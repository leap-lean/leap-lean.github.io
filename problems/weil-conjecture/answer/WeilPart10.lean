        commutes' := fun b => (congrFun (congrArg DFunLike.coe h_algMap_Ω) b).symm }
    have hs_eq : s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ Ω)) := by
      rw [← hs₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_algMap_Ω]
    rw [hs_eq]
    let _ : Algebra ↥(Algebra.adjoin B₀ (↑S_sm_all : Set K_bar)) Ω :=
      (φ_fin.comp (incAlg hSub_sm_all_fin)).toRingHom.toAlgebra
    have _ : IsScalarTower B₀ ↥(Algebra.adjoin B₀ (↑S_sm_all : Set K_bar)) Ω :=
      IsScalarTower.of_algebraMap_eq (fun b => ((φ_fin.comp (incAlg hSub_sm_all_fin)).commutes b).symm)
    exact hSmAll_spec hSmGen Ω

theorem weil_bivariate_quotient_away_lift_and_isPullback (B₀ : Type u) [CommRing B₀] [IsDomain B₀]
    (K_bar : Type u) [Field K_bar]
    (ι₀ : B₀ →+* K_bar) (_hInj₀ : Function.Injective ι₀)
    (P : Polynomial (Polynomial K_bar)) (_hMon : P.Monic) (_hDeg : 1 ≤ P.natDegree)
    (g₀ : Polynomial (Polynomial K_bar) ⧸ Ideal.span ({P} : Set (Polynomial (Polynomial K_bar))))
    (α_W : K_bar →+* Localization.Away g₀) :
    (∀ c : K_bar, α_W c = Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) →
    ∃ (B_init : Type u) (_ : CommRing B_init) (_ : IsDomain B_init)
      (ψ_init : B₀ →+* B_init) (ι_init : B_init →+* K_bar)
      (P_init : Polynomial (Polynomial B_init))
      (G_init : Polynomial (Polynomial B_init))
      (α_init : B_init →+* Localization.Away
        (Ideal.Quotient.mk (Ideal.span ({P_init} : Set (Polynomial (Polynomial B_init)))) G_init)),
      RingHom.FiniteType ψ_init ∧
      ι_init.comp ψ_init = ι₀ ∧
      Function.Injective ι_init ∧
      P_init.Monic ∧
      1 ≤ P_init.natDegree ∧
      P_init.map (Polynomial.mapRingHom ι_init) = P ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init)) ∧
      (∃ ψ_gen : Localization.Away
            (Ideal.Quotient.mk (Ideal.span ({P_init} : Set (Polynomial (Polynomial B_init)))) G_init) →+*
          Localization.Away g₀,
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_init))) ∧
      (∀ (R' : Type u) [CommRing R'] (φ : B_init →+* R'),
        let P_R' : Polynomial (Polynomial R') := P_init.map (Polynomial.mapRingHom φ)
        let g_R' : Polynomial (Polynomial R') ⧸ Ideal.span ({P_R'} : Set (Polynomial (Polynomial R'))) :=
          Ideal.Quotient.mk (Ideal.span ({P_R'} : Set (Polynomial (Polynomial R'))))
            (G_init.map (Polynomial.mapRingHom φ))
        ∃ (α_R' : R' →+* Localization.Away g_R')
          (ψ_R' : Localization.Away
              (Ideal.Quotient.mk (Ideal.span ({P_init} : Set (Polynomial (Polynomial B_init)))) G_init) →+*
            Localization.Away g_R'),
          (∀ c : R', α_R' c = Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) ∧
          CategoryTheory.IsPullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_R'))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_R'))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))) :=
by
  intro hα_W
  obtain ⟨G₀, hG₀⟩ := Ideal.Quotient.mk_surjective g₀

  have hLift :
      ∃ (B_init : Type u) (_ : CommRing B_init) (_ : IsDomain B_init)
        (ψ_init : B₀ →+* B_init) (ι_init : B_init →+* K_bar)
        (P_init G_init : Polynomial (Polynomial B_init)),
        RingHom.FiniteType ψ_init ∧
        ι_init.comp ψ_init = ι₀ ∧
        Function.Injective ι_init ∧
        P_init.Monic ∧
        1 ≤ P_init.natDegree ∧
        P_init.map (Polynomial.mapRingHom ι_init) = P ∧
        G_init.map (Polynomial.mapRingHom ι_init) = G₀ := by
    let _ : Algebra B₀ K_bar := ι₀.toAlgebra
    let _ : DecidableEq K_bar := Classical.decEq K_bar
    let bivCoeffs : Polynomial (Polynomial K_bar) → Finset K_bar := fun Q =>
      Q.support.biUnion fun i => (Q.coeff i).support.image (Q.coeff i).coeff
    let S₁ : Finset K_bar := bivCoeffs P ∪ bivCoeffs G₀
    let A_sub : Subalgebra B₀ K_bar := Algebra.adjoin B₀ (↑S₁ : Set K_bar)
    have hMemBiv : ∀ (Q : Polynomial (Polynomial K_bar)), bivCoeffs Q ⊆ S₁ →
        ∀ i j : ℕ, (Q.coeff i).coeff j ∈ A_sub := by
      intro Q hSub i j
      by_cases hij : (Q.coeff i).coeff j = 0
      · rw [hij]
        exact A_sub.zero_mem
      · have hj : j ∈ (Q.coeff i).support := Polynomial.mem_support_iff.mpr hij
        have hQi : Q.coeff i ≠ 0 := by
          intro h0
          apply hij
          rw [h0, Polynomial.coeff_zero]
        have hi : i ∈ Q.support := Polynomial.mem_support_iff.mpr hQi
        apply Algebra.subset_adjoin
        rw [Finset.mem_coe]
        exact hSub (Finset.mem_biUnion.mpr ⟨i, hi, Finset.mem_image.mpr ⟨j, hj, rfl⟩⟩)
    let B_init : Type u := ↥A_sub
    let ψ_init : B₀ →+* B_init := algebraMap B₀ B_init
    let ι_init : B_init →+* K_bar := A_sub.val.toRingHom
    have hFT_init : RingHom.FiniteType ψ_init := by
      change Algebra.FiniteType B₀ B_init
      exact Algebra.FiniteType.adjoin_of_finite S₁.finite_toSet
    have hComp_init : ι_init.comp ψ_init = ι₀ := by
      ext r
      rfl
    have hInj_init : Function.Injective ι_init := Subtype.val_injective
    let liftUni : ∀ (q : Polynomial K_bar), (∀ j : ℕ, q.coeff j ∈ A_sub) → Polynomial B_init :=
      fun q hq => ∑ j ∈ q.support, Polynomial.monomial j ⟨q.coeff j, hq j⟩
    have hLiftUni : ∀ (q : Polynomial K_bar) (hq : ∀ j : ℕ, q.coeff j ∈ A_sub),
        (liftUni q hq).map ι_init = q := by
      intro q hq
      apply Polynomial.ext
      intro m
      rw [Polynomial.coeff_map, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq']
      by_cases hm : m ∈ q.support
      · simp only [hm, ↓reduceIte]
        rfl
      · simp only [hm, ↓reduceIte, map_zero]
        exact (Polynomial.notMem_support_iff.mp hm).symm
    let liftBiv : ∀ (Q : Polynomial (Polynomial K_bar)),
        (∀ i j : ℕ, (Q.coeff i).coeff j ∈ A_sub) → Polynomial (Polynomial B_init) :=
      fun Q hQ => ∑ i ∈ Q.support, Polynomial.monomial i (liftUni (Q.coeff i) (hQ i))
    have hLiftBiv : ∀ (Q : Polynomial (Polynomial K_bar))
        (hQ : ∀ i j : ℕ, (Q.coeff i).coeff j ∈ A_sub),
        (liftBiv Q hQ).map (Polynomial.mapRingHom ι_init) = Q := by
      intro Q hQ
      apply Polynomial.ext
      intro m
      rw [Polynomial.coeff_map, Polynomial.coe_mapRingHom, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq']
      by_cases hm : m ∈ Q.support
      · simp only [hm, ↓reduceIte]
        exact hLiftUni (Q.coeff m) (hQ m)
      · simp only [hm, ↓reduceIte, Polynomial.map_zero]
        exact (Polynomial.notMem_support_iff.mp hm).symm
    let P_init : Polynomial (Polynomial B_init) :=
      liftBiv P (hMemBiv P Finset.subset_union_left)
    let G_init : Polynomial (Polynomial B_init) :=
      liftBiv G₀ (hMemBiv G₀ Finset.subset_union_right)
    have hP_map : P_init.map (Polynomial.mapRingHom ι_init) = P :=
      hLiftBiv P (hMemBiv P Finset.subset_union_left)
    have hG_map : G_init.map (Polynomial.mapRingHom ι_init) = G₀ :=
      hLiftBiv G₀ (hMemBiv G₀ Finset.subset_union_right)
    have hInj_poly : Function.Injective (Polynomial.mapRingHom ι_init) := by
      rw [Polynomial.coe_mapRingHom]
      exact Polynomial.map_injective ι_init hInj_init
    have hMon_init : P_init.Monic :=
      Polynomial.monic_of_injective hInj_poly (by rwa [hP_map])
    have hDeg_init : 1 ≤ P_init.natDegree := by
      rw [← Polynomial.natDegree_map_eq_of_injective hInj_poly P_init, hP_map]
      exact _hDeg
    exact ⟨B_init, inferInstance, inferInstance, ψ_init, ι_init, P_init, G_init,
      hFT_init, hComp_init, hInj_init, hMon_init, hDeg_init, hP_map, hG_map⟩

  suffices hMain :
      ∀ (B_init : Type u) [CommRing B_init] (_ : IsDomain B_init)
        (ψ_init : B₀ →+* B_init) (ι_init : B_init →+* K_bar)
        (P_init G_init : Polynomial (Polynomial B_init)),
        RingHom.FiniteType ψ_init →
        ι_init.comp ψ_init = ι₀ →
        Function.Injective ι_init →
        P_init.Monic →
        1 ≤ P_init.natDegree →
        P_init.map (Polynomial.mapRingHom ι_init) = P →
        G_init.map (Polynomial.mapRingHom ι_init) = G₀ → _ by
    obtain ⟨B_init, instCR_init, instDom_init, ψ_init, ι_init, P_init, G_init,
      hFT_init, hComp_init, hInj_init, hMon_init, hDeg_init, hP_map, hG_map⟩ := hLift
    exact @hMain B_init instCR_init instDom_init ψ_init ι_init P_init G_init
      hFT_init hComp_init hInj_init hMon_init hDeg_init hP_map hG_map
  intro B_init instCR_init instDom_init ψ_init ι_init P_init G_init
    hFT_init hComp_init hInj_init hMon_init hDeg_init hP_map hG_map

  have hAbstract :
      ∀ (B : Type u) [CommRing B]
        (A₀ : Type u) [CommRing A₀] (c₀ : B →+* A₀) (u₀ : A₀)
        (hFP_c₀ : c₀.FinitePresentation)
        (hExt₀ : ∀ {S : Type u} [CommRing S] (m₁ m₂ : A₀ →+* S),
          m₁.comp c₀ = m₂.comp c₀ → m₁ u₀ = m₂ u₀ → m₁ = m₂)
        (P₀ G₀ : Polynomial A₀),
        let I₀ : Ideal (Polynomial A₀) := Ideal.span ({P₀} : Set (Polynomial A₀))
        let g_init : Polynomial A₀ ⧸ I₀ := Ideal.Quotient.mk I₀ G₀
        ∃ (α_init : B →+* Localization.Away g_init),
          AlgebraicGeometry.LocallyOfFinitePresentation
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init)) ∧
          ∀ (R' : Type u) [CommRing R'] (φ : B →+* R')
            (A₁ : Type u) [CommRing A₁] (c₁ : R' →+* A₁) (u₁ : A₁)
            (φ_A : A₀ →+* A₁),
            φ_A.comp c₀ = c₁.comp φ →
            φ_A u₀ = u₁ →
            (∀ {S : Type u} [CommRing S] (f_R : R' →+* S) (u_S : S),
              ∃ h : A₁ →+* S,
                (h.comp c₁ = f_R ∧ h u₁ = u_S) ∧
                ∀ m : A₁ →+* S, m.comp c₁ = f_R → m u₁ = u_S → m = h) →
            let P₁ : Polynomial A₁ := P₀.map φ_A
            let g₁ : Polynomial A₁ ⧸ Ideal.span ({P₁} : Set (Polynomial A₁)) :=
              Ideal.Quotient.mk (Ideal.span ({P₁} : Set (Polynomial A₁))) (G₀.map φ_A)
            ∃ (α₁ : R' →+* Localization.Away g₁)
              (ψ₁ : Localization.Away g_init →+* Localization.Away g₁),
              (∀ c : R', α₁ c =
                Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (c₁ c))) 1) ∧
              CategoryTheory.IsPullback
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro B _ A₀ _ c₀ u₀ hFP_c₀ hExt₀ P₀ G₀ I₀ g_init
    let π₀ : Polynomial A₀ →+* Localization.Away g_init :=
      (algebraMap (Polynomial A₀ ⧸ I₀) (Localization.Away g_init)).comp (Ideal.Quotient.mk I₀)
    let C₀ : A₀ →+* Polynomial A₀ := Polynomial.C
    let α_init : B →+* Localization.Away g_init := π₀.comp (C₀.comp c₀)
    have hFP_C₀ : C₀.FinitePresentation := by
      change (Polynomial.C : A₀ →+* Polynomial A₀).FinitePresentation
      rw [← Polynomial.algebraMap_eq]
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    have hFP_quot : (Ideal.Quotient.mk I₀).FinitePresentation := by
      refine RingHom.FinitePresentation.of_surjective (Ideal.Quotient.mk I₀)
        Ideal.Quotient.mk_surjective ?_
      rw [Ideal.mk_ker]
      exact Submodule.fg_span_singleton P₀
    have hFP_loc :
        (algebraMap (Polynomial A₀ ⧸ I₀) (Localization.Away g_init)).FinitePresentation :=
      RingHom.finitePresentation_algebraMap.mpr (IsLocalization.Away.finitePresentation g_init)
    have hFP_α : α_init.FinitePresentation :=
      (hFP_loc.comp hFP_quot).comp (hFP_C₀.comp hFP_c₀)
    have hLFP_α :
        AlgebraicGeometry.LocallyOfFinitePresentation
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr hFP_α
    refine ⟨α_init, hLFP_α, ?_⟩
    intro R' _ φ A₁ _ c₁ u₁ φ_A hφ_c hφ_u hUniv₁ P₁ g₁
    let I₁ : Ideal (Polynomial A₁) := Ideal.span ({P₁} : Set (Polynomial A₁))
    let π₁ : Polynomial A₁ →+* Localization.Away g₁ :=
      (algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁)).comp (Ideal.Quotient.mk I₁)
    let C₁ : A₁ →+* Polynomial A₁ := Polynomial.C
    let α₁ : R' →+* Localization.Away g₁ := π₁.comp (C₁.comp c₁)
    have hα₁ :
        ∀ c : R', α₁ c = Localization.mk (Ideal.Quotient.mk I₁ (Polynomial.C (c₁ c))) 1 :=
      fun c => (Localization.mk_one_eq_algebraMap
        (Ideal.Quotient.mk I₁ (Polynomial.C (c₁ c)))).symm
    let φ_poly : Polynomial A₀ →+* Polynomial A₁ := Polynomial.mapRingHom φ_A
    have hKer₀ : ∀ a ∈ I₀, ((Ideal.Quotient.mk I₁).comp φ_poly) a = 0 := by
      intro a ha
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp ha
      simp only [RingHom.comp_apply, map_mul]
      have hP0 : Ideal.Quotient.mk I₁ (φ_poly P₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton P₁))
      rw [hP0, zero_mul]
    let ψ_Q : (Polynomial A₀ ⧸ I₀) →+* (Polynomial A₁ ⧸ I₁) :=
      Ideal.Quotient.lift I₀ ((Ideal.Quotient.mk I₁).comp φ_poly) hKer₀
    have hg_unit :
        IsUnit (((algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁)).comp ψ_Q) g_init) := by
      change IsUnit
        (algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁)
          (ψ_Q (Ideal.Quotient.mk I₀ G₀)))
      rw [Ideal.Quotient.lift_mk]
      exact IsLocalization.Away.algebraMap_isUnit g₁
    let ψ₁ : Localization.Away g_init →+* Localization.Away g₁ :=
      IsLocalization.Away.lift (S := Localization.Away g_init) g_init hg_unit
    have hψ_π : ∀ F : Polynomial A₀, ψ₁ (π₀ F) = π₁ (φ_poly F) := by
      intro F
      change IsLocalization.Away.lift g_init hg_unit
          (algebraMap (Polynomial A₀ ⧸ I₀) (Localization.Away g_init)
            (Ideal.Quotient.mk I₀ F)) =
        algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁)
          (Ideal.Quotient.mk I₁ (φ_poly F))
      rw [IsLocalization.Away.lift_eq]
      rfl
    have h_sq :
        CommRingCat.ofHom α_init ≫ CommRingCat.ofHom ψ₁ =
          CommRingCat.ofHom φ ≫ CommRingCat.ofHom α₁ := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      apply congrArg CommRingCat.ofHom
      apply RingHom.ext
      intro b
      change ψ₁ (π₀ (Polynomial.C (c₀ b))) = π₁ (Polynomial.C (c₁ (φ b)))
      rw [hψ_π]
      simp only [φ_poly, Polynomial.coe_mapRingHom, Polynomial.map_C]
      have hb : φ_A (c₀ b) = c₁ (φ b) := RingHom.congr_fun hφ_c b
      rw [hb]

    let mkDesc :
        ∀ (s : CategoryTheory.Limits.PushoutCocone
            (CommRingCat.ofHom α_init) (CommRingCat.ofHom φ)),
          { h_L : Localization.Away g₁ →+* ↥s.pt //
            (CommRingCat.ofHom ψ₁ ≫ CommRingCat.ofHom h_L = s.inl ∧
             CommRingCat.ofHom α₁ ≫ CommRingCat.ofHom h_L = s.inr) ∧
            ∀ (m : CommRingCat.of (Localization.Away g₁) ⟶ s.pt),
              CommRingCat.ofHom ψ₁ ≫ m = s.inl →
              CommRingCat.ofHom α₁ ≫ m = s.inr →
              m = CommRingCat.ofHom h_L } := fun s => by
      let S : Type u := ↥s.pt
      let f₂ : Localization.Away g_init →+* S := s.inl.hom
      let f₁ : R' →+* S := s.inr.hom
      have h_cond : f₂.comp α_init = f₁.comp φ :=
        congrArg CommRingCat.Hom.hom s.condition
      let u_S : S := f₂ (π₀ (Polynomial.C u₀))
      let T_S : S := f₂ (π₀ Polynomial.X)
      let h_u_spec := Classical.indefiniteDescription _ (hUniv₁ f₁ u_S)
      let h_u : A₁ →+* S := h_u_spec.1
      have hu_c₁ : h_u.comp c₁ = f₁ := h_u_spec.2.1.1
      have hu_u₁ : h_u u₁ = u_S := h_u_spec.2.1.2
      have hu_uniq : ∀ m : A₁ →+* S, m.comp c₁ = f₁ → m u₁ = u_S → m = h_u :=
        h_u_spec.2.2
      let h_uT : Polynomial A₁ →+* S := Polynomial.eval₂RingHom h_u T_S
      have hu_comp : h_u.comp φ_A = f₂.comp (π₀.comp C₀) := by
        apply hExt₀
        · calc
            (h_u.comp φ_A).comp c₀ = h_u.comp (φ_A.comp c₀) := rfl
            _ = h_u.comp (c₁.comp φ) := by rw [hφ_c]
            _ = (h_u.comp c₁).comp φ := rfl
            _ = f₁.comp φ := by rw [hu_c₁]
            _ = f₂.comp α_init := h_cond.symm
            _ = (f₂.comp (π₀.comp C₀)).comp c₀ := rfl
        · calc
            (h_u.comp φ_A) u₀ = h_u (φ_A u₀) := rfl
            _ = h_u u₁ := by rw [hφ_u]
            _ = u_S := hu_u₁
            _ = (f₂.comp (π₀.comp C₀)) u₀ := rfl
      have huT_comp : h_uT.comp φ_poly = f₂.comp π₀ := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro q
          change Polynomial.eval₂ h_u T_S (φ_poly (Polynomial.C q)) = f₂ (π₀ (Polynomial.C q))
          simp only [φ_poly, Polynomial.coe_mapRingHom, Polynomial.map_C, Polynomial.eval₂_C]
          exact RingHom.congr_fun hu_comp q
        · change Polynomial.eval₂ h_u T_S (φ_poly Polynomial.X) = T_S
          simp only [φ_poly, Polynomial.coe_mapRingHom, Polynomial.map_X, Polynomial.eval₂_X]
      have hKer₁ : ∀ a ∈ I₁, h_uT a = 0 := by
        intro a ha
        obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp ha
        rw [map_mul]
        have hP_zero : h_uT P₁ = 0 := by
          change (h_uT.comp φ_poly) P₀ = 0
          rw [huT_comp]
          simp only [π₀, RingHom.comp_apply]
          have hP₀_zero : Ideal.Quotient.mk I₀ P₀ = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton P₀))
          rw [hP₀_zero, map_zero, map_zero]
        rw [hP_zero, zero_mul]
      let h_Q : (Polynomial A₁ ⧸ I₁) →+* S := Ideal.Quotient.lift I₁ h_uT hKer₁
      have hg_S : IsUnit (h_Q g₁) := by
        have hg_eq :
            h_Q g₁ =
              f₂ (algebraMap (Polynomial A₀ ⧸ I₀) (Localization.Away g_init) g_init) := by
          change Ideal.Quotient.lift I₁ h_uT hKer₁
              (Ideal.Quotient.mk I₁ (φ_poly G₀)) =
            (f₂.comp π₀) G₀
          rw [Ideal.Quotient.lift_mk, ← huT_comp]
          rfl
        rw [hg_eq]
        exact (IsLocalization.Away.algebraMap_isUnit g_init).map f₂
      let h_L : Localization.Away g₁ →+* S :=
        IsLocalization.Away.lift (S := Localization.Away g₁) g₁ hg_S
      have hL_π : ∀ F : Polynomial A₁, h_L (π₁ F) = h_uT F := by
        intro F
        change IsLocalization.Away.lift g₁ hg_S
            (algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁)
              (Ideal.Quotient.mk I₁ F)) = h_uT F
        rw [IsLocalization.Away.lift_eq]
        rfl
      have h_inl : CommRingCat.ofHom ψ₁ ≫ CommRingCat.ofHom h_L = s.inl := by
        apply CommRingCat.hom_ext
        apply IsLocalization.ringHom_ext (Submonoid.powers g_init)
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro F
        change h_L (ψ₁ (π₀ F)) = f₂ (π₀ F)
        rw [hψ_π, hL_π]
        exact RingHom.congr_fun huT_comp F
      have h_inr : CommRingCat.ofHom α₁ ≫ CommRingCat.ofHom h_L = s.inr := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        change h_L (π₁ (Polynomial.C (c₁ c))) = f₁ c
        rw [hL_π]
        exact (Polynomial.eval₂_C h_u T_S).trans (RingHom.congr_fun hu_c₁ c)
      have h_uniq :
          ∀ (m : CommRingCat.of (Localization.Away g₁) ⟶ s.pt),
            CommRingCat.ofHom ψ₁ ≫ m = s.inl →
            CommRingCat.ofHom α₁ ≫ m = s.inr →
            m = CommRingCat.ofHom h_L := by
        intro m hm_inl hm_inr
        have hm2 : m.hom.comp ψ₁ = f₂ := congrArg CommRingCat.Hom.hom hm_inl
        have hm1 : m.hom.comp α₁ = f₁ := congrArg CommRingCat.Hom.hom hm_inr
        apply CommRingCat.hom_ext
        apply IsLocalization.ringHom_ext (Submonoid.powers g₁)
        apply Ideal.Quotient.ringHom_ext
        have h_rhs :
            (h_L.comp (algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁))).comp
              (Ideal.Quotient.mk I₁) = h_uT :=
          RingHom.ext fun F => hL_π F
        change (m.hom.comp (algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁))).comp
            (Ideal.Quotient.mk I₁) =
          (h_L.comp (algebraMap (Polynomial A₁ ⧸ I₁) (Localization.Away g₁))).comp
            (Ideal.Quotient.mk I₁)
        rw [h_rhs]
        change m.hom.comp π₁ = h_uT
        apply Polynomial.ringHom_ext'
        · have hm_A₁ : (m.hom.comp π₁).comp Polynomial.C = h_u := by
            apply hu_uniq
            · exact hm1
            · change m.hom (π₁ (Polynomial.C u₁)) = u_S
              rw [← hφ_u]
              have hCu : π₁ (Polynomial.C (φ_A u₀)) = ψ₁ (π₀ (Polynomial.C u₀)) := by
                rw [hψ_π]
                simp only [φ_poly, Polynomial.coe_mapRingHom, Polynomial.map_C]
              rw [hCu]
              exact RingHom.congr_fun hm2 (π₀ (Polynomial.C u₀))
          rw [hm_A₁]
          exact RingHom.ext fun _ => (Polynomial.eval₂_C h_u T_S).symm
        · change m.hom (π₁ Polynomial.X) = h_uT Polynomial.X
          have hX : π₁ Polynomial.X = ψ₁ (π₀ Polynomial.X) := by
            rw [hψ_π]
            simp only [φ_poly, Polynomial.coe_mapRingHom, Polynomial.map_X]
          rw [hX]
          change (m.hom.comp ψ₁) (π₀ Polynomial.X) = h_uT Polynomial.X
          rw [hm2]
          exact (Polynomial.eval₂_X h_u T_S).symm
      exact ⟨h_L, ⟨h_inl, h_inr⟩, h_uniq⟩

    let hColim :
        CategoryTheory.Limits.IsColimit
          (CategoryTheory.Limits.PushoutCocone.mk
            (CommRingCat.ofHom ψ₁) (CommRingCat.ofHom α₁) h_sq) :=
      CategoryTheory.Limits.PushoutCocone.IsColimit.mk h_sq
        (fun s => CommRingCat.ofHom (mkDesc s).1)
        (fun s => (mkDesc s).2.1.1)
        (fun s => (mkDesc s).2.1.2)
        (fun s m hm1 hm2 => (mkDesc s).2.2 m hm1 hm2)
    have hPush :
        CategoryTheory.IsPushout
          (CommRingCat.ofHom α_init) (CommRingCat.ofHom φ)
          (CommRingCat.ofHom ψ₁) (CommRingCat.ofHom α₁) :=
      CategoryTheory.IsPushout.of_isColimit hColim
    exact ⟨α₁, ψ₁, hα₁,
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush⟩

  have hFP_C_init : (Polynomial.C : B_init →+* Polynomial B_init).FinitePresentation := by
    rw [← Polynomial.algebraMap_eq]
    exact RingHom.finitePresentation_algebraMap.mpr inferInstance
  obtain ⟨α_init, hLFP_α, hAbsPb⟩ :=
    hAbstract B_init (Polynomial B_init) Polynomial.C Polynomial.X hFP_C_init
      (fun _ _ hc hx => Polynomial.ringHom_ext' hc hx) P_init G_init

  have hUnivPb :
      ∀ (R' : Type u) [CommRing R'] (φ : B_init →+* R'),
        let P_R' : Polynomial (Polynomial R') := P_init.map (Polynomial.mapRingHom φ)
        let g_R' : Polynomial (Polynomial R') ⧸ Ideal.span ({P_R'} : Set (Polynomial (Polynomial R'))) :=
          Ideal.Quotient.mk (Ideal.span ({P_R'} : Set (Polynomial (Polynomial R'))))
            (G_init.map (Polynomial.mapRingHom φ))
        ∃ (α_R' : R' →+* Localization.Away g_R')
          (ψ_R' : Localization.Away
              (Ideal.Quotient.mk (Ideal.span ({P_init} : Set (Polynomial (Polynomial B_init)))) G_init) →+*
            Localization.Away g_R'),
          (∀ c : R', α_R' c = Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) ∧
          CategoryTheory.IsPullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_R'))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_R'))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro R' _ φ
    exact hAbsPb R' φ (Polynomial R') Polynomial.C Polynomial.X (Polynomial.mapRingHom φ)
      (RingHom.ext fun _ => Polynomial.map_C φ)
      (Polynomial.map_X φ)
      (fun {S} _ f_R u_S =>
        ⟨Polynomial.eval₂RingHom f_R u_S,
          ⟨RingHom.ext fun _ => Polynomial.eval₂_C f_R u_S,
           Polynomial.eval₂_X f_R u_S⟩,
          fun m hm_c hm_u =>
            Polynomial.ringHom_ext'
              (by rw [hm_c]; exact RingHom.ext fun _ => (Polynomial.eval₂_C f_R u_S).symm)
              (hm_u.trans (Polynomial.eval₂_X f_R u_S).symm)⟩)

  have hPb_gen_ex :
      ∃ ψ_gen : Localization.Away
            (Ideal.Quotient.mk (Ideal.span ({P_init} : Set (Polynomial (Polynomial B_init)))) G_init) →+*
          Localization.Away g₀,
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_init))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_init)) := by
    rw [← hG_map] at hG₀
    clear hLift hG_map G₀
    subst hP_map
    subst hG₀
    obtain ⟨α_K, ψ_gen, hα_K, hPb_K⟩ := hUnivPb K_bar ι_init
    have hα_eq : α_K = α_W :=
      RingHom.ext fun c => (hα_K c).trans (hα_W c).symm
    rw [hα_eq] at hPb_K
    exact ⟨ψ_gen, hPb_K⟩

  exact ⟨B_init, instCR_init, instDom_init, ψ_init, ι_init, P_init, G_init, α_init,
    hFT_init, hComp_init, hInj_init, hMon_init, hDeg_init, hP_map, hLFP_α,
    hPb_gen_ex, hUnivPb⟩

theorem weil_domain_spreadOut_affine_openImmersion_and_finite_compl (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
    (K_bar : Type u) [Field K_bar]
    (ι₀ : B₀ →+* K_bar) (_hInj₀ : Function.Injective ι₀)
    (E₀ : AlgebraicGeometry.Scheme.{u})
    (p₀ : E₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (U₀ : E₀.Opens)
    (A₀ : Type u) [CommRing A₀]
    (α₀ : B₀ →+* A₀)
    (A_gen : Type u) [CommRing A_gen]
    (α_gen : K_bar →+* A_gen)
    (ψ_gen : A₀ →+* A_gen)
    (j_W : AlgebraicGeometry.Spec (CommRingCat.of A_gen) ⟶
      CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)))
    (pt_W : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A_gen))
    (r : ℕ)
    (ξ : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
      CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)))) :
    AlgebraicGeometry.IsProper p₀ →
    AlgebraicGeometry.LocallyOfFinitePresentation p₀ →
    AlgebraicGeometry.LocallyOfFinitePresentation (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)) →
    CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_gen))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) →
    AlgebraicGeometry.IsOpenImmersion j_W →
    j_W ≫ CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_gen) →
    Set.range j_W.base ⊆
      ((TopologicalSpace.Opens.map
        (CategoryTheory.Limits.pullback.fst p₀
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))).base).obj U₀ :
        Set ↥(CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)))) →
    pt_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_gen) = 𝟙 _ →
    (∀ ℓ : Fin r,
      ξ ℓ ≫ CategoryTheory.Limits.pullback.snd p₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) = 𝟙 _) →
    (Set.range j_W.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ ℓ).base →
    ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
      (ψ : B₀ →+* B) (ι_B : B →+* K_bar),
      RingHom.FiniteType ψ ∧
      ι_B.comp ψ = ι₀ ∧
      Function.Injective ι_B ∧
      ∀ (Ω : Type u) [Field Ω] (φ : B →+* Ω)
        (A_Ω : Type u) [CommRing A_Ω]
        (α_Ω : Ω →+* A_Ω) (ψ_Ω : A₀ →+* A_Ω),
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp ψ))) →
        let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp ψ))
        let E_Ω := CategoryTheory.Limits.pullback p₀ s₀
        let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s₀
        let fst_Ω := CategoryTheory.Limits.pullback.fst p₀ s₀
        ∃ (j_Ω : AlgebraicGeometry.Spec (CommRingCat.of A_Ω) ⟶ E_Ω)
          (pt_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of A_Ω))
          (ξ_Ω : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_Ω)),
          AlgebraicGeometry.IsOpenImmersion j_Ω ∧
          j_Ω ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω) ∧
          Set.range j_Ω.base ⊆ ((TopologicalSpace.Opens.map fst_Ω.base).obj U₀ : Set ↥E_Ω) ∧
          pt_Ω ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω) = 𝟙 _ ∧
          (∀ ℓ : Fin r, ξ_Ω ℓ ≫ p_Ω = 𝟙 _) ∧
          (Set.range j_Ω.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ_Ω ℓ).base :=
by
  intro hProp hLFP_p₀ hLFP_α₀ hPb_gen hjW_open hjW_p hjW_sub hpt_W hξ hCompl
  have _ : AlgebraicGeometry.IsProper p₀ := hProp
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation p₀ := hLFP_p₀
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)) := hLFP_α₀
  have _ : AlgebraicGeometry.IsOpenImmersion j_W := hjW_open

  
  
  
  have hStep1 :
      ∃ (J : Type u) (_ : CategoryTheory.SmallCategory J) (_ : CategoryTheory.IsFiltered J)
        (R_diag : J ⥤ CommRingCat.{u})
        (α_B₀ : (CategoryTheory.Functor.const J).obj (CommRingCat.of B₀) ⟶ R_diag)
        (ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of K_bar)),
        Nonempty (CategoryTheory.Limits.IsColimit
          (CategoryTheory.Limits.Cocone.mk (CommRingCat.of K_bar) ι_colim)) ∧
        Nonempty (CategoryTheory.Limits.IsLimit
          (AlgebraicGeometry.Scheme.Spec.mapCone
            (CategoryTheory.Limits.Cocone.mk (CommRingCat.of K_bar) ι_colim).op)) ∧
        (∀ j : J, α_B₀.app j ≫ ι_colim.app j = CommRingCat.ofHom ι₀) ∧
        (∀ j : J,
          IsDomain (R_diag.obj j) ∧
          IsNoetherianRing (R_diag.obj j) ∧
          RingHom.FiniteType (α_B₀.app j).hom ∧
          Function.Injective (ι_colim.app j).hom) := by
    let _ : Algebra B₀ K_bar := ι₀.toAlgebra
    let _ : DecidableEq K_bar := Classical.decEq K_bar
    let J : Type u := CategoryTheory.ULiftHom.{u} (Finset K_bar)
    let toJ : Finset K_bar → J := id
    let fromJ : J → Finset K_bar := id
    let A_sub : J → Subalgebra B₀ K_bar := fun j => Algebra.adjoin B₀ (↑(fromJ j) : Set K_bar)
    let R_diag : J ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of ↥(A_sub j)
        map := fun f =>
          CommRingCat.ofHom
            (Subalgebra.inclusion
              (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom f.down)))).toRingHom
        map_id := by intro j; ext ⟨x, hx⟩; rfl
        map_comp := by intro j₁ j₂ j₃ f g; ext ⟨x, hx⟩; rfl }
    let α_B₀ : (CategoryTheory.Functor.const J).obj (CommRingCat.of B₀) ⟶ R_diag :=
      { app := fun j => CommRingCat.ofHom (algebraMap B₀ ↥(A_sub j))
        naturality := by intro j₁ j₂ f; ext b; rfl }
    let ι_colim : R_diag ⟶ (CategoryTheory.Functor.const J).obj (CommRingCat.of K_bar) :=
      { app := fun j => CommRingCat.ofHom (A_sub j).val.toRingHom
        naturality := by intro j₁ j₂ f; ext x; rfl }
    have hFT_R : ∀ j : J, RingHom.FiniteType (α_B₀.app j).hom := by
      intro j
      change Algebra.FiniteType B₀ ↥(A_sub j)
      exact Algebra.FiniteType.adjoin_of_finite (fromJ j).finite_toSet
    have hInj_R : ∀ j : J, Function.Injective (ι_colim.app j).hom := fun _ =>
      Subtype.val_injective
    let c_K : CategoryTheory.Limits.Cocone R_diag :=
      CategoryTheory.Limits.Cocone.mk (CommRingCat.of K_bar) ι_colim
    have hExColim : Nonempty (CategoryTheory.Limits.IsColimit c_K) := by
      have _ : CategoryTheory.Limits.ReflectsColimit R_diag (CategoryTheory.forget CommRingCat.{u}) :=
        CategoryTheory.Limits.reflectsColimit_of_reflectsIsomorphisms
          R_diag (CategoryTheory.forget CommRingCat.{u})
      refine ⟨CategoryTheory.Limits.isColimitOfReflects (CategoryTheory.forget CommRingCat.{u}) ?_⟩
      refine CategoryTheory.Limits.Types.FilteredColimit.isColimitOf'
        (R_diag ⋙ CategoryTheory.forget CommRingCat.{u})
        ((CategoryTheory.forget CommRingCat.{u}).mapCocone c_K) ?_ ?_
      · intro x
        exact ⟨toJ {x}, ⟨x, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_singleton_self x))⟩, rfl⟩
      · intro j x y hxy
        exact ⟨j, 𝟙 j, by rw [hInj_R j hxy]⟩
    obtain ⟨hc_K⟩ := hExColim
    refine ⟨J, inferInstance, inferInstance, R_diag, α_B₀, ι_colim, ⟨hc_K⟩,
      ⟨CategoryTheory.Limits.isLimitOfPreserves AlgebraicGeometry.Scheme.Spec hc_K.op⟩,
      fun j => by ext b; rfl, fun j => ⟨inferInstance, ?_, hFT_R j, hInj_R j⟩⟩
    let _ : Algebra B₀ ↥(A_sub j) := inferInstance
    have _ : Algebra.FiniteType B₀ ↥(A_sub j) := hFT_R j
    exact Algebra.FiniteType.isNoetherianRing B₀ ↥(A_sub j)

  obtain ⟨J, instCatJ, instFiltJ, R_diag, α_B₀, ι_colim, hColimK, hLimSpec, hα_comm, hProps⟩ := hStep1
  let _ : CategoryTheory.SmallCategory J := instCatJ
  let _ : CategoryTheory.IsFiltered J := instFiltJ

  
  
  
  have hStep2 :
      ∃ (j₂ : J)
        (j_open :
          CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀))
            (AlgebraicGeometry.Spec.map (α_B₀.app j₂)) ⟶
          CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂))),
        AlgebraicGeometry.IsOpenImmersion j_open ∧
        j_open ≫ CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)) =
          CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀))
            (AlgebraicGeometry.Spec.map (α_B₀.app j₂)) ∧
        Set.range j_open.base ⊆
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂))).base).obj U₀ :
            Set ↥(CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)))) ∧
        ∀ (π_gen :
            CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) ⟶
            CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂))),
          π_gen ≫ CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)) =
            CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) →
          π_gen ≫ CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)) =
            CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) ≫
              AlgebraicGeometry.Spec.map (ι_colim.app j₂) →
          π_gen.base ⁻¹' (Set.range j_open.base) = Set.range j_W.base := by
    obtain ⟨hc_K⟩ := hColimK
    obtain ⟨hc_Spec⟩ := hLimSpec
    let c_K := CategoryTheory.Limits.Cocone.mk (CommRingCat.of K_bar) ι_colim
    let S_diag : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} := R_diag.op ⋙ AlgebraicGeometry.Scheme.Spec
    let c_Spec : CategoryTheory.Limits.Cone S_diag :=
      AlgebraicGeometry.Scheme.Spec.mapCone c_K.op
    let s_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)
    let E_gen := CategoryTheory.Limits.pullback p₀ s_gen
    let p_gen := CategoryTheory.Limits.pullback.snd p₀ s_gen
    let fst_gen := CategoryTheory.Limits.pullback.fst p₀ s_gen
    let f_α₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)

    let E_diag : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} :=
      { obj := fun i =>
          CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop))
        map := fun {i₁ i₂} f =>
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop)))
            (CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop)) ≫
              AlgebraicGeometry.Spec.map (R_diag.map f.unop))
            (by
              rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
              have hnat := α_B₀.naturality f.unop
              simp only [CategoryTheory.Functor.const_obj_obj,
                CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
              rw [← hnat, CategoryTheory.Limits.pullback.condition])
        map_id := by
          intro i
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
              (CategoryTheory.Category.id_comp _).symm
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
            change _ ≫ AlgebraicGeometry.Spec.map (R_diag.map (𝟙 i.unop)) = _
            rw [R_diag.map_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
        map_comp := by
          intro i₁ i₂ i₃ f g
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
            change _ ≫ AlgebraicGeometry.Spec.map (R_diag.map (g.unop ≫ f.unop)) = _
            rw [R_diag.map_comp, AlgebraicGeometry.Spec.map_comp] }

    let p_nat : E_diag ⟶ S_diag :=
      { app := fun i =>
          CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop))
        naturality := fun _ _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _ }

    let c_E : CategoryTheory.Limits.Cone E_diag :=
      { pt := E_gen
        π :=
          { app := fun i =>
              CategoryTheory.Limits.pullback.lift fst_gen
                (p_gen ≫ AlgebraicGeometry.Spec.map (ι_colim.app i.unop))
                (by
                  rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                    hα_comm i.unop]
                  exact CategoryTheory.Limits.pullback.condition)
            naturality := by
              intro i₁ i₂ f
              apply CategoryTheory.Limits.pullback.hom_ext
              · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
                  CategoryTheory.Category.id_comp, E_diag]
                rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
              · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
                  CategoryTheory.Category.id_comp, E_diag]
                rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  ← AlgebraicGeometry.Spec.map_comp (R_diag.map f.unop) (ι_colim.app i₁.unop)]
                have hnat := ι_colim.naturality f.unop
                simp only [CategoryTheory.Functor.const_obj_obj,
                  CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
                rw [hnat] } }

    have hPb_E_cone : ∀ i : Jᵒᵖ,
        CategoryTheory.IsPullback (c_E.π.app i) p_gen (p_nat.app i) (c_Spec.π.app i) := by
      intro i
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop)))
      have h1 : c_E.π.app i ≫
          CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop)) =
          fst_gen :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h2 : c_Spec.π.app i ≫ AlgebraicGeometry.Spec.map (α_B₀.app i.unop) = s_gen := by
        change AlgebraicGeometry.Spec.map (ι_colim.app i.unop) ≫
          AlgebraicGeometry.Spec.map (α_B₀.app i.unop) = s_gen
        rw [← AlgebraicGeometry.Spec.map_comp, hα_comm i.unop]
      rw [h1, h2]
      exact CategoryTheory.IsPullback.of_hasPullback p₀ s_gen

    have _ : CategoryTheory.IsConnected Jᵒᵖ := CategoryTheory.IsCofiltered.isConnected Jᵒᵖ
    have hExLimE : Nonempty (CategoryTheory.Limits.IsLimit c_E) :=
      ⟨CategoryTheory.Limits.isLimitOfIsPullbackOfIsConnected
        p_nat c_E c_Spec
        { hom := p_gen
          w := fun _ => (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm }
        hPb_E_cone hc_Spec⟩
    obtain ⟨hc_E⟩ := hExLimE

    have hPb_E_map : ∀ {i₁ i₂ : Jᵒᵖ} (f : i₁ ⟶ i₂),
        CategoryTheory.IsPullback (E_diag.map f) (p_nat.app i₁) (p_nat.app i₂) (S_diag.map f) := by
      intro i₁ i₂ f
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop)))
      have h1 : E_diag.map f ≫
          CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop)) =
          CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop)) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h2 : S_diag.map f ≫ AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop) =
          AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop) := by
        change AlgebraicGeometry.Spec.map (R_diag.map f.unop) ≫
          AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop) = _
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hnat := α_B₀.naturality f.unop
        simp only [CategoryTheory.Functor.const_obj_obj,
          CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
        rw [← hnat]
      rw [h1, h2]
      exact CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop))

    have hAff_E_map : ∀ {i₁ i₂ : Jᵒᵖ} (f : i₁ ⟶ i₂), AlgebraicGeometry.IsAffineHom (E_diag.map f) := by
      intro i₁ i₂ f
      have hAffS : AlgebraicGeometry.IsAffineHom (S_diag.map f) := by
        change AlgebraicGeometry.IsAffineHom (AlgebraicGeometry.Spec.map (R_diag.map f.unop))
        exact AlgebraicGeometry.isAffineHom_of_isAffine _
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hPb_E_map f).flip hAffS

    have hNoeth_E : ∀ i : Jᵒᵖ, TopologicalSpace.NoetherianSpace ↥(E_diag.obj i) := by
      intro i
      have _ : IsNoetherianRing (R_diag.obj i.unop) := (hProps i.unop).2.1
      have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (R_diag.obj i.unop)) :=
        inferInstance
      have _ : CompactSpace ↥(AlgebraicGeometry.Spec (R_diag.obj i.unop)) := inferInstance
      let p_i := CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop))
      have _ : AlgebraicGeometry.IsProper p_i := inferInstance
      have _ : AlgebraicGeometry.LocallyOfFinitePresentation p_i := inferInstance
      have _ : AlgebraicGeometry.IsLocallyNoetherian (E_diag.obj i) :=
        AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_i
      have _ : CompactSpace ↥(E_diag.obj i) :=
        AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_i
      have _ : AlgebraicGeometry.IsNoetherian (E_diag.obj i) := AlgebraicGeometry.IsNoetherian.mk
      exact AlgebraicGeometry.IsNoetherian.noetherianSpace

    have hQS_E : ∀ i : Jᵒᵖ, QuasiSeparatedSpace ↥(E_diag.obj i) := by
      intro i
      have _ := hNoeth_E i
      infer_instance

    
    have hExV₁ : ∃ (i₁ : Jᵒᵖ) (V₁ : (E_diag.obj i₁).Opens),
        AlgebraicGeometry.IsAffineOpen V₁ ∧
        (V₁ : Set ↥(E_diag.obj i₁)) ⊆
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst p₀
              (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop))).base).obj U₀ :
            Set ↥(E_diag.obj i₁)) ∧
        (TopologicalSpace.Opens.map (c_E.π.app i₁).base).obj V₁ = j_W.opensRange := by
      obtain ⟨i₀, V₀, hAffV₀, hPreV₀⟩ :=
        @AlgebraicGeometry.exists_isAffineOpen_preimage_eq Jᵒᵖ _ E_diag c_E hc_E _
          (@hAff_E_map) hQS_E j_W.opensRange (AlgebraicGeometry.isAffineOpen_opensRange j_W)
      let U_i₀ : (E_diag.obj i₀).Opens :=
        (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst p₀
            (AlgebraicGeometry.Spec.map (α_B₀.app i₀.unop))).base).obj U₀
      have hPre_inter₀ :
          (TopologicalSpace.Opens.map (c_E.π.app i₀).base).obj (V₀ ⊓ U_i₀) =
            (TopologicalSpace.Opens.map (c_E.π.app i₀).base).obj V₀ := by
        apply TopologicalSpace.Opens.ext
        ext (y : ↥E_gen)
        have h_fst : (c_E.π.app i₀ ≫
            CategoryTheory.Limits.pullback.fst p₀
              (AlgebraicGeometry.Spec.map (α_B₀.app i₀.unop))).base y = fst_gen.base y := by
          have hc : c_E.π.app i₀ ≫
              CategoryTheory.Limits.pullback.fst p₀
                (AlgebraicGeometry.Spec.map (α_B₀.app i₀.unop)) = fst_gen :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [hc]
        have hy_V₀ : (c_E.π.app i₀).base y ∈ V₀ ↔ y ∈ Set.range j_W.base :=
          (congrArg (fun (O : E_gen.Opens) => y ∈ O) hPreV₀).to_iff
        change ((c_E.π.app i₀).base y ∈ V₀ ∧
          (c_E.π.app i₀ ≫
            CategoryTheory.Limits.pullback.fst p₀
              (AlgebraicGeometry.Spec.map (α_B₀.app i₀.unop))).base y ∈ U₀) ↔
          (c_E.π.app i₀).base y ∈ V₀
        rw [h_fst]
        exact ⟨fun h => h.1, fun h => ⟨h, hjW_sub (hy_V₀.mp h)⟩⟩
      obtain ⟨i₁, f₀₁, hEqV₁⟩ :=
        @AlgebraicGeometry.exists_map_preimage_eq_map_preimage Jᵒᵖ _ E_diag c_E hc_E _
          (@hAff_E_map) i₀ (V₀ ⊓ U_i₀) V₀
          (@TopologicalSpace.NoetherianSpace.isCompact _ _ (hNoeth_E i₀) _)
          (@TopologicalSpace.NoetherianSpace.isCompact _ _ (hNoeth_E i₀) _)
          hPre_inter₀
      let V₁ : (E_diag.obj i₁).Opens := (TopologicalSpace.Opens.map (E_diag.map f₀₁).base).obj V₀
      have hAffV₁ : AlgebraicGeometry.IsAffineOpen V₁ := by
        have _ := hAff_E_map f₀₁
        exact hAffV₀.preimage (E_diag.map f₀₁)
      refine ⟨i₁, V₁, hAffV₁, ?_, ?_⟩
      · intro x hx
        have hx' : x ∈ ((TopologicalSpace.Opens.map (E_diag.map f₀₁).base).obj (V₀ ⊓ U_i₀) :
            Set ↥(E_diag.obj i₁)) := by
          rw [hEqV₁]
          exact hx
        have hc : E_diag.map f₀₁ ≫
            CategoryTheory.Limits.pullback.fst p₀
              (AlgebraicGeometry.Spec.map (α_B₀.app i₀.unop)) =
            CategoryTheory.Limits.pullback.fst p₀
              (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop)) :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        change (CategoryTheory.Limits.pullback.fst p₀
          (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop))).base x ∈ U₀
        rw [← hc]
        exact hx'.2
      · have hc : c_E.π.app i₁ ≫ E_diag.map f₀₁ = c_E.π.app i₀ := c_E.w f₀₁
        apply TopologicalSpace.Opens.ext
        rw [← hPreV₀]
        ext (y : ↥E_gen)
        change (c_E.π.app i₁ ≫ E_diag.map f₀₁).base y ∈ V₀ ↔ (c_E.π.app i₀).base y ∈ V₀
        rw [hc]

    obtain ⟨i₁, V₁, hAffV₁, hSubV₁, hPreV₁⟩ := hExV₁
    let j₁ : J := i₁.unop
    let K₁ := CategoryTheory.Under j₁
    let S₁ := AlgebraicGeometry.Spec (R_diag.obj j₁)
    let Z_gen := AlgebraicGeometry.Spec (CommRingCat.of A_gen)
    let p_Z := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_gen)

    let c_Spec₁ : CategoryTheory.Limits.Cone ((CategoryTheory.Under.forget j₁).op ⋙ S_diag) :=
      CategoryTheory.Limits.Cone.whisker (CategoryTheory.Under.forget j₁).op c_Spec
    have hExSpec₁ : Nonempty (CategoryTheory.Limits.IsLimit c_Spec₁) :=
      ⟨((CategoryTheory.Functor.Initial.isLimitWhiskerEquiv
        (CategoryTheory.Under.forget j₁).op c_Spec).symm hc_Spec)⟩
    obtain ⟨hc_Spec₁⟩ := hExSpec₁

    let mkPullbackDiag : ∀ {X₁ : AlgebraicGeometry.Scheme.{u}} (q₁ : X₁ ⟶ S₁),
        K₁ᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} := fun q₁ =>
      { obj := fun u =>
          CategoryTheory.Limits.pullback q₁ (AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom))
        map := fun {u₁ u₂} f =>
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst q₁
              (AlgebraicGeometry.Spec.map (R_diag.map u₁.unop.hom)))
            (CategoryTheory.Limits.pullback.snd q₁
              (AlgebraicGeometry.Spec.map (R_diag.map u₁.unop.hom)) ≫
              AlgebraicGeometry.Spec.map (R_diag.map f.unop.right))
            (by
              rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← R_diag.map_comp, CategoryTheory.Under.w f.unop]
              exact CategoryTheory.Limits.pullback.condition)
        map_id := by
          intro u
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
              (CategoryTheory.Category.id_comp _).symm
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
            change _ ≫ AlgebraicGeometry.Spec.map (R_diag.map (𝟙 u.unop.right)) = _
            rw [R_diag.map_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
        map_comp := by
          intro u₁ u₂ u₃ f g
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
            change _ ≫ AlgebraicGeometry.Spec.map (R_diag.map (g.unop.right ≫ f.unop.right)) = _
            rw [R_diag.map_comp, AlgebraicGeometry.Spec.map_comp] }

    let mkBaseNat : ∀ {X₁ : AlgebraicGeometry.Scheme.{u}} (q₁ : X₁ ⟶ S₁),
        mkPullbackDiag q₁ ⟶ (CategoryTheory.Functor.const K₁ᵒᵖ).obj S₁ := fun q₁ =>
      { app := fun u =>
          CategoryTheory.Limits.pullback.snd q₁
            (AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom)) ≫
            AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom)
        naturality := by
          intro u₁ u₂ f
          simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
            CategoryTheory.Category.comp_id, mkPullbackDiag, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd]
          rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            ← R_diag.map_comp, CategoryTheory.Under.w f.unop] }

    let mkPullbackCone : ∀ {X₁ : AlgebraicGeometry.Scheme.{u}} (q₁ : X₁ ⟶ S₁)
        (π_X : Z_gen ⟶ X₁)
        (_hcomm : π_X ≫ q₁ = p_Z ≫ AlgebraicGeometry.Spec.map (ι_colim.app j₁)),
        CategoryTheory.Limits.Cone (mkPullbackDiag q₁) := fun q₁ π_X hcomm =>
      { pt := Z_gen
        π :=
          { app := fun u =>
              CategoryTheory.Limits.pullback.lift π_X
                (p_Z ≫ AlgebraicGeometry.Spec.map (ι_colim.app u.unop.right))
                (by
                  rw [hcomm, CategoryTheory.Category.assoc,
                    ← AlgebraicGeometry.Spec.map_comp (R_diag.map u.unop.hom)
                      (ι_colim.app u.unop.right)]
                  have hnat := ι_colim.naturality u.unop.hom
                  simp only [CategoryTheory.Functor.const_obj_obj,
                    CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
                  rw [hnat])
            naturality := by
              intro u₁ u₂ f
              apply CategoryTheory.Limits.pullback.hom_ext
              · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
                  CategoryTheory.Category.id_comp, mkPullbackDiag]
                rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
              · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
                  CategoryTheory.Category.id_comp, mkPullbackDiag]
                rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  ← AlgebraicGeometry.Spec.map_comp (R_diag.map f.unop.right)
                    (ι_colim.app u₁.unop.right)]
                have hnat := ι_colim.naturality f.unop.right
                simp only [CategoryTheory.Functor.const_obj_obj,
                  CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
                rw [hnat] } }

    have hAffineConeAndLift : ∀ {X₁ : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine X₁]
        (q₁ : X₁ ⟶ S₁) [AlgebraicGeometry.LocallyOfFinitePresentation q₁]
        (π_X : Z_gen ⟶ X₁)
        (hPb_X : CategoryTheory.IsPullback π_X p_Z q₁ (AlgebraicGeometry.Spec.map (ι_colim.app j₁))),
        let D_X := mkPullbackDiag q₁
        let t_X := mkBaseNat q₁
        let c_X := mkPullbackCone q₁ π_X hPb_X.w
        Nonempty (CategoryTheory.Limits.IsLimit c_X) ∧
        (∀ {u₁ u₂ : K₁ᵒᵖ} (f : u₁ ⟶ u₂), AlgebraicGeometry.IsAffineHom (D_X.map f)) ∧
        (∀ {Y₁ : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine Y₁]
           (q_Y : Y₁ ⟶ S₁) [AlgebraicGeometry.LocallyOfFinitePresentation q_Y]
           (π_Y : Z_gen ⟶ Y₁),
           π_Y ≫ q_Y = p_Z ≫ AlgebraicGeometry.Spec.map (ι_colim.app j₁) →
           ∃ (k : K₁) (u_hom : D_X.obj (Opposite.op k) ⟶ Y₁),
             u_hom ≫ q_Y = t_X.app (Opposite.op k) ∧
             c_X.π.app (Opposite.op k) ≫ u_hom = π_Y) := by
      intro X₁ _ q₁ _ π_X hPb_X D_X t_X c_X
      let p_X_nat : D_X ⟶ (CategoryTheory.Under.forget j₁).op ⋙ S_diag :=
        { app := fun u =>
            CategoryTheory.Limits.pullback.snd q₁
              (AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom))
          naturality := fun _ _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _ }
      have hPb_X_cone : ∀ u : K₁ᵒᵖ,
          CategoryTheory.IsPullback (c_X.π.app u) p_Z (p_X_nat.app u) (c_Spec₁.π.app u) := by
        intro u
        refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          (CategoryTheory.IsPullback.of_hasPullback q₁
            (AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom)))
        change CategoryTheory.IsPullback
          (c_X.π.app u ≫ CategoryTheory.Limits.pullback.fst q₁
            (AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom)))
          p_Z q₁
          (AlgebraicGeometry.Spec.map (ι_colim.app u.unop.right) ≫
            AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom))
        have h1 : c_X.π.app u ≫
            CategoryTheory.Limits.pullback.fst q₁
              (AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom)) = π_X :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h2 : AlgebraicGeometry.Spec.map (ι_colim.app u.unop.right) ≫
            AlgebraicGeometry.Spec.map (R_diag.map u.unop.hom) =
            AlgebraicGeometry.Spec.map (ι_colim.app j₁) := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have hnat := ι_colim.naturality u.unop.hom
          simp only [CategoryTheory.Functor.const_obj_obj,
            CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
          rw [hnat]
        rw [h1, h2]
        exact hPb_X
      have _ : CategoryTheory.IsConnected K₁ᵒᵖ := CategoryTheory.IsCofiltered.isConnected K₁ᵒᵖ
      have hExLimX : Nonempty (CategoryTheory.Limits.IsLimit c_X) :=
        ⟨CategoryTheory.Limits.isLimitOfIsPullbackOfIsConnected
          p_X_nat c_X c_Spec₁
          { hom := p_Z
            w := fun _ => (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm }
          hPb_X_cone hc_Spec₁⟩
      obtain ⟨hc_X⟩ := hExLimX
      have hAff_D_X : ∀ u : K₁ᵒᵖ, AlgebraicGeometry.IsAffine (D_X.obj u) := fun _ => inferInstance
      have hAffHom_D_X : ∀ {u₁ u₂ : K₁ᵒᵖ} (f : u₁ ⟶ u₂),
          AlgebraicGeometry.IsAffineHom (D_X.map f) := by
        intro u₁ u₂ f
        have _ := hAff_D_X u₁
        have _ := hAff_D_X u₂
        exact AlgebraicGeometry.isAffineHom_of_isAffine (D_X.map f)
      refine ⟨⟨hc_X⟩, hAffHom_D_X, ?_⟩
      intro Y₁ _ q_Y _ π_Y hπ_Y
      let Γ_X : K₁ ⥤ CommRingCat.{u} :=
        { obj := fun k => (D_X.obj (Opposite.op k)).presheaf.obj (Opposite.op ⊤)
          map := fun f => (D_X.map f.op).appTop
          map_id := by
            intro k
            change (D_X.map (𝟙 (Opposite.op k))).appTop = 𝟙 _
            rw [D_X.map_id, AlgebraicGeometry.Scheme.Hom.id_appTop]
          map_comp := by
            intro k₁ k₂ k₃ f g
            change (D_X.map (g.op ≫ f.op)).appTop = _
            rw [D_X.map_comp, AlgebraicGeometry.Scheme.Hom.comp_appTop] }
      let α_Γ : (CategoryTheory.Functor.const K₁).obj (S₁.presheaf.obj (Opposite.op ⊤)) ⟶ Γ_X :=
        { app := fun k => (t_X.app (Opposite.op k)).appTop
          naturality := by
            intro k₁ k₂ f
            simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.id_comp, Γ_X]
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, t_X.naturality f.op]
            simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.comp_id] }
      let c_Γ : CategoryTheory.Limits.Cocone Γ_X :=
        { pt := Z_gen.presheaf.obj (Opposite.op ⊤)
          ι :=
            { app := fun k => (c_X.π.app (Opposite.op k)).appTop
              naturality := by
                intro k₁ k₂ f
                simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
                  CategoryTheory.Category.comp_id, Γ_X]
                rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, c_X.w f.op] } }
      have hExColimΓ : Nonempty (CategoryTheory.Limits.IsColimit c_Γ) := by
        have _ : CategoryTheory.Limits.ReflectsColimit Γ_X (CategoryTheory.forget CommRingCat.{u}) :=
          CategoryTheory.Limits.reflectsColimit_of_reflectsIsomorphisms
            Γ_X (CategoryTheory.forget CommRingCat.{u})
        refine ⟨CategoryTheory.Limits.isColimitOfReflects (CategoryTheory.forget CommRingCat.{u}) ?_⟩
        refine CategoryTheory.Limits.Types.FilteredColimit.isColimitOf'
          (Γ_X ⋙ CategoryTheory.forget CommRingCat.{u})
          ((CategoryTheory.forget CommRingCat.{u}).mapCocone c_Γ) ?_ ?_
        · intro s
          obtain ⟨u, t_s, ht_s⟩ :=
            @AlgebraicGeometry.exists_appTop_π_eq_of_isAffine_of_isLimit
              K₁ᵒᵖ _ D_X c_X hc_X _ hAff_D_X s
          exact ⟨u.unop, t_s, ht_s.symm⟩
        · intro k x y hxy
          have hsub : (c_X.π.app (Opposite.op k)).appTop.hom (x - y) = 0 := by
            rw [map_sub, sub_eq_zero]
            exact hxy
          obtain ⟨u', f', hf'⟩ :=
            @AlgebraicGeometry.exists_appTop_map_eq_zero_of_isAffine_of_isLimit
              K₁ᵒᵖ _ D_X c_X hc_X _ hAff_D_X (Opposite.op k) (x - y) hsub
          change (D_X.map f').appTop.hom (x - y) = 0 at hf'
          rw [map_sub, sub_eq_zero] at hf'
          exact ⟨u'.unop, f'.unop, hf'⟩
      obtain ⟨hc_Γ⟩ := hExColimΓ
      have hFP_qY : (CommRingCat.Hom.hom q_Y.appTop).FinitePresentation := by
        have hSpec_eq : AlgebraicGeometry.Spec.map q_Y.appTop =
            Y₁.isoSpec.inv ≫ q_Y ≫ S₁.isoSpec.hom := by
          rw [← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Scheme.isoSpec_inv_naturality q_Y,
            CategoryTheory.Category.assoc, S₁.isoSpec.inv_hom_id,
            CategoryTheory.Category.comp_id]
        have hLFP_map : AlgebraicGeometry.LocallyOfFinitePresentation
            (AlgebraicGeometry.Spec.map q_Y.appTop) := by
          rw [hSpec_eq]
          infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hLFP_map
      have hComm_Γ : ∀ k : K₁, q_Y.appTop ≫ π_Y.appTop = α_Γ.app k ≫ c_Γ.ι.app k := by
        intro k
        change q_Y.appTop ≫ π_Y.appTop =
          (t_X.app (Opposite.op k)).appTop ≫ (c_X.π.app (Opposite.op k)).appTop
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hπ_Y]
        congr 1
        simp only [t_X, mkBaseNat, c_X, mkPullbackCone, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd]
        rw [CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp (R_diag.map k.hom) (ι_colim.app k.right)]
        have hnat := ι_colim.naturality k.hom
        simp only [CategoryTheory.Functor.const_obj_obj,
          CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
        rw [hnat]
      obtain ⟨k₁, g', hfg', hg'_eq⟩ :=
        @RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          K₁ _ _ (S₁.presheaf.obj (Opposite.op ⊤)) Γ_X α_Γ _ q_Y.appTop c_Γ hc_Γ _
          hFP_qY π_Y.appTop hComm_Γ
      have _ : AlgebraicGeometry.IsAffine (D_X.obj (Opposite.op k₁)) := hAff_D_X (Opposite.op k₁)
      let u_hom : D_X.obj (Opposite.op k₁) ⟶ Y₁ :=
        (D_X.obj (Opposite.op k₁)).isoSpec.hom ≫ AlgebraicGeometry.Spec.map g' ≫ Y₁.isoSpec.inv
      let t_k₁ : D_X.obj (Opposite.op k₁) ⟶ S₁ := t_X.app (Opposite.op k₁)
      let π_k₁ : Z_gen ⟶ D_X.obj (Opposite.op k₁) := c_X.π.app (Opposite.op k₁)
      refine ⟨k₁, u_hom, ?_, ?_⟩
      · calc
          u_hom ≫ q_Y
            = (D_X.obj (Opposite.op k₁)).isoSpec.hom ≫ AlgebraicGeometry.Spec.map g' ≫
                (Y₁.isoSpec.inv ≫ q_Y) := by
                  simp only [u_hom, CategoryTheory.Category.assoc]
          _ = (D_X.obj (Opposite.op k₁)).isoSpec.hom ≫ AlgebraicGeometry.Spec.map g' ≫
                (AlgebraicGeometry.Spec.map q_Y.appTop ≫ S₁.isoSpec.inv) := by
                  rw [← AlgebraicGeometry.Scheme.isoSpec_inv_naturality q_Y]
          _ = ((D_X.obj (Opposite.op k₁)).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (q_Y.appTop ≫ g')) ≫ S₁.isoSpec.inv := by
                  rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map g'),
                    ← AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
          _ = ((D_X.obj (Opposite.op k₁)).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map t_k₁.appTop) ≫ S₁.isoSpec.inv := by
                  rw [hfg']
          _ = t_X.app (Opposite.op k₁) := by
                  rw [AlgebraicGeometry.Scheme.isoSpec_hom_naturality t_k₁,
                    CategoryTheory.Category.assoc, S₁.isoSpec.hom_inv_id,
                    CategoryTheory.Category.comp_id]
      · calc
          c_X.π.app (Opposite.op k₁) ≫ u_hom
            = (π_k₁ ≫ (D_X.obj (Opposite.op k₁)).isoSpec.hom) ≫
                AlgebraicGeometry.Spec.map g' ≫ Y₁.isoSpec.inv := by
                  simp only [u_hom, π_k₁, CategoryTheory.Category.assoc]
          _ = (Z_gen.isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (g' ≫ π_k₁.appTop)) ≫
                Y₁.isoSpec.inv := by
                  rw [← AlgebraicGeometry.Scheme.isoSpec_hom_naturality π_k₁,
                    CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
                      (AlgebraicGeometry.Spec.map π_k₁.appTop),
                    ← AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
          _ = (Z_gen.isoSpec.hom ≫ AlgebraicGeometry.Spec.map π_Y.appTop) ≫ Y₁.isoSpec.inv := by
                  change (Z_gen.isoSpec.hom ≫
                    AlgebraicGeometry.Spec.map (g' ≫ c_Γ.ι.app k₁)) ≫ Y₁.isoSpec.inv = _
                  rw [← hg'_eq]
          _ = π_Y := by
                  rw [AlgebraicGeometry.Scheme.isoSpec_hom_naturality π_Y,
                    CategoryTheory.Category.assoc, Y₁.isoSpec.hom_inv_id,
                    CategoryTheory.Category.comp_id]

    
    let L₁ := CategoryTheory.Limits.pullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₁))
    let p_L₁ : L₁ ⟶ S₁ :=
      CategoryTheory.Limits.pullback.snd f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₁))
    have hEx_πL : ∃ (π_L_gen : Z_gen ⟶ L₁),
        CategoryTheory.IsPullback π_L_gen p_Z p_L₁
          (AlgebraicGeometry.Spec.map (ι_colim.app j₁)) := by
      let π_L := CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen))
        (p_Z ≫ AlgebraicGeometry.Spec.map (ι_colim.app j₁))
        (by
          rw [hPb_gen.w, CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp (α_B₀.app j₁) (ι_colim.app j₁), hα_comm j₁])
      refine ⟨π_L, CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₁)))⟩
      rw [CategoryTheory.Limits.pullback.lift_fst, ← AlgebraicGeometry.Spec.map_comp, hα_comm j₁]
      exact hPb_gen
    obtain ⟨π_L_gen, hPb_L_gen⟩ := hEx_πL

    let W₁ : AlgebraicGeometry.Scheme.{u} := V₁.toScheme
    have _ : AlgebraicGeometry.IsAffine W₁ := hAffV₁
    let q_W₁ : W₁ ⟶ S₁ := V₁.ι ≫ p_nat.app i₁
    have hEx_πW : ∃ (π_W_gen : Z_gen ⟶ W₁),
        CategoryTheory.IsPullback π_W_gen p_Z q_W₁
          (AlgebraicGeometry.Spec.map (ι_colim.app j₁)) := by
      let π_W := AlgebraicGeometry.IsOpenImmersion.lift V₁.ι (j_W ≫ c_E.π.app i₁)
        (by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          have hx : j_W.base x ∈ j_W.opensRange := ⟨x, rfl⟩
          rw [← hPreV₁] at hx
          exact hx)
      have hPb_W_top : CategoryTheory.IsPullback π_W j_W V₁.ι (c_E.π.app i₁) := by
        refine AlgebraicGeometry.IsOpenImmersion.isPullback π_W j_W V₁.ι (c_E.π.app i₁)
          (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm ?_
        rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
        exact hPreV₁
      refine ⟨π_W, ?_⟩
      have hPasted := hPb_W_top.paste_vert (hPb_E_cone i₁)
      rwa [hjW_p] at hPasted
    obtain ⟨π_W_gen, hPb_W_gen⟩ := hEx_πW

    obtain ⟨⟨hc_L⟩, hAffHom_L, hLift_from_L⟩ := hAffineConeAndLift p_L₁ π_L_gen hPb_L_gen
    obtain ⟨⟨hc_W⟩, hAffHom_W, hLift_from_W⟩ := hAffineConeAndLift q_W₁ π_W_gen hPb_W_gen

    let D_L := mkPullbackDiag p_L₁
    let t_L := mkBaseNat p_L₁
    let c_L := mkPullbackCone p_L₁ π_L_gen hPb_L_gen.w
    let D_W := mkPullbackDiag q_W₁
    let t_W := mkBaseNat q_W₁
    let c_W := mkPullbackCone q_W₁ π_W_gen hPb_W_gen.w
    have hComp_L : ∀ u : K₁ᵒᵖ, CompactSpace ↥(D_L.obj u) := fun _ => inferInstance
    have hComp_W : ∀ u : K₁ᵒᵖ, CompactSpace ↥(D_W.obj u) := fun _ => inferInstance

    
    have hEx_uv2 : ∃ (k₂ : K₁)
        (u₂ : D_L.obj (Opposite.op k₂) ⟶ D_W.obj (Opposite.op k₂))
        (v₂ : D_W.obj (Opposite.op k₂) ⟶ D_L.obj (Opposite.op k₂)),
        u₂ ≫ CategoryTheory.Limits.pullback.snd q_W₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom)) =
          CategoryTheory.Limits.pullback.snd p_L₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom)) ∧
        v₂ ≫ CategoryTheory.Limits.pullback.snd p_L₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom)) =
          CategoryTheory.Limits.pullback.snd q_W₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom)) ∧
        c_L.π.app (Opposite.op k₂) ≫ u₂ = c_W.π.app (Opposite.op k₂) ∧
        c_W.π.app (Opposite.op k₂) ≫ v₂ = c_L.π.app (Opposite.op k₂) := by
      obtain ⟨k_u, u_base, hu_base_q, hu_base_π⟩ := hLift_from_L q_W₁ π_W_gen hPb_W_gen.w
      obtain ⟨k_v, v_base, hv_base_q, hv_base_π⟩ := hLift_from_W p_L₁ π_L_gen hPb_L_gen.w
      let k₂ : K₁ := CategoryTheory.IsFiltered.max k_u k_v
      let g_u2 : k_u ⟶ k₂ := CategoryTheory.IsFiltered.leftToMax k_u k_v
      let g_v2 : k_v ⟶ k₂ := CategoryTheory.IsFiltered.rightToMax k_u k_v
      let u₂ : D_L.obj (Opposite.op k₂) ⟶ D_W.obj (Opposite.op k₂) :=
        CategoryTheory.Limits.pullback.lift
          (D_L.map g_u2.op ≫ u_base)
          (CategoryTheory.Limits.pullback.snd p_L₁ (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom)))
          (by
            rw [CategoryTheory.Category.assoc, hu_base_q]
            have hnat := t_L.naturality g_u2.op
            simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.comp_id] at hnat
            exact hnat)
      let v₂ : D_W.obj (Opposite.op k₂) ⟶ D_L.obj (Opposite.op k₂) :=
        CategoryTheory.Limits.pullback.lift
          (D_W.map g_v2.op ≫ v_base)
          (CategoryTheory.Limits.pullback.snd q_W₁ (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom)))
          (by
            rw [CategoryTheory.Category.assoc, hv_base_q]
            have hnat := t_W.naturality g_v2.op
            simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.comp_id] at hnat
            exact hnat)
      refine ⟨k₂, u₂, v₂,
        CategoryTheory.Limits.pullback.lift_snd _ _ _,
        CategoryTheory.Limits.pullback.lift_snd _ _ _, ?_, ?_⟩
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, c_L.w g_u2.op, hu_base_π]
          exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, c_W.w g_v2.op, hv_base_π]
          exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm

    obtain ⟨k₂, u₂, v₂, hu₂_snd, hv₂_snd, hu₂_π, hv₂_π⟩ := hEx_uv2

    
    have hEx_uv3 : ∃ (k₃ : K₁)
        (u₃ : D_L.obj (Opposite.op k₃) ⟶ D_W.obj (Opposite.op k₃))
        (v₃ : D_W.obj (Opposite.op k₃) ⟶ D_L.obj (Opposite.op k₃)),
        u₃ ≫ CategoryTheory.Limits.pullback.snd q_W₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₃.hom)) =
          CategoryTheory.Limits.pullback.snd p_L₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₃.hom)) ∧
        v₃ ≫ CategoryTheory.Limits.pullback.snd p_L₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₃.hom)) =
          CategoryTheory.Limits.pullback.snd q_W₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₃.hom)) ∧
        u₃ ≫ v₃ = 𝟙 _ ∧
        c_L.π.app (Opposite.op k₃) ≫ u₃ = c_W.π.app (Opposite.op k₃) ∧
        c_W.π.app (Opposite.op k₃) ≫ v₃ = c_L.π.app (Opposite.op k₃) := by
      let fst_L₂ := CategoryTheory.Limits.pullback.fst p_L₁
        (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom))
      obtain ⟨op_k₃, f₂₃, hf₂₃⟩ :=
        @AlgebraicGeometry.Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType
          K₁ᵒᵖ _ S₁ L₁ D_L t_L p_L₁ c_L hc_L hComp_L _ _ (@hAffHom_L) (Opposite.op k₂)
          ((u₂ ≫ v₂) ≫ fst_L₂) fst_L₂
          (by
            symm
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              ← CategoryTheory.Category.assoc, CategoryTheory.Category.assoc u₂, hv₂_snd,
              hu₂_snd])
          (by
            exact (CategoryTheory.Limits.pullback.condition (f := p_L₁)
              (g := AlgebraicGeometry.Spec.map (R_diag.map k₂.hom))).symm)
          (by
            rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hu₂_π, hv₂_π])
      let k₃ : K₁ := op_k₃.unop
      let g₂₃ : k₂ ⟶ k₃ := f₂₃.unop
      let u₃ : D_L.obj (Opposite.op k₃) ⟶ D_W.obj (Opposite.op k₃) :=
        CategoryTheory.Limits.pullback.lift
          (D_L.map f₂₃ ≫ u₂ ≫ CategoryTheory.Limits.pullback.fst q_W₁
            (AlgebraicGeometry.Spec.map (R_diag.map k₂.hom)))
          (CategoryTheory.Limits.pullback.snd p_L₁ (AlgebraicGeometry.Spec.map (R_diag.map k₃.hom)))
          (by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc u₂,
              hu₂_snd, ← CategoryTheory.Category.assoc (D_L.map f₂₃),
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              ← AlgebraicGeometry.Spec.map_comp, ← R_diag.map_comp, CategoryTheory.Under.w g₂₃])
      let v₃ : D_W.obj (Opposite.op k₃) ⟶ D_L.obj (Opposite.op k₃) :=
        CategoryTheory.Limits.pullback.lift
          (D_W.map f₂₃ ≫ v₂ ≫ fst_L₂)
          (CategoryTheory.Limits.pullback.snd q_W₁ (AlgebraicGeometry.Spec.map (R_diag.map k₃.hom)))
          (by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc v₂,
              hv₂_snd, ← CategoryTheory.Category.assoc (D_W.map f₂₃),
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              ← AlgebraicGeometry.Spec.map_comp, ← R_diag.map_comp, CategoryTheory.Under.w g₂₃])
      have hu₃_comm : u₃ ≫ D_W.map f₂₃ = D_L.map f₂₃ ≫ u₂ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc, hu₂_snd, CategoryTheory.Limits.pullback.lift_snd]
      refine ⟨k₃, u₃, v₃,
        CategoryTheory.Limits.pullback.lift_snd _ _ _,
        CategoryTheory.Limits.pullback.lift_snd _ _ _, ?_, ?_, ?_⟩
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc u₃, hu₃_comm]
          have h_eq : D_L.map f₂₃ ≫ (u₂ ≫ v₂) ≫ fst_L₂ = D_L.map f₂₃ ≫ fst_L₂ := by
            simpa only [CategoryTheory.Category.assoc] using hf₂₃
          rw [show (D_L.map f₂₃ ≫ u₂) ≫ v₂ ≫ fst_L₂ = D_L.map f₂₃ ≫ (u₂ ≫ v₂) ≫ fst_L₂ by
            simp only [CategoryTheory.Category.assoc], h_eq]
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, c_L.w f₂₃, ← CategoryTheory.Category.assoc, hu₂_π,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, c_W.w f₂₃, ← CategoryTheory.Category.assoc, hv₂_π,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
