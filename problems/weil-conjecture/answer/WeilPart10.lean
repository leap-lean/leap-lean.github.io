        obtain ⟨θ_W, hθW_inj, hθW_alg, hθW_rng⟩ := hLocLift W hW hW_ne φ_W hSpecW p
        obtain ⟨θ_i, hθi_inj, _, hθi_rng⟩ := hLocLift (U_et i) (hAff_et i) (hNe_et i)
