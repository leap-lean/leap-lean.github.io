    have hInd : ∀ d : ℕ,
        FiniteDimensional κ (O ⧸ m_O ^ (d + 1)) ∧
        Module.finrank κ (O ⧸ m_O ^ (d + 1)) =
          Module.finrank κ E * Module.finrank K (R ⧸ m_R ^ (d + 1)) := by
      intro d
      induction d with
      | zero =>
        let e_O1 : (O ⧸ m_O ^ 1) ≃ₗ[κ] E :=
          { (Ideal.quotEquivOfEq (pow_one m_O)) with
            map_smul' := fun c x => by
              obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
