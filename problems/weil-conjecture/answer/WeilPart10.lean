                rw [map_mul, map_mul, hut_eq]
            _ = (ϖ * algebraMap A R_P s₁.1) * (u_t * algebraMap A R_P s₂.1) := by ring
            _ = algebraMap A R_P (m₁ * m₂) := by rw [hm₁, hm₂, map_mul]
        have hs₁₂_not : s₁.1 * s₂.1 ∉ p_P.asIdeal :=
          (p_P.asIdeal.primeCompl.mul_mem s₁.2 s₂.2)
        have hprod_sq : (s₁.1 * s₂.1) * t_P ∈ p_P.asIdeal ^ 2 := by
          rw [hprod_eq, pow_two]
          exact Ideal.mul_mem_mul hm₁_pP hm₂_pP
        exact ht_not_sq (hCancelSq (s₁.1 * s₂.1) t_P hs₁₂_not hprod_sq)
      have hut_unit : IsUnit u_t := IsLocalRing.notMem_maximalIdeal.mp hut_not_max
      obtain ⟨u_inv, hu_inv⟩ := hut_unit.exists_right_inv
      have hϖ_eq : ϖ = algebraMap A R_P t_P * u_inv := by
        calc ϖ = ϖ * (u_t * u_inv) := by rw [hu_inv, mul_one]
          _ = (ϖ * u_t) * u_inv := by ring
          _ = algebraMap A R_P t_P * u_inv := by rw [hut_eq]
      intro z hz
      have hz_max : algebraMap A R_P z ∈ Ideal.span ({ϖ} : Set R_P) := by
        rw [← Ideal.submodule_span_eq, ← hϖ_span]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_P p_P.asIdeal z).mpr hz
      obtain ⟨c_z, hcz⟩ := Ideal.mem_span_singleton.mp hz_max
      obtain ⟨⟨q_z, s_z⟩, hqs⟩ := IsLocalization.surj p_P.asIdeal.primeCompl (u_inv * c_z)
      refine ⟨s_z.1, q_z, s_z.2, hinj_ARP ?_⟩
      calc algebraMap A R_P (s_z.1 * z)
          = algebraMap A R_P s_z.1 * (ϖ * c_z) := by rw [map_mul, hcz]
        _ = ((u_inv * c_z) * algebraMap A R_P s_z.1) * algebraMap A R_P t_P := by
            rw [hϖ_eq]; ring
        _ = algebraMap A R_P (q_z * t_P) := by rw [hqs, map_mul]
    obtain ⟨f, hf_not_pP, hStd_Af⟩ := hSmHt1 A hDimA p_P.asIdeal (hHtA p_P.asIdeal)
    let A_f := Localization.Away f
    have hf_powers_RP : ∀ y : Submonoid.powers f, IsUnit (algebraMap A R_P y.1) := by
      rintro ⟨_, k, rfl⟩
      rw [map_pow]
      exact (IsLocalization.map_units R_P (⟨f, hf_not_pP⟩ : p_P.asIdeal.primeCompl)).pow k
    have hEx_φfP : ∃ φ_fP : A_f →+* R_P, φ_fP.comp (algebraMap A A_f) = algebraMap A R_P :=
      ⟨IsLocalization.lift (M := Submonoid.powers f) (S := A_f) (g := algebraMap A R_P) hf_powers_RP,
       IsLocalization.lift_comp (M := Submonoid.powers f) (S := A_f) (g := algebraMap A R_P) hf_powers_RP⟩
    obtain ⟨φ_fP, hφ_fP_comp⟩ := hEx_φfP
    have : Nontrivial R_P := inferInstance
    have : Nontrivial A_f := RingHom.domain_nontrivial φ_fP
    have : Algebra.IsStandardSmoothOfRelativeDimension 1 Ω A_f := hStd_Af
    have : Algebra.IsStandardSmooth Ω A_f := hStd_Af.isStandardSmooth
    have : Module.Free A_f (KaehlerDifferential Ω A_f) :=
      Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hRank_Af : Module.finrank A_f (KaehlerDifferential Ω A_f) = 1 := by
      have hrk := @Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
        Ω A_f _ _ _ _ 1 hStd_Af
      exact Module.finrank_eq_of_rank_eq (by simpa using hrk)
    let S_f : Submonoid A_f := Submonoid.map (algebraMap A A_f) p_P.asIdeal.primeCompl
    let algAfRP : Algebra A_f R_P := φ_fP.toAlgebra
    have hGenRP : ∃ ω₀ : KaehlerDifferential Ω R_P,
        ∀ η : KaehlerDifferential Ω R_P, ∃ r : R_P, r • ω₀ = η := by
      letI : Algebra A_f R_P := algAfRP
      have hAlgΩRP : (φ_fP.comp (algebraMap Ω A_f)) = algebraMap Ω R_P := by
        have h1 : algebraMap Ω A_f = (algebraMap A A_f).comp (algebraMap Ω A) :=
          IsScalarTower.algebraMap_eq Ω A A_f
        rw [h1, ← RingHom.comp_assoc, hφ_fP_comp]
        exact (IsScalarTower.algebraMap_eq Ω A R_P).symm
      haveI : IsScalarTower Ω A_f R_P := IsScalarTower.of_algebraMap_eq' hAlgΩRP.symm
      haveI hLoc_fP : IsLocalization S_f R_P := by
        refine ⟨⟨?_, ?_, ?_⟩⟩
        · rintro ⟨_, s, hs, rfl⟩
          change IsUnit (φ_fP (algebraMap A A_f s))
          rw [← RingHom.comp_apply, hφ_fP_comp]
          exact IsLocalization.map_units R_P ⟨s, hs⟩
        · intro z
          obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj p_P.asIdeal.primeCompl z
          refine ⟨⟨algebraMap A A_f a, ⟨algebraMap A A_f s.1, s.1, s.2, rfl⟩⟩, ?_⟩
          change z * φ_fP (algebraMap A A_f s.1) = φ_fP (algebraMap A A_f a)
          rw [← RingHom.comp_apply, ← RingHom.comp_apply, hφ_fP_comp]
          exact hzs
        · intro x₁ x₂ hx_eq
          obtain ⟨k₁, a₁, hk₁⟩ := IsLocalization.Away.surj f x₁
          obtain ⟨k₂, a₂, hk₂⟩ := IsLocalization.Away.surj f x₂
          let b₁ : A := a₁ * f ^ k₂
          let b₂ : A := a₂ * f ^ k₁
          have h_eq_RP : algebraMap A R_P b₁ = algebraMap A R_P b₂ := by
            have hx₁_k : x₁ * (algebraMap A A_f f) ^ (k₁ + k₂) = algebraMap A A_f b₁ := by
              calc x₁ * (algebraMap A A_f f) ^ (k₁ + k₂)
                  = (x₁ * (algebraMap A A_f f) ^ k₁) * (algebraMap A A_f f) ^ k₂ := by
                    rw [pow_add, mul_assoc]
                _ = algebraMap A A_f b₁ := by rw [hk₁, ← map_pow, ← map_mul]
            have hx₂_k : x₂ * (algebraMap A A_f f) ^ (k₁ + k₂) = algebraMap A A_f b₂ := by
              calc x₂ * (algebraMap A A_f f) ^ (k₁ + k₂)
                  = (x₂ * (algebraMap A A_f f) ^ k₂) * (algebraMap A A_f f) ^ k₁ := by
                    rw [add_comm k₁ k₂, pow_add, mul_assoc]
                _ = algebraMap A A_f b₂ := by rw [hk₂, ← map_pow, ← map_mul]
            have h1 := congrArg φ_fP hx₁_k
            have h2 := congrArg φ_fP hx₂_k
            change φ_fP x₁ = φ_fP x₂ at hx_eq
            rw [map_mul, hx_eq] at h1
            rw [map_mul] at h2
            have h12 := h1.symm.trans h2
            simpa [← RingHom.comp_apply, hφ_fP_comp] using h12
          obtain ⟨s, hs_eq⟩ := IsLocalization.exists_of_eq (M := p_P.asIdeal.primeCompl) h_eq_RP
          have hsf_mem : s.1 * f ^ (k₁ + k₂) ∈ p_P.asIdeal.primeCompl :=
            p_P.asIdeal.primeCompl.mul_mem s.2 (p_P.asIdeal.primeCompl.pow_mem hf_not_pP (k₁ + k₂))
          refine ⟨⟨algebraMap A A_f (s.1 * f ^ (k₁ + k₂)),
            s.1 * f ^ (k₁ + k₂), hsf_mem, rfl⟩, ?_⟩
          calc algebraMap A A_f (s.1 * f ^ (k₁ + k₂)) * x₁
              = algebraMap A A_f s.1 * ((x₁ * (algebraMap A A_f f) ^ k₁) *
                  (algebraMap A A_f f) ^ k₂) := by
                rw [map_mul, map_pow, pow_add]; ring
            _ = algebraMap A A_f (s.1 * b₁) := by
                rw [hk₁]; simp only [b₁, map_mul, map_pow]
            _ = algebraMap A A_f (s.1 * b₂) := by rw [hs_eq]
            _ = algebraMap A A_f s.1 * ((algebraMap A A_f a₂) *
                  (algebraMap A A_f f) ^ k₁) := by
                simp only [b₂, map_mul, map_pow]
            _ = algebraMap A A_f (s.1 * f ^ (k₁ + k₂)) * x₂ := by
                rw [← hk₂, map_mul, map_pow, pow_add]; ring
      haveI : IsLocalizedModule S_f (KaehlerDifferential.map Ω Ω A_f R_P) :=
        KaehlerDifferential.isLocalizedModule_map Ω A_f R_P S_f
      haveI : Module.Free R_P (KaehlerDifferential Ω R_P) :=
        Module.free_of_isLocalizedModule S_f (KaehlerDifferential.map Ω Ω A_f R_P)
      have hFinrank_RP : Module.finrank R_P (KaehlerDifferential Ω R_P) = 1 := by
        rw [Module.finrank_of_isLocalizedModule_of_free R_P S_f (KaehlerDifferential.map Ω Ω A_f R_P)]
        exact hRank_Af
      obtain ⟨ω₀, _, hGen⟩ := (finrank_eq_one_iff').mp hFinrank_RP
      exact ⟨ω₀, hGen⟩
    obtain ⟨ω₀, hGenRP⟩ := hGenRP
    have hBij_P : Function.Bijective (algebraMap Ω (A ⧸ p_P.asIdeal)) :=
      weil_algClosed_quotient_maximal_bijective A p_P.asIdeal
    let e_P : Ω ≃+* (A ⧸ p_P.asIdeal) := RingEquiv.ofBijective _ hBij_P
    let ev_P : A →+* Ω := e_P.symm.toRingHom.comp (Ideal.Quotient.mk p_P.asIdeal)
    have hevP_c : ∀ c : Ω, ev_P (algebraMap Ω A c) = c := fun c => e_P.symm_apply_apply c
    have hevP_ker : ∀ x : A, ev_P x = 0 ↔ x ∈ p_P.asIdeal := by
      intro x
      change e_P.symm (Ideal.Quotient.mk p_P.asIdeal x) = 0 ↔ x ∈ p_P.asIdeal
      rw [RingEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
    have hsub_mem_P : ∀ x : A, x - algebraMap Ω A (ev_P x) ∈ p_P.asIdeal := by
      intro x
