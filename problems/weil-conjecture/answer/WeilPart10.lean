            ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0)))) := by
        dsimp only [j_R, p_R, weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
