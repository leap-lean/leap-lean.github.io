      let u₃_tilde := liftAt j₃ u₃_cat f_M (fun _ => rfl) hu₃_comm
      let v₃_tilde := liftAt j₃ v₃_cat f_B (fun _ => rfl) hv₃_comm

      have h_vu₃_id : v₃_tilde.comp u₃_tilde =
          AlgHom.id ↥(Algebra.adjoin B₀ (↑j₃.1 : Set K))
            (TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j₃.1 : Set K)) M₁) := by
