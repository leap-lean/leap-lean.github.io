    fun α ν =>
      ⟨PrimeSpectrum.comap (mapTP α (hSub_rf α ν)).toRingHom ⁻¹' (O_rf α ν).1,
        (O_rf α ν).2.preimage (PrimeSpectrum.continuous_comap _)⟩

  let U₁ : ∀ (α : Fin N),
      TopologicalSpace.Opens
        (PrimeSpectrum (TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₁_nod : Set K_bar)) (R₀ α))) :=
    fun α => (⨆ μ : Fin (m α), PrimeSpectrum.basicOpen (f₁ α μ)) ⊔ (⨆ ν : Fin (s α), O₁ α ν)

  have hU₁_gen : ∀ (α : Fin N) (q_bar : PrimeSpectrum (TensorProduct B₀ K_bar (R₀ α))),
