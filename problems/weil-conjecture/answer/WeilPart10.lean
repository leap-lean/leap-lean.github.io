            rw [hsum_eq, hmk_sum, MvPolynomial.support_sum_monomial_coeff p]
          obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
          obtain ⟨n, hn⟩ := nd.den_mem
          change X_a ^ n = nd.den.1 at hn
          have hXa_ne : (X_a ^ n : MvPolynomial (Fin 2) R) ≠ 0 := by
