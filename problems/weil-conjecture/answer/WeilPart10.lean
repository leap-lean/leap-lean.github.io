    have hNePair : (⟨α₀, p₀⟩ : Σ α : Fin (c + 1), PrimeSpectrum (B_tilde α)) ≠ ⟨α₁, p₁⟩ :=
      hNePairGen α₀ α₁ p₀ p₁ ψ_br₀ ψ_br₁ hp₀_ker hp₁_ker hComp₀ hComp₁
        (fun y a' => by rw [hΦ_tmul]; rfl)
    refine ⟨α₀, α₁, p₀, p₁, ψ_br₀, ψ_br₁, hp₀_max, hp₁_max, hComap_ι₀, hComap_ι₁,
      rfl, rfl, hComp₀, hComp₁, hInj₀, hInj₁, hFT₀, hFT₁,
      hFlat₀, hUnram₀, hFlat₁, hUnram₁, hNePair, ?_, ?_⟩
    · intro α q_P hq_comap
      by_contra hnot
      rcases not_or.mp hnot with ⟨hne₀, hne₁⟩
      obtain ⟨_, ev_P, hker_P, hcomp_P⟩ := hPrimeEval α q_P hq_comap
      obtain ⟨s_tilde, hs_not, hs_0, hs_1⟩ := hTwoSep α₀ α₁ p₀ p₁ hp₀_max hp₁_max α q_P hne₀ hne₁
      have hev_l0 : ev_left (f_left s_tilde) = 0 := by
        change (ev₀.comp ψ_br₀) (s_tilde α₀) = 0
        rwa [← RingHom.mem_ker, ← hp₀_ker]
      have hev_r0 : ev_right (f_left s_tilde) = 0 := by
        change (ev₁.comp ψ_br₁) (s_tilde α₁) = 0
        rwa [← RingHom.mem_ker, ← hp₁_ker]
      obtain ⟨⟨a', ha'_eq, htmul_eq⟩, _⟩ := hDesc s_tilde (hev_l0.trans hev_r0.symm)
      have ha'_ev0 : (ev₀.comp π₀) a' = 0 := by
        change ev₀ (π₀ a') = 0
        have hπ₀a' : π₀ a' = ψ_br₀ (s_tilde α₀) := congrArg Prod.fst ha'_eq
        rw [hπ₀a']
        exact hev_l0
      letI : Algebra B₁ Ω := ev_B.toAlgebra
      let g_L : (∀ β : Fin (c + 1), B_tilde β) →ₐ[B₁] Ω :=
        { ev_P.comp (Pi.evalRingHom B_tilde α) with
          commutes' := fun b => DFunLike.congr_fun hcomp_P b }
      let g_R : A'₁ →ₐ[B₁] Ω :=
        { ev₀.comp π₀ with commutes' := fun _ => rfl }
      let Ψ_P := Algebra.TensorProduct.productMap g_L g_R
      have hΨ := congrArg Ψ_P htmul_eq
      rw [Algebra.TensorProduct.productMap_apply_tmul,
        Algebra.TensorProduct.productMap_apply_tmul] at hΨ
      change ev_P (s_tilde α) * (ev₀.comp π₀) 1 = ev_P 1 * (ev₀.comp π₀) a' at hΨ
      rw [map_one, mul_one, map_one, one_mul, ha'_ev0] at hΨ
      exact hs_not (by rwa [← hker_P, RingHom.mem_ker])
    · intro s_tilde c_val h0 h1
      have hev_0 : ev_left (f_left s_tilde) = c_val := by
        rw [hp₀_ker, RingHom.mem_ker, RingHom.comp_apply, map_sub, map_sub] at h0
        have hc₀ : ev₀ (ψ_br₀ (ι α₀ (c_B c_val))) = c_val := by
          have h := DFunLike.congr_fun hComp₀ (c_B c_val)
          simp only [RingHom.comp_apply] at h
          rw [h]
          exact hev_c c_val
        rw [hc₀] at h0
        exact sub_eq_zero.mp h0
      have hev_1 : ev_right (f_left s_tilde) = c_val := by
        rw [hp₁_ker, RingHom.mem_ker, RingHom.comp_apply, map_sub, map_sub] at h1
        have hc₁ : ev₁ (ψ_br₁ (ι α₁ (c_B c_val))) = c_val := by
          have h := DFunLike.congr_fun hComp₁ (c_B c_val)
          simp only [RingHom.comp_apply] at h
          rw [h]
          exact hev₁_c c_val
        rw [hc₁] at h1
        exact sub_eq_zero.mp h1
      obtain ⟨_, b, hb⟩ := hDesc s_tilde (hev_0.trans hev_1.symm)
      exact ⟨b, fun α => congrFun hb α⟩

  intro x₀ x₁ D₀ D₁ π₀ π₁
  obtain ⟨hInj_right, ev₀, ev₁, hker_ev₀, hm₀, hker_ev₁, hm₁,
    hev_eq_π, hker_ev_u₁, hev_c, hCRT_pair⟩ := hStep1
  exact @hAssemble D₀ D₁ _ _ hDom₀ hIC₀ hDom₁ hIC₁ π₀ Ideal.Quotient.mk_surjective
    π₁ Ideal.Quotient.mk_surjective hNeBot₀ hNeBot₁ hInj_right
    ev₀ ev₁ hker_ev₀ hm₀ hker_ev₁ hm₁ hev_eq_π hker_ev_u₁ hev_c hCRT_pair

theorem weil_nodal_etale_asymmetric_orders_span_cotangent (Ω : Type u) [Field Ω]
    (B₁ A'₁ B_tilde₀ B_tilde₁ : Type u)
    [CommRing B₁] [CommRing A'₁] [CommRing B_tilde₀] [CommRing B_tilde₁]
    (c_B : Ω →+* B₁)
    (φ₁ : B₁ →+* A'₁) (hEtφ₁ : φ₁.Etale)
    (ι₀ : B₁ →+* B_tilde₀) (ι₁ : B₁ →+* B_tilde₁)
    (p_z : Ideal B₁) [p_z.IsMaximal]
    (u₁ : Ideal A'₁) [u₁.IsPrime]
    (hComap_u₁ : Ideal.comap φ₁ u₁ = p_z)
    (hBij_u₁ : Function.Bijective ((Ideal.Quotient.mk u₁).comp (φ₁.comp c_B)))
    (x₀ x₁ : A'₁)
    (hx_mul : x₀ * x₁ = 0)
    (hSpan_u₁ : Ideal.span {x₀, x₁} = u₁)
    (hDom₀ : IsDomain (A'₁ ⧸ Ideal.span {x₁}))
    (hDom₁ : IsDomain (A'₁ ⧸ Ideal.span {x₀}))
    (hx₀_ne : Ideal.Quotient.mk (Ideal.span {x₁}) x₀ ≠ 0)
    (hx₁_ne : Ideal.Quotient.mk (Ideal.span {x₀}) x₁ ≠ 0)
    (p₀ : Ideal B_tilde₀) [p₀.IsMaximal]
    (p₁ : Ideal B_tilde₁) [p₁.IsMaximal]
    (ψ₀ : B_tilde₀ →+* (A'₁ ⧸ Ideal.span {x₁}))
    (ψ₁ : B_tilde₁ →+* (A'₁ ⧸ Ideal.span {x₀}))
    (hComp₀ : ψ₀.comp ι₀ = (Ideal.Quotient.mk (Ideal.span {x₁})).comp φ₁)
    (hComp₁ : ψ₁.comp ι₁ = (Ideal.Quotient.mk (Ideal.span {x₀})).comp φ₁)
    (hComap_ψ₀ : Ideal.comap ψ₀ (Ideal.map (Ideal.Quotient.mk (Ideal.span {x₁})) u₁) = p₀)
    (hComap_ψ₁ : Ideal.comap ψ₁ (Ideal.map (Ideal.Quotient.mk (Ideal.span {x₀})) u₁) = p₁)
    (hComap_ι₀ : Ideal.comap ι₀ p₀ = p_z)
    (hComap_ι₁ : Ideal.comap ι₁ p₁ = p_z)
    (hFT₀ : ψ₀.FiniteType)
    (hFT₁ : ψ₁.FiniteType)
    (hFlat₀ : @Module.Flat B_tilde₀ (A'₁ ⧸ Ideal.span {x₁}) _ _ ψ₀.toAlgebra.toModule)
    (hUnram₀ : @Algebra.FormallyUnramified B_tilde₀ (A'₁ ⧸ Ideal.span {x₁}) _ _ ψ₀.toAlgebra)
    (hFlat₁ : @Module.Flat B_tilde₁ (A'₁ ⧸ Ideal.span {x₀}) _ _ ψ₁.toAlgebra.toModule)
    (hUnram₁ : @Algebra.FormallyUnramified B_tilde₁ (A'₁ ⧸ Ideal.span {x₀}) _ _ ψ₁.toAlgebra)
    (b₀ b₁ : B₁)
    (hb₀_0 : ι₀ b₀ ∈ p₀)
    (hb₀_0s : ι₀ b₀ ∉ p₀ ^ 2)
    (hb₀_1s : ι₁ b₀ ∈ p₁ ^ 2)
    (hb₁_0s : ι₀ b₁ ∈ p₀ ^ 2)
    (hb₁_1 : ι₁ b₁ ∈ p₁)
    (hb₁_1s : ι₁ b₁ ∉ p₁ ^ 2) :
    b₀ ∈ p_z ∧
      b₁ ∈ p_z ∧
      IsLocalRing.maximalIdeal (Localization.AtPrime p_z) ≤
        Ideal.span ({algebraMap B₁ (Localization.AtPrime p_z) b₀,
            algebraMap B₁ (Localization.AtPrime p_z) b₁} :
            Set (Localization.AtPrime p_z)) ⊔
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_z)) ^ 2 :=
by
  have hb₀_pz : b₀ ∈ p_z := by
    rw [← hComap_ι₀]
    exact hb₀_0
  have hb₁_pz : b₁ ∈ p_z := by
    rw [← hComap_ι₁]
    exact hb₁_1
  have hStalk : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S)
      (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
      (hComap : Ideal.comap ψ q = p),
      @Module.Flat R S _ _ ψ.toAlgebra.toModule →
      @Algebra.FormallyUnramified R S _ _ ψ.toAlgebra →
      @Algebra.EssFiniteType R S _ _ ψ.toAlgebra →
      let f := Localization.localRingHom p q ψ hComap.symm
      (∀ J : Ideal (Localization.AtPrime p), Ideal.comap f (Ideal.map f J) = J) ∧
        Ideal.map f (IsLocalRing.maximalIdeal (Localization.AtPrime p)) =
          IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    intro R S _ _ ψ p _ q _ hComap hFlat hUnram hEFT
    let R_p := Localization.AtPrime p
    let S_q := Localization.AtPrime q
    let f : R_p →+* S_q := Localization.localRingHom p q ψ hComap.symm
    letI : Algebra R S := ψ.toAlgebra
    letI : Algebra R_p S_q := f.toAlgebra
    have hCompEq : f.comp (algebraMap R R_p) = (algebraMap S S_q).comp ψ :=
      RingHom.ext (Localization.localRingHom_to_map p q ψ hComap.symm)
    have : IsScalarTower R R_p S_q :=
      IsScalarTower.of_algebraMap_eq fun x => by
        rw [IsScalarTower.algebraMap_apply R S S_q x]
        exact (Localization.localRingHom_to_map p q ψ hComap.symm x).symm
    have : IsLocalHom (algebraMap R_p S_q) :=
      Localization.isLocalHom_localRingHom p q ψ hComap.symm
    have : Module.Flat R S := hFlat
    have : Module.Flat S S_q := IsLocalization.flat S_q q.primeCompl
    have : Module.Flat R S_q := Module.Flat.trans R S S_q
    have : Module.Flat R_p S_q :=
      (Module.flat_iff_of_isLocalization R_p p.primeCompl S_q).mpr inferInstance
    have : Module.FaithfullyFlat R_p S_q :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have : Algebra.FormallyUnramified R S := hUnram
    have : Algebra.FormallyUnramified S S_q :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    have : Algebra.FormallyUnramified R S_q :=
      Algebra.FormallyUnramified.comp R S S_q
    have : Algebra.FormallyUnramified R_p S_q :=
      Algebra.FormallyUnramified.localization_base p.primeCompl
    have : Algebra.EssFiniteType R S := hEFT
    have : Algebra.EssFiniteType S S_q :=
      Algebra.EssFiniteType.of_isLocalization S_q q.primeCompl
    have : Algebra.EssFiniteType R S_q :=
      Algebra.EssFiniteType.comp R S S_q
    have hf_eft : f.EssFiniteType := by
      have hcomp_eft : (algebraMap R S_q).EssFiniteType :=
        (RingHom.essFiniteType_algebraMap (R := R) (S := S_q)).mpr inferInstance
      have hAlgEq : algebraMap R S_q = f.comp (algebraMap R R_p) := by
        ext x
        rw [IsScalarTower.algebraMap_apply R S S_q x]
        exact (Localization.localRingHom_to_map p q ψ hComap.symm x).symm
      rw [hAlgEq] at hcomp_eft
      exact RingHom.EssFiniteType.of_comp (algebraMap R R_p) hcomp_eft
    have : Algebra.EssFiniteType R_p S_q :=
      (RingHom.essFiniteType_algebraMap (R := R_p) (S := S_q)).mp hf_eft
    exact ⟨fun J => Ideal.comap_map_eq_self_of_faithfullyFlat (A := R_p) (B := S_q) J,
      Algebra.FormallyUnramified.map_maximalIdeal (R := R_p) (S := S_q)⟩
  have hSqIff : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      ψ.FiniteType →
      @Module.Flat R S _ _ ψ.toAlgebra.toModule →
      @Algebra.FormallyUnramified R S _ _ ψ.toAlgebra →
      ∀ (p : Ideal R) [p.IsMaximal] (q : Ideal S) [q.IsMaximal]
        (hComap : Ideal.comap ψ q = p) (y : R),
        ψ y ∈ q ^ 2 ↔ y ∈ p ^ 2 := by
    intro R S _ _ ψ hFT hFlat hUnram p _ q _ hComap y
    constructor
    · intro hy_q2
      letI : Algebra R S := ψ.toAlgebra
      have : Algebra.FiniteType R S := hFT
      have hEFT : @Algebra.EssFiniteType R S _ _ ψ.toAlgebra :=
        Algebra.EssFiniteType.of_finiteType R S
      obtain ⟨hComapMap, hMapMax⟩ := hStalk R S ψ p q hComap hFlat hUnram hEFT
      let R_p := Localization.AtPrime p
      let S_q := Localization.AtPrime q
      let f := Localization.localRingHom p q ψ hComap.symm
      have hfy_mem : f (algebraMap R R_p y) ∈ Ideal.map f ((IsLocalRing.maximalIdeal R_p) ^ 2) := by
        rw [Localization.localRingHom_to_map p q ψ hComap.symm y,
          Ideal.map_pow, hMapMax,
          ← IsLocalization.AtPrime.map_eq_maximalIdeal q S_q, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem (algebraMap S S_q) hy_q2
      have hy_loc : algebraMap R R_p y ∈ Ideal.map (algebraMap R R_p) (p ^ 2) := by
        have h1 : algebraMap R R_p y ∈ (IsLocalRing.maximalIdeal R_p) ^ 2 := by
          rw [← hComapMap ((IsLocalRing.maximalIdeal R_p) ^ 2)]
          exact hfy_mem
        rwa [← IsLocalization.AtPrime.map_eq_maximalIdeal p R_p, ← Ideal.map_pow] at h1
      let J_loc : Ideal R_p :=
        { carrier := {z : R_p | ∃ s ∈ p.primeCompl, ∃ i ∈ p ^ 2,
            z * algebraMap R R_p s = algebraMap R R_p i}
          add_mem' := by
            rintro z₁ z₂ ⟨s₁, hs₁, i₁, hi₁, h₁⟩ ⟨s₂, hs₂, i₂, hi₂, h₂⟩
            refine ⟨s₁ * s₂, p.primeCompl.mul_mem hs₁ hs₂,
              s₂ * i₁ + s₁ * i₂,
              (p ^ 2).add_mem ((p ^ 2).mul_mem_left _ hi₁) ((p ^ 2).mul_mem_left _ hi₂), ?_⟩
            simp only [map_mul, map_add]
            calc (z₁ + z₂) * (algebraMap R R_p s₁ * algebraMap R R_p s₂)
                = (z₁ * algebraMap R R_p s₁) * algebraMap R R_p s₂ +
                    (z₂ * algebraMap R R_p s₂) * algebraMap R R_p s₁ := by ring
              _ = algebraMap R R_p i₁ * algebraMap R R_p s₂ +
                    algebraMap R R_p i₂ * algebraMap R R_p s₁ := by rw [h₁, h₂]
              _ = algebraMap R R_p s₂ * algebraMap R R_p i₁ +
                    algebraMap R R_p s₁ * algebraMap R R_p i₂ := by ring
          zero_mem' := ⟨1, p.primeCompl.one_mem, 0, (p ^ 2).zero_mem, by simp⟩
          smul_mem' := by
            rintro c z₁ ⟨s₁, hs₁, i₁, hi₁, h₁⟩
            obtain ⟨⟨r, s₂⟩, hc⟩ := IsLocalization.surj p.primeCompl c
            refine ⟨(s₂ : R) * s₁, p.primeCompl.mul_mem s₂.2 hs₁,
              r * i₁, (p ^ 2).mul_mem_left _ hi₁, ?_⟩
            simp only [smul_eq_mul, map_mul]
            calc c * z₁ * (algebraMap R R_p (s₂ : R) * algebraMap R R_p s₁)
                = (c * algebraMap R R_p (s₂ : R)) * (z₁ * algebraMap R R_p s₁) := by ring
              _ = algebraMap R R_p r * algebraMap R R_p i₁ := by rw [hc, h₁] }
      have hJ_le : Ideal.map (algebraMap R R_p) (p ^ 2) ≤ J_loc := by
        rw [Ideal.map_le_iff_le_comap]
        intro i hi
        exact ⟨1, p.primeCompl.one_mem, i, hi, by simp⟩
      obtain ⟨s₁, hs₁, i, hi, h_eq⟩ := hJ_le hy_loc
      have h_eq' : algebraMap R R_p (y * s₁) = algebraMap R R_p i := by
        simpa [map_mul] using h_eq
      obtain ⟨t₁, ht₁⟩ := IsLocalization.exists_of_eq (M := p.primeCompl) h_eq'
      let s_u : R := (t₁ : R) * s₁
      have hs_u_not : s_u ∉ p := p.primeCompl.mul_mem t₁.2 hs₁
      have hs_u_y : s_u * y ∈ p ^ 2 := by
        have ht₁' : s_u * y = (t₁ : R) * i := by
          dsimp only [s_u]
          linear_combination ht₁
        rw [ht₁']
        exact (p ^ 2).mul_mem_left _ hi
      have htop : p ⊔ Ideal.span ({s_u} : Set R) = ⊤ := by
        by_contra hne_top
        have heq : p = p ⊔ Ideal.span ({s_u} : Set R) :=
          ‹p.IsMaximal›.eq_of_le hne_top le_sup_left
        exact hs_u_not (heq.symm ▸ Ideal.mem_sup_right (Ideal.mem_span_singleton_self s_u))
      have h1 : (1 : R) ∈ p ⊔ Ideal.span ({s_u} : Set R) := htop ▸ trivial
      rw [Submodule.mem_sup] at h1
      rcases h1 with ⟨m_p, hm_p, s', hs', hms⟩
      rw [Ideal.mem_span_singleton] at hs'
      rcases hs' with ⟨t_u, rfl⟩
      have hy_id : y = (m_p * m_p) * y + (2 * m_p * t_u + s_u * t_u ^ 2) * (s_u * y) := by
        calc y = (1 : R) ^ 2 * y := by ring
          _ = (m_p + s_u * t_u) ^ 2 * y := by rw [hms]
          _ = (m_p * m_p) * y + (2 * m_p * t_u + s_u * t_u ^ 2) * (s_u * y) := by ring
      rw [hy_id]
      apply Ideal.add_mem
      · rw [pow_two]
        exact Ideal.mul_mem_right y _ (Ideal.mul_mem_mul hm_p hm_p)
      · exact Ideal.mul_mem_left _ _ hs_u_y
    · intro hy_p2
      have hmap_le : Ideal.map ψ (p ^ 2) ≤ q ^ 2 := by
        rw [Ideal.map_pow]
        apply pow_le_pow_left'
        rw [Ideal.map_le_iff_le_comap, hComap]
      exact hmap_le (Ideal.mem_map_of_mem ψ hy_p2)
  let c_A : Ω →+* A'₁ := φ₁.comp c_B
  let e_u : Ω ≃+* (A'₁ ⧸ u₁) := RingEquiv.ofBijective ((Ideal.Quotient.mk u₁).comp c_A) hBij_u₁
  let ev_u : A'₁ →+* Ω := e_u.symm.toRingHom.comp (Ideal.Quotient.mk u₁)
  have hev_c : ∀ c : Ω, ev_u (c_A c) = c := fun c => e_u.symm_apply_apply c
  have hev_zero_iff : ∀ z : A'₁, ev_u z = 0 ↔ z ∈ u₁ := by
    intro z
    change e_u.symm (Ideal.Quotient.mk u₁ z) = 0 ↔ z ∈ u₁
    rw [map_eq_zero_iff e_u.symm e_u.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
  have hNodalBranch : ∀ (x_a x_b : A'₁),
      Ideal.span ({x_a, x_b} : Set A'₁) = u₁ →
      (Ideal.map (Ideal.Quotient.mk (Ideal.span ({x_b} : Set A'₁))) u₁).IsMaximal ∧
        ∀ a : A'₁,
          Ideal.Quotient.mk (Ideal.span ({x_b} : Set A'₁)) a ∉
            (Ideal.map (Ideal.Quotient.mk (Ideal.span ({x_b} : Set A'₁))) u₁) ^ 2 →
          Ideal.Quotient.mk (Ideal.span ({x_a} : Set A'₁)) a ∈
            (Ideal.map (Ideal.Quotient.mk (Ideal.span ({x_a} : Set A'₁))) u₁) ^ 2 →
          x_a ∈ Ideal.span ({a} : Set A'₁) ⊔ u₁ ^ 2 := by
    intro x_a x_b hSpan
    let π_a := Ideal.Quotient.mk (Ideal.span ({x_b} : Set A'₁))
    let π_b := Ideal.Quotient.mk (Ideal.span ({x_a} : Set A'₁))
    let ū_a := Ideal.map π_a u₁
    let ū_b := Ideal.map π_b u₁
    have hx_a_mem : x_a ∈ u₁ := hSpan ▸ Ideal.subset_span (Or.inl rfl)
    have hx_b_mem : x_b ∈ u₁ := hSpan ▸ Ideal.subset_span (Or.inr rfl)
    have hker_xb : ∀ z ∈ Ideal.span ({x_b} : Set A'₁), ev_u z = 0 := by
      intro z hz
      have hsub : Ideal.span ({x_b} : Set A'₁) ≤ u₁ := by
        rw [← hSpan]
        exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Or.inr rfl))
      exact (hev_zero_iff z).mpr (hsub hz)
    let ev_a : (A'₁ ⧸ Ideal.span ({x_b} : Set A'₁)) →+* Ω :=
      Ideal.Quotient.lift (Ideal.span ({x_b} : Set A'₁)) ev_u hker_xb
    have hev_a_surj : Function.Surjective ev_a := fun c => ⟨π_a (c_A c), hev_c c⟩
    have hker_eq : RingHom.ker ev_a = ū_a := by
      apply le_antisymm
      · intro d hd
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective d
        exact Ideal.mem_map_of_mem π_a ((hev_zero_iff z).mp hd)
      · rw [Ideal.map_le_iff_le_comap]
        intro z hz
        exact (hev_zero_iff z).mpr hz
    refine ⟨?_, ?_⟩
    · change ū_a.IsMaximal
      rw [← hker_eq]
      exact RingHom.ker_isMaximal_of_surjective ev_a hev_a_surj
    · have hū_b_eq : ū_b = Ideal.span ({π_b x_b} : Set (A'₁ ⧸ Ideal.span ({x_a} : Set A'₁))) := by
        dsimp only [ū_b]
        rw [← hSpan, Ideal.map_span, Set.image_pair]
        have hxa0 : π_b x_a = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x_a)
        rw [hxa0]
        apply le_antisymm
        · rw [Ideal.span_le]
          rintro _ (rfl | rfl)
          · exact Ideal.zero_mem _
          · exact Ideal.mem_span_singleton_self _
        · exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Or.inr rfl))
      intro a ha_not_sq ha_sq
      change π_b a ∈ ū_b ^ 2 at ha_sq
      rw [hū_b_eq, Ideal.span_singleton_pow] at ha_sq
      rw [Ideal.mem_span_singleton] at ha_sq
      obtain ⟨t₁, ht₁⟩ := ha_sq
      obtain ⟨t_tilde, rfl⟩ := Ideal.Quotient.mk_surjective t₁
      have hdiff_mem : a - x_b ^ 2 * t_tilde ∈ Ideal.span ({x_a} : Set A'₁) := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change π_b (a - x_b ^ 2 * t_tilde) = 0
        rw [map_sub, map_mul, map_pow, ht₁, sub_self]
      rw [Ideal.mem_span_singleton] at hdiff_mem
      obtain ⟨s₀, hs₀_eq⟩ := hdiff_mem
      have ha_eq : a = x_a * s₀ + x_b ^ 2 * t_tilde := by linear_combination hs₀_eq
      have hs₀_not : s₀ ∉ u₁ := by
        intro hs₀_in
        apply ha_not_sq
        have hxb0 : π_a x_b = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x_b)
        have hπa_eq : π_a a = π_a x_a * π_a s₀ := by
          rw [ha_eq, map_add, map_mul, map_mul, map_pow, hxb0, zero_pow (by decide),
            zero_mul, add_zero]
        rw [hπa_eq, pow_two]
        exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem π_a hx_a_mem)
          (Ideal.mem_map_of_mem π_a hs₀_in)
      let c₀ : Ω := ev_u s₀
      have hc₀_ne : c₀ ≠ 0 := fun hc0 => hs₀_not ((hev_zero_iff s₀).mp hc0)
      let m₀ : A'₁ := s₀ - c_A c₀
      have hm₀_mem : m₀ ∈ u₁ := by
        apply (hev_zero_iff m₀).mp
        simp only [m₀, map_sub, hev_c, c₀, sub_self]
      let w₀ : A'₁ := x_a * m₀ + x_b ^ 2 * t_tilde
      have hw₀_mem : w₀ ∈ u₁ ^ 2 := by
        apply Ideal.add_mem
        · rw [pow_two]
          exact Ideal.mul_mem_mul hx_a_mem hm₀_mem
        · rw [pow_two, pow_two]
          exact Ideal.mul_mem_right t_tilde _ (Ideal.mul_mem_mul hx_b_mem hx_b_mem)
      have hc_inv : c_A c₀⁻¹ * c_A c₀ = 1 := by
        rw [← map_mul, inv_mul_cancel₀ hc₀_ne, map_one]
      have haw : c_A c₀ * x_a = a - w₀ := by
        change c_A c₀ * x_a = a - (x_a * (s₀ - c_A c₀) + x_b ^ 2 * t_tilde)
        linear_combination -ha_eq
      have hxa_id : x_a = a * c_A c₀⁻¹ + -(c_A c₀⁻¹ * w₀) := by
        calc x_a = c_A c₀⁻¹ * (c_A c₀ * x_a) := by rw [← mul_assoc, hc_inv, one_mul]
          _ = c_A c₀⁻¹ * (a - w₀) := by rw [haw]
          _ = a * c_A c₀⁻¹ + -(c_A c₀⁻¹ * w₀) := by ring
      rw [Submodule.mem_sup]
      exact ⟨a * c_A c₀⁻¹, Ideal.mem_span_singleton.mpr ⟨c_A c₀⁻¹, rfl⟩,
        -(c_A c₀⁻¹ * w₀), (u₁ ^ 2).neg_mem (Ideal.mul_mem_left _ _ hw₀_mem), hxa_id.symm⟩
  have hSpan_swap : Ideal.span ({x₁, x₀} : Set A'₁) = u₁ := by
    rw [Set.pair_comm]
    exact hSpan_u₁
  obtain ⟨hMax_ū₀, hGen₀⟩ := hNodalBranch x₀ x₁ hSpan_u₁
  obtain ⟨hMax_ū₁, hGen₁⟩ := hNodalBranch x₁ x₀ hSpan_swap
  have := hMax_ū₀
  have := hMax_ū₁
  let π₀ := Ideal.Quotient.mk (Ideal.span ({x₁} : Set A'₁))
  let π₁ := Ideal.Quotient.mk (Ideal.span ({x₀} : Set A'₁))
  let ū₀ := Ideal.map π₀ u₁
  let ū₁ := Ideal.map π₁ u₁
  have hComp₀_app : ∀ b : B₁, ψ₀ (ι₀ b) = π₀ (φ₁ b) := fun b => DFunLike.congr_fun hComp₀ b
  have hComp₁_app : ∀ b : B₁, ψ₁ (ι₁ b) = π₁ (φ₁ b) := fun b => DFunLike.congr_fun hComp₁ b
  have hb₀_π₀ : π₀ (φ₁ b₀) ∉ ū₀ ^ 2 := by
    rw [← hComp₀_app b₀]
    exact (hSqIff B_tilde₀ _ ψ₀ hFT₀ hFlat₀ hUnram₀ p₀ ū₀ hComap_ψ₀ (ι₀ b₀)).not.mpr hb₀_0s
  have hb₀_π₁ : π₁ (φ₁ b₀) ∈ ū₁ ^ 2 := by
    rw [← hComp₁_app b₀]
    exact (hSqIff B_tilde₁ _ ψ₁ hFT₁ hFlat₁ hUnram₁ p₁ ū₁ hComap_ψ₁ (ι₁ b₀)).mpr hb₀_1s
  have hb₁_π₀ : π₀ (φ₁ b₁) ∈ ū₀ ^ 2 := by
    rw [← hComp₀_app b₁]
    exact (hSqIff B_tilde₀ _ ψ₀ hFT₀ hFlat₀ hUnram₀ p₀ ū₀ hComap_ψ₀ (ι₀ b₁)).mpr hb₁_0s
  have hb₁_π₁ : π₁ (φ₁ b₁) ∉ ū₁ ^ 2 := by
    rw [← hComp₁_app b₁]
    exact (hSqIff B_tilde₁ _ ψ₁ hFT₁ hFlat₁ hUnram₁ p₁ ū₁ hComap_ψ₁ (ι₁ b₁)).not.mpr hb₁_1s
  have hx₀_span : x₀ ∈ Ideal.span ({φ₁ b₀, φ₁ b₁} : Set A'₁) ⊔ u₁ ^ 2 := by
    have hle : Ideal.span ({φ₁ b₀} : Set A'₁) ⊔ u₁ ^ 2 ≤
        Ideal.span ({φ₁ b₀, φ₁ b₁} : Set A'₁) ⊔ u₁ ^ 2 :=
      sup_le_sup (Ideal.span_mono (Set.singleton_subset_iff.mpr (Or.inl rfl))) le_rfl
    exact hle (hGen₀ (φ₁ b₀) hb₀_π₀ hb₀_π₁)
  have hx₁_span : x₁ ∈ Ideal.span ({φ₁ b₀, φ₁ b₁} : Set A'₁) ⊔ u₁ ^ 2 := by
    have hle : Ideal.span ({φ₁ b₁} : Set A'₁) ⊔ u₁ ^ 2 ≤
        Ideal.span ({φ₁ b₀, φ₁ b₁} : Set A'₁) ⊔ u₁ ^ 2 :=
      sup_le_sup (Ideal.span_mono (Set.singleton_subset_iff.mpr (Or.inr rfl))) le_rfl
    exact hle (hGen₁ (φ₁ b₁) hb₁_π₁ hb₁_π₀)
  have hu₁_le : u₁ ≤ Ideal.span ({φ₁ b₀, φ₁ b₁} : Set A'₁) ⊔ u₁ ^ 2 := by
    have hle : Ideal.span ({x₀, x₁} : Set A'₁) ≤
        Ideal.span ({φ₁ b₀, φ₁ b₁} : Set A'₁) ⊔ u₁ ^ 2 := by
      rw [Ideal.span_le]
      rintro _ (rfl | rfl)
      · exact hx₀_span
      · exact hx₁_span
    rwa [hSpan_u₁] at hle
  refine ⟨hb₀_pz, hb₁_pz, ?_⟩
  letI : Algebra B₁ A'₁ := φ₁.toAlgebra
  have : Algebra.Etale B₁ A'₁ := (RingHom.etale_algebraMap (R := B₁) (S := A'₁)).mp hEtφ₁
  obtain ⟨hComapMap_z, hMapMax_z⟩ :=
    hStalk B₁ A'₁ φ₁ p_z u₁ hComap_u₁ inferInstance inferInstance inferInstance
  let L_z := Localization.AtPrime p_z
  let L_u := Localization.AtPrime u₁
  let f_z := Localization.localRingHom p_z u₁ φ₁ hComap_u₁.symm
  let I_z : Ideal L_z :=
    Ideal.span ({algebraMap B₁ L_z b₀, algebraMap B₁ L_z b₁} : Set L_z) ⊔
      (IsLocalRing.maximalIdeal L_z) ^ 2
  have hMapLe : Ideal.map f_z (IsLocalRing.maximalIdeal L_z) ≤ Ideal.map f_z I_z := by
    have hpush := Ideal.map_mono (f := algebraMap A'₁ L_u) hu₁_le
    rw [IsLocalization.AtPrime.map_eq_maximalIdeal u₁ L_u, ← hMapMax_z] at hpush
    rw [Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_pow,
      IsLocalization.AtPrime.map_eq_maximalIdeal u₁ L_u, ← hMapMax_z,
      ← Localization.localRingHom_to_map p_z u₁ φ₁ hComap_u₁.symm b₀,
      ← Localization.localRingHom_to_map p_z u₁ φ₁ hComap_u₁.symm b₁] at hpush
    have hRHS : Ideal.map f_z I_z =
        Ideal.span ({f_z (algebraMap B₁ L_z b₀), f_z (algebraMap B₁ L_z b₁)} : Set L_u) ⊔
          (Ideal.map f_z (IsLocalRing.maximalIdeal L_z)) ^ 2 := by
      dsimp only [I_z]
      rw [Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_pow]
    rwa [← hRHS] at hpush
  rw [Ideal.map_le_iff_le_comap, hComapMap_z I_z] at hMapLe
  exact hMapLe

theorem weil_nodal_etale_branch_dvr_and_kaehler_unit_algebra (Ω : Type u) [Field Ω]
    (B A' B_tilde : Type u) [CommRing B] [CommRing A'] [CommRing B_tilde]
    (F_α : Type u) [Field F_α] [Algebra Ω F_α]
    (c_B : Ω →+* B)
    (φ₁ : B →+* A')
    (φ₂ : (MvPolynomial (Fin 2) Ω ⧸
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* A')
    (hEtφ₂ : φ₂.Etale)
    (ν_B : B →+* B_tilde)
    (φ_F : B_tilde →+* F_α)
    (hFrac : @IsFractionRing B_tilde _ F_α _ φ_F.toAlgebra)
    (u₀ : Ideal A') [u₀.IsPrime]
    (p_P : Ideal B_tilde) [p_P.IsMaximal]
    (t_P : B_tilde)
    (i_br : Fin 2)
    (hAlg_φ : ∀ c : Ω, φ₁ (c_B c) = φ₂ (Ideal.Quotient.mk _ (MvPolynomial.C c)))
    (hAlg_F : ∀ c : Ω, φ_F (ν_B (c_B c)) = algebraMap Ω F_α c)
    (hSpan_u₀ : Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i_br)),
      φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))} = u₀)
    (hDomD : IsDomain (A' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))}))
    (hx_br_ne : Ideal.Quotient.mk
      (Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))})
      (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i_br))) ≠ 0)
    (ht_mem : t_P ∈ p_P)
    (ht_not_sq : t_P ∉ p_P ^ 2)
    (hDVR_div : ∀ z : B_tilde, z ∈ p_P → ∃ s_z q_z : B_tilde, s_z ∉ p_P ∧ s_z * z = q_z * t_P)
    (ψ_br : B_tilde →+* (A' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))}))
    (hComp_br : ψ_br.comp ν_B =
      (Ideal.Quotient.mk
        (Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))})).comp φ₁)
    (hInj_br : Function.Injective ψ_br)
    (hComap_br : Ideal.comap ψ_br
      (Ideal.map
        (Ideal.Quotient.mk
          (Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))})) u₀) = p_P)
    (hFlat_br : @Module.Flat B_tilde
      (A' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))}) _ _
      ψ_br.toAlgebra.toModule)
    (hUnram_br : @Algebra.FormallyUnramified B_tilde
      (A' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))}) _ _
      ψ_br.toAlgebra)
    (hEFT_br : @Algebra.EssFiniteType B_tilde
      (A' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))}) _ _
      ψ_br.toAlgebra) :
    ∃ (K_br : Type u)
      (instFieldK : Field K_br)
      (instAlgΩK : Algebra Ω K_br)
      (instAlgFK : Algebra F_α K_br),
      letI : Field K_br := instFieldK
      letI : Algebra Ω K_br := instAlgΩK
      letI : Algebra F_α K_br := instAlgFK
      ∃ (_ : IsScalarTower Ω F_α K_br)
        (π_br : A' →+* K_br)
        (R_br : Subring K_br),
        let x_br : A' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i_br))
        letI : Algebra A' K_br := π_br.toAlgebra
        letI : (RingHom.ker π_br).IsPrime := RingHom.ker_isPrime π_br
        (∀ b : B, π_br (φ₁ b) = algebraMap F_α K_br (φ_F (ν_B b))) ∧
        IsLocalization (RingHom.ker π_br).primeCompl K_br ∧
        (∀ a' : A', π_br a' ∈ R_br) ∧
        (∀ s : A', s ∉ u₀ → ∃ s_inv : K_br, s_inv ∈ R_br ∧ π_br s * s_inv = 1) ∧
        (∃ w w_inv u_diff u_inv : K_br,
          w ∈ R_br ∧ w_inv ∈ R_br ∧ w * w_inv = 1 ∧
          u_diff ∈ R_br ∧ u_inv ∈ R_br ∧ u_diff * u_inv = 1 ∧
          algebraMap F_α K_br (φ_F t_P) = w * π_br x_br ∧
          KaehlerDifferential.D Ω K_br (algebraMap F_α K_br (φ_F t_P)) =
            u_diff • KaehlerDifferential.D Ω K_br (π_br x_br)) ∧
        (∀ y : F_α,
          algebraMap F_α K_br y ∈ R_br →
          (∃ y_inv : K_br, y_inv ∈ R_br ∧ algebraMap F_α K_br y * y_inv = 1) →
          ∃ a_num b_den : B_tilde,
            a_num ∉ p_P ∧ b_den ∉ p_P ∧ φ_F b_den * y = φ_F a_num) :=
by
  let x_br : A' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i_br))
  let x_other : A' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.rev i_br)))
  let I_other : Ideal A' := Ideal.span {x_other}
  let D := A' ⧸ I_other
  haveI : IsDomain D := hDomD
  let π : A' →+* D := Ideal.Quotient.mk I_other
  let K_br : Type u := FractionRing D
  let instFieldK : Field K_br := inferInstance
  let ι_D : D →+* K_br := algebraMap D K_br
  have hInj_ιD : Function.Injective ι_D := IsFractionRing.injective D K_br
  let π_br : A' →+* K_br := ι_D.comp π
  letI : Algebra B_tilde F_α := φ_F.toAlgebra
  haveI : IsFractionRing B_tilde F_α := hFrac
  have hg_inj : Function.Injective (ι_D.comp ψ_br) := hInj_ιD.comp hInj_br
  let ι_FK : F_α →+* K_br := IsFractionRing.lift hg_inj
  have hι_FK_eq : ∀ b : B_tilde, ι_FK (φ_F b) = ι_D (ψ_br b) :=
    fun b => IsFractionRing.lift_algebraMap hg_inj b
  let instAlgFK : Algebra F_α K_br := ι_FK.toAlgebra
  let instAlgΩK : Algebra Ω K_br := (ι_FK.comp (algebraMap Ω F_α)).toAlgebra
  letI : Algebra F_α K_br := instAlgFK
  letI : Algebra Ω K_br := instAlgΩK
  have hTowerΩFK : IsScalarTower Ω F_α K_br := IsScalarTower.of_algebraMap_eq' rfl
  let q_D : Ideal D := Ideal.map π u₀
  have hπ_x_other : π x_other = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x_other)
  have hx_other_u0 : x_other ∈ u₀ := by
    rw [← hSpan_u₀]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton x_other))
  have hKer_le_u0 : RingHom.ker π ≤ u₀ := by
    rw [Ideal.mk_ker]
    exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx_other_u0)
  have hComap_π_qD : Ideal.comap π q_D = u₀ := by
    rw [Ideal.comap_map_of_surjective π Ideal.Quotient.mk_surjective u₀]
    exact sup_eq_left.mpr hKer_le_u0
  have hqD_prime : q_D.IsPrime := by
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : A') ∈ Ideal.comap π q_D := by
        rw [Ideal.mem_comap, map_one, htop]
        trivial
      rw [hComap_π_qD] at h1
      exact ‹u₀.IsPrime›.ne_top (u₀.eq_top_iff_one.mpr h1)
    · intro d₁ d₂ hd₁₂
      obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective d₁
      obtain ⟨a₂, rfl⟩ := Ideal.Quotient.mk_surjective d₂
      have ha₁₂ : a₁ * a₂ ∈ u₀ := by
        rw [← hComap_π_qD, Ideal.mem_comap]
        simpa [π, map_mul] using hd₁₂
      rcases ‹u₀.IsPrime›.mem_or_mem ha₁₂ with ha₁ | ha₂
      · left; exact Ideal.mem_map_of_mem π ha₁
      · right; exact Ideal.mem_map_of_mem π ha₂
  haveI : q_D.IsPrime := hqD_prime
  have hqD_span : Ideal.span {π x_br} = q_D := by
    have hmap : q_D = Ideal.span {π x_br, π x_other} := by
      dsimp only [q_D]
      rw [← hSpan_u₀, Ideal.map_span, Set.image_pair]
    rw [hmap, hπ_x_other]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ rfl
      exact Ideal.subset_span (Set.mem_insert _ _)
    · rw [Ideal.span_le]
      rintro y (rfl | hy)
      · exact Ideal.mem_span_singleton_self (π x_br)
      · rw [Set.mem_singleton_iff.mp hy]
        exact (Ideal.span {π x_br}).zero_mem
  have hx_D_mem : π x_br ∈ q_D := by
    rw [← hqD_span]
    exact Ideal.mem_span_singleton_self (π x_br)
  let R_loc := Localization.AtPrime q_D
  have hUnit_qD : ∀ s : q_D.primeCompl, IsUnit (ι_D s.1) := by
    rintro ⟨s, hs⟩
    have hs_ne : s ≠ 0 := fun h0 => hs (h0 ▸ q_D.zero_mem)
    have hιs_ne : ι_D s ≠ 0 := fun h0 => hs_ne (hInj_ιD (h0.trans (map_zero ι_D).symm))
    exact IsUnit.mk0 (ι_D s) hιs_ne
  let j_loc : R_loc →+* K_br := IsLocalization.lift (M := q_D.primeCompl) (g := ι_D) hUnit_qD
  have hj_loc_eq : ∀ d : D, j_loc (algebraMap D R_loc d) = ι_D d :=
    fun d => IsLocalization.lift_eq (M := q_D.primeCompl) hUnit_qD d
  have hj_loc_inj : Function.Injective j_loc := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    obtain ⟨⟨d, s⟩, hrs⟩ := IsLocalization.surj q_D.primeCompl r
    have hd_zero : ι_D d = 0 := by
      rw [← hj_loc_eq d, ← hrs, map_mul, hr, zero_mul]
    have hd : d = 0 := hInj_ιD (hd_zero.trans (map_zero ι_D).symm)
    rw [hd, map_zero] at hrs
    obtain ⟨u_s, hu_s⟩ := isUnit_iff_exists_inv.mp (IsLocalization.map_units R_loc s)
    calc r = r * 1 := (mul_one r).symm
      _ = r * (algebraMap D R_loc s.1 * u_s) := by rw [hu_s]
      _ = (r * algebraMap D R_loc s.1) * u_s := by ring
      _ = 0 := by rw [hrs, zero_mul]
  let R_br : Subring K_br := j_loc.range
  have hx_prod : x_br * x_other = 0 := by
    dsimp only [x_br, x_other]
    rw [← map_mul, ← map_mul]
    have hmem : MvPolynomial.X i_br * MvPolynomial.X (Fin.rev i_br) ∈
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω)) := by
      fin_cases i_br
      · exact Ideal.mem_span_singleton_self _
      · change MvPolynomial.X 1 * MvPolynomial.X 0 ∈ _
        rw [mul_comm]
        exact Ideal.mem_span_singleton_self _
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
  letI : Algebra A' K_br := π_br.toAlgebra
  letI : (RingHom.ker π_br).IsPrime := RingHom.ker_isPrime π_br
  have hLocK : IsLocalization (RingHom.ker π_br).primeCompl K_br := by
    have hx_br_not_ker : x_br ∉ RingHom.ker π_br := by
      intro hmem
      rw [RingHom.mem_ker] at hmem
      exact hx_br_ne (hInj_ιD (hmem.trans (map_zero ι_D).symm))
    refine ⟨⟨?_, ?_, ?_⟩⟩
    · rintro ⟨y, hy⟩
      have hy_ne : π_br y ≠ 0 := hy
      exact IsUnit.mk0 (π_br y) hy_ne
    · intro z
      obtain ⟨⟨d₁, d₂⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors D) z
      have hd₂_ne : (d₂ : D) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d₂.2
      obtain ⟨a₁, ha₁⟩ := Ideal.Quotient.mk_surjective d₁
      obtain ⟨a₂, ha₂⟩ := Ideal.Quotient.mk_surjective (d₂ : D)
      have ha₂_not_ker : a₂ ∉ RingHom.ker π_br := by
        intro hmem
        rw [RingHom.mem_ker] at hmem
        have hπa₂ : π a₂ = 0 := hInj_ιD (hmem.trans (map_zero ι_D).symm)
        exact hd₂_ne (ha₂.symm.trans hπa₂)
      refine ⟨⟨a₁, ⟨a₂, ha₂_not_ker⟩⟩, ?_⟩
      change z * ι_D (π a₂) = ι_D (π a₁)
      change Ideal.Quotient.mk I_other a₁ = d₁ at ha₁
      change Ideal.Quotient.mk I_other a₂ = (d₂ : D) at ha₂
      rw [ha₁, ha₂]
      exact hz
    · intro a₁ a₂ heq
      have hπ_eq : π a₁ = π a₂ := hInj_ιD heq
      have hsub_zero : π (a₁ - a₂) = 0 := by rw [map_sub, hπ_eq, sub_self]
      have hmem_span : a₁ - a₂ ∈ I_other := Ideal.Quotient.eq_zero_iff_mem.mp hsub_zero
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hmem_span
      refine ⟨⟨x_br, hx_br_not_ker⟩, ?_⟩
      change x_br * a₁ = x_br * a₂
      apply sub_eq_zero.mp
      calc x_br * a₁ - x_br * a₂ = x_br * (a₁ - a₂) := by ring
        _ = x_br * (x_other * r) := by rw [← hr]
        _ = (x_br * x_other) * r := by ring
        _ = 0 := by rw [hx_prod, zero_mul]
  have hs2 :
      (∃ w₀ w₀_inv : R_loc,
        w₀ * w₀_inv = 1 ∧ ι_FK (φ_F t_P) = j_loc w₀ * π_br x_br) ∧
      (∀ y : F_α,
        ι_FK y ∈ R_br →
        (∃ y_inv : K_br, y_inv ∈ R_br ∧ ι_FK y * y_inv = 1) →
        ∃ a_num b_den : B_tilde,
          a_num ∉ p_P ∧ b_den ∉ p_P ∧ φ_F b_den * y = φ_F a_num) := by
    haveI : IsDomain R_loc := Function.Injective.isDomain j_loc hj_loc_inj
    haveI : IsDomain B_tilde := Function.Injective.isDomain ψ_br hInj_br
    let O_P := Localization.AtPrime p_P
    let ι_OP : B_tilde →+* O_P := algebraMap B_tilde O_P
    let ι_Rloc : D →+* R_loc := algebraMap D R_loc
    have hInj_OP : Function.Injective ι_OP :=
      IsLocalization.injective O_P (Ideal.primeCompl_le_nonZeroDivisors p_P)
    have hInj_φF : Function.Injective φ_F := IsFractionRing.injective B_tilde F_α
    let f_loc : O_P →+* R_loc := Localization.localRingHom p_P q_D ψ_br hComap_br.symm
    have hf_loc_map : ∀ b : B_tilde, f_loc (ι_OP b) = ι_Rloc (ψ_br b) :=
      fun b => Localization.localRingHom_to_map p_P q_D ψ_br hComap_br.symm b
    have hf_loc_K : ∀ b : B_tilde, j_loc (f_loc (ι_OP b)) = ι_FK (φ_F b) := by
      intro b
      rw [hf_loc_map b, hj_loc_eq (ψ_br b), hι_FK_eq b]
    letI : Algebra B_tilde D := ψ_br.toAlgebra
    letI : Algebra O_P R_loc := f_loc.toAlgebra
    haveI : IsLocalHom (algebraMap O_P R_loc) :=
      Localization.isLocalHom_localRingHom p_P q_D ψ_br hComap_br.symm
    haveI : IsScalarTower B_tilde O_P R_loc :=
      IsScalarTower.of_algebraMap_eq fun b => (hf_loc_map b).symm
    haveI : Module.Flat B_tilde D := hFlat_br
    haveI : Module.Flat D R_loc := IsLocalization.flat R_loc q_D.primeCompl
    haveI : Module.Flat B_tilde R_loc := Module.Flat.trans B_tilde D R_loc
    haveI : Module.Flat O_P R_loc :=
      (Module.flat_iff_of_isLocalization O_P p_P.primeCompl R_loc).mpr inferInstance
    haveI : Module.FaithfullyFlat O_P R_loc := Module.FaithfullyFlat.of_flat_of_isLocalHom
