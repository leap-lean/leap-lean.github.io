        { obj := fun u => CommRingCat.of ↥(Algebra.adjoin B₀ (↑u.1 : Set K))
          map := fun {u v} g =>
            CommRingCat.ofHom
              (Subalgebra.inclusion (Algebra.adjoin_mono
                (Finset.coe_subset.mpr (show u.1 ⊆ v.1 from leOfHom g)))).toRingHom
          map_id := fun _ => by apply CommRingCat.hom_ext; ext x; rfl
          map_comp := fun _ _ => by apply CommRingCat.hom_ext; ext x; rfl }
      let c_K : CategoryTheory.Limits.Cocone F_K :=
        { pt := CommRingCat.of K
          ι :=
            { app := fun u => CommRingCat.ofHom (Algebra.adjoin B₀ (↑u.1 : Set K)).val.toRingHom
              naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext x; rfl } }
      Nonempty (CategoryTheory.Limits.IsColimit c_K) := by
    intro S₀ J_S F_K c_K
    let u_sing : K → J_S := fun x => ⟨S₀ ∪ {x}, Set.mem_Ici.mpr Finset.subset_union_left⟩
    have hx_mem : ∀ x : K, x ∈ Algebra.adjoin B₀ (↑(u_sing x).1 : Set K) := fun x =>
      Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_singleton_self x)))
    have hDescK : ∀ s : CategoryTheory.Limits.Cocone F_K,
        ∃ (d : c_K.pt ⟶ s.pt),
          ∀ (u : J_S) (y : ↥(Algebra.adjoin B₀ (↑u.1 : Set K))),
            d.hom y.1 = (s.ι.app u).hom y := by
      intro s
      let d_fun : K → ↑s.pt := fun x => (s.ι.app (u_sing x)).hom ⟨x, hx_mem x⟩
      have hd_compat : ∀ (u : J_S) (y : ↥(Algebra.adjoin B₀ (↑u.1 : Set K))),
          d_fun y.1 = (s.ι.app u).hom y := by
        intro u y
        let w : J_S := u ⊔ u_sing y.1
        have hw1 := congrArg (fun q => q.hom y) (s.w (homOfLE (le_sup_left : u ≤ w)))
        have hw2 := congrArg (fun q => q.hom ⟨y.1, hx_mem y.1⟩) (s.w (homOfLE (le_sup_right : u_sing y.1 ≤ w)))
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hw1 hw2
        have h_sub_eq : (F_K.map (homOfLE (le_sup_left : u ≤ w))).hom y =
            (F_K.map (homOfLE (le_sup_right : u_sing y.1 ≤ w))).hom ⟨y.1, hx_mem y.1⟩ := by
          apply Subtype.ext; rfl
        rw [h_sub_eq] at hw1
        exact hw2.symm.trans hw1
      let d_hom : K →+* ↑s.pt :=
        { toFun := d_fun
          map_one' := by
            change d_fun (1 : ↥(Algebra.adjoin B₀ (↑(⊥ : J_S).1 : Set K))).1 = 1
            rw [hd_compat ⊥ 1, map_one]
          map_mul' := fun x y => by
            let u : J_S := u_sing x ⊔ u_sing y
            have hx_u : x ∈ Algebra.adjoin B₀ (↑u.1 : Set K) :=
              Algebra.adjoin_mono (Finset.coe_subset.mpr (show (u_sing x).1 ⊆ u.1 from le_sup_left)) (hx_mem x)
            have hy_u : y ∈ Algebra.adjoin B₀ (↑u.1 : Set K) :=
              Algebra.adjoin_mono (Finset.coe_subset.mpr (show (u_sing y).1 ⊆ u.1 from le_sup_right)) (hx_mem y)
            let x_u : ↥(Algebra.adjoin B₀ (↑u.1 : Set K)) := ⟨x, hx_u⟩
            let y_u : ↥(Algebra.adjoin B₀ (↑u.1 : Set K)) := ⟨y, hy_u⟩
            change d_fun (x_u * y_u).1 = d_fun x_u.1 * d_fun y_u.1
            rw [hd_compat u (x_u * y_u), hd_compat u x_u, hd_compat u y_u, map_mul]
          map_zero' := by
            change d_fun (0 : ↥(Algebra.adjoin B₀ (↑(⊥ : J_S).1 : Set K))).1 = 0
            rw [hd_compat ⊥ 0, map_zero]
          map_add' := fun x y => by
            let u : J_S := u_sing x ⊔ u_sing y
            have hx_u : x ∈ Algebra.adjoin B₀ (↑u.1 : Set K) :=
              Algebra.adjoin_mono (Finset.coe_subset.mpr (show (u_sing x).1 ⊆ u.1 from le_sup_left)) (hx_mem x)
            have hy_u : y ∈ Algebra.adjoin B₀ (↑u.1 : Set K) :=
              Algebra.adjoin_mono (Finset.coe_subset.mpr (show (u_sing y).1 ⊆ u.1 from le_sup_right)) (hx_mem y)
            let x_u : ↥(Algebra.adjoin B₀ (↑u.1 : Set K)) := ⟨x, hx_u⟩
            let y_u : ↥(Algebra.adjoin B₀ (↑u.1 : Set K)) := ⟨y, hy_u⟩
            change d_fun (x_u + y_u).1 = d_fun x_u.1 + d_fun y_u.1
            rw [hd_compat u (x_u + y_u), hd_compat u x_u, hd_compat u y_u, map_add] }
      exact ⟨CommRingCat.ofHom d_hom, hd_compat⟩
    choose descK hdescK using hDescK
    refine ⟨CategoryTheory.Limits.IsColimit.mk descK ?_ ?_⟩
    · intro s u
      apply CommRingCat.hom_ext; apply RingHom.ext; intro y
      exact hdescK s u y
    · intro s d hd
      apply CommRingCat.hom_ext; apply RingHom.ext; intro x
      have hx := congrArg (fun q => q.hom ⟨x, hx_mem x⟩) (hd (u_sing x))
      exact hx.trans (hdescK s (u_sing x) ⟨x, hx_mem x⟩).symm

  
