        let e_R1 : (R ⧸ m_R ^ 1) ≃ₗ[K] K :=
          { ((Ideal.quotEquivOfEq (pow_one m_R)).trans e_KkR.symm) with
            map_smul' := fun c x => by
              obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective (m_R ^ 1) x
