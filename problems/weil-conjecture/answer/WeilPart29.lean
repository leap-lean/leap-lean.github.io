      ((η₀.app 𝒢).hom.app (Opposite.op V)) s = 0 ↔
        ∃ S_cov ∈ J₀ V, ∀ ⦃W : C₀⦄ (f : Quiver.Hom W V),
          S_cov.arrows f → P₀ W ∨ (𝒢.obj.map f.op) s = 0 := by
    intro 𝒢 V s
    change s = 0 ↔ _
    refine ⟨fun hs => ⟨⊤, J₀.top_mem V, fun W f _ => Or.inr ?_⟩, fun ⟨S_cov, hS_cov, h_arr⟩ => ?_⟩
    · rw [hs, hModZero]
    · exact hSepZero 𝒢 hS_cov s (fun W f hf => (h_arr f hf).elim False.elim id)
  obtain ⟨ω₀, hω₀_iso, hω₀_nat_raw, hω₀_norm_raw⟩ := mkOmega P₀ hP₀ E₀ η₀ hEpi₀ hKer₀
  have hω₀_nat : ∀ {𝒢 𝒢' : ℳ₀} (u : 𝒢 ⟶ 𝒢'),
      CategoryTheory.MonoidalCategoryStruct.whiskerRight u.hom One₀.obj ≫ ω₀ 𝒢' =
        ω₀ 𝒢 ≫ u.hom :=
    fun u => hω₀_nat_raw u
  have hω₀_norm : ∀ 𝒢 : ℳ₀,
      CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj ι_R ≫ ω₀ 𝒢 =
        (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj).hom := by
    intro 𝒢
    have h := hω₀_norm_raw 𝒢
    have h1 : ι_R ≫ (η₀.app One₀).hom = ι_R := CategoryTheory.Category.comp_id ι_R
    have h2 : (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj).hom ≫ (η₀.app 𝒢).hom =
        (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj).hom :=
      CategoryTheory.Category.comp_id _
    rwa [h1, h2] at h
  obtain ⟨ω, hω_iso, hω_nat, hω_norm⟩ := mkOmega P hP E η hEpi hKer
  let adj := CategoryTheory.sheafificationAdjunction J₀ (ModuleCat.{u, u} R)
  have hcounit_nat : ∀ {𝒳 𝒴 : ℳ₀} (g : 𝒳 ⟶ 𝒴),
      L.map g.hom ≫ adj.counit.app 𝒴 = adj.counit.app 𝒳 ≫ g :=
    fun g => adj.counit.naturality g
  have : ∀ ℋ : ℳ₀, CategoryTheory.IsIso (adj.counit.app ℋ) := fun _ => inferInstance
  have : ∀ 𝒢 : ℳ₀, CategoryTheory.IsIso (L.map (ω₀ 𝒢)) := hω₀_iso
  have : ∀ 𝒢 : ℳ₀, CategoryTheory.IsIso (L.map (ω 𝒢)) := hω_iso
  let rStd : CategoryTheory.Iso (T.flip.obj One₀) (CategoryTheory.Functor.id ℳ₀) :=
    CategoryTheory.NatIso.ofComponents
      (fun 𝒢 => CategoryTheory.asIso (L.map (ω₀ 𝒢)) ≪≫ CategoryTheory.asIso (adj.counit.app 𝒢))
      (fun {𝒢 𝒢'} u => by
        change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight u.hom One₀.obj) ≫
            (L.map (ω₀ 𝒢') ≫ adj.counit.app 𝒢') =
          (L.map (ω₀ 𝒢) ≫ adj.counit.app 𝒢) ≫ u
        rw [← CategoryTheory.Category.assoc, ← L.map_comp, hω₀_nat u, L.map_comp,
          CategoryTheory.Category.assoc, hcounit_nat u, ← CategoryTheory.Category.assoc])
  let isoR₀ : CategoryTheory.Iso (T.flip.obj (E.obj One₀)) E :=
    CategoryTheory.NatIso.ofComponents
      (fun 𝒢 => CategoryTheory.asIso (L.map (ω 𝒢)) ≪≫ CategoryTheory.asIso (adj.counit.app (E.obj 𝒢)))
      (fun {𝒢 𝒢'} u => by
        change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight u.hom (E.obj One₀).obj) ≫
            (L.map (ω 𝒢') ≫ adj.counit.app (E.obj 𝒢')) =
          (L.map (ω 𝒢) ≫ adj.counit.app (E.obj 𝒢)) ≫ E.map u
        rw [← CategoryTheory.Category.assoc, ← L.map_comp, hω_nat u, L.map_comp,
          CategoryTheory.Category.assoc, hcounit_nat (E.map u),
          ← CategoryTheory.Category.assoc])
  have hisoR₀_comm : ∀ 𝒢 : ℳ₀,
      (T.obj 𝒢).map (η.app One₀) ≫ isoR₀.hom.app 𝒢 =
        rStd.hom.app 𝒢 ≫ η.app 𝒢 := by
    intro 𝒢
    let f_ι : L.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj 𝒢.obj c_R) ⟶
        L.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj 𝒢.obj One₀.obj) :=
      L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj ι_R)
    have hf_ι_eq : f_ι =
        (L.mapIso (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj)).hom ≫
          CategoryTheory.inv (L.map (ω₀ 𝒢)) := by
      apply (CategoryTheory.Iso.cancel_iso_hom_right _ _ (CategoryTheory.asIso (L.map (ω₀ 𝒢)))).mp
      change f_ι ≫ L.map (ω₀ 𝒢) =
        ((L.mapIso (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj)).hom ≫
          CategoryTheory.inv (L.map (ω₀ 𝒢))) ≫ L.map (ω₀ 𝒢)
      rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.comp_id]
      dsimp [f_ι]
      rw [← L.map_comp, hω₀_norm 𝒢]
    have : CategoryTheory.IsIso f_ι := by
      rw [hf_ι_eq]
      exact CategoryTheory.IsIso.comp_isIso
    have h_pre : L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj (η.app One₀).hom) ≫
          L.map (ω 𝒢) =
        L.map (ω₀ 𝒢) ≫ L.map (η.app 𝒢).hom := by
      apply (CategoryTheory.cancel_epi f_ι).mp
      dsimp [f_ι]
      calc
        L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj ι_R) ≫
            (L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj (η.app One₀).hom) ≫
              L.map (ω 𝒢))
          = L.map ((CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj ι_R ≫
              CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj (η.app One₀).hom) ≫ ω 𝒢) := by
            rw [← CategoryTheory.Category.assoc, ← L.map_comp, ← L.map_comp]
        _ = L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj
              (ι_R ≫ (η.app One₀).hom) ≫ ω 𝒢) := by
            rw [← CategoryTheory.MonoidalCategory.whiskerLeft_comp]
        _ = L.map ((CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj).hom ≫
              (η.app 𝒢).hom) := by
            rw [hω_norm 𝒢]
        _ = L.map ((CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj ι_R ≫ ω₀ 𝒢) ≫
              (η.app 𝒢).hom) := by
            rw [← hω₀_norm 𝒢]
        _ = L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj ι_R) ≫
              (L.map (ω₀ 𝒢) ≫ L.map (η.app 𝒢).hom) := by
            rw [CategoryTheory.Category.assoc, L.map_comp, L.map_comp]
    change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj (η.app One₀).hom) ≫
        (L.map (ω 𝒢) ≫ adj.counit.app (E.obj 𝒢)) =
      (L.map (ω₀ 𝒢) ≫ adj.counit.app 𝒢) ≫ η.app 𝒢
    rw [← CategoryTheory.Category.assoc, h_pre, CategoryTheory.Category.assoc,
      hcounit_nat (𝒳 := 𝒢) (η.app 𝒢), ← CategoryTheory.Category.assoc]
  let isoR : CategoryTheory.Iso (T.flip.obj ℱ) E := T.flip.mapIso ϕ ≪≫ isoR₀
  have hConj1 : ∀ 𝒢 : ℳ₀,
      CategoryTheory.CategoryStruct.comp ((T.obj 𝒢).map q) (isoR.hom.app 𝒢) =
        CategoryTheory.CategoryStruct.comp (rStd.hom.app 𝒢) (η.app 𝒢) := by
    intro 𝒢
    change (T.obj 𝒢).map q ≫ ((T.obj 𝒢).map ϕ.hom ≫ isoR₀.hom.app 𝒢) =
      rStd.hom.app 𝒢 ≫ η.app 𝒢
    rw [← CategoryTheory.Category.assoc, ← (T.obj 𝒢).map_comp, hq]
    exact hisoR₀_comm 𝒢
  let β_sh (𝒳 : ℳ₀) : CategoryTheory.Iso (T.obj 𝒳) (T.flip.obj 𝒳) :=
    CategoryTheory.NatIso.ofComponents
      (fun 𝒢 => L.mapIso (CategoryTheory.BraidedCategory.braiding 𝒳.obj 𝒢.obj))
      (fun {𝒢 𝒢'} u => by
        change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒳.obj u.hom) ≫
            L.map (CategoryTheory.BraidedCategory.braiding 𝒳.obj 𝒢'.obj).hom =
          L.map (CategoryTheory.BraidedCategory.braiding 𝒳.obj 𝒢.obj).hom ≫
            L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight u.hom 𝒳.obj)
        rw [← L.map_comp, ← L.map_comp,
          CategoryTheory.BraidedCategory.braiding_naturality_right 𝒳.obj u.hom])
  let lStd : CategoryTheory.Iso (T.obj One₀) (CategoryTheory.Functor.id ℳ₀) :=
    β_sh One₀ ≪≫ rStd
  let isoL : CategoryTheory.Iso (T.obj ℱ) E :=
    β_sh ℱ ≪≫ isoR
  have hConj2 : ∀ 𝒢 : ℳ₀,
      CategoryTheory.CategoryStruct.comp ((T.flip.obj 𝒢).map q) (isoL.hom.app 𝒢) =
        CategoryTheory.CategoryStruct.comp (lStd.hom.app 𝒢) (η.app 𝒢) := by
    intro 𝒢
    change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight q.hom 𝒢.obj) ≫
        (L.map (CategoryTheory.BraidedCategory.braiding ℱ.obj 𝒢.obj).hom ≫ isoR.hom.app 𝒢) =
      (L.map (CategoryTheory.BraidedCategory.braiding One₀.obj 𝒢.obj).hom ≫ rStd.hom.app 𝒢) ≫
        η.app 𝒢
    calc
      L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight q.hom 𝒢.obj) ≫
          (L.map (CategoryTheory.BraidedCategory.braiding ℱ.obj 𝒢.obj).hom ≫ isoR.hom.app 𝒢)
        = (L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight q.hom 𝒢.obj) ≫
            L.map (CategoryTheory.BraidedCategory.braiding ℱ.obj 𝒢.obj).hom) ≫ isoR.hom.app 𝒢 :=
          (CategoryTheory.Category.assoc _ _ _).symm
      _ = (L.map (CategoryTheory.BraidedCategory.braiding One₀.obj 𝒢.obj).hom ≫
            L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj q.hom)) ≫ isoR.hom.app 𝒢 := by
          rw [← L.map_comp, ← L.map_comp,
            CategoryTheory.BraidedCategory.braiding_naturality_left q.hom 𝒢.obj]
      _ = L.map (CategoryTheory.BraidedCategory.braiding One₀.obj 𝒢.obj).hom ≫
            ((T.obj 𝒢).map q ≫ isoR.hom.app 𝒢) :=
          CategoryTheory.Category.assoc _ _ _
      _ = L.map (CategoryTheory.BraidedCategory.braiding One₀.obj 𝒢.obj).hom ≫
            (rStd.hom.app 𝒢 ≫ η.app 𝒢) := by
          rw [hConj1 𝒢]
      _ = (L.map (CategoryTheory.BraidedCategory.braiding One₀.obj 𝒢.obj).hom ≫ rStd.hom.app 𝒢) ≫
            η.app 𝒢 :=
          (CategoryTheory.Category.assoc _ _ _).symm
  exact ⟨⟨rStd, isoR, hConj1⟩, ⟨lStd, isoL, hConj2⟩⟩

theorem weil_gysin_small_site_module_tensor_koszul_even_comm (C₀ : Type u) [CategoryTheory.SmallCategory C₀]
    (J₀ : CategoryTheory.GrothendieckTopology C₀)
    (R : Type u) [CommRing R] :
    let ℳ₀ := CategoryTheory.Sheaf J₀ (ModuleCat.{u, u} R)
    let One₀ := (CategoryTheory.constantSheaf J₀ (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
    (∀ (a b c : ℕ) (hab : 2 * a + 2 * b = c) (hba : 2 * b + 2 * a = c)
        (α : CategoryTheory.Abelian.Ext.{u} One₀ One₀ (2 * a))
        (β : CategoryTheory.Abelian.Ext.{u} One₀ One₀ (2 * b)),
      α.comp β hab = β.comp α hba) ∧
    (∀ (P₁ P₂ : C₀ → Prop),
      (∀ {W' W : C₀}, Quiver.Hom W' W → P₁ W → P₁ W') →
      (∀ {W' W : C₀}, Quiver.Hom W' W → P₂ W → P₂ W') →
      ∀ (E₁ E₂ : CategoryTheory.Functor ℳ₀ ℳ₀)
        [E₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits E₁]
        [CategoryTheory.Limits.PreservesFiniteColimits E₁]
        [E₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits E₂]
        [CategoryTheory.Limits.PreservesFiniteColimits E₂]
        (η₁ : CategoryTheory.NatTrans (CategoryTheory.Functor.id ℳ₀) E₁)
        (η₂ : CategoryTheory.NatTrans (CategoryTheory.Functor.id ℳ₀) E₂),
        (∀ 𝒢 : ℳ₀, CategoryTheory.Epi (η₁.app 𝒢)) →
        (∀ (𝒢 : ℳ₀) (V : C₀) (s : 𝒢.obj.obj (Opposite.op V)),
          ((η₁.app 𝒢).hom.app (Opposite.op V)) s = 0 ↔
            ∃ S ∈ J₀ V, ∀ ⦃W : C₀⦄ (f : Quiver.Hom W V),
              S.arrows f → P₁ W ∨ (𝒢.obj.map f.op) s = 0) →
        (∀ 𝒢 : ℳ₀, CategoryTheory.Epi (η₂.app 𝒢)) →
        (∀ (𝒢 : ℳ₀) (V : C₀) (s : 𝒢.obj.obj (Opposite.op V)),
          ((η₂.app 𝒢).hom.app (Opposite.op V)) s = 0 ↔
            ∃ S ∈ J₀ V, ∀ ⦃W : C₀⦄ (f : Quiver.Hom W V),
              S.arrows f → P₂ W ∨ (𝒢.obj.map f.op) s = 0) →
        ∀ (ℱ₁ ℱ₂ ℱ₁₂ : ℳ₀)
          (q₁ : Quiver.Hom One₀ ℱ₁) (q₂ : Quiver.Hom One₀ ℱ₂) (q₁₂ : Quiver.Hom One₀ ℱ₁₂)
          (ϕ₁ : CategoryTheory.Iso ℱ₁ (E₁.obj One₀))
          (ϕ₂ : CategoryTheory.Iso ℱ₂ (E₂.obj One₀))
          (ψ₁₂ : CategoryTheory.Iso ℱ₁₂ (E₁.obj ℱ₂))
          (ψ₂₁ : CategoryTheory.Iso ℱ₁₂ (E₂.obj ℱ₁)),
          CategoryTheory.CategoryStruct.comp q₁ ϕ₁.hom = η₁.app One₀ →
          CategoryTheory.CategoryStruct.comp q₂ ϕ₂.hom = η₂.app One₀ →
          CategoryTheory.CategoryStruct.comp q₁₂ ψ₁₂.hom =
            CategoryTheory.CategoryStruct.comp (η₁.app One₀) (E₁.map q₂) →
          CategoryTheory.CategoryStruct.comp q₁₂ ψ₂₁.hom =
            CategoryTheory.CategoryStruct.comp (η₂.app One₀) (E₂.map q₁) →
          ∀ (a b c : ℕ) (hab : 2 * a + 2 * b = c) (hba : 2 * b + 2 * a = c)
            (γ₂ : CategoryTheory.Abelian.Ext.{u} ℱ₂ One₀ (2 * a))
            (γ₁ : CategoryTheory.Abelian.Ext.{u} ℱ₁ One₀ (2 * b)),
            (((CategoryTheory.Abelian.Ext.mk₀ ψ₁₂.hom).comp
                (CategoryTheory.Abelian.Ext.mapExactFunctor E₁ γ₂)
                (Nat.zero_add (2 * a))).comp
              (CategoryTheory.Abelian.Ext.mk₀ ϕ₁.inv) (Nat.add_zero (2 * a))).comp
              γ₁ hab =
            (((CategoryTheory.Abelian.Ext.mk₀ ψ₂₁.hom).comp
                (CategoryTheory.Abelian.Ext.mapExactFunctor E₂ γ₁)
                (Nat.zero_add (2 * b))).comp
              (CategoryTheory.Abelian.Ext.mk₀ ϕ₂.inv) (Nat.add_zero (2 * b))).comp
              γ₂ hba) :=
by
  intro ℳ₀ One₀
  let Psh₀ := CategoryTheory.Functor (Opposite C₀) (ModuleCat.{u, u} R)
  let S := CategoryTheory.sheafToPresheaf J₀ (ModuleCat.{u, u} R)
  let L := CategoryTheory.presheafToSheaf J₀ (ModuleCat.{u, u} R)
  let T : CategoryTheory.Functor ℳ₀ (CategoryTheory.Functor ℳ₀ ℳ₀) :=
    (((S.comp (CategoryTheory.MonoidalCategory.curriedTensor Psh₀)).comp
      ((CategoryTheory.Functor.whiskeringLeft ℳ₀ Psh₀ Psh₀).obj S)).comp
      ((CategoryTheory.Functor.whiskeringRight ℳ₀ Psh₀ ℳ₀).obj L))
  obtain ⟨⟨hAddColimL, hAddColimR⟩, hCovers, lUnit, rUnit, hUnitEq⟩ :=
    weil_gysin_sheaf_tensor_colimits_unitors_and_free_covers C₀ J₀ R
  have hAddL : ∀ X : ℳ₀, (T.obj X).Additive := fun X => (hAddColimL X).1
  have hColimL : ∀ X : ℳ₀, CategoryTheory.Limits.PreservesFiniteColimits (T.obj X) :=
    fun X => (hAddColimL X).2
  have hAddR : ∀ Y : ℳ₀, (T.flip.obj Y).Additive := fun Y => (hAddColimR Y).1
  have hColimR : ∀ Y : ℳ₀, CategoryTheory.Limits.PreservesFiniteColimits (T.flip.obj Y) :=
    fun Y => (hAddColimR Y).2
  have hLimOneL : CategoryTheory.Limits.PreservesFiniteLimits (T.obj One₀) :=
    CategoryTheory.Limits.preservesFiniteLimits_of_natIso lUnit.symm
  have hLimOneR : CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj One₀) :=
    CategoryTheory.Limits.preservesFiniteLimits_of_natIso rUnit.symm
  have hlUnit_inv_hom : lUnit.inv.app One₀ ≫ lUnit.hom.app One₀ = 𝟙 One₀ :=
    lUnit.inv_hom_id_app One₀
  have hUnitInv : lUnit.inv.app One₀ = rUnit.inv.app One₀ := by
    apply (CategoryTheory.Iso.cancel_iso_hom_left (lUnit.app One₀) _ _).mp
    change lUnit.hom.app One₀ ≫ lUnit.inv.app One₀ = lUnit.hom.app One₀ ≫ rUnit.inv.app One₀
    rw [lUnit.hom_inv_id_app One₀, hUnitEq, rUnit.hom_inv_id_app One₀]
    rfl
  have hNatId : ∀ (α : CategoryTheory.Functor.id ℳ₀ ≅ CategoryTheory.Functor.id ℳ₀)
      {X Y : ℳ₀} (g : X ⟶ Y),
      g ≫ α.hom.app Y = α.hom.app X ≫ g :=
    fun α _ _ g => α.hom.naturality g
  have hlUnit_cancel_left : ∀ {n : ℕ} (w : CategoryTheory.Abelian.Ext.{u} One₀ One₀ n)
      (h0n : 0 + n = n),
      ((CategoryTheory.Abelian.Ext.mk₀ (lUnit.inv.app One₀)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (lUnit.hom.app One₀)) (Nat.add_zero 0)).comp w h0n = w := by
    intro n w h0n
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hlUnit_inv_hom]
    exact CategoryTheory.Abelian.Ext.mk₀_id_comp w
  have hNatIsoExt : ∀ (F G : CategoryTheory.Functor ℳ₀ ℳ₀)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (e : F ≅ G) (n : ℕ) (A B : ℳ₀)
      (ξ : CategoryTheory.Abelian.Ext.{u} A B n),
      CategoryTheory.Abelian.Ext.mapExactFunctor F ξ =
        ((CategoryTheory.Abelian.Ext.mk₀ (e.hom.app A)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G ξ)
          (Nat.zero_add n)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (e.inv.app B)) (Nat.add_zero n) := by
    intro F G _ _ _ _ _ _ e n
    induction n with
    | zero =>
      intro A B ξ
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A B).2 ξ
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      have hnat := e.hom.naturality f
      rw [← CategoryTheory.Category.comp_id (F.map f), ← e.hom_inv_id_app B,
        ← CategoryTheory.Category.assoc, hnat, CategoryTheory.Category.assoc]
    | succ n' ih =>
      intro A B ξ
      let I := CategoryTheory.Injective.under B
      let ι : B ⟶ I := CategoryTheory.Injective.ι B
      let S_inj := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hS_inj : S_inj.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hSub : Subsingleton (CategoryTheory.Abelian.Ext.{u} A I (n' + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton I 1 (n' + 1)
          (Nat.succ_le_succ (Nat.zero_le n')) A
      have h0 : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ S_inj.f) (Nat.add_zero (n' + 1)) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨δ, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS_inj ξ h0 rfl
      have hSF : (S_inj.map F).ShortExact := hS_inj.map_of_exact F
      have hSG : (S_inj.map G).ShortExact := hS_inj.map_of_exact G
      let φ_S : S_inj.map G ⟶ S_inj.map F :=
