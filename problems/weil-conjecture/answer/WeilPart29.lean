    rw [heval]
    change (((adj_Wx.homEquiv A_ℤ R_T) g_T).hom) (ULift.up (1 : ℤ)) = e_T
    rw [(adj_Wx.homEquiv A_ℤ R_T).apply_symm_apply]
    exact one_zsmul e_T

  refine ⟨hB1, hB2, fun s hs => ?_⟩
  have hSub_pf_s : Subsingleton ((pf_σ.obj C_m).H s) := by
    rw [← Nat.sub_add_cancel hs]
    exact hVanish_pf (s - 1) C_m
  have hSub_L_s : Subsingleton (L_σ.H s) := by
    apply subsingleton_of_forall_eq 0
    intro z
    have hz_pf : z.comp (CategoryTheory.Abelian.Ext.mk₀ e_clopen.hom) (Nat.add_zero s) = 0 :=
      @Subsingleton.elim _ hSub_pf_s _ _
    calc
      z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 L_σ)) (Nat.add_zero s) :=
        (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
      _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (e_clopen.hom ≫ e_clopen.inv)) (Nat.add_zero s) := by
        rw [e_clopen.hom_inv_id]
      _ = z.comp ((CategoryTheory.Abelian.Ext.mk₀ e_clopen.hom).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_clopen.inv) (Nat.add_zero 0)) (Nat.add_zero s) := by
        rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = (z.comp (CategoryTheory.Abelian.Ext.mk₀ e_clopen.hom) (Nat.add_zero s)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_clopen.inv) (Nat.add_zero s) :=
        (z.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ e_clopen.hom)
          (CategoryTheory.Abelian.Ext.mk₀ e_clopen.inv)
          (Nat.add_zero s) (Nat.add_zero 0) (Nat.add_zero s)).symm
      _ = 0 := by rw [hz_pf, CategoryTheory.Abelian.Ext.zero_comp]

  change Subsingleton (CategoryTheory.Abelian.Ext R_T L_σ s)
  apply subsingleton_of_forall_eq 0
  intro x
  have hy_zero : (CategoryTheory.Abelian.Ext.mk₀ g_T).comp x (Nat.zero_add s) = 0 :=
    @Subsingleton.elim _ hSub_L_s _ _
  calc
    x = (CategoryTheory.Abelian.Ext.mk₀ (𝟙 R_T)).comp x (Nat.zero_add s) :=
      (CategoryTheory.Abelian.Ext.mk₀_id_comp x).symm
    _ = (CategoryTheory.Abelian.Ext.mk₀ (f_T ≫ g_T)).comp x (Nat.zero_add s) := by
      rw [hf_g_id]
    _ = ((CategoryTheory.Abelian.Ext.mk₀ f_T).comp
        (CategoryTheory.Abelian.Ext.mk₀ g_T) (Nat.zero_add 0)).comp x (Nat.zero_add s) := by
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    _ = (CategoryTheory.Abelian.Ext.mk₀ f_T).comp
        ((CategoryTheory.Abelian.Ext.mk₀ g_T).comp x (Nat.zero_add s)) (Nat.zero_add s) :=
      (CategoryTheory.Abelian.Ext.mk₀ f_T).comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ g_T) x (Nat.zero_add 0) (Nat.zero_add s) (Nat.zero_add s)
    _ = 0 := by rw [hy_zero, CategoryTheory.Abelian.Ext.comp_zero]

