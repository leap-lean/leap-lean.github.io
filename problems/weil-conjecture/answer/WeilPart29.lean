  let B_s := weilEtaleSitePullback s
  let B_i := weilEtaleSitePullback i
  let B_si := weilEtaleSitePullback si
  letI : B_s.IsContinuous Z.smallEtaleTopology S₀.smallEtaleTopology := τ_Z.hCont
  letI : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := τ_Y.hCont
  letI : B_si.IsContinuous Y.smallEtaleTopology S₀.smallEtaleTopology := τ_SY.hCont
  let s_push := B_s.sheafPushforwardContinuous (ModuleCat.{u, u} R)
    Z.smallEtaleTopology S₀.smallEtaleTopology
  let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R)
    Y.smallEtaleTopology Z.smallEtaleTopology
  let si_push := B_si.sheafPushforwardContinuous (ModuleCat.{u, u} R)
    Y.smallEtaleTopology S₀.smallEtaleTopology

  let adj_S₀ := CategoryTheory.constantSheafAdj S₀.smallEtaleTopology (ModuleCat.{u, u} R) hT_S₀
  let adj_Z₀ := CategoryTheory.constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) hT_Z₀
  let adj_Y₀ := CategoryTheory.constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) hT_Y₀

  let q_s : Quiver.Hom One_Z (s_push.obj One_S) :=
    (adj_Z₀.homEquiv R_mod (s_push.obj One_S)).symm
      (CategoryTheory.CategoryStruct.comp (adj_S₀.unit.app R_mod)
        (One_S.obj.map (hT_S₀.from (B_s.obj T_Z₀)).op))
  let q_i : Quiver.Hom One_Y (i_push.obj One_Z) :=
    (adj_Y₀.homEquiv R_mod (i_push.obj One_Z)).symm
      (CategoryTheory.CategoryStruct.comp (adj_Z₀.unit.app R_mod)
        (One_Z.obj.map (hT_Z₀.from (B_i.obj T_Y₀)).op))
  let q_si : Quiver.Hom One_Y (si_push.obj One_S) :=
    (adj_Y₀.homEquiv R_mod (si_push.obj One_S)).symm
      (CategoryTheory.CategoryStruct.comp (adj_S₀.unit.app R_mod)
        (One_S.obj.map (hT_S₀.from (B_si.obj T_Y₀)).op))

  let cl_Z_mod : weilEtaleModuleH Z m p :=
    (CategoryTheory.Abelian.Ext.mk₀ q_s).comp τ_Z.val (Nat.zero_add p)
  let γ_mod : weilEtaleModuleH Y m q :=
    (CategoryTheory.Abelian.Ext.mk₀ q_i).comp τ_Y.val (Nat.zero_add q)
  let cl_SY_mod : weilEtaleModuleH Y m pq :=
    (CategoryTheory.Abelian.Ext.mk₀ q_si).comp τ_SY.val (Nat.zero_add pq)

  have hcl_Z_eq : cl_Z = θ_Zp cl_Z_mod := by
    rcases hfg_Z with ⟨U_fg, hU_obj, hU_map, hAdd, hLim, hColim, T_Z', hT_Z', T_S', hT_S',
      u_unit, hu_unit, πM, hαπ, hπα, hcl⟩
    have hqs_eq := hTermPushMate S₀.smallEtaleTopology Z.smallEtaleTopology B_s
      hT_S' hT_S₀ hT_Z' hT_Z₀ R_mod
    rw [hcl]
    exact (congrArg
      (fun q_s' : Quiver.Hom One_Z (s_push.obj One_S) =>
        (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp _ (Nat.add_zero p)
          ((CategoryTheory.Abelian.Ext.mk₀ _).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U_fg hAdd hLim hColim _ _
              One_Z One_Z p)
              ((CategoryTheory.Abelian.Ext.mk₀ q_s').comp τ_Z.val (Nat.zero_add p)))
            (Nat.zero_add p)))
      hqs_eq).trans
      (hAlignWit Z U_fg hU_obj hU_map hAdd hLim hColim T_Z' hT_Z'
        u_unit hu_unit πM hαπ hπα p θ_Zp hθ_Zp cl_Z_mod)

  have hγ_Y_eq : γ_Y = θ_Yq γ_mod := by
    rcases hfg_Y with ⟨U_fg, hU_obj, hU_map, hAdd, hLim, hColim, T_Y', hT_Y', T_Z', hT_Z',
      u_unit, hu_unit, πM, hαπ, hπα, hcl⟩
    have hqi_eq := hTermPushMate Z.smallEtaleTopology Y.smallEtaleTopology B_i
      hT_Z' hT_Z₀ hT_Y' hT_Y₀ R_mod
    rw [hcl]
    exact (congrArg
      (fun q_i' : Quiver.Hom One_Y (i_push.obj One_Z) =>
        (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp _ (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ _).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U_fg hAdd hLim hColim _ _
              One_Y One_Y q)
              ((CategoryTheory.Abelian.Ext.mk₀ q_i').comp τ_Y.val (Nat.zero_add q)))
            (Nat.zero_add q)))
      hqi_eq).trans
      (hAlignWit Y U_fg hU_obj hU_map hAdd hLim hColim T_Y' hT_Y'
        u_unit hu_unit πM hαπ hπα q θ_Yq hθ_Yq γ_mod)

  have hcl_SY_eq : cl_SY = θ_Ypq cl_SY_mod := by
    rcases hfg_SY with ⟨U_fg, hU_obj, hU_map, hAdd, hLim, hColim, T_Y', hT_Y', T_S', hT_S',
      u_unit, hu_unit, πM, hαπ, hπα, hcl⟩
    have hqsi_eq := hTermPushMate S₀.smallEtaleTopology Y.smallEtaleTopology B_si
      hT_S' hT_S₀ hT_Y' hT_Y₀ R_mod
    rw [hcl]
    exact (congrArg
      (fun q_si' : Quiver.Hom One_Y (si_push.obj One_S) =>
        (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp _ (Nat.add_zero pq)
          ((CategoryTheory.Abelian.Ext.mk₀ _).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U_fg hAdd hLim hColim _ _
              One_Y One_Y pq)
              ((CategoryTheory.Abelian.Ext.mk₀ q_si').comp τ_SY.val (Nat.zero_add pq)))
            (Nat.zero_add pq)))
      hqsi_eq).trans
      (hAlignWit Y U_fg hU_obj hU_map hAdd hLim hColim T_Y' hT_Y'
        u_unit hu_unit πM hαπ hπα pq θ_Ypq hθ_Ypq cl_SY_mod)

  have hc_Y_eq : ∀ (α : weilEtaleModuleH Y m q) (β : weilEtaleModuleH Y m p),
      c_Y (θ_Yq α) (θ_Yp β) = θ_Ypq (α.comp β hqp) := by
    intro α β
    rcases hc_Y with ⟨U_cup, hU_obj, hU_map, hAdd, hLim, hColim, T_Y', hT_Y',
      u_unit, hu_unit, πM, hαπ, hπα, hcup⟩
    have hq_al := hAlignWit Y U_cup hU_obj hU_map hAdd hLim hColim T_Y' hT_Y'
      u_unit hu_unit πM hαπ hπα q θ_Yq hθ_Yq α
    have hp_al := hAlignWit Y U_cup hU_obj hU_map hAdd hLim hColim T_Y' hT_Y'
      u_unit hu_unit πM hαπ hπα p θ_Yp hθ_Yp β
    have hpq_al := hAlignWit Y U_cup hU_obj hU_map hAdd hLim hColim T_Y' hT_Y'
      u_unit hu_unit πM hαπ hπα pq θ_Ypq hθ_Ypq (α.comp β hqp)
    rw [← hq_al, ← hp_al, ← hpq_al]
    exact hcup α β

  rcases hGys with ⟨hAdd_push, hLim_push, hColim_push,
    T_Sg, hT_Sg, T_Zg, hT_Zg, T_Yg, hT_Yg,
    α_push, _, _, _, hq_si_raw, hτ_SY_raw⟩
  letI := hAdd_push; letI := hLim_push; letI := hColim_push
  have hq_si_comp : CategoryTheory.CategoryStruct.comp q_si α_push =
      CategoryTheory.CategoryStruct.comp q_i (i_push.map q_s) := by
    have hqs_g := hTermPushMate S₀.smallEtaleTopology Z.smallEtaleTopology B_s
      hT_Sg hT_S₀ hT_Zg hT_Z₀ R_mod
    have hqi_g := hTermPushMate Z.smallEtaleTopology Y.smallEtaleTopology B_i
      hT_Zg hT_Z₀ hT_Yg hT_Y₀ R_mod
    have hqsi_g := hTermPushMate S₀.smallEtaleTopology Y.smallEtaleTopology B_si
      hT_Sg hT_S₀ hT_Yg hT_Y₀ R_mod
    exact (congrArg (fun x => CategoryTheory.CategoryStruct.comp x α_push) hqsi_g.symm).trans
      (hq_si_raw.trans
        (congrArg₂ CategoryTheory.CategoryStruct.comp hqi_g (congrArg i_push.map hqs_g)))
  have hτ_SY_eq : τ_SY.val =
      ((CategoryTheory.Abelian.Ext.mk₀ α_push).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor i_push τ_Z.val)
        (Nat.zero_add p)).comp τ_Y.val hpq :=
    hτ_SY_raw

  
  
  
  
  let φ_ZR : ℤ →+* R := Int.castRingHom R
  let eZ := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
  let isoF_fg : (ModuleCat.restrictScalars φ_ZR).comp eZ.functor ≅ F_fg :=
    CategoryTheory.NatIso.ofComponents
      (fun M => CategoryTheory.Iso.refl (AddCommGrpCat.of ↑M))
      (fun _ => by simp; rfl)
  let L_fg : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
    eZ.inverse.comp (ModuleCat.extendScalars φ_ZR)
  let R_fg : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
    eZ.inverse.comp (ModuleCat.coextendScalars φ_ZR)
  let adj_L_fg : L_fg ⊣ F_fg :=
    (eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj φ_ZR)).ofNatIsoRight isoF_fg
  let adj_R_fg : F_fg ⊣ R_fg :=
    ((ModuleCat.restrictCoextendScalarsAdj φ_ZR).comp eZ.toAdjunction).ofNatIsoLeft isoF_fg
  have hHasCompose_F : ∀ W : AlgebraicGeometry.Scheme.{u},
      W.smallEtaleTopology.HasSheafCompose F_fg :=
    fun W => @CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize _ _ _ _ _ _
      W.smallEtaleTopology F_fg adj_L_fg.rightAdjoint_preservesLimits
  have hHasCompose_R : ∀ W : AlgebraicGeometry.Scheme.{u},
      W.smallEtaleTopology.HasSheafCompose R_fg :=
    fun W => @CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize _ _ _ _ _ _
      W.smallEtaleTopology R_fg adj_R_fg.rightAdjoint_preservesLimits

  let liftModHom : ∀ {M N : ModuleCat.{u, u} R},
      Quiver.Hom (F_fg.obj M) (F_fg.obj N) → Quiver.Hom M N :=
    fun {M N} φ =>
      ModuleCat.homMk φ (fun r => by
        obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
        have hr : (z : R) = r := ULift.ext _ _ hz
        rw [← hr, map_intCast, map_intCast, ← zsmul_one z, ← zsmul_one z]
        change CategoryTheory.CategoryStruct.comp φ
            (z • CategoryTheory.CategoryStruct.id (F_fg.obj N)) =
          CategoryTheory.CategoryStruct.comp
            (z • CategoryTheory.CategoryStruct.id (F_fg.obj M)) φ
        rw [CategoryTheory.Preadditive.comp_zsmul, CategoryTheory.Preadditive.zsmul_comp,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])

  have h_liftModHom : ∀ {M N : ModuleCat.{u, u} R}
      (φ : Quiver.Hom (F_fg.obj M) (F_fg.obj N)),
      F_fg.map (liftModHom φ) = φ :=
    fun φ => ModuleCat.forget₂_map_homMk φ _

  have hF_fg_faith : ∀ {M N : ModuleCat.{u, u} R} (f₁ f₂ : Quiver.Hom M N),
      F_fg.map f₁ = F_fg.map f₂ → f₁ = f₂ := by
    intro M N f₁ f₂ hf
    apply ModuleCat.hom_ext
    ext x
    have hx := AddCommGrpCat.hom_ext_iff.mp hf
    exact DFunLike.congr_fun hx x

  let U_of : ∀ W : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Functor
        (CategoryTheory.Sheaf W.smallEtaleTopology (ModuleCat.{u, u} R))
        (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun W => @CategoryTheory.sheafCompose _ _ _ _ _ _ W.smallEtaleTopology F_fg (hHasCompose_F W)

  have hU_exact_ff : ∀ W : AlgebraicGeometry.Scheme.{u},
      (U_of W).Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits (U_of W) ∧
      CategoryTheory.Limits.PreservesFiniteColimits (U_of W) ∧
      Nonempty (U_of W).Full ∧
      (U_of W).Faithful := by
    intro W
    let J_W := W.smallEtaleTopology
    have hAddU : (U_of W).Additive :=
      { map_add := fun {_ _} f g => by
          apply CategoryTheory.Sheaf.hom_ext
          ext V x
          rfl }
    let L_sh : CategoryTheory.Functor
        (CategoryTheory.Sheaf J_W AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R)) :=
      (CategoryTheory.sheafToPresheaf J_W AddCommGrpCat.{u}).comp
        (((CategoryTheory.Functor.whiskeringRight (W.Etale)ᵒᵖ _ _).obj L_fg).comp
          (CategoryTheory.presheafToSheaf J_W (ModuleCat.{u, u} R)))
    let adj_L_sh : L_sh ⊣ U_of W :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun 𝒜 ℱ =>
            ((CategoryTheory.sheafificationAdjunction J_W (ModuleCat.{u, u} R)).homEquiv
              (𝒜.val.comp L_fg) ℱ).trans
              (((adj_L_fg.whiskerRight (W.Etale)ᵒᵖ).homEquiv 𝒜.val ℱ.val).trans
                { toFun := fun η => ⟨η⟩
                  invFun := fun η => η.hom
                  left_inv := fun _ => rfl
                  right_inv := fun _ => rfl })
          homEquiv_naturality_left_symm := fun {𝒜' 𝒜 ℱ} f g =>
            (congrArg
              (((CategoryTheory.sheafificationAdjunction J_W (ModuleCat.{u, u} R)).homEquiv
                (𝒜'.val.comp L_fg) ℱ).symm)
              ((adj_L_fg.whiskerRight (W.Etale)ᵒᵖ).homEquiv_naturality_left_symm
                f.hom g.hom)).trans
              ((CategoryTheory.sheafificationAdjunction J_W
                (ModuleCat.{u, u} R)).homEquiv_naturality_left_symm
                (CategoryTheory.Functor.whiskerRight f.hom L_fg) _)
          homEquiv_naturality_right := fun {𝒜 ℱ ℱ'} f g => by
            apply CategoryTheory.Sheaf.hom_ext
            exact (congrArg
              ((adj_L_fg.whiskerRight (W.Etale)ᵒᵖ).homEquiv 𝒜.val ℱ'.val)
              (CategoryTheory.Adjunction.homEquiv_naturality_right
                (CategoryTheory.sheafificationAdjunction J_W (ModuleCat.{u, u} R)) f g)).trans
              (CategoryTheory.Adjunction.homEquiv_naturality_right
                (adj_L_fg.whiskerRight (W.Etale)ᵒᵖ) _ g.hom) }
    let R_sh : CategoryTheory.Functor
        (CategoryTheory.Sheaf J_W AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R)) :=
      @CategoryTheory.sheafCompose _ _ _ _ _ _ J_W R_fg (hHasCompose_R W)
    let adj_R_sh : U_of W ⊣ R_sh :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun ℱ 𝒜 =>
            ({ toFun := fun (η : Quiver.Hom ((U_of W).obj ℱ) 𝒜) => η.hom
               invFun := fun η => ⟨η⟩
               left_inv := fun _ => rfl
               right_inv := fun _ => rfl } : Equiv _ _).trans
              (((adj_R_fg.whiskerRight (W.Etale)ᵒᵖ).homEquiv ℱ.val 𝒜.val).trans
                { toFun := fun η => ⟨η⟩
                  invFun := fun η => η.hom
                  left_inv := fun _ => rfl
                  right_inv := fun _ => rfl })
          homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒜} f g => by
            apply CategoryTheory.Sheaf.hom_ext
            exact (adj_R_fg.whiskerRight (W.Etale)ᵒᵖ).homEquiv_naturality_left_symm f.hom g.hom
          homEquiv_naturality_right := fun {ℱ 𝒜 𝒜'} f g => by
            apply CategoryTheory.Sheaf.hom_ext
            exact CategoryTheory.Adjunction.homEquiv_naturality_right
              (adj_R_fg.whiskerRight (W.Etale)ᵒᵖ) f.hom g.hom }
    have hLimU : CategoryTheory.Limits.PreservesFiniteLimits (U_of W) :=
      ⟨fun _ _ _ => (adj_L_sh.rightAdjoint_preservesLimits.{0, 0}).preservesLimitsOfShape⟩
    have hColimU : CategoryTheory.Limits.PreservesFiniteColimits (U_of W) :=
      ⟨fun _ _ _ => (adj_R_sh.leftAdjoint_preservesColimits.{0, 0}).preservesColimitsOfShape⟩
    have hFaithU : (U_of W).Faithful :=
      { map_injective := fun {ℱ₁ ℱ₂} u₁ u₂ hu => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V
          apply hF_fg_faith
          exact CategoryTheory.NatTrans.congr_app
            (congrArg (fun k : Quiver.Hom ((U_of W).obj ℱ₁) ((U_of W).obj ℱ₂) => k.hom) hu) V }
    let fullInst : (U_of W).Full :=
      { map_surjective := fun {ℱ₁ ℱ₂} ψ =>
          ⟨⟨{ app := fun V => liftModHom (ψ.hom.app V)
              naturality := fun {V₁ V₂} f => by
                apply hF_fg_faith
                exact (F_fg.map_comp (ℱ₁.obj.map f) (liftModHom (ψ.hom.app V₂))).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp (F_fg.map (ℱ₁.obj.map f)))
                    (@h_liftModHom (ℱ₁.obj.obj V₂) (ℱ₂.obj.obj V₂) (ψ.hom.app V₂))).trans
                    ((ψ.hom.naturality f).trans
                      ((congrArg
                        (fun z => CategoryTheory.CategoryStruct.comp z (F_fg.map (ℱ₂.obj.map f)))
                        (@h_liftModHom (ℱ₁.obj.obj V₁) (ℱ₂.obj.obj V₁) (ψ.hom.app V₁)).symm).trans
                        (F_fg.map_comp (liftModHom (ψ.hom.app V₁)) (ℱ₂.obj.map f)).symm))) }⟩,
           by
             apply CategoryTheory.Sheaf.hom_ext
             apply CategoryTheory.NatTrans.ext
             funext V
             exact @h_liftModHom (ℱ₁.obj.obj V) (ℱ₂.obj.obj V) (ψ.hom.app V)⟩ }
    exact ⟨hAddU, hLimU, hColimU, ⟨fullInst⟩, hFaithU⟩

  
  let downRingHom : R →+* ZMod m :=
    { toFun := ULift.down
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }

  let isoOf : ∀ A : AddCommGrpCat.{u}, AddCommGrpCat.of ↑A ≅ A
    | AddCommGrpCat.mk _ => CategoryTheory.Iso.refl _

  let liftModObj : ∀ (A : AddCommGrpCat.{u}),
      (∀ x : ↑A, m • x = 0) → ModuleCat.{u, u} R :=
    fun A h_tor =>
      letI : Module (ZMod m) ↑A := AddCommGroup.zmodModule h_tor
      letI : Module R ↑A := Module.compHom ↑A downRingHom
      ModuleCat.of R ↑A

  let liftModSheaf : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (𝒜 : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (V : (W.Etale)ᵒᵖ) (x : ↑(𝒜.val.obj V)), m • x = 0) →
      CategoryTheory.Sheaf W.smallEtaleTopology (ModuleCat.{u, u} R) :=
    fun W 𝒜 h_tor =>
      let P_mod : CategoryTheory.Functor (W.Etale)ᵒᵖ (ModuleCat.{u, u} R) :=
        { obj := fun V => liftModObj (𝒜.val.obj V) (h_tor V)
          map := fun {V₁ V₂} f =>
            liftModHom
              (CategoryTheory.CategoryStruct.comp (isoOf (𝒜.val.obj V₁)).hom
                (CategoryTheory.CategoryStruct.comp (𝒜.val.map f)
                  (isoOf (𝒜.val.obj V₂)).inv))
          map_id := fun V => by
            apply hF_fg_faith
            rw [h_liftModHom, 𝒜.val.map_id, CategoryTheory.Category.id_comp,
              (isoOf (𝒜.val.obj V)).hom_inv_id]
            exact (F_fg.map_id (liftModObj (𝒜.val.obj V) (h_tor V))).symm
          map_comp := fun {V₁ V₂ V₃} f g => by
            apply hF_fg_faith
            rw [h_liftModHom, F_fg.map_comp, h_liftModHom, h_liftModHom, 𝒜.val.map_comp]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc] }
      have h_sheaf : CategoryTheory.Presheaf.IsSheaf W.smallEtaleTopology P_mod := by
        intro X
        let e_coy : (𝒜.val.comp (CategoryTheory.coyoneda.obj (Opposite.op (F_fg.obj X)))) ≅
            (P_mod.comp (CategoryTheory.coyoneda.obj (Opposite.op X))) :=
          CategoryTheory.NatIso.ofComponents
            (fun V =>
              (Equiv.toIso
                { toFun := fun u =>
                    liftModHom (CategoryTheory.CategoryStruct.comp u (isoOf (𝒜.val.obj V)).inv)
                  invFun := fun v =>
                    CategoryTheory.CategoryStruct.comp (F_fg.map v) (isoOf (𝒜.val.obj V)).hom
                  left_inv := fun u => by
                    dsimp only
                    rw [h_liftModHom, CategoryTheory.Category.assoc,
                      CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
                  right_inv := fun v => by
                    dsimp only
                    apply hF_fg_faith
                    rw [h_liftModHom, CategoryTheory.Category.assoc,
                      CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id] }))
            (fun {V₁ V₂} f => by
              ext u
              apply hF_fg_faith
              let u' : Quiver.Hom (F_fg.obj X) (𝒜.val.obj V₁) := u
              change F_fg.map
                  (@liftModHom X (P_mod.obj V₂)
                    (CategoryTheory.CategoryStruct.comp
                      (CategoryTheory.CategoryStruct.comp u' (𝒜.val.map f))
                      (isoOf (𝒜.val.obj V₂)).inv)) =
                F_fg.map
                  (CategoryTheory.CategoryStruct.comp
                    (@liftModHom X (P_mod.obj V₁)
                      (CategoryTheory.CategoryStruct.comp u' (isoOf (𝒜.val.obj V₁)).inv))
                    (P_mod.map f))
              dsimp only [P_mod]
              rw [h_liftModHom, F_fg.map_comp, h_liftModHom, h_liftModHom]
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc])
        exact CategoryTheory.Presieve.isSheaf_iso W.smallEtaleTopology e_coy (𝒜.cond (F_fg.obj X))
      ⟨P_mod, h_sheaf⟩

  let isoLiftModSheaf : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (𝒜 : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
      (h_tor : ∀ (V : (W.Etale)ᵒᵖ) (x : ↑(𝒜.val.obj V)), m • x = 0),
      (U_of W).obj (liftModSheaf W 𝒜 h_tor) ≅ 𝒜 :=
    fun W 𝒜 h_tor =>
      { hom := ⟨{ app := fun V => (isoOf (𝒜.val.obj V)).hom
                  naturality := fun {V₁ V₂} f => by
                    change CategoryTheory.CategoryStruct.comp
                        (F_fg.map ((liftModSheaf W 𝒜 h_tor).val.map f))
                        (isoOf (𝒜.val.obj V₂)).hom =
                      CategoryTheory.CategoryStruct.comp (isoOf (𝒜.val.obj V₁)).hom (𝒜.val.map f)
                    dsimp [liftModSheaf]
                    rw [h_liftModHom]
                    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
                      CategoryTheory.Category.comp_id] }⟩
        inv := ⟨{ app := fun V => (isoOf (𝒜.val.obj V)).inv
                  naturality := fun {V₁ V₂} f => by
                    change CategoryTheory.CategoryStruct.comp (𝒜.val.map f)
                        (isoOf (𝒜.val.obj V₂)).inv =
                      CategoryTheory.CategoryStruct.comp (isoOf (𝒜.val.obj V₁)).inv
                        (F_fg.map ((liftModSheaf W 𝒜 h_tor).val.map f))
                    dsimp [liftModSheaf]
                    rw [h_liftModHom]
                    simp only [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
                      CategoryTheory.Category.id_comp] }⟩
        hom_inv_id := by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V
          exact (isoOf (𝒜.val.obj V)).hom_inv_id
        inv_hom_id := by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V
          exact (isoOf (𝒜.val.obj V)).inv_hom_id }

  have hm_R_zero : (m : R) = 0 := by
    apply ULift.ext
    exact ZMod.natCast_self m

  have hm_sheaf_nsmul_app : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      {𝒜₁ 𝒜₂ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}}
      (k : ℕ) (φ : Quiver.Hom 𝒜₁ 𝒜₂) (V : (W.Etale)ᵒᵖ) (x : ↑(𝒜₁.val.obj V)),
      ((k • φ).hom.app V).hom x = k • ((φ.hom.app V).hom x) := by
    intro W 𝒜₁ 𝒜₂ k φ V x
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ k' ih =>
      rw [succ_nsmul, succ_nsmul]
      change ((k' • φ).hom.app V).hom x + (φ.hom.app V).hom x = _
      rw [ih]

  
  have hStdCmp : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (θ_Wp : weilEtaleModuleH W m p →+ weilEtaleTorsionH W m p),
      WeilIsModuleToTorsionComparison W m p θ_Wp →
      let J_W := W.smallEtaleTopology
      let U_W := U_of W
      let hEx := hU_exact_ff W
      letI := hEx.1; letI := hEx.2.1; letI := hEx.2.2.1
      let T₀ := weilCupPDTraceTerminalObj W
      let hT₀ := hT_of W
      let adj_ab_0 := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT₀
      let adj_mod_0 := CategoryTheory.constantSheafAdj J_W (ModuleCat.{u, u} R) hT₀
      let One_W := weilEtaleModuleUnit W m
      let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
      let FM_W := weilEtaleTorsionSheaf W m
      let ηℤ_W : Quiver.Hom Fℤ_W (U_W.obj One_W) :=
        (adj_ab_0.homEquiv Aℤ (U_W.obj One_W)).symm
          (CategoryTheory.CategoryStruct.comp ιℤ_cmp (F_fg.map (adj_mod_0.unit.app R_mod)))
      let αM_W : Quiver.Hom FM_W (U_W.obj One_W) :=
        (adj_ab_0.homEquiv AM (U_W.obj One_W)).symm
          (CategoryTheory.CategoryStruct.comp ιM (F_fg.map (adj_mod_0.unit.app R_mod)))
      ∃ (βM_W : Quiver.Hom (U_W.obj One_W) FM_W),
        CategoryTheory.CategoryStruct.comp αM_W βM_W = CategoryTheory.CategoryStruct.id FM_W ∧
        CategoryTheory.CategoryStruct.comp βM_W αM_W =
          CategoryTheory.CategoryStruct.id (U_W.obj One_W) ∧
        ∀ x : weilEtaleModuleH W m p,
          θ_Wp x = (CategoryTheory.Abelian.Ext.mk₀ βM_W).postcomp Fℤ_W (Nat.add_zero p)
            ((CategoryTheory.Abelian.Ext.mk₀ ηℤ_W).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U_W _ _ _ _ _ One_W One_W p) x)
              (Nat.zero_add p)) := by
    intro W θ_Wp hθ_Wp
    let J_W := W.smallEtaleTopology
    let U_W := U_of W
    let hEx := hU_exact_ff W
    let hAddU := hEx.1; let hLimU := hEx.2.1; let hColimU := hEx.2.2.1
    obtain ⟨hFullU⟩ := hEx.2.2.2.1; have hFaithU := hEx.2.2.2.2
    letI := hAddU; letI := hLimU; letI := hColimU; letI := hFullU; letI := hFaithU
    let T₀ := weilCupPDTraceTerminalObj W
    let hT₀ : CategoryTheory.Limits.IsTerminal T₀ := hT_of W
    let adj_ab_0 := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT₀
    let adj_mod_0 := CategoryTheory.constantSheafAdj J_W (ModuleCat.{u, u} R) hT₀
    let One_W := weilEtaleModuleUnit W m
    let C_ab_W := CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}
    let Fℤ_W := C_ab_W.obj Aℤ
    let FM_W := weilEtaleTorsionSheaf W m
    have hm_AM : m • CategoryTheory.CategoryStruct.id AM = 0 := by
      apply AddCommGrpCat.hom_ext
      ext ⟨x⟩
      have hx : m • x = 0 := by
        rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
      let ux : ↑AM := ULift.up.{u, 0} x
      have h_app : ∀ k : ℕ, ((k • CategoryTheory.CategoryStruct.id AM).hom) ux =
          ULift.up.{u, 0} (k • x) := by
        intro k
        induction k with
        | zero => simp; rfl
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul]
          change ((n • CategoryTheory.CategoryStruct.id AM).hom) ux + ux = _
          rw [ih]
          rfl
      change ((m • CategoryTheory.CategoryStruct.id AM).hom) ux = 0
      rw [h_app m, hx]
      rfl
    have hm_FM : ∀ (V : (W.Etale)ᵒᵖ) (x : ↑(FM_W.val.obj V)), m • x = 0 := by
      intro V x
      have hid : ((CategoryTheory.CategoryStruct.id FM_W).hom.app V).hom x = x := rfl
      rw [← hid, ← hm_sheaf_nsmul_app m (CategoryTheory.CategoryStruct.id FM_W) V x]
      have h0 : m • CategoryTheory.CategoryStruct.id FM_W = 0 := by
        dsimp [FM_W, weilEtaleTorsionSheaf]
        have hns : ∀ k : ℕ, C_ab_W.map (k • CategoryTheory.CategoryStruct.id AM) =
            k • C_ab_W.map (CategoryTheory.CategoryStruct.id AM) := by
          intro k
          induction k with
          | zero => rw [zero_nsmul, zero_nsmul, C_ab_W.map_zero]
          | succ k' ih => rw [succ_nsmul, succ_nsmul, C_ab_W.map_add, ih]
        rw [← C_ab_W.map_id, ← hns m, hm_AM, C_ab_W.map_zero]
      rw [h0]
      rfl
    let FM_mod := liftModSheaf W FM_W hm_FM
    let e_FM : U_W.obj FM_mod ≅ FM_W := isoLiftModSheaf W FM_W hm_FM
    let ιM_inv : Quiver.Hom (F_fg.obj R_mod) AM := AddCommGrpCat.ofHom (AddMonoidHom.id R)
    have hιM_id₁ : CategoryTheory.CategoryStruct.comp ιM ιM_inv =
        CategoryTheory.CategoryStruct.id AM :=
      AddCommGrpCat.hom_ext (AddMonoidHom.ext fun _ => rfl)
    have hιM_id₂ : CategoryTheory.CategoryStruct.comp ιM_inv ιM =
        CategoryTheory.CategoryStruct.id (F_fg.obj R_mod) :=
      AddCommGrpCat.hom_ext (AddMonoidHom.ext fun _ => rfl)
    let g_mod : Quiver.Hom R_mod (FM_mod.val.obj (Opposite.op T₀)) :=
      liftModHom
        (CategoryTheory.CategoryStruct.comp ιM_inv
          (CategoryTheory.CategoryStruct.comp (adj_ab_0.unit.app AM)
            (e_FM.inv.hom.app (Opposite.op T₀))))
    let β_tilde : Quiver.Hom One_W FM_mod := (adj_mod_0.homEquiv R_mod FM_mod).symm g_mod
    let βM_W : Quiver.Hom (U_W.obj One_W) FM_W :=
      CategoryTheory.CategoryStruct.comp (U_W.map β_tilde) e_FM.hom
    let αM_W : Quiver.Hom FM_W (U_W.obj One_W) :=
      (adj_ab_0.homEquiv AM (U_W.obj One_W)).symm
        (CategoryTheory.CategoryStruct.comp ιM (F_fg.map (adj_mod_0.unit.app R_mod)))
    have hαβ : CategoryTheory.CategoryStruct.comp αM_W βM_W =
        CategoryTheory.CategoryStruct.id FM_W := by
      apply (adj_ab_0.homEquiv AM FM_W).injective
      have h_id_ab : (adj_ab_0.homEquiv AM FM_W) (CategoryTheory.CategoryStruct.id FM_W) =
          adj_ab_0.unit.app AM :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_ab_0 AM FM_W
          (CategoryTheory.CategoryStruct.id FM_W)).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (adj_ab_0.unit.app AM))
            (((CategoryTheory.sheafSections J_W AddCommGrpCat.{u}).obj
              (Opposite.op T₀)).map_id FM_W)).trans
            (CategoryTheory.Category.comp_id (adj_ab_0.unit.app AM)))
      have hβ_unit : CategoryTheory.CategoryStruct.comp
          (adj_mod_0.unit.app R_mod) (β_tilde.hom.app (Opposite.op T₀)) = g_mod :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_mod_0 R_mod FM_mod β_tilde).symm.trans
          (Equiv.apply_symm_apply (adj_mod_0.homEquiv R_mod FM_mod) g_mod)
      have he_inv_hom : CategoryTheory.CategoryStruct.comp
          (e_FM.inv.hom.app (Opposite.op T₀)) (e_FM.hom.hom.app (Opposite.op T₀)) =
          CategoryTheory.CategoryStruct.id (FM_W.obj.obj (Opposite.op T₀)) :=
        CategoryTheory.NatTrans.congr_app
          (congrArg (fun k : Quiver.Hom FM_W FM_W => k.hom) e_FM.inv_hom_id)
          (Opposite.op T₀)
      let u0 := F_fg.map (adj_mod_0.unit.app R_mod)
      let b0 := F_fg.map (β_tilde.hom.app (Opposite.op T₀))
      let e_h := e_FM.hom.hom.app (Opposite.op T₀)
      let e_i := e_FM.inv.hom.app (Opposite.op T₀)
      let u_ab := adj_ab_0.unit.app AM
      have hg_fg : CategoryTheory.CategoryStruct.comp u0 b0 =
          CategoryTheory.CategoryStruct.comp ιM_inv
            (CategoryTheory.CategoryStruct.comp u_ab e_i) :=
        (F_fg.map_comp (adj_mod_0.unit.app R_mod)
          (β_tilde.hom.app (Opposite.op T₀))).symm.trans
          ((congrArg F_fg.map hβ_unit).trans
            (@h_liftModHom R_mod (FM_mod.val.obj (Opposite.op T₀)) _))
      exact ((CategoryTheory.Adjunction.homEquiv_naturality_right adj_ab_0 αM_W βM_W).trans
        (congrArg (fun z => CategoryTheory.CategoryStruct.comp z
          (CategoryTheory.CategoryStruct.comp b0 e_h))
          (Equiv.apply_symm_apply (adj_ab_0.homEquiv AM (U_W.obj One_W)) _))).trans
        (((CategoryTheory.Category.assoc ιM u0
          (CategoryTheory.CategoryStruct.comp b0 e_h)).trans
          (congrArg (CategoryTheory.CategoryStruct.comp ιM)
            ((CategoryTheory.Category.assoc u0 b0 e_h).symm.trans
              ((congrArg (fun z => CategoryTheory.CategoryStruct.comp z e_h) hg_fg).trans
                ((CategoryTheory.Category.assoc ιM_inv
                  (CategoryTheory.CategoryStruct.comp u_ab e_i) e_h).trans
                  (congrArg (CategoryTheory.CategoryStruct.comp ιM_inv)
                    ((CategoryTheory.Category.assoc u_ab e_i e_h).trans
                      ((congrArg (CategoryTheory.CategoryStruct.comp u_ab) he_inv_hom).trans
                        (CategoryTheory.Category.comp_id u_ab))))))))) |>.trans
          ((CategoryTheory.Category.assoc ιM ιM_inv u_ab).symm.trans
            ((congrArg (fun z => CategoryTheory.CategoryStruct.comp z u_ab) hιM_id₁).trans
              ((CategoryTheory.Category.id_comp u_ab).trans h_id_ab.symm))))
    have hβα : CategoryTheory.CategoryStruct.comp βM_W αM_W =
        CategoryTheory.CategoryStruct.id (U_W.obj One_W) := by
      obtain ⟨α_tilde, hα_tilde⟩ := hFullU.map_surjective
        (CategoryTheory.CategoryStruct.comp e_FM.hom αM_W)
      have hcomp_eq : CategoryTheory.CategoryStruct.comp βM_W αM_W =
          U_W.map (CategoryTheory.CategoryStruct.comp β_tilde α_tilde) := by
        dsimp only [βM_W, U_W]
        rw [CategoryTheory.Category.assoc, ← hα_tilde, ← (U_of W).map_comp]
      rw [hcomp_eq, ← U_W.map_id]
      congr 1
      apply (adj_mod_0.homEquiv R_mod One_W).injective
      apply hF_fg_faith
      have h_id_mod : (adj_mod_0.homEquiv R_mod One_W) (CategoryTheory.CategoryStruct.id One_W) =
          adj_mod_0.unit.app R_mod :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_mod_0 R_mod One_W
          (CategoryTheory.CategoryStruct.id One_W)).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (adj_mod_0.unit.app R_mod))
            (((CategoryTheory.sheafSections J_W (ModuleCat.{u, u} R)).obj
              (Opposite.op T₀)).map_id One_W)).trans
            (CategoryTheory.Category.comp_id _))
      have h_lhs1 : F_fg.map ((adj_mod_0.homEquiv R_mod One_W)
          (CategoryTheory.CategoryStruct.comp β_tilde α_tilde)) =
          CategoryTheory.CategoryStruct.comp (F_fg.map g_mod)
            (F_fg.map (α_tilde.hom.app (Opposite.op T₀))) :=
        (congrArg F_fg.map
          ((CategoryTheory.Adjunction.homEquiv_naturality_right adj_mod_0 β_tilde α_tilde).trans
            (congrArg (fun z => CategoryTheory.CategoryStruct.comp z
              (α_tilde.hom.app (Opposite.op T₀)))
              (Equiv.apply_symm_apply (adj_mod_0.homEquiv R_mod FM_mod) g_mod)))).trans
          (F_fg.map_comp g_mod (α_tilde.hom.app (Opposite.op T₀)))
      have hg_fg : F_fg.map g_mod =
          CategoryTheory.CategoryStruct.comp ιM_inv
            (CategoryTheory.CategoryStruct.comp (adj_ab_0.unit.app AM)
              (e_FM.inv.hom.app (Opposite.op T₀))) :=
        @h_liftModHom R_mod (FM_mod.val.obj (Opposite.op T₀)) _
      have hα_app : F_fg.map (α_tilde.hom.app (Opposite.op T₀)) =
          CategoryTheory.CategoryStruct.comp (e_FM.hom.hom.app (Opposite.op T₀))
            (αM_W.hom.app (Opposite.op T₀)) :=
        CategoryTheory.NatTrans.congr_app
          (congrArg (fun k : Quiver.Hom ((U_of W).obj FM_mod) ((U_of W).obj One_W) => k.hom) hα_tilde)
          (Opposite.op T₀)
      have he_inv_hom : CategoryTheory.CategoryStruct.comp
          (e_FM.inv.hom.app (Opposite.op T₀)) (e_FM.hom.hom.app (Opposite.op T₀)) =
          CategoryTheory.CategoryStruct.id _ :=
        CategoryTheory.NatTrans.congr_app
          (congrArg (fun k : Quiver.Hom FM_W FM_W => k.hom) e_FM.inv_hom_id)
          (Opposite.op T₀)
      have hαM_unit : CategoryTheory.CategoryStruct.comp
          (adj_ab_0.unit.app AM) (αM_W.hom.app (Opposite.op T₀)) =
          CategoryTheory.CategoryStruct.comp ιM (F_fg.map (adj_mod_0.unit.app R_mod)) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_ab_0 AM (U_W.obj One_W) αM_W).symm.trans
          (Equiv.apply_symm_apply (adj_ab_0.homEquiv AM (U_W.obj One_W)) _)
      let u_ab := adj_ab_0.unit.app AM
      let e_i := e_FM.inv.hom.app (Opposite.op T₀)
      let e_h := e_FM.hom.hom.app (Opposite.op T₀)
      let α0 := αM_W.hom.app (Opposite.op T₀)
      let u0 := F_fg.map (adj_mod_0.unit.app R_mod)
      exact h_lhs1.trans
        (((congrArg₂ CategoryTheory.CategoryStruct.comp hg_fg hα_app).trans
          ((CategoryTheory.Category.assoc ιM_inv
            (CategoryTheory.CategoryStruct.comp u_ab e_i)
            (CategoryTheory.CategoryStruct.comp e_h α0)).trans
            (congrArg (CategoryTheory.CategoryStruct.comp ιM_inv)
              ((CategoryTheory.Category.assoc u_ab e_i
                (CategoryTheory.CategoryStruct.comp e_h α0)).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp u_ab)
                  ((CategoryTheory.Category.assoc e_i e_h α0).symm.trans
                    ((congrArg (fun z => CategoryTheory.CategoryStruct.comp z α0) he_inv_hom).trans
                      (CategoryTheory.Category.id_comp α0)))).trans
                  hαM_unit))))).trans
          ((CategoryTheory.Category.assoc ιM_inv ιM u0).symm.trans
            ((congrArg (fun z => CategoryTheory.CategoryStruct.comp z u0) hιM_id₂).trans
              ((CategoryTheory.Category.id_comp u0).trans
                (congrArg F_fg.map h_id_mod).symm))))
    let ηℤ_W : Quiver.Hom Fℤ_W (U_W.obj One_W) :=
      (adj_ab_0.homEquiv Aℤ (U_W.obj One_W)).symm
        (CategoryTheory.CategoryStruct.comp ιℤ_cmp (F_fg.map (adj_mod_0.unit.app R_mod)))
    let θ_std : weilEtaleModuleH W m p →+ weilEtaleTorsionH W m p :=
      ((CategoryTheory.Abelian.Ext.mk₀ βM_W).postcomp Fℤ_W (Nat.add_zero p)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ηℤ_W).precomp (U_W.obj One_W) (Nat.zero_add p)).comp
          (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U_W _ _ _ _ _ One_W One_W p))
    have h_std_cmp : WeilIsModuleToTorsionComparison W m p θ_std :=
      ⟨U_W, fun _ => rfl, fun _ _ => HEq.rfl, hAddU, hLimU, hColimU,
        T₀, hT₀, rfl, HEq.rfl, F_fg.map (adj_mod_0.unit.app R_mod), HEq.rfl,
        βM_W, hαβ, hβα, fun _ => rfl⟩
    have h_eq : θ_Wp = θ_std := (hModCmp W p).2 θ_Wp θ_std hθ_Wp h_std_cmp
    dsimp only
    exact ⟨βM_W, hαβ, hβα, fun x => congrFun (congrArg DFunLike.coe h_eq) x⟩

  
  rcases hp_i with ⟨hCont_ab, P_pull_ab, adj_ab, hAdd_ab, hLim_ab, hColim_ab,
    T_Z₁, hT_Z₁, T_Y₁, hT_Y₁, ιℤ_pb, hιπ_pb, _, hp_i_eq⟩
  have hCont_eq : hCont_ab = τ_Y.hCont := Subsingleton.elim _ _
  subst hCont_eq
  letI := hAdd_ab; letI := hLim_ab; letI := hColim_ab

  let U_Y := U_of Y
  let U_Z := U_of Z
  let hEx_Y := hU_exact_ff Y
  let hEx_Z := hU_exact_ff Z
  let hAdd_UY := hEx_Y.1; let hLim_UY := hEx_Y.2.1; let hColim_UY := hEx_Y.2.2.1
  obtain ⟨hFull_UY⟩ := hEx_Y.2.2.2.1; have hFaith_UY := hEx_Y.2.2.2.2
  let hAdd_UZ := hEx_Z.1; let hLim_UZ := hEx_Z.2.1; let hColim_UZ := hEx_Z.2.2.1
  obtain ⟨hFull_UZ⟩ := hEx_Z.2.2.2.1; have hFaith_UZ := hEx_Z.2.2.2.2
  letI := hAdd_UY; letI := hLim_UY; letI := hColim_UY; letI := hFull_UY; letI := hFaith_UY
  letI := hAdd_UZ; letI := hLim_UZ; letI := hColim_UZ; letI := hFull_UZ; letI := hFaith_UZ
  let i_push_ab := B_i.sheafPushforwardContinuous AddCommGrpCat.{u}
    Y.smallEtaleTopology Z.smallEtaleTopology

  have hm_UY_tor : ∀ (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)),
      m • CategoryTheory.CategoryStruct.id (U_Y.obj ℱ) = 0 := by
    intro ℱ
    apply CategoryTheory.Sheaf.hom_ext
    ext V x
    rw [hm_sheaf_nsmul_app m (CategoryTheory.CategoryStruct.id (U_Y.obj ℱ)) V x]
    let x' : ↑(ℱ.val.obj V) := x
    change m • x' = 0
    have hsm : m • x' = (m : R) • x' := (Nat.cast_smul_eq_nsmul R m x').symm
    rw [hsm, hm_R_zero, zero_smul]

  have hm_pull_tor : ∀ (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
      (V : (Z.Etale)ᵒᵖ) (x : ↑((P_pull_ab.obj (U_Y.obj ℱ)).val.obj V)),
      m • x = 0 := by
    intro ℱ V x
    have hid : ((CategoryTheory.CategoryStruct.id (P_pull_ab.obj (U_Y.obj ℱ))).hom.app V).hom x = x :=
      rfl
    rw [← hid, ← hm_sheaf_nsmul_app m
      (CategoryTheory.CategoryStruct.id (P_pull_ab.obj (U_Y.obj ℱ))) V x]
    have h0 : m • CategoryTheory.CategoryStruct.id (P_pull_ab.obj (U_Y.obj ℱ)) = 0 := by
      have hns : ∀ k : ℕ, P_pull_ab.map (k • CategoryTheory.CategoryStruct.id (U_Y.obj ℱ)) =
          k • P_pull_ab.map (CategoryTheory.CategoryStruct.id (U_Y.obj ℱ)) := by
        intro k
        induction k with
        | zero => rw [zero_nsmul, zero_nsmul, P_pull_ab.map_zero]
        | succ k' ih => rw [succ_nsmul, succ_nsmul, P_pull_ab.map_add, ih]
      rw [← P_pull_ab.map_id, ← hns m, hm_UY_tor ℱ, P_pull_ab.map_zero]
    rw [h0]
    rfl

  let ff_Y := CategoryTheory.Functor.FullyFaithful.ofFullyFaithful U_Y
  let ff_Z := CategoryTheory.Functor.FullyFaithful.ofFullyFaithful U_Z
  let uEqv_Y : ∀ (ℱ₁ ℱ₂ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)),
