      (weilEtaleGmPresheaf P1.left)
    let s_tilde : ↥((pf.obj Gm_C).obj.obj (Opposite.op U_V12)) :=
      (η_C.app (Opposite.op B_V12)).hom
        (Additive.ofMul (Units.map (B_V12.hom.appLE (W₁ ⊓ W_x) ⊤ h_le).hom.toMonoidHom u_f))
    let α : (pf.obj Gm_C).H 1 := d_MV P1.left V₁ V₂ hcov_V (pf.obj Gm_C) s_tilde
    obtain ⟨β, hβ_up, hβ_down⟩ :=
      hAbKummerLadder adj ιℤ hSE_kum_C hSE_kum_P1 hEpiCok Tr N_gm N_gm hKum.1 hKum.2 α

    
    let U_W12 : C.left.Etale := weilGysinEtaleObj (W₁ ⊓ W₂).ι inferInstance
    let U_Wx12 : C.left.Etale := weilGysinEtaleObj (W₁ ⊓ W_x).ι inferInstance
    let θ₁₂_left : (W₁ ⊓ W₂).toScheme ⟶ B_V12.left :=
      Limits.pullback.lift (π_tilde ∣_ (V₁ ⊓ V₂)) (W₁ ⊓ W₂).ι
        (AlgebraicGeometry.morphismRestrict_ι π_tilde (V₁ ⊓ V₂))
    let θ₁₂ : Quiver.Hom U_W12 B_V12 :=
      CategoryTheory.MorphismProperty.Over.homMk θ₁₂_left
        (Limits.pullback.lift_snd _ _ _) trivial
    let r₁₂ : Quiver.Hom U_W12 U_Wx12 :=
      CategoryTheory.MorphismProperty.Over.homMk
        (C.left.homOfLE (inf_le_inf (le_rfl : W₁ ≤ W₁) hW₂_le_Wx))
        (AlgebraicGeometry.Scheme.homOfLE_ι C.left (inf_le_inf (le_rfl : W₁ ≤ W₁) hW₂_le_Wx))
        trivial
    let u_C_sh : ↥(Gm_C.obj.obj (Opposite.op U_Wx12)) :=
      (η_C.app (Opposite.op U_Wx12)).hom
        (Additive.ofMul (Units.map (W₁ ⊓ W_x).topIso.inv.hom.toMonoidHom u_f))
    have hSec_eq : (Gm_C.obj.map (Opposite.op θ₁₂)).hom s_tilde =
        (Gm_C.obj.map (Opposite.op r₁₂)).hom u_C_sh := by
      let b_hom : B_V12.left ⟶ C.left := B_V12.hom
      let r_hom : (W₁ ⊓ W₂).toScheme ⟶ (W₁ ⊓ W_x).toScheme :=
        C.left.homOfLE (inf_le_inf le_rfl hW₂_le_Wx)
      have htop_inv : (W₁ ⊓ W_x).topIso.inv =
          (W₁ ⊓ W_x).ι.appLE (W₁ ⊓ W_x) ⊤ (fun z _ => z.2) :=
        (AlgebraicGeometry.Scheme.Opens.topIso_inv (W₁ ⊓ W_x)).trans
          ((congrArg C.left.presheaf.map (Subsingleton.elim _ _)).trans
            (C.left.presheaf.map_comp _ _))
      have hRingEq : b_hom.appLE (W₁ ⊓ W_x) ⊤ h_le ≫ θ₁₂_left.appTop =
          (W₁ ⊓ W_x).topIso.inv ≫ r_hom.appTop := by
        have hL :=
          (congrArg (b_hom.appLE (W₁ ⊓ W_x) ⊤ h_le ≫ ·)
            (AlgebraicGeometry.Scheme.Hom.app_eq_appLE θ₁₂_left)).trans
            (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE θ₁₂_left b_hom
              (W₁ ⊓ W_x) ⊤ ⊤ h_le le_rfl)
        have hR :=
          (congrArg₂ CategoryStruct.comp htop_inv
            (AlgebraicGeometry.Scheme.Hom.app_eq_appLE r_hom)).trans
            (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE r_hom (W₁ ⊓ W_x).ι
              (W₁ ⊓ W_x) ⊤ ⊤ (fun z _ => z.2) le_rfl)
        refine hL.trans (Eq.trans ?_ hR.symm)
        apply happLE_congr
        calc
          θ₁₂_left ≫ b_hom = (W₁ ⊓ W₂).ι := Limits.pullback.lift_snd _ _ _
          _ = r_hom ≫ (W₁ ⊓ W_x).ι := (AlgebraicGeometry.Scheme.homOfLE_ι C.left _).symm
      have hValEq : θ₁₂_left.appTop.hom ((b_hom.appLE (W₁ ⊓ W_x) ⊤ h_le).hom (u_f : _)) =
          r_hom.appTop.hom ((W₁ ⊓ W_x).topIso.inv.hom (u_f : _)) :=
        congrArg
          (fun f : C.left.presheaf.obj (Opposite.op (W₁ ⊓ W_x)) ⟶
              (W₁ ⊓ W₂).toScheme.presheaf.obj (Opposite.op ⊤) =>
            f.hom (u_f : _))
          hRingEq
      have hUnitsEq :
          Additive.ofMul (Units.map θ₁₂_left.appTop.hom.toMonoidHom
            (Units.map (B_V12.hom.appLE (W₁ ⊓ W_x) ⊤ h_le).hom.toMonoidHom u_f)) =
          Additive.ofMul (Units.map r_hom.appTop.hom.toMonoidHom
            (Units.map (W₁ ⊓ W_x).topIso.inv.hom.toMonoidHom u_f)) :=
        congrArg Additive.ofMul (Units.ext hValEq)
      have hnat₁ := congrArg (fun f => f.hom
          (Additive.ofMul (Units.map (B_V12.hom.appLE (W₁ ⊓ W_x) ⊤ h_le).hom.toMonoidHom u_f)))
        (η_C.naturality (Opposite.op θ₁₂))
      have hnat₂ := congrArg (fun f => f.hom
          (Additive.ofMul (Units.map (W₁ ⊓ W_x).topIso.inv.hom.toMonoidHom u_f)))
        (η_C.naturality (Opposite.op r₁₂))
      exact hnat₁.symm.trans ((congrArg (η_C.app (Opposite.op U_W12)).hom hUnitsEq).trans hnat₂)
    obtain ⟨s₁_C, fq_C, hs₁_C, hfq_C_1, hfq_C_2, hdiv_C⟩ :=
      hUnif_div_C P.1 P.2 W₁ hq_mem f_sec u_f hf_res hf_span
    have hMV_up :
        (Abelian.Ext.mk₀ (adj.counit.app Gm_C)).postcomp Fℤ_C (Nat.add_zero 1)
          ((Abelian.Ext.mk₀ ιℤ).comp
            ((@Functor.mapExtAddHom _ _ _ _ _ _ pb hAdd hLim hColim _ _
              Fℤ_P1 (pf.obj Gm_C) 1) α)
            (Nat.zero_add 1)) =
        (Abelian.Ext.mk₀ fq_C).comp hSE_div_C.extClass (Nat.zero_add 1) := by
      rw [hMV_pb π_tilde V₁ V₂ hcov_V hCont pb adj hAdd hLim hColim ιℤ hAdj.1 hAdj.2.1
        hcov_W Gm_C s_tilde θ₁₂]
      rw [hSec_eq]
      rw [← hMV_ref C.left W₁ W_x W₁ W₂ hcov_Wx hcov_W le_rfl hW₂_le_Wx Gm_C u_C_sh]
      exact hMV_ext C.left W₁ W_x hcov_Wx ι_gm_C π_div_C h0_div_C hSE_div_C
        u_C_sh s₁_C fq_C hs₁_C hfq_C_1 hfq_C_2
    have hleray_β : leray β = ψ_C (Abelian.Ext.mk₀ fq_C) := by
      rw [hAdj.2.2 β, hβ_up, hMV_up]
      rfl

    
    let u_P1_sh : ↥(Gm_P1.obj.obj (Opposite.op U_V12)) :=
      (η_P1.app (Opposite.op U_V12)).hom
        (Additive.ofMul (Units.map (V₁ ⊓ V₂).topIso.inv.hom.toMonoidHom u_g))
    obtain ⟨s₁_P1, fq_P1, hs₁_P1, hfq_P1_1, hfq_P1_2, hdiv_P1⟩ :=
      hUnif_div_P1 q hq V₁ hq_mem g_sec u_g hg_res hg_span
    have hMV_down :
        α.comp (Abelian.Ext.mk₀ N_gm) (Nat.add_zero 1) =
          (Abelian.Ext.mk₀ fq_P1).comp hSE_div_P1.extClass (Nat.zero_add 1) := by
      dsimp only [α]
      rw [hMV_nat P1.left V₁ V₂ hcov_V N_gm s_tilde, hNorm h_le]
      exact hMV_ext P1.left V₁ V₂ hcov_V ι_gm_P1 π_div_P1 h0_div_P1 hSE_div_P1
        u_P1_sh s₁_P1 fq_P1 hs₁_P1 hfq_P1_1 hfq_P1_2
    obtain ⟨k₀, hk₀⟩ := hPrin_div_P1 _ (hP1_diff ⟨q, hq⟩)
    have hfq_diff : Abelian.Ext.mk₀ fq_P1 =
        k₀.comp (Abelian.Ext.mk₀ π_div_P1) (Nat.add_zero 0) + Abelian.Ext.mk₀ fq_inf := by
      apply hInj_div_P1
      rw [map_add, hk₀, hdiv_P1, hdiv_inf, sub_add_cancel]
    have hdiv_ext_eq :
        (Abelian.Ext.mk₀ fq_P1).comp hSE_div_P1.extClass (Nat.zero_add 1) =
          (Abelian.Ext.mk₀ fq_inf).comp hSE_div_P1.extClass (Nat.zero_add 1) := by
      rw [hfq_diff, Abelian.Ext.add_comp,
        Abelian.Ext.comp_assoc k₀ (Abelian.Ext.mk₀ π_div_P1) hSE_div_P1.extClass
          (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
        ShortComplex.ShortExact.comp_extClass hSE_div_P1,
        Abelian.Ext.comp_zero, zero_add]
    have hTr_β : (Abelian.Ext.mk₀ Tr).postcomp Fℤ_P1 (Nat.add_zero 2) β = w_P1_inf := by
      rw [hβ_down, hMV_down, hdiv_ext_eq]
    refine ⟨Abelian.Ext.mk₀ fq_C, hdiv_C, ?_⟩
    have hsymm_β : (AddEquiv.ofBijective leray hBij).symm (ψ_C (Abelian.Ext.mk₀ fq_C)) = β := by
      apply (AddEquiv.ofBijective leray hBij).injective
      rw [AddEquiv.apply_symm_apply]
      exact hleray_β.symm
    rw [hsymm_β, hTr_β]

  choose q_pt₁ hq_pt₁_div hq_pt₁_eval using
    hPointEval π_tilde₁ hR1_₁ hCont₁ pb₁ adj₁ hAdd₁ hLim₁ hColim₁ ιℤ₁ leray₁ hBij₁
      hAdj₁ N_gm₁ Tr₁ hKum₁ hUnif₁
  choose q_pt₂ hq_pt₂_div hq_pt₂_eval using
    hPointEval π_tilde₂ hR1_₂ hCont₂ pb₂ adj₂ hAdd₂ hLim₂ hColim₂ ιℤ₂ leray₂ hBij₂
      hAdj₂ N_gm₂ Tr₂ hKum₂ hUnif₂

  have hq_pt_eq : ∀ P, q_pt₁ P = q_pt₂ P := fun P =>
    hInj_div_C ((hq_pt₁_div P).trans (hq_pt₂_div P).symm)
  have hΦ_pt : ∀ P, Φ₁ (ψ_C (q_pt₁ P)) = Φ₂ (ψ_C (q_pt₁ P)) := by
    intro P
    change ((Abelian.Ext.mk₀ Tr₁).postcomp Fℤ_P1 (Nat.add_zero 2))
        (e_leray₁.symm (ψ_C (q_pt₁ P))) =
      ((Abelian.Ext.mk₀ Tr₂).postcomp Fℤ_P1 (Nat.add_zero 2))
        (e_leray₂.symm (ψ_C (q_pt₁ P)))
    rw [hq_pt₁_eval P, hq_pt_eq P, hq_pt₂_eval P]

  
  have hw_gm0 : w.comp (Abelian.Ext.mk₀ ι_kum_C) (Nat.add_zero 2) = 0 :=
    hH2_Gm_C.elim _ 0
  obtain ⟨g_w, hg_w⟩ :=
    Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hSE_kum_C w hw_gm0 (Nat.one_add 1)
  have hgw_k0 : g_w.comp (Abelian.Ext.mk₀ ι_gm_C) (Nat.add_zero 1) = 0 :=
    hH1_K_C.elim _ 0
  obtain ⟨q_w, hq_w⟩ :=
    Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hSE_div_C g_w hgw_k0 (Nat.zero_add 1)
  have hw_eq_ψ : w = ψ_C q_w := by
    change w = (q_w.comp hSE_div_C.extClass (Nat.zero_add 1)).comp
      hSE_kum_C.extClass (Nat.one_add 1)
    rw [hq_w, hg_w]

  let D := div_H0_C q_w
  have hqw_sum : q_w = ∑ P ∈ D.support, D P • q_pt₁ P := by
    apply hInj_div_C
    rw [map_sum]
    have hsum_single : (∑ P ∈ D.support, div_H0_C (D P • q_pt₁ P)) =
        D.sum Finsupp.single := by
      change (∑ P ∈ D.support, div_H0_C (D P • q_pt₁ P)) =
        ∑ P ∈ D.support, Finsupp.single P (D P)
      apply Finset.sum_congr rfl
      intro P _
      rw [map_zsmul, hq_pt₁_div P]
      ext Q
      simp [Finsupp.single_apply]
    rw [hsum_single, Finsupp.sum_single]

  change Φ₁ w = Φ₂ w
  rw [hw_eq_ψ, hqw_sum, map_sum, map_sum, map_sum]
  apply Finset.sum_congr rfl
  intro P _
  rw [map_zsmul, map_zsmul, map_zsmul, hΦ_pt P]

theorem weil_gysin_curve_etale_counit_invariance (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hCD_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m n q : ℕ),
      1 ≤ n → IsUnit (n : Ω) →
      ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper Z.hom],
        topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
        2 * m < q →
        Subsingleton (weilEtaleTorsionH Z.left n q))
    (hPBC_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (ℓ : Ω) ≠ 0 → WeilProperModPrimeBaseChangeHolds Ω ℓ) :
    WeilGysinCurveEtaleCounitInvarianceHolds.{u} ℓ :=
by
  classical
  intro Ω _instFieldΩ _instAlgClosedΩ hℓΩ
    ι_P1 s_inf hInt_P1 hProp_P1 hSm_P1 hOpen_P1 hι_P1_hom hs_inf_hom hCompl_P1
    C_bar _instPropC C_open hAffC
    π₁ π₂ hπ₁_hom hπ₂_hom
    v₁ v₂ hv₁_et hv₂_et hv₁_hom hv₂_hom hπ₁_open hπ₂_open
    hv₁_P1 hv₂_P1 r z_C z₁ z₂ hz₁ hz₂
  let P1 := weilProjectiveSpaceOver Ω 1
  rcases Nat.eq_zero_or_pos r with rfl | hr_pos
  · have h_mod1_zero : ∀ x : weilEtaleTorsionH P1.left 1 2, x = 0 := by
      intro x
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod 1))
      have hAM_id : CategoryTheory.CategoryStruct.id AM = 0 := by
        ext ⟨a⟩
        exact ULift.ext _ _ (Subsingleton.elim a 0)
      let FM := weilEtaleTorsionSheaf P1.left 1
      have hFM_id : CategoryTheory.CategoryStruct.id FM = 0 := by
        rw [← (CategoryTheory.constantSheaf P1.left.smallEtaleTopology AddCommGrpCat.{u}).map_id AM,
          hAM_id, CategoryTheory.Functor.map_zero]
      let Fℤ := (CategoryTheory.constantSheaf P1.left.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      change (x : CategoryTheory.Abelian.Ext Fℤ FM 2) = 0
      calc
        x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM))
              (Nat.add_zero 2) :=
          (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : FM ⟶ FM)) (Nat.add_zero 2) := by
          rw [hFM_id]
        _ = 0 := by
          rw [CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero x FM 0 2 (Nat.add_zero 2)]
    exact (h_mod1_zero _).trans (h_mod1_zero _).symm
  · by_cases hEmpty : IsEmpty ↥C_open.toScheme
    · have h_empty_zero : ∀ (U : P1.left.Etale), IsEmpty ↥U.left →
          ∀ z : weilGysinLocalTorsionH P1.left (ℓ ^ r) U 2, z = 0 := by
        intro U hEmpU z
        have h_bot : (⊥ : CategoryTheory.Sieve U) ∈ P1.left.smallEtaleTopology U := by
          let _ : CategoryTheory.Category
              (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale) ⊤ P1.left) :=
            (inferInstance : CategoryTheory.Category P1.left.Etale)
          let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
              (@AlgebraicGeometry.Etale) :=
            ⟨fun _ _ hf hg => by
              have := hf
              have := hg
              infer_instance⟩
          have hJ :=
            AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
              (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) P1.left (le_refl _)
          have hmem := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) U
            (⊥ : CategoryTheory.Sieve U)).mpr (fun x => IsEmpty.elim hEmpU x)
          exact Eq.mp (congrArg (fun G => (⊥ : CategoryTheory.Sieve U) ∈ G U) hJ.symm) hmem
        let L_U := weilGysinLocalTorsionSheaf P1.left (ℓ ^ r) U
        let A_U := L_U.obj.obj (Opposite.op U)
        have hSF : CategoryTheory.Presieve.IsSheafFor
            (L_U.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op A_U))
            (⊥ : CategoryTheory.Presieve U) :=
          (L_U.property A_U).isSheafFor (⊥ : CategoryTheory.Presieve U) (by simpa using h_bot)
        have hAU_id : CategoryTheory.CategoryStruct.id A_U = 0 :=
          hSF.isSeparatedFor (fun _ _ hf => False.elim hf)
            (CategoryTheory.CategoryStruct.id A_U) (0 : A_U ⟶ A_U)
            (fun _ _ hf => False.elim hf) (fun _ _ hf => False.elim hf)
        have hHomZero : ∀ g : AddCommGrpCat.uliftFunctor.{u, 0}.obj
            (AddCommGrpCat.of (ZMod (ℓ ^ r))) ⟶ A_U, g = 0 := fun g => by
          calc
            g = CategoryTheory.CategoryStruct.comp g (CategoryTheory.CategoryStruct.id A_U) :=
              (CategoryTheory.Category.comp_id g).symm
            _ = CategoryTheory.CategoryStruct.comp g (0 : A_U ⟶ A_U) := by rw [hAU_id]
            _ = 0 := CategoryTheory.Limits.comp_zero
        have hLU_id : CategoryTheory.CategoryStruct.id L_U = 0 := by
          apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
          exact (hHomZero _).trans (hHomZero _).symm
        let Fℤ := (CategoryTheory.constantSheaf P1.left.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        change (z : CategoryTheory.Abelian.Ext Fℤ L_U 2) = 0
        calc
          z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id L_U))
                (Nat.add_zero 2) :=
            (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
          _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : L_U ⟶ L_U)) (Nat.add_zero 2) := by
            rw [hLU_id]
          _ = 0 := by
            rw [CategoryTheory.Abelian.Ext.mk₀_zero,
              CategoryTheory.Abelian.Ext.comp_zero z L_U 0 2 (Nat.add_zero 2)]
      have hz₁_zero : z₁ = 0 := h_empty_zero _ hEmpty z₁
      have hz₂_zero : z₂ = 0 := h_empty_zero _ hEmpty z₂
      rw [hz₁_zero, hz₂_zero, map_zero, map_zero]
    · have hNeC : Nonempty ↥C_open.toScheme := not_isEmpty_iff.mp hEmpty
      have hr : 1 ≤ r := hr_pos
      have : AlgebraicGeometry.IsProper P1.hom := hProp_P1
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 P1.hom := hSm_P1
      have hProj_P1 : IsProjectiveOverField Ω P1 := by
        refine ⟨1, CategoryTheory.CategoryStruct.id P1, ?_⟩
        change AlgebraicGeometry.IsClosedImmersion (CategoryTheory.CategoryStruct.id P1.left)
        infer_instance
      let n := ℓ ^ r
      have hPrime : Nat.Prime ℓ := Fact.out
      have hn : 2 ≤ n := le_trans hPrime.two_le (Nat.le_self_pow (by omega) ℓ)
      have hℓ_ne : (ℓ : Ω) ≠ 0 := hℓΩ.ne_zero
      have hUnit_n : IsUnit (n : Ω) := by
        dsimp only [n]
        rw [Nat.cast_pow]
        exact hℓΩ.pow r
      have : NeZero (ℓ : Ω) := ⟨hℓ_ne⟩
      have : HasEnoughRootsOfUnity Ω (ℓ ^ r) := IsSepClosed.hasEnoughRootsOfUnity_pow Ω ℓ r
      obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω n
      let ζ : Ωˣ := Units.mk0 ζ₀ (hζ₀.ne_zero (by omega))
      have hζ : IsPrimitiveRoot (ζ : Ω) n := by simpa [ζ] using hζ₀
      have hGmSheaf : ∀ X : AlgebraicGeometry.Scheme.{u},
          CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X) :=
        (weil_etale_gm_isSheaf_and_proj_H0_divisible.{u}).1
      obtain ⟨s, C_comp, C_tilde, p_comp, j_tilde, d₁, d₂,
          h_le, h_iSup, h_disj, _, h_tilde, h_flf⟩ :=
        weil_gysin_affine_etale_curve_clopen_split_and_normalization Ω
          (fun A _ _ _ _ K _ _ _ =>
            weil_algClosed_finiteType_domain_integralClosure_finite Ω A K)
          P1 hInt_P1 hProj_P1 ι_P1 hOpen_P1 hι_P1_hom
          C_bar C_open hAffC hNeC π₁ π₂ hπ₁_hom hπ₂_hom
          v₁ v₂ hv₁_et hv₂_et hv₁_hom hv₂_hom hπ₁_open hπ₂_open
      have h_tilde_part : ∀ α : Fin s,
          AlgebraicGeometry.IsProper (C_tilde α).hom ∧
          CategoryTheory.CategoryStruct.comp (p_comp α) C_bar.hom = (C_tilde α).hom ∧
          AlgebraicGeometry.IsProper (p_comp α) ∧
          AlgebraicGeometry.IsOpenImmersion (j_tilde α) ∧
          CategoryTheory.CategoryStruct.comp (j_tilde α) (p_comp α) = (C_comp α).ι ∧
          CategoryTheory.IsPullback (j_tilde α)
            (CategoryTheory.CategoryStruct.id (C_comp α).toScheme)
