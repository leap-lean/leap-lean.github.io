      have h0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (n' + 1)) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨δ, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS x h0 rfl
      have hSF₁ : (S.map F₁).ShortExact := hS.map_of_exact F₁
      have hSF₂ : (S.map F₂).ShortExact := hS.map_of_exact F₂
      let φ_S : S.map F₁ ⟶ S.map F₂ :=
        { τ₁ := η.app S.X₁
          τ₂ := η.app S.X₂
          τ₃ := η.app S.X₃
