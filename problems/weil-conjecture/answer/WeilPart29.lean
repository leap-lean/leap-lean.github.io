  refine ⟨hIntΓ, hPropΓ, hπ_comm, hj_Y, hj_P, hpb, hOpen_j, ?_, ?_⟩
  · have : AlgebraicGeometry.IsProper (π_Y ≫ Y.hom) := hPropΓ
    infer_instance
  · let U_Γ : Γ.Opens := j_Γ.opensRange
    let I_Z := weilAltClosedComplIdeal Γ U_Γ
    have hDimW : topologicalKrullDim ↥W = ((m + 1 : ℕ) : WithBot ℕ∞) :=
      (h_open_dim Y hIntY W hNe).trans hDimY
    let Γ_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (π_Y ≫ Y.hom)
    have : AlgebraicGeometry.IsProper Γ_ov.hom := hPropΓ
    obtain ⟨w₀⟩ := hNe
