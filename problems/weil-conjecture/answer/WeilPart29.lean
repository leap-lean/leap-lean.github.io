    have hνμ : ν ≫ μ =
      𝟙 (L.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj A (L.obj B).obj)) := by
      apply (hbij (L.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj A (L.obj B).obj))).1
      dsimp only
