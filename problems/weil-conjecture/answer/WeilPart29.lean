      intro r Y πY s₁ s₂
      apply TopCat.Presheaf.section_ext Y.sheaf ⊤
      intro y _
      change (Y.presheaf.germ ⊤ y trivial).hom (r_sec r Y πY (s₁ + s₂)) =
