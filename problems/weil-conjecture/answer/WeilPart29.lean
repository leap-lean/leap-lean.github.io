  have hPillar4_FiniteDimZero : ∀ (K : Type u) [Field K] (Y : AlgebraicGeometry.Scheme.{u})
      (p : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of K)))
      [AlgebraicGeometry.IsFinite p],
      topologicalKrullDim Y ≤ (0 : WithBot ℕ∞) := by
    intro K _ Y p _
    have : AlgebraicGeometry.IsIntegralHom p := inferInstance
    have hAff_pair := (@AlgebraicGeometry.HasAffineProperty.iff_of_isAffine _ _
      AlgebraicGeometry.IsIntegralHom.hasAffineProperty _ _ p inferInstance).mp inferInstance
    have : AlgebraicGeometry.IsAffine Y := hAff_pair.1
