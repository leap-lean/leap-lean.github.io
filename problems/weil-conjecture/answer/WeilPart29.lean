  let ι_pre : weilEtaleGmPresheaf Y.left ⟶ weilEtaleKPresheaf Y.left :=
    { app := fun U =>
        AddCommGrpCat.ofHom (MonoidHom.toAdditive
          (Units.map (CategoryTheory.Limits.pullback.fst U.unop.hom η_X).appTop.hom.toMonoidHom))
      naturality := fun U₂ U₁ f => by
        let g : U₁.unop ⟶ U₂.unop := f.unop
        let m_g : CategoryTheory.Limits.pullback U₁.unop.hom η_X ⟶
            CategoryTheory.Limits.pullback U₂.unop.hom η_X :=
          ((CategoryTheory.Over.pullback η_X).map
            ((AlgebraicGeometry.Scheme.Etale.forget Y.left).map g)).left
        have hfst : m_g ≫ CategoryTheory.Limits.pullback.fst U₂.unop.hom η_X =
            CategoryTheory.Limits.pullback.fst U₁.unop.hom η_X ≫ g.left := by
          have hm : m_g = CategoryTheory.Limits.pullback.map U₁.unop.hom η_X U₂.unop.hom η_X
              g.left (𝟙 S_K) (𝟙 Y.left)
              ((CategoryTheory.Category.comp_id _).trans
                (CategoryTheory.MorphismProperty.Over.w g).symm)
              (by simp) :=
            CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ η_X g
          exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst U₂.unop.hom η_X) hm).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have happ : (CategoryTheory.Limits.pullback.fst U₂.unop.hom η_X).appTop ≫ m_g.appTop =
            g.left.appTop ≫ (CategoryTheory.Limits.pullback.fst U₁.unop.hom η_X).appTop :=
          (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _).symm.trans
            ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hfst).trans
              (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _))
        apply AddCommGrpCat.ext
        intro u
        apply Additive.toMul.injective
        apply Units.ext
        exact (ConcreteCategory.congr_hom happ (toGmUnit U₂.unop u).val).symm }

  have hDom_base : ∀ x : { x : ↥Y.left // IsClosed ({x} : Set ↥Y.left) },
      IsDomain ↑(Y.left.presheaf.stalk x.1) :=
    fun x => (hDVR_et T_X ⟨x.1, x.2⟩).choose

  let φ_tilde : ∀ (U : Y.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) }),
      K →+* FractionRing ↑(U.left.presheaf.stalk y.1) := fun U y =>
    let x : { x : ↥Y.left // IsClosed ({x} : Set ↥Y.left) } := ⟨U.hom.base y.1, y.2⟩
    let Rx := ↑(Y.left.presheaf.stalk x.1)
    let Ry := ↑(U.left.presheaf.stalk y.1)
    let _ : IsDomain Rx := hDom_base x
    let _ : IsDomain Ry := (hDVR_et U y).choose
    let t_U : U ⟶ T_X :=
      CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom) trivial
    let ψ_y : Rx →+* FractionRing Ry :=
      (algebraMap Ry (FractionRing Ry)).comp (U.hom.stalkMap y.1).hom
    have hψ_inj : Function.Injective ψ_y :=
      (IsFractionRing.injective Ry (FractionRing Ry)).comp (hUnram t_U y).1
    IsFractionRing.lift hψ_inj

  have hφ_tilde_alg : ∀ (U : Y.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) })
      (r : ↑(Y.left.presheaf.stalk (U.hom.base y.1))),
      φ_tilde U y (algebraMap ↑(Y.left.presheaf.stalk (U.hom.base y.1)) K r) =
        algebraMap ↑(U.left.presheaf.stalk y.1) _ ((U.hom.stalkMap y.1).hom r) := by
    intro U y r
    let _ : IsDomain ↑(Y.left.presheaf.stalk (U.hom.base y.1)) := hDom_base ⟨U.hom.base y.1, y.2⟩
    let _ : IsDomain ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose
    exact IsFractionRing.lift_algebraMap _ r

  have hcomm_γ : ∀ (U : Y.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) }),
      (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↑(U.left.presheaf.stalk y.1)
            (FractionRing ↑(U.left.presheaf.stalk y.1)))) ≫
          U.left.fromSpecStalk y.1) ≫ U.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U y)) ≫ η_X := by
    intro U y
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ Y.left := U.hom
    let x : ↥Y.left := u_hom.base y.1
    let Ry := ↑(U_sch.presheaf.stalk y.1)
    have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry (FractionRing Ry))) ≫
          U_sch.fromSpecStalk y.1) ≫ u_hom =
        AlgebraicGeometry.Spec.map
          (u_hom.stalkMap y.1 ≫ CommRingCat.ofHom (algebraMap Ry (FractionRing Ry))) ≫
          Y.left.fromSpecStalk x := by
      rw [CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.SpecMap_stalkMap_fromSpecStalk u_hom,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U y)) ≫ η_X =
        AlgebraicGeometry.Spec.map
          (Y.left.presheaf.stalkSpecializes (genericPoint_specializes x) ≫
            CommRingCat.ofHom (φ_tilde U y)) ≫ Y.left.fromSpecStalk x := by
      dsimp [η_X]
      rw [← AlgebraicGeometry.Scheme.SpecMap_stalkSpecializes_fromSpecStalk
          (genericPoint_specializes x),
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hring : u_hom.stalkMap y.1 ≫ CommRingCat.ofHom (algebraMap Ry (FractionRing Ry)) =
        Y.left.presheaf.stalkSpecializes (genericPoint_specializes x) ≫
          CommRingCat.ofHom (φ_tilde U y) := by
      ext r
      change algebraMap Ry (FractionRing Ry) ((u_hom.stalkMap y.1).hom r) =
        φ_tilde U y (algebraMap _ K r)
      exact (hφ_tilde_alg U y r).symm
    exact h1.trans
      ((congrArg (fun φ => AlgebraicGeometry.Spec.map φ ≫ Y.left.fromSpecStalk x) hring).trans
        h2.symm)

  let γ_Uy : ∀ (U : Y.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) }),
      AlgebraicGeometry.Spec (CommRingCat.of (FractionRing ↑(U.left.presheaf.stalk y.1))) ⟶
        CategoryTheory.Limits.pullback U.hom η_X := fun U y =>
    CategoryTheory.Limits.pullback.lift
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↑(U.left.presheaf.stalk y.1)
          (FractionRing ↑(U.left.presheaf.stalk y.1)))) ≫ U.left.fromSpecStalk y.1)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U y)))
      (hcomm_γ U y)

  let ev_Uy : ∀ (U : Y.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) }),
      ↑((CategoryTheory.Limits.pullback U.hom η_X).presheaf.obj (Opposite.op ⊤)) →+*
        FractionRing ↑(U.left.presheaf.stalk y.1) := fun U y =>
    ((γ_Uy U y).appTop ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso
        (CommRingCat.of (FractionRing ↑(U.left.presheaf.stalk y.1)))).hom).hom

  have hev_fst : ∀ (U : Y.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) })
      (r : ↑(U.left.presheaf.obj (Opposite.op ⊤))),
      ev_Uy U y ((CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom r) =
        algebraMap ↑(U.left.presheaf.stalk y.1) _
          ((U.left.presheaf.germ ⊤ y.1 trivial).hom r) := by
    intro U y r
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ Y.left := U.hom
    let Ry := ↑(U_sch.presheaf.stalk y.1)
    have hfst : γ_Uy U y ≫ CategoryTheory.Limits.pullback.fst u_hom η_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry (FractionRing Ry))) ≫
          U_sch.fromSpecStalk y.1 :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have happ : (CategoryTheory.Limits.pullback.fst u_hom η_X).appTop ≫ (γ_Uy U y).appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (FractionRing Ry))).hom =
        U_sch.presheaf.germ ⊤ y.1 trivial ≫
          CommRingCat.ofHom (algebraMap Ry (FractionRing Ry)) := by
      have hcomp_top : (CategoryTheory.Limits.pullback.fst u_hom η_X).appTop ≫ (γ_Uy U y).appTop =
          (U_sch.fromSpecStalk y.1).appTop ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry (FractionRing Ry)))).appTop :=
        (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _).symm.trans
          ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hfst).trans
            (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _))
      rw [← CategoryTheory.Category.assoc, hcomp_top, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
      have hfs := U_sch.fromSpecStalk_app (U := ⊤) (x := y.1) trivial
      have hhom_id : (CategoryTheory.homOfLE
          (le_rfl : (⊤ : (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).Opens) ≤ ⊤)) =
          𝟙 ⊤ := Subsingleton.elim _ _
      have hmap_id : (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).presheaf.map
          (CategoryTheory.homOfLE
            (le_rfl : (⊤ : (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).Opens) ≤ ⊤)).op =
          𝟙 _ :=
        (congrArg
          (fun f => (AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).presheaf.map f.op)
          hhom_id).trans
          ((AlgebraicGeometry.Spec (U_sch.presheaf.stalk y.1)).presheaf.map_id (Opposite.op ⊤))
      have hfs' : (U_sch.fromSpecStalk y.1).appTop =
          U_sch.presheaf.germ ⊤ y.1 trivial ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (U_sch.presheaf.stalk y.1)).inv :=
        hfs.trans (congrArg (U_sch.presheaf.germ ⊤ y.1 trivial ≫ ·)
          ((congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (U_sch.presheaf.stalk y.1)).inv ≫ ·)
            hmap_id).trans (CategoryTheory.Category.comp_id _)))
      rw [hfs', CategoryTheory.Category.assoc]
      exact congrArg (U_sch.presheaf.germ ⊤ y.1 trivial ≫ ·)
        ((AlgebraicGeometry.Scheme.ΓSpecIso (U_sch.presheaf.stalk y.1)).inv_hom_id_assoc _)
    exact ConcreteCategory.congr_hom happ r

  let div_val : ∀ U : Y.left.Etale,
      ↥((weilEtaleKPresheaf Y.left).obj (Opposite.op U)) →+
        ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) } → ℤ) := fun U =>
    AddMonoidHom.pi fun y =>
      let _ : IsDomain ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose
      let _ : IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose_spec
      { toFun := fun s =>
          ordDVR ↑(U.left.presheaf.stalk y.1)
            (Additive.ofMul (Units.map (ev_Uy U y).toMonoidHom (toKUnit U s)))
        map_zero' :=
          (congrArg (fun v => ordDVR _ (Additive.ofMul v))
            ((Units.map (ev_Uy U y).toMonoidHom).map_one)).trans
            ((ordDVR _).map_zero)
        map_add' := fun s₁ s₂ =>
          (congrArg (fun v => ordDVR _ (Additive.ofMul v))
            ((Units.map (ev_Uy U y).toMonoidHom).map_mul (toKUnit U s₁) (toKUnit U s₂))).trans
            ((ordDVR _).map_add _ _) }

  have hDivNat : ∀ {U₁ U₂ : Y.left.Etale} (g : U₁ ⟶ U₂)
      (s : ↥((weilEtaleKPresheaf Y.left).obj (Opposite.op U₂)))
      (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥Y.left) }),
      div_val U₁ (((weilEtaleKPresheaf Y.left).map g.op).hom s) y₁ =
        div_val U₂ s ⟨g.left.base y₁.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
          exact y₁.2⟩ := by
    intro U₁ U₂ g s y₁
    let U₁_sch : AlgebraicGeometry.Scheme.{u} := U₁.left
    let U₂_sch : AlgebraicGeometry.Scheme.{u} := U₂.left
    let u₁_hom : U₁_sch ⟶ Y.left := U₁.hom
    let u₂_hom : U₂_sch ⟶ Y.left := U₂.hom
    let g_left : U₁_sch ⟶ U₂_sch := g.left
    let y₂ : { y : ↥U₂.left // IsClosed ({U₂.hom.base y} : Set ↥Y.left) } :=
      ⟨g_left.base y₁.1, by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
        exact y₁.2⟩
    let Ry₁ := ↑(U₁_sch.presheaf.stalk y₁.1)
    let Ry₂ := ↑(U₂_sch.presheaf.stalk y₂.1)
    let _ : IsDomain Ry₁ := (hDVR_et U₁ y₁).choose
    let _ : IsDiscreteValuationRing Ry₁ := (hDVR_et U₁ y₁).choose_spec
    let _ : IsDomain Ry₂ := (hDVR_et U₂ y₂).choose
    let _ : IsDiscreteValuationRing Ry₂ := (hDVR_et U₂ y₂).choose_spec
    rcases hUnram g y₁ with ⟨hInj_g, hPow_g⟩
    let ψ_g : Ry₂ →+* FractionRing Ry₁ :=
      (algebraMap Ry₁ (FractionRing Ry₁)).comp (g_left.stalkMap y₁.1).hom
    have hψg_inj : Function.Injective ψ_g :=
      (IsFractionRing.injective Ry₁ (FractionRing Ry₁)).comp hInj_g
    let ψ_tilde : FractionRing Ry₂ →+* FractionRing Ry₁ := IsFractionRing.lift hψg_inj
    have hψ_alg : ∀ r : Ry₂, ψ_tilde (algebraMap Ry₂ (FractionRing Ry₂) r) =
        algebraMap Ry₁ (FractionRing Ry₁) ((g_left.stalkMap y₁.1).hom r) :=
      fun r => IsFractionRing.lift_algebraMap hψg_inj r
    have hcomp_K : ψ_tilde.comp (φ_tilde U₂ y₂) = φ_tilde U₁ y₁ := by
      let Rx₂ := ↑(Y.left.presheaf.stalk (u₂_hom.base y₂.1))
      have : IsDomain Rx₂ := hDom_base ⟨u₂_hom.base y₂.1, y₂.2⟩
      apply IsLocalization.ringHom_ext (nonZeroDivisors Rx₂)
      ext r
      change ψ_tilde (φ_tilde U₂ y₂ (algebraMap Rx₂ K r)) =
        φ_tilde U₁ y₁ (algebraMap Rx₂ K r)
      rw [hφ_tilde_alg U₂ y₂ r, hψ_alg]
      have hw : g_left ≫ u₂_hom = u₁_hom := CategoryTheory.MorphismProperty.Over.w g
      have hp : u₂_hom.base y₂.1 = u₁_hom.base y₁.1 := by
        change u₂_hom.base (g_left.base y₁.1) = u₁_hom.base y₁.1
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hw]
      have hins : Inseparable (u₁_hom.base y₁.1) (u₂_hom.base y₂.1) :=
        Inseparable.of_eq hp.symm
      let e_sc := Y.left.presheaf.stalkCongr hins
      have hst : u₁_hom.stalkMap y₁.1 =
          e_sc.hom ≫ u₂_hom.stalkMap y₂.1 ≫ g_left.stalkMap y₁.1 :=
        (AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom u₁_hom (g_left ≫ u₂_hom) hw.symm y₁.1).trans
          (congrArg (e_sc.hom ≫ ·) (AlgebraicGeometry.Scheme.Hom.stalkMap_comp g_left u₂_hom y₁.1))
      let r₁ : ↑(Y.left.presheaf.stalk (u₁_hom.base y₁.1)) := e_sc.inv.hom r
      have hhom_sp : e_sc.hom ≫
            Y.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1)) =
          Y.left.presheaf.stalkSpecializes (genericPoint_specializes (u₁_hom.base y₁.1)) :=
        (congrArg (· ≫ Y.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1)))
          (TopCat.Presheaf.stalkCongr_hom Y.left.presheaf hins)).trans
          (Y.left.presheaf.stalkSpecializes_comp (genericPoint_specializes (u₂_hom.base y₂.1)) _)
      have hinv_sp : e_sc.inv ≫
            Y.left.presheaf.stalkSpecializes (genericPoint_specializes (u₁_hom.base y₁.1)) =
          Y.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1)) :=
        (congrArg (e_sc.inv ≫ ·) hhom_sp.symm).trans
          (e_sc.inv_hom_id_assoc
            (Y.left.presheaf.stalkSpecializes (genericPoint_specializes (u₂_hom.base y₂.1))))
      have halg_eq : algebraMap ↑(Y.left.presheaf.stalk (u₁_hom.base y₁.1)) K r₁ =
          algebraMap Rx₂ K r :=
        ConcreteCategory.congr_hom hinv_sp r
      rw [← halg_eq, hφ_tilde_alg U₁ y₁ r₁]
      have hst_r := ConcreteCategory.congr_hom hst r₁
      change _ = algebraMap Ry₁ (FractionRing Ry₁) ((u₁_hom.stalkMap y₁.1).hom r₁)
      rw [hst_r]
      have hinv_hom_r : e_sc.hom.hom r₁ = r :=
        ConcreteCategory.congr_hom e_sc.inv_hom_id r
      exact congrArg (fun z => algebraMap Ry₁ (FractionRing Ry₁)
        ((g_left.stalkMap y₁.1).hom ((u₂_hom.stalkMap y₂.1).hom z))) hinv_hom_r.symm
    let m_g : CategoryTheory.Limits.pullback u₁_hom η_X ⟶
        CategoryTheory.Limits.pullback u₂_hom η_X :=
      ((CategoryTheory.Over.pullback η_X).map
        ((AlgebraicGeometry.Scheme.Etale.forget Y.left).map g)).left
    have hm_g_eq : m_g = CategoryTheory.Limits.pullback.map u₁_hom η_X u₂_hom η_X
        g_left (𝟙 S_K) (𝟙 Y.left)
        ((CategoryTheory.Category.comp_id _).trans
          (CategoryTheory.MorphismProperty.Over.w g).symm)
        (by simp) :=
      CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ η_X g
    have hγ_mg : γ_Uy U₁ y₁ ≫ m_g =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde) ≫ γ_Uy U₂ y₂ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hm_fst : m_g ≫ CategoryTheory.Limits.pullback.fst u₂_hom η_X =
            CategoryTheory.Limits.pullback.fst u₁_hom η_X ≫ g_left :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.fst u₂_hom η_X) hm_g_eq).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have hγ₁_fst : γ_Uy U₁ y₁ ≫ CategoryTheory.Limits.pullback.fst u₁_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry₁ (FractionRing Ry₁))) ≫
              U₁_sch.fromSpecStalk y₁.1 :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hγ₂_fst : γ_Uy U₂ y₂ ≫ CategoryTheory.Limits.pullback.fst u₂_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ry₂ (FractionRing Ry₂))) ≫
              U₂_sch.fromSpecStalk y₂.1 :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [CategoryTheory.Category.assoc, hm_fst, ← CategoryTheory.Category.assoc,
          hγ₁_fst, CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde)),
          hγ₂_fst, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.SpecMap_stalkMap_fromSpecStalk g_left,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        congr 2
        ext r
        change algebraMap Ry₁ (FractionRing Ry₁) ((g_left.stalkMap y₁.1).hom r) =
          ψ_tilde (algebraMap Ry₂ (FractionRing Ry₂) r)
        exact (hψ_alg r).symm
      · have hm_snd : m_g ≫ CategoryTheory.Limits.pullback.snd u₂_hom η_X =
            CategoryTheory.Limits.pullback.snd u₁_hom η_X :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.snd u₂_hom η_X) hm_g_eq).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              (CategoryTheory.Category.comp_id _))
        have hγ₁_snd : γ_Uy U₁ y₁ ≫ CategoryTheory.Limits.pullback.snd u₁_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U₁ y₁)) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hγ₂_snd : γ_Uy U₂ y₂ ≫ CategoryTheory.Limits.pullback.snd u₂_hom η_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde U₂ y₂)) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [CategoryTheory.Category.assoc, hm_snd, hγ₁_snd,
          CategoryTheory.Category.assoc, hγ₂_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp_K]
    have hev_mg : ∀ z, ev_Uy U₁ y₁ (m_g.appTop.hom z) = ψ_tilde (ev_Uy U₂ y₂ z) := by
      intro z
      have happ : m_g.appTop ≫ (γ_Uy U₁ y₁).appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (FractionRing Ry₁))).hom =
          ((γ_Uy U₂ y₂).appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (FractionRing Ry₂))).hom) ≫
            CommRingCat.ofHom ψ_tilde := by
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
          hγ_mg, AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality, CategoryTheory.Category.assoc]
      exact ConcreteCategory.congr_hom happ z
    have hunit_eq : Units.map (ev_Uy U₁ y₁).toMonoidHom
          (Units.map m_g.appTop.hom.toMonoidHom (toKUnit U₂ s)) =
        Units.map ψ_tilde.toMonoidHom
          (Units.map (ev_Uy U₂ y₂).toMonoidHom (toKUnit U₂ s)) := by
      ext; exact hev_mg (toKUnit U₂ s).val
    change ordDVR Ry₁ (Additive.ofMul (Units.map (ev_Uy U₁ y₁).toMonoidHom
        (Units.map m_g.appTop.hom.toMonoidHom (toKUnit U₂ s)))) =
      ordDVR Ry₂ (Additive.ofMul (Units.map (ev_Uy U₂ y₂).toMonoidHom (toKUnit U₂ s)))
    rw [hunit_eq]
    exact hordDVR_ext Ry₁ Ry₂ (g_left.stalkMap y₁.1).hom ψ_tilde hInj_g hPow_g hψ_alg _

  have hDivZero : ∀ (U : Y.left.Etale)
      (u : ↥((weilEtaleGmPresheaf Y.left).obj (Opposite.op U))),
      div_val U ((ι_pre.app (Opposite.op U)).hom u) = 0 := by
    intro U u
    ext y
    let Ry := ↑(U.left.presheaf.stalk y.1)
    let _ : IsDomain Ry := (hDVR_et U y).choose
    let _ : IsDiscreteValuationRing Ry := (hDVR_et U y).choose_spec
    let v : Units Ry := Units.map (U.left.presheaf.germ ⊤ y.1 trivial).hom.toMonoidHom
      (toGmUnit U u)
    have hu_eq : Units.map (ev_Uy U y).toMonoidHom
          (Units.map (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom.toMonoidHom
            (toGmUnit U u)) =
        Units.map (algebraMap Ry (FractionRing Ry)).toMonoidHom v := by
      ext; exact hev_fst U y (toGmUnit U u).val
    change ordDVR Ry (Additive.ofMul (Units.map (ev_Uy U y).toMonoidHom
      (Units.map (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom.toMonoidHom
        (toGmUnit U u)))) = 0
    rw [hu_eq]
    exact hordDVR_unit Ry v

  
  have hTensor_aux : ∀ (R₀ D₀ K₀ : Type u) [CommRing R₀] [CommRing D₀] [IsDomain D₀]
      [Field K₀] [Algebra R₀ D₀] [Algebra R₀ K₀] [IsFractionRing R₀ K₀],
      Function.Injective (algebraMap R₀ D₀) →
      Function.Injective
        (Algebra.TensorProduct.includeLeftRingHom : D₀ →+* TensorProduct R₀ D₀ K₀) ∧
      (∀ u_T : Units (TensorProduct R₀ D₀ K₀), ∃ c d : D₀, c ≠ 0 ∧ d ≠ 0 ∧
        IsUnit ((Algebra.TensorProduct.includeLeftRingHom : D₀ →+* TensorProduct R₀ D₀ K₀) d) ∧
        (u_T : TensorProduct R₀ D₀ K₀) *
          (Algebra.TensorProduct.includeLeftRingHom : D₀ →+* TensorProduct R₀ D₀ K₀) d =
          (Algebra.TensorProduct.includeLeftRingHom : D₀ →+* TensorProduct R₀ D₀ K₀) c) := by
    intro R₀ D₀ K₀ _ _ _ _ _ _ _ hInj₀
    have : Nontrivial R₀ :=
      ⟨⟨0, 1, fun h => zero_ne_one
        ((map_zero (algebraMap R₀ D₀)).symm.trans
          ((congrArg (algebraMap R₀ D₀) h).trans (map_one (algebraMap R₀ D₀))))⟩⟩
    have : NoZeroDivisors R₀ :=
      ⟨fun {a b} hab => by
        have h0 : algebraMap R₀ D₀ a * algebraMap R₀ D₀ b = 0 := by
          rw [← map_mul, hab, map_zero]
        exact (mul_eq_zero.mp h0).imp
          (fun ha => hInj₀ (ha.trans (map_zero _).symm))
          (fun hb => hInj₀ (hb.trans (map_zero _).symm))⟩
    have : IsDomain R₀ := {}
    let L₀ := FractionRing D₀
    let ψ_A : R₀ →+* L₀ := (algebraMap D₀ L₀).comp (algebraMap R₀ D₀)
    have hψA_inj : Function.Injective ψ_A :=
      (IsFractionRing.injective D₀ L₀).comp hInj₀
    let ψ_K : K₀ →+* L₀ := IsFractionRing.lift hψA_inj
    let ι_D₀ : D₀ →+* TensorProduct R₀ D₀ K₀ := Algebra.TensorProduct.includeLeftRingHom
    let ι_K₀ : K₀ →+* TensorProduct R₀ D₀ K₀ := Algebra.TensorProduct.includeRight.toRingHom
    let bilin : D₀ →ₗ[R₀] K₀ →ₗ[R₀] L₀ :=
      { toFun := fun d =>
          { toFun := fun κ => algebraMap D₀ L₀ d * ψ_K κ
            map_add' := fun x y => by rw [map_add, mul_add]
            map_smul' := fun a x => by
              rw [RingHom.id_apply, Algebra.smul_def a x, map_mul,
                IsFractionRing.lift_algebraMap hψA_inj a,
                ← IsScalarTower.algebraMap_smul D₀ a _, Algebra.smul_def]
              dsimp only [ψ_A, RingHom.comp_apply]
              ring }
        map_add' := fun d₁ d₂ => LinearMap.ext fun κ => by
          change algebraMap D₀ L₀ (d₁ + d₂) * ψ_K κ =
            algebraMap D₀ L₀ d₁ * ψ_K κ + algebraMap D₀ L₀ d₂ * ψ_K κ
          rw [map_add, add_mul]
        map_smul' := fun a d => LinearMap.ext fun κ => by
          rw [RingHom.id_apply, LinearMap.smul_apply, Algebra.smul_def a d,
            ← IsScalarTower.algebraMap_smul D₀ a _, Algebra.smul_def]
          change algebraMap D₀ L₀ (algebraMap R₀ D₀ a * d) * ψ_K κ =
            algebraMap D₀ L₀ (algebraMap R₀ D₀ a) * (algebraMap D₀ L₀ d * ψ_K κ)
          rw [map_mul]
          exact mul_assoc (algebraMap R₀ D₀ a |> algebraMap D₀ L₀) (algebraMap D₀ L₀ d) (ψ_K κ) }
    have hInj_ιD₀ : Function.Injective ι_D₀ := by
      intro d₁ d₂ hd_eq
      have heval : ∀ d : D₀, TensorProduct.lift bilin (ι_D₀ d) = algebraMap D₀ L₀ d := fun d => by
        change TensorProduct.lift bilin (d ⊗ₜ[R₀] (1 : K₀)) = algebraMap D₀ L₀ d
        rw [TensorProduct.lift.tmul]
        change algebraMap D₀ L₀ d * ψ_K 1 = algebraMap D₀ L₀ d
        rw [map_one, mul_one]
      apply IsFractionRing.injective D₀ L₀
      exact (heval d₁).symm.trans ((congrArg (TensorProduct.lift bilin) hd_eq).trans (heval d₂))
    have hclear : ∀ z : TensorProduct R₀ D₀ K₀,
        ∃ (c : D₀) (a : nonZeroDivisors R₀), z * ι_D₀ (algebraMap R₀ D₀ a.1) = ι_D₀ c := by
      intro z
      refine TensorProduct.induction_on
        (motive := fun z =>
          ∃ (c : D₀) (a : nonZeroDivisors R₀), z * ι_D₀ (algebraMap R₀ D₀ a.1) = ι_D₀ c)
        z ?_ ?_ ?_
      · exact ⟨0, 1, by rw [zero_mul, map_zero]⟩
      · intro d κ
        obtain ⟨p, q, hq_mem, hpq⟩ := IsFractionRing.div_surjective (A := R₀) κ
        have hq_K : algebraMap R₀ K₀ q ≠ 0 :=
          (IsLocalization.map_units K₀ ⟨q, hq_mem⟩).ne_zero
        have hκq : algebraMap R₀ K₀ p = κ * algebraMap R₀ K₀ q := (div_eq_iff hq_K).mp hpq
        refine ⟨d * algebraMap R₀ D₀ p, ⟨q, hq_mem⟩, ?_⟩
        have hcomm_q : ι_D₀ (algebraMap R₀ D₀ q) = ι_K₀ (algebraMap R₀ K₀ q) :=
          congrFun (congrArg DFunLike.coe Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap) q
        rw [hcomm_q]
        change (d ⊗ₜ[R₀] κ) * ((1 : D₀) ⊗ₜ[R₀] algebraMap R₀ K₀ q) =
          (d * algebraMap R₀ D₀ p) ⊗ₜ[R₀] (1 : K₀)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← hκq]
        have hp_D : d * algebraMap R₀ D₀ p = p • d := by
          rw [Algebra.smul_def]; exact mul_comm d (algebraMap R₀ D₀ p)
        have hp_K : algebraMap R₀ K₀ p = p • (1 : K₀) := by
          rw [Algebra.smul_def, mul_one]
        rw [hp_D, hp_K, TensorProduct.smul_tmul]
      · rintro x y ⟨c₁, a₁, hx₁⟩ ⟨c₂, a₂, hy₂⟩
        refine ⟨c₁ * algebraMap R₀ D₀ a₂.1 + c₂ * algebraMap R₀ D₀ a₁.1, a₁ * a₂, ?_⟩
        change (x + y) * ι_D₀ (algebraMap R₀ D₀ (a₁.1 * a₂.1)) =
          ι_D₀ (c₁ * algebraMap R₀ D₀ a₂.1 + c₂ * algebraMap R₀ D₀ a₁.1)
        have hmul₁ : x * (ι_D₀ (algebraMap R₀ D₀ a₁.1) * ι_D₀ (algebraMap R₀ D₀ a₂.1)) =
            ι_D₀ c₁ * ι_D₀ (algebraMap R₀ D₀ a₂.1) := by
          rw [← mul_assoc, hx₁]
        have hmul₂ : y * (ι_D₀ (algebraMap R₀ D₀ a₁.1) * ι_D₀ (algebraMap R₀ D₀ a₂.1)) =
            ι_D₀ c₂ * ι_D₀ (algebraMap R₀ D₀ a₁.1) := by
          rw [mul_comm (ι_D₀ (algebraMap R₀ D₀ a₁.1)) (ι_D₀ (algebraMap R₀ D₀ a₂.1)),
            ← mul_assoc, hy₂]
        rw [map_mul (algebraMap R₀ D₀), map_mul ι_D₀, add_mul, hmul₁, hmul₂,
          ← map_mul, ← map_mul, ← map_add]
    refine ⟨hInj_ιD₀, fun u_T => ?_⟩
    obtain ⟨c, a, hca⟩ := hclear (u_T : TensorProduct R₀ D₀ K₀)
    have ha_ne : a.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp a.2
    have hd : algebraMap R₀ D₀ a.1 ≠ 0 :=
      fun h0 => ha_ne (hInj₀ (h0.trans (map_zero _).symm))
    have hu_d : IsUnit (ι_D₀ (algebraMap R₀ D₀ a.1)) := by
      have hcomm_a : ι_D₀ (algebraMap R₀ D₀ a.1) = ι_K₀ (algebraMap R₀ K₀ a.1) :=
        congrFun (congrArg DFunLike.coe Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap) a.1
      rw [hcomm_a]
      exact (IsLocalization.map_units K₀ a).map ι_K₀
    have hc : c ≠ 0 := by
      intro hc0
      rw [hc0, map_zero] at hca
      have h0 : ι_D₀ (algebraMap R₀ D₀ a.1) = 0 := by
        calc ι_D₀ (algebraMap R₀ D₀ a.1)
            = ↑u_T⁻¹ * ((u_T : TensorProduct R₀ D₀ K₀) * ι_D₀ (algebraMap R₀ D₀ a.1)) :=
              (Units.inv_mul_cancel_left u_T (ι_D₀ (algebraMap R₀ D₀ a.1))).symm
          _ = ↑u_T⁻¹ * 0 := congrArg (↑u_T⁻¹ * ·) hca
          _ = 0 := mul_zero _
      exact hd (hInj_ιD₀ (h0.trans (map_zero ι_D₀).symm))
    exact ⟨c, algebraMap R₀ D₀ a.1, hc, hd, hu_d, hca⟩

  have hOpens_top_app : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (V : Z.Opens),
      V.ι.appTop = Z.presheaf.map (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op ≫ V.topIso.inv := by
    intro Z V
    exact (congrArg Z.presheaf.map (Subsingleton.elim _ _)).trans
      ((Z.presheaf.map_comp _ _).trans
        (congrArg (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op ≫ ·)
          (AlgebraicGeometry.Scheme.Opens.topIso_inv V).symm))

  have hOpens_homOfLE_top : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Z.Opens} (hle : U₁ ≤ U₂),
      U₂.topIso.inv ≫ (Z.homOfLE hle).appTop =
        Z.presheaf.map (CategoryTheory.homOfLE hle).op ≫ U₁.topIso.inv := by
    intro Z U₁ U₂ hle
    rw [AlgebraicGeometry.Scheme.homOfLE_appTop,
      AlgebraicGeometry.Scheme.Opens.topIso_inv,
      AlgebraicGeometry.Scheme.Opens.topIso_inv]
    exact (Z.presheaf.map_comp _ _).symm.trans
      ((congrArg Z.presheaf.map (Subsingleton.elim _ _)).trans (Z.presheaf.map_comp _ _))

  have hAffine_topIso_cancel : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W : Z.Opens}
      (hW : AlgebraicGeometry.IsAffineOpen W),
      W.topIso.inv ≫ hW.isoSpec.inv.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op W))).hom = 𝟙 _ := by
    intro Z W hW
    have htop : (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op W))).inv ≫
        hW.isoSpec.hom.appTop = W.topIso.inv :=
      (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op W))).inv ≫ ·)
        ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hW.isoSpec_hom).trans
          ((AlgebraicGeometry.Scheme.Hom.comp_appTop
            (W : AlgebraicGeometry.Scheme.{u}).toSpecΓ
            (AlgebraicGeometry.Spec.map W.topIso.inv)).trans
            ((congrArg ((AlgebraicGeometry.Spec.map W.topIso.inv).appTop ≫ ·)
              (AlgebraicGeometry.Scheme.toSpecΓ_appTop (W : AlgebraicGeometry.Scheme.{u}))).trans
              (AlgebraicGeometry.Scheme.ΓSpecIso_naturality W.topIso.inv))))).trans
        ((AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op W))).inv_hom_id_assoc
          W.topIso.inv)
    have hhom_inv_top : hW.isoSpec.hom.appTop ≫ hW.isoSpec.inv.appTop = 𝟙 _ :=
      (AlgebraicGeometry.Scheme.Hom.comp_appTop hW.isoSpec.inv hW.isoSpec.hom).symm.trans
        ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hW.isoSpec.inv_hom_id).trans
          AlgebraicGeometry.Scheme.Hom.id_appTop)
    exact (congrArg (· ≫ (hW.isoSpec.inv.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op W))).hom)) htop.symm).trans
      ((CategoryTheory.Category.assoc _ hW.isoSpec.hom.appTop _).trans
        ((congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op W))).inv ≫ ·)
          ((CategoryTheory.Category.assoc hW.isoSpec.hom.appTop hW.isoSpec.inv.appTop _).symm.trans
            ((congrArg (· ≫ _) hhom_inv_top).trans
              (CategoryTheory.Category.id_comp _)))).trans
          (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op W))).inv_hom_id))

  have hOpens_germ_topIso : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (V : Z.Opens)
      (pt : ↥Z) (hpt : pt ∈ V) (r : ↑(Z.presheaf.obj (Opposite.op V))),
      (V.stalkIso ⟨pt, hpt⟩).commRingCatIsoToRingEquiv
        (((V : AlgebraicGeometry.Scheme.{u}).presheaf.germ ⊤ ⟨pt, hpt⟩ trivial).hom
          (V.topIso.inv.hom r)) =
        (Z.presheaf.germ V pt hpt).hom r := by
    intro Z V pt hpt r
    let e_iso := (V.stalkIso ⟨pt, hpt⟩).commRingCatIsoToRingEquiv
    apply e_iso.symm.injective
    rw [e_iso.symm_apply_apply]
    have h1 := AlgebraicGeometry.Scheme.Opens.germ_stalkIso_inv V ⊤ ⟨pt, hpt⟩ trivial
    have h2 := ConcreteCategory.congr_hom h1.symm (V.topIso.inv.hom r)
    refine h2.trans ?_
    change (V.stalkIso ⟨pt, hpt⟩).inv.hom
        ((Z.presheaf.germ (V.ι ''ᵁ ⊤) pt _).hom (V.topIso.inv.hom r)) =
      (V.stalkIso ⟨pt, hpt⟩).inv.hom ((Z.presheaf.germ V pt hpt).hom r)
    congr 1
    rw [AlgebraicGeometry.Scheme.Opens.topIso_inv]
    exact ConcreteCategory.congr_hom (TopCat.Presheaf.germ_res Z.presheaf _ pt _) r

  have hChart_pullback : ∀ (U : Y.left.Etale) (W₀ : Y.left.Opens)
      (hW₀ : AlgebraicGeometry.IsAffineOpen W₀)
      (V₀ : U.left.Opens) (hV₀ : AlgebraicGeometry.IsAffineOpen V₀) (u₀ : ↥U.left)
      (hu₀ : u₀ ∈ V₀) (e : V₀ ≤ (TopologicalSpace.Opens.map U.hom.base).obj W₀),
      IsDomain ↑(U.left.presheaf.obj (Opposite.op V₀)) →
      Function.Injective (U.hom.appLE W₀ V₀ e).hom →
      let A₀ := ↑(Y.left.presheaf.obj (Opposite.op W₀))
      let D := ↑(U.left.presheaf.obj (Opposite.op V₀))
      letI : Algebra A₀ D := (U.hom.appLE W₀ V₀ e).hom.toAlgebra
      letI : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨U.hom.base u₀, e hu₀⟩⟩
      let T := TensorProduct A₀ D K
      ∃ r_hom : ↑((CategoryTheory.Limits.pullback (V₀.ι ≫ U.hom) η_X).presheaf.obj
            (Opposite.op ⊤)) →+* T,
        Function.Bijective r_hom ∧
        Function.Injective (Algebra.TensorProduct.includeLeftRingHom : D →+* T) ∧
        (∀ r : D,
          r_hom ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ U.hom) η_X).appTop.hom
            (V₀.topIso.inv.hom r)) =
            (Algebra.TensorProduct.includeLeftRingHom : D →+* T) r) ∧
        (∀ u_T : Units T, ∃ c d : D, c ≠ 0 ∧ d ≠ 0 ∧
          IsUnit ((Algebra.TensorProduct.includeLeftRingHom : D →+* T) d) ∧
          (u_T : T) * (Algebra.TensorProduct.includeLeftRingHom : D →+* T) d =
            (Algebra.TensorProduct.includeLeftRingHom : D →+* T) c) := by
    intro U W₀ hW₀ V₀ hV₀ u₀ hu₀ e hDomD hInjφ
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ Y.left := U.hom
    let A₀ := ↑(Y.left.presheaf.obj (Opposite.op W₀))
    let D := ↑(U_sch.presheaf.obj (Opposite.op V₀))
    let φ : A₀ →+* D := (u_hom.appLE W₀ V₀ e).hom
    let _ : Algebra A₀ D := φ.toAlgebra
    have hx₀ : u_hom.base u₀ ∈ W₀ := e hu₀
    let _ : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨u_hom.base u₀, hx₀⟩⟩
    have hη_W₀ : η ∈ W₀ := (genericPoint_specializes (u_hom.base u₀)).mem_open W₀.isOpen hx₀
    have : IsFractionRing A₀ K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y.left W₀ hW₀
    let T := TensorProduct A₀ D K
    let ι_D : D →+* T := Algebra.TensorProduct.includeLeftRingHom
    let ι_K : K →+* T := Algebra.TensorProduct.includeRight.toRingHom
    let Z_η := CategoryTheory.Limits.pullback (V₀.ι ≫ u_hom) η_X
    let p₁_T : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ (V₀ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D) ≫ hV₀.isoSpec.inv
    let p₂_T : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ S_K :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_K)
    have hη_fac : η_X =
        AlgebraicGeometry.Spec.map (Y.left.presheaf.germ W₀ η hη_W₀) ≫ hW₀.fromSpec := by
      dsimp [η_X]
      rw [← hW₀.fromSpecStalk_eq_fromSpecStalk hη_W₀,
        AlgebraicGeometry.IsAffineOpen.fromSpecStalk.eq_1 hW₀ hη_W₀]
    have hV_fac : V₀.ι ≫ u_hom =
        hV₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (u_hom.appLE W₀ V₀ e) ≫ hW₀.fromSpec := by
      have hiso_fr : hV₀.isoSpec.hom ≫ hV₀.fromSpec = V₀.ι := by
        rw [← hV₀.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
      rw [← hiso_fr, CategoryTheory.Category.assoc,
        hW₀.SpecMap_appLE_fromSpec u_hom hV₀ e]
    have hcomm_T : p₁_T ≫ (V₀.ι ≫ u_hom) = p₂_T ≫ η_X := by
      have hlhs : p₁_T ≫ (V₀.ι ≫ u_hom) =
          AlgebraicGeometry.Spec.map (u_hom.appLE W₀ V₀ e ≫ CommRingCat.ofHom ι_D) ≫
            hW₀.fromSpec := by
        dsimp [p₁_T]
        rw [hV_fac, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hrhs : p₂_T ≫ η_X =
          AlgebraicGeometry.Spec.map
            (Y.left.presheaf.germ W₀ η hη_W₀ ≫ CommRingCat.ofHom ι_K) ≫ hW₀.fromSpec :=
        (congrArg (p₂_T ≫ ·) hη_fac).trans
          ((CategoryTheory.Category.assoc p₂_T _ hW₀.fromSpec).symm.trans
            (congrArg (· ≫ hW₀.fromSpec)
              (AlgebraicGeometry.Spec.map_comp
                (Y.left.presheaf.germ W₀ η hη_W₀) (CommRingCat.ofHom ι_K)).symm))
      have hring : u_hom.appLE W₀ V₀ e ≫ CommRingCat.ofHom ι_D =
          Y.left.presheaf.germ W₀ η hη_W₀ ≫ CommRingCat.ofHom ι_K := by
        ext a
        change ι_D (φ a) = ι_K (algebraMap A₀ K a)
        exact congrFun (congrArg DFunLike.coe Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap) a
      exact hlhs.trans
        ((congrArg (fun f => AlgebraicGeometry.Spec.map f ≫ hW₀.fromSpec) hring).trans hrhs.symm)
    let hom_Z : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ Z_η :=
      CategoryTheory.Limits.pullback.lift p₁_T p₂_T hcomm_T
    have : CategoryTheory.Mono hW₀.fromSpec := AlgebraicGeometry.IsOpenImmersion.mono hW₀.fromSpec
    have hcomm_inv : (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ D)) =
        CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ K)) := by
      apply (cancel_mono hW₀.fromSpec).mp
      change ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom) ≫
          AlgebraicGeometry.Spec.map (u_hom.appLE W₀ V₀ e)) ≫ hW₀.fromSpec =
        (CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X ≫
          AlgebraicGeometry.Spec.map (Y.left.presheaf.germ W₀ η hη_W₀)) ≫ hW₀.fromSpec
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, ← hV_fac, ← hη_fac]
      exact CategoryTheory.Limits.pullback.condition
    let L_inv : Z_η ⟶ CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ D)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ K))) :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom)
        (CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X)
        hcomm_inv
    let inv_Z : Z_η ⟶ AlgebraicGeometry.Spec (CommRingCat.of T) :=
      L_inv ≫ (AlgebraicGeometry.pullbackSpecIso A₀ D K).hom
    have h_hom_L : hom_Z ≫ L_inv = (AlgebraicGeometry.pullbackSpecIso A₀ D K).inv := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc hom_Z L_inv _).trans
          ((congrArg (hom_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc hom_Z _ hV₀.isoSpec.hom).symm.trans
              ((congrArg (· ≫ hV₀.isoSpec.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.assoc _ hV₀.isoSpec.inv hV₀.isoSpec.hom).trans
                  ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D) ≫ ·)
                    hV₀.isoSpec.inv_hom_id).trans
                    ((CategoryTheory.Category.comp_id _).trans
                      (AlgebraicGeometry.pullbackSpecIso_inv_fst A₀ D K).symm))))))
      · exact (CategoryTheory.Category.assoc hom_Z L_inv _).trans
          ((congrArg (hom_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              (AlgebraicGeometry.pullbackSpecIso_inv_snd A₀ D K).symm))
    have h_hom_inv : hom_Z ≫ inv_Z = 𝟙 _ :=
      (CategoryTheory.Category.assoc hom_Z L_inv _).symm.trans
        ((congrArg (· ≫ (AlgebraicGeometry.pullbackSpecIso A₀ D K).hom) h_hom_L).trans
          (AlgebraicGeometry.pullbackSpecIso A₀ D K).inv_hom_id)
    have h_inv_hom : inv_Z ≫ hom_Z = 𝟙 _ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have h_p1 : inv_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D) =
            CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ hV₀.isoSpec.hom :=
          (congrArg (inv_Z ≫ ·) (AlgebraicGeometry.pullbackSpecIso_inv_fst A₀ D K).symm).trans
            ((CategoryTheory.Category.assoc L_inv _ _).trans
              ((congrArg (L_inv ≫ ·)
                ((AlgebraicGeometry.pullbackSpecIso A₀ D K).hom_inv_id_assoc _)).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
        exact (CategoryTheory.Category.assoc inv_Z hom_Z _).trans
          ((congrArg (inv_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc inv_Z _ hV₀.isoSpec.inv).symm.trans
              ((congrArg (· ≫ hV₀.isoSpec.inv) h_p1).trans
                ((CategoryTheory.Category.assoc _ hV₀.isoSpec.hom hV₀.isoSpec.inv).trans
                  ((congrArg (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ ·)
                    hV₀.isoSpec.hom_inv_id).trans
                    ((CategoryTheory.Category.comp_id _).trans
                      (CategoryTheory.Category.id_comp _).symm))))))
      · have h_p2 : inv_Z ≫ p₂_T =
            CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) η_X :=
          (congrArg (inv_Z ≫ ·) (AlgebraicGeometry.pullbackSpecIso_inv_snd A₀ D K).symm).trans
            ((CategoryTheory.Category.assoc L_inv _ _).trans
              ((congrArg (L_inv ≫ ·)
                ((AlgebraicGeometry.pullbackSpecIso A₀ D K).hom_inv_id_assoc _)).trans
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
        exact (CategoryTheory.Category.assoc inv_Z hom_Z _).trans
          ((congrArg (inv_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            (h_p2.trans (CategoryTheory.Category.id_comp _).symm))
    let f_to_T : Z_η.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of T :=
      hom_Z.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom
    let f_from_T : CommRingCat.of T ⟶ Z_η.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).inv ≫ inv_Z.appTop
    have hf_lr : f_to_T ≫ f_from_T = 𝟙 _ := by
      dsimp [f_to_T, f_from_T]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, h_inv_hom,
        AlgebraicGeometry.Scheme.Hom.id_appTop]
    have hf_rl : f_from_T ≫ f_to_T = 𝟙 _ := by
      dsimp [f_to_T, f_from_T]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc inv_Z.appTop,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, h_hom_inv,
        AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
        CategoryTheory.Iso.inv_hom_id]
    have hbij : Function.Bijective f_to_T.hom :=
      ⟨fun x y hxy => by
          have h1 := ConcreteCategory.congr_hom hf_lr x
          have h2 := ConcreteCategory.congr_hom hf_lr y
          exact h1.symm.trans ((congrArg f_from_T.hom hxy).trans h2),
       fun t => ⟨f_from_T.hom t, ConcreteCategory.congr_hom hf_rl t⟩⟩
    let _ : IsDomain D := hDomD
    rcases hTensor_aux A₀ D K hInjφ with ⟨hInj_ιD, hsurj_T⟩
    have hr_fst : ∀ r : D,
        f_to_T.hom ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop.hom
          (V₀.topIso.inv.hom r)) = ι_D r := by
      intro r
      have hfst_app : (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop ≫
            hom_Z.appTop =
          hV₀.isoSpec.inv.appTop ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D)).appTop :=
        (AlgebraicGeometry.Scheme.Hom.comp_appTop hom_Z
          (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X)).symm.trans
          ((congrArg AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.Limits.pullback.lift_fst p₁_T p₂_T hcomm_T)).trans
            (AlgebraicGeometry.Scheme.Hom.comp_appTop
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_D)) hV₀.isoSpec.inv))
      have step1 : (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop ≫ f_to_T =
          (hV₀.isoSpec.inv.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (U_sch.presheaf.obj (Opposite.op V₀))).hom) ≫ CommRingCat.ofHom ι_D :=
        (CategoryTheory.Category.assoc _ hom_Z.appTop _).symm.trans
          ((congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom)
            hfst_app).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (hV₀.isoSpec.inv.appTop ≫ ·)
                (AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ι_D))).trans
                (CategoryTheory.Category.assoc _ _ _).symm)))
      have h1 : V₀.topIso.inv ≫
            ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop ≫ f_to_T) =
          CommRingCat.ofHom ι_D :=
        (congrArg (V₀.topIso.inv ≫ ·) step1).trans
          ((CategoryTheory.Category.assoc V₀.topIso.inv _ (CommRingCat.ofHom ι_D)).symm.trans
            ((congrArg (· ≫ CommRingCat.ofHom ι_D) (hAffine_topIso_cancel hV₀)).trans
              (CategoryTheory.Category.id_comp _)))
      exact ConcreteCategory.congr_hom h1 r
    exact ⟨f_to_T.hom, hbij, hInj_ιD, hr_fst, hsurj_T⟩

  have hInj_ι : ∀ U : Y.left.Etale, Function.Injective (ι_pre.app (Opposite.op U)).hom := by
    intro U u₁ u₂ hu_eq
    apply Additive.toMul.injective
    apply Units.ext
    have htop_eq : (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom
          (toGmUnit U u₁).val =
        (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom
          (toGmUnit U u₂).val :=
      congrArg (fun x => (toKUnit U x).val) hu_eq
    apply TopCat.Presheaf.section_ext U.left.sheaf ⊤
    intro u₀ hu₀_top
    obtain ⟨W₀, hW₀, V₀, hV₀, hu₀, e, hDomD, hInjφ, _⟩ := hChart U u₀
    obtain ⟨r_hom, _, hInj_ιD, hr_fst, _⟩ :=
      hChart_pullback U W₀ hW₀ V₀ hV₀ u₀ hu₀ e hDomD hInjφ
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : U_sch ⟶ Y.left := U.hom
    let m_V₀ : CategoryTheory.Limits.pullback (V₀.ι ≫ u_hom) η_X ⟶
        CategoryTheory.Limits.pullback u_hom η_X :=
      CategoryTheory.Limits.pullback.map (V₀.ι ≫ u_hom) η_X u_hom η_X
        V₀.ι (𝟙 S_K) (𝟙 Y.left) (CategoryTheory.Category.comp_id _) (by simp)
    have hm_fst : m_V₀ ≫ CategoryTheory.Limits.pullback.fst u_hom η_X =
        CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X ≫ V₀.ι :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hres_eq : ∀ s : ↑(U_sch.presheaf.obj (Opposite.op ⊤)),
        r_hom (m_V₀.appTop.hom ((CategoryTheory.Limits.pullback.fst u_hom η_X).appTop.hom s)) =
          (letI : Algebra ↑(Y.left.presheaf.obj (Opposite.op W₀))
              ↑(U_sch.presheaf.obj (Opposite.op V₀)) := (u_hom.appLE W₀ V₀ e).hom.toAlgebra
           letI : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨u_hom.base u₀, e hu₀⟩⟩
           (Algebra.TensorProduct.includeLeftRingHom :
              ↑(U_sch.presheaf.obj (Opposite.op V₀)) →+* _)
              ((U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom s)) := by
      intro s
      have h1 : m_V₀.appTop.hom ((CategoryTheory.Limits.pullback.fst u_hom η_X).appTop.hom s) =
          (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop.hom
            (V₀.ι.appTop.hom s) := by
        have hm_app : (CategoryTheory.Limits.pullback.fst u_hom η_X).appTop ≫ m_V₀.appTop =
            V₀.ι.appTop ≫ (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop :=
          (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _).symm.trans
            ((congrArg AlgebraicGeometry.Scheme.Hom.appTop hm_fst).trans
              (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _))
        exact ConcreteCategory.congr_hom hm_app s
      have h2 : V₀.ι.appTop.hom s =
          V₀.topIso.inv.hom
            ((U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom s) :=
        ConcreteCategory.congr_hom (hOpens_top_app V₀) s
      exact (congrArg r_hom h1).trans
        ((congrArg (fun z => r_hom
          ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) η_X).appTop.hom z)) h2).trans
          (hr_fst _))
    have hV₀_eq : (U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom
          (toGmUnit U u₁).val =
        (U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom
          (toGmUnit U u₂).val := by
      apply hInj_ιD
      have h_eq₁ := hres_eq (toGmUnit U u₁).val
      have h_eq₂ := hres_eq (toGmUnit U u₂).val
      exact h_eq₁.symm.trans ((congrArg (fun z => r_hom (m_V₀.appTop.hom z)) htop_eq).trans h_eq₂)
    have hgerm : ∀ s : ↑(U_sch.presheaf.obj (Opposite.op ⊤)),
        (U_sch.presheaf.germ ⊤ u₀ hu₀_top).hom s =
          (U_sch.presheaf.germ V₀ u₀ hu₀).hom
            ((U_sch.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom s) :=
      fun s => (ConcreteCategory.congr_hom
        (TopCat.Presheaf.germ_res U_sch.presheaf (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)) u₀ hu₀)
        s).symm
    exact (hgerm (toGmUnit U u₁).val).trans
      ((congrArg (U_sch.presheaf.germ V₀ u₀ hu₀).hom hV₀_eq).trans
        (hgerm (toGmUnit U u₂).val).symm)

  have hDivLoc : ∀ (U : Y.left.Etale)
      (s : ↥((weilEtaleKPresheaf Y.left).obj (Opposite.op U)))
      (u₀ : ↥U.left),
      ∃ V : U.left.Opens, u₀ ∈ V ∧
        { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) } |
          y.1 ∈ V ∧ div_val U s y ≠ 0 }.Finite := by
    intro U s u₀
    obtain ⟨W₀, hW₀, V₀, hV₀, hu₀, e, hDomD, hInjφ, _, _, _, hFinZero⟩ := hChart U u₀
    refine ⟨V₀, hu₀, ?_⟩
    obtain ⟨r_hom, hbij_r, _, hr_fst, hsurj_T⟩ :=
      hChart_pullback U W₀ hW₀ V₀ hV₀ u₀ hu₀ e hDomD hInjφ
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let D := ↑(U_sch.presheaf.obj (Opposite.op V₀))
    let W_V₀ : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (V₀.ι ≫ U.hom)
      (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
    let j_V₀ : W_V₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk V₀.ι rfl trivial
    let s₀ := ((weilEtaleKPresheaf Y.left).map j_V₀.op).hom s
    let e_T := RingEquiv.ofBijective r_hom hbij_r
    let u_T : Units _ := Units.map e_T.toRingHom.toMonoidHom (toKUnit W_V₀ s₀)
    obtain ⟨c, d, hc, hd, _, hcd_T⟩ := hsurj_T u_T
    let R_Z := ↑((CategoryTheory.Limits.pullback (V₀.ι ≫ U.hom) η_X).presheaf.obj (Opposite.op ⊤))
    let z_s₀ : R_Z := (toKUnit W_V₀ s₀).val
    let fst_Z : ↑((V₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) →+* R_Z :=
      (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ U.hom) η_X).appTop.hom
    have hcd_Z : z_s₀ * fst_Z (V₀.topIso.inv.hom d) = fst_Z (V₀.topIso.inv.hom c) := by
      apply hbij_r.1
      exact (r_hom.map_mul z_s₀ _).trans
        ((congrArg (r_hom z_s₀ * ·) (hr_fst d)).trans (hcd_T.trans (hr_fst c).symm))
    refine (hFinZero (c * d) (mul_ne_zero hc hd)).subset ?_
    rintro y ⟨hy, hne⟩
    refine ⟨hy, ?_⟩
    let y' : { y' : ↥W_V₀.left // IsClosed ({W_V₀.hom.base y'} : Set ↥Y.left) } :=
      ⟨⟨y.1, hy⟩, y.2⟩
    have hne' : div_val W_V₀ s₀ y' ≠ 0 := by
      have hnat := hDivNat j_V₀ s y'
      rwa [hnat]
    let Ry' := ↑(W_V₀.left.presheaf.stalk y'.1)
    let _ : IsDomain Ry' := (hDVR_et W_V₀ y').choose
    let _ : IsDiscreteValuationRing Ry' := (hDVR_et W_V₀ y').choose_spec
    let _ : IsDomain ↑(U_sch.presheaf.stalk y.1) := (hDVR_et U y).choose
    have : IsLocalization.AtPrime ↑(U_sch.presheaf.stalk (⟨y.1, hy⟩ : ↥V₀).1)
        (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal :=
      hV₀.isLocalization_stalk ⟨y.1, hy⟩
    have hle_nzd : (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal.primeCompl ≤ nonZeroDivisors D :=
      le_nonZeroDivisors_of_noZeroDivisors
        (fun h0 => h0 (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal.zero_mem)
    have hInj_germ : Function.Injective (U_sch.presheaf.germ V₀ y.1 hy).hom :=
      IsLocalization.injective ↑(U_sch.presheaf.stalk (⟨y.1, hy⟩ : ↥V₀).1) hle_nzd
    let e_st : Ry' ≃+* ↑(U_sch.presheaf.stalk y.1) :=
      (V₀.stalkIso ⟨y.1, hy⟩).commRingCatIsoToRingEquiv
    have hgerm_rel : ∀ r : D,
        e_st ((W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom r)) =
          (U_sch.presheaf.germ V₀ y.1 hy).hom r :=
      fun r => hOpens_germ_topIso V₀ y.1 hy r
    let c' : Ry' := (W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom c)
    let d' : Ry' := (W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom d)
    have hc'_ne : c' ≠ 0 := fun h0 => hc (hInj_germ
      (((hgerm_rel c).symm.trans ((congrArg e_st h0).trans (map_zero e_st))).trans
        (map_zero (U_sch.presheaf.germ V₀ y.1 hy).hom).symm))
    have hd'_ne : d' ≠ 0 := fun h0 => hd (hInj_germ
      (((hgerm_rel d).symm.trans ((congrArg e_st h0).trans (map_zero e_st))).trans
        (map_zero (U_sch.presheaf.germ V₀ y.1 hy).hom).symm))
    have hev_cd : (Units.map (ev_Uy W_V₀ y').toMonoidHom (toKUnit W_V₀ s₀)).val *
          algebraMap Ry' (FractionRing Ry') d' =
        algebraMap Ry' (FractionRing Ry') c' := by
      have h := congrArg (ev_Uy W_V₀ y') hcd_Z
      exact ((congrArg ((ev_Uy W_V₀ y') z_s₀ * ·) (hev_fst W_V₀ y' (V₀.topIso.inv.hom d))).symm.trans
        (((ev_Uy W_V₀ y').map_mul z_s₀ _).symm.trans
          (h.trans (hev_fst W_V₀ y' (V₀.topIso.inv.hom c)))))
    have hmem' : c' * d' ∈ IsLocalRing.maximalIdeal Ry' :=
      hordDVR_nonzero_mem Ry' _ c' d' hc'_ne hd'_ne hev_cd hne'
    have hnu' : ¬ IsUnit (c' * d') :=
      fun hu => IsLocalRing.notMem_maximalIdeal.mpr hu hmem'
    have hnu : ¬ IsUnit ((U_sch.presheaf.germ V₀ y.1 hy).hom (c * d)) := by
      intro hu_cd
      apply hnu'
      have heq : e_st (c' * d') = (U_sch.presheaf.germ V₀ y.1 hy).hom (c * d) :=
        (e_st.map_mul c' d').trans
          ((congrArg₂ (· * ·) (hgerm_rel c) (hgerm_rel d)).trans
            ((U_sch.presheaf.germ V₀ y.1 hy).hom.map_mul c d).symm)
      have hu_map : IsUnit (e_st.symm ((U_sch.presheaf.germ V₀ y.1 hy).hom (c * d))) :=
        e_st.symm.toRingHom.isUnit_map hu_cd
      have hsymm_eq : e_st.symm ((U_sch.presheaf.germ V₀ y.1 hy).hom (c * d)) = c' * d' :=
        (congrArg e_st.symm heq.symm).trans (e_st.symm_apply_apply (c' * d'))
      exact hsymm_eq ▸ hu_map
    exact Classical.byContradiction fun hnot => hnu (IsLocalRing.notMem_maximalIdeal.mp hnot)

  
  have hChart_mid_exact : ∀ (U : Y.left.Etale)
      (s : ↥((weilEtaleKPresheaf Y.left).obj (Opposite.op U))),
      div_val U s = 0 →
      ∀ u₀ : ↥U.left,
        ∃ (V₀ : U.left.Opens) (_ : u₀ ∈ V₀),
          let W_V₀ : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (V₀.ι ≫ U.hom)
            (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
          let j_V₀ : W_V₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk V₀.ι rfl trivial
          ((weilEtaleKPresheaf Y.left).map j_V₀.op).hom s ∈
            Set.range (ι_pre.app (Opposite.op W_V₀)).hom := by
    intro U s hs0 u₀
    obtain ⟨W₀, hW₀, V₀, hV₀, hu₀, e, hDomD, hInjφ, _, hMaxCl, _, _⟩ := hChart U u₀
    refine ⟨V₀, hu₀, ?_⟩
    obtain ⟨r_hom, hbij_r, hInj_ιD, hr_fst, hsurj_T⟩ :=
      hChart_pullback U W₀ hW₀ V₀ hV₀ u₀ hu₀ e hDomD hInjφ
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let D := ↑(U_sch.presheaf.obj (Opposite.op V₀))
    have : IsDomain D := hDomD
    let W_V₀ : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (V₀.ι ≫ U.hom)
      (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
    let j_V₀ : W_V₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk V₀.ι rfl trivial
    let e_T := RingEquiv.ofBijective r_hom hbij_r
    let R_Z := ↑((CategoryTheory.Limits.pullback (V₀.ι ≫ U.hom) η_X).presheaf.obj (Opposite.op ⊤))
    let fst_Z : ↑((V₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) →+* R_Z :=
      (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ U.hom) η_X).appTop.hom
    have hlift_nonneg : ∀ (s' : ↥((weilEtaleKPresheaf Y.left).obj (Opposite.op W_V₀))),
        (∀ y' : { y' : ↥W_V₀.left // IsClosed ({W_V₀.hom.base y'} : Set ↥Y.left) },
          0 ≤ div_val W_V₀ s' y') →
        ∃ q₁ : D, (toKUnit W_V₀ s').val = fst_Z (V₀.topIso.inv.hom q₁) := by
      intro s' hnonneg
      let u_T : Units _ := Units.map e_T.toRingHom.toMonoidHom (toKUnit W_V₀ s')
      obtain ⟨c, b, hc, hb, hu_b, hcb_T⟩ := hsurj_T u_T
      let z_s' : R_Z := (toKUnit W_V₀ s').val
      have hcb_Z : z_s' * fst_Z (V₀.topIso.inv.hom b) = fst_Z (V₀.topIso.inv.hom c) := by
        apply hbij_r.1
        exact (r_hom.map_mul z_s' _).trans
          ((congrArg (r_hom z_s' * ·) (hr_fst b)).trans (hcb_T.trans (hr_fst c).symm))
      have hdiv_stalk : ∀ (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥Y.left) })
          (hy : y.1 ∈ V₀),
          ∃ z : ↑(U_sch.presheaf.stalk y.1),
            (U_sch.presheaf.germ V₀ y.1 hy).hom c =
              z * (U_sch.presheaf.germ V₀ y.1 hy).hom b := by
        intro y hy
        let y' : { y' : ↥W_V₀.left // IsClosed ({W_V₀.hom.base y'} : Set ↥Y.left) } :=
          ⟨⟨y.1, hy⟩, y.2⟩
        let Ry' := ↑(W_V₀.left.presheaf.stalk y'.1)
        let _ : IsDomain Ry' := (hDVR_et W_V₀ y').choose
        let _ : IsDiscreteValuationRing Ry' := (hDVR_et W_V₀ y').choose_spec
        let _ : IsDomain ↑(U_sch.presheaf.stalk y.1) := (hDVR_et U y).choose
        have : IsLocalization.AtPrime ↑(U_sch.presheaf.stalk (⟨y.1, hy⟩ : ↥V₀).1)
            (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal :=
          hV₀.isLocalization_stalk ⟨y.1, hy⟩
        have hle_nzd : (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal.primeCompl ≤ nonZeroDivisors D :=
