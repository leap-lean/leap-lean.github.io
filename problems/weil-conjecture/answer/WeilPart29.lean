    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_Ω hSE z₃ (Nat.zero_add 1) hz₃_zero

  have hMap_SE : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u})),
      SC.ShortExact → (SC.map pf_σ).ShortExact := by
    intro SC hSE
    have hSurj_TΩ : Function.Surjective ((SC.g.hom.app (Opposite.op T_Ω)).hom) := by
      intro q₀
      let γ_q₀ : A_ℤ ⟶ SC.X₃.obj.obj (Opposite.op T_Ω) := AddCommGrpCat.ofHom
        { toFun := fun n => n.down • q₀
          map_zero' := zero_zsmul q₀
