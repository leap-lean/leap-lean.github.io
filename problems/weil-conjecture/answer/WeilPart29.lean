    have hLoc_poly_RU₀ :
        @IsLocalization (Polynomial k) _ (Submonoid.powers (Polynomial.X : Polynomial k))
          R_U₀ _ alg_poly_RU₀ := by
      refine ⟨⟨?_, ?_, ?_⟩⟩
      · rintro ⟨_, n, rfl⟩
        change IsUnit (U₀.ι.appTop.hom (e_A₁ (Polynomial.X ^ n)))
        rw [map_pow, he_A₁_X, map_pow, ← hu_X₀_val]
