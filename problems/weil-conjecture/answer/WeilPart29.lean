  obtain ⟨e_R2_R1⟩ := (hCalc3 S₀ hS₀ hI₀_acyc).2.1 1 le_rfl
  let e_R1_R2 : weilEtaleHigherDirectImage f 1 Q₁ ≅ weilEtaleHigherDirectImage f 2 F_E :=
    e_R2_R1.symm
  have hQ₂_acyc : ∀ q : ℕ, 1 ≤ q →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q Q₂) :=
    fun q hq =>
      (hCalc3 S₁ hS₁ hI₁_acyc).2.2 q hq
        ((hCalc3 S₀ hS₀ hI₀_acyc).2.2 (q + 1) (by omega) (hR_FE_ge3 q hq))
  obtain ⟨δ_B1, hcomp_δ, _, hEx_δ⟩ := (hCalc3 S₁ hS₁ hI₁_acyc).1.1

  
  let adj_E := CategoryTheory.constantSheafAdj E.smallEtaleTopology AddCommGrpCat.{u} hT_E
  let adj_B := CategoryTheory.constantSheafAdj B.left.smallEtaleTopology AddCommGrpCat.{u} hT_B
  let τ_f : (weilEtaleSitePullback f).obj T_B ⟶ T_E :=
