  have h_constAdj_eval : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {T : S.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (g : (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶ G)
