      rfl
    | succ n' ih =>
      intro A B x
      let I := CategoryTheory.Injective.under B
      let ι : B ⟶ I := CategoryTheory.Injective.ι B
      let S := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hSub : Subsingleton (CategoryTheory.Abelian.Ext.{u} A I (n' + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton I 1 (n' + 1)
          (Nat.succ_le_succ (Nat.zero_le n')) A
      have h0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (n' + 1)) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨δ, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS x h0 rfl
      have hSF : (S.map F).ShortExact := hS.map_of_exact F
      have hSFG₁ : ((S.map F).map G).ShortExact := hSF.map_of_exact G
      have hSFG₂ : (S.map (F.comp G)).ShortExact := hS.map_of_exact (F.comp G)
      let φ_FG : (S.map F).map G ⟶ S.map (F.comp G) :=
        { τ₁ := 𝟙 (G.obj (F.obj S.X₁))
          τ₂ := 𝟙 (G.obj (F.obj S.X₂))
          τ₃ := 𝟙 (G.obj (F.obj S.X₃)) }
      have hExtEq : hSFG₁.extClass = hSFG₂.extClass := by
        have h1 := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSFG₁ hSFG₂ φ_FG
        simpa [φ_FG, CategoryTheory.Abelian.Ext.comp_mk₀_id,
          CategoryTheory.Abelian.Ext.mk₀_id_comp] using h1
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (F.comp G) hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hSF,
        ih A S.X₃ δ, hExtEq]

  
  
  
  have hTermUnit : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      (J : CategoryTheory.GrothendieckTopology 𝒞)
      {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
      [CategoryTheory.HasWeakSheafify J 𝒟]
      {T₁ T₂ : 𝒞} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (A : 𝒟),
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj J 𝒟 hT₁).unit.app A)
        (((CategoryTheory.constantSheaf J 𝒟).obj A).obj.map (hT₁.from T₂).op) =
        (CategoryTheory.constantSheafAdj J 𝒟 hT₂).unit.app A := by
    intro 𝒞 _ J 𝒟 _ _ T₁ T₂ hT₁ hT₂ A
    have hu : ∀ {T : 𝒞} (hT : CategoryTheory.Limits.IsTerminal T),
        (CategoryTheory.constantSheafAdj J 𝒟 hT).unit.app A =
          ((CategoryTheory.sheafificationAdjunction J 𝒟).unit.app
            ((CategoryTheory.Functor.const 𝒞ᵒᵖ).obj A)).app (Opposite.op T) := by
      intro T hT
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.Category.id_comp]
      rfl
    rw [hu hT₁, hu hT₂]
    have hnat := (((CategoryTheory.sheafificationAdjunction J 𝒟).unit.app
      ((CategoryTheory.Functor.const 𝒞ᵒᵖ).obj A)).naturality (hT₁.from T₂).op).symm
    simpa [CategoryTheory.constantSheaf] using hnat

  have hTermSymm : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      (J : CategoryTheory.GrothendieckTopology 𝒞)
      {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
      [CategoryTheory.HasWeakSheafify J 𝒟]
      {T₁ T₂ : 𝒞} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (A : 𝒟)
      (ℱ : CategoryTheory.Sheaf J 𝒟)
      (g₁ : Quiver.Hom A (ℱ.obj.obj (Opposite.op T₁))),
      ((CategoryTheory.constantSheafAdj J 𝒟 hT₁).homEquiv A ℱ).symm g₁ =
      ((CategoryTheory.constantSheafAdj J 𝒟 hT₂).homEquiv A ℱ).symm
        (CategoryTheory.CategoryStruct.comp g₁ (ℱ.obj.map (hT₁.from T₂).op)) := by
    intro 𝒞 _ J 𝒟 _ _ T₁ T₂ hT₁ hT₂ A ℱ g₁
    let adj₁ := CategoryTheory.constantSheafAdj J 𝒟 hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J 𝒟 hT₂
    let φ := (adj₁.homEquiv A ℱ).symm g₁
    apply (adj₂.homEquiv A ℱ).injective
    rw [Equiv.apply_symm_apply]
    have hg₁ : adj₁.homEquiv A ℱ φ = g₁ := Equiv.apply_symm_apply _ g₁
    have h1 : adj₁.homEquiv A ℱ φ =
        CategoryTheory.CategoryStruct.comp (adj₁.unit.app A) (φ.hom.app (Opposite.op T₁)) :=
      CategoryTheory.Adjunction.homEquiv_unit adj₁ A ℱ φ
    have h2 : adj₂.homEquiv A ℱ φ =
        CategoryTheory.CategoryStruct.comp (adj₂.unit.app A) (φ.hom.app (Opposite.op T₂)) :=
      CategoryTheory.Adjunction.homEquiv_unit adj₂ A ℱ φ
    rw [h2, ← hTermUnit J hT₁ hT₂ A, CategoryTheory.Category.assoc]
    have hnat : CategoryTheory.CategoryStruct.comp
        (((CategoryTheory.constantSheaf J 𝒟).obj A).obj.map (hT₁.from T₂).op)
        (φ.hom.app (Opposite.op T₂)) =
        CategoryTheory.CategoryStruct.comp
          (φ.hom.app (Opposite.op T₁)) (ℱ.obj.map (hT₁.from T₂).op) :=
      φ.hom.naturality (hT₁.from T₂).op
    rw [hnat, ← CategoryTheory.Category.assoc, ← h1, hg₁]

  have hTermPushMate : ∀ {𝒞₁ 𝒞₂ : Type (u + 1)}
      [CategoryTheory.Category.{u, u + 1} 𝒞₁] [CategoryTheory.Category.{u, u + 1} 𝒞₂]
      (J₁ : CategoryTheory.GrothendieckTopology 𝒞₁)
      (J₂ : CategoryTheory.GrothendieckTopology 𝒞₂)
      {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
      [CategoryTheory.HasWeakSheafify J₁ 𝒟] [CategoryTheory.HasWeakSheafify J₂ 𝒟]
      (B : CategoryTheory.Functor 𝒞₂ 𝒞₁) [B.IsContinuous J₂ J₁]
      {T₁₁ T₁₂ : 𝒞₁} (hT₁₁ : CategoryTheory.Limits.IsTerminal T₁₁)
      (hT₁₂ : CategoryTheory.Limits.IsTerminal T₁₂)
      {T₂₁ T₂₂ : 𝒞₂} (hT₂₁ : CategoryTheory.Limits.IsTerminal T₂₁)
      (hT₂₂ : CategoryTheory.Limits.IsTerminal T₂₂) (A : 𝒟),
      let P_push := B.sheafPushforwardContinuous 𝒟 J₂ J₁
      let One₁ := (CategoryTheory.constantSheaf J₁ 𝒟).obj A
      let adj₁₁ := CategoryTheory.constantSheafAdj J₁ 𝒟 hT₁₁
      let adj₁₂ := CategoryTheory.constantSheafAdj J₁ 𝒟 hT₁₂
      let adj₂₁ := CategoryTheory.constantSheafAdj J₂ 𝒟 hT₂₁
      let adj₂₂ := CategoryTheory.constantSheafAdj J₂ 𝒟 hT₂₂
      (adj₂₁.homEquiv A (P_push.obj One₁)).symm
        (CategoryTheory.CategoryStruct.comp (adj₁₁.unit.app A)
          (One₁.obj.map (hT₁₁.from (B.obj T₂₁)).op)) =
      (adj₂₂.homEquiv A (P_push.obj One₁)).symm
        (CategoryTheory.CategoryStruct.comp (adj₁₂.unit.app A)
          (One₁.obj.map (hT₁₂.from (B.obj T₂₂)).op)) := by
    intro 𝒞₁ 𝒞₂ _ _ J₁ J₂ 𝒟 _ _ _ B _ T₁₁ T₁₂ hT₁₁ hT₁₂ T₂₁ T₂₂ hT₂₁ hT₂₂ A
    dsimp only
    rw [hTermSymm J₂ hT₂₁ hT₂₂ A]
    congr 1
    rw [← hTermUnit J₁ hT₁₁ hT₁₂ A]
    change CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheafAdj J₁ 𝒟 hT₁₁).unit.app A)
          (((CategoryTheory.constantSheaf J₁ 𝒟).obj A).obj.map (hT₁₁.from (B.obj T₂₁)).op))
        (((CategoryTheory.constantSheaf J₁ 𝒟).obj A).obj.map (B.map (hT₂₁.from T₂₂)).op) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheafAdj J₁ 𝒟 hT₁₁).unit.app A)
          (((CategoryTheory.constantSheaf J₁ 𝒟).obj A).obj.map (hT₁₁.from T₁₂).op))
        (((CategoryTheory.constantSheaf J₁ 𝒟).obj A).obj.map (hT₁₂.from (B.obj T₂₂)).op)
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp,
      ← op_comp, ← op_comp]
    have h_hom : CategoryTheory.CategoryStruct.comp (B.map (hT₂₁.from T₂₂))
        (hT₁₁.from (B.obj T₂₁)) =
        CategoryTheory.CategoryStruct.comp (hT₁₂.from (B.obj T₂₂)) (hT₁₁.from T₁₂) :=
      hT₁₁.hom_ext _ _
    rw [h_hom]

  have hT_of : ∀ W : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Limits.IsTerminal (weilCupPDTraceTerminalObj W) := fun W =>
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom))
      (fun U g => by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g))

  let R := ULift.{u, 0} (ZMod m)
  let R_mod := ModuleCat.of R R
  let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let ιM : Quiver.Hom AM (F_fg.obj R_mod) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let z_to_m : Quiver.Hom Aℤ AM :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  let ιℤ_cmp : Quiver.Hom Aℤ (F_fg.obj R_mod) :=
    CategoryTheory.CategoryStruct.comp
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        Quiver.Hom Aℤ (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)))
      (CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))))
        ιM)
  have h_z_ιM : CategoryTheory.CategoryStruct.comp z_to_m ιM = ιℤ_cmp :=
    AddCommGrpCat.hom_ext (AddMonoidHom.ext fun _ => rfl)

  have h_heq_comp_eqToHom : ∀ {X Y Y' : AddCommGrpCat.{u}}
      (f : Quiver.Hom X Y) (h : Y = Y'),
      HEq (CategoryTheory.CategoryStruct.comp f (CategoryTheory.eqToHom h)) f := by
    intro X Y Y' f h
    subst h
    simp

  have h_heq_nat : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      {P₁ P₂ : CategoryTheory.Functor (W.Etale)ᵒᵖ AddCommGrpCat.{u}} (hP : P₁ = P₂)
      {X : AddCommGrpCat.{u}} {V₀ V₁ : (W.Etale)ᵒᵖ} (f : Quiver.Hom V₀ V₁)
      (g₀ : Quiver.Hom X (P₂.obj V₀))
      (g₁ : Quiver.Hom X (P₁.obj V₁))
      (g₁' : Quiver.Hom X (P₂.obj V₁)),
      HEq g₁ g₁' →
      CategoryTheory.CategoryStruct.comp g₀ (P₂.map f) = g₁' →
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp g₀
          (CategoryTheory.eqToHom (congrArg (fun P => P.obj V₀) hP.symm)))
        (P₁.map f) = g₁ := by
    intro W P₁ P₂ hP X V₀ V₁ f g₀ g₁ g₁' hg₁ hcomm
    subst hP
    cases hg₁
    simpa using hcomm

  have hAlignWit : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (U : CategoryTheory.Functor
        (CategoryTheory.Sheaf W.smallEtaleTopology (ModuleCat.{u, u} R))
        (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}))
      (hU_obj : ∀ ℱ : CategoryTheory.Sheaf W.smallEtaleTopology (ModuleCat.{u, u} R),
        (U.obj ℱ).obj = CategoryTheory.Functor.comp ℱ.obj F_fg)
      (hU_map : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf W.smallEtaleTopology (ModuleCat.{u, u} R)}
        (u : Quiver.Hom ℱ₁ ℱ₂) (V : (W.Etale)ᵒᵖ),
        HEq ((U.map u).hom.app V) (F_fg.map (u.hom.app V)))
      (hAdd : U.Additive)
      (hLim : CategoryTheory.Limits.PreservesFiniteLimits U)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits U)
      (T : W.Etale) (hT : CategoryTheory.Limits.IsTerminal T)
      (u_unit : Quiver.Hom (F_fg.obj R_mod)
        ((U.obj (weilEtaleModuleUnit W m)).obj.obj (Opposite.op T)))
      (hu_unit : HEq u_unit
        (F_fg.map ((CategoryTheory.constantSheafAdj W.smallEtaleTopology
          (ModuleCat.{u, u} R) hT).unit.app R_mod)))
      (πM : Quiver.Hom (U.obj (weilEtaleModuleUnit W m)) (weilEtaleTorsionSheaf W m))
      (hαπ : CategoryTheory.CategoryStruct.comp
        (((CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT).homEquiv
          AM (U.obj (weilEtaleModuleUnit W m))).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit))
        πM = CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf W m))
      (hπα : CategoryTheory.CategoryStruct.comp πM
        (((CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT).homEquiv
          AM (U.obj (weilEtaleModuleUnit W m))).symm
            (CategoryTheory.CategoryStruct.comp ιM u_unit)) =
        CategoryTheory.CategoryStruct.id (U.obj (weilEtaleModuleUnit W m)))
      (k : ℕ) (θ_Wk : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k)
      (hθ_Wk : WeilIsModuleToTorsionComparison W m k θ_Wk)
      (γ : weilEtaleModuleH W m k),
      letI := hAdd; letI := hLim; letI := hColim
      let C_ab := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
      let Fℤ := C_ab.obj Aℤ
      let One_W := weilEtaleModuleUnit W m
      let adj_ab_T := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT
      let αM_T := (adj_ab_T.homEquiv AM (U.obj One_W)).symm
        (CategoryTheory.CategoryStruct.comp ιM u_unit)
      let ιℤ_T := CategoryTheory.CategoryStruct.comp (C_ab.map z_to_m) αM_T
      (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_T).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U hAdd hLim hColim _ _
            One_W One_W k) γ)
          (Nat.zero_add k)) = θ_Wk γ := by
    intro W U hU_obj hU_map hAdd hLim hColim T hT u_unit hu_unit πM hαπ hπα k θ_Wk hθ_Wk γ
    letI := hAdd; letI := hLim; letI := hColim
    let J_W := W.smallEtaleTopology
    let C_ab := CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}
    let Fℤ := C_ab.obj Aℤ
    let One_W := weilEtaleModuleUnit W m
    let T₀ := weilCupPDTraceTerminalObj W
    have hT₀ : CategoryTheory.Limits.IsTerminal T₀ := hT_of W
    let adj_ab_T := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT
    let adj_mod_T := CategoryTheory.constantSheafAdj J_W (ModuleCat.{u, u} R) hT
    let adj_ab_0 := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT₀
    let adj_mod_0 := CategoryTheory.constantSheafAdj J_W (ModuleCat.{u, u} R) hT₀
    have hP_eq : (U.obj One_W).obj = CategoryTheory.Functor.comp One_W.obj F_fg := hU_obj One_W
    let u_unit₀ : Quiver.Hom (F_fg.obj R_mod) ((U.obj One_W).obj.obj (Opposite.op T₀)) :=
      CategoryTheory.CategoryStruct.comp (F_fg.map (adj_mod_0.unit.app R_mod))
        (CategoryTheory.eqToHom (congrArg (fun P => P.obj (Opposite.op T₀)) hP_eq.symm))
    have hu_unit₀ : HEq u_unit₀ (F_fg.map (adj_mod_0.unit.app R_mod)) :=
      h_heq_comp_eqToHom _ _
    have hu_trans : CategoryTheory.CategoryStruct.comp u_unit₀
        ((U.obj One_W).obj.map (hT₀.from T).op) = u_unit := by
      apply h_heq_nat hP_eq (hT₀.from T).op (F_fg.map (adj_mod_0.unit.app R_mod))
        u_unit (F_fg.map (adj_mod_T.unit.app R_mod)) hu_unit
      change CategoryTheory.CategoryStruct.comp (F_fg.map (adj_mod_0.unit.app R_mod))
        (F_fg.map (One_W.obj.map (hT₀.from T).op)) = F_fg.map (adj_mod_T.unit.app R_mod)
      rw [← F_fg.map_comp, hTermUnit J_W hT₀ hT R_mod]
    let αM_T := (adj_ab_T.homEquiv AM (U.obj One_W)).symm
      (CategoryTheory.CategoryStruct.comp ιM u_unit)
    let αM_0 := (adj_ab_0.homEquiv AM (U.obj One_W)).symm
      (CategoryTheory.CategoryStruct.comp ιM u_unit₀)
    have hαM_eq : αM_0 = αM_T := by
      dsimp only [αM_0, αM_T]
      rw [hTermSymm J_W hT₀ hT AM (U.obj One_W), CategoryTheory.Category.assoc, hu_trans]
    let ηℤ_0 : Quiver.Hom Fℤ (U.obj One_W) :=
      (adj_ab_0.homEquiv Aℤ (U.obj One_W)).symm
        (CategoryTheory.CategoryStruct.comp ιℤ_cmp u_unit₀)
    have hηℤ_eq : ηℤ_0 = CategoryTheory.CategoryStruct.comp (C_ab.map z_to_m) αM_0 := by
      apply (adj_ab_0.homEquiv Aℤ (U.obj One_W)).injective
      rw [Equiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_left adj_ab_0 z_to_m αM_0,
        Equiv.apply_symm_apply]
      change CategoryTheory.CategoryStruct.comp ιℤ_cmp u_unit₀ =
        CategoryTheory.CategoryStruct.comp z_to_m
          (CategoryTheory.CategoryStruct.comp ιM u_unit₀)
      rw [← h_z_ιM, CategoryTheory.Category.assoc]
    let θ_wit : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k :=
      ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ηℤ_0).precomp (U.obj One_W) (Nat.zero_add k)).comp
          (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U hAdd hLim hColim _ _
            One_W One_W k))
    have h_is_cmp : WeilIsModuleToTorsionComparison W m k θ_wit := by
      refine ⟨U, hU_obj, @hU_map, hAdd, hLim, hColim, T₀, hT₀, rfl, HEq.rfl,
        u_unit₀, hu_unit₀, πM, ?_, ?_, fun _ => rfl⟩
      · change CategoryTheory.CategoryStruct.comp αM_0 πM = _
        rw [hαM_eq]
        exact hαπ
      · change CategoryTheory.CategoryStruct.comp πM αM_0 = _
        rw [hαM_eq]
        exact hπα
    have hθ_eq : θ_wit = θ_Wk := (hModCmp W k).2 θ_wit θ_Wk h_is_cmp hθ_Wk
    rw [← hθ_eq]
    change _ = (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)
      ((CategoryTheory.Abelian.Ext.mk₀ ηℤ_0).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U hAdd hLim hColim _ _
          One_W One_W k) γ)
        (Nat.zero_add k))
    rw [hηℤ_eq, hαM_eq]

  
