      apply CategoryTheory.Limits.biprod.hom_ext'
      · dsimp only [τ₂, π_MV_sh]
        rw [CategoryTheory.Limits.biprod.inl_desc_assoc,
          CategoryTheory.Limits.biprod.inl_desc_assoc]
        apply (evalEq X U₁ Q).injective
        rw [eval_post, eval_post, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        exact hfq₁.symm
