        have _hY_et : AlgebraicGeometry.Etale Y.hom := Y.prop
        let fst_pb := CategoryTheory.Limits.pullback.fst f.left (f_x x).left
        let snd_pb := CategoryTheory.Limits.pullback.snd f.left (f_x x).left
        let W_pb : S.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_pb ≫ Y.hom) inferInstance
        let p₁ : W_pb ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk fst_pb rfl trivial
        let p₂ : W_pb ⟶ Y_x x :=
          CategoryTheory.MorphismProperty.Over.homMk snd_pb
            (by
              change snd_pb ≫ (Y_x x).hom = fst_pb ≫ Y.hom
              rw [← CategoryTheory.MorphismProperty.Over.w (f_x x),
                  ← CategoryTheory.Category.assoc,
                  ← CategoryTheory.Limits.pullback.condition,
                  CategoryTheory.Category.assoc,
                  CategoryTheory.MorphismProperty.Over.w f])
            trivial
        have hp_comm : p₁ ≫ f = p₂ ≫ f_x x :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        have hcomp_eq : LocallyConstant.mk (fun w : ↥W_pb.left => evalFam f hf (fst_pb w)) _ =
            LocallyConstant.mk (fun w : ↥W_pb.left => evalFam (f_x x) (hf_R x) (snd_pb w)) _ :=
          hs_compat p₁ p₂ hf (hf_R x) hp_comm
        have hval : evalFam f hf (fst_pb z) = evalFam (f_x x) (hf_R x) (snd_pb z) :=
          congrArg (fun (k : LocallyConstant ↥W_pb.left (ULift.{u} (ZMod n))) => k z) hcomp_eq
        rw [hz₁, hz₂] at hval
        exact hval
      have hg₀_lc : IsLocallyConstant g₀ := by
        intro t
        rw [isOpen_iff_forall_mem_open]
        intro x hx
