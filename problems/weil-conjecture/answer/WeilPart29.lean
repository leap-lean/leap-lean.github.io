      have hFrom_U : hU_top.fromSpec = AlgebraicGeometry.Spec.map α₀ := by
        dsimp only [hU_top, α₀]
        rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top, AlgebraicGeometry.Scheme.isoSpec_Spec_inv]
      have hFrom_V :
