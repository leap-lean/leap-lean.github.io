  let S₁ := CategoryTheory.ShortComplex.mk j₁ p₁ h₁

  have hR_FE_ge3 : ∀ q : ℕ, 1 ≤ q →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f (q + 2) F_E) := by
    intro q hq
