    rw [hSub_K.elim pt (IsLocalRing.closedPoint K)]
    change p_C.base (η_C.base (IsLocalRing.closedPoint K)) = x_P
    rw [AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint]
    exact hpC_gen

  let ψ_cat : K₀_cat ⟶ K_cat :=
    P.left.presheaf.stalkSpecializes (specializes_of_eq hpC_gen) ≫ p_C.stalkMap x_C
  let ψ_K : K₀ →+* K := ψ_cat.hom

  have hpC_germ : ∀ (W : P.left.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})],
