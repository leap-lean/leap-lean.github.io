        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (F₁ ⋙ F₂) hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₁ hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₂ (hS.map_of_exact F₁), ih δ, hEq]

