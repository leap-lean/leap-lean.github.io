        trivial
      obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hy
      exact ⟨n • one_s, map_zsmul φ_s n one_s⟩
    let eG : (pb_s.obj (weilEtaleHigherDirectImage f 1 Q₁)).H 0 ≃ (pb_s.obj F_B).H 0 :=
      Fintype.equivOfCardEq (by
        rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card, hCard_cod, hCard_dom])
    have hbij : Function.Bijective (eG ∘ φ_s) :=
      Finite.surjective_iff_bijective.mp (eG.surjective.comp hsurj)
    have hcomp_fn : (φ_s : (pb_s.obj F_B).H 0 → _) = eG.symm ∘ (eG ∘ φ_s) := by
      funext a
      simp
    change Function.Bijective φ_s
    rw [hcomp_fn]
    exact eG.symm.bijective.comp hbij

  
  letI : CategoryTheory.IsIso ψ_ω := hIso_ψ
  let ρ_split : pf_f.obj Q₂ ⟶ F_B := δ_B1 ≫ CategoryTheory.inv ψ_ω
  have h_retract : α_split ≫ ρ_split = CategoryTheory.CategoryStruct.id F_B := by
    change α_split ≫ (δ_B1 ≫ CategoryTheory.inv ψ_ω) = 𝟙 F_B
    rw [← CategoryTheory.Category.assoc]
    exact CategoryTheory.IsIso.hom_inv_id ψ_ω

  let y_B : (pf_f.obj Q₂).H (2 * c) :=
    x_B.comp (CategoryTheory.Abelian.Ext.mk₀ α_split) (Nat.add_zero (2 * c))
  have hy_B : y_B ≠ 0 := by
    intro hy0
    apply hx_B
    have h_back : y_B.comp (CategoryTheory.Abelian.Ext.mk₀ ρ_split) (Nat.add_zero (2 * c)) = 0 := by
      rw [hy0, CategoryTheory.Abelian.Ext.zero_comp]
    dsimp only [y_B] at h_back
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.add_zero (2 * c)) (Nat.add_zero 0) (Nat.add_zero (2 * c)),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_retract] at h_back
    have hid_map :=
      CategoryTheory.Abelian.extFunctorObj_map (C_B.obj Aℤ) (2 * c)
        (CategoryTheory.CategoryStruct.id F_B)
    rw [(CategoryTheory.Abelian.extFunctorObj (C_B.obj Aℤ) (2 * c)).map_id F_B] at hid_map
    have hx_id : x_B.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F_B))
        (Nat.add_zero (2 * c)) = x_B :=
      CategoryTheory.ConcreteCategory.congr_hom hid_map.symm x_B
    exact hx_id.symm.trans h_back

  have hLeray_Q2 :=
    hLeray_bij f P_pull_f adj_f ιℤ_f _ hιπ_f hπι_f
      (fun SC hSC hX₂ => ⟨(hCalc3 SC hSC hX₂).1.2, (hCalc3 SC hSC hX₂).2.2⟩)
      Q₂ hQ₂_acyc (2 * c)
  let L_yB :=
    (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
      (((P_pull_f.mapExtAddHom (C_B.obj Aℤ) (pf_f.obj Q₂) (2 * c) y_B).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q₂)) (Nat.add_zero (2 * c))))
      (Nat.zero_add (2 * c))
  have hLyB_ne : L_yB ≠ 0 := by
    intro hL0
    apply hy_B
    apply hLeray_Q2.1
    change L_yB =
      (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
        (((P_pull_f.mapExtAddHom (C_B.obj Aℤ) (pf_f.obj Q₂) (2 * c) 0).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q₂)) (Nat.add_zero (2 * c))))
        (Nat.zero_add (2 * c))
    rw [map_zero, CategoryTheory.Abelian.Ext.zero_comp, CategoryTheory.Abelian.Ext.comp_zero]
    exact hL0

  let πM_f : P_pull_f.obj (C_B.obj AM) ⟶ C_E.obj AM :=
    (adj_f.homEquiv (C_B.obj AM) (C_E.obj AM)).symm η_F
  have h_nat_φ : P_pull_f.map (pf_f.map φ_ω) ≫ adj_f.counit.app Q₂ =
      adj_f.counit.app F_E ≫ φ_ω :=
    adj_f.counit.naturality φ_ω
  have h_counit_η : P_pull_f.map η_F ≫ adj_f.counit.app F_E = πM_f := by
    dsimp only [πM_f, F_E, weilEtaleTorsionSheaf]
    simp only [CategoryTheory.Adjunction.homEquiv_counit]
    rfl
  have h_counit_α : P_pull_f.map α_split ≫ adj_f.counit.app Q₂ = πM_f ≫ φ_ω :=
    (congrArg (· ≫ adj_f.counit.app Q₂) (P_pull_f.map_comp η_F (pf_f.map φ_ω))).trans
      ((CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (P_pull_f.map η_F ≫ ·) h_nat_φ).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ φ_ω) h_counit_η))))

  have hLyB_eq : L_yB =
      (p_f x_B).comp (CategoryTheory.Abelian.Ext.mk₀ φ_ω) (Nat.add_zero (2 * c)) := by
    dsimp only [L_yB, y_B]
    change (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
        ((CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_f
            (x_B.comp (CategoryTheory.Abelian.Ext.mk₀ α_split) (Nat.add_zero (2 * c)))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q₂)) (Nat.add_zero (2 * c)))
        (Nat.zero_add (2 * c)) = _
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp P_pull_f x_B
        (CategoryTheory.Abelian.Ext.mk₀ α_split) (Nat.add_zero (2 * c)),
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ P_pull_f α_split,
      CategoryTheory.Abelian.Ext.comp_assoc _
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull_f.map α_split))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q₂))
        (Nat.add_zero (2 * c)) (Nat.add_zero 0) (Nat.add_zero (2 * c)),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_counit_α,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ πM_f φ_ω,
      ← CategoryTheory.Abelian.Ext.comp_assoc _
        (CategoryTheory.Abelian.Ext.mk₀ πM_f) (CategoryTheory.Abelian.Ext.mk₀ φ_ω)
        (Nat.add_zero (2 * c)) (Nat.add_zero 0) (Nat.add_zero (2 * c)),
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f) _
        (CategoryTheory.Abelian.Ext.mk₀ φ_ω)
        (Nat.zero_add (2 * c)) (Nat.add_zero (2 * c)) (Nat.zero_add (2 * c)),
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f)
        (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_f x_B)
        (CategoryTheory.Abelian.Ext.mk₀ πM_f)
        (Nat.zero_add (2 * c)) (Nat.add_zero (2 * c)) (Nat.zero_add (2 * c)),
      hp_f_eq x_B]
    rfl

  intro h_zero_cup
  apply hLyB_ne
  rw [hLyB_eq]
  refine hShift_inj (C_E.obj Aℤ) (by omega : 1 ≤ 2 * c) (Nat.mul_succ 2 c).symm _ ?_
  rw [CategoryTheory.Abelian.Ext.comp_assoc (p_f x_B) (CategoryTheory.Abelian.Ext.mk₀ φ_ω)
    (hS₁.extClass.comp hS₀.extClass (Nat.one_add 1))
    (Nat.add_zero (2 * c)) (Nat.zero_add 2) (Nat.mul_succ 2 c).symm,
    ← hω_eq]
  exact h_zero_cup

theorem weil_gysin_dim_zero_and_polyP1_origin_nonvanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    (τ : ∀ (c r : ℕ), WeilGysinSupportClass
      (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilGysinAffineSpace k c) (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c))
    (hτ : WeilGysinIsAffineOriginThomTower k ℓ τ)
    (hCD_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m n q : ℕ),
      1 ≤ n → IsUnit (n : Ω) →
      ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper Z.hom],
        topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
        2 * m < q →
        Subsingleton (weilEtaleTorsionH Z.left n q))
    (hPBC_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (ℓ : Ω) ≠ 0 → WeilProperModPrimeBaseChangeHolds Ω ℓ)
    (ι_P1 : ∀ (Ω : Type u) [Field Ω],
      Quiver.Hom (weilGysinAffineSpace Ω 1) (weilProjectiveSpaceOver Ω 1).left)
    (s_inf : ∀ (Ω : Type u) [Field Ω],
      Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (weilProjectiveSpaceOver Ω 1).left)
    (V_zero_compl : ∀ (Ω : Type u) [Field Ω], (weilProjectiveSpaceOver Ω 1).left.Opens)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilGysinAffineSpace k δ) (weilGysinPolyP1Over k δ).left)
    (hComp : WeilGysinIsPolyP1Compactification k ι_P1 s_inf V_zero_compl ι_aff) :
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [CategoryTheory.IsIso Y.hom],
      ∃ tr_Y : ∀ r : ℕ, weilEtaleTorsionH Y.left (ℓ ^ r) 0 →+ ZMod (ℓ ^ r),
        (∀ r : ℕ, Function.Bijective (tr_Y r)) ∧
        (∀ (r : ℕ) (u : weilEtaleTorsionH Y.left (ℓ ^ (r + 1)) 0),
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_Y (r + 1) u) =
            tr_Y r (weilEtaleTorsionTransition Y.left ℓ r 0 u)) ∧
        (∀ (r : ℕ) (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Y.left)
          (cl : weilEtaleTorsionH Y.left (ℓ ^ r) 0),
          CategoryTheory.CategoryStruct.comp s Y.hom =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
          WeilGysinIsPointClass (τ 0 r) Y.left Y.hom s cl →
          tr_Y r cl = 1)) ∧
    (∀ (c : ℕ), 1 ≤ c →
      ∀ cl₁ : weilEtaleTorsionH (weilGysinPolyP1Over k c).left (ℓ ^ 1) (2 * c),
        WeilGysinIsPointClass (τ c 1) (weilGysinPolyP1Over k c).left
          (weilGysinPolyP1Over k c).hom
          (CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c) (ι_aff c)) cl₁ →
        cl₁ ≠ 0) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  obtain ⟨⟨e₀, he₀_trans, he₀_pt⟩, hτ₁_norm⟩ := hτ.2.1
  obtain ⟨τ_iso, ⟨_, hIso_pb, _, _⟩,
    ⟨hPb_ex, hPb_uniq, hPb_id, hPb_comp, hExc⟩,
    ⟨hFg_ex, hFg_nat, hPull_ex, hPull_id, hPull_comp⟩,
    ⟨hGysin_ex, _, _, _, hGysin_bc⟩, _⟩ :=
    weil_gysin_support_ext_and_ab_comparison_calculus.{u} ℓ
  obtain ⟨hPull_trans, _⟩ := weil_gysin_torsion_pullback_and_cup_transition.{u} ℓ
  have hSecClosed : ∀ {Y Z : AlgebraicGeometry.Scheme.{u}}
      (p_Y : Y ⟶ Z) [AlgebraicGeometry.IsSeparated p_Y]
      (s : Z ⟶ Y), s ≫ p_Y = 𝟙 Z → AlgebraicGeometry.IsClosedImmersion s := by
    intro Y Z p_Y _ s hs
    have hIso_sp : CategoryTheory.IsIso (s ≫ p_Y) := by
      rw [hs]
      infer_instance
    have hl : AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift (𝟙 Z) s (Category.id_comp (s ≫ p_Y))) :=
      AlgebraicGeometry.IsSeparated.instIsClosedImmersionLiftSchemeId s p_Y
    have hpr₂_iso : CategoryTheory.IsIso (CategoryTheory.Limits.pullback.snd (s ≫ p_Y) p_Y) :=
      inferInstance
    have hpr₂_cl : AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.snd (s ≫ p_Y) p_Y) :=
      inferInstance
    have heq : CategoryTheory.Limits.pullback.lift (𝟙 Z) s (Category.id_comp (s ≫ p_Y)) ≫
        CategoryTheory.Limits.pullback.snd (s ≫ p_Y) p_Y = s :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    rw [← heq]
    infer_instance
  have hAffOrigStruct : ∀ c : ℕ,
      CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c) (weilGysinAffineStruct k c) =
        CategoryTheory.CategoryStruct.id S_k := by
    intro c
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval 0)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = 𝟙 _
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
    congr 1
    ext x
    exact MvPolynomial.eval_C x
  have hIsoPt : ∀ (c r : ℕ) {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (p₁ : Quiver.Hom Y₁ S_k) (p₂ : Quiver.Hom Y₂ S_k)
      [AlgebraicGeometry.IsSeparated p₁] [AlgebraicGeometry.IsSeparated p₂]
      (s₁ : Quiver.Hom S_k Y₁) (s₂ : Quiver.Hom S_k Y₂)
      (g : Quiver.Hom Y₁ Y₂) [CategoryTheory.IsIso g]
      (p_g : weilEtaleTorsionH Y₂ (ℓ ^ r) (2 * c) →+ weilEtaleTorsionH Y₁ (ℓ ^ r) (2 * c))
      (cl₂ : weilEtaleTorsionH Y₂ (ℓ ^ r) (2 * c)),
      CategoryTheory.CategoryStruct.comp g p₂ = p₁ →
      CategoryTheory.CategoryStruct.comp s₂ p₂ = CategoryTheory.CategoryStruct.id S_k →
      CategoryTheory.CategoryStruct.comp s₁ g = s₂ →
      WeilLefschetzTorsionPullback g (ℓ ^ r) (2 * c) p_g →
      WeilGysinIsPointClass (τ c r) Y₂ p₂ s₂ cl₂ →
      WeilGysinIsPointClass (τ c r) Y₁ p₁ s₁ (p_g cl₂) := by
    intro c r Y₁ Y₂ p₁ p₂ _ _ s₁ s₂ g _ p_g cl₂ hgp hs₂ hsg hp_g hcl₂
    have hs₁ : s₁ ≫ p₁ = 𝟙 S_k := by
      rw [← hgp, ← Category.assoc, hsg, hs₂]
    have hs₁_cl : AlgebraicGeometry.IsClosedImmersion s₁ := hSecClosed p₁ s₁ hs₁
    have hs₂_cl : AlgebraicGeometry.IsClosedImmersion s₂ := hSecClosed p₂ s₂ hs₂
    obtain ⟨U₂, s_U₂, u₂, hChart₂, τ_Y₂, τ_U₂, hpb_U₂, hpb_u₂, hfg₂⟩ := hcl₂
    let U₁ : Y₁.Opens := g ⁻¹ᵁ U₂
    let g_U : U₁.toScheme ⟶ U₂.toScheme := g ∣_ U₂
    have hg_U_iso : CategoryTheory.IsIso g_U := inferInstance
    let s_U₁ : S_k ⟶ U₁.toScheme := s_U₂ ≫ CategoryTheory.inv g_U
    let u₁ : U₁.toScheme ⟶ weilGysinAffineSpace k c := g_U ≫ u₂
    have hg_U_ι : g_U ≫ U₂.ι = U₁.ι ≫ g := AlgebraicGeometry.morphismRestrict_ι g U₂
    have hs_U₁_ι : s_U₁ ≫ U₁.ι = s₁ := by
      apply (cancel_mono g).mp
      change (s_U₂ ≫ CategoryTheory.inv g_U) ≫ U₁.ι ≫ g = s₁ ≫ g
      rw [← hg_U_ι, Category.assoc, CategoryTheory.IsIso.inv_hom_id_assoc, hChart₂.2.2.1, hsg]
    have hChart₁ : WeilGysinIsEtaleOriginChart c p₁ s₁ U₁ s_U₁ u₁ := by
      have : AlgebraicGeometry.Etale u₂ := hChart₂.1
      refine ⟨inferInstance, ?_, hs_U₁_ι, ?_⟩
      · change (g_U ≫ u₂) ≫ weilGysinAffineStruct k c = U₁.ι ≫ p₁
        rw [Category.assoc, hChart₂.2.1, ← Category.assoc, hg_U_ι, Category.assoc, hgp]
      · have hsq_gU : CategoryTheory.IsPullback s_U₁ (𝟙 S_k) g_U s_U₂ := by
          refine CategoryTheory.IsPullback.of_vert_isIso ⟨?_⟩
          change (s_U₂ ≫ CategoryTheory.inv g_U) ≫ g_U = 𝟙 S_k ≫ s_U₂
          rw [Category.assoc, CategoryTheory.IsIso.inv_hom_id, Category.comp_id, Category.id_comp]
        have hpasted := hsq_gU.paste_vert hChart₂.2.2.2
        simpa only [Category.id_comp] using hpasted
    obtain ⟨τ'_Y₁, τ'_U₁, cl₁, hpb'_U₁, hpb'_u₁, hfg'₁⟩ :=
      (hτ.1 c Y₁ p₁ s₁ hs₁).1 U₁ s_U₁ u₁ hChart₁ r
    have hcl₁ : WeilGysinIsPointClass (τ c r) Y₁ p₁ s₁ cl₁ :=
      ⟨U₁, s_U₁, u₁, hChart₁, τ'_Y₁, τ'_U₁, hpb'_U₁, hpb'_u₁, hfg'₁⟩
    have hSep_U₁p₁ : AlgebraicGeometry.IsSeparated (U₁.ι ≫ p₁) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsSeparated) U₁.ι p₁
        (@AlgebraicGeometry.IsSeparated.isSeparated_of_mono _ _ U₁.ι
          (AlgebraicGeometry.IsOpenImmersion.mono U₁.ι))
        inferInstance
    have hSep_U₂p₂ : AlgebraicGeometry.IsSeparated (U₂.ι ≫ p₂) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsSeparated) U₂.ι p₂
        (@AlgebraicGeometry.IsSeparated.isSeparated_of_mono _ _ U₂.ι
          (AlgebraicGeometry.IsOpenImmersion.mono U₂.ι))
        inferInstance
    have hs_U₁_cl : AlgebraicGeometry.IsClosedImmersion s_U₁ :=
      @hSecClosed _ _ (U₁.ι ≫ p₁) hSep_U₁p₁ s_U₁ (by rw [← Category.assoc, hs_U₁_ι, hs₁])
    have hs_U₂_cl : AlgebraicGeometry.IsClosedImmersion s_U₂ :=
      @hSecClosed _ _ (U₂.ι ≫ p₂) hSep_U₂p₂ s_U₂ (by rw [← Category.assoc, hChart₂.2.2.1, hs₂])
    have hsq_g : CategoryTheory.IsPullback s₁ (𝟙 S_k) g s₂ :=
      CategoryTheory.IsPullback.of_vert_isIso ⟨by rw [hsg, Category.id_comp]⟩
    have hsq_U₁ : CategoryTheory.IsPullback s_U₁ (𝟙 S_k) U₁.ι s₁ :=
      CategoryTheory.IsPullback.of_vert_isIso_mono ⟨by rw [hs_U₁_ι, Category.id_comp]⟩
    have hsq_gU : CategoryTheory.IsPullback s_U₁ (𝟙 S_k) g_U s_U₂ := by
      refine CategoryTheory.IsPullback.of_vert_isIso ⟨?_⟩
      change (s_U₂ ≫ CategoryTheory.inv g_U) ≫ g_U = 𝟙 S_k ≫ s_U₂
      rw [Category.assoc, CategoryTheory.IsIso.inv_hom_id, Category.comp_id, Category.id_comp]
    obtain ⟨τ_Y₁, hpb_g⟩ := hPb_ex g s₁ s₂ (𝟙 S_k) hs₂_cl hsq_g r (2 * c) τ_Y₂
    obtain ⟨τ_U₁, hpb_U₁⟩ := hPb_ex U₁.ι s_U₁ s₁ (𝟙 S_k) hs₁_cl hsq_U₁ r (2 * c) τ_Y₁
    obtain ⟨τ''_U₁, hpb_gU⟩ := hPb_ex g_U s_U₁ s_U₂ (𝟙 S_k) hs_U₂_cl hsq_gU r (2 * c) τ_U₂
    have hcomp₁ : WeilGysinSupportPullback (U₁.ι ≫ g) s_U₁ s₂ (ℓ ^ r) (2 * c) τ_U₁ τ_Y₂ :=
      hPb_comp U₁.ι g s_U₁ s₁ s₂ r (2 * c) τ_U₁ τ_Y₁ τ_Y₂ hpb_U₁ hpb_g
    have hcomp₂ : WeilGysinSupportPullback (U₁.ι ≫ g) s_U₁ s₂ (ℓ ^ r) (2 * c) τ''_U₁ τ_Y₂ := by
      rw [← hg_U_ι]
      exact hPb_comp g_U U₂.ι s_U₁ s_U₂ s₂ r (2 * c) τ''_U₁ τ_U₂ τ_Y₂ hpb_gU hpb_U₂
    have hU₁_eq₁ : τ_U₁ = τ''_U₁ :=
      hPb_uniq (U₁.ι ≫ g) s_U₁ s₂ hs_U₁_cl r (2 * c) τ_Y₂ τ_U₁ τ''_U₁ hcomp₁ hcomp₂
    have hcomp₃ : WeilGysinSupportPullback u₁ s_U₁ (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c) τ''_U₁ (τ c r) :=
      hPb_comp g_U u₂ s_U₁ s_U₂ (weilGysinAffineOrigin k c) r (2 * c) τ''_U₁ τ_U₂ (τ c r) hpb_gU hpb_u₂
    have hU₁_eq₂ : τ''_U₁ = τ'_U₁ :=
      hPb_uniq u₁ s_U₁ (weilGysinAffineOrigin k c) hs_U₁_cl r (2 * c) (τ c r) τ''_U₁ τ'_U₁ hcomp₃ hpb'_u₁
    have hpb_U₁' : WeilGysinSupportPullback U₁.ι s_U₁ s₁ (ℓ ^ r) (2 * c) τ'_U₁ τ_Y₁ := by
      rwa [hU₁_eq₁, hU₁_eq₂] at hpb_U₁
    have hY₁_eq : τ_Y₁ = τ'_Y₁ :=
      (hExc s₁ U₁ s_U₁ hs₁_cl hs_U₁_ι r (2 * c) τ'_U₁).unique hpb_U₁' hpb'_U₁
    have hpb_g' : WeilGysinSupportPullback g s₁ s₂ (ℓ ^ r) (2 * c) τ'_Y₁ τ_Y₂ := by
      rwa [← hY₁_eq]
    have hp_eq : p_g cl₂ = cl₁ :=
      hFg_nat g s₁ s₂ r (2 * c) τ'_Y₁ τ_Y₂ cl₁ cl₂ p_g hpb_g' hfg₂ hfg'₁ hp_g
    rwa [hp_eq]
