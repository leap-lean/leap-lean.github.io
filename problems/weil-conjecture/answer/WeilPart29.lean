        hSE_pf.comp_extClass
      rw [← hx₃, ← hx₂_lift, x₂.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (pf_σ.map p_G))
          hSE_pf.extClass (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
        h_comp_ext, CategoryTheory.Abelian.Ext.comp_zero]
    | succ n ih =>
      intro G
      apply subsingleton_of_forall_eq 0
      intro y
      let I := CategoryTheory.Injective.under G
      let ι_G : G ⟶ I := CategoryTheory.Injective.ι G
      let p_G : I ⟶ CategoryTheory.Limits.cokernel ι_G := CategoryTheory.Limits.cokernel.π ι_G
      let SC_G := CategoryTheory.ShortComplex.mk ι_G p_G (CategoryTheory.Limits.cokernel.condition ι_G)
      have hSE_G : SC_G.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι_G) inferInstance inferInstance
      have hSE_pf : (SC_G.map pf_σ).ShortExact := hMap_SE SC_G hSE_G
      have _ : CategoryTheory.Injective (pf_σ.obj I) := hInj_σ I inferInstance
      have hSub_inj : Subsingleton (CategoryTheory.Abelian.Ext Fℤ_Wx (pf_σ.obj I) (n + 2)) :=
        CategoryTheory.Abelian.Ext.subsingleton_of_injective Fℤ_Wx (pf_σ.obj I) (n + 1)
      have hy_zero : y.comp (CategoryTheory.Abelian.Ext.mk₀ (SC_G.map pf_σ).f)
          (Nat.add_zero (n + 2)) = 0 :=
        @Subsingleton.elim _ hSub_inj _ _
      obtain ⟨x₃, hx₃⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
        Fℤ_Wx hSE_pf y hy_zero (rfl : (n + 1) + 1 = n + 2)
      have hx₃_zero : x₃ = 0 := @Subsingleton.elim _ (ih SC_G.X₃) _ _
      rw [← hx₃, hx₃_zero, CategoryTheory.Abelian.Ext.zero_comp]

  
