    have hδ : Algebra.H1Cotangent.δ k P_c S c₀ = 0 :=
      hφ_bij.1 (hδ0.trans (map_zero φ_diff).symm)
    obtain ⟨c₁, hc₁⟩ := (Algebra.H1Cotangent.exact_map_δ k P_c S c₀).mp hδ
    rw [← hc₁, Subsingleton.elim c₁ 0, map_zero]
  haveI : Algebra.FormallyEtale P_c S :=
    (Algebra.formallyEtale_iff P_c S).mpr ⟨hSub_Ω, hSub_H1⟩
  haveI : Algebra.Etale P_c S := {}
  exact RingHom.etale_algebraMap.mpr inferInstance

theorem weil_gysin_affine_basicOpen_lift_and_curve_slice (k : Type u) [Field k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    (∀ (b : ℕ) (h1b : 1 + b = b + 1)
        {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
        (s : Quiver.Hom S_k Y)
        (_hs : CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k)
        (W₀ : Y.Opens) (hW₀ : AlgebraicGeometry.IsAffineOpen W₀)
        (s_W₀ : Quiver.Hom S_k W₀.toScheme)
        (_hs_W₀ : CategoryTheory.CategoryStruct.comp s_W₀ W₀.ι = s),
      let B₀ : Type u := ↑(Y.presheaf.obj (Opposite.op W₀))
      ∃ (f_k : k →+* B₀) (ev₀ : B₀ →+* k),
        ev₀.comp f_k = RingHom.id k ∧
        (∀ u₀ : Quiver.Hom W₀.toScheme (weilGysinAffineSpace k (b + 1)),
          AlgebraicGeometry.Etale u₀ →
          CategoryTheory.CategoryStruct.comp u₀ (weilGysinAffineStruct k (b + 1)) =
            CategoryTheory.CategoryStruct.comp W₀.ι p_Y →
          CategoryTheory.CategoryStruct.comp s_W₀ u₀ = weilGysinAffineOrigin k (b + 1) →
          ∃ φ : MvPolynomial (Fin (b + 1)) k →+* B₀,
            φ.comp MvPolynomial.C = f_k ∧
            ev₀.comp φ = MvPolynomial.eval 0 ∧
            φ.Etale ∧
            CategoryTheory.CategoryStruct.comp hW₀.isoSpec.inv u₀ =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ∧
        (∀ (f_prod : B₀),
          ev₀ f_prod ≠ 0 →
          let V₀ : Y.Opens := Y.basicOpen f_prod
          let hle_V₀ : V₀ ≤ W₀ := Y.basicOpen_le f_prod
          ∃ (s_V₀ : Quiver.Hom S_k V₀.toScheme)
            (liftZ : (Fin (b + 1) → B₀) →
              Quiver.Hom V₀.toScheme (weilGysinAffineSpace k (b + 1))),
            CategoryTheory.CategoryStruct.comp s_V₀ V₀.ι = s ∧
            CategoryTheory.CategoryStruct.comp s_V₀ (Y.homOfLE hle_V₀) = s_W₀ ∧
            (∀ z : Fin (b + 1) → B₀,
              (∀ j : Fin (b + 1), ev₀ (z j) = 0) →
              (∀ (S : Type u) [CommRing S] (g : B₀ →+* S),
                @IsLocalization.Away B₀ _ f_prod S _ g.toAlgebra →
                (MvPolynomial.eval₂Hom (g.comp f_k) (fun j => g (z j))).Etale) →
              AlgebraicGeometry.Etale (liftZ z) ∧
              CategoryTheory.CategoryStruct.comp (liftZ z) (weilGysinAffineStruct k (b + 1)) =
                CategoryTheory.CategoryStruct.comp V₀.ι p_Y ∧
              CategoryTheory.CategoryStruct.comp s_V₀ (liftZ z) =
                weilGysinAffineOrigin k (b + 1)) ∧
            (∀ (u₀ : Quiver.Hom W₀.toScheme (weilGysinAffineSpace k (b + 1)))
                (φ : MvPolynomial (Fin (b + 1)) k →+* B₀)
                (z : Fin (b + 1) → B₀),
              CategoryTheory.CategoryStruct.comp hW₀.isoSpec.inv u₀ =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) →
              φ.comp MvPolynomial.C = f_k →
              (∀ j : Fin (b + 1), z j = φ (MvPolynomial.X j)) →
              liftZ z = CategoryTheory.CategoryStruct.comp (Y.homOfLE hle_V₀) u₀) ∧
            (∀ (z₁ z₂ : Fin (b + 1) → B₀) (i₀ : Fin (b + 1)),
              (∀ j : Fin (b + 1), j ≠ i₀ → z₂ j = z₁ j) →
              let π := Equiv.swap (0 : Fin (b + 1)) i₀
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (liftZ z₁) (weilGysinAffinePerm k (b + 1) π))
                (weilGysinAffineProjRight k 1 b (b + 1) h1b) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (liftZ z₂) (weilGysinAffinePerm k (b + 1) π))
                (weilGysinAffineProjRight k 1 b (b + 1) h1b)))) ∧
    (∀ (b : ℕ) (h1b : 1 + b = b + 1)
        {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
        [AlgebraicGeometry.IsSeparated p_Y] (s : Quiver.Hom S_k Y)
        (_hs : CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k)
        (W : Y.Opens) (s_W : Quiver.Hom S_k W.toScheme)
        (_hs_W : CategoryTheory.CategoryStruct.comp s_W W.ι = s)
        (h₁ h₂ : Quiver.Hom W.toScheme (weilGysinAffineSpace k (b + 1)))
        (π_m : Equiv.Perm (Fin (b + 1))),
      WeilGysinIsEtaleOriginChart (b + 1) p_Y s W s_W h₁ →
      WeilGysinIsEtaleOriginChart (b + 1) p_Y s W s_W h₂ →
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp h₁ (weilGysinAffinePerm k (b + 1) π_m))
        (weilGysinAffineProjRight k 1 b (b + 1) h1b) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp h₂ (weilGysinAffinePerm k (b + 1) π_m))
        (weilGysinAffineProjRight k 1 b (b + 1) h1b) →
      ∃ (C_m : AlgebraicGeometry.Scheme.{u})
        (p_Cm : Quiver.Hom C_m S_k)
        (_ : AlgebraicGeometry.IsSeparated p_Cm)
        (s_Cm : Quiver.Hom S_k C_m)
        (s_Cm_top : Quiver.Hom S_k (⊤ : C_m.Opens).toScheme)
        (i_Cm_top : Quiver.Hom (⊤ : C_m.Opens).toScheme W.toScheme)
        (h_rest_m : Quiver.Hom W.toScheme (weilGysinAffineSpace k b))
        (g_m1 g_m2 : Quiver.Hom (⊤ : C_m.Opens).toScheme (weilGysinAffineSpace k 1)),
        AlgebraicGeometry.IsClosedImmersion i_Cm_top ∧
        CategoryTheory.CategoryStruct.comp s_Cm p_Cm =
          CategoryTheory.CategoryStruct.id S_k ∧
        CategoryTheory.CategoryStruct.comp s_Cm_top i_Cm_top = s_W ∧
        WeilGysinIsEtaleOriginChart 1 p_Cm s_Cm ⊤ s_Cm_top g_m1 ∧
        WeilGysinIsEtaleOriginChart 1 p_Cm s_Cm ⊤ s_Cm_top g_m2 ∧
        CategoryTheory.IsPullback i_Cm_top
          (CategoryTheory.CategoryStruct.comp (⊤ : C_m.Opens).ι p_Cm)
          h_rest_m (weilGysinAffineOrigin k b) ∧
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp h₁ (weilGysinAffinePerm k (b + 1) π_m))
          (weilGysinAffineProjRight k 1 b (b + 1) h1b) = h_rest_m ∧
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp h₂ (weilGysinAffinePerm k (b + 1) π_m))
          (weilGysinAffineProjRight k 1 b (b + 1) h1b) = h_rest_m ∧
        CategoryTheory.IsPullback i_Cm_top g_m1
          (CategoryTheory.CategoryStruct.comp h₁ (weilGysinAffinePerm k (b + 1) π_m))
          (weilGysinAffineLeftAxis k 1 b (b + 1) h1b) ∧
        CategoryTheory.IsPullback i_Cm_top g_m2
          (CategoryTheory.CategoryStruct.comp h₂ (weilGysinAffinePerm k (b + 1) π_m))
          (weilGysinAffineLeftAxis k 1 b (b + 1) h1b)) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  refine ⟨?_, ?_⟩
  · intro b h1b Y p_Y s _hs W₀ hW₀ s_W₀ _hs_W₀
    let R₀ : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W₀)
    let B₀ : Type u := ↑R₀
    let f_k : k →+* B₀ :=
      (AlgebraicGeometry.Spec.preimage (hW₀.isoSpec.inv ≫ W₀.ι ≫ p_Y)).hom
    let ev₀ : B₀ →+* k :=
      (AlgebraicGeometry.Spec.preimage (s_W₀ ≫ hW₀.isoSpec.hom)).hom
    have h_fk : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) =
        hW₀.isoSpec.inv ≫ W₀.ι ≫ p_Y :=
      AlgebraicGeometry.Spec.map_preimage (hW₀.isoSpec.inv ≫ W₀.ι ≫ p_Y)
    have h_ev₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) =
        s_W₀ ≫ hW₀.isoSpec.hom :=
      AlgebraicGeometry.Spec.map_preimage (s_W₀ ≫ hW₀.isoSpec.hom)
    have hs_sec : s ≫ p_Y = 𝟙 S_k := _hs
    have hs_W₀_ι : s_W₀ ≫ W₀.ι = s := _hs_W₀
    have hev_fk : ev₀.comp f_k = RingHom.id k := by
      have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev₀.comp f_k)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id k)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, h_ev₀, h_fk,
          CategoryTheory.Category.assoc, hW₀.isoSpec.hom_inv_id_assoc,
          ← CategoryTheory.Category.assoc s_W₀ W₀.ι p_Y, hs_W₀_ι, hs_sec,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap)
    refine ⟨f_k, ev₀, hev_fk, ?_, ?_⟩
    · intro u₀ hu₀_et hu₀_str hs_u₀
      let φ : MvPolynomial (Fin (b + 1)) k →+* B₀ :=
        (AlgebraicGeometry.Spec.preimage (hW₀.isoSpec.inv ≫ u₀)).hom
      have hφ_spec : hW₀.isoSpec.inv ≫ u₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) :=
        (AlgebraicGeometry.Spec.map_preimage (hW₀.isoSpec.inv ≫ u₀)).symm
      have hφ_k : φ.comp MvPolynomial.C = f_k := by
        have h1 : (hW₀.isoSpec.inv ≫ u₀) ≫ weilGysinAffineStruct k (b + 1) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) := by
          rw [CategoryTheory.Category.assoc, hu₀_str, ← h_fk]
        have h1' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp MvPolynomial.C)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) :=
          (congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp MvPolynomial.C φ)).trans
            ((AlgebraicGeometry.Spec.map_comp _ _).trans
              ((congrArg (· ≫ weilGysinAffineStruct k (b + 1)) hφ_spec.symm).trans h1))
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h1')
      have hev_φ : ev₀.comp φ = MvPolynomial.eval 0 := by
        have h2 : (s_W₀ ≫ hW₀.isoSpec.hom) ≫ (hW₀.isoSpec.inv ≫ u₀) =
            weilGysinAffineOrigin k (b + 1) := by
          rw [CategoryTheory.Category.assoc, hW₀.isoSpec.hom_inv_id_assoc, hs_u₀]
        have h2' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev₀.comp φ)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval 0)) :=
          (congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp φ ev₀)).trans
            ((AlgebraicGeometry.Spec.map_comp _ _).trans
              ((congrArg₂ CategoryTheory.CategoryStruct.comp h_ev₀ hφ_spec.symm).trans h2))
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h2')
      have hφ_et : φ.Etale := by
        have : AlgebraicGeometry.Etale u₀ := hu₀_et
        have h_comp_et : AlgebraicGeometry.Etale (hW₀.isoSpec.inv ≫ u₀) := inferInstance
        rw [hφ_spec] at h_comp_et
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          h_comp_et
      exact ⟨φ, hφ_k, hev_φ, hφ_et, hφ_spec⟩
    · intro f_prod hf_ne
      let V₀ : Y.Opens := Y.basicOpen f_prod
      let hle_V₀ : V₀ ≤ W₀ := Y.basicOpen_le f_prod
      let pt₀ : ↥S_k := default
      let pt₀' : PrimeSpectrum k := pt₀
      have hpt₀_bot : pt₀'.asIdeal = ⊥ :=
        (Ideal.eq_bot_or_top pt₀'.asIdeal).resolve_right pt₀'.isPrime.ne_top
      let p₀ : PrimeSpectrum B₀ := PrimeSpectrum.comap ev₀ pt₀'
      have hp₀_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt₀ = p₀ :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom ev₀) pt₀
      have hp₀_mem : p₀ ∈ PrimeSpectrum.basicOpen f_prod := by
        rw [PrimeSpectrum.mem_basicOpen]
        intro h_in
        have h_ev_in : ev₀ f_prod ∈ pt₀'.asIdeal := h_in
        rw [hpt₀_bot, Submodule.mem_bot] at h_ev_in
        exact hf_ne h_ev_in
      have hs_pt₀_mem : s.base pt₀ ∈ V₀ := by
        have hp₀_pre : p₀ ∈ (TopologicalSpace.Opens.map hW₀.fromSpec.base).obj V₀ := by
          dsimp only [V₀]
          rwa [hW₀.fromSpec_preimage_basicOpen f_prod]
        have hs_from : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ hW₀.fromSpec = s := by
          rw [h_ev₀, ← hW₀.isoSpec_inv_ι, CategoryTheory.Category.assoc,
            hW₀.isoSpec.hom_inv_id_assoc, hs_W₀_ι]
        have hs_eq : s.base pt₀ = hW₀.fromSpec.base p₀ := by
          rw [← hs_from, AlgebraicGeometry.Scheme.Hom.comp_apply, hp₀_spec]
        rw [hs_eq]
        exact hp₀_pre
      have hs_V₀_range : Set.range s.base ⊆ Set.range V₀.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        rw [Subsingleton.elim q pt₀]
        exact hs_pt₀_mem
      let s_V₀ : Quiver.Hom S_k V₀.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V₀.ι s hs_V₀_range
      have hs_V₀_ι : s_V₀ ≫ V₀.ι = s :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V₀.ι s hs_V₀_range
      have hs_V₀_W₀ : s_V₀ ≫ Y.homOfLE hle_V₀ = s_W₀ := by
        apply (cancel_mono W₀.ι).mp
        rw [CategoryTheory.Category.assoc, Y.homOfLE_ι hle_V₀, hs_V₀_ι, hs_W₀_ι]
      let hV₀_aff : AlgebraicGeometry.IsAffineOpen V₀ := hW₀.basicOpen f_prod
      let R_V₀ : CommRingCat.{u} := Y.presheaf.obj (Opposite.op V₀)
      let B_V₀ : Type u := ↑R_V₀
      let g_cat : R₀ ⟶ R_V₀ := Y.presheaf.map (CategoryTheory.homOfLE hle_V₀).op
      let g : B₀ →+* B_V₀ := g_cat.hom
      have h_res_inv : AlgebraicGeometry.Spec.map g_cat ≫ hW₀.isoSpec.inv =
          hV₀_aff.isoSpec.inv ≫ Y.homOfLE hle_V₀ := by
        apply (cancel_mono W₀.ι).mp
        rw [CategoryTheory.Category.assoc, hW₀.isoSpec_inv_ι,
          CategoryTheory.Category.assoc, Y.homOfLE_ι hle_V₀, hV₀_aff.isoSpec_inv_ι]
        exact hW₀.map_fromSpec hV₀_aff (CategoryTheory.homOfLE hle_V₀).op
      have h_res_spec : hV₀_aff.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat =
          Y.homOfLE hle_V₀ ≫ hW₀.isoSpec.hom := by
        have h1 := congrArg (fun m => hV₀_aff.isoSpec.hom ≫ m ≫ hW₀.isoSpec.hom) h_res_inv
        rw [CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map g_cat),
          hW₀.isoSpec.inv_hom_id, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc hV₀_aff.isoSpec.inv,
          hV₀_aff.isoSpec.hom_inv_id_assoc] at h1
        exact h1
      let liftZ : (Fin (b + 1) → B₀) →
          Quiver.Hom V₀.toScheme (weilGysinAffineSpace k (b + 1)) :=
        fun z => hV₀_aff.isoSpec.hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.eval₂Hom (g.comp f_k) (fun j => g (z j))))
      let ev_V₀ : B_V₀ →+* k :=
        (AlgebraicGeometry.Spec.preimage (s_V₀ ≫ hV₀_aff.isoSpec.hom)).hom
      have h_ev_V₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_V₀) =
          s_V₀ ≫ hV₀_aff.isoSpec.hom :=
        AlgebraicGeometry.Spec.map_preimage (s_V₀ ≫ hV₀_aff.isoSpec.hom)
      have hev_V₀_g : ev_V₀.comp g = ev₀ := by
        have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_V₀.comp g)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, h_ev_V₀]
          change (s_V₀ ≫ hV₀_aff.isoSpec.hom) ≫ AlgebraicGeometry.Spec.map g_cat = _
          rw [CategoryTheory.Category.assoc, h_res_spec,
            ← CategoryTheory.Category.assoc s_V₀, hs_V₀_W₀, h_ev₀]
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap)
      refine ⟨s_V₀, liftZ, hs_V₀_ι, hs_V₀_W₀, ?_, ?_, ?_⟩
      · intro z hz_ev hz_et
        let ψ_z : MvPolynomial (Fin (b + 1)) k →+* B_V₀ :=
          MvPolynomial.eval₂Hom (g.comp f_k) (fun j => g (z j))
        have hψ_et : ψ_z.Etale :=
          hz_et B_V₀ g (hW₀.isLocalization_basicOpen f_prod)
        have h_spec_et : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_et
        have h_et_comp : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
            (e₁ : X₁ ⟶ X₂) (e₂ : X₂ ⟶ X₃)
            [AlgebraicGeometry.Etale e₁] [AlgebraicGeometry.Etale e₂],
            AlgebraicGeometry.Etale (e₁ ≫ e₂) := fun _ _ => inferInstance
        have h_lift_et : AlgebraicGeometry.Etale (liftZ z) :=
          @h_et_comp _ _ _ hV₀_aff.isoSpec.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z)) inferInstance h_spec_et
        have hψ_C : ψ_z.comp MvPolynomial.C = g.comp f_k :=
          RingHom.ext fun c => MvPolynomial.eval₂Hom_C (g.comp f_k) (fun j => g (z j)) c
        have h_lift_str : liftZ z ≫ weilGysinAffineStruct k (b + 1) = V₀.ι ≫ p_Y := by
          have h_c1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) ≫
              weilGysinAffineStruct k (b + 1) =
              AlgebraicGeometry.Spec.map g_cat ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
              ((congrArg AlgebraicGeometry.Spec.map
                ((CommRingCat.ofHom_comp MvPolynomial.C ψ_z).symm.trans
                  ((congrArg CommRingCat.ofHom hψ_C).trans
                    (CommRingCat.ofHom_comp f_k g)))).trans
                (AlgebraicGeometry.Spec.map_comp _ _))
          calc
            liftZ z ≫ weilGysinAffineStruct k (b + 1) =
                hV₀_aff.isoSpec.hom ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) ≫
                    weilGysinAffineStruct k (b + 1)) :=
              CategoryTheory.Category.assoc _ _ _
            _ = (hV₀_aff.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) := by
              rw [h_c1, CategoryTheory.Category.assoc]
            _ = (Y.homOfLE hle_V₀ ≫ hW₀.isoSpec.hom) ≫
                  (hW₀.isoSpec.inv ≫ W₀.ι ≫ p_Y) := by
              rw [h_res_spec, h_fk]
            _ = V₀.ι ≫ p_Y := by
              rw [CategoryTheory.Category.assoc, hW₀.isoSpec.hom_inv_id_assoc,
                ← CategoryTheory.Category.assoc, Y.homOfLE_ι hle_V₀]
        have hev_ψ : ev_V₀.comp ψ_z = MvPolynomial.eval 0 := by
          apply MvPolynomial.ringHom_ext
          · intro c
            simp only [ψ_z, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, MvPolynomial.eval_C]
            change (ev_V₀.comp g) (f_k c) = c
            rw [hev_V₀_g]
            exact RingHom.congr_fun hev_fk c
          · intro j
            simp only [ψ_z, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', MvPolynomial.eval_X,
              Pi.zero_apply]
            change (ev_V₀.comp g) (z j) = 0
            rw [hev_V₀_g]
            exact hz_ev j
        have h_lift_orig : s_V₀ ≫ liftZ z = weilGysinAffineOrigin k (b + 1) := by
          have h_c2 : (s_V₀ ≫ hV₀_aff.isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) =
              weilGysinAffineOrigin k (b + 1) :=
            (congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z))
              h_ev_V₀.symm).trans
              ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
                (congrArg AlgebraicGeometry.Spec.map
                  ((CommRingCat.ofHom_comp ψ_z ev_V₀).symm.trans
                    (congrArg CommRingCat.ofHom hev_ψ))))
          exact (CategoryTheory.Category.assoc s_V₀ hV₀_aff.isoSpec.hom _).symm.trans h_c2
        exact ⟨h_lift_et, h_lift_str, h_lift_orig⟩
      · intro u₀ φ z hφ_spec hφ_k hz_φ
