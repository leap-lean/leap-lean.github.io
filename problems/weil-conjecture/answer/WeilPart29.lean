    let Z_set : Set ↥Γ := (U_Γ : Set ↥Γ)ᶜ
    have hZ_cl : IsClosed Z_set := U_Γ.isOpen.isClosed_compl
    have h_range : Set.range ⇑I_Z.subschemeι = Z_set := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι]
      exact AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal ⟨Z_set, hZ_cl⟩
    let e_Z : ↥I_Z.subscheme ≃ₜ ↥Z_set :=
