            CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (isoαL 𝒢₂).hom (isoαL 𝒢₂).inv,
            (isoαL 𝒢₂).hom_inv_id, CategoryTheory.Category.id_comp,
            ← CategoryTheory.Category.assoc (L.map _), ← L.map_comp,
            CategoryTheory.MonoidalCategory.leftUnitor_naturality f.hom, L.map_comp,
            CategoryTheory.Category.assoc, hcounit_nat f]
          simp only [CategoryTheory.Category.assoc]
          rw [← CategoryTheory.Category.assoc (isoαL 𝒢₁).hom (isoαL 𝒢₁).inv,
            (isoαL 𝒢₁).hom_inv_id, CategoryTheory.Category.id_comp])
    let rUnit : CategoryTheory.Iso (T.flip.obj One₀) (CategoryTheory.Functor.id ℳ₀) :=
      CategoryTheory.NatIso.ofComponents
        (fun 𝒢 =>
          (isoαR 𝒢).symm ≪≫
            L.mapIso (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj) ≪≫
              CategoryTheory.asIso (adj.counit.app 𝒢))
        (fun {𝒢₁ 𝒢₂} f => by
          apply (CategoryTheory.Iso.cancel_iso_hom_left (isoαR 𝒢₁) _ _).mp
          have hexch : (isoαR 𝒢₁).hom ≫ (T.flip.obj One₀).map f =
              L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight f.hom 𝕀) ≫
                (isoαR 𝒢₂).hom := by
            change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢₁.obj η𝕀) ≫
                L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight f.hom One₀.obj) =
              L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight f.hom 𝕀) ≫
                L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢₂.obj η𝕀)
            rw [← L.map_comp, ← L.map_comp,
              CategoryTheory.MonoidalCategory.whisker_exchange f.hom η𝕀]
          change (isoαR 𝒢₁).hom ≫ (T.flip.obj One₀).map f ≫
              ((isoαR 𝒢₂).inv ≫
                L.map (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢₂.obj).hom ≫
                  adj.counit.app 𝒢₂) =
            (isoαR 𝒢₁).hom ≫
              ((isoαR 𝒢₁).inv ≫
                L.map (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢₁.obj).hom ≫
                  adj.counit.app 𝒢₁) ≫ f
          rw [← CategoryTheory.Category.assoc (isoαR 𝒢₁).hom ((T.flip.obj One₀).map f), hexch,
            CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (isoαR 𝒢₂).hom (isoαR 𝒢₂).inv,
            (isoαR 𝒢₂).hom_inv_id, CategoryTheory.Category.id_comp,
            ← CategoryTheory.Category.assoc (L.map _), ← L.map_comp,
            CategoryTheory.MonoidalCategory.rightUnitor_naturality f.hom, L.map_comp,
            CategoryTheory.Category.assoc, hcounit_nat f]
          simp only [CategoryTheory.Category.assoc]
          rw [← CategoryTheory.Category.assoc (isoαR 𝒢₁).hom (isoαR 𝒢₁).inv,
            (isoαR 𝒢₁).hom_inv_id, CategoryTheory.Category.id_comp])
    refine ⟨lUnit, rUnit, ?_⟩
    let isoFirst : L.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj 𝕀 𝕀) ≅
        L.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj 𝕀 One₀.obj) :=
      @CategoryTheory.asIso _ _ _ _
        (L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝕀 η𝕀))
        (hAbsorb_left 𝕀 𝕀)
    let τ_iso : L.obj (CategoryTheory.MonoidalCategoryStruct.tensorObj 𝕀 𝕀) ≅
        (T.obj One₀).obj One₀ :=
      isoFirst ≪≫ isoαL One₀
    have hτ_eq : τ_iso.hom =
        L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight η𝕀 𝕀) ≫
          (isoαR One₀).hom := by
      change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝕀 η𝕀) ≫
          L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight η𝕀 One₀.obj) =
        L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight η𝕀 𝕀) ≫
          L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft One₀.obj η𝕀)
      rw [← L.map_comp, ← L.map_comp,
        CategoryTheory.MonoidalCategory.whisker_exchange η𝕀 η𝕀]
    apply (CategoryTheory.Iso.cancel_iso_hom_left τ_iso _ _).mp
    have hLHS : τ_iso.hom ≫ lUnit.hom.app One₀ =
        L.map ((CategoryTheory.MonoidalCategoryStruct.leftUnitor 𝕀).hom ≫ η𝕀) ≫
          adj.counit.app One₀ := by
      change (L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝕀 η𝕀) ≫
          (isoαL One₀).hom) ≫
        ((isoαL One₀).inv ≫
          L.map (CategoryTheory.MonoidalCategoryStruct.leftUnitor One₀.obj).hom ≫
            adj.counit.app One₀) = _
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (isoαL One₀).hom (isoαL One₀).inv,
        (isoαL One₀).hom_inv_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc, ← L.map_comp,
        CategoryTheory.MonoidalCategory.leftUnitor_naturality η𝕀]
    have hRHS : τ_iso.hom ≫ rUnit.hom.app One₀ =
        L.map ((CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝕀).hom ≫ η𝕀) ≫
          adj.counit.app One₀ := by
      change τ_iso.hom ≫ ((isoαR One₀).inv ≫
          L.map (CategoryTheory.MonoidalCategoryStruct.rightUnitor One₀.obj).hom ≫
            adj.counit.app One₀) = _
      rw [hτ_eq, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (isoαR One₀).hom (isoαR One₀).inv,
        (isoαR One₀).hom_inv_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc, ← L.map_comp,
        CategoryTheory.MonoidalCategory.rightUnitor_naturality η𝕀]
    rw [hLHS, hRHS, CategoryTheory.MonoidalCategory.unitors_equal]
  exact ⟨⟨fun X => ⟨hAdd_left X, hColim_left X⟩, fun Y => ⟨hAdd_right Y, hColim_right Y⟩⟩,
    hCovers, hUnits⟩

theorem weil_gysin_downward_closed_quotient_sheaf_tensor_iso (C₀ : Type u) [CategoryTheory.SmallCategory C₀]
    (J₀ : CategoryTheory.GrothendieckTopology C₀)
    (R : Type u) [CommRing R] :
    let Psh₀ := CategoryTheory.Functor (Opposite C₀) (ModuleCat.{u, u} R)
    let ℳ₀ := CategoryTheory.Sheaf J₀ (ModuleCat.{u, u} R)
    let One₀ := (CategoryTheory.constantSheaf J₀ (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
    let S := CategoryTheory.sheafToPresheaf J₀ (ModuleCat.{u, u} R)
    let L := CategoryTheory.presheafToSheaf J₀ (ModuleCat.{u, u} R)
    let T : CategoryTheory.Functor ℳ₀ (CategoryTheory.Functor ℳ₀ ℳ₀) :=
      (((S.comp (CategoryTheory.MonoidalCategory.curriedTensor Psh₀)).comp
        ((CategoryTheory.Functor.whiskeringLeft ℳ₀ Psh₀ Psh₀).obj S)).comp
        ((CategoryTheory.Functor.whiskeringRight ℳ₀ Psh₀ ℳ₀).obj L))
    ∀ (P : C₀ → Prop),
      (∀ {W' W : C₀}, Quiver.Hom W' W → P W → P W') →
      ∀ (E : CategoryTheory.Functor ℳ₀ ℳ₀)
        (η : CategoryTheory.NatTrans (CategoryTheory.Functor.id ℳ₀) E),
        (∀ 𝒢 : ℳ₀, CategoryTheory.Epi (η.app 𝒢)) →
        (∀ (𝒢 : ℳ₀) (V : C₀) (s : 𝒢.obj.obj (Opposite.op V)),
          ((η.app 𝒢).hom.app (Opposite.op V)) s = 0 ↔
            ∃ S_cov ∈ J₀ V, ∀ ⦃W : C₀⦄ (f : Quiver.Hom W V),
              S_cov.arrows f → P W ∨ (𝒢.obj.map f.op) s = 0) →
        ∀ (ℱ : ℳ₀) (q : Quiver.Hom One₀ ℱ) (ϕ : CategoryTheory.Iso ℱ (E.obj One₀)),
          CategoryTheory.CategoryStruct.comp q ϕ.hom = η.app One₀ →
          (∃ (rStd : CategoryTheory.Iso (T.flip.obj One₀) (CategoryTheory.Functor.id ℳ₀))
             (isoR : CategoryTheory.Iso (T.flip.obj ℱ) E),
            ∀ 𝒢 : ℳ₀,
              CategoryTheory.CategoryStruct.comp ((T.obj 𝒢).map q) (isoR.hom.app 𝒢) =
                CategoryTheory.CategoryStruct.comp (rStd.hom.app 𝒢) (η.app 𝒢)) ∧
          (∃ (lStd : CategoryTheory.Iso (T.obj One₀) (CategoryTheory.Functor.id ℳ₀))
             (isoL : CategoryTheory.Iso (T.obj ℱ) E),
            ∀ 𝒢 : ℳ₀,
              CategoryTheory.CategoryStruct.comp ((T.flip.obj 𝒢).map q) (isoL.hom.app 𝒢) =
                CategoryTheory.CategoryStruct.comp (lStd.hom.app 𝒢) (η.app 𝒢)) :=
by
  classical
  intro Psh₀ ℳ₀ One₀ S L T P hP E η hEpi hKer ℱ q ϕ hq
  let Fgt := CategoryTheory.forget (ModuleCat.{u, u} R)
  let c_R : Opposite C₀ ⥤ ModuleCat.{u, u} R :=
    CategoryTheory.MonoidalCategoryStruct.tensorUnit Psh₀
  let ι_R : c_R ⟶ One₀.obj := CategoryTheory.toSheafify J₀ c_R
  have hι_surj : CategoryTheory.Presheaf.IsLocallySurjective J₀ ι_R :=
    CategoryTheory.Presheaf.isLocallySurjective_toSheafify' J₀ c_R
  have hι_inj : CategoryTheory.Presheaf.IsLocallyInjective J₀ ι_R :=
    CategoryTheory.Presheaf.isLocallyInjective_toSheafify' J₀ c_R
  have hModZero : ∀ {M N : ModuleCat.{u, u} R} (φ : M ⟶ N), φ 0 = 0 :=
    fun φ => φ.hom.map_zero
  have hModAdd : ∀ {M N : ModuleCat.{u, u} R} (φ : M ⟶ N) (x y : M),
      φ (x + y) = φ x + φ y :=
    fun φ x y => φ.hom.map_add x y
  have hModSub : ∀ {M N : ModuleCat.{u, u} R} (φ : M ⟶ N) (x y : M),
      φ (x - y) = φ x - φ y :=
    fun φ x y => φ.hom.map_sub x y
  have hModSmul : ∀ {M N : ModuleCat.{u, u} R} (φ : M ⟶ N) (r : R) (x : M),
      φ (r • x) = r • φ x :=
    fun φ r x => φ.hom.map_smul r x
  have hNatApp : ∀ {F G : Psh₀} (α : F ⟶ G) {W V : C₀} (f : W ⟶ V)
      (x : F.obj (Opposite.op V)),
      (G.map f.op) ((α.app (Opposite.op V)) x) =
        (α.app (Opposite.op W)) ((F.map f.op) x) := by
    intro F G α W V f x
    exact (congrArg (fun φ => φ x) (α.naturality f.op)).symm
  have hι_R_res : ∀ {W V : C₀} (f : W ⟶ V) (r : R),
      (One₀.obj.map f.op) ((ι_R.app (Opposite.op V)) r) = (ι_R.app (Opposite.op W)) r := by
    intro W V f r
    exact hNatApp ι_R f r
  have hShFor : ∀ (ℋ : ℳ₀) {V : C₀} {S_cov : CategoryTheory.Sieve V},
      S_cov ∈ J₀ V → CategoryTheory.Presieve.IsSheafFor (ℋ.obj ⋙ Fgt) S_cov.arrows := by
    intro ℋ V S_cov hS
    have h1 : CategoryTheory.Presheaf.IsSheaf J₀ (ℋ.obj ⋙ Fgt) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J₀ ℋ.obj Fgt ℋ.2
    have h2 : CategoryTheory.Presieve.IsSheaf J₀ (ℋ.obj ⋙ Fgt) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J₀ (ℋ.obj ⋙ Fgt)).mp h1
    exact h2.isSheafFor S_cov.arrows (by rwa [CategoryTheory.Sieve.generate_sieve])
  have hSepEq : ∀ (ℋ : ℳ₀) {V : C₀} {S_cov : CategoryTheory.Sieve V},
      S_cov ∈ J₀ V → ∀ (t₁ t₂ : ℋ.obj.obj (Opposite.op V)),
        (∀ ⦃W : C₀⦄ (f : W ⟶ V), S_cov.arrows f →
          (ℋ.obj.map f.op) t₁ = (ℋ.obj.map f.op) t₂) →
        t₁ = t₂ := by
    intro ℋ V S_cov hS t₁ t₂ hfg
    exact (hShFor ℋ hS).isSeparatedFor.ext (fun _ f hf => hfg f hf)
  have hSepZero : ∀ (ℋ : ℳ₀) {V : C₀} {S_cov : CategoryTheory.Sieve V},
      S_cov ∈ J₀ V → ∀ (t : ℋ.obj.obj (Opposite.op V)),
        (∀ ⦃W : C₀⦄ (f : W ⟶ V), S_cov.arrows f → (ℋ.obj.map f.op) t = 0) →
        t = 0 := by
    intro ℋ V S_cov hS t ht
    refine hSepEq ℋ hS t 0 (fun W f hf => ?_)
    rw [ht f hf, hModZero]
  have mkOmega : ∀ (P' : C₀ → Prop),
      (∀ {W' W : C₀}, Quiver.Hom W' W → P' W → P' W') →
      ∀ (E' : CategoryTheory.Functor ℳ₀ ℳ₀)
        (η' : CategoryTheory.NatTrans (CategoryTheory.Functor.id ℳ₀) E'),
        (∀ 𝒢 : ℳ₀, CategoryTheory.Epi (η'.app 𝒢)) →
        (∀ (𝒢 : ℳ₀) (V : C₀) (s : 𝒢.obj.obj (Opposite.op V)),
          ((η'.app 𝒢).hom.app (Opposite.op V)) s = 0 ↔
            ∃ S_cov ∈ J₀ V, ∀ ⦃W : C₀⦄ (f : Quiver.Hom W V),
              S_cov.arrows f → P' W ∨ (𝒢.obj.map f.op) s = 0) →
        ∃ ω' : ∀ 𝒢 : ℳ₀,
            CategoryTheory.MonoidalCategoryStruct.tensorObj 𝒢.obj (E'.obj One₀).obj ⟶
              (E'.obj 𝒢).obj,
          (∀ 𝒢 : ℳ₀, CategoryTheory.IsIso (L.map (ω' 𝒢))) ∧
          (∀ {𝒢 𝒢' : ℳ₀} (u : 𝒢 ⟶ 𝒢'),
            CategoryTheory.MonoidalCategoryStruct.whiskerRight u.hom (E'.obj One₀).obj ≫ ω' 𝒢' =
              ω' 𝒢 ≫ (E'.map u).hom) ∧
          (∀ 𝒢 : ℳ₀,
            CategoryTheory.MonoidalCategoryStruct.whiskerLeft 𝒢.obj
                (ι_R ≫ (η'.app One₀).hom) ≫ ω' 𝒢 =
              (CategoryTheory.MonoidalCategoryStruct.rightUnitor 𝒢.obj).hom ≫ (η'.app 𝒢).hom) := by
    intro P' hP' E' η' hEpi' hKer'
    have hLocSurj : ∀ 𝒢 : ℳ₀, CategoryTheory.Presheaf.IsLocallySurjective J₀ (η'.app 𝒢).hom :=
      fun 𝒢 => (CategoryTheory.Sheaf.isLocallySurjective_iff_epi'
        (ModuleCat.{u, u} R) (η'.app 𝒢)).mpr (hEpi' 𝒢)
    have hVanish : ∀ (𝒢 : ℳ₀) (V : C₀), P' V →
        ∀ t : (E'.obj 𝒢).obj.obj (Opposite.op V), t = 0 := by
      intro 𝒢 V hPV t
      have : CategoryTheory.Presheaf.IsLocallySurjective J₀ (η'.app 𝒢).hom := hLocSurj 𝒢
      have hS_t : CategoryTheory.Presheaf.imageSieve (η'.app 𝒢).hom t ∈ J₀ V :=
        CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem t
      refine hSepZero (E'.obj 𝒢) hS_t t (fun W f hf => ?_)
      rcases hf with ⟨s, hs⟩
      have h0 : ((η'.app 𝒢).hom.app (Opposite.op W)) s = 0 :=
        (hKer' 𝒢 W s).mpr ⟨⊤, J₀.top_mem W, fun W' g _ => Or.inl (hP' g (hP' f hPV))⟩
      exact hs.symm.trans h0
    let η'_One : One₀.obj ⟶ (E'.obj One₀).obj := (η'.app One₀).hom
    let u_E : c_R ⟶ (E'.obj One₀).obj := ι_R ≫ η'_One
    have hu_E_res : ∀ {W V : C₀} (f : W ⟶ V) (r : R),
        ((E'.obj One₀).obj.map f.op) ((u_E.app (Opposite.op V)) r) =
          (u_E.app (Opposite.op W)) r := by
      intro W V f r
      exact hNatApp u_E f r
    have : CategoryTheory.Presheaf.IsLocallySurjective J₀ η'_One := hLocSurj One₀
    have : CategoryTheory.Presheaf.IsLocallySurjective J₀ u_E := by
      dsimp [u_E]
      infer_instance
    let S_x (V : C₀) (x : (E'.obj One₀).obj.obj (Opposite.op V)) : CategoryTheory.Sieve V :=
      CategoryTheory.Presheaf.imageSieve u_E x
    have hS_x : ∀ (V : C₀) (x : (E'.obj One₀).obj.obj (Opposite.op V)), S_x V x ∈ J₀ V :=
      fun V x => CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem x
    have hScalarEq : ∀ (𝒢 : ℳ₀) (W : C₀) (g : 𝒢.obj.obj (Opposite.op W)) (r₁ r₂ : R),
        (u_E.app (Opposite.op W)) r₁ = (u_E.app (Opposite.op W)) r₂ →
        r₁ • (((η'.app 𝒢).hom.app (Opposite.op W)) g) =
          r₂ • (((η'.app 𝒢).hom.app (Opposite.op W)) g) := by
      intro 𝒢 W g r₁ r₂ hr
      let δ : R := r₁ - r₂
      let m₀ : (E'.obj 𝒢).obj.obj (Opposite.op W) := ((η'.app 𝒢).hom.app (Opposite.op W)) g
      suffices h0 : δ • m₀ = 0 by
        dsimp [δ] at h0
        rwa [sub_smul, sub_eq_zero] at h0
      have hu_δ : ((η'.app One₀).hom.app (Opposite.op W)) ((ι_R.app (Opposite.op W)) δ) = 0 := by
        change (u_E.app (Opposite.op W)) (r₁ - r₂) = 0
        rw [hModSub, hr, sub_self]
      obtain ⟨S_ker, hS_ker, h_ker⟩ := (hKer' One₀ W ((ι_R.app (Opposite.op W)) δ)).mp hu_δ
      refine hSepZero (E'.obj 𝒢) hS_ker (δ • m₀) (fun W' h hh => ?_)
      rcases h_ker h hh with hPW' | hι0
      · exact hVanish 𝒢 W' hPW' _
      · rw [hι_R_res h δ] at hι0
        let δ_c : ToType (c_R.obj (Opposite.op W')) := δ
        let z0_c : ToType (c_R.obj (Opposite.op W')) := (0 : R)
        have hι_eq : (ι_R.app (Opposite.op W')) δ_c = (ι_R.app (Opposite.op W')) z0_c := by
          change (ι_R.app (Opposite.op W')) δ = (ι_R.app (Opposite.op W')) (0 : R)
          rw [hι0, hModZero]
        have hS_eq : CategoryTheory.Presheaf.equalizerSieve δ_c z0_c ∈ J₀ W' :=
          CategoryTheory.Presheaf.IsLocallyInjective.equalizerSieve_mem δ_c z0_c hι_eq
        refine hSepZero (E'.obj 𝒢) hS_eq (((E'.obj 𝒢).obj.map h.op) (δ • m₀)) (fun W'' k hk => ?_)
        have hδ0 : δ = 0 := hk
        rw [hModSmul, hModSmul, hδ0, zero_smul]
    let fam (𝒢 : ℳ₀) (V : C₀) (g : 𝒢.obj.obj (Opposite.op V))
        (x : (E'.obj One₀).obj.obj (Opposite.op V)) :
        CategoryTheory.Presieve.FamilyOfElements ((E'.obj 𝒢).obj ⋙ Fgt) (S_x V x).arrows :=
      fun W f hf =>
        (Classical.choose hf : R) • (((η'.app 𝒢).hom.app (Opposite.op W)) ((𝒢.obj.map f.op) g))
    have hCompat : ∀ (𝒢 : ℳ₀) (V : C₀) (g : 𝒢.obj.obj (Opposite.op V))
        (x : (E'.obj One₀).obj.obj (Opposite.op V)),
        (fam 𝒢 V g x).Compatible := by
      intro 𝒢 V g x Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hgf
      let r₁ : R := Classical.choose hf₁
      let r₂ : R := Classical.choose hf₂
      have hr₁ : (u_E.app (Opposite.op Y₁)) r₁ = ((E'.obj One₀).obj.map f₁.op) x :=
        Classical.choose_spec hf₁
      have hr₂ : (u_E.app (Opposite.op Y₂)) r₂ = ((E'.obj One₀).obj.map f₂.op) x :=
        Classical.choose_spec hf₂
      have hur : (u_E.app (Opposite.op Z)) r₁ = (u_E.app (Opposite.op Z)) r₂ := by
        rw [← hu_E_res g₁ r₁, hr₁, ← hu_E_res g₂ r₂, hr₂]
        change (((E'.obj One₀).obj.map f₁.op ≫ (E'.obj One₀).obj.map g₁.op)) x =
          (((E'.obj One₀).obj.map f₂.op ≫ (E'.obj One₀).obj.map g₂.op)) x
        rw [← (E'.obj One₀).obj.map_comp, ← (E'.obj One₀).obj.map_comp,
          ← op_comp, ← op_comp, hgf]
      change ((E'.obj 𝒢).obj.map g₁.op) (r₁ • (((η'.app 𝒢).hom.app (Opposite.op Y₁)) ((𝒢.obj.map f₁.op) g))) =
        ((E'.obj 𝒢).obj.map g₂.op) (r₂ • (((η'.app 𝒢).hom.app (Opposite.op Y₂)) ((𝒢.obj.map f₂.op) g)))
      rw [hModSmul, hModSmul,
        hNatApp (F := 𝒢.obj) (η'.app 𝒢).hom g₁,
        hNatApp (F := 𝒢.obj) (η'.app 𝒢).hom g₂]
      have hg_eq : (𝒢.obj.map g₁.op) ((𝒢.obj.map f₁.op) g) =
          (𝒢.obj.map g₂.op) ((𝒢.obj.map f₂.op) g) := by
        change ((𝒢.obj.map f₁.op ≫ 𝒢.obj.map g₁.op)) g =
          ((𝒢.obj.map f₂.op ≫ 𝒢.obj.map g₂.op)) g
        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp, hgf]
