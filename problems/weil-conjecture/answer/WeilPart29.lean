                    (Localization.AtPrime (Ideal.comap f J))
                    (Localization.AtPrime J)).subsingleton
                have hUnramLoc : Algebra.FormallyUnramified
                    (Localization.AtPrime (Ideal.comap f J)) (Localization.AtPrime J) :=
                  (Algebra.formallyUnramified_iff
                    (Localization.AtPrime (Ideal.comap f J))
                    (Localization.AtPrime J)).mpr hSubLoc
                change (Localization.localRingHom (Ideal.comap f J) J f rfl).FormallyUnramified
