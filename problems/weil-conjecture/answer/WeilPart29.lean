    have ho₂_σ : CategoryTheory.CategoryStruct.comp o₂ σ = o₂ :=
      (AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom φ_σ) (CommRingCat.ofHom φ_o₂)).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp φ_σ φ_o₂).symm.trans
            (congrArg CommRingCat.ofHom ho₂_σ_ring)))
    have ho₁_i₂ : CategoryTheory.CategoryStruct.comp o₁ i₂ = o₂ := by
      dsimp [i₂]
      rw [← CategoryTheory.Category.assoc, h_orig₂, ho₂_σ]
    have hσ_πR_ring : φ_σ.comp φ_πR = φ_πL := by
      apply MvPolynomial.ringHom_ext'
      · ext a; simp [φ_σ, φ_πR, φ_πL]
      · intro j; fin_cases j; simp [φ_σ, φ_πR, φ_πL, sw]
    have hσ_πR : CategoryTheory.CategoryStruct.comp σ π_R = π_L :=
      (AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom φ_πR) (CommRingCat.ofHom φ_σ)).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp φ_πR φ_σ).symm.trans
            (congrArg CommRingCat.ofHom hσ_πR_ring)))
    have hσ_πL : CategoryTheory.CategoryStruct.comp σ π_L = π_R := by
      rw [← hσ_πR, ← CategoryTheory.Category.assoc, hσσ, CategoryTheory.Category.id_comp]
    have hi₁_πL : CategoryTheory.CategoryStruct.comp i₁ π_L = CategoryTheory.CategoryStruct.id A₁ :=
      (AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom φ_πL) (CommRingCat.ofHom φ_i₁)).symm.trans
        ((congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp φ_πL φ_i₁).symm.trans
            ((congrArg CommRingCat.ofHom h_πL_i₁_ring).trans
              CommRingCat.ofHom_id))).trans
          (AlgebraicGeometry.Spec.map_id _))
    have hi₂_πR : CategoryTheory.CategoryStruct.comp i₂ π_R = CategoryTheory.CategoryStruct.id A₁ := by
      dsimp [i₂]
      rw [CategoryTheory.Category.assoc, hσ_πR, hi₁_πL]
    have hpb₁ : CategoryTheory.IsPullback i₁ (weilGysinAffineStruct k 1) π_R o₁ := by
      apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        (CommRingCat.ofHom φ_πR) (CommRingCat.ofHom φ_o₁)
        (CommRingCat.ofHom φ_i₁) (CommRingCat.ofHom MvPolynomial.C)
      have hcomm₁ : CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_πR)
          (CommRingCat.ofHom φ_i₁) =
          CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_o₁)
            (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k)) := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 1
        apply MvPolynomial.ringHom_ext'
        · ext a; simp [φ_πR, φ_i₁, φ_o₁]
        · intro j; fin_cases j; simp [φ_πR, φ_i₁, φ_o₁, Fin.addCases]
      refine CategoryTheory.IsPushout.mk ⟨hcomm₁⟩ ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm₁
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun _ => s.inl.hom (MvPolynomial.X 0))))
        (fun s => ?_) (fun s => ?_) (fun s m hm₁ hm₂ => ?_)⟩
      · have hsc := congrArg CommRingCat.Hom.hom s.condition
        have hC : ∀ a : k, s.inl.hom (MvPolynomial.C a) = s.inr.hom a := by
          intro a
          have h2 := RingHom.congr_fun hsc (MvPolynomial.C a)
          simpa [φ_πR, φ_o₁] using h2
        have hX1 : s.inl.hom (MvPolynomial.X 1) = 0 := by
          have h2 := RingHom.congr_fun hsc (MvPolynomial.X 0)
          simpa [φ_πR, φ_o₁, Fin.natAdd] using h2
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · ext a; simp [φ_i₁, hC a]
        · intro b
          fin_cases b
          · simp [φ_i₁, Fin.addCases]
          · simp [φ_i₁, Fin.addCases, hX1]
      · ext a
        simp
      · apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · ext a
          have h2 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₂) a
          simpa using h2
        · intro j
          fin_cases j
          have h1 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₁) (MvPolynomial.X 0)
          simpa [φ_i₁, Fin.addCases] using h1
    have hpb₂ : CategoryTheory.IsPullback i₂ (weilGysinAffineStruct k 1) π_L o₁ := by
      have hcomm₂ : CategoryTheory.CategoryStruct.comp i₂ π_L =
          CategoryTheory.CategoryStruct.comp (weilGysinAffineStruct k 1) o₁ := by
        dsimp [i₂]
        rw [CategoryTheory.Category.assoc, hσ_πL, hpb₁.w]
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm₂
          (fun s => hpb₁.lift (CategoryTheory.CategoryStruct.comp s.fst σ) s.snd
            (by rw [CategoryTheory.Category.assoc, hσ_πR, s.condition]))
          (fun s => by
            dsimp [i₂]
            rw [← CategoryTheory.Category.assoc, hpb₁.lift_fst,
              CategoryTheory.Category.assoc, hσσ, CategoryTheory.Category.comp_id])
          (fun s => hpb₁.lift_snd _ _ _)
          (fun s m hm₁ hm₂ => by
            apply hpb₁.hom_ext
            · rw [hpb₁.lift_fst]
              calc
                CategoryTheory.CategoryStruct.comp m i₁ =
                    CategoryTheory.CategoryStruct.comp m
                      (CategoryTheory.CategoryStruct.comp i₁
                        (CategoryTheory.CategoryStruct.comp σ σ)) := by
                  rw [hσσ, CategoryTheory.Category.comp_id]
                _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp m i₂) σ := by
                  dsimp [i₂]; simp only [CategoryTheory.Category.assoc]
                _ = CategoryTheory.CategoryStruct.comp s.fst σ := by rw [hm₁]
            · rw [hpb₁.lift_snd, hm₂]))
    have hpb₃ : CategoryTheory.IsPullback o₁ o₁ i₁ i₂ := by
      let φ_i₂ : MvPolynomial (Fin 2) k →+* MvPolynomial (Fin 1) k := φ_i₁.comp φ_σ
      have hi₂_eq : i₂ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_i₂) :=
        (AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom φ_σ) (CommRingCat.ofHom φ_i₁)).symm.trans
          (congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp φ_σ φ_i₁).symm)
      rw [hi₂_eq]
      apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        (CommRingCat.ofHom φ_i₁) (CommRingCat.ofHom φ_i₂)
        (CommRingCat.ofHom φ_o₁) (CommRingCat.ofHom φ_o₁)
      have hcomm₃ : CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_i₁)
          (CommRingCat.ofHom φ_o₁) =
          CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_i₂)
            (CommRingCat.ofHom φ_o₁) := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 1
        apply MvPolynomial.ringHom_ext'
        · ext a; simp [φ_i₁, φ_i₂, φ_σ, φ_o₁]
        · intro b; fin_cases b <;> simp [φ_i₁, φ_i₂, φ_σ, φ_o₁, sw, Fin.addCases]
      refine CategoryTheory.IsPushout.mk ⟨hcomm₃⟩ ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm₃
        (fun s => CommRingCat.ofHom (s.inl.hom.comp MvPolynomial.C))
        (fun s => ?_) (fun s => ?_) (fun s m hm₁ _ => ?_)⟩
      · apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · ext a; simp [φ_o₁]
        · intro j
          fin_cases j
          have hX0 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) (MvPolynomial.X 0)
          have h0 : s.inl.hom (MvPolynomial.X 0) = 0 := by
            simpa [φ_i₁, φ_i₂, φ_σ, sw, Fin.addCases] using hX0
          simp [φ_o₁, h0]
      · apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · ext a
          have hC := RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) (MvPolynomial.C a)
          have hCa : s.inl.hom (MvPolynomial.C a) = s.inr.hom (MvPolynomial.C a) := by
            simpa [φ_i₁, φ_i₂, φ_σ] using hC
          simp [φ_o₁, hCa]
        · intro j
          fin_cases j
          have hX1 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) (MvPolynomial.X 1)
          have h0 : s.inr.hom (MvPolynomial.X 0) = 0 := by
            simpa [φ_i₁, φ_i₂, φ_σ, sw, Fin.addCases] using hX1.symm
          simp [φ_o₁, h0]
      · apply CommRingCat.hom_ext
        ext a
        have h1 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₁) (MvPolynomial.C a)
        simpa [φ_o₁] using h1
    exact weil_gysin_affine_axis_recollement_and_swap_pullback.{u} k (ℓ ^ r)
      (fun J₀ =>
        (weil_gysin_small_site_module_tensor_koszul_even_comm.{u}
          (CategoryTheory.SmallModel.{u} A₂.AffineEtale) J₀ (ULift.{u, 0} (ZMod (ℓ ^ r)))).2)
      τ₁ h_orig₂ τ_axis₂ τ₂ h22
      ⟨ho₁_cl, ho₂_cl, hi₁_cl, hi₂_cl⟩
      ⟨hσσ, ho₂_σ, ho₁_i₂, hσ_πR, hσ_πL, hi₁_πL, hi₂_πR⟩
      ⟨hpb₁, hpb₂, hpb₃⟩
      hpb_axis hGys₂

theorem weil_gysin_smooth_etale_origin_chart_and_fiber_shrink (k : Type u) [Field k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    (∀ (c : ℕ) (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Quiver.Hom Y S_k)
        (s : Quiver.Hom S_k Y)
        (_hs : CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k)
        (V₀ : Y.Opens)
        (s_V₀ : Quiver.Hom S_k V₀.toScheme)
        (_hs_V₀ : CategoryTheory.CategoryStruct.comp s_V₀ V₀.ι = s)
        (u₀ : Quiver.Hom V₀.toScheme (weilGysinAffineSpace k c)),
      AlgebraicGeometry.Etale u₀ →
      CategoryTheory.CategoryStruct.comp u₀ (weilGysinAffineStruct k c) =
        CategoryTheory.CategoryStruct.comp V₀.ι p_Y →
      CategoryTheory.CategoryStruct.comp s_V₀ u₀ = weilGysinAffineOrigin k c →
      ∃ (U : Y.Opens) (hle : U ≤ V₀) (s_U : Quiver.Hom S_k U.toScheme),
        WeilGysinIsEtaleOriginChart c p_Y s U s_U
          (CategoryTheory.CategoryStruct.comp (Y.homOfLE hle) u₀)) ∧
    (∀ (c : ℕ) (Y : CategoryTheory.Over S_k)
        [AlgebraicGeometry.SmoothOfRelativeDimension c Y.hom]
        (s : Quiver.Hom S_k Y.left),
      CategoryTheory.CategoryStruct.comp s Y.hom = CategoryTheory.CategoryStruct.id S_k →
      ∃ (U : Y.left.Opens) (s_U : Quiver.Hom S_k U.toScheme)
        (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k c)),
        WeilGysinIsEtaleOriginChart c Y.hom s U s_U u) :=
by
  intro S_k
  have hShrink : ∀ (c : ℕ) (Y : AlgebraicGeometry.Scheme.{u})
      (p_Y : Quiver.Hom Y S_k)
      (s : Quiver.Hom S_k Y)
      (_hs : CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k)
      (V₀ : Y.Opens)
      (s_V₀ : Quiver.Hom S_k V₀.toScheme)
      (_hs_V₀ : CategoryTheory.CategoryStruct.comp s_V₀ V₀.ι = s)
      (u₀ : Quiver.Hom V₀.toScheme (weilGysinAffineSpace k c)),
    AlgebraicGeometry.Etale u₀ →
    CategoryTheory.CategoryStruct.comp u₀ (weilGysinAffineStruct k c) =
      CategoryTheory.CategoryStruct.comp V₀.ι p_Y →
    CategoryTheory.CategoryStruct.comp s_V₀ u₀ = weilGysinAffineOrigin k c →
    ∃ (U : Y.Opens) (hle : U ≤ V₀) (s_U : Quiver.Hom S_k U.toScheme),
      WeilGysinIsEtaleOriginChart c p_Y s U s_U
        (CategoryTheory.CategoryStruct.comp (Y.homOfLE hle) u₀) := by
    intro c Y p_Y s _hs V₀ s_V₀ hs_V₀ u₀ hu₀_et hu₀_str hs_u₀
    let orig : S_k ⟶ weilGysinAffineSpace k c := weilGysinAffineOrigin k c
    have h_eval_surj : Function.Surjective
        (CommRingCat.Hom.hom (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin c → k)))) := by
      intro a
      exact ⟨MvPolynomial.C a, by simp⟩
    have : AlgebraicGeometry.IsClosedImmersion orig :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin c → k))) h_eval_surj
    have : AlgebraicGeometry.Etale u₀ := hu₀_et
    let F₀ := CategoryTheory.Limits.pullback u₀ orig
    let π₁ : F₀ ⟶ V₀.toScheme := CategoryTheory.Limits.pullback.fst u₀ orig
    let π₂ : F₀ ⟶ S_k := CategoryTheory.Limits.pullback.snd u₀ orig
    have : AlgebraicGeometry.IsClosedImmersion π₁ := inferInstance
    have : AlgebraicGeometry.Etale π₂ := inferInstance
    have : AlgebraicGeometry.FormallyUnramified π₂ := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType π₂ := inferInstance
    let σ₀ : S_k ⟶ F₀ :=
      CategoryTheory.Limits.pullback.lift s_V₀ (𝟙 S_k)
        (hs_u₀.trans (CategoryTheory.Category.id_comp orig).symm)
    have hσ₀_π₁ : σ₀ ≫ π₁ = s_V₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hσ₀_π₂ : σ₀ ≫ π₂ = 𝟙 S_k := CategoryTheory.Limits.pullback.lift_snd _ _ _
    let Δ_F := CategoryTheory.Limits.pullback.diagonal π₂
    have hcond_gF : 𝟙 F₀ ≫ π₂ = (π₂ ≫ σ₀) ≫ π₂ := by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hσ₀_π₂,
        CategoryTheory.Category.comp_id]
    let g_F := CategoryTheory.Limits.pullback.lift (𝟙 F₀) (π₂ ≫ σ₀) hcond_gF
    have h_σ0_sq : σ₀ ≫ Δ_F = σ₀ ≫ g_F := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc, hσ₀_π₂,
          CategoryTheory.Category.id_comp]
    have hcone_fst : ∀ cone : CategoryTheory.Limits.PullbackCone Δ_F g_F,
        (cone.snd ≫ π₂) ≫ σ₀ = cone.fst := by
      intro cone
      symm
      calc
        cone.fst = cone.fst ≫ (Δ_F ≫ CategoryTheory.Limits.pullback.snd π₂ π₂) := by
          rw [CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id]
        _ = (cone.fst ≫ Δ_F) ≫ CategoryTheory.Limits.pullback.snd π₂ π₂ := by
          rw [CategoryTheory.Category.assoc]
        _ = (cone.snd ≫ g_F) ≫ CategoryTheory.Limits.pullback.snd π₂ π₂ := by
          rw [cone.condition]
        _ = (cone.snd ≫ π₂) ≫ σ₀ := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc]
    have hpb_σ : CategoryTheory.IsPullback σ₀ σ₀ Δ_F g_F := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk h_σ0_sq
          (fun cone => cone.snd ≫ π₂)
          (fun cone => hcone_fst cone)
          (fun cone => ?_)
          (fun cone m _ hm₂ => ?_))
      · have h1 : cone.fst = cone.snd := by
          calc
            cone.fst = cone.fst ≫ (Δ_F ≫ CategoryTheory.Limits.pullback.fst π₂ π₂) := by
              rw [CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id]
            _ = (cone.fst ≫ Δ_F) ≫ CategoryTheory.Limits.pullback.fst π₂ π₂ := by
              rw [CategoryTheory.Category.assoc]
            _ = (cone.snd ≫ g_F) ≫ CategoryTheory.Limits.pullback.fst π₂ π₂ := by
              rw [cone.condition]
            _ = cone.snd := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.comp_id]
        exact (hcone_fst cone).trans h1
      · calc
          m = m ≫ 𝟙 S_k := (CategoryTheory.Category.comp_id m).symm
          _ = m ≫ (σ₀ ≫ π₂) := by rw [hσ₀_π₂]
          _ = (m ≫ σ₀) ≫ π₂ := (CategoryTheory.Category.assoc m σ₀ π₂).symm
          _ = cone.snd ≫ π₂ := by rw [hm₂]
    have hΔ_open : AlgebraicGeometry.IsOpenImmersion Δ_F :=
      AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal π₂
    have : AlgebraicGeometry.IsOpenImmersion σ₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_σ hΔ_open
    let K_spur : Set ↥F₀ := (Set.range σ₀.base)ᶜ
    have hK_closed : IsClosed K_spur := σ₀.isOpenEmbedding.isOpen_range.isClosed_compl
    let C_spur : Set ↥V₀.toScheme := π₁.base '' K_spur
    have hC_closed : IsClosed C_spur := π₁.isClosedEmbedding.isClosedMap K_spur hK_closed
    let W_set : Set ↥V₀.toScheme := C_spurᶜ
    have hW_open : IsOpen W_set := hC_closed.isOpen_compl
    let U : Y.Opens := ⟨V₀.ι.base '' W_set, V₀.ι.isOpenEmbedding.isOpenMap W_set hW_open⟩
    have hle : U ≤ V₀ := by
      rintro y ⟨z, _, rfl⟩
      change V₀.ι.base z ∈ (V₀ : Set ↥Y)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι V₀]
      exact ⟨z, rfl⟩
    let j : U.toScheme ⟶ V₀.toScheme := Y.homOfLE hle
    have hz_j : ∀ z : ↥V₀.toScheme, z ∈ j.opensRange ↔ z ∈ W_set := by
      intro z
      change z ∈ Set.range j.base ↔ z ∈ W_set
      have h_im : V₀.ι.base z ∈ (U : Set ↥Y) ↔ z ∈ W_set :=
        V₀.ι.isOpenEmbedding.injective.mem_set_image
      rw [← h_im, ← AlgebraicGeometry.Scheme.Opens.range_ι U]
      constructor
      · rintro ⟨w, rfl⟩
        refine ⟨w, ?_⟩
        change U.ι.base w = (j ≫ V₀.ι).base w
        rw [Y.homOfLE_ι hle]
      · rintro ⟨w, hw⟩
        refine ⟨w, V₀.ι.isOpenEmbedding.injective ?_⟩
        change (j ≫ V₀.ι).base w = V₀.ι.base z
        rw [Y.homOfLE_ι hle]
        exact hw
    let pt₀ : ↥S_k := default
    have hs_pt_mem : π₁.base (σ₀.base pt₀) ∈ W_set := by
      intro hmem
      have h_in_K : σ₀.base pt₀ ∈ K_spur :=
        (π₁.isClosedEmbedding.injective.mem_set_image).mp hmem
      exact h_in_K ⟨pt₀, rfl⟩
    have hs_range : Set.range s.base ⊆ Set.range U.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι U]
      rintro _ ⟨x, rfl⟩
      have hx : x = pt₀ := Subsingleton.elim x pt₀
      rw [hx]
      have hs_eq : s.base pt₀ = V₀.ι.base (π₁.base (σ₀.base pt₀)) := by
        calc
          s.base pt₀ = (s_V₀ ≫ V₀.ι).base pt₀ := by rw [hs_V₀]
          _ = ((σ₀ ≫ π₁) ≫ V₀.ι).base pt₀ := by rw [hσ₀_π₁]
          _ = V₀.ι.base (π₁.base (σ₀.base pt₀)) := rfl
      rw [hs_eq]
      exact ⟨π₁.base (σ₀.base pt₀), hs_pt_mem, rfl⟩
    let s_U : S_k ⟶ U.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U.ι s hs_range
    have hs_U_ι : s_U ≫ U.ι = s := AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι s hs_range
    have h_comm_top : σ₀ ≫ π₁ = s_U ≫ j := by
      apply (cancel_mono V₀.ι).mp
      rw [hσ₀_π₁, hs_V₀, CategoryTheory.Category.assoc, Y.homOfLE_ι hle, hs_U_ι]
    have h_opens : (TopologicalSpace.Opens.map π₁.base).obj j.opensRange = σ₀.opensRange := by
      ext q
      change π₁.base q ∈ j.opensRange ↔ q ∈ σ₀.opensRange
      rw [hz_j (π₁.base q)]
      change π₁.base q ∉ π₁.base '' (Set.range σ₀.base)ᶜ ↔ q ∈ Set.range σ₀.base
      rw [π₁.isClosedEmbedding.injective.mem_set_image]
      exact not_not
    have hpb_top : CategoryTheory.IsPullback s_U σ₀ j π₁ :=
      AlgebraicGeometry.IsOpenImmersion.isPullback s_U σ₀ j π₁ h_comm_top h_opens
    have hpb_u : CategoryTheory.IsPullback s_U (𝟙 S_k) (j ≫ u₀) orig := by
      have hp := CategoryTheory.IsPullback.paste_vert hpb_top
        (CategoryTheory.IsPullback.of_hasPullback u₀ orig)
      rwa [hσ₀_π₂] at hp
    have hu_str : (j ≫ u₀) ≫ weilGysinAffineStruct k c = U.ι ≫ p_Y := by
      rw [CategoryTheory.Category.assoc, hu₀_str, ← CategoryTheory.Category.assoc,
        Y.homOfLE_ι hle]
    exact ⟨U, hle, s_U, ⟨inferInstance, hu_str, hs_U_ι, hpb_u⟩⟩
  refine ⟨hShrink, ?_⟩
  intro c Y _ s hs
  let pt₀ : ↥S_k := default
  obtain ⟨U_base, _hU_base, V₀, hV₀, hs_mem, e, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff c Y.hom).mp inferInstance (s.base pt₀)
  have hU_top : U_base = ⊤ := by
    have hpt_mem : pt₀ ∈ U_base := by
      have hy : Y.hom.base (s.base pt₀) ∈ U_base := e hs_mem
      have hcomp : Y.hom.base (s.base pt₀) = pt₀ := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hs]
        rfl
      rwa [hcomp] at hy
    ext z
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hz : z = pt₀ := Subsingleton.elim z pt₀
    rwa [hz]
  subst hU_top
  obtain ⟨g_raw, hg_raw_C, hg_raw_et⟩ :=
    RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd
  let α_iso := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
  let α : k →+* ↑(S_k.presheaf.obj (Opposite.op ⊤)) := α_iso.inv.hom
  let α_inv : ↑(S_k.presheaf.obj (Opposite.op ⊤)) →+* k := α_iso.hom.hom
  have hα_left : α_inv.comp α = RingHom.id k := by
    ext x
    exact ConcreteCategory.congr_hom α_iso.inv_hom_id x
  have hα_right : α.comp α_inv = RingHom.id _ := by
    ext x
    exact ConcreteCategory.congr_hom α_iso.hom_inv_id x
  let M_α : MvPolynomial (Fin c) k →+*
      MvPolynomial (Fin c) ↑(S_k.presheaf.obj (Opposite.op ⊤)) :=
    MvPolynomial.map α
  have hM_bij : Function.Bijective M_α := by
    refine Function.bijective_iff_has_inverse.mpr ⟨MvPolynomial.map α_inv, ?_, ?_⟩
    · intro p
      dsimp [M_α]
      rw [MvPolynomial.map_map, hα_left, MvPolynomial.map_id]
    · intro p
      dsimp [M_α]
      rw [MvPolynomial.map_map, hα_right, MvPolynomial.map_id]
  have hM_et : M_α.Etale := RingHom.Etale.of_bijective hM_bij
  let g' : MvPolynomial (Fin c) k →+* ↑(Y.left.presheaf.obj (Opposite.op V₀)) :=
    g_raw.comp M_α
  have hg'_et : g'.Etale := RingHom.Etale.stableUnderComposition M_α g_raw hM_et hg_raw_et
  let u' : V₀.toScheme ⟶ weilGysinAffineSpace k c :=
    V₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom g')
  have : CategoryTheory.IsIso V₀.toSpecΓ := by
    rw [← hV₀.isoSpec_hom]
    infer_instance
  have h_map_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g')) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg'_et
  have hu'_et : AlgebraicGeometry.Etale u' := by
    dsimp [u', weilGysinAffineSpace]
    infer_instance
  have hg'_C_hom : CommRingCat.ofHom (g'.comp MvPolynomial.C) =
      α_iso.inv ≫ Y.hom.appLE ⊤ V₀ e := by
    ext x
    change g_raw (MvPolynomial.map α (MvPolynomial.C x)) = (Y.hom.appLE ⊤ V₀ e).hom (α x)
    rw [MvPolynomial.map_C]
    exact RingHom.congr_fun hg_raw_C (α x)
  have hu'_str : u' ≫ weilGysinAffineStruct k c = V₀.ι ≫ Y.hom := by
    dsimp [u', weilGysinAffineStruct, weilGysinAffineSpace]
    rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hg'_C_hom, AlgebraicGeometry.Spec.map_comp]
    have hfrom_top : (AlgebraicGeometry.isAffineOpen_top S_k).fromSpec =
        AlgebraicGeometry.Spec.map α_iso.inv := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      exact AlgebraicGeometry.Scheme.isoSpec_Spec_inv (CommRingCat.of k)
    have happ := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Y.hom
      (AlgebraicGeometry.isAffineOpen_top S_k) hV₀ e
    rw [hfrom_top] at happ
    rw [happ, ← CategoryTheory.Category.assoc, hV₀.toSpecΓ_fromSpec]
  have hs_V₀_range : Set.range s.base ⊆ Set.range V₀.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι V₀]
    rintro _ ⟨z, rfl⟩
    have hz : z = pt₀ := Subsingleton.elim z pt₀
    rw [hz]
    exact hs_mem
  let s_V₀ : S_k ⟶ V₀.toScheme := AlgebraicGeometry.IsOpenImmersion.lift V₀.ι s hs_V₀_range
  have hs_V₀ : s_V₀ ≫ V₀.ι = s := AlgebraicGeometry.IsOpenImmersion.lift_fac V₀.ι s hs_V₀_range
  let ev₀_hom : CommRingCat.of (MvPolynomial (Fin c) k) ⟶ CommRingCat.of k :=
    AlgebraicGeometry.Spec.preimage (s_V₀ ≫ u')
  let ev₀ : MvPolynomial (Fin c) k →+* k := ev₀_hom.hom
  have hev₀_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) = s_V₀ ≫ u' :=
    AlgebraicGeometry.Spec.map_preimage (s_V₀ ≫ u')
  have hev₀_C : ev₀.comp MvPolynomial.C = RingHom.id k := by
    have hspec : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ev₀) =
        AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id]
      have hcomp_str : (s_V₀ ≫ u') ≫ weilGysinAffineStruct k c = 𝟙 S_k := by
        rw [CategoryTheory.Category.assoc, hu'_str, ← CategoryTheory.Category.assoc, hs_V₀, hs]
      rw [← hev₀_spec] at hcomp_str
      exact hcomp_str
    have hcat := AlgebraicGeometry.Spec.map_injective hspec
    ext r
    exact ConcreteCategory.congr_hom hcat r
  let a : Fin c → k := fun i => ev₀ (MvPolynomial.X i)
  let tr_hom : MvPolynomial (Fin c) k →+* MvPolynomial (Fin c) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i - MvPolynomial.C (a i))
  let tr_inv : MvPolynomial (Fin c) k →+* MvPolynomial (Fin c) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i + MvPolynomial.C (a i))
  have htr_inv_hom : tr_inv.comp tr_hom = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro r; simp [tr_hom, tr_inv]
    · intro i; simp [tr_hom, tr_inv]
  have htr_hom_inv : tr_hom.comp tr_inv = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro r; simp [tr_hom, tr_inv]
    · intro i; simp [tr_hom, tr_inv]
  let T_c : weilGysinAffineSpace k c ⟶ weilGysinAffineSpace k c :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom tr_hom)
  have : CategoryTheory.IsIso T_c := by
    refine ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom tr_inv), ?_, ?_⟩⟩
    · dsimp [T_c, weilGysinAffineSpace]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, htr_hom_inv,
        CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    · dsimp [T_c, weilGysinAffineSpace]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, htr_inv_hom,
        CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hTc_str : T_c ≫ weilGysinAffineStruct k c = weilGysinAffineStruct k c := by
    dsimp [T_c, weilGysinAffineStruct, weilGysinAffineSpace]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext r
    simp [tr_hom]
  let u₀ : V₀.toScheme ⟶ weilGysinAffineSpace k c := u' ≫ T_c
  have hu₀_et : AlgebraicGeometry.Etale u₀ := inferInstance
  have hu₀_str : u₀ ≫ weilGysinAffineStruct k c = V₀.ι ≫ Y.hom := by
    change (u' ≫ T_c) ≫ weilGysinAffineStruct k c = V₀.ι ≫ Y.hom
    rw [CategoryTheory.Category.assoc, hTc_str, hu'_str]
  have hs_u₀ : s_V₀ ≫ u₀ = weilGysinAffineOrigin k c := by
    change s_V₀ ≫ (u' ≫ T_c) = weilGysinAffineOrigin k c
    rw [← CategoryTheory.Category.assoc, ← hev₀_spec]
    dsimp [S_k, T_c, weilGysinAffineOrigin, weilGysinAffineSpace]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply MvPolynomial.ringHom_ext
    · intro r
      have hr := RingHom.congr_fun hev₀_C r
      simpa [tr_hom] using hr
    · intro i
      have hi : ev₀ (MvPolynomial.C (a i)) = a i := RingHom.congr_fun hev₀_C (a i)
      simp [tr_hom, a, hi]
  obtain ⟨U, hle, s_U, hChart⟩ :=
    hShrink c Y.left Y.hom s hs V₀ s_V₀ hs_V₀ u₀ hu₀_et hu₀_str hs_u₀
  exact ⟨U, s_U, Y.left.homOfLE hle ≫ u₀, hChart⟩

theorem weil_gysin_projLine_integral_and_smooth (k : Type u) [Field k] :
    AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left ∧
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom :=
by
  classical
  let P₂ := MvPolynomial (Fin 2) k
  let P₁ := MvPolynomial (Fin 1) k
  let 𝒜 : ℕ → Submodule k P₂ := MvPolynomial.homogeneousSubmodule (Fin 2) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hX : ∀ j : Fin 2, (MvPolynomial.X j : P₂) ∈ 𝒜 1 := fun j =>
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X j)).mpr
      (MvPolynomial.isHomogeneous_X k j)
  
  have hChartEquiv : ∀ a : Fin 2,
      ∃ e : P₁ ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a),
        ∀ c : k,
          e (MvPolynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a))
              (algebraMap k ↥(𝒜 0) c) := by
    intro a
    let S : Submonoid P₂ := Submonoid.powers (MvPolynomial.X a)
    let R_a := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)
    let b_other : Fin 2 := if a = 0 then 1 else 0
    have hb_ne : b_other ≠ a := by
      fin_cases a <;> decide
    have hj_other : ∀ j : Fin 2, j ≠ a → j = b_other := by
      intro j hj
      fin_cases a <;> fin_cases j <;> simp_all [b_other]
    let s₁ : S := ⟨MvPolynomial.X a, Submonoid.mem_powers (MvPolynomial.X a)⟩
    let ι_k : k →+* R_a :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S).comp (algebraMap k ↥(𝒜 0))
    have hι_k_val : ∀ c : k,
        (ι_k c).val = Localization.mk (MvPolynomial.C c : P₂) 1 := by
      intro c
      change (HomogeneousLocalization.fromZeroRingHom 𝒜 S (algebraMap k ↥(𝒜 0) c)).val =
        Localization.mk (MvPolynomial.C c : P₂) 1
      simp only [HomogeneousLocalization.fromZeroRingHom]
      rfl
    let u₀ : R_a :=
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X b_other, hX b_other⟩, ⟨MvPolynomial.X a, hX a⟩,
          Submonoid.mem_powers (MvPolynomial.X a)⟩
    have hu₀_val : u₀.val = Localization.mk (MvPolynomial.X b_other : P₂) s₁ :=
      HomogeneousLocalization.val_mk _
    let α : P₁ →+* R_a := MvPolynomial.eval₂Hom ι_k (fun _ : Fin 1 => u₀)
    let w : Fin 2 → P₁ := fun j => if j = a then 1 else MvPolynomial.X 0
    let dehom : P₂ →+* P₁ := MvPolynomial.eval₂Hom MvPolynomial.C w
    have hdehom_S : ∀ y : S, dehom y.1 = 1 := by
      intro y
      obtain ⟨m, hm⟩ := y.2
      dsimp only at hm
      rw [← hm, map_pow]
      have hw_a : dehom (MvPolynomial.X a) = 1 := by
        dsimp only [dehom, w]
        rw [MvPolynomial.eval₂Hom_X']
        simp
      rw [hw_a, one_pow]
    have hUnit : ∀ y : S, IsUnit (dehom y.1) := by
      intro y
      rw [hdehom_S y]
      exact isUnit_one
    let β_loc : Localization S →+* P₁ :=
      IsLocalization.lift (M := S) (S := Localization S) hUnit
    have hβ_loc_mk : ∀ (p : P₂) (y : S), β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec (M := S) (S := Localization S)
        hUnit p (dehom p) y).mpr (by rw [hdehom_S y, one_mul])
    let valHom : R_a →+* Localization S :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let β : R_a →+* P₁ := β_loc.comp valHom
    have hLeft_hom : β.comp α = RingHom.id P₁ := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply]
        have hαc : α (MvPolynomial.C c) = ι_k c := MvPolynomial.eval₂Hom_C ι_k _ c
        rw [hαc]
        change β_loc (ι_k c).val = MvPolynomial.C c
        rw [hι_k_val c, hβ_loc_mk]
        exact MvPolynomial.eval₂Hom_C MvPolynomial.C w c
      · intro i
        rw [Fin.eq_zero i, RingHom.comp_apply, RingHom.id_apply]
        have hα0 : α (MvPolynomial.X 0) = u₀ := MvPolynomial.eval₂Hom_X' ι_k _ 0
        rw [hα0]
        change β_loc u₀.val = MvPolynomial.X 0
        rw [hu₀_val, hβ_loc_mk]
        dsimp only [dehom, w]
        rw [MvPolynomial.eval₂Hom_X']
        simp [hb_ne]
    have hLeft : Function.LeftInverse β α := fun q =>
      RingHom.congr_fun hLeft_hom q
    let φ : P₂ →+* Localization S := valHom.comp (α.comp dehom)
    have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c : P₂) 1 := by
      intro c
      change (α (dehom (MvPolynomial.C c))).val = _
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      exact hι_k_val c
    have hφ_X : ∀ j : Fin 2, φ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j : P₂) s₁ := by
      intro j
      change (α (dehom (MvPolynomial.X j))).val = _
      rw [MvPolynomial.eval₂Hom_X']
      by_cases hja : j = a
      · subst hja
        simp only [w, ↓reduceIte, map_one, HomogeneousLocalization.val_one]
        exact (Localization.mk_self s₁).symm
      · have hjb : j = b_other := hj_other j hja
        subst hjb
        have hw_b : w b_other = MvPolynomial.X 0 := by simp [w, hb_ne]
        have hα0 : α (MvPolynomial.X 0) = u₀ := MvPolynomial.eval₂Hom_X' ι_k _ 0
        rw [hw_b, hα0, hu₀_val]
    have hφ_prod : ∀ (d : Fin 2 →₀ ℕ) (F : Finset (Fin 2)),
        φ (∏ j ∈ F, (MvPolynomial.X j : P₂) ^ d j) =
          Localization.mk (∏ j ∈ F, (MvPolynomial.X j : P₂) ^ d j)
            (s₁ ^ (∑ j ∈ F, d j)) := by
      intro d F
      induction F using Finset.induction_on with
      | empty =>
        simp [Localization.mk_one]
      | @insert j₀ F' hj₀ ih =>
        rw [Finset.prod_insert hj₀, Finset.sum_insert hj₀, map_mul, map_pow,
          hφ_X j₀, Localization.mk_pow, ih, Localization.mk_mul, pow_add]
    have hφ_monomial : ∀ (d : Fin 2 →₀ ℕ) (c : k),
        φ (MvPolynomial.monomial d c) =
          Localization.mk (MvPolynomial.monomial d c) (s₁ ^ d.degree) := by
      intro d c
      rw [MvPolynomial.monomial_eq, map_mul, hφ_C c]
      change Localization.mk (MvPolynomial.C c : P₂) 1 *
          φ (∏ j ∈ d.support, (MvPolynomial.X j : P₂) ^ d j) = _
      rw [hφ_prod d d.support, Localization.mk_mul, one_mul]
      rfl
    have hφ_homog : ∀ (n : ℕ) (p : P₂), p.IsHomogeneous n →
        φ p = Localization.mk p (s₁ ^ n) := by
      intro n p hp
      have hφ_sum : ∀ (G : Finset (Fin 2 →₀ ℕ)), G ⊆ p.support →
          φ (∑ d ∈ G, MvPolynomial.monomial d (p.coeff d)) =
            Localization.mk (∑ d ∈ G, MvPolynomial.monomial d (p.coeff d)) (s₁ ^ n) := by
        intro G hG
        induction G using Finset.induction_on with
        | empty =>
          simp [Localization.mk_zero]
        | @insert d₀ G' hd₀ ih =>
          have hd₀_mem : d₀ ∈ p.support := hG (Finset.mem_insert_self d₀ G')
          have hcoeff_ne : p.coeff d₀ ≠ 0 := MvPolynomial.mem_support_iff.mp hd₀_mem
          have hdeg_eq : d₀.degree = n := by
            by_contra hne
            exact hcoeff_ne (hp.coeff_eq_zero hne)
          rw [Finset.sum_insert hd₀, map_add, hφ_monomial, hdeg_eq,
            ih ((Finset.subset_insert d₀ G').trans hG), Localization.add_mk_self]
      conv_lhs => rw [MvPolynomial.as_sum p]
      rw [hφ_sum p.support Finset.Subset.rfl, ← MvPolynomial.as_sum p]
    have hRight : Function.RightInverse β α := by
      intro z
      refine Quotient.inductionOn' z (fun nd => ?_)
      apply HomogeneousLocalization.val_injective S
      obtain ⟨n, hn⟩ := nd.den_mem
      dsimp only at hn
      have hXa_pow_ne : ((MvPolynomial.X a : P₂) ^ n) ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (1 : k))) h0
        simp at hev
      have hsupp_ne : ((MvPolynomial.X a : P₂) ^ n).support.Nonempty := by
        rw [Finset.nonempty_iff_ne_empty]
        intro hemp
        apply hXa_pow_ne
        have hsum := MvPolynomial.as_sum ((MvPolynomial.X a : P₂) ^ n)
        rw [hemp, Finset.sum_empty] at hsum
        exact hsum
      obtain ⟨d₀, hd₀_mem⟩ := hsupp_ne
      have hd₀ : ((MvPolynomial.X a : P₂) ^ n).coeff d₀ ≠ 0 :=
        MvPolynomial.mem_support_iff.mp hd₀_mem
      have hpow_hom : ((MvPolynomial.X a : P₂) ^ n).IsHomogeneous n := by
        simpa using (MvPolynomial.isHomogeneous_X k a).pow n
      have hden_hom : ((MvPolynomial.X a : P₂) ^ n).IsHomogeneous nd.deg := by
        rw [hn]
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
      have hdeg1 : d₀.degree = n := by
        by_contra hne
        exact hd₀ (hpow_hom.coeff_eq_zero hne)
      have hdeg2 : d₀.degree = nd.deg := by
        by_contra hne
        exact hd₀ (hden_hom.coeff_eq_zero hne)
      have hnd_deg : nd.deg = n := hdeg2.symm.trans hdeg1
      have hnum_hom : nd.num.1.IsHomogeneous n := by
        rw [← hnd_deg]
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
      have hs_den : (⟨nd.den.1, nd.den_mem⟩ : S) = s₁ ^ n :=
        Subtype.ext hn.symm
      change (α (β_loc (HomogeneousLocalization.mk nd).val)).val =
        (HomogeneousLocalization.mk nd).val
      rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
      change φ nd.num.1 = Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩
      rw [hφ_homog n nd.num.1 hnum_hom, hs_den]
    refine ⟨{ α with invFun := β, left_inv := hLeft, right_inv := hRight }, ?_⟩
    intro c
    exact MvPolynomial.eval₂Hom_C ι_k (fun _ : Fin 1 => u₀) c
  
  have hIrrelLe :
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → P₂)) := by
    intro p hp
    have hproj0 : GradedRing.proj 𝒜 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
    rw [← DirectSum.sum_support_decompose 𝒜 p]
    apply Submodule.sum_mem
    intro i _
    by_cases hi : i = 0
    · subst hi
      change GradedRing.proj 𝒜 0 p ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → P₂))
      rw [hproj0]
      exact Submodule.zero_mem _
    · have hhom_i : ((DirectSum.decompose 𝒜 p i : ↥(𝒜 i)) : P₂).IsHomogeneous i :=
        (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜 p i).2
      have hrange : Set.range (MvPolynomial.X : Fin 2 → P₂) = MvPolynomial.X '' Set.univ :=
        (Set.image_univ).symm
      rw [hrange, MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      have hd_ne : d ≠ 0 := by
        intro hd0
        subst hd0
        have hdeg0 : (0 : Fin 2 →₀ ℕ).degree ≠ i := by
          simpa using Ne.symm hi
        exact (MvPolynomial.mem_support_iff.mp hd) (hhom_i.coeff_eq_zero hdeg0)
      obtain ⟨j, hj⟩ : ∃ j : Fin 2, d j ≠ 0 := by
        by_contra! hall
        apply hd_ne
        ext j
        exact hall j
      exact ⟨j, Set.mem_univ j, hj⟩
  have hIrred : IrreducibleSpace (ProjectiveSpectrum 𝒜) := by
    have hPrimeBot : (⊥ : HomogeneousIdeal 𝒜).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hNotIrrel : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥ := by
      intro hle
      have hX0_irrel : (MvPolynomial.X 0 : P₂) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
        rw [HomogeneousIdeal.mem_irrelevant_iff]
        exact DirectSum.decompose_of_mem_ne 𝒜 (hX 0) (by decide)
      have hX0_bot : (MvPolynomial.X 0 : P₂) ∈ (⊥ : HomogeneousIdeal 𝒜) := hle hX0_irrel
      have hX0_zero : (MvPolynomial.X 0 : P₂) = 0 := hX0_bot
      have hev := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (1 : k))) hX0_zero
      simp at hev
    let η₀ : ProjectiveSpectrum 𝒜 := ⟨⊥, hPrimeBot, hNotIrrel⟩
    have hη₀_mem : ∀ (W : Set (ProjectiveSpectrum 𝒜)), IsOpen W → W.Nonempty → η₀ ∈ W := by
      rintro W hW ⟨z, hz⟩
      obtain ⟨s, hs⟩ := (ProjectiveSpectrum.isOpen_iff 𝒜 W).mp hW
      by_contra hη_not
      have hη_zl : η₀ ∈ ProjectiveSpectrum.zeroLocus 𝒜 s := by
        rw [← hs]
        exact hη_not
      have hs_sub_bot : s ⊆ (η₀.asHomogeneousIdeal : Set P₂) :=
        (ProjectiveSpectrum.mem_zeroLocus 𝒜 η₀ s).mp hη_zl
      have hz_zl : z ∈ ProjectiveSpectrum.zeroLocus 𝒜 s := by
        rw [ProjectiveSpectrum.mem_zeroLocus]
        intro g hg
        have hg0 : g = 0 := hs_sub_bot hg
        rw [hg0]
        exact zero_mem z.asHomogeneousIdeal
      rw [← hs] at hz_zl
      exact hz_zl hz
    exact
      { isPreirreducible_univ := fun U₁ U₂ hU₁ hU₂ ⟨z₁, _, hz₁⟩ ⟨z₂, _, hz₂⟩ =>
          ⟨η₀, Set.mem_univ η₀,
            hη₀_mem U₁ hU₁ ⟨z₁, hz₁⟩, hη₀_mem U₂ hU₂ ⟨z₂, hz₂⟩⟩
        toNonempty := ⟨η₀⟩ }
  
  let X_proj : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let U : Fin 2 → X_proj.Opens := fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
  have hCov : ⨆ a : Fin 2, U a = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrelLe
  have hRed_Ua : ∀ a : Fin 2, AlgebraicGeometry.IsReduced (U a).toScheme := by
    intro a
    obtain ⟨e_a, _⟩ := hChartEquiv a
    let iso_e : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of P₁) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_a.toRingHom.comp e_a.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_a.apply_symm_apply
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id _
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_a.symm.toRingHom.comp e_a.toRingHom = RingHom.id _ :=
            RingHom.ext e_a.symm_apply_apply
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id _ }
    let iso_Ua : (U a).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of P₁) :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one) ≪≫ iso_e
    exact AlgebraicGeometry.isReduced_of_isOpenImmersion iso_Ua.hom
  let 𝒰 : X_proj.OpenCover :=
    X_proj.openCoverOfIsOpenCover U (TopologicalSpace.IsOpenCover.mk hCov)
  have hRed_cover : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := by
    intro i
    dsimp [𝒰]
    exact hRed_Ua i
  have hRed_proj : AlgebraicGeometry.IsReduced X_proj :=
    AlgebraicGeometry.IsReduced.of_openCover X_proj 𝒰
  have hIrred_proj : IrreducibleSpace ↥X_proj := hIrred
  have hIntegral : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X_proj
  
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let f : X_proj ⟶ S_k := (weilProjectiveSpaceOver k 1).hom
  have hSmooth : AlgebraicGeometry.SmoothOfRelativeDimension 1 f := by
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro x
    have hx_top : x ∈ (⊤ : X_proj.Opens) := trivial
    rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx_top
    obtain ⟨a, hx_a⟩ := hx_top
    have hU_top : AlgebraicGeometry.IsAffineOpen (⊤ : S_k.Opens) :=
      AlgebraicGeometry.isAffineOpen_top S_k
    have hV_a : AlgebraicGeometry.IsAffineOpen (U a) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one
    have e_le : U a ≤ (TopologicalSpace.Opens.map f.base).obj ⊤ := fun _ _ => trivial
    refine ⟨⊤, hU_top, U a, hV_a, hx_a, e_le, ?_⟩
    obtain ⟨e_a, he_a⟩ := hChartEquiv a
    let A₁ : CommRingCat.{u} := CommRingCat.of P₁
    let B_a : CommRingCat.{u} := X_proj.presheaf.obj (Opposite.op (U a))
    let isoSpecE : AlgebraicGeometry.Spec A₁ ≅
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_a.symm.toRingHom.comp e_a.toRingHom = RingHom.id _ :=
            RingHom.ext e_a.symm_apply_apply
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id _
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_a.toRingHom.comp e_a.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_a.apply_symm_apply
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id _ }
    let Ψ_a : AlgebraicGeometry.Spec A₁ ≅ AlgebraicGeometry.Spec B_a :=
      isoSpecE ≪≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one).symm ≪≫
        hV_a.isoSpec
    let φ_a : B_a ⟶ A₁ := AlgebraicGeometry.Spec.preimage Ψ_a.hom
    let φ_a_inv : A₁ ⟶ B_a := AlgebraicGeometry.Spec.preimage Ψ_a.inv
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_a = Ψ_a.hom :=
      AlgebraicGeometry.Spec.map_preimage Ψ_a.hom
    have hSpec_φ_inv : AlgebraicGeometry.Spec.map φ_a_inv = Ψ_a.inv :=
      AlgebraicGeometry.Spec.map_preimage Ψ_a.inv
    have hIso_φ : CategoryTheory.IsIso φ_a :=
      ⟨⟨φ_a_inv,
        AlgebraicGeometry.Spec.map_injective
          (by rw [AlgebraicGeometry.Spec.map_comp, hSpec_φ_inv, hSpec_φ, Ψ_a.inv_hom_id,
            AlgebraicGeometry.Spec.map_id]),
        AlgebraicGeometry.Spec.map_injective
          (by rw [AlgebraicGeometry.Spec.map_comp, hSpec_φ, hSpec_φ_inv, Ψ_a.hom_inv_id,
            AlgebraicGeometry.Spec.map_id])⟩⟩
    have h1 : hV_a.isoSpec.hom ≫ hV_a.fromSpec = (U a).ι := by
      rw [← hV_a.isoSpec_inv_ι, Iso.hom_inv_id_assoc]
    have h2 : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one).inv ≫
        (U a).ι = AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one
    have h3 : AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one ≫ f =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a)))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
      AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one _
    have hΨ_comp : Ψ_a.hom ≫ hV_a.fromSpec ≫ f =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      calc Ψ_a.hom ≫ hV_a.fromSpec ≫ f
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom) ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one).inv ≫
              (hV_a.isoSpec.hom ≫ hV_a.fromSpec) ≫ f := by
            dsimp only [Ψ_a, Iso.trans_hom, Iso.symm_hom, isoSpecE]
            simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom) ≫
              ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one).inv ≫
                (U a).ι) ≫ f := by
            rw [h1]
            simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom) ≫
              (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one ≫ f) := by
            rw [h2]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) ≫
                CommRingCat.ofHom
                  (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a))) ≫
                CommRingCat.ofHom e_a.symm.toRingHom) := by
            rw [h3, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
            congr 1
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro c
            simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
            rw [← he_a c]
            exact e_a.symm_apply_apply (MvPolynomial.C c)
    let α₀ : CommRingCat.of k ⟶ S_k.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
    let g_app : S_k.presheaf.obj (Opposite.op ⊤) ⟶ B_a := f.appLE ⊤ (U a) e_le
    have hFromSpec_top : hU_top.fromSpec = AlgebraicGeometry.Spec.map α₀ := by
      dsimp only [hU_top, α₀]
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top, AlgebraicGeometry.Scheme.isoSpec_Spec_inv]
    have hApp_Spec : AlgebraicGeometry.Spec.map ((α₀ ≫ g_app) ≫ φ_a) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        hSpec_φ, ← hFromSpec_top,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hU_top hV_a e_le]
      exact hΨ_comp
    have hCommEq : (α₀ ≫ g_app) ≫ φ_a = CommRingCat.ofHom MvPolynomial.C :=
      AlgebraicGeometry.Spec.map_injective hApp_Spec
    have hHomEq : φ_a.hom.comp (g_app.hom.comp α₀.hom) = (MvPolynomial.C : k →+* P₁) := by
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using
        congrArg CommRingCat.Hom.hom hCommEq
    have hAlgSmooth : Algebra.IsStandardSmoothOfRelativeDimension 1 k P₁ := by
      have hcard : Nat.card (Fin 1) = 1 := by simp
      simpa only [hcard] using Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial k (Fin 1)
    have hRingSmoothC : RingHom.IsStandardSmoothOfRelativeDimension 1 (MvPolynomial.C : k →+* P₁) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hAlgSmooth
    have hSmoothComp1 : RingHom.IsStandardSmoothOfRelativeDimension 1
        (φ_a.hom.comp (α₀ ≫ g_app).hom) := by
      simpa only [CommRingCat.hom_comp, hHomEq] using hRingSmoothC
    have hSmoothComp2 : RingHom.IsStandardSmoothOfRelativeDimension 1 (g_app.hom.comp α₀.hom) := by
      simpa only [CommRingCat.hom_comp] using
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_right_isIso
          (α₀ ≫ g_app) φ_a).mp hSmoothComp1
    exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
      α₀ g_app).mp hSmoothComp2
  exact ⟨hIntegral, hSmooth⟩

theorem weil_gysin_affine_coord_block_and_perm_squares (k : Type u) [Field k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    (CategoryTheory.IsIso (weilGysinAffineOrigin k 0) ∧
      CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k 0)
        (weilGysinAffineStruct k 0) = CategoryTheory.CategoryStruct.id S_k ∧
      CategoryTheory.CategoryStruct.comp (weilGysinAffineStruct k 0)
        (weilGysinAffineOrigin k 0) =
        CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k 0) ∧
      (∀ c : ℕ, AlgebraicGeometry.IsClosedImmersion (weilGysinAffineOrigin k c)) ∧
      (∀ (a b ab : ℕ) (hab : a + b = ab),
        AlgebraicGeometry.IsClosedImmersion (weilGysinAffineLeftAxis k a b ab hab)) ∧
      (∀ {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
        [AlgebraicGeometry.IsSeparated p_Y] (s : Quiver.Hom S_k Y),
        CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k →
        AlgebraicGeometry.IsClosedImmersion s)) ∧
    ((∀ a : ℕ,
        weilGysinAffineLeftAxis k a 0 a (Nat.add_zero a) =
          CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k a)) ∧
      weilGysinAffineProjRight k 0 1 1 (Nat.zero_add 1) =
        CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k 1) ∧
      (∀ (a b ab : ℕ) (hab : a + b = ab),
        CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k a)
          (weilGysinAffineLeftAxis k a b ab hab) = weilGysinAffineOrigin k ab ∧
        CategoryTheory.IsPullback (weilGysinAffineLeftAxis k a b ab hab)
          (weilGysinAffineStruct k a)
          (weilGysinAffineProjRight k a b ab hab)
          (weilGysinAffineOrigin k b)) ∧
      (∀ (a b' b ab' ab : ℕ)
        (hb : b' + 1 = b) (hab' : a + b' = ab') (hab : a + b = ab) (hab1 : ab' + 1 = ab),
        CategoryTheory.CategoryStruct.comp
          (weilGysinAffineLeftAxis k a b' ab' hab')
          (weilGysinAffineLeftAxis k ab' 1 ab hab1) =
          weilGysinAffineLeftAxis k a b ab hab ∧
        CategoryTheory.CategoryStruct.comp
          (weilGysinAffineProjRight k a b ab hab)
          (weilGysinAffineProjRight k b' 1 b hb) =
          weilGysinAffineProjRight k ab' 1 ab hab1 ∧
        CategoryTheory.IsPullback
          (weilGysinAffineLeftAxis k ab' 1 ab hab1)
          (weilGysinAffineProjRight k a b' ab' hab')
          (weilGysinAffineProjRight k a b ab hab)
          (weilGysinAffineLeftAxis k b' 1 b hb))) ∧
    ((∀ c : ℕ,
        weilGysinAffinePerm k c 1 =
          CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k c)) ∧
      (∀ (c : ℕ) (π₁ π₂ : Equiv.Perm (Fin c)),
        weilGysinAffinePerm k c (π₁ * π₂) =
          CategoryTheory.CategoryStruct.comp
            (weilGysinAffinePerm k c π₁) (weilGysinAffinePerm k c π₂)) ∧
      (∀ (c : ℕ) (π : Equiv.Perm (Fin c)),
        CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c)
          (weilGysinAffinePerm k c π) = weilGysinAffineOrigin k c ∧
        CategoryTheory.IsPullback (weilGysinAffineOrigin k c)
          (CategoryTheory.CategoryStruct.id S_k)
          (weilGysinAffinePerm k c π) (weilGysinAffineOrigin k c)) ∧
      (∀ (c m : ℕ) (hm : m + 2 ≤ c) (hc_split : (m + 2) + (c - (m + 2)) = c),
        let s_m : Equiv.Perm (Fin c) := Equiv.swap ⟨m, by omega⟩ ⟨m + 1, by omega⟩
        let s_L : Equiv.Perm (Fin (m + 2)) := Equiv.swap ⟨m, by omega⟩ ⟨m + 1, by omega⟩
        CategoryTheory.IsPullback
          (weilGysinAffineLeftAxis k (m + 2) (c - (m + 2)) c hc_split)
          (weilGysinAffinePerm k (m + 2) s_L)
          (weilGysinAffinePerm k c s_m)
          (weilGysinAffineLeftAxis k (m + 2) (c - (m + 2)) c hc_split) ∧
        CategoryTheory.CategoryStruct.comp
          (weilGysinAffinePerm k c s_m)
          (weilGysinAffineProjRight k (m + 2) (c - (m + 2)) c hc_split) =
          weilGysinAffineProjRight k (m + 2) (c - (m + 2)) c hc_split ∧
        CategoryTheory.IsPullback
          (weilGysinAffineLeftAxis k m 2 (m + 2) rfl)
          (CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k m))
          (weilGysinAffinePerm k (m + 2) s_L)
          (weilGysinAffineLeftAxis k m 2 (m + 2) rfl) ∧
        CategoryTheory.CategoryStruct.comp
          (weilGysinAffinePerm k (m + 2) s_L)
          (weilGysinAffineProjRight k m 2 (m + 2) rfl) =
          CategoryTheory.CategoryStruct.comp
            (weilGysinAffineProjRight k m 2 (m + 2) rfl)
            (weilGysinAffinePerm k 2 (Equiv.swap (0 : Fin 2) (1 : Fin 2))))) :=
by
  intro S_k
  let struct_hom (c : ℕ) : k →+* MvPolynomial (Fin c) k := MvPolynomial.C
  let orig_hom (c : ℕ) : MvPolynomial (Fin c) k →+* k := MvPolynomial.eval 0
  let projLeft_hom (a b ab : ℕ) (hab : a + b = ab) :
      MvPolynomial (Fin a) k →+* MvPolynomial (Fin ab) k :=
    (MvPolynomial.rename (fun i : Fin a => Fin.cast hab (Fin.castAdd b i))).toRingHom
  let projRight_hom (a b ab : ℕ) (hab : a + b = ab) :
      MvPolynomial (Fin b) k →+* MvPolynomial (Fin ab) k :=
    (MvPolynomial.rename (fun j : Fin b => Fin.cast hab (Fin.natAdd a j))).toRingHom
  let axis_hom (a b ab : ℕ) (hab : a + b = ab) :
      MvPolynomial (Fin ab) k →+* MvPolynomial (Fin a) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (fun m : Fin ab =>
        Fin.addCases (fun i : Fin a => MvPolynomial.X i) (fun _ : Fin b => 0)
          (Fin.cast hab.symm m))
  let perm_hom (c : ℕ) (π : Equiv.Perm (Fin c)) :
      MvPolynomial (Fin c) k →+* MvPolynomial (Fin c) k :=
    (MvPolynomial.rename (R := k) π).toRingHom
  have hSpec_id : ∀ {A : Type u} [CommRing A],
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id A)) =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of A)) := by
    intro A _
    rw [CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hSpec_comp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (φ : A →+* B) (ψ : B →+* C),
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp φ)) := by
    intro A B C _ _ _ φ ψ
    symm
    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
  have hAddCases : ∀ {p q : ℕ} {α : Type u} (u : Fin p → α) (v : Fin q → α) (x : Fin (p + q)),
      Fin.addCases (motive := fun _ => α) u v x =
        if hx : x.1 < p then u ⟨x.1, hx⟩ else v ⟨x.1 - p, by omega⟩ := by
    intro p q α u v x
    split_ifs with hx
    · have hx_eq : x = Fin.castAdd q ⟨x.1, hx⟩ := Fin.ext rfl
      conv_lhs => rw [hx_eq]
      exact Fin.addCases_left _
    · have hx_eq : x = Fin.natAdd p ⟨x.1 - p, by omega⟩ := by
        ext; dsimp; omega
      conv_lhs => rw [hx_eq]
      exact Fin.addCases_right _
  have hAxis_C : ∀ {a b ab : ℕ} (hab : a + b = ab) (r : k),
      axis_hom a b ab hab (MvPolynomial.C r) = MvPolynomial.C r := by
    intro a b ab hab r
    exact MvPolynomial.eval₂Hom_C _ _ r
  have hAxis_X : ∀ {a b ab : ℕ} (hab : a + b = ab) (m : Fin ab),
      axis_hom a b ab hab (MvPolynomial.X m) =
        if hm : m.1 < a then MvPolynomial.X ⟨m.1, hm⟩ else 0 := by
    intro a b ab hab m
    dsimp only [axis_hom]
    rw [MvPolynomial.eval₂Hom_X', hAddCases]
    simp only [Fin.val_cast]
  have hAxis_X_lt : ∀ {a b ab : ℕ} (hab : a + b = ab) (m : Fin ab) (hm : m.1 < a),
      axis_hom a b ab hab (MvPolynomial.X m) = MvPolynomial.X ⟨m.1, hm⟩ := by
    intro a b ab hab m hm
    rw [hAxis_X hab]
