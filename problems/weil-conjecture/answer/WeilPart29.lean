  let η_F : F_B ⟶ pf_f.obj F_E :=
    (adj_B.homEquiv AM (pf_f.obj F_E)).symm (adj_E.unit.app AM ≫ F_E.obj.map τ_f.op)
  let α_split : F_B ⟶ pf_f.obj Q₂ := η_F ≫ pf_f.map φ_ω
  let ψ_ω : F_B ⟶ weilEtaleHigherDirectImage f 1 Q₁ := α_split ≫ δ_B1

  have hIso_ψ : CategoryTheory.IsIso ψ_ω := by
    apply hConserv_iso
    intro s hs B_s _hc_s _hr_s
    let pb_s := B_s.sheafPullback AddCommGrpCat.{u}
      B.left.smallEtaleTopology S_k.smallEtaleTopology
    let adj_s := B_s.sheafAdjunctionContinuous AddCommGrpCat.{u}
      B.left.smallEtaleTopology S_k.smallEtaleTopology
    obtain ⟨hc_s0, hr_s0, hLim_s, hAdd_s, _⟩ := hSite s
    obtain rfl : _hc_s = hc_s0 := Subsingleton.elim _ _
    obtain rfl : _hr_s = hr_s0 := Subsingleton.elim _ _
    letI : pb_s.Additive := hAdd_s
    letI : CategoryTheory.Limits.PreservesFiniteLimits pb_s := hLim_s
    letI : CategoryTheory.Limits.PreservesFiniteColimits pb_s :=
