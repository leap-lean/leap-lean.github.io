            (AlgebraicGeometry.Spec.map ι_hom)
            (U.left.fromSpecResidueField y₀) U.hom).trans
          ((congrArg
              (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map ι_hom))
              (@AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField
                U.left S U.hom y₀).symm).trans
          ((CategoryTheory.Category.assoc
              (AlgebraicGeometry.Spec.map ι_hom)
              (AlgebraicGeometry.Spec.map
                (@AlgebraicGeometry.Scheme.Hom.residueFieldMap U.left S U.hom y₀))
              (S.fromSpecResidueField x)).symm.trans
          ((congrArg
              (fun φ => CategoryTheory.CategoryStruct.comp φ (S.fromSpecResidueField x))
              (AlgebraicGeometry.Spec.map_comp
                (@AlgebraicGeometry.Scheme.Hom.residueFieldMap U.left S U.hom y₀)
                ι_hom).symm).trans
          (congrArg
            (fun ψ => CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map ψ) (S.fromSpecResidueField x))
            hcomp_res))))
        obtain ⟨V, v, w, hw, hv_zero⟩ := hStalk x U u hu_gx s
        let pt₀ :
            ↥(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ↥(S.residueField x)))) :=
          default
        have hpt : v.left.base (w.base pt₀) = y := by
          have hw_pt : (CategoryTheory.CategoryStruct.comp w ((Fgt.map v).left)).base pt₀ =
              u.base pt₀ := congrArg (fun φ => φ.base pt₀) hw
          have hu_pt : u.base pt₀ = y := by
            change (U.left.fromSpecResidueField y₀).base
              ((AlgebraicGeometry.Spec.map ι_hom).base pt₀) = y₀
            exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply y₀ _
          exact hw_pt.trans hu_pt
        have hEt_v : AlgebraicGeometry.Etale v.left := by
          have hcomp_v : CategoryTheory.CategoryStruct.comp v.left U.hom = V.hom :=
            CategoryTheory.MorphismProperty.Over.w v
          have hEt_comp :
              AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp v.left U.hom) := by
            rw [hcomp_v]
            exact V.prop
          exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) v.left U.hom
            U.prop hEt_comp
        exact ⟨V, v, w.base pt₀, hv_zero, hEt_v, hpt⟩
      · exact le_rfl
    have hSepAll := CategoryTheory.Presheaf.IsSheaf.isSeparated ℋ.property
    apply hSepAll U R_U hCov s 0
    intro V v hv
    change ℋ.obj.map (Opposite.op v) s = ℋ.obj.map (Opposite.op v) 0
    rw [hv, map_zero]

  
  have h1a : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (ℋ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (x : ↥S),
        let Ω_x := AlgebraicClosure ↥(S.residueField x)
        let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
        let g_x := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x)))
          (S.fromSpecResidueField x)
        ∃ (hc : (weilAltCdSitePullback g_x).IsContinuous S.smallEtaleTopology S_x.smallEtaleTopology)
          (P_pull : CategoryTheory.Functor
            (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf S_x.smallEtaleTopology AddCommGrpCat.{u}))
          (_ : P_pull ⊣ @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback g_x) AddCommGrpCat.{u} _
            S.smallEtaleTopology S_x.smallEtaleTopology hc),
          CategoryTheory.Limits.IsZero (P_pull.obj ℋ)) →
      CategoryTheory.Limits.IsZero ℋ :=
    fun S ℋ h_pts => hStalkAllToZero S ℋ (fun x => hSitePointStalk S ℋ x (h_pts x))
  refine ⟨?_, ?_⟩
  · intro S
    refine ⟨h1a S, ?_⟩
    intro ℱ₁ ℱ₂ α h_pts_iso
    have hMono : CategoryTheory.Mono α := by
      rw [CategoryTheory.Preadditive.mono_iff_isZero_kernel]
      refine h1a S (CategoryTheory.Limits.kernel α) (fun x => ?_)
      obtain ⟨hc, P_pull, adj, hAdd, hLim, hColim, hIso_x⟩ := h_pts_iso x
      have : P_pull.Additive := hAdd
      have : P_pull.PreservesZeroMorphisms :=
        CategoryTheory.Functor.preservesZeroMorphisms_of_additive P_pull
      have : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
      have : CategoryTheory.IsIso (P_pull.map α) := hIso_x
      have hZero_ker : CategoryTheory.Limits.IsZero
          (CategoryTheory.Limits.kernel (P_pull.map α)) :=
        CategoryTheory.Limits.isZero_kernel_of_mono (P_pull.map α)
      exact ⟨hc, P_pull, adj,
        hZero_ker.of_iso (CategoryTheory.Limits.PreservesKernel.iso P_pull α)⟩
    have hEpi : CategoryTheory.Epi α := by
      rw [CategoryTheory.Preadditive.epi_iff_isZero_cokernel]
      refine h1a S (CategoryTheory.Limits.cokernel α) (fun x => ?_)
      obtain ⟨hc, P_pull, adj, hAdd, hLim, hColim, hIso_x⟩ := h_pts_iso x
      have : P_pull.Additive := hAdd
      have : P_pull.PreservesZeroMorphisms :=
        CategoryTheory.Functor.preservesZeroMorphisms_of_additive P_pull
      have : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
      have : CategoryTheory.IsIso (P_pull.map α) := hIso_x
      have hZero_coker : CategoryTheory.Limits.IsZero
          (CategoryTheory.Limits.cokernel (P_pull.map α)) :=
        CategoryTheory.Limits.isZero_cokernel_of_epi (P_pull.map α)
      exact ⟨hc, P_pull, adj,
        hZero_coker.of_iso (CategoryTheory.Limits.PreservesCokernel.iso P_pull α)⟩
    exact @CategoryTheory.isIso_of_mono_of_epi _ _ _ _ _ α hMono hEpi
  · intro Ω _ _
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_Ω) inferInstance
    obtain ⟨hSecMem, hTermCov⟩ := hSpecSieves Ω
    obtain ⟨h2a, h2b, h2c, -⟩ :=
      hSitePkg S_Ω.smallEtaleTopology T_Ω (hTerm_Ω Ω) hSecMem hTermCov
    exact ⟨h2a, h2b, h2c⟩

theorem weil_gysin_localTorsion_nsmul_pullback_and_open_partition : (∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (U : S.Etale),
      m • CategoryTheory.CategoryStruct.id (weilGysinLocalTorsionSheaf S m U) = 0) ∧
    (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂) (m : ℕ) (U : S₂.Etale)
        (hc : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology)
        (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}))
        (adj : P_pull ⊣ @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdSitePullback h) AddCommGrpCat.{u} _
          S₂.smallEtaleTopology S₁.smallEtaleTopology hc),
      let pf_h := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAltCdSitePullback h) AddCommGrpCat.{u} _
        S₂.smallEtaleTopology S₁.smallEtaleTopology hc
      let L₂ := weilGysinLocalTorsionSheaf S₂ m U
      let L₁ := weilGysinLocalTorsionSheaf S₁ m ((weilAltCdSitePullback h).obj U)
      ∃ (e_pb : L₁ ≅ P_pull.obj L₂),
        ∀ (H : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u})
          (f : Quiver.Hom L₂ (pf_h.obj H)),
          CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.comp e_pb.hom ((adj.homEquiv L₂ H).symm f)) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv f) ∧
    (∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (U : S.Etale) (d : ℕ)
        (U_comp : Fin d → S.Etale)
        (ι_comp : ∀ i : Fin d, Quiver.Hom (U_comp i) U),
      (∀ i : Fin d, AlgebraicGeometry.IsOpenImmersion
        (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp i)).left)) →
      (⋃ i : Fin d,
        Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp i)).left).base) =
        Set.univ →
      (∀ i j : Fin d, i ≠ j →
        Disjoint
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp i)).left).base)
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp j)).left).base)) →
      let L := weilGysinLocalTorsionSheaf S m U
      let L_comp := fun i : Fin d => weilGysinLocalTorsionSheaf S m (U_comp i)
      ∃ (inc : ∀ i : Fin d, Quiver.Hom (L_comp i) L)
        (proj : ∀ i : Fin d, Quiver.Hom L (L_comp i)),
        (∀ i : Fin d,
          CategoryTheory.Sheaf.freeYonedaHomEquiv (inc i) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L))
              (L.obj.map (Opposite.op (ι_comp i)))) ∧
        (∀ i : Fin d,
          CategoryTheory.CategoryStruct.comp (inc i) (proj i) =
            CategoryTheory.CategoryStruct.id (L_comp i)) ∧
        (∀ i j : Fin d, i ≠ j →
          CategoryTheory.CategoryStruct.comp (inc i) (proj j) = 0) ∧
        (∑ i : Fin d, CategoryTheory.CategoryStruct.comp (proj i) (inc i)) =
          CategoryTheory.CategoryStruct.id L) :=
by
  have hFreeComp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ} {V : S.Etale}
      {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : Quiver.Hom (weilGysinLocalTorsionSheaf S m V) G₁) (g : Quiver.Hom G₁ G₂),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.comp f g) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv f)
          (g.hom.app (Opposite.op V)) := by
    intro S m V G₁ G₂ f g
    let P := CategoryTheory.Presheaf.freeYoneda V
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
    let adj := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    let f' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj P ⟶ G₁ := f
    have h1 : (adj.homEquiv P G₂) (f' ≫ g) = (adj.homEquiv P G₁) f' ≫ g.hom :=
      adj.homEquiv_naturality_right f' g
    have h2 : CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv P G₁) f' ≫ g.hom) =
        CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv P G₁) f') ≫
          g.hom.app (Opposite.op V) :=
      CategoryTheory.Presheaf.freeYonedaHomEquiv_comp ((adj.homEquiv P G₁) f') g.hom
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv h1).trans h2
  let freeYonedaAddEquiv (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (V : S.Etale)
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :
      (weilGysinLocalTorsionSheaf S m V ⟶ G) ≃+
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)) ⟶
          G.obj.obj (Opposite.op V)) :=
    AddEquiv.mk CategoryTheory.Sheaf.freeYonedaHomEquiv (by
      intro f₁ f₂
      have h_eval : ∀ (f : weilGysinLocalTorsionSheaf S m V ⟶ G),
          CategoryTheory.Sheaf.freeYonedaHomEquiv f =
            CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.CategoryStruct.id (weilGysinLocalTorsionSheaf S m V)) ≫
              f.hom.app (Opposite.op V) := fun f =>
        (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.Category.id_comp f).symm).trans
          (hFreeComp (CategoryTheory.CategoryStruct.id _) f)
      change CategoryTheory.Sheaf.freeYonedaHomEquiv (f₁ + f₂) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv f₁ + CategoryTheory.Sheaf.freeYonedaHomEquiv f₂
      rw [h_eval (f₁ + f₂), h_eval f₁, h_eval f₂,
        CategoryTheory.Sheaf.Hom.add_app, CategoryTheory.Preadditive.comp_add])
  refine ⟨?_, ?_, ?_⟩
  · intro S m U
    let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let L := weilGysinLocalTorsionSheaf S m U
    let e := freeYonedaAddEquiv S m U L
    have h_tors : m • CategoryTheory.CategoryStruct.id A_m = 0 := by
      ext z
      apply ULift.ext
      change m • z.down = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    apply e.injective
    rw [map_nsmul, map_zero]
    change m • (e (CategoryTheory.CategoryStruct.id L)) = 0
    rw [← CategoryTheory.Category.id_comp (e (CategoryTheory.CategoryStruct.id L)),
      ← CategoryTheory.Preadditive.nsmul_comp, h_tors, CategoryTheory.Limits.zero_comp]
  · intro S₁ S₂ h m U hc P_pull adj
    let pf_h := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilAltCdSitePullback h) AddCommGrpCat.{u} _
      S₂.smallEtaleTopology S₁.smallEtaleTopology hc
    let B_h := weilAltCdSitePullback h
    let U₁ := B_h.obj U
    let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let L₂ := weilGysinLocalTorsionSheaf S₂ m U
    let L₁ := weilGysinLocalTorsionSheaf S₁ m U₁
    let equiv₁ : ∀ (G₁ : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
        (L₁ ⟶ G₁) ≃ (A_m ⟶ G₁.obj.obj (Opposite.op U₁)) :=
      fun _ => CategoryTheory.Sheaf.freeYonedaHomEquiv
    let equiv₂ : ∀ (G₂ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}),
        (L₂ ⟶ G₂) ≃ (A_m ⟶ G₂.obj.obj (Opposite.op U)) :=
      fun _ => CategoryTheory.Sheaf.freeYonedaHomEquiv
    let ξ_unit : A_m ⟶ (P_pull.obj L₂).obj.obj (Opposite.op U₁) :=
      equiv₂ (pf_h.obj (P_pull.obj L₂)) (adj.unit.app L₂)
    let ψ : L₁ ⟶ P_pull.obj L₂ := (equiv₁ (P_pull.obj L₂)).symm ξ_unit
    have hMaster : ∀ (H : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u})
        (k : P_pull.obj L₂ ⟶ H),
        equiv₁ H (ψ ≫ k) = equiv₂ (pf_h.obj H) ((adj.homEquiv L₂ H) k) := by
      intro H k
      have h1 : equiv₁ H (ψ ≫ k) = equiv₁ (P_pull.obj L₂) ψ ≫ k.hom.app (Opposite.op U₁) :=
        hFreeComp ψ k
      have h2 : equiv₁ (P_pull.obj L₂) ψ = ξ_unit :=
        (equiv₁ (P_pull.obj L₂)).apply_symm_apply ξ_unit
      have h3 : ξ_unit ≫ k.hom.app (Opposite.op U₁) =
          equiv₂ (pf_h.obj (P_pull.obj L₂)) (adj.unit.app L₂) ≫
            (pf_h.map k).hom.app (Opposite.op U) := rfl
      have h4 : equiv₂ (pf_h.obj (P_pull.obj L₂)) (adj.unit.app L₂) ≫
            (pf_h.map k).hom.app (Opposite.op U) =
          equiv₂ (pf_h.obj H) (adj.unit.app L₂ ≫ pf_h.map k) :=
        (hFreeComp (adj.unit.app L₂) (pf_h.map k)).symm
      have h5 : adj.unit.app L₂ ≫ pf_h.map k = (adj.homEquiv L₂ H) k :=
        (CategoryTheory.Adjunction.homEquiv_unit adj L₂ H k).symm
      exact h1.trans ((congrArg (· ≫ k.hom.app (Opposite.op U₁)) h2).trans
        (h3.trans (h4.trans (congrArg (equiv₂ (pf_h.obj H)) h5))))
    have hCancel : ∀ (H : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u})
        (f : L₂ ⟶ pf_h.obj H),
        equiv₁ H (ψ ≫ (adj.homEquiv L₂ H).symm f) = equiv₂ (pf_h.obj H) f := by
      intro H f
      exact (hMaster H ((adj.homEquiv L₂ H).symm f)).trans
        (congrArg (equiv₂ (pf_h.obj H)) ((adj.homEquiv L₂ H).apply_symm_apply f))
    let η₁ : A_m ⟶ (pf_h.obj L₁).obj.obj (Opposite.op U) :=
      equiv₁ L₁ (CategoryTheory.CategoryStruct.id L₁)
    let f₀ : L₂ ⟶ pf_h.obj L₁ := (equiv₂ (pf_h.obj L₁)).symm η₁
    let φ : P_pull.obj L₂ ⟶ L₁ := (adj.homEquiv L₂ L₁).symm f₀
    have h_hom_inv : ψ ≫ φ = CategoryTheory.CategoryStruct.id L₁ := by
      apply (equiv₁ L₁).injective
      exact (hCancel L₁ f₀).trans ((equiv₂ (pf_h.obj L₁)).apply_symm_apply η₁)
    have h_inv_hom : φ ≫ ψ = CategoryTheory.CategoryStruct.id (P_pull.obj L₂) := by
      apply (adj.homEquiv L₂ (P_pull.obj L₂)).injective
      apply (equiv₂ (pf_h.obj (P_pull.obj L₂))).injective
      rw [← hMaster (P_pull.obj L₂) (φ ≫ ψ),
        ← hMaster (P_pull.obj L₂) (CategoryTheory.CategoryStruct.id (P_pull.obj L₂)),
        ← CategoryTheory.Category.assoc, h_hom_inv,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    refine ⟨{ hom := ψ, inv := φ, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom }, ?_⟩
    intro H f
    exact hCancel H f
  · intro S m U d U_comp ι_comp h_open h_univ h_disj
    let J := S.smallEtaleTopology
    let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let L := weilGysinLocalTorsionSheaf S m U
    let L_comp : Fin d → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      fun i => weilGysinLocalTorsionSheaf S m (U_comp i)
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hMem_J : ∀ {Z : S.Etale} (R : CategoryTheory.Sieve Z),
        (∀ x : ↥Z.left, ∃ (Y : S.Etale) (f : Y ⟶ Z) (y : ↥Y.left),
          R.arrows f ∧ P_et f.left ∧ f.left.base y = x) → R ∈ J Z := by
      intro Z R hR
      change R ∈ (S.smallGrothendieckTopology P_et) Z
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S (le_refl P_et)]
      exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology Z R).mpr hR
    have hEmpty_ext : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (Z : S.Etale),
        IsEmpty ↥Z.left → ∀ (g₁ g₂ : A_m ⟶ G.obj.obj (Opposite.op Z)), g₁ = g₂ := by
      intro G Z hEmp g₁ g₂
      have hBot : (⊥ : CategoryTheory.Sieve Z) ∈ J Z :=
        hMem_J ⊥ (fun x => IsEmpty.elim hEmp x)
      exact G.2.hom_ext ⟨⊥, hBot⟩ g₁ g₂ (fun I => False.elim I.hf)
    have hCov : CategoryTheory.Sieve.ofArrows U_comp ι_comp ∈ J U := by
      apply hMem_J
      intro x
      have hx : x ∈ ⋃ i : Fin d, Set.range ((ι_comp i).left).base := by
        change x ∈ ⋃ i : Fin d,
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp i)).left).base
        rw [h_univ]
        exact Set.mem_univ x
      rcases Set.mem_iUnion.mp hx with ⟨i, y, hy⟩
      have : AlgebraicGeometry.IsOpenImmersion (ι_comp i).left := h_open i
      exact ⟨U_comp i, ι_comp i, y, CategoryTheory.Sieve.ofArrows_mk U_comp ι_comp i,
        inferInstance, hy⟩
    have hMono : ∀ (i : Fin d) {W : S.Etale} (a b : W ⟶ U_comp i),
        a ≫ ι_comp i = b ≫ ι_comp i → a = b := by
      intro i W a b hab
      have : AlgebraicGeometry.IsOpenImmersion (ι_comp i).left := h_open i
      have hleft : a.left ≫ (ι_comp i).left = b.left ≫ (ι_comp i).left :=
        congrArg (fun k => k.left) hab
      exact CategoryTheory.MorphismProperty.Over.Hom.ext ((cancel_mono (ι_comp i).left).mp hleft)
    have hDisj_empty : ∀ (i j : Fin d), i ≠ j → ∀ {W : S.Etale}
        (a : W ⟶ U_comp i) (b : W ⟶ U_comp j),
        a ≫ ι_comp i = b ≫ ι_comp j → IsEmpty ↥W.left := by
      intro i j hij W a b hab
      refine ⟨fun w => ?_⟩
      have hpt : (ι_comp i).left.base (a.left.base w) = (ι_comp j).left.base (b.left.base w) := by
        have hcomp : (a.left ≫ (ι_comp i).left).base w = (b.left ≫ (ι_comp j).left).base w :=
          congrArg (fun k => k.left.base w) hab
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using hcomp
      have hmem_i : (ι_comp i).left.base (a.left.base w) ∈
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp i)).left).base :=
        ⟨a.left.base w, rfl⟩
      have hmem_j : (ι_comp i).left.base (a.left.base w) ∈
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp j)).left).base :=
        ⟨b.left.base w, hpt.symm⟩
      exact Set.disjoint_left.mp (h_disj i j hij) hmem_i hmem_j
    let η_L : A_m ⟶ L.obj.obj (Opposite.op U) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L)
    let η_comp : ∀ k : Fin d, A_m ⟶ (L_comp k).obj.obj (Opposite.op (U_comp k)) :=
      fun k => CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L_comp k))
    let inc : ∀ i : Fin d, L_comp i ⟶ L :=
      fun i => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (η_L ≫ L.obj.map (Opposite.op (ι_comp i)))
    have h_inc_free : ∀ i : Fin d,
        CategoryTheory.Sheaf.freeYonedaHomEquiv (inc i) =
          η_L ≫ L.obj.map (Opposite.op (ι_comp i)) :=
      fun i => CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    let x_fam : ∀ (k i : Fin d), A_m ⟶ (L_comp k).obj.obj (Opposite.op (U_comp i)) :=
      fun k i => if h : k = i then Eq.recOn h (η_comp k) else 0
    have hx_compat : ∀ (k : Fin d) ⦃W : S.Etale⦄ ⦃i j : Fin d⦄
        (a : W ⟶ U_comp i) (b : W ⟶ U_comp j),
        a ≫ ι_comp i = b ≫ ι_comp j →
        x_fam k i ≫ (L_comp k).obj.map (Opposite.op a) =
          x_fam k j ≫ (L_comp k).obj.map (Opposite.op b) := by
      intro k W i j a b hab
      by_cases hij : i = j
      · subst hij
        rw [hMono i a b hab]
      · exact hEmpty_ext (L_comp k) W (hDisj_empty i j hij a b hab) _ _
    let ξ_proj : ∀ k : Fin d, A_m ⟶ (L_comp k).obj.obj (Opposite.op U) :=
      fun k => (L_comp k).2.amalgamateOfArrows ι_comp hCov (x_fam k) (hx_compat k)
    have hProjMap : ∀ (k i : Fin d),
        ξ_proj k ≫ (L_comp k).obj.map (Opposite.op (ι_comp i)) = x_fam k i :=
      fun k i => (L_comp k).2.amalgamateOfArrows_map ι_comp hCov (x_fam k) (hx_compat k) i
    let proj : ∀ k : Fin d, L ⟶ L_comp k :=
      fun k => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (ξ_proj k)
    have h_proj_app : ∀ k : Fin d,
        η_L ≫ (proj k).hom.app (Opposite.op U) = ξ_proj k := by
      intro k
      calc η_L ≫ (proj k).hom.app (Opposite.op U)
          = CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.CategoryStruct.id L ≫ proj k) :=
            (hFreeComp (CategoryTheory.CategoryStruct.id L) (proj k)).symm
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (proj k) := by
            rw [CategoryTheory.Category.id_comp]
        _ = ξ_proj k := CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (ξ_proj k)
    have hIncProj : ∀ (i k : Fin d),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (inc i ≫ proj k) = x_fam k i := by
      intro i k
      calc CategoryTheory.Sheaf.freeYonedaHomEquiv (inc i ≫ proj k)
          = CategoryTheory.Sheaf.freeYonedaHomEquiv (inc i) ≫
              (proj k).hom.app (Opposite.op (U_comp i)) := hFreeComp (inc i) (proj k)
        _ = (η_L ≫ L.obj.map (Opposite.op (ι_comp i))) ≫
              (proj k).hom.app (Opposite.op (U_comp i)) := by rw [h_inc_free i]
        _ = η_L ≫ (L.obj.map (Opposite.op (ι_comp i)) ≫
              (proj k).hom.app (Opposite.op (U_comp i))) := CategoryTheory.Category.assoc _ _ _
        _ = η_L ≫ ((proj k).hom.app (Opposite.op U) ≫
              (L_comp k).obj.map (Opposite.op (ι_comp i))) := by
            rw [(proj k).hom.naturality (Opposite.op (ι_comp i))]
        _ = (η_L ≫ (proj k).hom.app (Opposite.op U)) ≫
              (L_comp k).obj.map (Opposite.op (ι_comp i)) :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = ξ_proj k ≫ (L_comp k).obj.map (Opposite.op (ι_comp i)) := by rw [h_proj_app k]
        _ = x_fam k i := hProjMap k i
    refine ⟨inc, proj, h_inc_free, ?_, ?_, ?_⟩
    · intro i
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hIncProj i i]
      exact dite_eq_left_iff.mpr (fun h => absurd rfl h)
    · intro i j hij
      apply (freeYonedaAddEquiv S m (U_comp i) (L_comp j)).injective
      rw [map_zero]
      change CategoryTheory.Sheaf.freeYonedaHomEquiv (inc i ≫ proj j) = 0
      rw [hIncProj i j]
      exact dite_eq_right_iff.mpr (fun h => absurd h.symm hij)
    · apply (freeYonedaAddEquiv S m U L).injective
      apply L.2.hom_ext_ofArrows ι_comp hCov
      intro j
      rw [map_sum, CategoryTheory.Preadditive.sum_comp]
      have hTerm : ∀ i : Fin d,
          freeYonedaAddEquiv S m U L (proj i ≫ inc i) ≫ L.obj.map (Opposite.op (ι_comp j)) =
            x_fam i j ≫ (inc i).hom.app (Opposite.op (U_comp j)) := by
        intro i
        calc CategoryTheory.Sheaf.freeYonedaHomEquiv (proj i ≫ inc i) ≫
              L.obj.map (Opposite.op (ι_comp j))
            = (CategoryTheory.Sheaf.freeYonedaHomEquiv (proj i) ≫
                (inc i).hom.app (Opposite.op U)) ≫
                L.obj.map (Opposite.op (ι_comp j)) := by rw [hFreeComp (proj i) (inc i)]
          _ = (ξ_proj i ≫ (inc i).hom.app (Opposite.op U)) ≫
                L.obj.map (Opposite.op (ι_comp j)) := by
              rw [CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (ξ_proj i)]
          _ = ξ_proj i ≫ ((inc i).hom.app (Opposite.op U) ≫
                L.obj.map (Opposite.op (ι_comp j))) := CategoryTheory.Category.assoc _ _ _
          _ = ξ_proj i ≫ ((L_comp i).obj.map (Opposite.op (ι_comp j)) ≫
                (inc i).hom.app (Opposite.op (U_comp j))) := by
              rw [← (inc i).hom.naturality (Opposite.op (ι_comp j))]
          _ = (ξ_proj i ≫ (L_comp i).obj.map (Opposite.op (ι_comp j))) ≫
                (inc i).hom.app (Opposite.op (U_comp j)) :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = x_fam i j ≫ (inc i).hom.app (Opposite.op (U_comp j)) := by rw [hProjMap i j]
      trans (∑ i : Fin d, x_fam i j ≫ (inc i).hom.app (Opposite.op (U_comp j)))
      · exact Finset.sum_congr rfl (fun i _ => hTerm i)
      rw [Finset.sum_eq_single j]
      · have hxj : x_fam j j = η_comp j := dite_eq_left_iff.mpr (fun h => absurd rfl h)
        rw [hxj]
        calc η_comp j ≫ (inc j).hom.app (Opposite.op (U_comp j))
            = CategoryTheory.Sheaf.freeYonedaHomEquiv
                (CategoryTheory.CategoryStruct.id (L_comp j) ≫ inc j) :=
              (hFreeComp (CategoryTheory.CategoryStruct.id (L_comp j)) (inc j)).symm
          _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (inc j) := by
              rw [CategoryTheory.Category.id_comp]
          _ = η_L ≫ L.obj.map (Opposite.op (ι_comp j)) := h_inc_free j
      · intro i _ hij
        have hxi : x_fam i j = 0 := dite_eq_right_iff.mpr (fun h => absurd h hij)
        rw [hxi, CategoryTheory.Limits.zero_comp]
      · intro hj
        exact absurd (Finset.mem_univ j) hj

theorem weil_gysin_algClosed_affine_etale_fiber_clopen_splitting (Ω : Type u) [Field Ω] [IsAlgClosed Ω] :
