        exact (CategoryTheory.cancel_epi e).mp heq_zero
      have hπ_zero : π_coker = 0 := by
        ext x₀
        have h0 := congrArg (fun k : X ⟶ SkyObj M_coker => ((k.hom.app (Opposite.op T)).hom x₀) (𝟙 T))
