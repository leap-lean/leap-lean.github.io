        intro Y f hf y
        let x : ↥U.left := f.left y
        have heq_pt : f.left y = (f_x x).left (y_x x) := (hfy x).symm
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y (y_x x) heq_pt
        have _hf_et : AlgebraicGeometry.Etale f.left := hEtaleLeft f
