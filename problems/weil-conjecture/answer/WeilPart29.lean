    let ιM_s : F_Sk ⟶ pb_s.obj F_B := e_s_FB.inv
    obtain ⟨eq_dom⟩ := hIsoH0 e_s_FB
    have hCard_dom : Nat.card ((pb_s.obj F_B).H 0) = ℓ := by
      rw [Nat.card_congr eq_dom.toEquiv]
