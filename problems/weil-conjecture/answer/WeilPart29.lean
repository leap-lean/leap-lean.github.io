      letI : ((weilEtaleSitePullback i_s).sheafPushforwardContinuous AddCommGrpCat.{u}
          E.smallEtaleTopology P1.left.smallEtaleTopology).IsRightAdjoint := hr_i
      letI : (weilEtaleSitePullback P1.hom).IsContinuous
          S_k.smallEtaleTopology P1.left.smallEtaleTopology := hc_P1
      let pb_i := (weilEtaleSitePullback i_s).sheafPullback AddCommGrpCat.{u}
        E.smallEtaleTopology P1.left.smallEtaleTopology
      let adj_i := (weilEtaleSitePullback i_s).sheafAdjunctionContinuous AddCommGrpCat.{u}
        E.smallEtaleTopology P1.left.smallEtaleTopology
      let pf_P1 := (weilEtaleSitePullback P1.hom).sheafPushforwardContinuous AddCommGrpCat.{u}
