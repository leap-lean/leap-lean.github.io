        letI : NeZero (ℓ : k) := ⟨hℓ.ne_zero⟩
        have : HasEnoughRootsOfUnity k ℓ := IsSepClosed.hasEnoughRootsOfUnity k ℓ
        let hex := HasEnoughRootsOfUnity.exists_primitiveRoot k ℓ
        let w₀ : k := Classical.choose hex
        have hw₀ : IsPrimitiveRoot w₀ ℓ := Classical.choose_spec hex
        have hmul : w₀ * w₀ ^ (ℓ - 1) = 1 := by
          rw [← pow_succ', Nat.sub_add_cancel hPrime.pos, hw₀.pow_eq_one]
        let w : Units k := Units.mkOfMulEqOne w₀ (w₀ ^ (ℓ - 1)) hmul
        have hw_val : (w : k) = w₀ := rfl
        refine ⟨w, ⟨by simpa [pow_one, hw_val] using hw₀, ?_⟩⟩
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, hw_val, hw₀.pow_eq_one]
        have hp1 : (prev.1 : k) ^ 1 = 1 := by simpa [pow_zero] using prev.2.pow_eq_one
        exact (pow_one (prev.1 : k)).symm.trans hp1 |>.symm
      | succ n =>
        let z : Units k := prev.1
        have hz : IsPrimitiveRoot (z : k) (ℓ ^ (n + 1)) := prev.2
        let Q : Polynomial k := Polynomial.X ^ ℓ - Polynomial.C (z : k)
        have hQ_deg : Q.degree ≠ 0 := by
          rw [Polynomial.degree_X_pow_sub_C hPrime.pos (z : k)]
          exact Nat.cast_ne_zero.mpr hPrime.ne_zero
        let hex := IsAlgClosed.exists_root Q hQ_deg
        let w₀ : k := Classical.choose hex
        have hw₀_root : Q.IsRoot w₀ := Classical.choose_spec hex
        have hw₀_pow : w₀ ^ ℓ = (z : k) := sub_eq_zero.mp (by simpa [Q] using hw₀_root)
        have hmul : w₀ * (w₀ ^ (ℓ - 1) * ↑z⁻¹) = 1 := by
          rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel hPrime.pos, hw₀_pow, Units.mul_inv]
        let w : Units k := Units.mkOfMulEqOne w₀ (w₀ ^ (ℓ - 1) * ↑z⁻¹) hmul
        have hw_val : (w : k) = w₀ := rfl
        have hw_pow_z : w ^ ℓ = z :=
          Units.ext (by rw [Units.val_pow_eq_pow_val, hw_val, hw₀_pow])
        refine ⟨w, ⟨?_, hw_pow_z⟩⟩
        rw [IsPrimitiveRoot.iff_orderOf]
        have hw_top : (w : k) ^ (ℓ ^ (n + 2)) = 1 := by
          rw [show ℓ ^ (n + 2) = ℓ * ℓ ^ (n + 1) by rw [pow_succ, mul_comm],
            pow_mul, hw_val, hw₀_pow, hz.pow_eq_one]
        have hdvd : orderOf (w : k) ∣ ℓ ^ (n + 2) := orderOf_dvd_of_pow_eq_one hw_top
        obtain ⟨t, ht_le, ht_eq⟩ := (Nat.dvd_prime_pow hPrime).mp hdvd
        rcases eq_or_lt_of_le ht_le with rfl | ht_lt
        · exact ht_eq
        · exfalso
          have ht_le' : t ≤ n + 1 := Nat.lt_succ_iff.mp ht_lt
          have hdvd' : orderOf (w : k) ∣ ℓ ^ (n + 1) := ht_eq ▸ pow_dvd_pow ℓ ht_le'
          have hw_low : (w : k) ^ (ℓ ^ (n + 1)) = 1 := orderOf_dvd_iff_pow_eq_one.mp hdvd'
          rw [show ℓ ^ (n + 1) = ℓ * ℓ ^ n by rw [pow_succ, mul_comm],
            pow_mul, hw_val, hw₀_pow] at hw_low
          have hdvd_z : ℓ ^ (n + 1) ∣ ℓ ^ n := hz.dvd_of_pow_eq_one _ hw_low
          have hle_z : ℓ ^ (n + 1) ≤ ℓ ^ n := Nat.le_of_dvd (pow_pos hPrime.pos n) hdvd_z
          have hlt_z : ℓ ^ n < ℓ ^ (n + 1) :=
            Nat.pow_lt_pow_right hPrime.one_lt (Nat.lt_succ_self n)
          omega
    let tower : ∀ r : ℕ, { z : Units k // IsPrimitiveRoot (z : k) (ℓ ^ r) } :=
      Nat.rec ⟨1, by simpa [pow_zero] using (IsPrimitiveRoot.one : IsPrimitiveRoot (1 : k) 1)⟩
        (fun r prev => ⟨(stepFn r prev).1, (stepFn r prev).2.1⟩)
    let ζ : ℕ → Units k := fun r => (tower r).1
    have hζ_prim : ∀ r : ℕ, IsPrimitiveRoot (ζ r : k) (ℓ ^ r) := fun r => (tower r).2
    have hζ_pow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r := fun r => (stepFn r (tower r)).2.2
    let ν : ∀ r : ℕ, ZMod (ℓ ^ r) → k := fun r j => (ζ r : k) ^ j.val
    have hν_zero : ∀ r : ℕ, ν r 0 = 1 := by
      intro r
      dsimp [ν]
      rw [ZMod.val_zero, pow_zero]
    have hν_pow : ∀ (r : ℕ) (j : ZMod (ℓ ^ r)), (ν r j) ^ (ℓ ^ r) = 1 := by
      intro r j
      dsimp [ν]
      rw [← pow_mul, mul_comm, pow_mul, (hζ_prim r).pow_eq_one, one_pow]
    have hν_add : ∀ (r : ℕ) (i j : ZMod (ℓ ^ r)), ν r (i + j) = ν r i * ν r j := by
      intro r i j
      have hm_pos : 0 < ℓ ^ r := pow_pos hPrime.pos r
      letI : NeZero (ℓ ^ r) := ⟨hm_pos.ne'⟩
      dsimp [ν]
      rw [← pow_add]
      conv_rhs => rw [← Nat.div_add_mod (i.val + j.val) (ℓ ^ r)]
      rw [pow_add, pow_mul, (hζ_prim r).pow_eq_one, one_pow, one_mul, ZMod.val_add]
    have hν_inj : ∀ r : ℕ, Function.Injective (ν r) := by
      intro r i j hij
      have hm_pos : 0 < ℓ ^ r := pow_pos hPrime.pos r
      letI : NeZero (ℓ ^ r) := ⟨hm_pos.ne'⟩
      apply ZMod.val_injective (ℓ ^ r)
      exact (hζ_prim r).pow_inj (ZMod.val_lt i) (ZMod.val_lt j) hij
    have hν_trans : ∀ (r : ℕ) (c : ZMod (ℓ ^ (r + 1))),
        (ν (r + 1) c) ^ ℓ =
          ν r (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) c) := by
      intro r c
      have hm_pos : 0 < ℓ ^ r := pow_pos hPrime.pos r
      letI : NeZero (ℓ ^ r) := ⟨hm_pos.ne'⟩
      have hcast_val :
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) c).val =
