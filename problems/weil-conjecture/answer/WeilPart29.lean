    have h_len_eq : q₁.length = p.length + 1 := RelSeries.snoc_length q₀ top_Γ h_lt_top
    rw [h_len_eq] at h_len_le
    have h_nat_le : p.length + 1 ≤ m + 1 :=
      ENat.natCast_le_natCast.mp (WithBot.coe_le_coe.mp h_len_le)
