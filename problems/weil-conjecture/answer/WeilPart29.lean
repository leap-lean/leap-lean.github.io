        exact hPb_comp _ _ _ _ _ r (2 * d) τ_ι₂_U τ_U τ_X hpb_ι₂_U_p₁ hpb_U_X
      have heq : τ'_V = τ_ι₂_U :=
        hPb_uniq _ _ _ hι₂_U_cl r (2 * d) τ_X τ'_V τ_ι₂_U hlhs hrhs
      rwa [heq] at hτ'_V
    have hpb_Ψ_axis : WeilGysinSupportPullback Ψ_swap ι₂_U
        (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm)
        (ℓ ^ r) (2 * d) τ_ι₂_U τ_axis_dd := by
      obtain ⟨τ''_V, hτ''_V⟩ := hPb_ex Ψ_swap ι₂_U
        (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) u
        (hAxis_cl d d (2 * d) (Nat.two_mul d).symm) hpb_Ψ r (2 * d) τ_axis_dd
      have hlhs : WeilGysinSupportPullback (CategoryTheory.CategoryStruct.comp p₁_V u)
          ι₂_U (weilGysinAffineOrigin k d) (ℓ ^ r) (2 * d) τ''_V (τ d r) := by
        rw [← hΨ_proj]
        exact hPb_comp _ _ _ _ _ r (2 * d) τ''_V τ_axis_dd (τ d r) hτ''_V hpb_axis_dd
      have hrhs : WeilGysinSupportPullback (CategoryTheory.CategoryStruct.comp p₁_V u)
          ι₂_U (weilGysinAffineOrigin k d) (ℓ ^ r) (2 * d) τ_ι₂_U (τ d r) :=
        hPb_comp _ _ _ _ _ r (2 * d) τ_ι₂_U τ_U (τ d r) hpb_ι₂_U_p₁ hpb_u
      have heq : τ''_V = τ_ι₂_U :=
        hPb_uniq _ _ _ hι₂_U_cl r (2 * d) (τ d r) τ''_V τ_ι₂_U hlhs hrhs
      rwa [heq] at hτ''_V
    obtain ⟨τ_V, hGys_V, _⟩ := hGys_ex hs_V hs_U_cl hι₂_U_cl hs_V_cl h4d τ_U τ_ι₂_U
    have hpb_V_Δ : WeilGysinSupportPullback V_UU.ι s_V
        (CategoryTheory.CategoryStruct.comp s Δ) (ℓ ^ r) (2 * (2 * d)) τ_V τ_Δ :=
      hGys_pb hs_V hs_ι₂
        (CategoryTheory.CategoryStruct.id S_k) U.ι V_UU.ι
        hs_cl hι₂_cl hsΔ_cl hs_U_cl hι₂_U_cl hs_V_cl
        hpb_ι₂_U (hOpen_pb s U s_U hChart_U.2.2.1) h4d
        τ_U τ_ι₂_U τ_V τ_X τ_ι₂ τ_Δ
        hpb_U_X hpb_V_ι₂ hGys_Δ hGys_V
    have hpb_Ψ_2d : WeilGysinSupportPullback Ψ_swap s_V
        (weilGysinAffineOrigin k (2 * d)) (ℓ ^ r) (2 * (2 * d)) τ_V (τ (2 * d) r) :=
      hGys_pb hs_V h_orig_dd
        (CategoryTheory.CategoryStruct.id S_k) u Ψ_swap
        (h0_cl d) (hAxis_cl d d (2 * d) (Nat.two_mul d).symm) (h0_cl (2 * d))
        hs_U_cl hι₂_U_cl hs_V_cl
        hpb_Ψ hChart_U.2.2.2 h4d
        τ_U τ_ι₂_U τ_V (τ d r) τ_axis_dd (τ (2 * d) r)
        hpb_u hpb_Ψ_axis hcomp_dd hGys_V
    have hcl'_P_eq : cl'_P = cl_P :=
      (hPointPkg (2 * d) P (CategoryTheory.CategoryStruct.comp p₁ X.hom)
        (CategoryTheory.CategoryStruct.comp s Δ) hsΔ_sec).2.1 r cl'_P cl_P
        ⟨V_UU, s_V, Ψ_swap, hChart_V, τ_Δ, τ_V, hpb_V_Δ, hpb_Ψ_2d, hfg_Δ⟩ hcl_P
    rw [hcl'_P_eq] at hfg_Δ
    
    obtain ⟨p_ι₂, hp_ι₂, _⟩ := hTorsPb_ex ι₂ r (2 * d)
    have hp_comp : WeilLefschetzTorsionPullback (CategoryTheory.CategoryStruct.id X.left)
        (ℓ ^ r) (2 * d) (p_ι₂.comp p₂_r) := by
      rw [← hι₂_p₂]
      exact hTorsPb_comp ι₂ p₂ r (2 * d) p_ι₂ p₂_r hp_ι₂ hp₂
    have hp_id_eq : p_ι₂.comp p₂_r = AddMonoidHom.id _ :=
      (hTorsPb_ex (CategoryTheory.CategoryStruct.id X.left) r (2 * d)).unique
        hp_comp (hTorsPb_id X.left r (2 * d))
    have hp_eval : p_ι₂ (p₂_r cl_X) = (1 : ℕ) • cl_X := by
      rw [one_nsmul]
      change (p_ι₂.comp p₂_r) cl_X = (AddMonoidHom.id _) cl_X
      rw [hp_id_eq]
    have hcup_res := hEvenProj S_k X.left P s ι₂ (CategoryTheory.CategoryStruct.comp s Δ)
      hs_cl hι₂_cl hsΔ_cl hs_ι₂ r d h4d τ_X τ_ι₂ τ_Δ hGys_Δ
      cl_X (p₁_r cl_X) cl_P hfg_X hfg_ι₂ hfg_Δ
      p_ι₂ c_P_r (p₂_r cl_X) 1 hp_ι₂ hc_P hp_eval
    rwa [one_nsmul] at hcup_res

theorem weil_gysin_smooth_affine_charts_and_steinitz_chain (k : Type u) [Field k] [IsAlgClosed k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    (∀ (c : ℕ) (Y : CategoryTheory.Over S_k)
        [AlgebraicGeometry.SmoothOfRelativeDimension c Y.hom],
      AlgebraicGeometry.IsIntegral Y.left →
      ∀ s : Quiver.Hom S_k Y.left,
        CategoryTheory.CategoryStruct.comp s Y.hom = CategoryTheory.CategoryStruct.id S_k →
        ∃ (W : Y.left.Opens)
          (s_W : Quiver.Hom S_k W.toScheme)
          (u : Quiver.Hom W.toScheme (weilGysinAffineSpace k c)),
          AlgebraicGeometry.IsAffineOpen W ∧
          WeilGysinIsEtaleOriginChart c Y.hom s W s_W u) ∧
    (∃ (ι_P1 : ∀ (Ω : Type u) [Field Ω],
          Quiver.Hom (weilGysinAffineSpace Ω 1) (weilProjectiveSpaceOver Ω 1).left)
        (s_inf : ∀ (Ω : Type u) [Field Ω],
          Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (weilProjectiveSpaceOver Ω 1).left)
        (V_zero_compl : ∀ (Ω : Type u) [Field Ω], (weilProjectiveSpaceOver Ω 1).left.Opens)
        (ι_aff : ∀ δ : ℕ,
          Quiver.Hom (weilGysinAffineSpace k δ) (weilGysinPolyP1Over k δ).left),
      WeilGysinIsPolyP1Compactification k ι_P1 s_inf V_zero_compl ι_aff) ∧
    (∀ (c : ℕ), 1 ≤ c →
      ∀ (Y : CategoryTheory.Over S_k)
        [AlgebraicGeometry.SmoothOfRelativeDimension c Y.hom],
        AlgebraicGeometry.IsIntegral Y.left →
        ∀ (W : Y.left.Opens),
          AlgebraicGeometry.IsAffineOpen W →
          Nonempty ↥W →
          ∀ (u₁ u₂ : Quiver.Hom W.toScheme (weilGysinAffineSpace k c)),
            AlgebraicGeometry.Etale u₁ →
            AlgebraicGeometry.Etale u₂ →
            CategoryTheory.CategoryStruct.comp u₁ (weilGysinAffineStruct k c) =
              CategoryTheory.CategoryStruct.comp W.ι Y.hom →
            CategoryTheory.CategoryStruct.comp u₂ (weilGysinAffineStruct k c) =
              CategoryTheory.CategoryStruct.comp W.ι Y.hom →
            ∃ (W' : Y.left.Opens) (hle : W' ≤ W) (N : ℕ)
              (w : Fin (N + 1) → Quiver.Hom W'.toScheme (weilGysinAffineSpace k c)),
              AlgebraicGeometry.IsAffineOpen W' ∧
              Nonempty ↥W' ∧
              w 0 = CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle) u₁ ∧
              w (Fin.last N) = CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle) u₂ ∧
              (∀ m : Fin (N + 1),
                AlgebraicGeometry.Etale (w m) ∧
                CategoryTheory.CategoryStruct.comp (w m) (weilGysinAffineStruct k c) =
                  CategoryTheory.CategoryStruct.comp W'.ι Y.hom) ∧
              (∀ m : Fin N, ∃ i₀ : Fin c, ∀ j : Fin c, j ≠ i₀ →
                CategoryTheory.CategoryStruct.comp (w m.succ)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                    (Polynomial.aeval (R := k) (MvPolynomial.X j : MvPolynomial (Fin c) k)).toRingHom)) =
                CategoryTheory.CategoryStruct.comp (w m.castSucc)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                    (Polynomial.aeval (R := k) (MvPolynomial.X j : MvPolynomial (Fin c) k)).toRingHom)))) :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hSub_SpecField : ∀ (Ω : Type u) [Field Ω],
      Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    intro Ω _
    refine ⟨fun p₁ p₂ => PrimeSpectrum.ext ?_⟩
    have hbot : ∀ p : PrimeSpectrum Ω, p.asIdeal = ⊥ := fun p =>
      (Submodule.eq_bot_iff p.asIdeal).mpr fun x hx => by
        by_contra hx0
        exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hx (IsUnit.mk0 x hx0))
    exact (hbot p₁).trans (hbot p₂).symm
  have hSm_affStruct : ∀ (Ω : Type u) [Field Ω] (d : ℕ),
      AlgebraicGeometry.SmoothOfRelativeDimension d (weilGysinAffineStruct Ω d) := by
    intro Ω _ d
    have hcard : Nat.card (Fin d) = d := by simp
    have hAlgSm : Algebra.IsStandardSmoothOfRelativeDimension d Ω (MvPolynomial (Fin d) Ω) := by
      have h0 := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial Ω (Fin d)
      rwa [hcard] at h0
    have hRingSm : RingHom.IsStandardSmoothOfRelativeDimension d
        (MvPolynomial.C : Ω →+* MvPolynomial (Fin d) Ω) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap d).mpr hAlgSm
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension d)).mpr
      (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ hRingSm)
  have hEt_comp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z),
      AlgebraicGeometry.Etale f → AlgebraicGeometry.Etale g →
      AlgebraicGeometry.Etale (f ≫ g) := by
    intro X Y Z f g _ _
    infer_instance
  have hOpen_comp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z),
      AlgebraicGeometry.IsOpenImmersion f → AlgebraicGeometry.IsOpenImmersion g →
      AlgebraicGeometry.IsOpenImmersion (f ≫ g) := by
    intro X Y Z f g _ _
    infer_instance
  refine ⟨?_, ?_, ?_⟩
  · 
    
    
    intro c Y hSmY _hIntY s hs
    have : Subsingleton ↥S_k := hSub_SpecField k
    obtain ⟨pt₀⟩ : Nonempty ↥S_k := inferInstance
    let y₀ : ↥Y.left := s.base pt₀
    rcases hSmY with ⟨hSm_loc⟩
    obtain ⟨U₀_open, hU₀_aff, V₀_open, hV₀_aff, hy₀_V₀, he_UV₀, hStd_loc⟩ := hSm_loc y₀
    have hRange_U : Set.range ⇑U₀_open.ι = Set.range ⇑(𝟙 S_k : S_k ⟶ S_k) := by
      ext p
      simp only [AlgebraicGeometry.Scheme.Opens.range_ι, SetLike.mem_coe]
      constructor
      · intro _
        exact ⟨p, rfl⟩
      · intro _
        have hp : p = Y.hom.base y₀ := Subsingleton.elim p (Y.hom.base y₀)
        rw [hp]
        exact he_UV₀ hy₀_V₀
    let e_top : U₀_open.toScheme ≅ S_k :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq U₀_open.ι (𝟙 S_k) hRange_U
    have he_top_hom : e_top.hom = U₀_open.ι :=
      (Category.comp_id e_top.hom).symm.trans
        (AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac U₀_open.ι (𝟙 S_k) hRange_U)
    let R_U := S_k.presheaf.obj (Opposite.op U₀_open)
    let R_V₀ := Y.left.presheaf.obj (Opposite.op V₀_open)
    let e_Spec : AlgebraicGeometry.Spec R_U ≅ S_k := hU₀_aff.isoSpec.symm ≪≫ e_top
    have he_Spec_hom : e_Spec.hom = hU₀_aff.fromSpec := by
      change hU₀_aff.isoSpec.inv ≫ e_top.hom = hU₀_aff.fromSpec
      rw [he_top_hom]
      rfl
    let φ_k : CommRingCat.of k ⟶ R_U := AlgebraicGeometry.Spec.preimage e_Spec.hom
    let ψ_k : R_U ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage e_Spec.inv
    have hφψ : φ_k ≫ ψ_k = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_Spec.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    have hψφ : ψ_k ≫ φ_k = 𝟙 R_U := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_Spec.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    let e_k : k ≃+* ↑R_U :=
      { φ_k.hom with
        invFun := ψ_k.hom
        left_inv := fun x => congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom x) hφψ
        right_inv := fun y => congrArg (fun f : R_U ⟶ R_U => f.hom y) hψφ }
    obtain ⟨g₀, hg₀_C, hg₀_et⟩ :=
      RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd_loc
    let g₁ : MvPolynomial (Fin c) k →+* ↑R_V₀ := g₀.comp (MvPolynomial.map φ_k.hom)
    let g₁_cat : CommRingCat.of (MvPolynomial (Fin c) k) ⟶ R_V₀ := CommRingCat.ofHom g₁
    have hmap_bij : Function.Bijective (MvPolynomial.map φ_k.hom :
        MvPolynomial (Fin c) k →+* MvPolynomial (Fin c) ↑R_U) :=
      (MvPolynomial.mapEquiv (Fin c) e_k).bijective
    have hg₁_et : g₁.Etale :=
      RingHom.Etale.stableUnderComposition (MvPolynomial.map φ_k.hom) g₀
        (RingHom.Etale.of_bijective hmap_bij) hg₀_et
    have hg₁_sp_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g₁_cat) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg₁_et
    let u_raw : V₀_open.toScheme ⟶ weilGysinAffineSpace k c :=
      hV₀_aff.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g₁_cat
    have hu_raw_et : AlgebraicGeometry.Etale u_raw :=
      hEt_comp hV₀_aff.isoSpec.hom (AlgebraicGeometry.Spec.map g₁_cat) inferInstance hg₁_sp_et
    have hg₁_C : CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin c) k) ≫
        g₁_cat = φ_k ≫ Y.hom.appLE U₀_open V₀_open he_UV₀ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      change g₀ (MvPolynomial.map φ_k.hom (MvPolynomial.C x)) =
        (Y.hom.appLE U₀_open V₀_open he_UV₀).hom (φ_k.hom x)
      rw [MvPolynomial.map_C]
      exact congrArg (fun h : ↑R_U →+* ↑R_V₀ => h (φ_k.hom x)) hg₀_C
    have hu_raw_comm : u_raw ≫ weilGysinAffineStruct k c = V₀_open.ι ≫ Y.hom := by
      dsimp [u_raw, weilGysinAffineStruct, weilGysinAffineSpace, S_k]
      rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hg₁_C,
        AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, he_Spec_hom,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Y.hom hU₀_aff hV₀_aff he_UV₀]
      change hV₀_aff.isoSpec.hom ≫ (hV₀_aff.isoSpec.inv ≫ V₀_open.ι) ≫ Y.hom = _
      rw [← Category.assoc, hV₀_aff.isoSpec.hom_inv_id_assoc]
    have hs_range_V₀ : Set.range s.base ⊆ Set.range V₀_open.ι.base := by
      rintro _ ⟨p, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      have hp : p = pt₀ := Subsingleton.elim p pt₀
      rw [hp]
      exact hy₀_V₀
    let s_V₀ : S_k ⟶ V₀_open.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V₀_open.ι s hs_range_V₀
    have hs_V₀_ι : s_V₀ ≫ V₀_open.ι = s :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V₀_open.ι s hs_range_V₀
    let α₀_hom : CommRingCat.of (MvPolynomial (Fin c) k) ⟶ CommRingCat.of k :=
      AlgebraicGeometry.Spec.preimage (s_V₀ ≫ u_raw)
    have hα₀_C : (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin c) k)) ≫ α₀_hom =
        𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_id]
      change (s_V₀ ≫ u_raw) ≫ weilGysinAffineStruct k c = 𝟙 S_k
      rw [Category.assoc, hu_raw_comm, ← Category.assoc, hs_V₀_ι]
      exact hs
    let a_pt : Fin c → k := fun i => α₀_hom.hom (MvPolynomial.X i)
    let τ_sub : MvPolynomial (Fin c) k →+* MvPolynomial (Fin c) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i - MvPolynomial.C (a_pt i))
    let τ_add : MvPolynomial (Fin c) k →+* MvPolynomial (Fin c) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i + MvPolynomial.C (a_pt i))
    have hτ_sub_add : τ_sub.comp τ_add = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp [τ_sub, τ_add]
      · intro i; simp [τ_sub, τ_add]
    have hτ_add_sub : τ_add.comp τ_sub = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp [τ_sub, τ_add]
      · intro i; simp [τ_sub, τ_add]
    let e_τ_sch : weilGysinAffineSpace k c ≅ weilGysinAffineSpace k c :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_sub)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_add)
        hom_inv_id := by
          dsimp [weilGysinAffineSpace]
          rw [← AlgebraicGeometry.Spec.map_comp]
          exact (congrArg AlgebraicGeometry.Spec.map
            (CommRingCat.hom_ext hτ_sub_add)).trans (AlgebraicGeometry.Spec.map_id _)
        inv_hom_id := by
          dsimp [weilGysinAffineSpace]
          rw [← AlgebraicGeometry.Spec.map_comp]
          exact (congrArg AlgebraicGeometry.Spec.map
            (CommRingCat.hom_ext hτ_add_sub)).trans (AlgebraicGeometry.Spec.map_id _) }
    have : CategoryTheory.IsIso e_τ_sch.hom :=
      ⟨⟨e_τ_sch.inv, e_τ_sch.hom_inv_id, e_τ_sch.inv_hom_id⟩⟩
    let u₀ : V₀_open.toScheme ⟶ weilGysinAffineSpace k c := u_raw ≫ e_τ_sch.hom
    have hu₀_et : AlgebraicGeometry.Etale u₀ :=
      hEt_comp u_raw e_τ_sch.hom hu_raw_et inferInstance
    have hu₀_comm : u₀ ≫ weilGysinAffineStruct k c = V₀_open.ι ≫ Y.hom := by
      have hτ_C : CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin c) k) ≫
          CommRingCat.ofHom τ_sub = CommRingCat.ofHom MvPolynomial.C := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r; simp [τ_sub]
      have hstep : e_τ_sch.hom ≫ weilGysinAffineStruct k c = weilGysinAffineStruct k c := by
        dsimp [e_τ_sch, weilGysinAffineStruct, weilGysinAffineSpace]
        rw [← AlgebraicGeometry.Spec.map_comp, hτ_C]
      change (u_raw ≫ e_τ_sch.hom) ≫ weilGysinAffineStruct k c = _
      rw [Category.assoc, hstep, hu_raw_comm]
    have hs_u₀ : s_V₀ ≫ u₀ = weilGysinAffineOrigin k c := by
      let su_spec : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin c) k)) := s_V₀ ≫ u_raw
      have h1 : s_V₀ ≫ u₀ =
          su_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_sub) :=
        (Category.assoc s_V₀ u_raw e_τ_sch.hom).symm
      rw [h1, ← AlgebraicGeometry.Spec.map_preimage su_spec, ← AlgebraicGeometry.Spec.map_comp]
      change AlgebraicGeometry.Spec.map _ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin c → k)))
      congr 1
      apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        change α₀_hom.hom (τ_sub (MvPolynomial.C r)) = MvPolynomial.eval 0 (MvPolynomial.C r)
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval_C]
        exact congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom r) hα₀_C
      · intro i
        change α₀_hom.hom (τ_sub (MvPolynomial.X i)) = MvPolynomial.eval 0 (MvPolynomial.X i)
        have hα_a : α₀_hom.hom (MvPolynomial.C (a_pt i)) = a_pt i :=
          congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom (a_pt i)) hα₀_C
        simp [τ_sub, a_pt, hα_a]
    
    let F₀ := CategoryTheory.Limits.pullback u₀ (weilGysinAffineOrigin k c)
    let π₁ : F₀ ⟶ V₀_open.toScheme := CategoryTheory.Limits.pullback.fst u₀ (weilGysinAffineOrigin k c)
    let π₂ : F₀ ⟶ S_k := CategoryTheory.Limits.pullback.snd u₀ (weilGysinAffineOrigin k c)
