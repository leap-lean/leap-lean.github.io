        intro M m₁ m₂ h
        have h1 := congrArg (fun φ : R_mod ⟶ M => φ.hom (1 : R)) h
        simpa only [toHom, ModuleCat.hom_ofHom, LinearMap.coe_mk, AddHom.coe_mk, one_smul] using h1
      have toHom_post : ∀ {M N : ModuleCat.{u, u} R} (m : ↥M) (f : M ⟶ N),
