            (@AlgebraicGeometry.LocallyOfFiniteType.stalkMap U.left S U.hom inferInstance y₀)
        have : Algebra.FormallyUnramified ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀) :=
          RingHom.formallyUnramified_algebraMap.mp
            (AlgebraicGeometry.HasRingHomProperty.stalkMap
              (P := @AlgebraicGeometry.FormallyUnramified)
              (Q := fun {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] =>
                @RingHom.FormallyUnramified R₀ S₀ _ _)
              (fun {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] f hf J hJ => by
                have : J.IsPrime := hJ
                have : (Ideal.comap f J).IsPrime := Ideal.IsPrime.comap f
                let _ : Algebra R₀ S₀ := f.toAlgebra
                have : Algebra.FormallyUnramified R₀ S₀ :=
