              (IsLocalization.AtPrime.isUnit_to_map_iff
                ↑(P1.left.presheaf.stalk x.1) p_x.asIdeal b_c).mpr hbc_not
            exact Ideal.span_singleton_eq_top.mpr hr_unit
          · rw [Ideal.span_singleton_one, pow_zero, Ideal.one_eq_top]
          · rw [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_of_ne hxQ,
              Finsupp.single_eq_of_ne hx_inf]
            norm_num

