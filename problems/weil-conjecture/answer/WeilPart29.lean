      have hCompat : TopCat.Presheaf.IsCompatible Y.presheaf V_lvl sf := by
        intro i j
        by_cases hij : i = j
        · subst hij; rfl
        · apply TopCat.Presheaf.section_ext Y.sheaf (V_lvl i ⊓ V_lvl j)
