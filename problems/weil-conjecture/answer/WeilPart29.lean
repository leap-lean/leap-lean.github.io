    intro n
    induction n with
    | zero =>
      intro G
      apply subsingleton_of_forall_eq 0
      intro y
      let I := CategoryTheory.Injective.under G
      let ι_G : G ⟶ I := CategoryTheory.Injective.ι G
      let p_G : I ⟶ CategoryTheory.Limits.cokernel ι_G := CategoryTheory.Limits.cokernel.π ι_G
