    change topologicalKrullDim (PrimeSpectrum ↑R) ≤ (0 : WithBot ℕ∞)
    rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    exact hRingDim
  
  have hSpecKSectionAndSieve : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      let Z_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := weilEtaleIdTerminal Z_K
      (∀ (W₀ : Z_K.Etale) (z : ↥W₀.left), ∃ σ_z : T_K ⟶ W₀, z ∈ Set.range σ_z.left.base) ∧
      (∀ {U₀ : Z_K.Etale} (R : CategoryTheory.Sieve U₀),
        R ∈ Z_K.smallEtaleTopology U₀ → ∀ (σ : T_K ⟶ U₀), R.arrows σ) := by
    intro K _ _ Z_K T_K
    have hSec : ∀ (W₀ : Z_K.Etale) (z : ↥W₀.left),
        ∃ σ_z : T_K ⟶ W₀, z ∈ Set.range σ_z.left.base := by
      intro W₀ z
      obtain ⟨V, hV, hz, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : W₀.left.Opens))
          (x := z) trivial
      let R_V := W₀.left.presheaf.obj (Opposite.op V)
      have : AlgebraicGeometry.Etale W₀.hom := W₀.prop
      have hf_et : AlgebraicGeometry.Etale (hV.fromSpec ≫ W₀.hom) := inferInstance
      let ψ_V : CommRingCat.of K ⟶ R_V := AlgebraicGeometry.Spec.preimage (hV.fromSpec ≫ W₀.hom)
      have hψ_spec : AlgebraicGeometry.Spec.map ψ_V = hV.fromSpec ≫ W₀.hom :=
        AlgebraicGeometry.Spec.map_preimage (hV.fromSpec ≫ W₀.hom)
      have hψ_et : RingHom.Etale ψ_V.hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hψ_spec.symm ▸ hf_et)
      let _ : Algebra K ↑R_V := ψ_V.hom.toAlgebra
      have hAlgEt : Algebra.Etale K ↑R_V := RingHom.etale_algebraMap.mp hψ_et
      obtain ⟨I_idx, hFinI, Ai, instFieldAi, instAlgAi, e_prod, hModFin⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K ↑R_V).mp hAlgEt
      have := hFinI
      let _ := instFieldAi
      let _ := instAlgAi
      have : ∀ i : I_idx, Module.Finite K (Ai i) := fun i => (hModFin i).1
      have : Module.Finite K ↑R_V := Module.Finite.equiv e_prod.symm.toLinearEquiv
      have : Algebra.IsIntegral K ↑R_V := Algebra.IsIntegral.of_finite K ↑R_V
      let p_z : PrimeSpectrum ↑R_V := hV.isoSpec.hom.base ⟨z, hz⟩
      have : p_z.asIdeal.IsPrime := p_z.isPrime
      let _ : IsDomain (↑R_V ⧸ p_z.asIdeal) := Ideal.Quotient.isDomain p_z.asIdeal
      have : Algebra.IsIntegral K (↑R_V ⧸ p_z.asIdeal) :=
        ⟨fun xbar => by
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xbar
          exact (Algebra.IsIntegral.isIntegral (R := K) x).map (Ideal.Quotient.mkₐ K p_z.asIdeal)⟩
      have hBij : Function.Bijective (algebraMap K (↑R_V ⧸ p_z.asIdeal)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let e_z : K ≃+* (↑R_V ⧸ p_z.asIdeal) := RingEquiv.ofBijective _ hBij
      let ret : R_V ⟶ CommRingCat.of K :=
        CommRingCat.ofHom (e_z.symm.toRingHom.comp (Ideal.Quotient.mk p_z.asIdeal))
      have hψ_ret : ψ_V ≫ ret = 𝟙 (CommRingCat.of K) := by
        ext c
        exact e_z.symm_apply_apply c
      let σ_left : Z_K ⟶ W₀.left := AlgebraicGeometry.Spec.map ret ≫ hV.fromSpec
      have hσ_w : σ_left ≫ W₀.hom = T_K.hom := by
        change (AlgebraicGeometry.Spec.map ret ≫ hV.fromSpec) ≫ W₀.hom = 𝟙 Z_K
        rw [CategoryTheory.Category.assoc, ← hψ_spec, ← AlgebraicGeometry.Spec.map_comp,
          hψ_ret, AlgebraicGeometry.Spec.map_id]
      let σ_z : T_K ⟶ W₀ := CategoryTheory.MorphismProperty.Over.homMk σ_left hσ_w trivial
      let pt_K : ↥Z_K := (⊥ : PrimeSpectrum K)
      refine ⟨σ_z, pt_K, ?_⟩
      have hpt_eq : (AlgebraicGeometry.Spec.map ret).base pt_K = p_z := by
        apply PrimeSpectrum.ext
        ext r
        change e_z.symm (Ideal.Quotient.mk p_z.asIdeal r) ∈ (⊥ : Ideal K) ↔ r ∈ p_z.asIdeal
        rw [Ideal.mem_bot, map_eq_zero_iff e_z.symm e_z.symm.injective,
          Ideal.Quotient.eq_zero_iff_mem]
      have hcomp1 : σ_left.base pt_K = hV.fromSpec.base ((AlgebraicGeometry.Spec.map ret).base pt_K) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply (AlgebraicGeometry.Spec.map ret) hV.fromSpec pt_K
      have hcomp2 : hV.fromSpec.base p_z = z := by
        have h1 : hV.fromSpec.base p_z = V.ι.base (hV.isoSpec.inv.base (hV.isoSpec.hom.base ⟨z, hz⟩)) :=
          AlgebraicGeometry.Scheme.Hom.comp_apply hV.isoSpec.inv V.ι (hV.isoSpec.hom.base ⟨z, hz⟩)
        have h2 : hV.isoSpec.inv.base (hV.isoSpec.hom.base ⟨z, hz⟩) =
            (hV.isoSpec.hom ≫ hV.isoSpec.inv).base ⟨z, hz⟩ :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply hV.isoSpec.hom hV.isoSpec.inv ⟨z, hz⟩).symm
        have h3 : (hV.isoSpec.hom ≫ hV.isoSpec.inv).base ⟨z, hz⟩ = ⟨z, hz⟩ :=
          congrArg (fun k : V.toScheme ⟶ V.toScheme => k.base ⟨z, hz⟩) hV.isoSpec.hom_inv_id
        exact h1.trans (congrArg V.ι.base (h2.trans h3))
      exact hcomp1.trans ((congrArg hV.fromSpec.base hpt_eq).trans hcomp2)
    refine ⟨hSec, ?_⟩
    intro U₀ R hR σ
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let R' : CategoryTheory.Sieve T_K := R.pullback σ
    have hR' : R' ∈ Z_K.smallEtaleTopology T_K :=
      Z_K.smallEtaleTopology.pullback_stable σ hR
    have hJ :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) Z_K (le_refl _)
    obtain ⟨W₀, h_W, z₀, hh_W, -, -⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) T_K R').mp
        (Eq.mp (congrArg (fun G => R' ∈ G T_K) hJ) hR') (⊥ : PrimeSpectrum K)
    obtain ⟨σ_z, -⟩ := hSec W₀ z₀
    have hid : σ_z ≫ h_W = 𝟙 T_K := (weilEtaleIdTerminalIsTerminal Z_K).hom_ext _ _
    have hid_mem : R'.arrows (𝟙 T_K) := hid ▸ R'.downward_closed hh_W σ_z
    change R.arrows (𝟙 T_K ≫ σ) at hid_mem
    rwa [CategoryTheory.Category.id_comp] at hid_mem
  
  have hSpecKSheafZero : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (P : CategoryTheory.Functor ((AlgebraicGeometry.Spec (CommRingCat.of K)).Etale)ᵒᵖ AddCommGrpCat.{u}),
