    obtain ⟨V, v, τ_V, hmap_V, hs_zero⟩ :=
      (Φ_x.toPresheafFiber_eq_iff' (P := ℋ.obj) U τ_u s 0).mp h_eq_fib
    rw [map_zero] at hs_zero
    let w : S_x ⟶ V.left := τ_V.left ≫ π_fst V
    exact ⟨V, v, w,
      (hFg_map_fst v τ_V).symm.trans
        ((congrArg (fun k : F_g.obj U => k.left ≫ π_fst U) hmap_V).trans (hmkSec_fst U u hu)),
      hs_zero⟩

  
  have hStalkAllToZero : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (ℋ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ x : ↥S, WeilAltCdStalkZeroAt S ℋ x) →
      CategoryTheory.Limits.IsZero ℋ := by
    intro S ℋ hStalk
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_injective
    change CategoryTheory.CategoryStruct.id ℋ.obj = 0
    ext ⟨U⟩ s
    simp only [CategoryTheory.NatTrans.id_app, CategoryTheory.NatTrans.app_zero,
      AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
    let R_U : CategoryTheory.Sieve U :=
      CategoryTheory.Sieve.mk (fun V v => ℋ.obj.map (Opposite.op v) s = 0)
        (fun {V W f} hf g => by
          change (ℋ.obj.map (CategoryTheory.CategoryStruct.comp (Opposite.op f) (Opposite.op g))) s = 0
          rw [ℋ.obj.map_comp, AddCommGrpCat.comp_apply, hf, map_zero])
    have hCov : R_U ∈ S.smallEtaleTopology U := by
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      let U' : P_et.Over ⊤ S := U
      let R_U' : CategoryTheory.Sieve U' := R_U
      change R_U' ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S) U'
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology,
        AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology]
      · intro y
        let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
        let y₀ : ↥U.left := y
        have : AlgebraicGeometry.Etale U.hom := U.prop
        let x : ↥S := U.hom.base y₀
        let _ : Algebra ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀) :=
          (@AlgebraicGeometry.Scheme.Hom.stalkMap U.left S U.hom y₀).hom.toAlgebra
        have : IsLocalHom (algebraMap ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀)) :=
          (inferInstance : IsLocalHom (@AlgebraicGeometry.Scheme.Hom.stalkMap U.left S U.hom y₀).hom)
        have : Algebra.EssFiniteType ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀) :=
