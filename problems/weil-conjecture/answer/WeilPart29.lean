      dsimp only [weilEtaleCechDiff]
      rw [hsum_app, hsum_app, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [AddMonoidHom.zsmul_apply, AddMonoidHom.zsmul_apply, map_zsmul]
      congr 1
      exact ConcreteCategory.congr_hom (α.naturality (weilEtaleCechFace w m j).op) x
    let isoK : weilEtaleKPresheaf Y.left ≅ (weilEtaleKSheaf Y.left).obj :=
