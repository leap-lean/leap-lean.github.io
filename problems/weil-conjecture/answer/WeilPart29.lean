      (CategoryTheory.Limits.pullback.fst Y.hom P.hom)
    let π_P := CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Hom.imageι γ_g)
      (CategoryTheory.Limits.pullback.snd Y.hom P.hom)
