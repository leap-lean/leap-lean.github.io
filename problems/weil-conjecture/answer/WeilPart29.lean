      CategoryTheory.Limits.pullback.lift_fst s_W (𝟙 S_k) hs_W_rest
    have hs_Cm_p : s_Cm ≫ p_Cm = 𝟙 S_k :=
      CategoryTheory.Limits.pullback.lift_snd s_W (𝟙 S_k) hs_W_rest
    let s_Cm_top : Quiver.Hom S_k (⊤ : C_m.Opens).toScheme := s_Cm ≫ C_m.topIso.inv
    let i_Cm_top : Quiver.Hom (⊤ : C_m.Opens).toScheme W.toScheme := (⊤ : C_m.Opens).ι ≫ i_Cm
    have hs_Cm_top_ι : s_Cm_top ≫ (⊤ : C_m.Opens).ι = s_Cm := by
      dsimp only [s_Cm_top]
      rw [← C_m.topIso_hom, CategoryTheory.Category.assoc, C_m.topIso.inv_hom_id,
        CategoryTheory.Category.comp_id]
    have hi_Cm_top_cl : AlgebraicGeometry.IsClosedImmersion i_Cm_top := by
      dsimp only [i_Cm_top]
      rw [← C_m.topIso_hom]
      exact inferInstance
    have hs_Cm_top_i : s_Cm_top ≫ i_Cm_top = s_W := by
      dsimp only [i_Cm_top]
      rw [← CategoryTheory.Category.assoc, hs_Cm_top_ι, hs_Cm_i]
    have hpb_rest : CategoryTheory.IsPullback i_Cm_top ((⊤ : C_m.Opens).ι ≫ p_Cm)
        h_rest_m orig_b := by
      refine CategoryTheory.IsPullback.of_iso_pullback
        ⟨by
          dsimp only [i_Cm_top]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc]⟩
        C_m.topIso ?_ ?_
      · dsimp only [i_Cm_top, i_Cm]
        rw [C_m.topIso_hom]
      · dsimp only [p_Cm]
        rw [C_m.topIso_hom]
    have h_mk_g : ∀ (h_ν : Quiver.Hom W.toScheme (weilGysinAffineSpace k (b + 1))),
        WeilGysinIsEtaleOriginChart (b + 1) p_Y s W s_W h_ν →
        (h_ν ≫ perm_π) ≫ projR = h_rest_m →
        ∃ g_ν : Quiver.Hom (⊤ : C_m.Opens).toScheme (weilGysinAffineSpace k 1),
          WeilGysinIsEtaleOriginChart 1 p_Cm s_Cm ⊤ s_Cm_top g_ν ∧
          CategoryTheory.IsPullback i_Cm_top g_ν (h_ν ≫ perm_π) leftAx := by
      intro h_ν hChart_ν h_proj_ν
      let h'_ν := h_ν ≫ perm_π
      have hh'_et : AlgebraicGeometry.Etale h'_ν := by
        have : AlgebraicGeometry.Etale h_ν := hChart_ν.1
        dsimp only [h'_ν]
        exact inferInstance
      have hpb_h'_orig : CategoryTheory.IsPullback s_W (𝟙 S_k)
          h'_ν (weilGysinAffineOrigin k (b + 1)) := by
        have hp := hChart_ν.2.2.2.paste_vert hpb_perm
        simpa only [S_k, CategoryTheory.Category.id_comp] using hp
      have hs_h' : s_W ≫ h'_ν = weilGysinAffineOrigin k (b + 1) :=
        hpb_h'_orig.w.trans (CategoryTheory.Category.id_comp _)
      have h_cond_ν : (i_Cm_top ≫ h'_ν) ≫ projR = ((⊤ : C_m.Opens).ι ≫ p_Cm) ≫ orig_b := by
        rw [CategoryTheory.Category.assoc, h_proj_ν, hpb_rest.w]
      let g_ν : Quiver.Hom (⊤ : C_m.Opens).toScheme (weilGysinAffineSpace k 1) :=
        hpb_ax.lift (i_Cm_top ≫ h'_ν) ((⊤ : C_m.Opens).ι ≫ p_Cm) h_cond_ν
      have hg_ax : g_ν ≫ leftAx = i_Cm_top ≫ h'_ν :=
        hpb_ax.lift_fst _ _ h_cond_ν
      have hg_str : g_ν ≫ weilGysinAffineStruct k 1 = (⊤ : C_m.Opens).ι ≫ p_Cm :=
        hpb_ax.lift_snd _ _ h_cond_ν
      have hpb_outer_vert : CategoryTheory.IsPullback i_Cm_top ((⊤ : C_m.Opens).ι ≫ p_Cm)
          (h'_ν ≫ projR) orig_b := by
        rwa [h_proj_ν]
      have hpb_g : CategoryTheory.IsPullback i_Cm_top g_ν h'_ν leftAx :=
        CategoryTheory.IsPullback.of_bot' hpb_outer_vert hpb_ax
      have hg_et : AlgebraicGeometry.Etale g_ν :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.Etale) hpb_g hh'_et
      have hs_g : s_Cm_top ≫ g_ν = weilGysinAffineOrigin k 1 := by
        apply hpb_ax.hom_ext
        · rw [CategoryTheory.Category.assoc, hg_ax, ← CategoryTheory.Category.assoc,
            hs_Cm_top_i, hs_h', h_orig1_ax]
        · rw [CategoryTheory.Category.assoc, hg_str, ← CategoryTheory.Category.assoc,
            hs_Cm_top_ι, hs_Cm_p, h0_str 1]
      have hpb_outer_horiz : CategoryTheory.IsPullback s_W (𝟙 S_k)
          h'_ν (weilGysinAffineOrigin k 1 ≫ leftAx) := by
        rwa [h_orig1_ax]
      have hpb_g_lift := CategoryTheory.IsPullback.of_right' hpb_outer_horiz hpb_g
      have h_lift_eq : hpb_g.lift s_W (𝟙 S_k ≫ weilGysinAffineOrigin k 1)
          (by rw [CategoryTheory.Category.id_comp, h_orig1_ax, hs_h']) = s_Cm_top := by
        apply hpb_g.hom_ext
        · rw [hpb_g.lift_fst, hs_Cm_top_i]
        · rw [hpb_g.lift_snd, CategoryTheory.Category.id_comp, hs_g]
      have hpb_g_orig : CategoryTheory.IsPullback s_Cm_top (𝟙 S_k)
          g_ν (weilGysinAffineOrigin k 1) := by
        convert hpb_g_lift using 1
        exact h_lift_eq.symm
      exact ⟨g_ν, ⟨hg_et, hg_str, hs_Cm_top_ι, hpb_g_orig⟩, hpb_g⟩
    obtain ⟨g_m1, hg_m1_chart, hpb_1⟩ := h_mk_g h₁ hChart₁ rfl
    obtain ⟨g_m2, hg_m2_chart, hpb_2⟩ := h_mk_g h₂ hChart₂ h_proj_eq.symm
    exact ⟨C_m, p_Cm, hp_Cm_sep, s_Cm, s_Cm_top, i_Cm_top, h_rest_m, g_m1, g_m2,
      hi_Cm_top_cl, hs_Cm_p, hs_Cm_top_i, hg_m1_chart, hg_m2_chart, hpb_rest,
      rfl, h_proj_eq.symm, hpb_1, hpb_2⟩

theorem weil_gysin_affine_coord_geometry_and_steinitz_chain (k : Type u) [Field k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    ((AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom ∧
        CategoryTheory.IsIso (weilGysinAffineOrigin k 0) ∧
        CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k 0)
          (weilGysinAffineStruct k 0) = CategoryTheory.CategoryStruct.id S_k ∧
        CategoryTheory.CategoryStruct.comp (weilGysinAffineStruct k 0)
          (weilGysinAffineOrigin k 0) =
          CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k 0) ∧
        (∀ c : ℕ, AlgebraicGeometry.IsClosedImmersion (weilGysinAffineOrigin k c)) ∧
        (∀ (a b ab : ℕ) (hab : a + b = ab),
          AlgebraicGeometry.IsClosedImmersion (weilGysinAffineLeftAxis k a b ab hab)) ∧
        (∀ {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
          [AlgebraicGeometry.IsSeparated p_Y] (s : Quiver.Hom S_k Y),
          CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k →
          AlgebraicGeometry.IsClosedImmersion s)) ∧
      ((∀ a : ℕ,
          weilGysinAffineLeftAxis k a 0 a (Nat.add_zero a) =
            CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k a)) ∧
        weilGysinAffineProjRight k 0 1 1 (Nat.zero_add 1) =
          CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k 1) ∧
        (∀ (a b ab : ℕ) (hab : a + b = ab),
          CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k a)
            (weilGysinAffineLeftAxis k a b ab hab) = weilGysinAffineOrigin k ab ∧
          CategoryTheory.IsPullback (weilGysinAffineLeftAxis k a b ab hab)
            (weilGysinAffineStruct k a)
            (weilGysinAffineProjRight k a b ab hab)
            (weilGysinAffineOrigin k b)) ∧
        (∀ (a b' b ab' ab : ℕ)
          (hb : b' + 1 = b) (hab' : a + b' = ab') (hab : a + b = ab) (hab1 : ab' + 1 = ab),
          CategoryTheory.CategoryStruct.comp
            (weilGysinAffineLeftAxis k a b' ab' hab')
            (weilGysinAffineLeftAxis k ab' 1 ab hab1) =
            weilGysinAffineLeftAxis k a b ab hab ∧
          CategoryTheory.CategoryStruct.comp
            (weilGysinAffineProjRight k a b ab hab)
            (weilGysinAffineProjRight k b' 1 b hb) =
            weilGysinAffineProjRight k ab' 1 ab hab1 ∧
          CategoryTheory.IsPullback
            (weilGysinAffineLeftAxis k ab' 1 ab hab1)
            (weilGysinAffineProjRight k a b' ab' hab')
            (weilGysinAffineProjRight k a b ab hab)
            (weilGysinAffineLeftAxis k b' 1 b hb))) ∧
      ((∀ c : ℕ,
          weilGysinAffinePerm k c 1 =
            CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k c)) ∧
        (∀ (c : ℕ) (π₁ π₂ : Equiv.Perm (Fin c)),
          weilGysinAffinePerm k c (π₁ * π₂) =
            CategoryTheory.CategoryStruct.comp
              (weilGysinAffinePerm k c π₁) (weilGysinAffinePerm k c π₂)) ∧
        (∀ (c : ℕ) (π : Equiv.Perm (Fin c)),
          CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c)
            (weilGysinAffinePerm k c π) = weilGysinAffineOrigin k c ∧
          CategoryTheory.IsPullback (weilGysinAffineOrigin k c)
            (CategoryTheory.CategoryStruct.id S_k)
            (weilGysinAffinePerm k c π) (weilGysinAffineOrigin k c)) ∧
        (∀ (c m : ℕ) (hm : m + 2 ≤ c) (hc_split : (m + 2) + (c - (m + 2)) = c),
          let s_m : Equiv.Perm (Fin c) := Equiv.swap ⟨m, by omega⟩ ⟨m + 1, by omega⟩
          let s_L : Equiv.Perm (Fin (m + 2)) := Equiv.swap ⟨m, by omega⟩ ⟨m + 1, by omega⟩
          CategoryTheory.IsPullback
            (weilGysinAffineLeftAxis k (m + 2) (c - (m + 2)) c hc_split)
            (weilGysinAffinePerm k (m + 2) s_L)
            (weilGysinAffinePerm k c s_m)
            (weilGysinAffineLeftAxis k (m + 2) (c - (m + 2)) c hc_split) ∧
          CategoryTheory.CategoryStruct.comp
            (weilGysinAffinePerm k c s_m)
            (weilGysinAffineProjRight k (m + 2) (c - (m + 2)) c hc_split) =
            weilGysinAffineProjRight k (m + 2) (c - (m + 2)) c hc_split ∧
          CategoryTheory.IsPullback
            (weilGysinAffineLeftAxis k m 2 (m + 2) rfl)
            (CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k m))
            (weilGysinAffinePerm k (m + 2) s_L)
            (weilGysinAffineLeftAxis k m 2 (m + 2) rfl) ∧
          CategoryTheory.CategoryStruct.comp
            (weilGysinAffinePerm k (m + 2) s_L)
            (weilGysinAffineProjRight k m 2 (m + 2) rfl) =
            CategoryTheory.CategoryStruct.comp
              (weilGysinAffineProjRight k m 2 (m + 2) rfl)
              (weilGysinAffinePerm k 2 (Equiv.swap (0 : Fin 2) (1 : Fin 2)))))) ∧
    (∀ (d : ℕ) (X : CategoryTheory.Over S_k) [AlgebraicGeometry.IsSeparated X.hom]
        (s : Quiver.Hom S_k X.left),
      CategoryTheory.CategoryStruct.comp s X.hom = CategoryTheory.CategoryStruct.id S_k →
      ∀ (U : X.left.Opens) (s_U : Quiver.Hom S_k U.toScheme)
        (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k d)),
        WeilGysinIsEtaleOriginChart d X.hom s U s_U u →
        let P := CategoryTheory.Limits.pullback X.hom X.hom
        let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
        let p₂ := CategoryTheory.Limits.pullback.snd X.hom X.hom
        let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
        ∃ (ι₂ : Quiver.Hom X.left P)
          (V_UU : P.Opens)
          (s_V : Quiver.Hom S_k V_UU.toScheme)
          (ι₂_U : Quiver.Hom U.toScheme V_UU.toScheme)
          (p₁_V : Quiver.Hom V_UU.toScheme U.toScheme)
          (Ψ_swap : Quiver.Hom V_UU.toScheme (weilGysinAffineSpace k (2 * d))),
          AlgebraicGeometry.IsSeparated (CategoryTheory.CategoryStruct.comp p₁ X.hom) ∧
          AlgebraicGeometry.IsClosedImmersion ι₂ ∧
          AlgebraicGeometry.IsClosedImmersion ι₂_U ∧
          CategoryTheory.CategoryStruct.comp s ι₂ = CategoryTheory.CategoryStruct.comp s Δ ∧
          CategoryTheory.CategoryStruct.comp ι₂ p₂ = CategoryTheory.CategoryStruct.id X.left ∧
          CategoryTheory.IsPullback ι₂ X.hom p₁ s ∧
          WeilGysinIsEtaleOriginChart (2 * d)
            (CategoryTheory.CategoryStruct.comp p₁ X.hom)
            (CategoryTheory.CategoryStruct.comp s Δ) V_UU s_V Ψ_swap ∧
          CategoryTheory.CategoryStruct.comp s_U ι₂_U = s_V ∧
          CategoryTheory.IsPullback ι₂_U U.ι V_UU.ι ι₂ ∧
          CategoryTheory.IsPullback ι₂_U
            (CategoryTheory.CategoryStruct.comp U.ι X.hom) p₁_V s_U ∧
          CategoryTheory.CategoryStruct.comp p₁_V U.ι =
            CategoryTheory.CategoryStruct.comp V_UU.ι p₁ ∧
          CategoryTheory.IsPullback ι₂_U u Ψ_swap
            (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
          CategoryTheory.CategoryStruct.comp Ψ_swap
            (weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) =
            CategoryTheory.CategoryStruct.comp p₁_V u) ∧
    ((∀ {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
          (s : Quiver.Hom S_k Y) (U : Y.Opens) (s_U : Quiver.Hom S_k U.toScheme)
          (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k 0)),
        WeilGysinIsEtaleOriginChart 0 p_Y s U s_U u →
        CategoryTheory.IsIso s_U) ∧
      (∀ {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
          (s : Quiver.Hom S_k Y)
          (U₁ U₂ : Y.Opens)
          (s_U₁ : Quiver.Hom S_k U₁.toScheme) (s_U₂ : Quiver.Hom S_k U₂.toScheme)
          (u₁ : Quiver.Hom U₁.toScheme (weilGysinAffineSpace k 0))
          (u₂ : Quiver.Hom U₂.toScheme (weilGysinAffineSpace k 0)),
        WeilGysinIsEtaleOriginChart 0 p_Y s U₁ s_U₁ u₁ →
        WeilGysinIsEtaleOriginChart 0 p_Y s U₂ s_U₂ u₂ →
        ∃ (W : Y.Opens) (hle₁ : W ≤ U₁) (hle₂ : W ≤ U₂)
          (s_W : Quiver.Hom S_k W.toScheme),
          CategoryTheory.CategoryStruct.comp s_W W.ι = s ∧
          CategoryTheory.CategoryStruct.comp s_W (Y.homOfLE hle₁) = s_U₁ ∧
          CategoryTheory.CategoryStruct.comp s_W (Y.homOfLE hle₂) = s_U₂ ∧
          WeilGysinIsEtaleOriginChart 0 p_Y s W s_W
            (CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₁) u₁) ∧
          CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₁) u₁ =
            CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₂) u₂)) ∧
    (∀ (b : ℕ) (h1b : 1 + b = b + 1)
        {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
        [AlgebraicGeometry.IsSeparated p_Y] (s : Quiver.Hom S_k Y),
      CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k →
      ∀ (U₁ U₂ : Y.Opens)
        (s_U₁ : Quiver.Hom S_k U₁.toScheme) (s_U₂ : Quiver.Hom S_k U₂.toScheme)
        (u₁ : Quiver.Hom U₁.toScheme (weilGysinAffineSpace k (b + 1)))
        (u₂ : Quiver.Hom U₂.toScheme (weilGysinAffineSpace k (b + 1))),
        WeilGysinIsEtaleOriginChart (b + 1) p_Y s U₁ s_U₁ u₁ →
        WeilGysinIsEtaleOriginChart (b + 1) p_Y s U₂ s_U₂ u₂ →
        ∃ (W : Y.Opens) (hle₁ : W ≤ U₁) (hle₂ : W ≤ U₂)
          (s_W : Quiver.Hom S_k W.toScheme)
          (N : ℕ)
          (h : Fin (N + 1) → Quiver.Hom W.toScheme (weilGysinAffineSpace k (b + 1))),
          CategoryTheory.CategoryStruct.comp s_W W.ι = s ∧
          CategoryTheory.CategoryStruct.comp s_W (Y.homOfLE hle₁) = s_U₁ ∧
          CategoryTheory.CategoryStruct.comp s_W (Y.homOfLE hle₂) = s_U₂ ∧
          h 0 = CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₁) u₁ ∧
          h (Fin.last N) = CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₂) u₂ ∧
          (∀ m : Fin (N + 1), WeilGysinIsEtaleOriginChart (b + 1) p_Y s W s_W (h m)) ∧
          (∀ m : Fin N,
            ∃ (π_m : Equiv.Perm (Fin (b + 1)))
              (C_m : AlgebraicGeometry.Scheme.{u})
              (p_Cm : Quiver.Hom C_m S_k)
              (_ : AlgebraicGeometry.IsSeparated p_Cm)
              (s_Cm : Quiver.Hom S_k C_m)
              (s_Cm_top : Quiver.Hom S_k (⊤ : C_m.Opens).toScheme)
              (i_Cm_top : Quiver.Hom (⊤ : C_m.Opens).toScheme W.toScheme)
              (h_rest_m : Quiver.Hom W.toScheme (weilGysinAffineSpace k b))
              (g_m1 g_m2 : Quiver.Hom (⊤ : C_m.Opens).toScheme (weilGysinAffineSpace k 1)),
              AlgebraicGeometry.IsClosedImmersion i_Cm_top ∧
              CategoryTheory.CategoryStruct.comp s_Cm p_Cm =
                CategoryTheory.CategoryStruct.id S_k ∧
              CategoryTheory.CategoryStruct.comp s_Cm_top i_Cm_top = s_W ∧
              WeilGysinIsEtaleOriginChart 1 p_Cm s_Cm ⊤ s_Cm_top g_m1 ∧
              WeilGysinIsEtaleOriginChart 1 p_Cm s_Cm ⊤ s_Cm_top g_m2 ∧
              CategoryTheory.IsPullback i_Cm_top
                (CategoryTheory.CategoryStruct.comp (⊤ : C_m.Opens).ι p_Cm)
                h_rest_m (weilGysinAffineOrigin k b) ∧
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (h m.castSucc)
                  (weilGysinAffinePerm k (b + 1) π_m))
                (weilGysinAffineProjRight k 1 b (b + 1) h1b) = h_rest_m ∧
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (h m.succ)
                  (weilGysinAffinePerm k (b + 1) π_m))
                (weilGysinAffineProjRight k 1 b (b + 1) h1b) = h_rest_m ∧
              CategoryTheory.IsPullback i_Cm_top g_m1
                (CategoryTheory.CategoryStruct.comp (h m.castSucc)
                  (weilGysinAffinePerm k (b + 1) π_m))
                (weilGysinAffineLeftAxis k 1 b (b + 1) h1b) ∧
              CategoryTheory.IsPullback i_Cm_top g_m2
                (CategoryTheory.CategoryStruct.comp (h m.succ)
                  (weilGysinAffinePerm k (b + 1) π_m))
                (weilGysinAffineLeftAxis k 1 b (b + 1) h1b))) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  obtain ⟨hP1_int, hP1_sm⟩ := weil_gysin_projLine_integral_and_smooth k
  obtain ⟨⟨hIso0, h0_str, hstr_0, h0_cl, hAxis_cl, hSec_cl⟩, hPart1b, hPart1c⟩ :=
    weil_gysin_affine_coord_block_and_perm_squares k
  have hIso_sU0 : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
      (s : Quiver.Hom S_k Y) (U : Y.Opens) (s_U : Quiver.Hom S_k U.toScheme)
      (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k 0)),
      WeilGysinIsEtaleOriginChart 0 p_Y s U s_U u →
      CategoryTheory.IsIso s_U := by
    intro Y p_Y s U s_U u hChart
    have : CategoryTheory.IsIso (weilGysinAffineOrigin k 0) := hIso0
    exact hChart.2.2.2.isIso_fst_of_isIso
  refine ⟨⟨⟨hP1_int, hP1_sm, hIso0, h0_str, hstr_0, h0_cl, hAxis_cl, hSec_cl⟩,
      hPart1b, hPart1c⟩,
    fun d X _ s hs U s_U u hChart =>
      weil_gysin_swapped_diagonal_product_origin_chart k d X s hs U s_U u hChart,
    ⟨hIso_sU0, ?_⟩, ?_⟩
  · 
    intro Y p_Y s U₁ U₂ s_U₁ s_U₂ u₁ u₂ hChart₁ hChart₂
    have : CategoryTheory.IsIso s_U₁ := hIso_sU0 p_Y s U₁ s_U₁ u₁ hChart₁
    have : CategoryTheory.IsIso s_U₂ := hIso_sU0 p_Y s U₂ s_U₂ u₂ hChart₂
    have hU_set : ∀ (U : Y.Opens) (s_U : Quiver.Hom S_k U.toScheme) [CategoryTheory.IsIso s_U],
        CategoryTheory.CategoryStruct.comp s_U U.ι = s →
        (U : Set ↥Y) = Set.range s.base := by
      intro U s_U _ hs_U
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U]
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        refine ⟨(CategoryTheory.inv s_U).base z, ?_⟩
        have hz : s_U.base ((CategoryTheory.inv s_U).base z) = z := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.IsIso.inv_hom_id]
          rfl
        rw [← hs_U, AlgebraicGeometry.Scheme.Hom.comp_apply, hz]
      · rintro ⟨pt, rfl⟩
        rw [← hs_U, AlgebraicGeometry.Scheme.Hom.comp_apply]
        exact ⟨s_U.base pt, rfl⟩
    have hU_eq : U₁ = U₂ :=
      TopologicalSpace.Opens.ext
        ((hU_set U₁ s_U₁ hChart₁.2.2.1).trans (hU_set U₂ s_U₂ hChart₂.2.2.1).symm)
    subst hU_eq
    have hs_eq : s_U₁ = s_U₂ := by
      apply (cancel_mono U₁.ι).mp
      exact hChart₁.2.2.1.trans hChart₂.2.2.1.symm
    have hu_eq : u₁ = u₂ := by
      calc
        u₁ = CategoryTheory.CategoryStruct.comp u₁
            (CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k 0)) :=
          (CategoryTheory.Category.comp_id u₁).symm
        _ = CategoryTheory.CategoryStruct.comp u₁
            (CategoryTheory.CategoryStruct.comp (weilGysinAffineStruct k 0)
              (weilGysinAffineOrigin k 0)) := by
          rw [hstr_0]
        _ = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp u₁ (weilGysinAffineStruct k 0))
            (weilGysinAffineOrigin k 0) :=
          (CategoryTheory.Category.assoc _ _ _).symm
        _ = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp u₂ (weilGysinAffineStruct k 0))
            (weilGysinAffineOrigin k 0) := by
          rw [hChart₁.2.1, hChart₂.2.1]
        _ = CategoryTheory.CategoryStruct.comp u₂
            (CategoryTheory.CategoryStruct.comp (weilGysinAffineStruct k 0)
              (weilGysinAffineOrigin k 0)) :=
          CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.CategoryStruct.comp u₂
            (CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k 0)) := by
          rw [hstr_0]
        _ = u₂ := CategoryTheory.Category.comp_id u₂
    refine ⟨U₁, le_rfl, le_rfl, s_U₁, hChart₁.2.2.1, ?_, ?_, ?_, ?_⟩
    · rw [Y.homOfLE_rfl, CategoryTheory.Category.comp_id]
    · rw [Y.homOfLE_rfl, CategoryTheory.Category.comp_id]
      exact hs_eq
    · rw [Y.homOfLE_rfl, CategoryTheory.Category.id_comp]
      exact hChart₁
    · rw [Y.homOfLE_rfl, CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]
      exact hu_eq
  · 
    intro b h1b Y p_Y _ s hs U₁ U₂ s_U₁ s_U₂ u₁ u₂ hChart₁ hChart₂
    let pt₀ : ↥S_k := default
    have hS_k_uniq : ∀ z : ↥S_k, z = pt₀ := fun z => Subsingleton.elim z pt₀
    have hs_mem₁ : s.base pt₀ ∈ U₁ := by
      rw [← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι U₁,
        ← hChart₁.2.2.1, AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact ⟨s_U₁.base pt₀, rfl⟩
    have hs_mem₂ : s.base pt₀ ∈ U₂ := by
      rw [← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι U₂,
        ← hChart₂.2.2.1, AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact ⟨s_U₂.base pt₀, rfl⟩
    have hs_mem₁₂ : s.base pt₀ ∈ (U₁ ⊓ U₂ : Y.Opens) := ⟨hs_mem₁, hs_mem₂⟩
    obtain ⟨W₀, hW₀, hs_W₀_mem, hle_W₀_set⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hs_mem₁₂
    have hle_W₀ : W₀ ≤ U₁ ⊓ U₂ := hle_W₀_set
    have hle₀₁ : W₀ ≤ U₁ := hle_W₀.trans inf_le_left
    have hle₀₂ : W₀ ≤ U₂ := hle_W₀.trans inf_le_right
    have hs_W₀_range : Set.range s.base ⊆ Set.range W₀.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      rw [hS_k_uniq z]
      exact hs_W₀_mem
    let s_W₀ : Quiver.Hom S_k W₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W₀.ι s hs_W₀_range
    have hs_W₀ : CategoryTheory.CategoryStruct.comp s_W₀ W₀.ι = s :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W₀.ι s hs_W₀_range
    have hs_W₀_1 : CategoryTheory.CategoryStruct.comp s_W₀ (Y.homOfLE hle₀₁) = s_U₁ := by
      apply (cancel_mono U₁.ι).mp
      rw [CategoryTheory.Category.assoc, Y.homOfLE_ι hle₀₁, hs_W₀, hChart₁.2.2.1]
    have hs_W₀_2 : CategoryTheory.CategoryStruct.comp s_W₀ (Y.homOfLE hle₀₂) = s_U₂ := by
      apply (cancel_mono U₂.ι).mp
      rw [CategoryTheory.Category.assoc, Y.homOfLE_ι hle₀₂, hs_W₀, hChart₂.2.2.1]
    let u₁_0 : Quiver.Hom W₀.toScheme (weilGysinAffineSpace k (b + 1)) :=
      CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₀₁) u₁
    let u₂_0 : Quiver.Hom W₀.toScheme (weilGysinAffineSpace k (b + 1)) :=
      CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₀₂) u₂
    have hu₁_0_et : AlgebraicGeometry.Etale u₁_0 := by
      have : AlgebraicGeometry.Etale u₁ := hChart₁.1
      dsimp [u₁_0]
      infer_instance
    have hu₂_0_et : AlgebraicGeometry.Etale u₂_0 := by
      have : AlgebraicGeometry.Etale u₂ := hChart₂.1
      dsimp [u₂_0]
      infer_instance
    have hu₁_0_str : CategoryTheory.CategoryStruct.comp u₁_0 (weilGysinAffineStruct k (b + 1)) =
        CategoryTheory.CategoryStruct.comp W₀.ι p_Y := by
      change (Y.homOfLE hle₀₁ ≫ u₁) ≫ weilGysinAffineStruct k (b + 1) = W₀.ι ≫ p_Y
      rw [CategoryTheory.Category.assoc, hChart₁.2.1, ← CategoryTheory.Category.assoc,
        Y.homOfLE_ι hle₀₁]
    have hu₂_0_str : CategoryTheory.CategoryStruct.comp u₂_0 (weilGysinAffineStruct k (b + 1)) =
        CategoryTheory.CategoryStruct.comp W₀.ι p_Y := by
      change (Y.homOfLE hle₀₂ ≫ u₂) ≫ weilGysinAffineStruct k (b + 1) = W₀.ι ≫ p_Y
      rw [CategoryTheory.Category.assoc, hChart₂.2.1, ← CategoryTheory.Category.assoc,
        Y.homOfLE_ι hle₀₂]
    have hs_u₁_0 : CategoryTheory.CategoryStruct.comp s_W₀ u₁_0 =
        weilGysinAffineOrigin k (b + 1) := by
      change s_W₀ ≫ (Y.homOfLE hle₀₁ ≫ u₁) = weilGysinAffineOrigin k (b + 1)
      rw [← CategoryTheory.Category.assoc, hs_W₀_1, hChart₁.2.2.2.w,
        CategoryTheory.Category.id_comp]
    have hs_u₂_0 : CategoryTheory.CategoryStruct.comp s_W₀ u₂_0 =
        weilGysinAffineOrigin k (b + 1) := by
      change s_W₀ ≫ (Y.homOfLE hle₀₂ ≫ u₂) = weilGysinAffineOrigin k (b + 1)
      rw [← CategoryTheory.Category.assoc, hs_W₀_2, hChart₂.2.2.2.w,
        CategoryTheory.Category.id_comp]
    obtain ⟨hBridge, hSlice⟩ := weil_gysin_affine_basicOpen_lift_and_curve_slice k
    obtain ⟨f_k, ev₀, hev_k, hExtr, hBasic⟩ :=
      hBridge b h1b p_Y s hs W₀ hW₀ s_W₀ hs_W₀
    obtain ⟨φ₁, hφ₁_k, hφ₁_ev, hφ₁_et, hφ₁_spec⟩ :=
      hExtr u₁_0 hu₁_0_et hu₁_0_str hs_u₁_0
    obtain ⟨φ₂, hφ₂_k, hφ₂_ev, hφ₂_et, hφ₂_spec⟩ :=
      hExtr u₂_0 hu₂_0_et hu₂_0_str hs_u₂_0
    obtain ⟨f_prod, N, x, hf_ne, hx0, hxN, hx_ev, hx_et, hx_step⟩ :=
      weil_gysin_pointed_kaehler_steinitz_away_etale_chain k (b + 1) (Nat.le_add_left 1 b) _
        f_k ev₀ φ₁ φ₂ hev_k hφ₁_k hφ₂_k hφ₁_ev hφ₂_ev hφ₁_et hφ₂_et
    obtain ⟨s_V₀, liftZ, hs_V₀, _, hLift_prop, hLift_end, hLift_step⟩ :=
      hBasic f_prod hf_ne
    let V₀ : Y.Opens := Y.basicOpen f_prod
    let hle_V₀ : V₀ ≤ W₀ := Y.basicOpen_le f_prod
    let h₀ : Fin (N + 1) → Quiver.Hom V₀.toScheme (weilGysinAffineSpace k (b + 1)) :=
      fun m => liftZ (x m)
    have hh₀_prop : ∀ m : Fin (N + 1),
        AlgebraicGeometry.Etale (h₀ m) ∧
        CategoryTheory.CategoryStruct.comp (h₀ m) (weilGysinAffineStruct k (b + 1)) =
          CategoryTheory.CategoryStruct.comp V₀.ι p_Y ∧
        CategoryTheory.CategoryStruct.comp s_V₀ (h₀ m) = weilGysinAffineOrigin k (b + 1) :=
      fun m => hLift_prop (x m) (hx_ev m) (fun S _ g hg => hx_et S g hg m)
    have hShrink := (weil_gysin_smooth_etale_origin_chart_and_fiber_shrink k).1
    choose W_m hle_m s_Wm hChart_Wm using fun m : Fin (N + 1) =>
      hShrink (b + 1) Y p_Y s hs V₀ s_V₀ hs_V₀ (h₀ m)
        (hh₀_prop m).1 (hh₀_prop m).2.1 (hh₀_prop m).2.2
    let W : Y.Opens := V₀ ⊓ Finset.univ.inf W_m
    have hle_WV₀ : W ≤ V₀ := inf_le_left
    have hle₁ : W ≤ U₁ := hle_WV₀.trans (hle_V₀.trans hle₀₁)
    have hle₂ : W ≤ U₂ := hle_WV₀.trans (hle_V₀.trans hle₀₂)
    have hle_Wm : ∀ m : Fin (N + 1), W ≤ W_m m :=
      fun m => inf_le_right.trans (Finset.inf_le (Finset.mem_univ m))
    have hs_V₀_mem : s.base pt₀ ∈ V₀ := by
      rw [← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι V₀,
        ← hs_V₀, AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact ⟨s_V₀.base pt₀, rfl⟩
    have hs_inf_mem : ∀ S : Finset (Fin (N + 1)), s.base pt₀ ∈ S.inf W_m := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        rw [Finset.inf_empty]
        trivial
      | @insert a S' _ ih =>
        rw [Finset.inf_insert]
        refine ⟨?_, ih⟩
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι (W_m a),
          ← (hChart_Wm a).2.2.1, AlgebraicGeometry.Scheme.Hom.comp_apply]
        exact ⟨(s_Wm a).base pt₀, rfl⟩
    have hs_W_mem : s.base pt₀ ∈ W := ⟨hs_V₀_mem, hs_inf_mem Finset.univ⟩
    have hs_W_range : Set.range s.base ⊆ Set.range W.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      rw [hS_k_uniq z]
      exact hs_W_mem
    let s_W : Quiver.Hom S_k W.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W.ι s hs_W_range
    have hs_W : CategoryTheory.CategoryStruct.comp s_W W.ι = s :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι s hs_W_range
    have hs_W₁ : CategoryTheory.CategoryStruct.comp s_W (Y.homOfLE hle₁) = s_U₁ := by
      apply (cancel_mono U₁.ι).mp
      rw [CategoryTheory.Category.assoc, Y.homOfLE_ι hle₁, hs_W, hChart₁.2.2.1]
    have hs_W₂ : CategoryTheory.CategoryStruct.comp s_W (Y.homOfLE hle₂) = s_U₂ := by
      apply (cancel_mono U₂.ι).mp
      rw [CategoryTheory.Category.assoc, Y.homOfLE_ι hle₂, hs_W, hChart₂.2.2.1]
    have hs_W_Wm : ∀ m : Fin (N + 1),
        CategoryTheory.CategoryStruct.comp s_W (Y.homOfLE (hle_Wm m)) = s_Wm m := by
      intro m
      apply (cancel_mono (W_m m).ι).mp
      rw [CategoryTheory.Category.assoc, Y.homOfLE_ι (hle_Wm m), hs_W, (hChart_Wm m).2.2.1]
    let h : Fin (N + 1) → Quiver.Hom W.toScheme (weilGysinAffineSpace k (b + 1)) :=
      fun m => CategoryTheory.CategoryStruct.comp (Y.homOfLE hle_WV₀) (h₀ m)
    have hh0 : h 0 = CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₁) u₁ := by
      change Y.homOfLE hle_WV₀ ≫ liftZ (x 0) = Y.homOfLE hle₁ ≫ u₁
      rw [hLift_end u₁_0 φ₁ (x 0) hφ₁_spec hφ₁_k hx0]
      change Y.homOfLE hle_WV₀ ≫ (Y.homOfLE hle_V₀ ≫ (Y.homOfLE hle₀₁ ≫ u₁)) =
        Y.homOfLE hle₁ ≫ u₁
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        Y.homOfLE_homOfLE, Y.homOfLE_homOfLE]
    have hhN : h (Fin.last N) = CategoryTheory.CategoryStruct.comp (Y.homOfLE hle₂) u₂ := by
      change Y.homOfLE hle_WV₀ ≫ liftZ (x (Fin.last N)) = Y.homOfLE hle₂ ≫ u₂
      rw [hLift_end u₂_0 φ₂ (x (Fin.last N)) hφ₂_spec hφ₂_k hxN]
      change Y.homOfLE hle_WV₀ ≫ (Y.homOfLE hle_V₀ ≫ (Y.homOfLE hle₀₂ ≫ u₂)) =
        Y.homOfLE hle₂ ≫ u₂
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        Y.homOfLE_homOfLE, Y.homOfLE_homOfLE]
    have hh_chart : ∀ m : Fin (N + 1),
        WeilGysinIsEtaleOriginChart (b + 1) p_Y s W s_W (h m) := by
      intro m
      have hh_eq : h m = CategoryTheory.CategoryStruct.comp (Y.homOfLE (hle_Wm m))
          (CategoryTheory.CategoryStruct.comp (Y.homOfLE (hle_m m)) (h₀ m)) := by
        change Y.homOfLE hle_WV₀ ≫ h₀ m = Y.homOfLE (hle_Wm m) ≫ (Y.homOfLE (hle_m m) ≫ h₀ m)
        rw [← CategoryTheory.Category.assoc, Y.homOfLE_homOfLE]
      have h_et : AlgebraicGeometry.Etale (h m) := by
        have : AlgebraicGeometry.Etale (h₀ m) := (hh₀_prop m).1
        dsimp [h]
        infer_instance
      have h_str : CategoryTheory.CategoryStruct.comp (h m) (weilGysinAffineStruct k (b + 1)) =
          CategoryTheory.CategoryStruct.comp W.ι p_Y := by
        change (Y.homOfLE hle_WV₀ ≫ h₀ m) ≫ weilGysinAffineStruct k (b + 1) = W.ι ≫ p_Y
        rw [CategoryTheory.Category.assoc, (hh₀_prop m).2.1, ← CategoryTheory.Category.assoc,
          Y.homOfLE_ι hle_WV₀]
      have hpb_le : CategoryTheory.IsPullback s_W (CategoryTheory.CategoryStruct.id S_k)
          (Y.homOfLE (hle_Wm m)) (s_Wm m) := by
        apply AlgebraicGeometry.IsOpenImmersion.isPullback s_W
          (CategoryTheory.CategoryStruct.id S_k) (Y.homOfLE (hle_Wm m)) (s_Wm m)
        · exact (CategoryTheory.Category.id_comp (s_Wm m)).trans (hs_W_Wm m).symm
        · ext pt
          simp only [TopologicalSpace.Opens.map_obj, SetLike.mem_coe,
            AlgebraicGeometry.Scheme.Hom.opensRange]
          refine ⟨fun _ => ⟨pt, rfl⟩, fun _ => ?_⟩
          rw [← hs_W_Wm m]
          exact ⟨s_W.base pt, rfl⟩
      have hpb_hm : CategoryTheory.IsPullback s_W (CategoryTheory.CategoryStruct.id S_k)
          (h m) (weilGysinAffineOrigin k (b + 1)) := by
        have hpasted := CategoryTheory.IsPullback.paste_vert hpb_le (hChart_Wm m).2.2.2
        rw [CategoryTheory.Category.id_comp, ← hh_eq] at hpasted
        exact hpasted
      exact ⟨h_et, h_str, hs_W, hpb_hm⟩
    refine ⟨W, hle₁, hle₂, s_W, N, h, hs_W, hs_W₁, hs_W₂, hh0, hhN, hh_chart, ?_⟩
    intro m
    obtain ⟨i₀, hi₀⟩ := hx_step m
    let π_m : Equiv.Perm (Fin (b + 1)) := Equiv.swap (0 : Fin (b + 1)) i₀
    have hstep_h₀ : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (h₀ m.castSucc)
          (weilGysinAffinePerm k (b + 1) π_m))
        (weilGysinAffineProjRight k 1 b (b + 1) h1b) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (h₀ m.succ)
          (weilGysinAffinePerm k (b + 1) π_m))
        (weilGysinAffineProjRight k 1 b (b + 1) h1b) :=
      hLift_step (x m.castSucc) (x m.succ) i₀ hi₀
    have hstep_h : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (h m.castSucc)
          (weilGysinAffinePerm k (b + 1) π_m))
        (weilGysinAffineProjRight k 1 b (b + 1) h1b) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (h m.succ)
          (weilGysinAffinePerm k (b + 1) π_m))
        (weilGysinAffineProjRight k 1 b (b + 1) h1b) := by
      change ((Y.homOfLE hle_WV₀ ≫ h₀ m.castSucc) ≫ weilGysinAffinePerm k (b + 1) π_m) ≫
          weilGysinAffineProjRight k 1 b (b + 1) h1b =
        ((Y.homOfLE hle_WV₀ ≫ h₀ m.succ) ≫ weilGysinAffinePerm k (b + 1) π_m) ≫
          weilGysinAffineProjRight k 1 b (b + 1) h1b
      rw [CategoryTheory.Category.assoc (Y.homOfLE hle_WV₀),
        CategoryTheory.Category.assoc (Y.homOfLE hle_WV₀),
        hstep_h₀,
        ← CategoryTheory.Category.assoc (Y.homOfLE hle_WV₀),
        ← CategoryTheory.Category.assoc (Y.homOfLE hle_WV₀)]
    obtain ⟨C_m, p_Cm, hSep_Cm, s_Cm, s_Cm_top, i_Cm_top, h_rest_m, g_m1, g_m2, hCm_props⟩ :=
      hSlice b h1b p_Y s hs W s_W hs_W (h m.castSucc) (h m.succ) π_m
        (hh_chart m.castSucc) (hh_chart m.succ) hstep_h
    exact ⟨π_m, C_m, p_Cm, hSep_Cm, s_Cm, s_Cm_top, i_Cm_top, h_rest_m, g_m1, g_m2, hCm_props⟩

theorem weil_gysin_affine_origin_thom_tower (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k)) :
    ∃ τ : ∀ (c r : ℕ), WeilGysinSupportClass
        (AlgebraicGeometry.Spec (CommRingCat.of k))
        (weilGysinAffineSpace k c) (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c),
      WeilGysinIsAffineOriginThomTower k ℓ τ :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hs_id_cl : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.CategoryStruct.id S_k) :=
    inferInstance
  obtain ⟨⟨⟨hP₁_int, hP₁_sm, hIso0, _, _, h0_cl, hAxis_cl, hSec_cl⟩,
      ⟨hAxis0_id, hProj01_id, hBlock_pb, hStep_pb⟩,
      ⟨hPerm_one, hPerm_mul, hPerm_orig, hPerm_adj⟩⟩,
      hSwapDiag, ⟨hChart0_iso, hChart0_eq⟩, hSteinitz⟩ :=
    weil_gysin_affine_coord_geometry_and_steinitz_chain k
  obtain ⟨τ_iso,
      ⟨hCont_fn, hIso_pb, hIso_fg, hIso_ab⟩,
      ⟨hPb_ex, hPb_uniq, hPb_id, hPb_comp, hExc_ex⟩,
      ⟨hFg_ex, hFg_pb, hTorsPb_ex, hTorsPb_id, hTorsPb_comp⟩,
      ⟨hGys_ex, hGys_unitL, hGys_unitR, hGys_assoc, hGys_pb⟩,
      ⟨hAb_equiv, hAb_pb_iff, hAb_pb_trans, hAb_gys_trans, hAb_fg_trans⟩⟩ :=
    weil_gysin_support_ext_and_ab_comparison_calculus.{u} ℓ
  obtain ⟨hEvenProj, hSwap2⟩ := weil_gysin_even_projection_and_swap_symmetry.{u} ℓ
  
  let P₁ := weilProjectiveSpaceOver k 1
  haveI : AlgebraicGeometry.IsIntegral P₁.left := hP₁_int
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁.hom := hP₁_sm
  have hProjP₁ : IsProjectiveOverField k P₁ := by
    refine ⟨1, CategoryTheory.CategoryStruct.id P₁, ?_⟩
    change AlgebraicGeometry.IsClosedImmersion (CategoryTheory.CategoryStruct.id P₁.left)
    infer_instance
  have hP1Gm := weil_etale_smooth_proj_curve_gm_cohomology_and_divisor_iso k P₁ hProjP₁ ℓ
  obtain ⟨⟨e₀, he₀_trans, he₀_unit⟩, ⟨τ₁_ab, hτ₁_ab_norm, hτ₁_ab_trans, hτ₁_ab_inv⟩⟩ :=
    weil_gysin_dim_zero_and_a1_kummer_origin_tower k ℓ hℓ hP1Gm
  
  have hSuppExt : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (a₁ a₂ : WeilGysinSupportClass Z Y i m q), a₁.val = a₂.val → a₁ = a₂ := by
    rintro Z Y i m q ⟨_, v₁⟩ ⟨_, v₂⟩ hv
    subst hv
    rfl
  have hAbSuppExt : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (a₁ a₂ : WeilGysinAbSupportClass Z Y i m q), a₁.val = a₂.val → a₁ = a₂ := by
    rintro Z Y i m q ⟨_, v₁⟩ ⟨_, v₂⟩ hv
    subst hv
