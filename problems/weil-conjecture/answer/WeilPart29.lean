                have hne2 : idx ≠ v_m := fun h => h2 (congrArg Fin.val h)
                rw [Equiv.swap_apply_of_ne_of_ne hne1 hne2]
                by_cases hlt : idx.1 < m + 2
                · rw [hAxis_X_lt hc_split idx hlt, MvPolynomial.rename_X]
                  have hneL1 : (⟨idx.1, hlt⟩ : Fin (m + 2)) ≠ u_L :=
                    fun h => h1 (congrArg Fin.val h)
                  have hneL2 : (⟨idx.1, hlt⟩ : Fin (m + 2)) ≠ v_L :=
                    fun h => h2 (congrArg Fin.val h)
                  rw [Equiv.swap_apply_of_ne_of_ne hneL1 hneL2]
                · rw [hAxis_X_ge hc_split idx hlt, map_zero]
        have : CategoryTheory.IsIso (weilGysinAffinePerm k (m + 2) s_L) := hPerm_iso (m + 2) s_L
        have : CategoryTheory.IsIso (weilGysinAffinePerm k c s_m) := hPerm_iso c s_m
        exact CategoryTheory.IsPullback.of_vert_isIso ⟨hcomm_out⟩
      · change CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (perm_hom c s_m)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (projRight_hom (m + 2) (c - (m + 2)) c hc_split))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (projRight_hom (m + 2) (c - (m + 2)) c hc_split))
        rw [hSpec_comp]
        congr 2
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [projRight_hom, perm_hom]
        · intro j
          dsimp only [RingHom.comp_apply, projRight_hom, perm_hom,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
          rw [MvPolynomial.rename_X, MvPolynomial.rename_X, hs_m_def]
          let idx : Fin c := Fin.cast hc_split (Fin.natAdd (m + 2) j)
          have hne1 : idx ≠ u_m := by
            intro h
            have := congrArg Fin.val h
            dsimp [idx, u_m] at this
            omega
          have hne2 : idx ≠ v_m := by
            intro h
            have := congrArg Fin.val h
            dsimp [idx, v_m] at this
            omega
          change MvPolynomial.X (Equiv.swap u_m v_m idx) = MvPolynomial.X idx
          rw [Equiv.swap_apply_of_ne_of_ne hne1 hne2]
      · have hcomm_in : CategoryTheory.CategoryStruct.comp
            (weilGysinAffineLeftAxis k m 2 (m + 2) rfl)
            (weilGysinAffinePerm k (m + 2) s_L) =
          weilGysinAffineLeftAxis k m 2 (m + 2) rfl := by
          change CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (axis_hom m 2 (m + 2) rfl)))
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (perm_hom (m + 2) s_L))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (axis_hom m 2 (m + 2) rfl))
          rw [hSpec_comp]
          congr 2
          apply MvPolynomial.ringHom_ext
          · intro r
            simp [perm_hom, hAxis_C rfl]
          · intro idx
            dsimp only [RingHom.comp_apply, perm_hom, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
            rw [MvPolynomial.rename_X, hs_L_def]
            by_cases hlt : idx.1 < m
            · have hne1 : idx ≠ u_L := by
                intro h; have := congrArg Fin.val h; dsimp [u_L] at this; omega
              have hne2 : idx ≠ v_L := by
                intro h; have := congrArg Fin.val h; dsimp [v_L] at this; omega
              rw [Equiv.swap_apply_of_ne_of_ne hne1 hne2, hAxis_X_lt rfl idx hlt]
            · rw [hAxis_X_ge rfl idx hlt]
              have hnot_swap : ¬ (Equiv.swap u_L v_L idx).1 < m := by
                by_cases h1 : idx.1 = m
                · have hidx : idx = u_L := Fin.ext h1
                  rw [hidx, Equiv.swap_apply_left]
                  dsimp [v_L]; omega
                · have h2 : idx.1 = m + 1 := by omega
                  have hidx : idx = v_L := Fin.ext h2
                  rw [hidx, Equiv.swap_apply_right]
                  dsimp [u_L]; omega
              exact hAxis_X_ge rfl _ hnot_swap
        have : CategoryTheory.IsIso (weilGysinAffinePerm k (m + 2) s_L) := hPerm_iso (m + 2) s_L
        exact CategoryTheory.IsPullback.of_vert_isIso
          ⟨hcomm_in.trans (CategoryTheory.Category.id_comp _).symm⟩
      · change CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (perm_hom (m + 2) s_L)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (projRight_hom m 2 (m + 2) rfl))) =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (projRight_hom m 2 (m + 2) rfl)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (perm_hom 2 (Equiv.swap (0 : Fin 2) (1 : Fin 2)))))
        rw [hSpec_comp, hSpec_comp]
        congr 2
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [projRight_hom, perm_hom]
        · intro j
          dsimp only [RingHom.comp_apply, projRight_hom, perm_hom,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
          rw [MvPolynomial.rename_X, MvPolynomial.rename_X,
            MvPolynomial.rename_X, MvPolynomial.rename_X, hs_L_def]
          rcases j with ⟨_ | ⟨_ | j_bad⟩, hj⟩
          · have hj0 : (⟨0, hj⟩ : Fin 2) = 0 := rfl
            rw [hj0, Equiv.swap_apply_left]
            have hnat0 : Fin.cast (rfl : m + 2 = m + 2) (Fin.natAdd m (0 : Fin 2)) = u_L := by
              ext; dsimp [u_L]
            have hnat1 : Fin.cast (rfl : m + 2 = m + 2) (Fin.natAdd m (1 : Fin 2)) = v_L := by
              ext; dsimp [v_L]
            rw [hnat0, hnat1, Equiv.swap_apply_left]
          · have hj1 : (⟨1, hj⟩ : Fin 2) = 1 := rfl
            rw [hj1, Equiv.swap_apply_right]
            have hnat1 : Fin.cast (rfl : m + 2 = m + 2) (Fin.natAdd m (1 : Fin 2)) = v_L := by
              ext; dsimp [v_L]
            have hnat0 : Fin.cast (rfl : m + 2 = m + 2) (Fin.natAdd m (0 : Fin 2)) = u_L := by
              ext; dsimp [u_L]
            rw [hnat1, hnat0, Equiv.swap_apply_right]
          · omega

theorem weil_gysin_swapped_diagonal_product_origin_chart (k : Type u) [Field k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsSeparated X.hom]
    (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) X.left)
    (hs : CategoryTheory.CategoryStruct.comp s X.hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U : X.left.Opens)
    (s_U : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U.toScheme)
    (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k d))
    (hChart : WeilGysinIsEtaleOriginChart d X.hom s U s_U u) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P := CategoryTheory.Limits.pullback X.hom X.hom
    let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
    let p₂ := CategoryTheory.Limits.pullback.snd X.hom X.hom
    let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
    ∃ (ι₂ : Quiver.Hom X.left P)
      (V_UU : P.Opens)
      (s_V : Quiver.Hom S_k V_UU.toScheme)
      (ι₂_U : Quiver.Hom U.toScheme V_UU.toScheme)
      (p₁_V : Quiver.Hom V_UU.toScheme U.toScheme)
      (Ψ_swap : Quiver.Hom V_UU.toScheme (weilGysinAffineSpace k (2 * d))),
      AlgebraicGeometry.IsSeparated (CategoryTheory.CategoryStruct.comp p₁ X.hom) ∧
      AlgebraicGeometry.IsClosedImmersion ι₂ ∧
      AlgebraicGeometry.IsClosedImmersion ι₂_U ∧
      CategoryTheory.CategoryStruct.comp s ι₂ = CategoryTheory.CategoryStruct.comp s Δ ∧
      CategoryTheory.CategoryStruct.comp ι₂ p₂ = CategoryTheory.CategoryStruct.id X.left ∧
      CategoryTheory.IsPullback ι₂ X.hom p₁ s ∧
      WeilGysinIsEtaleOriginChart (2 * d)
        (CategoryTheory.CategoryStruct.comp p₁ X.hom)
        (CategoryTheory.CategoryStruct.comp s Δ) V_UU s_V Ψ_swap ∧
      CategoryTheory.CategoryStruct.comp s_U ι₂_U = s_V ∧
      CategoryTheory.IsPullback ι₂_U U.ι V_UU.ι ι₂ ∧
      CategoryTheory.IsPullback ι₂_U
        (CategoryTheory.CategoryStruct.comp U.ι X.hom) p₁_V s_U ∧
      CategoryTheory.CategoryStruct.comp p₁_V U.ι =
        CategoryTheory.CategoryStruct.comp V_UU.ι p₁ ∧
      CategoryTheory.IsPullback ι₂_U u Ψ_swap
        (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
      CategoryTheory.CategoryStruct.comp Ψ_swap
        (weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) =
        CategoryTheory.CategoryStruct.comp p₁_V u :=
by
  intro S_k P p₁ p₂ Δ
  rcases hChart with ⟨hu_et, hu_str, hs_U, hpb_u⟩
  have : AlgebraicGeometry.Etale u := hu_et
  have hSep_P : AlgebraicGeometry.IsSeparated (p₁ ≫ X.hom) := inferInstance
  have hι₂_cond : (X.hom ≫ s) ≫ X.hom = 𝟙 X.left ≫ X.hom := by
    rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
  let ι₂ : X.left ⟶ P := Limits.pullback.lift (X.hom ≫ s) (𝟙 X.left) hι₂_cond
  have hι₂_p₁ : ι₂ ≫ p₁ = X.hom ≫ s := Limits.pullback.lift_fst _ _ _
  have hι₂_p₂ : ι₂ ≫ p₂ = 𝟙 X.left := Limits.pullback.lift_snd _ _ _
  have hι₂_cl : AlgebraicGeometry.IsClosedImmersion ι₂ := by
    have : AlgebraicGeometry.IsSeparated p₂ := inferInstance
    have : AlgebraicGeometry.IsClosedImmersion (ι₂ ≫ p₂) := by
      rw [hι₂_p₂]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp ι₂ p₂
  have hs_ι₂ : s ≫ ι₂ = s ≫ Δ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hι₂_p₁, ← Category.assoc, hs, Category.id_comp,
        Category.assoc, Limits.pullback.diagonal_fst X.hom, Category.comp_id]
    · rw [Category.assoc, hι₂_p₂, Category.assoc, Limits.pullback.diagonal_snd X.hom]
  have hpb_ι₂ : CategoryTheory.IsPullback ι₂ X.hom p₁ s := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hι₂_p₁
        (fun cone => cone.fst ≫ p₂)
        (fun cone => ?_) (fun cone => ?_) (fun cone m hm₁ _ => ?_))
    · have h2 : (cone.fst ≫ p₂) ≫ X.hom = cone.snd := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc,
          cone.condition, Category.assoc, hs, Category.comp_id]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hι₂_p₁, ← Category.assoc _ X.hom s, h2, cone.condition]
      · rw [Category.assoc, hι₂_p₂, Category.comp_id]
    · rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc,
        cone.condition, Category.assoc, hs, Category.comp_id]
    · calc
        m = m ≫ 𝟙 X.left := (Category.comp_id m).symm
        _ = m ≫ (ι₂ ≫ p₂) := by rw [hι₂_p₂]
        _ = (m ≫ ι₂) ≫ p₂ := (Category.assoc m ι₂ p₂).symm
        _ = cone.fst ≫ p₂ := by rw [hm₁]
  let V_UU : P.Opens :=
    (TopologicalSpace.Opens.map p₁.base).obj U ⊓ (TopologicalSpace.Opens.map p₂.base).obj U
  have hV_mem : ∀ z : ↥V_UU.toScheme, V_UU.ι.base z ∈ V_UU := by
    intro z
    rw [← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι V_UU]
    exact ⟨z, rfl⟩
  have hp₁_range : Set.range (V_UU.ι ≫ p₁).base ⊆ Set.range U.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    exact (hV_mem z).1
  have hp₂_range : Set.range (V_UU.ι ≫ p₂).base ⊆ Set.range U.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    exact (hV_mem z).2
  let p₁_V : V_UU.toScheme ⟶ U.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U.ι (V_UU.ι ≫ p₁) hp₁_range
  let p₂_V : V_UU.toScheme ⟶ U.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U.ι (V_UU.ι ≫ p₂) hp₂_range
  have hp₁_V : p₁_V ≫ U.ι = V_UU.ι ≫ p₁ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι (V_UU.ι ≫ p₁) hp₁_range
  have hp₂_V : p₂_V ≫ U.ι = V_UU.ι ≫ p₂ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι (V_UU.ι ≫ p₂) hp₂_range
  have hV_hom_ext : ∀ {T : AlgebraicGeometry.Scheme.{u}} (g₁ g₂ : T ⟶ V_UU.toScheme),
      g₁ ≫ p₁_V = g₂ ≫ p₁_V → g₁ ≫ p₂_V = g₂ ≫ p₂_V → g₁ = g₂ := by
    intro T g₁ g₂ h₁ h₂
    apply (cancel_mono V_UU.ι).mp
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, ← hp₁_V, ← Category.assoc, h₁, Category.assoc]
    · rw [Category.assoc, Category.assoc, ← hp₂_V, ← Category.assoc, h₂, Category.assoc]
  let f_U : U.toScheme ⟶ S_k := U.ι ≫ X.hom
  have hV_comm : p₂_V ≫ f_U = p₁_V ≫ f_U := by
    dsimp [f_U]
    rw [← Category.assoc, hp₂_V, Category.assoc, ← Limits.pullback.condition,
      ← Category.assoc, ← hp₁_V, Category.assoc]
  have hpb_V_swap : CategoryTheory.IsPullback p₂_V p₁_V f_U f_U := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hV_comm
        (fun cone =>
          let h_mp : (cone.snd ≫ U.ι) ≫ X.hom = (cone.fst ≫ U.ι) ≫ X.hom := by
            rw [Category.assoc, Category.assoc]
            exact cone.condition.symm
          let m_P : cone.pt ⟶ P :=
            CategoryTheory.Limits.pullback.lift (cone.snd ≫ U.ι) (cone.fst ≫ U.ι) h_mp
          have hm_range : Set.range m_P.base ⊆ Set.range V_UU.ι.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨t, rfl⟩
            refine ⟨?_, ?_⟩
            · change p₁.base (m_P.base t) ∈ U
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                CategoryTheory.Limits.pullback.lift_fst,
                AlgebraicGeometry.Scheme.Hom.comp_apply,
                ← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι U]
              exact ⟨cone.snd.base t, rfl⟩
            · change p₂.base (m_P.base t) ∈ U
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                CategoryTheory.Limits.pullback.lift_snd,
                AlgebraicGeometry.Scheme.Hom.comp_apply,
                ← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι U]
              exact ⟨cone.fst.base t, rfl⟩
          AlgebraicGeometry.IsOpenImmersion.lift V_UU.ι m_P hm_range)
        (fun cone => ?_) (fun cone => ?_) (fun cone m hm₁ hm₂ => ?_))
    · apply (cancel_mono U.ι).mp
      rw [Category.assoc, hp₂_V, ← Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.lift_fac,
        CategoryTheory.Limits.pullback.lift_snd]
    · apply (cancel_mono U.ι).mp
      rw [Category.assoc, hp₁_V, ← Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.lift_fac,
        CategoryTheory.Limits.pullback.lift_fst]
    · apply hV_hom_ext
      · rw [hm₂]
        symm
        apply (cancel_mono U.ι).mp
        rw [Category.assoc, hp₁_V, ← Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.lift_fac,
          CategoryTheory.Limits.pullback.lift_fst]
      · rw [hm₁]
        symm
        apply (cancel_mono U.ι).mp
        rw [Category.assoc, hp₂_V, ← Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.lift_fac,
          CategoryTheory.Limits.pullback.lift_snd]
  let e_V : V_UU.toScheme ≅ CategoryTheory.Limits.pullback f_U f_U :=
    CategoryTheory.Limits.IsLimit.conePointUniqueUpToIso
      hpb_V_swap.isLimit (CategoryTheory.Limits.pullback.isLimit f_U f_U)
  have he_V_fst : e_V.hom ≫ CategoryTheory.Limits.pullback.fst f_U f_U = p₂_V :=
    CategoryTheory.Limits.IsLimit.conePointUniqueUpToIso_hom_comp
      hpb_V_swap.isLimit (CategoryTheory.Limits.pullback.isLimit f_U f_U)
      CategoryTheory.Limits.WalkingCospan.left
  have he_V_snd : e_V.hom ≫ CategoryTheory.Limits.pullback.snd f_U f_U = p₁_V :=
    CategoryTheory.Limits.IsLimit.conePointUniqueUpToIso_hom_comp
      hpb_V_swap.isLimit (CategoryTheory.Limits.pullback.isLimit f_U f_U)
      CategoryTheory.Limits.WalkingCospan.right
  have hι₂_mem : ∀ x : ↥X.left, ι₂.base x ∈ V_UU ↔ x ∈ U := by
    intro x
    have hp₁_x : p₁.base (ι₂.base x) ∈ U := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hι₂_p₁, ← hs_U,
        ← Category.assoc, AlgebraicGeometry.Scheme.Hom.comp_apply,
        ← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι U]
      exact ⟨(X.hom ≫ s_U).base x, rfl⟩
    have hp₂_x : p₂.base (ι₂.base x) = x := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hι₂_p₂]
      rfl
    change p₁.base (ι₂.base x) ∈ U ∧ p₂.base (ι₂.base x) ∈ U ↔ x ∈ U
    rw [hp₂_x]
    exact ⟨fun h => h.2, fun hx => ⟨hp₁_x, hx⟩⟩
  have hι₂_U_range : Set.range (U.ι ≫ ι₂).base ⊆ Set.range V_UU.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply, SetLike.mem_coe, hι₂_mem,
      ← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι U]
    exact ⟨y, rfl⟩
  let ι₂_U : U.toScheme ⟶ V_UU.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift V_UU.ι (U.ι ≫ ι₂) hι₂_U_range
  have hι₂_U_ι : ι₂_U ≫ V_UU.ι = U.ι ≫ ι₂ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac V_UU.ι (U.ι ≫ ι₂) hι₂_U_range
  have hpb_ι₂_U : CategoryTheory.IsPullback ι₂_U U.ι V_UU.ι ι₂ := by
    apply AlgebraicGeometry.IsOpenImmersion.isPullback ι₂_U U.ι V_UU.ι ι₂ hι₂_U_ι.symm
    ext x
    simp only [SetLike.mem_coe, AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    exact hι₂_mem x
  have hι₂_U_cl : AlgebraicGeometry.IsClosedImmersion ι₂_U :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_ι₂_U.flip hι₂_cl
  let s_V : S_k ⟶ V_UU.toScheme := s_U ≫ ι₂_U
  have hs_V_ι : s_V ≫ V_UU.ι = s ≫ Δ := by
    dsimp [s_V]
    rw [Category.assoc, hι₂_U_ι, ← Category.assoc, hs_U, hs_ι₂]
  have hι₂_U_p₁ : ι₂_U ≫ p₁_V = f_U ≫ s_U := by
    apply (cancel_mono U.ι).mp
    dsimp [f_U]
    rw [Category.assoc, hp₁_V, ← Category.assoc, hι₂_U_ι, Category.assoc, hι₂_p₁,
      Category.assoc, hs_U, Category.assoc]
  have hι₂_U_p₂ : ι₂_U ≫ p₂_V = 𝟙 U.toScheme := by
    apply (cancel_mono U.ι).mp
    rw [Category.assoc, hp₂_V, ← Category.assoc, hι₂_U_ι, Category.assoc, hι₂_p₂,
      Category.comp_id, Category.id_comp]
  have hpb_p₁_V : CategoryTheory.IsPullback ι₂_U f_U p₁_V s_U := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hι₂_U_p₁
        (fun cone => cone.fst ≫ p₂_V)
        (fun cone => ?_) (fun cone => ?_) (fun cone m hm₁ _ => ?_))
    · have h2 : (cone.fst ≫ p₂_V) ≫ f_U = cone.snd := by
        rw [Category.assoc, hV_comm, ← Category.assoc, cone.condition]
        dsimp [f_U]
        rw [Category.assoc, ← Category.assoc s_U U.ι X.hom, hs_U, hs, Category.comp_id]
      apply hV_hom_ext
      · rw [Category.assoc, hι₂_U_p₁, ← Category.assoc _ f_U s_U, h2, cone.condition]
      · rw [Category.assoc, hι₂_U_p₂, Category.comp_id]
    · rw [Category.assoc, hV_comm, ← Category.assoc, cone.condition]
      dsimp [f_U]
      rw [Category.assoc, ← Category.assoc s_U U.ι X.hom, hs_U, hs, Category.comp_id]
    · calc
        m = m ≫ 𝟙 U.toScheme := (Category.comp_id m).symm
        _ = m ≫ (ι₂_U ≫ p₂_V) := by rw [hι₂_U_p₂]
        _ = (m ≫ ι₂_U) ≫ p₂_V := (Category.assoc m ι₂_U p₂_V).symm
        _ = cone.fst ≫ p₂_V := by rw [hm₁]
  let hab : d + d = 2 * d := (Nat.two_mul d).symm
  let P_d := MvPolynomial (Fin d) k
  let P_2d := MvPolynomial (Fin (2 * d)) k
  let struct_d := weilGysinAffineStruct k d
  let projLeft := weilGysinAffineProjLeft k d d (2 * d) hab
  let projRight := weilGysinAffineProjRight k d d (2 * d) hab
  let leftAxis := weilGysinAffineLeftAxis k d d (2 * d) hab
  let σ_dd : Fin d ⊕ Fin d ≃ Fin (2 * d) := finSumFinEquiv.trans (finCongr hab)
  let e_alg : TensorProduct k P_d P_d ≃ₐ[k] P_2d :=
    (MvPolynomial.tensorEquivSum k (Fin d) (Fin d) k).trans (MvPolynomial.renameEquiv k σ_dd)
  let e_spec : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k P_d P_d)) ≅
      weilGysinAffineSpace k (2 * d) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom)
      hom_inv_id := by
        dsimp only [weilGysinAffineSpace]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomp : e_alg.symm.toRingHom.comp e_alg.toRingHom =
            RingHom.id (TensorProduct k P_d P_d) :=
          RingHom.ext e_alg.symm_apply_apply
        rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        dsimp only [weilGysinAffineSpace]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomp : e_alg.toRingHom.comp e_alg.symm.toRingHom = RingHom.id P_2d :=
          RingHom.ext e_alg.apply_symm_apply
        rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  let E_dd : CategoryTheory.Limits.pullback struct_d struct_d ≅
      weilGysinAffineSpace k (2 * d) :=
    AlgebraicGeometry.pullbackSpecIso k P_d P_d ≪≫ e_spec
  have hE_fst : E_dd.hom ≫ projLeft = CategoryTheory.Limits.pullback.fst struct_d struct_d := by
    change ((AlgebraicGeometry.pullbackSpecIso k P_d P_d).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (MvPolynomial.rename (fun i : Fin d => Fin.cast hab (Fin.castAdd d i))).toRingHom) =
      CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k P_d)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k P_d)))
    rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hring : e_alg.symm.toRingHom.comp
        (MvPolynomial.rename (fun i : Fin d => Fin.cast hab (Fin.castAdd d i))).toRingHom =
        Algebra.TensorProduct.includeLeftRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change e_alg.symm ((MvPolynomial.rename
            (fun i : Fin d => Fin.cast hab (Fin.castAdd d i))) (MvPolynomial.C c)) =
          Algebra.TensorProduct.includeLeftRingHom (MvPolynomial.C c)
        apply e_alg.injective
        rw [AlgEquiv.apply_symm_apply, MvPolynomial.rename_C]
        have hc : Algebra.TensorProduct.includeLeftRingHom (MvPolynomial.C c : P_d) =
            algebraMap k (TensorProduct k P_d P_d) c := rfl
        rw [hc, e_alg.commutes]
        rfl
      · intro i
        change e_alg.symm ((MvPolynomial.rename
            (fun i : Fin d => Fin.cast hab (Fin.castAdd d i))) (MvPolynomial.X i)) =
          MvPolynomial.X i ⊗ₜ[k] (1 : P_d)
        apply e_alg.injective
        rw [AlgEquiv.apply_symm_apply, MvPolynomial.rename_X]
        change (MvPolynomial.X (Fin.cast hab (Fin.castAdd d i)) : P_2d) =
          (MvPolynomial.renameEquiv k σ_dd)
            ((MvPolynomial.tensorEquivSum k (Fin d) (Fin d) k) (MvPolynomial.X i ⊗ₜ[k] (1 : P_d)))
        rw [MvPolynomial.tensorEquivSum_X_tmul_one,
          MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
        congr 1
    rw [hring]
    exact AlgebraicGeometry.pullbackSpecIso_hom_fst k P_d P_d
  have hE_snd : E_dd.hom ≫ projRight = CategoryTheory.Limits.pullback.snd struct_d struct_d := by
    change ((AlgebraicGeometry.pullbackSpecIso k P_d P_d).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (MvPolynomial.rename (fun j : Fin d => Fin.cast hab (Fin.natAdd d j))).toRingHom) =
      CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k P_d)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k P_d)))
    rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hring : e_alg.symm.toRingHom.comp
        (MvPolynomial.rename (fun j : Fin d => Fin.cast hab (Fin.natAdd d j))).toRingHom =
        (Algebra.TensorProduct.includeRight : P_d →ₐ[k] TensorProduct k P_d P_d).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change e_alg.symm ((MvPolynomial.rename
            (fun j : Fin d => Fin.cast hab (Fin.natAdd d j))) (MvPolynomial.C c)) =
          (Algebra.TensorProduct.includeRight : P_d →ₐ[k] TensorProduct k P_d P_d)
            (algebraMap k P_d c)
        apply e_alg.injective
        rw [AlgEquiv.apply_symm_apply, MvPolynomial.rename_C, AlgHom.commutes, e_alg.commutes]
        rfl
      · intro j
        change e_alg.symm ((MvPolynomial.rename
            (fun j : Fin d => Fin.cast hab (Fin.natAdd d j))) (MvPolynomial.X j)) =
          (1 : P_d) ⊗ₜ[k] MvPolynomial.X j
        apply e_alg.injective
        rw [AlgEquiv.apply_symm_apply, MvPolynomial.rename_X]
        change (MvPolynomial.X (Fin.cast hab (Fin.natAdd d j)) : P_2d) =
          (MvPolynomial.renameEquiv k σ_dd)
            ((MvPolynomial.tensorEquivSum k (Fin d) (Fin d) k) ((1 : P_d) ⊗ₜ[k] MvPolynomial.X j))
        rw [MvPolynomial.tensorEquivSum_one_tmul_X,
          MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
        congr 1
    rw [hring]
    exact AlgebraicGeometry.pullbackSpecIso_hom_snd k P_d P_d
  have hProjLeft_str : projLeft ≫ struct_d = weilGysinAffineStruct k (2 * d) := by
    dsimp only [projLeft, struct_d, weilGysinAffineProjLeft, weilGysinAffineStruct,
      weilGysinAffineSpace]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact RingHom.ext (fun c => by simp)
  have hcast : ∀ x : Fin (d + d), Fin.cast hab.symm (Fin.cast hab x) = x :=
    fun _ => Fin.ext rfl
  have hAxis_left : leftAxis ≫ projLeft = 𝟙 (weilGysinAffineSpace k d) := by
    dsimp only [leftAxis, projLeft, weilGysinAffineLeftAxis, weilGysinAffineProjLeft,
      weilGysinAffineSpace]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_id (CommRingCat.of P_d), ← CommRingCat.ofHom_id]
    congr 2
    apply MvPolynomial.ringHom_ext
    · intro c
      simp
    · intro i
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X']
      rw [hcast (Fin.castAdd d i), Fin.addCases_left]
      rfl
  have hAxis_right : leftAxis ≫ projRight = struct_d ≫ weilGysinAffineOrigin k d := by
    dsimp only [leftAxis, projRight, struct_d, weilGysinAffineLeftAxis,
      weilGysinAffineProjRight, weilGysinAffineStruct, weilGysinAffineOrigin,
      weilGysinAffineSpace]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply MvPolynomial.ringHom_ext
    · intro c
      simp
    · intro j
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval_X, Pi.zero_apply, map_zero]
      rw [hcast (Fin.natAdd d j), Fin.addCases_right]
  have hOrig_axis : weilGysinAffineOrigin k d ≫ leftAxis = weilGysinAffineOrigin k (2 * d) := by
    dsimp only [leftAxis, weilGysinAffineLeftAxis, weilGysinAffineOrigin, weilGysinAffineSpace]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply MvPolynomial.ringHom_ext
    · intro c
      simp
    · intro m
      simp only [RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval_X, Pi.zero_apply]
      exact Fin.addCases
        (motive := fun x : Fin (d + d) =>
          MvPolynomial.eval (0 : Fin d → k)
            (Fin.addCases (fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) k))
              (fun _ : Fin d => (0 : MvPolynomial (Fin d) k)) x) = 0)
        (fun i => by rw [Fin.addCases_left, MvPolynomial.eval_X, Pi.zero_apply])
        (fun j => by rw [Fin.addCases_right, map_zero])
        (Fin.cast hab.symm m)
  have hA2d_hom_ext : ∀ {T : AlgebraicGeometry.Scheme.{u}}
      (g₁ g₂ : T ⟶ weilGysinAffineSpace k (2 * d)),
      g₁ ≫ projLeft = g₂ ≫ projLeft → g₁ ≫ projRight = g₂ ≫ projRight → g₁ = g₂ := by
    intro T g₁ g₂ hL hR
    apply (cancel_mono E_dd.inv).mp
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, ← hE_fst, ← Category.assoc E_dd.inv,
        E_dd.inv_hom_id, Category.id_comp, hL]
    · rw [Category.assoc, Category.assoc, ← hE_snd, ← Category.assoc E_dd.inv,
        E_dd.inv_hom_id, Category.id_comp, hR]
  have he_u : f_U = u ≫ struct_d := hu_str.symm
  have h_u_id : f_U ≫ 𝟙 S_k = u ≫ struct_d := (Category.comp_id f_U).trans he_u
  let m_uu : CategoryTheory.Limits.pullback f_U f_U ⟶
      CategoryTheory.Limits.pullback struct_d struct_d :=
    CategoryTheory.Limits.pullback.map f_U f_U struct_d struct_d u u (𝟙 S_k) h_u_id h_u_id
  have hm_uu_et : AlgebraicGeometry.Etale m_uu := by
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsStableUnderComposition.mk
        (fun f₁ f₂ hf₁ hf₂ => by
          have : AlgebraicGeometry.Etale f₁ := hf₁
          have : AlgebraicGeometry.Etale f₂ := hf₂
          infer_instance)
    exact CategoryTheory.MorphismProperty.pullbackMap (P := @AlgebraicGeometry.Etale)
      hu_et hu_et he_u he_u
  let Ψ_swap : V_UU.toScheme ⟶ weilGysinAffineSpace k (2 * d) :=
    e_V.hom ≫ m_uu ≫ E_dd.hom
  have hΨ_et : AlgebraicGeometry.Etale Ψ_swap := by
    dsimp [Ψ_swap]
    infer_instance
  have hm_uu_fst : m_uu ≫ CategoryTheory.Limits.pullback.fst struct_d struct_d =
      CategoryTheory.Limits.pullback.fst f_U f_U ≫ u := by
    dsimp [m_uu, CategoryTheory.Limits.pullback.map]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hm_uu_snd : m_uu ≫ CategoryTheory.Limits.pullback.snd struct_d struct_d =
      CategoryTheory.Limits.pullback.snd f_U f_U ≫ u := by
    dsimp [m_uu, CategoryTheory.Limits.pullback.map]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hΨ_left : Ψ_swap ≫ projLeft = p₂_V ≫ u := by
    dsimp [Ψ_swap]
    rw [Category.assoc, Category.assoc, hE_fst, hm_uu_fst, ← Category.assoc, he_V_fst]
  have hΨ_right : Ψ_swap ≫ projRight = p₁_V ≫ u := by
    dsimp [Ψ_swap]
    rw [Category.assoc, Category.assoc, hE_snd, hm_uu_snd, ← Category.assoc, he_V_snd]
  have hΨ_str : Ψ_swap ≫ weilGysinAffineStruct k (2 * d) = V_UU.ι ≫ (p₁ ≫ X.hom) := by
    rw [← hProjLeft_str, ← Category.assoc, hΨ_left, Category.assoc, hu_str,
      ← Category.assoc, hp₂_V, Category.assoc, ← Limits.pullback.condition]
  have hΨ_sq : ι₂_U ≫ Ψ_swap = u ≫ leftAxis := by
    apply hA2d_hom_ext
    · rw [Category.assoc, hΨ_left, ← Category.assoc, hι₂_U_p₂, Category.id_comp,
        Category.assoc, hAxis_left, Category.comp_id]
    · rw [Category.assoc, hΨ_right, ← Category.assoc, hι₂_U_p₁, Category.assoc,
        hpb_u.w, Category.id_comp, he_u, Category.assoc, ← hAxis_right, ← Category.assoc]
  have hpb_Ψ : CategoryTheory.IsPullback ι₂_U u Ψ_swap leftAxis := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hΨ_sq
        (fun cone => cone.fst ≫ p₂_V)
        (fun cone => ?_) (fun cone => ?_) (fun cone m hm₁ _ => ?_))
    · have h_snd : (cone.fst ≫ p₂_V) ≫ u = cone.snd := by
        rw [Category.assoc, ← hΨ_left, ← Category.assoc, cone.condition,
          Category.assoc, hAxis_left, Category.comp_id]
      have h_right : (cone.fst ≫ p₁_V) ≫ u =
          (cone.snd ≫ struct_d) ≫ weilGysinAffineOrigin k d := by
        rw [Category.assoc, ← hΨ_right, ← Category.assoc, cone.condition,
          Category.assoc, hAxis_right, Category.assoc]
      let q : cone.pt ⟶ S_k :=
        hpb_u.lift (cone.fst ≫ p₁_V) (cone.snd ≫ struct_d) h_right
      have hq_sU : q ≫ s_U = cone.fst ≫ p₁_V := hpb_u.lift_fst _ _ _
      have hq_id : q ≫ 𝟙 S_k = cone.snd ≫ struct_d := hpb_u.lift_snd _ _ _
      have hq_eq : q = (cone.fst ≫ p₂_V) ≫ f_U := by
        calc
          q = q ≫ 𝟙 S_k := (Category.comp_id q).symm
          _ = cone.snd ≫ struct_d := hq_id
          _ = ((cone.fst ≫ p₂_V) ≫ u) ≫ struct_d := by rw [h_snd]
          _ = (cone.fst ≫ p₂_V) ≫ f_U := by rw [Category.assoc, he_u]
      apply hV_hom_ext
      · rw [Category.assoc, hι₂_U_p₁, ← Category.assoc _ f_U s_U, ← hq_eq, hq_sU]
      · rw [Category.assoc, hι₂_U_p₂, Category.comp_id]
    · rw [Category.assoc, ← hΨ_left, ← Category.assoc, cone.condition,
        Category.assoc, hAxis_left, Category.comp_id]
    · calc
        m = m ≫ 𝟙 U.toScheme := (Category.comp_id m).symm
        _ = m ≫ (ι₂_U ≫ p₂_V) := by rw [hι₂_U_p₂]
        _ = (m ≫ ι₂_U) ≫ p₂_V := (Category.assoc m ι₂_U p₂_V).symm
        _ = cone.fst ≫ p₂_V := by rw [hm₁]
  have hpb_V : CategoryTheory.IsPullback s_V (𝟙 S_k) Ψ_swap
      (weilGysinAffineOrigin k (2 * d)) := by
    have hpasted := CategoryTheory.IsPullback.paste_horiz hpb_u hpb_Ψ
    rwa [hOrig_axis] at hpasted
  have hChart_V : WeilGysinIsEtaleOriginChart (2 * d) (p₁ ≫ X.hom) (s ≫ Δ) V_UU s_V Ψ_swap :=
    ⟨hΨ_et, hΨ_str, hs_V_ι, hpb_V⟩
  exact ⟨ι₂, V_UU, s_V, ι₂_U, p₁_V, Ψ_swap,
    hSep_P, hι₂_cl, hι₂_U_cl, hs_ι₂, hι₂_p₂, hpb_ι₂,
    hChart_V, rfl, hpb_ι₂_U, hpb_p₁_V, hp₁_V, hpb_Ψ, hΨ_right⟩

theorem weil_gysin_pointed_kaehler_steinitz_away_etale_chain (k : Type u) [Field k]
    (c : ℕ) (hc : 1 ≤ c)
    (B₀ : Type u) [CommRing B₀]
    (f_k : k →+* B₀) (ev₀ : B₀ →+* k)
    (φ₁ φ₂ : MvPolynomial (Fin c) k →+* B₀)
    (hev_k : ev₀.comp f_k = RingHom.id k)
    (hφ₁_k : φ₁.comp MvPolynomial.C = f_k)
    (hφ₂_k : φ₂.comp MvPolynomial.C = f_k)
    (hφ₁_ev : ev₀.comp φ₁ = MvPolynomial.eval 0)
    (hφ₂_ev : ev₀.comp φ₂ = MvPolynomial.eval 0)
    (hφ₁_et : φ₁.Etale)
    (hφ₂_et : φ₂.Etale) :
    ∃ (f_prod : B₀) (N : ℕ) (x : Fin (N + 1) → Fin c → B₀),
      ev₀ f_prod ≠ 0 ∧
      (∀ j : Fin c, x 0 j = φ₁ (MvPolynomial.X j)) ∧
      (∀ j : Fin c, x (Fin.last N) j = φ₂ (MvPolynomial.X j)) ∧
      (∀ (m : Fin (N + 1)) (j : Fin c), ev₀ (x m j) = 0) ∧
      (∀ (S : Type u) [CommRing S] (g : B₀ →+* S),
        @IsLocalization.Away B₀ _ f_prod S _ g.toAlgebra →
        ∀ m : Fin (N + 1),
          (MvPolynomial.eval₂Hom (g.comp f_k) (fun j => g (x m j))).Etale) ∧
      (∀ m : Fin N, ∃ i₀ : Fin c, ∀ j : Fin c, j ≠ i₀ → x m.succ j = x m.castSucc j) :=
by
  classical
  letI : Algebra k B₀ := f_k.toAlgebra
  let P_c := MvPolynomial (Fin c) k
  let b_P : Module.Basis (Fin c) P_c Ω[P_c⁄k] := KaehlerDifferential.mvPolynomialBasis k (Fin c)
  have hBasis : ∀ (φ : P_c →+* B₀),
      φ.comp MvPolynomial.C = f_k →
      φ.Etale →
      Algebra.FormallySmooth k B₀ ∧
      Algebra.FinitePresentation k B₀ ∧
      ∃ b : Module.Basis (Fin c) B₀ Ω[B₀⁄k],
        ∀ j : Fin c, b j = KaehlerDifferential.D k B₀ (φ (MvPolynomial.X j)) := by
    intro φ hφ_k hφ_et
    letI : Algebra P_c B₀ := φ.toAlgebra
    have h_alg : (algebraMap P_c B₀).comp (algebraMap k P_c) = algebraMap k B₀ := hφ_k
    haveI : IsScalarTower k P_c B₀ := IsScalarTower.of_algebraMap_eq' h_alg.symm
    haveI : Algebra.Etale P_c B₀ := RingHom.etale_algebraMap.mp hφ_et
    have hSm : Algebra.FormallySmooth k B₀ := Algebra.FormallySmooth.comp k P_c B₀
    have hFP : Algebra.FinitePresentation k B₀ := Algebra.FinitePresentation.trans k P_c B₀
    let e_φ : TensorProduct P_c B₀ Ω[P_c⁄k] ≃ₗ[B₀] Ω[B₀⁄k] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k P_c B₀
    let b : Module.Basis (Fin c) B₀ Ω[B₀⁄k] := (b_P.baseChange B₀).map e_φ
    refine ⟨hSm, hFP, b, fun j => ?_⟩
    dsimp [b, e_φ, b_P]
    rw [Module.Basis.baseChange_apply,
      KaehlerDifferential.mvPolynomialBasis_apply,
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
      KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
    rfl
  obtain ⟨hSm, hFP, b₁, hb₁⟩ := hBasis φ₁ hφ₁_k hφ₁_et
  haveI : Algebra.FormallySmooth k B₀ := hSm
  haveI : Algebra.FinitePresentation k B₀ := hFP
  obtain ⟨-, -, b₂, hb₂⟩ := hBasis φ₂ hφ₂_k hφ₂_et
  let z₁ : Fin c → B₀ := fun j => φ₁ (MvPolynomial.X j)
  let z₂ : Fin c → B₀ := fun j => φ₂ (MvPolynomial.X j)
  let J (z : Fin c → B₀) : Matrix (Fin c) (Fin c) B₀ :=
    Matrix.of fun r j => b₁.repr (KaehlerDifferential.D k B₀ (z j)) r
  have hJ₁_one : J z₁ = 1 := by
    ext r j
    simp only [J, z₁, Matrix.of_apply, ← hb₁ j, Module.Basis.repr_self,
      Finsupp.single_apply, Matrix.one_apply]
    by_cases h : r = j
    · rw [h]
    · have h' : j ≠ r := Ne.symm h
      simp [h, h']
  have hJ₂_eq : J z₂ = b₁.toMatrix b₂ := by
    ext r j
    simp only [J, z₂, Matrix.of_apply, ← hb₂ j, Module.Basis.toMatrix_apply]
  have hJ₂_unit : IsUnit (J z₂).det := by
    rw [hJ₂_eq]
    refine isUnit_iff_exists_inv.mpr ⟨(b₂.toMatrix b₁).det, ?_⟩
    rw [← Matrix.det_mul, Module.Basis.toMatrix_mul_toMatrix_flip, Matrix.det_one]
  let δ : B₀ →+ (Fin c → k) :=
    { toFun := fun b r => ev₀ (b₁.repr (KaehlerDifferential.D k B₀ b) r)
      map_zero' := by
        ext r
        simp
      map_add' := fun a b => by
        ext r
        simp [map_add] }
  let M (z : Fin c → B₀) : Matrix (Fin c) (Fin c) k :=
