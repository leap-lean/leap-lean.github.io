              (ff_Z.map_preimage _) (ff_Z.map_preimage _)).trans
              ((CategoryTheory.Category.assoc a1 (CategoryTheory.CategoryStruct.comp a2 a3)
                (CategoryTheory.CategoryStruct.comp a4 rhs_g)).trans
                (congrArg (CategoryTheory.CategoryStruct.comp a1)
                  ((CategoryTheory.Category.assoc a2 a3
                    (CategoryTheory.CategoryStruct.comp a4 rhs_g)).trans
                    (congrArg (CategoryTheory.CategoryStruct.comp a2)
                      ((CategoryTheory.Category.assoc a3 a4 rhs_g).symm.trans
