            toHom ((ℱ.obj.map f.op).hom m) :=
        fun f m => toHom_post m (ℱ.obj.map f.op)
      have hOpensRange : ∀ {X : AlgebraicGeometry.Scheme.{u}} (O : X.Opens),
          Set.range O.ι.base = (O : Set ↥X) := by
        intro X O
        ext x
        exact ⟨by rintro ⟨y, rfl⟩; exact y.2, fun hx => ⟨⟨x, hx⟩, rfl⟩⟩
      have hℱ_sh : Presieve.IsSheaf J (ℱ.obj ⋙ coyoneda.obj (Opposite.op R_mod)) :=
        ℱ.property R_mod
      have hEmpty_sub : ∀ (Z : S.Etale), IsEmpty ↥Z.left → Subsingleton ↥(ℱ.obj.obj (Opposite.op Z)) := by
        intro Z hZ
        have hbot : (⊥ : Sieve Z) ∈ J Z := (hMemEtaleJ S Z ⊥).mpr fun z => hZ.elim z
        refine ⟨fun x y => toHom_inj ?_⟩
        exact (hℱ_sh ⊥ hbot).isSeparatedFor.ext fun _ _ hf => False.elim hf
      let liftUV (Y : S.Etale) (hY : Set.range (Y.hom : Y.left ⟶ S).base ⊆ (V : Set ↥S)) : Y ⟶ U_V :=
        have hY' : Set.range (Y.hom : Y.left ⟶ S).base ⊆ Set.range V.ι.base := by
          rwa [hOpensRange]
        let l_Y : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ V.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift V.ι (Y.hom : Y.left ⟶ S) hY'
        have hl_Y : l_Y ≫ V.ι = Y.hom :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac V.ι (Y.hom : Y.left ⟶ S) hY'
