    let e_U₀ : LaurentPolynomial k ≃+* R_U₀ := e_alg_U₀.toRingEquiv
    have he_U₀_T : e_U₀ (LaurentPolynomial.T 1) = (u_X₀ : R_U₀) := by
      have hT1 : (LaurentPolynomial.T 1 : LaurentPolynomial k) =
