      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE ξ W ⊤ he)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom =
        ψ_K.comp (P.left.germToFunctionField W).hom := by
    intro W hNeW he
    have hxC_W : x_C ∈ (TopologicalSpace.Opens.map p_C.base).obj W := by
      change p_C.base x_C ∈ W
      rw [hpC_gen]
      obtain ⟨w₀⟩ := hNeW
      exact ((genericPoint_spec ↥P.left).mem_open_set_iff W.isOpen).mpr ⟨w₀.1, trivial, w₀.2⟩
    have happ_eq1 : ξ.appLE W ⊤ he =
        ξ.app W ≫
          (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.map
            (CategoryTheory.homOfLE he).op := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app ξ,
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    have he_η : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) ≤
        (TopologicalSpace.Opens.map η_C.base).obj
          ((TopologicalSpace.Opens.map p_C.base).obj W) := he
    have hη_app : η_C.app ((TopologicalSpace.Opens.map p_C.base).obj W) ≫
          (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.map
            (CategoryTheory.homOfLE he_η).op ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom =
        C.presheaf.germ ((TopologicalSpace.Opens.map p_C.base).obj W) x_C hxC_W := by
      dsimp only [η_C]
      rw [AlgebraicGeometry.Scheme.fromSpecStalk_app hxC_W]
      change C.presheaf.germ ((TopologicalSpace.Opens.map p_C.base).obj W) x_C hxC_W ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (C.presheaf.stalk x_C)).inv ≫
          ((AlgebraicGeometry.Spec (C.presheaf.stalk x_C)).presheaf.map
              (CategoryTheory.homOfLE le_top).op ≫
            (AlgebraicGeometry.Spec (C.presheaf.stalk x_C)).presheaf.map
              (CategoryTheory.homOfLE he_η).op) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (C.presheaf.stalk x_C)).hom = _
      rw [← CategoryTheory.Functor.map_comp, ← op_comp]
      have hid : CategoryTheory.homOfLE he_η ≫ CategoryTheory.homOfLE le_top =
          𝟙 (⊤ : (AlgebraicGeometry.Spec (C.presheaf.stalk x_C)).Opens) :=
        Subsingleton.elim _ _
      rw [hid, op_id, CategoryTheory.Functor.map_id, CategoryTheory.Category.id_comp,
        CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
    have hcat : ξ.appLE W ⊤ he ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom =
        P.left.germToFunctionField W ≫ ψ_cat := by
      rw [happ_eq1]
      change (p_C.app W ≫ η_C.app ((TopologicalSpace.Opens.map p_C.base).obj W)) ≫
          (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.map
            (CategoryTheory.homOfLE he_η).op ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom = _
      rw [CategoryTheory.Category.assoc, hη_app, hpC_germ W]
    exact congrArg CommRingCat.Hom.hom hcat

  have he_pC : (⊤ : C.Opens) ≤ (TopologicalSpace.Opens.map p_C.base).obj V₁ := by
    intro c _
    exact ⟨u_C.base c, rfl⟩
  have hpC_appLE_eq : p_C.appLE V₁ ⊤ he_pC = φ_V1 ≫ φ_cat := by
    have hSpec1 : AlgebraicGeometry.Spec.map (p_C.appLE V₁ ⊤ he_pC) ≫ hAff_V1.fromSpec =
        e_C.inv ≫ p_C := by
      rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_top (X := C)]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_C hAff_V1
        (AlgebraicGeometry.isAffineOpen_top C) he_pC
    have hSpec2 : AlgebraicGeometry.Spec.map (φ_V1 ≫ φ_cat) ≫ hAff_V1.fromSpec =
        e_C.inv ≫ p_C := by
      calc
        AlgebraicGeometry.Spec.map (φ_V1 ≫ φ_cat) ≫ hAff_V1.fromSpec
          = AlgebraicGeometry.Spec.map φ_cat ≫
              (AlgebraicGeometry.Spec.map φ_V1 ≫ hAff_V1.fromSpec) := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = (e_C.inv ≫ u_C) ≫ (lift_V1_to ≫ hAff_V1.fromSpec) := by
            rw [hSpec_φ, AlgebraicGeometry.Spec.map_preimage]
        _ = e_C.inv ≫ p_C := by
            dsimp only [lift_V1_to, p_C]
            rw [AlgebraicGeometry.IsOpenImmersion.lift_fac, CategoryTheory.Category.assoc]
    apply AlgebraicGeometry.Spec.map_injective
    rw [← CategoryTheory.cancel_mono hAff_V1.fromSpec, hSpec1, hSpec2]

  haveI hNe_topC : Nonempty ↥((⊤ : C.Opens) : AlgebraicGeometry.Scheme.{u}) :=
    ⟨⟨x_C, trivial⟩⟩
  letI alg_AV1_K0 : Algebra A_V1 K₀ := (P.left.germToFunctionField V₁).hom.toAlgebra
  have hFrac_AV1_K0 : @IsFractionRing A_V1 _ K₀ _ alg_AV1_K0 :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen P.left V₁ hAff_V1
  letI alg_B_K : Algebra B K := (C.germToFunctionField ⊤).hom.toAlgebra
  haveI hFrac_B_K : IsFractionRing B K :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C ⊤
      (AlgebraicGeometry.isAffineOpen_top C)
  letI : Algebra R₀ K₀ := (φ_V1_inv ≫ P.left.germToFunctionField V₁).hom.toAlgebra
  haveI hFrac_R₀_K₀ : IsFractionRing R₀ K₀ := by
    have hinj_AV1 : Function.Injective (P.left.germToFunctionField V₁).hom :=
      AlgebraicGeometry.Scheme.germToFunctionField_injective P.left V₁
    have hinj_inv : Function.Injective φ_V1_inv.hom := fun x y hxy => by
      have h := congrArg φ_V1.hom hxy
      have h1 := congrArg (fun f : CommRingCat.of R₀ ⟶ CommRingCat.of R₀ => f.hom x) hφ_V1_2
      have h2 := congrArg (fun f : CommRingCat.of R₀ ⟶ CommRingCat.of R₀ => f.hom y) hφ_V1_2
      exact h1.symm.trans (h.trans h2)
    have hinj_R₀ : Function.Injective (algebraMap R₀ K₀) := hinj_AV1.comp hinj_inv
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨s, hs⟩
      have hs_ne : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
      exact IsUnit.mk0 (algebraMap R₀ K₀ s) (fun h0 => hs_ne (hinj_R₀ (h0.trans (map_zero _).symm)))
    · intro z
      obtain ⟨⟨a, s⟩, hz⟩ := @IsLocalization.surj A_V1 _ (nonZeroDivisors A_V1) K₀ _
        alg_AV1_K0 hFrac_AV1_K0 z
      have hs_ne : (s : A_V1) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have ht_ne : φ_V1.hom (s : A_V1) ≠ 0 := by
        intro h0
        apply hs_ne
        have h1 := congrArg (fun f : A_V1_cat ⟶ A_V1_cat => f.hom (s : A_V1)) hφ_V1_1
        change φ_V1_inv.hom (φ_V1.hom (s : A_V1)) = (s : A_V1) at h1
        rw [h0, map_zero] at h1
        exact h1.symm
      refine ⟨⟨φ_V1.hom a, ⟨φ_V1.hom (s : A_V1), mem_nonZeroDivisors_iff_ne_zero.mpr ht_ne⟩⟩, ?_⟩
      have ha_eq : φ_V1_inv.hom (φ_V1.hom a) = a :=
        congrArg (fun f : A_V1_cat ⟶ A_V1_cat => f.hom a) hφ_V1_1
      have hs_eq : φ_V1_inv.hom (φ_V1.hom (s : A_V1)) = (s : A_V1) :=
        congrArg (fun f : A_V1_cat ⟶ A_V1_cat => f.hom (s : A_V1)) hφ_V1_1
      change z * (P.left.germToFunctionField V₁).hom (φ_V1_inv.hom (φ_V1.hom (s : A_V1))) =
        (P.left.germToFunctionField V₁).hom (φ_V1_inv.hom (φ_V1.hom a))
      rw [hs_eq, ha_eq]
      exact hz
    · intro x y hxy
      exact ⟨1, by simp [hinj_R₀ hxy]⟩

  letI : Algebra K₀ K := ψ_K.toAlgebra
  letI : Algebra R₀ K := (φ_cat ≫ C.germToFunctionField ⊤).hom.toAlgebra
  have hTower_cat : (φ_V1_inv ≫ P.left.germToFunctionField V₁) ≫ ψ_cat =
      φ_cat ≫ C.germToFunctionField ⊤ := by
    rw [CategoryTheory.Category.assoc, hpC_germ V₁]
    have hpC_top : p_C.app V₁ ≫ C.presheaf.germ ((TopologicalSpace.Opens.map p_C.base).obj V₁) x_C
          (by
            change p_C.base x_C ∈ V₁
            rw [hpC_gen]
            exact ((genericPoint_spec ↥P.left).mem_open_set_iff V₁.isOpen).mpr
              ⟨_, trivial, ⟨η_A1, rfl⟩⟩) =
        p_C.appLE V₁ ⊤ he_pC ≫ C.germToFunctionField ⊤ := by
      have h1 : p_C.appLE V₁ ⊤ he_pC =
          p_C.app V₁ ≫ C.presheaf.map (CategoryTheory.homOfLE he_pC).op := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app p_C,
          AlgebraicGeometry.Scheme.Hom.appLE_map]
      rw [h1, CategoryTheory.Category.assoc]
      congr 1
      dsimp only [AlgebraicGeometry.Scheme.germToFunctionField]
      exact (C.presheaf.germ_res (CategoryTheory.homOfLE he_pC) x_C trivial).symm
    rw [hpC_top, hpC_appLE_eq, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
      hφ_V1_2, CategoryTheory.Category.id_comp]
  haveI : IsScalarTower R₀ K₀ K :=
    IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom hTower_cat).symm
  haveI : IsScalarTower R₀ B K := IsScalarTower.of_algebraMap_eq' rfl

  obtain ⟨hFinDim_K, hSep_K, hd_ge_one⟩ := hFrac_B K₀ K
  let d : ℕ := Module.finrank K₀ K

  
  obtain ⟨hInt_Y, hFin_ubar, hSurj_ubar, hChart_norm⟩ :=
    weil_dedekind_atlas_generic_normalization_package P.left hDedCover hNonGen K ξ ψ_K
      hFinDim_K hSep_K hξ_gen hξ_app
  let Y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.normalization ξ
  let u_bar : Y ⟶ P.left := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
  let N : CategoryTheory.Over S_Ω := CategoryTheory.Over.mk (u_bar ≫ P.hom)
  haveI : AlgebraicGeometry.IsIntegral Y := hInt_Y
  haveI : AlgebraicGeometry.IsFinite u_bar := hFin_ubar
  haveI : AlgebraicGeometry.Surjective u_bar := hSurj_ubar
  haveI hProp_N : AlgebraicGeometry.IsProper N.hom := by
    change AlgebraicGeometry.IsProper (u_bar ≫ P.hom)
    infer_instance

  
  have hSmooth_N : AlgebraicGeometry.SmoothOfRelativeDimension 1 N.hom := by
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro x
    obtain ⟨W, hyW, hW, hDedW⟩ := hDedCover (u_bar.base x)
    haveI : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨u_bar.base x, hyW⟩⟩
    obtain ⟨hW', hDom_BW, hIC_BW, _hDed_BW, _hFin_W, hKrull_BW, _⟩ :=
      hChart_norm W hW hDedW
    let W' : Y.Opens := (TopologicalSpace.Opens.map u_bar.base).obj W
    have hxW' : x ∈ W' := hyW
    let B_W_cat : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W')
    let B_W : Type u := ↑B_W_cat
    letI : IsDomain B_W := hDom_BW
    letI : IsIntegrallyClosed B_W := hIC_BW
    have he_W'_top : W' ≤ (TopologicalSpace.Opens.map N.hom.base).obj ⊤ :=
      fun _ _ => trivial
    let φ_Ω_BW_cat : CommRingCat.of Ω ⟶ B_W_cat :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        N.hom.appLE ⊤ W' he_W'_top
    have hSpec_appLE_Ω : AlgebraicGeometry.Spec.map
        (N.hom.appLE ⊤ W' he_W'_top) ≫
        S_Ω.isoSpec.inv = hW'.fromSpec ≫ N.hom := by
      rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_top (X := S_Ω)]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec N.hom
        (AlgebraicGeometry.isAffineOpen_top S_Ω) hW' he_W'_top
    have hSpec_Ω_BW : AlgebraicGeometry.Spec.map φ_Ω_BW_cat =
