    let c' : ↥((weilEtaleKPresheaf Y.left).obj (Opposite.op (weilEtaleCechObj w (p + 1)))) :=
      (isoK.inv.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom c
    have hc' : weilEtaleCechDiff (weilEtaleKPresheaf Y.left) w (p + 1) c' = 0 := by
      rw [← hCech_nat isoK.inv (p + 1) c, hc, map_zero]
