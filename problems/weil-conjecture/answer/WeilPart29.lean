      unfold ringKrullDim Order.krullDim
      refine iSup_le fun s => ?_
      have hs0 : s.length = 0 := by
        by_contra hne
        have hpos : 0 < s.length := Nat.pos_of_ne_zero hne
        have hstep : s ⟨0, Nat.succ_pos _⟩ < s ⟨1, Nat.succ_lt_succ hpos⟩ := s.step ⟨0, hpos⟩
