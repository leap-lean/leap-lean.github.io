      refine ⟨e_uU₀ y₀, ?_⟩
      rw [← map_nsmul, hy₀, e_uU₀.apply_symm_apply]

theorem weil_gysin_one_dim_etale_origin_chart_unit_ratio (k : Type u) [Field k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let A₁ := weilGysinAffineSpace k 1
    let o₁ := weilGysinAffineOrigin k 1
    let X₀_sec : ↑(A₁.presheaf.obj (Opposite.op ⊤)) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) k))).inv.hom
        (MvPolynomial.X 0)
    ∀ (C : AlgebraicGeometry.Scheme.{u}) (p_C : Quiver.Hom C S_k)
      [AlgebraicGeometry.IsSeparated p_C]
      (s_C : Quiver.Hom S_k C),
      CategoryTheory.CategoryStruct.comp s_C p_C = CategoryTheory.CategoryStruct.id S_k →
      ∀ (s_C_top : Quiver.Hom S_k (⊤ : C.Opens).toScheme)
        (g₁ g₂ : Quiver.Hom (⊤ : C.Opens).toScheme A₁),
        WeilGysinIsEtaleOriginChart 1 p_C s_C ⊤ s_C_top g₁ →
        WeilGysinIsEtaleOriginChart 1 p_C s_C ⊤ s_C_top g₂ →
        AlgebraicGeometry.IsClosedImmersion s_C_top ∧
        ∃ (W'₀ : ((⊤ : C.Opens).toScheme).Opens)
          (s'₀ : Quiver.Hom S_k W'₀.toScheme)
          (U'₀ : (W'₀.toScheme).Opens)
          (u_rat : Units ↑(W'₀.toScheme.presheaf.obj (Opposite.op ⊤))),
          CategoryTheory.CategoryStruct.comp s'₀ W'₀.ι = s_C_top ∧
          AlgebraicGeometry.IsClosedImmersion s'₀ ∧
          (U'₀ : Set ↥W'₀.toScheme) = (Set.range s'₀.base)ᶜ ∧
          CategoryTheory.IsPullback s'₀ (CategoryTheory.CategoryStruct.id S_k)
            (CategoryTheory.CategoryStruct.comp W'₀.ι g₁) o₁ ∧
          CategoryTheory.IsPullback s'₀ (CategoryTheory.CategoryStruct.id S_k)
            (CategoryTheory.CategoryStruct.comp W'₀.ι g₂) o₁ ∧
          Set.range (CategoryTheory.CategoryStruct.comp U'₀.ι
            (CategoryTheory.CategoryStruct.comp W'₀.ι g₁)).base ⊆ (Set.range o₁.base)ᶜ ∧
          Set.range (CategoryTheory.CategoryStruct.comp U'₀.ι
            (CategoryTheory.CategoryStruct.comp W'₀.ι g₂)).base ⊆ (Set.range o₁.base)ᶜ ∧
          (CategoryTheory.CategoryStruct.comp W'₀.ι g₂).appTop.hom X₀_sec =
            (u_rat : ↑(W'₀.toScheme.presheaf.obj (Opposite.op ⊤))) *
              (CategoryTheory.CategoryStruct.comp W'₀.ι g₁).appTop.hom X₀_sec :=
by
  classical
  intro S_k A₁ o₁ X₀_sec C p_C inst_sep s_C hs_C s_C_top g₁ g₂ hg₁ hg₂
  have _ := inst_sep
  
  have heval0_surj : Function.Surjective (MvPolynomial.eval (0 : Fin 1 → k)) := by
    intro c
    exact ⟨MvPolynomial.C c, MvPolynomial.eval_C c⟩
  have ho₁_cl : AlgebraicGeometry.IsClosedImmersion o₁ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 1 → k))) heval0_surj
  have hs_C_top_cl : AlgebraicGeometry.IsClosedImmersion s_C_top :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hg₁.2.2.2.flip ho₁_cl
  refine ⟨hs_C_top_cl, ?_⟩
  
  let C_top : AlgebraicGeometry.Scheme.{u} := (⊤ : C.Opens).toScheme
  let pt₀ : ↥S_k := default
  have hSk_uniq : ∀ q : ↥S_k, q = pt₀ := fun q => Subsingleton.elim q pt₀
  have hSk_ideal_zero : ∀ (q : ↥S_k) (c : k), c ∈ q.asIdeal ↔ c = 0 := by
    intro q c
    refine ⟨fun hc => ?_, fun hc => hc ▸ q.asIdeal.zero_mem⟩
    by_contra hc0
    apply q.isPrime.ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 : c⁻¹ * c = 1 := inv_mul_cancel₀ hc0
    rw [← h1]
    exact q.asIdeal.mul_mem_left c⁻¹ hc
  let x₀ : ↥C_top := s_C_top.base pt₀
  obtain ⟨W₀, hW₀, hx₀_W₀, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x₀) (U := (⊤ : C_top.Opens)) trivial
  
  have hLiftOpen : ∀ (V : C_top.Opens), x₀ ∈ V →
      ∃ s_V : Quiver.Hom S_k V.toScheme,
        CategoryTheory.CategoryStruct.comp s_V V.ι = s_C_top ∧
        CategoryTheory.IsPullback s_V (CategoryTheory.CategoryStruct.id S_k)
          (CategoryTheory.CategoryStruct.comp V.ι g₁) o₁ ∧
        CategoryTheory.IsPullback s_V (CategoryTheory.CategoryStruct.id S_k)
          (CategoryTheory.CategoryStruct.comp V.ι g₂) o₁ := by
    intro V hx₀_V
    have h_range_V : Set.range s_C_top.base ⊆ Set.range V.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι V]
      rintro _ ⟨q, rfl⟩
      rw [hSk_uniq q]
      exact hx₀_V
    let s_V : Quiver.Hom S_k V.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V.ι s_C_top h_range_V
    have hs_V : CategoryTheory.CategoryStruct.comp s_V V.ι = s_C_top :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V.ι s_C_top h_range_V
    have hpb_V : CategoryTheory.IsPullback s_V (CategoryTheory.CategoryStruct.id S_k)
        V.ι s_C_top := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback s_V
        (CategoryTheory.CategoryStruct.id S_k) V.ι s_C_top
      · exact (CategoryTheory.Category.id_comp s_C_top).trans hs_V.symm
      · ext q
        simp only [TopologicalSpace.Opens.map_obj, SetLike.mem_coe,
          AlgebraicGeometry.Scheme.Opens.opensRange_ι]
        change s_C_top.base q ∈ V ↔ q ∈ Set.range (CategoryTheory.CategoryStruct.id S_k).base
        have hmem : s_C_top.base q ∈ V := by
          rw [← hs_V]
          exact (s_V.base q).2
        exact ⟨fun _ => ⟨q, rfl⟩, fun _ => hmem⟩
    have hpb_1 : CategoryTheory.IsPullback s_V (CategoryTheory.CategoryStruct.id S_k)
        (CategoryTheory.CategoryStruct.comp V.ι g₁) o₁ := by
      have hp := hpb_V.paste_vert hg₁.2.2.2
      rwa [CategoryTheory.Category.id_comp] at hp
    have hpb_2 : CategoryTheory.IsPullback s_V (CategoryTheory.CategoryStruct.id S_k)
        (CategoryTheory.CategoryStruct.comp V.ι g₂) o₁ := by
      have hp := hpb_V.paste_vert hg₂.2.2.2
      rwa [CategoryTheory.Category.id_comp] at hp
    exact ⟨s_V, hs_V, hpb_1, hpb_2⟩
  obtain ⟨s_W₀, hs_W₀, hpb_W₀_1, hpb_W₀_2⟩ := hLiftOpen W₀ hx₀_W₀
  
  let R₀ : CommRingCat.{u} := C_top.presheaf.obj (Opposite.op W₀)
  let B₀ : Type u := ↑R₀
  let P₁ : Type u := MvPolynomial (Fin 1) k
  let R_A : CommRingCat.{u} := CommRingCat.of P₁
  let f_k_cat : CommRingCat.of k ⟶ R₀ :=
    AlgebraicGeometry.Spec.preimage (hW₀.isoSpec.inv ≫ W₀.ι ≫ (⊤ : C.Opens).ι ≫ p_C)
  let f_k : k →+* B₀ := f_k_cat.hom
  let ev₀_cat : R₀ ⟶ CommRingCat.of k :=
    AlgebraicGeometry.Spec.preimage (s_W₀ ≫ hW₀.isoSpec.hom)
  let ev₀ : B₀ →+* k := ev₀_cat.hom
  let φ₁_cat : R_A ⟶ R₀ :=
    AlgebraicGeometry.Spec.preimage (hW₀.isoSpec.inv ≫ W₀.ι ≫ g₁)
  let φ₁ : P₁ →+* B₀ := φ₁_cat.hom
  let φ₂_cat : R_A ⟶ R₀ :=
    AlgebraicGeometry.Spec.preimage (hW₀.isoSpec.inv ≫ W₀.ι ≫ g₂)
  let φ₂ : P₁ →+* B₀ := φ₂_cat.hom
  have hf_k_map : AlgebraicGeometry.Spec.map f_k_cat =
      hW₀.isoSpec.inv ≫ W₀.ι ≫ (⊤ : C.Opens).ι ≫ p_C :=
    AlgebraicGeometry.Spec.map_preimage _
  have hev₀_map : AlgebraicGeometry.Spec.map ev₀_cat = s_W₀ ≫ hW₀.isoSpec.hom :=
    AlgebraicGeometry.Spec.map_preimage _
  have hφ₁_map : AlgebraicGeometry.Spec.map φ₁_cat = hW₀.isoSpec.inv ≫ W₀.ι ≫ g₁ :=
    AlgebraicGeometry.Spec.map_preimage _
  have hφ₂_map : AlgebraicGeometry.Spec.map φ₂_cat = hW₀.isoSpec.inv ≫ W₀.ι ≫ g₂ :=
    AlgebraicGeometry.Spec.map_preimage _
  have hev_fk_cat : f_k_cat ≫ ev₀_cat = 𝟙 (CommRingCat.of k) := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hev₀_map, hf_k_map]
    calc
      (s_W₀ ≫ hW₀.isoSpec.hom) ≫ (hW₀.isoSpec.inv ≫ W₀.ι ≫ (⊤ : C.Opens).ι ≫ p_C)
        = (s_W₀ ≫ W₀.ι) ≫ (⊤ : C.Opens).ι ≫ p_C := by simp
      _ = (s_C_top ≫ (⊤ : C.Opens).ι) ≫ p_C := by
          rw [hs_W₀, CategoryTheory.Category.assoc]
      _ = s_C ≫ p_C := by rw [hg₁.2.2.1]
      _ = 𝟙 S_k := hs_C
  have hev_fk : ev₀.comp f_k = RingHom.id k :=
    congrArg CommRingCat.Hom.hom hev_fk_cat
  have hφ_props : ∀ (g : Quiver.Hom C_top A₁) (φ_cat : R_A ⟶ R₀),
      AlgebraicGeometry.Spec.map φ_cat = hW₀.isoSpec.inv ≫ W₀.ι ≫ g →
      CategoryTheory.CategoryStruct.comp g (weilGysinAffineStruct k 1) =
        CategoryTheory.CategoryStruct.comp (⊤ : C.Opens).ι p_C →
      CategoryTheory.IsPullback s_W₀ (CategoryTheory.CategoryStruct.id S_k)
        (CategoryTheory.CategoryStruct.comp W₀.ι g) o₁ →
      φ_cat.hom.comp MvPolynomial.C = f_k ∧
      ev₀.comp φ_cat.hom = MvPolynomial.eval 0 ∧
      (CategoryTheory.CategoryStruct.comp W₀.ι g).appTop.hom X₀_sec =
        W₀.topIso.inv.hom (φ_cat.hom (MvPolynomial.X 0)) := by
    intro g φ_cat hφ_map hg_struct hpb_g
    have hC_cat : CommRingCat.ofHom MvPolynomial.C ≫ φ_cat = f_k_cat := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hφ_map, hf_k_map]
      change (hW₀.isoSpec.inv ≫ W₀.ι ≫ g) ≫ weilGysinAffineStruct k 1 = _
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hg_struct]
    have hev_cat : φ_cat ≫ ev₀_cat = CommRingCat.ofHom (MvPolynomial.eval 0) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hev₀_map, hφ_map]
      calc
        (s_W₀ ≫ hW₀.isoSpec.hom) ≫ (hW₀.isoSpec.inv ≫ W₀.ι ≫ g)
          = s_W₀ ≫ (W₀.ι ≫ g) := by simp
        _ = 𝟙 S_k ≫ o₁ := hpb_g.w
        _ = o₁ := CategoryTheory.Category.id_comp o₁
    have hg_W₀_eq : W₀.ι ≫ g = W₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ_cat := by
      dsimp only [A₁, weilGysinAffineSpace, R_A, P₁, R₀] at g φ_cat hφ_map ⊢
      rw [← hW₀.isoSpec_hom, hφ_map, CategoryTheory.Iso.hom_inv_id_assoc]
    have happ_eq : (W₀.ι ≫ g).appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso R_A).hom ≫ φ_cat ≫ W₀.topIso.inv := by
      dsimp only [A₁, weilGysinAffineSpace, R_A, P₁, R₀] at g φ_cat hg_W₀_eq ⊢
      rw [hg_W₀_eq, AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop W₀,
        ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_cat,
        CategoryTheory.Category.assoc]
    have hsec_eq : (W₀.ι ≫ g).appTop.hom X₀_sec =
        W₀.topIso.inv.hom (φ_cat.hom (MvPolynomial.X 0)) := by
      dsimp only [X₀_sec, A₁, weilGysinAffineSpace, R_A, P₁] at g happ_eq ⊢
      change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) k))).inv ≫
        (W₀.ι ≫ g).appTop).hom (MvPolynomial.X 0) = _
      rw [happ_eq, CategoryTheory.Iso.inv_hom_id_assoc]
      rfl
    exact ⟨congrArg CommRingCat.Hom.hom hC_cat,
      congrArg CommRingCat.Hom.hom hev_cat, hsec_eq⟩
  obtain ⟨hφ₁_C, hev_φ₁, hsec_W₀_1⟩ := hφ_props g₁ φ₁_cat hφ₁_map hg₁.2.1 hpb_W₀_1
  obtain ⟨hφ₂_C, hev_φ₂, hsec_W₀_2⟩ := hφ_props g₂ φ₂_cat hφ₂_map hg₂.2.1 hpb_W₀_2
  
  have hφ₂_spec_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₂_cat) := by
    haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      AlgebraicGeometry.HasRingHomProperty.stableUnderComposition
        RingHom.Etale.stableUnderComposition
    have h1 : AlgebraicGeometry.Etale hW₀.isoSpec.inv := inferInstance
    have h2 : AlgebraicGeometry.Etale W₀.ι := inferInstance
    have h3 : AlgebraicGeometry.Etale g₂ := hg₂.1
    dsimp only [A₁, weilGysinAffineSpace, R_A, P₁, R₀] at g₂ h3 φ₂_cat hφ₂_map ⊢
    rw [hφ₂_map]
    exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _ h1
      (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _ h2 h3)
  have hφ₂_et : RingHom.Etale φ₂ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hφ₂_spec_et
  
  let t₁ : B₀ := φ₁ (MvPolynomial.X 0)
  let t₂ : B₀ := φ₂ (MvPolynomial.X 0)
  have h_span_ker : ∀ (g : Quiver.Hom C_top A₁) (φ_cat : R_A ⟶ R₀),
      AlgebraicGeometry.Spec.map φ_cat = hW₀.isoSpec.inv ≫ W₀.ι ≫ g →
      φ_cat.hom.comp MvPolynomial.C = f_k →
      ev₀.comp φ_cat.hom = MvPolynomial.eval 0 →
      CategoryTheory.IsPullback s_W₀ (CategoryTheory.CategoryStruct.id S_k)
        (CategoryTheory.CategoryStruct.comp W₀.ι g) o₁ →
      Ideal.span ({φ_cat.hom (MvPolynomial.X 0)} : Set B₀) = RingHom.ker ev₀ := by
    intro g φ_cat hφ_map hφ_C hev_φ hpb_g
    let t : B₀ := φ_cat.hom (MvPolynomial.X 0)
    have ht_zero : ev₀ t = 0 := by
      change (ev₀.comp φ_cat.hom) (MvPolynomial.X 0) = 0
      rw [hev_φ, MvPolynomial.eval_X]
      rfl
    apply le_antisymm
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      exact ht_zero
    · intro b hb
      rw [RingHom.mem_ker] at hb
      let I : Ideal B₀ := Ideal.span ({t} : Set B₀)
      let Q : Type u := B₀ ⧸ I
      let π : B₀ →+* Q := Ideal.Quotient.mk I
      let π_cat : R₀ ⟶ CommRingCat.of Q := CommRingCat.ofHom π
      have hπ_fac : π.comp φ_cat.hom = (π.comp f_k).comp (MvPolynomial.eval 0) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          change π ((φ_cat.hom.comp MvPolynomial.C) c) =
            π (f_k (MvPolynomial.eval (0 : Fin 1 → k) (MvPolynomial.C c)))
          rw [hφ_C, MvPolynomial.eval_C]
        · intro j
          rw [Subsingleton.elim j 0]
          change π t = π (f_k (MvPolynomial.eval (0 : Fin 1 → k) (MvPolynomial.X 0)))
          have hπt : π t = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [hπt, MvPolynomial.eval_X]
          exact (map_zero (π.comp f_k)).symm
      have hπ_fac_cat : φ_cat ≫ π_cat =
          CommRingCat.ofHom (MvPolynomial.eval 0) ≫ CommRingCat.ofHom (π.comp f_k) :=
        CommRingCat.Hom.ext hπ_fac
      let q_W₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Q)) W₀.toScheme :=
        AlgebraicGeometry.Spec.map π_cat ≫ hW₀.isoSpec.inv
      let q_Sk : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Q)) S_k :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π.comp f_k))
      have h_cone : q_W₀ ≫ (W₀.ι ≫ g) = q_Sk ≫ o₁ := by
        dsimp only [q_W₀, q_Sk, A₁, weilGysinAffineSpace, o₁, weilGysinAffineOrigin,
          S_k, R_A, P₁, R₀] at g φ_cat hφ_map ⊢
        rw [CategoryTheory.Category.assoc, ← hφ_map, ← AlgebraicGeometry.Spec.map_comp,
          hπ_fac_cat, AlgebraicGeometry.Spec.map_comp]
      let ℓ_mor : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Q)) S_k :=
        hpb_g.lift q_W₀ q_Sk h_cone
      have hℓ_fst : ℓ_mor ≫ s_W₀ = q_W₀ := hpb_g.lift_fst q_W₀ q_Sk h_cone
      have hℓ_spec : ℓ_mor ≫ AlgebraicGeometry.Spec.map ev₀_cat =
          AlgebraicGeometry.Spec.map π_cat := by
        dsimp only [S_k, R₀] at ev₀_cat hev₀_map ℓ_mor q_W₀ π_cat ⊢
        rw [hev₀_map, ← CategoryTheory.Category.assoc, hℓ_fst]
        dsimp only [q_W₀]
        rw [CategoryTheory.Category.assoc, hW₀.isoSpec.inv_hom_id, CategoryTheory.Category.comp_id]
      have hℓ_cat : ev₀_cat ≫ AlgebraicGeometry.Spec.preimage ℓ_mor = π_cat := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
        exact hℓ_spec
      have hπb : π b = (AlgebraicGeometry.Spec.preimage ℓ_mor).hom (ev₀ b) :=
        RingHom.congr_fun (congrArg CommRingCat.Hom.hom hℓ_cat.symm) b
      rw [hb, map_zero] at hπb
      exact Ideal.Quotient.eq_zero_iff_mem.mp hπb
  have h_ker_1 : Ideal.span ({t₁} : Set B₀) = RingHom.ker ev₀ :=
    h_span_ker g₁ φ₁_cat hφ₁_map hφ₁_C hev_φ₁ hpb_W₀_1
  have h_ker_2 : Ideal.span ({t₂} : Set B₀) = RingHom.ker ev₀ :=
    h_span_ker g₂ φ₂_cat hφ₂_map hφ₂_C hev_φ₂ hpb_W₀_2
  have ht₁_0 : ev₀ t₁ = 0 := by
    rw [← RingHom.mem_ker, ← h_ker_1]
    exact Ideal.subset_span rfl
  have ht₂_mem : t₂ ∈ Ideal.span ({t₁} : Set B₀) := by
    rw [h_ker_1, ← h_ker_2]
    exact Ideal.subset_span rfl
  obtain ⟨u, hu_raw⟩ := Ideal.mem_span_singleton.mp ht₂_mem
  have hu_mul : t₂ = u * t₁ := by rw [hu_raw, mul_comm]
  
  have heu₀ : ev₀ u ≠ 0 := by
    letI : Algebra k B₀ := f_k.toAlgebra
    letI : Algebra P₁ B₀ := φ₂.toAlgebra
    haveI : IsScalarTower k P₁ B₀ :=
      IsScalarTower.of_algebraMap_eq (fun c => (RingHom.congr_fun hφ₂_C c).symm)
    haveI : Algebra.Etale P₁ B₀ := hφ₂_et.toAlgebra
    haveI : Algebra.FormallyEtale P₁ B₀ := inferInstance
    let b_P₁ : Module.Basis (Fin 1) P₁ Ω[P₁⁄k] :=
      KaehlerDifferential.mvPolynomialBasis k (Fin 1)
    let ψ₀ : TensorProduct P₁ B₀ Ω[P₁⁄k] →ₗ[B₀] B₀ :=
      LinearMap.liftBaseChange B₀ ((Algebra.linearMap P₁ B₀).comp (b_P₁.coord 0))
    let e_Ω : TensorProduct P₁ B₀ Ω[P₁⁄k] ≃ₗ[B₀] Ω[B₀⁄k] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k P₁ B₀
    let lam₂ : Ω[B₀⁄k] →ₗ[B₀] B₀ := ψ₀.comp e_Ω.symm.toLinearMap
    have he_X₀ : e_Ω ((1 : B₀) ⊗ₜ[P₁] KaehlerDifferential.D k P₁ (MvPolynomial.X 0)) =
        KaehlerDifferential.D k B₀ t₂ := by
      rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.map_D k k P₁ B₀ (MvPolynomial.X 0)]
      rfl
    have hlam₂_t₂ : lam₂ (KaehlerDifferential.D k B₀ t₂) = 1 := by
      dsimp only [lam₂, ψ₀]
      rw [LinearMap.comp_apply, LinearEquiv.coe_coe, ← he_X₀, e_Ω.symm_apply_apply,
        LinearMap.liftBaseChange_one_tmul, LinearMap.comp_apply, Algebra.linearMap_apply,
        ← KaehlerDifferential.mvPolynomialBasis_apply k (Fin 1) 0,
        Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_same, map_one]
    have h_ev_eq : (1 : k) = ev₀ u * ev₀ (lam₂ (KaehlerDifferential.D k B₀ t₁)) := by
      have h_leib := congrArg (fun x => ev₀ (lam₂ x))
        ((congrArg (KaehlerDifferential.D k B₀) hu_mul).trans
          (Derivation.leibniz (KaehlerDifferential.D k B₀) u t₁))
      rw [hlam₂_t₂] at h_leib
      simp only [map_one, map_add, LinearMap.map_smul, smul_eq_mul, map_mul,
        ht₁_0, zero_mul, mul_zero, zero_add, add_zero] at h_leib
      exact h_leib
    intro h0
    rw [h0, zero_mul] at h_ev_eq
    exact one_ne_zero h_ev_eq
  
  let W'₀ : C_top.Opens := C_top.basicOpen u
  have hle : W'₀ ≤ W₀ := C_top.basicOpen_le u
  have hs_fromSpec : AlgebraicGeometry.Spec.map ev₀_cat ≫ hW₀.fromSpec = s_C_top := by
    dsimp only [S_k, R₀] at ev₀_cat hev₀_map s_W₀ hs_W₀ ⊢
    rw [hev₀_map, ← hW₀.isoSpec_inv_ι, CategoryTheory.Category.assoc,
      hW₀.isoSpec.hom_inv_id_assoc, hs_W₀]
  have hx₀_W'₀ : x₀ ∈ W'₀ := by
    have hx₀_eq : x₀ = hW₀.fromSpec.base ((AlgebraicGeometry.Spec.map ev₀_cat).base pt₀) := by
      dsimp only [x₀]
      rw [← hs_fromSpec]
      rfl
    rw [hx₀_eq]
    change (AlgebraicGeometry.Spec.map ev₀_cat).base pt₀ ∈
      (TopologicalSpace.Opens.map hW₀.fromSpec.base).obj (C_top.basicOpen u)
    rw [hW₀.fromSpec_preimage_basicOpen u]
    change u ∉ ((AlgebraicGeometry.Spec.map ev₀_cat).base pt₀).asIdeal
    intro hu_mem
    have hev_mem : ev₀ u ∈ pt₀.asIdeal := hu_mem
    exact heu₀ ((hSk_ideal_zero pt₀ (ev₀ u)).mp hev_mem)
  obtain ⟨s'₀, hs'₀_eq, hpb'_1, hpb'_2⟩ := hLiftOpen W'₀ hx₀_W'₀
  have hs'₀_cl : AlgebraicGeometry.IsClosedImmersion s'₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb'_1.flip ho₁_cl
  
  let U'₀ : (W'₀.toScheme).Opens :=
    ⟨(Set.range s'₀.base)ᶜ, s'₀.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hU'₀ : (U'₀ : Set ↥W'₀.toScheme) = (Set.range s'₀.base)ᶜ := rfl
  have hev₀_surj : Function.Surjective ev₀ :=
    fun c => ⟨f_k c, RingHom.congr_fun hev_fk c⟩
  have hker_max : (RingHom.ker ev₀).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective ev₀ hev₀_surj
  have h_punct_range : ∀ (g : Quiver.Hom C_top A₁) (φ_cat : R_A ⟶ R₀),
      AlgebraicGeometry.Spec.map φ_cat = hW₀.isoSpec.inv ≫ W₀.ι ≫ g →
      Ideal.span ({φ_cat.hom (MvPolynomial.X 0)} : Set B₀) = RingHom.ker ev₀ →
      Set.range (CategoryTheory.CategoryStruct.comp U'₀.ι
        (CategoryTheory.CategoryStruct.comp W'₀.ι g)).base ⊆ (Set.range o₁.base)ᶜ := by
    intro g φ_cat hφ_map h_ker
    rintro _ ⟨y, rfl⟩ ⟨q, hq⟩
    have hy_mem : U'₀.ι.base y ∈ (U'₀ : Set ↥W'₀.toScheme) := by
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U'₀]
      exact ⟨y, rfl⟩
    rw [hU'₀, Set.mem_compl_iff] at hy_mem
    let w : ↥W₀.toScheme := (C_top.homOfLE hle).base (U'₀.ι.base y)
    let p_spec : PrimeSpectrum B₀ := hW₀.isoSpec.hom.base w
    have hw_W₀_ι : W₀.ι.base w = W'₀.ι.base (U'₀.ι.base y) := by
      dsimp only [w]
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, C_top.homOfLE_ι hle]
    have hg_W₀_eq : W₀.ι ≫ g = hW₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_cat := by
      dsimp only [A₁, weilGysinAffineSpace, R_A, P₁, R₀] at g φ_cat hφ_map ⊢
      rw [hφ_map, CategoryTheory.Iso.hom_inv_id_assoc]
    have hp_map : (AlgebraicGeometry.Spec.map φ_cat).base p_spec = o₁.base q := by
      dsimp only [p_spec, A₁, weilGysinAffineSpace, o₁, weilGysinAffineOrigin, R_A, P₁, R₀]
        at g φ_cat hg_W₀_eq hq ⊢
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← hg_W₀_eq]
      change g.base (W₀.ι.base w) = _
      rw [hw_W₀_ι]
      exact hq.symm
    have hX₀_q : MvPolynomial.X (0 : Fin 1) ∈ (o₁.base q).asIdeal := by
      change MvPolynomial.eval (0 : Fin 1 → k) (MvPolynomial.X 0) ∈ q.asIdeal
      rw [MvPolynomial.eval_X]
      exact q.asIdeal.zero_mem
    have ht_mem_p : φ_cat.hom (MvPolynomial.X 0) ∈ p_spec.asIdeal := by
      rw [← hp_map] at hX₀_q
      exact hX₀_q
    have hker_le : RingHom.ker ev₀ ≤ p_spec.asIdeal := by
      rw [← h_ker, Ideal.span_singleton_le_iff_mem]
      exact ht_mem_p
    have hker_eq_p : RingHom.ker ev₀ = p_spec.asIdeal :=
      hker_max.eq_of_le p_spec.isPrime.ne_top hker_le
    have hp_eq_pt₀ : p_spec = (AlgebraicGeometry.Spec.map ev₀_cat).base pt₀ := by
      ext b
      change b ∈ p_spec.asIdeal ↔ ev₀ b ∈ pt₀.asIdeal
      rw [← hker_eq_p, RingHom.mem_ker, hSk_ideal_zero pt₀ (ev₀ b)]
    have hw_eq : w = s_W₀.base pt₀ := by
      have h1 : hW₀.isoSpec.hom.base w = hW₀.isoSpec.hom.base (s_W₀.base pt₀) := by
        change p_spec = (s_W₀ ≫ hW₀.isoSpec.hom).base pt₀
        rw [← hev₀_map]
        exact hp_eq_pt₀
      exact (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hW₀.isoSpec.hom).injective h1
    have hW'₀_eq : W'₀.ι.base (U'₀.ι.base y) = W'₀.ι.base (s'₀.base pt₀) := by
      calc
        W'₀.ι.base (U'₀.ι.base y) = W₀.ι.base w := hw_W₀_ι.symm
        _ = (s_W₀ ≫ W₀.ι).base pt₀ := by rw [hw_eq]; rfl
        _ = s_C_top.base pt₀ := by rw [hs_W₀]
        _ = (s'₀ ≫ W'₀.ι).base pt₀ := by rw [← hs'₀_eq]
        _ = W'₀.ι.base (s'₀.base pt₀) := rfl
    have hy_eq_s'₀ : U'₀.ι.base y = s'₀.base pt₀ :=
      W'₀.ι.isOpenEmbedding.injective hW'₀_eq
    exact hy_mem ⟨pt₀, hy_eq_s'₀.symm⟩
  have hrange_1 := h_punct_range g₁ φ₁_cat hφ₁_map h_ker_1
  have hrange_2 := h_punct_range g₂ φ₂_cat hφ₂_map h_ker_2
  
  let res_map := C_top.presheaf.map (CategoryTheory.homOfLE hle).op
  have hu_res : IsUnit (res_map.hom u) := C_top.toRingedSpace.isUnit_res_basicOpen u
  have hu_top : IsUnit (W'₀.topIso.inv.hom (res_map.hom u)) := hu_res.map W'₀.topIso.inv.hom
  let u_rat : Units ↑(W'₀.toScheme.presheaf.obj (Opposite.op ⊤)) := hu_top.unit
  have h_top_res : W₀.topIso.inv ≫ (C_top.homOfLE hle).appTop = res_map ≫ W'₀.topIso.inv := by
    rw [CategoryTheory.Iso.inv_comp_eq, ← CategoryTheory.Category.assoc,
      CategoryTheory.Iso.eq_comp_inv]
    erw [AlgebraicGeometry.Scheme.homOfLE_appTop, AlgebraicGeometry.Scheme.Opens.topIso_hom,
      AlgebraicGeometry.Scheme.Opens.topIso_hom, ← C_top.presheaf.map_comp,
      ← C_top.presheaf.map_comp]
    congr 1
  have hsec_W'₀ : ∀ (g : Quiver.Hom C_top A₁) (t : B₀),
      (CategoryTheory.CategoryStruct.comp W₀.ι g).appTop.hom X₀_sec = W₀.topIso.inv.hom t →
      (CategoryTheory.CategoryStruct.comp W'₀.ι g).appTop.hom X₀_sec =
        W'₀.topIso.inv.hom (res_map.hom t) := by
    intro g t hsec_g
    have hcomp_g : CategoryTheory.CategoryStruct.comp W'₀.ι g =
        C_top.homOfLE hle ≫ (CategoryTheory.CategoryStruct.comp W₀.ι g) := by
      rw [← CategoryTheory.Category.assoc, C_top.homOfLE_ι hle]
    rw [hcomp_g, AlgebraicGeometry.Scheme.Hom.comp_appTop]
    change (C_top.homOfLE hle).appTop.hom ((W₀.ι ≫ g).appTop.hom X₀_sec) = _
    rw [hsec_g]
    change (W₀.topIso.inv ≫ (C_top.homOfLE hle).appTop).hom t = _
    rw [h_top_res]
    rfl
  have hsec_W'₀_1 : (CategoryTheory.CategoryStruct.comp W'₀.ι g₁).appTop.hom X₀_sec =
      W'₀.topIso.inv.hom (res_map.hom t₁) :=
    hsec_W'₀ g₁ t₁ hsec_W₀_1
  have hsec_W'₀_2 : (CategoryTheory.CategoryStruct.comp W'₀.ι g₂).appTop.hom X₀_sec =
      W'₀.topIso.inv.hom (res_map.hom t₂) :=
    hsec_W'₀ g₂ t₂ hsec_W₀_2
  have h_unit_eq : (CategoryTheory.CategoryStruct.comp W'₀.ι g₂).appTop.hom X₀_sec =
      (u_rat : ↑(W'₀.toScheme.presheaf.obj (Opposite.op ⊤))) *
        (CategoryTheory.CategoryStruct.comp W'₀.ι g₁).appTop.hom X₀_sec := by
    rw [hsec_W'₀_2, hsec_W'₀_1, hu_mul, map_mul, map_mul]
    rfl
  exact ⟨W'₀, s'₀, U'₀, u_rat, hs'₀_eq, hs'₀_cl, hU'₀, hpb'_1, hpb'_2,
    hrange_1, hrange_2, h_unit_eq⟩

theorem weil_gysin_dim_zero_and_a1_kummer_origin_tower (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    [AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left]
    (hP1Gm :
      (∀ x : (weilEtaleGmSheaf (weilProjectiveSpaceOver k 1).left).H 0,
        ∃ y : (weilEtaleGmSheaf (weilProjectiveSpaceOver k 1).left).H 0, ℓ • y = x) ∧
      Nonempty ((weilEtaleGmSheaf (weilProjectiveSpaceOver k 1).left).H 1 ≃+
        weilCurveClGroup (weilProjectiveSpaceOver k 1).left) ∧
      (∀ q : ℕ, 2 ≤ q → Subsingleton ((weilEtaleGmSheaf (weilProjectiveSpaceOver k 1).left).H q))) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let A₁ := weilGysinAffineSpace k 1
    let o₁ := weilGysinAffineOrigin k 1
    (∃ e₀ : ∀ r : ℕ, weilEtaleTorsionH S_k (ℓ ^ r) 0 ≃+ ZMod (ℓ ^ r),
      (∀ (r : ℕ) (u : weilEtaleTorsionH S_k (ℓ ^ (r + 1)) 0),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (e₀ (r + 1) u) =
          e₀ r (weilEtaleTorsionTransition S_k ℓ r 0 u)) ∧
      (∀ (r : ℕ) (θ₀ : weilEtaleModuleH S_k (ℓ ^ r) 0 →+ weilEtaleTorsionH S_k (ℓ ^ r) 0),
        WeilIsModuleToTorsionComparison S_k (ℓ ^ r) 0 θ₀ →
        e₀ r (θ₀ (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S_k (ℓ ^ r))))) = 1)) ∧
    (∃ τ₁_ab : ∀ r : ℕ, WeilGysinAbSupportClass S_k A₁ o₁ (ℓ ^ r) 2,
      (∀ r : ℕ, ∃ e₁ : weilGysinAbSupportExtGroup (τ₁_ab r) ≃+ ZMod (ℓ ^ r),
        e₁ (τ₁_ab r).val = 1) ∧
      (∀ r : ℕ, weilGysinAbSupportTransition ℓ r 2 (τ₁_ab (r + 1)) = τ₁_ab r) ∧
      (∀ (C : AlgebraicGeometry.Scheme.{u}) (p_C : Quiver.Hom C S_k)
          [AlgebraicGeometry.IsSeparated p_C]
          (s_C : Quiver.Hom S_k C),
        CategoryTheory.CategoryStruct.comp s_C p_C = CategoryTheory.CategoryStruct.id S_k →
        ∀ (s_C_top : Quiver.Hom S_k (⊤ : C.Opens).toScheme)
          (g₁ g₂ : Quiver.Hom (⊤ : C.Opens).toScheme A₁),
          WeilGysinIsEtaleOriginChart 1 p_C s_C ⊤ s_C_top g₁ →
          WeilGysinIsEtaleOriginChart 1 p_C s_C ⊤ s_C_top g₂ →
          ∀ (r : ℕ) (α₁ α₂ : WeilGysinAbSupportClass S_k (⊤ : C.Opens).toScheme s_C_top (ℓ ^ r) 2),
            WeilGysinAbSupportPullback g₁ s_C_top o₁ (ℓ ^ r) 2 α₁ (τ₁_ab r) →
            WeilGysinAbSupportPullback g₂ s_C_top o₁ (ℓ ^ r) 2 α₂ (τ₁_ab r) →
            α₁ = α₂)) :=
by
  classical
  have _ := @hP1Gm
  intro S_k A₁ o₁
  have hAbSuppExt : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (a₁ a₂ : WeilGysinAbSupportClass Z Y i m q), a₁.val = a₂.val → a₁ = a₂ := by
    rintro Z Y i m q ⟨_, v₁⟩ ⟨_, v₂⟩ hv
    subst hv
    rfl
  obtain ⟨hEtPull, -, -, -, -⟩ := weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨hDim0, δ, hδ_props, ⟨hPb_uniq, hPb_comp, hPb_cart⟩, hExc⟩ :=
    weil_gysin_ab_support_boundary_and_dim_zero_norm.{u} ℓ (@hEtPull)
  obtain ⟨κ, hκ⟩ :=
    weil_gysin_kummer_prime_power_short_exact_and_connecting_class.{u} k ℓ hℓ
  obtain ⟨U₀, p_G₁, u_X₀, ord₀,
      ⟨ho₁_cl, hU₀_compl, hp_G₁⟩,
      ⟨hA₁_H1, hA₁_H2, hA₁_div⟩,
      ⟨hG₁_H1, hord₀_u, hG₁_div⟩,
      hu_X₀_map⟩ :=
    weil_gysin_a1_and_punctured_line_gm_and_laurent_units.{u} k
  let τ₁_ab : ∀ r : ℕ, WeilGysinAbSupportClass S_k A₁ o₁ (ℓ ^ r) 2 :=
    fun r => δ o₁ U₀ ho₁_cl hU₀_compl (ℓ ^ r) (κ p_G₁ r (Additive.ofMul u_X₀))
  refine ⟨hDim0 k, ⟨τ₁_ab, ?_, ?_, ?_⟩⟩
  · intro r
    have hm_pos : 1 ≤ ℓ ^ r := Nat.one_le_pow r ℓ (Fact.out : Nat.Prime ℓ).pos
    have : NeZero (ℓ ^ r) := ⟨by omega⟩
    obtain ⟨hTorsA₁_1, hTorsA₁_2⟩ :=
      (hκ (weilGysinAffineStruct k 1)).2.1 r (hA₁_div (ℓ ^ r) hm_pos) hA₁_H1 hA₁_H2
    have hδ_add := (hδ_props o₁ U₀ ho₁_cl hU₀_compl).1 (ℓ ^ r)
    have hδ_bij := (hδ_props o₁ U₀ ho₁_cl hU₀_compl).2.2.1 (ℓ ^ r) hTorsA₁_1 hTorsA₁_2
    have hValEq : ∀ (a b : WeilGysinAbSupportClass S_k A₁ o₁ (ℓ ^ r) 2),
        a = b → a.val = b.val := by
      rintro a _ rfl
      rfl
    let δ_val_hom : weilEtaleTorsionH U₀.toScheme (ℓ ^ r) 1 →+
        weilGysinAbSupportExtGroup (τ₁_ab r) :=
      { toFun := fun ξ => (δ o₁ U₀ ho₁_cl hU₀_compl (ℓ ^ r) ξ).val
        map_zero' := (hδ_add 0 0).1
        map_add' := fun ξ₁ ξ₂ => (hδ_add ξ₁ ξ₂).2 }
    have hδ_val_bij : Function.Bijective δ_val_hom := by
      refine ⟨?_, ?_⟩
      · intro ξ₁ ξ₂ h
        exact hδ_bij.1 (hAbSuppExt _ _ h)
      · intro v
        obtain ⟨ξ, hξ⟩ := hδ_bij.2 ⟨(τ₁_ab r).hCont, v⟩
        exact ⟨ξ, hValEq _ _ hξ⟩
    let e_δ : weilEtaleTorsionH U₀.toScheme (ℓ ^ r) 1 ≃+
        weilGysinAbSupportExtGroup (τ₁_ab r) :=
      AddEquiv.ofBijective δ_val_hom hδ_val_bij
    let A_G₁ := Additive (Units ↑(U₀.toScheme.presheaf.obj (Opposite.op ⊤)))
    let π_r : A_G₁ →+ ZMod (ℓ ^ r) := (Int.castAddHom (ZMod (ℓ ^ r))).comp ord₀
    let x₀ : A_G₁ := Additive.ofMul u_X₀
    let g₀ : weilEtaleTorsionH U₀.toScheme (ℓ ^ r) 1 := κ p_G₁ r x₀
    have hπ_x₀ : π_r x₀ = 1 := by
      change ((ord₀ x₀ : ℤ) : ZMod (ℓ ^ r)) = 1
      rw [hord₀_u, Int.cast_one]
    have hker_iff : ∀ x : A_G₁, κ p_G₁ r x = 0 ↔ π_r x = 0 := by
      intro x
      rw [((hκ p_G₁).1 r).1 x, hG₁_div (ℓ ^ r) hm_pos x, ← ZMod.intCast_zmod_eq_zero_iff_dvd]
      rfl
    have hκ_eq_nsmul : ∀ x : A_G₁, κ p_G₁ r x = (π_r x).val • g₀ := by
      intro x
      have hsub_π : π_r (x - (π_r x).val • x₀) = 0 := by
        rw [map_sub, map_nsmul, hπ_x₀, nsmul_one, ZMod.natCast_zmod_val, sub_self]
      have hsub_κ : κ p_G₁ r (x - (π_r x).val • x₀) = 0 := (hker_iff _).mpr hsub_π
      rw [map_sub, map_nsmul] at hsub_κ
      exact sub_eq_zero.mp hsub_κ
    let φ_hom : ZMod (ℓ ^ r) →+ weilEtaleTorsionH U₀.toScheme (ℓ ^ r) 1 :=
      { toFun := fun z => z.val • g₀
        map_zero' := by
          change (0 : ZMod (ℓ ^ r)).val • g₀ = 0
          rw [ZMod.val_zero, zero_nsmul]
        map_add' := fun z₁ z₂ => by
          let y₁ : A_G₁ := z₁.val • x₀
          let y₂ : A_G₁ := z₂.val • x₀
          have hy₁ : π_r y₁ = z₁ := by
            dsimp [y₁]
            rw [map_nsmul, hπ_x₀, nsmul_one, ZMod.natCast_zmod_val]
          have hy₂ : π_r y₂ = z₂ := by
            dsimp [y₂]
            rw [map_nsmul, hπ_x₀, nsmul_one, ZMod.natCast_zmod_val]
          have hy12 : π_r (y₁ + y₂) = z₁ + z₂ := by rw [map_add, hy₁, hy₂]
          calc
            (z₁ + z₂).val • g₀ = (π_r (y₁ + y₂)).val • g₀ := by rw [hy12]
            _ = κ p_G₁ r (y₁ + y₂) := (hκ_eq_nsmul (y₁ + y₂)).symm
            _ = κ p_G₁ r y₁ + κ p_G₁ r y₂ := map_add _ y₁ y₂
            _ = z₁.val • g₀ + z₂.val • g₀ := by
              dsimp [y₁, y₂, g₀]
              rw [map_nsmul, map_nsmul] }
    have hφ_inj : Function.Injective φ_hom := by
      intro z₁ z₂ hz
      have h0 : φ_hom (z₁ - z₂) = 0 := by rw [map_sub, hz, sub_self]
      have h0' : (z₁ - z₂).val • g₀ = 0 := h0
      have hκz : κ p_G₁ r ((z₁ - z₂).val • x₀) = 0 := by
        dsimp only [g₀] at h0'
        rw [map_nsmul]
        exact h0'
      have hπz : π_r ((z₁ - z₂).val • x₀) = 0 := (hker_iff _).mp hκz
      rw [map_nsmul, hπ_x₀, nsmul_one, ZMod.natCast_zmod_val] at hπz
      exact sub_eq_zero.mp hπz
    have hφ_surj : Function.Surjective φ_hom := by
      intro h
      obtain ⟨x, hx⟩ := ((hκ p_G₁).1 r).2 hG₁_H1 h
      refine ⟨π_r x, ?_⟩
      change (π_r x).val • g₀ = h
      rw [← hκ_eq_nsmul x, hx]
    let e_φ : ZMod (ℓ ^ r) ≃+ weilEtaleTorsionH U₀.toScheme (ℓ ^ r) 1 :=
      AddEquiv.ofBijective φ_hom ⟨hφ_inj, hφ_surj⟩
    have he_φ_one : e_φ 1 = g₀ := by
      change (1 : ZMod (ℓ ^ r)).val • g₀ = g₀
      rw [← hπ_x₀, ← hκ_eq_nsmul x₀]
    refine ⟨e_δ.symm.trans e_φ.symm, ?_⟩
    have he_δ_g₀ : e_δ g₀ = (τ₁_ab r).val := rfl
    change e_φ.symm (e_δ.symm (e_δ g₀)) = 1
    rw [e_δ.symm_apply_apply, ← he_φ_one, e_φ.symm_apply_apply]
  · intro r
    change weilGysinAbSupportTransition ℓ r 2
        (δ o₁ U₀ ho₁_cl hU₀_compl (ℓ ^ (r + 1)) (κ p_G₁ (r + 1) (Additive.ofMul u_X₀))) =
      δ o₁ U₀ ho₁_cl hU₀_compl (ℓ ^ r) (κ p_G₁ r (Additive.ofMul u_X₀))
    rw [(hδ_props o₁ U₀ ho₁_cl hU₀_compl).2.2.2 r (κ p_G₁ (r + 1) (Additive.ofMul u_X₀)),
      (hκ p_G₁).2.2.1 r (Additive.ofMul u_X₀)]
  · intro C p_C _ s_C hs_C s_C_top g₁ g₂ hg₁ hg₂ r α₁ α₂ hab₁ hab₂
    let X₀_sec : ↑(A₁.presheaf.obj (Opposite.op ⊤)) :=
