by
  classical
  
  have h1DFinSurj : ∀ {X Z : AlgebraicGeometry.Scheme.{u}}
      [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral Z],
      topologicalKrullDim X = (1 : WithBot ℕ∞) →
      topologicalKrullDim Z = (1 : WithBot ℕ∞) →
      ∀ (f : X ⟶ Z) [AlgebraicGeometry.IsFinite f],
        AlgebraicGeometry.Surjective f := by
    intro X Z _ _ hDimX hDimZ f _
    have : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    have : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
    have hDenseOpen : ∀ {Y : Type u} [TopologicalSpace Y] [IrreducibleSpace Y]
