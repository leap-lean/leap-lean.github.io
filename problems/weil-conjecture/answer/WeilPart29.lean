        let R_gen : CategoryTheory.Sieve E' :=
          CategoryTheory.Sieve.ofArrows (fun (_ : T_Ω ⟶ E) => T_Ω) id
        change R_gen ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S_Ω) E'
        rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology,
