      exact IsLocalization.Away.algebraMap_isUnit (S := R_U₀) X₀_sec
    let u_X₀ : Units ↑(U₀.toScheme.presheaf.obj (Opposite.op ⊤)) := h_unit_top.unit
    have hu_X₀_val :
        (u_X₀ : ↑(U₀.toScheme.presheaf.obj (Opposite.op ⊤))) = U₀.ι.appTop.hom X₀_sec :=
