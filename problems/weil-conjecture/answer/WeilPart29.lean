          _ = res_B (g' * x) := by rw [← hc_span']
          _ = res_B g' * (z * res_B (g' ^ n)) := by rw [map_mul, ← hsec_z]
          _ = (u_BV : B_V) * z := by
              rw [hu_BV_val, pow_succ', map_mul, mul_comm z (res_B (g' ^ n)), mul_assoc]
    let e_equiv : M ≃+ B_V := AddEquiv.ofBijective e₀ he₀_bij
    refine ⟨V, hyV, hV_aff, hV'_aff, M, inferInstance, inferInstance, e_equiv, ?_,
      ⟨Pi.basisFun A_V (Fin d)⟩⟩
    intro b m
    change ∑ i : Fin d, φ_V (b * m i) * res_B (v i) =
      φ_V b * ∑ i : Fin d, φ_V (m i) * res_B (v i)
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => by rw [map_mul, mul_assoc])

  
  have hDedAtlas_N : ∀ q : ↥P.left, ∃ W : P.left.Opens,
      q ∈ W ∧
      AlgebraicGeometry.IsAffineOpen W ∧
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map u_bar.base).obj W) ∧
      IsDedekindDomain
        ↑(N.left.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map u_bar.base).obj W))) := by
    intro q
    obtain ⟨W, hqW, hW, hDedW⟩ := hDedCover q
    haveI : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨q, hqW⟩⟩
    obtain ⟨hW', _, _, hDed_BW, _, _, _⟩ := hChart_norm W hW hDedW
    exact ⟨W, hqW, hW, hW', hDed_BW⟩

  exact ⟨N, j_N, d, u_bar, hInt_Y, hProp_N, hSmooth_N, hd_ge_one, rfl,
    hFin_ubar, hSurj_ubar, hOpen_jN, hjN_ubar, hFLF, hDedAtlas_N⟩

theorem weil_normal_proper_curve_birational_isIso_over_dedekind_target (Ω : Type u) [Field Ω]
    (hBiratOpen : ∀ (B₁ B K : Type u) [CommRing B₁] [IsDedekindDomain B₁]
      [CommRing B] [IsDomain B] [Field K]
      [Algebra B₁ K] [IsFractionRing B₁ K]
      [Algebra B K] [IsFractionRing B K]
      [Algebra B₁ B] [Algebra.FiniteType B₁ B]
      [IsScalarTower B₁ B K],
      AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₁ B))))
    (P X N : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsProper P.hom]
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    (hIntN : AlgebraicGeometry.IsIntegral N.left)
    [AlgebraicGeometry.IsProper N.hom]
    (π_tilde : Quiver.Hom X.left P.left)
    (hπ_hom : CategoryTheory.CategoryStruct.comp π_tilde P.hom = X.hom)
    (u_bar : Quiver.Hom N.left P.left)
    (hu_hom : CategoryTheory.CategoryStruct.comp u_bar P.hom = N.hom)
    [AlgebraicGeometry.IsFinite u_bar]
    [AlgebraicGeometry.Surjective u_bar]
    (hNormX : ∀ x : ↥X.left, ∃ U : X.left.Opens,
      x ∈ U ∧
      AlgebraicGeometry.IsAffineOpen U ∧
      IsIntegrallyClosed ↑(X.left.presheaf.obj (Opposite.op U)))
    (hDedN : ∀ q : ↥P.left, ∃ W : P.left.Opens,
      q ∈ W ∧
      AlgebraicGeometry.IsAffineOpen W ∧
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map u_bar.base).obj W) ∧
      IsDedekindDomain ↑(N.left.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map u_bar.base).obj W))))
    (W₀ : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥W₀]
    (j_X : Quiver.Hom W₀ X.left) [AlgebraicGeometry.IsOpenImmersion j_X]
    (j_N : Quiver.Hom W₀ N.left) [AlgebraicGeometry.IsOpenImmersion j_N]
    (hOpenComm : CategoryTheory.CategoryStruct.comp j_X π_tilde =
      CategoryTheory.CategoryStruct.comp j_N u_bar) :
    ∃ ψ : Quiver.Hom X.left N.left,
      CategoryTheory.IsIso ψ ∧
      CategoryTheory.CategoryStruct.comp ψ u_bar = π_tilde ∧
      CategoryTheory.CategoryStruct.comp ψ N.hom = X.hom ∧
      (AlgebraicGeometry.SmoothOfRelativeDimension 1 N.hom →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 X.hom) ∧
      (∀ d : ℕ, WeilTopDegFiniteLocallyFreeOfRank d u_bar →
        WeilTopDegFiniteLocallyFreeOfRank d π_tilde) :=
by
  classical
  have : AlgebraicGeometry.IsIntegral X.left := hIntX
  have : AlgebraicGeometry.IsIntegral N.left := hIntN
  have : AlgebraicGeometry.IsIntegral W₀ :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion j_X

  
  let x₀ : ↥W₀ := genericPoint ↥W₀
  let K₀_cat : CommRingCat.{u} := W₀.presheaf.stalk x₀
  let K₀ : Type u := ↑K₀_cat
  let : Field K₀ := (inferInstance : Field ↑W₀.functionField)
  let S_K : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K₀)
  let pt₀ : ↥S_K := IsLocalRing.closedPoint K₀
  have : Nonempty ↥S_K := ⟨pt₀⟩
  let η₀ : S_K ⟶ W₀ := W₀.fromSpecStalk x₀
  let η_X : S_K ⟶ X.left := η₀ ≫ j_X
  let η_N : S_K ⟶ N.left := η₀ ≫ j_N

  have hη_comm : η_X ≫ π_tilde = η_N ≫ u_bar := by
    dsimp only [η_X, η_N]
    rw [Category.assoc, hOpenComm, ← Category.assoc]

  have hGenMemOpen : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
      {G : Set ↥Z}, IsOpen G → G.Nonempty → genericPoint ↥Z ∈ G := by
    intro Z _ G hG ⟨z, hz⟩
    have hz_cl : z ∈ closure ({genericPoint ↥Z} : Set ↥Z) := by
      rw [(genericPoint_spec ↥Z).def]
      trivial
    obtain ⟨_, hmem, rfl⟩ := mem_closure_iff.mp hz_cl G hG hz
    exact hmem

  have hGenMap : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
      (j : W₀ ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j],
      j.base x₀ = genericPoint ↥Z := by
    intro Z _ j _
    have hGen : IsGenericPoint (j.base x₀) (Set.univ : Set ↥Z) := by
      rw [isGenericPoint_def]
      apply Set.eq_univ_of_forall
      intro z
      rw [mem_closure_iff]
      intro G hG hzG
      obtain ⟨w_init⟩ : Nonempty ↥W₀ := inferInstance
      have hRangeOpen : IsOpen (Set.range j.base) := j.opensRange.isOpen
      have hGNe : (Set.univ ∩ G).Nonempty := ⟨z, trivial, hzG⟩
      have hRangeNe : (Set.univ ∩ Set.range j.base).Nonempty :=
        ⟨j.base w_init, trivial, w_init, rfl⟩
      obtain ⟨_, -, hw₁G, w₁, rfl⟩ :=
        (PreirreducibleSpace.isPreirreducible_univ (X := ↥Z)) G (Set.range j.base)
          hG hRangeOpen hGNe hRangeNe
      have hPreOpen : IsOpen (j.base ⁻¹' G) :=
        ((TopologicalSpace.Opens.map j.base).obj ⟨G, hG⟩).isOpen
      have hx₀_pre : x₀ ∈ j.base ⁻¹' G := hGenMemOpen W₀ hPreOpen ⟨w₁, hw₁G⟩
      exact ⟨j.base x₀, hx₀_pre, rfl⟩
    exact hGen.eq (genericPoint_spec ↥Z)

  have hjX_gen : j_X.base x₀ = genericPoint ↥X.left := hGenMap X.left j_X
  have hjN_gen : j_N.base x₀ = genericPoint ↥N.left := hGenMap N.left j_N

  have hη₀_pt : ∀ pt : ↥S_K, η₀.base pt = x₀ := by
    intro pt
    rw [Subsingleton.elim pt pt₀]
    exact AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint

  have hGenX : ∀ pt : ↥S_K, η_X.base pt = genericPoint ↥X.left := by
    intro pt
    change j_X.base (η₀.base pt) = genericPoint ↥X.left
    rw [hη₀_pt pt, hjX_gen]

  have hGenN : ∀ pt : ↥S_K, η_N.base pt = genericPoint ↥N.left := by
    intro pt
    change j_N.base (η₀.base pt) = genericPoint ↥N.left
    rw [hη₀_pt pt, hjN_gen]

  have hDomX : AlgebraicGeometry.IsDominant η_X := by
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
    apply Set.eq_univ_of_forall
    intro z
    rw [mem_closure_iff]
    intro G hG hzG
    exact ⟨genericPoint ↥X.left, hGenMemOpen X.left hG ⟨z, hzG⟩, pt₀, hGenX pt₀⟩
  have : AlgebraicGeometry.IsDominant η_X := hDomX

  have hDomN : AlgebraicGeometry.IsDominant η_N := by
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
    apply Set.eq_univ_of_forall
    intro z
    rw [mem_closure_iff]
    intro G hG hzG
    exact ⟨genericPoint ↥N.left, hGenMemOpen N.left hG ⟨z, hzG⟩, pt₀, hGenN pt₀⟩
  have : AlgebraicGeometry.IsDominant η_N := hDomN

  have hFracMap : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
      (j : W₀ ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j]
      (hj_gen : j.base x₀ = genericPoint ↥Z)
      (U : Z.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) [Nonempty ↥U.toScheme]
      (he : (⊤ : S_K.Opens) ≤ (TopologicalSpace.Opens.map (η₀ ≫ j).base).obj U),
      @IsFractionRing ↑(Z.presheaf.obj (Opposite.op U)) _ K₀ _
        (CommRingCat.Hom.hom (((η₀ ≫ j).appLE U ⊤ he) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₀)).hom)).toAlgebra := by
    intro Z _ j _ hj_gen U hU hNeU he
    have ⟨u₀, hu₀⟩ := hNeU
    have : Nonempty ↥U.toScheme := hNeU
    have hgen_U : genericPoint ↥Z ∈ U := hGenMemOpen Z U.isOpen ⟨u₀, hu₀⟩
    let V₀ : W₀.Opens := (TopologicalSpace.Opens.map j.base).obj U
    have hx₀_V₀ : x₀ ∈ V₀ := by
      show j.base x₀ ∈ U
      rw [hj_gen]
      exact hgen_U
    have he₀ : (⊤ : S_K.Opens) ≤ (TopologicalSpace.Opens.map η₀.base).obj V₀ := he
    have hη₀_appLE : η₀.appLE V₀ ⊤ he₀ ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₀)).hom =
        W₀.presheaf.germ V₀ x₀ hx₀_V₀ := by
      have happ : η₀.appLE V₀ ⊤ he₀ =
          η₀.app V₀ ≫ S_K.presheaf.map (CategoryTheory.homOfLE he₀).op := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      let SpecK := AlgebraicGeometry.Spec (W₀.presheaf.stalk x₀)
      have hmap_id : SpecK.presheaf.map (CategoryTheory.homOfLE
            (le_top : (TopologicalSpace.Opens.map η₀.base).obj V₀ ≤ ⊤)).op ≫
          SpecK.presheaf.map (CategoryTheory.homOfLE he₀).op = 𝟙 _ := by
        rw [← SpecK.presheaf.map_comp]
        have h_op : (CategoryTheory.homOfLE
              (le_top : (TopologicalSpace.Opens.map η₀.base).obj V₀ ≤ ⊤)).op ≫
            (CategoryTheory.homOfLE he₀).op = 𝟙 (Opposite.op (⊤ : SpecK.Opens)) :=
          Subsingleton.elim _ _
        rw [h_op, SpecK.presheaf.map_id]
      rw [happ, AlgebraicGeometry.Scheme.fromSpecStalk_app hx₀_V₀]
      change W₀.presheaf.germ V₀ x₀ hx₀_V₀ ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (W₀.presheaf.stalk x₀)).inv ≫
          (SpecK.presheaf.map (CategoryTheory.homOfLE
            (le_top : (TopologicalSpace.Opens.map η₀.base).obj V₀ ≤ ⊤)).op ≫
            SpecK.presheaf.map (CategoryTheory.homOfLE he₀).op) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (W₀.presheaf.stalk x₀)).hom = _
      dsimp only [SpecK] at hmap_id ⊢
      rw [hmap_id, Category.id_comp, Iso.inv_hom_id, Category.comp_id]
    have hj_germ : j.app U ≫ W₀.presheaf.germ V₀ x₀ hx₀_V₀ =
        Z.presheaf.germ U (j.base x₀) hx₀_V₀ ≫ j.stalkMap x₀ := by
      ext s
      exact (j.germ_stalkMap_apply U x₀ hx₀_V₀ s).symm
    let h_spec : j.base x₀ ⤳ genericPoint ↥Z := specializes_of_eq hj_gen
    let h_spec_inv : genericPoint ↥Z ⤳ j.base x₀ := specializes_of_eq hj_gen.symm
    let e_spec : Z.functionField ≅ Z.presheaf.stalk (j.base x₀) :=
      { hom := Z.presheaf.stalkSpecializes h_spec
        inv := Z.presheaf.stalkSpecializes h_spec_inv
        hom_inv_id := by
          rw [TopCat.Presheaf.stalkSpecializes_comp, TopCat.Presheaf.stalkSpecializes_refl]
        inv_hom_id := by
          rw [TopCat.Presheaf.stalkSpecializes_comp, TopCat.Presheaf.stalkSpecializes_refl] }
    let e_KZ : Z.functionField ≅ K₀_cat := e_spec ≪≫ asIso (j.stalkMap x₀)
    have hcomp_eq : ((η₀ ≫ j).appLE U ⊤ he) ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₀)).hom =
        Z.germToFunctionField U ≫ e_KZ.hom := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_appLE, Category.assoc, hη₀_appLE, hj_germ]
      have hspec_germ : Z.presheaf.germ U (j.base x₀) hx₀_V₀ =
          Z.germToFunctionField U ≫ e_spec.hom :=
        (Z.presheaf.germ_stalkSpecializes hgen_U h_spec).symm
      rw [hspec_germ, Category.assoc]
      rfl
    let A_U : Type u := ↑(Z.presheaf.obj (Opposite.op U))
    have : IsFractionRing A_U ↑Z.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z U hU
    let κ_U := (((η₀ ≫ j).appLE U ⊤ he) ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₀)).hom).hom
    let : Algebra A_U K₀ := κ_U.toAlgebra
    let e_alg : ↑Z.functionField ≃ₐ[A_U] K₀ :=
      { e_KZ.commRingCatIsoToRingEquiv with
        commutes' := fun a => by
          change e_KZ.hom.hom ((Z.germToFunctionField U).hom a) = κ_U a
          change (Z.germToFunctionField U ≫ e_KZ.hom).hom a = _
          rw [← hcomp_eq] }
    exact IsLocalization.isLocalization_of_algEquiv (nonZeroDivisors A_U) e_alg

  
  have hAppLE_congr : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {g₁ g₂ : S_K ⟶ Y} (h : g₁ = g₂) (W : Y.Opens)
      (e₁ : (⊤ : S_K.Opens) ≤ (TopologicalSpace.Opens.map g₁.base).obj W)
      (e₂ : (⊤ : S_K.Opens) ≤ (TopologicalSpace.Opens.map g₂.base).obj W),
      g₁.appLE W ⊤ e₁ = g₂.appLE W ⊤ e₂ := by
    rintro _ _ _ rfl _ _ _
    rfl

  have hCov : ∀ x : ↥X.left, ∃ (U : X.left.Opens) (_ : x ∈ U)
      (f : U.toScheme ⟶ N.left) (η_U : S_K ⟶ U.toScheme),
      AlgebraicGeometry.IsOpenImmersion f ∧
      f ≫ u_bar = U.ι ≫ π_tilde ∧
      η_U ≫ U.ι = η_X ∧
      η_U ≫ f = η_N := by
    intro x
    obtain ⟨W_x, hqW, hAffW, hAffW', hDedW'⟩ := hDedN (π_tilde.base x)
    let W'_x : N.left.Opens := (TopologicalSpace.Opens.map u_bar.base).obj W_x
    obtain ⟨y₀, hy₀⟩ := u_bar.surjective (π_tilde.base x)
    have hy₀_W' : y₀ ∈ W'_x := by
      show u_bar.base y₀ ∈ W_x
      rw [hy₀]
      exact hqW
    have : Nonempty ↥W'_x.toScheme := ⟨⟨y₀, hy₀_W'⟩⟩
    obtain ⟨U₁, hxU₁, hAffU₁, hICU₁⟩ := hNormX x
    have hx_preW : x ∈ (TopologicalSpace.Opens.map π_tilde.base).obj W_x := hqW
    obtain ⟨h_x, hle_W, hxU_raw⟩ :=
      hAffU₁.exists_basicOpen_le
        (V := (TopologicalSpace.Opens.map π_tilde.base).obj W_x) ⟨x, hx_preW⟩ hxU₁
    let U_x : X.left.Opens := X.left.basicOpen h_x
    have hxU : x ∈ U_x := hxU_raw
    have hAffU : AlgebraicGeometry.IsAffineOpen U_x := hAffU₁.basicOpen h_x
    have : Nonempty ↥U_x.toScheme := ⟨⟨x, hxU⟩⟩
    have : Nonempty ↥U₁.toScheme := ⟨⟨x, hxU₁⟩⟩
    let A_U₁ : Type u := ↑(X.left.presheaf.obj (Opposite.op U₁))
    let A_x : Type u := ↑(X.left.presheaf.obj (Opposite.op U_x))
    let B_W : Type u := ↑(N.left.presheaf.obj (Opposite.op W'_x))
    have : IsDomain A_U₁ := AlgebraicGeometry.IsIntegral.component_integral U₁
    have : IsDomain A_x := AlgebraicGeometry.IsIntegral.component_integral U_x
    have : IsDomain B_W := AlgebraicGeometry.IsIntegral.component_integral W'_x
    have : IsIntegrallyClosed A_U₁ := hICU₁
    have : IsDedekindDomain B_W := hDedW'
    have hh_ne : h_x ≠ 0 := by
      intro hh0
      have hx_bot : x ∈ (⊥ : X.left.Opens) := by
        simpa only [U_x, hh0, X.left.basicOpen_zero] using hxU
      exact hx_bot
    have : IsLocalization.Away h_x A_x := hAffU₁.isLocalization_basicOpen h_x
    have hsub_nzd : Submonoid.powers h_x ≤ nonZeroDivisors A_U₁ :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hh_ne)
    have hIC_Ax : IsIntegrallyClosed A_x :=
      isIntegrallyClosed_of_isLocalization A_x (Submonoid.powers h_x) hsub_nzd

    have hgenX_U : genericPoint ↥X.left ∈ U_x := hGenMemOpen X.left U_x.isOpen ⟨x, hxU⟩
    have hgenN_W' : genericPoint ↥N.left ∈ W'_x := hGenMemOpen N.left W'_x.isOpen ⟨y₀, hy₀_W'⟩
    have he_U : (⊤ : S_K.Opens) ≤ (TopologicalSpace.Opens.map η_X.base).obj U_x := by
      intro pt _
      show η_X.base pt ∈ U_x
      rw [hGenX pt]
      exact hgenX_U
    have he_W' : (⊤ : S_K.Opens) ≤ (TopologicalSpace.Opens.map η_N.base).obj W'_x := by
      intro pt _
      show η_N.base pt ∈ W'_x
      rw [hGenN pt]
      exact hgenN_W'
    have hrange_ηX : Set.range η_X.base ⊆ Set.range U_x.ι.base := by
      rintro _ ⟨pt, rfl⟩
      exact ⟨⟨genericPoint ↥X.left, hgenX_U⟩, (hGenX pt).symm⟩
    let η_U : S_K ⟶ U_x.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U_x.ι η_X hrange_ηX
    have hηU_X : η_U ≫ U_x.ι = η_X :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_x.ι η_X hrange_ηX

    let κ_cat : X.left.presheaf.obj (Opposite.op U_x) ⟶ CommRingCat.of K₀ :=
      η_X.appLE U_x ⊤ he_U ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₀)).hom
    let ι_cat : N.left.presheaf.obj (Opposite.op W'_x) ⟶ CommRingCat.of K₀ :=
      η_N.appLE W'_x ⊤ he_W' ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₀)).hom
    let κ : A_x →+* K₀ := κ_cat.hom
    let ι : B_W →+* K₀ := ι_cat.hom
    have : @IsFractionRing A_x _ K₀ _ κ.toAlgebra :=
      hFracMap X.left j_X hjX_gen U_x hAffU he_U
    have : @IsFractionRing B_W _ K₀ _ ι.toAlgebra :=
      hFracMap N.left j_N hjN_gen W'_x hAffW' he_W'
    have hinj_κ : Function.Injective κ := by
      let : Algebra A_x K₀ := κ.toAlgebra
      exact IsFractionRing.injective A_x K₀

    let f_π_cat := π_tilde.appLE W_x U_x hle_W
    let f_u_cat := u_bar.app W_x
    have hfπ_κ_eq : f_π_cat ≫ κ_cat = f_u_cat ≫ ι_cat := by
      dsimp only [κ_cat, ι_cat, f_π_cat, f_u_cat]
      rw [← Category.assoc, AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        ← Category.assoc, AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
      congr 1
      exact hAppLE_congr hη_comm W_x _ _
    have hcomp_hom : κ.comp f_π_cat.hom = ι.comp f_u_cat.hom := by
      ext a
      exact congrArg (fun φ => φ.hom a) hfπ_κ_eq

    have hf_u_int : f_u_cat.hom.IsIntegral :=
      AlgebraicGeometry.IsIntegralHom.isIntegral_app u_bar W_x hAffW
    have hex_σ : ∀ b : B_W, ∃ a : A_x, κ a = ι b := by
      intro b
      let : Algebra A_x K₀ := κ.toAlgebra
      obtain ⟨Q₀, hQ₀_monic, hQ₀_eval⟩ := hf_u_int b
      have hInt_b : IsIntegral A_x (ι b) := by
        refine ⟨Q₀.map f_π_cat.hom, hQ₀_monic.map f_π_cat.hom, ?_⟩
        change Polynomial.eval₂ κ (ι b) (Q₀.map f_π_cat.hom) = 0
        rw [Polynomial.eval₂_map, hcomp_hom, ← Polynomial.hom_eval₂, hQ₀_eval, map_zero]
      exact (isIntegrallyClosed_iff K₀).mp hIC_Ax hInt_b

    let σ : B_W →+* A_x :=
      { toFun := fun b => (hex_σ b).choose
        map_one' := hinj_κ (by rw [(hex_σ 1).choose_spec, map_one, map_one])
        map_mul' := fun b₁ b₂ => hinj_κ (by
          rw [(hex_σ (b₁ * b₂)).choose_spec, map_mul, map_mul,
            (hex_σ b₁).choose_spec, (hex_σ b₂).choose_spec])
        map_zero' := hinj_κ (by rw [(hex_σ 0).choose_spec, map_zero, map_zero])
        map_add' := fun b₁ b₂ => hinj_κ (by
          rw [(hex_σ (b₁ + b₂)).choose_spec, map_add, map_add,
            (hex_σ b₁).choose_spec, (hex_σ b₂).choose_spec]) }
    have hσ : ∀ b : B_W, κ (σ b) = ι b := fun b => (hex_σ b).choose_spec

    have hσ_appLE : CommRingCat.ofHom σ ≫ η_X.appLE U_x ⊤ he_U = η_N.appLE W'_x ⊤ he_W' := by
      apply (cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₀)).hom).mp
      rw [Category.assoc]
      ext b
      exact hσ b

    have hσ_fu : f_u_cat ≫ CommRingCat.ofHom σ = f_π_cat := by
      ext a
      apply hinj_κ
      change κ (σ (f_u_cat.hom a)) = κ (f_π_cat.hom a)
      rw [hσ]
      exact (congrArg (fun φ : _ →+* K₀ => φ a) hcomp_hom).symm

    let φ_X : CommRingCat.of Ω ⟶ X.left.presheaf.obj (Opposite.op U_x) :=
      AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ X.hom)
    have hφX_spec : AlgebraicGeometry.Spec.map φ_X = hAffU.fromSpec ≫ X.hom :=
      AlgebraicGeometry.Spec.map_preimage (hAffU.fromSpec ≫ X.hom)
    have hLFT_φX : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_X) := by
      rw [hφX_spec]
      infer_instance
    have hφX_ft : RingHom.FiniteType φ_X.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_φX
    let φ_P : CommRingCat.of Ω ⟶ P.left.presheaf.obj (Opposite.op W_x) :=
      AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ P.hom)
    have hφP_spec : AlgebraicGeometry.Spec.map φ_P = hAffW.fromSpec ≫ P.hom :=
      AlgebraicGeometry.Spec.map_preimage (hAffW.fromSpec ≫ P.hom)
    have hφP_eq : (φ_P ≫ f_u_cat) ≫ CommRingCat.ofHom σ = φ_X := by
      rw [Category.assoc, hσ_fu]
      apply AlgebraicGeometry.Spec.map_injective
      dsimp only [f_π_cat]
      rw [AlgebraicGeometry.Spec.map_comp, hφP_spec, ← Category.assoc,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π_tilde hAffW hAffU hle_W,
        Category.assoc, hπ_hom, ← hφX_spec]
    have hσ_ft : RingHom.FiniteType σ := by
      have hcomp_ft : (σ.comp (φ_P ≫ f_u_cat).hom).FiniteType := by
        have heq_hom : σ.comp (φ_P ≫ f_u_cat).hom = φ_X.hom :=
          congrArg CommRingCat.Hom.hom hφP_eq
        rw [heq_hom]
        exact hφX_ft
      exact RingHom.FiniteType.of_comp_finiteType hcomp_ft

    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ)) := by
      let : Algebra B_W K₀ := ι.toAlgebra
      let : Algebra A_x K₀ := κ.toAlgebra
      let : Algebra B_W A_x := σ.toAlgebra
      have : Algebra.FiniteType B_W A_x := RingHom.finiteType_algebraMap.mp hσ_ft
      have : IsScalarTower B_W A_x K₀ :=
        IsScalarTower.of_algebraMap_eq (fun b => (hσ b).symm)
      exact hBiratOpen B_W A_x K₀

    let f : U_x.toScheme ⟶ N.left :=
      hAffU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫ hAffW'.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion f := by
      dsimp only [f]
      infer_instance

    have hf_comm : f ≫ u_bar = U_x.ι ≫ π_tilde := by
      have hu_spec : hAffW'.fromSpec ≫ u_bar =
          AlgebraicGeometry.Spec.map f_u_cat ≫ hAffW.fromSpec := by
        dsimp only [f_u_cat]
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        exact (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
          u_bar hAffW hAffW' le_rfl).symm
      have hπ_spec : AlgebraicGeometry.Spec.map f_π_cat ≫ hAffW.fromSpec =
          hAffU.fromSpec ≫ π_tilde :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π_tilde hAffW hAffU hle_W
      calc
        f ≫ u_bar
          = hAffU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫
              (hAffW'.fromSpec ≫ u_bar) := by
              dsimp only [f]; simp only [Category.assoc]
        _ = hAffU.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫
                AlgebraicGeometry.Spec.map f_u_cat) ≫ hAffW.fromSpec := by
              rw [hu_spec]; simp only [Category.assoc]
        _ = hAffU.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (f_u_cat ≫ CommRingCat.ofHom σ) ≫ hAffW.fromSpec := by
              rw [← AlgebraicGeometry.Spec.map_comp]
        _ = hAffU.isoSpec.hom ≫ (AlgebraicGeometry.Spec.map f_π_cat ≫ hAffW.fromSpec) := by
              rw [hσ_fu]
        _ = hAffU.isoSpec.hom ≫ hAffU.fromSpec ≫ π_tilde := by
              rw [hπ_spec]
        _ = (hAffU.isoSpec.hom ≫ hAffU.isoSpec.inv ≫ U_x.ι) ≫ π_tilde := by
              rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffU]
              simp only [Category.assoc]
        _ = U_x.ι ≫ π_tilde := by
              rw [Iso.hom_inv_id_assoc]

    have hηU_N : η_U ≫ f = η_N := by
      have hηX_spec : AlgebraicGeometry.Spec.map (η_X.appLE U_x ⊤ he_U) ≫ hAffU.fromSpec =
          (AlgebraicGeometry.isAffineOpen_top S_K).fromSpec ≫ η_X :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
          η_X hAffU (AlgebraicGeometry.isAffineOpen_top S_K) he_U
      have hηN_spec : AlgebraicGeometry.Spec.map (η_N.appLE W'_x ⊤ he_W') ≫ hAffW'.fromSpec =
          (AlgebraicGeometry.isAffineOpen_top S_K).fromSpec ≫ η_N :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
          η_N hAffW' (AlgebraicGeometry.isAffineOpen_top S_K) he_W'
      have hηU_iso : (AlgebraicGeometry.isAffineOpen_top S_K).fromSpec ≫
          η_U ≫ hAffU.isoSpec.hom =
          AlgebraicGeometry.Spec.map (η_X.appLE U_x ⊤ he_U) := by
        have hc : ((AlgebraicGeometry.isAffineOpen_top S_K).fromSpec ≫ η_U) ≫ U_x.ι =
            (AlgebraicGeometry.Spec.map (η_X.appLE U_x ⊤ he_U) ≫ hAffU.isoSpec.inv) ≫ U_x.ι := by
          rw [Category.assoc, hηU_X, Category.assoc,
            AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffU, hηX_spec]
        have hc' := (cancel_mono U_x.ι).mp hc
        rw [← Category.assoc, hc', Category.assoc, Iso.inv_hom_id, Category.comp_id]
      apply (cancel_epi (AlgebraicGeometry.isAffineOpen_top S_K).fromSpec).mp
      calc
        (AlgebraicGeometry.isAffineOpen_top S_K).fromSpec ≫ η_U ≫ f
          = ((AlgebraicGeometry.isAffineOpen_top S_K).fromSpec ≫ η_U ≫ hAffU.isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫ hAffW'.fromSpec := by
              dsimp only [f]; simp only [Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (η_X.appLE U_x ⊤ he_U) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ)) ≫ hAffW'.fromSpec := by
              rw [hηU_iso, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ ≫ η_X.appLE U_x ⊤ he_U) ≫
              hAffW'.fromSpec := by
              rw [← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (η_N.appLE W'_x ⊤ he_W') ≫ hAffW'.fromSpec := by
              rw [hσ_appLE]
        _ = (AlgebraicGeometry.isAffineOpen_top S_K).fromSpec ≫ η_N := hηN_spec

    exact ⟨U_x, hxU, f, η_U, inferInstance, hf_comm, hηU_X, hηU_N⟩

  
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  have : X.left.IsSeparated := by
    rw [AlgebraicGeometry.Scheme.isSeparated_iff]
    have : AlgebraicGeometry.IsSeparated (Limits.terminal.from S_Ω) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff S_Ω).mp inferInstance
    have heq : X.hom ≫ Limits.terminal.from S_Ω = Limits.terminal.from X.left :=
      Limits.terminal.hom_ext _ _
    rw [← heq]
    infer_instance
  have : N.left.IsSeparated := by
    rw [AlgebraicGeometry.Scheme.isSeparated_iff]
    have : AlgebraicGeometry.IsSeparated (Limits.terminal.from S_Ω) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff S_Ω).mp inferInstance
    have heq : N.hom ≫ Limits.terminal.from S_Ω = Limits.terminal.from N.left :=
      Limits.terminal.hom_ext _ _
    rw [← heq]
    infer_instance

  have hDomLift : ∀ {Z Q : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsIntegral Z]
      (ι : Q ⟶ Z) [AlgebraicGeometry.IsOpenImmersion ι]
      (α : S_K ⟶ Q), AlgebraicGeometry.IsDominant (α ≫ ι) →
      AlgebraicGeometry.IsIntegral Q ∧ AlgebraicGeometry.IsDominant α := by
    intro Z Q _ ι _ α hDomComp
    have : Nonempty ↥Q := ⟨α.base pt₀⟩
    have hIntQ : AlgebraicGeometry.IsIntegral Q :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion ι
    refine ⟨hIntQ, ?_⟩
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
    apply Set.eq_univ_of_forall
    intro q
    rw [mem_closure_iff]
    intro O hO hqO
    have hImgOpen : IsOpen (ι.base '' O) := ι.isOpenEmbedding.isOpenMap O hO
    have hDenseComp : closure (Set.range (α ≫ ι).base) = Set.univ :=
      denseRange_iff_closure_range.mp ((AlgebraicGeometry.isDominant_iff (α ≫ ι)).mp hDomComp)
    have hq_cl : ι.base q ∈ closure (Set.range (α ≫ ι).base) := by
      rw [hDenseComp]; trivial
    obtain ⟨_, ⟨q', hq'O, hq'_eq⟩, ⟨pt, hpt_eq⟩⟩ :=
      mem_closure_iff.mp hq_cl (ι.base '' O) hImgOpen ⟨q, hqO, rfl⟩
    have hα_eq : α.base pt = q' :=
      ι.isOpenEmbedding.injective (by
        change (α ≫ ι).base pt = ι.base q'
        rw [hpt_eq, hq'_eq])
    exact ⟨q', hq'O, pt, hα_eq⟩

  choose U hxU f η_U hOpen_f hf_comm hηU_X hηU_N using hCov
  have hcov_X : iSup U = ⊤ :=
    eq_top_iff.mpr (fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxU x⟩)
  let 𝒰 := X.left.openCoverOfIsOpenCover U hcov_X
  have hglue_X : ∀ x y : 𝒰.I₀,
      Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ f x =
        Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ f y := by
    intro x y
    change Limits.pullback.fst (U x).ι (U y).ι ≫ f x =
      Limits.pullback.snd (U x).ι (U y).ι ≫ f y
    let p₁ := Limits.pullback.fst (U x).ι (U y).ι
    let p₂ := Limits.pullback.snd (U x).ι (U y).ι
    let η_xy := Limits.pullback.lift (η_U x) (η_U y) ((hηU_X x).trans (hηU_X y).symm)
    have hη_comp : η_xy ≫ (p₁ ≫ (U x).ι) = η_X := by
      rw [← Category.assoc, Limits.pullback.lift_fst, hηU_X x]
    obtain ⟨hInt_xy, hDom_xy⟩ := hDomLift (p₁ ≫ (U x).ι) η_xy (by rw [hη_comp]; exact hDomX)
    have := hInt_xy
    have := hDom_xy
    apply AlgebraicGeometry.ext_of_isDominant η_xy
    calc
      η_xy ≫ (p₁ ≫ f x) = (η_xy ≫ p₁) ≫ f x := (Category.assoc _ _ _).symm
      _ = η_U x ≫ f x := by rw [Limits.pullback.lift_fst]
      _ = η_N := hηU_N x
      _ = η_U y ≫ f y := (hηU_N y).symm
      _ = (η_xy ≫ p₂) ≫ f y := by rw [Limits.pullback.lift_snd]
      _ = η_xy ≫ (p₂ ≫ f y) := Category.assoc _ _ _

  let ψ : X.left ⟶ N.left := 𝒰.glueMorphisms f hglue_X
  have hι_ψ : ∀ x : ↥X.left, (U x).ι ≫ ψ = f x := fun x => 𝒰.ι_glueMorphisms f hglue_X x

  have hψ_u : ψ ≫ u_bar = π_tilde := by
    apply 𝒰.hom_ext
    intro x
    change (U x).ι ≫ (ψ ≫ u_bar) = (U x).ι ≫ π_tilde
    rw [← Category.assoc, hι_ψ x, hf_comm x]

  have hψ_hom : ψ ≫ N.hom = X.hom := by
    rw [← hu_hom, ← Category.assoc, hψ_u, hπ_hom]

  obtain ⟨x_init⟩ : Nonempty ↥X.left := inferInstance
  have hηX_ψ : η_X ≫ ψ = η_N := by
    rw [← hηU_X x_init, Category.assoc, hι_ψ x_init, hηU_N x_init]

  have : AlgebraicGeometry.IsProper ψ := by
    have : AlgebraicGeometry.IsProper (ψ ≫ N.hom) := by
      rw [hψ_hom]
      infer_instance
    exact AlgebraicGeometry.IsProper.of_comp ψ N.hom

  let V : ↥X.left → N.left.Opens := fun x =>
    letI := hOpen_f x
    (f x).opensRange

  have hRange_eq : Set.range ψ.base = ⋃ x : ↥X.left, (V x : Set ↥N.left) := by
    ext y
    simp only [Set.mem_range, Set.mem_iUnion]
    constructor
    · rintro ⟨x, rfl⟩
      refine ⟨x, ⟨⟨x, hxU x⟩, ?_⟩⟩
      change (f x).base ⟨x, hxU x⟩ = ψ.base x
      rw [← hι_ψ x]
      rfl
    · rintro ⟨x, ⟨u, rfl⟩⟩
      refine ⟨(U x).ι.base u, ?_⟩
      change ψ.base ((U x).ι.base u) = (f x).base u
      rw [← hι_ψ x]
      rfl

  have hRange_univ : Set.range ψ.base = Set.univ := by
    have hCl : IsClosed (Set.range ψ.base) := ψ.isClosedMap.isClosed_range
    have hOp : IsOpen (Set.range ψ.base) := by
      rw [hRange_eq]
      exact isOpen_iUnion (fun x => (V x).isOpen)
    have hNe : (Set.range ψ.base).Nonempty := ⟨ψ.base x_init, x_init, rfl⟩
    exact IsClopen.eq_univ ⟨hCl, hOp⟩ hNe

  have hcov_N : iSup V = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have hy : y ∈ ⋃ x : ↥X.left, (V x : Set ↥N.left) := by
      rw [← hRange_eq, hRange_univ]
      trivial
    obtain ⟨x, hyx⟩ := Set.mem_iUnion.mp hy
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hyx⟩

  let e_V : ∀ x : ↥X.left, (U x).toScheme ≅ (V x).toScheme := fun x =>
    letI := hOpen_f x
    (f x).isoOpensRange
  let g : ∀ x : ↥X.left, (V x).toScheme ⟶ X.left := fun x => (e_V x).inv ≫ (U x).ι
  let η_V : ∀ x : ↥X.left, S_K ⟶ (V x).toScheme := fun x => η_U x ≫ (e_V x).hom

  have hηV_N : ∀ x : ↥X.left, η_V x ≫ (V x).ι = η_N := by
    intro x
    let := hOpen_f x
    dsimp only [η_V, e_V, V]
    rw [Category.assoc, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι, hηU_N x]

  have hηV_g : ∀ x : ↥X.left, η_V x ≫ g x = η_X := by
    intro x
    dsimp only [η_V, g]
    rw [Category.assoc, Iso.hom_inv_id_assoc, hηU_X x]

  let 𝒱 := N.left.openCoverOfIsOpenCover V hcov_N
  have hglue_N : ∀ x y : 𝒱.I₀,
      Limits.pullback.fst (𝒱.f x) (𝒱.f y) ≫ g x =
        Limits.pullback.snd (𝒱.f x) (𝒱.f y) ≫ g y := by
    intro x y
    change Limits.pullback.fst (V x).ι (V y).ι ≫ g x =
      Limits.pullback.snd (V x).ι (V y).ι ≫ g y
    let q₁ := Limits.pullback.fst (V x).ι (V y).ι
    let q₂ := Limits.pullback.snd (V x).ι (V y).ι
    let ηV_xy := Limits.pullback.lift (η_V x) (η_V y) ((hηV_N x).trans (hηV_N y).symm)
    have hη_comp : ηV_xy ≫ (q₁ ≫ (V x).ι) = η_N := by
      rw [← Category.assoc, Limits.pullback.lift_fst, hηV_N x]
    obtain ⟨hInt_xy, hDom_xy⟩ := hDomLift (q₁ ≫ (V x).ι) ηV_xy (by rw [hη_comp]; exact hDomN)
    have := hInt_xy
    have := hDom_xy
    apply AlgebraicGeometry.ext_of_isDominant ηV_xy
    calc
      ηV_xy ≫ (q₁ ≫ g x) = (ηV_xy ≫ q₁) ≫ g x := (Category.assoc _ _ _).symm
      _ = η_V x ≫ g x := by rw [Limits.pullback.lift_fst]
      _ = η_X := hηV_g x
      _ = η_V y ≫ g y := (hηV_g y).symm
      _ = (ηV_xy ≫ q₂) ≫ g y := by rw [Limits.pullback.lift_snd]
      _ = ηV_xy ≫ (q₂ ≫ g y) := Category.assoc _ _ _

  let φ : N.left ⟶ X.left := 𝒱.glueMorphisms g hglue_N
  have hι_φ : ∀ x : ↥X.left, (V x).ι ≫ φ = g x := fun x => 𝒱.ι_glueMorphisms g hglue_N x

  have hηN_φ : η_N ≫ φ = η_X := by
    rw [← hηV_N x_init, Category.assoc, hι_φ x_init, hηV_g x_init]

  have hψφ : ψ ≫ φ = 𝟙 X.left := by
    apply AlgebraicGeometry.ext_of_isDominant η_X
    rw [← Category.assoc, hηX_ψ, hηN_φ, Category.comp_id]

  have hφψ : φ ≫ ψ = 𝟙 N.left := by
    apply AlgebraicGeometry.ext_of_isDominant η_N
    rw [← Category.assoc, hηN_φ, hηX_ψ, Category.comp_id]

  have hIso_ψ : CategoryTheory.IsIso ψ := ⟨⟨φ, hψφ, hφψ⟩⟩
  have : CategoryTheory.IsIso ψ := hIso_ψ

  
  have hTransport : ∀ {X₀ N₀ P₀ S₀ : AlgebraicGeometry.Scheme.{u}}
      (x_hom : X₀ ⟶ S₀) (n_hom : N₀ ⟶ S₀)
      (π_t : X₀ ⟶ P₀) (u_b : N₀ ⟶ P₀)
      (ψ₀ : X₀ ⟶ N₀) [CategoryTheory.IsIso ψ₀],
      ψ₀ ≫ u_b = π_t →
      ψ₀ ≫ n_hom = x_hom →
      (AlgebraicGeometry.SmoothOfRelativeDimension 1 n_hom →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 x_hom) ∧
      (∀ d : ℕ, WeilTopDegFiniteLocallyFreeOfRank d u_b →
        WeilTopDegFiniteLocallyFreeOfRank d π_t) := by
    rintro X₀ N₀ P₀ S₀ _ n_hom _ u_b ψ₀ hIso₀ rfl rfl
    have : CategoryTheory.IsIso ψ₀ := hIso₀
    refine ⟨?_, ?_⟩
    · intro ⟨hSmN_at⟩
      refine ⟨fun x => ?_⟩
      obtain ⟨U_S, hAff_US, V_N, hAff_VN, hψx_VN, he_VN, hStd_N⟩ := hSmN_at (ψ₀.base x)
      let V_X : X₀.Opens := (TopologicalSpace.Opens.map ψ₀.base).obj V_N
      have hAff_VX : AlgebraicGeometry.IsAffineOpen V_X := hAff_VN.preimage ψ₀
      have he_VX : V_X ≤ (TopologicalSpace.Opens.map (ψ₀ ≫ n_hom).base).obj U_S :=
        fun _ hz => he_VN hz
      refine ⟨U_S, hAff_US, V_X, hAff_VX, hψx_VN, he_VX, ?_⟩
      have happ_eq : (ψ₀ ≫ n_hom).appLE U_S V_X he_VX =
          n_hom.appLE U_S V_N he_VN ≫ ψ₀.app V_N := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        exact (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          ψ₀ n_hom U_S V_N V_X he_VN le_rfl).symm
      rw [happ_eq]
      exact ((@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).cancel_right_isIso
        (n_hom.appLE U_S V_N he_VN) (ψ₀.app V_N)).mpr hStd_N
    · intro d ⟨hFin_u, hChart_u⟩
      have : AlgebraicGeometry.IsFinite u_b := hFin_u
      refine ⟨inferInstance, fun y => ?_⟩
      obtain ⟨V_y, hyV, hAffVy, hAffWN, M, instAdd, instMod, e_N, he_smul, hBasis⟩ := hChart_u y
      let := instAdd
      let := instMod
      have hAffWX : AlgebraicGeometry.IsAffineOpen
          ((TopologicalSpace.Opens.map (ψ₀ ≫ u_b).base).obj V_y) :=
        hAffWN.preimage ψ₀
      let iso_ψ := asIso (ψ₀.app ((TopologicalSpace.Opens.map u_b.base).obj V_y))
      let e_X : M ≃+ ↑(X₀.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ψ₀ ≫ u_b).base).obj V_y))) :=
        e_N.trans iso_ψ.commRingCatIsoToRingEquiv.toAddEquiv
      refine ⟨V_y, hyV, hAffVy, hAffWX, M, instAdd, instMod, e_X, ?_, hBasis⟩
      intro b m
      rw [AlgebraicGeometry.Scheme.Hom.comp_app ψ₀ u_b V_y]
      change (ψ₀.app ((TopologicalSpace.Opens.map u_b.base).obj V_y)).hom (e_N (b • m)) =
        (ψ₀.app ((TopologicalSpace.Opens.map u_b.base).obj V_y)).hom ((u_b.app V_y).hom b) *
          (ψ₀.app ((TopologicalSpace.Opens.map u_b.base).obj V_y)).hom (e_N m)
      rw [he_smul b m, map_mul]

  obtain ⟨hSm_trans, hFLF_trans⟩ := hTransport X.hom N.hom π_tilde u_bar ψ hψ_u hψ_hom
  exact ⟨ψ, hIso_ψ, hψ_u, hψ_hom, hSm_trans, hFLF_trans⟩

theorem weil_gysin_affine_etale_curve_clopen_split_and_normalization (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (hIntClosFin : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra Ω A] [Algebra.FiniteType Ω A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K))
    (P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hIntP : AlgebraicGeometry.IsIntegral P.left)
    (hProjP : IsProjectiveOverField Ω P)
    [AlgebraicGeometry.IsProper P.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 P.hom]
    (ι_P : Quiver.Hom (weilGysinAffineSpace Ω 1) P.left)
    (hOpen_P : AlgebraicGeometry.IsOpenImmersion ι_P)
    (hι_P_hom : CategoryTheory.CategoryStruct.comp ι_P P.hom = weilGysinAffineStruct Ω 1)
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsProper C_bar.hom]
    (C_open : C_bar.left.Opens)
    (hAffC : AlgebraicGeometry.IsAffineOpen C_open)
    (hNeC : Nonempty ↥C_open.toScheme)
    (π₁ π₂ : Quiver.Hom C_bar.left P.left)
    (hπ₁_hom : CategoryTheory.CategoryStruct.comp π₁ P.hom = C_bar.hom)
    (hπ₂_hom : CategoryTheory.CategoryStruct.comp π₂ P.hom = C_bar.hom)
    (v₁ v₂ : Quiver.Hom C_open.toScheme (weilGysinAffineSpace Ω 1))
    (hv₁_et : AlgebraicGeometry.Etale v₁)
    (hv₂_et : AlgebraicGeometry.Etale v₂)
    (hv₁_hom : CategoryTheory.CategoryStruct.comp v₁ (weilGysinAffineStruct Ω 1) =
      CategoryTheory.CategoryStruct.comp C_open.ι C_bar.hom)
    (hv₂_hom : CategoryTheory.CategoryStruct.comp v₂ (weilGysinAffineStruct Ω 1) =
      CategoryTheory.CategoryStruct.comp C_open.ι C_bar.hom)
    (hπ₁_open : CategoryTheory.CategoryStruct.comp C_open.ι π₁ =
      CategoryTheory.CategoryStruct.comp v₁ ι_P)
    (hπ₂_open : CategoryTheory.CategoryStruct.comp C_open.ι π₂ =
      CategoryTheory.CategoryStruct.comp v₂ ι_P) :
    ∃ (s : ℕ)
      (C_comp : Fin s → C_bar.left.Opens)
      (C_tilde : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (p_comp : ∀ α : Fin s, Quiver.Hom (C_tilde α).left C_bar.left)
      (j_tilde : ∀ α : Fin s, Quiver.Hom (C_comp α).toScheme (C_tilde α).left)
      (d₁ d₂ : Fin s → ℕ),
      (∀ α : Fin s, C_comp α ≤ C_open) ∧
      (⨆ α : Fin s, C_comp α) = C_open ∧
      (∀ α β : Fin s, α ≠ β → Disjoint (C_comp α : Set ↥C_bar.left) (C_comp β : Set ↥C_bar.left)) ∧
      (∀ α : Fin s,
        AlgebraicGeometry.IsAffineOpen (C_comp α) ∧
        AlgebraicGeometry.IsIntegral (C_comp α).toScheme) ∧
      (∀ α : Fin s,
        AlgebraicGeometry.IsIntegral (C_tilde α).left ∧
        AlgebraicGeometry.IsProper (C_tilde α).hom ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (C_tilde α).hom ∧
        CategoryTheory.CategoryStruct.comp (p_comp α) C_bar.hom = (C_tilde α).hom ∧
        AlgebraicGeometry.IsProper (p_comp α) ∧
        AlgebraicGeometry.IsOpenImmersion (j_tilde α) ∧
        CategoryTheory.CategoryStruct.comp (j_tilde α) (p_comp α) = (C_comp α).ι ∧
        CategoryTheory.IsPullback (j_tilde α)
          (CategoryTheory.CategoryStruct.id (C_comp α).toScheme)
          (p_comp α) (C_comp α).ι) ∧
      (∀ α : Fin s,
        1 ≤ d₁ α ∧
        1 ≤ d₂ α ∧
        WeilTopDegFiniteLocallyFreeOfRank (d₁ α)
          (CategoryTheory.CategoryStruct.comp (p_comp α) π₁) ∧
        WeilTopDegFiniteLocallyFreeOfRank (d₂ α)
          (CategoryTheory.CategoryStruct.comp (p_comp α) π₂)) :=
by
  classical
  have _ := hProjP
  have _ := hNeC
  have _ := hv₁_hom
  have _ := hv₂_hom
  have : AlgebraicGeometry.Etale v₁ := hv₁_et
  have : AlgebraicGeometry.Etale v₂ := hv₂_et

  
  let B_cat : CommRingCat.{u} := C_bar.left.presheaf.obj (Opposite.op C_open)
  let B : Type u := ↑B_cat
  let φ₁_cat : CommRingCat.of (MvPolynomial (Fin 1) Ω) ⟶ B_cat :=
    AlgebraicGeometry.Spec.preimage (CategoryTheory.CategoryStruct.comp hAffC.isoSpec.inv v₁)
  have hSpec_φ₁ : AlgebraicGeometry.Spec.map φ₁_cat =
      CategoryTheory.CategoryStruct.comp hAffC.isoSpec.inv v₁ :=
    AlgebraicGeometry.Spec.map_preimage (CategoryTheory.CategoryStruct.comp hAffC.isoSpec.inv v₁)
  have hEt_Spec₁ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₁_cat) := by
    rw [hSpec_φ₁]
    change AlgebraicGeometry.Etale (hAffC.isoSpec.inv ≫ v₁)
    infer_instance
  have hEt_φ₁ : RingHom.Etale φ₁_cat.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec₁
  let _ : Algebra (MvPolynomial (Fin 1) Ω) B := φ₁_cat.hom.toAlgebra
  have : Algebra.Etale (MvPolynomial (Fin 1) Ω) B := RingHom.etale_algebraMap.mp hEt_φ₁
  have : Algebra.FiniteType (MvPolynomial (Fin 1) Ω) B := inferInstance
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin 1) Ω) B
  have hLocDom : ∀ (m : Ideal B) [m.IsMaximal], IsDomain (Localization.AtPrime m) :=
    fun m _ => (weil_algClosed_etale_mvPolynomial_local_domain_integrallyClosed Ω 1 B m).1
  obtain ⟨s, e, h_sum, h_orth, h_dom⟩ :=
    weil_noetherian_locally_domain_orthogonal_idempotent_split B hLocDom

  
  let C_comp : Fin s → C_bar.left.Opens := fun α => C_bar.left.basicOpen (e α)
  have h_le : ∀ α : Fin s, C_comp α ≤ C_open := fun α => C_bar.left.basicOpen_le (e α)
  have h_iSup : (⨆ α : Fin s, C_comp α) = C_open := by
    apply le_antisymm
    · exact iSup_le fun α => h_le α
    · intro x hx
      by_contra hx_not
      let q_x : PrimeSpectrum B := hAffC.primeIdealOf ⟨x, hx⟩
      have he_mem : ∀ α : Fin s, e α ∈ q_x.asIdeal := by
        intro α
        by_contra h_not_mem
        have hmem_spec : q_x ∈ PrimeSpectrum.basicOpen (e α) :=
          (PrimeSpectrum.mem_basicOpen (e α) q_x).mpr h_not_mem
        rw [← hAffC.fromSpec_preimage_basicOpen (e α)] at hmem_spec
        change hAffC.fromSpec.base q_x ∈ C_comp α at hmem_spec
        rw [hAffC.fromSpec_primeIdealOf ⟨x, hx⟩] at hmem_spec
        exact hx_not (TopologicalSpace.Opens.mem_iSup.mpr ⟨α, hmem_spec⟩)
      have h1_mem : (1 : B) ∈ q_x.asIdeal := by
        rw [← h_sum]
        exact Ideal.sum_mem q_x.asIdeal fun α _ => he_mem α
      exact q_x.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q_x.asIdeal h1_mem isUnit_one)
  have h_disj : ∀ α β : Fin s, α ≠ β →
      Disjoint (C_comp α : Set ↥C_bar.left) (C_comp β : Set ↥C_bar.left) := by
    intro α β hne
    rw [Set.disjoint_iff_inter_eq_empty]
    have hinf : C_comp α ⊓ C_comp β = ⊥ := by
      dsimp only [C_comp]
      rw [← C_bar.left.basicOpen_mul (e α) (e β), h_orth α β hne, C_bar.left.basicOpen_zero]
    exact congrArg SetLike.coe hinf
  have hAff_comp : ∀ α : Fin s, AlgebraicGeometry.IsAffineOpen (C_comp α) :=
    fun α => hAffC.basicOpen (e α)

  
  let R₀ : Type u := Polynomial Ω
  let e_poly_alg : MvPolynomial (Fin 1) Ω ≃ₐ[Ω] Polynomial Ω :=
    (MvPolynomial.finSuccEquiv Ω 0).trans
      (Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv Ω (Fin 0)))
  let e_poly_ring : R₀ ≃+* MvPolynomial (Fin 1) Ω := e_poly_alg.symm.toRingEquiv

  let w₁ : ∀ α : Fin s, Quiver.Hom (C_comp α).toScheme (weilGysinAffineSpace Ω 1) :=
    fun α => CategoryTheory.CategoryStruct.comp (C_bar.left.homOfLE (h_le α)) v₁
  let w₂ : ∀ α : Fin s, Quiver.Hom (C_comp α).toScheme (weilGysinAffineSpace Ω 1) :=
    fun α => CategoryTheory.CategoryStruct.comp (C_bar.left.homOfLE (h_le α)) v₂
  have hw₁_et : ∀ α : Fin s, AlgebraicGeometry.Etale (w₁ α) := fun α => by
    change AlgebraicGeometry.Etale (C_bar.left.homOfLE (h_le α) ≫ v₁)
    infer_instance
  have hw₂_et : ∀ α : Fin s, AlgebraicGeometry.Etale (w₂ α) := fun α => by
    change AlgebraicGeometry.Etale (C_bar.left.homOfLE (h_le α) ≫ v₂)
    infer_instance

  have hInt_and_IC : ∀ α : Fin s,
      AlgebraicGeometry.IsIntegral (C_comp α).toScheme ∧
      IsIntegrallyClosed ↑(C_bar.left.presheaf.obj (Opposite.op (C_comp α))) := by
    intro α
    let hAff_α := hAff_comp α
    let B_α_cat : CommRingCat.{u} := C_bar.left.presheaf.obj (Opposite.op (C_comp α))
    let B_α : Type u := ↑B_α_cat
    let res_α : B_cat ⟶ B_α_cat :=
      C_bar.left.presheaf.map (CategoryTheory.homOfLE (h_le α)).op
    let _ : Algebra B B_α := res_α.hom.toAlgebra
    have : IsLocalization.Away (e α) B_α := hAffC.isLocalization_basicOpen (e α)
    let _ : IsDomain (Localization.Away (e α)) := h_dom α
    let e_loc_α : Localization.Away (e α) ≃ₐ[B] B_α :=
      IsLocalization.algEquiv (Submonoid.powers (e α)) (Localization.Away (e α)) B_α
    let _ : IsDomain B_α := e_loc_α.symm.toRingEquiv.toMulEquiv.isDomain _
    have hNe_Spec : Nonempty (PrimeSpectrum B_α) := inferInstance
    have hNe_α : Nonempty ↥(C_comp α).toScheme :=
      ⟨hAff_α.isoSpec.inv.base (Classical.choice hNe_Spec)⟩
    have : AlgebraicGeometry.IsAffine (C_comp α).toScheme := hAff_α
    let B_top_cat : CommRingCat.{u} := (C_comp α).toScheme.presheaf.obj (Opposite.op ⊤)
    let iso_appTop : B_top_cat ≅
        (AlgebraicGeometry.Spec B_α_cat).presheaf.obj (Opposite.op ⊤) :=
      { hom := hAff_α.isoSpec.inv.appTop
        inv := hAff_α.isoSpec.hom.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hAff_α.isoSpec.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hAff_α.isoSpec.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    let iso_top_α : B_top_cat ≅ B_α_cat :=
      iso_appTop ≪≫ AlgebraicGeometry.Scheme.ΓSpecIso B_α_cat
    have hDom_top : IsDomain ↑B_top_cat :=
      iso_top_α.commRingCatIsoToRingEquiv.toMulEquiv.isDomain _
    have hInt_α : AlgebraicGeometry.IsIntegral (C_comp α).toScheme :=
      @AlgebraicGeometry.isIntegral_of_isAffine_of_isDomain (C_comp α).toScheme _ hNe_α hDom_top
    have : AlgebraicGeometry.Etale (w₁ α) := hw₁_et α
    let ψ_α_cat : CommRingCat.of (MvPolynomial (Fin 1) Ω) ⟶ B_α_cat :=
      AlgebraicGeometry.Spec.preimage
        (CategoryTheory.CategoryStruct.comp hAff_α.isoSpec.inv (w₁ α))
    have hSpec_ψ : AlgebraicGeometry.Spec.map ψ_α_cat =
        CategoryTheory.CategoryStruct.comp hAff_α.isoSpec.inv (w₁ α) :=
      AlgebraicGeometry.Spec.map_preimage _
    have hEt_Spec_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map ψ_α_cat) := by
      rw [hSpec_ψ]
      change AlgebraicGeometry.Etale (hAff_α.isoSpec.inv ≫ w₁ α)
      infer_instance
    have hEt_ψ : RingHom.Etale ψ_α_cat.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec_ψ
    have hEt_R₀_Bα : RingHom.Etale (ψ_α_cat.hom.comp e_poly_ring.toRingHom) :=
      (RingHom.Etale.respectsIso.cancel_left_isIso
        e_poly_ring.toCommRingCatIso.hom ψ_α_cat).mpr hEt_ψ
    let _ : Algebra R₀ B_α := (ψ_α_cat.hom.comp e_poly_ring.toRingHom).toAlgebra
    have : Algebra.Etale R₀ B_α := RingHom.etale_algebraMap.mp hEt_R₀_Bα
    have : IrreducibleSpace (PrimeSpectrum B_α) := PrimeSpectrum.irreducibleSpace
    have : ConnectedSpace (PrimeSpectrum B_α) :=
      IrreducibleSpace.connectedSpace (PrimeSpectrum B_α)
    have hIC_α : IsIntegrallyClosed B_α :=
      (weil_connected_etale_dedekind_domain_and_separable_frac R₀ B_α).2.1
    exact ⟨hInt_α, hIC_α⟩

  
  choose C_tilde p_comp j_tilde h_norm using fun α : Fin s =>
    weil_open_integral_schematic_closure_normalization_pullback Ω hIntClosFin C_bar
      (C_comp α) (hAff_comp α) (hInt_and_IC α).1 (hInt_and_IC α).2

  
  have hConn_comp : ∀ α : Fin s, ConnectedSpace ↥(C_comp α).toScheme := fun α => by
    have : AlgebraicGeometry.IsIntegral (C_comp α).toScheme := (hInt_and_IC α).1
    infer_instance
  choose N₁ j_N1 d₁ u_bar₁ hN₁ using fun α : Fin s =>
    @weil_connected_etale_curve_completion_over_smooth_curve Ω _ _ P hIntP _ _
      ι_P hOpen_P hι_P_hom (C_comp α).toScheme (hAff_comp α) (hConn_comp α) (w₁ α) (hw₁_et α)
  choose N₂ j_N2 d₂ u_bar₂ hN₂ using fun α : Fin s =>
    @weil_connected_etale_curve_completion_over_smooth_curve Ω _ _ P hIntP _ _
      ι_P hOpen_P hι_P_hom (C_comp α).toScheme (hAff_comp α) (hConn_comp α) (w₂ α) (hw₂_et α)

  
  have hBirat : ∀ α : Fin s,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (C_tilde α).hom ∧
      WeilTopDegFiniteLocallyFreeOfRank (d₁ α)
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₁) ∧
      WeilTopDegFiniteLocallyFreeOfRank (d₂ α)
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₂) := by
    intro α
    have : AlgebraicGeometry.IsIntegral (C_comp α).toScheme := (hInt_and_IC α).1
    have : Nonempty ↥(C_comp α).toScheme := inferInstance
    have : AlgebraicGeometry.IsProper (C_tilde α).hom := (h_norm α).2.2.2.1
    have : AlgebraicGeometry.IsOpenImmersion (j_tilde α) := (h_norm α).2.2.2.2.1

    have hpi_tilde1_hom : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₁) P.hom = (C_tilde α).hom := by
      rw [CategoryTheory.Category.assoc, hπ₁_hom, (h_norm α).2.1]
    have hpi_tilde2_hom : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₂) P.hom = (C_tilde α).hom := by
      rw [CategoryTheory.Category.assoc, hπ₂_hom, (h_norm α).2.1]

    have hOpenComm₁ : CategoryTheory.CategoryStruct.comp (j_tilde α)
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₁) =
        CategoryTheory.CategoryStruct.comp (j_N1 α) (u_bar₁ α) := by
      calc
        j_tilde α ≫ (p_comp α ≫ π₁)
          = (j_tilde α ≫ p_comp α) ≫ π₁ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (C_comp α).ι ≫ π₁ := by rw [(h_norm α).2.2.2.2.2.1]
        _ = C_bar.left.homOfLE (h_le α) ≫ (C_open.ι ≫ π₁) := by
            rw [← AlgebraicGeometry.Scheme.homOfLE_ι_assoc C_bar.left (h_le α)]
        _ = C_bar.left.homOfLE (h_le α) ≫ (v₁ ≫ ι_P) := by rw [hπ₁_open]
        _ = w₁ α ≫ ι_P := (CategoryTheory.Category.assoc _ _ _).symm
        _ = j_N1 α ≫ u_bar₁ α := (hN₁ α).2.2.2.2.2.2.2.2.1.symm

    have hOpenComm₂ : CategoryTheory.CategoryStruct.comp (j_tilde α)
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₂) =
        CategoryTheory.CategoryStruct.comp (j_N2 α) (u_bar₂ α) := by
      calc
        j_tilde α ≫ (p_comp α ≫ π₂)
          = (j_tilde α ≫ p_comp α) ≫ π₂ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (C_comp α).ι ≫ π₂ := by rw [(h_norm α).2.2.2.2.2.1]
        _ = C_bar.left.homOfLE (h_le α) ≫ (C_open.ι ≫ π₂) := by
            rw [← AlgebraicGeometry.Scheme.homOfLE_ι_assoc C_bar.left (h_le α)]
        _ = C_bar.left.homOfLE (h_le α) ≫ (v₂ ≫ ι_P) := by rw [hπ₂_open]
        _ = w₂ α ≫ ι_P := (CategoryTheory.Category.assoc _ _ _).symm
        _ = j_N2 α ≫ u_bar₂ α := (hN₂ α).2.2.2.2.2.2.2.2.1.symm

    have : AlgebraicGeometry.IsProper (N₁ α).hom := (hN₁ α).2.1
    have : AlgebraicGeometry.IsFinite (u_bar₁ α) := (hN₁ α).2.2.2.2.2.1
    have : AlgebraicGeometry.Surjective (u_bar₁ α) := (hN₁ α).2.2.2.2.2.2.1
    have : AlgebraicGeometry.IsOpenImmersion (j_N1 α) := (hN₁ α).2.2.2.2.2.2.2.1
    obtain ⟨_ψ₁, _hIso₁, _hψ₁_u, _hψ₁_hom, hSm_trans₁, hFLF_trans₁⟩ :=
      weil_normal_proper_curve_birational_isIso_over_dedekind_target Ω
        weil_dedekind_birational_finiteType_spec_isOpenImmersion
        P (C_tilde α) (N₁ α) (h_norm α).1 (hN₁ α).1
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₁) hpi_tilde1_hom
        (u_bar₁ α) (hN₁ α).2.2.2.2.1
        (h_norm α).2.2.2.2.2.2.2 (hN₁ α).2.2.2.2.2.2.2.2.2.2
        (C_comp α).toScheme (j_tilde α) (j_N1 α) hOpenComm₁

    have : AlgebraicGeometry.IsProper (N₂ α).hom := (hN₂ α).2.1
    have : AlgebraicGeometry.IsFinite (u_bar₂ α) := (hN₂ α).2.2.2.2.2.1
    have : AlgebraicGeometry.Surjective (u_bar₂ α) := (hN₂ α).2.2.2.2.2.2.1
    have : AlgebraicGeometry.IsOpenImmersion (j_N2 α) := (hN₂ α).2.2.2.2.2.2.2.1
    obtain ⟨_ψ₂, _hIso₂, _hψ₂_u, _hψ₂_hom, _hSm_trans₂, hFLF_trans₂⟩ :=
      weil_normal_proper_curve_birational_isIso_over_dedekind_target Ω
        weil_dedekind_birational_finiteType_spec_isOpenImmersion
        P (C_tilde α) (N₂ α) (h_norm α).1 (hN₂ α).1
        (CategoryTheory.CategoryStruct.comp (p_comp α) π₂) hpi_tilde2_hom
        (u_bar₂ α) (hN₂ α).2.2.2.2.1
        (h_norm α).2.2.2.2.2.2.2 (hN₂ α).2.2.2.2.2.2.2.2.2.2
        (C_comp α).toScheme (j_tilde α) (j_N2 α) hOpenComm₂

    exact ⟨hSm_trans₁ (hN₁ α).2.2.1,
      hFLF_trans₁ (d₁ α) (hN₁ α).2.2.2.2.2.2.2.2.2.1,
      hFLF_trans₂ (d₂ α) (hN₂ α).2.2.2.2.2.2.2.2.2.1⟩

  exact ⟨s, C_comp, C_tilde, p_comp, j_tilde, d₁, d₂,
    h_le, h_iSup, h_disj,
    fun α => ⟨hAff_comp α, (hInt_and_IC α).1⟩,
    fun α => ⟨(h_norm α).1, (h_norm α).2.2.2.1, (hBirat α).1,
      (h_norm α).2.1, (h_norm α).2.2.1, (h_norm α).2.2.2.2.1,
      (h_norm α).2.2.2.2.2.1, (h_norm α).2.2.2.2.2.2.1⟩,
    fun α => ⟨(hN₁ α).2.2.2.1, (hN₂ α).2.2.2.1, (hBirat α).2.1, (hBirat α).2.2⟩⟩

theorem weil_finite_morphism_torsion_higherDirectImage_isZero (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hCD_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m n q : ℕ),
      1 ≤ n → IsUnit (n : Ω) →
      ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper Z.hom],
        topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
        2 * m < q →
        Subsingleton (weilEtaleTorsionH Z.left n q))
    (hPBC_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (ℓ : Ω) ≠ 0 → WeilProperModPrimeBaseChangeHolds Ω ℓ)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (hℓΩ : IsUnit (ℓ : Ω))
    (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsProper X.hom] [AlgebraicGeometry.IsProper S.hom]
    (f : Quiver.Hom X.left S.left)
    (hf_hom : CategoryTheory.CategoryStruct.comp f S.hom = X.hom)
    [AlgebraicGeometry.IsFinite f]
    (r q : ℕ) (hr : 1 ≤ r) (hq : 1 ≤ q) :
    CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X.left (ℓ ^ r))) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hPrime.pos
  
  have hMapId : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.LargeCategory 𝒞]
      (P : CategoryTheory.Functor 𝒞ᵒᵖ AddCommGrpCat.{u}) {W : 𝒞}
      (s : ↥(P.obj (Opposite.op W))),
      P.map (Opposite.op (𝟙 W)) s = s := by
    intro 𝒞 _ P W s
    change P.map (𝟙 (Opposite.op W)) s = s
    rw [P.map_id]
    rfl
  have hMapComp : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.LargeCategory 𝒞]
      (P : CategoryTheory.Functor 𝒞ᵒᵖ AddCommGrpCat.{u}) {W₁ W₂ W₃ : 𝒞}
      (u₁ : W₁ ⟶ W₂) (u₂ : W₂ ⟶ W₃)
      (s : ↥(P.obj (Opposite.op W₃))),
      P.map (Opposite.op (u₁ ≫ u₂)) s = P.map (Opposite.op u₁) (P.map (Opposite.op u₂) s) := by
    intro 𝒞 _ P W₁ W₂ W₃ u₁ u₂ s
    change P.map (Opposite.op u₂ ≫ Opposite.op u₁) s = _
    rw [P.map_comp]
    rfl
  
  have hPillar1_Bockstein : ∀ {X₀ S₀ : AlgebraicGeometry.Scheme.{u}} (f₀ : Quiver.Hom X₀ S₀),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ q (weilEtaleTorsionSheaf X₀ ℓ)) →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f₀ q (weilEtaleTorsionSheaf X₀ (ℓ ^ r))) := by
    intro X₀ S₀ f₀ hBase
    have hPresheafExactOfObj : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.LargeCategory 𝒞]
        (SC : CategoryTheory.ShortComplex (CategoryTheory.Functor 𝒞ᵒᵖ AddCommGrpCat.{u})),
        (∀ W : 𝒞, (SC.map ((CategoryTheory.evaluation 𝒞ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W))).Exact) →
        SC.Exact := by
      intro 𝒞 _ SC hObj
      rw [CategoryTheory.ShortComplex.exact_iff_isZero_homology, CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.NatTrans.ext
      funext ⟨W⟩
      let EV := (CategoryTheory.evaluation 𝒞ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W)
      have : EV.PreservesHomology := CategoryTheory.Functor.preservesHomologyOfExact EV
      have hExW : (SC.map EV).Exact := hObj W
      rw [CategoryTheory.ShortComplex.exact_iff_isZero_homology] at hExW
      have hZeroW : CategoryTheory.Limits.IsZero (EV.obj SC.homology) :=
        hExW.of_iso (SC.mapHomologyIso EV).symm
      exact (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp hZeroW
    have hMidExactR : ∀ {SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})},
        SC.ShortExact →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ q SC.X₁) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ q SC.X₃) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ q SC.X₂) := by
      intro SC hSE hZ₁ hZ₃
      let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f₀ :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f₀ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_f : CategoryTheory.Functor S₀.Etale X₀.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f₀
      let F_cohom := CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q
      have hfg0 : F_cohom.map SC.f ≫ F_cohom.map SC.g = 0 := by
        rw [← F_cohom.map_comp, SC.zero]
        apply CategoryTheory.NatTrans.ext
        funext ⟨V⟩
        apply AddCommGrpCat.ext
        intro z
        let G_V := (CategoryTheory.presheafToSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
        change (z : CategoryTheory.Abelian.Ext G_V SC.X₁ q).comp
          (CategoryTheory.Abelian.Ext.mk₀ (0 : SC.X₁ ⟶ SC.X₃)) (Nat.add_zero q) = 0
        rw [CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero z SC.X₃ 0 q (Nat.add_zero q)]
      let SC_pre := CategoryTheory.ShortComplex.mk (F_cohom.map SC.f) (F_cohom.map SC.g) hfg0
      have hEx_pre : SC_pre.Exact := by
        apply hPresheafExactOfObj SC_pre
        intro V
        let G_V := (CategoryTheory.presheafToSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' G_V hSE q
      let W_f :=
        (CategoryTheory.Functor.whiskeringLeft (S₀.Etale)ᵒᵖ (X₀.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
          B_f.op
      let Sh_S := CategoryTheory.presheafToSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}
      have : W_f.PreservesHomology := CategoryTheory.Functor.preservesHomologyOfExact W_f
      have : Sh_S.PreservesHomology := CategoryTheory.Functor.preservesHomologyOfExact Sh_S
      have hEx_sh : ((SC_pre.map W_f).map Sh_S).Exact := (hEx_pre.map W_f).map Sh_S
      have hf0 : ((SC_pre.map W_f).map Sh_S).f = 0 := hZ₁.eq_of_src _ _
      have hg0 : ((SC_pre.map W_f).map Sh_S).g = 0 := hZ₃.eq_of_tgt _ _
      exact hEx_sh.isZero_of_both_zeros hf0 hg0
    have hPow : ∀ m : ℕ, CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f₀ q (weilEtaleTorsionSheaf X₀ (ℓ ^ (m + 1)))) := by
      intro m
      induction m with
      | zero =>
        simpa only [Nat.zero_add, pow_one] using hBase
      | succ m ih =>
        have : NeZero ℓ := ⟨Nat.ne_of_gt hℓ_pos⟩
        have : NeZero (ℓ ^ (m + 1)) := ⟨Nat.ne_of_gt (pow_pos hℓ_pos (m + 1))⟩
        have : NeZero (ℓ ^ (m + 2)) := ⟨Nat.ne_of_gt (pow_pos hℓ_pos (m + 2))⟩
        let A₁ : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
        let A₂ : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (m + 2))))
        let A₃ : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (m + 1))))
        let i_m : A₁ ⟶ A₂ := AddCommGrpCat.ofHom
          { toFun := fun a => ULift.up (((ℓ ^ (m + 1) * a.down.val : ℕ) : ZMod (ℓ ^ (m + 2))))
            map_zero' := by
              apply ULift.ext
              simp
            map_add' := fun a b => by
              apply ULift.ext
              dsimp
              have hdiv := (Nat.div_add_mod (a.down.val + b.down.val) ℓ).symm
              have hval : (a.down + b.down).val = (a.down.val + b.down.val) % ℓ :=
                ZMod.val_add a.down b.down
              have hmul : ℓ ^ (m + 1) * (a.down.val + b.down.val) =
                  ℓ ^ (m + 2) * ((a.down.val + b.down.val) / ℓ) +
                    ℓ ^ (m + 1) * (a.down + b.down).val := by
                rw [hval, pow_succ ℓ (m + 1), mul_assoc]
                calc
                  ℓ ^ (m + 1) * (a.down.val + b.down.val) =
                      ℓ ^ (m + 1) * (ℓ * ((a.down.val + b.down.val) / ℓ) +
                        (a.down.val + b.down.val) % ℓ) :=
                    congrArg (ℓ ^ (m + 1) * ·) hdiv
                  _ = _ := by ring
              have hcast : ((ℓ ^ (m + 1) * (a.down.val + b.down.val) : ℕ) : ZMod (ℓ ^ (m + 2))) =
                  ((ℓ ^ (m + 1) * (a.down + b.down).val : ℕ) : ZMod (ℓ ^ (m + 2))) := by
                rw [hmul, Nat.cast_add, Nat.cast_mul, CharP.cast_eq_zero, zero_mul, zero_add]
              rw [← hcast, mul_add, Nat.cast_add] }
        let cast_m := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
        let p_m : A₂ ⟶ A₃ := AddCommGrpCat.ofHom
          { toFun := fun b => ULift.up (cast_m b.down)
            map_zero' := congrArg ULift.up cast_m.map_zero
            map_add' := fun a b => congrArg ULift.up (cast_m.map_add a.down b.down) }
        have hip_zero : i_m ≫ p_m = 0 := by
          ext ⟨a⟩
          apply ULift.ext
          change cast_m (((ℓ ^ (m + 1) * a.val : ℕ) : ZMod (ℓ ^ (m + 2)))) = 0
          rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero, zero_mul]
        have hi_mono : CategoryTheory.Mono i_m := by
          rw [AddCommGrpCat.mono_iff_injective]
          refine (injective_iff_map_eq_zero i_m.hom).mpr ?_
          rintro ⟨a⟩ ha
          have hval_lt : ℓ ^ (m + 1) * a.val < ℓ ^ (m + 2) := by
            rw [pow_succ ℓ (m + 1)]
            exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt a) (pow_pos hℓ_pos (m + 1))
          have h0 : ((ℓ ^ (m + 1) * a.val : ℕ) : ZMod (ℓ ^ (m + 2))) = 0 :=
            congrArg ULift.down ha
          have hv0 : ℓ ^ (m + 1) * a.val = 0 := by
            have := congrArg ZMod.val h0
            rwa [ZMod.val_natCast_of_lt hval_lt, ZMod.val_zero] at this
          rcases Nat.mul_eq_zero.mp hv0 with hpow0 | ha0
          · exact absurd hpow0 (Nat.ne_of_gt (pow_pos hℓ_pos (m + 1)))
          · exact congrArg ULift.up ((ZMod.val_eq_zero a).mp ha0)
        have hp_epi : CategoryTheory.Epi p_m := by
          rw [AddCommGrpCat.epi_iff_surjective]
          rintro ⟨c⟩
          have hsurj : Function.Surjective cast_m := ZMod.castHom_surjective _
          obtain ⟨b, rfl⟩ := hsurj c
          exact ⟨ULift.up b, rfl⟩
        let SC₀ := CategoryTheory.ShortComplex.mk i_m p_m hip_zero
        have hEx₀ : SC₀.Exact := by
          rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
          rintro ⟨b⟩ hb
          have hb0 : cast_m b = 0 := congrArg ULift.down hb
          have hb_nat : ((b.val : ℕ) : ZMod (ℓ ^ (m + 1))) = 0 := by
            have hbv : b = (b.val : ZMod (ℓ ^ (m + 2))) := (ZMod.natCast_zmod_val b).symm
            rw [hbv, map_natCast] at hb0
            exact hb0
          obtain ⟨q_div, hq_div⟩ := (ZMod.natCast_eq_zero_iff b.val (ℓ ^ (m + 1))).mp hb_nat
          have hq_lt : q_div < ℓ := by
            have hblt : b.val < ℓ ^ (m + 1) * ℓ := by
              rw [← pow_succ ℓ (m + 1)]
              exact ZMod.val_lt b
            rw [hq_div] at hblt
            exact Nat.lt_of_mul_lt_mul_left hblt
          refine ⟨ULift.up (q_div : ZMod ℓ), ?_⟩
          apply ULift.ext
          change ((ℓ ^ (m + 1) * (q_div : ZMod ℓ).val : ℕ) : ZMod (ℓ ^ (m + 2))) = b
          rw [ZMod.val_natCast_of_lt hq_lt, ← hq_div, ZMod.natCast_zmod_val]
        let F_const : CategoryTheory.Functor AddCommGrpCat.{u}
            (CategoryTheory.Functor (X₀.Etale)ᵒᵖ AddCommGrpCat.{u}) :=
          CategoryTheory.Functor.const (X₀.Etale)ᵒᵖ
        let SC_const := SC₀.map F_const
        have hSE_const : SC_const.ShortExact := by
          have : ∀ W, CategoryTheory.Mono (SC_const.f.app W) := fun _ => hi_mono
          have : ∀ W, CategoryTheory.Epi (SC_const.g.app W) := fun _ => hp_epi
          refine CategoryTheory.ShortComplex.ShortExact.mk' ?_ ?_ ?_
          · exact hPresheafExactOfObj SC_const (fun _ => hEx₀)
          · exact CategoryTheory.NatTrans.mono_of_mono_app SC_const.f
          · exact CategoryTheory.NatTrans.epi_of_epi_app SC_const.g
        let Sh_X := CategoryTheory.presheafToSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}
        have hSE_sh : (SC_const.map Sh_X).ShortExact := hSE_const.map_of_exact Sh_X
        exact hMidExactR hSE_sh hBase ih
    have hr_eq : r = (r - 1) + 1 := by omega
    rw [hr_eq]
    exact hPow (r - 1)
  
  have hPillar2_StalkConserv : ∀ (S₀ : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ y : ↥S₀, WeilAltCdStalkZeroAt S₀ 𝒢 y) →
      CategoryTheory.Limits.IsZero 𝒢 := by
    intro S₀ 𝒢 hStalkAll
    have hLocUnram : ∀ {R₀ B₀ : Type u} [CommRing R₀] [CommRing B₀] (φ₀ : R₀ →+* B₀),
        RingHom.FormallyUnramified φ₀ → ∀ (J : Ideal B₀) [J.IsPrime],
          RingHom.FormallyUnramified (Localization.localRingHom (Ideal.comap φ₀ J) J φ₀ rfl) := by
      intro R₀ B₀ _ _ φ₀ hφ₀ J _
      let I := Ideal.comap φ₀ J
      let ψ := Localization.localRingHom I J φ₀ rfl
      let _ : Algebra R₀ B₀ := φ₀.toAlgebra
      let _ : Algebra (Localization.AtPrime I) (Localization.AtPrime J) := ψ.toAlgebra
      have : IsScalarTower R₀ (Localization.AtPrime I) (Localization.AtPrime J) :=
        ⟨fun r₀ x y => by
          rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc]
          congr 1
          change ψ (algebraMap R₀ (Localization.AtPrime I) r₀) =
            algebraMap R₀ (Localization.AtPrime J) r₀
          rw [Localization.localRingHom_to_map I J φ₀ rfl r₀,
            IsScalarTower.algebraMap_apply R₀ B₀ (Localization.AtPrime J)]
          rfl⟩
      have : Algebra.FormallyUnramified R₀ B₀ := hφ₀
      have : Algebra.FormallyUnramified B₀ (Localization.AtPrime J) :=
        Algebra.FormallyUnramified.of_isLocalization J.primeCompl
      have : Algebra.FormallyUnramified R₀ (Localization.AtPrime J) :=
        Algebra.FormallyUnramified.comp R₀ B₀ (Localization.AtPrime J)
      have : Subsingleton (KaehlerDifferential R₀ (Localization.AtPrime J)) :=
        Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
      have hSurjK : Function.Surjective
          (KaehlerDifferential.map R₀ (Localization.AtPrime I)
            (Localization.AtPrime J) (Localization.AtPrime J)) :=
        KaehlerDifferential.map_surjective R₀ (Localization.AtPrime I) (Localization.AtPrime J)
      have : Subsingleton
          (KaehlerDifferential (Localization.AtPrime I) (Localization.AtPrime J)) :=
        hSurjK.subsingleton
      change Algebra.FormallyUnramified (Localization.AtPrime I) (Localization.AtPrime J)
      exact (Algebra.formallyUnramified_iff _ _).mpr inferInstance
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext ⟨U⟩
    apply AddCommGrpCat.ext
    intro s
    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let R_U : CategoryTheory.Sieve U :=
      { arrows := fun V v => 𝒢.obj.map (Opposite.op v) s = 0
        downward_closed := fun {V W} v hv w =>
          (hMapComp 𝒢.obj w v s).trans
            ((congrArg (𝒢.obj.map (Opposite.op w)) hv).trans
              (𝒢.obj.map (Opposite.op w)).hom.map_zero) }
    have hCov : R_U ∈ S₀.smallEtaleTopology U := by
      have hJ :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S₀ (le_refl _)
      have hmem := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) U R_U).mpr fun z => by
        let y : ↥S₀ := U.hom.base z
        let κ_y := S₀.residueField y
        let Ω_y := AlgebraicClosure ↥κ_y
        let g_y : AlgebraicGeometry.Spec (CommRingCat.of Ω_y) ⟶ S₀ :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ_y Ω_y)) ≫
            S₀.fromSpecResidueField y
        have hEt_U : AlgebraicGeometry.Etale U.hom := U.prop
        have hStalkUnram : RingHom.FormallyUnramified (U.hom.stalkMap z).hom :=
          @AlgebraicGeometry.HasRingHomProperty.stalkMap (@AlgebraicGeometry.FormallyUnramified) _ _
            _ _ U.hom (@hLocUnram) inferInstance z
        have hStalkEFT : RingHom.EssFiniteType (U.hom.stalkMap z).hom :=
          AlgebraicGeometry.LocallyOfFiniteType.stalkMap U.hom z
        let R_Sy := ↑(S₀.presheaf.stalk y)
        let R_Uz := ↑(U.left.presheaf.stalk z)
        let _ : Algebra R_Sy R_Uz := (U.hom.stalkMap z).hom.toAlgebra
        have : IsLocalHom (algebraMap R_Sy R_Uz) :=
          show IsLocalHom (U.hom.stalkMap z).hom from inferInstance
        have : Algebra.FormallyUnramified R_Sy R_Uz := hStalkUnram
        have : Algebra.EssFiniteType R_Sy R_Uz := hStalkEFT
        have hFinRes : Module.Finite (IsLocalRing.ResidueField R_Sy) (IsLocalRing.ResidueField R_Uz) :=
          Algebra.instFiniteResidueFieldOfFormallyUnramified
        have hFinResHom : RingHom.Finite (U.hom.residueFieldMap z).hom :=
          RingHom.finite_algebraMap.mpr hFinRes
        let _ : Algebra ↥κ_y ↥(U.left.residueField z) := (U.hom.residueFieldMap z).hom.toAlgebra
        have : Module.Finite ↥κ_y ↥(U.left.residueField z) := hFinResHom
        have : Algebra.IsAlgebraic ↥κ_y ↥(U.left.residueField z) :=
          Algebra.IsAlgebraic.of_finite ↥κ_y ↥(U.left.residueField z)
        let emb : ↥(U.left.residueField z) →ₐ[↥κ_y] Ω_y := IsAlgClosed.lift
        let u_z : AlgebraicGeometry.Spec (CommRingCat.of Ω_y) ⟶ U.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom emb.toRingHom) ≫
            U.left.fromSpecResidueField z
        have hcomm : U.hom.residueFieldMap z ≫ CommRingCat.ofHom emb.toRingHom =
            CommRingCat.ofHom (algebraMap ↥κ_y Ω_y) := by
          ext c
          exact emb.commutes c
        have hu_z : u_z ≫ U.hom = g_y :=
          (CategoryTheory.Category.assoc _ _ U.hom).trans
            ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom emb.toRingHom) ≫ ·)
              (AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField U.hom z).symm).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ S₀.fromSpecResidueField y)
                  ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
                    (congrArg AlgebraicGeometry.Spec.map hcomm)))))
        obtain ⟨V_z, v_z, w_z, hw_z, hv_z_zero⟩ := hStalkAll y U u_z hu_z s
        have hEt_Vz : AlgebraicGeometry.Etale V_z.hom := V_z.prop
        have hEt_vz : AlgebraicGeometry.Etale v_z.left := by
          have hw_ov : v_z.left ≫ U.hom = V_z.hom := CategoryTheory.MorphismProperty.Over.w v_z
          exact CategoryTheory.MorphismProperty.of_postcomp
            (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
            v_z.left U.hom hEt_U (hw_ov.symm ▸ hEt_Vz)
        let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_y)) := (⊥ : PrimeSpectrum Ω_y)
        refine ⟨V_z, v_z, w_z.base pt₀, hv_z_zero, hEt_vz, ?_⟩
        exact (AlgebraicGeometry.Scheme.Hom.comp_apply w_z v_z.left pt₀).symm.trans
          ((congrArg (fun k => k.base pt₀) hw_z).trans
            ((AlgebraicGeometry.Scheme.Hom.comp_apply _ _ pt₀).trans
              (AlgebraicGeometry.Scheme.fromSpecResidueField_apply z _)))
      exact Eq.mp (congrArg (fun G => R_U ∈ G U) hJ.symm) hmem
    have hSep := (CategoryTheory.Presheaf.IsSheaf.isSeparated 𝒢.property) U R_U hCov
    exact hSep s 0 (fun V v hv => hv.trans (𝒢.obj.map (Opposite.op v)).hom.map_zero.symm)
  
  have hPillar3_ConstPull : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂)
      (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro Y₁ Y₂ h A
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
