    intro SC hSE z₃
    have _ : CategoryTheory.Projective Fℤ_Ω := hProj_Ω
    have hSub₁ : Subsingleton (CategoryTheory.Abelian.Ext Fℤ_Ω SC.X₁ 1) :=
