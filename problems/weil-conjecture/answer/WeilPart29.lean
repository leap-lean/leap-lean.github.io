      (fun E L _ _ _ _ _ _ _ n hn => weil_tsen_c1_galois_units_cohomology_vanishing Ω E L n hn)
      U W w p c' hc'
    refine ⟨(isoK.hom.app (Opposite.op (weilEtaleCechObj w p))).hom b', ?_⟩
    rw [← hCech_nat isoK.hom p b', hb']
    exact ConcreteCategory.congr_hom
      (congrArg
        (fun φ : (weilEtaleKSheaf Y.left).obj ⟶ (weilEtaleKSheaf Y.left).obj =>
          φ.app (Opposite.op (weilEtaleCechObj w (p + 1))))
        isoK.inv_hom_id) c

