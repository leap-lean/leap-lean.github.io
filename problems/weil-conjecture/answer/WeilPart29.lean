    let T_P1 := weilEtaleIdTerminal.{u} P1.left
    let hT_P1 := weilEtaleIdTerminalIsTerminal.{u} P1.left

    have hIso_πMs : CategoryTheory.IsIso (weilEtaleConstPullbackHom s hT_Sk hT_B AM) :=
