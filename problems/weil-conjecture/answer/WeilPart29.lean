        ⟨fun {Z} h₁ h₂ hh => by
          have hsub : e_T ≫ (h₁ - h₂) = 0 := by
            rw [CategoryTheory.Preadditive.comp_sub, hh, sub_self]
          have hdesc : π_coker ≫ CategoryTheory.Limits.cokernel.desc e_T (h₁ - h₂) hsub =
              h₁ - h₂ :=
            CategoryTheory.Limits.cokernel.π_desc e_T (h₁ - h₂) hsub
          rw [hπ_zero, CategoryTheory.Limits.zero_comp] at hdesc
          exact sub_eq_zero.mp hdesc.symm⟩
      have hSurj_T : Function.Surjective e_T.hom :=
        (AddCommGrpCat.epi_iff_surjective e_T).mp hEpi_T
      let f_sharp : Aℤ ⟶ (Γ_T.obj (Opposite.op T)).obj X := adj_const.homEquiv Aℤ X f
      obtain ⟨y₁, hy₁⟩ := hSurj_T (f_sharp.hom (ULift.up 1))
      let g_sharp : Aℤ ⟶ (Γ_T.obj (Opposite.op T)).obj E :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • y₁
            map_zero' := zero_zsmul y₁
            map_add' := fun a b => add_zsmul y₁ a.down b.down }
      have hg_comp : g_sharp ≫ (Γ_T.obj (Opposite.op T)).map e = f_sharp := by
        ext ⟨n⟩
        change e_T.hom (n • y₁) = f_sharp.hom (ULift.up n)
        have hn : (ULift.up n : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) := by
          ext
          change n = n • (1 : ℤ)
          simp
        rw [map_zsmul, hy₁, hn, map_zsmul]
      refine ⟨(adj_const.homEquiv Aℤ E).symm g_sharp, ?_⟩
      rw [← adj_const.homEquiv_naturality_right_symm g_sharp e, hg_comp,
        Equiv.symm_apply_apply]
    · 
      intro 𝒟 _ K B hc ℋ M φ hCompat hZeroHom U τ
      let pf_B := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ K J hc
      let γ : ℋ ⟶ pf_B.obj (SkyObj M) :=
        { hom :=
            { app := fun W => AddCommGrpCat.ofHom
                { toFun := fun s σ => (φ (Opposite.unop W) σ).hom s
                  map_zero' := by
                    funext σ
                    exact map_zero _
                  map_add' := fun s₁ s₂ => by
                    funext σ
                    exact map_add _ s₁ s₂ }
              naturality := fun {W₁ W₂} v => by
                rcases v with ⟨v₀⟩
                ext s
                funext σ
                change (φ (Opposite.unop W₂) σ).hom ((ℋ.obj.map (Opposite.op v₀)).hom s) =
                  (φ (Opposite.unop W₁) (σ ≫ B.map v₀)).hom s
                exact congrArg (fun k => k.hom s) (hCompat v₀ σ) } }
      have hγ0 : γ = 0 := hZeroHom (SkyObj M) γ
      ext s
      exact congrArg (fun k : ℋ ⟶ pf_B.obj (SkyObj M) => ((k.hom.app (Opposite.op U)).hom s) τ) hγ0

  
  have hSitePointStalk : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (ℋ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (x : ↥S),
      let Ω_x := AlgebraicClosure ↥(S.residueField x)
      let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
      let g_x := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x)))
        (S.fromSpecResidueField x)
      (∃ (hc : (weilAltCdSitePullback g_x).IsContinuous S.smallEtaleTopology S_x.smallEtaleTopology)
        (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf S_x.smallEtaleTopology AddCommGrpCat.{u}))
        (_ : P_pull ⊣ @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdSitePullback g_x) AddCommGrpCat.{u} _
          S.smallEtaleTopology S_x.smallEtaleTopology hc),
        CategoryTheory.Limits.IsZero (P_pull.obj ℋ)) →
      WeilAltCdStalkZeroAt S ℋ x := by
    intro S ℋ x Ω_x S_x g_x ⟨hc, P_pull, adj, hZero_pull⟩
    let T_x := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_x) inferInstance
    let B_g := weilAltCdSitePullback g_x
    let pf_x := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_g AddCommGrpCat.{u} _ S.smallEtaleTopology S_x.smallEtaleTopology hc
    have hZeroHom : ∀ (𝒢 : CategoryTheory.Sheaf S_x.smallEtaleTopology AddCommGrpCat.{u})
        (γ : Quiver.Hom ℋ (pf_x.obj 𝒢)), γ = 0 := by
      intro 𝒢 γ
      apply (adj.homEquiv ℋ 𝒢).symm.injective
      exact hZero_pull.eq_of_src _ _
    let F_g : S.Etale ⥤ Type u := B_g ⋙ CategoryTheory.coyoneda.obj (Opposite.op T_x)
    
    let π_fst : ∀ (W : S.Etale), (B_g.obj W).left ⟶ W.left :=
      fun W => CategoryTheory.Limits.pullback.fst W.hom g_x
    let π_snd : ∀ (W : S.Etale), (B_g.obj W).left ⟶ S_x :=
      fun W => CategoryTheory.Limits.pullback.snd W.hom g_x
    let mkSec : ∀ (W : S.Etale) (u_W : S_x ⟶ W.left),
        u_W ≫ W.hom = g_x → F_g.obj W :=
      fun W u_W hu_W =>
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift u_W (𝟙 S_x)
            (hu_W.trans (CategoryTheory.Category.id_comp g_x).symm))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have hmkSec_fst : ∀ (W : S.Etale) (u_W : S_x ⟶ W.left) (hu_W : u_W ≫ W.hom = g_x),
        (mkSec W u_W hu_W).left ≫ π_fst W = u_W :=
      fun W u_W hu_W => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have htau_hom : ∀ (W : S.Etale) (τ : F_g.obj W),
        (τ.left ≫ π_fst W) ≫ W.hom = g_x :=
      fun W τ =>
        (CategoryTheory.Category.assoc τ.left (π_fst W) W.hom).trans
          ((congrArg (τ.left ≫ ·)
            (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := g_x))).trans
            ((CategoryTheory.Category.assoc τ.left (π_snd W) g_x).symm.trans
              ((congrArg (· ≫ g_x) (CategoryTheory.MorphismProperty.Over.w τ)).trans
                (CategoryTheory.Category.id_comp g_x))))
    have hBg_map_fst_snd : ∀ {W₁ W₂ : S.Etale} (f : W₁ ⟶ W₂),
        ((B_g.map f).left ≫ π_fst W₂ = π_fst W₁ ≫ f.left) ∧
        ((B_g.map f).left ≫ π_snd W₂ = π_snd W₁) := by
      intro W₁ W₂ f
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have : P_et.HasPullbacksAlong g_x :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      have : P_et.IsStableUnderBaseChangeAlong g_x :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      have hmap_left : (B_g.map f).left =
          CategoryTheory.Limits.pullback.lift (π_fst W₁ ≫ f.left) (π_snd W₁)
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (π_fst W₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w f)).trans
                CategoryTheory.Limits.pullback.condition)) :=
        CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ g_x f
      exact ⟨(congrArg (· ≫ CategoryTheory.Limits.pullback.fst W₂.hom g_x) hmap_left).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _),
        (congrArg (· ≫ CategoryTheory.Limits.pullback.snd W₂.hom g_x) hmap_left).trans
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩
    have hFg_map_eq : ∀ {W₁ W₂ : S.Etale} (f : W₁ ⟶ W₂) (τ₁ : F_g.obj W₁) (τ₂ : F_g.obj W₂),
        (τ₁.left ≫ π_fst W₁) ≫ f.left = τ₂.left ≫ π_fst W₂ →
        F_g.map f τ₁ = τ₂ := by
      intro W₁ W₂ f τ₁ τ₂ hEq
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc τ₁.left (B_g.map f).left (π_fst W₂)).trans
          ((congrArg (τ₁.left ≫ ·) (hBg_map_fst_snd f).1).trans
            ((CategoryTheory.Category.assoc τ₁.left (π_fst W₁) f.left).symm.trans hEq))
      · exact (CategoryTheory.Category.assoc τ₁.left (B_g.map f).left (π_snd W₂)).trans
          ((congrArg (τ₁.left ≫ ·) (hBg_map_fst_snd f).2).trans
            ((CategoryTheory.MorphismProperty.Over.w τ₁).trans
              (CategoryTheory.MorphismProperty.Over.w τ₂).symm))
    have hFg_map_fst : ∀ {W₁ W₂ : S.Etale} (f : W₁ ⟶ W₂) (τ₁ : F_g.obj W₁),
        ((F_g.map f τ₁).left ≫ π_fst W₂) = (τ₁.left ≫ π_fst W₁) ≫ f.left :=
      fun {W₁ W₂} f τ₁ =>
        (CategoryTheory.Category.assoc τ₁.left (B_g.map f).left (π_fst W₂)).trans
          ((congrArg (τ₁.left ≫ ·) (hBg_map_fst_snd f).1).trans
            (CategoryTheory.Category.assoc τ₁.left (π_fst W₁) f.left).symm)
    
    have : CategoryTheory.Limits.PreservesFiniteLimits B_g :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) g_x
    have hCof : CategoryTheory.IsCofiltered F_g.Elements :=
      CategoryTheory.Functor.isCofiltered_elements F_g
    let pt₀ : ↥S_x := default
    have hInitSmall : CategoryTheory.InitiallySmall.{u} F_g.Elements := by
      rw [CategoryTheory.initiallySmall_iff_exists_small_weakly_initial_set]
      let e_sm := CategoryTheory.equivSmallModel.{u} S.AffineEtale
      let ι_S := AlgebraicGeometry.Scheme.AffineEtale.Spec S
      let G_S : CategoryTheory.SmallModel.{u} S.AffineEtale ⥤ S.Etale := e_sm.inverse ⋙ ι_S
      let Idx : Type u := Σ (m : CategoryTheory.SmallModel.{u} S.AffineEtale), F_g.obj (G_S.obj m)
      let idx_fn : Idx → F_g.Elements := fun p => F_g.elementsMk (G_S.obj p.1) p.2
      refine ⟨Set.range idx_fn, small_range idx_fn, fun z => ?_⟩
      let W : S.Etale := z.obj
      let τ : F_g.obj W := z.val
      have : AlgebraicGeometry.Etale W.hom := W.prop
      let u_S : S_x ⟶ W.left := τ.left ≫ π_fst W
      have hu_S : u_S ≫ W.hom = g_x := htau_hom W τ
      obtain ⟨W₀, hW₀, hmem₀, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (by trivial : u_S.base pt₀ ∈ (⊤ : W.left.Opens))
      let R₀ : CommRingCat.{u} := W.left.presheaf.obj (Opposite.op W₀)
      let j₀ : AlgebraicGeometry.Spec R₀ ⟶ W.left := hW₀.fromSpec
      have hrange : Set.range ⇑u_S ⊆ Set.range ⇑j₀ := by
        rw [hW₀.range_fromSpec]
        rintro _ ⟨pt, rfl⟩
        have hpt : pt = pt₀ := Subsingleton.elim pt pt₀
        subst hpt
        exact hmem₀
      let u_aff : S_x ⟶ AlgebraicGeometry.Spec R₀ :=
        AlgebraicGeometry.IsOpenImmersion.lift j₀ u_S hrange
      have hu_aff : u_aff ≫ j₀ = u_S :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j₀ u_S hrange
      have : AlgebraicGeometry.Etale (j₀ ≫ W.hom) := inferInstance
      let A₀ : S.AffineEtale := AlgebraicGeometry.Scheme.AffineEtale.mk (j₀ ≫ W.hom)
      let f_aff : ι_S.obj A₀ ⟶ W := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
      let m : CategoryTheory.SmallModel.{u} S.AffineEtale := e_sm.functor.obj A₀
      let e_m : G_S.obj m ≅ ι_S.obj A₀ := ι_S.mapIso (e_sm.unitIso.app A₀).symm
      let f_m : G_S.obj m ⟶ W := e_m.hom ≫ f_aff
      let u_m : S_x ⟶ (G_S.obj m).left := u_aff ≫ e_m.inv.left
      have he_inv_hom : e_m.inv.left ≫ e_m.hom.left = 𝟙 _ := by
        have hid := congrArg (fun k : ι_S.obj A₀ ⟶ ι_S.obj A₀ => k.left) e_m.inv_hom_id
        exact hid
      have hu_m_f : u_m ≫ f_m.left = u_S :=
        (CategoryTheory.Category.assoc u_aff e_m.inv.left (e_m.hom.left ≫ j₀)).trans
          ((congrArg (u_aff ≫ ·)
            ((CategoryTheory.Category.assoc e_m.inv.left e_m.hom.left j₀).symm.trans
              ((congrArg (· ≫ j₀) he_inv_hom).trans (CategoryTheory.Category.id_comp j₀)))).trans
            hu_aff)
      have hu_m_hom : u_m ≫ (G_S.obj m).hom = g_x :=
        (congrArg (u_m ≫ ·) (CategoryTheory.MorphismProperty.Over.w f_m).symm).trans
          ((CategoryTheory.Category.assoc u_m f_m.left W.hom).symm.trans
            ((congrArg (· ≫ W.hom) hu_m_f).trans hu_S))
      let τ_m : F_g.obj (G_S.obj m) := mkSec (G_S.obj m) u_m hu_m_hom
      have hmap_m : F_g.map f_m τ_m = τ :=
        hFg_map_eq f_m τ_m τ
          ((congrArg (· ≫ f_m.left) (hmkSec_fst (G_S.obj m) u_m hu_m_hom)).trans hu_m_f)
      exact ⟨idx_fn ⟨m, τ_m⟩, ⟨⟨m, τ_m⟩, rfl⟩,
        ⟨CategoryTheory.Functor.Elements.homMk (f := f_m) hmap_m⟩⟩
    let Φ_x : CategoryTheory.GrothendieckTopology.Point.{u} S.smallEtaleTopology :=
      { fiber := F_g
        isCofiltered := hCof
        initiallySmall := hInitSmall
        jointly_surjective := by
          let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
            @AlgebraicGeometry.Etale
          intro W R hR τ
          let u_S : S_x ⟶ W.left := τ.left ≫ π_fst W
