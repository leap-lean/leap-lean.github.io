      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology
      (@AlgebraicGeometry.Etale) S U ↔ _
    rw [@AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) S hStab _ _ _ _
          (le_refl (@AlgebraicGeometry.Etale))]
