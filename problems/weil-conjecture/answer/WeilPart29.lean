        · refine ⟨r_x, 1, 0, 0, hr_x_ne, one_ne_zero, ?_, ?_, ?_, ?_⟩
          · rw [map_one, mul_one]
            exact hr_x_K
          · rw [pow_zero, Ideal.one_eq_top]
            let p_x : ↥(AlgebraicGeometry.Spec (P1.left.presheaf.obj (Opposite.op U_aff))) :=
              hAff_U.primeIdealOf ⟨x.1, hx_mem⟩
            have hbc_not : b_c ∉ p_x.asIdeal := by
              intro hbc_in
