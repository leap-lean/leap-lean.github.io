        CategoryTheory.Category.comp_id]
    have hEpi_pf : CategoryTheory.Epi (pf.map p) := by
      change CategoryTheory.Epi f₂₃
      rw [hf₂₃_eq]
      haveI : CategoryTheory.Epi (ηI.hom ≫ Shf_S.map f₂₃.hom) :=
        CategoryTheory.epi_comp ηI.hom (Shf_S.map f₂₃.hom)
      exact CategoryTheory.epi_comp (ηI.hom ≫ Shf_S.map f₂₃.hom) ηQ.inv
    exact ⟨hjp_pf, CategoryTheory.ShortComplex.ShortExact.mk' hEx_pf hMono_pf hEpi_pf⟩
  let I₀ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Injective.under ℱ
  let j₀ : ℱ ⟶ I₀ := CategoryTheory.Injective.ι ℱ
  let Q₁ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel j₀
  let p₀ : I₀ ⟶ Q₁ := CategoryTheory.Limits.cokernel.π j₀
  have hjp₀ : j₀ ≫ p₀ = 0 := CategoryTheory.Limits.cokernel.condition j₀
  have hSE₀ : (CategoryTheory.ShortComplex.mk j₀ p₀ hjp₀).ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_g_is_cokernel
        (CategoryTheory.ShortComplex.mk j₀ p₀ hjp₀)
        (CategoryTheory.Limits.cokernelIsCokernel j₀))
      (inferInstance : CategoryTheory.Mono j₀)
      (inferInstance : CategoryTheory.Epi p₀)
  haveI hInj_I₀ : CategoryTheory.Injective I₀ := inferInstance
  haveI hInj_pf_I₀ : CategoryTheory.Injective (pf.obj I₀) := hInjPush I₀ hInj_I₀
  have hR1' : CategoryTheory.Limits.IsZero (weilAltCdHigherDirectImage h 1 ℱ) := hR1
  obtain ⟨hjp₀_pf, hSE₀_pf⟩ := hPushSES ℱ I₀ Q₁ hInj_I₀ j₀ p₀ hjp₀ hSE₀ hR1'
  obtain ⟨e_shift⟩ := hShiftIso ℱ I₀ Q₁ hInj_I₀ j₀ p₀ hjp₀ hSE₀
  have hR2' : CategoryTheory.Limits.IsZero (weilAltCdHigherDirectImage h 2 ℱ) := hR2
  have hZ1_Q₁ : CategoryTheory.Limits.IsZero (weilAltCdHigherDirectImage h 1 Q₁) :=
    CategoryTheory.Limits.IsZero.of_iso hR2' e_shift
  let I₁ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Injective.under Q₁
  let j₁ : Q₁ ⟶ I₁ := CategoryTheory.Injective.ι Q₁
  let Q₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel j₁
  let p₁ : I₁ ⟶ Q₂ := CategoryTheory.Limits.cokernel.π j₁
  have hjp₁ : j₁ ≫ p₁ = 0 := CategoryTheory.Limits.cokernel.condition j₁
  have hSE₁ : (CategoryTheory.ShortComplex.mk j₁ p₁ hjp₁).ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_g_is_cokernel
        (CategoryTheory.ShortComplex.mk j₁ p₁ hjp₁)
        (CategoryTheory.Limits.cokernelIsCokernel j₁))
      (inferInstance : CategoryTheory.Mono j₁)
      (inferInstance : CategoryTheory.Epi p₁)
  haveI hInj_I₁ : CategoryTheory.Injective I₁ := inferInstance
  haveI hInj_pf_I₁ : CategoryTheory.Injective (pf.obj I₁) := hInjPush I₁ hInj_I₁
  obtain ⟨hjp₁_pf, hSE₁_pf⟩ := hPushSES Q₁ I₁ Q₂ hInj_I₁ j₁ p₁ hjp₁ hSE₁ hZ1_Q₁
  let L : ∀ (M : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Abelian.Ext.{u} Fℤ_S (pf.obj M) q →+
        CategoryTheory.Abelian.Ext.{u} Fℤ_X M q :=
    fun M q =>
      ((CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app M)).postcomp Fℤ_X (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb.obj (pf.obj M))
          (Nat.zero_add q)).comp
          (pb.mapExtAddHom Fℤ_S (pf.obj M) q))
  have hL0_mk₀ : ∀ (M : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (g : Fℤ_S ⟶ pf.obj M),
      L M 0 (CategoryTheory.Abelian.Ext.mk₀ g) =
        CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ (adj.homEquiv Fℤ_S M).symm g) := by
    intro M g
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        (pb.mapExtAddHom Fℤ_S (pf.obj M) 0 (CategoryTheory.Abelian.Ext.mk₀ g))
        (Nat.zero_add 0)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app M)) (Nat.add_zero 0) = _
    rw [CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Category.assoc,
      ← adj.homEquiv_counit Fℤ_S M g]
  have hL0_bij : ∀ M : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      Function.Bijective (L M 0) := by
    intro M
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun α => CategoryTheory.Abelian.Ext.mk₀
        (adj.homEquiv Fℤ_S M (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α)), ?_, ?_⟩
    · intro β
      dsimp only
      set g : Fℤ_S ⟶ pf.obj M := CategoryTheory.Abelian.Ext.addEquiv₀ β
      have hg : CategoryTheory.Abelian.Ext.mk₀ g = β :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply β
      rw [← hg, hL0_mk₀ M g,
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply
          (ιℤ ≫ (adj.homEquiv Fℤ_S M).symm g),
        AddEquiv.apply_symm_apply]
      have hπ : πℤ ≫ (ιℤ ≫ (adj.homEquiv Fℤ_S M).symm g) = (adj.homEquiv Fℤ_S M).symm g := by
        rw [← CategoryTheory.Category.assoc, hπι, CategoryTheory.Category.id_comp]
      rw [hπ, Equiv.apply_symm_apply]
    · intro α
      dsimp only
      set f : Fℤ_X ⟶ M := CategoryTheory.Abelian.Ext.addEquiv₀ α
      have hf : CategoryTheory.Abelian.Ext.mk₀ f = α :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α
      rw [hL0_mk₀ M (adj.homEquiv Fℤ_S M (πℤ ≫ f)), Equiv.symm_apply_apply,
        ← CategoryTheory.Category.assoc, hιπ, CategoryTheory.Category.id_comp, hf]
  have hL0_nat : ∀ {M₁ M₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : M₁ ⟶ M₂)
      (β : CategoryTheory.Abelian.Ext.{u} Fℤ_S (pf.obj M₁) 0),
      L M₂ 0 (β.comp (CategoryTheory.Abelian.Ext.mk₀ (pf.map φ)) (Nat.add_zero 0)) =
        (L M₁ 0 β).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) := by
    intro M₁ M₂ φ β
    set g : Fℤ_S ⟶ pf.obj M₁ := CategoryTheory.Abelian.Ext.addEquiv₀ β
    have hg : CategoryTheory.Abelian.Ext.mk₀ g = β :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply β
    rw [← hg, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hL0_mk₀ M₂ (g ≫ pf.map φ), hL0_mk₀ M₁ g,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    congr 1
    have hcounit_φ : pb.map (pf.map φ) ≫ adj.counit.app M₂ = adj.counit.app M₁ ≫ φ :=
      adj.counit.naturality φ
    rw [adj.homEquiv_counit, adj.homEquiv_counit, pb.map_comp,
      CategoryTheory.Category.assoc, hcounit_φ]
    simp only [CategoryTheory.Category.assoc]
  have hL_delta : ∀ {M₁ M₂ M₃ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      (j : M₁ ⟶ M₂) (p : M₂ ⟶ M₃) (hjp : j ≫ p = 0)
      (hSE_top : (CategoryTheory.ShortComplex.mk j p hjp).ShortExact)
      (hjp_pf : pf.map j ≫ pf.map p = 0)
      (hSE_bot : (CategoryTheory.ShortComplex.mk (pf.map j) (pf.map p) hjp_pf).ShortExact)
      (q : ℕ) (γ : CategoryTheory.Abelian.Ext.{u} Fℤ_S (pf.obj M₃) q),
      L M₁ (q + 1) (γ.comp hSE_bot.extClass rfl) =
        (L M₃ q γ).comp hSE_top.extClass rfl := by
    intro M₁ M₂ M₃ j p hjp hSE_top hjp_pf hSE_bot q γ
    let S_top := CategoryTheory.ShortComplex.mk j p hjp
    let S_bot := CategoryTheory.ShortComplex.mk (pf.map j) (pf.map p) hjp_pf
    have hSE_pb : (S_bot.map pb).ShortExact := hSE_bot.map_of_exact pb
    let ε_S : S_bot.map pb ⟶ S_top :=
      { τ₁ := adj.counit.app M₁
        τ₂ := adj.counit.app M₂
        τ₃ := adj.counit.app M₃
        comm₁₂ := (adj.counit.naturality j).symm
        comm₂₃ := (adj.counit.naturality p).symm }
    have h_nat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb hSE_top ε_S
    have h_map : pb.mapExtAddHom Fℤ_S (pf.obj M₁) (q + 1) (γ.comp hSE_bot.extClass rfl) =
        (pb.mapExtAddHom Fℤ_S (pf.obj M₃) q γ).comp hSE_pb.extClass rfl := by
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        (pb.mapExtAddHom Fℤ_S (pf.obj M₁) (q + 1) (γ.comp hSE_bot.extClass rfl))
        (Nat.zero_add (q + 1))).comp
      (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app M₁)) (Nat.add_zero (q + 1)) =
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (pb.mapExtAddHom Fℤ_S (pf.obj M₃) q γ) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app M₃)) (Nat.add_zero q)).comp
        hSE_top.extClass rfl
    rw [h_map,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        (pb.mapExtAddHom Fℤ_S (pf.obj M₃) q γ) hSE_pb.extClass
        (Nat.zero_add q) rfl (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (pb.mapExtAddHom Fℤ_S (pf.obj M₃) q γ) (Nat.zero_add q))
        hSE_pb.extClass (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app M₁))
        rfl (Nat.add_zero 1) (by omega),
      h_nat,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (pb.mapExtAddHom Fℤ_S (pf.obj M₃) q γ) (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app M₃)) hSE_top.extClass
        (Nat.add_zero q) (Nat.zero_add 1) (by omega)]
  have hL1_Q₁ : Function.Bijective (L Q₁ 1) := by
    refine ⟨?_, ?_⟩
    · intro x₁ x₂ hx_eq
      apply sub_eq_zero.mp
      set x := x₁ - x₂
      have hx : L Q₁ 1 x = 0 := by
        dsimp only [x]
        rw [map_sub, hx_eq, sub_self]
      have hxj : x.comp (CategoryTheory.Abelian.Ext.mk₀ (pf.map j₁)) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective (n := 0) _
      obtain ⟨c_bot, hc_bot⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_S hSE₁_pf x hxj (rfl : 0 + 1 = 1)
      have hc_top0 : (L Q₂ 0 c_bot).comp hSE₁.extClass (rfl : 0 + 1 = 1) = 0 := by
        rw [← hL_delta j₁ p₁ hjp₁ hSE₁ hjp₁_pf hSE₁_pf 0 c_bot, hc_bot, hx]
      obtain ⟨b_top, hb_top⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_X hSE₁
          (L Q₂ 0 c_bot) (rfl : 0 + 1 = 1) hc_top0
      obtain ⟨b_bot, hb_bot⟩ := (hL0_bij I₁).2 b_top
      have hc_eq : b_bot.comp (CategoryTheory.Abelian.Ext.mk₀ (pf.map p₁)) (Nat.add_zero 0) = c_bot := by
        apply (hL0_bij Q₂).1
        rw [hL0_nat p₁ b_bot, hb_bot, hb_top]
      rw [← hc_bot, ← hc_eq,
        CategoryTheory.Abelian.Ext.comp_assoc b_bot
          (CategoryTheory.Abelian.Ext.mk₀ (pf.map p₁)) hSE₁_pf.extClass
          (Nat.add_zero 0) (Nat.zero_add 1) (by omega),
        hSE₁_pf.comp_extClass]
      exact CategoryTheory.Abelian.Ext.comp_zero b_bot (pf.obj Q₁) 1 1 _
    · intro y
      have hyj : y.comp (CategoryTheory.Abelian.Ext.mk₀ j₁) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective (n := 0) _
      obtain ⟨c_top, hc_top⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X hSE₁ y hyj (rfl : 0 + 1 = 1)
      obtain ⟨c_bot, hc_bot⟩ := (hL0_bij Q₂).2 c_top
      refine ⟨c_bot.comp hSE₁_pf.extClass (rfl : 0 + 1 = 1), ?_⟩
      rw [hL_delta j₁ p₁ hjp₁ hSE₁ hjp₁_pf hSE₁_pf 0 c_bot, hc_bot, hc_top]
  have hL2_ℱ : Function.Bijective (L ℱ 2) := by
    refine ⟨?_, ?_⟩
    · intro z₁ z₂ hz_eq
      apply sub_eq_zero.mp
      set z := z₁ - z₂
      have hz : L ℱ 2 z = 0 := by
        dsimp only [z]
        rw [map_sub, hz_eq, sub_self]
      have hzj : z.comp (CategoryTheory.Abelian.Ext.mk₀ (pf.map j₀)) (Nat.add_zero 2) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective (n := 1) _
      obtain ⟨u_bot, hu_bot⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_S hSE₀_pf z hzj (rfl : 1 + 1 = 2)
      have hu_top0 : (L Q₁ 1 u_bot).comp hSE₀.extClass (rfl : 1 + 1 = 2) = 0 := by
        rw [← hL_delta j₀ p₀ hjp₀ hSE₀ hjp₀_pf hSE₀_pf 1 u_bot, hu_bot, hz]
      obtain ⟨v_top, hv_top⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_X hSE₀
          (L Q₁ 1 u_bot) (rfl : 1 + 1 = 2) hu_top0
      have hv_zero : v_top = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective (n := 0) v_top
      have hu_bot_zero : u_bot = 0 := by
        apply hL1_Q₁.1
        rw [map_zero, ← hv_top, hv_zero]
        exact CategoryTheory.Abelian.Ext.zero_comp Fℤ_X 1
          (CategoryTheory.Abelian.Ext.mk₀ p₀) 1 _
      rw [← hu_bot, hu_bot_zero]
      exact CategoryTheory.Abelian.Ext.zero_comp Fℤ_S 1 hSE₀_pf.extClass 2 _
    · intro w
      have hwj : w.comp (CategoryTheory.Abelian.Ext.mk₀ j₀) (Nat.add_zero 2) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective (n := 1) _
      obtain ⟨u_top, hu_top⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X hSE₀ w hwj (rfl : 1 + 1 = 2)
      obtain ⟨u_bot, hu_bot⟩ := hL1_Q₁.2 u_top
      refine ⟨u_bot.comp hSE₀_pf.extClass (rfl : 1 + 1 = 2), ?_⟩
      rw [hL_delta j₀ p₀ hjp₀ hSE₀ hjp₀_pf hSE₀_pf 1 u_bot, hu_bot, hu_top]
  have h_eq : (leray : (pf.obj ℱ).H 2 → ℱ.H 2) = ⇑(L ℱ 2) := by
    funext β
    exact hleray β
  rw [h_eq]
  exact hL2_ℱ

theorem weil_local_torsion_clopen_open_partition_and_pullback_proj : (∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (U : S.Etale)
        (s : ℕ) (U_comp : Fin s → S.Etale)
        (ι_comp : ∀ α : Fin s, Quiver.Hom (U_comp α) U),
      (∀ α : Fin s,
        AlgebraicGeometry.IsOpenImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp α)).left)) →
      (⋃ α : Fin s,
        Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp α)).left).base) =
        Set.univ →
      (∀ α β : Fin s, α ≠ β →
        Disjoint
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp α)).left).base)
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (ι_comp β)).left).base)) →
      let L := weilGysinLocalTorsionSheaf S m U
      let L_comp := fun α : Fin s => weilGysinLocalTorsionSheaf S m (U_comp α)
      let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      ∃ (inc : ∀ α : Fin s, Quiver.Hom (L_comp α) L)
        (proj : ∀ α : Fin s, Quiver.Hom L (L_comp α)),
        (∀ α : Fin s,
          CategoryTheory.Sheaf.freeYonedaHomEquiv (inc α) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L))
              (L.obj.map (Opposite.op (ι_comp α)))) ∧
        (∀ α : Fin s,
          CategoryTheory.CategoryStruct.comp (inc α) (proj α) =
            CategoryTheory.CategoryStruct.id (L_comp α)) ∧
        (∀ α β : Fin s, α ≠ β →
          CategoryTheory.CategoryStruct.comp (inc α) (proj β) = 0) ∧
        (∑ α : Fin s, CategoryTheory.CategoryStruct.comp (proj α) (inc α)) =
          CategoryTheory.CategoryStruct.id L ∧
        (∀ (q : ℕ) (z : weilGysinLocalTorsionH S m U q),
          weilGysinLocalTorsionCounitH S m U q z =
            ∑ α : Fin s,
              weilGysinLocalTorsionCounitH S m (U_comp α) q
                ((CategoryTheory.Abelian.Ext.mk₀ (proj α)).postcomp Fℤ (Nat.add_zero q) z))) ∧
    (∀ (C₀ P₀ : AlgebraicGeometry.Scheme.{u})
        (π : Quiver.Hom C₀ P₀) [AlgebraicGeometry.IsSeparated π]
        (C_open : C₀.Opens) (s : ℕ) (C_comp : Fin s → C₀.Opens)
        (h_le : ∀ α : Fin s, C_comp α ≤ C_open)
        (u : Quiver.Hom C_open.toScheme P₀) (hu : AlgebraicGeometry.Etale u)
        (hu_eq : CategoryTheory.CategoryStruct.comp C_open.ι π = u)
        (hu_comp : ∀ α : Fin s,
          AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp (C_comp α).ι π))
        (m q : ℕ)
        (z_P : weilGysinLocalTorsionH P₀ m (weilGysinEtaleObj u hu) q)
        (z_C : weilGysinLocalTorsionH C₀ m (weilGysinEtaleObj C_open.ι inferInstance) q),
      let U_C := weilGysinEtaleObj C_open.ι inferInstance
      let U_P := weilGysinEtaleObj u hu
      let U_C_comp := fun α : Fin s => weilGysinEtaleObj (C_comp α).ι inferInstance
      let U_P_comp := fun α : Fin s =>
        weilGysinEtaleObj (CategoryTheory.CategoryStruct.comp (C_comp α).ι π) (hu_comp α)
      let ι_C_comp : ∀ α : Fin s, Quiver.Hom (U_C_comp α) U_C := fun α =>
        CategoryTheory.MorphismProperty.Over.homMk (C₀.homOfLE (h_le α))
          (AlgebraicGeometry.Scheme.homOfLE_ι C₀ (h_le α))
      let ι_P_comp : ∀ α : Fin s, Quiver.Hom (U_P_comp α) U_P := fun α =>
        CategoryTheory.MorphismProperty.Over.homMk (C₀.homOfLE (h_le α))
          ((congrArg (CategoryTheory.CategoryStruct.comp (C₀.homOfLE (h_le α))) hu_eq.symm).trans
            (AlgebraicGeometry.Scheme.homOfLE_ι_assoc C₀ (h_le α) π))
      let L_C := weilGysinLocalTorsionSheaf C₀ m U_C
      let L_P := weilGysinLocalTorsionSheaf P₀ m U_P
      let L_C_comp := fun α : Fin s => weilGysinLocalTorsionSheaf C₀ m (U_C_comp α)
      let L_P_comp := fun α : Fin s => weilGysinLocalTorsionSheaf P₀ m (U_P_comp α)
      let Fℤ_C := (CategoryTheory.constantSheaf C₀.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      let Fℤ_P := (CategoryTheory.constantSheaf P₀.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      ∀ (inc_C : ∀ α : Fin s, Quiver.Hom (L_C_comp α) L_C)
        (proj_C : ∀ α : Fin s, Quiver.Hom L_C (L_C_comp α))
        (inc_P : ∀ α : Fin s, Quiver.Hom (L_P_comp α) L_P)
        (proj_P : ∀ α : Fin s, Quiver.Hom L_P (L_P_comp α)),
        (∀ α : Fin s,
          CategoryTheory.Sheaf.freeYonedaHomEquiv (inc_C α) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_C))
              (L_C.obj.map (Opposite.op (ι_C_comp α)))) →
        (∀ α : Fin s,
          CategoryTheory.CategoryStruct.comp (inc_C α) (proj_C α) =
            CategoryTheory.CategoryStruct.id (L_C_comp α)) →
        (∀ α β : Fin s, α ≠ β →
          CategoryTheory.CategoryStruct.comp (inc_C α) (proj_C β) = 0) →
        (∀ α : Fin s,
          CategoryTheory.Sheaf.freeYonedaHomEquiv (inc_P α) =
            CategoryTheory.CategoryStruct.comp
