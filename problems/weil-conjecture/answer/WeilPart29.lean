      homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} f g => by
        apply hFaith_UZ.map_injective
        let ug : Quiver.Hom (U_Y.obj ℱ) (i_push_ab.obj (U_Z.obj 𝒢)) := U_Y.map g
        let lhs_in := (adj_ab.homEquiv (U_Y.obj ℱ') (U_Z.obj 𝒢)).symm
