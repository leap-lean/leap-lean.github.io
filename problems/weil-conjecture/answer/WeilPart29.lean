      rw [hT1]
      change e_alg_U₀ (algebraMap (Polynomial k) (LaurentPolynomial k) Polynomial.X) = (u_X₀ : R_U₀)
      rw [e_alg_U₀.commutes Polynomial.X]
      change U₀.ι.appTop.hom (e_A₁ Polynomial.X) = (u_X₀ : R_U₀)
