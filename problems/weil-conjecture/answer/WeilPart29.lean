              left_inv := fun f => by
                ext m
                change f.hom ((1 : ULift.{u, 0} (ZMod N)) • m) = f.hom m
                rw [one_smul]
              right_inv := fun ψ => by
                ext m r
                change (ψ.hom (r • m)) 1 = (ψ.hom m) r
                rw [ψ.hom.map_smul]
                change (ψ.hom m) (r * 1) = (ψ.hom m) r
                rw [mul_one] }
          homEquiv_naturality_left_symm := fun _ _ => by ext; rfl
          homEquiv_naturality_right := fun _ _ => by ext; rfl }

    have hasSheafCompose_ffg : ∀ (W : Scheme.{u}) (N : ℕ),
        W.smallEtaleTopology.HasSheafCompose
          (forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod N))) AddCommGrpCat.{u}) := by
      intro W N
      have := (adjLeftFfg N).isRightAdjoint
      exact ⟨fun P hP => Presheaf.isSheaf_comp_of_isSheaf W.smallEtaleTopology P _ hP⟩

    have hasSheafCompose_coextMod : ∀ (W : Scheme.{u}) (N : ℕ),
        W.smallEtaleTopology.HasSheafCompose (coextMod N) := by
      intro W N
      have := (adjRightFfg N).isRightAdjoint
      exact ⟨fun P hP => Presheaf.isSheaf_comp_of_isSheaf W.smallEtaleTopology P _ hP⟩

    have hasSheafCompose_restrict : ∀ (W : Scheme.{u}) {N M : ℕ}
        (π : ULift.{u, 0} (ZMod N) →+* ULift.{u, 0} (ZMod M)),
        W.smallEtaleTopology.HasSheafCompose (ModuleCat.restrictScalars.{u, u, u} π) := by
      intro W N M π
      have := (ModuleCat.extendRestrictScalarsAdj π).isRightAdjoint
      exact ⟨fun P hP => Presheaf.isSheaf_comp_of_isSheaf W.smallEtaleTopology P _ hP⟩

    have hasSheafCompose_coextRing : ∀ (W : Scheme.{u}) {N M : ℕ}
        (π : ULift.{u, 0} (ZMod N) →+* ULift.{u, 0} (ZMod M)),
        W.smallEtaleTopology.HasSheafCompose (ModuleCat.coextendScalars.{u, u, u} π) := by
      intro W N M π
      have := (ModuleCat.restrictCoextendScalarsAdj π).isRightAdjoint
      exact ⟨fun P hP => Presheaf.isSheaf_comp_of_isSheaf W.smallEtaleTopology P _ hP⟩

    let sheafComposeAdj {C : Type (u + 1)} [Category.{u, u + 1} C]
        (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u, u + 1} A] [Category.{u, u + 1} B]
        {F : A ⥤ B} {G : B ⥤ A} (adj : F ⊣ G) [J.HasSheafCompose F] [J.HasSheafCompose G] :
        sheafCompose J F ⊣ sheafCompose J G :=
      Adjunction.mkOfHomEquiv
        { homEquiv := fun X Y =>
            { toFun := fun f => ⟨((adj.whiskerRight Cᵒᵖ).homEquiv X.obj Y.obj) f.hom⟩
              invFun := fun g => ⟨((adj.whiskerRight Cᵒᵖ).homEquiv X.obj Y.obj).symm g.hom⟩
              left_inv := fun _ => Sheaf.hom_ext (Equiv.symm_apply_apply _ _)
              right_inv := fun _ => Sheaf.hom_ext (Equiv.apply_symm_apply _ _) }
          homEquiv_naturality_left_symm := fun h g =>
            Sheaf.hom_ext ((adj.whiskerRight Cᵒᵖ).homEquiv_naturality_left_symm h.hom g.hom)
          homEquiv_naturality_right := fun f h =>
            Sheaf.hom_ext ((adj.whiskerRight Cᵒᵖ).homEquiv_naturality_right f.hom h.hom) }

    have ext1_as_shortExact : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C]
        [HasExt.{u} C] [EnoughInjectives C] {X Y : C} (e : Abelian.Ext.{u} X Y 1),
        ∃ (E_mid : C) (f : Y ⟶ E_mid) (g : E_mid ⟶ X) (hfg : f ≫ g = 0)
          (hS : (ShortComplex.mk f g hfg).ShortExact),
          hS.extClass = e := by
      intro C _ _ _ _ X Y e
      let ι : Y ⟶ Injective.under Y := Injective.ι Y
      let π : Injective.under Y ⟶ Limits.cokernel ι := Limits.cokernel.π ι
      let S_Y : ShortComplex C := ShortComplex.mk ι π (Limits.cokernel.condition ι)
      have hS_Y : S_Y.ShortExact :=
        { exact := ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      have hzero : e.comp (Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero 1) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS_Y e hzero (Nat.zero_add 1)
      let u : X ⟶ Limits.cokernel ι := Abelian.Ext.addEquiv₀ z
      have hu : Abelian.Ext.mk₀ u = z := Abelian.Ext.addEquiv₀.left_inv z
      let E_mid : C := Limits.pullback π u
      let p₁ : E_mid ⟶ Injective.under Y := Limits.pullback.fst π u
      let p₂ : E_mid ⟶ X := Limits.pullback.snd π u
      have hcond : ι ≫ π = 0 ≫ u := by
        rw [Limits.zero_comp]
        exact Limits.cokernel.condition ι
      let j : Y ⟶ E_mid := Limits.pullback.lift ι 0 hcond
      have hjp₂ : j ≫ p₂ = 0 := Limits.pullback.lift_snd _ _ _
      have hj_mono : Mono j := by
        have hjp₁ : j ≫ p₁ = ι := Limits.pullback.lift_fst _ _ _
        have : Mono (j ≫ p₁) := by rw [hjp₁]; infer_instance
        exact mono_of_mono j p₁
      have hp₂_epi : Epi p₂ := inferInstance
      let lift_fn : ∀ {W' : C} (g' : W' ⟶ E_mid), g' ≫ p₂ = 0 → (W' ⟶ Y) :=
        fun {W'} g' hg' => hS_Y.fIsKernel.lift (Limits.KernelFork.ofι (g' ≫ p₁) (by
          change (g' ≫ p₁) ≫ π = 0
          rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hg', Limits.zero_comp]))
      have hfac : ∀ {W' : C} (g' : W' ⟶ E_mid) (hg' : g' ≫ p₂ = 0),
          lift_fn g' hg' ≫ j = g' := by
        intro W' g' hg'
        apply Limits.pullback.hom_ext
        · rw [Category.assoc]
          change _ ≫ (j ≫ p₁) = g' ≫ p₁
          rw [Limits.pullback.lift_fst]
          exact hS_Y.fIsKernel.fac _ Limits.WalkingParallelPair.zero
        · rw [Category.assoc]
          change _ ≫ (j ≫ p₂) = g' ≫ p₂
          rw [hjp₂, Limits.comp_zero, hg']
      let hj_ker : Limits.IsLimit (Limits.KernelFork.ofι j hjp₂) :=
        Limits.KernelFork.IsLimit.ofι j hjp₂
          (fun {W'} g' hg' => lift_fn g' hg')
          (fun {W'} g' hg' => hfac g' hg')
          (fun {W'} g' hg' m hm => by
            rw [← cancel_mono j]
            exact hm.trans (hfac g' hg').symm)
      have hS_pb : (ShortComplex.mk j p₂ hjp₂).ShortExact :=
        { exact := ShortComplex.exact_of_f_is_kernel _ hj_ker
          mono_f := hj_mono
          epi_g := hp₂_epi }
      let φ_sc : ShortComplex.mk j p₂ hjp₂ ⟶ S_Y :=
        { τ₁ := 𝟙 Y
          τ₂ := p₁
          τ₃ := u
          comm₁₂ := by
            change 𝟙 Y ≫ ι = j ≫ p₁
            rw [Category.id_comp, Limits.pullback.lift_fst]
          comm₂₃ := Limits.pullback.condition }
      have hnat := ShortComplex.ShortExact.extClass_naturality hS_pb hS_Y φ_sc
      dsimp [φ_sc, S_Y] at hnat
      refine ⟨E_mid, j, p₂, hjp₂, hS_pb, ?_⟩
      calc
        hS_pb.extClass = hS_pb.extClass.comp (Abelian.Ext.mk₀ (𝟙 Y)) (Nat.add_zero 1) :=
          (Abelian.Ext.comp_mk₀_id hS_pb.extClass).symm
        _ = (Abelian.Ext.mk₀ u).comp hS_Y.extClass (Nat.zero_add 1) := hnat
        _ = z.comp hS_Y.extClass (Nat.zero_add 1) := by rw [hu]
        _ = e := hz

    have groth_coprod_epi_and_mono : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C]
        [IsGrothendieckAbelian.{u} C] {ι : Type u} (fam : ι → C) (N : ℕ),
        (∀ i : ι, Mono (N • 𝟙 (fam i))) →
        (∀ {X Z : C} (k : X ⟶ Z), (∀ (i : ι) (g : fam i ⟶ X), g ≫ k = 0) → k = 0) →
        ∀ (E_obj : C), ∃ (P_cov : C) (p : P_cov ⟶ E_obj), Epi p ∧ Mono (N • 𝟙 P_cov) := by
      intro C _ _ _ ι fam N hfam_mono hfam_sep E_obj
      let J_idx : Type u := Σ i : ι, Shrink.{u} (fam i ⟶ E_obj)
      let X_fam : J_idx → C := fun j => fam j.1
      let P_cov : C := Limits.sigmaObj X_fam
      let p : P_cov ⟶ E_obj := Limits.Sigma.desc (fun j : J_idx => (equivShrink (fam j.1 ⟶ E_obj)).symm j.2)
      have hp_epi : Epi p := by
        refine ⟨fun {Z} k₁ k₂ hk => ?_⟩
        rw [← sub_eq_zero]
        apply hfam_sep (k₁ - k₂)
        intro i g
        let j : J_idx := ⟨i, equivShrink (fam i ⟶ E_obj) g⟩
        have hj : Limits.Sigma.ι X_fam j ≫ p = g := by simp [p, j]
        rw [← hj, Category.assoc, Preadditive.comp_sub, hk, sub_self, Limits.comp_zero]
      have h_smul_eq : N • 𝟙 P_cov = Limits.Sigma.map (fun j : J_idx => N • 𝟙 (X_fam j)) := by
        apply Limits.Sigma.hom_ext
        intro j
        rw [Preadditive.comp_nsmul, Category.comp_id, Limits.Sigma.ι_map, Preadditive.nsmul_comp,
          Category.id_comp]
      have hP_mono : Mono (N • 𝟙 P_cov) := by
        have : ∀ j : J_idx, Mono (N • 𝟙 (X_fam j)) := fun j => hfam_mono j.1
        rw [h_smul_eq]
        infer_instance
      exact ⟨P_cov, p, hp_epi, hP_mono⟩

    have sigma_nsmul_mono : ∀ {J_idx : Type u} (Aℤ : AddCommGrpCat.{u}) (N : ℕ),
        Mono (N • 𝟙 Aℤ) → Mono (N • 𝟙 (Limits.sigmaObj fun (_ : J_idx) => Aℤ)) := by
      intro J_idx Aℤ N hmono
      let P_sig := Limits.sigmaObj fun (_ : J_idx) => Aℤ
      have h_eq : N • 𝟙 P_sig = Limits.Sigma.map (fun (_ : J_idx) => N • 𝟙 Aℤ) := by
        apply Limits.Sigma.hom_ext
        intro f
        rw [Preadditive.comp_nsmul, Category.comp_id, Limits.Sigma.ι_map, Preadditive.nsmul_comp,
          Category.id_comp]
      have : ∀ (_ : J_idx), Mono (N • 𝟙 Aℤ) := fun _ => hmono
      change Mono (N • 𝟙 P_sig)
      rw [h_eq]
      infer_instance

    have exists_tf_epi_sheaf : ∀ (W : Scheme.{u}) (N : ℕ), 1 ≤ N →
        ∀ (E_obj : Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
          ∃ (P_cov : Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) (p : P_cov ⟶ E_obj),
            Epi p ∧ Mono (N • 𝟙 P_cov) := by
      intro W N hN E_obj
      let J_aff := Scheme.AffineEtale.topology W
      let E_aff := Scheme.AffineEtale.sheafEquiv W AddCommGrpCat.{u}
      have : E_aff.functor.Additive := Functor.additive_of_preserves_binary_products E_aff.functor
      let e_sm := equivSmallModel.{u} W.AffineEtale
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      have hmono_Aℤ : Mono (N • 𝟙 Aℤ) := by
        rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        ext
        have h0 : (N • a).down = (N • b).down := congrArg ULift.down hab
        have h1 : (N : ℤ) * a.down = (N : ℤ) * b.down := by
          change N • a.down = N • b.down at h0
          rwa [nsmul_eq_mul, nsmul_eq_mul] at h0
        have hN0 : (N : ℤ) ≠ 0 := by omega
        exact mul_left_cancel₀ hN0 h1
      let fam : SmallModel.{u} W.AffineEtale → Sheaf W.smallEtaleTopology AddCommGrpCat.{u} :=
        fun i => E_aff.functor.obj (Sheaf.freeYoneda J_aff (e_sm.inverse.obj i) Aℤ)
      have hfam_mono : ∀ i : SmallModel.{u} W.AffineEtale, Mono (N • 𝟙 (fam i)) := by
        intro i
        let V := e_sm.inverse.obj i
        let P := Presheaf.freeYoneda V Aℤ
        have hmono_P : Mono (N • 𝟙 P) := by
          have : ∀ U : (W.AffineEtale)ᵒᵖ, Mono ((N • 𝟙 P).app U) := by
            intro U
            change Mono (N • 𝟙 (Limits.sigmaObj fun (_ : Opposite.unop U ⟶ V) => Aℤ))
            exact sigma_nsmul_mono Aℤ N hmono_Aℤ
          exact NatTrans.mono_of_mono_app (N • 𝟙 P)
        let S_sh := presheafToSheaf J_aff AddCommGrpCat.{u}
        have h_sh : Mono (N • 𝟙 (Sheaf.freeYoneda J_aff V Aℤ)) := by
          change Mono (N • 𝟙 (S_sh.obj P))
          have h_map : S_sh.map (N • 𝟙 P) = N • 𝟙 (S_sh.obj P) := by
            rw [Functor.map_nsmul, S_sh.map_id]
          rw [← h_map]
          infer_instance
        dsimp [fam]
        have h_eqv : E_aff.functor.map (N • 𝟙 (Sheaf.freeYoneda J_aff V Aℤ)) =
            N • 𝟙 (E_aff.functor.obj (Sheaf.freeYoneda J_aff V Aℤ)) := by
          rw [Functor.map_nsmul, E_aff.functor.map_id]
        rw [← h_eqv]
        infer_instance
      have h_fy_comp : ∀ {V : W.AffineEtale} {F₁ F₂ : Sheaf J_aff AddCommGrpCat.{u}}
          (u : Sheaf.freeYoneda J_aff V Aℤ ⟶ F₁) (v : F₁ ⟶ F₂),
          Sheaf.freeYonedaHomEquiv (u ≫ v) =
            Sheaf.freeYonedaHomEquiv u ≫ v.hom.app (Opposite.op V) := by
        intro V F₁ F₂ u v
        change Presheaf.freeYonedaHomEquiv
            (((sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv
              (Presheaf.freeYoneda V Aℤ) F₂) (u ≫ v)) =
          Presheaf.freeYonedaHomEquiv
            (((sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv
              (Presheaf.freeYoneda V Aℤ) F₁) u) ≫ v.hom.app (Opposite.op V)
        rw [(sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv_naturality_right u v]
        let w := ((sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv
          (Presheaf.freeYoneda V Aℤ) F₁) u
        change Limits.Sigma.ι (fun (_ : V ⟶ V) => Aℤ) (𝟙 V) ≫ (w ≫ v.hom).app (Opposite.op V) =
          (Limits.Sigma.ι (fun (_ : V ⟶ V) => Aℤ) (𝟙 V) ≫ w.app (Opposite.op V)) ≫
            v.hom.app (Opposite.op V)
        rw [NatTrans.comp_app]
        exact (Category.assoc _ _ _).symm
      have hfam_sep : ∀ {X Z : Sheaf W.smallEtaleTopology AddCommGrpCat.{u}} (k : X ⟶ Z),
          (∀ (i : SmallModel.{u} W.AffineEtale) (g : fam i ⟶ X), g ≫ k = 0) → k = 0 := by
        intro X Z k hk
        apply E_aff.inverse.map_injective
        rw [Functor.map_zero]
        apply Sheaf.hom_ext
        ext U s
        let U₀ := Opposite.unop U
        let i : SmallModel.{u} W.AffineEtale := e_sm.functor.obj U₀
        let isoU : e_sm.inverse.obj i ≅ U₀ := (e_sm.unitIso.app U₀).symm
        let s' := ((E_aff.inverse.obj X).obj.map isoU.hom.op) s
        let φ_s : Aℤ ⟶ (E_aff.inverse.obj X).obj.obj (Opposite.op (e_sm.inverse.obj i)) :=
          AddCommGrpCat.ofHom
            { toFun := fun z => z.down • s'
              map_zero' := zero_zsmul s'
              map_add' := fun z₁ z₂ => add_zsmul s' z₁.down z₂.down }
        let g₀ : Sheaf.freeYoneda J_aff (e_sm.inverse.obj i) Aℤ ⟶ E_aff.inverse.obj X :=
          Sheaf.freeYonedaHomEquiv.symm φ_s
        let g : fam i ⟶ X := E_aff.functor.map g₀ ≫ E_aff.counitIso.hom.app X
        have hg0 : g ≫ k = 0 := hk i g
        have hg₀_k : g₀ ≫ E_aff.inverse.map k = g₀ ≫ 0 := by
          rw [Limits.comp_zero]
          apply E_aff.functor.map_injective
          rw [Functor.map_zero, Functor.map_comp]
          have hnat : E_aff.functor.map (E_aff.inverse.map k) ≫ E_aff.counitIso.hom.app Z =
              E_aff.counitIso.hom.app X ≫ k := E_aff.counitIso.hom.naturality k
          rw [← cancel_mono (E_aff.counitIso.hom.app Z), Category.assoc, hnat,
            ← Category.assoc, hg0, Limits.zero_comp]
        have h_ev := congrArg Sheaf.freeYonedaHomEquiv hg₀_k
        rw [h_fy_comp, h_fy_comp, Sheaf.freeYonedaHomEquiv.apply_symm_apply] at h_ev
        have h_zero_app : ((0 : E_aff.inverse.obj X ⟶ E_aff.inverse.obj Z)).hom.app
            (Opposite.op (e_sm.inverse.obj i)) = 0 := rfl
        rw [h_zero_app, Limits.comp_zero] at h_ev
        have h_ev1 : ((E_aff.inverse.map k).hom.app (Opposite.op (e_sm.inverse.obj i))) s' = 0 := by
          have h1 := ConcreteCategory.congr_hom h_ev (ULift.up 1)
          change ((E_aff.inverse.map k).hom.app (Opposite.op (e_sm.inverse.obj i))).hom ((1 : ℤ) • s') = 0 at h1
          rwa [one_zsmul] at h1
        have h_img_zero : ((E_aff.inverse.obj Z).obj.map isoU.hom.op)
            (((E_aff.inverse.map k).hom.app U) s) = 0 := by
          change ((E_aff.inverse.map k).hom.app U ≫ (E_aff.inverse.obj Z).obj.map isoU.hom.op) s = 0
          rw [← (E_aff.inverse.map k).hom.naturality isoU.hom.op]
          exact h_ev1
        have h_cancel := congrArg (((E_aff.inverse.obj Z).obj.map isoU.inv.op).hom) h_img_zero
        rw [map_zero] at h_cancel
        change (((E_aff.inverse.obj Z).obj.map isoU.hom.op ≫
          (E_aff.inverse.obj Z).obj.map isoU.inv.op)) (((E_aff.inverse.map k).hom.app U) s) = 0 at h_cancel
        rw [← CategoryTheory.Functor.map_comp, ← op_comp, isoU.inv_hom_id, op_id,
          (E_aff.inverse.obj Z).obj.map_id] at h_cancel
        simpa using h_cancel
      exact groth_coprod_epi_and_mono fam N hfam_mono hfam_sep E_obj

    have ext_succ_vanish_on_tf : ∀ (W : Scheme.{u}) (N : ℕ), 1 ≤ N →
        ∀ (q : ℕ) (F_sh : Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
          Mono (N • 𝟙 F_sh) →
          ∀ (I_mod : Sheaf W.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod N))))
            [Injective I_mod]
            (e : Abelian.Ext.{u} F_sh
              ((@sheafCompose _ _ _ _ _ _ W.smallEtaleTopology
                (forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod N))) AddCommGrpCat.{u})
                (hasSheafCompose_ffg W N)).obj I_mod) (q + 1)),
            e = 0 := by
      intro W N hN
      have hsc_ffg := hasSheafCompose_ffg W N
      have hsc_coext := hasSheafCompose_coextMod W N
      let R := ULift.{u, 0} (ZMod N)
      let J := W.smallEtaleTopology
      let F_fg := forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
      let U_N := @sheafCompose _ _ _ _ _ _ J F_fg hsc_ffg
      let C_coext := @sheafCompose _ _ _ _ _ _ J (coextMod N) hsc_coext
      have : U_N.Additive :=
        { map_add := fun {_ _ f g} => Sheaf.hom_ext (NatTrans.ext (funext fun _ => F_fg.map_add)) }
      have : U_N.Faithful :=
        { map_injective := fun {X Y f g} h => by
            apply Sheaf.hom_ext
            ext V x
            exact ConcreteCategory.congr_hom
              (NatTrans.congr_app (congrArg (fun φ : U_N.obj X ⟶ U_N.obj Y => φ.hom) h) V) x }
      have h_efface : ∀ (n : ℕ) (X Y : Sheaf J AddCommGrpCat.{u})
          (e₀ : Abelian.Ext.{u} X Y (n + 1)),
          ∃ (P_cov : Sheaf J AddCommGrpCat.{u}) (p : P_cov ⟶ X),
            Epi p ∧ Mono (N • 𝟙 P_cov) ∧
            (Abelian.Ext.mk₀ p).comp e₀ (Nat.zero_add (n + 1)) = 0 := by
        intro n
        induction n with
        | zero =>
          intro X Y e₀
          obtain ⟨E_mid, f, g, hfg, hS, rfl⟩ := ext1_as_shortExact e₀
          obtain ⟨P_cov, q_cov, hq_epi, hP_mono⟩ := exists_tf_epi_sheaf W N hN E_mid
          have : Epi g := hS.epi_g
          refine ⟨P_cov, q_cov ≫ g, epi_comp q_cov g, hP_mono, ?_⟩
          rw [← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ q_cov) (Abelian.Ext.mk₀ g)
              hS.extClass (Nat.zero_add 1),
            ShortComplex.ShortExact.comp_extClass hS, Abelian.Ext.comp_zero]
        | succ k ih =>
          intro X Y e₀
          let ι : Y ⟶ Injective.under Y := Injective.ι Y
          let S_Y := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
          have hS_Y : S_Y.ShortExact :=
            { exact := ShortComplex.exact_cokernel ι
              mono_f := inferInstance
              epi_g := inferInstance }
          have hzero : e₀.comp (Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (k + 2)) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨e', rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS_Y e₀ hzero rfl
          obtain ⟨P_cov, p, hp_epi, hP_mono, hkill⟩ := ih X S_Y.X₃ e'
          refine ⟨P_cov, p, hp_epi, hP_mono, ?_⟩
          rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ p) e' hS_Y.extClass
              (Nat.zero_add (k + 1)) rfl (Nat.zero_add (k + 2)),
            hkill, Abelian.Ext.zero_comp]
      intro q
      induction q with
      | zero =>
        intro F_sh hF_mono I_mod _ e
        obtain ⟨E_mid, f, g, hfg, hS, rfl⟩ := ext1_as_shortExact e
        let π_cok : E_mid ⟶ Limits.cokernel (N • 𝟙 E_mid) := Limits.cokernel.π (N • 𝟙 E_mid)
        let Q_cok : Sheaf J AddCommGrpCat.{u} := Limits.cokernel (N • 𝟙 E_mid)
        have hNI_zero : N • 𝟙 (U_N.obj I_mod) = 0 := by
          have hIR : N • 𝟙 I_mod = 0 := by
            apply Sheaf.hom_ext
            ext V x
            change N • x = 0
            have hN_R : (N : R) = 0 := ULift.ext _ _ (ZMod.natCast_self N)
            rw [← Nat.cast_smul_eq_nsmul R N x, hN_R, zero_smul]
          rw [← U_N.map_id, ← Functor.map_nsmul, hIR, U_N.map_zero]
        have hNg : (N • 𝟙 E_mid) ≫ g = g ≫ (N • 𝟙 F_sh) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        have hfN : f ≫ (N • 𝟙 E_mid) = 0 := by
          rw [Preadditive.comp_nsmul, Category.comp_id, ← Category.id_comp f,
            ← Preadditive.nsmul_comp, hNI_zero, Limits.zero_comp]
        let j : U_N.obj I_mod ⟶ Q_cok := f ≫ π_cok
        have hj_mono : Mono j := by
          apply Abelian.Pseudoelement.mono_of_zero_of_map_zero
          intro a ha
          rw [Abelian.Pseudoelement.comp_apply] at ha
          have h_cok_ex : (ShortComplex.mk (N • 𝟙 E_mid) π_cok (Limits.cokernel.condition _)).Exact :=
            ShortComplex.exact_cokernel _
          obtain ⟨b, hb⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact h_cok_ex _ ha
          change Abelian.Pseudoelement.pseudoApply (N • 𝟙 E_mid) b =
            Abelian.Pseudoelement.pseudoApply f a at hb
          have hgb : Abelian.Pseudoelement.pseudoApply (N • 𝟙 F_sh)
              (Abelian.Pseudoelement.pseudoApply g b) = 0 := by
            rw [← Abelian.Pseudoelement.comp_apply, ← hNg, Abelian.Pseudoelement.comp_apply,
              hb, ← Abelian.Pseudoelement.comp_apply, hfg, Abelian.Pseudoelement.zero_apply]
          have hgb0 : Abelian.Pseudoelement.pseudoApply g b = 0 :=
            Abelian.Pseudoelement.zero_of_map_zero (N • 𝟙 F_sh)
              (Abelian.Pseudoelement.pseudo_injective_of_mono (N • 𝟙 F_sh)) _ hgb
          obtain ⟨a', ha'⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact hS.exact b hgb0
          change Abelian.Pseudoelement.pseudoApply f a' = b at ha'
          have hfa : Abelian.Pseudoelement.pseudoApply f a = 0 := by
            rw [← hb, ← ha', ← Abelian.Pseudoelement.comp_apply, hfN,
              Abelian.Pseudoelement.zero_apply]
          have : Mono f := hS.mono_f
          exact Abelian.Pseudoelement.zero_of_map_zero f
            (Abelian.Pseudoelement.pseudo_injective_of_mono f) a hfa
        have hQ_zero : N • 𝟙 Q_cok = 0 := by
          rw [← cancel_epi π_cok, Limits.comp_zero, Preadditive.comp_nsmul, Category.comp_id,
            ← Category.id_comp π_cok, ← Preadditive.nsmul_comp]
          exact Limits.cokernel.condition (N • 𝟙 E_mid)
        have h_nsmul_sec : ∀ (n : ℕ) (V : (W.Etale)ᵒᵖ) (y : Q_cok.obj.obj V),
            ((n • 𝟙 Q_cok).hom.app V).hom y = n • y := by
          intro n V y
          induction n with
          | zero => rfl
          | succ m_idx ih_n =>
            rw [succ_nsmul, succ_nsmul]
            change ((m_idx • 𝟙 Q_cok).hom.app V).hom y + y = m_idx • y + y
            rw [ih_n]
        have hQ_sec : ∀ (V : (W.Etale)ᵒᵖ) (y : Q_cok.obj.obj V), N • y = 0 := by
          intro V y
          rw [← h_nsmul_sec N V y, hQ_zero]
          rfl
        let s_cok : Q_cok ⟶ U_N.obj (C_coext.obj Q_cok) :=
          ⟨{ app := fun V =>
              letI : Module (ZMod N) (Q_cok.obj.obj V) := AddCommGroup.zmodModule (hQ_sec V)
              AddCommGrpCat.ofHom (Y := AddCommGrpCat.of (R →+ Q_cok.obj.obj V))
                { toFun := fun y =>
                    { toFun := fun r => r.down • y
                      map_zero' := zero_smul (ZMod N) y
                      map_add' := fun r₁ r₂ => add_smul r₁.down r₂.down y }
                  map_zero' := AddMonoidHom.ext fun r => smul_zero r.down
                  map_add' := fun y₁ y₂ => AddMonoidHom.ext fun r => smul_add r.down y₁ y₂ }
             naturality := fun {V₁ V₂} u => by
              apply AddCommGrpCat.ext
              intro y
              apply AddMonoidHom.ext
              intro r
              letI : Module (ZMod N) (Q_cok.obj.obj V₁) := AddCommGroup.zmodModule (hQ_sec V₁)
              letI : Module (ZMod N) (Q_cok.obj.obj V₂) := AddCommGroup.zmodModule (hQ_sec V₂)
              change r.down • ((Q_cok.obj.map u).hom y) = (Q_cok.obj.map u).hom (r.down • y)
              obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
              rw [← hz, Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
              exact ((Q_cok.obj.map u).hom.map_zsmul z y).symm }⟩
        let ev_1 : U_N.obj (C_coext.obj Q_cok) ⟶ Q_cok :=
          ⟨{ app := fun V => AddCommGrpCat.ofHom (X := AddCommGrpCat.of (R →+ Q_cok.obj.obj V))
              { toFun := fun φ => φ 1
                map_zero' := rfl
                map_add' := fun _ _ => rfl }
             naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl }⟩
        have hs_ev : s_cok ≫ ev_1 = 𝟙 Q_cok := by
          apply Sheaf.hom_ext
          ext V y
          letI : Module (ZMod N) (Q_cok.obj.obj V) := AddCommGroup.zmodModule (hQ_sec V)
          change (1 : ZMod N) • y = y
          exact one_smul (ZMod N) y
        let j_tilde : I_mod ⟶ C_coext.obj Q_cok :=
          ⟨{ app := fun V =>
              let A_V : AddCommGrpCat.{u} := ((sheafToPresheaf J AddCommGrpCat.{u}).obj Q_cok).obj V
              letI : Module R (R →+ A_V) := instModHomRA N A_V
              ModuleCat.ofHom (Y := ModuleCat.of R (R →+ A_V))
                { toFun := fun x =>
                    { toFun := fun r => (j.hom.app V).hom (r • x)
                      map_zero' := by
                        change (j.hom.app V).hom ((0 : R) • x) = 0
                        rw [zero_smul]
                        exact (j.hom.app V).hom.map_zero
                      map_add' := fun r₁ r₂ => by
                        change (j.hom.app V).hom ((r₁ + r₂) • x) =
                          (j.hom.app V).hom (r₁ • x) + (j.hom.app V).hom (r₂ • x)
                        rw [add_smul]
                        exact (j.hom.app V).hom.map_add (r₁ • x) (r₂ • x) }
                  map_add' := fun x₁ x₂ => AddMonoidHom.ext fun r => by
                    change (j.hom.app V).hom (r • (x₁ + x₂)) =
                      (j.hom.app V).hom (r • x₁) + (j.hom.app V).hom (r • x₂)
                    rw [smul_add]
                    exact (j.hom.app V).hom.map_add (r • x₁) (r • x₂)
                  map_smul' := fun c x => AddMonoidHom.ext fun r => by
                    change (j.hom.app V).hom (r • (c • x)) = (j.hom.app V).hom ((c * r) • x)
                    rw [← mul_smul, mul_comm] }
             naturality := fun {V₁ V₂} u => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro x
              apply AddMonoidHom.ext
              intro r
              change (j.hom.app V₂).hom (r • (I_mod.obj.map u).hom x) =
                (Q_cok.obj.map u).hom ((j.hom.app V₁).hom (r • x))
              rw [← (I_mod.obj.map u).hom.map_smul]
              exact ConcreteCategory.congr_hom (j.hom.naturality u) (r • x) }⟩
        have hj_tilde_eq : U_N.map j_tilde = j ≫ s_cok := by
          apply Sheaf.hom_ext
          apply NatTrans.ext
          funext V
          apply AddCommGrpCat.ext
          intro x
          apply AddMonoidHom.ext
          intro r
          letI : Module (ZMod N) (Q_cok.obj.obj V) := AddCommGroup.zmodModule (hQ_sec V)
          let x_mod : ↑(I_mod.obj.obj V) := x
          let f_j : ↑(I_mod.obj.obj V) →+ ↑(Q_cok.obj.obj V) := (j.hom.app V).hom
          change f_j (r • x_mod) = r.down • f_j x_mod
          obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
          have hr : r = (z : R) := by ext; exact hz.symm
          have hrx : r • x_mod = z • x_mod := by
            rw [hr, Int.cast_smul_eq_zsmul R z x_mod]
          have hry : r.down • f_j x_mod = z • f_j x_mod := by
            rw [← hz, Int.cast_smul_eq_zsmul (ZMod N) z (f_j x_mod)]
          rw [hrx, hry]
          exact f_j.map_zsmul z x_mod
        have h_map_mono : Mono (U_N.map j_tilde) := by
          rw [hj_tilde_eq]
          have : Mono ((j ≫ s_cok) ≫ ev_1) := by
            rw [Category.assoc, hs_ev, Category.comp_id]
            exact hj_mono
          exact mono_of_mono (j ≫ s_cok) ev_1
        have : Mono j_tilde := U_N.mono_of_mono_map h_map_mono
        let r_mod : C_coext.obj Q_cok ⟶ I_mod := Injective.factorThru (𝟙 I_mod) j_tilde
        have hr_mod : j_tilde ≫ r_mod = 𝟙 I_mod := Injective.comp_factorThru (𝟙 I_mod) j_tilde
        let r_split : E_mid ⟶ U_N.obj I_mod := π_cok ≫ s_cok ≫ U_N.map r_mod
        have hsplit : f ≫ r_split = 𝟙 (U_N.obj I_mod) := by
          change (f ≫ π_cok) ≫ s_cok ≫ U_N.map r_mod = 𝟙 (U_N.obj I_mod)
          rw [← Category.assoc j s_cok, ← hj_tilde_eq, ← U_N.map_comp, hr_mod, U_N.map_id]
        calc
          hS.extClass = hS.extClass.comp (Abelian.Ext.mk₀ (𝟙 (U_N.obj I_mod))) (Nat.add_zero 1) :=
            (Abelian.Ext.comp_mk₀_id hS.extClass).symm
          _ = hS.extClass.comp (Abelian.Ext.mk₀ (f ≫ r_split)) (Nat.add_zero 1) := by rw [hsplit]
          _ = (hS.extClass.comp (Abelian.Ext.mk₀ (ShortComplex.mk f g hfg).f) (Nat.add_zero 1)).comp
                (Abelian.Ext.mk₀ r_split) (Nat.add_zero 1) := by
            rw [← Abelian.Ext.mk₀_comp_mk₀,
              Abelian.Ext.comp_assoc_of_third_deg_zero hS.extClass (Abelian.Ext.mk₀ f)
                (Abelian.Ext.mk₀ r_split) (Nat.add_zero 1)]
          _ = 0 := by rw [ShortComplex.ShortExact.extClass_comp hS, Abelian.Ext.zero_comp]
      | succ k ih =>
        intro F_sh hF_mono I_mod _ e
        obtain ⟨P_cov, p, hp_epi, hP_mono, hkill⟩ := h_efface (k + 1) F_sh (U_N.obj I_mod) e
        let ι_p : Limits.kernel p ⟶ P_cov := Limits.kernel.ι p
        let S_p := ShortComplex.mk ι_p p (Limits.kernel.condition p)
        have hS_p : S_p.ShortExact :=
          { exact := ShortComplex.exact_kernel p
            mono_f := inferInstance
            epi_g := hp_epi }
        have hK_mono : Mono (N • 𝟙 (Limits.kernel p)) := by
          have hcomm : (N • 𝟙 (Limits.kernel p)) ≫ ι_p = ι_p ≫ (N • 𝟙 P_cov) := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
          have : Mono ((N • 𝟙 (Limits.kernel p)) ≫ ι_p) := by
            rw [hcomm]
            exact mono_comp ι_p (N • 𝟙 P_cov)
          exact mono_of_mono (N • 𝟙 (Limits.kernel p)) ι_p
        obtain ⟨x₁, rfl⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS_p (U_N.obj I_mod) e hkill
          (Nat.add_comm 1 (k + 1))
        rw [ih (Limits.kernel p) hK_mono I_mod x₁, Abelian.Ext.comp_zero]

    have hTheta_shift : ∀ {C₁ C₂ : Type (u + 1)}
        [Category.{u + 1, u + 1} C₁] [Abelian C₁] [HasExt.{u} C₁] [EnoughInjectives C₁]
        [Category.{u + 1, u + 1} C₂] [Abelian C₂] [HasExt.{u} C₂]
        (U : C₁ ⥤ C₂) [U.Additive] [Limits.PreservesFiniteLimits U] [Limits.PreservesFiniteColimits U]
        (One_obj : C₁) (Fℤ_obj : C₂) (ιℤ_hom : Fℤ_obj ⟶ U.obj One_obj),
        (∀ F_mod : C₁, Function.Bijective
          (((Abelian.Ext.mk₀ ιℤ_hom).precomp (U.obj F_mod) (Nat.zero_add 0)).comp
            (U.mapExtAddHom One_obj F_mod 0))) →
        (∀ (q : ℕ) (I_obj : C₁) [Injective I_obj]
          (w : Abelian.Ext.{u} Fℤ_obj (U.obj I_obj) (q + 1)), w = 0) →
        ∀ (k : ℕ) (F_mod : C₁), Function.Bijective
          (((Abelian.Ext.mk₀ ιℤ_hom).precomp (U.obj F_mod) (Nat.zero_add k)).comp
            (U.mapExtAddHom One_obj F_mod k)) := by
      intro C₁ C₂ _ _ _ _ _ _ _ U _ _ _ One_obj Fℤ_obj ιℤ_hom hBase0 hVan k
      induction k with
      | zero => exact hBase0
      | succ q ih =>
        intro F_mod
        let ι : F_mod ⟶ Injective.under F_mod := Injective.ι F_mod
        let S : ShortComplex C₁ := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
        have hS : S.ShortExact :=
          { exact := ShortComplex.exact_cokernel ι
            mono_f := inferInstance
            epi_g := inferInstance }
        let hS_U : (S.map U).ShortExact := hS.map_of_exact U
        let Θ_I := ((Abelian.Ext.mk₀ ιℤ_hom).precomp (U.obj S.X₂) (Nat.zero_add q)).comp
          (U.mapExtAddHom One_obj S.X₂ q)
        let Θ_Q := ((Abelian.Ext.mk₀ ιℤ_hom).precomp (U.obj S.X₃) (Nat.zero_add q)).comp
          (U.mapExtAddHom One_obj S.X₃ q)
        let Θ_F := ((Abelian.Ext.mk₀ ιℤ_hom).precomp (U.obj F_mod) (Nat.zero_add (q + 1))).comp
          (U.mapExtAddHom One_obj F_mod (q + 1))
        have hbij_I : Function.Bijective Θ_I := ih S.X₂
        have hbij_Q : Function.Bijective Θ_Q := ih S.X₃
        have hΘ_g : ∀ u : Abelian.Ext.{u} One_obj S.X₂ q,
            Θ_Q (u.comp (Abelian.Ext.mk₀ S.g) (Nat.add_zero q)) =
              (Θ_I u).comp (Abelian.Ext.mk₀ (U.map S.g)) (Nat.add_zero q) := by
          intro u
          change (Abelian.Ext.mk₀ ιℤ_hom).comp
              ((U.mapExtAddHom One_obj S.X₃ q) (u.comp (Abelian.Ext.mk₀ S.g) (Nat.add_zero q)))
              (Nat.zero_add q) =
            ((Abelian.Ext.mk₀ ιℤ_hom).comp
              ((U.mapExtAddHom One_obj S.X₂ q) u) (Nat.zero_add q)).comp
              (Abelian.Ext.mk₀ (U.map S.g)) (Nat.add_zero q)
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
            Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
            ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ιℤ_hom) _ _
              (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q)]
        have hΘ_δ : ∀ v : Abelian.Ext.{u} One_obj S.X₃ q,
            Θ_F (v.comp hS.extClass rfl) = (Θ_Q v).comp hS_U.extClass rfl := by
          intro v
          change (Abelian.Ext.mk₀ ιℤ_hom).comp
              ((U.mapExtAddHom One_obj F_mod (q + 1)) (v.comp hS.extClass rfl))
              (Nat.zero_add (q + 1)) =
            ((Abelian.Ext.mk₀ ιℤ_hom).comp
              ((U.mapExtAddHom One_obj S.X₃ q) v) (Nat.zero_add q)).comp
              hS_U.extClass rfl
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
            Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
            ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ιℤ_hom) _ _
              (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]
        refine ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro γ hγ0
          have hzero_I : γ.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨v, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ One_obj hS γ hzero_I rfl
          rw [hΘ_δ v] at hγ0
          obtain ⟨u', hu'⟩ := Abelian.Ext.covariant_sequence_exact₃ Fℤ_obj hS_U (Θ_Q v) rfl hγ0
          obtain ⟨u, rfl⟩ := hbij_I.2 u'
          change (Θ_I u).comp (Abelian.Ext.mk₀ (U.map S.g)) (Nat.add_zero q) = Θ_Q v at hu'
          rw [← hΘ_g u] at hu'
          have huv : u.comp (Abelian.Ext.mk₀ S.g) (Nat.add_zero q) = v := hbij_Q.1 hu'
          rw [← huv, Abelian.Ext.comp_assoc u (Abelian.Ext.mk₀ S.g) hS.extClass
            (Nat.add_zero q) (Nat.zero_add 1) rfl,
            ShortComplex.ShortExact.comp_extClass hS, Abelian.Ext.comp_zero]
        · intro w
          have hw_zero : w.comp (Abelian.Ext.mk₀ (S.map U).f) (Nat.add_zero (q + 1)) = 0 :=
            hVan q S.X₂ _
          obtain ⟨w', rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ Fℤ_obj hS_U w hw_zero rfl
          obtain ⟨v, rfl⟩ := hbij_Q.2 w'
          exact ⟨v.comp hS.extClass rfl, hΘ_δ v⟩

    intro W r a b c hab c_succ c_curr hs hr x y
    let J := W.smallEtaleTopology
    let T₀ := weilEtaleIdTerminal.{u} W
    let hT₀ := weilEtaleIdTerminalIsTerminal.{u} W
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let C_ab := constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C_ab.obj Aℤ
    let adj_ab₀ := constantSheafAdj J AddCommGrpCat.{u} hT₀

    let R_of (N : ℕ) : Type u := ULift.{u, 0} (ZMod N)
    let Rmod_of (N : ℕ) : ModuleCat.{u, u} (R_of N) := ModuleCat.of (R_of N) (R_of N)
    let Onemod_of (N : ℕ) : Sheaf J (ModuleCat.{u, u} (R_of N)) :=
      (constantSheaf J (ModuleCat.{u, u} (R_of N))).obj (Rmod_of N)
    let AM_of (N : ℕ) : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod N))
    let FM_of (N : ℕ) : Sheaf J AddCommGrpCat.{u} := C_ab.obj (AM_of N)
    let Ffg_of (N : ℕ) : ModuleCat.{u, u} (R_of N) ⥤ AddCommGrpCat.{u} :=
      forget₂ (ModuleCat.{u, u} (R_of N)) AddCommGrpCat.{u}
    let U_of (N : ℕ) : Sheaf J (ModuleCat.{u, u} (R_of N)) ⥤ Sheaf J AddCommGrpCat.{u} :=
      @sheafCompose _ _ _ _ _ _ J (Ffg_of N) (hasSheafCompose_ffg W N)
    let adj_mod₀_of (N : ℕ) := constantSheafAdj J (ModuleCat.{u, u} (R_of N)) hT₀
    let ιM_of (N : ℕ) : AM_of N ⟶ (Ffg_of N).obj (Rmod_of N) :=
      AddCommGrpCat.ofHom (AddMonoidHom.id (R_of N))
    let z_to_m_of (N : ℕ) : Aℤ ⟶ AM_of N :=
      AddCommGrpCat.ofHom
        { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod N)
          map_zero' := congrArg ULift.up Int.cast_zero
          map_add' := fun z₁ z₂ => congrArg ULift.up (Int.cast_add z₁.down z₂.down) }
    let u₀_of (N : ℕ) : (Ffg_of N).obj (Rmod_of N) ⟶
        ((U_of N).obj (Onemod_of N)).obj.obj (Opposite.op T₀) :=
      (Ffg_of N).map ((adj_mod₀_of N).unit.app (Rmod_of N))
    let αM₀_of (N : ℕ) : FM_of N ⟶ (U_of N).obj (Onemod_of N) :=
      (adj_ab₀.homEquiv (AM_of N) ((U_of N).obj (Onemod_of N))).symm (ιM_of N ≫ u₀_of N)
    let ιℤ₀_of (N : ℕ) : Fℤ ⟶ (U_of N).obj (Onemod_of N) :=
      C_ab.map (z_to_m_of N) ≫ αM₀_of N

    have sheafCompose_preservesFiniteLimits : ∀ {D₁ D₂ : Type (u + 1)}
        [Category.{u, u + 1} D₁] [Category.{u, u + 1} D₂]
        [Limits.HasFiniteLimits D₁] [Limits.HasFiniteLimits D₂]
        (F : D₁ ⥤ D₂) [F.IsRightAdjoint] (hsc : J.HasSheafCompose F),
        Limits.PreservesFiniteLimits (@sheafCompose _ _ _ _ _ _ J F hsc) := by
      intro D₁ D₂ _ _ _ _ F _ hsc
      let G := @sheafCompose _ _ _ _ _ _ J F hsc
      refine ⟨fun K _ _ => ?_⟩
      have : Limits.PreservesLimitsOfShape K (sheafToPresheaf J D₁) := inferInstance
      have : Limits.PreservesLimitsOfShape K ((Functor.whiskeringRight (W.Etale)ᵒᵖ D₁ D₂).obj F) :=
        inferInstance
      have : Limits.PreservesLimitsOfShape K (G ⋙ sheafToPresheaf J D₂) :=
        Limits.comp_preservesLimitsOfShape (sheafToPresheaf J D₁)
          ((Functor.whiskeringRight (W.Etale)ᵒᵖ D₁ D₂).obj F)
      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves G (sheafToPresheaf J D₂)

    have hU_exact : ∀ N : ℕ,
        (U_of N).Additive ∧
        Limits.PreservesFiniteLimits (U_of N) ∧
        Limits.PreservesFiniteColimits (U_of N) := by
      intro N
      have hsc_ffg := hasSheafCompose_ffg W N
      have hsc_coext := hasSheafCompose_coextMod W N
      have := (adjLeftFfg N).isRightAdjoint
      have hLim_U : Limits.PreservesFiniteLimits (U_of N) :=
        sheafCompose_preservesFiniteLimits (Ffg_of N) hsc_ffg
      have hadjR := @sheafComposeAdj _ _ J _ _ _ _ _ _ (adjRightFfg N) hsc_ffg hsc_coext
      have := hadjR.isLeftAdjoint
      refine ⟨{ map_add := fun {_ _ f g} => Sheaf.hom_ext (NatTrans.ext (funext fun _ => (Ffg_of N).map_add)) },
        hLim_U, ⟨fun K _ _ => inferInstance⟩⟩

    have hTheta_bij : ∀ (N : ℕ), 1 ≤ N →
        ∀ (hAdd : (U_of N).Additive) (hLim : Limits.PreservesFiniteLimits (U_of N))
          (hColim : Limits.PreservesFiniteColimits (U_of N))
          (k : ℕ) (F_mod : Sheaf J (ModuleCat.{u, u} (R_of N))),
          letI := hAdd; letI := hLim; letI := hColim
          Function.Bijective
            (((Abelian.Ext.mk₀ (ιℤ₀_of N)).precomp ((U_of N).obj F_mod) (Nat.zero_add k)).comp
              ((U_of N).mapExtAddHom (Onemod_of N) F_mod k)) := by
      intro N hN hAdd hLim hColim k F_mod
      haveI := hAdd; haveI := hLim; haveI := hColim
      have hFℤ_mono : Mono (N • 𝟙 Fℤ) := by
        have hmono_Aℤ : Mono (N • 𝟙 Aℤ) := by
          rw [AddCommGrpCat.mono_iff_injective]
          intro a₁ a₂ hab_eq
          ext
          have h0 : (N • a₁).down = (N • a₂).down := congrArg ULift.down hab_eq
          have h1 : (N : ℤ) * a₁.down = (N : ℤ) * a₂.down := by
            change N • a₁.down = N • a₂.down at h0
            rwa [nsmul_eq_mul, nsmul_eq_mul] at h0
          have hN0 : (N : ℤ) ≠ 0 := by omega
          exact mul_left_cancel₀ hN0 h1
        have : C_ab.Additive := Functor.additive_of_preserves_binary_products C_ab
        have h_map : C_ab.map (N • 𝟙 Aℤ) = N • 𝟙 Fℤ := by
          rw [Functor.map_nsmul, C_ab.map_id]
        rw [← h_map]
        have : Mono ((Functor.const (W.Etale)ᵒᵖ).map (N • 𝟙 Aℤ)) := by
          have : ∀ U : (W.Etale)ᵒᵖ, Mono (((Functor.const (W.Etale)ᵒᵖ).map (N • 𝟙 Aℤ)).app U) :=
            fun _ => hmono_Aℤ
          exact NatTrans.mono_of_mono_app _
        exact (presheafToSheaf J AddCommGrpCat.{u}).map_mono _
      refine @hTheta_shift _ _ _ _ _ _ _ _ _ (U_of N) hAdd hLim hColim
        (Onemod_of N) Fℤ (ιℤ₀_of N) (fun F₀ => ?_)
        (fun q I_obj _ w => ext_succ_vanish_on_tf W N hN q Fℤ hFℤ_mono I_obj w) k F_mod
      let S_sec := F₀.obj.obj (Opposite.op T₀)
      let e_mod : (Onemod_of N ⟶ F₀) ≃ ↑S_sec :=
        ((adj_mod₀_of N).homEquiv (Rmod_of N) F₀).trans
          { toFun := fun f => f.hom 1
            invFun := fun m => ModuleCat.ofHom
              { toFun := fun r => r • m
                map_add' := fun r₁ r₂ => add_smul r₁ r₂ m
                map_smul' := fun c r => by dsimp; rw [mul_smul] }
            left_inv := fun f => by
              ext
              exact one_smul (R_of N) (f.hom 1)
            right_inv := fun m => one_smul (R_of N) m }
      let e_ab : (Fℤ ⟶ (U_of N).obj F₀) ≃ ↑S_sec :=
        (adj_ab₀.homEquiv Aℤ ((U_of N).obj F₀)).trans
          { toFun := fun g => g.hom (ULift.up (1 : ℤ))
            invFun := fun m => AddCommGrpCat.ofHom (Y := ((U_of N).obj F₀).obj.obj (Opposite.op T₀))
              { toFun := fun z => z.down • m
                map_zero' := zero_zsmul m
                map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
            left_inv := fun g => by
              ext z
              change z.down • g.hom (ULift.up (1 : ℤ)) = g.hom z
              have hz : z = z.down • (ULift.up (1 : ℤ)) := by ext; simp
              conv_rhs => rw [hz]
              exact (g.hom.map_zsmul z.down (ULift.up (1 : ℤ))).symm
            right_inv := fun m => one_zsmul m }
      let Phi₀ : (Onemod_of N ⟶ F₀) → (Fℤ ⟶ (U_of N).obj F₀) :=
        fun ψ => ιℤ₀_of N ≫ (U_of N).map ψ
      have hPhi_eq : ∀ ψ : Onemod_of N ⟶ F₀, e_ab (Phi₀ ψ) = e_mod ψ := by
        intro ψ
        dsimp [e_ab, e_mod, Phi₀]
        have h1 : (adj_ab₀.homEquiv Aℤ ((U_of N).obj F₀)) (ιℤ₀_of N ≫ (U_of N).map ψ) =
            (z_to_m_of N ≫ ιM_of N ≫ u₀_of N) ≫ ((U_of N).map ψ).hom.app (Opposite.op T₀) := by
          rw [adj_ab₀.homEquiv_naturality_right]
          congr 1
          dsimp [ιℤ₀_of, αM₀_of]
          rw [adj_ab₀.homEquiv_naturality_left, Equiv.apply_symm_apply]
        rw [h1]
        have h2 : (adj_mod₀_of N).homEquiv (Rmod_of N) F₀ ψ =
            (adj_mod₀_of N).unit.app (Rmod_of N) ≫ ψ.hom.app (Opposite.op T₀) :=
          Adjunction.homEquiv_unit _ _ _ _
        rw [h2]
        have h_one : (z_to_m_of N ≫ ιM_of N).hom (ULift.up (1 : ℤ)) = (1 : R_of N) := by
          change ULift.up (((1 : ℤ) : ZMod N)) = ULift.up (1 : ZMod N)
          rw [Int.cast_one]
        change (((U_of N).map ψ).hom.app (Opposite.op T₀)).hom
            ((u₀_of N).hom ((z_to_m_of N ≫ ιM_of N).hom (ULift.up (1 : ℤ)))) =
          ((adj_mod₀_of N).unit.app (Rmod_of N) ≫ ψ.hom.app (Opposite.op T₀)).hom (1 : R_of N)
        rw [h_one]
        rfl
      have hPhi_bij : Function.Bijective Phi₀ := by
        have hcomp_bij : Function.Bijective (e_ab ∘ Phi₀) := by
          have heq_fn : e_ab ∘ Phi₀ = e_mod := funext hPhi_eq
          rw [heq_fn]
          exact e_mod.bijective
        exact ⟨fun ψ₁ ψ₂ h => hcomp_bij.1 (congrArg e_ab h),
          fun g => by
            obtain ⟨ψ, hψ⟩ := hcomp_bij.2 (e_ab g)
            exact ⟨ψ, e_ab.injective hψ⟩⟩
      have h_mk₀ : ∀ {C_cat : Type (u + 1)} [Category.{u + 1, u + 1} C_cat] [Abelian C_cat]
          [HasExt.{u} C_cat] {A_obj B_obj : C_cat} (f : A_obj ⟶ B_obj),
          Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f) = f :=
        fun f => Abelian.Ext.addEquiv₀.right_inv f
      let Θ₀ := ((Abelian.Ext.mk₀ (ιℤ₀_of N)).precomp ((U_of N).obj F₀) (Nat.zero_add 0)).comp
        (@Functor.mapExtAddHom _ _ _ _ _ _ (U_of N) hAdd hLim hColim _ _ (Onemod_of N) F₀ 0)
      have hΘ_comm : ∀ γ : Abelian.Ext.{u} (Onemod_of N) F₀ 0,
          Θ₀ γ = Abelian.Ext.mk₀ (Phi₀ (Abelian.Ext.addEquiv₀ γ)) := by
        intro γ
        let ψ := Abelian.Ext.addEquiv₀ γ
        have hψ : Abelian.Ext.mk₀ ψ = γ := Abelian.Ext.addEquiv₀.left_inv γ
        change (Abelian.Ext.mk₀ (ιℤ₀_of N)).comp
          ((@Functor.mapExtAddHom _ _ _ _ _ _ (U_of N) hAdd hLim hColim _ _ (Onemod_of N) F₀ 0) γ)
          (Nat.zero_add 0) = _
        rw [← hψ, @Functor.mapExtAddHom_apply _ _ _ _ _ _ (U_of N) hAdd hLim hColim,
          @Abelian.Ext.mapExactFunctor_mk₀ _ _ _ _ _ _ (U_of N) hAdd hLim hColim,
          Abelian.Ext.mk₀_comp_mk₀, h_mk₀]
      refine ⟨fun γ₁ γ₂ h => ?_, fun w => ?_⟩
      · rw [hΘ_comm γ₁, hΘ_comm γ₂] at h
        have h_mk := congrArg Abelian.Ext.addEquiv₀ h
        rw [h_mk₀, h_mk₀] at h_mk
        exact Abelian.Ext.addEquiv₀.injective (hPhi_bij.1 h_mk)
      · obtain ⟨ψ, hψ⟩ := hPhi_bij.2 (Abelian.Ext.addEquiv₀ w)
        refine ⟨Abelian.Ext.mk₀ ψ, ?_⟩
        rw [hΘ_comm, h_mk₀, hψ]
        exact Abelian.Ext.addEquiv₀.left_inv w

    have hAlignCup : ∀ (N : ℕ) (hAdd_std : (U_of N).Additive)
        (hLim_std : Limits.PreservesFiniteLimits (U_of N))
        (hColim_std : Limits.PreservesFiniteColimits (U_of N))
        (cup : weilEtaleTorsionH W N a →+ weilEtaleTorsionH W N b →+ weilEtaleTorsionH W N c),
        WeilLefschetzIsTorsionCup W N a b c hab cup →
        letI := hAdd_std; letI := hLim_std; letI := hColim_std
        ∃ (βM₀ : (U_of N).obj (Onemod_of N) ⟶ FM_of N),
          αM₀_of N ≫ βM₀ = 𝟙 (FM_of N) ∧
          βM₀ ≫ αM₀_of N = 𝟙 ((U_of N).obj (Onemod_of N)) ∧
          ∀ (α : Abelian.Ext.{u} (Onemod_of N) (Onemod_of N) a)
            (β : Abelian.Ext.{u} (Onemod_of N) (Onemod_of N) b),
            cup
              (((Abelian.Ext.mk₀ (ιℤ₀_of N)).comp
                (((U_of N).mapExtAddHom (Onemod_of N) (Onemod_of N) a) α) (Nat.zero_add a)).comp
                (Abelian.Ext.mk₀ βM₀) (Nat.add_zero a))
              (((Abelian.Ext.mk₀ (ιℤ₀_of N)).comp
                (((U_of N).mapExtAddHom (Onemod_of N) (Onemod_of N) b) β) (Nat.zero_add b)).comp
                (Abelian.Ext.mk₀ βM₀) (Nat.add_zero b)) =
            (((Abelian.Ext.mk₀ (ιℤ₀_of N)).comp
              (((U_of N).mapExtAddHom (Onemod_of N) (Onemod_of N) c) (α.comp β hab)) (Nat.zero_add c)).comp
              (Abelian.Ext.mk₀ βM₀) (Nat.add_zero c)) := by
      intro N hAdd_std hLim_std hColim_std cup hcup
      haveI := hAdd_std; haveI := hLim_std; haveI := hColim_std
      rcases hcup with ⟨U, hU_obj, hU_map, hAdd, hLim, hColim,
        T, hT, u_unit, hu_unit, πM, hαπ, hπα, hcup_eq⟩
      haveI := hAdd; haveI := hLim; haveI := hColim
      have hU_obj' : ∀ F_sh : Sheaf J (ModuleCat.{u, u} (R_of N)),
          (U.obj F_sh).obj = ((U_of N).obj F_sh).obj := hU_obj
      let σ : U ≅ U_of N :=
        NatIso.ofComponents
          (fun F_sh =>
            { hom := ⟨eqToHom (hU_obj' F_sh)⟩
              inv := ⟨eqToHom (hU_obj' F_sh).symm⟩
              hom_inv_id := Sheaf.hom_ext (by simp)
              inv_hom_id := Sheaf.hom_ext (by simp) })
          (fun {F₁ F₂} u => by
            apply Sheaf.hom_ext
            apply NatTrans.ext
            funext V
            have h1 : (U.obj F₁).obj.obj V = ((U_of N).obj F₁).obj.obj V :=
              congrArg (fun G => G.obj V) (hU_obj' F₁)
            have h2 : (U.obj F₂).obj.obj V = ((U_of N).obj F₂).obj.obj V :=
              congrArg (fun G => G.obj V) (hU_obj' F₂)
            have hm : (U.map u).hom.app V =
                eqToHom h1 ≫ ((U_of N).map u).hom.app V ≫ eqToHom h2.symm :=
              eq_eqToHom_of_heq h1 h2 (hU_map u V)
            change (U.map u).hom.app V ≫ (eqToHom (hU_obj' F₂)).app V =
              (eqToHom (hU_obj' F₁)).app V ≫ ((U_of N).map u).hom.app V
            rw [eqToHom_app, eqToHom_app, hm, Category.assoc, Category.assoc,
              eqToHom_trans, eqToHom_refl, Category.comp_id])
      let adj_ab := constantSheafAdj J AddCommGrpCat.{u} hT
      let adj_mod := constantSheafAdj J (ModuleCat.{u, u} (R_of N)) hT
      let φ : T₀ ⟶ T := hT.from T₀
      let u_T : (Ffg_of N).obj (Rmod_of N) ⟶
          ((U_of N).obj (Onemod_of N)).obj.obj (Opposite.op T) :=
        (Ffg_of N).map (adj_mod.unit.app (Rmod_of N))
      have hu_unit' : HEq u_unit u_T := hu_unit
      have hobj_T : (U.obj (Onemod_of N)).obj.obj (Opposite.op T) =
          ((U_of N).obj (Onemod_of N)).obj.obj (Opposite.op T) :=
        congrArg (fun G => G.obj (Opposite.op T)) (hU_obj' (Onemod_of N))
      have hu_σ : u_unit ≫ (σ.hom.app (Onemod_of N)).hom.app (Opposite.op T) = u_T := by
        have hu_eq : u_unit = eqToHom rfl ≫ u_T ≫ eqToHom hobj_T.symm :=
          eq_eqToHom_of_heq rfl hobj_T hu_unit'
        change u_unit ≫ (eqToHom (hU_obj' (Onemod_of N))).app (Opposite.op T) = u_T
        rw [eqToHom_app, hu_eq, eqToHom_refl, Category.id_comp, Category.assoc,
          eqToHom_trans, eqToHom_refl, Category.comp_id]
      have hu₀_map : u₀_of N = u_T ≫ ((U_of N).obj (Onemod_of N)).obj.map φ.op := by
        dsimp [u₀_of, u_T]
        rw [constAdj_unit_map_mod W N hT hT₀ φ (Rmod_of N), (Ffg_of N).map_comp]
        rfl
      let αM : FM_of N ⟶ U.obj (Onemod_of N) :=
        (adj_ab.homEquiv (AM_of N) (U.obj (Onemod_of N))).symm (ιM_of N ≫ u_unit)
      have hαM_σ : αM ≫ σ.hom.app (Onemod_of N) = αM₀_of N := by
        let g_T : AM_of N ⟶ ((U_of N).obj (Onemod_of N)).obj.obj (Opposite.op T) :=
          ιM_of N ≫ u_T
        have h1 : αM ≫ σ.hom.app (Onemod_of N) =
            (adj_ab.homEquiv (AM_of N) ((U_of N).obj (Onemod_of N))).symm g_T := by
          apply (adj_ab.homEquiv (AM_of N) ((U_of N).obj (Onemod_of N))).injective
          rw [Equiv.apply_symm_apply, adj_ab.homEquiv_naturality_right]
          have hα : (adj_ab.homEquiv (AM_of N) (U.obj (Onemod_of N))) αM = ιM_of N ≫ u_unit :=
            Equiv.apply_symm_apply _ _
          rw [hα]
          change ιM_of N ≫ (u_unit ≫ (σ.hom.app (Onemod_of N)).hom.app (Opposite.op T)) = g_T
          rw [hu_σ]
        rw [h1]
        have h2 : αM₀_of N =
            (adj_ab₀.homEquiv (AM_of N) ((U_of N).obj (Onemod_of N))).symm
              (g_T ≫ ((U_of N).obj (Onemod_of N)).obj.map φ.op) := by
          dsimp [αM₀_of, g_T]
          rw [hu₀_map, Category.assoc]
        rw [h2]
        exact (constAdj_homEquiv_symm_map W hT hT₀ φ (AM_of N)
          ((U_of N).obj (Onemod_of N)) g_T).symm
      let ιℤ : Fℤ ⟶ U.obj (Onemod_of N) := C_ab.map (z_to_m_of N) ≫ αM
      have hιℤ_σ : ιℤ ≫ σ.hom.app (Onemod_of N) = ιℤ₀_of N := by
        dsimp [ιℤ, ιℤ₀_of]
        rw [Category.assoc, hαM_σ]
      let βM₀ : (U_of N).obj (Onemod_of N) ⟶ FM_of N := σ.inv.app (Onemod_of N) ≫ πM
      have h_ab_id : αM₀_of N ≫ βM₀ = 𝟙 (FM_of N) := by
        dsimp [βM₀]
        rw [← hαM_σ, Category.assoc, ← Category.assoc (σ.hom.app _),
          σ.hom_inv_id_app, Category.id_comp]
        exact hαπ
      have h_ba_id : βM₀ ≫ αM₀_of N = 𝟙 ((U_of N).obj (Onemod_of N)) := by
        dsimp [βM₀]
        rw [← hαM_σ, Category.assoc, ← Category.assoc πM, hπα, Category.id_comp, σ.inv_hom_id_app]
      have hθ_align : ∀ (k : ℕ) (γ : Abelian.Ext.{u} (Onemod_of N) (Onemod_of N) k),
          (Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)
            ((Abelian.Ext.mk₀ ιℤ).comp
              ((U.mapExtAddHom (Onemod_of N) (Onemod_of N) k) γ) (Nat.zero_add k)) =
          (((Abelian.Ext.mk₀ (ιℤ₀_of N)).comp
            (((U_of N).mapExtAddHom (Onemod_of N) (Onemod_of N) k) γ) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ βM₀) (Nat.add_zero k)) := by
        intro k γ
        change (((Abelian.Ext.mk₀ ιℤ).comp
            ((U.mapExtAddHom (Onemod_of N) (Onemod_of N) k) γ) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ πM) (Nat.add_zero k)) = _
        rw [hExtIso (U_of N) U σ.symm (Onemod_of N) (Onemod_of N) k γ]
        change (((Abelian.Ext.mk₀ ιℤ).comp
            ((Abelian.Ext.mk₀ (σ.hom.app (Onemod_of N))).comp
              ((((U_of N).mapExtAddHom (Onemod_of N) (Onemod_of N) k) γ).comp
                (Abelian.Ext.mk₀ (σ.inv.app (Onemod_of N))) (Nat.add_zero k))
              (Nat.zero_add k))
            (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ πM) (Nat.add_zero k)) = _
        rw [ext_conj_eq ιℤ (σ.hom.app (Onemod_of N)) (σ.inv.app (Onemod_of N)) πM k _,
          hιℤ_σ,
          ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ιℤ₀_of N)) _ (Abelian.Ext.mk₀ βM₀)
            (Nat.zero_add k) (Nat.add_zero k) (Nat.zero_add k)]
      refine ⟨βM₀, h_ab_id, h_ba_id, fun α β => ?_⟩
      rw [← hθ_align a α, ← hθ_align b β, ← hθ_align c (α.comp β hab)]
      exact hcup_eq α β

    let N₁ : ℕ := ℓ ^ (r + 1)
    let N₀ : ℕ := ℓ ^ r
    have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
    have hN₁ : 1 ≤ N₁ := Nat.one_le_pow (r + 1) ℓ hℓ_pos
    have hN₀ : 1 ≤ N₀ := Nat.one_le_pow r ℓ hℓ_pos
    obtain ⟨hAdd₁, hLim₁, hColim₁⟩ := hU_exact N₁
    obtain ⟨hAdd₀, hLim₀, hColim₀⟩ := hU_exact N₀
    haveI := hAdd₁; haveI := hLim₁; haveI := hColim₁
    haveI := hAdd₀; haveI := hLim₀; haveI := hColim₀
    obtain ⟨βM₁, hαβ₁, hβα₁, hcup₁⟩ := hAlignCup N₁ hAdd₁ hLim₁ hColim₁ c_succ hs
    obtain ⟨βM₀, hαβ₀, hβα₀, hcup₀⟩ := hAlignCup N₀ hAdd₀ hLim₀ hColim₀ c_curr hr

    let π_ring : R_of N₁ →+* R_of N₀ :=
      ULift.ringEquiv.symm.toRingHom.comp
        ((ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod N₀)).comp ULift.ringEquiv.toRingHom)
    have hsc_ρ := hasSheafCompose_restrict W π_ring
    have hsc_ρ_coext := hasSheafCompose_coextRing W π_ring
    let ρ : Sheaf J (ModuleCat.{u, u} (R_of N₀)) ⥤ Sheaf J (ModuleCat.{u, u} (R_of N₁)) :=
      @sheafCompose _ _ _ _ _ _ J (ModuleCat.restrictScalars.{u, u, u} π_ring) hsc_ρ
    have hadj_ρ_R := @sheafComposeAdj _ _ J _ _ _ _ _ _ (ModuleCat.restrictCoextendScalarsAdj π_ring) hsc_ρ hsc_ρ_coext
    have := (ModuleCat.extendRestrictScalarsAdj π_ring).isRightAdjoint
    have := hadj_ρ_R.isLeftAdjoint
    haveI : ρ.Additive :=
      { map_add := fun {_ _ f g} => Sheaf.hom_ext (NatTrans.ext (funext fun _ =>
          (ModuleCat.restrictScalars.{u, u, u} π_ring).map_add)) }
    haveI : Limits.PreservesFiniteLimits ρ :=
      sheafCompose_preservesFiniteLimits (ModuleCat.restrictScalars.{u, u, u} π_ring) hsc_ρ
    haveI : Limits.PreservesFiniteColimits ρ := ⟨fun K _ _ => inferInstance⟩

    let ψ_mod : Rmod_of N₁ ⟶ (ModuleCat.restrictScalars.{u, u, u} π_ring).obj (Rmod_of N₀) :=
      ModuleCat.ofHom (Y := (ModuleCat.restrictScalars.{u, u, u} π_ring).obj (Rmod_of N₀))
        { toFun := fun t => π_ring t
          map_add' := π_ring.map_add
          map_smul' := fun c t => π_ring.map_mul c t }
    let c_mod : Onemod_of N₁ ⟶ ρ.obj (Onemod_of N₀) :=
      ((adj_mod₀_of N₁).homEquiv (Rmod_of N₁) (ρ.obj (Onemod_of N₀))).symm
        (ψ_mod ≫ (ModuleCat.restrictScalars.{u, u, u} π_ring).map
          ((adj_mod₀_of N₀).unit.app (Rmod_of N₀)))

    let φ_cast : AM_of N₁ ⟶ AM_of N₀ :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod N₀)).toAddMonoidHom)

    let αM₀' : FM_of N₀ ⟶ (U_of N₁).obj (ρ.obj (Onemod_of N₀)) := αM₀_of N₀
    let βM₀' : (U_of N₁).obj (ρ.obj (Onemod_of N₀)) ⟶ FM_of N₀ := βM₀
    let ιℤ₀' : Fℤ ⟶ (U_of N₁).obj (ρ.obj (Onemod_of N₀)) := ιℤ₀_of N₀
    have hαβ₀' : αM₀' ≫ βM₀' = 𝟙 (FM_of N₀) := hαβ₀
    have hβα₀' : βM₀' ≫ αM₀' = 𝟙 ((U_of N₁).obj (ρ.obj (Onemod_of N₀))) := hβα₀

    have hα_cmod : αM₀_of N₁ ≫ (U_of N₁).map c_mod = C_ab.map φ_cast ≫ αM₀' := by
      apply (adj_ab₀.homEquiv (AM_of N₁) ((U_of N₁).obj (ρ.obj (Onemod_of N₀)))).injective
      let S_tgt : AddCommGrpCat.{u} :=
        ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T₀)).obj
          ((U_of N₁).obj (ρ.obj (Onemod_of N₀)))
      let u₀' : (Ffg_of N₀).obj (Rmod_of N₀) ⟶ S_tgt := u₀_of N₀
      have h1 : (adj_ab₀.homEquiv (AM_of N₁) ((U_of N₁).obj (Onemod_of N₁))) (αM₀_of N₁) =
          ιM_of N₁ ≫ u₀_of N₁ := Equiv.apply_symm_apply _ _
      have h2 : (adj_ab₀.homEquiv (AM_of N₁) ((U_of N₁).obj (ρ.obj (Onemod_of N₀))))
          (C_ab.map φ_cast ≫ αM₀') =
          φ_cast ≫ ιM_of N₀ ≫ u₀' := by
        rw [adj_ab₀.homEquiv_naturality_left]
        congr 1
        exact Equiv.apply_symm_apply
          (adj_ab₀.homEquiv (AM_of N₀) ((U_of N₀).obj (Onemod_of N₀))) (ιM_of N₀ ≫ u₀_of N₀)
      rw [adj_ab₀.homEquiv_naturality_right, h1, h2]
      have hc_eq : (adj_mod₀_of N₁).unit.app (Rmod_of N₁) ≫ c_mod.hom.app (Opposite.op T₀) =
          ψ_mod ≫ (ModuleCat.restrictScalars.{u, u, u} π_ring).map
            ((adj_mod₀_of N₀).unit.app (Rmod_of N₀)) := by
        change ((adj_mod₀_of N₁).homEquiv (Rmod_of N₁) (ρ.obj (Onemod_of N₀))) c_mod = _
        exact Equiv.apply_symm_apply _ _
      apply AddCommGrpCat.ext
      intro t
      exact ConcreteCategory.congr_hom hc_eq t

    have hιℤ_cmod : ιℤ₀_of N₁ ≫ (U_of N₁).map c_mod = ιℤ₀' := by
      change (C_ab.map (z_to_m_of N₁) ≫ αM₀_of N₁) ≫ (U_of N₁).map c_mod =
        C_ab.map (z_to_m_of N₀) ≫ αM₀'
      rw [Category.assoc, hα_cmod, ← Category.assoc, ← C_ab.map_comp]
      congr 2
      ext z
      change ULift.up ((ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod N₀)) (z.down : ZMod N₁)) =
        ULift.up (z.down : ZMod N₀)
      rw [map_intCast]

    have hβ_cast : βM₁ ≫ C_ab.map φ_cast = (U_of N₁).map c_mod ≫ βM₀' := by
      calc
        βM₁ ≫ C_ab.map φ_cast = βM₁ ≫ C_ab.map φ_cast ≫ 𝟙 (FM_of N₀) := by rw [Category.comp_id]
        _ = βM₁ ≫ C_ab.map φ_cast ≫ (αM₀' ≫ βM₀') := by rw [hαβ₀']
        _ = βM₁ ≫ (C_ab.map φ_cast ≫ αM₀') ≫ βM₀' := by
          rw [← Category.assoc (C_ab.map φ_cast) αM₀' βM₀']
        _ = βM₁ ≫ (αM₀_of N₁ ≫ (U_of N₁).map c_mod) ≫ βM₀' := by rw [hα_cmod]
        _ = (βM₁ ≫ αM₀_of N₁) ≫ (U_of N₁).map c_mod ≫ βM₀' := by
          rw [Category.assoc (αM₀_of N₁) ((U_of N₁).map c_mod) βM₀',
            ← Category.assoc βM₁ (αM₀_of N₁) _]
        _ = (U_of N₁).map c_mod ≫ βM₀' := by rw [hβα₁, Category.id_comp]

    let θ₁_fn (k : ℕ) : Abelian.Ext.{u} (Onemod_of N₁) (Onemod_of N₁) k →+ weilEtaleTorsionH W N₁ k :=
      ((Abelian.Ext.mk₀ βM₁).postcomp Fℤ (Nat.add_zero k)).comp
        (((Abelian.Ext.mk₀ (ιℤ₀_of N₁)).precomp ((U_of N₁).obj (Onemod_of N₁)) (Nat.zero_add k)).comp
          ((U_of N₁).mapExtAddHom (Onemod_of N₁) (Onemod_of N₁) k))

    let θ₀_fn (k : ℕ) : Abelian.Ext.{u} (Onemod_of N₀) (Onemod_of N₀) k →+ weilEtaleTorsionH W N₀ k :=
      ((Abelian.Ext.mk₀ βM₀).postcomp Fℤ (Nat.add_zero k)).comp
        (((Abelian.Ext.mk₀ (ιℤ₀_of N₀)).precomp ((U_of N₀).obj (Onemod_of N₀)) (Nat.zero_add k)).comp
          ((U_of N₀).mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k))

    have hθ₁_surj : ∀ k : ℕ, Function.Surjective (θ₁_fn k) := by
      intro k w
      have hbij := hTheta_bij N₁ hN₁ hAdd₁ hLim₁ hColim₁ k (Onemod_of N₁)
      obtain ⟨γ, hγ⟩ := hbij.2 (w.comp (Abelian.Ext.mk₀ (αM₀_of N₁)) (Nat.add_zero k))
      refine ⟨γ, ?_⟩
      change (((Abelian.Ext.mk₀ (ιℤ₀_of N₁)).precomp ((U_of N₁).obj (Onemod_of N₁)) (Nat.zero_add k)).comp
          ((U_of N₁).mapExtAddHom (Onemod_of N₁) (Onemod_of N₁) k) γ).comp
          (Abelian.Ext.mk₀ βM₁) (Nat.add_zero k) = w
      rw [hγ, Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ (αM₀_of N₁))
        (Abelian.Ext.mk₀ βM₁) (Nat.add_zero k), Abelian.Ext.mk₀_comp_mk₀, hαβ₁,
        Abelian.Ext.comp_mk₀_id]

    have hθ₀_surj : ∀ k : ℕ, Function.Surjective (θ₀_fn k) := by
      intro k w
      have hbij := hTheta_bij N₀ hN₀ hAdd₀ hLim₀ hColim₀ k (Onemod_of N₀)
      obtain ⟨γ, hγ⟩ := hbij.2 (w.comp (Abelian.Ext.mk₀ (αM₀_of N₀)) (Nat.add_zero k))
      refine ⟨γ, ?_⟩
      change (((Abelian.Ext.mk₀ (ιℤ₀_of N₀)).precomp ((U_of N₀).obj (Onemod_of N₀)) (Nat.zero_add k)).comp
          ((U_of N₀).mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ).comp
          (Abelian.Ext.mk₀ βM₀) (Nat.add_zero k) = w
      rw [hγ, Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ (αM₀_of N₀))
        (Abelian.Ext.mk₀ βM₀) (Nat.add_zero k), Abelian.Ext.mk₀_comp_mk₀, hαβ₀,
        Abelian.Ext.comp_mk₀_id]

    let Θ_ρ (k : ℕ) :=
      ((Abelian.Ext.mk₀ (ιℤ₀_of N₁)).precomp ((U_of N₁).obj (ρ.obj (Onemod_of N₀))) (Nat.zero_add k)).comp
        ((U_of N₁).mapExtAddHom (Onemod_of N₁) (ρ.obj (Onemod_of N₀)) k)

    have hTrans_LHS : ∀ (k : ℕ) (γ₁ : Abelian.Ext.{u} (Onemod_of N₁) (Onemod_of N₁) k),
        weilEtaleTorsionTransition W ℓ r k (θ₁_fn k γ₁) =
          (Θ_ρ k (γ₁.comp (Abelian.Ext.mk₀ c_mod) (Nat.add_zero k))).comp
            (Abelian.Ext.mk₀ βM₀') (Nat.add_zero k) := by
      intro k γ₁
      change ((((Abelian.Ext.mk₀ (ιℤ₀_of N₁)).comp
          (((U_of N₁).mapExtAddHom (Onemod_of N₁) (Onemod_of N₁) k) γ₁) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ βM₁) (Nat.add_zero k)).comp
          (Abelian.Ext.mk₀ (C_ab.map φ_cast)) (Nat.add_zero k)) =
        (((Abelian.Ext.mk₀ (ιℤ₀_of N₁)).comp
          (((U_of N₁).mapExtAddHom (Onemod_of N₁) (ρ.obj (Onemod_of N₀)) k)
            (γ₁.comp (Abelian.Ext.mk₀ c_mod) (Nat.add_zero k))) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ βM₀') (Nat.add_zero k))
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero _ (Abelian.Ext.mk₀ βM₁)
          (Abelian.Ext.mk₀ (C_ab.map φ_cast)) (Nat.add_zero k),
        Abelian.Ext.mk₀_comp_mk₀, hβ_cast, ← Abelian.Ext.mk₀_comp_mk₀ ((U_of N₁).map c_mod) βM₀',
        Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ιℤ₀_of N₁)) _
          (Abelian.Ext.mk₀ ((U_of N₁).map c_mod))
          (Nat.zero_add k) (Nat.add_zero k) (Nat.zero_add k),
        Abelian.Ext.comp_assoc_of_third_deg_zero _
          (Abelian.Ext.mk₀ ((U_of N₁).map c_mod)) (Abelian.Ext.mk₀ βM₀') (Nat.add_zero k)]

    have hTrans_RHS : ∀ (k : ℕ) (γ₀ : Abelian.Ext.{u} (Onemod_of N₀) (Onemod_of N₀) k),
        θ₀_fn k γ₀ =
          (Θ_ρ k ((Abelian.Ext.mk₀ c_mod).comp
            ((ρ.mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ₀) (Nat.zero_add k))).comp
            (Abelian.Ext.mk₀ βM₀') (Nat.add_zero k) := by
      intro k γ₀
      have hcomp_ext : ((U_of N₀).mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ₀ =
          ((U_of N₁).mapExtAddHom (ρ.obj (Onemod_of N₀)) (ρ.obj (Onemod_of N₀)) k)
            ((ρ.mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ₀) :=
        @hExtComp _ _ _ _ _ _ _ _ _ _ _ _ _ ρ (U_of N₁) _ _ _ hAdd₁ hLim₁ hColim₁
          hAdd₀ hLim₀ hColim₀ (Onemod_of N₀) (Onemod_of N₀) k γ₀
      have h_lhs_eq : θ₀_fn k γ₀ =
          (((Abelian.Ext.mk₀ ιℤ₀').comp
            (((U_of N₁).mapExtAddHom (ρ.obj (Onemod_of N₀)) (ρ.obj (Onemod_of N₀)) k)
              ((ρ.mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ₀)) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ βM₀') (Nat.add_zero k)) := by
        change (((Abelian.Ext.mk₀ (ιℤ₀_of N₀)).comp
            (((U_of N₀).mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ₀) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ βM₀) (Nat.add_zero k)) = _
        rw [hcomp_ext]
        rfl
      rw [h_lhs_eq]
      change _ =
        (((Abelian.Ext.mk₀ (ιℤ₀_of N₁)).comp
          (((U_of N₁).mapExtAddHom (Onemod_of N₁) (ρ.obj (Onemod_of N₀)) k)
            ((Abelian.Ext.mk₀ c_mod).comp
              ((ρ.mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ₀) (Nat.zero_add k)))
          (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ βM₀') (Nat.add_zero k))
      congr 1
      simp only [Functor.mapExtAddHom_apply]
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        ← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (ιℤ₀_of N₁))
          (Abelian.Ext.mk₀ ((U_of N₁).map c_mod)) _ (Nat.zero_add k),
        Abelian.Ext.mk₀_comp_mk₀, hιℤ_cmod]

    obtain ⟨α₁, rfl⟩ := hθ₁_surj a x
    obtain ⟨β₁, rfl⟩ := hθ₁_surj b y
    obtain ⟨α₀, hα₀⟩ := hθ₀_surj a (weilEtaleTorsionTransition W ℓ r a (θ₁_fn a α₁))
    obtain ⟨β₀, hβ₀⟩ := hθ₀_surj b (weilEtaleTorsionTransition W ℓ r b (θ₁_fn b β₁))

    have h_eq_mod : ∀ (k : ℕ)
        (γ₁ : Abelian.Ext.{u} (Onemod_of N₁) (Onemod_of N₁) k)
        (γ₀ : Abelian.Ext.{u} (Onemod_of N₀) (Onemod_of N₀) k),
        θ₀_fn k γ₀ = weilEtaleTorsionTransition W ℓ r k (θ₁_fn k γ₁) →
        γ₁.comp (Abelian.Ext.mk₀ c_mod) (Nat.add_zero k) =
          (Abelian.Ext.mk₀ c_mod).comp ((ρ.mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) k) γ₀)
            (Nat.zero_add k) := by
      intro k γ₁ γ₀ heq
      rw [hTrans_LHS k γ₁, hTrans_RHS k γ₀] at heq
      have heq' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ αM₀') (Nat.add_zero k)) heq
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero _ (Abelian.Ext.mk₀ βM₀')
          (Abelian.Ext.mk₀ αM₀') (Nat.add_zero k),
        Abelian.Ext.comp_assoc_of_third_deg_zero _ (Abelian.Ext.mk₀ βM₀')
          (Abelian.Ext.mk₀ αM₀') (Nat.add_zero k),
        Abelian.Ext.mk₀_comp_mk₀, hβα₀', Abelian.Ext.comp_mk₀_id, Abelian.Ext.comp_mk₀_id] at heq'
      exact (hTheta_bij N₁ hN₁ hAdd₁ hLim₁ hColim₁ k (ρ.obj (Onemod_of N₀))).1 heq'.symm

    have hα_rel := h_eq_mod a α₁ α₀ hα₀
    have hβ_rel := h_eq_mod b β₁ β₀ hβ₀

    have h_prod_rel :
        (α₁.comp β₁ hab).comp (Abelian.Ext.mk₀ c_mod) (Nat.add_zero c) =
        (Abelian.Ext.mk₀ c_mod).comp
          ((ρ.mapExtAddHom (Onemod_of N₀) (Onemod_of N₀) c) (α₀.comp β₀ hab))
          (Nat.zero_add c) := by
      rw [Abelian.Ext.comp_assoc α₁ β₁ (Abelian.Ext.mk₀ c_mod) hab (Nat.add_zero b) hab,
        hβ_rel,
        ← Abelian.Ext.comp_assoc α₁ (Abelian.Ext.mk₀ c_mod) _ (Nat.add_zero a) (Nat.zero_add b) hab,
        hα_rel,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ c_mod) _ _ (Nat.zero_add a) hab (by omega),
        Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
        Abelian.Ext.mapExactFunctor_comp]

    have hc_succ_eq : c_succ (θ₁_fn a α₁) (θ₁_fn b β₁) = θ₁_fn c (α₁.comp β₁ hab) := hcup₁ α₁ β₁
    have hc_curr_eq : c_curr (θ₀_fn a α₀) (θ₀_fn b β₀) = θ₀_fn c (α₀.comp β₀ hab) := hcup₀ α₀ β₀
    rw [hc_succ_eq, ← hα₀, ← hβ₀, hc_curr_eq, hTrans_LHS c (α₁.comp β₁ hab),
      hTrans_RHS c (α₀.comp β₀ hab), h_prod_rel]

theorem weil_gysin_p1_mod_prime_cohomology_and_origin_nonvanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    (ι_P1 : Quiver.Hom (weilGysinAffineSpace k 1) (weilProjectiveSpaceOver k 1).left)
    (s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) (weilProjectiveSpaceOver k 1).left)
    (hInt_P1 : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left)
    (hProp_P1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom)
    (hSm_P1 : AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom)
    (hOpen_P1 : AlgebraicGeometry.IsOpenImmersion ι_P1)
    (hComp_P1 : CategoryTheory.CategoryStruct.comp ι_P1 (weilProjectiveSpaceOver k 1).hom =
      weilGysinAffineStruct k 1)
    (hs_inf : CategoryTheory.CategoryStruct.comp s_inf (weilProjectiveSpaceOver k 1).hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hCompl_inf : (Set.range ι_P1.base)ᶜ = Set.range s_inf.base) :
    Nat.card (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 0) = ℓ ∧
    Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 1) ∧
    Nat.card (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 2) = ℓ ∧
    (∀ (s₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) (weilProjectiveSpaceOver k 1).left)
       (V_compl : (weilProjectiveSpaceOver k 1).left.Opens)
       (e_compl : CategoryTheory.Iso V_compl.toScheme (weilGysinAffineSpace k 1))
       (τ_P1 : WeilGysinSupportClass (AlgebraicGeometry.Spec (CommRingCat.of k))
         (weilProjectiveSpaceOver k 1).left s₀ (ℓ ^ 1) 2)
       (cl₁ : weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 2),
      CategoryTheory.CategoryStruct.comp s₀ (weilProjectiveSpaceOver k 1).hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      (V_compl : Set ↥(weilProjectiveSpaceOver k 1).left) = (Set.range s₀.base)ᶜ →
      CategoryTheory.CategoryStruct.comp e_compl.hom (weilGysinAffineStruct k 1) =
        CategoryTheory.CategoryStruct.comp V_compl.ι (weilProjectiveSpaceOver k 1).hom →
      τ_P1.val ≠ 0 →
      WeilGysinForgetsTo τ_P1 cl₁ →
      cl₁ ≠ 0) :=
by
  classical
  simp only [pow_one]
  have hModComp := weil_etale_module_ext_comparison.{u}.1
  have hRecollementAndH0 :
      (∀ (X : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥X] [Nonempty ↥X] (m : ℕ),
        Nonempty (weilEtaleTorsionH X m 0 ≃ ZMod m)) ∧
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
        [AlgebraicGeometry.IsClosedImmersion i]
        (V : Y.Opens) (hV : (V : Set ↥Y) = (Set.range i.base)ᶜ)
        (m : ℕ) (hV_H1 : Subsingleton (weilEtaleModuleH V.toScheme m 1))
        (τ : WeilGysinSupportClass Z Y i m 2) (cl : weilEtaleTorsionH Y m 2),
        τ.val ≠ 0 → WeilGysinForgetsTo τ cl → cl ≠ 0) := by
    have hConstTermInv : ∀ {𝒞 : Type (u + 1)} [Category.{u} 𝒞]
        (J : GrothendieckTopology 𝒞)
        (𝒟 : Type (u + 1)) [Category.{u} 𝒟] [HasWeakSheafify J 𝒟]
        {T₁ T₂ : 𝒞} (hT₁ : Limits.IsTerminal T₁) (hT₂ : Limits.IsTerminal T₂),
        let τ₁₂ : T₁ ⟶ T₂ := hT₂.from T₁
        let adj₁ := constantSheafAdj J 𝒟 hT₁
        let adj₂ := constantSheafAdj J 𝒟 hT₂
        (∀ (A : 𝒟) (ℱ : Sheaf J 𝒟) (f : A ⟶ ℱ.obj.obj (Opposite.op T₂)),
          (adj₁.homEquiv A ℱ).symm (f ≫ ℱ.obj.map τ₁₂.op) = (adj₂.homEquiv A ℱ).symm f) ∧
        (∀ (A : 𝒟),
          adj₂.unit.app A ≫ ((constantSheaf J 𝒟).obj A).obj.map τ₁₂.op = adj₁.unit.app A) := by
      intro 𝒞 _ J 𝒟 _ _ T₁ T₂ hT₁ hT₂ τ₁₂ adj₁ adj₂
      have hunit : ∀ (A : 𝒟),
          adj₂.unit.app A ≫ ((constantSheaf J 𝒟).obj A).obj.map τ₁₂.op = adj₁.unit.app A := by
        intro A
        let η_sh := (sheafificationAdjunction J 𝒟).unit.app ((Functor.const 𝒞ᵒᵖ).obj A)
        have hunit_eval : ∀ {T : 𝒞} (hT : Limits.IsTerminal T),
            (constantSheafAdj J 𝒟 hT).unit.app A = η_sh.app (Opposite.op T) := by
          intro T hT
          rw [constantSheafAdj, Adjunction.comp_unit_app]
          change 𝟙 A ≫ η_sh.app (Opposite.op T) = η_sh.app (Opposite.op T)
          exact Category.id_comp _
        have hnat : 𝟙 A ≫ η_sh.app (Opposite.op T₁) =
            η_sh.app (Opposite.op T₂) ≫ ((constantSheaf J 𝒟).obj A).obj.map τ₁₂.op :=
          η_sh.naturality τ₁₂.op
        rw [Category.id_comp] at hnat
        rw [hunit_eval hT₂, hunit_eval hT₁]
        exact hnat.symm
      refine ⟨fun A ℱ f => ?_, hunit⟩
      apply (adj₁.homEquiv A ℱ).injective
      rw [Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
      let g₂ : (constantSheaf J 𝒟).obj A ⟶ ℱ := (adj₂.homEquiv A ℱ).symm f
      change f ≫ ℱ.obj.map τ₁₂.op = adj₁.unit.app A ≫ g₂.hom.app (Opposite.op T₁)
      rw [← hunit A, Category.assoc]
      have hnat_g₂ : ((constantSheaf J 𝒟).obj A).obj.map τ₁₂.op ≫ g₂.hom.app (Opposite.op T₁) =
          g₂.hom.app (Opposite.op T₂) ≫ ℱ.obj.map τ₁₂.op :=
        g₂.hom.naturality τ₁₂.op
      rw [hnat_g₂, ← Category.assoc]
      have hg₂ : adj₂.unit.app A ≫ g₂.hom.app (Opposite.op T₂) = f := by
        have h1 := (adj₂.homEquiv A ℱ).apply_symm_apply f
        rw [Adjunction.homEquiv_unit] at h1
        exact h1
      rw [hg₂]
    let zeroBdrySubmod (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (m : ℕ) (U : S.Etale) :
        Submodule (ULift.{u, 0} (ZMod m))
          (LocallyConstant ↥U.left (ULift.{u, 0} (ZMod m))) :=
      { carrier := { g | ∀ x : ↥U.left, U.hom.base x ∉ (V : Set ↥S) → g x = 0 }
        add_mem' := fun {a b} ha hb x hx => by
          change a x + b x = 0
          rw [ha x hx, hb x hx, add_zero]
        zero_mem' := fun _ _ => rfl
        smul_mem' := fun c {a} ha x hx => by
          change c • a x = 0
          rw [ha x hx, smul_zero] }
    let zeroBdryPresheaf (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (m : ℕ) :
        (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)) :=
      { obj := fun opU => ModuleCat.of (ULift.{u, 0} (ZMod m)) ↥(zeroBdrySubmod S V m opU.unop)
        map := fun {opU₁ opU₂} f => ModuleCat.ofHom
          { toFun := fun g =>
              ⟨{ toFun := fun x => g.1 (f.unop.left.base x)
                 isLocallyConstant := fun t =>
                   f.unop.left.continuous.isOpen_preimage _ (g.1.isLocallyConstant t) },
               fun x hx => g.2 (f.unop.left.base x) fun hmem => hx <| by
                 have hw : f.unop.left ≫ opU₁.unop.hom = opU₂.unop.hom :=
                   MorphismProperty.Over.w f.unop
                 have happ : opU₁.unop.hom.base (f.unop.left.base x) = opU₂.unop.hom.base x := by
                   rw [← Scheme.Hom.comp_apply, hw]
                 rwa [← happ]⟩
            map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl)
            map_smul' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
        map_id := fun _ => ModuleCat.hom_ext (LinearMap.ext fun _ =>
          Subtype.ext (LocallyConstant.ext fun _ => rfl))
        map_comp := fun _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ =>
          Subtype.ext (LocallyConstant.ext fun _ => rfl)) }
    have hMemEtaleJ : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (S_cov : Sieve U),
        S_cov ∈ S.smallEtaleTopology U ↔ ∀ x : ↥U.left, ∃ (Y : S.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          S_cov.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
      intro S U S_cov
      let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
      have hJ_eq :=
        Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) S le_rfl
      exact (Eq.to_iff (congrArg (fun G : GrothendieckTopology (P_et.Over ⊤ S) => S_cov ∈ G U) hJ_eq)).trans
        (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U S_cov)
    have hZeroBdryCorep : ∀ (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (m : ℕ),
        let R := ULift.{u, 0} (ZMod m)
        let J := S.smallEtaleTopology
        let U_V : S.Etale := MorphismProperty.Over.mk ⊤ V.ι
          (inferInstance : AlgebraicGeometry.Etale V.ι)
        let one_V : ↥(zeroBdrySubmod S V m U_V) :=
          ⟨LocallyConstant.const ↥V.toScheme (1 : R), fun x hx => absurd x.2 hx⟩
        ∃ (hSh : Presheaf.IsSheaf J (zeroBdryPresheaf S V m)),
          let K_sh : Sheaf J (ModuleCat.{u, u} R) := ⟨zeroBdryPresheaf S V m, hSh⟩
          ∀ (ℱ : Sheaf J (ModuleCat.{u, u} R)) (s₀ : ↥(ℱ.obj.obj (Opposite.op U_V))),
            ∃! (Ψ : K_sh ⟶ ℱ), (Ψ.hom.app (Opposite.op U_V)).hom one_V = s₀ := by
      intro S V m R J U_V one_V
      let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
      have hMult : P_et.IsMultiplicative := inferInstance
      haveI := hMult.toContainsIdentities
      haveI := hMult.toIsStableUnderComposition
      let submod := zeroBdrySubmod S V m
      let K_pre := zeroBdryPresheaf S V m
      have hSh : Presheaf.IsSheaf J K_pre := by
        intro E U S_cov hS_cov
        have hMem : ∀ x : ↥U.left, ∃ (Y : S.Etale) (f : Y ⟶ U) (y : ↥Y.left),
            S_cov.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x :=
          (hMemEtaleJ S U S_cov).mp hS_cov
        intro φ hcompat
        have hpt_eq : ∀ (e : E) {Y₁ Y₂ : S.Etale} {f₁ : Y₁ ⟶ U} {f₂ : Y₂ ⟶ U}
            (hf₁ : S_cov.arrows f₁) (hf₂ : S_cov.arrows f₂)
            (y₁ : ↥Y₁.left) (y₂ : ↥Y₂.left),
            f₁.left.base y₁ = f₂.left.base y₂ →
            ((φ f₁ hf₁).hom e).1 y₁ = ((φ f₂ hf₂).hom e).1 y₂ := by
          intro e Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
          have hEt₁ : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
          have hEt₂ : AlgebraicGeometry.Etale Y₂.hom := Y₂.prop
          have hEtU : AlgebraicGeometry.Etale U.hom := U.prop
          have hf₁_et : AlgebraicGeometry.Etale f₁.left := by
            have hw : f₁.left ≫ U.hom = Y₁.hom := MorphismProperty.Over.w f₁
            exact MorphismProperty.of_postcomp P_et f₁.left U.hom hEtU (hw.symm ▸ hEt₁)
          have hf₂_et : AlgebraicGeometry.Etale f₂.left := by
            have hw : f₂.left ≫ U.hom = Y₂.hom := MorphismProperty.Over.w f₂
            exact MorphismProperty.of_postcomp P_et f₂.left U.hom hEtU (hw.symm ▸ hEt₂)
          let W_pb := Limits.pullback f₁.left f₂.left
          let p₁ : W_pb ⟶ Y₁.left := Limits.pullback.fst f₁.left f₂.left
          let p₂ : W_pb ⟶ Y₂.left := Limits.pullback.snd f₁.left f₂.left
          have hp₁_et : AlgebraicGeometry.Etale p₁ := by
            have := hf₂_et
            infer_instance
          have hW_et : AlgebraicGeometry.Etale (p₁ ≫ Y₁.hom) :=
            MorphismProperty.comp_mem P_et p₁ Y₁.hom hp₁_et hEt₁
          let W_obj : S.Etale := MorphismProperty.Over.mk ⊤ (p₁ ≫ Y₁.hom) hW_et
          let g₁ : W_obj ⟶ Y₁ := MorphismProperty.Over.homMk p₁ rfl
          let g₂ : W_obj ⟶ Y₂ := MorphismProperty.Over.homMk p₂ <| by
            change p₂ ≫ Y₂.hom = p₁ ≫ Y₁.hom
            rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂,
              ← Category.assoc, ← Category.assoc, Limits.pullback.condition]
          have hg_eq : g₁ ≫ f₁ = g₂ ≫ f₂ :=
            MorphismProperty.Over.Hom.ext Limits.pullback.condition
          obtain ⟨z, hz₁, hz₂⟩ := Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy
          have hc := hcompat g₁ g₂ hf₁ hf₂ hg_eq
          have hce := congrArg (fun m : E ⟶ K_pre.obj (Opposite.op W_obj) => (m.hom e).1 z) hc
          change ((φ f₁ hf₁).hom e).1 (p₁.base z) = ((φ f₂ hf₂).hom e).1 (p₂.base z) at hce
          rwa [hz₁, hz₂] at hce
        choose Yx fx yx hfx_mem hfx_et hfx_pt using hMem
        let g_of (e : E) : ↥(submod U) :=
          ⟨{ toFun := fun x => ((φ (fx x) (hfx_mem x)).hom e).1 (yx x)
             isLocallyConstant := fun T => by
               have hT_eq : (fun x : ↥U.left => ((φ (fx x) (hfx_mem x)).hom e).1 (yx x)) ⁻¹' T =
                   ⋃ (Y : S.Etale) (f : Y ⟶ U) (hf : S_cov.arrows f ∧ AlgebraicGeometry.Etale f.left),
                     f.left.base '' ((((φ f hf.1).hom e).1) ⁻¹' T) := by
                 ext x
                 simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
                 constructor
                 · intro hxT
                   exact ⟨Yx x, fx x, ⟨hfx_mem x, hfx_et x⟩, yx x, hxT, hfx_pt x⟩
                 · rintro ⟨Y, f, ⟨hfS, _⟩, y, hyT, rfl⟩
                   have heq := hpt_eq e (hfx_mem (f.left.base y)) hfS (yx (f.left.base y)) y
                     (hfx_pt (f.left.base y))
                   rwa [heq]
               rw [hT_eq]
               refine isOpen_iUnion fun Y => isOpen_iUnion fun f => isOpen_iUnion fun hf => ?_
               have : AlgebraicGeometry.Etale f.left := hf.2
               exact f.left.isOpenMap _ (((φ f hf.1).hom e).1.isLocallyConstant T) },
           fun x hx => by
             have hw : (fx x).left ≫ U.hom = (Yx x).hom := MorphismProperty.Over.w (fx x)
             have hy_not : (Yx x).hom.base (yx x) ∉ (V : Set ↥S) := by
               rw [← hw, Scheme.Hom.comp_apply, hfx_pt x]
               exact hx
             exact ((φ (fx x) (hfx_mem x)).hom e).2 (yx x) hy_not⟩
        have hg_res : ∀ (e : E) {Y : S.Etale} (f : Y ⟶ U) (hf : S_cov.arrows f) (y : ↥Y.left),
            (g_of e).1 (f.left.base y) = ((φ f hf).hom e).1 y :=
          fun e {_} f hf y => hpt_eq e (hfx_mem (f.left.base y)) hf (yx (f.left.base y)) y
            (hfx_pt (f.left.base y))
        let Φ_glued : E ⟶ K_pre.obj (Opposite.op U) := ModuleCat.ofHom
          { toFun := g_of
            map_add' := fun e₁ e₂ => Subtype.ext <| LocallyConstant.ext fun x => by
              change ((φ (fx x) (hfx_mem x)).hom (e₁ + e₂)).1 (yx x) =
                ((φ (fx x) (hfx_mem x)).hom e₁).1 (yx x) + ((φ (fx x) (hfx_mem x)).hom e₂).1 (yx x)
              rw [map_add]
              rfl
            map_smul' := fun r e => Subtype.ext <| LocallyConstant.ext fun x => by
              change ((φ (fx x) (hfx_mem x)).hom (r • e)).1 (yx x) =
                r • ((φ (fx x) (hfx_mem x)).hom e).1 (yx x)
              rw [map_smul]
              rfl }
        refine ⟨Φ_glued, fun Y f hf => ?_, fun Ψ hΨ => ?_⟩
        · apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro e
          apply Subtype.ext
          apply LocallyConstant.ext
          intro y
          exact hg_res e f hf y
        · apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro e
          apply Subtype.ext
          apply LocallyConstant.ext
          intro x
          have hΨx := congrArg (fun m : E ⟶ K_pre.obj (Opposite.op (Yx x)) => (m.hom e).1 (yx x))
            (hΨ (fx x) (hfx_mem x))
          change (Ψ.hom e).1 ((fx x).left.base (yx x)) =
            ((φ (fx x) (hfx_mem x)).hom e).1 (yx x) at hΨx
          rwa [hfx_pt x] at hΨx
      refine ⟨hSh, ?_⟩
      intro K_sh ℱ s₀
      let R_mod := ModuleCat.of R R
      let toHom : ∀ {M : ModuleCat.{u, u} R}, ↥M → (R_mod ⟶ M) := fun {M} m =>
        ModuleCat.ofHom
          { toFun := fun r => r • m
            map_add' := fun r₁ r₂ => add_smul r₁ r₂ m
            map_smul' := fun c r => mul_smul c r m }
      have toHom_inj : ∀ {M : ModuleCat.{u, u} R} {m₁ m₂ : ↥M},
