        p_C.app W ≫ C.presheaf.germ ((TopologicalSpace.Opens.map p_C.base).obj W) x_C
          (by
            change p_C.base x_C ∈ W
            rw [hpC_gen]
            obtain ⟨w₀⟩ := ‹Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})›
            exact ((genericPoint_spec ↥P.left).mem_open_set_iff W.isOpen).mpr
