theorem weil_gysin_smooth_curve_cokernel_divisor_injection_and_tsen (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (hGmSheaf : ∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X))
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsIntegral Y.left]
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 Y.hom] :
    let J_Y := Y.left.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ
    let Pt_Y := { y : ↥Y.left // IsClosed ({y} : Set ↥Y.left) }
    Subsingleton ((weilEtaleKSheaf Y.left).H 1) ∧
    ∃ (Q_div : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (ι_gm : Quiver.Hom (weilEtaleGmSheaf Y.left) (weilEtaleKSheaf Y.left))
      (π_div : Quiver.Hom (weilEtaleKSheaf Y.left) Q_div)
      (h0_div : CategoryTheory.CategoryStruct.comp ι_gm π_div = 0)
      (div_H0 : Q_div.H 0 →+ (Pt_Y →₀ ℤ)),
      (CategoryTheory.ShortComplex.mk ι_gm π_div h0_div).ShortExact ∧
      Function.Injective div_H0 ∧
      (∀ D ∈ weilCurvePrincipalSubgroup Y.left,
        ∃ k₀ : (weilEtaleKSheaf Y.left).H 0,
          div_H0 (k₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_div) (Nat.add_zero 0)) = D) ∧
      (∀ (y : ↥Y.left) (hy : IsClosed ({y} : Set ↥Y.left))
          (O₁ : Y.left.Opens) (hy_mem : y ∈ O₁),
        let O₂ : Y.left.Opens := ⟨({y} : Set ↥Y.left)ᶜ, hy.isOpen_compl⟩
        let O₁₂ : Y.left.Opens := O₁ ⊓ O₂
        let U₁ : Y.left.Etale := weilGysinEtaleObj O₁.ι inferInstance
        let U₂ : Y.left.Etale := weilGysinEtaleObj O₂.ι inferInstance
        let U₁₂ : Y.left.Etale := weilGysinEtaleObj O₁₂.ι inferInstance
        let j₁₂_₁ : Quiver.Hom U₁₂ U₁ :=
          CategoryTheory.MorphismProperty.Over.homMk
            (Y.left.homOfLE inf_le_left)
            (AlgebraicGeometry.Scheme.homOfLE_ι Y.left inf_le_left)
            trivial
        let shAdj_Y := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
        let u₁_Fℤ : ∀ V : Y.left.Etale, ↥(Fℤ_Y.obj.obj (Opposite.op V)) := fun V =>
          ((shAdj_Y.unit.app ((CategoryTheory.Functor.const (Opposite Y.left.Etale)).obj Aℤ)).app
            (Opposite.op V)).hom (ULift.up (1 : ℤ))
        ∀ (f_sec : ↑(Y.left.presheaf.obj (Opposite.op O₁)))
          (u_O : Units ↑(Y.left.presheaf.obj (Opposite.op O₁₂))),
          (Y.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : O₁₂ ≤ O₁)).op).hom f_sec =
            (u_O : ↑(Y.left.presheaf.obj (Opposite.op O₁₂))) →
          Ideal.span {(Y.left.presheaf.germ O₁ y hy_mem).hom f_sec} =
            IsLocalRing.maximalIdeal ↑(Y.left.presheaf.stalk y) →
          let u_Y_sh : ↥((weilEtaleGmSheaf Y.left).obj.obj (Opposite.op U₁₂)) :=
            ((shAdj_Y.unit.app (weilEtaleGmPresheaf Y.left)).app (Opposite.op U₁₂)).hom
              (Additive.ofMul (Units.map O₁₂.topIso.inv.hom.toMonoidHom u_O))
          ∃ (s₁ : ↥((weilEtaleKSheaf Y.left).obj.obj (Opposite.op U₁)))
            (f_q : Quiver.Hom Fℤ_Y Q_div),
            ((weilEtaleKSheaf Y.left).obj.map (Opposite.op j₁₂_₁)).hom s₁ =
              (ι_gm.hom.app (Opposite.op U₁₂)).hom u_Y_sh ∧
            (f_q.hom.app (Opposite.op U₁)).hom (u₁_Fℤ U₁) =
              (π_div.hom.app (Opposite.op U₁)).hom s₁ ∧
            (f_q.hom.app (Opposite.op U₂)).hom (u₁_Fℤ U₂) = 0 ∧
            div_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q) = Finsupp.single ⟨y, hy⟩ (1 : ℤ)) :=
by
  classical
  
  have hAbstEtaleInj : ∀ (X_sch : AlgebraicGeometry.Scheme.{u})
      (G_pre K_pre : CategoryTheory.Functor (Opposite X_sch.Etale) AddCommGrpCat.{u})
      (hG_sh : CategoryTheory.Presheaf.IsSheaf X_sch.smallEtaleTopology G_pre)
      (hK_sh : CategoryTheory.Presheaf.IsSheaf X_sch.smallEtaleTopology K_pre)
      (Div_sh : CategoryTheory.Sheaf X_sch.smallEtaleTopology AddCommGrpCat.{u})
      (valDiv : ∀ U : X_sch.Etale,
        ↥(Div_sh.obj.obj (Opposite.op U)) →+
          ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_sch) } → ℤ))
      (hValInj : ∀ U : X_sch.Etale, Function.Injective (valDiv U))
      (ι_pre : G_pre ⟶ K_pre)
      (val_pre : K_pre ⟶ Div_sh.obj)
      (_hι_val_zero : ι_pre ≫ val_pre = 0)
      (_hInj_ι : ∀ U : X_sch.Etale, Function.Injective (ι_pre.app (Opposite.op U)).hom)
      (_hChart_ex : ∀ (U : X_sch.Etale) (s : ↥(K_pre.obj (Opposite.op U))),
        (val_pre.app (Opposite.op U)).hom s = 0 →
        ∀ u₀ : ↥U.left,
          ∃ (V₀ : U.left.Opens) (_ : u₀ ∈ V₀),
            let W_V₀ : X_sch.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (V₀.ι ≫ U.hom)
              (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
            let j_V₀ : W_V₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk V₀.ι rfl trivial
            (K_pre.map j_V₀.op).hom s ∈ Set.range (ι_pre.app (Opposite.op W_V₀)).hom)
      (T_X : X_sch.Etale) (_hT_X : CategoryTheory.Limits.IsTerminal T_X),
      let J_X := X_sch.smallEtaleTopology
      let sh := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
      let shAdj := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
      let ι_gm : sh.obj G_pre ⟶ sh.obj K_pre := sh.map ι_pre
      let Q_div := CategoryTheory.Limits.cokernel ι_gm
      let val_sh : sh.obj K_pre ⟶ Div_sh := (shAdj.homEquiv K_pre Div_sh).symm val_pre
      ∃ (h0_val_sh : ι_gm ≫ val_sh = 0),
        let val_bar : Q_div ⟶ Div_sh := CategoryTheory.Limits.cokernel.desc ι_gm val_sh h0_val_sh
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        let Pℤ := (CategoryTheory.Functor.const (Opposite X_sch.Etale)).obj Aℤ
        let u₁_X := fun (V : X_sch.Etale) =>
          ((shAdj.unit.app Pℤ).app (Opposite.op V)).hom (ULift.up (1 : ℤ))
        CategoryTheory.Mono val_bar ∧
        ∀ q : Q_div.H 0,
          valDiv T_X ((val_bar.hom.app (Opposite.op T_X)).hom
            (((CategoryTheory.Abelian.Ext.addEquiv₀ q).hom.app (Opposite.op T_X)).hom
              (u₁_X T_X))) = 0 →
          q = 0 := by
    intro X_sch G_pre K_pre hG_sh hK_sh Div_sh valDiv hValInj
      ι_pre val_pre hι_val_zero hInj_ι hChart_ex T_X hT_X
