    obtain ⟨V₀, hAffV₀, hu₀_V₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top u₀)
    obtain ⟨s₀, hs₀_tr, -⟩ := h_aff_dim V₀ hAffV₀ ⟨⟨u₀, hu₀_V₀⟩⟩
    have h_aff_eq : ∀ (V : Z.left.Opens),
