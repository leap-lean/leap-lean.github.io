        refine ⟨(e_A₁.symm x, ⟨Polynomial.X ^ n, n, rfl⟩), ?_⟩
        rw [h_alg_apply, h_alg_apply, map_pow, he_A₁_X, e_A₁.apply_symm_apply]
        exact hzx
      · intro p₁ p₂ hp
