      exact (eval_post X U₁₂ τ₁ ι₀).trans
        ((congrArg ((ι₀.hom.app (Opposite.op U₁₂)).hom) ((evalEq X U₁₂ F).apply_symm_apply s)).trans
          (hs₁.symm.trans
            ((congrArg ((K.obj.map j₁₂_₁.op).hom) ((evalEq X U₁ K).apply_symm_apply s₁)).symm.trans
