        (@Algebra.IsIntegral.isField_iff_isField K (↑R ⧸ q₁.asIdeal) _ _ _ _ _
          (RingHom.injective (algebraMap K (↑R ⧸ q₁.asIdeal)))).mp (Field.toIsField K)
      have hMax : q₁.asIdeal.IsMaximal :=
        (Ideal.Quotient.maximal_ideal_iff_isField_quotient q₁.asIdeal).mpr hIsField
      exact PrimeSpectrum.ext (hMax.eq_of_le q₂.isPrime.ne_top hle)
