      rwa [Nat.zero_add] at hSm01
    let e_Spec : R_mv ≃+* ↑(A₁.presheaf.obj (Opposite.op ⊤)) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_mv)).symm.commRingCatIsoToRingEquiv
    let e_A₁ : Polynomial k ≃+* ↑(A₁.presheaf.obj (Opposite.op ⊤)) :=
      α_alg.symm.toRingEquiv.trans e_Spec
    have he_A₁_X : e_A₁ Polynomial.X = X₀_sec := by
      change e_Spec (α_alg.symm Polynomial.X) = X₀_sec
      rw [hα_symm_X]
