      intro hmem
      exact hπf ((Ideal.Quotient.eq_zero_iff_mem).mpr hmem)
    let p_max : PrimeSpectrum A := ⟨𝔪, h𝔪_max.isPrime⟩
    let W' : Y.left.Opens := Y.left.basicOpen f
    let hle : W' ≤ W := Y.left.basicOpen_le f
    have hW' : AlgebraicGeometry.IsAffineOpen W' := hW.basicOpen f
    have hNe' : Nonempty ↥W' := by
      have hp_mem : p_max ∈ PrimeSpectrum.basicOpen f := hf_not_m
      rw [← hW.fromSpec_preimage_basicOpen f] at hp_mem
      exact ⟨⟨hW.fromSpec.base p_max, hp_mem⟩⟩
    let R' := Y.left.presheaf.obj (Opposite.op W')
    let S : Type u := ↑R'
    let g_cat : R ⟶ R' := Y.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE hle))
    let g : A →+* S := g_cat.hom
    have hLoc_S : @IsLocalization.Away A _ f S _ g.toAlgebra := hW.isLocalization_basicOpen f
    let ψ_chain : Fin (N + 1) → (P_c →+* S) :=
      fun m => MvPolynomial.eval₂Hom (g.comp f_k) (fun j => g (x m j))
    let ψ_chain_cat : Fin (N + 1) → (CommRingCat.of P_c ⟶ R') :=
      fun m => CommRingCat.ofHom (ψ_chain m)
    let w : Fin (N + 1) → Quiver.Hom W'.toScheme (weilGysinAffineSpace k c) :=
      fun m => hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (ψ_chain_cat m)
    
    have hEt_chain : ∀ m : Fin (N + 1), (ψ_chain m).Etale := by
      intro m
      letI : Algebra A S := g.toAlgebra
      have : IsLocalization.Away f S := hLoc_S
      letI : Algebra k S := (g.comp f_k).toAlgebra
      have : IsScalarTower k A S := IsScalarTower.of_algebraMap_eq' rfl
      have hFP_kA : Algebra.FiniteType k A := by
        letI : Algebra P_c A := φ₁.toAlgebra
        have : IsScalarTower k P_c A := IsScalarTower.of_algebraMap_eq' hφ₁_k.symm
        have : Algebra.Etale P_c A := RingHom.etale_algebraMap.mp hφ₁_et
        have : Algebra.FinitePresentation P_c A := inferInstance
        have : Algebra.FiniteType P_c A := inferInstance
        exact Algebra.FiniteType.trans (R := k) (S := P_c) (A := A) inferInstance inferInstance
      have hSm_kA : Algebra.FormallySmooth k A := by
        letI : Algebra P_c A := φ₁.toAlgebra
        have : IsScalarTower k P_c A := IsScalarTower.of_algebraMap_eq' hφ₁_k.symm
        have : Algebra.Etale P_c A := RingHom.etale_algebraMap.mp hφ₁_et
        exact Algebra.FormallySmooth.comp k P_c A
      have : Algebra.FiniteType k A := hFP_kA
      have : Algebra.FormallySmooth k A := hSm_kA
      have : Algebra.FinitePresentation A S := IsLocalization.Away.finitePresentation f
      have : Algebra.FiniteType A S := inferInstance
      have : Algebra.FiniteType k S :=
        Algebra.FiniteType.trans (R := k) (S := A) (A := S) inferInstance inferInstance
      have : Algebra.FinitePresentation k S := Algebra.FinitePresentation.of_finiteType.mp inferInstance
      have : Algebra.FormallyEtale A S :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.powers f)
      have : Algebra.FormallySmooth A S :=
        Algebra.FormallySmooth.of_isLocalization (Submonoid.powers f)
      have : Algebra.FormallySmooth k S := Algebra.FormallySmooth.comp k A S
      have : Subsingleton (Algebra.H1Cotangent k S) :=
        Algebra.FormallySmooth.subsingleton_h1Cotangent
      let e_AS : TensorProduct A S Ω[A⁄k] ≃ₗ[S] Ω[S⁄k] :=
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k A S
      let b₁_S : Module.Basis (Fin c) S Ω[S⁄k] :=
        (Algebra.TensorProduct.basis S b₁).map e_AS
      letI : Algebra P_c S := (ψ_chain m).toAlgebra
      have hψ_C : (ψ_chain m).comp MvPolynomial.C = g.comp f_k := by
        apply RingHom.ext
        intro r
        dsimp [ψ_chain]
        rw [MvPolynomial.eval₂Hom_C]
        rfl
      have : IsScalarTower k P_c S := IsScalarTower.of_algebraMap_eq' hψ_C.symm
      have : Algebra.FinitePresentation P_c S :=
        Algebra.FinitePresentation.of_restrict_scalars_finitePresentation k P_c S
      let b_PS : Module.Basis (Fin c) S (TensorProduct P_c S Ω[P_c⁄k]) :=
        Algebra.TensorProduct.basis S (KaehlerDifferential.mvPolynomialBasis k (Fin c))
      let L_bc : TensorProduct P_c S Ω[P_c⁄k] →ₗ[S] Ω[S⁄k] :=
        KaehlerDifferential.mapBaseChange k P_c S
      have hMat_L : LinearMap.toMatrix b_PS b₁_S L_bc = (J (x m)).map g := by
        ext i j
        rw [LinearMap.toMatrix_apply, Matrix.map_apply]
        have hLb : L_bc (b_PS j) = KaehlerDifferential.D k S (g (x m j)) := by
          rw [Algebra.TensorProduct.basis_apply, KaehlerDifferential.mvPolynomialBasis_apply,
            KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
          change KaehlerDifferential.D k S ((ψ_chain m) (MvPolynomial.X j)) = _
          dsimp [ψ_chain]
          rw [MvPolynomial.eval₂Hom_X']
        have hD_exp : KaehlerDifferential.D k S (g (x m j)) =
            ∑ l : Fin c, g (J (x m) l j) • b₁_S l := by
          have hA_exp : KaehlerDifferential.D k A (x m j) =
              ∑ l : Fin c, J (x m) l j • b₁ l :=
            (b₁.sum_repr (KaehlerDifferential.D k A (x m j))).symm
          have he_D : e_AS (1 ⊗ₜ[A] KaehlerDifferential.D k A (x m j)) =
              KaehlerDifferential.D k S (g (x m j)) := by
            rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
              KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
            rfl
          rw [← he_D, hA_exp, TensorProduct.tmul_sum, map_sum]
          apply Finset.sum_congr rfl
          intro l _
          have htmul : (1 : S) ⊗ₜ[A] (J (x m) l j • b₁ l) =
              g (J (x m) l j) • ((1 : S) ⊗ₜ[A] b₁ l) := by
            rw [TensorProduct.tmul_smul]
            exact (IsScalarTower.algebraMap_smul S (J (x m) l j)
              ((1 : S) ⊗ₜ[A] b₁ l)).symm
          rw [htmul, map_smul]
          dsimp [b₁_S]
          rw [Algebra.TensorProduct.basis_apply]
        rw [hLb, hD_exp, map_sum, Finsupp.finsetSum_apply, Finset.sum_eq_single i]
        · simp [b₁_S.repr_self]
        · intro l _ hl
          simp [b₁_S.repr_self, Ne.symm hl]
        · intro hi; exact absurd (Finset.mem_univ i) hi
      have hUnit_f : IsUnit (g f) :=
        IsLocalization.map_units S ⟨f, Submonoid.mem_powers f⟩
      have hdvd_f : (J (x m)).det ∣ f :=
        Finset.dvd_prod_of_mem _ (Finset.mem_univ m)
      have hUnit_det : IsUnit (((J (x m)).map g).det) := by
        change IsUnit (g.mapMatrix (J (x m))).det
        rw [← RingHom.map_det g (J (x m))]
        exact isUnit_of_dvd_unit (map_dvd g hdvd_f) hUnit_f
      rcases (Matrix.isUnit_iff_isUnit_det ((J (x m)).map g)).mpr hUnit_det with
        ⟨M_inv_u, hM_inv_u⟩
      let L_inv : Ω[S⁄k] →ₗ[S] TensorProduct P_c S Ω[P_c⁄k] :=
        Matrix.toLin b₁_S b_PS (↑M_inv_u⁻¹ : Matrix (Fin c) (Fin c) S)
      have hL_left : L_inv.comp L_bc = LinearMap.id := by
        apply (LinearMap.toMatrix b_PS b_PS).injective
        rw [LinearMap.toMatrix_comp b_PS b₁_S b_PS, LinearMap.toMatrix_toLin, hMat_L,
          ← hM_inv_u, Units.inv_mul, LinearMap.toMatrix_id]
      have hL_right : L_bc.comp L_inv = LinearMap.id := by
        apply (LinearMap.toMatrix b₁_S b₁_S).injective
        rw [LinearMap.toMatrix_comp b₁_S b_PS b₁_S, LinearMap.toMatrix_toLin, hMat_L,
          ← hM_inv_u, Units.mul_inv, LinearMap.toMatrix_id]
      have hL_surj : Function.Surjective L_bc :=
        Function.HasRightInverse.surjective ⟨L_inv, fun v => LinearMap.congr_fun hL_right v⟩
      have hL_inj : Function.Injective L_bc :=
        Function.HasLeftInverse.injective ⟨L_inv, fun v => LinearMap.congr_fun hL_left v⟩
      have : Subsingleton Ω[S⁄P_c] := by
        refine subsingleton_of_forall_eq 0 fun ω => ?_
        obtain ⟨ω₀, rfl⟩ := KaehlerDifferential.map_surjective k P_c S ω
        exact ((KaehlerDifferential.exact_mapBaseChange_map k P_c S) ω₀).mpr
          (hL_surj ω₀)
      have : Subsingleton (Algebra.H1Cotangent P_c S) := by
        refine subsingleton_of_forall_eq 0 fun η => ?_
        have hδ0 : Algebra.H1Cotangent.δ k P_c S η = 0 := by
          apply hL_inj
          rw [map_zero]
          exact ((Algebra.H1Cotangent.exact_δ_mapBaseChange k P_c S) _).mpr ⟨η, rfl⟩
        obtain ⟨ζ, rfl⟩ := ((Algebra.H1Cotangent.exact_map_δ k P_c S) η).mp hδ0
        rw [Subsingleton.elim ζ 0, map_zero]
      have : Algebra.FormallyEtale P_c S :=
        (Algebra.formallyEtale_iff P_c S).mpr ⟨inferInstance, inferInstance⟩
      have : Algebra.Etale P_c S := {}
      exact RingHom.etale_algebraMap.mpr inferInstance
    have hSpec_res : AlgebraicGeometry.Spec.map g_cat ≫ hW.fromSpec = hW'.fromSpec :=
      hW.map_fromSpec hW' (Opposite.op (CategoryTheory.homOfLE hle))
    have hw_endpoint : ∀ (m : Fin (N + 1)) (u : Quiver.Hom W.toScheme (weilGysinAffineSpace k c))
        (φ : P_c →+* A),
        hW.isoSpec.inv ≫ u = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) →
        φ.comp MvPolynomial.C = f_k →
        x m = (fun j => φ (MvPolynomial.X j)) →
        w m = Y.left.homOfLE hle ≫ u := by
      intro m u φ hu_sp hφ_C hxm
      let φ_hom : CommRingCat.of P_c ⟶ R := CommRingCat.ofHom φ
      have hψ_eq : ψ_chain_cat m = φ_hom ≫ g_cat := by
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro c₀
          change (ψ_chain m) (MvPolynomial.C c₀) = g (φ (MvPolynomial.C c₀))
          dsimp [ψ_chain]
          rw [MvPolynomial.eval₂Hom_C, ← hφ_C]
          rfl
        · intro j
          change (ψ_chain m) (MvPolynomial.X j) = g (φ (MvPolynomial.X j))
          dsimp [ψ_chain]
          rw [MvPolynomial.eval₂Hom_X', hxm]
      have hcancel_W : hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ hW.isoSpec.inv =
          Y.left.homOfLE hle := by
        rw [← CategoryTheory.cancel_mono W.ι, Category.assoc, Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι]
        change hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ hW.fromSpec = W'.ι
        rw [hSpec_res]
        exact hW'.isoSpec.hom_inv_id_assoc W'.ι
      have h1 : w m = hW'.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map g_cat ≫ AlgebraicGeometry.Spec.map φ_hom := by
        dsimp [w]
        rw [hψ_eq, AlgebraicGeometry.Spec.map_comp]
        rfl
      have h2 : hW'.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map g_cat ≫ AlgebraicGeometry.Spec.map φ_hom =
          hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ (hW.isoSpec.inv ≫ u) :=
        congrArg (fun k_hom => hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ k_hom)
          hu_sp.symm
      have h3 : hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ (hW.isoSpec.inv ≫ u) =
          Y.left.homOfLE hle ≫ u := by
        calc
          hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ (hW.isoSpec.inv ≫ u) =
              (hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ hW.isoSpec.inv) ≫ u := by
            simp only [Category.assoc]
          _ = Y.left.homOfLE hle ≫ u := by rw [hcancel_W]
      exact h1.trans (h2.trans h3)
    refine ⟨W', hle, N, w, hW', hNe',
      hw_endpoint 0 u₁ φ₁ hu₁_spec hφ₁_k hx0,
      hw_endpoint (Fin.last N) u₂ φ₂ hu₂_spec hφ₂_k hxN, ?_, ?_⟩
    · intro m
      have het_m : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (ψ_chain_cat m)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.Etale)).mpr (hEt_chain m)
      refine ⟨hEt_comp hW'.isoSpec.hom (AlgebraicGeometry.Spec.map (ψ_chain_cat m))
        inferInstance het_m, ?_⟩
      dsimp [w, weilGysinAffineStruct, weilGysinAffineSpace, P_c]
      rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hψ_base : CommRingCat.ofHom (MvPolynomial.C : k →+* P_c) ≫
          ψ_chain_cat m = φ_k_cat ≫ g_cat := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c₀
        change (ψ_chain m) (MvPolynomial.C c₀) = g (f_k c₀)
        dsimp [ψ_chain]
        rw [MvPolynomial.eval₂Hom_C]
        rfl
      rw [hψ_base, AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Spec.map_preimage]
      calc
        hW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ hW.isoSpec.inv ≫ W.ι ≫ Y.hom =
          hW'.isoSpec.hom ≫ (AlgebraicGeometry.Spec.map g_cat ≫ hW.fromSpec) ≫ Y.hom := by
          rfl
        _ = hW'.isoSpec.hom ≫ hW'.fromSpec ≫ Y.hom := by rw [hSpec_res]
        _ = W'.ι ≫ Y.hom := by
          change hW'.isoSpec.hom ≫ (hW'.isoSpec.inv ≫ W'.ι) ≫ Y.hom = _
          rw [← Category.assoc, hW'.isoSpec.hom_inv_id_assoc]
    · intro m
      obtain ⟨i₀, hi₀⟩ := hx_step m
      refine ⟨i₀, fun j hj => ?_⟩
      dsimp [w, weilGysinAffineSpace, P_c]
      rw [Category.assoc, Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      apply CommRingCat.hom_ext
      apply Polynomial.ringHom_ext'
      · ext c₀
        simp [ψ_chain_cat, ψ_chain]
      · simp [ψ_chain_cat, ψ_chain, hi₀ j hj]

theorem weil_gysin_torsion_pullback_and_cup_transition (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (r m : ℕ)
      (p_succ : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) m →+ weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) m)
      (p_curr : weilEtaleTorsionH W₂ (ℓ ^ r) m →+ weilEtaleTorsionH W₁ (ℓ ^ r) m),
      WeilLefschetzTorsionPullback h (ℓ ^ (r + 1)) m p_succ →
      WeilLefschetzTorsionPullback h (ℓ ^ r) m p_curr →
      ∀ x : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) m,
        weilEtaleTorsionTransition W₁ ℓ r m (p_succ x) =
          p_curr (weilEtaleTorsionTransition W₂ ℓ r m x)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (r a b c : ℕ) (hab : a + b = c)
      (c_succ : weilEtaleTorsionH W (ℓ ^ (r + 1)) a →+
        weilEtaleTorsionH W (ℓ ^ (r + 1)) b →+ weilEtaleTorsionH W (ℓ ^ (r + 1)) c)
      (c_curr : weilEtaleTorsionH W (ℓ ^ r) a →+
        weilEtaleTorsionH W (ℓ ^ r) b →+ weilEtaleTorsionH W (ℓ ^ r) c),
      WeilLefschetzIsTorsionCup W (ℓ ^ (r + 1)) a b c hab c_succ →
      WeilLefschetzIsTorsionCup W (ℓ ^ r) a b c hab c_curr →
      ∀ (x : weilEtaleTorsionH W (ℓ ^ (r + 1)) a)
        (y : weilEtaleTorsionH W (ℓ ^ (r + 1)) b),
        weilEtaleTorsionTransition W ℓ r c (c_succ x y) =
          c_curr (weilEtaleTorsionTransition W ℓ r a x)
            (weilEtaleTorsionTransition W ℓ r b y)) :=
by
  
  have inv_uniq : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] {X Y : C}
      (p : X ⟶ Y) (q₁ q₂ : Y ⟶ X),
      q₁ ≫ p = 𝟙 Y → p ≫ q₂ = 𝟙 X → q₁ = q₂ := by
    intro C _ X Y p q₁ q₂ hq₁ hq₂
    calc
      q₁ = q₁ ≫ 𝟙 X := (Category.comp_id q₁).symm
      _ = q₁ ≫ (p ≫ q₂) := by rw [hq₂]
      _ = (q₁ ≫ p) ≫ q₂ := (Category.assoc q₁ p q₂).symm
      _ = 𝟙 Y ≫ q₂ := by rw [hq₁]
      _ = q₂ := Category.id_comp q₂

  have eq_eqToHom_of_heq : ∀ {C : Type (u + 1)} [Category.{u, u + 1} C] {A₁ A₂ B₁ B₂ : C}
      (hA : A₁ = A₂) (hB : B₁ = B₂) {f : A₁ ⟶ B₁} {g : A₂ ⟶ B₂},
      HEq f g → f = eqToHom hA ≫ g ≫ eqToHom hB.symm := by
    rintro C _ A₁ _ B₁ _ rfl rfl f g ⟨⟩
    simp

  have ext_conj_eq : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C]
      {X₁ X₂ X₃ Z₁ Z₂ Z₃ : C} (a : X₁ ⟶ X₂) (a' : X₂ ⟶ X₃) (b' : Z₁ ⟶ Z₂) (b : Z₂ ⟶ Z₃)
      (i : ℕ) (y : Abelian.Ext.{u} X₃ Z₁ i),
      ((Abelian.Ext.mk₀ a).comp
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (Nat.add_zero i)) (Nat.zero_add i))
        (Nat.zero_add i)).comp (Abelian.Ext.mk₀ b) (Nat.add_zero i) =
      (Abelian.Ext.mk₀ (a ≫ a')).comp
        (y.comp (Abelian.Ext.mk₀ (b' ≫ b)) (Nat.add_zero i)) (Nat.zero_add i) := by
    intro C _ _ _ X₁ X₂ X₃ Z₁ Z₂ Z₃ a a' b' b i y
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ a) (Abelian.Ext.mk₀ a') _
        (Nat.zero_add i),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (a ≫ a')) _ (Abelian.Ext.mk₀ b)
        (Nat.zero_add i) (Nat.add_zero i) (Nat.zero_add i),
      Abelian.Ext.comp_assoc_of_third_deg_zero y (Abelian.Ext.mk₀ b') (Abelian.Ext.mk₀ b)
        (Nat.add_zero i),
      Abelian.Ext.mk₀_comp_mk₀]

  have hExtIso : ∀ {C D : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C]
      [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      (F G : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (σ : F ≅ G) (X Y : C) (i : ℕ) (x : Abelian.Ext.{u} X Y i),
      (G.mapExtAddHom X Y i) x =
        (Abelian.Ext.mk₀ (σ.inv.app X)).comp
          (((F.mapExtAddHom X Y i) x).comp (Abelian.Ext.mk₀ (σ.hom.app Y)) (Nat.add_zero i))
          (Nat.zero_add i) := by
    intro C D _ _ _ _ _ _ _ F G _ _ _ _ _ _ σ X Y i x
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
    induction i generalizing Y with
    | zero =>
      let f : X ⟶ Y := Abelian.Ext.addEquiv₀ x
      have hf : Abelian.Ext.mk₀ f = x := Abelian.Ext.addEquiv₀.left_inv x
      rw [← hf, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [σ.hom.naturality f, σ.inv_hom_id_app_assoc]
    | succ k ih =>
      let ι : Y ⟶ Injective.under Y := Injective.ι Y
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        { exact := ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
        ih S.X₃ z]
      let φ : S.map F ⟶ S.map G :=
        { τ₁ := σ.hom.app S.X₁
          τ₂ := σ.hom.app S.X₂
          τ₃ := σ.hom.app S.X₃
          comm₁₂ := (σ.hom.naturality S.f).symm
          comm₂₃ := (σ.hom.naturality S.g).symm }
      have hnat := ShortComplex.ShortExact.extClass_naturality (hS.map_of_exact F) (hS.map_of_exact G) φ
      dsimp [φ, S] at hnat
      rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (σ.inv.app X)) _ _
          (Nat.zero_add k) rfl (Nat.zero_add (k + 1)),
        Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ (σ.hom.app S.X₃)) _
          (Nat.add_zero k) (Nat.zero_add 1) rfl,
        ← hnat,
        ← Abelian.Ext.comp_assoc _ (hS.map_of_exact F).extClass (Abelian.Ext.mk₀ (σ.hom.app Y))
