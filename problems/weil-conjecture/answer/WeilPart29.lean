            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
              ((CategoryTheory.Functor.const (Opposite S.Etale)).obj A_n)).app (Opposite.op T))
            (Φ.hom.hom.app (Opposite.op T)) =
            weilAltLocConstConstHom S T n := by
    intro S
    let J_S := S.smallEtaleTopology
    have hShL_type : CategoryTheory.Presieve.IsSheaf J_S
        ((weilAltLocConstPresheaf S n).comp (CategoryTheory.forget AddCommGrpCat.{u})) := by
      intro U R hR s_fam hs_compat
      have hR_mem := (hMemEtale R).mp hR
      choose Y_x f_x y_x hf_in using hR_mem
      have hf_R : ∀ x : ↥U.left, R.arrows (f_x x) := fun x => (hf_in x).1
      have hfy : ∀ x : ↥U.left, (f_x x).left (y_x x) = x := fun x => (hf_in x).2.2
      let evalFam : ∀ {Y : S.Etale} (f : Y ⟶ U), R.arrows f →
