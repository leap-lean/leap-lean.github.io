    let p_U := CategoryTheory.Limits.pullback.fst u_P g_x
    let u_Px := CategoryTheory.Limits.pullback.snd u_P g_x
    let q_U := CategoryTheory.Limits.pullback.fst j_W g'_0
    let q_W := CategoryTheory.Limits.pullback.snd j_W g'_0
    have hcond1 : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp p_U j_W) π =
        CategoryTheory.CategoryStruct.comp u_Px g_x := by
      rw [CategoryTheory.Category.assoc, hjπ, CategoryTheory.Limits.pullback.condition]
    let j'_x : Quiver.Hom (CategoryTheory.Limits.pullback u_P g_x) W_x :=
      hpb.lift (CategoryTheory.CategoryStruct.comp p_U j_W) u_Px hcond1
    have hj'_g' : CategoryTheory.CategoryStruct.comp j'_x g'_0 =
        CategoryTheory.CategoryStruct.comp p_U j_W :=
      hpb.lift_fst _ _ _
    have hj'_f' : CategoryTheory.CategoryStruct.comp j'_x f'_0 = u_Px :=
      hpb.lift_snd _ _ _
    let φ_hom : Quiver.Hom (CategoryTheory.Limits.pullback u_P g_x)
        (CategoryTheory.Limits.pullback j_W g'_0) :=
      CategoryTheory.Limits.pullback.lift p_U j'_x hj'_g'.symm
    have hcond2 : CategoryTheory.CategoryStruct.comp q_U u_P =
        CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp q_W f'_0) g_x := by
      rw [← hjπ, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, hpb.w, CategoryTheory.Category.assoc]
    let φ_inv : Quiver.Hom (CategoryTheory.Limits.pullback j_W g'_0)
        (CategoryTheory.Limits.pullback u_P g_x) :=
      CategoryTheory.Limits.pullback.lift q_U (CategoryTheory.CategoryStruct.comp q_W f'_0) hcond2
    let e : CategoryTheory.Iso
        (CategoryTheory.Limits.pullback u_P g_x)
        (CategoryTheory.Limits.pullback j_W g'_0) :=
      { hom := φ_hom
        inv := φ_inv
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · dsimp only [φ_hom, φ_inv, p_U, q_U]
            rw [CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.id_comp]
          · dsimp only [φ_hom, φ_inv, u_Px, q_W]
            rw [CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd,
              hj'_f', CategoryTheory.Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · dsimp only [φ_hom, φ_inv, p_U, q_U]
            rw [CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.id_comp]
          · dsimp only [φ_hom, q_W]
            rw [CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.id_comp]
            apply hpb.hom_ext
            · rw [CategoryTheory.Category.assoc, hj'_g', ← CategoryTheory.Category.assoc]
              dsimp only [φ_inv, p_U]
              rw [CategoryTheory.Limits.pullback.lift_fst]
              exact CategoryTheory.Limits.pullback.condition
            · rw [CategoryTheory.Category.assoc, hj'_f']
              dsimp only [φ_inv, u_Px]
              exact CategoryTheory.Limits.pullback.lift_snd _ _ _ }
    have hφ_fst : CategoryTheory.CategoryStruct.comp e.hom q_U = p_U :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hφ_snd : CategoryTheory.CategoryStruct.comp e.hom q_W = j'_x :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have : CategoryTheory.IsIso e.hom := e.isIso_hom
    have hj'_open : AlgebraicGeometry.IsOpenImmersion j'_x := by
      rw [← hφ_snd]
      infer_instance
    exact ⟨e, j'_x, hj'_open, hφ_fst, hφ_snd, hj'_f'⟩
  refine ⟨?_, ?_⟩
  · intro E y
    have : AlgebraicGeometry.Etale E.hom := E.prop
    obtain ⟨V₀, hV₀, hy, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (by trivial : y ∈ (⊤ : E.left.Opens))
    have : AlgebraicGeometry.IsAffine V₀.toScheme := hV₀
    obtain ⟨d, τ_V, hτV_sec, hτV_univ, -⟩ :=
      h_aff_part V₀.toScheme (CategoryTheory.CategoryStruct.comp V₀.ι E.hom)
    obtain ⟨i, pt, hpt⟩ :=
      Set.mem_iUnion.mp (hτV_univ.symm ▸ Set.mem_univ (⟨y, hy⟩ : ↥V₀.toScheme))
    refine ⟨CategoryTheory.CategoryStruct.comp (τ_V i) V₀.ι, ?_, pt, ?_⟩
    · rw [CategoryTheory.Category.assoc, hτV_sec i]
    · exact congrArg V₀.ι.base hpt
  · intro W₀ P₀ U W_x π g_x f'_0 _ g'_0 hpb j_W _ u_P hu_P hjπ _
    have : AlgebraicGeometry.Etale u_P := hu_P
    let u_Px := CategoryTheory.Limits.pullback.snd u_P g_x
    obtain ⟨d_x, τ, hτ_sec, hτ_univ, hτ_disj⟩ :=
      h_aff_part (CategoryTheory.Limits.pullback u_P g_x) u_Px
    have hτ_open : ∀ i : Fin d_x, AlgebraicGeometry.IsOpenImmersion (τ i) :=
      fun i => (h_sec_clopen u_Px (τ i) (hτ_sec i)).1 inferInstance
    obtain ⟨e_Ux, j'_x, hj'_open, he_fst, he_snd, hj'_f'⟩ :=
      h_cart_iso π g_x f'_0 g'_0 hpb j_W u_P hjπ
    have : AlgebraicGeometry.IsOpenImmersion j'_x := hj'_open
    have : CategoryTheory.IsIso e_Ux.hom := e_Ux.isIso_hom
    let σ_x : Fin d_x → Quiver.Hom S_Ω W_x :=
      fun i => CategoryTheory.CategoryStruct.comp (τ i) j'_x
    have hσ_open : ∀ i : Fin d_x, AlgebraicGeometry.IsOpenImmersion (σ_x i) := by
      intro i
      have : AlgebraicGeometry.IsOpenImmersion (τ i) := hτ_open i
      dsimp only [σ_x]
      infer_instance
    have hσ_et : ∀ i : Fin d_x, AlgebraicGeometry.Etale (σ_x i) := by
      intro i
      have : AlgebraicGeometry.IsOpenImmersion (σ_x i) := hσ_open i
      infer_instance
    have hσ_sec : ∀ i : Fin d_x,
        CategoryTheory.CategoryStruct.comp (σ_x i) f'_0 =
          CategoryTheory.CategoryStruct.id S_Ω := by
      intro i
      dsimp only [σ_x]
      rw [CategoryTheory.Category.assoc, hj'_f', hτ_sec i]
    have hσ_closed : ∀ i : Fin d_x, AlgebraicGeometry.IsClosedImmersion (σ_x i) :=
      fun i => (h_sec_clopen f'_0 (σ_x i) (hσ_sec i)).2 inferInstance
    let m : Fin d_x → Quiver.Hom S_Ω (CategoryTheory.Limits.pullback j_W g'_0) :=
      fun i => CategoryTheory.CategoryStruct.comp (τ i) e_Ux.hom
    have hm_snd : ∀ i : Fin d_x,
        CategoryTheory.CategoryStruct.comp (m i)
          (CategoryTheory.Limits.pullback.snd j_W g'_0) = σ_x i := by
      intro i
      dsimp only [m, σ_x]
      rw [CategoryTheory.Category.assoc, he_snd]
    let ι_W : ∀ i : Fin d_x,
        Quiver.Hom (weilGysinEtaleObj (σ_x i) (hσ_et i))
          ((weilAltCdSitePullback g'_0).obj (weilGysinEtaleObj j_W inferInstance)) :=
      fun i => CategoryTheory.MorphismProperty.Over.homMk (m i) (hm_snd i) trivial
    refine ⟨d_x, τ, σ_x, hσ_open, hσ_closed, hσ_et, ι_W,
      hτ_sec, hτ_open, hτ_univ, hτ_disj, hσ_sec, ?_, ?_, ?_, ?_⟩
    · intro i
      change CategoryTheory.CategoryStruct.comp (m i)
          (CategoryTheory.Limits.pullback.fst j_W g'_0) =
        CategoryTheory.CategoryStruct.comp (τ i)
          (CategoryTheory.Limits.pullback.fst u_P g_x)
      dsimp only [m]
      rw [CategoryTheory.Category.assoc, he_fst]
    · intro i
      change AlgebraicGeometry.IsOpenImmersion (m i)
      have : AlgebraicGeometry.IsOpenImmersion (τ i) := hτ_open i
      dsimp only [m]
      infer_instance
    · change (⋃ i : Fin d_x, Set.range (m i).base) = Set.univ
      rw [Set.eq_univ_iff_forall]
      intro w
      rw [Set.mem_iUnion]
      obtain ⟨i, pt, hpt⟩ :=
        Set.mem_iUnion.mp (hτ_univ.symm ▸ Set.mem_univ (e_Ux.inv.base w))
      refine ⟨i, pt, ?_⟩
      change e_Ux.hom.base ((τ i).base pt) = w
      rw [hpt]
      change (CategoryTheory.CategoryStruct.comp e_Ux.inv e_Ux.hom).base w = w
      rw [e_Ux.inv_hom_id]
      rfl
    · intro i j hij
      change Disjoint (Set.range (m i).base) (Set.range (m j).base)
      rw [Set.disjoint_left]
      rintro z ⟨pt₁, rfl⟩ ⟨pt₂, hpt₂⟩
      have h_eq : (τ i).base pt₁ = (τ j).base pt₂ := by
        have h_ap := congrArg e_Ux.inv.base hpt₂
        change (CategoryTheory.CategoryStruct.comp e_Ux.hom e_Ux.inv).base ((τ j).base pt₂) =
          (CategoryTheory.CategoryStruct.comp e_Ux.hom e_Ux.inv).base ((τ i).base pt₁) at h_ap
        rw [e_Ux.hom_inv_id] at h_ap
        exact h_ap.symm
      exact Set.disjoint_left.mp (hτ_disj i j hij) ⟨pt₁, rfl⟩ ⟨pt₂, h_eq.symm⟩

theorem weil_gysin_clopen_spec_section_acyclicity_and_eval (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m : ℕ) :
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_Ω) inferInstance
    CategoryTheory.Projective
      ((CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) →
    (∀ (E : S_Ω.Etale) (y : ↥E.left),
      ∃ (s : Quiver.Hom S_Ω E.left),
        CategoryTheory.CategoryStruct.comp s E.hom = CategoryTheory.CategoryStruct.id S_Ω ∧
        ∃ pt : ↥S_Ω, s.base pt = y) →
    Function.Bijective
      ((CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.CategoryStruct.id (weilGysinLocalTorsionSheaf S_Ω m T_Ω))).hom) ∧
    ∀ (W_x : AlgebraicGeometry.Scheme.{u})
      (f'_0 : Quiver.Hom W_x S_Ω)
      (σ : Quiver.Hom S_Ω W_x)
      [AlgebraicGeometry.IsOpenImmersion σ]
      [AlgebraicGeometry.IsClosedImmersion σ]
      (hσ_et : AlgebraicGeometry.Etale σ)
      (hc_σ : (weilAltCdSitePullback σ).IsContinuous
        W_x.smallEtaleTopology S_Ω.smallEtaleTopology)
      (P_pull_σ : CategoryTheory.Functor
        (CategoryTheory.Sheaf W_x.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}))
      (_ : P_pull_σ ⊣ @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAltCdSitePullback σ) AddCommGrpCat.{u} _
        W_x.smallEtaleTopology S_Ω.smallEtaleTopology hc_σ)
      [(@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAltCdSitePullback σ) AddCommGrpCat.{u} _
        W_x.smallEtaleTopology S_Ω.smallEtaleTopology hc_σ).Additive],
      (∀ (I : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Injective I →
        CategoryTheory.Injective
          ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback σ) AddCommGrpCat.{u} _
            W_x.smallEtaleTopology S_Ω.smallEtaleTopology hc_σ).obj I)) →
      ∀ (e₀_σ : ∀ (N : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
          ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback σ) AddCommGrpCat.{u} _
            W_x.smallEtaleTopology S_Ω.smallEtaleTopology hc_σ).obj N).H 0 ≃+ N.H 0),
        (∀ {N₁ N₂ : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}}
            (φ : Quiver.Hom N₁ N₂)
            (z : ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
              (weilAltCdSitePullback σ) AddCommGrpCat.{u} _
              W_x.smallEtaleTopology S_Ω.smallEtaleTopology hc_σ).obj N₁).H 0),
          e₀_σ N₂ (z.comp (CategoryTheory.Abelian.Ext.mk₀
            ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
              (weilAltCdSitePullback σ) AddCommGrpCat.{u} _
              W_x.smallEtaleTopology S_Ω.smallEtaleTopology hc_σ).map φ)) (Nat.add_zero 0)) =
            (e₀_σ N₁ z).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) →
        let U_σ := weilGysinEtaleObj σ hσ_et
        let L_σ := weilGysinLocalTorsionSheaf W_x m U_σ
        let T_Wx := (weilAltCdSitePullback f'_0).obj T_Ω
        Function.Bijective
          ((CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_σ)).hom) ∧
        Nonempty (↥(L_σ.obj.obj (Opposite.op T_Wx)) ≃ ULift.{u} (ZMod m)) ∧
        ∀ (s : ℕ), 1 ≤ s → Subsingleton ↥((L_σ.cohomologyPresheaf s).obj (Opposite.op T_Wx)) :=
by
  classical
  intro S_Ω T_Ω hProj_Ω hPtSec
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let J_Ω := S_Ω.smallEtaleTopology
  let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let A_ℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_Ω := (CategoryTheory.constantSheaf J_Ω AddCommGrpCat.{u}).obj A_ℤ
  let C_m := weilEtaleTorsionSheaf S_Ω m
  let L_0 := weilGysinLocalTorsionSheaf S_Ω m T_Ω

  
  have hFreeComp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {U : S.Etale} {M : AddCommGrpCat.{u}}
      {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology U M ⟶ F) (g : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (f ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv f ≫ g.hom.app (Opposite.op U) :=
    fun f g =>
      (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
        ((CategoryTheory.sheafificationAdjunction _ AddCommGrpCat.{u}).homEquiv_naturality_right
          f g)).trans
        (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)

  have hMemEtale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {X : S.Etale}
      {R : CategoryTheory.Sieve X},
      R ∈ S.smallEtaleTopology X ↔
        ∀ x : ↥X.left, ∃ (Y : S.Etale) (f : Y ⟶ X) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S X R
    exact (Eq.to_iff (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J X)
      (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := S) le_rfl))).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := S) (X := X) (R := R))

  
  have hT_Ω : CategoryTheory.Limits.IsTerminal T_Ω :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
        (CategoryTheory.Category.comp_id E.hom) trivial)
      (fun _ w => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id w.left).symm.trans w.w))

  
  have hSub_TΩ : Subsingleton ↥T_Ω.left := (inferInstance : Subsingleton ↥S_Ω)
  have hEmpty_ext : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (Z : S.Etale), IsEmpty ↥Z.left →
      ∀ {M₀ : AddCommGrpCat.{u}} (f₁ f₂ : M₀ ⟶ F.obj.obj (Opposite.op Z)), f₁ = f₂ := by
    intro S F Z hEmp M₀ f₁ f₂
    have hBot : (⊥ : CategoryTheory.Sieve Z) ∈ S.smallEtaleTopology Z :=
      hMemEtale.mpr (fun x => hEmp.elim x)
    exact F.2.hom_ext ⟨⊥, hBot⟩ f₁ f₂ (fun I => False.elim I.hf)

  
  have hSecOpenImm_sch : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (g_E : Y ⟶ S_Ω)
      [AlgebraicGeometry.Etale g_E] (s_u : S_Ω ⟶ Y),
      s_u ≫ g_E = 𝟙 S_Ω → AlgebraicGeometry.IsOpenImmersion s_u := by
    intro Y g_E _ s_u h_uw
    have _ : AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.diagonal g_E) :=
      AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal g_E
    let q : Y ⟶ CategoryTheory.Limits.pullback g_E g_E :=
      CategoryTheory.Limits.pullback.lift (𝟙 Y) (g_E ≫ s_u)
        (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, h_uw,
          CategoryTheory.Category.comp_id])
    have hq_fst : q ≫ CategoryTheory.Limits.pullback.fst g_E g_E = 𝟙 Y :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hq_snd : q ≫ CategoryTheory.Limits.pullback.snd g_E g_E = g_E ≫ s_u :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hcomm : s_u ≫ q = s_u ≫ CategoryTheory.Limits.pullback.diagonal g_E := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hq_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst]
      · rw [CategoryTheory.Category.assoc, hq_snd, ← CategoryTheory.Category.assoc, h_uw,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id]
    have hpb : CategoryTheory.IsPullback s_u s_u q
        (CategoryTheory.Limits.pullback.diagonal g_E) := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
          (fun c => c.fst ≫ g_E) ?_ ?_ ?_)
      · intro c
        have hfst : c.fst = c.snd := by
          have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst g_E g_E) c.condition
          change (c.fst ≫ q) ≫ CategoryTheory.Limits.pullback.fst g_E g_E =
            (c.snd ≫ CategoryTheory.Limits.pullback.diagonal g_E) ≫
              CategoryTheory.Limits.pullback.fst g_E g_E at h1
          rwa [CategoryTheory.Category.assoc, hq_fst, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Category.comp_id] at h1
        have hsnd : c.fst ≫ g_E ≫ s_u = c.snd := by
          have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd g_E g_E) c.condition
          change (c.fst ≫ q) ≫ CategoryTheory.Limits.pullback.snd g_E g_E =
            (c.snd ≫ CategoryTheory.Limits.pullback.diagonal g_E) ≫
              CategoryTheory.Limits.pullback.snd g_E g_E at h2
          rwa [CategoryTheory.Category.assoc, hq_snd, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id] at h2
        rw [CategoryTheory.Category.assoc, hsnd, hfst.symm]
      · intro c
        have hsnd : c.fst ≫ g_E ≫ s_u = c.snd := by
          have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd g_E g_E) c.condition
          change (c.fst ≫ q) ≫ CategoryTheory.Limits.pullback.snd g_E g_E =
            (c.snd ≫ CategoryTheory.Limits.pullback.diagonal g_E) ≫
              CategoryTheory.Limits.pullback.snd g_E g_E at h2
          rwa [CategoryTheory.Category.assoc, hq_snd, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id] at h2
        rw [CategoryTheory.Category.assoc, hsnd]
      · intro c m_hom hm₁ _
        calc
          m_hom = m_hom ≫ 𝟙 S_Ω := (CategoryTheory.Category.comp_id m_hom).symm
          _ = m_hom ≫ (s_u ≫ g_E) := by rw [h_uw]
          _ = (m_hom ≫ s_u) ≫ g_E := (CategoryTheory.Category.assoc m_hom s_u g_E).symm
          _ = c.fst ≫ g_E := by rw [hm₁]
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip
      inferInstance

  have hSecOpenImm : ∀ (E : S_Ω.Etale) (u : T_Ω ⟶ E),
      AlgebraicGeometry.IsOpenImmersion u.left :=
    fun E u => @hSecOpenImm_sch E.left E.hom E.prop u.left u.w

  
  have hSecMem : ∀ (W : S_Ω.Etale) (R : CategoryTheory.Sieve W),
      R ∈ J_Ω W → ∀ (τ : T_Ω ⟶ W), R.arrows τ := by
    intro W R hR τ
    have hR₀ : R.pullback τ ∈ S_Ω.smallEtaleTopology T_Ω := J_Ω.pullback_stable τ hR
    obtain ⟨Y, f, y, hf_arr, _, _⟩ := hMemEtale.mp hR₀ (default : ↥S_Ω)
    obtain ⟨s_Y, hs_Y, _⟩ := hPtSec Y y
    let s_tilde : T_Ω ⟶ Y :=
      CategoryTheory.MorphismProperty.Over.homMk s_Y hs_Y trivial
    have h_down := (R.pullback τ).downward_closed hf_arr s_tilde
    have h_id : s_tilde ≫ f = 𝟙 T_Ω := hT_Ω.hom_ext _ _
    rw [h_id] at h_down
    change R.arrows (𝟙 T_Ω ≫ τ) at h_down
    rwa [CategoryTheory.Category.id_comp] at h_down

  
  have hSecDisj : ∀ (E : S_Ω.Etale) (u₁ u₂ : T_Ω ⟶ E), u₁ ≠ u₂ →
      Disjoint (Set.range u₁.left.base) (Set.range u₂.left.base) := by
    intro E u₁ u₂ hne
    rw [Set.disjoint_iff]
    rintro y ⟨⟨pt₁, hpt₁⟩, ⟨pt₂, hpt₂⟩⟩
    apply hne
    let s₁ : S_Ω ⟶ E.left := u₁.left
    let s₂ : S_Ω ⟶ E.left := u₂.left
    have hs₁_w : s₁ ≫ E.hom = 𝟙 S_Ω := u₁.w
    have hs₂_w : s₂ ≫ E.hom = 𝟙 S_Ω := u₂.w
    have _ : AlgebraicGeometry.IsOpenImmersion s₂ := hSecOpenImm E u₂
    have hsub : Set.range s₁.base ⊆ Set.range s₂.base := by
      rintro z ⟨x, rfl⟩
      have hx_eq : x = pt₁ := @Subsingleton.elim _ hSub_TΩ x pt₁
      have hz_eq : s₁.base x = s₂.base pt₂ :=
        (congrArg s₁.base hx_eq).trans (hpt₁.trans hpt₂.symm)
      exact ⟨pt₂, hz_eq.symm⟩
    let lam₀ : S_Ω ⟶ S_Ω := AlgebraicGeometry.IsOpenImmersion.lift s₂ s₁ hsub
    have hlam_fac : lam₀ ≫ s₂ = s₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac s₂ s₁ hsub
    have hlam_id : lam₀ = 𝟙 S_Ω :=
      (CategoryTheory.Category.comp_id lam₀).symm.trans
        ((congrArg (lam₀ ≫ ·) hs₂_w.symm).trans
          ((CategoryTheory.Category.assoc lam₀ s₂ E.hom).symm.trans
            ((congrArg (· ≫ E.hom) hlam_fac).trans hs₁_w)))
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    change s₁ = s₂
    exact hlam_fac.symm.trans ((congrArg (· ≫ s₂) hlam_id).trans (CategoryTheory.Category.id_comp s₂))

  have hCov_S : ∀ (E : S_Ω.Etale),
      CategoryTheory.Sieve.ofArrows (fun _ : T_Ω ⟶ E => T_Ω) (fun u => u) ∈ J_Ω E := by
    intro E
    refine hMemEtale.mpr fun y => ?_
    obtain ⟨s, hs, pt, hpt⟩ := hPtSec E y
    let u : T_Ω ⟶ E := CategoryTheory.MorphismProperty.Over.homMk s hs trivial
    have _ : AlgebraicGeometry.IsOpenImmersion s := @hSecOpenImm_sch E.left E.hom E.prop s hs
    have hu_et : AlgebraicGeometry.Etale u.left :=
      (inferInstance : AlgebraicGeometry.Etale s)
    exact ⟨T_Ω, u, pt, CategoryTheory.Sieve.ofArrows_mk _ _ u, hu_et, hpt⟩

  
  let SkyPre : AddCommGrpCat.{u} → ((Opposite S_Ω.Etale) ⥤ AddCommGrpCat.{u}) := fun M =>
    { obj := fun opW => AddCommGrpCat.of ((T_Ω ⟶ opW.unop) → ↥M)
      map := fun f => AddCommGrpCat.ofHom
        { toFun := fun g τ => g (τ ≫ f.unop)
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      map_id := fun _ => AddCommGrpCat.ext fun g => funext fun τ =>
        congrArg g (CategoryTheory.Category.comp_id τ)
      map_comp := fun _ _ => AddCommGrpCat.ext fun g => funext fun τ =>
        congrArg g (CategoryTheory.Category.assoc τ _ _).symm }

  have hSkySheaf : ∀ (M : AddCommGrpCat.{u}),
      CategoryTheory.Presheaf.IsSheaf J_Ω (SkyPre M) := by
    intro M E₀ W R hR x hx
    let t : E₀ ⟶ (SkyPre M).obj (Opposite.op W) := AddCommGrpCat.ofHom
      { toFun := fun e τ => ((x τ (hSecMem W R hR τ)).hom e) (𝟙 T_Ω)
        map_zero' := funext fun τ => by
          change ((x τ (hSecMem W R hR τ)).hom 0) (𝟙 T_Ω) = 0
          rw [map_zero]
          rfl
        map_add' := fun e₁ e₂ => funext fun τ => by
          change ((x τ (hSecMem W R hR τ)).hom (e₁ + e₂)) (𝟙 T_Ω) =
            ((x τ (hSecMem W R hR τ)).hom e₁) (𝟙 T_Ω) +
              ((x τ (hSecMem W R hR τ)).hom e₂) (𝟙 T_Ω)
          rw [map_add]
          rfl }
    refine ⟨t, ?_, ?_⟩
    · intro Y f hf
      change t ≫ (SkyPre M).map f.op = x f hf
      apply AddCommGrpCat.ext
      intro e
      funext σ
      have hcomp := hx (𝟙 T_Ω) σ (hSecMem W R hR (σ ≫ f)) hf
        (CategoryTheory.Category.id_comp (σ ≫ f))
      have heval := congrArg (fun k : E₀ ⟶ (SkyPre M).obj (Opposite.op T_Ω) => (k.hom e) (𝟙 T_Ω)) hcomp
      change ((x (σ ≫ f) (hSecMem W R hR (σ ≫ f))).hom e) (𝟙 T_Ω ≫ 𝟙 T_Ω) =
        ((x f hf).hom e) (𝟙 T_Ω ≫ σ) at heval
      rwa [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp] at heval
    · intro t' ht'
      apply AddCommGrpCat.ext
      intro e
      funext τ
      have h1 := ht' τ (hSecMem W R hR τ)
      have heval := congrArg (fun k : E₀ ⟶ (SkyPre M).obj (Opposite.op T_Ω) => (k.hom e) (𝟙 T_Ω)) h1
      change (t'.hom e) (𝟙 T_Ω ≫ τ) = ((x τ (hSecMem W R hR τ)).hom e) (𝟙 T_Ω) at heval
      rwa [CategoryTheory.Category.id_comp] at heval

  have hSkyEvalIso : ∀ (F : CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u}) (E : S_Ω.Etale),
      ∃ (inv_E : (SkyPre (F.obj.obj (Opposite.op T_Ω))).obj (Opposite.op E) ⟶
          F.obj.obj (Opposite.op E)),
        (∀ (g : (T_Ω ⟶ E) → ↥(F.obj.obj (Opposite.op T_Ω))) (u : T_Ω ⟶ E),
          (F.obj.map (Opposite.op u)).hom (inv_E.hom g) = g u) ∧
        (∀ (x : ↥(F.obj.obj (Opposite.op E))),
          inv_E.hom (fun u => (F.obj.map (Opposite.op u)).hom x) = x) := by
    intro F E
    let M_E := (SkyPre (F.obj.obj (Opposite.op T_Ω))).obj (Opposite.op E)
    let x_fam : ∀ (_ : T_Ω ⟶ E), M_E ⟶ F.obj.obj (Opposite.op T_Ω) := fun u =>
      AddCommGrpCat.ofHom
        { toFun := fun g => g u
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
    have hx_compat : ∀ ⦃Z : S_Ω.Etale⦄ ⦃u₁ u₂ : T_Ω ⟶ E⦄ (a : Z ⟶ T_Ω) (b : Z ⟶ T_Ω),
        a ≫ u₁ = b ≫ u₂ → x_fam u₁ ≫ F.obj.map a.op = x_fam u₂ ≫ F.obj.map b.op := by
      intro Z u₁ u₂ a b hab
      by_cases hu : u₁ = u₂
      · subst hu
        rw [hT_Ω.hom_ext a b]
      · refine hEmpty_ext S_Ω F Z ⟨fun z => ?_⟩ _ _
        have hz : (a ≫ u₁).left.base z = (b ≫ u₂).left.base z :=
          congrArg (fun k : Z ⟶ E => k.left.base z) hab
        exact Set.disjoint_iff.mp (hSecDisj E u₁ u₂ hu)
          ⟨⟨a.left.base z, rfl⟩, ⟨b.left.base z, hz.symm⟩⟩
    let inv_E : M_E ⟶ F.obj.obj (Opposite.op E) :=
      F.2.amalgamateOfArrows (fun u : T_Ω ⟶ E => u) (hCov_S E) x_fam hx_compat
    refine ⟨inv_E, ?_, ?_⟩
    · intro g u
      have hmap := F.2.amalgamateOfArrows_map (fun u : T_Ω ⟶ E => u) (hCov_S E) x_fam hx_compat u
      exact congrArg (fun k => k.hom g) hmap
    · intro x
      let δ_E : F.obj.obj (Opposite.op E) ⟶ M_E := AddCommGrpCat.ofHom
        { toFun := fun x' u => (F.obj.map (Opposite.op u)).hom x'
          map_zero' := funext fun u => map_zero (F.obj.map (Opposite.op u)).hom
          map_add' := fun a b => funext fun u => map_add (F.obj.map (Opposite.op u)).hom a b }
      have h_id : δ_E ≫ inv_E = 𝟙 (F.obj.obj (Opposite.op E)) := by
        apply F.2.hom_ext_ofArrows (fun u : T_Ω ⟶ E => u) (hCov_S E)
        intro u
        rw [CategoryTheory.Category.assoc,
          F.2.amalgamateOfArrows_map (fun u : T_Ω ⟶ E => u) (hCov_S E) x_fam hx_compat u,
          CategoryTheory.Category.id_comp]
        rfl
      exact congrArg (fun k => k.hom x) h_id

  
  have hSep_pt : ∀ (F : CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u}) (E : S_Ω.Etale)
      (x₁ x₂ : ↥(F.obj.obj (Opposite.op E))),
      (∀ u : T_Ω ⟶ E, (F.obj.map (Opposite.op u)).hom x₁ = (F.obj.map (Opposite.op u)).hom x₂) →
      x₁ = x₂ := by
    intro F E x₁ x₂ h_eq
    obtain ⟨inv_E, _, hleft⟩ := hSkyEvalIso F E
    calc
      x₁ = inv_E.hom (fun u => (F.obj.map (Opposite.op u)).hom x₁) := (hleft x₁).symm
      _ = inv_E.hom (fun u => (F.obj.map (Opposite.op u)).hom x₂) := by
        congr 1; funext u; exact h_eq u
      _ = x₂ := hleft x₂

  have hSurj_prop : ∀ {F₁ F₂ : CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u}} (p : F₁ ⟶ F₂),
      Function.Surjective ((p.hom.app (Opposite.op T_Ω)).hom) →
      ∀ (E : S_Ω.Etale), Function.Surjective ((p.hom.app (Opposite.op E)).hom) := by
    intro F₁ F₂ p hSurj E y
    obtain ⟨inv_E, hmap_inv, _⟩ := hSkyEvalIso F₁ E
    let g₁ : (T_Ω ⟶ E) → ↥(F₁.obj.obj (Opposite.op T_Ω)) :=
      fun u => Classical.choose (hSurj ((F₂.obj.map (Opposite.op u)).hom y))
    refine ⟨inv_E.hom g₁, ?_⟩
    apply hSep_pt F₂ E
    intro u
    have hnat := congrArg (fun k => k.hom (inv_E.hom g₁)) (p.hom.naturality (Opposite.op u)).symm
    change (F₂.obj.map (Opposite.op u)).hom ((p.hom.app (Opposite.op E)).hom (inv_E.hom g₁)) =
      (p.hom.app (Opposite.op T_Ω)).hom ((F₁.obj.map (Opposite.op u)).hom (inv_E.hom g₁)) at hnat
    rw [hnat, hmap_inv g₁ u]
    exact Classical.choose_spec (hSurj ((F₂.obj.map (Opposite.op u)).hom y))

  
  let adj_c := CategoryTheory.constantSheafAdj J_Ω AddCommGrpCat.{u} hT_Ω
  let adj_sh := CategoryTheory.sheafificationAdjunction J_Ω AddCommGrpCat.{u}
  let Sky_m : CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u} := ⟨SkyPre A_m, hSkySheaf A_m⟩
  let P_const : (Opposite S_Ω.Etale) ⥤ AddCommGrpCat.{u} :=
    (CategoryTheory.Functor.const (Opposite S_Ω.Etale)).obj A_m
  let γ_const : P_const ⟶ SkyPre A_m :=
    { app := fun _ => AddCommGrpCat.ofHom
        { toFun := fun a _ => a
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      naturality := fun _ _ _ => rfl }
  let γ_sh : C_m ⟶ Sky_m := (adj_sh.homEquiv P_const Sky_m).symm γ_const
  let ev_1 : (SkyPre A_m).obj (Opposite.op T_Ω) ⟶ A_m := AddCommGrpCat.ofHom
    { toFun := fun g => g (𝟙 T_Ω)
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let η_m : A_m ⟶ C_m.obj.obj (Opposite.op T_Ω) := adj_c.unit.app A_m
  let ρ_m : C_m.obj.obj (Opposite.op T_Ω) ⟶ A_m := γ_sh.hom.app (Opposite.op T_Ω) ≫ ev_1

  have h_unit_γ : adj_sh.unit.app P_const ≫ γ_sh.hom = γ_const := by
    have h1 := (adj_sh.homEquiv P_const Sky_m).apply_symm_apply γ_const
    exact (adj_sh.homEquiv_unit P_const Sky_m γ_sh).symm.trans h1

  have h_η_ρ : η_m ≫ ρ_m = 𝟙 A_m := by
    have happ : η_m ≫ γ_sh.hom.app (Opposite.op T_Ω) = γ_const.app (Opposite.op T_Ω) :=
      congrArg (fun α => α.app (Opposite.op T_Ω)) h_unit_γ
    exact (CategoryTheory.Category.assoc η_m (γ_sh.hom.app (Opposite.op T_Ω)) ev_1).symm.trans
      (congrArg (· ≫ ev_1) happ)

  have h_ρ_η : ρ_m ≫ η_m = 𝟙 (C_m.obj.obj (Opposite.op T_Ω)) := by
    let Sky_Cm : CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u} :=
      ⟨SkyPre (C_m.obj.obj (Opposite.op T_Ω)), hSkySheaf (C_m.obj.obj (Opposite.op T_Ω))⟩
    let sky_η : Sky_m ⟶ Sky_Cm :=
      { hom :=
          { app := fun _ => AddCommGrpCat.ofHom
              { toFun := fun g u => η_m.hom (g u)
                map_zero' := funext fun _ => map_zero η_m.hom
                map_add' := fun g₁ g₂ => funext fun u => map_add η_m.hom (g₁ u) (g₂ u) }
            naturality := fun _ _ _ => rfl } }
    let δ_Cm : C_m ⟶ Sky_Cm :=
      { hom :=
          { app := fun opE => AddCommGrpCat.ofHom
              { toFun := fun x u => (C_m.obj.map (Opposite.op u)).hom x
                map_zero' := funext fun u => map_zero (C_m.obj.map (Opposite.op u)).hom
                map_add' := fun x₁ x₂ => funext fun u =>
                  map_add (C_m.obj.map (Opposite.op u)).hom x₁ x₂ }
            naturality := fun _ _ f => AddCommGrpCat.ext fun x => funext fun u => by
              change (C_m.obj.map (Opposite.op u)).hom ((C_m.obj.map f).hom x) =
                (C_m.obj.map (Opposite.op (u ≫ f.unop))).hom x
              have hm : C_m.obj.map f ≫ C_m.obj.map (Opposite.op u) =
                  C_m.obj.map (Opposite.op (u ≫ f.unop)) :=
                (C_m.obj.map_comp f (Opposite.op u)).symm.trans
                  (congrArg C_m.obj.map rfl)
              exact congrArg (fun k => k.hom x) hm } }
    have h_sh_eq : γ_sh ≫ sky_η = δ_Cm := by
      apply (adj_sh.homEquiv P_const Sky_Cm).injective
      refine (adj_sh.homEquiv_unit P_const Sky_Cm (γ_sh ≫ sky_η)).trans
        (Eq.trans ?_ (adj_sh.homEquiv_unit P_const Sky_Cm δ_Cm).symm)
      apply CategoryTheory.NatTrans.ext
      funext opE
      apply AddCommGrpCat.ext
      intro a
      funext u
      have h_lhs : (((adj_sh.unit.app P_const ≫ (γ_sh ≫ sky_η).hom).app opE).hom a) u =
          η_m.hom a := by
        have h1 : adj_sh.unit.app P_const ≫ (γ_sh ≫ sky_η).hom = γ_const ≫ sky_η.hom :=
          (CategoryTheory.Category.assoc (adj_sh.unit.app P_const) γ_sh.hom sky_η.hom).symm.trans
            (congrArg (· ≫ sky_η.hom) h_unit_γ)
        exact congrArg (fun α => ((α.app opE).hom a) u) h1
      have h_rhs : (((adj_sh.unit.app P_const ≫ δ_Cm.hom).app opE).hom a) u = η_m.hom a := by
        have hnat : ((adj_sh.unit.app P_const).app opE ≫ C_m.obj.map (Opposite.op u)) = η_m :=
          ((adj_sh.unit.app P_const).naturality (Opposite.op u)).symm.trans
            (CategoryTheory.Category.id_comp η_m)
        exact congrArg (fun k : A_m ⟶ C_m.obj.obj (Opposite.op T_Ω) => k.hom a) hnat
      exact h_lhs.trans h_rhs.symm
    apply AddCommGrpCat.ext
    intro x
    have heval : (ρ_m ≫ η_m).hom x = (C_m.obj.map (𝟙 (Opposite.op T_Ω))).hom x :=
      congrArg (fun φ : C_m ⟶ Sky_Cm =>
        ((φ.hom.app (Opposite.op T_Ω)).hom x) (𝟙 T_Ω)) h_sh_eq
    exact heval.trans (congrArg (fun k => k.hom x) (C_m.obj.map_id (Opposite.op T_Ω)))

  let e_unit : A_m ≅ C_m.obj.obj (Opposite.op T_Ω) :=
    { hom := η_m
      inv := ρ_m
      hom_inv_id := h_η_ρ
      inv_hom_id := h_ρ_η }

  have hBij_TΩ : Function.Bijective
      ((CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0)).hom) := by
    let π_sh : L_0 ⟶ C_m := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm e_unit.hom
    let ε_sh : C_m ⟶ L_0 :=
      (adj_c.homEquiv A_m L_0).symm
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0))
    have h_adj_unit : ∀ {G : CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u}} (f : C_m ⟶ G),
        adj_c.homEquiv A_m G f = e_unit.hom ≫ f.hom.app (Opposite.op T_Ω) := by
      intro G f
      exact adj_c.homEquiv_unit A_m G f
    have h_unit_ε : e_unit.hom ≫ ε_sh.hom.app (Opposite.op T_Ω) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0) :=
      (h_adj_unit ε_sh).symm.trans ((adj_c.homEquiv A_m L_0).apply_symm_apply _)
    have h_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0) ≫
        π_sh.hom.app (Opposite.op T_Ω) = e_unit.hom :=
      (hFreeComp (CategoryTheory.CategoryStruct.id L_0) π_sh).symm.trans
        ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.Category.id_comp π_sh)).trans
          (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply e_unit.hom))
    have h_πε : π_sh ≫ ε_sh = 𝟙 L_0 := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      exact (hFreeComp π_sh ε_sh).trans
        ((congrArg (· ≫ ε_sh.hom.app (Opposite.op T_Ω))
          (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply e_unit.hom)).trans h_unit_ε)
    let inv_hom : L_0.obj.obj (Opposite.op T_Ω) ⟶ A_m :=
      π_sh.hom.app (Opposite.op T_Ω) ≫ e_unit.inv
    have h_lr : CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0) ≫
        inv_hom = 𝟙 A_m :=
      (CategoryTheory.Category.assoc _ (π_sh.hom.app (Opposite.op T_Ω)) e_unit.inv).symm.trans
        ((congrArg (· ≫ e_unit.inv) h_eq).trans e_unit.hom_inv_id)
    have h_rl : inv_hom ≫
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0) = 𝟙 _ := by
      have h_app_inv : π_sh.hom.app (Opposite.op T_Ω) ≫ ε_sh.hom.app (Opposite.op T_Ω) = 𝟙 _ :=
        congrArg (fun φ => φ.hom.app (Opposite.op T_Ω)) h_πε
      have h_inv_eq : e_unit.inv ≫
          CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0) =
          ε_sh.hom.app (Opposite.op T_Ω) :=
        (congrArg (e_unit.inv ≫ ·) h_unit_ε.symm).trans
          ((CategoryTheory.Category.assoc e_unit.inv e_unit.hom _).symm.trans
            ((congrArg (· ≫ ε_sh.hom.app (Opposite.op T_Ω)) e_unit.inv_hom_id).trans
              (CategoryTheory.Category.id_comp _)))
      exact (CategoryTheory.Category.assoc (π_sh.hom.app (Opposite.op T_Ω)) e_unit.inv _).trans
        ((congrArg (π_sh.hom.app (Opposite.op T_Ω) ≫ ·) h_inv_eq).trans h_app_inv)
    exact (Equiv.mk
      ((CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_0)).hom)
      inv_hom.hom
      (fun a => congrArg (fun k => k.hom a) h_lr)
      (fun b => congrArg (fun k => k.hom b) h_rl)).bijective

  refine ⟨hBij_TΩ, ?_⟩

  
  intro W_x f'_0 σ _ _ hσ_et hc_σ P_pull_σ adj_σ _ hInj_σ e₀_σ he₀_nat U_σ L_σ T_Wx
  let B_σ := weilAltCdSitePullback σ
  let pf_σ := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    B_σ AddCommGrpCat.{u} _ W_x.smallEtaleTopology S_Ω.smallEtaleTopology hc_σ

  
  let d_σ_left : S_Ω ⟶ CategoryTheory.Limits.pullback σ σ :=
    CategoryTheory.Limits.pullback.lift (𝟙 S_Ω) (𝟙 S_Ω) rfl
  let d_σ : T_Ω ⟶ B_σ.obj U_σ :=
    CategoryTheory.MorphismProperty.Over.homMk d_σ_left
      (CategoryTheory.Limits.pullback.lift_snd (𝟙 S_Ω) (𝟙 S_Ω) rfl) trivial
  let t_Uσ : B_σ.obj U_σ ⟶ T_Ω := hT_Ω.from (B_σ.obj U_σ)
  have hd_t : d_σ ≫ t_Uσ = 𝟙 T_Ω := hT_Ω.hom_ext _ _
  have ht_d : t_Uσ ≫ d_σ = 𝟙 (B_σ.obj U_σ) := by
    have h_fst_eq_snd : CategoryTheory.Limits.pullback.fst σ σ =
        CategoryTheory.Limits.pullback.snd σ σ := by
      rw [← cancel_mono σ]
      exact CategoryTheory.Limits.pullback.condition
    let t_left : CategoryTheory.Limits.pullback σ σ ⟶ S_Ω := t_Uσ.left
    have ht_left : t_left = CategoryTheory.Limits.pullback.snd σ σ :=
      (CategoryTheory.Category.comp_id t_left).symm.trans t_Uσ.w
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    change t_left ≫ d_σ_left = 𝟙 (CategoryTheory.Limits.pullback σ σ)
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp, ht_left, h_fst_eq_snd]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp, ht_left]

  
  let α_σ : L_σ ⟶ pf_σ.obj C_m :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (e_unit.hom ≫ C_m.obj.map (Opposite.op t_Uσ))

  let Idx : W_x.Etale → Type u := fun V => (T_Ω ⟶ B_σ.obj V) ⊕ ULift.{u} Unit
  let u_hat : ∀ (V : W_x.Etale), (T_Ω ⟶ B_σ.obj V) → (S_Ω ⟶ V.left) :=
    fun V u =>
      let s_u : S_Ω ⟶ CategoryTheory.Limits.pullback V.hom σ := u.left
      s_u ≫ CategoryTheory.Limits.pullback.fst V.hom σ
  have hu_hat_w : ∀ (V : W_x.Etale) (u : T_Ω ⟶ B_σ.obj V), u_hat V u ≫ V.hom = σ := by
    intro V u
    let s_u : S_Ω ⟶ CategoryTheory.Limits.pullback V.hom σ := u.left
    have hu_snd : s_u ≫ CategoryTheory.Limits.pullback.snd V.hom σ = 𝟙 S_Ω := u.w
    change (s_u ≫ CategoryTheory.Limits.pullback.fst V.hom σ) ≫ V.hom = σ
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc, hu_snd, CategoryTheory.Category.id_comp]
  let ι_tilde : ∀ (V : W_x.Etale), (T_Ω ⟶ B_σ.obj V) → (U_σ ⟶ V) :=
    fun V u => CategoryTheory.MorphismProperty.Over.homMk (u_hat V u) (hu_hat_w V u) trivial

  let O_out : ∀ (V : W_x.Etale), V.left.Opens := fun V =>
    ⟨V.hom.base ⁻¹' (Set.range σ.base)ᶜ,
      σ.isClosedEmbedding.isClosed_range.isOpen_compl.preimage V.hom.continuous⟩
  let V_out : ∀ (V : W_x.Etale), W_x.Etale := fun V =>
    let _ : AlgebraicGeometry.Etale V.hom := V.prop
    weilGysinEtaleObj ((O_out V).ι ≫ V.hom) inferInstance
  let w_out : ∀ (V : W_x.Etale), V_out V ⟶ V := fun V =>
    CategoryTheory.MorphismProperty.Over.homMk (O_out V).ι rfl trivial

  let X_obj : ∀ (V : W_x.Etale), Idx V → W_x.Etale := fun V i =>
    match i with
    | Sum.inl _ => U_σ
    | Sum.inr _ => V_out V
  let arr : ∀ (V : W_x.Etale) (i : Idx V), X_obj V i ⟶ V := fun V i =>
    match i with
    | Sum.inl u => ι_tilde V u
    | Sum.inr _ => w_out V

  have harr_open : ∀ (V : W_x.Etale) (i : Idx V),
      AlgebraicGeometry.IsOpenImmersion (arr V i).left := by
    intro V i
    cases i with
    | inl u =>
      let s_u : S_Ω ⟶ CategoryTheory.Limits.pullback V.hom σ := u.left
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        s_u (CategoryTheory.Limits.pullback.fst V.hom σ)
        (hSecOpenImm (B_σ.obj V) u) inferInstance
    | inr _ =>
      change AlgebraicGeometry.IsOpenImmersion (O_out V).ι
      infer_instance

  have harr_disj : ∀ (V : W_x.Etale) (i₁ i₂ : Idx V), i₁ ≠ i₂ →
      Disjoint (Set.range (arr V i₁).left.base) (Set.range (arr V i₂).left.base) := by
    intro V i₁ i₂ hne
    cases i₁ with
    | inl u₁ =>
      cases i₂ with
      | inl u₂ =>
        rw [Set.disjoint_iff]
        rintro y ⟨⟨pt₁, hpt₁⟩, ⟨pt₂, hpt₂⟩⟩
        apply hne
        congr 1
        have _ : AlgebraicGeometry.IsOpenImmersion (u_hat V u₂) := harr_open V (Sum.inl u₂)
        have hsub : Set.range (u_hat V u₁).base ⊆ Set.range (u_hat V u₂).base := by
          rintro z ⟨x, rfl⟩
          have hx_eq : x = pt₁ := @Subsingleton.elim _ (inferInstance : Subsingleton ↥S_Ω) x pt₁
          exact ⟨pt₂, hpt₂.trans (hpt₁.symm.trans (congrArg (u_hat V u₁).base hx_eq.symm))⟩
        let lam₀ : S_Ω ⟶ S_Ω := AlgebraicGeometry.IsOpenImmersion.lift (u_hat V u₂) (u_hat V u₁) hsub
        have hlam_fac : lam₀ ≫ u_hat V u₂ = u_hat V u₁ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (u_hat V u₂) (u_hat V u₁) hsub
        have hlam_id : lam₀ = 𝟙 S_Ω := by
          rw [← cancel_mono σ]
          calc
            lam₀ ≫ σ = lam₀ ≫ (u_hat V u₂ ≫ V.hom) := by rw [hu_hat_w V u₂]
            _ = (lam₀ ≫ u_hat V u₂) ≫ V.hom := (CategoryTheory.Category.assoc _ _ _).symm
            _ = u_hat V u₁ ≫ V.hom := by rw [hlam_fac]
            _ = σ := hu_hat_w V u₁
            _ = 𝟙 S_Ω ≫ σ := (CategoryTheory.Category.id_comp σ).symm
        have hu_eq : u_hat V u₁ = u_hat V u₂ := by
          rw [← hlam_fac, hlam_id, CategoryTheory.Category.id_comp]
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        let s₁ : S_Ω ⟶ CategoryTheory.Limits.pullback V.hom σ := u₁.left
        let s₂ : S_Ω ⟶ CategoryTheory.Limits.pullback V.hom σ := u₂.left
        change s₁ = s₂
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact hu_eq
        · exact u₁.w.trans u₂.w.symm
      | inr _ =>
        rw [Set.disjoint_iff]
        rintro y ⟨⟨pt, hpt⟩, ⟨z, rfl⟩⟩
        have hz_not : V.hom.base ((O_out V).ι.base z) ∉ Set.range σ.base := z.2
        have hpt' : (u_hat V u₁).base pt = (O_out V).ι.base z := hpt
        have h_in : V.hom.base ((O_out V).ι.base z) ∈ Set.range σ.base :=
          ⟨pt, (congrArg (fun k : S_Ω ⟶ W_x => k.base pt) (hu_hat_w V u₁)).symm.trans
            (congrArg V.hom.base hpt')⟩
        exact hz_not h_in
    | inr a₁ =>
      cases i₂ with
      | inl u₂ =>
        rw [Set.disjoint_iff]
        rintro y ⟨⟨z, rfl⟩, ⟨pt, hpt⟩⟩
        have hz_not : V.hom.base ((O_out V).ι.base z) ∉ Set.range σ.base := z.2
        have hpt' : (u_hat V u₂).base pt = (O_out V).ι.base z := hpt
        have h_in : V.hom.base ((O_out V).ι.base z) ∈ Set.range σ.base :=
          ⟨pt, (congrArg (fun k : S_Ω ⟶ W_x => k.base pt) (hu_hat_w V u₂)).symm.trans
            (congrArg V.hom.base hpt')⟩
        exact hz_not h_in
      | inr a₂ =>
        exact absurd (congrArg Sum.inr (Subsingleton.elim a₁ a₂)) hne

  have hCov_W : ∀ (V : W_x.Etale),
      CategoryTheory.Sieve.ofArrows (X_obj V) (arr V) ∈ W_x.smallEtaleTopology V := by
    intro V
    refine hMemEtale.mpr fun v => ?_
    by_cases hv : V.hom.base v ∈ Set.range σ.base
    · obtain ⟨pt, hpt⟩ := hv
      obtain ⟨z, hz_fst, _⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback V.hom σ) v pt hpt.symm
      obtain ⟨s, hs, pt₀, hpt₀⟩ := hPtSec (B_σ.obj V) z
      let u : T_Ω ⟶ B_σ.obj V := CategoryTheory.MorphismProperty.Over.homMk s hs trivial
      have _ : AlgebraicGeometry.IsOpenImmersion (u_hat V u) := harr_open V (Sum.inl u)
      have hu_et : AlgebraicGeometry.Etale (arr V (Sum.inl u)).left :=
        (inferInstance : AlgebraicGeometry.Etale (u_hat V u))
      refine ⟨X_obj V (Sum.inl u), arr V (Sum.inl u), pt₀,
        CategoryTheory.Sieve.ofArrows_mk (X_obj V) (arr V) (Sum.inl u), hu_et, ?_⟩
      change (CategoryTheory.Limits.pullback.fst V.hom σ).base (s.base pt₀) = v
      rw [hpt₀, hz_fst]
    · let z : ↥(O_out V) := ⟨v, hv⟩
      have hout_et : AlgebraicGeometry.Etale (arr V (Sum.inr ⟨()⟩)).left :=
        (inferInstance : AlgebraicGeometry.Etale (O_out V).ι)
      exact ⟨X_obj V (Sum.inr ⟨()⟩), arr V (Sum.inr ⟨()⟩), z,
        CategoryTheory.Sieve.ofArrows_mk (X_obj V) (arr V) (Sum.inr ⟨()⟩), hout_et, rfl⟩

  
  let η_Lσ : A_m ⟶ L_σ.obj.obj (Opposite.op U_σ) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_σ)
  let x_fam_W : ∀ (V : W_x.Etale) (i : Idx V),
      (pf_σ.obj C_m).obj.obj (Opposite.op V) ⟶ L_σ.obj.obj (Opposite.op (X_obj V i)) :=
    fun V i =>
      match i with
      | Sum.inl u => C_m.obj.map (Opposite.op u) ≫ e_unit.inv ≫ η_Lσ
      | Sum.inr _ => 0

  have hx_compat_W : ∀ (V : W_x.Etale) ⦃Z : W_x.Etale⦄ ⦃i₁ i₂ : Idx V⦄
      (a : Z ⟶ X_obj V i₁) (b : Z ⟶ X_obj V i₂),
      a ≫ arr V i₁ = b ≫ arr V i₂ →
      x_fam_W V i₁ ≫ L_σ.obj.map a.op = x_fam_W V i₂ ≫ L_σ.obj.map b.op := by
    intro V Z i₁ i₂ a b hab
    by_cases hi : i₁ = i₂
    · subst hi
      let arr_l : (X_obj V i₁).left ⟶ V.left := (arr V i₁).left
      have _ : AlgebraicGeometry.IsOpenImmersion arr_l := harr_open V i₁
      let a_l : Z.left ⟶ (X_obj V i₁).left := a.left
      let b_l : Z.left ⟶ (X_obj V i₁).left := b.left
      have hab_left : a_l ≫ arr_l = b_l ≫ arr_l :=
        congrArg (fun k : Z ⟶ V => (k.left : Z.left ⟶ V.left)) hab
      rw [cancel_mono] at hab_left
      have hab_eq : a = b := CategoryTheory.MorphismProperty.Over.Hom.ext hab_left
      rw [hab_eq]
    · refine hEmpty_ext W_x L_σ Z ⟨fun z => ?_⟩ _ _
      have hz : (a ≫ arr V i₁).left.base z = (b ≫ arr V i₂).left.base z :=
        congrArg (fun k : Z ⟶ V => k.left.base z) hab
      exact Set.disjoint_iff.mp (harr_disj V i₁ i₂ hi)
        ⟨⟨a.left.base z, rfl⟩, ⟨b.left.base z, hz.symm⟩⟩

  let β_app : ∀ (V : W_x.Etale),
      (pf_σ.obj C_m).obj.obj (Opposite.op V) ⟶ L_σ.obj.obj (Opposite.op V) :=
    fun V => L_σ.2.amalgamateOfArrows (arr V) (hCov_W V) (x_fam_W V) (hx_compat_W V)

  have hβ_nat : ∀ ⦃opV₂ opV₁ : Opposite W_x.Etale⦄ (fg : opV₂ ⟶ opV₁),
      (pf_σ.obj C_m).obj.map fg ≫ β_app opV₁.unop =
        β_app opV₂.unop ≫ L_σ.obj.map fg := by
    intro opV₂ opV₁ fg
    let V₁ := opV₁.unop
    let V₂ := opV₂.unop
    let g : V₁ ⟶ V₂ := fg.unop
    change (pf_σ.obj C_m).obj.map (Opposite.op g) ≫ β_app V₁ =
      β_app V₂ ≫ L_σ.obj.map (Opposite.op g)
    apply L_σ.2.hom_ext_ofArrows (arr V₁) (hCov_W V₁)
    intro i₁
    cases i₁ with
    | inl u₁ =>
      have h_ι_comp : ι_tilde V₁ u₁ ≫ g = ι_tilde V₂ (u₁ ≫ B_σ.map g) := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        let s₁ : S_Ω ⟶ CategoryTheory.Limits.pullback V₁.hom σ := u₁.left
        let bg_l : CategoryTheory.Limits.pullback V₁.hom σ ⟶
            CategoryTheory.Limits.pullback V₂.hom σ := (B_σ.map g).left
        let g_l : V₁.left ⟶ V₂.left := g.left
        have hbg_fst : bg_l ≫ CategoryTheory.Limits.pullback.fst V₂.hom σ =
            CategoryTheory.Limits.pullback.fst V₁.hom σ ≫ g_l :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        exact (CategoryTheory.Category.assoc s₁ _ g_l).trans
          ((congrArg (s₁ ≫ ·) hbg_fst.symm).trans
            (CategoryTheory.Category.assoc s₁ bg_l _).symm)
      have h_lhs : (pf_σ.obj C_m).obj.map (Opposite.op g) ≫
          (β_app V₁ ≫ L_σ.obj.map (Opposite.op (arr V₁ (Sum.inl u₁)))) =
          C_m.obj.map (Opposite.op (u₁ ≫ B_σ.map g)) ≫ e_unit.inv ≫ η_Lσ := by
        have hm₁ := L_σ.2.amalgamateOfArrows_map (arr V₁) (hCov_W V₁) (x_fam_W V₁)
          (hx_compat_W V₁) (Sum.inl u₁)
        exact (congrArg ((pf_σ.obj C_m).obj.map (Opposite.op g) ≫ ·) hm₁).trans
          ((CategoryTheory.Category.assoc (C_m.obj.map (Opposite.op (B_σ.map g)))
              (C_m.obj.map (Opposite.op u₁)) (e_unit.inv ≫ η_Lσ)).symm.trans
            (congrArg (· ≫ (e_unit.inv ≫ η_Lσ))
              (C_m.obj.map_comp (Opposite.op (B_σ.map g)) (Opposite.op u₁)).symm))
      have h_rhs : β_app V₂ ≫
          (L_σ.obj.map (Opposite.op g) ≫ L_σ.obj.map (Opposite.op (arr V₁ (Sum.inl u₁)))) =
          C_m.obj.map (Opposite.op (u₁ ≫ B_σ.map g)) ≫ e_unit.inv ≫ η_Lσ := by
        have hm₂ := L_σ.2.amalgamateOfArrows_map (arr V₂) (hCov_W V₂) (x_fam_W V₂)
          (hx_compat_W V₂) (Sum.inl (u₁ ≫ B_σ.map g))
        have hmap_eq : L_σ.obj.map (Opposite.op g) ≫
            L_σ.obj.map (Opposite.op (arr V₁ (Sum.inl u₁))) =
            L_σ.obj.map (Opposite.op (arr V₂ (Sum.inl (u₁ ≫ B_σ.map g)))) :=
          (L_σ.obj.map_comp (Opposite.op g) (Opposite.op (ι_tilde V₁ u₁))).symm.trans
            (congrArg (fun k => L_σ.obj.map (Opposite.op k)) h_ι_comp)
        exact (congrArg (β_app V₂ ≫ ·) hmap_eq).trans hm₂
      exact (CategoryTheory.Category.assoc _ _ _).trans
        (h_lhs.trans (h_rhs.symm.trans (CategoryTheory.Category.assoc _ _ _).symm))
    | inr a₁ =>
      let g_l : V₁.left ⟶ V₂.left := g.left
      have hg_l_w : g_l ≫ V₂.hom = V₁.hom := g.w
      have hsub_out : Set.range ((O_out V₁).ι ≫ g_l).base ⊆ Set.range (O_out V₂).ι.base := by
        rintro y ⟨z, rfl⟩
        have hz : z.1 ∈ (O_out V₁ : Set ↥V₁.left) := z.2
        have hy_not : V₂.hom.base (((O_out V₁).ι ≫ g_l).base z) ∉ Set.range σ.base := by
          have hg_pt : V₂.hom.base (((O_out V₁).ι ≫ g_l).base z) =
              V₁.hom.base ((O_out V₁).ι.base z) :=
            congrArg (fun k : V₁.left ⟶ W_x => k.base ((O_out V₁).ι.base z)) hg_l_w
          rw [hg_pt]
          exact hz
        exact ⟨⟨((O_out V₁).ι ≫ g_l).base z, hy_not⟩, rfl⟩
      let q_out : (O_out V₁).toScheme ⟶ (O_out V₂).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (O_out V₂).ι ((O_out V₁).ι ≫ g_l) hsub_out
      have hq_fac : q_out ≫ (O_out V₂).ι = (O_out V₁).ι ≫ g_l :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (O_out V₂).ι ((O_out V₁).ι ≫ g_l) hsub_out
      let g_out : V_out V₁ ⟶ V_out V₂ :=
        CategoryTheory.MorphismProperty.Over.homMk q_out
          ((CategoryTheory.Category.assoc q_out (O_out V₂).ι V₂.hom).symm.trans
            ((congrArg (· ≫ V₂.hom) hq_fac).trans
              ((CategoryTheory.Category.assoc (O_out V₁).ι g_l V₂.hom).trans
                (congrArg ((O_out V₁).ι ≫ ·) hg_l_w))))
          trivial
      have hw_comp : w_out V₁ ≫ g = g_out ≫ w_out V₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hq_fac.symm
      have h_lhs : ((pf_σ.obj C_m).obj.map (Opposite.op g) ≫ β_app V₁) ≫
          L_σ.obj.map (Opposite.op (arr V₁ (Sum.inr a₁))) = 0 :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg ((pf_σ.obj C_m).obj.map (Opposite.op g) ≫ ·)
            (L_σ.2.amalgamateOfArrows_map (arr V₁) (hCov_W V₁) (x_fam_W V₁) (hx_compat_W V₁)
              (Sum.inr a₁))).trans CategoryTheory.Limits.comp_zero)
      have h_rhs : (β_app V₂ ≫ L_σ.obj.map (Opposite.op g)) ≫
          L_σ.obj.map (Opposite.op (arr V₁ (Sum.inr a₁))) = 0 := by
        have hmap_eq : L_σ.obj.map (Opposite.op g) ≫
            L_σ.obj.map (Opposite.op (arr V₁ (Sum.inr a₁))) =
            L_σ.obj.map (Opposite.op (arr V₂ (Sum.inr ⟨()⟩))) ≫ L_σ.obj.map (Opposite.op g_out) :=
          (L_σ.obj.map_comp (Opposite.op g) (Opposite.op (w_out V₁))).symm.trans
            ((congrArg (fun k => L_σ.obj.map (Opposite.op k)) hw_comp).trans
              (L_σ.obj.map_comp (Opposite.op (w_out V₂)) (Opposite.op g_out)))
        exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (β_app V₂ ≫ ·) hmap_eq).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ L_σ.obj.map (Opposite.op g_out))
                (L_σ.2.amalgamateOfArrows_map (arr V₂) (hCov_W V₂) (x_fam_W V₂) (hx_compat_W V₂)
                  (Sum.inr ⟨()⟩))).trans CategoryTheory.Limits.zero_comp)))
      exact h_lhs.trans h_rhs.symm

  let β_σ : pf_σ.obj C_m ⟶ L_σ :=
    { hom :=
        { app := fun opV => β_app opV.unop
          naturality := hβ_nat } }

  have h_ι_dσ : ι_tilde U_σ d_σ = 𝟙 U_σ :=
    CategoryTheory.MorphismProperty.Over.Hom.ext
      (CategoryTheory.Limits.pullback.lift_fst (𝟙 S_Ω) (𝟙 S_Ω) rfl)

  have hβ_Uσ : β_app U_σ = C_m.obj.map (Opposite.op d_σ) ≫ e_unit.inv ≫ η_Lσ :=
    (CategoryTheory.Category.comp_id (β_app U_σ)).symm.trans
      ((congrArg (β_app U_σ ≫ ·)
        ((L_σ.obj.map_id (Opposite.op U_σ)).symm.trans
          (congrArg (fun k => L_σ.obj.map (Opposite.op k)) h_ι_dσ.symm))).trans
        (L_σ.2.amalgamateOfArrows_map (arr U_σ) (hCov_W U_σ) (x_fam_W U_σ) (hx_compat_W U_σ)
          (Sum.inl d_σ)))

  have h_td_map : C_m.obj.map (Opposite.op t_Uσ) ≫ C_m.obj.map (Opposite.op d_σ) =
      𝟙 (C_m.obj.obj (Opposite.op T_Ω)) :=
    (C_m.obj.map_comp (Opposite.op t_Uσ) (Opposite.op d_σ)).symm.trans
      ((congrArg (fun k => C_m.obj.map (Opposite.op k)) hd_t).trans
        (C_m.obj.map_id (Opposite.op T_Ω)))

  have h_α_Uσ : η_Lσ ≫ α_σ.hom.app (Opposite.op U_σ) =
      e_unit.hom ≫ C_m.obj.map (Opposite.op t_Uσ) :=
    (hFreeComp (CategoryTheory.CategoryStruct.id L_σ) α_σ).symm.trans
      ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.Category.id_comp α_σ)).trans
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _))

  have h_αβ : α_σ ≫ β_σ = 𝟙 L_σ := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    refine (hFreeComp α_σ β_σ).trans ?_
    refine (congrArg (· ≫ β_app U_σ)
      (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _)).trans ?_
    refine (congrArg ((e_unit.hom ≫ C_m.obj.map (Opposite.op t_Uσ)) ≫ ·) hβ_Uσ).trans ?_
    refine (CategoryTheory.Category.assoc e_unit.hom (C_m.obj.map (Opposite.op t_Uσ)) _).trans ?_
    refine (congrArg (e_unit.hom ≫ ·)
      ((CategoryTheory.Category.assoc (C_m.obj.map (Opposite.op t_Uσ))
        (C_m.obj.map (Opposite.op d_σ)) (e_unit.inv ≫ η_Lσ)).symm.trans
        ((congrArg (· ≫ (e_unit.inv ≫ η_Lσ)) h_td_map).trans
          (CategoryTheory.Category.id_comp _)))).trans ?_
    exact (CategoryTheory.Category.assoc e_unit.hom e_unit.inv η_Lσ).symm.trans
      ((congrArg (· ≫ η_Lσ) e_unit.hom_inv_id).trans (CategoryTheory.Category.id_comp η_Lσ))

  have h_βα : β_σ ≫ α_σ = 𝟙 (pf_σ.obj C_m) := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext ⟨V⟩
    apply AddCommGrpCat.ext
    intro c
    apply hSep_pt C_m (B_σ.obj V)
    intro u
    have h_d_map : d_σ ≫ B_σ.map (ι_tilde V u) = u := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      let bg_l : CategoryTheory.Limits.pullback σ σ ⟶
          CategoryTheory.Limits.pullback V.hom σ := (B_σ.map (ι_tilde V u)).left
      let s_u : S_Ω ⟶ CategoryTheory.Limits.pullback V.hom σ := u.left
      have hbg_fst : bg_l ≫ CategoryTheory.Limits.pullback.fst V.hom σ =
          CategoryTheory.Limits.pullback.fst σ σ ≫ u_hat V u :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      change d_σ_left ≫ bg_l = s_u
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hbg_fst, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      · exact (d_σ ≫ B_σ.map (ι_tilde V u)).w.trans u.w.symm
    let m_u := C_m.obj.map (Opposite.op u)
    let m_B := C_m.obj.map (Opposite.op (B_σ.map (ι_tilde V u)))
    let m_d := C_m.obj.map (Opposite.op d_σ)
    let m_t := C_m.obj.map (Opposite.op t_Uσ)
    let α_V := α_σ.hom.app (Opposite.op V)
    let α_U := α_σ.hom.app (Opposite.op U_σ)
    have hnat : α_V ≫ m_B = L_σ.obj.map (Opposite.op (ι_tilde V u)) ≫ α_U :=
      (α_σ.hom.naturality (Opposite.op (ι_tilde V u))).symm
    have h_u_decomp : m_u = m_B ≫ m_d :=
      (congrArg (fun k => C_m.obj.map (Opposite.op k)) h_d_map.symm).trans
        (C_m.obj.map_comp (Opposite.op (B_σ.map (ι_tilde V u))) (Opposite.op d_σ))
    have hm_V : β_app V ≫ L_σ.obj.map (Opposite.op (ι_tilde V u)) =
        m_u ≫ (e_unit.inv ≫ η_Lσ) :=
      L_σ.2.amalgamateOfArrows_map (arr V) (hCov_W V) (x_fam_W V) (hx_compat_W V) (Sum.inl u)
    have h_mid : (e_unit.inv ≫ η_Lσ) ≫ (α_U ≫ m_d) = 𝟙 _ :=
      (CategoryTheory.Category.assoc e_unit.inv η_Lσ (α_U ≫ m_d)).trans
        ((congrArg (e_unit.inv ≫ ·)
          ((CategoryTheory.Category.assoc η_Lσ α_U m_d).symm.trans
            ((congrArg (· ≫ m_d) h_α_Uσ).trans
              ((CategoryTheory.Category.assoc e_unit.hom m_t m_d).trans
                ((congrArg (e_unit.hom ≫ ·) h_td_map).trans
                  (CategoryTheory.Category.comp_id e_unit.hom)))))).trans
          e_unit.inv_hom_id)
    have h_chain : (β_app V ≫ α_V) ≫ m_u = m_u :=
      (congrArg ((β_app V ≫ α_V) ≫ ·) h_u_decomp).trans
        ((CategoryTheory.Category.assoc (β_app V) α_V (m_B ≫ m_d)).trans
          ((congrArg (β_app V ≫ ·)
            ((CategoryTheory.Category.assoc α_V m_B m_d).symm.trans
              ((congrArg (· ≫ m_d) hnat).trans
                (CategoryTheory.Category.assoc _ α_U m_d)))).trans
            ((CategoryTheory.Category.assoc (β_app V) _ (α_U ≫ m_d)).symm.trans
              ((congrArg (· ≫ (α_U ≫ m_d)) hm_V).trans
                ((CategoryTheory.Category.assoc m_u (e_unit.inv ≫ η_Lσ) (α_U ≫ m_d)).trans
                  ((congrArg (m_u ≫ ·) h_mid).trans
                    (CategoryTheory.Category.comp_id m_u)))))))
    exact congrArg (fun k => k.hom c) h_chain

