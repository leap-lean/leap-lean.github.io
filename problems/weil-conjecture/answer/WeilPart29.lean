            CategoryTheory.Sieve.ofArrows_mk (fun (_ : T_Ω ⟶ E) => T_Ω) id τ_y,
            hEt_sE, hpt_E pt_Ω⟩
        · exact le_rfl

  
  have hSitePkg : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      (J : CategoryTheory.GrothendieckTopology 𝒞)
      [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      (T : 𝒞) (hT : CategoryTheory.Limits.IsTerminal T),
      (∀ (W : 𝒞) (R : CategoryTheory.Sieve W), R ∈ J W → ∀ (τ : Quiver.Hom T W), R.arrows τ) →
      (∀ (E : 𝒞),
        (Nonempty (Quiver.Hom T E) ∨ (⊥ : CategoryTheory.Sieve E) ∈ J E) ∧
        CategoryTheory.Sieve.ofArrows (fun (_ : Quiver.Hom T E) => T) id ∈ J E) →
      (∀ (Q : CategoryTheory.Functor (Opposite 𝒞) AddCommGrpCat.{u}),
        Subsingleton ↥(Q.obj (Opposite.op T)) →
        CategoryTheory.Limits.IsZero
          ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj Q)) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (ψ : Quiver.Hom ℱ₁ ℱ₂),
        Function.Bijective ((ψ.hom.app (Opposite.op T)).hom) →
        CategoryTheory.IsIso ψ) ∧
      CategoryTheory.Projective
        ((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) ∧
      (∀ {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
          (K : CategoryTheory.GrothendieckTopology 𝒟)
          (B : CategoryTheory.Functor 𝒟 𝒞)
          (hc : B.IsContinuous K J)
          (ℋ : CategoryTheory.Sheaf K AddCommGrpCat.{u})
          (M : AddCommGrpCat.{u})
          (φ : ∀ (U : 𝒟) (τ : Quiver.Hom T (B.obj U)),
            Quiver.Hom (ℋ.obj.obj (Opposite.op U)) M),
        (∀ {U V : 𝒟} (v : Quiver.Hom V U) (τ : Quiver.Hom T (B.obj V)),
          CategoryTheory.CategoryStruct.comp (ℋ.obj.map (Opposite.op v)) (φ V τ) =
            φ U (CategoryTheory.CategoryStruct.comp τ (B.map v))) →
        (∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
            (γ : Quiver.Hom ℋ ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
              B AddCommGrpCat.{u} _ K J hc).obj 𝒢)),
          γ = 0) →
        ∀ (U : 𝒟) (τ : Quiver.Hom T (B.obj U)), φ U τ = 0) := by
    intro 𝒞 _ J _ _ T hT hSecMem hTermCov
    let L := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    
    let ε_const : ∀ (P : CategoryTheory.Functor (Opposite 𝒞) AddCommGrpCat.{u}),
        ((CategoryTheory.Functor.const (Opposite 𝒞)).obj (P.obj (Opposite.op T)) ⟶ P) :=
      fun P =>
        { app := fun X => P.map (hT.from (Opposite.unop X)).op
          naturality := fun {X₁ X₂} u => by
            dsimp
            rw [CategoryTheory.Category.id_comp, ← P.map_comp]
            congr 1
            apply Quiver.Hom.unop_inj
            exact hT.hom_ext _ _ }
    have hIso_ε : ∀ (P : CategoryTheory.Functor (Opposite 𝒞) AddCommGrpCat.{u}),
        CategoryTheory.IsIso (L.map (ε_const P)) := by
      intro P
      rw [← CategoryTheory.GrothendieckTopology.W_iff,
        CategoryTheory.GrothendieckTopology.W_iff_isLocallyBijective]
      refine ⟨?_, ?_⟩
      · refine CategoryTheory.Presheaf.IsLocallyInjective.mk (fun {X} m₁ m₂ hm => ?_)
        let E := Opposite.unop X
        rcases (hTermCov E).1 with hNe | hBot
        · obtain ⟨τ⟩ := hNe
          have hm_eq : m₁ = m₂ := by
            have h1 := congrArg (fun x => (P.map τ.op).hom x) hm
            change ((ε_const P).app (Opposite.op E) ≫ P.map τ.op).hom m₁ =
              ((ε_const P).app (Opposite.op E) ≫ P.map τ.op).hom m₂ at h1
            have hcomp : (ε_const P).app (Opposite.op E) ≫ P.map τ.op = 𝟙 _ := by
              change P.map (hT.from E).op ≫ P.map τ.op = 𝟙 _
              rw [← P.map_comp, ← op_comp, hT.hom_ext (τ ≫ hT.from E) (𝟙 T), op_id, P.map_id]
            rwa [hcomp, AddCommGrpCat.hom_id, AddMonoidHom.id_apply, AddMonoidHom.id_apply] at h1
          subst hm_eq
          refine J.superset_covering ?_ (J.top_mem E)
          intro Y f _
          rfl
        · exact J.superset_covering bot_le hBot
      · refine CategoryTheory.Presheaf.IsLocallySurjective.mk (fun {E} z => ?_)
        refine J.superset_covering ?_ (hTermCov E).2
        intro W g hg
        rcases hg with ⟨Z, u, s_arr, ⟨τ⟩, rfl⟩
        refine ⟨(P.map τ.op).hom z, ?_⟩
        change (P.map τ.op ≫ P.map (hT.from W).op).hom z = (P.map (u ≫ τ).op).hom z
        rw [← P.map_comp, ← op_comp, hT.hom_ext u (hT.from W)]
    
    let SkyPre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite 𝒞) AddCommGrpCat.{u} :=
      fun M =>
        { obj := fun W => AddCommGrpCat.of ((T ⟶ Opposite.unop W) → ↥M)
          map := fun {W₁ W₂} u => AddCommGrpCat.ofHom
            { toFun := fun g τ => g (τ ≫ u.unop)
              map_zero' := rfl
              map_add' := fun _ _ => rfl }
          map_id := fun W => by
            ext g τ
            change g (τ ≫ 𝟙 _) = g τ
            rw [CategoryTheory.Category.comp_id]
          map_comp := fun {W₁ W₂ W₃} u v => by
            ext g τ
            change g (τ ≫ (v.unop ≫ u.unop)) = g ((τ ≫ v.unop) ≫ u.unop)
            rw [CategoryTheory.Category.assoc] }
    have hSkySheaf : ∀ (M : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf J (SkyPre M) := by
      intro M E₀ W R hR x hx
      let amalg : E₀ ⟶ (SkyPre M).obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := fun e τ => ((x τ (hSecMem W R hR τ)).hom e) (𝟙 T)
            map_zero' := by
              funext τ
              change ((x τ (hSecMem W R hR τ)).hom 0) (𝟙 T) = 0
              rw [map_zero]
              rfl
            map_add' := fun e₁ e₂ => by
              funext τ
              change ((x τ (hSecMem W R hR τ)).hom (e₁ + e₂)) (𝟙 T) =
                ((x τ (hSecMem W R hR τ)).hom e₁) (𝟙 T) +
                  ((x τ (hSecMem W R hR τ)).hom e₂) (𝟙 T)
              rw [map_add]
              rfl }
      refine ⟨amalg, ?_, ?_⟩
      · intro V f hf
        apply AddCommGrpCat.ext
        intro e
        funext σ
        have hcomp := hx (𝟙 T) σ (hSecMem W R hR (σ ≫ f)) hf (CategoryTheory.Category.id_comp _)
        have hval := congrArg (fun k : E₀ ⟶ (SkyPre M).obj (Opposite.op T) => (k.hom e) (𝟙 T)) hcomp
        change ((x (σ ≫ f) (hSecMem W R hR (σ ≫ f))).hom e) (𝟙 T ≫ 𝟙 T) =
          ((x f hf).hom e) (𝟙 T ≫ σ) at hval
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp] at hval
        exact hval
      · intro y hy
        apply AddCommGrpCat.ext
        intro e
        funext τ
        have hyτ := hy τ (hSecMem W R hR τ)
        have hval := congrArg (fun k : E₀ ⟶ (SkyPre M).obj (Opposite.op T) => (k.hom e) (𝟙 T)) hyτ
        change (y.hom e) (𝟙 T ≫ τ) = ((x τ (hSecMem W R hR τ)).hom e) (𝟙 T) at hval
        rwa [CategoryTheory.Category.id_comp] at hval
    let SkyObj : AddCommGrpCat.{u} → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      fun M => ⟨SkyPre M, hSkySheaf M⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · 
      intro Q hSub
      let P₀ := (CategoryTheory.Functor.const (Opposite 𝒞)).obj (Q.obj (Opposite.op T))
      have hZero_P₀ : CategoryTheory.Limits.IsZero P₀ := by
