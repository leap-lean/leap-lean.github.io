      intro Y _ _ U hUo hUne
      by_contra hne
      have hc_ne : (Set.univ ∩ (closure U)ᶜ).Nonempty := by
        rw [Set.univ_inter, Set.nonempty_compl]
        exact hne
      have hU_ne : (Set.univ ∩ U).Nonempty := by rwa [Set.univ_inter]
      obtain ⟨y, -, hyc, hyU⟩ :=
        (IrreducibleSpace.isIrreducible_univ (X := Y)).2 (closure U)ᶜ U
          isClosed_closure.isOpen_compl hUo hc_ne hU_ne
      exact hyc (subset_closure hyU)
    have hex_x₀ : ∃ x₀ : ↥X, closure ({x₀} : Set ↥X) ≠ Set.univ := by
      by_contra h_all
      push Not at h_all
      let instTopX : OrderTop (TopologicalSpace.IrreducibleCloseds ↥X) :=
        { top := ⟨Set.univ, IrreducibleSpace.isIrreducible_univ (X := ↥X), isClosed_univ⟩
          le_top := fun S => Set.subset_univ S.1 }
      have h_eq_univ : ∀ S : TopologicalSpace.IrreducibleCloseds ↥X,
          (S : Set ↥X) = Set.univ := fun S => by
        obtain ⟨x, hx⟩ := S.2.1
        refine Set.Subset.antisymm (Set.subset_univ _) ?_
        rw [← h_all x]
        exact S.3.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hx)
      have hSubIC : Subsingleton (TopologicalSpace.IrreducibleCloseds ↥X) :=
        ⟨fun S₁ S₂ => SetLike.ext' ((h_eq_univ S₁).trans (h_eq_univ S₂).symm)⟩
      have hDim0 : topologicalKrullDim X = (0 : WithBot ℕ∞) :=
        (@Order.krullDim_eq_zero_iff_of_orderTop _ _ instTopX).mpr hSubIC
      rw [hDimX] at hDim0
      exact absurd hDim0 (by decide)
    obtain ⟨x₀, hx₀_cl⟩ := hex_x₀
    obtain ⟨V, hV, hx₀_V, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Z.Opens))
        (x := f.base x₀) trivial
    let W : X.Opens := (TopologicalSpace.Opens.map f.base).obj V
    have hW : AlgebraicGeometry.IsAffineOpen W :=
      AlgebraicGeometry.IsAffineHom.isAffine_preimage V hV
    have hx₀_W : x₀ ∈ W := hx₀_V
    have : Nonempty ↥V.toScheme := ⟨⟨f.base x₀, hx₀_V⟩⟩
    have : Nonempty ↥W.toScheme := ⟨⟨x₀, hx₀_W⟩⟩
    let R := Z.presheaf.obj (Opposite.op V)
    let S := X.presheaf.obj (Opposite.op W)
    have : IsDomain ↑R :=
      (V.topIso.commRingCatIsoToRingEquiv).symm.toMulEquiv.isDomain
        ↑(V.toScheme.presheaf.obj (Opposite.op (⊤ : V.toScheme.Opens)))
    have : IsDomain ↑S :=
      (W.topIso.commRingCatIsoToRingEquiv).symm.toMulEquiv.isDomain
        ↑(W.toScheme.presheaf.obj (Opposite.op (⊤ : W.toScheme.Opens)))
    have : AlgebraicGeometry.IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsOpenImmersion hW.fromSpec := hW.isOpenImmersion_fromSpec
    let p_x : PrimeSpectrum ↑S := hW.primeIdealOf ⟨x₀, hx₀_W⟩
    have hp_ne_bot : p_x.asIdeal ≠ ⊥ := by
      intro hp_bot
      apply hx₀_cl
      have hW_sub : (W : Set ↥X) ⊆ closure ({x₀} : Set ↥X) := by
        intro y hy
        let p_y : PrimeSpectrum ↑S := hW.primeIdealOf ⟨y, hy⟩
        have hmem_sp : p_y ∈ closure ({p_x} : Set (PrimeSpectrum ↑S)) := by
          rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus, hp_bot]
          exact Set.Subset.trans (by simp) (zero_mem p_y.asIdeal |> Set.singleton_subset_iff.mpr)
        have himg := image_closure_subset_closure_image hW.fromSpec.continuous
          (Set.mem_image_of_mem (hW.fromSpec : PrimeSpectrum ↑S → ↥X) hmem_sp)
        have hsub_img : (hW.fromSpec : PrimeSpectrum ↑S → ↥X) '' {p_x} ⊆ ({x₀} : Set ↥X) := by
          rintro _ ⟨q, hq, rfl⟩
          rw [Set.mem_singleton_iff.mp hq, Set.mem_singleton_iff]
          exact hW.fromSpec_primeIdealOf ⟨x₀, hx₀_W⟩
        have hy_cl := closure_mono hsub_img himg
        rwa [hW.fromSpec_primeIdealOf ⟨y, hy⟩] at hy_cl
      refine Set.Subset.antisymm (Set.subset_univ _) ?_
      rw [← hDenseOpen W.isOpen ⟨x₀, hx₀_W⟩]
      exact isClosed_closure.closure_subset_iff.mpr hW_sub
    have hex_s₀ : ∃ s₀ ∈ p_x.asIdeal, s₀ ≠ 0 := by
      by_contra h_all0
      push Not at h_all0
      apply hp_ne_bot
      ext s
      simp only [Ideal.mem_bot]
      exact ⟨fun hs => h_all0 s hs, fun hs => hs.symm ▸ p_x.asIdeal.zero_mem⟩
    obtain ⟨s₀, hs₀_mem, hs₀_ne⟩ := hex_s₀
    let φ_mor : R ⟶ S := f.app V
    let φ : ↑R →+* ↑S := φ_mor.hom
    let _instAlgRS : Algebra ↑R ↑S := φ.toAlgebra
    have hφ_int : φ.IsIntegral :=
      RingHom.Finite.to_isIntegral (AlgebraicGeometry.Scheme.Hom.finite_app f V hV)
    have hs₀_int : @IsIntegral ↑R ↑S _ _ _instAlgRS s₀ := hφ_int s₀
    have hs₀_sdiff : s₀ ∈ (p_x.asIdeal : Set ↑S) \ ((⊥ : Ideal ↑S) : Set ↑S) :=
      ⟨hs₀_mem, fun h0 => hs₀_ne ((Ideal.mem_bot (R := ↑S)).mp h0)⟩
    have hq_lt : Ideal.comap φ ⊥ < Ideal.comap φ p_x.asIdeal :=
      @Ideal.under_lt_under_of_integral_mem_sdiff ↑R _ ↑S _ ⊥ p_x.asIdeal _instAlgRS
        Ideal.isPrime_bot bot_le s₀ hs₀_sdiff hs₀_int
    have hq0_eq : Ideal.comap φ ⊥ = (⊥ : Ideal ↑R) := by
      by_contra hq0_ne
      let q₀ : PrimeSpectrum ↑R := ⟨⊥, Ideal.isPrime_bot⟩
      let q₁ : PrimeSpectrum ↑R := ⟨Ideal.comap φ ⊥, Ideal.IsPrime.comap φ⟩
      let q₂ : PrimeSpectrum ↑R := ⟨Ideal.comap φ p_x.asIdeal, Ideal.IsPrime.comap φ⟩
      have h01 : q₀.asIdeal < q₁.asIdeal := bot_lt_iff_ne_bot.mpr hq0_ne
      have h12 : q₁.asIdeal < q₂.asIdeal := hq_lt
      have hEmb : Topology.IsInducing (hV.fromSpec : PrimeSpectrum ↑R → ↥Z) :=
        hV.fromSpec.isOpenEmbedding.isInducing
      have hClosIff : ∀ a b : PrimeSpectrum ↑R,
          hV.fromSpec a ∈ closure ({hV.fromSpec b} : Set ↥Z) ↔
            b.asIdeal ≤ a.asIdeal := by
        intro a b
        have hpre := hEmb.closure_eq_preimage_closure_image ({b} : Set (PrimeSpectrum ↑R))
        have himg_b : closure (⇑hV.fromSpec '' ({b} : Set (PrimeSpectrum ↑R))) =
            closure ({hV.fromSpec b} : Set ↥Z) := by
          congr 1
          ext z
          exact ⟨by rintro ⟨q, hq, rfl⟩; rw [Set.mem_singleton_iff.mp hq]; exact Set.mem_singleton _,
            fun hz => ⟨b, Set.mem_singleton b, hz.symm⟩⟩
        rw [himg_b] at hpre
        have hmem : a ∈ ⇑hV.fromSpec ⁻¹' closure ({hV.fromSpec b} : Set ↥Z) ↔
            a ∈ closure ({b} : Set (PrimeSpectrum ↑R)) :=
          Eq.to_iff (congrArg (a ∈ ·) hpre.symm)
        rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus] at hmem
        exact hmem
      let F_ic : PrimeSpectrum ↑R → TopologicalSpace.IrreducibleCloseds ↥Z := fun p =>
        ⟨closure ({hV.fromSpec p} : Set ↥Z), isIrreducible_singleton.closure, isClosed_closure⟩
      have hF_lt : ∀ {a b : PrimeSpectrum ↑R}, a.asIdeal < b.asIdeal → F_ic b < F_ic a := by
        intro a b hab
        refine lt_of_le_of_ne ?_ ?_
        · exact isClosed_closure.closure_subset_iff.mpr
            (Set.singleton_subset_iff.mpr ((hClosIff b a).mpr hab.le))
        · intro heq
          have h_in : hV.fromSpec a ∈ (F_ic b : Set ↥Z) := by
            rw [heq]
            exact subset_closure (Set.mem_singleton _)
          exact hab.not_ge ((hClosIff a b).mp h_in)
      let ser : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Z) :=
        { length := 2
          toFun := ![F_ic q₂, F_ic q₁, F_ic q₀]
          step := fun i => by
            fin_cases i
            · exact hF_lt h12
            · exact hF_lt h01 }
      have hle2 : ((2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim Z :=
        Order.le_krullDim_iff.mpr ⟨ser, rfl⟩
      rw [hDimZ] at hle2
      exact absurd hle2 (by decide)
    let pS_bot : PrimeSpectrum ↑S := ⟨⊥, Ideal.isPrime_bot⟩
    let pR_bot : PrimeSpectrum ↑R := ⟨⊥, Ideal.isPrime_bot⟩
    have happ_eq : f.appLE V W le_rfl = φ_mor :=
      (AlgebraicGeometry.Scheme.Hom.app_eq_appLE f).symm
    have hSpec_comm :
        AlgebraicGeometry.Spec.map φ_mor ≫ hV.fromSpec = hW.fromSpec ≫ f := by
      rw [← happ_eq]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hV hW le_rfl
    have hSpec_pt : (AlgebraicGeometry.Spec.map φ_mor) pS_bot = pR_bot :=
      PrimeSpectrum.ext hq0_eq
    have hy_mem_range : hV.fromSpec pR_bot ∈ Set.range f := by
      refine ⟨hW.fromSpec pS_bot, ?_⟩
      have hc := congrArg (fun g : AlgebraicGeometry.Spec S ⟶ Z => g pS_bot) hSpec_comm
      have hc1 := AlgebraicGeometry.Scheme.Hom.comp_apply (AlgebraicGeometry.Spec.map φ_mor)
        hV.fromSpec pS_bot
      have hc2 := AlgebraicGeometry.Scheme.Hom.comp_apply hW.fromSpec f pS_bot
      exact (hc2.symm.trans hc.symm).trans (hc1.trans (congrArg hV.fromSpec hSpec_pt))
    have hRange_closed : IsClosed (Set.range f) :=
      (AlgebraicGeometry.Scheme.Hom.isClosedMap f).isClosed_range
    have hV_sub_range : (V : Set ↥Z) ⊆ Set.range f := by
      intro z hz
      let p_z : PrimeSpectrum ↑R := hV.primeIdealOf ⟨z, hz⟩
      have hmem_sp : p_z ∈ closure ({pR_bot} : Set (PrimeSpectrum ↑R)) := by
        rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus]
        exact Set.Subset.trans (by simp [pR_bot]) (zero_mem p_z.asIdeal |> Set.singleton_subset_iff.mpr)
      have himg := image_closure_subset_closure_image hV.fromSpec.continuous
        (Set.mem_image_of_mem (hV.fromSpec : PrimeSpectrum ↑R → ↥Z) hmem_sp)
      have hsub_img : (hV.fromSpec : PrimeSpectrum ↑R → ↥Z) '' {pR_bot} ⊆
          ({hV.fromSpec pR_bot} : Set ↥Z) := by
        rintro _ ⟨q, hq, rfl⟩
        rw [Set.mem_singleton_iff.mp hq]
        exact Set.mem_singleton _
      have hz_cl := closure_mono hsub_img himg
      rw [hV.fromSpec_primeIdealOf ⟨z, hz⟩] at hz_cl
      exact hRange_closed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hy_mem_range) hz_cl
    have hUniv_range : Set.range f = Set.univ := by
      refine Set.Subset.antisymm (Set.subset_univ _) ?_
      rw [← hDenseOpen V.isOpen ⟨f x₀, hx₀_V⟩]
      exact hRange_closed.closure_subset_iff.mpr hV_sub_range
    exact ⟨Set.range_eq_univ.mp hUniv_range⟩

  have hEpiOfPullback : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜] [Abelian 𝒜]
      {P X Y Z : 𝒜} {f₁ : P ⟶ X} {f₂ : P ⟶ Y} {α : X ⟶ Z} {β : Y ⟶ Z},
      IsPullback f₁ f₂ α β → [Epi β] → Epi f₁ := by
    intro 𝒜 _ _ P X Y Z f₁ f₂ α β hpb _
    let ι : P ⟶ Limits.biprod X Y := Limits.biprod.lift f₁ f₂
    let Φ : Limits.biprod X Y ⟶ Z := Limits.biprod.desc α (-β)
    have hιΦ : ι ≫ Φ = 0 := by
      dsimp [ι, Φ]
      rw [Limits.biprod.lift_desc, Preadditive.comp_neg, hpb.w, add_neg_cancel]
    have hLim : Limits.IsLimit (Limits.KernelFork.ofι ι hιΦ) :=
      Limits.KernelFork.IsLimit.ofι ι hιΦ
        (fun {W} k hk =>
          hpb.lift (k ≫ Limits.biprod.fst) (k ≫ Limits.biprod.snd) (by
            have h1 : k ≫ (Limits.biprod.fst ≫ α + Limits.biprod.snd ≫ (-β)) = 0 := by
              simpa [Φ, Limits.biprod.desc_eq] using hk
            rw [Preadditive.comp_add, ← Category.assoc, ← Category.assoc,
              Preadditive.comp_neg, add_neg_eq_zero] at h1
            exact h1))
        (fun {W} k hk => by
          apply Limits.biprod.hom_ext
          · simp [ι]
          · simp [ι])
        (fun {W} k hk m hm => by
          apply hpb.hom_ext
          · have h1 := congrArg (· ≫ Limits.biprod.fst) hm
            simpa [ι] using h1
          · have h2 := congrArg (· ≫ Limits.biprod.snd) hm
            simpa [ι] using h2)
    have hEx : (ShortComplex.mk ι Φ hιΦ).Exact :=
      ShortComplex.exact_of_f_is_kernel (ShortComplex.mk ι Φ hιΦ) hLim
    have hEpiNegβ : Epi (-β) := by
      have heq : -β = (-𝟙 Y) ≫ β := by simp
      rw [heq]
      have : IsIso (-𝟙 Y) := ⟨⟨-𝟙 Y, by simp, by simp⟩⟩
      exact epi_comp (-𝟙 Y) β
    have hEpiΦ : Epi Φ := by
      have hfac : Limits.biprod.inr ≫ Φ = -β := by simp [Φ]
      exact @epi_of_epi_fac _ _ _ _ _ Limits.biprod.inr Φ (-β) hEpiNegβ hfac
    refine ⟨fun {T} g₁ g₂ hg => ?_⟩
    let g : X ⟶ T := g₁ - g₂
    have hfg : f₁ ≫ g = 0 := by simp [g, Preadditive.comp_sub, hg]
    let Ψ : Limits.biprod X Y ⟶ T := Limits.biprod.desc g 0
    have hιΨ : ι ≫ Ψ = 0 := by
      dsimp [ι, Ψ]
      rw [Limits.biprod.lift_desc, hfg, Limits.comp_zero, add_zero]
    let q : Z ⟶ T := @ShortComplex.Exact.desc _ _ _ (ShortComplex.mk ι Φ hιΦ) _ hEx T Ψ hιΨ hEpiΦ
    have hΦq : Φ ≫ q = Ψ :=
      @ShortComplex.Exact.g_desc _ _ _ (ShortComplex.mk ι Φ hιΦ) _ hEx T Ψ hιΨ hEpiΦ
    have hinr : (-β) ≫ q = 0 := by
      calc
        (-β) ≫ q = (Limits.biprod.inr ≫ Φ) ≫ q := by simp [Φ]
        _ = Limits.biprod.inr ≫ Ψ := by rw [Category.assoc, hΦq]
        _ = 0 := by simp [Ψ]
    have hβq : β ≫ q = 0 := by
      rw [Preadditive.neg_comp, neg_eq_zero] at hinr
      exact hinr
    have hq0 : q = 0 := (cancel_epi β).mp (by simpa using hβq)
    have hg0 : g = 0 := by
      calc
        g = Limits.biprod.inl ≫ Ψ := by simp [Ψ]
        _ = Limits.biprod.inl ≫ Φ ≫ q := by rw [← hΦq]
        _ = 0 := by rw [hq0, Limits.comp_zero, Limits.comp_zero]
    exact sub_eq_zero.mp hg0

  have hAbKummerLadder : ∀ {𝒞 𝒟 : Type (u + 1)}
      [Category.{u + 1, u + 1} 𝒞] [Abelian 𝒞] [HasExt.{u} 𝒞] [EnoughInjectives 𝒞]
      [Category.{u + 1, u + 1} 𝒟] [Abelian 𝒟] [HasExt.{u} 𝒟]
      {pb : 𝒟 ⥤ 𝒞} {pf : 𝒞 ⥤ 𝒟} (adj : pb ⊣ pf)
      [pb.Additive] [Limits.PreservesFiniteLimits pb] [Limits.PreservesFiniteColimits pb]
      {Fℤ₁ : 𝒞} {Fℤ₂ : 𝒟} (ιℤ : Fℤ₁ ⟶ pb.obj Fℤ₂)
      {FM₁ G₁ G₁' : 𝒞} {ι₁ : FM₁ ⟶ G₁} {p₁ : G₁ ⟶ G₁'} {h0₁ : ι₁ ≫ p₁ = 0}
      (hSE₁ : (ShortComplex.mk ι₁ p₁ h0₁).ShortExact)
      {FM₂ G₂ G₂' : 𝒟} {ι₂ : FM₂ ⟶ G₂} {p₂ : G₂ ⟶ G₂'} {h0₂ : ι₂ ≫ p₂ = 0}
      (hSE₂ : (ShortComplex.mk ι₂ p₂ h0₂).ShortExact),
      (∀ (I Q : 𝒞) [Injective I] (j : FM₁ ⟶ I) (π_Q : I ⟶ Q) (hjπ : j ≫ π_Q = 0),
        (ShortComplex.mk j π_Q hjπ).ShortExact → Epi (pf.map π_Q)) →
      ∀ (Tr : pf.obj FM₁ ⟶ FM₂) (N_G : pf.obj G₁ ⟶ G₂) (N_G' : pf.obj G₁' ⟶ G₂'),
        Tr ≫ ι₂ = pf.map ι₁ ≫ N_G →
        N_G ≫ p₂ = pf.map p₁ ≫ N_G' →
        ∀ α : Abelian.Ext Fℤ₂ (pf.obj G₁') 1,
          ∃ β : Abelian.Ext Fℤ₂ (pf.obj FM₁) 2,
            (Abelian.Ext.mk₀ (adj.counit.app FM₁)).postcomp Fℤ₁ (Nat.add_zero 2)
              ((Abelian.Ext.mk₀ ιℤ).comp ((pb.mapExtAddHom Fℤ₂ (pf.obj FM₁) 2) β) (Nat.zero_add 2)) =
            ((Abelian.Ext.mk₀ (adj.counit.app G₁')).postcomp Fℤ₁ (Nat.add_zero 1)
              ((Abelian.Ext.mk₀ ιℤ).comp ((pb.mapExtAddHom Fℤ₂ (pf.obj G₁') 1) α) (Nat.zero_add 1))).comp
              hSE₁.extClass (Nat.one_add 1) ∧
            (Abelian.Ext.mk₀ Tr).postcomp Fℤ₂ (Nat.add_zero 2) β =
              (α.comp (Abelian.Ext.mk₀ N_G') (Nat.add_zero 1)).comp
                hSE₂.extClass (Nat.one_add 1) := by
    intro 𝒞 𝒟 _ _ _ _ _ _ _ pb pf adj _ _ _ Fℤ₁ Fℤ₂ ιℤ
      FM₁ G₁ G₁' ι₁ p₁ h0₁ hSE₁ FM₂ G₂ G₂' ι₂ p₂ h0₂ hSE₂
      hEpiCok Tr N_G N_G' hTr hNG α
    have : pf.IsRightAdjoint := adj.isRightAdjoint
    have : pf.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint pf
    have : Mono ι₁ := hSE₁.mono_f
    have : Epi p₁ := hSE₁.epi_g
    let I : 𝒞 := Injective.under FM₁
    let j : FM₁ ⟶ I := Injective.ι FM₁
    let Q : 𝒞 := Limits.cokernel j
    let π_Q : I ⟶ Q := Limits.cokernel.π j
    have hjπ : j ≫ π_Q = 0 := Limits.cokernel.condition j
    have hSE_inj : (ShortComplex.mk j π_Q hjπ).ShortExact :=
      { exact := ShortComplex.exact_cokernel j
        mono_f := (inferInstance : Mono (Injective.ι FM₁))
        epi_g := ⟨fun _ _ hg => Limits.coequalizer.hom_ext (by simpa [π_Q] using hg)⟩ }
    have : Epi (pf.map π_Q) := hEpiCok I Q j π_Q hjπ hSE_inj
    let γ : G₁ ⟶ I := Injective.factorThru j ι₁
    have hγ : ι₁ ≫ γ = j := Injective.comp_factorThru j ι₁
    have hιγπ : ι₁ ≫ (γ ≫ π_Q) = 0 := by rw [← Category.assoc, hγ, hjπ]
    let δ : G₁' ⟶ Q := hSE₁.exact.desc (γ ≫ π_Q) hιγπ
    have hδ : p₁ ≫ δ = γ ≫ π_Q := hSE₁.exact.g_desc (γ ≫ π_Q) hιγπ
    have hUniq : ∀ {W : 𝒞} (m₁ m₂ : W ⟶ G₁),
        m₁ ≫ p₁ = m₂ ≫ p₁ → m₁ ≫ γ = m₂ ≫ γ → m₁ = m₂ := by
      intro W m₁ m₂ hp hγm
      have hd_p : (m₁ - m₂) ≫ p₁ = 0 := by rw [Preadditive.sub_comp, sub_eq_zero]; exact hp
      let a : W ⟶ FM₁ := hSE₁.exact.lift (m₁ - m₂) hd_p
      have ha : a ≫ ι₁ = m₁ - m₂ := hSE₁.exact.lift_f (m₁ - m₂) hd_p
      have haj : a ≫ j = 0 := by
        rw [← hγ, ← Category.assoc, ha, Preadditive.sub_comp, sub_eq_zero]
        exact hγm
      have ha0 : a = 0 := (cancel_mono j).mp (by simpa using haj)
      have hsub0 : m₁ - m₂ = 0 := by rw [← ha, ha0, Limits.zero_comp]
      exact sub_eq_zero.mp hsub0
    have hLiftCone : ∀ s : Limits.PullbackCone δ π_Q,
        ∃ l : s.pt ⟶ G₁, l ≫ p₁ = s.fst ∧ l ≫ γ = s.snd := by
      intro s
      let P₀ := Limits.pullback s.fst p₁
      let pr₁ : P₀ ⟶ s.pt := Limits.pullback.fst s.fst p₁
      let pr₂ : P₀ ⟶ G₁ := Limits.pullback.snd s.fst p₁
      have : Epi pr₁ := hEpiOfPullback (IsPullback.of_hasPullback s.fst p₁)
      let d₀ : P₀ ⟶ I := pr₁ ≫ s.snd - pr₂ ≫ γ
      have hd₀ : d₀ ≫ π_Q = 0 := by
        dsimp [d₀]
        rw [Preadditive.sub_comp, Category.assoc, ← s.condition, ← Category.assoc pr₁,
          Limits.pullback.condition, Category.assoc, hδ, Category.assoc, sub_self]
      let a₀ : P₀ ⟶ FM₁ := hSE_inj.exact.lift d₀ hd₀
      have ha₀ : a₀ ≫ j = d₀ := hSE_inj.exact.lift_f d₀ hd₀
      let l₀ : P₀ ⟶ G₁ := pr₂ + a₀ ≫ ι₁
      have hl₀_p : l₀ ≫ p₁ = pr₁ ≫ s.fst := by
        dsimp [l₀]
        rw [Preadditive.add_comp, Category.assoc, h0₁, Limits.comp_zero, add_zero,
          Limits.pullback.condition.symm]
      have hl₀_γ : l₀ ≫ γ = pr₁ ≫ s.snd := by
        dsimp [l₀]
        rw [Preadditive.add_comp, Category.assoc, hγ, ha₀]
        dsimp [d₀]
        abel
      have hk₀ : Limits.kernel.ι pr₁ ≫ l₀ = 0 :=
        hUniq (Limits.kernel.ι pr₁ ≫ l₀) 0
          (by rw [Category.assoc, hl₀_p, ← Category.assoc, Limits.kernel.condition,
                Limits.zero_comp, Limits.zero_comp])
          (by rw [Category.assoc, hl₀_γ, ← Category.assoc, Limits.kernel.condition,
                Limits.zero_comp, Limits.zero_comp])
      refine ⟨Abelian.epiDesc pr₁ l₀ hk₀, ?_, ?_⟩
      · apply (cancel_epi pr₁).mp
        rw [← Category.assoc, Abelian.comp_epiDesc, hl₀_p]
      · apply (cancel_epi pr₁).mp
        rw [← Category.assoc, Abelian.comp_epiDesc, hl₀_γ]
