      have hy : y ∈ V_j := rfl
      have hg₁ := TopCat.Presheaf.germ_res_apply Y.presheaf
        (CategoryTheory.homOfLE (le_top : V_j ≤ ⊤)) y hy (r_sec r Y πY s)
      have hg₂ := TopCat.Presheaf.germ_res_apply Y.presheaf
        (CategoryTheory.homOfLE (le_top : V_j ≤ ⊤)) y hy (σ_of Y πY (ν r j))
      exact hg₁.symm.trans ((congrArg _ (hr_sec r Y πY s j)).trans hg₂)
    have hr_zero : ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (πY : Quiver.Hom Y S_k),
        r_sec r Y πY 0 = 1 := by
      intro r Y πY
      apply TopCat.Presheaf.section_ext Y.sheaf ⊤
      intro y _
      change (Y.presheaf.germ ⊤ y trivial).hom (r_sec r Y πY 0) =
