  · intro X O₁ O₂ hcov J_X Aℤ' Fℤ_X O₁₂ U₁ U₂ U₁₂ j₁₂_₁ u₁_Fℤ
      F K Q ι₀ π₀ h0 hSE₀ s s₁ f_q hs₁ hfq₁ hfq₂
    let τ₁ : L_sh X U₁₂ ⟶ F := (evalEq X U₁₂ F).symm s
