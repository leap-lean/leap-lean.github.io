            ∀ r : R, (ℱ.obj.map (levelHom U g r).op).hom m = localSec U g r := by
        intro U g
        have hArr := (Presieve.isSheafFor_arrows_iff (P := ℱ.obj ⋙ coyoneda.obj (Opposite.op R_mod))
          (X := levelObj U g) (π := levelHom U g)).mp
          ((Presieve.isSheafFor_iff_generate _).mpr (hℱ_sh _ (hLevelCov U g)))
        obtain ⟨Φ_m, hΦ_m, hΦ_uniq⟩ := hArr (fun r => toHom (localSec U g r)) <| by
          intro r₁ r₂ Z p₁ p₂ hp
          by_cases hZ : Nonempty ↥Z.left
          · obtain ⟨z⟩ := hZ
            have hu : (levelOpen U g r₁).ι.base (p₁.left.base z) =
                (levelOpen U g r₂).ι.base (p₂.left.base z) :=
              congrArg (fun k : Z ⟶ U => k.left.base z) hp
            have hr₁ : g.1 ((levelOpen U g r₁).ι.base (p₁.left.base z)) = r₁ := (p₁.left.base z).2
            have hr₂ : g.1 ((levelOpen U g r₂).ι.base (p₂.left.base z)) = r₂ := (p₂.left.base z).2
            have hreq : r₁ = r₂ := by rw [← hr₁, hu, hr₂]
            subst hreq
            have hp_eq : p₁ = p₂ := by
              apply MorphismProperty.Over.Hom.ext
              apply (cancel_mono (levelOpen U g r₁).ι).mp
              exact congrArg (fun k : Z ⟶ U => k.left) hp
            subst hp_eq
            rfl
          · haveI := hEmpty_sub Z (not_nonempty_iff.mp hZ)
            exact ModuleCat.hom_ext (LinearMap.ext fun _ => Subsingleton.elim _ _)
        refine ⟨Φ_m.hom (1 : R), fun r => ?_, fun m' hm' => ?_⟩
        · have hr_eq : Φ_m ≫ ℱ.obj.map (levelHom U g r).op = toHom (localSec U g r) := hΦ_m r
          have h1 := congrArg (fun f : R_mod ⟶ _ => f.hom (1 : R)) hr_eq
          simpa only [toHom, ModuleCat.hom_comp, ModuleCat.hom_ofHom,
            LinearMap.comp_apply, LinearMap.coe_mk, AddHom.coe_mk, one_smul] using h1
        · have hm'_hom : toHom m' = Φ_m := hΦ_uniq (toHom m') fun r =>
            (toHom_coyoneda (levelHom U g r) m').trans (congrArg toHom (hm' r))
          have h1 := congrArg (fun f : R_mod ⟶ _ => f.hom (1 : R)) hm'_hom
          simpa only [toHom, ModuleCat.hom_ofHom, LinearMap.coe_mk, AddHom.coe_mk, one_smul] using h1
      let ψ_fun (U : S.Etale) (g : ↥(submod U)) : ↥(ℱ.obj.obj (Opposite.op U)) :=
        (hGlued U g).choose
      have hψ_level : ∀ (U : S.Etale) (g : ↥(submod U)) (r : R),
          (ℱ.obj.map (levelHom U g r).op).hom (ψ_fun U g) = localSec U g r :=
        fun U g => (hGlued U g).choose_spec.1
      have hψ_zero_on : ∀ (U : S.Etale) (g : ↥(submod U)) {Y : S.Etale} (f : Y ⟶ U),
          (∀ y : ↥Y.left, g.1 (f.left.base y) = 0) →
          (ℱ.obj.map f.op).hom (ψ_fun U g) = 0 := by
        intro U g Y f hy
        have hsub : Set.range (f.left : Y.left ⟶ U.left).base ⊆ Set.range (levelOpen U g 0).ι.base := by
          rw [hOpensRange]
          rintro _ ⟨y, rfl⟩
          exact hy y
        let l₀ : (Y.left : AlgebraicGeometry.Scheme.{u}) ⟶ (levelOpen U g 0).toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift (levelOpen U g 0).ι (f.left : Y.left ⟶ U.left) hsub
        have hl₀ : l₀ ≫ (levelOpen U g 0).ι = f.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (levelOpen U g 0).ι (f.left : Y.left ⟶ U.left) hsub
        let f₀ : Y ⟶ levelObj U g 0 :=
          MorphismProperty.Over.homMk l₀ <| by
            change l₀ ≫ ((levelOpen U g 0).ι ≫ U.hom) = Y.hom
            rw [← Category.assoc, hl₀, MorphismProperty.Over.w f]
