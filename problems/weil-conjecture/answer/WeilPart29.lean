    let one_s : (pb_s.obj F_B).H 0 :=
      CategoryTheory.Abelian.Ext.mk₀ (C_Sk.map z_to_m₀ ≫ ιM_s)
    have hone_ne : φ_s one_s ≠ 0 := by
      intro h0_s
