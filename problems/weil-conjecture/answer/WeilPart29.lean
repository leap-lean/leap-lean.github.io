  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  have h_sec_clopen : ∀ {X Y : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom X Y) (s : Quiver.Hom Y X),
      CategoryTheory.CategoryStruct.comp s f = CategoryTheory.CategoryStruct.id Y →
      (AlgebraicGeometry.Etale f → AlgebraicGeometry.IsOpenImmersion s) ∧
      (AlgebraicGeometry.IsSeparated f → AlgebraicGeometry.IsClosedImmersion s) := by
    intro X Y f s hs
    refine ⟨?_, ?_⟩
    · intro hf
      have : AlgebraicGeometry.Etale f := hf
      let Δ_f : Quiver.Hom X (CategoryTheory.Limits.pullback f f) :=
        CategoryTheory.Limits.pullback.diagonal f
      have hsq : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id X) f =
          CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f s) f := by
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs,
          CategoryTheory.Category.comp_id]
      let q : Quiver.Hom X (CategoryTheory.Limits.pullback f f) :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.id X)
          (CategoryTheory.CategoryStruct.comp f s) hsq
      have hw : CategoryTheory.CategoryStruct.comp s Δ_f =
          CategoryTheory.CategoryStruct.comp s q := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp only [Δ_f, q]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Limits.pullback.lift_fst]
        · dsimp only [Δ_f, q]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.comp_id,
            ← CategoryTheory.Category.assoc, hs, CategoryTheory.Category.id_comp]
      have hpb_s : CategoryTheory.IsPullback s s Δ_f q := by
        refine CategoryTheory.IsPullback.of_isLimit
          (c := CategoryTheory.Limits.PullbackCone.mk s s hw) ?_
        refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
          (fun c => CategoryTheory.CategoryStruct.comp c.snd f) ?_ ?_ ?_
        · intro c
          have h2 := congrArg (fun m => CategoryTheory.CategoryStruct.comp m
            (CategoryTheory.Limits.pullback.snd f f)) c.condition
          simp only [Δ_f, q, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.comp_id] at h2
          rw [CategoryTheory.Category.assoc]
