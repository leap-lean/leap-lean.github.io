        rw [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
      calc
        (ν (r + 1) c) ^ ℓ = ((ζ (r + 1) : k) ^ ℓ) ^ c.val := by
          dsimp [ν]; rw [← pow_mul, mul_comm, pow_mul]
        _ = (ζ r : k) ^ c.val := by
          rw [← Units.val_pow_eq_pow_val, hζ_pow r]
        _ = (ζ r : k) ^ ((ℓ ^ r) * (c.val / (ℓ ^ r)) + c.val % (ℓ ^ r)) := by
          rw [Nat.div_add_mod]
        _ = (ζ r : k) ^ (c.val % (ℓ ^ r)) := by
          rw [pow_add, pow_mul, (hζ_prim r).pow_eq_one, one_pow, one_mul]
        _ = ν r (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) c) := by
          change (ζ r : k) ^ (c.val % (ℓ ^ r)) =
            (ζ r : k) ^ (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) c).val
          rw [hcast_val]
    let σ_of (Y : AlgebraicGeometry.Scheme.{u}) (πY : Quiver.Hom Y S_k) :
        k →+* ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ πY.appTop).hom
    have hSecGluing : ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (πY : Quiver.Hom Y S_k)
