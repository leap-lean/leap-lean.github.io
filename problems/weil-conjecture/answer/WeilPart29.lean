      have heq_zero : e ≫ q_mor = 0 := by
        apply (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map_injective
        ext ⟨W⟩ s_E
        funext τ
        change π_coker.hom ((X.obj.map τ.op).hom ((e.hom.app (Opposite.op W)).hom s_E)) = 0
        have hnat := (congrArg (fun k => k.hom s_E) (e.hom.naturality τ.op)).symm
        change (X.obj.map τ.op).hom ((e.hom.app (Opposite.op W)).hom s_E) =
          e_T.hom ((E.obj.map τ.op).hom s_E) at hnat
        rw [hnat]
        change (e_T ≫ π_coker).hom ((E.obj.map τ.op).hom s_E) = 0
        rw [CategoryTheory.Limits.cokernel.condition]
        rfl
      have hq_zero : q_mor = 0 := by
