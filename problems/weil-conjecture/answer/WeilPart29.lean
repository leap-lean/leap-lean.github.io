      rw [CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ (Φ_pull.inv.app One_Y))
          (CategoryTheory.Abelian.Ext.mk₀ (Φ_pull.hom.app One_Y))
          (Nat.add_zero p) (Nat.add_zero 0) (Nat.add_zero p),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        Φ_pull.inv_hom_id_app One_Y,
        CategoryTheory.Abelian.Ext.comp_mk₀_id] at hcancel
      exact hcancel
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      hΦ_ext,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    let Z_mid := CategoryTheory.Abelian.Ext.mapExactFunctor U_Z
      (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_mod ξ_m)
    calc
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_pb).comp
          (((CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map ηℤ_Y)).comp
            (((CategoryTheory.Abelian.Ext.mk₀ (Φ_pull.inv.app One_Y)).comp Z_mid
              (Nat.zero_add p)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (Φ_pull.hom.app One_Y)) (Nat.add_zero p))
            (Nat.zero_add p)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map βM_Y)) (Nat.add_zero p))
          (Nat.zero_add p)).comp (CategoryTheory.Abelian.Ext.mk₀ πM_pb) (Nat.add_zero p)
        = ((CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.comp ιℤ_pb
                (CategoryTheory.CategoryStruct.comp (P_pull_ab.map ηℤ_Y)
                  (Φ_pull.inv.app One_Y)))).comp Z_mid (Nat.zero_add p)).comp
            (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.comp (Φ_pull.hom.app One_Y)
                (CategoryTheory.CategoryStruct.comp (P_pull_ab.map βM_Y) πM_pb)))
            (Nat.add_zero p) := by
          rw [hExtConjComp, hExtConjComp, CategoryTheory.Category.assoc]
      _ = ((CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.comp ηℤ_Z (U_Z.map ι_Z_mod))).comp Z_mid
            (Nat.zero_add p)).comp
            (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.comp (U_Z.map π_Z_mod) βM_Z))
            (Nat.add_zero p) := by
          rw [hSqLeft, hSqRight]
      _ = ((CategoryTheory.Abelian.Ext.mk₀ ηℤ_Z).comp
            (((CategoryTheory.Abelian.Ext.mk₀ (U_Z.map ι_Z_mod)).comp Z_mid
              (Nat.zero_add p)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (U_Z.map π_Z_mod)) (Nat.add_zero p))
            (Nat.zero_add p)).comp (CategoryTheory.Abelian.Ext.mk₀ βM_Z) (Nat.add_zero p) :=
          (hExtConjComp ηℤ_Z (U_Z.map ι_Z_mod) (U_Z.map π_Z_mod) βM_Z Z_mid).symm

  
  
  
  obtain ⟨ξ_mod, hξ_mod⟩ := hbij_Yp.2 ξ
  refine ⟨θ_Ypq, γ_mod, ξ_mod, cl_SY_mod, ?_, hcl_SY_eq, ?_⟩
  · rw [hγ_Y_eq, ← hξ_mod, hc_Y_eq γ_mod ξ_mod]
  · let i_star_ξ : weilEtaleModuleH Z m p :=
      ((CategoryTheory.Abelian.Ext.mk₀ ι_Z_mod).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_mod ξ_mod)
        (Nat.zero_add p)).comp (CategoryTheory.Abelian.Ext.mk₀ π_Z_mod) (Nat.add_zero p)
    have hi_star : i_star_ξ = a • cl_Z_mod := by
      apply hbij_Zp.1
      rw [← hp_i_compat ξ_mod, hξ_mod, hξ, hcl_Z_eq, map_nsmul]
    let Add_P_ipush : (P_pull_mod.comp i_push).Additive :=
      { map_add := fun {_ _} f g => by dsimp; rw [P_pull_mod.map_add, i_push.map_add] }
    let Lim_P_ipush : CategoryTheory.Limits.PreservesFiniteLimits (P_pull_mod.comp i_push) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits P_pull_mod i_push
    let Colim_P_ipush : CategoryTheory.Limits.PreservesFiniteColimits (P_pull_mod.comp i_push) :=
      CategoryTheory.Limits.comp_preservesFiniteColimits P_pull_mod i_push
    letI := Add_P_ipush; letI := Lim_P_ipush; letI := Colim_P_ipush
    have hUnitNat := hExtNat
      (CategoryTheory.Functor.id (CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)))
      (P_pull_mod.comp i_push) adj_mod.unit p One_Y One_Y ξ_mod
    rw [hExtId p One_Y One_Y ξ_mod,
      hExtComp P_pull_mod i_push p One_Y One_Y ξ_mod] at hUnitNat
    have hUnitRight := congrArg
      (fun z => z.comp (CategoryTheory.Abelian.Ext.mk₀ (i_push.map π_Z_mod)) (Nat.add_zero p))
      hUnitNat
    have hLHS_qi : (ξ_mod.comp (CategoryTheory.Abelian.Ext.mk₀ (adj_mod.unit.app One_Y))
        (Nat.add_zero p)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (i_push.map π_Z_mod)) (Nat.add_zero p) =
        ξ_mod.comp (CategoryTheory.Abelian.Ext.mk₀ q_i) (Nat.add_zero p) := by
      rw [CategoryTheory.Abelian.Ext.comp_assoc ξ_mod _ _
          (Nat.add_zero p) (Nat.add_zero 0) (Nat.add_zero p),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hunit_π]
    have hRHS_qi : ((CategoryTheory.Abelian.Ext.mk₀ (adj_mod.unit.app One_Y)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor i_push
          (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_mod ξ_mod))
        (Nat.zero_add p)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (i_push.map π_Z_mod)) (Nat.add_zero p) =
        (CategoryTheory.Abelian.Ext.mk₀ q_i).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor i_push i_star_ξ) (Nat.zero_add p) := by
      have hpush_istar : CategoryTheory.Abelian.Ext.mapExactFunctor i_push i_star_ξ =
          ((CategoryTheory.Abelian.Ext.mk₀ (i_push.map ι_Z_mod)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor i_push
              (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_mod ξ_mod))
            (Nat.zero_add p)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (i_push.map π_Z_mod)) (Nat.add_zero p) := by
        dsimp only [i_star_ξ]
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      let z_push := CategoryTheory.Abelian.Ext.mapExactFunctor i_push
        (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_mod ξ_mod)
      exact (congrArg
        (fun u => CategoryTheory.Abelian.Ext.comp
          (CategoryTheory.Abelian.Ext.comp u z_push (Nat.zero_add p))
          (CategoryTheory.Abelian.Ext.mk₀ (i_push.map π_Z_mod)) (Nat.add_zero p))
        ((congrArg CategoryTheory.Abelian.Ext.mk₀ hunit_ι).trans
          (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ q_i (i_push.map ι_Z_mod)).symm)).trans
        ((congrArg
          (fun u => CategoryTheory.Abelian.Ext.comp u
            (CategoryTheory.Abelian.Ext.mk₀ (i_push.map π_Z_mod)) (Nat.add_zero p))
          (CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ q_i)
            (CategoryTheory.Abelian.Ext.mk₀ (i_push.map ι_Z_mod))
            z_push (Nat.zero_add 0) (Nat.zero_add p) (Nat.zero_add p))).trans
          ((CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ q_i)
            ((CategoryTheory.Abelian.Ext.mk₀ (i_push.map ι_Z_mod)).comp z_push (Nat.zero_add p))
            (CategoryTheory.Abelian.Ext.mk₀ (i_push.map π_Z_mod))
            (Nat.zero_add p) (Nat.add_zero p) (by omega)).trans
            (congrArg (fun w => CategoryTheory.Abelian.Ext.comp
                (CategoryTheory.Abelian.Ext.mk₀ q_i) w (Nat.zero_add p))
              hpush_istar.symm)))
    rw [hLHS_qi, hRHS_qi, hi_star] at hUnitRight
    have h_nsmul_push : CategoryTheory.Abelian.Ext.mapExactFunctor i_push (a • cl_Z_mod) =
        a • CategoryTheory.Abelian.Ext.mapExactFunctor i_push cl_Z_mod :=
      map_nsmul (i_push.mapExtAddHom One_Z One_Z p) a cl_Z_mod
    have h_nsmul_pre : (CategoryTheory.Abelian.Ext.mk₀ q_i).comp
        (a • CategoryTheory.Abelian.Ext.mapExactFunctor i_push cl_Z_mod) (Nat.zero_add p) =
        a • ((CategoryTheory.Abelian.Ext.mk₀ q_i).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor i_push cl_Z_mod) (Nat.zero_add p)) :=
      map_nsmul ((CategoryTheory.Abelian.Ext.mk₀ q_i).precomp
        (i_push.obj One_Z) (Nat.zero_add p)) a _
    rw [h_nsmul_push, h_nsmul_pre] at hUnitRight
    have hFinal := congrArg
      (fun z => CategoryTheory.Abelian.Ext.comp z τ_Y.val hpq) hUnitRight
    have hLHS_fin : (ξ_mod.comp (CategoryTheory.Abelian.Ext.mk₀ q_i) (Nat.add_zero p)).comp
        τ_Y.val hpq = ξ_mod.comp γ_mod hpq :=
      CategoryTheory.Abelian.Ext.comp_assoc ξ_mod (CategoryTheory.Abelian.Ext.mk₀ q_i) τ_Y.val
        (Nat.add_zero p) (Nat.zero_add q) hpq
    have h_nsmul_post : (a • ((CategoryTheory.Abelian.Ext.mk₀ q_i).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor i_push cl_Z_mod) (Nat.zero_add p))).comp
        τ_Y.val hpq =
        a • (((CategoryTheory.Abelian.Ext.mk₀ q_i).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor i_push cl_Z_mod) (Nat.zero_add p)).comp
          τ_Y.val hpq) :=
      map_nsmul (τ_Y.val.postcomp One_Y hpq) a _
    have hMapCompMk₀ : ∀ {𝒞 𝒟 : Type (u + 1)}
        [CategoryTheory.Category.{u + 1} 𝒞] [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        [CategoryTheory.Category.{u + 1} 𝒟] [CategoryTheory.Abelian 𝒟] [CategoryTheory.HasExt.{u} 𝒟]
        (G : CategoryTheory.Functor 𝒞 𝒟) [G.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        {X₁ X₂ X₃ : 𝒞} (f : Quiver.Hom X₁ X₂) (y : CategoryTheory.Abelian.Ext.{u} X₂ X₃ p),
        CategoryTheory.Abelian.Ext.mapExactFunctor G
          ((CategoryTheory.Abelian.Ext.mk₀ f).comp y (Nat.zero_add p)) =
        (CategoryTheory.Abelian.Ext.mk₀ (G.map f)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G y) (Nat.zero_add p) := by
      intro 𝒞 𝒟 _ _ _ _ _ _ G _ _ _ X₁ X₂ X₃ f y
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    have hInner : (((CategoryTheory.Abelian.Ext.mk₀ q_i).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor i_push cl_Z_mod) (Nat.zero_add p)).comp
        τ_Y.val hpq) = cl_SY_mod :=
      (congrArg
        (fun w => CategoryTheory.Abelian.Ext.comp
          (CategoryTheory.Abelian.Ext.comp (CategoryTheory.Abelian.Ext.mk₀ q_i) w (Nat.zero_add p))
          τ_Y.val hpq)
        (hMapCompMk₀ i_push q_s τ_Z.val)).trans
        ((congrArg (fun u => CategoryTheory.Abelian.Ext.comp u τ_Y.val hpq)
          ((CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ q_i)
            (CategoryTheory.Abelian.Ext.mk₀ (i_push.map q_s))
            (CategoryTheory.Abelian.Ext.mapExactFunctor i_push τ_Z.val)
            (Nat.add_zero 0) (Nat.zero_add p) (Nat.zero_add p)).symm.trans
            ((congrArg
              (fun k => CategoryTheory.Abelian.Ext.comp k
                (CategoryTheory.Abelian.Ext.mapExactFunctor i_push τ_Z.val)
                (Nat.zero_add p))
              ((CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ q_i (i_push.map q_s)).trans
                ((congrArg CategoryTheory.Abelian.Ext.mk₀ hq_si_comp.symm).trans
                  (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ q_si α_push).symm))).trans
              (CategoryTheory.Abelian.Ext.comp_assoc
                (CategoryTheory.Abelian.Ext.mk₀ q_si)
                (CategoryTheory.Abelian.Ext.mk₀ α_push)
                (CategoryTheory.Abelian.Ext.mapExactFunctor i_push τ_Z.val)
                (Nat.add_zero 0) (Nat.zero_add p) (Nat.zero_add p))))).trans
          ((CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ q_si)
            ((CategoryTheory.Abelian.Ext.mk₀ α_push).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor i_push τ_Z.val) (Nat.zero_add p))
            τ_Y.val (Nat.zero_add p) hpq (by omega)).trans
            (congrArg
              (fun t => CategoryTheory.Abelian.Ext.comp
                (CategoryTheory.Abelian.Ext.mk₀ q_si) t (Nat.zero_add pq))
              hτ_SY_eq.symm)))
    exact hLHS_fin.symm.trans
      (hFinal.trans (h_nsmul_post.trans
        (congrArg (fun (t : weilEtaleModuleH Y m pq) => a • t) hInner)))

theorem weil_gysin_abelian_bifunctor_koszul_interchange (𝒜 : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} 𝒜]
    [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
    [CategoryTheory.EnoughInjectives 𝒜]
    (T : CategoryTheory.Functor 𝒜 (CategoryTheory.Functor 𝒜 𝒜))
    [∀ X : 𝒜, (T.obj X).Additive]
    [∀ X : 𝒜, CategoryTheory.Limits.PreservesFiniteColimits (T.obj X)]
    [∀ Y : 𝒜, (T.flip.obj Y).Additive]
    [∀ Y : 𝒜, CategoryTheory.Limits.PreservesFiniteColimits (T.flip.obj Y)]
    (hCovers : ∀ Z : 𝒜, ∃ (P : 𝒜) (π : Quiver.Hom P Z),
      CategoryTheory.Epi π ∧
      CategoryTheory.Limits.PreservesFiniteLimits (T.obj P) ∧
      CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj P))
    (X₁ Y₁ X₂ Y₂ : 𝒜)
    [CategoryTheory.Limits.PreservesFiniteLimits (T.obj X₁)]
    [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj X₁)]
    [CategoryTheory.Limits.PreservesFiniteLimits (T.obj Y₁)]
    [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj Y₁)]
    [CategoryTheory.Limits.PreservesFiniteLimits (T.obj X₂)]
    [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj X₂)]
    [CategoryTheory.Limits.PreservesFiniteLimits (T.obj Y₂)]
    [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj Y₂)]
    (p q r : ℕ) (hpq : p + q = r) (hqp : q + p = r)
    (α : CategoryTheory.Abelian.Ext.{u} X₁ Y₁ p)
    (β : CategoryTheory.Abelian.Ext.{u} X₂ Y₂ q) :
    (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj X₂) α).comp
      (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj Y₁) β) hpq =
    ((-1 : ℤ) ^ (p * q)) •
      ((CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj X₁) β).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj Y₂) α) hqp) :=
by
  have hzsmul_comp : ∀ {A B C : 𝒜} {a b c : ℕ} (h : a + b = c) (k : ℤ)
      (x : CategoryTheory.Abelian.Ext.{u} A B a)
      (y : CategoryTheory.Abelian.Ext.{u} B C b),
      (k • x).comp y h = k • (x.comp y h) := by
    intro A B C a b c h k x y
    exact map_zsmul (y.postcomp A h) k x
  have hcomp_zsmul : ∀ {A B C : 𝒜} {a b c : ℕ} (h : a + b = c) (k : ℤ)
      (x : CategoryTheory.Abelian.Ext.{u} A B a)
      (y : CategoryTheory.Abelian.Ext.{u} B C b),
      x.comp (k • y) h = k • (x.comp y h) := by
    intro A B C a b c h k x y
    exact map_zsmul (x.precomp C h) k y

  have hNatTransComm : ∀ (F G : CategoryTheory.Functor 𝒜 𝒜)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (τ : CategoryTheory.NatTrans F G)
      (n : ℕ) (A B : 𝒜) (ξ : CategoryTheory.Abelian.Ext.{u} A B n),
      (CategoryTheory.Abelian.Ext.mk₀ (τ.app A)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor G ξ) (Nat.zero_add n) =
      (CategoryTheory.Abelian.Ext.mapExactFunctor F ξ).comp
        (CategoryTheory.Abelian.Ext.mk₀ (τ.app B)) (Nat.add_zero n) := by
    intro F G _ _ _ _ _ _ τ n
    induction n with
    | zero =>
      intro A B ξ
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A B).2 ξ
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact congrArg CategoryTheory.Abelian.Ext.mk₀ (τ.naturality f).symm
    | succ n' ih =>
      intro A B ξ
      let I := CategoryTheory.Injective.under B
      let ι : B ⟶ I := CategoryTheory.Injective.ι B
      let S := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hSub : Subsingleton (CategoryTheory.Abelian.Ext.{u} A I (n' + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton I 1 (n' + 1)
          (Nat.succ_le_succ (Nat.zero_le n')) A
      have h0 : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (n' + 1)) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨δ, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS ξ h0 rfl
      have hSF : (S.map F).ShortExact := hS.map_of_exact F
      have hSG : (S.map G).ShortExact := hS.map_of_exact G
      let φ_S : S.map F ⟶ S.map G :=
        { τ₁ := τ.app S.X₁
          τ₂ := τ.app S.X₂
          τ₃ := τ.app S.X₃
          comm₁₂ := (τ.naturality S.f).symm
          comm₂₃ := (τ.naturality S.g).symm }
      have hNatExt : hSF.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (τ.app B))
          (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app S.X₃)).comp hSG.extClass
            (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSF hSG φ_S
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor F δ) hSF.extClass
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app B))
          rfl (Nat.add_zero 1) (by omega),
        hNatExt,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor F δ)
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app S.X₃))
          hSG.extClass (Nat.add_zero n') (Nat.zero_add 1) (by omega),
        ← ih A S.X₃ δ,
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app A))
          (CategoryTheory.Abelian.Ext.mapExactFunctor G δ)
          hSG.extClass (Nat.zero_add n') rfl (by omega)]

  have hRightExact : ∀ (F : CategoryTheory.Functor 𝒜 𝒜) [F.Additive]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      (S : CategoryTheory.ShortComplex 𝒜),
      S.ShortExact → (S.map F).Exact ∧ CategoryTheory.Epi (F.map S.g) := by
    intro F _ hColim S hS
    have hiff : CategoryTheory.Limits.PreservesFiniteColimits F ↔
        ∀ (S₀ : CategoryTheory.ShortComplex 𝒜),
          S₀.ShortExact → (S₀.map F).Exact ∧ CategoryTheory.Epi (F.map S₀.g) :=
      (CategoryTheory.Functor.preservesFiniteColimits_tfae F).out 4 1
    exact hiff.mp hColim S hS

  have hBiexactKer : ∀ (B : CategoryTheory.Functor 𝒜 (CategoryTheory.Functor 𝒜 𝒜))
      [∀ A : 𝒜, (B.obj A).Additive]
      [∀ A : 𝒜, CategoryTheory.Limits.PreservesFiniteColimits (B.obj A)]
      [∀ A : 𝒜, (B.flip.obj A).Additive]
      [∀ A : 𝒜, CategoryTheory.Limits.PreservesFiniteColimits (B.flip.obj A)]
      (hCovB : ∀ Z : 𝒜, ∃ (Q : 𝒜) (ε : Q ⟶ Z),
        CategoryTheory.Epi ε ∧
        CategoryTheory.Limits.PreservesFiniteLimits (B.obj Q) ∧
        CategoryTheory.Limits.PreservesFiniteLimits (B.flip.obj Q))
      {K P X : 𝒜} {i : K ⟶ P} {π : P ⟶ X} (hz : i ≫ π = 0)
      (hS : (CategoryTheory.ShortComplex.mk i π hz).ShortExact)
      [CategoryTheory.Limits.PreservesFiniteLimits (B.obj P)]
      [CategoryTheory.Limits.PreservesFiniteLimits (B.obj X)],
      CategoryTheory.Limits.PreservesFiniteLimits (B.obj K) := by
    intro B _ _ _ _ hCovB K P X i π hz hS _ _
    have hMonoFlip : ∀ G : 𝒜, CategoryTheory.Mono ((B.flip.obj G).map i) := by
      intro G
      obtain ⟨Q, ε, hε_epi, hQ_L, hQ_R⟩ := hCovB G
      have : CategoryTheory.Epi ε := hε_epi
      have : CategoryTheory.Limits.PreservesFiniteLimits (B.obj Q) := hQ_L
      have : CategoryTheory.Limits.PreservesFiniteLimits (B.flip.obj Q) := hQ_R
      let H := CategoryTheory.Limits.kernel ε
      let j : H ⟶ Q := CategoryTheory.Limits.kernel.ι ε
      let S_G := CategoryTheory.ShortComplex.mk j ε (CategoryTheory.Limits.kernel.condition ε)
      have hSG : S_G.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_kernel ε) inferInstance inferInstance
      have hBK_ε : CategoryTheory.Epi ((B.obj K).map ε) := (hRightExact (B.obj K) S_G hSG).2
      have hSG_P : (S_G.map (B.obj P)).ShortExact := hSG.map_of_exact (B.obj P)
      have hSG_X : (S_G.map (B.obj X)).ShortExact := hSG.map_of_exact (B.obj X)
      have hMono_BX_j : CategoryTheory.Mono ((B.obj X).map j) := hSG_X.mono_f
      have hExact_SH : ((CategoryTheory.ShortComplex.mk i π hz).map (B.flip.obj H)).Exact :=
        (hRightExact (B.flip.obj H) _ hS).1
      have hS_Q : ((CategoryTheory.ShortComplex.mk i π hz).map (B.flip.obj Q)).ShortExact :=
        hS.map_of_exact (B.flip.obj Q)
      have hMono_BQ_i : CategoryTheory.Mono ((B.flip.obj Q).map i) := hS_Q.mono_f
      rw [CategoryTheory.Preadditive.mono_iff_cancel_zero]
      intro W z hz0
      let W₁ := CategoryTheory.Limits.pullback z ((B.obj K).map ε)
      let e₁ : W₁ ⟶ W := CategoryTheory.Limits.pullback.fst z ((B.obj K).map ε)
      let y : W₁ ⟶ (B.obj K).obj Q := CategoryTheory.Limits.pullback.snd z ((B.obj K).map ε)
      have he₁_epi : CategoryTheory.Epi e₁ :=
        CategoryTheory.Abelian.epi_pullback_of_epi_g z ((B.obj K).map ε)
      have hpb₁ : e₁ ≫ z = y ≫ (B.obj K).map ε := CategoryTheory.Limits.pullback.condition
      have hy_ker : (y ≫ (B.flip.obj Q).map i) ≫ (B.obj P).map ε = 0 := by
        have hnat1 : (B.flip.obj Q).map i ≫ (B.obj P).map ε =
            (B.obj K).map ε ≫ (B.flip.obj G).map i :=
          ((B.map i).naturality ε).symm
        rw [CategoryTheory.Category.assoc, hnat1, ← CategoryTheory.Category.assoc,
          ← hpb₁, CategoryTheory.Category.assoc, hz0, CategoryTheory.Limits.comp_zero]
      obtain ⟨x, hx⟩ :=
        CategoryTheory.Limits.KernelFork.IsLimit.lift' hSG_P.fIsKernel
          (y ≫ (B.flip.obj Q).map i) hy_ker
      change x ≫ (B.obj P).map j = y ≫ (B.flip.obj Q).map i at hx
      have hx_π : x ≫ (B.flip.obj H).map π = 0 := by
        apply (CategoryTheory.cancel_mono ((B.obj X).map j)).mp
        have hnat2 : (B.flip.obj H).map π ≫ (B.obj X).map j =
            (B.obj P).map j ≫ (B.flip.obj Q).map π :=
          ((B.map π).naturality j).symm
        rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.assoc, hnat2,
          ← CategoryTheory.Category.assoc, hx, CategoryTheory.Category.assoc,
          ← (B.flip.obj Q).map_comp, hz, (B.flip.obj Q).map_zero,
          CategoryTheory.Limits.comp_zero]
      obtain ⟨W₂, e₂, he₂_epi, w, hw⟩ := hExact_SH.exact_up_to_refinements x hx_π
      have : CategoryTheory.Epi e₂ := he₂_epi
      change e₂ ≫ x = w ≫ (B.flip.obj H).map i at hw
      have hw_j : w ≫ (B.obj K).map j = e₂ ≫ y := by
        apply (CategoryTheory.cancel_mono ((B.flip.obj Q).map i)).mp
        have hnat3 : (B.obj K).map j ≫ (B.flip.obj Q).map i =
            (B.flip.obj H).map i ≫ (B.obj P).map j :=
          (B.map i).naturality j
        rw [CategoryTheory.Category.assoc, hnat3, ← CategoryTheory.Category.assoc,
          ← hw, CategoryTheory.Category.assoc, hx, CategoryTheory.Category.assoc]
      have he₂₁_epi : CategoryTheory.Epi (e₂ ≫ e₁) := CategoryTheory.epi_comp e₂ e₁
      apply (CategoryTheory.cancel_epi (e₂ ≫ e₁)).mp
      rw [CategoryTheory.Limits.comp_zero, CategoryTheory.Category.assoc, hpb₁,
        ← CategoryTheory.Category.assoc, ← hw_j, CategoryTheory.Category.assoc,
        ← (B.obj K).map_comp, CategoryTheory.Limits.kernel.condition ε,
        (B.obj K).map_zero, CategoryTheory.Limits.comp_zero]
    rw [CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono]
    intro S_test hSt
    refine ⟨(hRightExact (B.obj K) S_test hSt).1, ?_⟩
    have hMono_BP : CategoryTheory.Mono ((B.obj P).map S_test.f) :=
      (hSt.map_of_exact (B.obj P)).mono_f
    have hMono_flip : CategoryTheory.Mono ((B.flip.obj S_test.X₁).map i) :=
      hMonoFlip S_test.X₁
    have hMono_rhs :
        CategoryTheory.Mono (((B.flip.obj S_test.X₁).map i) ≫ ((B.obj P).map S_test.f)) :=
      CategoryTheory.mono_comp _ _
    have hfac : ((B.obj K).map S_test.f) ≫ ((B.flip.obj S_test.X₂).map i) =
        ((B.flip.obj S_test.X₁).map i) ≫ ((B.obj P).map S_test.f) :=
      (B.map i).naturality S_test.f
    exact CategoryTheory.mono_of_mono_fac hfac

  have hSyzygyFact : ∀ (X Y : 𝒜)
      [CategoryTheory.Limits.PreservesFiniteLimits (T.obj X)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj X)]
      (n : ℕ) (ξ : CategoryTheory.Abelian.Ext.{u} X Y (n + 1)),
      ∃ (K P : 𝒜) (i : K ⟶ P) (π : P ⟶ X)
        (hz : i ≫ π = 0)
        (hS : (CategoryTheory.ShortComplex.mk i π hz).ShortExact)
        (ξ' : CategoryTheory.Abelian.Ext.{u} K Y n),
        CategoryTheory.Limits.PreservesFiniteLimits (T.obj K) ∧
        CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj K) ∧
        CategoryTheory.Limits.PreservesFiniteLimits (T.obj P) ∧
        CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj P) ∧
        hS.extClass.comp ξ' (Nat.one_add n) = ξ := by
    intro X Y _ _ n ξ
    let R_inj := CategoryTheory.InjectiveResolution.of Y
    obtain ⟨f, hf, hf_eq⟩ := R_inj.extMk_surjective ξ (n + 2) rfl
    obtain ⟨E, e, he_epi, x₁, hx₁⟩ := (R_inj.exact_succ n).exact_up_to_refinements f hf
    have : CategoryTheory.Epi e := he_epi
    change e ≫ f = x₁ ≫ R_inj.cocomplex.d n (n + 1) at hx₁
    obtain ⟨P, p, hp_epi, hP_L, hP_R⟩ := hCovers E
    have : CategoryTheory.Epi p := hp_epi
    have : CategoryTheory.Limits.PreservesFiniteLimits (T.obj P) := hP_L
    have : CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj P) := hP_R
    let π : P ⟶ X := p ≫ e
    have hπ_epi : CategoryTheory.Epi π := CategoryTheory.epi_comp p e
    have h_kill : (CategoryTheory.Abelian.Ext.mk₀ π).comp ξ (Nat.zero_add (n + 1)) = 0 := by
      rw [← hf_eq, R_inj.mk₀_comp_extMk f (n + 2) rfl hf π]
      refine (R_inj.extMk_eq_zero_iff (π ≫ f) (n + 2) rfl _ n rfl).mpr ⟨p ≫ x₁, ?_⟩
      dsimp [π]
      rw [CategoryTheory.Category.assoc, ← hx₁, ← CategoryTheory.Category.assoc]
    let K := CategoryTheory.Limits.kernel π
    let i : K ⟶ P := CategoryTheory.Limits.kernel.ι π
    have hz : i ≫ π = 0 := CategoryTheory.Limits.kernel.condition π
    let S := CategoryTheory.ShortComplex.mk i π hz
    have hS : S.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_kernel π) inferInstance inferInstance
    have hK_L : CategoryTheory.Limits.PreservesFiniteLimits (T.obj K) :=
      hBiexactKer T hCovers hz hS
    have hFlipFlipAdd : ∀ A : 𝒜, (T.flip.flip.obj A).Additive :=
      fun A => inferInstanceAs ((T.obj A).Additive)
    have hFlipFlipColim : ∀ A : 𝒜, CategoryTheory.Limits.PreservesFiniteColimits (T.flip.flip.obj A) :=
      fun A => inferInstanceAs (CategoryTheory.Limits.PreservesFiniteColimits (T.obj A))
    have hCovFlip : ∀ Z : 𝒜, ∃ (Q : 𝒜) (ε : Q ⟶ Z),
        CategoryTheory.Epi ε ∧
        CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj Q) ∧
        CategoryTheory.Limits.PreservesFiniteLimits (T.flip.flip.obj Q) :=
      fun Z => let ⟨Q, ε, h1, h2, h3⟩ := hCovers Z; ⟨Q, ε, h1, h3, h2⟩
    have hK_R : CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj K) :=
      hBiexactKer T.flip hCovFlip hz hS
    obtain ⟨ξ', hξ'⟩ :=
      CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hS Y ξ h_kill (Nat.one_add n)
    exact ⟨K, P, i, π, hz, hS, ξ', hK_L, hK_R, hP_L, hP_R, hξ'⟩

  have hBicomplexAnticomm : ∀ {A₀₀ A₀₁ A₀₂ A₁₀ A₁₁ A₁₂ A₂₀ A₂₁ A₂₂ : 𝒜}
      (f₀₀ : A₀₀ ⟶ A₀₁) (g₀₁ : A₀₁ ⟶ A₀₂)
      (f₁₀ : A₁₀ ⟶ A₁₁) (g₁₁ : A₁₁ ⟶ A₁₂)
      (f₂₀ : A₂₀ ⟶ A₂₁) (g₂₁ : A₂₁ ⟶ A₂₂)
      (u₀₀ : A₀₀ ⟶ A₁₀) (v₁₀ : A₁₀ ⟶ A₂₀)
      (u₀₁ : A₀₁ ⟶ A₁₁) (v₁₁ : A₁₁ ⟶ A₂₁)
      (u₀₂ : A₀₂ ⟶ A₁₂) (v₁₂ : A₁₂ ⟶ A₂₂)
      (hr₀ : f₀₀ ≫ g₀₁ = 0) (hr₁ : f₁₀ ≫ g₁₁ = 0) (hr₂ : f₂₀ ≫ g₂₁ = 0)
      (hc₀ : u₀₀ ≫ v₁₀ = 0) (hc₁ : u₀₁ ≫ v₁₁ = 0) (hc₂ : u₀₂ ≫ v₁₂ = 0)
      (hR₀ : (CategoryTheory.ShortComplex.mk f₀₀ g₀₁ hr₀).ShortExact)
      (hR₁ : (CategoryTheory.ShortComplex.mk f₁₀ g₁₁ hr₁).ShortExact)
      (hR₂ : (CategoryTheory.ShortComplex.mk f₂₀ g₂₁ hr₂).ShortExact)
      (hC₀ : (CategoryTheory.ShortComplex.mk u₀₀ v₁₀ hc₀).ShortExact)
      (hC₁ : (CategoryTheory.ShortComplex.mk u₀₁ v₁₁ hc₁).ShortExact)
      (hC₂ : (CategoryTheory.ShortComplex.mk u₀₂ v₁₂ hc₂).ShortExact),
      f₀₀ ≫ u₀₁ = u₀₀ ≫ f₁₀ →
      g₀₁ ≫ u₀₂ = u₀₁ ≫ g₁₁ →
      f₁₀ ≫ v₁₁ = v₁₀ ≫ f₂₀ →
      g₁₁ ≫ v₁₂ = v₁₁ ≫ g₂₁ →
      hC₂.extClass.comp hR₀.extClass (rfl : 1 + 1 = 2) =
        -(hR₂.extClass.comp hC₀.extClass (rfl : 1 + 1 = 2)) := by
    intro A₀₀ A₀₁ A₀₂ A₁₀ A₁₁ A₁₂ A₂₀ A₂₁ A₂₂
      f₀₀ g₀₁ f₁₀ g₁₁ f₂₀ g₂₁ u₀₀ v₁₀ u₀₁ v₁₁ u₀₂ v₁₂
      hr₀ hr₁ hr₂ hc₀ hc₁ hc₂ hR₀ hR₁ hR₂ hC₀ hC₁ hC₂
      hsq₀₀ hsq₀₁ hsq₁₀ hsq₁₁
    have : CategoryTheory.Mono f₀₀ := hR₀.mono_f
    have : CategoryTheory.Epi g₀₁ := hR₀.epi_g
    have : CategoryTheory.Mono f₁₀ := hR₁.mono_f
    have : CategoryTheory.Epi g₁₁ := hR₁.epi_g
    have : CategoryTheory.Mono f₂₀ := hR₂.mono_f
    have : CategoryTheory.Epi g₂₁ := hR₂.epi_g
    have : CategoryTheory.Mono u₀₀ := hC₀.mono_f
    have : CategoryTheory.Epi v₁₀ := hC₀.epi_g
    have : CategoryTheory.Mono u₀₁ := hC₁.mono_f
    have : CategoryTheory.Epi v₁₁ := hC₁.epi_g
    have : CategoryTheory.Mono u₀₂ := hC₂.mono_f
    have : CategoryTheory.Epi v₁₂ := hC₂.epi_g
    let π_tot : A₁₁ ⟶ A₂₂ := g₁₁ ≫ v₁₂
    have hπ_alt : π_tot = v₁₁ ≫ g₂₁ := hsq₁₁
    have : CategoryTheory.Epi π_tot := CategoryTheory.epi_comp g₁₁ v₁₂
    let K := CategoryTheory.Limits.kernel π_tot
    let j : K ⟶ A₁₁ := CategoryTheory.Limits.kernel.ι π_tot
    let S_right := CategoryTheory.ShortComplex.mk j π_tot (CategoryTheory.Limits.kernel.condition π_tot)
    have hS_right : S_right.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_kernel π_tot) inferInstance inferInstance
    let ι : A₀₀ ⟶ A₀₁ ⊞ A₁₀ := CategoryTheory.Limits.biprod.lift f₀₀ (-u₀₀)
    let d_tot : A₀₁ ⊞ A₁₀ ⟶ A₁₁ := CategoryTheory.Limits.biprod.desc u₀₁ f₁₀
    have h_ι_d : ι ≫ d_tot = 0 := by
      dsimp [ι, d_tot]
      rw [CategoryTheory.Limits.biprod.lift_desc, CategoryTheory.Preadditive.neg_comp,
        hsq₀₀, add_neg_cancel]
    have h_d_π : d_tot ≫ π_tot = 0 := by
      apply CategoryTheory.Limits.biprod.hom_ext'
      · dsimp [d_tot]
        rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inl_desc, hπ_alt, ← CategoryTheory.Category.assoc,
          hc₁, CategoryTheory.Limits.zero_comp]
      · dsimp [d_tot, π_tot]
        rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inr_desc, ← CategoryTheory.Category.assoc,
          hr₁, CategoryTheory.Limits.zero_comp]
    let d_bar : A₀₁ ⊞ A₁₀ ⟶ K := CategoryTheory.Limits.kernel.lift π_tot d_tot h_d_π
    have hd_bar_j : d_bar ≫ j = d_tot := CategoryTheory.Limits.kernel.lift_ι π_tot d_tot h_d_π
    have h_ι_dbar : ι ≫ d_bar = 0 := by
      apply (CategoryTheory.cancel_mono j).mp
      rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.assoc, hd_bar_j, h_ι_d]
    let S_left := CategoryTheory.ShortComplex.mk ι d_bar h_ι_dbar
    have hMono_ι : CategoryTheory.Mono ι :=
      CategoryTheory.mono_of_mono_fac (CategoryTheory.Limits.biprod.lift_fst f₀₀ (-u₀₀))
    have hExact_left : S_left.Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
      let x : CategoryTheory.Limits.kernel S_left.g ⟶ A₀₁ ⊞ A₁₀ :=
        CategoryTheory.Limits.kernel.ι S_left.g
      have hx_dbar : x ≫ d_bar = 0 := CategoryTheory.Limits.kernel.condition S_left.g
      have hx_dtot : x ≫ d_tot = 0 := by
        rw [← hd_bar_j, ← CategoryTheory.Category.assoc, hx_dbar, CategoryTheory.Limits.zero_comp]
      let x₁ := x ≫ CategoryTheory.Limits.biprod.fst
      let x₂ := x ≫ CategoryTheory.Limits.biprod.snd
      have hx_eq : x = CategoryTheory.Limits.biprod.lift x₁ x₂ := by
        apply CategoryTheory.Limits.biprod.hom_ext <;> simp [x₁, x₂]
      have hx_sum : x₁ ≫ u₀₁ + x₂ ≫ f₁₀ = 0 := by
        have h1 := hx_dtot
        conv_lhs at h1 => rw [hx_eq]
        dsimp [d_tot] at h1
        rwa [CategoryTheory.Limits.biprod.lift_desc] at h1
      have hx₁_g : x₁ ≫ g₀₁ = 0 := by
        apply (CategoryTheory.cancel_mono u₀₂).mp
        rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.assoc, hsq₀₁,
          ← CategoryTheory.Category.assoc]
        have h2 := congrArg (· ≫ g₁₁) hx_sum
        simp only [CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc,
          hr₁, CategoryTheory.Limits.comp_zero, add_zero,
          CategoryTheory.Limits.zero_comp] at h2
        rw [CategoryTheory.Category.assoc]
        exact h2
      obtain ⟨w₀, hw₀⟩ := CategoryTheory.Limits.KernelFork.IsLimit.lift' hR₀.fIsKernel x₁ hx₁_g
      change w₀ ≫ f₀₀ = x₁ at hw₀
      have hw₀_x₂ : w₀ ≫ (-u₀₀) = x₂ := by
        have h3 : (w₀ ≫ u₀₀ + x₂) ≫ f₁₀ = 0 := by
          rw [CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc,
            ← hsq₀₀, ← CategoryTheory.Category.assoc, hw₀, hx_sum]
        have h4 : w₀ ≫ u₀₀ + x₂ = 0 :=
          (CategoryTheory.cancel_mono f₁₀).mp (by rw [h3, CategoryTheory.Limits.zero_comp])
        rw [CategoryTheory.Preadditive.comp_neg, eq_comm, ← add_eq_zero_iff_eq_neg, add_comm]
        exact h4
      have hx_fac : x = w₀ ≫ ι := by
        apply CategoryTheory.Limits.biprod.hom_ext
        · dsimp [ι]; rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_fst, hw₀]
        · dsimp [ι]; rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_snd, hw₀_x₂]
      change x ≫ CategoryTheory.Limits.cokernel.π ι = 0
      rw [hx_fac, CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.condition,
        CategoryTheory.Limits.comp_zero]
    have hjg : (j ≫ g₁₁) ≫ v₁₂ = 0 := by
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.Limits.kernel.condition π_tot
    obtain ⟨g_tilde, hg_tilde⟩ :=
      CategoryTheory.Limits.KernelFork.IsLimit.lift' hC₂.fIsKernel (j ≫ g₁₁) hjg
    change g_tilde ≫ u₀₂ = j ≫ g₁₁ at hg_tilde
    have hjv : (j ≫ v₁₁) ≫ g₂₁ = 0 := by
      rw [CategoryTheory.Category.assoc, ← hπ_alt]
      exact CategoryTheory.Limits.kernel.condition π_tot
    obtain ⟨v_tilde, hv_tilde⟩ :=
      CategoryTheory.Limits.KernelFork.IsLimit.lift' hR₂.fIsKernel (j ≫ v₁₁) hjv
    change v_tilde ≫ f₂₀ = j ≫ v₁₁ at hv_tilde
    let W' := CategoryTheory.Limits.pullback g_tilde g₀₁
    let e : W' ⟶ K := CategoryTheory.Limits.pullback.fst g_tilde g₀₁
    let y₁ : W' ⟶ A₀₁ := CategoryTheory.Limits.pullback.snd g_tilde g₀₁
    have : CategoryTheory.Epi e := CategoryTheory.Abelian.epi_pullback_of_epi_g g_tilde g₀₁
    have hpb_g : e ≫ g_tilde = y₁ ≫ g₀₁ := CategoryTheory.Limits.pullback.condition
    let d_diff : W' ⟶ A₁₁ := e ≫ j - y₁ ≫ u₀₁
    have hd_diff : d_diff ≫ g₁₁ = 0 := by
      dsimp [d_diff]
      rw [CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc, ← hg_tilde,
        CategoryTheory.Category.assoc, ← hsq₀₁, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc, hpb_g, sub_self]
    obtain ⟨y₂, hy₂⟩ :=
      CategoryTheory.Limits.KernelFork.IsLimit.lift' hR₁.fIsKernel d_diff hd_diff
    change y₂ ≫ f₁₀ = e ≫ j - y₁ ≫ u₀₁ at hy₂
    let y_tot : W' ⟶ A₀₁ ⊞ A₁₀ := CategoryTheory.Limits.biprod.lift y₁ y₂
    have hy_fac : y_tot ≫ d_bar = e := by
      apply (CategoryTheory.cancel_mono j).mp
      rw [CategoryTheory.Category.assoc, hd_bar_j]
      dsimp [y_tot, d_tot]
      rw [CategoryTheory.Limits.biprod.lift_desc, hy₂, add_sub_cancel]
    have hEpi_dbar : CategoryTheory.Epi d_bar := CategoryTheory.epi_of_epi_fac hy_fac
    have hS_left : S_left.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hExact_left hMono_ι hEpi_dbar
    have hdbar_g : d_bar ≫ g_tilde = CategoryTheory.Limits.biprod.fst ≫ g₀₁ := by
      apply (CategoryTheory.cancel_mono u₀₂).mp
      rw [CategoryTheory.Category.assoc, hg_tilde, ← CategoryTheory.Category.assoc, hd_bar_j]
      apply CategoryTheory.Limits.biprod.hom_ext'
      · dsimp [d_tot]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.inl_desc, ← hsq₀₁,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inl_fst, CategoryTheory.Category.id_comp]
      · dsimp [d_tot]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.inr_desc, hr₁,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inr_fst, CategoryTheory.Limits.zero_comp,
          CategoryTheory.Limits.zero_comp]
    have hdbar_v : d_bar ≫ v_tilde = CategoryTheory.Limits.biprod.snd ≫ v₁₀ := by
      apply (CategoryTheory.cancel_mono f₂₀).mp
      rw [CategoryTheory.Category.assoc, hv_tilde, ← CategoryTheory.Category.assoc, hd_bar_j]
      apply CategoryTheory.Limits.biprod.hom_ext'
      · dsimp [d_tot]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.inl_desc, hc₁,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inl_snd, CategoryTheory.Limits.zero_comp,
          CategoryTheory.Limits.zero_comp]
      · dsimp [d_tot]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.inr_desc, hsq₁₀,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inr_snd, CategoryTheory.Category.id_comp]
    let Φ₁ : S_right ⟶ CategoryTheory.ShortComplex.mk u₀₂ v₁₂ hc₂ :=
      { τ₁ := g_tilde
        τ₂ := g₁₁
        τ₃ := 𝟙 A₂₂
        comm₁₂ := hg_tilde
        comm₂₃ := (CategoryTheory.Category.comp_id π_tot).symm }
    let Φ₂ : S_right ⟶ CategoryTheory.ShortComplex.mk f₂₀ g₂₁ hr₂ :=
      { τ₁ := v_tilde
        τ₂ := v₁₁
        τ₃ := 𝟙 A₂₂
        comm₁₂ := hv_tilde
        comm₂₃ := hπ_alt.symm.trans (CategoryTheory.Category.comp_id π_tot).symm }
    let Φ₃ : S_left ⟶ CategoryTheory.ShortComplex.mk f₀₀ g₀₁ hr₀ :=
      { τ₁ := 𝟙 A₀₀
        τ₂ := CategoryTheory.Limits.biprod.fst
        τ₃ := g_tilde
        comm₁₂ := (CategoryTheory.Category.id_comp f₀₀).trans
          (CategoryTheory.Limits.biprod.lift_fst f₀₀ (-u₀₀)).symm
        comm₂₃ := hdbar_g.symm }
    let Φ₄ : S_left ⟶ CategoryTheory.ShortComplex.mk u₀₀ v₁₀ hc₀ :=
      { τ₁ := -𝟙 A₀₀
        τ₂ := CategoryTheory.Limits.biprod.snd
        τ₃ := v_tilde
        comm₁₂ := by
          change (-𝟙 A₀₀) ≫ u₀₀ = ι ≫ CategoryTheory.Limits.biprod.snd
          dsimp [ι]
          rw [CategoryTheory.Limits.biprod.lift_snd, CategoryTheory.Preadditive.neg_comp,
            CategoryTheory.Category.id_comp]
        comm₂₃ := hdbar_v.symm }
    have hNat₁ : hS_right.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ g_tilde) (Nat.add_zero 1) =
        hC₂.extClass := by
      have h := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_right hC₂ Φ₁
      dsimp [Φ₁] at h
      rwa [CategoryTheory.Abelian.Ext.mk₀_id_comp] at h
    have hNat₂ : hS_right.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ v_tilde) (Nat.add_zero 1) =
        hR₂.extClass := by
      have h := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_right hR₂ Φ₂
      dsimp [Φ₂] at h
      rwa [CategoryTheory.Abelian.Ext.mk₀_id_comp] at h
    have hNat₃ : (CategoryTheory.Abelian.Ext.mk₀ g_tilde).comp hR₀.extClass (Nat.zero_add 1) =
        hS_left.extClass := by
      have h := (CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_left hR₀ Φ₃).symm
      dsimp [Φ₃] at h
      rwa [CategoryTheory.Abelian.Ext.comp_mk₀_id] at h
    have hNat₄ : (CategoryTheory.Abelian.Ext.mk₀ v_tilde).comp hC₀.extClass (Nat.zero_add 1) =
        -hS_left.extClass := by
      have h := (CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_left hC₀ Φ₄).symm
      dsimp [Φ₄] at h
      rwa [CategoryTheory.Abelian.Ext.mk₀_neg, CategoryTheory.Abelian.Ext.comp_neg,
        CategoryTheory.Abelian.Ext.comp_mk₀_id] at h
    calc
      hC₂.extClass.comp hR₀.extClass (rfl : 1 + 1 = 2)
        = (hS_right.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ g_tilde) (Nat.add_zero 1)).comp
            hR₀.extClass (rfl : 1 + 1 = 2) := by rw [← hNat₁]
      _ = hS_right.extClass.comp
            ((CategoryTheory.Abelian.Ext.mk₀ g_tilde).comp hR₀.extClass (Nat.zero_add 1))
            (rfl : 1 + 1 = 2) :=
          CategoryTheory.Abelian.Ext.comp_assoc hS_right.extClass
            (CategoryTheory.Abelian.Ext.mk₀ g_tilde) hR₀.extClass
            (Nat.add_zero 1) (Nat.zero_add 1) rfl
      _ = hS_right.extClass.comp hS_left.extClass (rfl : 1 + 1 = 2) := by rw [hNat₃]
      _ = -(hS_right.extClass.comp (-hS_left.extClass) (rfl : 1 + 1 = 2)) := by
          rw [CategoryTheory.Abelian.Ext.comp_neg, neg_neg]
      _ = -(hS_right.extClass.comp
            ((CategoryTheory.Abelian.Ext.mk₀ v_tilde).comp hC₀.extClass (Nat.zero_add 1))
            (rfl : 1 + 1 = 2)) := by rw [← hNat₄]
      _ = -((hS_right.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ v_tilde) (Nat.add_zero 1)).comp
            hC₀.extClass (rfl : 1 + 1 = 2)) := by
          rw [← CategoryTheory.Abelian.Ext.comp_assoc hS_right.extClass
            (CategoryTheory.Abelian.Ext.mk₀ v_tilde) hC₀.extClass
            (Nat.add_zero 1) (Nat.zero_add 1) rfl]
      _ = -(hR₂.extClass.comp hC₀.extClass (rfl : 1 + 1 = 2)) := by rw [hNat₂]

  have hOneQ : ∀ (q_deg : ℕ) {K₁ P₁ U₁ U₂ V₂ : 𝒜}
      [CategoryTheory.Limits.PreservesFiniteLimits (T.obj K₁)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj K₁)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.obj P₁)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj P₁)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.obj U₁)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj U₁)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.obj U₂)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj U₂)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.obj V₂)]
      [CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj V₂)]
      {i₁ : K₁ ⟶ P₁} {π₁ : P₁ ⟶ U₁} (hz₁ : i₁ ≫ π₁ = 0)
      (hS₁ : (CategoryTheory.ShortComplex.mk i₁ π₁ hz₁).ShortExact)
      {r_deg : ℕ} (h1q : 1 + q_deg = r_deg) (hq1 : q_deg + 1 = r_deg)
      (β₀ : CategoryTheory.Abelian.Ext.{u} U₂ V₂ q_deg),
      (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj U₂) hS₁.extClass).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj K₁) β₀) h1q =
      ((-1 : ℤ) ^ (1 * q_deg)) •
        ((CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj U₁) β₀).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj V₂) hS₁.extClass) hq1) := by
    intro q_deg
    induction q_deg with
    | zero =>
      intro K₁ P₁ U₁ U₂ V₂ _ _ _ _ _ _ _ _ _ _ i₁ π₁ hz₁ hS₁ r_deg h1q hq1 β₀
      have hr : r_deg = 1 := hq1.symm.trans (Nat.zero_add 1)
      subst hr
      obtain ⟨g, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective U₂ V₂).2 β₀
      have hh1 : h1q = Nat.add_zero 1 := Subsingleton.elim _ _
      have hh2 : hq1 = Nat.zero_add 1 := Subsingleton.elim _ _
      rw [hh1, hh2, Nat.mul_zero, pow_zero, one_smul,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      exact (hNatTransComm (T.flip.obj U₂) (T.flip.obj V₂) (T.flip.map g)
        1 U₁ K₁ hS₁.extClass).symm
    | succ q' ih_q =>
      intro K₁ P₁ U₁ U₂ V₂ _ _ _ _ _ _ _ _ _ _ i₁ π₁ hz₁ hS₁ r_deg h1q hq1 β₀
      obtain ⟨K₂, P₂, i₂, π₂, hz₂, hS₂, β', hK₂_L, hK₂_R, hP₂_L, hP₂_R, hβ_eq⟩ :=
        hSyzygyFact U₂ V₂ q' β₀
      have : CategoryTheory.Limits.PreservesFiniteLimits (T.obj K₂) := hK₂_L
      have : CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj K₂) := hK₂_R
      have : CategoryTheory.Limits.PreservesFiniteLimits (T.obj P₂) := hP₂_L
      have : CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj P₂) := hP₂_R
      let S₁ := CategoryTheory.ShortComplex.mk i₁ π₁ hz₁
      let S₂ := CategoryTheory.ShortComplex.mk i₂ π₂ hz₂
      have hR₀ : (S₂.map (T.obj K₁)).ShortExact := hS₂.map_of_exact (T.obj K₁)
      have hR₁ : (S₂.map (T.obj P₁)).ShortExact := hS₂.map_of_exact (T.obj P₁)
      have hR₂ : (S₂.map (T.obj U₁)).ShortExact := hS₂.map_of_exact (T.obj U₁)
      have hC₀ : (S₁.map (T.flip.obj K₂)).ShortExact := hS₁.map_of_exact (T.flip.obj K₂)
      have hC₁ : (S₁.map (T.flip.obj P₂)).ShortExact := hS₁.map_of_exact (T.flip.obj P₂)
      have hC₂ : (S₁.map (T.flip.obj U₂)).ShortExact := hS₁.map_of_exact (T.flip.obj U₂)
      have hAnti :
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj U₂) hS₁.extClass).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj K₁) hS₂.extClass)
            (rfl : 1 + 1 = 2) =
          -((CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj U₁) hS₂.extClass).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj K₂) hS₁.extClass)
            (rfl : 1 + 1 = 2)) := by
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (T.flip.obj U₂) hS₁,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (T.obj K₁) hS₂,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (T.obj U₁) hS₂,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (T.flip.obj K₂) hS₁]
        exact hBicomplexAnticomm
          ((T.obj K₁).map i₂) ((T.obj K₁).map π₂)
          ((T.obj P₁).map i₂) ((T.obj P₁).map π₂)
          ((T.obj U₁).map i₂) ((T.obj U₁).map π₂)
          ((T.flip.obj K₂).map i₁) ((T.flip.obj K₂).map π₁)
          ((T.flip.obj P₂).map i₁) ((T.flip.obj P₂).map π₁)
          ((T.flip.obj U₂).map i₁) ((T.flip.obj U₂).map π₁)
          (S₂.map (T.obj K₁)).zero (S₂.map (T.obj P₁)).zero (S₂.map (T.obj U₁)).zero
          (S₁.map (T.flip.obj K₂)).zero (S₁.map (T.flip.obj P₂)).zero (S₁.map (T.flip.obj U₂)).zero
          hR₀ hR₁ hR₂ hC₀ hC₁ hC₂
          ((T.map i₁).naturality i₂)
          ((T.map i₁).naturality π₂)
          ((T.map π₁).naturality i₂)
          ((T.map π₁).naturality π₂)
      have hSign : -(((-1 : ℤ) ^ (1 * q')) •
          ((CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj U₁) β₀).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj V₂) hS₁.extClass) hq1)) =
          ((-1 : ℤ) ^ (1 * (q' + 1))) •
            ((CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj U₁) β₀).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj V₂) hS₁.extClass) hq1) := by
        rw [← neg_one_smul ℤ, smul_smul]
        congr 1
        simp [pow_succ, mul_comm]
      rw [← hβ_eq,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp (T.obj K₁),
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj U₂) hS₁.extClass)
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj K₁) hS₂.extClass)
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj K₁) β')
          (rfl : 1 + 1 = 2) (Nat.one_add q') (by omega),
        hAnti,
        CategoryTheory.Abelian.Ext.neg_comp,
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj U₁) hS₂.extClass)
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj K₂) hS₁.extClass)
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj K₁) β')
          (rfl : 1 + 1 = 2) (rfl : 1 + q' = 1 + q') (by omega),
        ih_q hz₁ hS₁ (rfl : 1 + q' = 1 + q') (Nat.add_comm q' 1) β',
        hcomp_zsmul,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj U₁) hS₂.extClass)
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj U₁) β')
          (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj V₂) hS₁.extClass)
          (Nat.one_add q') (Nat.add_comm q' 1) (by omega : 1 + q' + 1 = r_deg),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp (T.obj U₁),
        hβ_eq, hSign]

  revert X₁ Y₁ X₂ Y₂ q r hpq hqp α β
  induction p with
  | zero =>
    intro X₁ Y₁ X₂ Y₂ _ _ _ _ _ _ _ _ q r hpq hqp α β
    have hr : r = q := hpq.symm.trans (Nat.zero_add q)
    revert hpq hqp
    rw [hr]
    intro hpq hqp
    obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X₁ Y₁).2 α
    have hh1 : hpq = Nat.zero_add q := Subsingleton.elim _ _
    have hh2 : hqp = Nat.add_zero q := Subsingleton.elim _ _
    rw [hh1, hh2, Nat.zero_mul, pow_zero, one_smul,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    exact hNatTransComm (T.obj X₁) (T.obj Y₁) (T.map f) q X₂ Y₂ β
  | succ p' ih_p =>
    intro X₁ Y₁ X₂ Y₂ _ _ _ _ _ _ _ _ q r hpq hqp α β
    obtain ⟨K₁, P₁, i₁, π₁, hz₁, hS₁, α', hK₁_L, hK₁_R, hP₁_L, hP₁_R, hα_eq⟩ :=
      hSyzygyFact X₁ Y₁ p' α
    have : CategoryTheory.Limits.PreservesFiniteLimits (T.obj K₁) := hK₁_L
    have : CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj K₁) := hK₁_R
    have : CategoryTheory.Limits.PreservesFiniteLimits (T.obj P₁) := hP₁_L
    have : CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj P₁) := hP₁_R
    rw [← hα_eq,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp (T.flip.obj X₂),
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj X₂) hS₁.extClass)
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj X₂) α')
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj Y₁) β)
        (Nat.one_add p') (rfl : p' + q = p' + q) (by omega),
      ih_p K₁ Y₁ X₂ Y₂ q (p' + q) rfl (Nat.add_comm q p') α' β,
      hcomp_zsmul,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj X₂) hS₁.extClass)
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj K₁) β)
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj Y₂) α')
        (rfl : 1 + q = 1 + q) (Nat.add_comm q p') (by omega),
      hOneQ q hz₁ hS₁ (rfl : 1 + q = 1 + q) (Nat.add_comm q 1) β,
      hzsmul_comp, smul_smul,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.obj X₁) β)
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj Y₂) hS₁.extClass)
        (CategoryTheory.Abelian.Ext.mapExactFunctor (T.flip.obj Y₂) α')
        (Nat.add_comm q 1) (Nat.one_add p') (by omega : q + 1 + p' = r),
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp (T.flip.obj Y₂),
      hα_eq, ← pow_add, ← Nat.add_mul]

theorem weil_gysin_sheaf_tensor_colimits_unitors_and_free_covers (C₀ : Type u) [CategoryTheory.SmallCategory C₀]
    (J₀ : CategoryTheory.GrothendieckTopology C₀)
    (R : Type u) [CommRing R] :
    let Psh₀ := CategoryTheory.Functor (Opposite C₀) (ModuleCat.{u, u} R)
    let ℳ₀ := CategoryTheory.Sheaf J₀ (ModuleCat.{u, u} R)
    let One₀ := (CategoryTheory.constantSheaf J₀ (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
    let S := CategoryTheory.sheafToPresheaf J₀ (ModuleCat.{u, u} R)
    let L := CategoryTheory.presheafToSheaf J₀ (ModuleCat.{u, u} R)
    let T : CategoryTheory.Functor ℳ₀ (CategoryTheory.Functor ℳ₀ ℳ₀) :=
      (((S.comp (CategoryTheory.MonoidalCategory.curriedTensor Psh₀)).comp
        ((CategoryTheory.Functor.whiskeringLeft ℳ₀ Psh₀ Psh₀).obj S)).comp
        ((CategoryTheory.Functor.whiskeringRight ℳ₀ Psh₀ ℳ₀).obj L))
    ((∀ X : ℳ₀, (T.obj X).Additive ∧ CategoryTheory.Limits.PreservesFiniteColimits (T.obj X)) ∧
      (∀ Y : ℳ₀, (T.flip.obj Y).Additive ∧ CategoryTheory.Limits.PreservesFiniteColimits (T.flip.obj Y))) ∧
    (∀ Z : ℳ₀, ∃ (P_cov : ℳ₀) (π : Quiver.Hom P_cov Z),
      CategoryTheory.Epi π ∧
      CategoryTheory.Limits.PreservesFiniteLimits (T.obj P_cov) ∧
      CategoryTheory.Limits.PreservesFiniteLimits (T.flip.obj P_cov)) ∧
    (∃ (lUnit : CategoryTheory.Iso (T.obj One₀) (CategoryTheory.Functor.id ℳ₀))
       (rUnit : CategoryTheory.Iso (T.flip.obj One₀) (CategoryTheory.Functor.id ℳ₀)),
      lUnit.hom.app One₀ = rUnit.hom.app One₀) :=
by
  intro Psh₀ ℳ₀ One₀ S L T
  let adj := CategoryTheory.sheafificationAdjunction J₀ (ModuleCat.{u, u} R)
  let η_app (P : Psh₀) : P ⟶ (L.obj P).obj := adj.unit.app P
  let 𝕀 := CategoryTheory.MonoidalCategoryStruct.tensorUnit Psh₀
  have hL_add : L.Additive := CategoryTheory.presheafToSheaf_additive
  
  have hWhiskerLeft_add : ∀ (A : Psh₀) {B₁ B₂ : Psh₀} (f₁ f₂ : B₁ ⟶ B₂),
      CategoryTheory.MonoidalCategoryStruct.whiskerLeft A (f₁ + f₂) =
        CategoryTheory.MonoidalCategoryStruct.whiskerLeft A f₁ +
          CategoryTheory.MonoidalCategoryStruct.whiskerLeft A f₂ := by
    intro A B₁ B₂ f₁ f₂
    apply CategoryTheory.NatTrans.ext
    funext V
    exact CategoryTheory.MonoidalPreadditive.whiskerLeft_add (X := A.obj V) (f₁.app V) (f₂.app V)
  have hAdd_left : ∀ X : ℳ₀, (T.obj X).Additive := by
    intro X
    refine ⟨fun {Y₁ Y₂} f₁ f₂ => ?_⟩
    change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft X.obj (S.map (f₁ + f₂))) =
      L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft X.obj (S.map f₁)) +
        L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft X.obj (S.map f₂))
    rw [S.map_add, hWhiskerLeft_add, @CategoryTheory.Functor.map_add _ _ _ _ _ _ L hL_add]
  let β_sh : ∀ X : ℳ₀, CategoryTheory.Iso (T.obj X) (T.flip.obj X) := fun X =>
    CategoryTheory.NatIso.ofComponents
      (fun Y => L.mapIso (CategoryTheory.BraidedCategory.braiding X.obj Y.obj))
      (fun {Y₁ Y₂} g => by
        change L.map (CategoryTheory.MonoidalCategoryStruct.whiskerLeft X.obj g.hom) ≫
            L.map (CategoryTheory.BraidedCategory.braiding X.obj Y₂.obj).hom =
          L.map (CategoryTheory.BraidedCategory.braiding X.obj Y₁.obj).hom ≫
            L.map (CategoryTheory.MonoidalCategoryStruct.whiskerRight g.hom X.obj)
        rw [← L.map_comp, ← L.map_comp,
          CategoryTheory.BraidedCategory.braiding_naturality_right X.obj g.hom])
  have hAdd_right : ∀ Y : ℳ₀, (T.flip.obj Y).Additive := fun Y => by
    have : (T.obj Y).Additive := hAdd_left Y
    exact CategoryTheory.Functor.additive_of_iso (β_sh Y)
  
  let sliceSubmod (A : Psh₀) (ℋ : ℳ₀) (V : C₀) :
      Submodule R (∀ (W : C₀) (_ : W ⟶ V),
        (↑(A.obj (Opposite.op W)) →ₗ[R] ↑(ℋ.obj.obj (Opposite.op W)))) :=
    { carrier := { φ | ∀ ⦃W' W : C₀⦄ (g : W' ⟶ W) (f : W ⟶ V) (a : ↑(A.obj (Opposite.op W))),
        (ℋ.obj.map g.op).hom (φ W f a) = φ W' (g ≫ f) ((A.map g.op).hom a) }
      zero_mem' := by
        intro W' W g f a
        simp only [Pi.zero_apply, LinearMap.zero_apply, map_zero]
      add_mem' := by
        intro φ₁ φ₂ hφ₁ hφ₂ W' W g f a
        simp only [Pi.add_apply, LinearMap.add_apply, map_add, hφ₁ g f a, hφ₂ g f a]
      smul_mem' := by
        intro r φ hφ W' W g f a
        simp only [Pi.smul_apply, LinearMap.smul_apply, map_smul, hφ g f a] }
  let homPresheaf (A : Psh₀) (ℋ : ℳ₀) : Psh₀ :=
    { obj := fun V => ModuleCat.of R ↥(sliceSubmod A ℋ (Opposite.unop V))
      map := fun {V₁ V₂} h => ModuleCat.ofHom
        { toFun := fun φ =>
            ⟨fun W f => φ.1 W (f ≫ h.unop),
              fun {W' W} g f a => by
                dsimp only
                rw [φ.2 g (f ≫ h.unop) a, CategoryTheory.Category.assoc]⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      map_id := fun V => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro φ
        apply Subtype.ext
        funext W f
        change φ.1 W (f ≫ 𝟙 (Opposite.unop V)) = φ.1 W f
        rw [CategoryTheory.Category.comp_id]
      map_comp := fun {V₁ V₂ V₃} h₁ h₂ => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro φ
        apply Subtype.ext
        funext W f
        change φ.1 W (f ≫ (h₂.unop ≫ h₁.unop)) = φ.1 W ((f ≫ h₂.unop) ≫ h₁.unop)
        rw [CategoryTheory.Category.assoc] }
  have homPresheaf_isSheaf : ∀ (A : Psh₀) (ℋ : ℳ₀),
      CategoryTheory.Presheaf.IsSheaf J₀ (homPresheaf A ℋ) := by
    intro A ℋ
    let FgtMod := CategoryTheory.forget (ModuleCat.{u, u} R)
    have hH_sh : CategoryTheory.Presieve.IsSheaf J₀ (ℋ.obj.comp FgtMod) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J₀ (ℋ.obj.comp FgtMod)).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J₀ ℋ.obj FgtMod ℋ.property)
    have hP_comp : ∀ {X₁ X₂ X₃ : C₀} (P : Psh₀) (p : X₁ ⟶ X₂) (q : X₂ ⟶ X₃)
        (z : ↑(P.obj (Opposite.op X₃))),
        (P.map p.op).hom ((P.map q.op).hom z) = (P.map (p ≫ q).op).hom z := by
      intro X₁ X₂ X₃ P p q z
      change (P.map p.op).hom ((P.map q.op).hom z) = (P.map (q.op ≫ p.op)).hom z
      rw [P.map_comp]
      rfl
    have hP_id : ∀ (P : Psh₀) (X : C₀) (z : ↑(P.obj (Opposite.op X))),
        (P.map (𝟙 X).op).hom z = z := by
      intro P X z
      change (P.map (𝟙 (Opposite.op X))).hom z = z
      rw [P.map_id]
      rfl
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J₀ (homPresheaf A ℋ) FgtMod
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro V S₀ hS₀ x hx
    have hx_eval : ∀ {Y₁ Y₂ Z₀ : C₀} (g₁ : Z₀ ⟶ Y₁) (g₂ : Z₀ ⟶ Y₂)
        {f₁ : Y₁ ⟶ V} {f₂ : Y₂ ⟶ V} (h₁ : S₀.arrows f₁) (h₂ : S₀.arrows f₂)
        (heq : g₁ ≫ f₁ = g₂ ≫ f₂) (W : C₀) (f₀ : W ⟶ Z₀) (a : ↑(A.obj (Opposite.op W))),
        (x f₁ h₁).1 W (f₀ ≫ g₁) a = (x f₂ h₂).1 W (f₀ ≫ g₂) a := by
      intro Y₁ Y₂ Z₀ g₁ g₂ f₁ f₂ h₁ h₂ heq W f₀ a
      have h := hx g₁ g₂ h₁ h₂ heq
      exact congrArg (fun (ψ : ↥(sliceSubmod A ℋ Z₀)) => ψ.1 W f₀ a) h
    let shfH (W : C₀) (f : W ⟶ V) :
        CategoryTheory.Presieve.IsSheafFor (ℋ.obj.comp FgtMod) (S₀.pullback f).arrows :=
      hH_sh (S₀.pullback f) (J₀.pullback_stable f hS₀)
    let y (W : C₀) (f : W ⟶ V) (a : ↑(A.obj (Opposite.op W))) :
        CategoryTheory.Presieve.FamilyOfElements (ℋ.obj.comp FgtMod) (S₀.pullback f).arrows :=
      fun W' k hk => (x (k ≫ f) hk).1 W' (𝟙 W') ((A.map k.op).hom a)
    have hy : ∀ (W : C₀) (f : W ⟶ V) (a : ↑(A.obj (Opposite.op W))),
        (y W f a).Compatible := by
      intro W f a W'₁ W'₂ U m₁ m₂ k₁ k₂ hk₁ hk₂ hm
      change (ℋ.obj.map m₁.op).hom ((x (k₁ ≫ f) hk₁).1 W'₁ (𝟙 W'₁) ((A.map k₁.op).hom a)) =
        (ℋ.obj.map m₂.op).hom ((x (k₂ ≫ f) hk₂).1 W'₂ (𝟙 W'₂) ((A.map k₂.op).hom a))
      rw [(x (k₁ ≫ f) hk₁).2 m₁ (𝟙 W'₁) ((A.map k₁.op).hom a),
        (x (k₂ ≫ f) hk₂).2 m₂ (𝟙 W'₂) ((A.map k₂.op).hom a),
        CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id,
        hP_comp A m₁ k₁ a, hP_comp A m₂ k₂ a, hm]
      have h_eq := hx_eval m₁ m₂ hk₁ hk₂
        (by rw [← CategoryTheory.Category.assoc, hm, CategoryTheory.Category.assoc])
        U (𝟙 U) ((A.map (m₂ ≫ k₂).op).hom a)
      simpa only [CategoryTheory.Category.id_comp] using h_eq
    let φ_fn (W : C₀) (f : W ⟶ V) (a : ↑(A.obj (Opposite.op W))) :
        ↑(ℋ.obj.obj (Opposite.op W)) :=
      (shfH W f).amalgamate (y W f a) (hy W f a)
    have hglue : ∀ (W : C₀) (f : W ⟶ V) (a : ↑(A.obj (Opposite.op W)))
        {W' : C₀} (k : W' ⟶ W) (hk : (S₀.pullback f).arrows k),
        (ℋ.obj.map k.op).hom (φ_fn W f a) =
          (x (k ≫ f) hk).1 W' (𝟙 W') ((A.map k.op).hom a) :=
      fun W f a _ k hk => (shfH W f).valid_glue (hy W f a) k hk
    have hsep : ∀ (W : C₀) (f : W ⟶ V) (z₁ z₂ : ↑(ℋ.obj.obj (Opposite.op W))),
        (∀ ⦃W' : C₀⦄ ⦃k : W' ⟶ W⦄, (S₀.pullback f).arrows k →
          (ℋ.obj.map k.op).hom z₁ = (ℋ.obj.map k.op).hom z₂) → z₁ = z₂ :=
      fun W f _ _ h => (shfH W f).isSeparatedFor.ext h
    let φ_lin (W : C₀) (f : W ⟶ V) :
        ↑(A.obj (Opposite.op W)) →ₗ[R] ↑(ℋ.obj.obj (Opposite.op W)) :=
      { toFun := φ_fn W f
        map_add' := fun a₁ a₂ => by
          apply hsep W f
          intro W' k hk
          rw [map_add, hglue W f (a₁ + a₂) k hk, hglue W f a₁ k hk, hglue W f a₂ k hk,
            map_add, map_add]
        map_smul' := fun r a => by
          dsimp only [RingHom.id_apply]
          apply hsep W f
          intro W' k hk
          rw [map_smul, hglue W f (r • a) k hk, hglue W f a k hk, map_smul, map_smul] }
    have hφ_mem : φ_lin ∈ sliceSubmod A ℋ V := by
      intro W₁ W g f a
      change (ℋ.obj.map g.op).hom (φ_fn W f a) = φ_fn W₁ (g ≫ f) ((A.map g.op).hom a)
      apply hsep W₁ (g ≫ f)
      intro W₂ k₁ hk₁
      have hk₁' : (S₀.pullback f).arrows (k₁ ≫ g) := by
        change S₀.arrows ((k₁ ≫ g) ≫ f)
        rw [CategoryTheory.Category.assoc]
        exact hk₁
      rw [hP_comp ℋ.obj k₁ g (φ_fn W f a), hglue W f a (k₁ ≫ g) hk₁',
        hglue W₁ (g ≫ f) ((A.map g.op).hom a) k₁ hk₁, hP_comp A k₁ g a]
      have h_eq := hx_eval (𝟙 W₂) (𝟙 W₂) hk₁' hk₁
        (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.assoc])
        W₂ (𝟙 W₂) ((A.map (k₁ ≫ g).op).hom a)
      simpa only [CategoryTheory.Category.id_comp] using h_eq
    let φ : ↥(sliceSubmod A ℋ V) := ⟨φ_lin, hφ_mem⟩
    refine ⟨φ, ?_, ?_⟩
    · intro U u hu
      apply Subtype.ext
      funext W f₀
      apply LinearMap.ext
      intro a
      change φ_fn W (f₀ ≫ u) a = (x u hu).1 W f₀ a
      have hf₀u : S₀.arrows (f₀ ≫ u) := S₀.downward_closed hu f₀
      have hid : (S₀.pullback (f₀ ≫ u)).arrows (𝟙 W) := by
        change S₀.arrows (𝟙 W ≫ (f₀ ≫ u))
        rwa [CategoryTheory.Category.id_comp]
      have hg := hglue W (f₀ ≫ u) a (𝟙 W) hid
      rw [hP_id ℋ.obj W (φ_fn W (f₀ ≫ u) a), hP_id A W a] at hg
      rw [hg]
      have h_eq := hx_eval (𝟙 W) f₀ hid hu
        (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp])
        W (𝟙 W) a
      simpa only [CategoryTheory.Category.id_comp] using h_eq
    · intro ψ hψ
      apply Subtype.ext
      funext W f
      apply LinearMap.ext
      intro a
      change ψ.1 W f a = φ_fn W f a
      apply hsep W f
      intro W' k hk
      rw [hglue W f a k hk, ψ.2 k f a]
      have hψ_k := congrArg (fun (ξ : ↥(sliceSubmod A ℋ W')) => ξ.1 W' (𝟙 W') ((A.map k.op).hom a))
        (hψ (k ≫ f) hk)
      change ψ.1 W' (𝟙 W' ≫ (k ≫ f)) ((A.map k.op).hom a) =
        (x (k ≫ f) hk).1 W' (𝟙 W') ((A.map k.op).hom a) at hψ_k
      rwa [CategoryTheory.Category.id_comp] at hψ_k
  let ihomSheaf (A : Psh₀) : CategoryTheory.Functor ℳ₀ ℳ₀ :=
    { obj := fun ℋ => ⟨homPresheaf A ℋ, homPresheaf_isSheaf A ℋ⟩
      map := fun {ℋ₁ ℋ₂} θ => CategoryTheory.ObjectProperty.homMk
        { app := fun V => ModuleCat.ofHom
            { toFun := fun φ =>
                ⟨fun W f => (θ.hom.app (Opposite.op W)).hom.comp (φ.1 W f),
                  fun {W' W} g f a => by
                    dsimp only [LinearMap.comp_apply]
                    have hnat := congrArg (fun (m : ℋ₁.obj.obj (Opposite.op W) ⟶
                        ℋ₂.obj.obj (Opposite.op W')) => m.hom (φ.1 W f a))
                      (θ.hom.naturality g.op)
                    change (θ.hom.app (Opposite.op W')).hom ((ℋ₁.obj.map g.op).hom (φ.1 W f a)) =
                      (ℋ₂.obj.map g.op).hom ((θ.hom.app (Opposite.op W)).hom (φ.1 W f a)) at hnat
                    rw [← hnat, φ.2 g f a]⟩
              map_add' := fun _ _ => by
                apply Subtype.ext; funext W f; apply LinearMap.ext; intro a; simp
              map_smul' := fun _ _ => by
                apply Subtype.ext; funext W f; apply LinearMap.ext; intro a; simp }
          naturality := fun {V₁ V₂} h => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro φ
            rfl }
      map_id := fun ℋ => by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext V
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro φ
        rfl
      map_comp := fun θ₁ θ₂ => by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext V
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro φ
        rfl }
  
  let curryEquiv (A B : Psh₀) (ℋ : ℳ₀) :
      (CategoryTheory.MonoidalCategoryStruct.tensorObj A B ⟶ ℋ.obj) ≃
        (B ⟶ ((ihomSheaf A).obj ℋ).obj) :=
    { toFun := fun α =>
        let α_lin (W : C₀) :
            TensorProduct R ↑(A.obj (Opposite.op W)) ↑(B.obj (Opposite.op W)) →ₗ[R]
              ↑(ℋ.obj.obj (Opposite.op W)) :=
          (α.app (Opposite.op W)).hom
        { app := fun V => ModuleCat.ofHom
            { toFun := fun b =>
                ⟨fun W f =>
                    { toFun := fun a => α_lin W (a ⊗ₜ[R] (B.map f.op).hom b)
                      map_add' := fun a₁ a₂ => by
                        rw [TensorProduct.add_tmul, (α_lin W).map_add]
                      map_smul' := fun r a => by
                        dsimp only [RingHom.id_apply]
                        rw [← TensorProduct.smul_tmul', (α_lin W).map_smul] },
                  fun {W' W} g f a => by
                    change (ℋ.obj.map g.op).hom (α_lin W (a ⊗ₜ[R] (B.map f.op).hom b)) =
                      α_lin W' ((A.map g.op).hom a ⊗ₜ[R] (B.map (g ≫ f).op).hom b)
                    have hnat := congrArg
                      (fun (m : (CategoryTheory.MonoidalCategoryStruct.tensorObj A B).obj
                          (Opposite.op W) ⟶ ℋ.obj.obj (Opposite.op W')) =>
                        m.hom (a ⊗ₜ[R] (B.map f.op).hom b))
                      (α.naturality g.op)
                    change α_lin W'
                        (((CategoryTheory.MonoidalCategoryStruct.tensorObj A B).map g.op).hom
                          (a ⊗ₜ[R] (B.map f.op).hom b)) =
                      (ℋ.obj.map g.op).hom (α_lin W (a ⊗ₜ[R] (B.map f.op).hom b)) at hnat
                    rw [← hnat]
                    have htmul := ModuleCat.MonoidalCategory.tensorHom_tmul
                      (A.map g.op) (B.map g.op) a ((B.map f.op).hom b)
                    change (((CategoryTheory.MonoidalCategoryStruct.tensorObj A B).map g.op).hom
                        (a ⊗ₜ[R] (B.map f.op).hom b)) =
                      (A.map g.op).hom a ⊗ₜ[R] (B.map g.op).hom ((B.map f.op).hom b) at htmul
                    rw [htmul]
                    have hB : (B.map g.op).hom ((B.map f.op).hom b) =
                        (B.map (g ≫ f).op).hom b := by
                      change (B.map g.op).hom ((B.map f.op).hom b) =
                        (B.map (f.op ≫ g.op)).hom b
                      rw [B.map_comp]
                      rfl
                    rw [hB]⟩
              map_add' := fun b₁ b₂ => by
                apply Subtype.ext; funext W f; apply LinearMap.ext; intro a
                change α_lin W (a ⊗ₜ[R] (B.map f.op).hom (b₁ + b₂)) =
                  α_lin W (a ⊗ₜ[R] (B.map f.op).hom b₁) +
                    α_lin W (a ⊗ₜ[R] (B.map f.op).hom b₂)
                rw [map_add, TensorProduct.tmul_add, (α_lin W).map_add]
              map_smul' := fun r b => by
                apply Subtype.ext; funext W f; apply LinearMap.ext; intro a
                change α_lin W (a ⊗ₜ[R] (B.map f.op).hom (r • b)) =
                  r • α_lin W (a ⊗ₜ[R] (B.map f.op).hom b)
                rw [map_smul, TensorProduct.tmul_smul, (α_lin W).map_smul] }
          naturality := fun {V₁ V₂} h => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro b
            apply Subtype.ext
            funext W f
            apply LinearMap.ext
            intro a
            change α_lin W (a ⊗ₜ[R] (B.map f.op).hom ((B.map h).hom b)) =
              α_lin W (a ⊗ₜ[R] (B.map (h ≫ f.op)).hom b)
            rw [B.map_comp]
            rfl }
      invFun := fun β =>
        let liftV (V : Opposite C₀) :
            TensorProduct R ↑(A.obj V) ↑(B.obj V) →ₗ[R] ↑(ℋ.obj.obj V) :=
          TensorProduct.lift
            { toFun := fun a =>
                { toFun := fun b =>
                    ((β.app V).hom b).1 (Opposite.unop V) (𝟙 (Opposite.unop V)) a
                  map_add' := fun b₁ b₂ => by
                    rw [map_add]; rfl
                  map_smul' := fun r b => by
                    dsimp only [RingHom.id_apply]
                    rw [map_smul]; rfl }
              map_add' := fun a₁ a₂ => by
                apply LinearMap.ext; intro b
                exact (((β.app V).hom b).1 (Opposite.unop V) (𝟙 (Opposite.unop V))).map_add a₁ a₂
              map_smul' := fun r a => by
                apply LinearMap.ext; intro b
                exact (((β.app V).hom b).1 (Opposite.unop V) (𝟙 (Opposite.unop V))).map_smul r a }
        { app := fun V => ModuleCat.ofHom (liftV V)
          naturality := fun {V₁ V₂} h => by
            apply ModuleCat.hom_ext
            apply TensorProduct.ext'
            intro a b
            change liftV V₂
                (((CategoryTheory.MonoidalCategoryStruct.tensorObj A B).map h).hom (a ⊗ₜ[R] b)) =
              (ℋ.obj.map h).hom (liftV V₁ (a ⊗ₜ[R] b))
            have htmul := ModuleCat.MonoidalCategory.tensorHom_tmul (A.map h) (B.map h) a b
            change (((CategoryTheory.MonoidalCategoryStruct.tensorObj A B).map h).hom
                (a ⊗ₜ[R] b)) = (A.map h).hom a ⊗ₜ[R] (B.map h).hom b at htmul
            rw [htmul]
            change ((β.app V₂).hom ((B.map h).hom b)).1 (Opposite.unop V₂)
                (𝟙 (Opposite.unop V₂)) ((A.map h).hom a) =
              (ℋ.obj.map h).hom
                (((β.app V₁).hom b).1 (Opposite.unop V₁) (𝟙 (Opposite.unop V₁)) a)
            have hslice : (ℋ.obj.map h).hom
                (((β.app V₁).hom b).1 (Opposite.unop V₁) (𝟙 (Opposite.unop V₁)) a) =
              ((β.app V₁).hom b).1 (Opposite.unop V₂)
                (h.unop ≫ 𝟙 (Opposite.unop V₁)) ((A.map h).hom a) :=
              ((β.app V₁).hom b).2 h.unop (𝟙 (Opposite.unop V₁)) a
            rw [hslice, CategoryTheory.Category.comp_id]
            have hβ := congrArg
              (fun (m : B.obj V₁ ⟶ ((ihomSheaf A).obj ℋ).obj.obj V₂) =>
                (m.hom b).1 (Opposite.unop V₂) (𝟙 (Opposite.unop V₂)) ((A.map h).hom a))
              (β.naturality h)
            change ((β.app V₂).hom ((B.map h).hom b)).1 (Opposite.unop V₂)
                (𝟙 (Opposite.unop V₂)) ((A.map h).hom a) =
              ((β.app V₁).hom b).1 (Opposite.unop V₂)
                (𝟙 (Opposite.unop V₂) ≫ h.unop) ((A.map h).hom a) at hβ
            rwa [CategoryTheory.Category.id_comp] at hβ }
      left_inv := fun α => by
        apply CategoryTheory.NatTrans.ext
        funext V
        apply ModuleCat.hom_ext
        apply TensorProduct.ext'
        intro a b
        change (α.app V).hom (a ⊗ₜ[R] (B.map (𝟙 V)).hom b) = (α.app V).hom (a ⊗ₜ[R] b)
        have hB : (B.map (𝟙 V)).hom b = b := by
          rw [B.map_id]
          rfl
        rw [hB]
      right_inv := fun β => by
        apply CategoryTheory.NatTrans.ext
        funext V
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro b
        apply Subtype.ext
        funext W f
        apply LinearMap.ext
        intro a
        change ((β.app (Opposite.op W)).hom ((B.map f.op).hom b)).1 W (𝟙 W) a =
          ((β.app V).hom b).1 W f a
        have hβ := congrArg
          (fun (m : B.obj V ⟶ ((ihomSheaf A).obj ℋ).obj.obj (Opposite.op W)) =>
            (m.hom b).1 W (𝟙 W) a)
          (β.naturality f.op)
        change ((β.app (Opposite.op W)).hom ((B.map f.op).hom b)).1 W (𝟙 W) a =
          ((β.app V).hom b).1 W (𝟙 W ≫ f) a at hβ
        rwa [CategoryTheory.Category.id_comp] at hβ }
  have hcurry_nat_left : ∀ (A : Psh₀) {B₁ B₂ : Psh₀} (u : B₁ ⟶ B₂) (ℋ : ℳ₀)
      (α : CategoryTheory.MonoidalCategoryStruct.tensorObj A B₂ ⟶ ℋ.obj),
      curryEquiv A B₁ ℋ (CategoryTheory.MonoidalCategoryStruct.whiskerLeft A u ≫ α) =
        u ≫ curryEquiv A B₂ ℋ α := by
    intro A B₁ B₂ u ℋ α
    apply CategoryTheory.NatTrans.ext
    funext V
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro b₁
    apply Subtype.ext
    funext W f
    apply LinearMap.ext
    intro a
    change (α.app (Opposite.op W)).hom
        ((CategoryTheory.MonoidalCategoryStruct.whiskerLeft (A.obj (Opposite.op W))
          (u.app (Opposite.op W))).hom (a ⊗ₜ[R] (B₁.map f.op).hom b₁)) =
      (α.app (Opposite.op W)).hom (a ⊗ₜ[R] (B₂.map f.op).hom ((u.app V).hom b₁))
    rw [ModuleCat.MonoidalCategory.whiskerLeft_apply]
    have hu := congrArg (fun (m : B₁.obj V ⟶ B₂.obj (Opposite.op W)) => m.hom b₁)
      (u.naturality f.op)
