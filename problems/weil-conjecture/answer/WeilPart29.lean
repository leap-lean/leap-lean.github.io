                        = algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J) (r • a) * b :=
                          Algebra.smul_def (r • a) b
                      _ = algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J)
                            (algebraMap R₀ (Localization.AtPrime (Ideal.comap f J)) r * a) * b := by
                          rw [Algebra.smul_def r a]
