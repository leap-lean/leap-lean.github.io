      refine ⟨⊤, hU_top, ⊤, hV_top, trivial, e_le, ?_⟩
      let α₀ : CommRingCat.of k ⟶ S_k.presheaf.obj (Opposite.op ⊤) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
      let β₀ : Spec_Rmv.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of R_mv :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_mv)).hom
      haveI : CategoryTheory.IsIso α₀ := by dsimp [α₀]; infer_instance
      haveI : CategoryTheory.IsIso β₀ := by dsimp [β₀]; infer_instance
      let g_app : S_k.presheaf.obj (Opposite.op ⊤) ⟶ Spec_Rmv.presheaf.obj (Opposite.op ⊤) :=
