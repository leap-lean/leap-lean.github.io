      let f_q₀ : Fℤ_Ω ⟶ SC.X₃ := (adj_c.homEquiv A_ℤ SC.X₃).symm γ_q₀
      obtain ⟨z₂, hz₂⟩ := hSurj_H0 SC hSE (CategoryTheory.Abelian.Ext.mk₀ f_q₀)
      let f₂ : Fℤ_Ω ⟶ SC.X₂ := CategoryTheory.Abelian.Ext.addEquiv₀ z₂
      have hf₂_eq : f₂ ≫ SC.g = f_q₀ := by
        apply CategoryTheory.Abelian.Ext.addEquiv₀.symm.injective
        rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
          CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
          ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z₂, hz₂]
      have h_adj_eq : adj_c.homEquiv A_ℤ SC.X₂ f₂ ≫ SC.g.hom.app (Opposite.op T_Ω) = γ_q₀ :=
        ((adj_c.homEquiv_unit A_ℤ SC.X₂ f₂).trans rfl).symm ▸ by
          calc
            (adj_c.unit.app A_ℤ ≫ f₂.hom.app (Opposite.op T_Ω)) ≫ SC.g.hom.app (Opposite.op T_Ω) =
              adj_c.homEquiv A_ℤ SC.X₃ (f₂ ≫ SC.g) :=
                (CategoryTheory.Category.assoc _ _ _).trans
                  (adj_c.homEquiv_unit A_ℤ SC.X₃ (f₂ ≫ SC.g)).symm
            _ = γ_q₀ := by rw [hf₂_eq, Equiv.apply_symm_apply]
      refine ⟨((adj_c.homEquiv A_ℤ SC.X₂ f₂).hom) (ULift.up (1 : ℤ)), ?_⟩
      have heval := congrArg (fun k => k.hom (ULift.up (1 : ℤ))) h_adj_eq
      simpa [γ_q₀, one_zsmul] using heval
    have hSurj_all : ∀ (E : S_Ω.Etale), Function.Surjective ((SC.g.hom.app (Opposite.op E)).hom) :=
      hSurj_prop SC.g hSurj_TΩ
    have hEpi : CategoryTheory.Epi (pf_σ.map SC.g) := by
      refine ⟨fun {H} u₁ u₂ hu => ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext ⟨V⟩
      apply AddCommGrpCat.ext
      intro y
      obtain ⟨x, hx⟩ := hSurj_all (B_σ.obj V) y
      rw [← hx]
      exact congrArg (fun φ => (φ.hom.app (Opposite.op V)).hom x) hu
    let _ := adj_σ.rightAdjoint_preservesLimits
    have _ : CategoryTheory.Mono SC.f := hSE.mono_f
    have hMono : CategoryTheory.Mono (pf_σ.map SC.f) := pf_σ.map_mono SC.f
    have hc_map : CategoryTheory.Limits.IsLimit
