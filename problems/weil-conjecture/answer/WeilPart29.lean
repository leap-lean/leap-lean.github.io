theorem weil_gysin_unsigned_left_projection (S₀ Z Y : AlgebraicGeometry.Scheme.{u})
    (s : Quiver.Hom S₀ Z) (i : Quiver.Hom Z Y) (si : Quiver.Hom S₀ Y)
    (hsi : CategoryTheory.CategoryStruct.comp s i = si)
    (m p q pq : ℕ) (hm : 1 ≤ m) (hpq : p + q = pq) (hqp : q + p = pq)
    (hModCmp : ∀ (W : AlgebraicGeometry.Scheme.{u}) (k : ℕ),
      (∃ θ : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k,
        WeilIsModuleToTorsionComparison W m k θ ∧ Function.Bijective θ) ∧
      (∀ θ₁ θ₂ : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k,
        WeilIsModuleToTorsionComparison W m k θ₁ →
        WeilIsModuleToTorsionComparison W m k θ₂ →
        θ₁ = θ₂))
    (τ_Z : WeilGysinSupportClass S₀ Z s m p)
    (τ_Y : WeilGysinSupportClass Z Y i m q)
    (τ_SY : WeilGysinSupportClass S₀ Y si m pq)
    (hGys : WeilGysinSupportGysinComp hsi hpq τ_Z τ_Y τ_SY)
    (cl_Z : weilEtaleTorsionH Z m p)
    (γ_Y : weilEtaleTorsionH Y m q)
    (cl_SY : weilEtaleTorsionH Y m pq)
    (hfg_Z : WeilGysinForgetsTo τ_Z cl_Z)
    (hfg_Y : WeilGysinForgetsTo τ_Y γ_Y)
    (hfg_SY : WeilGysinForgetsTo τ_SY cl_SY)
    (p_i : weilEtaleTorsionH Y m p →+ weilEtaleTorsionH Z m p)
    (c_Y : weilEtaleTorsionH Y m q →+
      weilEtaleTorsionH Y m p →+ weilEtaleTorsionH Y m pq)
    (ξ : weilEtaleTorsionH Y m p) (a : ℕ)
    (hp_i : WeilLefschetzTorsionPullback i m p p_i)
    (hc_Y : WeilLefschetzIsTorsionCup Y m q p pq hqp c_Y)
    (hξ : p_i ξ = a • cl_Z) :
    ∃ (θ_Ypq : weilEtaleModuleH Y m pq →+ weilEtaleTorsionH Y m pq)
      (γ_mod : weilEtaleModuleH Y m q)
      (ξ_mod : weilEtaleModuleH Y m p)
      (cl_SY_mod : weilEtaleModuleH Y m pq),
      c_Y γ_Y ξ = θ_Ypq (γ_mod.comp ξ_mod hqp) ∧
      cl_SY = θ_Ypq cl_SY_mod ∧
      ξ_mod.comp γ_mod hpq = a • cl_SY_mod :=
by
  let _ := hm
  
  
  
  have hExtNat : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      [CategoryTheory.EnoughInjectives 𝒞]
      {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Abelian 𝒟] [CategoryTheory.HasExt.{u} 𝒟]
      (F₁ F₂ : CategoryTheory.Functor 𝒞 𝒟)
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (η : Quiver.Hom F₁ F₂)
      (n : ℕ) (A B : 𝒞) (x : CategoryTheory.Abelian.Ext.{u} A B n),
      (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x).comp
        (CategoryTheory.Abelian.Ext.mk₀ (η.app B)) (Nat.add_zero n) =
      (CategoryTheory.Abelian.Ext.mk₀ (η.app A)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ x) (Nat.zero_add n) := by
    intro 𝒞 _ _ _ _ 𝒟 _ _ _ F₁ F₂ _ _ _ _ _ _ η n
    induction n with
    | zero =>
      intro A B x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A B).2 x
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact congrArg CategoryTheory.Abelian.Ext.mk₀ (η.naturality f)
    | succ n' ih =>
      intro A B x
      let I := CategoryTheory.Injective.under B
      let ι : B ⟶ I := CategoryTheory.Injective.ι B
      let S := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hSub : Subsingleton (CategoryTheory.Abelian.Ext.{u} A I (n' + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton I 1 (n' + 1)
