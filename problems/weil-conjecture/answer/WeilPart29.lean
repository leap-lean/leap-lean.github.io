              (CategoryTheory.CategoryStruct.comp (Φ_pull.inv.app ℱ) (U_Z.map f))
              (U_Z.map g))).trans
            ((congrArg (fun z => CategoryTheory.CategoryStruct.comp z (U_Y.map (i_push.map g)))
              (ff_Y.map_preimage _).symm).trans
              (U_Y.map_comp _ (i_push.map g)).symm)) }
  let adj_mod : P_pull_mod ⊣ i_push := CategoryTheory.Adjunction.mkOfHomEquiv core_mod

