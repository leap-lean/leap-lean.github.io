        obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers X₀_sec) R_U₀).mp hp
        have hn' : X₀_sec ^ n * e_A₁ p₁ = X₀_sec ^ n * e_A₁ p₂ := hn
        refine ⟨⟨Polynomial.X ^ n, n, rfl⟩, ?_⟩
        apply e_A₁.injective
        simpa only [map_mul, map_pow, he_A₁_X] using hn'
    haveI : @IsLocalization (Polynomial k) _ (Submonoid.powers (Polynomial.X : Polynomial k))
        R_U₀ _ alg_poly_RU₀ := hLoc_poly_RU₀
    let e_alg_U₀ : LaurentPolynomial k ≃ₐ[Polynomial k] R_U₀ :=
      IsLocalization.algEquiv (Submonoid.powers (Polynomial.X : Polynomial k))
