                have hpx_from : hAff_U.fromSpec.base p_x = x.1 :=
                  hAff_U.fromSpec_primeIdealOf ⟨x.1, hx_mem⟩
                rw [← hfrom_pQ, hpt_eq, hpx_from]
              exact hxQ (Subtype.ext hx1_eq.symm)
