            (fun h0 => h0 (hV₀.primeIdealOf ⟨y.1, hy⟩).asIdeal.zero_mem)
        have hInj_germ : Function.Injective (U_sch.presheaf.germ V₀ y.1 hy).hom :=
          IsLocalization.injective ↑(U_sch.presheaf.stalk (⟨y.1, hy⟩ : ↥V₀).1) hle_nzd
        let e_st : Ry' ≃+* ↑(U_sch.presheaf.stalk y.1) :=
          (V₀.stalkIso ⟨y.1, hy⟩).commRingCatIsoToRingEquiv
        have hgerm_rel : ∀ r : D,
            e_st ((W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom r)) =
              (U_sch.presheaf.germ V₀ y.1 hy).hom r :=
          fun r => hOpens_germ_topIso V₀ y.1 hy r
        let c' : Ry' := (W_V₀.left.presheaf.germ ⊤ y'.1 trivial).hom (V₀.topIso.inv.hom c)
