        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (η.app A)) _ hSF₂.extClass
          (Nat.zero_add n') rfl (by omega)]

  have hExtId : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      [CategoryTheory.EnoughInjectives 𝒞]
      (n : ℕ) (A B : 𝒞) (x : CategoryTheory.Abelian.Ext.{u} A B n),
      CategoryTheory.Abelian.Ext.mapExactFunctor (CategoryTheory.Functor.id 𝒞) x = x := by
    intro 𝒞 _ _ _ _ n
    induction n with
    | zero =>
      intro A B x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A B).2 x
      exact CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ (CategoryTheory.Functor.id 𝒞) f
    | succ n' ih =>
      intro A B x
      let I := CategoryTheory.Injective.under B
      let ι : B ⟶ I := CategoryTheory.Injective.ι B
      let S := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hSub : Subsingleton (CategoryTheory.Abelian.Ext.{u} A I (n' + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton I 1 (n' + 1)
          (Nat.succ_le_succ (Nat.zero_le n')) A
      have h0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (n' + 1)) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨δ, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS x h0 rfl
      have hSid : (S.map (CategoryTheory.Functor.id 𝒞)).ShortExact :=
        hS.map_of_exact (CategoryTheory.Functor.id 𝒞)
      let φ_id : S.map (CategoryTheory.Functor.id 𝒞) ⟶ S :=
        { τ₁ := 𝟙 S.X₁, τ₂ := 𝟙 S.X₂, τ₃ := 𝟙 S.X₃ }
      have hExtEq : hSid.extClass = hS.extClass := by
        have h1 := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSid hS φ_id
        simpa [φ_id, CategoryTheory.Abelian.Ext.comp_mk₀_id,
          CategoryTheory.Abelian.Ext.mk₀_id_comp] using h1
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (CategoryTheory.Functor.id 𝒞) hS,
        ih A S.X₃ δ, hExtEq]

  have hExtComp : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      [CategoryTheory.EnoughInjectives 𝒞]
      {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Abelian 𝒟] [CategoryTheory.HasExt.{u} 𝒟]
      {ℰ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} ℰ]
      [CategoryTheory.Abelian ℰ] [CategoryTheory.HasExt.{u} ℰ]
      (F : CategoryTheory.Functor 𝒞 𝒟) (G : CategoryTheory.Functor 𝒟 ℰ)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      [hAddFG : (F.comp G).Additive]
      [hLimFG : CategoryTheory.Limits.PreservesFiniteLimits (F.comp G)]
      [hColimFG : CategoryTheory.Limits.PreservesFiniteColimits (F.comp G)]
      (n : ℕ) (A B : 𝒞) (x : CategoryTheory.Abelian.Ext.{u} A B n),
      @CategoryTheory.Abelian.Ext.mapExactFunctor _ _ _ _ _ _ (F.comp G)
        hAddFG hLimFG hColimFG _ _ _ _ _ x =
      CategoryTheory.Abelian.Ext.mapExactFunctor G
        (CategoryTheory.Abelian.Ext.mapExactFunctor F x) := by
    intro 𝒞 _ _ _ _ 𝒟 _ _ _ ℰ _ _ _ F G _ _ _ _ _ _ hAddFG hLimFG hColimFG n
    induction n with
    | zero =>
      intro A B x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A B).2 x
