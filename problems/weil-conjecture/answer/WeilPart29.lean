      (Φ : 𝒟 ≌ 𝒞) {One_sm ℱ_sm : 𝒞} {One_lg G_lg : 𝒟}
      (u_X : One_sm ≅ Φ.functor.obj One_lg) (θ : ℱ_sm ≅ Φ.functor.obj G_lg)
      (q : One_sm ⟶ ℱ_sm) (w : One_lg ⟶ G_lg),
      q ≫ θ.hom = u_X.hom ≫ Φ.functor.map w →
      Φ.inverse.map q =
        (Φ.inverse.map u_X.hom ≫ Φ.unitIso.inv.app One_lg) ≫ w ≫
          (Φ.unitIso.hom.app G_lg ≫ Φ.inverse.map θ.inv) := by
