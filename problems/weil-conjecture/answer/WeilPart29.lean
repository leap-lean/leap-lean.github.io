        CategoryTheory.MorphismProperty.Over.homMk hV.fromSpec rfl trivial
      refine ⟨m, c_hom ≫ f_aff, u_spec ≫ c_inv.left, ?_⟩
      have hc_left : c_inv.left ≫ c_hom.left = 𝟙 _ :=
        congrArg (fun φ => ((AlgebraicGeometry.Scheme.Etale.forget S₀).map φ).left) hc
      exact (CategoryTheory.Category.assoc u_spec _ _).trans
        ((congrArg (u_spec ≫ ·) (CategoryTheory.Category.assoc c_inv.left c_hom.left _).symm).trans
          ((congrArg (fun k => u_spec ≫ (k ≫ hV.fromSpec)) hc_left).trans
            ((congrArg (u_spec ≫ ·) (CategoryTheory.Category.id_comp hV.fromSpec)).trans hu_spec)))
    let X_germ : Type u :=
      Σ (m : M_sm) (_ : { u : Z₀ ⟶ (F_sm.obj m).left // u ≫ (F_sm.obj m).hom = g_y }),
        ↥(𝒢.obj.obj (Opposite.op (F_sm.obj m)))
    let rel_germ : X_germ → X_germ → Prop := fun x₁ x₂ =>
      ∃ (V : S₀.Etale) (v₁ : V ⟶ F_sm.obj x₁.1) (v₂ : V ⟶ F_sm.obj x₂.1)
        (w : Z₀ ⟶ V.left),
        w ≫ v₁.left = x₁.2.1.1 ∧
        w ≫ v₂.left = x₂.2.1.1 ∧
        𝒢.obj.map (Opposite.op v₁) x₁.2.2 = 𝒢.obj.map (Opposite.op v₂) x₂.2.2
    have hEquiv_germ : Equivalence rel_germ := by
      refine ⟨?_, ?_, ?_⟩
      · intro x
        exact ⟨F_sm.obj x.1, 𝟙 _, 𝟙 _, x.2.1.1, CategoryTheory.Category.comp_id _,
          CategoryTheory.Category.comp_id _, rfl⟩
      · rintro x₁ x₂ ⟨V, v₁, v₂, w, hw₁, hw₂, hs⟩
        exact ⟨V, v₂, v₁, w, hw₂, hw₁, hs.symm⟩
      · rintro x₁ x₂ x₃ ⟨V_a, v_a1, v_a2, w_a, hwa1, hwa2, hsa⟩
          ⟨V_b, v_b2, v_b3, w_b, hwb2, hwb3, hsb⟩
        have : AlgebraicGeometry.Etale (F_sm.obj x₂.1).hom := (F_sm.obj x₂.1).prop
        have : AlgebraicGeometry.Etale V_a.hom := V_a.prop
        have : AlgebraicGeometry.Etale V_b.hom := V_b.prop
        have : AlgebraicGeometry.Etale v_a2.left :=
          CategoryTheory.MorphismProperty.of_postcomp
            (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
            v_a2.left (F_sm.obj x₂.1).hom inferInstance
            ((CategoryTheory.MorphismProperty.Over.w v_a2).symm ▸
              (inferInstance : AlgebraicGeometry.Etale V_a.hom))
        have : AlgebraicGeometry.Etale v_b2.left :=
          CategoryTheory.MorphismProperty.of_postcomp
            (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
            v_b2.left (F_sm.obj x₂.1).hom inferInstance
            ((CategoryTheory.MorphismProperty.Over.w v_b2).symm ▸
              (inferInstance : AlgebraicGeometry.Etale V_b.hom))
        let W_sch := CategoryTheory.Limits.pullback v_a2.left v_b2.left
        let p₁_left : W_sch ⟶ V_a.left := CategoryTheory.Limits.pullback.fst v_a2.left v_b2.left
        let p₂_left : W_sch ⟶ V_b.left := CategoryTheory.Limits.pullback.snd v_a2.left v_b2.left
        let W_et : S₀.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁_left ≫ V_a.hom) inferInstance
        let p₁ : W_et ⟶ V_a := CategoryTheory.MorphismProperty.Over.homMk p₁_left rfl trivial
        let p₂ : W_et ⟶ V_b := CategoryTheory.MorphismProperty.Over.homMk p₂_left
          ((congrArg (p₂_left ≫ ·) (CategoryTheory.MorphismProperty.Over.w v_b2).symm).trans
            ((CategoryTheory.Category.assoc p₂_left v_b2.left _).symm.trans
              ((congrArg (· ≫ (F_sm.obj x₂.1).hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc p₁_left v_a2.left _).trans
                  (congrArg (p₁_left ≫ ·) (CategoryTheory.MorphismProperty.Over.w v_a2))))))
          trivial
        have hp_mid : p₁ ≫ v_a2 = p₂ ≫ v_b2 :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
        let w_ab : Z₀ ⟶ W_sch := CategoryTheory.Limits.pullback.lift w_a w_b (hwa2.trans hwb2.symm)
        refine ⟨W_et, p₁ ≫ v_a1, p₂ ≫ v_b3, w_ab, ?_, ?_, ?_⟩
        · exact (CategoryTheory.Category.assoc w_ab p₁_left v_a1.left).symm.trans
            ((congrArg (· ≫ v_a1.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans hwa1)
        · exact (CategoryTheory.Category.assoc w_ab p₂_left v_b3.left).symm.trans
            ((congrArg (· ≫ v_b3.left) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans hwb3)
        · exact (hMapComp 𝒢.obj p₁ v_a1 x₁.2.2).trans
            ((congrArg (𝒢.obj.map (Opposite.op p₁)) hsa).trans
              ((hMapComp 𝒢.obj p₁ v_a2 x₂.2.2).symm.trans
                ((congrArg (fun k => 𝒢.obj.map (Opposite.op k) x₂.2.2) hp_mid).trans
                  ((hMapComp 𝒢.obj p₂ v_b2 x₂.2.2).trans
                    ((congrArg (𝒢.obj.map (Opposite.op p₂)) hsb).trans
                      (hMapComp 𝒢.obj p₂ v_b3 x₃.2.2).symm)))))
    let S_germ : Setoid X_germ := ⟨rel_germ, hEquiv_germ⟩
    let toGerm : ∀ (U : S₀.Etale) (u : Z₀ ⟶ U.left), u ≫ U.hom = g_y →
        ↥(𝒢.obj.obj (Opposite.op U)) → X_germ :=
      fun U u hu s =>
        let m := (hExAffRef U u hu).choose
        let f_m := (hExAffRef U u hu).choose_spec.choose
        let w_m := (hExAffRef U u hu).choose_spec.choose_spec.choose
        let hw_m := (hExAffRef U u hu).choose_spec.choose_spec.choose_spec
        ⟨m, ⟨w_m,
          (congrArg (w_m ≫ ·) (CategoryTheory.MorphismProperty.Over.w f_m).symm).trans
            ((CategoryTheory.Category.assoc w_m f_m.left U.hom).symm.trans
              ((congrArg (· ≫ U.hom) hw_m).trans hu))⟩,
          𝒢.obj.map (Opposite.op f_m) s⟩
    have hToGermSpec : ∀ (U : S₀.Etale) (u : Z₀ ⟶ U.left) (hu : u ≫ U.hom = g_y)
        (s : ↥(𝒢.obj.obj (Opposite.op U))) (m' : M_sm) (f' : F_sm.obj m' ⟶ U)
        (w' : Z₀ ⟶ (F_sm.obj m').left) (hw' : w' ≫ f'.left = u)
        (hw'_gy : w' ≫ (F_sm.obj m').hom = g_y),
        rel_germ (toGerm U u hu s) ⟨m', ⟨w', hw'_gy⟩, 𝒢.obj.map (Opposite.op f') s⟩ := by
      intro U u hu s m' f' w' hw' hw'_gy
      let m := (hExAffRef U u hu).choose
      let f_m := (hExAffRef U u hu).choose_spec.choose
      let w_m := (hExAffRef U u hu).choose_spec.choose_spec.choose
      let hw_m := (hExAffRef U u hu).choose_spec.choose_spec.choose_spec
      have : AlgebraicGeometry.Etale U.hom := U.prop
      have : AlgebraicGeometry.Etale (F_sm.obj m).hom := (F_sm.obj m).prop
      have : AlgebraicGeometry.Etale (F_sm.obj m').hom := (F_sm.obj m').prop
      have : AlgebraicGeometry.Etale f_m.left :=
        CategoryTheory.MorphismProperty.of_postcomp
          (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
          f_m.left U.hom inferInstance
          ((CategoryTheory.MorphismProperty.Over.w f_m).symm ▸
            (inferInstance : AlgebraicGeometry.Etale (F_sm.obj m).hom))
      have : AlgebraicGeometry.Etale f'.left :=
        CategoryTheory.MorphismProperty.of_postcomp
          (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
          f'.left U.hom inferInstance
          ((CategoryTheory.MorphismProperty.Over.w f').symm ▸
            (inferInstance : AlgebraicGeometry.Etale (F_sm.obj m').hom))
      let W_sch := CategoryTheory.Limits.pullback f_m.left f'.left
      let p₁_left : W_sch ⟶ (F_sm.obj m).left := CategoryTheory.Limits.pullback.fst f_m.left f'.left
      let p₂_left : W_sch ⟶ (F_sm.obj m').left := CategoryTheory.Limits.pullback.snd f_m.left f'.left
      let W_et : S₀.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁_left ≫ (F_sm.obj m).hom) inferInstance
      let p₁ : W_et ⟶ F_sm.obj m := CategoryTheory.MorphismProperty.Over.homMk p₁_left rfl trivial
      let p₂ : W_et ⟶ F_sm.obj m' := CategoryTheory.MorphismProperty.Over.homMk p₂_left
        ((congrArg (p₂_left ≫ ·) (CategoryTheory.MorphismProperty.Over.w f').symm).trans
          ((CategoryTheory.Category.assoc p₂_left f'.left U.hom).symm.trans
            ((congrArg (· ≫ U.hom) CategoryTheory.Limits.pullback.condition.symm).trans
              ((CategoryTheory.Category.assoc p₁_left f_m.left U.hom).trans
                (congrArg (p₁_left ≫ ·) (CategoryTheory.MorphismProperty.Over.w f_m))))))
        trivial
      have hp_eq : p₁ ≫ f_m = p₂ ≫ f' :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
      let w_W : Z₀ ⟶ W_sch := CategoryTheory.Limits.pullback.lift w_m w' (hw_m.trans hw'.symm)
      refine ⟨W_et, p₁, p₂, w_W, CategoryTheory.Limits.pullback.lift_fst _ _ _,
        CategoryTheory.Limits.pullback.lift_snd _ _ _, ?_⟩
      exact (hMapComp 𝒢.obj p₁ f_m s).symm.trans
        ((congrArg (fun φ : W_et ⟶ U => 𝒢.obj.map (Opposite.op φ) s) hp_eq).trans
          (hMapComp 𝒢.obj p₂ f' s))
    have hToGermSelf : ∀ x : X_germ,
        rel_germ (toGerm (F_sm.obj x.1) x.2.1.1 x.2.1.2 x.2.2) x := by
      intro x
      have h := hToGermSpec (F_sm.obj x.1) x.2.1.1 x.2.1.2 x.2.2 x.1 (𝟙 _) x.2.1.1
        (CategoryTheory.Category.comp_id _) x.2.1.2
      have hid : (⟨x.1, ⟨x.2.1.1, x.2.1.2⟩, 𝒢.obj.map (Opposite.op (𝟙 (F_sm.obj x.1))) x.2.2⟩ : X_germ) = x := by
        rcases x with ⟨m, ⟨u, hu⟩, s⟩
        congr 2
        exact hMapId 𝒢.obj s
      exact Eq.mp (congrArg (rel_germ (toGerm (F_sm.obj x.1) x.2.1.1 x.2.1.2 x.2.2)) hid) h
    have hToGermNat : ∀ {U₁ U₂ : S₀.Etale} (v : U₁ ⟶ U₂) (u₁ : Z₀ ⟶ U₁.left)
        (hu₁ : u₁ ≫ U₁.hom = g_y) (hu₂ : (u₁ ≫ v.left) ≫ U₂.hom = g_y)
        (s₂ : ↥(𝒢.obj.obj (Opposite.op U₂))),
        rel_germ (toGerm U₁ u₁ hu₁ (𝒢.obj.map (Opposite.op v) s₂))
          (toGerm U₂ (u₁ ≫ v.left) hu₂ s₂) := by
      intro U₁ U₂ v u₁ hu₁ hu₂ s₂
      let m₁ := (hExAffRef U₁ u₁ hu₁).choose
      let f₁ := (hExAffRef U₁ u₁ hu₁).choose_spec.choose
      let w₁ := (hExAffRef U₁ u₁ hu₁).choose_spec.choose_spec.choose
      let hw₁ := (hExAffRef U₁ u₁ hu₁).choose_spec.choose_spec.choose_spec
      have hw₁_v : w₁ ≫ (f₁ ≫ v).left = u₁ ≫ v.left :=
        (CategoryTheory.Category.assoc w₁ f₁.left v.left).symm.trans (congrArg (· ≫ v.left) hw₁)
      have hw₁_gy : w₁ ≫ (F_sm.obj m₁).hom = g_y :=
        (congrArg (w₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w f₁).symm).trans
          ((CategoryTheory.Category.assoc w₁ f₁.left U₁.hom).symm.trans
            ((congrArg (· ≫ U₁.hom) hw₁).trans hu₁))
      have h := hToGermSpec U₂ (u₁ ≫ v.left) hu₂ s₂ m₁ (f₁ ≫ v) w₁ hw₁_v hw₁_gy
      have hEq : (⟨m₁, ⟨w₁, hw₁_gy⟩, 𝒢.obj.map (Opposite.op (f₁ ≫ v)) s₂⟩ : X_germ) =
          toGerm U₁ u₁ hu₁ (𝒢.obj.map (Opposite.op v) s₂) := by
        dsimp only [toGerm]
        congr 2
        exact hMapComp 𝒢.obj f₁ v s₂
      exact hEquiv_germ.symm (hEq ▸ h)
    let zeroRaw : X_germ :=
      toGerm (weilEtaleIdTerminal S₀) g_y (CategoryTheory.Category.comp_id g_y) 0
    let negRaw : X_germ → X_germ := fun x => ⟨x.1, x.2.1, -x.2.2⟩
    let addRaw : X_germ → X_germ → X_germ := fun x₁ x₂ =>
      let U₁ := F_sm.obj x₁.1
      let U₂ := F_sm.obj x₂.1
      letI : AlgebraicGeometry.Etale U₁.hom := U₁.prop
      letI : AlgebraicGeometry.Etale U₂.hom := U₂.prop
      let W_sch := CategoryTheory.Limits.pullback U₁.hom U₂.hom
      let p₁_left : W_sch ⟶ U₁.left := CategoryTheory.Limits.pullback.fst U₁.hom U₂.hom
      let p₂_left : W_sch ⟶ U₂.left := CategoryTheory.Limits.pullback.snd U₁.hom U₂.hom
      let W_et : S₀.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁_left ≫ U₁.hom) inferInstance
      let π₁ : W_et ⟶ U₁ := CategoryTheory.MorphismProperty.Over.homMk p₁_left rfl trivial
      let π₂ : W_et ⟶ U₂ := CategoryTheory.MorphismProperty.Over.homMk p₂_left
        CategoryTheory.Limits.pullback.condition.symm trivial
      let u_W : Z₀ ⟶ W_et.left :=
        CategoryTheory.Limits.pullback.lift x₁.2.1.1 x₂.2.1.1 (x₁.2.1.2.trans x₂.2.1.2.symm)
      have hu_W : u_W ≫ W_et.hom = g_y :=
        (CategoryTheory.Category.assoc u_W p₁_left U₁.hom).symm.trans
          ((congrArg (· ≫ U₁.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans x₁.2.1.2)
      toGerm W_et u_W hu_W (𝒢.obj.map (Opposite.op π₁) x₁.2.2 + 𝒢.obj.map (Opposite.op π₂) x₂.2.2)
    have hAddRef : ∀ (x₁ x₂ : X_germ) (V : S₀.Etale)
        (f₁ : V ⟶ F_sm.obj x₁.1) (f₂ : V ⟶ F_sm.obj x₂.1) (w : Z₀ ⟶ V.left)
        (hw : w ≫ V.hom = g_y),
        w ≫ f₁.left = x₁.2.1.1 → w ≫ f₂.left = x₂.2.1.1 →
        rel_germ (addRaw x₁ x₂)
          (toGerm V w hw (𝒢.obj.map (Opposite.op f₁) x₁.2.2 + 𝒢.obj.map (Opposite.op f₂) x₂.2.2)) := by
      intro x₁ x₂ V f₁ f₂ w hw hwf₁ hwf₂
      let U₁ := F_sm.obj x₁.1
      let U₂ := F_sm.obj x₂.1
      have : AlgebraicGeometry.Etale U₁.hom := U₁.prop
      have : AlgebraicGeometry.Etale U₂.hom := U₂.prop
      let W_sch := CategoryTheory.Limits.pullback U₁.hom U₂.hom
      let p₁_left : W_sch ⟶ U₁.left := CategoryTheory.Limits.pullback.fst U₁.hom U₂.hom
      let p₂_left : W_sch ⟶ U₂.left := CategoryTheory.Limits.pullback.snd U₁.hom U₂.hom
      let W_et : S₀.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁_left ≫ U₁.hom) inferInstance
      let π₁ : W_et ⟶ U₁ := CategoryTheory.MorphismProperty.Over.homMk p₁_left rfl trivial
      let π₂ : W_et ⟶ U₂ := CategoryTheory.MorphismProperty.Over.homMk p₂_left
        CategoryTheory.Limits.pullback.condition.symm trivial
      have hf₁₂ : f₁.left ≫ U₁.hom = f₂.left ≫ U₂.hom :=
        (CategoryTheory.MorphismProperty.Over.w f₁).trans
          (CategoryTheory.MorphismProperty.Over.w f₂).symm
      let Φ_left : V.left ⟶ W_sch := CategoryTheory.Limits.pullback.lift f₁.left f₂.left hf₁₂
      let Φ : V ⟶ W_et := CategoryTheory.MorphismProperty.Over.homMk Φ_left
        ((CategoryTheory.Category.assoc Φ_left p₁_left U₁.hom).symm.trans
          ((congrArg (· ≫ U₁.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            (CategoryTheory.MorphismProperty.Over.w f₁))) trivial
      have hΦ₁ : Φ ≫ π₁ = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Limits.pullback.lift_fst _ _ _) (Subsingleton.elim _ _)
      have hΦ₂ : Φ ≫ π₂ = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) (Subsingleton.elim _ _)
      have hwΦ : w ≫ Φ.left =
          CategoryTheory.Limits.pullback.lift x₁.2.1.1 x₂.2.1.1 (x₁.2.1.2.trans x₂.2.1.2.symm) := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc w Φ_left p₁_left).trans
            ((congrArg (w ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (hwf₁.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))
        · exact (CategoryTheory.Category.assoc w Φ_left p₂_left).trans
            ((congrArg (w ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              (hwf₂.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm))
      have hwΦ_gy : (w ≫ Φ.left) ≫ W_et.hom = g_y :=
        (CategoryTheory.Category.assoc w Φ.left W_et.hom).trans
          ((congrArg (w ≫ ·) (CategoryTheory.MorphismProperty.Over.w Φ)).trans hw)
      have hmap_sum : 𝒢.obj.map (Opposite.op Φ)
          (𝒢.obj.map (Opposite.op π₁) x₁.2.2 + 𝒢.obj.map (Opposite.op π₂) x₂.2.2) =
          𝒢.obj.map (Opposite.op f₁) x₁.2.2 + 𝒢.obj.map (Opposite.op f₂) x₂.2.2 :=
        ((𝒢.obj.map (Opposite.op Φ)).hom.map_add _ _).trans
          (congrArg₂ (· + ·)
            ((hMapComp 𝒢.obj Φ π₁ x₁.2.2).symm.trans
              (congrArg (fun k => 𝒢.obj.map (Opposite.op k) x₁.2.2) hΦ₁))
            ((hMapComp 𝒢.obj Φ π₂ x₂.2.2).symm.trans
              (congrArg (fun k => 𝒢.obj.map (Opposite.op k) x₂.2.2) hΦ₂)))
      have hnat := hToGermNat Φ w hw hwΦ_gy
        (𝒢.obj.map (Opposite.op π₁) x₁.2.2 + 𝒢.obj.map (Opposite.op π₂) x₂.2.2)
      have hlhs : toGerm V w hw (𝒢.obj.map (Opposite.op Φ)
          (𝒢.obj.map (Opposite.op π₁) x₁.2.2 + 𝒢.obj.map (Opposite.op π₂) x₂.2.2)) =
          toGerm V w hw (𝒢.obj.map (Opposite.op f₁) x₁.2.2 + 𝒢.obj.map (Opposite.op f₂) x₂.2.2) :=
        congrArg (toGerm V w hw) hmap_sum
      have hrhs : toGerm W_et (w ≫ Φ.left) hwΦ_gy
          (𝒢.obj.map (Opposite.op π₁) x₁.2.2 + 𝒢.obj.map (Opposite.op π₂) x₂.2.2) =
          addRaw x₁ x₂ := by
        dsimp only [addRaw]
        congr 1
      exact hEquiv_germ.symm (hlhs ▸ hrhs ▸ hnat)
    have hGermHomAdd_raw : ∀ (U : S₀.Etale) (u : Z₀ ⟶ U.left) (hu : u ≫ U.hom = g_y)
        (s₁ s₂ : ↥(𝒢.obj.obj (Opposite.op U))),
        rel_germ (addRaw (toGerm U u hu s₁) (toGerm U u hu s₂)) (toGerm U u hu (s₁ + s₂)) := by
      intro U u hu s₁ s₂
      let g₁ := toGerm U u hu s₁
      let g₂ := toGerm U u hu s₂
      have hr := hAddRef g₁ g₂ (F_sm.obj g₁.1) (𝟙 _) (𝟙 _) g₁.2.1.1 g₁.2.1.2
        (CategoryTheory.Category.comp_id _) (CategoryTheory.Category.comp_id _)
      have hsum : 𝒢.obj.map (Opposite.op (𝟙 (F_sm.obj g₁.1))) g₁.2.2 +
          𝒢.obj.map (Opposite.op (𝟙 (F_sm.obj g₁.1))) g₂.2.2 =
          (toGerm U u hu (s₁ + s₂)).2.2 :=
        (congrArg₂ (· + ·) (hMapId 𝒢.obj g₁.2.2) (hMapId 𝒢.obj g₂.2.2)).trans
          ((𝒢.obj.map (Opposite.op (hExAffRef U u hu).choose_spec.choose)).hom.map_add s₁ s₂).symm
      have hEq : toGerm (F_sm.obj g₁.1) g₁.2.1.1 g₁.2.1.2
          (𝒢.obj.map (Opposite.op (𝟙 (F_sm.obj g₁.1))) g₁.2.2 +
            𝒢.obj.map (Opposite.op (𝟙 (F_sm.obj g₁.1))) g₂.2.2) =
          toGerm (F_sm.obj (toGerm U u hu (s₁ + s₂)).1)
