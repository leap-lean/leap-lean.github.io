import WeilPart28
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_gysin_kummer_prime_power_short_exact_and_connecting_class (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k)) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    ∃ κ : ∀ {V : AlgebraicGeometry.Scheme.{u}} (_ : Quiver.Hom V S_k) (r : ℕ),
        Additive (Units ↑(V.presheaf.obj (Opposite.op ⊤))) →+ weilEtaleTorsionH V (ℓ ^ r) 1,
      ∀ {V : AlgebraicGeometry.Scheme.{u}} (p_V : Quiver.Hom V S_k),
        (∀ r : ℕ,
          (∀ x : Additive (Units ↑(V.presheaf.obj (Opposite.op ⊤))),
            κ p_V r x = 0 ↔
              ∃ y : Additive (Units ↑(V.presheaf.obj (Opposite.op ⊤))), (ℓ ^ r) • y = x) ∧
          (Subsingleton ((weilEtaleGmSheaf V).H 1) → Function.Surjective (κ p_V r))) ∧
        (∀ r : ℕ,
          (∀ x : Additive (Units ↑(V.presheaf.obj (Opposite.op ⊤))),
            ∃ y : Additive (Units ↑(V.presheaf.obj (Opposite.op ⊤))), (ℓ ^ r) • y = x) →
          Subsingleton ((weilEtaleGmSheaf V).H 1) →
          Subsingleton ((weilEtaleGmSheaf V).H 2) →
          Subsingleton (weilEtaleTorsionH V (ℓ ^ r) 1) ∧
            Subsingleton (weilEtaleTorsionH V (ℓ ^ r) 2)) ∧
        (∀ (r : ℕ) (x : Additive (Units ↑(V.presheaf.obj (Opposite.op ⊤)))),
          weilEtaleTorsionTransition V ℓ r 1 (κ p_V (r + 1) x) = κ p_V r x) ∧
        (∀ {V' : AlgebraicGeometry.Scheme.{u}} (p_V' : Quiver.Hom V' S_k)
            (f : Quiver.Hom V' V),
          CategoryTheory.CategoryStruct.comp f p_V = p_V' →
          ∀ (r : ℕ) (p_f : weilEtaleTorsionH V (ℓ ^ r) 1 →+ weilEtaleTorsionH V' (ℓ ^ r) 1),
            WeilIsTorsionEtalePullback f (ℓ ^ r) 1 p_f →
            ∀ (u : Units ↑(V.presheaf.obj (Opposite.op ⊤))),
              p_f (κ p_V r (Additive.ofMul u)) =
                κ p_V' r (Additive.ofMul (Units.map f.appTop.hom.toMonoidHom u))) :=
by
  classical
  have pillar1_gm_isSheaf :
      ∀ X : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X) := by
    classical
    have hAmitsur : ∀ (A : Type u) [CommRing A] (ι : Type u) [Fintype ι]
        (B : ι → Type u) [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)] [∀ i, Module.Flat A (B i)],
        (∀ p : PrimeSpectrum A, ∃ (i : ι) (q : PrimeSpectrum (B i)),
          PrimeSpectrum.comap (algebraMap A (B i)) q = p) →
        (∀ (D : Type u) [CommRing D] [Algebra A D] (d₁ d₂ : D),
          (∀ i : ι, (d₁ : D) ⊗ₜ[A] (1 : B i) = (d₂ : D) ⊗ₜ[A] (1 : B i)) → d₁ = d₂) ∧
        (∀ b : ∀ i : ι, B i,
          (∀ i j : ι, (b i) ⊗ₜ[A] (1 : B j) = (1 : B i) ⊗ₜ[A] (b j)) →
          ∃ a : A, ∀ i : ι, algebraMap A (B i) a = b i) := by
      intro A _ ι _ B _ _ _ hSurj
      let P := ∀ i : ι, B i
      have : Module.Flat A (DirectSum ι B) := Module.Flat.directSum
      have : Module.Flat A P :=
        Module.Flat.of_linearEquiv (DirectSum.linearEquivFunOnFintype A ι B).symm
      have hSurjP : Function.Surjective (PrimeSpectrum.comap (algebraMap A P)) := by
        intro p
        obtain ⟨i₀, q₀, hq₀⟩ := hSurj p
        refine ⟨PrimeSpectrum.comap (Pi.evalRingHom B i₀) q₀, ?_⟩
        have hcomp : (Pi.evalRingHom B i₀).comp (algebraMap A P) = algebraMap A (B i₀) :=
          RingHom.ext (fun _ => rfl)
        rw [← PrimeSpectrum.comap_comp_apply, hcomp, hq₀]
      have : Module.FaithfullyFlat A P := Module.FaithfullyFlat.of_comap_surjective hSurjP
      have hPiSum : ∀ x : P, x = ∑ i : ι, LinearMap.single A B i (x i) := by
        intro x
        ext j
        simp [LinearMap.single_apply, Finset.sum_apply]
      refine ⟨?_, ?_⟩
      · intro D _ _ d₁ d₂ hd
        have : Module.FaithfullyFlat D (TensorProduct A D P) := inferInstance
        apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := D) (B := TensorProduct A D P) D
        have hmk : ∀ d : D,
            (TensorProduct.mk D (TensorProduct A D P) D 1) d =
              (1 : TensorProduct A D P) ⊗ₜ[D] d := fun _ => rfl
        rw [hmk d₁, hmk d₂]
        have hsmul : ∀ d : D,
            (1 : TensorProduct A D P) ⊗ₜ[D] d = (d ⊗ₜ[A] (1 : P)) ⊗ₜ[D] (1 : D) := by
          intro d
          calc
            (1 : TensorProduct A D P) ⊗ₜ[D] d =
                (1 : TensorProduct A D P) ⊗ₜ[D] (d • (1 : D)) := by rw [smul_eq_mul, mul_one]
            _ = (d • (1 : TensorProduct A D P)) ⊗ₜ[D] (1 : D) :=
              (TensorProduct.smul_tmul d (1 : TensorProduct A D P) (1 : D)).symm
            _ = (d ⊗ₜ[A] (1 : P)) ⊗ₜ[D] (1 : D) := by
              congr 1
              change d • ((1 : D) ⊗ₜ[A] (1 : P)) = d ⊗ₜ[A] (1 : P)
              rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hsmul d₁, hsmul d₂]
        congr 1
        conv_lhs => rw [hPiSum (1 : P), TensorProduct.tmul_sum]
        conv_rhs => rw [hPiSum (1 : P), TensorProduct.tmul_sum]
        apply Finset.sum_congr rfl
        intro i _
        change LinearMap.lTensor D (LinearMap.single A B i) (d₁ ⊗ₜ[A] (1 : B i)) =
          LinearMap.lTensor D (LinearMap.single A B i) (d₂ ⊗ₜ[A] (1 : B i))
        rw [hd i]
      · intro b hb
        let ε : A →ₗ[A] P := Algebra.linearMap A P
        let δ : P →ₗ[A] TensorProduct A P P :=
          LinearMap.flip (TensorProduct.mk A P P) 1 - TensorProduct.mk A P P 1
        have hδb : δ b = 0 := by
          change b ⊗ₜ[A] (1 : P) - (1 : P) ⊗ₜ[A] b = 0
          rw [sub_eq_zero]
          conv_lhs =>
            rw [hPiSum b, hPiSum (1 : P), TensorProduct.sum_tmul]
            arg 2; ext i; rw [TensorProduct.tmul_sum]
          conv_rhs =>
            rw [hPiSum (1 : P), hPiSum b, TensorProduct.sum_tmul]
            arg 2; ext i; rw [TensorProduct.tmul_sum]
          apply Finset.sum_congr rfl
          intro i _
          apply Finset.sum_congr rfl
          intro j _
          change TensorProduct.map (LinearMap.single A B i) (LinearMap.single A B j)
              ((b i) ⊗ₜ[A] (1 : B j)) =
            TensorProduct.map (LinearMap.single A B i) (LinearMap.single A B j)
              ((1 : B i) ⊗ₜ[A] (b j))
          rw [hb i j]
        have hExL : Function.Exact (LinearMap.lTensor P ε) (LinearMap.lTensor P δ) := by
          rw [LinearMap.exact_iff]
          apply le_antisymm
          · intro w hw
            rw [LinearMap.mem_ker] at hw
            let μ : TensorProduct A P P →ₗ[A] TensorProduct A P A :=
              (LinearMap.flip (TensorProduct.mk A P A) 1).comp (LinearMap.mul' A P)
            let h₁ : TensorProduct A P (TensorProduct A P P) →ₗ[A] TensorProduct A P P :=
              (LinearMap.rTensor P (LinearMap.mul' A P)).comp
                (TensorProduct.assoc A P P P).symm.toLinearMap
            have h_id : (LinearMap.lTensor P ε).comp μ - h₁.comp (LinearMap.lTensor P δ) =
                LinearMap.id := by
              apply TensorProduct.ext'
              intro p₁ p₂
              simp [μ, h₁, δ, ε, Algebra.linearMap_apply]
            have hw_eq := LinearMap.congr_fun h_id w
            simp only [LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.id_apply, hw,
              map_zero, sub_zero] at hw_eq
            exact ⟨μ w, hw_eq⟩
          · rw [LinearMap.range_le_ker_iff, ← LinearMap.lTensor_comp]
            have h0 : δ.comp ε = 0 := by
              ext1
              change ε 1 ⊗ₜ[A] (1 : P) - (1 : P) ⊗ₜ[A] ε 1 = 0
              simp [ε]
            rw [h0, LinearMap.lTensor_zero]
        have hEx : Function.Exact ε δ :=
          Module.FaithfullyFlat.lTensor_reflects_exact A P ε δ hExL
        obtain ⟨a, ha⟩ := (hEx b).mp hδb
        exact ⟨a, fun i => congrFun ha i⟩
    intro X
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
    let G_ring_cat : CategoryTheory.Functor (Opposite X.Etale) CommRingCat.{u} :=
      { obj := fun U => ((Fgt.obj (Opposite.unop U)).left).presheaf.obj (Opposite.op ⊤)
        map := fun f => ((Fgt.map (Opposite.unop f)).left).appTop
        map_id := fun U =>
          (congrArg AlgebraicGeometry.Scheme.Hom.appTop
            (congrArg CategoryTheory.CommaMorphism.left (Fgt.map_id (Opposite.unop U)))).trans
            AlgebraicGeometry.Scheme.Hom.id_appTop
        map_comp := fun f g =>
          (congrArg AlgebraicGeometry.Scheme.Hom.appTop
            (congrArg CategoryTheory.CommaMorphism.left
              (Fgt.map_comp (Opposite.unop g) (Opposite.unop f)))).trans
            (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _) }
    let G_ring : CategoryTheory.Functor (Opposite X.Etale) (Type u) :=
      G_ring_cat ⋙ CategoryTheory.forget CommRingCat.{u}
    have hFromSpecApp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {O : Z.Opens}
        (hO : AlgebraicGeometry.IsAffineOpen O)
        (s : ↑(Z.presheaf.obj (Opposite.op ⊤))),
        (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op O))).hom.hom
          (hO.fromSpec.appTop.hom s) =
        (Z.presheaf.map (CategoryTheory.homOfLE (le_top : O ≤ ⊤)).op).hom s := by
      intro Z O hO s
      have hiso : hO.isoSpec.inv.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op O))).hom =
          O.topIso.hom := by
        calc
          hO.isoSpec.inv.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op O))).hom
            = hO.isoSpec.inv.appTop ≫
                ((AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op O))).hom ≫
                  O.topIso.inv) ≫ O.topIso.hom := by
              rw [CategoryTheory.Category.assoc, O.topIso.inv_hom_id,
                CategoryTheory.Category.comp_id]
          _ = (hO.isoSpec.hom ≫ hO.isoSpec.inv).appTop ≫ O.topIso.hom := by
              rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_hom_appTop hO,
                ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop]
          _ = O.topIso.hom := by
              rw [hO.isoSpec.hom_inv_id, AlgebraicGeometry.Scheme.Hom.id_appTop,
                CategoryTheory.Category.id_comp]
      have hdef : hO.fromSpec = hO.isoSpec.inv ≫ O.ι := rfl
      have htop : O.ι.appTop ≫ O.topIso.hom =
          Z.presheaf.map (CategoryTheory.homOfLE (le_top : O ≤ ⊤)).op := by
        erw [AlgebraicGeometry.Scheme.Opens.ι_appTop,
          AlgebraicGeometry.Scheme.Opens.topIso_hom, ← Z.presheaf.map_comp]
        rfl
      have htot : hO.fromSpec.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.obj (Opposite.op O))).hom =
          Z.presheaf.map (CategoryTheory.homOfLE (le_top : O ≤ ⊤)).op := by
        rw [hdef, AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
          hiso, htop]
      exact congrArg (fun k => k.hom s) htot
    have hMemTop : ∀ {U : X.Etale} {R : CategoryTheory.Sieve U},
        R ∈ X.smallEtaleTopology U →
        ∀ u : ↥((Fgt.obj U).left), ∃ (Y : X.Etale) (f : Y ⟶ U) (y : ↥((Fgt.obj Y).left)),
          R.arrows f ∧ AlgebraicGeometry.Etale ((Fgt.map f).left) ∧
          ((Fgt.map f).left).base y = u := by
      intro U R hR u
      let P_et_prop : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et_prop :=
        (inferInstance :
          CategoryTheory.MorphismProperty.IsMultiplicative P_et_prop).toIsStableUnderComposition
      have htop_eq : X.smallEtaleTopology = (X.smallPretopology P_et_prop P_et_prop).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X
          (le_rfl : P_et_prop ≤ P_et_prop)
      have hR_pre : R ∈ (X.smallPretopology P_et_prop P_et_prop).toGrothendieck U :=
        (congrArg (fun K : CategoryTheory.GrothendieckTopology X.Etale => R ∈ K U) htop_eq).mp hR
      exact ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et_prop) (Q := P_et_prop) U R).mp hR_pre) u
    have hRingSheaf : CategoryTheory.Presieve.IsSheaf X.smallEtaleTopology G_ring := by
      intro U R hR x hx
      let U₀ : AlgebraicGeometry.Scheme.{u} := (Fgt.obj U).left
      have hU₀_et : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
      have hAffDesc : ∀ (V : U₀.Opens) (hV : AlgebraicGeometry.IsAffineOpen V),
          let A_obj := U₀.presheaf.obj (Opposite.op V)
          ∃! a_V : ↑A_obj,
            ∀ (D : Type u) [CommRing D] (φ : ↑A_obj →+* D)
              (W : X.Etale) (w : W ⟶ U) (hw : R.arrows w)
              (e_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ (Fgt.obj W).left),
              AlgebraicGeometry.Etale e_D →
              e_D ≫ (Fgt.map w).left =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ hV.fromSpec →
              φ a_V =
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of D)).hom.hom
                  (e_D.appTop.hom (x w hw)) := by
        intro V hV A_obj
        let A : Type u := ↑A_obj
        have hLocal : ∀ p : ↥(AlgebraicGeometry.Spec A_obj),
            ∃ (Y_p : X.Etale) (f_p : Y_p ⟶ U) (hf_p : R.arrows f_p)
              (B_p : Type u) (_ : CommRing B_p) (φ_p : A →+* B_p)
              (e_p : AlgebraicGeometry.Spec (CommRingCat.of B_p) ⟶ (Fgt.obj Y_p).left),
              φ_p.Etale ∧
              AlgebraicGeometry.Etale e_p ∧
              IsOpen (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_p)).base) ∧
              p ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_p)).base ∧
              e_p ≫ (Fgt.map f_p).left =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_p) ≫ hV.fromSpec := by
          intro p
          obtain ⟨Y_p, f_p, y_p, hf_p, hEt_fp, hy_p⟩ := hMemTop hR (hV.fromSpec.base p)
          have : AlgebraicGeometry.Etale (Fgt.map f_p).left := hEt_fp
          let Z_p := CategoryTheory.Limits.pullback (Fgt.map f_p).left hV.fromSpec
          obtain ⟨z_p, hz_fst, hz_snd⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y_p p hy_p
          obtain ⟨W_p : Z_p.Opens, hWp_mem, hz_mem, _⟩ :=
            TopologicalSpace.Opens.isBasis_iff_nbhd.mp
              (AlgebraicGeometry.Scheme.isBasis_affineOpens Z_p)
              (show z_p ∈ (⊤ : Z_p.Opens) from trivial)
          have hWp : AlgebraicGeometry.IsAffineOpen W_p := hWp_mem
          let B_obj := Z_p.presheaf.obj (Opposite.op W_p)
          let B_p : Type u := ↑B_obj
          let e_p : AlgebraicGeometry.Spec (CommRingCat.of B_p) ⟶ (Fgt.obj Y_p).left :=
            hWp.fromSpec ≫ CategoryTheory.Limits.pullback.fst (Fgt.map f_p).left hV.fromSpec
          let g_p : AlgebraicGeometry.Spec (CommRingCat.of B_p) ⟶ AlgebraicGeometry.Spec A_obj :=
            hWp.fromSpec ≫ CategoryTheory.Limits.pullback.snd (Fgt.map f_p).left hV.fromSpec
          have hEt_ep : AlgebraicGeometry.Etale e_p := inferInstance
          have hEt_gp : AlgebraicGeometry.Etale g_p := inferInstance
          let φ_hom : A_obj ⟶ CommRingCat.of B_p := AlgebraicGeometry.Spec.preimage g_p
          have hg_map : AlgebraicGeometry.Spec.map φ_hom = g_p :=
            AlgebraicGeometry.Spec.map_preimage g_p
          have hφ_et : φ_hom.hom.Etale :=
            (AlgebraicGeometry.HasRingHomProperty.Spec_iff
              (P := @AlgebraicGeometry.Etale)).mp (hg_map.symm ▸ hEt_gp)
          have hOpen : IsOpen (Set.range (AlgebraicGeometry.Spec.map φ_hom).base) := by
            rw [hg_map]
            exact (AlgebraicGeometry.Scheme.Hom.isOpenMap g_p).isOpen_range
          have hp_mem : p ∈ Set.range (AlgebraicGeometry.Spec.map φ_hom).base := by
            rw [hg_map]
            refine ⟨hWp.isoSpec.hom.base ⟨z_p, hz_mem⟩, ?_⟩
            change (hWp.isoSpec.hom ≫ hWp.fromSpec ≫
              CategoryTheory.Limits.pullback.snd (Fgt.map f_p).left hV.fromSpec).base
              ⟨z_p, hz_mem⟩ = p
            have h1 : hWp.isoSpec.hom ≫ hWp.fromSpec = W_p.ι := by
              change hWp.isoSpec.hom ≫ hWp.isoSpec.inv ≫ W_p.ι = W_p.ι
              rw [← CategoryTheory.Category.assoc, hWp.isoSpec.hom_inv_id,
                CategoryTheory.Category.id_comp]
            rw [← CategoryTheory.Category.assoc hWp.isoSpec.hom hWp.fromSpec, h1]
            exact hz_snd
          have hcomm : e_p ≫ (Fgt.map f_p).left =
              AlgebraicGeometry.Spec.map φ_hom ≫ hV.fromSpec := by
            rw [hg_map]
            dsimp [e_p, g_p]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition]
          exact ⟨Y_p, f_p, hf_p, B_p, inferInstance, φ_hom.hom, e_p,
            hφ_et, hEt_ep, hOpen, hp_mem, hcomm⟩
        choose Y_p f_p hf_p B_p instB φ_p e_p hφ_et hEt_ep hOpen hp_mem hcomm using hLocal
        letI : ∀ p, CommRing (B_p p) := instB
        letI : ∀ p, Algebra A (B_p p) := fun p => (φ_p p).toAlgebra
        have : ∀ p, Algebra.Etale A (B_p p) :=
          fun p => RingHom.etale_algebraMap.mp (hφ_et p)
        have : ∀ p, Module.Flat A (B_p p) := fun _ => inferInstance
        obtain ⟨F_fin, hF_cov⟩ := isCompact_univ.elim_finite_subcover
          (fun p => Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_p p))).base)
          hOpen (fun p _ => Set.mem_iUnion.mpr ⟨p, hp_mem p⟩)
        let ι : Type u := ↥F_fin
        have hSurj_ι : ∀ q : PrimeSpectrum A, ∃ (i : ι) (r : PrimeSpectrum (B_p i.1)),
            PrimeSpectrum.comap (algebraMap A (B_p i.1)) r = q := by
          intro q
          let q_pt : ↥(AlgebraicGeometry.Spec A_obj) := q
          obtain ⟨p, hq₁⟩ := Set.mem_iUnion.mp (hF_cov (Set.mem_univ q_pt))
          obtain ⟨hpF, r, hr⟩ := Set.mem_iUnion.mp hq₁
          exact ⟨⟨p, hpF⟩, r, hr⟩
        obtain ⟨hInjA, hEqA⟩ := hAmitsur A ι (fun i => B_p i.1) hSurj_ι
        let b : ∀ i : ι, B_p i.1 := fun i =>
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (B_p i.1))).hom.hom
            ((e_p i.1).appTop.hom (x (f_p i.1) (hf_p i.1)))
        have hb_compat : ∀ i j : ι,
            (b i) ⊗ₜ[A] (1 : B_p j.1) = (1 : B_p i.1) ⊗ₜ[A] (b j) := by
          intro i j
          let C_ij := TensorProduct A (B_p i.1) (B_p j.1)
          have : Algebra.Etale (B_p i.1) C_ij :=
            Algebra.Etale.baseChange A (B_p j.1) (B_p i.1)
          let inl_hom : CommRingCat.of (B_p i.1) ⟶ CommRingCat.of C_ij :=
            CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
          let inr_hom : CommRingCat.of (B_p j.1) ⟶ CommRingCat.of C_ij :=
            CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := A) (A := B_p i.1)
              (B := B_p j.1)).toRingHom
          have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map inl_hom) :=
            (AlgebraicGeometry.HasRingHomProperty.Spec_iff
              (P := @AlgebraicGeometry.Etale)).mpr (RingHom.etale_algebraMap.mpr inferInstance)
          have : AlgebraicGeometry.Etale (e_p i.1) := hEt_ep i.1
          have : AlgebraicGeometry.Etale ((Fgt.obj (Y_p i.1)).hom) := (Y_p i.1).prop
          let g_i : AlgebraicGeometry.Spec (CommRingCat.of C_ij) ⟶ (Fgt.obj (Y_p i.1)).left :=
            AlgebraicGeometry.Spec.map inl_hom ≫ e_p i.1
          let g_j : AlgebraicGeometry.Spec (CommRingCat.of C_ij) ⟶ (Fgt.obj (Y_p j.1)).left :=
            AlgebraicGeometry.Spec.map inr_hom ≫ e_p j.1
          have hg_eq : g_i ≫ (Fgt.map (f_p i.1)).left = g_j ≫ (Fgt.map (f_p j.1)).left := by
            dsimp [g_i, g_j]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              hcomm i.1, hcomm j.1, ← CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
              ← AlgebraicGeometry.Spec.map_comp]
            congr 2
            apply CommRingCat.hom_ext
            ext a
            change Algebra.TensorProduct.includeLeftRingHom (φ_p i.1 a) =
              (Algebra.TensorProduct.includeRight (R := A) (A := B_p i.1) (B := B_p j.1))
