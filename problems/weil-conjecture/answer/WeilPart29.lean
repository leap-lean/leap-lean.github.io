    exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr h_m_le)

theorem weil_gysin_open_immersion_freeYoneda_zero_bdry_shortExact (Γ W₀ : AlgebraicGeometry.Scheme.{u}) (j : Quiver.Hom W₀ Γ)
    (hOpen : AlgebraicGeometry.IsOpenImmersion j)
    (hj_et : AlgebraicGeometry.Etale j)
    (n : ℕ)
    (hCont : (weilAltCdSitePullback
      (weilAltClosedComplIdeal Γ
        (@AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen)).subschemeι).IsContinuous
      Γ.smallEtaleTopology
      (weilAltClosedComplIdeal Γ
        (@AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen)).subscheme.smallEtaleTopology) :
    let I_Z := weilAltClosedComplIdeal Γ
      (@AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen)
