      have hL_nat : L.map ((CategoryTheory.Functor.const (Opposite 𝒞)).map ψ_T) ≫
          L.map (ε_const ℱ₂.obj) = L.map (ε_const ℱ₁.obj) ≫ L.map ψ.hom := by
        rw [← L.map_comp, hnat_ε, L.map_comp]
      have : CategoryTheory.IsIso (L.map (ε_const ℱ₁.obj)) := hIso_ε ℱ₁.obj
      have : CategoryTheory.IsIso (L.map (ε_const ℱ₂.obj)) := hIso_ε ℱ₂.obj
      have hLψ_eq : L.map ψ.hom =
          CategoryTheory.inv (L.map (ε_const ℱ₁.obj)) ≫
            L.map ((CategoryTheory.Functor.const (Opposite 𝒞)).map ψ_T) ≫
              L.map (ε_const ℱ₂.obj) := by
        rw [hL_nat, ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
