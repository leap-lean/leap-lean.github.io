    exact hEpi S.g
  exact ⟨hLim, hColim⟩

theorem weil_gysin_open_immersion_zero_bdry_counit_bijective (Γ W₀ : AlgebraicGeometry.Scheme.{u}) (j : Quiver.Hom W₀ Γ)
    (hOpen : AlgebraicGeometry.IsOpenImmersion j)
    (hj_et : AlgebraicGeometry.Etale j)
    (n q₀ q : ℕ) (_ : q₀ + 1 = q)
    (_ : Subsingleton
      (weilEtaleTorsionH
        (weilAltClosedComplIdeal Γ
          (@AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen)).subscheme
        n q₀))
    (_ : Subsingleton
      (weilEtaleTorsionH
        (weilAltClosedComplIdeal Γ
          (@AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen)).subscheme
        n q)) :
    Function.Bijective
      (weilGysinLocalTorsionCounitH Γ n (weilGysinEtaleObj j hj_et) q) :=
by
  have hq₀ : q₀ + 1 = q := ‹_›
  let V : Γ.Opens := @AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen
  let I_Z : Γ.IdealSheafData := weilAltClosedComplIdeal Γ V
  let Z : AlgebraicGeometry.Scheme.{u} := I_Z.subscheme
  let i_Z : Quiver.Hom Z Γ := I_Z.subschemeι
  have hSub_q₀ : Subsingleton (weilEtaleTorsionH Z n q₀) := ‹_›
  have hSub_q : Subsingleton (weilEtaleTorsionH Z n q) := ‹_›
  have : AlgebraicGeometry.IsClosedImmersion i_Z := inferInstance
  obtain ⟨hCont, _, _, _, hAdd_push, _, _, hInj, e₀, he₀_nat⟩ :=
    weil_alt_cd_etale_pullback_adjunction_and_H0 i_Z
  have : (weilAltCdSitePullback i_Z).IsContinuous
      Γ.smallEtaleTopology Z.smallEtaleTopology := hCont
  let P_push_Z := (weilAltCdSitePullback i_Z).sheafPushforwardContinuous
    AddCommGrpCat.{u} Γ.smallEtaleTopology Z.smallEtaleTopology
  obtain ⟨hLim_push, hColim_push⟩ :=
    weil_gysin_closed_immersion_etale_pushforward_exact Z Γ i_Z hCont
  have : P_push_Z.Additive := hAdd_push
  have : CategoryTheory.Limits.PreservesFiniteLimits P_push_Z := hLim_push
  have : CategoryTheory.Limits.PreservesFiniteColimits P_push_Z := hColim_push
  let Fℤ_Γ : CategoryTheory.Sheaf Γ.smallEtaleTopology AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf Γ.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
  let Fℤ_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
  have hSubTransfer : ∀ (m : ℕ) (M : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      Subsingleton (M.H m) → Subsingleton ((P_push_Z.obj M).H m) := by
    intro m
    induction m with
    | zero =>
      intro M hSub
      have : Subsingleton (M.H 0) := hSub
      exact (e₀ M).injective.subsingleton
    | succ m' ih =>
      cases m' with
      | zero =>
        intro M hSub
        let I : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
          CategoryTheory.Injective.under M
        let ι_I : Quiver.Hom M I := CategoryTheory.Injective.ι M
        let Q : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
          CategoryTheory.Limits.cokernel ι_I
        let π_Q : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π ι_I
        let S₀ : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
          CategoryTheory.ShortComplex.mk ι_I π_Q (CategoryTheory.Limits.cokernel.condition ι_I)
        have hS₀ : S₀.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_cokernel ι_I
            mono_f := inferInstance
            epi_g := inferInstance }
        have hS'₀ : (S₀.map P_push_Z).ShortExact := hS₀.map_of_exact P_push_Z
        have : CategoryTheory.Injective (P_push_Z.obj I) := hInj I inferInstance
        rw [subsingleton_iff_forall_eq 0]
        intro x'
        have hx'_zero : x'.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push_Z.map ι_I))
            (Nat.add_zero 1) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y', hy'⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Γ hS'₀ x' hx'_zero
            (Nat.zero_add 1)
        let y : Q.H 0 := e₀ Q y'
        have hy_ext : y.comp hS₀.extClass (Nat.zero_add 1) = 0 :=
          Subsingleton.elim _ 0
        obtain ⟨w, hw⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_Z hS₀ y (Nat.zero_add 1) hy_ext
        let w' : (P_push_Z.obj I).H 0 := (e₀ I).symm w
        have hy'_eq : y' = w'.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push_Z.map π_Q))
            (Nat.add_zero 0) := by
          apply (e₀ Q).injective
          rw [he₀_nat π_Q w', (e₀ I).apply_symm_apply w, hw]
        have h_comp0 : (CategoryTheory.Abelian.Ext.mk₀ (P_push_Z.map π_Q)).comp hS'₀.extClass
            (Nat.zero_add 1) = 0 :=
          hS'₀.comp_extClass
        rw [← hy', hy'_eq,
          CategoryTheory.Abelian.Ext.comp_assoc w' _ hS'₀.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
          h_comp0,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ k =>
        intro M hSub
        let I : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
          CategoryTheory.Injective.under M
        let ι_I : Quiver.Hom M I := CategoryTheory.Injective.ι M
        let Q : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
          CategoryTheory.Limits.cokernel ι_I
        let π_Q : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π ι_I
        let S₀ : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
          CategoryTheory.ShortComplex.mk ι_I π_Q (CategoryTheory.Limits.cokernel.condition ι_I)
        have hS₀ : S₀.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_cokernel ι_I
            mono_f := inferInstance
            epi_g := inferInstance }
        have hS'₀ : (S₀.map P_push_Z).ShortExact := hS₀.map_of_exact P_push_Z
        have : CategoryTheory.Injective (P_push_Z.obj I) := hInj I inferInstance
        have hSubQ : Subsingleton (Q.H (k + 1)) := by
          rw [subsingleton_iff_forall_eq 0]
          intro y
          have hy_ext : y.comp hS₀.extClass rfl = 0 := Subsingleton.elim _ 0
          obtain ⟨w, hw⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_Z hS₀ y rfl hy_ext
          have hw0 : w = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective w
          rw [← hw, hw0, CategoryTheory.Abelian.Ext.zero_comp]
        have hSubPushQ : Subsingleton ((P_push_Z.obj Q).H (k + 1)) := ih Q hSubQ
        rw [subsingleton_iff_forall_eq 0]
        intro x'
        have hx'_zero : x'.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push_Z.map ι_I))
            (Nat.add_zero (k + 2)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y', hy'⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Γ hS'₀ x' hx'_zero rfl
        have hy'0 : y' = 0 := @Subsingleton.elim _ hSubPushQ y' 0
        rw [← hy', hy'0, CategoryTheory.Abelian.Ext.zero_comp]
  obtain ⟨ρ_Z, h0, hSE⟩ :=
    weil_gysin_open_immersion_freeYoneda_zero_bdry_shortExact Γ W₀ j hOpen hj_et n hCont
  have hSubPush₀ : Subsingleton ((P_push_Z.obj (weilEtaleTorsionSheaf Z n)).H q₀) :=
    hSubTransfer q₀ (weilEtaleTorsionSheaf Z n) hSub_q₀
  have hSubPush₁ : Subsingleton ((P_push_Z.obj (weilEtaleTorsionSheaf Z n)).H q) :=
    hSubTransfer q (weilEtaleTorsionSheaf Z n) hSub_q
  let U_j : Γ.Etale := weilGysinEtaleObj j hj_et
  let ε_j := weilGysinLocalTorsionCounit Γ n U_j
  constructor
  · rw [injective_iff_map_eq_zero (weilGysinLocalTorsionCounitH Γ n U_j q)]
    intro x hx
    have hx' : x.comp (CategoryTheory.Abelian.Ext.mk₀ ε_j) (Nat.add_zero q) = 0 := hx
    obtain ⟨x₃, hx₃⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Γ hSE x hx' hq₀
    have hx₃_zero : x₃ = 0 := @Subsingleton.elim _ hSubPush₀ x₃ 0
    rw [← hx₃, hx₃_zero, CategoryTheory.Abelian.Ext.zero_comp]
  · intro y
    have hy : y.comp (CategoryTheory.Abelian.Ext.mk₀ ρ_Z) (Nat.add_zero q) = 0 :=
      @Subsingleton.elim _ hSubPush₁ _ 0
    obtain ⟨x, hx⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_Γ hSE y hy
    exact ⟨x, hx⟩

theorem weil_etale_geom_point_and_algClosed_sheaf_conservativity : (∀ (S : AlgebraicGeometry.Scheme.{u}),
      (∀ (ℋ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (x : ↥S),
          let Ω_x := AlgebraicClosure ↥(S.residueField x)
          let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
          let g_x := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x)))
            (S.fromSpecResidueField x)
          ∃ (hc : (weilAltCdSitePullback g_x).IsContinuous S.smallEtaleTopology S_x.smallEtaleTopology)
            (P_pull : CategoryTheory.Functor
              (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
              (CategoryTheory.Sheaf S_x.smallEtaleTopology AddCommGrpCat.{u}))
            (_ : P_pull ⊣ @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
              (weilAltCdSitePullback g_x) AddCommGrpCat.{u} _
              S.smallEtaleTopology S_x.smallEtaleTopology hc),
            CategoryTheory.Limits.IsZero (P_pull.obj ℋ)) →
        CategoryTheory.Limits.IsZero ℋ) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
          (α : Quiver.Hom ℱ₁ ℱ₂),
        (∀ (x : ↥S),
          let Ω_x := AlgebraicClosure ↥(S.residueField x)
          let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
          let g_x := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x)))
            (S.fromSpecResidueField x)
          ∃ (hc : (weilAltCdSitePullback g_x).IsContinuous S.smallEtaleTopology S_x.smallEtaleTopology)
            (P_pull : CategoryTheory.Functor
              (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
              (CategoryTheory.Sheaf S_x.smallEtaleTopology AddCommGrpCat.{u}))
            (_ : P_pull ⊣ @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
              (weilAltCdSitePullback g_x) AddCommGrpCat.{u} _
              S.smallEtaleTopology S_x.smallEtaleTopology hc)
            (_ : P_pull.Additive)
            (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
            (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull),
            CategoryTheory.IsIso (P_pull.map α)) →
        CategoryTheory.IsIso α)) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T_Ω := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_Ω) inferInstance
      (∀ (Q : CategoryTheory.Functor (Opposite S_Ω.Etale) AddCommGrpCat.{u}),
        Subsingleton ↥(Q.obj (Opposite.op T_Ω)) →
        CategoryTheory.Limits.IsZero
          ((CategoryTheory.presheafToSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}).obj Q)) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : Quiver.Hom ℱ₁ ℱ₂),
        Function.Bijective ((ψ.hom.app (Opposite.op T_Ω)).hom) →
        CategoryTheory.IsIso ψ) ∧
      CategoryTheory.Projective
        ((CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))) :=
by
  classical
  
  have hTerm_Ω : ∀ (Ω : Type u) [Field Ω],
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T_Ω := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_Ω) inferInstance
      CategoryTheory.Limits.IsTerminal T_Ω := by
    intro Ω _ S_Ω T_Ω
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom))
      (fun W m => ?_)
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans m.w

  
  have hSecLift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (P : AlgebraicGeometry.Scheme.{u})
      (q : Quiver.Hom P (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      [AlgebraicGeometry.Etale q] (p₀ : ↥P),
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      ∃ s_P : Quiver.Hom S_Ω P,
        CategoryTheory.CategoryStruct.comp s_P q = CategoryTheory.CategoryStruct.id S_Ω ∧
        ∀ pt : ↥S_Ω, s_P.base pt = p₀ := by
    intro Ω _ _ P q _ p₀ S_Ω
    obtain ⟨V₀, hV₀, hp₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (by trivial : p₀ ∈ (⊤ : P.Opens))
    let R_V : CommRingCat.{u} := P.presheaf.obj (Opposite.op V₀)
    let A : Type u := ↥R_V
    let w_V : AlgebraicGeometry.Spec R_V ⟶ S_Ω := hV₀.fromSpec ≫ q
    have : AlgebraicGeometry.Etale w_V := inferInstance
    let ψ₀ : CommRingCat.of Ω ⟶ R_V := AlgebraicGeometry.Spec.preimage w_V
    have hψ₀_map : AlgebraicGeometry.Spec.map ψ₀ = w_V :=
      AlgebraicGeometry.Spec.map_preimage w_V
    have hψ₀_et : RingHom.Etale ψ₀.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hψ₀_map.symm ▸ (inferInstance : AlgebraicGeometry.Etale w_V))
    let _ : Algebra Ω A := ψ₀.hom.toAlgebra
    have : Algebra.Etale Ω A := RingHom.etale_algebraMap.mp hψ₀_et
    rcases (Algebra.Etale.iff_exists_algEquiv_prod Ω A).mp inferInstance with
      ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_A, hSepAi⟩
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra Ω (Ai i) := hAlgAi
    let φ_inv : (∀ i : I, Ai i) →+* A := e_A.symm.toRingHom
    let p_spec : PrimeSpectrum A := hV₀.primeIdealOf ⟨p₀, hp₀⟩
    let q_id : Ideal (∀ i : I, Ai i) := Ideal.comap φ_inv p_spec.asIdeal
    have hq_prime : q_id.IsPrime := Ideal.IsPrime.comap φ_inv
    let e_idem : I → (∀ j : I, Ai j) := fun i => Pi.single i 1
    have hsum_idem : (∑ i : I, e_idem i) = 1 := by
      ext j
      simp [e_idem]
    have hex_i₀ : ∃ i₀ : I, e_idem i₀ ∉ q_id := by
      by_contra h_none
      have h_all : ∀ i : I, e_idem i ∈ q_id := fun i =>
         Classical.not_not.mp (fun hni => h_none ⟨i, hni⟩)
      have h1 : (1 : ∀ j : I, Ai j) ∈ q_id :=
        hsum_idem ▸ q_id.sum_mem (fun i _ => h_all i)
      exact hq_prime.ne_top (q_id.eq_top_of_isUnit_mem h1 isUnit_one)
    obtain ⟨i₀, hi₀⟩ := hex_i₀
    have hq_iff : ∀ z : (∀ j : I, Ai j), z ∈ q_id ↔ z i₀ = 0 := by
      intro z
      constructor
      · intro hz
        by_contra hzi₀
        have hwz : Pi.single i₀ (z i₀)⁻¹ * z = e_idem i₀ := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [e_idem, inv_mul_cancel₀ hzi₀]
          · simp [e_idem, Pi.single_eq_of_ne hj]
        exact hi₀ (hwz ▸ q_id.mul_mem_left _ hz)
      · intro hz0
        have hez : e_idem i₀ * z = 0 := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [e_idem, hz0]
          · simp [e_idem, Pi.single_eq_of_ne hj]
        rcases hq_prime.mem_or_mem (hez ▸ q_id.zero_mem) with h1 | h2
        · exact absurd h1 hi₀
        · exact h2
    have : Algebra.IsSeparable Ω (Ai i₀) := (hSepAi i₀).2
    have : IsSepClosed Ω := IsSepClosed.of_isAlgClosed Ω
    have hbij_alg : Function.Bijective (Algebra.ofId Ω (Ai i₀)) :=
      ⟨RingHom.injective (algebraMap Ω (Ai i₀)), IsSepClosed.algebraMap_surjective Ω (Ai i₀)⟩
    let α_i₀ : Ω ≃ₐ[Ω] Ai i₀ := AlgEquiv.ofBijective (Algebra.ofId Ω (Ai i₀)) hbij_alg
    let ε : A →ₐ[Ω] Ω := α_i₀.symm.toAlgHom.comp ((Pi.evalAlgHom Ω Ai i₀).comp e_A.toAlgHom)
    have hε_zero : ∀ a : A, ε a = 0 ↔ a ∈ p_spec.asIdeal := by
      intro a
      change α_i₀.symm (e_A a i₀) = 0 ↔ a ∈ p_spec.asIdeal
      rw [(map_eq_zero_iff α_i₀.symm α_i₀.symm.injective), ← hq_iff (e_A a)]
      change e_A.symm (e_A a) ∈ p_spec.asIdeal ↔ a ∈ p_spec.asIdeal
      rw [e_A.symm_apply_apply]
    let ε_hom : R_V ⟶ CommRingCat.of Ω := CommRingCat.ofHom ε.toRingHom
    let s_P : S_Ω ⟶ P := AlgebraicGeometry.Spec.map ε_hom ≫ hV₀.fromSpec
    refine ⟨s_P, ?_, ?_⟩
    · have hcomp_ring : ψ₀ ≫ ε_hom = 𝟙 (CommRingCat.of Ω) := by
        ext c
        exact ε.commutes c
      calc
        s_P ≫ q = AlgebraicGeometry.Spec.map ε_hom ≫ w_V :=
          CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map ε_hom ≫ AlgebraicGeometry.Spec.map ψ₀ :=
          congrArg (AlgebraicGeometry.Spec.map ε_hom ≫ ·) hψ₀_map.symm
        _ = AlgebraicGeometry.Spec.map (ψ₀ ≫ ε_hom) :=
          (AlgebraicGeometry.Spec.map_comp ψ₀ ε_hom).symm
        _ = 𝟙 S_Ω := by
          rw [hcomp_ring, AlgebraicGeometry.Spec.map_id]
    · intro pt
      have hmap_pt : (AlgebraicGeometry.Spec.map ε_hom).base pt = p_spec := by
        apply PrimeSpectrum.ext
        ext a
        change ε a ∈ pt.asIdeal ↔ a ∈ p_spec.asIdeal
        have hmem_iff : ∀ c : Ω, c ∈ pt.asIdeal ↔ c = 0 := by
          intro c
          constructor
          · intro hc
            by_contra hc0
            exact pt.isPrime.ne_top (pt.asIdeal.eq_top_of_isUnit_mem hc (IsUnit.mk0 c hc0))
          · rintro rfl
            exact pt.asIdeal.zero_mem
        rw [hmem_iff (ε a)]
        exact hε_zero a
      change hV₀.fromSpec.base ((AlgebraicGeometry.Spec.map ε_hom).base pt) = p₀
      rw [hmap_pt]
      exact hV₀.fromSpec_primeIdealOf ⟨p₀, hp₀⟩

  
  have hSpecSieves : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T_Ω := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_Ω) inferInstance
      (∀ (W : S_Ω.Etale) (R : CategoryTheory.Sieve W),
        R ∈ S_Ω.smallEtaleTopology W → ∀ (τ : Quiver.Hom T_Ω W), R.arrows τ) ∧
      (∀ (E : S_Ω.Etale),
        (Nonempty (Quiver.Hom T_Ω E) ∨ (⊥ : CategoryTheory.Sieve E) ∈ S_Ω.smallEtaleTopology E) ∧
        CategoryTheory.Sieve.ofArrows (fun (_ : Quiver.Hom T_Ω E) => T_Ω) id ∈
          S_Ω.smallEtaleTopology E) := by
    intro Ω _ _ S_Ω T_Ω
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let hT_Ω := hTerm_Ω Ω
    let pt_Ω : ↥S_Ω := default
    refine ⟨?_, ?_⟩
    · intro W R hR τ
      let T_Ω' : P_et.Over ⊤ S_Ω := T_Ω
      let R₀ : CategoryTheory.Sieve T_Ω' := R.pullback τ
      have hR₀ : R₀ ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S_Ω) T_Ω' :=
        S_Ω.smallEtaleTopology.pullback_stable τ hR
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology,
        AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology] at hR₀
      · obtain ⟨Y, f, y, hf_arr, -, -⟩ := hR₀ pt_Ω
        have : AlgebraicGeometry.Etale Y.hom := Y.prop
        obtain ⟨s_Y, hs_Y, -⟩ := hSecLift Ω Y.left Y.hom y
        let s_tilde : T_Ω ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk s_Y hs_Y
        have hcomp_arr : (R.pullback τ).arrows (s_tilde ≫ f) :=
          (R.pullback τ).downward_closed hf_arr s_tilde
        have heq_id : s_tilde ≫ f = 𝟙 T_Ω := hT_Ω.hom_ext _ _
        rw [heq_id] at hcomp_arr
        change R.arrows (𝟙 T_Ω ≫ τ) at hcomp_arr
        rwa [CategoryTheory.Category.id_comp] at hcomp_arr
      · exact le_rfl
    · intro E
