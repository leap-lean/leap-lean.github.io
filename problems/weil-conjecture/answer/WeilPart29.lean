          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app K₁))
          (CategoryTheory.Abelian.Ext.mk₀ ψ)
          (Nat.add_zero d) (Nat.add_zero 0) (Nat.add_zero d)]
    have hΛ_bij0 : ∀ (K : 𝒜_E), Function.Bijective (Λ K 0) := by
      intro K
      have h_eval : ∀ (x : (P_push.obj K).H 0),
          CategoryTheory.Abelian.Ext.addEquiv₀ (Λ K 0 x) =
            ιℤ ≫ (adj.homEquiv Fℤ_B K).symm (CategoryTheory.Abelian.Ext.addEquiv₀ x) := by
        intro x
        let u : Fℤ_B ⟶ P_push.obj K := CategoryTheory.Abelian.Ext.addEquiv₀ x
        have hx : x = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
        change CategoryTheory.Abelian.Ext.addEquiv₀
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((CategoryTheory.Abelian.Ext.mapExactFunctor P_pull x).comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app K)) (Nat.add_zero 0))
            (Nat.zero_add 0)) = ιℤ ≫ (adj.homEquiv Fℤ_B K).symm u
        rw [hx, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
          AddEquiv.apply_symm_apply,
          CategoryTheory.Adjunction.homEquiv_counit]
      let g_inv : K.H 0 → (P_push.obj K).H 0 := fun y =>
        CategoryTheory.Abelian.Ext.addEquiv₀.symm
          (adj.homEquiv Fℤ_B K (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ y))
      rw [Function.bijective_iff_has_inverse]
      refine ⟨g_inv, fun x => ?_, fun y => ?_⟩
      · dsimp only [g_inv]
        rw [h_eval x, ← CategoryTheory.Category.assoc, hπι, CategoryTheory.Category.id_comp,
          Equiv.apply_symm_apply, AddEquiv.symm_apply_apply]
      · apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
        rw [h_eval (g_inv y)]
        dsimp only [g_inv]
        rw [AddEquiv.apply_symm_apply, Equiv.symm_apply_apply,
          ← CategoryTheory.Category.assoc, hιπ, CategoryTheory.Category.id_comp]
    have hΛ_extClass : ∀ {SC : CategoryTheory.ShortComplex 𝒜_E}
        (hSE_E : SC.ShortExact) (hSE_B : (SC.map P_push).ShortExact)
        (d : ℕ) (x : (P_push.obj SC.X₃).H d),
        Λ SC.X₁ (d + 1) (x.comp hSE_B.extClass rfl) =
          (Λ SC.X₃ d x).comp hSE_E.extClass rfl := by
      intro SC hSE_E hSE_B d x
      let hSE_pb : ((SC.map P_push).map P_pull).ShortExact := hSE_B.map_of_exact P_pull
      let counit_SC : (SC.map P_push).map P_pull ⟶ SC :=
        { τ₁ := adj.counit.app SC.X₁
          τ₂ := adj.counit.app SC.X₂
          τ₃ := adj.counit.app SC.X₃
          comm₁₂ := (adj.counit.naturality SC.f).symm
          comm₂₃ := (adj.counit.naturality SC.g).symm }
      have h_nat_ext : hSE_pb.extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₁)) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₃)).comp
          hSE_E.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb hSE_E counit_SC
      rw [hΛ_left, hΛ_left,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp P_pull x hSE_B.extClass rfl,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_pull hSE_B,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
          (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull x)
          hSE_pb.extClass
          (Nat.zero_add d) rfl (Nat.zero_add (d + 1)),
        CategoryTheory.Abelian.Ext.comp_assoc _
          hSE_pb.extClass
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₁))
          rfl (Nat.add_zero 1) rfl,
        h_nat_ext,
        ← CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app SC.X₃))
          hSE_E.extClass
          (Nat.add_zero d) (Nat.zero_add 1) rfl]
    let Acyclic : 𝒜_E → Prop := fun K =>
      ∀ q : ℕ, 1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q K)
    have hΛ_bij_all : ∀ (d : ℕ) (K : 𝒜_E), Acyclic K → Function.Bijective (Λ K d) := by
      intro d
      induction d with
      | zero =>
        intro K _
        exact hΛ_bij0 K
      | succ d ih =>
        intro K hK
        let I₀ : 𝒜_E := CategoryTheory.Injective.under K
        let ι₀ : K ⟶ I₀ := CategoryTheory.Injective.ι K
        let Q₁ : 𝒜_E := CategoryTheory.Limits.cokernel ι₀
        let π₀ : I₀ ⟶ Q₁ := CategoryTheory.Limits.cokernel.π ι₀
        have h₀ : ι₀ ≫ π₀ = 0 := CategoryTheory.Limits.cokernel.condition ι₀
        let E₀ := CategoryTheory.ShortComplex.mk ι₀ π₀ h₀
        have hE₀ : E₀.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_cokernel ι₀) inferInstance inferInstance
        have hI₀_acyc : Acyclic I₀ := fun q hq => hInj_Rvanish f I₀ q hq
        have hSE_B : (E₀.map P_push).ShortExact :=
          (hCalc E₀ hE₀ hI₀_acyc).1 (hK 1 le_rfl)
        have hQ₁_acyc : Acyclic Q₁ :=
          fun p hp => (hCalc E₀ hE₀ hI₀_acyc).2 p hp (hK (p + 1) (by omega))
        have : CategoryTheory.Injective (E₀.map P_push).X₂ :=
          CategoryTheory.Injective.injective_of_adjoint adj I₀
        have hBij_Q : Function.Bijective (Λ Q₁ d) := ih Q₁ hQ₁_acyc
        have hBij_I : Function.Bijective (Λ I₀ d) := ih I₀ hI₀_acyc
        refine ⟨(injective_iff_map_eq_zero (Λ K (d + 1))).mpr (fun x hx => ?_), fun y => ?_⟩
        · have hx_pfI : x.comp (CategoryTheory.Abelian.Ext.mk₀ (E₀.map P_push).f)
              (Nat.add_zero (d + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨c_B, rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_B hSE_B x hx_pfI rfl
          have hc_ext : (Λ Q₁ d c_B).comp hE₀.extClass rfl = 0 := by
            rw [← hΛ_extClass hE₀ hSE_B d c_B]
            exact hx
          obtain ⟨i_E, hi_E⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_E hE₀ (Λ Q₁ d c_B) rfl hc_ext
          obtain ⟨i_B, rfl⟩ := hBij_I.2 i_E
          have h_eq_Q : Λ Q₁ d (i_B.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map π₀))
              (Nat.add_zero d)) = Λ Q₁ d c_B := by
            rw [hΛ_nat π₀ d i_B]
            exact hi_E
          have hc_eq : i_B.comp (CategoryTheory.Abelian.Ext.mk₀ (E₀.map P_push).g)
              (Nat.add_zero d) = c_B :=
            hBij_Q.1 h_eq_Q
          rw [← hc_eq,
            CategoryTheory.Abelian.Ext.comp_assoc i_B
              (CategoryTheory.Abelian.Ext.mk₀ (E₀.map P_push).g) hSE_B.extClass
              (Nat.add_zero d) (Nat.zero_add 1) rfl,
            hSE_B.comp_extClass,
            CategoryTheory.Abelian.Ext.comp_zero]
        · have hy_I : y.comp (CategoryTheory.Abelian.Ext.mk₀ E₀.f)
              (Nat.add_zero (d + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨c_E, rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_E hE₀ y hy_I rfl
          obtain ⟨c_B, rfl⟩ := hBij_Q.2 c_E
          exact ⟨c_B.comp hSE_B.extClass rfl, hΛ_extClass hE₀ hSE_B d c_B⟩
    exact hΛ_bij_all m M hM

theorem weil_gysin_proper_p1_bundle_top_cup_nonvanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hP1_prop : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom)
    (s_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) (weilProjectiveSpaceOver k 1).left)
    (hs_P1 : CategoryTheory.CategoryStruct.comp s_P1 (weilProjectiveSpaceOver k 1).hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hSk_H0 : Nat.card (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of k)) (ℓ ^ 1) 0) = ℓ)
    (hP1_H0 : Nat.card (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 0) = ℓ)
    (hP1_H1 : Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 1))
    (hP1_H2 : Nat.card (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 2) = ℓ)
    (hP1_Hge3 : ∀ q : ℕ, 3 ≤ q →
      Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) q))
    (c : ℕ) (hc : 1 ≤ c)
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper B.hom]
    (hB_cd : ∀ q : ℕ, 2 * c < q → Subsingleton (weilEtaleTorsionH B.left (ℓ ^ 1) q))
    (x_B : weilEtaleTorsionH B.left (ℓ ^ 1) (2 * c)) (hx_B : x_B ≠ 0)
    (p_f : weilEtaleTorsionH B.left (ℓ ^ 1) (2 * c) →+
      weilEtaleTorsionH
        (CategoryTheory.Limits.pullback B.hom (weilProjectiveSpaceOver k 1).hom) (ℓ ^ 1) (2 * c))
    (hp_f : WeilLefschetzTorsionPullback
      (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom)
      (ℓ ^ 1) (2 * c) p_f)
    (cl_P1 : weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 2)
    (hcl_P1 : cl_P1 ≠ 0)
    (ω_hat : CategoryTheory.Abelian.Ext.{u}
      (weilEtaleTorsionSheaf
        (CategoryTheory.Limits.pullback B.hom (weilProjectiveSpaceOver k 1).hom) (ℓ ^ 1))
      (weilEtaleTorsionSheaf
        (CategoryTheory.Limits.pullback B.hom (weilProjectiveSpaceOver k 1).hom) (ℓ ^ 1)) 2)
    (hω_fib : ∀ (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) B.left)
       (hs : CategoryTheory.CategoryStruct.comp s B.hom =
         CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
       (p_is : weilEtaleTorsionH
           (CategoryTheory.Limits.pullback B.hom (weilProjectiveSpaceOver k 1).hom) (ℓ ^ 1) 2 →+
         weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ 1) 2),
      WeilLefschetzTorsionPullback
        (CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.comp (weilProjectiveSpaceOver k 1).hom s)
          (CategoryTheory.CategoryStruct.id (weilProjectiveSpaceOver k 1).left)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp (weilProjectiveSpaceOver k 1).hom) hs).trans
              ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm))))
        (ℓ ^ 1) 2 p_is →
      let z_to_m₀ : Quiver.Hom (AddCommGrpCat.of (ULift.{u} ℤ))
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ 1)))) :=
        AddCommGrpCat.ofHom
          { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod (ℓ ^ 1))
            map_zero' := congrArg ULift.up Int.cast_zero
            map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
      p_is ((CategoryTheory.Abelian.Ext.mk₀
        ((CategoryTheory.constantSheaf
          (CategoryTheory.Limits.pullback B.hom (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
          AddCommGrpCat.{u}).map z_to_m₀)).comp ω_hat (Nat.zero_add 2)) = cl_P1) :
    (p_f x_B).comp ω_hat (Nat.mul_succ 2 c).symm ≠ 0 :=
by
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P1 := weilProjectiveSpaceOver k 1
  let E := CategoryTheory.Limits.pullback B.hom P1.hom
  let f := CategoryTheory.Limits.pullback.fst B.hom P1.hom
  let g_snd := CategoryTheory.Limits.pullback.snd B.hom P1.hom
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ 1)))
  let z_to_m₀ : Quiver.Hom Aℤ AM :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod (ℓ ^ 1))
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  let C_E := CategoryTheory.constantSheaf E.smallEtaleTopology AddCommGrpCat.{u}
  let C_B := CategoryTheory.constantSheaf B.left.smallEtaleTopology AddCommGrpCat.{u}
  let C_P1 := CategoryTheory.constantSheaf P1.left.smallEtaleTopology AddCommGrpCat.{u}
  let C_Sk := CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}
  let F_E := weilEtaleTorsionSheaf E (ℓ ^ 1)
  let F_B := weilEtaleTorsionSheaf B.left (ℓ ^ 1)
  let F_P1 := weilEtaleTorsionSheaf P1.left (ℓ ^ 1)
  let F_Sk := weilEtaleTorsionSheaf S_k (ℓ ^ 1)

  
  obtain ⟨hSite, -⟩ := weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  obtain ⟨-, -, hCalc3⟩ := weil_etale_higherDirectImage_shortExact_calculus f
  obtain ⟨hSk_exact, hSk_H0_equiv, hConserv_imp⟩ :=
    weil_gysin_algClosed_spec_sheaf_equiv_and_closed_point_conservativity k
  obtain ⟨hConserv_zero, hConserv_iso⟩ := hConserv_imp (fun h => hSite h) B
  obtain ⟨hConst_pb, hConst_iso, hBC_mate⟩ :=
    weil_gysin_etale_constant_pullback_and_bc_mate.{u} (fun h => hSite h)
  obtain ⟨hInj_Rvanish, hTwoStep, hLeray_bij⟩ :=
    weil_gysin_abelian_two_step_injective_shift_and_acyclic_leray.{u}
  obtain ⟨hCont_f, P_pull_f, adj_f, hAdd_f, hLim_f, hColim_f, T_E, hT_E, T_B, hT_B,
    ιℤ_f, hιπ_f, hπι_f, hp_f_eq⟩ := hp_f
  letI : (weilEtaleSitePullback f).IsContinuous
      B.left.smallEtaleTopology E.smallEtaleTopology := hCont_f
  let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
    B.left.smallEtaleTopology E.smallEtaleTopology
  have hr_f : pf_f.IsRightAdjoint := adj_f.isRightAdjoint
  letI : pf_f.IsRightAdjoint := hr_f
  letI : P_pull_f.Additive := hAdd_f
  letI : CategoryTheory.Limits.PreservesFiniteLimits P_pull_f := hLim_f
  letI : CategoryTheory.Limits.PreservesFiniteColimits P_pull_f := hColim_f

  
  have hIsoH0 : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}}
      (e : 𝒢₁ ≅ 𝒢₂), Nonempty (𝒢₁.H 0 ≃+ 𝒢₂.H 0) := by
    intro W 𝒢₁ 𝒢₂ e
    let Fℤ_W := (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    refine ⟨AddEquiv.ofBijective
      ((CategoryTheory.Abelian.Ext.mk₀ e.hom).postcomp Fℤ_W (Nat.add_zero 0))
      ⟨fun a₁ a₂ ha => ?_,
       fun b => ⟨b.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 0), ?_⟩⟩⟩
    · have h1 := congrArg
        (fun z : 𝒢₂.H 0 => z.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 0)) ha
      change (a₁.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 0) =
        (a₂.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 0) at h1
      have ha₁ := (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply a₁).symm
      have ha₂ := (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply a₂).symm
      rw [ha₁, ha₂, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, e.hom_inv_id, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.comp_id] at h1
      rw [ha₁, ha₂]
      exact h1
    · have hb := (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply b).symm
      change (b.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero 0) = b
      rw [hb, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.comp_id]

  
  have hProp_f : AlgebraicGeometry.IsProper f := by
    have : AlgebraicGeometry.IsProper P1.hom := hP1_prop
    infer_instance
  have hℓ_AM : ℓ • CategoryTheory.CategoryStruct.id AM = 0 := by
    ext ⟨x⟩
    change ULift.up (ℓ • x) = ULift.up 0
    congr 1
    rw [nsmul_eq_mul]
    have h0 : (ℓ : ZMod (ℓ ^ 1)) = 0 :=
      (congrArg (Nat.cast (R := ZMod (ℓ ^ 1))) (pow_one ℓ)).symm.trans (ZMod.natCast_self (ℓ ^ 1))
    rw [h0, zero_mul]
  have hAdd_CE : C_E.Additive := by
    letI : ((CategoryTheory.sheafSections E.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op T_E)).Additive :=
      { map_add := fun {_ _ _ _} => rfl }
    exact (CategoryTheory.constantSheafAdj E.smallEtaleTopology AddCommGrpCat.{u}
      hT_E).left_adjoint_additive
  have hℓ_FE : ℓ • CategoryTheory.CategoryStruct.id F_E = 0 := by
    letI : C_E.Additive := hAdd_CE
    change ℓ • CategoryTheory.CategoryStruct.id (C_E.obj AM) = 0
    rw [← C_E.map_id, ← C_E.map_nsmul, hℓ_AM, C_E.map_zero]

  
  have hPBC_sec : ∀ (s : S_k ⟶ B.left)
      (hs : CategoryTheory.CategoryStruct.comp s B.hom =
        CategoryTheory.CategoryStruct.id S_k) (q : ℕ),
      WeilIsEtaleSheafPullback s
        (weilEtaleHigherDirectImage f q F_E)
        (weilEtaleHigherDirectImage P1.hom q F_P1) := by
    intro s hs q
    have hf_cond : f ≫ B.hom = g_snd ≫ P1.hom :=
      CategoryTheory.Limits.pullback.condition
    let h_is_comm : CategoryTheory.CategoryStruct.comp (P1.hom ≫ s) B.hom =
        CategoryTheory.CategoryStruct.comp (𝟙 P1.left) P1.hom :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp P1.hom) hs).trans
          ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm))
    let i_s : P1.left ⟶ E :=
      CategoryTheory.Limits.pullback.lift (P1.hom ≫ s) (𝟙 P1.left) h_is_comm
    have hi_fst : i_s ≫ f = P1.hom ≫ s :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hi_snd : i_s ≫ g_snd = 𝟙 P1.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_is : CategoryTheory.IsPullback i_s P1.hom f s := by
      refine { toCommSq := ⟨hi_fst⟩, isLimit' := ⟨?_⟩ }
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hi_fst
        (fun cone => cone.fst ≫ g_snd) (fun cone => ?_) (fun cone => ?_) (fun cone m hm₁ _ => ?_)
      · apply CategoryTheory.Limits.pullback.hom_ext
        · change (cone.fst ≫ g_snd) ≫ i_s ≫ f = cone.fst ≫ f
          calc
            (cone.fst ≫ g_snd) ≫ i_s ≫ f
                = (cone.fst ≫ g_snd) ≫ (P1.hom ≫ s) :=
                  congrArg ((cone.fst ≫ g_snd) ≫ ·) hi_fst
            _ = cone.fst ≫ (g_snd ≫ P1.hom) ≫ s := by
                  simp only [CategoryTheory.Category.assoc]
            _ = (cone.fst ≫ f) ≫ B.hom ≫ s := by
                  rw [← hf_cond]
                  simp only [CategoryTheory.Category.assoc]
            _ = cone.snd ≫ (s ≫ B.hom) ≫ s := by
                  rw [cone.condition]
                  simp only [CategoryTheory.Category.assoc]
            _ = cone.snd ≫ s := by
                  rw [hs, CategoryTheory.Category.id_comp]
            _ = cone.fst ≫ f := cone.condition.symm
        · change (cone.fst ≫ g_snd) ≫ i_s ≫ g_snd = cone.fst ≫ g_snd
          rw [hi_snd, CategoryTheory.Category.comp_id]
      · change (cone.fst ≫ g_snd) ≫ P1.hom = cone.snd
        calc
          (cone.fst ≫ g_snd) ≫ P1.hom
              = cone.fst ≫ (g_snd ≫ P1.hom) := CategoryTheory.Category.assoc _ _ _
          _ = (cone.fst ≫ f) ≫ B.hom := by
                rw [← hf_cond, CategoryTheory.Category.assoc]
          _ = cone.snd ≫ (s ≫ B.hom) := by
                rw [cone.condition, CategoryTheory.Category.assoc]
          _ = cone.snd := by
                rw [hs, CategoryTheory.Category.comp_id]
      · calc
          m = m ≫ 𝟙 P1.left := (CategoryTheory.Category.comp_id m).symm
          _ = m ≫ (i_s ≫ g_snd) := by rw [hi_snd]
          _ = (m ≫ i_s) ≫ g_snd := (CategoryTheory.Category.assoc m i_s g_snd).symm
          _ = cone.fst ≫ g_snd := by rw [hm₁]
    let E_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (f ≫ B.hom)
    let Sk_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (𝟙 S_k)
    let f_ov : E_ov ⟶ B := CategoryTheory.Over.homMk f rfl
    let g_ov : Sk_ov ⟶ B := CategoryTheory.Over.homMk s hs
    let f'_ov : P1 ⟶ Sk_ov := CategoryTheory.Over.homMk P1.hom (CategoryTheory.Category.comp_id _)
    let g'_ov : P1 ⟶ E_ov := CategoryTheory.Over.homMk i_s (by
      change i_s ≫ (f ≫ B.hom) = P1.hom
      rw [← CategoryTheory.Category.assoc, hi_fst, CategoryTheory.Category.assoc, hs,
        CategoryTheory.Category.comp_id])
    exact hPBC E_ov B Sk_ov P1 f_ov g_ov f'_ov g'_ov hProp_f hpb_is
      F_E F_P1 hℓ_FE (hConst_pb i_s AM) q

  
  obtain ⟨I₀, Q₁, I₁, Q₂, hI₀, hI₁, j₀, p₀, h₀, j₁, p₁, h₁, hS₀, hS₁, φ_ω, hω_eq, hShift_inj⟩ :=
    hTwoStep (CategoryTheory.Sheaf E.smallEtaleTopology AddCommGrpCat.{u}) F_E ω_hat
  letI : CategoryTheory.Injective I₀ := hI₀
