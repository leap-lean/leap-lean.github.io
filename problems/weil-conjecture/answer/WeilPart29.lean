        AlgebraicGeometry.Spec.map_injective hApp_Spec
      have hHomEq : β₀.hom.comp (g_app.hom.comp α₀.hom) = (MvPolynomial.C : k →+* R_mv) := by
        simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using
