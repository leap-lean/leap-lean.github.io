          exact False.elim (hij (ULift.up.inj (hy.1.symm.trans hy.2)))
      have hSup : (⨆ j : ZMod (ℓ ^ r), V_lvl j) = ⊤ := by
        rw [eq_top_iff]
        intro y _
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨(s y).down, rfl⟩
      obtain ⟨g_sup, hg_gl, hg_uniq⟩ := Y.sheaf.existsUnique_gluing V_lvl sf hCompat
      let g_sup' : ↑(Y.presheaf.obj (Opposite.op (⨆ j : ZMod (ℓ ^ r), V_lvl j))) := g_sup
      let g_tot : ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
        (Y.presheaf.map (CategoryTheory.eqToHom hSup.symm).op).hom g_sup'
