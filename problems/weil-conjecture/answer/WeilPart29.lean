                IsLocalization.AtPrime.map_eq_maximalIdeal _ _
          · rw [Ideal.span_singleton_one, pow_zero, Ideal.one_eq_top]
          · rw [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_same,
              Finsupp.single_eq_of_ne hQ]
