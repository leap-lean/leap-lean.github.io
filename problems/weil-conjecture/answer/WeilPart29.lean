    AddCommGrpCat.ofHom
      { toFun := fun k => k.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }
  let evOne : ∀ (G : AddCommGrpCat.{u}), (Aℤ ⟶ G) → ↥G := fun _ φ => φ.hom (ULift.up 1)
  have h_evOne_toHom : ∀ (G : AddCommGrpCat.{u}) (m : ↥G), evOne G (toHom G m) = m :=
    fun _ m => one_zsmul m
  have h_toHom_evOne : ∀ (G : AddCommGrpCat.{u}) (φ : Aℤ ⟶ G), toHom G (evOne G φ) = φ := by
    intro G φ
    apply AddCommGrpCat.ext
    intro k
    have hk : k = k.down • (ULift.up (1 : ℤ) : ↥Aℤ) :=
      ULift.ext _ _ (by change k.down = k.down • (1 : ℤ); simp)
    change k.down • φ.hom (ULift.up 1) = φ.hom k
    rw [← map_zsmul φ.hom k.down (ULift.up 1), ← hk]
  have h_toHom_comp : ∀ {G₁ G₂ : AddCommGrpCat.{u}} (m : ↥G₁) (ψ : G₁ ⟶ G₂),
      toHom G₁ m ≫ ψ = toHom G₂ (ψ.hom m) := fun m ψ =>
    AddCommGrpCat.ext (fun k => map_zsmul ψ.hom k.down m)
  have h_toHom_add : ∀ (G : AddCommGrpCat.{u}) (m₁ m₂ : ↥G),
