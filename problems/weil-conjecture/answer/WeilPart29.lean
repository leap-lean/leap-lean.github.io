      · intro j
        change (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_lvl j ≤ ⊤)).op).hom
          ((Y.presheaf.map (CategoryTheory.eqToHom hSup.symm).op).hom g_sup') = sf j
        rw [← CommRingCat.comp_apply, ← Y.presheaf.map_comp]
        exact hg_gl j
      · intro g' hg'
        have hsup' : (Y.presheaf.map (CategoryTheory.eqToHom hSup).op).hom g' = g_sup' := by
          apply hg_uniq
          intro j
          change (Y.presheaf.map _).hom ((Y.presheaf.map _).hom g') = sf j
          rw [← CommRingCat.comp_apply, ← Y.presheaf.map_comp]
          exact hg' j
        change g' = (Y.presheaf.map (CategoryTheory.eqToHom hSup.symm).op).hom g_sup'
        rw [← hsup', ← CommRingCat.comp_apply, ← Y.presheaf.map_comp]
        simp
    choose r_sec hr_sec hr_sec_uniq using hSecGluing
    have hr_germ : ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (πY : Quiver.Hom Y S_k)
