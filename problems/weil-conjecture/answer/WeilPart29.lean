      have hIso_πℤi : CategoryTheory.IsIso πℤ_i := hConst_iso i_s hT_P1 hT_E Aℤ
      letI : CategoryTheory.IsIso πℤ_i := hIso_πℤi
      let ιℤ_i : C_P1.obj Aℤ ⟶ pb_i.obj (C_E.obj Aℤ) := CategoryTheory.inv πℤ_i

