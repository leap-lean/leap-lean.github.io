theorem weil_gysin_even_projection_and_swap_symmetry (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (S₀ Z Y : AlgebraicGeometry.Scheme.{u})
        (s : Quiver.Hom S₀ Z) (i : Quiver.Hom Z Y) (si : Quiver.Hom S₀ Y),
      AlgebraicGeometry.IsClosedImmersion s →
      AlgebraicGeometry.IsClosedImmersion i →
      AlgebraicGeometry.IsClosedImmersion si →
      ∀ (hsi : CategoryTheory.CategoryStruct.comp s i = si)
        (r d : ℕ) (h4d : 2 * d + 2 * d = 2 * (2 * d))
        (τ_Z : WeilGysinSupportClass S₀ Z s (ℓ ^ r) (2 * d))
        (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) (2 * d))
        (τ_SY : WeilGysinSupportClass S₀ Y si (ℓ ^ r) (2 * (2 * d))),
        WeilGysinSupportGysinComp hsi h4d τ_Z τ_Y τ_SY →
        ∀ (cl_Z : weilEtaleTorsionH Z (ℓ ^ r) (2 * d))
          (γ_Y : weilEtaleTorsionH Y (ℓ ^ r) (2 * d))
          (cl_SY : weilEtaleTorsionH Y (ℓ ^ r) (2 * (2 * d))),
          WeilGysinForgetsTo τ_Z cl_Z →
          WeilGysinForgetsTo τ_Y γ_Y →
          WeilGysinForgetsTo τ_SY cl_SY →
          ∀ (p_i : weilEtaleTorsionH Y (ℓ ^ r) (2 * d) →+ weilEtaleTorsionH Z (ℓ ^ r) (2 * d))
            (c_Y : weilEtaleTorsionH Y (ℓ ^ r) (2 * d) →+
              weilEtaleTorsionH Y (ℓ ^ r) (2 * d) →+ weilEtaleTorsionH Y (ℓ ^ r) (2 * (2 * d)))
            (ξ : weilEtaleTorsionH Y (ℓ ^ r) (2 * d)) (a : ℕ),
            WeilLefschetzTorsionPullback i (ℓ ^ r) (2 * d) p_i →
            WeilLefschetzIsTorsionCup Y (ℓ ^ r) (2 * d) (2 * d) (2 * (2 * d)) h4d c_Y →
            p_i ξ = a • cl_Z →
            c_Y γ_Y ξ = a • cl_SY) ∧
    (∀ (k : Type u) [Field k] (r : ℕ)
        (τ₁ : WeilGysinSupportClass (AlgebraicGeometry.Spec (CommRingCat.of k))
          (weilGysinAffineSpace k 1) (weilGysinAffineOrigin k 1) (ℓ ^ r) 2)
        (h_orig₂ : CategoryTheory.CategoryStruct.comp
          (weilGysinAffineOrigin k 1)
          (weilGysinAffineLeftAxis k 1 1 2 (rfl : 1 + 1 = 2)) =
          weilGysinAffineOrigin k 2)
        (τ_axis₂ : WeilGysinSupportClass (weilGysinAffineSpace k 1)
          (weilGysinAffineSpace k 2)
          (weilGysinAffineLeftAxis k 1 1 2 (rfl : 1 + 1 = 2)) (ℓ ^ r) 2)
        (τ₂ : WeilGysinSupportClass (AlgebraicGeometry.Spec (CommRingCat.of k))
          (weilGysinAffineSpace k 2) (weilGysinAffineOrigin k 2) (ℓ ^ r) 4)
        (h22 : 2 + 2 = 4),
      WeilGysinSupportPullback (weilGysinAffineProjRight k 1 1 2 (rfl : 1 + 1 = 2))
        (weilGysinAffineLeftAxis k 1 1 2 (rfl : 1 + 1 = 2))
        (weilGysinAffineOrigin k 1) (ℓ ^ r) 2 τ_axis₂ τ₁ →
      WeilGysinSupportGysinComp h_orig₂ h22 τ₁ τ_axis₂ τ₂ →
      WeilGysinSupportPullback
        (weilGysinAffinePerm k 2 (Equiv.swap (0 : Fin 2) (1 : Fin 2)))
        (weilGysinAffineOrigin k 2) (weilGysinAffineOrigin k 2) (ℓ ^ r) 4 τ₂ τ₂) :=
by
  refine ⟨?_, ?_⟩
  · intro S₀ Z Y s i si _ _ _ hsi r d h4d τ_Z τ_Y τ_SY hGys
      cl_Z γ_Y cl_SY hfg_Z hfg_Y hfg_SY p_i c_Y ξ a hp_i hc_Y hξ
    have hm : 1 ≤ ℓ ^ r := Nat.one_le_pow r ℓ (Fact.out : Nat.Prime ℓ).pos
    have hModCmp := weil_etale_module_ext_comparison.{u}.1
