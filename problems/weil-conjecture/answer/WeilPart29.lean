      exact hcl_P1 (hLHS_cl.symm.trans (h_post.trans hRHS_zero))

    have hℓ_ne : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
    have : Finite ((pb_s.obj F_B).H 0) :=
      Nat.finite_of_card_ne_zero (by rw [hCard_dom]; exact hℓ_ne)
    have : Finite ((pb_s.obj (weilEtaleHigherDirectImage f 1 Q₁)).H 0) :=
