theorem weil_noetherian_locally_domain_orthogonal_idempotent_split (B : Type u) [CommRing B] [IsNoetherianRing B]
    (hLocDom : ∀ (m : Ideal B) [m.IsMaximal], IsDomain (Localization.AtPrime m)) :
    ∃ (s : ℕ) (e : Fin s → B),
      (∑ α : Fin s, e α) = 1 ∧
      (∀ α β : Fin s, α ≠ β → e α * e β = 0) ∧
      (∀ α : Fin s, IsDomain (Localization.Away (e α))) :=
by
  classical
  have hStalk : ∀ (m : Ideal B) [m.IsMaximal],
      let K_m : Ideal B := RingHom.ker (algebraMap B (Localization.AtPrime m))
      K_m.IsPrime ∧
      K_m ≤ m ∧
      (∀ (q : Ideal B), q.IsPrime → q ≤ m → K_m ≤ q) ∧
      K_m ∈ minimalPrimes B := by
    intro m hm
    let S_m := Localization.AtPrime m
    have : IsDomain S_m := hLocDom m
    let K_m : Ideal B := RingHom.ker (algebraMap B S_m)
    have hK_prime : K_m.IsPrime := RingHom.ker_isPrime (algebraMap B S_m)
    have hK_le_m : K_m ≤ m := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      by_contra hx_not
      let u_x : ↥m.primeCompl := ⟨x, hx_not⟩
      have hu : IsUnit (algebraMap B S_m x) := IsLocalization.map_units S_m u_x
      rw [hx] at hu
      exact not_isUnit_zero hu
    have hK_min_below : ∀ (q : Ideal B), q.IsPrime → q ≤ m → K_m ≤ q := by
      intro q hq hqm x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨t, htx⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl S_m x).mp hx
      have htx_mul : (t : B) * x = 0 := by simpa [Submonoid.smul_def, smul_eq_mul] using htx
      have hmem_q : (t : B) * x ∈ q := htx_mul.symm ▸ q.zero_mem
      rcases hq.mem_or_mem hmem_q with ht_q | hx_q
      · exact False.elim (t.2 (hqm ht_q))
      · exact hx_q
    have hK_mem_min : K_m ∈ minimalPrimes B := by
      rw [minimalPrimes_eq_minimals]
      exact ⟨hK_prime, fun q hq hqK => hK_min_below q hq (hqK.trans hK_le_m)⟩
    exact ⟨hK_prime, hK_le_m, hK_min_below, hK_mem_min⟩

  have hf_min : (minimalPrimes B).Finite := minimalPrimes.finite_of_isNoetherianRing B
  let _ : Fintype ↥(minimalPrimes B) := hf_min.fintype
  let s : ℕ := Fintype.card ↥(minimalPrimes B)
  let p : Fin s ≃ ↥(minimalPrimes B) := (Fintype.equivFin ↥(minimalPrimes B)).symm
  let I : Fin s → Ideal B := fun α => (p α).1
  let Q : Fin s → Type u := fun α => B ⧸ I α
  have hMin : ∀ α : Fin s, Minimal Ideal.IsPrime (I α) := by
    intro α
    have hmem : I α ∈ minimalPrimes B := (p α).2
    rwa [minimalPrimes_eq_minimals] at hmem
  have hPrime : ∀ α : Fin s, (I α).IsPrime := fun α => (hMin α).1

  have hCop : _root_.Pairwise (Function.onFun IsCoprime I) := by
    intro α β hne
    rw [Function.onFun, Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal (I α ⊔ I β) h_ne_top
    have : m.IsMaximal := hm
    obtain ⟨hK_prime, _, hK_below, _⟩ := hStalk m
    let K_m : Ideal B := RingHom.ker (algebraMap B (Localization.AtPrime m))
    have hKα_le : K_m ≤ I α := hK_below (I α) (hPrime α) (le_sup_left.trans hle)
    have hKβ_le : K_m ≤ I β := hK_below (I β) (hPrime β) (le_sup_right.trans hle)
    have hKα_eq : K_m = I α := (hMin α).eq_of_le hK_prime hKα_le
    have hKβ_eq : K_m = I β := (hMin β).eq_of_le hK_prime hKβ_le
    have hI_eq : I α = I β := hKα_eq.symm.trans hKβ_eq
    exact hne (p.injective (Subtype.ext hI_eq))

  have h_iInf : (⨅ α : Fin s, I α) = (⊥ : Ideal B) := by
    rw [Submodule.eq_bot_iff]
    intro b hb_mem
    have hb_all : ∀ α : Fin s, b ∈ I α := Ideal.mem_iInf.mp hb_mem
    let Ann_b : Ideal B :=
      { carrier := { t : B | t * b = 0 }
        zero_mem' := zero_mul b
        add_mem' := fun {x y} hx hy => by
          change (x + y) * b = 0
          rw [add_mul, hx, hy, add_zero]
        smul_mem' := fun c {x} hx => by
          change (c • x) * b = 0
          rw [smul_eq_mul, mul_assoc, hx, mul_zero] }
    have hAnn_top : Ann_b = ⊤ := by
      by_contra h_ann_ne
      obtain ⟨m, hm, h_ann_le⟩ := Ideal.exists_le_maximal Ann_b h_ann_ne
      have : m.IsMaximal := hm
      obtain ⟨_, _, _, hK_mem⟩ := hStalk m
      let K_m : Ideal B := RingHom.ker (algebraMap B (Localization.AtPrime m))
      let α_m : Fin s := p.symm ⟨K_m, hK_mem⟩
      have hI_αm : I α_m = K_m := congrArg Subtype.val (p.apply_symm_apply ⟨K_m, hK_mem⟩)
      have hb_Km : b ∈ K_m := hI_αm ▸ hb_all α_m
      rw [RingHom.mem_ker] at hb_Km
      obtain ⟨t, htb⟩ :=
        (IsLocalization.map_eq_zero_iff m.primeCompl (Localization.AtPrime m) b).mp hb_Km
      have htb_mul : (t : B) * b = 0 := by simpa [Submonoid.smul_def, smul_eq_mul] using htb
      have ht_ann : (t : B) ∈ Ann_b := htb_mul
      exact t.2 (h_ann_le ht_ann)
    have h1_ann : (1 : B) ∈ Ann_b := hAnn_top ▸ Submodule.mem_top
    have h1b : (1 : B) * b = 0 := h1_ann
    simpa only [one_mul] using h1b

  let e₁ : B ≃+* (B ⧸ (⊥ : Ideal B)) := (RingEquiv.quotientBot B).symm
  let e₂ : (B ⧸ (⊥ : Ideal B)) ≃+* (B ⧸ ⨅ α : Fin s, I α) := Ideal.quotEquivOfEq h_iInf.symm
  let e₃ : (B ⧸ ⨅ α : Fin s, I α) ≃+* (∀ α : Fin s, Q α) :=
    Ideal.quotientInfRingEquivPiQuotient I hCop
  let Φ : B ≃+* (∀ α : Fin s, Q α) := e₁.trans (e₂.trans e₃)

  let e : Fin s → B := fun α => Φ.symm (Pi.single α (1 : Q α))
  have hΦ_e : ∀ α : Fin s, Φ (e α) = Pi.single α (1 : Q α) :=
    fun α => Φ.apply_symm_apply _
  have h_sum : (∑ α : Fin s, e α) = 1 := by
    apply Φ.injective
    rw [map_sum, map_one]
    have h_s : (∑ α : Fin s, Φ (e α)) =
        ∑ α : Fin s, Pi.single α ((1 : ∀ γ : Fin s, Q γ) α) := by
      apply Finset.sum_congr rfl
      intro α _
      rw [hΦ_e α, Pi.one_apply]
    rw [h_s]
    exact Finset.univ_sum_single (1 : ∀ γ : Fin s, Q γ)
  have h_orth : ∀ α β : Fin s, α ≠ β → e α * e β = 0 := by
    intro α β hne
    apply Φ.injective
    rw [map_mul, map_zero, hΦ_e α, hΦ_e β]
    funext γ
    simp only [Pi.mul_apply, Pi.zero_apply]
    by_cases hγα : γ = α
    · subst hγα
      have hne' : γ ≠ β := hne
      rw [Pi.single_eq_of_ne hne' (1 : Q β), mul_zero]
    · rw [Pi.single_eq_of_ne hγα (1 : Q α), zero_mul]

  have h_dom : ∀ α : Fin s, IsDomain (Localization.Away (e α)) := by
    intro α
    have : (I α).IsPrime := hPrime α
    have : IsDomain (Q α) := Ideal.Quotient.isDomain (I α)
    let proj_α : B →+* Q α := (Pi.evalRingHom Q α).comp Φ.toRingHom
    have hproj_apply : ∀ b : B, proj_α b = Φ b α := fun _ => rfl
    have hproj_e : proj_α (e α) = 1 := by
      rw [hproj_apply, hΦ_e α, Pi.single_eq_same α (1 : Q α)]
    have hu_α : IsUnit (proj_α (e α)) := hproj_e.symm ▸ isUnit_one
    let A_α := Localization.Away (e α)
    let ψ_α : A_α →+* Q α := IsLocalization.Away.lift (e α) hu_α
    have hψ_inj : Function.Injective ψ_α := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨n, b, hzb⟩ := IsLocalization.Away.surj (e α) z
      have hzb' : z * (algebraMap B A_α (e α)) ^ n = algebraMap B A_α b := hzb
      have hb_α : Φ b α = 0 := by
        have hcongr := congrArg ψ_α hzb'
        rw [map_mul, hz, zero_mul] at hcongr
        have hlift : ψ_α (algebraMap B A_α b) = proj_α b :=
          IsLocalization.Away.lift_eq (S := A_α) (e α) hu_α b
        rw [hlift, hproj_apply] at hcongr
        exact hcongr.symm
      have hb_mul : b * e α = 0 := by
        apply Φ.injective
        rw [map_mul, map_zero, hΦ_e α]
        funext γ
        simp only [Pi.mul_apply, Pi.zero_apply]
        by_cases hγα : γ = α
        · subst hγα
          rw [hb_α, zero_mul]
        · rw [Pi.single_eq_of_ne hγα (1 : Q α), mul_zero]
      have hz_pow : z * (algebraMap B A_α (e α)) ^ (n + 1) = 0 := by
        calc
          z * (algebraMap B A_α (e α)) ^ (n + 1)
            = (z * (algebraMap B A_α (e α)) ^ n) * algebraMap B A_α (e α) := by
                rw [pow_succ, ← mul_assoc]
          _ = algebraMap B A_α b * algebraMap B A_α (e α) := by rw [hzb']
          _ = algebraMap B A_α (b * e α) := (map_mul _ _ _).symm
          _ = algebraMap B A_α 0 := by rw [hb_mul]
          _ = 0 := map_zero _
      have hUnit_pow : IsUnit ((algebraMap B A_α (e α)) ^ (n + 1)) :=
        (IsLocalization.Away.algebraMap_isUnit (S := A_α) (e α)).pow (n + 1)
      exact (IsUnit.mul_left_eq_zero hUnit_pow).mp hz_pow
    exact Function.Injective.isDomain ψ_α hψ_inj

  exact ⟨s, e, h_sum, h_orth, h_dom⟩

theorem weil_open_integral_schematic_closure_normalization_pullback (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (hIntClosFin : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra Ω A] [Algebra.FiniteType Ω A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K))
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsProper C_bar.hom]
    (U₀ : C_bar.left.Opens)
    (hAff₀ : AlgebraicGeometry.IsAffineOpen U₀)
    (hInt₀ : AlgebraicGeometry.IsIntegral U₀.toScheme)
    (hIC₀ : IsIntegrallyClosed ↑(C_bar.left.presheaf.obj (Opposite.op U₀))) :
    ∃ (C_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (p_C : Quiver.Hom C_tilde.left C_bar.left)
      (j_tilde : Quiver.Hom U₀.toScheme C_tilde.left),
      AlgebraicGeometry.IsIntegral C_tilde.left ∧
      CategoryTheory.CategoryStruct.comp p_C C_bar.hom = C_tilde.hom ∧
      AlgebraicGeometry.IsProper p_C ∧
      AlgebraicGeometry.IsProper C_tilde.hom ∧
      AlgebraicGeometry.IsOpenImmersion j_tilde ∧
      CategoryTheory.CategoryStruct.comp j_tilde p_C = U₀.ι ∧
      CategoryTheory.IsPullback j_tilde
        (CategoryTheory.CategoryStruct.id U₀.toScheme)
        p_C U₀.ι ∧
      (∀ x : ↥C_tilde.left, ∃ W : C_tilde.left.Opens,
        x ∈ W ∧
        AlgebraicGeometry.IsAffineOpen W ∧
        IsIntegrallyClosed ↑(C_tilde.left.presheaf.obj (Opposite.op W))) :=
by
  classical
  have : AlgebraicGeometry.IsAffine U₀.toScheme := hAff₀
  have : AlgebraicGeometry.IsIntegral U₀.toScheme := hInt₀
  have : IrreducibleSpace ↥U₀.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral U₀.toScheme
  have : AlgebraicGeometry.QuasiCompact U₀.ι :=
    AlgebraicGeometry.QuasiCompact.of_comp U₀.ι C_bar.hom

  
  let C_cl : AlgebraicGeometry.Scheme.{u} := (U₀.ι).image
  let i_cl : C_cl ⟶ C_bar.left := (U₀.ι).imageι
  let j_cl : U₀.toScheme ⟶ C_cl := (U₀.ι).toImage
  have : AlgebraicGeometry.IsOpenImmersion j_cl :=
    AlgebraicGeometry.IsImmersion.instIsOpenImmersionToImageOfQuasiCompact U₀.ι
  have : AlgebraicGeometry.IsDominant j_cl :=
    AlgebraicGeometry.Scheme.instIsDominantToImageOfQuasiCompact U₀.ι
  have hDense_jcl : DenseRange j_cl.base :=
    (inferInstance : AlgebraicGeometry.IsDominant j_cl).denseRange
  let V₀ : C_cl.Opens := j_cl.opensRange
  have hAff_V₀ : AlgebraicGeometry.IsAffineOpen V₀ :=
    AlgebraicGeometry.IsAffine.of_isIso j_cl.isoOpensRange.inv
  obtain ⟨u₀⟩ : Nonempty ↥U₀.toScheme := inferInstance
  have hNe_V₀ : Nonempty V₀ := ⟨⟨j_cl.base u₀, ⟨u₀, rfl⟩⟩⟩
  have : Nonempty ↥C_cl := ⟨j_cl.base u₀⟩

  have hPre_i : (TopologicalSpace.Opens.map i_cl.base).obj U₀ = V₀ := by
    ext z
    constructor
    · intro hz
      let u : ↥U₀.toScheme := ⟨i_cl.base z, hz⟩
      have h_eq : i_cl.base (j_cl.base u) = i_cl.base z := by
        change (j_cl ≫ i_cl).base u = i_cl.base z
        rw [(U₀.ι).toImage_imageι]
        rfl
      have h_inj : Function.Injective i_cl.base :=
        (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i_cl).toIsEmbedding.injective
      exact ⟨u, h_inj h_eq⟩
    · rintro ⟨u, rfl⟩
      change (j_cl ≫ i_cl).base u ∈ U₀
      rw [(U₀.ι).toImage_imageι]
      exact u.2

  let iso_ring_V₀ : C_bar.left.presheaf.obj (Opposite.op U₀) ≅ C_cl.presheaf.obj (Opposite.op V₀) :=
    U₀.topIso.symm ≪≫ (j_cl.appIso ⊤).symm ≪≫
      C_cl.presheaf.mapIso (CategoryTheory.eqToIso (congrArg Opposite.op j_cl.image_top_eq_opensRange))
  have hIC_V₀ : IsIntegrallyClosed ↑(C_cl.presheaf.obj (Opposite.op V₀)) :=
    @IsIntegrallyClosed.of_equiv _ _ _ _ iso_ring_V₀.commRingCatIsoToRingEquiv hIC₀

  have : IrreducibleSpace ↥C_cl :=
    { isPreirreducible_univ := by
        have h1 : IsPreirreducible (j_cl.base '' (Set.univ : Set ↥U₀.toScheme)) :=
          (IrreducibleSpace.isIrreducible_univ (X := ↥U₀.toScheme)).isPreirreducible.image
            j_cl.base j_cl.continuous.continuousOn
        have h2 : IsPreirreducible (closure (Set.range j_cl.base)) := by
          rw [← Set.image_univ]
          exact h1.closure
        rwa [hDense_jcl.closure_range] at h2
      toNonempty := inferInstance }

  have hStalkRed : ∀ y : ↥C_cl, _root_.IsReduced ↑(C_cl.presheaf.stalk y) := by
    intro y
    obtain ⟨W_X, hWX, hyWX, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (TopologicalSpace.Opens.mem_top (i_cl.base y))
    let W_y : C_cl.Opens := i_cl ⁻¹ᵁ W_X
    have hWy : AlgebraicGeometry.IsAffineOpen W_y := hWX.preimage i_cl
    have hy_range : y ∈ Set.range hWy.fromSpec.base := by
      rw [hWy.range_fromSpec]
      exact hyWX
    obtain ⟨q, hq⟩ := hy_range
    let e_sub := (U₀.ι).ker.subschemeObjIso ⟨W_X, hWX⟩
    let e_quot := Ideal.quotEquivOfEq ((U₀.ι).ker_apply ⟨W_X, hWX⟩)
    let φ_inj : ↑(C_cl.presheaf.obj (Opposite.op W_y)) →+*
        ↑(U₀.toScheme.presheaf.obj (Opposite.op (U₀.ι ⁻¹ᵁ W_X))) :=
      (RingHom.kerLift ((U₀.ι).app W_X).hom).comp (e_quot.toRingHom.comp e_sub.hom.hom)
    have hφ_inj : Function.Injective φ_inj :=
      (RingHom.kerLift_injective ((U₀.ι).app W_X).hom).comp
        (e_quot.injective.comp e_sub.commRingCatIsoToRingEquiv.injective)
    have : _root_.IsReduced ↑(U₀.toScheme.presheaf.obj (Opposite.op (U₀.ι ⁻¹ᵁ W_X))) :=
      AlgebraicGeometry.IsReduced.component_reduced (U₀.ι ⁻¹ᵁ W_X)
    have : _root_.IsReduced ↑(C_cl.presheaf.obj (Opposite.op W_y)) :=
      isReduced_of_injective φ_inj hφ_inj
    have : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (C_cl.presheaf.obj (Opposite.op W_y))) :=
      (AlgebraicGeometry.affine_isReduced_iff _).mpr inferInstance
    let e_stalk : C_cl.presheaf.stalk y ≅
        (AlgebraicGeometry.Spec (C_cl.presheaf.obj (Opposite.op W_y))).presheaf.stalk q :=
      (C_cl.presheaf.stalkCongr (Inseparable.of_eq hq.symm)) ≪≫
        CategoryTheory.asIso (hWy.fromSpec.stalkMap q)
    exact isReduced_of_injective e_stalk.hom.hom e_stalk.commRingCatIsoToRingEquiv.injective

  have : AlgebraicGeometry.IsReduced C_cl :=
    @AlgebraicGeometry.isReduced_of_isReduced_stalk C_cl hStalkRed

  have : AlgebraicGeometry.IsIntegral C_cl :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C_cl

  
  let f_cl : C_cl ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) := i_cl ≫ C_bar.hom
  have : AlgebraicGeometry.IsProper f_cl := inferInstance
  let η : ↥C_cl := genericPoint ↥C_cl
  let ξ : AlgebraicGeometry.Spec (C_cl.presheaf.stalk η) ⟶ C_cl := C_cl.fromSpecStalk η
  have : AlgebraicGeometry.QuasiCompact ξ :=
    AlgebraicGeometry.QuasiCompact.of_comp ξ f_cl
  have : AlgebraicGeometry.QuasiSeparated ξ :=
    AlgebraicGeometry.QuasiSeparated.of_comp ξ f_cl

  let C_sch : AlgebraicGeometry.Scheme.{u} := ξ.normalization
  let ν : C_sch ⟶ C_cl := ξ.fromNormalization
  let p_C : C_sch ⟶ C_bar.left := ν ≫ i_cl
  let C_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
    CategoryTheory.Over.mk (p_C ≫ C_bar.hom)

  have hInt_C_tilde : AlgebraicGeometry.IsIntegral C_tilde.left := by
    change AlgebraicGeometry.IsIntegral ξ.normalization
    have : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (C_cl.presheaf.stalk η)) := by
      change AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec C_cl.functionField)
      infer_instance
    infer_instance

  
  have hChart : ∀ (V : C_cl.Opens) (hV : AlgebraicGeometry.IsAffineOpen V) [Nonempty V],
      (∃ e : ↥(integralClosure ↑(C_cl.presheaf.obj (Opposite.op V)) ↑C_cl.functionField) ≃+*
          ↑(C_sch.presheaf.obj (Opposite.op (ν ⁻¹ᵁ V))),
        ∀ a : ↑(C_cl.presheaf.obj (Opposite.op V)),
          e (algebraMap ↑(C_cl.presheaf.obj (Opposite.op V))
              ↥(integralClosure ↑(C_cl.presheaf.obj (Opposite.op V)) ↑C_cl.functionField) a) =
            (ν.app V).hom a) ∧
      (IsIntegrallyClosed ↑(C_cl.presheaf.obj (Opposite.op V)) →
        Function.Bijective (ν.app V).hom) ∧
      Module.Finite ↑(C_cl.presheaf.obj (Opposite.op V))
        ↥(integralClosure ↑(C_cl.presheaf.obj (Opposite.op V)) ↑C_cl.functionField) ∧
      IsIntegrallyClosed
        ↥(integralClosure ↑(C_cl.presheaf.obj (Opposite.op V)) ↑C_cl.functionField) := by
    intro V hV hNeV
    have ⟨⟨v₀, hv₀⟩⟩ := hNeV
    have hηV : η ∈ V :=
      ((genericPoint_spec ↥C_cl).mem_open_set_iff V.isOpen).mpr ⟨v₀, Set.mem_univ v₀, hv₀⟩
    let Z_η := AlgebraicGeometry.Spec (C_cl.presheaf.stalk η)
    let W_ξ : Z_η.Opens := ξ ⁻¹ᵁ V
    have hW_top : W_ξ = ⊤ := by
      ext pt
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      change ξ.base pt ∈ (V : Set ↥C_cl)
      have h_mem_range : ξ.base pt ∈ Set.range ⇑ξ := ⟨pt, rfl⟩
      rw [AlgebraicGeometry.Scheme.range_fromSpecStalk] at h_mem_range
      have h_spec : ξ.base pt ⤳ η := h_mem_range
      exact h_spec.mem_open V.isOpen hηV
    let A_V : Type u := ↑(C_cl.presheaf.obj (Opposite.op V))
    let K : Type u := ↑C_cl.functionField
    let B_V : Type u := ↑(Z_η.presheaf.obj (Opposite.op W_ξ))
    let _ : Algebra A_V B_V := (ξ.app V).hom.toAlgebra
    let iso_KB : C_cl.functionField ≅ Z_η.presheaf.obj (Opposite.op W_ξ) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (C_cl.presheaf.stalk η)).symm ≪≫
        Z_η.presheaf.mapIso (CategoryTheory.eqToIso hW_top).op
    have h_app_eq : ξ.app V = C_cl.presheaf.germ V η hηV ≫ iso_KB.hom := by
      rw [AlgebraicGeometry.Scheme.fromSpecStalk_app hηV]
      dsimp only [iso_KB, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
        CategoryTheory.Functor.mapIso_hom]
      have h_op : (CategoryTheory.homOfLE (le_top : W_ξ ≤ ⊤)).op =
          (CategoryTheory.eqToIso hW_top).op.hom := Subsingleton.elim _ _
      rw [h_op]
    let φ_alg : K ≃ₐ[A_V] B_V :=
      { iso_KB.commRingCatIsoToRingEquiv with
        commutes' := fun a => by
          change iso_KB.hom.hom ((C_cl.germToFunctionField V).hom a) = (ξ.app V).hom a
          have h_germ : C_cl.germToFunctionField V = C_cl.presheaf.germ V η hηV := rfl
          rw [h_germ, h_app_eq]
          rfl }
    let Ψ_V : ↥(integralClosure A_V K) ≃ₐ[A_V] ↥(integralClosure A_V B_V) :=
      AlgEquiv.mapIntegralClosure φ_alg
    let e_V : ↥(integralClosure A_V K) ≃+* ↑(C_sch.presheaf.obj (Opposite.op (ν ⁻¹ᵁ V))) :=
      Ψ_V.toRingEquiv.trans (ξ.normalizationObjIso hV).symm.commRingCatIsoToRingEquiv
    have he_V : ∀ a : A_V, e_V (algebraMap A_V ↥(integralClosure A_V K) a) = (ν.app V).hom a := by
      intro a
      change (ξ.normalizationObjIso hV).inv.hom (Ψ_V (algebraMap A_V ↥(integralClosure A_V K) a)) =
        (ξ.fromNormalization.app V).hom a
      rw [Ψ_V.commutes a, ξ.fromNormalization_app hV]
      rfl
    have : IsDomain A_V := AlgebraicGeometry.IsIntegral.component_integral V
    have : IsFractionRing A_V K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C_cl V hV
    have hBij_imp : IsIntegrallyClosed A_V → Function.Bijective (ν.app V).hom := by
      intro hIC_A
      let α : A_V →+* ↥(integralClosure A_V K) := algebraMap A_V ↥(integralClosure A_V K)
      have hInj : Function.Injective α := by
        intro a₁ a₂ h12
        exact IsFractionRing.injective A_V K (congrArg Subtype.val h12)
      have hSurj : Function.Surjective α := by
        intro c
        obtain ⟨a, ha⟩ := (isIntegrallyClosed_iff K).mp hIC_A c.2
        exact ⟨a, Subtype.ext ha⟩
      have h_comp : (ν.app V).hom = e_V.toRingHom.comp α :=
        RingHom.ext fun a => (he_V a).symm
      rw [h_comp]
      exact e_V.bijective.comp ⟨hInj, hSurj⟩
    have hFin_IC : Module.Finite A_V ↥(integralClosure A_V K) ∧
        IsIntegrallyClosed ↥(integralClosure A_V K) := by
      let φ_Ω : Ω →+* A_V :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          f_cl.appLE ⊤ V le_top).hom
      have hφ_eq : φ_Ω = (f_cl.appLE ⊤ V le_top).hom.comp
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom := rfl
      have hFT_app : (f_cl.appLE ⊤ V le_top).hom.FiniteType :=
        f_cl.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hV le_top
      have hFT_iso : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom.FiniteType :=
        RingHom.FiniteType.of_surjective _
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm.commRingCatIsoToRingEquiv.surjective
      let _ : Algebra Ω A_V := φ_Ω.toAlgebra
      have : Algebra.FiniteType Ω A_V := by
        change φ_Ω.FiniteType
        rw [hφ_eq]
        exact hFT_app.comp hFT_iso
      exact hIntClosFin A_V K
    exact ⟨⟨e_V, he_V⟩, hBij_imp, hFin_IC.1, hFin_IC.2⟩

  
  have : AlgebraicGeometry.IsFinite ν := by
    refine (AlgebraicGeometry.isFinite_iff ν).mpr ⟨inferInstance, fun V hV => ?_⟩
    by_cases hNe : Nonempty V
    · have := hNe
      obtain ⟨⟨e_V, he_V⟩, _, hFin_V, _⟩ := hChart V hV
      have h_comp : (ν.app V).hom = e_V.toRingHom.comp (algebraMap _ _) :=
        RingHom.ext fun a => (he_V a).symm
      rw [h_comp]
      exact (RingHom.Finite.of_surjective _ e_V.surjective).comp
        (RingHom.finite_algebraMap.mpr hFin_V)
    · have hV_bot : V = ⊥ := by
        ext z
        exact ⟨fun hz => False.elim (hNe ⟨⟨z, hz⟩⟩), False.elim⟩
      subst hV_bot
      have h_bot_pre : ν ⁻¹ᵁ (⊥ : C_cl.Opens) = ⊥ := rfl
      have : Subsingleton ↑(C_sch.presheaf.obj (Opposite.op (ν ⁻¹ᵁ (⊥ : C_cl.Opens)))) := by
        rw [h_bot_pre]
        infer_instance
      exact RingHom.Finite.of_surjective _ (fun y => ⟨0, Subsingleton.elim _ _⟩)

  have hProp_pC : AlgebraicGeometry.IsProper p_C := by
    change AlgebraicGeometry.IsProper (ν ≫ i_cl)
    infer_instance
  have hProp_C_tilde : AlgebraicGeometry.IsProper C_tilde.hom := by
    change AlgebraicGeometry.IsProper (p_C ≫ C_bar.hom)
    infer_instance

  
  have hBij_V₀ : Function.Bijective (ν.app V₀).hom :=
    (hChart V₀ hAff_V₀).2.1 hIC_V₀
  let W₀ : C_sch.Opens := ν ⁻¹ᵁ V₀
  have : AlgebraicGeometry.IsAffine V₀.toScheme := hAff_V₀
  have hAff_W₀ : AlgebraicGeometry.IsAffineOpen W₀ := hAff_V₀.preimage ν
  have : AlgebraicGeometry.IsAffine W₀.toScheme := hAff_W₀
  have : CategoryTheory.IsIso (ν.app V₀) := by
    have h_eq_iso : ν.app V₀ = (RingEquiv.ofBijective (ν.app V₀).hom hBij_V₀).toCommRingCatIso.hom := by
      ext x
      rfl
    rw [h_eq_iso]
    infer_instance
  have hImg_V₀ : V₀.ι ''ᵁ ⊤ = V₀ :=
    (V₀.ι.image_top_eq_opensRange).trans V₀.opensRange_ι
  have hIso_img : CategoryTheory.IsIso (ν.app (V₀.ι ''ᵁ ⊤)) := by
    rw [hImg_V₀]
    infer_instance
  have hMapEqIso : ∀ {U₁ U₂ : C_sch.Opens} (h : U₁ = U₂),
      CategoryTheory.IsIso (C_sch.presheaf.map (CategoryTheory.eqToHom h).op) :=
    fun h => (C_sch.presheaf.mapIso (CategoryTheory.eqToIso h).op).isIso_hom
  have : CategoryTheory.IsIso (ν ∣_ V₀).appTop := by
    rw [AlgebraicGeometry.morphismRestrict_appTop ν V₀]
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_img (hMapEqIso _)
  have : CategoryTheory.IsIso (ν ∣_ V₀) := by
    have hg : (ν ∣_ V₀) =
        W₀.toScheme.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (ν ∣_ V₀).appTop ≫
          V₀.toScheme.isoSpec.inv := by
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.isoSpec_hom_naturality (ν ∣_ V₀),
        CategoryTheory.Category.assoc,
        CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.comp_id]
    rw [hg]
    infer_instance

  let e_lift : U₀.toScheme ≅ W₀.toScheme :=
    j_cl.isoOpensRange ≪≫ (CategoryTheory.asIso (ν ∣_ V₀)).symm
  let j_tilde : U₀.toScheme ⟶ C_tilde.left := e_lift.hom ≫ W₀.ι

  have hOpen_j : AlgebraicGeometry.IsOpenImmersion j_tilde := by
    change AlgebraicGeometry.IsOpenImmersion (e_lift.hom ≫ W₀.ι)
    infer_instance

  have hj_ν : j_tilde ≫ ν = j_cl := by
    change (j_cl.isoOpensRange.hom ≫ CategoryTheory.inv (ν ∣_ V₀) ≫ W₀.ι) ≫ ν = j_cl
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.morphismRestrict_ι ν V₀,
      CategoryTheory.IsIso.inv_hom_id_assoc,
      j_cl.isoOpensRange_hom_ι]

  have hj_pC : j_tilde ≫ p_C = U₀.ι := by
    change j_tilde ≫ (ν ≫ i_cl) = U₀.ι
    rw [← CategoryTheory.Category.assoc, hj_ν, (U₀.ι).toImage_imageι]

  have hj_range : j_tilde.opensRange = W₀ := by
    ext w
    constructor
    · rintro ⟨u, rfl⟩
      exact (e_lift.hom.base u).2
    · intro hw
      refine ⟨e_lift.inv.base ⟨w, hw⟩, ?_⟩
      have h_id : e_lift.hom.base (e_lift.inv.base ⟨w, hw⟩) = ⟨w, hw⟩ := by
        change (e_lift.inv ≫ e_lift.hom).base ⟨w, hw⟩ = ⟨w, hw⟩
        rw [e_lift.inv_hom_id]
        rfl
      change (e_lift.hom.base (e_lift.inv.base ⟨w, hw⟩)).1 = w
      rw [h_id]

  have hPre_p : p_C ⁻¹ᵁ U₀.ι.opensRange = j_tilde.opensRange := by
    rw [U₀.opensRange_ι, hj_range]
    ext w
    change (ν ≫ i_cl).base w ∈ U₀ ↔ w ∈ W₀
    change i_cl.base (ν.base w) ∈ U₀ ↔ ν.base w ∈ V₀
    change ν.base w ∈ (TopologicalSpace.Opens.map i_cl.base).obj U₀ ↔ ν.base w ∈ V₀
    rw [hPre_i]

  have hPull : CategoryTheory.IsPullback j_tilde
      (CategoryTheory.CategoryStruct.id U₀.toScheme) p_C U₀.ι := by
    have hPull_flip : CategoryTheory.IsPullback
        (CategoryTheory.CategoryStruct.id U₀.toScheme) j_tilde U₀.ι p_C :=
      @AlgebraicGeometry.IsOpenImmersion.isPullback _ _ _ _
        (CategoryTheory.CategoryStruct.id U₀.toScheme) j_tilde U₀.ι p_C
        hOpen_j inferInstance
        (hj_pC.trans (CategoryTheory.Category.id_comp U₀.ι).symm)
        hPre_p
    exact hPull_flip.flip

  
  have hCover : ∀ x : ↥C_tilde.left, ∃ W : C_tilde.left.Opens,
      x ∈ W ∧
      AlgebraicGeometry.IsAffineOpen W ∧
      IsIntegrallyClosed ↑(C_tilde.left.presheaf.obj (Opposite.op W)) := by
    intro x
    obtain ⟨V, hV, hxV, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (TopologicalSpace.Opens.mem_top (ν.base x))
    have : Nonempty V := ⟨⟨ν.base x, hxV⟩⟩
    obtain ⟨⟨e_V, _⟩, _, _, hIC_intV⟩ := hChart V hV
    let W : C_tilde.left.Opens := ν ⁻¹ᵁ V
    exact ⟨W, hxV, hV.preimage ν, @IsIntegrallyClosed.of_equiv _ _ _ _ e_V hIC_intV⟩

  exact ⟨C_tilde, p_C, j_tilde, hInt_C_tilde, rfl, hProp_pC, hProp_C_tilde,
    hOpen_j, hj_pC, hPull, hCover⟩

theorem weil_connected_etale_curve_completion_over_smooth_curve (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hIntP : AlgebraicGeometry.IsIntegral P.left)
    [AlgebraicGeometry.IsProper P.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 P.hom]
    (ι_P : Quiver.Hom (weilGysinAffineSpace Ω 1) P.left)
    (hOpen_P : AlgebraicGeometry.IsOpenImmersion ι_P)
    (hι_P_hom : CategoryTheory.CategoryStruct.comp ι_P P.hom = weilGysinAffineStruct Ω 1)
    (C : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine C] [ConnectedSpace ↥C]
    (w : Quiver.Hom C (weilGysinAffineSpace Ω 1)) [AlgebraicGeometry.Etale w] :
    ∃ (N : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (j_N : Quiver.Hom C N.left)
      (d : ℕ)
      (u_bar : Quiver.Hom N.left P.left),
      AlgebraicGeometry.IsIntegral N.left ∧
      AlgebraicGeometry.IsProper N.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 N.hom ∧
      1 ≤ d ∧
      CategoryTheory.CategoryStruct.comp u_bar P.hom = N.hom ∧
      AlgebraicGeometry.IsFinite u_bar ∧
      AlgebraicGeometry.Surjective u_bar ∧
      AlgebraicGeometry.IsOpenImmersion j_N ∧
      CategoryTheory.CategoryStruct.comp j_N u_bar =
        CategoryTheory.CategoryStruct.comp w ι_P ∧
      WeilTopDegFiniteLocallyFreeOfRank d u_bar ∧
      (∀ q : ↥P.left, ∃ W : P.left.Opens,
        q ∈ W ∧
        AlgebraicGeometry.IsAffineOpen W ∧
        AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map u_bar.base).obj W) ∧
        IsDedekindDomain
          ↑(N.left.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map u_bar.base).obj W)))) :=
by
  classical
  let _ := hι_P_hom
  letI : AlgebraicGeometry.IsIntegral P.left := hIntP
  letI : AlgebraicGeometry.IsOpenImmersion ι_P := hOpen_P
  let S_Ω : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let R₀ : Type u := Polynomial Ω
  let A1_Ω : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R₀)
  haveI hIrred_P : IrreducibleSpace ↥P.left :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral P.left
  haveI hSub_SΩ : Subsingleton ↥S_Ω := by
    change Subsingleton (PrimeSpectrum Ω)
    infer_instance
  haveI hQS_SΩ : QuasiSeparatedSpace ↥S_Ω := by
    change QuasiSeparatedSpace (PrimeSpectrum Ω)
    infer_instance
  haveI hQS_P : QuasiSeparatedSpace ↥P.left :=
    (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace P.hom).mp inferInstance

  
  let e_poly_alg : MvPolynomial (Fin 1) Ω ≃ₐ[Ω] Polynomial Ω :=
    (MvPolynomial.finSuccEquiv Ω 0).trans
      (Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv Ω (Fin 0)))
  let e_poly_ring : R₀ ≃+* MvPolynomial (Fin 1) Ω := e_poly_alg.symm.toRingEquiv
  let e_A1_hom : weilGysinAffineSpace Ω 1 ⟶ A1_Ω :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_poly_ring.toRingHom)
  let e_A1_inv : A1_Ω ⟶ weilGysinAffineSpace Ω 1 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_poly_ring.symm.toRingHom)
  have h_eA1_1 : e_A1_hom ≫ e_A1_inv = 𝟙 (weilGysinAffineSpace Ω 1) := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_poly_ring.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_poly_ring.symm.toRingHom) =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) Ω)))
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_re1 : e_poly_ring.toRingHom.comp e_poly_ring.symm.toRingHom =
        RingHom.id (MvPolynomial (Fin 1) Ω) :=
      RingHom.ext (fun p => e_poly_ring.apply_symm_apply p)
    rw [h_re1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have h_eA1_2 : e_A1_inv ≫ e_A1_hom = 𝟙 A1_Ω := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_poly_ring.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_poly_ring.toRingHom) =
      𝟙 A1_Ω
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_re2 : e_poly_ring.symm.toRingHom.comp e_poly_ring.toRingHom =
        RingHom.id R₀ :=
      RingHom.ext (fun p => e_poly_ring.symm_apply_apply p)
    rw [h_re2, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  haveI hIso_eA1_hom : CategoryTheory.IsIso e_A1_hom := ⟨⟨e_A1_inv, h_eA1_1, h_eA1_2⟩⟩
  haveI hIso_eA1_inv : CategoryTheory.IsIso e_A1_inv := ⟨⟨e_A1_hom, h_eA1_2, h_eA1_1⟩⟩
  let u_C : C ⟶ A1_Ω := w ≫ e_A1_hom
  haveI hEt_uC : AlgebraicGeometry.Etale u_C := by
    dsimp only [u_C]
    infer_instance
  let ι₁ : A1_Ω ⟶ P.left := e_A1_inv ≫ ι_P
  haveI hOpen_ι₁ : AlgebraicGeometry.IsOpenImmersion ι₁ := by
    dsimp only [ι₁]
    infer_instance
  have huC_ι1 : u_C ≫ ι₁ = w ≫ ι_P := by
    dsimp only [u_C, ι₁]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_A1_hom e_A1_inv ι_P,
      h_eA1_1, CategoryTheory.Category.id_comp]

  
  let B_cat : CommRingCat.{u} := C.presheaf.obj (Opposite.op ⊤)
  let B : Type u := ↑B_cat
  let e_C : C ≅ AlgebraicGeometry.Spec B_cat := C.isoSpec
  have hSurj_eC : Function.Surjective e_C.hom.base := fun y =>
    ⟨e_C.inv.base y, by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, e_C.inv_hom_id]
      rfl⟩
  haveI hConn_B : ConnectedSpace (PrimeSpectrum B) := by
    have hConn_Spec : ConnectedSpace ↥(AlgebraicGeometry.Spec B_cat) :=
      hSurj_eC.connectedSpace e_C.hom.continuous
    exact hConn_Spec
  let φ_cat : CommRingCat.of R₀ ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_C.inv ≫ u_C)
  have hSpec_φ : AlgebraicGeometry.Spec.map φ_cat = e_C.inv ≫ u_C :=
    AlgebraicGeometry.Spec.map_preimage (e_C.inv ≫ u_C)
  have hEt_Specφ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_cat) := by
    rw [hSpec_φ]
    infer_instance
  have hEt_φhom : RingHom.Etale φ_cat.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Specφ
  letI : Algebra R₀ B := φ_cat.hom.toAlgebra
  haveI hEt_R₀B : Algebra.Etale R₀ B := RingHom.etale_algebraMap.mp hEt_φhom
  obtain ⟨hDom_B, hIC_B, hDed_B, _hInj_R₀B, hFrac_B⟩ :=
    weil_connected_etale_dedekind_domain_and_separable_frac R₀ B
  letI : IsDomain B := hDom_B
  letI : IsIntegrallyClosed B := hIC_B
  letI : IsDedekindDomain B := hDed_B
  haveI hNonempty_C : Nonempty ↥C := ConnectedSpace.toNonempty
  haveI hInt_C : AlgebraicGeometry.IsIntegral C :=
    @AlgebraicGeometry.isIntegral_of_isAffine_of_isDomain C _ hNonempty_C hDom_B
  haveI hIrred_C : IrreducibleSpace ↥C := AlgebraicGeometry.irreducibleSpace_of_isIntegral C

  
  have hOpen_inter : ∀ {X : Type u} [TopologicalSpace X] [IrreducibleSpace X]
      {U V : Set X}, IsOpen U → IsOpen V → U.Nonempty → V.Nonempty → (U ∩ V).Nonempty := by
    intro X _ _ U V hU hV hUne hVne
    obtain ⟨x, -, hxUV⟩ := PreirreducibleSpace.isPreirreducible_univ U V hU hV
      (by rwa [Set.univ_inter]) (by rwa [Set.univ_inter])
    exact ⟨x, hxUV⟩
  have hDedCover : ∀ y : ↥P.left, ∃ W : P.left.Opens,
      y ∈ W ∧ AlgebraicGeometry.IsAffineOpen W ∧
        IsDedekindDomain ↑(P.left.presheaf.obj (Opposite.op W)) := by
    intro y
    obtain ⟨U_Ω, _hAff_UΩ, W, hW, hyW, he_W, hStd_W⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 P.hom).mp inferInstance y
    have hUΩ_top : U_Ω = ⊤ := by
      ext pt
      exact iff_of_true (by rw [hSub_SΩ.elim pt (P.hom.base y)]; exact he_W hyW) trivial
    let iso_Ω : CommRingCat.of Ω ≅ S_Ω.presheaf.obj (Opposite.op U_Ω) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm ≪≫
        S_Ω.presheaf.mapIso (CategoryTheory.eqToIso hUΩ_top).op
    let A_W_cat : CommRingCat.{u} := P.left.presheaf.obj (Opposite.op W)
    let A_W : Type u := ↑A_W_cat
    let g_W : S_Ω.presheaf.obj (Opposite.op U_Ω) ⟶ A_W_cat :=
      P.hom.appLE U_Ω W he_W
    have hStd_Ω : RingHom.IsStandardSmoothOfRelativeDimension 1 (g_W.hom.comp iso_Ω.hom.hom) :=
      (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
        iso_Ω.hom g_W).mpr hStd_W
    obtain ⟨ψ_mv, _hψ_mv_comp, hψ_mv_et⟩ := hStd_Ω.exists_etale_mvPolynomial
    have hEt_R₀_AW : RingHom.Etale (ψ_mv.comp e_poly_ring.toRingHom) :=
      (RingHom.Etale.respectsIso.cancel_left_isIso
        e_poly_ring.toCommRingCatIso.hom (CommRingCat.ofHom ψ_mv)).mpr hψ_mv_et
    letI : Algebra R₀ A_W := (ψ_mv.comp e_poly_ring.toRingHom).toAlgebra
    haveI : Algebra.Etale R₀ A_W := RingHom.etale_algebraMap.mp hEt_R₀_AW
    haveI : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨y, hyW⟩⟩
    haveI hDom_AW : IsDomain A_W := AlgebraicGeometry.IsIntegral.component_integral W
    haveI : IrreducibleSpace (PrimeSpectrum A_W) := PrimeSpectrum.irreducibleSpace
    haveI : ConnectedSpace (PrimeSpectrum A_W) := IrreducibleSpace.connectedSpace (PrimeSpectrum A_W)
    have hDed_AW : IsDedekindDomain A_W :=
      (weil_connected_etale_dedekind_domain_and_separable_frac R₀ A_W).2.2.1
    exact ⟨W, hyW, hW, hDed_AW⟩

  
  let V₁ : P.left.Opens := ι₁.opensRange
  have hAff_V1 : AlgebraicGeometry.IsAffineOpen V₁ :=
    AlgebraicGeometry.isAffineOpen_opensRange ι₁
  let A_V1_cat : CommRingCat.{u} := P.left.presheaf.obj (Opposite.op V₁)
  let A_V1 : Type u := ↑A_V1_cat
  have hRange_V1 : Set.range ι₁.base = Set.range hAff_V1.fromSpec.base :=
    hAff_V1.range_fromSpec.symm
  let lift_V1_to : A1_Ω ⟶ AlgebraicGeometry.Spec A_V1_cat :=
    AlgebraicGeometry.IsOpenImmersion.lift hAff_V1.fromSpec ι₁ (le_of_eq hRange_V1)
  let lift_V1_from : AlgebraicGeometry.Spec A_V1_cat ⟶ A1_Ω :=
    AlgebraicGeometry.IsOpenImmersion.lift ι₁ hAff_V1.fromSpec (le_of_eq hRange_V1.symm)
  have h_lift_1 : lift_V1_to ≫ lift_V1_from = 𝟙 A1_Ω := by
    rw [← CategoryTheory.cancel_mono ι₁, CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsOpenImmersion.lift_fac, AlgebraicGeometry.IsOpenImmersion.lift_fac,
      CategoryTheory.Category.id_comp]
  have h_lift_2 : lift_V1_from ≫ lift_V1_to = 𝟙 (AlgebraicGeometry.Spec A_V1_cat) := by
    rw [← CategoryTheory.cancel_mono hAff_V1.fromSpec, CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsOpenImmersion.lift_fac, AlgebraicGeometry.IsOpenImmersion.lift_fac,
      CategoryTheory.Category.id_comp]
  let φ_V1 : A_V1_cat ⟶ CommRingCat.of R₀ := AlgebraicGeometry.Spec.preimage lift_V1_to
  let φ_V1_inv : CommRingCat.of R₀ ⟶ A_V1_cat := AlgebraicGeometry.Spec.preimage lift_V1_from
  have hφ_V1_1 : φ_V1 ≫ φ_V1_inv = 𝟙 A_V1_cat := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, h_lift_2, AlgebraicGeometry.Spec.map_id]
  have hφ_V1_2 : φ_V1_inv ≫ φ_V1 = 𝟙 (CommRingCat.of R₀) := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, h_lift_1, AlgebraicGeometry.Spec.map_id]
  haveI hIso_φV1 : CategoryTheory.IsIso φ_V1 := ⟨⟨φ_V1_inv, hφ_V1_1, hφ_V1_2⟩⟩
  haveI hIso_φV1_inv : CategoryTheory.IsIso φ_V1_inv := ⟨⟨φ_V1, hφ_V1_2, hφ_V1_1⟩⟩
  let η_A1 : PrimeSpectrum R₀ :=
    ⟨⊥, ⟨bot_ne_top, fun {a b} hab => mul_eq_zero.mp hab⟩⟩
  haveI hNe_V1 : Nonempty ↥(V₁ : AlgebraicGeometry.Scheme.{u}) :=
    ⟨⟨ι₁.base η_A1, ⟨η_A1, rfl⟩⟩⟩
  haveI hDom_AV1 : IsDomain A_V1 := AlgebraicGeometry.IsIntegral.component_integral V₁
  have hDed_AV1 : IsDedekindDomain A_V1 := by
    have hId : RingHom.Etale (CommRingCat.Hom.hom (𝟙 (CommRingCat.of R₀))) :=
      RingHom.etale_algebraMap.mpr (inferInstance : Algebra.Etale R₀ R₀)
    have hEt_inv : RingHom.Etale φ_V1_inv.hom :=
      (RingHom.Etale.respectsIso.cancel_right_isIso
        (𝟙 (CommRingCat.of R₀)) φ_V1_inv).mpr hId
    letI : Algebra R₀ A_V1 := φ_V1_inv.hom.toAlgebra
    haveI : Algebra.Etale R₀ A_V1 := RingHom.etale_algebraMap.mp hEt_inv
    haveI : IrreducibleSpace (PrimeSpectrum A_V1) := PrimeSpectrum.irreducibleSpace
    haveI : ConnectedSpace (PrimeSpectrum A_V1) :=
      IrreducibleSpace.connectedSpace (PrimeSpectrum A_V1)
    exact (weil_connected_etale_dedekind_domain_and_separable_frac R₀ A_V1).2.2.1

  have hη_A1_gen : ι₁.base η_A1 = genericPoint ↥P.left := by
    have hGen : IsGenericPoint (ι₁.base η_A1) Set.univ := by
      rw [isGenericPoint_def]
      apply Set.eq_univ_of_forall
      intro p
      rw [mem_closure_iff]
      intro G hG hpG
      have hInter : (G ∩ (V₁ : Set ↥P.left)).Nonempty :=
        hOpen_inter hG V₁.isOpen ⟨p, hpG⟩ ⟨ι₁.base η_A1, ⟨η_A1, rfl⟩⟩
      obtain ⟨_, hp_in_G, q_G, rfl⟩ := hInter
      have hOpen_pre : IsOpen (ι₁.base ⁻¹' G) := ι₁.continuous.isOpen_preimage G hG
      obtain ⟨B_open, ⟨_, ⟨f₀, rfl⟩, rfl⟩, hq_B, hB_sub⟩ :=
        PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open hp_in_G hOpen_pre
      have hf₀_not_mem : f₀ ∉ q_G.asIdeal := (PrimeSpectrum.mem_basicOpen f₀ q_G).mp hq_B
      have hf₀_ne : f₀ ≠ 0 := fun h0 => hf₀_not_mem (h0 ▸ q_G.asIdeal.zero_mem)
      have hη_mem_B : η_A1 ∈ PrimeSpectrum.basicOpen f₀ := by
        rw [PrimeSpectrum.mem_basicOpen]
        exact hf₀_ne
      exact ⟨ι₁.base η_A1, hB_sub hη_mem_B, rfl⟩
    exact hGen.eq (genericPoint_spec ↥P.left)

  have hNonGen : ∀ (W : P.left.Opens), AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) → ∃ z : ↥W, z.1 ≠ genericPoint ↥P.left := by
    intro W _hW hNeW
    obtain ⟨w₀⟩ := hNeW
    have hInter : ((W : Set ↥P.left) ∩ (V₁ : Set ↥P.left)).Nonempty :=
      hOpen_inter W.isOpen V₁.isOpen ⟨w₀.1, w₀.2⟩ ⟨ι₁.base η_A1, ⟨η_A1, rfl⟩⟩
    obtain ⟨_, h_in_W, q₀, rfl⟩ := hInter
    have hOpen_O : IsOpen (ι₁.base ⁻¹' (W : Set ↥P.left)) :=
      ι₁.continuous.isOpen_preimage _ W.isOpen
    obtain ⟨B_open, ⟨_, ⟨h_poly, rfl⟩, rfl⟩, hq₀_B, hB_sub⟩ :=
      PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open h_in_W hOpen_O
    have hh_not : h_poly ∉ q₀.asIdeal := (PrimeSpectrum.mem_basicOpen h_poly q₀).mp hq₀_B
    have hh_ne : h_poly ≠ 0 := fun h0 => hh_not (h0 ▸ q₀.asIdeal.zero_mem)
    haveI : Infinite Ω := inferInstance
    obtain ⟨a, ha_not⟩ := Infinite.exists_notMem_finset h_poly.roots.toFinset
    have ha_ev : Polynomial.eval a h_poly ≠ 0 := by
      intro h0
      exact ha_not (Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hh_ne).mpr h0))
    let ev_a : R₀ →+* Ω := Polynomial.evalRingHom a
    have hSurj_eva : Function.Surjective ev_a :=
      fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
    have hm_a : (RingHom.ker ev_a).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ev_a hSurj_eva
    let x_a : PrimeSpectrum R₀ := ⟨RingHom.ker ev_a, hm_a.isPrime⟩
    have hxa_B : x_a ∈ PrimeSpectrum.basicOpen h_poly := by
      rw [PrimeSpectrum.mem_basicOpen]
      exact ha_ev
    have hxa_W : ι₁.base x_a ∈ W := hB_sub hxa_B
    have hxa_ne_η : x_a ≠ η_A1 := by
      intro heq
      have hmem : Polynomial.X - Polynomial.C a ∈ x_a.asIdeal := by
        change Polynomial.eval a (Polynomial.X - Polynomial.C a) = 0
        simp
      rw [heq] at hmem
      exact Polynomial.X_sub_C_ne_zero a hmem
    refine ⟨⟨ι₁.base x_a, hxa_W⟩, ?_⟩
    rw [← hη_A1_gen]
    exact fun h_eq => hxa_ne_η (ι₁.isOpenEmbedding.injective h_eq)

  
  let x_C : ↥C := genericPoint ↥C
  let x_P : ↥P.left := genericPoint ↥P.left
  let K_cat : CommRingCat.{u} := C.functionField
  let K : Type u := ↑K_cat
  let K₀_cat : CommRingCat.{u} := P.left.functionField
  let K₀ : Type u := ↑K₀_cat
  let η_C : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C := C.fromSpecStalk x_C
  let p_C : C ⟶ P.left := u_C ≫ ι₁
  let ξ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ P.left := η_C ≫ p_C
  haveI hQC_ξ : AlgebraicGeometry.QuasiCompact ξ :=
    AlgebraicGeometry.quasiCompact_of_compactSpace ξ
  haveI hQS_ξ : AlgebraicGeometry.QuasiSeparated ξ :=
    (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace ξ).mpr inferInstance

  have hpC_gen : p_C.base x_C = x_P := by
    haveI : AlgebraicGeometry.Etale p_C := by
      dsimp only [p_C]
      infer_instance
    have hGen : IsGenericPoint (p_C.base x_C) Set.univ := by
      rw [isGenericPoint_def]
      apply Set.eq_univ_of_forall
      intro y
      rw [mem_closure_iff]
      intro G hG hyG
      obtain ⟨c₀⟩ := hNonempty_C
      have hInter : (G ∩ Set.range p_C.base).Nonempty :=
        hOpen_inter hG p_C.isOpenMap.isOpen_range ⟨y, hyG⟩ ⟨p_C.base c₀, ⟨c₀, rfl⟩⟩
      obtain ⟨_, hc_G, c₁, rfl⟩ := hInter
      have hOpen_pre : IsOpen (p_C.base ⁻¹' G) := p_C.continuous.isOpen_preimage G hG
      have hxC_pre : x_C ∈ p_C.base ⁻¹' G :=
        ((genericPoint_spec ↥C).mem_open_set_iff hOpen_pre).mpr ⟨c₁, trivial, hc_G⟩
      exact ⟨p_C.base x_C, hxC_pre, rfl⟩
    exact hGen.eq (genericPoint_spec ↥P.left)

  have hξ_gen : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)), ξ.base pt = x_P := by
    intro pt
    have hSub_K : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      change Subsingleton (PrimeSpectrum K)
