    intro W hNeW
    dsimp only [ψ_cat, AlgebraicGeometry.Scheme.germToFunctionField]
    rw [← CategoryTheory.Category.assoc, TopCat.Presheaf.germ_stalkSpecializes,
      AlgebraicGeometry.Scheme.Hom.germ_stalkMap]

  have hξ_app : ∀ (W : P.left.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})]
