        let rhs_g := (adj_ab.homEquiv (U_Y.obj ℱ) (U_Z.obj 𝒢)).symm ug
        have hL : U_Z.map (ff_Z.preimage
            (CategoryTheory.CategoryStruct.comp (Φ_pull.hom.app ℱ') lhs_in)) =
