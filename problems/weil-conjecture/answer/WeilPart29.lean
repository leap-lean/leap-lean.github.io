        · intro c
          have h1 := congrArg (fun m => CategoryTheory.CategoryStruct.comp m
            (CategoryTheory.Limits.pullback.fst f f)) c.condition
          have h2 := congrArg (fun m => CategoryTheory.CategoryStruct.comp m
            (CategoryTheory.Limits.pullback.snd f f)) c.condition
          simp only [Δ_f, q, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.comp_id] at h1 h2
          rw [CategoryTheory.Category.assoc, ← h2, h1]
        · intro c m _ hm₂
          calc m = CategoryTheory.CategoryStruct.comp m (CategoryTheory.CategoryStruct.id Y) :=
                (CategoryTheory.Category.comp_id m).symm
            _ = CategoryTheory.CategoryStruct.comp m (CategoryTheory.CategoryStruct.comp s f) := by
                rw [hs]
            _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp m s) f :=
                (CategoryTheory.Category.assoc m s f).symm
            _ = CategoryTheory.CategoryStruct.comp c.snd f := by rw [hm₂]
      have hDiag : AlgebraicGeometry.IsOpenImmersion Δ_f := inferInstance
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_s hDiag
    · intro hsep
      have : AlgebraicGeometry.IsSeparated f := hsep
      have hcl : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.CategoryStruct.comp s f) := by
        rw [hs]
        infer_instance
      exact CategoryTheory.MorphismProperty.of_postcomp
        (W' := @AlgebraicGeometry.IsSeparated)
        (@AlgebraicGeometry.IsClosedImmersion) s f hsep hcl
  have h_aff_part : ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine X]
