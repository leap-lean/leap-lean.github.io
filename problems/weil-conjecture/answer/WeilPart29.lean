      have hab_y : algebraMap R_y (FractionRing R_y) a_y =
          u_ev_y.val * algebraMap R_y (FractionRing R_y) 1 := by
        have h1 : algebraMap R_y (FractionRing R_y) a_y = u_ev_y.val :=
          (hφ_TX_alg ⟨y, hy⟩ a_y).symm.trans
            ((congrArg (φ_tilde T_X ⟨y, hy⟩) (ψ_TX.apply_symm_apply f_K).symm).trans
              (hev_TX ⟨y, hy⟩ (ψ_TX.symm f_K)).symm)
        exact h1.trans ((mul_one u_ev_y.val).symm.trans
          (congrArg (u_ev_y.val * ·) (algebraMap R_y (FractionRing R_y)).map_one.symm))
      have hna_y : Ideal.span ({a_y} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ 1 := by
        rw [pow_one]; exact hSpan
      have hnb_y : Ideal.span ({(1 : R_y)} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ 0 := by
        rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one]
      exact (hordDVR R_y u_ev_y a_y 1 1 0 ha_y_ne one_ne_zero hab_y hna_y hnb_y).trans
        (sub_zero (1 : ℤ))

    let s₁ : ↥((weilEtaleKSheaf Y.left).obj.obj (Opposite.op U₁)) :=
      ((shAdj.unit.app (weilEtaleKPresheaf Y.left)).app (Opposite.op U₁)).hom s₁_pre
    have hs₁_ov : ((weilEtaleKSheaf Y.left).obj.map (Opposite.op j₁₂_₁)).hom s₁ =
        (ι_gm.hom.app (Opposite.op U₁₂)).hom u_Y_sh := by
      have hnat₁ := ConcreteCategory.congr_hom
        ((shAdj.unit.app (weilEtaleKPresheaf Y.left)).naturality (Opposite.op j₁₂_₁)) s₁_pre
      have hnat₂ := ConcreteCategory.congr_hom
        (congrArg (fun τ => τ.app (Opposite.op U₁₂)) (shAdj.unit.naturality ι_pre)) u_pre
      exact hnat₁.symm.trans ((congrArg _ hs₁_pre_ov).trans hnat₂)

    let q₁_sec : ↥(Q_div.obj.obj (Opposite.op U₁)) := (π_div.hom.app (Opposite.op U₁)).hom s₁
    have hq₁_ov : (Q_div.obj.map (Opposite.op j₁₂_₁)).hom q₁_sec = 0 := by
      have hnat := ConcreteCategory.congr_hom (π_div.hom.naturality (Opposite.op j₁₂_₁)) s₁
      change (π_div.hom.app (Opposite.op U₁₂)).hom
          (((weilEtaleKSheaf Y.left).obj.map (Opposite.op j₁₂_₁)).hom s₁) =
        (Q_div.obj.map (Opposite.op j₁₂_₁)).hom q₁_sec at hnat
      rw [← hnat, hs₁_ov]
      change ((ι_gm ≫ π_div).hom.app (Opposite.op U₁₂)).hom u_Y_sh = 0
      rw [h0_div]
      rfl

    let Fam : Bool → Y.left.Etale := fun b => cond b U₁ U₂
    let Arr : ∀ b : Bool, Fam b ⟶ T_X := fun b =>
      match b with
      | true => g₁
      | false => g₂
    let R_cov : CategoryTheory.Sieve T_X := CategoryTheory.Sieve.ofArrows Fam Arr
    have hR_cov : R_cov ∈ Y.left.smallEtaleTopology T_X := by
      rw [hMemEt]
      intro x
      have hx_cov : (x : ↥Y.left) ∈ (O₁ ⊔ O₂ : Y.left.Opens) := by rw [hcov]; trivial
      rcases hx_cov with hx₁ | hx₂
      · refine ⟨Fam true, Arr true, ⟨x, hx₁⟩,
          CategoryTheory.Sieve.ofArrows_mk Fam Arr true, ?_, rfl⟩
        change AlgebraicGeometry.Etale O₁.ι; infer_instance
      · refine ⟨Fam false, Arr false, ⟨x, hx₂⟩,
          CategoryTheory.Sieve.ofArrows_mk Fam Arr false, ?_, rfl⟩
        change AlgebraicGeometry.Etale O₂.ι; infer_instance

    have hQ_type : CategoryTheory.Presheaf.IsSheaf Y.left.smallEtaleTopology
        (Q_div.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf Y.left.smallEtaleTopology Q_div.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) Q_div.property

    let yHom : ∀ (Z : Y.left.Etale), (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ Y.left :=
      fun Z => Z.hom

    have hOpen_O₁ : AlgebraicGeometry.IsOpenImmersion O₁.ι := inferInstance
    have hOpen_O₁₂ : AlgebraicGeometry.IsOpenImmersion O₁₂.ι := inferInstance

    let liftO₁ : ∀ (Z : Y.left.Etale),
        Set.range (yHom Z).base ⊆ Set.range O₁.ι.base → (Z ⟶ U₁) :=
      fun Z hZ₁ =>
        let l : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ (O₁ : AlgebraicGeometry.Scheme.{u}) :=
          @AlgebraicGeometry.IsOpenImmersion.lift _ _ _ O₁.ι (yHom Z) hOpen_O₁ hZ₁
        have hl : l ≫ O₁.ι = yHom Z :=
          @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ O₁.ι (yHom Z) hOpen_O₁ hZ₁
        CategoryTheory.MorphismProperty.Over.homMk l hl trivial

    have hliftO₁_fac : ∀ (Z : Y.left.Etale)
        (hZ₁ : Set.range (yHom Z).base ⊆ Set.range O₁.ι.base),
        ((liftO₁ Z hZ₁).left :
          (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ (O₁ : AlgebraicGeometry.Scheme.{u})) ≫
          O₁.ι = yHom Z :=
      fun Z hZ₁ =>
        @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ O₁.ι (yHom Z) hOpen_O₁ hZ₁

    let x_el : CategoryTheory.Presieve.FamilyOfElements
        (Q_div.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R_cov.arrows :=
      fun Z _ _ =>
        if hZ₁ : Set.range (yHom Z).base ⊆ Set.range O₁.ι.base then
          (Q_div.obj.map (liftO₁ Z hZ₁).op).hom q₁_sec
        else 0

    have hx_O₂ : ∀ (Z : Y.left.Etale) (f : Z ⟶ T_X) (hf : R_cov.arrows f),
        Set.range (yHom Z).base ⊆ Set.range O₂.ι.base → x_el f hf = 0 := by
      intro Z f hf hZ₂
      dsimp only [x_el]
      split_ifs with hZ₁
      · have hZ₁₂ : Set.range (yHom Z).base ⊆ Set.range O₁₂.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hZ₁ hZ₂ ⊢
          exact Set.subset_inter hZ₁ hZ₂
        let l_μ : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ (O₁₂ : AlgebraicGeometry.Scheme.{u}) :=
          @AlgebraicGeometry.IsOpenImmersion.lift _ _ _ O₁₂.ι (yHom Z) hOpen_O₁₂ hZ₁₂
        have hl_μ : l_μ ≫ O₁₂.ι = yHom Z :=
          @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ O₁₂.ι (yHom Z) hOpen_O₁₂ hZ₁₂
        let μ : Z ⟶ U₁₂ := CategoryTheory.MorphismProperty.Over.homMk l_μ hl_μ trivial
        have hmu_lam : μ ≫ j₁₂_₁ = liftO₁ Z hZ₁ := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          apply (cancel_mono O₁.ι).mp
          have h_lhs : (l_μ ≫ Y.left.homOfLE inf_le_left) ≫ O₁.ι = yHom Z :=
            (CategoryTheory.Category.assoc l_μ (Y.left.homOfLE inf_le_left) O₁.ι).trans
              ((congrArg (l_μ ≫ ·) (Y.left.homOfLE_ι inf_le_left)).trans hl_μ)
          exact h_lhs.trans (hliftO₁_fac Z hZ₁).symm
        have hmap_eq : (Q_div.obj.map (liftO₁ Z hZ₁).op).hom q₁_sec =
            (Q_div.obj.map μ.op).hom ((Q_div.obj.map (Opposite.op j₁₂_₁)).hom q₁_sec) :=
          ConcreteCategory.congr_hom
            ((congrArg (fun k => Q_div.obj.map k.op) hmu_lam.symm).trans
              (Q_div.obj.map_comp (Opposite.op j₁₂_₁) μ.op)) q₁_sec
        exact hmap_eq.trans ((congrArg (Q_div.obj.map μ.op).hom hq₁_ov).trans (map_zero _))
      · rfl

    let C_sch : AlgebraicGeometry.Scheme.{u} := Y.left
    have hnot_O₁_imp_O₂ : ∀ (Z : C_sch.Etale) (f : Z ⟶ T_X) (hf : R_cov.arrows f),
        ¬ Set.range (yHom Z).base ⊆ Set.range O₁.ι.base →
          Set.range (yHom Z).base ⊆ Set.range O₂.ι.base := by
      intro Z f hf hnot₁
      rcases hf with ⟨W_arr, h_ZW, g_arr, hg_arr, h_eq⟩
      revert Z f hnot₁ h_ZW h_eq
      rcases hg_arr with ⟨b⟩
      rintro (Z : C_sch.Etale) (f : Z ⟶ T_X)
        (hnot₁ : ¬ Set.range (yHom Z).base ⊆ Set.range O₁.ι.base) h_ZW h_eq
      have hz_hom : yHom Z = (f.left : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C_sch) := by
        have hw : (f.left : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C_sch) ≫ 𝟙 C_sch =
            yHom Z := CategoryTheory.MorphismProperty.Over.w f
        exact hw.symm.trans (CategoryTheory.Category.comp_id _)
      cases b
      · have hf_left : (yHom Z : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C_sch) =
            (h_ZW.left : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ O₂) ≫ O₂.ι :=
          hz_hom.trans (congrArg (fun k : Z ⟶ T_X => k.left) h_eq.symm)
        rintro _ ⟨z, rfl⟩
        have hz_app : (yHom Z).base z = O₂.ι.base (h_ZW.left.base z) :=
          (congrArg (fun m : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C_sch => m.base z)
            hf_left).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply
              (h_ZW.left : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ O₂) O₂.ι z)
        exact ⟨h_ZW.left.base z, hz_app.symm⟩
      · exfalso
        apply hnot₁
        have hf_left : (yHom Z : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C_sch) =
            (h_ZW.left : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ O₁) ≫ O₁.ι :=
          hz_hom.trans (congrArg (fun k : Z ⟶ T_X => k.left) h_eq.symm)
        rintro _ ⟨z, rfl⟩
        have hz_app : (yHom Z).base z = O₁.ι.base (h_ZW.left.base z) :=
          (congrArg (fun m : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ C_sch => m.base z)
            hf_left).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply
              (h_ZW.left : (Z.left : AlgebraicGeometry.Scheme.{u}) ⟶ O₁) O₁.ι z)
        exact ⟨h_ZW.left.base z, hz_app.symm⟩

    have hx_pull : ∀ (Z₁ Z₂ : Y.left.Etale) (g : Z₂ ⟶ Z₁) (f : Z₁ ⟶ T_X) (hf : R_cov.arrows f),
        (Q_div.obj.map g.op).hom (x_el f hf) = x_el (g ≫ f) (R_cov.downward_closed hf g) := by
      intro Z₁ Z₂ g f hf
      let g_left : (Z₂.left : AlgebraicGeometry.Scheme.{u}) ⟶ Z₁.left := g.left
      have hgw : g_left ≫ yHom Z₁ = yHom Z₂ := CategoryTheory.MorphismProperty.Over.w g
      by_cases hZ₁ : Set.range (yHom Z₁).base ⊆ Set.range O₁.ι.base
      · have hZ₂ : Set.range (yHom Z₂).base ⊆ Set.range O₁.ι.base := by
          rintro _ ⟨z, rfl⟩
          have hz : (yHom Z₂).base z = (yHom Z₁).base (g_left.base z) :=
            (congrArg (fun m : (Z₂.left : AlgebraicGeometry.Scheme.{u}) ⟶ Y.left => m.base z)
              hgw.symm).trans (AlgebraicGeometry.Scheme.Hom.comp_apply g_left (yHom Z₁) z)
          exact hz ▸ hZ₁ ⟨g_left.base z, rfl⟩
        have hx₁ : x_el f hf = (Q_div.obj.map (liftO₁ Z₁ hZ₁).op).hom q₁_sec := by
          simp only [x_el, hZ₁, ↓reduceDIte]
        have hx₂ : x_el (g ≫ f) (R_cov.downward_closed hf g) =
            (Q_div.obj.map (liftO₁ Z₂ hZ₂).op).hom q₁_sec := by
          simp only [x_el, hZ₂, ↓reduceDIte]
        have hglam : g ≫ liftO₁ Z₁ hZ₁ = liftO₁ Z₂ hZ₂ := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          apply (cancel_mono O₁.ι).mp
          have h_lhs : (g_left ≫ ((liftO₁ Z₁ hZ₁).left :
              (Z₁.left : AlgebraicGeometry.Scheme.{u}) ⟶ O₁)) ≫ O₁.ι = yHom Z₂ :=
            (CategoryTheory.Category.assoc g_left _ O₁.ι).trans
              ((congrArg (g_left ≫ ·) (hliftO₁_fac Z₁ hZ₁)).trans hgw)
          exact h_lhs.trans (hliftO₁_fac Z₂ hZ₂).symm
        exact (congrArg (Q_div.obj.map g.op).hom hx₁).trans
          ((ConcreteCategory.congr_hom
            ((Q_div.obj.map_comp (liftO₁ Z₁ hZ₁).op g.op).symm.trans
              (congrArg (fun k => Q_div.obj.map k.op) hglam)) q₁_sec).trans hx₂.symm)
      · have hZ₁_O₂ : Set.range (yHom Z₁).base ⊆ Set.range O₂.ι.base :=
          hnot_O₁_imp_O₂ Z₁ f hf hZ₁
        have hZ₂_O₂ : Set.range (yHom Z₂).base ⊆ Set.range O₂.ι.base := by
          rintro _ ⟨z, rfl⟩
          have hz : (yHom Z₂).base z = (yHom Z₁).base (g_left.base z) :=
            (congrArg (fun m : (Z₂.left : AlgebraicGeometry.Scheme.{u}) ⟶ Y.left => m.base z)
              hgw.symm).trans (AlgebraicGeometry.Scheme.Hom.comp_apply g_left (yHom Z₁) z)
          exact hz ▸ hZ₁_O₂ ⟨g_left.base z, rfl⟩
        exact ((congrArg (Q_div.obj.map g.op).hom (hx_O₂ Z₁ f hf hZ₁_O₂)).trans (map_zero _)).trans
          (hx_O₂ Z₂ (g ≫ f) (R_cov.downward_closed hf g) hZ₂_O₂).symm

    have hx_compat : x_el.Compatible := by
      intro Y₁ Y₂ Z g₁' g₂' f₁ f₂ hf₁ hf₂ _
      exact (hx_pull Y₁ Z g₁' f₁ hf₁).trans (hx_pull Y₂ Z g₂' f₂ hf₂).symm

    let hShFor := hQ_type.isSheafFor R_cov hR_cov
    let q₀ : ↥(Q_div.obj.obj (Opposite.op T_X)) := hShFor.amalgamate x_el hx_compat
    have hq₀_1 : (Q_div.obj.map g₁.op).hom q₀ = q₁_sec := by
      have hv : (Q_div.obj.map g₁.op).hom q₀ =
          x_el g₁ (CategoryTheory.Sieve.ofArrows_mk Fam Arr true) :=
        hShFor.valid_glue hx_compat g₁ (CategoryTheory.Sieve.ofArrows_mk Fam Arr true)
      have hU₁_sub : Set.range (yHom U₁).base ⊆ Set.range O₁.ι.base := subset_rfl
      have hx₁ : x_el g₁ (CategoryTheory.Sieve.ofArrows_mk Fam Arr true) =
          (Q_div.obj.map (liftO₁ U₁ hU₁_sub).op).hom q₁_sec := by
        simp only [x_el, hU₁_sub, ↓reduceDIte]
      have hlam_id : liftO₁ U₁ hU₁_sub = 𝟙 U₁ := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
        apply (cancel_mono O₁.ι).mp
        exact (hliftO₁_fac U₁ hU₁_sub).trans (CategoryTheory.Category.id_comp O₁.ι).symm
      exact hv.trans (hx₁.trans
        (ConcreteCategory.congr_hom
          ((congrArg (fun k => Q_div.obj.map k.op) hlam_id).trans (Q_div.obj.map_id _)) q₁_sec))
    have hq₀_2 : (Q_div.obj.map g₂.op).hom q₀ = 0 := by
      have hv : (Q_div.obj.map g₂.op).hom q₀ =
          x_el g₂ (CategoryTheory.Sieve.ofArrows_mk Fam Arr false) :=
        hShFor.valid_glue hx_compat g₂ (CategoryTheory.Sieve.ofArrows_mk Fam Arr false)
      exact hv.trans (hx_O₂ U₂ g₂ (CategoryTheory.Sieve.ofArrows_mk Fam Arr false) subset_rfl)

    let adj_X := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_X
    let q_hom : Aℤ ⟶ Q_div.obj.obj (Opposite.op T_X) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • q₀
          map_zero' := zero_zsmul q₀
          map_add' := fun a b => add_zsmul q₀ a.down b.down }
    let f_q : Fℤ_Y ⟶ Q_div := (adj_X.homEquiv Aℤ Q_div).symm q_hom

    have hfq_eval : ∀ (V : Y.left.Etale) (v_hom : V ⟶ T_X),
        (f_q.hom.app (Opposite.op V)).hom (u₁_Fℤ V) = (Q_div.obj.map v_hom.op).hom q₀ := by
      intro V v_hom
      have hfq_TX : (f_q.hom.app (Opposite.op T_X)).hom (u₁_Fℤ T_X) = q₀ := by
        have h1 : (adj_X.homEquiv Aℤ Q_div) f_q = q_hom :=
          (adj_X.homEquiv Aℤ Q_div).apply_symm_apply q_hom
        have h2 : (adj_X.homEquiv Aℤ Q_div) f_q =
            adj_X.unit.app Aℤ ≫ f_q.hom.app (Opposite.op T_X) :=
          CategoryTheory.Adjunction.homEquiv_unit adj_X Aℤ Q_div f_q
        have hadj_u : adj_X.unit.app Aℤ = (shAdj_Y.unit.app Pℤ).app (Opposite.op T_X) :=
          CategoryTheory.Category.id_comp _
        have h3 := ConcreteCategory.congr_hom (h2.symm.trans h1) (ULift.up (1 : ℤ))
        rw [hadj_u] at h3
        change (f_q.hom.app (Opposite.op T_X)).hom (u₁_Fℤ T_X) = (1 : ℤ) • q₀ at h3
        rwa [one_zsmul] at h3
      have hu_nat : (Fℤ_Y.obj.map v_hom.op).hom (u₁_Fℤ T_X) = u₁_Fℤ V := by
        have h := ConcreteCategory.congr_hom
          ((shAdj_Y.unit.app Pℤ).naturality v_hom.op) (ULift.up (1 : ℤ))
        exact h.symm
      have hfq_nat := ConcreteCategory.congr_hom (f_q.hom.naturality v_hom.op) (u₁_Fℤ T_X)
      change (f_q.hom.app (Opposite.op V)).hom ((Fℤ_Y.obj.map v_hom.op).hom (u₁_Fℤ T_X)) =
        (Q_div.obj.map v_hom.op).hom ((f_q.hom.app (Opposite.op T_X)).hom (u₁_Fℤ T_X)) at hfq_nat
      rw [hu_nat, hfq_TX] at hfq_nat
      exact hfq_nat

    refine ⟨s₁, f_q, hs₁_ov, (hfq_eval U₁ g₁).trans hq₀_1, (hfq_eval U₂ g₂).trans hq₀_2, ?_⟩

    have hmk_fq : CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ f_q) = f_q := by
      apply (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ_Y Q_div).1
      exact CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply _
    have hfq_TX : (f_q.hom.app (Opposite.op T_X)).hom (u₁_C T_X) = q₀ := by
      have := hfq_eval T_X (𝟙 T_X)
      rwa [op_id, Q_div.obj.map_id, AddCommGrpCat.id_apply] at this
    have hev_fq : ev_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q) =
        (val_bar.hom.app (Opposite.op T_X)).hom q₀ := by
      change (val_bar.hom.app (Opposite.op T_X)).hom
        (((CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ f_q)).hom.app (Opposite.op T_X)).hom (u₁_C T_X)) = _
      rw [hmk_fq, hfq_TX]
    let d₀ : ↥(Div_sh.obj.obj (Opposite.op T_X)) := (val_bar.hom.app (Opposite.op T_X)).hom q₀
    have hd₀_g₁ : (Div_sh.obj.map g₁.op).hom d₀ = (val_pre.app (Opposite.op U₁)).hom s₁_pre := by
      have hnat := ConcreteCategory.congr_hom (val_bar.hom.naturality g₁.op) q₀
      change (val_bar.hom.app (Opposite.op U₁)).hom ((Q_div.obj.map g₁.op).hom q₀) =
        (Div_sh.obj.map g₁.op).hom d₀ at hnat
      rw [← hnat, hq₀_1]
      change ((π_div ≫ val_bar).hom.app (Opposite.op U₁)).hom s₁ = _
      rw [hπ_val]
      change ((shAdj.unit.app (weilEtaleKPresheaf Y.left) ≫ val_sh.hom).app (Opposite.op U₁)).hom
        s₁_pre = _
      rw [hunit_val]
    have hd₀_g₂ : (Div_sh.obj.map g₂.op).hom d₀ = 0 := by
      have hnat := ConcreteCategory.congr_hom (val_bar.hom.naturality g₂.op) q₀
      change (val_bar.hom.app (Opposite.op U₂)).hom ((Q_div.obj.map g₂.op).hom q₀) =
        (Div_sh.obj.map g₂.op).hom d₀ at hnat
      rw [← hnat, hq₀_2, map_zero]
    apply Finsupp.ext
    intro x
    have hlhs : (div_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q)) x = valDiv T_X d₀ x :=
      congrArg (fun e => valDiv T_X e x) hev_fq
    refine hlhs.trans ?_
    by_cases hx : x = ⟨y, hy⟩
    · subst hx
      let y₁ : { z : ↥U₁.left // IsClosed ({U₁.hom.base z} : Set ↥Y.left) } := ⟨⟨y, hy_mem⟩, hy⟩
      have hnat : valDiv U₁ ((Div_sh.obj.map g₁.op).hom d₀) y₁ = valDiv T_X d₀ ⟨y, hy⟩ :=
        hValNat g₁ d₀ y₁
      exact hnat.symm.trans
        ((congrArg (fun e => valDiv U₁ e y₁) hd₀_g₁).trans
          ((congrFun (hval_pre_spec U₁ s₁_pre) y₁).trans
            (hs₁_pre_val.trans
              (Finsupp.single_eq_same (a := (⟨y, hy⟩ : Pt_Y)) (b := (1 : ℤ))).symm)))
    · have hx_val : x.1 ≠ y := fun h => hx (Subtype.ext h)
      have hx₂ : x.1 ∈ O₂ := hx_val
      let y₂ : { z : ↥U₂.left // IsClosed ({U₂.hom.base z} : Set ↥Y.left) } := ⟨⟨x.1, hx₂⟩, x.2⟩
      have hnat : valDiv U₂ ((Div_sh.obj.map g₂.op).hom d₀) y₂ = valDiv T_X d₀ x :=
        hValNat g₂ d₀ y₂
      have hzero_y₂ : valDiv U₂ 0 y₂ = 0 :=
        congrFun (valDiv U₂).map_zero y₂
      exact hnat.symm.trans
        ((congrArg (fun e => valDiv U₂ e y₂) hd₀_g₂).trans
          (hzero_y₂.trans (Finsupp.single_eq_of_ne hx).symm))

theorem weil_gysin_p1_infinity_uniformizer_and_principal_point_diff (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (P1 : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsIntegral P1.left]
    [AlgebraicGeometry.IsProper P1.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 P1.hom]
    (ι_P1 : Quiver.Hom (weilGysinAffineSpace Ω 1) P1.left)
    [AlgebraicGeometry.IsOpenImmersion ι_P1]
    (s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) P1.left)
    (hι_P1_hom : CategoryTheory.CategoryStruct.comp ι_P1 P1.hom = weilGysinAffineStruct Ω 1)
    (hs_inf_hom : CategoryTheory.CategoryStruct.comp s_inf P1.hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hCompl_P1 : (Set.range ι_P1.base)ᶜ = Set.range s_inf.base) :
    ∃ (hq_inf : IsClosed ({s_inf.base ⟨⊥, Ideal.isPrime_bot⟩} : Set ↥P1.left))
      (V_inf : P1.left.Opens)
      (hq_inf_mem : s_inf.base ⟨⊥, Ideal.isPrime_bot⟩ ∈ V_inf)
      (g_inf : ↑(P1.left.presheaf.obj (Opposite.op V_inf)))
      (u_inf : Units ↑(P1.left.presheaf.obj (Opposite.op
        (V_inf ⊓ ⟨({s_inf.base ⟨⊥, Ideal.isPrime_bot⟩} : Set ↥P1.left)ᶜ, hq_inf.isOpen_compl⟩)))),
      (P1.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left :
          V_inf ⊓ ⟨({s_inf.base ⟨⊥, Ideal.isPrime_bot⟩} : Set ↥P1.left)ᶜ, hq_inf.isOpen_compl⟩ ≤
            V_inf)).op).hom g_inf =
        (u_inf : ↑(P1.left.presheaf.obj (Opposite.op
          (V_inf ⊓ ⟨({s_inf.base ⟨⊥, Ideal.isPrime_bot⟩} : Set ↥P1.left)ᶜ, hq_inf.isOpen_compl⟩)))) ∧
      Ideal.span {(P1.left.presheaf.germ V_inf (s_inf.base ⟨⊥, Ideal.isPrime_bot⟩) hq_inf_mem).hom g_inf} =
        IsLocalRing.maximalIdeal ↑(P1.left.presheaf.stalk (s_inf.base ⟨⊥, Ideal.isPrime_bot⟩)) ∧
      ∀ Q : { y : ↥P1.left // IsClosed ({y} : Set ↥P1.left) },
        Finsupp.single Q (1 : ℤ) -
          Finsupp.single ⟨s_inf.base ⟨⊥, Ideal.isPrime_bot⟩, hq_inf⟩ (1 : ℤ) ∈
          weilCurvePrincipalSubgroup P1.left :=
by
  classical
  let _ := hs_inf_hom

  
  have hPolyMaxLinear : ∀ (I : Ideal (Polynomial Ω)), I.IsMaximal →
      ∃ c : Ω, I = Ideal.span ({Polynomial.X - Polynomial.C c} : Set (Polynomial Ω)) := by
    intro I hI_max
    have hJX_ne_top : Ideal.span ({Polynomial.X} : Set (Polynomial Ω)) ≠ ⊤ :=
      fun htop => Polynomial.not_isUnit_X (Ideal.span_singleton_eq_top.mp htop)
    have hI_ne_bot : I ≠ ⊥ := by
      intro hbot
      have heq : (⊥ : Ideal (Polynomial Ω)) = Ideal.span ({Polynomial.X} : Set (Polynomial Ω)) :=
        (hbot ▸ hI_max).eq_of_le hJX_ne_top bot_le
      have hX_mem : (Polynomial.X : Polynomial Ω) ∈ (⊥ : Ideal (Polynomial Ω)) := by
        rw [heq]
        exact Ideal.subset_span (Set.mem_singleton _)
      exact Polynomial.X_ne_zero (Ideal.mem_bot.mp hX_mem)
    let P₀ : Polynomial Ω := Submodule.IsPrincipal.generator I
    have hP₀_span : Ideal.span ({P₀} : Set (Polynomial Ω)) = I :=
      Submodule.IsPrincipal.span_singleton_generator I
    have hP₀_ne : P₀ ≠ 0 := by
      intro h0
      apply hI_ne_bot
      rw [← hP₀_span, h0, Ideal.span_singleton_eq_bot]
    have hP₀_not_unit : ¬ IsUnit P₀ := by
      intro hu
      apply hI_max.ne_top
      rw [← hP₀_span]
      exact Ideal.span_singleton_eq_top.mpr hu
    have hP₀_deg_ne : P₀.degree ≠ 0 := by
      intro hdeg0
      have hP₀_C : P₀ = Polynomial.C (P₀.coeff 0) := Polynomial.eq_C_of_degree_eq_zero hdeg0
      have ha_ne : P₀.coeff 0 ≠ 0 := fun ha0 => hP₀_ne (by rw [hP₀_C, ha0, map_zero])
      rw [hP₀_C] at hP₀_not_unit
      exact hP₀_not_unit (RingHom.isUnit_map Polynomial.C (IsUnit.mk0 _ ha_ne))
    obtain ⟨c, hc_root⟩ := IsAlgClosed.exists_root P₀ hP₀_deg_ne
    have hdvd : Polynomial.X - Polynomial.C c ∣ P₀ := Polynomial.dvd_iff_isRoot.mpr hc_root
    have hP₀_mem : P₀ ∈ Ideal.span ({Polynomial.X - Polynomial.C c} : Set (Polynomial Ω)) :=
      Ideal.mem_span_singleton.mpr hdvd
    have hle_Xc : I ≤ Ideal.span ({Polynomial.X - Polynomial.C c} : Set (Polynomial Ω)) := by
      rw [← hP₀_span, Ideal.span_le, Set.singleton_subset_iff]
      exact hP₀_mem
    have hXc_ne_top :
        Ideal.span ({Polynomial.X - Polynomial.C c} : Set (Polynomial Ω)) ≠ ⊤ :=
      fun htop => (Polynomial.irreducible_X_sub_C c).not_isUnit
        (Ideal.span_singleton_eq_top.mp htop)
    exact ⟨c, hI_max.eq_of_le hXc_ne_top hle_Xc⟩

  
  have hEtaleStalkDVR : ∀ (A₀ R : Type u) [CommRing A₀] [IsDomain A₀]
      [CommRing R] [IsDomain R] [IsLocalRing R] [Algebra A₀ R]
      (m : Ideal A₀) [m.IsMaximal] [IsLocalization.AtPrime R m],
      m ≠ ⊥ → (∃ f₀ : Polynomial Ω →+* A₀, f₀.Etale) → IsDiscreteValuationRing R := by
    intro A₀ R _ _ _ _ _ _ m _ _ hm_ne_bot ⟨f₀, hf₀_et⟩
    let _ : Algebra (Polynomial Ω) A₀ := f₀.toAlgebra
    let _ : Algebra Ω A₀ := (f₀.comp Polynomial.C).toAlgebra
    have : IsScalarTower Ω (Polynomial Ω) A₀ := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale (Polynomial Ω) A₀ := hf₀_et.toAlgebra
    have : Algebra.FiniteType Ω A₀ :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType Ω (Polynomial Ω)) inferInstance
    have hNoethA₀ : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing Ω A₀
    have : IsNoetherianRing R := IsLocalization.isNoetherianRing m.primeCompl R hNoethA₀
    let L := A₀ ⧸ m
    let _ : Field L := Ideal.Quotient.field m
    have : Algebra.FiniteType Ω L :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω m)
        (Ideal.Quotient.mkₐ_surjective Ω m)
    obtain ⟨n_mv, ψ_mv, hψ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := Ω) (S := L)).mp inferInstance
    have hker_max : (RingHom.ker ψ_mv.toRingHom).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ψ_mv.toRingHom hψ_surj
    obtain ⟨v_pt, hv_ker⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hker_max
    obtain ⟨Q_x, hQ_x⟩ := hψ_surj (Ideal.Quotient.mk m (f₀ Polynomial.X))
    let c₀ : Ω := MvPolynomial.aeval v_pt Q_x
    have hc₀_mem : Q_x - MvPolynomial.C c₀ ∈ RingHom.ker ψ_mv.toRingHom := by
      rw [hv_ker, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      simp [c₀]
    have hc₀_eq : Ideal.Quotient.mk m (f₀ Polynomial.X) =
        Ideal.Quotient.mk m (f₀ (Polynomial.C c₀)) := by
      have h1 : ψ_mv Q_x - ψ_mv (MvPolynomial.C c₀) = 0 := by
        rw [← map_sub]
        exact hc₀_mem
      rw [← hQ_x, sub_eq_zero.mp h1]
      exact ψ_mv.commutes c₀
    let π_P : Polynomial Ω := Polynomial.X - Polynomial.C c₀
    let p₀ : Ideal (Polynomial Ω) := Ideal.comap f₀ m
    have hp₀_prime : p₀.IsPrime := Ideal.IsPrime.comap f₀
    have hπ_mem : π_P ∈ p₀ := by
      change f₀ (Polynomial.X - Polynomial.C c₀) ∈ m
      rw [map_sub, ← Ideal.Quotient.eq]
      exact hc₀_eq
    have hp₀_max : (Ideal.span ({π_P} : Set (Polynomial Ω))).IsMaximal :=
      PrincipalIdealRing.isMaximal_of_irreducible (Polynomial.irreducible_X_sub_C c₀)
    have hp₀_span : p₀ = Ideal.span ({π_P} : Set (Polynomial Ω)) :=
      (hp₀_max.eq_of_le hp₀_prime.ne_top
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_mem))).symm
    let R₀ := Localization.AtPrime p₀
    have hmax_R₀ : IsLocalRing.maximalIdeal R₀ =
        Ideal.span ({algebraMap (Polynomial Ω) R₀ π_P} : Set R₀) := by
      calc
        IsLocalRing.maximalIdeal R₀ = Ideal.map (algebraMap (Polynomial Ω) R₀) p₀ :=
          (IsLocalization.AtPrime.map_eq_maximalIdeal p₀ R₀).symm
        _ = Ideal.map (algebraMap (Polynomial Ω) R₀)
              (Ideal.span ({π_P} : Set (Polynomial Ω))) :=
          congrArg (Ideal.map (algebraMap (Polynomial Ω) R₀)) hp₀_span
        _ = Ideal.span ({algebraMap (Polynomial Ω) R₀ π_P} : Set R₀) := by
          rw [Ideal.map_span, Set.image_singleton]
    let _ : Algebra (Polynomial Ω) R := ((algebraMap A₀ R).comp f₀).toAlgebra
    have : IsScalarTower (Polynomial Ω) A₀ R := IsScalarTower.of_algebraMap_eq' rfl
    have hcomap_R :
        Ideal.comap (algebraMap (Polynomial Ω) R) (IsLocalRing.maximalIdeal R) = p₀ := by
      have hA : Ideal.comap (algebraMap A₀ R) (IsLocalRing.maximalIdeal R) = m :=
        IsLocalization.AtPrime.under_maximalIdeal R m
      change Ideal.comap ((algebraMap A₀ R).comp f₀) (IsLocalRing.maximalIdeal R) = p₀
      rw [← Ideal.comap_comap, hA]
    have hunit_P₀ : ∀ s : p₀.primeCompl, IsUnit (algebraMap (Polynomial Ω) R s.1) := by
      intro s
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hmem
      have hmem' :
          s.1 ∈ Ideal.comap (algebraMap (Polynomial Ω) R) (IsLocalRing.maximalIdeal R) := hmem
      rw [hcomap_R] at hmem'
      exact s.2 hmem'
    let ψ₀ : R₀ →+* R := IsLocalization.lift hunit_P₀
    let _ : Algebra R₀ R := ψ₀.toAlgebra
    have : IsScalarTower (Polynomial Ω) R₀ R :=
      IsScalarTower.of_algebraMap_eq'
        (RingHom.ext fun p => (IsLocalization.lift_eq hunit_P₀ p).symm)
    have : IsLocalHom (algebraMap R₀ R) :=
      ⟨fun z hz => by
        obtain ⟨⟨p, s⟩, hps⟩ := IsLocalization.surj p₀.primeCompl z
        have hmul_u : IsUnit (ψ₀ (z * algebraMap (Polynomial Ω) R₀ s.1)) := by
          rw [map_mul, IsLocalization.lift_eq hunit_P₀ s.1]
          exact hz.mul (hunit_P₀ s)
        rw [hps] at hmul_u
        change IsUnit (ψ₀ (algebraMap (Polynomial Ω) R₀ p)) at hmul_u
        rw [IsLocalization.lift_eq hunit_P₀ p] at hmul_u
        have hp_not : p ∉ p₀ := by
          intro hp_mem
          have hp_max : algebraMap (Polynomial Ω) R p ∈ IsLocalRing.maximalIdeal R := by
            change p ∈ Ideal.comap (algebraMap (Polynomial Ω) R) (IsLocalRing.maximalIdeal R)
            rw [hcomap_R]
            exact hp_mem
          exact (IsLocalRing.notMem_maximalIdeal.mpr hmul_u) hp_max
        have hp_u_R₀ : IsUnit (algebraMap (Polynomial Ω) R₀ p) :=
          IsLocalization.map_units R₀ (⟨p, hp_not⟩ : p₀.primeCompl)
        rw [← hps] at hp_u_R₀
        exact isUnit_of_mul_isUnit_left hp_u_R₀⟩
    have : Algebra.FormallyUnramified A₀ R :=
      Algebra.FormallyUnramified.of_isLocalization m.primeCompl
    have : Algebra.FormallyUnramified (Polynomial Ω) R :=
      Algebra.FormallyUnramified.comp (Polynomial Ω) A₀ R
    have : Algebra.FormallyUnramified R₀ R :=
      Algebra.FormallyUnramified.localization_base p₀.primeCompl
    have : Algebra.EssFiniteType (Polynomial Ω) A₀ :=
      Algebra.EssFiniteType.of_finiteType (Polynomial Ω) A₀
    have : Algebra.EssFiniteType A₀ R :=
      Algebra.EssFiniteType.of_isLocalization R m.primeCompl
    have : Algebra.EssFiniteType (Polynomial Ω) R :=
      Algebra.EssFiniteType.comp (Polynomial Ω) A₀ R
    have : Algebra.EssFiniteType R₀ R :=
      Algebra.EssFiniteType.of_comp (Polynomial Ω) R₀ R
    let π_R : R := algebraMap (Polynomial Ω) R π_P
    have hmax_R : IsLocalRing.maximalIdeal R = Ideal.span ({π_R} : Set R) := by
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R₀) (S := R), hmax_R₀,
        Ideal.map_span, Set.image_singleton]
      congr 1
      ext r
      simp only [Set.mem_singleton_iff]
      change r = ψ₀ (algebraMap (Polynomial Ω) R₀ π_P) ↔ r = π_R
      rw [IsLocalization.lift_eq hunit_P₀ π_P]
    have hle_nzd : m.primeCompl ≤ nonZeroDivisors A₀ := by
      intro s hs
      exact mem_nonZeroDivisors_iff_ne_zero.mpr (fun h0 => hs (h0 ▸ m.zero_mem))
    have hinj_A₀ : Function.Injective (algebraMap A₀ R) :=
      IsLocalization.injective R hle_nzd
    have hex_a₀ : ∃ a₀ ∈ m, a₀ ≠ 0 := by
      by_contra hall
      push Not at hall
      exact hm_ne_bot (eq_bot_iff.mpr fun a ha => Ideal.mem_bot.mpr (hall a ha))
    obtain ⟨a₀, ha₀_m, ha₀_ne⟩ := hex_a₀
    have hnf : ¬ IsField R := by
      intro hF
      have ha₀_mem : algebraMap A₀ R a₀ ∈ IsLocalRing.maximalIdeal R := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal m R]
        exact Ideal.mem_map_of_mem _ ha₀_m
      have ha₀_R_ne : algebraMap A₀ R a₀ ≠ 0 :=
        fun h0 => ha₀_ne (hinj_A₀ (h0.trans (map_zero _).symm))
      have hu : IsUnit (algebraMap A₀ R a₀) :=
        isUnit_iff_exists_inv.mpr (hF.mul_inv_cancel ha₀_R_ne)
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) ha₀_mem
    have hprin : Submodule.IsPrincipal (IsLocalRing.maximalIdeal R) := ⟨⟨π_R, hmax_R⟩⟩
    exact ((IsDiscreteValuationRing.TFAE R hnf).out 5 1).mp hprin

  
  have hUnif_pole_alg : ∀ (K R : Type u) [Field K] [CommRing R] [IsDomain R]
      [IsDiscreteValuationRing R] [Algebra R K] [IsFractionRing R K]
      (ψ : Polynomial Ω →+* K) (φ_Ω : Ω →+* R),
      Function.Injective ψ →
      (∀ z : K, ∃ P Q : Polynomial Ω, Q ≠ 0 ∧ z * ψ Q = ψ P) →
      (∀ a : Ω, algebraMap R K (φ_Ω a) = ψ (Polynomial.C a)) →
      ∀ c : Ω,
        (¬ ∃ r : R, algebraMap R K r = ψ (Polynomial.X - Polynomial.C c)) →
        ψ (Polynomial.X - Polynomial.C c) ≠ 0 ∧
        ∃ s_c : R, s_c ≠ 0 ∧
          algebraMap R K s_c * ψ (Polynomial.X - Polynomial.C c) = 1 ∧
          Ideal.span ({s_c} : Set R) = IsLocalRing.maximalIdeal R := by
    intro K R _ _ _ _ _ _ ψ φ_Ω hInj_ψ hFrac hConst_eq c hPole_c
    let t_c : K := ψ (Polynomial.X - Polynomial.C c)
    have ht_c_ne : t_c ≠ 0 :=
      (map_ne_zero_iff ψ hInj_ψ).mpr (Polynomial.X_sub_C_ne_zero c)
    refine ⟨ht_c_ne, ?_⟩
    let _ : ValuationRing R := of_isDiscreteValuationRing R
    rcases ValuationRing.isInteger_or_isInteger R t_c with ⟨r, hr⟩ | ⟨s_c, hs_c⟩
    · exact absurd ⟨r, hr⟩ hPole_c
    · have hs_c_inv : algebraMap R K s_c * t_c = 1 := by
        rw [hs_c]
        exact inv_mul_cancel₀ ht_c_ne
      have hs_c_ne : s_c ≠ 0 := by
        intro h0
        rw [h0, map_zero, zero_mul] at hs_c_inv
        exact zero_ne_one hs_c_inv
      have hs_c_max : s_c ∈ IsLocalRing.maximalIdeal R := by
        by_contra hnot
        obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp hnot
        apply hPole_c
        refine ⟨↑u⁻¹, ?_⟩
        have hmul : algebraMap R K (↑u : R) * algebraMap R K (↑u⁻¹ : R) = 1 := by
          rw [← map_mul, Units.mul_inv, map_one]
        have hu_eq : algebraMap R K (↑u : R) = t_c⁻¹ := by
          rw [hu]
          exact hs_c
        rw [hu_eq] at hmul
        exact mul_left_cancel₀ (inv_ne_zero ht_c_ne) (hmul.trans (inv_mul_cancel₀ ht_c_ne).symm)
      have hRevUnit : ∀ P : Polynomial Ω, P ≠ 0 →
          ∃ (d_P : ℕ) (u_P : R), IsUnit u_P ∧
            (algebraMap R K s_c) ^ d_P * ψ P = algebraMap R K u_P := by
        intro P hP_ne
        let P₁ : Polynomial Ω := P.comp (Polynomial.X + Polynomial.C c)
        have hP₁_comp : P₁.comp (Polynomial.X - Polynomial.C c) = P := by
          dsimp [P₁]
          rw [Polynomial.comp_assoc]
          have hX : (Polynomial.X + Polynomial.C c).comp (Polynomial.X - Polynomial.C c) =
              Polynomial.X := by simp
          rw [hX, Polynomial.comp_X]
        have hP₁_ne : P₁ ≠ 0 := by
          intro h0
          apply hP_ne
          rw [← hP₁_comp, h0, Polynomial.zero_comp]
        let d_P : ℕ := P₁.natDegree
        let u_P : R :=
          ∑ i ∈ Finset.range (d_P + 1), φ_Ω (P₁.coeff i) * s_c ^ (d_P - i)
        have hu_P_unit : IsUnit u_P := by
          apply IsLocalRing.notMem_maximalIdeal.mp
          intro hu_mem
          have hu_split : u_P =
              (∑ i ∈ Finset.range d_P, φ_Ω (P₁.coeff i) * s_c ^ (d_P - i)) +
                φ_Ω P₁.leadingCoeff := by
            dsimp [u_P]
            rw [Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one]
            rfl
          have hsum_mem :
              (∑ i ∈ Finset.range d_P, φ_Ω (P₁.coeff i) * s_c ^ (d_P - i)) ∈
                IsLocalRing.maximalIdeal R := by
            apply Ideal.sum_mem
            intro i hi
            have hi_lt : i < d_P := Finset.mem_range.mp hi
            have hsub_pos : d_P - i = (d_P - 1 - i) + 1 := by omega
            rw [hsub_pos, pow_succ]
            exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hs_c_max)
          have hlead_mem : φ_Ω P₁.leadingCoeff ∈ IsLocalRing.maximalIdeal R := by
            have hdiff := (IsLocalRing.maximalIdeal R).sub_mem hu_mem hsum_mem
            rwa [hu_split, add_sub_cancel_left] at hdiff
          have hlead_ne : P₁.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hP₁_ne
          have hlead_unit : IsUnit (φ_Ω P₁.leadingCoeff) :=
            RingHom.isUnit_map φ_Ω (IsUnit.mk0 _ hlead_ne)
          exact (IsLocalRing.notMem_maximalIdeal.mpr hlead_unit) hlead_mem
        refine ⟨d_P, u_P, hu_P_unit, ?_⟩
        have hP_sum : P = ∑ i ∈ Finset.range (d_P + 1),
            Polynomial.C (P₁.coeff i) * (Polynomial.X - Polynomial.C c) ^ i := by
          rw [← hP₁_comp]
          conv_lhs => rw [Polynomial.as_sum_range P₁]
          change (Polynomial.eval₂RingHom Polynomial.C (Polynomial.X - Polynomial.C c))
            (∑ i ∈ Finset.range (d_P + 1), Polynomial.monomial i (P₁.coeff i)) = _
          rw [map_sum]
          apply Finset.sum_congr rfl
          intro i _
          rw [← Polynomial.C_mul_X_pow_eq_monomial]
          simp
        conv_lhs => rw [hP_sum]
        rw [map_sum, Finset.mul_sum]
        dsimp [u_P]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro i hi
        have hi_le : i ≤ d_P := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [map_mul, map_pow, ← hConst_eq (P₁.coeff i), map_mul, map_pow]
        change (algebraMap R K s_c) ^ d_P * (algebraMap R K (φ_Ω (P₁.coeff i)) * t_c ^ i) =
          algebraMap R K (φ_Ω (P₁.coeff i)) * (algebraMap R K s_c) ^ (d_P - i)
        have hd_eq : d_P = (d_P - i) + i := (Nat.sub_add_cancel hi_le).symm
        calc
          (algebraMap R K s_c) ^ d_P * (algebraMap R K (φ_Ω (P₁.coeff i)) * t_c ^ i) =
              algebraMap R K (φ_Ω (P₁.coeff i)) *
                (((algebraMap R K s_c) ^ (d_P - i) * (algebraMap R K s_c) ^ i) * t_c ^ i) := by
            conv_lhs => rw [hd_eq, pow_add]
            ring
          _ = algebraMap R K (φ_Ω (P₁.coeff i)) *
                ((algebraMap R K s_c) ^ (d_P - i) * (algebraMap R K s_c * t_c) ^ i) := by
            rw [mul_assoc ((algebraMap R K s_c) ^ (d_P - i)), ← mul_pow]
          _ = algebraMap R K (φ_Ω (P₁.coeff i)) * (algebraMap R K s_c) ^ (d_P - i) := by
            rw [hs_c_inv, one_pow, mul_one]
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
      obtain ⟨P, Q, hQ_ne, hϖ_frac⟩ := hFrac (algebraMap R K ϖ)
      have hψQ_ne : ψ Q ≠ 0 := (map_ne_zero_iff ψ hInj_ψ).mpr hQ_ne
      have hϖK_ne : algebraMap R K ϖ ≠ 0 :=
        fun h0 => hϖ.ne_zero (IsFractionRing.injective R K (h0.trans (map_zero _).symm))
      have hP_ne : P ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hϖ_frac
        exact mul_ne_zero hϖK_ne hψQ_ne hϖ_frac
      obtain ⟨d_P, u_P, hu_P, hclear_P⟩ := hRevUnit P hP_ne
      obtain ⟨d_Q, u_Q, hu_Q, hclear_Q⟩ := hRevUnit Q hQ_ne
      have hR_eq : ϖ * s_c ^ d_P * u_Q = s_c ^ d_Q * u_P := by
        apply IsFractionRing.injective R K
        simp only [map_mul, map_pow]
        calc
          algebraMap R K ϖ * (algebraMap R K s_c) ^ d_P * algebraMap R K u_Q =
              (algebraMap R K s_c) ^ d_P *
                (algebraMap R K ϖ * ((algebraMap R K s_c) ^ d_Q * ψ Q)) := by
            rw [← hclear_Q]; ring
          _ = (algebraMap R K s_c) ^ d_Q *
                ((algebraMap R K s_c) ^ d_P * (algebraMap R K ϖ * ψ Q)) := by ring
          _ = (algebraMap R K s_c) ^ d_Q * ((algebraMap R K s_c) ^ d_P * ψ P) := by
            rw [hϖ_frac]
          _ = (algebraMap R K s_c) ^ d_Q * algebraMap R K u_P := by rw [hclear_P]
      obtain ⟨m, hm_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible hs_c_ne hϖ
      obtain ⟨v_inv, hv_inv_eq⟩ := hm_assoc
      let v : Units R := v_inv⁻¹
      have hv_eq : ϖ ^ m * (v : R) = s_c := by
        dsimp [v]
        rw [← hv_inv_eq, mul_assoc, Units.mul_inv, mul_one]
      have hm_ne_zero : m ≠ 0 := by
        intro hm0
        rw [hm0, pow_zero, one_mul] at hv_eq
        have hu_sc : IsUnit s_c := hv_eq ▸ v.isUnit
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu_sc) hs_c_max
      have hpow_eq : ϖ ^ (1 + m * d_P) * ((v : R) ^ d_P * u_Q) =
          ϖ ^ (m * d_Q) * ((v : R) ^ d_Q * u_P) := by
        calc
          ϖ ^ (1 + m * d_P) * ((v : R) ^ d_P * u_Q) =
              ϖ * (ϖ ^ m * (v : R)) ^ d_P * u_Q := by
            rw [pow_add, pow_one, mul_pow, ← pow_mul]; ring
          _ = ϖ * s_c ^ d_P * u_Q := by rw [hv_eq]
          _ = s_c ^ d_Q * u_P := hR_eq
          _ = (ϖ ^ m * (v : R)) ^ d_Q * u_P := by rw [← hv_eq]
          _ = ϖ ^ (m * d_Q) * ((v : R) ^ d_Q * u_P) := by
            rw [mul_pow, ← pow_mul]; ring
      let w₁ : R := (v : R) ^ d_P * u_Q
      let w₂ : R := (v : R) ^ d_Q * u_P
      have hw₁_u : IsUnit w₁ := (v.isUnit.pow d_P).mul hu_Q
      have hw₂_u : IsUnit w₂ := (v.isUnit.pow d_Q).mul hu_P
      have hexp_eq : 1 + m * d_P = m * d_Q := by
        rcases lt_trichotomy (1 + m * d_P) (m * d_Q) with hlt | heq | hgt
        · exfalso
          have hb : m * d_Q = (1 + m * d_P) + (1 + (m * d_Q - (1 + m * d_P) - 1)) := by omega
          have h1 : ϖ ^ (1 + m * d_P) * w₁ =
              ϖ ^ (1 + m * d_P) * (ϖ * (ϖ ^ (m * d_Q - (1 + m * d_P) - 1) * w₂)) := by
            calc
              ϖ ^ (1 + m * d_P) * w₁ = ϖ ^ (m * d_Q) * w₂ := hpow_eq
              _ = ϖ ^ ((1 + m * d_P) + (1 + (m * d_Q - (1 + m * d_P) - 1))) * w₂ := by rw [← hb]
              _ = ϖ ^ (1 + m * d_P) * (ϖ * (ϖ ^ (m * d_Q - (1 + m * d_P) - 1) * w₂)) := by
                rw [pow_add, pow_add, pow_one]; ring
          have hw₁_dvd : ϖ ∣ w₁ :=
            ⟨ϖ ^ (m * d_Q - (1 + m * d_P) - 1) * w₂,
              mul_left_cancel₀ (pow_ne_zero _ hϖ.ne_zero) h1⟩
          exact hϖ.not_isUnit (isUnit_of_dvd_unit hw₁_dvd hw₁_u)
        · exact heq
        · exfalso
          have ha : 1 + m * d_P = (m * d_Q) + (1 + ((1 + m * d_P) - m * d_Q - 1)) := by omega
          have h1 : ϖ ^ (m * d_Q) * w₂ =
              ϖ ^ (m * d_Q) * (ϖ * (ϖ ^ ((1 + m * d_P) - m * d_Q - 1) * w₁)) := by
            calc
              ϖ ^ (m * d_Q) * w₂ = ϖ ^ (1 + m * d_P) * w₁ := hpow_eq.symm
              _ = ϖ ^ ((m * d_Q) + (1 + ((1 + m * d_P) - m * d_Q - 1))) * w₁ := by rw [← ha]
              _ = ϖ ^ (m * d_Q) * (ϖ * (ϖ ^ ((1 + m * d_P) - m * d_Q - 1) * w₁)) := by
                rw [pow_add, pow_add, pow_one]; ring
          have hw₂_dvd : ϖ ∣ w₂ :=
            ⟨ϖ ^ ((1 + m * d_P) - m * d_Q - 1) * w₁,
              mul_left_cancel₀ (pow_ne_zero _ hϖ.ne_zero) h1⟩
          exact hϖ.not_isUnit (isUnit_of_dvd_unit hw₂_dvd hw₂_u)
      have hm_dvd_one : m ∣ 1 := by
        have hd_le : d_P ≤ d_Q := by
          by_contra hnot
          have hgt : d_Q < d_P := Nat.lt_of_not_ge hnot
          have hmul_lt : m * d_Q < m * d_P :=
            Nat.mul_lt_mul_of_pos_left hgt (Nat.pos_of_ne_zero hm_ne_zero)
          omega
        refine ⟨d_Q - d_P, ?_⟩
        rw [Nat.mul_sub_left_distrib]
        omega
      have hm_one : m = 1 := Nat.eq_one_of_dvd_one hm_dvd_one
      rw [hm_one, pow_one] at hv_inv_eq
      have hassoc_sc : Associated s_c ϖ := ⟨v_inv, hv_inv_eq⟩
      refine ⟨s_c, hs_c_ne, hs_c_inv, ?_⟩
      rw [Ideal.span_singleton_eq_span_singleton.mpr hassoc_sc, ← hϖ.maximalIdeal_eq]

  
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let p_Ω0 : ↥S_Ω := ⟨⊥, Ideal.isPrime_bot⟩
  let q_inf : ↥P1.left := s_inf.base p_Ω0
  have hSub_SΩ : ∀ p : ↥S_Ω, p = p_Ω0 := by
    intro p
    apply PrimeSpectrum.ext
    rw [eq_bot_iff]
    intro a ha
    rw [Ideal.mem_bot]
    by_contra ha0
    exact p.2.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal ha (IsUnit.mk0 a ha0))

  
  let M_ring := CommRingCat.of (MvPolynomial (Fin 1) Ω)
  let ι_aff : AlgebraicGeometry.Spec M_ring ⟶ P1.left := ι_P1
  have : AlgebraicGeometry.IsOpenImmersion ι_aff := ‹AlgebraicGeometry.IsOpenImmersion ι_P1›
  have hRange_sinf : Set.range s_inf.base = ({q_inf} : Set ↥P1.left) := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨by rintro ⟨p, rfl⟩; rw [hSub_SΩ p], by rintro rfl; exact ⟨p_Ω0, rfl⟩⟩
  have hCompl_eq : (Set.range ι_aff.base)ᶜ = ({q_inf} : Set ↥P1.left) :=
    hCompl_P1.trans hRange_sinf
  have hRange_ι : Set.range ι_aff.base = ({q_inf} : Set ↥P1.left)ᶜ := by
    rw [← hCompl_eq, compl_compl]
  have hq_inf : IsClosed ({q_inf} : Set ↥P1.left) := by
    rw [← hCompl_eq]
    exact ι_aff.isOpenEmbedding.isOpen_range.isClosed_compl
  let U_aff : P1.left.Opens := ι_aff.opensRange
  have hU_coe : (U_aff : Set ↥P1.left) = ({q_inf} : Set ↥P1.left)ᶜ := hRange_ι
  have hAff_U : AlgebraicGeometry.IsAffineOpen U_aff :=
    AlgebraicGeometry.isAffineOpen_opensRange ι_aff
  let p_A1_0 : ↥(AlgebraicGeometry.Spec M_ring) := ⟨⊥, Ideal.isPrime_bot⟩
  have hNe_U : Nonempty ↥(U_aff : TopologicalSpace.Opens ↥P1.left) :=
    ⟨⟨ι_aff.base p_A1_0, ⟨p_A1_0, rfl⟩⟩⟩
  have : Nonempty ↥(U_aff : AlgebraicGeometry.Scheme.{u}) := hNe_U
  have : IrreducibleSpace ↥P1.left :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral P1.left
  have hη_U : genericPoint ↥P1.left ∈ U_aff :=
    (genericPoint_specializes hNe_U.some.1).mem_open U_aff.isOpen hNe_U.some.2

  
  let e_mv : Polynomial Ω ≃+* MvPolynomial (Fin 1) Ω :=
    { toFun := Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
      invFun := MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X)
      left_inv := fun p => by
        change ((MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X)).comp
          (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0))) p = RingHom.id _ p
        congr 1
        apply Polynomial.ringHom_ext'
        · ext a; simp
        · simp
      right_inv := fun q => by
        change ((Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)).comp
          (MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X))) q = RingHom.id _ q
        congr 1
        apply MvPolynomial.ringHom_ext'
        · ext a; simp
        · intro i
          fin_cases i
          simp
      map_mul' := map_mul _
      map_add' := map_add _ }
  let iso_range_top :
      (AlgebraicGeometry.Spec M_ring).presheaf.obj (Opposite.op ⊤) ≅
        U_aff.toScheme.presheaf.obj (Opposite.op ⊤) :=
    { hom := ι_aff.isoOpensRange.inv.appTop
      inv := ι_aff.isoOpensRange.hom.appTop
      hom_inv_id := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Iso.hom_inv_id,
          AlgebraicGeometry.Scheme.Hom.id_appTop]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Iso.inv_hom_id,
          AlgebraicGeometry.Scheme.Hom.id_appTop] }
  let iso_MB : M_ring ≅ P1.left.presheaf.obj (Opposite.op U_aff) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso M_ring).symm ≪≫ iso_range_top ≪≫ U_aff.topIso
  let e_MB : MvPolynomial (Fin 1) Ω ≃+* ↑(P1.left.presheaf.obj (Opposite.op U_aff)) :=
    iso_MB.commRingCatIsoToRingEquiv
  let e_poly : Polynomial Ω ≃+* ↑(P1.left.presheaf.obj (Opposite.op U_aff)) :=
    e_mv.trans e_MB

  have happLE_congr : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : Z₁ ⟶ Z₂} (hf : f₁ = f₂)
      (U : Z₂.Opens) (V : Z₁.Opens)
      (e₁ : V ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (e₂ : V ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      f₁.appLE U V e₁ = f₂.appLE U V e₂ := by
    intro Z₁ Z₂ f₁ f₂ hf U V e₁ e₂
    subst hf
    rfl

  have h_le_top : (⊤ : (AlgebraicGeometry.Spec M_ring).Opens) ≤
      (TopologicalSpace.Opens.map ι_aff.base).obj U_aff :=
    fun x _ => ⟨x, rfl⟩

  have hiso_MB_inv : iso_MB.inv =
      ι_aff.appLE U_aff ⊤ h_le_top ≫ (AlgebraicGeometry.Scheme.ΓSpecIso M_ring).hom := by
    have htop_inv : U_aff.topIso.inv = U_aff.ι.appLE U_aff ⊤ (fun z _ => z.2) :=
      (AlgebraicGeometry.Scheme.Opens.topIso_inv U_aff).trans
        ((congrArg P1.left.presheaf.map (Subsingleton.elim _ _)).trans
          (P1.left.presheaf.map_comp _ _))
    have hcomp_app : U_aff.topIso.inv ≫ ι_aff.isoOpensRange.hom.appTop =
        ι_aff.appLE U_aff ⊤ h_le_top := by
      have h1 := (congrArg₂ CategoryStruct.comp htop_inv
        (AlgebraicGeometry.Scheme.Hom.app_eq_appLE ι_aff.isoOpensRange.hom)).trans
        (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_aff.isoOpensRange.hom U_aff.ι
          U_aff ⊤ ⊤ (fun z _ => z.2) le_rfl)
      exact h1.trans (happLE_congr (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_aff)
        U_aff ⊤ _ h_le_top)
    change U_aff.topIso.inv ≫ (ι_aff.isoOpensRange.hom.appTop ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso M_ring).hom) = _
    rw [← Category.assoc, hcomp_app]

  have hSpec_iso_MB :
      AlgebraicGeometry.Spec.map iso_MB.hom ≫ ι_aff = hAff_U.fromSpec := by
    have hSpec_top : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso M_ring).hom ≫
        (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec M_ring)).fromSpec =
        𝟙 (AlgebraicGeometry.Spec M_ring) := by
      rw [← AlgebraicGeometry.Scheme.isoSpec_Spec_hom M_ring,
        AlgebraicGeometry.IsAffineOpen.fromSpec_top, Iso.hom_inv_id]
    have hSpec_inv : AlgebraicGeometry.Spec.map iso_MB.inv ≫ hAff_U.fromSpec = ι_aff := by
      rw [hiso_MB_inv, AlgebraicGeometry.Spec.map_comp, Category.assoc,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι_aff hAff_U
          (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec M_ring)) h_le_top,
        ← Category.assoc, hSpec_top, Category.id_comp]
    rw [← hSpec_inv, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id, Category.id_comp]

  
  let g_U := P1.left.germToFunctionField U_aff
  let ψ : Polynomial Ω →+* ↑P1.left.functionField := g_U.hom.comp e_poly.toRingHom
  have hInj_ψ : Function.Injective ψ :=
    (AlgebraicGeometry.Scheme.germToFunctionField_injective P1.left U_aff).comp e_poly.injective

  have hFrac : ∀ z : ↑P1.left.functionField, ∃ P Q : Polynomial Ω, Q ≠ 0 ∧ z * ψ Q = ψ P := by
    intro z
    have : IsDomain ↑(P1.left.presheaf.obj (Opposite.op U_aff)) :=
      @AlgebraicGeometry.IsIntegral.component_integral P1.left _ U_aff hNe_U
    have : IsFractionRing ↑(P1.left.presheaf.obj (Opposite.op U_aff)) ↑P1.left.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen P1.left U_aff hAff_U
    obtain ⟨⟨b, s⟩, hbs⟩ :=
      IsLocalization.surj (nonZeroDivisors ↑(P1.left.presheaf.obj (Opposite.op U_aff))) z
    have hs_ne : (s : ↑(P1.left.presheaf.obj (Opposite.op U_aff))) ≠ 0 :=
      nonZeroDivisors.ne_zero s.2
    refine ⟨e_poly.symm b, e_poly.symm s, ?_, ?_⟩
    · intro h0
      exact hs_ne (e_poly.symm.injective (h0.trans (map_zero _).symm))
    · dsimp [ψ]
      rw [e_poly.apply_symm_apply, e_poly.apply_symm_apply]
      exact hbs

  let γ_0 : CommRingCat.of Ω ⟶ P1.left.presheaf.obj (Opposite.op ⊤) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ P1.hom.appTop
  have hq_top : q_inf ∈ (⊤ : P1.left.Opens) := Set.mem_univ q_inf
  let φ_Ω : Ω →+* ↑(P1.left.presheaf.stalk q_inf) :=
    (γ_0 ≫ P1.left.presheaf.germ ⊤ q_inf hq_top).hom

  have hγ_res : ∀ a : Ω,
      (P1.left.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op).hom (γ_0.hom a) =
        e_poly (Polynomial.C a) := by
    intro a
    apply e_MB.symm.injective
    change iso_MB.inv.hom
      ((P1.left.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op).hom (γ_0.hom a)) =
      e_MB.symm (e_MB (e_mv (Polynomial.C a)))
    rw [e_MB.symm_apply_apply]
    have hev : e_mv (Polynomial.C a) = MvPolynomial.C a := by simp [e_mv]
    rw [hev]
    have hres_app : P1.hom.appTop ≫
        P1.left.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
        ι_aff.appLE U_aff ⊤ h_le_top = (ι_aff ≫ P1.hom).appTop := by
      have h1 : P1.hom.appTop ≫
          P1.left.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op =
          P1.hom.appLE ⊤ U_aff (fun _ _ => trivial) :=
        (congrArg (· ≫ _) (AlgebraicGeometry.Scheme.Hom.app_eq_appLE P1.hom)).trans
          (AlgebraicGeometry.Scheme.Hom.appLE_map P1.hom _ _)
      rw [← Category.assoc, h1]
      exact (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_aff P1.hom ⊤ U_aff ⊤
        (fun _ _ => trivial) h_le_top).trans
        (AlgebraicGeometry.Scheme.Hom.app_eq_appLE (ι_aff ≫ P1.hom)).symm
    have hmor : γ_0 ≫ P1.left.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
        iso_MB.inv = CommRingCat.ofHom MvPolynomial.C := by
      calc
        γ_0 ≫ P1.left.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
            iso_MB.inv =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              (P1.hom.appTop ≫
                P1.left.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
                ι_aff.appLE U_aff ⊤ h_le_top) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso M_ring).hom := by
          dsimp [γ_0]
          rw [hiso_MB_inv]
          simp only [Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)).appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso M_ring).hom := by
          have hι_aff_hom : ι_aff ≫ P1.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := hι_P1_hom
          rw [hres_app, hι_aff_hom]
        _ = CommRingCat.ofHom MvPolynomial.C := by
          rw [← Category.assoc,
            ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom MvPolynomial.C),
            Category.assoc, Iso.inv_hom_id, Category.comp_id]
    exact congrArg (fun f : CommRingCat.of Ω ⟶ M_ring => f.hom a) hmor

  have hConst_eq : ∀ a : Ω,
      algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField (φ_Ω a) =
        ψ (Polynomial.C a) := by
    intro a
    have hsp := genericPoint_specializes q_inf
    have halg_inf :
        algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField (φ_Ω a) =
          (P1.left.presheaf.stalkSpecializes hsp).hom
            ((P1.left.presheaf.germ ⊤ q_inf hq_top).hom (γ_0.hom a)) := rfl
    rw [halg_inf, TopCat.Presheaf.germ_stalkSpecializes_apply]
    have hres := TopCat.Presheaf.germ_res_apply P1.left.presheaf
      (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤))
      (genericPoint ↥P1.left) hη_U (γ_0.hom a)
    dsimp [ψ, g_U, AlgebraicGeometry.Scheme.germToFunctionField]
    rw [← hγ_res a]
    exact hres.symm

  have hSep_P1 : P1.left.IsSeparated := by
    have : AlgebraicGeometry.IsSeparated P1.hom := AlgebraicGeometry.IsProper.toIsSeparated
    have hterm : Limits.terminal.from P1.left = P1.hom ≫ Limits.terminal.from S_Ω :=
      Limits.terminal.hom_ext _ _
    have : AlgebraicGeometry.IsSeparated (Limits.terminal.from P1.left) := by
      rw [hterm]
      exact MorphismProperty.comp_mem _ P1.hom (Limits.terminal.from S_Ω)
        inferInstance inferInstance
    exact AlgebraicGeometry.Scheme.IsSeparated.mk inferInstance

  have hPole : ∀ c : Ω,
      ¬ ∃ r : ↑(P1.left.presheaf.stalk q_inf),
        algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField r =
          ψ (Polynomial.X - Polynomial.C c) := by
    intro c ⟨r, hr⟩
    have : P1.left.IsSeparated := hSep_P1
    let α : MvPolynomial (Fin 1) Ω →+* ↑(P1.left.presheaf.stalk q_inf) :=
      MvPolynomial.eval₂Hom φ_Ω (fun _ => r + φ_Ω c)
    let α_mor : M_ring ⟶ P1.left.presheaf.stalk q_inf := CommRingCat.ofHom α
    let σ_inf : P1.left.presheaf.stalk q_inf ⟶ P1.left.functionField :=
      P1.left.presheaf.stalkSpecializes (genericPoint_specializes q_inf)
    have hα_comp : α_mor ≫ σ_inf = iso_MB.hom ≫ g_U := by
      apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext'
      · ext a
        change algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField
          (α (MvPolynomial.C a)) = g_U.hom (e_MB (MvPolynomial.C a))
        have h1 : α (MvPolynomial.C a) = φ_Ω a := by simp [α]
        have h2 : e_MB (MvPolynomial.C a) = e_poly (Polynomial.C a) := by simp [e_poly, e_mv]
        rw [h1, h2, hConst_eq a]
        rfl
      · intro i
        fin_cases i
        change algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField
          (α (MvPolynomial.X 0)) = g_U.hom (e_MB (MvPolynomial.X 0))
        have h1 : α (MvPolynomial.X 0) = r + φ_Ω c := by simp [α]
        have h2 : e_MB (MvPolynomial.X 0) = e_poly Polynomial.X := by simp [e_poly, e_mv]
        rw [h1, h2, map_add, hr, hConst_eq c, ← map_add, sub_add_cancel]
        rfl
    let η_dom : AlgebraicGeometry.Spec P1.left.functionField ⟶
        AlgebraicGeometry.Spec (P1.left.presheaf.stalk q_inf) :=
      AlgebraicGeometry.Spec.map σ_inf
    have : AlgebraicGeometry.IsDominant η_dom := by
      apply AlgebraicGeometry.IsDominant.mk
      intro q
      let p_K : ↥(AlgebraicGeometry.Spec P1.left.functionField) := ⟨⊥, Ideal.isPrime_bot⟩
      have hp_img : η_dom.base p_K ∈ Set.range ⇑η_dom := ⟨p_K, rfl⟩
      let q_sp : PrimeSpectrum ↑(P1.left.presheaf.stalk q_inf) := q
      let p_sp : PrimeSpectrum ↑(P1.left.presheaf.stalk q_inf) := η_dom.base p_K
      have hker : p_sp.asIdeal = ⊥ := by
        change Ideal.comap
          (algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField) ⊥ = ⊥
        rw [eq_bot_iff]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_bot] at hx
        rw [Ideal.mem_bot]
        exact IsFractionRing.injective
          ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField
          (hx.trans (map_zero _).symm)
      have hmem_cl : q_sp ∈ closure ({p_sp} : Set (PrimeSpectrum ↑(P1.left.presheaf.stalk q_inf))) := by
        rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus, hker]
        intro x hx
        rw [Ideal.mem_bot.mp hx]
        exact q_sp.asIdeal.zero_mem
      exact closure_mono (Set.singleton_subset_iff.mpr hp_img) hmem_cl
    let f₁ : AlgebraicGeometry.Spec (P1.left.presheaf.stalk q_inf) ⟶ P1.left :=
      P1.left.fromSpecStalk q_inf
    let f₂ : AlgebraicGeometry.Spec (P1.left.presheaf.stalk q_inf) ⟶ P1.left :=
      AlgebraicGeometry.Spec.map α_mor ≫ ι_aff
    have hf₁_dom : η_dom ≫ f₁ = P1.left.fromSpecStalk (genericPoint ↥P1.left) :=
      AlgebraicGeometry.Scheme.SpecMap_stalkSpecializes_fromSpecStalk
        (genericPoint_specializes q_inf)
    have hf₂_dom : η_dom ≫ f₂ = P1.left.fromSpecStalk (genericPoint ↥P1.left) := by
      change AlgebraicGeometry.Spec.map σ_inf ≫ (AlgebraicGeometry.Spec.map α_mor ≫ ι_aff) = _
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hα_comp,
        AlgebraicGeometry.Spec.map_comp, Category.assoc, hSpec_iso_MB]
      exact AlgebraicGeometry.IsAffineOpen.fromSpecStalk_eq_fromSpecStalk hAff_U hη_U
    have hf_eq : f₁ = f₂ :=
      AlgebraicGeometry.ext_of_isDominant η_dom (hf₁_dom.trans hf₂_dom.symm)
    let x_cl := IsLocalRing.closedPoint ↑(P1.left.presheaf.stalk q_inf)
    have hx₁ : f₁.base x_cl = q_inf := AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint
    have hx₂ : f₂.base x_cl ∈ Set.range ι_aff.base :=
      ⟨(AlgebraicGeometry.Spec.map α_mor).base x_cl, rfl⟩
    rw [← hf_eq, hx₁, hRange_ι] at hx₂
    exact hx₂ rfl

  
  have hDVR_inf : IsDiscreteValuationRing ↑(P1.left.presheaf.stalk q_inf) := by
    obtain ⟨U_k, _, W₀, hW₀, hqW, e_k, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 P1.hom).mp inferInstance q_inf
    have hUk : U_k = ⊤ := by
      ext u
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [hSub_SΩ u, ← show P1.hom.base q_inf = p_Ω0 from hSub_SΩ (P1.hom.base q_inf)]
      exact e_k hqW
    subst hUk
    have hW₀_ne : Nonempty ↥(W₀ : TopologicalSpace.Opens ↥P1.left) := ⟨⟨q_inf, hqW⟩⟩
    have : IsDomain ↑(P1.left.presheaf.obj (Opposite.op W₀)) :=
      @AlgebraicGeometry.IsIntegral.component_integral P1.left _ W₀ hW₀_ne
    obtain ⟨g_mv, _, hg_et⟩ := hStd.exists_etale_mvPolynomial
    let isoΓ := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm
    let e_Ω_ring : Ω ≃+* ↑(S_Ω.presheaf.obj (Opposite.op ⊤)) :=
      isoΓ.commRingCatIsoToRingEquiv
    let iso_poly : Polynomial Ω ≃+* MvPolynomial (Fin 1) ↑(S_Ω.presheaf.obj (Opposite.op ⊤)) :=
      e_mv.trans (MvPolynomial.mapEquiv (Fin 1) e_Ω_ring)
    let f₀ : Polynomial Ω →+* ↑(P1.left.presheaf.obj (Opposite.op W₀)) :=
      g_mv.comp iso_poly.toRingHom
    have hf₀_et : f₀.Etale := RingHom.Etale.respectsIso.right g_mv iso_poly hg_et
    let p_q : ↥(AlgebraicGeometry.Spec (P1.left.presheaf.obj (Opposite.op W₀))) :=
      hW₀.primeIdealOf ⟨q_inf, hqW⟩
    have hfrom_pq : hW₀.fromSpec.base p_q = q_inf := hW₀.fromSpec_primeIdealOf ⟨q_inf, hqW⟩
    have hpq_cl : IsClosed ({p_q} : Set ↥(AlgebraicGeometry.Spec
        (P1.left.presheaf.obj (Opposite.op W₀)))) := by
      have hpre : hW₀.fromSpec.base ⁻¹' ({q_inf} : Set ↥P1.left) = {p_q} := by
        ext p
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact ⟨fun hp => hW₀.fromSpec.isOpenEmbedding.injective (hp.trans hfrom_pq.symm),
          fun hp => hp ▸ hfrom_pq⟩
      rw [← hpre]
      exact hq_inf.preimage hW₀.fromSpec.continuous
    let m : Ideal ↑(P1.left.presheaf.obj (Opposite.op W₀)) := p_q.asIdeal
    have : m.IsPrime := p_q.2
    have hm_max : m.IsMaximal := by
      obtain ⟨M, hM_max, hmM⟩ := m.exists_le_maximal p_q.2.ne_top
      let q_M : PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)) := ⟨M, hM_max.isPrime⟩
      let p_q_sp : PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)) := p_q
      have hpq_cl' : IsClosed ({p_q_sp} :
          Set (PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)))) := hpq_cl
      have hmem : q_M ∈ closure ({p_q_sp} :
          Set (PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)))) := by
        rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus]
        exact hmM
      rw [hpq_cl'.closure_eq, Set.mem_singleton_iff] at hmem
      have hM_eq : M = m := congrArg PrimeSpectrum.asIdeal hmem
      exact hM_eq ▸ hM_max
    have hm_ne_bot : m ≠ ⊥ := by
      intro hm_bot
      obtain ⟨z, -, hzW, hzU⟩ :=
        (IrreducibleSpace.isIrreducible_univ (X := ↥P1.left)).2
          (W₀ : Set ↥P1.left) (U_aff : Set ↥P1.left)
          W₀.isOpen U_aff.isOpen
          ⟨q_inf, trivial, hqW⟩
          ⟨hNe_U.some.1, trivial, hNe_U.some.2⟩
      let p_z : PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)) :=
        hW₀.primeIdealOf ⟨z, hzW⟩
      let p_q_sp : PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)) := p_q
      have hpq_cl' : IsClosed ({p_q_sp} :
          Set (PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)))) := hpq_cl
      have hmem : p_z ∈ closure ({p_q_sp} :
          Set (PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op W₀)))) := by
        rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus]
        change m ≤ p_z.asIdeal
        rw [hm_bot]
        exact bot_le
      rw [hpq_cl'.closure_eq, Set.mem_singleton_iff] at hmem
      have hpz_from : hW₀.fromSpec.base p_z = z := hW₀.fromSpec_primeIdealOf ⟨z, hzW⟩
      have hz_eq : z = q_inf := by
        rw [← hpz_from]
        change hW₀.fromSpec.base p_z = q_inf
        rw [hmem]
        exact hfrom_pq
      rw [hU_coe] at hzU
      exact hzU hz_eq
    have : m.IsMaximal := hm_max
    let _ : Algebra ↑(P1.left.presheaf.obj (Opposite.op W₀)) ↑(P1.left.presheaf.stalk q_inf) :=
      TopCat.Presheaf.algebra_section_stalk P1.left.presheaf ⟨q_inf, hqW⟩
    have : IsLocalization.AtPrime ↑(P1.left.presheaf.stalk q_inf) m :=
      hW₀.isLocalization_stalk ⟨q_inf, hqW⟩
    exact hEtaleStalkDVR ↑(P1.left.presheaf.obj (Opposite.op W₀))
      ↑(P1.left.presheaf.stalk q_inf) m hm_ne_bot ⟨f₀, hf₀_et⟩

  have : IsDiscreteValuationRing ↑(P1.left.presheaf.stalk q_inf) := hDVR_inf
  have hUnif_pole := fun c : Ω =>
    hUnif_pole_alg ↑P1.left.functionField ↑(P1.left.presheaf.stalk q_inf)
      ψ φ_Ω hInj_ψ hFrac hConst_eq c (hPole c)

  
  obtain ⟨_, s_0, _, hs_0_inv, hs_0_span⟩ := hUnif_pole 0
  rw [map_zero, sub_zero] at hs_0_inv
  obtain ⟨V_inf, hq_inf_mem, g_inf, hg_germ⟩ :=
    TopCat.Presheaf.exists_germ_eq P1.left.presheaf (x := q_inf) s_0
  let O_aff : P1.left.Opens := ⟨({q_inf} : Set ↥P1.left)ᶜ, hq_inf.isOpen_compl⟩
  let W_inf : P1.left.Opens := V_inf ⊓ O_aff
  have hNe_W : Nonempty ↥(W_inf : TopologicalSpace.Opens ↥P1.left) := by
    obtain ⟨z, -, hzV, hzO⟩ :=
      (IrreducibleSpace.isIrreducible_univ (X := ↥P1.left)).2
        (V_inf : Set ↥P1.left) (O_aff : Set ↥P1.left)
        V_inf.isOpen O_aff.isOpen
        ⟨q_inf, trivial, hq_inf_mem⟩
        ⟨hNe_U.some.1, trivial, show hNe_U.some.1 ∈ ({q_inf} : Set ↥P1.left)ᶜ from
          hU_coe ▸ hNe_U.some.2⟩
    exact ⟨⟨z, hzV, hzO⟩⟩
  have : Nonempty ↥(W_inf : AlgebraicGeometry.Scheme.{u}) := hNe_W
  have hη_W : genericPoint ↥P1.left ∈ W_inf :=
    (genericPoint_specializes hNe_W.some.1).mem_open W_inf.isOpen hNe_W.some.2
  have h_le_W : W_inf ≤ U_aff := by
    intro x hx
    change x ∈ (U_aff : Set ↥P1.left)
    rw [hU_coe]
    exact hx.2
  let a_sec : ↑(P1.left.presheaf.obj (Opposite.op W_inf)) :=
    (P1.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_inf ≤ V_inf)).op).hom g_inf
  let b_sec : ↑(P1.left.presheaf.obj (Opposite.op W_inf)) :=
    (P1.left.presheaf.map (CategoryTheory.homOfLE h_le_W).op).hom (e_poly Polynomial.X)
  have hab_sec : a_sec * b_sec = 1 := by
    apply AlgebraicGeometry.Scheme.germToFunctionField_injective P1.left W_inf
    rw [map_mul, map_one]
    have ha_germ : (P1.left.germToFunctionField W_inf).hom a_sec =
        algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField s_0 := by
      have hres := TopCat.Presheaf.germ_res_apply P1.left.presheaf
        (CategoryTheory.homOfLE (inf_le_left : W_inf ≤ V_inf))
        (genericPoint ↥P1.left) hη_W g_inf
      have hsp := TopCat.Presheaf.germ_stalkSpecializes_apply P1.left.presheaf
        hq_inf_mem (genericPoint_specializes q_inf) g_inf
      dsimp [a_sec, AlgebraicGeometry.Scheme.germToFunctionField]
      rw [hres, ← hsp, hg_germ]
      rfl
    have hb_germ : (P1.left.germToFunctionField W_inf).hom b_sec = ψ Polynomial.X := by
      have hres := TopCat.Presheaf.germ_res_apply P1.left.presheaf
        (CategoryTheory.homOfLE h_le_W)
        (genericPoint ↥P1.left) hη_W (e_poly Polynomial.X)
      dsimp [b_sec, ψ, g_U, AlgebraicGeometry.Scheme.germToFunctionField]
      exact hres
    rw [ha_germ, hb_germ, hs_0_inv]
  let u_inf : Units ↑(P1.left.presheaf.obj (Opposite.op W_inf)) :=
    ⟨a_sec, b_sec, hab_sec, mul_comm a_sec b_sec ▸ hab_sec⟩

  
  refine ⟨hq_inf, V_inf, hq_inf_mem, g_inf, u_inf, rfl, ?_, ?_⟩
  · rw [hg_germ, hs_0_span]
  · intro Q
    let Q_inf : { y : ↥P1.left // IsClosed ({y} : Set ↥P1.left) } := ⟨q_inf, hq_inf⟩
    by_cases hQ : Q = Q_inf
    · rw [hQ, sub_self]
      exact AddSubgroup.zero_mem _
    · have hQ_ne : Q.1 ≠ q_inf := fun heq => hQ (Subtype.ext heq)
      have hQ_mem : Q.1 ∈ U_aff := by
        change Q.1 ∈ (U_aff : Set ↥P1.left)
        rw [hU_coe]
        exact hQ_ne
      let p_Q : ↥(AlgebraicGeometry.Spec (P1.left.presheaf.obj (Opposite.op U_aff))) :=
        hAff_U.primeIdealOf ⟨Q.1, hQ_mem⟩
      have hfrom_pQ : hAff_U.fromSpec.base p_Q = Q.1 :=
        hAff_U.fromSpec_primeIdealOf ⟨Q.1, hQ_mem⟩
      have hpQ_cl : IsClosed ({p_Q} : Set ↥(AlgebraicGeometry.Spec
          (P1.left.presheaf.obj (Opposite.op U_aff)))) := by
        have hpre : hAff_U.fromSpec.base ⁻¹' ({Q.1} : Set ↥P1.left) = {p_Q} := by
          ext p
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact ⟨fun hp => hAff_U.fromSpec.isOpenEmbedding.injective (hp.trans hfrom_pQ.symm),
            fun hp => hp ▸ hfrom_pQ⟩
        rw [← hpre]
        exact Q.2.preimage hAff_U.fromSpec.continuous
      have hpQ_max : p_Q.asIdeal.IsMaximal := by
        obtain ⟨M, hM_max, hmM⟩ := p_Q.asIdeal.exists_le_maximal p_Q.2.ne_top
        let q_M : PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op U_aff)) := ⟨M, hM_max.isPrime⟩
        let p_Q_sp : PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op U_aff)) := p_Q
        have hpQ_cl' : IsClosed ({p_Q_sp} :
            Set (PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op U_aff)))) := hpQ_cl
        have hmem : q_M ∈ closure ({p_Q_sp} :
            Set (PrimeSpectrum ↑(P1.left.presheaf.obj (Opposite.op U_aff)))) := by
          rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus]
          exact hmM
        rw [hpQ_cl'.closure_eq, Set.mem_singleton_iff] at hmem
        have hM_eq : M = p_Q.asIdeal := congrArg PrimeSpectrum.asIdeal hmem
        exact hM_eq ▸ hM_max
      let I_Q : Ideal (Polynomial Ω) := Ideal.comap e_poly.toRingHom p_Q.asIdeal
      have hIQ_max : I_Q.IsMaximal := by
        have : p_Q.asIdeal.IsMaximal := hpQ_max
        exact Ideal.comap_isMaximal_of_surjective e_poly.toRingHom e_poly.surjective
      obtain ⟨c, hIQ_eq⟩ := hPolyMaxLinear I_Q hIQ_max
      let b_c : ↑(P1.left.presheaf.obj (Opposite.op U_aff)) :=
        e_poly (Polynomial.X - Polynomial.C c)
      have hXc_mem : Polynomial.X - Polynomial.C c ∈ I_Q := by
        rw [hIQ_eq]
        exact Ideal.subset_span (Set.mem_singleton _)
      have hpQ_span : p_Q.asIdeal = Ideal.span ({b_c} :
          Set ↑(P1.left.presheaf.obj (Opposite.op U_aff))) := by
        ext z
        constructor
        · intro hz
          have hz' : e_poly.symm z ∈ I_Q := by
            change e_poly (e_poly.symm z) ∈ p_Q.asIdeal
            rwa [e_poly.apply_symm_apply]
          rw [hIQ_eq, Ideal.mem_span_singleton] at hz'
          obtain ⟨q, hq⟩ := hz'
          rw [Ideal.mem_span_singleton]
          refine ⟨e_poly q, ?_⟩
          calc
            z = e_poly (e_poly.symm z) := (e_poly.apply_symm_apply z).symm
            _ = e_poly ((Polynomial.X - Polynomial.C c) * q) := congrArg e_poly hq
            _ = b_c * e_poly q := map_mul e_poly _ _
        · intro hz
          rw [Ideal.mem_span_singleton] at hz
          obtain ⟨w, rfl⟩ := hz
          have hb_mem : b_c ∈ p_Q.asIdeal := hXc_mem
          exact p_Q.asIdeal.mul_mem_right w hb_mem

      obtain ⟨ht_c_ne, s_c, hs_c_ne, hs_c_inv, hs_c_span⟩ := hUnif_pole c
      let f_c : Units ↑P1.left.functionField :=
        Units.mk0 (ψ (Polynomial.X - Polynomial.C c)) ht_c_ne
      apply AddSubgroup.subset_closure
      refine ⟨f_c, fun x => ?_⟩
      by_cases hx_inf : x = Q_inf
      · subst hx_inf
        refine ⟨1, s_c, 0, 1, one_ne_zero, hs_c_ne, ?_, ?_, ?_, ?_⟩
        · rw [map_one]
          change (1 : ↑P1.left.functionField) =
            ψ (Polynomial.X - Polynomial.C c) *
              algebraMap ↑(P1.left.presheaf.stalk q_inf) ↑P1.left.functionField s_c
          rw [mul_comm, hs_c_inv]
        · rw [Ideal.span_singleton_one, pow_zero, Ideal.one_eq_top]
        · rw [pow_one]
          exact hs_c_span
        · rw [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_same,
            Finsupp.single_eq_of_ne (Ne.symm hQ)]
          norm_num
      · have hx_ne_inf : x.1 ≠ q_inf := fun heq => hx_inf (Subtype.ext heq)
        have hx_mem : x.1 ∈ U_aff := by
          change x.1 ∈ (U_aff : Set ↥P1.left)
          rw [hU_coe]
          exact hx_ne_inf
        let r_x : ↑(P1.left.presheaf.stalk x.1) :=
          (P1.left.presheaf.germ U_aff x.1 hx_mem).hom b_c
        have hr_x_K :
            algebraMap ↑(P1.left.presheaf.stalk x.1) ↑P1.left.functionField r_x =
              ψ (Polynomial.X - Polynomial.C c) := by
          have hsp := TopCat.Presheaf.germ_stalkSpecializes_apply P1.left.presheaf
            hx_mem (genericPoint_specializes x.1) b_c
          dsimp [r_x, b_c, ψ, g_U, AlgebraicGeometry.Scheme.germToFunctionField]
          exact hsp
        have hr_x_ne : r_x ≠ 0 := by
          intro h0
          rw [h0, map_zero] at hr_x_K
          exact ht_c_ne hr_x_K.symm
        let _ : Algebra ↑(P1.left.presheaf.obj (Opposite.op U_aff))
            ↑(P1.left.presheaf.stalk x.1) :=
          TopCat.Presheaf.algebra_section_stalk P1.left.presheaf ⟨x.1, hx_mem⟩
        have : IsLocalization.AtPrime ↑(P1.left.presheaf.stalk x.1)
            (hAff_U.primeIdealOf ⟨x.1, hx_mem⟩).asIdeal :=
          hAff_U.isLocalization_stalk ⟨x.1, hx_mem⟩
        by_cases hxQ : x = Q
        · subst x
          refine ⟨r_x, 1, 1, 0, hr_x_ne, one_ne_zero, ?_, ?_, ?_, ?_⟩
          · rw [map_one, mul_one]
            exact hr_x_K
          · rw [pow_one]
            have hp_eq : hAff_U.primeIdealOf ⟨Q.1, hx_mem⟩ = p_Q := rfl
            calc
              Ideal.span ({r_x} : Set ↑(P1.left.presheaf.stalk Q.1)) =
                  Ideal.map
                    (algebraMap ↑(P1.left.presheaf.obj (Opposite.op U_aff))
                      ↑(P1.left.presheaf.stalk Q.1))
                    (Ideal.span ({b_c} : Set ↑(P1.left.presheaf.obj (Opposite.op U_aff)))) := by
                rw [Ideal.map_span, Set.image_singleton]
                rfl
              _ = Ideal.map
                    (algebraMap ↑(P1.left.presheaf.obj (Opposite.op U_aff))
                      ↑(P1.left.presheaf.stalk Q.1))
                    (hAff_U.primeIdealOf ⟨Q.1, hx_mem⟩).asIdeal := by
                rw [hp_eq, hpQ_span]
