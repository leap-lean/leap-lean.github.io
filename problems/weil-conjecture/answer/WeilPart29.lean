        MorphismProperty.Over.homMk (levelOpen U g r).ι rfl
      have hLevelCov : ∀ (U : S.Etale) (g : ↥(submod U)),
          Sieve.generate (Presieve.ofArrows (levelObj U g) (levelHom U g)) ∈ J U := by
        intro U g
        rw [hMemEtaleJ]
        intro x
        let r := g.1 x
        refine ⟨levelObj U g r, levelHom U g r, ⟨x, rfl⟩, ?_, ?_, rfl⟩
        · exact ⟨levelObj U g r, 𝟙 _, levelHom U g r, Presieve.ofArrows.mk r, Category.id_comp _⟩
        · change AlgebraicGeometry.Etale (levelOpen U g r).ι
