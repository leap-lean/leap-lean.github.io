      intro U R hR s0_fam hs0_compat
      let s_fam : CategoryTheory.Presieve.FamilyOfElements
          ((weilAltLocConstPresheaf S n).comp (CategoryTheory.forget AddCommGrpCat.{u})) R.arrows :=
        fun _ f hf => (s0_fam f hf).1
      have hs_compat : s_fam.Compatible := fun _ _ _ g₁ g₂ f₁ f₂ hf₁ hf₂ hg =>
        congrArg Subtype.val (hs0_compat g₁ g₂ hf₁ hf₂ hg)
      obtain ⟨g, hg_amalg, hg_uniq⟩ := hShL_type R hR s_fam hs_compat
      let g_lc : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) := g
      have hg_mem : g_lc ∈ weilAltZeroBdrySubgroup S V n U := by
        intro x hx
        obtain ⟨Z, h_Z, z₀, hh_R, _, hhz⟩ := (hMemEtale R).mp hR x
        have hgx : g_lc x = (s0_fam h_Z hh_R).1 z₀ := by
          rw [← hhz]
          exact congrArg (fun (k : LocallyConstant ↥Z.left (ULift.{u} (ZMod n))) => k z₀)
            (hg_amalg h_Z hh_R)
        refine hgx.trans ((s0_fam h_Z hh_R).2 z₀ ?_)
        intro hz_in
        apply hx
        have hzw : Z.hom z₀ = U.hom x := by
          rw [← CategoryTheory.MorphismProperty.Over.w h_Z,
              AlgebraicGeometry.Scheme.Hom.comp_apply, hhz]
        exact hzw ▸ hz_in
      refine ⟨⟨g_lc, hg_mem⟩, fun _ f hf => Subtype.ext (hg_amalg f hf), fun g' hg' => ?_⟩
      exact Subtype.ext (hg_uniq g'.1 (fun _ f hf => congrArg Subtype.val (hg' f hf)))
    let L_S : CategoryTheory.Sheaf J_S AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf S n, hShL⟩
    let F_S : CategoryTheory.Sheaf J_S AddCommGrpCat.{u} := weilEtaleTorsionSheaf S n
    let P_const : CategoryTheory.Functor S.Etaleᵒᵖ AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const (Opposite S.Etale)).obj A_n
    let adj_sh := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
    let η_const : P_const ⟶ F_S.obj := adj_sh.unit.app P_const
    let c_nat : P_const ⟶ L_S.obj :=
      { app := fun U => weilAltLocConstConstHom S (Opposite.unop U) n
        naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }
    let Φ_hom : F_S ⟶ L_S := (adj_sh.homEquiv P_const L_S).symm c_nat
    have hΦ_unit : ∀ (T : S.Etale),
        η_const.app (Opposite.op T) ≫ Φ_hom.hom.app (Opposite.op T) =
          weilAltLocConstConstHom S T n := by
      intro T
      have h1 : adj_sh.homEquiv P_const L_S Φ_hom = c_nat :=
        (adj_sh.homEquiv P_const L_S).apply_symm_apply c_nat
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact congrArg (fun α : P_const ⟶ L_S.obj => α.app (Opposite.op T)) h1
    have hη_nat : ∀ {W₁ W₂ : S.Etale} (u : W₁ ⟶ W₂) (a : ↥A_n),
        (F_S.obj.map u.op).hom ((η_const.app (Opposite.op W₂)).hom a) =
          (η_const.app (Opposite.op W₁)).hom a := by
      intro W₁ W₂ u a
      have hnat := η_const.naturality u.op
      exact (congrArg (fun φ : A_n ⟶ F_S.obj.obj (Opposite.op W₁) => φ.hom a) hnat).symm
    let O_lvl_S : ∀ (T : S.Etale) (s : LocallyConstant ↥T.left (ULift.{u} (ZMod n))),
        ↥T.left → T.left.Opens := fun _ s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
    let φ_inv_fun : ∀ (T : S.Etale),
        LocallyConstant ↥T.left (ULift.{u} (ZMod n)) → ↥(F_S.obj.obj (Opposite.op T)) :=
      fun T s =>
        let W_lvl : ↥T.left → S.Etale := fun x => openEtaleObj T (O_lvl_S T s x)
        let κ : ∀ x : ↥T.left, W_lvl x ⟶ T := fun x => openEtaleHom T (O_lvl_S T s x)
        let hCov : CategoryTheory.Sieve.ofArrows W_lvl κ ∈ J_S T :=
          hOpenArrowsCov T (O_lvl_S T s) (fun x => ⟨x, rfl⟩)
        let loc : ∀ x : ↥T.left, Aℤ ⟶ F_S.obj.obj (Opposite.op (W_lvl x)) :=
          fun x => toHom _ ((η_const.app (Opposite.op (W_lvl x))).hom (s x))
        evOne _ (F_S.2.amalgamateOfArrows κ hCov loc (by
          intro Z₀ x₁ x₂ a₁ a₂ heq
          by_cases hE : IsEmpty ↥Z₀.left
          · exact hEmpty_ext F_S Z₀ hE _ _
          · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hE
            have hpt : (a₁.left z₀).1 = (a₂.left z₀).1 :=
              congrArg (fun (k : Z₀ ⟶ T) => k.left z₀) heq
            have hs1 : s (a₁.left z₀).1 = s x₁ := (a₁.left z₀).2
            have hs2 : s (a₂.left z₀).1 = s x₂ := (a₂.left z₀).2
            have hs12 : s x₁ = s x₂ := hs1.symm.trans ((congrArg s hpt).trans hs2)
            dsimp only [loc]
            rw [h_toHom_comp, h_toHom_comp, hη_nat a₁ (s x₁), hη_nat a₂ (s x₂), hs12]))
    have hChar_inv : ∀ {W T : S.Etale} (f : W ⟶ T)
        (s : LocallyConstant ↥T.left (ULift.{u} (ZMod n))) (a : ↥A_n),
        (∀ y : ↥W.left, s (f.left y) = a) →
        (F_S.obj.map f.op).hom (φ_inv_fun T s) = (η_const.app (Opposite.op W)).hom a := by
      intro W T f s a hsa
      rw [← h_evOne_toHom (F_S.obj.obj (Opposite.op W))
            ((F_S.obj.map f.op).hom (φ_inv_fun T s)),
          ← h_evOne_toHom (F_S.obj.obj (Opposite.op W))
            ((η_const.app (Opposite.op W)).hom a)]
      congr 1
      let W_lvl : ↥T.left → S.Etale := fun x => openEtaleObj T (O_lvl_S T s x)
      let κ : ∀ x : ↥T.left, W_lvl x ⟶ T := fun x => openEtaleHom T (O_lvl_S T s x)
      let O' : ↥T.left → W.left.Opens :=
        fun x => (TopologicalSpace.Opens.map f.left.base).obj (O_lvl_S T s x)
      let W' : ↥T.left → S.Etale := fun x => openEtaleObj W (O' x)
      let κ' : ∀ x : ↥T.left, W' x ⟶ W := fun x => openEtaleHom W (O' x)
      have hCov' : CategoryTheory.Sieve.ofArrows W' κ' ∈ J_S W :=
        hOpenArrowsCov W O' (fun y => ⟨f.left y, rfl⟩)
      apply F_S.2.hom_ext_ofArrows κ' hCov'
      intro x
      have hr_x : Set.range ⇑((O' x).ι ≫ f.left) ⊆ Set.range ⇑(O_lvl_S T s x).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro p ⟨z, rfl⟩
        exact z.2
      let lift_x : (O' x).toScheme ⟶ (O_lvl_S T s x).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (O_lvl_S T s x).ι ((O' x).ι ≫ f.left) hr_x
      have hlift_fac : lift_x ≫ (O_lvl_S T s x).ι = (O' x).ι ≫ f.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (O_lvl_S T s x).ι ((O' x).ι ≫ f.left) hr_x
      let g_x : W' x ⟶ W_lvl x :=
        CategoryTheory.MorphismProperty.Over.homMk lift_x
          (by
            change lift_x ≫ ((O_lvl_S T s x).ι ≫ T.hom) = (O' x).ι ≫ W.hom
            rw [← CategoryTheory.Category.assoc, hlift_fac,
                CategoryTheory.Category.assoc,
                CategoryTheory.MorphismProperty.Over.w f])
          trivial
      have hgx_op : f.op ≫ (κ' x).op = (κ x).op ≫ g_x.op :=
        congrArg Quiver.Hom.op
          (CategoryTheory.MorphismProperty.Over.Hom.ext hlift_fac.symm : κ' x ≫ f = g_x ≫ κ x)
      rw [← h_toHom_comp (φ_inv_fun T s) (F_S.obj.map f.op)]
      dsimp only [φ_inv_fun]
      rw [h_toHom_evOne, CategoryTheory.Category.assoc, ← F_S.obj.map_comp,
          hgx_op, F_S.obj.map_comp,
          ← CategoryTheory.Category.assoc, F_S.2.amalgamateOfArrows_map,
          h_toHom_comp, h_toHom_comp, hη_nat g_x (s x), hη_nat (κ' x) a]
      by_cases hE : IsEmpty ↥(W' x).left
      · exact hEmpty_ext F_S (W' x) hE _ _
      · obtain ⟨z⟩ := not_isEmpty_iff.mp hE
        have hsx : s (f.left z.1) = s x := z.2
        rw [← hsx, hsa z.1]
    have hφ_zero : ∀ (T : S.Etale), φ_inv_fun T 0 = 0 := by
      intro T
      have h1 := hChar_inv (𝟙 T) 0 0 (fun _ => rfl)
      have hid : F_S.obj.map (𝟙 T).op = 𝟙 _ := F_S.obj.map_id (Opposite.op T)
      rw [hid] at h1
      exact h1.trans (map_zero _)
    have hφ_add : ∀ (T : S.Etale) (s₁ s₂ : LocallyConstant ↥T.left (ULift.{u} (ZMod n))),
        φ_inv_fun T (s₁ + s₂) = φ_inv_fun T s₁ + φ_inv_fun T s₂ := by
      intro T s₁ s₂
      rw [← h_evOne_toHom (F_S.obj.obj (Opposite.op T)) (φ_inv_fun T (s₁ + s₂)),
          ← h_evOne_toHom (F_S.obj.obj (Opposite.op T)) (φ_inv_fun T s₁ + φ_inv_fun T s₂)]
      congr 1
      let O₁₂ : ↥T.left → T.left.Opens := fun x =>
        ⟨s₁ ⁻¹' {s₁ x} ∩ s₂ ⁻¹' {s₂ x},
          (s₁.isLocallyConstant {s₁ x}).inter (s₂.isLocallyConstant {s₂ x})⟩
      let W₁₂ : ↥T.left → S.Etale := fun x => openEtaleObj T (O₁₂ x)
      let κ₁₂ : ∀ x : ↥T.left, W₁₂ x ⟶ T := fun x => openEtaleHom T (O₁₂ x)
      apply F_S.2.hom_ext_ofArrows κ₁₂ (hOpenArrowsCov T O₁₂ (fun x => ⟨x, ⟨rfl, rfl⟩⟩))
      intro x
      rw [h_toHom_add, Preadditive.add_comp, h_toHom_comp, h_toHom_comp, h_toHom_comp,
          hChar_inv (κ₁₂ x) (s₁ + s₂) (s₁ x + s₂ x)
            (fun y => congrArg₂ (· + ·) y.2.1 y.2.2),
          hChar_inv (κ₁₂ x) s₁ (s₁ x) (fun y => y.2.1),
          hChar_inv (κ₁₂ x) s₂ (s₂ x) (fun y => y.2.2)]
      exact (congrArg (toHom _)
        ((η_const.app (Opposite.op (W₁₂ x))).hom.map_add (s₁ x) (s₂ x))).trans
        (h_toHom_add _ _ _)
    let Φ_inv : L_S ⟶ F_S :=
      CategoryTheory.ObjectProperty.homMk
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := φ_inv_fun (Opposite.unop U)
              map_zero' := hφ_zero (Opposite.unop U)
              map_add' := hφ_add (Opposite.unop U) }
          naturality := fun {U₁ U₂} u => by
            apply AddCommGrpCat.ext
            intro s
            let T := Opposite.unop U₁
            let T' := Opposite.unop U₂
            let s' : LocallyConstant ↥T'.left (ULift.{u} (ZMod n)) := (L_S.obj.map u).hom s
            change φ_inv_fun T' s' = (F_S.obj.map u).hom (φ_inv_fun T s)
            rw [← h_evOne_toHom (F_S.obj.obj (Opposite.op T')) (φ_inv_fun T' s'),
                ← h_evOne_toHom (F_S.obj.obj (Opposite.op T'))
                  ((F_S.obj.map u).hom (φ_inv_fun T s))]
            congr 1
            let W' : ↥T'.left → S.Etale := fun x' => openEtaleObj T' (O_lvl_S T' s' x')
            let κ' : ∀ x' : ↥T'.left, W' x' ⟶ T' := fun x' => openEtaleHom T' (O_lvl_S T' s' x')
            apply F_S.2.hom_ext_ofArrows κ' (hOpenArrowsCov T' (O_lvl_S T' s') (fun x' => ⟨x', rfl⟩))
            intro x'
            have hu_op : u ≫ (κ' x').op = (κ' x' ≫ u.unop).op := rfl
            rw [h_toHom_comp, ← h_toHom_comp (φ_inv_fun T s) (F_S.obj.map u),
                CategoryTheory.Category.assoc, ← F_S.obj.map_comp, hu_op, h_toHom_comp,
                hChar_inv (κ' x') s' (s' x') (fun y => y.2)]
            exact congrArg (toHom _)
              (hChar_inv (κ' x' ≫ u.unop) s (s' x') (fun y => y.2)).symm }
    have hΦ_hom_inv : Φ_hom ≫ Φ_inv = 𝟙 F_S := by
      apply (adj_sh.homEquiv P_const F_S).injective
      have h1 : adj_sh.homEquiv P_const F_S (Φ_hom ≫ Φ_inv) = c_nat ≫ Φ_inv.hom :=
        (adj_sh.homEquiv_naturality_right Φ_hom Φ_inv).trans
          (congrArg (· ≫ Φ_inv.hom) ((adj_sh.homEquiv P_const L_S).apply_symm_apply c_nat))
      have h2 : adj_sh.homEquiv P_const F_S (𝟙 F_S) = η_const := by
        apply CategoryTheory.NatTrans.ext
        funext U
        exact CategoryTheory.Category.comp_id _
      refine h1.trans (Eq.trans ?_ h2.symm)
      apply CategoryTheory.NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro a
      let T := Opposite.unop U
      have h3 := hChar_inv (𝟙 T) (LocallyConstant.const ↥T.left a) a (fun _ => rfl)
      have hid : F_S.obj.map (𝟙 T).op = 𝟙 _ := F_S.obj.map_id (Opposite.op T)
      rw [hid] at h3
      exact h3
    have hΦ_inv_hom : Φ_inv ≫ Φ_hom = 𝟙 L_S := by
      let toLC : ∀ {W : S.Etale}, ↥(L_S.obj.obj (Opposite.op W)) →
          LocallyConstant ↥W.left (ULift.{u} (ZMod n)) := fun k => k
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro s
      refine LocallyConstant.ext (fun x => ?_)
      let T := Opposite.unop U
      let s_lc : LocallyConstant ↥T.left (ULift.{u} (ZMod n)) := s
      let κ_x : openEtaleObj T (O_lvl_S T s_lc x) ⟶ T := openEtaleHom T (O_lvl_S T s_lc x)
      let y₀ : ↥(openEtaleObj T (O_lvl_S T s_lc x)).left := ⟨x, rfl⟩
      have hnat := Φ_hom.hom.naturality κ_x.op
      have happ : toLC ((Φ_hom.hom.app (Opposite.op (openEtaleObj T (O_lvl_S T s_lc x)))).hom
            ((F_S.obj.map κ_x.op).hom (φ_inv_fun T s_lc))) y₀ =
          toLC ((Φ_hom.hom.app (Opposite.op T)).hom (φ_inv_fun T s_lc)) x :=
        congrArg
          (fun (φ : F_S.obj.obj (Opposite.op T) ⟶
              L_S.obj.obj (Opposite.op (openEtaleObj T (O_lvl_S T s_lc x)))) =>
            toLC (φ.hom (φ_inv_fun T s_lc)) y₀) hnat
      change toLC ((Φ_hom.hom.app (Opposite.op T)).hom (φ_inv_fun T s_lc)) x = s_lc x
      rw [← happ, hChar_inv κ_x s_lc (s_lc x) (fun y => y.2)]
      exact congrArg (fun (φ : A_n ⟶ L_S.obj.obj _) => toLC (φ.hom (s_lc x)) y₀)
        (hΦ_unit (openEtaleObj T (O_lvl_S T s_lc x)))
    exact ⟨hShL, hSh0, ⟨Φ_hom, Φ_inv, hΦ_hom_inv, hΦ_inv_hom⟩, hΦ_unit⟩

  let V : Γ.Opens := @AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen
  let I_Z : Γ.IdealSheafData := weilAltClosedComplIdeal Γ V
  let Z : AlgebraicGeometry.Scheme.{u} := I_Z.subscheme
  let i_Z : Quiver.Hom Z Γ := I_Z.subschemeι
  have _hCont := hCont
  let P_push_Z := (weilAltCdSitePullback i_Z).sheafPushforwardContinuous
    AddCommGrpCat.{u} Γ.smallEtaleTopology Z.smallEtaleTopology
  let U_j : Γ.Etale := weilGysinEtaleObj j hj_et
  let L_j := weilGysinLocalTorsionSheaf Γ n U_j
  let ε_j := weilGysinLocalTorsionCounit Γ n U_j

  obtain ⟨hShL_Γ, hSh0_Γ_all, Φ_Γ, hΦ_Γ⟩ := hStep1 Γ
  obtain ⟨hShL_Z, _, Φ_Z, _⟩ := hStep1 Z
  let hSh0_V := hSh0_Γ_all V
  let K_V : CategoryTheory.Sheaf Γ.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilAltZeroBdrySubpresheaf Γ V n, hSh0_V⟩
  let L_Γ : CategoryTheory.Sheaf Γ.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilAltLocConstPresheaf Γ n, hShL_Γ⟩
  let L_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilAltLocConstPresheaf Z n, hShL_Z⟩

  have hFreeComp : ∀ {F G : CategoryTheory.Sheaf Γ.smallEtaleTopology AddCommGrpCat.{u}}
      (α : L_j ⟶ F) (β : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ β) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ β.hom.app (Opposite.op U_j) := by
    intro F G α β
    let adj_Γ := CategoryTheory.sheafificationAdjunction Γ.smallEtaleTopology AddCommGrpCat.{u}
    have h1 : (adj_Γ.homEquiv (CategoryTheory.Presheaf.freeYoneda U_j A_n) G) (α ≫ β) =
        (adj_Γ.homEquiv (CategoryTheory.Presheaf.freeYoneda U_j A_n) F) α ≫ β.hom :=
      adj_Γ.homEquiv_naturality_right α β
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv h1).trans
      (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)

  
  
  
  have hStep2 : ∃ (Ψ : CategoryTheory.Iso L_j K_V),
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Sheaf.freeYonedaHomEquiv Ψ.hom)
        ((weilAltZeroBdrySubpresheafι Γ V n).app (Opposite.op U_j)) =
        weilAltLocConstConstHom Γ U_j n := by
    have hMono_j : CategoryTheory.Mono j := @AlgebraicGeometry.IsOpenImmersion.mono _ _ j hOpen
    let J_Γ := Γ.smallEtaleTopology
    let η_free : A_n ⟶ L_j.obj.obj (Opposite.op U_j) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_j)
    have h_Uj_sub : ∀ {Y : Γ.Etale} (g₁ g₂ : Y ⟶ U_j), g₁ = g₂ := by
      intro Y g₁ g₂
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hMono_j.right_cancellation g₁.left g₂.left
        ((CategoryTheory.MorphismProperty.Over.w g₁).trans
          (CategoryTheory.MorphismProperty.Over.w g₂).symm)
    let liftHom : ∀ (Y : Γ.Etale), Set.range ⇑Y.hom ⊆ (V : Set ↥Γ) → (Y ⟶ U_j) :=
      fun Y hr =>
        have hr' : Set.range ⇑Y.hom ⊆ Set.range ⇑j := by
          rwa [← @AlgebraicGeometry.Scheme.Hom.coe_opensRange _ _ j hOpen]
        CategoryTheory.MorphismProperty.Over.homMk
          (@AlgebraicGeometry.IsOpenImmersion.lift _ _ _ j Y.hom hOpen hr')
          (@AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ j Y.hom hOpen hr')
          trivial
    let c0_j : A_n ⟶ K_V.obj.obj (Opposite.op U_j) :=
      AddCommGrpCat.ofHom
        { toFun := fun a =>
            ⟨LocallyConstant.const ↥W₀ a, fun x hx =>
              False.elim (hx ((@AlgebraicGeometry.Scheme.Hom.coe_opensRange _ _ j hOpen).symm ▸
                ⟨x, rfl⟩))⟩
          map_zero' := Subtype.ext (LocallyConstant.ext (fun _ => rfl))
          map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)) }
    let ψ_hom : L_j ⟶ K_V := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm c0_j
    have hψ_equiv : CategoryTheory.Sheaf.freeYonedaHomEquiv ψ_hom = c0_j :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply c0_j
    have hψ_counit :
        CategoryTheory.Sheaf.freeYonedaHomEquiv ψ_hom ≫
          (weilAltZeroBdrySubpresheafι Γ V n).app (Opposite.op U_j) =
        weilAltLocConstConstHom Γ U_j n := by
      rw [hψ_equiv]
      exact AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
    have hψ_η : η_free ≫ ψ_hom.hom.app (Opposite.op U_j) = c0_j := by
      have h1 := hFreeComp (𝟙 L_j) ψ_hom
      rw [CategoryTheory.Category.id_comp, hψ_equiv] at h1
      exact h1.symm
    have hψ_eval : ∀ {Y : Γ.Etale} (lam : Y ⟶ U_j) (a : ↥A_n),
        ((ψ_hom.hom.app (Opposite.op Y)).hom ((L_j.obj.map lam.op).hom (η_free.hom a))).1 =
          LocallyConstant.const ↥Y.left a := by
      intro Y lam a
      have hnat := ψ_hom.hom.naturality lam.op
      have happ := congrArg
        (fun (φ : L_j.obj.obj (Opposite.op U_j) ⟶ K_V.obj.obj (Opposite.op Y)) =>
          (φ.hom (η_free.hom a)).1) hnat
      change ((ψ_hom.hom.app (Opposite.op Y)).hom ((L_j.obj.map lam.op).hom (η_free.hom a))).1 =
        ((K_V.obj.map lam.op).hom ((ψ_hom.hom.app (Opposite.op U_j)).hom (η_free.hom a))).1 at happ
      rw [happ]
      exact congrArg
        (fun (φ : A_n ⟶ K_V.obj.obj (Opposite.op U_j)) =>
          ((K_V.obj.map lam.op).hom (φ.hom a)).1) hψ_η
    let locModel : ∀ (Y : Γ.Etale), ↥A_n → ↥(L_j.obj.obj (Opposite.op Y)) :=
      fun Y a =>
        if hr : Set.range ⇑Y.hom ⊆ (V : Set ↥Γ) then
          (L_j.obj.map (liftHom Y hr).op).hom (η_free.hom a)
        else 0
    have h_locModel_zero : ∀ (Y : Γ.Etale), locModel Y 0 = 0 := by
      intro Y
      dsimp only [locModel]
      split_ifs with hr
      · rw [map_zero, map_zero]
      · rfl
    have h_locModel_pos : ∀ (Y : Γ.Etale) (a : ↥A_n) (hr : Set.range ⇑Y.hom ⊆ (V : Set ↥Γ)),
        locModel Y a = (L_j.obj.map (liftHom Y hr).op).hom (η_free.hom a) := by
      intro Y a hr
      dsimp only [locModel]
      split_ifs with h
      · rfl
      · exact absurd hr h
    have h_locModel_map : ∀ {Z₀ Y : Γ.Etale} (g : Z₀ ⟶ Y) (a : ↥A_n),
        (a ≠ 0 → Set.range ⇑Y.hom ⊆ (V : Set ↥Γ)) →
        (L_j.obj.map g.op).hom (locModel Y a) = locModel Z₀ a := by
      intro Z₀ Y g a ha
      by_cases h0 : a = 0
      · subst h0
        rw [h_locModel_zero, h_locModel_zero, map_zero]
      · have hr_Y : Set.range ⇑Y.hom ⊆ (V : Set ↥Γ) := ha h0
        have hr_Z : Set.range ⇑Z₀.hom ⊆ (V : Set ↥Γ) := by
          rintro _ ⟨z, hz⟩
          subst hz
          apply hr_Y
          refine ⟨g.left z, ?_⟩
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w g]
        rw [h_locModel_pos Y a hr_Y, h_locModel_pos Z₀ a hr_Z]
        change ((L_j.obj.map (liftHom Y hr_Y).op ≫ L_j.obj.map g.op).hom) (η_free.hom a) = _
        have hcomp_op : (liftHom Y hr_Y).op ≫ g.op = (liftHom Z₀ hr_Z).op :=
          congrArg Quiver.Hom.op (h_Uj_sub (g ≫ liftHom Y hr_Y) (liftHom Z₀ hr_Z))
        rw [← L_j.obj.map_comp, hcomp_op]
    have h_ψ_locModel : ∀ (Y : Γ.Etale) (a : ↥A_n),
        (a ≠ 0 → Set.range ⇑Y.hom ⊆ (V : Set ↥Γ)) →
        ((ψ_hom.hom.app (Opposite.op Y)).hom (locModel Y a)).1 =
          LocallyConstant.const ↥Y.left a := by
      intro Y a ha
      by_cases h0 : a = 0
      · subst h0
        rw [h_locModel_zero, map_zero]
        exact LocallyConstant.ext (fun _ => rfl)
      · have hr : Set.range ⇑Y.hom ⊆ (V : Set ↥Γ) := ha h0
        rw [h_locModel_pos Y a hr]
        exact hψ_eval (liftHom Y hr) a
    have h_locModel_add : ∀ (Y : Γ.Etale) (a₁ a₂ : ↥A_n),
        (a₁ ≠ 0 → Set.range ⇑Y.hom ⊆ (V : Set ↥Γ)) →
        (a₂ ≠ 0 → Set.range ⇑Y.hom ⊆ (V : Set ↥Γ)) →
        locModel Y (a₁ + a₂) = locModel Y a₁ + locModel Y a₂ := by
      intro Y a₁ a₂ ha₁ ha₂
      by_cases hr : Set.range ⇑Y.hom ⊆ (V : Set ↥Γ)
      · rw [h_locModel_pos Y (a₁ + a₂) hr, h_locModel_pos Y a₁ hr, h_locModel_pos Y a₂ hr,
            map_add, map_add]
      · have hz1 : a₁ = 0 := by by_contra h; exact hr (ha₁ h)
        have hz2 : a₂ = 0 := by by_contra h; exact hr (ha₂ h)
        subst hz1; subst hz2
        rw [add_zero, h_locModel_zero, add_zero]
    let O_lvl_K : ∀ (T : Γ.Etale) (s : ↥(weilAltZeroBdrySubgroup Γ V n T)),
        ↥T.left → T.left.Opens := fun _ s x => ⟨s.1 ⁻¹' {s.1 x}, s.1.isLocallyConstant {s.1 x}⟩
    have ha_lvl : ∀ (T : Γ.Etale) (s : ↥(weilAltZeroBdrySubgroup Γ V n T)) (x : ↥T.left),
        s.1 x ≠ 0 → Set.range ⇑(openEtaleObj T (O_lvl_K T s x)).hom ⊆ (V : Set ↥Γ) := by
      intro T s x hne p ⟨y, hy⟩
      subst hy
      by_contra hnot
      apply hne
      have hy_val : s.1 y.1 = s.1 x := y.2
      rw [← hy_val]
      exact s.2 y.1 hnot
    let ψ_inv_fun : ∀ (T : Γ.Etale),
        ↥(weilAltZeroBdrySubgroup Γ V n T) → ↥(L_j.obj.obj (Opposite.op T)) :=
      fun T s =>
        let W_lvl : ↥T.left → Γ.Etale := fun x => openEtaleObj T (O_lvl_K T s x)
        let κ : ∀ x : ↥T.left, W_lvl x ⟶ T := fun x => openEtaleHom T (O_lvl_K T s x)
        let hCov : CategoryTheory.Sieve.ofArrows W_lvl κ ∈ J_Γ T :=
          hOpenArrowsCov T (O_lvl_K T s) (fun x => ⟨x, rfl⟩)
        let loc : ∀ x : ↥T.left, Aℤ ⟶ L_j.obj.obj (Opposite.op (W_lvl x)) :=
          fun x => toHom _ (locModel (W_lvl x) (s.1 x))
        evOne _ (L_j.2.amalgamateOfArrows κ hCov loc (by
          intro Z₀ x₁ x₂ a₁ a₂ heq
          by_cases hE : IsEmpty ↥Z₀.left
          · exact hEmpty_ext L_j Z₀ hE _ _
          · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hE
            have hpt : (a₁.left z₀).1 = (a₂.left z₀).1 :=
              congrArg (fun (k : Z₀ ⟶ T) => k.left z₀) heq
            have hs12 : s.1 x₁ = s.1 x₂ :=
              (a₁.left z₀).2.symm.trans ((congrArg s.1 hpt).trans (a₂.left z₀).2)
            dsimp only [loc]
            rw [h_toHom_comp, h_toHom_comp,
                h_locModel_map a₁ (s.1 x₁) (ha_lvl T s x₁),
                h_locModel_map a₂ (s.1 x₂) (ha_lvl T s x₂),
                hs12]))
    have hChar_psi : ∀ {W T : Γ.Etale} (f : W ⟶ T)
        (s : ↥(weilAltZeroBdrySubgroup Γ V n T)) (a : ↥A_n),
        (a ≠ 0 → Set.range ⇑W.hom ⊆ (V : Set ↥Γ)) →
        (∀ y : ↥W.left, s.1 (f.left y) = a) →
        (L_j.obj.map f.op).hom (ψ_inv_fun T s) = locModel W a := by
      intro W T f s a ha hsa
      rw [← h_evOne_toHom (L_j.obj.obj (Opposite.op W))
            ((L_j.obj.map f.op).hom (ψ_inv_fun T s)),
          ← h_evOne_toHom (L_j.obj.obj (Opposite.op W)) (locModel W a)]
      congr 1
      let W_lvl : ↥T.left → Γ.Etale := fun x => openEtaleObj T (O_lvl_K T s x)
      let κ : ∀ x : ↥T.left, W_lvl x ⟶ T := fun x => openEtaleHom T (O_lvl_K T s x)
      let O' : ↥T.left → W.left.Opens :=
        fun x => (TopologicalSpace.Opens.map f.left.base).obj (O_lvl_K T s x)
      let W' : ↥T.left → Γ.Etale := fun x => openEtaleObj W (O' x)
      let κ' : ∀ x : ↥T.left, W' x ⟶ W := fun x => openEtaleHom W (O' x)
      apply L_j.2.hom_ext_ofArrows κ' (hOpenArrowsCov W O' (fun y => ⟨f.left y, rfl⟩))
      intro x
      have hr_x : Set.range ⇑((O' x).ι ≫ f.left) ⊆ Set.range ⇑(O_lvl_K T s x).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro p ⟨z, rfl⟩
        exact z.2
      let lift_x : (O' x).toScheme ⟶ (O_lvl_K T s x).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (O_lvl_K T s x).ι ((O' x).ι ≫ f.left) hr_x
      have hlift_fac : lift_x ≫ (O_lvl_K T s x).ι = (O' x).ι ≫ f.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (O_lvl_K T s x).ι ((O' x).ι ≫ f.left) hr_x
      let g_x : W' x ⟶ W_lvl x :=
        CategoryTheory.MorphismProperty.Over.homMk lift_x
          (by
            change lift_x ≫ ((O_lvl_K T s x).ι ≫ T.hom) = (O' x).ι ≫ W.hom
            rw [← CategoryTheory.Category.assoc, hlift_fac,
                CategoryTheory.Category.assoc,
                CategoryTheory.MorphismProperty.Over.w f])
          trivial
      have hgx_op : f.op ≫ (κ' x).op = (κ x).op ≫ g_x.op :=
        congrArg Quiver.Hom.op
          (CategoryTheory.MorphismProperty.Over.Hom.ext hlift_fac.symm : κ' x ≫ f = g_x ≫ κ x)
      rw [← h_toHom_comp (ψ_inv_fun T s) (L_j.obj.map f.op)]
      dsimp only [ψ_inv_fun]
      rw [h_toHom_evOne, CategoryTheory.Category.assoc, ← L_j.obj.map_comp,
          hgx_op, L_j.obj.map_comp,
          ← CategoryTheory.Category.assoc, L_j.2.amalgamateOfArrows_map,
          h_toHom_comp, h_toHom_comp,
          h_locModel_map g_x (s.1 x) (ha_lvl T s x),
          h_locModel_map (κ' x) a ha]
      by_cases hE : IsEmpty ↥(W' x).left
      · exact hEmpty_ext L_j (W' x) hE _ _
      · obtain ⟨z⟩ := not_isEmpty_iff.mp hE
        have hsx : s.1 x = a := z.2.symm.trans (hsa z.1)
        rw [hsx]
    have hψ_zero : ∀ (T : Γ.Etale), ψ_inv_fun T 0 = 0 := by
      intro T
      have h1 := hChar_psi (𝟙 T) 0 0 (fun h0 => False.elim (h0 rfl)) (fun _ => rfl)
      have hid : L_j.obj.map (𝟙 T).op = 𝟙 _ := L_j.obj.map_id (Opposite.op T)
      rw [hid] at h1
      exact h1.trans (h_locModel_zero T)
    have hψ_add : ∀ (T : Γ.Etale) (s₁ s₂ : ↥(weilAltZeroBdrySubgroup Γ V n T)),
        ψ_inv_fun T (s₁ + s₂) = ψ_inv_fun T s₁ + ψ_inv_fun T s₂ := by
      intro T s₁ s₂
      rw [← h_evOne_toHom (L_j.obj.obj (Opposite.op T)) (ψ_inv_fun T (s₁ + s₂)),
          ← h_evOne_toHom (L_j.obj.obj (Opposite.op T)) (ψ_inv_fun T s₁ + ψ_inv_fun T s₂)]
      congr 1
      let O₁₂ : ↥T.left → T.left.Opens := fun x =>
        ⟨s₁.1 ⁻¹' {s₁.1 x} ∩ s₂.1 ⁻¹' {s₂.1 x},
          (s₁.1.isLocallyConstant {s₁.1 x}).inter (s₂.1.isLocallyConstant {s₂.1 x})⟩
      let W₁₂ : ↥T.left → Γ.Etale := fun x => openEtaleObj T (O₁₂ x)
      let κ₁₂ : ∀ x : ↥T.left, W₁₂ x ⟶ T := fun x => openEtaleHom T (O₁₂ x)
      apply L_j.2.hom_ext_ofArrows κ₁₂ (hOpenArrowsCov T O₁₂ (fun x => ⟨x, ⟨rfl, rfl⟩⟩))
      intro x
      have ha₁ : s₁.1 x ≠ 0 → Set.range ⇑(W₁₂ x).hom ⊆ (V : Set ↥Γ) := by
        rintro hne p ⟨y, hy⟩
        subst hy
        by_contra hnot
        exact hne (y.2.1.symm.trans (s₁.2 y.1 hnot))
      have ha₂ : s₂.1 x ≠ 0 → Set.range ⇑(W₁₂ x).hom ⊆ (V : Set ↥Γ) := by
        rintro hne p ⟨y, hy⟩
        subst hy
        by_contra hnot
        exact hne (y.2.2.symm.trans (s₂.2 y.1 hnot))
      have ha₁₂ : s₁.1 x + s₂.1 x ≠ 0 → Set.range ⇑(W₁₂ x).hom ⊆ (V : Set ↥Γ) := by
        rintro hne p ⟨y, hy⟩
        subst hy
        by_contra hnot
        exact hne ((congrArg₂ (· + ·) y.2.1 y.2.2).symm.trans ((s₁ + s₂).2 y.1 hnot))
      rw [h_toHom_add, Preadditive.add_comp, h_toHom_comp, h_toHom_comp, h_toHom_comp,
          hChar_psi (κ₁₂ x) (s₁ + s₂) (s₁.1 x + s₂.1 x) ha₁₂
            (fun y => congrArg₂ (· + ·) y.2.1 y.2.2),
          hChar_psi (κ₁₂ x) s₁ (s₁.1 x) ha₁ (fun y => y.2.1),
          hChar_psi (κ₁₂ x) s₂ (s₂.1 x) ha₂ (fun y => y.2.2)]
      exact (congrArg (toHom _)
        (h_locModel_add (W₁₂ x) (s₁.1 x) (s₂.1 x) ha₁ ha₂)).trans
        (h_toHom_add _ _ _)
    let ψ_inv : K_V ⟶ L_j :=
      CategoryTheory.ObjectProperty.homMk
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := ψ_inv_fun (Opposite.unop U)
              map_zero' := hψ_zero (Opposite.unop U)
              map_add' := hψ_add (Opposite.unop U) }
          naturality := fun {U₁ U₂} u => by
            apply AddCommGrpCat.ext
            intro s
            let T := Opposite.unop U₁
            let T' := Opposite.unop U₂
            let s' : ↥(weilAltZeroBdrySubgroup Γ V n T') := (K_V.obj.map u).hom s
            change ψ_inv_fun T' s' = (L_j.obj.map u).hom (ψ_inv_fun T s)
            rw [← h_evOne_toHom (L_j.obj.obj (Opposite.op T')) (ψ_inv_fun T' s'),
                ← h_evOne_toHom (L_j.obj.obj (Opposite.op T'))
                  ((L_j.obj.map u).hom (ψ_inv_fun T s))]
            congr 1
            let W' : ↥T'.left → Γ.Etale := fun x' => openEtaleObj T' (O_lvl_K T' s' x')
            let κ' : ∀ x' : ↥T'.left, W' x' ⟶ T' := fun x' => openEtaleHom T' (O_lvl_K T' s' x')
            apply L_j.2.hom_ext_ofArrows κ' (hOpenArrowsCov T' (O_lvl_K T' s') (fun x' => ⟨x', rfl⟩))
            intro x'
            have hu_op : u ≫ (κ' x').op = (κ' x' ≫ u.unop).op := rfl
            rw [h_toHom_comp, ← h_toHom_comp (ψ_inv_fun T s) (L_j.obj.map u),
                CategoryTheory.Category.assoc, ← L_j.obj.map_comp, hu_op, h_toHom_comp,
                hChar_psi (κ' x') s' (s'.1 x') (ha_lvl T' s' x') (fun y => y.2)]
            exact congrArg (toHom _)
              (hChar_psi (κ' x' ≫ u.unop) s (s'.1 x') (ha_lvl T' s' x') (fun y => y.2)).symm }
    have hψ_hom_inv : ψ_hom ≫ ψ_inv = 𝟙 L_j := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeComp, hψ_equiv]
      apply AddCommGrpCat.ext
      intro a
      change ψ_inv_fun U_j (c0_j.hom a) = η_free.hom a
      have hr_Uj : Set.range ⇑U_j.hom ⊆ (V : Set ↥Γ) := by
        rw [@AlgebraicGeometry.Scheme.Hom.coe_opensRange _ _ j hOpen]
        exact le_refl _
      have h1 := hChar_psi (𝟙 U_j) (c0_j.hom a) a (fun _ => hr_Uj) (fun _ => rfl)
      have hid : L_j.obj.map (𝟙 U_j).op = 𝟙 _ := L_j.obj.map_id (Opposite.op U_j)
      rw [hid] at h1
      have h2 : locModel U_j a = (L_j.obj.map (liftHom U_j hr_Uj).op).hom (η_free.hom a) :=
        h_locModel_pos U_j a hr_Uj
      have h3 : (liftHom U_j hr_Uj).op = (𝟙 U_j).op :=
        congrArg Quiver.Hom.op (h_Uj_sub (liftHom U_j hr_Uj) (𝟙 U_j))
      rw [h3, hid] at h2
      exact h1.trans h2
    have hψ_inv_hom : ψ_inv ≫ ψ_hom = 𝟙 K_V := by
      let toSub : ∀ {W : Γ.Etale}, ↥(K_V.obj.obj (Opposite.op W)) →
          ↥(weilAltZeroBdrySubgroup Γ V n W) := fun k => k
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro s
      refine Subtype.ext (LocallyConstant.ext (fun x => ?_))
      let T := Opposite.unop U
      let s_sub : ↥(weilAltZeroBdrySubgroup Γ V n T) := s
      let κ_x : openEtaleObj T (O_lvl_K T s_sub x) ⟶ T := openEtaleHom T (O_lvl_K T s_sub x)
      let y₀ : ↥(openEtaleObj T (O_lvl_K T s_sub x)).left := ⟨x, rfl⟩
      have hnat := ψ_hom.hom.naturality κ_x.op
      have happ : (toSub ((ψ_hom.hom.app (Opposite.op (openEtaleObj T (O_lvl_K T s_sub x)))).hom
            ((L_j.obj.map κ_x.op).hom (ψ_inv_fun T s_sub)))).1 y₀ =
          (toSub ((ψ_hom.hom.app (Opposite.op T)).hom (ψ_inv_fun T s_sub))).1 x :=
        congrArg
          (fun (φ : L_j.obj.obj (Opposite.op T) ⟶
              K_V.obj.obj (Opposite.op (openEtaleObj T (O_lvl_K T s_sub x)))) =>
            (toSub (φ.hom (ψ_inv_fun T s_sub))).1 y₀) hnat
      change (toSub ((ψ_hom.hom.app (Opposite.op T)).hom (ψ_inv_fun T s_sub))).1 x = s_sub.1 x
      rw [← happ, hChar_psi κ_x s_sub (s_sub.1 x) (ha_lvl T s_sub x) (fun y => y.2)]
      exact congrArg (fun (k : LocallyConstant _ _) => k y₀)
        (h_ψ_locModel (openEtaleObj T (O_lvl_K T s_sub x)) (s_sub.1 x) (ha_lvl T s_sub x))
    exact ⟨⟨ψ_hom, ψ_inv, hψ_hom_inv, hψ_inv_hom⟩, hψ_counit⟩

  
  
  
  let ι_0 : K_V ⟶ L_Γ := CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι Γ V n)
  let ρ_loc : L_Γ ⟶ P_push_Z.obj L_Z :=
    CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_Z n)
  have hStep3 : ∃ (h0_loc : ι_0 ≫ ρ_loc = 0),
      (CategoryTheory.ShortComplex.mk ι_0 ρ_loc h0_loc).ShortExact := by
    let B_Z := weilEtaleSitePullback i_Z
    have hRange_iZ : Set.range ⇑i_Z = (V : Set ↥Γ)ᶜ :=
      (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_Z).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal
          ⟨(V : Set ↥Γ)ᶜ, V.isOpen.isClosed_compl⟩)
    have hRange_pb : ∀ (U : Γ.Etale) (x : ↥U.left),
        x ∈ Set.range ⇑(CategoryTheory.Limits.pullback.fst U.hom i_Z) ↔
          U.hom x ∉ (V : Set ↥Γ) := by
      intro U x
      constructor
      · rintro ⟨y, rfl⟩
        have hcond : U.hom (CategoryTheory.Limits.pullback.fst U.hom i_Z y) =
            i_Z (CategoryTheory.Limits.pullback.snd U.hom i_Z y) := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.Limits.pullback.condition,
              AlgebraicGeometry.Scheme.Hom.comp_apply]
        have hmem : U.hom (CategoryTheory.Limits.pullback.fst U.hom i_Z y) ∈ Set.range ⇑i_Z :=
          ⟨_, hcond.symm⟩
        rw [hRange_iZ] at hmem
        exact hmem
      · intro hx
        have hmem : U.hom x ∈ Set.range ⇑i_Z := by rwa [hRange_iZ]
        obtain ⟨z, hz⟩ := hmem
        obtain ⟨y, hy, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x z hz.symm
        exact ⟨y, hy⟩
    have h0_loc : ι_0 ≫ ρ_loc = 0 := by
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro s
      refine LocallyConstant.ext (fun y => ?_)
      let T := Opposite.unop U
      exact (s : ↥(weilAltZeroBdrySubgroup Γ V n T)).2
        (CategoryTheory.Limits.pullback.fst T.hom i_Z y)
        ((hRange_pb T _).mp ⟨y, rfl⟩)
    have hMono_ι0 : CategoryTheory.Mono ι_0 :=
      ⟨fun {W} g₁ g₂ heq =>
        CategoryTheory.ObjectProperty.hom_ext _
          (CategoryTheory.NatTrans.ext (funext fun U =>
            AddCommGrpCat.ext fun w =>
              Subtype.ext (congrArg (fun (φ : W ⟶ L_Γ) => (φ.hom.app U).hom w) heq)))⟩
    have hKer : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι ι_0 h0_loc) := by
      let toLC_Z : ∀ {U : Γ.Etaleᵒᵖ}, ↥((P_push_Z.obj L_Z).obj.obj U) →
          LocallyConstant ↥(B_Z.obj (Opposite.unop U)).left (ULift.{u} (ZMod n)) := fun k => k
      let lift_fn : ∀ {W : CategoryTheory.Sheaf Γ.smallEtaleTopology AddCommGrpCat.{u}}
          (g' : W ⟶ L_Γ), g' ≫ ρ_loc = 0 → (W ⟶ K_V) := fun {W} g' hg' =>
        CategoryTheory.ObjectProperty.homMk
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := fun w =>
                  ⟨(g'.hom.app U).hom w, by
                    intro x hx
                    obtain ⟨y, rfl⟩ := (hRange_pb (Opposite.unop U) x).mpr hx
                    have hzero : toLC_Z (((g' ≫ ρ_loc).hom.app U).hom w) y =
                        toLC_Z (((0 : W ⟶ P_push_Z.obj L_Z).hom.app U).hom w) y :=
                      congrArg (fun (φ : W ⟶ P_push_Z.obj L_Z) => toLC_Z ((φ.hom.app U).hom w) y)
                        hg'
                    exact hzero⟩
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun a b => Subtype.ext (map_add _ a b) }
            naturality := fun {U₁ U₂} u =>
              AddCommGrpCat.ext fun w =>
                Subtype.ext (congrArg (fun φ => φ.hom w) (g'.hom.naturality u)) }
      have hlift_fac : ∀ {W : CategoryTheory.Sheaf Γ.smallEtaleTopology AddCommGrpCat.{u}}
          (g' : W ⟶ L_Γ) (hg' : g' ≫ ρ_loc = 0), lift_fn g' hg' ≫ ι_0 = g' :=
        fun _ _ => CategoryTheory.ObjectProperty.hom_ext _
          (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
      exact CategoryTheory.Limits.KernelFork.IsLimit.ofι ι_0 h0_loc
        (fun g' hg' => lift_fn g' hg')
        (fun g' hg' => hlift_fac g' hg')
        (fun g' hg' m hm => hMono_ι0.right_cancellation m (lift_fn g' hg')
          (hm.trans (hlift_fac g' hg').symm))
    have hExact : (CategoryTheory.ShortComplex.mk ι_0 ρ_loc h0_loc).Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer
    have hLocSurj : CategoryTheory.Sheaf.IsLocallySurjective ρ_loc := by
      apply CategoryTheory.Presheaf.IsLocallySurjective.mk
      intro U s₀
      rw [hMemEtale]
      intro x
      let ι'_U : (B_Z.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom i_Z
      have hCl_ι : AlgebraicGeometry.IsClosedImmersion ι'_U :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback U.hom I_Z.subschemeι).flip
          (inferInstance : AlgebraicGeometry.IsClosedImmersion I_Z.subschemeι)
      have hCl : Topology.IsClosedEmbedding ⇑ι'_U :=
        @AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding _ _ ι'_U hCl_ι
      let s₀_lc : LocallyConstant ↥(B_Z.obj U).left (ULift.{u} (ZMod n)) := s₀
      by_cases hx : x ∈ Set.range ⇑ι'_U
      · obtain ⟨z₀, hz₀⟩ := hx
        let a₀ := s₀_lc z₀
        obtain ⟨t_open, ht_open, ht_pre⟩ :=
          hCl.isInducing.isOpen_iff.mp (s₀_lc.isLocallyConstant {a₀})
        have hx_t : x ∈ t_open := by
          rw [← hz₀]
          change z₀ ∈ ⇑ι'_U ⁻¹' t_open
          rw [ht_pre]
          rfl
        let O_x : U.left.Opens := ⟨t_open, ht_open⟩
        let Y_x : Γ.Etale := openEtaleObj U O_x
        let f_x : Y_x ⟶ U := openEtaleHom U O_x
        refine ⟨Y_x, f_x, ⟨x, hx_t⟩, ?_, hEtaleLeft f_x, rfl⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        refine ⟨LocallyConstant.const ↥Y_x.left a₀, LocallyConstant.ext (fun w => ?_)⟩
        have hmap_fst : (B_Z.map f_x).left ≫ ι'_U =
            CategoryTheory.Limits.pullback.fst Y_x.hom i_Z ≫ O_x.ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hw_mem : ((B_Z.map f_x).left w : ↥(B_Z.obj U).left) ∈ ⇑ι'_U ⁻¹' t_open := by
          change ι'_U ((B_Z.map f_x).left w) ∈ t_open
          have hw_eq := congrArg (fun (k : (B_Z.obj Y_x).left ⟶ U.left) => k w) hmap_fst
          change ι'_U ((B_Z.map f_x).left w) =
            O_x.ι (CategoryTheory.Limits.pullback.fst Y_x.hom i_Z w) at hw_eq
          rw [hw_eq]
          exact (CategoryTheory.Limits.pullback.fst Y_x.hom i_Z w).2
        have hw_pre : s₀_lc ((B_Z.map f_x).left w) = a₀ :=
          (Set.ext_iff.mp ht_pre ((B_Z.map f_x).left w)).mp hw_mem
        exact hw_pre.symm
      · let O_c : U.left.Opens := ⟨(Set.range ⇑ι'_U)ᶜ, hCl.isClosed_range.isOpen_compl⟩
        let Y_c : Γ.Etale := openEtaleObj U O_c
        let f_c : Y_c ⟶ U := openEtaleHom U O_c
        refine ⟨Y_c, f_c, ⟨x, hx⟩, ?_, hEtaleLeft f_c, rfl⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        refine ⟨0, LocallyConstant.ext (fun w => ?_)⟩
        have hmap_fst : (B_Z.map f_c).left ≫ ι'_U =
            CategoryTheory.Limits.pullback.fst Y_c.hom i_Z ≫ O_c.ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hw_eq := congrArg (fun (k : (B_Z.obj Y_c).left ⟶ U.left) => k w) hmap_fst
        change ι'_U ((B_Z.map f_c).left w) =
          O_c.ι (CategoryTheory.Limits.pullback.fst Y_c.hom i_Z w) at hw_eq
        exact False.elim ((CategoryTheory.Limits.pullback.fst Y_c.hom i_Z w).2
          ⟨(B_Z.map f_c).left w, hw_eq⟩)
    have hEpi_ρ : CategoryTheory.Epi ρ_loc :=
      @CategoryTheory.Sheaf.epi_of_isLocallySurjective _ _ _ _ _ _ _ _ _ _ _ ρ_loc inferInstance
        hLocSurj
    exact ⟨h0_loc, @CategoryTheory.ShortComplex.ShortExact.mk _ _ _ _ hExact hMono_ι0 hEpi_ρ⟩

  
  
  
  obtain ⟨Ψ_j, hΨ_j⟩ := hStep2
  obtain ⟨h0_loc, hSE_loc⟩ := hStep3
  have hEq_fwd : ε_j ≫ Φ_Γ.hom = Ψ_j.hom ≫ ι_0 := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hFreeComp, hFreeComp]
    have hε : CategoryTheory.Sheaf.freeYonedaHomEquiv ε_j =
        (((CategoryTheory.sheafificationAdjunction Γ.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Γ.Etale)).obj A_n)).app (Opposite.op U_j) :
          A_n ⟶ (weilEtaleTorsionSheaf Γ n).obj.obj (Opposite.op U_j)) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    exact (congrArg (· ≫ Φ_Γ.hom.hom.app (Opposite.op U_j)) hε).trans
      ((hΦ_Γ U_j).trans hΨ_j.symm)
  have hComm1 : Ψ_j.symm.hom ≫ ε_j = ι_0 ≫ Φ_Γ.symm.hom := by
    change Ψ_j.inv ≫ ε_j = ι_0 ≫ Φ_Γ.inv
    rw [← CategoryTheory.Category.comp_id (Ψ_j.inv ≫ ε_j), ← Φ_Γ.hom_inv_id,
        ← CategoryTheory.Category.assoc, CategoryTheory.Category.assoc Ψ_j.inv,
        hEq_fwd, ← CategoryTheory.Category.assoc, Ψ_j.inv_hom_id,
        CategoryTheory.Category.id_comp]
  let ρ_Z : Quiver.Hom (weilEtaleTorsionSheaf Γ n)
      (P_push_Z.obj (weilEtaleTorsionSheaf Z n)) :=
    Φ_Γ.hom ≫ ρ_loc ≫ P_push_Z.map Φ_Z.inv
  have h0 : CategoryTheory.CategoryStruct.comp ε_j ρ_Z = 0 := by
    dsimp only [ρ_Z]
    rw [← CategoryTheory.Category.assoc ε_j, hEq_fwd,
        CategoryTheory.Category.assoc Ψ_j.hom,
        ← CategoryTheory.Category.assoc ι_0, h0_loc,
        CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
  have hComm2 : Φ_Γ.symm.hom ≫ ρ_Z = ρ_loc ≫ (P_push_Z.mapIso Φ_Z.symm).hom := by
    change Φ_Γ.inv ≫ (Φ_Γ.hom ≫ ρ_loc ≫ P_push_Z.map Φ_Z.inv) =
      ρ_loc ≫ P_push_Z.map Φ_Z.inv
    exact Φ_Γ.inv_hom_id_assoc _
  let e_SC : CategoryTheory.ShortComplex.mk ι_0 ρ_loc h0_loc ≅
      CategoryTheory.ShortComplex.mk ε_j ρ_Z h0 :=
    CategoryTheory.ShortComplex.isoMk Ψ_j.symm Φ_Γ.symm (P_push_Z.mapIso Φ_Z.symm)
      hComm1 hComm2
  exact ⟨ρ_Z, h0, CategoryTheory.ShortComplex.shortExact_of_iso e_SC hSE_loc⟩

theorem weil_gysin_closed_immersion_etale_pushforward_exact (Z Γ : AlgebraicGeometry.Scheme.{u}) (i_Z : Quiver.Hom Z Γ)
    [AlgebraicGeometry.IsClosedImmersion i_Z]
    (hCont : (weilAltCdSitePullback i_Z).IsContinuous
      Γ.smallEtaleTopology Z.smallEtaleTopology) :
    letI := hCont
    let P_push_Z := (weilAltCdSitePullback i_Z).sheafPushforwardContinuous
      AddCommGrpCat.{u} Γ.smallEtaleTopology Z.smallEtaleTopology
    CategoryTheory.Limits.PreservesFiniteLimits P_push_Z ∧
    CategoryTheory.Limits.PreservesFiniteColimits P_push_Z :=
by
  classical
  letI := hCont
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  letI : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  letI : P_et.HasPullbacksAlong i_Z :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : P_et.IsStableUnderBaseChangeAlong i_Z :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_Z := weilAltCdSitePullback i_Z
  let P_push_Z := B_Z.sheafPushforwardContinuous
    AddCommGrpCat.{u} Γ.smallEtaleTopology Z.smallEtaleTopology
  change CategoryTheory.Limits.PreservesFiniteLimits P_push_Z ∧
    CategoryTheory.Limits.PreservesFiniteColimits P_push_Z
  have hBZ_fst : ∀ {V U' : Γ.Etale} (g : Quiver.Hom V U'),
      (B_Z.map g).left ≫ CategoryTheory.Limits.pullback.fst U'.hom i_Z =
      CategoryTheory.Limits.pullback.fst V.hom i_Z ≫ g.left := by
    intro V U' g
    have hm : (B_Z.map g).left =
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst V.hom i_Z ≫ g.left)
          (CategoryTheory.Limits.pullback.snd V.hom i_Z)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.fst V.hom i_Z ≫ ·) g.w).trans
              (CategoryTheory.Limits.pullback.condition (f := V.hom) (g := i_Z)))) :=
      CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ i_Z g
    exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst U'.hom i_Z) hm).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
  
  have hAffLift : ∀ (A A_Z B_Z : Type u) [CommRing A] [CommRing A_Z] [CommRing B_Z]
      (π : A →+* A_Z) (f_Z : A_Z →+* B_Z),
      Function.Surjective π → RingHom.Etale f_Z →
      ∃ (B_A : Type u) (instBA : CommRing B_A) (g_A : A →+* B_A) (π_B : B_A →+* B_Z),
        letI := instBA
        RingHom.Etale g_A ∧
        Function.Surjective π_B ∧
        π_B.comp g_A = f_Z.comp π ∧
        CategoryTheory.IsPushout
          (CommRingCat.ofHom g_A) (CommRingCat.ofHom π)
          (CommRingCat.ofHom π_B) (CommRingCat.ofHom f_Z) := by
    intro A A_Z B_Z _ _ _ π f_Z hπ hf_Z
    letI : Algebra A_Z B_Z := f_Z.toAlgebra
    have hEt_AZ_BZ : Algebra.Etale A_Z B_Z :=
      (RingHom.etale_algebraMap (R := A_Z) (S := B_Z)).mp hf_Z
    have hStd_Z : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z :=
      (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero
        (R := A_Z) (S := B_Z)).mp hEt_AZ_BZ
    rcases hStd_Z with ⟨⟨ι₀, σ₀, hFin_σ₀, hFin_ι₀, P₀, hdim₀⟩⟩
    letI : Finite σ₀ := hFin_σ₀
    letI : Finite ι₀ := hFin_ι₀
    obtain ⟨n_v, ⟨e_v⟩⟩ := Finite.exists_equiv_fin ι₀
    obtain ⟨n_r, ⟨e_r⟩⟩ := Finite.exists_equiv_fin σ₀
    have hle₁ : n_v ≤ n_r := by
      have hsub : Nat.card ι₀ - Nat.card σ₀ = 0 := hdim₀
      rw [Nat.card_congr e_v, Nat.card_congr e_r, Nat.card_fin, Nat.card_fin] at hsub
      omega
    have hle₂ : n_r ≤ n_v := by
      have hinj : Function.Injective (fun i : Fin n_r => e_v (P₀.map (e_r.symm i))) :=
        e_v.injective.comp (P₀.map_inj.comp e_r.symm.injective)
      have hcard := Fintype.card_le_of_injective _ hinj
      simpa only [Fintype.card_fin] using hcard
    have hn_eq : n_r = n_v := Nat.le_antisymm hle₂ hle₁
    subst hn_eq
    let n := n_r
    let P_Z : Algebra.SubmersivePresentation A_Z B_Z (Fin n) (Fin n) :=
      P₀.reindex e_v.symm e_r.symm
    have hmap_surj : Function.Surjective
        (MvPolynomial.map π : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) A_Z) :=
      MvPolynomial.map_surjective π hπ
    choose rel_A hrel_A using fun c : Fin n => hmap_surj (P_Z.relation c)
    let I_A : Ideal (MvPolynomial (Fin n) A) := Ideal.span (Set.range rel_A)
    let Q_A : Type u := MvPolynomial (Fin n) A ⧸ I_A
    let P_Q : Algebra.PreSubmersivePresentation A Q_A (Fin n) (Fin n) :=
      Algebra.PreSubmersivePresentation.naive (v := rel_A) P_Z.map P_Z.map_inj
    let j_Q : Q_A := P_Q.jacobian
    let B_A : Type u := Localization.Away j_Q
    let g_A : A →+* B_A := algebraMap A B_A
    let Q_loc : Algebra.PreSubmersivePresentation Q_A B_A Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
    let P_tot : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ Fin n) (Unit ⊕ Fin n) :=
      Q_loc.comp P_Q
    have hdim_tot : P_tot.dimension = 0 := by
      change Nat.card (Unit ⊕ Fin n) - Nat.card (Unit ⊕ Fin n) = 0
      exact Nat.sub_self _
    have hUnit_tot : IsUnit P_tot.jacobian := by
      dsimp [P_tot]
      rw [Q_loc.comp_jacobian_eq_jacobian_smul_jacobian P_Q]
      dsimp [Q_loc]
      rw [Algebra.PreSubmersivePresentation.localizationAway_jacobian (S := B_A) j_Q,
        Algebra.smul_def]
      exact (IsLocalization.Away.algebraMap_isUnit (S := B_A) j_Q).mul
        (IsLocalization.Away.algebraMap_isUnit (S := B_A) j_Q)
    let P_sub_tot : Algebra.SubmersivePresentation A B_A (Unit ⊕ Fin n) (Unit ⊕ Fin n) :=
      ⟨P_tot, hUnit_tot⟩
    have hStd_BA : Algebra.IsStandardSmoothOfRelativeDimension 0 A B_A :=
      ⟨⟨Unit ⊕ Fin n, Unit ⊕ Fin n, inferInstance, inferInstance, P_sub_tot, hdim_tot⟩⟩
    have hEt_A_BA : Algebra.Etale A B_A :=
      (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero (R := A) (S := B_A)).mpr hStd_BA
    have hg_A_et : RingHom.Etale g_A :=
      (RingHom.etale_algebraMap (R := A) (S := B_A)).mpr hEt_A_BA
    let ev_Z : MvPolynomial (Fin n) A_Z →+* B_Z := (MvPolynomial.aeval P_Z.val).toRingHom
    have hev_Z_alg : (algebraMap P_Z.Ring B_Z : MvPolynomial (Fin n) A_Z →+* B_Z) = ev_Z :=
      RingHom.ext P_Z.algebraMap_apply
    let ψ₀ : MvPolynomial (Fin n) A →+* B_Z := ev_Z.comp (MvPolynomial.map π)
    have h_vanish : I_A ≤ RingHom.ker ψ₀ := by
      rw [Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      change ev_Z (MvPolynomial.map π (rel_A c)) = 0
      rw [hrel_A c]
      exact P_Z.aeval_val_eq_zero (P_Z.relation_mem_ker c)
    let q₀ : Q_A →+* B_Z := Ideal.Quotient.lift I_A ψ₀ h_vanish
    have halg_PQ : (algebraMap P_Q.Ring Q_A : MvPolynomial (Fin n) A →+* Q_A) =
        Ideal.Quotient.mk I_A := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [P_Q.algebraMap_apply, MvPolynomial.aeval_C]
        rfl
      · intro i
        rw [P_Q.algebraMap_apply, MvPolynomial.aeval_X]
        rfl
    have hmat_eq : (MvPolynomial.map π).mapMatrix P_Q.jacobiMatrix = P_Z.jacobiMatrix := by
      apply Matrix.ext
      intro i j
      change MvPolynomial.map π (P_Q.jacobiMatrix i j) = P_Z.jacobiMatrix i j
      rw [P_Q.jacobiMatrix_apply, P_Z.jacobiMatrix_apply]
      have hmap_i : P_Q.map i = P_Z.map i := rfl
      have hrel_j : P_Q.relation j = rel_A j := rfl
      rw [hmap_i, hrel_j, ← MvPolynomial.pderiv_map, hrel_A j]
    have hq₀_jac : q₀ j_Q = P_Z.jacobian := by
      dsimp [j_Q]
      rw [P_Q.jacobian_eq_jacobiMatrix_det, P_Z.jacobian_eq_jacobiMatrix_det,
        halg_PQ, hev_Z_alg]
      change ev_Z (MvPolynomial.map π P_Q.jacobiMatrix.det) = ev_Z P_Z.jacobiMatrix.det
      rw [RingHom.map_det (MvPolynomial.map π) P_Q.jacobiMatrix, hmat_eq]
    have hq₀_unit : IsUnit (q₀ j_Q) := hq₀_jac.symm ▸ P_Z.jacobian_isUnit
    let π_B : B_A →+* B_Z := IsLocalization.Away.lift j_Q (S := B_A) hq₀_unit
    have hcomm_ring : π_B.comp g_A = f_Z.comp π := by
      ext a
      have hg_a : g_A a = algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)) := by
        dsimp [g_A]
        rw [IsScalarTower.algebraMap_apply A Q_A B_A a]
        rfl
      simp only [RingHom.comp_apply, hg_a]
      rw [IsLocalization.Away.lift_eq (S := B_A) j_Q hq₀_unit]
      change ev_Z (MvPolynomial.map π (MvPolynomial.C a)) = f_Z (π a)
      rw [MvPolynomial.map_C]
      exact MvPolynomial.aeval_C P_Z.val (π a)
    have hπ_B_surj : Function.Surjective π_B := by
      intro b
      obtain ⟨p_Z, hp_Z⟩ := P_Z.aeval_val_surjective b
      obtain ⟨p_A, hp_A⟩ := hmap_surj p_Z
      refine ⟨algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A), ?_⟩
      rw [IsLocalization.Away.lift_eq (S := B_A) j_Q hq₀_unit]
      change ev_Z (MvPolynomial.map π p_A) = b
      rw [hp_A]
      exact hp_Z
    have hcomm_cat :
        CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom g_A) (CommRingCat.ofHom π_B) =
        CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom π) (CommRingCat.ofHom f_Z) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm_ring]
    have hCocone : ∀ (s : CategoryTheory.Limits.PushoutCocone
          (CommRingCat.ofHom g_A) (CommRingCat.ofHom π)),
        ∃ u : CommRingCat.of B_Z ⟶ s.pt,
          CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom π_B) u = s.inl ∧
          CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_Z) u = s.inr := by
      intro s
      let x_B : Fin n → B_A := fun i =>
        algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.X i))
      let φ_poly : MvPolynomial (Fin n) A_Z →+* ↑s.pt :=
        MvPolynomial.eval₂Hom s.inr.hom (fun i => s.inl.hom (x_B i))
      have hs_eq : s.inl.hom.comp g_A = s.inr.hom.comp π := by
        have hw := congrArg CommRingCat.Hom.hom s.condition
        simpa [CommRingCat.hom_comp] using hw
      have hφ_comp : φ_poly.comp (MvPolynomial.map π) =
          s.inl.hom.comp ((algebraMap Q_A B_A).comp (Ideal.Quotient.mk I_A)) := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, MvPolynomial.map_C, φ_poly, MvPolynomial.eval₂Hom_C]
          have h1 : s.inr.hom (π a) = s.inl.hom (g_A a) := RingHom.congr_fun hs_eq.symm a
          have hg_a : g_A a = algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)) :=
            IsScalarTower.algebraMap_apply A Q_A B_A a
          exact h1.trans (congrArg s.inl.hom hg_a)
        · intro i
          simp only [RingHom.comp_apply, MvPolynomial.map_X, φ_poly,
            MvPolynomial.eval₂Hom_X', x_B]
      have hker_φ : RingHom.ker ev_Z ≤ RingHom.ker φ_poly := by
        have hspan : Ideal.span (Set.range P_Z.relation) = RingHom.ker ev_Z :=
          P_Z.span_range_relation_eq_ker.trans (congrArg RingHom.ker hev_Z_alg)
        rw [← hspan, Ideal.span_le]
        rintro _ ⟨c, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, ← hrel_A c]
        have h1 := RingHom.congr_fun hφ_comp (rel_A c)
        simp only [RingHom.comp_apply] at h1
        have hc_mem : rel_A c ∈ I_A := Ideal.subset_span ⟨c, rfl⟩
        rw [h1, Ideal.Quotient.eq_zero_iff_mem.mpr hc_mem, map_zero, map_zero]
      let e_quot : (MvPolynomial (Fin n) A_Z ⧸ RingHom.ker ev_Z) ≃+* B_Z :=
        RingHom.quotientKerEquivOfSurjective P_Z.aeval_val_surjective
      let u_hom : B_Z →+* ↑s.pt :=
        (Ideal.Quotient.lift (RingHom.ker ev_Z) φ_poly hker_φ).comp e_quot.symm.toRingHom
      have hu_ev : ∀ p : MvPolynomial (Fin n) A_Z, u_hom (ev_Z p) = φ_poly p := by
        intro p
        have he_mk : e_quot (Ideal.Quotient.mk (RingHom.ker ev_Z) p) = ev_Z p := rfl
        have hsymm : e_quot.symm (ev_Z p) = Ideal.Quotient.mk (RingHom.ker ev_Z) p := by
