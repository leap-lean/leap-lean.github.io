    have hq' : q = u_X.hom ≫ Φ.functor.map w ≫ θ.inv := by
      rw [← CategoryTheory.Category.assoc, ← hqθ, CategoryTheory.Category.assoc,
        θ.hom_inv_id, CategoryTheory.Category.comp_id]
    have hnat := Φ.unitIso.hom.naturality w
    dsimp at hnat
    rw [hq', Φ.inverse.map_comp, Φ.inverse.map_comp]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc w, hnat]
    simp only [CategoryTheory.Category.assoc, Φ.unitIso.inv_hom_id_app_assoc]

