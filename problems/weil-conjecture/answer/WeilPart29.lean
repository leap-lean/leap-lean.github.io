        rw [hcounit_nat, ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
          CategoryTheory.Category.id_comp]
      rw [hψ_eq]
      infer_instance
    · 
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let adj_const := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
      let Γ_T := CategoryTheory.sheafSections J AddCommGrpCat.{u}
      refine CategoryTheory.Projective.mk (fun {E X} f e => ?_)
      intro hEpi
      let e_T := e.hom.app (Opposite.op T)
      let M_coker := CategoryTheory.Limits.cokernel e_T
      let π_coker := CategoryTheory.Limits.cokernel.π e_T
      let q_mor : X ⟶ SkyObj M_coker :=
        { hom :=
            { app := fun W => AddCommGrpCat.ofHom
                { toFun := fun s τ => π_coker.hom ((X.obj.map τ.op).hom s)
                  map_zero' := by
                    funext τ
                    simp
                  map_add' := fun s₁ s₂ => by
                    funext τ
                    simp }
              naturality := fun {W₁ W₂} u => by
                ext s τ
                change π_coker.hom ((X.obj.map τ.op).hom ((X.obj.map u).hom s)) =
                  π_coker.hom ((X.obj.map (τ ≫ u.unop).op).hom s)
                rw [op_comp, X.obj.map_comp]
