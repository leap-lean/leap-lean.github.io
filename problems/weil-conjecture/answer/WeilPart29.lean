    obtain ⟨hc_s2, hr_s2, ⟨e_pbc2⟩⟩ := hPBC_sec s hs 2
    obtain rfl : _hc_s = hc_s2 := Subsingleton.elim _ _
    obtain rfl : _hr_s = hr_s2 := Subsingleton.elim _ _
    obtain ⟨eq_cod1⟩ := hIsoH0 (pb_s.mapIso e_R1_R2 ≪≫ e_pbc2)
    obtain ⟨eq_cod2⟩ := hSk_H0_equiv P1.left P1.hom F_P1 2
    have hCard_cod : Nat.card ((pb_s.obj (weilEtaleHigherDirectImage f 1 Q₁)).H 0) = ℓ := by
      rw [Nat.card_congr (eq_cod1.trans eq_cod2).toEquiv]
