  have h_s9_poly_laurent_units :
      (IsDomain (Polynomial k) ∧ IsPrincipalIdealRing (Polynomial k) ∧ ¬ IsField (Polynomial k)) ∧
      (IsDomain (LaurentPolynomial k) ∧
        IsPrincipalIdealRing (LaurentPolynomial k) ∧
        ¬ IsField (LaurentPolynomial k)) ∧
      (∀ (m : ℕ), 1 ≤ m →
        ∀ x : Additive (Units (Polynomial k)),
          ∃ y : Additive (Units (Polynomial k)), m • y = x) ∧
      (∃ ord : Additive (Units (LaurentPolynomial k)) →+ ℤ,
        ord (Additive.ofMul (LaurentPolynomial.isUnit_T (R := k) 1).unit) = 1 ∧
        ∀ (m : ℕ), 1 ≤ m →
          ∀ x : Additive (Units (LaurentPolynomial k)),
            (∃ y : Additive (Units (LaurentPolynomial k)), m • y = x) ↔
              (m : ℤ) ∣ ord x) := by
    have hNF_poly : ¬ IsField (Polynomial k) := Polynomial.not_isField k
    have hX_nzd : Submonoid.powers (Polynomial.X : Polynomial k) ≤ nonZeroDivisors (Polynomial k) :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero)
    have hDom_laurent : IsDomain (LaurentPolynomial k) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (LaurentPolynomial k) hX_nzd
    haveI : IsDomain (LaurentPolynomial k) := hDom_laurent
    let φ_L : Polynomial k →+* LaurentPolynomial k :=
      algebraMap (Polynomial k) (LaurentPolynomial k)
    have hφ_inj : Function.Injective φ_L :=
      IsLocalization.injective (LaurentPolynomial k) hX_nzd
    have hφ_X : φ_L Polynomial.X = LaurentPolynomial.T 1 := Polynomial.toLaurent_X
    have hφ_C : ∀ c : k, φ_L (Polynomial.C c) = LaurentPolynomial.C c := by
      intro c
      have h1 := Polynomial.toLaurent_C_mul_T (R := k) 0 c
      rw [Polynomial.monomial_zero_left, Int.ofNat_zero, LaurentPolynomial.T_zero, mul_one] at h1
      exact h1
    have hT_pow : ∀ n : ℕ, (LaurentPolynomial.T (1 : ℤ) : LaurentPolynomial k) ^ n =
        LaurentPolynomial.T (n : ℤ) := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ, ih, ← LaurentPolynomial.T_add]
        push_cast
        rfl
    have hφ_X_pow : ∀ n : ℕ, φ_L (Polynomial.X ^ n) = LaurentPolynomial.T (n : ℤ) := by
      intro n
      rw [map_pow, hφ_X, hT_pow]
    have hPID_laurent : IsPrincipalIdealRing (LaurentPolynomial k) := by
      refine IsPrincipalIdealRing.mk fun J => ?_
      obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal (Ideal.comap φ_L J)).principal
      refine Submodule.IsPrincipal.mk ⟨φ_L g, ?_⟩
      apply le_antisymm
      · intro z hz
        obtain ⟨n, p, hp⟩ := LaurentPolynomial.exists_T_pow z
        have hp' : φ_L p = z * LaurentPolynomial.T (n : ℤ) := hp
        have hp_mem : p ∈ Ideal.comap φ_L J := by
          change φ_L p ∈ J
          rw [hp']
          exact J.mul_mem_right _ hz
        rw [hg, Ideal.mem_span_singleton] at hp_mem
        obtain ⟨q, rfl⟩ := hp_mem
        rw [Ideal.mem_span_singleton]
        refine ⟨φ_L q * LaurentPolynomial.T (-(n : ℤ)), ?_⟩
        calc
          z = z * (LaurentPolynomial.T (n : ℤ) * LaurentPolynomial.T (-(n : ℤ))) := by
            rw [← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero, mul_one]
          _ = (z * LaurentPolynomial.T (n : ℤ)) * LaurentPolynomial.T (-(n : ℤ)) :=
            (mul_assoc _ _ _).symm
          _ = φ_L (g * q) * LaurentPolynomial.T (-(n : ℤ)) := by rw [← hp']
          _ = φ_L g * (φ_L q * LaurentPolynomial.T (-(n : ℤ))) := by rw [map_mul, mul_assoc]
      · rw [Ideal.span_singleton_le_iff_mem]
        have hg_mem : g ∈ Ideal.comap φ_L J := by
          rw [hg]
          exact Ideal.subset_span rfl
        exact hg_mem
    have h_dvd_X_pow : ∀ (N : ℕ) (p : Polynomial k),
        p ∣ Polynomial.X ^ N →
        ∃ (c : kˣ) (d : ℕ), p = Polynomial.C (c : k) * Polynomial.X ^ d := by
      intro N
      induction N with
      | zero =>
        intro p hp
        rw [pow_zero] at hp
        have hu : IsUnit p := isUnit_of_dvd_one hp
        obtain ⟨c₀, hc₀_unit, hc₀_eq⟩ := Polynomial.isUnit_iff.mp hu
        refine ⟨hc₀_unit.unit, 0, ?_⟩
        rw [pow_zero, mul_one, IsUnit.unit_spec, hc₀_eq]
      | succ N ih =>
        intro p ⟨r, hpr⟩
        have hX_dvd : (Polynomial.X : Polynomial k) ∣ p * r := by
          refine ⟨Polynomial.X ^ N, ?_⟩
          rw [← hpr, pow_succ']
        rcases Polynomial.prime_X.dvd_or_dvd hX_dvd with ⟨p₁, rfl⟩ | ⟨r₁, rfl⟩
        · have hp₁_dvd : p₁ ∣ Polynomial.X ^ N := by
            refine ⟨r, ?_⟩
            apply mul_left_cancel₀ Polynomial.X_ne_zero
            calc
              Polynomial.X * Polynomial.X ^ N = Polynomial.X ^ (N + 1) := (pow_succ' _ _).symm
              _ = (Polynomial.X * p₁) * r := hpr
              _ = Polynomial.X * (p₁ * r) := mul_assoc _ _ _
          obtain ⟨c, d, rfl⟩ := ih p₁ hp₁_dvd
          refine ⟨c, d + 1, ?_⟩
          rw [pow_succ']
          ring
        · have hp_dvd : p ∣ Polynomial.X ^ N := by
            refine ⟨r₁, ?_⟩
            apply mul_left_cancel₀ Polynomial.X_ne_zero
            calc
              Polynomial.X * Polynomial.X ^ N = Polynomial.X ^ (N + 1) := (pow_succ' _ _).symm
              _ = p * (Polynomial.X * r₁) := hpr
              _ = Polynomial.X * (p * r₁) := by ring
          exact ih p hp_dvd
    let Ψ : kˣ × Multiplicative ℤ →* Units (LaurentPolynomial k) :=
      { toFun := fun p =>
          { val := LaurentPolynomial.C (p.1 : k) * LaurentPolynomial.T (Multiplicative.toAdd p.2)
            inv := LaurentPolynomial.C ((p.1⁻¹ : kˣ) : k) *
              LaurentPolynomial.T (-Multiplicative.toAdd p.2)
            val_inv := by
              calc
                (LaurentPolynomial.C (p.1 : k) * LaurentPolynomial.T (Multiplicative.toAdd p.2)) *
                    (LaurentPolynomial.C ((p.1⁻¹ : kˣ) : k) *
                      LaurentPolynomial.T (-Multiplicative.toAdd p.2)) =
                  (LaurentPolynomial.C (p.1 : k) * LaurentPolynomial.C ((p.1⁻¹ : kˣ) : k)) *
                    (LaurentPolynomial.T (Multiplicative.toAdd p.2) *
                      LaurentPolynomial.T (-Multiplicative.toAdd p.2)) := by ring
                _ = LaurentPolynomial.C ((p.1 * p.1⁻¹ : kˣ) : k) *
                    LaurentPolynomial.T (Multiplicative.toAdd p.2 + -Multiplicative.toAdd p.2) := by
                  rw [← map_mul, ← LaurentPolynomial.T_add]
                  rfl
                _ = 1 := by simp
            inv_val := by
              calc
                (LaurentPolynomial.C ((p.1⁻¹ : kˣ) : k) *
                    LaurentPolynomial.T (-Multiplicative.toAdd p.2)) *
                  (LaurentPolynomial.C (p.1 : k) * LaurentPolynomial.T (Multiplicative.toAdd p.2)) =
                  (LaurentPolynomial.C ((p.1⁻¹ : kˣ) : k) * LaurentPolynomial.C (p.1 : k)) *
                    (LaurentPolynomial.T (-Multiplicative.toAdd p.2) *
                      LaurentPolynomial.T (Multiplicative.toAdd p.2)) := by ring
                _ = LaurentPolynomial.C ((p.1⁻¹ * p.1 : kˣ) : k) *
                    LaurentPolynomial.T (-Multiplicative.toAdd p.2 + Multiplicative.toAdd p.2) := by
                  rw [← map_mul, ← LaurentPolynomial.T_add]
                  rfl
                _ = 1 := by simp }
        map_one' := by
          apply Units.ext
          simp
        map_mul' := fun p₁ p₂ => by
          apply Units.ext
          change LaurentPolynomial.C ((p₁.1 * p₂.1 : kˣ) : k) *
              LaurentPolynomial.T (Multiplicative.toAdd (p₁.2 * p₂.2)) =
            (LaurentPolynomial.C (p₁.1 : k) * LaurentPolynomial.T (Multiplicative.toAdd p₁.2)) *
              (LaurentPolynomial.C (p₂.1 : k) * LaurentPolynomial.T (Multiplicative.toAdd p₂.2))
          rw [toAdd_mul, LaurentPolynomial.T_add, Units.val_mul, map_mul]
          ring }
    have hΨ_surj : Function.Surjective Ψ := by
      intro u
      obtain ⟨a, p, hp⟩ := LaurentPolynomial.exists_T_pow (u : LaurentPolynomial k)
      obtain ⟨b, q, hq⟩ := LaurentPolynomial.exists_T_pow ((u⁻¹ : Units (LaurentPolynomial k)) : LaurentPolynomial k)
      have hp' : φ_L p = (u : LaurentPolynomial k) * LaurentPolynomial.T (a : ℤ) := hp
      have hq' : φ_L q = ((u⁻¹ : Units (LaurentPolynomial k)) : LaurentPolynomial k) *
          LaurentPolynomial.T (b : ℤ) := hq
      have hpq_φ : φ_L (p * q) = φ_L (Polynomial.X ^ (a + b)) := by
        rw [map_mul, hp', hq', hφ_X_pow]
        calc
          ((u : LaurentPolynomial k) * LaurentPolynomial.T (a : ℤ)) *
              (((u⁻¹ : Units (LaurentPolynomial k)) : LaurentPolynomial k) *
                LaurentPolynomial.T (b : ℤ)) =
            ((u : LaurentPolynomial k) * ((u⁻¹ : Units (LaurentPolynomial k)) : LaurentPolynomial k)) *
              (LaurentPolynomial.T (a : ℤ) * LaurentPolynomial.T (b : ℤ)) := by ring
          _ = 1 * LaurentPolynomial.T ((a : ℤ) + (b : ℤ)) := by
            rw [u.mul_inv, ← LaurentPolynomial.T_add]
          _ = LaurentPolynomial.T (↑(a + b)) := by
            rw [one_mul]
            push_cast
            rfl
      have hpq : p * q = Polynomial.X ^ (a + b) := hφ_inj hpq_φ
      obtain ⟨c, d, rfl⟩ := h_dvd_X_pow (a + b) p ⟨q, hpq.symm⟩
      refine ⟨(c, Multiplicative.ofAdd ((d : ℤ) - (a : ℤ))), ?_⟩
      apply Units.ext
      change LaurentPolynomial.C (c : k) * LaurentPolynomial.T ((d : ℤ) - (a : ℤ)) =
        (u : LaurentPolynomial k)
      have hφ_cd : φ_L (Polynomial.C (c : k) * Polynomial.X ^ d) =
          LaurentPolynomial.C (c : k) * LaurentPolynomial.T (d : ℤ) := by
        rw [map_mul, hφ_C, hφ_X_pow]
      rw [hφ_cd] at hp'
      calc
        LaurentPolynomial.C (c : k) * LaurentPolynomial.T ((d : ℤ) - (a : ℤ)) =
            (LaurentPolynomial.C (c : k) * LaurentPolynomial.T (d : ℤ)) *
              LaurentPolynomial.T (-(a : ℤ)) := by
          rw [mul_assoc, ← LaurentPolynomial.T_add, sub_eq_add_neg]
        _ = ((u : LaurentPolynomial k) * LaurentPolynomial.T (a : ℤ)) *
              LaurentPolynomial.T (-(a : ℤ)) := by rw [hp']
        _ = (u : LaurentPolynomial k) *
              (LaurentPolynomial.T (a : ℤ) * LaurentPolynomial.T (-(a : ℤ))) := mul_assoc _ _ _
        _ = (u : LaurentPolynomial k) := by
          rw [← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero, mul_one]
    have hΨ_inj : Function.Injective Ψ := by
      rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
      rintro ⟨c, m⟩ hcm
      rw [MonoidHom.mem_ker] at hcm
      let n : ℤ := Multiplicative.toAdd m
      have hval : LaurentPolynomial.C (c : k) * LaurentPolynomial.T n = 1 :=
        congrArg Units.val hcm
      have hdeg_eq :
          (LaurentPolynomial.C (c : k) * LaurentPolynomial.T n).degree =
            (LaurentPolynomial.C (1 : k) * LaurentPolynomial.T (0 : ℤ)).degree := by
        rw [hval]
        simp
      rw [LaurentPolynomial.degree_C_mul_T n (c : k) c.ne_zero,
        LaurentPolynomial.degree_C_mul_T 0 (1 : k) one_ne_zero] at hdeg_eq
      have hn0 : n = 0 := WithBot.coe_inj.mp hdeg_eq
      rw [hn0, LaurentPolynomial.T_zero, mul_one] at hval
      have hC_poly : Polynomial.C (c : k) = Polynomial.C (1 : k) := by
        apply hφ_inj
        rw [hφ_C, hφ_C, hval, map_one]
      have hc_val : (c : k) = 1 := by
        simpa using congrArg (Polynomial.eval (0 : k)) hC_poly
      have hc1 : c = 1 := Units.ext hc_val
