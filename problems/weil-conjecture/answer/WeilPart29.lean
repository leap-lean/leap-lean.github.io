      { carrier := Set.univ
        isIrreducible' := IrreducibleSpace.isIrreducible_univ ↥Γ
        isClosed' := isClosed_univ }
    have h_lt_top : q₀.last < top_Γ := by
      apply lt_of_le_not_ge (Set.subset_univ _)
      intro h_ge
