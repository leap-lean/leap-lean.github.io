            (α₀ ≫ g_app) β₀).mp hSmoothComp1
      exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
        α₀ g_app).mp hSmoothComp2
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilGysinAffineStruct k 1) := hSm_A₁
    have hSm_U₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_G₁ := by
      have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
