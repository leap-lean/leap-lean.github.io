        ∃! g : ↑(Y.presheaf.obj (Opposite.op ⊤)),
          ∀ j : ZMod (ℓ ^ r),
            (Y.presheaf.map (CategoryTheory.homOfLE
              (le_top : (⟨s ⁻¹' {ULift.up j}, s.isLocallyConstant {ULift.up j}⟩ : Y.Opens) ≤ ⊤)).op).hom g =
            (Y.presheaf.map (CategoryTheory.homOfLE
              (le_top : (⟨s ⁻¹' {ULift.up j}, s.isLocallyConstant {ULift.up j}⟩ : Y.Opens) ≤ ⊤)).op).hom
              (σ_of Y πY (ν r j)) := by
      intro r Y πY s
      let V_lvl : ZMod (ℓ ^ r) → Y.Opens :=
        fun j => ⟨s ⁻¹' {ULift.up j}, s.isLocallyConstant {ULift.up j}⟩
