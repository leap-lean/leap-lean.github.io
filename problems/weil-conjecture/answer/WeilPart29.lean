          rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology,
            AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology] at hR'
          · obtain ⟨Y, f_a, y₀, hf_a, hEt_fa, hy₀⟩ := hR' (u_S.base pt₀)
            have : AlgebraicGeometry.Etale f_a.left := hEt_fa
            obtain ⟨p₀, -, -⟩ :=
              AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ pt₀ hy₀
            let q_P := CategoryTheory.Limits.pullback.snd f_a.left u_S
            have : AlgebraicGeometry.Etale q_P := inferInstance
            obtain ⟨s_P, hs_P, -⟩ := hSecLift Ω_x _ q_P p₀
            let u_Y : S_x ⟶ Y.left := s_P ≫ CategoryTheory.Limits.pullback.fst f_a.left u_S
            have hu_Y_fa : u_Y ≫ f_a.left = u_S :=
              (CategoryTheory.Category.assoc s_P
                (CategoryTheory.Limits.pullback.fst f_a.left u_S) f_a.left).trans
                ((congrArg (s_P ≫ ·)
                  (CategoryTheory.Limits.pullback.condition (f := f_a.left) (g := u_S))).trans
                  ((CategoryTheory.Category.assoc s_P q_P u_S).symm.trans
                    ((congrArg (· ≫ u_S) hs_P).trans (CategoryTheory.Category.id_comp u_S))))
            have hu_Y_hom : u_Y ≫ Y.hom = g_x :=
              (congrArg (u_Y ≫ ·) (CategoryTheory.MorphismProperty.Over.w f_a).symm).trans
                ((CategoryTheory.Category.assoc u_Y f_a.left W.hom).symm.trans
                  ((congrArg (· ≫ W.hom) hu_Y_fa).trans hu_S))
            let τ_Y : F_g.obj Y := mkSec Y u_Y hu_Y_hom
            exact ⟨Y, f_a, hf_a, τ_Y,
              hFg_map_eq f_a τ_Y τ
                ((congrArg (· ≫ f_a.left) (hmkSec_fst Y u_Y hu_Y_hom)).trans hu_Y_fa)⟩
          · exact le_rfl }
    
    let M_x : AddCommGrpCat.{u} := Φ_x.presheafFiber.obj ℋ.obj
    let φ_fam : ∀ (U : S.Etale) (τ : Quiver.Hom T_x (B_g.obj U)),
        Quiver.Hom (ℋ.obj.obj (Opposite.op U)) M_x :=
      fun U τ => Φ_x.toPresheafFiber U τ ℋ.obj
    obtain ⟨hSecMem_x, hTermCov_x⟩ := hSpecSieves Ω_x
    have hφ_zero : ∀ (U : S.Etale) (τ : Quiver.Hom T_x (B_g.obj U)), φ_fam U τ = 0 :=
      (hSitePkg S_x.smallEtaleTopology T_x (hTerm_Ω Ω_x) hSecMem_x hTermCov_x).2.2.2
        S.smallEtaleTopology B_g hc ℋ M_x φ_fam
        (fun {U V} v τ => Φ_x.toPresheafFiber_w v τ ℋ.obj)
        hZeroHom
    intro U u hu s
    let τ_u : Φ_x.fiber.obj U := mkSec U u hu
    have h_eq_fib : (Φ_x.toPresheafFiber U τ_u ℋ.obj).hom s =
        (Φ_x.toPresheafFiber U τ_u ℋ.obj).hom 0 := by
      have h0 := congrArg (fun k => k.hom s) (hφ_zero U τ_u)
      change (Φ_x.toPresheafFiber U τ_u ℋ.obj).hom s = 0 at h0
