          (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (η.app S.X₃)).comp hSF₂.extClass
            (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSF₁ hSF₂ φ_S
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₁ hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₂ hS,
        CategoryTheory.Abelian.Ext.comp_assoc _ hSF₁.extClass
          (CategoryTheory.Abelian.Ext.mk₀ (η.app B)) rfl (Nat.add_zero 1) (by omega),
        hNatExt,
        ← CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ (η.app S.X₃))
          hSF₂.extClass (Nat.add_zero n') (Nat.zero_add 1) (by omega),
