        fun f hf => s_fam f hf
      let g₀ : ↥U.left → ULift.{u} (ZMod n) := fun x => evalFam (f_x x) (hf_R x) (y_x x)
      have hg₀_pull : ∀ {Y : S.Etale} (f : Y ⟶ U) (hf : R.arrows f) (y : ↥Y.left),
