      (adj.ofNatIsoRight iso).homEquiv X Y f = adj.homEquiv X Y f ≫ iso.hom.app Y := by
    intro 𝒞 𝒟 _ _ F G G' adj iso X Y f
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    dsimp [CategoryTheory.Adjunction.ofNatIsoRight]
    rw [CategoryTheory.Category.assoc, ← iso.hom.naturality, ← CategoryTheory.Category.assoc]

  have hMapInvConj : ∀ {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
