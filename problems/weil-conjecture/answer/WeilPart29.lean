      exact CategoryTheory.yonedaEquiv_comp _ _
    apply (weilPolyP1CohomologyRepHomEquiv W_x T_Wx R_T).injective
    rw [hRepComp f_T g_T]
    have hf_val : weilPolyP1CohomologyRepHomEquiv W_x T_Wx Fℤ_Wx f_T =
