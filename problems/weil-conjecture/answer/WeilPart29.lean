    ∃ (ρ_Z : Quiver.Hom (weilEtaleTorsionSheaf Γ n)
        (P_push_Z.obj (weilEtaleTorsionSheaf I_Z.subscheme n)))
      (h0 : CategoryTheory.CategoryStruct.comp
        (weilGysinLocalTorsionCounit Γ n (weilGysinEtaleObj j hj_et)) ρ_Z = 0),
      (CategoryTheory.ShortComplex.mk
        (weilGysinLocalTorsionCounit Γ n (weilGysinEtaleObj j hj_et)) ρ_Z h0).ShortExact :=
by
  classical
  have hMemEtale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {U : S.Etale}
