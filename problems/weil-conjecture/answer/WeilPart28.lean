        (Sigma_et hw).IsContinuous X.smallEtaleTopology S.smallEtaleTopology :=
      (hLocPkg w hw).choose
    let Res_fn {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
        (hw : AlgebraicGeometry.Etale w) :
        CategoryTheory.Functor
          (CategoryTheory.Sheaf S.smallEtaleTopology ModR)
          (CategoryTheory.Sheaf X.smallEtaleTopology ModR) :=
      @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (Sigma_et hw) ModR _
        X.smallEtaleTopology S.smallEtaleTopology (hCont_fn w hw)
    let hAdd_fn {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
        (hw : AlgebraicGeometry.Etale w) : (Res_fn w hw).Additive :=
      (hLocPkg w hw).choose_spec.choose
    let hLim_fn {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
        (hw : AlgebraicGeometry.Etale w) :
        CategoryTheory.Limits.PreservesFiniteLimits (Res_fn w hw) :=
      (hLocPkg w hw).choose_spec.choose_spec.choose
    let hColim_fn {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
        (hw : AlgebraicGeometry.Etale w) :
        CategoryTheory.Limits.PreservesFiniteColimits (Res_fn w hw) :=
      (hLocPkg w hw).choose_spec.choose_spec.choose_spec.choose
    let ε_fn {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
        (hw : AlgebraicGeometry.Etale w) :
        one_fn X ≅ (Res_fn w hw).obj (one_fn S) :=
      (hLocPkg w hw).choose_spec.choose_spec.choose_spec.choose_spec.choose
    have hPkg_spec : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
        (hw : AlgebraicGeometry.Etale w),
        (∀ (I : CategoryTheory.Sheaf S.smallEtaleTopology ModR),
          CategoryTheory.Injective I → CategoryTheory.Injective ((Res_fn w hw).obj I)) ∧
        (∀ V : X.Etale,
