          exact (CategoryTheory.Abelian.Ext.comp_mk₀_id y_mod).symm
        _ = (y_mod.precomp one_W (Nat.add_zero D))
            (m₀ • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id one_W)) :=
          (map_nsmul (y_mod.precomp one_W (Nat.add_zero D)) _ _).symm
        _ = 0 := by
          rw [hmk_zero, map_zero]
    rw [hy_mod, map_zero]
  let K : ℕ := M ^ (D * D)
  refine ⟨fun s t₁ t₂ => (K : ZMod m₀) * c₀ s t₁ t₂, ?_⟩
  have hpow : ℓ ^ (e * (D * D + D + 2)) = K * M ^ (D + 2) := by
    dsimp only [K, M]
    rw [pow_mul ℓ e (D * D + D + 2), ← pow_add, Nat.add_assoc]
  rw [hpow, mul_nsmul', h_exp]
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro s _
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro t₁ _
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro t₂ _
  let term := cup s.1 (D - s.1) (Nat.add_sub_of_le (Finset.mem_Iic.mp s.2))
    (p₁ s.1 (v_S s.1 t₁)) (p₂ (D - s.1) (v_S (D - s.1) t₂))
  change K • ((c₀ s t₁ t₂).val • term) = (((K : ZMod m₀) * c₀ s t₁ t₂).val) • term
  rw [← mul_nsmul']
  have hval : ((K : ZMod m₀) * c₀ s t₁ t₂).val = (K * (c₀ s t₁ t₂).val) % m₀ := by
    conv_lhs => rw [← ZMod.natCast_zmod_val (c₀ s t₁ t₂), ← Nat.cast_mul]
    exact ZMod.val_natCast (n := m₀) (K * (c₀ s t₁ t₂).val)
  rw [hval]
  conv_lhs => rw [← Nat.div_add_mod (K * (c₀ s t₁ t₂).val) m₀]
  rw [add_nsmul, mul_nsmul, h_tor term, nsmul_zero, zero_add]

theorem weil_lefschetz_integral_kunneth_generators (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W₁ W₂ : AlgebraicGeometry.Scheme.{u})
    (p₁ p₂ : Quiver.Hom W₂ W₁) (D : ℕ)
    (H_X : ∀ i : ℕ, WeilLefschetzEllAdicSpace W₁ ℓ i)
    (H_P : ∀ i : ℕ, WeilLefschetzEllAdicSpace W₂ ℓ i)
    (fp₁ fp₂ : ∀ i : ℕ, (H_X i).V →ₗ[Padic ℓ] (H_P i).V)
    (hfp₁ : ∀ i : ℕ, WeilLefschetzIsEllAdicPullback p₁ ℓ i (H_P i) (H_X i) (fp₁ i))
    (hfp₂ : ∀ i : ℕ, WeilLefschetzIsEllAdicPullback p₂ ℓ i (H_P i) (H_X i) (fp₂ i))
    (cup_P : ∀ (i j : ℕ), i + j = D →
      (H_P i).V →ₗ[Padic ℓ] (H_P j).V →ₗ[Padic ℓ] (H_P D).V)
    (hcup_P : ∀ (i j : ℕ) (hij : i + j = D),
      WeilLefschetzIsEllAdicCup W₂ ℓ i j D hij (H_P i) (H_P j) (H_P D) (cup_P i j hij))
    (hPullTrans : ∀ (h : Quiver.Hom W₂ W₁) (r m : ℕ)
      (p_succ : weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) m →+ weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) m)
      (p_curr : weilEtaleTorsionH W₁ (ℓ ^ r) m →+ weilEtaleTorsionH W₂ (ℓ ^ r) m),
      WeilLefschetzTorsionPullback h (ℓ ^ (r + 1)) m p_succ →
      WeilLefschetzTorsionPullback h (ℓ ^ r) m p_curr →
      ∀ x : weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) m,
        weilEtaleTorsionTransition W₂ ℓ r m (p_succ x) =
          p_curr (weilEtaleTorsionTransition W₁ ℓ r m x))
    (hCupTrans : ∀ (r a b_deg c : ℕ) (hab : a + b_deg = c)
      (c_succ : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) a →+
        weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) b_deg →+ weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) c)
      (c_curr : weilEtaleTorsionH W₂ (ℓ ^ r) a →+
        weilEtaleTorsionH W₂ (ℓ ^ r) b_deg →+ weilEtaleTorsionH W₂ (ℓ ^ r) c),
      WeilLefschetzIsTorsionCup W₂ (ℓ ^ (r + 1)) a b_deg c hab c_succ →
      WeilLefschetzIsTorsionCup W₂ (ℓ ^ r) a b_deg c hab c_curr →
      ∀ (x : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) a)
        (y : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) b_deg),
        weilEtaleTorsionTransition W₂ ℓ r c (c_succ x y) =
          c_curr (weilEtaleTorsionTransition W₂ ℓ r a x)
            (weilEtaleTorsionTransition W₂ ℓ r b_deg y))
    (b : ℕ → ℕ)
    (v_sys : ∀ q : ℕ, Fin (b q) → ↥(weilEtaleIntegralSystem W₁ ℓ q))
    (C : ℕ)
    (hExp : ∀ (r : ℕ)
      (p₁_r p₂_r : ∀ i : ℕ, weilEtaleTorsionH W₁ (ℓ ^ r) i →+ weilEtaleTorsionH W₂ (ℓ ^ r) i)
      (cup_r : ∀ (i j : ℕ), i + j = D →
        weilEtaleTorsionH W₂ (ℓ ^ r) i →+
          weilEtaleTorsionH W₂ (ℓ ^ r) j →+ weilEtaleTorsionH W₂ (ℓ ^ r) D),
      (∀ i : ℕ, WeilLefschetzTorsionPullback p₁ (ℓ ^ r) i (p₁_r i)) →
      (∀ j : ℕ, WeilLefschetzTorsionPullback p₂ (ℓ ^ r) j (p₂_r j)) →
      (∀ (i j : ℕ) (hij : i + j = D),
        WeilLefschetzIsTorsionCup W₂ (ℓ ^ r) i j D hij (cup_r i j hij)) →
      ∀ z_r : weilEtaleTorsionH W₂ (ℓ ^ r) D,
        ∃ coeff : ∀ s : ↥(Finset.Iic D), Fin (b s.1) → Fin (b (D - s.1)) → ZMod (ℓ ^ r),
          (ℓ ^ C) • z_r =
            ∑ s : ↥(Finset.Iic D),
              ∑ t₁ : Fin (b s.1),
                ∑ t₂ : Fin (b (D - s.1)),
                  (coeff s t₁ t₂).val •
                    cup_r s.1 (D - s.1) (Nat.add_sub_of_le (Finset.mem_Iic.mp s.2))
                      (p₁_r s.1 ((v_sys s.1 t₁).1 r))
                      (p₂_r (D - s.1) ((v_sys (D - s.1) t₂).1 r))) :
    ∃ κ : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))) →
        ↥(weilEtaleIntegralSystem W₂ ℓ D),
      (∀ α : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))),
        (H_P D).equiv (TensorProduct.tmul ℤ (1 : ℚ) (κ α)) ∈
          { z : (H_P D).V |
            ∃ (i j : ℕ) (hij : i + j = D) (u : (H_X i).V) (w : (H_X j).V),
              z = cup_P i j hij (fp₁ i u) (fp₂ j w) }) ∧
      (∀ (r : ℕ) (z_r : weilEtaleTorsionH W₂ (ℓ ^ r) D),
        ∃ f : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))) → ZMod (ℓ ^ r),
          (ℓ ^ C) • z_r =
            ∑ α : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))),
              (f α).val • (κ α).1 r) :=
by
  have h_sys_mem : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      (x : ∀ r : ℕ, weilEtaleTorsionH W (ℓ ^ r) m),
      x ∈ weilEtaleIntegralSystem W ℓ m ↔
        ∀ r : ℕ, weilEtaleTorsionTransition W ℓ r m (x (r + 1)) = x r := by
    intro W m x
    unfold weilEtaleIntegralSystem
    rw [AddMonoidHom.mem_ker, funext_iff]
    refine forall_congr' fun r => ?_
    rw [AddMonoidHom.pi_apply, Pi.zero_apply, AddMonoidHom.sub_apply,
      AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, Pi.evalAddMonoidHom_apply,
      sub_eq_zero]
  have h_engine : ∀ (H₁ H₂ : ℕ → ℕ → Type u)
      [∀ r i, AddCommGroup (H₁ r i)] [∀ r i, AddCommGroup (H₂ r i)]
      (π₁ : ∀ r i, H₁ (r + 1) i →+ H₁ r i)
      (π₂ : ∀ r i, H₂ (r + 1) i →+ H₂ r i)
      (L₁ : ∀ i, AddSubgroup (∀ r, H₁ r i))
      (L₂ : ∀ i, AddSubgroup (∀ r, H₂ r i))
      (_hL₁ : ∀ i (x : ∀ r, H₁ r i), x ∈ L₁ i ↔ ∀ r, π₁ r i (x (r + 1)) = x r)
      (_hL₂ : ∀ i (x : ∀ r, H₂ r i), x ∈ L₂ i ↔ ∀ r, π₂ r i (x (r + 1)) = x r)
      (V₁ V₂ : ℕ → Type u)
      [∀ i, AddCommGroup (V₁ i)] [∀ i, Module (Padic ℓ) (V₁ i)]
      [∀ i, AddCommGroup (V₂ i)] [∀ i, Module (Padic ℓ) (V₂ i)]
      (equiv₁ : ∀ i, TensorProduct ℤ ℚ ↥(L₁ i) ≃+ V₁ i)
      (equiv₂ : ∀ i, TensorProduct ℤ ℚ ↥(L₂ i) ≃+ V₂ i)
      (fp₁' fp₂' : ∀ i, V₁ i →ₗ[Padic ℓ] V₂ i)
      (cup_P' : ∀ i j, i + j = D → V₂ i →ₗ[Padic ℓ] V₂ j →ₗ[Padic ℓ] V₂ D)
      (IsPull₁ IsPull₂ : ∀ r i, (H₁ r i →+ H₂ r i) → Prop)
      (IsCup : ∀ r i j, i + j = D → (H₂ r i →+ H₂ r j →+ H₂ r D) → Prop),
      (∀ i, ∃ p : ∀ r, H₁ r i →+ H₂ r i,
        (∀ r, IsPull₁ r i (p r)) ∧
        ∀ (x : ↥(L₁ i)) (y : ↥(L₂ i)),
          (∀ r, y.1 r = p r (x.1 r)) →
            fp₁' i (equiv₁ i (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv₂ i (TensorProduct.tmul ℤ (1 : ℚ) y)) →
      (∀ j, ∃ p : ∀ r, H₁ r j →+ H₂ r j,
        (∀ r, IsPull₂ r j (p r)) ∧
        ∀ (x : ↥(L₁ j)) (y : ↥(L₂ j)),
          (∀ r, y.1 r = p r (x.1 r)) →
            fp₂' j (equiv₁ j (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv₂ j (TensorProduct.tmul ℤ (1 : ℚ) y)) →
      (∀ (i j : ℕ) (hij : i + j = D),
        ∃ c_tors : ∀ r, H₂ r i →+ H₂ r j →+ H₂ r D,
          (∀ r, IsCup r i j hij (c_tors r)) ∧
          ∀ (x : ↥(L₂ i)) (y : ↥(L₂ j)) (z : ↥(L₂ D)),
            (∀ r, z.1 r = c_tors r (x.1 r) (y.1 r)) →
              cup_P' i j hij (equiv₂ i (TensorProduct.tmul ℤ (1 : ℚ) x))
                  (equiv₂ j (TensorProduct.tmul ℤ (1 : ℚ) y)) =
                equiv₂ D (TensorProduct.tmul ℤ (1 : ℚ) z)) →
      (∀ r m (p_succ : H₁ (r + 1) m →+ H₂ (r + 1) m) (p_curr : H₁ r m →+ H₂ r m),
        IsPull₁ (r + 1) m p_succ → IsPull₁ r m p_curr →
        ∀ x, π₂ r m (p_succ x) = p_curr (π₁ r m x)) →
      (∀ r m (p_succ : H₁ (r + 1) m →+ H₂ (r + 1) m) (p_curr : H₁ r m →+ H₂ r m),
        IsPull₂ (r + 1) m p_succ → IsPull₂ r m p_curr →
        ∀ x, π₂ r m (p_succ x) = p_curr (π₁ r m x)) →
      (∀ r a b_deg (hab : a + b_deg = D)
        (c_succ : H₂ (r + 1) a →+ H₂ (r + 1) b_deg →+ H₂ (r + 1) D)
        (c_curr : H₂ r a →+ H₂ r b_deg →+ H₂ r D),
        IsCup (r + 1) a b_deg hab c_succ → IsCup r a b_deg hab c_curr →
        ∀ x y, π₂ r D (c_succ x y) = c_curr (π₂ r a x) (π₂ r b_deg y)) →
      ∀ (v_sys' : ∀ q, Fin (b q) → ↥(L₁ q)),
      (∀ (r : ℕ)
        (p₁_r p₂_r : ∀ i, H₁ r i →+ H₂ r i)
        (cup_r : ∀ i j, i + j = D → H₂ r i →+ H₂ r j →+ H₂ r D),
        (∀ i, IsPull₁ r i (p₁_r i)) →
        (∀ j, IsPull₂ r j (p₂_r j)) →
        (∀ i j hij, IsCup r i j hij (cup_r i j hij)) →
        ∀ z_r : H₂ r D,
          ∃ coeff : ∀ s : ↥(Finset.Iic D), Fin (b s.1) → Fin (b (D - s.1)) → ZMod (ℓ ^ r),
            (ℓ ^ C) • z_r =
              ∑ s : ↥(Finset.Iic D),
                ∑ t₁ : Fin (b s.1),
                  ∑ t₂ : Fin (b (D - s.1)),
                    (coeff s t₁ t₂).val •
                      cup_r s.1 (D - s.1) (Nat.add_sub_of_le (Finset.mem_Iic.mp s.2))
                        (p₁_r s.1 ((v_sys' s.1 t₁).1 r))
                        (p₂_r (D - s.1) ((v_sys' (D - s.1) t₂).1 r))) →
      ∃ κ : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))) → ↥(L₂ D),
        (∀ α : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))),
          equiv₂ D (TensorProduct.tmul ℤ (1 : ℚ) (κ α)) ∈
            { z : V₂ D |
              ∃ (i j : ℕ) (hij : i + j = D) (u : V₁ i) (w : V₁ j),
                z = cup_P' i j hij (fp₁' i u) (fp₂' j w) }) ∧
        (∀ (r : ℕ) (z_r : H₂ r D),
          ∃ f : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))) → ZMod (ℓ ^ r),
            (ℓ ^ C) • z_r =
              ∑ α : (Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))),
                (f α).val • (κ α).1 r) := by
    intro H₁ H₂ _ _ _π₁ _π₂ L₁ L₂ hL₁ hL₂ V₁ V₂ _ _ _ _ equiv₁ equiv₂ fp₁' fp₂' cup_P'
      IsPull₁ IsPull₂ IsCup hfp₁' hfp₂' hcup' hPT₁ hPT₂ hCT v_sys' hExp'
    let Idx : Type := Σ s : ↥(Finset.Iic D), Fin (b s.1) × Fin (b (D - s.1))
    have h_triple_sum : ∀ {M : Type u} [AddCommMonoid M]
        (g : ∀ s : ↥(Finset.Iic D), Fin (b s.1) → Fin (b (D - s.1)) → M),
        (∑ s : ↥(Finset.Iic D), ∑ t₁ : Fin (b s.1), ∑ t₂ : Fin (b (D - s.1)), g s t₁ t₂) =
          ∑ α : Idx, g α.1 α.2.1 α.2.2 := by
      intro M _ g
      symm
      rw [Fintype.sum_sigma]
      refine Finset.sum_congr rfl fun s _ => ?_
      exact Fintype.sum_prod_type fun p => g s p.1 p.2
    obtain ⟨p₁_tors, hp₁_tors⟩ := Classical.axiomOfChoice hfp₁'
    obtain ⟨p₂_tors, hp₂_tors⟩ := Classical.axiomOfChoice hfp₂'
    obtain ⟨c_pack, hc_pack⟩ := Classical.axiomOfChoice
      (fun p : { ij : ℕ × ℕ // ij.1 + ij.2 = D } => hcup' p.1.1 p.1.2 p.2)
    let pull₁_sys (i : ℕ) (x : ↥(L₁ i)) : ↥(L₂ i) :=
      ⟨fun r => p₁_tors i r (x.1 r),
        (hL₂ i _).mpr fun r =>
          (hPT₁ r i (p₁_tors i (r + 1)) (p₁_tors i r)
            ((hp₁_tors i).1 (r + 1)) ((hp₁_tors i).1 r) (x.1 (r + 1))).trans
            (congrArg (p₁_tors i r) ((hL₁ i x.1).mp x.2 r))⟩
    let pull₂_sys (j : ℕ) (y : ↥(L₁ j)) : ↥(L₂ j) :=
      ⟨fun r => p₂_tors j r (y.1 r),
        (hL₂ j _).mpr fun r =>
          (hPT₂ r j (p₂_tors j (r + 1)) (p₂_tors j r)
            ((hp₂_tors j).1 (r + 1)) ((hp₂_tors j).1 r) (y.1 (r + 1))).trans
            (congrArg (p₂_tors j r) ((hL₁ j y.1).mp y.2 r))⟩
    let κ (α : Idx) : ↥(L₂ D) :=
      let h_s : α.1.1 + (D - α.1.1) = D := Nat.add_sub_of_le (Finset.mem_Iic.mp α.1.2)
      let x_α := pull₁_sys α.1.1 (v_sys' α.1.1 α.2.1)
      let y_α := pull₂_sys (D - α.1.1) (v_sys' (D - α.1.1) α.2.2)
      ⟨fun r => c_pack ⟨(α.1.1, D - α.1.1), h_s⟩ r (x_α.1 r) (y_α.1 r),
        (hL₂ D _).mpr fun r =>
          (hCT r α.1.1 (D - α.1.1) h_s
            (c_pack ⟨(α.1.1, D - α.1.1), h_s⟩ (r + 1))
            (c_pack ⟨(α.1.1, D - α.1.1), h_s⟩ r)
            ((hc_pack ⟨(α.1.1, D - α.1.1), h_s⟩).1 (r + 1))
            ((hc_pack ⟨(α.1.1, D - α.1.1), h_s⟩).1 r)
            (x_α.1 (r + 1)) (y_α.1 (r + 1))).trans
            (congrArg₂ (fun u₀ w₀ => c_pack ⟨(α.1.1, D - α.1.1), h_s⟩ r u₀ w₀)
              ((hL₂ α.1.1 x_α.1).mp x_α.2 r)
              ((hL₂ (D - α.1.1) y_α.1).mp y_α.2 r))⟩
    refine ⟨κ, ?_, ?_⟩
    · intro α
      let i : ℕ := α.1.1
      let j : ℕ := D - α.1.1
      let h_s : i + j = D := Nat.add_sub_of_le (Finset.mem_Iic.mp α.1.2)
      let x_α := pull₁_sys i (v_sys' i α.2.1)
      let y_α := pull₂_sys j (v_sys' j α.2.2)
      let u : V₁ i := equiv₁ i (TensorProduct.tmul ℤ (1 : ℚ) (v_sys' i α.2.1))
      let w : V₁ j := equiv₁ j (TensorProduct.tmul ℤ (1 : ℚ) (v_sys' j α.2.2))
      have h_u : fp₁' i u = equiv₂ i (TensorProduct.tmul ℤ (1 : ℚ) x_α) :=
        (hp₁_tors i).2 (v_sys' i α.2.1) x_α (fun _ => rfl)
      have h_w : fp₂' j w = equiv₂ j (TensorProduct.tmul ℤ (1 : ℚ) y_α) :=
        (hp₂_tors j).2 (v_sys' j α.2.2) y_α (fun _ => rfl)
      have h_c : cup_P' i j h_s (equiv₂ i (TensorProduct.tmul ℤ (1 : ℚ) x_α))
          (equiv₂ j (TensorProduct.tmul ℤ (1 : ℚ) y_α)) =
          equiv₂ D (TensorProduct.tmul ℤ (1 : ℚ) (κ α)) :=
        (hc_pack ⟨(i, j), h_s⟩).2 x_α y_α (κ α) (fun _ => rfl)
      exact ⟨i, j, h_s, u, w,
        ((congrArg₂ (fun u' w' => cup_P' i j h_s u' w') h_u h_w).trans h_c).symm⟩
    · intro r z_r
      obtain ⟨coeff, hcoeff⟩ := hExp' r
        (fun i => p₁_tors i r)
        (fun j => p₂_tors j r)
        (fun i j hij => c_pack ⟨(i, j), hij⟩ r)
        (fun i => (hp₁_tors i).1 r)
        (fun j => (hp₂_tors j).1 r)
        (fun i j hij => (hc_pack ⟨(i, j), hij⟩).1 r)
        z_r
      refine ⟨fun α => coeff α.1 α.2.1 α.2.2, ?_⟩
      exact hcoeff.trans (h_triple_sum fun s t₁ t₂ =>
        (coeff s t₁ t₂).val •
          c_pack ⟨(s.1, D - s.1), Nat.add_sub_of_le (Finset.mem_Iic.mp s.2)⟩ r
            (p₁_tors s.1 r ((v_sys' s.1 t₁).1 r))
            (p₂_tors (D - s.1) r ((v_sys' (D - s.1) t₂).1 r)))
  exact h_engine
    (fun r i => weilEtaleTorsionH W₁ (ℓ ^ r) i)
    (fun r i => weilEtaleTorsionH W₂ (ℓ ^ r) i)
    (fun r i => weilEtaleTorsionTransition W₁ ℓ r i)
    (fun r i => weilEtaleTorsionTransition W₂ ℓ r i)
    (fun i => weilEtaleIntegralSystem W₁ ℓ i)
    (fun i => weilEtaleIntegralSystem W₂ ℓ i)
    (fun i x => h_sys_mem W₁ i x)
    (fun i x => h_sys_mem W₂ i x)
    (fun i => (H_X i).V)
    (fun i => (H_P i).V)
    (fun i => (H_X i).equiv)
    (fun i => (H_P i).equiv)
    fp₁ fp₂ cup_P
    (fun r i p => WeilLefschetzTorsionPullback p₁ (ℓ ^ r) i p)
    (fun r j p => WeilLefschetzTorsionPullback p₂ (ℓ ^ r) j p)
    (fun r i j hij c => WeilLefschetzIsTorsionCup W₂ (ℓ ^ r) i j D hij c)
    hfp₁ hfp₂ hcup_P
    (fun r m ps pc hs hc x => hPullTrans p₁ r m ps pc hs hc x)
    (fun r m ps pc hs hc x => hPullTrans p₂ r m ps pc hs hc x)
    (fun r a b_deg hab cs cc hs hc x y => hCupTrans r a b_deg D hab cs cc hs hc x y)
    v_sys
    hExp

theorem weil_konig_padic_tensor_span_of_bounded_torsion_coker (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H_fam : ℕ → Type u) [∀ r : ℕ, AddCommGroup (H_fam r)]
    (π_tr : ∀ r : ℕ, H_fam (r + 1) →+ H_fam r)
    (hAnn : ∀ (r : ℕ) (y : H_fam r), (ℓ ^ r) • y = 0)
    (L_sub : AddSubgroup (∀ r : ℕ, H_fam r))
    (hL_mem : ∀ x : ∀ r : ℕ, H_fam r, x ∈ L_sub ↔ ∀ r : ℕ, π_tr r (x (r + 1)) = x r)
    {V₀ : Type u} [AddCommGroup V₀] [Module (Padic ℓ) V₀]
    (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V₀)
    (hsmul : ∀ (z : PadicInt ℓ) (x y : ↥L_sub),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
        equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x))
    {Idx : Type} [Fintype Idx]
    (κ : Idx → ↥L_sub)
    (S_span : Set V₀)
    (hκ_mem : ∀ α : Idx, equiv (TensorProduct.tmul ℤ (1 : ℚ) (κ α)) ∈ S_span)
    (C : ℕ)
    (hExp : ∀ (r : ℕ) (z_r : H_fam r),
      ∃ f : Idx → ZMod (ℓ ^ r),
        (ℓ ^ C) • z_r = ∑ α : Idx, (f α).val • (κ α).1 r) :
    ⊤ ≤ Submodule.span (Padic ℓ) S_span :=
by
  let W : Submodule (Padic ℓ) V₀ := Submodule.span (Padic ℓ) S_span
  change ⊤ ≤ W
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hNeZero : ∀ r : ℕ, NeZero (ℓ ^ r) :=
    fun r => ⟨(pow_pos hℓ_prime.pos r).ne'⟩
  have hZMod_nsmul : ∀ {r₁ r₂ : ℕ} (hr : r₁ ≤ r₂) (a : ZMod (ℓ ^ r₂)) (y : H_fam r₁),
      (ZMod.castHom (pow_dvd_pow ℓ hr) (ZMod (ℓ ^ r₁)) a).val • y = a.val • y := by
    intro r₁ r₂ hr a y
    have hval : (ZMod.castHom (pow_dvd_pow ℓ hr) (ZMod (ℓ ^ r₁)) a).val = a.val % (ℓ ^ r₁) := by
      rw [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
    rw [hval]
    conv_rhs => rw [← Nat.div_add_mod a.val (ℓ ^ r₁)]
    rw [mul_comm (ℓ ^ r₁) (a.val / (ℓ ^ r₁)), add_nsmul, mul_nsmul', hAnn r₁ y,
      nsmul_zero, zero_add]
  let smulL : PadicInt ℓ → ↥L_sub → ↥L_sub := fun μ x =>
    ⟨fun r => (PadicInt.toZModPow r μ).val • x.1 r, by
      rw [hL_mem]
      intro r
      have hx_tr : π_tr r (x.1 (r + 1)) = x.1 r := (hL_mem x.1).mp x.2 r
      have hcast_μ :
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
            (PadicInt.toZModPow (r + 1) μ) = PadicInt.toZModPow r μ :=
        RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r)) μ
      calc
        π_tr r ((PadicInt.toZModPow (r + 1) μ).val • x.1 (r + 1))
            = (PadicInt.toZModPow (r + 1) μ).val • π_tr r (x.1 (r + 1)) := map_nsmul _ _ _
        _ = (PadicInt.toZModPow (r + 1) μ).val • x.1 r := by rw [hx_tr]
        _ = (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
              (PadicInt.toZModPow (r + 1) μ)).val • x.1 r :=
            (hZMod_nsmul (Nat.le_succ r) _ _).symm
        _ = (PadicInt.toZModPow r μ).val • x.1 r := by rw [hcast_μ]⟩
  let φ_L : ↥L_sub →+ V₀ :=
    equiv.toAddMonoidHom.comp (TensorProduct.mk ℤ ℚ ↥L_sub (1 : ℚ)).toAddMonoidHom
  have h_one : ∀ z : ↥L_sub, equiv (TensorProduct.tmul ℤ (1 : ℚ) z) ∈ W := by
    intro z
    have hz_tr : ∀ r : ℕ, π_tr r (z.1 (r + 1)) = z.1 r := (hL_mem z.1).mp z.2
    have hκ_tr : ∀ (α : Idx) (r : ℕ), π_tr r ((κ α).1 (r + 1)) = (κ α).1 r :=
      fun α => (hL_mem (κ α).1).mp (κ α).2
    let Fiber : ℕ → Type := fun r =>
      { f : Idx → ZMod (ℓ ^ r) // (ℓ ^ C) • z.1 r = ∑ α : Idx, (f α).val • (κ α).1 r }
    have hStep : ∀ (r : ℕ) (x : Fiber (r + 1)),
        (ℓ ^ C) • z.1 r =
          ∑ α : Idx,
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (x.1 α)).val •
              (κ α).1 r := by
      intro r x
      have hx := congrArg (π_tr r) x.2
      rw [map_nsmul, hz_tr r, map_sum] at hx
      rw [hx]
      apply Finset.sum_congr rfl
      intro α _
      rw [map_nsmul, hκ_tr α r, hZMod_nsmul (Nat.le_succ r) (x.1 α) ((κ α).1 r)]
    have hTrans : ∀ {r₁ r₂ : ℕ} (hr : r₁ ≤ r₂) (x : Fiber r₂),
        (ℓ ^ C) • z.1 r₁ =
          ∑ α : Idx,
            (ZMod.castHom (pow_dvd_pow ℓ hr) (ZMod (ℓ ^ r₁)) (x.1 α)).val • (κ α).1 r₁ := by
      intro r₁ r₂ hr
      induction hr with
      | refl =>
        intro x
        simpa only [ZMod.castHom_self, RingHom.id_apply] using x.2
      | @step m hm ih =>
        intro x
        let x_m : Fiber m :=
          ⟨fun α => ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) (x.1 α),
            hStep m x⟩
        have h_ih := ih x_m
        rw [h_ih]
        apply Finset.sum_congr rfl
        intro α _
        have hcomp :
            ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ r₁)) (x_m.1 α) =
              ZMod.castHom (pow_dvd_pow ℓ (Nat.le.step hm)) (ZMod (ℓ ^ r₁)) (x.1 α) :=
          RingHom.congr_fun
            (ZMod.castHom_comp (pow_dvd_pow ℓ hm) (pow_dvd_pow ℓ (Nat.le_succ m))) (x.1 α)
        rw [hcomp]
    let F_inv : CategoryTheory.Functor ℕᵒᵖ Type :=
      { obj := fun j => Fiber (Opposite.unop j)
        map := fun {j₂ j₁} u => TypeCat.ofHom fun x =>
          ⟨fun α =>
              ZMod.castHom (pow_dvd_pow ℓ (CategoryTheory.leOfHom u.unop))
                (ZMod (ℓ ^ Opposite.unop j₁)) (x.1 α),
            hTrans (CategoryTheory.leOfHom u.unop) x⟩
        map_id := fun j => by
          ext x α
          change ZMod.castHom _ _ (x.1 α) = x.1 α
          rw [ZMod.castHom_self, RingHom.id_apply]
        map_comp := fun {j₃ j₂ j₁} u v => by
          ext x α
          change ZMod.castHom _ _ (x.1 α) = ZMod.castHom _ _ (ZMod.castHom _ _ (x.1 α))
          exact (RingHom.congr_fun
            (ZMod.castHom_comp
              (pow_dvd_pow ℓ (CategoryTheory.leOfHom v.unop))
              (pow_dvd_pow ℓ (CategoryTheory.leOfHom u.unop)))
            (x.1 α)).symm }
    have hFin_obj : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := by
      intro j
      dsimp [F_inv, Fiber]
      infer_instance
    have hNonempty_obj : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := by
      intro j
      obtain ⟨f, hf⟩ := hExp (Opposite.unop j) (z.1 (Opposite.unop j))
      exact ⟨⟨f, hf⟩⟩
    obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system F_inv
    let c_sys : ∀ r : ℕ, Idx → ZMod (ℓ ^ r) := fun r => (sec (Opposite.op r)).1
    have hc_compat : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂) (α : Idx),
        ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁)) (c_sys k₂ α) = c_sys k₁ α := by
      intro k₁ k₂ hk α
      exact congrFun (congrArg Subtype.val (hsec (CategoryTheory.homOfLE hk).op)) α
    have hc_exp : ∀ r : ℕ, (ℓ ^ C) • z.1 r = ∑ α : Idx, (c_sys r α).val • (κ α).1 r :=
      fun r => (sec (Opposite.op r)).2
    let f_ring : Idx → ∀ k : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ k) := fun α k =>
      Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ k))) (c_sys k α)
    have hf_compat : ∀ (α : Idx) (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (f_ring α k₂) = f_ring α k₁ := by
      intro α k₁ k₂ hk
      apply Polynomial.ringHom_ext
      · intro n
        simp [f_ring]
      · simp [f_ring, hc_compat k₁ k₂ hk α]
    let liftCoeff : Idx → PadicInt ℓ := fun α =>
      PadicInt.lift (hf_compat α) Polynomial.X
    have hlift_spec : ∀ (α : Idx) (r : ℕ), PadicInt.toZModPow r (liftCoeff α) = c_sys r α := by
      intro α r
      have hspec := RingHom.congr_fun (PadicInt.lift_spec (hf_compat α) r) Polynomial.X
      simpa [f_ring] using hspec
    have hz_eq : (ℓ ^ C) • z = ∑ α : Idx, smulL (liftCoeff α) (κ α) := by
      apply Subtype.ext
      funext r
      have hsum_val :
          (∑ α : Idx, smulL (liftCoeff α) (κ α)).1 r =
            ∑ α : Idx, (smulL (liftCoeff α) (κ α)).1 r := by
        change L_sub.subtype (∑ α : Idx, smulL (liftCoeff α) (κ α)) r = _
        rw [map_sum, Finset.sum_apply]
        rfl
      change (ℓ ^ C) • z.1 r = (∑ α : Idx, smulL (liftCoeff α) (κ α)).1 r
      rw [hsum_val, hc_exp r]
      apply Finset.sum_congr rfl
      intro α _
      change (c_sys r α).val • (κ α).1 r = (PadicInt.toZModPow r (liftCoeff α)).val • (κ α).1 r
      rw [hlift_spec α r]
    have hφ_eq := congrArg φ_L hz_eq
    rw [map_nsmul, map_sum, ← Nat.cast_smul_eq_nsmul (Padic ℓ) (ℓ ^ C) (φ_L z)] at hφ_eq
    have hsum_mem : (∑ α : Idx, φ_L (smulL (liftCoeff α) (κ α))) ∈ W := by
      apply Submodule.sum_mem W
      intro α _
      have h_α : φ_L (smulL (liftCoeff α) (κ α)) = (liftCoeff α : Padic ℓ) • φ_L (κ α) :=
        hsmul (liftCoeff α) (κ α) (smulL (liftCoeff α) (κ α)) (fun _ => rfl)
      rw [h_α]
      exact Submodule.smul_mem W (liftCoeff α : Padic ℓ) (Submodule.subset_span (hκ_mem α))
    have hpow_mem : ((ℓ ^ C : ℕ) : Padic ℓ) • φ_L z ∈ W := by
      rw [hφ_eq]
      exact hsum_mem
    have hc_ne : ((ℓ ^ C : ℕ) : Padic ℓ) ≠ 0 :=
      Nat.cast_ne_zero.mpr (pow_ne_zero C hℓ_prime.ne_zero)
    have hinv := Submodule.smul_mem W (((ℓ ^ C : ℕ) : Padic ℓ)⁻¹) hpow_mem
    rwa [inv_smul_smul₀ hc_ne] at hinv
  have h_all : ∀ t : TensorProduct ℤ ℚ ↥L_sub, equiv t ∈ W := by
    intro t
    induction t using TensorProduct.inductionOn with
    | tmul q z =>
      have hq_rat : (q.den : ℕ) • q = q.num • (1 : ℚ) := by
        rw [nsmul_eq_mul, zsmul_eq_mul, mul_one, mul_comm, Rat.mul_den_eq_num]
      have htp_eq :
          (q.den : ℕ) • TensorProduct.tmul ℤ q z =
            q.num • TensorProduct.tmul ℤ (1 : ℚ) z := by
        rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', hq_rat]
      have heq_V := congrArg equiv htp_eq
      rw [map_nsmul, map_zsmul,
        ← Nat.cast_smul_eq_nsmul (Padic ℓ),
        ← Int.cast_smul_eq_zsmul (Padic ℓ)] at heq_V
      have hden_ne : ((q.den : ℕ) : Padic ℓ) ≠ 0 :=
        Nat.cast_ne_zero.mpr q.den_nz
      have hrhs_mem : ((q.num : ℤ) : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) z) ∈ W :=
        Submodule.smul_mem W ((q.num : ℤ) : Padic ℓ) (h_one z)
      rw [← heq_V] at hrhs_mem
      have hinv := Submodule.smul_mem W (((q.den : ℕ) : Padic ℓ)⁻¹) hrhs_mem
      rwa [inv_smul_smul₀ hden_ne] at hinv
    | add t₁ t₂ ht₁ ht₂ =>
      rw [map_add]
      exact Submodule.add_mem W ht₁ ht₂
  intro v _
  rw [← equiv.apply_symm_apply v]
  exact h_all (equiv.symm v)

theorem weil_lefschetz_konig_padic_span (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W₁ W₂ : AlgebraicGeometry.Scheme.{u})
    (p₁ p₂ : Quiver.Hom W₂ W₁) (D : ℕ)
    (H_X : ∀ i : ℕ, WeilLefschetzEllAdicSpace W₁ ℓ i)
    (H_P : ∀ i : ℕ, WeilLefschetzEllAdicSpace W₂ ℓ i)
    (fp₁ fp₂ : ∀ i : ℕ, (H_X i).V →ₗ[Padic ℓ] (H_P i).V)
    (hfp₁ : ∀ i : ℕ, WeilLefschetzIsEllAdicPullback p₁ ℓ i (H_P i) (H_X i) (fp₁ i))
    (hfp₂ : ∀ i : ℕ, WeilLefschetzIsEllAdicPullback p₂ ℓ i (H_P i) (H_X i) (fp₂ i))
    (cup_P : ∀ (i j : ℕ), i + j = D →
      (H_P i).V →ₗ[Padic ℓ] (H_P j).V →ₗ[Padic ℓ] (H_P D).V)
    (hcup_P : ∀ (i j : ℕ) (hij : i + j = D),
      WeilLefschetzIsEllAdicCup W₂ ℓ i j D hij (H_P i) (H_P j) (H_P D) (cup_P i j hij))
    (hPullTrans : ∀ (h : Quiver.Hom W₂ W₁) (r m : ℕ)
      (p_succ : weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) m →+ weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) m)
      (p_curr : weilEtaleTorsionH W₁ (ℓ ^ r) m →+ weilEtaleTorsionH W₂ (ℓ ^ r) m),
      WeilLefschetzTorsionPullback h (ℓ ^ (r + 1)) m p_succ →
      WeilLefschetzTorsionPullback h (ℓ ^ r) m p_curr →
      ∀ x : weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) m,
        weilEtaleTorsionTransition W₂ ℓ r m (p_succ x) =
          p_curr (weilEtaleTorsionTransition W₁ ℓ r m x))
    (hCupTrans : ∀ (r a b_deg c : ℕ) (hab : a + b_deg = c)
      (c_succ : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) a →+
        weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) b_deg →+ weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) c)
      (c_curr : weilEtaleTorsionH W₂ (ℓ ^ r) a →+
        weilEtaleTorsionH W₂ (ℓ ^ r) b_deg →+ weilEtaleTorsionH W₂ (ℓ ^ r) c),
      WeilLefschetzIsTorsionCup W₂ (ℓ ^ (r + 1)) a b_deg c hab c_succ →
      WeilLefschetzIsTorsionCup W₂ (ℓ ^ r) a b_deg c hab c_curr →
      ∀ (x : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) a)
        (y : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) b_deg),
        weilEtaleTorsionTransition W₂ ℓ r c (c_succ x y) =
          c_curr (weilEtaleTorsionTransition W₂ ℓ r a x)
            (weilEtaleTorsionTransition W₂ ℓ r b_deg y))
    (b : ℕ → ℕ)
    (v_sys : ∀ q : ℕ, Fin (b q) → ↥(weilEtaleIntegralSystem W₁ ℓ q))
    (C : ℕ)
    (hExp : ∀ (r : ℕ)
      (p₁_r p₂_r : ∀ i : ℕ, weilEtaleTorsionH W₁ (ℓ ^ r) i →+ weilEtaleTorsionH W₂ (ℓ ^ r) i)
      (cup_r : ∀ (i j : ℕ), i + j = D →
        weilEtaleTorsionH W₂ (ℓ ^ r) i →+
          weilEtaleTorsionH W₂ (ℓ ^ r) j →+ weilEtaleTorsionH W₂ (ℓ ^ r) D),
      (∀ i : ℕ, WeilLefschetzTorsionPullback p₁ (ℓ ^ r) i (p₁_r i)) →
      (∀ j : ℕ, WeilLefschetzTorsionPullback p₂ (ℓ ^ r) j (p₂_r j)) →
      (∀ (i j : ℕ) (hij : i + j = D),
        WeilLefschetzIsTorsionCup W₂ (ℓ ^ r) i j D hij (cup_r i j hij)) →
      ∀ z_r : weilEtaleTorsionH W₂ (ℓ ^ r) D,
        ∃ coeff : ∀ s : ↥(Finset.Iic D), Fin (b s.1) → Fin (b (D - s.1)) → ZMod (ℓ ^ r),
          (ℓ ^ C) • z_r =
            ∑ s : ↥(Finset.Iic D),
              ∑ t₁ : Fin (b s.1),
                ∑ t₂ : Fin (b (D - s.1)),
                  (coeff s t₁ t₂).val •
                    cup_r s.1 (D - s.1) (Nat.add_sub_of_le (Finset.mem_Iic.mp s.2))
                      (p₁_r s.1 ((v_sys s.1 t₁).1 r))
                      (p₂_r (D - s.1) ((v_sys (D - s.1) t₂).1 r))) :
    ⊤ ≤ Submodule.span (Padic ℓ) { z : (H_P D).V |
      ∃ (i j : ℕ) (hij : i + j = D) (u : (H_X i).V) (w : (H_X j).V),
        z = cup_P i j hij (fp₁ i u) (fp₂ j w) } :=
by
  have hL_mem : ∀ x : ∀ r : ℕ, weilEtaleTorsionH W₂ (ℓ ^ r) D,
      x ∈ weilEtaleIntegralSystem W₂ ℓ D ↔
        ∀ r : ℕ, weilEtaleTorsionTransition W₂ ℓ r D (x (r + 1)) = x r := by
    intro x
    unfold weilEtaleIntegralSystem
    rw [AddMonoidHom.mem_ker, funext_iff]
    refine forall_congr' fun r => ?_
    rw [AddMonoidHom.pi_apply, Pi.zero_apply, AddMonoidHom.sub_apply,
      AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, Pi.evalAddMonoidHom_apply,
      sub_eq_zero]
  obtain ⟨κ, hκ_mem, hExp_idx⟩ :=
    weil_lefschetz_integral_kunneth_generators ℓ W₁ W₂ p₁ p₂ D
      H_X H_P fp₁ fp₂ hfp₁ hfp₂ cup_P hcup_P hPullTrans hCupTrans b v_sys C hExp
  exact weil_konig_padic_tensor_span_of_bounded_torsion_coker ℓ
    (fun r => weilEtaleTorsionH W₂ (ℓ ^ r) D)
    (fun r => weilEtaleTorsionTransition W₂ ℓ r D)
    (fun r y => weil_etale_torsion_sheafH_annihilation W₂ (ℓ ^ r) D y)
    (weilEtaleIntegralSystem W₂ ℓ D)
    hL_mem
    (H_P D).equiv
    (H_P D).hsmul
    κ
    _
    hκ_mem
    C
    hExp_idx

theorem weil_lefschetz_cd_vanishing_and_kunneth_span (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k)) :
    (∀ (m : ℕ), 2 * d < m →
      ∀ (H_m : WeilLefschetzEllAdicSpace X.left ℓ m) (v : H_m.V), v = 0) ∧
    (let P := CategoryTheory.Limits.pullback X.hom X.hom
     let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
     let p₂ := CategoryTheory.Limits.pullback.snd X.hom X.hom
     ∀ (H_X : ∀ i : ℕ, WeilLefschetzEllAdicSpace X.left ℓ i)
       [∀ i : ℕ, Module.Finite (Padic ℓ) (H_X i).V]
       (H_P : ∀ i : ℕ, WeilLefschetzEllAdicSpace P ℓ i)
       (fp₁ fp₂ : ∀ i : ℕ, (H_X i).V →ₗ[Padic ℓ] (H_P i).V),
       (∀ i : ℕ, WeilLefschetzIsEllAdicPullback p₁ ℓ i (H_P i) (H_X i) (fp₁ i)) →
       (∀ i : ℕ, WeilLefschetzIsEllAdicPullback p₂ ℓ i (H_P i) (H_X i) (fp₂ i)) →
