        rw [Abelian.Ext.comp_assoc a b (Abelian.Ext.mk₀ q_r) hc (Nat.add_zero j) (by omega), hb_mod,
          ← Abelian.Ext.comp_assoc a (Abelian.Ext.mk₀ q_r) (Abelian.Ext.mapExactFunctor ρ b₀)
            (Nat.add_zero i) (Nat.zero_add j) (by omega), ha_mod,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q_r) (Abelian.Ext.mapExactFunctor ρ a₀)
            (Abelian.Ext.mapExactFunctor ρ b₀) (Nat.zero_add i) hc (by omega),
          ← Abelian.Ext.mapExactFunctor_comp ρ a₀ b₀ hc]
    have hMod_ex_uniq := hModPkg.1
    have hMod_trans := hModPkg.2
    intro W r a b c hab c_succ c_curr hc_succ hc_curr x y
    let θ_std : ∀ (n k : ℕ), weilEtaleModuleH W n k →+ weilEtaleTorsionH W n k :=
      fun n k => Classical.choose (hMod_ex_uniq W n k).1
    have hθ_std : ∀ (n k : ℕ), WeilIsModuleToTorsionComparison W n k (θ_std n k) :=
      fun n k => (Classical.choose_spec (hMod_ex_uniq W n k).1).1
    have hθ_bij : ∀ (n k : ℕ), Function.Bijective (θ_std n k) :=
      fun n k => (Classical.choose_spec (hMod_ex_uniq W n k).1).2
    have hθ_uniq : ∀ (n k : ℕ) (θ : weilEtaleModuleH W n k →+ weilEtaleTorsionH W n k),
        WeilIsModuleToTorsionComparison W n k θ → θ = θ_std n k :=
      fun n k θ hθ => (hMod_ex_uniq W n k).2 θ (θ_std n k) hθ (hθ_std n k)
    have hCupAlign : ∀ (n a₀ b₀ c₀ : ℕ) (h₀ : a₀ + b₀ = c₀)
        (cup : weilEtaleTorsionH W n a₀ →+ weilEtaleTorsionH W n b₀ →+ weilEtaleTorsionH W n c₀),
        WeilLefschetzIsTorsionCup W n a₀ b₀ c₀ h₀ cup →
        ∀ (α : weilEtaleModuleH W n a₀) (β : weilEtaleModuleH W n b₀),
          cup (θ_std n a₀ α) (θ_std n b₀ β) = θ_std n c₀ (α.comp β h₀) := by
      intro n a₀ b₀ c₀ h₀ cup hcup_wit α β
      let R := ULift.{u, 0} (ZMod n)
      let J := W.smallEtaleTopology
      let R_mod := ModuleCat.of R R
      let One_mod := weilEtaleModuleUnit W n
      let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
      let C_ab := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
      let Fℤ := C_ab.obj Aℤ
      let FM := weilEtaleTorsionSheaf W n
      let ιM : Quiver.Hom AM (F_fg.obj R_mod) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
      let z_to_m : Quiver.Hom Aℤ AM :=
        AddCommGrpCat.ofHom
          { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod n)
            map_zero' := congrArg ULift.up Int.cast_zero
            map_add' := fun x₁ x₂ => congrArg ULift.up (Int.cast_add x₁.down x₂.down) }
      let ιℤ_mod : Quiver.Hom Aℤ (F_fg.obj R_mod) :=
        CategoryTheory.CategoryStruct.comp
          (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
            Quiver.Hom Aℤ (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)))
          (CategoryTheory.CategoryStruct.comp
            (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod n))))
            ιM)
      have hz_ι : CategoryTheory.CategoryStruct.comp z_to_m ιM = ιℤ_mod :=
        AddCommGrpCat.ext fun _ => rfl
      obtain ⟨_, _, _, _, _, _, T₀, hT₀, hT₀_left, hT₀_hom, _⟩ := hθ_std n 0
      rcases hcup_wit with ⟨U, hU_obj, hU_map, hAdd, hLim, hColim, T, hT,
        u_unit, hu_unit, πM, hαπ, hπα, hcup_eq⟩
      haveI : U.Additive := hAdd
      haveI : CategoryTheory.Limits.PreservesFiniteLimits U := hLim
      haveI : CategoryTheory.Limits.PreservesFiniteColimits U := hColim
      let φ : Quiver.Hom T₀ T := hT.from T₀
      let adj_ab := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
      let adj_mod := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT
      let adj_ab₀ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₀
      let adj_mod₀ := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT₀
      have hobj_T : (U.obj One_mod).obj.obj (Opposite.op T) =
          F_fg.obj (One_mod.obj.obj (Opposite.op T)) :=
        congrArg (fun G => G.obj (Opposite.op T)) (hU_obj One_mod)
      have hobj_T₀ : (U.obj One_mod).obj.obj (Opposite.op T₀) =
          F_fg.obj (One_mod.obj.obj (Opposite.op T₀)) :=
        congrArg (fun G => G.obj (Opposite.op T₀)) (hU_obj One_mod)
      let u₀ : Quiver.Hom (F_fg.obj R_mod) ((U.obj One_mod).obj.obj (Opposite.op T₀)) :=
        CategoryTheory.CategoryStruct.comp
          (F_fg.map (adj_mod₀.unit.app R_mod))
          (CategoryTheory.eqToHom hobj_T₀.symm)
      have hu₀_heq : HEq u₀ (F_fg.map (adj_mod₀.unit.app R_mod)) :=
        CategoryTheory.comp_eqToHom_heq _ _
      have hu_unit_eq : u_unit =
          CategoryTheory.CategoryStruct.comp
            (F_fg.map (adj_mod.unit.app R_mod))
            (CategoryTheory.eqToHom hobj_T.symm) :=
        eq_of_heq (hu_unit.trans (CategoryTheory.comp_eqToHom_heq _ hobj_T.symm).symm)
      have hu₀_rel : u₀ =
          CategoryTheory.CategoryStruct.comp u_unit ((U.obj One_mod).obj.map φ.op) := by
        have hmap_φ : (U.obj One_mod).obj.map φ.op =
            CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom hobj_T)
              (CategoryTheory.CategoryStruct.comp
                (F_fg.map (One_mod.obj.map φ.op))
                (CategoryTheory.eqToHom hobj_T₀.symm)) :=
          CategoryTheory.Functor.congr_hom (hU_obj One_mod) φ.op
        dsimp only [u₀]
        rw [hu_unit_eq, hmap_φ,
          hConstUnit J (ModuleCat.{u, u} R) hT hT₀ φ R_mod,
          F_fg.map_comp, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.eqToHom_trans_assoc, CategoryTheory.eqToHom_refl,
          CategoryTheory.Category.id_comp]
        rfl
      let αM : Quiver.Hom FM (U.obj One_mod) :=
        (adj_ab.homEquiv AM (U.obj One_mod)).symm
          (CategoryTheory.CategoryStruct.comp ιM u_unit)
      let αM₀ : Quiver.Hom FM (U.obj One_mod) :=
        (adj_ab₀.homEquiv AM (U.obj One_mod)).symm
          (CategoryTheory.CategoryStruct.comp ιM u₀)
      have hαM_eq : αM₀ = αM := by
        dsimp only [αM₀, αM]
        rw [hu₀_rel, ← CategoryTheory.Category.assoc]
        exact hConstSymm J AddCommGrpCat.{u} hT hT₀ φ AM (U.obj One_mod) _
      let ιℤ : Quiver.Hom Fℤ (U.obj One_mod) :=
        CategoryTheory.CategoryStruct.comp (C_ab.map z_to_m) αM
      let ηℤ₀ : Quiver.Hom Fℤ (U.obj One_mod) :=
        (adj_ab₀.homEquiv Aℤ (U.obj One_mod)).symm
          (CategoryTheory.CategoryStruct.comp ιℤ_mod u₀)
      have hηℤ_eq : ηℤ₀ = ιℤ := by
        apply (adj_ab₀.homEquiv Aℤ (U.obj One_mod)).injective
        change (adj_ab₀.homEquiv Aℤ (U.obj One_mod))
            ((adj_ab₀.homEquiv Aℤ (U.obj One_mod)).symm
              (CategoryTheory.CategoryStruct.comp ιℤ_mod u₀)) =
          (adj_ab₀.homEquiv Aℤ (U.obj One_mod))
            (CategoryTheory.CategoryStruct.comp (C_ab.map z_to_m) αM)
        rw [Equiv.apply_symm_apply, ← hαM_eq,
          CategoryTheory.Adjunction.homEquiv_naturality_left,
          Equiv.apply_symm_apply, ← CategoryTheory.Category.assoc z_to_m ιM u₀, hz_ι]
      let mapU : ∀ k : ℕ, weilEtaleModuleH W n k →+
          CategoryTheory.Abelian.Ext.{u} (U.obj One_mod) (U.obj One_mod) k :=
        fun k => @CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _
          U hAdd hLim hColim _ _ One_mod One_mod k
      let θ_hom : ∀ k : ℕ, weilEtaleModuleH W n k →+ weilEtaleTorsionH W n k :=
        fun k =>
          ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)).comp
            (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (U.obj One_mod) (Nat.zero_add k)).comp
              (mapU k))
      have hθ_hom_eq : ∀ k : ℕ, θ_hom k = θ_std n k := by
        intro k
        apply hθ_uniq n k (θ_hom k)
        refine ⟨U, hU_obj, hU_map, hAdd, hLim, hColim, T₀, hT₀, hT₀_left, hT₀_hom,
          u₀, hu₀_heq, ?_⟩
        refine ⟨πM, ?_, ?_, ?_⟩
        · change CategoryTheory.CategoryStruct.comp αM₀ πM =
            CategoryTheory.CategoryStruct.id FM
          rw [hαM_eq]
          exact hαπ
        · change CategoryTheory.CategoryStruct.comp πM αM₀ =
            CategoryTheory.CategoryStruct.id (U.obj One_mod)
          rw [hαM_eq]
          exact hπα
        · intro γ
          have hγ : θ_hom k γ =
              (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)
                ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp (mapU k γ) (Nat.zero_add k)) := rfl
          rw [hγ]
          exact congrArg
            (fun f => (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)
              ((CategoryTheory.Abelian.Ext.mk₀ f).comp (mapU k γ) (Nat.zero_add k)))
            hηℤ_eq.symm
      have hcup_inst : cup (θ_hom a₀ α) (θ_hom b₀ β) = θ_hom c₀ (α.comp β h₀) := hcup_eq α β
      rw [hθ_hom_eq a₀, hθ_hom_eq b₀, hθ_hom_eq c₀] at hcup_inst
      exact hcup_inst
    obtain ⟨α₁, rfl⟩ := (hθ_bij (ℓ ^ (r + 1)) a).2 x
    obtain ⟨β₁, rfl⟩ := (hθ_bij (ℓ ^ (r + 1)) b).2 y
    obtain ⟨α₀, hα₀⟩ := (hθ_bij (ℓ ^ r) a).2
      (weilEtaleTorsionTransition W ℓ r a (θ_std (ℓ ^ (r + 1)) a α₁))
    obtain ⟨β₀, hβ₀⟩ := (hθ_bij (ℓ ^ r) b).2
      (weilEtaleTorsionTransition W ℓ r b (θ_std (ℓ ^ (r + 1)) b β₁))
    rw [hCupAlign (ℓ ^ (r + 1)) a b c hab c_succ hc_succ α₁ β₁,
      ← hα₀, ← hβ₀,
      hCupAlign (ℓ ^ r) a b c hab c_curr hc_curr α₀ β₀]
    exact hMod_trans W ℓ r a b c hab
      (θ_std (ℓ ^ (r + 1)) a) (θ_std (ℓ ^ r) a)
      (θ_std (ℓ ^ (r + 1)) b) (θ_std (ℓ ^ r) b)
      (θ_std (ℓ ^ (r + 1)) c) (θ_std (ℓ ^ r) c)
      (hθ_std _ _) (hθ_std _ _) (hθ_std _ _) (hθ_std _ _) (hθ_std _ _) (hθ_std _ _)
      α₁ β₁ α₀ β₀ hα₀.symm hβ₀.symm

theorem weil_etale_torsion_sheafH_annihilation (W : AlgebraicGeometry.Scheme.{u}) (m k : ℕ)
    (y : weilEtaleTorsionH W m k) :
    m • y = 0 :=
by
  let Z_m : AddCommGrpCat.{0} := AddCommGrpCat.of (ZMod m)
  have hZ_zero : m • CategoryTheory.CategoryStruct.id Z_m = 0 := by
    apply AddCommGrpCat.hom_ext
    ext a
    rw [AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id,
      AddMonoidHom.id_apply, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply,
      nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  let J := W.smallEtaleTopology
  let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
  let C_sh := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let FM : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleTorsionSheaf W m
  have hFM_zero : m • CategoryTheory.CategoryStruct.id FM = 0 := by
    change m • CategoryTheory.CategoryStruct.id (C_sh.obj (U_lift.obj Z_m)) = 0
    rw [← C_sh.map_id, ← U_lift.map_id, ← CategoryTheory.Functor.map_nsmul,
      ← CategoryTheory.Functor.map_nsmul, hZ_zero, CategoryTheory.Functor.map_zero,
      CategoryTheory.Functor.map_zero]
  let Fℤ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    C_sh.obj (AddCommGrpCat.of (ULift.{u} ℤ))
  let yExt : CategoryTheory.Abelian.Ext Fℤ FM k := y
  have hExt_nsmul : ∀ n : ℕ,
      yExt.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id FM))
        (Nat.add_zero k) = n • yExt := by
    intro n
    induction n with
    | zero =>
      rw [zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero, zero_nsmul]
    | succ n ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih,
        CategoryTheory.Abelian.Ext.comp_mk₀_id, ← succ_nsmul]
  change m • yExt = 0
  rw [← hExt_nsmul m, hFM_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
    CategoryTheory.Abelian.Ext.comp_zero]

theorem weil_padic_space_of_torsion_inverse_system (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : ℕ → Type u) [∀ r : ℕ, AddCommGroup (G r)]
    (h_ann : ∀ (r : ℕ) (u : G r), (ℓ ^ r) • u = 0)
    (τ : ∀ r : ℕ, G (r + 1) →+ G r)
    (L_sub : AddSubgroup (∀ r : ℕ, G r))
    (hL_mem : ∀ seq : ∀ r : ℕ, G r, seq ∈ L_sub ↔ ∀ r : ℕ, τ r (seq (r + 1)) = seq r) :
    ∃ (V : Type u) (_ : AddCommGroup V) (_ : Module (Padic ℓ) V)
      (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V),
      ∀ (z : PadicInt ℓ) (x y : ↥L_sub),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x) :=
by
  have h_prime : Nat.Prime ℓ := Fact.out
  have h_neZero : ∀ r : ℕ, NeZero (ℓ ^ r) := fun r => ⟨(pow_pos h_prime.pos r).ne'⟩
  have h_nsmul_zmod : ∀ (r a : ℕ) (u : G r), ((a : ZMod (ℓ ^ r)).val) • u = a • u := by
    intro r a u
    have : NeZero (ℓ ^ r) := h_neZero r
    rw [ZMod.val_natCast]
    conv_rhs => rw [← Nat.div_add_mod a (ℓ ^ r)]
    rw [add_nsmul, mul_comm, mul_nsmul', h_ann r u, nsmul_zero, zero_add]
  have h_padicInt_mem : ∀ (z : PadicInt ℓ) (x : ↥L_sub),
      (fun r : ℕ => (PadicInt.toZModPow r z).val • x.1 r) ∈ L_sub := by
    intro z x
    rw [hL_mem]
    intro r
    have : NeZero (ℓ ^ (r + 1)) := h_neZero (r + 1)
    have hx_r : τ r (x.1 (r + 1)) = x.1 r := (hL_mem x.1).mp x.2 r
    rw [map_nsmul, hx_r, ← h_nsmul_zmod r (PadicInt.toZModPow (r + 1) z).val (x.1 r)]
    have h_cast : (((PadicInt.toZModPow (r + 1) z).val : ℕ) : ZMod (ℓ ^ r)) =
        PadicInt.toZModPow r z := by
      let φ := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
      have hφ : φ (PadicInt.toZModPow (r + 1) z) = PadicInt.toZModPow r z :=
        RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r)) z
      rw [← hφ, ← map_natCast φ, ZMod.natCast_zmod_val]
    rw [h_cast]
  let actAdd (z : PadicInt ℓ) : ↥L_sub →+ ↥L_sub :=
    { toFun := fun x => ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, h_padicInt_mem z x⟩
      map_zero' := by
        apply Subtype.ext; funext r
        exact nsmul_zero _
      map_add' := fun x₁ x₂ => by
        apply Subtype.ext; funext r
        exact nsmul_add _ _ _ }
  let lam_L : PadicInt ℓ →+* Module.End ℤ ↥L_sub :=
    { toFun := fun z => (actAdd z).toIntLinearMap
      map_one' := by
        apply LinearMap.ext; intro x; apply Subtype.ext; funext r
        have : NeZero (ℓ ^ r) := h_neZero r
        change (PadicInt.toZModPow r 1).val • x.1 r = x.1 r
        rw [map_one, ← Nat.cast_one, h_nsmul_zmod r 1 (x.1 r), one_nsmul]
      map_mul' := fun z₁ z₂ => by
        apply LinearMap.ext; intro x; apply Subtype.ext; funext r
        have : NeZero (ℓ ^ r) := h_neZero r
        change (PadicInt.toZModPow r (z₁ * z₂)).val • x.1 r =
          (PadicInt.toZModPow r z₁).val • ((PadicInt.toZModPow r z₂).val • x.1 r)
        rw [map_mul]
        set w₁ := PadicInt.toZModPow r z₁
        set w₂ := PadicInt.toZModPow r z₂
        have hw : w₁ * w₂ = (((w₁.val * w₂.val : ℕ)) : ZMod (ℓ ^ r)) := by
          rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
        rw [hw, h_nsmul_zmod r (w₁.val * w₂.val) (x.1 r), mul_nsmul']
      map_zero' := by
        apply LinearMap.ext; intro x; apply Subtype.ext; funext r
        have : NeZero (ℓ ^ r) := h_neZero r
        change (PadicInt.toZModPow r 0).val • x.1 r = 0
        rw [map_zero, ZMod.val_zero, zero_nsmul]
      map_add' := fun z₁ z₂ => by
        apply LinearMap.ext; intro x; apply Subtype.ext; funext r
        have : NeZero (ℓ ^ r) := h_neZero r
        change (PadicInt.toZModPow r (z₁ + z₂)).val • x.1 r =
          (PadicInt.toZModPow r z₁).val • x.1 r + (PadicInt.toZModPow r z₂).val • x.1 r
        rw [map_add]
        set w₁ := PadicInt.toZModPow r z₁
        set w₂ := PadicInt.toZModPow r z₂
        have hw : w₁ + w₂ = (((w₁.val + w₂.val : ℕ)) : ZMod (ℓ ^ r)) := by
          rw [Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
        rw [hw, h_nsmul_zmod r (w₁.val + w₂.val) (x.1 r), add_nsmul] }
  let V₀ : Type u := TensorProduct ℤ ℚ ↥L_sub
  let EndQ : Type u := Module.End ℚ V₀
  let rho_Z : PadicInt ℓ →+* EndQ := (Module.End.baseChangeHom ℤ ℚ ↥L_sub).toRingHom.comp lam_L
  have h_rho_Z_tmul : ∀ (z : PadicInt ℓ) (q : ℚ) (x : ↥L_sub),
      rho_Z z (TensorProduct.tmul ℤ q x) = TensorProduct.tmul ℤ q (lam_L z x) :=
    fun z q x => LinearMap.baseChange_tmul (lam_L z) q x
  have h_unit_ℓ : IsUnit (rho_Z (ℓ : PadicInt ℓ)) := by
    have hq_ne : (ℓ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr h_prime.ne_zero
    have h_eq : rho_Z (ℓ : PadicInt ℓ) = algebraMap ℚ EndQ (ℓ : ℚ) := by
      rw [map_natCast, map_natCast]
    rw [h_eq]
    exact (IsUnit.mk0 (ℓ : ℚ) hq_ne).map (algebraMap ℚ EndQ)
  let M : Submonoid (PadicInt ℓ) := nonZeroDivisors (PadicInt ℓ)
  have h_unit_nzd : ∀ s : M, IsUnit (rho_Z s.1) := by
    intro s
    have hs : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
    rw [PadicInt.unitCoeff_spec hs, map_mul, map_pow]
    exact ((Units.isUnit (PadicInt.unitCoeff hs)).map rho_Z).mul (h_unit_ℓ.pow _)
  let invS (s : M) : EndQ := ↑((h_unit_nzd s).unit⁻¹)
  have h_mul_inv : ∀ s : M, rho_Z s.1 * invS s = 1 := fun s =>
    (congrArg (· * invS s) (h_unit_nzd s).unit_spec.symm).trans (Units.mul_inv (h_unit_nzd s).unit)
  have h_inv_mul : ∀ s : M, invS s * rho_Z s.1 = 1 := fun s =>
    (congrArg (invS s * ·) (h_unit_nzd s).unit_spec.symm).trans (Units.inv_mul (h_unit_nzd s).unit)
  have h_comm_inv : ∀ (u : EndQ) (s : M), u * rho_Z s.1 = rho_Z s.1 * u →
      u * invS s = invS s * u := by
    intro u s hcomm
    calc
      u * invS s = 1 * (u * invS s) := (one_mul _).symm
      _ = (invS s * rho_Z s.1) * (u * invS s) := by rw [h_inv_mul s]
      _ = invS s * (rho_Z s.1 * u) * invS s := by simp only [mul_assoc]
      _ = invS s * (u * rho_Z s.1) * invS s := by rw [hcomm]
      _ = (invS s * u) * (rho_Z s.1 * invS s) := by simp only [mul_assoc]
      _ = (invS s * u) * 1 := by rw [h_mul_inv s]
      _ = invS s * u := mul_one _
  have h_ff : ∀ a b : PadicInt ℓ, rho_Z a * rho_Z b = rho_Z b * rho_Z a := by
    intro a b
    rw [← map_mul, mul_comm a b, map_mul]
  have h_f_inv : ∀ (a : PadicInt ℓ) (s : M), rho_Z a * invS s = invS s * rho_Z a :=
    fun a s => h_comm_inv (rho_Z a) s (h_ff a s.1)
  have h_inv_inv : ∀ s₁ s₂ : M, invS s₁ * invS s₂ = invS s₂ * invS s₁ :=
    fun s₁ s₂ => h_comm_inv (invS s₁) s₂ (h_f_inv s₂.1 s₁).symm
  have h_inv_one : invS 1 = 1 := by
    calc
      invS 1 = invS 1 * 1 := (mul_one _).symm
      _ = invS 1 * rho_Z (1 : M).1 := by rw [Submonoid.coe_one, map_one]
      _ = 1 := h_inv_mul 1
  have h_inv_mul_s : ∀ s₁ s₂ : M, invS (s₁ * s₂) = invS s₁ * invS s₂ := by
    intro s₁ s₂
    have h_prod : rho_Z (s₁ * s₂).1 * (invS s₁ * invS s₂) = 1 := by
      calc
        rho_Z (s₁ * s₂).1 * (invS s₁ * invS s₂)
          = (rho_Z s₁.1 * rho_Z s₂.1) * (invS s₁ * invS s₂) := by
            rw [Submonoid.coe_mul, map_mul]
        _ = rho_Z s₁.1 * (rho_Z s₂.1 * invS s₁) * invS s₂ := by simp only [mul_assoc]
        _ = rho_Z s₁.1 * (invS s₁ * rho_Z s₂.1) * invS s₂ := by rw [h_f_inv s₂.1 s₁]
        _ = (rho_Z s₁.1 * invS s₁) * (rho_Z s₂.1 * invS s₂) := by simp only [mul_assoc]
        _ = 1 * 1 := by rw [h_mul_inv s₁, h_mul_inv s₂]
        _ = 1 := one_mul 1
    calc
      invS (s₁ * s₂) = invS (s₁ * s₂) * 1 := (mul_one _).symm
      _ = invS (s₁ * s₂) * (rho_Z (s₁ * s₂).1 * (invS s₁ * invS s₂)) := by rw [h_prod]
      _ = (invS (s₁ * s₂) * rho_Z (s₁ * s₂).1) * (invS s₁ * invS s₂) := by simp only [mul_assoc]
      _ = 1 * (invS s₁ * invS s₂) := by rw [h_inv_mul (s₁ * s₂)]
      _ = invS s₁ * invS s₂ := one_mul _
  have h_frac_eq : ∀ (z₁ z₂ : PadicInt ℓ) (s₁ s₂ : M),
      z₁ * s₂.1 = z₂ * s₁.1 → rho_Z z₁ * invS s₁ = rho_Z z₂ * invS s₂ := by
    intro z₁ z₂ s₁ s₂ heq
    calc
      rho_Z z₁ * invS s₁ = (rho_Z z₁ * invS s₁) * 1 := (mul_one _).symm
      _ = (rho_Z z₁ * invS s₁) * (rho_Z s₂.1 * invS s₂) := by rw [h_mul_inv s₂]
      _ = rho_Z z₁ * (invS s₁ * rho_Z s₂.1) * invS s₂ := by simp only [mul_assoc]
      _ = rho_Z z₁ * (rho_Z s₂.1 * invS s₁) * invS s₂ := by rw [← h_f_inv s₂.1 s₁]
      _ = (rho_Z z₁ * rho_Z s₂.1) * invS s₁ * invS s₂ := by simp only [mul_assoc]
      _ = rho_Z (z₁ * s₂.1) * invS s₁ * invS s₂ := by rw [← map_mul]
      _ = rho_Z (z₂ * s₁.1) * invS s₁ * invS s₂ := by rw [heq]
      _ = rho_Z z₂ * (rho_Z s₁.1 * invS s₁) * invS s₂ := by rw [map_mul]; simp only [mul_assoc]
      _ = rho_Z z₂ * 1 * invS s₂ := by rw [h_mul_inv s₁]
      _ = rho_Z z₂ * invS s₂ := by rw [mul_one]
  let ι : PadicInt ℓ →+* Padic ℓ := algebraMap (PadicInt ℓ) (Padic ℓ)
  have hι_inj : Function.Injective ι := IsFractionRing.injective (PadicInt ℓ) (Padic ℓ)
  let rep (α : Padic ℓ) : PadicInt ℓ × M := Classical.choose (IsLocalization.surj M α)
  have hrep : ∀ α : Padic ℓ, α * ι (rep α).2.1 = ι (rep α).1 :=
    fun α => Classical.choose_spec (IsLocalization.surj M α)
  let gFun (α : Padic ℓ) : EndQ := rho_Z (rep α).1 * invS (rep α).2
  have hgFun_spec : ∀ (α : Padic ℓ) (z : PadicInt ℓ) (s : M),
      α * ι s.1 = ι z → gFun α = rho_Z z * invS s := by
    intro α z s hα
    apply h_frac_eq (rep α).1 z (rep α).2 s
    apply hι_inj
    calc
      ι ((rep α).1 * s.1) = ι (rep α).1 * ι s.1 := map_mul ι _ _
      _ = (α * ι (rep α).2.1) * ι s.1 := by rw [← hrep α]
      _ = (α * ι s.1) * ι (rep α).2.1 := by ring
      _ = ι z * ι (rep α).2.1 := by rw [hα]
      _ = ι (z * (rep α).2.1) := (map_mul ι _ _).symm
  have hg_ι : ∀ z : PadicInt ℓ, gFun (ι z) = rho_Z z := by
    intro z
    have h1 : ι z * ι (1 : M).1 = ι z := by
      rw [Submonoid.coe_one, map_one, mul_one]
    rw [hgFun_spec (ι z) z 1 h1, h_inv_one, mul_one]
  let rho : Padic ℓ →+* EndQ :=
    { toFun := gFun
      map_one' := by
        rw [← map_one ι, hg_ι 1, map_one]
      map_mul' := fun α₁ α₂ => by
        have h12 : (α₁ * α₂) * ι ((rep α₁).2 * (rep α₂).2).1 =
            ι ((rep α₁).1 * (rep α₂).1) := by
          rw [Submonoid.coe_mul, map_mul, map_mul]
          calc
            (α₁ * α₂) * (ι (rep α₁).2.1 * ι (rep α₂).2.1)
              = (α₁ * ι (rep α₁).2.1) * (α₂ * ι (rep α₂).2.1) := by ring
            _ = ι (rep α₁).1 * ι (rep α₂).1 := by rw [hrep α₁, hrep α₂]
        rw [hgFun_spec (α₁ * α₂) ((rep α₁).1 * (rep α₂).1) ((rep α₁).2 * (rep α₂).2) h12,
          map_mul, h_inv_mul_s]
        calc
          (rho_Z (rep α₁).1 * rho_Z (rep α₂).1) * (invS (rep α₁).2 * invS (rep α₂).2)
            = rho_Z (rep α₁).1 * (rho_Z (rep α₂).1 * invS (rep α₁).2) * invS (rep α₂).2 := by
              simp only [mul_assoc]
          _ = rho_Z (rep α₁).1 * (invS (rep α₁).2 * rho_Z (rep α₂).1) * invS (rep α₂).2 := by
              rw [h_f_inv (rep α₂).1 (rep α₁).2]
          _ = (rho_Z (rep α₁).1 * invS (rep α₁).2) * (rho_Z (rep α₂).1 * invS (rep α₂).2) := by
              simp only [mul_assoc]
      map_zero' := by
        rw [← map_zero ι, hg_ι 0, map_zero]
      map_add' := fun α₁ α₂ => by
        have h12 : (α₁ + α₂) * ι ((rep α₁).2 * (rep α₂).2).1 =
            ι ((rep α₁).1 * (rep α₂).2.1 + (rep α₂).1 * (rep α₁).2.1) := by
          rw [Submonoid.coe_mul, map_mul, map_add, map_mul, map_mul]
          calc
            (α₁ + α₂) * (ι (rep α₁).2.1 * ι (rep α₂).2.1)
              = (α₁ * ι (rep α₁).2.1) * ι (rep α₂).2.1 +
                (α₂ * ι (rep α₂).2.1) * ι (rep α₁).2.1 := by ring
            _ = ι (rep α₁).1 * ι (rep α₂).2.1 + ι (rep α₂).1 * ι (rep α₁).2.1 := by
              rw [hrep α₁, hrep α₂]
        rw [hgFun_spec (α₁ + α₂)
          ((rep α₁).1 * (rep α₂).2.1 + (rep α₂).1 * (rep α₁).2.1)
          ((rep α₁).2 * (rep α₂).2) h12,
          map_add, add_mul]
        have ht₁ : rho_Z ((rep α₁).1 * (rep α₂).2.1) * invS ((rep α₁).2 * (rep α₂).2) =
            gFun α₁ := by
          rw [map_mul, h_inv_mul_s, h_inv_inv (rep α₁).2 (rep α₂).2]
          calc
            (rho_Z (rep α₁).1 * rho_Z (rep α₂).2.1) * (invS (rep α₂).2 * invS (rep α₁).2)
              = rho_Z (rep α₁).1 * (rho_Z (rep α₂).2.1 * invS (rep α₂).2) * invS (rep α₁).2 := by
                simp only [mul_assoc]
            _ = rho_Z (rep α₁).1 * 1 * invS (rep α₁).2 := by rw [h_mul_inv (rep α₂).2]
            _ = gFun α₁ := by rw [mul_one]
        have ht₂ : rho_Z ((rep α₂).1 * (rep α₁).2.1) * invS ((rep α₁).2 * (rep α₂).2) =
            gFun α₂ := by
          rw [map_mul, h_inv_mul_s]
          calc
            (rho_Z (rep α₂).1 * rho_Z (rep α₁).2.1) * (invS (rep α₁).2 * invS (rep α₂).2)
              = rho_Z (rep α₂).1 * (rho_Z (rep α₁).2.1 * invS (rep α₁).2) * invS (rep α₂).2 := by
                simp only [mul_assoc]
            _ = rho_Z (rep α₂).1 * 1 * invS (rep α₂).2 := by rw [h_mul_inv (rep α₁).2]
            _ = gFun α₂ := by rw [mul_one]
        rw [ht₁, ht₂] }
  let hMod : Module (Padic ℓ) V₀ := Module.compHom V₀ rho
  refine ⟨V₀, inferInstance, hMod, AddEquiv.refl V₀, fun z x y hy => ?_⟩
  have hy_eq : y = lam_L z x := by
    apply Subtype.ext; funext r
    exact hy r
  change TensorProduct.tmul ℤ (1 : ℚ) y =
    (rho (ι z)) (TensorProduct.tmul ℤ (1 : ℚ) x)
  have h_rho_ι : rho (ι z) = rho_Z z := hg_ι z
  rw [h_rho_ι, h_rho_Z_tmul z (1 : ℚ) x, hy_eq]

theorem weil_padic_gen_ext_sign_and_linear_lift (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (P : Type u) [AddCommGroup P] (L_sub : AddSubgroup P)
      (V : Type u) [AddCommGroup V] [Module (Padic ℓ) V]
      (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V),
      (∀ x y : ↥L_sub,
        (x = y → equiv (TensorProduct.tmul ℤ (1 : ℚ) x) = equiv (TensorProduct.tmul ℤ (1 : ℚ) y)) ∧
        (x = -y → equiv (TensorProduct.tmul ℤ (1 : ℚ) x) =
          (-1 : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) y))) ∧
      (∀ {E : Type u} [AddCommGroup E] [Module (Padic ℓ) E] (g₁ g₂ : V →ₗ[Padic ℓ] E),
        (∀ x : ↥L_sub, g₁ (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          g₂ (equiv (TensorProduct.tmul ℤ (1 : ℚ) x))) →
        g₁ = g₂)) ∧
    (∀ (G₁ G₂ : ℕ → Type u) [∀ r : ℕ, AddCommGroup (G₁ r)] [∀ r : ℕ, AddCommGroup (G₂ r)]
      (h_ann₂ : ∀ (r : ℕ) (u : G₂ r), (ℓ ^ r) • u = 0)
      (τ₁ : ∀ r : ℕ, G₁ (r + 1) →+ G₁ r) (τ₂ : ∀ r : ℕ, G₂ (r + 1) →+ G₂ r)
      (L₁ : AddSubgroup (∀ r : ℕ, G₁ r)) (L₂ : AddSubgroup (∀ r : ℕ, G₂ r))
      (hL₁ : ∀ seq : ∀ r : ℕ, G₁ r, seq ∈ L₁ ↔ ∀ r : ℕ, τ₁ r (seq (r + 1)) = seq r)
      (hL₂ : ∀ seq : ∀ r : ℕ, G₂ r, seq ∈ L₂ ↔ ∀ r : ℕ, τ₂ r (seq (r + 1)) = seq r)
      (V₁ V₂ : Type u) [AddCommGroup V₁] [Module (Padic ℓ) V₁]
      [AddCommGroup V₂] [Module (Padic ℓ) V₂]
      (equiv₁ : TensorProduct ℤ ℚ ↥L₁ ≃+ V₁) (equiv₂ : TensorProduct ℤ ℚ ↥L₂ ≃+ V₂)
      (hsmul₁ : ∀ (z : PadicInt ℓ) (x y : ↥L₁),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))
      (hsmul₂ : ∀ (z : PadicInt ℓ) (x y : ↥L₂),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x))
      (p : ∀ r : ℕ, G₂ r →+ G₁ r),
      (∀ (r : ℕ) (u : G₂ (r + 1)), τ₁ r (p (r + 1) u) = p r (τ₂ r u)) →
      ∃ f : V₂ →ₗ[Padic ℓ] V₁,
        ∀ (x : ↥L₂) (y : ↥L₁), (∀ r : ℕ, y.1 r = p r (x.1 r)) →
          f (equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y)) :=
by
  have h_rat_tmul : ∀ (P : Type u) [AddCommGroup P] (L_sub : AddSubgroup P)
      (V : Type u) [AddCommGroup V] [Module (Padic ℓ) V]
      (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V) (q : ℚ) (x : ↥L_sub),
      equiv (TensorProduct.tmul ℤ q x) =
        (q : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    intro P _ L_sub V _ _ equiv q x
    let b : ℕ := q.den
    let a : ℤ := q.num
    have hb_nz : b ≠ 0 := q.den_nz
    have h_rat_eq : (b : ℚ) * q = (a : ℚ) := Rat.den_mul_eq_num q
    have hq_zsmul : ((b : ℤ) • q : ℚ) = a • (1 : ℚ) := by
      rw [zsmul_eq_mul, zsmul_eq_mul, Int.cast_natCast, mul_one]
      exact h_rat_eq
    have htp : (b : ℤ) • TensorProduct.tmul ℤ q x = a • TensorProduct.tmul ℤ (1 : ℚ) x := by
      rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', hq_zsmul]
    have hev := congrArg equiv htp
    rw [map_zsmul, map_zsmul, ← Int.cast_smul_eq_zsmul (Padic ℓ),
      ← Int.cast_smul_eq_zsmul (Padic ℓ), Int.cast_natCast] at hev
    have h_padic_eq : (b : Padic ℓ) * (q : Padic ℓ) = (a : Padic ℓ) := by
      have h := congrArg (Rat.cast : ℚ → Padic ℓ) h_rat_eq
      rwa [Rat.cast_mul, Rat.cast_natCast, Rat.cast_intCast] at h
    rw [← h_padic_eq, mul_smul] at hev
    have hb_padic : (b : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hb_nz
    have h_cancel := congrArg ((b : Padic ℓ)⁻¹ • ·) hev
    simpa only [inv_smul_smul₀ hb_padic] using h_cancel
  refine ⟨?_, ?_⟩
  · intro P _ L_sub V _ _ equiv
    refine ⟨?_, ?_⟩
    · intro x y
      refine ⟨fun hxy => congrArg (fun w => equiv (TensorProduct.tmul ℤ (1 : ℚ) w)) hxy, ?_⟩
      rintro rfl
      rw [TensorProduct.tmul_neg, map_neg, ← neg_one_smul (Padic ℓ)]
    · intro E _ _ g₁ g₂ hg
      ext v
      rw [← equiv.apply_symm_apply v]
      refine TensorProduct.induction_on (motive := fun t => g₁ (equiv t) = g₂ (equiv t))
        (equiv.symm v) ?_ ?_ ?_
      · rw [map_zero, map_zero, map_zero]
      · intro q x
        rw [h_rat_tmul P L_sub V equiv q x, map_smul, map_smul, hg x]
      · intro t₁ t₂ ht₁ ht₂
        rw [map_add, map_add, map_add, ht₁, ht₂]
  · intro G₁ G₂ _ _ h_ann₂ τ₁ τ₂ L₁ L₂ hL₁ hL₂ V₁ V₂ _ _ _ _ equiv₁ equiv₂ hsmul₁ hsmul₂ p hp
    letI hNeZero : ∀ r : ℕ, NeZero (ℓ ^ r) :=
      fun r => ⟨(pow_pos (Fact.out : Nat.Prime ℓ).pos r).ne'⟩
    let p_L : ↥L₂ →+ ↥L₁ :=
      { toFun := fun x => ⟨fun r => p r (x.1 r), (hL₁ _).mpr fun r =>
          (hp r (x.1 (r + 1))).trans (congrArg (p r) ((hL₂ x.1).mp x.2 r))⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (p r))
        map_add' := fun x₁ x₂ => Subtype.ext (funext fun r => map_add (p r) (x₁.1 r) (x₂.1 r)) }
    have h_mod_smul : ∀ (r a : ℕ) (u : G₂ r), ((a : ZMod (ℓ ^ r)).val) • u = a • u := by
      intro r a u
      calc
        ((a : ZMod (ℓ ^ r)).val) • u = (a % (ℓ ^ r)) • u := by rw [ZMod.val_natCast]
        _ = (a / (ℓ ^ r)) • ((ℓ ^ r) • u) + (a % (ℓ ^ r)) • u := by
          rw [h_ann₂ r u, nsmul_zero, zero_add]
        _ = ((ℓ ^ r) * (a / (ℓ ^ r)) + a % (ℓ ^ r)) • u := by
          rw [← mul_nsmul', ← add_nsmul, mul_comm]
        _ = a • u := by rw [Nat.div_add_mod]
    let ψ : ↥L₂ →+ V₁ :=
      equiv₁.toAddMonoidHom.comp ((TensorProduct.mk ℤ ℚ ↥L₁ (1 : ℚ)).toAddMonoidHom.comp p_L)
    have h_equiv_z : ∀ (z : PadicInt ℓ) (x : ↥L₂),
        ∃ x_z : ↥L₂,
          equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x_z) =
            (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x) ∧
          ψ x_z = (z : Padic ℓ) • ψ x := by
      intro z x
      let s : ∀ r : ℕ, G₂ r := fun r => (PadicInt.toZModPow r z).val • x.1 r
      have hs : s ∈ L₂ := (hL₂ s).mpr fun r => by
        dsimp only [s]
        let w : ZMod (ℓ ^ (r + 1)) := PadicInt.toZModPow (r + 1) z
        have hw_cast : (w.val : ZMod (ℓ ^ r)) = PadicInt.toZModPow r z := by
          rw [ZMod.natCast_val]
          exact PadicInt.cast_toZModPow r (r + 1) (Nat.le_succ r) z
        calc
          τ₂ r (w.val • x.1 (r + 1)) = w.val • τ₂ r (x.1 (r + 1)) := map_nsmul (τ₂ r) _ _
          _ = w.val • x.1 r := by rw [(hL₂ x.1).mp x.2 r]
          _ = ((w.val : ZMod (ℓ ^ r)).val) • x.1 r := (h_mod_smul r w.val (x.1 r)).symm
          _ = (PadicInt.toZModPow r z).val • x.1 r := by rw [hw_cast]
      let x_z : ↥L₂ := ⟨s, hs⟩
      refine ⟨x_z, hsmul₂ z x x_z (fun _ => rfl), ?_⟩
      exact hsmul₁ z (p_L x) (p_L x_z) (fun r => map_nsmul (p r) _ _)
    let B_ψ : ℚ →ₗ[ℤ] ↥L₂ →ₗ[ℤ] V₁ :=
      LinearMap.mk₂ ℤ (fun q x => (q : Padic ℓ) • ψ x)
        (fun q₁ q₂ x => by rw [Rat.cast_add, add_smul])
        (fun c q x => by
          rw [zsmul_eq_mul, Rat.cast_mul, Rat.cast_intCast, mul_smul,
            Int.cast_smul_eq_zsmul (Padic ℓ)])
        (fun q x₁ x₂ => by rw [map_add, smul_add])
        (fun c q x => by
          rw [map_zsmul, ← Int.cast_smul_eq_zsmul (Padic ℓ), smul_comm,
            Int.cast_smul_eq_zsmul (Padic ℓ)])
    let T_ψ : TensorProduct ℤ ℚ ↥L₂ →ₗ[ℤ] V₁ := TensorProduct.lift B_ψ
    let f_add : V₂ →+ V₁ := T_ψ.toAddMonoidHom.comp equiv₂.symm.toAddMonoidHom
    have hf_tmul : ∀ (q : ℚ) (x : ↥L₂),
        f_add (equiv₂ (TensorProduct.tmul ℤ q x)) = (q : Padic ℓ) • ψ x := by
      intro q x
      change T_ψ (equiv₂.symm (equiv₂ (TensorProduct.tmul ℤ q x))) = _
      rw [equiv₂.symm_apply_apply]
      exact TensorProduct.lift.tmul q x
    have hf_zsmul : ∀ (z : PadicInt ℓ) (v : V₂),
        f_add ((z : Padic ℓ) • v) = (z : Padic ℓ) • f_add v := by
      intro z v
      rw [← equiv₂.apply_symm_apply v]
      refine TensorProduct.induction_on
        (motive := fun t => f_add ((z : Padic ℓ) • equiv₂ t) = (z : Padic ℓ) • f_add (equiv₂ t))
        (equiv₂.symm v) ?_ ?_ ?_
      · rw [map_zero, smul_zero, map_zero, smul_zero]
      · intro q x
        obtain ⟨x_z, hx_ev, hx_ψ⟩ := h_equiv_z z x
        have h_z_eq : (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ q x) =
            equiv₂ (TensorProduct.tmul ℤ q x_z) := by
          rw [h_rat_tmul _ L₂ V₂ equiv₂ q x, smul_comm, ← hx_ev,
            ← h_rat_tmul _ L₂ V₂ equiv₂ q x_z]
        rw [h_z_eq, hf_tmul q x_z, hx_ψ, smul_comm, ← hf_tmul q x]
      · intro t₁ t₂ ht₁ ht₂
        rw [map_add, smul_add, map_add, ht₁, ht₂, ← smul_add, ← map_add]
    have hf_smul : ∀ (α : Padic ℓ) (v : V₂), f_add (α • v) = α • f_add v := by
      intro α v
      obtain ⟨⟨z, s⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors (PadicInt ℓ)) α
      have hzs' : (s.1 : Padic ℓ) * α = (z : Padic ℓ) := by
        rw [mul_comm]
        exact hzs
      have hs_ne : (s.1 : Padic ℓ) ≠ 0 :=
        IsLocalization.to_map_ne_zero_of_mem_nonZeroDivisors
          (M := nonZeroDivisors (PadicInt ℓ)) (S := Padic ℓ) le_rfl s.2
      have h_eq : (s.1 : Padic ℓ) • f_add (α • v) = (s.1 : Padic ℓ) • (α • f_add v) := by
        calc
          (s.1 : Padic ℓ) • f_add (α • v) = f_add ((s.1 : Padic ℓ) • (α • v)) :=
            (hf_zsmul s.1 (α • v)).symm
          _ = f_add (((s.1 : Padic ℓ) * α) • v) := by rw [mul_smul]
          _ = f_add ((z : Padic ℓ) • v) := by rw [hzs']
          _ = (z : Padic ℓ) • f_add v := hf_zsmul z v
          _ = ((s.1 : Padic ℓ) * α) • f_add v := by rw [← hzs']
          _ = (s.1 : Padic ℓ) • (α • f_add v) := by rw [mul_smul]
      have h_cancel := congrArg ((s.1 : Padic ℓ)⁻¹ • ·) h_eq
      simpa only [inv_smul_smul₀ hs_ne] using h_cancel
    let f : V₂ →ₗ[Padic ℓ] V₁ :=
      { toFun := f_add
        map_add' := f_add.map_add
        map_smul' := fun α v => by
          dsimp only [RingHom.id_apply]
          exact hf_smul α v }
    refine ⟨f, fun x y hy => ?_⟩
    have hpL_eq : p_L x = y := Subtype.ext (funext fun r => (hy r).symm)
    change f_add (equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) = _
    rw [hf_tmul (1 : ℚ) x, Rat.cast_one, one_smul]
    exact congrArg (fun w => equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) w)) hpL_eq

theorem weil_padic_bilinear_cup_lift (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G_a G_b G_c : ℕ → Type u)
    [∀ r : ℕ, AddCommGroup (G_a r)] [∀ r : ℕ, AddCommGroup (G_b r)]
    [∀ r : ℕ, AddCommGroup (G_c r)]
    (h_ann_a : ∀ (r : ℕ) (u : G_a r), (ℓ ^ r) • u = 0)
    (h_ann_b : ∀ (r : ℕ) (v : G_b r), (ℓ ^ r) • v = 0)
    (τ_a : ∀ r : ℕ, G_a (r + 1) →+ G_a r)
    (τ_b : ∀ r : ℕ, G_b (r + 1) →+ G_b r)
    (τ_c : ∀ r : ℕ, G_c (r + 1) →+ G_c r)
    (L_a : AddSubgroup (∀ r : ℕ, G_a r))
    (L_b : AddSubgroup (∀ r : ℕ, G_b r))
    (L_c : AddSubgroup (∀ r : ℕ, G_c r))
    (hL_a : ∀ seq : ∀ r : ℕ, G_a r, seq ∈ L_a ↔ ∀ r : ℕ, τ_a r (seq (r + 1)) = seq r)
    (hL_b : ∀ seq : ∀ r : ℕ, G_b r, seq ∈ L_b ↔ ∀ r : ℕ, τ_b r (seq (r + 1)) = seq r)
    (hL_c : ∀ seq : ∀ r : ℕ, G_c r, seq ∈ L_c ↔ ∀ r : ℕ, τ_c r (seq (r + 1)) = seq r)
    (V_a V_b V_c : Type u)
    [AddCommGroup V_a] [Module (Padic ℓ) V_a]
    [AddCommGroup V_b] [Module (Padic ℓ) V_b]
    [AddCommGroup V_c] [Module (Padic ℓ) V_c]
    (equiv_a : TensorProduct ℤ ℚ ↥L_a ≃+ V_a)
    (equiv_b : TensorProduct ℤ ℚ ↥L_b ≃+ V_b)
    (equiv_c : TensorProduct ℤ ℚ ↥L_c ≃+ V_c)
    (hsmul_a : ∀ (z : PadicInt ℓ) (x y : ↥L_a),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
        equiv_a (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv_a (TensorProduct.tmul ℤ (1 : ℚ) x))
    (hsmul_b : ∀ (z : PadicInt ℓ) (x y : ↥L_b),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
        equiv_b (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv_b (TensorProduct.tmul ℤ (1 : ℚ) x))
    (hsmul_c : ∀ (z : PadicInt ℓ) (x y : ↥L_c),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
        equiv_c (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv_c (TensorProduct.tmul ℤ (1 : ℚ) x))
    (c_tors : ∀ r : ℕ, G_a r →+ G_b r →+ G_c r)
    (hc : ∀ (r : ℕ) (u : G_a (r + 1)) (v : G_b (r + 1)),
      τ_c r (c_tors (r + 1) u v) = c_tors r (τ_a r u) (τ_b r v)) :
    ∃ cup : V_a →ₗ[Padic ℓ] V_b →ₗ[Padic ℓ] V_c,
      ∀ (x : ↥L_a) (y : ↥L_b) (z : ↥L_c),
        (∀ r : ℕ, z.1 r = c_tors r (x.1 r) (y.1 r)) →
        cup (equiv_a (TensorProduct.tmul ℤ (1 : ℚ) x))
            (equiv_b (TensorProduct.tmul ℤ (1 : ℚ) y)) =
          equiv_c (TensorProduct.tmul ℤ (1 : ℚ) z) :=
by
  classical
  have h_prime : Nat.Prime ℓ := Fact.out
  have h_neZero : ∀ r : ℕ, NeZero (ℓ ^ r) := fun r => ⟨(pow_pos h_prime.pos r).ne'⟩
  have h_closed : ∀ (G : ℕ → Type u) [∀ r : ℕ, AddCommGroup (G r)]
      (h_ann : ∀ (r : ℕ) (u : G r), (ℓ ^ r) • u = 0)
      (τ : ∀ r : ℕ, G (r + 1) →+ G r)
      (L_sub : AddSubgroup (∀ r : ℕ, G r))
      (hL : ∀ seq : ∀ r : ℕ, G r, seq ∈ L_sub ↔ ∀ r : ℕ, τ r (seq (r + 1)) = seq r)
      (z : PadicInt ℓ) (x : ↥L_sub),
      (fun r : ℕ => (PadicInt.toZModPow r z).val • x.1 r) ∈ L_sub := by
    intro G _ h_ann τ L_sub hL z x
    have h_mod_nsmul : ∀ (r a : ℕ) (u : G r), ((a : ZMod (ℓ ^ r)).val) • u = a • u := by
      intro r a u
      rw [ZMod.val_natCast]
      conv_rhs => rw [← Nat.div_add_mod a (ℓ ^ r)]
      rw [add_nsmul, mul_comm (ℓ ^ r) (a / (ℓ ^ r)), mul_nsmul', h_ann r u, nsmul_zero, zero_add]
    rw [hL]
    intro r
    have : NeZero (ℓ ^ (r + 1)) := h_neZero (r + 1)
    rw [map_nsmul, (hL x.1).mp x.2 r, ← h_mod_nsmul r _ (x.1 r)]
    have h_cast : (((PadicInt.toZModPow (r + 1) z).val : ZMod (ℓ ^ r))) =
        PadicInt.toZModPow r z := by
      have hcomp := RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r)) z
      simp only [RingHom.comp_apply, ZMod.castHom_apply] at hcomp
      rw [ZMod.natCast_val]
      exact hcomp
    rw [h_cast]
  have h_rat : ∀ {P : Type u} [AddCommGroup P] (L_sub : AddSubgroup P)
      {V : Type u} [AddCommGroup V] [Module (Padic ℓ) V]
      (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V) (q : ℚ) (x : ↥L_sub),
      equiv (TensorProduct.tmul ℤ q x) =
        (q : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    intro P _ L_sub V _ _ equiv q x
    let b_z : ℤ := (q.den : ℤ)
    let a : ℤ := q.num
    have hq_eq : b_z • q = a • (1 : ℚ) := by
      simp only [b_z, a, zsmul_eq_mul, mul_one, Int.cast_natCast]
      rw [mul_comm, Rat.mul_den_eq_num]
    have htp : b_z • TensorProduct.tmul ℤ q x = a • TensorProduct.tmul ℤ (1 : ℚ) x := by
      rw [TensorProduct.smul_tmul', hq_eq, ← TensorProduct.smul_tmul']
    have hev : (b_z : Padic ℓ) • equiv (TensorProduct.tmul ℤ q x) =
        (a : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
      rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul, ← map_zsmul, ← map_zsmul, htp]
    have ha_padic : (a : Padic ℓ) = (b_z : Padic ℓ) * (q : Padic ℓ) := by
      have hnum : (a : ℚ) = (b_z : ℚ) * q := by
        simp only [a, b_z, Int.cast_natCast]
        rw [mul_comm, Rat.mul_den_eq_num]
      calc
        (a : Padic ℓ) = ((a : ℚ) : Padic ℓ) := (Rat.cast_intCast a).symm
        _ = (((b_z : ℚ) * q : ℚ) : Padic ℓ) := by rw [hnum]
        _ = (b_z : Padic ℓ) * (q : Padic ℓ) := by rw [Rat.cast_mul, Rat.cast_intCast]
    rw [ha_padic, mul_smul] at hev
    have hbz_ne : (b_z : Padic ℓ) ≠ 0 := by
      simp only [b_z, Int.cast_natCast]
      exact Nat.cast_ne_zero.mpr q.den_nz
    calc
      equiv (TensorProduct.tmul ℤ q x) =
          (b_z : Padic ℓ)⁻¹ • ((b_z : Padic ℓ) • equiv (TensorProduct.tmul ℤ q x)) :=
        (inv_smul_smul₀ hbz_ne _).symm
      _ = (b_z : Padic ℓ)⁻¹ • ((b_z : Padic ℓ) • ((q : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
        rw [hev]
      _ = (q : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x) :=
        inv_smul_smul₀ hbz_ne _
  have h_ext : ∀ {P : Type u} [AddCommGroup P] (L_sub : AddSubgroup P)
      {V : Type u} [AddCommGroup V] [Module (Padic ℓ) V]
      (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V)
      {E : Type u} [AddCommGroup E] [Module (Padic ℓ) E]
      (g₁ g₂ : V →ₗ[Padic ℓ] E),
      (∀ x : ↥L_sub, g₁ (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        g₂ (equiv (TensorProduct.tmul ℤ (1 : ℚ) x))) →
      g₁ = g₂ := by
    intro P _ L_sub V _ _ equiv E _ _ g₁ g₂ hg
    ext v
    rw [← equiv.apply_symm_apply v]
    refine TensorProduct.inductionOn (motive := fun t => g₁ (equiv t) = g₂ (equiv t))
      (equiv.symm v) ?_ ?_
    · intro q x
      rw [h_rat L_sub equiv q x, map_smul, map_smul, hg x]
    · intro t₁ t₂ ih₁ ih₂
      rw [map_add, map_add, map_add, ih₁, ih₂]
  have h_lift : ∀ (G : ℕ → Type u) [∀ r : ℕ, AddCommGroup (G r)]
      (L_sub : AddSubgroup (∀ r : ℕ, G r))
      (h_cl : ∀ (z : PadicInt ℓ) (x : ↥L_sub),
        (fun r : ℕ => (PadicInt.toZModPow r z).val • x.1 r) ∈ L_sub)
      {V : Type u} [AddCommGroup V] [Module (Padic ℓ) V]
      (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V)
      (hsmul : ∀ (z : PadicInt ℓ) (x y : ↥L_sub),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x))
      {E : Type u} [AddCommGroup E] [Module (Padic ℓ) E]
      (ψ : ↥L_sub →+ E)
      (hψ_smul : ∀ (z : PadicInt ℓ) (x x_z : ↥L_sub),
        (∀ r : ℕ, x_z.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          ψ x_z = (z : Padic ℓ) • ψ x),
      ∃ f : V →ₗ[Padic ℓ] E,
        ∀ x : ↥L_sub, f (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) = ψ x := by
    intro G _ L_sub h_cl V _ _ equiv hsmul E _ _ ψ hψ_smul
    let bilin_QE : ℚ →ₗ[ℤ] ↥L_sub →ₗ[ℤ] E :=
      LinearMap.mk₂ ℤ (fun q x => (q : Padic ℓ) • ψ x)
        (fun q₁ q₂ x => by rw [Rat.cast_add, add_smul])
        (fun n q x => by
          rw [zsmul_eq_mul, Rat.cast_mul, Rat.cast_intCast, mul_smul, Int.cast_smul_eq_zsmul])
        (fun q x₁ x₂ => by rw [map_add, smul_add])
        (fun n q x => by
          rw [map_zsmul, ← Int.cast_smul_eq_zsmul (Padic ℓ), smul_smul,
            mul_comm (q : Padic ℓ) (n : Padic ℓ), ← smul_smul, Int.cast_smul_eq_zsmul])
    let f_add : V →+ E :=
      (TensorProduct.lift bilin_QE).toAddMonoidHom.comp equiv.symm.toAddMonoidHom
    have hf_add : ∀ (q : ℚ) (x : ↥L_sub),
        f_add (equiv (TensorProduct.tmul ℤ q x)) = (q : Padic ℓ) • ψ x := by
      intro q x
      dsimp [f_add, bilin_QE]
      rw [equiv.symm_apply_apply, TensorProduct.lift.tmul, LinearMap.mk₂_apply]
    have hf_z : ∀ (z : PadicInt ℓ) (v : V),
        f_add ((z : Padic ℓ) • v) = (z : Padic ℓ) • f_add v := by
      intro z v
      rw [← equiv.apply_symm_apply v]
      refine TensorProduct.inductionOn
        (motive := fun t => f_add ((z : Padic ℓ) • equiv t) = (z : Padic ℓ) • f_add (equiv t))
        (equiv.symm v) ?_ ?_
      · intro q x
        let x_z : ↥L_sub := ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, h_cl z x⟩
        have h_eq_v : (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ q x) =
            equiv (TensorProduct.tmul ℤ q x_z) := by
          rw [h_rat L_sub equiv q x, smul_smul, mul_comm (z : Padic ℓ) (q : Padic ℓ),
            ← smul_smul, ← hsmul z x x_z (fun _ => rfl), ← h_rat L_sub equiv q x_z]
        rw [h_eq_v, hf_add q x_z, hψ_smul z x x_z (fun _ => rfl), smul_smul,
          mul_comm (q : Padic ℓ) (z : Padic ℓ), ← smul_smul, ← hf_add q x]
      · intro t₁ t₂ ih₁ ih₂
        rw [map_add, smul_add, map_add, ih₁, ih₂, map_add, smul_add]
    have hf_smul : ∀ (α : Padic ℓ) (v : V), f_add (α • v) = α • f_add v := by
      intro α v
      obtain ⟨⟨z, s⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors (PadicInt ℓ)) α
      dsimp only at hzs
      have hs_ne0 : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have h_alg_coe : ∀ w : PadicInt ℓ, algebraMap (PadicInt ℓ) (Padic ℓ) w = (w : Padic ℓ) :=
        fun _ => rfl
      rw [h_alg_coe s.1, h_alg_coe z] at hzs
      have hs_padic : (s.1 : Padic ℓ) ≠ 0 := fun h0 => hs_ne0 (Subtype.coe_inj.mp h0)
      have hmul : (s.1 : Padic ℓ) * α = (z : Padic ℓ) := by rw [mul_comm, hzs]
      have key : (s.1 : Padic ℓ) • f_add (α • v) = (s.1 : Padic ℓ) • (α • f_add v) := by
        rw [← hf_z s.1 (α • v), ← mul_smul, hmul, hf_z z v, ← hmul, mul_smul]
      calc
        f_add (α • v) = (s.1 : Padic ℓ)⁻¹ • ((s.1 : Padic ℓ) • f_add (α • v)) :=
          (inv_smul_smul₀ hs_padic _).symm
        _ = (s.1 : Padic ℓ)⁻¹ • ((s.1 : Padic ℓ) • (α • f_add v)) := by rw [key]
        _ = α • f_add v := inv_smul_smul₀ hs_padic _
    refine ⟨{ toFun := f_add, map_add' := f_add.map_add, map_smul' := hf_smul }, ?_⟩
    intro x
    change f_add (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) = ψ x
    rw [hf_add (1 : ℚ) x, Rat.cast_one, one_smul]
  let B_L (x : ↥L_a) (y : ↥L_b) : ↥L_c :=
    ⟨fun r => c_tors r (x.1 r) (y.1 r), (hL_c _).mpr fun r => by
      rw [hc r (x.1 (r + 1)) (y.1 (r + 1)), (hL_a x.1).mp x.2 r, (hL_b y.1).mp y.2 r]⟩
  have hB_zero_right : ∀ x : ↥L_a, B_L x 0 = 0 := by
    intro x
    ext r
    exact map_zero (c_tors r (x.1 r))
  have hB_add_right : ∀ (x : ↥L_a) (y₁ y₂ : ↥L_b), B_L x (y₁ + y₂) = B_L x y₁ + B_L x y₂ := by
    intro x y₁ y₂
    ext r
    exact map_add (c_tors r (x.1 r)) (y₁.1 r) (y₂.1 r)
  have hB_zero_left : ∀ y : ↥L_b, B_L 0 y = 0 := by
    intro y
    ext r
    change (c_tors r 0) (y.1 r) = 0
    rw [map_zero, AddMonoidHom.zero_apply]
  have hB_add_left : ∀ (x₁ x₂ : ↥L_a) (y : ↥L_b), B_L (x₁ + x₂) y = B_L x₁ y + B_L x₂ y := by
    intro x₁ x₂ y
    ext r
    change (c_tors r (x₁.1 r + x₂.1 r)) (y.1 r) =
      c_tors r (x₁.1 r) (y.1 r) + c_tors r (x₂.1 r) (y.1 r)
    rw [map_add, AddMonoidHom.add_apply]
  let ψ_b (x : ↥L_a) : ↥L_b →+ V_c :=
    { toFun := fun y => equiv_c (TensorProduct.tmul ℤ (1 : ℚ) (B_L x y))
      map_zero' := by rw [hB_zero_right x, TensorProduct.tmul_zero, map_zero]
      map_add' := fun y₁ y₂ => by rw [hB_add_right x y₁ y₂, TensorProduct.tmul_add, map_add] }
  have h_ex_b : ∀ x : ↥L_a, ∃ f : V_b →ₗ[Padic ℓ] V_c,
      ∀ y : ↥L_b, f (equiv_b (TensorProduct.tmul ℤ (1 : ℚ) y)) = ψ_b x y := by
    intro x
    refine h_lift G_b L_b (h_closed G_b h_ann_b τ_b L_b hL_b) equiv_b hsmul_b (ψ_b x) ?_
    intro z y y_z hy_z
    exact hsmul_c z (B_L x y) (B_L x y_z) fun r => by
      change c_tors r (x.1 r) (y_z.1 r) = (PadicInt.toZModPow r z).val • c_tors r (x.1 r) (y.1 r)
      rw [hy_z r, map_nsmul]
  let cup_x : ↥L_a → (V_b →ₗ[Padic ℓ] V_c) := fun x => (h_ex_b x).choose
  have hcup_x : ∀ (x : ↥L_a) (y : ↥L_b),
      cup_x x (equiv_b (TensorProduct.tmul ℤ (1 : ℚ) y)) =
        equiv_c (TensorProduct.tmul ℤ (1 : ℚ) (B_L x y)) :=
    fun x y => (h_ex_b x).choose_spec y
  let Ψ : ↥L_a →+ (V_b →ₗ[Padic ℓ] V_c) :=
    { toFun := cup_x
      map_zero' := by
        apply h_ext L_b equiv_b
        intro y
        rw [hcup_x 0 y, hB_zero_left y, TensorProduct.tmul_zero, map_zero, LinearMap.zero_apply]
      map_add' := fun x₁ x₂ => by
        apply h_ext L_b equiv_b
        intro y
        rw [hcup_x (x₁ + x₂) y, hB_add_left x₁ x₂ y, TensorProduct.tmul_add, map_add,
          LinearMap.add_apply, hcup_x x₁ y, hcup_x x₂ y] }
  obtain ⟨cup, hcup⟩ := h_lift G_a L_a (h_closed G_a h_ann_a τ_a L_a hL_a) equiv_a hsmul_a Ψ
    (fun z x x_z hx_z => by
      apply h_ext L_b equiv_b
      intro y
      change cup_x x_z (equiv_b (TensorProduct.tmul ℤ (1 : ℚ) y)) =
        ((z : Padic ℓ) • cup_x x) (equiv_b (TensorProduct.tmul ℤ (1 : ℚ) y))
      rw [LinearMap.smul_apply, hcup_x x_z y, hcup_x x y]
      exact hsmul_c z (B_L x y) (B_L x_z y) fun r => by
        change c_tors r (x_z.1 r) (y.1 r) = (PadicInt.toZModPow r z).val • c_tors r (x.1 r) (y.1 r)
        rw [hx_z r, map_nsmul, AddMonoidHom.nsmul_apply])
  refine ⟨cup, ?_⟩
  intro x y z hz
  have hz_eq : z = B_L x y := Subtype.ext (funext hz)
  rw [hcup x]
  change cup_x x (equiv_b (TensorProduct.tmul ℤ (1 : ℚ) y)) = _
  rw [hcup_x x y, hz_eq]

theorem weil_lefschetz_ell_adic_space_and_limit_transport (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      Nonempty (WeilLefschetzEllAdicSpace W ℓ m)) ∧
    (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m : ℕ)
      (H₁ : WeilLefschetzEllAdicSpace W₁ ℓ m) (H₂ : WeilLefschetzEllAdicSpace W₂ ℓ m)
      (f : H₂.V →ₗ[Padic ℓ] H₁.V),
      WeilLefschetzIsEllAdicPullback h ℓ m H₁ H₂ f ↔
        ∃ p : ∀ r : ℕ, weilEtaleTorsionH W₂ (ℓ ^ r) m →+ weilEtaleTorsionH W₁ (ℓ ^ r) m,
          (∀ r : ℕ, WeilLefschetzTorsionPullback h (ℓ ^ r) m (p r)) ∧
          ∀ (x : ↥(weilEtaleIntegralSystem W₂ ℓ m)) (y : ↥(weilEtaleIntegralSystem W₁ ℓ m)),
            (∀ r : ℕ, y.1 r = p r (x.1 r)) →
              f (weilLefschetzSpaceGen H₂ x) = weilLefschetzSpaceGen H₁ y) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (a b c : ℕ) (hab : a + b = c)
      (H_a : WeilLefschetzEllAdicSpace W ℓ a)
      (H_b : WeilLefschetzEllAdicSpace W ℓ b)
      (H_c : WeilLefschetzEllAdicSpace W ℓ c)
      (cup : H_a.V →ₗ[Padic ℓ] H_b.V →ₗ[Padic ℓ] H_c.V),
      WeilLefschetzIsEllAdicCup W ℓ a b c hab H_a H_b H_c cup ↔
        ∃ c_tors : ∀ r : ℕ, weilEtaleTorsionH W (ℓ ^ r) a →+
            weilEtaleTorsionH W (ℓ ^ r) b →+ weilEtaleTorsionH W (ℓ ^ r) c,
          (∀ r : ℕ, WeilLefschetzIsTorsionCup W (ℓ ^ r) a b c hab (c_tors r)) ∧
          ∀ (x : ↥(weilEtaleIntegralSystem W ℓ a))
            (y : ↥(weilEtaleIntegralSystem W ℓ b))
            (z : ↥(weilEtaleIntegralSystem W ℓ c)),
            (∀ r : ℕ, z.1 r = c_tors r (x.1 r) (y.1 r)) →
              cup (weilLefschetzSpaceGen H_a x) (weilLefschetzSpaceGen H_b y) =
                weilLefschetzSpaceGen H_c z) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      (seq : ∀ r : ℕ, weilEtaleTorsionH W (ℓ ^ r) m),
      (∀ r : ℕ, weilEtaleTorsionTransition W ℓ r m (seq (r + 1)) = seq r) →
      ∃ x : ↥(weilEtaleIntegralSystem W ℓ m), ∀ r : ℕ, x.1 r = seq r) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      (x : ↥(weilEtaleIntegralSystem W ℓ m)) (r : ℕ),
      weilEtaleTorsionTransition W ℓ r m (x.1 (r + 1)) = x.1 r) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (H : WeilLefschetzEllAdicSpace W ℓ m)
      (x y : ↥(weilEtaleIntegralSystem W ℓ m)),
      ((∀ r : ℕ, x.1 r = y.1 r) → weilLefschetzSpaceGen H x = weilLefschetzSpaceGen H y) ∧
      ((∀ r : ℕ, x.1 r = -(y.1 r)) →
        weilLefschetzSpaceGen H x = (-1 : Padic ℓ) • weilLefschetzSpaceGen H y)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (H : WeilLefschetzEllAdicSpace W ℓ m)
      {E : Type u} [AddCommGroup E] [Module (Padic ℓ) E]
      (g₁ g₂ : H.V →ₗ[Padic ℓ] E),
      (∀ x : ↥(weilEtaleIntegralSystem W ℓ m),
        g₁ (weilLefschetzSpaceGen H x) = g₂ (weilLefschetzSpaceGen H x)) →
      g₁ = g₂) ∧
    (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (m : ℕ)
      (H₁ : WeilLefschetzEllAdicSpace W₁ ℓ m) (H₂ : WeilLefschetzEllAdicSpace W₂ ℓ m)
      (p : ∀ r : ℕ, weilEtaleTorsionH W₂ (ℓ ^ r) m →+ weilEtaleTorsionH W₁ (ℓ ^ r) m),
      (∀ (r : ℕ) (x : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) m),
        weilEtaleTorsionTransition W₁ ℓ r m (p (r + 1) x) =
          p r (weilEtaleTorsionTransition W₂ ℓ r m x)) →
      ∃ f : H₂.V →ₗ[Padic ℓ] H₁.V,
        ∀ (x : ↥(weilEtaleIntegralSystem W₂ ℓ m)) (y : ↥(weilEtaleIntegralSystem W₁ ℓ m)),
          (∀ r : ℕ, y.1 r = p r (x.1 r)) →
          f (weilLefschetzSpaceGen H₂ x) = weilLefschetzSpaceGen H₁ y) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (a b c : ℕ)
      (H_a : WeilLefschetzEllAdicSpace W ℓ a)
      (H_b : WeilLefschetzEllAdicSpace W ℓ b)
      (H_c : WeilLefschetzEllAdicSpace W ℓ c)
      (c_tors : ∀ r : ℕ, weilEtaleTorsionH W (ℓ ^ r) a →+
        weilEtaleTorsionH W (ℓ ^ r) b →+ weilEtaleTorsionH W (ℓ ^ r) c),
      (∀ (r : ℕ) (u : weilEtaleTorsionH W (ℓ ^ (r + 1)) a)
        (v : weilEtaleTorsionH W (ℓ ^ (r + 1)) b),
        weilEtaleTorsionTransition W ℓ r c (c_tors (r + 1) u v) =
          c_tors r (weilEtaleTorsionTransition W ℓ r a u)
            (weilEtaleTorsionTransition W ℓ r b v)) →
      ∃ cup : H_a.V →ₗ[Padic ℓ] H_b.V →ₗ[Padic ℓ] H_c.V,
        ∀ (x : ↥(weilEtaleIntegralSystem W ℓ a))
          (y : ↥(weilEtaleIntegralSystem W ℓ b))
          (z : ↥(weilEtaleIntegralSystem W ℓ c)),
          (∀ r : ℕ, z.1 r = c_tors r (x.1 r) (y.1 r)) →
          cup (weilLefschetzSpaceGen H_a x) (weilLefschetzSpaceGen H_b y) =
            weilLefschetzSpaceGen H_c z) :=
by
  have hL_mem_weil : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      (seq : ∀ r : ℕ, weilEtaleTorsionH W (ℓ ^ r) m),
      seq ∈ weilEtaleIntegralSystem W ℓ m ↔
        ∀ r : ℕ, weilEtaleTorsionTransition W ℓ r m (seq (r + 1)) = seq r := by
    intro W m seq
    rw [weilEtaleIntegralSystem, AddMonoidHom.mem_ker, funext_iff]
    exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
  obtain ⟨hExtSign, hLinLift⟩ := weil_padic_gen_ext_sign_and_linear_lift ℓ
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro W m
    obtain ⟨V, hAdd, hMod, equiv, hsmul⟩ :=
      weil_padic_space_of_torsion_inverse_system ℓ
        (fun r => weilEtaleTorsionH W (ℓ ^ r) m)
        (fun r u => weil_etale_torsion_sheafH_annihilation W (ℓ ^ r) m u)
        (fun r => weilEtaleTorsionTransition W ℓ r m)
        (weilEtaleIntegralSystem W ℓ m)
        (hL_mem_weil W m)
    letI : AddCommGroup V := hAdd
    letI : Module (Padic ℓ) V := hMod
    exact ⟨{ V := V, equiv := equiv, hsmul := hsmul }⟩
  · intro W₁ W₂ h m H₁ H₂ f
    exact Iff.rfl
  · intro W a b c hab H_a H_b H_c cup
    exact Iff.rfl
  · intro W m seq hseq
    exact ⟨⟨seq, (hL_mem_weil W m seq).mpr hseq⟩, fun _ => rfl⟩
  · intro W m x r
    exact (hL_mem_weil W m x.1).mp x.2 r
  · intro W m H x y
    have hES := (hExtSign _ (weilEtaleIntegralSystem W ℓ m) H.V H.equiv).1 x y
    exact ⟨fun h => hES.1 (Subtype.ext (funext h)), fun h => hES.2 (Subtype.ext (funext h))⟩
  · intro W m H E _ _ g₁ g₂ hg
    exact (hExtSign _ (weilEtaleIntegralSystem W ℓ m) H.V H.equiv).2 g₁ g₂ hg
  · intro W₁ W₂ m H₁ H₂ p hp
    exact hLinLift
      (fun r => weilEtaleTorsionH W₁ (ℓ ^ r) m)
      (fun r => weilEtaleTorsionH W₂ (ℓ ^ r) m)
      (fun r u => weil_etale_torsion_sheafH_annihilation W₂ (ℓ ^ r) m u)
      (fun r => weilEtaleTorsionTransition W₁ ℓ r m)
      (fun r => weilEtaleTorsionTransition W₂ ℓ r m)
      (weilEtaleIntegralSystem W₁ ℓ m)
      (weilEtaleIntegralSystem W₂ ℓ m)
      (hL_mem_weil W₁ m) (hL_mem_weil W₂ m)
      H₁.V H₂.V H₁.equiv H₂.equiv H₁.hsmul H₂.hsmul p hp
  · intro W a b c H_a H_b H_c c_tors hc
    exact weil_padic_bilinear_cup_lift ℓ
      (fun r => weilEtaleTorsionH W (ℓ ^ r) a)
      (fun r => weilEtaleTorsionH W (ℓ ^ r) b)
      (fun r => weilEtaleTorsionH W (ℓ ^ r) c)
      (fun r u => weil_etale_torsion_sheafH_annihilation W (ℓ ^ r) a u)
      (fun r v => weil_etale_torsion_sheafH_annihilation W (ℓ ^ r) b v)
      (fun r => weilEtaleTorsionTransition W ℓ r a)
      (fun r => weilEtaleTorsionTransition W ℓ r b)
      (fun r => weilEtaleTorsionTransition W ℓ r c)
      (weilEtaleIntegralSystem W ℓ a)
      (weilEtaleIntegralSystem W ℓ b)
      (weilEtaleIntegralSystem W ℓ c)
      (hL_mem_weil W a) (hL_mem_weil W b) (hL_mem_weil W c)
      H_a.V H_b.V H_c.V H_a.equiv H_b.equiv H_c.equiv
      H_a.hsmul H_b.hsmul H_c.hsmul c_tors hc

theorem weil_lefschetz_torsion_pullback_functoriality : (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m i : ℕ),
      ∃! p : weilEtaleTorsionH W₂ m i →+ weilEtaleTorsionH W₁ m i,
        WeilLefschetzTorsionPullback h m i p) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m i : ℕ),
      WeilLefschetzTorsionPullback (CategoryTheory.CategoryStruct.id W) m i
        (AddMonoidHom.id (weilEtaleTorsionH W m i))) ∧
    (∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Quiver.Hom W₁ W₂) (h₂ : Quiver.Hom W₂ W₃) (m i : ℕ)
      (p₁ : weilEtaleTorsionH W₂ m i →+ weilEtaleTorsionH W₁ m i)
      (p₂ : weilEtaleTorsionH W₃ m i →+ weilEtaleTorsionH W₂ m i),
      WeilLefschetzTorsionPullback h₁ m i p₁ →
      WeilLefschetzTorsionPullback h₂ m i p₂ →
      WeilLefschetzTorsionPullback (CategoryTheory.CategoryStruct.comp h₁ h₂) m i
        (p₁.comp p₂)) :=
