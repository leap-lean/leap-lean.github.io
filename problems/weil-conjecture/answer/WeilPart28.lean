    letI := CategoryTheory.Limits.comp_preservesFiniteColimits P_pull U₁
    letI := CategoryTheory.Limits.comp_preservesFiniteLimits U₂ P_pull_ab
    letI := CategoryTheory.Limits.comp_preservesFiniteColimits U₂ P_pull_ab
    let E₀ := P_pull_ab.mapExtAddHom (U₂.obj one₂) (U₂.obj one₂) q
