    (hZ0 : Z 0 = weilEtaleModuleUnit W₀ m₀)
    (hInjJ : ∀ k : ℕ, CategoryTheory.Injective (J k))
    (ι_Z : ∀ k : ℕ, Quiver.Hom (Z k) (J k))
    (π_Z : ∀ k : ℕ, Quiver.Hom (J k) (Z (k + 1)))
