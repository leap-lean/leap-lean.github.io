      AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply] at hc'
    exact hc'
  have hLocAll : ∀ (r q : ℕ) (U : Y₁.left.Etale)
      (ξ : weilEtaleTorsionH ((Fgt_W.obj (B₁.obj U)).left) (ℓ ^ r) q),
      ∃ S ∈ J₁ U,
        ∀ (V : Y₁.left.Etale) (f : Quiver.Hom V U), S.arrows f →
          ∃ c : weilEtaleTorsionH Y₂.left (ℓ ^ r) q,
            p_std (Fgt_W.map (B₁.map f)).left (ℓ ^ r) q ξ =
              p_std (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj V)).hom pr₂)
