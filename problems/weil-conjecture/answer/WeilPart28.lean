          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero n) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app A)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ e) (Nat.zero_add n) := by
      intro n
      induction n with
      | zero =>
        intro A B e
        let f : A ⟶ B := CategoryTheory.Abelian.Ext.addEquiv₀ e
        have hf : CategoryTheory.Abelian.Ext.mk₀ f = e :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply e
        rw [← hf, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          η.hom.naturality f]
      | succ k ih =>
        intro A B e
        let I : C_ab := CategoryTheory.Injective.under B
        let ι : B ⟶ I := CategoryTheory.Injective.ι B
        let Q : C_ab := CategoryTheory.Limits.cokernel ι
        let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
