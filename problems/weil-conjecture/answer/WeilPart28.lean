        CategoryTheory.Adjunction.homEquiv_counit adj_i₀ Fℤ_Y Fℤ_Z q_i_ab
      have hmap_q_eq : pb_i₀.map q_i_ab = π_A ≫ CategoryTheory.inv (adj_i₀.counit.app Fℤ_Z) := by
        rw [hπ_fac, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      haveI : CategoryTheory.IsIso (pb_i₀.map q_i_ab) := by
        rw [hmap_q_eq]
        infer_instance
      have h0_i_cok : CategoryTheory.Limits.IsZero
          (pb_i₀.obj (CategoryTheory.Limits.cokernel q_i_ab)) :=
        CategoryTheory.Limits.IsZero.of_iso
          (hSheafCokernelZeroOfEpi (pb_i₀.map q_i_ab))
          (CategoryTheory.Limits.PreservesCokernel.iso pb_i₀ q_i_ab)
      haveI := hi
      let U_c : Y.Opens :=
        ⟨(Set.range i.base)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      obtain ⟨hc_j₀, pb_j₀, adj_j₀, hAdd_j₀, _, hColim_j₀, _, _⟩ := hSite U_c.ι
      haveI : (weilEtaleSitePullback U_c.ι).IsContinuous
          Y.smallEtaleTopology U_c.toScheme.smallEtaleTopology := hc_j₀
      haveI := hAdd_j₀
      haveI := hColim_j₀
      have h0_j_push : CategoryTheory.Limits.IsZero (pb_j₀.obj (i_push_ab.obj Fℤ_Z)) := by
        apply hStalkJointZero U_c.toScheme
        intro Ω _ _ ξ_U
        obtain ⟨σ_j, _, _⟩ := hPullbackStalkAndTheta U_c.ι hc_j₀ pb_j₀ adj_j₀ Ω ξ_U
        have hOut : ¬ ∃ ξ_Z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z,
            ξ_Z ≫ i = ξ_U ≫ U_c.ι := by
          rintro ⟨ξ_Z, h_eq⟩
          let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
          have hpt : i.base (ξ_Z.base pt_Ω) = U_c.ι.base (ξ_U.base pt_Ω) :=
            congrArg (fun k : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y => k.base pt_Ω) h_eq
          exact (ξ_U.base pt_Ω).2 ⟨ξ_Z.base pt_Ω, hpt⟩
        exact CategoryTheory.Limits.IsZero.of_iso
          (hPushStalkOut i hi hc_i₀ Fℤ_Z (ξ_U ≫ U_c.ι) hOut)
          (σ_j.app (i_push_ab.obj Fℤ_Z))
      have h0_j_cok : CategoryTheory.Limits.IsZero
          (pb_j₀.obj (CategoryTheory.Limits.cokernel q_i_ab)) :=
        CategoryTheory.Limits.IsZero.of_iso
          (hSheafCokernelZeroOfTargetZero (pb_j₀.map q_i_ab) h0_j_push)
          (CategoryTheory.Limits.PreservesCokernel.iso pb_j₀ q_i_ab)
      exact hAbEpiOfCokernelZero q_i_ab
        (hFactII i U_c hi rfl hc_i₀ hc_j₀ pb_i₀ adj_i₀ pb_j₀ adj_j₀
          (CategoryTheory.Limits.cokernel q_i_ab) h0_j_cok h0_i_cok)
  exact ⟨hClosedExactAb, @hFactI, @hFactII⟩

