    exact eq_neg_of_add_eq_zero_left hsum_top

  
  have part4_monoidal_abelian_unit_ext_graded_comm
      {𝒞 : Type (u + 1)} [Category.{u, u + 1} 𝒞]
      [Abelian 𝒞] [HasExt.{u} 𝒞]
      [EnoughInjectives 𝒞] [MonoidalCategory 𝒞]
      (P : 𝒞 → Prop)
      (hP_unit : P (MonoidalCategoryStruct.tensorUnit 𝒞))
      (hP_exact : ∀ X : 𝒞, P X →
        (MonoidalCategory.tensorLeft X).Additive ∧
        Nonempty (Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft X)) ∧
        Nonempty (Limits.PreservesFiniteColimits (MonoidalCategory.tensorLeft X)) ∧
        (MonoidalCategory.tensorRight X).Additive ∧
        Nonempty (Limits.PreservesFiniteLimits (MonoidalCategory.tensorRight X)) ∧
        Nonempty (Limits.PreservesFiniteColimits (MonoidalCategory.tensorRight X)))
      (hP_epi : ∀ E : 𝒞, ∃ (Q : 𝒞) (e₀ : Q ⟶ E), P Q ∧ Epi e₀)
      (hP_ker : ∀ S : ShortComplex 𝒞, S.ShortExact → P S.X₂ → P S.X₃ → P S.X₁)
      (U : 𝒞) (hU : Nonempty (MonoidalCategoryStruct.tensorUnit 𝒞 ≅ U))
      (a₀ b₀ c₀ : ℕ) (hab₀ : a₀ + b₀ = c₀) (hba₀ : b₀ + a₀ = c₀)
      (α_u : Abelian.Ext.{u} U U a₀) (β_u : Abelian.Ext.{u} U U b₀) :
      α_u.comp β_u hab₀ = ((-1 : ℤ) ^ (a₀ * b₀)) • (β_u.comp α_u hba₀) := by
    have comp_zsmul : ∀ {X Y Z : 𝒞} {p q pq : ℕ} (x : Abelian.Ext.{u} X Y p)
        (y : Abelian.Ext.{u} Y Z q) (hpq : p + q = pq) (n : ℤ),
        x.comp (n • y) hpq = n • (x.comp y hpq) :=
      fun x y hpq n => map_zsmul (x.precomp _ hpq) n y
    have zsmul_comp : ∀ {X Y Z : 𝒞} {p q pq : ℕ} (x : Abelian.Ext.{u} X Y p)
        (y : Abelian.Ext.{u} Y Z q) (hpq : p + q = pq) (n : ℤ),
        (n • x).comp y hpq = n • (x.comp y hpq) :=
      fun x y hpq n => map_zsmul (y.postcomp _ hpq) n x
    have hExtNatTrans : ∀ (F₁ F₂ : 𝒞 ⥤ 𝒞)
        [F₁.Additive] [Limits.PreservesFiniteLimits F₁] [Limits.PreservesFiniteColimits F₁]
        [F₂.Additive] [Limits.PreservesFiniteLimits F₂] [Limits.PreservesFiniteColimits F₂]
        (σ : F₁ ⟶ F₂) (A B : 𝒞) (n : ℕ) (x : Abelian.Ext.{u} A B n),
        ((F₁.mapExtAddHom A B n) x).comp (Abelian.Ext.mk₀ (σ.app B)) (Nat.add_zero n) =
          (Abelian.Ext.mk₀ (σ.app A)).comp ((F₂.mapExtAddHom A B n) x) (Nat.zero_add n) := by
      intro F₁ F₂ _ _ _ _ _ _ σ A B n x
      rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
      induction n generalizing B with
      | zero =>
        have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
        rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
            Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, σ.naturality]
      | succ k ih =>
        let ι : B ⟶ Injective.under B := Injective.ι B
        let S : ShortComplex 𝒞 := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
        have hS : S.ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x hzero rfl
        let φ_S : S.map F₁ ⟶ S.map F₂ :=
          { τ₁ := σ.app S.X₁
            τ₂ := σ.app S.X₂
            τ₃ := σ.app S.X₃
            comm₁₂ := (σ.naturality S.f).symm
            comm₂₃ := (σ.naturality S.g).symm }
        have hnat_ext :
            (hS.map_of_exact F₁).extClass.comp (Abelian.Ext.mk₀ (σ.app B)) (Nat.add_zero 1) =
              (Abelian.Ext.mk₀ (σ.app S.X₃)).comp (hS.map_of_exact F₂).extClass (Nat.zero_add 1) :=
          ShortComplex.ShortExact.extClass_naturality (hS.map_of_exact F₁) (hS.map_of_exact F₂) φ_S
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
            Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
            Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl,
            hnat_ext,
            ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl,
            ih S.X₃ z,
            Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (σ.app A)) _ _ (Nat.zero_add k) rfl (by omega)]
    have hExtIso : ∀ (F₁ F₂ : 𝒞 ⥤ 𝒞)
        [F₁.Additive] [Limits.PreservesFiniteLimits F₁] [Limits.PreservesFiniteColimits F₁]
        [F₂.Additive] [Limits.PreservesFiniteLimits F₂] [Limits.PreservesFiniteColimits F₂]
        (σ : F₁ ≅ F₂) (A B : 𝒞) (n : ℕ) (x : Abelian.Ext.{u} A B n),
        (F₂.mapExtAddHom A B n) x =
          (Abelian.Ext.mk₀ (σ.inv.app A)).comp
