          CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
        have hExact : S_c.Exact :=
          CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_c
            (CategoryTheory.Limits.cokernelIsCokernel ι)
        have hMono : CategoryTheory.Mono S_c.f := by dsimp [S_c]; infer_instance
        have hEpi : CategoryTheory.Epi S_c.g := by dsimp [S_c]; infer_instance
        have hS : S_c.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi
        have hInj : CategoryTheory.Injective S_c.X₂ := by dsimp [S_c, I]; infer_instance
        have hZero : e.comp (CategoryTheory.Abelian.Ext.mk₀ S_c.f) (Nat.add_zero (k + 1)) = 0 :=
          @CategoryTheory.Abelian.Ext.eq_zero_of_injective _ _ _ _ A S_c.X₂ k hInj _
        obtain ⟨z, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS e hZero (rfl : k + 1 = k + 1)
        have hS₁ : (S_c.map F₁).ShortExact := hS.map_of_exact F₁
        have hS₂ : (S_c.map F₂).ShortExact := hS.map_of_exact F₂
        let τ : S_c.map F₁ ⟶ S_c.map F₂ := S_c.mapNatTrans η.hom
        have hExtNat :
            hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Q)).comp hS₂.extClass (Nat.zero_add 1) :=
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₁ hS₂ τ
        calc
          (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ (z.comp hS.extClass rfl)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero (k + 1))
            = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z).comp hS₁.extClass rfl).comp
                (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero (k + 1)) := by
              rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
                CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
          _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z).comp
                (hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero 1))
                rfl :=
