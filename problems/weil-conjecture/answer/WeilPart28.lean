    cases Subsingleton.elim hCont_r hCont_s
    haveI : B.IsContinuous J₂ J₁ := hCont_s
    haveI : P_pull_s.Additive := hAdd_s
    haveI : CategoryTheory.Limits.PreservesFiniteLimits P_pull_s := hLim_s
    haveI : CategoryTheory.Limits.PreservesFiniteColimits P_pull_s := hColim_s
