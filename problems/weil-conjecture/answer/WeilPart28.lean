        let JZ := Z.smallEtaleTopology
        let CZ := CategoryTheory.constantSheaf JZ AddCommGrpCat.{u}
        let Fℤ := CZ.obj (AddCommGrpCat.of (ULift.{u} ℤ))
        let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
        let Z_1 := AddCommGrpCat.of (ZMod 1)
