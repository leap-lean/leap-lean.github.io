            have hgf_left : (Fgt_W.map (B₁.map (CategoryTheory.CategoryStruct.comp g f))).left =
                CategoryTheory.CategoryStruct.comp
                  (Fgt_W.map (B₁.map g)).left (Fgt_W.map (B₁.map f)).left := by
