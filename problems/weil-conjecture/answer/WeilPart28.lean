    have hU₁_x : U₁.mapExtAddHom one₁ one₁ q
        (((CategoryTheory.Abelian.Ext.mk₀ e_hom).comp
          (P_pull.mapExtAddHom one₂ one₂ q γ) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_inv) (Nat.add_zero q)) =
        (((CategoryTheory.Abelian.Ext.mk₀ (U₁.map e_hom)).comp
          ((P_pull.comp U₁).mapExtAddHom one₂ one₂ q γ) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (U₁.map e_inv)) (Nat.add_zero q)) := by
      have hc := (h_ext_comp P_pull U₁ q one₂ one₂ γ).symm
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Functor.mapExtAddHom_apply (F := U₁), hc]
    have hPullU₁_γ : (P_pull.comp U₁).mapExtAddHom one₂ one₂ q γ =
        (((CategoryTheory.Abelian.Ext.mk₀ (e_comm.hom.app one₂)).comp E₀ (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (e_comm.inv.app one₂)) (Nat.add_zero q)) := by
      rw [h_ext_natIso (P_pull.comp U₁) (U₂.comp P_pull_ab) e_comm q one₂ one₂ γ,
        h_ext_comp U₂ P_pull_ab q one₂ one₂ γ]
    let y₂ := (((CategoryTheory.Abelian.Ext.mk₀ ηℤ₂).comp
      (U₂.mapExtAddHom one₂ one₂ q γ) (Nat.zero_add q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ βM₂) (Nat.add_zero q))
    have hPab_y₂ : P_pull_ab.mapExtAddHom Fℤ₂ FM₂ q y₂ =
        (((CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map ηℤ₂)).comp E₀ (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map βM₂)) (Nat.add_zero q)) := by
      dsimp only [y₂]
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Functor.mapExtAddHom_apply (F := P_pull_ab)]
    have hPp_y₂ : P_pull_p.mapExtAddHom Fℤ₂ FM₂ q y₂ =
        (((CategoryTheory.Abelian.Ext.mk₀ (η_p.inv.app Fℤ₂)).comp
          (P_pull_ab.mapExtAddHom Fℤ₂ FM₂ q y₂) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η_p.hom.app FM₂)) (Nat.add_zero q)) :=
