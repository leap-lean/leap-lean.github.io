      intro G x
      refine ⟨AddCommGrpCat.ofHom
        { toFun := fun z => z.down • x
          map_zero' := zero_zsmul x
          map_add' := fun a b => add_zsmul x a.down b.down }, ?_⟩
      exact one_zsmul x
    have hEvRestrict : ∀ g : Quiver.Hom Fℤ_Y F,
        ((adj_V.homEquiv Aℤ (j_star.obj F))
          (CategoryTheory.CategoryStruct.comp (weilGysinAbOpenConstHom V hc_MV Aℤ)
            (j_star.map g))) (ULift.up (1 : ℤ)) =
          F.obj.map (Opposite.op μ_V)
            (((adj_Y.homEquiv Aℤ F) g) (ULift.up (1 : ℤ))) := by
      intro g
      let shAdj_V := CategoryTheory.sheafificationAdjunction V.toScheme.smallEtaleTopology AddCommGrpCat.{u}
      let shAdj_Y := CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}
      let P_V := (CategoryTheory.Functor.const (Opposite V.toScheme.Etale)).obj Aℤ
      let P_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
      have hoc : weilGysinAbOpenConstHom V hc_MV Aℤ = constPushHom M_V Aℤ :=
        hConstPushEq M_V hT_Y hT_V Aℤ
      have hsh_MV : CategoryTheory.CategoryStruct.comp
          (shAdj_V.unit.app P_V)
          ((CategoryTheory.sheafToPresheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u}).map
            (constPushHom M_V Aℤ)) =
          CategoryTheory.Functor.whiskerLeft M_V.op (shAdj_Y.unit.app P_Y) :=
        (CategoryTheory.Adjunction.homEquiv_unit shAdj_V P_V _ (constPushHom M_V Aℤ)).symm.trans
          ((shAdj_V.homEquiv P_V _).apply_symm_apply _)
      have hadj_oc : (adj_V.homEquiv Aℤ (j_star.obj Fℤ_Y)) (weilGysinAbOpenConstHom V hc_MV Aℤ) =
          (shAdj_Y.unit.app P_Y).app (Opposite.op W_V) := by
        rw [hoc, CategoryTheory.Adjunction.homEquiv_unit, hConstAdjUnit hT_V Aℤ]
        exact CategoryTheory.NatTrans.congr_app hsh_MV (Opposite.op T_V)
      have hLHS : (adj_V.homEquiv Aℤ (j_star.obj F))
          (CategoryTheory.CategoryStruct.comp (weilGysinAbOpenConstHom V hc_MV Aℤ) (j_star.map g)) =
          CategoryTheory.CategoryStruct.comp
            ((shAdj_Y.unit.app P_Y).app (Opposite.op W_V))
            (g.hom.app (Opposite.op W_V)) := by
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right, hadj_oc]
        rfl
      have hnat_η : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id Aℤ)
          ((shAdj_Y.unit.app P_Y).app (Opposite.op W_V)) =
          CategoryTheory.CategoryStruct.comp
            ((shAdj_Y.unit.app P_Y).app (Opposite.op T_Y))
            (Fℤ_Y.obj.map (Opposite.op μ_V)) :=
        (shAdj_Y.unit.app P_Y).naturality (Opposite.op μ_V)
      rw [CategoryTheory.Category.id_comp] at hnat_η
      have hRHS : CategoryTheory.CategoryStruct.comp
          ((adj_Y.homEquiv Aℤ F) g) (F.obj.map (Opposite.op μ_V)) =
          CategoryTheory.CategoryStruct.comp
            ((shAdj_Y.unit.app P_Y).app (Opposite.op W_V))
            (g.hom.app (Opposite.op W_V)) :=
        (congrArg (fun u => CategoryTheory.CategoryStruct.comp u (F.obj.map (Opposite.op μ_V)))
          ((CategoryTheory.Adjunction.homEquiv_unit adj_Y Aℤ F g).trans
            (congrArg (fun v => CategoryTheory.CategoryStruct.comp v (g.hom.app (Opposite.op T_Y)))
              (hConstAdjUnit hT_Y Aℤ)))).trans
          ((CategoryTheory.Category.assoc
            ((shAdj_Y.unit.app P_Y).app (Opposite.op T_Y))
            (g.hom.app (Opposite.op T_Y))
            (F.obj.map (Opposite.op μ_V))).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp ((shAdj_Y.unit.app P_Y).app (Opposite.op T_Y)))
              (g.hom.naturality (Opposite.op μ_V)).symm).trans
