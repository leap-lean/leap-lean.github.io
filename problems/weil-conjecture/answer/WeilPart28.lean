      IsPullback (fr U hU) u u (fr W hW) := by
    intro U W hU hW u hEt_u
    have hcomm : fr U hU ≫ u = u ≫ fr W hW := hfr_nat hU hW u
    let P_pb := Limits.pullback u (fr W hW)
    let fst_pb : P_pb ⟶ U := Limits.pullback.fst u (fr W hW)
    let snd_pb : P_pb ⟶ W := Limits.pullback.snd u (fr W hW)
    let F : U ⟶ P_pb := Limits.pullback.lift (fr U hU) u hcomm
    have hF_fst : F ≫ fst_pb = fr U hU := Limits.pullback.lift_fst _ _ _
    have hF_snd : F ≫ snd_pb = u := Limits.pullback.lift_snd _ _ _
