      have hM_fst : M ≫ Limits.pullback.fst (fr U hU) (i₂ ≫ fst_pb) = i₁ :=
        Limits.pullback.lift_fst _ _ _
      have hM_snd : M ≫ Limits.pullback.snd (fr U hU) (i₂ ≫ fst_pb) = f' :=
        Limits.pullback.lift_snd _ _ _
      have hMono_M : Mono M :=
        { right_cancellation := fun {W₀} a b hab => by
            have h1 : a ≫ i₁ = b ≫ i₁ := by
              rw [← hM_fst, ← Category.assoc, hab, Category.assoc]
            have h2 : a ≫ f' = b ≫ f' := by
              rw [← hM_snd, ← Category.assoc, hab, Category.assoc]
            exact hp_F.hom_ext h2 h1 }
