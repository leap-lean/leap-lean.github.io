          have hf₁_et : AlgebraicGeometry.Etale f₁.left := hEtaleLeft f₁
          have hf₂_et : AlgebraicGeometry.Etale f₂.left := hEtaleLeft f₂
          have hY₁_et : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
          let p₁ := CategoryTheory.Limits.pullback.fst f₁.left f₂.left
          let p₂ := CategoryTheory.Limits.pullback.snd f₁.left f₂.left
          let P₁₂ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ Y₁.hom) inferInstance
          let π₁ : P₁₂ ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl
          let π₂ : P₁₂ ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ (by
            change p₂ ≫ Y₂.hom = p₁ ≫ Y₁.hom
            rw [← CategoryTheory.MorphismProperty.Over.w f₁,
              ← CategoryTheory.MorphismProperty.Over.w f₂,
              ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition])
