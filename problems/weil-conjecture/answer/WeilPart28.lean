                rw [h_glued_eq f_w hf_w (e₁ + e₂) y_w, h_glued_eq f_w hf_w e₁ y_w,
                  h_glued_eq f_w hf_w e₂ y_w, map_add]
                rfl)
              map_smul' := fun r e => Subtype.ext (LocallyConstant.ext fun w => by
                obtain ⟨Y_w, f_w, y_w, hf_w, rfl⟩ := hcov_pts w
                change gluedFn (r • e) (f_w.left.base y_w) = r • gluedFn e (f_w.left.base y_w)
                rw [h_glued_eq f_w hf_w (r • e) y_w, h_glued_eq f_w hf_w e y_w, map_smul]
