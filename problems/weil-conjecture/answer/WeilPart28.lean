        (𝒢 : CategoryTheory.Sheaf W.smallEtaleTopology ModR) :
        (one_fn W ⟶ 𝒢) ≃+ ↑(𝒢.obj.obj (Opposite.op (T_fn W))) :=
      (homAdd_fn W 𝒢).trans (evalOne_R (𝒢.obj.obj (Opposite.op (T_fn W))))
    have hsecEval_apply : ∀ (W : AlgebraicGeometry.Scheme.{u})
        (𝒢 : CategoryTheory.Sheaf W.smallEtaleTopology ModR) (m : one_fn W ⟶ 𝒢),
