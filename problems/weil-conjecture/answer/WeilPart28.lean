        · ext z; simp [fRing]
        · simp [fRing, hs_compat a hr]
      let α (a : Fin n) : PadicInt ℓ := PadicInt.lift (hf_compat a) Polynomial.X
      have hα_spec : ∀ (a : Fin n) (r : ℕ), PadicInt.toZModPow r (α a) = sPart a r := by
        intro a r
