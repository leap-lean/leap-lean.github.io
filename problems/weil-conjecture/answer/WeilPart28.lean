        frobVi (eVi ((1 : ℚ) ⊗ₜ[ℤ] x)) = eVi ((1 : ℚ) ⊗ₜ[ℤ] y))
      (_ : ∀ (x y : ↥Lj), (∀ r : ℕ, y.1 r = frobTj r (x.1 r)) →
        frobVj (eVj ((1 : ℚ) ⊗ₜ[ℤ] x)) = eVj ((1 : ℚ) ⊗ₜ[ℤ] y)),
      ∃ B : Vi →ₗ[Padic ℓ] Vj →ₗ[Padic ℓ] Padic ℓ,
        Function.Bijective B ∧
        ∀ (v : Vi) (w : Vj), B (frobVi v) (frobVj w) = (q_card : Padic ℓ) ^ d * B v w := by
    intro Hi Hj _ _ πi πj Li hmemLi Lj hmemLj hTors_i hTors_j
      frobTi hfrobTi frobTj hfrobTj pSys hpCompat hpLeft hpRight q_card hpFrob
      hLift_i hLift_j Vi Vj _ _ _ _ _ _ frobVi frobVj eVi eVj
      hsmulVi hsmulVj hfrobVi hfrobVj
    let smulLi (z : PadicInt ℓ) (x : ↥Li) : ↥Li :=
      ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, (hmemLi _).mpr fun r => by
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
        have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_ne⟩
        set c := PadicInt.toZModPow (r + 1) z
        have hc_cast : PadicInt.toZModPow r z =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) c :=
          (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r) (p := ℓ)) z).symm
        have hc_cast2 : PadicInt.toZModPow r z = (c.val : ZMod (ℓ ^ r)) := by
          conv_lhs => rw [hc_cast, ← ZMod.natCast_zmod_val c]
          exact map_natCast (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))) c.val
        rw [map_nsmul, (hmemLi x.1).mp x.2 r, hc_cast2, ZMod.val_natCast]
        have hdiv := (Nat.div_add_mod c.val (ℓ ^ r)).symm
        conv_lhs => rw [hdiv, add_nsmul, Nat.mul_comm, mul_nsmul', hTors_i r (x.1 r), smul_zero, zero_add]⟩
    let smulLj (z : PadicInt ℓ) (y : ↥Lj) : ↥Lj :=
      ⟨fun r => (PadicInt.toZModPow r z).val • y.1 r, (hmemLj _).mpr fun r => by
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
        have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_ne⟩
        set c := PadicInt.toZModPow (r + 1) z
        have hc_cast : PadicInt.toZModPow r z =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) c :=
          (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r) (p := ℓ)) z).symm
        have hc_cast2 : PadicInt.toZModPow r z = (c.val : ZMod (ℓ ^ r)) := by
          conv_lhs => rw [hc_cast, ← ZMod.natCast_zmod_val c]
          exact map_natCast (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))) c.val
        rw [map_nsmul, (hmemLj y.1).mp y.2 r, hc_cast2, ZMod.val_natCast]
        have hdiv := (Nat.div_add_mod c.val (ℓ ^ r)).symm
        conv_lhs => rw [hdiv, add_nsmul, Nat.mul_comm, mul_nsmul', hTors_j r (y.1 r), smul_zero, zero_add]⟩
    have hpair_compat : ∀ (x : ↥Li) (y : ↥Lj) {r₁ r₂ : ℕ} (hr : r₁ ≤ r₂),
        ZMod.castHom (pow_dvd_pow ℓ hr) (ZMod (ℓ ^ r₁)) (pSys r₂ (x.1 r₂) (y.1 r₂)) =
          pSys r₁ (x.1 r₁) (y.1 r₁) := by
      intro x y r₁ r₂ hr
      induction r₂, hr using Nat.le_induction with
      | base => exact RingHom.congr_fun ZMod.castHom_self _
      | succ t hrt ih =>
        have hcast_comp : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ_of_le hrt)) (ZMod (ℓ ^ r₁)) =
            (ZMod.castHom (pow_dvd_pow ℓ hrt) (ZMod (ℓ ^ r₁))).comp
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ t)) (ZMod (ℓ ^ t))) := by
          ext z; simp
        rw [hcast_comp, RingHom.comp_apply, hpCompat t (x.1 (t + 1)) (y.1 (t + 1)),
          (hmemLi x.1).mp x.2 t, (hmemLj y.1).mp y.2 t, ih]
    let fPairRing (x : ↥Li) (y : ↥Lj) (r : ℕ) : Polynomial ℤ →+* ZMod (ℓ ^ r) :=
      Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ r))) (pSys r (x.1 r) (y.1 r))
    have hfPair_compat : ∀ (x : ↥Li) (y : ↥Lj) (r₁ r₂ : ℕ) (hr : r₁ ≤ r₂),
        (ZMod.castHom (pow_dvd_pow ℓ hr) (ZMod (ℓ ^ r₁))).comp (fPairRing x y r₂) =
          fPairRing x y r₁ := by
      intro x y r₁ r₂ hr
      apply Polynomial.ringHom_ext'
      · ext z; simp [fPairRing]
      · simp [fPairRing, hpair_compat x y hr]
    let β (x : ↥Li) (y : ↥Lj) : PadicInt ℓ :=
      PadicInt.lift (hfPair_compat x y) Polynomial.X
    have hβ_mod : ∀ (x : ↥Li) (y : ↥Lj) (r : ℕ),
        PadicInt.toZModPow r (β x y) = pSys r (x.1 r) (y.1 r) := by
      intro x y r
      have h := RingHom.congr_fun (PadicInt.lift_spec (hfPair_compat x y) r) Polynomial.X
      simpa [β, fPairRing] using h
    have hβ_add_left : ∀ (x₁ x₂ : ↥Li) (y : ↥Lj), β (x₁ + x₂) y = β x₁ y + β x₂ y := by
      intro x₁ x₂ y; apply PadicInt.ext_of_toZModPow.mp; intro r
      rw [map_add, hβ_mod, hβ_mod, hβ_mod]
      change pSys r (x₁.1 r + x₂.1 r) (y.1 r) = pSys r (x₁.1 r) (y.1 r) + pSys r (x₂.1 r) (y.1 r)
      rw [map_add, AddMonoidHom.add_apply]
    have hβ_add_right : ∀ (x : ↥Li) (y₁ y₂ : ↥Lj), β x (y₁ + y₂) = β x y₁ + β x y₂ := by
      intro x y₁ y₂; apply PadicInt.ext_of_toZModPow.mp; intro r
      rw [map_add, hβ_mod, hβ_mod, hβ_mod]
      exact map_add (pSys r (x.1 r)) (y₁.1 r) (y₂.1 r)
    have hβ_smul_left : ∀ (z : PadicInt ℓ) (x : ↥Li) (y : ↥Lj), β (smulLi z x) y = z * β x y := by
      intro z x y; apply PadicInt.ext_of_toZModPow.mp; intro r
      have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_ne⟩
      rw [map_mul, hβ_mod, hβ_mod]
      change pSys r ((PadicInt.toZModPow r z).val • x.1 r) (y.1 r) =
        PadicInt.toZModPow r z * pSys r (x.1 r) (y.1 r)
      rw [map_nsmul, AddMonoidHom.nsmul_apply, nsmul_eq_mul, ZMod.natCast_zmod_val]
    have hβ_smul_right : ∀ (z : PadicInt ℓ) (x : ↥Li) (y : ↥Lj), β x (smulLj z y) = z * β x y := by
      intro z x y; apply PadicInt.ext_of_toZModPow.mp; intro r
      have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_ne⟩
      rw [map_mul, hβ_mod, hβ_mod]
      change pSys r (x.1 r) ((PadicInt.toZModPow r z).val • y.1 r) =
        PadicInt.toZModPow r z * pSys r (x.1 r) (y.1 r)
      rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
    let frobLi (x : ↥Li) : ↥Li :=
      ⟨fun r => frobTi r (x.1 r), (hmemLi _).mpr fun r => by
        rw [hfrobTi r (x.1 (r + 1)), (hmemLi x.1).mp x.2 r]⟩
    let frobLj (y : ↥Lj) : ↥Lj :=
      ⟨fun r => frobTj r (y.1 r), (hmemLj _).mpr fun r => by
        rw [hfrobTj r (y.1 (r + 1)), (hmemLj y.1).mp y.2 r]⟩
    have hβ_frob : ∀ (x : ↥Li) (y : ↥Lj),
        β (frobLi x) (frobLj y) = ((q_card : PadicInt ℓ) ^ d) * β x y := by
      intro x y; apply PadicInt.ext_of_toZModPow.mp; intro r
      rw [map_mul, map_pow, map_natCast, hβ_mod, hβ_mod]
      exact hpFrob r (x.1 r) (y.1 r)
    let β_add : ↥Li →+ ↥Lj →+ Padic ℓ :=
      AddMonoidHom.mk'
        (fun x => AddMonoidHom.mk' (fun y => (β x y : Padic ℓ))
          (fun y₁ y₂ => by rw [hβ_add_right]; push_cast; rfl))
        (fun x₁ x₂ => by
          ext y
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, hβ_add_left]
          push_cast; rfl)
    let β_right_bilin (q₁ : ℚ) (x : ↥Li) : ℚ →ₗ[ℤ] ↥Lj →ₗ[ℤ] Padic ℓ :=
      LinearMap.mk₂ ℤ (fun (q₂ : ℚ) (y : ↥Lj) => (q₁ : Padic ℓ) * ((q₂ : Padic ℓ) * β_add x y))
        (fun r₁ r₂ y => by push_cast; ring)
        (fun c r y => by
          change (q₁ : Padic ℓ) * (((c • r : ℚ) : Padic ℓ) * β_add x y) =
            c • ((q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y))
          rw [zsmul_eq_mul, zsmul_eq_mul]; push_cast; ring)
        (fun r y₁ y₂ => by rw [map_add]; ring)
        (fun c r y => by rw [map_zsmul, zsmul_eq_mul, zsmul_eq_mul]; ring)
    let β_right (q₁ : ℚ) (x : ↥Li) : TensorProduct ℤ ℚ ↥Lj →ₗ[ℤ] Padic ℓ :=
      TensorProduct.lift (β_right_bilin q₁ x)
    let β_left_bilin : ℚ →ₗ[ℤ] ↥Li →ₗ[ℤ] (TensorProduct ℤ ℚ ↥Lj →ₗ[ℤ] Padic ℓ) :=
      LinearMap.mk₂ ℤ β_right
        (fun q₁ q₂ x => TensorProduct.ext' fun r y => by
          change (((q₁ + q₂ : ℚ) : Padic ℓ) * ((r : Padic ℓ) * β_add x y)) =
            (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y) +
              (q₂ : Padic ℓ) * ((r : Padic ℓ) * β_add x y)
          push_cast; ring)
        (fun c q₁ x => TensorProduct.ext' fun r y => by
          change (((c • q₁ : ℚ) : Padic ℓ) * ((r : Padic ℓ) * β_add x y)) =
            c • ((q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y))
          rw [zsmul_eq_mul, zsmul_eq_mul]; push_cast; ring)
        (fun q₁ x₁ x₂ => TensorProduct.ext' fun r y => by
          change (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add (x₁ + x₂) y) =
            (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x₁ y) +
              (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x₂ y)
          rw [map_add, AddMonoidHom.add_apply]; ring)
        (fun c q₁ x => TensorProduct.ext' fun r y => by
          change (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add (c • x) y) =
            c • ((q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y))
          rw [map_zsmul, AddMonoidHom.zsmul_apply, zsmul_eq_mul, zsmul_eq_mul]; ring)
    let β_Q : TensorProduct ℤ ℚ ↥Li →ₗ[ℤ] TensorProduct ℤ ℚ ↥Lj →ₗ[ℤ] Padic ℓ :=
      TensorProduct.lift β_left_bilin
    have hβ_Q_tmul : ∀ (q₁ q₂ : ℚ) (x : ↥Li) (y : ↥Lj),
        β_Q (q₁ ⊗ₜ[ℤ] x) (q₂ ⊗ₜ[ℤ] y) = (q₁ : Padic ℓ) * ((q₂ : Padic ℓ) * (β x y : Padic ℓ)) :=
      fun _ _ _ _ => rfl
    have hEquivRat : ∀ {L V : Type u} [AddCommGroup L] [AddCommGroup V] [Module (Padic ℓ) V]
        (e : TensorProduct ℤ ℚ L ≃+ V) (q : ℚ) (t : TensorProduct ℤ ℚ L),
        e (q • t) = (q : Padic ℓ) • e t := by
      intro L V _ _ _ e q t
      have hd_ne : q.den ≠ 0 := q.den_nz
      have hd_padic : ((q.den : ℕ) : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
      have hrat_eq : (q.den : ℚ) * q = (q.num : ℚ) := by rw [mul_comm, Rat.mul_den_eq_num]
      have ht_eq : q.den • (q • t) = q.num • t := by
        rw [← Nat.cast_smul_eq_nsmul ℚ, ← mul_smul, hrat_eq, Int.cast_smul_eq_zsmul ℚ]
      have he_eq : q.den • e (q • t) = q.num • e t := by
        rw [← map_nsmul, ht_eq, map_zsmul]
      rw [← Nat.cast_smul_eq_nsmul (Padic ℓ), ← Int.cast_smul_eq_zsmul (Padic ℓ)] at he_eq
      have hpadic_eq : ((q.num : ℤ) : Padic ℓ) = ((q.den : ℕ) : Padic ℓ) * (q : Padic ℓ) := by
        have hq := congrArg (fun r : ℚ => (r : Padic ℓ)) hrat_eq.symm
        push_cast at hq
        exact hq
      rw [hpadic_eq, mul_smul] at he_eq
      exact smul_right_injective V hd_padic he_eq
    have hEquivSymmRat : ∀ {L V : Type u} [AddCommGroup L] [AddCommGroup V] [Module (Padic ℓ) V]
        (e : TensorProduct ℤ ℚ L ≃+ V) (q : ℚ) (v : V),
        e.symm ((q : Padic ℓ) • v) = q • e.symm v := by
      intro L V _ _ _ e q v
      apply e.injective
      rw [e.apply_symm_apply, hEquivRat e q (e.symm v), e.apply_symm_apply]
    have hβ_Q_rat_left : ∀ (q : ℚ) (t : TensorProduct ℤ ℚ ↥Li) (s : TensorProduct ℤ ℚ ↥Lj),
        β_Q (q • t) s = (q : Padic ℓ) * β_Q t s := by
      intro q t s
      induction t using TensorProduct.induction_on with
      | zero => rw [smul_zero, map_zero, LinearMap.zero_apply, mul_zero]
      | tmul q₁ x =>
        rw [TensorProduct.smul_tmul', smul_eq_mul]
        induction s using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero, mul_zero]
        | tmul q₂ y => rw [hβ_Q_tmul, hβ_Q_tmul]; push_cast; ring
        | add s₁ s₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [smul_add, map_add, map_add, LinearMap.add_apply, LinearMap.add_apply, ih₁, ih₂, mul_add]
    have hβ_Q_rat_right : ∀ (q : ℚ) (t : TensorProduct ℤ ℚ ↥Li) (s : TensorProduct ℤ ℚ ↥Lj),
        β_Q t (q • s) = (q : Padic ℓ) * β_Q t s := by
      intro q t s
      induction t using TensorProduct.induction_on with
      | zero => rw [map_zero, LinearMap.zero_apply, LinearMap.zero_apply, mul_zero]
      | tmul q₁ x =>
        induction s using TensorProduct.induction_on with
        | zero => rw [smul_zero, map_zero, mul_zero]
        | tmul q₂ y =>
          rw [TensorProduct.smul_tmul', smul_eq_mul, hβ_Q_tmul, hβ_Q_tmul]; push_cast; ring
        | add s₁ s₂ ih₁ ih₂ => rw [smul_add, map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [map_add, LinearMap.add_apply, LinearMap.add_apply, ih₁, ih₂, mul_add]
    let B₀ : Vi →+ Vj →+ Padic ℓ :=
      AddMonoidHom.mk'
        (fun v => AddMonoidHom.mk' (fun w => β_Q (eVi.symm v) (eVj.symm w))
          (fun w₁ w₂ => by rw [map_add, map_add]))
        (fun v₁ v₂ => by
          ext w
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add, LinearMap.add_apply])
    have hB₀_apply : ∀ (v : Vi) (w : Vj), B₀ v w = β_Q (eVi.symm v) (eVj.symm w) :=
      fun _ _ => rfl
    have hB₀_tmul : ∀ (q₁ q₂ : ℚ) (x : ↥Li) (y : ↥Lj),
        B₀ (eVi (q₁ ⊗ₜ[ℤ] x)) (eVj (q₂ ⊗ₜ[ℤ] y)) =
          (q₁ : Padic ℓ) * ((q₂ : Padic ℓ) * (β x y : Padic ℓ)) := by
      intro q₁ q₂ x y
      rw [hB₀_apply, eVi.symm_apply_apply, eVj.symm_apply_apply, hβ_Q_tmul]
    have hB₀_rat_left : ∀ (q : ℚ) (v : Vi) (w : Vj),
        B₀ ((q : Padic ℓ) • v) w = (q : Padic ℓ) * B₀ v w := by
      intro q v w
      rw [hB₀_apply, hB₀_apply, hEquivSymmRat eVi q v, hβ_Q_rat_left]
    have hB₀_rat_right : ∀ (q : ℚ) (v : Vi) (w : Vj),
        B₀ v ((q : Padic ℓ) • w) = (q : Padic ℓ) * B₀ v w := by
      intro q v w
      rw [hB₀_apply, hB₀_apply, hEquivSymmRat eVj q w, hβ_Q_rat_right]
    have hVi_int_tmul : ∀ (z : PadicInt ℓ) (q₁ : ℚ) (x : ↥Li),
        (z : Padic ℓ) • eVi (q₁ ⊗ₜ[ℤ] x) = eVi (q₁ ⊗ₜ[ℤ] smulLi z x) := by
      intro z q₁ x
      have h1 : ∀ w : ↥Li, q₁ ⊗ₜ[ℤ] w = q₁ • ((1 : ℚ) ⊗ₜ[ℤ] w) := by
        intro w; rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h1 x, h1 (smulLi z x), hEquivRat eVi, hEquivRat eVi,
        hsmulVi z x (smulLi z x) (fun _ => rfl), smul_comm]
    have hVj_int_tmul : ∀ (z : PadicInt ℓ) (q₂ : ℚ) (y : ↥Lj),
        (z : Padic ℓ) • eVj (q₂ ⊗ₜ[ℤ] y) = eVj (q₂ ⊗ₜ[ℤ] smulLj z y) := by
      intro z q₂ y
      have h1 : ∀ w : ↥Lj, q₂ ⊗ₜ[ℤ] w = q₂ • ((1 : ℚ) ⊗ₜ[ℤ] w) := by
        intro w; rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h1 y, h1 (smulLj z y), hEquivRat eVj, hEquivRat eVj,
        hsmulVj z y (smulLj z y) (fun _ => rfl), smul_comm]
    have hB₀_int_left : ∀ (z : PadicInt ℓ) (v : Vi) (w : Vj),
        B₀ ((z : Padic ℓ) • v) w = (z : Padic ℓ) * B₀ v w := by
      intro z v w
      rw [← eVi.apply_symm_apply v, ← eVj.apply_symm_apply w]
      generalize eVi.symm v = t
      generalize eVj.symm w = s
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul q₁ x =>
        rw [hVi_int_tmul z q₁ x]
        induction s using TensorProduct.induction_on with
        | zero => simp
        | tmul q₂ y =>
          rw [hB₀_tmul q₁ q₂ (smulLi z x) y, hB₀_tmul q₁ q₂ x y, hβ_smul_left z x y]
          push_cast; ring
        | add s₁ s₂ ih₁ ih₂ => rw [map_add, map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [map_add, smul_add, map_add, AddMonoidHom.add_apply, map_add, AddMonoidHom.add_apply,
          ih₁, ih₂, mul_add]
    have hB₀_int_right : ∀ (z : PadicInt ℓ) (v : Vi) (w : Vj),
        B₀ v ((z : Padic ℓ) • w) = (z : Padic ℓ) * B₀ v w := by
      intro z v w
      rw [← eVi.apply_symm_apply v, ← eVj.apply_symm_apply w]
      generalize eVi.symm v = t
      generalize eVj.symm w = s
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul q₁ x =>
        induction s using TensorProduct.induction_on with
        | zero => simp
        | tmul q₂ y =>
          rw [hVj_int_tmul z q₂ y, hB₀_tmul q₁ q₂ x (smulLj z y),
            hB₀_tmul q₁ q₂ x y, hβ_smul_right z x y]
          push_cast; ring
        | add s₁ s₂ ih₁ ih₂ => rw [map_add, smul_add, map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [map_add, map_add, AddMonoidHom.add_apply, AddMonoidHom.add_apply,
          ih₁, ih₂, mul_add]
    have hex_padic_denom : ∀ c : Padic ℓ, ∃ (k : ℕ) (z₀ : PadicInt ℓ),
        c = ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) * (z₀ : Padic ℓ) := by
      intro c
      have h1lt : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓ_prime.one_lt
      obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h1lt
      have hnorm : ‖(ℓ : Padic ℓ) ^ k * c‖ ≤ 1 := by
        rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
        have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by exact_mod_cast hℓ_pos) k
        calc
          ((ℓ : ℝ) ^ k)⁻¹ * ‖c‖ ≤ ((ℓ : ℝ) ^ k)⁻¹ * (ℓ : ℝ) ^ k :=
            mul_le_mul_of_nonneg_left (le_of_lt hk) (inv_nonneg.mpr (le_of_lt hpos))
          _ = 1 := inv_mul_cancel₀ (ne_of_gt hpos)
      refine ⟨k, ⟨(ℓ : Padic ℓ) ^ k * c, hnorm⟩, ?_⟩
      have hp_ne : (ℓ : Padic ℓ) ^ k ≠ 0 := pow_ne_zero k (Nat.cast_ne_zero.mpr hℓ_ne)
      change c = ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) * ((ℓ : Padic ℓ) ^ k * c)
      push_cast
      rw [← mul_assoc, inv_mul_cancel₀ hp_ne, one_mul]
    let B : Vi →ₗ[Padic ℓ] Vj →ₗ[Padic ℓ] Padic ℓ :=
      { toFun := fun v =>
          { toFun := fun w => B₀ v w
            map_add' := fun w₁ w₂ => map_add (B₀ v) w₁ w₂
            map_smul' := fun c w => by
              obtain ⟨k, z₀, rfl⟩ := hex_padic_denom c
              rw [mul_smul, hB₀_rat_right, hB₀_int_right, RingHom.id_apply, smul_eq_mul, mul_assoc] }
        map_add' := fun v₁ v₂ => by
          ext w
          exact AddMonoidHom.add_apply (B₀ v₁) (B₀ v₂) w ▸ congrArg (fun f => f w) (map_add B₀ v₁ v₂)
        map_smul' := fun c v => by
          ext w
          obtain ⟨k, z₀, rfl⟩ := hex_padic_denom c
          change B₀ ((((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) * (z₀ : Padic ℓ)) • v) w =
            ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) * (z₀ : Padic ℓ) * B₀ v w
          rw [mul_smul, hB₀_rat_left, hB₀_int_left, mul_assoc] }
    have hB_pure : ∀ (x : ↥Li) (y : ↥Lj),
        B (eVi ((1 : ℚ) ⊗ₜ[ℤ] x)) (eVj ((1 : ℚ) ⊗ₜ[ℤ] y)) = (β x y : Padic ℓ) := by
      intro x y
      change B₀ (eVi ((1 : ℚ) ⊗ₜ[ℤ] x)) (eVj ((1 : ℚ) ⊗ₜ[ℤ] y)) = (β x y : Padic ℓ)
      rw [hB₀_tmul 1 1 x y]
      simp
    have hB_frob : ∀ (v : Vi) (w : Vj),
        B (frobVi v) (frobVj w) = (q_card : Padic ℓ) ^ d * B v w := by
      intro v w
      rw [← eVi.apply_symm_apply v, ← eVj.apply_symm_apply w]
      generalize eVi.symm v = t
      generalize eVj.symm w = s
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul q₁ x =>
        have ht1 : q₁ ⊗ₜ[ℤ] x = q₁ • ((1 : ℚ) ⊗ₜ[ℤ] x) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [ht1, hEquivRat eVi]
        induction s using TensorProduct.induction_on with
        | zero => simp
        | tmul q₂ y =>
          have hs1 : q₂ ⊗ₜ[ℤ] y = q₂ • ((1 : ℚ) ⊗ₜ[ℤ] y) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [hs1, hEquivRat eVj,
            frobVi.map_smul, frobVj.map_smul,
            B.map_smul, LinearMap.smul_apply, (B _).map_smul,
            B.map_smul, LinearMap.smul_apply, (B _).map_smul,
            hfrobVi x (frobLi x) (fun _ => rfl), hfrobVj y (frobLj y) (fun _ => rfl),
            hB_pure (frobLi x) (frobLj y), hB_pure x y, hβ_frob x y]
          simp only [smul_eq_mul]
          push_cast
          ring
        | add s₁ s₂ ih₁ ih₂ =>
          rw [map_add, map_add, map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [map_add, map_add, map_add, LinearMap.add_apply, map_add, LinearMap.add_apply,
          ih₁, ih₂, mul_add]
    have hClearDenom : ∀ {L : Type u} [AddCommGroup L] (t : TensorProduct ℤ ℚ L),
        ∃ m : ℕ, m ≠ 0 ∧ ∃ x : L, m • t = (1 : ℚ) ⊗ₜ[ℤ] x := by
      intro L _ t
      induction t using TensorProduct.induction_on with
      | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
      | tmul q x₀ =>
        refine ⟨q.den, q.den_nz, q.num • x₀, ?_⟩
        have h1 : q.den • (q ⊗ₜ[ℤ] x₀) = ((q.den : ℤ) • q) ⊗ₜ[ℤ] x₀ := by
          rw [← natCast_zsmul, TensorProduct.smul_tmul']
        have h2 : ((q.den : ℤ) • q) = q.num • (1 : ℚ) := by
          rw [zsmul_eq_mul, Int.cast_natCast, mul_comm, Rat.mul_den_eq_num, zsmul_eq_mul, mul_one]
        rw [h1, h2, TensorProduct.smul_tmul]
      | add t₁ t₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨m₁, hm₁, x₁, hx₁⟩
        rcases ih₂ with ⟨m₂, hm₂, x₂, hx₂⟩
        refine ⟨m₁ * m₂, Nat.mul_ne_zero hm₁ hm₂, m₂ • x₁ + m₁ • x₂, ?_⟩
        have hmk_nsmul : ∀ (k : ℕ) (w : L), k • ((1 : ℚ) ⊗ₜ[ℤ] w) = (1 : ℚ) ⊗ₜ[ℤ] (k • w) :=
          fun k w => (map_nsmul ((TensorProduct.mk ℤ ℚ L) (1 : ℚ)).toAddMonoidHom k w).symm
        rw [smul_add, mul_comm m₁ m₂, mul_nsmul', hx₁, mul_comm m₂ m₁, mul_nsmul', hx₂,
          hmk_nsmul, hmk_nsmul, TensorProduct.tmul_add]
    have hB_inj : Function.Injective B := by
      obtain ⟨N_j, hNj⟩ := hLift_j
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro v hv
      rw [LinearMap.mem_ker] at hv
      obtain ⟨m, hm_ne, x, hx⟩ := hClearDenom (eVi.symm v)
      have hmv : m • v = eVi ((1 : ℚ) ⊗ₜ[ℤ] x) := by
        rw [← hx, map_nsmul, eVi.apply_symm_apply]
      have hβ0 : ∀ y : ↥Lj, β x y = 0 := by
        intro y; apply Subtype.ext
        change (β x y : Padic ℓ) = 0
        rw [← hB_pure x y, ← hmv, map_nsmul, hv, smul_zero, LinearMap.zero_apply]
      have hx_tors : (ℓ ^ N_j) • x = 0 := by
        apply Subtype.ext; funext r
        change (ℓ ^ N_j) • (x.1 r) = 0
        apply hpLeft r
        intro b
        obtain ⟨y, hy⟩ := hNj r b
        calc
          pSys r ((ℓ ^ N_j) • (x.1 r)) b
            = (ℓ ^ N_j) • (pSys r (x.1 r) b) := by rw [map_nsmul, AddMonoidHom.nsmul_apply]
          _ = pSys r (x.1 r) ((ℓ ^ N_j) • b) := (map_nsmul (pSys r (x.1 r)) (ℓ ^ N_j) b).symm
          _ = pSys r (x.1 r) (y.1 r) := by rw [hy]
          _ = PadicInt.toZModPow r (β x y) := (hβ_mod x y r).symm
          _ = 0 := by rw [hβ0 y, map_zero]
      have hmk_nsmul : ∀ (k : ℕ) (w : ↥Li), k • ((1 : ℚ) ⊗ₜ[ℤ] w) = (1 : ℚ) ⊗ₜ[ℤ] (k • w) :=
        fun k w => (map_nsmul ((TensorProduct.mk ℤ ℚ ↥Li) (1 : ℚ)).toAddMonoidHom k w).symm
      have hkill_v : ((ℓ ^ N_j * m : ℕ) : Padic ℓ) • v = 0 := by
        rw [Nat.cast_smul_eq_nsmul, mul_nsmul', hmv, ← map_nsmul, hmk_nsmul, hx_tors,
          TensorProduct.tmul_zero, map_zero]
      have hcoeff_ne : ((ℓ ^ N_j * m : ℕ) : Padic ℓ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (Nat.mul_ne_zero (pow_ne_zero N_j hℓ_ne) hm_ne)
      exact (smul_eq_zero.mp hkill_v).resolve_left hcoeff_ne
    have hB_flip_inj : Function.Injective B.flip := by
      obtain ⟨N_i, hNi⟩ := hLift_i
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro w hw
      rw [LinearMap.mem_ker] at hw
      obtain ⟨m, hm_ne, y, hy⟩ := hClearDenom (eVj.symm w)
      have hmw : m • w = eVj ((1 : ℚ) ⊗ₜ[ℤ] y) := by
        rw [← hy, map_nsmul, eVj.apply_symm_apply]
      have hβ0 : ∀ x : ↥Li, β x y = 0 := by
        intro x; apply Subtype.ext
        change (β x y : Padic ℓ) = 0
        rw [← hB_pure x y, ← hmw, map_nsmul]
        have hvw : B (eVi ((1 : ℚ) ⊗ₜ[ℤ] x)) w = 0 := by
          change B.flip w (eVi ((1 : ℚ) ⊗ₜ[ℤ] x)) = 0
          rw [hw, LinearMap.zero_apply]
        rw [hvw, smul_zero]
      have hy_tors : (ℓ ^ N_i) • y = 0 := by
        apply Subtype.ext; funext r
        change (ℓ ^ N_i) • (y.1 r) = 0
        apply hpRight r
        intro a
        obtain ⟨x, hx⟩ := hNi r a
        calc
          pSys r a ((ℓ ^ N_i) • (y.1 r))
            = (ℓ ^ N_i) • (pSys r a (y.1 r)) := map_nsmul (pSys r a) (ℓ ^ N_i) (y.1 r)
          _ = pSys r ((ℓ ^ N_i) • a) (y.1 r) := by rw [map_nsmul, AddMonoidHom.nsmul_apply]
          _ = pSys r (x.1 r) (y.1 r) := by rw [hx]
          _ = PadicInt.toZModPow r (β x y) := (hβ_mod x y r).symm
          _ = 0 := by rw [hβ0 x, map_zero]
      have hmk_nsmul : ∀ (k : ℕ) (z : ↥Lj), k • ((1 : ℚ) ⊗ₜ[ℤ] z) = (1 : ℚ) ⊗ₜ[ℤ] (k • z) :=
        fun k z => (map_nsmul ((TensorProduct.mk ℤ ℚ ↥Lj) (1 : ℚ)).toAddMonoidHom k z).symm
      have hkill_w : ((ℓ ^ N_i * m : ℕ) : Padic ℓ) • w = 0 := by
        rw [Nat.cast_smul_eq_nsmul, mul_nsmul', hmw, ← map_nsmul, hmk_nsmul, hy_tors,
          TensorProduct.tmul_zero, map_zero]
      have hcoeff_ne : ((ℓ ^ N_i * m : ℕ) : Padic ℓ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (Nat.mul_ne_zero (pow_ne_zero N_i hℓ_ne) hm_ne)
      exact (smul_eq_zero.mp hkill_w).resolve_left hcoeff_ne
    have hle1 : Module.finrank (Padic ℓ) Vi ≤
        Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) Vj) :=
      LinearMap.finrank_le_finrank_of_injective hB_inj
    have hle2 : Module.finrank (Padic ℓ) Vj ≤
        Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) Vi) :=
      LinearMap.finrank_le_finrank_of_injective hB_flip_inj
    rw [Subspace.dual_finrank_eq] at hle1 hle2
    have hfinrank_eq : Module.finrank (Padic ℓ) Vi =
        Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) Vj) := by
      rw [Subspace.dual_finrank_eq]
      exact le_antisymm hle1 hle2
    exact ⟨B, ⟨hB_inj, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfinrank_eq).mp hB_inj⟩,
      hB_frob⟩
  
  let S := weilGeomScheme K Z
  have hmemSys : ∀ (k : ℕ) (f : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) k),
      f ∈ weilEtaleIntegralSystem S ℓ k ↔
      ∀ r : ℕ, weilEtaleTorsionTransition S ℓ r k (f (r + 1)) = f r := by
    intro k f
    rw [weilEtaleIntegralSystem, AddMonoidHom.mem_ker, funext_iff]
    exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
  obtain ⟨resH, hres_step, hTors, hres_comp, hStepBock, hConnBock⟩ := hStage1 S
  have hmemRes : ∀ (k : ℕ) (f : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) k),
      f ∈ weilEtaleIntegralSystem S ℓ k ↔
      ∀ r : ℕ, resH k (Nat.le_succ r) (f (r + 1)) = f r := by
    intro k f
    rw [hmemSys]
    exact forall_congr' fun r => by rw [hres_step]
  have hLift_i : ∃ N_i : ℕ, ∀ (r : ℕ) (a : weilEtaleTorsionH S (ℓ ^ r) i),
      ∃ x : ↥(weilEtaleIntegralSystem S ℓ i), x.1 r = (ℓ ^ N_i) • a := by
    obtain ⟨ι₁, ρ₁, hExact₁, hCommι₁, hMulℓ₁, hCommρ₁⟩ := hStepBock (i + 1)
    obtain ⟨Δ, hΔ_lift⟩ := hConnBock i
    exact hStage2 _ _ (hFin i) (hFin (i + 1)) (hTors i) (hTors (i + 1))
      (fun hab => resH i hab) (fun hab hbc u => hres_comp i hab hbc u)
      (fun r => weilEtaleTorsionTransition S ℓ r (i + 1)) ι₁ ρ₁
      hExact₁ hCommι₁ hMulℓ₁ hCommρ₁
      (weilEtaleIntegralSystem S ℓ i) (hmemRes i)
      (weilEtaleIntegralSystem S ℓ (i + 1)) (hmemSys (i + 1))
      Δ hΔ_lift
  have hLift_j : ∃ N_j : ℕ, ∀ (r : ℕ) (b : weilEtaleTorsionH S (ℓ ^ r) j),
      ∃ y : ↥(weilEtaleIntegralSystem S ℓ j), y.1 r = (ℓ ^ N_j) • b := by
    obtain ⟨ι₁, ρ₁, hExact₁, hCommι₁, hMulℓ₁, hCommρ₁⟩ := hStepBock (j + 1)
    obtain ⟨Δ, hΔ_lift⟩ := hConnBock j
    exact hStage2 _ _ (hFin j) (hFin (j + 1)) (hTors j) (hTors (j + 1))
      (fun hab => resH j hab) (fun hab hbc u => hres_comp j hab hbc u)
      (fun r => weilEtaleTorsionTransition S ℓ r (j + 1)) ι₁ ρ₁
      hExact₁ hCommι₁ hMulℓ₁ hCommρ₁
      (weilEtaleIntegralSystem S ℓ j) (hmemRes j)
      (weilEtaleIntegralSystem S ℓ (j + 1)) (hmemSys (j + 1))
      Δ hΔ_lift
  exact hStage3 _ _
    (fun r => weilEtaleTorsionTransition S ℓ r i)
    (fun r => weilEtaleTorsionTransition S ℓ r j)
    (weilEtaleIntegralSystem S ℓ i) (hmemSys i)
    (weilEtaleIntegralSystem S ℓ j) (hmemSys j)
    (hTors i) (hTors j)
    Mi.frobTorsion hFrobTrans_i Mj.frobTorsion hFrobTrans_j
    pair hCompat hLeft hRight (Nat.card K) hFrob
    hLift_i hLift_j
    Mi.V Mj.V Mi.frob Mj.frob Mi.equiv Mj.equiv
    Mi.hsmul Mj.hsmul Mi.hfrob Mj.hfrob

theorem weil_etale_poincare_duality_pairing (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Z.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (i : ℕ) (hi : i ≤ 2 * d)
    (Mi : WeilEllAdicCohomologyModel K Z ℓ i)
    (M_dual : WeilEllAdicCohomologyModel K Z ℓ (2 * d - i)) :
    ∃ B : Mi.V →ₗ[Padic ℓ] M_dual.V →ₗ[Padic ℓ] Padic ℓ,
      Function.Bijective B ∧
      ∀ (x : Mi.V) (y : M_dual.V),
        B (Mi.frob x) (M_dual.frob y) = (Nat.card K : Padic ℓ) ^ d * B x y :=
by
  classical
  let k_bar : Type u := AlgebraicClosure K
  let X_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k_bar)) :=
    weilBaseChangeOver K k_bar Z
  let S : AlgebraicGeometry.Scheme.{u} := weilGeomScheme K Z
  obtain ⟨hIntS, hPropS, hSmS⟩ := weil_smooth_algClosure_baseChange_integral K Z d
  letI : AlgebraicGeometry.IsProper X_bar.hom := hPropS
  letI : AlgebraicGeometry.SmoothOfRelativeDimension d X_bar.hom := hSmS
  have hchar_kbar : CharP k_bar (ringChar K) :=
    (RingHom.charP_iff_charP (algebraMap K k_bar) (ringChar K)).mp inferInstance
  have hchar_eq : ringChar k_bar = ringChar K :=
    @ringChar.eq k_bar _ (ringChar K) hchar_kbar
  have hℓ_bar : ℓ ≠ ringChar k_bar := by
    rw [hchar_eq]
    exact hℓ
  have hFin : ∀ (k r : ℕ), Finite (weilEtaleTorsionH S (ℓ ^ r) k) :=
    fun k r => weil_etale_proper_torsion_finiteness K Z d ℓ hℓ k r
  obtain ⟨hModComp1, hModComp2, hModComp3⟩ := weil_etale_module_ext_comparison.{u}
  obtain ⟨hFrobEx, hFrobTrans, hFrobCup⟩ := hModComp3 K Z
  let θ : ∀ (m k : ℕ), weilEtaleModuleH S m k →+ weilEtaleTorsionH S m k :=
    fun m k => Classical.choose (hModComp1 S m k).1
  have hθ : ∀ (m k : ℕ), WeilIsModuleToTorsionComparison S m k (θ m k) :=
    fun m k => (Classical.choose_spec (hModComp1 S m k).1).1
  have hθ_bij : ∀ (m k : ℕ), Function.Bijective (θ m k) :=
    fun m k => (Classical.choose_spec (hModComp1 S m k).1).2
  let eθ : ∀ (m k : ℕ), weilEtaleModuleH S m k ≃+ weilEtaleTorsionH S m k :=
    fun m k => AddEquiv.ofBijective (θ m k) (hθ_bij m k)
  have heθ_symm : ∀ (m k : ℕ) (u : weilEtaleTorsionH S m k),
      θ m k ((eθ m k).symm u) = u :=
    fun m k u => (eθ m k).apply_symm_apply u
  have hsymm_eθ : ∀ (m k : ℕ) (v : weilEtaleModuleH S m k),
      (eθ m k).symm (θ m k v) = v :=
    fun m k v => (eθ m k).symm_apply_apply v
  let j : ℕ := 2 * d - i
  have hc : i + j = 2 * d := Nat.add_sub_of_le hi
  let cupMod : ∀ m : ℕ, weilEtaleModuleH S m i →+
      weilEtaleModuleH S m j →+ weilEtaleModuleH S m (2 * d) :=
    fun m => AddMonoidHom.mk'
      (fun a => AddMonoidHom.mk'
        (fun b => CategoryTheory.Abelian.Ext.comp a b hc)
        (fun b₁ b₂ => CategoryTheory.Abelian.Ext.comp_add a b₁ b₂ hc))
      (fun a₁ a₂ => by
        ext b
        exact CategoryTheory.Abelian.Ext.add_comp a₁ a₂ b hc)
  let cup : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) i →+
      weilEtaleTorsionH S (ℓ ^ r) j →+ weilEtaleTorsionH S (ℓ ^ r) (2 * d) :=
    fun r => AddMonoidHom.mk'
      (fun a => (θ (ℓ ^ r) (2 * d)).comp
        ((cupMod (ℓ ^ r) ((eθ (ℓ ^ r) i).symm a)).comp (eθ (ℓ ^ r) j).symm.toAddMonoidHom))
      (fun a₁ a₂ => by
        ext b
        simp only [AddMonoidHom.comp_apply, AddEquiv.toAddMonoidHom_eq_coe,
          AddMonoidHom.coe_coe, map_add, AddMonoidHom.add_apply])
  obtain ⟨tr, _, hTrCompat, hNonDeg⟩ :=
    weil_etale_smooth_proper_torsion_poincare_duality k_bar X_bar hIntS d ℓ hℓ_bar
  let pair : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) i →+
      weilEtaleTorsionH S (ℓ ^ r) j →+ ZMod (ℓ ^ r) :=
    fun r => AddMonoidHom.mk'
      (fun a => (tr r).comp (cup r a))
      (fun a₁ a₂ => by
        ext b
        simp only [AddMonoidHom.comp_apply, map_add, AddMonoidHom.add_apply])
  have hFrobTrans_i : ∀ (r : ℕ) (a : weilEtaleTorsionH S (ℓ ^ (r + 1)) i),
      weilEtaleTorsionTransition S ℓ r i (Mi.frobTorsion (r + 1) a) =
        Mi.frobTorsion r (weilEtaleTorsionTransition S ℓ r i a) :=
    fun r a => hFrobTrans ℓ r i (Mi.frobTorsion (r + 1)) (Mi.frobTorsion r)
      (Mi.hfrobTorsion (r + 1)) (Mi.hfrobTorsion r) a
  have hFrobTrans_j : ∀ (r : ℕ) (b : weilEtaleTorsionH S (ℓ ^ (r + 1)) j),
      weilEtaleTorsionTransition S ℓ r j (M_dual.frobTorsion (r + 1) b) =
        M_dual.frobTorsion r (weilEtaleTorsionTransition S ℓ r j b) :=
    fun r b => hFrobTrans ℓ r j (M_dual.frobTorsion (r + 1)) (M_dual.frobTorsion r)
      (M_dual.hfrobTorsion (r + 1)) (M_dual.hfrobTorsion r) b
  have hCompat : ∀ (r : ℕ) (a : weilEtaleTorsionH S (ℓ ^ (r + 1)) i)
      (b : weilEtaleTorsionH S (ℓ ^ (r + 1)) j),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (pair (r + 1) a b) =
        pair r (weilEtaleTorsionTransition S ℓ r i a)
          (weilEtaleTorsionTransition S ℓ r j b) := by
    intro r a b
    let a₁ := (eθ (ℓ ^ (r + 1)) i).symm a
    let b₁ := (eθ (ℓ ^ (r + 1)) j).symm b
    let a₀ := (eθ (ℓ ^ r) i).symm (weilEtaleTorsionTransition S ℓ r i a)
    let b₀ := (eθ (ℓ ^ r) j).symm (weilEtaleTorsionTransition S ℓ r j b)
    have ha : weilEtaleTorsionTransition S ℓ r i (θ (ℓ ^ (r + 1)) i a₁) = θ (ℓ ^ r) i a₀ := by
      dsimp [a₁, a₀]
      rw [heθ_symm, heθ_symm]
    have hb : weilEtaleTorsionTransition S ℓ r j (θ (ℓ ^ (r + 1)) j b₁) = θ (ℓ ^ r) j b₀ := by
      dsimp [b₁, b₀]
      rw [heθ_symm, heθ_symm]
    have hcup := hModComp2 S ℓ r i j (2 * d) hc
      (θ (ℓ ^ (r + 1)) i) (θ (ℓ ^ r) i)
      (θ (ℓ ^ (r + 1)) j) (θ (ℓ ^ r) j)
      (θ (ℓ ^ (r + 1)) (2 * d)) (θ (ℓ ^ r) (2 * d))
      (hθ _ _) (hθ _ _) (hθ _ _) (hθ _ _) (hθ _ _) (hθ _ _)
      a₁ b₁ a₀ b₀ ha hb
    change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
        (tr (r + 1) (cup (r + 1) a b)) =
      tr r (cup r (weilEtaleTorsionTransition S ℓ r i a) (weilEtaleTorsionTransition S ℓ r j b))
    rw [hTrCompat r (cup (r + 1) a b)]
    congr 1
  have hLeft : ∀ (r : ℕ) (a : weilEtaleTorsionH S (ℓ ^ r) i),
      (∀ b : weilEtaleTorsionH S (ℓ ^ r) j, pair r a b = 0) → a = 0 := by
    intro r a ha0
    have hND := (hNonDeg r i hi (θ (ℓ ^ r) (2 * d)) (hθ (ℓ ^ r) (2 * d))).1
      ((eθ (ℓ ^ r) i).symm a)
    have hsymm0 : (eθ (ℓ ^ r) i).symm a = 0 := by
      apply hND
      intro b_mod
      have hspec := ha0 (θ (ℓ ^ r) j b_mod)
      change tr r (θ (ℓ ^ r) (2 * d)
        (CategoryTheory.Abelian.Ext.comp ((eθ (ℓ ^ r) i).symm a)
          ((eθ (ℓ ^ r) j).symm (θ (ℓ ^ r) j b_mod)) hc)) = 0 at hspec
      rwa [hsymm_eθ] at hspec
    calc
      a = θ (ℓ ^ r) i ((eθ (ℓ ^ r) i).symm a) := (heθ_symm (ℓ ^ r) i a).symm
      _ = θ (ℓ ^ r) i 0 := by rw [hsymm0]
      _ = 0 := map_zero _
  have hRight : ∀ (r : ℕ) (b : weilEtaleTorsionH S (ℓ ^ r) j),
      (∀ a : weilEtaleTorsionH S (ℓ ^ r) i, pair r a b = 0) → b = 0 := by
    intro r b hb0
    have hND := (hNonDeg r i hi (θ (ℓ ^ r) (2 * d)) (hθ (ℓ ^ r) (2 * d))).2
      ((eθ (ℓ ^ r) j).symm b)
    have hsymm0 : (eθ (ℓ ^ r) j).symm b = 0 := by
      apply hND
      intro a_mod
      have hspec := hb0 (θ (ℓ ^ r) i a_mod)
      change tr r (θ (ℓ ^ r) (2 * d)
        (CategoryTheory.Abelian.Ext.comp
          ((eθ (ℓ ^ r) i).symm (θ (ℓ ^ r) i a_mod))
          ((eθ (ℓ ^ r) j).symm b) hc)) = 0 at hspec
      rwa [hsymm_eθ] at hspec
    calc
      b = θ (ℓ ^ r) j ((eθ (ℓ ^ r) j).symm b) := (heθ_symm (ℓ ^ r) j b).symm
      _ = θ (ℓ ^ r) j 0 := by rw [hsymm0]
      _ = 0 := map_zero _
  have hFrob : ∀ (r : ℕ) (a : weilEtaleTorsionH S (ℓ ^ r) i)
      (b : weilEtaleTorsionH S (ℓ ^ r) j),
      pair r (Mi.frobTorsion r a) (M_dual.frobTorsion r b) =
        ((Nat.card K : ZMod (ℓ ^ r)) ^ d) * pair r a b := by
    intro r a b
    obtain ⟨f_top, hf_top⟩ := hFrobEx (ℓ ^ r) (2 * d)
    let a₁ := (eθ (ℓ ^ r) i).symm a
    let b₁ := (eθ (ℓ ^ r) j).symm b
    let a' := (eθ (ℓ ^ r) i).symm (Mi.frobTorsion r a)
    let b' := (eθ (ℓ ^ r) j).symm (M_dual.frobTorsion r b)
    have ha' : Mi.frobTorsion r (θ (ℓ ^ r) i a₁) = θ (ℓ ^ r) i a' := by
      dsimp [a₁, a']
      rw [heθ_symm, heθ_symm]
    have hb' : M_dual.frobTorsion r (θ (ℓ ^ r) j b₁) = θ (ℓ ^ r) j b' := by
      dsimp [b₁, b']
      rw [heθ_symm, heθ_symm]
    have hcup_frob := hFrobCup (ℓ ^ r) i j (2 * d) hc
      (Mi.frobTorsion r) (M_dual.frobTorsion r) f_top
      (θ (ℓ ^ r) i) (θ (ℓ ^ r) j) (θ (ℓ ^ r) (2 * d))
      (Mi.hfrobTorsion r) (M_dual.hfrobTorsion r) hf_top
      (hθ _ _) (hθ _ _) (hθ _ _)
      a₁ b₁ a' b' ha' hb'
    have hcup_eq : cup r (Mi.frobTorsion r a) (M_dual.frobTorsion r b) = f_top (cup r a b) :=
      hcup_frob.symm
    have htop := weil_etale_top_degree_geom_frob_smul K Z d ℓ hℓ r f_top hf_top (cup r a b)
    change tr r (cup r (Mi.frobTorsion r a) (M_dual.frobTorsion r b)) =
      ((Nat.card K : ZMod (ℓ ^ r)) ^ d) * tr r (cup r a b)
    rw [hcup_eq, htop, map_nsmul, nsmul_eq_mul, Nat.cast_pow]
  exact weil_ell_adic_poincare_pairing_of_torsion_system K Z d ℓ i j
    Mi M_dual hFin hFrobTrans_i hFrobTrans_j pair hCompat hLeft hRight hFrob

theorem weil_closed_frob_fixed_card_eq_pointCount (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Z.hom]
    (n : ℕ) (hn : 1 ≤ n) :
    Nat.card { x : ↥(weilGeomScheme K Z) //
      IsClosed ({x} : Set ↥(weilGeomScheme K Z)) ∧
      (⇑(weilGeomFrobHom K Z).base)^[n] x = x } =
    weilPointCount K Z n :=
by
  let Kbar := AlgebraicClosure K
  let instFinK : Fintype K := Fintype.ofFinite K
  let φ : Kbar ≃ₐ[K] Kbar :=
    @FiniteField.frobeniusAlgEquivOfAlgebraic K _ instFinK Kbar _ _ _
  let ψ : Kbar ≃ₐ[K] Kbar := φ.symm
  let f₂ : AlgebraicGeometry.Spec (CommRingCat.of Kbar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of K) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K Kbar))
  let i₂ : AlgebraicGeometry.Spec (CommRingCat.of Kbar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of Kbar) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
  let j₂ : AlgebraicGeometry.Spec (CommRingCat.of Kbar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of Kbar) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom)
  let S : AlgebraicGeometry.Scheme.{u} := weilGeomScheme K Z
  let fst : S ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom f₂
  let p : S ⟶ AlgebraicGeometry.Spec (CommRingCat.of Kbar) :=
    (weilBaseChangeOver K Kbar Z).hom
  let g : S ⟶ S := weilGeomFrobHom K Z
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Kbar)) := default

  
  have _ : AlgebraicGeometry.LocallyOfFiniteType Z.hom :=
    AlgebraicGeometry.IsProper.toLocallyOfFiniteType
  have _ : AlgebraicGeometry.IsSeparated Z.hom :=
    AlgebraicGeometry.IsProper.toIsSeparated
  have _ : AlgebraicGeometry.LocallyOfFiniteType p :=
    AlgebraicGeometry.instLocallyOfFiniteTypeSndScheme Z.hom f₂
  have _ : AlgebraicGeometry.IsSeparated p :=
    AlgebraicGeometry.IsSeparated.instSndScheme Z.hom f₂

  
  obtain ⟨ι_S, hι_S⟩ : ∃ ι_S : ∀ x : ↥S, CommRingCat.of Kbar ⟶ S.residueField x,
      ∀ x : ↥S, AlgebraicGeometry.Spec.map (ι_S x) = S.fromSpecResidueField x ≫ p :=
    ⟨fun x => (AlgebraicGeometry.Spec.fullyFaithful.preimage
        (S.fromSpecResidueField x ≫ p)).unop,
     fun _ => AlgebraicGeometry.Spec.fullyFaithful.map_preimage _⟩

  have h_closed_iff_bij : ∀ x : ↥S,
      IsClosed ({x} : Set ↥S) ↔ Function.Bijective (ι_S x).hom := by
    intro x
    constructor
    · intro hx
      have _ : AlgebraicGeometry.IsClosedImmersion (S.fromSpecResidueField x) :=
        (AlgebraicGeometry.isClosed_singleton_iff_isClosedImmersion (x := x)).mp hx
      have hlft_comp : AlgebraicGeometry.LocallyOfFiniteType (S.fromSpecResidueField x ≫ p) :=
        inferInstance
      rw [← hι_S x] at hlft_comp
      have hft : RingHom.FiniteType (ι_S x).hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hlft_comp
      have hfin : RingHom.Finite (ι_S x).hom :=
        RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hft
      let _ : Algebra Kbar ↥(S.residueField x) := (ι_S x).hom.toAlgebra
      have _ : Module.Finite Kbar ↥(S.residueField x) := hfin
      have _ : Algebra.IsIntegral Kbar ↥(S.residueField x) :=
        Algebra.IsIntegral.of_finite Kbar ↥(S.residueField x)
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral
    · intro hbij
      have hci_spec : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map (ι_S x)) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (ι_S x) hbij.surjective
      rw [hι_S x] at hci_spec
      have hci : AlgebraicGeometry.IsClosedImmersion (S.fromSpecResidueField x) :=
        AlgebraicGeometry.IsClosedImmersion.of_comp (S.fromSpecResidueField x) p
      exact (AlgebraicGeometry.isClosed_singleton_iff_isClosedImmersion (x := x)).mpr hci

  let eS₀ := AlgebraicGeometry.Scheme.SpecToEquivOfField Kbar S
  have h_eS₀_pt : ∀ (s : AlgebraicGeometry.Spec (CommRingCat.of Kbar) ⟶ S)
      (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Kbar))),
      s.base pt = (eS₀ s).1 := by
    intro s pt
    conv_lhs => rw [← eS₀.symm_apply_apply s]
    rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply]
    exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply (eS₀ s).1
      ((AlgebraicGeometry.Spec.map (eS₀ s).2).base pt)

  have h_eS₀_sec : ∀ xf : (x : ↥S) × (S.residueField x ⟶ CommRingCat.of Kbar),
      (eS₀.symm xf ≫ p = 𝟙 _) ↔ (ι_S xf.1 ≫ xf.2 = 𝟙 _) := by
    intro xf
    rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply, Category.assoc,
      ← hι_S xf.1, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
    exact AlgebraicGeometry.Spec.map_injective.eq_iff

  have h_rinv : ∀ (x : ↥S) (α : S.residueField x ⟶ CommRingCat.of Kbar),
      ι_S x ≫ α = 𝟙 _ → ∀ y : ↥(S.residueField x), (ι_S x).hom (α.hom y) = y := by
    intro x α hα y
    apply RingHom.injective α.hom
    exact CategoryTheory.ConcreteCategory.congr_hom hα (α.hom y)

  let Sec := { s : AlgebraicGeometry.Spec (CommRingCat.of Kbar) ⟶ S // s ≫ p = 𝟙 _ }

  have h_sec_ext : ∀ s₁ s₂ : Sec, s₁.1.base pt₀ = s₂.1.base pt₀ → s₁ = s₂ := by
    intro s₁ s₂ hpt
    apply Subtype.ext
    apply eS₀.injective
    have hx : (eS₀ s₁.1).1 = (eS₀ s₂.1).1 := by
      rw [← h_eS₀_pt s₁.1 pt₀, ← h_eS₀_pt s₂.1 pt₀, hpt]
    have hα₁ : ι_S (eS₀ s₁.1).1 ≫ (eS₀ s₁.1).2 = 𝟙 _ :=
      (h_eS₀_sec (eS₀ s₁.1)).mp (by rw [eS₀.symm_apply_apply]; exact s₁.2)
    have hα₂ : ι_S (eS₀ s₂.1).1 ≫ (eS₀ s₂.1).2 = 𝟙 _ :=
      (h_eS₀_sec (eS₀ s₂.1)).mp (by rw [eS₀.symm_apply_apply]; exact s₂.2)
    rcases h1 : eS₀ s₁.1 with ⟨x₁, α₁⟩
    rcases h2 : eS₀ s₂.1 with ⟨x₂, α₂⟩
    rw [h1] at hx hα₁
    rw [h2] at hx hα₂
    dsimp only at hx hα₁ hα₂
    subst hx
    congr 1
    ext y
    calc α₁.hom y = α₁.hom ((ι_S x₁).hom (α₂.hom y)) := by rw [h_rinv x₁ α₂ hα₂ y]
    _ = α₂.hom y := CategoryTheory.ConcreteCategory.congr_hom hα₁ (α₂.hom y)

  have h_sec_closed : ∀ s : Sec, IsClosed ({s.1.base pt₀} : Set ↥S) := by
    intro s
    rw [h_eS₀_pt s.1 pt₀, h_closed_iff_bij]
    have hα : ι_S (eS₀ s.1).1 ≫ (eS₀ s.1).2 = 𝟙 _ :=
      (h_eS₀_sec (eS₀ s.1)).mp (by rw [eS₀.symm_apply_apply]; exact s.2)
    exact ⟨RingHom.injective (ι_S (eS₀ s.1).1).hom,
      fun y => ⟨(eS₀ s.1).2.hom y, h_rinv (eS₀ s.1).1 (eS₀ s.1).2 hα y⟩⟩

  let e_sec_cl : Sec ≃ { x : ↥S // IsClosed ({x} : Set ↥S) } :=
    { toFun := fun s => ⟨s.1.base pt₀, h_sec_closed s⟩
      invFun := fun ⟨x, hx⟩ =>
        let hbij := (h_closed_iff_bij x).mp hx
        let α_x : S.residueField x ⟶ CommRingCat.of Kbar :=
          CommRingCat.ofHom (RingEquiv.ofBijective (ι_S x).hom hbij).symm.toRingHom
        ⟨eS₀.symm ⟨x, α_x⟩, (h_eS₀_sec ⟨x, α_x⟩).mpr (by
          ext c
          exact (RingEquiv.ofBijective (ι_S x).hom hbij).symm_apply_apply c)⟩
      left_inv := fun s => by
        apply h_sec_ext
        dsimp only
        rw [h_eS₀_pt, eS₀.apply_symm_apply]
      right_inv := fun ⟨x, hx⟩ => by
        apply Subtype.ext
        dsimp only
        rw [h_eS₀_pt, eS₀.apply_symm_apply] }

  
  have hg_fst : g ≫ fst = fst := by
    dsimp only [g, fst, S, f₂, Kbar, weilGeomFrobHom, weilGeomScheme, weilBaseChangeOver]
    rw [CategoryTheory.Limits.pullback.lift_fst, Category.comp_id]

  have hg_snd : g ≫ p = p ≫ i₂ := by
    dsimp only [g, p, S, i₂, ψ, φ, instFinK, f₂, Kbar, weilGeomFrobHom, weilGeomScheme,
      weilBaseChangeOver]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hj₂_i₂ : j₂ ≫ i₂ = 𝟙 _ := by
    dsimp only [j₂, i₂]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have h_id : CommRingCat.ofHom ψ.toRingHom ≫ CommRingCat.ofHom φ.toRingHom = 𝟙 _ := by
      ext c
      exact φ.apply_symm_apply c
    rw [h_id, AlgebraicGeometry.Spec.map_id]

  let F : Sec → Sec := fun s =>
    ⟨j₂ ≫ s.1 ≫ g, by
      rw [Category.assoc, Category.assoc, hg_snd, ← Category.assoc s.1 p i₂,
        s.2, Category.id_comp, hj₂_i₂]⟩

  have hF_pt : ∀ (m : ℕ) (s : Sec),
      (F^[m] s).1.base pt₀ = (⇑g.base)^[m] (s.1.base pt₀) := by
    intro m
    induction m with
    | zero =>
      intro s
      rfl
    | succ m ih =>
      intro s
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
      have hsub : j₂.base pt₀ = pt₀ := Subsingleton.elim _ _
      change g.base ((F^[m] s).1.base (j₂.base pt₀)) = _
      rw [hsub, ih s]

  let e_cl_F : { x : ↥S // IsClosed ({x} : Set ↥S) ∧ (⇑g.base)^[n] x = x } ≃
      { s : Sec // F^[n] s = s } :=
    { toFun := fun ⟨x, hx_cl, hx_fix⟩ =>
        ⟨e_sec_cl.symm ⟨x, hx_cl⟩, by
          apply h_sec_ext
          rw [hF_pt n]
          have h_ev : (e_sec_cl.symm ⟨x, hx_cl⟩).1.base pt₀ = x :=
            congrArg Subtype.val (e_sec_cl.apply_symm_apply ⟨x, hx_cl⟩)
          rw [h_ev, hx_fix]⟩
      invFun := fun ⟨s, hs⟩ =>
        ⟨(e_sec_cl s).1, (e_sec_cl s).2, by
          change (⇑g.base)^[n] (s.1.base pt₀) = s.1.base pt₀
          rw [← hF_pt n s, hs]⟩
      left_inv := fun ⟨x, hx_cl, _⟩ => by
        apply Subtype.ext
        dsimp only
        exact congrArg Subtype.val (e_sec_cl.apply_symm_apply ⟨x, hx_cl⟩)
      right_inv := fun ⟨s, _⟩ => by
        apply Subtype.ext
        dsimp only
        exact e_sec_cl.symm_apply_apply s }

  have h_pb_cond : fst ≫ Z.hom = p ≫ f₂ := CategoryTheory.Limits.pullback.condition

  let secEquivOver : Sec ≃ (CategoryTheory.Over.mk f₂ ⟶ Z) :=
    { toFun := fun s => CategoryTheory.Over.homMk (s.1 ≫ fst) (by
        dsimp only [CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
        rw [Category.assoc, h_pb_cond, ← Category.assoc, s.2, Category.id_comp])
      invFun := fun z =>
        ⟨CategoryTheory.Limits.pullback.lift z.left (𝟙 _) (by
            rw [Category.id_comp]
            exact CategoryTheory.Over.w z),
         by
           dsimp only [p, S, Kbar, weilGeomScheme, weilBaseChangeOver]
           exact CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
      left_inv := fun s => by
        apply Subtype.ext
        have hs2 : s.1 ≫ CategoryTheory.Limits.pullback.snd Z.hom f₂ = 𝟙 _ := s.2
        dsimp only [S, fst, Kbar, weilGeomScheme, weilBaseChangeOver] at *
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
        · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans hs2.symm
      right_inv := fun z => by
        ext1
        dsimp only [fst, S, Kbar, weilGeomScheme, weilBaseChangeOver]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _ }

  have hF_fst : ∀ (m : ℕ) (s : Sec),
      (F^[m] s).1 ≫ fst =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ ^ m).toRingHom)) ≫
          (s.1 ≫ fst) := by
    intro m
    induction m with
    | zero =>
      intro s
      have h0 : CommRingCat.ofHom ((φ ^ 0).toRingHom) = 𝟙 (CommRingCat.of Kbar) := by
        ext c
        simp
      rw [Function.iterate_zero_apply, h0, AlgebraicGeometry.Spec.map_id, Category.id_comp]
    | succ m ih =>
      intro s
      rw [Function.iterate_succ_apply']
      change (j₂ ≫ (F^[m] s).1 ≫ g) ≫ fst = _
      rw [Category.assoc, Category.assoc, hg_fst, ih s, ← Category.assoc]
      congr 1
      dsimp only [j₂]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext c
      change φ ((φ ^ m) c) = (φ ^ (m + 1)) c
      rw [pow_succ' φ m, AlgEquiv.mul_apply]

  let α_n : Kbar ≃ₐ[K] Kbar := φ ^ n

  let e_F_over : { s : Sec // F^[n] s = s } ≃
      { z : CategoryTheory.Over.mk f₂ ⟶ Z //
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_n.toRingHom) ≫ z.left = z.left } :=
    Equiv.subtypeEquiv secEquivOver fun s => by
      constructor
      · intro hs
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ ^ n).toRingHom)) ≫
          (s.1 ≫ fst) = s.1 ≫ fst
        rw [← hF_fst n s, hs]
      · intro hz
        apply secEquivOver.injective
        ext1
        change (F^[n] s).1 ≫ fst = s.1 ≫ fst
        rw [hF_fst n s]
        exact hz

  
  obtain ⟨ι_Z, hι_Z⟩ : ∃ ι_Z : ∀ x : ↥Z.left, CommRingCat.of K ⟶ Z.left.residueField x,
      ∀ x : ↥Z.left,
        AlgebraicGeometry.Spec.map (ι_Z x) = Z.left.fromSpecResidueField x ≫ Z.hom :=
    ⟨fun x => (AlgebraicGeometry.Spec.fullyFaithful.preimage
        (Z.left.fromSpecResidueField x ≫ Z.hom)).unop,
     fun _ => AlgebraicGeometry.Spec.fullyFaithful.map_preimage _⟩

  let algRes : ∀ x : ↥Z.left, Algebra K ↥(Z.left.residueField x) :=
    fun x => (ι_Z x).hom.toAlgebra

  have h_ex_equivOverSigma :
      ∃ equivOverSigma : ∀ (L : Type u) [Field L] [Algebra K L],
          (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap K L))) ⟶ Z) ≃
          (Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) L _ _ _ (algRes x) _),
        ∀ (L : Type u) [Field L] [Algebra K L] (x : ↥Z.left)
          (σ : @AlgHom K ↥(Z.left.residueField x) L _ _ _ (algRes x) _),
          ((equivOverSigma L).symm ⟨x, σ⟩).left =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
              Z.left.fromSpecResidueField x := by
    have he₀_cond : ∀ (L : Type u) [Field L] [Algebra K L]
        (xf : (x : ↥Z.left) × (Z.left.residueField x ⟶ CommRingCat.of L)),
        ((AlgebraicGeometry.Scheme.SpecToEquivOfField L Z.left).symm xf ≫ Z.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L))) ↔
        (ι_Z xf.1 ≫ xf.2 = CommRingCat.ofHom (algebraMap K L)) := by
      intro L _ _ xf
      rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply, Category.assoc,
        ← hι_Z xf.1, ← AlgebraicGeometry.Spec.map_comp]
      exact AlgebraicGeometry.Spec.map_injective.eq_iff
    let mkEquiv : ∀ (L : Type u) [Field L] [Algebra K L],
        (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap K L))) ⟶ Z) ≃
        (Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) L _ _ _ (algRes x) _) :=
      fun L _ _ =>
        let sL := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L))
        let e₁ : (CategoryTheory.Over.mk sL ⟶ Z) ≃
            { h : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Z.left // h ≫ Z.hom = sL } :=
          { toFun := fun h => ⟨h.left, CategoryTheory.Over.w h⟩
            invFun := fun h => CategoryTheory.Over.homMk h.1 h.2
            left_inv := fun _ => by ext1; rfl
            right_inv := fun _ => by ext1; rfl }
        let e₀ := AlgebraicGeometry.Scheme.SpecToEquivOfField L Z.left
        let e₂ : { h : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Z.left // h ≫ Z.hom = sL } ≃
            { xf : (x : ↥Z.left) × (Z.left.residueField x ⟶ CommRingCat.of L) //
              ι_Z xf.1 ≫ xf.2 = CommRingCat.ofHom (algebraMap K L) } :=
          { toFun := fun h =>
              ⟨e₀ h.1, (he₀_cond L (e₀ h.1)).mp (by rw [e₀.symm_apply_apply]; exact h.2)⟩
            invFun := fun xf => ⟨e₀.symm xf.1, (he₀_cond L xf.1).mpr xf.2⟩
            left_inv := fun h => Subtype.ext (e₀.symm_apply_apply h.1)
            right_inv := fun xf => Subtype.ext (e₀.apply_symm_apply xf.1) }
        let e₃ : { xf : (x : ↥Z.left) × (Z.left.residueField x ⟶ CommRingCat.of L) //
              ι_Z xf.1 ≫ xf.2 = CommRingCat.ofHom (algebraMap K L) } ≃
            (Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) L _ _ _ (algRes x) _) :=
          { toFun := fun ⟨⟨x, f⟩, hf⟩ =>
              let _ : Algebra K ↥(Z.left.residueField x) := algRes x
              ⟨x, { f.hom with
                commutes' := fun r => CategoryTheory.ConcreteCategory.congr_hom hf r }⟩
            invFun := fun ⟨x, σ⟩ =>
              let _ : Algebra K ↥(Z.left.residueField x) := algRes x
              ⟨⟨x, CommRingCat.ofHom σ.toRingHom⟩, by ext r; exact σ.commutes r⟩
            left_inv := fun ⟨⟨x, f⟩, hf⟩ => by
              ext1
              refine Sigma.ext rfl (heq_of_eq ?_)
              ext a
              rfl
            right_inv := fun ⟨x, σ⟩ => by
              refine Sigma.ext rfl (heq_of_eq ?_)
              let _ : Algebra K ↥(Z.left.residueField x) := algRes x
              ext a
              rfl }
        (e₁.trans e₂).trans e₃
    refine ⟨mkEquiv, fun L _ _ x σ => ?_⟩
    let _ : Algebra K ↥(Z.left.residueField x) := algRes x
    change (AlgebraicGeometry.Scheme.SpecToEquivOfField L Z.left).symm
      ⟨x, CommRingCat.ofHom σ.toRingHom⟩ = _
    rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply]
    rfl

  obtain ⟨equivOverSigma, h_symm_left⟩ := h_ex_equivOverSigma

  let e_over_sigma_fixed :
      { z : CategoryTheory.Over.mk f₂ ⟶ Z //
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_n.toRingHom) ≫ z.left = z.left } ≃
      { w : Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) Kbar _ _ _ (algRes x) _ //
        ∀ a : ↥(Z.left.residueField w.1), α_n (w.2 a) = w.2 a } :=
    Equiv.subtypeEquiv (equivOverSigma Kbar) fun z => by
      let w := equivOverSigma Kbar z
      let _ : Algebra K ↥(Z.left.residueField w.1) := algRes w.1
      let w' : Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) Kbar _ _ _ (algRes x) _ :=
        ⟨w.1, α_n.toAlgHom.comp w.2⟩
      have hz_symm : (equivOverSigma Kbar).symm ⟨w.1, w.2⟩ = z :=
        (equivOverSigma Kbar).symm_apply_apply z
      have hw'_left : ((equivOverSigma Kbar).symm w').left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_n.toRingHom) ≫ z.left := by
        calc ((equivOverSigma Kbar).symm w').left
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α_n.toAlgHom.comp w.2).toRingHom) ≫
              Z.left.fromSpecResidueField w.1 :=
              h_symm_left Kbar w.1 (α_n.toAlgHom.comp w.2)
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_n.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom w.2.toRingHom)) ≫
              Z.left.fromSpecResidueField w.1 := by
              rw [← AlgebraicGeometry.Spec.map_comp]
              rfl
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_n.toRingHom) ≫
              ((equivOverSigma Kbar).symm ⟨w.1, w.2⟩).left := by
              rw [Category.assoc, ← h_symm_left Kbar w.1 w.2]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_n.toRingHom) ≫ z.left := by
              rw [hz_symm]
      constructor
      · intro hz
        have h_over_eq : (equivOverSigma Kbar).symm w' =
            (equivOverSigma Kbar).symm ⟨w.1, w.2⟩ := by
          ext1
          rw [hw'_left, hz, hz_symm]
        have hw_eq : w' = ⟨w.1, w.2⟩ := (equivOverSigma Kbar).symm.injective h_over_eq
        have h_comp : α_n.toAlgHom.comp w.2 = w.2 :=
          eq_of_heq (Sigma.mk.inj_iff.mp hw_eq).2
        intro a
        exact AlgHom.congr_fun h_comp a
      · intro hw_fix
        have h_comp : α_n.toAlgHom.comp w.2 = w.2 := by
          ext a
          exact hw_fix a
        have hw_eq : w' = ⟨w.1, w.2⟩ := by
          dsimp only [w']
          rw [h_comp]
        rw [← hw'_left, hw_eq, hz_symm]

  let E_n : IntermediateField K Kbar :=
    IntermediateField.fixedField (Subgroup.zpowers α_n)

  have h_mem_En : ∀ c : Kbar, c ∈ E_n ↔ α_n c = c := by
    intro c
    rw [IntermediateField.mem_fixedField_iff]
    constructor
    · intro h
      exact h α_n (Subgroup.mem_zpowers α_n)
    · intro hc f hf
      rcases Subgroup.mem_zpowers_iff.mp hf with ⟨j, rfl⟩
      exact (MulAction.mem_fixedBy_zpowers_iff_mem_fixedBy (g := α_n) (a := c)).mpr hc j

  let e_sigma_En :
      { w : Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) Kbar _ _ _ (algRes x) _ //
        ∀ a : ↥(Z.left.residueField w.1), α_n (w.2 a) = w.2 a } ≃
      (Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) ↥E_n _ _ _ (algRes x) _) :=
    { toFun := fun ⟨⟨x, σ⟩, hσ⟩ =>
        let _ : Algebra K ↥(Z.left.residueField x) := algRes x
        ⟨x, {
          toFun := fun a => ⟨σ a, (h_mem_En (σ a)).mpr (hσ a)⟩
          map_one' := Subtype.ext (map_one σ)
          map_mul' := fun a b => Subtype.ext (map_mul σ a b)
          map_zero' := Subtype.ext (map_zero σ)
          map_add' := fun a b => Subtype.ext (map_add σ a b)
          commutes' := fun r => Subtype.ext (σ.commutes r)
        }⟩
      invFun := fun ⟨x, τ⟩ =>
        let _ : Algebra K ↥(Z.left.residueField x) := algRes x
        ⟨⟨x, E_n.val.comp τ⟩, fun a => (h_mem_En (τ a).1).mp (τ a).2⟩
      left_inv := fun ⟨⟨x, σ⟩, hσ⟩ => by
        ext1
        refine Sigma.ext rfl (heq_of_eq ?_)
        let _ : Algebra K ↥(Z.left.residueField x) := algRes x
        ext a
        rfl
      right_inv := fun ⟨x, τ⟩ => by
        refine Sigma.ext rfl (heq_of_eq ?_)
        let _ : Algebra K ↥(Z.left.residueField x) := algRes x
        ext a
        rfl }

  let q := Nat.card K
  let P_n : Polynomial K := Polynomial.X ^ (q ^ n) - Polynomial.X

  have hφ_apply : ∀ c : Kbar, φ c = c ^ q := by
    intro c
    have h1 := @FiniteField.coe_frobeniusAlgEquivOfAlgebraic K _ instFinK Kbar _ _ _
    have h2 : @Fintype.card K instFinK = q := (@Nat.card_eq_fintype_card K instFinK).symm
    rw [← h2]
    exact congrFun h1 c

  have hφ_pow : ∀ (m : ℕ) (c : Kbar), (φ ^ m) c = c ^ (q ^ m) := by
    intro m
    induction m with
    | zero =>
      intro c
      simp
    | succ m ih =>
      intro c
      rw [pow_succ' φ m, AlgEquiv.mul_apply, ih c, hφ_apply, ← pow_mul, ← pow_succ]

  have hq : 2 ≤ q := @Finite.one_lt_card K _ _
  have hqn : 2 ≤ q ^ n := by
    calc 2 ≤ q ^ 1 := by simp [hq]
    _ ≤ q ^ n := Nat.pow_le_pow_right (by omega) hn

  have hP_ne : P_n ≠ 0 := by
    intro h0
    have hc1 : Polynomial.coeff P_n 1 = 0 := by rw [h0, Polynomial.coeff_zero]
    have h1_ne : (1 : ℕ) ≠ q ^ n := by omega
    have hc2 : Polynomial.coeff P_n 1 = -1 := by
      dsimp only [P_n]
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_X_one]
      simp [h1_ne]
    rw [hc2] at hc1
    exact neg_ne_zero.mpr one_ne_zero hc1

  have hRootSet : P_n.rootSet Kbar = (E_n : Set Kbar) := by
    ext c
    rw [Polynomial.mem_rootSet_of_ne hP_ne, SetLike.mem_coe, h_mem_En c]
    change Polynomial.aeval c P_n = 0 ↔ (φ ^ n) c = c
    rw [hφ_pow n c]
    dsimp only [P_n]
    rw [map_sub, map_pow, Polynomial.aeval_X, sub_eq_zero]

  have hSplit : Polynomial.IsSplittingField K ↥E_n P_n := by
    have h_adj : IntermediateField.adjoin K (P_n.rootSet Kbar) = E_n := by
      rw [hRootSet]
      exact IntermediateField.adjoin_self K E_n
    rw [← h_adj]
    exact IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

  let _ : Polynomial.IsSplittingField K ↥E_n P_n := hSplit
  let τ_split : ↥E_n ≃ₐ[K] weilExtField K n := Polynomial.IsSplittingField.algEquiv ↥E_n P_n

  let e_En_ext :
      (Σ x : ↥Z.left, @AlgHom K ↥(Z.left.residueField x) ↥E_n _ _ _ (algRes x) _) ≃
      (Σ x : ↥Z.left,
        @AlgHom K ↥(Z.left.residueField x) (weilExtField K n) _ _ _ (algRes x) _) :=
    Equiv.sigmaCongrRight fun x =>
      let _ : Algebra K ↥(Z.left.residueField x) := algRes x
      { toFun := fun τ => τ_split.toAlgHom.comp τ
        invFun := fun ρ => τ_split.symm.toAlgHom.comp ρ
        left_inv := fun τ => by apply AlgHom.ext; intro a; exact τ_split.symm_apply_apply (τ a)
        right_inv := fun ρ => by apply AlgHom.ext; intro a; exact τ_split.apply_symm_apply (ρ a) }

  
  let e_total :=
    (((e_cl_F.trans e_F_over).trans e_over_sigma_fixed).trans e_sigma_En).trans
      (e_En_ext.trans (equivOverSigma (weilExtField K n)).symm)
  exact Nat.card_congr e_total

theorem weil_lefschetz_relFrob_fixed_point_etale (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Z.hom]
    (n : ℕ) (hn : 1 ≤ n) :
    let X := weilBaseChangeOver K (AlgebraicClosure K) Z
    let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
    ∃ (φ : Quiver.Hom X.left X.left)
      (hφ : CategoryTheory.CategoryStruct.comp φ X.hom = X.hom),
      WeilLefschetzIsRelFrobPow K Z n φ ∧
      ⇑φ.base = (⇑(weilGeomFrobHom K Z).base)^[n] ∧
      let Γ_φ := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.CategoryStruct.id X.left) φ
        ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)
      let W := CategoryTheory.Limits.pullback Δ Γ_φ
      AlgebraicGeometry.IsFinite
        (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst Δ Γ_φ) X.hom) ∧
      AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst Δ Γ_φ) X.hom) ∧
      Nat.card ↥W = Nat.card { x : ↥(weilGeomScheme K Z) //
        IsClosed ({x} : Set ↥(weilGeomScheme K Z)) ∧
        (⇑(weilGeomFrobHom K Z).base)^[n] x = x } :=
by
  
  
  
  letI instFinK : Fintype K := Fintype.ofFinite K
  let k : Type u := AlgebraicClosure K
  let q : ℕ := Nat.card K
  have hcard_q : Fintype.card K = q := (Nat.card_eq_fintype_card).symm
  have hq_ge2 : 2 ≤ q := Finite.one_lt_card
  let Q : ℕ := q ^ n
  have hQ_ge2 : 2 ≤ Q := le_trans hq_ge2 (Nat.le_self_pow (by omega : n ≠ 0) q)
  have hQ_ne0 : Q ≠ 0 := by omega

  have h_frob_pow : ∀ {R : Type u} [CommRing R] [Algebra K R] (m : ℕ) (r : R),
      (((FiniteField.frobeniusAlgHom K R) ^ m) r) = r ^ (q ^ m) := by
    intro R _ _ m
    induction m with
    | zero =>
      intro r
      simp
    | succ m ih =>
      intro r
      rw [pow_succ, AlgHom.mul_apply, ih, FiniteField.frobeniusAlgHom_apply, hcard_q,
        ← pow_mul, ← pow_succ']

  have h_K_pow : ∀ (m : ℕ) (c : K), c ^ (q ^ m) = c := by
    intro m
    induction m with
    | zero =>
      intro c
      simp
    | succ m ih =>
      intro c
      have hc : c ^ q = c := by
        rw [← hcard_q]
        exact FiniteField.pow_card c
      rw [pow_succ', pow_mul, hc, ih]
  have h_K_Q : ∀ c : K, c ^ Q = c := h_K_pow n

  let φ_arith : k ≃ₐ[K] k :=
    @FiniteField.frobeniusAlgEquivOfAlgebraic K _ instFinK k _ _ _
  let ψ : k ≃ₐ[K] k := φ_arith.symm

  have h_arith_pow : ∀ (m : ℕ) (c : k), (φ_arith ^ m) c = c ^ (q ^ m) := by
    intro m
    induction m with
    | zero =>
      intro c
      simp
    | succ m ih =>
      intro c
      rw [pow_succ, AlgEquiv.mul_apply, ih,
        FiniteField.frobeniusAlgEquivOfAlgebraic_apply, hcard_q, ← pow_mul, ← pow_succ']

  have h_arith_ψ : ∀ (m : ℕ) (c : k), (φ_arith ^ m) ((ψ ^ m) c) = c := by
    intro m
    induction m with
    | zero =>
      intro c
      rfl
    | succ m ih =>
      intro c
      rw [pow_succ, pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply]
      have hc : φ_arith (ψ ((ψ ^ m) c)) = (ψ ^ m) c := φ_arith.apply_symm_apply _
      rw [hc, ih]

  have h_ψ_Q : ∀ c : k, ((ψ ^ n) c) ^ Q = c := by
    intro c
    rw [← h_arith_pow n]
    exact h_arith_ψ n c

  
  
  
  let toSpecHom : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}},
      (T ⟶ Spec R) → (R ⟶ Γ(T, ⊤)) :=
    fun {T} {R} g => ((ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm g).unop

  have toSpecHom_inj : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}} {g₁ g₂ : T ⟶ Spec R},
      toSpecHom g₁ = toSpecHom g₂ → g₁ = g₂ := by
    intro T R g₁ g₂ h
    apply (ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm.injective
    exact Quiver.Hom.unop_inj h

  have toSpecHom_comp_left : ∀ {T' T : Scheme.{u}} {R : CommRingCat.{u}}
      (h : T' ⟶ T) (g : T ⟶ Spec R),
      toSpecHom (h ≫ g) = toSpecHom g ≫ h.appTop :=
    fun h g => congrArg Quiver.Hom.unop (ΓSpec.adjunction.homEquiv_naturality_left_symm h g)

  have toSpecHom_comp_right : ∀ {T : Scheme.{u}} {R R' : CommRingCat.{u}}
      (g : T ⟶ Spec R) (α : R' ⟶ R),
      toSpecHom (g ≫ Spec.map α) = α ≫ toSpecHom g :=
    fun g α => congrArg Quiver.Hom.unop (ΓSpec.adjunction.homEquiv_naturality_right_symm g α.op)

  let fromSpecHom : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}},
      (R ⟶ Γ(T, ⊤)) → (T ⟶ Spec R) :=
    fun {T} {R} α => (ΓSpec.adjunction.homEquiv T (Opposite.op R)) (Opposite.op α)

  have toSpecHom_fromSpecHom : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}} (α : R ⟶ Γ(T, ⊤)),
      toSpecHom (fromSpecHom α) = α :=
    fun {T} {R} α => congrArg Quiver.Hom.unop
      ((ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm_apply_apply (Opposite.op α))

  let frOfHom : ∀ (Y : Scheme.{u}), (Y ⟶ Spec (CommRingCat.of K)) → (Y ⟶ Y) :=
    fun Y hY =>
      let algU (U : Y.Opens) : Algebra K ↑(Y.presheaf.obj (Opposite.op U)) :=
        (toSpecHom hY ≫ Y.presheaf.map (homOfLE le_top).op).hom.toAlgebra
      let σU (U : Y.Opens) :
          ↑(Y.presheaf.obj (Opposite.op U)) →+* ↑(Y.presheaf.obj (Opposite.op U)) :=
        letI : Algebra K ↑(Y.presheaf.obj (Opposite.op U)) := algU U
        ((FiniteField.frobeniusAlgHom K ↑(Y.presheaf.obj (Opposite.op U))) ^ n).toRingHom
      let cY : Y.presheaf ⟶
          (TopCat.Presheaf.pushforward CommRingCat.{u} (𝟙 Y.toTopCat)).obj Y.presheaf :=
        { app := fun U => CommRingCat.ofHom (σU U.unop)
          naturality := fun U V i => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro s
            change σU V.unop ((Y.presheaf.map i).hom s) = (Y.presheaf.map i).hom (σU U.unop s)
            have h₁ : σU U.unop s = s ^ Q := by
              letI : Algebra K ↑(Y.presheaf.obj (Opposite.op U.unop)) := algU U.unop
              exact h_frob_pow n s
            have h₂ : σU V.unop ((Y.presheaf.map i).hom s) = ((Y.presheaf.map i).hom s) ^ Q := by
              letI : Algebra K ↑(Y.presheaf.obj (Opposite.op V.unop)) := algU V.unop
              exact h_frob_pow n _
            rw [h₁, h₂, map_pow] }
      let pHom : Y.toPresheafedSpace ⟶ Y.toPresheafedSpace :=
        PresheafedSpace.Hom.mk (𝟙 Y.toTopCat) cY
      Scheme.Hom.mk (LocallyRingedSpace.Hom.mk pHom (fun y =>
        ⟨fun {t} ht => by
          obtain ⟨U, hy, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq Y.presheaf (x := y) t
          have hst : (pHom.stalkMap y).hom ((Y.presheaf.germ U y hy).hom s) =
              (Y.presheaf.germ U y hy).hom (σU U s) :=
            PresheafedSpace.stalkMap_germ_apply pHom U y hy s
          have hσ : σU U s = s ^ Q := by
            letI : Algebra K ↑(Y.presheaf.obj (Opposite.op U)) := algU U
            exact h_frob_pow n s
          rw [hst, hσ, map_pow] at ht
          exact (isUnit_pow_iff hQ_ne0).mp ht⟩))

  have h_fr_base : ∀ (Y : Scheme.{u}) (hY : Y ⟶ Spec (CommRingCat.of K)),
      (frOfHom Y hY).base = 𝟙 Y.toTopCat :=
    fun _ _ => rfl

  have h_fr_app : ∀ (Y : Scheme.{u}) (hY : Y ⟶ Spec (CommRingCat.of K))
      (U : Y.Opens) (s : ↑(Y.presheaf.obj (Opposite.op U))),
      ((frOfHom Y hY).app U).hom s = s ^ Q := by
    intro Y hY U s
    letI : Algebra K ↑(Y.presheaf.obj (Opposite.op U)) :=
      (toSpecHom hY ≫ Y.presheaf.map (homOfLE le_top).op).hom.toAlgebra
    exact h_frob_pow n s

  have h_fr_nat : ∀ {Y₁ Y₂ : Scheme.{u}} (h₁ : Y₁ ⟶ Spec (CommRingCat.of K))
      (h₂ : Y₂ ⟶ Spec (CommRingCat.of K)) (f : Y₁ ⟶ Y₂),
      frOfHom Y₁ h₁ ≫ f = f ≫ frOfHom Y₂ h₂ := by
    intro Y₁ Y₂ h₁ h₂ f
    have hbase_eq : (frOfHom Y₁ h₁ ≫ f).base = (f ≫ frOfHom Y₂ h₂).base := by
      ext x
      rfl
    refine Scheme.Hom.ext hbase_eq (fun U => ?_)
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro s
    have hL : (Scheme.Hom.app (frOfHom Y₁ h₁ ≫ f) U ≫
        Y₁.presheaf.map (eqToHom rfl).op).hom s =
        ((f.app U).hom s) ^ Q := by
      rw [CategoryTheory.eqToHom_refl, op_id, CategoryTheory.Functor.map_id,
        Category.comp_id, Scheme.Hom.comp_app]
      exact h_fr_app Y₁ h₁ (f ⁻¹ᵁ U) ((f.app U).hom s)
    have hR : (Scheme.Hom.app (f ≫ frOfHom Y₂ h₂) U).hom s =
        (f.app U).hom (s ^ Q) := by
      rw [Scheme.Hom.comp_app]
      change (f.app U).hom (((frOfHom Y₂ h₂).app U).hom s) = _
      rw [h_fr_app]
    exact (hL.trans (map_pow (f.app U).hom s Q).symm).trans hR.symm

  have h_fr_spec : ∀ (A : Type u) [CommRing A] [Algebra K A],
      let gA := Spec.map (CommRingCat.ofHom (algebraMap K A))
      frOfHom (Spec (CommRingCat.of A)) gA =
        Spec.map (CommRingCat.ofHom (((FiniteField.frobeniusAlgHom K A) ^ n).toRingHom)) := by
    intro A _ _ gA
    apply toSpecHom_inj
    have h₁ : toSpecHom (frOfHom (Spec (CommRingCat.of A)) gA) =
        toSpecHom (frOfHom (Spec (CommRingCat.of A)) gA ≫ 𝟙 _) := by rw [Category.comp_id]
    have h₂ : toSpecHom (Spec.map (CommRingCat.ofHom (((FiniteField.frobeniusAlgHom K A) ^ n).toRingHom))) =
        toSpecHom (𝟙 _ ≫ Spec.map (CommRingCat.ofHom (((FiniteField.frobeniusAlgHom K A) ^ n).toRingHom))) := by
      rw [Category.id_comp]
    rw [h₁, toSpecHom_comp_left, h₂, toSpecHom_comp_right]
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    change (((frOfHom (Spec (CommRingCat.of A)) gA).app ⊤).hom ((toSpecHom (𝟙 _)).hom a)) =
      (toSpecHom (𝟙 _)).hom ((((FiniteField.frobeniusAlgHom K A) ^ n) a))
    rw [h_fr_app, h_frob_pow n a, map_pow]

  
  
  
  let f₂ : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K k))
  let S : Scheme.{u} := Limits.pullback Z.hom f₂
  let fst : S ⟶ Z.left := Limits.pullback.fst Z.hom f₂
  let p : S ⟶ Spec (CommRingCat.of k) := Limits.pullback.snd Z.hom f₂

  let frZ : Z.left ⟶ Z.left := frOfHom Z.left Z.hom

  have h_frZ_hom : frZ ≫ Z.hom = Z.hom := by
    apply toSpecHom_inj
    rw [toSpecHom_comp_left]
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    change ((frZ.app ⊤).hom ((toSpecHom Z.hom).hom c)) = (toSpecHom Z.hom).hom c
    rw [h_fr_app, ← map_pow, h_K_Q c]

  let φ : S ⟶ S :=
    Limits.pullback.map Z.hom f₂ Z.hom f₂ frZ (𝟙 (Spec (CommRingCat.of k)))
      (𝟙 (Spec (CommRingCat.of K)))
      (by rw [Category.comp_id, h_frZ_hom])
      (by rw [Category.comp_id, Category.id_comp])

  have hφ : φ ≫ p = p :=
    (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)

  have hφ_fst : φ ≫ fst = fst ≫ frZ :=
    Limits.pullback.lift_fst _ _ _

  have hφ_fst_base : (φ ≫ fst).base = fst.base := by
    rw [hφ_fst]
    ext x
    rfl

  have hφ_rel : WeilLefschetzIsRelFrobPow K Z n φ := by
    change φ ≫ p = p ∧
      (φ ≫ fst).base = fst.base ∧
      ∀ (U₀ : Z.left.Opens),
        ∃ (hU : fst ⁻¹ᵁ U₀ ≤ (φ ≫ fst) ⁻¹ᵁ U₀),
          ∀ a₀ : ↑(Z.left.presheaf.obj (Opposite.op U₀)),
            ((φ ≫ fst).appLE U₀ (fst ⁻¹ᵁ U₀) hU).hom a₀ =
              ((fst.app U₀).hom a₀) ^ Q
    refine ⟨hφ, hφ_fst_base, fun U₀ => ?_⟩
    rw [hφ_fst]
    have hU : fst ⁻¹ᵁ U₀ ≤ (fst ≫ frZ) ⁻¹ᵁ U₀ := le_rfl
    refine ⟨hU, fun a₀ => ?_⟩
    rw [Scheme.Hom.comp_appLE]
    have h_appLE_fst : fst.appLE (frZ ⁻¹ᵁ U₀) (fst ⁻¹ᵁ U₀) hU = fst.app U₀ := by
      change fst.appLE U₀ (fst ⁻¹ᵁ U₀) hU = fst.app U₀
      exact Scheme.Hom.appLE_eq_app fst
    rw [h_appLE_fst]
    change (fst.app U₀).hom ((frZ.app U₀).hom a₀) = ((fst.app U₀).hom a₀) ^ Q
    rw [h_fr_app, map_pow]

  let g : S ⟶ S := weilGeomFrobHom K Z
  let i₂ : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of k) :=
    Spec.map (CommRingCat.ofHom ψ.toRingHom)

  have hg_fst : g ≫ fst = fst :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)

  have hg_snd : g ≫ p = p ≫ i₂ :=
    Limits.pullback.lift_snd _ _ _

  let gPow : ℕ → (S ⟶ S) := fun m => Nat.rec (𝟙 S) (fun _ acc => acc ≫ g) m

  have hgPow_base : ∀ m : ℕ, ⇑(gPow m).base = (⇑g.base)^[m] := by
    intro m
    induction m with
    | zero =>
      ext x
      rfl
    | succ m ih =>
      ext x
      change g.base ((gPow m).base x) = (⇑g.base)^[m + 1] x
      rw [Function.iterate_succ_apply', ← ih]

  have hgPow_fst : ∀ m : ℕ, gPow m ≫ fst = fst := by
    intro m
    induction m with
    | zero => exact Category.id_comp fst
    | succ m ih =>
      change (gPow m ≫ g) ≫ fst = fst
      rw [Category.assoc, hg_fst, ih]

  have hgPow_snd : ∀ m : ℕ,
      gPow m ≫ p = p ≫ Spec.map (CommRingCat.ofHom (ψ ^ m).toRingHom) := by
    intro m
    induction m with
    | zero =>
      change 𝟙 S ≫ p = p ≫ Spec.map (CommRingCat.ofHom (ψ ^ 0).toRingHom)
      have h0 : CommRingCat.ofHom (ψ ^ 0).toRingHom = 𝟙 (CommRingCat.of k) :=
        CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
      rw [Category.id_comp, h0, Spec.map_id, Category.comp_id]
    | succ m ih =>
      change (gPow m ≫ g) ≫ p = p ≫ Spec.map (CommRingCat.ofHom (ψ ^ (m + 1)).toRingHom)
      rw [Category.assoc, hg_snd, ← Category.assoc (gPow m) p i₂, ih, Category.assoc]
      congr 1
      rw [← Spec.map_comp]
      rfl

  let frS : S ⟶ S := frOfHom S (fst ≫ Z.hom)

  have hφ_eq_fact : φ = frS ≫ gPow n := by
    apply Limits.pullback.hom_ext
    · change φ ≫ fst = (frS ≫ gPow n) ≫ fst
      rw [hφ_fst, Category.assoc, hgPow_fst n]
      exact (h_fr_nat (fst ≫ Z.hom) Z.hom fst).symm
    · change φ ≫ p = (frS ≫ gPow n) ≫ p
      rw [hφ, Category.assoc, hgPow_snd n]
      symm
      apply toSpecHom_inj
      rw [← Category.assoc frS p _, toSpecHom_comp_right, toSpecHom_comp_left]
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change ((frS.app ⊤).hom ((toSpecHom p).hom ((ψ ^ n) c))) = (toSpecHom p).hom c
      rw [h_fr_app, ← map_pow, h_ψ_Q c]

  have hφ_base : ⇑φ.base = (⇑g.base)^[n] := by
    rw [hφ_eq_fact]
    change (fun x => (gPow n).base (frS.base x)) = (⇑g.base)^[n]
    rw [← hgPow_base n]
    rfl

  
  
  
  have _ : LocallyOfFiniteType Z.hom := IsProper.toLocallyOfFiniteType
  have _ : IsProper p :=
    MorphismProperty.of_isPullback (P := @IsProper)
      (IsPullback.of_hasPullback Z.hom f₂) (inferInstance : IsProper Z.hom)
  have _ : LocallyOfFiniteType p := IsProper.toLocallyOfFiniteType
  have _ : IsSeparated p := IsProper.toIsSeparated

  let I : Type u := ↥Z.left.affineOpens
  let R₀ : I → CommRingCat.{u} := fun i => Z.left.presheaf.obj (Opposite.op i.1)
  let A₀ : I → Type u := fun i => ↥(R₀ i)
  let u₀ : ∀ i : I, Spec (R₀ i) ⟶ Z.left :=
    fun i => (show IsAffineOpen i.1 from i.2).isoSpec.inv ≫ i.1.ι
  have _ : ∀ i : I, IsOpenImmersion (u₀ i) := fun i => by
    dsimp only [u₀]
    infer_instance

  obtain ⟨ρ₀, hρ₀⟩ : ∃ ρ₀ : ∀ i : I, CommRingCat.of K ⟶ R₀ i,
      ∀ i : I, Spec.map (ρ₀ i) = u₀ i ≫ Z.hom :=
    ⟨fun i => (Spec.fullyFaithful.preimage (u₀ i ≫ Z.hom)).unop,
     fun _ => Spec.fullyFaithful.map_preimage _⟩

  letI instAlgA₀ : ∀ i : I, Algebra K (A₀ i) := fun i => (ρ₀ i).hom.toAlgebra

  have hFT_A₀ : ∀ i : I, Algebra.FiniteType K (A₀ i) := by
    intro i
    have hlft : LocallyOfFiniteType (u₀ i ≫ Z.hom) := inferInstance
    rw [← hρ₀ i] at hlft
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft

  have hu₀_cov : ∀ z : ↥Z.left, ∃ (i : I) (y : ↥(Spec (R₀ i))), (u₀ i).base y = z := by
    intro z
    obtain ⟨U₀, hU₀, hzU₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := Z.left) (x := z) (U := ⊤) trivial
    let i : I := ⟨U₀, hU₀⟩
    refine ⟨i, hU₀.isoSpec.hom.base ⟨z, hzU₀⟩, ?_⟩
    change (hU₀.isoSpec.hom ≫ hU₀.isoSpec.inv ≫ U₀.ι).base ⟨z, hzU₀⟩ = z
    rw [Iso.hom_inv_id_assoc]
    rfl

  let 𝒰₀ : Z.left.OpenCover :=
    Scheme.Cover.mkOfCovers I (fun i => Spec (R₀ i)) u₀ hu₀_cov
  let 𝒰_S : S.OpenCover := Scheme.Pullback.openCoverOfLeft 𝒰₀ Z.hom f₂

  let A : I → Type u := fun i => TensorProduct K k (A₀ i)
  let F_Q : ∀ i : I, A₀ i →ₐ[K] A₀ i := fun i => (FiniteField.frobeniusAlgHom K (A₀ i)) ^ n
  let φ_A : ∀ i : I, A i →ₐ[k] A i :=
    fun i => Algebra.TensorProduct.map (AlgHom.id k k) (F_Q i)
  let c_equiv : ∀ i : I, TensorProduct K (A₀ i) k ≃ₐ[K] A i :=
    fun i => Algebra.TensorProduct.comm K (A₀ i) k

  let g₀ : ∀ i : I, Spec (CommRingCat.of (A₀ i)) ⟶ Spec (CommRingCat.of K) :=
    fun i => Spec.map (CommRingCat.ofHom (algebraMap K (A₀ i)))

  have hg₀_eq : ∀ i : I, g₀ i = u₀ i ≫ Z.hom := by
    intro i
    rw [← hρ₀ i]
    rfl

  let m₀ : ∀ i : I, Limits.pullback (g₀ i) f₂ ⟶ S :=
    fun i => Limits.pullback.map (g₀ i) f₂ Z.hom f₂ (u₀ i) (𝟙 _) (𝟙 _)
      (by rw [Category.comp_id, hg₀_eq i])
      (by rw [Category.comp_id, Category.id_comp])

  have _ : ∀ i : I, IsOpenImmersion (m₀ i) :=
    fun i => Scheme.pullback_map_isOpenImmersion (g₀ i) f₂ Z.hom f₂ (u₀ i) (𝟙 _) (𝟙 _) _ _

  let c_spec : ∀ i : I,
      Spec (CommRingCat.of (A i)) ⟶ Spec (CommRingCat.of (TensorProduct K (A₀ i) k)) :=
    fun i => Spec.map (CommRingCat.ofHom (c_equiv i).toRingHom)

  have _ : ∀ i : I, IsIso (c_spec i) := by
    intro i
    refine ⟨⟨Spec.map (CommRingCat.ofHom (c_equiv i).symm.toRingHom), ?_, ?_⟩⟩
    · rw [← Spec.map_comp]
      have hid : CommRingCat.ofHom (c_equiv i).symm.toRingHom ≫
          CommRingCat.ofHom (c_equiv i).toRingHom = 𝟙 _ :=
        CommRingCat.hom_ext (RingHom.ext fun t => (c_equiv i).apply_symm_apply t)
      rw [hid, Spec.map_id]
    · rw [← Spec.map_comp]
      have hid : CommRingCat.ofHom (c_equiv i).toRingHom ≫
          CommRingCat.ofHom (c_equiv i).symm.toRingHom = 𝟙 _ :=
        CommRingCat.hom_ext (RingHom.ext fun t => (c_equiv i).symm_apply_apply t)
      rw [hid, Spec.map_id]

  let u : ∀ i : I, Spec (CommRingCat.of (A i)) ⟶ S :=
    fun i => c_spec i ≫ (pullbackSpecIso K (A₀ i) k).inv ≫ m₀ i

  have _ : ∀ i : I, IsOpenImmersion (u i) := fun i => inferInstance

  have hu_cov : ∀ x : ↥S, ∃ (i : I) (y : ↥(Spec (CommRingCat.of (A i)))), (u i).base y = x := by
    intro x
    let j := 𝒰_S.idx x
    let i : I := j
    obtain ⟨z₀, hz₀⟩ := 𝒰_S.covers x
    let map_raw : Limits.pullback (u₀ i ≫ Z.hom) f₂ ⟶ S :=
      Limits.pullback.map (u₀ i ≫ Z.hom) f₂ Z.hom f₂ (u₀ i) (𝟙 _) (𝟙 _)
        (Category.comp_id _) ((Category.comp_id f₂).trans (Category.id_comp f₂).symm)
    let e_pb : Limits.pullback (u₀ i ≫ Z.hom) f₂ ⟶ Limits.pullback (g₀ i) f₂ :=
      Limits.pullback.map (u₀ i ≫ Z.hom) f₂ (g₀ i) f₂ (𝟙 _) (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, Category.id_comp, hg₀_eq i])
        (by rw [Category.comp_id, Category.id_comp])
    have he_raw : e_pb ≫ m₀ i = map_raw := by
      apply Limits.pullback.hom_ext
      · calc
          (e_pb ≫ m₀ i) ≫ Limits.pullback.fst Z.hom f₂ =
              e_pb ≫ (m₀ i ≫ Limits.pullback.fst Z.hom f₂) := Category.assoc _ _ _
          _ = e_pb ≫ (Limits.pullback.fst (g₀ i) f₂ ≫ u₀ i) := by rw [Limits.pullback.lift_fst]
          _ = (e_pb ≫ Limits.pullback.fst (g₀ i) f₂) ≫ u₀ i := (Category.assoc _ _ _).symm
          _ = Limits.pullback.fst (u₀ i ≫ Z.hom) f₂ ≫ u₀ i := by
            rw [Limits.pullback.lift_fst, Category.comp_id]
          _ = map_raw ≫ Limits.pullback.fst Z.hom f₂ := by
            dsimp only [map_raw]
            rw [Limits.pullback.lift_fst]
      · calc
          (e_pb ≫ m₀ i) ≫ Limits.pullback.snd Z.hom f₂ =
              e_pb ≫ (m₀ i ≫ Limits.pullback.snd Z.hom f₂) := Category.assoc _ _ _
          _ = e_pb ≫ Limits.pullback.snd (g₀ i) f₂ := by
            rw [Limits.pullback.lift_snd, Category.comp_id]
          _ = Limits.pullback.snd (u₀ i ≫ Z.hom) f₂ := by
            rw [Limits.pullback.lift_snd, Category.comp_id]
          _ = map_raw ≫ Limits.pullback.snd Z.hom f₂ := by
            dsimp only [map_raw]
            rw [Limits.pullback.lift_snd, Category.comp_id]
    have hj_eq : 𝒰_S.f j = map_raw :=
      Scheme.Pullback.openCoverOfLeft_f 𝒰₀ Z.hom f₂ j
    let z₀' : ↥(Limits.pullback (u₀ i ≫ Z.hom) f₂) := z₀
    let z₁ : ↥(Limits.pullback (g₀ i) f₂) := e_pb.base z₀'
    have hz₁ : (m₀ i).base z₁ = x := by
      have h1 : (m₀ i).base z₁ = map_raw.base z₀' := by
        rw [← he_raw]
        rfl
      have h2 : map_raw.base z₀' = (𝒰_S.f j).base z₀ := by
        rw [← hj_eq]
        rfl
      rw [h1, h2]
      exact hz₀
    let iso_front : Spec (CommRingCat.of (A i)) ≅ Limits.pullback (g₀ i) f₂ :=
      asIso (c_spec i) ≪≫ (pullbackSpecIso K (A₀ i) k).symm
    refine ⟨i, iso_front.inv.base z₁, ?_⟩
    change (iso_front.inv ≫ iso_front.hom ≫ m₀ i).base z₁ = x
    rw [Iso.inv_hom_id_assoc]
    exact hz₁

  have hu_p : ∀ i : I,
      u i ≫ p = Spec.map (CommRingCat.ofHom (algebraMap k (A i))) := by
    intro i
    dsimp only [u, c_spec]
    rw [Category.assoc, Category.assoc]
    have hm_p : m₀ i ≫ p = Limits.pullback.snd (g₀ i) f₂ :=
      (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
    rw [hm_p, pullbackSpecIso_inv_snd K (A₀ i) k, ← Spec.map_comp]
    rfl

  have hu_fst : ∀ i : I,
      u i ≫ fst =
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫ u₀ i := by
    intro i
    dsimp only [u, c_spec]
    rw [Category.assoc, Category.assoc]
    have hm_fst : m₀ i ≫ fst = Limits.pullback.fst (g₀ i) f₂ ≫ u₀ i :=
      Limits.pullback.lift_fst _ _ _
    rw [hm_fst, ← Category.assoc (pullbackSpecIso K (A₀ i) k).inv,
      pullbackSpecIso_inv_fst K (A₀ i) k, ← Category.assoc, ← Spec.map_comp]
    rfl

  have hu_φ : ∀ i : I,
      u i ≫ φ = Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) ≫ u i := by
    intro i
    apply Limits.pullback.hom_ext
    · change (u i ≫ φ) ≫ fst = (Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) ≫ u i) ≫ fst
      calc
        (u i ≫ φ) ≫ fst = u i ≫ (φ ≫ fst) := Category.assoc _ _ _
        _ = u i ≫ (fst ≫ frZ) := by rw [hφ_fst]
        _ = (u i ≫ fst) ≫ frZ := (Category.assoc _ _ _).symm
        _ = (Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫ u₀ i) ≫ frZ := by
          rw [hu_fst i]
        _ = Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫ (u₀ i ≫ frZ) :=
          Category.assoc _ _ _
        _ = Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫
            (frOfHom (Spec (CommRingCat.of (A₀ i))) (g₀ i) ≫ u₀ i) := by
          rw [← h_fr_nat (g₀ i) Z.hom (u₀ i)]
        _ = (Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫
            Spec.map (CommRingCat.ofHom ((FiniteField.frobeniusAlgHom K (A₀ i) ^ n).toRingHom))) ≫ u₀ i := by
          rw [h_fr_spec (A₀ i), Category.assoc]
        _ = (Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) ≫
            Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)) ≫ u₀ i := by
          rw [← Spec.map_comp, ← Spec.map_comp]
          rfl
        _ = (Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) ≫ u i) ≫ fst := by
          rw [Category.assoc, ← hu_fst i,
            ← Category.assoc (Spec.map (CommRingCat.ofHom (φ_A i).toRingHom)) (u i) fst]
    · change (u i ≫ φ) ≫ p = (Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) ≫ u i) ≫ p
      rw [Category.assoc (u i) φ p, hφ, Category.assoc _ (u i) p, hu_p i, ← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      exact ((φ_A i).commutes c).symm

  
  let J : ∀ i : I, Ideal (A i) :=
    fun i => Ideal.span (Set.range (fun x : A i => x - φ_A i x))
  let B : I → Type u := fun i => A i ⧸ J i

  have hB_etale_art : ∀ i : I, Algebra.Etale k (B i) ∧ IsArtinianRing (B i) := by
    intro i
    letI : Algebra.FiniteType K (A₀ i) := hFT_A₀ i
    let I₀ : Ideal (A₀ i) := Ideal.span (Set.range (fun a₀ : A₀ i => a₀ - a₀ ^ Q))
    let B₀ : Type u := A₀ i ⧸ I₀
    let π₀ : A₀ i →ₐ[K] B₀ := Ideal.Quotient.mkₐ K I₀

    have hyQ : ∀ y : B₀, y ^ Q = y := by
      intro y
      obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hmem : a₀ - a₀ ^ Q ∈ I₀ := Ideal.subset_span ⟨a₀, rfl⟩
      have h0 : Ideal.Quotient.mk I₀ (a₀ - a₀ ^ Q) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_pow, sub_eq_zero] at h0
      exact h0.symm

    have _ : Algebra.FiniteType K B₀ :=
      Algebra.FiniteType.of_surjective π₀ Ideal.Quotient.mk_surjective
    have _ : Algebra.FinitePresentation K B₀ :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance

    have hP_monic : (Polynomial.X ^ Q - Polynomial.X : Polynomial K).Monic :=
      Polynomial.monic_X_pow_sub
        (lt_of_le_of_lt Polynomial.degree_X_le (by exact_mod_cast (show 1 < Q by omega)))
    have _ : Algebra.IsIntegral K B₀ :=
      ⟨fun y => ⟨Polynomial.X ^ Q - Polynomial.X, hP_monic, by
        simp [hyQ y]⟩⟩
    have _ : Module.Finite K B₀ := Algebra.IsIntegral.finite

    have _ : Algebra.FormallyEtale K B₀ := by
      rw [Algebra.FormallyEtale.iff_comp_bijective]
      intro R_test _ _ I_test hI_sq
      let πI : R_test →ₐ[K] R_test ⧸ I_test := Ideal.Quotient.mkₐ K I_test
      let σR : R_test →ₐ[K] R_test := (FiniteField.frobeniusAlgHom K R_test) ^ n
      have hσR_pow : ∀ b : R_test, σR b = b ^ Q := h_frob_pow n
      have hσR_kill : ∀ δ ∈ I_test, σR δ = 0 := by
        intro δ hδ
        rw [hσR_pow]
        have hδ2_mem : δ * δ ∈ I_test ^ 2 := by
          rw [sq]
          exact Submodule.mul_mem_mul hδ hδ
        rw [hI_sq, Submodule.mem_bot] at hδ2_mem
        have hQ_split : Q = 2 + (Q - 2) := by omega
        rw [hQ_split, pow_add, sq, hδ2_mem, zero_mul]
      constructor
      · intro g₁ g₂ hg
        ext y
        have hquot : πI (g₁ y - g₂ y) = 0 := by
          rw [map_sub, sub_eq_zero]
          exact AlgHom.congr_fun hg y
        have hmem : g₁ y - g₂ y ∈ I_test :=
          Ideal.Quotient.eq_zero_iff_mem.mp hquot
        have h0 := hσR_kill (g₁ y - g₂ y) hmem
        rw [map_sub, hσR_pow, hσR_pow, ← map_pow, ← map_pow, hyQ y, sub_eq_zero] at h0
        exact h0
      · intro f
        let σR_bar : (R_test ⧸ I_test) →ₐ[K] R_test :=
          Ideal.Quotient.liftₐ I_test σR hσR_kill
        refine ⟨σR_bar.comp f, ?_⟩
        ext y
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (f y)
        have hb' : πI b = f y := hb
        change πI (σR_bar (f y)) = f y
        rw [← hb']
        have hlift : σR_bar (πI b) = σR b := rfl
        rw [hlift, hσR_pow, map_pow, hb', ← map_pow, hyQ y]

    have _ : Algebra.Etale K B₀ := Algebra.Etale.mk
    have _ : Algebra.Etale k (TensorProduct K k B₀) := Algebra.Etale.baseChange K B₀ k
    have _ : Module.Finite k (TensorProduct K k B₀) := Module.Finite.base_change K k B₀

    let τ₀ : A₀ i →ₐ[K] B i :=
      (Ideal.Quotient.mkₐ K (J i)).comp Algebra.TensorProduct.includeRight
    have hτ₀_ker : ∀ a₀ ∈ I₀, τ₀ a₀ = 0 := by
      intro a₀ ha₀
      refine Submodule.span_induction ?_ ?_ ?_ ?_ ha₀
      · rintro _ ⟨x₀, rfl⟩
        change Ideal.Quotient.mk (J i) ((1 : k) ⊗ₜ[K] (x₀ - x₀ ^ Q)) = 0
        rw [TensorProduct.tmul_sub]
        have hφ_1 : φ_A i ((1 : k) ⊗ₜ[K] x₀) = (1 : k) ⊗ₜ[K] (x₀ ^ Q) := by
          change (1 : k) ⊗ₜ[K] (F_Q i x₀) = _
          rw [h_frob_pow n x₀]
        rw [← hφ_1]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨(1 : k) ⊗ₜ[K] x₀, rfl⟩)
      · exact map_zero τ₀
      · intro x y _ _ hx hy
        rw [map_add, hx, hy, add_zero]
      · intro r x _ hx
        rw [smul_eq_mul, map_mul, hx, mul_zero]

    let τ₀_bar : B₀ →ₐ[K] B i := Ideal.Quotient.liftₐ I₀ τ₀ hτ₀_ker
    let Ψ₂ : TensorProduct K k B₀ →ₐ[k] B i :=
      Algebra.TensorProduct.lift (Algebra.ofId k (B i)) τ₀_bar (fun _ _ => Commute.all _ _)

    let Ψ₁_tilde : A i →ₐ[k] TensorProduct K k B₀ :=
      Algebra.TensorProduct.map (AlgHom.id k k) π₀
    have hΨ₁_comp : Ψ₁_tilde.comp (φ_A i) = Ψ₁_tilde := by
      apply Algebra.TensorProduct.ext
      · ext
      · ext a₀
        change (1 : k) ⊗ₜ[K] π₀ (F_Q i a₀) = (1 : k) ⊗ₜ[K] π₀ a₀
        rw [h_frob_pow n a₀, map_pow, hyQ (π₀ a₀)]

    have hΨ₁_ker : ∀ z ∈ J i, Ψ₁_tilde z = 0 := by
      intro z hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨x, rfl⟩
        rw [map_sub, ← AlgHom.comp_apply, hΨ₁_comp, sub_self]
      · exact map_zero Ψ₁_tilde
      · intro x y _ _ hx hy
        rw [map_add, hx, hy, add_zero]
      · intro r x _ hx
        rw [smul_eq_mul, map_mul, hx, mul_zero]

    let Ψ₁ : B i →ₐ[k] TensorProduct K k B₀ := Ideal.Quotient.liftₐ (J i) Ψ₁_tilde hΨ₁_ker

    have hΨ₂₁_mk :
        (Ψ₂.comp Ψ₁).comp (Ideal.Quotient.mkₐ k (J i)) = Ideal.Quotient.mkₐ k (J i) := by
      apply Algebra.TensorProduct.ext
      · ext
      · ext a₀
        change Ψ₂ ((1 : k) ⊗ₜ[K] π₀ a₀) = Ideal.Quotient.mk (J i) ((1 : k) ⊗ₜ[K] a₀)
        dsimp only [Ψ₂]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl

    let e_alg : TensorProduct K k B₀ ≃ₐ[k] B i :=
      AlgEquiv.ofAlgHom Ψ₂ Ψ₁
        (by
          ext q
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
          exact AlgHom.congr_fun hΨ₂₁_mk x)
        (by
          apply Algebra.TensorProduct.ext
          · ext
          · ext b₀
            obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective b₀
            change Ψ₁ (Ψ₂ ((1 : k) ⊗ₜ[K] π₀ a₀)) = (1 : k) ⊗ₜ[K] π₀ a₀
            dsimp only [Ψ₂]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl)

    have het : Algebra.Etale k (B i) := Algebra.Etale.of_equiv e_alg
    have _ : Module.Finite k (B i) := Module.Finite.equiv e_alg.toLinearEquiv
    have hart : IsArtinianRing (B i) := IsArtinianRing.of_finite k (B i)
    exact ⟨het, hart⟩

  
  
  
  let Δ := Limits.pullback.diagonal p
  let Γ_φ := Limits.pullback.lift (𝟙 S) φ ((Category.id_comp p).trans hφ.symm)
  let W := Limits.pullback Δ Γ_φ
  let i_W : W ⟶ S := Limits.pullback.fst Δ Γ_φ
  let j_W : W ⟶ S := Limits.pullback.snd Δ Γ_φ

  have hW_cond : i_W ≫ Δ = j_W ≫ Γ_φ := Limits.pullback.condition

  have h_iW_eq_jW : i_W = j_W := by
    calc
      i_W = i_W ≫ (Δ ≫ Limits.pullback.fst p p) := by
        rw [Limits.pullback.diagonal_fst, Category.comp_id]
      _ = (i_W ≫ Δ) ≫ Limits.pullback.fst p p := (Category.assoc _ _ _).symm
      _ = (j_W ≫ Γ_φ) ≫ Limits.pullback.fst p p := by rw [hW_cond]
      _ = j_W ≫ (Γ_φ ≫ Limits.pullback.fst p p) := Category.assoc _ _ _
      _ = j_W := by rw [Limits.pullback.lift_fst, Category.comp_id]

  have h_iW_φ : i_W ≫ φ = i_W := by
    calc
      i_W ≫ φ = j_W ≫ (Γ_φ ≫ Limits.pullback.snd p p) := by
        rw [h_iW_eq_jW, Limits.pullback.lift_snd]
      _ = (j_W ≫ Γ_φ) ≫ Limits.pullback.snd p p := (Category.assoc _ _ _).symm
      _ = (i_W ≫ Δ) ≫ Limits.pullback.snd p p := by rw [← hW_cond]
      _ = i_W ≫ (Δ ≫ Limits.pullback.snd p p) := Category.assoc _ _ _
      _ = i_W := by rw [Limits.pullback.diagonal_snd, Category.comp_id]

  have h_iW_mono : Mono i_W :=
    ⟨fun {T} a b hab => Limits.pullback.hom_ext hab (by
      change a ≫ j_W = b ≫ j_W
      rwa [← h_iW_eq_jW])⟩

  obtain ⟨liftW, h_liftW_iW⟩ :
      ∃ liftW : ∀ {T : Scheme.{u}} (t : T ⟶ S), t ≫ φ = t → (T ⟶ W),
        ∀ {T : Scheme.{u}} (t : T ⟶ S) (ht : t ≫ φ = t), liftW t ht ≫ i_W = t :=
    ⟨fun {T} t ht =>
      Limits.pullback.lift t t
        (Limits.pullback.hom_ext
          (by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id,
                Category.assoc, Limits.pullback.lift_fst, Category.comp_id])
          (by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
                Category.assoc, Limits.pullback.lift_snd, ht])),
     fun t ht => Limits.pullback.lift_fst _ _ _⟩

  let π_quot : ∀ i : I, Spec (CommRingCat.of (B i)) ⟶ Spec (CommRingCat.of (A i)) :=
    fun i => Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (J i)))

  have _ : ∀ i : I, IsClosedImmersion (π_quot i) :=
    fun i => IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

  have hπ_φ : ∀ i : I,
      π_quot i ≫ Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) = π_quot i := by
    intro i
    dsimp only [π_quot]
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    change Ideal.Quotient.mk (J i) (φ_A i x) = Ideal.Quotient.mk (J i) x
    symm
    rw [Ideal.Quotient.eq]
    exact Ideal.subset_span ⟨x, rfl⟩

  have hπu_φ : ∀ i : I, (π_quot i ≫ u i) ≫ φ = π_quot i ≫ u i := by
    intro i
    rw [Category.assoc, hu_φ i, ← Category.assoc, hπ_φ i]

  obtain ⟨v, hv_iW⟩ :
      ∃ v : ∀ i : I, Spec (CommRingCat.of (B i)) ⟶ W,
        ∀ i : I, v i ≫ i_W = π_quot i ≫ u i :=
    ⟨fun i => liftW (π_quot i ≫ u i) (hπu_φ i),
     fun i => h_liftW_iW (π_quot i ≫ u i) (hπu_φ i)⟩

  have h_aff_eq : ∀ (i : I) {T : Scheme.{u}} (q_hom : T ⟶ Spec (CommRingCat.of (A i))),
      q_hom ≫ Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) = q_hom →
      ∃ β : T ⟶ Spec (CommRingCat.of (B i)), β ≫ π_quot i = q_hom := by
    intro i T q_hom hq
    let fq : A i →+* ↑Γ(T, ⊤) := (toSpecHom q_hom).hom
    have hfq_eq : CommRingCat.ofHom (φ_A i).toRingHom ≫ toSpecHom q_hom = toSpecHom q_hom := by
      rw [← toSpecHom_comp_right, hq]
    have hker : J i ≤ RingHom.ker fq := by
      rw [Ideal.span_le]
      rintro _ ⟨x, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, sub_eq_zero]
      exact (ConcreteCategory.congr_hom hfq_eq x).symm
    let lq : B i →+* ↑Γ(T, ⊤) := Ideal.Quotient.lift (J i) fq hker
    let β : T ⟶ Spec (CommRingCat.of (B i)) := fromSpecHom (CommRingCat.ofHom lq)
    refine ⟨β, ?_⟩
    apply toSpecHom_inj
    rw [toSpecHom_comp_right, toSpecHom_fromSpecHom]
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    rfl

  have hv_open_and_cov :
      (∀ i : I, IsOpenImmersion (v i)) ∧
      (∀ w : ↥W, ∃ (i : I) (z : ↥(Spec (CommRingCat.of (B i)))), (v i).base z = w) := by
    have h_iso : ∀ i : I,
        ∃ (α_i : Spec (CommRingCat.of (B i)) ⟶ Limits.pullback i_W (u i))
          (β_i : Limits.pullback i_W (u i) ⟶ Spec (CommRingCat.of (B i))),
          α_i ≫ Limits.pullback.fst i_W (u i) = v i ∧
          α_i ≫ β_i = 𝟙 _ ∧
          β_i ≫ α_i = 𝟙 _ := by
      intro i
      let W_i := Limits.pullback i_W (u i)
      let p_i : W_i ⟶ W := Limits.pullback.fst i_W (u i)
      let q_i : W_i ⟶ Spec (CommRingCat.of (A i)) := Limits.pullback.snd i_W (u i)
      let α_i : Spec (CommRingCat.of (B i)) ⟶ W_i :=
        Limits.pullback.lift (v i) (π_quot i) (hv_iW i)
      have hq_φ : q_i ≫ Spec.map (CommRingCat.ofHom (φ_A i).toRingHom) = q_i := by
        apply (cancel_mono (u i)).mp
        rw [Category.assoc, ← hu_φ i, ← Category.assoc, ← Limits.pullback.condition,
          Category.assoc, h_iW_φ, Limits.pullback.condition]
      obtain ⟨β_i, hβ_π⟩ := h_aff_eq i q_i hq_φ
      have hαβ : α_i ≫ β_i = 𝟙 _ := by
        have : Mono (π_quot i) :=
          ((IsClosedImmersion.iff_isFinite_and_mono (π_quot i)).mp inferInstance).2
        apply (cancel_mono (π_quot i)).mp
        rw [Category.assoc, hβ_π, Limits.pullback.lift_snd, Category.id_comp]
      have hβα : β_i ≫ α_i = 𝟙 _ := by
        apply Limits.pullback.hom_ext
        · apply (cancel_mono i_W).mp
          calc
            ((β_i ≫ α_i) ≫ Limits.pullback.fst i_W (u i)) ≫ i_W =
                β_i ≫ ((α_i ≫ Limits.pullback.fst i_W (u i)) ≫ i_W) := by
              simp only [Category.assoc]
            _ = β_i ≫ (v i ≫ i_W) := by rw [Limits.pullback.lift_fst]
            _ = (β_i ≫ π_quot i) ≫ u i := by rw [hv_iW i, Category.assoc]
            _ = q_i ≫ u i := by rw [hβ_π]
            _ = Limits.pullback.fst i_W (u i) ≫ i_W := Limits.pullback.condition.symm
            _ = (𝟙 W_i ≫ Limits.pullback.fst i_W (u i)) ≫ i_W := by rw [Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, hβ_π, Category.id_comp]
      exact ⟨α_i, β_i, Limits.pullback.lift_fst _ _ _, hαβ, hβα⟩
    refine ⟨fun i => ?_, fun w => ?_⟩
    · obtain ⟨α_i, β_i, hα_p, hαβ, hβα⟩ := h_iso i
      have : IsIso α_i := ⟨⟨β_i, hαβ, hβα⟩⟩
      rw [← hα_p]
      infer_instance
    · obtain ⟨i, y₀, hy₀⟩ := hu_cov (i_W.base w)
      obtain ⟨α_i, β_i, hα_p, _, hβα⟩ := h_iso i
      have hw_mem : w ∈ (Limits.pullback.fst i_W (u i)).opensRange := by
        rw [Scheme.Hom.opensRange_pullbackFst (u i) i_W]
        exact ⟨y₀, hy₀⟩
      rcases hw_mem with ⟨z₀, hz₀⟩
      refine ⟨i, β_i.base z₀, ?_⟩
      rw [← hα_p]
      change (β_i ≫ α_i ≫ Limits.pullback.fst i_W (u i)).base z₀ = w
      rw [← Category.assoc, hβα, Category.id_comp]
      exact hz₀

  have hv_open : ∀ i : I, IsOpenImmersion (v i) := hv_open_and_cov.1
  have hv_cov : ∀ w : ↥W, ∃ (i : I) (z : ↥(Spec (CommRingCat.of (B i)))), (v i).base z = w :=
    hv_open_and_cov.2

  have hW_disc : DiscreteTopology ↥W := by
    rw [discreteTopology_iff_isOpen_singleton]
    intro w
    obtain ⟨i, z, rfl⟩ := hv_cov w
    have : IsArtinianRing (B i) := (hB_etale_art i).2
    have hArt : IsArtinianScheme (Spec (CommRingCat.of (B i))) :=
      Scheme.isArtinianScheme_Spec.mpr inferInstance
    have : DiscreteTopology ↥(Spec (CommRingCat.of (B i))) :=
      (IsArtinianScheme.iff_isNoetherian_and_discreteTopology.mp hArt).2
    have hz_open : IsOpen ({z} : Set ↥(Spec (CommRingCat.of (B i)))) := isOpen_discrete {z}
    have himg : (v i).base '' ({z} : Set ↥(Spec (CommRingCat.of (B i)))) = {(v i).base z} :=
      Set.image_singleton
    rw [← himg]
    exact (v i).isOpenEmbedding.isOpenMap _ hz_open

  have : IsClosedImmersion Δ := by
    dsimp only [Δ]
    infer_instance
  have : IsClosedImmersion Γ_φ := by
    have hΓ_fst : Γ_φ ≫ Limits.pullback.fst p p = 𝟙 S := Limits.pullback.lift_fst _ _ _
    have : IsClosedImmersion (Γ_φ ≫ Limits.pullback.fst p p) := by
      rw [hΓ_fst]
      infer_instance
    exact IsClosedImmersion.of_comp Γ_φ (Limits.pullback.fst p p)
  have : IsClosedImmersion i_W := inferInstance
  have : IsProper i_W := inferInstance
  have : IsProper (i_W ≫ p) := inferInstance
  have : QuasiCompact (i_W ≫ p) := inferInstance
  have : CompactSpace ↥W := QuasiCompact.compactSpace_of_compactSpace (i_W ≫ p)
  have : Finite ↥W := finite_of_compact_of_discrete
  have : IsAffine W := inferInstance
  have : IsAffineHom (i_W ≫ p) := isAffineHom_of_isAffine (i_W ≫ p)

  have hW_fin : IsFinite (i_W ≫ p) :=
    IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩

  let 𝒰_W : W.OpenCover :=
    Scheme.Cover.mkOfCovers I (fun i => Spec (CommRingCat.of (B i))) v hv_cov

  have hW_et : Etale (i_W ≫ p) := by
    have : IsZariskiLocalAtSource (@Etale.{u}) :=
      HasRingHomProperty.instIsZariskiLocalAtSource (P := @Etale.{u})
    apply IsZariskiLocalAtSource.of_openCover 𝒰_W
    intro i
    change Etale (v i ≫ (i_W ≫ p))
    have hcomp_vi : v i ≫ (i_W ≫ p) = Spec.map (CommRingCat.ofHom (algebraMap k (B i))) := by
      rw [← Category.assoc, hv_iW i, Category.assoc, hu_p i, ← Spec.map_comp]
      rfl
    rw [hcomp_vi]
    have : Algebra.Etale k (B i) := (hB_etale_art i).1
    exact (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (RingHom.etale_algebraMap.mpr inferInstance)

  
  let pt₀ : ↥(Spec (CommRingCat.of k)) := default

  obtain ⟨ι_S, hι_S⟩ : ∃ ι_S : ∀ x : ↥S, CommRingCat.of k ⟶ S.residueField x,
      ∀ x : ↥S, Spec.map (ι_S x) = S.fromSpecResidueField x ≫ p :=
    ⟨fun x => (Spec.fullyFaithful.preimage (S.fromSpecResidueField x ≫ p)).unop,
     fun _ => Spec.fullyFaithful.map_preimage _⟩

  have h_closed_bij : ∀ x : ↥S,
      IsClosed ({x} : Set ↥S) → Function.Bijective (ι_S x).hom := by
    intro x hx
    have : IsClosedImmersion (S.fromSpecResidueField x) :=
      (isClosed_singleton_iff_isClosedImmersion (x := x)).mp hx
    have hlft_comp : LocallyOfFiniteType (S.fromSpecResidueField x ≫ p) := inferInstance
    rw [← hι_S x] at hlft_comp
    have hft : RingHom.FiniteType (ι_S x).hom :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft_comp
    have hfin : RingHom.Finite (ι_S x).hom :=
      RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hft
    letI : Algebra k ↥(S.residueField x) := (ι_S x).hom.toAlgebra
    have : Module.Finite k ↥(S.residueField x) := hfin
    have : Algebra.IsIntegral k ↥(S.residueField x) :=
      Algebra.IsIntegral.of_finite k ↥(S.residueField x)
    exact IsAlgClosed.algebraMap_bijective_of_isIntegral

  let eS₀ := Scheme.SpecToEquivOfField k S
  have h_eS₀_pt : ∀ (s : Spec (CommRingCat.of k) ⟶ S), s.base pt₀ = (eS₀ s).1 := by
    intro s
    conv_lhs => rw [← eS₀.symm_apply_apply s]
    rw [Scheme.SpecToEquivOfField_symm_apply]
    exact Scheme.fromSpecResidueField_apply (eS₀ s).1 ((Spec.map (eS₀ s).2).base pt₀)

  have h_eS₀_sec : ∀ xf : (x : ↥S) × (S.residueField x ⟶ CommRingCat.of k),
      (eS₀.symm xf ≫ p = 𝟙 _) ↔ (ι_S xf.1 ≫ xf.2 = 𝟙 _) := by
    intro xf
    rw [Scheme.SpecToEquivOfField_symm_apply, Category.assoc,
      ← hι_S xf.1, ← Spec.map_comp, ← Spec.map_id]
    exact Spec.map_injective.eq_iff

  have h_rinv : ∀ (x : ↥S) (α : S.residueField x ⟶ CommRingCat.of k),
      ι_S x ≫ α = 𝟙 _ → ∀ y : ↥(S.residueField x), (ι_S x).hom (α.hom y) = y := by
    intro x α hα y
    apply RingHom.injective α.hom
    exact ConcreteCategory.congr_hom hα (α.hom y)

  have h_sec_ext : ∀ (s₁ s₂ : Spec (CommRingCat.of k) ⟶ S),
      s₁ ≫ p = 𝟙 _ → s₂ ≫ p = 𝟙 _ → s₁.base pt₀ = s₂.base pt₀ → s₁ = s₂ := by
    intro s₁ s₂ hs₁ hs₂ hpt
    apply eS₀.injective
    have hx : (eS₀ s₁).1 = (eS₀ s₂).1 := by
      rw [← h_eS₀_pt s₁, ← h_eS₀_pt s₂, hpt]
    have hα₁ : ι_S (eS₀ s₁).1 ≫ (eS₀ s₁).2 = 𝟙 _ :=
      (h_eS₀_sec (eS₀ s₁)).mp (by rw [eS₀.symm_apply_apply]; exact hs₁)
    have hα₂ : ι_S (eS₀ s₂).1 ≫ (eS₀ s₂).2 = 𝟙 _ :=
      (h_eS₀_sec (eS₀ s₂)).mp (by rw [eS₀.symm_apply_apply]; exact hs₂)
    rcases h1 : eS₀ s₁ with ⟨x₁, α₁⟩
    rcases h2 : eS₀ s₂ with ⟨x₂, α₂⟩
    rw [h1] at hx hα₁
    rw [h2] at hx hα₂
    dsimp only at hx hα₁ hα₂
    subst hx
    congr 1
    ext y
    calc
      α₁.hom y = α₁.hom ((ι_S x₁).hom (α₂.hom y)) := by rw [h_rinv x₁ α₂ hα₂ y]
      _ = α₂.hom y := ConcreteCategory.congr_hom hα₁ (α₂.hom y)

  have h_iW_emb : Topology.IsClosedEmbedding i_W.base :=
    IsClosedImmersion.isClosedEmbedding i_W

  let toFixedPt : ↥W → { x : ↥S // IsClosed ({x} : Set ↥S) ∧ (⇑g.base)^[n] x = x } :=
    fun w =>
      ⟨i_W.base w,
        by
          have hw_cl : IsClosed ({w} : Set ↥W) := isClosed_discrete {w}
          have himg : i_W.base '' ({w} : Set ↥W) = {i_W.base w} := Set.image_singleton
          rw [← himg]
          exact h_iW_emb.isClosedMap _ hw_cl,
        by
          rw [← hφ_base]
          change (i_W ≫ φ).base w = i_W.base w
          rw [h_iW_φ]⟩

  have h_toFixedPt_bij : Function.Bijective toFixedPt := by
    constructor
    · intro w₁ w₂ hw
      exact h_iW_emb.injective (congrArg Subtype.val hw)
    · rintro ⟨x, hx_cl, hx_fix⟩
      have hx_φ : φ.base x = x := by
        rw [hφ_base]
        exact hx_fix
      have hbij := h_closed_bij x hx_cl
      let α_x : S.residueField x ⟶ CommRingCat.of k :=
        CommRingCat.ofHom (RingEquiv.ofBijective (ι_S x).hom hbij).symm.toRingHom
      let s_x : Spec (CommRingCat.of k) ⟶ S := eS₀.symm ⟨x, α_x⟩
      have hs_p : s_x ≫ p = 𝟙 _ :=
        (h_eS₀_sec ⟨x, α_x⟩).mpr (by
          ext c
          exact (RingEquiv.ofBijective (ι_S x).hom hbij).symm_apply_apply c)
      have hs_pt : s_x.base pt₀ = x := by
        dsimp only [s_x]
        rw [h_eS₀_pt, eS₀.apply_symm_apply]
      have hs_φ : s_x ≫ φ = s_x := by
        apply h_sec_ext (s_x ≫ φ) s_x
        · rw [Category.assoc, hφ, hs_p]
        · exact hs_p
        · change φ.base (s_x.base pt₀) = s_x.base pt₀
          rw [hs_pt, hx_φ]
      let s_tilde : Spec (CommRingCat.of k) ⟶ W := liftW s_x hs_φ
      refine ⟨s_tilde.base pt₀, ?_⟩
      apply Subtype.ext
      change (s_tilde ≫ i_W).base pt₀ = x
      rw [h_liftW_iW s_x hs_φ, hs_pt]

  have hW_card :
      Nat.card ↥W =
        Nat.card { x : ↥S // IsClosed ({x} : Set ↥S) ∧ (⇑g.base)^[n] x = x } :=
    Nat.card_congr (Equiv.ofBijective toFixedPt h_toFixedPt_bij)

  exact ⟨φ, hφ, hφ_rel, hφ_base, hW_fin, hW_et, hW_card⟩

theorem weil_lefschetz_torsion_pullback_and_cup_transition (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (r m : ℕ)
      (p_succ : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) m →+ weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) m)
      (p_curr : weilEtaleTorsionH W₂ (ℓ ^ r) m →+ weilEtaleTorsionH W₁ (ℓ ^ r) m),
      WeilLefschetzTorsionPullback h (ℓ ^ (r + 1)) m p_succ →
      WeilLefschetzTorsionPullback h (ℓ ^ r) m p_curr →
      ∀ x : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) m,
        weilEtaleTorsionTransition W₁ ℓ r m (p_succ x) =
          p_curr (weilEtaleTorsionTransition W₂ ℓ r m x)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (r a b c : ℕ) (hab : a + b = c)
      (c_succ : weilEtaleTorsionH W (ℓ ^ (r + 1)) a →+
        weilEtaleTorsionH W (ℓ ^ (r + 1)) b →+ weilEtaleTorsionH W (ℓ ^ (r + 1)) c)
      (c_curr : weilEtaleTorsionH W (ℓ ^ r) a →+
        weilEtaleTorsionH W (ℓ ^ r) b →+ weilEtaleTorsionH W (ℓ ^ r) c),
      WeilLefschetzIsTorsionCup W (ℓ ^ (r + 1)) a b c hab c_succ →
      WeilLefschetzIsTorsionCup W (ℓ ^ r) a b c hab c_curr →
      ∀ (x : weilEtaleTorsionH W (ℓ ^ (r + 1)) a) (y : weilEtaleTorsionH W (ℓ ^ (r + 1)) b),
        weilEtaleTorsionTransition W ℓ r c (c_succ x y) =
          c_curr (weilEtaleTorsionTransition W ℓ r a x)
            (weilEtaleTorsionTransition W ℓ r b y)) :=
by
  have hConstUnit :
      ∀ {ℰ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} ℰ]
        (J : CategoryTheory.GrothendieckTopology ℰ)
        (𝒟 : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} 𝒟]
        [CategoryTheory.HasWeakSheafify J 𝒟]
        {T T' : ℰ} (hT : CategoryTheory.Limits.IsTerminal T)
        (hT' : CategoryTheory.Limits.IsTerminal T') (θ : T' ⟶ T) (A : 𝒟),
        (CategoryTheory.constantSheafAdj J 𝒟 hT').unit.app A =
          CategoryTheory.CategoryStruct.comp
            ((CategoryTheory.constantSheafAdj J 𝒟 hT).unit.app A)
            (((CategoryTheory.constantSheaf J 𝒟).obj A).obj.map (Opposite.op θ)) := by
    intro ℰ _ J 𝒟 _ _ T T' hT hT' θ A
    let u_sh := (CategoryTheory.sheafificationAdjunction J 𝒟).unit.app
      ((CategoryTheory.Functor.const ℰᵒᵖ).obj A)
    have h1 : (CategoryTheory.constantSheafAdj J 𝒟 hT).unit.app A =
        u_sh.app (Opposite.op T) := by
      change ((CategoryTheory.constantPresheafAdj 𝒟 hT).comp
        (CategoryTheory.sheafificationAdjunction J 𝒟)).unit.app A = _
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.Category.id_comp]
      rfl
    have h2 : (CategoryTheory.constantSheafAdj J 𝒟 hT').unit.app A =
        u_sh.app (Opposite.op T') := by
      change ((CategoryTheory.constantPresheafAdj 𝒟 hT').comp
        (CategoryTheory.sheafificationAdjunction J 𝒟)).unit.app A = _
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.Category.id_comp]
      rfl
    rw [h1, h2]
    have hnat := u_sh.naturality (Opposite.op θ)
    dsimp [u_sh, CategoryTheory.constantSheaf] at hnat ⊢
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat
  have hConstSymm :
      ∀ {ℰ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} ℰ]
        (J : CategoryTheory.GrothendieckTopology ℰ)
        (𝒟 : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} 𝒟]
        [CategoryTheory.HasWeakSheafify J 𝒟]
        {T T' : ℰ} (hT : CategoryTheory.Limits.IsTerminal T)
        (hT' : CategoryTheory.Limits.IsTerminal T') (θ : T' ⟶ T)
        (A : 𝒟) (𝒢 : CategoryTheory.Sheaf J 𝒟)
        (g : A ⟶ 𝒢.obj.obj (Opposite.op T)),
        ((CategoryTheory.constantSheafAdj J 𝒟 hT').homEquiv A 𝒢).symm
            (CategoryTheory.CategoryStruct.comp g (𝒢.obj.map (Opposite.op θ))) =
          ((CategoryTheory.constantSheafAdj J 𝒟 hT).homEquiv A 𝒢).symm g := by
    intro ℰ _ J 𝒟 _ _ T T' hT hT' θ A 𝒢 g
    apply ((CategoryTheory.constantSheafAdj J 𝒟 hT').homEquiv A 𝒢).injective
    rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit]
    set f := ((CategoryTheory.constantSheafAdj J 𝒟 hT).homEquiv A 𝒢).symm g
    have hf : (CategoryTheory.constantSheafAdj J 𝒟 hT).homEquiv A 𝒢 f = g :=
      Equiv.apply_symm_apply _ g
    rw [CategoryTheory.Adjunction.homEquiv_unit] at hf
    rw [hConstUnit J 𝒟 hT hT' θ A, CategoryTheory.Category.assoc]
    have hnat : CategoryTheory.CategoryStruct.comp
        (((CategoryTheory.constantSheaf J 𝒟).obj A).obj.map (Opposite.op θ))
