theorem weil_gysin_closed_support_pullback_and_open_excision (hSite : WeilGysinSuppCalcHasExactPullbacks.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ((∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
        (g_Z : Quiver.Hom Z' Z),
        AlgebraicGeometry.IsClosedImmersion i →
        CategoryTheory.IsPullback i' g_Z g i →
        ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
          ∃ τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q,
            WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ) ∧
      (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i' →
        ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (τ'₁ τ'₂ : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q),
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₁ τ →
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₂ τ →
          τ'₁ = τ'₂)) ∧
    ((∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i' →
        ∀ (r q : ℕ) (α : WeilGysinAbSupportClass Z Y i (ℓ ^ r) q)
          (α'₁ α'₂ : WeilGysinAbSupportClass Z' Y' i' (ℓ ^ r) q),
          WeilGysinAbSupportPullback g i' i (ℓ ^ r) q α'₁ α →
          WeilGysinAbSupportPullback g i' i (ℓ ^ r) q α'₂ α →
          α'₁ = α'₂) ∧
      (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
        (g_Z : Quiver.Hom Z' Z),
        AlgebraicGeometry.IsClosedImmersion i' →
        AlgebraicGeometry.IsClosedImmersion i →
        CategoryTheory.IsPullback i' g_Z g i →
        ∀ (r q : ℕ)
          (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
          (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (α' : WeilGysinAbSupportClass Z' Y' i' (ℓ ^ r) q)
          (α : WeilGysinAbSupportClass Z Y i (ℓ ^ r) q),
          WeilGysinIsAbSupportComparison τ' α' →
          WeilGysinIsAbSupportComparison τ α →
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ →
          WeilGysinAbSupportPullback g i' i (ℓ ^ r) q α' α)) ∧
    (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
      (U : Y.Opens) (s_U : Quiver.Hom Z U.toScheme),
      AlgebraicGeometry.IsClosedImmersion i →
      CategoryTheory.CategoryStruct.comp s_U U.ι = i →
      ∀ (r q : ℕ) (τ_U : WeilGysinSupportClass Z U.toScheme s_U (ℓ ^ r) q),
        ∃! τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) q,
          WeilGysinSupportPullback U.ι s_U i (ℓ ^ r) q τ_U τ_Y) :=
by
  have hCorep :
      ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
