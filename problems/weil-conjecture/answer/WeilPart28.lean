      rw [hπ_eq (AM m)]
      rfl
  
  
  
  have hmemL : ∀ (f : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) i),
      f ∈ weilEtaleIntegralSystem S ℓ i ↔
        ∀ r : ℕ, weilEtaleTorsionTransition S ℓ r i (f (r + 1)) = f r := by
    intro f
    rw [weilEtaleIntegralSystem, AddMonoidHom.mem_ker, funext_iff]
    exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
  let F_sys : ↥(weilEtaleIntegralSystem S ℓ i) → ↥(weilEtaleIntegralSystem S ℓ i) :=
    fun z => ⟨fun r => Mi.frobTorsion r (z.1 r), (hmemL _).mpr fun r => by
      rw [hfrob_trans r (z.1 (r + 1)), (hmemL z.1).mp z.2 r]⟩
  have hF_sys_iter : ∀ (k : ℕ) (z : ↥(weilEtaleIntegralSystem S ℓ i)),
      (∀ r : ℕ, (F_sys^[k] z).1 r = (⇑(Mi.frobTorsion r))^[k] (z.1 r)) ∧
      (⇑Mi.frob)^[k] (Mi.equiv (TensorProduct.tmul ℤ (1 : ℚ) z)) =
        Mi.equiv (TensorProduct.tmul ℤ (1 : ℚ) (F_sys^[k] z)) := by
    intro k
    induction k with
    | zero => intro z; exact ⟨fun _ => rfl, rfl⟩
    | succ k ih =>
      intro z
      refine ⟨fun r => ?_, ?_⟩
      · rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ← (ih z).1 r]
      · rw [Function.iterate_succ_apply', Function.iterate_succ_apply', (ih z).2]
        exact Mi.hfrob (F_sys^[k] z) (F_sys (F_sys^[k] z)) (fun _ => rfl)
  refine ⟨fun r => frobAct_k n (ℓ ^ r), hPull_φ, ?_⟩
  intro x y hxy
  have hy_eq : F_sys^[n] x = y := by
    apply Subtype.ext; funext r
    rw [(hF_sys_iter n x).1 r, hxy r, hfrobAct_iter n (ℓ ^ r) (x.1 r), hfrob_eq_act1 r]
  have hpow_apply : (Mi.frob ^ n) (Mi.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
      (⇑Mi.frob)^[n] (Mi.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) :=
    @Module.End.pow_apply (Padic ℓ) Mi.V _ _ _ Mi.frob n _
  rw [hpow_apply, (hF_sys_iter n x).2, hy_eq]

theorem weil_lefschetz_proper_torsion_finiteness_algClosed (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k)) (m r : ℕ) :
    Finite (weilEtaleTorsionH X.left (ℓ ^ r) m) :=
by
  classical
  have hℓ_ne : (ℓ : k) ≠ 0 := hℓ.ne_zero
  let B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
  let f₀ : X ⟶ B₀ :=
    CategoryTheory.Over.homMk X.hom (CategoryTheory.Category.comp_id X.hom)
  have : AlgebraicGeometry.LocallyOfFiniteType B₀.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    infer_instance
  have : AlgebraicGeometry.QuasiCompact B₀.hom := by
    change AlgebraicGeometry.QuasiCompact
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    infer_instance
  have : AlgebraicGeometry.IsSeparated B₀.hom := by
    change AlgebraicGeometry.IsSeparated
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    infer_instance
  have hPropX : AlgebraicGeometry.IsProper f₀.left := by
    change AlgebraicGeometry.IsProper X.hom
    infer_instance
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ_ne
  have hP1 : WeilP1ConstructiblePushforwardHolds k ℓ :=
    weil_etale_p1_constructible_pushforward k ℓ hℓ_ne
      (fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
        weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀)
      hPBC
  obtain ⟨hConstSheaf, hExtract⟩ :=
    weil_etale_constructible_mod_prime_extraction_over_algClosed k X ℓ m
  have hPrime : Finite (weilEtaleTorsionH X.left ℓ m) :=
    hExtract (weil_etale_proper_constructible_pushforward k ℓ hℓ_ne hPBC hP1
      X B₀ f₀ hPropX (weilEtaleTorsionSheaf X.left ℓ) hConstSheaf m)
  let S := X.left
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hℓ_prime.pos
  let C := CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let U := AddCommGrpCat.uliftFunctor.{u, 0}
  induction r with
  | zero =>
    change Finite (weilEtaleTorsionH S 1 m)
    let A₁ : AddCommGrpCat.{u} := U.obj (AddCommGrpCat.of (ZMod 1))
    have hZeroA₁ : CategoryTheory.Limits.IsZero A₁ := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext ⟨x⟩
      exact ULift.ext _ _ (Subsingleton.elim _ _)
    have : C.PreservesZeroMorphisms := by
      dsimp [C, CategoryTheory.constantSheaf]
      infer_instance
    have hZeroSheaf : CategoryTheory.Limits.IsZero (weilEtaleTorsionSheaf S 1) :=
      C.map_isZero hZeroA₁
    have : Subsingleton (weilEtaleTorsionH S 1 m) :=
      CategoryTheory.Sheaf.subsingleton_H_of_isZero hZeroSheaf m
    exact Finite.of_subsingleton
  | succ r ih =>
    have : NeZero ℓ := ⟨hℓ_prime.ne_zero⟩
    have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_prime.ne_zero⟩
    have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_prime.ne_zero⟩
    let ι_hom : ZMod (ℓ ^ r) →+ ZMod (ℓ ^ (r + 1)) :=
      { toFun := fun x => ((ℓ * x.val : ℕ) : ZMod (ℓ ^ (r + 1)))
        map_zero' := by simp
        map_add' := fun x y => by
          have hdiv := Nat.div_add_mod (x.val + y.val) (ℓ ^ r)
          have hmul : ℓ * ((ℓ ^ r) * ((x.val + y.val) / (ℓ ^ r)) + (x.val + y.val) % (ℓ ^ r)) =
              ℓ * (x.val + y.val) := congrArg (ℓ * ·) hdiv
          rw [mul_add, ← mul_assoc, ← pow_succ', mul_add] at hmul
          rw [ZMod.val_add]
          have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r + 1)))) hmul
          rw [Nat.cast_add, Nat.cast_mul, CharP.cast_eq_zero (ZMod (ℓ ^ (r + 1))) (ℓ ^ (r + 1)),
            zero_mul, zero_add, Nat.cast_add] at hcast
          exact hcast }
    have hι_inj : Function.Injective ι_hom := by
      intro x y hxy
      have hx_lt : ℓ * x.val < ℓ ^ (r + 1) := by
        rw [pow_succ']
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt x) hℓ_pos
      have hy_lt : ℓ * y.val < ℓ ^ (r + 1) := by
        rw [pow_succ']
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt y) hℓ_pos
      have hval : (ι_hom x).val = (ι_hom y).val := congrArg ZMod.val hxy
      dsimp [ι_hom] at hval
      rw [ZMod.val_natCast_of_lt hx_lt, ZMod.val_natCast_of_lt hy_lt] at hval
      exact ZMod.val_injective _ (Nat.mul_left_cancel hℓ_pos hval)
    let hdvd : ℓ ∣ ℓ ^ (r + 1) := dvd_pow_self ℓ (Nat.succ_ne_zero r)
    let ρ_ring : ZMod (ℓ ^ (r + 1)) →+* ZMod ℓ := ZMod.castHom hdvd (ZMod ℓ)
    let ρ_hom : ZMod (ℓ ^ (r + 1)) →+ ZMod ℓ := ρ_ring.toAddMonoidHom
    have hρ_surj : Function.Surjective ρ_hom := ZMod.castHom_surjective hdvd
    have hcomp0 : ∀ x : ZMod (ℓ ^ r), ρ_hom (ι_hom x) = 0 := by
      intro x
      change ρ_ring ((ℓ * x.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0
      rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero (ZMod ℓ) ℓ, zero_mul]
    have hexact0 : ∀ z : ZMod (ℓ ^ (r + 1)), ρ_hom z = 0 → ∃ x : ZMod (ℓ ^ r), ι_hom x = z := by
      intro z hz
      have hz_cast : ((z.val : ℕ) : ZMod (ℓ ^ (r + 1))) = z := ZMod.natCast_zmod_val z
      have hρz : ((z.val : ℕ) : ZMod ℓ) = 0 := by
        have h1 : ρ_ring ((z.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 := by
          rw [hz_cast]
          exact hz
        rwa [map_natCast] at h1
      rw [ZMod.natCast_eq_zero_iff] at hρz
      rcases hρz with ⟨q, hq⟩
      have hq_lt : q < ℓ ^ r := by
        have hlt : ℓ * q < ℓ * ℓ ^ r := by
          rw [← hq, ← pow_succ']
          exact ZMod.val_lt z
        exact (Nat.mul_lt_mul_left hℓ_pos).mp hlt
      refine ⟨(q : ZMod (ℓ ^ r)), ?_⟩
      dsimp [ι_hom]
      rw [ZMod.val_natCast_of_lt hq_lt, ← hq, hz_cast]
    let fU := U.map (AddCommGrpCat.ofHom ι_hom)
    let gU := U.map (AddCommGrpCat.ofHom ρ_hom)
    have hfgU : CategoryTheory.CategoryStruct.comp fU gU = 0 := by
      ext ⟨x⟩
      exact ULift.ext _ _ (hcomp0 x)
    let SC₀ := CategoryTheory.ShortComplex.mk fU gU hfgU
    have hSE₀ : SC₀.ShortExact := by
      refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
      · rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
        rintro ⟨z⟩ hz
        have hz0 : ρ_hom z = 0 := congrArg ULift.down hz
        obtain ⟨x, hx⟩ := hexact0 z hz0
        exact ⟨ULift.up x, ULift.ext _ _ hx⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        rintro ⟨x⟩ ⟨y⟩ hxy
        exact ULift.ext _ _ (hι_inj (congrArg ULift.down hxy))
      · rw [AddCommGrpCat.epi_iff_surjective]
        rintro ⟨w⟩
        obtain ⟨z, rfl⟩ := hρ_surj w
        exact ⟨ULift.up z, rfl⟩
    have : CategoryTheory.Limits.PreservesFiniteLimits C := by
      dsimp [C, CategoryTheory.constantSheaf]
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteColimits C := by
      dsimp [C, CategoryTheory.constantSheaf]
      infer_instance
    have : C.Additive := by
      dsimp [C, CategoryTheory.constantSheaf]
      infer_instance
    have hSE : (SC₀.map C).ShortExact := hSE₀.map_of_exact C
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let f_ext : weilEtaleTorsionH S (ℓ ^ r) m →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) m :=
      (CategoryTheory.Abelian.Ext.mk₀ (SC₀.map C).f).postcomp Fℤ (Nat.add_zero m)
    let g_ext : weilEtaleTorsionH S (ℓ ^ (r + 1)) m →+ weilEtaleTorsionH S ℓ m :=
      (CategoryTheory.Abelian.Ext.mk₀ (SC₀.map C).g).postcomp Fℤ (Nat.add_zero m)
    have hexact_mid : ∀ b : weilEtaleTorsionH S (ℓ ^ (r + 1)) m,
        g_ext b = 0 → ∃ a : weilEtaleTorsionH S (ℓ ^ r) m, f_ext a = b :=
      fun b hb => CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE b hb
    have : Finite (Set.range g_ext) := Subtype.finite
    let Φ : weilEtaleTorsionH S (ℓ ^ r) m × Set.range g_ext → weilEtaleTorsionH S (ℓ ^ (r + 1)) m :=
      fun p => f_ext p.1 + p.2.2.choose
    have hΦ_surj : Function.Surjective Φ := by
      intro b
      let q : Set.range g_ext := ⟨g_ext b, ⟨b, rfl⟩⟩
      have hgb : g_ext (b - q.2.choose) = 0 := by
        rw [map_sub, q.2.choose_spec, sub_self]
      obtain ⟨a, ha⟩ := hexact_mid (b - q.2.choose) hgb
      refine ⟨(a, q), ?_⟩
      dsimp [Φ]
      rw [ha, sub_add_cancel]
    exact Finite.of_surjective Φ hΦ_surj

theorem weil_etale_two_param_bockstein_exact_system (S : AlgebraicGeometry.Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (q r : ℕ) (w : weilEtaleTorsionH S (ℓ ^ r) q), (ℓ ^ r) • w = 0) ∧
    ∃ (π : ∀ (q a b : ℕ), b ≤ a →
        weilEtaleTorsionH S (ℓ ^ a) q →+ weilEtaleTorsionH S (ℓ ^ b) q)
      (ι : ∀ (q r s : ℕ),
        weilEtaleTorsionH S (ℓ ^ s) q →+ weilEtaleTorsionH S (ℓ ^ (r + s)) q)
      (δ : ∀ (q r s : ℕ),
        weilEtaleTorsionH S (ℓ ^ r) q →+ weilEtaleTorsionH S (ℓ ^ s) (q + 1)),
      (∀ (q a : ℕ) (x : weilEtaleTorsionH S (ℓ ^ a) q), π q a a (le_refl a) x = x) ∧
      (∀ (q r : ℕ) (x : weilEtaleTorsionH S (ℓ ^ (r + 1)) q),
        π q (r + 1) r (Nat.le_succ r) x = weilEtaleTorsionTransition S ℓ r q x) ∧
      (∀ (q a b c : ℕ) (hba : b ≤ a) (hcb : c ≤ b) (x : weilEtaleTorsionH S (ℓ ^ a) q),
        π q b c hcb (π q a b hba x) = π q a c (le_trans hcb hba) x) ∧
      (∀ (q r s : ℕ) (x : weilEtaleTorsionH S (ℓ ^ (r + s)) q),
        π q (r + s) r (Nat.le_add_right r s) x = 0 →
          ∃ u : weilEtaleTorsionH S (ℓ ^ s) q, ι q r s u = x) ∧
      (∀ (q r s : ℕ) (x : weilEtaleTorsionH S (ℓ ^ r) q),
        δ q r s x = 0 →
          ∃ y : weilEtaleTorsionH S (ℓ ^ (r + s)) q,
            π q (r + s) r (Nat.le_add_right r s) y = x) ∧
      (∀ (q r s : ℕ) (u : weilEtaleTorsionH S (ℓ ^ (s + 1)) q),
        weilEtaleTorsionTransition S ℓ (r + s) q (ι q r (s + 1) u) =
          ι q r s (weilEtaleTorsionTransition S ℓ s q u)) ∧
      (∀ (q r s : ℕ) (x : weilEtaleTorsionH S (ℓ ^ (r + s)) q),
        ι q r s (π q (r + s) s (Nat.le_add_left s r) x) = (ℓ ^ r) • x) ∧
      (∀ (q r s : ℕ) (x : weilEtaleTorsionH S (ℓ ^ r) q),
        weilEtaleTorsionTransition S ℓ s (q + 1) (δ q r (s + 1) x) = δ q r s x) ∧
      (∀ (q r s : ℕ) (x : weilEtaleTorsionH S (ℓ ^ r) q),
        ι (q + 1) r s (δ q r s x) = 0) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  have : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hℓ_ne⟩
  let J := S.smallEtaleTopology
  let C_shf := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
  let Fℤ := C_shf.obj (AddCommGrpCat.of (ULift.{u} ℤ))
  have : C_shf.Additive := by dsimp [C_shf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteLimits C_shf :=
    CategoryTheory.Limits.comp_preservesFiniteLimits
      (CategoryTheory.Functor.const (Opposite S.Etale))
      (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u})
  have hExt_nsmul : ∀ {Y : CategoryTheory.Sheaf J AddCommGrpCat.{u}} {q : ℕ}
      (x : CategoryTheory.Abelian.Ext Fℤ Y q) (n : ℕ),
      x.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id Y))
        (Nat.add_zero q) = n • x := by
    intro Y q x n
    induction n with
    | zero =>
      rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
    | succ n ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
        ih, CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
  have hTors : ∀ (q r : ℕ) (w : weilEtaleTorsionH S (ℓ ^ r) q), (ℓ ^ r) • w = 0 := by
    intro q r w
    let Z_r := AddCommGrpCat.of (ZMod (ℓ ^ r))
    have hZ_zero : (ℓ ^ r) • (CategoryTheory.CategoryStruct.id Z_r) = 0 := by
      ext a
      change (ℓ ^ r) • a = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    have hFM_zero :
        (ℓ ^ r) • (CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf S (ℓ ^ r))) = 0 := by
      change (ℓ ^ r) • (CategoryTheory.CategoryStruct.id (C_shf.obj (U_lift.obj Z_r))) = 0
      rw [← C_shf.map_id, ← U_lift.map_id, ← CategoryTheory.Functor.map_nsmul,
        ← CategoryTheory.Functor.map_nsmul, hZ_zero,
        CategoryTheory.Functor.map_zero, CategoryTheory.Functor.map_zero]
    change (ℓ ^ r) • (w : CategoryTheory.Abelian.Ext Fℤ (weilEtaleTorsionSheaf S (ℓ ^ r)) q) = 0
    rw [← hExt_nsmul w (ℓ ^ r), hFM_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero]
  let Z_obj (n : ℕ) : AddCommGrpCat.{0} := AddCommGrpCat.of (ZMod (ℓ ^ n))
  let π_zmod (a b : ℕ) (hba : b ≤ a) : ZMod (ℓ ^ a) →+ ZMod (ℓ ^ b) :=
    (ZMod.castHom (pow_dvd_pow ℓ hba) (ZMod (ℓ ^ b))).toAddMonoidHom
  have hπ_zmod_nat : ∀ (a b : ℕ) (hba : b ≤ a) (n : ℕ),
      π_zmod a b hba (n : ZMod (ℓ ^ a)) = (n : ZMod (ℓ ^ b)) := by
    intro a b hba n
    exact map_natCast (ZMod.castHom (pow_dvd_pow ℓ hba) (ZMod (ℓ ^ b))) n
  let ι_zmod (r s : ℕ) : ZMod (ℓ ^ s) →+ ZMod (ℓ ^ (r + s)) :=
    ZMod.lift (ℓ ^ s) ⟨AddMonoidHom.mk'
      (fun z : ℤ => ((ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + s))) * (z : ZMod (ℓ ^ (r + s))))
      (fun z₁ z₂ => by push_cast; rw [mul_add]), by
        simp only [AddMonoidHom.mk'_apply, Int.cast_natCast]
        rw [← Nat.cast_mul, ← pow_add, CharP.cast_eq_zero]⟩
  have hι_zmod_nat : ∀ (r s n : ℕ),
      ι_zmod r s (n : ZMod (ℓ ^ s)) = ((ℓ ^ r * n : ℕ) : ZMod (ℓ ^ (r + s))) := by
    intro r s n
    have hcast : (n : ZMod (ℓ ^ s)) = ((n : ℤ) : ZMod (ℓ ^ s)) := (Int.cast_natCast n).symm
    rw [hcast]
    dsimp [ι_zmod]
    rw [ZMod.lift_coe]
    simp only [AddMonoidHom.mk'_apply, Int.cast_natCast, Nat.cast_mul]
  let π_cat (a b : ℕ) (hba : b ≤ a) : Quiver.Hom (Z_obj a) (Z_obj b) :=
    AddCommGrpCat.ofHom (π_zmod a b hba)
  let ι_cat (r s : ℕ) : Quiver.Hom (Z_obj s) (Z_obj (r + s)) :=
    AddCommGrpCat.ofHom (ι_zmod r s)
  have hπ_cat_self : ∀ a : ℕ, π_cat a a (le_refl a) = CategoryTheory.CategoryStruct.id (Z_obj a) := by
    intro a
    ext x
    change π_zmod a a (le_refl a) x = x
    conv_lhs => rw [← ZMod.natCast_zmod_val x]
    rw [hπ_zmod_nat a a (le_refl a), ZMod.natCast_zmod_val]
  have hπ_cat_comp : ∀ (a b c : ℕ) (hba : b ≤ a) (hcb : c ≤ b),
      CategoryTheory.CategoryStruct.comp (π_cat a b hba) (π_cat b c hcb) =
        π_cat a c (le_trans hcb hba) := by
    intro a b c hba hcb
    ext x
    change π_zmod b c hcb (π_zmod a b hba x) = π_zmod a c (le_trans hcb hba) x
    rw [← ZMod.natCast_zmod_val x, hπ_zmod_nat a b hba, hπ_zmod_nat b c hcb,
      hπ_zmod_nat a c (le_trans hcb hba)]
  have hComm_ι_cat : ∀ (r s : ℕ),
      CategoryTheory.CategoryStruct.comp (ι_cat r (s + 1))
        (π_cat (r + s + 1) (r + s) (Nat.le_succ (r + s))) =
      CategoryTheory.CategoryStruct.comp (π_cat (s + 1) s (Nat.le_succ s)) (ι_cat r s) := by
    intro r s
    ext u
    change π_zmod (r + s + 1) (r + s) (Nat.le_succ (r + s)) (ι_zmod r (s + 1) u) =
      ι_zmod r s (π_zmod (s + 1) s (Nat.le_succ s) u)
    rw [← ZMod.natCast_zmod_val u, hι_zmod_nat r (s + 1) u.val,
      hπ_zmod_nat (r + s + 1) (r + s) (Nat.le_succ (r + s)) (ℓ ^ r * u.val),
      hπ_zmod_nat (s + 1) s (Nat.le_succ s) u.val, hι_zmod_nat r s u.val]
  have hMul_ι_cat : ∀ (r s : ℕ),
      CategoryTheory.CategoryStruct.comp (π_cat (r + s) s (Nat.le_add_left s r)) (ι_cat r s) =
        (ℓ ^ r) • CategoryTheory.CategoryStruct.id (Z_obj (r + s)) := by
    intro r s
    ext x
    change ι_zmod r s (π_zmod (r + s) s (Nat.le_add_left s r) x) = (ℓ ^ r) • x
    conv_lhs => rw [← ZMod.natCast_zmod_val x]
    rw [hπ_zmod_nat (r + s) s (Nat.le_add_left s r), hι_zmod_nat, Nat.cast_mul,
      ZMod.natCast_zmod_val, nsmul_eq_mul]
  have hZero_SC₀ : ∀ (r s : ℕ),
      CategoryTheory.CategoryStruct.comp (ι_cat r s) (π_cat (r + s) r (Nat.le_add_right r s)) = 0 := by
    intro r s
    ext a
    change π_zmod (r + s) r (Nat.le_add_right r s) (ι_zmod r s a) = 0
    rw [← ZMod.natCast_zmod_val a, hι_zmod_nat,
      hπ_zmod_nat (r + s) r (Nat.le_add_right r s), Nat.cast_mul,
      CharP.cast_eq_zero, zero_mul]
  let SC₀ (r s : ℕ) : CategoryTheory.ShortComplex AddCommGrpCat.{0} :=
    CategoryTheory.ShortComplex.mk (ι_cat r s) (π_cat (r + s) r (Nat.le_add_right r s))
      (hZero_SC₀ r s)
  have hShort₀ : ∀ (r s : ℕ), (SC₀ r s).ShortExact := by
    intro r s
    have hMono : CategoryTheory.Mono (SC₀ r s).f := by
      dsimp [SC₀]
      rw [AddCommGrpCat.mono_iff_injective]
      change Function.Injective (ι_zmod r s)
      rw [_root_.injective_iff_map_eq_zero]
      intro a ha
      have hlt : ℓ ^ r * a.val < ℓ ^ (r + s) := by
        rw [pow_add]
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt a) (pow_pos hℓ_pos r)
      have ha_cast : ((ℓ ^ r * a.val : ℕ) : ZMod (ℓ ^ (r + s))) = 0 := by
        rw [← hι_zmod_nat r s a.val, ZMod.natCast_zmod_val]
        exact ha
      have hval0 : ℓ ^ r * a.val = 0 := by
        have hv := congrArg ZMod.val ha_cast
        rwa [ZMod.val_natCast_of_lt hlt, ZMod.val_zero] at hv
      have ha_val : a.val = 0 := (mul_eq_zero.mp hval0).resolve_left (pow_ne_zero r hℓ_ne)
      rw [← ZMod.natCast_zmod_val a, ha_val, Nat.cast_zero]
    have hEpi : CategoryTheory.Epi (SC₀ r s).g := by
      dsimp [SC₀]
      rw [AddCommGrpCat.epi_iff_surjective]
      intro c
      refine ⟨(c.val : ZMod (ℓ ^ (r + s))), ?_⟩
      change π_zmod (r + s) r (Nat.le_add_right r s) (c.val : ZMod (ℓ ^ (r + s))) = c
      rw [hπ_zmod_nat (r + s) r (Nat.le_add_right r s), ZMod.natCast_zmod_val]
    have hExact : (SC₀ r s).Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff]
      intro b hb
      have hb_cast : ((b.val : ℕ) : ZMod (ℓ ^ r)) = 0 := by
        have hb' : π_zmod (r + s) r (Nat.le_add_right r s) b = 0 := hb
        rwa [← ZMod.natCast_zmod_val b, hπ_zmod_nat (r + s) r (Nat.le_add_right r s)] at hb'
      obtain ⟨q₀, hq₀⟩ := (ZMod.natCast_eq_zero_iff b.val (ℓ ^ r)).mp hb_cast
      refine ⟨(q₀ : ZMod (ℓ ^ s)), ?_⟩
      change ι_zmod r s (q₀ : ZMod (ℓ ^ s)) = b
      rw [hι_zmod_nat, ← hq₀, ZMod.natCast_zmod_val]
    exact CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi
  let SC_sh (r s : ℕ) : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
    ((SC₀ r s).map U_lift).map C_shf
  have hShort : ∀ (r s : ℕ), (SC_sh r s).ShortExact :=
    fun r s => ((hShort₀ r s).map_of_exact U_lift).map_of_exact C_shf
  let π : ∀ (q a b : ℕ), b ≤ a →
      weilEtaleTorsionH S (ℓ ^ a) q →+ weilEtaleTorsionH S (ℓ ^ b) q :=
    fun q a b hba =>
      (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (π_cat a b hba)))).postcomp
        Fℤ (Nat.add_zero q)
  let ι : ∀ (q r s : ℕ),
      weilEtaleTorsionH S (ℓ ^ s) q →+ weilEtaleTorsionH S (ℓ ^ (r + s)) q :=
    fun q r s =>
      (CategoryTheory.Abelian.Ext.mk₀ (SC_sh r s).f).postcomp Fℤ (Nat.add_zero q)
  let δ : ∀ (q r s : ℕ),
      weilEtaleTorsionH S (ℓ ^ r) q →+ weilEtaleTorsionH S (ℓ ^ s) (q + 1) :=
    fun q r s =>
      ((hShort r s).extClass).postcomp Fℤ (rfl : q + 1 = q + 1)
  refine ⟨hTors, π, ι, δ, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro q a x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (π_cat a a (le_refl a)))))
      (Nat.add_zero q) = x
    rw [hπ_cat_self a, U_lift.map_id, C_shf.map_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
  · intro q r x
    rfl
  · intro q a b c hba hcb x
    change (x.comp (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (π_cat a b hba))))
        (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (π_cat b c hcb))))
        (Nat.add_zero q) =
      x.comp (CategoryTheory.Abelian.Ext.mk₀
          (C_shf.map (U_lift.map (π_cat a c (le_trans hcb hba)))))
        (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
        (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← C_shf.map_comp, ← U_lift.map_comp,
      hπ_cat_comp a b c hba hcb]
  · intro q r s x hx
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ (hShort r s) x hx
  · intro q r s x hx
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ (hShort r s) x rfl hx
  · intro q r s u
    change (u.comp (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (ι_cat r (s + 1)))))
        (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀
          (C_shf.map (U_lift.map (π_cat (r + s + 1) (r + s) (Nat.le_succ (r + s))))))
        (Nat.add_zero q) =
      (u.comp (CategoryTheory.Abelian.Ext.mk₀
          (C_shf.map (U_lift.map (π_cat (s + 1) s (Nat.le_succ s)))))
        (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (ι_cat r s))))
        (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
        (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
        (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← C_shf.map_comp, ← C_shf.map_comp, ← U_lift.map_comp, ← U_lift.map_comp,
      hComm_ι_cat r s]
  · intro q r s x
    change (x.comp (CategoryTheory.Abelian.Ext.mk₀
          (C_shf.map (U_lift.map (π_cat (r + s) s (Nat.le_add_left s r)))))
        (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (ι_cat r s))))
        (Nat.add_zero q) = (ℓ ^ r) • x
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
        (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← C_shf.map_comp, ← U_lift.map_comp,
      hMul_ι_cat r s, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_nsmul,
      U_lift.map_id, C_shf.map_id]
    exact hExt_nsmul x (ℓ ^ r)
  · intro q r s x
    let mor_sh : Quiver.Hom (SC_sh r (s + 1)) (SC_sh r s) :=
      { τ₁ := C_shf.map (U_lift.map (π_cat (s + 1) s (Nat.le_succ s)))
        τ₂ := C_shf.map (U_lift.map (π_cat (r + s + 1) (r + s) (Nat.le_succ (r + s))))
        τ₃ := CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf S (ℓ ^ r))
        comm₁₂ := by
          dsimp [SC_sh, SC₀]
          rw [← C_shf.map_comp, ← C_shf.map_comp, ← U_lift.map_comp, ← U_lift.map_comp]
          exact congrArg (fun f => C_shf.map (U_lift.map f)) (hComm_ι_cat r s).symm
        comm₂₃ := by
          dsimp [SC_sh, SC₀]
          rw [CategoryTheory.Category.comp_id, ← C_shf.map_comp, ← U_lift.map_comp,
            hπ_cat_comp (r + s + 1) (r + s) r (Nat.le_succ (r + s)) (Nat.le_add_right r s)] }
    have hnat :
        (hShort r (s + 1)).extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀
            (C_shf.map (U_lift.map (π_cat (s + 1) s (Nat.le_succ s)))))
          (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf S (ℓ ^ r)))).comp
          (hShort r s).extClass (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality
        (hShort r (s + 1)) (hShort r s) mor_sh
    rw [CategoryTheory.Abelian.Ext.mk₀_id_comp] at hnat
    change (x.comp (hShort r (s + 1)).extClass rfl).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (π_cat (s + 1) s (Nat.le_succ s)))))
        (Nat.add_zero (q + 1)) =
      x.comp (hShort r s).extClass rfl
    rw [CategoryTheory.Abelian.Ext.comp_assoc x (hShort r (s + 1)).extClass
        (CategoryTheory.Abelian.Ext.mk₀ (C_shf.map (U_lift.map (π_cat (s + 1) s (Nat.le_succ s)))))
        rfl (Nat.add_zero 1) (Nat.add_zero (q + 1)),
      hnat]
  · intro q r s x
    have hkill := CategoryTheory.ShortComplex.ShortExact.extClass_comp (hShort r s)
    change (x.comp (hShort r s).extClass rfl).comp
        (CategoryTheory.Abelian.Ext.mk₀ (SC_sh r s).f) (Nat.add_zero (q + 1)) = 0
    rw [CategoryTheory.Abelian.Ext.comp_assoc x (hShort r s).extClass
        (CategoryTheory.Abelian.Ext.mk₀ (SC_sh r s).f) rfl (Nat.add_zero 1) (Nat.add_zero (q + 1)),
      hkill, CategoryTheory.Abelian.Ext.comp_zero]

theorem weil_konig_bockstein_universal_coeff_and_finite (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H : ℕ → ℕ → Type u) [∀ q r : ℕ, AddCommGroup (H q r)]
    (hFin : ∀ q r : ℕ, Finite (H q r))
    (hTors : ∀ (q r : ℕ) (w : H q r), (ℓ ^ r) • w = 0)
    (τ : ∀ q r : ℕ, H q (r + 1) →+ H q r)
    (π : ∀ (q a b : ℕ), b ≤ a → H q a →+ H q b)
    (ι : ∀ q r s : ℕ, H q s →+ H q (r + s))
    (δ : ∀ q r s : ℕ, H q r →+ H (q + 1) s)
    (hπ_self : ∀ (q a : ℕ) (x : H q a), π q a a (le_refl a) x = x)
    (hπ_step : ∀ (q r : ℕ) (x : H q (r + 1)), π q (r + 1) r (Nat.le_succ r) x = τ q r x)
    (hπ_comp : ∀ (q a b c : ℕ) (hba : b ≤ a) (hcb : c ≤ b) (x : H q a),
      π q b c hcb (π q a b hba x) = π q a c (le_trans hcb hba) x)
    (hExact_mid : ∀ (q r s : ℕ) (x : H q (r + s)),
      π q (r + s) r (Nat.le_add_right r s) x = 0 → ∃ u : H q s, ι q r s u = x)
    (hExact_conn : ∀ (q r s : ℕ) (x : H q r),
      δ q r s x = 0 → ∃ y : H q (r + s), π q (r + s) r (Nat.le_add_right r s) y = x)
    (hComm_ι : ∀ (q r s : ℕ) (u : H q (s + 1)),
      τ q (r + s) (ι q r (s + 1) u) = ι q r s (τ q s u))
    (hMul_ι : ∀ (q r s : ℕ) (x : H q (r + s)),
      ι q r s (π q (r + s) s (Nat.le_add_left s r) x) = (ℓ ^ r) • x)
    (hComm_δ : ∀ (q r s : ℕ) (x : H q r),
      τ (q + 1) s (δ q r (s + 1) x) = δ q r s x)
    (hKill_δ : ∀ (q r s : ℕ) (x : H q r),
      ι (q + 1) r s (δ q r s x) = 0) :
    let L : ℕ → Type u := fun q =>
      ↥(AddMonoidHom.ker (AddMonoidHom.pi fun r =>
        (τ q r).comp (Pi.evalAddMonoidHom (H q) (r + 1)) -
        Pi.evalAddMonoidHom (H q) r))
    ∃ (instMod : ∀ q : ℕ, Module (PadicInt ℓ) (L q)),
      ∀ q : ℕ,
        letI : Module (PadicInt ℓ) (L q) := instMod q
        letI : Module (PadicInt ℓ) (L (q + 1)) := instMod (q + 1)
        (∀ (z : PadicInt ℓ) (x : L q) (r : ℕ),
          (z • x).1 r = (PadicInt.toZModPow r z).val • x.1 r) ∧
        Module.Finite (PadicInt ℓ) (L q) ∧
        (∀ (r : ℕ) (y : L q), y.1 r = 0 →
          ∃ u : L q, y = ((ℓ : PadicInt ℓ) ^ r) • u) ∧
        (∃ δ_hat : ∀ r : ℕ, H q r →+ L (q + 1),
          (∀ (r : ℕ) (x : H q r), ((ℓ : PadicInt ℓ) ^ r) • (δ_hat r x) = 0) ∧
          (∀ (r : ℕ) (x : H q r), δ_hat r x = 0 → ∃ w₀ : L q, w₀.1 r = x)) :=
by
  classical
  intro L
  let Sys (q : ℕ) : AddSubgroup (∀ r : ℕ, H q r) :=
    AddMonoidHom.ker (AddMonoidHom.pi fun r =>
      (τ q r).comp (Pi.evalAddMonoidHom (H q) (r + 1)) -
      Pi.evalAddMonoidHom (H q) r)
  have hmemSys : ∀ (q : ℕ) (f : ∀ r : ℕ, H q r),
      f ∈ Sys q ↔ ∀ r : ℕ, τ q r (f (r + 1)) = f r := by
    intro q f
    rw [AddMonoidHom.mem_ker, funext_iff]
    exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  let _ : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hℓ_ne⟩
  have hModSmul : ∀ (q r k : ℕ) (w : H q r),
      ((k : ZMod (ℓ ^ r)).val) • w = k • w := by
    intro q r k w
    rw [ZMod.val_natCast]
    conv_rhs => rw [(Nat.div_add_mod k (ℓ ^ r)).symm]
    rw [add_nsmul, mul_comm (ℓ ^ r), mul_nsmul', hTors q r w, smul_zero, zero_add]
  have hZModZero : ∀ (q r : ℕ) (w : H q r), (0 : ZMod (ℓ ^ r)).val • w = 0 := by
    intro q r w
    rw [ZMod.val_zero, zero_smul]
  have hZModOne : ∀ (q r : ℕ) (w : H q r), (1 : ZMod (ℓ ^ r)).val • w = w := by
    intro q r w
    rw [← Nat.cast_one, hModSmul q r 1 w, one_smul]
  have hZModAdd : ∀ (q r : ℕ) (a b : ZMod (ℓ ^ r)) (w : H q r),
      (a + b).val • w = a.val • w + b.val • w := by
    intro q r a b w
    have hab : a + b = ((a.val + b.val : ℕ) : ZMod (ℓ ^ r)) := by
      rw [Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [hab, hModSmul q r (a.val + b.val) w, add_nsmul]
  have hZModMul : ∀ (q r : ℕ) (a b : ZMod (ℓ ^ r)) (w : H q r),
      (a * b).val • w = a.val • (b.val • w) := by
    intro q r a b w
    have hab : a * b = ((a.val * b.val : ℕ) : ZMod (ℓ ^ r)) := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [hab, hModSmul q r (a.val * b.val) w, mul_nsmul']
  have hZModSum : ∀ {α : Type} (q r : ℕ) (S : Finset α) (u : α → ZMod (ℓ ^ r)) (w : H q r),
      (∑ i ∈ S, u i).val • w = ∑ i ∈ S, (u i).val • w := by
    intro α q r S u w
    induction S using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty, hZModZero]
    | @insert i S hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, hZModAdd, ih]
  have hSmulMem : ∀ (q : ℕ) (z : PadicInt ℓ) (x : L q),
      (fun r => (PadicInt.toZModPow r z).val • x.1 r) ∈ Sys q := by
    intro q z x
    rw [hmemSys]
    intro r
    let a₁ : ℕ := (PadicInt.toZModPow (r + 1) z).val
    have hcast : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
        (PadicInt.toZModPow (r + 1) z) = PadicInt.toZModPow r z :=
      RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r)) z
    have ha₁ : (a₁ : ZMod (ℓ ^ r)) = PadicInt.toZModPow r z := by
      rw [← hcast]
      have h1 : (a₁ : ZMod (ℓ ^ (r + 1))) = PadicInt.toZModPow (r + 1) z :=
        ZMod.natCast_zmod_val _
      rw [← h1, map_natCast]
    change τ q r (a₁ • x.1 (r + 1)) = (PadicInt.toZModPow r z).val • x.1 r
    rw [map_nsmul, (hmemSys q x.1).mp x.2 r, ← ha₁, hModSmul q r a₁ (x.1 r)]
  let instMod : ∀ q : ℕ, Module (PadicInt ℓ) (L q) := fun q =>
    { smul := fun z x => ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, hSmulMem q z x⟩
      one_smul := fun x => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow r 1).val • x.1 r = x.1 r
        rw [map_one, hZModOne]
      mul_smul := fun z₁ z₂ x => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow r (z₁ * z₂)).val • x.1 r =
          (PadicInt.toZModPow r z₁).val • ((PadicInt.toZModPow r z₂).val • x.1 r)
        rw [map_mul, hZModMul]
      smul_zero := fun z => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow r z).val • (0 : H q r) = 0
        rw [smul_zero]
      smul_add := fun z x₁ x₂ => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow r z).val • (x₁.1 r + x₂.1 r) =
          (PadicInt.toZModPow r z).val • x₁.1 r + (PadicInt.toZModPow r z).val • x₂.1 r
        rw [smul_add]
      add_smul := fun z₁ z₂ x => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow r (z₁ + z₂)).val • x.1 r =
          (PadicInt.toZModPow r z₁).val • x.1 r + (PadicInt.toZModPow r z₂).val • x.1 r
        rw [map_add, hZModAdd]
      zero_smul := fun x => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow r 0).val • x.1 r = 0
        rw [map_zero, hZModZero] }
  have hπ_compat : ∀ (q : ℕ) (f : ∀ m : ℕ, H q m),
      (∀ m : ℕ, τ q m (f (m + 1)) = f m) →
      ∀ (b a : ℕ) (hba : b ≤ a), π q a b hba (f a) = f b := by
    intro q f hf b
    refine Nat.le_induction (hπ_self q b (f b)) fun a hba ih => ?_
    calc
      π q (a + 1) b _ (f (a + 1))
        = π q a b hba (π q (a + 1) a (Nat.le_succ a) (f (a + 1))) := by
            rw [hπ_comp]
      _ = π q a b hba (τ q a (f (a + 1))) := by
            rw [hπ_step]
      _ = π q a b hba (f a) := by
            rw [hf a]
      _ = f b := ih
  have hπ_ι_comm : ∀ (q r a b : ℕ) (hab : a ≤ b), ∀ w : H q b,
      ι q r a (π q b a hab w) =
        π q (r + b) (r + a) (Nat.add_le_add_left hab r) (ι q r b w) := by
    intro q r a
    refine Nat.le_induction ?_ fun b hab ih w => ?_
    · intro w
      rw [hπ_self q a w, hπ_self q (r + a) (ι q r a w)]
    · calc
        ι q r a (π q (b + 1) a _ w)
          = ι q r a (π q b a hab (π q (b + 1) b (Nat.le_succ b) w)) := by
              rw [hπ_comp]
        _ = ι q r a (π q b a hab (τ q b w)) := by
              rw [hπ_step]
        _ = π q (r + b) (r + a) (Nat.add_le_add_left hab r) (ι q r b (τ q b w)) :=
              ih (τ q b w)
        _ = π q (r + b) (r + a) (Nat.add_le_add_left hab r) (τ q (r + b) (ι q r (b + 1) w)) := by
              rw [hComm_ι]
        _ = π q (r + b) (r + a) (Nat.add_le_add_left hab r)
              (π q ((r + b) + 1) (r + b) (Nat.le_succ (r + b)) (ι q r (b + 1) w)) := by
              rw [hπ_step]
        _ = π q (r + (b + 1)) (r + a) (Nat.add_le_add_left (Nat.le_succ_of_le hab) r)
              (ι q r (b + 1) w) := by
              rw [hπ_comp]; rfl
  have hEvalKerDiv : ∀ (q r : ℕ) (y : ∀ m : ℕ, H q m),
      (∀ m : ℕ, τ q m (y (m + 1)) = y m) →
      y r = 0 →
      ∃ u : ∀ m : ℕ, H q m,
        (∀ m : ℕ, τ q m (u (m + 1)) = u m) ∧
        (∀ m : ℕ, y m = (ℓ ^ r) • u m) := by
    intro q r y hy hyr
    let K (s : ℕ) : Type u := { u : H q s // ι q r s u = y (r + s) }
    let F : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun j => K j.unop
        map := fun {j₁ j₂} f => TypeCat.ofHom fun u =>
          ⟨π q j₁.unop j₂.unop (CategoryTheory.leOfHom f.unop) u.1, by
            rw [hπ_ι_comm q r j₂.unop j₁.unop (CategoryTheory.leOfHom f.unop) u.1, u.2]
            exact hπ_compat q y hy (r + j₂.unop) (r + j₁.unop) _⟩
        map_id := fun j => by
          ext u
          exact hπ_self q j.unop u.1
        map_comp := fun {j₁ j₂ j₃} f g => by
          ext u
          exact (hπ_comp q j₁.unop j₂.unop j₃.unop
            (CategoryTheory.leOfHom f.unop) (CategoryTheory.leOfHom g.unop) u.1).symm }
    have hFinF : ∀ j : ℕᵒᵖ, Finite (F.obj j) := fun j =>
      @Subtype.finite (H q j.unop) (hFin q j.unop) _
    have hNeF : ∀ j : ℕᵒᵖ, Nonempty (F.obj j) := fun j => by
      have hy_proj : π q (r + j.unop) r (Nat.le_add_right r j.unop) (y (r + j.unop)) = 0 := by
        rw [hπ_compat q y hy r (r + j.unop) (Nat.le_add_right r j.unop), hyr]
      obtain ⟨u₀, hu₀⟩ := hExact_mid q r j.unop (y (r + j.unop)) hy_proj
      exact ⟨⟨u₀, hu₀⟩⟩
    obtain ⟨sec, hsec⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _ F hFinF hNeF
    let u : ∀ m : ℕ, H q m := fun m => (sec (Opposite.op m)).1
    have hu_eq : ∀ s : ℕ, ι q r s (u s) = y (r + s) := fun s => (sec (Opposite.op s)).2
    have hu_compat : ∀ m : ℕ, τ q m (u (m + 1)) = u m := by
      intro m
      have hf := congrArg Subtype.val (hsec (CategoryTheory.homOfLE (Nat.le_succ m)).op)
      change π q (m + 1) m (Nat.le_succ m) (u (m + 1)) = u m at hf
      rwa [hπ_step q m (u (m + 1))] at hf
    refine ⟨u, hu_compat, fun m => ?_⟩
    rcases le_total m r with hmr | hrm
    · have hym : y m = 0 := by
        rw [← hπ_compat q y hy m r hmr, hyr, map_zero]
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hmr
      rw [hym, pow_add, mul_comm (ℓ ^ m) (ℓ ^ k), mul_nsmul', hTors q m (u m), smul_zero]
    · obtain ⟨s, rfl⟩ := Nat.exists_eq_add_of_le hrm
      rw [← hu_eq s, ← hπ_compat q u hu_compat s (r + s) (Nat.le_add_left s r),
        hMul_ι q r s (u (r + s))]
  refine ⟨instMod, fun q => ?_⟩
  let _ : Module (PadicInt ℓ) (L q) := instMod q
  let _ : Module (PadicInt ℓ) (L (q + 1)) := instMod (q + 1)
  have hDivL : ∀ (r : ℕ) (y : L q), y.1 r = 0 →
      ∃ u : L q, y = ((ℓ : PadicInt ℓ) ^ r) • u := by
    intro r y hyr
    obtain ⟨u_raw, hu_compat, hu_div⟩ :=
      hEvalKerDiv q r y.1 ((hmemSys q y.1).mp y.2) hyr
    let u : L q := ⟨u_raw, (hmemSys q u_raw).mpr hu_compat⟩
    refine ⟨u, Subtype.ext <| funext fun m => ?_⟩
    rw [hu_div m]
    change (ℓ ^ r) • u.1 m = (PadicInt.toZModPow m ((ℓ : PadicInt ℓ) ^ r)).val • u.1 m
    rw [← Nat.cast_pow, map_natCast, hModSmul q m (ℓ ^ r) (u.1 m)]
  have hFinL : Module.Finite (PadicInt ℓ) (L q) := by
    let R₁ : Set (H q 1) := Set.range (fun w : L q => w.1 1)
    have hFinR₁ : Finite ↥R₁ := @Subtype.finite (H q 1) (hFin q 1) _
    let _ : Fintype ↥R₁ := Fintype.ofFinite ↥R₁
    let n : ℕ := Fintype.card ↥R₁
    let e₁ : Fin n ≃ ↥R₁ := (Fintype.equivFin ↥R₁).symm
    let g : Fin n → L q := fun j => Classical.choose (e₁ j).2
    have hg : ∀ j : Fin n, (g j).1 1 = (e₁ j).1 := fun j => Classical.choose_spec (e₁ j).2
    let j_of : L q → Fin n := fun w => e₁.symm ⟨w.1 1, ⟨w, rfl⟩⟩
    have hsub1 : ∀ w : L q, (w - g (j_of w)).1 1 = 0 := by
      intro w
      change w.1 1 - (g (j_of w)).1 1 = 0
      rw [hg (j_of w), e₁.apply_symm_apply]
      exact sub_self (w.1 1)
    have hstep : ∀ w : L q, ∃ u : L q, w = g (j_of w) + (ℓ : PadicInt ℓ) • u := by
      intro w
      obtain ⟨u, hu⟩ := hDivL 1 (w - g (j_of w)) (hsub1 w)
      rw [pow_one] at hu
      refine ⟨u, ?_⟩
      rw [← hu]
      abel
    choose next_u hnext_u using hstep
    let evL (r : ℕ) : L q →+ H q r :=
      { toFun := fun w => w.1 r
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    refine Module.Finite.of_fg_top (Submodule.fg_def.mpr ⟨Set.range g, Set.finite_range g, ?_⟩)
    refine le_antisymm le_top fun x _ => ?_
    let u_seq : ℕ → L q := fun k => Nat.recOn k x (fun _ uk => next_u uk)
    let j_seq : ℕ → Fin n := fun k => j_of (u_seq k)
    have hexp : ∀ r : ℕ,
        x = (∑ k ∈ Finset.range r, ((ℓ : PadicInt ℓ) ^ k) • g (j_seq k)) +
          ((ℓ : PadicInt ℓ) ^ r) • u_seq r := by
      intro r
      induction r with
      | zero =>
        rw [Finset.sum_range_zero, zero_add, pow_zero, one_smul]; rfl
      | succ r ih =>
        rw [Finset.sum_range_succ, add_assoc]
        conv_lhs => rw [ih]
        congr 1
        have hstep_r : u_seq r = g (j_seq r) + (ℓ : PadicInt ℓ) • u_seq (r + 1) :=
          hnext_u (u_seq r)
        conv_lhs => rw [hstep_r]
        rw [smul_add, ← mul_smul, ← pow_succ]
    let s_mod (j : Fin n) (r : ℕ) : ZMod (ℓ ^ r) :=
      ∑ k ∈ Finset.range r, if j = j_seq k then (ℓ : ZMod (ℓ ^ r)) ^ k else 0
    have hs_compat : ∀ (j : Fin n) (r₁ r₂ : ℕ) (hk : r₁ ≤ r₂),
        ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ r₁)) (s_mod j r₂) = s_mod j r₁ := by
      intro j r₁ r₂ hk
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
      let φ := ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ r₁))
      change φ (s_mod j (r₁ + d)) = s_mod j r₁
      dsimp only [s_mod]
      rw [Finset.sum_range_add, map_add, map_sum, map_sum]
      have hhead : ∑ k ∈ Finset.range r₁,
          φ (if j = j_seq k then (ℓ : ZMod (ℓ ^ (r₁ + d))) ^ k else 0) =
          ∑ k ∈ Finset.range r₁,
            if j = j_seq k then (ℓ : ZMod (ℓ ^ r₁)) ^ k else 0 := by
        refine Finset.sum_congr rfl fun k _ => ?_
        split_ifs
        · rw [map_pow, map_natCast]
        · rw [map_zero]
      have htail : ∑ t ∈ Finset.range d,
          φ (if j = j_seq (r₁ + t) then (ℓ : ZMod (ℓ ^ (r₁ + d))) ^ (r₁ + t) else 0) = 0 := by
        refine Finset.sum_eq_zero fun t _ => ?_
        split_ifs
        · rw [map_pow, map_natCast, pow_add, ← Nat.cast_pow, CharP.cast_eq_zero, zero_mul]
        · rw [map_zero]
      rw [hhead, htail, add_zero]
    let f_hom (j : Fin n) (r : ℕ) : Polynomial ℤ →+* ZMod (ℓ ^ r) :=
      Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ r))) (s_mod j r)
    have hf_compat : ∀ (j : Fin n) (r₁ r₂ : ℕ) (hk : r₁ ≤ r₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ r₁))).comp (f_hom j r₂) = f_hom j r₁ := by
      intro j r₁ r₂ hk
      apply Polynomial.ringHom_ext'
      · exact RingHom.ext_int _ _
      · simp only [RingHom.comp_apply, f_hom, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        exact hs_compat j r₁ r₂ hk
    let α : Fin n → PadicInt ℓ := fun j => PadicInt.lift (hf_compat j) Polynomial.X
    have hα_mod : ∀ (j : Fin n) (r : ℕ), PadicInt.toZModPow r (α j) = s_mod j r := by
      intro j r
      have hspec := RingHom.congr_fun (PadicInt.lift_spec (hf_compat j) r) Polynomial.X
      simpa [α, f_hom] using hspec
    have hx_eq : x = ∑ j : Fin n, α j • g j := by
      apply Subtype.ext
      funext r
      have hlhs : x.1 r = ∑ k ∈ Finset.range r, (ℓ ^ k) • (g (j_seq k)).1 r := by
        have h1 := congrArg (evL r) (hexp r)
        rw [map_add, map_sum] at h1
        have hrem : evL r (((ℓ : PadicInt ℓ) ^ r) • u_seq r) = 0 := by
          change (PadicInt.toZModPow r ((ℓ : PadicInt ℓ) ^ r)).val • (u_seq r).1 r = 0
          rw [← Nat.cast_pow, map_natCast, hModSmul q r (ℓ ^ r) ((u_seq r).1 r),
            hTors q r ((u_seq r).1 r)]
        rw [hrem, add_zero] at h1
        refine h1.trans (Finset.sum_congr rfl fun k _ => ?_)
        change (PadicInt.toZModPow r ((ℓ : PadicInt ℓ) ^ k)).val • (g (j_seq k)).1 r = _
        rw [← Nat.cast_pow, map_natCast, hModSmul q r (ℓ ^ k) ((g (j_seq k)).1 r)]
      have hrhs : (∑ j : Fin n, α j • g j).1 r =
          ∑ k ∈ Finset.range r, (ℓ ^ k) • (g (j_seq k)).1 r := by
        change evL r (∑ j : Fin n, α j • g j) = _
        rw [map_sum]
        have hstep1 : ∑ j : Fin n, evL r (α j • g j) =
            ∑ j : Fin n, ∑ k ∈ Finset.range r,
              (if j = j_seq k then (ℓ : ZMod (ℓ ^ r)) ^ k else 0).val • (g j).1 r := by
          refine Finset.sum_congr rfl fun j _ => ?_
          change (PadicInt.toZModPow r (α j)).val • (g j).1 r = _
          rw [hα_mod j r]
          exact hZModSum q r (Finset.range r)
            (fun k => if j = j_seq k then (ℓ : ZMod (ℓ ^ r)) ^ k else 0) ((g j).1 r)
        rw [hstep1, Finset.sum_comm]
        refine Finset.sum_congr rfl fun k _ => ?_
        have hinner : ∑ j : Fin n,
            (if j = j_seq k then (ℓ : ZMod (ℓ ^ r)) ^ k else 0).val • (g j).1 r =
            ∑ j : Fin n,
              if j = j_seq k then ((ℓ : ZMod (ℓ ^ r)) ^ k).val • (g j).1 r else 0 := by
          refine Finset.sum_congr rfl fun j _ => ?_
          split_ifs
          · rfl
          · rw [ZMod.val_zero, zero_smul]
        rw [hinner, Finset.sum_ite_eq' Finset.univ (j_seq k)]
        simp only [Finset.mem_univ, ↓reduceIte]
        rw [← Nat.cast_pow, hModSmul q r (ℓ ^ k) ((g (j_seq k)).1 r)]
      exact hlhs.trans hrhs.symm
    rw [hx_eq]
    exact sum_mem fun j _ => Submodule.smul_mem _ (α j) (Submodule.subset_span ⟨j, rfl⟩)
  refine ⟨fun z x r => rfl, hFinL, hDivL, ?_⟩
  let δ_hat : ∀ r : ℕ, H q r →+ L (q + 1) := fun r =>
    { toFun := fun x =>
        ⟨fun s => δ q r s x, (hmemSys (q + 1) _).mpr fun s => hComm_δ q r s x⟩
      map_zero' := Subtype.ext <| funext fun s => map_zero (δ q r s)
      map_add' := fun x₁ x₂ => Subtype.ext <| funext fun s => map_add (δ q r s) x₁ x₂ }
  refine ⟨δ_hat, ?_, ?_⟩
  · intro r x
    apply Subtype.ext
    funext m
    change (PadicInt.toZModPow m ((ℓ : PadicInt ℓ) ^ r)).val • δ q r m x = 0
    rw [← Nat.cast_pow, map_natCast, hModSmul (q + 1) m (ℓ ^ r) (δ q r m x)]
    rcases le_total m r with hmr | hrm
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hmr
      rw [pow_add, mul_comm (ℓ ^ m) (ℓ ^ k), mul_nsmul', hTors (q + 1) m _, smul_zero]
    · obtain ⟨s, rfl⟩ := Nat.exists_eq_add_of_le hrm
      rw [← hMul_ι (q + 1) r s (δ q r (r + s) x),
        hπ_compat (q + 1) (fun t => δ q r t x) (fun t => hComm_δ q r t x)
          s (r + s) (Nat.le_add_left s r),
        hKill_δ q r s x]
  · intro r x h0
    have hδ0 : ∀ s : ℕ, δ q r s x = 0 := fun s =>
      congrFun (congrArg Subtype.val h0) s
    let M_fib (s : ℕ) : Type u :=
      { y : H q (r + s) // π q (r + s) r (Nat.le_add_right r s) y = x }
    let F : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun j => M_fib j.unop
        map := fun {j₁ j₂} f => TypeCat.ofHom fun y =>
          ⟨π q (r + j₁.unop) (r + j₂.unop)
            (Nat.add_le_add_left (CategoryTheory.leOfHom f.unop) r) y.1, by
            rw [hπ_comp]
            exact y.2⟩
        map_id := fun j => by
          ext y
          exact hπ_self q (r + j.unop) y.1
        map_comp := fun {j₁ j₂ j₃} f g => by
          ext y
          exact (hπ_comp q (r + j₁.unop) (r + j₂.unop) (r + j₃.unop)
            (Nat.add_le_add_left (CategoryTheory.leOfHom f.unop) r)
            (Nat.add_le_add_left (CategoryTheory.leOfHom g.unop) r) y.1).symm }
    have hFinF : ∀ j : ℕᵒᵖ, Finite (F.obj j) := fun j =>
      @Subtype.finite (H q (r + j.unop)) (hFin q (r + j.unop)) _
    have hNeF : ∀ j : ℕᵒᵖ, Nonempty (F.obj j) := fun j => by
      obtain ⟨y₀, hy₀⟩ := hExact_conn q r j.unop x (hδ0 j.unop)
      exact ⟨⟨y₀, hy₀⟩⟩
    obtain ⟨sec, hsec⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _ F hFinF hNeF
    let z : ∀ s : ℕ, M_fib s := fun s => sec (Opposite.op s)
    have hz_step : ∀ s : ℕ, τ q (r + s) (z (s + 1)).1 = (z s).1 := by
      intro s
      have hf := congrArg Subtype.val (hsec (CategoryTheory.homOfLE (Nat.le_succ s)).op)
      change π q ((r + s) + 1) (r + s) (Nat.le_succ (r + s)) (z (s + 1)).1 = (z s).1 at hf
      rwa [hπ_step q (r + s) (z (s + 1)).1] at hf
    let w_raw : ∀ m : ℕ, H q m := fun m =>
      π q (r + m) m (Nat.le_add_left m r) (z m).1
    have hw_compat : ∀ m : ℕ, τ q m (w_raw (m + 1)) = w_raw m := by
      intro m
      dsimp only [w_raw]
      calc
        τ q m (π q (r + (m + 1)) (m + 1) (Nat.le_add_left (m + 1) r) (z (m + 1)).1)
          = π q (m + 1) m (Nat.le_succ m)
              (π q ((r + m) + 1) (m + 1) (Nat.le_add_left (m + 1) r) (z (m + 1)).1) := by
              rw [hπ_step]; rfl
        _ = π q ((r + m) + 1) m (le_trans (Nat.le_succ m) (Nat.le_add_left (m + 1) r))
              (z (m + 1)).1 := by
              rw [hπ_comp]
        _ = π q ((r + m) + 1) m (le_trans (Nat.le_add_left m r) (Nat.le_succ (r + m)))
              (z (m + 1)).1 := rfl
        _ = π q (r + m) m (Nat.le_add_left m r)
              (π q ((r + m) + 1) (r + m) (Nat.le_succ (r + m)) (z (m + 1)).1) := by
              rw [hπ_comp]
        _ = π q (r + m) m (Nat.le_add_left m r) (τ q (r + m) (z (m + 1)).1) := by
              rw [hπ_step]
        _ = π q (r + m) m (Nat.le_add_left m r) (z m).1 := by
              rw [hz_step m]
    refine ⟨⟨w_raw, (hmemSys q w_raw).mpr hw_compat⟩, ?_⟩
    change π q (r + r) r (Nat.le_add_left r r) (z r).1 = x
    exact (z r).2

theorem weil_padicInt_finite_module_free_basis_and_torsion_bound (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (M : Type u) [AddCommGroup M] [Module (PadicInt ℓ) M] [Module.Finite (PadicInt ℓ) M] :
    ∃ (b e_M : ℕ) (v : Fin b → M),
      (∀ z : M, (∃ n : ℕ, ((ℓ : PadicInt ℓ) ^ n) • z = 0) →
        ((ℓ : PadicInt ℓ) ^ e_M) • z = 0) ∧
      (∀ (k : ℕ) (c : Fin b → PadicInt ℓ) (u : M),
        ∑ t : Fin b, c t • v t = ((ℓ : PadicInt ℓ) ^ k) • u →
          ∃ d : Fin b → PadicInt ℓ, ∀ t : Fin b, c t = ((ℓ : PadicInt ℓ) ^ k) * d t) ∧
      (∀ (e : ℕ), e_M ≤ e → ∀ w : M,
        ∃ c : Fin b → PadicInt ℓ,
          ((ℓ : PadicInt ℓ) ^ e) • w = ∑ t : Fin b, c t • v t) :=
by
  classical
  let R := PadicInt ℓ
  let T : Submodule R M := Submodule.torsion R M
  let Q := M ⧸ T
  let π_T : M →ₗ[R] Q := T.mkQ
  let ⟨b, bas⟩ := Module.basisOfFiniteTypeTorsionFree' (R := R) (M := Q)
  choose v hv using fun t : Fin b => Submodule.mkQ_surjective T (bas t)
  have hπ_comb : ∀ c : Fin b → R, π_T (∑ t : Fin b, c t • v t) = bas.equivFun.symm c := by
    intro c
    rw [map_sum]
    calc
      ∑ t : Fin b, π_T (c t • v t)
        = ∑ t : Fin b, c t • bas t := by
            refine Finset.sum_congr rfl fun t _ => ?_
            rw [map_smul, hv t]
      _ = bas.equivFun.symm c := (bas.equivFun_symm_apply c).symm
  have hT_pointwise : ∀ x ∈ T, ∃ k : ℕ, ((ℓ : R) ^ k) • x = 0 := by
    intro x hx
    rcases (Submodule.mem_torsion_iff x).mp hx with ⟨a, ha_smul⟩
    rw [Submonoid.smul_def] at ha_smul
    have ha_ne : (a : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp a.2
    let u_unit : Rˣ := PadicInt.unitCoeff ha_ne
    let k_x : ℕ := (a : R).valuation
    have ha_fac : (a : R) = (u_unit : R) * (ℓ : R) ^ k_x := PadicInt.unitCoeff_spec ha_ne
    refine ⟨k_x, ?_⟩
    calc
      ((ℓ : R) ^ k_x) • x
        = (1 : R) • (((ℓ : R) ^ k_x) • x) := (one_smul R _).symm
      _ = ((↑u_unit⁻¹ : R) * (u_unit : R)) • (((ℓ : R) ^ k_x) • x) := by
            rw [Units.inv_mul]
      _ = (↑u_unit⁻¹ : R) • (((u_unit : R) * (ℓ : R) ^ k_x) • x) :=
            ((smul_smul (↑u_unit⁻¹ : R) (u_unit : R) (((ℓ : R) ^ k_x) • x)).symm).trans
              (congrArg ((↑u_unit⁻¹ : R) • ·) (smul_smul (u_unit : R) ((ℓ : R) ^ k_x) x))
      _ = (↑u_unit⁻¹ : R) • ((a : R) • x) := by
            rw [← ha_fac]
      _ = 0 := by
            rw [ha_smul, smul_zero]
  obtain ⟨m, g, hg_span⟩ :=
    Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian T)
  have hg_mem : ∀ i : Fin m, g i ∈ T := by
    intro i
    rw [← hg_span]
    exact Submodule.subset_span ⟨i, rfl⟩
  choose k_fn hk_fn using fun i : Fin m => hT_pointwise (g i) (hg_mem i)
  let e_M : ℕ := Finset.univ.sup k_fn
  let μ_eM : M →ₗ[R] M := LinearMap.lsmul R M ((ℓ : R) ^ e_M)
  have hT_le_ker : T ≤ LinearMap.ker μ_eM := by
    rw [← hg_span, Submodule.span_le, Set.range_subset_iff]
    intro i
    rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.lsmul_apply]
    have hi_le : k_fn i ≤ e_M := Finset.le_sup (f := k_fn) (Finset.mem_univ i)
    rw [← Nat.sub_add_cancel hi_le, pow_add, mul_smul, hk_fn i, smul_zero]
  have hT_kill : ∀ z ∈ T, ((ℓ : R) ^ e_M) • z = 0 := by
    intro z hz
    exact LinearMap.mem_ker.mp (hT_le_ker hz)
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : (ℓ : R) ≠ 0 := Nat.cast_ne_zero.mpr hPrime.ne_zero
  refine ⟨b, e_M, v, ?_, ?_, ?_⟩
  · intro z ⟨n, hn⟩
    have hpow_ne : ((ℓ : R) ^ n) ≠ 0 := pow_ne_zero n hℓ_ne
    have hz_T : z ∈ T := by
      rw [Submodule.mem_torsion_iff]
      refine ⟨⟨(ℓ : R) ^ n, mem_nonZeroDivisors_of_ne_zero hpow_ne⟩, ?_⟩
      rwa [Submonoid.smul_def]
    exact hT_kill z hz_T
  · intro k c u h_comb
    have hQ_eq : bas.equivFun.symm c = ((ℓ : R) ^ k) • π_T u := by
      rw [← hπ_comb c, h_comb, map_smul]
    have hc_eq : c = ((ℓ : R) ^ k) • bas.equivFun (π_T u) := by
      have h1 := congrArg bas.equivFun hQ_eq
      rwa [bas.equivFun.apply_symm_apply, map_smul] at h1
    refine ⟨bas.equivFun (π_T u), fun t => ?_⟩
    have ht := congrFun hc_eq t
    rwa [Pi.smul_apply, smul_eq_mul] at ht
  · intro e he w
    let d₀ : Fin b → R := bas.equivFun (π_T w)
    let z₀ : M := w - ∑ t : Fin b, d₀ t • v t
    have hz₀_ker : z₀ ∈ LinearMap.ker π_T := by
      rw [LinearMap.mem_ker]
      change π_T (w - ∑ t : Fin b, d₀ t • v t) = 0
      rw [map_sub, hπ_comb d₀]
      change π_T w - bas.equivFun.symm (bas.equivFun (π_T w)) = 0
      rw [LinearEquiv.symm_apply_apply bas.equivFun (π_T w), sub_self]
    have hz₀_T : z₀ ∈ T := by
      rwa [Submodule.ker_mkQ T] at hz₀_ker
    have hz₀_kill : ((ℓ : R) ^ e) • z₀ = 0 := by
      rw [← Nat.sub_add_cancel he, pow_add, mul_smul, hT_kill z₀ hz₀_T, smul_zero]
    have hw_eq : ((ℓ : R) ^ e) • w = ((ℓ : R) ^ e) • ∑ t : Fin b, d₀ t • v t := by
      change ((ℓ : R) ^ e) • (w - ∑ t : Fin b, d₀ t • v t) = 0 at hz₀_kill
      rw [smul_sub] at hz₀_kill
      exact sub_eq_zero.mp hz₀_kill
    refine ⟨fun t => ((ℓ : R) ^ e) * d₀ t, ?_⟩
    rw [hw_eq, Finset.smul_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [← mul_smul]

theorem weil_etale_bockstein_dvr_free_basis_system (S : AlgebraicGeometry.Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : ℕ)
    (hFin : ∀ q r : ℕ, Finite (weilEtaleTorsionH S (ℓ ^ r) q)) :
    ∃ (e : ℕ) (b : ℕ → ℕ)
      (v_sys : ∀ q : ℕ, Fin (b q) → ↥(weilEtaleIntegralSystem S ℓ q)),
      (∀ (q r : ℕ), q ≤ D → ∀ c : Fin (b q) → ZMod (ℓ ^ r),
        ∑ t : Fin (b q), (c t).val • ((v_sys q t).1 r) = 0 → c = 0) ∧
      (∀ (q r : ℕ), q ≤ D → ∀ x : weilEtaleTorsionH S (ℓ ^ r) q,
        ∃ c : Fin (b q) → ZMod (ℓ ^ r),
          (ℓ ^ e) • x = ∑ t : Fin (b q), (c t).val • ((v_sys q t).1 r)) ∧
      (∀ q : ℕ, q ≤ D → ∀ w₀ : ↥(weilEtaleIntegralSystem S ℓ q),
        ∃ c : Fin (b q) → PadicInt ℓ,
          ∀ r : ℕ, (ℓ ^ e) • (w₀.1 r) =
            ∑ t : Fin (b q), (PadicInt.toZModPow r (c t)).val • ((v_sys q t).1 r)) :=
by
  classical
  have hAbstractGlue : ∀ (H : ℕ → ℕ → Type u) [∀ q r : ℕ, AddCommGroup (H q r)]
      (hFinH : ∀ q r : ℕ, Finite (H q r))
      (hTorsH : ∀ (q r : ℕ) (w : H q r), (ℓ ^ r) • w = 0)
      (τ : ∀ q r : ℕ, H q (r + 1) →+ H q r)
      (π : ∀ (q a b : ℕ), b ≤ a → H q a →+ H q b)
      (ι : ∀ q r s : ℕ, H q s →+ H q (r + s))
      (δ : ∀ q r s : ℕ, H q r →+ H (q + 1) s),
      (∀ (q a : ℕ) (x : H q a), π q a a (le_refl a) x = x) →
      (∀ (q r : ℕ) (x : H q (r + 1)), π q (r + 1) r (Nat.le_succ r) x = τ q r x) →
      (∀ (q a b c : ℕ) (hba : b ≤ a) (hcb : c ≤ b) (x : H q a),
        π q b c hcb (π q a b hba x) = π q a c (le_trans hcb hba) x) →
      (∀ (q r s : ℕ) (x : H q (r + s)),
        π q (r + s) r (Nat.le_add_right r s) x = 0 → ∃ u : H q s, ι q r s u = x) →
      (∀ (q r s : ℕ) (x : H q r),
        δ q r s x = 0 → ∃ y : H q (r + s), π q (r + s) r (Nat.le_add_right r s) y = x) →
      (∀ (q r s : ℕ) (u : H q (s + 1)),
        τ q (r + s) (ι q r (s + 1) u) = ι q r s (τ q s u)) →
      (∀ (q r s : ℕ) (x : H q (r + s)),
        ι q r s (π q (r + s) s (Nat.le_add_left s r) x) = (ℓ ^ r) • x) →
      (∀ (q r s : ℕ) (x : H q r),
        τ (q + 1) s (δ q r (s + 1) x) = δ q r s x) →
      (∀ (q r s : ℕ) (x : H q r),
        ι (q + 1) r s (δ q r s x) = 0) →
      ∃ (e : ℕ) (b : ℕ → ℕ)
        (v_raw : ∀ q : ℕ, Fin (b q) → ∀ r : ℕ, H q r),
        (∀ (q : ℕ) (t : Fin (b q)) (r : ℕ),
          τ q r (v_raw q t (r + 1)) = v_raw q t r) ∧
        (∀ (q r : ℕ), q ≤ D → ∀ c : Fin (b q) → ZMod (ℓ ^ r),
          ∑ t : Fin (b q), (c t).val • (v_raw q t r) = 0 → c = 0) ∧
        (∀ (q r : ℕ), q ≤ D → ∀ x : H q r,
          ∃ c : Fin (b q) → ZMod (ℓ ^ r),
            (ℓ ^ e) • x = ∑ t : Fin (b q), (c t).val • (v_raw q t r)) ∧
        (∀ q : ℕ, q ≤ D → ∀ w_raw : ∀ r : ℕ, H q r,
          (∀ r : ℕ, τ q r (w_raw (r + 1)) = w_raw r) →
          ∃ c : Fin (b q) → PadicInt ℓ,
            ∀ r : ℕ, (ℓ ^ e) • (w_raw r) =
              ∑ t : Fin (b q), (PadicInt.toZModPow r (c t)).val • (v_raw q t r)) := by
    intro H _ hFinH hTorsH τ π ι δ hπ_self hπ_step hπ_comp hExact_mid hExact_conn
      hComm_ι hMul_ι hComm_δ hKill_δ
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
    let _ : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hℓ_ne⟩
    obtain ⟨instMod, hSpec⟩ :=
      weil_konig_bockstein_universal_coeff_and_finite ℓ H hFinH hTorsH τ
        π ι δ hπ_self hπ_step hπ_comp hExact_mid hExact_conn hComm_ι hMul_ι hComm_δ hKill_δ
    let Sys (q : ℕ) : AddSubgroup (∀ r : ℕ, H q r) :=
      AddMonoidHom.ker (AddMonoidHom.pi fun r =>
        (τ q r).comp (Pi.evalAddMonoidHom (H q) (r + 1)) -
        Pi.evalAddMonoidHom (H q) r)
    let L (q : ℕ) : Type u := ↥(Sys q)
    have hmemSys : ∀ (q : ℕ) (f : ∀ r : ℕ, H q r),
        f ∈ Sys q ↔ ∀ r : ℕ, τ q r (f (r + 1)) = f r := by
      intro q f
      rw [AddMonoidHom.mem_ker, funext_iff]
      exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
    let _ : ∀ q : ℕ, Module (PadicInt ℓ) (L q) := instMod
    have : ∀ q : ℕ, Module.Finite (PadicInt ℓ) (L q) := fun q => (hSpec q).2.1
    have hSmulL : ∀ (q : ℕ) (z : PadicInt ℓ) (x : L q) (r : ℕ),
        (z • x).1 r = (PadicInt.toZModPow r z).val • x.1 r :=
      fun q => (hSpec q).1
    have hPowSmulL_eval : ∀ (q n r : ℕ) (x : L q),
        (((ℓ : PadicInt ℓ) ^ n) • x).1 r = (ℓ ^ n) • x.1 r := by
      intro q n r x
      rw [hSmulL, ← Nat.cast_pow, map_natCast, ZMod.val_natCast]
      conv_rhs => rw [(Nat.div_add_mod (ℓ ^ n) (ℓ ^ r)).symm]
      rw [add_nsmul, mul_comm (ℓ ^ r), mul_nsmul', hTorsH q r (x.1 r), smul_zero, zero_add]
    let evL (q r : ℕ) : L q →+ H q r :=
      { toFun := fun x => x.1 r
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    choose b e_loc v_sys hTorsKill hDivCoord hDecomp using fun q : ℕ =>
      weil_padicInt_finite_module_free_basis_and_torsion_bound ℓ (L q)
    let e : ℕ := (Finset.Iic D).sup (fun q => e_loc q + e_loc (q + 1))
    have he_bound : ∀ q : ℕ, q ≤ D → e_loc q + e_loc (q + 1) ≤ e :=
      fun q hq => Finset.le_sup (f := fun q => e_loc q + e_loc (q + 1)) (Finset.mem_Iic.mpr hq)
    refine ⟨e, b, fun q t => (v_sys q t).1,
      fun q t => (hmemSys q (v_sys q t).1).mp (v_sys q t).2, ?_, ?_, ?_⟩
    · intro q r _ c hc_sum
      let c_tilde : Fin (b q) → PadicInt ℓ := fun t => ((c t).val : PadicInt ℓ)
      let y : L q := ∑ t : Fin (b q), c_tilde t • v_sys q t
      have hc_tilde_mod : ∀ t : Fin (b q), PadicInt.toZModPow r (c_tilde t) = c t := by
        intro t
        dsimp [c_tilde]
        rw [map_natCast, ZMod.natCast_zmod_val]
      have hy0 : y.1 r = 0 := by
        change evL q r (∑ t : Fin (b q), c_tilde t • v_sys q t) = 0
        rw [map_sum]
        calc
          ∑ t : Fin (b q), evL q r (c_tilde t • v_sys q t)
            = ∑ t : Fin (b q), (c t).val • ((v_sys q t).1 r) := by
                refine Finset.sum_congr rfl fun t _ => ?_
                change (c_tilde t • v_sys q t).1 r = _
                rw [hSmulL, hc_tilde_mod]
          _ = 0 := hc_sum
      obtain ⟨u, hu⟩ := (hSpec q).2.2.1 r y hy0
      obtain ⟨d, hd⟩ := hDivCoord q r c_tilde u hu
      funext t
      have ht := congrArg (PadicInt.toZModPow r) (hd t)
      rw [hc_tilde_mod, map_mul, map_pow, map_natCast, ← Nat.cast_pow,
        CharP.cast_eq_zero, zero_mul] at ht
      exact ht
    · intro q r hq x
      have hbound := he_bound q hq
      obtain ⟨δ_hat, hδ_hat_pow, hδ_hat_exact⟩ := (hSpec q).2.2.2
      have hkill_δ : ((ℓ : PadicInt ℓ) ^ e_loc (q + 1)) • (δ_hat r x) = 0 :=
        hTorsKill (q + 1) (δ_hat r x) ⟨r, hδ_hat_pow r x⟩
      have hδ_smul0 : δ_hat r ((ℓ ^ e_loc (q + 1)) • x) = 0 := by
        rw [map_nsmul]
        apply Subtype.ext
        funext s
        have h1 : (((ℓ : PadicInt ℓ) ^ e_loc (q + 1)) • (δ_hat r x)).1 s = 0 :=
          congrFun (congrArg Subtype.val hkill_δ) s
        rw [hPowSmulL_eval] at h1
        exact (map_nsmul (evL (q + 1) s) (ℓ ^ e_loc (q + 1)) (δ_hat r x)).trans h1
      obtain ⟨w₀, hw₀⟩ := hδ_hat_exact r ((ℓ ^ e_loc (q + 1)) • x) hδ_smul0
      let e' : ℕ := e - e_loc (q + 1)
      have he'_ge : e_loc q ≤ e' := by omega
      have he'_add : e' + e_loc (q + 1) = e := by omega
      obtain ⟨c₀, hc₀⟩ := hDecomp q e' he'_ge w₀
      refine ⟨fun t => PadicInt.toZModPow r (c₀ t), ?_⟩
      have heval := congrArg (evL q r) hc₀
      rw [map_sum] at heval
      have hlhs : evL q r (((ℓ : PadicInt ℓ) ^ e') • w₀) = (ℓ ^ e) • x := by
        change (((ℓ : PadicInt ℓ) ^ e') • w₀).1 r = (ℓ ^ e) • x
        rw [hPowSmulL_eval, hw₀, ← mul_nsmul', ← pow_add, he'_add]
      rw [hlhs] at heval
      rw [heval]
      refine Finset.sum_congr rfl fun t _ => ?_
      exact hSmulL q (c₀ t) (v_sys q t) r
    · intro q hq w_raw hw_raw
      have hbound := he_bound q hq
      have he_ge : e_loc q ≤ e := by omega
      let w₀ : L q := ⟨w_raw, (hmemSys q w_raw).mpr hw_raw⟩
      obtain ⟨c, hc⟩ := hDecomp q e he_ge w₀
      refine ⟨c, fun r => ?_⟩
      have heval := congrArg (evL q r) hc
      rw [map_sum] at heval
      have hlhs : evL q r (((ℓ : PadicInt ℓ) ^ e) • w₀) = (ℓ ^ e) • (w_raw r) :=
        hPowSmulL_eval q e r w₀
      rw [hlhs] at heval
      rw [heval]
      refine Finset.sum_congr rfl fun t _ => ?_
      exact hSmulL q (c t) (v_sys q t) r

  obtain ⟨hTors, π, ι, δ, hπ_self, hπ_step, hπ_comp, hExact_mid, hExact_conn,
    hComm_ι, hMul_ι, hComm_δ, hKill_δ⟩ :=
    weil_etale_two_param_bockstein_exact_system S ℓ
  obtain ⟨e, b, v_raw, hv_compat, hInj, hSurj, hIntDecomp⟩ :=
    hAbstractGlue (fun q r => weilEtaleTorsionH S (ℓ ^ r) q) hFin hTors
      (fun q r => weilEtaleTorsionTransition S ℓ r q)
      π ι δ hπ_self hπ_step hπ_comp hExact_mid hExact_conn hComm_ι hMul_ι hComm_δ hKill_δ
  have hmemSys_etale : ∀ (q : ℕ) (f : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) q),
      f ∈ weilEtaleIntegralSystem S ℓ q ↔
        ∀ r : ℕ, weilEtaleTorsionTransition S ℓ r q (f (r + 1)) = f r := by
    intro q f
    rw [weilEtaleIntegralSystem, AddMonoidHom.mem_ker, funext_iff]
    exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
  refine ⟨e, b, fun q t => ⟨v_raw q t, (hmemSys_etale q _).mpr (hv_compat q t)⟩,
    hInj, hSurj, fun q hq w₀ => hIntDecomp q hq w₀.1 ((hmemSys_etale q w₀.1).mp w₀.2)⟩

theorem weil_etale_topDegPullback_unique_and_bockstein_exact : (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ)
      (p₁ p₂ : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q),
      WeilTopDegTorsionPullback h m₀ q p₁ →
      WeilTopDegTorsionPullback h m₀ q p₂ →
      p₁ = p₂) ∧
    (∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ),
      ∃ (ι_H : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
          weilEtaleTorsionH Z (ℓ ^ r) q →+ weilEtaleTorsionH Z (ℓ ^ (r + 1)) q)
        (π_H : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
          weilEtaleTorsionH Z (ℓ ^ (r + 1)) q →+ weilEtaleTorsionH Z ℓ q)
        (δ_H : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
          weilEtaleTorsionH Z ℓ q →+ weilEtaleTorsionH Z (ℓ ^ r) (q + 1)),
        (∀ (Z : AlgebraicGeometry.Scheme.{u}) (q : ℕ)
            (b : weilEtaleTorsionH Z (ℓ ^ (r + 1)) q),
          π_H Z q b = 0 ↔ ∃ a : weilEtaleTorsionH Z (ℓ ^ r) q, ι_H Z q a = b) ∧
        (∀ (Z : AlgebraicGeometry.Scheme.{u}) (q : ℕ)
            (c : weilEtaleTorsionH Z ℓ q),
          δ_H Z q c = 0 ↔ ∃ b : weilEtaleTorsionH Z (ℓ ^ (r + 1)) q, π_H Z q b = c) ∧
        (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (q : ℕ),
          (∀ (p_r : weilEtaleTorsionH W₂ (ℓ ^ r) q →+ weilEtaleTorsionH W₁ (ℓ ^ r) q)
              (p_s : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) q →+ weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) q),
            WeilTopDegTorsionPullback h (ℓ ^ r) q p_r →
            WeilTopDegTorsionPullback h (ℓ ^ (r + 1)) q p_s →
            ∀ a : weilEtaleTorsionH W₂ (ℓ ^ r) q,
              p_s (ι_H W₂ q a) = ι_H W₁ q (p_r a)) ∧
          (∀ (p_s : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) q →+ weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) q)
              (p_1 : weilEtaleTorsionH W₂ ℓ q →+ weilEtaleTorsionH W₁ ℓ q),
            WeilTopDegTorsionPullback h (ℓ ^ (r + 1)) q p_s →
            WeilTopDegTorsionPullback h ℓ q p_1 →
            ∀ b : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) q,
              p_1 (π_H W₂ q b) = π_H W₁ q (p_s b)) ∧
          (∀ (p_1 : weilEtaleTorsionH W₂ ℓ q →+ weilEtaleTorsionH W₁ ℓ q)
              (p_r1 : weilEtaleTorsionH W₂ (ℓ ^ r) (q + 1) →+ weilEtaleTorsionH W₁ (ℓ ^ r) (q + 1)),
            WeilTopDegTorsionPullback h ℓ q p_1 →
            WeilTopDegTorsionPullback h (ℓ ^ r) (q + 1) p_r1 →
            ∀ c : weilEtaleTorsionH W₂ ℓ q,
              p_r1 (δ_H W₂ q c) = δ_H W₁ q (p_1 c)))) :=
by
  have hExtNatIso : ∀ {C D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.HasExt.{u} C] [CategoryTheory.EnoughInjectives C]
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      (F₁ F₂ : CategoryTheory.Functor C D)
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (η : F₁ ≅ F₂) (X Y : C) (q : ℕ) (x : CategoryTheory.Abelian.Ext X Y q),
      (F₂.mapExtAddHom X Y q) x =
        (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)).comp
          (((F₁.mapExtAddHom X Y q) x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero q))
          (Nat.zero_add q) := by
    intro C D _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ η X Y q x
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply]
    induction q generalizing Y with
    | zero =>
      rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [η.hom.naturality, ← CategoryTheory.Category.assoc, η.inv_hom_id_app,
        CategoryTheory.Category.id_comp]
    | succ k ih =>
      let I : C := CategoryTheory.Injective.under Y
      let ι : Quiver.Hom Y I := CategoryTheory.Injective.ι Y
      let π : Quiver.Hom I (CategoryTheory.Limits.cokernel ι) :=
        CategoryTheory.Limits.cokernel.π ι
      let S : CategoryTheory.ShortComplex C :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hxI : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hxI rfl
      have hS₁ : (S.map F₁).ShortExact := hS.map_of_exact F₁
      have hS₂ : (S.map F₂).ShortExact := hS.map_of_exact F₂
      let φ_η : (S.map F₁).Hom (S.map F₂) :=
        CategoryTheory.ShortComplex.Hom.mk
          (η.hom.app S.X₁) (η.hom.app S.X₂) (η.hom.app S.X₃)
          (η.hom.naturality S.f).symm (η.hom.naturality S.g).symm
      let u := CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)
      let v := CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z
      let e₁ := hS₁.extClass
      let e₂ := hS₂.extClass
      let wY := CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)
      let wQ := CategoryTheory.Abelian.Ext.mk₀ (η.hom.app S.X₃)
      have hNatExt : e₁.comp wY (Nat.add_zero 1) = wQ.comp e₂ (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₁ hS₂ φ_η
      exact calc
        CategoryTheory.Abelian.Ext.mapExactFunctor F₂ (z.comp hS.extClass rfl)
            = (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ z).comp e₂ rfl := by
                dsimp only [e₂]
                rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        _ = (u.comp (v.comp wQ (Nat.add_zero k)) (Nat.zero_add k)).comp e₂ rfl := by
                dsimp only [u, v, wQ]
                rw [ih S.X₃ z]
        _ = u.comp ((v.comp wQ (Nat.add_zero k)).comp e₂ rfl) (Nat.zero_add (k + 1)) :=
                CategoryTheory.Abelian.Ext.comp_assoc u (v.comp wQ (Nat.add_zero k)) e₂
                  (Nat.zero_add k) (rfl : k + 1 = k + 1) (by omega : 0 + k + 1 = k + 1)
        _ = u.comp (v.comp (wQ.comp e₂ (Nat.zero_add 1)) rfl) (Nat.zero_add (k + 1)) :=
                congrArg (fun t => u.comp t (Nat.zero_add (k + 1)))
                  (CategoryTheory.Abelian.Ext.comp_assoc v wQ e₂
                    (Nat.add_zero k) (Nat.zero_add 1) (by omega : k + 0 + 1 = k + 1))
        _ = u.comp (v.comp (e₁.comp wY (Nat.add_zero 1)) rfl) (Nat.zero_add (k + 1)) := by
                rw [← hNatExt]
        _ = u.comp ((v.comp e₁ rfl).comp wY (Nat.add_zero (k + 1))) (Nat.zero_add (k + 1)) :=
                congrArg (fun t => u.comp t (Nat.zero_add (k + 1)))
                  (CategoryTheory.Abelian.Ext.comp_assoc v e₁ wY
                    (rfl : k + 1 = k + 1) (Nat.add_zero 1) (Nat.add_zero (k + 1))).symm
        _ = u.comp ((CategoryTheory.Abelian.Ext.mapExactFunctor F₁ (z.comp hS.extClass rfl)).comp
              wY (Nat.add_zero (k + 1))) (Nat.zero_add (k + 1)) := by
                dsimp only [v, e₁]
                rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]

  have hUnitRes : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (T T' : W.Etale) (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (μ : Quiver.Hom T T')
      (A : AddCommGrpCat.{u}),
      let J := W.smallEtaleTopology
      let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A)
        ((C.obj A).obj.map (Opposite.op μ)) =
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A := by
    intro W T T' hT hT' μ A J C
    let P_A := (CategoryTheory.Functor.const (Opposite W.Etale)).obj A
    have hu : ∀ {U : W.Etale} (hU : CategoryTheory.Limits.IsTerminal U),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hU).unit.app A =
          (CategoryTheory.toSheafify J P_A).app (Opposite.op U) := by
      intro U hU
      change CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hU).unit.app A)
          (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app P_A).app
            (Opposite.op U)) = _
      rw [CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.sheafificationAdjunction_unit_app]
      exact CategoryTheory.Category.id_comp ((CategoryTheory.toSheafify J P_A).app (Opposite.op U))
    rw [hu hT', hu hT]
    have hnat := (CategoryTheory.toSheafify J P_A).naturality (Opposite.op μ)
    dsimp [P_A] at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm

  have hMateConj : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂),
      let B : CategoryTheory.Functor W₂.Etale W₁.Etale := weilEtaleSitePullback h
      let J₁ := W₁.smallEtaleTopology
      let J₂ := W₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      ∀ [hCont : B.IsContinuous J₂ J₁]
        (P₁ P₂ : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
        (adj_pull₁ : P₁ ⊣ B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁)
        (adj_pull₂ : P₂ ⊣ B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁)
        (T₁ T₁' : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (hT₁' : CategoryTheory.Limits.IsTerminal T₁')
        (T₂ T₂' : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (hT₂' : CategoryTheory.Limits.IsTerminal T₂')
        (A : AddCommGrpCat.{u}),
        let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let adj₁' := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁'
        let adj₂' := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂'
        let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
        let τ' : Quiver.Hom (B.obj T₂') T₁' := hT₁'.from (B.obj T₂')
        let π₁ : Quiver.Hom (P₁.obj (C₂.obj A)) (C₁.obj A) :=
          (adj_pull₁.homEquiv (C₂.obj A) (C₁.obj A)).symm
            ((adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
                ((C₁.obj A).obj.map (Opposite.op τ))))
        let π₂ : Quiver.Hom (P₂.obj (C₂.obj A)) (C₁.obj A) :=
          (adj_pull₂.homEquiv (C₂.obj A) (C₁.obj A)).symm
            ((adj₂'.homEquiv A (P_push.obj (C₁.obj A))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁'.unit.app A)
                ((C₁.obj A).obj.map (Opposite.op τ'))))
        π₁ = CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.Adjunction.leftAdjointUniq adj_pull₁ adj_pull₂).hom.app (C₂.obj A))
          π₂ := by
    intro W₁ W₂ h B J₁ J₂ C₁ C₂ hCont P₁ P₂ adj_pull₁ adj_pull₂ T₁ T₁' hT₁ hT₁' T₂ T₂' hT₂ hT₂' A
      P_push adj₁ adj₂ adj₁' adj₂' τ τ' π₁ π₂
    let 𝒢 := P_push.obj (C₁.obj A)
    let g₁ : Quiver.Hom (C₂.obj A) 𝒢 :=
      (adj₂.homEquiv A 𝒢).symm
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A) ((C₁.obj A).obj.map (Opposite.op τ)))
    let g₂ : Quiver.Hom (C₂.obj A) 𝒢 :=
      (adj₂'.homEquiv A 𝒢).symm
        (CategoryTheory.CategoryStruct.comp (adj₁'.unit.app A) ((C₁.obj A).obj.map (Opposite.op τ')))
    have hg_eq : g₁ = g₂ := by
      apply (adj₂.homEquiv A 𝒢).injective
      dsimp only [g₁]
      rw [Equiv.apply_symm_apply]
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      change _ = CategoryTheory.CategoryStruct.comp (adj₂.unit.app A) (g₂.hom.app (Opposite.op T₂))
      let μ₂ : Quiver.Hom T₂ T₂' := hT₂'.from T₂
      let μ₁ : Quiver.Hom T₁' T₁ := hT₁.from T₁'
      rw [← hUnitRes W₂ T₂ T₂' hT₂ hT₂' μ₂ A, CategoryTheory.Category.assoc,
        g₂.hom.naturality (Opposite.op μ₂), ← CategoryTheory.Category.assoc]
      have hg₂_app : CategoryTheory.CategoryStruct.comp (adj₂'.unit.app A)
          (g₂.hom.app (Opposite.op T₂')) =
          CategoryTheory.CategoryStruct.comp (adj₁'.unit.app A)
            ((C₁.obj A).obj.map (Opposite.op τ')) := by
        change (adj₂'.homEquiv A 𝒢) g₂ = _
        dsimp only [g₂]
        exact Equiv.apply_symm_apply _ _
      rw [hg₂_app]
      change _ = CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (adj₁'.unit.app A)
          ((C₁.obj A).obj.map (Opposite.op τ')))
        ((C₁.obj A).obj.map (Opposite.op (B.map μ₂)))
      rw [← hUnitRes W₁ T₁' T₁ hT₁' hT₁ μ₁ A, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, ← (C₁.obj A).obj.map_comp, ← (C₁.obj A).obj.map_comp]
      congr 1
      exact congrArg (fun f => (C₁.obj A).obj.map (Opposite.op f)) (hT₁.hom_ext τ _)
    apply (adj_pull₁.homEquiv (C₂.obj A) (C₁.obj A)).injective
    change (adj_pull₁.homEquiv (C₂.obj A) (C₁.obj A)) ((adj_pull₁.homEquiv _ _).symm g₁) = _
    rw [Equiv.apply_symm_apply, hg_eq, CategoryTheory.Adjunction.homEquiv_unit, P_push.map_comp,
      ← CategoryTheory.Category.assoc]
    have huniq := CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app
      adj_pull₁ adj_pull₂ (C₂.obj A)
    rw [CategoryTheory.Adjunction.homEquiv_unit] at huniq
    rw [huniq, ← CategoryTheory.Adjunction.homEquiv_unit]
    dsimp only [π₂, g₂, 𝒢]
    exact (Equiv.apply_symm_apply _ _).symm

  have hMateNat : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂),
      let B : CategoryTheory.Functor W₂.Etale W₁.Etale := weilEtaleSitePullback h
      let J₁ := W₁.smallEtaleTopology
      let J₂ := W₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      ∀ [hCont : B.IsContinuous J₂ J₁]
        (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
        (adj_pull : P_pull ⊣ B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁)
        (T₁ : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        {A A' : AddCommGrpCat.{u}} (φ : Quiver.Hom A A'),
        let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
        let π_A : Quiver.Hom (P_pull.obj (C₂.obj A)) (C₁.obj A) :=
          (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
            ((adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
                ((C₁.obj A).obj.map (Opposite.op τ))))
        let π_A' : Quiver.Hom (P_pull.obj (C₂.obj A')) (C₁.obj A') :=
          (adj_pull.homEquiv (C₂.obj A') (C₁.obj A')).symm
            ((adj₂.homEquiv A' (P_push.obj (C₁.obj A'))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A')
                ((C₁.obj A').obj.map (Opposite.op τ))))
        CategoryTheory.CategoryStruct.comp (P_pull.map (C₂.map φ)) π_A' =
          CategoryTheory.CategoryStruct.comp π_A (C₁.map φ) := by
    intro W₁ W₂ h B J₁ J₂ C₁ C₂ hCont P_pull adj_pull T₁ hT₁ T₂ hT₂ A A' φ
      P_push adj₁ adj₂ τ π_A π_A'
    dsimp only [π_A, π_A']
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm,
      ← CategoryTheory.Adjunction.homEquiv_naturality_right_symm]
    congr 1
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm,
      ← CategoryTheory.Adjunction.homEquiv_naturality_right_symm]
    congr 1
    change CategoryTheory.CategoryStruct.comp φ
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A')
          ((C₁.obj A').obj.map (Opposite.op τ))) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
          ((C₁.obj A).obj.map (Opposite.op τ)))
        ((C₁.map φ).hom.app (Opposite.op (B.obj T₂)))
    have hnat₁ : CategoryTheory.CategoryStruct.comp φ (adj₁.unit.app A') =
        CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
          ((C₁.map φ).hom.app (Opposite.op T₁)) :=
      adj₁.unit.naturality φ
    rw [← CategoryTheory.Category.assoc, hnat₁, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc]
    congr 1
    exact ((C₁.map φ).hom.naturality (Opposite.op τ)).symm

  have hZModSE : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ),
      ∃ (ι₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ r)))
            (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1)))))
        (π₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
            (AddCommGrpCat.of (ZMod ℓ)))
        (hcomp₀ : CategoryTheory.CategoryStruct.comp ι₀ π₀ = 0),
        (CategoryTheory.ShortComplex.mk ι₀ π₀ hcomp₀).ShortExact := by
    intro ℓ hFact r
    have hPrime : Nat.Prime ℓ := hFact.out
    have hℓ_pos : 0 < ℓ := hPrime.pos
    have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
    have : NeZero ℓ := ⟨hℓ_ne⟩
    have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_ne⟩
    have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
    let ι_hom : ZMod (ℓ ^ r) →+ ZMod (ℓ ^ (r + 1)) :=
      { toFun := fun a => ((ℓ * a.val : ℕ) : ZMod (ℓ ^ (r + 1)))
        map_zero' := by simp
        map_add' := fun a b => by
          have hval : (a + b).val = (a.val + b.val) % (ℓ ^ r) := ZMod.val_add a b
          let q₀ := (a.val + b.val) / (ℓ ^ r)
          have hdiv : ℓ ^ r * q₀ + (a + b).val = a.val + b.val := by
            rw [hval]
            exact Nat.div_add_mod (a.val + b.val) (ℓ ^ r)
          have hmul : ℓ ^ (r + 1) * q₀ + ℓ * (a + b).val = ℓ * a.val + ℓ * b.val := by
            calc
              ℓ ^ (r + 1) * q₀ + ℓ * (a + b).val
                  = ℓ * (ℓ ^ r * q₀ + (a + b).val) := by rw [pow_succ']; ring
              _ = ℓ * (a.val + b.val) := by rw [hdiv]
              _ = ℓ * a.val + ℓ * b.val := Nat.mul_add ℓ a.val b.val
          have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r + 1)))) hmul
          push_cast at hcast
          have hzero : ((ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 := CharP.cast_eq_zero _ _
          have hzero' : (ℓ : ZMod (ℓ ^ (r + 1))) ^ (r + 1) = 0 := by
            rw [← Nat.cast_pow]
            exact hzero
          rw [hzero', zero_mul, zero_add] at hcast
          push_cast
          exact hcast }
    let π_hom : ZMod (ℓ ^ (r + 1)) →+ ZMod ℓ :=
      (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)).toAddMonoidHom
    let ι₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ r)))
        (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1)))) :=
      AddCommGrpCat.ofHom ι_hom
    let π₀ : Quiver.Hom (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
        (AddCommGrpCat.of (ZMod ℓ)) :=
      AddCommGrpCat.ofHom π_hom
    have hcomp₀ : CategoryTheory.CategoryStruct.comp ι₀ π₀ = 0 := by
      ext a
      change (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ))
        (((ℓ * a.val : ℕ) : ZMod (ℓ ^ (r + 1)))) = 0
      rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero, zero_mul]
    have hMono : CategoryTheory.Mono ι₀ := by
      rw [AddCommGrpCat.mono_iff_injective]
      change Function.Injective ι_hom
      rw [_root_.injective_iff_map_eq_zero]
      intro a ha
      have hlt : ℓ * a.val < ℓ ^ (r + 1) := by
        rw [pow_succ']
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt a) hℓ_pos
      have hval0 : ℓ * a.val = 0 := by
        have ha' : ((ℓ * a.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 := ha
        have hv := congrArg ZMod.val ha'
        rwa [ZMod.val_natCast_of_lt hlt, ZMod.val_zero] at hv
      have ha_val : a.val = 0 := (mul_eq_zero.mp hval0).resolve_left hℓ_ne
      rw [← ZMod.natCast_zmod_val a, ha_val, Nat.cast_zero]
    have hEpi : CategoryTheory.Epi π₀ := by
      rw [AddCommGrpCat.epi_iff_surjective]
      intro c
      refine ⟨(c.val : ZMod (ℓ ^ (r + 1))), ?_⟩
      change (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ))
        (c.val : ZMod (ℓ ^ (r + 1))) = c
      rw [map_natCast, ZMod.natCast_zmod_val]
    have hExact : (CategoryTheory.ShortComplex.mk ι₀ π₀ hcomp₀).Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff]
      intro b hb
      have hb_cast : ((b.val : ℕ) : ZMod ℓ) = 0 := by
        have hb' : (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)) b = 0 := hb
        rw [← ZMod.natCast_zmod_val b, map_natCast] at hb'
        exact hb'
      obtain ⟨q₁, hq₁⟩ := (ZMod.natCast_eq_zero_iff b.val ℓ).mp hb_cast
      have hq₁_lt : q₁ < ℓ ^ r := by
        have hlt : ℓ * q₁ < ℓ * ℓ ^ r := by
          rw [← hq₁, ← pow_succ']
          exact ZMod.val_lt b
        exact Nat.lt_of_mul_lt_mul_left hlt
      refine ⟨(q₁ : ZMod (ℓ ^ r)), ?_⟩
      change ((ℓ * (q₁ : ZMod (ℓ ^ r)).val : ℕ) : ZMod (ℓ ^ (r + 1))) = b
      rw [ZMod.val_natCast_of_lt hq₁_lt, ← hq₁, ZMod.natCast_zmod_val]
    exact ⟨ι₀, π₀, hcomp₀, CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi⟩

  have hUniq_top : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ)
      (p₁ p₂ : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q),
      WeilTopDegTorsionPullback h m₀ q p₁ →
      WeilTopDegTorsionPullback h m₀ q p₂ →
      p₁ = p₂ := by
    intro W₁ W₂ h m₀ q p₁ p₂ hp₁ hp₂
    rcases hp₁ with ⟨hCont₁, P₁, adj_pull₁, hAdd₁, hLim₁, hColim₁,
      T₁, hT₁, T₂, hT₂, ιℤ₁, hιπ₁, hπι₁, hp₁_eq⟩
    rcases hp₂ with ⟨hCont₂, P₂, adj_pull₂, hAdd₂, hLim₂, hColim₂,
      T₁', hT₁', T₂', hT₂', ιℤ₂, hιπ₂, hπι₂, hp₂_eq⟩
    cases Subsingleton.elim hCont₁ hCont₂
    have := hCont₁
    have := hAdd₁
    have := hLim₁
    have := hColim₁
    have := hAdd₂
    have := hLim₂
    have := hColim₂
    let B := weilEtaleSitePullback h
    let J₁ := W₁.smallEtaleTopology
    let J₂ := W₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let η : P₁ ≅ P₂ := CategoryTheory.Adjunction.leftAdjointUniq adj_pull₁ adj_pull₂
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let adj₁' := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁'
