            map_smul' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
      have hCorepSV : ∀ (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens)
          (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R₀))
