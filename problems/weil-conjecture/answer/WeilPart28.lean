import WeilPart27
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_top_deg_p1_prod_kummer_affine_chart_trace (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (hd : 1 ≤ d)
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (hCD : ∀ (m q : ℕ)
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper Z.hom],
      topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
      2 * m < q →
      Subsingleton (weilEtaleTorsionH Z.left n q))
    (hGenFree : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
      (w : Fin d → A),
      IsTranscendenceBasis k w →
      let ψ : MvPolynomial (Fin d) k →ₐ[k] A := MvPolynomial.aeval w
      ∃ (g : MvPolynomial (Fin d) k) (m_w : ℕ),
        g ≠ 0 ∧
        1 ≤ m_w ∧
        let B_g := Localization.Away g
        let A_g := Localization.Away (ψ g)
        let ψ_g : B_g →+* A_g := Localization.awayMap ψ.toRingHom g
        ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module B_g M)
          (e : M ≃+ A_g),
          (∀ (b : B_g) (m : M), e (b • m) = ψ_g b * e m) ∧
          Nonempty (Module.Basis (Fin m_w) B_g M))
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (hDim : topologicalKrullDim X.left = (d : WithBot ℕ∞)) :
    let kAlg : ∀ W : X.left.Opens, Algebra k ↑(X.left.presheaf.obj (Opposite.op W)) :=
      fun W => RingHom.toAlgebra (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appLE X.hom ⊤ W le_top)))
    ∃ t_X : ∀ (W : X.left.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥W →
      ∀ (w : Fin d → ↑(X.left.presheaf.obj (Opposite.op W))),
        @IsTranscendenceBasis (Fin d) k ↑(X.left.presheaf.obj (Opposite.op W)) _ _ (kAlg W) w →
        (weilEtaleTorsionH X.left n (2 * d) →+ ZMod n),
      (∀ (W' W : X.left.Opens)
        (hW' : AlgebraicGeometry.IsAffineOpen W') (hNe' : Nonempty ↥W')
        (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W)
        (hle : W' ≤ W)
        (w : Fin d → ↑(X.left.presheaf.obj (Opposite.op W)))
        (hw : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W) w)
        (hw' : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W')
          (fun i => (CommRingCat.Hom.hom
            (X.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE hle)))) (w i))),
        t_X W' hW' hNe' _ hw' = t_X W hW hNe w hw) ∧
      (∀ (W : X.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W)
        (w₁ w₂ : Fin d → ↑(X.left.presheaf.obj (Opposite.op W)))
        (hw₁ : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W) w₁)
        (hw₂ : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W) w₂)
        (i₀ : Fin d),
        (∀ j : Fin d, j ≠ i₀ → w₁ j = w₂ j) →
        t_X W hW hNe w₁ hw₁ = t_X W hW hNe w₂ hw₂) ∧
      (∀ (δ : ℕ) (_ : 1 ≤ δ)
        (φ : Quiver.Hom X.left X.left),
        CategoryTheory.CategoryStruct.comp φ X.hom = X.hom →
        WeilTopDegFiniteLocallyFreeOfRank δ φ →
        ∀ (φ_shriek : weilEtaleTorsionH X.left n (2 * d) →+ weilEtaleTorsionH X.left n (2 * d)),
          WeilTopDegAffineFiniteFreePushforward k n δ (2 * d) ζ X X φ φ_shriek →
          ∀ (V : X.left.Opens) (hV : AlgebraicGeometry.IsAffineOpen V) (hNeV : Nonempty ↥V),
            let U : X.left.Opens := (TopologicalSpace.Opens.map φ.base).obj V
            ∀ (hU : AlgebraicGeometry.IsAffineOpen U) (hNeU : Nonempty ↥U)
              (u : Fin d → ↑(X.left.presheaf.obj (Opposite.op V)))
              (hu : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg V) u)
              (hu' : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg U)
                (fun i => (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app φ V)) (u i))),
              (t_X V hV hNeV u hu).comp φ_shriek = t_X U hU hNeU _ hu') ∧
      (∀ (V : X.left.Opens) (hV : AlgebraicGeometry.IsAffineOpen V) (hNeV : Nonempty ↥V)
        (ψ : @AlgHom k (MvPolynomial (Fin d) k) ↑(X.left.presheaf.obj (Opposite.op V)) _ _ _ _ (kAlg V)),
        RingHom.Etale ψ.toRingHom →
        ∀ (hu : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg V) (fun i => ψ (MvPolynomial.X i))),
          Function.Surjective (t_X V hV hNeV (fun i => ψ (MvPolynomial.X i)) hu)) :=
by
  classical
  obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : d ≠ 0)
  have hmd : m + 1 = d := hm.symm
  intro kAlg
  obtain ⟨ι_P1, ι_aff, hCoord⟩ := weil_top_deg_kummer_polyP1_coord_compactification k
  obtain ⟨tr_P1, tr_Pd, hTrace⟩ :=
    weil_top_deg_kummer_polyP1_model_trace k n hn hUnit ζ hζ hCD ι_P1 ι_aff hCoord
  obtain ⟨F_push, hPush⟩ :=
    weil_top_deg_kummer_chart_pushforward_and_tower_norm k d hd n hn hUnit ζ hζ
      hCD hGenFree ι_P1 ι_aff hCoord
  rcases hPush with ⟨hPush_shrink, hPush_shriek, ⟨A_aut, hA_id, hA_comp, hA_nat, hA_Pd⟩,
    hPush_lift, _hPush_char⟩
  let t_X : ∀ (W : X.left.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥W →
      ∀ (w : Fin d → ↑(X.left.presheaf.obj (Opposite.op W))),
        @IsTranscendenceBasis (Fin d) k ↑(X.left.presheaf.obj (Opposite.op W)) _ _ (kAlg W) w →
        (weilEtaleTorsionH X.left n (2 * d) →+ ZMod n) :=
    fun W hW hNe w hw => (tr_Pd d).comp (F_push X hInt hDim W hW hNe w hw)
  refine ⟨t_X, ?_, ?_, ?_, ?_⟩
  · 
    intro W' W hW' hNe' hW hNe hle w hw hw'
    exact congrArg (tr_Pd d).comp
      (hPush_shrink X hInt hDim W' W hW' hNe' hW hNe hle w hw hw')
  · 
    intro W hW hNe w₁ w₂ hw₁ hw₂ i₀ hAgree
    let hPush_all : WeilTopDegKummerChartPushPkg k d n ζ ι_aff F_push :=
      ⟨hPush_shrink, hPush_shriek, ⟨A_aut, hA_id, hA_comp, hA_nat, hA_Pd⟩, hPush_lift, _hPush_char⟩
    let j_last : Fin d := Fin.cast hmd (Fin.last m)
    by_cases hi₀ : i₀ = j_last
    · subst hi₀
      exact weil_top_deg_kummer_last_coord_curve_norm_invariance k m d hmd n hn hUnit ζ hζ
        hCD hGenFree ι_P1 ι_aff hCoord tr_P1 tr_Pd hTrace F_push hPush_all
        X hInt hDim W hW hNe w₁ w₂ hw₁ hw₂ hAgree
    · let R₀ := MvPolynomial (Fin d) k
      let Pd := weilPolyP1Over k d
      have hCoord_d := hCoord.2.2.2.2.2.2.2.2 d
      have : AlgebraicGeometry.IsProper Pd.hom := hCoord_d.1
      have hIntP : AlgebraicGeometry.IsIntegral Pd.left := hCoord_d.2.1
      have : AlgebraicGeometry.SmoothOfRelativeDimension d Pd.hom := hCoord_d.2.2.1
      have hOpen : AlgebraicGeometry.IsOpenImmersion (ι_aff d) := hCoord_d.2.2.2.1
      have h_over : CategoryTheory.CategoryStruct.comp (ι_aff d) Pd.hom =
          (weilAffineSpaceOver k d).hom := hCoord_d.2.2.2.2.1
      have hDimP : topologicalKrullDim Pd.left = (d : WithBot ℕ∞) :=
        weil_smooth_integral_krullDim_over_field k d Pd hIntP
      have : AlgebraicGeometry.IsOpenImmersion (ι_aff d) := hOpen
      let W_aff : Pd.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange (ι_aff d)
      have : AlgebraicGeometry.IsAffine (weilAffineSpaceOver k d).left := by
        change AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of R₀))
        infer_instance
      have hAff_P : AlgebraicGeometry.IsAffineOpen W_aff :=
        AlgebraicGeometry.isAffineOpen_opensRange (ι_aff d)
      have hNe_Spec : Nonempty ↥(weilAffineSpaceOver k d).left := by
        change Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀))
        infer_instance
      obtain ⟨pt_aff⟩ := hNe_Spec
      have hNe_P : Nonempty ↥W_aff := ⟨⟨(ι_aff d).base pt_aff, ⟨pt_aff, rfl⟩⟩⟩
      let kAlgP : Algebra k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Pd.hom ⊤ W_aff le_top)))
      let A_spec : AlgebraicGeometry.Scheme.{u} :=
        AlgebraicGeometry.Spec (CommRingCat.of R₀)
      let ι_d : A_spec ⟶ Pd.left := ι_aff d
      have : AlgebraicGeometry.IsOpenImmersion ι_d := hOpen
      let e_sch : A_spec ≅ W_aff.toScheme := ι_d.isoOpensRange
      let e_ι_app : Pd.left.presheaf.obj (Opposite.op W_aff) ≅
          W_aff.toScheme.presheaf.obj (Opposite.op ⊤) :=
        CategoryTheory.asIso
          (AlgebraicGeometry.Scheme.Hom.appLE W_aff.ι W_aff ⊤ (fun x _ => x.2))
      let e_appTop : W_aff.toScheme.presheaf.obj (Opposite.op ⊤) ≅
          A_spec.presheaf.obj (Opposite.op ⊤) :=
        { hom := e_sch.hom.appTop
          inv := e_sch.inv.appTop
          hom_inv_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] }
      let Φ_ring : Pd.left.presheaf.obj (Opposite.op W_aff) ≅ CommRingCat.of R₀ :=
        e_ι_app ≪≫ e_appTop ≪≫ AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)
      have h_appLE_congr : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}
          {O₂ : Z₂.Opens} {O₁ : Z₁.Opens}
          (g₁ g₂ : Z₁ ⟶ Z₂), g₁ = g₂ →
          ∀ (h₁ : O₁ ≤ (TopologicalSpace.Opens.map g₁.base).obj O₂)
            (h₂ : O₁ ≤ (TopologicalSpace.Opens.map g₂.base).obj O₂),
          g₁.appLE O₂ O₁ h₁ = g₂.appLE O₂ O₁ h₂ := by
        rintro _ _ _ _ g₁ _ rfl _ _
        rfl
      have h_app_eq : e_ι_app.hom ≫ e_sch.hom.appTop =
          AlgebraicGeometry.Scheme.Hom.appLE (ι_aff d) W_aff ⊤ (fun x _ => ⟨x, rfl⟩) :=
        (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e_sch.hom W_aff.ι W_aff ⊤ ⊤
          (fun x _ => x.2) (fun _ _ => trivial)).trans
          (h_appLE_congr (e_sch.hom ≫ W_aff.ι) (ι_aff d)
            (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_d) _ _)
      have hΦ_hom_eq : Φ_ring.hom =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appLE (ι_aff d) W_aff ⊤ (fun x _ => ⟨x, rfl⟩))
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom :=
        (CategoryTheory.Category.assoc e_ι_app.hom e_sch.hom.appTop
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom).symm.trans
          (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) h_app_eq)
      have hΦ_k_comm : ∀ c : k,
          Φ_ring.inv.hom (algebraMap k R₀ c) =
            @algebraMap k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) _ _ kAlgP c := by
        intro c
        have h_fwd : Φ_ring.hom.hom
            (@algebraMap k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) _ _ kAlgP c) =
            algebraMap k R₀ c := by
          let specC : A_spec ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀))
          have h_comp1 : Pd.hom.appLE ⊤ W_aff le_top ≫
              (ι_aff d).appLE W_aff ⊤ (fun x _ => ⟨x, rfl⟩) =
              specC.appTop :=
            (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE (ι_aff d) Pd.hom ⊤ W_aff ⊤
              (fun _ _ => trivial) (fun x _ => ⟨x, rfl⟩)).trans
              (h_appLE_congr (O₂ := ⊤) (O₁ := ⊤) (ι_aff d ≫ Pd.hom) specC h_over
                (fun _ _ => trivial) (fun _ _ => trivial))
          have h_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              (specC.appTop ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) =
              CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) :=
            (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
              (AlgebraicGeometry.Scheme.ΓSpecIso_naturality
                (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀)))).trans
              (CategoryTheory.Iso.inv_hom_id_assoc _ _)
          have h_hom_chain : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              Pd.hom.appLE ⊤ W_aff le_top) ≫ Φ_ring.hom =
              CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) := by
            rw [hΦ_hom_eq]
            calc
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  Pd.hom.appLE ⊤ W_aff le_top) ≫
                (AlgebraicGeometry.Scheme.Hom.appLE (ι_aff d) W_aff ⊤ (fun x _ => ⟨x, rfl⟩) ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom)
                = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                    ((Pd.hom.appLE ⊤ W_aff le_top ≫
                      (ι_aff d).appLE W_aff ⊤ (fun x _ => ⟨x, rfl⟩)) ≫
                      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) :=
                  (CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
                      (CategoryTheory.Category.assoc _ _ _).symm)
              _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                    (specC.appTop ≫
                      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) :=
                  congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
                    (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom)
                      h_comp1)
              _ = CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) := h_nat
          exact congrArg (fun ψ => ψ.hom c) h_hom_chain
        calc
          Φ_ring.inv.hom (algebraMap k R₀ c)
            = Φ_ring.inv.hom (Φ_ring.hom.hom
                (@algebraMap k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) _ _ kAlgP c)) := by
              rw [h_fwd]
          _ = (Φ_ring.hom ≫ Φ_ring.inv).hom
                (@algebraMap k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) _ _ kAlgP c) := rfl
          _ = @algebraMap k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) _ _ kAlgP c := by
              rw [Φ_ring.hom_inv_id]
              rfl
      letI : Algebra k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) := kAlgP
      let e_aff : R₀ ≃ₐ[k] ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) :=
        AlgEquiv.ofRingEquiv (f := Φ_ring.symm.commRingCatIsoToRingEquiv) hΦ_k_comm
      let x_std : Fin d → ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) :=
        fun i => e_aff (MvPolynomial.X i)
      have hx_std_app : ∀ i : Fin d,
          (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appLE (ι_aff d) W_aff ⊤ (fun x _ => ⟨x, rfl⟩))
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom))
            (x_std i) = MvPolynomial.X i := by
        intro i
        rw [← hΦ_hom_eq]
        change (Φ_ring.inv ≫ Φ_ring.hom).hom (MvPolynomial.X i) = MvPolynomial.X i
        rw [Φ_ring.inv_hom_id]
        rfl
      have h_aeval_eaff : ∀ p : R₀, MvPolynomial.aeval x_std p = e_aff p := by
        have h_alg : MvPolynomial.aeval x_std = e_aff.toAlgHom := by
          apply MvPolynomial.algHom_ext
          intro i
          exact MvPolynomial.aeval_X x_std i
        intro p
        exact AlgHom.congr_fun h_alg p
      have htb_X : IsTranscendenceBasis k (MvPolynomial.X : Fin d → R₀) :=
        IsTranscendenceBasis.mvPolynomial (Fin d) k
      have htb_θ : ∀ θ : R₀ ≃ₐ[k] R₀,
          IsTranscendenceBasis k
            (fun i : Fin d => MvPolynomial.aeval x_std (θ (MvPolynomial.X i))) := by
        intro θ
        have h_eq : (fun i : Fin d => MvPolynomial.aeval x_std (θ (MvPolynomial.X i))) =
            (⇑(θ.trans e_aff) ∘ (MvPolynomial.X : Fin d → R₀)) := by
          ext i
          exact h_aeval_eaff (θ (MvPolynomial.X i))
        rw [h_eq]
        exact (θ.trans e_aff).isTranscendenceBasis htb_X
      
      let σ : Equiv.Perm (Fin d) := Equiv.swap i₀ j_last
      let swap_alg : R₀ ≃ₐ[k] R₀ := MvPolynomial.renameEquiv k σ
      let f_il_pos : R₀ →ₐ[k] R₀ :=
        MvPolynomial.aeval (Function.update MvPolynomial.X i₀
          (MvPolynomial.X i₀ + MvPolynomial.X j_last))
      let f_il_neg : R₀ →ₐ[k] R₀ :=
        MvPolynomial.aeval (Function.update MvPolynomial.X i₀
          (MvPolynomial.X i₀ - MvPolynomial.X j_last))
      let E_il : R₀ ≃ₐ[k] R₀ :=
        AlgEquiv.ofAlgHom f_il_pos f_il_neg
          (by
            apply MvPolynomial.algHom_ext
            intro j
            change f_il_pos (f_il_neg (MvPolynomial.X j)) = MvPolynomial.X j
            rw [MvPolynomial.aeval_X]
            by_cases hj : j = i₀
            · subst hj
              rw [Function.update_self, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
                Function.update_self, Function.update_of_ne (Ne.symm hi₀), add_sub_cancel_right]
            · rw [Function.update_of_ne hj, MvPolynomial.aeval_X, Function.update_of_ne hj])
          (by
            apply MvPolynomial.algHom_ext
            intro j
            change f_il_neg (f_il_pos (MvPolynomial.X j)) = MvPolynomial.X j
            rw [MvPolynomial.aeval_X]
            by_cases hj : j = i₀
            · subst hj
              rw [Function.update_self, map_add, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
                Function.update_self, Function.update_of_ne (Ne.symm hi₀), sub_add_cancel]
            · rw [Function.update_of_ne hj, MvPolynomial.aeval_X, Function.update_of_ne hj])
      let f_li_pos : R₀ →ₐ[k] R₀ :=
        MvPolynomial.aeval (Function.update MvPolynomial.X j_last
          (MvPolynomial.X j_last + MvPolynomial.X i₀))
      let f_li_neg : R₀ →ₐ[k] R₀ :=
        MvPolynomial.aeval (Function.update MvPolynomial.X j_last
          (MvPolynomial.X j_last - MvPolynomial.X i₀))
      let E_li_pos : R₀ ≃ₐ[k] R₀ :=
        AlgEquiv.ofAlgHom f_li_pos f_li_neg
          (by
            apply MvPolynomial.algHom_ext
            intro j
            change f_li_pos (f_li_neg (MvPolynomial.X j)) = MvPolynomial.X j
            rw [MvPolynomial.aeval_X]
            by_cases hj : j = j_last
            · subst hj
              rw [Function.update_self, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
                Function.update_self, Function.update_of_ne hi₀, add_sub_cancel_right]
            · rw [Function.update_of_ne hj, MvPolynomial.aeval_X, Function.update_of_ne hj])
          (by
            apply MvPolynomial.algHom_ext
            intro j
            change f_li_neg (f_li_pos (MvPolynomial.X j)) = MvPolynomial.X j
            rw [MvPolynomial.aeval_X]
            by_cases hj : j = j_last
            · subst hj
              rw [Function.update_self, map_add, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
                Function.update_self, Function.update_of_ne hi₀, sub_add_cancel]
            · rw [Function.update_of_ne hj, MvPolynomial.aeval_X, Function.update_of_ne hj])
      let E_li_neg : R₀ ≃ₐ[k] R₀ := E_li_pos.symm
      let f_dneg : R₀ →ₐ[k] R₀ :=
        MvPolynomial.aeval (Function.update MvPolynomial.X j_last (-MvPolynomial.X j_last))
      let D_neg : R₀ ≃ₐ[k] R₀ :=
        AlgEquiv.ofAlgHom f_dneg f_dneg
          (by
            apply MvPolynomial.algHom_ext
            intro j
            change f_dneg (f_dneg (MvPolynomial.X j)) = MvPolynomial.X j
            rw [MvPolynomial.aeval_X]
            by_cases hj : j = j_last
            · subst hj
              rw [Function.update_self, map_neg, MvPolynomial.aeval_X,
                Function.update_self, neg_neg]
            · rw [Function.update_of_ne hj, MvPolynomial.aeval_X, Function.update_of_ne hj])
          (by
            apply MvPolynomial.algHom_ext
            intro j
            change f_dneg (f_dneg (MvPolynomial.X j)) = MvPolynomial.X j
            rw [MvPolynomial.aeval_X]
            by_cases hj : j = j_last
            · subst hj
              rw [Function.update_self, map_neg, MvPolynomial.aeval_X,
                Function.update_self, neg_neg]
            · rw [Function.update_of_ne hj, MvPolynomial.aeval_X, Function.update_of_ne hj])
      have h_algEquiv_ext : ∀ (α β : R₀ ≃ₐ[k] R₀),
          (∀ j : Fin d, α (MvPolynomial.X j) = β (MvPolynomial.X j)) → α = β :=
        fun α β hgen => AlgEquiv.ext (fun p => AlgHom.congr_fun
          (MvPolynomial.algHom_ext (f := α.toAlgHom) (g := β.toAlgHom) hgen) p)
      have h_swap_X : ∀ j : Fin d, swap_alg (MvPolynomial.X j) = MvPolynomial.X (σ j) :=
        fun j => MvPolynomial.rename_X σ j
      have h_swap_inv : swap_alg.trans swap_alg = AlgEquiv.refl := by
        apply h_algEquiv_ext
        intro j
        change swap_alg (swap_alg (MvPolynomial.X j)) = MvPolynomial.X j
        rw [h_swap_X, h_swap_X, Equiv.swap_apply_self]
      have h_conj : (swap_alg.trans E_il).trans swap_alg = E_li_pos := by
        apply h_algEquiv_ext
        intro j
        change swap_alg (f_il_pos (swap_alg (MvPolynomial.X j))) = f_li_pos (MvPolynomial.X j)
        rw [h_swap_X, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        by_cases hj1 : j = i₀
        · rw [hj1]
          have hσ1 : σ i₀ = j_last := Equiv.swap_apply_left i₀ j_last
          rw [hσ1, Function.update_of_ne (Ne.symm hi₀), h_swap_X,
            Equiv.swap_apply_right, Function.update_of_ne hi₀]
        · by_cases hj2 : j = j_last
          · rw [hj2]
            have hσ2 : σ j_last = i₀ := Equiv.swap_apply_right i₀ j_last
            rw [hσ2, Function.update_self, map_add, h_swap_X, h_swap_X,
              Equiv.swap_apply_left, Equiv.swap_apply_right, Function.update_self]
          · have hσ : σ j = j := Equiv.swap_apply_of_ne_of_ne hj1 hj2
            rw [hσ, Function.update_of_ne hj1, h_swap_X, hσ, Function.update_of_ne hj2]
      have h_fac_swap : D_neg.trans (E_il.trans (E_li_neg.trans E_il)) = swap_alg := by
        apply h_algEquiv_ext
        intro j
        change f_il_pos (f_li_neg (f_il_pos (f_dneg (MvPolynomial.X j)))) =
          swap_alg (MvPolynomial.X j)
        rw [h_swap_X, MvPolynomial.aeval_X]
        by_cases hj1 : j = i₀
        · rw [hj1]
          have hσ1 : σ i₀ = j_last := Equiv.swap_apply_left i₀ j_last
          rw [hσ1, Function.update_of_ne hi₀, MvPolynomial.aeval_X, Function.update_self,
            map_add, MvPolynomial.aeval_X, MvPolynomial.aeval_X, Function.update_of_ne hi₀,
            Function.update_self]
          have h_ring1 : MvPolynomial.X i₀ + (MvPolynomial.X j_last - MvPolynomial.X i₀) =
              (MvPolynomial.X j_last : R₀) := by ring
          rw [h_ring1, MvPolynomial.aeval_X, Function.update_of_ne (Ne.symm hi₀)]
        · by_cases hj2 : j = j_last
          · rw [hj2]
            have hσ2 : σ j_last = i₀ := Equiv.swap_apply_right i₀ j_last
            rw [hσ2, Function.update_self, map_neg, MvPolynomial.aeval_X,
              Function.update_of_ne (Ne.symm hi₀), map_neg, MvPolynomial.aeval_X,
              Function.update_self, neg_sub, map_sub, MvPolynomial.aeval_X,
              MvPolynomial.aeval_X, Function.update_self,
              Function.update_of_ne (Ne.symm hi₀), add_sub_cancel_right]
          · have hσ : σ j = j := Equiv.swap_apply_of_ne_of_ne hj1 hj2
            rw [hσ, Function.update_of_ne hj2, MvPolynomial.aeval_X,
              Function.update_of_ne hj1, MvPolynomial.aeval_X, Function.update_of_ne hj2,
              MvPolynomial.aeval_X, Function.update_of_ne hj1]
      have h_last_aut : ∀ θ : R₀ ≃ₐ[k] R₀,
          (∀ j : Fin d, j ≠ j_last → θ (MvPolynomial.X j) = MvPolynomial.X j) →
          (tr_Pd d).comp (A_aut θ) = tr_Pd d := by
        intro θ hfix
        have h1 := hA_Pd hIntP hDimP hOpen hAff_P hNe_P x_std hx_std_app θ (htb_θ θ)
        have h2 := hA_Pd hIntP hDimP hOpen hAff_P hNe_P x_std hx_std_app
          (AlgEquiv.refl : R₀ ≃ₐ[k] R₀) (htb_θ AlgEquiv.refl)
        have h_inv := weil_top_deg_kummer_last_coord_curve_norm_invariance k m d hmd n hn hUnit ζ hζ
          hCD hGenFree ι_P1 ι_aff hCoord tr_P1 tr_Pd hTrace F_push hPush_all
          Pd hIntP hDimP W_aff hAff_P hNe_P
          (fun i => MvPolynomial.aeval x_std (θ (MvPolynomial.X i)))
          (fun i => MvPolynomial.aeval x_std ((AlgEquiv.refl : R₀ ≃ₐ[k] R₀) (MvPolynomial.X i)))
          (htb_θ θ) (htb_θ AlgEquiv.refl)
          (fun j hj => by
            change MvPolynomial.aeval x_std (θ (MvPolynomial.X j)) =
              MvPolynomial.aeval x_std (MvPolynomial.X j)
            rw [hfix j hj])
        rw [h1, h2, hA_id, AddMonoidHom.comp_id] at h_inv
        exact h_inv
      have h_tr_Eli_pos : (tr_Pd d).comp (A_aut E_li_pos) = tr_Pd d :=
        h_last_aut E_li_pos (fun j hj => by
          change f_li_pos (MvPolynomial.X j) = MvPolynomial.X j
          rw [MvPolynomial.aeval_X, Function.update_of_ne hj])
      have h_tr_Eli_neg : (tr_Pd d).comp (A_aut E_li_neg) = tr_Pd d :=
        h_last_aut E_li_neg (fun j hj => by
          change f_li_neg (MvPolynomial.X j) = MvPolynomial.X j
          rw [MvPolynomial.aeval_X, Function.update_of_ne hj])
      have h_tr_Dneg : (tr_Pd d).comp (A_aut D_neg) = tr_Pd d :=
        h_last_aut D_neg (fun j hj => by
          change f_dneg (MvPolynomial.X j) = MvPolynomial.X j
          rw [MvPolynomial.aeval_X, Function.update_of_ne hj])
      
      have : NeZero n := ⟨by omega⟩
      let e_tr : weilEtaleTorsionH Pd.left n (2 * d) ≃+ ZMod n :=
        AddEquiv.ofBijective (tr_Pd d) (hTrace.2.1 d)
      let s_end : (weilEtaleTorsionH Pd.left n (2 * d) →+
          weilEtaleTorsionH Pd.left n (2 * d)) → ZMod n :=
        fun f => tr_Pd d (f (e_tr.symm 1))
      have hs_eval : ∀ (f : weilEtaleTorsionH Pd.left n (2 * d) →+
            weilEtaleTorsionH Pd.left n (2 * d))
          (u : weilEtaleTorsionH Pd.left n (2 * d)),
          tr_Pd d (f u) = s_end f * tr_Pd d u := by
        intro f u
        let z : ZMod n := tr_Pd d u
        have hz_eq : z.val • (1 : ZMod n) = z := by
          rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
        have hu_eq : u = z.val • e_tr.symm 1 := by
          apply e_tr.injective
          change tr_Pd d u = e_tr (z.val • e_tr.symm 1)
          rw [map_nsmul, e_tr.apply_symm_apply, hz_eq]
        calc
          tr_Pd d (f u) = tr_Pd d (f (z.val • e_tr.symm 1)) := by
            conv_lhs => rw [hu_eq]
          _ = z.val • s_end f := by
            rw [map_nsmul, map_nsmul]
          _ = (z.val : ZMod n) * s_end f := nsmul_eq_mul _ _
          _ = z * s_end f := by rw [ZMod.natCast_zmod_val]
          _ = s_end f * tr_Pd d u := mul_comm z (s_end f)
      have hs_id : s_end (AddMonoidHom.id _) = 1 :=
        e_tr.apply_symm_apply 1
      have hs_comp : ∀ f g : weilEtaleTorsionH Pd.left n (2 * d) →+
          weilEtaleTorsionH Pd.left n (2 * d),
          s_end (f.comp g) = s_end f * s_end g := by
        intro f g
        exact hs_eval f (g (e_tr.symm 1))
      have hs_of_tr_eq : ∀ f : weilEtaleTorsionH Pd.left n (2 * d) →+
          weilEtaleTorsionH Pd.left n (2 * d),
          (tr_Pd d).comp f = tr_Pd d → s_end f = 1 := by
        intro f hf
        calc
          s_end f = ((tr_Pd d).comp f) (e_tr.symm 1) := rfl
          _ = tr_Pd d (e_tr.symm 1) := by rw [hf]
          _ = 1 := e_tr.apply_symm_apply 1
      have hs_Eli_pos : s_end (A_aut E_li_pos) = 1 := hs_of_tr_eq _ h_tr_Eli_pos
      have hs_Eli_neg : s_end (A_aut E_li_neg) = 1 := hs_of_tr_eq _ h_tr_Eli_neg
      have hs_Dneg : s_end (A_aut D_neg) = 1 := hs_of_tr_eq _ h_tr_Dneg
      have hs_swap_sq : s_end (A_aut swap_alg) * s_end (A_aut swap_alg) = 1 := by
        rw [← hs_comp, ← hA_comp, h_swap_inv, hA_id, hs_id]
      have hs_conj : (s_end (A_aut swap_alg) * s_end (A_aut E_il)) *
          s_end (A_aut swap_alg) = 1 := by
        rw [← hs_comp, ← hA_comp, ← hs_comp, ← hA_comp, h_conj, hs_Eli_pos]
      have hs_Eil : s_end (A_aut E_il) = 1 := by
        calc
          s_end (A_aut E_il) = 1 * s_end (A_aut E_il) := (one_mul _).symm
          _ = (s_end (A_aut swap_alg) * s_end (A_aut swap_alg)) * s_end (A_aut E_il) := by
            rw [hs_swap_sq]
          _ = (s_end (A_aut swap_alg) * s_end (A_aut E_il)) * s_end (A_aut swap_alg) := by
            ring
          _ = 1 := hs_conj
      have hs_swap : s_end (A_aut swap_alg) = 1 := by
        calc
          s_end (A_aut swap_alg)
            = s_end (A_aut (D_neg.trans (E_il.trans (E_li_neg.trans E_il)))) := by
              rw [h_fac_swap]
          _ = s_end (A_aut D_neg) *
              (s_end (A_aut E_il) * (s_end (A_aut E_li_neg) * s_end (A_aut E_il))) := by
              rw [hA_comp, hA_comp, hA_comp, hs_comp, hs_comp, hs_comp]
          _ = 1 := by
              rw [hs_Dneg, hs_Eil, hs_Eli_neg, mul_one, mul_one, mul_one]
      have h_tr_swap : (tr_Pd d).comp (A_aut swap_alg) = tr_Pd d := by
        ext u
        change tr_Pd d (A_aut swap_alg u) = tr_Pd d u
        rw [hs_eval (A_aut swap_alg) u, hs_swap, one_mul]
      
      letI : Algebra k ↑(X.left.presheaf.obj (Opposite.op W)) := kAlg W
      let w₁' : Fin d → ↑(X.left.presheaf.obj (Opposite.op W)) :=
        fun i => MvPolynomial.aeval w₁ (swap_alg (MvPolynomial.X i))
      let w₂' : Fin d → ↑(X.left.presheaf.obj (Opposite.op W)) :=
        fun i => MvPolynomial.aeval w₂ (swap_alg (MvPolynomial.X i))
      have hw₁'_eq : w₁' = w₁ ∘ σ := by
        ext i
        change MvPolynomial.aeval w₁ (swap_alg (MvPolynomial.X i)) = w₁ (σ i)
        rw [h_swap_X, MvPolynomial.aeval_X]
      have hw₂'_eq : w₂' = w₂ ∘ σ := by
        ext i
        change MvPolynomial.aeval w₂ (swap_alg (MvPolynomial.X i)) = w₂ (σ i)
        rw [h_swap_X, MvPolynomial.aeval_X]
      have hw₁' : IsTranscendenceBasis k w₁' := by
        rw [hw₁'_eq]
        exact IsTranscendenceBasis.comp_equiv σ hw₁
      have hw₂' : IsTranscendenceBasis k w₂' := by
        rw [hw₂'_eq]
        exact IsTranscendenceBasis.comp_equiv σ hw₂
      have ht_w₁ : t_X W hW hNe w₁' hw₁' = t_X W hW hNe w₁ hw₁ := by
        change (tr_Pd d).comp (F_push X hInt hDim W hW hNe w₁' hw₁') =
          (tr_Pd d).comp (F_push X hInt hDim W hW hNe w₁ hw₁)
        rw [hA_nat X hInt hDim W hW hNe w₁ hw₁ swap_alg hw₁',
          ← AddMonoidHom.comp_assoc, h_tr_swap]
      have ht_w₂ : t_X W hW hNe w₂' hw₂' = t_X W hW hNe w₂ hw₂ := by
        change (tr_Pd d).comp (F_push X hInt hDim W hW hNe w₂' hw₂') =
          (tr_Pd d).comp (F_push X hInt hDim W hW hNe w₂ hw₂)
        rw [hA_nat X hInt hDim W hW hNe w₂ hw₂ swap_alg hw₂',
          ← AddMonoidHom.comp_assoc, h_tr_swap]
      have hAgree' : ∀ j : Fin d, j ≠ j_last → w₁' j = w₂' j := by
        intro j hj
        have hσj : σ j ≠ i₀ := by
          intro h_eq
          apply hj
          apply σ.injective
          rw [h_eq]
          exact (Equiv.swap_apply_right i₀ j_last).symm
        change MvPolynomial.aeval w₁ (swap_alg (MvPolynomial.X j)) =
          MvPolynomial.aeval w₂ (swap_alg (MvPolynomial.X j))
        rw [h_swap_X, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        exact hAgree (σ j) hσj
      have ht_w'_eq : t_X W hW hNe w₁' hw₁' = t_X W hW hNe w₂' hw₂' :=
        weil_top_deg_kummer_last_coord_curve_norm_invariance k m d hmd n hn hUnit ζ hζ
          hCD hGenFree ι_P1 ι_aff hCoord tr_P1 tr_Pd hTrace F_push hPush_all
          X hInt hDim W hW hNe w₁' w₂' hw₁' hw₂' hAgree'
      exact ht_w₁.symm.trans (ht_w'_eq.trans ht_w₂)
  · 
    intro δ hδ φ hφ_over hφ_free φ_shriek hφ_sh V hV hNeV U hU hNeU u hu hu'
    change ((tr_Pd d).comp (F_push X hInt hDim V hV hNeV u hu)).comp φ_shriek =
      (tr_Pd d).comp (F_push X hInt hDim U hU hNeU _ hu')
    rw [AddMonoidHom.comp_assoc]
    exact congrArg (tr_Pd d).comp
      (hPush_shriek X hInt hDim δ hδ φ hφ_over hφ_free φ_shriek hφ_sh V hV hNeV hU hNeU u hu hu')
  · 
    intro V hV hNeV ψ hEt hu
    obtain ⟨E, hAffE, hNeE, v_A, hv_et, hEt_comp, Φ_lift, hΦ_eq⟩ :=
      hPush_lift X hInt hDim V hV hNeV ψ hEt hu
    have : AlgebraicGeometry.IsAffine E := hAffE
    have : Nonempty ↥E := hNeE
    have hSurj :=
      weil_top_deg_kummer_polyP1_affine_etale_trace_surjective k m d hmd n hn hUnit ζ hζ
        hCD ι_P1 ι_aff hCoord tr_P1 tr_Pd hTrace E v_A hv_et hEt_comp
    intro c
    obtain ⟨z, hz⟩ := hSurj c
    refine ⟨Φ_lift z, ?_⟩
    change tr_Pd d (F_push X hInt hDim V hV hNeV (fun i => ψ (MvPolynomial.X i)) hu (Φ_lift z)) = c
    rw [hΦ_eq z]
    exact hz

theorem weil_etale_top_degree_finite_free_k_hom_smul (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (r δ : ℕ)
    (φ : Quiver.Hom X.left X.left)
    (hφ_over : CategoryTheory.CategoryStruct.comp φ X.hom = X.hom)
    (hφ_free : WeilTopDegFiniteLocallyFreeOfRank δ φ)
    (p_top : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+
      weilEtaleTorsionH X.left (ℓ ^ r) (2 * d))
    (hp_top : WeilTopDegTorsionPullback φ (ℓ ^ r) (2 * d) p_top)
    (w : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d)) :
    p_top w = δ • w :=
by
  obtain ⟨tr_pd, hBij_pd, _, _⟩ :=
    weil_etale_smooth_proper_torsion_poincare_duality k X hInt d ℓ hℓ
  rcases Nat.eq_zero_or_pos r with rfl | hr_pos
  · apply (hBij_pd 0).1
    have : Subsingleton (ZMod (ℓ ^ 0)) := by
      change Subsingleton (ZMod 1)
      infer_instance
    exact Subsingleton.elim _ _
  · let n : ℕ := ℓ ^ r
    have hPrime : Nat.Prime ℓ := Fact.out
    have hn2 : 2 ≤ n := by
      calc
        2 ≤ ℓ := hPrime.two_le
        _ = ℓ ^ 1 := (pow_one ℓ).symm
        _ ≤ ℓ ^ r := Nat.pow_le_pow_right hPrime.pos hr_pos
    have hn1 : 1 ≤ n := by omega
    have hℓ_ne_zero : (ℓ : k) ≠ 0 := by
      intro h0
      have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
      rcases CharP.char_is_prime_or_zero k (ringChar k) with hp_char | h0_char
      · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
        · exact hp_char.ne_one h1
        · exact hℓ heq.symm
      · rw [h0_char, zero_dvd_iff] at hdvd
        exact hPrime.ne_zero hdvd
    have hn_ne_zero : (n : k) ≠ 0 := by
      dsimp [n]
      rw [Nat.cast_pow]
      exact pow_ne_zero r hℓ_ne_zero
    have hUnit : IsUnit (n : k) := IsUnit.mk0 (n : k) hn_ne_zero
    have _ : NeZero (n : k) := ⟨hn_ne_zero⟩
    have hdeg_cyc : (Polynomial.cyclotomic n k).degree ≠ 0 := by
      rw [Polynomial.degree_cyclotomic n k]
      have htot : 0 < Nat.totient n := Nat.totient_pos.mpr (by omega)
      exact ne_of_gt (WithBot.coe_pos.mpr htot)
    obtain ⟨μ, hμ_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic n k) hdeg_cyc
    have hμ : IsPrimitiveRoot μ n :=
      (Polynomial.isRoot_cyclotomic_iff (R := k) (n := n)).mp hμ_root
    let ζ : kˣ := Units.mk0 μ (hμ.ne_zero (by omega))
    have hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n := hμ
    have hDim : topologicalKrullDim X.left = (d : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field k d X hInt
    have _ : AlgebraicGeometry.IsIntegral X.left := hInt
    obtain ⟨x₀⟩ : Nonempty ↥X.left := hInt.nonempty
    let y₀ : ↥X.left := φ.base x₀
    obtain ⟨hφ_fin, hφ_charts⟩ := hφ_free
    obtain ⟨V_free, hy₀_Vfree, hAff_Vfree, hAff_Ufree, M_free, hAddM, hModM,
      e_free, he_free, ⟨bM_free⟩⟩ := hφ_charts y₀
    let U_free : X.left.Opens := (TopologicalSpace.Opens.map φ.base).obj V_free
    have hx₀_Ufree : x₀ ∈ U_free := hy₀_Vfree
    have hNe_Ufree_sch : Nonempty ↥(U_free : AlgebraicGeometry.Scheme.{u}) :=
      ⟨⟨x₀, hx₀_Ufree⟩⟩
    have hDom_Ufree : IsDomain ↑(X.left.presheaf.obj (Opposite.op U_free)) :=
      @AlgebraicGeometry.IsIntegral.component_integral X.left hInt U_free hNe_Ufree_sch
    have hδ_pos : 1 ≤ δ := by
      by_contra hδ0
      have hδ_eq : δ = 0 := by omega
      subst hδ_eq
      let _ : AddCommGroup M_free := hAddM
      let _ : Module ↑(X.left.presheaf.obj (Opposite.op V_free)) M_free := hModM
      have hSubM : Subsingleton M_free := by
        refine ⟨fun m₁ m₂ => bM_free.repr.injective ?_⟩
        ext i
        exact Fin.elim0 i
      have hSubU : Subsingleton ↑(X.left.presheaf.obj (Opposite.op U_free)) :=
        e_free.symm.injective.subsingleton
      exact @false_of_nontrivial_of_subsingleton
        ↑(X.left.presheaf.obj (Opposite.op U_free)) hDom_Ufree.toNontrivial hSubU
    obtain ⟨hPush1, hPush2, hPush3, hPush4⟩ :=
      weil_top_deg_affine_finite_free_det_pushforward k n hn2 hUnit ζ hζ
    obtain ⟨⟨φ_shriek, hφ_shriek⟩, hUniq_shriek⟩ :=
      hPush1 δ (2 * d) hδ_pos X X φ hφ_over ⟨hφ_fin, hφ_charts⟩
    have hdeg : φ_shriek (p_top w) = δ • w :=
