      rw [Abelian.Ext.comp_assoc
          ((Abelian.Ext.mk₀ α_push₁).comp (Abelian.Ext.mapExactFunctor i_push₁ vZ₁) (Nat.zero_add a))
          vY₁ (Abelian.Ext.mk₀ (c_of Y)) hab (Nat.add_zero b) (by omega),
        hMod_Y,
        ← Abelian.Ext.comp_assoc
          ((Abelian.Ext.mk₀ α_push₁).comp (Abelian.Ext.mapExactFunctor i_push₁ vZ₁) (Nat.zero_add a))
          (Abelian.Ext.mk₀ (push_c_of B_i))
          (Abelian.Ext.mapExactFunctor (ρ_of Y) vY₀) (Nat.add_zero a) (Nat.zero_add b) hab,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ α_push₁)
          (Abelian.Ext.mapExactFunctor i_push₁ vZ₁)
          (Abelian.Ext.mk₀ (push_c_of B_i))
          (Nat.zero_add a) (Nat.add_zero a) (Nat.zero_add a),
        h_z_push,
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ α_push₁)
          (Abelian.Ext.mk₀ i_push_sc₁)
          (Abelian.Ext.mapExactFunctor (ρ_of Y) (Abelian.Ext.mapExactFunctor i_push₀ vZ₀))
          (Nat.zero_add 0) (Nat.zero_add a) (Nat.zero_add a),
        Abelian.Ext.mk₀_comp_mk₀, h_cancel_eq, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (push_c_of B_si))
          (Abelian.Ext.mk₀ ((ρ_of Y).map α_push₀))
          (Abelian.Ext.mapExactFunctor (ρ_of Y) (Abelian.Ext.mapExactFunctor i_push₀ vZ₀))
          (Nat.zero_add 0) (Nat.zero_add a) (Nat.zero_add a),
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (push_c_of B_si))
          ((Abelian.Ext.mk₀ ((ρ_of Y).map α_push₀)).comp
            (Abelian.Ext.mapExactFunctor (ρ_of Y) (Abelian.Ext.mapExactFunctor i_push₀ vZ₀))
            (Nat.zero_add a))
          (Abelian.Ext.mapExactFunctor (ρ_of Y) vY₀) (Nat.zero_add a) hab (by omega),
        Abelian.Ext.mapExactFunctor_comp (ρ_of Y) _ vY₀ hab,
        Abelian.Ext.mapExactFunctor_comp (ρ_of Y) (Abelian.Ext.mk₀ α_push₀) _ (Nat.zero_add a),
        Abelian.Ext.mapExactFunctor_mk₀]

    
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) s :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) si :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) si :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_s : CategoryTheory.Functor Z.Etale S.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s
    let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    let B_si : CategoryTheory.Functor Y.Etale S.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ si
    have hc_s : B_s.IsContinuous Z.smallEtaleTopology S.smallEtaleTopology := τ_Z_succ.hCont
    have hc_i : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := τ_Y_succ.hCont
    have hc_si : B_si.IsContinuous Y.smallEtaleTopology S.smallEtaleTopology := τ_SY_succ.hCont
    have hColim_s_ab := (hExactAb s hs hc_s).1
    have hColim_i_ab := (hExactAb i hi hc_i).1
    obtain ⟨hColim_si_ab, hEpi_si_fn⟩ := hExactAb si hsi_cl hc_si
    have hEpi_q_si_ab : Epi (q_ab_std B_si) :=
      hEpi_si_fn (T_of Y) (hT_of Y) (T_of S) (hT_of S)

    have he_Z1 : e_raw B_s m₁ a τ_Z_succ.val = α_Z_succ.val := (hCmp_iff τ_Z_succ α_Z_succ).mp hcmp_Z1
    have he_Z0 : e_raw B_s m₀ a τ_Z_curr.val =
        (weilGysinAbSupportTransition ℓ r a α_Z_succ).val :=
      (hCmp_iff τ_Z_curr _).mp hcmp_Z0
    have he_Y1 : e_raw B_i m₁ b τ_Y_succ.val = α_Y_succ.val := (hCmp_iff τ_Y_succ α_Y_succ).mp hcmp_Y1
    have he_Y0 : e_raw B_i m₀ b τ_Y_curr.val =
        (weilGysinAbSupportTransition ℓ r b α_Y_succ).val :=
      (hCmp_iff τ_Y_curr _).mp hcmp_Y0
    have he_SY1 : e_raw B_si m₁ c τ_SY_succ.val = α_SY_succ.val :=
      (hCmp_iff τ_SY_succ α_SY_succ).mp hcmp_SY1
    have he_SY0 : e_raw B_si m₀ c τ_SY_curr.val = α_SY_curr.val :=
      (hCmp_iff τ_SY_curr α_SY_curr).mp hcmp_SY0

    have htr_Z_val :
        (e_raw B_s m₁ a τ_Z_succ.val).comp
          (Abelian.Ext.mk₀
            ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map τ₀_cast))
          (Nat.add_zero a) = e_raw B_s m₀ a τ_Z_curr.val :=
      (congrArg
        (fun x => x.comp
          (Abelian.Ext.mk₀
            ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map τ₀_cast))
          (Nat.add_zero a))
        he_Z1).trans he_Z0.symm
    have htr_Y_val :
        (e_raw B_i m₁ b τ_Y_succ.val).comp
          (Abelian.Ext.mk₀
            ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map τ₀_cast))
          (Nat.add_zero b) = e_raw B_i m₀ b τ_Y_curr.val :=
      (congrArg
        (fun x => x.comp
          (Abelian.Ext.mk₀
            ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map τ₀_cast))
          (Nat.add_zero b))
        he_Y1).trans he_Y0.symm

    have hMod_Z := (hModBridge B_s hColim_s_ab a τ_Z_succ.val τ_Z_curr.val).mp htr_Z_val
    have hMod_Y := (hModBridge B_i hColim_i_ab b τ_Y_succ.val τ_Y_curr.val).mp htr_Y_val

    rcases hGys_succ with ⟨hAdd₁, hLim₁, hColim₁, T_S1, hT_S1, T_Z1, hT_Z1, T_Y1, hT_Y1,
      α_push₁, _, _, _, hq_α₁_raw, hvSY₁_raw⟩
    rcases hGys_curr with ⟨hAdd₀, hLim₀, hColim₀, T_S0, hT_S0, T_Z0, hT_Z0, T_Y0, hT_Y0,
      α_push₀, _, _, _, hq_α₀_raw, hvSY₀_raw⟩

    let i_push₁ := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
      Y.smallEtaleTopology Z.smallEtaleTopology
    let i_push₀ := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
      Y.smallEtaleTopology Z.smallEtaleTopology

    have hq_α₁ : q_mod_std B_si m₁ ≫ α_push₁ =
        q_mod_std B_i m₁ ≫ i_push₁.map (q_mod_std B_s m₁) :=
      (congrArg (· ≫ α_push₁) (hq_mod_indep B_si m₁ T_S1 hT_S1 T_Y1 hT_Y1).symm).trans
        (hq_α₁_raw.trans
          (congrArg₂
            (fun (f : One_of Y m₁ ⟶ i_push₁.obj (One_of Z m₁))
                (g : i_push₁.obj (One_of Z m₁) ⟶ _) => f ≫ g)
            (hq_mod_indep B_i m₁ T_Z1 hT_Z1 T_Y1 hT_Y1)
            (congrArg i_push₁.map (hq_mod_indep B_s m₁ T_S1 hT_S1 T_Z1 hT_Z1))))
    have hq_α₀ : q_mod_std B_si m₀ ≫ α_push₀ =
        q_mod_std B_i m₀ ≫ i_push₀.map (q_mod_std B_s m₀) :=
      (congrArg (· ≫ α_push₀) (hq_mod_indep B_si m₀ T_S0 hT_S0 T_Y0 hT_Y0).symm).trans
        (hq_α₀_raw.trans
          (congrArg₂
            (fun (f : One_of Y m₀ ⟶ i_push₀.obj (One_of Z m₀))
                (g : i_push₀.obj (One_of Z m₀) ⟶ _) => f ≫ g)
            (hq_mod_indep B_i m₀ T_Z0 hT_Z0 T_Y0 hT_Y0)
            (congrArg i_push₀.map (hq_mod_indep B_s m₀ T_S0 hT_S0 T_Z0 hT_Z0))))

    have hMod_SY := hGysSplice B_s B_i B_si hColim_si_ab hEpi_q_si_ab
      hAdd₁ hLim₁ hColim₁ hAdd₀ hLim₀ hColim₀
      α_push₁ α_push₀ τ_Z_succ.val τ_Z_curr.val τ_Y_succ.val τ_Y_curr.val
      τ_SY_succ.val τ_SY_curr.val
      hq_α₁ hq_α₀ hvSY₁_raw hvSY₀_raw hMod_Z hMod_Y

    have ab_supp_ext : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} {f : Quiver.Hom W₁ W₂} {m q : ℕ}
        {u₁ u₂ : WeilGysinAbSupportClass W₁ W₂ f m q},
        (u₁.val : weilGysinAbSupportExtGroup u₁) = (u₂.val : weilGysinAbSupportExtGroup u₁) →
        u₁ = u₂ := by
      intro W₁ W₂ f m q ⟨hc₁, v₁⟩ ⟨hc₂, v₂⟩ hv
      have hc : hc₁ = hc₂ := Subsingleton.elim _ _
      subst hc
      exact congrArg (WeilGysinAbSupportClass.mk hc₁) hv

    apply ab_supp_ext
    exact (congrArg
      (fun x => x.comp
        (Abelian.Ext.mk₀
          ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map τ₀_cast))
        (Nat.add_zero c))
      he_SY1.symm).trans
      (((hModBridge B_si hColim_si_ab c τ_SY_succ.val τ_SY_curr.val).mpr hMod_SY).trans he_SY0)

theorem weil_gysin_support_ext_and_ab_comparison_calculus (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ τ_iso : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
        [CategoryTheory.IsIso i] (r : ℕ), WeilGysinSupportClass Z Y i (ℓ ^ r) 0,
      ((∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
          letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
            CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
          letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
              (@AlgebraicGeometry.Etale) i :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
              (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
          let B : CategoryTheory.Functor Y.Etale Z.Etale :=
            CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
          B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology) ∧
        (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          [CategoryTheory.IsIso i'] [CategoryTheory.IsIso i] (r : ℕ),
          WeilGysinSupportPullback g i' i (ℓ ^ r) 0 (τ_iso i' r) (τ_iso i r)) ∧
        (∀ (S : AlgebraicGeometry.Scheme.{u}) (r : ℕ)
          (cl : weilEtaleTorsionH S (ℓ ^ r) 0),
          WeilGysinForgetsTo (τ_iso (CategoryTheory.CategoryStruct.id S) r) cl →
          ∃ θ₀ : weilEtaleModuleH S (ℓ ^ r) 0 →+ weilEtaleTorsionH S (ℓ ^ r) 0,
            WeilIsModuleToTorsionComparison S (ℓ ^ r) 0 θ₀ ∧
            cl = θ₀ (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S (ℓ ^ r))))) ∧
        (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y) [CategoryTheory.IsIso i],
          AlgebraicGeometry.IsClosedImmersion i →
          ∃ α_iso : ∀ r : ℕ, WeilGysinAbSupportClass Z Y i (ℓ ^ r) 0,
            (∀ r : ℕ, WeilGysinIsAbSupportComparison (τ_iso i r) (α_iso r)) ∧
            (∀ r : ℕ, weilGysinAbSupportTransition ℓ r 0 (α_iso (r + 1)) = α_iso r))) ∧
      ((∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          (g_Z : Quiver.Hom Z' Z),
          AlgebraicGeometry.IsClosedImmersion i →
          CategoryTheory.IsPullback i' g_Z g i →
          ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
            ∃ τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q,
              WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ) ∧
        (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y),
          AlgebraicGeometry.IsClosedImmersion i' →
          ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
            (τ'₁ τ'₂ : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q),
            WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₁ τ →
            WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₂ τ →
            τ'₁ = τ'₂) ∧
        (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
          (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
          WeilGysinSupportPullback (CategoryTheory.CategoryStruct.id Y) i i (ℓ ^ r) q τ τ) ∧
        (∀ {Z'' Y'' Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g₁ : Quiver.Hom Y'' Y') (g₂ : Quiver.Hom Y' Y)
          (i'' : Quiver.Hom Z'' Y'') (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          (r q : ℕ)
          (τ'' : WeilGysinSupportClass Z'' Y'' i'' (ℓ ^ r) q)
          (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
          (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
          WeilGysinSupportPullback g₁ i'' i' (ℓ ^ r) q τ'' τ' →
          WeilGysinSupportPullback g₂ i' i (ℓ ^ r) q τ' τ →
          WeilGysinSupportPullback (CategoryTheory.CategoryStruct.comp g₁ g₂)
            i'' i (ℓ ^ r) q τ'' τ) ∧
        (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
          (U : Y.Opens) (s_U : Quiver.Hom Z U.toScheme),
          AlgebraicGeometry.IsClosedImmersion i →
          CategoryTheory.CategoryStruct.comp s_U U.ι = i →
          ∀ (r q : ℕ) (τ_U : WeilGysinSupportClass Z U.toScheme s_U (ℓ ^ r) q),
            ∃! τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) q,
              WeilGysinSupportPullback U.ι s_U i (ℓ ^ r) q τ_U τ_Y)) ∧
      ((∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
          (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
          ∃! cl : weilEtaleTorsionH Y (ℓ ^ r) q, WeilGysinForgetsTo τ cl) ∧
        (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          (r q : ℕ)
          (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
          (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (cl' : weilEtaleTorsionH Y' (ℓ ^ r) q)
          (cl : weilEtaleTorsionH Y (ℓ ^ r) q)
          (p_g : weilEtaleTorsionH Y (ℓ ^ r) q →+ weilEtaleTorsionH Y' (ℓ ^ r) q),
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ →
          WeilGysinForgetsTo τ cl →
          WeilGysinForgetsTo τ' cl' →
          WeilLefschetzTorsionPullback g (ℓ ^ r) q p_g →
          p_g cl = cl') ∧
        (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (r q : ℕ),
          ∃! p_h : weilEtaleTorsionH W₂ (ℓ ^ r) q →+ weilEtaleTorsionH W₁ (ℓ ^ r) q,
            WeilLefschetzTorsionPullback h (ℓ ^ r) q p_h) ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (r q : ℕ),
          WeilLefschetzTorsionPullback (CategoryTheory.CategoryStruct.id W)
            (ℓ ^ r) q (AddMonoidHom.id _)) ∧
        (∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
          (h₁ : Quiver.Hom W₁ W₂) (h₂ : Quiver.Hom W₂ W₃) (r q : ℕ)
          (p₁ : weilEtaleTorsionH W₂ (ℓ ^ r) q →+ weilEtaleTorsionH W₁ (ℓ ^ r) q)
          (p₂ : weilEtaleTorsionH W₃ (ℓ ^ r) q →+ weilEtaleTorsionH W₂ (ℓ ^ r) q),
          WeilLefschetzTorsionPullback h₁ (ℓ ^ r) q p₁ →
          WeilLefschetzTorsionPullback h₂ (ℓ ^ r) q p₂ →
          WeilLefschetzTorsionPullback (CategoryTheory.CategoryStruct.comp h₁ h₂)
            (ℓ ^ r) q (p₁.comp p₂))) ∧
      ((∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
          {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
          (hsi : CategoryTheory.CategoryStruct.comp s i = si),
          AlgebraicGeometry.IsClosedImmersion s →
          AlgebraicGeometry.IsClosedImmersion i →
          AlgebraicGeometry.IsClosedImmersion si →
          ∀ {r a b c : ℕ} (hab : a + b = c)
            (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
            (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b),
            ∃! τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c,
              WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY) ∧
        (∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
          {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
          [CategoryTheory.IsIso s]
          (hsi : CategoryTheory.CategoryStruct.comp s i = si),
          AlgebraicGeometry.IsClosedImmersion i →
          AlgebraicGeometry.IsClosedImmersion si →
          ∀ (r b : ℕ)
            (τ_step : WeilGysinSupportClass Z Y i (ℓ ^ r) b)
            (τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) b),
            WeilGysinSupportPullback (CategoryTheory.CategoryStruct.id Y) i si (ℓ ^ r) b
              τ_step τ_SY →
            WeilGysinSupportGysinComp hsi (Nat.zero_add b) (τ_iso s r) τ_step τ_SY) ∧
        (∀ {S Z : AlgebraicGeometry.Scheme.{u}}
          {s : Quiver.Hom S Z} {i : Quiver.Hom Z Z}
          [CategoryTheory.IsIso i]
          (_hi_eq : i = CategoryTheory.CategoryStruct.id Z)
          (hsi : CategoryTheory.CategoryStruct.comp s i = s),
          AlgebraicGeometry.IsClosedImmersion s →
          ∀ (r a : ℕ) (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a),
            WeilGysinSupportGysinComp hsi (Nat.add_zero a) τ_Z (τ_iso i r) τ_Z) ∧
        (∀ {S Z₁ Z₂ Y : AlgebraicGeometry.Scheme.{u}}
          {s : Quiver.Hom S Z₁} {i₁ : Quiver.Hom Z₁ Z₂} {i₂ : Quiver.Hom Z₂ Y}
          {s₁ : Quiver.Hom S Z₂} {i₁₂ : Quiver.Hom Z₁ Y} {sy : Quiver.Hom S Y}
          (hs₁ : CategoryTheory.CategoryStruct.comp s i₁ = s₁)
          (hi₁₂ : CategoryTheory.CategoryStruct.comp i₁ i₂ = i₁₂)
          (hsy₁ : CategoryTheory.CategoryStruct.comp s₁ i₂ = sy)
          (hsy₂ : CategoryTheory.CategoryStruct.comp s i₁₂ = sy),
          AlgebraicGeometry.IsClosedImmersion s →
          AlgebraicGeometry.IsClosedImmersion i₁ →
          AlgebraicGeometry.IsClosedImmersion i₂ →
          AlgebraicGeometry.IsClosedImmersion s₁ →
          AlgebraicGeometry.IsClosedImmersion i₁₂ →
          AlgebraicGeometry.IsClosedImmersion sy →
          ∀ {r a b c ab bc abc : ℕ}
            (hab : a + b = ab) (hbc : b + c = bc)
            (hab_c : ab + c = abc) (ha_bc : a + bc = abc)
            (τ_S : WeilGysinSupportClass S Z₁ s (ℓ ^ r) a)
            (τ_Z₁ : WeilGysinSupportClass Z₁ Z₂ i₁ (ℓ ^ r) b)
            (τ_Z₂ : WeilGysinSupportClass Z₂ Y i₂ (ℓ ^ r) c)
            (τ_SZ₂ : WeilGysinSupportClass S Z₂ s₁ (ℓ ^ r) ab)
            (τ_Z₁Y : WeilGysinSupportClass Z₁ Y i₁₂ (ℓ ^ r) bc)
            (τ_L τ_R : WeilGysinSupportClass S Y sy (ℓ ^ r) abc),
            WeilGysinSupportGysinComp hs₁ hab τ_S τ_Z₁ τ_SZ₂ →
            WeilGysinSupportGysinComp hi₁₂ hbc τ_Z₁ τ_Z₂ τ_Z₁Y →
            WeilGysinSupportGysinComp hsy₁ hab_c τ_SZ₂ τ_Z₂ τ_L →
            WeilGysinSupportGysinComp hsy₂ ha_bc τ_S τ_Z₁Y τ_R →
