    intro W₁ W₂ B _ pb adj A₁ A₂ φ pf C₁ C₂ adj₁ adj₂ τ_h π₁ π₂
    have h_sq₀ : φ ≫ (adj₁.unit.app A₂ ≫ (C₁.obj A₂).obj.map τ_h.op) =
        (adj₁.unit.app A₁ ≫ (C₁.obj A₁).obj.map τ_h.op) ≫
          ((sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op (T_of W₂))).map (pf.map (C₁.map φ)) := by
      have hu : φ ≫ adj₁.unit.app A₂ =
          adj₁.unit.app A₁ ≫ (C₁.map φ).hom.app (Opposite.op (T_of W₁)) :=
        adj₁.unit.naturality φ
      have hm : (C₁.obj A₁).obj.map τ_h.op ≫ (C₁.map φ).hom.app (Opposite.op (B.obj (T_of W₂))) =
          (C₁.map φ).hom.app (Opposite.op (T_of W₁)) ≫ (C₁.obj A₂).obj.map τ_h.op :=
        (C₁.map φ).hom.naturality τ_h.op
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ _) hu).trans
          ((Category.assoc _ _ _).trans
            ((congrArg (adj₁.unit.app A₁ ≫ ·) hm.symm).trans
              (Category.assoc _ _ _).symm)))
    have h_sq₁ := Adjunction.homEquiv_naturality_right_square adj₂
      (Y := pf.obj (C₁.obj A₁)) (Y' := pf.obj (C₁.obj A₂))
      φ _ _ (pf.map (C₁.map φ)) h_sq₀
    exact Adjunction.homEquiv_naturality_right_square adj
      (Y := C₁.obj A₁) (Y' := C₁.obj A₂) (C₂.map φ) _ _ (C₁.map φ) h_sq₁

  
  
  
  have hSiteCompId : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (f : Z ⟶ Y) (g : Y ⟶ Z)
      (_hgf : g ≫ f = 𝟙 Y),
      ∃ e : weilEtaleSitePullback f ⋙ weilEtaleSitePullback g ≅ 𝟭 Y.Etale,
        ∀ U : Y.Etale,
          (e.hom.app U).left =
            Limits.pullback.fst (Limits.pullback.snd U.hom f) g ≫ Limits.pullback.fst U.hom f := by
    intro Z Y f g hgf
    let B_f : Y.Etale ⥤ Z.Etale := weilEtaleSitePullback f
    let B_g : Z.Etale ⥤ Y.Etale := weilEtaleSitePullback g
    let hom_U (U : Y.Etale) : B_g.obj (B_f.obj U) ⟶ U :=
      MorphismProperty.Over.homMk
        (Limits.pullback.fst (Limits.pullback.snd U.hom f) g ≫ Limits.pullback.fst U.hom f)
        ((Category.assoc _ _ U.hom).trans
          ((congrArg (Limits.pullback.fst (Limits.pullback.snd U.hom f) g ≫ ·)
            (Limits.pullback.condition (f := U.hom) (g := f))).trans
            ((Category.assoc _ (Limits.pullback.snd U.hom f) f).symm.trans
              ((congrArg (· ≫ f)
                (Limits.pullback.condition (f := Limits.pullback.snd U.hom f) (g := g))).trans
                ((Category.assoc _ g f).trans
                  ((congrArg (_ ≫ ·) hgf).trans (Category.comp_id _)))))))
    let inv_U (U : Y.Etale) : U ⟶ B_g.obj (B_f.obj U) :=
      let l₁ : U.left ⟶ Limits.pullback U.hom f :=
        Limits.pullback.lift (𝟙 U.left) (U.hom ≫ g)
          ((Category.id_comp U.hom).trans
            ((Category.comp_id U.hom).symm.trans
              ((congrArg (U.hom ≫ ·) hgf.symm).trans
                (Category.assoc U.hom g f).symm)))
      MorphismProperty.Over.homMk
        (Limits.pullback.lift l₁ U.hom (Limits.pullback.lift_snd _ _ _))
        (Limits.pullback.lift_snd _ _ _)
    let e : B_f ⋙ B_g ≅ 𝟭 Y.Etale :=
      NatIso.ofComponents
        (fun U =>
          { hom := hom_U U
            inv := inv_U U
            hom_inv_id := by
              apply MorphismProperty.Over.Hom.ext
              apply Limits.pullback.hom_ext
              · apply Limits.pullback.hom_ext
                · exact (congrArg (· ≫ _) (Category.assoc (hom_U U).left (inv_U U).left _)).trans
                    ((congrArg (fun k => ((hom_U U).left ≫ k) ≫ _)
                      (Limits.pullback.lift_fst _ _ _)).trans
                      ((Category.assoc (hom_U U).left _ _).trans
                        ((congrArg ((hom_U U).left ≫ ·)
                          (Limits.pullback.lift_fst _ _ _)).trans
                          ((Category.comp_id (hom_U U).left).trans
                            (congrArg (· ≫ _) (Category.id_comp _).symm)))))
                · exact (congrArg (· ≫ _) (Category.assoc (hom_U U).left (inv_U U).left _)).trans
                    ((congrArg (fun k => ((hom_U U).left ≫ k) ≫ _)
                      (Limits.pullback.lift_fst _ _ _)).trans
                      ((Category.assoc (hom_U U).left _ _).trans
                        ((congrArg ((hom_U U).left ≫ ·)
                          (Limits.pullback.lift_snd _ _ _)).trans
                          ((Category.assoc (hom_U U).left U.hom g).symm.trans
                            ((congrArg (· ≫ g) (MorphismProperty.Over.w (hom_U U))).trans
                              ((Limits.pullback.condition
                                (f := Limits.pullback.snd U.hom f) (g := g)).symm.trans
                                (congrArg (· ≫ _) (Category.id_comp _).symm)))))))
              · exact (Category.assoc (hom_U U).left (inv_U U).left _).trans
                  ((congrArg ((hom_U U).left ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
                    ((MorphismProperty.Over.w (hom_U U)).trans
                      (Category.id_comp _).symm))
            inv_hom_id := by
              apply MorphismProperty.Over.Hom.ext
              exact (Category.assoc (inv_U U).left _ _).symm.trans
                ((congrArg (· ≫ _) (Limits.pullback.lift_fst _ _ _)).trans
                  (Limits.pullback.lift_fst _ _ _)) })
        (fun {U₁ U₂} u => by
          apply MorphismProperty.Over.Hom.ext
          exact (Category.assoc ((B_g.map (B_f.map u)).left) _ _).symm.trans
            ((congrArg (· ≫ _) (Limits.pullback.lift_fst _ _ _)).trans
              ((Category.assoc _ ((B_f.map u).left) _).trans
                ((congrArg (_ ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
                  (Category.assoc _ _ u.left).symm))))
    exact ⟨e, fun _ => rfl⟩

  have iso_const_pushforward_inv : ∀ {𝒜 : Type (u + 1)} [Category.{u, u + 1} 𝒜]
      [∀ S : AlgebraicGeometry.Scheme.{u}, HasWeakSheafify S.smallEtaleTopology 𝒜]
      {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Z ⟶ Y) [IsIso i] (A : 𝒜),
      let B_i := weilEtaleSitePullback i
      letI : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := hContAll i
      let i_push := B_i.sheafPushforwardContinuous 𝒜 Y.smallEtaleTopology Z.smallEtaleTopology
      let One_Y := (constantSheaf Y.smallEtaleTopology 𝒜).obj A
      let One_Z := (constantSheaf Z.smallEtaleTopology 𝒜).obj A
      let adj_Y0 := constantSheafAdj Y.smallEtaleTopology 𝒜 (hT_of Y)
      let adj_Z0 := constantSheafAdj Z.smallEtaleTopology 𝒜 (hT_of Z)
      let q_i0 : One_Y ⟶ i_push.obj One_Z :=
        (adj_Y0.homEquiv A (i_push.obj One_Z)).symm
          (adj_Z0.unit.app A ≫ One_Z.obj.map ((hT_of Z).from (B_i.obj (T_of Y))).op)
      ∃ p_i : i_push.obj One_Z ⟶ One_Y,
        q_i0 ≫ p_i = 𝟙 One_Y ∧ p_i ≫ q_i0 = 𝟙 (i_push.obj One_Z) := by
    intro 𝒜 _ _ Z Y i _ A B_i i_push One_Y One_Z adj_Y0 adj_Z0 q_i0
    have _ : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := hContAll i
    let j : Y ⟶ Z := inv i
    have hij : i ≫ j = 𝟙 Z := IsIso.hom_inv_id i
    have hji : j ≫ i = 𝟙 Y := IsIso.inv_hom_id i
    let B_j := weilEtaleSitePullback j
    have _ : B_j.IsContinuous Z.smallEtaleTopology Y.smallEtaleTopology := hContAll j
    let j_push := B_j.sheafPushforwardContinuous 𝒜 Z.smallEtaleTopology Y.smallEtaleTopology
    obtain ⟨e_Y, he_Y⟩ := hSiteCompId i j hji
    obtain ⟨e_Z, he_Z⟩ := hSiteCompId j i hij
    have h_tri_hom : ∀ U : Y.Etale, B_i.map (e_Y.hom.app U) = e_Z.hom.app (B_i.obj U) := by
      intro U
      apply MorphismProperty.Over.Hom.ext
      apply Limits.pullback.hom_ext
      · exact (Limits.pullback.lift_fst _ _ _).trans
          ((congrArg (_ ≫ ·) (he_Y U)).trans
            ((Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ Limits.pullback.fst U.hom i) (he_Z (B_i.obj U)).symm)))
      · exact (Limits.pullback.lift_snd _ _ _).trans
          (MorphismProperty.Over.w (e_Z.hom.app (B_i.obj U))).symm
    have h_tri_inv : ∀ U : Y.Etale, B_i.map (e_Y.inv.app U) = e_Z.inv.app (B_i.obj U) := by
      intro U
      have h1 : B_i.map (e_Y.inv.app U) ≫ e_Z.hom.app (B_i.obj U) = 𝟙 (B_i.obj U) :=
        (congrArg (B_i.map (e_Y.inv.app U) ≫ ·) (h_tri_hom U).symm).trans
          ((B_i.map_comp _ _).symm.trans
            ((congrArg B_i.map (e_Y.inv_hom_id_app U)).trans (B_i.map_id U)))
      exact inv_uniq_et h1 (e_Z.hom_inv_id_app (B_i.obj U))
    let η_Y_hom (ℱ : Sheaf Y.smallEtaleTopology 𝒜) : i_push.obj (j_push.obj ℱ) ⟶ ℱ :=
      ⟨{ app := fun U => ℱ.obj.map (e_Y.inv.app U.unop).op
         naturality := fun {U₁ U₂} f => by
           change ℱ.obj.map (B_j.map (B_i.map f.unop)).op ≫ ℱ.obj.map (e_Y.inv.app U₂.unop).op =
             ℱ.obj.map (e_Y.inv.app U₁.unop).op ≫ ℱ.obj.map f
           rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← op_comp]
           have hnat := (e_Y.inv.naturality f.unop).symm
           change (e_Y.inv.app U₂.unop ≫ B_j.map (B_i.map f.unop)) =
             f.unop ≫ e_Y.inv.app U₁.unop at hnat
           rw [hnat, op_comp]
           rfl }⟩
    let η_Z_hom (𝒢 : Sheaf Z.smallEtaleTopology 𝒜) : j_push.obj (i_push.obj 𝒢) ⟶ 𝒢 :=
      ⟨{ app := fun W => 𝒢.obj.map (e_Z.inv.app W.unop).op
         naturality := fun {W₁ W₂} f => by
           change 𝒢.obj.map (B_i.map (B_j.map f.unop)).op ≫ 𝒢.obj.map (e_Z.inv.app W₂.unop).op =
             𝒢.obj.map (e_Z.inv.app W₁.unop).op ≫ 𝒢.obj.map f
           rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp]
           have hnat := (e_Z.inv.naturality f.unop).symm
           change (e_Z.inv.app W₂.unop ≫ B_i.map (B_j.map f.unop)) =
             f.unop ≫ e_Z.inv.app W₁.unop at hnat
           rw [hnat, op_comp]
           rfl }⟩
    have hη_Y_nat : ∀ {ℱ₁ ℱ₂ : Sheaf Y.smallEtaleTopology 𝒜} (u : ℱ₁ ⟶ ℱ₂),
        i_push.map (j_push.map u) ≫ η_Y_hom ℱ₂ = η_Y_hom ℱ₁ ≫ u := by
      intro ℱ₁ ℱ₂ u
      apply sheaf_hom_eq; intro U
      exact (u.hom.naturality (e_Y.inv.app U.unop).op).symm
    have hη_tri : ∀ 𝒢 : Sheaf Z.smallEtaleTopology 𝒜,
        η_Y_hom (i_push.obj 𝒢) = i_push.map (η_Z_hom 𝒢) := by
      intro 𝒢
      apply sheaf_hom_eq; intro U
      change 𝒢.obj.map (B_i.map (e_Y.inv.app U.unop)).op =
        𝒢.obj.map (e_Z.inv.app (B_i.obj U.unop)).op
      rw [h_tri_inv U.unop]
    let q_j0 : One_Z ⟶ j_push.obj One_Y :=
      (adj_Z0.homEquiv A (j_push.obj One_Y)).symm
        (adj_Y0.unit.app A ≫ One_Y.obj.map ((hT_of Y).from (B_j.obj (T_of Z))).op)
    let p_i : i_push.obj One_Z ⟶ One_Y := i_push.map q_j0 ≫ η_Y_hom One_Y
    let p_j : j_push.obj One_Y ⟶ One_Z := j_push.map q_i0 ≫ η_Z_hom One_Z
    have h_qp_gen : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (f₁ : W₁ ⟶ W₂) (f₂ : W₂ ⟶ W₁)
        (e_W : weilEtaleSitePullback f₁ ⋙ weilEtaleSitePullback f₂ ≅ 𝟭 W₂.Etale),
        let Bf₁ := weilEtaleSitePullback f₁
        let Bf₂ := weilEtaleSitePullback f₂
        letI : Bf₁.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := hContAll f₁
        letI : Bf₂.IsContinuous W₁.smallEtaleTopology W₂.smallEtaleTopology := hContAll f₂
        let pf₁ := Bf₁.sheafPushforwardContinuous 𝒜 W₂.smallEtaleTopology W₁.smallEtaleTopology
        let pf₂ := Bf₂.sheafPushforwardContinuous 𝒜 W₁.smallEtaleTopology W₂.smallEtaleTopology
        let O₁ := (constantSheaf W₁.smallEtaleTopology 𝒜).obj A
        let O₂ := (constantSheaf W₂.smallEtaleTopology 𝒜).obj A
        let a₁ := constantSheafAdj W₁.smallEtaleTopology 𝒜 (hT_of W₁)
        let a₂ := constantSheafAdj W₂.smallEtaleTopology 𝒜 (hT_of W₂)
        let q₁ : O₂ ⟶ pf₁.obj O₁ :=
          (a₂.homEquiv A (pf₁.obj O₁)).symm
            (a₁.unit.app A ≫ O₁.obj.map ((hT_of W₁).from (Bf₁.obj (T_of W₂))).op)
        let q₂ : O₁ ⟶ pf₂.obj O₂ :=
          (a₁.homEquiv A (pf₂.obj O₂)).symm
            (a₂.unit.app A ≫ O₂.obj.map ((hT_of W₂).from (Bf₂.obj (T_of W₁))).op)
        let η_O₂ : pf₁.obj (pf₂.obj O₂) ⟶ O₂ :=
          ⟨{ app := fun U => O₂.obj.map (e_W.inv.app U.unop).op
             naturality := fun {U₁ U₂} f => by
               change O₂.obj.map (Bf₂.map (Bf₁.map f.unop)).op ≫ O₂.obj.map (e_W.inv.app U₂.unop).op =
                 O₂.obj.map (e_W.inv.app U₁.unop).op ≫ O₂.obj.map f
               rw [← O₂.obj.map_comp, ← O₂.obj.map_comp, ← op_comp]
               have hnat := (e_W.inv.naturality f.unop).symm
               change (e_W.inv.app U₂.unop ≫ Bf₂.map (Bf₁.map f.unop)) =
                 f.unop ≫ e_W.inv.app U₁.unop at hnat
               rw [hnat, op_comp]; rfl }⟩
        q₁ ≫ (pf₁.map q₂ ≫ η_O₂) = 𝟙 O₂ := by
      intro W₁ W₂ f₁ f₂ e_W Bf₁ Bf₂ pf₁ pf₂ O₁ O₂ a₁ a₂ q₁ q₂ η_O₂
      have _ : Bf₁.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := hContAll f₁
      have _ : Bf₂.IsContinuous W₁.smallEtaleTopology W₂.smallEtaleTopology := hContAll f₂
      apply (a₂.homEquiv A O₂).injective
      let τ₁ : Bf₁.obj (T_of W₂) ⟶ T_of W₁ := (hT_of W₁).from (Bf₁.obj (T_of W₂))
      let τ₂ : Bf₂.obj (T_of W₁) ⟶ T_of W₂ := (hT_of W₂).from (Bf₂.obj (T_of W₁))
      have h1 := Adjunction.homEquiv_naturality_right a₂ q₁ (pf₁.map q₂ ≫ η_O₂)
      have hq₁ : a₂.homEquiv A (pf₁.obj O₁) q₁ = a₁.unit.app A ≫ O₁.obj.map τ₁.op :=
        Equiv.apply_symm_apply _ _
      have hq₂ : a₁.unit.app A ≫ q₂.hom.app (Opposite.op (T_of W₁)) =
          a₂.unit.app A ≫ O₂.obj.map τ₂.op :=
        (Adjunction.homEquiv_unit a₁ A (pf₂.obj O₂) q₂).symm.trans
          ((a₁.homEquiv A (pf₂.obj O₂)).apply_symm_apply _)
      have hnat_q₂ : O₁.obj.map τ₁.op ≫ q₂.hom.app (Opposite.op (Bf₁.obj (T_of W₂))) =
          q₂.hom.app (Opposite.op (T_of W₁)) ≫ O₂.obj.map (Bf₂.map τ₁).op :=
        q₂.hom.naturality τ₁.op
      have hop : τ₂.op ≫ ((Bf₂.map τ₁).op ≫ (e_W.inv.app (T_of W₂)).op) =
          𝟙 (Opposite.op (T_of W₂)) :=
        (congrArg (τ₂.op ≫ ·) op_comp.symm).trans
          (op_comp.symm.trans
            (congrArg Quiver.Hom.op ((hT_of W₂).hom_ext _ (𝟙 (T_of W₂)))))
      have h_map_id :
          O₂.obj.map τ₂.op ≫
            (O₂.obj.map (Bf₂.map τ₁).op ≫ O₂.obj.map (e_W.inv.app (T_of W₂)).op) =
          𝟙 (O₂.obj.obj (Opposite.op (T_of W₂))) :=
        (congrArg (O₂.obj.map τ₂.op ≫ ·) (O₂.obj.map_comp _ _).symm).trans
          ((O₂.obj.map_comp _ _).symm.trans
            ((congrArg O₂.obj.map hop).trans (O₂.obj.map_id _)))
      let m_e := O₂.obj.map (e_W.inv.app (T_of W₂)).op
      let m₂₁ := O₂.obj.map (Bf₂.map τ₁).op
      have h_mid :
          (a₁.unit.app A ≫ O₁.obj.map τ₁.op) ≫
            (q₂.hom.app (Opposite.op (Bf₁.obj (T_of W₂))) ≫ m_e) =
          a₂.unit.app A ≫ 𝟙 _ :=
        (Category.assoc (a₁.unit.app A) (O₁.obj.map τ₁.op) _).trans
          ((congrArg (a₁.unit.app A ≫ ·)
            (Category.assoc (O₁.obj.map τ₁.op) _ m_e).symm).trans
            ((congrArg (fun k => a₁.unit.app A ≫ (k ≫ m_e)) hnat_q₂).trans
              ((congrArg (a₁.unit.app A ≫ ·)
                (Category.assoc (q₂.hom.app (Opposite.op (T_of W₁))) m₂₁ m_e)).trans
                ((Category.assoc (a₁.unit.app A) _ (m₂₁ ≫ m_e)).symm.trans
                  ((congrArg (· ≫ (m₂₁ ≫ m_e)) hq₂).trans
                    ((Category.assoc (a₂.unit.app A) (O₂.obj.map τ₂.op) _).trans
                      (congrArg (a₂.unit.app A ≫ ·) h_map_id)))))))
      exact h1.trans
        ((congrArg (· ≫ _) hq₁).trans
          (h_mid.trans (Adjunction.homEquiv_unit a₂ A O₂ (𝟙 O₂)).symm))
    have hqp_i : q_i0 ≫ p_i = 𝟙 One_Y := h_qp_gen i j e_Y
    have hqp_j : q_j0 ≫ p_j = 𝟙 One_Z := h_qp_gen j i e_Z
    have hpq_i : p_i ≫ q_i0 = 𝟙 (i_push.obj One_Z) := by
      dsimp only [p_i]
      rw [Category.assoc, ← hη_Y_nat q_i0, hη_tri One_Z, ← i_push.map_comp, ← i_push.map_comp]
      change i_push.map (q_j0 ≫ p_j) = _
      rw [hqp_j, i_push.map_id]
    exact ⟨p_i, hqp_i, hpq_i⟩

  
  have hq_intertwine : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}}
      (B : Y.Etale ⥤ Z.Etale) [B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology] (m : ℕ),
      let R := ULift.{u, 0} (ZMod m)
      let R_mod := ModuleCat.of R R
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let i_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology Z.smallEtaleTopology
      let i_push_mod := B.sheafPushforwardContinuous (ModuleCat.{u, u} R)
        Y.smallEtaleTopology Z.smallEtaleTopology
      let Fℤ_Z := (constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let adj_ab_Y := constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} (hT_of Y)
      let adj_ab_Z := constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} (hT_of Z)
      let adj_mod_Y := constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Y)
      let adj_mod_Z := constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Z)
      let τ_i := (hT_of Z).from (B.obj (T_of Y))
      let q_ab := (adj_ab_Y.homEquiv Aℤ (i_push_ab.obj Fℤ_Z)).symm
        (adj_ab_Z.unit.app Aℤ ≫ Fℤ_Z.obj.map τ_i.op)
      let q_mod := (adj_mod_Y.homEquiv R_mod (i_push_mod.obj (One_of Z m))).symm
        (adj_mod_Z.unit.app R_mod ≫ (One_of Z m).obj.map τ_i.op)
      q_ab ≫ (i_push_ab.map (ιℤ_std Z m) ≫ (γ_pf B m (One_of Z m)).hom) =
        ιℤ_std Y m ≫ (U_of Y m).map q_mod := by
    intro Z Y B _ m R R_mod Aℤ i_push_ab i_push_mod Fℤ_Z
      adj_ab_Y adj_ab_Z adj_mod_Y adj_mod_Z τ_i q_ab q_mod
    let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let mor_Z := i_push_ab.map (ιℤ_std Z m) ≫ (γ_pf B m (One_of Z m)).hom
    apply (adj_ab_Y.homEquiv Aℤ ((U_of Y m).obj (i_push_mod.obj (One_of Z m)))).injective
    have hL : adj_ab_Y.homEquiv Aℤ _ (q_ab ≫ mor_Z) =
        (z_to_m_of m ≫ ιM_of m ≫ u₀_of Z m) ≫
          F_fg.map ((One_of Z m).obj.map τ_i.op) := by
      have h1 := Adjunction.homEquiv_naturality_right adj_ab_Y q_ab mor_Z
      have hq_ev : adj_ab_Y.homEquiv Aℤ (i_push_ab.obj Fℤ_Z) q_ab =
          adj_ab_Z.unit.app Aℤ ≫ Fℤ_Z.obj.map τ_i.op := Equiv.apply_symm_apply _ _
      have hnat : Fℤ_Z.obj.map τ_i.op ≫
          (ιℤ_std Z m).hom.app (Opposite.op (B.obj (T_of Y))) =
          (ιℤ_std Z m).hom.app (Opposite.op (T_of Z)) ≫
            F_fg.map ((One_of Z m).obj.map τ_i.op) :=
        (ιℤ_std Z m).hom.naturality τ_i.op
      have hιZ : adj_ab_Z.unit.app Aℤ ≫ (ιℤ_std Z m).hom.app (Opposite.op (T_of Z)) =
          z_to_m_of m ≫ ιM_of m ≫ u₀_of Z m :=
        (Adjunction.homEquiv_unit adj_ab_Z Aℤ _ (ιℤ_std Z m)).symm.trans (h_ιℤ_std_ev Z m)
      exact h1.trans
        ((congrArg₂ CategoryStruct.comp hq_ev
          (Category.comp_id ((ιℤ_std Z m).hom.app (Opposite.op (B.obj (T_of Y)))))).trans
          ((Category.assoc _ _ _).trans
            ((congrArg (adj_ab_Z.unit.app Aℤ ≫ ·) hnat).trans
              ((Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ F_fg.map ((One_of Z m).obj.map τ_i.op)) hιZ)))))
    have hR : adj_ab_Y.homEquiv Aℤ _ (ιℤ_std Y m ≫ (U_of Y m).map q_mod) =
        (z_to_m_of m ≫ ιM_of m ≫ u₀_of Z m) ≫
          F_fg.map ((One_of Z m).obj.map τ_i.op) := by
      have h2 := Adjunction.homEquiv_naturality_right adj_ab_Y (ιℤ_std Y m) ((U_of Y m).map q_mod)
      have hq_mod : adj_mod_Y.unit.app R_mod ≫ q_mod.hom.app (Opposite.op (T_of Y)) =
          adj_mod_Z.unit.app R_mod ≫ (One_of Z m).obj.map τ_i.op :=
        (Adjunction.homEquiv_unit adj_mod_Y R_mod _ q_mod).symm.trans
          ((adj_mod_Y.homEquiv R_mod (i_push_mod.obj (One_of Z m))).apply_symm_apply _)
      have huq : u₀_of Y m ≫ F_fg.map (q_mod.hom.app (Opposite.op (T_of Y))) =
          u₀_of Z m ≫ F_fg.map ((One_of Z m).obj.map τ_i.op) :=
        (F_fg.map_comp _ _).symm.trans ((congrArg F_fg.map hq_mod).trans (F_fg.map_comp _ _))
      exact h2.trans
        ((congrArg (· ≫ F_fg.map (q_mod.hom.app (Opposite.op (T_of Y)))) (h_ιℤ_std_ev Y m)).trans
          ((Category.assoc (z_to_m_of m) _ _).trans
            ((congrArg (z_to_m_of m ≫ ·) (Category.assoc (ιM_of m) _ _)).trans
              ((congrArg (fun k => z_to_m_of m ≫ (ιM_of m ≫ k)) huq).trans
                ((congrArg (z_to_m_of m ≫ ·) (Category.assoc (ιM_of m) _ _).symm).trans
                  (Category.assoc (z_to_m_of m) _ _).symm)))))
    exact hL.trans hR.symm

  
  let cl_std_of {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (τ : WeilGysinSupportClass Z Y i m q) : weilEtaleTorsionH Y m q :=
    let _ := hAdd_U Y m
    let _ := (hLim_U Y m).1
    let _ := (hLim_U Y m).2
    let R := ULift.{u, 0} (ZMod m)
    let R_mod := ModuleCat.of R R
    let B_i : Y.Etale ⥤ Z.Etale := weilEtaleSitePullback i
    letI : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := τ.hCont
    let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R)
      Y.smallEtaleTopology Z.smallEtaleTopology
    let adj_Y0 := constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Y)
    let adj_Z0 := constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Z)
    let q_i0 : One_of Y m ⟶ i_push.obj (One_of Z m) :=
      (adj_Y0.homEquiv R_mod (i_push.obj (One_of Z m))).symm
        (adj_Z0.unit.app R_mod ≫ (One_of Z m).obj.map ((hT_of Z).from (B_i.obj (T_of Y))).op)
    let Fℤ_Y := (constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    (Abelian.Ext.mk₀ (βM_of Y m)).postcomp Fℤ_Y (Nat.add_zero q)
      ((Abelian.Ext.mk₀ (ιℤ_std Y m)).comp
        (((U_of Y m).mapExtAddHom (One_of Y m) (One_of Y m) q)
          ((Abelian.Ext.mk₀ q_i0).comp τ.val (Nat.zero_add q)))
        (Nat.zero_add q))

  have hForgets_iff : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (τ : WeilGysinSupportClass Z Y i m q) (cl : weilEtaleTorsionH Y m q),
      WeilGysinForgetsTo τ cl ↔ cl = cl_std_of τ := by
    intro Z Y i m q τ cl
    let R := ULift.{u, 0} (ZMod m)
    let R_mod := ModuleCat.of R R
    let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let B_i : Y.Etale ⥤ Z.Etale := weilEtaleSitePullback i
    have _ : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := τ.hCont
    let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R)
      Y.smallEtaleTopology Z.smallEtaleTopology
    let Fℤ_Y := (constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    refine ⟨fun hfg => ?_, fun hcl => ?_⟩
    · rcases hfg with ⟨U, hU_obj, hU_map, hAdd, hLim, hColim,
        T_Y, hT_Y, T_Z, hT_Z, u_unit, hu_unit, πM, hαπ, hπα, hcl_eq⟩
      have hU_eq : U = U_of Y m := by
        have hmap := @hU_map
        rcases U with ⟨o₁, m₁, i₁, c₁⟩
        have ho : o₁ = (U_of Y m).obj := funext fun ℱ => sheaf_eq_of_obj_eq (hU_obj ℱ)
        subst ho
        refine CategoryTheory.Functor.ext (fun _ => rfl) (fun ℱ₁ ℱ₂ f => ?_)
        rw [eqToHom_refl, eqToHom_refl, Category.id_comp, Category.comp_id]
        apply sheaf_hom_eq; intro W; exact eq_of_heq (hmap f W)
      subst hU_eq
      have : hAdd = hAdd_U Y m := Subsingleton.elim _ _; subst this
      have : hLim = (hLim_U Y m).1 := Subsingleton.elim _ _; subst this
      have : hColim = (hLim_U Y m).2 := Subsingleton.elim _ _; subst this
      have hu_eq : u_unit = F_fg.map ((constantSheafAdj Y.smallEtaleTopology
          (ModuleCat.{u, u} R) hT_Y).unit.app R_mod) := eq_of_heq hu_unit
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let αM_wit : weilEtaleTorsionSheaf Y m ⟶ (U_of Y m).obj (One_of Y m) :=
        ((constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y).homEquiv
          AM ((U_of Y m).obj (One_of Y m))).symm (ιM_of m ≫ u_unit)
      have hα_eq : αM_wit = αM_of Y m := by
        dsimp only [αM_wit]; rw [hu_eq]; exact hαM_indep Y m T_Y hT_Y
      have hπ_eq : πM = βM_of Y m := inv_uniq (hα_eq ▸ hπα) (hαβ_of Y m)
      have hιℤ_eq : (constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map (z_to_m_of m) ≫
          αM_wit = ιℤ_std Y m := congrArg _ hα_eq
      have hq_eq := hq_indep B_i hT_Y (hT_of Y) hT_Z (hT_of Z) R_mod
      have _ := hAdd_U Y m; have _ := (hLim_U Y m).1; have _ := (hLim_U Y m).2
      let mk_cl (p : (U_of Y m).obj (One_of Y m) ⟶ weilEtaleTorsionSheaf Y m)
          (z : Fℤ_Y ⟶ (U_of Y m).obj (One_of Y m))
          (q_m : One_of Y m ⟶ i_push.obj (One_of Z m)) : weilEtaleTorsionH Y m q :=
        (Abelian.Ext.mk₀ p).postcomp Fℤ_Y (Nat.add_zero q)
          ((Abelian.Ext.mk₀ z).comp
            (((U_of Y m).mapExtAddHom (One_of Y m) (One_of Y m) q)
              ((Abelian.Ext.mk₀ q_m).comp τ.val (Nat.zero_add q)))
            (Nat.zero_add q))
      exact hcl_eq.trans
        ((congrArg (fun p => mk_cl p _ _) hπ_eq).trans
          (congrArg₂ (mk_cl (βM_of Y m)) hιℤ_eq hq_eq))
    · rw [hcl]
      refine ⟨U_of Y m, fun _ => rfl, fun _ _ => HEq.rfl,
        hAdd_U Y m, (hLim_U Y m).1, (hLim_U Y m).2,
        T_of Y, hT_of Y, T_of Z, hT_of Z, u₀_of Y m, HEq.rfl,
        βM_of Y m, hαβ_of Y m, hβα_of Y m, rfl⟩

  
  have hForgets_eq_ab : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (τ : WeilGysinSupportClass Z Y i m q)
      (α : WeilGysinAbSupportClass Z Y i m q)
      (cl : weilEtaleTorsionH Y m q),
      WeilGysinIsAbSupportComparison τ α →
      WeilGysinForgetsTo τ cl →
      let B_i : Y.Etale ⥤ Z.Etale := weilEtaleSitePullback i
      letI : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := α.hCont
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let i_push_ab := B_i.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology Z.smallEtaleTopology
      let Fℤ_Z := (constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let adj_ab_Y := constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} (hT_of Y)
      let adj_ab_Z := constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} (hT_of Z)
      let q_ab0 := (adj_ab_Y.homEquiv Aℤ (i_push_ab.obj Fℤ_Z)).symm
        (adj_ab_Z.unit.app Aℤ ≫ Fℤ_Z.obj.map ((hT_of Z).from (B_i.obj (T_of Y))).op)
      cl = (Abelian.Ext.mk₀ q_ab0).comp α.val (Nat.zero_add q) := by
    intro Z Y i m q τ α cl hcmp hfg B_i Aℤ i_push_ab Fℤ_Z adj_ab_Y adj_ab_Z q_ab0
    have hcl_std := (hForgets_iff τ cl).mp hfg
    have hc_eq : α.hCont = τ.hCont := Subsingleton.elim _ _
    cases hc_eq
    have _ : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := τ.hCont
    let R := ULift.{u, 0} (ZMod m)
    let R_mod := ModuleCat.of R R
    let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let i_push_mod := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R)
      Y.smallEtaleTopology Z.smallEtaleTopology
    rcases hcmp with ⟨U_Y, U_Z, hUY_obj, hUY_map, hUZ_obj, hUZ_map,
      hAdd, hLim, hColim, T_Y, hT_Y, T_Z, hT_Z,
      u_unit_Y, u_unit_Z, γ_push, hu_Y, hu_Z, hγ_app, πM_Y, hαπ_Y, hπα_Y, hα_val⟩
    have hUY_eq : U_Y = U_of Y m := by
      have hmap := @hUY_map
      rcases U_Y with ⟨o₁, m₁, i₁, c₁⟩
      have ho : o₁ = (U_of Y m).obj := funext fun ℱ => sheaf_eq_of_obj_eq (hUY_obj ℱ)
      subst ho
      refine CategoryTheory.Functor.ext (fun _ => rfl) (fun ℱ₁ ℱ₂ f => ?_)
      rw [eqToHom_refl, eqToHom_refl, Category.id_comp, Category.comp_id]
      apply sheaf_hom_eq; intro W; exact eq_of_heq (hmap f W)
    have hUZ_eq : U_Z = U_of Z m := by
      have hmap := @hUZ_map
      rcases U_Z with ⟨o₁, m₁, i₁, c₁⟩
      have ho : o₁ = (U_of Z m).obj := funext fun 𝒢 => sheaf_eq_of_obj_eq (hUZ_obj 𝒢)
      subst ho
      refine CategoryTheory.Functor.ext (fun _ => rfl) (fun 𝒢₁ 𝒢₂ f => ?_)
      rw [eqToHom_refl, eqToHom_refl, Category.id_comp, Category.comp_id]
      apply sheaf_hom_eq; intro W; exact eq_of_heq (hmap f W)
    subst hUY_eq; subst hUZ_eq
    have : hAdd = hAdd_U Y m := Subsingleton.elim _ _; subst this
    have : hLim = (hLim_U Y m).1 := Subsingleton.elim _ _; subst this
    have : hColim = (hLim_U Y m).2 := Subsingleton.elim _ _; subst this
    have huY_eq : u_unit_Y = F_fg.map ((constantSheafAdj Y.smallEtaleTopology
        (ModuleCat.{u, u} R) hT_Y).unit.app R_mod) := eq_of_heq hu_Y
    have huZ_eq : u_unit_Z = F_fg.map ((constantSheafAdj Z.smallEtaleTopology
        (ModuleCat.{u, u} R) hT_Z).unit.app R_mod) := eq_of_heq hu_Z
    have hγ_eq : γ_push = (γ_pf B_i m (One_of Z m)).hom :=
      sheaf_hom_eq _ _ (fun V => eq_of_heq (hγ_app V))
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let αM_Y_wit : weilEtaleTorsionSheaf Y m ⟶ (U_of Y m).obj (One_of Y m) :=
      ((constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y).homEquiv
        AM ((U_of Y m).obj (One_of Y m))).symm (ιM_of m ≫ u_unit_Y)
    let αM_Z_wit : weilEtaleTorsionSheaf Z m ⟶ (U_of Z m).obj (One_of Z m) :=
      ((constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z).homEquiv
        AM ((U_of Z m).obj (One_of Z m))).symm (ιM_of m ≫ u_unit_Z)
    have hαM_Y_eq : αM_Y_wit = αM_of Y m := by
      dsimp only [αM_Y_wit]; rw [huY_eq]; exact hαM_indep Y m T_Y hT_Y
    have hαM_Z_eq : αM_Z_wit = αM_of Z m := by
      dsimp only [αM_Z_wit]; rw [huZ_eq]; exact hαM_indep Z m T_Z hT_Z
    have hπ_eq : πM_Y = βM_of Y m := inv_uniq (hαM_Y_eq ▸ hπα_Y) (hαβ_of Y m)
    let ζ_Z_wit : i_push_ab.obj Fℤ_Z ⟶ (U_of Y m).obj (i_push_mod.obj (One_of Z m)) :=
      i_push_ab.map ((constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
        (z_to_m_of m) ≫ αM_Z_wit) ≫ γ_push
    let ζ_Z_std : i_push_ab.obj Fℤ_Z ⟶ (U_of Y m).obj (i_push_mod.obj (One_of Z m)) :=
      i_push_ab.map (ιℤ_std Z m) ≫ (γ_pf B_i m (One_of Z m)).hom
    have hζ_eq : ζ_Z_wit = ζ_Z_std :=
      congrArg₂ CategoryStruct.comp
        (congrArg (fun k => i_push_ab.map
          ((constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map (z_to_m_of m) ≫ k))
          hαM_Z_eq) hγ_eq
    have _ := hAdd_U Y m; have _ := (hLim_U Y m).1; have _ := (hLim_U Y m).2
    have hα_std : α.val =
        (((Abelian.Ext.mk₀ ζ_Z_std).comp
          (((U_of Y m).mapExtAddHom (i_push_mod.obj (One_of Z m)) (One_of Y m) q) τ.val)
          (Nat.zero_add q)).comp
          (Abelian.Ext.mk₀ (βM_of Y m)) (Nat.add_zero q)) :=
      hα_val.trans
        (congrArg₂
          (fun (p : (U_of Y m).obj (One_of Y m) ⟶ weilEtaleTorsionSheaf Y m)
              (z : i_push_ab.obj Fℤ_Z ⟶ (U_of Y m).obj (i_push_mod.obj (One_of Z m))) =>
            (Abelian.Ext.mk₀ p).postcomp (i_push_ab.obj Fℤ_Z) (Nat.add_zero q)
              ((Abelian.Ext.mk₀ z).comp
                (((U_of Y m).mapExtAddHom (i_push_mod.obj (One_of Z m)) (One_of Y m) q) τ.val)
                (Nat.zero_add q)))
          hπ_eq hζ_eq)
    let adj_mod_Y := constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Y)
    let adj_mod_Z := constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Z)
    let q_mod0 : One_of Y m ⟶ i_push_mod.obj (One_of Z m) :=
      (adj_mod_Y.homEquiv R_mod (i_push_mod.obj (One_of Z m))).symm
        (adj_mod_Z.unit.app R_mod ≫ (One_of Z m).obj.map ((hT_of Z).from (B_i.obj (T_of Y))).op)
    have hq_comm : q_ab0 ≫ ζ_Z_std =
        ιℤ_std Y m ≫ (U_of Y m).map q_mod0 := hq_intertwine B_i m
    have h_abs : ∀ {𝒞 𝒟 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒞] [Abelian 𝒞] [HasExt.{u} 𝒞]
        [Category.{u + 1, u + 1} 𝒟] [Abelian 𝒟] [HasExt.{u} 𝒟]
        (U : 𝒞 ⥤ 𝒟) [U.Additive] [Limits.PreservesFiniteLimits U] [Limits.PreservesFiniteColimits U]
        {X₀ X₁ Y₀ : 𝒞} {E₀ E₁ M₀ : 𝒟}
        (q_ab : E₀ ⟶ E₁) (ζ : E₁ ⟶ U.obj X₁) (ι_Y : E₀ ⟶ U.obj X₀)
        (q_m : X₀ ⟶ X₁) (β_M : U.obj Y₀ ⟶ M₀)
        (_hcomm : q_ab ≫ ζ = ι_Y ≫ U.map q_m) (v : Abelian.Ext X₁ Y₀ q),
        (Abelian.Ext.mk₀ q_ab).comp
          (((Abelian.Ext.mk₀ ζ).comp ((U.mapExtAddHom X₁ Y₀ q) v) (Nat.zero_add q)).comp
            (Abelian.Ext.mk₀ β_M) (Nat.add_zero q)) (Nat.zero_add q) =
        (((Abelian.Ext.mk₀ ι_Y).comp
          ((U.mapExtAddHom X₀ Y₀ q) ((Abelian.Ext.mk₀ q_m).comp v (Nat.zero_add q)))
          (Nat.zero_add q)).comp (Abelian.Ext.mk₀ β_M) (Nat.add_zero q)) := by
      intro 𝒞 𝒟 _ _ _ _ _ _ U _ _ _ X₀ X₁ Y₀ E₀ E₁ M₀ q_ab ζ ι_Y q_m β_M hcomm v
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q_ab) _ (Abelian.Ext.mk₀ β_M)
          (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q),
        ← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ q_ab)
          (Abelian.Ext.mk₀ ζ) _ (Nat.zero_add q),
        Abelian.Ext.mk₀_comp_mk₀, hcomm, ← Abelian.Ext.mk₀_comp_mk₀,
        Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ ι_Y)
          (Abelian.Ext.mk₀ (U.map q_m)) _ (Nat.zero_add q)]
    exact hcl_std.trans
      ((h_abs (U_of Y m) q_ab0 ζ_Z_std (ιℤ_std Y m)
        q_mod0 (βM_of Y m) hq_comm τ.val).symm.trans
        (congrArg (fun x => (Abelian.Ext.mk₀ q_ab0).comp x (Nat.zero_add q)) hα_std.symm))

  
  
  
  have hSite_out : WeilGysinSuppCalcHasExactPullbacks.{u} := by
    intro W₁ W₂ h
    let B : W₂.Etale ⥤ W₁.Etale := weilEtaleSitePullback h
    have hc : B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := hContAll h
    let _ := hc
    obtain ⟨hLimB, hRightAdj, hLim_ab⟩ := hSitePullExact h
    let pb_ab := B.sheafPullback AddCommGrpCat.{u} W₂.smallEtaleTopology W₁.smallEtaleTopology
    let adj_ab := B.sheafAdjunctionContinuous AddCommGrpCat.{u}
      W₂.smallEtaleTopology W₁.smallEtaleTopology
    have _ := adj_ab.leftAdjoint_preservesColimits
    have hColim_ab : Limits.PreservesFiniteColimits pb_ab := inferInstance
    have hAdd_ab : pb_ab.Additive := pb_ab.additive_of_preserves_binary_products
    refine ⟨hc, pb_ab, adj_ab, hAdd_ab, hLim_ab, hColim_ab, ?_, ?_⟩
    · intro A T₁ hT₁ T₂ hT₂
      have hBT₂ : Limits.IsTerminal (B.obj T₂) := Limits.IsTerminal.isTerminalObj B T₂ hT₂
      exact hπ_iso_of_term B pb_ab adj_ab hT₁ hT₂ hBT₂ A
    · intro m _hm
      obtain ⟨pb_mod, adj_mod, hAdd_mod, hLim_mod, hColim_mod, _, _⟩ :=
        hModPullLift h m pb_ab adj_ab
      refine ⟨pb_mod, adj_mod, hAdd_mod, hLim_mod, hColim_mod, ?_⟩
      intro T₁ hT₁ T₂ hT₂
      have hBT₂ : Limits.IsTerminal (B.obj T₂) := Limits.IsTerminal.isTerminalObj B T₂ hT₂
      exact hπ_iso_of_term B pb_mod adj_mod hT₁ hT₂ hBT₂
        (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m)))

  
  let p_mod_iso {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Z ⟶ Y) [inst_i : IsIso i] (r : ℕ) :
      let B_i := weilEtaleSitePullback i
      let _ : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := hContAll i
      let R := ULift.{u, 0} (ZMod (ℓ ^ r))
      (B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R)
        Y.smallEtaleTopology Z.smallEtaleTopology).obj (One_of Z (ℓ ^ r)) ⟶
        One_of Y (ℓ ^ r) :=
    Classical.choose (@iso_const_pushforward_inv _ _ _ Z Y i inst_i
      (ModuleCat.of (ULift.{u, 0} (ZMod (ℓ ^ r))) (ULift.{u, 0} (ZMod (ℓ ^ r)))))

  have hp_mod_iso_spec : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Z ⟶ Y) [IsIso i] (r : ℕ),
      let B_i := weilEtaleSitePullback i
      let _ : B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := hContAll i
      let R := ULift.{u, 0} (ZMod (ℓ ^ r))
      let R_mod := ModuleCat.of R R
      let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R)
        Y.smallEtaleTopology Z.smallEtaleTopology
      let adj_Y0 := constantSheafAdj Y.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Y)
      let adj_Z0 := constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of Z)
      let q_i0 : One_of Y (ℓ ^ r) ⟶ i_push.obj (One_of Z (ℓ ^ r)) :=
