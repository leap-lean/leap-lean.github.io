        let K : 𝒞 := Limits.kernel p
        let k : K ⟶ Q := Limits.kernel.ι p
        have hk0 : k ≫ p = 0 := Limits.kernel.condition p
        let S : ShortComplex 𝒞 := ShortComplex.mk k p hk0
        have hS : S.ShortExact :=
