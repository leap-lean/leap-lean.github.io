          Aℤ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)) ≫
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))) ≫ ιM)
