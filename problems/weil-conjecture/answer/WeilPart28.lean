                  ext U : 3
                  exact (α.hom.naturality (adj_site.counit.app U.unop).op).symm }
            counit :=
              { app := fun 𝒢 =>
                  CategoryTheory.ObjectProperty.homMk
                    { app := fun V => 𝒢.obj.map (adj_site.unit.app V.unop).op
                      naturality := fun {V₁ V₂} g => by
                        change 𝒢.obj.map (B_0.map (Sigma_0.map g.unop)).op ≫
                            𝒢.obj.map (adj_site.unit.app V₂.unop).op =
                          𝒢.obj.map (adj_site.unit.app V₁.unop).op ≫ 𝒢.obj.map g
                        have hg_op : g = g.unop.op := rfl
                        conv_rhs => rw [hg_op]
                        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp,
                          ← CategoryTheory.op_comp, ← CategoryTheory.op_comp]
                        congr 2
                        exact (adj_site.unit.naturality g.unop).symm }
                naturality := fun {𝒢₁ 𝒢₂} β => by
                  ext V : 3
                  exact (β.hom.naturality (adj_site.unit.app V.unop).op).symm }
            left_triangle := by
              apply CategoryTheory.NatTrans.ext
              funext ℱ
              apply CategoryTheory.ObjectProperty.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext V
              change ℱ.obj.map (adj_site.counit.app (Sigma_0.obj V.unop)).op ≫
                ℱ.obj.map (Sigma_0.map (adj_site.unit.app V.unop)).op = 𝟙 _
              rw [← ℱ.obj.map_comp, ← CategoryTheory.op_comp,
                adj_site.left_triangle_components V.unop]
              exact ℱ.obj.map_id _
            right_triangle := by
              apply CategoryTheory.NatTrans.ext
              funext 𝒢
              apply CategoryTheory.ObjectProperty.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext U
              change 𝒢.obj.map (B_0.map (adj_site.counit.app U.unop)).op ≫
                𝒢.obj.map (adj_site.unit.app (B_0.obj U.unop)).op = 𝟙 _
              rw [← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
                adj_site.right_triangle_components U.unop]
              exact 𝒢.obj.map_id _ }
      let ν_w : Res_0 ≅ P_pull := CategoryTheory.Adjunction.leftAdjointUniq adj_w adj
      have hAdd_R : Res_0.Additive := CategoryTheory.Functor.additive_of_iso ν_w.symm
      have hLim_R : CategoryTheory.Limits.PreservesFiniteLimits Res_0 :=
        CategoryTheory.Limits.preservesFiniteLimits_of_natIso ν_w.symm
      have hColim_R : CategoryTheory.Limits.PreservesFiniteColimits Res_0 :=
        CategoryTheory.Limits.preservesFiniteColimits_of_natIso ν_w.symm
      letI := hAdd_R
      letI := hLim_R
      letI := hColim_R
      let ε_w : one_fn X ≅ Res_0.obj (one_fn S) := e_unit.trans (ν_w.symm.app (one_fn S))
      let hat_1 : one_fn S ⟶ P_push.obj (one_fn X) :=
        (adj.homEquiv (one_fn S) (one_fn X)) (e_unit.inv ≫ 𝟙 (one_fn X))
      have h_mate : (adj_w.homEquiv (one_fn S) (one_fn X)) ε_w.inv = hat_1 := by
        change (adj_w.homEquiv (one_fn S) (one_fn X)) (ν_w.hom.app (one_fn S) ≫ e_unit.inv) =
          (adj.homEquiv (one_fn S) (one_fn X)) (e_unit.inv ≫ 𝟙 (one_fn X))
        rw [CategoryTheory.Category.comp_id, adj_w.homEquiv_unit, P_push.map_comp,
          ← CategoryTheory.Category.assoc,
          CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj_w adj (one_fn S),
          ← adj.homEquiv_unit]
      have h_ε_inv_eq : ε_w.inv = Res_0.map hat_1 ≫ adj_w.counit.app (one_fn X) := by
        have hsymm := congrArg (adj_w.homEquiv (one_fn S) (one_fn X)).symm h_mate
        rw [Equiv.symm_apply_apply, adj_w.homEquiv_counit] at hsymm
        exact hsymm
      have hEv_inv : ∀ V : X.Etale,
          u_fn S ≫ (one_fn S).obj.map (Opposite.op ((hT_fn S).from (Sigma_0.obj V))) ≫
            ε_w.inv.hom.app (Opposite.op V) =
          u_fn X ≫ (one_fn X).obj.map (Opposite.op ((hT_fn X).from V)) := by
        intro V
        have happ : ε_w.inv.hom.app (Opposite.op V) =
            hat_1.hom.app (Opposite.op (Sigma_0.obj V)) ≫
              (one_fn X).obj.map (adj_site.unit.app V).op :=
          congrArg (fun m => m.hom.app (Opposite.op V)) h_ε_inv_eq
        let mS := (one_fn S).obj.map (Opposite.op ((hT_fn S).from (Sigma_0.obj V)))
        let mHat := hat_1.hom.app (Opposite.op (Sigma_0.obj V))
        let mUnit := (one_fn X).obj.map (adj_site.unit.app V).op
        calc
          u_fn S ≫ mS ≫ ε_w.inv.hom.app (Opposite.op V)
            = u_fn S ≫ mS ≫ (mHat ≫ mUnit) :=
              congrArg (fun m => u_fn S ≫ mS ≫ m) happ
          _ = (u_fn S ≫ mS ≫ mHat) ≫ mUnit :=
              (congrArg (u_fn S ≫ ·) (CategoryTheory.Category.assoc mS mHat mUnit).symm).trans
                (CategoryTheory.Category.assoc (u_fn S) (mS ≫ mHat) mUnit).symm
          _ = (u_fn X ≫ (one_fn X).obj.map (Opposite.op ((hT_fn X).from (B_0.obj (Sigma_0.obj V)))) ≫
                (CategoryTheory.CategoryStruct.id (one_fn X)).hom.app
                  (Opposite.op (B_0.obj (Sigma_0.obj V)))) ≫ mUnit :=
              congrArg (· ≫ mUnit) (hEv (Sigma_0.obj V))
          _ = u_fn X ≫ ((one_fn X).obj.map ((hT_fn X).from (B_0.obj (Sigma_0.obj V))).op ≫ mUnit) := by
              have hid_app : (CategoryTheory.CategoryStruct.id (one_fn X)).hom.app
                  (Opposite.op (B_0.obj (Sigma_0.obj V))) = 𝟙 _ := rfl
              rw [hid_app, CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc]
              rfl
          _ = u_fn X ≫ (one_fn X).obj.map (Opposite.op ((hT_fn X).from V)) := by
              dsimp only [mUnit]
              rw [← (one_fn X).obj.map_comp, ← CategoryTheory.op_comp]
              exact congrArg (fun f => u_fn X ≫ (one_fn X).obj.map (Opposite.op f))
                ((hT_fn X).hom_ext _ _)
      have hEv_hom : ∀ V : X.Etale,
          u_fn X ≫ (one_fn X).obj.map (Opposite.op ((hT_fn X).from V)) ≫
            ε_w.hom.hom.app (Opposite.op V) =
          u_fn S ≫ (one_fn S).obj.map (Opposite.op ((hT_fn S).from (Sigma_0.obj V))) := by
        intro V
        let A : ModR := (one_fn X).obj.obj (Opposite.op V)
        let B : ModR := (Res_0.obj (one_fn S)).obj.obj (Opposite.op V)
        let fX : R_mod ⟶ A := u_fn X ≫ (one_fn X).obj.map (Opposite.op ((hT_fn X).from V))
        let fS : R_mod ⟶ B :=
          u_fn S ≫ (one_fn S).obj.map (Opposite.op ((hT_fn S).from (Sigma_0.obj V)))
        let eh : A ⟶ B := ε_w.hom.hom.app (Opposite.op V)
        let ei : B ⟶ A := ε_w.inv.hom.app (Opposite.op V)
        have h1 : fS ≫ ei = fX :=
          (CategoryTheory.Category.assoc _ _ _).symm.trans (hEv_inv V)
        have h2 : ei ≫ eh = 𝟙 B :=
          congrArg (fun m : Res_0.obj (one_fn S) ⟶ Res_0.obj (one_fn S) => m.hom.app (Opposite.op V))
            ε_w.inv_hom_id
        have h3 : fX ≫ eh = fS := by
          rw [← h1, CategoryTheory.Category.assoc, h2, CategoryTheory.Category.comp_id]
        exact (CategoryTheory.Category.assoc _ _ _).symm.trans h3
      have hResInt : ∀ (q : ℕ)
          (θ_X : CategoryTheory.Abelian.Ext.{u} (one_fn X) (one_fn X) q →+ H_tor X q)
          (θ_S : CategoryTheory.Abelian.Ext.{u} (one_fn S) (one_fn S) q →+ H_tor S q)
          (p : H_tor S q →+ H_tor X q),
          IsModComp X q θ_X →
          IsModComp S q θ_S →
          IsTopPull w q p →
          ∀ γ : CategoryTheory.Abelian.Ext.{u} (one_fn S) (one_fn S) q,
            θ_X (((CategoryTheory.Abelian.Ext.mk₀ ε_w.hom).comp
              (Res_0.mapExtAddHom (one_fn S) (one_fn S) q γ) (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ ε_w.inv) (Nat.add_zero q)) = p (θ_S γ) := by
        intro q θ_X θ_S p hθX hθS hp γ
        rw [← hInt q θ_X θ_S p hθX hθS hp γ]
        congr 1
        change _ = ((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
          (P_pull.mapExtAddHom (one_fn S) (one_fn S) q γ) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv) (Nat.add_zero q)
        conv_rhs =>
          rw [hExtCoh.1 Res_0 P_pull ν_w q (one_fn S) (one_fn S) γ,
            ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add 0) (Nat.zero_add q) (by omega),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add q) (Nat.add_zero q) (by omega),
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.add_zero q) (Nat.zero_add 0) (by omega),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add q) (Nat.add_zero q) (by omega)]
        rfl
      exact ⟨hAdd_R, hLim_R, hColim_R, ε_w, hInj_Res, hEv_inv, hEv_hom, hResInt⟩

    
    
    
    let evalOne_R (M : ModR) : (R_mod ⟶ M) ≃+ ↑M :=
      { toFun := fun f => f.hom r_one
        invFun := fun m => ModuleCat.ofHom
          { toFun := fun r => r • m
            map_add' := fun a b => add_smul a b m
            map_smul' := fun a b => mul_smul a b m }
        left_inv := fun f => by
          apply ModuleCat.hom_ext
          ext
          simp only [ModuleCat.hom_ofHom, LinearMap.coe_mk, AddHom.coe_mk, one_smul, hr_one]
        right_inv := fun m => by
          simp only [ModuleCat.hom_ofHom, LinearMap.coe_mk, AddHom.coe_mk, hr_one, one_smul]
        map_add' := fun f g => by
          simp only [ModuleCat.hom_add, LinearMap.add_apply] }
    have hevalOne_apply : ∀ (M : ModR) (f : R_mod ⟶ M), evalOne_R M f = f.hom r_one :=
      fun _ _ => rfl
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    letI : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let I_et (W : AlgebraicGeometry.Scheme.{u}) : W.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id W)
        (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id W))
    let hI_et (W : AlgebraicGeometry.Scheme.{u}) : CategoryTheory.Limits.IsTerminal (I_et W) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun Y => CategoryTheory.MorphismProperty.Over.homMk Y.hom
          (CategoryTheory.Category.comp_id Y.hom) trivial)
        (fun Y m => CategoryTheory.MorphismProperty.Comma.Hom.ext
          ((CategoryTheory.Category.comp_id m.left).symm.trans
            (CategoryTheory.MorphismProperty.Over.w m))
          (Subsingleton.elim _ _))
    let e_T (W : AlgebraicGeometry.Scheme.{u}) : T_fn W ≅ I_et W :=
      (hT_fn W).uniqueUpToIso (hI_et W)
    have h_from_I_left : ∀ {W : AlgebraicGeometry.Scheme.{u}} {Y : W.Etale}
        (m : Y ⟶ I_et W), m.left = Y.hom := fun {W Y} m =>
      (CategoryTheory.Category.comp_id m.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w m)
    let hCont_fn {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
