        obtain ⟨z₀, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS_inj ξ hzero rfl
        obtain ⟨K, Q, k, p, hk0, hS, hK, hQ, ξ'₀, hz₀⟩ := ih hX Q₀ z₀
        refine ⟨K, Q, k, p, hk0, hS, hK, hQ, ξ'₀.comp hS_inj.extClass rfl, ?_⟩
        rw [hz₀, Abelian.Ext.comp_assoc hS.extClass ξ'₀ hS_inj.extClass (by omega) rfl (by omega)]
    let extL : ∀ (T : 𝒞), P T → ∀ {A B : 𝒞} {n : ℕ},
        Abelian.Ext.{u} A B n →
          Abelian.Ext.{u}
            (MonoidalCategoryStruct.tensorObj T A)
            (MonoidalCategoryStruct.tensorObj T B) n :=
      fun T hT {A B n} γ =>
        letI := (hP_exact T hT).1
        letI := (hP_exact T hT).2.1.some
        letI := (hP_exact T hT).2.2.1.some
        ((MonoidalCategory.tensorLeft T).mapExtAddHom A B n) γ
    let extR : ∀ (T : 𝒞), P T → ∀ {A B : 𝒞} {n : ℕ},
        Abelian.Ext.{u} A B n →
          Abelian.Ext.{u}
            (MonoidalCategoryStruct.tensorObj A T)
            (MonoidalCategoryStruct.tensorObj B T) n :=
      fun T hT {A B n} γ =>
        letI := (hP_exact T hT).2.2.2.1
        letI := (hP_exact T hT).2.2.2.2.1.some
        letI := (hP_exact T hT).2.2.2.2.2.some
        ((MonoidalCategory.tensorRight T).mapExtAddHom A B n) γ
    have hKoszul1 : ∀ (b₁ c₁ : ℕ) (hab₁ : 1 + b₁ = c₁) (hba₁ : b₁ + 1 = c₁)
        {K Q X : 𝒞} (f₁ : K ⟶ Q) (g₁ : Q ⟶ X) (hf₁0 : f₁ ≫ g₁ = 0)
        (hS₁ : (ShortComplex.mk f₁ g₁ hf₁0).ShortExact)
        (hK : P K) (hQ : P Q) (hX : P X)
        {X' Y' : 𝒞} (hX' : P X') (hY' : P Y')
        (β₁ : Abelian.Ext.{u} X' Y' b₁),
        (extR X' hX' hS₁.extClass).comp (extL K hK β₁) hab₁ =
          ((-1 : ℤ) ^ b₁) • ((extL X hX β₁).comp (extR Y' hY' hS₁.extClass) hba₁) := by
      intro b₁
      induction b₁ with
      | zero =>
        intro c₁ hab₁ hba₁ K Q X f₁ g₁ hf₁0 hS₁ hK hQ hX X' Y' hX' hY' β₁
        obtain rfl : 1 = c₁ := by omega
        let g : X' ⟶ Y' := Abelian.Ext.addEquiv₀ β₁
        have hβ₁ : β₁ = Abelian.Ext.mk₀ g := (Abelian.Ext.addEquiv₀.left_inv β₁).symm
        rw [hβ₁, pow_zero, one_smul]
        letI := (hP_exact K hK).1; letI := (hP_exact K hK).2.1.some; letI := (hP_exact K hK).2.2.1.some
        letI := (hP_exact X hX).1; letI := (hP_exact X hX).2.1.some; letI := (hP_exact X hX).2.2.1.some
        letI := (hP_exact X' hX').2.2.2.1; letI := (hP_exact X' hX').2.2.2.2.1.some; letI := (hP_exact X' hX').2.2.2.2.2.some
        letI := (hP_exact Y' hY').2.2.2.1; letI := (hP_exact Y' hY').2.2.2.2.1.some; letI := (hP_exact Y' hY').2.2.2.2.2.some
        let σ_g : MonoidalCategory.tensorRight X' ⟶ MonoidalCategory.tensorRight Y' :=
          { app := fun Z => MonoidalCategoryStruct.whiskerLeft Z g
            naturality := fun {Z₁ Z₂} h => by
              dsimp
              exact (MonoidalCategory.whisker_exchange h g).symm }
        have hL_K : extL K hK (Abelian.Ext.mk₀ g) = Abelian.Ext.mk₀ (σ_g.app K) := by
          dsimp [extL, σ_g]
          rw [Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_mk₀]
          rfl
        have hL_X : extL X hX (Abelian.Ext.mk₀ g) = Abelian.Ext.mk₀ (σ_g.app X) := by
          dsimp [extL, σ_g]
          rw [Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_mk₀]
          rfl
        rw [hL_K, hL_X]
        exact hExtNatTrans (MonoidalCategory.tensorRight X') (MonoidalCategory.tensorRight Y')
          σ_g X K 1 hS₁.extClass
      | succ b_idx ih_b =>
        intro c₁ hab₁ hba₁ K Q X f₁ g₁ hf₁0 hS₁ hK hQ hX X' Y' hX' hY' β₁
        obtain ⟨K', Q', f₂, g₂, hf₂0, hS₂, hK', hQ', β₀, hβ₁⟩ := hSyzygy b_idx hX' Y' β₁
        letI := (hP_exact K hK).1; letI := (hP_exact K hK).2.1.some; letI := (hP_exact K hK).2.2.1.some
        letI := (hP_exact Q hQ).1; letI := (hP_exact Q hQ).2.1.some; letI := (hP_exact Q hQ).2.2.1.some
        letI := (hP_exact X hX).1; letI := (hP_exact X hX).2.1.some; letI := (hP_exact X hX).2.2.1.some
        letI := (hP_exact K' hK').2.2.2.1; letI := (hP_exact K' hK').2.2.2.2.1.some; letI := (hP_exact K' hK').2.2.2.2.2.some
        letI := (hP_exact Q' hQ').2.2.2.1; letI := (hP_exact Q' hQ').2.2.2.2.1.some; letI := (hP_exact Q' hQ').2.2.2.2.2.some
        letI := (hP_exact X' hX').2.2.2.1; letI := (hP_exact X' hX').2.2.2.2.1.some; letI := (hP_exact X' hX').2.2.2.2.2.some
        letI := (hP_exact Y' hY').2.2.2.1; letI := (hP_exact Y' hY').2.2.2.2.1.some; letI := (hP_exact Y' hY').2.2.2.2.2.some
        have hR₀ := hS₂.map_of_exact (MonoidalCategory.tensorLeft K)
        have hR₁ := hS₂.map_of_exact (MonoidalCategory.tensorLeft Q)
        have hR₂ := hS₂.map_of_exact (MonoidalCategory.tensorLeft X)
        have hC₀ := hS₁.map_of_exact (MonoidalCategory.tensorRight K')
        have hC₁ := hS₁.map_of_exact (MonoidalCategory.tensorRight Q')
        have hC₂ := hS₁.map_of_exact (MonoidalCategory.tensorRight X')
        have h11 : (extR X' hX' hS₁.extClass).comp (extL K hK hS₂.extClass) (rfl : 1 + 1 = 2) =
            -((extL X hX hS₂.extClass).comp (extR K' hK' hS₁.extClass) (rfl : 1 + 1 = 2)) := by
          dsimp only [extR, extL]
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
              Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
              Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
              Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]
          exact part3_bicomplex_extClass_anticomm
            (MonoidalCategoryStruct.whiskerLeft K f₂) (MonoidalCategoryStruct.whiskerLeft K g₂)
            (ShortComplex.map (ShortComplex.mk f₂ g₂ hf₂0) (MonoidalCategory.tensorLeft K)).zero
            (MonoidalCategoryStruct.whiskerLeft Q f₂) (MonoidalCategoryStruct.whiskerLeft Q g₂)
            (ShortComplex.map (ShortComplex.mk f₂ g₂ hf₂0) (MonoidalCategory.tensorLeft Q)).zero
            (MonoidalCategoryStruct.whiskerLeft X f₂) (MonoidalCategoryStruct.whiskerLeft X g₂)
            (ShortComplex.map (ShortComplex.mk f₂ g₂ hf₂0) (MonoidalCategory.tensorLeft X)).zero
            (MonoidalCategoryStruct.whiskerRight f₁ K') (MonoidalCategoryStruct.whiskerRight g₁ K')
            (ShortComplex.map (ShortComplex.mk f₁ g₁ hf₁0) (MonoidalCategory.tensorRight K')).zero
            (MonoidalCategoryStruct.whiskerRight f₁ Q') (MonoidalCategoryStruct.whiskerRight g₁ Q')
            (ShortComplex.map (ShortComplex.mk f₁ g₁ hf₁0) (MonoidalCategory.tensorRight Q')).zero
            (MonoidalCategoryStruct.whiskerRight f₁ X') (MonoidalCategoryStruct.whiskerRight g₁ X')
            (ShortComplex.map (ShortComplex.mk f₁ g₁ hf₁0) (MonoidalCategory.tensorRight X')).zero
            (MonoidalCategory.whisker_exchange f₁ f₂)
            (MonoidalCategory.whisker_exchange f₁ g₂)
            (MonoidalCategory.whisker_exchange g₁ f₂)
            (MonoidalCategory.whisker_exchange g₁ g₂)
            hR₀ hR₁ hR₂ hC₀ hC₁ hC₂
        have hL_K_comp : extL K hK β₁ =
            (extL K hK hS₂.extClass).comp (extL K hK β₀) (by omega : 1 + b_idx = b_idx + 1) := by
          rw [hβ₁]
          dsimp only [extL]
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
              Abelian.Ext.mapExactFunctor_comp]
        have hL_X_comp : extL X hX β₁ =
            (extL X hX hS₂.extClass).comp (extL X hX β₀) (by omega : 1 + b_idx = b_idx + 1) := by
          rw [hβ₁]
          dsimp only [extL]
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
              Abelian.Ext.mapExactFunctor_comp]
        rw [hL_K_comp,
            ← Abelian.Ext.comp_assoc (extR X' hX' hS₁.extClass) (extL K hK hS₂.extClass) (extL K hK β₀)
              (rfl : 1 + 1 = 2) (by omega : 1 + b_idx = b_idx + 1) (by omega),
            h11, Abelian.Ext.neg_comp,
            Abelian.Ext.comp_assoc (extL X hX hS₂.extClass) (extR K' hK' hS₁.extClass) (extL K hK β₀)
              (rfl : 1 + 1 = 2) (rfl : 1 + b_idx = 1 + b_idx) (by omega),
            ih_b (1 + b_idx) rfl (by omega : b_idx + 1 = 1 + b_idx) f₁ g₁ hf₁0 hS₁ hK hQ hX hK' hY' β₀,
            comp_zsmul, ← neg_zsmul,
            ← Abelian.Ext.comp_assoc (extL X hX hS₂.extClass) (extL X hX β₀) (extR Y' hY' hS₁.extClass)
              (by omega : 1 + b_idx = b_idx + 1) (by omega : b_idx + 1 = 1 + b_idx) (by omega),
            ← hL_X_comp]
        have hpow : -((-1 : ℤ) ^ b_idx) = (-1 : ℤ) ^ (b_idx + 1) := by
          rw [pow_succ, mul_neg_one]
        rw [hpow]
    have hKoszul : ∀ (p q pq : ℕ) (hpq : p + q = pq) (hqp : q + p = pq)
        {X Y X' Y' : 𝒞} (hX : P X) (hY : P Y) (hX' : P X') (hY' : P Y')
        (x : Abelian.Ext.{u} X Y p) (y : Abelian.Ext.{u} X' Y' q),
        (extR X' hX' x).comp (extL Y hY y) hpq =
          ((-1 : ℤ) ^ (p * q)) • ((extL X hX y).comp (extR Y' hY' x) hqp) := by
      intro p
      induction p with
      | zero =>
        intro q pq hpq hqp X Y X' Y' hX hY hX' hY' x y
        obtain rfl : q = pq := by omega
        let f : X ⟶ Y := Abelian.Ext.addEquiv₀ x
        have hx : x = Abelian.Ext.mk₀ f := (Abelian.Ext.addEquiv₀.left_inv x).symm
        rw [hx, zero_mul, pow_zero, one_smul]
        letI := (hP_exact X hX).1; letI := (hP_exact X hX).2.1.some; letI := (hP_exact X hX).2.2.1.some
        letI := (hP_exact Y hY).1; letI := (hP_exact Y hY).2.1.some; letI := (hP_exact Y hY).2.2.1.some
        letI := (hP_exact X' hX').2.2.2.1; letI := (hP_exact X' hX').2.2.2.2.1.some; letI := (hP_exact X' hX').2.2.2.2.2.some
        letI := (hP_exact Y' hY').2.2.2.1; letI := (hP_exact Y' hY').2.2.2.2.1.some; letI := (hP_exact Y' hY').2.2.2.2.2.some
        let σ_f : MonoidalCategory.tensorLeft X ⟶ MonoidalCategory.tensorLeft Y :=
          { app := fun Z => MonoidalCategoryStruct.whiskerRight f Z
            naturality := fun {Z₁ Z₂} h => by
              dsimp
              exact MonoidalCategory.whisker_exchange f h }
        have hR_X' : extR X' hX' (Abelian.Ext.mk₀ f) = Abelian.Ext.mk₀ (σ_f.app X') := by
          dsimp [extR, σ_f]
          rw [Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_mk₀]
          rfl
        have hR_Y' : extR Y' hY' (Abelian.Ext.mk₀ f) = Abelian.Ext.mk₀ (σ_f.app Y') := by
          dsimp [extR, σ_f]
          rw [Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_mk₀]
          rfl
        rw [hR_X', hR_Y']
        exact (hExtNatTrans (MonoidalCategory.tensorLeft X) (MonoidalCategory.tensorLeft Y)
          σ_f X' Y' q y).symm
      | succ p₀ ih_p =>
        intro q pq hpq hqp X Y X' Y' hX hY hX' hY' x y
        obtain ⟨K, Q, f₁, g₁, hf₁0, hS₁, hK, hQ, x₀, hx⟩ := hSyzygy p₀ hX Y x
        letI := (hP_exact X' hX').2.2.2.1; letI := (hP_exact X' hX').2.2.2.2.1.some; letI := (hP_exact X' hX').2.2.2.2.2.some
        letI := (hP_exact Y' hY').2.2.2.1; letI := (hP_exact Y' hY').2.2.2.2.1.some; letI := (hP_exact Y' hY').2.2.2.2.2.some
        have hR_X'_comp : extR X' hX' x =
            (extR X' hX' hS₁.extClass).comp (extR X' hX' x₀) (by omega : 1 + p₀ = p₀ + 1) := by
          rw [hx]
          dsimp only [extR]
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
              Abelian.Ext.mapExactFunctor_comp]
        have hR_Y'_comp : extR Y' hY' x =
            (extR Y' hY' hS₁.extClass).comp (extR Y' hY' x₀) (by omega : 1 + p₀ = p₀ + 1) := by
          rw [hx]
          dsimp only [extR]
          rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
              Abelian.Ext.mapExactFunctor_comp]
        rw [hR_X'_comp,
            Abelian.Ext.comp_assoc (extR X' hX' hS₁.extClass) (extR X' hX' x₀) (extL Y hY y)
              (by omega : 1 + p₀ = p₀ + 1) (rfl : p₀ + q = p₀ + q) (by omega),
            ih_p q (p₀ + q) rfl (by omega : q + p₀ = p₀ + q) hK hY hX' hY' x₀ y,
            comp_zsmul,
            ← Abelian.Ext.comp_assoc (extR X' hX' hS₁.extClass) (extL K hK y) (extR Y' hY' x₀)
              (rfl : 1 + q = 1 + q) (by omega : q + p₀ = p₀ + q) (by omega),
            hKoszul1 q (1 + q) rfl (by omega : q + 1 = 1 + q) f₁ g₁ hf₁0 hS₁ hK hQ hX hX' hY' y,
            zsmul_comp, smul_smul,
            Abelian.Ext.comp_assoc (extL X hX y) (extR Y' hY' hS₁.extClass) (extR Y' hY' x₀)
              (by omega : q + 1 = 1 + q) (by omega : 1 + p₀ = p₀ + 1) (by omega),
            ← hR_Y'_comp]
        have hpow : (-1 : ℤ) ^ (p₀ * q) * (-1 : ℤ) ^ q = (-1 : ℤ) ^ ((p₀ + 1) * q) := by
          rw [add_mul, one_mul, pow_add]
        rw [hpow]
    let I₀ : 𝒞 := MonoidalCategoryStruct.tensorUnit 𝒞
    letI := (hP_exact I₀ hP_unit).1
    letI := (hP_exact I₀ hP_unit).2.1.some
    letI := (hP_exact I₀ hP_unit).2.2.1.some
    letI := (hP_exact I₀ hP_unit).2.2.2.1
    letI := (hP_exact I₀ hP_unit).2.2.2.2.1.some
    letI := (hP_exact I₀ hP_unit).2.2.2.2.2.some
    let u_iso : MonoidalCategoryStruct.tensorObj I₀ I₀ ≅ I₀ :=
      MonoidalCategoryStruct.leftUnitor I₀
    have hu_hom : (MonoidalCategoryStruct.rightUnitor I₀).hom = u_iso.hom :=
      MonoidalCategory.unitors_equal.symm
    have hu_inv : (MonoidalCategoryStruct.rightUnitor I₀).inv = u_iso.inv := by
      have : MonoidalCategoryStruct.rightUnitor I₀ = u_iso := Iso.ext hu_hom
      rw [this]
    have hextL_I₀ : ∀ {n : ℕ} (γ : Abelian.Ext.{u} I₀ I₀ n),
        extL I₀ hP_unit γ =
          (Abelian.Ext.mk₀ u_iso.hom).comp
            (γ.comp (Abelian.Ext.mk₀ u_iso.inv) (Nat.add_zero n))
            (Nat.zero_add n) := by
      intro n γ
      dsimp only [extL]
      rw [hExtIso (𝟭 𝒞) (MonoidalCategory.tensorLeft I₀)
            (MonoidalCategory.leftUnitorNatIso 𝒞).symm I₀ I₀ n γ,
          hExtId I₀ I₀ n γ]
      rfl
    have hextR_I₀ : ∀ {n : ℕ} (γ : Abelian.Ext.{u} I₀ I₀ n),
        extR I₀ hP_unit γ =
          (Abelian.Ext.mk₀ u_iso.hom).comp
            (γ.comp (Abelian.Ext.mk₀ u_iso.inv) (Nat.add_zero n))
            (Nat.zero_add n) := by
      intro n γ
      dsimp only [extR]
      rw [hExtIso (𝟭 𝒞) (MonoidalCategory.tensorRight I₀)
            (MonoidalCategory.rightUnitorNatIso 𝒞).symm I₀ I₀ n γ,
          hExtId I₀ I₀ n γ]
      change (Abelian.Ext.mk₀ (MonoidalCategoryStruct.rightUnitor I₀).hom).comp
          (γ.comp (Abelian.Ext.mk₀ (MonoidalCategoryStruct.rightUnitor I₀).inv) (Nat.add_zero n))
          (Nat.zero_add n) = _
      rw [hu_hom, hu_inv]
    have hConjCancel : ∀ {A B : 𝒞} (e : A ≅ B) {p q pq : ℕ} (hpq : p + q = pq)
        (x : Abelian.Ext.{u} B B p) (y : Abelian.Ext.{u} B B q),
        ((Abelian.Ext.mk₀ e.hom).comp (x.comp (Abelian.Ext.mk₀ e.inv) (Nat.add_zero p))
            (Nat.zero_add p)).comp
          ((Abelian.Ext.mk₀ e.hom).comp (y.comp (Abelian.Ext.mk₀ e.inv) (Nat.add_zero q))
            (Nat.zero_add q)) hpq =
        (Abelian.Ext.mk₀ e.hom).comp
          ((x.comp y hpq).comp (Abelian.Ext.mk₀ e.inv) (Nat.add_zero pq))
          (Nat.zero_add pq) := by
      intro A B e p q pq hpq x y
      rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e.hom) _ _ (Nat.zero_add p) hpq (by omega),
          Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ e.inv) _ (Nat.add_zero p) (Nat.zero_add q) (by omega),
          ← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ e.inv) (Abelian.Ext.mk₀ e.hom) _
            (Nat.zero_add q),
          Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id, Abelian.Ext.mk₀_id_comp,
          ← Abelian.Ext.comp_assoc x y (Abelian.Ext.mk₀ e.inv) hpq (Nat.add_zero q) (by omega)]
    have hConjInj : ∀ {A B : 𝒞} (e : A ≅ B) {n : ℕ} (x y : Abelian.Ext.{u} B B n),
        (Abelian.Ext.mk₀ e.hom).comp (x.comp (Abelian.Ext.mk₀ e.inv) (Nat.add_zero n)) (Nat.zero_add n) =
        (Abelian.Ext.mk₀ e.hom).comp (y.comp (Abelian.Ext.mk₀ e.inv) (Nat.add_zero n)) (Nat.zero_add n) →
        x = y := by
      intro A B e n x y heq
      have h1 := congrArg
        (fun z : Abelian.Ext.{u} A A n =>
          ((Abelian.Ext.mk₀ e.inv).comp z (Nat.zero_add n)).comp
            (Abelian.Ext.mk₀ e.hom) (Nat.add_zero n)) heq
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add n),
          Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id, Abelian.Ext.mk₀_id_comp,
          Abelian.Ext.comp_assoc_of_third_deg_zero x _ _ (Nat.add_zero n),
          Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id, Abelian.Ext.comp_mk₀_id,
          ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add n),
          Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id, Abelian.Ext.mk₀_id_comp,
          Abelian.Ext.comp_assoc_of_third_deg_zero y _ _ (Nat.add_zero n),
          Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id, Abelian.Ext.comp_mk₀_id] at h1
      exact h1
    have hUnitComm : ∀ (α₀ : Abelian.Ext.{u} I₀ I₀ a₀) (β₀ : Abelian.Ext.{u} I₀ I₀ b₀),
        α₀.comp β₀ hab₀ = ((-1 : ℤ) ^ (a₀ * b₀)) • (β₀.comp α₀ hba₀) := by
      intro α₀ β₀
      have hk := hKoszul a₀ b₀ c₀ hab₀ hba₀ hP_unit hP_unit hP_unit hP_unit α₀ β₀
      rw [hextR_I₀ α₀, hextL_I₀ β₀,
          hConjCancel u_iso hab₀ α₀ β₀, hConjCancel u_iso hba₀ β₀ α₀,
          ← comp_zsmul (Abelian.Ext.mk₀ u_iso.hom),
          ← zsmul_comp (β₀.comp α₀ hba₀) (Abelian.Ext.mk₀ u_iso.inv)] at hk
      exact hConjInj u_iso (α₀.comp β₀ hab₀) (((-1 : ℤ) ^ (a₀ * b₀)) • (β₀.comp α₀ hba₀)) hk
    rcases hU with ⟨e_U⟩
    let α₀ : Abelian.Ext.{u} I₀ I₀ a₀ :=
      (Abelian.Ext.mk₀ e_U.hom).comp (α_u.comp (Abelian.Ext.mk₀ e_U.inv) (Nat.add_zero a₀)) (Nat.zero_add a₀)
    let β₀ : Abelian.Ext.{u} I₀ I₀ b₀ :=
      (Abelian.Ext.mk₀ e_U.hom).comp (β_u.comp (Abelian.Ext.mk₀ e_U.inv) (Nat.add_zero b₀)) (Nat.zero_add b₀)
    have hu := hUnitComm α₀ β₀
    dsimp only [α₀, β₀] at hu
    rw [hConjCancel e_U hab₀ α_u β_u, hConjCancel e_U hba₀ β_u α_u,
        ← comp_zsmul (Abelian.Ext.mk₀ e_U.hom),
        ← zsmul_comp (β_u.comp α_u hba₀) (Abelian.Ext.mk₀ e_U.inv)] at hu
    exact hConjInj e_U (α_u.comp β_u hab₀) (((-1 : ℤ) ^ (a₀ * b₀)) • (β_u.comp α_u hba₀)) hu

  intro R One_mod α β
  obtain ⟨C₀, instC₀, J₀, φ, hφ_inj, hφ_mul⟩ := part1_small_etale_ext_ring_iso W R
  letI := instC₀
  letI : (CategoryTheory.GrothendieckTopology.W J₀ (A := ModuleCat.{u, u} R)).IsMonoidal :=
    CategoryTheory.GrothendieckTopology.W.monoidal
  letI : CategoryTheory.MonoidalCategory (CategoryTheory.Sheaf J₀ (ModuleCat.{u, u} R)) :=
    CategoryTheory.Sheaf.monoidalCategory J₀ (ModuleCat.{u, u} R)
  let One₀ :=
    (CategoryTheory.constantSheaf J₀ (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
  obtain ⟨hUnitIso, P, hP_unit, hP_exact, hP_epi, hP_ker⟩ :=
    part2_small_sheaf_tensor_exact_resolution C₀ J₀ R
  have hcomm₀ :=
    part4_monoidal_abelian_unit_ext_graded_comm P hP_unit hP_exact hP_epi hP_ker
      One₀ hUnitIso a b c hab hba (φ a α) (φ b β)
  apply hφ_inj c
  rw [hφ_mul a b c hab α β, map_zsmul, hφ_mul b a c hba β α]
  exact hcomm₀

theorem weil_lefschetz_ell_adic_pullback_and_cup_ring (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      Nonempty (WeilLefschetzEllAdicSpace W ℓ m)) ∧
    (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m : ℕ)
      (H₁ : WeilLefschetzEllAdicSpace W₁ ℓ m) (H₂ : WeilLefschetzEllAdicSpace W₂ ℓ m),
      ∃! f : H₂.V →ₗ[Padic ℓ] H₁.V, WeilLefschetzIsEllAdicPullback h ℓ m H₁ H₂ f) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (H : WeilLefschetzEllAdicSpace W ℓ m),
      WeilLefschetzIsEllAdicPullback (CategoryTheory.CategoryStruct.id W) ℓ m H H LinearMap.id) ∧
    (∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Quiver.Hom W₁ W₂) (h₂ : Quiver.Hom W₂ W₃) (m : ℕ)
      (H₁ : WeilLefschetzEllAdicSpace W₁ ℓ m)
      (H₂ : WeilLefschetzEllAdicSpace W₂ ℓ m)
      (H₃ : WeilLefschetzEllAdicSpace W₃ ℓ m)
      (f₁ : H₂.V →ₗ[Padic ℓ] H₁.V) (f₂ : H₃.V →ₗ[Padic ℓ] H₂.V),
      WeilLefschetzIsEllAdicPullback h₁ ℓ m H₁ H₂ f₁ →
      WeilLefschetzIsEllAdicPullback h₂ ℓ m H₂ H₃ f₂ →
      WeilLefschetzIsEllAdicPullback (CategoryTheory.CategoryStruct.comp h₁ h₂) ℓ m H₁ H₃
        (f₁.comp f₂)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (a b c : ℕ) (hab : a + b = c)
      (H_a : WeilLefschetzEllAdicSpace W ℓ a)
      (H_b : WeilLefschetzEllAdicSpace W ℓ b)
      (H_c : WeilLefschetzEllAdicSpace W ℓ c),
