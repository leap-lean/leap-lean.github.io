theorem weil_kunneth_etale_slice_cosyzygy_representation (W₀ : AlgebraicGeometry.Scheme.{u}) (m₀ : ℕ) (hm₀ : 1 ≤ m₀)
    (hModComp : ∀ (W : AlgebraicGeometry.Scheme.{u}) (k : ℕ),
      (∃ θ : weilEtaleModuleH W m₀ k →+ weilEtaleTorsionH W m₀ k,
        WeilIsModuleToTorsionComparison W m₀ k θ ∧ Function.Bijective θ) ∧
      (∀ θ₁ θ₂ : weilEtaleModuleH W m₀ k →+ weilEtaleTorsionH W m₀ k,
        WeilIsModuleToTorsionComparison W m₀ k θ₁ →
        WeilIsModuleToTorsionComparison W m₀ k θ₂ →
        θ₁ = θ₂))
    (hModPull : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂),
      let R := ULift.{u, 0} (ZMod m₀)
      ∃ (hCont : (weilAltCdSitePullback h).IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology),
        letI := hCont
        let P_push := (weilAltCdSitePullback h).sheafPushforwardContinuous (ModuleCat.{u, u} R)
          W₂.smallEtaleTopology W₁.smallEtaleTopology
        ∃ (P_pull : CategoryTheory.Functor
              (CategoryTheory.Sheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R))
              (CategoryTheory.Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R)))
          (adj : P_pull ⊣ P_push)
          (hAdd : P_pull.Additive)
          (hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
          (hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
          (e_unit : weilEtaleModuleUnit W₁ m₀ ≅ P_pull.obj (weilEtaleModuleUnit W₂ m₀)),
          (∀ (I : CategoryTheory.Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R)),
