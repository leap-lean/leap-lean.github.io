theorem weil_gysin_etale_site_pullback_and_torsion_functoriality (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hContAll : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
      (weilEtaleSitePullback i).IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology) :
    WeilGysinSuppCalcHasExactPullbacks.{u} ∧
    ∃ τ_iso : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
        [CategoryTheory.IsIso i] (r : ℕ), WeilGysinSupportClass Z Y i (ℓ ^ r) 0,
      WeilGysinSuppCalcIsIsoUnit.{u} ℓ (@τ_iso) ∧
      ((∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          [CategoryTheory.IsIso i'] [CategoryTheory.IsIso i] (r : ℕ),
          WeilGysinSupportPullback g i' i (ℓ ^ r) 0 (τ_iso i' r) (τ_iso i r)) ∧
        (∀ (S : AlgebraicGeometry.Scheme.{u}) (r : ℕ)
          (cl : weilEtaleTorsionH S (ℓ ^ r) 0),
          WeilGysinForgetsTo (τ_iso (CategoryTheory.CategoryStruct.id S) r) cl →
          ∃ θ₀ : weilEtaleModuleH S (ℓ ^ r) 0 →+ weilEtaleTorsionH S (ℓ ^ r) 0,
            WeilIsModuleToTorsionComparison S (ℓ ^ r) 0 θ₀ ∧
            cl = θ₀ (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S (ℓ ^ r))))) ∧
        (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y) [CategoryTheory.IsIso i],
          ∃ α_iso : ∀ r : ℕ, WeilGysinAbSupportClass Z Y i (ℓ ^ r) 0,
            (∀ r : ℕ, WeilGysinIsAbSupportComparison (τ_iso i r) (α_iso r)) ∧
            (∀ r : ℕ, weilGysinAbSupportTransition ℓ r 0 (α_iso (r + 1)) = α_iso r))) ∧
      ((∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
          (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
          ∃! cl : weilEtaleTorsionH Y (ℓ ^ r) q, WeilGysinForgetsTo τ cl) ∧
        (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          (r q : ℕ)
          (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
          (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (cl' : weilEtaleTorsionH Y' (ℓ ^ r) q)
          (cl : weilEtaleTorsionH Y (ℓ ^ r) q)
          (p_g : weilEtaleTorsionH Y (ℓ ^ r) q →+ weilEtaleTorsionH Y' (ℓ ^ r) q),
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ →
          WeilGysinForgetsTo τ cl →
          WeilGysinForgetsTo τ' cl' →
          WeilLefschetzTorsionPullback g (ℓ ^ r) q p_g →
          p_g cl = cl') ∧
        (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (r q : ℕ),
          ∃! p_h : weilEtaleTorsionH W₂ (ℓ ^ r) q →+ weilEtaleTorsionH W₁ (ℓ ^ r) q,
            WeilLefschetzTorsionPullback h (ℓ ^ r) q p_h)) ∧
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i →
        ∀ (r q : ℕ)
          (τ_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q)
          (τ_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (α_succ : WeilGysinAbSupportClass Z Y i (ℓ ^ (r + 1)) q)
          (cl_succ : weilEtaleTorsionH Y (ℓ ^ (r + 1)) q)
          (cl_curr : weilEtaleTorsionH Y (ℓ ^ r) q),
          WeilGysinIsAbSupportComparison τ_succ α_succ →
          WeilGysinIsAbSupportComparison τ_curr (weilGysinAbSupportTransition ℓ r q α_succ) →
          WeilGysinForgetsTo τ_succ cl_succ →
          WeilGysinForgetsTo τ_curr cl_curr →
          weilEtaleTorsionTransition Y ℓ r q cl_succ = cl_curr) :=
by
  
  
  
  have sheaf_eq_of_obj_eq : ∀ {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
      {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : Sheaf J A},
      ℱ₁.obj = ℱ₂.obj → ℱ₁ = ℱ₂ := by
    intro C _ J A _ ⟨o₁, _⟩ ⟨o₂, _⟩ h
    change o₁ = o₂ at h
    subst h
    rfl

  have sheaf_hom_eq : ∀ {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
      {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : Sheaf J A}
      (f₁ f₂ : ℱ₁ ⟶ ℱ₂), (∀ W : Cᵒᵖ, f₁.hom.app W = f₂.hom.app W) → f₁ = f₂ := by
    intro C _ J A _ ℱ₁ ℱ₂ ⟨h₁⟩ ⟨h₂⟩ h
    congr 1
    exact NatTrans.ext (funext h)

  have inv_uniq : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] {X Y : C}
      {p : X ⟶ Y} {q₁ q₂ : Y ⟶ X}, q₁ ≫ p = 𝟙 Y → p ≫ q₂ = 𝟙 X → q₁ = q₂ :=
    fun {_} _ {_ _ p q₁ q₂} h₁ h₂ =>
      (Category.comp_id q₁).symm.trans
        ((congrArg (q₁ ≫ ·) h₂.symm).trans
          ((Category.assoc q₁ p q₂).symm.trans
            ((congrArg (· ≫ q₂) h₁).trans (Category.id_comp q₂))))

  have inv_uniq_et : ∀ {C : Type (u + 1)} [Category.{u, u + 1} C] {X Y : C}
      {p : X ⟶ Y} {q₁ q₂ : Y ⟶ X}, q₁ ≫ p = 𝟙 Y → p ≫ q₂ = 𝟙 X → q₁ = q₂ :=
    fun {_} _ {_ _ p q₁ q₂} h₁ h₂ =>
      (Category.comp_id q₁).symm.trans
        ((congrArg (q₁ ≫ ·) h₂.symm).trans
          ((Category.assoc q₁ p q₂).symm.trans
            ((congrArg (· ≫ q₂) h₁).trans (Category.id_comp q₂))))

  have ext_conj_eq : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C]
      [Abelian C] [HasExt.{u} C] {W₁ W₂ W₃ Z₁ Z₂ Z₃ : C} {i : ℕ}
      (a : W₁ ⟶ W₂) (a' : W₂ ⟶ W₃) (b' : Z₁ ⟶ Z₂) (b : Z₂ ⟶ Z₃)
      (y : Abelian.Ext W₃ Z₁ i),
      ((Abelian.Ext.mk₀ a).comp
        (((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (Nat.add_zero i))
          (Nat.zero_add i))) (Nat.zero_add i)).comp
        (Abelian.Ext.mk₀ b) (Nat.add_zero i) =
      (Abelian.Ext.mk₀ (a ≫ a')).comp (y.comp (Abelian.Ext.mk₀ (b' ≫ b)) (Nat.add_zero i))
        (Nat.zero_add i) := by
    intro C _ _ _ W₁ W₂ W₃ Z₁ Z₂ Z₃ i a a' b' b y
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add i),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (a ≫ a')) _ _ (Nat.zero_add i) (Nat.add_zero i) (by omega),
      Abelian.Ext.comp_assoc_of_third_deg_zero y _ _ (Nat.add_zero i),
      Abelian.Ext.mk₀_comp_mk₀]

  have hExtComp : ∀ {C D E : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      [Category.{u + 1, u + 1} E] [Abelian E] [HasExt.{u} E]
      (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (G : D ⥤ E) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (X Y : C) (n : ℕ) (x : Abelian.Ext X Y n),
      let _ : Limits.PreservesFiniteLimits (F ⋙ G) := Limits.comp_preservesFiniteLimits F G
      let _ : Limits.PreservesFiniteColimits (F ⋙ G) := Limits.comp_preservesFiniteColimits F G
      ((F ⋙ G).mapExtAddHom X Y n) x =
        (G.mapExtAddHom (F.obj X) (F.obj Y) n) ((F.mapExtAddHom X Y n) x) := by
    intro C D E _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ X Y n x
    have _ : (F ⋙ G).Additive := inferInstance
    have _ : Limits.PreservesFiniteLimits (F ⋙ G) := Limits.comp_preservesFiniteLimits F G
    have _ : Limits.PreservesFiniteColimits (F ⋙ G) := Limits.comp_preservesFiniteColimits F G
    dsimp only
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
    induction n generalizing Y with
    | zero =>
      have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x :=
        Abelian.Ext.addEquiv₀.left_inv x
      rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      let ι : Y ⟶ Injective.under Y := Injective.ι Y
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, ih S.X₃ z,
        Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_extClass]

  have hExtIso : ∀ {C D : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      (F G : C ⥤ D)
      [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (η : F ≅ G) (X Y : C) (n : ℕ) (x : Abelian.Ext X Y n),
      (G.mapExtAddHom X Y n) x =
        (Abelian.Ext.mk₀ (η.inv.app X)).comp
          (((F.mapExtAddHom X Y n) x).comp
            (Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero n))
          (Nat.zero_add n) := by
    intro C D _ _ _ _ _ _ _ F G _ _ _ _ _ _ η X Y n x
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
    induction n generalizing Y with
    | zero =>
      let f : X ⟶ Y := Abelian.Ext.addEquiv₀ x
      have hx : Abelian.Ext.mk₀ f = x := Abelian.Ext.addEquiv₀.left_inv x
      rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [η.hom.naturality f, ← Category.assoc, η.inv_hom_id_app, Category.id_comp]
    | succ k ih =>
      let ι : Y ⟶ Injective.under Y := Injective.ι Y
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        ih S.X₃ z, Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]
      let φ : S.map F ⟶ S.map G :=
        { τ₁ := η.hom.app S.X₁
          τ₂ := η.hom.app S.X₂
          τ₃ := η.hom.app S.X₃
          comm₁₂ := (η.hom.naturality S.f).symm
          comm₂₃ := (η.hom.naturality S.g).symm }
      have hnat := ShortComplex.ShortExact.extClass_naturality
        (hS.map_of_exact F) (hS.map_of_exact G) φ
      change (hS.map_of_exact F).extClass.comp (Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero 1) =
        (Abelian.Ext.mk₀ (η.hom.app S.X₃)).comp (hS.map_of_exact G).extClass (Nat.zero_add 1) at hnat
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl, hnat,
        ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (η.inv.app X)) _ _
          (Nat.zero_add k) rfl (by omega)]

  have hConstUnitMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [Category.{u, u + 1} 𝒜] [HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : Limits.IsTerminal T₁) (hT₂ : Limits.IsTerminal T₂)
      (φ : T₂ ⟶ T₁) (X : 𝒜),
      (constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).unit.app X ≫
        (((constantSheaf S.smallEtaleTopology 𝒜).obj X).obj.map φ.op) =
      (constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).unit.app X := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ φ X
    let J := S.smallEtaleTopology
    let P_X := (Functor.const S.Etaleᵒᵖ).obj X
    let η_X := (sheafificationAdjunction J 𝒜).unit.app P_X
    have h_nat := η_X.naturality φ.op
    dsimp [P_X] at h_nat
    rw [Category.id_comp] at h_nat
    have h_u₁ : (constantSheafAdj J 𝒜 hT₁).unit.app X = η_X.app (Opposite.op T₁) := by
      dsimp only [constantSheafAdj]
      rw [Adjunction.comp_unit_app, constantPresheafAdj_unit_app, Category.id_comp]; rfl
    have h_u₂ : (constantSheafAdj J 𝒜 hT₂).unit.app X = η_X.app (Opposite.op T₂) := by
      dsimp only [constantSheafAdj]
      rw [Adjunction.comp_unit_app, constantPresheafAdj_unit_app, Category.id_comp]; rfl
    rw [h_u₁, h_u₂]
    exact h_nat.symm

  have hConstSymmMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [Category.{u, u + 1} 𝒜] [HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : Limits.IsTerminal T₁) (hT₂ : Limits.IsTerminal T₂) (X : 𝒜)
      (ℱ : Sheaf S.smallEtaleTopology 𝒜) (f : X ⟶ ℱ.obj.obj (Opposite.op T₁)),
      ((constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).homEquiv X ℱ).symm
        (f ≫ ℱ.obj.map (hT₁.from T₂).op) =
      ((constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).homEquiv X ℱ).symm f := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ X ℱ f
    let J := S.smallEtaleTopology
    set rhs := ((constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ).symm f
    apply ((constantSheafAdj J 𝒜 hT₂).homEquiv X ℱ).injective
    rw [Equiv.apply_symm_apply]
    have h₁ : ((constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ) rhs = f := Equiv.apply_symm_apply _ _
    rw [Adjunction.homEquiv_unit] at h₁ ⊢
    change (constantSheafAdj J 𝒜 hT₁).unit.app X ≫ rhs.hom.app (Opposite.op T₁) = f at h₁
    change f ≫ ℱ.obj.map (hT₁.from T₂).op =
      (constantSheafAdj J 𝒜 hT₂).unit.app X ≫ rhs.hom.app (Opposite.op T₂)
    rw [← hConstUnitMap hT₁ hT₂ (hT₁.from T₂) X, Category.assoc,
      rhs.hom.naturality (hT₁.from T₂).op, ← Category.assoc, h₁]

  have hq_indep : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [Category.{u, u + 1} 𝒜]
      [HasWeakSheafify Y.smallEtaleTopology 𝒜] [HasWeakSheafify Z.smallEtaleTopology 𝒜]
      (B : Y.Etale ⥤ Z.Etale) [B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology]
      {T_Y₁ T_Y₂ : Y.Etale} (hT_Y₁ : Limits.IsTerminal T_Y₁) (hT_Y₂ : Limits.IsTerminal T_Y₂)
      {T_Z₁ T_Z₂ : Z.Etale} (hT_Z₁ : Limits.IsTerminal T_Z₁) (hT_Z₂ : Limits.IsTerminal T_Z₂)
      (A : 𝒜),
      let i_push := B.sheafPushforwardContinuous 𝒜 Y.smallEtaleTopology Z.smallEtaleTopology
      let One_Z := (constantSheaf Z.smallEtaleTopology 𝒜).obj A
      let adj_Y₁ := constantSheafAdj Y.smallEtaleTopology 𝒜 hT_Y₁
      let adj_Z₁ := constantSheafAdj Z.smallEtaleTopology 𝒜 hT_Z₁
      let adj_Y₂ := constantSheafAdj Y.smallEtaleTopology 𝒜 hT_Y₂
      let adj_Z₂ := constantSheafAdj Z.smallEtaleTopology 𝒜 hT_Z₂
      (adj_Y₁.homEquiv A (i_push.obj One_Z)).symm
        (adj_Z₁.unit.app A ≫ One_Z.obj.map (hT_Z₁.from (B.obj T_Y₁)).op) =
      (adj_Y₂.homEquiv A (i_push.obj One_Z)).symm
        (adj_Z₂.unit.app A ≫ One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op) := by
    intro Z Y 𝒜 _ _ _ B _ T_Y₁ T_Y₂ hT_Y₁ hT_Y₂ T_Z₁ T_Z₂ hT_Z₁ hT_Z₂ A
      i_push One_Z adj_Y₁ adj_Z₁ adj_Y₂ adj_Z₂
    refine (congrArg (adj_Y₁.homEquiv A (i_push.obj One_Z)).symm ?_).trans
      (hConstSymmMap hT_Y₂ hT_Y₁ A (i_push.obj One_Z)
        (adj_Z₂.unit.app A ≫ One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op))
    have hu : adj_Z₁.unit.app A = adj_Z₂.unit.app A ≫ One_Z.obj.map (hT_Z₂.from T_Z₁).op :=
      (hConstUnitMap hT_Z₂ hT_Z₁ (hT_Z₂.from T_Z₁) A).symm
    change adj_Z₁.unit.app A ≫ One_Z.obj.map (hT_Z₁.from (B.obj T_Y₁)).op =
      (adj_Z₂.unit.app A ≫ One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op) ≫
        One_Z.obj.map (B.map (hT_Y₂.from T_Y₁)).op
    rw [hu, Category.assoc, Category.assoc, ← One_Z.obj.map_comp, ← One_Z.obj.map_comp,
      ← op_comp, ← op_comp]
    congr 2
    exact congrArg Quiver.Hom.op (hT_Z₂.hom_ext _ _)

  have hπ_iso_of_term : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [Category.{u, u + 1} 𝒜]
      [HasWeakSheafify W₁.smallEtaleTopology 𝒜] [HasWeakSheafify W₂.smallEtaleTopology 𝒜]
      (B : W₂.Etale ⥤ W₁.Etale) [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology]
      (pb : Sheaf W₂.smallEtaleTopology 𝒜 ⥤ Sheaf W₁.smallEtaleTopology 𝒜)
      (adj : pb ⊣ B.sheafPushforwardContinuous 𝒜 W₂.smallEtaleTopology W₁.smallEtaleTopology)
      {T₁ : W₁.Etale} (hT₁ : Limits.IsTerminal T₁)
      {T₂ : W₂.Etale} (hT₂ : Limits.IsTerminal T₂)
      (hBT₂ : Limits.IsTerminal (B.obj T₂)) (A : 𝒜),
      let pf := B.sheafPushforwardContinuous 𝒜 W₂.smallEtaleTopology W₁.smallEtaleTopology
      let C₁ := constantSheaf W₁.smallEtaleTopology 𝒜
      let C₂ := constantSheaf W₂.smallEtaleTopology 𝒜
      let adj₁ := constantSheafAdj W₁.smallEtaleTopology 𝒜 hT₁
      let adj₂ := constantSheafAdj W₂.smallEtaleTopology 𝒜 hT₂
      let τ_h : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
      let π_A : pb.obj (C₂.obj A) ⟶ C₁.obj A :=
        (adj.homEquiv (C₂.obj A) (C₁.obj A)).symm
          ((adj₂.homEquiv A (pf.obj (C₁.obj A))).symm
            (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ_h.op))
      ∃ ι_A : C₁.obj A ⟶ pb.obj (C₂.obj A),
        ι_A ≫ π_A = 𝟙 (C₁.obj A) ∧ π_A ≫ ι_A = 𝟙 (pb.obj (C₂.obj A)) := by
    intro W₁ W₂ 𝒜 _ _ _ B _ pb adj T₁ hT₁ T₂ hT₂ hBT₂ A pf C₁ C₂ adj₁ adj₂ τ_h π_A
    let τ_inv : T₁ ⟶ B.obj T₂ := hBT₂.from T₁
    let θ_sec : (sheafSections W₁.smallEtaleTopology 𝒜).obj (Opposite.op T₁) ≅
        pf ⋙ (sheafSections W₂.smallEtaleTopology 𝒜).obj (Opposite.op T₂) :=
      NatIso.ofComponents
        (fun ℱ =>
          { hom := ℱ.obj.map τ_h.op
            inv := ℱ.obj.map τ_inv.op
            hom_inv_id := by
              change ℱ.obj.map τ_h.op ≫ ℱ.obj.map τ_inv.op = 𝟙 _
              rw [← ℱ.obj.map_comp, ← op_comp, hT₁.hom_ext (τ_inv ≫ τ_h) (𝟙 T₁),
                op_id, ℱ.obj.map_id]
            inv_hom_id := by
              change ℱ.obj.map τ_inv.op ≫ ℱ.obj.map τ_h.op = 𝟙 _
              rw [← ℱ.obj.map_comp, ← op_comp, hBT₂.hom_ext (τ_h ≫ τ_inv) (𝟙 (B.obj T₂)),
                op_id, ℱ.obj.map_id] })
        (fun {_ _} u => (u.hom.naturality τ_h.op).symm)
    let adj_L := adj₂.comp adj
    let adj_R := adj₁.ofNatIsoRight θ_sec
    let α_iso : C₂ ⋙ pb ≅ C₁ := adj_L.leftAdjointUniq adj_R
    have hα_eq : α_iso.hom.app A = π_A := by
      apply (adj_L.homEquiv A (C₁.obj A)).injective
      have hL : adj_L.homEquiv A (C₁.obj A) (α_iso.hom.app A) = adj_R.unit.app A :=
        Adjunction.homEquiv_leftAdjointUniq_hom_app adj_L adj_R A
      have hR : adj_L.homEquiv A (C₁.obj A) π_A =
          adj₁.unit.app A ≫ (C₁.obj A).obj.map τ_h.op := by
        dsimp only [adj_L, π_A]
        rw [Adjunction.comp_homEquiv]
        dsimp only [Equiv.trans_apply]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      exact hL.trans hR.symm
    refine ⟨α_iso.inv.app A, ?_, ?_⟩
    · rw [← hα_eq]; exact α_iso.inv_hom_id_app A
    · rw [← hα_eq]; exact α_iso.hom_inv_id_app A

  have hasSheafCompose_of_adj : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {L : B ⥤ A} {F : A ⥤ B} (_ : L ⊣ F), J.HasSheafCompose F := by
    intro C _ J A B _ _ L F adj
    refine ⟨fun P hP E => ?_⟩
    let isoE : (P ⋙ F) ⋙ coyoneda.obj (Opposite.op E) ≅
        P ⋙ coyoneda.obj (Opposite.op (L.obj E)) :=
      NatIso.ofComponents
        (fun W => (adj.homEquiv E (P.obj W)).symm.toIso)
        (fun {_ _} u => by ext g; exact Adjunction.homEquiv_naturality_right_symm adj g (P.map u))
    exact Presieve.isSheaf_iso J isoE.symm (hP (L.obj E))

  let sheafComposeAdjRight : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {F : A ⥤ B} {G : B ⥤ A} (adj : F ⊣ G) [J.HasSheafCompose F] [J.HasSheafCompose G],
      sheafCompose J F ⊣ sheafCompose J G := fun {C} _ J {A B} _ _ {F G} adj _ _ =>
    let liftEquiv (P : Cᵒᵖ ⥤ A) (Q : Cᵒᵖ ⥤ B) : (P ⋙ F ⟶ Q) ≃ (P ⟶ Q ⋙ G) :=
      { toFun := fun φ =>
          { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
            naturality := fun {W₁ W₂} u => by
              have hnat : F.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
              change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
                adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ G.map (Q.map u)
              rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
                ← Adjunction.homEquiv_naturality_left adj] }
        invFun := fun ψ =>
          { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
            naturality := fun {W₁ W₂} u => by
              have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ G.map (Q.map u) := ψ.naturality u
              change F.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
                (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
              rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
                ← Adjunction.homEquiv_naturality_right_symm adj] }
        left_inv := fun φ => by ext W; exact (adj.homEquiv _ _).symm_apply_apply _
        right_inv := fun ψ => by ext W; exact (adj.homEquiv _ _).apply_symm_apply _ }
    Adjunction.mkOfHomEquiv
      { homEquiv := fun ℱ 𝒢 =>
          { toFun := fun φ => ⟨liftEquiv ℱ.obj 𝒢.obj φ.hom⟩
            invFun := fun ψ => ⟨(liftEquiv ℱ.obj 𝒢.obj).symm ψ.hom⟩
            left_inv := fun φ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).symm_apply_apply φ.hom
            right_inv := fun ψ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).apply_symm_apply ψ.hom }
        homEquiv_naturality_left_symm := fun {_ _ _} h ψ => by
          ext W; exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
        homEquiv_naturality_right := fun {_ _ _} φ k => by
          ext W; exact Adjunction.homEquiv_naturality_right adj (φ.hom.app W) (k.hom.app W) }

  let sheafComposeAdjLeft : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {L : B ⥤ A} {F : A ⥤ B} (adj : L ⊣ F) [J.HasSheafCompose F] [HasWeakSheafify J A],
      (sheafToPresheaf J B ⋙ (Functor.whiskeringRight Cᵒᵖ B A).obj L ⋙
          presheafToSheaf J A) ⊣
        sheafCompose J F := fun {C} _ J {A B} _ _ {L F} adj _ _ =>
    let liftTo (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (φ : P ⋙ L ⟶ Q) : P ⟶ Q ⋙ F :=
      { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
        naturality := fun {W₁ W₂} u => by
          have hnat : L.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
          change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
            adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ F.map (Q.map u)
          rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
            ← Adjunction.homEquiv_naturality_left adj] }
    let liftInv (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (ψ : P ⟶ Q ⋙ F) : P ⋙ L ⟶ Q :=
      { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
        naturality := fun {W₁ W₂} u => by
          have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ F.map (Q.map u) := ψ.naturality u
          change L.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
            (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
          rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
            ← Adjunction.homEquiv_naturality_right_symm adj] }
    Adjunction.mkOfHomEquiv
      { homEquiv := fun 𝒢 ℱ =>
          { toFun := fun φ =>
              ⟨liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ)⟩
            invFun := fun ψ =>
              ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ).symm
                (liftInv 𝒢.obj ℱ.obj ψ.hom)
            left_inv := fun φ => by
              have h : liftInv 𝒢.obj ℱ.obj
                  (liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ)) =
                  (sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ := by
                ext W; exact (adj.homEquiv _ _).symm_apply_apply _
              exact (congrArg ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ).symm h).trans
                (Equiv.symm_apply_apply _ φ)
            right_inv := fun ψ => by
              ext W
              have h := Equiv.apply_symm_apply
                ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ)
                (liftInv 𝒢.obj ℱ.obj ψ.hom)
              exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ.obj.obj W))
                (congrArg (fun α => α.app W) h)).trans
                ((adj.homEquiv _ _).apply_symm_apply (ψ.hom.app W)) }
        homEquiv_naturality_left_symm := fun {𝒢' 𝒢 ℱ} h ψ => by
          have h1 : liftInv 𝒢'.obj ℱ.obj ((h ≫ ψ).hom) =
              Functor.whiskerRight h.hom L ≫ liftInv 𝒢.obj ℱ.obj ψ.hom := by
            ext W; exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
          exact (congrArg ((sheafificationAdjunction J A).homEquiv (𝒢'.obj ⋙ L) ℱ).symm h1).trans
            (Adjunction.homEquiv_naturality_left_symm
              (sheafificationAdjunction J A) (Functor.whiskerRight h.hom L)
              (liftInv 𝒢.obj ℱ.obj ψ.hom))
        homEquiv_naturality_right := fun {𝒢 ℱ ℱ'} φ k => by
          ext W
          have h1 := Adjunction.homEquiv_naturality_right (sheafificationAdjunction J A) φ k
          exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ'.obj.obj W))
            (congrArg (fun α => α.app W) h1)).trans
            (Adjunction.homEquiv_naturality_right adj _ (k.hom.app W)) }

  
  
  
  have exists_affine_spec_point : ∀ {S : Scheme.{u}} (U : S.Etale)
      (y : ((Scheme.Etale.forget S).obj U).left),
      ∃ (R : CommRingCat.{u}) (f : Spec R ⟶ ((Scheme.Etale.forget S).obj U).left) (z₀ : Spec R),
        Etale f ∧ f.base z₀ = y := by
    intro S U y
    let X := ((Scheme.Etale.forget S).obj U).left
    obtain ⟨_, ⟨V, hV, rfl⟩, hyV, -⟩ :=
      (Scheme.isBasis_affineOpens X).exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
    have : IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
    refine ⟨X.presheaf.obj (Opposite.op V), hV.fromSpec, hV.isoSpec.hom.base ⟨y, hyV⟩, inferInstance, ?_⟩
    have hcomp : hV.isoSpec.hom ≫ hV.fromSpec = Scheme.Opens.ι V := by
      simp [IsAffineOpen.fromSpec]
    change (hV.isoSpec.hom ≫ hV.fromSpec).base ⟨y, hyV⟩ = y
    rw [hcomp]
    rfl

  have preservesFiniteLimits_lan_of_flat : ∀ {D : Type u} [SmallCategory D]
      {E : Type (u + 1)} [Category.{u, u + 1} E] (F₀ : D ⥤ E) [RepresentablyFlat F₀],
      Limits.PreservesFiniteLimits
        (F₀.op.lan : (Dᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Eᵒᵖ ⥤ AddCommGrpCat.{u})) := by
    intro D _ E _ F₀ _
    refine ⟨fun J _ _ => ?_⟩
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    let U : E := Opposite.unop Y
    have _ : IsCofiltered (StructuredArrow U F₀) := RepresentablyFlat.cofiltered U
    have _ : IsFiltered (StructuredArrow U F₀)ᵒᵖ := isFiltered_op_of_isCofiltered _
    let e_arrow : (StructuredArrow U F₀)ᵒᵖ ≌ CostructuredArrow F₀.op (Opposite.op U) :=
      { functor :=
          { obj := fun X => CostructuredArrow.mk (Y := Opposite.op (Opposite.unop X).right)
              (Opposite.unop X).hom.op
            map := fun {X₁ X₂} f =>
              CostructuredArrow.homMk f.unop.right.op (by
                dsimp; rw [← op_comp, StructuredArrow.w f.unop]) }
        inverse :=
          { obj := fun W => Opposite.op (StructuredArrow.mk (Y := Opposite.unop W.left) W.hom.unop)
            map := fun {W₁ W₂} g =>
              (StructuredArrow.homMk g.left.unop (by
                dsimp; exact Quiver.Hom.op_inj (CostructuredArrow.w g))).op }
        unitIso := NatIso.ofComponents
          (fun _ => Iso.op (StructuredArrow.isoMk (Iso.refl _) (by dsimp; simp)))
          (fun _ => Quiver.Hom.unop_inj (by ext; simp))
        counitIso := NatIso.ofComponents
          (fun _ => CostructuredArrow.isoMk (Iso.refl _) (by dsimp; simp))
          (fun _ => by ext; simp)
        functor_unitIso_comp := fun _ => by ext; simp }
    have _ : IsFiltered (CostructuredArrow F₀.op Y) := IsFiltered.of_equivalence e_arrow
    have _ : Limits.PreservesLimitsOfShape J
        (Limits.colim (J := CostructuredArrow F₀.op Y) (C := AddCommGrpCat.{u})) :=
      Limits.filtered_colim_preservesFiniteLimits
    have _ : Limits.PreservesLimitsOfShape J
        ((Functor.whiskeringLeft (CostructuredArrow F₀.op Y) Dᵒᵖ AddCommGrpCat.{u}).obj
          (CostructuredArrow.proj F₀.op Y) ⋙ Limits.colim) :=
      Limits.comp_preservesLimitsOfShape _ _
    let isoP : ∀ P : Dᵒᵖ ⥤ AddCommGrpCat.{u},
        (F₀.op.lan ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u}).obj Y).obj P ≅
          ((Functor.whiskeringLeft (CostructuredArrow F₀.op Y) Dᵒᵖ AddCommGrpCat.{u}).obj
            (CostructuredArrow.proj F₀.op Y) ⋙ Limits.colim).obj P :=
      fun P => F₀.op.leftKanExtensionObjIsoColimit P Y
    let iso_lan : F₀.op.lan ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u}).obj Y ≅
        (Functor.whiskeringLeft (CostructuredArrow F₀.op Y) Dᵒᵖ AddCommGrpCat.{u}).obj
          (CostructuredArrow.proj F₀.op Y) ⋙ Limits.colim :=
      NatIso.ofComponents isoP (fun {P₁ P₂} α => by
        apply (Iso.cancel_iso_inv_left (isoP P₁) _ _).mp
        rw [Iso.inv_hom_id_assoc]
        apply Limits.colimit.hom_ext
        intro j
        let f_lan : ∀ Z : Eᵒᵖ, (F₀.op.leftKanExtension P₁).obj Z ⟶
            (F₀.op.leftKanExtension P₂).obj Z := fun Z => (F₀.op.lan.map α).app Z
        have hf_nat : ∀ {Z₁ Z₂ : Eᵒᵖ} (u : Z₁ ⟶ Z₂),
            (F₀.op.leftKanExtension P₁).map u ≫ f_lan Z₂ =
              f_lan Z₁ ≫ (F₀.op.leftKanExtension P₂).map u :=
          fun u => (F₀.op.lan.map α).naturality u
        have hunit : α.app j.left ≫ (F₀.op.leftKanExtensionUnit P₂).app j.left =
            (F₀.op.leftKanExtensionUnit P₁).app j.left ≫ f_lan (F₀.op.obj j.left) :=
          NatTrans.congr_app (F₀.op.lanUnit.naturality α) j.left
        change Limits.colimit.ι (CostructuredArrow.proj F₀.op Y ⋙ P₁) j ≫
            ((F₀.op.leftKanExtensionObjIsoColimit P₁ Y).inv ≫
              (f_lan Y ≫ (F₀.op.leftKanExtensionObjIsoColimit P₂ Y).hom)) =
          Limits.colimit.ι (CostructuredArrow.proj F₀.op Y ⋙ P₁) j ≫
            Limits.colim.map (Functor.whiskerLeft (CostructuredArrow.proj F₀.op Y) α)
        rw [Limits.colimit.ι_map, ← Category.assoc, F₀.op.ι_leftKanExtensionObjIsoColimit_inv P₁ Y j,
          Category.assoc ((F₀.op.leftKanExtensionUnit P₁).app j.left),
          ← Category.assoc ((F₀.op.leftKanExtension P₁).map j.hom), hf_nat j.hom,
          Category.assoc (f_lan (F₀.op.obj j.left)),
          ← Category.assoc ((F₀.op.leftKanExtensionUnit P₁).app j.left),
          ← hunit, Category.assoc (α.app j.left),
          F₀.op.leftKanExtensionUnit_leftKanExtension_map_leftKanExtensionObjIsoColimit_hom P₂ Y j]
        rfl)
    exact Limits.preservesLimitsOfShape_of_natIso iso_lan.symm

  have hSitePullExact : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂),
      let B := weilEtaleSitePullback h
      letI : B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := hContAll h
      Limits.PreservesFiniteLimits B ∧
      ∃ (_ : (B.sheafPushforwardContinuous AddCommGrpCat.{u}
          W₂.smallEtaleTopology W₁.smallEtaleTopology).IsRightAdjoint),
        Limits.PreservesFiniteLimits
          (B.sheafPullback AddCommGrpCat.{u} W₂.smallEtaleTopology W₁.smallEtaleTopology) := by
    intro W₁ W₂ h
    let P_et : MorphismProperty Scheme.{u} := @Etale
    let B : W₂.Etale ⥤ W₁.Etale := weilEtaleSitePullback h
    have _ : B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := hContAll h
    let J₁ := W₁.smallEtaleTopology
    let J₂ := W₂.smallEtaleTopology
    let Fgt₁ := Scheme.Etale.forget W₁
    let Fgt₂ := Scheme.Etale.forget W₂
    have _ : Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
      (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    have _ : Limits.PreservesFiniteLimits (B ⋙ Fgt₁) := by
      change Limits.PreservesFiniteLimits (Fgt₂ ⋙ CategoryTheory.Over.pullback h)
      infer_instance
    have hLimB : Limits.PreservesFiniteLimits B :=
      Limits.preservesFiniteLimits_of_reflects_of_preserves B Fgt₁
    refine ⟨hLimB, ?_⟩
    let t₂_std := weilEtaleIdTerminal.{u} W₂
    let ht₂_std := weilEtaleIdTerminalIsTerminal.{u} W₂
    let e_small := equivSmallModel.{u} W₂.AffineEtale
    let g₀ : SmallModel.{u} W₂.AffineEtale → W₂.Etale := fun i =>
      let W := e_small.inverse.obj i
      MorphismProperty.Over.mk ⊤ W.hom W.prop
    let Stage₂_data : ℕ → Σ (X : Type u), (X → W₂.Etale) :=
      Nat.rec
        ⟨PUnit.{u + 1} ⊕ SmallModel.{u} W₂.AffineEtale, Sum.elim (fun _ => t₂_std) g₀⟩
        (fun _ prev =>
          ⟨prev.1 ⊕ Σ (a b c : prev.1) (f₁ : prev.2 a ⟶ prev.2 c) (f₂ : prev.2 b ⟶ prev.2 c),
            PUnit.{1},
           Sum.elim prev.2 (fun p => Limits.pullback p.2.2.2.1 p.2.2.2.2.1)⟩)
    let Idx₂ : Type u := Σ n : ℕ, (Stage₂_data n).1
    let eval₂ : Idx₂ → W₂.Etale := fun p => (Stage₂_data p.1).2 p.2
    let D₂ : Type u := InducedCategory W₂.Etale eval₂
    let G₂ : D₂ ⥤ W₂.Etale := inducedFunctor eval₂
    have lift_add : ∀ (n d : ℕ) (x : (Stage₂_data n).1),
        ∃ y : (Stage₂_data (n + d)).1, (Stage₂_data (n + d)).2 y = (Stage₂_data n).2 x := by
      intro n d x
      induction d with
      | zero => exact ⟨x, rfl⟩
      | succ _ ih => obtain ⟨y, hy⟩ := ih; exact ⟨Sum.inl y, hy⟩
    have lift_le : ∀ {n N : ℕ} (hle : n ≤ N) (x : (Stage₂_data n).1),
        ∃ y : (Stage₂_data N).1, (Stage₂_data N).2 y = eval₂ ⟨n, x⟩ := by
      intro n N hle x
      obtain ⟨y, hy⟩ := lift_add n (N - n) x
      have hN : n + (N - n) = N := Nat.add_sub_of_le hle
      revert y; rw [hN]; exact fun y hy => ⟨y, hy⟩
    let t₀ : D₂ := (⟨0, Sum.inl PUnit.unit⟩ : Idx₂)
    have ht₀ : Limits.IsTerminal t₀ :=
      Limits.IsTerminal.ofUniqueHom
        (fun d => InducedCategory.homMk (ht₂_std.from (eval₂ d)))
        (fun d m => InducedCategory.hom_ext (ht₂_std.hom_ext m.hom _))
    have _ : Limits.HasTerminal D₂ := ht₀.hasTerminal
    have _ : Limits.PreservesLimit (Functor.empty.{0} D₂) G₂ := by
      have hmap_term : Limits.IsLimit (G₂.mapCone (Limits.asEmptyCone t₀)) :=
        { lift := fun s => (ht₂_std.from s.pt : s.pt ⟶ t₂_std)
          fac := fun _ j => j.as.elim
          uniq := fun s m _ => ht₂_std.hom_ext (m : s.pt ⟶ t₂_std) _ }
      exact Limits.preservesLimit_of_preserves_limit_cone ht₀ hmap_term
    have _ : Limits.PreservesLimitsOfShape (Discrete PEmpty.{1}) G₂ :=
      Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G₂
    have hCospan : ∀ (K : Limits.WalkingCospan ⥤ D₂),
        ∃ (c : Limits.Cone K), Nonempty (Limits.IsLimit (G₂.mapCone c)) := by
      intro K
      let d₁ : Idx₂ := K.obj Limits.WalkingCospan.left
      let d₂ : Idx₂ := K.obj Limits.WalkingCospan.right
      let d₃ : Idx₂ := K.obj Limits.WalkingCospan.one
      let u := K.map Limits.WalkingCospan.Hom.inl
      let v := K.map Limits.WalkingCospan.Hom.inr
      obtain ⟨N, ⟨x₁, hx₁⟩, ⟨x₂, hx₂⟩, ⟨x₃, hx₃⟩⟩ :
          ∃ N : ℕ,
            (∃ x₁ : (Stage₂_data N).1, (Stage₂_data N).2 x₁ = G₂.obj (K.obj Limits.WalkingCospan.left)) ∧
            (∃ x₂ : (Stage₂_data N).1, (Stage₂_data N).2 x₂ = G₂.obj (K.obj Limits.WalkingCospan.right)) ∧
            (∃ x₃ : (Stage₂_data N).1, (Stage₂_data N).2 x₃ = G₂.obj (K.obj Limits.WalkingCospan.one)) :=
        ⟨max d₁.1 (max d₂.1 d₃.1),
          lift_le (le_max_left _ _) d₁.2,
          lift_le ((le_max_left _ _).trans (le_max_right _ _)) d₂.2,
          lift_le ((le_max_right _ _).trans (le_max_right _ _)) d₃.2⟩
      let X₁ : W₂.Etale := (Stage₂_data N).2 x₁
      let X₂ : W₂.Etale := (Stage₂_data N).2 x₂
      let X₃ : W₂.Etale := (Stage₂_data N).2 x₃
      let f₁ : X₁ ⟶ X₃ := eqToHom hx₁ ≫ G₂.map u ≫ eqToHom hx₃.symm
      let f₂ : X₂ ⟶ X₃ := eqToHom hx₂ ≫ G₂.map v ≫ eqToHom hx₃.symm
      let pr₁_et : Limits.pullback f₁ f₂ ⟶ G₂.obj (K.obj Limits.WalkingCospan.left) :=
        Limits.pullback.fst f₁ f₂ ≫ eqToHom hx₁
      let pr₂_et : Limits.pullback f₁ f₂ ⟶ G₂.obj (K.obj Limits.WalkingCospan.right) :=
        Limits.pullback.snd f₁ f₂ ≫ eqToHom hx₂
      have hcond_et : pr₁_et ≫ G₂.map u = pr₂_et ≫ G₂.map v := by
        have h1 : (Limits.pullback.fst f₁ f₂ ≫ f₁) ≫ eqToHom hx₃ = pr₁_et ≫ G₂.map u := by
          dsimp only [f₁, pr₁_et]
          rw [Category.assoc, Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl,
            Category.comp_id, Category.assoc]
        have h2 : (Limits.pullback.snd f₁ f₂ ≫ f₂) ≫ eqToHom hx₃ = pr₂_et ≫ G₂.map v := by
          dsimp only [f₂, pr₂_et]
          rw [Category.assoc, Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl,
            Category.comp_id, Category.assoc]
        rw [← h1, ← h2, Limits.pullback.condition]
      have hlim_pure : Limits.IsLimit (Limits.PullbackCone.mk pr₁_et pr₂_et hcond_et) := by
        refine Limits.PullbackCone.IsLimit.mk hcond_et
          (fun s => Limits.pullback.lift (s.fst ≫ eqToHom hx₁.symm) (s.snd ≫ eqToHom hx₂.symm) (by
            dsimp only [f₁, f₂]
            rw [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp,
              Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp,
              ← Category.assoc, s.condition, Category.assoc]))
          (fun s => by
            dsimp only [pr₁_et]
            rw [← Category.assoc, Limits.pullback.lift_fst, Category.assoc,
              eqToHom_trans, eqToHom_refl, Category.comp_id])
          (fun s => by
            dsimp only [pr₂_et]
            rw [← Category.assoc, Limits.pullback.lift_snd, Category.assoc,
              eqToHom_trans, eqToHom_refl, Category.comp_id])
          (fun s m hm₁ hm₂ => by
            apply Limits.pullback.hom_ext
            · rw [Limits.pullback.lift_fst]
              calc
                m ≫ Limits.pullback.fst f₁ f₂
                  = m ≫ Limits.pullback.fst f₁ f₂ ≫ (eqToHom hx₁ ≫ eqToHom hx₁.symm) := by
                      rw [eqToHom_trans, eqToHom_refl, Category.comp_id]
                _ = (m ≫ pr₁_et) ≫ eqToHom hx₁.symm := by
                      dsimp only [pr₁_et]; simp only [Category.assoc]
                _ = s.fst ≫ eqToHom hx₁.symm := by rw [hm₁]
            · rw [Limits.pullback.lift_snd]
              calc
                m ≫ Limits.pullback.snd f₁ f₂
                  = m ≫ Limits.pullback.snd f₁ f₂ ≫ (eqToHom hx₂ ≫ eqToHom hx₂.symm) := by
                      rw [eqToHom_trans, eqToHom_refl, Category.comp_id]
                _ = (m ≫ pr₂_et) ≫ eqToHom hx₂.symm := by
                      dsimp only [pr₂_et]; simp only [Category.assoc]
                _ = s.snd ≫ eqToHom hx₂.symm := by rw [hm₂])
      let p_obj : D₂ := (⟨N + 1, Sum.inr ⟨x₁, x₂, x₃, f₁, f₂, PUnit.unit⟩⟩ : Idx₂)
      let p₁ : p_obj ⟶ K.obj Limits.WalkingCospan.left := InducedCategory.homMk pr₁_et
      let p₂ : p_obj ⟶ K.obj Limits.WalkingCospan.right := InducedCategory.homMk pr₂_et
      have hcond_D : p₁ ≫ u = p₂ ≫ v := InducedCategory.hom_ext hcond_et
      let c₀ : Limits.PullbackCone u v := Limits.PullbackCone.mk p₁ p₂ hcond_D
      have hc₀_lim : Limits.IsLimit (G₂.mapCone c₀) :=
        (Limits.PullbackCone.isLimitMapConeEquiv c₀ G₂).symm hlim_pure
      let c : Limits.Cone K := (Limits.Cone.postcompose (Limits.diagramIsoCospan K).inv).obj c₀
      refine ⟨c, ⟨?_⟩⟩
      let isoMap : G₂.mapCone c ≅
          (Limits.Cone.postcompose (Functor.isoWhiskerRight (Limits.diagramIsoCospan K) G₂).inv).obj
            (G₂.mapCone c₀) :=
        Limits.Cone.ext (Iso.refl _) (fun _ => by
          dsimp [c]; rw [Functor.map_comp, Category.id_comp])
      exact Limits.IsLimit.ofIsoLimit
        ((Limits.IsLimit.postcomposeInvEquiv
          (Functor.isoWhiskerRight (Limits.diagramIsoCospan K) G₂) _).symm hc₀_lim)
        isoMap.symm
    have _ : Limits.HasPullbacks D₂ :=
      ⟨fun K => let ⟨c, ⟨hc⟩⟩ := hCospan K; ⟨⟨c, Limits.isLimitOfReflects G₂ hc⟩⟩⟩
    have _ : Limits.PreservesLimitsOfShape Limits.WalkingCospan G₂ :=
      ⟨fun {K} =>
        let ⟨c, ⟨hc⟩⟩ := hCospan K
        Limits.preservesLimit_of_preserves_limit_cone (Limits.isLimitOfReflects G₂ hc) hc⟩
    have _ : Limits.HasFiniteLimits D₂ :=
      Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have _ : Limits.PreservesFiniteLimits G₂ :=
      Limits.preservesFiniteLimits_of_preservesTerminal_and_pullbacks G₂
    have _ : G₂.IsCoverDense J₂ := by
      refine ⟨fun U => ?_⟩
      have hJ₂ := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology W₂
        (le_refl P_et)
      suffices hgoal : Sieve.coverByImage G₂ U ∈
          (Scheme.smallPretopology P_et P_et).toGrothendieck U by
        change Sieve.coverByImage G₂ U ∈ Scheme.smallGrothendieckTopology P_et W₂ U
        rwa [hJ₂]
      refine (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et)
        U (Sieve.coverByImage G₂ U)).mpr fun y => ?_
      obtain ⟨R, f_spec, z₀, hf_et, hz₀⟩ := exists_affine_spec_point U y
      let W : W₂.AffineEtale :=
        MorphismProperty.Comma.mk
          { left := Opposite.op R
            right := Discrete.mk PUnit.unit
            hom := f_spec ≫ (Fgt₂.obj U).hom }
          (MorphismProperty.comp_mem P_et _ _ hf_et U.prop)
      let i : SmallModel.{u} W₂.AffineEtale := e_small.functor.obj W
      let isoW : e_small.inverse.obj i ≅ W := (e_small.unitIso.app W).symm
      let Fgt_aff : W₂.AffineEtale ⥤ Comma Scheme.Spec (Functor.fromPUnit.{0} W₂) :=
        MorphismProperty.Comma.forget _ _ _ _ _
      let isoW_comma := Fgt_aff.mapIso isoW
      let α_left : (e_small.inverse.obj i).left ⟶ Opposite.op R := isoW_comma.hom.left
      let β_left : Opposite.op R ⟶ (e_small.inverse.obj i).left := isoW_comma.inv.left
      have hαβ : α_left ≫ β_left = 𝟙 _ := congrArg CommaMorphism.left isoW_comma.hom_inv_id
      have hβα : β_left ≫ α_left = 𝟙 _ := congrArg CommaMorphism.left isoW_comma.inv_hom_id
      have hw_comma : Scheme.Spec.map α_left ≫ (f_spec ≫ (Fgt₂.obj U).hom) =
          (e_small.inverse.obj i).hom ≫ 𝟙 W₂ := isoW_comma.hom.w
      let s_hom : Scheme.Spec.obj (e_small.inverse.obj i).left ⟶ Spec R := Scheme.Spec.map α_left
      let s_inv : Spec R ⟶ Scheme.Spec.obj (e_small.inverse.obj i).left := Scheme.Spec.map β_left
      have hs_hom_inv : s_hom ≫ s_inv = 𝟙 _ := by
        dsimp only [s_hom, s_inv]; rw [← Scheme.Spec.map_comp, hαβ, Scheme.Spec.map_id]
      have hs_inv_hom : s_inv ≫ s_hom = 𝟙 (Spec R) := by
        dsimp only [s_hom, s_inv]; rw [← Scheme.Spec.map_comp, hβα, Scheme.Spec.map_id]; rfl
      have _ : IsIso s_hom := ⟨⟨s_inv, hs_hom_inv, hs_inv_hom⟩⟩
      have hs_et : P_et s_hom := MorphismProperty.of_isIso P_et s_hom
      have hcomp_et : P_et (s_hom ≫ f_spec) :=
        MorphismProperty.comp_mem P_et s_hom f_spec hs_et hf_et
      have hw_over : (s_hom ≫ f_spec) ≫ (Fgt₂.obj U).hom = (e_small.inverse.obj i).hom := by
        dsimp only [s_hom]; rw [Category.assoc, hw_comma]; exact Category.comp_id _
      let d_i : D₂ := (⟨0, Sum.inr i⟩ : Idx₂)
      let u_et : G₂.obj d_i ⟶ U := MorphismProperty.Over.homMk (s_hom ≫ f_spec) hw_over
      refine ⟨G₂.obj d_i, u_et, s_inv.base z₀, Presieve.in_coverByImage G₂ u_et, hcomp_et, ?_⟩
      change (s_inv ≫ (s_hom ≫ f_spec)).base z₀ = y
      rw [← Category.assoc, hs_inv_hom, Category.id_comp]
      exact hz₀
    let K₂ := G₂.inducedTopology J₂
    have _ : Functor.IsDenseSubsite K₂ J₂ G₂ := inferInstance
    let E₂ := G₂.sheafPushforwardContinuous AddCommGrpCat.{u} K₂ J₂
    let eE₂ := E₂.asEquivalence
    let F₀ : D₂ ⥤ W₁.Etale := G₂ ⋙ B
    have _ : F₀.IsContinuous K₂ J₁ := Functor.isContinuous_comp G₂ B K₂ J₂ J₁
    have _ : Limits.PreservesFiniteLimits F₀ := Limits.comp_preservesFiniteLimits G₂ B
    have _ : RepresentablyFlat F₀ := flat_of_preservesFiniteLimits F₀
    have _ : Limits.PreservesFiniteLimits F₀.op.lan := preservesFiniteLimits_lan_of_flat F₀
    let P_F₀ := F₀.sheafPushforwardContinuous AddCommGrpCat.{u} K₂ J₁
    let adj_F₀ := F₀.sheafAdjunctionContinuous AddCommGrpCat.{u} K₂ J₁
    have _ : Limits.PreservesFiniteLimits (F₀.sheafPullback AddCommGrpCat.{u} K₂ J₁) :=
      Functor.sheafPullbackConstruction.preservesFiniteLimits F₀ AddCommGrpCat.{u} K₂ J₁
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let iso_push : P_F₀ ⋙ eE₂.inverse ≅ P_push :=
      (Functor.isoWhiskerRight
        (Functor.sheafPushforwardContinuousComp G₂ B AddCommGrpCat.{u} K₂ J₂ J₁).symm
        eE₂.inverse) ≪≫
      Functor.associator P_push eE₂.functor eE₂.inverse ≪≫
      Functor.isoWhiskerLeft P_push eE₂.unitIso.symm ≪≫
      Functor.rightUnitor P_push
    let adj_tot : (E₂ ⋙ F₀.sheafPullback AddCommGrpCat.{u} K₂ J₁) ⊣ P_push :=
      (eE₂.toAdjunction.comp adj_F₀).ofNatIsoRight iso_push
    have hAdj_push : P_push.IsRightAdjoint := ⟨_, ⟨adj_tot⟩⟩
    let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let Φ : B.sheafPullback AddCommGrpCat.{u} J₂ J₁ ≅
        E₂ ⋙ F₀.sheafPullback AddCommGrpCat.{u} K₂ J₁ :=
      adj_pull.leftAdjointUniq adj_tot
    have _ : Limits.PreservesFiniteLimits (E₂ ⋙ F₀.sheafPullback AddCommGrpCat.{u} K₂ J₁) :=
      Limits.comp_preservesFiniteLimits _ _
    exact ⟨hAdj_push, Limits.preservesFiniteLimits_of_natIso Φ.symm⟩

  
  
  
  let z_to_m_of (m : ℕ) :
      AddCommGrpCat.of (ULift.{u} ℤ) ⟶
        AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)) :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }

  have hHasSC_fgt : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      S.smallEtaleTopology.HasSheafCompose
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    exact hasSheafCompose_of_adj S.smallEtaleTopology
      (eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R)))

  let U_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) ⥤
        Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    let _ := hHasSC_fgt S m
    sheafCompose S.smallEtaleTopology
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u})

  have hAdd_U : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ), (U_of S m).Additive :=
    fun _ _ => { map_add := by intros; ext W x; rfl }

  have hLim_U : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      Limits.PreservesFiniteLimits (U_of S m) ∧
      Limits.PreservesFiniteColimits (U_of S m) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let adjModL := eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R))
    let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      eZ.inverse ⋙ ModuleCat.coextendScalars (Int.castRingHom R)
    let adjModR := (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
    have _ : J.HasSheafCompose C_mod := hasSheafCompose_of_adj J adjModR
    have _ : (U_of S m).IsLeftAdjoint := ⟨sheafCompose J C_mod, ⟨sheafComposeAdjRight J adjModR⟩⟩
    have _ : (U_of S m).IsRightAdjoint := ⟨_, ⟨sheafComposeAdjLeft J adjModL⟩⟩
    exact ⟨inferInstance, inferInstance⟩

  let One_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
    (constantSheaf S.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))).obj
      (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m)))

  let T_of (S : AlgebraicGeometry.Scheme.{u}) : S.Etale := weilEtaleIdTerminal.{u} S
  let hT_of (S : AlgebraicGeometry.Scheme.{u}) : Limits.IsTerminal (T_of S) :=
    weilEtaleIdTerminalIsTerminal.{u} S

  let ιM_of (m : ℕ) :
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)) ⟶
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).obj
          (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) :=
    AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u, 0} (ZMod m)))

  let u₀_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).obj
          (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) ⟶
        ((sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op (T_of S))).obj ((U_of S m).obj (One_of S m)) :=
    (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).map
      ((constantSheafAdj S.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) (hT_of S)).unit.app
        (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))))

  let αM_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      weilEtaleTorsionSheaf S m ⟶ (U_of S m).obj (One_of S m) :=
    ((constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
      ((U_of S m).obj (One_of S m))).symm (ιM_of m ≫ u₀_of S m)

  have h_αM_homEquiv : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      (constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
        ((U_of S m).obj (One_of S m)) (αM_of S m) = ιM_of m ≫ u₀_of S m :=
    fun _ _ => Equiv.apply_symm_apply _ _

  have hαM_indep : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      (T_S : S.Etale) (hT_S : Limits.IsTerminal T_S),
      let R := ULift.{u, 0} (ZMod m)
      let R_mod := ModuleCat.of R R
      let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let adj_ab_S := constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
      let adj_mod_S := constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT_S
      (adj_ab_S.homEquiv AM ((U_of S m).obj (One_of S m))).symm
        (ιM_of m ≫ F_fg.map (adj_mod_S.unit.app R_mod)) = αM_of S m := by
    intro S m T_S hT_S R R_mod F_fg AM adj_ab_S adj_mod_S
    let φ : T_S ⟶ T_of S := (hT_of S).from T_S
    have hu := hConstUnitMap (hT_of S) hT_S φ R_mod
    have hmap : ιM_of m ≫ F_fg.map (adj_mod_S.unit.app R_mod) =
        (ιM_of m ≫ u₀_of S m) ≫ ((U_of S m).obj (One_of S m)).obj.map φ.op := by
      rw [← hu, F_fg.map_comp, ← Category.assoc]; rfl
    exact (congrArg (adj_ab_S.homEquiv AM ((U_of S m).obj (One_of S m))).symm hmap).trans
      (hConstSymmMap (hT_of S) hT_S AM ((U_of S m).obj (One_of S m)) (ιM_of m ≫ u₀_of S m))

  have hβM_exists : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      ∃ βM : (U_of S m).obj (One_of S m) ⟶ weilEtaleTorsionSheaf S m,
        αM_of S m ≫ βM = 𝟙 (weilEtaleTorsionSheaf S m) ∧
        βM ≫ αM_of S m = 𝟙 ((U_of S m).obj (One_of S m)) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      eZ.inverse ⋙ ModuleCat.coextendScalars (Int.castRingHom R)
    let adjModR : FgtMod ⊣ C_mod :=
      (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
    have _ : J.HasSheafCompose C_mod := hasSheafCompose_of_adj J adjModR
    let C_sh := sheafCompose J C_mod
    let eShR (ℱ : Sheaf J (ModuleCat.{u, u} R)) (𝒢 : Sheaf J AddCommGrpCat.{u}) :
        ((U_of S m).obj ℱ ⟶ 𝒢) ≃ (ℱ ⟶ C_sh.obj 𝒢) :=
      (sheafComposeAdjRight J adjModR).homEquiv ℱ 𝒢
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let R_mod := ModuleCat.of R R
    let FM := weilEtaleTorsionSheaf S m
    let oneR := One_of S m
    let adjℤ := constantSheafAdj J AddCommGrpCat.{u} (hT_of S)
    let adjR := constantSheafAdj J (ModuleCat.{u, u} R) (hT_of S)
    let ιM_inv : FgtMod.obj R_mod ⟶ AM := AddCommGrpCat.ofHom (AddMonoidHom.id R)
    have hιM_1 : ιM_of m ≫ ιM_inv = 𝟙 AM := by ext ⟨x⟩; rfl
    have hιM_2 : ιM_inv ≫ ιM_of m = 𝟙 (FgtMod.obj R_mod) := by ext ⟨x⟩; rfl
    let evMod (𝒢 : Sheaf J AddCommGrpCat.{u}) :
        (R_mod ⟶ ((sheafSections J (ModuleCat.{u, u} R)).obj (Opposite.op (T_of S))).obj (C_sh.obj 𝒢)) ≃
          (FgtMod.obj R_mod ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) :=
      (adjModR.homEquiv R_mod (𝒢.obj.obj (Opposite.op (T_of S)))).symm
    let preEqv (𝒢 : Sheaf J AddCommGrpCat.{u}) :
        (FgtMod.obj R_mod ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) ≃
          (AM ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) :=
      { toFun := fun f => ιM_of m ≫ f
        invFun := fun g => ιM_inv ≫ g
        left_inv := fun f => by dsimp only; rw [← Category.assoc, hιM_2, Category.id_comp]
        right_inv := fun g => by dsimp only; rw [← Category.assoc, hιM_1, Category.id_comp] }
    let eHom (𝒢 : Sheaf J AddCommGrpCat.{u}) : ((U_of S m).obj oneR ⟶ 𝒢) ≃ (FM ⟶ 𝒢) :=
      (eShR oneR 𝒢).trans
        ((adjR.homEquiv R_mod (C_sh.obj 𝒢)).trans
          ((evMod 𝒢).trans ((preEqv 𝒢).trans (adjℤ.homEquiv AM 𝒢).symm)))
    have heHom_apply : ∀ (𝒢 : Sheaf J AddCommGrpCat.{u}) (φ : (U_of S m).obj oneR ⟶ 𝒢),
        eHom 𝒢 φ = αM_of S m ≫ φ := by
      intro 𝒢 φ
      apply (adjℤ.homEquiv AM 𝒢).injective
      change (adjℤ.homEquiv AM 𝒢) ((adjℤ.homEquiv AM 𝒢).symm
        (ιM_of m ≫ (evMod 𝒢) ((adjR.homEquiv R_mod (C_sh.obj 𝒢)) ((eShR oneR 𝒢) φ)))) =
        (adjℤ.homEquiv AM 𝒢) (αM_of S m ≫ φ)
      rw [Equiv.apply_symm_apply, Adjunction.homEquiv_naturality_right adjℤ (αM_of S m) φ,
        h_αM_homEquiv, Category.assoc]
      congr 1
      apply (evMod 𝒢).symm.injective
      rw [Equiv.symm_apply_apply]
      have h_app : ((eShR oneR 𝒢) φ).hom.app (Opposite.op (T_of S)) =
          adjModR.homEquiv (oneR.obj.obj (Opposite.op (T_of S)))
            (𝒢.obj.obj (Opposite.op (T_of S))) (φ.hom.app (Opposite.op (T_of S))) := by
        dsimp only [eShR, sheafComposeAdjRight]
        rw [Adjunction.mkOfHomEquiv_homEquiv]
        rfl
      have h_adjR : adjR.homEquiv R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ) =
          adjR.unit.app R_mod ≫ ((eShR oneR 𝒢) φ).hom.app (Opposite.op (T_of S)) :=
        Adjunction.homEquiv_unit adjR R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ)
      rw [h_adjR, h_app]
      exact (Adjunction.homEquiv_naturality_left adjModR
        (adjR.unit.app R_mod) (φ.hom.app (Opposite.op (T_of S)))).symm
    let βM : (U_of S m).obj oneR ⟶ FM := (eHom FM).symm (𝟙 FM)
    have hαβ : αM_of S m ≫ βM = 𝟙 FM := by
      rw [← heHom_apply FM βM]; exact (eHom FM).apply_symm_apply (𝟙 FM)
    have hβα : βM ≫ αM_of S m = 𝟙 ((U_of S m).obj oneR) := by
      apply (eHom ((U_of S m).obj oneR)).injective
      rw [heHom_apply, heHom_apply, Category.comp_id, ← Category.assoc, hαβ, Category.id_comp]
    exact ⟨βM, hαβ, hβα⟩

  let βM_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (U_of S m).obj (One_of S m) ⟶ weilEtaleTorsionSheaf S m :=
    Classical.choose (hβM_exists S m)
  have hαβ_of : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      αM_of S m ≫ βM_of S m = 𝟙 (weilEtaleTorsionSheaf S m) :=
    fun S m => (Classical.choose_spec (hβM_exists S m)).1
  have hβα_of : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      βM_of S m ≫ αM_of S m = 𝟙 ((U_of S m).obj (One_of S m)) :=
    fun S m => (Classical.choose_spec (hβM_exists S m)).2

  let ιℤ_std (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ (U_of S m).obj (One_of S m) :=
    (constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map (z_to_m_of m) ≫ αM_of S m

  have h_ιℤ_std_ev : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      (constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
        (AddCommGrpCat.of (ULift.{u} ℤ)) ((U_of S m).obj (One_of S m)) (ιℤ_std S m) =
      z_to_m_of m ≫ ιM_of m ≫ u₀_of S m := by
    intro S m
    dsimp only [ιℤ_std]
    rw [Adjunction.homEquiv_naturality_left _ (z_to_m_of m) (αM_of S m), h_αM_homEquiv]

  
  have hU_ff_and_lift : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      Nonempty ((U_of S m).FullyFaithful) ∧
      (∀ ℱ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))),
        m • 𝟙 ((U_of S m).obj ℱ) = 0) ∧
      (∀ (ℬ : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        m • 𝟙 ℬ = 0 →
        ∃ ℬ_mod : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))),
          (U_of S m).obj ℬ_mod = ℬ) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    have hLiftModHom : ∀ {M N : ModuleCat.{u, u} R} (g : FgtMod.obj M ⟶ FgtMod.obj N),
        ∃ f : M ⟶ N, FgtMod.map f = g := by
      intro M N g
      refine ⟨ModuleCat.ofHom
        { toFun := g.hom.toFun
          map_add' := g.hom.map_add'
          map_smul' := fun r x => by
            obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
            have hzr : (z : R) = r := by ext; exact hz
            simp only [RingHom.id_apply, ← hzr]
            rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
            exact map_zsmul g.hom z x }, ?_⟩
      ext x; rfl
    have hFgtInj : ∀ {M N : ModuleCat.{u, u} R} {f₁ f₂ : M ⟶ N},
        FgtMod.map f₁ = FgtMod.map f₂ → f₁ = f₂ := by
      intro M N f₁ f₂ h; ext x; exact congrArg (fun k => k x) h
    have hUFaith : ∀ {ℱ₁ ℱ₂ : Sheaf J (ModuleCat.{u, u} R)} {ψ₁ ψ₂ : ℱ₁ ⟶ ℱ₂},
        (U_of S m).map ψ₁ = (U_of S m).map ψ₂ → ψ₁ = ψ₂ := by
      intro ℱ₁ ℱ₂ ψ₁ ψ₂ h; ext W x; exact congrArg (fun k => k.hom.app W x) h
    have hUFull : ∀ {ℱ₁ ℱ₂ : Sheaf J (ModuleCat.{u, u} R)}
        (φ : (U_of S m).obj ℱ₁ ⟶ (U_of S m).obj ℱ₂),
        ∃ ψ : ℱ₁ ⟶ ℱ₂, (U_of S m).map ψ = φ := by
      intro ℱ₁ ℱ₂ φ
      choose appL happL using fun W => hLiftModHom (φ.hom.app W)
      refine ⟨⟨{ app := appL
                 naturality := fun {W₁ W₂} u => hFgtInj (by
                   rw [FgtMod.map_comp, FgtMod.map_comp, happL W₁, happL W₂]
                   exact φ.hom.naturality u) }⟩, ?_⟩
      ext W x; exact congrArg (fun k => k x) (happL W)
    let ff_U : (U_of S m).FullyFaithful :=
      { preimage := fun {ℱ₁ ℱ₂} φ => Classical.choose (hUFull φ)
        map_preimage := fun {ℱ₁ ℱ₂} φ => Classical.choose_spec (hUFull φ)
        preimage_map := fun {ℱ₁ ℱ₂} ψ => hUFaith (Classical.choose_spec (hUFull ((U_of S m).map ψ))) }
    let upHom : ZMod m →+* R :=
      { toFun := ULift.up, map_one' := rfl, map_mul' := fun _ _ => rfl,
        map_zero' := rfl, map_add' := fun _ _ => rfl }
    let downHom : R →+* ZMod m :=
      { toFun := ULift.down, map_one' := rfl, map_mul' := fun _ _ => rfl,
        map_zero' := rfl, map_add' := fun _ _ => rfl }
    refine ⟨⟨ff_U⟩, fun ℱ => ?_, fun ℬ hm => ?_⟩
    · ext W x
      let M_W : Type u := ℱ.obj.obj W
      let modZ : Module (ZMod m) M_W := Module.compHom M_W upHom
      exact @ZModModule.char_nsmul_eq_zero m M_W _ modZ x
    · let objMod (W : (S.Etale)ᵒᵖ) : ModuleCat.{u, u} R :=
        let hmW : ∀ x : ℬ.obj.obj W, m • x = 0 := fun x => by
          change ((m • 𝟙 ℬ).hom.app W) x = 0; rw [hm]; rfl
        letI : Module (ZMod m) (ℬ.obj.obj W) := AddCommGroup.zmodModule hmW
        letI : Module R (ℬ.obj.obj W) := Module.compHom (ℬ.obj.obj W) downHom
        ModuleCat.of R (ℬ.obj.obj W)
      choose mapMod hmapMod using fun {W₁ W₂ : (S.Etale)ᵒᵖ} (u : W₁ ⟶ W₂) =>
        hLiftModHom (M := objMod W₁) (N := objMod W₂) (ℬ.obj.map u)
      let P_mod : (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
        { obj := objMod
          map := fun u => mapMod u
          map_id := fun W => hFgtInj (by rw [hmapMod, FgtMod.map_id]; exact ℬ.obj.map_id W)
          map_comp := fun u v => hFgtInj (by
            rw [hmapMod, FgtMod.map_comp, hmapMod, hmapMod]; exact ℬ.obj.map_comp u v) }
      have hP_comp : P_mod ⋙ FgtMod = ℬ.obj := by
        refine CategoryTheory.Functor.ext (fun _ => rfl) (fun _ _ u => ?_)
        dsimp; rw [Category.id_comp, Category.comp_id]; exact hmapMod u
      have hIsSheaf : Presheaf.IsSheaf J P_mod := by
        intro E
        let eqvW (W : (S.Etale)ᵒᵖ) : (E ⟶ objMod W) ≃ (FgtMod.obj E ⟶ ℬ.obj.obj W) :=
          { toFun := fun f => FgtMod.map f
            invFun := fun g => Classical.choose (hLiftModHom (M := E) (N := objMod W) g)
            left_inv := fun f => hFgtInj (Classical.choose_spec
              (hLiftModHom (M := E) (N := objMod W) (FgtMod.map f)))
            right_inv := fun g => Classical.choose_spec (hLiftModHom (M := E) (N := objMod W) g) }
        let isoE : P_mod ⋙ coyoneda.obj (Opposite.op E) ≅
            ℬ.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E)) :=
          NatIso.ofComponents (fun W => (eqvW W).toIso) (fun {_ _} u => by
            ext f; change FgtMod.map (f ≫ mapMod u) = FgtMod.map f ≫ ℬ.obj.map u
            rw [FgtMod.map_comp, hmapMod])
        exact Presieve.isSheaf_iso J isoE.symm (ℬ.property (FgtMod.obj E))
      exact ⟨⟨P_mod, hIsSheaf⟩, sheaf_eq_of_obj_eq hP_comp⟩

  
  let γ_pf {Z Y : AlgebraicGeometry.Scheme.{u}} (B : Y.Etale ⥤ Z.Etale)
      [B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology] (m : ℕ)
      (𝒢 : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))) :
      (B.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Z.smallEtaleTopology).obj ((U_of Z m).obj 𝒢) ≅
        (U_of Y m).obj ((B.sheafPushforwardContinuous
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
          Y.smallEtaleTopology Z.smallEtaleTopology).obj 𝒢) :=
    { hom := ⟨{ app := fun _ => 𝟙 _
                naturality := fun {_ _} _ => (Category.comp_id _).trans (Category.id_comp _).symm }⟩
      inv := ⟨{ app := fun _ => 𝟙 _
                naturality := fun {_ _} _ => (Category.comp_id _).trans (Category.id_comp _).symm }⟩
      hom_inv_id := sheaf_hom_eq _ _ (fun _ => Category.id_comp _)
      inv_hom_id := sheaf_hom_eq _ _ (fun _ => Category.id_comp _) }

  
  have hModPullLift : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m : ℕ),
      let R := ULift.{u, 0} (ZMod m)
      let B := weilEtaleSitePullback h
      letI : B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := hContAll h
      let pf_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      let pf_mod := B.sheafPushforwardContinuous (ModuleCat.{u, u} R)
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      ∀ (pb_ab : Sheaf W₂.smallEtaleTopology AddCommGrpCat.{u} ⥤
          Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u})
        (adj_ab : pb_ab ⊣ pf_ab)
        [pb_ab.Additive] [Limits.PreservesFiniteLimits pb_ab] [Limits.PreservesFiniteColimits pb_ab],
        ∃ (pb_mod : Sheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R) ⥤
              Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R))
          (adj_mod : pb_mod ⊣ pf_mod)
          (_ : pb_mod.Additive)
          (_ : Limits.PreservesFiniteLimits pb_mod)
          (_ : Limits.PreservesFiniteColimits pb_mod)
          (θ_lift : pb_mod ⋙ U_of W₁ m ≅ U_of W₂ m ⋙ pb_ab),
          let R_mod := ModuleCat.of R R
          let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
          let C_ab₁ := constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}
          let C_ab₂ := constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
          let adj_ab₁ := constantSheafAdj W₁.smallEtaleTopology AddCommGrpCat.{u} (hT_of W₁)
          let adj_ab₂ := constantSheafAdj W₂.smallEtaleTopology AddCommGrpCat.{u} (hT_of W₂)
          let adj_mod₁ := constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of W₁)
          let adj_mod₂ := constantSheafAdj W₂.smallEtaleTopology (ModuleCat.{u, u} R) (hT_of W₂)
          let τ_h : B.obj (T_of W₂) ⟶ T_of W₁ := (hT_of W₁).from (B.obj (T_of W₂))
          let π_mod : pb_mod.obj (One_of W₂ m) ⟶ One_of W₁ m :=
            (adj_mod.homEquiv (One_of W₂ m) (One_of W₁ m)).symm
              ((adj_mod₂.homEquiv R_mod (pf_mod.obj (One_of W₁ m))).symm
                (adj_mod₁.unit.app R_mod ≫ (One_of W₁ m).obj.map τ_h.op))
          let πM_ab : pb_ab.obj (C_ab₂.obj AM) ⟶ C_ab₁.obj AM :=
            (adj_ab.homEquiv (C_ab₂.obj AM) (C_ab₁.obj AM)).symm
              ((adj_ab₂.homEquiv AM (pf_ab.obj (C_ab₁.obj AM))).symm
                (adj_ab₁.unit.app AM ≫ (C_ab₁.obj AM).obj.map τ_h.op))
          pb_ab.map (αM_of W₂ m) ≫ θ_lift.inv.app (One_of W₂ m) ≫ (U_of W₁ m).map π_mod =
            πM_ab ≫ αM_of W₁ m := by
    intro W₁ W₂ h m R B pf_ab pf_mod pb_ab adj_ab _ _ _
    have _ : B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := hContAll h
    let U₁ := U_of W₁ m
    let U₂ := U_of W₂ m
    have _ := hAdd_U W₁ m; have _ := (hLim_U W₁ m).1; have _ := (hLim_U W₁ m).2
    have _ := hAdd_U W₂ m; have _ := (hLim_U W₂ m).1; have _ := (hLim_U W₂ m).2
    obtain ⟨⟨ff₁⟩, _, hLift₁⟩ := hU_ff_and_lift W₁ m
    obtain ⟨⟨ff₂⟩, hm_tors₂, _⟩ := hU_ff_and_lift W₂ m
    have _ := ff₁.full; have _ := ff₁.faithful
    have _ := ff₂.full; have _ := ff₂.faithful
    have hTor_pb : ∀ ℱ : Sheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R),
        m • 𝟙 (pb_ab.obj (U₂.obj ℱ)) = 0 := by
      intro ℱ
      rw [← pb_ab.map_id, ← pb_ab.map_nsmul, hm_tors₂ ℱ, pb_ab.map_zero]
    choose pb_obj hpb_obj using fun ℱ => hLift₁ (pb_ab.obj (U₂.obj ℱ)) (hTor_pb ℱ)
    let pb_mod : Sheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R) ⥤
        Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R) :=
      { obj := pb_obj
        map := fun {ℱ₁ ℱ₂} u =>
          ff₁.preimage (eqToHom (hpb_obj ℱ₁) ≫ pb_ab.map (U₂.map u) ≫ eqToHom (hpb_obj ℱ₂).symm)
        map_id := fun ℱ => ff₁.map_injective (by
          rw [ff₁.map_preimage, U₂.map_id, pb_ab.map_id, Category.id_comp,
            eqToHom_trans, eqToHom_refl, U₁.map_id])
        map_comp := fun {ℱ₁ ℱ₂ ℱ₃} u v => ff₁.map_injective (by
          rw [ff₁.map_preimage, U₁.map_comp, ff₁.map_preimage, ff₁.map_preimage,
            U₂.map_comp, pb_ab.map_comp]
          simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]) }
    let θ_lift : pb_mod ⋙ U₁ ≅ U₂ ⋙ pb_ab :=
      NatIso.ofComponents (fun ℱ => eqToIso (hpb_obj ℱ)) (fun {ℱ₁ ℱ₂} u => by
        change U₁.map (pb_mod.map u) ≫ eqToHom (hpb_obj ℱ₂) =
          eqToHom (hpb_obj ℱ₁) ≫ pb_ab.map (U₂.map u)
        dsimp only [pb_mod]
        rw [ff₁.map_preimage, Category.assoc, Category.assoc, eqToHom_trans,
          eqToHom_refl, Category.comp_id])
    have hAdd_mod : pb_mod.Additive :=
      { map_add := fun {ℱ₁ ℱ₂ f g} => ff₁.map_injective (by
          dsimp only [pb_mod]
          rw [U₁.map_add, ff₁.map_preimage, ff₁.map_preimage, ff₁.map_preimage,
            U₂.map_add, pb_ab.map_add, Preadditive.add_comp, Preadditive.comp_add]) }
    have _ : Limits.PreservesFiniteLimits (U₂ ⋙ pb_ab) := Limits.comp_preservesFiniteLimits U₂ pb_ab
    have _ : Limits.PreservesFiniteColimits (U₂ ⋙ pb_ab) := Limits.comp_preservesFiniteColimits U₂ pb_ab
    have _ : Limits.PreservesFiniteLimits (pb_mod ⋙ U₁) :=
      Limits.preservesFiniteLimits_of_natIso θ_lift.symm
    have _ : Limits.PreservesFiniteColimits (pb_mod ⋙ U₁) :=
      Limits.preservesFiniteColimits_of_natIso θ_lift.symm
    have _ : Limits.ReflectsLimitsOfSize.{0, 0} U₁ :=
      @Limits.fullyFaithful_reflectsLimits.{0, 0} _ _ _ _ U₁ _ _
    have _ : Limits.ReflectsColimitsOfSize.{0, 0} U₁ :=
      @Limits.fullyFaithful_reflectsColimits.{0, 0} _ _ _ _ U₁ _ _
    have hLim_mod : Limits.PreservesFiniteLimits pb_mod :=
      Limits.preservesFiniteLimits_of_reflects_of_preserves pb_mod U₁
    have hColim_mod : Limits.PreservesFiniteColimits pb_mod :=
      Limits.preservesFiniteColimits_of_reflects_of_preserves pb_mod U₁
    have hpf_map : ∀ {𝒢₁ 𝒢₂ : Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R)} (v : 𝒢₁ ⟶ 𝒢₂),
        pf_ab.map (U₁.map v) ≫ (γ_pf B m 𝒢₂).hom =
          (γ_pf B m 𝒢₁).hom ≫ U₂.map (pf_mod.map v) :=
      fun _ => sheaf_hom_eq _ _ (fun _ => (Category.comp_id _).trans (Category.id_comp _).symm)
    let coreEquiv (ℱ : Sheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R))
        (𝒢 : Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R)) :
        (pb_mod.obj ℱ ⟶ 𝒢) ≃ (ℱ ⟶ pf_mod.obj 𝒢) :=
      { toFun := fun f =>
          ff₂.preimage (adj_ab.homEquiv (U₂.obj ℱ) (U₁.obj 𝒢)
            (θ_lift.inv.app ℱ ≫ U₁.map f) ≫ (γ_pf B m 𝒢).hom)
        invFun := fun g =>
          ff₁.preimage (θ_lift.hom.app ℱ ≫ (adj_ab.homEquiv (U₂.obj ℱ) (U₁.obj 𝒢)).symm
            (U₂.map g ≫ (γ_pf B m 𝒢).inv))
        left_inv := fun f => ff₁.map_injective (by
          rw [ff₁.map_preimage, ff₂.map_preimage, Category.assoc,
            (γ_pf B m 𝒢).hom_inv_id, Category.comp_id, Equiv.symm_apply_apply,
            θ_lift.hom_inv_id_app_assoc])
        right_inv := fun g => ff₂.map_injective (by
          rw [ff₂.map_preimage, ff₁.map_preimage, θ_lift.inv_hom_id_app_assoc,
            Equiv.apply_symm_apply, Category.assoc, (γ_pf B m 𝒢).inv_hom_id, Category.comp_id]) }
    let adj_mod : pb_mod ⊣ pf_mod :=
      Adjunction.mkOfHomEquiv
        { homEquiv := coreEquiv
          homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} u g => ff₁.map_injective (by
            have hl : U₁.map ((coreEquiv ℱ' 𝒢).symm (u ≫ g)) =
                θ_lift.hom.app ℱ' ≫ (adj_ab.homEquiv (U₂.obj ℱ') (U₁.obj 𝒢)).symm
                  (U₂.map (u ≫ g) ≫ (γ_pf B m 𝒢).inv) := ff₁.map_preimage _
            have hr : U₁.map ((coreEquiv ℱ 𝒢).symm g) =
                θ_lift.hom.app ℱ ≫ (adj_ab.homEquiv (U₂.obj ℱ) (U₁.obj 𝒢)).symm
                  (U₂.map g ≫ (γ_pf B m 𝒢).inv) := ff₁.map_preimage _
            rw [U₁.map_comp, hl, hr, U₂.map_comp, Category.assoc]
            have hnat := Adjunction.homEquiv_naturality_left_symm adj_ab (U₂.map u)
              (U₂.map g ≫ (γ_pf B m 𝒢).inv)
            dsimp only [U₁] at hnat ⊢
            rw [hnat, ← Category.assoc ((U_of W₁ m).map (pb_mod.map u))]
            have hθ : (U_of W₁ m).map (pb_mod.map u) ≫ θ_lift.hom.app ℱ =
                θ_lift.hom.app ℱ' ≫ pb_ab.map (U₂.map u) := θ_lift.hom.naturality u
            rw [hθ, Category.assoc])
          homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} f v => ff₂.map_injective (by
            rw [U₂.map_comp]
            change U₂.map (ff₂.preimage _) = U₂.map (ff₂.preimage _) ≫ U₂.map (pf_mod.map v)
            rw [ff₂.map_preimage, ff₂.map_preimage, U₁.map_comp,
              ← Category.assoc (θ_lift.inv.app ℱ),
              Adjunction.homEquiv_naturality_right adj_ab _ (U₁.map v),
              Category.assoc, hpf_map v, ← Category.assoc]) }
    have h_adj_mod_ev : ∀ ℱ 𝒢 (f : pb_mod.obj ℱ ⟶ 𝒢),
        U₂.map (adj_mod.homEquiv ℱ 𝒢 f) =
          adj_ab.homEquiv (U₂.obj ℱ) (U₁.obj 𝒢) (θ_lift.inv.app ℱ ≫ U₁.map f) ≫
            (γ_pf B m 𝒢).hom := by
      intro ℱ 𝒢 f
      dsimp only [adj_mod]
      rw [Adjunction.mkOfHomEquiv_homEquiv]
      exact ff₂.map_preimage _
    refine ⟨pb_mod, adj_mod, hAdd_mod, hLim_mod, hColim_mod, θ_lift, ?_⟩
    
    intro R_mod AM C_ab₁ C_ab₂ adj_ab₁ adj_ab₂ adj_mod₁ adj_mod₂ τ_h π_mod πM_ab
    apply (adj_ab.homEquiv (C_ab₂.obj AM) (U₁.obj (One_of W₁ m))).injective
    apply (adj_ab₂.homEquiv AM (pf_ab.obj (U₁.obj (One_of W₁ m)))).injective
    have hL1 : adj_ab.homEquiv (C_ab₂.obj AM) (U₁.obj (One_of W₁ m))
        (pb_ab.map (αM_of W₂ m) ≫ θ_lift.inv.app (One_of W₂ m) ≫ U₁.map π_mod) =
        αM_of W₂ m ≫ adj_ab.homEquiv (U₂.obj (One_of W₂ m)) (U₁.obj (One_of W₁ m))
          (θ_lift.inv.app (One_of W₂ m) ≫ U₁.map π_mod) :=
      Adjunction.homEquiv_naturality_left adj_ab (αM_of W₂ m) _
    have hL2 : adj_ab.homEquiv (U₂.obj (One_of W₂ m)) (U₁.obj (One_of W₁ m))
        (θ_lift.inv.app (One_of W₂ m) ≫ U₁.map π_mod) =
        U₂.map (adj_mod.homEquiv (One_of W₂ m) (One_of W₁ m) π_mod) ≫
          (γ_pf B m (One_of W₁ m)).inv := by
      rw [h_adj_mod_ev, Category.assoc, (γ_pf B m _).hom_inv_id, Category.comp_id]
    rw [hL1, hL2]
    set u_mod := adj_mod.homEquiv (One_of W₂ m) (One_of W₁ m) π_mod
    have hu_mod : u_mod = (adj_mod₂.homEquiv R_mod (pf_mod.obj (One_of W₁ m))).symm
        (adj_mod₁.unit.app R_mod ≫ (One_of W₁ m).obj.map τ_h.op) :=
      Equiv.apply_symm_apply _ _
    have hu_app : adj_mod₂.unit.app R_mod ≫ u_mod.hom.app (Opposite.op (T_of W₂)) =
        adj_mod₁.unit.app R_mod ≫ (One_of W₁ m).obj.map τ_h.op := by
      have h0 := (adj_mod₂.homEquiv R_mod (pf_mod.obj (One_of W₁ m))).apply_symm_apply
        (adj_mod₁.unit.app R_mod ≫ (One_of W₁ m).obj.map τ_h.op)
      rw [← hu_mod, Adjunction.homEquiv_unit] at h0
      exact h0
    let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    have hLHS : adj_ab₂.homEquiv AM (pf_ab.obj (U₁.obj (One_of W₁ m)))
        (αM_of W₂ m ≫ U₂.map u_mod ≫ (γ_pf B m (One_of W₁ m)).inv) =
        ιM_of m ≫ F_fg.map (adj_mod₁.unit.app R_mod) ≫
          F_fg.map ((One_of W₁ m).obj.map τ_h.op) := by
      rw [Adjunction.homEquiv_naturality_right adj_ab₂ (αM_of W₂ m)
          (U₂.map u_mod ≫ (γ_pf B m (One_of W₁ m)).inv),
        h_αM_homEquiv W₂ m, Category.assoc]
      congr 1
      have happ_id : ((U₂.map u_mod ≫ (γ_pf B m (One_of W₁ m)).inv).hom.app
