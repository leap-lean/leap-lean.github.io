        (∀ (r : ℕ) (u : weilEtaleTorsionH S_K (ℓ ^ (r + 1)) 0),
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (e₀ (r + 1) u) =
            e₀ r (weilEtaleTorsionTransition S_K ℓ r 0 u)) ∧
        (∀ (r : ℕ) (θ₀ : weilEtaleModuleH S_K (ℓ ^ r) 0 →+ weilEtaleTorsionH S_K (ℓ ^ r) 0),
          WeilIsModuleToTorsionComparison S_K (ℓ ^ r) 0 θ₀ →
          e₀ r (θ₀ (CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S_K (ℓ ^ r))))) = 1)) ∧
    (∃ δ : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y) (U : Y.Opens),
        AlgebraicGeometry.IsClosedImmersion i →
        (U : Set ↥Y) = (Set.range i.base)ᶜ →
        ∀ (m : ℕ), weilEtaleTorsionH U.toScheme m 1 → WeilGysinAbSupportClass Z Y i m 2,
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y) (U : Y.Opens)
          (hi : AlgebraicGeometry.IsClosedImmersion i) (hU : (U : Set ↥Y) = (Set.range i.base)ᶜ),
        (∀ (m : ℕ) (ξ₁ ξ₂ : weilEtaleTorsionH U.toScheme m 1),
          (δ i U hi hU m 0).val = 0 ∧
          (δ i U hi hU m (ξ₁ + ξ₂)).val = (δ i U hi hU m ξ₁).val + (δ i U hi hU m ξ₂).val) ∧
        (∀ (m : ℕ) (p_U : weilEtaleTorsionH Y m 1 →+ weilEtaleTorsionH U.toScheme m 1),
          WeilIsTorsionEtalePullback U.ι m 1 p_U →
          ∀ (η : weilEtaleTorsionH Y m 1), (δ i U hi hU m (p_U η)).val = 0) ∧
        (∀ (m : ℕ),
          Subsingleton (weilEtaleTorsionH Y m 1) →
          Subsingleton (weilEtaleTorsionH Y m 2) →
          Function.Bijective (δ i U hi hU m)) ∧
        (∀ (r : ℕ) (ξ : weilEtaleTorsionH U.toScheme (ℓ ^ (r + 1)) 1),
          weilGysinAbSupportTransition ℓ r 2 (δ i U hi hU (ℓ ^ (r + 1)) ξ) =
            δ i U hi hU (ℓ ^ r) (weilEtaleTorsionTransition U.toScheme ℓ r 1 ξ))) ∧
      ((∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i' →
        ∀ (m q : ℕ) (α : WeilGysinAbSupportClass Z Y i m q)
          (α'₁ α'₂ : WeilGysinAbSupportClass Z' Y' i' m q),
          WeilGysinAbSupportPullback g i' i m q α'₁ α →
          WeilGysinAbSupportPullback g i' i m q α'₂ α →
          α'₁ = α'₂) ∧
       (∀ {Z'' Y'' Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g₁ : Quiver.Hom Y'' Y') (g₂ : Quiver.Hom Y' Y)
          (i'' : Quiver.Hom Z'' Y'') (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          (m q : ℕ)
          (α'' : WeilGysinAbSupportClass Z'' Y'' i'' m q)
          (α' : WeilGysinAbSupportClass Z' Y' i' m q)
          (α : WeilGysinAbSupportClass Z Y i m q),
        WeilGysinAbSupportPullback g₁ i'' i' m q α'' α' →
        WeilGysinAbSupportPullback g₂ i' i m q α' α →
        WeilGysinAbSupportPullback (CategoryTheory.CategoryStruct.comp g₁ g₂) i'' i m q α'' α) ∧
       (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          (g_Z : Quiver.Hom Z' Z) (U' : Y'.Opens) (U : Y.Opens)
          (hi' : AlgebraicGeometry.IsClosedImmersion i')
          (hi : AlgebraicGeometry.IsClosedImmersion i)
          (hU' : (U' : Set ↥Y') = (Set.range i'.base)ᶜ)
