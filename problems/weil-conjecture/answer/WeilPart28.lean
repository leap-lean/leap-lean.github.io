            inferInstance inferInstance
        have hK : P K := hP_ker S hS hQ hX
        have hke_zero : (k ≫ e₀) ≫ p_X = 0 := by rw [Category.assoc]; exact hk0
        obtain ⟨u, hu⟩ := hS_pb.exact.lift' (k ≫ e₀) hke_zero
