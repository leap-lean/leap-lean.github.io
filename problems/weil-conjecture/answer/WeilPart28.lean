              map_add' := fun e₁ e₂ => Subtype.ext (LocallyConstant.ext fun w => by
                obtain ⟨Y_w, f_w, y_w, hf_w, rfl⟩ := hcov_pts w
                change gluedFn (e₁ + e₂) (f_w.left.base y_w) =
