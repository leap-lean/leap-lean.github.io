        refine ⟨U, hU_obj, hU_map, hAdd, hLim, hColim, T₀, hT₀, hT₀_left, hT₀_hom, u₀, hu₀,
          πM, ?_, ?_, fun x => ?_⟩
        · change αM₀ ≫ πM = 𝟙 FM; rw [hα_eq]; exact hαπ
        · change πM ≫ αM₀ = 𝟙 (U.obj One_mod); rw [hα_eq]; exact hπα
