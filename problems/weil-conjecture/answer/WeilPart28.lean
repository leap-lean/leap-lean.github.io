    letI : Module (PadicInt ℓ) ↥L₁ := instMod₁
    have hnat_smul₁ : ∀ (n : ℕ) (x : ↥L₁) (r : ℕ), ((n : PadicInt ℓ) • x).1 r = n • x.1 r := by
      intro n x r
