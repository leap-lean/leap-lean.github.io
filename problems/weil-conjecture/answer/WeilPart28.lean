        let S_pb : ShortComplex 𝒞 := ShortComplex.mk ι_E p_X hιE_X
        have hSpb_lift : ∀ {W_obj : 𝒞} (t : W_obj ⟶ E), t ≫ p_X = 0 →
            ∃! a_hom : W_obj ⟶ Y, a_hom ≫ ι_E = t := by
          intro W_obj t ht
          have htI : (t ≫ p_I) ≫ π = 0 := by
            rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, ht, Limits.zero_comp]
          obtain ⟨a_hom, ha⟩ := hS_inj.exact.lift' (t ≫ p_I) htI
          have ha_E : a_hom ≫ ι_E = t := by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, hιE_I, ha]
            · rw [Category.assoc, hιE_X, Limits.comp_zero, ht]
          exact ⟨a_hom, ha_E, fun m_hom hm => (cancel_mono ι_E).mp (hm.trans ha_E.symm)⟩
        have hSpb_ker : Limits.IsLimit (Limits.KernelFork.ofι S_pb.f S_pb.zero) :=
          Limits.KernelFork.IsLimit.ofι _ _
            (fun {W_obj} t ht => (hSpb_lift t ht).choose)
            (fun {W_obj} t ht => (hSpb_lift t ht).choose_spec.1)
            (fun {W_obj} t ht m_hom hm => (hSpb_lift t ht).choose_spec.2 m_hom hm)
        have hS_pb : S_pb.ShortExact :=
          ShortComplex.ShortExact.mk'
