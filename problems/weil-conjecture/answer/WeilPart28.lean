        symm
        calc
          (uA ≫ (C.obj A).obj.map (μ_k 1).op) ≫
              (m_αk ((G_k 1).obj T_std) ≫ (C.obj A).obj.map (e_Gstep.inv.app T_std).op)
            = uA ≫ ((C.obj A).obj.map (μ_k 1).op ≫ m_αk ((G_k 1).obj T_std)) ≫
                (C.obj A).obj.map (e_Gstep.inv.app T_std).op := by simp only [Category.assoc]
          _ = (uA ≫ m_αk T_std) ≫ (C.obj A).obj.map ((G_k k).map (μ_k 1)).op ≫
                (C.obj A).obj.map (e_Gstep.inv.app T_std).op := by
              rw [hm_nat]; simp only [Category.assoc]
          _ = uA ≫ ((C.obj A).obj.map (μ_k k).op ≫
                ((C.obj A).obj.map ((G_k k).map (μ_k 1)).op ≫
                  (C.obj A).obj.map (e_Gstep.inv.app T_std).op)) := by
              rw [hm_T]; simp only [Category.assoc]
          _ = uA ≫ (C.obj A).obj.map
                (((e_Gstep.inv.app T_std ≫ (G_k k).map (μ_k 1)) ≫ μ_k k).op) := by
              rw [← (C.obj A).obj.map_comp, ← (C.obj A).obj.map_comp, ← op_comp, ← op_comp]
          _ = uA ≫ (C.obj A).obj.map (μ_k (k + 1)).op :=
              congrArg (fun m : (G_k (k + 1)).obj T_std ⟶ T_std => uA ≫ (C.obj A).obj.map m.op)
                (Limits.IsTerminal.hom_ext hT_std _ _)
      have hβ_step : ∀ A : D,
          β_k (k + 1) A = η_Pstep.inv.app (C.obj A) ≫ (P_k 1).map (β_k k A) ≫ β_k 1 A := by
        intro A
        let rhs := η_Pstep.inv.app (C.obj A) ≫ (P_k 1).map (β_k k A) ≫ β_k 1 A
        have hcomp_one : α_k (k + 1) A ≫ rhs = 𝟙 (C.obj A) := by
          dsimp [rhs]
          rw [hα_step A]
          calc
            (α_k 1 A ≫ (P_k 1).map (α_k k A) ≫ η_Pstep.hom.app (C.obj A)) ≫
                (η_Pstep.inv.app (C.obj A) ≫ (P_k 1).map (β_k k A) ≫ β_k 1 A)
              = α_k 1 A ≫ (P_k 1).map (α_k k A) ≫
                  (η_Pstep.hom.app (C.obj A) ≫ η_Pstep.inv.app (C.obj A)) ≫
                  (P_k 1).map (β_k k A) ≫ β_k 1 A := by simp only [Category.assoc]
            _ = α_k 1 A ≫ ((P_k 1).map (α_k k A) ≫ (P_k 1).map (β_k k A)) ≫ β_k 1 A := by
                rw [η_Pstep.hom_inv_id_app]
                dsimp only [Functor.comp_obj]
                rw [Category.id_comp]
                simp only [Category.assoc]
            _ = α_k 1 A ≫ β_k 1 A := by
                rw [← (P_k 1).map_comp, hαβ_k k A, (P_k 1).map_id, Category.id_comp]
            _ = 𝟙 (C.obj A) := hαβ_k 1 A
        calc
          β_k (k + 1) A = β_k (k + 1) A ≫ (α_k (k + 1) A ≫ rhs) := by
            rw [hcomp_one, Category.comp_id]
          _ = (β_k (k + 1) A ≫ α_k (k + 1) A) ≫ rhs := (Category.assoc _ _ _).symm
          _ = rhs := by rw [hβα_k (k + 1) A, Category.id_comp]
      rw [Function.iterate_succ_apply', ← ih m x,
          hfrobAct_apply (k + 1) m x,
          hfrobAct_apply 1 m (frobAct_k k m x),
          hfrobAct_apply k m x]
      rw [hα_step Aℤ, hβ_step (AM m),
          ← Abelian.Ext.mk₀_comp_mk₀ (α_k 1 Aℤ),
          ← Abelian.Ext.mk₀_comp_mk₀ ((P_k 1).map (α_k k Aℤ)),
          Abelian.Ext.comp_assoc _ _ (Abelian.Ext.mapExactFunctor (P_k (k + 1)) x)
            (Nat.zero_add 0) (Nat.zero_add i) (by omega),
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ((P_k 1).map (α_k k Aℤ))) _ _
            (Nat.zero_add 0) (Nat.zero_add i) (by omega),
          hExt_natIso (P_k k ⋙ P_k 1) (P_k (k + 1)) η_Pstep i Fℤ (C.obj (AM m)) x,
          hExt_comp (P_k k) (P_k 1) i Fℤ (C.obj (AM m)) x,
          ← Abelian.Ext.mk₀_comp_mk₀ (η_Pstep.inv.app (C.obj (AM m))),
          ← Abelian.Ext.mk₀_comp_mk₀ ((P_k 1).map (β_k k (AM m))),
          Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
          Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀]
      have hmid_cancel :
          (((Abelian.Ext.mk₀ ((P_k 1).map (α_k k Aℤ))).comp
            ((Abelian.Ext.mapExactFunctor (P_k 1) (Abelian.Ext.mapExactFunctor (P_k k) x)).comp
              (Abelian.Ext.mk₀ (η_Pstep.hom.app (C.obj (AM m)))) (Nat.add_zero i))
            (Nat.zero_add i)).comp
            ((Abelian.Ext.mk₀ (η_Pstep.inv.app (C.obj (AM m)))).comp
              ((Abelian.Ext.mk₀ ((P_k 1).map (β_k k (AM m)))).comp
                (Abelian.Ext.mk₀ (β_k 1 (AM m))) (Nat.zero_add 0)) (Nat.zero_add 0))
            (Nat.add_zero i)) =
          (((Abelian.Ext.mk₀ ((P_k 1).map (α_k k Aℤ))).comp
            (Abelian.Ext.mapExactFunctor (P_k 1) (Abelian.Ext.mapExactFunctor (P_k k) x))
            (Nat.zero_add i)).comp
            (Abelian.Ext.mk₀ ((P_k 1).map (β_k k (AM m)))) (Nat.add_zero i)).comp
            (Abelian.Ext.mk₀ (β_k 1 (AM m))) (Nat.add_zero i) := by
        rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ((P_k 1).map (α_k k Aℤ))) _ _
              (Nat.zero_add i) (Nat.add_zero i) (by omega),
            Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ (η_Pstep.hom.app (C.obj (AM m)))) _
              (Nat.add_zero i) (Nat.zero_add 0) (by omega),
            ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (η_Pstep.hom.app (C.obj (AM m)))) _ _
              (Nat.zero_add 0) (Nat.zero_add 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, η_Pstep.hom_inv_id_app, Abelian.Ext.mk₀_id_comp,
            ← Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ ((P_k 1).map (β_k k (AM m)))) _
              (Nat.add_zero i) (Nat.zero_add 0) (by omega)]
      rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (α_k 1 Aℤ)) _ _
            (Nat.zero_add i) (Nat.add_zero i) (by omega),
          hmid_cancel,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (α_k 1 Aℤ)) _ _
            (Nat.zero_add i) (Nat.add_zero i) (by omega)]
  
  
  
  
  have hPull_φ : ∀ r : ℕ, WeilLefschetzTorsionPullback φ (ℓ ^ r) i (frobAct_k n (ℓ ^ r)) := by
    intro r
    let m := ℓ ^ r
    haveI : (P_k n).Additive := hPk_add n
    haveI : Limits.PreservesFiniteLimits (P_k n) := hPk_lim n
    haveI : Limits.PreservesFiniteColimits (P_k n) := hPk_colim n
    let _ : MorphismProperty.HasPullbacksAlong PEt φ :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong PEt φ :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp_bc hg_bc => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_bc hg_bc)
    let B_φ : S.Etale ⥤ S.Etale := MorphismProperty.Over.pullback PEt ⊤ φ
    have hU_char : ∀ U : S.Etale,
        ∀ V : ((Fgt.obj U).left).Opens,
          (p : ↑(((Fgt.obj U).left).presheaf.obj (Opposite.op V))) = 0 :=
      fun U => hCharOverK (Fgt.obj U).left ((Fgt.obj U).hom ≫ fstS ≫ Z.hom)
    have hp_φ : ∀ U : S.Etale,
        IsPullback (fr (Fgt.obj U).left (hU_char U))
          ((Fgt.obj U).hom ≫ ginv_pow n) (Fgt.obj U).hom φ := by
      intro U
      let u := (Fgt.obj U).hom
      let u' := u ≫ ginv_pow n
      have hu'_et : Etale u' := MorphismProperty.comp_mem PEt u (ginv_pow n) U.prop (hginv_pow_et n)
      have hp_top : IsPullback (fr (Fgt.obj U).left (hU_char U)) u' u' fr_S :=
        @hfr_pull _ _ (hU_char U) hS_char u' hu'_et
      have hp_right : IsPullback (𝟙 (Fgt.obj U).left) u' u (g_pow n) :=
        @IsPullback.of_horiz_isIso _ _ _ _ _ _ (𝟙 (Fgt.obj U).left) u' u (g_pow n)
          inferInstance ⟨⟨ginv_pow n, hg_pow_inv n, hginv_pow n⟩⟩
          ⟨by rw [Category.id_comp]; dsimp [u']; rw [Category.assoc, hginv_pow n, Category.comp_id]⟩
      have hp_comp := hp_top.paste_horiz hp_right
      rw [Category.comp_id, ← hφ_eq] at hp_comp
      exact hp_comp
    let θ_φ : G_inv_k n ≅ B_φ :=
      NatIso.ofComponents
        (fun U => MorphismProperty.Over.isoMk (P := PEt) (Q := ⊤)
          (hp_φ U).isoPullback (hp_φ U).isoPullback_hom_snd)
        (fun {U₁ U₂} f => etale_hom_ext (by
          let u₁ := (Fgt.obj U₁).hom
          let u₂ := (Fgt.obj U₂).hom
          let f_left := (Fgt.map f).left
          change f_left ≫ (hp_φ U₂).isoPullback.hom =
            (hp_φ U₁).isoPullback.hom ≫ (Fgt.map (B_φ.map f)).left
          symm
          apply Limits.pullback.hom_ext
          · exact (Category.assoc _ _ _).trans
              ((congrArg ((hp_φ U₁).isoPullback.hom ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
                ((Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ f_left) (hp_φ U₁).isoPullback_hom_fst).trans
                    ((hfr_nat (hU_char U₁) (hU_char U₂) f_left).trans
                      ((congrArg (f_left ≫ ·) (hp_φ U₂).isoPullback_hom_fst.symm).trans
                        (Category.assoc _ _ _).symm)))))
          · exact (Category.assoc _ _ _).trans
              ((congrArg ((hp_φ U₁).isoPullback.hom ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
                ((hp_φ U₁).isoPullback_hom_snd.trans
                  ((congrArg (· ≫ ginv_pow n) (etale_w f).symm).trans
                    ((Category.assoc _ _ _).trans
                      ((congrArg (f_left ≫ ·) (hp_φ U₂).isoPullback_hom_snd.symm).trans
                        (Category.assoc _ _ _).symm)))))))
    have : (G_inv_k n).IsContinuous J J := hGinvk_cont n
    have hB_cont : B_φ.IsContinuous J J := Functor.isContinuous_of_iso θ_φ J J
    let _ := hB_cont
    let P_push := B_φ.sheafPushforwardContinuous D J J
    let e_push : P_inv_k n ≅ P_push :=
      NatIso.ofComponents
        (fun ℱ =>
          { hom := ObjectProperty.homMk
              { app := fun U => ℱ.obj.map (θ_φ.inv.app U.unop).op
                naturality := fun {U₁ U₂} u => by
                  change ℱ.obj.map ((G_inv_k n).map u.unop).op ≫ ℱ.obj.map (θ_φ.inv.app U₂.unop).op =
                    ℱ.obj.map (θ_φ.inv.app U₁.unop).op ≫ ℱ.obj.map (B_φ.map u.unop).op
                  rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← op_comp, ← op_comp]
                  congr 2
                  exact (θ_φ.inv.naturality u.unop).symm }
            inv := ObjectProperty.homMk
              { app := fun U => ℱ.obj.map (θ_φ.hom.app U.unop).op
                naturality := fun {U₁ U₂} u => by
                  change ℱ.obj.map (B_φ.map u.unop).op ≫ ℱ.obj.map (θ_φ.hom.app U₂.unop).op =
                    ℱ.obj.map (θ_φ.hom.app U₁.unop).op ≫ ℱ.obj.map ((G_inv_k n).map u.unop).op
                  rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← op_comp, ← op_comp]
                  congr 2
                  exact (θ_φ.hom.naturality u.unop).symm }
            hom_inv_id := by
              apply Sheaf.hom_ext; apply NatTrans.ext; funext U
              change ℱ.obj.map (θ_φ.inv.app U.unop).op ≫ ℱ.obj.map (θ_φ.hom.app U.unop).op = 𝟙 _
              rw [← ℱ.obj.map_comp, ← op_comp, θ_φ.hom_inv_id_app, op_id, ℱ.obj.map_id]
            inv_hom_id := by
              apply Sheaf.hom_ext; apply NatTrans.ext; funext U
              change ℱ.obj.map (θ_φ.hom.app U.unop).op ≫ ℱ.obj.map (θ_φ.inv.app U.unop).op = 𝟙 _
              rw [← ℱ.obj.map_comp, ← op_comp, θ_φ.inv_hom_id_app, op_id, ℱ.obj.map_id] })
        (fun f => by
