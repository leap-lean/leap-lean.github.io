      fun W h => CategoryTheory.MorphismProperty.Over.mk (P := @AlgebraicGeometry.Etale) ⊤
        (g_W W h) (hEt_gW W h)
    have hP_V_of_hom : ∀ {W₂ W₁ : Y.Etale} (u : Quiver.Hom W₂ W₁), P_V W₁ → P_V W₂ := by
      rintro W₂ W₁ u h₁ _ ⟨x, rfl⟩
      have hw : CategoryTheory.CategoryStruct.comp u.left W₁.hom = W₂.hom :=
        CategoryTheory.MorphismProperty.Over.w u
      rw [← hw, AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact h₁ ⟨u.left.base x, rfl⟩
    let liftMap : ∀ {W₂ W₁ : Y.Etale} (u : Quiver.Hom W₂ W₁) (h₂ : P_V W₂) (h₁ : P_V W₁),
        Quiver.Hom (L_V W₂ h₂) (L_V W₁ h₁) :=
      fun {W₂ W₁} u h₂ h₁ =>
        CategoryTheory.MorphismProperty.Over.homMk u.left
          ((CategoryTheory.cancel_mono V.ι).mp
            ((CategoryTheory.Category.assoc u.left (g_W W₁ h₁) V.ι).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp u.left) (hg_W W₁ h₁)).trans
                ((CategoryTheory.MorphismProperty.Over.w u).trans (hg_W W₂ h₂).symm))))
          trivial
    have h_MV : ∀ (U : V.toScheme.Etale), P_V (M_V.obj U) := by
      rintro U _ ⟨x, rfl⟩
      exact ⟨(((AlgebraicGeometry.Scheme.Etale.forget V.toScheme).obj U).hom).base x,
        (AlgebraicGeometry.Scheme.Hom.comp_apply
          (((AlgebraicGeometry.Scheme.Etale.forget V.toScheme).obj U).hom) V.ι x).symm⟩
    let σ_V : ∀ (U : V.toScheme.Etale), CategoryTheory.Iso (L_V (M_V.obj U) (h_MV U)) U :=
      fun U =>
        have h_eq : g_W (M_V.obj U) (h_MV U) = U.hom :=
          (CategoryTheory.cancel_mono V.ι).mp (hg_W (M_V.obj U) (h_MV U))
        { hom := CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id U.left)
            ((CategoryTheory.Category.id_comp U.hom).trans h_eq.symm) trivial
          inv := CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id U.left)
            ((CategoryTheory.Category.id_comp _).trans h_eq) trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
          inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _) }
    let ρ_V : ∀ (W : Y.Etale) (h : P_V W), CategoryTheory.Iso (M_V.obj (L_V W h)) W :=
      fun W h =>
        { hom := CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id W.left)
            ((CategoryTheory.Category.id_comp W.hom).trans (hg_W W h).symm) trivial
          inv := CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id W.left)
            ((CategoryTheory.Category.id_comp _).trans (hg_W W h)) trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
          inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _) }
    let Z₀ : AbCat := AddCommGrpCat.of PUnit.{u + 1}
    have hZ₀ : CategoryTheory.Limits.IsZero Z₀ := AddCommGrpCat.isZero_of_subsingleton Z₀
    let evObj : CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat →
        Opposite Y.Etale → AbCat :=
      fun Psh K => if h : P_V K.unop then Psh.obj (Opposite.op (L_V K.unop h)) else Z₀
    let evPosIso : ∀ (Psh : CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat)
        (K : Opposite Y.Etale) (h : P_V K.unop),
        evObj Psh K ≅ Psh.obj (Opposite.op (L_V K.unop h)) :=
      fun Psh K h => CategoryTheory.eqToIso (dif_pos h)
    have hZ₀_neg : ∀ (Psh : CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat)
        (K : Opposite Y.Etale), ¬ P_V K.unop → CategoryTheory.Limits.IsZero (evObj Psh K) :=
      fun Psh K nh => hZ₀.of_iso (CategoryTheory.eqToIso (dif_neg nh))
    let evMap : ∀ (Psh : CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat)
        {K₁ K₂ : Opposite Y.Etale} (_ : Quiver.Hom K₁ K₂),
        Quiver.Hom (evObj Psh K₁) (evObj Psh K₂) :=
      fun Psh {K₁ K₂} α =>
        if h₁ : P_V K₁.unop then
          CategoryTheory.CategoryStruct.comp (evPosIso Psh K₁ h₁).hom
            (CategoryTheory.CategoryStruct.comp
              (Psh.map (liftMap α.unop (hP_V_of_hom α.unop h₁) h₁).op)
              (evPosIso Psh K₂ (hP_V_of_hom α.unop h₁)).inv)
        else 0
    let evNatApp : ∀ {Psh₁ Psh₂ : CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat}
        (_ : Quiver.Hom Psh₁ Psh₂) (K : Opposite Y.Etale),
        Quiver.Hom (evObj Psh₁ K) (evObj Psh₂ K) :=
      fun {Psh₁ Psh₂} φ K =>
        if h : P_V K.unop then
          CategoryTheory.CategoryStruct.comp (evPosIso Psh₁ K h).hom
            (CategoryTheory.CategoryStruct.comp
              (φ.app (Opposite.op (L_V K.unop h)))
              (evPosIso Psh₂ K h).inv)
        else 0
    have hevMap_pos : ∀ (Psh : CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat)
        {K₁ K₂ : Opposite Y.Etale} (α : Quiver.Hom K₁ K₂) (h₁ : P_V K₁.unop),
        evMap Psh α =
          CategoryTheory.CategoryStruct.comp (evPosIso Psh K₁ h₁).hom
            (CategoryTheory.CategoryStruct.comp
              (Psh.map (liftMap α.unop (hP_V_of_hom α.unop h₁) h₁).op)
              (evPosIso Psh K₂ (hP_V_of_hom α.unop h₁)).inv) := by
      intro Psh K₁ K₂ α h₁
      exact dif_pos h₁
    have hevNat_pos : ∀ {Psh₁ Psh₂ : CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat}
        (φ : Quiver.Hom Psh₁ Psh₂) (K : Opposite Y.Etale) (h : P_V K.unop),
        evNatApp φ K =
          CategoryTheory.CategoryStruct.comp (evPosIso Psh₁ K h).hom
            (CategoryTheory.CategoryStruct.comp
              (φ.app (Opposite.op (L_V K.unop h)))
              (evPosIso Psh₂ K h).inv) :=
      fun _ _ h => dif_pos h
    let E_V : CategoryTheory.Functor
        (CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat)
        (CategoryTheory.Functor (Opposite Y.Etale) AbCat) :=
      { obj := fun Psh =>
          { obj := fun K => evObj Psh K
            map := fun α => evMap Psh α
            map_id := fun K => by
              by_cases h : P_V K.unop
              · rw [hevMap_pos Psh (CategoryTheory.CategoryStruct.id K) h]
                have hid : liftMap (CategoryTheory.CategoryStruct.id K).unop
                    (hP_V_of_hom (CategoryTheory.CategoryStruct.id K).unop h) h =
                    CategoryTheory.CategoryStruct.id (L_V K.unop h) :=
                  CategoryTheory.MorphismProperty.Over.Hom.ext rfl
                have hp_id : Psh.map (CategoryTheory.CategoryStruct.id (L_V K.unop h)).op =
                    CategoryTheory.CategoryStruct.id (Psh.obj (Opposite.op (L_V K.unop h))) :=
                  Psh.map_id (Opposite.op (L_V K.unop h))
                rw [hid, hp_id, CategoryTheory.Category.id_comp]
                exact (evPosIso Psh K h).hom_inv_id
              · exact (hZ₀_neg Psh K h).eq_of_src _ _
            map_comp := fun {K₁ K₂ K₃} α β => by
              by_cases h₁ : P_V K₁.unop
              · have h₂ : P_V K₂.unop := hP_V_of_hom α.unop h₁
                have h₃ : P_V K₃.unop := hP_V_of_hom β.unop h₂
                rw [hevMap_pos Psh (CategoryTheory.CategoryStruct.comp α β) h₁,
                  hevMap_pos Psh α h₁, hevMap_pos Psh β h₂]
                have hcomp : liftMap (CategoryTheory.CategoryStruct.comp α β).unop h₃ h₁ =
                    CategoryTheory.CategoryStruct.comp
                      (liftMap β.unop h₃ h₂) (liftMap α.unop h₂ h₁) :=
                  CategoryTheory.MorphismProperty.Over.Hom.ext rfl
                rw [hcomp, op_comp, Psh.map_comp]
                simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
              · exact (hZ₀_neg Psh K₁ h₁).eq_of_src _ _ }
        map := fun {Psh₁ Psh₂} φ =>
          { app := fun K => evNatApp φ K
            naturality := fun {K₁ K₂} α => by
              by_cases h₁ : P_V K₁.unop
              · have h₂ : P_V K₂.unop := hP_V_of_hom α.unop h₁
                change CategoryTheory.CategoryStruct.comp (evMap Psh₁ α) (evNatApp φ K₂) =
                  CategoryTheory.CategoryStruct.comp (evNatApp φ K₁) (evMap Psh₂ α)
                rw [hevMap_pos Psh₁ α h₁, hevNat_pos φ K₂ h₂, hevNat_pos φ K₁ h₁,
                  hevMap_pos Psh₂ α h₁]
                simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
                rw [← CategoryTheory.Category.assoc (φ.app _), ← φ.naturality,
                  CategoryTheory.Category.assoc]
              · exact (hZ₀_neg Psh₁ K₁ h₁).eq_of_src _ _ }
        map_id := fun Psh => CategoryTheory.NatTrans.ext (funext fun K => by
          by_cases h : P_V K.unop
          · change evNatApp (CategoryTheory.CategoryStruct.id Psh) K = _
            rw [hevNat_pos (CategoryTheory.CategoryStruct.id Psh) K h]
            change CategoryTheory.CategoryStruct.comp (evPosIso Psh K h).hom
              (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id _)
                (evPosIso Psh K h).inv) = _
            rw [CategoryTheory.Category.id_comp]
            exact (evPosIso Psh K h).hom_inv_id
          · exact (hZ₀_neg Psh K h).eq_of_src _ _)
        map_comp := fun {Psh₁ Psh₂ Psh₃} φ ψ => CategoryTheory.NatTrans.ext (funext fun K => by
          by_cases h : P_V K.unop
          · change evNatApp (CategoryTheory.CategoryStruct.comp φ ψ) K =
              CategoryTheory.CategoryStruct.comp (evNatApp φ K) (evNatApp ψ K)
            rw [hevNat_pos (CategoryTheory.CategoryStruct.comp φ ψ) K h,
              hevNat_pos φ K h, hevNat_pos ψ K h]
            dsimp only [CategoryTheory.NatTrans.comp_app]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
          · exact (hZ₀_neg Psh₁ K h).eq_of_src _ _) }
    let R_V : CategoryTheory.Functor
        (CategoryTheory.Functor (Opposite Y.Etale) AbCat)
        (CategoryTheory.Functor (Opposite V.toScheme.Etale) AbCat) :=
      (CategoryTheory.Functor.whiskeringLeft _ _ AbCat).obj M_V.op
    let η_P : CategoryTheory.Functor.id _ ⟶ CategoryTheory.Functor.comp E_V R_V :=
      { app := fun Psh =>
          { app := fun X =>
              CategoryTheory.CategoryStruct.comp
                (Psh.map (σ_V X.unop).hom.op)
                (evPosIso Psh (Opposite.op (M_V.obj X.unop)) (h_MV X.unop)).inv
            naturality := fun {X₁ X₂} β => by
              change CategoryTheory.CategoryStruct.comp (Psh.map β)
                  (CategoryTheory.CategoryStruct.comp
                    (Psh.map (σ_V X₂.unop).hom.op)
                    (evPosIso Psh (Opposite.op (M_V.obj X₂.unop)) (h_MV X₂.unop)).inv) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp
                    (Psh.map (σ_V X₁.unop).hom.op)
                    (evPosIso Psh (Opposite.op (M_V.obj X₁.unop)) (h_MV X₁.unop)).inv)
                  (evMap Psh (M_V.map β.unop).op)
              rw [hevMap_pos Psh (M_V.map β.unop).op (h_MV X₁.unop)]
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
              rw [← CategoryTheory.Category.assoc (Psh.map β),
                ← CategoryTheory.Category.assoc (Psh.map (σ_V X₁.unop).hom.op),
                ← Psh.map_comp, ← Psh.map_comp,
                ← Quiver.Hom.op_unop β, ← op_comp, ← op_comp]
              have hσ_nat : CategoryTheory.CategoryStruct.comp
                  (liftMap (M_V.map β.unop) (h_MV X₂.unop) (h_MV X₁.unop))
                  (σ_V X₁.unop).hom =
                  CategoryTheory.CategoryStruct.comp (σ_V X₂.unop).hom β.unop :=
                CategoryTheory.MorphismProperty.Over.Hom.ext
                  ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
              exact congrArg (fun k => CategoryTheory.CategoryStruct.comp (Psh.map k.op) _)
                hσ_nat.symm }
        naturality := fun {Psh₁ Psh₂} φ => CategoryTheory.NatTrans.ext (funext fun X => by
          change CategoryTheory.CategoryStruct.comp (φ.app X)
              (CategoryTheory.CategoryStruct.comp
                (Psh₂.map (σ_V X.unop).hom.op)
                (evPosIso Psh₂ (Opposite.op (M_V.obj X.unop)) (h_MV X.unop)).inv) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp
                (Psh₁.map (σ_V X.unop).hom.op)
                (evPosIso Psh₁ (Opposite.op (M_V.obj X.unop)) (h_MV X.unop)).inv)
              (evNatApp φ (Opposite.op (M_V.obj X.unop)))
          rw [hevNat_pos φ (Opposite.op (M_V.obj X.unop)) (h_MV X.unop)]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
          rw [← CategoryTheory.Category.assoc (φ.app X), ← φ.naturality,
            CategoryTheory.Category.assoc]) }
    let εApp : ∀ (Qsh : CategoryTheory.Functor (Opposite Y.Etale) AbCat) (K : Opposite Y.Etale),
        Quiver.Hom (evObj (R_V.obj Qsh) K) (Qsh.obj K) :=
      fun Qsh K =>
        if h : P_V K.unop then
          CategoryTheory.CategoryStruct.comp
            (evPosIso (R_V.obj Qsh) K h).hom
            (Qsh.map (ρ_V K.unop h).inv.op)
        else 0
    have hεApp_pos : ∀ (Qsh : CategoryTheory.Functor (Opposite Y.Etale) AbCat)
        (K : Opposite Y.Etale) (h : P_V K.unop),
        εApp Qsh K =
          CategoryTheory.CategoryStruct.comp
            (evPosIso (R_V.obj Qsh) K h).hom
            (Qsh.map (ρ_V K.unop h).inv.op) :=
      fun _ _ h => dif_pos h
    let ε_P : CategoryTheory.Functor.comp R_V E_V ⟶ CategoryTheory.Functor.id _ :=
      { app := fun Qsh =>
          { app := fun K => εApp Qsh K
            naturality := fun {K₁ K₂} α => by
              by_cases h₁ : P_V K₁.unop
              · have h₂ : P_V K₂.unop := hP_V_of_hom α.unop h₁
                change CategoryTheory.CategoryStruct.comp (evMap (R_V.obj Qsh) α) (εApp Qsh K₂) =
                  CategoryTheory.CategoryStruct.comp (εApp Qsh K₁) (Qsh.map α)
                rw [hevMap_pos (R_V.obj Qsh) α h₁, hεApp_pos Qsh K₂ h₂, hεApp_pos Qsh K₁ h₁]
                simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
                change CategoryTheory.CategoryStruct.comp (evPosIso (R_V.obj Qsh) K₁ h₁).hom
                    (CategoryTheory.CategoryStruct.comp
                      (Qsh.map (M_V.map (liftMap α.unop h₂ h₁)).op)
                      (Qsh.map (ρ_V K₂.unop h₂).inv.op)) =
                  CategoryTheory.CategoryStruct.comp (evPosIso (R_V.obj Qsh) K₁ h₁).hom
                    (CategoryTheory.CategoryStruct.comp
                      (Qsh.map (ρ_V K₁.unop h₁).inv.op)
                      (Qsh.map α))
                rw [← Qsh.map_comp, ← Qsh.map_comp, ← Quiver.Hom.op_unop α, ← op_comp, ← op_comp]
                have hρ_nat : CategoryTheory.CategoryStruct.comp
                    (ρ_V K₂.unop h₂).inv (M_V.map (liftMap α.unop h₂ h₁)) =
                    CategoryTheory.CategoryStruct.comp α.unop (ρ_V K₁.unop h₁).inv :=
                  CategoryTheory.MorphismProperty.Over.Hom.ext
                    ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm)
                exact congrArg (fun k => CategoryTheory.CategoryStruct.comp _ (Qsh.map k.op)) hρ_nat
              · exact (hZ₀_neg (R_V.obj Qsh) K₁ h₁).eq_of_src _ _ }
        naturality := fun {Qsh₁ Qsh₂} ψ => CategoryTheory.NatTrans.ext (funext fun K => by
          by_cases h : P_V K.unop
          · change CategoryTheory.CategoryStruct.comp (evNatApp (R_V.map ψ) K) (εApp Qsh₂ K) =
              CategoryTheory.CategoryStruct.comp (εApp Qsh₁ K) (ψ.app K)
            rw [hevNat_pos (R_V.map ψ) K h, hεApp_pos Qsh₂ K h, hεApp_pos Qsh₁ K h]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
            exact congrArg (CategoryTheory.CategoryStruct.comp _)
              (ψ.naturality (ρ_V K.unop h).inv.op).symm
          · exact (hZ₀_neg (R_V.obj Qsh₁) K h).eq_of_src _ _) }
    let adj_P : CategoryTheory.Adjunction E_V R_V :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit := η_P
          counit := ε_P
          left_triangle := CategoryTheory.NatTrans.ext (funext fun Psh =>
            CategoryTheory.NatTrans.ext (funext fun K => by
              by_cases h : P_V K.unop
              · change CategoryTheory.CategoryStruct.comp
                    (evNatApp (η_P.app Psh) K) (εApp (E_V.obj Psh) K) =
                  CategoryTheory.CategoryStruct.id (evObj Psh K)
                rw [hevNat_pos (η_P.app Psh) K h, hεApp_pos (E_V.obj Psh) K h]
                let α_ρ : Quiver.Hom (Opposite.op (M_V.obj (L_V K.unop h))) K :=
                  (ρ_V K.unop h).inv.op
                change CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.CategoryStruct.comp (evPosIso Psh K h).hom
                      (CategoryTheory.CategoryStruct.comp
                        (CategoryTheory.CategoryStruct.comp
                          (Psh.map (σ_V (L_V K.unop h)).hom.op)
                          (evPosIso Psh (Opposite.op (M_V.obj (L_V K.unop h))) (h_MV (L_V K.unop h))).inv)
                        (evPosIso (R_V.obj (E_V.obj Psh)) K h).inv))
                    (CategoryTheory.CategoryStruct.comp
                      (evPosIso (R_V.obj (E_V.obj Psh)) K h).hom
                      (evMap Psh α_ρ)) =
                  CategoryTheory.CategoryStruct.id (evObj Psh K)
                simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
                change CategoryTheory.CategoryStruct.comp (evPosIso Psh K h).hom
                  (CategoryTheory.CategoryStruct.comp
                    (Psh.map (σ_V (L_V K.unop h)).hom.op)
                    (CategoryTheory.CategoryStruct.comp
                      (evPosIso Psh (Opposite.op (M_V.obj (L_V K.unop h))) (h_MV (L_V K.unop h))).inv
                      (evMap Psh α_ρ))) =
                  CategoryTheory.CategoryStruct.id (evObj Psh K)
                rw [hevMap_pos Psh α_ρ (h_MV (L_V K.unop h))]
                simp only [CategoryTheory.Iso.inv_hom_id_assoc]
                rw [← CategoryTheory.Category.assoc (Psh.map _), ← Psh.map_comp, ← op_comp]
                have h_id : CategoryTheory.CategoryStruct.comp
                    (liftMap α_ρ.unop (hP_V_of_hom α_ρ.unop (h_MV (L_V K.unop h))) (h_MV (L_V K.unop h)))
                    (σ_V (L_V K.unop h)).hom =
                    CategoryTheory.CategoryStruct.id (L_V K.unop h) :=
                  CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
                have hp_id : Psh.map (CategoryTheory.CategoryStruct.id (L_V K.unop h)).op =
                    CategoryTheory.CategoryStruct.id (Psh.obj (Opposite.op (L_V K.unop h))) :=
                  Psh.map_id (Opposite.op (L_V K.unop h))
                rw [h_id, hp_id, CategoryTheory.Category.id_comp]
                exact (evPosIso Psh K h).hom_inv_id
              · exact (hZ₀_neg Psh K h).eq_of_src _ _))
          right_triangle := CategoryTheory.NatTrans.ext (funext fun Qsh =>
            CategoryTheory.NatTrans.ext (funext fun X => by
              change CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp
                    (Qsh.map (M_V.map (σ_V X.unop).hom).op)
                    (evPosIso (R_V.obj Qsh) (Opposite.op (M_V.obj X.unop)) (h_MV X.unop)).inv)
                  (εApp Qsh (Opposite.op (M_V.obj X.unop))) =
                CategoryTheory.CategoryStruct.id (Qsh.obj (Opposite.op (M_V.obj X.unop)))
              rw [hεApp_pos Qsh (Opposite.op (M_V.obj X.unop)) (h_MV X.unop)]
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
              rw [← Qsh.map_comp, ← op_comp]
              have h_id : CategoryTheory.CategoryStruct.comp
                  (ρ_V (M_V.obj X.unop) (h_MV X.unop)).inv
                  (M_V.map (σ_V X.unop).hom) =
                  CategoryTheory.CategoryStruct.id (M_V.obj X.unop) :=
                CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
              rw [h_id]
              exact Qsh.map_id (Opposite.op (M_V.obj X.unop)))) }
    haveI hLim_EV : CategoryTheory.Limits.PreservesFiniteLimits E_V := by
      apply CategoryTheory.Limits.preservesFiniteLimits_of_preservesFiniteLimitsOfSize E_V
      intro J _ _
      apply CategoryTheory.Limits.preservesLimitsOfShape_of_evaluation E_V J
      intro K
      by_cases h : P_V K.unop
      · let e_ev : CategoryTheory.Iso
            ((CategoryTheory.evaluation (Opposite V.toScheme.Etale) AbCat).obj
              (Opposite.op (L_V K.unop h)))
            (CategoryTheory.Functor.comp E_V
              ((CategoryTheory.evaluation (Opposite Y.Etale) AbCat).obj K)) :=
          CategoryTheory.NatIso.ofComponents
            (fun Psh => (evPosIso Psh K h).symm)
            (fun {Psh₁ Psh₂} φ => by
              change CategoryTheory.CategoryStruct.comp (φ.app _) (evPosIso Psh₂ K h).inv =
                CategoryTheory.CategoryStruct.comp (evPosIso Psh₁ K h).inv (evNatApp φ K)
              rw [hevNat_pos φ K h]
