                 ((weilEtaleModuleUnit W₂ m₀).obj.map (Opposite.op (hT₂.from U)))
                 (hat_g.hom.app (Opposite.op U))) =
             CategoryTheory.CategoryStruct.comp (adjR₁.unit.app (ModuleCat.of R R))
               (CategoryTheory.CategoryStruct.comp
                 ((weilEtaleModuleUnit W₁ m₀).obj.map (Opposite.op (hT₁.from W_U)))
