      h0Y.eq_of_src (CategoryTheory.Limits.cokernel.π f) 0
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    exact (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π f)).mp
      ((CategoryTheory.Category.comp_id _).trans
        (hπ.trans CategoryTheory.Limits.comp_zero.symm))
  have hSheafCokernelZeroOfEpi : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : X ⟶ Y) [CategoryTheory.Epi f],
      CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel f) := by
    intro S X Y f _
    have hπ : CategoryTheory.Limits.cokernel.π f = 0 :=
      (CategoryTheory.cancel_epi f).mp
        ((CategoryTheory.Limits.cokernel.condition f).trans CategoryTheory.Limits.comp_zero.symm)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    exact (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π f)).mp
      ((CategoryTheory.Category.comp_id _).trans
        (hπ.trans CategoryTheory.Limits.comp_zero.symm))
  have hSheafCokernelZeroOfTargetZero : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}} (f : X ⟶ Y),
      CategoryTheory.Limits.IsZero Y →
      CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel f) := by
    intro S X Y f h0Y
    have hπ : CategoryTheory.Limits.cokernel.π f = 0 :=
      h0Y.eq_of_src (CategoryTheory.Limits.cokernel.π f) 0
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    exact (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π f)).mp
      ((CategoryTheory.Category.comp_id _).trans
        (hπ.trans CategoryTheory.Limits.comp_zero.symm))
  have hAbMonoOfKernelZero : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}} (f : X ⟶ Y),
      CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel f) → CategoryTheory.Mono f := by
    intro S X Y f h0
    refine ⟨fun {W} g₁ g₂ hg => sub_eq_zero.mp ?_⟩
    have hsub : (g₁ - g₂) ≫ f = 0 := by
      rw [CategoryTheory.Preadditive.sub_comp, hg, sub_self]
    rw [← CategoryTheory.Limits.kernel.lift_ι f (g₁ - g₂) hsub,
      h0.eq_of_src (CategoryTheory.Limits.kernel.ι f) 0, CategoryTheory.Limits.comp_zero]
  have hAbEpiOfCokernelZero : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}} (f : X ⟶ Y),
      CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel f) → CategoryTheory.Epi f := by
    intro S X Y f h0
    refine ⟨fun {W} g₁ g₂ hg => sub_eq_zero.mp ?_⟩
    have hsub : f ≫ (g₁ - g₂) = 0 := by
      rw [CategoryTheory.Preadditive.comp_sub, hg, sub_self]
    rw [← CategoryTheory.Limits.cokernel.π_desc f (g₁ - g₂) hsub,
      h0.eq_of_tgt (CategoryTheory.Limits.cokernel.π f) 0, CategoryTheory.Limits.zero_comp]
  have hPullbackAffOfClosed : ∀ {Z Y W : AlgebraicGeometry.Scheme.{u}}
      (f : W ⟶ Y) (i : Z ⟶ Y) [AlgebraicGeometry.IsAffine W]
      [AlgebraicGeometry.IsClosedImmersion i],
