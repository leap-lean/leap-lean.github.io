theorem weil_kunneth_torsion_pullback_comp_and_cup_comparison (m₀ : ℕ) :
    (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (q : ℕ)
      (p p' : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q),
      (WeilTopDegTorsionPullback h m₀ q p ∨ WeilLefschetzTorsionPullback h m₀ q p) →
      (WeilTopDegTorsionPullback h m₀ q p' ∨ WeilLefschetzTorsionPullback h m₀ q p') →
      p = p') ∧
    (∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Quiver.Hom W₁ W₂) (h₂ : Quiver.Hom W₂ W₃) (q : ℕ)
      (p₁ : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q)
      (p₂ : weilEtaleTorsionH W₃ m₀ q →+ weilEtaleTorsionH W₂ m₀ q)
      (p₁₂ : weilEtaleTorsionH W₃ m₀ q →+ weilEtaleTorsionH W₁ m₀ q),
      (WeilTopDegTorsionPullback h₁ m₀ q p₁ ∨ WeilLefschetzTorsionPullback h₁ m₀ q p₁) →
      (WeilTopDegTorsionPullback h₂ m₀ q p₂ ∨ WeilLefschetzTorsionPullback h₂ m₀ q p₂) →
      (WeilTopDegTorsionPullback (CategoryTheory.CategoryStruct.comp h₁ h₂) m₀ q p₁₂ ∨
        WeilLefschetzTorsionPullback (CategoryTheory.CategoryStruct.comp h₁ h₂) m₀ q p₁₂) →
      ∀ x : weilEtaleTorsionH W₃ m₀ q, p₁₂ x = p₁ (p₂ x)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (i j c : ℕ) (hij : i + j = c),
      (∀ (k : ℕ) (θ' θ'' : weilEtaleModuleH W m₀ k →+ weilEtaleTorsionH W m₀ k),
        WeilIsModuleToTorsionComparison W m₀ k θ' →
        WeilIsModuleToTorsionComparison W m₀ k θ'' →
        θ' = θ'') →
      (∃ θ₀ : weilEtaleModuleH W m₀ 0 →+ weilEtaleTorsionH W m₀ 0,
        WeilIsModuleToTorsionComparison W m₀ 0 θ₀) →
      ∀ (θ_i : weilEtaleModuleH W m₀ i →+ weilEtaleTorsionH W m₀ i)
        (θ_j : weilEtaleModuleH W m₀ j →+ weilEtaleTorsionH W m₀ j)
        (θ_c : weilEtaleModuleH W m₀ c →+ weilEtaleTorsionH W m₀ c)
        (cup : weilEtaleTorsionH W m₀ i →+ weilEtaleTorsionH W m₀ j →+ weilEtaleTorsionH W m₀ c),
        WeilIsModuleToTorsionComparison W m₀ i θ_i →
        WeilIsModuleToTorsionComparison W m₀ j θ_j →
        WeilIsModuleToTorsionComparison W m₀ c θ_c →
        WeilLefschetzIsTorsionCup W m₀ i j c hij cup →
        ∀ (α : weilEtaleModuleH W m₀ i) (β : weilEtaleModuleH W m₀ j),
          cup (θ_i α) (θ_j β) = θ_c (CategoryTheory.Abelian.Ext.comp α β hij)) :=
by
  have hUnitRes : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      (J₀ : CategoryTheory.GrothendieckTopology C₀)
      (D : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} D]
      [CategoryTheory.HasWeakSheafify J₀ D]
      {T T' : C₀} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T')
      (μ : T' ⟶ T) (A : D),
      (CategoryTheory.constantSheafAdj J₀ D hT).unit.app A ≫
        (((CategoryTheory.constantSheaf J₀ D).obj A).obj.map μ.op) =
        (CategoryTheory.constantSheafAdj J₀ D hT').unit.app A := by
    intro C₀ _ J₀ D _ _ T T' hT hT' μ A
    let η_sh := (CategoryTheory.sheafificationAdjunction J₀ D).unit.app
      ((CategoryTheory.Functor.const C₀ᵒᵖ).obj A)
    dsimp [CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp,
      CategoryTheory.Adjunction.mk', CategoryTheory.constantSheaf]
    simp only [CategoryTheory.constantPresheafAdj_unit_app,
      CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have hnat := η_sh.naturality μ.op
    dsimp [η_sh] at hnat ⊢
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm
  have hConstHomEquiv : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      (J₀ : CategoryTheory.GrothendieckTopology C₀)
      (D : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} D]
      [CategoryTheory.HasWeakSheafify J₀ D]
      {T : C₀} (hT : CategoryTheory.Limits.IsTerminal T)
      (A : D) (𝒢 : CategoryTheory.Sheaf J₀ D)
      (g : (CategoryTheory.constantSheaf J₀ D).obj A ⟶ 𝒢),
