                        ℱ.obj.map (e_Gstep.inv.app U₂.unop).op =
                      ℱ.obj.map (e_Gstep.inv.app U₁.unop).op ≫
                        ℱ.obj.map ((G_k (k + 1)).map u.unop).op
                    rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]; congr 1 }
              inv := ObjectProperty.homMk
                { app := fun U => ℱ.obj.map (e_Gstep.hom.app U.unop).op
                  naturality := fun {U₁ U₂} u => by
                    change ℱ.obj.map ((G_k (k + 1)).map u.unop).op ≫
                        ℱ.obj.map (e_Gstep.hom.app U₂.unop).op =
                      ℱ.obj.map (e_Gstep.hom.app U₁.unop).op ≫
                        ℱ.obj.map ((G_k k).map ((G_k 1).map u.unop)).op
                    rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]; congr 1 }
              hom_inv_id := by
                apply Sheaf.hom_ext; apply NatTrans.ext; funext U
                change ℱ.obj.map (e_Gstep.inv.app U.unop).op ≫
                    ℱ.obj.map (e_Gstep.hom.app U.unop).op = 𝟙 _
                rw [← ℱ.obj.map_comp, ← op_comp, e_Gstep.hom_inv_id_app, op_id, ℱ.obj.map_id]
              inv_hom_id := by
                apply Sheaf.hom_ext; apply NatTrans.ext; funext U
                change ℱ.obj.map (e_Gstep.hom.app U.unop).op ≫
                    ℱ.obj.map (e_Gstep.inv.app U.unop).op = 𝟙 _
                rw [← ℱ.obj.map_comp, ← op_comp, e_Gstep.inv_hom_id_app, op_id, ℱ.obj.map_id] })
          (fun f => by
            apply Sheaf.hom_ext; apply NatTrans.ext; funext U
            exact (f.hom.naturality (e_Gstep.inv.app U.unop).op).symm)
      have hα_step : ∀ A : D,
          α_k (k + 1) A = α_k 1 A ≫ (P_k 1).map (α_k k A) ≫ η_Pstep.hom.app (C.obj A) := by
        intro A
        apply (adj.homEquiv A ((P_k (k + 1)).obj (C.obj A))).injective
        let uA : A ⟶ (C.obj A).obj.obj (Opposite.op T_std) := adj.unit.app A
        let m_αk (U : S.Etale) :
            (C.obj A).obj.obj (Opposite.op U) ⟶ (C.obj A).obj.obj (Opposite.op ((G_k k).obj U)) :=
          (α_k k A).hom.app (Opposite.op U)
