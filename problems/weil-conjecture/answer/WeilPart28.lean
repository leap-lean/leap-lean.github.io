            apply Subtype.ext
            have h_mor : g₁.left ≫ (O_a i₁.1).ι = g₂.left ≫ (O_a i₂.1).ι :=
              congrArg (fun k : Y₀ ⟶ W => k.left) h_eq
            have h_pt : (O_a i₁.1).ι.base (g₁.left.base p) = (O_a i₂.1).ι.base (g₂.left.base p) :=
              (AlgebraicGeometry.Scheme.Hom.comp_apply g₁.left (O_a i₁.1).ι p).symm.trans
                ((congrArg (fun k => k.base p) h_mor).trans
                  (AlgebraicGeometry.Scheme.Hom.comp_apply g₂.left (O_a i₂.1).ι p))
            have hm₁ : s.1 ((O_a i₁.1).ι.base (g₁.left.base p)) = i₁.1 :=
              hMemOpen (O_a i₁.1) (g₁.left.base p)
            have hm₂ : s.1 ((O_a i₂.1).ι.base (g₂.left.base p)) = i₂.1 :=
