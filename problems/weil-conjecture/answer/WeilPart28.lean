        (hMapExtCongrInst i'_push hAc' hAdd_i' hLc' hLim_i' hCc' hColim_i' _ _ a τ'_Z.val))
    obtain ⟨Θ_BC, hΘ_q⟩ := (hModClosed r).2 hi' hi hpb_i
      τ_Y.hCont τ'_Y.hCont hCont_g hCont_gZ P_Y adj_g P_Z adj_gZ
    have hΘ_coh := hΘ_q T_Y hT_Y T_Z hT_Z T_Y' hT_Y' T_Z' hT_Z'
    have hEpi_i' := ((hModClosed r).1 i' hi' τ'_Y.hCont).2 T_Y' hT_Y' T_Z' hT_Z'
    letI := hEpi_i'
    have h_β_Θ_π : β_i ≫ Θ_BC.hom.app One_Z ≫ i'_push.map π_Z = 𝟙 (i'_push.obj One_Z') := by
      apply (CategoryTheory.cancel_epi q_i').mp
      have h1 : q_i' ≫ (β_i ≫ Θ_BC.hom.app One_Z ≫ i'_push.map π_Z) =
          (q_i' ≫ β_i) ≫ Θ_BC.hom.app One_Z ≫ i'_push.map π_Z :=
        (CategoryTheory.Category.assoc _ _ _).symm
      refine h1.trans ?_
      have h2 : (ι_Y ≫ P_Y.map q_i) ≫ Θ_BC.hom.app One_Z ≫ i'_push.map π_Z = q_i' :=
        (CategoryTheory.Category.assoc ι_Y _ _).trans
          ((congrArg (ι_Y ≫ ·) hΘ_coh).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ q_i') hιπ_Y).trans (CategoryTheory.Category.id_comp q_i'))))
      exact ((congrArg (· ≫ _) hqβ_i).trans h2).trans (CategoryTheory.Category.comp_id q_i').symm
    have h_Θ_inv_OneZ : Θ_BC.inv.app One_Z = i'_push.map π_Z ≫ β_i := by
      have h1 : (β_i ≫ Θ_BC.hom.app One_Z) ≫ i'_push.map π_Z ≫ i'_push.map ι_Z =
          i'_push.map ι_Z :=
        ((CategoryTheory.Category.assoc (β_i ≫ Θ_BC.hom.app One_Z) _ _).symm.trans
          ((congrArg (· ≫ i'_push.map ι_Z)
            ((CategoryTheory.Category.assoc β_i _ _).trans h_β_Θ_π)).trans
            (CategoryTheory.Category.id_comp _)))
      have h2 : β_i ≫ Θ_BC.hom.app One_Z = i'_push.map ι_Z :=
        (CategoryTheory.Category.comp_id (β_i ≫ Θ_BC.hom.app One_Z)).symm.trans
          ((congrArg ((β_i ≫ Θ_BC.hom.app One_Z) ≫ ·)
            ((i'_push.map_id (P_Z.obj One_Z)).symm.trans
              ((congrArg i'_push.map hπι_Z.symm).trans (i'_push.map_comp π_Z ι_Z)))).trans h1)
      have h3 : i'_push.map ι_Z ≫ Θ_BC.inv.app One_Z = β_i :=
        (congrArg (· ≫ Θ_BC.inv.app One_Z) h2.symm).trans
          ((CategoryTheory.Category.assoc β_i _ _).trans
            ((congrArg (β_i ≫ ·) (Θ_BC.hom_inv_id_app One_Z)).trans
              (CategoryTheory.Category.comp_id β_i)))
      exact (CategoryTheory.Category.id_comp (Θ_BC.inv.app One_Z)).symm.trans
        ((congrArg (· ≫ Θ_BC.inv.app One_Z)
          ((i'_push.map_id (P_Z.obj One_Z)).symm.trans
            ((congrArg i'_push.map hπι_Z.symm).trans (i'_push.map_comp π_Z ι_Z)))).trans
          ((CategoryTheory.Category.assoc _ _ _).trans (congrArg (i'_push.map π_Z ≫ ·) h3)))
    have h_ι_Θ_inv : i'_push.map ι_Z ≫ Θ_BC.inv.app One_Z = β_i :=
      (congrArg (i'_push.map ι_Z ≫ ·) h_Θ_inv_OneZ).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ β_i)
            ((i'_push.map_comp ι_Z π_Z).symm.trans
              ((congrArg i'_push.map (hπ_Z_align ▸ hιπ_Z_raw)).trans (i'_push.map_id One_Z')))).trans
            (CategoryTheory.Category.id_comp β_i)))
    let β_si : si'_push.obj One_S' ⟶ P_Y.obj (si_push.obj One_S) :=
      α'_push ≫ i'_push.map β_s ≫ Θ_BC.inv.app (s_push.obj One_S) ≫ P_Y.map β_push
    have hq_β_si : q_si' ≫ β_si = ι_Y ≫ P_Y.map q_si := by
      have h_qs_nat : i'_push.map (P_Z.map q_s) ≫ Θ_BC.inv.app (s_push.obj One_S) =
          Θ_BC.inv.app One_Z ≫ P_Y.map (i_push.map q_s) :=
        Θ_BC.inv.naturality q_s
      have h_qsi_β : (q_i ≫ i_push.map q_s) ≫ β_push = q_si :=
        (congrArg (· ≫ β_push) hqc.symm).trans
          ((CategoryTheory.Category.assoc q_si α_push β_push).trans
            ((congrArg (q_si ≫ ·) hαβ).trans (CategoryTheory.Category.comp_id q_si)))
      calc
        q_si' ≫ (α'_push ≫ i'_push.map β_s ≫ Θ_BC.inv.app (s_push.obj One_S) ≫ P_Y.map β_push)
            = (q_si' ≫ α'_push) ≫ i'_push.map β_s ≫ Θ_BC.inv.app (s_push.obj One_S) ≫ P_Y.map β_push :=
          (CategoryTheory.Category.assoc _ _ _).symm
        _ = q_i' ≫ (i'_push.map q_s' ≫ i'_push.map β_s) ≫
              Θ_BC.inv.app (s_push.obj One_S) ≫ P_Y.map β_push := by
          rw [hqc', CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = q_i' ≫ (i'_push.map ι_Z ≫ (i'_push.map (P_Z.map q_s) ≫ Θ_BC.inv.app (s_push.obj One_S))) ≫
              P_Y.map β_push := by
          rw [← i'_push.map_comp, hqβ_s, i'_push.map_comp]
          simp only [CategoryTheory.Category.assoc]
        _ = (q_i' ≫ (i'_push.map ι_Z ≫ Θ_BC.inv.app One_Z)) ≫
              (P_Y.map (i_push.map q_s) ≫ P_Y.map β_push) := by
          rw [h_qs_nat]
          simp only [CategoryTheory.Category.assoc]
        _ = ι_Y ≫ P_Y.map ((q_i ≫ i_push.map q_s) ≫ β_push) := by
          rw [h_ι_Θ_inv, hqβ_i, CategoryTheory.Category.assoc,
            ← P_Y.map_comp, ← P_Y.map_comp, CategoryTheory.Category.assoc]
        _ = ι_Y ≫ P_Y.map q_si := by rw [h_qsi_β]
    refine ⟨hCont_g, P_Y, adj_g, hAdd_PY, hLim_PY, hColim_PY,
      T_Y, hT_Y, T_S, hT_S, T_Y', hT_Y', T_S', hT_S',
      ι_Y, β_si, hιπ_Y, hπι_Y, hq_β_si, ?_⟩
    exact hExtPasteSquare i_push i'_push P_Z P_Y Θ_BC.inv
      α_push β_push hβα α'_push β_s π_Z β_i π_Y h_Θ_inv_OneZ hab
      τ_Z.val τ_Y.val τ'_Z.val τ'_Y.val τ_SY.val τ'_SY.val
      hval_Z'_al hval_Y'_al hval_SY hval_SY'

theorem weil_gysin_ab_support_comparison_and_gysin_transition (hExactAb : WeilGysinSuppCalcClosedExactAb.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
      AlgebraicGeometry.IsClosedImmersion i →
      ∀ (r q : ℕ)
        (τ₀ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
        (α₀ : WeilGysinAbSupportClass Z Y i (ℓ ^ r) q),
        ∃ e_ab : weilGysinSupportExtGroup τ₀ ≃+ weilGysinAbSupportExtGroup α₀,
          ∀ (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
            (α : WeilGysinAbSupportClass Z Y i (ℓ ^ r) q),
            WeilGysinIsAbSupportComparison τ α ↔ e_ab τ.val = α.val) ∧
    (∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
      {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
      (hsi : CategoryTheory.CategoryStruct.comp s i = si),
      AlgebraicGeometry.IsClosedImmersion s →
      AlgebraicGeometry.IsClosedImmersion i →
      AlgebraicGeometry.IsClosedImmersion si →
      ∀ {r a b c : ℕ} (hab : a + b = c)
        (τ_Z_succ : WeilGysinSupportClass S Z s (ℓ ^ (r + 1)) a)
        (τ_Z_curr : WeilGysinSupportClass S Z s (ℓ ^ r) a)
        (τ_Y_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) b)
        (τ_Y_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) b)
        (τ_SY_succ : WeilGysinSupportClass S Y si (ℓ ^ (r + 1)) c)
        (τ_SY_curr : WeilGysinSupportClass S Y si (ℓ ^ r) c)
        (α_Z_succ : WeilGysinAbSupportClass S Z s (ℓ ^ (r + 1)) a)
        (α_Z_curr : WeilGysinAbSupportClass S Z s (ℓ ^ r) a)
        (α_Y_succ : WeilGysinAbSupportClass Z Y i (ℓ ^ (r + 1)) b)
        (α_Y_curr : WeilGysinAbSupportClass Z Y i (ℓ ^ r) b)
        (α_SY_succ : WeilGysinAbSupportClass S Y si (ℓ ^ (r + 1)) c)
        (α_SY_curr : WeilGysinAbSupportClass S Y si (ℓ ^ r) c),
        WeilGysinIsAbSupportComparison τ_Z_succ α_Z_succ →
        WeilGysinIsAbSupportComparison τ_Z_curr α_Z_curr →
        WeilGysinIsAbSupportComparison τ_Y_succ α_Y_succ →
        WeilGysinIsAbSupportComparison τ_Y_curr α_Y_curr →
        WeilGysinIsAbSupportComparison τ_SY_succ α_SY_succ →
        WeilGysinIsAbSupportComparison τ_SY_curr α_SY_curr →
        WeilGysinSupportGysinComp hsi hab τ_Z_succ τ_Y_succ τ_SY_succ →
        WeilGysinSupportGysinComp hsi hab τ_Z_curr τ_Y_curr τ_SY_curr →
        weilGysinAbSupportTransition ℓ r a α_Z_succ = α_Z_curr →
        weilGysinAbSupportTransition ℓ r b α_Y_succ = α_Y_curr →
        weilGysinAbSupportTransition ℓ r c α_SY_succ = α_SY_curr) :=
by
  
  
  
  have hasSheafCompose_of_adj : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {L : B ⥤ A} {F : A ⥤ B} (_ : L ⊣ F), J.HasSheafCompose F := by
    intro C _ J A B _ _ L F adj
    refine ⟨fun P hP E => ?_⟩
    let isoE : (P ⋙ F) ⋙ coyoneda.obj (Opposite.op E) ≅
        P ⋙ coyoneda.obj (Opposite.op (L.obj E)) :=
      NatIso.ofComponents
        (fun W => (adj.homEquiv E (P.obj W)).symm.toIso)
        (fun {W₁ W₂} u => by
          ext g
          exact Adjunction.homEquiv_naturality_right_symm adj g (P.map u))
    exact Presieve.isSheaf_iso J isoE.symm (hP (L.obj E))

  let sheafComposeAdjRight : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {F : A ⥤ B} {G : B ⥤ A} (adj : F ⊣ G) [J.HasSheafCompose F] [J.HasSheafCompose G],
      sheafCompose J F ⊣ sheafCompose J G := fun {C} _ J {A B} _ _ {F G} adj _ _ =>
    let liftEquiv (P : Cᵒᵖ ⥤ A) (Q : Cᵒᵖ ⥤ B) : (P ⋙ F ⟶ Q) ≃ (P ⟶ Q ⋙ G) :=
      { toFun := fun φ =>
          { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
            naturality := fun {W₁ W₂} u => by
              have hnat : F.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
              change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
                adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ G.map (Q.map u)
              rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
                ← Adjunction.homEquiv_naturality_left adj] }
        invFun := fun ψ =>
          { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
            naturality := fun {W₁ W₂} u => by
              have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ G.map (Q.map u) := ψ.naturality u
              change F.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
                (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
              rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
                ← Adjunction.homEquiv_naturality_right_symm adj] }
        left_inv := fun φ => by ext W; exact (adj.homEquiv _ _).symm_apply_apply _
        right_inv := fun ψ => by ext W; exact (adj.homEquiv _ _).apply_symm_apply _ }
    Adjunction.mkOfHomEquiv
      { homEquiv := fun ℱ 𝒢 =>
          { toFun := fun φ => ⟨liftEquiv ℱ.obj 𝒢.obj φ.hom⟩
            invFun := fun ψ => ⟨(liftEquiv ℱ.obj 𝒢.obj).symm ψ.hom⟩
            left_inv := fun φ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).symm_apply_apply φ.hom
            right_inv := fun ψ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).apply_symm_apply ψ.hom }
        homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} h ψ => by
          ext W
          exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
        homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} φ k => by
          ext W
          exact Adjunction.homEquiv_naturality_right adj (φ.hom.app W) (k.hom.app W) }

  let sheafComposeAdjLeft : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {L : B ⥤ A} {F : A ⥤ B} (adj : L ⊣ F) [J.HasSheafCompose F] [HasWeakSheafify J A],
      (sheafToPresheaf J B ⋙
          { obj := fun P => P ⋙ L
            map := fun f => Functor.whiskerRight f L } ⋙
          presheafToSheaf J A) ⊣
        sheafCompose J F := fun {C} _ J {A B} _ _ {L F} adj _ _ =>
    let liftTo (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (φ : P ⋙ L ⟶ Q) : P ⟶ Q ⋙ F :=
      { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
        naturality := fun {W₁ W₂} u => by
          have hnat : L.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
          change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
            adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ F.map (Q.map u)
          rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
            ← Adjunction.homEquiv_naturality_left adj] }
    let liftInv (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (ψ : P ⟶ Q ⋙ F) : P ⋙ L ⟶ Q :=
      { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
        naturality := fun {W₁ W₂} u => by
          have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ F.map (Q.map u) := ψ.naturality u
          change L.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
            (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
          rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
            ← Adjunction.homEquiv_naturality_right_symm adj] }
    Adjunction.mkOfHomEquiv
      { homEquiv := fun 𝒢 ℱ =>
          { toFun := fun φ =>
              ⟨liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ)⟩
            invFun := fun ψ =>
              ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ).symm
                (liftInv 𝒢.obj ℱ.obj ψ.hom)
            left_inv := fun φ => by
              have h : liftInv 𝒢.obj ℱ.obj
                  (liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ)) =
                  (sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ := by
                ext W
                exact (adj.homEquiv _ _).symm_apply_apply _
              exact (congrArg ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ).symm h).trans
                (Equiv.symm_apply_apply _ φ)
            right_inv := fun ψ => by
              ext W
              have h := Equiv.apply_symm_apply
                ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ)
                (liftInv 𝒢.obj ℱ.obj ψ.hom)
              have hW := congrArg (fun α => α.app W) h
              exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ.obj.obj W)) hW).trans
                ((adj.homEquiv _ _).apply_symm_apply (ψ.hom.app W)) }
        homEquiv_naturality_left_symm := fun {𝒢' 𝒢 ℱ} h ψ => by
          have h1 : liftInv 𝒢'.obj ℱ.obj ((h ≫ ψ).hom) =
              Functor.whiskerRight h.hom L ≫ liftInv 𝒢.obj ℱ.obj ψ.hom := by
            ext W
            exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
          exact (congrArg ((sheafificationAdjunction J A).homEquiv (𝒢'.obj ⋙ L) ℱ).symm h1).trans
            (Adjunction.homEquiv_naturality_left_symm
              (sheafificationAdjunction J A) (Functor.whiskerRight h.hom L)
              (liftInv 𝒢.obj ℱ.obj ψ.hom))
        homEquiv_naturality_right := fun {𝒢 ℱ ℱ'} φ k => by
          ext W
          have h1 := Adjunction.homEquiv_naturality_right (sheafificationAdjunction J A) φ k
          have h1W := congrArg (fun α => α.app W) h1
          exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ'.obj.obj W)) h1W).trans
            (Adjunction.homEquiv_naturality_right adj _ (k.hom.app W)) }

  have sheaf_eq_of_obj_eq : ∀ {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
      {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : Sheaf J A},
      ℱ₁.obj = ℱ₂.obj → ℱ₁ = ℱ₂ := by
    intro C _ J A _ ℱ₁ ℱ₂ h
    rcases ℱ₁ with ⟨o₁, p₁⟩
    rcases ℱ₂ with ⟨o₂, p₂⟩
    change o₁ = o₂ at h
    subst h
    rfl

  have sheaf_hom_eq :
      ∀ {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
        {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J A}
        (f₁ f₂ : ℱ₁ ⟶ ℱ₂),
        (∀ W : Cᵒᵖ, f₁.hom.app W = f₂.hom.app W) → f₁ = f₂ := by
    intro C _ J A _ ℱ₁ ℱ₂ ⟨h₁⟩ ⟨h₂⟩ h
    congr 1
    exact CategoryTheory.NatTrans.ext (funext h)

  have hConstUnitMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒜]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (φ : T₂ ⟶ T₁) (X : 𝒜),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).unit.app X ≫
        (((CategoryTheory.constantSheaf S.smallEtaleTopology 𝒜).obj X).obj.map φ.op) =
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).unit.app X := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ φ X
    let J := S.smallEtaleTopology
    let P_X := (CategoryTheory.Functor.const S.Etaleᵒᵖ).obj X
    let η_X := (CategoryTheory.sheafificationAdjunction J 𝒜).unit.app P_X
    have h_nat := η_X.naturality φ.op
    dsimp [P_X] at h_nat
    rw [CategoryTheory.Category.id_comp] at h_nat
    have h_u₁ : (CategoryTheory.constantSheafAdj J 𝒜 hT₁).unit.app X = η_X.app (Opposite.op T₁) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    have h_u₂ : (CategoryTheory.constantSheafAdj J 𝒜 hT₂).unit.app X = η_X.app (Opposite.op T₂) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [h_u₁, h_u₂]
    exact h_nat.symm

  have hConstSymmMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒜]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (X : 𝒜)
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology 𝒜)
      (f : X ⟶ ℱ.obj.obj (Opposite.op T₁)),
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).homEquiv X ℱ).symm
        (f ≫ ℱ.obj.map (hT₁.from T₂).op) =
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).homEquiv X ℱ).symm f := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ X ℱ f
    let J := S.smallEtaleTopology
    set rhs := ((CategoryTheory.constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ).symm f
    apply ((CategoryTheory.constantSheafAdj J 𝒜 hT₂).homEquiv X ℱ).injective
    rw [Equiv.apply_symm_apply]
    have h₁ : ((CategoryTheory.constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ) rhs = f :=
      Equiv.apply_symm_apply _ _
    rw [CategoryTheory.Adjunction.homEquiv_unit] at h₁ ⊢
    change (CategoryTheory.constantSheafAdj J 𝒜 hT₁).unit.app X ≫
        rhs.hom.app (Opposite.op T₁) = f at h₁
    change f ≫ ℱ.obj.map (hT₁.from T₂).op =
      (CategoryTheory.constantSheafAdj J 𝒜 hT₂).unit.app X ≫
        rhs.hom.app (Opposite.op T₂)
    rw [← hConstUnitMap hT₁ hT₂ (hT₁.from T₂) X, CategoryTheory.Category.assoc,
      rhs.hom.naturality (hT₁.from T₂).op, ← CategoryTheory.Category.assoc, h₁]

  have mapExactFunctor_comp_apply :
      ∀ {A B D : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A] [EnoughInjectives A]
        [Category.{u + 1} B] [Abelian B] [HasExt.{u} B]
        [Category.{u + 1} D] [Abelian D] [HasExt.{u} D]
        (F : A ⥤ B) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
        (G : B ⥤ D) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
        {X Y : A} {n : ℕ} (x : Abelian.Ext X Y n),
        let _ : Limits.PreservesFiniteLimits (F ⋙ G) := Limits.comp_preservesFiniteLimits F G
        let _ : Limits.PreservesFiniteColimits (F ⋙ G) := Limits.comp_preservesFiniteColimits F G
        Abelian.Ext.mapExactFunctor (F ⋙ G) x =
          Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor F x) := by
    intro A B D _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _
    have _ : Limits.PreservesFiniteLimits (F ⋙ G) := Limits.comp_preservesFiniteLimits F G
    have _ : Limits.PreservesFiniteColimits (F ⋙ G) := Limits.comp_preservesFiniteColimits F G
    intro X Y n
    induction n generalizing Y with
    | zero =>
      intro x
      dsimp only
      rw [← Abelian.Ext.mk₀_addEquiv₀_apply x,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ n ih =>
      intro x
      let ι : Y ⟶ Injective.under Y := Injective.ι Y
      let S_Y : ShortComplex A :=
        ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS_Y : S_Y.ShortExact := { exact := ShortComplex.exact_cokernel ι }
      have h_zero : x.comp (Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (n + 1)) = 0 := by
        have hIdim : HasInjectiveDimensionLT (Injective.under Y) 1 := inferInstance
        exact (hasInjectiveDimensionLT_iff (Injective.under Y) 1).mp hIdim (n + 1)
          (Nat.le_add_left 1 n) _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS_Y x h_zero rfl
      dsimp only
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, ih z,
        Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_extClass]

  have ext_vanish_of_effaceable :
      ∀ {D : Type (u + 1)} [Category.{u + 1} D] [Abelian D] [HasExt.{u} D] [EnoughInjectives D]
        (T_pred : D → Prop),
        (∀ {K' P : D} (ι : K' ⟶ P) [Mono ι], T_pred P → T_pred K') →
        (∀ E : D, ∃ (P : D) (q : P ⟶ E), T_pred P ∧ Epi q) →
        ∀ (Y : D),
          (∀ (SC : ShortComplex D), SC.ShortExact → T_pred SC.X₃ →
            ∀ (g₀ : SC.X₁ ⟶ Y), ∃ h : SC.X₂ ⟶ Y, SC.f ≫ h = g₀) →
          ∀ (p : ℕ) {K : D}, T_pred K → ∀ (e : Abelian.Ext K Y (p + 1)), e = 0 := by
    intro D _ _ _ _ T_pred hSub hCover Y hExt
    let R_Y := InjectiveResolution.of Y
    have hPull : ∀ (q : ℕ) (K : D) (f : K ⟶ R_Y.cocomplex.X (q + 1))
        (_ : f ≫ R_Y.cocomplex.d (q + 1) (q + 2) = 0),
        ∃ (P : D) (π : P ⟶ K) (g : P ⟶ R_Y.cocomplex.X q),
          T_pred P ∧ Epi π ∧ g ≫ R_Y.cocomplex.d q (q + 1) = π ≫ f := by
      intro q K f hf
      let SC_q : ShortComplex D :=
        ShortComplex.mk (R_Y.cocomplex.d q (q + 1)) (R_Y.cocomplex.d (q + 1) (q + 2))
          (R_Y.cocomplex.d_comp_d q (q + 1) (q + 2))
      have hEx_q : SC_q.Exact := R_Y.exact_succ q
      have _ : Epi SC_q.toCycles := (ShortComplex.exact_iff_epi_toCycles SC_q).mp hEx_q
      let f_cyc : K ⟶ SC_q.cycles := SC_q.liftCycles f hf
      let E_pb := Limits.pullback SC_q.toCycles f_cyc
      let p_pb : E_pb ⟶ K := Limits.pullback.snd SC_q.toCycles f_cyc
      have _ : Epi p_pb := Abelian.epi_pullback_of_epi_f SC_q.toCycles f_cyc
      let g_pb : E_pb ⟶ R_Y.cocomplex.X q := Limits.pullback.fst SC_q.toCycles f_cyc
      obtain ⟨P, q_P, hTP, hEpi_q⟩ := hCover E_pb
      refine ⟨P, q_P ≫ p_pb, q_P ≫ g_pb, hTP, epi_comp q_P p_pb, ?_⟩
      change (q_P ≫ g_pb) ≫ SC_q.f = (q_P ≫ p_pb) ≫ f
      rw [← SC_q.toCycles_i, Category.assoc, ← Category.assoc g_pb, Limits.pullback.condition,
        Category.assoc, SC_q.liftCycles_i, Category.assoc]
    intro p
    induction p with
    | zero =>
      intro K hTK e
      obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e 2 rfl
      obtain ⟨P, π, g, hTP, hEpi_π, hg⟩ := hPull 0 K f hf
      let ι := Limits.kernel.ι π
      let S_π : ShortComplex D := ShortComplex.mk ι π (Limits.kernel.condition π)
      have hS_π : S_π.ShortExact := { exact := ShortComplex.exact_kernel π }
      have h_ig : (ι ≫ g) ≫ R_Y.cocomplex.d 0 1 = 0 := by
        rw [Category.assoc, hg, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
      have _ : Mono (R_Y.ι.f 0) := inferInstance
      let ι₀ : Y ⟶ R_Y.cocomplex.X 0 := R_Y.ι.f 0
      let getZero {SC : ShortComplex D} (_ : SC.Exact) : SC.f ≫ SC.g = 0 := SC.zero
      have hι₀_d : ι₀ ≫ R_Y.cocomplex.d 0 1 = 0 := getZero R_Y.exact₀
      let g₀ : Limits.kernel π ⟶ Y :=
        (R_Y.exact₀).fIsKernel.lift (Limits.KernelFork.ofι (ι ≫ g) h_ig)
      have hg₀ : g₀ ≫ ι₀ = ι ≫ g :=
        (R_Y.exact₀).fIsKernel.fac (Limits.KernelFork.ofι (ι ≫ g) h_ig)
          Limits.WalkingParallelPair.zero
      obtain ⟨h, hh⟩ := hExt S_π hS_π hTK g₀
      have h_sub_ker : ι ≫ (g - h ≫ ι₀) = 0 := by
        rw [Preadditive.comp_sub, ← Category.assoc]
        change ι ≫ g - (S_π.f ≫ h) ≫ ι₀ = 0
        rw [hh, hg₀, sub_self]
      let s : K ⟶ R_Y.cocomplex.X 0 :=
        hS_π.exact.gIsCokernel.desc (Limits.CokernelCofork.ofπ (g - h ≫ ι₀) h_sub_ker)
      have hs : π ≫ s = g - h ≫ ι₀ :=
        hS_π.exact.gIsCokernel.fac (Limits.CokernelCofork.ofπ (g - h ≫ ι₀) h_sub_ker)
          Limits.WalkingParallelPair.one
      have hs_d : s ≫ R_Y.cocomplex.d 0 1 = f := by
        apply (cancel_epi π).mp
        rw [← Category.assoc, hs, Preadditive.sub_comp, hg, Category.assoc, hι₀_d,
          Limits.comp_zero, sub_zero]
      exact (R_Y.extMk_eq_zero_iff f 2 rfl hf 0 rfl).mpr ⟨s, hs_d⟩
    | succ p' ih =>
      intro K hTK e
      obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e (p' + 3) rfl
      obtain ⟨P, π, g, hTP, hEpi_π, hg⟩ := hPull (p' + 1) K f hf
      have h_pull_zero :
          (Abelian.Ext.mk₀ π).comp (R_Y.extMk f (p' + 3) rfl hf) (Nat.zero_add (p' + 2)) = 0 := by
        rw [R_Y.mk₀_comp_extMk]
        exact (R_Y.extMk_eq_zero_iff (π ≫ f) (p' + 3) rfl _ (p' + 1) rfl).mpr ⟨g, hg⟩
      let ι := Limits.kernel.ι π
      let S_π : ShortComplex D := ShortComplex.mk ι π (Limits.kernel.condition π)
      have hS_π : S_π.ShortExact := { exact := ShortComplex.exact_kernel π }
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS_π Y
        (R_Y.extMk f (p' + 3) rfl hf) h_pull_zero (Nat.add_comm 1 (p' + 1))
      rw [← hx₁, ih (hSub ι hTP) x₁, Abelian.Ext.comp_zero]

  have ext_comparison_bijective_of_acyclic :
      ∀ {A D : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A] [EnoughInjectives A]
        [Category.{u + 1} D] [Abelian D] [HasExt.{u} D]
        (U : A ⥤ D) [U.Additive] [Limits.PreservesFiniteLimits U] [Limits.PreservesFiniteColimits U]
        (X₀ : A) (Z₀ : D) (η : Z₀ ⟶ U.obj X₀),
        (∀ ℱ : A, Function.Bijective (fun x : Abelian.Ext X₀ ℱ 0 =>
          (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U x) (Nat.zero_add 0))) →
        (∀ (ℐ : A) [Injective ℐ] (p : ℕ) (e : Abelian.Ext Z₀ (U.obj ℐ) (p + 1)), e = 0) →
        ∀ (k : ℕ) (ℱ : A), Function.Bijective (fun x : Abelian.Ext X₀ ℱ k =>
          (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U x) (Nat.zero_add k)) := by
    intro A D _ _ _ _ _ _ _ U _ _ _ X₀ Z₀ η hBase hAcyc
    let Θ (ℱ : A) (k : ℕ) : Abelian.Ext X₀ ℱ k →+ Abelian.Ext Z₀ (U.obj ℱ) k :=
      ((Abelian.Ext.mk₀ η).precomp (U.obj ℱ) (Nat.zero_add k)).comp (U.mapExtAddHom X₀ ℱ k)
    change ∀ (k : ℕ) (ℱ : A), Function.Bijective (Θ ℱ k)
    intro k
    induction k with
    | zero =>
      intro ℱ
      exact hBase ℱ
    | succ k ih =>
      intro ℱ
      let ℐ := Injective.under ℱ
      let i_ℱ : ℱ ⟶ ℐ := Injective.ι ℱ
      let Q := Limits.cokernel i_ℱ
      let p_ℱ : ℐ ⟶ Q := Limits.cokernel.π i_ℱ
      let S_ℱ : ShortComplex A := ShortComplex.mk i_ℱ p_ℱ (Limits.cokernel.condition i_ℱ)
      have hS_ℱ : S_ℱ.ShortExact := { exact := ShortComplex.exact_cokernel i_ℱ }
      have hUS_ℱ : (S_ℱ.map U).ShortExact := hS_ℱ.map_of_exact U
      have hΘ_p : ∀ y : Abelian.Ext X₀ ℐ k,
          Θ Q k (y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k)) =
            (Θ ℐ k y).comp (Abelian.Ext.mk₀ (S_ℱ.map U).g) (Nat.add_zero k) := by
        intro y
        change (Abelian.Ext.mk₀ η).comp
            (Abelian.Ext.mapExactFunctor U (y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k)))
            (Nat.zero_add k) =
          ((Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U y) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ (U.map S_ℱ.g)) (Nat.add_zero k)
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) (Abelian.Ext.mapExactFunctor U y)
            (Abelian.Ext.mk₀ (U.map S_ℱ.g)) (Nat.zero_add k) (Nat.add_zero k) (Nat.zero_add k)]
      have hΘ_δ : ∀ z : Abelian.Ext X₀ Q k,
          Θ ℱ (k + 1) (z.comp hS_ℱ.extClass rfl) =
            (Θ Q k z).comp hUS_ℱ.extClass rfl := by
        intro z
        change (Abelian.Ext.mk₀ η).comp
            (Abelian.Ext.mapExactFunctor U (z.comp hS_ℱ.extClass rfl))
            (Nat.zero_add (k + 1)) =
          ((Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U z) (Nat.zero_add k)).comp
            hUS_ℱ.extClass rfl
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) (Abelian.Ext.mapExactFunctor U z)
            hUS_ℱ.extClass (Nat.zero_add k) rfl (Nat.zero_add (k + 1))]
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro x hx
        have hx0 : x.comp (Abelian.Ext.mk₀ S_ℱ.f) (Nat.add_zero (k + 1)) = 0 := by
          have hIdim : HasInjectiveDimensionLT ℐ 1 := inferInstance
          exact (hasInjectiveDimensionLT_iff ℐ 1).mp hIdim (k + 1) (Nat.le_add_left 1 k) _
        obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X₀ hS_ℱ x hx0 rfl
        have hz0 : (Θ Q k z).comp hUS_ℱ.extClass rfl = 0 := by
          rw [← hΘ_δ z, hx]
        obtain ⟨y', hy'⟩ := Abelian.Ext.covariant_sequence_exact₃ Z₀ hUS_ℱ (Θ Q k z) rfl hz0
        obtain ⟨y, rfl⟩ := (ih ℐ).surjective y'
        have hz_eq : z = y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k) :=
          (ih Q).injective ((hΘ_p y).trans hy').symm
        rw [hz_eq, Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ S_ℱ.g) hS_ℱ.extClass
          (Nat.add_zero k) (Nat.zero_add 1) rfl, hS_ℱ.comp_extClass, Abelian.Ext.comp_zero]
      · intro w
        have hw0 : w.comp (Abelian.Ext.mk₀ (S_ℱ.map U).f) (Nat.add_zero (k + 1)) = 0 :=
          hAcyc ℐ k _
        obtain ⟨z', rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ Z₀ hUS_ℱ w hw0 rfl
        obtain ⟨z, rfl⟩ := (ih Q).surjective z'
        exact ⟨z.comp hS_ℱ.extClass rfl, hΘ_δ z⟩

  have ext_postcomp_apply :
      ∀ {A : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A]
        {X Y Z : A} {a b ab : ℕ} (y : Abelian.Ext Y Z b) (h : a + b = ab)
        (x : Abelian.Ext X Y a),
        (y.postcomp X h) x = x.comp y h :=
    fun _ _ _ => rfl

  have ext_precomp_apply :
      ∀ {A : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A]
        {X Y Z : A} {a b ab : ℕ} (x : Abelian.Ext X Y a) (h : a + b = ab)
        (y : Abelian.Ext Y Z b),
        (x.precomp Z h) y = x.comp y h :=
    fun _ _ _ => rfl

  have mapExtAddHom_apply :
      ∀ {A B : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A]
        [Category.{u + 1} B] [Abelian B] [HasExt.{u} B]
        (F : A ⥤ B) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
        (X Y : A) (n : ℕ) (x : Abelian.Ext X Y n),
        (F.mapExtAddHom X Y n) x = Abelian.Ext.mapExactFunctor F x := by
    intros; rfl

  have cokernel_univ_map_of_preserves :
      ∀ {𝒜 ℬ : Type (u + 1)} [Category.{u, u + 1} 𝒜] [Abelian 𝒜]
        [Category.{u + 1, u + 1} ℬ] [Abelian ℬ]
        (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteColimits G]
        {X Q : 𝒜} (m : ℕ) (p : X ⟶ Q)
        (h0 : (m • 𝟙 X) ≫ p = 0)
        (hdesc : ∀ {W : 𝒜} (g : X ⟶ W), (m • 𝟙 X) ≫ g = 0 → ∃! g_bar : Q ⟶ W, p ≫ g_bar = g),
        ((m • 𝟙 (G.obj X)) ≫ G.map p = 0) ∧
        (∀ {T : ℬ} (g : G.obj X ⟶ T), (m • 𝟙 (G.obj X)) ≫ g = 0 →
          ∃! g_bar : G.obj Q ⟶ T, G.map p ≫ g_bar = g) := by
    intro 𝒜 ℬ _ _ _ _ G _ _ X Q m p h0 hdesc
    have hc0 : Limits.IsColimit (Limits.CokernelCofork.ofπ p h0) :=
      Limits.CokernelCofork.IsColimit.ofπ p h0
        (fun {_} g' hg' => (hdesc g' hg').choose)
        (fun {_} g' hg' => (hdesc g' hg').choose_spec.1)
        (fun {_} g' hg' k hk => (hdesc g' hg').choose_spec.2 k hk)
    have hcG := Limits.isColimitCoforkMapOfIsColimit G _ hc0
    have hmap_m : G.map (m • 𝟙 X) = m • 𝟙 (G.obj X) := by
      rw [G.map_nsmul, G.map_id]
    have hmap_0 : G.map (0 : X ⟶ X) = 0 := G.map_zero X X
    have hG0 : (m • 𝟙 (G.obj X)) ≫ G.map p = 0 := by
      rw [← hmap_m, ← G.map_comp, h0, G.map_zero]
    refine ⟨hG0, fun {T} g hg => ?_⟩
    have hcond : G.map (m • 𝟙 X) ≫ g = G.map (0 : X ⟶ X) ≫ g := by
      rw [hmap_m, hmap_0, hg, Limits.zero_comp]
    let s : Limits.Cofork (G.map (m • 𝟙 X)) (G.map (0 : X ⟶ X)) :=
      Limits.Cofork.ofπ g hcond
    have hfac : G.map p ≫ hcG.desc s = g :=
      hcG.fac s Limits.WalkingParallelPair.one
    refine ⟨hcG.desc s, hfac, fun k hk => ?_⟩
    apply Limits.Cofork.IsColimit.hom_ext hcG
    change G.map p ≫ k = G.map p ≫ hcG.desc s
    exact hk.trans hfac.symm

  let z_to_m_of (m : ℕ) :
      AddCommGrpCat.of (ULift.{u} ℤ) ⟶
        AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)) :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }

  have z_to_m_cokernel_univ : ∀ (m : ℕ),
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      ((m • 𝟙 Aℤ) ≫ z_to_m_of m = 0) ∧
      (∀ {W : AddCommGrpCat.{u}} (g : Aℤ ⟶ W), (m • 𝟙 Aℤ) ≫ g = 0 →
        ∃! g_bar : AM ⟶ W, z_to_m_of m ≫ g_bar = g) := by
    intro m Aℤ AM
    have h0 : (m • 𝟙 Aℤ) ≫ z_to_m_of m = 0 := by
      ext ⟨z⟩
      change ULift.up (((m • z : ℤ) : ZMod m)) = ULift.up 0
      congr 1
      rw [nsmul_eq_mul, Int.cast_mul, Int.cast_natCast, CharP.cast_eq_zero, zero_mul]
    refine ⟨h0, fun {W} g hg => ?_⟩
    have h_wd : ∀ z₁ z₂ : ℤ, (z₁ : ZMod m) = (z₂ : ZMod m) →
        g (ULift.up z₁) = g (ULift.up z₂) := by
      intro z₁ z₂ hcast
      obtain ⟨k, hk⟩ := (ZMod.intCast_eq_intCast_iff_dvd_sub z₁ z₂ m).mp hcast
      have hz₂ : ULift.up z₂ = ULift.up z₁ + (m • 𝟙 Aℤ) (ULift.up k) := by
        ext
        change z₂ = z₁ + m • k
        rw [nsmul_eq_mul]
        linarith
      have hgk : g ((m • 𝟙 Aℤ) (ULift.up k)) = 0 := by
        change ((m • 𝟙 Aℤ) ≫ g) (ULift.up k) = 0
        rw [hg]; rfl
      rw [hz₂, map_add, hgk, add_zero]
    let liftZ (x : ZMod m) : ℤ := Classical.choose (ZMod.intCast_surjective x)
    have hliftZ (x : ZMod m) : (liftZ x : ZMod m) = x :=
      Classical.choose_spec (ZMod.intCast_surjective x)
    let g_bar : AM ⟶ W := AddCommGrpCat.ofHom
      { toFun := fun a => g (ULift.up (liftZ a.down))
        map_zero' := by
          have h0_eq : g (ULift.up (liftZ 0)) = g (ULift.up 0) :=
            h_wd _ 0 ((hliftZ 0).trans Int.cast_zero.symm)
          exact h0_eq.trans (map_zero g.hom)
        map_add' := fun a b => by
          have hadd_eq : g (ULift.up (liftZ (a.down + b.down))) =
              g (ULift.up (liftZ a.down + liftZ b.down)) :=
            h_wd _ _ ((hliftZ _).trans (by rw [Int.cast_add, hliftZ, hliftZ]))
          exact hadd_eq.trans (map_add g.hom (ULift.up (liftZ a.down)) (ULift.up (liftZ b.down))) }
    have hz_bar : z_to_m_of m ≫ g_bar = g := by
      ext ⟨z⟩
      exact h_wd (liftZ (z : ZMod m)) z (hliftZ (z : ZMod m))
    refine ⟨g_bar, hz_bar, fun k hk => ?_⟩
    have hkg : z_to_m_of m ≫ k = z_to_m_of m ≫ g_bar := hk.trans hz_bar.symm
    ext ⟨a⟩
    have ha : (⟨a⟩ : AM) = (z_to_m_of m).hom (ULift.up (liftZ a)) := by
      ext; exact (hliftZ a).symm
    rw [ha]
    change (z_to_m_of m ≫ k).hom (ULift.up (liftZ a)) =
      (z_to_m_of m ≫ g_bar).hom (ULift.up (liftZ a))
    rw [hkg]

  
  
  
  have hHasSC_fgt : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      S.smallEtaleTopology.HasSheafCompose
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    exact hasSheafCompose_of_adj S.smallEtaleTopology
      (eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R)))

  let U_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) ⥤
        CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    let _ := hHasSC_fgt S m
    CategoryTheory.sheafCompose S.smallEtaleTopology
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u})

  have hAdd_U : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ), (U_of S m).Additive := by
    intro S m
    exact { map_add := by intros; ext W x; rfl }

  have hLim_U : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      Limits.PreservesFiniteLimits (U_of S m) ∧
      Limits.PreservesFiniteColimits (U_of S m) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let adjModL : (eZ.inverse ⋙ ModuleCat.extendScalars (Int.castRingHom R)) ⊣
        CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u} :=
      eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R))
    let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      eZ.inverse ⋙ ModuleCat.coextendScalars (Int.castRingHom R)
    let adjModR : CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u} ⊣ C_mod :=
      (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
    have _ : J.HasSheafCompose C_mod := hasSheafCompose_of_adj J adjModR
    have _ : (U_of S m).IsLeftAdjoint := ⟨sheafCompose J C_mod, ⟨sheafComposeAdjRight J adjModR⟩⟩
    have _ : (U_of S m).IsRightAdjoint := ⟨_, ⟨sheafComposeAdjLeft J adjModL⟩⟩
    exact ⟨inferInstance, inferInstance⟩

  have hExtMod : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      HasExt.{u} (CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))) := fun _ _ => inferInstance

  have hExtAb : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      HasExt.{u} (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun _ => inferInstance

  let One_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
    (CategoryTheory.constantSheaf S.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))).obj
      (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m)))

  let T_of (S : AlgebraicGeometry.Scheme.{u}) : S.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : AlgebraicGeometry.Etale (𝟙 S))

  let hT_of (S : AlgebraicGeometry.Scheme.{u}) : Limits.IsTerminal (T_of S) :=
    let FgtFF := AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S
    Limits.IsTerminal.ofUniqueHom
      (fun W => FgtFF.preimage
        (Over.mkIdTerminal.from ((AlgebraicGeometry.Scheme.Etale.forget S).obj W)))
      (fun W f => FgtFF.map_injective (Over.mkIdTerminal.hom_ext _ _))

  let ιM_of (m : ℕ) :
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)) ⟶
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).obj
          (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) :=
    AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u, 0} (ZMod m)))

  let u₀_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).obj
          (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) ⟶
        ((CategoryTheory.sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op (T_of S))).obj
          ((U_of S m).obj (One_of S m)) :=
    (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).map
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) (hT_of S)).unit.app
        (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))))

  let αM_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      weilEtaleTorsionSheaf S m ⟶ (U_of S m).obj (One_of S m) :=
    ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
      ((U_of S m).obj (One_of S m))).symm (ιM_of m ≫ u₀_of S m)

  have h_αM_homEquiv : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
        ((U_of S m).obj (One_of S m))
        (αM_of S m) = ιM_of m ≫ u₀_of S m :=
    fun _ _ => Equiv.apply_symm_apply _ _

  have hαM_indep : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      (T_S : S.Etale) (hT_S : Limits.IsTerminal T_S),
      let R := ULift.{u, 0} (ZMod m)
      let R_mod := ModuleCat.of R R
      let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let adj_ab_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
      let adj_mod_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT_S
      (adj_ab_S.homEquiv AM ((U_of S m).obj (One_of S m))).symm
        (ιM_of m ≫ F_fg.map (adj_mod_S.unit.app R_mod)) = αM_of S m := by
    intro S m T_S hT_S R R_mod F_fg AM adj_ab_S adj_mod_S
    let φ : T_S ⟶ T_of S := (hT_of S).from T_S
    have hu : (CategoryTheory.constantSheafAdj S.smallEtaleTopology
          (ModuleCat.{u, u} R) (hT_of S)).unit.app R_mod ≫
        (One_of S m).obj.map φ.op = adj_mod_S.unit.app R_mod :=
      hConstUnitMap (hT_of S) hT_S φ R_mod
    have hmap : ιM_of m ≫ F_fg.map (adj_mod_S.unit.app R_mod) =
        (ιM_of m ≫ u₀_of S m) ≫ ((U_of S m).obj (One_of S m)).obj.map φ.op := by
      rw [← hu, F_fg.map_comp, ← Category.assoc]
      rfl
    exact (congrArg (adj_ab_S.homEquiv AM ((U_of S m).obj (One_of S m))).symm hmap).trans
      (hConstSymmMap (hT_of S) hT_S AM ((U_of S m).obj (One_of S m)) (ιM_of m ≫ u₀_of S m))

  have hβM_exists : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      ∃ βM : (U_of S m).obj (One_of S m) ⟶ weilEtaleTorsionSheaf S m,
        αM_of S m ≫ βM = 𝟙 (weilEtaleTorsionSheaf S m) ∧
        βM ≫ αM_of S m = 𝟙 ((U_of S m).obj (One_of S m)) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      eZ.inverse ⋙ ModuleCat.coextendScalars (Int.castRingHom R)
    let adjModR : FgtMod ⊣ C_mod :=
      (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
    have _ : J.HasSheafCompose C_mod := hasSheafCompose_of_adj J adjModR
    let C_sh := CategoryTheory.sheafCompose J C_mod
    let eShR (ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R))
        (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        ((U_of S m).obj ℱ ⟶ 𝒢) ≃ (ℱ ⟶ C_sh.obj 𝒢) :=
      { toFun := fun φ =>
          ⟨{ app := fun W => adjModR.homEquiv (ℱ.obj.obj W) (𝒢.obj.obj W) (φ.hom.app W)
             naturality := fun {W₁ W₂} u => by
               have h1 := Adjunction.homEquiv_naturality_left adjModR (ℱ.obj.map u) (φ.hom.app W₂)
               have h2 := Adjunction.homEquiv_naturality_right adjModR (φ.hom.app W₁) (𝒢.obj.map u)
               exact h1.symm.trans ((congrArg _ (φ.hom.naturality u)).trans h2) }⟩
        invFun := fun ψ =>
          ⟨{ app := fun W => (adjModR.homEquiv (ℱ.obj.obj W) (𝒢.obj.obj W)).symm (ψ.hom.app W)
             naturality := fun {W₁ W₂} u => by
               have h1 := Adjunction.homEquiv_naturality_left_symm adjModR (ℱ.obj.map u) (ψ.hom.app W₂)
               have h2 := Adjunction.homEquiv_naturality_right_symm adjModR (ψ.hom.app W₁) (𝒢.obj.map u)
               exact h1.symm.trans ((congrArg _ (ψ.hom.naturality u)).trans h2) }⟩
        left_inv := fun φ => by
          apply sheaf_hom_eq; intro W
          exact (adjModR.homEquiv _ _).symm_apply_apply (φ.hom.app W)
        right_inv := fun ψ => by
          apply sheaf_hom_eq; intro W
          exact (adjModR.homEquiv _ _).apply_symm_apply (ψ.hom.app W) }
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let R_mod := ModuleCat.of R R
    let FM := weilEtaleTorsionSheaf S m
    let oneR := One_of S m
    let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} (hT_of S)
    let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) (hT_of S)
    let ιM : AM ⟶ FgtMod.obj R_mod := ιM_of m
    let ιM_inv : FgtMod.obj R_mod ⟶ AM := AddCommGrpCat.ofHom (AddMonoidHom.id R)
    have hιM_1 : ιM ≫ ιM_inv = 𝟙 AM := by ext ⟨x⟩; rfl
    have hιM_2 : ιM_inv ≫ ιM = 𝟙 (FgtMod.obj R_mod) := by ext ⟨x⟩; rfl
    let evMod (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        (R_mod ⟶ ((sheafSections J (ModuleCat.{u, u} R)).obj (Opposite.op (T_of S))).obj (C_sh.obj 𝒢)) ≃
          (FgtMod.obj R_mod ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) :=
      (adjModR.homEquiv R_mod (𝒢.obj.obj (Opposite.op (T_of S)))).symm
    let preEqv (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        (FgtMod.obj R_mod ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) ≃
          (AM ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) :=
      { toFun := fun f => ιM ≫ f
        invFun := fun g => ιM_inv ≫ g
        left_inv := fun f => by dsimp only; rw [← Category.assoc, hιM_2, Category.id_comp]
        right_inv := fun g => by dsimp only; rw [← Category.assoc, hιM_1, Category.id_comp] }
    let eHom (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        ((U_of S m).obj oneR ⟶ 𝒢) ≃ (FM ⟶ 𝒢) :=
      (eShR oneR 𝒢).trans
        ((adjR.homEquiv R_mod (C_sh.obj 𝒢)).trans
          ((evMod 𝒢).trans ((preEqv 𝒢).trans (adjℤ.homEquiv AM 𝒢).symm)))
    have heHom_apply : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (φ : (U_of S m).obj oneR ⟶ 𝒢), eHom 𝒢 φ = αM_of S m ≫ φ := by
      intro 𝒢 φ
      change (adjℤ.homEquiv AM 𝒢).symm
          (ιM_of m ≫ (evMod 𝒢) ((adjR.homEquiv R_mod (C_sh.obj 𝒢)) ((eShR oneR 𝒢) φ))) =
        αM_of S m ≫ φ
      apply (adjℤ.homEquiv AM 𝒢).injective
      rw [Equiv.apply_symm_apply, Adjunction.homEquiv_naturality_right adjℤ (αM_of S m) φ,
        h_αM_homEquiv, Category.assoc]
      congr 1
      apply (evMod 𝒢).symm.injective
      rw [Equiv.symm_apply_apply]
      change adjR.homEquiv R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ) =
        adjModR.homEquiv R_mod (𝒢.obj.obj (Opposite.op (T_of S)))
          (FgtMod.map (adjR.unit.app R_mod) ≫ φ.hom.app (Opposite.op (T_of S)))
      have h_adjR : adjR.homEquiv R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ) =
          adjR.unit.app R_mod ≫
            adjModR.homEquiv (oneR.obj.obj (Opposite.op (T_of S)))
              (𝒢.obj.obj (Opposite.op (T_of S))) (φ.hom.app (Opposite.op (T_of S))) :=
        Adjunction.homEquiv_unit adjR R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ)
      have h_nat_mod : adjR.unit.app R_mod ≫
          adjModR.homEquiv (oneR.obj.obj (Opposite.op (T_of S)))
            (𝒢.obj.obj (Opposite.op (T_of S))) (φ.hom.app (Opposite.op (T_of S))) =
          adjModR.homEquiv R_mod (𝒢.obj.obj (Opposite.op (T_of S)))
            (FgtMod.map (adjR.unit.app R_mod) ≫ φ.hom.app (Opposite.op (T_of S))) :=
        (Adjunction.homEquiv_naturality_left adjModR
          (adjR.unit.app R_mod) (φ.hom.app (Opposite.op (T_of S)))).symm
      exact h_adjR.trans h_nat_mod
    let βM : (U_of S m).obj oneR ⟶ FM := (eHom FM).symm (𝟙 FM)
    have hαβ : αM_of S m ≫ βM = 𝟙 FM := by
      rw [← heHom_apply FM βM]
      exact (eHom FM).apply_symm_apply (𝟙 FM)
    have hβα : βM ≫ αM_of S m = 𝟙 ((U_of S m).obj oneR) := by
      apply (eHom ((U_of S m).obj oneR)).injective
      rw [heHom_apply, heHom_apply, Category.comp_id, ← Category.assoc, hαβ, Category.id_comp]
    exact ⟨βM, hαβ, hβα⟩

  let βM_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (U_of S m).obj (One_of S m) ⟶ weilEtaleTorsionSheaf S m :=
    Classical.choose (hβM_exists S m)

  have hαβ_of : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      αM_of S m ≫ βM_of S m = 𝟙 (weilEtaleTorsionSheaf S m) :=
    fun S m => (Classical.choose_spec (hβM_exists S m)).1

  have hβα_of : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      βM_of S m ≫ αM_of S m = 𝟙 ((U_of S m).obj (One_of S m)) :=
    fun S m => (Classical.choose_spec (hβM_exists S m)).2

  have hUFaith_of : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))}
      {ψ₁ ψ₂ : ℱ₁ ⟶ ℱ₂},
      (U_of S m).map ψ₁ = (U_of S m).map ψ₂ → ψ₁ = ψ₂ := by
    intro S m ℱ₁ ℱ₂ ψ₁ ψ₂ h
    ext W x
    exact congrArg (fun k => k.hom.app W x) h

  have hMono_Aℤ : ∀ (n : ℕ), n ≠ 0 →
      Mono (n • 𝟙 (AddCommGrpCat.of (ULift.{u} ℤ))) := by
    intro n hn
    rw [AddCommGrpCat.mono_iff_injective]
    intro ⟨x⟩ ⟨y⟩ hxy
    have h' : (n : ℤ) * x = (n : ℤ) * y := by
      have hd := congrArg ULift.down hxy
      change n • x = n • y at hd
      rwa [nsmul_eq_mul, nsmul_eq_mul] at hd
    exact congrArg ULift.up (mul_left_cancel₀ (Nat.cast_ne_zero.mpr hn) h')

  
  have hGenSiteBij : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      (𝒳₀ : CategoryTheory.Sheaf Y.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))))
      (ℰ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (ζ : ℰ ⟶ (U_of Y m).obj 𝒳₀),
      (∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 ℰ)) →
      (m • 𝟙 ℰ) ≫ ζ = 0 →
      (∀ {ℬ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}} (g : ℰ ⟶ ℬ),
        (m • 𝟙 ℰ) ≫ g = 0 → ∃! g_bar : (U_of Y m).obj 𝒳₀ ⟶ ℬ, ζ ≫ g_bar = g) →
      ∀ (q : ℕ)
        (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))),
        let _ := hAdd_U Y m
        let _ := (hLim_U Y m).1
        let _ := (hLim_U Y m).2
        let _ := hExtMod Y m
        let _ := hExtAb Y
        Function.Bijective (fun x : Abelian.Ext.{u} 𝒳₀ ℱ q =>
          (Abelian.Ext.mk₀ ζ).comp
            (Abelian.Ext.mapExactFunctor (U_of Y m) x) (Nat.zero_add q)) := by
    intro Y m 𝒳₀ ℰ ζ hTF_ℰ hζ0 hζ_desc
    let R := ULift.{u, 0} (ZMod m)
    let J := Y.smallEtaleTopology
    have _ := hHasSC_fgt Y m
    have _ := hAdd_U Y m
    have _ := (hLim_U Y m).1
    have _ := (hLim_U Y m).2
    have _ : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) :=
      inferInstance
    have _ : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
      inferInstance
    have _ := hExtMod Y m
    have _ := hExtAb Y
    have _ : EnoughInjectives (CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) := inferInstance
    have _ : EnoughInjectives (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    
    have hLiftModHom : ∀ {M N : ModuleCat.{u, u} R} (g : FgtMod.obj M ⟶ FgtMod.obj N),
        ∃ f : M ⟶ N, FgtMod.map f = g := by
      intro M N g
      refine ⟨ModuleCat.ofHom
        { toFun := g.hom.toFun
          map_add' := g.hom.map_add'
          map_smul' := fun r x => by
            obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
            have hzr : (z : R) = r := by ext; exact hz
            simp only [RingHom.id_apply, ← hzr]
            rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
            exact map_zsmul g.hom z x }, ?_⟩
      ext x; rfl
    have hFgtInj : ∀ {M N : ModuleCat.{u, u} R} {f₁ f₂ : M ⟶ N},
        FgtMod.map f₁ = FgtMod.map f₂ → f₁ = f₂ := by
      intro M N f₁ f₂ h; ext x; exact congrArg (fun k => k x) h
    have hUFull : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)}
        (φ : (U_of Y m).obj ℱ₁ ⟶ (U_of Y m).obj ℱ₂),
        ∃ ψ : ℱ₁ ⟶ ℱ₂, (U_of Y m).map ψ = φ := by
      intro ℱ₁ ℱ₂ φ
      choose appL happL using fun W => hLiftModHom (φ.hom.app W)
      refine ⟨⟨{ app := appL
                 naturality := fun {W₁ W₂} u => by
                   apply hFgtInj
                   rw [FgtMod.map_comp, FgtMod.map_comp, happL W₁, happL W₂]
                   exact φ.hom.naturality u }⟩, ?_⟩
      ext W x; exact congrArg (fun k => k x) (happL W)
    have hUFaith : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)} {ψ₁ ψ₂ : ℱ₁ ⟶ ℱ₂},
        (U_of Y m).map ψ₁ = (U_of Y m).map ψ₂ → ψ₁ = ψ₂ :=
      fun h => hUFaith_of Y m h
    let upHom : ZMod m →+* R :=
      { toFun := ULift.up
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hm_tors : ∀ ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
        m • 𝟙 ((U_of Y m).obj ℱ) = 0 := by
      intro ℱ
      ext W x
      let M_W : Type u := ℱ.obj.obj W
      let modZ : Module (ZMod m) M_W := Module.compHom M_W upHom
      exact @ZModModule.char_nsmul_eq_zero m M_W _ modZ x
    have hLiftSheaf : ∀ (ℬ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        m • 𝟙 ℬ = 0 → ∃ ℬ_mod : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
          (U_of Y m).obj ℬ_mod = ℬ := by
      intro ℬ hm
      let downHom : R →+* ZMod m :=
        { toFun := ULift.down
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      let objMod (W : (Y.Etale)ᵒᵖ) : ModuleCat.{u, u} R :=
        let hmW : ∀ x : ℬ.obj.obj W, m • x = 0 := fun x => by
          change ((m • 𝟙 ℬ).hom.app W) x = 0
          rw [hm]; rfl
        letI : Module (ZMod m) (ℬ.obj.obj W) := AddCommGroup.zmodModule hmW
        letI : Module R (ℬ.obj.obj W) := Module.compHom (ℬ.obj.obj W) downHom
        ModuleCat.of R (ℬ.obj.obj W)
      choose mapMod hmapMod using fun {W₁ W₂ : (Y.Etale)ᵒᵖ} (u : W₁ ⟶ W₂) =>
        hLiftModHom (M := objMod W₁) (N := objMod W₂) (ℬ.obj.map u)
      let P_mod : (Y.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
        { obj := objMod
          map := fun u => mapMod u
          map_id := fun W => hFgtInj (by rw [hmapMod, FgtMod.map_id]; exact ℬ.obj.map_id W)
          map_comp := fun u v => hFgtInj (by
            rw [hmapMod, FgtMod.map_comp, hmapMod, hmapMod]; exact ℬ.obj.map_comp u v) }
      have hP_comp : P_mod ⋙ FgtMod = ℬ.obj := by
        refine CategoryTheory.Functor.ext (fun _ => rfl) (fun _ _ u => ?_)
        dsimp; rw [Category.id_comp, Category.comp_id]; exact hmapMod u
      have hIsSheaf : Presheaf.IsSheaf J P_mod := by
        intro E
        let eqvW (W : (Y.Etale)ᵒᵖ) : (E ⟶ objMod W) ≃ (FgtMod.obj E ⟶ ℬ.obj.obj W) :=
          { toFun := fun f => FgtMod.map f
            invFun := fun g => Classical.choose (hLiftModHom (M := E) (N := objMod W) g)
            left_inv := fun f => hFgtInj (Classical.choose_spec
              (hLiftModHom (M := E) (N := objMod W) (FgtMod.map f)))
            right_inv := fun g => Classical.choose_spec
              (hLiftModHom (M := E) (N := objMod W) g) }
        let isoE : P_mod ⋙ coyoneda.obj (Opposite.op E) ≅
            ℬ.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E)) :=
          NatIso.ofComponents (fun W => (eqvW W).toIso) (fun {W₁ W₂} u => by
            ext f
            change FgtMod.map (f ≫ mapMod u) = FgtMod.map f ≫ ℬ.obj.map u
            rw [FgtMod.map_comp, hmapMod])
        exact Presieve.isSheaf_iso J isoE.symm (ℬ.property (FgtMod.obj E))
      exact ⟨⟨P_mod, hIsSheaf⟩, sheaf_eq_of_obj_eq hP_comp⟩
    
    have hBase : ∀ ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
        Function.Bijective (fun x : Abelian.Ext.{u} 𝒳₀ ℱ 0 =>
          (Abelian.Ext.mk₀ ζ).comp
            (Abelian.Ext.mapExactFunctor (U_of Y m) x) (Nat.zero_add 0)) := by
      intro ℱ
      have h_map_bij : Function.Bijective (fun φ : 𝒳₀ ⟶ ℱ => (U_of Y m).map φ) :=
        ⟨fun _ _ h => hUFaith h, fun ψ => hUFull ψ⟩
      have h_ζ_bij : Function.Bijective
          (fun g_bar : (U_of Y m).obj 𝒳₀ ⟶ (U_of Y m).obj ℱ => ζ ≫ g_bar) := by
        refine ⟨fun g₁ g₂ h12 => ?_, fun g => ?_⟩
        · have hg_cond : (m • 𝟙 ℰ) ≫ (ζ ≫ g₂) = 0 := by
            rw [← Category.assoc, hζ0, Limits.zero_comp]
          exact (hζ_desc (ζ ≫ g₂) hg_cond).unique h12 rfl
        · have hg_cond : (m • 𝟙 ℰ) ≫ g = 0 := by
            have hcomm : (m • 𝟙 ℰ) ≫ g = g ≫ (m • 𝟙 ((U_of Y m).obj ℱ)) := by
              rw [Preadditive.nsmul_comp, Category.id_comp,
                Preadditive.comp_nsmul, Category.comp_id]
            rw [hcomm, hm_tors ℱ, Limits.comp_zero]
          exact (hζ_desc g hg_cond).exists
      have h_hom_bij : Function.Bijective (fun φ : 𝒳₀ ⟶ ℱ => ζ ≫ (U_of Y m).map φ) :=
        h_ζ_bij.comp h_map_bij
      let mk0Dom : (𝒳₀ ⟶ ℱ) ≃ Abelian.Ext.{u} 𝒳₀ ℱ 0 :=
        Equiv.ofBijective Abelian.Ext.mk₀ (Abelian.Ext.mk₀_bijective 𝒳₀ ℱ)
      let mk0Cod : (ℰ ⟶ (U_of Y m).obj ℱ) ≃ Abelian.Ext.{u} ℰ ((U_of Y m).obj ℱ) 0 :=
        Equiv.ofBijective Abelian.Ext.mk₀ (Abelian.Ext.mk₀_bijective ℰ ((U_of Y m).obj ℱ))
      have h_ext0 : (fun x : Abelian.Ext.{u} 𝒳₀ ℱ 0 =>
          (Abelian.Ext.mk₀ ζ).comp
            (Abelian.Ext.mapExactFunctor (U_of Y m) x) (Nat.zero_add 0)) =
          (mk0Cod ∘ (fun φ => ζ ≫ (U_of Y m).map φ) ∘ mk0Dom.symm) := by
        funext x
        obtain ⟨φ, rfl⟩ := mk0Dom.surjective x
        have hsymm : mk0Dom.symm (mk0Dom φ) = φ := mk0Dom.symm_apply_apply φ
        dsimp only [Function.comp_apply]
        rw [hsymm]
        change (Abelian.Ext.mk₀ ζ).comp
            (Abelian.Ext.mapExactFunctor (U_of Y m) (Abelian.Ext.mk₀ φ)) (Nat.zero_add 0) =
          Abelian.Ext.mk₀ (ζ ≫ (U_of Y m).map φ)
        rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      rw [h_ext0]
      exact mk0Cod.bijective.comp (h_hom_bij.comp mk0Dom.symm.bijective)
    
    let isTF_cat {C : Type (u + 1)} [Category.{u + 1} C] [Preadditive C] (K : C) : Prop :=
      ∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 K)
    have isTF_sub : ∀ {C : Type (u + 1)} [Category.{u + 1} C] [Preadditive C] {K' P : C}
        (ι : K' ⟶ P) [Mono ι], isTF_cat P → isTF_cat K' := by
      intro C _ _ K' P ι _ hP n hn
      have _ : Mono (n • 𝟙 P) := hP n hn
      have hcomm : (n • 𝟙 K') ≫ ι = ι ≫ (n • 𝟙 P) := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
      have _ : Mono ((n • 𝟙 K') ≫ ι) := by
        rw [hcomm]; exact mono_comp ι (n • 𝟙 P)
      exact mono_of_mono (n • 𝟙 K') ι
    have isTF_map : ∀ {A B : Type (u + 1)} [Category.{u + 1} A] [Preadditive A]
        [Category.{u + 1} B] [Preadditive B] (F : A ⥤ B) [F.Additive]
        [Limits.PreservesFiniteLimits F] {K : A}, isTF_cat K → isTF_cat (F.obj K) := by
      intro A B _ _ _ _ F _ _ K hK n hn
      have _ : Mono (n • 𝟙 K) := hK n hn
      have hmap : F.map (n • 𝟙 K) = n • 𝟙 (F.obj K) := by
        rw [F.map_nsmul, F.map_id]
      rw [← hmap]; exact F.map_mono (n • 𝟙 K)
    have hasColimOfGroth : ∀ (C : Type (u + 1)) [Category.{u + 1} C] [Abelian C]
        [IsGrothendieckAbelian.{u} C],
        Limits.HasColimitsOfSize.{0, u} C ∧ Limits.HasColimitsOfSize.{u, u} C ∧
          LocallySmall.{u} C :=
      fun C _ _ _ => ⟨Limits.hasColimitsOfSizeShrink C, Limits.hasColimitsOfSizeShrink C,
        inferInstance⟩
    let sigmaObjU {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} (X : ι → C) : C :=
      Limits.sigmaObj X
    let sigmaDesc {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} {X : ι → C} {Z : C} (c : ∀ i, X i ⟶ Z) : sigmaObjU X ⟶ Z :=
      Limits.Sigma.desc c
    let sigmaIota {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} (X : ι → C) (i : ι) : X i ⟶ sigmaObjU X :=
      Limits.Sigma.ι X i
    have sigmaIotaDesc : ∀ {C : Type (u + 1)} [Category.{u + 1} C]
        [Limits.HasColimitsOfSize.{u, u} C] {ι : Type u} {X : ι → C} {Z : C}
        (c : ∀ i, X i ⟶ Z) (i : ι), sigmaIota X i ≫ sigmaDesc c = c i :=
      fun c i => Limits.Sigma.ι_comp_desc c i
    have isTF_sigma : ∀ {C : Type (u + 1)} [Category.{u + 1} C] [Abelian C]
        [IsGrothendieckAbelian.{u} C] [Limits.HasColimitsOfSize.{0, u} C]
        [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} (X : ι → C), (∀ i : ι, isTF_cat (X i)) → isTF_cat (sigmaObjU X) := by
      intro C _ _ _ _ _ ι X hX n hn
      have _ : AB4OfSize.{u} C := AB4OfSize_shrink C
      have _ : HasExactColimitsOfShape (Discrete ι) C := AB4OfSize.ofShape ι
      let D : Discrete ι ⥤ C := Discrete.functor X
      let φ : D ⟶ D := n • 𝟙 D
      have _ : ∀ j : Discrete ι, Mono (φ.app j) := fun ⟨i⟩ => hX i n hn
      have _ : Mono φ := NatTrans.mono_of_mono_app φ
      exact Limits.colim.map_mono' φ (Limits.colimit.isColimit D) (Limits.colimit.isColimit D)
        (n • 𝟙 (sigmaObjU X)) (fun ⟨i⟩ => by
          change sigmaIota X i ≫ (n • 𝟙 (sigmaObjU X)) =
            (n • 𝟙 (X i)) ≫ sigmaIota X i
          rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
    have hCover : ∀ ℰ' : CategoryTheory.Sheaf J AddCommGrpCat.{u},
        ∃ (P : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (q : P ⟶ ℰ'),
          isTF_cat P ∧ Epi q := by
      let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology Y
      have _ : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}) :=
        inferInstance
      obtain ⟨hColim0_aff, hColimU_aff, _⟩ :=
        hasColimOfGroth (CategoryTheory.Sheaf J_aff AddCommGrpCat.{u})
      obtain ⟨hColim0_J, hColimU_J, hLocSmall_J⟩ :=
        hasColimOfGroth (CategoryTheory.Sheaf J AddCommGrpCat.{u})
      have _ := hColim0_aff; have _ := hColimU_aff
      have _ := hColim0_J; have _ := hColimU_J; have _ := hLocSmall_J
      have hMono_sigma_Aℤ : ∀ (ι : Type u) (n : ℕ), n ≠ 0 →
          Mono (n • 𝟙 (Limits.sigmaObj (fun _ : ι => Aℤ))) := by
        intro ι n hn
        have _ : AB4OfSize.{u} AddCommGrpCat.{u} := inferInstance
        have _ : HasExactColimitsOfShape (Discrete ι) AddCommGrpCat.{u} := AB4OfSize.ofShape ι
        let D : Discrete ι ⥤ AddCommGrpCat.{u} := Discrete.functor (fun _ : ι => Aℤ)
        let φ : D ⟶ D := n • 𝟙 D
        have _ : ∀ j : Discrete ι, Mono (φ.app j) := fun ⟨_⟩ => hMono_Aℤ n hn
        have _ : Mono φ := NatTrans.mono_of_mono_app φ
        exact Limits.colim.map_mono' φ (Limits.colimit.isColimit D) (Limits.colimit.isColimit D)
