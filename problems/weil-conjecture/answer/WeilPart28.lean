      (CategoryTheory.cancel_mono f).mp
        ((CategoryTheory.Limits.kernel.condition f).trans CategoryTheory.Limits.zero_comp.symm)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    exact (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι f)).mp
      ((CategoryTheory.Category.id_comp _).trans
        (hι.trans CategoryTheory.Limits.zero_comp.symm))
  have hAbCokernelZeroOfEpi : ∀ {X Y : AddCommGrpCat.{u}} (f : X ⟶ Y) [CategoryTheory.Epi f],
      CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel f) := by
    intro X Y f _
    have hπ : CategoryTheory.Limits.cokernel.π f = 0 :=
      (CategoryTheory.cancel_epi f).mp
        ((CategoryTheory.Limits.cokernel.condition f).trans CategoryTheory.Limits.comp_zero.symm)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    exact (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π f)).mp
      ((CategoryTheory.Category.comp_id _).trans
        (hπ.trans CategoryTheory.Limits.comp_zero.symm))
  have hAbCokernelZeroOfTargetZero : ∀ {X Y : AddCommGrpCat.{u}} (f : X ⟶ Y),
      CategoryTheory.Limits.IsZero Y →
      CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel f) := by
    intro X Y f h0Y
