          ((P_pull'.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) k) x) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ πM'_raw) (Nat.add_zero k) =
        ((Abelian.Ext.mk₀ ιℤ₀).comp
          ((P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) k) x) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ πM₀) (Nat.add_zero k)
      rw [hπM'_eq, hExtIso P_pull P_pull' η (C₂.obj Aℤ) (C₂.obj AM) k x,
          ext_conj_eq ι'ℤ (η.inv.app (C₂.obj Aℤ)) (η.hom.app (C₂.obj AM)) (π'_fn AM),
          hι_inv_eq, ← hπ_rel AM,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ιℤ₀) _ _ (Nat.zero_add k) (Nat.add_zero k) (by omega)]
    have hp_a_eq : p_a = p_std a := hp_eq_std a p_a hp_a
    have hp_b_eq : p_b = p_std b := hp_eq_std b p_b hp_b
    have hp_c_eq : p_c = p_std c := hp_eq_std c p_c hp_c
    have hm_U₂ : ∀ ℱ₂ : Sheaf J₂ (ModuleCat.{u, u} R), m • 𝟙 (P_pull.obj (U₂.obj ℱ₂)) = 0 := by
      intro ℱ₂
      have hm₀ : m • 𝟙 ℱ₂ = 0 := by
        let smulEnd (r : R) : ℱ₂ ⟶ ℱ₂ :=
          { hom :=
              { app := fun V =>
                  ModuleCat.ofHom
                    { toFun := fun x => r • x
                      map_add' := smul_add r
                      map_smul' := fun c x => smul_comm r c x }
                naturality := fun {V₁ V₂} φ =>
                  ModuleCat.hom_ext
                    (LinearMap.ext fun x => ((ℱ₂.obj.map φ).hom.map_smul r x).symm) } }
        have hsmulEnd : ∀ k : ℕ, k • 𝟙 ℱ₂ = smulEnd (k : R) := by
          intro k
          induction k with
          | zero =>
            rw [zero_nsmul, Nat.cast_zero]
            exact ObjectProperty.hom_ext _ (NatTrans.ext (funext fun V =>
              ModuleCat.hom_ext (LinearMap.ext fun x => (zero_smul R x).symm)))
          | succ k ih =>
            rw [succ_nsmul, ih, Nat.cast_add, Nat.cast_one]
            exact ObjectProperty.hom_ext _ (NatTrans.ext (funext fun V =>
              ModuleCat.hom_ext (LinearMap.ext fun x => by
                change (k : R) • x + x = ((k : R) + 1) • x
                rw [add_smul, one_smul])))
        have hmr : (m : R) = 0 := ULift.ext _ _ (CharP.cast_eq_zero (ZMod m) m)
        have h0 : smulEnd 0 = 0 := by rw [← Nat.cast_zero, ← hsmulEnd 0, zero_nsmul]
        rw [hsmulEnd m, hmr, h0]
      rw [← P_pull.map_id, ← U₂.map_id, ← Functor.map_nsmul, ← Functor.map_nsmul,
          hm₀, Functor.map_zero, Functor.map_zero]
    let obj_R (ℱ₂ : Sheaf J₂ (ModuleCat.{u, u} R)) : Sheaf J₁ (ModuleCat.{u, u} R) :=
      Classical.choose (hliftSheaf (P_pull.obj (U₂.obj ℱ₂)) (hm_U₂ ℱ₂))
    let iso_R (ℱ₂ : Sheaf J₂ (ModuleCat.{u, u} R)) : U₁.obj (obj_R ℱ₂) ≅ P_pull.obj (U₂.obj ℱ₂) :=
      Classical.choice (Classical.choose_spec (hliftSheaf (P_pull.obj (U₂.obj ℱ₂)) (hm_U₂ ℱ₂)))
    let P_pull_R : Sheaf J₂ (ModuleCat.{u, u} R) ⥤ Sheaf J₁ (ModuleCat.{u, u} R) :=
      { obj := obj_R
        map := fun {ℱ 𝒢} f =>
          ff_U₁.preimage ((iso_R ℱ).hom ≫ P_pull.map (U₂.map f) ≫ (iso_R 𝒢).inv)
        map_id := fun ℱ => ff_U₁.map_injective (by
          rw [ff_U₁.map_preimage, U₂.map_id, P_pull.map_id, Category.id_comp,
              (iso_R ℱ).hom_inv_id, U₁.map_id])
        map_comp := fun {ℱ 𝒢 ℋ} f g => ff_U₁.map_injective (by
          rw [U₁.map_comp, ff_U₁.map_preimage, ff_U₁.map_preimage, ff_U₁.map_preimage,
              U₂.map_comp, P_pull.map_comp]
          simp only [Category.assoc, Iso.inv_hom_id_assoc]) }
    let δ : P_pull_R ⋙ U₁ ≅ U₂ ⋙ P_pull :=
      NatIso.ofComponents iso_R (fun {ℱ 𝒢} f => by
        change U₁.map (P_pull_R.map f) ≫ (iso_R 𝒢).hom = (iso_R ℱ).hom ≫ P_pull.map (U₂.map f)
        rw [ff_U₁.map_preimage]
        simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id])
    have hCompLim : Limits.PreservesFiniteLimits (P_pull_R ⋙ U₁) :=
      Limits.preservesFiniteLimits_of_natIso δ.symm
    have hCompColim : Limits.PreservesFiniteColimits (P_pull_R ⋙ U₁) :=
      Limits.preservesFiniteColimits_of_natIso δ.symm
    have : Limits.PreservesFiniteLimits P_pull_R :=
      Limits.preservesFiniteLimits_of_reflects_of_preserves P_pull_R U₁
    have : Limits.PreservesFiniteColimits P_pull_R :=
      Limits.preservesFiniteColimits_of_reflects_of_preserves P_pull_R U₁
    have : P_pull_R.Additive :=
      { map_add := fun {ℱ 𝒢} {f g} => ff_U₁.map_injective (by
          rw [U₁.map_add, ff_U₁.map_preimage, ff_U₁.map_preimage, ff_U₁.map_preimage,
              U₂.map_add, P_pull.map_add, Preadditive.add_comp, Preadditive.comp_add]) }
    let αM₁ := (adjℤ₁.homEquiv AM (U₁.obj One₁)).symm (ιM ≫ u₁₀)
    let αM₂ := (adjℤ₂.homEquiv AM (U₂.obj One₂)).symm (ιM ≫ u₂₀)
    let ηℤ₁ := (adjℤ₁.homEquiv Aℤ (U₁.obj One₁)).symm (ιℤ_mod ≫ u₁₀)
    let ηℤ₂ := (adjℤ₂.homEquiv Aℤ (U₂.obj One₂)).symm (ιℤ_mod ≫ u₂₀)
    have hη₁_eq : C₁.map z_to_m ≫ αM₁ = ηℤ₁ := by
      apply (adjℤ₁.homEquiv Aℤ (U₁.obj One₁)).injective
      rw [Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
          ← Category.assoc, hz_ι]
    have hη₂_eq : C₂.map z_to_m ≫ αM₂ = ηℤ₂ := by
      apply (adjℤ₂.homEquiv Aℤ (U₂.obj One₂)).injective
      rw [Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
          ← Category.assoc, hz_ι]
    let e_One_ab : U₁.obj (P_pull_R.obj One₂) ≅ U₁.obj One₁ :=
      { hom := δ.hom.app One₂ ≫ P_pull.map βM₂ ≫ πM₀ ≫ αM₁
        inv := βM₁ ≫ inv πM₀ ≫ P_pull.map αM₂ ≫ δ.inv.app One₂
        hom_inv_id := by
          calc
            (δ.hom.app One₂ ≫ P_pull.map βM₂ ≫ πM₀ ≫ αM₁) ≫
                (βM₁ ≫ inv πM₀ ≫ P_pull.map αM₂ ≫ δ.inv.app One₂)
              = δ.hom.app One₂ ≫ P_pull.map βM₂ ≫ πM₀ ≫ (αM₁ ≫ βM₁) ≫
                  inv πM₀ ≫ P_pull.map αM₂ ≫ δ.inv.app One₂ := by simp only [Category.assoc]
            _ = δ.hom.app One₂ ≫ P_pull.map βM₂ ≫ (πM₀ ≫ inv πM₀) ≫
                  P_pull.map αM₂ ≫ δ.inv.app One₂ := by
                  rw [hαβ₁, Category.id_comp]; simp only [Category.assoc]
            _ = δ.hom.app One₂ ≫ (P_pull.map βM₂ ≫ P_pull.map αM₂) ≫ δ.inv.app One₂ := by
                  rw [IsIso.hom_inv_id, Category.id_comp]; simp only [Category.assoc]
            _ = 𝟙 _ := by
                  rw [← P_pull.map_comp, hβα₂, P_pull.map_id]
                  simp only [Functor.comp_obj, Category.id_comp]
                  exact δ.hom_inv_id_app One₂
        inv_hom_id := by
          calc
            (βM₁ ≫ inv πM₀ ≫ P_pull.map αM₂ ≫ δ.inv.app One₂) ≫
                (δ.hom.app One₂ ≫ P_pull.map βM₂ ≫ πM₀ ≫ αM₁)
              = βM₁ ≫ inv πM₀ ≫ P_pull.map αM₂ ≫ (δ.inv.app One₂ ≫ δ.hom.app One₂) ≫
                  P_pull.map βM₂ ≫ πM₀ ≫ αM₁ := by simp only [Category.assoc]
            _ = βM₁ ≫ inv πM₀ ≫ (P_pull.map αM₂ ≫ P_pull.map βM₂) ≫ πM₀ ≫ αM₁ := by
                  rw [δ.inv_hom_id_app]; simp only [Functor.comp_obj, Category.id_comp, Category.assoc]
            _ = βM₁ ≫ (inv πM₀ ≫ πM₀) ≫ αM₁ := by
                  rw [← P_pull.map_comp, hαβ₂, P_pull.map_id, Category.id_comp]
                  simp only [Category.assoc]
            _ = 𝟙 _ := by rw [IsIso.inv_hom_id, Category.id_comp, hβα₁] }
    let ε_R : P_pull_R.obj One₂ ≅ One₁ := ff_U₁.preimageIso e_One_ab
    have hU₁_ε_hom : U₁.map ε_R.hom ≫ βM₁ = δ.hom.app One₂ ≫ P_pull.map βM₂ ≫ πM₀ := by
      change U₁.map (ff_U₁.preimage e_One_ab.hom) ≫ βM₁ = _
      rw [ff_U₁.map_preimage]
      dsimp only [e_One_ab]
      rw [Category.assoc, Category.assoc, Category.assoc, hαβ₁, Category.comp_id]
    have hU₁_ε_inv : ηℤ₁ ≫ U₁.map ε_R.inv ≫ δ.hom.app One₂ = ιℤ₀ ≫ P_pull.map ηℤ₂ := by
      change ηℤ₁ ≫ U₁.map (ff_U₁.preimage e_One_ab.inv) ≫ δ.hom.app One₂ = _
      rw [ff_U₁.map_preimage]
      dsimp only [e_One_ab]
      have h1 : ηℤ₁ ≫ βM₁ = C₁.map z_to_m := by
        rw [← hη₁_eq, Category.assoc, hαβ₁, Category.comp_id]
      have h2 : C₁.map z_to_m ≫ inv πM₀ = ιℤ₀ ≫ P_pull.map (C₂.map z_to_m) := by
        have h3 : πℤ₀ ≫ C₁.map z_to_m = P_pull.map (C₂.map z_to_m) ≫ πM₀ :=
          (hNatPi z_to_m).symm
        calc
          C₁.map z_to_m ≫ inv πM₀ = (ιℤ₀ ≫ πℤ₀) ≫ C₁.map z_to_m ≫ inv πM₀ := by
            rw [IsIso.inv_hom_id, Category.id_comp]
          _ = ιℤ₀ ≫ (πℤ₀ ≫ C₁.map z_to_m) ≫ inv πM₀ := by simp only [Category.assoc]
          _ = ιℤ₀ ≫ P_pull.map (C₂.map z_to_m) ≫ (πM₀ ≫ inv πM₀) := by
            rw [h3]; simp only [Category.assoc]
          _ = ιℤ₀ ≫ P_pull.map (C₂.map z_to_m) := by rw [IsIso.hom_inv_id, Category.comp_id]
      calc
        ηℤ₁ ≫ (βM₁ ≫ inv πM₀ ≫ P_pull.map αM₂ ≫ δ.inv.app One₂) ≫ δ.hom.app One₂
          = (ηℤ₁ ≫ βM₁) ≫ inv πM₀ ≫ P_pull.map αM₂ ≫ (δ.inv.app One₂ ≫ δ.hom.app One₂) := by
            simp only [Category.assoc]
        _ = (C₁.map z_to_m ≫ inv πM₀) ≫ P_pull.map αM₂ := by
            rw [h1, δ.inv_hom_id_app]; simp only [Functor.comp_obj, Category.comp_id, Category.assoc]
        _ = ιℤ₀ ≫ P_pull.map (C₂.map z_to_m ≫ αM₂) := by
            rw [h2, Category.assoc, ← P_pull.map_comp]
        _ = ιℤ₀ ≫ P_pull.map ηℤ₂ := by rw [hη₂_eq]
    let f_R (k : ℕ) (γ : weilEtaleModuleH W₂ m k) : weilEtaleModuleH W₁ m k :=
      (Abelian.Ext.mk₀ ε_R.inv).comp
        (((P_pull_R.mapExtAddHom One₂ One₂ k) γ).comp (Abelian.Ext.mk₀ ε_R.hom) (Nat.add_zero k))
        (Nat.zero_add k)
    have hf_R_mul : ∀ (α : weilEtaleModuleH W₂ m a) (β : weilEtaleModuleH W₂ m b),
        f_R c (α.comp β hab) = (f_R a α).comp (f_R b β) hab := by
      intro α β
      subst hab
      dsimp only [f_R]
      rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply,
          Abelian.Ext.mapExactFunctor_comp]
      let x_a := Abelian.Ext.mapExactFunctor P_pull_R α
      let x_b := Abelian.Ext.mapExactFunctor P_pull_R β
      change (Abelian.Ext.mk₀ ε_R.inv).comp
          ((x_a.comp x_b rfl).comp (Abelian.Ext.mk₀ ε_R.hom) (Nat.add_zero (a + b)))
          (Nat.zero_add (a + b)) =
        ((Abelian.Ext.mk₀ ε_R.inv).comp (x_a.comp (Abelian.Ext.mk₀ ε_R.hom) (Nat.add_zero a))
          (Nat.zero_add a)).comp
          ((Abelian.Ext.mk₀ ε_R.inv).comp (x_b.comp (Abelian.Ext.mk₀ ε_R.hom) (Nat.add_zero b))
            (Nat.zero_add b)) rfl
      symm
      rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ε_R.inv)
            (x_a.comp (Abelian.Ext.mk₀ ε_R.hom) (Nat.add_zero a)) _
            (Nat.zero_add a) rfl (by omega),
          ← Abelian.Ext.comp_assoc (x_a.comp (Abelian.Ext.mk₀ ε_R.hom) (Nat.add_zero a))
            (Abelian.Ext.mk₀ ε_R.inv) _ (Nat.add_zero a) (Nat.zero_add b) (by omega),
          Abelian.Ext.comp_assoc_of_second_deg_zero x_a (Abelian.Ext.mk₀ ε_R.hom)
            (Abelian.Ext.mk₀ ε_R.inv) (Nat.add_zero a),
          Abelian.Ext.mk₀_comp_mk₀, ε_R.hom_inv_id, Abelian.Ext.comp_mk₀_id,
          ← Abelian.Ext.comp_assoc x_a x_b (Abelian.Ext.mk₀ ε_R.hom)
            rfl (Nat.add_zero b) (by omega)]
    have hθ_fR : ∀ (k : ℕ) (γ : weilEtaleModuleH W₂ m k),
        θ_std W₁ m k (f_R k γ) = p_std k (θ_std W₂ m k γ) := by
      intro k γ
      let θ₁_k : weilEtaleModuleH W₁ m k →+ weilEtaleTorsionH W₁ m k :=
        ((Abelian.Ext.mk₀ βM₁).postcomp (C₁.obj Aℤ) (Nat.add_zero k)).comp
          (((Abelian.Ext.mk₀ ηℤ₁).precomp (U₁.obj One₁) (Nat.zero_add k)).comp
            (U₁.mapExtAddHom One₁ One₁ k))
      let θ₂_k : weilEtaleModuleH W₂ m k →+ weilEtaleTorsionH W₂ m k :=
        ((Abelian.Ext.mk₀ βM₂).postcomp (C₂.obj Aℤ) (Nat.add_zero k)).comp
          (((Abelian.Ext.mk₀ ηℤ₂).precomp (U₂.obj One₂) (Nat.zero_add k)).comp
            (U₂.mapExtAddHom One₂ One₂ k))
      have hθ₁_eq : θ₁_k = θ_std W₁ m k :=
        hθ_uniq W₁ m k θ₁_k ⟨U₁, hU₁_obj, hU₁_map, hAddU₁, hLimU₁, hColimU₁,
          T₁₀, hT₁₀, hT₁₀_left, hT₁₀_hom, u₁₀, hu₁₀, βM₁, hαβ₁, hβα₁, fun _ => rfl⟩
      have hθ₂_eq : θ₂_k = θ_std W₂ m k :=
        hθ_uniq W₂ m k θ₂_k ⟨U₂, hU₂_obj, hU₂_map, hAddU₂, hLimU₂, hColimU₂,
          T₂₀, hT₂₀, hT₂₀_left, hT₂₀_hom, u₂₀, hu₂₀, βM₂, hαβ₂, hβα₂, fun _ => rfl⟩
      rw [← hθ₁_eq, ← hθ₂_eq]
      change ((Abelian.Ext.mk₀ ηℤ₁).comp ((U₁.mapExtAddHom One₁ One₁ k) (f_R k γ))
          (Nat.zero_add k)).comp (Abelian.Ext.mk₀ βM₁) (Nat.add_zero k) =
        ((Abelian.Ext.mk₀ ιℤ₀).comp ((P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) k)
          (((Abelian.Ext.mk₀ ηℤ₂).comp ((U₂.mapExtAddHom One₂ One₂ k) γ) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ βM₂) (Nat.add_zero k))) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ πM₀) (Nat.add_zero k)
      dsimp only [f_R]
      rw [Functor.mapExtAddHom_apply U₁, Functor.mapExtAddHom_apply P_pull_R,
          Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
          Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
          ← Functor.mapExtAddHom_apply P_pull_R, ← Functor.mapExtAddHom_apply U₁,
          ← hExtComp P_pull_R U₁ One₂ One₂ k γ,
          hExtIso (U₂ ⋙ P_pull) (P_pull_R ⋙ U₁) δ.symm One₂ One₂ k γ,
          hExtComp U₂ P_pull One₂ One₂ k γ]
      let w := (P_pull.mapExtAddHom (U₂.obj One₂) (U₂.obj One₂) k) ((U₂.mapExtAddHom One₂ One₂ k) γ)
      have hLHS : ((Abelian.Ext.mk₀ ηℤ₁).comp
          ((Abelian.Ext.mk₀ (U₁.map ε_R.inv)).comp
            ((((Abelian.Ext.mk₀ (δ.hom.app One₂)).comp
              (w.comp (Abelian.Ext.mk₀ (δ.inv.app One₂)) (Nat.add_zero k)) (Nat.zero_add k))).comp
              (Abelian.Ext.mk₀ (U₁.map ε_R.hom)) (Nat.add_zero k)) (Nat.zero_add k))
          (Nat.zero_add k)).comp (Abelian.Ext.mk₀ βM₁) (Nat.add_zero k) =
        (Abelian.Ext.mk₀ (ηℤ₁ ≫ U₁.map ε_R.inv ≫ δ.hom.app One₂)).comp
          (w.comp (Abelian.Ext.mk₀ (δ.inv.app One₂ ≫ U₁.map ε_R.hom ≫ βM₁)) (Nat.add_zero k))
          (Nat.zero_add k) := by
        rw [ext_conj_eq ηℤ₁ (U₁.map ε_R.inv) (U₁.map ε_R.hom) βM₁ _,
            Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (δ.hom.app One₂)) _ _
              (Nat.zero_add k) (Nat.add_zero k) (by omega),
            Abelian.Ext.comp_assoc_of_third_deg_zero w _ _ (Nat.add_zero k),
            Abelian.Ext.mk₀_comp_mk₀,
            ← Abelian.Ext.comp_assoc_of_second_deg_zero
              (Abelian.Ext.mk₀ (ηℤ₁ ≫ U₁.map ε_R.inv)) _ _ (Nat.zero_add k),
            Abelian.Ext.mk₀_comp_mk₀]
        simp only [Category.assoc]
      have hδ_hom_β : δ.inv.app One₂ ≫ U₁.map ε_R.hom ≫ βM₁ = P_pull.map βM₂ ≫ πM₀ := by
        rw [hU₁_ε_hom, δ.inv_hom_id_app_assoc]
      have hRHS : ((Abelian.Ext.mk₀ ιℤ₀).comp ((P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) k)
          (((Abelian.Ext.mk₀ ηℤ₂).comp ((U₂.mapExtAddHom One₂ One₂ k) γ) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ βM₂) (Nat.add_zero k))) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ πM₀) (Nat.add_zero k) =
        (Abelian.Ext.mk₀ (ιℤ₀ ≫ P_pull.map ηℤ₂)).comp
          (w.comp (Abelian.Ext.mk₀ (P_pull.map βM₂ ≫ πM₀)) (Nat.add_zero k))
          (Nat.zero_add k) := by
        rw [Functor.mapExtAddHom_apply P_pull, Abelian.Ext.mapExactFunctor_comp,
            Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
            Abelian.Ext.mapExactFunctor_mk₀, ← Functor.mapExtAddHom_apply P_pull]
        change ((Abelian.Ext.mk₀ ιℤ₀).comp
            (((Abelian.Ext.mk₀ (P_pull.map ηℤ₂)).comp w (Nat.zero_add k)).comp
              (Abelian.Ext.mk₀ (P_pull.map βM₂)) (Nat.add_zero k)) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ πM₀) (Nat.add_zero k) = _
        rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (P_pull.map ηℤ₂)) w
            (Abelian.Ext.mk₀ (P_pull.map βM₂)) (Nat.zero_add k) (Nat.add_zero k) (by omega)]
        exact ext_conj_eq ιℤ₀ (P_pull.map ηℤ₂) (P_pull.map βM₂) πM₀ w
      exact hLHS.trans (by rw [hU₁_ε_inv, hδ_hom_β]; exact hRHS.symm)
    obtain ⟨α, rfl⟩ := (hθ_bij W₂ m a).2 u
    obtain ⟨β, rfl⟩ := (hθ_bij W₂ m b).2 v
    rw [hp_a_eq, hp_b_eq, hp_c_eq,
        (hCup_spec W₂ m a b c hab cup₂).mp hcup₂ α β,
        ← hθ_fR c (α.comp β hab), hf_R_mul α β,
        ← hθ_fR a α, ← hθ_fR b β,
        (hCup_spec W₁ m a b c hab cup₁).mp hcup₁ (f_R a α) (f_R b β)]
  exact ⟨hCup_ex_uniq, hCup_nat, hCup_assoc, hCup_comm_of⟩

theorem weil_lefschetz_module_ext_cup_graded_comm (W : AlgebraicGeometry.Scheme.{u}) (m a b c : ℕ) (hab : a + b = c) (hba : b + a = c) :
    let R := ULift.{u, 0} (ZMod m)
    let One_mod :=
      (CategoryTheory.constantSheaf W.smallEtaleTopology (ModuleCat.{u, u} R)).obj
        (ModuleCat.of R R)
    ∀ (α : CategoryTheory.Abelian.Ext.{u} One_mod One_mod a)
      (β : CategoryTheory.Abelian.Ext.{u} One_mod One_mod b),
      α.comp β hab = ((-1 : ℤ) ^ (a * b)) • (β.comp α hba) :=
by
  
  have part1_abstract_equiv_ext_ring_iso
      {𝒞₁ : Type (u + 1)} [Category.{u + 1, u + 1} 𝒞₁] [Abelian 𝒞₁] [HasExt.{u} 𝒞₁]
      [EnoughInjectives 𝒞₁]
      {𝒞₂ : Type (u + 1)} [Category.{u, u + 1} 𝒞₂] [Abelian 𝒞₂] [HasExt.{u} 𝒞₂]
      (E : 𝒞₁ ≌ 𝒞₂) [E.functor.Additive] [E.inverse.Additive]
      (One_W : 𝒞₁) (One₀ : 𝒞₂) (e_unit : E.functor.obj One_W ≅ One₀) :
      ∃ φ : ∀ k : ℕ, Abelian.Ext.{u} One_W One_W k →+ Abelian.Ext.{u} One₀ One₀ k,
        (∀ k : ℕ, Function.Injective (φ k)) ∧
        (∀ (a₀ b₀ c₀ : ℕ) (hab₀ : a₀ + b₀ = c₀)
          (α₀ : Abelian.Ext.{u} One_W One_W a₀) (β₀ : Abelian.Ext.{u} One_W One_W b₀),
          φ c₀ (α₀.comp β₀ hab₀) = (φ a₀ α₀).comp (φ b₀ β₀) hab₀) := by
    have hExtComp : ∀ (k : ℕ) (A B : 𝒞₁) (x : Abelian.Ext.{u} A B k),
        ((E.functor ⋙ E.inverse).mapExtAddHom A B k) x =
          (E.inverse.mapExtAddHom (E.functor.obj A) (E.functor.obj B) k)
            ((E.functor.mapExtAddHom A B k) x) := by
      intro k A B x
      rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
      induction k generalizing B with
      | zero =>
        have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
        rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
            Abelian.Ext.mapExactFunctor_mk₀]
        rfl
      | succ n ih =>
        let ι : B ⟶ Injective.under B := Injective.ι B
        let S : ShortComplex 𝒞₁ :=
          ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
        have hS : S.ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (n + 1)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x hzero rfl
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
            Abelian.Ext.mapExactFunctor_comp, ih S.X₃ z,
            Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
            Abelian.Ext.mapExactFunctor_extClass]
    have hExtUnit : ∀ (k : ℕ) (A B : 𝒞₁) (x : Abelian.Ext.{u} A B k),
        ((E.functor ⋙ E.inverse).mapExtAddHom A B k) x =
          (Abelian.Ext.mk₀ (E.unitIso.inv.app A)).comp
            (x.comp (Abelian.Ext.mk₀ (E.unitIso.hom.app B)) (Nat.add_zero k))
            (Nat.zero_add k) := by
      intro k A B x
      suffices hnat : (((E.functor ⋙ E.inverse).mapExtAddHom A B k) x).comp
          (Abelian.Ext.mk₀ (E.unitIso.inv.app B)) (Nat.add_zero k) =
          (Abelian.Ext.mk₀ (E.unitIso.inv.app A)).comp x (Nat.zero_add k) by
        have h1 := congrArg
          (fun y => y.comp (Abelian.Ext.mk₀ (E.unitIso.hom.app B)) (Nat.add_zero k)) hnat
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero k),
            Abelian.Ext.mk₀_comp_mk₀, E.unitIso.inv_hom_id_app, Abelian.Ext.comp_mk₀_id,
            Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (E.unitIso.inv.app A)) x _
              (Nat.zero_add k) (Nat.add_zero k) (by omega)] at h1
        exact h1
      rw [Functor.mapExtAddHom_apply]
      induction k generalizing B with
      | zero =>
        have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
        rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.mk₀_comp_mk₀]
        exact congrArg Abelian.Ext.mk₀ (E.unitIso.inv.naturality _)
      | succ n ih =>
        let ι : B ⟶ Injective.under B := Injective.ι B
        let S : ShortComplex 𝒞₁ :=
          ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
        have hS : S.ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (n + 1)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x hzero rfl
        let φ_S : S.map (E.functor ⋙ E.inverse) ⟶ S :=
          { τ₁ := E.unitIso.inv.app S.X₁
            τ₂ := E.unitIso.inv.app S.X₂
            τ₃ := E.unitIso.inv.app S.X₃
            comm₁₂ := (E.unitIso.inv.naturality S.f).symm
            comm₂₃ := (E.unitIso.inv.naturality S.g).symm }
        have hnat_ext :
            (hS.map_of_exact (E.functor ⋙ E.inverse)).extClass.comp
                (Abelian.Ext.mk₀ (E.unitIso.inv.app B)) (Nat.add_zero 1) =
              (Abelian.Ext.mk₀ (E.unitIso.inv.app S.X₃)).comp hS.extClass (Nat.zero_add 1) :=
          ShortComplex.ShortExact.extClass_naturality
            (hS.map_of_exact (E.functor ⋙ E.inverse)) hS φ_S
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
            Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl,
            hnat_ext,
            ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl,
            ih S.X₃ z,
            Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (E.unitIso.inv.app A)) z hS.extClass
              (Nat.zero_add n) rfl (by omega)]
    let φ : ∀ k : ℕ, Abelian.Ext.{u} One_W One_W k →+ Abelian.Ext.{u} One₀ One₀ k := fun k =>
      ((Abelian.Ext.mk₀ e_unit.hom).postcomp One₀ (Nat.add_zero k)).comp
        (((Abelian.Ext.mk₀ e_unit.inv).precomp (E.functor.obj One_W) (Nat.zero_add k)).comp
          (E.functor.mapExtAddHom One_W One_W k))
    have hφ_apply : ∀ (k : ℕ) (x : Abelian.Ext.{u} One_W One_W k),
        φ k x =
          ((Abelian.Ext.mk₀ e_unit.inv).comp
            ((E.functor.mapExtAddHom One_W One_W k) x) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ e_unit.hom) (Nat.add_zero k) :=
      fun _ _ => rfl
    have ext_conj_W : ∀ {X₁ X₂ X₃ Z₁ Z₂ Z₃ : 𝒞₁} {k : ℕ}
        (u₁ : X₁ ⟶ X₂) (u₂ : X₂ ⟶ X₃) (v₁ : Z₁ ⟶ Z₂) (v₂ : Z₂ ⟶ Z₃)
        (y : Abelian.Ext.{u} X₃ Z₁ k),
        ((Abelian.Ext.mk₀ u₁).comp
          ((Abelian.Ext.mk₀ u₂).comp (y.comp (Abelian.Ext.mk₀ v₁) (Nat.add_zero k))
            (Nat.zero_add k)) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ v₂) (Nat.add_zero k) =
        (Abelian.Ext.mk₀ (u₁ ≫ u₂)).comp
          (y.comp (Abelian.Ext.mk₀ (v₁ ≫ v₂)) (Nat.add_zero k)) (Nat.zero_add k) := by
      intro X₁ X₂ X₃ Z₁ Z₂ Z₃ k u₁ u₂ v₁ v₂ y
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add k),
          Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (u₁ ≫ u₂)) _ _
            (Nat.zero_add k) (Nat.add_zero k) (by omega),
          Abelian.Ext.comp_assoc_of_third_deg_zero y _ _ (Nat.add_zero k),
          Abelian.Ext.mk₀_comp_mk₀]
    refine ⟨φ, ?_, ?_⟩
    · intro k x y hxy
      let e'_hom : E.inverse.obj One₀ ⟶ One_W :=
        E.inverse.map e_unit.inv ≫ E.unitIso.inv.app One_W
      let e'_inv : One_W ⟶ E.inverse.obj One₀ :=
        E.unitIso.hom.app One_W ≫ E.inverse.map e_unit.hom
      have h1 : E.inverse.map e_unit.hom ≫ E.inverse.map e_unit.inv =
          𝟙 ((E.functor ⋙ E.inverse).obj One_W) := by
        rw [← E.inverse.map_comp, e_unit.hom_inv_id, E.inverse.map_id]; rfl
      have hu_hom_inv : (E.unitIso.hom.app One_W : One_W ⟶ (E.functor ⋙ E.inverse).obj One_W) ≫
          E.unitIso.inv.app One_W = 𝟙 One_W := E.unitIso.hom_inv_id_app One_W
      have he'_id : e'_inv ≫ e'_hom = 𝟙 One_W := by
        dsimp only [e'_inv, e'_hom]
        calc
          (E.unitIso.hom.app One_W ≫ E.inverse.map e_unit.hom) ≫
              (E.inverse.map e_unit.inv ≫ E.unitIso.inv.app One_W) =
            E.unitIso.hom.app One_W ≫ (E.inverse.map e_unit.hom ≫ E.inverse.map e_unit.inv) ≫
              E.unitIso.inv.app One_W := by simp only [Category.assoc]
          _ = 𝟙 One_W := by rw [h1, Category.id_comp, hu_hom_inv]
      have hleft : ∀ z : Abelian.Ext.{u} One_W One_W k,
          ((Abelian.Ext.mk₀ e'_inv).comp
            ((E.inverse.mapExtAddHom One₀ One₀ k) (φ k z)) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ e'_hom) (Nat.add_zero k) = z := by
        intro z
        have hmap_φ : (E.inverse.mapExtAddHom One₀ One₀ k) (φ k z) =
            (Abelian.Ext.mk₀ e'_hom).comp
              (z.comp (Abelian.Ext.mk₀ e'_inv) (Nat.add_zero k)) (Nat.zero_add k) := by
          rw [hφ_apply k z, Functor.mapExtAddHom_apply (E.inverse) One₀ One₀ k,
              Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
              Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
              ← Functor.mapExtAddHom_apply (E.inverse),
              ← hExtComp k One_W One_W z, hExtUnit k One_W One_W z,
              ext_conj_W (E.inverse.map e_unit.inv) (E.unitIso.inv.app One_W)
                (E.unitIso.hom.app One_W) (E.inverse.map e_unit.hom) z]
        rw [hmap_φ, ext_conj_W e'_inv e'_hom e'_inv e'_hom z, he'_id,
            Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_mk₀_id]
      rw [← hleft x, ← hleft y, hxy]
    · intro a₀ b₀ c₀ hab₀ α₀ β₀
      have hφ_conj : ∀ (k : ℕ) (z : Abelian.Ext.{u} One_W One_W k),
          φ k z =
            (Abelian.Ext.mk₀ e_unit.inv).comp
              (((E.functor.mapExtAddHom One_W One_W k) z).comp
                (Abelian.Ext.mk₀ e_unit.hom) (Nat.add_zero k))
              (Nat.zero_add k) := fun k z => by
        rw [hφ_apply k z, Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e_unit.inv) _ _
          (Nat.zero_add k) (Nat.add_zero k) (by omega)]
      rw [hφ_conj c₀ (α₀.comp β₀ hab₀), hφ_conj a₀ α₀, hφ_conj b₀ β₀,
          Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_comp,
          ← Functor.mapExtAddHom_apply, ← Functor.mapExtAddHom_apply,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e_unit.inv) _ _ (Nat.zero_add a₀) hab₀ (by omega),
          Abelian.Ext.comp_assoc ((E.functor.mapExtAddHom One_W One_W a₀) α₀)
            (Abelian.Ext.mk₀ e_unit.hom) _ (Nat.add_zero a₀) (Nat.zero_add b₀) (by omega),
          ← Abelian.Ext.comp_assoc_of_second_deg_zero
            (Abelian.Ext.mk₀ e_unit.hom) (Abelian.Ext.mk₀ e_unit.inv) _ (Nat.zero_add b₀),
          Abelian.Ext.mk₀_comp_mk₀, e_unit.hom_inv_id, Abelian.Ext.mk₀_id_comp,
          ← Abelian.Ext.comp_assoc
            ((E.functor.mapExtAddHom One_W One_W a₀) α₀)
            ((E.functor.mapExtAddHom One_W One_W b₀) β₀)
            (Abelian.Ext.mk₀ e_unit.hom) hab₀ (Nat.add_zero b₀) (by omega)]

  
  have part1_small_etale_ext_ring_iso
      (W₀ : AlgebraicGeometry.Scheme.{u}) (R₀ : Type u) [CommRing R₀] :
      ∃ (C₀ : Type u) (instC₀ : CategoryTheory.SmallCategory C₀)
        (J₀ : @CategoryTheory.GrothendieckTopology C₀ instC₀),
        letI := instC₀
        let One_W :=
          (CategoryTheory.constantSheaf W₀.smallEtaleTopology (ModuleCat.{u, u} R₀)).obj
            (ModuleCat.of R₀ R₀)
        let One₀ :=
          (CategoryTheory.constantSheaf J₀ (ModuleCat.{u, u} R₀)).obj
            (ModuleCat.of R₀ R₀)
        ∃ φ : ∀ k : ℕ,
            CategoryTheory.Abelian.Ext.{u} One_W One_W k →+
              CategoryTheory.Abelian.Ext.{u} One₀ One₀ k,
          (∀ k : ℕ, Function.Injective (φ k)) ∧
          (∀ (a₀ b₀ c₀ : ℕ) (hab₀ : a₀ + b₀ = c₀)
            (α₀ : CategoryTheory.Abelian.Ext.{u} One_W One_W a₀)
            (β₀ : CategoryTheory.Abelian.Ext.{u} One_W One_W b₀),
            φ c₀ (α₀.comp β₀ hab₀) = (φ a₀ α₀).comp (φ b₀ β₀) hab₀) := by
    let 𝒜 := ModuleCat.{u, u} R₀
    let M₀ : 𝒜 := ModuleCat.of R₀ R₀
    let J_W := W₀.smallEtaleTopology
    let S₀ : Type u := CategoryTheory.SmallModel.{u} W₀.AffineEtale
    let e_sm : W₀.AffineEtale ≌ S₀ := CategoryTheory.equivSmallModel.{u} W₀.AffineEtale
    let ι_aff : W₀.AffineEtale ⥤ W₀.Etale := AlgebraicGeometry.Scheme.AffineEtale.Spec W₀
    haveI : CategoryTheory.MorphismProperty.ContainsIdentities (@AlgebraicGeometry.Etale) :=
      ⟨fun _ => inferInstance⟩
    let T_W : W₀.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 W₀)
        (CategoryTheory.MorphismProperty.id_mem _ W₀)
    let hT_W : Limits.IsTerminal T_W :=
      CategoryTheory.MorphismProperty.Over.mkIdTerminal (@AlgebraicGeometry.Etale) W₀
    let f₀ : S₀ ⊕ PUnit.{1} → W₀.Etale :=
      Sum.elim (fun s => ι_aff.obj (e_sm.inverse.obj s)) (fun _ => T_W)
    let C₀ : Type u := CategoryTheory.InducedCategory W₀.Etale f₀
    let instC₀ : CategoryTheory.SmallCategory C₀ := inferInstance
    let G : C₀ ⥤ W₀.Etale := CategoryTheory.inducedFunctor f₀
    let ff_G : G.FullyFaithful := CategoryTheory.fullyFaithfulInducedFunctor f₀
    haveI : G.Full := ff_G.full
    haveI : G.Faithful := ff_G.faithful
    haveI : ι_aff.IsCoverDense J_W :=
      CategoryTheory.Functor.IsDenseSubsite.isCoverDense
        (AlgebraicGeometry.Scheme.AffineEtale.topology W₀) J_W ι_aff
    haveI : G.IsCoverDense J_W := by
      refine CategoryTheory.Functor.IsCoverDense.mk (fun U => ?_)
      refine J_W.superset_covering ?_ (CategoryTheory.Functor.IsCoverDense.is_cover (G := ι_aff) U)
      intro V u ⟨⟨A, l, m_arr, hfac⟩⟩
      let s : C₀ := Sum.inl (e_sm.functor.obj A)
      let iso_A : ι_aff.obj A ≅ G.obj s := ι_aff.mapIso (e_sm.unitIso.app A)
      exact ⟨⟨s, l ≫ iso_A.hom, iso_A.inv ≫ m_arr, by simp [hfac]⟩⟩
    let J₀ : CategoryTheory.GrothendieckTopology C₀ := G.inducedTopology J_W
    let F_res : Sheaf J_W 𝒜 ⥤ Sheaf J₀ 𝒜 := G.sheafPushforwardContinuous 𝒜 J₀ J_W
    let E : Sheaf J_W 𝒜 ≌ Sheaf J₀ 𝒜 := F_res.asEquivalence
    have sheaf_hom_ext₀ : ∀ {ℱ₁ ℱ₂ : Sheaf J₀ 𝒜} {u v : ℱ₁ ⟶ ℱ₂}, u.hom = v.hom → u = v := by
      rintro _ _ ⟨u⟩ ⟨v⟩ rfl; rfl
    haveI : E.functor.Additive :=
      { map_add := fun {ℱ₁ ℱ₂ f g} => sheaf_hom_ext₀ (NatTrans.ext (funext fun _ => rfl)) }
    haveI : E.inverse.Additive := inferInstance
    let T₀ : C₀ := Sum.inr PUnit.unit
    let toT₀ : ∀ X : C₀, X ⟶ T₀ :=
      fun X => ff_G.preimage (show G.obj X ⟶ G.obj T₀ from hT_W.from (G.obj X))
    have hT₀ : Limits.IsTerminal T₀ :=
      Limits.IsTerminal.ofUniqueHom toT₀
        (fun X m_hom => ff_G.map_injective
          ((hT_W.hom_ext (G.map m_hom) (hT_W.from (G.obj X))).trans
            (ff_G.map_preimage (show G.obj X ⟶ G.obj T₀ from hT_W.from (G.obj X))).symm))
    let One_W : Sheaf J_W 𝒜 := (CategoryTheory.constantSheaf J_W 𝒜).obj M₀
    let One₀ : Sheaf J₀ 𝒜 := (CategoryTheory.constantSheaf J₀ 𝒜).obj M₀
    let hGT₀ : Limits.IsTerminal (G.obj T₀) := hT_W
    let adj_W := CategoryTheory.constantSheafAdj J_W 𝒜 hGT₀
    let adj₀ := CategoryTheory.constantSheafAdj J₀ 𝒜 hT₀
    let sec₀ := (CategoryTheory.sheafSections J₀ 𝒜).obj (Opposite.op T₀)
    let c_hom : ∀ 𝒢 : Sheaf J₀ 𝒜, E.functor.obj (E.inverse.obj 𝒢) ⟶ 𝒢 :=
      fun 𝒢 => E.counitIso.hom.app 𝒢
    let c_inv : ∀ 𝒢 : Sheaf J₀ 𝒜, 𝒢 ⟶ E.functor.obj (E.inverse.obj 𝒢) :=
      fun 𝒢 => E.counitIso.inv.app 𝒢
    let midEq : ∀ 𝒢 : Sheaf J₀ 𝒜,
        (M₀ ⟶ ((CategoryTheory.sheafSections J_W 𝒜).obj (Opposite.op (G.obj T₀))).obj
          (E.inverse.obj 𝒢)) ≃ (M₀ ⟶ sec₀.obj 𝒢) := fun 𝒢 =>
      { toFun := fun h => h ≫ sec₀.map (c_hom 𝒢)
        invFun := fun h => h ≫ sec₀.map (c_inv 𝒢)
        left_inv := fun h =>
          (Category.assoc h (sec₀.map (c_hom 𝒢)) (sec₀.map (c_inv 𝒢))).trans
            ((congrArg (h ≫ ·)
              (((sec₀.map_comp (c_hom 𝒢) (c_inv 𝒢)).symm.trans
                (congrArg sec₀.map (show c_hom 𝒢 ≫ c_inv 𝒢 = 𝟙 (E.functor.obj (E.inverse.obj 𝒢)) from
                  E.counitIso.hom_inv_id_app 𝒢))).trans
                (sec₀.map_id (E.functor.obj (E.inverse.obj 𝒢))))).trans
              (Category.comp_id h))
        right_inv := fun h =>
          (Category.assoc h (sec₀.map (c_inv 𝒢)) (sec₀.map (c_hom 𝒢))).trans
            ((congrArg (h ≫ ·)
              (((sec₀.map_comp (c_inv 𝒢) (c_hom 𝒢)).symm.trans
                (congrArg sec₀.map (show c_inv 𝒢 ≫ c_hom 𝒢 = 𝟙 𝒢 from
                  E.counitIso.inv_hom_id_app 𝒢))).trans
                (sec₀.map_id 𝒢))).trans
              (Category.comp_id h)) }
    let homEq : ∀ 𝒢 : Sheaf J₀ 𝒜, (E.functor.obj One_W ⟶ 𝒢) ≃ (One₀ ⟶ 𝒢) := fun 𝒢 =>
      (E.toAdjunction.homEquiv One_W 𝒢).trans
        ((adj_W.homEquiv M₀ (E.inverse.obj 𝒢)).trans
          ((midEq 𝒢).trans (adj₀.homEquiv M₀ 𝒢).symm))
    have hhomEq_nat : ∀ {𝒢₁ 𝒢₂ : Sheaf J₀ 𝒜} (g : E.functor.obj One_W ⟶ 𝒢₁) (f : 𝒢₁ ⟶ 𝒢₂),
        homEq 𝒢₂ (g ≫ f) = homEq 𝒢₁ g ≫ f := by
      intro 𝒢₁ 𝒢₂ g f
      let w : M₀ ⟶ sec₀.obj (E.functor.obj (E.inverse.obj 𝒢₁)) :=
        adj_W.homEquiv M₀ (E.inverse.obj 𝒢₁) (E.toAdjunction.homEquiv One_W 𝒢₁ g)
      have h1 : E.toAdjunction.homEquiv One_W 𝒢₂ (g ≫ f) =
          E.toAdjunction.homEquiv One_W 𝒢₁ g ≫ E.inverse.map f :=
        Adjunction.homEquiv_naturality_right E.toAdjunction g f
      have h2 : adj_W.homEquiv M₀ (E.inverse.obj 𝒢₂)
            (E.toAdjunction.homEquiv One_W 𝒢₁ g ≫ E.inverse.map f) =
          w ≫ sec₀.map (E.functor.map (E.inverse.map f)) :=
        Adjunction.homEquiv_naturality_right adj_W _ (E.inverse.map f)
      have h_counit_nat : E.functor.map (E.inverse.map f) ≫ c_hom 𝒢₂ = c_hom 𝒢₁ ≫ f :=
        E.counitIso.hom.naturality f
      have h3 : midEq 𝒢₂ (w ≫ sec₀.map (E.functor.map (E.inverse.map f))) =
          midEq 𝒢₁ w ≫ sec₀.map f :=
        (Category.assoc w (sec₀.map (E.functor.map (E.inverse.map f))) (sec₀.map (c_hom 𝒢₂))).trans
          ((congrArg (w ≫ ·)
            (((sec₀.map_comp (E.functor.map (E.inverse.map f)) (c_hom 𝒢₂)).symm.trans
              (congrArg sec₀.map h_counit_nat)).trans
              (sec₀.map_comp (c_hom 𝒢₁) f))).trans
            (Category.assoc w (sec₀.map (c_hom 𝒢₁)) (sec₀.map f)).symm)
      have h4 : (adj₀.homEquiv M₀ 𝒢₂).symm (midEq 𝒢₁ w ≫ sec₀.map f) =
          (adj₀.homEquiv M₀ 𝒢₁).symm (midEq 𝒢₁ w) ≫ f :=
        Adjunction.homEquiv_naturality_right_symm adj₀ (midEq 𝒢₁ w) f
      change (adj₀.homEquiv M₀ 𝒢₂).symm
          (midEq 𝒢₂ (adj_W.homEquiv M₀ (E.inverse.obj 𝒢₂) (E.toAdjunction.homEquiv One_W 𝒢₂ (g ≫ f)))) =
        (adj₀.homEquiv M₀ 𝒢₁).symm (midEq 𝒢₁ w) ≫ f
      exact (congrArg (fun x => (adj₀.homEquiv M₀ 𝒢₂).symm
        (midEq 𝒢₂ (adj_W.homEquiv M₀ (E.inverse.obj 𝒢₂) x))) h1).trans
        ((congrArg (fun x => (adj₀.homEquiv M₀ 𝒢₂).symm (midEq 𝒢₂ x)) h2).trans
          ((congrArg (adj₀.homEquiv M₀ 𝒢₂).symm h3).trans h4))
    let u_hom : E.functor.obj One_W ⟶ One₀ := (homEq One₀).symm (𝟙 One₀)
    let u_inv : One₀ ⟶ E.functor.obj One_W :=
      homEq (E.functor.obj One_W) (𝟙 (E.functor.obj One_W))
    have hu_inv_hom : u_inv ≫ u_hom = 𝟙 One₀ := by
      have h1 := (hhomEq_nat (𝟙 (E.functor.obj One_W)) u_hom).symm
      rw [Category.id_comp] at h1
      exact h1.trans ((homEq One₀).apply_symm_apply (𝟙 One₀))
    have hu_hom_inv : u_hom ≫ u_inv = 𝟙 (E.functor.obj One_W) := by
      apply (homEq (E.functor.obj One_W)).injective
      rw [hhomEq_nat u_hom u_inv]
      have h1 : homEq One₀ u_hom = 𝟙 One₀ := (homEq One₀).apply_symm_apply (𝟙 One₀)
      rw [h1, Category.id_comp]
    let e_unit : E.functor.obj One_W ≅ One₀ :=
      { hom := u_hom, inv := u_inv, hom_inv_id := hu_hom_inv, inv_hom_id := hu_inv_hom }
    exact ⟨C₀, instC₀, J₀, part1_abstract_equiv_ext_ring_iso E One_W One₀ e_unit⟩

  
  have part2_small_sheaf_tensor_exact_resolution
      (C₀ : Type u) [CategoryTheory.SmallCategory C₀]
      (J₀ : CategoryTheory.GrothendieckTopology C₀)
      (R₀ : Type u) [CommRing R₀] :
      letI : (CategoryTheory.GrothendieckTopology.W J₀ (A := ModuleCat.{u, u} R₀)).IsMonoidal :=
        CategoryTheory.GrothendieckTopology.W.monoidal
      letI : CategoryTheory.MonoidalCategory (CategoryTheory.Sheaf J₀ (ModuleCat.{u, u} R₀)) :=
        CategoryTheory.Sheaf.monoidalCategory J₀ (ModuleCat.{u, u} R₀)
      let ℳ₀ := CategoryTheory.Sheaf J₀ (ModuleCat.{u, u} R₀)
      let One₀ :=
        (CategoryTheory.constantSheaf J₀ (ModuleCat.{u, u} R₀)).obj (ModuleCat.of R₀ R₀)
      Nonempty (MonoidalCategoryStruct.tensorUnit ℳ₀ ≅ One₀) ∧
      ∃ P : ℳ₀ → Prop,
        P (MonoidalCategoryStruct.tensorUnit ℳ₀) ∧
        (∀ X : ℳ₀, P X →
          (MonoidalCategory.tensorLeft X).Additive ∧
          Nonempty (Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft X)) ∧
          Nonempty (Limits.PreservesFiniteColimits (MonoidalCategory.tensorLeft X)) ∧
          (MonoidalCategory.tensorRight X).Additive ∧
          Nonempty (Limits.PreservesFiniteLimits (MonoidalCategory.tensorRight X)) ∧
          Nonempty (Limits.PreservesFiniteColimits (MonoidalCategory.tensorRight X))) ∧
        (∀ E : ℳ₀, ∃ (Q : ℳ₀) (e₀ : Q ⟶ E), P Q ∧ Epi e₀) ∧
        (∀ S : ShortComplex ℳ₀, S.ShortExact → P S.X₂ → P S.X₃ → P S.X₁) := by
    let 𝒜 := ModuleCat.{u, u} R₀
    let PSh := C₀ᵒᵖ ⥤ 𝒜
    letI : (CategoryTheory.GrothendieckTopology.W J₀ (A := 𝒜)).IsMonoidal :=
      CategoryTheory.GrothendieckTopology.W.monoidal
    let ℳ₀ := CategoryTheory.Sheaf J₀ 𝒜
    letI : MonoidalCategory ℳ₀ := CategoryTheory.Sheaf.monoidalCategory J₀ 𝒜
    letI : SymmetricCategory ℳ₀ := CategoryTheory.Sheaf.symmetricCategory J₀ 𝒜
    let L : PSh ⥤ ℳ₀ := CategoryTheory.presheafToSheaf J₀ 𝒜
    let U : ℳ₀ ⥤ PSh := CategoryTheory.sheafToPresheaf J₀ 𝒜
    let adj : L ⊣ U := CategoryTheory.sheafificationAdjunction J₀ 𝒜
    letI : L.Monoidal := inferInstanceAs ((CategoryTheory.presheafToSheaf J₀ 𝒜).Monoidal)
    haveI : IsIso adj.counit :=
      inferInstanceAs (IsIso (CategoryTheory.sheafificationAdjunction J₀ 𝒜).counit)
    let ε : U ⋙ L ≅ 𝟭 ℳ₀ := asIso adj.counit
    let One₀ : ℳ₀ := (CategoryTheory.constantSheaf J₀ 𝒜).obj (ModuleCat.of R₀ R₀)
    have hUnitIso : Nonempty (MonoidalCategoryStruct.tensorUnit ℳ₀ ≅ One₀) :=
      ⟨Functor.Monoidal.εIso L⟩
    haveI : Limits.PreservesLimits U := adj.rightAdjoint_preservesLimits
    haveI : U.Additive := Functor.additive_of_preserves_binary_products U
    haveI : L.Additive := Functor.additive_of_preserves_binary_products L
    have hwL : ∀ (Z A B C : ℳ₀) (u : A ⟶ B) (v : B ⟶ C),
        MonoidalCategoryStruct.whiskerLeft Z u ≫ MonoidalCategoryStruct.whiskerLeft Z v =
          MonoidalCategoryStruct.whiskerLeft Z (u ≫ v) :=
      fun Z _ _ _ u v => ((MonoidalCategory.tensorLeft Z).map_comp u v).symm
    have hwR : ∀ (A B C Z : ℳ₀) (u : A ⟶ B) (v : B ⟶ C),
        MonoidalCategoryStruct.whiskerRight u Z ≫ MonoidalCategoryStruct.whiskerRight v Z =
          MonoidalCategoryStruct.whiskerRight (u ≫ v) Z :=
      fun _ _ _ Z u v => ((MonoidalCategory.tensorRight Z).map_comp u v).symm
    have hPSh_add : ∀ P : PSh, (MonoidalCategory.tensorLeft P).Additive := fun P =>
      { map_add := fun {G₁ G₂ f g} => by
          ext V : 2
          change MonoidalCategoryStruct.whiskerLeft (P.obj V) ((f + g).app V) =
            MonoidalCategoryStruct.whiskerLeft (P.obj V) (f.app V) +
              MonoidalCategoryStruct.whiskerLeft (P.obj V) (g.app V)
          rw [NatTrans.app_add, MonoidalPreadditive.whiskerLeft_add] }
    have hPSh_colim : ∀ P : PSh, Limits.PreservesFiniteColimits (MonoidalCategory.tensorLeft P) := by
      intro P
      refine ⟨fun J _ _ => ?_⟩
      haveI : ∀ V : C₀ᵒᵖ,
          Limits.PreservesColimitsOfShape J
            (MonoidalCategory.tensorLeft P ⋙ (evaluation C₀ᵒᵖ 𝒜).obj V) := by
        intro V
        let evV : PSh ⥤ 𝒜 := (evaluation C₀ᵒᵖ 𝒜).obj V
        haveI : Limits.PreservesColimits (MonoidalCategory.tensorLeft (P.obj V)) :=
          (ihom.adjunction (P.obj V)).leftAdjoint_preservesColimits
        let e_ev : (evV ⋙ MonoidalCategory.tensorLeft (P.obj V)) ≅
            (MonoidalCategory.tensorLeft P ⋙ evV) := Iso.refl _
        exact Limits.preservesColimitsOfShape_of_natIso e_ev
      exact Limits.preservesColimitsOfShape_of_evaluation (MonoidalCategory.tensorLeft P) J
        (fun V => inferInstance)
    let τ_X : ∀ X : ℳ₀,
        MonoidalCategory.tensorLeft X ≅ U ⋙ MonoidalCategory.tensorLeft (U.obj X) ⋙ L := fun X =>
      NatIso.ofComponents
        (fun Y =>
          (MonoidalCategory.whiskerRightIso (ε.symm.app X) Y) ≪≫
            (MonoidalCategory.whiskerLeftIso (L.obj (U.obj X)) (ε.symm.app Y)) ≪≫
            Functor.Monoidal.μIso L (U.obj X) (U.obj Y))
        (fun {Y₁ Y₂} f => by
          let eX : X ⟶ L.obj (U.obj X) := ε.inv.app X
          change MonoidalCategoryStruct.whiskerLeft X f ≫
              (MonoidalCategoryStruct.whiskerRight eX Y₂ ≫
                MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (ε.inv.app Y₂) ≫
                Functor.LaxMonoidal.μ L (U.obj X) (U.obj Y₂)) =
            (MonoidalCategoryStruct.whiskerRight eX Y₁ ≫
              MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (ε.inv.app Y₁) ≫
              Functor.LaxMonoidal.μ L (U.obj X) (U.obj Y₁)) ≫
              L.map (MonoidalCategoryStruct.whiskerLeft (U.obj X) (U.map f))
          calc
            MonoidalCategoryStruct.whiskerLeft X f ≫
                (MonoidalCategoryStruct.whiskerRight eX Y₂ ≫
                  MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (ε.inv.app Y₂) ≫
                  Functor.LaxMonoidal.μ L (U.obj X) (U.obj Y₂)) =
              (MonoidalCategoryStruct.whiskerLeft X f ≫
                MonoidalCategoryStruct.whiskerRight eX Y₂) ≫
                MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (ε.inv.app Y₂) ≫
                Functor.LaxMonoidal.μ L (U.obj X) (U.obj Y₂) := by simp only [Category.assoc]
            _ = MonoidalCategoryStruct.whiskerRight eX Y₁ ≫
                (MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) f ≫
                  MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (ε.inv.app Y₂)) ≫
                Functor.LaxMonoidal.μ L (U.obj X) (U.obj Y₂) := by
                rw [MonoidalCategory.whisker_exchange eX f]
                simp only [Category.assoc]
            _ = MonoidalCategoryStruct.whiskerRight eX Y₁ ≫
                MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (ε.inv.app Y₁) ≫
                (MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (L.map (U.map f)) ≫
                  Functor.LaxMonoidal.μ L (U.obj X) (U.obj Y₂)) := by
                have hf_nat : f ≫ ε.inv.app Y₂ = ε.inv.app Y₁ ≫ L.map (U.map f) :=
                  ε.inv.naturality f
                rw [hwL, hf_nat, ← hwL]
                simp only [Category.assoc]
            _ = (MonoidalCategoryStruct.whiskerRight eX Y₁ ≫
                  MonoidalCategoryStruct.whiskerLeft (L.obj (U.obj X)) (ε.inv.app Y₁) ≫
                  Functor.LaxMonoidal.μ L (U.obj X) (U.obj Y₁)) ≫
                L.map (MonoidalCategoryStruct.whiskerLeft (U.obj X) (U.map f)) := by
                rw [Functor.LaxMonoidal.μ_natural_right L (U.obj X) (U.map f)]
                simp only [Category.assoc])
    let β_nat : ∀ X : ℳ₀, MonoidalCategory.tensorRight X ≅ MonoidalCategory.tensorLeft X := fun X =>
      NatIso.ofComponents (fun Y => BraidedCategory.braiding Y X)
        (fun {Y₁ Y₂} f => BraidedCategory.braiding_naturality_left f X)
    have hSheaf_add_L : ∀ X : ℳ₀, (MonoidalCategory.tensorLeft X).Additive := by
      intro X
      letI : (MonoidalCategory.tensorLeft (U.obj X)).Additive := hPSh_add (U.obj X)
      exact Functor.additive_of_iso (τ_X X).symm
    have hSheaf_add_R : ∀ X : ℳ₀, (MonoidalCategory.tensorRight X).Additive := by
      intro X
      letI := hSheaf_add_L X
      exact Functor.additive_of_iso (β_nat X).symm
    have hwL_zero : ∀ (Z A B : ℳ₀), MonoidalCategoryStruct.whiskerLeft Z (0 : A ⟶ B) = 0 :=
      fun Z A B => by letI := hSheaf_add_L Z; exact (MonoidalCategory.tensorLeft Z).map_zero A B
    have hwR_zero : ∀ (A B Z : ℳ₀), MonoidalCategoryStruct.whiskerRight (0 : A ⟶ B) Z = 0 :=
      fun A B Z => by letI := hSheaf_add_R Z; exact (MonoidalCategory.tensorRight Z).map_zero A B
    have hSheaf_colim_L : ∀ X : ℳ₀, Limits.PreservesFiniteColimits (MonoidalCategory.tensorLeft X) := by
      intro X
      letI : Limits.PreservesFiniteColimits (MonoidalCategory.tensorLeft (U.obj X)) :=
        hPSh_colim (U.obj X)
      let H : PSh ⥤ ℳ₀ := MonoidalCategory.tensorLeft (U.obj X) ⋙ L
      haveI : Limits.PreservesFiniteColimits (U ⋙ H) := by
        refine ⟨fun J _ _ => ⟨fun {K} => ⟨fun {c_cocone} hc => ⟨?_⟩⟩⟩⟩
        let c₀ : Limits.Cocone (K ⋙ U) := Limits.colimit.cocone (K ⋙ U)
        let hc₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit (K ⋙ U)
        let q : c₀.pt ⟶ U.obj c_cocone.pt := hc₀.desc (U.mapCocone c_cocone)
        have hq_ι : ∀ j : J, c₀.ι.app j ≫ q = U.map (c_cocone.ι.app j) :=
          fun j => hc₀.fac (U.mapCocone c_cocone) j
        let hc₀_L : Limits.IsColimit (L.mapCocone c₀) := Limits.isColimitOfPreserves L hc₀
        let c_L : Limits.Cocone K :=
          { pt := L.obj c₀.pt
            ι :=
              { app := fun j => ε.inv.app (K.obj j) ≫ L.map (c₀.ι.app j)
                naturality := fun {j₁ j₂} u => by
                  dsimp
                  have hnat : K.map u ≫ ε.inv.app (K.obj j₂) =
                      ε.inv.app (K.obj j₁) ≫ L.map (U.map (K.map u)) := ε.inv.naturality (K.map u)
                  have hc₀_w : U.map (K.map u) ≫ c₀.ι.app j₂ = c₀.ι.app j₁ := c₀.w u
                  rw [Category.comp_id, ← Category.assoc, hnat, Category.assoc,
                      ← L.map_comp, hc₀_w] } }
        let r : c_cocone.pt ⟶ L.obj c₀.pt := hc.desc c_L
        have hr_ι : ∀ j : J, c_cocone.ι.app j ≫ r = ε.inv.app (K.obj j) ≫ L.map (c₀.ι.app j) :=
          fun j => hc.fac c_L j
        let q_inv : L.obj (U.obj c_cocone.pt) ⟶ L.obj c₀.pt := ε.hom.app c_cocone.pt ≫ r
        have h_left : L.map q ≫ q_inv = 𝟙 (L.obj c₀.pt) := by
          apply hc₀_L.hom_ext
          intro j
          dsimp [q_inv]
          rw [Category.comp_id, ← Category.assoc, ← Category.assoc, ← L.map_comp, hq_ι j]
          have hnat : L.map (U.map (c_cocone.ι.app j)) ≫ ε.hom.app c_cocone.pt =
              ε.hom.app (K.obj j) ≫ c_cocone.ι.app j := ε.hom.naturality (c_cocone.ι.app j)
          have hid1 : (ε.hom.app (K.obj j) : L.obj (U.obj (K.obj j)) ⟶ K.obj j) ≫
              ε.inv.app (K.obj j) = 𝟙 (L.obj (U.obj (K.obj j))) := ε.hom_inv_id_app (K.obj j)
          rw [Category.assoc, ← Category.assoc (L.map (U.map (c_cocone.ι.app j))), hnat,
              Category.assoc, hr_ι j, ← Category.assoc, hid1, Category.id_comp]
        have h_right : q_inv ≫ L.map q = 𝟙 (L.obj (U.obj c_cocone.pt)) := by
          have h_id : r ≫ L.map q ≫ ε.hom.app c_cocone.pt = 𝟙 c_cocone.pt := by
            apply hc.hom_ext
            intro j
            have hnat : L.map (U.map (c_cocone.ι.app j)) ≫ ε.hom.app c_cocone.pt =
                ε.hom.app (K.obj j) ≫ c_cocone.ι.app j := ε.hom.naturality (c_cocone.ι.app j)
            have hid2 : (ε.inv.app (K.obj j) : K.obj j ⟶ L.obj (U.obj (K.obj j))) ≫
                ε.hom.app (K.obj j) = 𝟙 (K.obj j) := ε.inv_hom_id_app (K.obj j)
            rw [Category.comp_id, ← Category.assoc, hr_ι j, Category.assoc,
                ← Category.assoc (L.map (c₀.ι.app j)), ← L.map_comp, hq_ι j,
                hnat, ← Category.assoc, hid2, Category.id_comp]
          have hid_c : (ε.hom.app c_cocone.pt : L.obj (U.obj c_cocone.pt) ⟶ c_cocone.pt) ≫
              ε.inv.app c_cocone.pt = 𝟙 (L.obj (U.obj c_cocone.pt)) :=
            ε.hom_inv_id_app c_cocone.pt
          calc
            q_inv ≫ L.map q =
                (q_inv ≫ L.map q) ≫ (ε.hom.app c_cocone.pt ≫ ε.inv.app c_cocone.pt) := by
              rw [hid_c, Category.comp_id]
            _ = ε.hom.app c_cocone.pt ≫
                (r ≫ L.map q ≫ ε.hom.app c_cocone.pt) ≫ ε.inv.app c_cocone.pt := by
              dsimp [q_inv]; simp only [Category.assoc]
            _ = 𝟙 (L.obj (U.obj c_cocone.pt)) := by
              have he_id : (ε.hom.app c_cocone.pt : L.obj (U.obj c_cocone.pt) ⟶ c_cocone.pt) ≫
                  𝟙 c_cocone.pt = ε.hom.app c_cocone.pt := Category.comp_id _
              rw [h_id, ← Category.assoc, he_id, hid_c]
        have hL_q_iso : IsIso (L.map q) := ⟨⟨q_inv, h_left, h_right⟩⟩
        have hW_q : CategoryTheory.GrothendieckTopology.W J₀ q :=
          (CategoryTheory.GrothendieckTopology.W_iff J₀ q).mpr hL_q_iso
        have hW_Xq : CategoryTheory.GrothendieckTopology.W J₀
            (MonoidalCategoryStruct.whiskerLeft (U.obj X) q) :=
          CategoryTheory.MorphismProperty.whiskerLeft_mem
            (CategoryTheory.GrothendieckTopology.W J₀) (U.obj X) q hW_q
        haveI : IsIso (H.map q) :=
          (CategoryTheory.GrothendieckTopology.W_iff J₀
            (MonoidalCategoryStruct.whiskerLeft (U.obj X) q)).mp hW_Xq
        let hc₀_H : Limits.IsColimit (H.mapCocone c₀) := Limits.isColimitOfPreserves H hc₀
        let iso_cocone : H.mapCocone c₀ ≅ (U ⋙ H).mapCocone c_cocone :=
          Limits.Cocones.ext (asIso (H.map q)) (fun j => by
            dsimp
            rw [← H.map_comp, hq_ι j])
        exact Limits.IsColimit.ofIsoColimit hc₀_H iso_cocone
      exact Limits.preservesFiniteColimits_of_natIso (τ_X X).symm
    have hSheaf_colim_R : ∀ X : ℳ₀, Limits.PreservesFiniteColimits (MonoidalCategory.tensorRight X) := by
      intro X
      letI := hSheaf_colim_L X
      exact Limits.preservesFiniteColimits_of_natIso (β_nat X).symm
    let P : ℳ₀ → Prop := fun X =>
      ∀ ⦃G₁ G₂ : ℳ₀⦄ (j : G₁ ⟶ G₂) [Mono j], Mono ((MonoidalCategory.tensorLeft X).map j)
    have hP_right_mono : ∀ {X : ℳ₀}, P X →
        ∀ ⦃G₁ G₂ : ℳ₀⦄ (j : G₁ ⟶ G₂) [Mono j], Mono ((MonoidalCategory.tensorRight X).map j) := by
      intro X hX G₁ G₂ j hj
      haveI : Mono ((MonoidalCategory.tensorLeft X).map j) := hX j
      have heq : (MonoidalCategory.tensorRight X).map j =
          (BraidedCategory.braiding G₁ X).hom ≫ (MonoidalCategory.tensorLeft X).map j ≫
            (BraidedCategory.braiding G₂ X).inv := by
        calc
          (MonoidalCategory.tensorRight X).map j =
            (MonoidalCategoryStruct.whiskerRight j X ≫ (BraidedCategory.braiding G₂ X).hom) ≫
              (BraidedCategory.braiding G₂ X).inv := by
                change MonoidalCategoryStruct.whiskerRight j X = _
                rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
          _ = (BraidedCategory.braiding G₁ X).hom ≫ (MonoidalCategory.tensorLeft X).map j ≫
              (BraidedCategory.braiding G₂ X).inv := by
                rw [BraidedCategory.braiding_naturality_left j X, Category.assoc]
                rfl
      rw [heq]
      exact mono_comp _ _
    have hP_lim_L : ∀ {X : ℳ₀}, P X → Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft X) := by
      intro X hX
      letI := hSheaf_add_L X
      letI := hSheaf_colim_L X
      rw [Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono]
      intro S hS
      haveI : Mono S.f := hS.mono_f
      exact ⟨((Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi
        (MonoidalCategory.tensorLeft X)).mp inferInstance S hS).1, hX S.f⟩
    have hP_lim_R : ∀ {X : ℳ₀}, P X → Limits.PreservesFiniteLimits (MonoidalCategory.tensorRight X) := by
      intro X hX
      letI := hP_lim_L hX
      exact Limits.preservesFiniteLimits_of_natIso (β_nat X).symm
    have hP_unit : P (MonoidalCategoryStruct.tensorUnit ℳ₀) := by
      intro G₁ G₂ j hj
      have heq : (MonoidalCategory.tensorLeft (MonoidalCategoryStruct.tensorUnit ℳ₀)).map j =
          (MonoidalCategoryStruct.leftUnitor G₁).hom ≫ j ≫
            (MonoidalCategoryStruct.leftUnitor G₂).inv := by
        calc
          (MonoidalCategory.tensorLeft (MonoidalCategoryStruct.tensorUnit ℳ₀)).map j =
            (MonoidalCategoryStruct.whiskerLeft (MonoidalCategoryStruct.tensorUnit ℳ₀) j ≫
              (MonoidalCategoryStruct.leftUnitor G₂).hom) ≫
              (MonoidalCategoryStruct.leftUnitor G₂).inv := by
                change MonoidalCategoryStruct.whiskerLeft (MonoidalCategoryStruct.tensorUnit ℳ₀) j = _
                rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
          _ = (MonoidalCategoryStruct.leftUnitor G₁).hom ≫ j ≫
