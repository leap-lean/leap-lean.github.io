theorem weil_kunneth_abstract_cosyzygy_leray_expansion {C₁ C₂ : Type (u + 1)}
    [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁] [CategoryTheory.HasExt.{u} C₁]
    [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂] [CategoryTheory.HasExt.{u} C₂]
    (P_pull : CategoryTheory.Functor C₁ C₂)
    (P_push : CategoryTheory.Functor C₂ C₁)
    (adj : P_pull ⊣ P_push)
    [P_pull.Additive]
    [CategoryTheory.Limits.PreservesFiniteLimits P_pull]
    [CategoryTheory.Limits.PreservesFiniteColimits P_pull]
    (one₁ : C₁) (one₂ : C₂) (e_unit : one₂ ≅ P_pull.obj one₁)
    (D m₀ M : ℕ) (b : ℕ → ℕ)
    (v₁ : ∀ q : ℕ, Fin (b q) → CategoryTheory.Abelian.Ext.{u} one₁ one₁ q)
