      intro W 𝒢 m
      change evalOne_R _ (homAdd_fn W 𝒢 m) = _
      rw [hhomAdd_fn, hevalOne_apply]
    let Sig0_fn (U₀ : W₀.Etale) : CategoryTheory.Functor (Fgt₀.obj U₀).left.Etale W₀.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ (U₀.prop : P_et (Fgt₀.obj U₀).hom)
    let ι_I0 (U₀ : W₀.Etale) :
        (Sig0_fn U₀).obj (I_et (Fgt₀.obj U₀).left) ≅ U₀ :=
      { hom := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id (Fgt₀.obj U₀).left)
          (CategoryTheory.Category.id_comp _) trivial
        inv := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id (Fgt₀.obj U₀).left)
          ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.id_comp _).symm)
          trivial
        hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
        inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _) }
    let ι_I (U₀ : W₀.Etale) :
        (Sigma_et U₀.prop).obj (I_et (Fgt₀.obj U₀).left) ≅ U₀ :=
      ((eqToIso (hSigma_et U₀.prop)).app (I_et (Fgt₀.obj U₀).left)).trans (ι_I0 U₀)
    let ι_slice (U₀ : W₀.Etale) :
        (Sigma_et U₀.prop).obj (T_fn (Fgt₀.obj U₀).left) ≅ U₀ :=
      ((Sigma_et U₀.prop).mapIso (e_T (Fgt₀.obj U₀).left)).trans (ι_I U₀)
    let mapIso_sec (U₀ : W₀.Etale) (ℱ : CategoryTheory.Sheaf W₀.smallEtaleTopology ModR) :
        ↑(ℱ.obj.obj (Opposite.op U₀)) ≃+
          ↑(((Res_fn (Fgt₀.obj U₀).hom U₀.prop).obj ℱ).obj.obj
            (Opposite.op (T_fn (Fgt₀.obj U₀).left))) :=
      (ℱ.obj.mapIso (ι_slice U₀).op).toLinearEquiv.toAddEquiv
    let μ_sec (U₀ : W₀.Etale) (ℱ : CategoryTheory.Sheaf W₀.smallEtaleTopology ModR) :
        ↑(ℱ.obj.obj (Opposite.op U₀)) ≃+
          (one_fn (Fgt₀.obj U₀).left ⟶ (Res_fn (Fgt₀.obj U₀).hom U₀.prop).obj ℱ) :=
      (mapIso_sec U₀ ℱ).trans
        (secEval (Fgt₀.obj U₀).left ((Res_fn (Fgt₀.obj U₀).hom U₀.prop).obj ℱ)).symm
    have hμ_eval : ∀ (U₀ : W₀.Etale) (ℱ : CategoryTheory.Sheaf W₀.smallEtaleTopology ModR)
        (σ : ↑(ℱ.obj.obj (Opposite.op U₀))),
        (u_fn (Fgt₀.obj U₀).left ≫
          (μ_sec U₀ ℱ σ).hom.app (Opposite.op (T_fn (Fgt₀.obj U₀).left))).hom r_one =
        (ℱ.obj.map (Opposite.op (ι_slice U₀).hom)).hom σ := by
      intro U₀ ℱ σ
      rw [← hsecEval_apply]
      exact (secEval (Fgt₀.obj U₀).left _).apply_symm_apply (mapIso_sec U₀ ℱ σ)
    have hμ_nat : ∀ (U₀ : W₀.Etale) {ℱ₁ ℱ₂ : CategoryTheory.Sheaf W₀.smallEtaleTopology ModR}
        (α : ℱ₁ ⟶ ℱ₂) (σ : ↑(ℱ₁.obj.obj (Opposite.op U₀))),
        μ_sec U₀ ℱ₂ ((α.hom.app (Opposite.op U₀)).hom σ) =
          μ_sec U₀ ℱ₁ σ ≫ (Res_fn (Fgt₀.obj U₀).hom U₀.prop).map α := by
      intro U₀ ℱ₁ ℱ₂ α σ
      apply (secEval (Fgt₀.obj U₀).left _).injective
      rw [hsecEval_apply, hsecEval_apply, hμ_eval]
      let m_α := α.hom.app (Opposite.op ((Sigma_et U₀.prop).obj (T_fn (Fgt₀.obj U₀).left)))
      have h_assoc : u_fn (Fgt₀.obj U₀).left ≫
          (μ_sec U₀ ℱ₁ σ ≫ (Res_fn (Fgt₀.obj U₀).hom U₀.prop).map α).hom.app
            (Opposite.op (T_fn (Fgt₀.obj U₀).left)) =
        (u_fn (Fgt₀.obj U₀).left ≫
          (μ_sec U₀ ℱ₁ σ).hom.app (Opposite.op (T_fn (Fgt₀.obj U₀).left))) ≫ m_α :=
        (CategoryTheory.Category.assoc _ _ _).symm
      have h_rhs :
