          let f_i : ∀ idx : Idx, W_i idx ⟶ W := fun idx => openSubHom W (O_a idx.1)
          have hIdx_inj : ∀ {i₁ i₂ : Idx} {Y₀ : S.Etale} (g₁ : Y₀ ⟶ W_i i₁) (g₂ : Y₀ ⟶ W_i i₂),
              Nonempty ↥Y₀.left → g₁ ≫ f_i i₁ = g₂ ≫ f_i i₂ → i₁ = i₂ := by
