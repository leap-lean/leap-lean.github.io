    have hι_rel : ιℤ_r = CategoryTheory.CategoryStruct.comp ιℤ_s (η.hom.app (C₂.obj Aℤ)) := by
      have hleft_inv : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp ιℤ_r (η.inv.app (C₂.obj Aℤ))) (π_s Aℤ) =
          CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) := by
