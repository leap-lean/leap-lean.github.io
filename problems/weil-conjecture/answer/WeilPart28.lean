      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i →
        ∀ (V : Y.Opens) (s_V : Quiver.Hom Z V.toScheme),
