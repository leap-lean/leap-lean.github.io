                    map_add' := fun s₁ s₂ => funext fun γ => φ.hom.map_add (s₁ γ) (s₂ γ) }
                naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl } }
        map_id := fun _ => CategoryTheory.Sheaf.hom_ext <| CategoryTheory.NatTrans.ext <|
          funext fun _ => AddCommGrpCat.ext fun _ => rfl
        map_comp := fun _ _ => CategoryTheory.Sheaf.hom_ext <| CategoryTheory.NatTrans.ext <|
          funext fun _ => AddCommGrpCat.ext fun _ => rfl }
  have hStalkRepIndep : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω]
      (ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      {U : S.Etale} {γ : GeomLifts ξ U} (s : ↑(ℱ.obj.obj (Opposite.op U)))
      (el₁ el₂ : (LiftFunctor ξ).Elements)
      (w₁ : (weilOrdGodSmallAffSpec S).obj el₁.1 ⟶ U)
      (w₂ : (weilOrdGodSmallAffSpec S).obj el₂.1 ⟶ U),
      GeomLiftMap ξ w₁ el₁.2 = γ →
      GeomLiftMap ξ w₂ el₂.2 = γ →
      (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₁))
          ((ℱ.obj.map w₁.op) s) =
        (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₂))
          ((ℱ.obj.map w₂.op) s) := by
    intro S Ω _ ξ ℱ U γ s el₁ el₂ w₁ w₂ hw₁ hw₂
    obtain ⟨el₃, u₁, u₂, hu12⟩ := hCommonRef el₁ el₂ w₁ w₂ hw₁ hw₂
    have h1 : (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₁))
        ((ℱ.obj.map w₁.op) s) =
        (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₃))
          ((ℱ.obj.map ((weilOrdGodSmallAffSpec S).map u₁.1 ≫ w₁).op) s) := by
      have hw := CategoryTheory.Limits.colimit.w (StalkAt ξ ℱ) u₁.op
      have h_ev := congrArg (fun k => k ((ℱ.obj.map w₁.op) s)) hw.symm
      have h_comp : ℱ.obj.map ((weilOrdGodSmallAffSpec S).map u₁.1 ≫ w₁).op =
          ℱ.obj.map w₁.op ≫ ℱ.obj.map ((weilOrdGodSmallAffSpec S).map u₁.1).op :=
        ℱ.obj.map_comp w₁.op _
      exact h_ev.trans (congrArg (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₃))
        (congrArg (fun m => m s) h_comp.symm))
    have h2 : (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₂))
        ((ℱ.obj.map w₂.op) s) =
        (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₃))
          ((ℱ.obj.map ((weilOrdGodSmallAffSpec S).map u₂.1 ≫ w₂).op) s) := by
      have hw := CategoryTheory.Limits.colimit.w (StalkAt ξ ℱ) u₂.op
      have h_ev := congrArg (fun k => k ((ℱ.obj.map w₂.op) s)) hw.symm
      have h_comp : ℱ.obj.map ((weilOrdGodSmallAffSpec S).map u₂.1 ≫ w₂).op =
          ℱ.obj.map w₂.op ≫ ℱ.obj.map ((weilOrdGodSmallAffSpec S).map u₂.1).op :=
        ℱ.obj.map_comp w₂.op _
      exact h_ev.trans (congrArg (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₃))
        (congrArg (fun m => m s) h_comp.symm))
    exact h1.trans ((congrArg (fun m =>
      (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op el₃)) ((ℱ.obj.map m.op) s))
      hu12).trans h2.symm)
  
  let skyCocone : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      (ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (A : AddCommGrpCat.{u})
      (_φ : ℱ ⟶ (Sky ξ).obj A),
      CategoryTheory.Limits.Cocone (StalkAt ξ ℱ) :=
    fun {S Ω} _ _ ξ ℱ A φ =>
      CategoryTheory.Limits.Cocone.mk A
        { app := fun opEl => AddCommGrpCat.ofHom
            { toFun := fun s =>
                (φ.hom.app (Opposite.op ((weilOrdGodSmallAffSpec S).obj opEl.unop.1)) s)
                  opEl.unop.2
              map_zero' := by
                change ((φ.hom.app _ 0) opEl.unop.2) = 0
                rw [map_zero]
                rfl
              map_add' := fun s₁ s₂ => by
                change ((φ.hom.app _ (s₁ + s₂)) opEl.unop.2) = _
                rw [map_add]
                rfl }
          naturality := fun {opEl₁ opEl₂} g_op => by
            apply AddCommGrpCat.ext
            intro s
            dsimp [StalkAt, StalkDiagram]
            let g : opEl₂.unop ⟶ opEl₁.unop := g_op.unop
            let w : (weilOrdGodSmallAffSpec S).obj opEl₂.unop.1 ⟶
                (weilOrdGodSmallAffSpec S).obj opEl₁.unop.1 :=
              (weilOrdGodSmallAffSpec S).map g.1
            have hnat := congrArg (fun m => (m s) opEl₂.unop.2)
              (φ.hom.naturality w.op)
            change ((φ.hom.app _) ((ℱ.obj.map w.op) s)) opEl₂.unop.2 =
              ((φ.hom.app _) s) (GeomLiftMap ξ w opEl₂.unop.2) at hnat
            have hg2 : GeomLiftMap ξ w opEl₂.unop.2 = opEl₁.unop.2 := g.2
            exact hnat.trans (congrArg (φ.hom.app _ s) hg2) }
  let stalkHomEquiv : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      (ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (A : AddCommGrpCat.{u}),
      ((Stalk ξ).obj ℱ ⟶ A) ≃ (ℱ ⟶ (Sky ξ).obj A) :=
    fun {S Ω} _ _ ξ ℱ A =>
      { toFun := fun u =>
          { hom :=
              { app := fun opU => AddCommGrpCat.ofHom
                  { toFun := fun s γ =>
                      let ch := hShrinkAny ξ opU.unop γ
                      u ((CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ)
                        (Opposite.op ch.choose))
                        ((ℱ.obj.map ch.choose_spec.choose.op) s))
                    map_zero' := funext fun γ => by
                      dsimp
                      rw [map_zero, map_zero, map_zero]
                    map_add' := fun s₁ s₂ => funext fun γ => by
                      dsimp
                      rw [map_add, map_add, map_add] }
                naturality := fun {opU₁ opU₂} f_op => by
                  apply AddCommGrpCat.ext
                  intro s
                  funext γ
                  dsimp
                  let f : opU₂.unop ⟶ opU₁.unop := f_op.unop
                  let ch₁ := hShrinkAny ξ opU₁.unop (GeomLiftMap ξ f γ)
                  let ch₂ := hShrinkAny ξ opU₂.unop γ
                  have h_lift₂ : GeomLiftMap ξ (ch₂.choose_spec.choose ≫ f) ch₂.choose.2 =
                      GeomLiftMap ξ f γ := by
                    have hc : (ch₂.choose_spec.choose ≫ f).left =
                        ch₂.choose_spec.choose.left ≫ f.left := rfl
                    exact Subtype.ext ((congrArg (ch₂.choose.2.1 ≫ ·) hc).trans
                      ((CategoryTheory.Category.assoc _ _ _).symm.trans
                        (congrArg (· ≫ f.left)
                          (congrArg Subtype.val ch₂.choose_spec.choose_spec))))
                  have hind := hStalkRepIndep ξ ℱ s
                    ch₂.choose ch₁.choose (ch₂.choose_spec.choose ≫ f)
                    ch₁.choose_spec.choose h_lift₂ ch₁.choose_spec.choose_spec
                  have hcomp : ℱ.obj.map (ch₂.choose_spec.choose ≫ f).op =
                      ℱ.obj.map f_op ≫ ℱ.obj.map ch₂.choose_spec.choose.op :=
                    ℱ.obj.map_comp f_op ch₂.choose_spec.choose.op
                  exact congrArg u ((congrArg
                    (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) (Opposite.op ch₂.choose))
                    (congrArg (fun m => m s) hcomp.symm)).trans hind) } }
        invFun := fun φ => CategoryTheory.Limits.colimit.desc (StalkAt ξ ℱ) (skyCocone ξ ℱ A φ)
        left_inv := fun u => by
          apply CategoryTheory.Limits.colimit.hom_ext
          intro opEl
          refine (CategoryTheory.Limits.colimit.ι_desc (skyCocone ξ ℱ A _) opEl).trans ?_
          apply AddCommGrpCat.ext
          intro s
          dsimp [skyCocone]
          let el := opEl.unop
          let U_el := (weilOrdGodSmallAffSpec S).obj el.1
          let ch := hShrinkAny ξ U_el el.2
          have hid : GeomLiftMap ξ (𝟙 U_el) el.2 = el.2 :=
            Subtype.ext (CategoryTheory.Category.comp_id el.2.1)
          have hind := hStalkRepIndep ξ ℱ s ch.choose el ch.choose_spec.choose
            (𝟙 U_el) ch.choose_spec.choose_spec hid
          have hmap_id : (ℱ.obj.map (Opposite.op (𝟙 U_el))) s = s :=
            congrArg (fun m => m s) (ℱ.obj.map_id (Opposite.op U_el))
          exact congrArg u (hind.trans
            (congrArg (CategoryTheory.Limits.colimit.ι (StalkAt ξ ℱ) opEl) hmap_id))
        right_inv := fun φ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opU
          apply AddCommGrpCat.ext
          intro s
          funext γ
          dsimp
          let ch := hShrinkAny ξ opU.unop γ
          have hdesc := congrArg
            (fun m => m ((ℱ.obj.map ch.choose_spec.choose.op) s))
            (CategoryTheory.Limits.colimit.ι_desc (skyCocone ξ ℱ A φ) (Opposite.op ch.choose))
          refine hdesc.trans ?_
          dsimp [skyCocone]
          have hnat := congrArg (fun m => (m s) ch.choose.2)
            (φ.hom.naturality ch.choose_spec.choose.op)
          change ((φ.hom.app _) ((ℱ.obj.map ch.choose_spec.choose.op) s)) ch.choose.2 =
            ((φ.hom.app opU) s) (GeomLiftMap ξ ch.choose_spec.choose ch.choose.2) at hnat
          exact hnat.trans (congrArg (φ.hom.app opU s) ch.choose_spec.choose_spec) }
