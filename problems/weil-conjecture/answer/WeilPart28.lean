      {T_Y₁ T_Y₂ : Y.Etale} (hT_Y₁ : CategoryTheory.Limits.IsTerminal T_Y₁)
      (hT_Y₂ : CategoryTheory.Limits.IsTerminal T_Y₂)
      {T_Z₁ T_Z₂ : Z.Etale} (hT_Z₁ : CategoryTheory.Limits.IsTerminal T_Z₁)
