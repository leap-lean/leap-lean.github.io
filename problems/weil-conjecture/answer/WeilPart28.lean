      intro W hW_ne c₁ c₂ hc
      have hc' : (e (B₁.obj W)).symm
          (p_std (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj W)).hom pr₂) ℓ q c₁) =
