      let adjR₀ := CategoryTheory.constantSheafAdj T.smallEtaleTopology
        (ModuleCat.{u, u} R₀) (hT_of T)
      have h1 : Fgt₁.map (adjR₁.unit.app R₁_mod) ≫
          ((c_ab_of T).hom.app (Opposite.op (T_of T))) =
          Fgt₁.map (adjR₁.unit.app R₁_mod ≫ (c_of T).hom.app (Opposite.op (T_of T))) :=
        (Fgt₁.map_comp _ _).symm
      have h2 : adjR₁.unit.app R₁_mod ≫ (c_of T).hom.app (Opposite.op (T_of T)) =
          π_lin ≫ (ModuleCat.restrictScalars π).map (adjR₀.unit.app R₀_mod) :=
        (Adjunction.homEquiv_unit adjR₁ R₁_mod ((ρ_of T).obj (One_of T m₀)) (c_of T)).symm.trans
          (Equiv.apply_symm_apply _ _)
      exact h1.trans ((congrArg Fgt₁.map h2).trans (Fgt₁.map_comp _ _))

    have h_ιℤ_c : ∀ (T : AlgebraicGeometry.Scheme.{u}),
        ιℤ_std T m₁ ≫ c_ab_of T = ιℤ_std T m₀ := by
      intro T
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let adjℤ := CategoryTheory.constantSheafAdj T.smallEtaleTopology AddCommGrpCat.{u} (hT_of T)
      apply (adjℤ.homEquiv Aℤ ((U_of T m₀).obj (One_of T m₀))).injective
      rw [Adjunction.homEquiv_naturality_right adjℤ (ιℤ_std T m₁) (c_ab_of T),
        h_ιℤ_std_ev T m₁, h_ιℤ_std_ev T m₀]
      calc
        (z_to_m_of m₁ ≫ ιM_of m₁ ≫ u₀_of T m₁) ≫
            ((CategoryTheory.sheafSections T.smallEtaleTopology AddCommGrpCat.{u}).obj
              (Opposite.op (T_of T))).map (c_ab_of T)
          = z_to_m_of m₁ ≫ ιM_of m₁ ≫
              (u₀_of T m₁ ≫
                ((CategoryTheory.sheafSections T.smallEtaleTopology AddCommGrpCat.{u}).obj
                  (Opposite.op (T_of T))).map (c_ab_of T)) := by
              simp only [Category.assoc]
        _ = z_to_m_of m₁ ≫ ιM_of m₁ ≫ (π_ab ≫ u₀_of T m₀) :=
              congrArg (fun k => z_to_m_of m₁ ≫ ιM_of m₁ ≫ k) (h_c_unit T)
        _ = ((z_to_m_of m₁ ≫ ιM_of m₁) ≫ π_ab) ≫ u₀_of T m₀ := by
              simp only [Category.assoc]
        _ = (z_to_m_of m₀ ≫ ιM_of m₀) ≫ u₀_of T m₀ :=
              congrArg (· ≫ u₀_of T m₀) h_z_π
        _ = z_to_m_of m₀ ≫ ιM_of m₀ ≫ u₀_of T m₀ := Category.assoc _ _ _

    have h_β_c : ∀ (T : AlgebraicGeometry.Scheme.{u}),
        let βM₀' : (U_of T m₁).obj ((ρ_of T).obj (One_of T m₀)) ⟶ weilEtaleTorsionSheaf T m₀ :=
          βM_of T m₀
        (U_of T m₁).map (c_of T) ≫ βM₀' =
          βM_of T m₁ ≫
            (CategoryTheory.constantSheaf T.smallEtaleTopology AddCommGrpCat.{u}).map τ₀_cast := by
      intro T βM₀'
      let AM₁ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₁))
      let Cℤ := CategoryTheory.constantSheaf T.smallEtaleTopology AddCommGrpCat.{u}
      let adjℤ := CategoryTheory.constantSheafAdj T.smallEtaleTopology AddCommGrpCat.{u} (hT_of T)
      have h_α : αM_of T m₁ ≫ c_ab_of T = Cℤ.map τ₀_cast ≫ αM_of T m₀ := by
        apply (adjℤ.homEquiv AM₁ ((U_of T m₀).obj (One_of T m₀))).injective
        rw [Adjunction.homEquiv_naturality_right adjℤ (αM_of T m₁) (c_ab_of T),
          Adjunction.homEquiv_naturality_left adjℤ τ₀_cast (αM_of T m₀),
          h_αM_homEquiv, h_αM_homEquiv]
        calc
          (ιM_of m₁ ≫ u₀_of T m₁) ≫
              ((CategoryTheory.sheafSections T.smallEtaleTopology AddCommGrpCat.{u}).obj
                (Opposite.op (T_of T))).map (c_ab_of T)
            = ιM_of m₁ ≫
                (u₀_of T m₁ ≫
                  ((CategoryTheory.sheafSections T.smallEtaleTopology AddCommGrpCat.{u}).obj
                    (Opposite.op (T_of T))).map (c_ab_of T)) := Category.assoc _ _ _
          _ = ιM_of m₁ ≫ (π_ab ≫ u₀_of T m₀) :=
                congrArg (ιM_of m₁ ≫ ·) (h_c_unit T)
          _ = (ιM_of m₁ ≫ π_ab) ≫ u₀_of T m₀ := (Category.assoc _ _ _).symm
          _ = (τ₀_cast ≫ ιM_of m₀) ≫ u₀_of T m₀ :=
                congrArg (· ≫ u₀_of T m₀) h_ιM_π
          _ = τ₀_cast ≫ ιM_of m₀ ≫ u₀_of T m₀ := Category.assoc _ _ _
      change c_ab_of T ≫ βM_of T m₀ = βM_of T m₁ ≫ Cℤ.map τ₀_cast
      calc
        c_ab_of T ≫ βM_of T m₀ = 𝟙 _ ≫ (c_ab_of T ≫ βM_of T m₀) := (Category.id_comp _).symm
        _ = (βM_of T m₁ ≫ αM_of T m₁) ≫ (c_ab_of T ≫ βM_of T m₀) := by rw [hβα_of T m₁]
        _ = βM_of T m₁ ≫ ((αM_of T m₁ ≫ c_ab_of T) ≫ βM_of T m₀) := by simp only [Category.assoc]
        _ = βM_of T m₁ ≫ Cℤ.map τ₀_cast := by
              rw [h_α]; simp only [Category.assoc, hαβ_of T m₀]; rw [Category.comp_id]

    
    have hModBridge : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (B : W₂.Etale ⥤ W₁.Etale)
        [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology],
        Limits.PreservesFiniteColimits
          (B.sheafPushforwardContinuous AddCommGrpCat.{u}
            W₂.smallEtaleTopology W₁.smallEtaleTopology) →
        ∀ (d : ℕ)
          (v₁ : Abelian.Ext.{u}
            ((B.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
              W₂.smallEtaleTopology W₁.smallEtaleTopology).obj (One_of W₁ m₁))
            (One_of W₂ m₁) d)
          (v₀ : Abelian.Ext.{u}
            ((B.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
              W₂.smallEtaleTopology W₁.smallEtaleTopology).obj (One_of W₁ m₀))
            (One_of W₂ m₀) d),
          ((e_raw B m₁ d v₁).comp
              (Abelian.Ext.mk₀
                ((CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).map τ₀_cast))
              (Nat.add_zero d) =
            e_raw B m₀ d v₀) ↔
          (v₁.comp (Abelian.Ext.mk₀ (c_of W₂)) (Nat.add_zero d) =
            (Abelian.Ext.mk₀ (push_c_of B)).comp
              (Abelian.Ext.mapExactFunctor (ρ_of W₂) v₀) (Nat.zero_add d)) := by
      intro W₁ W₂ B _ hColim_B d v₁ v₀
      have _ : EnoughInjectives
          (CategoryTheory.Sheaf W₂.smallEtaleTopology (ModuleCat.{u, u} R₀)) := inferInstance
      let f_push₁ := B.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      let f_push₀ := B.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      let f_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      let Fℤ₁ := (CategoryTheory.constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      let C_ab₂ := CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
      let βM₀' : (U_of W₂ m₁).obj ((ρ_of W₂).obj (One_of W₂ m₀)) ⟶ weilEtaleTorsionSheaf W₂ m₀ :=
        βM_of W₂ m₀
      let αM₀' : weilEtaleTorsionSheaf W₂ m₀ ⟶ (U_of W₂ m₁).obj ((ρ_of W₂).obj (One_of W₂ m₀)) :=
        αM_of W₂ m₀
      have hβα₀' : βM₀' ≫ αM₀' = 𝟙 _ := hβα_of W₂ m₀
      have h_ζ_c : ζ_of B m₁ ≫ (U_of W₂ m₁).map (push_c_of B) = ζ_of B m₀ := by
        have h1 : f_push_ab.map (ιℤ_std W₁ m₁) ≫ f_push_ab.map (c_ab_of W₁) =
            f_push_ab.map (ιℤ_std W₁ m₀) := by
          rw [← f_push_ab.map_comp, h_ιℤ_c W₁]
        exact h1
      have h_comp_map :
          Abelian.Ext.mapExactFunctor (U_of W₂ m₁) (Abelian.Ext.mapExactFunctor (ρ_of W₂) v₀) =
            Abelian.Ext.mapExactFunctor (U_of W₂ m₀) v₀ := by
        refine (mapExactFunctor_comp_apply (ρ_of W₂) (U_of W₂ m₁) v₀).symm.trans ?_
        have hF : ρ_of W₂ ⋙ U_of W₂ m₁ = U_of W₂ m₀ := rfl
        congr! 1
      let Ψ (z : Abelian.Ext.{u} (f_push₁.obj (One_of W₁ m₁)) ((ρ_of W₂).obj (One_of W₂ m₀)) d) :
          Abelian.Ext.{u} (f_push_ab.obj Fℤ₁) (weilEtaleTorsionSheaf W₂ m₀) d :=
        ((Abelian.Ext.mk₀ (ζ_of B m₁)).comp (Abelian.Ext.mapExactFunctor (U_of W₂ m₁) z)
          (Nat.zero_add d)).comp (Abelian.Ext.mk₀ βM₀') (Nat.add_zero d)
      have hΨ_inj : Function.Injective Ψ := by
        intro z₁ z₂ hz
        apply ((hSuppGenBij B m₁ hColim_B).2 d ((ρ_of W₂).obj (One_of W₂ m₀))).injective
        have hz' := congrArg (fun w => w.comp (Abelian.Ext.mk₀ αM₀') (Nat.add_zero d)) hz
        dsimp only [Ψ] at hz'
        rw [Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ βM₀') (Abelian.Ext.mk₀ αM₀')
            (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d),
          Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ βM₀') (Abelian.Ext.mk₀ αM₀')
            (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d),
          Abelian.Ext.mk₀_comp_mk₀, hβα₀', Abelian.Ext.comp_mk₀_id, Abelian.Ext.comp_mk₀_id] at hz'
        exact hz'
      have hΨ_left : Ψ (v₁.comp (Abelian.Ext.mk₀ (c_of W₂)) (Nat.add_zero d)) =
          (e_raw B m₁ d v₁).comp (Abelian.Ext.mk₀ (C_ab₂.map τ₀_cast)) (Nat.add_zero d) := by
        rw [he_raw_apply B m₁ d v₁]
        dsimp only [Ψ]
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
          ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ζ_of B m₁))
            (Abelian.Ext.mapExactFunctor (U_of W₂ m₁) v₁)
            (Abelian.Ext.mk₀ ((U_of W₂ m₁).map (c_of W₂)))
            (Nat.zero_add d) (Nat.add_zero d) (Nat.zero_add d),
          Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ ((U_of W₂ m₁).map (c_of W₂)))
            (Abelian.Ext.mk₀ βM₀') (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d),
          Abelian.Ext.mk₀_comp_mk₀, h_β_c W₂, ← Abelian.Ext.mk₀_comp_mk₀,
          ← Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ (βM_of W₂ m₁))
            (Abelian.Ext.mk₀ (C_ab₂.map τ₀_cast))
            (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d)]
      have hΨ_right : Ψ ((Abelian.Ext.mk₀ (push_c_of B)).comp
          (Abelian.Ext.mapExactFunctor (ρ_of W₂) v₀) (Nat.zero_add d)) =
          e_raw B m₀ d v₀ := by
        rw [he_raw_apply B m₀ d v₀]
        dsimp only [Ψ]
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
          ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ζ_of B m₁))
            (Abelian.Ext.mk₀ ((U_of W₂ m₁).map (push_c_of B)))
            (Abelian.Ext.mapExactFunctor (U_of W₂ m₁) (Abelian.Ext.mapExactFunctor (ρ_of W₂) v₀))
            (Nat.zero_add 0) (Nat.zero_add d) (Nat.zero_add d),
          Abelian.Ext.mk₀_comp_mk₀]
        exact congrArg
          (fun w : Abelian.Ext.{u} (f_push_ab.obj Fℤ₁) ((U_of W₂ m₀).obj (One_of W₂ m₀)) d =>
            w.comp (Abelian.Ext.mk₀ (βM_of W₂ m₀)) (Nat.add_zero d))
          (congrArg₂
            (fun (f : f_push_ab.obj Fℤ₁ ⟶ (U_of W₂ m₀).obj (f_push₀.obj (One_of W₁ m₀)))
                (z : Abelian.Ext.{u} ((U_of W₂ m₀).obj (f_push₀.obj (One_of W₁ m₀)))
                  ((U_of W₂ m₀).obj (One_of W₂ m₀)) d) =>
              (Abelian.Ext.mk₀ f).comp z (Nat.zero_add d))
            h_ζ_c h_comp_map)
      rw [← hΨ_left, ← hΨ_right]
      exact hΨ_inj.eq_iff

    
    let q_mod_std {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (B : W₂.Etale ⥤ W₁.Etale)
        [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology] (m : ℕ) :
        One_of W₂ m ⟶
          (B.sheafPushforwardContinuous (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
            W₂.smallEtaleTopology W₁.smallEtaleTopology).obj (One_of W₁ m) :=
      let R := ULift.{u, 0} (ZMod m)
      let R_mod := ModuleCat.of R R
      let adj₁ := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology
        (ModuleCat.{u, u} R) (hT_of W₁)
      let adj₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology
        (ModuleCat.{u, u} R) (hT_of W₂)
      (adj₂.homEquiv R_mod _).symm
        (adj₁.unit.app R_mod ≫ (One_of W₁ m).obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op)

    let q_ab_std {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (B : W₂.Etale ⥤ W₁.Etale)
        [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology] :
        (CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶
          (B.sheafPushforwardContinuous AddCommGrpCat.{u}
            W₂.smallEtaleTopology W₁.smallEtaleTopology).obj
            ((CategoryTheory.constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}).obj
              (AddCommGrpCat.of (ULift.{u} ℤ))) :=
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let Fℤ₁ := (CategoryTheory.constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let adj₁ := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology AddCommGrpCat.{u} (hT_of W₁)
      let adj₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology AddCommGrpCat.{u} (hT_of W₂)
      (adj₂.homEquiv Aℤ _).symm
        (adj₁.unit.app Aℤ ≫ Fℤ₁.obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op)

    have hq_mod_indep : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (B : W₂.Etale ⥤ W₁.Etale)
        [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology] (m : ℕ)
        (T₁ : W₁.Etale) (hT₁ : Limits.IsTerminal T₁)
        (T₂ : W₂.Etale) (hT₂ : Limits.IsTerminal T₂),
        let R := ULift.{u, 0} (ZMod m)
        let R_mod := ModuleCat.of R R
        let f_push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R)
          W₂.smallEtaleTopology W₁.smallEtaleTopology
        let adj₁ := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R) hT₁
        let adj₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology (ModuleCat.{u, u} R) hT₂
        (adj₂.homEquiv R_mod (f_push.obj (One_of W₁ m))).symm
          (adj₁.unit.app R_mod ≫ (One_of W₁ m).obj.map (hT₁.from (B.obj T₂)).op) =
        q_mod_std B m := by
      intro W₁ W₂ B _ m T₁ hT₁ T₂ hT₂ R R_mod f_push adj₁ adj₂
      let adj₁_std := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology
        (ModuleCat.{u, u} R) (hT_of W₁)
      refine (congrArg (adj₂.homEquiv R_mod (f_push.obj (One_of W₁ m))).symm ?_).trans
        (hConstSymmMap (hT_of W₂) hT₂ R_mod (f_push.obj (One_of W₁ m))
          (adj₁_std.unit.app R_mod ≫ (One_of W₁ m).obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op))
      have hu : adj₁.unit.app R_mod =
          adj₁_std.unit.app R_mod ≫ (One_of W₁ m).obj.map ((hT_of W₁).from T₁).op :=
        (hConstUnitMap (hT_of W₁) hT₁ ((hT_of W₁).from T₁) R_mod).symm
      have hm1 : (One_of W₁ m).obj.map ((hT_of W₁).from T₁).op ≫
          (One_of W₁ m).obj.map (hT₁.from (B.obj T₂)).op =
          (One_of W₁ m).obj.map (hT₁.from (B.obj T₂) ≫ (hT_of W₁).from T₁).op :=
        ((One_of W₁ m).obj.map_comp _ _).symm.trans
          (congrArg (One_of W₁ m).obj.map (CategoryTheory.op_comp (f := _) (g := _)).symm)
      have hm2 : (One_of W₁ m).obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op ≫
          (One_of W₁ m).obj.map (B.map ((hT_of W₂).from T₂)).op =
          (One_of W₁ m).obj.map
            (B.map ((hT_of W₂).from T₂) ≫ (hT_of W₁).from (B.obj (T_of W₂))).op :=
        ((One_of W₁ m).obj.map_comp _ _).symm.trans
          (congrArg (One_of W₁ m).obj.map (CategoryTheory.op_comp (f := _) (g := _)).symm)
      have h_term : hT₁.from (B.obj T₂) ≫ (hT_of W₁).from T₁ =
          B.map ((hT_of W₂).from T₂) ≫ (hT_of W₁).from (B.obj (T_of W₂)) :=
        (hT_of W₁).hom_ext _ _
      have h_lhs : adj₁.unit.app R_mod ≫ (One_of W₁ m).obj.map (hT₁.from (B.obj T₂)).op =
          adj₁_std.unit.app R_mod ≫
            (One_of W₁ m).obj.map (hT₁.from (B.obj T₂) ≫ (hT_of W₁).from T₁).op :=
        (congrArg (· ≫ (One_of W₁ m).obj.map (hT₁.from (B.obj T₂)).op) hu).trans
          ((Category.assoc _ _ _).trans (congrArg (adj₁_std.unit.app R_mod ≫ ·) hm1))
      have h_rhs : (adj₁_std.unit.app R_mod ≫
            (One_of W₁ m).obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op) ≫
            (f_push.obj (One_of W₁ m)).obj.map ((hT_of W₂).from T₂).op =
          adj₁_std.unit.app R_mod ≫
            (One_of W₁ m).obj.map
              (B.map ((hT_of W₂).from T₂) ≫ (hT_of W₁).from (B.obj (T_of W₂))).op :=
        (Category.assoc (adj₁_std.unit.app R_mod)
          ((One_of W₁ m).obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op)
          ((One_of W₁ m).obj.map (B.map ((hT_of W₂).from T₂)).op)).trans
          (congrArg (adj₁_std.unit.app R_mod ≫ ·) hm2)
      exact h_lhs.trans
        ((congrArg (fun k => adj₁_std.unit.app R_mod ≫ (One_of W₁ m).obj.map k.op) h_term).trans
          h_rhs.symm)

    have hq_c_nat : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (B : W₂.Etale ⥤ W₁.Etale)
        [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology],
        q_mod_std B m₁ ≫ push_c_of B =
        c_of W₂ ≫ (ρ_of W₂).map (q_mod_std B m₀) := by
      intro W₁ W₂ B _
      let f_push₁ := B.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      let f_push₀ := B.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      let adj₁_1 := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology
        (ModuleCat.{u, u} R₁) (hT_of W₁)
      let adj₁_0 := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology
        (ModuleCat.{u, u} R₀) (hT_of W₁)
      let adj₂_1 := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology
        (ModuleCat.{u, u} R₁) (hT_of W₂)
      let adj₂_0 := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology
        (ModuleCat.{u, u} R₀) (hT_of W₂)
