        have h_ιS_unit : adj_ab_S.unit.app Aℤ ≫ (ιℤ_std S m₁).hom.app (Opposite.op (T_of S)) =
            z_to_m_of m₁ ≫ ιM_of m₁ ≫ u₀_of S m₁ :=
          (Adjunction.homEquiv_unit adj_ab_S Aℤ ((U_of S m₁).obj (One_of S m₁))
            (ιℤ_std S m₁)).symm.trans (h_ιℤ_std_ev S m₁)
        have hR1 : adj_ab_Y.homEquiv Aℤ ((U_of Y m₁).obj (si_push₁.obj (One_of S m₁)))
            (ιℤ_std Y m₁ ≫ (U_of Y m₁).map (q_mod_std B_si m₁)) =
            (z_to_m_of m₁ ≫ ιM_of m₁ ≫ u₀_of Y m₁) ≫
              Fgt₁.map ((q_mod_std B_si m₁).hom.app (Opposite.op (T_of Y))) := by
          rw [Adjunction.homEquiv_naturality_right adj_ab_Y (ιℤ_std Y m₁) _,
            h_ιℤ_std_ev Y m₁]
          rfl
        have hq_ev : adj_mod_Y.unit.app R₁_mod ≫
            (q_mod_std B_si m₁).hom.app (Opposite.op (T_of Y)) =
            adj_mod_S.unit.app R₁_mod ≫ (One_of S m₁).obj.map τ_si.op :=
          (Adjunction.homEquiv_unit adj_mod_Y R₁_mod (si_push₁.obj (One_of S m₁))
            (q_mod_std B_si m₁)).symm.trans (Equiv.apply_symm_apply _ _)
        have h_uY : u₀_of Y m₁ ≫ Fgt₁.map ((q_mod_std B_si m₁).hom.app (Opposite.op (T_of Y))) =
            u₀_of S m₁ ≫ ((U_of S m₁).obj (One_of S m₁)).obj.map τ_si.op :=
          (Fgt₁.map_comp _ _).symm.trans ((congrArg Fgt₁.map hq_ev).trans (Fgt₁.map_comp _ _))
        have h_lhs_chain :
            (adj_ab_S.unit.app Aℤ ≫ Fℤ_S.obj.map τ_si.op) ≫
