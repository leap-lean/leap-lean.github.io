      _ = (ιℤ_p ≫ η_p.inv.app (Cℤ₂.obj Aℤ)) ≫ (π_ab Aℤ ≫ ηℤ₁) ≫
            U₁.map e_unit.hom ≫ e_comm.hom.app one₂ := by
            simp only [CategoryTheory.Category.assoc]
      _ = (ιℤ_p ≫ η_p.inv.app (Cℤ₂.obj Aℤ)) ≫
            (P_pull_ab.map ηℤ₂ ≫ e_comm.inv.app one₂ ≫ U₁.map e_unit.inv) ≫
            U₁.map e_unit.hom ≫ e_comm.hom.app one₂ := h1
      _ = (ιℤ_p ≫ η_p.inv.app (Cℤ₂.obj Aℤ)) ≫ P_pull_ab.map ηℤ₂ ≫
            e_comm.inv.app one₂ ≫ (U₁.map e_unit.inv ≫ U₁.map e_unit.hom) ≫
            e_comm.hom.app one₂ := by simp only [CategoryTheory.Category.assoc]
      _ = (ιℤ_p ≫ η_p.inv.app (Cℤ₂.obj Aℤ)) ≫ P_pull_ab.map ηℤ₂ := by
            rw [h_u_inv_hom, CategoryTheory.Category.id_comp, h_e_inv_hom,
