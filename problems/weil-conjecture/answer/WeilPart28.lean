      have hm₁ : GeomLiftMap ξ π₁ δ₁₂ = δ₁ :=
        Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hm₂ : GeomLiftMap ξ π₂ δ₁₂ = δ₂ :=
        Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      change (x f₁ hf₁ : GeomLifts ξ V₁ → ↑A) (GeomLiftMap ξ π₁ δ₁₂) =
        (x f₂ hf₂ : GeomLifts ξ V₂ → ↑A) (GeomLiftMap ξ π₂ δ₁₂) at h_compat
      exact (congrArg (x f₁ hf₁) hm₁.symm).trans (h_compat.trans (congrArg (x f₂ hf₂) hm₂))
