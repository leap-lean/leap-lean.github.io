    (Z J : ℕ → C₂) (hZ0 : Z 0 = one₂)
    (hInj₂ : ∀ k : ℕ, CategoryTheory.Injective (J k))
    (hInj₁ : ∀ k : ℕ, CategoryTheory.Injective (P_push.obj (J k)))
    (ι_Z : ∀ k : ℕ, Quiver.Hom (Z k) (J k))
    (π_Z : ∀ k : ℕ, Quiver.Hom (J k) (Z (k + 1)))
    (hz_Z : ∀ k : ℕ, CategoryTheory.CategoryStruct.comp (ι_Z k) (π_Z k) = 0)
    (hEx_Z : ∀ k : ℕ, (CategoryTheory.ShortComplex.mk (ι_Z k) (π_Z k) (hz_Z k)).ShortExact)
    (η : ∀ q : ℕ, CategoryTheory.Abelian.Ext.{u} (Z q) one₂ q)
    (hη0 : η 0 = CategoryTheory.Abelian.Ext.mk₀ (eqToHom hZ0))
    (hηSucc : ∀ k : ℕ, η (k + 1) = ((hEx_Z k).extClass).comp (η k) (Nat.one_add k))
    (g_tilde : ∀ q : ℕ, Fin (b q) → Quiver.Hom one₂ (Z q))
    (hg_tilde : ∀ (q : ℕ) (t : Fin (b q)),
      (CategoryTheory.Abelian.Ext.mk₀ (g_tilde q t)).comp (η q) (Nat.zero_add q) = w₂ q t)
    (E₁ : ℕ → C₁)
    (proj₁ : ∀ q : ℕ, Fin (b q) → Quiver.Hom (E₁ q) one₁)
    (B₁ H₁ : ℕ → C₁)
    (p_img : ∀ k : ℕ, Quiver.Hom (P_push.obj (J k)) (B₁ k))
    (j_B : ∀ k : ℕ, Quiver.Hom (B₁ k) (P_push.obj (Z (k + 1))))
    (q_H : ∀ k : ℕ, Quiver.Hom (P_push.obj (Z (k + 1))) (H₁ k))
    (hz_B : ∀ k : ℕ, CategoryTheory.CategoryStruct.comp (j_B k) (q_H k) = 0)
    (hEpi_p : ∀ k : ℕ, CategoryTheory.Epi (p_img k))
    (hFac_B : ∀ k : ℕ, CategoryTheory.CategoryStruct.comp (p_img k) (j_B k) = P_push.map (π_Z k))
