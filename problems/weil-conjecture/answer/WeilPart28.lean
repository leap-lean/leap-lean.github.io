      have : UniversallyInjective M := hMono_univInj M
      have hsnd_Q : Function.Injective (Limits.pullback.snd (fr U hU) (i₂ ≫ fst_pb)).base := by
        have hpQ := (IsPullback.of_hasPullback (fr U hU) (i₂ ≫ fst_pb)).flip
        exact (universallyInjective_iff (fr U hU)).mp (hUnivInj_fr U hU) _ _ _ hpQ
      change Function.Injective f'.base
      rw [← hM_snd]
