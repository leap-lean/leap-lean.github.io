       ∀ (α : CategoryTheory.Abelian.Ext.{u} One_mod One_mod a)
         (β : CategoryTheory.Abelian.Ext.{u} One_mod One_mod b),
         α.comp β hab = ((-1 : ℤ) ^ (a * b)) • (β.comp α hba)) →
      ∀ (cup_ab : weilEtaleTorsionH W m a →+ weilEtaleTorsionH W m b →+ weilEtaleTorsionH W m c)
        (cup_ba : weilEtaleTorsionH W m b →+ weilEtaleTorsionH W m a →+ weilEtaleTorsionH W m c),
        WeilLefschetzIsTorsionCup W m a b c hab cup_ab →
        WeilLefschetzIsTorsionCup W m b a c hba cup_ba →
        ∀ (u : weilEtaleTorsionH W m a) (v : weilEtaleTorsionH W m b),
          cup_ab u v = ((-1 : ℤ) ^ (a * b)) • cup_ba v u) :=
