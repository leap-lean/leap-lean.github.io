           (θ₂ : weilEtaleModuleH W₂ m₀ q →+ weilEtaleTorsionH W₂ m₀ q)
           (p : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q),
