      refine (CategoryTheory.Adjunction.homEquiv_naturality_right adj_g
        (θ_BC.app One_Z) (i'_push.map π_Z)).trans ?_
      exact (congrArg (· ≫ g_push.map (i'_push.map π_Z)) h_th).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (i_push.map (adj_gZ.unit.app One_Z) ≫ ·) hγ.symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ γ_sq.inv.app One_Z')
                ((i_push.map_comp _ _).symm.trans (congrArg i_push.map huZ))))))
    have hStep1_R : adj_g.homEquiv One_Y (i'_push.obj One_Z') (π_Y ≫ q_i') =
        u_Y ≫ g_push.map q_i' := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      dsimp only [π_Y]
      rw [Equiv.apply_symm_apply]
    rw [hStep1_L, hStep1_R]
    apply (adj_Y.homEquiv R_mod (g_push.obj (i'_push.obj One_Z'))).injective
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
      CategoryTheory.Adjunction.homEquiv_naturality_right]
    dsimp only [q_i, u_Y]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    have huZ_app : adj_Z.unit.app R_mod ≫ u_Z.hom.app (Opposite.op T_Z) =
        adj_Z'.unit.app R_mod ≫ One_Z'.obj.map (hT_Z'.from (B_gZ.obj T_Z)).op := by
      have h := (adj_Z.homEquiv R_mod (gZ_push.obj One_Z')).apply_symm_apply
        (adj_Z'.unit.app R_mod ≫ One_Z'.obj.map (hT_Z'.from (B_gZ.obj T_Z)).op)
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h
      exact h
    have hqi'_app : adj_Y'.unit.app R_mod ≫ q_i'.hom.app (Opposite.op T_Y') =
        adj_Z'.unit.app R_mod ≫ One_Z'.obj.map (hT_Z'.from (B_i'.obj T_Y')).op := by
      have h := (adj_Y'.homEquiv R_mod (i'_push.obj One_Z')).apply_symm_apply
        (adj_Z'.unit.app R_mod ≫ One_Z'.obj.map (hT_Z'.from (B_i'.obj T_Y')).op)
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h
      exact h
    have hγ_app : (γ_sq.inv.app One_Z').hom.app (Opposite.op T_Y) =
        One_Z'.obj.map (e_sq.inv.app T_Y).op :=
      (congrArg (· ≫ 𝟙 _)
        (CategoryTheory.Category.id_comp (One_Z'.obj.map (e_sq.inv.app T_Y).op))).trans
        (CategoryTheory.Category.comp_id _)
    have h_nat_uZ : One_Z.obj.map (hT_Z.from (B_i.obj T_Y)).op ≫
        u_Z.hom.app (Opposite.op (B_i.obj T_Y)) =
        u_Z.hom.app (Opposite.op T_Z) ≫
          One_Z'.obj.map (B_gZ.map (hT_Z.from (B_i.obj T_Y))).op :=
      u_Z.hom.naturality (hT_Z.from (B_i.obj T_Y)).op
    have h_nat_qi' : One_Y'.obj.map (hT_Y'.from (B_g.obj T_Y)).op ≫
        q_i'.hom.app (Opposite.op (B_g.obj T_Y)) =
        q_i'.hom.app (Opposite.op T_Y') ≫
          One_Z'.obj.map (B_i'.map (hT_Y'.from (B_g.obj T_Y))).op :=
      q_i'.hom.naturality (hT_Y'.from (B_g.obj T_Y)).op
    have hStep2_L : (adj_Z.unit.app R_mod ≫ One_Z.obj.map (hT_Z.from (B_i.obj T_Y)).op) ≫
        ((CategoryTheory.sheafSections Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj
          (Opposite.op T_Y)).map (i_push.map u_Z ≫ γ_sq.inv.app One_Z') =
        adj_Z'.unit.app R_mod ≫
          One_Z'.obj.map (e_sq.inv.app T_Y ≫ B_gZ.map (hT_Z.from (B_i.obj T_Y)) ≫
            hT_Z'.from (B_gZ.obj T_Z)).op := by
      change (adj_Z.unit.app R_mod ≫ One_Z.obj.map (hT_Z.from (B_i.obj T_Y)).op) ≫
          (u_Z.hom.app (Opposite.op (B_i.obj T_Y)) ≫ (γ_sq.inv.app One_Z').hom.app (Opposite.op T_Y)) = _
      have hm : (One_Z'.obj.map (hT_Z'.from (B_gZ.obj T_Z)).op ≫
          One_Z'.obj.map (B_gZ.map (hT_Z.from (B_i.obj T_Y))).op) ≫
          One_Z'.obj.map (e_sq.inv.app T_Y).op =
          One_Z'.obj.map (e_sq.inv.app T_Y ≫ B_gZ.map (hT_Z.from (B_i.obj T_Y)) ≫
            hT_Z'.from (B_gZ.obj T_Z)).op := by
        rw [← One_Z'.obj.map_comp, ← One_Z'.obj.map_comp,
          ← CategoryTheory.op_comp, ← CategoryTheory.op_comp]
      exact (congrArg ((adj_Z.unit.app R_mod ≫ One_Z.obj.map (hT_Z.from (B_i.obj T_Y)).op) ≫ ·)
          (congrArg (u_Z.hom.app (Opposite.op (B_i.obj T_Y)) ≫ ·) hγ_app)).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ One_Z'.obj.map (e_sq.inv.app T_Y).op)
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (adj_Z.unit.app R_mod ≫ ·) h_nat_uZ).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ _) huZ_app).trans
                    (CategoryTheory.Category.assoc _ _ _)))))).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (adj_Z'.unit.app R_mod ≫ ·) hm))))
    have hStep2_R : (adj_Y'.unit.app R_mod ≫ One_Y'.obj.map (hT_Y'.from (B_g.obj T_Y)).op) ≫
        ((CategoryTheory.sheafSections Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj
          (Opposite.op T_Y)).map (g_push.map q_i') =
        adj_Z'.unit.app R_mod ≫
          One_Z'.obj.map (B_i'.map (hT_Y'.from (B_g.obj T_Y)) ≫ hT_Z'.from (B_i'.obj T_Y')).op := by
      change (adj_Y'.unit.app R_mod ≫ One_Y'.obj.map (hT_Y'.from (B_g.obj T_Y)).op) ≫
          q_i'.hom.app (Opposite.op (B_g.obj T_Y)) = _
      have hm : One_Z'.obj.map (hT_Z'.from (B_i'.obj T_Y')).op ≫
          One_Z'.obj.map (B_i'.map (hT_Y'.from (B_g.obj T_Y))).op =
          One_Z'.obj.map (B_i'.map (hT_Y'.from (B_g.obj T_Y)) ≫ hT_Z'.from (B_i'.obj T_Y')).op := by
        rw [← One_Z'.obj.map_comp, ← CategoryTheory.op_comp]
      exact (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (adj_Y'.unit.app R_mod ≫ ·) h_nat_qi').trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ _) hqi'_app).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                (congrArg (adj_Z'.unit.app R_mod ≫ ·) hm)))))
    have h_term :
        (e_sq.inv.app T_Y ≫ B_gZ.map (hT_Z.from (B_i.obj T_Y)) ≫ hT_Z'.from (B_gZ.obj T_Z) :
          B_i'.obj (B_g.obj T_Y) ⟶ T_Z') =
        B_i'.map (hT_Y'.from (B_g.obj T_Y)) ≫ hT_Z'.from (B_i'.obj T_Y') :=
      hT_Z'.hom_ext _ _
    exact hStep2_L.trans
      ((congrArg (fun (k : B_i'.obj (B_g.obj T_Y) ⟶ T_Z') =>
        adj_Z'.unit.app R_mod ≫ One_Z'.obj.map k.op) h_term).trans
        hStep2_R.symm)

theorem weil_gysin_closed_immersion_exact_and_gysin_comp (hSite : WeilGysinSuppCalcHasExactPullbacks.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (τ_iso : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
      [CategoryTheory.IsIso i] (r : ℕ), WeilGysinSupportClass Z Y i (ℓ ^ r) 0)
    (hIsoUnit : WeilGysinSuppCalcIsIsoUnit.{u} ℓ (@τ_iso)) :
    WeilGysinSuppCalcClosedExactAb.{u} ∧
    (∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
        {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
        (hsi : CategoryTheory.CategoryStruct.comp s i = si),
        AlgebraicGeometry.IsClosedImmersion s →
        AlgebraicGeometry.IsClosedImmersion i →
        AlgebraicGeometry.IsClosedImmersion si →
        ∀ {r a b c : ℕ} (hab : a + b = c)
          (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
          (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b),
          ∃! τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c,
            WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY) ∧
    (∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
      {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
      [CategoryTheory.IsIso s]
      (hsi : CategoryTheory.CategoryStruct.comp s i = si),
      AlgebraicGeometry.IsClosedImmersion i →
      AlgebraicGeometry.IsClosedImmersion si →
      ∀ (r b : ℕ)
        (τ_step : WeilGysinSupportClass Z Y i (ℓ ^ r) b)
        (τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) b),
        WeilGysinSupportPullback (CategoryTheory.CategoryStruct.id Y) i si (ℓ ^ r) b
          τ_step τ_SY →
        WeilGysinSupportGysinComp hsi (Nat.zero_add b) (τ_iso s r) τ_step τ_SY) ∧
    (∀ {S Z : AlgebraicGeometry.Scheme.{u}}
      {s : Quiver.Hom S Z} {i : Quiver.Hom Z Z}
      [CategoryTheory.IsIso i]
      (_hi_eq : i = CategoryTheory.CategoryStruct.id Z)
      (hsi : CategoryTheory.CategoryStruct.comp s i = s),
      AlgebraicGeometry.IsClosedImmersion s →
      ∀ (r a : ℕ) (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a),
        WeilGysinSupportGysinComp hsi (Nat.add_zero a) τ_Z (τ_iso i r) τ_Z) ∧
    (∀ {S Z₁ Z₂ Y : AlgebraicGeometry.Scheme.{u}}
      {s : Quiver.Hom S Z₁} {i₁ : Quiver.Hom Z₁ Z₂} {i₂ : Quiver.Hom Z₂ Y}
      {s₁ : Quiver.Hom S Z₂} {i₁₂ : Quiver.Hom Z₁ Y} {sy : Quiver.Hom S Y}
      (hs₁ : CategoryTheory.CategoryStruct.comp s i₁ = s₁)
      (hi₁₂ : CategoryTheory.CategoryStruct.comp i₁ i₂ = i₁₂)
      (hsy₁ : CategoryTheory.CategoryStruct.comp s₁ i₂ = sy)
      (hsy₂ : CategoryTheory.CategoryStruct.comp s i₁₂ = sy),
      AlgebraicGeometry.IsClosedImmersion s →
      AlgebraicGeometry.IsClosedImmersion i₁ →
      AlgebraicGeometry.IsClosedImmersion i₂ →
      AlgebraicGeometry.IsClosedImmersion s₁ →
      AlgebraicGeometry.IsClosedImmersion i₁₂ →
      AlgebraicGeometry.IsClosedImmersion sy →
      ∀ {r a b c ab bc abc : ℕ}
        (hab : a + b = ab) (hbc : b + c = bc)
        (hab_c : ab + c = abc) (ha_bc : a + bc = abc)
        (τ_S : WeilGysinSupportClass S Z₁ s (ℓ ^ r) a)
        (τ_Z₁ : WeilGysinSupportClass Z₁ Z₂ i₁ (ℓ ^ r) b)
        (τ_Z₂ : WeilGysinSupportClass Z₂ Y i₂ (ℓ ^ r) c)
        (τ_SZ₂ : WeilGysinSupportClass S Z₂ s₁ (ℓ ^ r) ab)
        (τ_Z₁Y : WeilGysinSupportClass Z₁ Y i₁₂ (ℓ ^ r) bc)
        (τ_L τ_R : WeilGysinSupportClass S Y sy (ℓ ^ r) abc),
        WeilGysinSupportGysinComp hs₁ hab τ_S τ_Z₁ τ_SZ₂ →
        WeilGysinSupportGysinComp hi₁₂ hbc τ_Z₁ τ_Z₂ τ_Z₁Y →
        WeilGysinSupportGysinComp hsy₁ hab_c τ_SZ₂ τ_Z₂ τ_L →
        WeilGysinSupportGysinComp hsy₂ ha_bc τ_S τ_Z₁Y τ_R →
        τ_L = τ_R) ∧
    (∀ {S' Z' Y' S Z Y : AlgebraicGeometry.Scheme.{u}}
      {s' : Quiver.Hom S' Z'} {i' : Quiver.Hom Z' Y'} {si' : Quiver.Hom S' Y'}
      {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
      (hsi' : CategoryTheory.CategoryStruct.comp s' i' = si')
      (hsi : CategoryTheory.CategoryStruct.comp s i = si)
      (g_S : Quiver.Hom S' S) (g_Z : Quiver.Hom Z' Z) (g : Quiver.Hom Y' Y),
      AlgebraicGeometry.IsClosedImmersion s →
      AlgebraicGeometry.IsClosedImmersion i →
      AlgebraicGeometry.IsClosedImmersion si →
      AlgebraicGeometry.IsClosedImmersion s' →
      AlgebraicGeometry.IsClosedImmersion i' →
      AlgebraicGeometry.IsClosedImmersion si' →
      CategoryTheory.IsPullback i' g_Z g i →
      CategoryTheory.IsPullback s' g_S g_Z s →
      ∀ {r a b c : ℕ} (hab : a + b = c)
        (τ'_Z : WeilGysinSupportClass S' Z' s' (ℓ ^ r) a)
        (τ'_Y : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) b)
        (τ'_SY : WeilGysinSupportClass S' Y' si' (ℓ ^ r) c)
        (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
        (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b)
        (τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c),
        WeilGysinSupportPullback g_Z s' s (ℓ ^ r) a τ'_Z τ_Z →
        WeilGysinSupportPullback g i' i (ℓ ^ r) b τ'_Y τ_Y →
        WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY →
        WeilGysinSupportGysinComp hsi' hab τ'_Z τ'_Y τ'_SY →
        WeilGysinSupportPullback g si' si (ℓ ^ r) c τ'_SY τ_SY) :=
by
  
  have hLift : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
      AlgebraicGeometry.IsClosedImmersion i →
      ∀ (W : Y.Etale) [AlgebraicGeometry.IsAffine W.left]
        (V_Z : Z.Etale) [AlgebraicGeometry.IsAffine V_Z.left]
        (α : Quiver.Hom V_Z ((weilEtaleSitePullback i).obj W)),
        ∃ (W' : Y.Etale) (_ : AlgebraicGeometry.IsAffine W'.left)
          (f : Quiver.Hom W' W)
          (e : CategoryTheory.Iso V_Z ((weilEtaleSitePullback i).obj W')),
          CategoryTheory.CategoryStruct.comp e.hom ((weilEtaleSitePullback i).map f) = α := by
    have hRingLift : ∀ (A B_bar S_bar : Type u) [CommRing A] [CommRing B_bar] [CommRing S_bar]
        (π : A →+* B_bar) (_h_surj : Function.Surjective π) (φ_bar : B_bar →+* S_bar),
        φ_bar.Etale →
        ∃ (S_tilde : Type u) (_ : CommRing S_tilde) (_ : Algebra A S_tilde) (ψ : S_tilde →+* S_bar),
          Algebra.Etale A S_tilde ∧
          CategoryTheory.IsPushout
            (CommRingCat.ofHom π) (CommRingCat.ofHom (algebraMap A S_tilde))
            (CommRingCat.ofHom φ_bar) (CommRingCat.ofHom ψ) := by
      intro A B_bar S_bar _ _ _ π h_surj φ_bar hEt_bar
      classical
      let _ : Algebra A B_bar := π.toAlgebra
      let _ : Algebra B_bar S_bar := φ_bar.toAlgebra
      let _ : Algebra A S_bar := (φ_bar.comp π).toAlgebra
      have _ : IsScalarTower A B_bar S_bar := IsScalarTower.of_algebraMap_eq' rfl
      have hEt_alg : Algebra.Etale B_bar S_bar := hEt_bar
      have hStd : Algebra.IsStandardSmoothOfRelativeDimension 0 B_bar S_bar :=
        (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero).mp hEt_alg
      obtain ⟨ι, σ, hFin_σ, hFin_ι, P, hP_dim⟩ := hStd.out
      let _ : Finite σ := hFin_σ
      let _ : Finite ι := hFin_ι
      let _ : Fintype σ := Fintype.ofFinite σ
      have _ : P.toPresentation.HasCoeffs A :=
        Algebra.Presentation.HasCoeffs.mk (by
          change P.toPresentation.coeffs ⊆ Set.range ⇑π
          rw [h_surj.range_eq]
          exact Set.subset_univ _)
      let M₀ : Type u := P.toPresentation.ModelOfHasCoeffs A
      let P₀ : Algebra.PreSubmersivePresentation A M₀ ι σ :=
        P.toPreSubmersivePresentation.ofHasCoeffs A
      let Δ : M₀ := P₀.jacobian
      let S_tilde : Type u := Localization.Away Δ
      let Q₀ : Algebra.PreSubmersivePresentation M₀ S_tilde Unit Unit :=
        Algebra.PreSubmersivePresentation.localizationAway S_tilde Δ
      let R₀ : Algebra.PreSubmersivePresentation A S_tilde (Unit ⊕ ι) (Unit ⊕ σ) :=
        Q₀.comp P₀
      have hR₀_jac_unit : IsUnit R₀.jacobian := by
        have hjac : R₀.jacobian = Δ • Q₀.jacobian :=
          Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian Q₀ P₀
        have hQjac : Q₀.jacobian = algebraMap M₀ S_tilde Δ :=
          Algebra.PreSubmersivePresentation.localizationAway_jacobian (S := S_tilde) Δ
        rw [hjac, hQjac]
        have hsmul : Δ • algebraMap M₀ S_tilde Δ =
            algebraMap M₀ S_tilde Δ * algebraMap M₀ S_tilde Δ :=
          Algebra.smul_def Δ (algebraMap M₀ S_tilde Δ)
        rw [hsmul]
        exact (IsLocalization.Away.algebraMap_isUnit (S := S_tilde) Δ).mul
          (IsLocalization.Away.algebraMap_isUnit (S := S_tilde) Δ)
      let R_sub : Algebra.SubmersivePresentation A S_tilde (Unit ⊕ ι) (Unit ⊕ σ) :=
        { toPreSubmersivePresentation := R₀
          jacobian_isUnit := hR₀_jac_unit }
      have hR_dim : R_sub.dimension = 0 := by
        have h_inj : Function.Injective P.map := P.map_inj
        have h_le : Nat.card σ ≤ Nat.card ι := Nat.card_le_card_of_injective P.map h_inj
        have h_dimP : Nat.card ι - Nat.card σ = 0 := hP_dim
        have h_eq_card : Nat.card ι = Nat.card σ := by omega
        change Nat.card (Unit ⊕ ι) - Nat.card (Unit ⊕ σ) = 0
        simp [Nat.card_sum, h_eq_card]
      have hEt_tilde : Algebra.Etale A S_tilde :=
        (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero).mpr
          (R_sub.isStandardSmoothOfRelativeDimension hR_dim)
      let e_M : TensorProduct A B_bar M₀ ≃ₐ[B_bar] S_bar :=
        P.toPresentation.tensorModelOfHasCoeffsEquiv A
      have heM_Δ : e_M ((1 : B_bar) ⊗ₜ[A] Δ) = P.jacobian := by
        let M_mat₀ : Matrix σ σ (MvPolynomial ι A) :=
          Matrix.of fun i j => MvPolynomial.pderiv (P.map j) (P.toPresentation.relationOfHasCoeffs A i)
        let M_mat : Matrix σ σ (MvPolynomial ι B_bar) :=
          Matrix.of fun i j => MvPolynomial.pderiv (P.map j) (P.relation i)
        have hdet_P₀ : LinearMap.det P₀.differential =
            ((LinearMap.toMatrix P₀.basis P₀.basis) P₀.differential).det :=
          (LinearMap.det_toMatrix P₀.basis P₀.differential).symm
        have hdet_P : LinearMap.det P.differential =
            ((LinearMap.toMatrix P.basis P.basis) P.differential).det :=
          (LinearMap.det_toMatrix P.basis P.differential).symm
        have hmat_map : M_mat₀.map (MvPolynomial.map (algebraMap A B_bar)) = M_mat := by
          apply Matrix.ext
          intro i j
          simp only [M_mat₀, M_mat, Matrix.map_apply, Matrix.of_apply]
          rw [← MvPolynomial.pderiv_map]
          congr 1
          exact P.toPresentation.map_relationOfHasCoeffs A i
        have h_toMat₀ : (LinearMap.toMatrix P₀.basis P₀.basis) P₀.differential = M_mat₀.transpose := by
          apply Matrix.ext
          intro i j
          rw [LinearMap.toMatrix_apply, Matrix.transpose_apply]
          dsimp only [M_mat₀, Matrix.of_apply]
          change (P₀.differential (Pi.single j 1)) i = _
          simp only [Algebra.PreSubmersivePresentation.differential, Module.Basis.constr_apply_fintype,
            Module.Basis.equivFun_apply, Pi.basisFun_repr, Finset.sum_apply]
          rw [Fintype.sum_eq_single j (fun x hx => by rw [Pi.single_eq_of_ne hx, zero_smul, Pi.zero_apply]),
            Pi.single_eq_same, one_smul]
          rfl
        have h_toMat : (LinearMap.toMatrix P.basis P.basis) P.differential = M_mat.transpose := by
          apply Matrix.ext
          intro i j
          rw [LinearMap.toMatrix_apply, Matrix.transpose_apply]
          dsimp only [M_mat, Matrix.of_apply]
          change (P.differential (Pi.single j 1)) i = _
          simp only [Algebra.PreSubmersivePresentation.differential, Module.Basis.constr_apply_fintype,
            Module.Basis.equivFun_apply, Pi.basisFun_repr, Finset.sum_apply]
          rw [Fintype.sum_eq_single j (fun x hx => by rw [Pi.single_eq_of_ne hx, zero_smul, Pi.zero_apply]),
            Pi.single_eq_same, one_smul]
        have hΔ_eq : Δ = Ideal.Quotient.mk
            (Ideal.span (Set.range (P.toPresentation.relationOfHasCoeffs A)))
            (LinearMap.det P₀.differential) := rfl
        rw [hΔ_eq, Algebra.Presentation.tensorModelOfHasCoeffsEquiv_tmul A 1, map_one, one_mul]
        change MvPolynomial.aeval P.val (LinearMap.det P₀.differential) =
          (algebraMap P.Ring S_bar) (LinearMap.det P.differential)
        have haeval_map : MvPolynomial.aeval P.val (LinearMap.det P₀.differential) =
            MvPolynomial.aeval P.val
              (MvPolynomial.map (algebraMap A B_bar) (LinearMap.det P₀.differential)) :=
          (MvPolynomial.aeval_map_algebraMap B_bar P.val (LinearMap.det P₀.differential)).symm
        rw [haeval_map, hdet_P₀, h_toMat₀, Matrix.det_transpose,
          RingHom.map_det (MvPolynomial.map (algebraMap A B_bar)) M_mat₀,
          RingHom.mapMatrix_apply, hmat_map,
          hdet_P, h_toMat, Matrix.det_transpose]
        exact (Algebra.Generators.algebraMap_apply P.toGenerators M_mat.det).symm
      have hu_bar : IsUnit (e_M ((1 : B_bar) ⊗ₜ[A] Δ)) := by
        rw [heM_Δ]
        exact P.jacobian_isUnit
      obtain ⟨M₁, hComm_M₁, hAlg_M₁, Δ₁, S₁, hComm_S₁, hAlg_M₁_S₁, hLoc_Δ₁,
