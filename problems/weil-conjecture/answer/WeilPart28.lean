    have hGysSplice : ∀ (B_s : Z.Etale ⥤ S.Etale) (B_i : Y.Etale ⥤ Z.Etale)
        (B_si : Y.Etale ⥤ S.Etale)
        [B_s.IsContinuous Z.smallEtaleTopology S.smallEtaleTopology]
        [B_i.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology]
        [B_si.IsContinuous Y.smallEtaleTopology S.smallEtaleTopology],
        Limits.PreservesFiniteColimits
          (B_si.sheafPushforwardContinuous AddCommGrpCat.{u}
            Y.smallEtaleTopology S.smallEtaleTopology) →
        Epi (q_ab_std B_si) →
        let s_push₁ := B_s.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
          Z.smallEtaleTopology S.smallEtaleTopology
        let s_push₀ := B_s.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
          Z.smallEtaleTopology S.smallEtaleTopology
        let i_push₁ := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
          Y.smallEtaleTopology Z.smallEtaleTopology
        let i_push₀ := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
          Y.smallEtaleTopology Z.smallEtaleTopology
        let si_push₁ := B_si.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
          Y.smallEtaleTopology S.smallEtaleTopology
        let si_push₀ := B_si.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
          Y.smallEtaleTopology S.smallEtaleTopology
        ∀ (_ : i_push₁.Additive) (_ : Limits.PreservesFiniteLimits i_push₁)
          (_ : Limits.PreservesFiniteColimits i_push₁)
          (_ : i_push₀.Additive) (_ : Limits.PreservesFiniteLimits i_push₀)
          (_ : Limits.PreservesFiniteColimits i_push₀)
          (α_push₁ : si_push₁.obj (One_of S m₁) ⟶ i_push₁.obj (s_push₁.obj (One_of S m₁)))
          (α_push₀ : si_push₀.obj (One_of S m₀) ⟶ i_push₀.obj (s_push₀.obj (One_of S m₀)))
          (vZ₁ : Abelian.Ext.{u} (s_push₁.obj (One_of S m₁)) (One_of Z m₁) a)
          (vZ₀ : Abelian.Ext.{u} (s_push₀.obj (One_of S m₀)) (One_of Z m₀) a)
          (vY₁ : Abelian.Ext.{u} (i_push₁.obj (One_of Z m₁)) (One_of Y m₁) b)
          (vY₀ : Abelian.Ext.{u} (i_push₀.obj (One_of Z m₀)) (One_of Y m₀) b)
          (vSY₁ : Abelian.Ext.{u} (si_push₁.obj (One_of S m₁)) (One_of Y m₁) c)
          (vSY₀ : Abelian.Ext.{u} (si_push₀.obj (One_of S m₀)) (One_of Y m₀) c),
          q_mod_std B_si m₁ ≫ α_push₁ = q_mod_std B_i m₁ ≫ i_push₁.map (q_mod_std B_s m₁) →
          q_mod_std B_si m₀ ≫ α_push₀ = q_mod_std B_i m₀ ≫ i_push₀.map (q_mod_std B_s m₀) →
          vSY₁ = ((Abelian.Ext.mk₀ α_push₁).comp
            (Abelian.Ext.mapExactFunctor i_push₁ vZ₁) (Nat.zero_add a)).comp vY₁ hab →
          vSY₀ = ((Abelian.Ext.mk₀ α_push₀).comp
            (Abelian.Ext.mapExactFunctor i_push₀ vZ₀) (Nat.zero_add a)).comp vY₀ hab →
          vZ₁.comp (Abelian.Ext.mk₀ (c_of Z)) (Nat.add_zero a) =
            (Abelian.Ext.mk₀ (push_c_of B_s)).comp
              (Abelian.Ext.mapExactFunctor (ρ_of Z) vZ₀) (Nat.zero_add a) →
          vY₁.comp (Abelian.Ext.mk₀ (c_of Y)) (Nat.add_zero b) =
            (Abelian.Ext.mk₀ (push_c_of B_i)).comp
              (Abelian.Ext.mapExactFunctor (ρ_of Y) vY₀) (Nat.zero_add b) →
          vSY₁.comp (Abelian.Ext.mk₀ (c_of Y)) (Nat.add_zero c) =
            (Abelian.Ext.mk₀ (push_c_of B_si)).comp
              (Abelian.Ext.mapExactFunctor (ρ_of Y) vSY₀) (Nat.zero_add c) := by
      intro B_s B_i B_si _ _ _ hColim_si_ab hEpi_q_si_ab
        s_push₁ s_push₀ i_push₁ i_push₀ si_push₁ si_push₀
        _ _ _ _ _ _ α_push₁ α_push₀ vZ₁ vZ₀ vY₁ vY₀ vSY₁ vSY₀
        hq_α₁ hq_α₀ hvSY₁ hvSY₀ hMod_Z hMod_Y
      have _ : EnoughInjectives
