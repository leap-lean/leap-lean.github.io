            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)).comp
              ((CategoryTheory.Abelian.Ext.mapExactFunctor F y).comp
                (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero i))
              (Nat.zero_add i) := by
      intro 𝒞 𝒟 _ _ _ _ _ _ _ F G _ _ _ _ _ _ η X i
      induction i with
      | zero =>
        intro Y y
        rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply y]
        set f := CategoryTheory.Abelian.Ext.addEquiv₀ y
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        congr 1
        rw [η.hom.naturality f, ← CategoryTheory.Category.assoc,
          η.inv_hom_id_app X, CategoryTheory.Category.id_comp]
      | succ k ih =>
        intro Y y
        let ι : Y ⟶ CategoryTheory.Injective.under Y := CategoryTheory.Injective.ι Y
        let S : CategoryTheory.ShortComplex 𝒞 :=
          CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
            (CategoryTheory.Limits.cokernel.condition ι)
        have hS : S.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hzero : y.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, hz⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS y hzero rfl
        rw [← hz, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass, ih S.X₃ z]
        let Φ : S.map F ⟶ S.map G :=
          { τ₁ := η.hom.app S.X₁
            τ₂ := η.hom.app S.X₂
            τ₃ := η.hom.app S.X₃
