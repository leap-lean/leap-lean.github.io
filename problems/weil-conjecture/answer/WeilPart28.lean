        { carrier := { g | ∀ x : ↥W.left, W.hom.base x ∉ (V : Set ↥S) → g x = 0 }
          add_mem' := fun {a b} ha hb x hx => by
            rw [LocallyConstant.add_apply, ha x hx, hb x hx, add_zero]
          zero_mem' := fun _ _ => rfl
          smul_mem' := fun r {a} ha x hx => by
            rw [LocallyConstant.smul_apply, ha x hx, smul_zero] }
