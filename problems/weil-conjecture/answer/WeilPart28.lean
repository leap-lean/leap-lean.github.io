            comm₂₃ := (Category.comp_id p).symm }
        have hnat_Q := ShortComplex.ShortExact.extClass_naturality hS hS_pb φ_Q
        change hS.extClass.comp (Abelian.Ext.mk₀ u) (Nat.add_zero 1) =
          (Abelian.Ext.mk₀ (𝟙 X)).comp hS_pb.extClass (Nat.zero_add 1) at hnat_Q
        rw [Abelian.Ext.mk₀_id_comp] at hnat_Q
        exact ⟨K, Q, k, p, hk0, hS, hK, hQ, Abelian.Ext.mk₀ u, hnat_pb.symm.trans hnat_Q.symm⟩
      | succ q₀ ih =>
        intro X hX Y ξ
        let I : 𝒞 := Injective.under Y
        let ι : Y ⟶ I := Injective.ι Y
        let Q₀ : 𝒞 := Limits.cokernel ι
        let π : I ⟶ Q₀ := Limits.cokernel.π ι
        let S_inj : ShortComplex 𝒞 := ShortComplex.mk ι π (Limits.cokernel.condition ι)
        have hS_inj : S_inj.ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hzero : ξ.comp (Abelian.Ext.mk₀ S_inj.f) (Nat.add_zero (q₀ + 1 + 1)) = 0 :=
