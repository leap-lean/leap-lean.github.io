           WeilLefschetzIsEllAdicCup P ℓ i j (2 * d) hij (H_P i) (H_P j) (H_P (2 * d))
             (cup_P i j hij)) →
         ⊤ ≤ Submodule.span (Padic ℓ) { z : (H_P (2 * d)).V |
           ∃ (i j : ℕ) (hij : i + j = 2 * d) (u : (H_X i).V) (w : (H_X j).V),
             z = cup_P i j hij (fp₁ i u) (fp₂ j w) }) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have h_subsingleton_tp : ∀ {P₀ : Type u} [AddCommGroup P₀] [Subsingleton P₀]
      (L_sub : AddSubgroup P₀) {V₀ : Type u} [AddCommGroup V₀]
      (e : TensorProduct ℤ ℚ ↥L_sub ≃+ V₀) (v : V₀), v = 0 := by
