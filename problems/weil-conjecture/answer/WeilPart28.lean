            ⟨𝟙 (M_U.obj T_U), (CategoryTheory.Category.id_comp f₀).trans hf_eq.symm⟩
          rw [dif_pos hex]
          have ha_id : hex.choose = 𝟙 (M_U.obj T_U) :=
            h_f₀_mono hex.choose (𝟙 _) (hex.choose_spec.trans (hf_eq.trans
              (CategoryTheory.Category.id_comp f₀).symm))
          exact (congrArg (fun a => x₀ ≫ ℱ.obj.map a.op) ha_id).trans
            ((congrArg (x₀ ≫ ·) (ℱ.obj.map_id (Opposite.op (M_U.obj T_U)))).trans
              (CategoryTheory.Category.comp_id x₀))
        let z_true : R_mod ⟶ ℱ.obj.obj (Opposite.op (X_cov (ULift.up true))) := 0
        have hfam_f₁ : fam (f_cov (ULift.up true))
            (CategoryTheory.Presieve.ofArrows.mk (ULift.up true)) = z_true := by
          dsimp only [fam, z_true]
          have hf_eq : f_cov (ULift.up true) = f₁ := CategoryTheory.Category.id_comp f₁
          by_cases hex : ∃ a : X_cov (ULift.up true) ⟶ M_U.obj T_U, a ≫ f₀ = f_cov (ULift.up true)
          · rw [dif_pos hex]
            exact hOvZero x₀ hx₀_van hex.choose (𝟙 U_c_et)
              (hex.choose_spec.trans (hf_eq.trans (CategoryTheory.Category.id_comp f₁).symm))
          · rw [dif_neg hex]
        have hfam_compat : fam.Compatible := by
          rintro Y₁ Y₂ W g₁ g₂ u₁ u₂ ⟨⟨b₁⟩⟩ ⟨⟨b₂⟩⟩ hcomm
          let mk_f : CategoryTheory.Presieve.ofArrows X_cov f_cov (f_cov (ULift.up false)) :=
            CategoryTheory.Presieve.ofArrows.mk (ULift.up false)
          let mk_t : CategoryTheory.Presieve.ofArrows X_cov f_cov (f_cov (ULift.up true)) :=
            CategoryTheory.Presieve.ofArrows.mk (ULift.up true)
          have hf0 : f_cov (ULift.up false) = f₀ := CategoryTheory.Category.id_comp f₀
          have hf1 : f_cov (ULift.up true) = f₁ := CategoryTheory.Category.id_comp f₁
          cases b₁ <;> cases b₂
          · change (fam (f_cov (ULift.up false)) mk_f) ≫ ℱ.obj.map g₁.op =
              (fam (f_cov (ULift.up false)) mk_f) ≫ ℱ.obj.map g₂.op
            rw [hfam_f₀]
            have hg_eq : g₁ = g₂ :=
              h_f₀_mono g₁ g₂ ((congrArg (g₁ ≫ ·) hf0.symm).trans
                (hcomm.trans (congrArg (g₂ ≫ ·) hf0)))
            exact congrArg (fun g => x₀ ≫ ℱ.obj.map g.op) hg_eq
          · change (fam (f_cov (ULift.up false)) mk_f) ≫ ℱ.obj.map g₁.op =
              (fam (f_cov (ULift.up true)) mk_t) ≫ ℱ.obj.map g₂.op
            rw [hfam_f₀, hfam_f₁]
            dsimp only [z_true]
            rw [CategoryTheory.Limits.zero_comp]
            exact hOvZero x₀ hx₀_van g₁ g₂
              ((congrArg (g₁ ≫ ·) hf0.symm).trans (hcomm.trans (congrArg (g₂ ≫ ·) hf1)))
          · change (fam (f_cov (ULift.up true)) mk_t) ≫ ℱ.obj.map g₁.op =
              (fam (f_cov (ULift.up false)) mk_f) ≫ ℱ.obj.map g₂.op
            rw [hfam_f₁, hfam_f₀]
            dsimp only [z_true]
            rw [CategoryTheory.Limits.zero_comp]
            exact (hOvZero x₀ hx₀_van g₂ g₁
              ((congrArg (g₂ ≫ ·) hf0.symm).trans (hcomm.symm.trans (congrArg (g₁ ≫ ·) hf1)))).symm
          · change (fam (f_cov (ULift.up true)) mk_t) ≫ ℱ.obj.map g₁.op =
              (fam (f_cov (ULift.up true)) mk_t) ≫ ℱ.obj.map g₂.op
            rw [hfam_f₁]
            dsimp only [z_true]
            rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
        let x_Y : R_mod ⟶ ℱ.obj.obj (Opposite.op T_Y) := hF_sh.amalgamate fam hfam_compat
        have hx_Y_f₀ : x_Y ≫ ℱ.obj.map f₀.op = x₀ := by
          have hg : x_Y ≫ ℱ.obj.map (f_cov (ULift.up false)).op =
              fam (f_cov (ULift.up false))
                (CategoryTheory.Presieve.ofArrows.mk (ULift.up false)) :=
            hF_sh.valid_glue hfam_compat (f_cov (ULift.up false))
              (CategoryTheory.Presieve.ofArrows.mk (ULift.up false))
          have hf0 : f_cov (ULift.up false) = f₀ := CategoryTheory.Category.id_comp f₀
          exact (congrArg (fun k => x_Y ≫ ℱ.obj.map k.op) hf0.symm).trans (hg.trans hfam_f₀)
        have hx_Y_f₁ : x_Y ≫ ℱ.obj.map f₁.op = 0 := by
          have hg : x_Y ≫ ℱ.obj.map (f_cov (ULift.up true)).op =
              fam (f_cov (ULift.up true))
                (CategoryTheory.Presieve.ofArrows.mk (ULift.up true)) :=
            hF_sh.valid_glue hfam_compat (f_cov (ULift.up true))
              (CategoryTheory.Presieve.ofArrows.mk (ULift.up true))
          have hf1 : f_cov (ULift.up true) = f₁ := CategoryTheory.Category.id_comp f₁
          exact (congrArg (fun k => x_Y ≫ ℱ.obj.map k.op) hf1.symm).trans (hg.trans hfam_f₁)
        let h_Y : One_Y ⟶ ℱ := (adj_Y.homEquiv R_mod ℱ).symm x_Y
        have hκ_hY0 : κ_i ≫ h_Y = 0 := by
          apply (hVan_Y h_Y).mpr
          exact (congrArg (· ≫ ℱ.obj.map f₁.op)
            ((adj_Y.homEquiv R_mod ℱ).apply_symm_apply x_Y)).trans hx_Y_f₁
        let hCok_i := hSE_i.gIsCokernel
        let s_cok_i := CategoryTheory.Limits.CokernelCofork.ofπ (f := κ_i) h_Y hκ_hY0
        let f_Y : i_push.obj One_Z ⟶ ℱ := hCok_i.desc s_cok_i
        have hqi_fY : q_i ≫ f_Y = h_Y :=
          hCok_i.fac s_cok_i CategoryTheory.Limits.WalkingParallelPair.one
        refine ⟨f_Y, ?_⟩
        apply (cancel_epi q_s).mp
        apply (adj_U.homEquiv R_mod (j_star.obj ℱ)).injective
        exact (hMapSec f_Y).trans
          ((congrArg (fun h => adj_Y.homEquiv R_mod ℱ h ≫ ℱ.obj.map f₀.op) hqi_fY).trans
            ((congrArg (· ≫ ℱ.obj.map f₀.op)
              ((adj_Y.homEquiv R_mod ℱ).apply_symm_apply x_Y)).trans hx_Y_f₀))
    have hAllDegBij := hExtExcisionDimShift j_star hj_inj β_U hDeg0Bij q One_Y
    let pull_fn : CategoryTheory.Abelian.Ext.{u} (i_push.obj One_Z) One_Y q →
        CategoryTheory.Abelian.Ext.{u} (s_push.obj One_Z) One_U q :=
      fun e_Y => (CategoryTheory.Abelian.Ext.mk₀ π_U).postcomp (s_push.obj One_Z) (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀ β_U).comp
          ((j_star.mapExtAddHom (i_push.obj One_Z) One_Y q) e_Y) (Nat.zero_add q))
    have hPostBij : Function.Bijective
        ((CategoryTheory.Abelian.Ext.mk₀ π_U).postcomp (s_push.obj One_Z) (Nat.add_zero q)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨(CategoryTheory.Abelian.Ext.mk₀ ι_U).postcomp (s_push.obj One_Z) (Nat.add_zero q),
         fun x => ?_, fun y => ?_⟩
      · change (x.comp (CategoryTheory.Abelian.Ext.mk₀ π_U) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ι_U) (Nat.add_zero q) = x
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero x
          (CategoryTheory.Abelian.Ext.mk₀ π_U) (CategoryTheory.Abelian.Ext.mk₀ ι_U) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hι_U2,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      · change (y.comp (CategoryTheory.Abelian.Ext.mk₀ ι_U) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_U) (Nat.add_zero q) = y
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero y
          (CategoryTheory.Abelian.Ext.mk₀ ι_U) (CategoryTheory.Abelian.Ext.mk₀ π_U) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hι_U1,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    have hPullBij : Function.Bijective pull_fn := hPostBij.comp hAllDegBij
    obtain ⟨e_Y, he_Y⟩ := hPullBij.2 τ_U.val
    let τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) q := { hCont := hc_i, val := e_Y }
    have h_mk_pull : ∀ v'_Y : CategoryTheory.Abelian.Ext.{u} (i_push.obj One_Z) One_Y q,
        WeilGysinSupportPullback U.ι s_U i (ℓ ^ r) q
          { hCont := τ_U.hCont, val := pull_fn v'_Y } { hCont := hc_i, val := v'_Y } :=
      fun _ => ⟨hc_j, j_star, adj_jU, inferInstance, inferInstance, inferInstance,
        T_Y, hT_Y, T_Z, hT_Z, T_U, hT_U, T_Z, hT_Z, ι_U, β_U, hι_U1, hι_U2, hqβ_U, rfl⟩
    have hτ_Y_pb : WeilGysinSupportPullback U.ι s_U i (ℓ ^ r) q τ_U τ_Y := by
      have h_tauU_eq : ({ hCont := τ_U.hCont, val := pull_fn e_Y } :
          WeilGysinSupportClass Z U.toScheme s_U (ℓ ^ r) q) = τ_U := by
        cases τ_U with
        | mk hc_s v_U =>
          dsimp only at he_Y
          rw [he_Y]
      rw [← h_tauU_eq]
      exact h_mk_pull e_Y
    refine ⟨τ_Y, hτ_Y_pb, fun τ'_Y hτ'_pb => ?_⟩
    cases τ'_Y with
    | mk hc'_i v'_Y =>
      cases Subsingleton.elim hc'_i hc_i
      have h_std_pb : WeilGysinSupportPullback U.ι s_U i (ℓ ^ r) q
          { hCont := τ_U.hCont, val := pull_fn v'_Y } { hCont := hc_i, val := v'_Y } :=
        h_mk_pull v'_Y
      have h_eq_U : ({ hCont := τ_U.hCont, val := pull_fn v'_Y } :
          WeilGysinSupportClass Z U.toScheme s_U (ℓ ^ r) q) = τ_U :=
        hPb_uniq U.ι s_U i hs_U_cl r q _ _ _ h_std_pb hτ'_pb
      have hv_eq_pull : pull_fn v'_Y = pull_fn e_Y := by
        have h1 : pull_fn v'_Y = τ_U.val := by
          cases τ_U with
          | mk hc_s v_U =>
            exact eq_of_heq (Eq.ndrec
              (motive := fun w => HEq (pull_fn v'_Y) w.val) HEq.rfl h_eq_U)
        exact h1.trans he_Y.symm
      have hv_eq : v'_Y = e_Y := hPullBij.1 hv_eq_pull
      subst hv_eq
      rfl
  exact ⟨hBC.1, hBC.2, hExc⟩

theorem weil_gysin_closed_immersion_stalk_recollement_ab (hSite : WeilGysinSuppCalcHasExactPullbacks.{u})
    (hLift : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
      AlgebraicGeometry.IsClosedImmersion i →
      ∀ (W : Y.Etale) [AlgebraicGeometry.IsAffine W.left]
        (V_Z : Z.Etale) [AlgebraicGeometry.IsAffine V_Z.left]
        (α : Quiver.Hom V_Z ((weilEtaleSitePullback i).obj W)),
        ∃ (W' : Y.Etale) (_ : AlgebraicGeometry.IsAffine W'.left)
          (f : Quiver.Hom W' W)
          (e : CategoryTheory.Iso V_Z ((weilEtaleSitePullback i).obj W')),
          CategoryTheory.CategoryStruct.comp e.hom ((weilEtaleSitePullback i).map f) = α) :
    WeilGysinSuppCalcClosedExactAb.{u} ∧
    (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
      AlgebraicGeometry.IsClosedImmersion i →
      ∀ (hc : (weilEtaleSitePullback i).IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology),
        letI := hc
        let i_push_ab := (weilEtaleSitePullback i).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Z.smallEtaleTopology
        ∀ (pb_i : CategoryTheory.Functor
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}))
          (adj_i : CategoryTheory.Adjunction pb_i i_push_ab)
          (ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.IsIso (adj_i.counit.app ℱ)) ∧
    (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y) (U_c : Y.Opens),
      AlgebraicGeometry.IsClosedImmersion i →
      (U_c : Set ↥Y) = (Set.range i.base)ᶜ →
      ∀ (hc_i : (weilEtaleSitePullback i).IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology)
        (hc_j : (weilEtaleSitePullback U_c.ι).IsContinuous
          Y.smallEtaleTopology U_c.toScheme.smallEtaleTopology),
        letI := hc_i
        letI := hc_j
        let i_push_ab := (weilEtaleSitePullback i).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Z.smallEtaleTopology
        let j_push_ab := (weilEtaleSitePullback U_c.ι).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology U_c.toScheme.smallEtaleTopology
        ∀ (pb_i : CategoryTheory.Functor
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}))
          (_adj_i : CategoryTheory.Adjunction pb_i i_push_ab)
          (pb_j : CategoryTheory.Functor
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf U_c.toScheme.smallEtaleTopology AddCommGrpCat.{u}))
          (_adj_j : CategoryTheory.Adjunction pb_j j_push_ab)
          (ℋ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Limits.IsZero (pb_j.obj ℋ) →
          CategoryTheory.Limits.IsZero (pb_i.obj ℋ) →
          CategoryTheory.Limits.IsZero ℋ) :=
by
  classical
  let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  
  have hWeakNullstellensatz : ∀ (Ω B : Type u) [Field Ω] [IsAlgClosed Ω]
      [CommRing B] [Nontrivial B] (φ : Ω →+* B),
      φ.FiniteType → ∃ ψ : B →+* Ω, ψ.comp φ = RingHom.id Ω := by
    intro Ω B _ _ _ _ φ hFT
    letI : Algebra Ω B := φ.toAlgebra
    have hFT_alg : Algebra.FiniteType Ω B := hFT
    obtain ⟨n_gen, ev_s, hev_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let I : Ideal (MvPolynomial (Fin n_gen) Ω) := RingHom.ker ev_s.toRingHom
    have h1_not_rad : (1 : MvPolynomial (Fin n_gen) Ω) ∉ I.radical := by
      rintro ⟨n, hn⟩
      rw [one_pow, RingHom.mem_ker, map_one] at hn
      exact one_ne_zero hn
    have hZL_ne : (MvPolynomial.zeroLocus Ω I).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro h_emp
      apply h1_not_rad
      rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := Ω) I, h_emp,
        MvPolynomial.mem_vanishingIdeal_iff]
      intro x hx
      exact False.elim hx
    obtain ⟨x₀, hx₀⟩ := hZL_ne
    rw [MvPolynomial.mem_zeroLocus_iff] at hx₀
    let eval_x₀ : MvPolynomial (Fin n_gen) Ω →ₐ[Ω] Ω := MvPolynomial.aeval x₀
    let ψ_quot : (MvPolynomial (Fin n_gen) Ω ⧸ I) →+* Ω :=
      Ideal.Quotient.lift I eval_x₀.toRingHom (fun f hf => hx₀ f hf)
    let e_quot : (MvPolynomial (Fin n_gen) Ω ⧸ I) ≃+* B :=
      RingHom.quotientKerEquivOfSurjective hev_surj
    let ψ : B →+* Ω := ψ_quot.comp e_quot.symm.toRingHom
    refine ⟨ψ, RingHom.ext fun c => ?_⟩
    have hc : φ c = ev_s (MvPolynomial.C c) := (ev_s.commutes c).symm
    change ψ (φ c) = c
    rw [hc]
    have heq : e_quot.symm (ev_s (MvPolynomial.C c)) = Ideal.Quotient.mk I (MvPolynomial.C c) :=
      e_quot.injective (e_quot.apply_symm_apply _)
    change ψ_quot (e_quot.symm (ev_s (MvPolynomial.C c))) = c
    rw [heq]
    exact eval_x₀.commutes c
  have hAbKernelZeroOfMono : ∀ {X Y : AddCommGrpCat.{u}} (f : X ⟶ Y) [CategoryTheory.Mono f],
      CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel f) := by
