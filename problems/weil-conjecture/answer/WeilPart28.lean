            e_sec S V ≫ φ.hom.app (Opposite.op (openEt V)) = x := by
        intro S V 𝒢 x
        have hEvalSec : ∀ (W : S.Etale) (s : ↥((K_sh S V).obj.obj (Opposite.op W))),
