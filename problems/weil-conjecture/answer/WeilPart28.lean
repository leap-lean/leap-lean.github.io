          _ = c_of Y ≫ (ρ_of Y).map (q_mod_std B_si m₀ ≫ α_push₀) := by rw [← hq_α₀]
          _ = (c_of Y ≫ (ρ_of Y).map (q_mod_std B_si m₀)) ≫ (ρ_of Y).map α_push₀ := by
                rw [(ρ_of Y).map_comp, ← Category.assoc]
          _ = (q_mod_std B_si m₁ ≫ push_c_of B_si) ≫ (ρ_of Y).map α_push₀ := by
                rw [← hq_c_nat B_si]
          _ = q_mod_std B_si m₁ ≫ (push_c_of B_si ≫ (ρ_of Y).map α_push₀) :=
                Category.assoc _ _ _
      
      have h_push_ρ_ext :
          Abelian.Ext.mapExactFunctor i_push₁ (Abelian.Ext.mapExactFunctor (ρ_of Z) vZ₀) =
