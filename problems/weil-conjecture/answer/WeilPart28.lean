              rfl
            have hg_π₂ : CategoryTheory.CategoryStruct.comp (Fgt_W.map (B₁.map g)).left
                (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj V)).hom pr₂) =
                CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj W)).hom pr₂ := by
