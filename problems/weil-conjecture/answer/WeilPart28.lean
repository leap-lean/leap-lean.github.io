          ext a
          change (1 : ℕ) • a = 0
          rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
        have hF_zero : (1 : ℕ) • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z 1) = 0 := by
          change (1 : ℕ) • CategoryTheory.CategoryStruct.id (CZ.obj (U_lift.obj Z_1)) = 0
