      intro G φ₁ φ₂ h1
      ext ⟨n⟩
      have hn : (⟨n⟩ : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) := by
        ext; change n = n • (1 : ℤ); simp
      rw [hn]
      change φ₁.hom (n • ULift.up (1 : ℤ)) = φ₂.hom (n • ULift.up (1 : ℤ))
      rw [map_zsmul, map_zsmul]
