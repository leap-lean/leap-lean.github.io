      have _ : Limits.PreservesFiniteLimits (U ⋙ P_a) := Limits.comp_preservesFiniteLimits U P_a
      have _ : Limits.PreservesFiniteColimits (U ⋙ P_a) := Limits.comp_preservesFiniteColimits U P_a
      have h_comp₁ := hExtComp P_m U' O O q ξ
      have h_comp₂ := hExtComp U P_a O O q ξ
      have h_iso := hExtIso (P_m ⋙ U') (U ⋙ P_a) θ O O q ξ
      rw [Functor.mapExtAddHom_apply U', Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀, ← Functor.mapExtAddHom_apply U', ← h_comp₁]
      rw [Functor.mapExtAddHom_apply P_a, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀, ← Functor.mapExtAddHom_apply P_a, ← h_comp₂, h_iso]
      set y := ((P_m ⋙ U').mapExtAddHom O O q) ξ
