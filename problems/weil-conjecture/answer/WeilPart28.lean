          obtain ⟨z₁, rfl⟩ := hsurjR r₁; obtain ⟨z₂, rfl⟩ := hsurjR r₂
          exact (congrArg (· • x) (map_mul (Int.castRingHom R) z₁ z₂).symm).trans
