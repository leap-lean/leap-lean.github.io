          η.inv_hom_id_app (C₂.obj Aℤ), CategoryTheory.Category.id_comp, hιr_l']
      have h_inv_eq : CategoryTheory.CategoryStruct.comp ιℤ_r (η.inv.app (C₂.obj Aℤ)) = ιℤ_s := by
        calc
          CategoryTheory.CategoryStruct.comp ιℤ_r (η.inv.app (C₂.obj Aℤ))
