        ∃ u : Fin b₀ → CategoryTheory.Abelian.Ext.{u} one₁ one₁ s,
          M • γ₀ = ∑ t : Fin b₀,
            (u t).comp (CategoryTheory.Abelian.Ext.mk₀ (g₀ t)) (Nat.add_zero s) := by
    intro b₀ E₀ X₀ proj₀ g₀ lift₀ hLift₀ s γ₀
    let ξ₀ := γ₀.comp (CategoryTheory.Abelian.Ext.mk₀ lift₀) (Nat.add_zero s)
    refine ⟨fun t => ξ₀.comp (CategoryTheory.Abelian.Ext.mk₀ (proj₀ t)) (Nat.add_zero s), ?_⟩
    have hsum : (∑ t : Fin b₀,
        (ξ₀.comp (CategoryTheory.Abelian.Ext.mk₀ (proj₀ t)) (Nat.add_zero s)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (g₀ t)) (Nat.add_zero s)) =
        mk₀_post ξ₀ (∑ t : Fin b₀, proj₀ t ≫ g₀ t) := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro t _
      rw [h_mk₀_post_apply, h_ext_assoc ξ₀ _ _ (Nat.add_zero s) (Nat.zero_add 0)
        (Nat.add_zero s) (Nat.add_zero s), h_mk₀_comp]
    rw [hsum, h_mk₀_post_apply]
    dsimp only [ξ₀]
    rw [h_ext_assoc γ₀ _ _ (Nat.add_zero s) (Nat.zero_add 0) (Nat.add_zero s) (Nat.add_zero s),
      h_mk₀_comp, hLift₀, ← h_mk₀_post_apply γ₀ (M • 𝟙 X₀), map_nsmul,
      h_mk₀_post_apply, h_comp_mk₀_id]
  have h_split_succ : ∀ (b_q : ℕ) (E₀ B₀ X₀ H₀ : C₁)
      (j₀ : B₀ ⟶ X₀) (q₀ : X₀ ⟶ H₀) (hz₀ : j₀ ≫ q₀ = 0),
      (CategoryTheory.ShortComplex.mk j₀ q₀ hz₀).ShortExact →
      ∀ (proj₀ : Fin b_q → (E₀ ⟶ one₁)) (g₀ : Fin b_q → (one₁ ⟶ X₀)) (lift_ψ : H₀ ⟶ E₀),
        lift_ψ ≫ ((∑ t : Fin b_q, proj₀ t ≫ g₀ t) ≫ q₀) = M • 𝟙 H₀ →
        ∀ (s : ℕ) (γ : CategoryTheory.Abelian.Ext.{u} one₁ X₀ s),
          ∃ (u : Fin b_q → CategoryTheory.Abelian.Ext.{u} one₁ one₁ s)
            (β : CategoryTheory.Abelian.Ext.{u} one₁ B₀ s),
            M • γ = (∑ t : Fin b_q,
              (u t).comp (CategoryTheory.Abelian.Ext.mk₀ (g₀ t)) (Nat.add_zero s)) +
              β.comp (CategoryTheory.Abelian.Ext.mk₀ j₀) (Nat.add_zero s) := by
    intro b_q E₀ B₀ X₀ H₀ j₀ q₀ hz₀ hEx₀ proj₀ g₀ lift_ψ hLift_ψ s γ
    let hat_ψ : E₀ ⟶ X₀ := ∑ t : Fin b_q, proj₀ t ≫ g₀ t
    let ξ := γ.comp (CategoryTheory.Abelian.Ext.mk₀ (q₀ ≫ lift_ψ)) (Nat.add_zero s)
    let u : Fin b_q → CategoryTheory.Abelian.Ext.{u} one₁ one₁ s :=
      fun t => ξ.comp (CategoryTheory.Abelian.Ext.mk₀ (proj₀ t)) (Nat.add_zero s)
    let S_sum : CategoryTheory.Abelian.Ext.{u} one₁ X₀ s :=
      ∑ t : Fin b_q, (u t).comp (CategoryTheory.Abelian.Ext.mk₀ (g₀ t)) (Nat.add_zero s)
    have hS_eq : S_sum = γ.comp (CategoryTheory.Abelian.Ext.mk₀ ((q₀ ≫ lift_ψ) ≫ hat_ψ))
        (Nat.add_zero s) := by
      have h1 : S_sum = mk₀_post ξ hat_ψ := by
        dsimp only [S_sum, u, hat_ψ]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro t _
        rw [h_mk₀_post_apply, h_ext_assoc ξ _ _ (Nat.add_zero s) (Nat.zero_add 0)
          (Nat.add_zero s) (Nat.add_zero s), h_mk₀_comp]
      rw [h1, h_mk₀_post_apply]
      dsimp only [ξ]
      rw [h_ext_assoc γ _ _ (Nat.add_zero s) (Nat.zero_add 0) (Nat.add_zero s) (Nat.add_zero s),
        h_mk₀_comp]
    have hS_q : S_sum.comp (CategoryTheory.Abelian.Ext.mk₀ q₀) (Nat.add_zero s) =
        (M • γ).comp (CategoryTheory.Abelian.Ext.mk₀ q₀) (Nat.add_zero s) := by
      rw [hS_eq, h_ext_assoc γ _ _ (Nat.add_zero s) (Nat.zero_add 0)
          (Nat.add_zero s) (Nat.add_zero s), h_mk₀_comp]
      have h_mor : ((q₀ ≫ lift_ψ) ≫ hat_ψ) ≫ q₀ = M • q₀ := by
        calc ((q₀ ≫ lift_ψ) ≫ hat_ψ) ≫ q₀
            = q₀ ≫ (lift_ψ ≫ (hat_ψ ≫ q₀)) := by simp only [Category.assoc]
          _ = q₀ ≫ (M • 𝟙 H₀) := by rw [hLift_ψ]
          _ = M • q₀ := by simp only [Preadditive.comp_nsmul, Category.comp_id]
      rw [h_mor, ← h_mk₀_post_apply γ (M • q₀), map_nsmul, h_mk₀_post_apply]
      exact (map_nsmul ((CategoryTheory.Abelian.Ext.mk₀ q₀).postcomp one₁ (Nat.add_zero s)) M γ).symm
    have h_diff_zero : (M • γ - S_sum).comp (CategoryTheory.Abelian.Ext.mk₀ q₀)
        (Nat.add_zero s) = 0 := by
      change ((CategoryTheory.Abelian.Ext.mk₀ q₀).postcomp one₁ (Nat.add_zero s)) (M • γ - S_sum) = 0
      rw [map_sub]
      exact sub_eq_zero.mpr hS_q.symm
    obtain ⟨β, hβ⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ one₁ hEx₀
      (M • γ - S_sum) h_diff_zero
    refine ⟨u, β, ?_⟩
    change M • γ = S_sum + β.comp (CategoryTheory.Abelian.Ext.mk₀ j₀) (Nat.add_zero s)
    rw [hβ, add_sub_cancel]

  
  let leray (Y : C₂) (m : ℕ) :
      CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj Y) m →+
        CategoryTheory.Abelian.Ext.{u} one₂ Y m :=
    ((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).precomp Y (Nat.zero_add m)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app Y)).postcomp (P_pull.obj one₁)
        (Nat.add_zero m)).comp (P_pull.mapExtAddHom one₁ (P_push.obj Y) m))
  let p₁_mod (s : ℕ) :
      CategoryTheory.Abelian.Ext.{u} one₁ one₁ s →+
        CategoryTheory.Abelian.Ext.{u} one₂ one₂ s :=
    ((CategoryTheory.Abelian.Ext.mk₀ e_unit.inv).postcomp one₂ (Nat.add_zero s)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).precomp (P_pull.obj one₁)
        (Nat.zero_add s)).comp (P_pull.mapExtAddHom one₁ one₁ s))
  have h_leray_apply : ∀ (Y : C₂) (m : ℕ)
      (γ : CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj Y) m),
      leray Y m γ =
        (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
          ((CategoryTheory.Abelian.Ext.mapExactFunctor P_pull γ).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app Y)) (Nat.add_zero m))
          (Nat.zero_add m) := by
    intro Y m γ
    change (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
      (((P_pull.mapExtAddHom one₁ (P_push.obj Y) m) γ).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app Y)) (Nat.add_zero m))
      (Nat.zero_add m) = _
    rw [CategoryTheory.Functor.mapExtAddHom_apply]
  have h_mate_counit : ∀ (Y : C₂) (f : one₂ ⟶ Y),
      P_pull.map ((adj.homEquiv one₁ Y) (e_unit.inv ≫ f)) ≫ adj.counit.app Y =
        e_unit.inv ≫ f := by
    intro Y f
    rw [← adj.homEquiv_counit one₁ Y ((adj.homEquiv one₁ Y) (e_unit.inv ≫ f)),
      Equiv.symm_apply_apply]
  have h_leray0 : ∀ (Y : C₂) (f : one₂ ⟶ Y),
      leray Y 0 (CategoryTheory.Abelian.Ext.mk₀ ((adj.homEquiv one₁ Y) (e_unit.inv ≫ f))) =
        CategoryTheory.Abelian.Ext.mk₀ f := by
    intro Y f
    rw [h_leray_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀, h_mk₀_comp,
      h_mate_counit, h_mk₀_comp, ← Category.assoc, e_unit.hom_inv_id, Category.id_comp]
  have h_leray_u : ∀ (Y : C₂) (f : one₂ ⟶ Y) (s : ℕ)
      (u : CategoryTheory.Abelian.Ext.{u} one₁ one₁ s),
      leray Y s (u.comp (CategoryTheory.Abelian.Ext.mk₀ ((adj.homEquiv one₁ Y) (e_unit.inv ≫ f)))
        (Nat.add_zero s)) =
        (p₁_mod s u).comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero s) := by
    intro Y f s u
    rw [h_leray_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      h_ext_assoc _ _ _ (Nat.add_zero s) (Nat.zero_add 0) (Nat.add_zero s) (Nat.add_zero s),
      h_mk₀_comp, h_mate_counit, ← h_mk₀_comp e_unit.inv f,
      ← h_ext_assoc _ (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv)
        (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero s) (Nat.zero_add 0)
        (Nat.add_zero s) (Nat.add_zero s),
      ← h_ext_assoc (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom) _
        (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.zero_add s) (Nat.add_zero s)
        (Nat.add_zero s) (Nat.zero_add s),
      ← h_ext_assoc (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom) _
        (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv) (Nat.zero_add s) (Nat.add_zero s)
        (Nat.add_zero s) (Nat.zero_add s),
      ← CategoryTheory.Functor.mapExtAddHom_apply P_pull one₁ one₁ s u]
    rfl
  have h_leray_step : ∀ (k : ℕ),
      ∃ (hz_inj : P_push.map (ι_Z k) ≫ p_img k = 0)
        (hEx_inj : (CategoryTheory.ShortComplex.mk (P_push.map (ι_Z k)) (p_img k) hz_inj).ShortExact),
        ∀ (s : ℕ) (β : CategoryTheory.Abelian.Ext.{u} one₁ (B₁ k) s),
          leray (Z k) (s + 1) (β.comp hEx_inj.extClass rfl) =
            (leray (Z (k + 1)) s (β.comp (CategoryTheory.Abelian.Ext.mk₀ (j_B k))
              (Nat.add_zero s))).comp (hEx_Z k).extClass rfl := by
    intro k
    have : P_push.Additive := adj.right_adjoint_additive
    have : CategoryTheory.Mono (j_B k) := (hEx_B k).mono_f
    have : CategoryTheory.Epi (p_img k) := hEpi_p k
    have : CategoryTheory.Mono (ι_Z k) := (hEx_Z k).mono_f
    have hz_inj : P_push.map (ι_Z k) ≫ p_img k = 0 := by
      apply (cancel_mono (j_B k)).mp
      rw [Category.assoc, hFac_B k, ← P_push.map_comp, hz_Z k, P_push.map_zero, Limits.zero_comp]
    let S_inj := CategoryTheory.ShortComplex.mk (P_push.map (ι_Z k)) (p_img k) hz_inj
    let hk_Z := (hEx_Z k).fIsKernel
    have hg'_adj_of : ∀ {W' : C₁} (g' : W' ⟶ P_push.obj (J k)),
        g' ≫ p_img k = 0 → ((adj.homEquiv W' (J k)).symm g') ≫ π_Z k = 0 := by
      intro W' g' hg'
      have hg'_π : g' ≫ P_push.map (π_Z k) = 0 := by
        rw [← hFac_B k, ← Category.assoc, hg', Limits.zero_comp]
      rw [← adj.homEquiv_naturality_right_symm g' (π_Z k), hg'_π,
        adj.homEquiv_counit, P_pull.map_zero, Limits.zero_comp]
    have hfac_of : ∀ {W' : C₁} (g' : W' ⟶ P_push.obj (J k)) (hg' : g' ≫ p_img k = 0),
        hk_Z.lift (CategoryTheory.Limits.KernelFork.ofι
          ((adj.homEquiv W' (J k)).symm g') (hg'_adj_of g' hg')) ≫ ι_Z k =
          (adj.homEquiv W' (J k)).symm g' := by
      intro W' g' hg'
      exact hk_Z.fac (CategoryTheory.Limits.KernelFork.ofι
        ((adj.homEquiv W' (J k)).symm g') (hg'_adj_of g' hg'))
        CategoryTheory.Limits.WalkingParallelPair.zero
    have hk_inj : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι (P_push.map (ι_Z k)) hz_inj) := by
      refine CategoryTheory.Limits.KernelFork.IsLimit.ofι (P_push.map (ι_Z k)) hz_inj
        (fun {W'} g' hg' => (adj.homEquiv W' (Z k))
          (hk_Z.lift (CategoryTheory.Limits.KernelFork.ofι
            ((adj.homEquiv W' (J k)).symm g') (hg'_adj_of g' hg'))))
        (fun {W'} g' hg' => ?_) (fun {W'} g' hg' m hm => ?_)
      · dsimp only
        rw [← adj.homEquiv_naturality_right, hfac_of g' hg', Equiv.apply_symm_apply]
      · dsimp only
        apply (adj.homEquiv W' (Z k)).symm.injective
        rw [Equiv.symm_apply_apply]
        apply (cancel_mono (ι_Z k)).mp
        rw [hfac_of g' hg', ← adj.homEquiv_naturality_right_symm m (ι_Z k), hm]
    have hEx_inj : S_inj.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel S_inj hk_inj)
        (CategoryTheory.Limits.mono_of_isLimit_fork hk_inj)
        (hEpi_p k)
    refine ⟨hz_inj, hEx_inj, ?_⟩
    intro s β
    let hEx_pull : (S_inj.map P_pull).ShortExact := hEx_inj.map_of_exact P_pull
    have comm₁₂ : adj.counit.app (Z k) ≫ ι_Z k =
        (S_inj.map P_pull).f ≫ adj.counit.app (J k) :=
      (adj.counit.naturality (ι_Z k)).symm
    have comm₂₃ : adj.counit.app (J k) ≫ π_Z k =
        (S_inj.map P_pull).g ≫ (P_pull.map (j_B k) ≫ adj.counit.app (Z (k + 1))) := by
      change adj.counit.app (J k) ≫ π_Z k =
        P_pull.map (p_img k) ≫ (P_pull.map (j_B k) ≫ adj.counit.app (Z (k + 1)))
      calc adj.counit.app (J k) ≫ π_Z k
          = P_pull.map (P_push.map (π_Z k)) ≫ adj.counit.app (Z (k + 1)) :=
            (adj.counit.naturality (π_Z k)).symm
        _ = P_pull.map (p_img k ≫ j_B k) ≫ adj.counit.app (Z (k + 1)) := by
            rw [hFac_B k]
        _ = (P_pull.map (p_img k) ≫ P_pull.map (j_B k)) ≫ adj.counit.app (Z (k + 1)) := by
            rw [P_pull.map_comp]
        _ = P_pull.map (p_img k) ≫ (P_pull.map (j_B k) ≫ adj.counit.app (Z (k + 1))) :=
            Category.assoc _ _ _
    let φ : S_inj.map P_pull ⟶ CategoryTheory.ShortComplex.mk (ι_Z k) (π_Z k) (hz_Z k) :=
      CategoryTheory.ShortComplex.homMk (adj.counit.app (Z k)) (adj.counit.app (J k))
        (P_pull.map (j_B k) ≫ adj.counit.app (Z (k + 1))) comm₁₂ comm₂₃
    have h_nat : hEx_pull.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app (Z k)))
        (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map (j_B k) ≫ adj.counit.app (Z (k + 1)))).comp
          (hEx_Z k).extClass (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hEx_pull (hEx_Z k) φ
    rw [h_leray_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_pull hEx_inj]
    change (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
      (((CategoryTheory.Abelian.Ext.mapExactFunctor P_pull β).comp hEx_pull.extClass rfl).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app (Z k))) (Nat.add_zero (s + 1)))
      (Nat.zero_add (s + 1)) = _
    rw [h_ext_assoc (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull β) hEx_pull.extClass
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app (Z k)))
        rfl (Nat.add_zero 1) (Nat.add_zero (s + 1)) rfl,
      h_nat,
      ← h_ext_assoc (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull β)
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map (j_B k) ≫ adj.counit.app (Z (k + 1))))
        (hEx_Z k).extClass (Nat.add_zero s) (Nat.zero_add 1) rfl rfl,
      ← h_mk₀_comp (P_pull.map (j_B k)) (adj.counit.app (Z (k + 1))),
      ← h_ext_assoc (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull β)
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map (j_B k)))
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app (Z (k + 1))))
        (Nat.add_zero s) (Nat.zero_add 0) (Nat.add_zero s) (Nat.add_zero s),
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ P_pull (j_B k),
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp P_pull β
        (CategoryTheory.Abelian.Ext.mk₀ (j_B k)) (Nat.add_zero s),
      ← h_ext_assoc (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom) _ (hEx_Z k).extClass
        (Nat.zero_add s) rfl rfl (Nat.zero_add (s + 1)),
      ← h_leray_apply]

  
  let hat_g (q : ℕ) (t : Fin (b q)) : one₁ ⟶ P_push.obj (Z q) :=
    (adj.homEquiv one₁ (Z q)) (e_unit.inv ≫ g_tilde q t)
  let Φ (n q : ℕ) (hnq : n + q = D) (t₂ : Fin (b q)) :
      CategoryTheory.Abelian.Ext.{u} one₁ one₁ n →+
        CategoryTheory.Abelian.Ext.{u} one₂ one₂ D :=
    ((w₂ q t₂).postcomp one₂ hnq).comp (p₁_mod n)
  let L_hom (n q : ℕ) (hnq : n + q = D) :
      CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj (Z q)) n →+
        CategoryTheory.Abelian.Ext.{u} one₂ one₂ D :=
    ((η q).postcomp one₂ hnq).comp (leray (Z q) n)
  have hInit : ∃ γ_D : CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj (Z D)) 0,
      L_hom 0 D (Nat.zero_add D) γ_D = z := by
    obtain ⟨f_D, hf_D⟩ := h_lift_deg0
    refine ⟨CategoryTheory.Abelian.Ext.mk₀ ((adj.homEquiv one₁ (Z D)) (e_unit.inv ≫ f_D)), ?_⟩
    change (leray (Z D) 0 _).comp (η D) (Nat.zero_add D) = z
    rw [h_leray0, hf_D]
  have hBase : ∀ (n : ℕ) (hn0 : n + 0 = D)
      (γ₀ : CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj (Z 0)) n),
      ∃ u₀ : Fin (b 0) → CategoryTheory.Abelian.Ext.{u} one₁ one₁ n,
        M • L_hom n 0 hn0 γ₀ = ∑ t₂ : Fin (b 0), Φ n 0 hn0 t₂ (u₀ t₂) := by
    intro n hn0 γ₀
    obtain ⟨_, lift_ψ₀, hLift₀⟩ := hBasis0
    obtain ⟨u₀, hu₀⟩ := h_split_base (b 0) (E₁ 0) (P_push.obj (Z 0)) (proj₁ 0) (hat_g 0)
      lift_ψ₀ hLift₀ n γ₀
    refine ⟨u₀, ?_⟩
    rw [← map_nsmul, hu₀, map_sum]
    apply Finset.sum_congr rfl
    intro t₂ _
    change (leray (Z 0) n ((u₀ t₂).comp (CategoryTheory.Abelian.Ext.mk₀ (hat_g 0 t₂))
        (Nat.add_zero n))).comp (η 0) hn0 =
      (p₁_mod n (u₀ t₂)).comp (w₂ 0 t₂) hn0
    rw [h_leray_u (Z 0) (g_tilde 0 t₂) n (u₀ t₂),
      h_ext_assoc (p₁_mod n (u₀ t₂)) (CategoryTheory.Abelian.Ext.mk₀ (g_tilde 0 t₂)) (η 0)
        (Nat.add_zero n) (Nat.zero_add 0) hn0 hn0,
      hg_tilde 0 t₂]
  have hStep : ∀ (n k : ℕ) (hnk : n + (k + 1) = D)
      (γ : CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj (Z (k + 1))) n),
      ∃ (u : Fin (b (k + 1)) → CategoryTheory.Abelian.Ext.{u} one₁ one₁ n)
        (γ' : CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj (Z k)) (n + 1)),
        M • L_hom n (k + 1) hnk γ =
          (∑ t₂ : Fin (b (k + 1)), Φ n (k + 1) hnk t₂ (u t₂)) +
            L_hom (n + 1) k (by omega) γ' := by
    intro n k hnk γ
    have hk : k + 1 ≤ D := by omega
    obtain ⟨_, lift_ψ_k, hLift_k⟩ := hBasisSucc k hk
    obtain ⟨u, β, hγ_eq⟩ := h_split_succ (b (k + 1)) (E₁ (k + 1)) (B₁ k) (P_push.obj (Z (k + 1)))
      (H₁ k) (j_B k) (q_H k) (hz_B k) (hEx_B k) (proj₁ (k + 1)) (hat_g (k + 1)) lift_ψ_k
      hLift_k n γ
    obtain ⟨hz_inj, hEx_inj, hComm⟩ := h_leray_step k
    refine ⟨u, β.comp hEx_inj.extClass rfl, ?_⟩
    rw [← map_nsmul, hγ_eq, map_add, map_sum]
    congr 1
    · apply Finset.sum_congr rfl
      intro t₂ _
      change (leray (Z (k + 1)) n ((u t₂).comp
          (CategoryTheory.Abelian.Ext.mk₀ (hat_g (k + 1) t₂)) (Nat.add_zero n))).comp
          (η (k + 1)) hnk =
        (p₁_mod n (u t₂)).comp (w₂ (k + 1) t₂) hnk
      rw [h_leray_u (Z (k + 1)) (g_tilde (k + 1) t₂) n (u t₂),
        h_ext_assoc (p₁_mod n (u t₂)) (CategoryTheory.Abelian.Ext.mk₀ (g_tilde (k + 1) t₂))
          (η (k + 1)) (Nat.add_zero n) (Nat.zero_add (k + 1)) hnk hnk,
        hg_tilde (k + 1) t₂]
    · have hnk' : (n + 1) + k = D := by omega
      change (leray (Z (k + 1)) n (β.comp (CategoryTheory.Abelian.Ext.mk₀ (j_B k))
          (Nat.add_zero n))).comp (η (k + 1)) hnk =
        (leray (Z k) (n + 1) (β.comp hEx_inj.extClass rfl)).comp (η k) hnk'
      rw [hηSucc k,
        ← h_ext_assoc _ (hEx_Z k).extClass (η k) rfl (Nat.one_add k) hnk' hnk,
        ← hComm n β]

  
  let Idx := ↥(Finset.Iic D)
  let term (s : Idx) (t₁ : Fin (b s.1)) (t₂ : Fin (b (D - s.1))) :
      CategoryTheory.Abelian.Ext.{u} one₂ one₂ D :=
    Φ s.1 (D - s.1) (Nat.add_sub_of_le (Finset.mem_Iic.mp s.2)) t₂ (v₁ s.1 t₁)
  have h_align : ∀ (n q : ℕ) (hn : n ≤ D) (hq : q = D - n) (hnq : n + q = D)
      (u : Fin (b q) → CategoryTheory.Abelian.Ext.{u} one₁ one₁ n),
      (∑ t₂ : Fin (b q), Φ n q hnq t₂ (u t₂)) =
        ∑ t₂ : Fin (b (D - n)),
          Φ n (D - n) (Nat.add_sub_of_le hn) t₂ (u (Fin.cast (congrArg b hq.symm) t₂)) := by
    intro n q hn hq
    subst hq
    intro hnq u
    rfl
  have h_single : ∀ (n q K : ℕ) (hn : n ≤ D) (hq : q = D - n) (hnq : n + q = D)
      (u : Fin (b q) → CategoryTheory.Abelian.Ext.{u} one₁ one₁ n),
      let s₀ : Idx := ⟨n, Finset.mem_Iic.mpr hn⟩
      ∃ f_n : Fin (b n) → Fin (b (D - n)) → ZMod m₀,
        (M ^ (K + 1)) • (∑ t₂ : Fin (b q), Φ n q hnq t₂ (u t₂)) =
          ∑ t₁ : Fin (b n), ∑ t₂ : Fin (b (D - n)), (f_n t₁ t₂).val • term s₀ t₁ t₂ := by
    intro n q K hn hq hnq u
    let s₀ : Idx := ⟨n, Finset.mem_Iic.mpr hn⟩
    have hc_ex : ∀ t₂ : Fin (b (D - n)), ∃ c : Fin (b n) → ZMod m₀,
        M • ((M ^ K) • u (Fin.cast (congrArg b hq.symm) t₂)) =
          ∑ t₁ : Fin (b n), (c t₁).val • v₁ n t₁ :=
      fun t₂ => hCoker₁ n hn ((M ^ K) • u (Fin.cast (congrArg b hq.symm) t₂))
    let c_loc : Fin (b (D - n)) → Fin (b n) → ZMod m₀ := fun t₂ => (hc_ex t₂).choose
    refine ⟨fun t₁ t₂ => c_loc t₂ t₁, ?_⟩
    rw [h_align n q hn hq hnq u, Finset.smul_sum, ← Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro t₂ _
    rw [← map_nsmul, pow_succ' M K, mul_nsmul', (hc_ex t₂).choose_spec, map_sum]
    apply Finset.sum_congr rfl
    intro t₁ _
    rw [map_nsmul]
  have h_glue : ∀ (n : ℕ) (hn : n ≤ D)
      (f_n : Fin (b n) → Fin (b (D - n)) → ZMod m₀)
      (c_rest : ∀ s : Idx, Fin (b s.1) → Fin (b (D - s.1)) → ZMod m₀),
      (∀ (s : Idx) (t₁ : Fin (b s.1)) (t₂ : Fin (b (D - s.1))),
        s.1 < n + 1 → c_rest s t₁ t₂ = 0) →
      let s₀ : Idx := ⟨n, Finset.mem_Iic.mpr hn⟩
      ∃ c_new : ∀ s : Idx, Fin (b s.1) → Fin (b (D - s.1)) → ZMod m₀,
        (∀ (s : Idx) (t₁ : Fin (b s.1)) (t₂ : Fin (b (D - s.1))),
          s.1 < n → c_new s t₁ t₂ = 0) ∧
        (∑ s : Idx, ∑ t₁ : Fin (b s.1), ∑ t₂ : Fin (b (D - s.1)),
          (c_new s t₁ t₂).val • term s t₁ t₂) =
        (∑ t₁ : Fin (b n), ∑ t₂ : Fin (b (D - n)), (f_n t₁ t₂).val • term s₀ t₁ t₂) +
        (∑ s : Idx, ∑ t₁ : Fin (b s.1), ∑ t₂ : Fin (b (D - s.1)),
          (c_rest s t₁ t₂).val • term s t₁ t₂) := by
    intro n hn f_n c_rest h_supp
    let s₀ : Idx := ⟨n, Finset.mem_Iic.mpr hn⟩
    let c_new : ∀ s : Idx, Fin (b s.1) → Fin (b (D - s.1)) → ZMod m₀ :=
      fun s t₁ t₂ =>
        if h : s = s₀ then
          f_n (Fin.cast (congrArg (fun x : Idx => b x.1) h) t₁)
            (Fin.cast (congrArg (fun x : Idx => b (D - x.1)) h) t₂)
        else
          c_rest s t₁ t₂
    refine ⟨c_new, ?_, ?_⟩
    · intro s t₁ t₂ hs
      have hne : s ≠ s₀ := by
        intro heq
        have : s.1 = n := congrArg Subtype.val heq
        omega
      have hc_s : c_new s t₁ t₂ = c_rest s t₁ t₂ :=
        dite_eq_right_iff.mpr (fun h => absurd h hne)
      rw [hc_s]
      exact h_supp s t₁ t₂ (by omega)
    · rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ s₀)]
      have h_at_s₀ : (∑ t₁ : Fin (b s₀.1), ∑ t₂ : Fin (b (D - s₀.1)),
          (c_new s₀ t₁ t₂).val • term s₀ t₁ t₂) =
          ∑ t₁ : Fin (b n), ∑ t₂ : Fin (b (D - n)), (f_n t₁ t₂).val • term s₀ t₁ t₂ := by
        apply Finset.sum_congr rfl
        intro t₁ _
        apply Finset.sum_congr rfl
        intro t₂ _
        have hc_s₀ : c_new s₀ t₁ t₂ = f_n t₁ t₂ :=
          dite_cond_eq_true (eq_true rfl)
        rw [hc_s₀]
      have h_erase : (∑ s ∈ Finset.univ.erase s₀,
          ∑ t₁ : Fin (b s.1), ∑ t₂ : Fin (b (D - s.1)),
            (c_new s t₁ t₂).val • term s t₁ t₂) =
          ∑ s : Idx, ∑ t₁ : Fin (b s.1), ∑ t₂ : Fin (b (D - s.1)),
            (c_rest s t₁ t₂).val • term s t₁ t₂ := by
        conv_rhs => rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ s₀)]
        have h_rest_s₀ : (∑ t₁ : Fin (b s₀.1), ∑ t₂ : Fin (b (D - s₀.1)),
            (c_rest s₀ t₁ t₂).val • term s₀ t₁ t₂) = 0 := by
          apply Finset.sum_eq_zero
          intro t₁ _
          apply Finset.sum_eq_zero
          intro t₂ _
          have hz0 : c_rest s₀ t₁ t₂ = 0 := h_supp s₀ t₁ t₂ (Nat.lt_succ_self n)
          rw [hz0, ZMod.val_zero, zero_smul]
        rw [h_rest_s₀, zero_add]
        apply Finset.sum_congr rfl
        intro s hs
        have hne : s ≠ s₀ := (Finset.mem_erase.mp hs).1
        apply Finset.sum_congr rfl
        intro t₁ _
        apply Finset.sum_congr rfl
        intro t₂ _
        have hc_s : c_new s t₁ t₂ = c_rest s t₁ t₂ :=
          dite_eq_right_iff.mpr (fun h => absurd h hne)
        rw [hc_s]
      rw [h_at_s₀, h_erase]
  have h_tele : ∀ (q n : ℕ) (hnq : n + q = D)
      (γ : CategoryTheory.Abelian.Ext.{u} one₁ (P_push.obj (Z q)) n),
      ∃ c_q : ∀ s : Idx, Fin (b s.1) → Fin (b (D - s.1)) → ZMod m₀,
        (∀ (s : Idx) (t₁ : Fin (b s.1)) (t₂ : Fin (b (D - s.1))),
          s.1 < n → c_q s t₁ t₂ = 0) ∧
        (M ^ (q + 2)) • L_hom n q hnq γ =
          ∑ s : Idx, ∑ t₁ : Fin (b s.1), ∑ t₂ : Fin (b (D - s.1)),
            (c_q s t₁ t₂).val • term s t₁ t₂ := by
    intro q
    induction q with
    | zero =>
      intro n hn0 γ₀
      have hn : n ≤ D := by omega
      have hq : 0 = D - n := by omega
      obtain ⟨u₀, hu₀⟩ := hBase n hn0 γ₀
      obtain ⟨f_n, hf_n⟩ := h_single n 0 0 hn hq hn0 u₀
      let c_zero : ∀ s : Idx, Fin (b s.1) → Fin (b (D - s.1)) → ZMod m₀ := fun _ _ _ => 0
      obtain ⟨c_new, h_new_supp, h_new_sum⟩ := h_glue n hn f_n c_zero (fun _ _ _ _ => rfl)
      refine ⟨c_new, h_new_supp, ?_⟩
      have h_czero_sum : (∑ s : Idx, ∑ t₁ : Fin (b s.1), ∑ t₂ : Fin (b (D - s.1)),
          (c_zero s t₁ t₂).val • term s t₁ t₂) = 0 := by
        apply Finset.sum_eq_zero; intro s _
        apply Finset.sum_eq_zero; intro t₁ _
        apply Finset.sum_eq_zero; intro t₂ _
        dsimp only [c_zero]
        rw [ZMod.val_zero, zero_smul]
      rw [h_new_sum, h_czero_sum, add_zero, ← hf_n]
      change (M ^ 2) • L_hom n 0 hn0 γ₀ = (M ^ 1) • (∑ t₂ : Fin (b 0), Φ n 0 hn0 t₂ (u₀ t₂))
      rw [← hu₀, ← mul_nsmul', pow_one, sq]
    | succ k ih =>
      intro n hnk γ
      have hn : n ≤ D := by omega
      have hq : k + 1 = D - n := by omega
      obtain ⟨u, γ', hst⟩ := hStep n k hnk γ
      obtain ⟨f_n, hf_n⟩ := h_single n (k + 1) (k + 1) hn hq hnk u
      obtain ⟨c_ih, h_ih_supp, h_ih_eq⟩ := ih (n + 1) (by omega) γ'
      obtain ⟨c_new, h_new_supp, h_new_sum⟩ := h_glue n hn f_n c_ih h_ih_supp
      refine ⟨c_new, h_new_supp, ?_⟩
      rw [h_new_sum, ← hf_n, ← h_ih_eq, ← smul_add, ← hst, ← mul_nsmul', ← pow_succ]
  obtain ⟨γ_D, hγ_D⟩ := hInit
  obtain ⟨c₀, _, hc₀⟩ := h_tele D 0 (Nat.zero_add D) γ_D
  rw [hγ_D] at hc₀
  exact ⟨c₀, hc₀⟩

theorem weil_lefschetz_torsion_kunneth_bounded_cokernel (S S_W : AlgebraicGeometry.Scheme.{u})
    (pr₁ pr₂ : Quiver.Hom S_W S)
    (D ℓ r e : ℕ) [Fact (Nat.Prime ℓ)]
    (hModComp : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m k : ℕ),
      (∃ θ : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k,
        WeilIsModuleToTorsionComparison W m k θ ∧ Function.Bijective θ) ∧
      (∀ θ₁ θ₂ : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k,
        WeilIsModuleToTorsionComparison W m k θ₁ →
        WeilIsModuleToTorsionComparison W m k θ₂ →
        θ₁ = θ₂))
    (hPullEx : ∀ (W₁ W₂ : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W₁ W₂) (q : ℕ),
      ∃ p : weilEtaleTorsionH W₂ (ℓ ^ r) q →+ weilEtaleTorsionH W₁ (ℓ ^ r) q,
        WeilTopDegTorsionPullback h (ℓ ^ r) q p)
    (hLocConst : ∀ (q : ℕ), q ≤ D → ∀ (U : S.Etale),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) pr₁ :=
        ⟨fun _ _ => inferInstance⟩
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) pr₁ :=
        ⟨fun h hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback h hg⟩
      let B₁ : CategoryTheory.Functor S.Etale S_W.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ pr₁
      let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget S
      let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget S_W
      let U_W := (Fgt_W.obj (B₁.obj U)).left
      let π₂_U := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj U)).hom pr₂
      (Nonempty ↥(Fgt₁.obj U).left →
        ∀ (p_U : weilEtaleTorsionH S (ℓ ^ r) q →+ weilEtaleTorsionH U_W (ℓ ^ r) q),
          WeilTopDegTorsionPullback π₂_U (ℓ ^ r) q p_U → Function.Injective p_U) ∧
      (∀ ξ : weilEtaleTorsionH U_W (ℓ ^ r) q,
        ∃ S_cov ∈ S.smallEtaleTopology U,
          ∀ (V : S.Etale) (f : Quiver.Hom V U), S_cov.arrows f →
            let V_W := (Fgt_W.obj (B₁.obj V)).left
            let f_W : Quiver.Hom V_W U_W := (Fgt_W.map (B₁.map f)).left
            let π₂_V := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj V)).hom pr₂
            ∃ c : weilEtaleTorsionH S (ℓ ^ r) q,
              ∀ (p_f : weilEtaleTorsionH U_W (ℓ ^ r) q →+ weilEtaleTorsionH V_W (ℓ ^ r) q)
                (p_V : weilEtaleTorsionH S (ℓ ^ r) q →+ weilEtaleTorsionH V_W (ℓ ^ r) q),
                WeilTopDegTorsionPullback f_W (ℓ ^ r) q p_f →
                WeilTopDegTorsionPullback π₂_V (ℓ ^ r) q p_V →
                p_f ξ = p_V c))
    (b : ℕ → ℕ) (v : ∀ q : ℕ, Fin (b q) → weilEtaleTorsionH S (ℓ ^ r) q)
    (hInj : ∀ q : ℕ, q ≤ D → ∀ c : Fin (b q) → ZMod (ℓ ^ r),
      ∑ t : Fin (b q), (c t).val • v q t = 0 → c = 0)
    (hCoker : ∀ q : ℕ, q ≤ D → ∀ x : weilEtaleTorsionH S (ℓ ^ r) q,
      ∃ c : Fin (b q) → ZMod (ℓ ^ r), (ℓ ^ e) • x = ∑ t : Fin (b q), (c t).val • v q t)
    (p₁_r : ∀ i : ℕ, weilEtaleTorsionH S (ℓ ^ r) i →+ weilEtaleTorsionH S_W (ℓ ^ r) i)
    (hp₁_r : ∀ i : ℕ, WeilLefschetzTorsionPullback pr₁ (ℓ ^ r) i (p₁_r i))
    (p₂_r : ∀ j : ℕ, weilEtaleTorsionH S (ℓ ^ r) j →+ weilEtaleTorsionH S_W (ℓ ^ r) j)
    (hp₂_r : ∀ j : ℕ, WeilLefschetzTorsionPullback pr₂ (ℓ ^ r) j (p₂_r j))
    (cup_r : ∀ (i j : ℕ), i + j = D →
      weilEtaleTorsionH S_W (ℓ ^ r) i →+
        weilEtaleTorsionH S_W (ℓ ^ r) j →+ weilEtaleTorsionH S_W (ℓ ^ r) D)
    (hcup_r : ∀ (i j : ℕ) (hij : i + j = D),
      WeilLefschetzIsTorsionCup S_W (ℓ ^ r) i j D hij (cup_r i j hij))
    (z_r : weilEtaleTorsionH S_W (ℓ ^ r) D) :
    ∃ coeff : ∀ s : ↥(Finset.Iic D), Fin (b s.1) → Fin (b (D - s.1)) → ZMod (ℓ ^ r),
      (ℓ ^ (e * (D * D + D + 2))) • z_r =
        ∑ s : ↥(Finset.Iic D),
          ∑ t₁ : Fin (b s.1),
            ∑ t₂ : Fin (b (D - s.1)),
              (coeff s t₁ t₂).val •
                cup_r s.1 (D - s.1) (Nat.add_sub_of_le (Finset.mem_Iic.mp s.2))
                  (p₁_r s.1 (v s.1 t₁)) (p₂_r (D - s.1) (v (D - s.1) t₂)) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have hm₀ : 1 ≤ ℓ ^ r := Nat.one_le_pow r ℓ hPrime.pos
  have hNeZero : NeZero (ℓ ^ r) := ⟨by omega⟩
  have hAdjAb : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
      ∃ (hCont : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology),
        letI := hCont
        let P_push := (weilAltCdSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology
        ∃ (P_pull : CategoryTheory.Functor
              (CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
              (CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}))
          (_ : P_pull ⊣ P_push)
          (_ : P_pull.Additive)
          (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
          (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull), True := by
    intro S₁ S₂ h
    obtain ⟨hCont, P_pull, adj, hAdd, _, hLim, hColim, -⟩ :=
      weil_alt_cd_etale_pullback_adjunction_and_H0 h
    exact ⟨hCont, P_pull, adj, hAdd, hLim, hColim, trivial⟩
  have hModPullAll := fun {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) =>
    weil_kunneth_module_pullback_adjunction_and_intertwining (ℓ ^ r) hm₀ (@hAdjAb) h
  obtain ⟨hCont₁, P_pull₁, adj₁, hAdd₁, hLim₁, hColim₁, e_unit₁, hInj₁_map, hEv₁, hInt₁⟩ :=
    hModPullAll pr₁
  obtain ⟨_, hPullComp, hCupComp⟩ :=
    weil_kunneth_torsion_pullback_comp_and_cup_comparison.{u} (ℓ ^ r)
  obtain ⟨θ_S, hθ_S_comp, hθ_S_bij⟩ :
      ∃ θ_S : ∀ k : ℕ, weilEtaleModuleH S (ℓ ^ r) k →+ weilEtaleTorsionH S (ℓ ^ r) k,
        (∀ k : ℕ, WeilIsModuleToTorsionComparison S (ℓ ^ r) k (θ_S k)) ∧
        (∀ k : ℕ, Function.Bijective (θ_S k)) :=
    ⟨fun k => ((hModComp S (ℓ ^ r) k).1).choose,
     fun k => ((hModComp S (ℓ ^ r) k).1).choose_spec.1,
     fun k => ((hModComp S (ℓ ^ r) k).1).choose_spec.2⟩
  obtain ⟨θ_W, hθ_W_comp, hθ_W_bij⟩ :
      ∃ θ_W : ∀ k : ℕ, weilEtaleModuleH S_W (ℓ ^ r) k →+ weilEtaleTorsionH S_W (ℓ ^ r) k,
        (∀ k : ℕ, WeilIsModuleToTorsionComparison S_W (ℓ ^ r) k (θ_W k)) ∧
        (∀ k : ℕ, Function.Bijective (θ_W k)) :=
    ⟨fun k => ((hModComp S_W (ℓ ^ r) k).1).choose,
     fun k => ((hModComp S_W (ℓ ^ r) k).1).choose_spec.1,
     fun k => ((hModComp S_W (ℓ ^ r) k).1).choose_spec.2⟩
  have hCup_S_W : ∀ (i j : ℕ) (hij : i + j = D)
      (α : weilEtaleModuleH S_W (ℓ ^ r) i) (β : weilEtaleModuleH S_W (ℓ ^ r) j),
      cup_r i j hij (θ_W i α) (θ_W j β) = θ_W D (CategoryTheory.Abelian.Ext.comp α β hij) :=
    fun i j hij => hCupComp S_W i j D hij
      (fun k θ' θ'' h' h'' => (hModComp S_W (ℓ ^ r) k).2 θ' θ'' h' h'')
      ⟨θ_W 0, hθ_W_comp 0⟩
      (θ_W i) (θ_W j) (θ_W D) (cup_r i j hij)
      (hθ_W_comp i) (hθ_W_comp j) (hθ_W_comp D) (hcup_r i j hij)
  have hInt_p₁ : ∀ (i : ℕ) (γ : weilEtaleModuleH S (ℓ ^ r) i),
      θ_W i ((CategoryTheory.Abelian.Ext.mk₀ e_unit₁.inv).postcomp
        (weilEtaleModuleUnit S_W (ℓ ^ r)) (Nat.add_zero i)
        ((CategoryTheory.Abelian.Ext.mk₀ e_unit₁.hom).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull₁
            hAdd₁ hLim₁ hColim₁ _ _
            (weilEtaleModuleUnit S (ℓ ^ r)) (weilEtaleModuleUnit S (ℓ ^ r)) i) γ)
          (Nat.zero_add i))) = p₁_r i (θ_S i γ) :=
    fun i γ => hInt₁ i (θ_W i) (θ_S i) (p₁_r i) (hθ_W_comp i) (hθ_S_comp i) (Or.inr (hp₁_r i)) γ
  have hSlice_rep := weil_kunneth_etale_slice_cosyzygy_representation S_W (ℓ ^ r) hm₀
    (fun W k => hModComp W (ℓ ^ r) k) (@hModPullAll)
  have hSheaf_basis := fun (b_q : ℕ) =>
    weil_kunneth_sheaf_cohomology_basis_mono_and_coker S (ℓ ^ r) (ℓ ^ e) b_q hm₀
  suffices h_fast :
      ∀ (m₀ : ℕ) [NeZero m₀]
        (H_tor : AlgebraicGeometry.Scheme.{u} → ℕ → Type u)
        [∀ W q, AddCommGroup (H_tor W q)]
        (IsTopPull : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}},
          Quiver.Hom W₁ W₂ → ∀ q : ℕ, (H_tor W₂ q →+ H_tor W₁ q) → Prop)
        (IsLefPull : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}},
          Quiver.Hom W₁ W₂ → ∀ q : ℕ, (H_tor W₂ q →+ H_tor W₁ q) → Prop)
