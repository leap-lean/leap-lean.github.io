      have hDom_U : IsDomain ↑(X.left.presheaf.obj (Opposite.op U)) := hDom_of_ne U hNeU
      have hDom_W12 : IsDomain ↑(X.left.presheaf.obj (Opposite.op W_12)) := hDom_of_ne W_12 hNe_W12
      let u_V : Fin d → ↑(X.left.presheaf.obj (Opposite.op V)) :=
        fun i => ψ_V (MvPolynomial.X i)
      have hu_V : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg V) u_V :=
        @hs5_et ↑(X.left.presheaf.obj (Opposite.op V)) _ hDom_V (kAlg V) ψ_V hEt_V
      let u_U : Fin d → ↑(X.left.presheaf.obj (Opposite.op U)) :=
        fun i => (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app φ V)) (u_V i)
      have hu_U : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg U) u_U :=
        @hs5_alg ↑(X.left.presheaf.obj (Opposite.op V))
          ↑(X.left.presheaf.obj (Opposite.op U)) _ hDom_V (kAlg V) _ hDom_U (kAlg U)
          phiAlgHom u_V hφ_V_inj hφ_V_alg hu_V
      let u_1 : Fin d → ↑(X.left.presheaf.obj (Opposite.op W_12)) :=
        fun i => (CommRingCat.Hom.hom
          (X.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE hW12_le_U)))) (u_U i)
      have hu_1 : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W_12) u_1 :=
        @hs5_alg ↑(X.left.presheaf.obj (Opposite.op U))
          ↑(X.left.presheaf.obj (Opposite.op W_12)) _ hDom_U (kAlg U) _ hDom_W12 (kAlg W_12)
          (resAlgHom W_12 U hW12_le_U) u_U
          (hRes_inj_alg W_12 U hAff_W12 hNe_W12 hAff_U hNeU hW12_le_U).1
          (hRes_inj_alg W_12 U hAff_W12 hNe_W12 hAff_U hNeU hW12_le_U).2 hu_U
      let u_2 : Fin d → ↑(X.left.presheaf.obj (Opposite.op W_12)) :=
        fun i => (CommRingCat.Hom.hom
          (X.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE hW12_le_V)))) (u_V i)
      have hu_2 : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W_12) u_2 :=
        @hs5_alg ↑(X.left.presheaf.obj (Opposite.op V))
          ↑(X.left.presheaf.obj (Opposite.op W_12)) _ hDom_V (kAlg V) _ hDom_W12 (kAlg W_12)
          (resAlgHom W_12 V hW12_le_V) u_V
          (hRes_inj_alg W_12 V hAff_W12 hNe_W12 hAff_V hNeV hW12_le_V).1
          (hRes_inj_alg W_12 V hAff_W12 hNe_W12 hAff_V hNeV hW12_le_V).2 hu_V
      
      obtain ⟨N_ch, w_ch, hw0, hwN, hw_tb, hw_step⟩ :=
        @hs5_chain ↑(X.left.presheaf.obj (Opposite.op W_12)) _ hDom_W12 (kAlg W_12)
          u_1 u_2 hu_1 hu_2
      have h_chain_eq : ∀ (m : ℕ) (hm : m ≤ N_ch),
          t_X W_12 hAff_W12 hNe_W12 (w_ch ⟨m, Nat.lt_succ_of_le hm⟩)
            (hw_tb ⟨m, Nat.lt_succ_of_le hm⟩) =
          t_X W_12 hAff_W12 hNe_W12 (w_ch 0) (hw_tb 0) := by
        intro m
        induction m with
        | zero =>
          intro _
          rfl
        | succ m ih =>
          intro hm
          let s : Fin N_ch := ⟨m, hm⟩
          obtain ⟨i₀, hi₀⟩ := hw_step s
          have hstep_eq : t_X W_12 hAff_W12 hNe_W12 (w_ch s.succ) (hw_tb s.succ) =
              t_X W_12 hAff_W12 hNe_W12 (w_ch s.castSucc) (hw_tb s.castSucc) :=
            ht_step W_12 hAff_W12 hNe_W12 (w_ch s.succ) (w_ch s.castSucc)
              (hw_tb s.succ) (hw_tb s.castSucc) i₀ hi₀
          exact hstep_eq.trans (ih (Nat.le_of_succ_le hm))
      have ht_congr : ∀ (v₁ v₂ : Fin d → ↑(X.left.presheaf.obj (Opposite.op W_12)))
          (heq : v₁ = v₂)
          (hv₁ : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W_12) v₁)
          (hv₂ : @IsTranscendenceBasis (Fin d) k _ _ _ (kAlg W_12) v₂),
          t_X W_12 hAff_W12 hNe_W12 v₁ hv₁ = t_X W_12 hAff_W12 hNe_W12 v₂ hv₂ := by
        rintro v₁ _ rfl hv₁ hv₂
        rfl
      have ht_u1_u2 : t_X W_12 hAff_W12 hNe_W12 u_1 hu_1 =
          t_X W_12 hAff_W12 hNe_W12 u_2 hu_2 := by
        calc
          t_X W_12 hAff_W12 hNe_W12 u_1 hu_1
            = t_X W_12 hAff_W12 hNe_W12 (w_ch 0) (hw_tb 0) :=
              ht_congr u_1 (w_ch 0) hw0.symm hu_1 (hw_tb 0)
          _ = t_X W_12 hAff_W12 hNe_W12 (w_ch (Fin.last N_ch)) (hw_tb (Fin.last N_ch)) :=
              (h_chain_eq N_ch le_rfl).symm
          _ = t_X W_12 hAff_W12 hNe_W12 u_2 hu_2 :=
              ht_congr (w_ch (Fin.last N_ch)) u_2 hwN (hw_tb (Fin.last N_ch)) hu_2
      let Tr_X : weilEtaleTorsionH X.left n (2 * d) →+ ZMod n :=
        t_X V hAff_V hNeV u_V hu_V
      have hTr_push : Tr_X.comp φ_shriek = Tr_X := by
        calc
          Tr_X.comp φ_shriek
            = t_X U hAff_U hNeU u_U hu_U :=
              ht_push δ hδ_pos φ hφ_over ⟨hφ_fin, hφ_charts⟩ φ_shriek hφ_shriek
                V hAff_V hNeV hAff_U hNeU u_V hu_V hu_U
          _ = t_X W_12 hAff_W12 hNe_W12 u_1 hu_1 :=
              (ht_shrink W_12 U hAff_W12 hNe_W12 hAff_U hNeU hW12_le_U u_U hu_U hu_1).symm
          _ = t_X W_12 hAff_W12 hNe_W12 u_2 hu_2 := ht_u1_u2
          _ = Tr_X :=
              ht_shrink W_12 V hAff_W12 hNe_W12 hAff_V hNeV hW12_le_V u_V hu_V hu_2
      
      have hSurj_Tr : Function.Surjective Tr_X :=
        ht_surj V hAff_V hNeV ψ_V hEt_V hu_V
      let e_pd : weilEtaleTorsionH X.left n (2 * d) ≃ ZMod n :=
        Equiv.ofBijective (tr_pd r) (hBij_pd r)
      have _ : NeZero n := ⟨by omega⟩
      have hSurj_comp : Function.Surjective (fun z : ZMod n => Tr_X (e_pd.symm z)) :=
        hSurj_Tr.comp e_pd.symm.surjective
      have hBij_comp : Function.Bijective (fun z : ZMod n => Tr_X (e_pd.symm z)) :=
        Finite.surjective_iff_bijective.mp hSurj_comp
      have hInj_Tr : Function.Injective Tr_X := by
        intro a b hab
        apply e_pd.injective
        apply hBij_comp.1
        dsimp
        rw [e_pd.symm_apply_apply, e_pd.symm_apply_apply, hab]
      apply hInj_Tr
      calc
        Tr_X (p_top w) = (Tr_X.comp φ_shriek) (p_top w) := by rw [hTr_push]
        _ = Tr_X (φ_shriek (p_top w)) := rfl
        _ = Tr_X (δ • w) := by rw [hdeg]

theorem weil_etale_top_degree_geom_frob_smul (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Z.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (r : ℕ)
    (f_top : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) (2 * d) →+
      weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) (2 * d))
    (hf_top : WeilIsTorsionGeomFrobAction K Z (ℓ ^ r) (2 * d) f_top)
    (w : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) (2 * d)) :
    f_top w = (Nat.card K ^ d) • w :=
by
  let k_bar : Type u := AlgebraicClosure K
  let X_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k_bar)) :=
    weilBaseChangeOver K k_bar Z
  let S : AlgebraicGeometry.Scheme.{u} := weilGeomScheme K Z
  obtain ⟨hIntS, hPropS, hSmS⟩ := weil_smooth_algClosure_baseChange_integral K Z d
  have : AlgebraicGeometry.IsProper X_bar.hom := hPropS
  have : AlgebraicGeometry.SmoothOfRelativeDimension d X_bar.hom := hSmS
  have hchar_kbar : CharP k_bar (ringChar K) :=
    (RingHom.charP_iff_charP (algebraMap K k_bar) (ringChar K)).mp inferInstance
  have hchar_eq : ringChar k_bar = ringChar K :=
    @ringChar.eq k_bar _ (ringChar K) hchar_kbar
  have hℓ_bar : ℓ ≠ ringChar k_bar := by
    rw [hchar_eq]
    exact hℓ
  obtain ⟨hPullComp, hPullFrob⟩ := weil_top_deg_torsion_pullback_functoriality.{u}
  obtain ⟨p, ν, φ_abs, φ_rel, hp_prime, hφ_abs, hFactor, hφ_over, hφ_free⟩ :=
    weil_rel_frob_factorization_and_locally_free_rank K Z d
  have : Fact (Nat.Prime p) := ⟨hp_prime⟩
  have hPull_abs : WeilTopDegTorsionPullback φ_abs (ℓ ^ r) (2 * d) (AddMonoidHom.id _) :=
    weil_abs_frob_pow_torsion_pullback_id p ν (ℓ ^ r) (2 * d) S φ_abs hφ_abs
  have hPull_g : WeilTopDegTorsionPullback (weilGeomFrobHom K Z) (ℓ ^ r) (2 * d) f_top :=
    hPullFrob K Z (ℓ ^ r) (2 * d) f_top hf_top
  have hPull_rel : WeilTopDegTorsionPullback φ_rel (ℓ ^ r) (2 * d) f_top := by
    have hcomp := hPullComp φ_abs (weilGeomFrobHom K Z) (ℓ ^ r) (2 * d)
      (AddMonoidHom.id _) f_top hPull_abs hPull_g
    rwa [hFactor, AddMonoidHom.id_comp] at hcomp
  exact weil_etale_top_degree_finite_free_k_hom_smul k_bar X_bar hIntS d ℓ hℓ_bar
    r (Nat.card K ^ d) φ_rel hφ_over hφ_free f_top hPull_rel w

theorem weil_ell_adic_poincare_pairing_of_torsion_system (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (d ℓ i j : ℕ) [Fact (Nat.Prime ℓ)]
    (Mi : WeilEllAdicCohomologyModel K Z ℓ i)
    (Mj : WeilEllAdicCohomologyModel K Z ℓ j)
    (hFin : ∀ (k r : ℕ), Finite (weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) k))
    (hFrobTrans_i : ∀ (r : ℕ) (a : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) i),
      weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r i (Mi.frobTorsion (r + 1) a) =
        Mi.frobTorsion r (weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r i a))
    (hFrobTrans_j : ∀ (r : ℕ) (b : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) j),
      weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r j (Mj.frobTorsion (r + 1) b) =
        Mj.frobTorsion r (weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r j b))
    (pair : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i →+
      weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) j →+ ZMod (ℓ ^ r))
    (hCompat : ∀ (r : ℕ) (a : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) i)
      (b : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) j),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (pair (r + 1) a b) =
        pair r (weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r i a)
          (weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r j b))
    (hLeft : ∀ (r : ℕ) (a : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i),
      (∀ b : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) j, pair r a b = 0) → a = 0)
    (hRight : ∀ (r : ℕ) (b : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) j),
      (∀ a : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i, pair r a b = 0) → b = 0)
    (hFrob : ∀ (r : ℕ) (a : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i)
      (b : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) j),
      pair r (Mi.frobTorsion r a) (Mj.frobTorsion r b) =
        ((Nat.card K : ZMod (ℓ ^ r)) ^ d) * pair r a b) :
    ∃ B : Mi.V →ₗ[Padic ℓ] Mj.V →ₗ[Padic ℓ] Padic ℓ,
      Function.Bijective B ∧
      ∀ (x : Mi.V) (y : Mj.V),
        B (Mi.frob x) (Mj.frob y) = (Nat.card K : Padic ℓ) ^ d * B x y :=
by
  classical
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hℓ_prime.pos
  have hℓ_ne : ℓ ≠ 0 := hℓ_prime.ne_zero
  
  have hStage1 : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      ∃ resH : ∀ (k : ℕ) {a b : ℕ}, a ≤ b →
          weilEtaleTorsionH S (ℓ ^ b) k →+ weilEtaleTorsionH S (ℓ ^ a) k,
        (∀ (k r : ℕ) (u : weilEtaleTorsionH S (ℓ ^ (r + 1)) k),
          resH k (Nat.le_succ r) u = weilEtaleTorsionTransition S ℓ r k u) ∧
        (∀ (k r : ℕ) (w : weilEtaleTorsionH S (ℓ ^ r) k), (ℓ ^ r) • w = 0) ∧
        (∀ (k : ℕ) {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c)
          (u : weilEtaleTorsionH S (ℓ ^ c) k),
          resH k hab (resH k hbc u) = resH k (le_trans hab hbc) u) ∧
        (∀ k : ℕ, ∃ (ι : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) k →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) k)
          (ρ : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ (r + 1)) k →+ weilEtaleTorsionH S (ℓ ^ 1) k),
          (∀ (r : ℕ) (x : weilEtaleTorsionH S (ℓ ^ (r + 1)) k),
            ρ r x = 0 → ∃ y : weilEtaleTorsionH S (ℓ ^ r) k, ι r y = x) ∧
          (∀ (r : ℕ) (y : weilEtaleTorsionH S (ℓ ^ (r + 1)) k),
            weilEtaleTorsionTransition S ℓ (r + 1) k (ι (r + 1) y) =
              ι r (weilEtaleTorsionTransition S ℓ r k y)) ∧
          (∀ (r : ℕ) (x : weilEtaleTorsionH S (ℓ ^ (r + 1)) k),
            ι r (weilEtaleTorsionTransition S ℓ r k x) = ℓ • x) ∧
          (∀ (r : ℕ) (x : weilEtaleTorsionH S (ℓ ^ (r + 2)) k),
            ρ (r + 1) x = ρ r (weilEtaleTorsionTransition S ℓ (r + 1) k x))) ∧
        (∀ m : ℕ, ∃ (Δ : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) m →+
            ↥(weilEtaleIntegralSystem S ℓ (m + 1))),
          ∀ (r : ℕ) (v : weilEtaleTorsionH S (ℓ ^ r) m),
            Δ r v = 0 → ∀ s : ℕ, ∃ w : weilEtaleTorsionH S (ℓ ^ (r + s)) m,
              resH m (Nat.le_add_right r s) w = v) := by
    intro S
    have hmemSysS : ∀ (k : ℕ) (f : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) k),
        f ∈ weilEtaleIntegralSystem S ℓ k ↔
        ∀ r : ℕ, weilEtaleTorsionTransition S ℓ r k (f (r + 1)) = f r := by
      intro k f
      rw [weilEtaleIntegralSystem, AddMonoidHom.mem_ker, funext_iff]
      exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
    let J := S.smallEtaleTopology
    let D := AddCommGrpCat.{u}
    let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
    let C := CategoryTheory.constantSheaf J D
    have hClim : CategoryTheory.Limits.PreservesFiniteLimits C :=
      CategoryTheory.Limits.comp_preservesFiniteLimits
        (CategoryTheory.Functor.const (S.Etale)ᵒᵖ) (CategoryTheory.presheafToSheaf J D)
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let resH (k : ℕ) {a b : ℕ} (hab : a ≤ b) :
        weilEtaleTorsionH S (ℓ ^ b) k →+ weilEtaleTorsionH S (ℓ ^ a) k :=
      (CategoryTheory.Abelian.Ext.mk₀
        (C.map (U_lift.map (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ hab) (ZMod (ℓ ^ a))).toAddMonoidHom)))).postcomp
        Fℤ (Nat.add_zero k)
    have hExt_nsmul : ∀ {Y : CategoryTheory.Sheaf J D} {k : ℕ}
        (w : CategoryTheory.Abelian.Ext Fℤ Y k) (n : ℕ),
        w.comp (CategoryTheory.Abelian.Ext.mk₀ (n • 𝟙 Y)) (Nat.add_zero k) = n • w := by
      intro Y k w n
      induction n with
      | zero =>
        rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
          ih, CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
    have hTors : ∀ (k r : ℕ) (w : weilEtaleTorsionH S (ℓ ^ r) k), (ℓ ^ r) • w = 0 := by
      intro k r w
      let m := ℓ ^ r
      let Z_m := AddCommGrpCat.of (ZMod m)
      have hZ_zero : m • (𝟙 Z_m) = 0 := by
        ext a
        change m • a = 0
        rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
      have hFM_zero : m • (𝟙 (weilEtaleTorsionSheaf S m)) = 0 := by
        change m • (𝟙 (C.obj (U_lift.obj Z_m))) = 0
        rw [← C.map_id, ← U_lift.map_id, ← Functor.map_nsmul, ← Functor.map_nsmul,
          hZ_zero, Functor.map_zero, Functor.map_zero]
      rw [← hExt_nsmul w m, hFM_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    let ZObj (n : ℕ) : AddCommGrpCat.{0} := AddCommGrpCat.of (ZMod n)
    let π_zmod {a b : ℕ} (hab : a ≤ b) : ZMod (ℓ ^ b) →+ ZMod (ℓ ^ a) :=
      (ZMod.castHom (pow_dvd_pow ℓ hab) (ZMod (ℓ ^ a))).toAddMonoidHom
    have hπ_nat : ∀ {a b : ℕ} (hab : a ≤ b) (n : ℕ),
        π_zmod hab (n : ZMod (ℓ ^ b)) = (n : ZMod (ℓ ^ a)) :=
      fun {a _} hab n => map_natCast (ZMod.castHom (pow_dvd_pow ℓ hab) (ZMod (ℓ ^ a))) n
    let π_cat {a b : ℕ} (hab : a ≤ b) : ZObj (ℓ ^ b) ⟶ ZObj (ℓ ^ a) :=
      AddCommGrpCat.ofHom (π_zmod hab)
    let π_sh {a b : ℕ} (hab : a ≤ b) :
        weilEtaleTorsionSheaf S (ℓ ^ b) ⟶ weilEtaleTorsionSheaf S (ℓ ^ a) :=
      C.map (U_lift.map (π_cat hab))
    have hres_comp : ∀ (k : ℕ) {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c)
        (u : weilEtaleTorsionH S (ℓ ^ c) k),
        resH k hab (resH k hbc u) = resH k (le_trans hab hbc) u := by
      intro k a b c hab hbc u
      have hcat : π_cat hbc ≫ π_cat hab = π_cat (le_trans hab hbc) := by
        ext x
        have : NeZero (ℓ ^ c) := ⟨pow_ne_zero c hℓ_ne⟩
        have hx : (x.val : ZMod (ℓ ^ c)) = x := ZMod.natCast_zmod_val x
        change π_zmod hab (π_zmod hbc x) = π_zmod (le_trans hab hbc) x
        rw [← hx, hπ_nat hbc x.val, hπ_nat hab x.val, hπ_nat (le_trans hab hbc) x.val]
      have hsh : π_sh hbc ≫ π_sh hab = π_sh (le_trans hab hbc) := by
        dsimp [π_sh]
        rw [← C.map_comp, ← U_lift.map_comp, hcat]
      change (u.comp (CategoryTheory.Abelian.Ext.mk₀ (π_sh hbc)) (Nat.add_zero k)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_sh hab)) (Nat.add_zero k) =
        u.comp (CategoryTheory.Abelian.Ext.mk₀ (π_sh (le_trans hab hbc))) (Nat.add_zero k)
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero k) (Nat.zero_add 0) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hsh]
    let mulSubGen (a b c : ℕ) (habc : a + b = c) :
        { f : ℤ →+ ZMod (ℓ ^ c) // f (ℓ ^ b : ℕ) = 0 } :=
      ⟨{ toFun := fun z : ℤ => (((ℓ ^ a : ℕ) : ℤ) * z : ZMod (ℓ ^ c))
         map_zero' := by simp
         map_add' := fun x y => by push_cast; ring }, by
        change (((ℓ ^ a : ℕ) : ℤ) * ((ℓ ^ b : ℕ) : ℤ) : ZMod (ℓ ^ c)) = 0
