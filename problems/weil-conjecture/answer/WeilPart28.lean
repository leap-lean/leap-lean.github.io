        smul_add := fun z x₁ x₂ => Subtype.ext (funext fun r => by
          change (PadicInt.toZModPow r z).val • (x₁.1 r + x₂.1 r) =
            (PadicInt.toZModPow r z).val • x₁.1 r + (PadicInt.toZModPow r z).val • x₂.1 r
