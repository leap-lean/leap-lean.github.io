  let adjOfIsoRight_ab :
      ∀ {ℰ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} ℰ]
        {F : CategoryTheory.Functor AddCommGrpCat.{u} ℰ}
        {G H : CategoryTheory.Functor ℰ AddCommGrpCat.{u}}
        (adj : F ⊣ G) (e : G ≅ H), F ⊣ H :=
    fun {ℰ} _ {F G H} adj e =>
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun X Y =>
            (adj.homEquiv X Y).trans
              { toFun := fun g => CategoryTheory.CategoryStruct.comp g (e.hom.app Y)
                invFun := fun g => CategoryTheory.CategoryStruct.comp g (e.inv.app Y)
                left_inv := fun g => by
                  dsimp only
                  rw [CategoryTheory.Category.assoc, e.hom_inv_id_app Y,
                    CategoryTheory.Category.comp_id]
                right_inv := fun g => by
                  dsimp only
                  rw [CategoryTheory.Category.assoc, e.inv_hom_id_app Y,
                    CategoryTheory.Category.comp_id] }
          homEquiv_naturality_left_symm := fun {X' X Y} f g => by
            change (adj.homEquiv X' Y).symm
                (CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp f g) (e.inv.app Y)) =
              CategoryTheory.CategoryStruct.comp (F.map f)
                ((adj.homEquiv X Y).symm
                  (CategoryTheory.CategoryStruct.comp g (e.inv.app Y)))
            rw [CategoryTheory.Category.assoc, adj.homEquiv_naturality_left_symm]
          homEquiv_naturality_right := fun {X Y Y'} f g => by
            change CategoryTheory.CategoryStruct.comp
                ((adj.homEquiv X Y') (CategoryTheory.CategoryStruct.comp f g)) (e.hom.app Y') =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp ((adj.homEquiv X Y) f) (e.hom.app Y))
                (H.map g)
            rw [adj.homEquiv_naturality_right, CategoryTheory.Category.assoc,
              e.hom.naturality g, ← CategoryTheory.Category.assoc] }

