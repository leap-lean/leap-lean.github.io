      let e₁ := (hSE_Z W₁).extClass
      let w_r := CategoryTheory.Abelian.Ext.mk₀ (π_mate (AM (ℓ ^ r)))
      let w_1 := CategoryTheory.Abelian.Ext.mk₀ (π_mate (AM ℓ))
      have hExtNat : e₂.comp w_r (Nat.add_zero 1) = w_1.comp e₁ (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pull (hSE_Z W₁) Ψ_h
      change (u.comp ((P_pull.mapExtAddHom (Fℤ W₂) ((C_shf W₂).obj (AM (ℓ ^ r))) (q + 1))
          (c.comp (hSE_Z W₂).extClass rfl)) (Nat.zero_add (q + 1))).comp w_r
          (Nat.add_zero (q + 1)) =
        ((u.comp ((P_pull.mapExtAddHom (Fℤ W₂) ((C_shf W₂).obj (AM ℓ)) q) c)
          (Nat.zero_add q)).comp w_1 (Nat.add_zero q)).comp e₁ rfl
      exact calc
        (u.comp ((P_pull.mapExtAddHom (Fℤ W₂) ((C_shf W₂).obj (AM (ℓ ^ r))) (q + 1))
            (c.comp (hSE_Z W₂).extClass rfl)) (Nat.zero_add (q + 1))).comp w_r
            (Nat.add_zero (q + 1))
            = (u.comp (v.comp e₂ rfl) (Nat.zero_add (q + 1))).comp w_r
                (Nat.add_zero (q + 1)) := by
                dsimp only [v, e₂]
                rw [CategoryTheory.Functor.mapExtAddHom_apply,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
                  CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        _ = u.comp ((v.comp e₂ rfl).comp w_r (Nat.add_zero (q + 1))) (Nat.zero_add (q + 1)) :=
              CategoryTheory.Abelian.Ext.comp_assoc u (v.comp e₂ rfl) w_r
                (Nat.zero_add (q + 1)) (Nat.add_zero (q + 1))
                (by omega : 0 + (q + 1) + 0 = q + 1)
        _ = u.comp (v.comp (e₂.comp w_r (Nat.add_zero 1)) rfl) (Nat.zero_add (q + 1)) :=
              congrArg (fun t => u.comp t (Nat.zero_add (q + 1)))
                (CategoryTheory.Abelian.Ext.comp_assoc v e₂ w_r
                  (rfl : q + 1 = q + 1) (Nat.add_zero 1) (by omega : q + 1 + 0 = q + 1))
        _ = u.comp (v.comp (w_1.comp e₁ (Nat.zero_add 1)) rfl) (Nat.zero_add (q + 1)) := by
              rw [hExtNat]
        _ = u.comp ((v.comp w_1 (Nat.add_zero q)).comp e₁ rfl) (Nat.zero_add (q + 1)) :=
              congrArg (fun t => u.comp t (Nat.zero_add (q + 1)))
                (CategoryTheory.Abelian.Ext.comp_assoc v w_1 e₁
                  (Nat.add_zero q) (Nat.zero_add 1) (by omega : q + 0 + 1 = q + 1)).symm
        _ = (u.comp (v.comp w_1 (Nat.add_zero q)) (Nat.zero_add q)).comp e₁ rfl :=
              (CategoryTheory.Abelian.Ext.comp_assoc u (v.comp w_1 (Nat.add_zero q)) e₁
                (Nat.zero_add q) (rfl : q + 1 = q + 1) (by omega : 0 + q + 1 = q + 1)).symm
        _ = ((u.comp v (Nat.zero_add q)).comp w_1 (Nat.add_zero q)).comp e₁ rfl :=
              congrArg (fun t => t.comp e₁ rfl)
                (CategoryTheory.Abelian.Ext.comp_assoc u v w_1
                  (Nat.zero_add q) (Nat.add_zero q) (by omega : 0 + q + 0 = q)).symm
        _ = ((u.comp ((P_pull.mapExtAddHom (Fℤ W₂) ((C_shf W₂).obj (AM ℓ)) q) c)
              (Nat.zero_add q)).comp w_1 (Nat.add_zero q)).comp e₁ rfl := by
                dsimp only [v]
                rw [CategoryTheory.Functor.mapExtAddHom_apply]

theorem weil_abelian_ext_mapExactFunctor_natIso {C_ab D_ab : Type (u + 1)}
    [CategoryTheory.Category.{u + 1, u + 1} C_ab] [CategoryTheory.Abelian C_ab]
    [CategoryTheory.HasExt.{u} C_ab] [CategoryTheory.EnoughInjectives C_ab]
    [CategoryTheory.Category.{u + 1, u + 1} D_ab] [CategoryTheory.Abelian D_ab]
    [CategoryTheory.HasExt.{u} D_ab]
    (F₁ F₂ : CategoryTheory.Functor C_ab D_ab)
    [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
    [CategoryTheory.Limits.PreservesFiniteColimits F₁]
    [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
    [CategoryTheory.Limits.PreservesFiniteColimits F₂]
    (η : F₁ ≅ F₂) (q : ℕ) (X Y : C_ab) (x : CategoryTheory.Abelian.Ext.{u} X Y q) :
    (F₁.mapExtAddHom X Y q) x =
      (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
        (((F₂.mapExtAddHom X Y q) x).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q))
        (Nat.zero_add q) :=
by
  have hNat : ∀ (n : ℕ) (A B : C_ab) (e : CategoryTheory.Abelian.Ext.{u} A B n),
      (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ e).comp
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero n) =
      (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app A)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ e) (Nat.zero_add n) := by
    intro n
    induction n with
    | zero =>
      intro A B e
      let f : A ⟶ B := CategoryTheory.Abelian.Ext.addEquiv₀ e
      have hf : CategoryTheory.Abelian.Ext.mk₀ f = e :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply e
      rw [← hf, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        η.hom.naturality f]
    | succ k ih =>
      intro A B e
      let I : C_ab := CategoryTheory.Injective.under B
      let ι : B ⟶ I := CategoryTheory.Injective.ι B
      let Q : C_ab := CategoryTheory.Limits.cokernel ι
      let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S_c : CategoryTheory.ShortComplex C_ab :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hExact : S_c.Exact :=
        CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_c
          (CategoryTheory.Limits.cokernelIsCokernel ι)
      have hMono : CategoryTheory.Mono S_c.f := by dsimp [S_c]; infer_instance
      have hEpi : CategoryTheory.Epi S_c.g := by dsimp [S_c]; infer_instance
      have hS : S_c.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi
      have hInj : CategoryTheory.Injective S_c.X₂ := by dsimp [S_c, I]; infer_instance
      have hZero : e.comp (CategoryTheory.Abelian.Ext.mk₀ S_c.f) (Nat.add_zero (k + 1)) = 0 :=
        @CategoryTheory.Abelian.Ext.eq_zero_of_injective _ _ _ _ A S_c.X₂ k hInj _
      obtain ⟨z, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS e hZero (rfl : k + 1 = k + 1)
      have hS₁ : (S_c.map F₁).ShortExact := hS.map_of_exact F₁
      have hS₂ : (S_c.map F₂).ShortExact := hS.map_of_exact F₂
      let τ : S_c.map F₁ ⟶ S_c.map F₂ := S_c.mapNatTrans η.hom
      have hExtNat :
          hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Q)).comp hS₂.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₁ hS₂ τ
      calc
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ (z.comp hS.extClass rfl)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero (k + 1))
          = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z).comp hS₁.extClass rfl).comp
              (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero (k + 1)) := by
            rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z).comp
              (hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero 1))
              rfl :=
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl
        _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z).comp
              ((CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Q)).comp hS₂.extClass (Nat.zero_add 1))
              rfl := by
            rw [hExtNat]
        _ = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z).comp
              (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Q)) (Nat.add_zero k)).comp
              hS₂.extClass rfl :=
            (CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl).symm
        _ = ((CategoryTheory.Abelian.Ext.mk₀ (η.hom.app A)).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ z) (Nat.zero_add k)).comp
              hS₂.extClass rfl := by
            rw [ih A Q z]
        _ = (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app A)).comp
              ((CategoryTheory.Abelian.Ext.mapExactFunctor F₂ z).comp hS₂.extClass rfl)
              (Nat.zero_add (k + 1)) :=
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add k) rfl
              (congrArg (· + 1) (Nat.zero_add k))
        _ = (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app A)).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ (z.comp hS.extClass rfl))
              (Nat.zero_add (k + 1)) := by
            rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
  rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply]
  calc
    CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x
      = (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x).comp
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 (F₁.obj Y))) (Nat.add_zero q) :=
        (CategoryTheory.Abelian.Ext.comp_mk₀_id _).symm
    _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y ≫ η.inv.app Y)) (Nat.add_zero q) := by
        rw [η.hom_inv_id_app Y]
    _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x).comp
          ((CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.zero_add 0))
          (Nat.add_zero q) := by
        rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    _ = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q) :=
        (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q)).symm
    _ = ((CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ x) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q) := by
        rw [hNat q X Y x]
    _ = (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
          ((CategoryTheory.Abelian.Ext.mapExactFunctor F₂ x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q))
          (Nat.zero_add q) :=
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q)

theorem weil_etale_pullback_leftAdjoint_mate_iso {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let J₁ := W₁.smallEtaleTopology
    let J₂ := W₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    ∀ [hCont : B.IsContinuous J₂ J₁],
      let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      ∀ (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
        (adj_pull : CategoryTheory.Adjunction P_pull P_push)
        [P_pull.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits P_pull]
        [CategoryTheory.Limits.PreservesFiniteColimits P_pull]
        (T₁ : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
        ∃ (hRightAdj : P_push.IsRightAdjoint),
          letI := hRightAdj
          let P_pull' := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
          let adj_pull' := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
          ∃ (_ : P_pull'.Additive)
            (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull')
            (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull')
            (η : P_pull ≅ P_pull'),
            ∀ (A : AddCommGrpCat.{u}),
              let u_A := (adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
                (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
                  ((C₁.obj A).obj.map (Opposite.op τ)))
              (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm u_A =
                CategoryTheory.CategoryStruct.comp (η.hom.app (C₂.obj A))
                  ((adj_pull'.homEquiv (C₂.obj A) (C₁.obj A)).symm u_A) :=
by
  intro B J₁ J₂ C₁ C₂ _hCont P_push P_pull adj_pull _hAdd _hLim _hColim _T₁ _hT₁ _T₂ _hT₂ _adj₁ _adj₂ _τ
  have hRightAdj : P_push.IsRightAdjoint := adj_pull.isRightAdjoint
  refine ⟨hRightAdj, ?_⟩
  intro P_pull' adj_pull'
  let η : P_pull ≅ P_pull' := CategoryTheory.Adjunction.leftAdjointUniq adj_pull adj_pull'
  refine ⟨CategoryTheory.Functor.additive_of_iso η,
    CategoryTheory.Limits.preservesFiniteLimits_of_natIso η,
    CategoryTheory.Limits.preservesFiniteColimits_of_natIso η,
    η, ?_⟩
  intro A u_A
  apply (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).injective
  rw [(adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).apply_symm_apply]
  change u_A = (adj_pull.homEquiv (C₂.obj A) (C₁.obj A))
    (η.hom.app (C₂.obj A) ≫ (adj_pull'.homEquiv (C₂.obj A) (C₁.obj A)).symm u_A)
  rw [CategoryTheory.Adjunction.homEquiv_unit, P_push.map_comp, ← CategoryTheory.Category.assoc,
    CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj_pull adj_pull' (C₂.obj A),
    ← CategoryTheory.Adjunction.homEquiv_unit,
    (adj_pull'.homEquiv (C₂.obj A) (C₁.obj A)).apply_symm_apply]

theorem weil_etale_cohomologyPresheaf_scheme_iso (X : AlgebraicGeometry.Scheme.{u}) (m₀ q : ℕ) :
    let F_X := weilEtaleTorsionSheaf X m₀
    let P_cohom := CategoryTheory.Sheaf.cohomologyPresheaf F_X q
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
    ∃ (e : ∀ W : X.Etale,
        ↥(P_cohom.obj (Opposite.op W)) ≃+ weilEtaleTorsionH (Fgt.obj W).left m₀ q),
      ∀ {W' W : X.Etale} (g : Quiver.Hom W' W)
        (p_g : weilEtaleTorsionH (Fgt.obj W).left m₀ q →+
          weilEtaleTorsionH (Fgt.obj W').left m₀ q),
        WeilTopDegTorsionPullback (Fgt.map g).left m₀ q p_g →
        ∀ x : ↥(P_cohom.obj (Opposite.op W)),
          e W' ((P_cohom.map (Opposite.op g)).hom x) = p_g (e W x) :=
by
  intro F_X P_cohom Fgt
  obtain ⟨hSlice, -⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.{u}
  obtain ⟨Θ, hΘ⟩ := hSlice X m₀ q
  refine ⟨Θ, fun {W' W} g p_g hp_g x => hΘ g p_g ?_ x⟩
  let W₁ : AlgebraicGeometry.Scheme.{u} := (Fgt.obj W').left
  let W₂ : AlgebraicGeometry.Scheme.{u} := (Fgt.obj W).left
  let h : Quiver.Hom W₁ W₂ := (Fgt.map g).left
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let J₁ := W₁.smallEtaleTopology
  let J₂ := W₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  rcases hp_g with ⟨hCont, P_pull, adj_pull, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ,
    h_ιπ, h_πι, hp_formula⟩
  have := hCont
  have := hAdd
  have := hLim
  have := hColim
  obtain ⟨hRightAdj, hAdd', hLim', hColim', η, hMate⟩ :=
    weil_etale_pullback_leftAdjoint_mate_iso h P_pull adj_pull T₁ hT₁ T₂ hT₂
  have := hRightAdj
  have := hAdd'
  have := hLim'
  have := hColim'
  let P_pull' := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
  let adj_pull' := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
  let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
  let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
  let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
  let uℤ := (adj₂.homEquiv Aℤ ((B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).obj (C₁.obj Aℤ))).symm
    (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ) ((C₁.obj Aℤ).obj.map (Opposite.op τ)))
  let uM := (adj₂.homEquiv AM ((B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).obj (C₁.obj AM))).symm
    (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) ((C₁.obj AM).obj.map (Opposite.op τ)))
  let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
    (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm uℤ
  let πM : Quiver.Hom (P_pull.obj (C₂.obj AM)) (C₁.obj AM) :=
    (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm uM
  let πℤ' : Quiver.Hom (P_pull'.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
    (adj_pull'.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm uℤ
  let πM' : Quiver.Hom (P_pull'.obj (C₂.obj AM)) (C₁.obj AM) :=
    (adj_pull'.homEquiv (C₂.obj AM) (C₁.obj AM)).symm uM
  have hπℤ : πℤ = CategoryTheory.CategoryStruct.comp (η.hom.app (C₂.obj Aℤ)) πℤ' := hMate Aℤ
  have hπM : πM = CategoryTheory.CategoryStruct.comp (η.hom.app (C₂.obj AM)) πM' := hMate AM
  let ιℤ' : Quiver.Hom (C₁.obj Aℤ) (P_pull'.obj (C₂.obj Aℤ)) :=
    CategoryTheory.CategoryStruct.comp ιℤ (η.hom.app (C₂.obj Aℤ))
  refine ⟨hCont, hRightAdj, hAdd', hLim', hColim', T₁, hT₁, T₂, hT₂, ιℤ', ?_, ?_, fun y => ?_⟩
  · change CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp ιℤ (η.hom.app (C₂.obj Aℤ))) πℤ' =
      CategoryTheory.CategoryStruct.id (C₁.obj Aℤ)
    refine (CategoryTheory.Category.assoc ιℤ (η.hom.app (C₂.obj Aℤ)) πℤ').trans ?_
    exact (congrArg (CategoryTheory.CategoryStruct.comp ιℤ) hπℤ.symm).trans h_ιπ
  · change CategoryTheory.CategoryStruct.comp πℤ'
        (CategoryTheory.CategoryStruct.comp ιℤ (η.hom.app (C₂.obj Aℤ))) =
      CategoryTheory.CategoryStruct.id (P_pull'.obj (C₂.obj Aℤ))
    have hπℤ'_inv : πℤ' = CategoryTheory.CategoryStruct.comp (η.inv.app (C₂.obj Aℤ)) πℤ := by
      refine (CategoryTheory.Category.id_comp πℤ').symm.trans ?_
      refine (congrArg (fun k => CategoryTheory.CategoryStruct.comp k πℤ')
        (η.inv_hom_id_app (C₂.obj Aℤ)).symm).trans ?_
      refine (CategoryTheory.Category.assoc (η.inv.app (C₂.obj Aℤ))
        (η.hom.app (C₂.obj Aℤ)) πℤ').trans ?_
      exact congrArg (CategoryTheory.CategoryStruct.comp (η.inv.app (C₂.obj Aℤ))) hπℤ.symm
    refine (congrArg (fun k => CategoryTheory.CategoryStruct.comp k
        (CategoryTheory.CategoryStruct.comp ιℤ (η.hom.app (C₂.obj Aℤ)))) hπℤ'_inv).trans ?_
    refine (CategoryTheory.Category.assoc (η.inv.app (C₂.obj Aℤ)) πℤ
      (CategoryTheory.CategoryStruct.comp ιℤ (η.hom.app (C₂.obj Aℤ)))).trans ?_
    refine (congrArg (CategoryTheory.CategoryStruct.comp (η.inv.app (C₂.obj Aℤ)))
      ((CategoryTheory.Category.assoc πℤ ιℤ (η.hom.app (C₂.obj Aℤ))).symm.trans
        ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k (η.hom.app (C₂.obj Aℤ))) h_πι).trans
          (CategoryTheory.Category.id_comp (η.hom.app (C₂.obj Aℤ)))))).trans ?_
    exact η.inv_hom_id_app (C₂.obj Aℤ)
  · refine (hp_formula y).trans ?_
    let y₁ := (P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) q) y
    let y₂ := (P_pull'.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) q) y
    have hy_conj : y₁ =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app (C₂.obj Aℤ))).comp
          (y₂.comp (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app (C₂.obj AM))) (Nat.add_zero q))
          (Nat.zero_add q) :=
      weil_abelian_ext_mapExactFunctor_natIso P_pull P_pull' η q (C₂.obj Aℤ) (C₂.obj AM) y
    have hleft :
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp y₁ (Nat.zero_add q) =
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ').comp y₂ (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app (C₂.obj AM))) (Nat.add_zero q) := by
      refine (congrArg (fun w => (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp w (Nat.zero_add q))
        hy_conj).trans ?_
      refine (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc ιℤ (η.hom.app (C₂.obj Aℤ))
        (y₂.comp (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app (C₂.obj AM))) (Nat.add_zero q))).trans ?_
      exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ') y₂
        (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app (C₂.obj AM))) (Nat.zero_add q)).symm
    have hright_hom :
        CategoryTheory.CategoryStruct.comp (η.inv.app (C₂.obj AM)) πM = πM' := by
      refine (congrArg (CategoryTheory.CategoryStruct.comp (η.inv.app (C₂.obj AM))) hπM).trans ?_
      refine (CategoryTheory.Category.assoc (η.inv.app (C₂.obj AM))
        (η.hom.app (C₂.obj AM)) πM').symm.trans ?_
      refine (congrArg (fun k => CategoryTheory.CategoryStruct.comp k πM')
        (η.inv_hom_id_app (C₂.obj AM))).trans ?_
      exact CategoryTheory.Category.id_comp πM'
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp y₁ (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q)) =
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ').comp y₂ (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM') (Nat.add_zero q))
    refine (congrArg (fun w => w.comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q))
      hleft).trans ?_
    refine (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ').comp y₂ (Nat.zero_add q))
      (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app (C₂.obj AM)))
      (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q)).trans ?_
    refine congrArg
      (fun w => ((CategoryTheory.Abelian.Ext.mk₀ ιℤ').comp y₂ (Nat.zero_add q)).comp w (Nat.add_zero q)) ?_
    exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (η.inv.app (C₂.obj AM)) πM).trans
      (congrArg CategoryTheory.Abelian.Ext.mk₀ hright_hom)

theorem weil_etale_proper_cartesian_torsion_local_constancy (k : Type u) [Field k] [IsAlgClosed k]
    (Y₁ Y₂ Y_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Y₁.hom] [AlgebraicGeometry.IsProper Y₂.hom]
    (pr₁ : Quiver.Hom Y_W.left Y₁.left) (pr₂ : Quiver.Hom Y_W.left Y₂.left)
    (hPb : CategoryTheory.IsPullback pr₁ pr₂ Y₁.hom Y₂.hom)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hFin₂ : ∀ q r : ℕ, Finite (weilEtaleTorsionH Y₂.left (ℓ ^ r) q)) :
    (∀ (W₁ W₂ : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ),
      ∃ p : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q,
        WeilTopDegTorsionPullback h m₀ q p) ∧
    (∀ (r q : ℕ) (U : Y₁.left.Etale),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) pr₁ :=
        ⟨fun _ _ => inferInstance⟩
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) pr₁ :=
        ⟨fun h hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback h hg⟩
      let B₁ : CategoryTheory.Functor Y₁.left.Etale Y_W.left.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ pr₁
      let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁.left
      let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget Y_W.left
      let U_W := (Fgt_W.obj (B₁.obj U)).left
      let π₂_U := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj U)).hom pr₂
      (Nonempty ↥(Fgt₁.obj U).left →
        ∀ (p_U : weilEtaleTorsionH Y₂.left (ℓ ^ r) q →+ weilEtaleTorsionH U_W (ℓ ^ r) q),
          WeilTopDegTorsionPullback π₂_U (ℓ ^ r) q p_U → Function.Injective p_U) ∧
      (∀ ξ : weilEtaleTorsionH U_W (ℓ ^ r) q,
        ∃ S ∈ Y₁.left.smallEtaleTopology U,
          ∀ (V : Y₁.left.Etale) (f : Quiver.Hom V U), S.arrows f →
            let V_W := (Fgt_W.obj (B₁.obj V)).left
            let f_W : Quiver.Hom V_W U_W := (Fgt_W.map (B₁.map f)).left
            let π₂_V := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj V)).hom pr₂
            ∃ c : weilEtaleTorsionH Y₂.left (ℓ ^ r) q,
              ∀ (p_f : weilEtaleTorsionH U_W (ℓ ^ r) q →+ weilEtaleTorsionH V_W (ℓ ^ r) q)
                (p_V : weilEtaleTorsionH Y₂.left (ℓ ^ r) q →+ weilEtaleTorsionH V_W (ℓ ^ r) q),
                WeilTopDegTorsionPullback f_W (ℓ ^ r) q p_f →
                WeilTopDegTorsionPullback π₂_V (ℓ ^ r) q p_V →
                p_f ξ = p_V c)) :=
by
  classical
  have _ := hℓ
  have hIsoToTop : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ)
      (p : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q),
      WeilIsTorsionEtalePullback h m₀ q p → WeilTopDegTorsionPullback h m₀ q p := by
    intro W₁ W₂ h m₀ q p hp
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
    let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    rcases hp with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, h1, h2, hpx⟩
    letI := hCont
    letI := hAdj
    exact ⟨hCont, B.sheafPullback AddCommGrpCat.{u} W₂.smallEtaleTopology W₁.smallEtaleTopology,
      B.sheafAdjunctionContinuous AddCommGrpCat.{u} W₂.smallEtaleTopology W₁.smallEtaleTopology,
      hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, h1, h2, hpx⟩
  obtain ⟨hEx_iso, hId_iso, hComp_iso, -, -⟩ := weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨hUniq_top, hBock⟩ := weil_etale_topDegPullback_unique_and_bockstein_exact.{u}
  have hPullTopEx : ∀ (W₁ W₂ : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ),
      ∃ p : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q,
        WeilTopDegTorsionPullback h m₀ q p := by
    intro W₁ W₂ h m₀ q
    obtain ⟨p, hp⟩ := hEx_iso h m₀ q
    exact ⟨p, hIsoToTop h m₀ q p hp⟩
  let p_std : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ),
      weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q :=
    fun h m₀ q => Classical.choose (hEx_iso h m₀ q)
  have hp_iso : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ),
      WeilIsTorsionEtalePullback h m₀ q (p_std h m₀ q) :=
    fun h m₀ q => Classical.choose_spec (hEx_iso h m₀ q)
  have hp_top : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ),
      WeilTopDegTorsionPullback h m₀ q (p_std h m₀ q) :=
    fun h m₀ q => hIsoToTop h m₀ q (p_std h m₀ q) (hp_iso h m₀ q)
  have hp_eq_std : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (m₀ q : ℕ)
      (p : weilEtaleTorsionH W₂ m₀ q →+ weilEtaleTorsionH W₁ m₀ q),
      WeilTopDegTorsionPullback h m₀ q p → p = p_std h m₀ q :=
    fun h m₀ q p hp => hUniq_top h m₀ q p (p_std h m₀ q) hp (hp_top h m₀ q)
  have hp_std_id : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m₀ q : ℕ),
      p_std (CategoryTheory.CategoryStruct.id W) m₀ q = AddMonoidHom.id _ :=
    fun W m₀ q => hId_iso m₀ q _ (hp_iso (CategoryTheory.CategoryStruct.id W) m₀ q)
  have hp_std_comp : ∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Quiver.Hom W₁ W₂) (h₂ : Quiver.Hom W₂ W₃) (m₀ q : ℕ),
      p_std (CategoryTheory.CategoryStruct.comp h₁ h₂) m₀ q =
        (p_std h₁ m₀ q).comp (p_std h₂ m₀ q) :=
    fun h₁ h₂ m₀ q =>
      hComp_iso h₁ h₂ m₀ q _ _ _ (hp_iso h₁ m₀ q) (hp_iso h₂ m₀ q)
        (hp_iso (CategoryTheory.CategoryStruct.comp h₁ h₂) m₀ q)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) pr₁ :=
    ⟨fun _ _ => inferInstance⟩
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) pr₁ :=
    ⟨fun h hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback h hg⟩
  let B₁ : CategoryTheory.Functor Y₁.left.Etale Y_W.left.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ pr₁
  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁.left
  let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget Y_W.left
  let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
  let J₁ := Y₁.left.smallEtaleTopology
  obtain ⟨hNullSec, hSpecConst⟩ :=
    weil_algClosed_nullstellensatz_section_and_spec_constant_sheaf k
  have hInjAll : ∀ (m₀ q : ℕ) (U : Y₁.left.Etale),
      Nonempty ↥(Fgt₁.obj U).left →
      Function.Injective
        (p_std (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj U)).hom pr₂) m₀ q) := by
    intro m₀ q U hU_ne
    haveI : AlgebraicGeometry.Etale (Fgt₁.obj U).hom := U.prop
    let g_U := CategoryTheory.CategoryStruct.comp (Fgt₁.obj U).hom Y₁.hom
    have hg_lft : AlgebraicGeometry.LocallyOfFiniteType g_U := by
      dsimp [g_U]
      infer_instance
    obtain ⟨s_U, hs_U⟩ := hNullSec (Fgt₁.obj U).left g_U hg_lft hU_ne
    let U_W := (Fgt_W.obj (B₁.obj U)).left
    let fst_U : Quiver.Hom U_W (Fgt₁.obj U).left :=
      CategoryTheory.Limits.pullback.fst (Fgt₁.obj U).hom pr₁
    have hPb_top : CategoryTheory.IsPullback
        fst_U (Fgt_W.obj (B₁.obj U)).hom (Fgt₁.obj U).hom pr₁ :=
      CategoryTheory.IsPullback.of_hasPullback (Fgt₁.obj U).hom pr₁
    have hPb_U := hPb_top.paste_vert hPb
    have hsec_comm :
        CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp Y₂.hom s_U) g_U =
          CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id Y₂.left) Y₂.hom := by
      rw [CategoryTheory.Category.assoc, hs_U, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    let σ_U : Quiver.Hom Y₂.left U_W :=
      hPb_U.lift (CategoryTheory.CategoryStruct.comp Y₂.hom s_U)
        (CategoryTheory.CategoryStruct.id Y₂.left) hsec_comm
    have hσ_snd : CategoryTheory.CategoryStruct.comp σ_U
        (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj U)).hom pr₂) =
        CategoryTheory.CategoryStruct.id Y₂.left :=
      hPb_U.lift_snd _ _ hsec_comm
    have hleft : (p_std σ_U m₀ q).comp
        (p_std (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj U)).hom pr₂) m₀ q) =
        AddMonoidHom.id _ :=
      (hp_std_comp σ_U (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj U)).hom pr₂)
        m₀ q).symm.trans
        ((congrArg (fun h => p_std h m₀ q) hσ_snd).trans (hp_std_id Y₂.left m₀ q))
    exact Function.HasLeftInverse.injective ⟨p_std σ_U m₀ q, fun c =>
      congrArg (fun φ : weilEtaleTorsionH Y₂.left m₀ q →+ weilEtaleTorsionH Y₂.left m₀ q => φ c)
        hleft⟩
  have hBotMem : ∀ (V : Y₁.left.Etale), IsEmpty ↥(Fgt₁.obj V).left →
      (⊥ : CategoryTheory.Sieve V) ∈ J₁ V := fun V hEmp =>
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hmem : (⊥ : CategoryTheory.Sieve V) ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck V :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) V (⊥ : CategoryTheory.Sieve V)).mpr (fun x => hEmp.elim x)
    have heq : J₁ =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Y₁.left (le_refl P_et)
    heq.symm ▸ hmem
  obtain ⟨-, hPbIso, -, hPbConst, -, -⟩ := weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  have hLoc1 : ∀ (q : ℕ) (U : Y₁.left.Etale)
      (ξ : weilEtaleTorsionH ((Fgt_W.obj (B₁.obj U)).left) ℓ q),
      ∃ S ∈ J₁ U,
        ∀ (V : Y₁.left.Etale) (f : Quiver.Hom V U), S.arrows f →
          ∃ c : weilEtaleTorsionH Y₂.left ℓ q,
            p_std (Fgt_W.map (B₁.map f)).left ℓ q ξ =
              p_std (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj V)).hom pr₂) ℓ q c := by
    intro q U ξ
    let A₀ := AddCommGrpCat.of (weilEtaleTorsionH Y₂.left ℓ q)
    have hFinA₀ : Finite ↥A₀ := by
      change Finite (weilEtaleTorsionH Y₂.left ℓ q)
      simpa only [pow_one] using hFin₂ q 1
    letI : Finite ↥A₀ := hFinA₀
    let F₂ := weilEtaleTorsionSheaf Y₂.left ℓ
    let F_W := weilEtaleTorsionSheaf Y_W.left ℓ
    have hℓ_F₂ : ℓ • CategoryTheory.CategoryStruct.id F₂ = 0 := by
      let C₂ := CategoryTheory.constantSheaf Y₂.left.smallEtaleTopology AddCommGrpCat.{u}
      let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
      let Z_ℓ := AddCommGrpCat.of (ZMod ℓ)
      have : C₂.Additive := by dsimp [C₂]; infer_instance
      have hZ_zero : ℓ • CategoryTheory.CategoryStruct.id Z_ℓ = 0 := by
        ext a
        change ℓ • a = 0
        rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
      change ℓ • CategoryTheory.CategoryStruct.id (C₂.obj (U_lift.obj Z_ℓ)) = 0
      rw [← C₂.map_id, ← U_lift.map_id, ← Functor.map_nsmul, ← Functor.map_nsmul,
        hZ_zero, Functor.map_zero, Functor.map_zero]
    have hPb_FW : WeilIsEtaleSheafPullback pr₂ F₂ F_W :=
      hPbConst pr₂ (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ)))
    let S_k : CategoryTheory.Over S₀ :=
      CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.id S₀)
    haveI : AlgebraicGeometry.LocallyOfFiniteType S_k.hom := by
      dsimp [S_k]
      infer_instance
    let Y'_W : CategoryTheory.Over S₀ :=
      CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp pr₁ Y₁.hom)
    let f_ov : Y₂ ⟶ S_k :=
      CategoryTheory.Over.homMk Y₂.hom (CategoryTheory.Category.comp_id Y₂.hom)
    let g_ov : Y₁ ⟶ S_k :=
      CategoryTheory.Over.homMk Y₁.hom (CategoryTheory.Category.comp_id Y₁.hom)
    let f'_ov : Y'_W ⟶ Y₁ :=
      CategoryTheory.Over.homMk pr₁ rfl
    let g'_ov : Y'_W ⟶ Y₂ :=
      CategoryTheory.Over.homMk pr₂ hPb.w.symm
    have hPBC_out : WeilIsEtaleSheafPullback Y₁.hom
        (weilEtaleHigherDirectImage Y₂.hom q F₂)
        (weilEtaleHigherDirectImage pr₁ q F_W) :=
      hPBC Y₂ S_k Y₁ Y'_W f_ov g_ov f'_ov g'_ov
        (inferInstance : AlgebraicGeometry.IsProper Y₂.hom) hPb.flip F₂ F_W hℓ_F₂ hPb_FW q
    obtain ⟨iso_spec⟩ := hSpecConst Y₂.left Y₂.hom ℓ q
    have hPull_R : WeilIsEtaleSheafPullback Y₁.hom
        ((CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)
        (weilEtaleHigherDirectImage pr₁ q F_W) :=
      hPbIso Y₁.hom _ _ _ _ hPBC_out ⟨iso_spec⟩ ⟨CategoryTheory.Iso.refl _⟩
    have hPull_C : WeilIsEtaleSheafPullback Y₁.hom
        ((CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)
        ((CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj A₀) :=
      hPbConst Y₁.hom A₀
    have hIsoR : Nonempty (CategoryTheory.Iso
        ((CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj A₀)
        (weilEtaleHigherDirectImage pr₁ q F_W)) := by
      rcases hPull_R with ⟨hC₁, hR₁, ⟨i₁⟩⟩
      rcases hPull_C with ⟨hC₂, hR₂, ⟨i₂⟩⟩
      cases Subsingleton.elim hC₁ hC₂
      cases Subsingleton.elim hR₁ hR₂
      exact ⟨i₂.symm.trans i₁⟩
    obtain ⟨e, he⟩ := weil_etale_cohomologyPresheaf_scheme_iso Y_W.left ℓ q
    let P_cohom := CategoryTheory.Sheaf.cohomologyPresheaf F_W q
    let P : CategoryTheory.Functor (Opposite Y₁.left.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B₁.op P_cohom
    let α : CategoryTheory.NatTrans
        ((CategoryTheory.Functor.const (Opposite Y₁.left.Etale)).obj A₀) P :=
      { app := fun W_op =>
          AddCommGrpCat.ofHom
            ((e (B₁.obj (Opposite.unop W_op))).symm.toAddMonoidHom.comp
              (p_std (CategoryTheory.CategoryStruct.comp
                (Fgt_W.obj (B₁.obj (Opposite.unop W_op))).hom pr₂) ℓ q))
        naturality := fun W₁_op W₂_op φ =>
          AddCommGrpCat.hom_ext (AddMonoidHom.ext fun c =>
            let W₁ := Opposite.unop W₁_op
            let W₂ := Opposite.unop W₂_op
            let f : Quiver.Hom W₂ W₁ := Opposite.unop φ
            let π₂_1 := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj W₁)).hom pr₂
            let π₂_2 := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj W₂)).hom pr₂
            let f_W := (Fgt_W.map (B₁.map f)).left
            have hcomp : CategoryTheory.CategoryStruct.comp f_W π₂_1 = π₂_2 :=
              (CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (fun u => CategoryTheory.CategoryStruct.comp u pr₂)
                  (Fgt_W.map (B₁.map f)).w)
            (e (B₁.obj W₂)).injective (
              ((e (B₁.obj W₂)).apply_symm_apply (p_std π₂_2 ℓ q c)).trans (
                (congrArg (fun h => p_std h ℓ q c) hcomp.symm).trans (
                  (congrArg (fun ψ : weilEtaleTorsionH Y₂.left ℓ q →+ _ => ψ c)
                    (hp_std_comp f_W π₂_1 ℓ q)).trans (
                    (congrArg (p_std f_W ℓ q)
                      ((e (B₁.obj W₁)).apply_symm_apply (p_std π₂_1 ℓ q c)).symm).trans
                    (he (B₁.map f) (p_std f_W ℓ q) (hp_top f_W ℓ q)
                      ((e (B₁.obj W₁)).symm (p_std π₂_1 ℓ q c))).symm))))) }
    have hα_inj : ∀ W : Y₁.left.Etale, Nonempty ↥(Fgt₁.obj W).left →
