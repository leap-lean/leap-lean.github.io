              rw [h1]
              exact Category.id_comp _
      have hpull_β : adj_pull.homEquiv (C.obj A) (C.obj A) (β_k n A) =
          α'_k n A ≫ e_push.hom.app (C.obj A) := by
        rw [adj_pull.homEquiv_unit]
        change ((unitP_k n).hom.app (C.obj A) ≫ e_push.hom.app ((P_k n).obj (C.obj A))) ≫
            P_push.map (β_k n A) = α'_k n A ≫ e_push.hom.app (C.obj A)
        rw [Category.assoc, ← e_push.hom.naturality (β_k n A), ← Category.assoc]
        have hunit_pk : (unitP_k n).hom.app (C.obj A) ≫ (P_inv_k n).map (β_k n A) =
            (adj_Pk n).homEquiv (C.obj A) (C.obj A) (β_k n A) :=
          ((adj_Pk n).homEquiv_unit (C.obj A) (C.obj A) (β_k n A)).symm
        rw [hunit_pk, hadj_β]
      rw [hpull_β, adj.homEquiv_naturality_right,
