    exact (congrArg _ hLHS₁).trans (hLHS₂.trans (hLHS₃.trans
      (hMid_fg.trans (hRHS₂.symm.trans (congrArg _ hRHS₁.symm)))))

  
  let ηℤ₁ := (adjℤ₁.homEquiv Aℤ (U₁.obj one₁)).symm (ιℤ ≫ FgtMod.map (adjR₁.unit.app R_mod))
  let ηℤ₂ := (adjℤ₂.homEquiv Aℤ (U₂.obj one₂)).symm (ιℤ ≫ FgtMod.map (adjR₂.unit.app R_mod))
  let αM₁ := (adjℤ₁.homEquiv AM (U₁.obj one₁)).symm (ιM ≫ FgtMod.map (adjR₁.unit.app R_mod))
  let αM₂ := (adjℤ₂.homEquiv AM (U₂.obj one₂)).symm (ιM ≫ FgtMod.map (adjR₂.unit.app R_mod))

