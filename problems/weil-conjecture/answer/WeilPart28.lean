        (CategoryTheory.constantSheafAdj J₀ D hT).unit.app A ≫ g.hom.app (Opposite.op T) := by
    intro C₀ _ J₀ D _ _ T hT A 𝒢 g
    rw [CategoryTheory.Adjunction.homEquiv_unit]
    rfl
  have hExtNatIso : ∀ {C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁]
      [CategoryTheory.HasExt.{u} C₁] [CategoryTheory.EnoughInjectives C₁]
      [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂]
      [CategoryTheory.HasExt.{u} C₂]
      (F₁ F₂ : CategoryTheory.Functor C₁ C₂)
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (η : F₁ ≅ F₂) (q : ℕ) (X Y : C₁) (x : CategoryTheory.Abelian.Ext.{u} X Y q),
      (F₁.mapExtAddHom X Y q) x =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
          (((F₂.mapExtAddHom X Y q) x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q))
          (Nat.zero_add q) := by
    intro C₁ C₂ _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ η q X
    induction q with
    | zero =>
      intro Y x
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply]
      let f : X ⟶ Y := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : x = CategoryTheory.Abelian.Ext.mk₀ f :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
      rw [hx, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
