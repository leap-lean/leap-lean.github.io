          change (f₁.hom.app (Opposite.op (eAff.inverse.obj x)) ≫
            ℱ₂.obj.map (Opposite.op isoU.hom)) a' = f₁.hom.app V a
          rw [← f₁.hom.naturality (Opposite.op isoU.hom)]
          change f₁.hom.app V (ℱ₁.obj.map (Opposite.op isoU.hom) a') = f₁.hom.app V a
          rw [ha_id]
        have hf2_eq : (ℱ₂.obj.map (Opposite.op isoU.hom))
            (f₂.hom.app (Opposite.op (eAff.inverse.obj x)) a') = f₂.hom.app V a := by
          change (f₂.hom.app (Opposite.op (eAff.inverse.obj x)) ≫
            ℱ₂.obj.map (Opposite.op isoU.hom)) a' = f₂.hom.app V a
          rw [← f₂.hom.naturality (Opposite.op isoU.hom)]
          change f₂.hom.app V (ℱ₁.obj.map (Opposite.op isoU.hom) a') = f₂.hom.app V a
          rw [ha_id]
        rw [← hf1_eq, ← hf2_eq, h_app_x]
      let E := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv Y AddCommGrpCat.{u}
      have _ : E.functor.Additive := E.functor.additive_of_preserves_binary_products
      let G_tf := E.functor.obj G₀
      have hTF_tf : isTF_cat G_tf := isTF_map E.functor hTF₀
      have hSep_tf : ∀ {X₁ X₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (f₁ f₂ : X₁ ⟶ X₂), (∀ h : G_tf ⟶ X₁, h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
        intro X₁ X₂ f₁ f₂ h_eq
        refine E.inverse.map_injective (hSep₀ _ _ fun k => ?_)
        have hk := h_eq (E.functor.map k ≫ E.counitIso.hom.app X₁)
        have hnat₁ := E.counitIso.hom.naturality f₁
        have hnat₂ := E.counitIso.hom.naturality f₂
        dsimp at hnat₁ hnat₂
        have hk' : E.functor.map (k ≫ E.inverse.map f₁) ≫ E.counitIso.hom.app X₂ =
            E.functor.map (k ≫ E.inverse.map f₂) ≫ E.counitIso.hom.app X₂ := by
          rw [Functor.map_comp, Functor.map_comp, Category.assoc, Category.assoc, hnat₁, hnat₂,
            ← Category.assoc, ← Category.assoc, hk]
        exact E.functor.map_injective ((cancel_mono (E.counitIso.hom.app X₂)).mp hk')
      intro ℰ'
      have _ : Small.{u} (G_tf ⟶ ℰ') := LocallySmall.hom_small G_tf ℰ'
      let Idx : Type u := Shrink.{u} (G_tf ⟶ ℰ')
      let P : CategoryTheory.Sheaf J AddCommGrpCat.{u} := sigmaObjU (fun _ : Idx => G_tf)
      let q : P ⟶ ℰ' := sigmaDesc (X := fun _ : Idx => G_tf)
        (fun i : Idx => (equivShrink (G_tf ⟶ ℰ')).symm i)
      refine ⟨P, q, isTF_sigma (fun _ : Idx => G_tf) (fun _ => hTF_tf), ?_⟩
      refine ⟨fun {Z_cod} f₁ f₂ hqf => hSep_tf f₁ f₂ fun h => ?_⟩
      have hi : sigmaIota (fun _ : Idx => G_tf) (equivShrink (G_tf ⟶ ℰ') h) ≫ q = h :=
        (sigmaIotaDesc (X := fun _ : Idx => G_tf)
          (fun i : Idx => (equivShrink (G_tf ⟶ ℰ')).symm i) (equivShrink (G_tf ⟶ ℰ') h)).trans
          (Equiv.symm_apply_apply _ h)
      rw [← hi, Category.assoc, Category.assoc, hqf]
    
    have hExtend : ∀ (ℐ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) [Injective ℐ]
        (SC : ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
        SC.ShortExact → isTF_cat SC.X₃ →
        ∀ (g₀ : SC.X₁ ⟶ (U_of Y m).obj ℐ), ∃ h : SC.X₂ ⟶ (U_of Y m).obj ℐ, SC.f ≫ h = g₀ := by
      intro ℐ _ SC hSC hTF_K g₀
      have hm_ℐ : m • 𝟙 ((U_of Y m).obj ℐ) = 0 := hm_tors ℐ
      let K' := SC.X₁; let P := SC.X₂; let K := SC.X₃; let ι := SC.f; let π := SC.g
      have _ : Mono ι := hSC.mono_f
      have _ : Epi π := hSC.epi_g
      let K'_bar := Limits.cokernel (m • 𝟙 K')
      let P_bar := Limits.cokernel (m • 𝟙 P)
      let pK' := Limits.cokernel.π (m • 𝟙 K')
      let pP := Limits.cokernel.π (m • 𝟙 P)
      have hm_K' : m • 𝟙 K'_bar = 0 := by
        rw [← cancel_epi pK', Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
          ← Category.id_comp pK', ← Preadditive.nsmul_comp, Limits.cokernel.condition]
      have hm_P : m • 𝟙 P_bar = 0 := by
        rw [← cancel_epi pP, Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
          ← Category.id_comp pP, ← Preadditive.nsmul_comp, Limits.cokernel.condition]
      have h_cond_ι : (m • 𝟙 K') ≫ (ι ≫ pP) = 0 := by
        have hcomm : (m • 𝟙 K') ≫ ι = ι ≫ (m • 𝟙 P) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        rw [← Category.assoc, hcomm, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
      let ι_bar : K'_bar ⟶ P_bar := Limits.cokernel.desc (m • 𝟙 K') (ι ≫ pP) h_cond_ι
      have h_comm_ι : pK' ≫ ι_bar = ι ≫ pP := Limits.cokernel.π_desc _ _ _
      have _ : Mono ι_bar := by
        apply Abelian.Pseudoelement.mono_of_zero_of_map_zero
        intro a_bar ha_bar
        obtain ⟨a, rfl⟩ := Abelian.Pseudoelement.pseudo_surjective_of_epi pK' a_bar
        have h1 : Abelian.Pseudoelement.pseudoApply pP (Abelian.Pseudoelement.pseudoApply ι a) = 0 := by
          rw [← Abelian.Pseudoelement.comp_apply, ← h_comm_ι, Abelian.Pseudoelement.comp_apply]
          exact ha_bar
        obtain ⟨b, hb⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact
          (ShortComplex.exact_cokernel (m • 𝟙 P)) _ h1
        by_cases hm0 : m = 0
        · subst hm0
          have hb0 : Abelian.Pseudoelement.pseudoApply ((0 : ℕ) • 𝟙 P) b = 0 := by
            rw [zero_smul]; exact Abelian.Pseudoelement.zero_apply P b
          rw [hb0] at hb
          have ha0 : a = 0 := Abelian.Pseudoelement.zero_of_map_zero ι
            (Abelian.Pseudoelement.pseudo_injective_of_mono ι) a hb.symm
          rw [ha0, Abelian.Pseudoelement.apply_zero]
        · have _ : Mono (m • 𝟙 K) := hTF_K m hm0
          have hcomm_π : (m • 𝟙 P) ≫ π = π ≫ (m • 𝟙 K) := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
          have hπb : Abelian.Pseudoelement.pseudoApply (m • 𝟙 K)
              (Abelian.Pseudoelement.pseudoApply π b) = 0 := by
            rw [← Abelian.Pseudoelement.comp_apply, ← hcomm_π, Abelian.Pseudoelement.comp_apply, hb,
              ← Abelian.Pseudoelement.comp_apply]
            have hz : ι ≫ π = 0 := SC.zero
            rw [hz]; exact Abelian.Pseudoelement.zero_apply K a
          have hb_ker : Abelian.Pseudoelement.pseudoApply π b = 0 :=
            Abelian.Pseudoelement.zero_of_map_zero (m • 𝟙 K)
              (Abelian.Pseudoelement.pseudo_injective_of_mono (m • 𝟙 K)) _ hπb
          obtain ⟨c, rfl⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact hSC.exact b hb_ker
          have hcomm_ι2 : (m • 𝟙 K') ≫ ι = ι ≫ (m • 𝟙 P) := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
          have hc_eq : Abelian.Pseudoelement.pseudoApply ι
              (Abelian.Pseudoelement.pseudoApply (m • 𝟙 K') c) =
              Abelian.Pseudoelement.pseudoApply ι a := by
            rw [← Abelian.Pseudoelement.comp_apply, hcomm_ι2, Abelian.Pseudoelement.comp_apply, hb]
          have ha_eq : a = Abelian.Pseudoelement.pseudoApply (m • 𝟙 K') c :=
            (Abelian.Pseudoelement.pseudo_injective_of_mono ι hc_eq).symm
          rw [ha_eq, ← Abelian.Pseudoelement.comp_apply, Limits.cokernel.condition]
          exact Abelian.Pseudoelement.zero_apply K'_bar c
      obtain ⟨K'_mod, hK'_mod⟩ := hLiftSheaf K'_bar hm_K'
      obtain ⟨P_mod, hP_mod⟩ := hLiftSheaf P_bar hm_P
      obtain ⟨ι_mod, hι_mod⟩ := hUFull (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm)
      have _ : Mono ι_mod := by
        refine ⟨fun {Z_dom} f₁ f₂ hf => hUFaith ?_⟩
        have _ : Mono ((U_of Y m).map ι_mod) := by
          rw [hι_mod]
          exact mono_comp (eqToHom hK'_mod) (ι_bar ≫ eqToHom hP_mod.symm)
        rw [← cancel_mono ((U_of Y m).map ι_mod), ← (U_of Y m).map_comp,
          ← (U_of Y m).map_comp, hf]
      have hg₀_cond : (m • 𝟙 K') ≫ g₀ = 0 := by
        have hcomm : (m • 𝟙 K') ≫ g₀ = g₀ ≫ (m • 𝟙 ((U_of Y m).obj ℐ)) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        rw [hcomm, hm_ℐ, Limits.comp_zero]
      let g₀_bar : K'_bar ⟶ (U_of Y m).obj ℐ := Limits.cokernel.desc (m • 𝟙 K') g₀ hg₀_cond
      obtain ⟨g₀_mod, hg₀_mod⟩ := hUFull (eqToHom hK'_mod ≫ g₀_bar)
      let h_mod : P_mod ⟶ ℐ := Injective.factorThru g₀_mod ι_mod
      have hh_mod : ι_mod ≫ h_mod = g₀_mod := Injective.comp_factorThru g₀_mod ι_mod
      refine ⟨pP ≫ eqToHom hP_mod.symm ≫ (U_of Y m).map h_mod, ?_⟩
      have h_mid : ι_bar ≫ eqToHom hP_mod.symm ≫ (U_of Y m).map h_mod = g₀_bar := by
        have h_eq1 : (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm) ≫ (U_of Y m).map h_mod =
            eqToHom hK'_mod ≫ g₀_bar := by
          rw [← hι_mod, ← (U_of Y m).map_comp, hh_mod, hg₀_mod]
        have h_eq2 := congrArg (fun k => eqToHom hK'_mod.symm ≫ k) h_eq1
        simpa only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp] using h_eq2
      calc
        SC.f ≫ (pP ≫ eqToHom hP_mod.symm ≫ (U_of Y m).map h_mod)
          = (ι ≫ pP) ≫ eqToHom hP_mod.symm ≫ (U_of Y m).map h_mod := (Category.assoc _ _ _).symm
        _ = (pK' ≫ ι_bar) ≫ eqToHom hP_mod.symm ≫ (U_of Y m).map h_mod := by rw [h_comm_ι]
        _ = pK' ≫ (ι_bar ≫ eqToHom hP_mod.symm ≫ (U_of Y m).map h_mod) := Category.assoc _ _ _
        _ = pK' ≫ g₀_bar := by rw [h_mid]
        _ = g₀ := Limits.cokernel.π_desc _ _ _
    exact ext_comparison_bijective_of_acyclic (U_of Y m) 𝒳₀ ℰ ζ hBase
      (fun ℐ _ p e => ext_vanish_of_effaceable isTF_cat isTF_sub hCover ((U_of Y m).obj ℐ)
        (hExtend ℐ) p hTF_ℰ e)

  
  
  
  let ιℤ_std (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶
        (U_of S m).obj (One_of S m) :=
    (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map (z_to_m_of m) ≫
      αM_of S m

  have h_ιℤ_std_ev : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
        (AddCommGrpCat.of (ULift.{u} ℤ)) ((U_of S m).obj (One_of S m)) (ιℤ_std S m) =
      z_to_m_of m ≫ ιM_of m ≫ u₀_of S m := by
    intro S m
    dsimp only [ιℤ_std]
    rw [Adjunction.homEquiv_naturality_left _ (z_to_m_of m) (αM_of S m), h_αM_homEquiv]

  let ζ_of {Z Y : AlgebraicGeometry.Scheme.{u}} (B : Y.Etale ⥤ Z.Etale)
      [B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology] (m : ℕ) :
      (B.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Z.smallEtaleTopology).obj
        ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶
      (U_of Y m).obj
        ((B.sheafPushforwardContinuous (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
            Y.smallEtaleTopology Z.smallEtaleTopology).obj (One_of Z m)) :=
    (B.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.smallEtaleTopology Z.smallEtaleTopology).map (ιℤ_std Z m)

  have hSuppGenBij : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (B : Y.Etale ⥤ Z.Etale)
      [B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology] (m : ℕ),
      Limits.PreservesFiniteColimits
        (B.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Z.smallEtaleTopology) →
      Epi (ζ_of B m) ∧
      ∀ (q : ℕ)
        (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))),
        let _ := hAdd_U Y m
        let _ := (hLim_U Y m).1
        let _ := (hLim_U Y m).2
        let _ := hExtMod Y m
        let _ := hExtAb Y
        Function.Bijective (fun x : Abelian.Ext.{u}
            ((B.sheafPushforwardContinuous (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
              Y.smallEtaleTopology Z.smallEtaleTopology).obj (One_of Z m)) ℱ q =>
          (Abelian.Ext.mk₀ (ζ_of B m)).comp
            (Abelian.Ext.mapExactFunctor (U_of Y m) x) (Nat.zero_add q)) := by
    intro Z Y B _ m hColim_B
    let i_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.smallEtaleTopology Z.smallEtaleTopology
    have _ : i_push_ab.Additive := { map_add := by intros; ext W x; rfl }
    have _ : Limits.PreservesFiniteLimits i_push_ab :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
        i_push_ab (CategoryTheory.sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (Limits.comp_preservesFiniteLimits
          (CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          ((Functor.whiskeringLeft Y.Etaleᵒᵖ Z.Etaleᵒᵖ AddCommGrpCat.{u}).obj B.op))
        inferInstance
    have _ : Limits.PreservesFiniteColimits i_push_ab := hColim_B
    let C_Z := CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    have _ : C_Z.IsLeftAdjoint :=
      ⟨_, ⟨CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} (hT_of Z)⟩⟩
    let C_unf : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const (Z.Etale)ᵒᵖ) ⋙
        CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    have hC_eq : C_Z = C_unf := rfl
    have _ : Limits.PreservesFiniteLimits C_Z := by
      rw [hC_eq]; exact Limits.comp_preservesFiniteLimits _ _
    have _ : C_Z.Additive := C_Z.additive_of_preserves_binary_products
    have _ : Limits.PreservesFiniteColimits C_Z := inferInstance
    let G : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
      C_Z ⋙ i_push_ab
    have _ : G.Additive :=
      { map_add := by
          intro X₁ X₂ f₁ f₂
          change i_push_ab.map (C_Z.map (f₁ + f₂)) =
            i_push_ab.map (C_Z.map f₁) + i_push_ab.map (C_Z.map f₂)
          rw [C_Z.map_add, i_push_ab.map_add] }
    have _ : Limits.PreservesFiniteLimits G := Limits.comp_preservesFiniteLimits C_Z i_push_ab
    have _ : Limits.PreservesFiniteColimits G := Limits.comp_preservesFiniteColimits C_Z i_push_ab
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let ℰ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
      (B.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology Z.smallEtaleTopology).obj
        ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
    let 𝒬 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
      (U_of Y m).obj
        ((B.sheafPushforwardContinuous (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
          Y.smallEtaleTopology Z.smallEtaleTopology).obj (One_of Z m))
    have hTF_ℰ : ∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 ℰ) := by
      intro n hn
      have _ : Mono (n • 𝟙 Aℤ) := hMono_Aℤ n hn
      have hmap : G.map (n • 𝟙 Aℤ) = n • 𝟙 ℰ := by
        change G.map (n • 𝟙 Aℤ) = n • 𝟙 (G.obj Aℤ)
        rw [G.map_nsmul, G.map_id]
      rw [← hmap]; exact G.map_mono (n • 𝟙 Aℤ)
    obtain ⟨hz0, hz_desc⟩ := z_to_m_cokernel_univ m
    obtain ⟨hG0, hG_desc⟩ := cokernel_univ_map_of_preserves G m (z_to_m_of m) hz0 hz_desc
    let gm : ℰ ⟶ G.obj (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))) :=
      G.map (z_to_m_of m)
    have hgm0 : (m • 𝟙 ℰ) ≫ gm = 0 := hG0
    let αZ_map : G.obj (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))) ⟶ 𝒬 :=
      i_push_ab.map (αM_of Z m)
    let βZ_map : 𝒬 ⟶ G.obj (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))) :=
      i_push_ab.map (βM_of Z m)
    have hαβ_Z : αZ_map ≫ βZ_map = 𝟙 _ := by
      change i_push_ab.map (αM_of Z m) ≫ i_push_ab.map (βM_of Z m) = 𝟙 (i_push_ab.obj _)
      rw [← i_push_ab.map_comp, hαβ_of Z m, i_push_ab.map_id]
    have hβα_Z : βZ_map ≫ αZ_map = 𝟙 𝒬 := by
      change i_push_ab.map (βM_of Z m) ≫ i_push_ab.map (αM_of Z m) = 𝟙 (i_push_ab.obj _)
      rw [← i_push_ab.map_comp, hβα_of Z m, i_push_ab.map_id]
    have hζ_fac : ζ_of B m = gm ≫ αZ_map :=
      i_push_ab.map_comp (C_Z.map (z_to_m_of m)) (αM_of Z m)
    have hζ0 : (m • 𝟙 ℰ) ≫ ζ_of B m = 0 := by
      rw [hζ_fac, ← Category.assoc, hgm0, Limits.zero_comp]
    have hζ_desc : ∀ {ℬ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (g : ℰ ⟶ ℬ), (m • 𝟙 ℰ) ≫ g = 0 →
        ∃! g_bar : 𝒬 ⟶ ℬ, ζ_of B m ≫ g_bar = g := by
      intro ℬ g hg
      obtain ⟨g₁, hg₁, hg₁_uniq⟩ := hG_desc g hg
      have hg₁' : gm ≫ g₁ = g := hg₁
      refine ⟨βZ_map ≫ g₁, ?_, fun k hk => ?_⟩
      · dsimp only
        rw [hζ_fac, Category.assoc, ← Category.assoc αZ_map, hαβ_Z, Category.id_comp, hg₁']
      · dsimp only at hk
        have hk' : gm ≫ (αZ_map ≫ k) = g := by
          rw [← Category.assoc, ← hζ_fac, hk]
        have h_ak : αZ_map ≫ k = g₁ := hg₁_uniq (αZ_map ≫ k) hk'
        calc
          k = 𝟙 𝒬 ≫ k := (Category.id_comp k).symm
          _ = (βZ_map ≫ αZ_map) ≫ k := by rw [hβα_Z]
          _ = βZ_map ≫ (αZ_map ≫ k) := Category.assoc _ _ _
          _ = βZ_map ≫ g₁ := by rw [h_ak]
    have hEpi_ζ : Epi (ζ_of B m) := by
      refine ⟨fun {ℬ} f₁ f₂ hf => ?_⟩
      have hcond : (m • 𝟙 ℰ) ≫ (ζ_of B m ≫ f₂) = 0 := by
        rw [← Category.assoc, hζ0, Limits.zero_comp]
      exact (hζ_desc (ζ_of B m ≫ f₂) hcond).unique hf rfl
    exact ⟨hEpi_ζ, hGenSiteBij Y m _ ℰ (ζ_of B m) hTF_ℰ hζ0 hζ_desc⟩

  let e_raw {Z Y : AlgebraicGeometry.Scheme.{u}} (B : Y.Etale ⥤ Z.Etale)
      [B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology] (m q : ℕ) :
      Abelian.Ext.{u}
        ((B.sheafPushforwardContinuous (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
          Y.smallEtaleTopology Z.smallEtaleTopology).obj (One_of Z m))
        (One_of Y m) q →+
      Abelian.Ext.{u}
        ((B.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Z.smallEtaleTopology).obj
          ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))))
        (weilEtaleTorsionSheaf Y m) q :=
    let _ := hAdd_U Y m
    let _ := (hLim_U Y m).1
    let _ := (hLim_U Y m).2
    let _ := hExtMod Y m
    let _ := hExtAb Y
    ((Abelian.Ext.mk₀ (βM_of Y m)).postcomp _ (Nat.add_zero q)).comp
      (((Abelian.Ext.mk₀ (ζ_of B m)).precomp ((U_of Y m).obj (One_of Y m))
          (Nat.zero_add q)).comp
        ((U_of Y m).mapExtAddHom _ (One_of Y m) q))

  have he_raw_apply : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (B : Y.Etale ⥤ Z.Etale)
      [B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology] (m q : ℕ)
      (x : Abelian.Ext.{u}
        ((B.sheafPushforwardContinuous (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
          Y.smallEtaleTopology Z.smallEtaleTopology).obj (One_of Z m))
        (One_of Y m) q),
      let _ := hAdd_U Y m
      let _ := (hLim_U Y m).1
      let _ := (hLim_U Y m).2
      let _ := hExtMod Y m
      let _ := hExtAb Y
      e_raw B m q x =
        ((Abelian.Ext.mk₀ (ζ_of B m)).comp
          (Abelian.Ext.mapExactFunctor (U_of Y m) x) (Nat.zero_add q)).comp
          (Abelian.Ext.mk₀ (βM_of Y m)) (Nat.add_zero q) := by
    intro Z Y B _ m q x
    let _ := hAdd_U Y m
    let _ := (hLim_U Y m).1
    let _ := (hLim_U Y m).2
    let _ := hExtMod Y m
    let _ := hExtAb Y
    let ℰ := (B.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.smallEtaleTopology Z.smallEtaleTopology).obj
      ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ)))
