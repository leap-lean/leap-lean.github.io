      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        _ (CategoryTheory.Abelian.Ext.mk₀ (F.map φ)) (CategoryTheory.Abelian.Ext.mk₀ π₂) (Nat.add_zero q),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ β) _ (CategoryTheory.Abelian.Ext.mk₀ (F.map φ)) (Nat.zero_add q)]
  
  have hPb_id : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
      (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
      WeilGysinSupportPullback (CategoryTheory.CategoryStruct.id Y) i i (ℓ ^ r) q τ τ := by
    intro Z Y i r q τ
    let R := ULift.{u, 0} (ZMod (ℓ ^ r))
    let R_mod := ModuleCat.of R R
    let J_Y := Y.smallEtaleTopology
    let J_Z := Z.smallEtaleTopology
    let B_g : Y.Etale ⥤ Y.Etale := weilEtaleSitePullback (𝟙 Y)
    have hCont_g : B_g.IsContinuous J_Y J_Y := hContAll (𝟙 Y)
    let _ := hCont_g
    let _ := τ.hCont
    obtain ⟨e_id⟩ := hIdIso Y
    let g_push := B_g.sheafPushforwardContinuous (ModuleCat.{u, u} R) J_Y J_Y
    let η_push : g_push ≅ 𝟭 (CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R)) :=
      (CategoryTheory.Functor.sheafPushforwardContinuousIso e_id (ModuleCat.{u, u} R) J_Y J_Y).trans
        (CategoryTheory.Functor.sheafPushforwardContinuousId (ModuleCat.{u, u} R) J_Y)
    let adj_pull : 𝟭 (CategoryTheory.Sheaf J_Y (ModuleCat.{u, u} R)) ⊣ g_push :=
      CategoryTheory.Adjunction.id.ofNatIsoRight η_push.symm
    obtain ⟨T_Y, ⟨hT_Y⟩⟩ := hTerm Y
    obtain ⟨T_Z, ⟨hT_Z⟩⟩ := hTerm Z
    refine ⟨hCont_g, 𝟭 _, adj_pull, inferInstance, inferInstance, inferInstance,
      T_Y, hT_Y, T_Z, hT_Z, T_Y, hT_Y, T_Z, hT_Z, ?_⟩
    let One_Y := (CategoryTheory.constantSheaf J_Y (ModuleCat.{u, u} R)).obj R_mod
    let One_Z := (CategoryTheory.constantSheaf J_Z (ModuleCat.{u, u} R)).obj R_mod
    let B_i : Y.Etale ⥤ Z.Etale := weilEtaleSitePullback i
    let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R) J_Y J_Z
    let adj_Y := CategoryTheory.constantSheafAdj J_Y (ModuleCat.{u, u} R) hT_Y
    let τ_g : B_g.obj T_Y ⟶ T_Y := hT_Y.from (B_g.obj T_Y)
    set π_Y : One_Y ⟶ One_Y :=
      (adj_pull.homEquiv One_Y One_Y).symm
        ((adj_Y.homEquiv R_mod (g_push.obj One_Y)).symm
          (adj_Y.unit.app R_mod ≫ One_Y.obj.map τ_g.op))
    have hπ_id : π_Y = 𝟙 One_Y := by
      apply (adj_pull.homEquiv One_Y One_Y).injective
      apply (adj_Y.homEquiv R_mod (g_push.obj One_Y)).injective
      have hLHS : adj_Y.homEquiv R_mod (g_push.obj One_Y) (adj_pull.homEquiv One_Y One_Y π_Y) =
          adj_Y.unit.app R_mod ≫ One_Y.obj.map τ_g.op := by
        dsimp only [π_Y]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      rw [hLHS]
      have h1 : adj_pull.homEquiv One_Y One_Y (𝟙 One_Y) = η_push.inv.app One_Y :=
        hIdOfNatIsoRight η_push One_Y
      rw [h1, CategoryTheory.Adjunction.homEquiv_unit]
      have he_eq : e_id.hom.app T_Y = τ_g := hT_Y.hom_ext _ _
      congr 1
      rw [← he_eq]
      change One_Y.obj.map (e_id.hom.app T_Y).op =
        𝟙 _ ≫ One_Y.obj.map (e_id.hom.app T_Y).op
      exact (CategoryTheory.Category.id_comp _).symm
    refine ⟨𝟙 One_Y, 𝟙 (i_push.obj One_Z), ?_, ?_, ?_, ?_⟩
    · exact (CategoryTheory.Category.id_comp π_Y).trans hπ_id
    · exact (CategoryTheory.Category.comp_id π_Y).trans hπ_id
    · exact (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm
    · change τ.val = (CategoryTheory.Abelian.Ext.mk₀ π_Y).postcomp (i_push.obj One_Z) (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀ (𝟙 (i_push.obj One_Z))).comp
          (((𝟭 _).mapExtAddHom (i_push.obj One_Z) One_Y q) τ.val) (Nat.zero_add q))
      rw [hπ_id, hMapExtId _ _ q τ.val]
      change τ.val = ((CategoryTheory.Abelian.Ext.mk₀ (𝟙 _)).comp τ.val (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 One_Y)) (Nat.add_zero q)
      rw [CategoryTheory.Abelian.Ext.mk₀_id_comp, CategoryTheory.Abelian.Ext.comp_mk₀_id]
  have hTorsPb_id : ∀ (W : AlgebraicGeometry.Scheme.{u}) (r q : ℕ),
      WeilLefschetzTorsionPullback (CategoryTheory.CategoryStruct.id W)
        (ℓ ^ r) q (AddMonoidHom.id _) := by
    intro W r q
    let J := W.smallEtaleTopology
    let B : W.Etale ⥤ W.Etale := weilEtaleSitePullback (𝟙 W)
    have hCont : B.IsContinuous J J := hContAll (𝟙 W)
    let _ := hCont
    obtain ⟨e_id⟩ := hIdIso W
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J J
    let η_push : P_push ≅ 𝟭 (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
