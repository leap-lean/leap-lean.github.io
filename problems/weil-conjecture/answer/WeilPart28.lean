          ← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]
    intro W₁ W₂ h r m p_succ p_curr hp_succ hp_curr x
    let PEt : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong PEt h :=
