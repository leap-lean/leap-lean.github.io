        η.hom_inv_id_app X, CategoryTheory.Category.id_comp]
    | succ k ih =>
      intro Y x
      have ih' : ∀ (Y₀ : C₁) (z₀ : CategoryTheory.Abelian.Ext.{u} X Y₀ k),
          CategoryTheory.Abelian.Ext.mapExactFunctor F₁ z₀ =
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
