theorem weil_lefschetz_torsion_cup_comparison_and_ring_ops : (∀ (W : AlgebraicGeometry.Scheme.{u}) (m a b c : ℕ) (hab : a + b = c),
      ∃! cup : weilEtaleTorsionH W m a →+ weilEtaleTorsionH W m b →+ weilEtaleTorsionH W m c,
        WeilLefschetzIsTorsionCup W m a b c hab cup) ∧
    (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂)
      (m a b c : ℕ) (hab : a + b = c)
      (p_a : weilEtaleTorsionH W₂ m a →+ weilEtaleTorsionH W₁ m a)
      (p_b : weilEtaleTorsionH W₂ m b →+ weilEtaleTorsionH W₁ m b)
      (p_c : weilEtaleTorsionH W₂ m c →+ weilEtaleTorsionH W₁ m c)
      (cup₁ : weilEtaleTorsionH W₁ m a →+ weilEtaleTorsionH W₁ m b →+ weilEtaleTorsionH W₁ m c)
      (cup₂ : weilEtaleTorsionH W₂ m a →+ weilEtaleTorsionH W₂ m b →+ weilEtaleTorsionH W₂ m c),
      WeilLefschetzTorsionPullback h m a p_a →
      WeilLefschetzTorsionPullback h m b p_b →
      WeilLefschetzTorsionPullback h m c p_c →
      WeilLefschetzIsTorsionCup W₁ m a b c hab cup₁ →
      WeilLefschetzIsTorsionCup W₂ m a b c hab cup₂ →
      ∀ (u : weilEtaleTorsionH W₂ m a) (v : weilEtaleTorsionH W₂ m b),
        p_c (cup₂ u v) = cup₁ (p_a u) (p_b v)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m a b c ab bc abc : ℕ)
      (hab : a + b = ab) (hbc : b + c = bc) (hab_c : ab + c = abc) (ha_bc : a + bc = abc)
      (cup_ab : weilEtaleTorsionH W m a →+ weilEtaleTorsionH W m b →+ weilEtaleTorsionH W m ab)
      (cup_bc : weilEtaleTorsionH W m b →+ weilEtaleTorsionH W m c →+ weilEtaleTorsionH W m bc)
      (cup_ab_c : weilEtaleTorsionH W m ab →+ weilEtaleTorsionH W m c →+ weilEtaleTorsionH W m abc)
      (cup_a_bc : weilEtaleTorsionH W m a →+ weilEtaleTorsionH W m bc →+ weilEtaleTorsionH W m abc),
      WeilLefschetzIsTorsionCup W m a b ab hab cup_ab →
      WeilLefschetzIsTorsionCup W m b c bc hbc cup_bc →
      WeilLefschetzIsTorsionCup W m ab c abc hab_c cup_ab_c →
      WeilLefschetzIsTorsionCup W m a bc abc ha_bc cup_a_bc →
      ∀ (u : weilEtaleTorsionH W m a) (v : weilEtaleTorsionH W m b) (w : weilEtaleTorsionH W m c),
        cup_ab_c (cup_ab u v) w = cup_a_bc u (cup_bc v w)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (m a b c : ℕ) (hab : a + b = c) (hba : b + a = c),
      (let R := ULift.{u, 0} (ZMod m)
       let One_mod :=
         (CategoryTheory.constantSheaf W.smallEtaleTopology (ModuleCat.{u, u} R)).obj
