        exact eqvPost.bijective
      exact hPost_bij.comp (hGenBij S m k (weilEtaleModuleUnit S m))
    intro S m k
    exact ⟨⟨θ_of S m k, hθ_of_valid S m k, hθ_of_bij S m k⟩,
      fun θ₁ θ₂ h₁ h₂ => (hθ_of_uniq S m k θ₁ h₁).trans (hθ_of_uniq S m k θ₂ h₂).symm⟩
  let θ_std (W : Scheme.{u}) (m k : ℕ) : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k :=
    Classical.choose (hMod_ex_uniq W m k).1
  have hθ_std : ∀ (W : Scheme.{u}) (m k : ℕ),
