          have hy_mem : y_w ∈ O_y := by
            change ((x f_w hf_w).hom e).1 y_w ∈ t
            rwa [← h_glued_eq f_w hf_w e y_w]
          refine ⟨f_w.left.base '' O_y, ?_, f_w.left.isOpenMap O_y hO_open, ⟨y_w, hy_mem, rfl⟩⟩
