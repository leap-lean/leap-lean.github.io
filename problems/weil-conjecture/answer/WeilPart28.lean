      AddMonoidHom.mk'
        (fun α => AddMonoidHom.mk'
          (fun β => α.comp β hab)
          (fun β₁ β₂ => Abelian.Ext.comp_add α β₁ β₂ hab))
        (fun α₁ α₂ => by ext β; exact Abelian.Ext.add_comp α₁ α₂ β hab)
