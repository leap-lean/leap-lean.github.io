        exact (AlgebraicGeometry.Scheme.Hom.comp_apply (B_V.map f).left
          (CategoryTheory.Limits.pullback.fst W.hom V.ι) z₀).symm.trans
          ((congrArg
            (fun k : Quiver.Hom (CategoryTheory.Limits.pullback W₀.hom V.ι) W.left => k.base z₀)
            h_fst_comp).trans
            ((AlgebraicGeometry.Scheme.Hom.comp_apply
              (CategoryTheory.Limits.pullback.fst W₀.hom V.ι) f.left z₀).trans
              ((congrArg f.left.base hz₀_fst).trans hfy)))
      exact ⟨B_V.obj W₀, B_V.map f, z₀,
        CategoryTheory.Sieve.image_mem_functorPushforward B_V R hfR, hEt_Bf, hz₀_eq⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_B hCov_B
  have hCont_M : (weilGysinAbOpenMapSite V).IsContinuous
      V.toScheme.smallEtaleTopology Y.smallEtaleTopology := by
    let M_V := weilGysinAbOpenMapSite V
    let J_V := V.toScheme.smallEtaleTopology
    let J_Y := Y.smallEtaleTopology
    haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hCov_M : CategoryTheory.CoverPreserving J_V J_Y M_V := by
      refine ⟨fun {U R} hR => ?_⟩
      change R ∈ V.toScheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) U at hR
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        V.toScheme (Q := @AlgebraicGeometry.Etale) le_rfl] at hR
      change CategoryTheory.Sieve.functorPushforward M_V R ∈
        Y.smallGrothendieckTopology (@AlgebraicGeometry.Etale) (M_V.obj U)
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y (Q := @AlgebraicGeometry.Etale) le_rfl]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (M_V.obj U) _).mpr
        (fun x => ?_)
      obtain ⟨Y₀, f, y, hfR, hEt_f, hfy⟩ :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) U R).mp hR x
      exact ⟨M_V.obj Y₀, M_V.map f, y,
        CategoryTheory.Sieve.image_mem_functorPushforward M_V R hfR, hEt_f, hfy⟩
    have hCompat_M : CategoryTheory.CompatiblePreserving J_Y M_V := by
      apply CategoryTheory.CompatiblePreserving.mk
      intro Fsh Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      haveI hEt_f₁ : AlgebraicGeometry.Etale f₁.left := by
        haveI : AlgebraicGeometry.Etale X.hom := X.prop
