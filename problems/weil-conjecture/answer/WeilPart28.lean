      FormallyUnramified.isOpenImmersion_diagonal F
    have hSurj_diag : Surjective (Limits.pullback.diagonal F) :=
      (UniversallyInjective.iff_diagonal F).mp hUnivInj_F
    have : IsIso (Limits.pullback.diagonal F) :=
      (isIso_iff_isOpenImmersion_and_surjective (Limits.pullback.diagonal F)).mpr
        ⟨inferInstance, hSurj_diag⟩
    have : Mono F := (Limits.pullback.isIso_diagonal_iff F).mp inferInstance
    have : IsOpenImmersion F := IsOpenImmersion.of_flat_of_mono F
    have : IsIso F :=
      (isIso_iff_isOpenImmersion_and_surjective F).mpr ⟨inferInstance, hSurj_F⟩
    exact IsPullback.of_iso_pullback ⟨hcomm⟩ (asIso F) hF_fst hF_snd
  
  
  
