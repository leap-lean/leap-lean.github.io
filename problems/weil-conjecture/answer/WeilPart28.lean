        (adj_Z₂.unit.app X ≫ One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op) := by
    intro Z Y B hc 𝒜 _ _ _ X T_Y₁ T_Y₂ hT_Y₁ hT_Y₂ T_Z₁ T_Z₂ hT_Z₁ hT_Z₂
    let pf := B.sheafPushforwardContinuous 𝒜 Y.smallEtaleTopology Z.smallEtaleTopology
    let One_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology 𝒜).obj X
    let adj_Y₁ := CategoryTheory.constantSheafAdj Y.smallEtaleTopology 𝒜 hT_Y₁
    let adj_Z₁ := CategoryTheory.constantSheafAdj Z.smallEtaleTopology 𝒜 hT_Z₁
    let adj_Z₂ := CategoryTheory.constantSheafAdj Z.smallEtaleTopology 𝒜 hT_Z₂
    refine (congrArg (adj_Y₁.homEquiv X (pf.obj One_Z)).symm ?_).trans
      (hConstSymmMap hT_Y₂ hT_Y₁ X (pf.obj One_Z)
        (adj_Z₂.unit.app X ≫ One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op))
    have hu : adj_Z₁.unit.app X = adj_Z₂.unit.app X ≫ One_Z.obj.map (hT_Z₂.from T_Z₁).op :=
      (hConstUnitMap hT_Z₂ hT_Z₁ (hT_Z₂.from T_Z₁) X).symm
    have hm1 : One_Z.obj.map (hT_Z₂.from T_Z₁).op ≫
        One_Z.obj.map (hT_Z₁.from (B.obj T_Y₁)).op =
        One_Z.obj.map (hT_Z₁.from (B.obj T_Y₁) ≫ hT_Z₂.from T_Z₁).op :=
      (One_Z.obj.map_comp _ _).symm.trans
        (congrArg One_Z.obj.map (CategoryTheory.op_comp (f := _) (g := _)).symm)
    have hm2 : One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op ≫
        One_Z.obj.map (B.map (hT_Y₂.from T_Y₁)).op =
        One_Z.obj.map (B.map (hT_Y₂.from T_Y₁) ≫ hT_Z₂.from (B.obj T_Y₂)).op :=
      (One_Z.obj.map_comp _ _).symm.trans
        (congrArg One_Z.obj.map (CategoryTheory.op_comp (f := _) (g := _)).symm)
    have h_term : hT_Z₁.from (B.obj T_Y₁) ≫ hT_Z₂.from T_Z₁ =
        B.map (hT_Y₂.from T_Y₁) ≫ hT_Z₂.from (B.obj T_Y₂) :=
      hT_Z₂.hom_ext _ _
    have h_lhs : adj_Z₁.unit.app X ≫ One_Z.obj.map (hT_Z₁.from (B.obj T_Y₁)).op =
        adj_Z₂.unit.app X ≫ One_Z.obj.map (hT_Z₁.from (B.obj T_Y₁) ≫ hT_Z₂.from T_Z₁).op :=
      (congrArg (· ≫ _) hu).trans
        ((CategoryTheory.Category.assoc _ _ _).trans (congrArg (adj_Z₂.unit.app X ≫ ·) hm1))
    have h_rhs : (adj_Z₂.unit.app X ≫ One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op) ≫
          (pf.obj One_Z).obj.map (hT_Y₂.from T_Y₁).op =
        adj_Z₂.unit.app X ≫ One_Z.obj.map (B.map (hT_Y₂.from T_Y₁) ≫ hT_Z₂.from (B.obj T_Y₂)).op :=
      (CategoryTheory.Category.assoc (adj_Z₂.unit.app X)
        (One_Z.obj.map (hT_Z₂.from (B.obj T_Y₂)).op)
        (One_Z.obj.map (B.map (hT_Y₂.from T_Y₁)).op)).trans
        (congrArg (adj_Z₂.unit.app X ≫ ·) hm2)
    exact h_lhs.trans
      ((congrArg (fun k => adj_Z₂.unit.app X ≫ One_Z.obj.map k.op) h_term).trans h_rhs.symm)
