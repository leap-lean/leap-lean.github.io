      obtain ⟨S₁, hS₁_mem, hS₁⟩ := hLoc1 q U (π_H U_W q ξ)
      refine ⟨S_target, J₁.transitive hS₁_mem S_target ?_, fun V f hf => hf⟩
      intro V f hf
      by_cases hV_ne : Nonempty ↥(Fgt₁.obj V).left
      · obtain ⟨c₁, hc₁⟩ := hS₁ V f hf
        let V_W := (Fgt_W.obj (B₁.obj V)).left
        let f_W := (Fgt_W.map (B₁.map f)).left
        let π₂_V := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj V)).hom pr₂
        have hNat_ι_W : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
            (a : weilEtaleTorsionH Z₂ (ℓ ^ r) q),
            p_std h (ℓ ^ (r + 1)) q (ι_H Z₂ q a) = ι_H Z₁ q (p_std h (ℓ ^ r) q a) :=
          fun h a => (hNat h q).1 _ _ (hp_top h (ℓ ^ r) q) (hp_top h (ℓ ^ (r + 1)) q) a
        have hNat_π_W : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
            (b : weilEtaleTorsionH Z₂ (ℓ ^ (r + 1)) q),
            p_std h ℓ q (π_H Z₂ q b) = π_H Z₁ q (p_std h (ℓ ^ (r + 1)) q b) :=
          fun h b => (hNat h q).2.1 _ _ (hp_top h (ℓ ^ (r + 1)) q) (hp_top h ℓ q) b
        have hNat_δ_W : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
            (c₀ : weilEtaleTorsionH Z₂ ℓ q),
            p_std h (ℓ ^ r) (q + 1) (δ_H Z₂ q c₀) = δ_H Z₁ q (p_std h ℓ q c₀) :=
          fun h c₀ => (hNat h q).2.2 _ _ (hp_top h ℓ q) (hp_top h (ℓ ^ r) (q + 1)) c₀
        have hδ_kill_V : p_std π₂_V (ℓ ^ r) (q + 1) (δ_H Y₂.left q c₁) = 0 := by
          rw [hNat_δ_W π₂_V c₁, ← hc₁, hNat_π_W f_W ξ]
          exact (hEx_π V_W q _).mpr ⟨p_std f_W (ℓ ^ (r + 1)) q ξ, rfl⟩
        have hδ_c₁ : δ_H Y₂.left q c₁ = 0 :=
          hInjAll (ℓ ^ r) (q + 1) V hV_ne
            (hδ_kill_V.trans (map_zero (p_std π₂_V (ℓ ^ r) (q + 1))).symm)
        obtain ⟨c_tilde, hc_tilde⟩ := (hEx_π Y₂.left q c₁).mp hδ_c₁
        have hdiff_ker : π_H V_W q
            (p_std f_W (ℓ ^ (r + 1)) q ξ - p_std π₂_V (ℓ ^ (r + 1)) q c_tilde) = 0 := by
          rw [map_sub, ← hNat_π_W f_W ξ, ← hNat_π_W π₂_V c_tilde, hc_tilde, hc₁, sub_self]
        obtain ⟨η_V, hη_V⟩ := (hEx_ι V_W q _).mp hdiff_ker
        obtain ⟨S₂, hS₂_mem, hS₂⟩ := ih q V η_V
        refine J₁.superset_covering ?_ hS₂_mem
        intro W g hg
        obtain ⟨c₀, hc₀⟩ := hS₂ W g hg
        refine ⟨c_tilde + ι_H Y₂.left q c₀, ?_⟩
        let g_W := (Fgt_W.map (B₁.map g)).left
        let π₂_W := CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj W)).hom pr₂
        have hgf_left : (Fgt_W.map (B₁.map (CategoryTheory.CategoryStruct.comp g f))).left =
            CategoryTheory.CategoryStruct.comp g_W f_W := by
          rw [B₁.map_comp, Fgt_W.map_comp]
          rfl
        have hg_π₂ : CategoryTheory.CategoryStruct.comp g_W π₂_V = π₂_W := by
          dsimp [g_W, π₂_V, π₂_W]
          rw [← CategoryTheory.Category.assoc, (Fgt_W.map (B₁.map g)).w]
        have hξ_split : p_std f_W (ℓ ^ (r + 1)) q ξ =
            p_std π₂_V (ℓ ^ (r + 1)) q c_tilde + ι_H V_W q η_V := by
          rw [hη_V, add_sub_cancel]
        rw [hgf_left, hp_std_comp, AddMonoidHom.comp_apply, hξ_split, map_add,
          ← AddMonoidHom.comp_apply, ← hp_std_comp, hg_π₂,
          hNat_ι_W g_W η_V, hc₀, ← hNat_ι_W π₂_W c₀, ← map_add]
      · have hEmp : IsEmpty ↥(Fgt₁.obj V).left := not_nonempty_iff.mp hV_ne
        refine J₁.superset_covering ?_ (hBotMem V hEmp)
        intro W g hg
        exact False.elim hg
  refine ⟨hPullTopEx, fun r q U => ⟨?_, ?_⟩⟩
  · intro hU_ne p_U hp_U
    rw [hp_eq_std _ (ℓ ^ r) q p_U hp_U]
    exact hInjAll (ℓ ^ r) q U hU_ne
  · intro ξ
    obtain ⟨S, hS_mem, hS⟩ := hLocAll r q U ξ
    refine ⟨S, hS_mem, fun V f hf => ?_⟩
    obtain ⟨c, hc⟩ := hS V f hf
    refine ⟨c, fun p_f p_V hp_f hp_V => ?_⟩
    rw [hp_eq_std _ (ℓ ^ r) q p_f hp_f, hp_eq_std _ (ℓ ^ r) q p_V hp_V]
    exact hc

theorem weil_kunneth_module_pullback_adjunction_and_intertwining (m₀ : ℕ) (hm₀ : 1 ≤ m₀)
    (hAdjAb : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
