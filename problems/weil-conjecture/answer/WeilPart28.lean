        Category.comp_id _
      refine (congrArg (u₀_of W₂ m ≫ ·) happ_id).trans ?_
      exact (F_fg.map_comp _ _).symm.trans
        ((congrArg F_fg.map hu_app).trans (F_fg.map_comp _ _))
    rw [hLHS]
    have hR1 : adj_ab.homEquiv (C_ab₂.obj AM) (U₁.obj (One_of W₁ m)) (πM_ab ≫ αM_of W₁ m) =
        (adj_ab₂.homEquiv AM (pf_ab.obj (C_ab₁.obj AM))).symm
          (adj_ab₁.unit.app AM ≫ (C_ab₁.obj AM).obj.map τ_h.op) ≫
          pf_ab.map (αM_of W₁ m) := by
      rw [Adjunction.homEquiv_naturality_right adj_ab πM_ab (αM_of W₁ m)]
      congr 1
      exact Equiv.apply_symm_apply _ _
    rw [hR1, Adjunction.homEquiv_naturality_right adj_ab₂, Equiv.apply_symm_apply]
    have hnat_α := (αM_of W₁ m).hom.naturality τ_h.op
    have hα₁ : adj_ab₁.unit.app AM ≫ (αM_of W₁ m).hom.app (Opposite.op (T_of W₁)) =
        ιM_of m ≫ u₀_of W₁ m := by
      have h0 := h_αM_homEquiv W₁ m
      rw [Adjunction.homEquiv_unit] at h0
      exact h0
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ _) hα₁.symm).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (adj_ab₁.unit.app AM ≫ ·) hnat_α.symm).trans
            (Category.assoc _ _ _).symm)))

  
  have hπ_align : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [Category.{u, u + 1} 𝒜]
      [HasWeakSheafify W₁.smallEtaleTopology 𝒜] [HasWeakSheafify W₂.smallEtaleTopology 𝒜]
      (B : W₂.Etale ⥤ W₁.Etale) [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology]
      (P_pull pb : Sheaf W₂.smallEtaleTopology 𝒜 ⥤ Sheaf W₁.smallEtaleTopology 𝒜)
      (adj_pull : P_pull ⊣ B.sheafPushforwardContinuous 𝒜 W₂.smallEtaleTopology W₁.smallEtaleTopology)
      (adj : pb ⊣ B.sheafPushforwardContinuous 𝒜 W₂.smallEtaleTopology W₁.smallEtaleTopology)
      {T₁ : W₁.Etale} (hT₁ : Limits.IsTerminal T₁)
      {T₂ : W₂.Etale} (hT₂ : Limits.IsTerminal T₂) (A : 𝒜),
      let pf := B.sheafPushforwardContinuous 𝒜 W₂.smallEtaleTopology W₁.smallEtaleTopology
      let C₁ := constantSheaf W₁.smallEtaleTopology 𝒜
      let C₂ := constantSheaf W₂.smallEtaleTopology 𝒜
      let adj₁ := constantSheafAdj W₁.smallEtaleTopology 𝒜 hT₁
      let adj₂ := constantSheafAdj W₂.smallEtaleTopology 𝒜 hT₂
      let adj₁_0 := constantSheafAdj W₁.smallEtaleTopology 𝒜 (hT_of W₁)
      let adj₂_0 := constantSheafAdj W₂.smallEtaleTopology 𝒜 (hT_of W₂)
      let η : P_pull ≅ pb := adj_pull.leftAdjointUniq adj
      (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
        ((adj₂.homEquiv A (pf.obj (C₁.obj A))).symm
          (adj₁.unit.app A ≫ (C₁.obj A).obj.map (hT₁.from (B.obj T₂)).op)) =
      η.hom.app (C₂.obj A) ≫
        (adj.homEquiv (C₂.obj A) (C₁.obj A)).symm
          ((adj₂_0.homEquiv A (pf.obj (C₁.obj A))).symm
            (adj₁_0.unit.app A ≫ (C₁.obj A).obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op)) := by
    intro W₁ W₂ 𝒜 _ _ _ B _ P_pull pb adj_pull adj T₁ hT₁ T₂ hT₂ A
      pf C₁ C₂ adj₁ adj₂ adj₁_0 adj₂_0 η
    set π_std := (adj.homEquiv (C₂.obj A) (C₁.obj A)).symm
      ((adj₂_0.homEquiv A (pf.obj (C₁.obj A))).symm
        (adj₁_0.unit.app A ≫ (C₁.obj A).obj.map ((hT_of W₁).from (B.obj (T_of W₂))).op))
    apply (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).injective
    rw [Equiv.apply_symm_apply, hq_indep B hT₂ (hT_of W₂) hT₁ (hT_of W₁) A,
      Adjunction.homEquiv_naturality_right adj_pull (η.hom.app (C₂.obj A)) π_std,
      Adjunction.homEquiv_leftAdjointUniq_hom_app adj_pull adj (C₂.obj A),
      ← Adjunction.homEquiv_unit adj (C₂.obj A) (C₁.obj A) π_std,
      Equiv.apply_symm_apply]

  have hπ_nat_coeff : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
      (B : W₂.Etale ⥤ W₁.Etale) [B.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology]
      (pb : Sheaf W₂.smallEtaleTopology AddCommGrpCat.{u} ⥤
        Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u})
      (adj : pb ⊣ B.sheafPushforwardContinuous AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology)
      {A₁ A₂ : AddCommGrpCat.{u}} (φ : A₁ ⟶ A₂),
      let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology
      let C₁ := constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
      let adj₁ := constantSheafAdj W₁.smallEtaleTopology AddCommGrpCat.{u} (hT_of W₁)
      let adj₂ := constantSheafAdj W₂.smallEtaleTopology AddCommGrpCat.{u} (hT_of W₂)
      let τ_h := (hT_of W₁).from (B.obj (T_of W₂))
      let π₁ := (adj.homEquiv (C₂.obj A₁) (C₁.obj A₁)).symm
        ((adj₂.homEquiv A₁ (pf.obj (C₁.obj A₁))).symm
          (adj₁.unit.app A₁ ≫ (C₁.obj A₁).obj.map τ_h.op))
      let π₂ := (adj.homEquiv (C₂.obj A₂) (C₁.obj A₂)).symm
        ((adj₂.homEquiv A₂ (pf.obj (C₁.obj A₂))).symm
          (adj₁.unit.app A₂ ≫ (C₁.obj A₂).obj.map τ_h.op))
