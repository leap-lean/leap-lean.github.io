          (let hT₂ := weilEtaleIdTerminalIsTerminal.{u} W₂
           let hT₁ := weilEtaleIdTerminalIsTerminal.{u} W₁
           let adjR₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology (ModuleCat.{u, u} R) hT₂
           let adjR₁ := CategoryTheory.constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R) hT₁
           ∀ (ℱ : CategoryTheory.Sheaf W₁.smallEtaleTopology (ModuleCat.{u, u} R))
             (g : Quiver.Hom (weilEtaleModuleUnit W₁ m₀) ℱ) (U : W₂.Etale),
             let hat_g := (adj.homEquiv (weilEtaleModuleUnit W₂ m₀) ℱ)
               (CategoryTheory.CategoryStruct.comp e_unit.inv g)
