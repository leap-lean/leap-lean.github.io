      have hz₀_eq : (B_V.map f).left.base z₀ = z := by
        apply (CategoryTheory.Limits.pullback.fst W.hom V.ι).isOpenEmbedding.injective
        have h_fst_comp : CategoryTheory.CategoryStruct.comp (B_V.map f).left
