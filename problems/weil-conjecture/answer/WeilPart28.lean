      have hExactAndCoker : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y),
          ((C.map i_push_ab).map (Stalk ξ)).Exact ∧
          CategoryTheory.Limits.IsZero
            ((Stalk ξ).obj (CategoryTheory.Limits.cokernel (i_push_ab.map C.g))) := by
        intro Ω _ _ ξ
        haveI := hStalkAdditive ξ
        haveI := hStalkPreservesLimits ξ
        haveI := hStalkPreservesColimits ξ
        by_cases hIn : ∃ ξ_Z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z, ξ_Z ≫ i = ξ
        · rcases hIn with ⟨ξ_Z, rfl⟩
          haveI := hStalkAdditive ξ_Z
          haveI := hStalkPreservesLimits ξ_Z
          haveI := hStalkPreservesColimits ξ_Z
          obtain ⟨_, Θ, _⟩ := hClosedPushStalkIso i hi hc_i₀ pb_i₀ adj_i₀ Ω ξ_Z
          let e_SC : (C.map i_push_ab).map (Stalk (ξ_Z ≫ i)) ≅ C.map (Stalk ξ_Z) :=
            CategoryTheory.ShortComplex.isoMk (Θ.app C.X₁) (Θ.app C.X₂) (Θ.app C.X₃)
              (Θ.hom.naturality C.f).symm (Θ.hom.naturality C.g).symm
          have hSE : (C.map (Stalk ξ_Z)).ShortExact := hC.map_of_exact (Stalk ξ_Z)
          have hEx : ((C.map i_push_ab).map (Stalk (ξ_Z ≫ i))).Exact :=
            (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC).mpr hSE.exact
          haveI : CategoryTheory.Epi ((Stalk ξ_Z).map C.g) := hSE.epi_g
          have hg_eq : (Stalk (ξ_Z ≫ i)).map (i_push_ab.map C.g) =
              Θ.hom.app C.X₂ ≫ (Stalk ξ_Z).map C.g ≫ Θ.inv.app C.X₃ := by
            have hnat := Θ.hom.naturality C.g
            exact (CategoryTheory.Category.comp_id _).symm.trans
              ((congrArg (_ ≫ ·) (Θ.hom_inv_id_app C.X₃).symm).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ Θ.inv.app C.X₃) hnat).trans
                    (CategoryTheory.Category.assoc _ _ _))))
          haveI : CategoryTheory.Epi ((Stalk (ξ_Z ≫ i)).map (i_push_ab.map C.g)) := by
            rw [hg_eq]
            exact CategoryTheory.epi_comp _ _
          have hCok0 : CategoryTheory.Limits.IsZero
              ((Stalk (ξ_Z ≫ i)).obj (CategoryTheory.Limits.cokernel (i_push_ab.map C.g))) :=
            CategoryTheory.Limits.IsZero.of_iso
              (hAbCokernelZeroOfEpi ((Stalk (ξ_Z ≫ i)).map (i_push_ab.map C.g)))
              (CategoryTheory.Limits.PreservesCokernel.iso (Stalk (ξ_Z ≫ i)) (i_push_ab.map C.g))
          exact ⟨hEx, hCok0⟩
        · have h0_X₂ : CategoryTheory.Limits.IsZero (((C.map i_push_ab).map (Stalk ξ)).X₂) :=
            hPushStalkOut i hi hc_i₀ C.X₂ ξ hIn
          have h0_X₃ : CategoryTheory.Limits.IsZero ((Stalk ξ).obj (i_push_ab.obj C.X₃)) :=
            hPushStalkOut i hi hc_i₀ C.X₃ ξ hIn
          have hEx : ((C.map i_push_ab).map (Stalk ξ)).Exact :=
            CategoryTheory.ShortComplex.exact_of_isZero_X₂ _ h0_X₂
          have hCok0 : CategoryTheory.Limits.IsZero
              ((Stalk ξ).obj (CategoryTheory.Limits.cokernel (i_push_ab.map C.g))) :=
            CategoryTheory.Limits.IsZero.of_iso
              (hAbCokernelZeroOfTargetZero ((Stalk ξ).map (i_push_ab.map C.g)) h0_X₃)
              (CategoryTheory.Limits.PreservesCokernel.iso (Stalk ξ) (i_push_ab.map C.g))
          exact ⟨hEx, hCok0⟩
      refine ⟨hStalkReflectsExact Y (C.map i_push_ab) (fun Ω _ _ ξ => (hExactAndCoker Ω ξ).1),
        hAbEpiOfCokernelZero (i_push_ab.map C.g)
          (hStalkJointZero Y _ (fun Ω _ _ ξ => (hExactAndCoker Ω ξ).2))⟩
    · 
      intro T_Y hT_Y T_Z hT_Z
      haveI := hAdd_i₀
      haveI := hColim_i₀
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
      let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
      let τ_i : (weilEtaleSitePullback i).obj T_Y ⟶ T_Z :=
        hT_Z.from ((weilEtaleSitePullback i).obj T_Y)
      let q_i_ab : Fℤ_Y ⟶ i_push_ab.obj Fℤ_Z :=
        (adj_Y.homEquiv Aℤ (i_push_ab.obj Fℤ_Z)).symm
          (adj_Z.unit.app Aℤ ≫ Fℤ_Z.obj.map τ_i.op)
      let π_A : pb_i₀.obj Fℤ_Y ⟶ Fℤ_Z := (adj_i₀.homEquiv Fℤ_Y Fℤ_Z).symm q_i_ab
      obtain ⟨ι_A, hιπ, hπι⟩ := hConst_i₀ Aℤ T_Z hT_Z T_Y hT_Y
      haveI : CategoryTheory.IsIso π_A := ⟨⟨ι_A, hπι, hιπ⟩⟩
      haveI : CategoryTheory.IsIso (adj_i₀.counit.app Fℤ_Z) :=
        hFactI i hi hc_i₀ pb_i₀ adj_i₀ Fℤ_Z
