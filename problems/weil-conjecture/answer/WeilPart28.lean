    let adj_s : P_pull_s ⊣ P_push := adj_s_raw
    let adj_r : P_pull_r ⊣ P_push := adj_r_raw
    let η : P_pull_s ≅ P_pull_r := CategoryTheory.Adjunction.leftAdjointUniq adj_s adj_r
    let adj₁ := CategoryTheory.constantSheafAdj J₁ D hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ D hT₂
    let adj'₁ := CategoryTheory.constantSheafAdj J₁ D hT'₁
    let adj'₂ := CategoryTheory.constantSheafAdj J₂ D hT'₂
    let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
    let τ' : Quiver.Hom (B.obj T'₂) T'₁ := hT'₁.from (B.obj T'₂)
