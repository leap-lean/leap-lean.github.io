    have hExtId : ∀ (A B : 𝒞) (n : ℕ) (x : Abelian.Ext.{u} A B n),
        ((𝟭 𝒞).mapExtAddHom A B n) x = x := by
      intro A B n x
      rw [Functor.mapExtAddHom_apply]
      induction n generalizing B with
      | zero =>
        have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
        rw [← hx, Abelian.Ext.mapExactFunctor_mk₀]
        rfl
      | succ k ih =>
        let ι : B ⟶ Injective.under B := Injective.ι B
        let S : ShortComplex 𝒞 := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
        have hS : S.ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x hzero rfl
        let φ_id : S.map (𝟭 𝒞) ⟶ S := { τ₁ := 𝟙 S.X₁, τ₂ := 𝟙 S.X₂, τ₃ := 𝟙 S.X₃ }
        have hext_id : (hS.map_of_exact (𝟭 𝒞)).extClass = hS.extClass :=
          ((Abelian.Ext.comp_mk₀_id _).symm.trans
            (ShortComplex.ShortExact.extClass_naturality (hS.map_of_exact (𝟭 𝒞)) hS φ_id)).trans
            (Abelian.Ext.mk₀_id_comp _)
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass, hext_id,
            ih S.X₃ z]
    have hSyzygy : ∀ (q : ℕ) {X : 𝒞} (hX : P X) (Y : 𝒞) (ξ : Abelian.Ext.{u} X Y (q + 1)),
        ∃ (K Q : 𝒞) (k : K ⟶ Q) (p : Q ⟶ X) (hk0 : k ≫ p = 0)
          (hS : (ShortComplex.mk k p hk0).ShortExact) (hK : P K) (hQ : P Q)
          (ξ' : Abelian.Ext.{u} K Y q),
          ξ = hS.extClass.comp ξ' (by omega : 1 + q = q + 1) := by
      intro q
      induction q with
      | zero =>
        intro X hX Y ξ
        let I : 𝒞 := Injective.under Y
        let ι : Y ⟶ I := Injective.ι Y
        let Q₀ : 𝒞 := Limits.cokernel ι
        let π : I ⟶ Q₀ := Limits.cokernel.π ι
        let S_inj : ShortComplex 𝒞 := ShortComplex.mk ι π (Limits.cokernel.condition ι)
        have hS_inj : S_inj.ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hzero : ξ.comp (Abelian.Ext.mk₀ S_inj.f) (Nat.add_zero 1) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z₀, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS_inj ξ hzero (Nat.zero_add 1)
        let g : X ⟶ Q₀ := Abelian.Ext.addEquiv₀ z₀
        have hz₀ : z₀ = Abelian.Ext.mk₀ g := (Abelian.Ext.addEquiv₀.left_inv z₀).symm
        rw [hz₀]
        let E : 𝒞 := Limits.pullback π g
        let p_I : E ⟶ I := Limits.pullback.fst π g
        let p_X : E ⟶ X := Limits.pullback.snd π g
        haveI : Epi p_X := Abelian.epi_pullback_of_epi_f π g
        have h_lift_pb : ι ≫ π = (0 : Y ⟶ X) ≫ g := by
          rw [Limits.cokernel.condition, Limits.zero_comp]
        let ι_E : Y ⟶ E := Limits.pullback.lift ι 0 h_lift_pb
        have hιE_I : ι_E ≫ p_I = ι := Limits.pullback.lift_fst ι 0 h_lift_pb
        have hιE_X : ι_E ≫ p_X = 0 := Limits.pullback.lift_snd ι 0 h_lift_pb
        haveI : Mono ι_E := by
          haveI : Mono (ι_E ≫ p_I) := by rw [hιE_I]; infer_instance
