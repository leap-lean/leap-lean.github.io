        let adj_ab_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology
          AddCommGrpCat.{u} (hT_of Y)
        let adj_mod_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology
          (ModuleCat.{u, u} R₁) (hT_of S)
        let adj_mod_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology
          (ModuleCat.{u, u} R₁) (hT_of Y)
        let τ_si : B_si.obj (T_of Y) ⟶ T_of S := (hT_of S).from (B_si.obj (T_of Y))
        apply (adj_ab_Y.homEquiv Aℤ ((U_of Y m₁).obj (si_push₁.obj (One_of S m₁)))).injective
        have hL1 : adj_ab_Y.homEquiv Aℤ ((U_of Y m₁).obj (si_push₁.obj (One_of S m₁)))
