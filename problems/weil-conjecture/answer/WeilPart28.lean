    have : CategoryTheory.Epi (weilGysinAbSupportQuotHom s_V hc_sV) := hEpi_sV
    have hIff_Y := hCok_i U_c rfl T_Y hT_Y T_Uc hT_Uc F
    have hIff_V := hCok_sV U_Vc hU_Vc T_V hT_V T_UVc hT_UVc (j_star.obj F)
    have hZHomInj : ∀ {G : AddCommGrpCat.{u}} (φ₁ φ₂ : Quiver.Hom Aℤ G),
