    obtain ⟨u_ab, hu_ab_r⟩ := hMapCup W a b ab hab c_ab hc_ab x₀ y₀
    obtain ⟨u_bc, hu_bc_r⟩ := hMapCup W b c bc hbc c_bc hc_bc y₀ z₀
    obtain ⟨w₁, hw₁_r⟩ := hMapCup W ab c abc hab_c c_ab_c hc_ab_c u_ab z₀
    obtain ⟨w₂, hw₂_r⟩ := hMapCup W a bc abc ha_bc c_a_bc hc_a_bc x₀ u_bc
    have hw_eq : weilLefschetzSpaceGen H_abc w₁ = weilLefschetzSpaceGen H_abc w₂ :=
      (hGen_sign W abc H_abc w₁ w₂).1 fun r =>
        (hw₁_r r).trans
          ((congrArg (fun u => c_ab_c r u (z₀.1 r)) (hu_ab_r r)).trans
            ((hCupT_assoc W (ℓ ^ r) a b c ab bc abc hab hbc hab_c ha_bc
                (c_ab r) (c_bc r) (c_ab_c r) (c_a_bc r)
                (hc_ab r) (hc_bc r) (hc_ab_c r) (hc_a_bc r)
                (x₀.1 r) (y₀.1 r) (z₀.1 r)).trans
              ((congrArg (c_a_bc r (x₀.1 r)) (hu_bc_r r).symm).trans (hw₂_r r).symm)))
    exact (congrArg (fun u => cup_ab_c u (weilLefschetzSpaceGen H_c z₀))
        (hcup_ab x₀ y₀ u_ab hu_ab_r)).trans
      ((hcup_ab_c u_ab z₀ w₁ hw₁_r).trans
        (hw_eq.trans
          ((hcup_a_bc x₀ u_bc w₂ hw₂_r).symm.trans
            (congrArg (cup_a_bc (weilLefschetzSpaceGen H_a x₀))
              (hcup_bc y₀ z₀ u_bc hu_bc_r).symm))))
  · 
    intro W a b c hab hba H_a H_b H_c cup_ab cup_ba hcup_ab_raw hcup_ba_raw
    obtain ⟨c_ab, hc_ab, hcup_ab⟩ := (hCup_iff W a b c hab H_a H_b H_c cup_ab).mp hcup_ab_raw
    obtain ⟨c_ba, hc_ba, hcup_ba⟩ := (hCup_iff W b a c hba H_b H_a H_c cup_ba).mp hcup_ba_raw
    refine hBilinFlipExt (Padic ℓ)
      (weilLefschetzSpaceGen H_a) (weilLefschetzSpaceGen H_b)
      (fun l₁ l₂ hl => hGen_ext W a H_a l₁ l₂ hl)
      (fun l₁ l₂ hl => hGen_ext W b H_b l₁ l₂ hl)
      ((-1 : Padic ℓ) ^ (a * b)) cup_ab cup_ba fun x₀ y₀ => ?_
    obtain ⟨w_ab, hw_ab_r⟩ := hMapCup W a b c hab c_ab hc_ab x₀ y₀
    obtain ⟨w_ba, hw_ba_r⟩ := hMapCup W b a c hba c_ba hc_ba y₀ x₀
    have hrel : ∀ r : ℕ, w_ab.1 r = ((-1 : ℤ) ^ (a * b)) • w_ba.1 r := fun r =>
      (hw_ab_r r).trans
        ((hCupT_comm_of W (ℓ ^ r) a b c hab hba
            (weil_lefschetz_module_ext_cup_graded_comm W (ℓ ^ r) a b c hab hba)
            (c_ab r) (c_ba r) (hc_ab r) (hc_ba r) (x₀.1 r) (y₀.1 r)).trans
          (congrArg (((-1 : ℤ) ^ (a * b)) • ·) (hw_ba_r r).symm))
    have hsign_gen : weilLefschetzSpaceGen H_c w_ab =
        ((-1 : Padic ℓ) ^ (a * b)) • weilLefschetzSpaceGen H_c w_ba := by
      rcases Nat.even_or_odd (a * b) with heven | hodd
      · rw [heven.neg_one_pow, one_smul]
        exact (hGen_sign W c H_c w_ab w_ba).1 fun r =>
          (hrel r).trans ((congrArg (· • w_ba.1 r) heven.neg_one_pow).trans (one_zsmul _))
      · rw [hodd.neg_one_pow]
        exact (hGen_sign W c H_c w_ab w_ba).2 fun r =>
          (hrel r).trans ((congrArg (· • w_ba.1 r) hodd.neg_one_pow).trans (neg_one_zsmul _))
    exact (hcup_ab x₀ y₀ w_ab hw_ab_r).trans
      (hsign_gen.trans
        (congrArg (((-1 : Padic ℓ) ^ (a * b)) • ·) (hcup_ba y₀ x₀ w_ba hw_ba_r).symm))

theorem weil_lefschetz_relFrob_pullback_eq_model_frob_pow (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i n : ℕ)
    (Mi : WeilEllAdicCohomologyModel K Z ℓ i)
    (φ : Quiver.Hom (weilGeomScheme K Z) (weilGeomScheme K Z))
    (hφ_rel : WeilLefschetzIsRelFrobPow K Z n φ) :
    WeilLefschetzIsEllAdicPullback φ ℓ i
      { V := Mi.V, equiv := Mi.equiv, hsmul := Mi.hsmul }
      { V := Mi.V, equiv := Mi.equiv, hsmul := Mi.hsmul }
      (Mi.frob ^ n) :=
by
  
  
  
  
  let p : ℕ := ringChar K
  have hp : Nat.Prime p := by
    rcases CharP.char_is_prime_or_zero K p with hp | hp0
    · exact hp
    · exfalso
      have : CharP K 0 := hp0 ▸ (inferInstance : CharP K p)
      have : CharZero K := CharP.charP_to_charZero K
      exact not_finite K
  let ν : ℕ :=
    let _ : Fact (Nat.Prime p) := ⟨hp⟩
    let _ : Algebra (ZMod p) K := ZMod.algebra K p
    Module.finrank (ZMod p) K * n
  have hν_eq : p ^ ν = Nat.card K ^ n := by
    letI : Fact (Nat.Prime p) := ⟨hp⟩
    letI : Algebra (ZMod p) K := ZMod.algebra K p
    let finK : Fintype K := Fintype.ofFinite K
    have hFinMod : Module.Finite (ZMod p) K :=
      Module.Finite.of_fg_top ⟨@Finset.univ K finK, by simp⟩
    have hcardK : Nat.card K = p ^ Module.finrank (ZMod p) K := by
      rw [@Module.natCard_eq_pow_finrank (ZMod p) K _ _ _ hFinMod, Nat.card_zmod]
    dsimp [ν]
    rw [pow_mul, hcardK]
  let Q : ℕ := p ^ ν
  have hQ_ne : Q ≠ 0 := pow_ne_zero ν hp.ne_zero
  have hQ_pos : 0 < Q := Nat.pos_of_ne_zero hQ_ne
  have h_add_p : ∀ {R : Type u} [CommRing R], (p : R) = 0 →
      ∀ x y : R, (x + y) ^ p = x ^ p + y ^ p := by
    intro R _ hpR x y
    rw [add_pow, Finset.sum_range_succ]
    have hp1 : p = (p - 1) + 1 := (Nat.sub_add_cancel hp.one_le).symm
    have hmid : ∑ m ∈ Finset.range p, x ^ m * y ^ (p - m) * (p.choose m : R) = y ^ p := by
      conv_lhs => rw [hp1, Finset.sum_range_succ']
      have hzero : ∑ k ∈ Finset.range (p - 1),
          x ^ (k + 1) * y ^ (p - 1 + 1 - (k + 1)) * ((p - 1 + 1).choose (k + 1) : R) = 0 := by
        apply Finset.sum_eq_zero
        intro k hk
        rw [Finset.mem_range] at hk
        rw [← hp1]
        obtain ⟨c, hc⟩ := hp.dvd_choose_self (Nat.succ_ne_zero k) (by omega)
        rw [hc, Nat.cast_mul, hpR, zero_mul, mul_zero]
      rw [hzero, zero_add, ← hp1]
      simp
    rw [hmid, Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one, mul_one, add_comm]
  have h_add_Q : ∀ {R : Type u} [CommRing R], (p : R) = 0 →
      ∀ (k : ℕ) (x y : R), (x + y) ^ (p ^ k) = x ^ (p ^ k) + y ^ (p ^ k) := by
    intro R _ hpR k
    induction k with
    | zero => intro x y; simp
    | succ k ih =>
      intro x y
      rw [pow_succ, pow_mul, ih x y, h_add_p hpR, ← pow_mul, ← pow_mul]
  let σRing (R : Type u) [CommRing R] (hpR : (p : R) = 0) : R →+* R :=
    { toFun := fun s => s ^ Q
      map_one' := one_pow Q
      map_mul' := fun x y => mul_pow x y Q
      map_zero' := zero_pow hQ_ne
      map_add' := fun x y => h_add_Q hpR ν x y }
  let frPSh (W : Scheme.{u})
      (hW : ∀ V : W.Opens, (p : ↑(W.presheaf.obj (Opposite.op V))) = 0) :
      W.toPresheafedSpace ⟶ W.toPresheafedSpace :=
    PresheafedSpace.Hom.mk (𝟙 _)
      { app := fun V => CommRingCat.ofHom (σRing ↑(W.presheaf.obj V) (hW V.unop))
        naturality := fun {V₁ V₂} j => by
          ext s
          exact (map_pow (W.presheaf.map j).hom s Q).symm }
  let fr (W : Scheme.{u})
      (hW : ∀ V : W.Opens, (p : ↑(W.presheaf.obj (Opposite.op V))) = 0) : W ⟶ W :=
    Scheme.Hom.mk
      (LocallyRingedSpace.Hom.mk (frPSh W hW) (fun x =>
        { map_nonunit := fun r hr => by
            obtain ⟨V, hxV, s, hs⟩ := TopCat.Presheaf.exists_germ_eq W.presheaf r
            have hst : ((frPSh W hW).stalkMap x).hom r = r ^ Q := by
              rw [← hs]
              exact (PresheafedSpace.stalkMap_germ_apply (frPSh W hW) V x hxV s).trans
                (map_pow (W.presheaf.germ V x hxV).hom s Q)
            rw [hst] at hr
            exact (isUnit_pow_iff hQ_ne).mp hr }))
  have hfr_app : ∀ W hW (V : W.Opens) (s : ↑(W.presheaf.obj (Opposite.op V))),
      ((fr W hW).app V).hom s = s ^ Q := fun _ _ _ _ => rfl
  have hfr_nat : ∀ {W₁ W₂ : Scheme.{u}} hW₁ hW₂ (f : W₁ ⟶ W₂),
      fr W₁ hW₁ ≫ f = f ≫ fr W₂ hW₂ := by
    intro W₁ W₂ hW₁ hW₂ f
    refine Scheme.Hom.ext rfl (fun V => ?_)
    have hm : W₁.presheaf.map
        (eqToHom (by rfl) : (f ≫ fr W₂ hW₂) ⁻¹ᵁ V ⟶ (fr W₁ hW₁ ≫ f) ⁻¹ᵁ V).op = 𝟙 _ :=
      (congrArg (fun u => W₁.presheaf.map u.op) (Subsingleton.elim _ (𝟙 (f ⁻¹ᵁ V)))).trans
        (W₁.presheaf.map_id (Opposite.op (f ⁻¹ᵁ V)))
    refine ((congrArg ((fr W₁ hW₁ ≫ f).app V ≫ ·) hm).trans (Category.comp_id _)).trans ?_
    ext s
    exact (map_pow (f.app V).hom s Q).symm
  have hSpec_hom_ext : ∀ {X : Scheme.{u}} {R : CommRingCat.{u}} {f₁ f₂ : X ⟶ Spec R},
      f₁.appTop = f₂.appTop → f₁ = f₂ := by
    intro X R f₁ f₂ happ
    rw [← cancel_mono (Spec R).toSpecΓ, Scheme.toSpecΓ_naturality, Scheme.toSpecΓ_naturality, happ]
  have hSpec_char : ∀ (R : Type u) [CommRing R], (p : R) = 0 →
      ∀ V : (Spec (.of R)).Opens, (p : ↑((Spec (.of R)).presheaf.obj (Opposite.op V))) = 0 := by
    intro R _ hpR V
    let α : R →+* ↑((Spec (.of R)).presheaf.obj (Opposite.op V)) :=
      ((Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec (.of R)).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
    have h0 : α (p : R) = 0 := by rw [hpR, map_zero]
    rwa [map_natCast] at h0
  have hfr_Spec : ∀ (R : Type u) [CommRing R] (hpR : (p : R) = 0),
      fr (Spec (.of R)) (hSpec_char R hpR) = Spec.map (CommRingCat.ofHom (σRing R hpR)) := by
    intro R _ hpR
    apply hSpec_hom_ext
    rw [← cancel_epi (Scheme.ΓSpecIso (.of R)).inv]
    ext r
    have h1 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (σRing R hpR))
    have h1_r : ((Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec.map (CommRingCat.ofHom (σRing R hpR))).appTop).hom r =
        (Scheme.ΓSpecIso (.of R)).inv.hom (r ^ Q) := by
      rw [← h1]
      rfl
    change ((fr (Spec (.of R)) (hSpec_char R hpR)).app ⊤).hom
        ((Scheme.ΓSpecIso (.of R)).inv.hom r) =
      ((Scheme.ΓSpecIso (.of R)).inv ≫ (Spec.map (CommRingCat.ofHom (σRing R hpR))).appTop).hom r
    rw [hfr_app (Spec (.of R)) (hSpec_char R hpR) ⊤, h1_r]
    exact (map_pow (Scheme.ΓSpecIso (.of R)).inv.hom r Q).symm
  have hIsoBase_inj : ∀ {X Y : Scheme.{u}} (e : X ≅ Y), Function.Injective e.hom.base := by
    intro X Y e x₁ x₂ hx
    have hinv : (e.hom ≫ e.inv).base x₁ = (e.hom ≫ e.inv).base x₂ := congrArg e.inv.base hx
    simpa [e.hom_inv_id] using hinv
  have hMono_univInj : ∀ {X Y : Scheme.{u}} (m : X ⟶ Y) [Mono m], UniversallyInjective m := by
    intro X Y m hm
    have : IsIso (Limits.pullback.diagonal m) := (Limits.pullback.isIso_diagonal_iff m).mpr hm
    exact (UniversallyInjective.iff_diagonal m).mpr inferInstance
  
  have hTensorComapInj : ∀ (R₀ A₀ B₀ : Type u) [CommRing R₀] [CommRing A₀] [CommRing B₀]
      [Algebra R₀ A₀] [Algebra R₀ B₀],
      (p : R₀) = 0 → (∀ a : A₀, ∃ r : R₀, a ^ Q = algebraMap R₀ A₀ r) →
      Function.Injective
        (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := R₀) (A := A₀) (B := B₀)).toRingHom)).base := by
    intro R₀ A₀ B₀ _ _ _ _ _ hpR₀ haQ
    let _ : CommRing (TensorProduct R₀ A₀ B₀) := Algebra.TensorProduct.instCommRing
    let _ : Algebra R₀ (TensorProduct R₀ A₀ B₀) := Algebra.TensorProduct.instAlgebra
    let ψ : B₀ →+* TensorProduct R₀ A₀ B₀ :=
      (Algebra.TensorProduct.includeRight (R := R₀) (A := A₀) (B := B₀)).toRingHom
    have hpB₀ : (p : B₀) = 0 := by rw [← map_natCast (algebraMap R₀ B₀) p, hpR₀, map_zero]
    have hpT : (p : TensorProduct R₀ A₀ B₀) = 0 := by rw [← map_natCast ψ p, hpB₀, map_zero]
    have hzQ : ∀ z : TensorProduct R₀ A₀ B₀, ∃ b : B₀, z ^ Q = ψ b := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [zero_pow hQ_ne, map_zero]⟩
      | tmul a b =>
        obtain ⟨r, hr⟩ := haQ a
        refine ⟨algebraMap R₀ B₀ r * b ^ Q, ?_⟩
        have htmul_pow : ∀ m : ℕ,
            (a ⊗ₜ[R₀] b : TensorProduct R₀ A₀ B₀) ^ m = (a ^ m) ⊗ₜ[R₀] (b ^ m) := by
          intro m
          induction m with
          | zero => simp [Algebra.TensorProduct.one_def]
          | succ m ihm =>
            rw [pow_succ, ihm, Algebra.TensorProduct.tmul_mul_tmul, pow_succ, pow_succ]
        rw [htmul_pow Q, hr, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
            Algebra.smul_def]
        rfl
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨b₁, hb₁⟩ := ih₁
        obtain ⟨b₂, hb₂⟩ := ih₂
        refine ⟨b₁ + b₂, ?_⟩
        change (z₁ + z₂) ^ (p ^ ν) = ψ (b₁ + b₂)
        rw [h_add_Q hpT ν z₁ z₂]
        change z₁ ^ Q + z₂ ^ Q = ψ (b₁ + b₂)
        rw [hb₁, hb₂, map_add]
    have hsub : ∀ {q₁ q₂ : PrimeSpectrum (TensorProduct R₀ A₀ B₀)},
        PrimeSpectrum.comap ψ q₁ = PrimeSpectrum.comap ψ q₂ → q₁.asIdeal ≤ q₂.asIdeal := by
      intro q₁ q₂ hq z hz
      obtain ⟨b, hb⟩ := hzQ z
      have hψb₁ : ψ b ∈ q₁.asIdeal := by
        rw [← hb]
        exact Ideal.pow_mem_of_mem q₁.asIdeal hz Q hQ_pos
      have hb_mem : b ∈ (PrimeSpectrum.comap ψ q₁).asIdeal := hψb₁
      rw [hq] at hb_mem
      have hψb₂ : z ^ Q ∈ q₂.asIdeal := by rw [hb]; exact hb_mem
      exact q₂.isPrime.mem_of_pow_mem Q hψb₂
    have hcomap_inj : Function.Injective (PrimeSpectrum.comap ψ) := by
      intro q₁ q₂ hq
      exact PrimeSpectrum.ext (le_antisymm (hsub hq) (hsub hq.symm))
    rw [Spec.map_base]
    exact hcomap_inj
  have hUnivInj_Spec : ∀ (R : Type u) [CommRing R] (hpR : (p : R) = 0),
      UniversallyInjective (Spec.map (CommRingCat.ofHom (σRing R hpR))) := by
    intro R _ hpR
    let f₀ : Spec (.of R) ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom (σRing R hpR))
    have hAffPull : ∀ (B : Type u) [CommRing B] (α : R →+* B),
        Function.Injective
          (Limits.pullback.snd f₀ (Spec.map (CommRingCat.ofHom α))).base := by
      intro B _ α
      let algRR : Algebra R R := (σRing R hpR).toAlgebra
      let algRB : Algebra R B := α.toAlgebra
      have hSpec_ψ_inj :=
        @hTensorComapInj R R B _ _ _ algRR algRB hpR (fun a => ⟨a, rfl⟩)
      let ePB := @pullbackSpecIso R R B _ _ _ algRR algRB
      have hsnd_eq := @pullbackSpecIso_hom_snd R R B _ _ _ algRR algRB
      change Function.Injective
        (Limits.pullback.snd
          (Spec.map (CommRingCat.ofHom (@algebraMap R R _ _ algRR)))
          (Spec.map (CommRingCat.ofHom (@algebraMap R B _ _ algRB)))).base
      rw [← hsnd_eq]
      exact hSpec_ψ_inj.comp (hIsoBase_inj ePB)
    let P_inj : MorphismProperty Scheme.{u} := topologically Function.Injective
    have : IsZariskiLocalAtTarget P_inj := injective_isZariskiLocalAtTarget
    rw [universallyInjective_iff]
    intro X' Y' i₁ i₂ f' hp_sq
    have hsnd_Y' : P_inj (Limits.pullback.snd f₀ i₂) := by
      rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := P_inj)
        (fun V : Y'.affineOpens => V.1) (iSup_affineOpens_eq_top Y')]
      intro V
      let B_cat : CommRingCat.{u} := Y'.presheaf.obj (Opposite.op V.1)
      let eV : V.1.toScheme ≅ Spec B_cat := V.2.isoSpec
      let g_B : Spec B_cat ⟶ Spec (.of R) := eV.inv ≫ V.1.ι ≫ i₂
      let α : R →+* ↑B_cat := (Spec.preimage g_B).hom
      have hg_B : Spec.map (CommRingCat.ofHom α) = g_B := Spec.map_preimage g_B
      have hp_res : IsPullback ((Limits.pullback.snd f₀ i₂) ⁻¹ᵁ V.1).ι
          (Limits.pullback.snd f₀ i₂ ∣_ V.1) (Limits.pullback.snd f₀ i₂) V.1.ι :=
        (isPullback_morphismRestrict (Limits.pullback.snd f₀ i₂) V.1).flip
      have hp_main : IsPullback (Limits.pullback.fst f₀ i₂) (Limits.pullback.snd f₀ i₂) f₀ i₂ :=
        IsPullback.of_hasPullback f₀ i₂
      have hp_paste : IsPullback
          (((Limits.pullback.snd f₀ i₂) ⁻¹ᵁ V.1).ι ≫ Limits.pullback.fst f₀ i₂)
          (Limits.pullback.snd f₀ i₂ ∣_ V.1) f₀ (V.1.ι ≫ i₂) :=
        hp_res.paste_horiz hp_main
      have hp_bot : IsPullback (V.1.ι ≫ i₂) eV.hom (𝟙 (Spec (.of R)))
          (Spec.map (CommRingCat.ofHom α)) := by
        refine IsPullback.of_vert_isIso ⟨?_⟩
        rw [Category.comp_id, hg_B, ← Category.assoc, eV.hom_inv_id, Category.id_comp]
      have hp_aff := hp_paste.paste_vert hp_bot
      have hfac := hp_aff.isoPullback_hom_snd
      have hcomp_inj : Function.Injective
          ((Limits.pullback.snd f₀ i₂ ∣_ V.1) ≫ eV.hom).base := by
        rw [← hfac]
        exact (hAffPull ↑B_cat α).comp (hIsoBase_inj hp_aff.isoPullback)
      exact fun x₁ x₂ hx => hcomp_inj (congrArg eV.hom.base hx)
    have hf'_fac : hp_sq.flip.isoPullback.hom ≫ Limits.pullback.snd f₀ i₂ = f' :=
      hp_sq.flip.isoPullback_hom_snd
    change Function.Injective f'.base
    rw [← hf'_fac]
    exact hsnd_Y'.comp (hIsoBase_inj hp_sq.flip.isoPullback)
  have hUnivInj_fr : ∀ (W : Scheme.{u})
      (hW : ∀ V : W.Opens, (p : ↑(W.presheaf.obj (Opposite.op V))) = 0),
      UniversallyInjective (fr W hW) := by
    intro W hW
    rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @UniversallyInjective)
      (fun V : W.affineOpens => V.1) (iSup_affineOpens_eq_top W)]
    intro V
    have hV_char : ∀ U₀ : V.1.toScheme.Opens,
        (p : ↑(V.1.toScheme.presheaf.obj (Opposite.op U₀))) = 0 := by
      intro U₀
      let α : ↑(W.presheaf.obj (Opposite.op ⊤)) →+*
          ↑(V.1.toScheme.presheaf.obj (Opposite.op U₀)) :=
        (V.1.ι.appTop ≫ V.1.toScheme.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op).hom
      have h0 : α (p : ↑(W.presheaf.obj (Opposite.op ⊤))) = 0 := by rw [hW ⊤, map_zero]
      rwa [map_natCast] at h0
    let R_V : Type u := ↑(W.presheaf.obj (Opposite.op V.1))
    have hpRV : (p : R_V) = 0 := hW V.1
    have hres_eq : (fr W hW ∣_ V.1) =
        V.2.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (σRing R_V hpRV)) ≫ V.2.isoSpec.inv := by
