      let x_tup : (b : Bool) → P_F.obj (Opposite.op (X_cov b)) :=
        fun b => by cases b; exact (0 : ↥(F.obj.obj (Opposite.op W_Uc))); exact s'
      have hCrossZero : ∀ (Z_et : Y.Etale) (v₁ : Quiver.Hom Z_et W_V) (v₂ : Quiver.Hom Z_et W_Uc),
          CategoryTheory.CategoryStruct.comp v₁ μ_V = CategoryTheory.CategoryStruct.comp v₂ μ_Uc →
          F.obj.map (Opposite.op v₁) s' = 0 := by
        intro Z_et v₁ v₂ _
        have hv₁_w : CategoryTheory.CategoryStruct.comp v₁.left V.ι = Z_et.hom :=
          (congrArg (CategoryTheory.CategoryStruct.comp v₁.left)
            (CategoryTheory.Category.id_comp V.ι)).symm.trans (hOverW v₁)
        have hv₂_w : CategoryTheory.CategoryStruct.comp v₂.left U_c.ι = Z_et.hom :=
          (congrArg (CategoryTheory.CategoryStruct.comp v₂.left)
            (CategoryTheory.Category.id_comp U_c.ι)).symm.trans (hOverW v₂)
        have hRange : Set.range v₁.left.base ⊆ Set.range U_Vc.ι.base := by
          erw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨z, rfl⟩
          change V.ι.base (v₁.left.base z) ∈ U_c
          have hpt : V.ι.base (v₁.left.base z) = U_c.ι.base (v₂.left.base z) := by
            change (v₁.left ≫ V.ι).base z = (v₂.left ≫ U_c.ι).base z
            rw [hv₁_w, hv₂_w]
          rw [hpt]
          exact (v₂.left.base z).2
        let l : Quiver.Hom Z_et.left U_Vc.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift U_Vc.ι v₁.left hRange
        have hl_fac : CategoryTheory.CategoryStruct.comp l U_Vc.ι = v₁.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac U_Vc.ι v₁.left hRange
        let W_UVc : Y.Etale := M_V.obj ((weilGysinAbOpenMapSite U_Vc).obj T_UVc)
        have hl_ov : CategoryTheory.CategoryStruct.comp l W_UVc.hom = Z_et.hom :=
          (congrArg (CategoryTheory.CategoryStruct.comp l)
            (congrArg (fun k => CategoryTheory.CategoryStruct.comp k V.ι)
              (CategoryTheory.Category.id_comp U_Vc.ι))).trans
            ((CategoryTheory.Category.assoc l U_Vc.ι V.ι).symm.trans
              ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k V.ι) hl_fac).trans hv₁_w))
        let w₁ : Quiver.Hom Z_et W_UVc :=
          CategoryTheory.MorphismProperty.Over.homMk l hl_ov trivial
        have hw₁_comp : CategoryTheory.CategoryStruct.comp w₁ (M_V.map ν_UVc) = v₁ := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          apply (CategoryTheory.cancel_mono V.ι).mp
          have hcomp_w : CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp w₁ (M_V.map ν_UVc)).left V.ι = Z_et.hom :=
            (congrArg (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp w₁ (M_V.map ν_UVc)).left)
              (CategoryTheory.Category.id_comp V.ι)).symm.trans
              (hOverW (CategoryTheory.CategoryStruct.comp w₁ (M_V.map ν_UVc)))
          exact hcomp_w.trans hv₁_w.symm
        exact (congrArg (fun k => F.obj.map (Opposite.op k) s') hw₁_comp).symm.trans
          ((congrArg (fun φ => φ s')
            (F.obj.map_comp (Opposite.op (M_V.map ν_UVc)) (Opposite.op w₁))).trans
            ((congrArg (F.obj.map (Opposite.op w₁)) hs'_van).trans (map_zero _)))
      have hCompat : CategoryTheory.Presieve.Arrows.Compatible P_F π_cov x_tup := by
        intro b₁ b₂ Z_et v₁ v₂ hv_eq
        cases b₁ <;> cases b₂
        · change F.obj.map (Opposite.op v₁) 0 = F.obj.map (Opposite.op v₂) 0
          rw [map_zero, map_zero]
        · change F.obj.map (Opposite.op v₁) 0 = F.obj.map (Opposite.op v₂) s'
          rw [map_zero]
          exact (hCrossZero Z_et v₂ v₁ hv_eq.symm).symm
        · change F.obj.map (Opposite.op v₁) s' = F.obj.map (Opposite.op v₂) 0
          rw [map_zero]
          exact hCrossZero Z_et v₁ v₂ hv_eq
        · change F.obj.map (Opposite.op v₁) s' = F.obj.map (Opposite.op v₂) s'
          have hv₁₂ : v₁ = v₂ := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            apply (CategoryTheory.cancel_mono V.ι).mp
            have hw₁ : CategoryTheory.CategoryStruct.comp v₁.left V.ι = Z_et.hom :=
              (congrArg (CategoryTheory.CategoryStruct.comp v₁.left)
                (CategoryTheory.Category.id_comp V.ι)).symm.trans (hOverW v₁)
            have hw₂ : CategoryTheory.CategoryStruct.comp v₂.left V.ι = Z_et.hom :=
              (congrArg (CategoryTheory.CategoryStruct.comp v₂.left)
                (CategoryTheory.Category.id_comp V.ι)).symm.trans (hOverW v₂)
            exact hw₁.trans hw₂.symm
          rw [hv₁₂]
      obtain ⟨s, hs, _⟩ := hSheafFor x_tup hCompat
      have hs_V : F.obj.map (Opposite.op μ_V) s = s' := hs true
      have hs_Uc : F.obj.map (Opposite.op μ_Uc) s = 0 := hs false
      obtain ⟨φ_s, hφ_s⟩ := hZHomSurj s
      let g_Y : Quiver.Hom Fℤ_Y F := (adj_Y.homEquiv Aℤ F).symm φ_s
      have hg_Y_ev : ((adj_Y.homEquiv Aℤ F) g_Y) (ULift.up (1 : ℤ)) = s := by
        rw [(adj_Y.homEquiv Aℤ F).apply_symm_apply, hφ_s]
      obtain ⟨f, hf⟩ := (hIff_Y g_Y).mpr (by rw [hg_Y_ev]; exact hs_Uc)
      refine ⟨f, ?_⟩
      apply (CategoryTheory.cancel_epi (weilGysinAbSupportQuotHom s_V hc_sV)).mp
      have hcomm_f : CategoryTheory.CategoryStruct.comp (weilGysinAbSupportQuotHom s_V hc_sV)
          (CategoryTheory.CategoryStruct.comp β_V (j_star.map f)) =
          CategoryTheory.CategoryStruct.comp (weilGysinAbOpenConstHom V hc_MV Aℤ)
            (j_star.map g_Y) := by
        rw [← CategoryTheory.Category.assoc, hβ_comm, CategoryTheory.Category.assoc,
          ← j_star.map_comp, hf]
      rw [hcomm_f]
      apply (adj_V.homEquiv Aℤ (j_star.obj F)).injective
      apply hZHomInj
      rw [hEvRestrict g_Y, hg_Y_ev, hs_V]
  exact ⟨h_s1 (fun j hj hc_j => (h_s2 j hj hc_j).1),
    fun i U hi hU hc_i => ((h_s2 i hi hc_i).2 U hU).1,
    h_s3 (fun j hj hc_j => ⟨(h_s2 j hj hc_j).1, fun U hU => ((h_s2 j hj hc_j).2 U hU).2⟩)⟩

theorem weil_gysin_ab_boundary_connecting_and_cartesian_pullback (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hEtPull : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂) (m i : ℕ),
      ∃ p : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i,
        WeilIsTorsionEtalePullback h m i p)
    (hOpenAdj : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (V : Y.Opens),
      let M_V := weilGysinAbOpenMapSite V
      let B_V := weilEtaleSitePullback V.ι
      ∃ (hCont_M : M_V.IsContinuous V.toScheme.smallEtaleTopology Y.smallEtaleTopology)
        (hCont_B : B_V.IsContinuous Y.smallEtaleTopology V.toScheme.smallEtaleTopology),
        letI := hCont_M
        letI := hCont_B
        let j_star := M_V.sheafPushforwardContinuous AddCommGrpCat.{u}
          V.toScheme.smallEtaleTopology Y.smallEtaleTopology
        let j_push := B_V.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology V.toScheme.smallEtaleTopology
        ∃ (adj_star_push : CategoryTheory.Adjunction j_star j_push)
          (hAdd_star : j_star.Additive)
          (hLim_star : CategoryTheory.Limits.PreservesFiniteLimits j_star)
          (hColim_star : CategoryTheory.Limits.PreservesFiniteColimits j_star)
          (j_shriek : CategoryTheory.Functor
            (CategoryTheory.Sheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
          (adj_shriek_star : CategoryTheory.Adjunction j_shriek j_star),
          (∀ (A : AddCommGrpCat.{u}),
            let C_V := CategoryTheory.constantSheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u}
            let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
            let hT_V := weilEtaleIdTerminalIsTerminal.{u} V.toScheme
            let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
            let adj_V := CategoryTheory.constantSheafAdj
              V.toScheme.smallEtaleTopology AddCommGrpCat.{u} hT_V
            let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
            let π_A := (adj_star_push.homEquiv (C_Y.obj A) (C_V.obj A)).symm
