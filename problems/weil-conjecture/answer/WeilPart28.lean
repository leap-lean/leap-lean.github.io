    refine ⟨R, hR_mem, fun V f hf => ?_⟩
    obtain ⟨c, hc⟩ := hR V f hf
    refine ⟨c, ?_⟩
    have hc' := congrArg (e (B₁.obj V)) hc
    change e (B₁.obj V) ((P_cohom.map (Opposite.op (B₁.map f))).hom ((e (B₁.obj U)).symm ξ)) =
      e (B₁.obj V) ((e (B₁.obj V)).symm
        (p_std (CategoryTheory.CategoryStruct.comp (Fgt_W.obj (B₁.obj V)).hom pr₂) ℓ q c)) at hc'
