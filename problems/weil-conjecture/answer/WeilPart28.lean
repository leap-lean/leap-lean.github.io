      CategoryTheory.CategoryStruct.comp
        (((CategoryTheory.sheafSections J 𝒟).obj (Opposite.op T)).map f)
        (𝒢.obj.map (Opposite.op θ)) :=
      f.hom.naturality (Opposite.op θ)
    rw [hnat, ← CategoryTheory.Category.assoc, hf]
  refine ⟨?_, ?_⟩
  · 
    have hExtIso :
        ∀ {𝒞 𝒟 : Type (u + 1)}
          [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Abelian 𝒞]
          [CategoryTheory.HasExt.{u} 𝒞] [CategoryTheory.EnoughInjectives 𝒞]
          [CategoryTheory.Category.{u + 1, u + 1} 𝒟] [CategoryTheory.Abelian 𝒟]
          [CategoryTheory.HasExt.{u} 𝒟]
          (F G : CategoryTheory.Functor 𝒞 𝒟)
          [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
          [CategoryTheory.Limits.PreservesFiniteColimits F]
          [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
          [CategoryTheory.Limits.PreservesFiniteColimits G]
          (η : F ≅ G) (X : 𝒞) (i : ℕ) (Y : 𝒞) (y : CategoryTheory.Abelian.Ext X Y i),
