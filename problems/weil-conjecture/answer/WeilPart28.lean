    let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback PEt ⊤ h
    let J₁ := W₁.smallEtaleTopology
    let J₂ := W₂.smallEtaleTopology
    let D := AddCommGrpCat.{u}
