    let τ_g : B_g.obj T_Y ⟶ T_Y' := hT_Y'.from (B_g.obj T_Y)
    let AM_succ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
    let AM_curr := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r)))
    let φ_cast : AM_succ ⟶ AM_curr :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom)
    let πM_succ : P_pull.obj (C_Y.obj AM_succ) ⟶ C_Y'.obj AM_succ :=
      (adj_pull.homEquiv (C_Y.obj AM_succ) (C_Y'.obj AM_succ)).symm
        ((adj_Y.homEquiv AM_succ (g_push.obj (C_Y'.obj AM_succ))).symm
          (adj_Y'.unit.app AM_succ ≫ (C_Y'.obj AM_succ).obj.map τ_g.op))
    let πM_curr : P_pull.obj (C_Y.obj AM_curr) ⟶ C_Y'.obj AM_curr :=
      (adj_pull.homEquiv (C_Y.obj AM_curr) (C_Y'.obj AM_curr)).symm
        ((adj_Y.homEquiv AM_curr (g_push.obj (C_Y'.obj AM_curr))).symm
          (adj_Y'.unit.app AM_curr ≫ (C_Y'.obj AM_curr).obj.map τ_g.op))
    have hπ_nat : πM_succ ≫ C_Y'.map φ_cast = P_pull.map (C_Y.map φ_cast) ≫ πM_curr := by
      let h_succ : AM_succ ⟶
          ((CategoryTheory.sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op T_Y)).obj (g_push.obj (C_Y'.obj AM_succ)) :=
        adj_Y'.unit.app AM_succ ≫ (C_Y'.obj AM_succ).obj.map τ_g.op
      let g_curr : AM_curr ⟶
          ((CategoryTheory.sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op T_Y)).obj (g_push.obj (C_Y'.obj AM_curr)) :=
        adj_Y'.unit.app AM_curr ≫ (C_Y'.obj AM_curr).obj.map τ_g.op
      have h_sq₀ : φ_cast ≫ g_curr = h_succ ≫
          ((CategoryTheory.sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op T_Y)).map (g_push.map (C_Y'.map φ_cast)) := by
        have h_u : φ_cast ≫ adj_Y'.unit.app AM_curr =
            adj_Y'.unit.app AM_succ ≫ (C_Y'.map φ_cast).hom.app (Opposite.op T_Y') :=
          adj_Y'.unit.naturality φ_cast
        have h_m : (C_Y'.obj AM_succ).obj.map τ_g.op ≫
            (C_Y'.map φ_cast).hom.app (Opposite.op (B_g.obj T_Y)) =
            (C_Y'.map φ_cast).hom.app (Opposite.op T_Y') ≫
              (C_Y'.obj AM_curr).obj.map τ_g.op :=
          (C_Y'.map φ_cast).hom.naturality τ_g.op
        exact (CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ _) h_u).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg _ h_m.symm).trans
                (CategoryTheory.Category.assoc _ _ _).symm)))
      have h_sq₁ := CategoryTheory.Adjunction.homEquiv_naturality_right_square
        adj_Y (Y := g_push.obj (C_Y'.obj AM_succ)) (Y' := g_push.obj (C_Y'.obj AM_curr))
        φ_cast g_curr h_succ (g_push.map (C_Y'.map φ_cast)) h_sq₀
      exact (CategoryTheory.Adjunction.homEquiv_naturality_right_square
        adj_pull (Y := C_Y'.obj AM_succ) (Y' := C_Y'.obj AM_curr)
        (C_Y.map φ_cast) _ _ (C_Y'.map φ_cast) h_sq₁).symm
    exact (congrArg
      (fun x => x.comp (CategoryTheory.Abelian.Ext.mk₀ (C_Y'.map φ_cast)) (Nat.add_zero q))
      hval_succ).trans
      (hExt_pb_trans P_pull β πM_succ πM_curr (C_Y.map φ_cast) (C_Y'.map φ_cast) hπ_nat q α_succ.val)
  
  obtain ⟨hSite, τ_iso, hIsoUnit,
      ⟨hIso_pb, hIso_fg, hIso_ab_all⟩,
      ⟨hFg_ex, hFg_pb, hTorsPb_ex⟩,
      hAb_fg_trans⟩ :=
    weil_gysin_etale_site_pullback_and_torsion_functoriality ℓ (@hContAll)
  obtain ⟨⟨hPb_ex, hPb_uniq⟩, ⟨hAb_pb_uniq, hAb_pb_fwd⟩, hExc_ex⟩ :=
    weil_gysin_closed_support_pullback_and_open_excision hSite ℓ
  obtain ⟨hExactAb, hGys_ex, hGys_unitL, hGys_unitR, hGys_assoc, hGys_pb⟩ :=
    weil_gysin_closed_immersion_exact_and_gysin_comp hSite ℓ (@τ_iso) hIsoUnit
  obtain ⟨hAb_equiv, hAb_gys_trans⟩ :=
    weil_gysin_ab_support_comparison_and_gysin_transition hExactAb ℓ
  have hSuppExt : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (a₁ a₂ : WeilGysinSupportClass Z Y i m q), a₁.val = a₂.val → a₁ = a₂ := by
    rintro Z Y i m q ⟨_, v₁⟩ ⟨_, v₂⟩ hv
    subst hv
    rfl
  have hAb_pb_iff : ∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
      (g_Z : Quiver.Hom Z' Z),
      AlgebraicGeometry.IsClosedImmersion i' →
      AlgebraicGeometry.IsClosedImmersion i →
      CategoryTheory.IsPullback i' g_Z g i →
      ∀ (r q : ℕ)
        (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
        (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
        (α' : WeilGysinAbSupportClass Z' Y' i' (ℓ ^ r) q)
        (α : WeilGysinAbSupportClass Z Y i (ℓ ^ r) q),
        WeilGysinIsAbSupportComparison τ' α' →
        WeilGysinIsAbSupportComparison τ α →
        (WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ ↔
          WeilGysinAbSupportPullback g i' i (ℓ ^ r) q α' α) := by
    intro Z' Y' Z Y g i' i g_Z hi' hi hpb r q τ' τ α' α hcmp' hcmp
    refine ⟨hAb_pb_fwd g i' i g_Z hi' hi hpb r q τ' τ α' α hcmp' hcmp, fun hab_pb => ?_⟩
    obtain ⟨τ'_cand, hpb_cand⟩ := hPb_ex g i' i g_Z hi hpb r q τ
    obtain ⟨e_ab', he_ab'⟩ := hAb_equiv i' hi' r q τ'_cand α'
    let α'_cand : WeilGysinAbSupportClass Z' Y' i' (ℓ ^ r) q :=
      ⟨α'.hCont, e_ab' τ'_cand.val⟩
    have hcmp_cand : WeilGysinIsAbSupportComparison τ'_cand α'_cand :=
      (he_ab' τ'_cand α'_cand).mpr rfl
    have hab_cand : WeilGysinAbSupportPullback g i' i (ℓ ^ r) q α'_cand α :=
      hAb_pb_fwd g i' i g_Z hi' hi hpb r q τ'_cand τ α'_cand α hcmp_cand hcmp hpb_cand
    have hα_eq : α'_cand = α' :=
      hAb_pb_uniq g i' i hi' r q α α'_cand α' hab_cand hab_pb
    have hval_eq : e_ab' τ'_cand.val = e_ab' τ'.val := by
      have h₁ : e_ab' τ'_cand.val = α'.val := by
        cases α' with
        | mk hC v' =>
          have h_inj : ({ hCont := hC, val := e_ab' τ'_cand.val } :
              WeilGysinAbSupportClass Z' Y' i' (ℓ ^ r) q) = { hCont := hC, val := v' } := hα_eq
          exact eq_of_heq (Eq.ndrec
            (motive := fun x => HEq (e_ab' τ'_cand.val) x.val) HEq.rfl h_inj)
      have h₂ : e_ab' τ'.val = α'.val := (he_ab' τ' α').mp hcmp'
      exact h₁.trans h₂.symm
    have hτ_eq : τ'_cand = τ' := hSuppExt τ'_cand τ' (e_ab'.injective hval_eq)
    rwa [hτ_eq] at hpb_cand
  exact ⟨@τ_iso,
    ⟨fun {Z Y} i => hContAll i, hIso_pb, hIso_fg,
      fun {Z Y} i [CategoryTheory.IsIso i] _ => hIso_ab_all i⟩,
    ⟨hPb_ex, hPb_uniq, hPb_id, hPb_comp, hExc_ex⟩,
    ⟨hFg_ex, hFg_pb, hTorsPb_ex, hTorsPb_id, hTorsPb_comp⟩,
    ⟨hGys_ex, hGys_unitL, hGys_unitR, hGys_assoc, hGys_pb⟩,
    ⟨hAb_equiv, hAb_pb_iff, hAb_pb_trans, hAb_gys_trans, hAb_fg_trans⟩⟩

theorem weil_gysin_ab_open_shriek_adjunction_and_ext_iso (Y : AlgebraicGeometry.Scheme.{u}) (V : Y.Opens) :
    let M_V := weilGysinAbOpenMapSite V
    let B_V := weilEtaleSitePullback V.ι
    ∃ (hCont_M : M_V.IsContinuous V.toScheme.smallEtaleTopology Y.smallEtaleTopology)
      (hCont_B : B_V.IsContinuous Y.smallEtaleTopology V.toScheme.smallEtaleTopology),
      letI := hCont_M
      letI := hCont_B
      let j_star := M_V.sheafPushforwardContinuous AddCommGrpCat.{u}
        V.toScheme.smallEtaleTopology Y.smallEtaleTopology
      let j_push := B_V.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology V.toScheme.smallEtaleTopology
      ∃ (adj_star_push : CategoryTheory.Adjunction j_star j_push)
        (hAdd_star : j_star.Additive)
        (hLim_star : CategoryTheory.Limits.PreservesFiniteLimits j_star)
        (hColim_star : CategoryTheory.Limits.PreservesFiniteColimits j_star)
        (j_shriek : CategoryTheory.Functor
          (CategoryTheory.Sheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
        (adj_shriek_star : CategoryTheory.Adjunction j_shriek j_star),
        (∀ (I : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (j_star.obj I)) ∧
        (∀ (A : AddCommGrpCat.{u}),
          let C_V := CategoryTheory.constantSheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u}
          let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
          let hT_V := weilEtaleIdTerminalIsTerminal.{u} V.toScheme
          let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
          let adj_V := CategoryTheory.constantSheafAdj
            V.toScheme.smallEtaleTopology AddCommGrpCat.{u} hT_V
          let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
          let π_A := (adj_star_push.homEquiv (C_Y.obj A) (C_V.obj A)).symm
            ((adj_Y.homEquiv A (j_push.obj (C_V.obj A))).symm
              (CategoryTheory.CategoryStruct.comp (adj_V.unit.app A)
                ((C_V.obj A).obj.map
                  (Opposite.op (hT_V.from (B_V.obj (weilEtaleIdTerminal.{u} Y)))))))
          CategoryTheory.CategoryStruct.comp (weilGysinAbOpenConstHom V hCont_M A) π_A =
            CategoryTheory.CategoryStruct.id (C_V.obj A) ∧
          CategoryTheory.CategoryStruct.comp π_A (weilGysinAbOpenConstHom V hCont_M A) =
            CategoryTheory.CategoryStruct.id (j_star.obj (C_Y.obj A))) ∧
        (letI := hAdd_star
         letI := hLim_star
         letI := hColim_star
         ∀ (G : CategoryTheory.Sheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u})
           (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
           (q : ℕ),
           Function.Bijective
             (fun x : CategoryTheory.Abelian.Ext.{u} (j_shriek.obj G) F q =>
               (CategoryTheory.Abelian.Ext.mk₀ (adj_shriek_star.unit.app G)).comp
                 ((j_star.mapExtAddHom (j_shriek.obj G) F q) x)
                 (Nat.zero_add q))) :=
by
  have hCont_B : (weilEtaleSitePullback V.ι).IsContinuous
      Y.smallEtaleTopology V.toScheme.smallEtaleTopology := by
    let B_V := weilEtaleSitePullback V.ι
    let J_V := V.toScheme.smallEtaleTopology
    let J_Y := Y.smallEtaleTopology
    haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) V.ι :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) V.ι :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let hEt_V : AlgebraicGeometry.Etale V.ι := inferInstance
    let M'_V : CategoryTheory.Functor V.toScheme.Etale Y.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hEt_V
    let adj_M'B : CategoryTheory.Adjunction M'_V B_V :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj
        (@AlgebraicGeometry.Etale) ⊤ V.ι hEt_V trivial
    have hCompat_B : CategoryTheory.CompatiblePreserving J_V B_V := by
      apply CategoryTheory.CompatiblePreserving.mk
      intro Fsh Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      let tf₁ : Quiver.Hom (M'_V.obj X) Y₁ := (adj_M'B.homEquiv X Y₁).symm f₁
      let tf₂ : Quiver.Hom (M'_V.obj X) Y₂ := (adj_M'B.homEquiv X Y₂).symm f₂
      have hcomm_Y : CategoryTheory.CategoryStruct.comp tf₁ g₁ =
          CategoryTheory.CategoryStruct.comp tf₂ g₂ := by
        have h1 : (adj_M'B.homEquiv X Z).symm (CategoryTheory.CategoryStruct.comp f₁ (B_V.map g₁)) =
            CategoryTheory.CategoryStruct.comp tf₁ g₁ :=
          adj_M'B.homEquiv_naturality_right_symm f₁ g₁
        have h2 : (adj_M'B.homEquiv X Z).symm (CategoryTheory.CategoryStruct.comp f₂ (B_V.map g₂)) =
            CategoryTheory.CategoryStruct.comp tf₂ g₂ :=
          adj_M'B.homEquiv_naturality_right_symm f₂ g₂
        exact h1.symm.trans ((congrArg (adj_M'B.homEquiv X Z).symm hcomm).trans h2)
      have hf₁ : CategoryTheory.CategoryStruct.comp (adj_M'B.unit.app X) (B_V.map tf₁) = f₁ :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_M'B X Y₁ tf₁).symm.trans
          ((adj_M'B.homEquiv X Y₁).apply_symm_apply f₁)
      have hf₂ : CategoryTheory.CategoryStruct.comp (adj_M'B.unit.app X) (B_V.map tf₂) = f₂ :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_M'B X Y₂ tf₂).symm.trans
          ((adj_M'B.homEquiv X Y₂).apply_symm_apply f₂)
      have hx_eq := hx tf₁ tf₂ hg₁ hg₂ hcomm_Y
      have hmap₁ : Fsh.obj.map f₁.op =
          CategoryTheory.CategoryStruct.comp (Fsh.obj.map (B_V.map tf₁).op)
            (Fsh.obj.map (adj_M'B.unit.app X).op) := by
        rw [← hf₁, op_comp, Fsh.obj.map_comp]
      have hmap₂ : Fsh.obj.map f₂.op =
          CategoryTheory.CategoryStruct.comp (Fsh.obj.map (B_V.map tf₂).op)
            (Fsh.obj.map (adj_M'B.unit.app X).op) := by
        rw [← hf₂, op_comp, Fsh.obj.map_comp]
      rw [hmap₁, hmap₂]
      exact congrArg (Fsh.obj.map (adj_M'B.unit.app X).op) hx_eq
    have hCov_B : CategoryTheory.CoverPreserving J_Y J_V B_V := by
      refine ⟨fun {W R} hR => ?_⟩
      change R ∈ Y.smallGrothendieckTopology (@AlgebraicGeometry.Etale) W at hR
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y (Q := @AlgebraicGeometry.Etale) le_rfl] at hR
      change CategoryTheory.Sieve.functorPushforward B_V R ∈
        V.toScheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) (B_V.obj W)
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        V.toScheme (Q := @AlgebraicGeometry.Etale) le_rfl]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (B_V.obj W) _).mpr
        (fun z => ?_)
      obtain ⟨W₀, f, y, hfR, _, hfy⟩ :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) W R).mp hR
          ((CategoryTheory.Limits.pullback.fst W.hom V.ι).base z)
      have hEt_Bf : AlgebraicGeometry.Etale (B_V.map f).left := by
        haveI : AlgebraicGeometry.Etale (B_V.obj W₀).hom := (B_V.obj W₀).prop
        haveI : AlgebraicGeometry.Etale (B_V.obj W).hom := (B_V.obj W).prop
        have hw : CategoryTheory.CategoryStruct.comp (B_V.map f).left (B_V.obj W).hom =
            (B_V.obj W₀).hom :=
          CategoryTheory.MorphismProperty.Over.w (B_V.map f)
        haveI : AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp (B_V.map f).left (B_V.obj W).hom) := by
          rw [hw]; infer_instance
        exact CategoryTheory.MorphismProperty.of_postcomp
          (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
          (B_V.map f).left (B_V.obj W).hom inferInstance inferInstance
      have h_yv : W₀.hom.base y =
          V.ι.base ((CategoryTheory.Limits.pullback.snd W.hom V.ι).base z) :=
        (congrArg (fun k : Quiver.Hom W₀.left Y => k.base y)
          (CategoryTheory.MorphismProperty.Over.w f).symm).trans
          ((AlgebraicGeometry.Scheme.Hom.comp_apply f.left W.hom y).trans
            ((congrArg W.hom.base hfy).trans
              ((AlgebraicGeometry.Scheme.Hom.comp_apply
                (CategoryTheory.Limits.pullback.fst W.hom V.ι) W.hom z).symm.trans
                ((congrArg
                  (fun k : Quiver.Hom (CategoryTheory.Limits.pullback W.hom V.ι) Y => k.base z)
                  (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := V.ι))).trans
                  (AlgebraicGeometry.Scheme.Hom.comp_apply
