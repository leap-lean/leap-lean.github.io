          (CategoryTheory.Abelian.Ext.mk₀ βM₂) (Nat.add_zero q)))
      (Nat.zero_add q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (π_p AM)) (Nat.add_zero q)) = p (θ₂ γ) :=
    (congrArg (fun y => (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_p).comp
        (P_pull_p.mapExtAddHom (Cℤ₂.obj Aℤ) (Cℤ₂.obj AM) q y) (Nat.zero_add q)).comp
