    change _ = (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_p).comp
      (P_pull_p.mapExtAddHom Fℤ₂ FM₂ q y₂) (Nat.zero_add q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ πM_p) (Nat.add_zero q))
    rw [hU₁_x, hPullU₁_γ,
      h_sandwich q (U₁.map e_hom) (e_comm.hom.app one₂) E₀
        (e_comm.inv.app one₂) (U₁.map e_inv),
      h_sandwich q ηℤ₁ (U₁.map e_hom ≫ e_comm.hom.app one₂) E₀
        (e_comm.inv.app one₂ ≫ U₁.map e_inv) βM₁,
      hPp_y₂, hPab_y₂,
      h_sandwich q (η_p.inv.app Fℤ₂) (P_pull_ab.map ηℤ₂) E₀
