      let θ_w : ∀ k : ℕ, weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k := fun k =>
        ((Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero k)).comp
          (((Abelian.Ext.mk₀ (C_ab.map z_to_m ≫ αM)).precomp (U.obj One_mod) (Nat.zero_add k)).comp
