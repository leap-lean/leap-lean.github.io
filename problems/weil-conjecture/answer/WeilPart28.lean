            m_αk T_std ≫ (C.obj A).obj.map ((G_k k).map (μ_k 1)).op :=
          (α_k k A).hom.naturality (μ_k 1).op
        have hm_T : uA ≫ m_αk T_std = uA ≫ (C.obj A).obj.map (μ_k k).op :=
          (adj.homEquiv_unit A ((P_k k).obj (C.obj A)) (α_k k A)).symm.trans
            ((adj.homEquiv A ((P_k k).obj (C.obj A))).apply_symm_apply _)
        have h_lhs : adj.homEquiv A ((P_k (k + 1)).obj (C.obj A)) (α_k (k + 1) A) =
            uA ≫ (C.obj A).obj.map (μ_k (k + 1)).op :=
          (adj.homEquiv A ((P_k (k + 1)).obj (C.obj A))).apply_symm_apply _
        have h_rhs : adj.homEquiv A ((P_k (k + 1)).obj (C.obj A))
            (α_k 1 A ≫ (P_k 1).map (α_k k A) ≫ η_Pstep.hom.app (C.obj A)) =
            (uA ≫ (C.obj A).obj.map (μ_k 1).op) ≫
              (m_αk ((G_k 1).obj T_std) ≫ (C.obj A).obj.map (e_Gstep.inv.app T_std).op) := by
          rw [adj.homEquiv_naturality_right, CategoryTheory.Functor.map_comp,
              (adj.homEquiv A ((P_k 1).obj (C.obj A))).apply_symm_apply]
          rfl
