    let s_amal : P_type.obj (Opposite.op U) := fun γ => (x (f_c γ) (hf_c γ) : _ → ↑A) (δ_c γ)
    refine ⟨s_amal, ?_, ?_⟩
    · intro V f hf
      funext δ
      exact hAgree (f_c (GeomLiftMap ξ f δ)) (hf_c _) (δ_c _) f hf δ (hδ_c _)
    · intro s' hs'
      funext γ
      have h_ev := congrFun (congrArg (fun k : GeomLifts ξ (V_c γ) → ↑A => k)
        (hs' (f_c γ) (hf_c γ))) (δ_c γ)
      change s' (GeomLiftMap ξ (f_c γ) (δ_c γ)) = s_amal γ at h_ev
      exact (congrArg s' (hδ_c γ).symm).trans h_ev
  let Sky : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      (_ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
      AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun {S Ω} _ _ ξ =>
      { obj := fun A => ⟨SkyPre ξ A, hSkyIsSheaf ξ A⟩
        map := fun {A₁ A₂} φ =>
          { hom :=
              { app := fun _ => AddCommGrpCat.ofHom
                  { toFun := fun s γ => φ.hom (s γ)
