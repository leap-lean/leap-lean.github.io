    exact weil_lefschetz_konig_padic_span ℓ X.left Y_W.left p₁ p₂ (2 * d)
      H_X H_P fp₁ fp₂ hfp₁ hfp₂ cup_P hcup_P
      (fun h r m p_s p_c hs hc x => hPullTrans h r m p_s p_c hs hc x)
      (fun r a b_deg c hab cs cc hs hc x y => hCupTrans Y_W.left r a b_deg c hab cs cc hs hc x y)
      b v_sys (e * ((2 * d) * (2 * d) + 2 * d + 2))
      (fun r p₁_r p₂_r cup_r hp₁_r hp₂_r hcup_r z_r =>
