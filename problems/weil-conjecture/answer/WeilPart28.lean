        ((adj_ab.homEquiv (Cℤ₂.obj A) (Cℤ₁.obj A)) (π_ab A) ≫ P_push_ab.map α₁) =
        (adjℤ₁.unit.app A ≫ (Cℤ₁.obj A).obj.map (Opposite.op τ₀)) ≫
          α₁.hom.app (Opposite.op (B.obj T₂)) := by
      have hn := adjℤ₂.homEquiv_naturality_right
        ((adj_ab.homEquiv (Cℤ₂.obj A) (Cℤ₁.obj A)) (π_ab A)) (P_push_ab.map α₁)
      have hπ : (adjℤ₂.homEquiv A (P_push_ab.obj (Cℤ₁.obj A)))
          ((adj_ab.homEquiv (Cℤ₂.obj A) (Cℤ₁.obj A)) (π_ab A)) =
          adjℤ₁.unit.app A ≫ (Cℤ₁.obj A).obj.map (Opposite.op τ₀) := by
        dsimp [π_ab]
        rw [(adj_ab.homEquiv _ _).apply_symm_apply, (adjℤ₂.homEquiv _ _).apply_symm_apply]
        rfl
      exact hn.trans (congrArg (· ≫ α₁.hom.app (Opposite.op (B.obj T₂))) hπ)
    have hLHS₃ : (adjℤ₁.unit.app A ≫ (Cℤ₁.obj A).obj.map (Opposite.op τ₀)) ≫
        α₁.hom.app (Opposite.op (B.obj T₂)) =
        (κ ≫ FgtMod.map (adjR₁.unit.app R_mod)) ≫
          FgtMod.map (one₁.obj.map (Opposite.op τ₀)) := by
      have hnat : (Cℤ₁.obj A).obj.map (Opposite.op τ₀) ≫ α₁.hom.app (Opposite.op (B.obj T₂)) =
          α₁.hom.app (Opposite.op T₁) ≫ (U₁.obj one₁).obj.map (Opposite.op τ₀) :=
        α₁.hom.naturality (Opposite.op τ₀)
      have hunit : adjℤ₁.unit.app A ≫ α₁.hom.app (Opposite.op T₁) =
          κ ≫ FgtMod.map (adjR₁.unit.app R_mod) :=
        (CategoryTheory.Adjunction.homEquiv_unit adjℤ₁ A (U₁.obj one₁) α₁).trans
          ((adjℤ₁.homEquiv A (U₁.obj one₁)).apply_symm_apply _)
      exact (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (adjℤ₁.unit.app A ≫ ·) hnat).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ (U₁.obj one₁).obj.map (Opposite.op τ₀)) hunit)))
    have hRHS₁ : (adj_ab.homEquiv (Cℤ₂.obj A) (U₁.obj one₁))
        (P_pull_ab.map α₂ ≫ (e_comm.inv.app one₂ ≫ U₁.map e_unit.inv)) =
        α₂ ≫ U₂.map ((adj.homEquiv one₂ one₁) e_unit.inv) := by
      rw [adj_ab.homEquiv_naturality_left α₂ (e_comm.inv.app one₂ ≫ U₁.map e_unit.inv),
        ← hCompat one₂ one₁ e_unit.inv]
      rfl
    have hRHS₂ : (adjℤ₂.homEquiv A (P_push_ab.obj (U₁.obj one₁)))
        (α₂ ≫ U₂.map ((adj.homEquiv one₂ one₁) e_unit.inv)) =
        (κ ≫ FgtMod.map (adjR₂.unit.app R_mod)) ≫
          FgtMod.map (((adj.homEquiv one₂ one₁) e_unit.inv).hom.app (Opposite.op T₂)) := by
      have hn := adjℤ₂.homEquiv_naturality_right α₂
        (U₂.map ((adj.homEquiv one₂ one₁) e_unit.inv))
      have hα₂ : (adjℤ₂.homEquiv A (U₂.obj one₂)) α₂ =
          κ ≫ FgtMod.map (adjR₂.unit.app R_mod) :=
        (adjℤ₂.homEquiv A (U₂.obj one₂)).apply_symm_apply _
      exact hn.trans (congrArg (· ≫ FgtMod.map
        (((adj.homEquiv one₂ one₁) e_unit.inv).hom.app (Opposite.op T₂))) hα₂)
    have hRHS₃ : adjR₂.unit.app R_mod ≫
        ((adj.homEquiv one₂ one₁) e_unit.inv).hom.app (Opposite.op T₂) =
        adjR₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op τ₀) := by
      have hu : adjR₂.unit.app R_mod ≫
          ((adj.homEquiv one₂ one₁) e_unit.inv).hom.app (Opposite.op T₂) =
          (adjR₂.homEquiv R_mod (P_push.obj one₁)) ((adj.homEquiv one₂ one₁) π_R) :=
        (CategoryTheory.Adjunction.homEquiv_unit adjR₂ R_mod (P_push.obj one₁)
          ((adj.homEquiv one₂ one₁) π_R)).symm
      have hπ : (adjR₂.homEquiv R_mod (P_push.obj one₁)) ((adj.homEquiv one₂ one₁) π_R) =
