        (P_pull_ab.map βM₂ ≫ η_p.hom.app FM₂) πM_p,
      ← CategoryTheory.Category.assoc ηℤ₁, hLeft,
      CategoryTheory.Category.assoc ιℤ_p,
      CategoryTheory.Category.assoc (e_comm.inv.app one₂), hRight,
      CategoryTheory.Category.assoc (P_pull_ab.map βM₂)]

  
  
  
  have h_const_term_inv : ∀ {S₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} S₀]
      (J₀ : CategoryTheory.GrothendieckTopology S₀)
      {A₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} A₀]
      [CategoryTheory.HasWeakSheafify J₀ A₀]
      {Ta Tb : S₀} (hTa : CategoryTheory.Limits.IsTerminal Ta)
      (hTb : CategoryTheory.Limits.IsTerminal Tb),
      let φ : Tb ⟶ Ta := hTa.from Tb
      let C := CategoryTheory.constantSheaf J₀ A₀
      let adjTa := CategoryTheory.constantSheafAdj J₀ A₀ hTa
      let adjTb := CategoryTheory.constantSheafAdj J₀ A₀ hTb
      (∀ M : A₀,
        CategoryTheory.CategoryStruct.comp (adjTa.unit.app M) ((C.obj M).obj.map (Opposite.op φ)) =
          adjTb.unit.app M) ∧
      (∀ (M : A₀) (𝒢 : CategoryTheory.Sheaf J₀ A₀) (f : Quiver.Hom (C.obj M) 𝒢),
        (adjTb.homEquiv M 𝒢) f =
          CategoryTheory.CategoryStruct.comp ((adjTa.homEquiv M 𝒢) f)
            (𝒢.obj.map (Opposite.op φ))) := by
    intro S₀ _ J₀ A₀ _ _ Ta Tb hTa hTb
    let φ : Tb ⟶ Ta := hTa.from Tb
    let C := CategoryTheory.constantSheaf J₀ A₀
    let adjTa := CategoryTheory.constantSheafAdj J₀ A₀ hTa
    let adjTb := CategoryTheory.constantSheafAdj J₀ A₀ hTb
    have hUnit : ∀ M : A₀,
        CategoryTheory.CategoryStruct.comp (adjTa.unit.app M) ((C.obj M).obj.map (Opposite.op φ)) =
          adjTb.unit.app M := by
      intro M
      let P_M := (CategoryTheory.Functor.const S₀ᵒᵖ).obj M
      have huT : (adjTa.unit.app M : M ⟶ (C.obj M).obj.obj (Opposite.op Ta)) =
          (CategoryTheory.toSheafify J₀ P_M).app (Opposite.op Ta) := by
        change ((CategoryTheory.constantPresheafAdj A₀ hTa).comp
          (CategoryTheory.sheafificationAdjunction J₀ A₀)).unit.app M = _
        rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
          CategoryTheory.Category.id_comp]
        rfl
      have huT' : (adjTb.unit.app M : M ⟶ (C.obj M).obj.obj (Opposite.op Tb)) =
          (CategoryTheory.toSheafify J₀ P_M).app (Opposite.op Tb) := by
        change ((CategoryTheory.constantPresheafAdj A₀ hTb).comp
          (CategoryTheory.sheafificationAdjunction J₀ A₀)).unit.app M = _
        rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
          CategoryTheory.Category.id_comp]
        rfl
      have hnat := (CategoryTheory.toSheafify J₀ P_M).naturality (Opposite.op φ)
      change CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id M)
          ((CategoryTheory.toSheafify J₀ P_M).app (Opposite.op Tb)) =
        CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.toSheafify J₀ P_M).app (Opposite.op Ta))
          ((C.obj M).obj.map (Opposite.op φ)) at hnat
      rw [CategoryTheory.Category.id_comp] at hnat
      exact (congrArg (fun k : M ⟶ (C.obj M).obj.obj (Opposite.op Ta) =>
        CategoryTheory.CategoryStruct.comp k ((C.obj M).obj.map (Opposite.op φ))) huT).trans
        (hnat.symm.trans huT'.symm)
    refine ⟨hUnit, fun M 𝒢 f => ?_⟩
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    change CategoryTheory.CategoryStruct.comp (adjTb.unit.app M) (f.hom.app (Opposite.op Tb)) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (adjTa.unit.app M) (f.hom.app (Opposite.op Ta)))
        (𝒢.obj.map (Opposite.op φ))
    rw [← hUnit M, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    congr 1
    exact f.hom.naturality (Opposite.op φ)

  
  
  
  obtain ⟨hCont, P_pull_ab, adj_ab, hAdd_ab, hLim_ab, hColim_ab, -⟩ := hAdjAb h
  letI := hCont
  letI := hAdd_ab
  letI := hLim_ab
  letI := hColim_ab

  let R := ULift.{u, 0} (ZMod m₀)
  let R_mod := ModuleCat.of R R
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let B := weilAltCdSitePullback h
  let J₁ := W₁.smallEtaleTopology
  let J₂ := W₂.smallEtaleTopology

  have hIntSurj : Function.Surjective (Int.cast : ℤ → R) := by
    intro r
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
    refine ⟨z, ULift.ext _ _ ?_⟩
    change (z : ZMod m₀) = r.down
    exact hz

  have hModTor : ∀ (M : ModuleCat.{u, u} R) (x : ↑M), m₀ • x = 0 := by
    intro M x
    have h_nsmul : ∀ n : ℕ, n • x = ((n : R)) • x := by
      intro n
      induction n with
      | zero => rw [zero_nsmul, Nat.cast_zero, zero_smul]
      | succ n ih =>
        rw [succ_nsmul, ih, Nat.cast_succ, add_smul, one_smul]
    rw [h_nsmul m₀]
    have hm0 : (m₀ : R) = 0 := by
      apply ULift.ext
      change (m₀ : ZMod m₀) = 0
      exact ZMod.natCast_self m₀
    rw [hm0, zero_smul]

  let liftModHom : ∀ (M N : ModuleCat.{u, u} R), (↑M →+ ↑N) → (M ⟶ N) :=
    fun M N g =>
      ModuleCat.ofHom
        { toAddHom := g.toAddHom
          map_smul' := fun r x => by
            obtain ⟨z, rfl⟩ := hIntSurj r
            dsimp only [RingHom.id_apply]
            rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
            exact map_zsmul g z x }

  have hom_ext_mod : ∀ {M N : ModuleCat.{u, u} R} (f₁ f₂ : M ⟶ N),
      (∀ x : ↑M, f₁.hom x = f₂.hom x) → f₁ = f₂ := by
    intro M N f₁ f₂ h_eq
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    exact h_eq

  let downHom : R →+* ZMod m₀ :=
    { toFun := ULift.down
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }

  let mkRMod : ∀ (A : Type u) [AddCommGroup A], (∀ a : A, m₀ • a = 0) → ModuleCat.{u, u} R :=
    fun A _ hA =>
      letI : Module (ZMod m₀) A := @AddCommGroup.zmodModule m₀ A _ hA
      letI : Module R A := Module.compHom A downHom
      ModuleCat.of R A

  let mSub : ∀ (A : AddCommGrpCat.{u}), AddSubgroup ↑A :=
    fun A =>
      { carrier := { b : ↑A | ∃ a : ↑A, m₀ • a = b }
        add_mem' := by
          rintro _ _ ⟨a₁, rfl⟩ ⟨a₂, rfl⟩
          exact ⟨a₁ + a₂, nsmul_add a₁ a₂ m₀⟩
        zero_mem' := ⟨0, nsmul_zero m₀⟩
        neg_mem' := by
          rintro _ ⟨a, rfl⟩
          exact ⟨-a, smul_neg m₀ a⟩ }

  let L_fg_obj : AddCommGrpCat.{u} → ModuleCat.{u, u} R :=
    fun A => mkRMod (↑A ⧸ mSub A) (fun q => by
      induction q using QuotientAddGroup.induction_on with
      | H a =>
        rw [← QuotientAddGroup.mk_nsmul]
        exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨a, rfl⟩)

  let L_fg : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
    { obj := L_fg_obj
      map := fun {A₁ A₂} φ =>
        liftModHom (L_fg_obj A₁) (L_fg_obj A₂)
          (QuotientAddGroup.lift (mSub A₁)
            ((QuotientAddGroup.mk' (mSub A₂)).comp φ.hom) (by
              rintro _ ⟨a, rfl⟩
              rw [AddMonoidHom.mem_ker, AddMonoidHom.comp_apply, map_nsmul,
                QuotientAddGroup.mk'_apply]
              exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨φ.hom a, rfl⟩))
      map_id := fun A => hom_ext_mod _ _ (fun q => by
        induction q using QuotientAddGroup.induction_on with
        | H a => rfl)
      map_comp := fun {A₁ A₂ A₃} φ ψ => hom_ext_mod _ _ (fun q => by
        induction q using QuotientAddGroup.induction_on with
        | H a => rfl) }

  let adjL : L_fg ⊣ FgtMod :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun A M =>
          { toFun := fun f =>
              AddCommGrpCat.ofHom (f.hom.toAddMonoidHom.comp (QuotientAddGroup.mk' (mSub A)))
            invFun := fun g =>
              liftModHom (L_fg_obj A) M
                (QuotientAddGroup.lift (mSub A) g.hom (by
                  rintro _ ⟨a, rfl⟩
                  rw [AddMonoidHom.mem_ker, map_nsmul]
                  exact hModTor M (g.hom a)))
            left_inv := fun f => hom_ext_mod _ _ (fun q => by
              induction q using QuotientAddGroup.induction_on with
              | H a => rfl)
            right_inv := fun g => by
              apply AddCommGrpCat.ext; intro a; rfl }
        homEquiv_naturality_left_symm := fun {A₁ A₂ M} φ g => hom_ext_mod _ _ (fun q => by
          induction q using QuotientAddGroup.induction_on with
          | H a => rfl)
        homEquiv_naturality_right := fun {A M₁ M₂} f ψ => by
          apply AddCommGrpCat.ext; intro a; rfl }

  let torSub : ∀ (A : AddCommGrpCat.{u}), AddSubgroup ↑A :=
    fun A =>
      { carrier := { a : ↑A | m₀ • a = 0 }
        add_mem' := fun {a₁ a₂} h₁ h₂ => by
          change m₀ • (a₁ + a₂) = 0
          rw [nsmul_add, h₁, h₂, add_zero]
        zero_mem' := nsmul_zero m₀
        neg_mem' := fun {a} ha => by
          change m₀ • (-a) = 0
          rw [smul_neg, ha, neg_zero] }

  let R_fg_obj : AddCommGrpCat.{u} → ModuleCat.{u, u} R :=
    fun A => mkRMod ↥(torSub A) (fun x => Subtype.ext x.2)

  let R_fg : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
    { obj := R_fg_obj
      map := fun {A₁ A₂} φ =>
        liftModHom (R_fg_obj A₁) (R_fg_obj A₂)
          { toFun := fun (x : ↥(torSub A₁)) => (⟨φ.hom x.1, by
              change m₀ • (φ.hom x.1) = 0
              rw [← map_nsmul, x.2, map_zero]⟩ : ↥(torSub A₂))
            map_zero' := Subtype.ext φ.hom.map_zero
            map_add' := fun x y => Subtype.ext (φ.hom.map_add x.1 y.1) }
      map_id := fun A => hom_ext_mod _ _ (fun _ => rfl)
      map_comp := fun {A₁ A₂ A₃} φ ψ => hom_ext_mod _ _ (fun _ => rfl) }

  let adjR : FgtMod ⊣ R_fg :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun M A =>
          { toFun := fun g =>
              liftModHom M (R_fg_obj A)
                { toFun := fun (x : ↑M) => (⟨g.hom x, by
                    let x' : ↑(FgtMod.obj M) := x
                    change m₀ • (g.hom x') = 0
                    rw [← map_nsmul, hModTor M x, map_zero]⟩ : ↥(torSub A))
                  map_zero' := Subtype.ext g.hom.map_zero
                  map_add' := fun x y => Subtype.ext (g.hom.map_add x y) }
            invFun := fun f =>
              AddCommGrpCat.ofHom ((torSub A).subtype.comp f.hom.toAddMonoidHom)
            left_inv := fun g => by
              apply AddCommGrpCat.ext; intro x; rfl
            right_inv := fun f => hom_ext_mod _ _ (fun _ => rfl) }
        homEquiv_naturality_left_symm := fun {M₁ M₂ A} φ f => by
          apply AddCommGrpCat.ext; intro x; rfl
        homEquiv_naturality_right := fun {M A₁ A₂} g ψ =>
          hom_ext_mod _ _ (fun _ => rfl) }

  have hHasSheafComposeOfAdj :
      ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
        (J₀ : CategoryTheory.GrothendieckTopology C₀)
        {D₁ D₂ : Type (u + 1)}
        [CategoryTheory.Category.{u, u + 1} D₁]
        [CategoryTheory.Category.{u, u + 1} D₂]
        {L₀ : CategoryTheory.Functor D₂ D₁}
        {F₀ : CategoryTheory.Functor D₁ D₂}
        (_ : L₀ ⊣ F₀),
        J₀.HasSheafCompose F₀ := by
    intro C₀ _ J₀ D₁ D₂ _ _ L₀ F₀ adj₀
    refine ⟨fun P hP X => ?_⟩
    let e_X : (P ⋙ F₀) ⋙ CategoryTheory.coyoneda.obj (Opposite.op X) ≅
        P ⋙ CategoryTheory.coyoneda.obj (Opposite.op (L₀.obj X)) :=
      CategoryTheory.NatIso.ofComponents
        (fun W => (adj₀.homEquiv X (P.obj W)).symm.toIso)
        (fun {W₁ W₂} u => by
          ext g
          exact adj₀.homEquiv_naturality_right_symm g (P.map u))
    exact CategoryTheory.Presieve.isSheaf_iso J₀ e_X.symm (hP (L₀.obj X))

  letI hSC₁ : J₁.HasSheafCompose FgtMod := hHasSheafComposeOfAdj J₁ adjL
  letI hSC₂ : J₂.HasSheafCompose FgtMod := hHasSheafComposeOfAdj J₂ adjL

  have hSheafComposeProps :
      ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
        (J₀ : CategoryTheory.GrothendieckTopology C₀)
        [CategoryTheory.HasWeakSheafify J₀ (ModuleCat.{u, u} R)]
        [hSC : J₀.HasSheafCompose FgtMod],
        let U₀ := CategoryTheory.sheafCompose J₀ FgtMod
        U₀.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits U₀ ∧
        CategoryTheory.Limits.PreservesFiniteColimits U₀ ∧
        Nonempty U₀.Full ∧
        U₀.Faithful := by
    intro C₀ _ J₀ _ hSC
    let U₀ := CategoryTheory.sheafCompose J₀ FgtMod
    letI hSC_R : J₀.HasSheafCompose R_fg := hHasSheafComposeOfAdj J₀ adjR
    let V₀ := CategoryTheory.sheafCompose J₀ R_fg
    let adj_U_R : U₀ ⊣ V₀ :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun ℳ 𝒜 =>
            { toFun := fun g =>
                CategoryTheory.ObjectProperty.homMk
                  { app := fun W =>
                      liftModHom (ℳ.obj.obj W) (R_fg_obj (𝒜.obj.obj W))
                        { toFun := fun (x : ↑(ℳ.obj.obj W)) =>
                            (⟨(g.hom.app W).hom x, by
                              let x' : ↑((U₀.obj ℳ).obj.obj W) := x
                              have hx0 : m₀ • x' = 0 := hModTor (ℳ.obj.obj W) x
                              change m₀ • ((g.hom.app W).hom x') = 0
                              rw [← map_nsmul, hx0, map_zero]⟩ :
                              ↥(torSub (𝒜.obj.obj W)))
                          map_zero' := Subtype.ext (g.hom.app W).hom.map_zero
                          map_add' := fun x y => Subtype.ext ((g.hom.app W).hom.map_add x y) }
                    naturality := fun {W₁ W₂} u => hom_ext_mod _ _ (fun x => by
                      apply Subtype.ext
                      exact congrArg (fun k => k.hom x) (g.hom.naturality u)) }
              invFun := fun f =>
                CategoryTheory.ObjectProperty.homMk
                  { app := fun W =>
                      AddCommGrpCat.ofHom ((torSub (𝒜.obj.obj W)).subtype.comp
                        (f.hom.app W).hom.toAddMonoidHom)
                    naturality := fun {W₁ W₂} u => by
                      apply AddCommGrpCat.ext; intro x
                      exact (congrArg (fun k => (k.hom x).1) (f.hom.naturality u) :
                        ((f.hom.app W₂).hom ((ℳ.obj.map u).hom x)).1 =
                          (𝒜.obj.map u).hom ((f.hom.app W₁).hom x).1) }
              left_inv := fun g => by
                apply CategoryTheory.Sheaf.hom_ext; ext W : 2
                apply AddCommGrpCat.ext; intro x; rfl
              right_inv := fun f => by
                apply CategoryTheory.Sheaf.hom_ext; ext W : 2
                exact hom_ext_mod _ _ (fun _ => rfl) }
          homEquiv_naturality_left_symm := fun {ℳ₁ ℳ₂ 𝒜} φ f => by
            apply CategoryTheory.Sheaf.hom_ext; ext W : 2
            apply AddCommGrpCat.ext; intro x; rfl
          homEquiv_naturality_right := fun {ℳ 𝒜₁ 𝒜₂} g ψ => by
            apply CategoryTheory.Sheaf.hom_ext; ext W : 2
            exact hom_ext_mod _ _ (fun _ => rfl) }
    let L_pre := (CategoryTheory.Functor.whiskeringRight C₀ᵒᵖ AddCommGrpCat.{u} (ModuleCat.{u, u} R)).obj L_fg
    let F_pre := (CategoryTheory.Functor.whiskeringRight C₀ᵒᵖ (ModuleCat.{u, u} R) AddCommGrpCat.{u}).obj FgtMod
    let adj_pre : L_pre ⊣ F_pre := adjL.whiskerRight C₀ᵒᵖ
    let W_left := CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u} ⋙
      L_pre ⋙ CategoryTheory.presheafToSheaf J₀ (ModuleCat.{u, u} R)
    let adj_sh := CategoryTheory.sheafificationAdjunction J₀ (ModuleCat.{u, u} R)
    let adj_L_U : W_left ⊣ U₀ :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun 𝒜 ℳ =>
            ((adj_sh.homEquiv (L_pre.obj 𝒜.obj) ℳ).trans
              (adj_pre.homEquiv 𝒜.obj ℳ.obj)).trans
              { toFun := fun g => CategoryTheory.ObjectProperty.homMk g
                invFun := fun g => g.hom
                left_inv := fun _ => rfl
                right_inv := fun _ => rfl }
          homEquiv_naturality_left_symm := fun {𝒜₁ 𝒜₂ ℳ} φ g => by
            dsimp [W_left]
            rw [← adj_sh.homEquiv_naturality_left_symm (L_pre.map φ.hom)]
            congr 1
            exact adj_pre.homEquiv_naturality_left_symm φ.hom g.hom
          homEquiv_naturality_right := fun {𝒜 ℳ₁ ℳ₂} f ψ => by
            apply CategoryTheory.Sheaf.hom_ext
            change (adj_pre.homEquiv 𝒜.obj ℳ₂.obj)
              ((adj_sh.homEquiv (L_pre.obj 𝒜.obj) ℳ₂) (f ≫ ψ)) =
              (adj_pre.homEquiv 𝒜.obj ℳ₁.obj) ((adj_sh.homEquiv (L_pre.obj 𝒜.obj) ℳ₁) f) ≫
                F_pre.map ψ.hom
            rw [adj_sh.homEquiv_naturality_right, adj_pre.homEquiv_naturality_right]
            rfl }
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits U₀ :=
      (adj_L_U.rightAdjoint_preservesLimits.{0, 0}).preservesFiniteLimits
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits U₀ :=
      (adj_U_R.leftAdjoint_preservesColimits.{0, 0}).preservesFiniteColimits
    have hAdd : U₀.Additive :=
      { map_add := fun {ℳ₁ ℳ₂} {f g} => by
          apply CategoryTheory.Sheaf.hom_ext; ext W : 2
          apply AddCommGrpCat.ext; intro x; rfl }
    have hFaithful : U₀.Faithful :=
      { map_injective := fun {ℳ₁ ℳ₂} {f₁ f₂} h_eq => by
          apply CategoryTheory.Sheaf.hom_ext; ext W : 2
          exact hom_ext_mod _ _ (fun x => congrArg (fun k => (k.hom.app W).hom x) h_eq) }
    have hFull : U₀.Full :=
      { map_surjective := fun {ℳ₁ ℳ₂} g =>
          ⟨CategoryTheory.ObjectProperty.homMk
            { app := fun W => liftModHom (ℳ₁.obj.obj W) (ℳ₂.obj.obj W) (g.hom.app W).hom
              naturality := fun {W₁ W₂} u =>
                hom_ext_mod _ _ (fun x => congrArg (fun k => k.hom x) (g.hom.naturality u)) },
           by
             apply CategoryTheory.Sheaf.hom_ext; ext W : 2
             apply AddCommGrpCat.ext; intro x; rfl⟩ }
    exact ⟨hAdd, hLim, hColim, ⟨hFull⟩, hFaithful⟩

  obtain ⟨hAdd_U₁, hLim_U₁, hColim_U₁, ⟨hFull_U₁⟩, hFaith_U₁⟩ := hSheafComposeProps J₁
  obtain ⟨hAdd_U₂, hLim_U₂, hColim_U₂, ⟨hFull_U₂⟩, hFaith_U₂⟩ := hSheafComposeProps J₂
  let U₁ := CategoryTheory.sheafCompose J₁ FgtMod
  let U₂ := CategoryTheory.sheafCompose J₂ FgtMod
  letI := hAdd_U₁; letI := hLim_U₁; letI := hColim_U₁; letI := hFull_U₁; letI := hFaith_U₁
  letI := hAdd_U₂; letI := hLim_U₂; letI := hColim_U₂; letI := hFull_U₂; letI := hFaith_U₂

  have h_nsmul_ab : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      {J₀ : CategoryTheory.GrothendieckTopology C₀}
      (ℬ : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u}) (n : ℕ) (W : C₀ᵒᵖ) (x : ↑(ℬ.obj.obj W)),
      ((n • CategoryTheory.CategoryStruct.id ℬ).hom.app W).hom x = n • x := by
    intro C₀ _ J₀ ℬ n W x
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ n ih => rw [succ_nsmul, succ_nsmul]; exact congrArg (· + x) ih

  have hU₂_tor : ∀ (ℳ : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R)),
      m₀ • CategoryTheory.CategoryStruct.id (U₂.obj ℳ) = 0 := by
    intro ℳ
    apply CategoryTheory.Sheaf.hom_ext; ext W : 2
    apply AddCommGrpCat.ext; intro x
    rw [h_nsmul_ab]
    exact hModTor (ℳ.obj.obj W) x

  have hPull_tor : ∀ (ℳ : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R)),
      m₀ • CategoryTheory.CategoryStruct.id (P_pull_ab.obj (U₂.obj ℳ)) = 0 := by
    intro ℳ
    rw [← P_pull_ab.map_id, ← Functor.map_nsmul, hU₂_tor ℳ, P_pull_ab.map_zero]

  have hLiftSheaf₁ : ∀ (ℬ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
      m₀ • CategoryTheory.CategoryStruct.id ℬ = 0 →
      ∃ (ℳ₁ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R)), Nonempty (U₁.obj ℳ₁ ≅ ℬ) := by
    intro ℬ hℬ
    have hℬ_sec : ∀ (W : (W₁.Etale)ᵒᵖ) (x : ↑(ℬ.obj.obj W)), m₀ • x = 0 := by
      intro W x
      rw [← h_nsmul_ab ℬ m₀ W x, hℬ]
      rfl
    let P_mod : CategoryTheory.Functor (W₁.Etale)ᵒᵖ (ModuleCat.{u, u} R) :=
      { obj := fun W => mkRMod ↑(ℬ.obj.obj W) (hℬ_sec W)
        map := fun {V₁ V₂} u =>
          liftModHom (mkRMod ↑(ℬ.obj.obj V₁) (hℬ_sec V₁))
            (mkRMod ↑(ℬ.obj.obj V₂) (hℬ_sec V₂)) (ℬ.obj.map u).hom
        map_id := fun W =>
          hom_ext_mod _ _ (fun x => congrArg (fun k => k.hom x) (ℬ.obj.map_id W))
        map_comp := fun {V₁ V₂ V₃} u v =>
          hom_ext_mod _ _ (fun x => congrArg (fun k => k.hom x) (ℬ.obj.map_comp u v)) }
    have hIsSheaf : CategoryTheory.Presheaf.IsSheaf J₁ P_mod := by
      intro X
      let e_X : P_mod ⋙ CategoryTheory.coyoneda.obj (Opposite.op X) ≅
          ℬ.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op (FgtMod.obj X)) :=
        CategoryTheory.NatIso.ofComponents
          (fun W =>
            { hom := TypeCat.ofHom (fun (f : X ⟶ P_mod.obj W) =>
                (AddCommGrpCat.ofHom f.hom.toAddMonoidHom : FgtMod.obj X ⟶ ℬ.obj.obj W))
              inv := TypeCat.ofHom (fun (g : FgtMod.obj X ⟶ ℬ.obj.obj W) =>
                liftModHom X (P_mod.obj W) g.hom)
              hom_inv_id := by
                ext f; exact hom_ext_mod _ _ (fun _ => rfl)
              inv_hom_id := by
                ext g; apply AddCommGrpCat.ext; intro x; rfl })
          (fun {V₁ V₂} u => by
            ext f; apply AddCommGrpCat.ext; intro x; rfl)
      exact CategoryTheory.Presieve.isSheaf_iso J₁ e_X.symm (ℬ.property (FgtMod.obj X))
    let ℳ₁ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R) := ⟨P_mod, hIsSheaf⟩
    let iso_ℬ : U₁.obj ℳ₁ ≅ ℬ :=
      { hom := CategoryTheory.ObjectProperty.homMk
          { app := fun W => AddCommGrpCat.ofHom (AddMonoidHom.id ↑(ℬ.obj.obj W))
            naturality := fun {V₁ V₂} u => by apply AddCommGrpCat.ext; intro x; rfl }
        inv := CategoryTheory.ObjectProperty.homMk
          { app := fun W => AddCommGrpCat.ofHom (AddMonoidHom.id ↑(ℬ.obj.obj W))
            naturality := fun {V₁ V₂} u => by apply AddCommGrpCat.ext; intro x; rfl }
        hom_inv_id := by
          apply CategoryTheory.Sheaf.hom_ext; ext W : 2
          apply AddCommGrpCat.ext; intro x; rfl
        inv_hom_id := by
          apply CategoryTheory.Sheaf.hom_ext; ext W : 2
          apply AddCommGrpCat.ext; intro x; rfl }
    exact ⟨ℳ₁, ⟨iso_ℬ⟩⟩

  let P_pull_obj : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R) →
      CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R) :=
    fun ℳ => (hLiftSheaf₁ (P_pull_ab.obj (U₂.obj ℳ)) (hPull_tor ℳ)).choose

  let e_pull_obj : ∀ ℳ, U₁.obj (P_pull_obj ℳ) ≅ P_pull_ab.obj (U₂.obj ℳ) :=
    fun ℳ => Classical.choice (hLiftSheaf₁ (P_pull_ab.obj (U₂.obj ℳ)) (hPull_tor ℳ)).choose_spec

  let P_pull : CategoryTheory.Functor
      (CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R)) :=
    { obj := P_pull_obj
      map := fun {ℳ₁ ℳ₂} f =>
        U₁.preimage ((e_pull_obj ℳ₁).hom ≫ P_pull_ab.map (U₂.map f) ≫ (e_pull_obj ℳ₂).inv)
      map_id := fun ℳ => U₁.map_injective (by
        rw [U₁.map_preimage, U₁.map_id, U₂.map_id, P_pull_ab.map_id,
          CategoryTheory.Category.id_comp, (e_pull_obj ℳ).hom_inv_id])
      map_comp := fun {ℳ₁ ℳ₂ ℳ₃} f g => U₁.map_injective (by
        rw [U₁.map_preimage, U₁.map_comp, U₁.map_preimage, U₁.map_preimage,
          U₂.map_comp, P_pull_ab.map_comp]
        simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id_assoc]) }

  let e_comm : P_pull.comp U₁ ≅ U₂.comp P_pull_ab :=
    CategoryTheory.NatIso.ofComponents e_pull_obj
      (fun {ℳ₁ ℳ₂} f => by
        dsimp [P_pull]
        rw [U₁.map_preimage]
        simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id,
          CategoryTheory.Category.comp_id])

  let P_push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₂ J₁
  let P_push_ab := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let toPushU₂ : ∀ {ℳ ℱ}, (U₂.obj ℳ ⟶ P_push_ab.obj (U₁.obj ℱ)) →
      (U₂.obj ℳ ⟶ U₂.obj (P_push.obj ℱ)) := fun f => f
  let fromPushU₂ : ∀ {ℳ ℱ}, (U₂.obj ℳ ⟶ U₂.obj (P_push.obj ℱ)) →
      (U₂.obj ℳ ⟶ P_push_ab.obj (U₁.obj ℱ)) := fun f => f

  let core : CategoryTheory.Adjunction.CoreHomEquiv P_pull P_push :=
    { homEquiv := fun ℳ ℱ =>
        { toFun := fun φ =>
            U₂.preimage (toPushU₂ ((adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ))
              (e_comm.inv.app ℳ ≫ U₁.map φ)))
          invFun := fun ψ =>
            U₁.preimage (e_comm.hom.app ℳ ≫
              (adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ)).symm (fromPushU₂ (U₂.map ψ)))
          left_inv := fun φ => U₁.map_injective (by
            dsimp only
            rw [U₁.map_preimage, U₂.map_preimage]
            change e_comm.hom.app ℳ ≫
              (adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ)).symm
                ((adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ)) (e_comm.inv.app ℳ ≫ U₁.map φ)) =
              U₁.map φ
            rw [(adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ)).symm_apply_apply,
              ← CategoryTheory.Category.assoc, e_comm.hom_inv_id_app,
              CategoryTheory.Category.id_comp])
          right_inv := fun ψ => U₂.map_injective (by
            dsimp only
            rw [U₂.map_preimage, U₁.map_preimage]
            have hid : e_comm.inv.app ℳ ≫ e_comm.hom.app ℳ = 𝟙 (P_pull_ab.obj (U₂.obj ℳ)) :=
              e_comm.inv_hom_id_app ℳ
            change toPushU₂ ((adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ))
              (e_comm.inv.app ℳ ≫ (e_comm.hom.app ℳ ≫
                (adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ)).symm (fromPushU₂ (U₂.map ψ))))) =
              U₂.map ψ
            rw [← CategoryTheory.Category.assoc, hid,
              CategoryTheory.Category.id_comp,
              (adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ)).apply_symm_apply]) }
      homEquiv_naturality_left_symm := fun {ℳ₁ ℳ₂ ℱ} f ψ => U₁.map_injective (by
        let α₁ := e_comm.hom.app ℳ₁ ≫
          (adj_ab.homEquiv (U₂.obj ℳ₁) (U₁.obj ℱ)).symm (fromPushU₂ (U₂.map (f ≫ ψ)))
        let α₂ := e_comm.hom.app ℳ₂ ≫
          (adj_ab.homEquiv (U₂.obj ℳ₂) (U₁.obj ℱ)).symm (fromPushU₂ (U₂.map ψ))
        change U₁.map (U₁.preimage α₁) = U₁.map (P_pull.map f ≫ U₁.preimage α₂)
        have hmap : fromPushU₂ (U₂.map (f ≫ ψ)) = U₂.map f ≫ fromPushU₂ (U₂.map ψ) :=
          U₂.map_comp f ψ
        have hnat : U₁.map (P_pull.map f) ≫ e_comm.hom.app ℳ₂ =
            e_comm.hom.app ℳ₁ ≫ P_pull_ab.map (U₂.map f) := e_comm.hom.naturality f
        calc
          U₁.map (U₁.preimage α₁)
            = α₁ := U₁.map_preimage α₁
          _ = e_comm.hom.app ℳ₁ ≫ P_pull_ab.map (U₂.map f) ≫
                (adj_ab.homEquiv (U₂.obj ℳ₂) (U₁.obj ℱ)).symm (fromPushU₂ (U₂.map ψ)) := by
              dsimp [α₁]
              rw [hmap, adj_ab.homEquiv_naturality_left_symm]
          _ = (e_comm.hom.app ℳ₁ ≫ P_pull_ab.map (U₂.map f)) ≫
                (adj_ab.homEquiv (U₂.obj ℳ₂) (U₁.obj ℱ)).symm (fromPushU₂ (U₂.map ψ)) :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = (U₁.map (P_pull.map f) ≫ e_comm.hom.app ℳ₂) ≫
                (adj_ab.homEquiv (U₂.obj ℳ₂) (U₁.obj ℱ)).symm (fromPushU₂ (U₂.map ψ)) := by
              rw [← hnat]
          _ = U₁.map (P_pull.map f) ≫ α₂ := CategoryTheory.Category.assoc _ _ _
          _ = U₁.map (P_pull.map f) ≫ U₁.map (U₁.preimage α₂) :=
              congrArg (U₁.map (P_pull.map f) ≫ ·) (U₁.map_preimage α₂).symm
          _ = U₁.map (P_pull.map f ≫ U₁.preimage α₂) := (U₁.map_comp _ _).symm)
      homEquiv_naturality_right := fun {ℳ ℱ₁ ℱ₂} φ g => U₂.map_injective (by
        change U₂.map (U₂.preimage (toPushU₂ ((adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ₂))
            (e_comm.inv.app ℳ ≫ U₁.map (φ ≫ g))))) =
          U₂.map (U₂.preimage (toPushU₂ ((adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ₁))
            (e_comm.inv.app ℳ ≫ U₁.map φ))) ≫ P_push.map g)
        rw [U₂.map_preimage, U₂.map_comp, U₂.map_preimage, U₁.map_comp,
          ← CategoryTheory.Category.assoc, adj_ab.homEquiv_naturality_right]
        <;> rfl) }

  let adj : P_pull ⊣ P_push := CategoryTheory.Adjunction.mkOfHomEquiv core

  have hAdd : P_pull.Additive :=
    { map_add := fun {ℳ₁ ℳ₂} {f g} => U₁.map_injective (by
        rw [U₁.map_add]
        dsimp [P_pull]
        rw [U₁.map_preimage, U₁.map_preimage, U₁.map_preimage,
          Functor.map_add, Functor.map_add, Preadditive.add_comp, Preadditive.comp_add]) }

  have hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull :=
    (adj.leftAdjoint_preservesColimits.{0, 0}).preservesFiniteColimits

  have hLim_comp : CategoryTheory.Limits.PreservesFiniteLimits (U₂.comp P_pull_ab) :=
    CategoryTheory.Limits.comp_preservesFiniteLimits U₂ P_pull_ab
  have hLim_pull_U₁ : CategoryTheory.Limits.PreservesFiniteLimits (P_pull.comp U₁) :=
    CategoryTheory.Limits.preservesFiniteLimits_of_natIso e_comm.symm
  have hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull :=
    CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves P_pull U₁

  letI := hAdd
  letI := hLim
  letI := hColim

  have hInj_push : ∀ (I : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R)),
      CategoryTheory.Injective I → CategoryTheory.Injective (P_push.obj I) :=
    fun I hI => adj.map_injective I hI

  have hCompat : ∀ (ℳ : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R))
      (ℱ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R))
      (φ : Quiver.Hom (P_pull.obj ℳ) ℱ),
      U₂.map ((adj.homEquiv ℳ ℱ) φ) =
        (adj_ab.homEquiv (U₂.obj ℳ) (U₁.obj ℱ))
          (CategoryTheory.CategoryStruct.comp (e_comm.inv.app ℳ) (U₁.map φ)) := by
    intro ℳ ℱ φ
    have hmk : (adj.homEquiv ℳ ℱ) φ = (core.homEquiv ℳ ℱ) φ :=
      congrArg (fun e => e φ)
        (congrFun (congrFun (CategoryTheory.Adjunction.mkOfHomEquiv_homEquiv core) ℳ) ℱ)
    rw [hmk]
    exact U₂.map_preimage _

  
  
  
  let T₁ := weilEtaleIdTerminal.{u} W₁
  let hT₁ := weilEtaleIdTerminalIsTerminal.{u} W₁
  let T₂ := weilEtaleIdTerminal.{u} W₂
  let hT₂ := weilEtaleIdTerminalIsTerminal.{u} W₂

  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget W₁
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget W₂
  have hLimOverPb : CategoryTheory.Limits.PreservesFiniteLimits (CategoryTheory.Over.pullback h) :=
    ((CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits.{0, 0}).preservesFiniteLimits
  have hLimCompB : CategoryTheory.Limits.PreservesFiniteLimits
      (Fgt₂.comp (CategoryTheory.Over.pullback h)) :=
    @CategoryTheory.Limits.comp_preservesFiniteLimits _ _ _ _ _ _ Fgt₂
      (CategoryTheory.Over.pullback h) inferInstance hLimOverPb
  have hEqCompB : B.comp Fgt₁ = Fgt₂.comp (CategoryTheory.Over.pullback h) := rfl
  have hLimCompB' : CategoryTheory.Limits.PreservesFiniteLimits (B.comp Fgt₁) := by
    rw [hEqCompB]; exact hLimCompB
  have hLimB : CategoryTheory.Limits.PreservesFiniteLimits B :=
    @CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
      B Fgt₁ hLimCompB' inferInstance
  let hT₁_B : CategoryTheory.Limits.IsTerminal (B.obj T₂) :=
    CategoryTheory.Limits.IsTerminal.isTerminalObj B T₂ hT₂
  let τ₀ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
  let σ₀ : T₁ ⟶ B.obj T₂ := hT₁_B.from T₁
  have hστ : σ₀ ≫ τ₀ = 𝟙 T₁ := hT₁.hom_ext _ _
  have hτσ : τ₀ ≫ σ₀ = 𝟙 (B.obj T₂) := hT₁_B.hom_ext _ _

  let one₁ := weilEtaleModuleUnit W₁ m₀
  let one₂ := weilEtaleModuleUnit W₂ m₀
  let adjR₁ := CategoryTheory.constantSheafAdj J₁ (ModuleCat.{u, u} R) hT₁
  let adjR₂ := CategoryTheory.constantSheafAdj J₂ (ModuleCat.{u, u} R) hT₂
  let π_R : P_pull.obj one₂ ⟶ one₁ :=
    (adj.homEquiv one₂ one₁).symm
      ((adjR₂.homEquiv R_mod (P_push.obj one₁)).symm
        (adjR₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op τ₀)))

  have hMateT₂ : ∀ (ℱ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R))
      (g : one₁ ⟶ ℱ),
      (adjR₂.homEquiv R_mod (P_push.obj ℱ)) ((adj.homEquiv one₂ ℱ) (π_R ≫ g)) =
        adjR₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op τ₀) ≫
          g.hom.app (Opposite.op (B.obj T₂)) := by
    intro ℱ g
    have h1 := adj.homEquiv_naturality_right π_R g
    have h2 := adjR₂.homEquiv_naturality_right ((adj.homEquiv one₂ one₁) π_R) (P_push.map g)
    have hπ : (adjR₂.homEquiv R_mod (P_push.obj one₁)) ((adj.homEquiv one₂ one₁) π_R) =
        adjR₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op τ₀) := by
      dsimp [π_R]
      rw [(adj.homEquiv one₂ one₁).apply_symm_apply,
        (adjR₂.homEquiv R_mod (P_push.obj one₁)).apply_symm_apply]
      rfl
    exact (congrArg (adjR₂.homEquiv R_mod (P_push.obj ℱ)) h1).trans
      (h2.trans ((congrArg (· ≫ g.hom.app (Opposite.op (B.obj T₂))) hπ).trans
        (CategoryTheory.Category.assoc _ _ _)))

  have hMateEquiv : ∀ (ℱ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R))
      (g : one₁ ⟶ ℱ),
      (adjR₂.homEquiv R_mod (P_push.obj ℱ)) ((adj.homEquiv one₂ ℱ) (π_R ≫ g)) =
        ((adjR₁.homEquiv R_mod ℱ) g) ≫ ℱ.obj.map (Opposite.op τ₀) := by
    intro ℱ g
    have h1 := hMateT₂ ℱ g
    have hnat : one₁.obj.map (Opposite.op τ₀) ≫ g.hom.app (Opposite.op (B.obj T₂)) =
        g.hom.app (Opposite.op T₁) ≫ ℱ.obj.map (Opposite.op τ₀) :=
      g.hom.naturality (Opposite.op τ₀)
    have hunit : (adjR₁.homEquiv R_mod ℱ) g = adjR₁.unit.app R_mod ≫ g.hom.app (Opposite.op T₁) :=
      CategoryTheory.Adjunction.homEquiv_unit adjR₁ R_mod ℱ g
    exact h1.trans ((congrArg (adjR₁.unit.app R_mod ≫ ·) hnat).trans
      ((CategoryTheory.Category.assoc _ _ _).symm.trans
        (congrArg (· ≫ ℱ.obj.map (Opposite.op τ₀)) hunit.symm)))

  have hPreInj : ∀ (ℱ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R))
      (g₁ g₂ : one₁ ⟶ ℱ), π_R ≫ g₁ = π_R ≫ g₂ → g₁ = g₂ := by
    intro ℱ g₁ g₂ h_eq
    apply (adjR₁.homEquiv R_mod ℱ).injective
    let f₁ : R_mod ⟶ ℱ.obj.obj (Opposite.op T₁) := (adjR₁.homEquiv R_mod ℱ) g₁
    let f₂ : R_mod ⟶ ℱ.obj.obj (Opposite.op T₁) := (adjR₁.homEquiv R_mod ℱ) g₂
    have h1 : f₁ ≫ ℱ.obj.map (Opposite.op τ₀) = f₂ ≫ ℱ.obj.map (Opposite.op τ₀) :=
      (hMateEquiv ℱ g₁).symm.trans
        ((congrArg (fun k => (adjR₂.homEquiv R_mod (P_push.obj ℱ)) ((adj.homEquiv one₂ ℱ) k)) h_eq).trans
          (hMateEquiv ℱ g₂))
    have hcancel : ℱ.obj.map (Opposite.op τ₀) ≫ ℱ.obj.map (Opposite.op σ₀) =
        𝟙 (ℱ.obj.obj (Opposite.op T₁)) :=
      (ℱ.obj.map_comp (Opposite.op τ₀) (Opposite.op σ₀)).symm.trans
        ((congrArg (fun u => ℱ.obj.map (Opposite.op u)) hστ).trans
          (ℱ.obj.map_id (Opposite.op T₁)))
    exact (CategoryTheory.Category.comp_id f₁).symm.trans
      ((congrArg (f₁ ≫ ·) hcancel.symm).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ ℱ.obj.map (Opposite.op σ₀)) h1).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (f₂ ≫ ·) hcancel).trans (CategoryTheory.Category.comp_id f₂))))))

  let u_id : R_mod ⟶ (P_pull.obj one₂).obj.obj (Opposite.op (B.obj T₂)) :=
    (adjR₂.homEquiv R_mod (P_push.obj (P_pull.obj one₂)))
      ((adj.homEquiv one₂ (P_pull.obj one₂)) (𝟙 (P_pull.obj one₂)))
  let ι_R : one₁ ⟶ P_pull.obj one₂ :=
    (adjR₁.homEquiv R_mod (P_pull.obj one₂)).symm
      (u_id ≫ (P_pull.obj one₂).obj.map (Opposite.op σ₀))

  have h_inv_hom : π_R ≫ ι_R = 𝟙 (P_pull.obj one₂) := by
    apply (adj.homEquiv one₂ (P_pull.obj one₂)).injective
    apply (adjR₂.homEquiv R_mod (P_push.obj (P_pull.obj one₂))).injective
    have hcancel : (P_pull.obj one₂).obj.map (Opposite.op σ₀) ≫
        (P_pull.obj one₂).obj.map (Opposite.op τ₀) =
        𝟙 ((P_pull.obj one₂).obj.obj (Opposite.op (B.obj T₂))) :=
      ((P_pull.obj one₂).obj.map_comp (Opposite.op σ₀) (Opposite.op τ₀)).symm.trans
        ((congrArg (fun u => (P_pull.obj one₂).obj.map (Opposite.op u)) hτσ).trans
          ((P_pull.obj one₂).obj.map_id _))
    exact (hMateEquiv _ ι_R).trans
      ((congrArg (· ≫ (P_pull.obj one₂).obj.map (Opposite.op τ₀))
        ((adjR₁.homEquiv R_mod (P_pull.obj one₂)).apply_symm_apply _)).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (u_id ≫ ·) hcancel).trans (CategoryTheory.Category.comp_id _))))

  have h_hom_inv : ι_R ≫ π_R = 𝟙 one₁ :=
    hPreInj one₁ (ι_R ≫ π_R) (𝟙 one₁) (by
      rw [← CategoryTheory.Category.assoc, h_inv_hom,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])

  let e_unit : one₁ ≅ P_pull.obj one₂ :=
    { hom := ι_R, inv := π_R, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom }

  have hEv : ∀ (ℱ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R))
      (g : Quiver.Hom one₁ ℱ) (U : W₂.Etale),
      let hat_g := (adj.homEquiv one₂ ℱ) (CategoryTheory.CategoryStruct.comp e_unit.inv g)
      let W_U := B.obj U
      CategoryTheory.CategoryStruct.comp (adjR₂.unit.app R_mod)
        (CategoryTheory.CategoryStruct.comp
          (one₂.obj.map (Opposite.op (hT₂.from U)))
          (hat_g.hom.app (Opposite.op U))) =
      CategoryTheory.CategoryStruct.comp (adjR₁.unit.app R_mod)
        (CategoryTheory.CategoryStruct.comp
          (one₁.obj.map (Opposite.op (hT₁.from W_U)))
          (g.hom.app (Opposite.op W_U))) := by
    intro ℱ g U
    let u₂ : U ⟶ T₂ := hT₂.from U
    let W_U := B.obj U
    let hat_g := (adj.homEquiv one₂ ℱ) (π_R ≫ g)
    have hnat_hat : one₂.obj.map (Opposite.op u₂) ≫ hat_g.hom.app (Opposite.op U) =
        hat_g.hom.app (Opposite.op T₂) ≫ (P_push.obj ℱ).obj.map (Opposite.op u₂) :=
      hat_g.hom.naturality (Opposite.op u₂)
    have hunit₂ : adjR₂.unit.app R_mod ≫ hat_g.hom.app (Opposite.op T₂) =
        (adjR₂.homEquiv R_mod (P_push.obj ℱ)) hat_g :=
      (CategoryTheory.Adjunction.homEquiv_unit adjR₂ R_mod (P_push.obj ℱ) hat_g).symm
    have hnat_g : g.hom.app (Opposite.op (B.obj T₂)) ≫ ℱ.obj.map (Opposite.op (B.map u₂)) =
        one₁.obj.map (Opposite.op (B.map u₂)) ≫ g.hom.app (Opposite.op W_U) :=
      (g.hom.naturality (Opposite.op (B.map u₂))).symm
    have hterm₁ : B.map u₂ ≫ τ₀ = hT₁.from W_U := hT₁.hom_ext _ _
    have hmap₁ : one₁.obj.map (Opposite.op τ₀) ≫ one₁.obj.map (Opposite.op (B.map u₂)) =
        one₁.obj.map (Opposite.op (hT₁.from W_U)) :=
      (one₁.obj.map_comp (Opposite.op τ₀) (Opposite.op (B.map u₂))).symm.trans
        (congrArg (fun u => one₁.obj.map (Opposite.op u)) hterm₁)
    have h_lhs_part :
        adjR₂.unit.app R_mod ≫ (one₂.obj.map (Opposite.op u₂) ≫ hat_g.hom.app (Opposite.op U)) =
        ((adjR₂.homEquiv R_mod (P_push.obj ℱ)) hat_g) ≫ ℱ.obj.map (Opposite.op (B.map u₂)) :=
      (congrArg (adjR₂.unit.app R_mod ≫ ·) hnat_hat).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ (P_push.obj ℱ).obj.map (Opposite.op u₂)) hunit₂))
    have h_rhs_part :
        ((adjR₂.homEquiv R_mod (P_push.obj ℱ)) hat_g) ≫ ℱ.obj.map (Opposite.op (B.map u₂)) =
        adjR₁.unit.app R_mod ≫ (one₁.obj.map (Opposite.op (hT₁.from W_U)) ≫
          g.hom.app (Opposite.op W_U)) := by
      calc
        ((adjR₂.homEquiv R_mod (P_push.obj ℱ)) hat_g) ≫ ℱ.obj.map (Opposite.op (B.map u₂))
          = (adjR₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op τ₀) ≫
              g.hom.app (Opposite.op (B.obj T₂))) ≫ ℱ.obj.map (Opposite.op (B.map u₂)) :=
            congrArg (· ≫ ℱ.obj.map (Opposite.op (B.map u₂))) (hMateT₂ ℱ g)
