  have h_ext_comp : ∀ {A B D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} A] [CategoryTheory.Abelian A]
      [CategoryTheory.HasExt.{u} A] [CategoryTheory.EnoughInjectives A]
      [CategoryTheory.Category.{u + 1, u + 1} B] [CategoryTheory.Abelian B]
      [CategoryTheory.HasExt.{u} B]
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      (F : CategoryTheory.Functor A B)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      (G : CategoryTheory.Functor B D)
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      [CategoryTheory.Limits.PreservesFiniteLimits (F.comp G)]
      [CategoryTheory.Limits.PreservesFiniteColimits (F.comp G)]
      (q : ℕ) (X Y : A) (x : CategoryTheory.Abelian.Ext.{u} X Y q),
      ((F.comp G).mapExtAddHom X Y q) x =
        (G.mapExtAddHom (F.obj X) (F.obj Y) q) ((F.mapExtAddHom X Y q) x) := by
    intro A B D _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ _ _ q X Y x
    rw [CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Functor.mapExtAddHom_apply]
    induction q generalizing Y with
    | zero =>
      let f : X ⟶ Y := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hf : CategoryTheory.Abelian.Ext.mk₀ f = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      rw [← hf, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      let I : A := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let Q : A := CategoryTheory.Limits.cokernel ι
      let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S_c : CategoryTheory.ShortComplex A :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hExact : S_c.Exact :=
        CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_c
          (CategoryTheory.Limits.cokernelIsCokernel ι)
      have hMono : CategoryTheory.Mono S_c.f := by dsimp [S_c]; infer_instance
      have hEpi : CategoryTheory.Epi S_c.g := by dsimp [S_c]; infer_instance
      have hS : S_c.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi
      have hInj : CategoryTheory.Injective S_c.X₂ := by dsimp [S_c, I]; infer_instance
      have hZero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_c.f) (Nat.add_zero (k + 1)) = 0 :=
        @CategoryTheory.Abelian.Ext.eq_zero_of_injective _ _ _ _ X S_c.X₂ k hInj _
      obtain ⟨z, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hZero (rfl : k + 1 = k + 1)
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ih Q z]

  have h_sandwich : ∀ {C : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.HasExt.{u} C]
      {X₀ X₁ Y₁ Y₂ Z₁ Z₂ : C} (q : ℕ)
      (f₁ : X₀ ⟶ X₁) (f₂ : X₁ ⟶ Y₁)
      (E : CategoryTheory.Abelian.Ext.{u} Y₁ Y₂ q)
      (g₁ : Y₂ ⟶ Z₁) (g₂ : Z₁ ⟶ Z₂),
      (((CategoryTheory.Abelian.Ext.mk₀ f₁).comp
        (((CategoryTheory.Abelian.Ext.mk₀ f₂).comp E (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ g₁) (Nat.add_zero q))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ g₂) (Nat.add_zero q)) =
      (((CategoryTheory.Abelian.Ext.mk₀ (f₁ ≫ f₂)).comp E (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (g₁ ≫ g₂)) (Nat.add_zero q)) := by
    intro C _ _ _ X₀ X₁ Y₁ Y₂ Z₁ Z₂ q f₁ f₂ E g₁ g₂
    have h1 : (CategoryTheory.Abelian.Ext.mk₀ f₁).comp
        (((CategoryTheory.Abelian.Ext.mk₀ f₂).comp E (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ g₁) (Nat.add_zero q))
        (Nat.zero_add q) =
        (((CategoryTheory.Abelian.Ext.mk₀ f₁).comp
          ((CategoryTheory.Abelian.Ext.mk₀ f₂).comp E (Nat.zero_add q))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ g₁) (Nat.add_zero q)) :=
      (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q)).symm
    have h2 : (CategoryTheory.Abelian.Ext.mk₀ f₁).comp
        ((CategoryTheory.Abelian.Ext.mk₀ f₂).comp E (Nat.zero_add q))
        (Nat.zero_add q) =
        ((CategoryTheory.Abelian.Ext.mk₀ (f₁ ≫ f₂)).comp E (Nat.zero_add q)) := by
      rw [← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ f₁) (CategoryTheory.Abelian.Ext.mk₀ f₂) E
        (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    rw [h1, h2, CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  
  have h_ext_intertwine : ∀ {C_M₁ C_M₂ C_A₁ C_A₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C_M₁] [CategoryTheory.Abelian C_M₁]
      [CategoryTheory.HasExt.{u} C_M₁]
      [CategoryTheory.Category.{u + 1, u + 1} C_M₂] [CategoryTheory.Abelian C_M₂]
      [CategoryTheory.HasExt.{u} C_M₂] [CategoryTheory.EnoughInjectives C_M₂]
      [CategoryTheory.Category.{u + 1, u + 1} C_A₁] [CategoryTheory.Abelian C_A₁]
      [CategoryTheory.HasExt.{u} C_A₁]
      [CategoryTheory.Category.{u + 1, u + 1} C_A₂] [CategoryTheory.Abelian C_A₂]
      [CategoryTheory.HasExt.{u} C_A₂] [CategoryTheory.EnoughInjectives C_A₂]
      (U₁ : CategoryTheory.Functor C_M₁ C_A₁)
      [U₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits U₁]
      [CategoryTheory.Limits.PreservesFiniteColimits U₁]
      (U₂ : CategoryTheory.Functor C_M₂ C_A₂)
      [U₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits U₂]
      [CategoryTheory.Limits.PreservesFiniteColimits U₂]
      (P_pull : CategoryTheory.Functor C_M₂ C_M₁)
      [P_pull.Additive] [CategoryTheory.Limits.PreservesFiniteLimits P_pull]
      [CategoryTheory.Limits.PreservesFiniteColimits P_pull]
      (P_pull_ab P_pull_p : CategoryTheory.Functor C_A₂ C_A₁)
      [P_pull_ab.Additive] [CategoryTheory.Limits.PreservesFiniteLimits P_pull_ab]
      [CategoryTheory.Limits.PreservesFiniteColimits P_pull_ab]
      [P_pull_p.Additive] [CategoryTheory.Limits.PreservesFiniteLimits P_pull_p]
      [CategoryTheory.Limits.PreservesFiniteColimits P_pull_p]
      (e_comm : P_pull.comp U₁ ≅ U₂.comp P_pull_ab)
      (η_p : P_pull_ab ≅ P_pull_p)
      (one₁ : C_M₁) (one₂ : C_M₂)
      (Fℤ₁ FM₁ : C_A₁) (Fℤ₂ FM₂ : C_A₂)
      (e_hom : one₁ ⟶ P_pull.obj one₂) (e_inv : P_pull.obj one₂ ⟶ one₁)
      (ηℤ₁ : Fℤ₁ ⟶ U₁.obj one₁) (βM₁ : U₁.obj one₁ ⟶ FM₁)
      (ηℤ₂ : Fℤ₂ ⟶ U₂.obj one₂) (βM₂ : U₂.obj one₂ ⟶ FM₂)
      (ιℤ_p : Fℤ₁ ⟶ P_pull_p.obj Fℤ₂) (πM_p : P_pull_p.obj FM₂ ⟶ FM₁)
      (q : ℕ),
      (ηℤ₁ ≫ U₁.map e_hom) ≫ e_comm.hom.app one₂ =
        (ιℤ_p ≫ η_p.inv.app Fℤ₂) ≫ P_pull_ab.map ηℤ₂ →
      e_comm.inv.app one₂ ≫ (U₁.map e_inv ≫ βM₁) =
        (P_pull_ab.map βM₂ ≫ η_p.hom.app FM₂) ≫ πM_p →
      ∀ (γ : CategoryTheory.Abelian.Ext.{u} one₂ one₂ q),
        (((CategoryTheory.Abelian.Ext.mk₀ ηℤ₁).comp
          (U₁.mapExtAddHom one₁ one₁ q
            (((CategoryTheory.Abelian.Ext.mk₀ e_hom).comp
              (P_pull.mapExtAddHom one₂ one₂ q γ) (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_inv) (Nat.add_zero q)))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ βM₁) (Nat.add_zero q)) =
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_p).comp
          (P_pull_p.mapExtAddHom Fℤ₂ FM₂ q
            (((CategoryTheory.Abelian.Ext.mk₀ ηℤ₂).comp
              (U₂.mapExtAddHom one₂ one₂ q γ) (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ βM₂) (Nat.add_zero q)))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM_p) (Nat.add_zero q)) := by
    intro C_M₁ C_M₂ C_A₁ C_A₂ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      U₁ _ _ _ U₂ _ _ _ P_pull _ _ _ P_pull_ab P_pull_p _ _ _ _ _ _
      e_comm η_p one₁ one₂ Fℤ₁ FM₁ Fℤ₂ FM₂
      e_hom e_inv ηℤ₁ βM₁ ηℤ₂ βM₂ ιℤ_p πM_p q hLeft hRight γ
