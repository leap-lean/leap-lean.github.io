              Set.range ((O_a a).ι ≫ (W.hom : W.left ⟶ S)).base ⊆ (V : Set ↥S) := by
            rintro a ha _ ⟨p, rfl⟩
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
            by_contra hnot
            have h0 := s.2 ((O_a a).ι.base p) hnot
            have hm : s.1 ((O_a a).ι.base p) = a := hMemOpen (O_a a) p
            exact ha (hm.symm.trans h0)
          let μ_of : ∀ (a : R₀), a ≠ 0 → (openSubEt W (O_a a) ⟶ openEt V) := fun a ha =>
            let l := liftOpen V ((O_a a).ι ≫ (W.hom : W.left ⟶ S)) (hSubV a ha)
            CategoryTheory.MorphismProperty.Over.homMk l.1 l.2
