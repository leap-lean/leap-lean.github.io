    have : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hOverW : ∀ {S : AlgebraicGeometry.Scheme.{u}} {A B : S.Etale} (f : Quiver.Hom A B),
        CategoryTheory.CategoryStruct.comp f.left B.hom = A.hom :=
      fun f => CategoryTheory.MorphismProperty.Over.w f
    have hMemSmallEtale : ∀ {X : AlgebraicGeometry.Scheme.{u}} (W : X.Etale)
        (S : CategoryTheory.Sieve W),
        (∀ x : ↥W.left, ∃ (U_et : X.Etale) (f : Quiver.Hom U_et W) (y : ↥U_et.left),
          S.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x) →
        S ∈ X.smallEtaleTopology W :=
      fun {X} W S hcov =>
        let hEq := congrArg (fun (J : CategoryTheory.GrothendieckTopology X.Etale) => S ∈ J W)
          (X.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (le_refl _))
        Eq.mpr hEq ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W S).mpr hcov)
    let X_cov : Bool → Y.Etale := fun b => if b then W_V else W_Uc
    let π_cov : (b : Bool) → Quiver.Hom (X_cov b) T_Y :=
      fun b => by cases b; exact μ_Uc; exact μ_V
    have hSieveMem : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows X_cov π_cov) ∈
        Y.smallEtaleTopology T_Y := by
      apply hMemSmallEtale T_Y
      intro y
      by_cases hy : y ∈ Set.range i.base
      · rcases hy with ⟨z, rfl⟩
        have h_wt : (π_cov true).left = V.ι :=
          (CategoryTheory.Category.comp_id (π_cov true).left).symm.trans
            ((hOverW (π_cov true)).trans (CategoryTheory.Category.id_comp V.ι))
        refine ⟨X_cov true, π_cov true, s_V.base z,
          ⟨X_cov true, CategoryTheory.CategoryStruct.id _, π_cov true,
            CategoryTheory.Presieve.ofArrows.mk true, CategoryTheory.Category.id_comp _⟩,
          h_wt.symm ▸ (inferInstance : AlgebraicGeometry.Etale V.ι),
          (congrArg (fun k => k.base (s_V.base z)) h_wt).trans (congrArg (fun k => k.base z) hs_V)⟩
      · have h_wf : (π_cov false).left = U_c.ι :=
          (CategoryTheory.Category.comp_id (π_cov false).left).symm.trans
            ((hOverW (π_cov false)).trans (CategoryTheory.Category.id_comp U_c.ι))
        refine ⟨X_cov false, π_cov false, ⟨y, hy⟩,
          ⟨X_cov false, CategoryTheory.CategoryStruct.id _, π_cov false,
            CategoryTheory.Presieve.ofArrows.mk false, CategoryTheory.Category.id_comp _⟩,
          h_wf.symm ▸ (inferInstance : AlgebraicGeometry.Etale U_c.ι),
          congrArg (fun k => k.base ⟨y, hy⟩) h_wf⟩
    let P_F : CategoryTheory.Functor Y.Etaleᵒᵖ (Type u) :=
      F.obj.comp (CategoryTheory.forget AddCommGrpCat.{u})
    have hSh_PF : CategoryTheory.Presieve.IsSheaf Y.smallEtaleTopology P_F :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type Y.smallEtaleTopology P_F).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf Y.smallEtaleTopology F.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) F.property)
    have hSheafFor : CategoryTheory.Presieve.IsSheafFor P_F
        (CategoryTheory.Presieve.ofArrows X_cov π_cov) :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (hSh_PF _ hSieveMem)
    rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hSheafFor
    refine ⟨?_, ?_⟩
    · intro f₁ f₂ hf
      dsimp only at hf
      apply (CategoryTheory.cancel_epi (weilGysinAbSupportQuotHom i hc_i)).mp
      apply (adj_Y.homEquiv Aℤ F).injective
      apply hZHomInj
      let s₁ : P_F.obj (Opposite.op T_Y) :=
        ((adj_Y.homEquiv Aℤ F) (CategoryTheory.CategoryStruct.comp (weilGysinAbSupportQuotHom i hc_i) f₁))
          (ULift.up (1 : ℤ))
      let s₂ : P_F.obj (Opposite.op T_Y) :=
        ((adj_Y.homEquiv Aℤ F) (CategoryTheory.CategoryStruct.comp (weilGysinAbSupportQuotHom i hc_i) f₂))
          (ULift.up (1 : ℤ))
      have hs₁_Uc : F.obj.map (Opposite.op μ_Uc) s₁ = 0 := (hIff_Y _).mp ⟨f₁, rfl⟩
      have hs₂_Uc : F.obj.map (Opposite.op μ_Uc) s₂ = 0 := (hIff_Y _).mp ⟨f₂, rfl⟩
      have hs_V_eq : F.obj.map (Opposite.op μ_V) s₁ = F.obj.map (Opposite.op μ_V) s₂ := by
        have heq12 : CategoryTheory.CategoryStruct.comp (weilGysinAbOpenConstHom V hc_MV Aℤ)
            (j_star.map (CategoryTheory.CategoryStruct.comp (weilGysinAbSupportQuotHom i hc_i) f₁)) =
            CategoryTheory.CategoryStruct.comp (weilGysinAbOpenConstHom V hc_MV Aℤ)
              (j_star.map (CategoryTheory.CategoryStruct.comp (weilGysinAbSupportQuotHom i hc_i) f₂)) := by
          rw [j_star.map_comp, j_star.map_comp,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            ← hβ_comm, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hf]
        exact (hEvRestrict _).symm.trans
          ((congrArg (fun m => ((adj_V.homEquiv Aℤ (j_star.obj F)) m) (ULift.up (1 : ℤ))) heq12).trans
            (hEvRestrict _))
      let x_tup : (b : Bool) → P_F.obj (Opposite.op (X_cov b)) :=
        fun b => (CategoryTheory.ConcreteCategory.hom (P_F.map (π_cov b).op)) s₁
      have hCompat : CategoryTheory.Presieve.Arrows.Compatible P_F π_cov x_tup := by
        intro I₁ I₂ Z_et g₁ g₂ hg_eq
        dsimp only [x_tup]
        change (F.obj.map g₁.op) ((F.obj.map (π_cov I₁).op) s₁) =
          (F.obj.map g₂.op) ((F.obj.map (π_cov I₂).op) s₁)
        rw [← CategoryTheory.ConcreteCategory.comp_apply, ← F.obj.map_comp, ← op_comp, hg_eq,
          op_comp, F.obj.map_comp, CategoryTheory.ConcreteCategory.comp_apply]
      obtain ⟨_, _, hUniq⟩ := hSheafFor x_tup hCompat
      have h₁_sol : s₁ = _ := hUniq s₁ (fun _ => rfl)
      have h₂_sol : s₂ = _ := hUniq s₂ (fun b => by
        cases b
        · change F.obj.map (Opposite.op μ_Uc) s₂ = F.obj.map (Opposite.op μ_Uc) s₁
          rw [hs₂_Uc, hs₁_Uc]
        · change F.obj.map (Opposite.op μ_V) s₂ = F.obj.map (Opposite.op μ_V) s₁
          exact hs_V_eq.symm)
      exact h₁_sol.trans h₂_sol.symm
    · intro f_V
      let g_V : Quiver.Hom Fℤ_V (j_star.obj F) :=
        CategoryTheory.CategoryStruct.comp (weilGysinAbSupportQuotHom s_V hc_sV) f_V
      let s' : ↥(F.obj.obj (Opposite.op W_V)) :=
        ((adj_V.homEquiv Aℤ (j_star.obj F)) g_V) (ULift.up (1 : ℤ))
      have hs'_van : F.obj.map (Opposite.op (M_V.map ν_UVc)) s' = 0 :=
