        (congrArg (CategoryTheory.Limits.pullback.lift γ.1 ξ γ.2 ≫ ·)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
          (CategoryTheory.Limits.pullback.lift_snd γ.1 ξ γ.2)
      exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
        (h2.symm.trans (CategoryTheory.Category.assoc _ _ _).symm)
