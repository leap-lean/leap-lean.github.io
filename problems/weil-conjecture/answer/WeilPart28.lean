          exact (f.hom.naturality (θ_φ.inv.app U.unop).op).symm)
    let adj_pull : P_k n ⊣ P_push := Adjunction.ofNatIsoRight (adj_Pk n) e_push
    let τ : B_φ.obj T_std ⟶ T_std := hT_std.from (B_φ.obj T_std)
    have hπ_eq : ∀ A : D,
        (adj_pull.homEquiv (C.obj A) (C.obj A)).symm
          ((adj.homEquiv A (P_push.obj (C.obj A))).symm
            (adj.unit.app A ≫ (C.obj A).obj.map τ.op)) = β_k n A := by
      intro A
      apply (adj_pull.homEquiv (C.obj A) (C.obj A)).injective
      apply (adj.homEquiv A (P_push.obj (C.obj A))).injective
      rw [(adj_pull.homEquiv (C.obj A) (C.obj A)).apply_symm_apply,
          (adj.homEquiv A (P_push.obj (C.obj A))).apply_symm_apply]
      have hadj_β : (adj_Pk n).homEquiv (C.obj A) (C.obj A) (β_k n A) = α'_k n A := by
        rw [(adj_Pk n).homEquiv_unit]
        change (unitP_k n).hom.app (C.obj A) ≫ (P_inv_k n).map (β_k n A) = α'_k n A
        have h1 : ((unitP_k n).hom.app (C.obj A) ≫ (P_inv_k n).map (β_k n A)) ≫ β'_k n A =
            𝟙 (C.obj A) := by
          dsimp [β'_k]
          calc
            ((unitP_k n).hom.app (C.obj A) ≫ (P_inv_k n).map (β_k n A)) ≫
                ((P_inv_k n).map (α_k n A) ≫ (unitP_k n).inv.app (C.obj A))
              = (unitP_k n).hom.app (C.obj A) ≫
                  ((P_inv_k n).map (β_k n A) ≫ (P_inv_k n).map (α_k n A)) ≫
                  (unitP_k n).inv.app (C.obj A) := by simp only [Category.assoc]
            _ = (unitP_k n).hom.app (C.obj A) ≫ (unitP_k n).inv.app (C.obj A) := by
                rw [← (P_inv_k n).map_comp, hβα_k n A, (P_inv_k n).map_id]
                dsimp only [Functor.comp_obj]
                rw [Category.id_comp]
            _ = 𝟙 (C.obj A) := (unitP_k n).hom_inv_id_app (C.obj A)
        calc
          (unitP_k n).hom.app (C.obj A) ≫ (P_inv_k n).map (β_k n A)
            = ((unitP_k n).hom.app (C.obj A) ≫ (P_inv_k n).map (β_k n A)) ≫
                (β'_k n A ≫ α'_k n A) := by rw [hβ'α'_k n A, Category.comp_id]
          _ = (((unitP_k n).hom.app (C.obj A) ≫ (P_inv_k n).map (β_k n A)) ≫ β'_k n A) ≫
                α'_k n A := (Category.assoc _ _ _).symm
