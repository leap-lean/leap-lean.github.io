              change (z.comp (Abelian.Ext.mk₀ (βM_of S m)) (Nat.add_zero k)).comp
                (Abelian.Ext.mk₀ (αM_of S m)) (Nat.add_zero k) = z
              rw [Abelian.Ext.comp_assoc z _ _ (Nat.add_zero k) (Nat.zero_add 0) (Nat.add_zero k),
