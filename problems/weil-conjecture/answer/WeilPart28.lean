      T_std, hT_std, T_std, hT_std, α_k n Aℤ, ?_, ?_, ?_⟩
    · change α_k n Aℤ ≫ _ = 𝟙 (C.obj Aℤ)
      rw [hπ_eq Aℤ]
      exact hαβ_k n Aℤ
    · change _ ≫ α_k n Aℤ = 𝟙 ((P_k n).obj (C.obj Aℤ))
      rw [hπ_eq Aℤ]
      exact hβα_k n Aℤ
    · intro x
