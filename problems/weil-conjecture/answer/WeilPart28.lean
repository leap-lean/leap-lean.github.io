      rwa [one_smul, one_smul] at h1
    have hSheafOpenSep : ∀ {S : AlgebraicGeometry.Scheme.{u}} {R₀ : Type u} [CommRing R₀]
        (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R₀))
        (W : S.Etale) {ι : Type u} (O : ι → W.left.Opens)
        (hcov : ∀ w : ↥W.left, ∃ i : ι, w ∈ O i)
        (y₁ y₂ : ↥(𝒢.obj.obj (Opposite.op W))),
        (∀ i : ι,
