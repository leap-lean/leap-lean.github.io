            (CategoryTheory.Category.id_comp _).symm
      _ = (P_pull_ab.map βM₂ ≫ P_pull_ab.map αM₂) ≫
            e_comm.inv.app one₂ ≫ U₁.map e_unit.inv ≫ βM₁ := by rw [h_p_βα]
      _ = P_pull_ab.map βM₂ ≫
            (P_pull_ab.map αM₂ ≫ e_comm.inv.app one₂ ≫ U₁.map e_unit.inv) ≫ βM₁ := by
            simp only [CategoryTheory.Category.assoc]
