        have h_rhs_chain :
            (z_to_m_of m₁ ≫ ιM_of m₁ ≫ u₀_of Y m₁) ≫
              Fgt₁.map ((q_mod_std B_si m₁).hom.app (Opposite.op (T_of Y))) =
            z_to_m_of m₁ ≫ ιM_of m₁ ≫
              u₀_of S m₁ ≫ ((U_of S m₁).obj (One_of S m₁)).obj.map τ_si.op :=
          (Category.assoc (z_to_m_of m₁) (ιM_of m₁ ≫ u₀_of Y m₁) _).trans
            (congrArg (z_to_m_of m₁ ≫ ·)
