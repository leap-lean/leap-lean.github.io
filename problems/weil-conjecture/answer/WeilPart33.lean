  have h_s8 :
      ∀ (R : Type u) [CommRing R]
        (ℱ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))).smallEtaleTopology
          AddCommGrpCat.{u})
        (C₀ : Type u) [CommRing C₀] (f₀ : R →+* C₀) (hf₀ : f₀.Etale),
        let B := AlgebraicGeometry.Spec (CommRingCat.of R)
        let X := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))
        let p : Quiver.Hom X B :=
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))
        let P_ℱ : CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u} :=
          CategoryTheory.Functor.comp (weilAltCdSitePullback p).op
            (CategoryTheory.Sheaf.cohomologyPresheaf ℱ b)
        let Z₀ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial C₀))
        let π₀ : Quiver.Hom Z₀ X :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom f₀))
        let 𝒢₀ := ((weilEtaleSitePullback π₀).sheafPullback AddCommGrpCat.{u}
          X.smallEtaleTopology Z₀.smallEtaleTopology).obj ℱ
        ∃ (Ξ : ↥(P_ℱ.obj (Opposite.op (U_of R C₀ f₀ hf₀))) ≃+
            (((weilEtaleSitePullback (CategoryTheory.CategoryStruct.id Z₀)).sheafPullback
              AddCommGrpCat.{u} Z₀.smallEtaleTopology Z₀.smallEtaleTopology).obj 𝒢₀).H b),
          ∀ (C₁ : Type u) [CommRing C₁] (g₁ : C₀ →+* C₁) (_hg₁ : g₁.Etale)
            (hf₁ : (g₁.comp f₀).Etale)
            (s₀ : ↥(P_ℱ.obj (Opposite.op (U_of R C₀ f₀ hf₀)))),
            let π₁ : Quiver.Hom
                (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial C₁))) Z₀ :=
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom g₁))
            (P_ℱ.map (Opposite.op (w_of R f₀ hf₀ g₁ hf₁))).hom s₀ = 0 ↔
              WeilEtaleTrianglePullbackMapsTo
                π₁ (CategoryTheory.CategoryStruct.id Z₀) π₁
                (CategoryTheory.Category.comp_id π₁) 𝒢₀ b (Ξ s₀) 0 := by
    intro R _ ℱ C₀ _ f₀ hf₀ B X p P_ℱ Z₀ π₀ 𝒢₀
    obtain ⟨iso_Z, h_iso_proj, h_iso_nat⟩ := h_s8_geom R
    let U₀ := U_of R C₀ f₀ hf₀
    let V₀ := (weilAltCdSitePullback p).obj U₀
