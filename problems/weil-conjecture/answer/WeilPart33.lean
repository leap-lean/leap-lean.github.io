  let fst_Z2 := CategoryTheory.Limits.pullback.fst Z_bar.hom (weilProjectiveSpaceOver k 2).hom
  let snd_Z2 := CategoryTheory.Limits.pullback.snd Z_bar.hom (weilProjectiveSpaceOver k 2).hom
  let lift_Y : Y₂.left ⟶ P_Z2 := CategoryTheory.Limits.pullback.lift π_Y.left g₂.left hcomm_net

  have hGamma_comm : 𝟙 Z_bar.left ≫ Z_bar.hom =
      (Z_bar.hom ≫ s₂) ≫ (weilProjectiveSpaceOver k 2).hom := by
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs₂_sec,
      CategoryTheory.Category.comp_id]
  let Γ_s₂ : Z_bar.left ⟶ P_Z2 :=
    CategoryTheory.Limits.pullback.lift (𝟙 Z_bar.left) (Z_bar.hom ≫ s₂) hGamma_comm
  have hΓ_fst : Γ_s₂ ≫ fst_Z2 = 𝟙 Z_bar.left :=
    CategoryTheory.Limits.pullback.lift_fst _ _ hGamma_comm
  have hΓ_snd : Γ_s₂ ≫ snd_Z2 = Z_bar.hom ≫ s₂ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ hGamma_comm

  have hPb_Gamma : CategoryTheory.IsPullback Γ_s₂ Z_bar.hom snd_Z2 s₂ := by
    refine CategoryTheory.IsPullback.of_right ?_ hΓ_snd
      (CategoryTheory.IsPullback.of_hasPullback Z_bar.hom (weilProjectiveSpaceOver k 2).hom)
    rw [hΓ_fst, hs₂_sec]
    exact CategoryTheory.IsPullback.id_horiz Z_bar.hom

  have hιH_hom : ι_H ≫ Z_bar.hom = p_k := by
    rw [hι_H_eq, CategoryTheory.Category.assoc, hcomm_net, ← CategoryTheory.Category.assoc,
      hPb_fib.w, CategoryTheory.Category.assoc, hs₂_sec, CategoryTheory.Category.comp_id]

  have hp_lift_comm : p_Y ≫ lift_Y = ι_H ≫ Γ_s₂ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · dsimp [lift_Y, Γ_s₂, p_Y, ι_H]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.comp_id, hπ₀_left]
    · dsimp [lift_Y, Γ_s₂]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      rw [← CategoryTheory.Category.assoc ι_H, hιH_hom, hPb_fib.w]

  have hPb_inc : CategoryTheory.IsPullback p_Y ι_H lift_Y Γ_s₂ := by
    have htot : CategoryTheory.IsPullback p_Y (ι_H ≫ Z_bar.hom) (lift_Y ≫ snd_Z2) s₂ := by
      rw [hιH_hom, CategoryTheory.Limits.pullback.lift_snd]
      exact hPb_fib
    exact CategoryTheory.IsPullback.of_bot htot hp_lift_comm hPb_Gamma

  have hCl_ιH : AlgebraicGeometry.IsClosedImmersion ι_H :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_inc hCl_liftY

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  have hF_mem : L_pt ∈ 𝒜_M ((1 : ℕ) • 1) := by
    rw [one_smul, ← hL_sum]
    refine Submodule.sum_mem (𝒜_M 1) fun r _ => ?_
    rw [MvPolynomial.C_mul']
    exact Submodule.smul_mem _ (c_pt r) (hL_homog r)

  have hLocalKer : ∀ (μ : Fin (M + 1))
      (hXμ : MvPolynomial.X μ ∈ 𝒜_M 1)
      (U_Z : Z_bar.left.Opens) (hAffUZ : AlgebraicGeometry.IsAffineOpen U_Z)
      (hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X μ))),
      RingHom.ker (ι_H.app U_Z).hom =
        Ideal.span {(ι_bar.left.appLE
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X μ)) U_Z hUZ).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X μ)).hom
            (HomogeneousLocalization.Away.mk 𝒜_M hXμ 1 L_pt hF_mem))} := by
    intro μ hXμ U_Z hAffUZ hUZ
    let U_Mμ : (weilProjectiveSpaceOver k M).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X μ)
    have hUZ' : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj U_Mμ := hUZ
    let awayM : CommRingCat.of (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X μ)) ⟶
        (weilProjectiveSpaceOver k M).left.presheaf.obj (Opposite.op U_Mμ) :=
      AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X μ)
    let U_P : (weilProjectiveSpaceOver k 2).left.Opens := U₂_fn b_idx
    have hAffUP : AlgebraicGeometry.IsAffineOpen U_P := hProjAffine 2 β
    let hWβ : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
      MvPolynomial.isHomogeneous_X k β
    let W_pb : P_Z2.Opens :=
      (TopologicalSpace.Opens.map fst_Z2.base).obj U_Z ⊓
        (TopologicalSpace.Opens.map snd_Z2.base).obj U_P
    have hAffWpb : AlgebraicGeometry.IsAffineOpen W_pb := by
      let f_aff := hAffUZ.fromSpec ≫ Z_bar.hom
      let g_aff := hAffUP.fromSpec ≫ (weilProjectiveSpaceOver k 2).hom
      let j_pb : CategoryTheory.Limits.pullback f_aff g_aff ⟶ P_Z2 :=
        CategoryTheory.Limits.pullback.map f_aff g_aff Z_bar.hom (weilProjectiveSpaceOver k 2).hom
          hAffUZ.fromSpec hAffUP.fromSpec (𝟙 _)
          (CategoryTheory.Category.comp_id _) (CategoryTheory.Category.comp_id _)
      haveI : AlgebraicGeometry.IsOpenImmersion j_pb := by
        dsimp [j_pb]
        infer_instance
      have hopen_eq : j_pb.opensRange = W_pb := by
        ext w
        change w ∈ Set.range j_pb.base ↔ w ∈ W_pb
        dsimp [j_pb]
        rw [AlgebraicGeometry.Scheme.Pullback.range_map]
        have hrZ : Set.range hAffUZ.fromSpec.base = (U_Z : Set Z_bar.left) := by
          rw [← hAffUZ.isoSpec_inv_ι]
          ext z
          constructor
          · rintro ⟨p, rfl⟩; exact (hAffUZ.isoSpec.inv.base p).2
          · intro hz; exact ⟨hAffUZ.isoSpec.hom.base ⟨z, hz⟩, by
              change (hAffUZ.isoSpec.hom ≫ hAffUZ.isoSpec.inv ≫ U_Z.ι).base ⟨z, hz⟩ = z
              rw [hAffUZ.isoSpec.hom_inv_id_assoc]; rfl⟩
        have hrP : Set.range hAffUP.fromSpec.base = (U_P : Set (weilProjectiveSpaceOver k 2).left) := by
          rw [← hAffUP.isoSpec_inv_ι]
          ext p₀
          constructor
          · rintro ⟨p, rfl⟩; exact (hAffUP.isoSpec.inv.base p).2
          · intro hp₀; exact ⟨hAffUP.isoSpec.hom.base ⟨p₀, hp₀⟩, by
              change (hAffUP.isoSpec.hom ≫ hAffUP.isoSpec.inv ≫ U_P.ι).base ⟨p₀, hp₀⟩ = p₀
              rw [hAffUP.isoSpec.hom_inv_id_assoc]; rfl⟩
        rw [hrZ, hrP]
        rfl
      rw [← hopen_eq]
      exact AlgebraicGeometry.isAffineOpen_opensRange j_pb

    have hUW : U_Z ≤ (TopologicalSpace.Opens.map Γ_s₂.base).obj W_pb := by
      intro z hz
      refine ⟨?_, ?_⟩
      · change (Γ_s₂ ≫ fst_Z2).base z ∈ U_Z
        rwa [hΓ_fst]
      · change (Γ_s₂ ≫ snd_Z2).base z ∈ U_P
        rw [hΓ_snd]
        exact hs₂_le trivial

    let ℓ_r : Fin 3 → ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z)) := fun r =>
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X μ) hXμ zero_lt_one).hom ≫
        ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X μ)) U_Z hUZ).hom
        (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩)
    let w_r : Fin 3 → ↑((weilProjectiveSpaceOver k 2).left.presheaf.obj (Opposite.op U_P)) := fun r =>
      (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β) hWβ zero_lt_one).hom ≫
        (weilProjectiveSpaceOver k 2).left.presheaf.map (CategoryTheory.homOfLE (le_rfl : U_P ≤ U_P)).op)).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
            ⟨MvPolynomial.X β, hWβ⟩, ⟨1, pow_one _⟩⟩)
    let G_inc : ↑(P_Z2.presheaf.obj (Opposite.op W_pb)) :=
      ∑ r : Fin 3,
        (fst_Z2.appLE U_Z W_pb inf_le_left).hom (ℓ_r r) *
          (snd_Z2.appLE U_P W_pb inf_le_right).hom (w_r r)
    have hKerY : RingHom.ker (lift_Y.app W_pb).hom = Ideal.span {G_inc} :=
      hKer_inc μ hXμ β hWβ U_Z hAffUZ hUZ U_P hAffUP le_rfl W_pb hAffWpb inf_le_left inf_le_right

    let V_Y : Y₂.left.Opens := (TopologicalSpace.Opens.map lift_Y.base).obj W_pb
    let V_H : F_pt.Opens := (TopologicalSpace.Opens.map ι_H.base).obj U_Z
    haveI : AlgebraicGeometry.IsAffineHom lift_Y := inferInstance
    haveI : AlgebraicGeometry.IsAffineHom ι_H := inferInstance
    let hAffVY : AlgebraicGeometry.IsAffineOpen V_Y := hAffWpb.preimage lift_Y
    let hAffVH : AlgebraicGeometry.IsAffineOpen V_H := hAffUZ.preimage ι_H
    let γ_U := (Γ_s₂.appLE W_pb U_Z hUW).hom
    let ρ_Y := (lift_Y.app W_pb).hom
    let φ_H := (ι_H.app U_Z).hom
    have hρY_surj : Function.Surjective ρ_Y :=
      (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl_liftY).2 W_pb hAffWpb

    have hKer_γG : RingHom.ker φ_H = Ideal.span {γ_U G_inc} := by
      apply le_antisymm
      · let A_Z := ↑(Z_bar.left.presheaf.obj (Opposite.op U_Z))
        let I_Q : Ideal A_Z := Ideal.span {γ_U G_inc}
        let Q := A_Z ⧸ I_Q
        let mk_Q : A_Z →+* Q := Ideal.Quotient.mk I_Q
        have hker_le : RingHom.ker ρ_Y ≤ RingHom.ker (mk_Q.comp γ_U) := by
          rw [hKerY, Ideal.span_le, Set.singleton_subset_iff]
          change mk_Q (γ_U G_inc) = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.subset_span (Set.mem_singleton (γ_U G_inc)))
        let e_quot := RingHom.quotientKerEquivOfSurjective hρY_surj
        let ψ_bar : (↑(P_Z2.presheaf.obj (Opposite.op W_pb)) ⧸ RingHom.ker ρ_Y) →+* Q :=
          Ideal.Quotient.lift (RingHom.ker ρ_Y) (mk_Q.comp γ_U) hker_le
        let ψ_Y : ↑(Y₂.left.presheaf.obj (Opposite.op V_Y)) →+* Q :=
          ψ_bar.comp e_quot.symm.toRingHom
        have hψY_comp : ψ_Y.comp ρ_Y = mk_Q.comp γ_U := by
          apply RingHom.ext
          intro x
          dsimp [ψ_Y, ψ_bar]
          have he : e_quot.symm (ρ_Y x) = Ideal.Quotient.mk (RingHom.ker ρ_Y) x := by
            apply e_quot.injective
            rw [e_quot.apply_symm_apply]
            rfl
          rw [he]
          rfl
        let f_top : AlgebraicGeometry.Spec (CommRingCat.of Q) ⟶ Y₂.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y) ≫ hAffVY.fromSpec
        let f_left : AlgebraicGeometry.Spec (CommRingCat.of Q) ⟶ Z_bar.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_Q) ≫ hAffUZ.fromSpec
        have hcomm_Q : f_top ≫ lift_Y = f_left ≫ Γ_s₂ := by
          dsimp [f_top, f_left]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hFromSpecComm lift_Y hAffWpb hAffVY le_rfl,
            hFromSpecComm Γ_s₂ hAffWpb hAffUZ hUW,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
          congr 2
          rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
          exact CommRingCat.hom_ext hψY_comp
        let l_Q : AlgebraicGeometry.Spec (CommRingCat.of Q) ⟶ F_pt :=
          hPb_inc.lift f_top f_left hcomm_Q
        have hl_Q_left : l_Q ≫ ι_H = f_left := hPb_inc.lift_snd f_top f_left hcomm_Q
        have hl_in_VH : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Q)).Opens) ≤
            (TopologicalSpace.Opens.map l_Q.base).obj V_H := by
          intro p _
          change (l_Q ≫ ι_H).base p ∈ U_Z
          rw [hl_Q_left]
          dsimp [f_left]
          rw [← hAffUZ.isoSpec_inv_ι]
          exact (hAffUZ.isoSpec.inv.base _).2
        have hUZ_in : (⊤ : (AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op U_Z))).Opens) ≤
            (TopologicalSpace.Opens.map hAffUZ.fromSpec.base).obj U_Z := by
          intro p _
          change hAffUZ.fromSpec.base p ∈ U_Z
          rw [← hAffUZ.isoSpec_inv_ι]
          exact (hAffUZ.isoSpec.inv.base p).2
        have happ_l : CommRingCat.ofHom φ_H ≫ l_Q.appLE V_H ⊤ hl_in_VH ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Q)).hom =
            CommRingCat.ofHom mk_Q := by
          have h1 : CommRingCat.ofHom φ_H ≫ l_Q.appLE V_H ⊤ hl_in_VH =
              (l_Q ≫ ι_H).appLE U_Z ⊤ hl_in_VH := by
            change ι_H.app U_Z ≫ l_Q.appLE V_H ⊤ hl_in_VH = _
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
          have hf_left_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Q)).Opens) ≤
              (TopologicalSpace.Opens.map f_left.base).obj U_Z := by
            rw [← hl_Q_left]; exact hl_in_VH
          have hl_app_eq : (l_Q ≫ ι_H).appLE U_Z ⊤ hl_in_VH = f_left.appLE U_Z ⊤ hf_left_in := by
            congr 1
          rw [← CategoryTheory.Category.assoc, h1, hl_app_eq]
          dsimp [f_left]
          rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ U_Z ⊤ ⊤ hUZ_in le_rfl]
          have hfrom_UZ : hAffUZ.fromSpec.appLE U_Z ⊤ hUZ_in =
              (AlgebraicGeometry.Scheme.ΓSpecIso (Z_bar.left.presheaf.obj (Opposite.op U_Z))).inv := by
            have hself := hAffUZ.fromSpec_app_self
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE] at hself
            have heq_top : (TopologicalSpace.Opens.map hAffUZ.fromSpec.base).obj U_Z = ⊤ :=
              top_unique hUZ_in
            have hmap_eq : hAffUZ.fromSpec.appLE U_Z ⊤ hUZ_in =
                hAffUZ.fromSpec.appLE U_Z
                  ((TopologicalSpace.Opens.map hAffUZ.fromSpec.base).obj U_Z) le_rfl ≫
                  (AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op U_Z))).presheaf.map
                    (CategoryTheory.eqToHom heq_top.symm).op := by
              dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
              congr 2
            rw [hmap_eq, hself, CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp,
              ← op_comp, CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_refl, op_id,
              CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
          have htop_Q : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_Q)).appLE ⊤ ⊤ le_rfl =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_Q)).appTop := by
            rw [AlgebraicGeometry.Scheme.Hom.appTop, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
            rfl
          rw [hfrom_UZ, htop_Q, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
          change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_Z)).inv ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_Z)).hom ≫
                CommRingCat.ofHom mk_Q = CommRingCat.ofHom mk_Q
          rw [CategoryTheory.Iso.inv_hom_id_assoc]
        intro a ha
        have hmk0 : mk_Q a = 0 := by
          have h2 := congrArg (fun g : Z_bar.left.presheaf.obj (Opposite.op U_Z) ⟶ CommRingCat.of Q =>
            g.hom a) happ_l.symm
          change mk_Q a = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Q)).hom).hom
            ((l_Q.appLE V_H ⊤ hl_in_VH).hom (φ_H a)) at h2
          rw [ha, map_zero, map_zero] at h2
          exact h2
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        have hVH_WY : V_H ≤ (TopologicalSpace.Opens.map p_Y.base).obj V_Y := by
          intro x hx
          change (p_Y ≫ lift_Y).base x ∈ W_pb
          rw [hp_lift_comm]
          exact hUW hx
        have hcomm_app : (ι_H.appLE U_Z V_H le_rfl).hom (γ_U G_inc) =
            (p_Y.appLE V_Y V_H hVH_WY).hom (ρ_Y G_inc) := by
          have h1 : Γ_s₂.appLE W_pb U_Z hUW ≫ ι_H.appLE U_Z V_H le_rfl =
              (ι_H ≫ Γ_s₂).appLE W_pb V_H _ :=
            AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ _ _ _ hUW le_rfl
          have h2 : lift_Y.appLE W_pb V_Y le_rfl ≫ p_Y.appLE V_Y V_H hVH_WY =
              (p_Y ≫ lift_Y).appLE W_pb V_H _ :=
            AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ _ _ _ le_rfl hVH_WY
          have h3 : (ι_H ≫ Γ_s₂).appLE W_pb V_H
              (le_rfl.trans ((TopologicalSpace.Opens.map ι_H.base).monotone hUW)) =
              (p_Y ≫ lift_Y).appLE W_pb V_H
                (hVH_WY.trans ((TopologicalSpace.Opens.map p_Y.base).monotone le_rfl)) := by
            congr 1
            exact hp_lift_comm.symm
          have h4 := h1.trans (h3.trans h2.symm)
          have hρ_eq : ρ_Y = (lift_Y.appLE W_pb V_Y le_rfl).hom := by
            dsimp [ρ_Y]
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
          rw [hρ_eq]
          exact congrArg (fun g => g.hom G_inc) h4
        have hφ_eq : φ_H = (ι_H.appLE U_Z V_H le_rfl).hom := by
          dsimp [φ_H]
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        change φ_H (γ_U G_inc) = 0
        rw [hφ_eq, hcomm_app]
        have hG0 : ρ_Y G_inc = 0 := by
          have hmem : G_inc ∈ RingHom.ker ρ_Y := by
            rw [hKerY]
            exact Ideal.subset_span (Set.mem_singleton G_inc)
          exact hmem
        rw [hG0, map_zero]

    
    rw [hKer_γG]
    congr 1; congr 1
    change γ_U G_inc =
      (ι_bar.left.appLE U_Mμ U_Z hUZ').hom
        (awayM.hom (HomogeneousLocalization.Away.mk 𝒜_M hXμ 1 L_pt hF_mem))
    dsimp [G_inc]
    rw [map_sum]
    let S_μ : Submonoid (MvPolynomial (Fin (M + 1)) k) :=
      Submonoid.powers (MvPolynomial.X μ : MvPolynomial (Fin (M + 1)) k)
    have hf_term : ∀ r : Fin 3,
        γ_U ((fst_Z2.appLE U_Z W_pb inf_le_left).hom (ℓ_r r) *
          (snd_Z2.appLE U_P W_pb inf_le_right).hom (w_r r)) =
        (ι_bar.left.appLE U_Mμ U_Z hUZ').hom
          (awayM.hom
            (HomogeneousLocalization.fromZeroRingHom 𝒜_M S_μ
              (algebraMap k ↥(𝒜_M 0) (c_pt r)) *
            HomogeneousLocalization.mk
              (⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩ :
                HomogeneousLocalization.NumDenSameDeg 𝒜_M S_μ))) := by
      intro r
      rw [map_mul, map_mul, map_mul]
      have hfst_eval : γ_U ((fst_Z2.appLE U_Z W_pb inf_le_left).hom (ℓ_r r)) = ℓ_r r := by
        dsimp [γ_U]
        have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE Γ_s₂ fst_Z2 U_Z W_pb U_Z inf_le_left hUW
        have h1 := congrArg (fun g => g.hom (ℓ_r r)) hc
        change γ_U ((fst_Z2.appLE U_Z W_pb inf_le_left).hom (ℓ_r r)) =
          ((Γ_s₂ ≫ fst_Z2).appLE U_Z U_Z _).hom (ℓ_r r) at h1
        have hid_eq : (Γ_s₂ ≫ fst_Z2).appLE U_Z U_Z
            (hUW.trans ((TopologicalSpace.Opens.map Γ_s₂.base).monotone inf_le_left)) =
            AlgebraicGeometry.Scheme.Hom.appLE (𝟙 Z_bar.left) U_Z U_Z le_rfl := by
          congr 1
        have hid_UZ : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 Z_bar.left) U_Z U_Z le_rfl = 𝟙 _ := by
          let Xz := Z_bar.left
          let id_Z : Xz ⟶ Xz := 𝟙 Xz
          have htriv : U_Z ≤ (TopologicalSpace.Opens.map id_Z.base).obj U_Z := le_rfl
          have h1' : id_Z.appLE U_Z U_Z htriv =
              id_Z.app U_Z ≫ Xz.presheaf.map (CategoryTheory.homOfLE htriv).op := rfl
          have h2' : (id_Z.app U_Z : Xz.presheaf.obj (Opposite.op U_Z) ⟶
              Xz.presheaf.obj (Opposite.op U_Z)) = 𝟙 _ := by
            dsimp [id_Z]
          have h3' : (Xz.presheaf.map (CategoryTheory.homOfLE htriv).op :
              Xz.presheaf.obj (Opposite.op U_Z) ⟶ Xz.presheaf.obj (Opposite.op U_Z)) = 𝟙 _ :=
            (congrArg (fun m : U_Z ⟶ U_Z => Xz.presheaf.map m.op)
              (Subsingleton.elim (CategoryTheory.homOfLE htriv) (𝟙 U_Z))).trans
              (CategoryTheory.Functor.map_id Xz.presheaf (Opposite.op U_Z))
          exact h1'.trans ((congrArg₂ CategoryTheory.CategoryStruct.comp h2' h3').trans
            (CategoryTheory.Category.id_comp _))
        rw [h1, hid_eq, hid_UZ]
        rfl
      have hsnd_eval : γ_U ((snd_Z2.appLE U_P W_pb inf_le_right).hom (w_r r)) =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            Z_bar.hom.appLE ⊤ U_Z le_top).hom (c_pt r) := by
        dsimp [γ_U]
        have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE Γ_s₂ snd_Z2 U_P W_pb U_Z inf_le_right hUW
        have h1 := congrArg (fun g => g.hom (w_r r)) hc
        change γ_U ((snd_Z2.appLE U_P W_pb inf_le_right).hom (w_r r)) =
          ((Γ_s₂ ≫ snd_Z2).appLE U_P U_Z _).hom (w_r r) at h1
        have hsnd_eq : (Γ_s₂ ≫ snd_Z2).appLE U_P U_Z
            (hUW.trans ((TopologicalSpace.Opens.map Γ_s₂.base).monotone inf_le_right)) =
            (Z_bar.hom ≫ s₂).appLE U_P U_Z
              (le_top.trans ((TopologicalSpace.Opens.map Z_bar.hom.base).monotone hs₂_le)) := by
          congr 1
        rw [h1, hsnd_eq,
          ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE Z_bar.hom s₂ U_P ⊤ U_Z hs₂_le le_top]
        have hw_r_eq : w_r r = (isoAwayβ_pt.hom).hom (ξ₂_pt r) := by
          change ((isoAwayβ_pt.hom ≫
            (weilProjectiveSpaceOver k 2).left.presheaf.map
              (CategoryTheory.homOfLE (le_rfl : U_P ≤ U_P)).op)).hom (ξ₂_pt r) =
            (isoAwayβ_pt.hom).hom (ξ₂_pt r)
          have hid : CategoryTheory.homOfLE (le_rfl : U_P ≤ U_P) = 𝟙 U_P := rfl
          rw [hid, op_id, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
        rw [hw_r_eq]
        have hc_r := hc_eval r
        have hc_r' : (s₂.appLE U_P ⊤ hs₂_le).hom ((isoAwayβ_pt.hom).hom (ξ₂_pt r)) =
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom (c_pt r) := by
          have h1 := congrArg (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom) hc_r.symm
          dsimp at h1
          rw [h1]
          symm
          exact congrArg (fun φ : (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤) ⟶ _ =>
            φ.hom _) (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom_inv_id
        change (Z_bar.hom.appLE ⊤ U_Z le_top).hom ((s₂.appLE U_P ⊤ hs₂_le).hom _) = _
        rw [hc_r']
      have hsc_M : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Z_bar.hom.appLE ⊤ U_Z le_top).hom (c_pt r) =
          (ι_bar.left.appLE U_Mμ U_Z hUZ').hom
            (awayM.hom
              (HomogeneousLocalization.fromZeroRingHom 𝒜_M S_μ
                (algebraMap k ↥(𝒜_M 0) (c_pt r)))) :=
        (hProjScalarCompat M μ hXμ Z_bar.hom ι_bar.left ι_bar.w U_Z hAffUZ hUZ' (c_pt r)).symm
      have hℓ_eq : ℓ_r r =
          (ι_bar.left.appLE U_Mμ U_Z hUZ').hom
            (awayM.hom
              (HomogeneousLocalization.mk
                (⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩ :
                  HomogeneousLocalization.NumDenSameDeg 𝒜_M S_μ))) := rfl
      rw [hfst_eval, hsnd_eval, hsc_M, hℓ_eq]
      ring
    rw [Finset.sum_congr rfl fun r _ => hf_term r, ← map_sum, ← map_sum]
    congr 2
    apply HomogeneousLocalization.val_injective
    let ιC_M := algebraMap (HomogeneousLocalization 𝒜_M S_μ) (Localization S_μ)
    rw [HomogeneousLocalization.Away.val_mk]
    simp only [← HomogeneousLocalization.algebraMap_apply, map_sum, map_mul]
    have hsum_loc : ∀ r : Fin 3,
        ιC_M (HomogeneousLocalization.fromZeroRingHom 𝒜_M S_μ
          (algebraMap k ↥(𝒜_M 0) (c_pt r))) *
        ιC_M (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩) =
        Localization.mk (MvPolynomial.C (c_pt r) * L r)
          (⟨MvPolynomial.X μ ^ 1, ⟨1, rfl⟩⟩ : S_μ) := by
      intro r
      have hv1 : ιC_M (HomogeneousLocalization.fromZeroRingHom 𝒜_M S_μ
          (algebraMap k ↥(𝒜_M 0) (c_pt r))) =
          Localization.mk (MvPolynomial.C (c_pt r)) (⟨1, S_μ.one_mem⟩ : S_μ) :=
        HomogeneousLocalization.val_mk _
      have hv2 : ιC_M (HomogeneousLocalization.mk
          ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X μ, hXμ⟩, ⟨1, pow_one _⟩⟩) =
          Localization.mk (L r) (⟨MvPolynomial.X μ, ⟨1, pow_one _⟩⟩ : S_μ) :=
        HomogeneousLocalization.val_mk _
      rw [hv1, hv2, Localization.mk_mul]
      congr 1
    change (∑ r : Fin 3, ιC_M _ * ιC_M _) = _
    rw [Finset.sum_congr rfl fun r _ => hsum_loc r]
    simp only [Fin.sum_univ_three, Localization.add_mk_self]
    congr 1
    rw [← hL_sum, Fin.sum_univ_three]

  have hGlobalRange : Set.range ι_H.base =
      (((TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M L_pt) : Set Z_bar.left)ᶜ) := by
    let U_ML : (weilProjectiveSpaceOver k M).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_M L_pt
    change Set.range ι_H.base = (((TopologicalSpace.Opens.map ι_bar.left.base).obj U_ML : Set Z_bar.left)ᶜ)
    ext z
    obtain ⟨μ, hz_μ⟩ := hProjCover M (ι_bar.left.base z)
    let hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
      MvPolynomial.isHomogeneous_X k μ
    let U_Mμ : (weilProjectiveSpaceOver k M).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X μ)
    obtain ⟨U_Z, hAffUZ, hz_UZ, hUZ_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := z)
        (U := (TopologicalSpace.Opens.map ι_bar.left.base).obj U_Mμ)
        hz_μ
    have hUZ : U_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj U_Mμ := hUZ_sub
    let ℓ_μ := (ι_bar.left.appLE U_Mμ U_Z hUZ).hom
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X μ)).hom
        (HomogeneousLocalization.Away.mk 𝒜_M hXμ 1 L_pt hF_mem))
    have hKer_UZ := hLocalKer μ hXμ U_Z hAffUZ hUZ
    let V_H : F_pt.Opens := (TopologicalSpace.Opens.map ι_H.base).obj U_Z
    haveI : AlgebraicGeometry.IsAffineHom ι_H := inferInstance
    let hAffVH : AlgebraicGeometry.IsAffineOpen V_H := hAffUZ.preimage ι_H
    have hSurj_UZ : Function.Surjective (ι_H.app U_Z).hom :=
      (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl_ιH).2 U_Z hAffUZ
    let p_z : AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op U_Z)) :=
      hAffUZ.isoSpec.hom.base ⟨z, hz_UZ⟩
    have hp_z : hAffUZ.fromSpec.base p_z = z := by
      dsimp [p_z]
      rw [← hAffUZ.isoSpec_inv_ι]
      change (hAffUZ.isoSpec.hom ≫ hAffUZ.isoSpec.inv ≫ U_Z.ι).base ⟨z, hz_UZ⟩ = z
      rw [hAffUZ.isoSpec.hom_inv_id_assoc]
      rfl
    have hinj_fromUZ : Function.Injective hAffUZ.fromSpec.base := by
      rw [← hAffUZ.isoSpec_inv_ι]
      intro q₁ q₂ hq
      have hq' : U_Z.ι.base (hAffUZ.isoSpec.inv.base q₁) = U_Z.ι.base (hAffUZ.isoSpec.inv.base q₂) := hq
      have hsub : hAffUZ.isoSpec.inv.base q₁ = hAffUZ.isoSpec.inv.base q₂ := Subtype.ext hq'
      have hiso := congrArg hAffUZ.isoSpec.hom.base hsub
      change (hAffUZ.isoSpec.inv ≫ hAffUZ.isoSpec.hom).base q₁ =
        (hAffUZ.isoSpec.inv ≫ hAffUZ.isoSpec.hom).base q₂ at hiso
      rw [hAffUZ.isoSpec.inv_hom_id] at hiso
      exact hiso
    have hz_range_iff : z ∈ Set.range ι_H.base ↔ ℓ_μ ∈ p_z.asIdeal := by
      constructor
      · rintro ⟨w, rfl⟩
        have hw_VH : w ∈ V_H := hz_UZ
        let q_w := hAffVH.isoSpec.hom.base ⟨w, hw_VH⟩
        have hqw : hAffVH.fromSpec.base q_w = w := by
          dsimp [q_w]
          rw [← hAffVH.isoSpec_inv_ι]
          change (hAffVH.isoSpec.hom ≫ hAffVH.isoSpec.inv ≫ V_H.ι).base ⟨w, hw_VH⟩ = w
          rw [hAffVH.isoSpec.hom_inv_id_assoc]
          rfl
        have hp_eq : (AlgebraicGeometry.Spec.map (ι_H.app U_Z)).base q_w = p_z := by
          apply hinj_fromUZ
          change (AlgebraicGeometry.Spec.map (ι_H.app U_Z) ≫ hAffUZ.fromSpec).base q_w =
            hAffUZ.fromSpec.base p_z
          have hcomm_H := hFromSpecComm ι_H hAffUZ hAffVH le_rfl
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, ← hcomm_H]
          change ι_H.base (hAffVH.fromSpec.base q_w) = _
          rw [hqw, hp_z]
        rw [← hp_eq]
        have hℓ0 : (ι_H.app U_Z).hom ℓ_μ = 0 := by
          have hmem : ℓ_μ ∈ RingHom.ker (ι_H.app U_Z).hom := by
            rw [hKer_UZ]
            exact Ideal.subset_span (Set.mem_singleton ℓ_μ)
          exact hmem
        change (ι_H.app U_Z).hom ℓ_μ ∈ q_w.asIdeal
        rw [hℓ0]
        exact q_w.asIdeal.zero_mem
      · intro hℓ_mem
        have hp_zero : p_z ∈ PrimeSpectrum.zeroLocus (Ideal.span ({ℓ_μ} : Set _) : Set _) := by
          intro x hx
          change x ∈ Ideal.span ({ℓ_μ} : Set _) at hx
          rw [Ideal.mem_span_singleton] at hx
          rcases hx with ⟨r, rfl⟩
          exact (p_z : PrimeSpectrum _).asIdeal.mul_mem_right r hℓ_mem
        let q_w := (Ideal.primeSpectrumOrderIsoZeroLocusOfSurj
          (ι_H.app U_Z).hom hSurj_UZ hKer_UZ).symm ⟨p_z, hp_zero⟩
        have hqw_map : (AlgebraicGeometry.Spec.map (ι_H.app U_Z)).base q_w = p_z := by
          have h := (Ideal.primeSpectrumOrderIsoZeroLocusOfSurj
            (ι_H.app U_Z).hom hSurj_UZ hKer_UZ).apply_symm_apply ⟨p_z, hp_zero⟩
          exact congrArg Subtype.val h
        refine ⟨hAffVH.fromSpec.base q_w, ?_⟩
        change (hAffVH.fromSpec ≫ ι_H).base q_w = z
        rw [hFromSpecComm ι_H hAffUZ hAffVH le_rfl, ← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        change hAffUZ.fromSpec.base ((AlgebraicGeometry.Spec.map (ι_H.app U_Z)).base q_w) = z
        rw [hqw_map, hp_z]
    have hz_basic_iff : z ∈ Z_bar.left.basicOpen ℓ_μ ↔ ℓ_μ ∉ p_z.asIdeal := by
      rw [← hp_z]
      change p_z ∈ (TopologicalSpace.Opens.map hAffUZ.fromSpec.base).obj
        (Z_bar.left.basicOpen ℓ_μ) ↔ _
      rw [hAffUZ.fromSpec_preimage_basicOpen]
      rfl
    have hbasic_eq : Z_bar.left.basicOpen ℓ_μ =
        U_Z ⊓ (TopologicalSpace.Opens.map ι_bar.left.base).obj U_ML := by
      let s_L : ↑((weilProjectiveSpaceOver k M).left.presheaf.obj (Opposite.op U_Mμ)) :=
        (AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X μ)).hom
          (HomogeneousLocalization.Away.mk 𝒜_M hXμ 1 L_pt hF_mem)
      have hres : Z_bar.left.basicOpen ℓ_μ =
          U_Z ⊓ Z_bar.left.basicOpen ((ι_bar.left.app U_Mμ).hom s_L) := by
        dsimp [ℓ_μ, AlgebraicGeometry.Scheme.Hom.appLE]
        exact Z_bar.left.basicOpen_res _ (CategoryTheory.homOfLE hUZ).op
      rw [hres, ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι_bar.left s_L,
        hProjBasicOpenAway M μ hXμ L_pt hF_mem]
      ext x
      exact ⟨fun hx => ⟨hx.1, hx.2.2⟩, fun hx => ⟨hx.1, hUZ hx.1, hx.2⟩⟩
    rw [hz_range_iff]
    change ℓ_μ ∈ p_z.asIdeal ↔
      z ∉ ((TopologicalSpace.Opens.map ι_bar.left.base).obj U_ML : Set Z_bar.left)
    have hnot_basic : ℓ_μ ∈ p_z.asIdeal ↔ z ∉ Z_bar.left.basicOpen ℓ_μ := by
      rw [hz_basic_iff, Classical.not_not]
    rw [hnot_basic, hbasic_eq]
    exact ⟨fun h hzL => h ⟨hz_UZ, hzL⟩, fun h ⟨_, hzL⟩ => h hzL⟩

  refine ⟨?_, ?_, ⟨hCl_ιH, hF_mem, hGlobalRange, hLocalKer⟩⟩
  · exact ⟨x_pt, R'_1, B'_1, u_1, e_B1, h_1, ψ_B1, v_1, e_Y1, q_1,
      hx_f0, hx_sm, he_B1_et, he_Y1_et, hq_1_et, hψ_B1_X, hψ_B1_et, he_B1_hom,
      hh1_u1, hX_v1, hh1_v1, hComm_1, hpt_1⟩
  · refine ⟨x_pt, hx_f0, hx_sm, fun pt => ?_⟩
    have hf0_pt : f₀.left.base (x_pt.base pt) = s_pt.base pt := by
      change (x_pt ≫ f₀.left).base pt = s_pt.base pt
      rw [hx_f0]
    exact ⟨hf0_pt, R'_1, u_1, e_B1, h_1, AlgebraicGeometry.Spec B'_1, v_1, e_Y1, q_1,
      he_B1_et, he_Y1_et, hq_1_et, (hpt_1 pt).1, (hpt_1 pt).2,
      ⟨ψ_B1, hψ_B1_X, hψ_B1_et, he_B1_hom⟩, hh1_u1, hX_v1, hh1_v1, hComm_1⟩

theorem weil_split_quadric_cone_etale_stalk_domain_and_nodal_reduced (k : Type u) [Field k]
    (hKrullDom : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (ϖ : A),
      ϖ ∈ IsLocalRing.maximalIdeal A →
      (∀ x : A, ϖ * x = 0 → x = 0) →
      IsDomain (A ⧸ Ideal.span ({ϖ} : Set A)) →
      IsDomain A)
    (hEtPolyDom : ∀ (d : ℕ) (K : Type u) [Field K]
        (S : Type u) [CommRing S] [Algebra (MvPolynomial (Fin d) K) S]
        [Algebra.Etale (MvPolynomial (Fin d) K) S]
        (q : Ideal S) [q.IsPrime],
      IsDomain (Localization.AtPrime q)) :
    (∀ (m : ℕ), 1 ≤ m →
      let A_cone := MvPolynomial (Fin (m + 1) × Fin 2) k ⧸
        Ideal.span {∑ j : Fin (m + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))}
      ∀ (D : Type u) [CommRing D] [Algebra A_cone D] [Algebra.Etale A_cone D]
        (q : Ideal D) [q.IsPrime],
        (∀ idx : Fin (m + 1) × Fin 2,
          algebraMap A_cone D (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ q) →
        IsDomain (Localization.AtPrime q)) ∧
    (let A_node := MvPolynomial (Fin 2) k ⧸
        Ideal.span ({MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)} : Set (MvPolynomial (Fin 2) k))
      ∀ (D : Type u) [CommRing D] [Algebra A_node D] [Algebra.Etale A_node D]
        (q : Ideal D) [q.IsPrime],
        IsReduced (Localization.AtPrime q)) :=
by
 have hKrull_pkg : True ∧ _ := ⟨trivial, hKrullDom⟩
 have hEt_pkg : True ∧ _ := ⟨trivial, hEtPolyDom⟩
 clear hKrullDom hEtPolyDom
 have hDescent_pkg : True ∧ (∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
    (ϖ : R) (hϖ_reg : ∀ r : R, ϖ * r = 0 → r = 0)
    (B : Type u) [CommRing B]
    (π : R →+* B) (hπ_surj : Function.Surjective π)
    (hπ_ker : RingHom.ker π = Ideal.span ({ϖ} : Set R))
    (D : Type u) [CommRing D] [Algebra R D] [Algebra.Etale R D]
    (q : Ideal D) [q.IsPrime]
    (hϖ_mem : algebraMap R D ϖ ∈ q)
    (hQuotDom : ∀ (D' : Type u) [CommRing D'] [Algebra B D'] [Algebra.Etale B D']
      (q' : Ideal D') [q'.IsPrime],
      (∀ r : R, algebraMap R D r ∈ q → algebraMap B D' (π r) ∈ q') →
      IsDomain (Localization.AtPrime q')),
    IsDomain (Localization.AtPrime q)) := ⟨trivial, by
  intro R _ _ ϖ hϖ_reg B _ π hπ_surj hπ_ker D _ _ _ q _ hϖ_mem hQuotDom
  let A : Type u := Localization.AtPrime q
  have : Algebra.FiniteType R D := inferInstance
  have : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing R D
  have : IsNoetherianRing A := IsLocalization.isNoetherianRing q.primeCompl A ‹_›
  let ϖ_D : D := algebraMap R D ϖ
  let ϖ_A : A := algebraMap D A ϖ_D
  have hϖ_max : ϖ_A ∈ IsLocalRing.maximalIdeal A :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff A q ϖ_D).mpr hϖ_mem
  have hϖ_A_eq : ϖ_A = algebraMap R A ϖ :=
    (IsScalarTower.algebraMap_apply R D A ϖ).symm
  have hϖ_A_reg : ∀ x : A, ϖ_A * x = 0 → x = 0 := by
    have : Module.Flat R D := inferInstance
    have : Module.Flat D A := IsLocalization.flat A q.primeCompl
    have : Module.Flat R A := Module.Flat.trans R D A
    let μ : R →ₗ[R] R := LinearMap.mulLeft R ϖ
    have hμ_inj : Function.Injective μ := by
      intro r₁ r₂ h
      apply sub_eq_zero.mp
      apply hϖ_reg (r₁ - r₂)
      change ϖ * r₁ = ϖ * r₂ at h
      rw [mul_sub, h, sub_self]
    have hlT_inj : Function.Injective (μ.lTensor A) :=
      Module.Flat.lTensor_preserves_injective_linearMap μ hμ_inj
    intro x hx
    have h0 : (TensorProduct.rid R A) ((μ.lTensor A) (x ⊗ₜ[R] (1 : R))) = 0 := by
      change (TensorProduct.rid R A) (x ⊗ₜ[R] (ϖ * 1)) = 0
      rw [mul_one, TensorProduct.rid_tmul, Algebra.smul_def, ← hϖ_A_eq]
      exact hx
    have h_tmul : x ⊗ₜ[R] (1 : R) = 0 :=
      hlT_inj ((TensorProduct.rid R A).injective (h0.trans (map_zero _).symm))
    have hx1 : (TensorProduct.rid R A) (x ⊗ₜ[R] (1 : R)) = 0 := by
      rw [h_tmul, map_zero]
    rwa [TensorProduct.rid_tmul, one_smul] at hx1
  letI : Algebra R B := π.toAlgebra
  let D' : Type u := TensorProduct R B D
  have : Algebra.Etale B D' := Algebra.Etale.baseChange R D B
  let φ_D : D →+* D' := (Algebra.TensorProduct.includeRight (R := R) (A := B) (B := D)).toRingHom
  have hφ_alg : ∀ r : R, φ_D (algebraMap R D r) = algebraMap B D' (π r) := by
    intro r
    exact ((Algebra.TensorProduct.includeRight (R := R) (A := B) (B := D)).commutes r).trans
      ((Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := B) (B := D)).commutes r).symm
  have hφ_surj : Function.Surjective φ_D := by
    intro w
    refine TensorProduct.induction_on (motive := fun w => ∃ a, φ_D a = w) w ?_ (fun b d => ?_)
      (fun w₁ w₂ ih₁ ih₂ => ?_)
    · exact ⟨0, map_zero φ_D⟩
    · obtain ⟨r, rfl⟩ := hπ_surj b
      refine ⟨algebraMap R D r * d, ?_⟩
      rw [map_mul, hφ_alg r]
      change ((π r) ⊗ₜ[R] (1 : D)) * ((1 : B) ⊗ₜ[R] d) = (π r) ⊗ₜ[R] d
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    · obtain ⟨d₁, rfl⟩ := ih₁
      obtain ⟨d₂, rfl⟩ := ih₂
      exact ⟨d₁ + d₂, map_add φ_D d₁ d₂⟩
  let I_D : Ideal D := Ideal.span ({ϖ_D} : Set D)
  have hφ_ϖ : φ_D ϖ_D = 0 := by
    change φ_D (algebraMap R D ϖ) = 0
    rw [hφ_alg ϖ]
    have hϖ_ker : ϖ ∈ RingHom.ker π := by
      rw [hπ_ker]
      exact Ideal.subset_span rfl
    rw [RingHom.mem_ker.mp hϖ_ker, map_zero]
  have hφ_ker : RingHom.ker φ_D = I_D := by
    apply le_antisymm
    · intro d hd
      let Q_D : Type u := D ⧸ I_D
      let θ : R →+* Q_D := (Ideal.Quotient.mk I_D).comp (algebraMap R D)
      have hker_θ : RingHom.ker π ≤ RingHom.ker θ := by
        rw [hπ_ker, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change Ideal.Quotient.mk I_D ϖ_D = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      let ψ_B : B →+* Q_D :=
        (Ideal.Quotient.lift (RingHom.ker π) θ hker_θ).comp
          (RingHom.quotientKerEquivOfSurjective hπ_surj).symm.toRingHom
      have hψ_B_apply : ∀ r : R, ψ_B (π r) = θ r := by
        intro r
        have heq : (RingHom.quotientKerEquivOfSurjective hπ_surj).symm (π r) =
            Ideal.Quotient.mk (RingHom.ker π) r :=
          (RingHom.quotientKerEquivOfSurjective hπ_surj).injective (by simp)
        change Ideal.Quotient.lift (RingHom.ker π) θ hker_θ
          ((RingHom.quotientKerEquivOfSurjective hπ_surj).symm (π r)) = θ r
        rw [heq]
        rfl
      letI : Algebra R Q_D := θ.toAlgebra
      let ψ_B_alg : B →ₐ[R] Q_D := ⟨ψ_B, hψ_B_apply⟩
      let mk_alg : D →ₐ[R] Q_D := ⟨Ideal.Quotient.mk I_D, fun _ => rfl⟩
      let Φ : D' →ₐ[R] Q_D := Algebra.TensorProduct.productMap ψ_B_alg mk_alg
      have hΦ_d : Ideal.Quotient.mk I_D d = 0 := by
        have h1 : Φ (φ_D d) = Ideal.Quotient.mk I_D d := by
          change Φ ((1 : B) ⊗ₜ[R] d) = Ideal.Quotient.mk I_D d
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
          rfl
        rw [← h1, RingHom.mem_ker.mp hd, map_zero]
