          t.pt.obj.map (Opposite.op g) ((m.hom.app opU) s₀) at hnat_m
        rw [← hnat_m]
        exact congrArg (fun (w : D.obj j ⟶ t.pt) => (w.hom.app (Opposite.op V)) ⟨_, hj⟩) (hm j)
    let isColim_c : CategoryTheory.Limits.IsColimit c_colim :=
      { desc := fun t => Classical.choose (hDescEx t)
        fac := fun t j => (Classical.choose_spec (hDescEx t)).1 j
        uniq := fun t m hm => (Classical.choose_spec (hDescEx t)).2 m hm }
    refine ⟨Idx, instSmall, instFilt, D, c_colim, rfl, ⟨isColim_c⟩, hMono_c, fun j => ?_⟩
