    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton.mp hg_span₀
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.mem_span_singleton.mpr ⟨h, by rw [hg, hh]; ring⟩
  letI : Algebra A_node (P₁ × P₁) := ι_node.toAlgebra
  let W : Type u := TensorProduct A_node (P₁ × P₁) D
  let ι_D : D →+* W :=
    (Algebra.TensorProduct.includeRight (R := A_node) (A := P₁ × P₁) (B := D)).toRingHom
  have hιD_inj : Function.Injective ι_D := by
    have : Module.Flat A_node D := inferInstance
