      rw [hrange_eq, AlgebraicGeometry.Scheme.Pullback.range_fst, (hAff α).range_fromSpec]
    · intro α α' res_L res_R hΩ
      let C : Type u := ↑(W.left.presheaf.obj (Opposite.op (U_chart α ⊓ U_chart α')))
      let _ : Algebra Ω C := (res_L.comp (algebraMap Ω (B α))).toAlgebra
      have hAff_ov : AlgebraicGeometry.IsAffineOpen (U_chart α ⊓ U_chart α') := by
