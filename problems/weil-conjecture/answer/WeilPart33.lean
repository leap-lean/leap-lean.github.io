    have : Module.Flat B₂ D := inferInstance
    have : Module.Flat D R_loc := IsLocalization.flat R_loc q.primeCompl
    have : Module.Flat B₂ R_loc := Module.Flat.trans B₂ D R_loc
    let f_lin : B₂ →ₗ[B₂] P₂ := Algebra.linearMap B₂ P₂
    have hf_inj : Function.Injective f_lin := hφ_inj
    have hrT_inj : Function.Injective (f_lin.rTensor R_loc) :=
