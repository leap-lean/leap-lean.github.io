    change ℓ • CategoryTheory.CategoryStruct.id (Shf.obj (W_left.obj (ℱ.cohomologyPresheaf b))) = 0
    rw [← Shf.map_id, ← CategoryTheory.Functor.map_nsmul, hWhisk0,
      CategoryTheory.Functor.map_zero]
  · intro hAdd q hq hInjPush ⟨e₀, he₀_nat⟩ hStep hSubPush hRPush
    let 𝒞_X := CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}
    let 𝒞_B := CategoryTheory.Sheaf B.smallEtaleTopology AddCommGrpCat.{u}
    let Fℤ_X : 𝒞_X :=
      (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
