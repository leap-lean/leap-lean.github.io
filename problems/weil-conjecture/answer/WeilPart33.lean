theorem weil_aff_cd_affineLine_constructible_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ q : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (hq : 1 < q)
    (hZeroDim : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType Z.hom] [AlgebraicGeometry.QuasiCompact Z.hom],
      topologicalKrullDim Z.left ≤ (0 : WithBot ℕ∞) →
      ∀ (𝒢 : CategoryTheory.Sheaf Z.left.smallEtaleTopology AddCommGrpCat.{u})
        (r : ℕ), 1 ≤ r → Subsingleton (𝒢.H r))
    (ℬ : CategoryTheory.Sheaf (weilAffineSpaceOver k 1).left.smallEtaleTopology AddCommGrpCat.{u})
    (hℬ : WeilIsConstructibleModPrimeSheaf ℓ (weilAffineSpaceOver k 1).left ℬ) :
    Subsingleton (ℬ.H q) :=
by
  classical
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ
