      intro F
      induction F using MvPolynomial.induction_on with
      | C c =>
        refine ⟨MvPolynomial.C c, 0, ?_⟩
        rw [hι01_C, map_zero, mul_zero, add_zero]
      | add p₁ p₂ ih₁ ih₂ =>
        obtain ⟨A₀, A₁, hA⟩ := ih₁
        obtain ⟨C₀, C₁, hC⟩ := ih₂
        refine ⟨A₀ + C₀, A₁ + C₁, ?_⟩
        rw [map_add, hA, hC, ← map_add]
        congr 1
        simp only [map_add]
        ring
      | mul_X p i ih =>
        obtain ⟨A₀, A₁, hA⟩ := ih
        fin_cases i
        · refine ⟨A₀ * s, A₁ * s, ?_⟩
          change mk_B2 (p * MvPolynomial.X 0) = _
          rw [map_mul, hA, ← map_mul]
          congr 1
          have hs0 : ι01 s = MvPolynomial.X 0 := hι01_X 0
          simp only [map_mul, hs0]
          ring
        · refine ⟨A₀ * t, A₁ * t, ?_⟩
          change mk_B2 (p * MvPolynomial.X 1) = _
          rw [map_mul, hA, ← map_mul]
          congr 1
          have ht1 : ι01 t = MvPolynomial.X 1 := hι01_X 1
          simp only [map_mul, ht1]
          ring
        · refine ⟨A₁ * (s * t), A₀, ?_⟩
          change mk_B2 (p * MvPolynomial.X 2) = _
          rw [map_mul, hA]
          calc mk_B2 (ι01 A₀ + MvPolynomial.X 2 * ι01 A₁) * mk_B2 (MvPolynomial.X 2)
              = mk_B2 (MvPolynomial.X 2 * ι01 A₀) +
                mk_B2 (MvPolynomial.X 2 ^ 2) * mk_B2 (ι01 A₁) := by
                  simp only [map_add, map_mul, pow_two]; ring
            _ = mk_B2 (ι01 (A₁ * (s * t)) + MvPolynomial.X 2 * ι01 A₀) := by
                  rw [hX2_sq, ← map_mul, ← map_add]
                  congr 1
                  simp only [map_mul]
                  ring
