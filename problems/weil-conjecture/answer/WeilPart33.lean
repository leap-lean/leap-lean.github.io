      have hcomp_sch : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (f_C₀.comp ψ.toRingHom))) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
        exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
          hf_sch hψ_sch
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mp hcomp_sch
    have hj_et : j_κ.Etale := by
      have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      have h1 : (CategoryTheory.Limits.pushout.inl
          (CommRingCat.ofHom φ₀) (CommRingCat.ofHom (f_C₀.comp ψ.toRingHom))).hom.Etale :=
        RingHom.Etale.isStableUnderBaseChange.pushout_inl RingHom.Etale.respectsIso
          (CommRingCat.ofHom φ₀) (CommRingCat.ofHom (f_C₀.comp ψ.toRingHom)) hfψ_et
      have h1_sch : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map
            (CategoryTheory.Limits.pushout.inl
              (CommRingCat.ofHom φ₀) (CommRingCat.ofHom (f_C₀.comp ψ.toRingHom)))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr h1
      let e_po := hPush.isoPushout
      have heq_j : CommRingCat.ofHom j_κ =
          CategoryTheory.Limits.pushout.inl
            (CommRingCat.ofHom φ₀) (CommRingCat.ofHom (f_C₀.comp ψ.toRingHom)) ≫ e_po.inv := by
        rw [← hPush.inl_isoPushout_inv]
      have hj_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_κ)) := by
        rw [heq_j, AlgebraicGeometry.Spec.map_comp]
        exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
          inferInstance h1_sch
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hj_sch
    let _ : Algebra κ B_κ := j_κ.toAlgebra
    have _ : Algebra.Etale κ B_κ := RingHom.etale_algebraMap.mp hj_et
    have hj_ft : j_κ.FiniteType := RingHom.finiteType_algebraMap.mpr inferInstance
    have hC_ft : (Polynomial.C : B_κ →+* Polynomial B_κ).FiniteType :=
      RingHom.finiteType_algebraMap.mpr inferInstance
    refine ⟨(AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr (hC_ft.comp hj_ft), ?_⟩
    change topologicalKrullDim (PrimeSpectrum (Polynomial B_κ)) ≤ (1 : WithBot ℕ∞)
    rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
