      have hCl_g : IsClosed (Set.range ⇑g_left.base) := g_left.isClosedMap.isClosed_range
      have hUnion : (⇑iY₀.base '' ((U₂ : Set ↥Y₀)ᶜ)) ∪ Set.range ⇑g_left.base = Set.univ := by
        refine Set.eq_univ_of_forall fun x => ?_
        obtain ⟨u, rfl⟩ := iY₀.surjective x
        by_cases hu : u ∈ U₂
        · right
