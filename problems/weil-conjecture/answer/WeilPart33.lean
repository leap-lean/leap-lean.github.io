    have hMap_eq : (TopologicalSpace.Opens.map ι_line.left.base).obj U₂_sm = U₀ := by
      ext x
      change x ∈ ι_line.left.base ⁻¹' (U₂_sm : Set _) ↔ x ∈ (U₀ : Set _)
      rw [hU₂_eq, Set.preimage_compl, hPreim_disc, compl_compl]
    exact ⟨U₂_sm, hU₂_eq, hSm_g₂ U₂_sm hU₂_le, hSm_f₀_open U₂_sm U₀ hU₂_le hMap_eq⟩

theorem weil_ring_etale_derivation_and_submersive_jacobian (R : Type u) [CommRing R] (d : ℕ)
    (C : Type u) [CommRing C] [Algebra R C]
    (ψ : MvPolynomial (Fin d) R →+* C)
    (hψ_alg : ψ.comp MvPolynomial.C = algebraMap R C)
    (hψ_et : ψ.Etale) :
    (∃ der_C : Fin d → Derivation R C C,
      (∀ (i : Fin d) (f : MvPolynomial (Fin d) R), der_C i (ψ f) = ψ (MvPolynomial.pderiv i f)) ∧
      (∀ (M : Type u) [AddCommGroup M] [Module C M] [Module R M] [IsScalarTower R C M]
         (E : Derivation R C M) (c : C),
        E c = ∑ i : Fin d, (der_C i c) • E (ψ (MvPolynomial.X i)))) ∧
    (∀ (der_C : Fin d → Derivation R C C),
      (∀ (i : Fin d) (f : MvPolynomial (Fin d) R), der_C i (ψ f) = ψ (MvPolynomial.pderiv i f)) →
      ∀ (z : Fin d → C),
        let Δ_z : C := Matrix.det (Matrix.of fun i j : Fin d => der_C j (z i))
        (MvPolynomial.eval₂Hom
          ((algebraMap C (Localization.Away Δ_z)).comp (algebraMap R C))
          (fun i : Fin d => algebraMap C (Localization.Away Δ_z) (z i))).Etale) ∧
    (∀ (n : ℕ) (der_C : Fin d → Derivation R C C),
      (∀ (i : Fin d) (f : MvPolynomial (Fin d) R), der_C i (ψ f) = ψ (MvPolynomial.pderiv i f)) →
      (∀ (F : Fin d → MvPolynomial (Fin n) C) (g_extra : MvPolynomial (Fin n) C),
        let Δ_F : MvPolynomial (Fin n) C :=
          Matrix.det (Matrix.of fun i j : Fin d => weilMvPolyMapCoeffs (der_C j) (F i))
        let δ : MvPolynomial (Fin n) C := Δ_F * g_extra
        let I_F : Ideal (MvPolynomial (Fin n) C) := Ideal.span (Set.range F)
        (((algebraMap (MvPolynomial (Fin n) C ⧸ I_F)
            (Localization.Away (Ideal.Quotient.mk I_F δ))).comp
          (Ideal.Quotient.mk I_F)).comp (MvPolynomial.map (algebraMap R C))).Etale) ∧
      (1 ≤ d → ∀ (G : MvPolynomial (Fin n) C) (i_0 : Fin d),
        let I_G : Ideal (MvPolynomial (Fin n) C) :=
          Ideal.span ({G} : Set (MvPolynomial (Fin n) C))
        RingHom.IsStandardSmoothOfRelativeDimension (d - 1)
          (((algebraMap (MvPolynomial (Fin n) C ⧸ I_G)
              (Localization.Away (Ideal.Quotient.mk I_G (weilMvPolyMapCoeffs (der_C i_0) G)))).comp
            (Ideal.Quotient.mk I_G)).comp (MvPolynomial.map (algebraMap R C))))) :=
by
  have hMC_coeff : ∀ {σ : Type} [DecidableEq σ] (D : C → C) (hD0 : D 0 = 0)
      (f : MvPolynomial σ C) (m : σ →₀ ℕ),
      (weilMvPolyMapCoeffs D f).coeff m = D (f.coeff m) := by
    intro σ _ D hD0 f m
    unfold weilMvPolyMapCoeffs
    rw [MvPolynomial.coeff_sum]
    simp_rw [MvPolynomial.coeff_monomial]
    by_cases hm : m ∈ f.support
    · rw [Finset.sum_eq_single m
        (fun b _ hbm => by simp [hbm])
        (fun h => absurd hm h)]
      simp
    · rw [Finset.sum_eq_zero (fun b hb => by
        have hbm : b ≠ m := fun h => hm (h ▸ hb)
        simp [hbm])]
      have hfm : f.coeff m = 0 := Classical.not_not.mp (mt MvPolynomial.mem_support_iff.mpr hm)
      rw [hfm, hD0]

  have hMC_add : ∀ {σ : Type} [DecidableEq σ] (D : Derivation R C C) (f g : MvPolynomial σ C),
      weilMvPolyMapCoeffs D (f + g) = weilMvPolyMapCoeffs D f + weilMvPolyMapCoeffs D g := by
    intro σ _ D f g
    apply MvPolynomial.ext
    intro m
    rw [hMC_coeff D (map_zero D), MvPolynomial.coeff_add, MvPolynomial.coeff_add,
      hMC_coeff D (map_zero D), hMC_coeff D (map_zero D), map_add]

  have hMC_sub : ∀ {σ : Type} [DecidableEq σ] (D : Derivation R C C) (f g : MvPolynomial σ C),
      weilMvPolyMapCoeffs D (f - g) = weilMvPolyMapCoeffs D f - weilMvPolyMapCoeffs D g := by
    intro σ _ D f g
    apply MvPolynomial.ext
    intro m
    rw [hMC_coeff D (map_zero D), MvPolynomial.coeff_sub, MvPolynomial.coeff_sub,
      hMC_coeff D (map_zero D), hMC_coeff D (map_zero D), map_sub]

  have hMC_monomial : ∀ {σ : Type} [DecidableEq σ] (D : Derivation R C C) (s : σ →₀ ℕ) (c : C),
      weilMvPolyMapCoeffs D (MvPolynomial.monomial s c) = MvPolynomial.monomial s (D c) := by
    intro σ _ D s c
    apply MvPolynomial.ext
    intro m
    rw [hMC_coeff D (map_zero D), MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial]
    split_ifs <;> simp

  have hMC_C : ∀ {σ : Type} [DecidableEq σ] (D : Derivation R C C) (c : C),
      weilMvPolyMapCoeffs D (MvPolynomial.C c : MvPolynomial σ C) = MvPolynomial.C (D c) := by
    intro σ _ D c
    apply MvPolynomial.ext
    intro m
    rw [hMC_coeff D (map_zero D), MvPolynomial.coeff_C, MvPolynomial.coeff_C]
    split_ifs <;> simp

  have hMC_X : ∀ {σ : Type} [DecidableEq σ] (D : Derivation R C C) (i : σ),
      weilMvPolyMapCoeffs D (MvPolynomial.X i : MvPolynomial σ C) = 0 := by
    intro σ _ D i
    apply MvPolynomial.ext
    intro m
    rw [hMC_coeff D (map_zero D), MvPolynomial.coeff_X', MvPolynomial.coeff_zero]
    split_ifs <;> simp

  have hMC_rename : ∀ {σ τ : Type} [DecidableEq σ] [DecidableEq τ]
      (D : Derivation R C C) (ι : σ → τ) (G : MvPolynomial σ C),
      weilMvPolyMapCoeffs D (MvPolynomial.rename ι G) =
        MvPolynomial.rename ι (weilMvPolyMapCoeffs D G) := by
    intro σ τ _ _ D ι G
    refine MvPolynomial.induction_on' G (fun m c => ?_) (fun P Q hP hQ => ?_)
    · rw [MvPolynomial.rename_monomial, hMC_monomial, hMC_monomial, MvPolynomial.rename_monomial]
    · rw [map_add, hMC_add, hP, hQ, hMC_add, map_add]

  have hStdSmooth : ∀ (R₀ : Type u) [CommRing R₀] (S₀ : Type u) [CommRing S₀] (k : ℕ)
      (f₀ : R₀ →+* S₀) (g₀ : MvPolynomial (Fin k) R₀ →+* S₀),
      g₀.Etale → g₀.comp MvPolynomial.C = f₀ →
      RingHom.IsStandardSmoothOfRelativeDimension k f₀ := by
    intro R₀ _ S₀ _ k f₀ g₀ hg₀_et hg₀_comp
    letI : Algebra R₀ S₀ := f₀.toAlgebra
    letI : Algebra (MvPolynomial (Fin k) R₀) S₀ := g₀.toAlgebra
    haveI : IsScalarTower R₀ (MvPolynomial (Fin k) R₀) S₀ :=
      IsScalarTower.of_algebraMap_eq fun r => by
        change f₀ r = g₀ (MvPolynomial.C r)
        exact (RingHom.congr_fun hg₀_comp r).symm
    haveI : Algebra.Etale (MvPolynomial (Fin k) R₀) S₀ := RingHom.etale_algebraMap.mp hg₀_et
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 (MvPolynomial (Fin k) R₀) S₀ :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    haveI : Algebra.IsStandardSmoothOfRelativeDimension
        (Nat.card (Fin k)) R₀ (MvPolynomial (Fin k) R₀) :=
      Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial R₀ (Fin k)
    have h_tr : Algebra.IsStandardSmoothOfRelativeDimension
        (0 + Nat.card (Fin k)) R₀ S₀ :=
      Algebra.IsStandardSmoothOfRelativeDimension.trans
        (Nat.card (Fin k)) 0 R₀ (MvPolynomial (Fin k) R₀) S₀
    have hcard : 0 + Nat.card (Fin k) = k := by simp
    rw [hcard] at h_tr
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap k).mpr h_tr

  have hS2 : ∀ (R₀ : Type u) [CommRing R₀] (A : Type u) [CommRing A] [Algebra R₀ A]
      (ψ₀ : MvPolynomial (Fin d) R₀ →+* A)
      (_ : ψ₀.comp MvPolynomial.C = algebraMap R₀ A)
      (_ : ψ₀.Etale),
      (Algebra.FormallySmooth R₀ A ∧ Algebra.FinitePresentation R₀ A) ∧
      (∃ b_A : Module.Basis (Fin d) A Ω[A⁄R₀],
        (∀ i : Fin d, b_A i = KaehlerDifferential.D R₀ A (ψ₀ (MvPolynomial.X i))) ∧
        (∀ (der_A : Fin d → Derivation R₀ A A),
          (∀ (i : Fin d) (f : MvPolynomial (Fin d) R₀),
            der_A i (ψ₀ f) = ψ₀ (MvPolynomial.pderiv i f)) →
          ∀ a : A, KaehlerDifferential.D R₀ A a = ∑ j : Fin d, (der_A j a) • b_A j)) ∧
      (∃ der_A : Fin d → Derivation R₀ A A,
        (∀ (i : Fin d) (f : MvPolynomial (Fin d) R₀),
          der_A i (ψ₀ f) = ψ₀ (MvPolynomial.pderiv i f)) ∧
        (∀ (M : Type u) [AddCommGroup M] [Module A M] [Module R₀ M] [IsScalarTower R₀ A M]
           (E : Derivation R₀ A M) (a : A),
          E a = ∑ i : Fin d, (der_A i a) • E (ψ₀ (MvPolynomial.X i)))) := by
    intro R₀ _ A _ _ ψ₀ hψ₀_alg hψ₀_et
    let P := MvPolynomial (Fin d) R₀
    letI : Algebra P A := ψ₀.toAlgebra
    have hψ₀_eq : algebraMap P A = ψ₀ := rfl
    haveI : IsScalarTower R₀ P A := IsScalarTower.of_algebraMap_eq fun r => by
      change algebraMap R₀ A r = ψ₀ (MvPolynomial.C r)
      exact (RingHom.congr_fun hψ₀_alg r).symm
    haveI : Algebra.Etale P A := RingHom.etale_algebraMap.mp hψ₀_et
    haveI : Algebra.FormallyEtale P A := Algebra.Etale.formallyEtale
    haveI : Algebra.FinitePresentation P A := Algebra.Etale.finitePresentation
    have hSm_A : Algebra.FormallySmooth R₀ A := Algebra.FormallySmooth.comp R₀ P A
    have hFP_A : Algebra.FinitePresentation R₀ A := Algebra.FinitePresentation.trans R₀ P A
    let b_P : Module.Basis (Fin d) P Ω[P⁄R₀] := KaehlerDifferential.mvPolynomialBasis R₀ (Fin d)
    let e_Ω : TensorProduct P A Ω[P⁄R₀] ≃ₗ[A] Ω[A⁄R₀] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R₀ P A
    let b_A : Module.Basis (Fin d) A Ω[A⁄R₀] := (b_P.baseChange A).map e_Ω
    have hD_ψ₀ : ∀ f : P,
        KaehlerDifferential.D R₀ A (ψ₀ f) = e_Ω (1 ⊗ₜ[P] KaehlerDifferential.D R₀ P f) := by
      intro f
      apply e_Ω.symm.injective
      rw [e_Ω.symm_apply_apply]
      exact KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap R₀ P A f
    have hb_A_apply : ∀ i : Fin d, b_A i = KaehlerDifferential.D R₀ A (ψ₀ (MvPolynomial.X i)) := by
      intro i
      dsimp [b_A]
      rw [Module.Basis.baseChange_apply, KaehlerDifferential.mvPolynomialBasis_apply, hD_ψ₀]
    let der_0 : Fin d → Derivation R₀ A A :=
      fun i => (b_A.coord i).compDer (KaehlerDifferential.D R₀ A)
    have hder_0_apply : ∀ (i : Fin d) (a : A),
        der_0 i a = b_A.repr (KaehlerDifferential.D R₀ A a) i := fun _ _ => rfl
    have hD_A_sum : ∀ a : A,
        KaehlerDifferential.D R₀ A a = ∑ i : Fin d, (der_0 i a) • b_A i := by
      intro a
      exact (b_A.sum_repr (KaehlerDifferential.D R₀ A a)).symm
    have hder_0_ψ₀ : ∀ (i : Fin d) (f : P),
        der_0 i (ψ₀ f) = ψ₀ (MvPolynomial.pderiv i f) := by
      intro i f
      have hDP : KaehlerDifferential.D R₀ P f =
          ∑ j : Fin d, (MvPolynomial.pderiv j f) • b_P j := by
        conv_lhs => rw [← b_P.sum_repr (KaehlerDifferential.D R₀ P f)]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [KaehlerDifferential.mvPolynomialBasis_repr_apply]
      have hDA_f : KaehlerDifferential.D R₀ A (ψ₀ f) =
          ∑ j : Fin d, ψ₀ (MvPolynomial.pderiv j f) • b_A j := by
        rw [hD_ψ₀ f, hDP, TensorProduct.tmul_sum, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        have htmul : (1 : A) ⊗ₜ[P] ((MvPolynomial.pderiv j f) • b_P j) =
            ψ₀ (MvPolynomial.pderiv j f) • ((1 : A) ⊗ₜ[P] b_P j) := by
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, hψ₀_eq,
            TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [htmul, map_smul]
        dsimp [b_A]
        rw [Module.Basis.baseChange_apply]
      rw [hder_0_apply, hDA_f, map_sum]
      simp only [map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
        Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.single_apply]
      rw [Finset.sum_eq_single i (fun j _ hji => by simp [hji])
        (fun hi => absurd (Finset.mem_univ i) hi)]
      simp
    have hUniv : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module R₀ M] [IsScalarTower R₀ A M]
        (E : Derivation R₀ A M) (a : A),
        E a = ∑ i : Fin d, (der_0 i a) • E (ψ₀ (MvPolynomial.X i)) := by
      intro M _ _ _ _ E a
      let L_E : Ω[A⁄R₀] →ₗ[A] M := E.liftKaehlerDifferential
      have hL_D : ∀ x : A, L_E (KaehlerDifferential.D R₀ A x) = E x :=
        fun x => Derivation.congr_fun (Derivation.liftKaehlerDifferential_comp E) x
      rw [← hL_D a, hD_A_sum a, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_smul, hb_A_apply i, hL_D]
    refine ⟨⟨hSm_A, hFP_A⟩, ⟨b_A, hb_A_apply, ?_⟩, ⟨der_0, hder_0_ψ₀, hUniv⟩⟩
    intro der_A hder_A a
    have hEq_der : ∀ j : Fin d, der_A j a = der_0 j a := by
      intro j
      have hexp := hUniv A (der_A j) a
      rw [hexp]
      have hterm : ∀ i : Fin d,
          (der_0 i a) • der_A j (ψ₀ (MvPolynomial.X i)) =
            if i = j then der_0 i a else 0 := by
        intro i
        rw [hder_A j (MvPolynomial.X i), MvPolynomial.pderiv_X, smul_eq_mul]
        split_ifs with hij
        · subst hij; simp
        · simp [hij]
      simp_rw [hterm]
      rw [Finset.sum_eq_single j (fun i _ hij => by simp [hij])
        (fun hj => absurd (Finset.mem_univ j) hj)]
      simp
    rw [hD_A_sum a]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hEq_der j]

  have hS3 : ∀ (R₀ : Type u) [CommRing R₀] (A : Type u) [CommRing A] [Algebra R₀ A]
      [Algebra.FormallySmooth R₀ A] [Algebra.FinitePresentation R₀ A]
      (b_A : Module.Basis (Fin d) A Ω[A⁄R₀])
      (der_A : Fin d → A → A)
      (_ : ∀ a : A, KaehlerDifferential.D R₀ A a = ∑ j : Fin d, (der_A j a) • b_A j)
      (F : Fin d → A) (g_extra : A),
      let Δ_F : A := Matrix.det (Matrix.of fun i j : Fin d => der_A j (F i))
      let δ : A := Δ_F * g_extra
      let I_F : Ideal A := Ideal.span (Set.range F)
      (((algebraMap (A ⧸ I_F) (Localization.Away (Ideal.Quotient.mk I_F δ))).comp
        (Ideal.Quotient.mk I_F)).comp (algebraMap R₀ A)).Etale := by
    intro R₀ _ A _ _ _ _ b_A der_A hD_A F g_extra Δ_F δ I_F
    let Q := A ⧸ I_F
    let bar_δ : Q := Ideal.Quotient.mk I_F δ
    let S := Localization.Away bar_δ
    let τ : A →+* S := (algebraMap Q S).comp (Ideal.Quotient.mk I_F)
    let A' := Localization.Away δ
    let ι_δ : A →+* A' := algebraMap A A'
    let f : Fin d → A' := fun i => ι_δ (F i)
    let J' : Ideal A' := Ideal.span (Set.range f)
    let S' := A' ⧸ J'
    let π' : A' →+* S' := Ideal.Quotient.mk J'
    have h_ker_α0 : ∀ a ∈ I_F, (π'.comp ι_δ) a = 0 := by
      have hle : I_F ≤ RingHom.ker (π'.comp ι_δ) := Ideal.span_le.mpr fun _ ⟨i, hEq⟩ => by
        subst hEq
        rw [SetLike.mem_coe, RingHom.mem_ker]
        change π' (f i) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
      exact fun a ha => RingHom.mem_ker.mp (hle ha)
    let α_0 : Q →+* S' := Ideal.Quotient.lift I_F (π'.comp ι_δ) h_ker_α0
    have h_unit_α0 : IsUnit (α_0 bar_δ) :=
      (IsLocalization.Away.algebraMap_isUnit (S := A') δ).map π'
    let α : S →+* S' := IsLocalization.Away.lift bar_δ h_unit_α0
    have h_unit_τ : IsUnit (τ δ) :=
      IsLocalization.Away.algebraMap_isUnit (S := S) bar_δ
    let β_0 : A' →+* S := IsLocalization.Away.lift δ h_unit_τ
    have h_ker_β0 : ∀ a' ∈ J', β_0 a' = 0 := by
      have hle : J' ≤ RingHom.ker β_0 := Ideal.span_le.mpr fun _ ⟨i, hEq⟩ => by
        subst hEq
        rw [SetLike.mem_coe, RingHom.mem_ker]
        change β_0 (algebraMap A A' (F i)) = 0
        rw [IsLocalization.Away.lift_eq]
        change algebraMap Q S (Ideal.Quotient.mk I_F (F i)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i)), map_zero]
      exact fun a' ha' => RingHom.mem_ker.mp (hle ha')
    let β : S' →+* S := Ideal.Quotient.lift J' β_0 h_ker_β0
    have hβα : β.comp α = RingHom.id S := by
      apply IsLocalization.ringHom_ext (Submonoid.powers bar_δ)
      apply Ideal.Quotient.ringHom_ext
      apply RingHom.ext
      intro a
      change β (α (algebraMap Q S (Ideal.Quotient.mk I_F a))) =
        algebraMap Q S (Ideal.Quotient.mk I_F a)
      rw [IsLocalization.Away.lift_eq]
      change β (π' (algebraMap A A' a)) = _
      change β_0 (algebraMap A A' a) = _
      rw [IsLocalization.Away.lift_eq]
      rfl
    have hαβ : α.comp β = RingHom.id S' := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext (Submonoid.powers δ)
      apply RingHom.ext
      intro a
      change α (β (π' (algebraMap A A' a))) = π' (algebraMap A A' a)
      change α (β_0 (algebraMap A A' a)) = _
      rw [IsLocalization.Away.lift_eq]
      change α (algebraMap Q S (Ideal.Quotient.mk I_F a)) = _
      rw [IsLocalization.Away.lift_eq]
      rfl
    have hβ_bij : Function.Bijective β := by
      refine ⟨fun x y hxy => ?_, fun y => ⟨α y, RingHom.congr_fun hβα y⟩⟩
      have := congrArg α hxy
      exact (RingHom.congr_fun hαβ x).symm.trans (this.trans (RingHom.congr_fun hαβ y))
    haveI : Algebra.Etale A A' := Algebra.Etale.of_isLocalizationAway δ
    haveI : Algebra.FormallyEtale A A' := Algebra.Etale.formallyEtale
    haveI : Algebra.FinitePresentation A A' := Algebra.Etale.finitePresentation
    haveI : Algebra.FormallySmooth R₀ A' := Algebra.FormallySmooth.comp R₀ A A'
    haveI : Algebra.FinitePresentation R₀ A' := Algebra.FinitePresentation.trans R₀ A A'
    have hJ'_fg : J'.FG := by classical exact ⟨Finset.univ.image f, by simp [J']⟩
    haveI : Algebra.FinitePresentation R₀ S' := Algebra.FinitePresentation.quotient hJ'_fg
    let e_Ω' : TensorProduct A A' Ω[A⁄R₀] ≃ₗ[A'] Ω[A'⁄R₀] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R₀ A A'
    let b_A' : Module.Basis (Fin d) A' Ω[A'⁄R₀] := (b_A.baseChange A').map e_Ω'
    have hD_A'_ι : ∀ a : A,
        KaehlerDifferential.D R₀ A' (ι_δ a) =
          ∑ j : Fin d, ι_δ (der_A j a) • b_A' j := by
      intro a
      have hsymm := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap R₀ A A' a
      have h1 : KaehlerDifferential.D R₀ A' (ι_δ a) =
          e_Ω' (1 ⊗ₜ[A] KaehlerDifferential.D R₀ A a) := by
        apply e_Ω'.symm.injective
        rw [e_Ω'.symm_apply_apply]
        exact hsymm
      rw [h1, hD_A a, TensorProduct.tmul_sum, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      have htmul : (1 : A') ⊗ₜ[A] ((der_A j a) • b_A j) =
          ι_δ (der_A j a) • ((1 : A') ⊗ₜ[A] b_A j) := by
        rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, TensorProduct.smul_tmul',
          smul_eq_mul, mul_one]
      rw [htmul, map_smul]
      dsimp [b_A']
      rw [Module.Basis.baseChange_apply]
    have hπ'_surj : Function.Surjective (algebraMap A' S') := Ideal.Quotient.mk_surjective
    let I_ker : Ideal A' := RingHom.ker (algebraMap A' S')
    have hI_ker_eq : I_ker = J' := Ideal.mk_ker
    have hf_mem : ∀ i : Fin d, f i ∈ I_ker := by
      intro i
      rw [hI_ker_eq]
      exact Ideal.subset_span (Set.mem_range_self i)
    let c_gen : Fin d → I_ker.Cotangent := fun i => I_ker.toCotangent ⟨f i, hf_mem i⟩
    let σ_0 : S' → A' := Function.surjInv hπ'_surj
    have hσ_0 : ∀ s : S', algebraMap A' S' (σ_0 s) = s := Function.surjInv_eq hπ'_surj
    let γ : (Fin d → S') → I_ker.Cotangent := fun v => ∑ i : Fin d, σ_0 (v i) • c_gen i
    have hγ_surj : Function.Surjective γ := by
      intro y
      obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective I_ker y
      have hx_J' : x ∈ Ideal.span (Set.range f) := by
        change x ∈ J'
        rwa [← hI_ker_eq]
      obtain ⟨u, hu⟩ := (Submodule.mem_span_range_iff_exists_fun A').mp hx_J'
      have hx_sub : (⟨x, hx⟩ : I_ker) = ∑ i : Fin d, u i • (⟨f i, hf_mem i⟩ : I_ker) := by
        ext
        simp only [AddSubmonoidClass.coe_finset_sum, SetLike.val_smul, smul_eq_mul]
        exact hu.symm
      let v : Fin d → S' := fun i => algebraMap A' S' (u i)
      refine ⟨v, ?_⟩
      rw [hx_sub, map_sum]
      change (∑ i : Fin d, σ_0 (v i) • c_gen i) =
        ∑ i : Fin d, I_ker.toCotangent (u i • (⟨f i, hf_mem i⟩ : I_ker))
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [LinearMap.map_smul]
      have hz_mem : σ_0 (v i) - u i ∈ I_ker := by
        rw [RingHom.mem_ker, map_sub, hσ_0 (v i)]
        exact sub_self _
      have hzero : (σ_0 (v i) - u i) • I_ker.toCotangent ⟨f i, hf_mem i⟩ = 0 := by
        rw [← LinearMap.map_smul, ← LinearMap.mem_ker, Ideal.mem_toCotangent_ker, pow_two]
        exact Ideal.mul_mem_mul hz_mem (hf_mem i)
      exact sub_eq_zero.mp (by rwa [sub_smul] at hzero)
    let κ := KaehlerDifferential.kerCotangentToTensor R₀ A' S'
    let bar_b : Module.Basis (Fin d) S' (TensorProduct A' S' Ω[A'⁄R₀]) := b_A'.baseChange S'
    have hκ_c : ∀ i : Fin d,
        κ (c_gen i) = ∑ j : Fin d, π' (ι_δ (der_A j (F i))) • bar_b j := by
      intro i
      dsimp [κ, c_gen]
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
      change (1 : S') ⊗ₜ[A'] KaehlerDifferential.D R₀ A' (ι_δ (F i)) = _
      rw [hD_A'_ι (F i), TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      dsimp [bar_b]
      rw [Module.Basis.baseChange_apply, ← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
      change (ι_δ (der_A j (F i)) • (1 : S')) ⊗ₜ[A'] b_A' j =
        ((algebraMap A' S' (ι_δ (der_A j (F i)))) • (1 : S')) ⊗ₜ[A'] b_A' j
      rw [IsScalarTower.algebraMap_smul S' (ι_δ (der_A j (F i))) (1 : S')]
    let M_jac : Matrix (Fin d) (Fin d) S' :=
      Matrix.of fun i j : Fin d => π' (ι_δ (der_A j (F i)))
    have hκ_γ : ∀ v : Fin d → S',
        bar_b.equivFun (κ (γ v)) = M_jac.transpose.mulVec v := by
      intro v
      ext j
      change (bar_b.coord j) (κ (γ v)) = (M_jac.transpose.mulVec v) j
      dsimp [γ, Matrix.mulVec, dotProduct, M_jac]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hsmul_S' : κ (σ_0 (v i) • c_gen i) = v i • κ (c_gen i) := by
        rw [LinearMap.map_smul, ← IsScalarTower.algebraMap_smul S' (σ_0 (v i)) (κ (c_gen i)),
          hσ_0 (v i)]
      rw [hsmul_S', hκ_c i, Finset.smul_sum, map_sum]
      simp only [Module.Basis.coord_apply, map_smul, Module.Basis.repr_self,
        smul_eq_mul, Finsupp.single_apply]
      rw [Finset.sum_eq_single j
        (fun k _ hkj => by simp [hkj])
        (fun hj => absurd (Finset.mem_univ j) hj)]
      simp [mul_comm]
    have hM_det_unit : IsUnit M_jac.transpose.det := by
      rw [Matrix.det_transpose]
      have hM_map : M_jac =
          (π'.comp ι_δ).mapMatrix (Matrix.of fun i j : Fin d => der_A j (F i)) := by
        ext i j; rfl
      rw [hM_map, ← RingHom.map_det]
      have hδ_unit : IsUnit (ι_δ Δ_F * ι_δ g_extra) := by
        rw [← map_mul]
        exact IsLocalization.Away.algebraMap_isUnit (S := A') δ
      exact (isUnit_of_mul_isUnit_left hδ_unit).map π'
    have hmulVec_bij : Function.Bijective M_jac.transpose.mulVec := by
      refine ⟨fun u v huv => ?_, fun w => ⟨M_jac.transpose⁻¹.mulVec w, ?_⟩⟩
      · have h := congrArg M_jac.transpose⁻¹.mulVec huv
        rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
          Matrix.nonsing_inv_mul _ hM_det_unit, Matrix.one_mulVec, Matrix.one_mulVec] at h
        exact h
      · rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hM_det_unit, Matrix.one_mulVec]
    have hκγ_bij : Function.Bijective (κ ∘ γ) := by
      have h_eq : κ ∘ γ = bar_b.equivFun.symm ∘ M_jac.transpose.mulVec :=
        funext fun v => bar_b.equivFun.eq_symm_apply.mpr (hκ_γ v)
      rw [h_eq]
      exact bar_b.equivFun.symm.bijective.comp hmulVec_bij
    have hκ_inj : Function.Injective κ := by
      intro y₁ y₂ hy
      obtain ⟨v₁, rfl⟩ := hγ_surj y₁
      obtain ⟨v₂, rfl⟩ := hγ_surj y₂
      exact congrArg γ (hκγ_bij.1 hy)
    have hκ_surj : Function.Surjective κ :=
      fun t => let ⟨v, hv⟩ := hκγ_bij.2 t; ⟨γ v, hv⟩
    have hH1_sub : Subsingleton (Algebra.H1Cotangent R₀ S') :=
      (Algebra.FormallySmooth.kerCotangentToTensor_injective_iff (R := R₀) (A := S') (P := A')
        hπ'_surj).mp hκ_inj
    have hΩ_sub : Subsingleton Ω[S'⁄R₀] := by
      refine Subsingleton.intro fun ω₁ ω₂ => ?_
      have hzero : ∀ ω : Ω[S'⁄R₀], ω = 0 := by
        intro ω
        obtain ⟨t, rfl⟩ := KaehlerDifferential.mapBaseChange_surjective R₀ A' S' hπ'_surj ω
        obtain ⟨y, rfl⟩ := hκ_surj t
        exact (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R₀ A' S' hπ'_surj).apply_apply_eq_zero y
      rw [hzero ω₁, hzero ω₂]
    haveI : Algebra.FormallyEtale R₀ S' := Algebra.FormallyEtale.mk hΩ_sub hH1_sub
    haveI : Algebra.Etale R₀ S' := Algebra.Etale.mk
    have h_algS'_et : (algebraMap R₀ S').Etale :=
      (RingHom.etale_algebraMap (R := R₀) (S := S')).mpr inferInstance
    have h_target_eq : β.comp (algebraMap R₀ S') =
        (((algebraMap Q S).comp (Ideal.Quotient.mk I_F)).comp (algebraMap R₀ A)) := by
      apply RingHom.ext
      intro r
      change β (π' (algebraMap A A' (algebraMap R₀ A r))) =
        algebraMap Q S (Ideal.Quotient.mk I_F (algebraMap R₀ A r))
      change β_0 (algebraMap A A' (algebraMap R₀ A r)) = _
      rw [IsLocalization.Away.lift_eq]
      rfl
    rw [← h_target_eq]
    exact RingHom.Etale.stableUnderComposition _ _ h_algS'_et (RingHom.Etale.of_bijective hβ_bij)

  have hS4 : ∀ (m : ℕ) (der_C : Fin d → Derivation R C C),
      (∀ (i : Fin d) (f : MvPolynomial (Fin d) R), der_C i (ψ f) = ψ (MvPolynomial.pderiv i f)) →
      let R_m := MvPolynomial (Fin m) R
      let C_m := MvPolynomial (Fin m) C
      letI : Algebra R_m C_m := (MvPolynomial.map (algebraMap R C)).toAlgebra
      let ψ_m : MvPolynomial (Fin d) R_m →+* C_m :=
        MvPolynomial.eval₂Hom (MvPolynomial.map (algebraMap R C))
          (fun i : Fin d => MvPolynomial.C (ψ (MvPolynomial.X i)))
      (ψ_m.comp MvPolynomial.C = algebraMap R_m C_m ∧ ψ_m.Etale) ∧
      ∃ D_poly : Fin d → Derivation R_m C_m C_m,
        (∀ (j : Fin d) (F : C_m), D_poly j F = weilMvPolyMapCoeffs (der_C j) F) ∧
        (∀ (j : Fin d) (g : MvPolynomial (Fin d) R_m),
          D_poly j (ψ_m g) = ψ_m (MvPolynomial.pderiv j g)) := by
    intro m der_C hder_C R_m C_m ψ_m
    letI : Algebra R_m C_m := (MvPolynomial.map (algebraMap R C)).toAlgebra
    have hψm_alg : ψ_m.comp MvPolynomial.C = algebraMap R_m C_m := by
      apply RingHom.ext
      intro p
      change ψ_m (MvPolynomial.C p) = MvPolynomial.map (algebraMap R C) p
      exact MvPolynomial.eval₂Hom_C _ _ p
    have hψm_et : ψ_m.Etale := by
      let P_d := MvPolynomial (Fin d) R
      letI : Algebra P_d C := ψ.toAlgebra
      haveI : Algebra.Etale P_d C := RingHom.etale_algebraMap.mp hψ_et
      let Q_md := MvPolynomial (Fin m) P_d
      have hf_mid_et := RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange P_d C Q_md)
      let f_mid : Q_md →+* TensorProduct P_d Q_md C := algebraMap Q_md (TensorProduct P_d Q_md C)
      let e_tens : TensorProduct P_d Q_md C ≃+* C_m :=
        (Algebra.TensorProduct.comm P_d Q_md C).toRingEquiv.trans
          (MvPolynomial.algebraTensorAlgEquiv P_d C).toRingEquiv
      have he_tens_mid : ∀ q : Q_md, e_tens (f_mid q) = MvPolynomial.map ψ q := by
        intro q
        change (MvPolynomial.algebraTensorAlgEquiv P_d C)
          ((Algebra.TensorProduct.comm P_d Q_md C) (q ⊗ₜ[P_d] (1 : C))) = MvPolynomial.map ψ q
        rw [Algebra.TensorProduct.comm_tmul, MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
        rfl
      let e_swap_alg :=
        (MvPolynomial.sumAlgEquiv R (Fin d) (Fin m)).symm.trans
          ((MvPolynomial.renameEquiv R (Equiv.sumComm (Fin d) (Fin m))).trans
            (MvPolynomial.sumAlgEquiv R (Fin m) (Fin d)))
      let e_swap : MvPolynomial (Fin d) R_m ≃+* Q_md := e_swap_alg.toRingEquiv
      have hψm_factor : ψ_m = (e_tens.toRingHom.comp f_mid).comp e_swap.toRingHom := by
        apply MvPolynomial.ringHom_ext'
        · apply MvPolynomial.ringHom_ext
          · intro r
            have h1 : (MvPolynomial.sumAlgEquiv R (Fin d) (Fin m)).symm
                (MvPolynomial.C (MvPolynomial.C r : MvPolynomial (Fin m) R)) = MvPolynomial.C r := by
              apply (MvPolynomial.sumAlgEquiv R (Fin d) (Fin m)).injective
              rw [AlgEquiv.apply_symm_apply]
              simp
            have he_r : e_swap_alg (MvPolynomial.C (MvPolynomial.C r : MvPolynomial (Fin m) R)) =
                MvPolynomial.C (MvPolynomial.C r) := by
              dsimp [e_swap_alg]
              rw [h1]
              simp
            change ψ_m (MvPolynomial.C (MvPolynomial.C r : MvPolynomial (Fin m) R)) =
              e_tens (f_mid (e_swap_alg (MvPolynomial.C (MvPolynomial.C r : MvPolynomial (Fin m) R))))
            rw [MvPolynomial.eval₂Hom_C, MvPolynomial.map_C, he_tens_mid, he_r,
              MvPolynomial.map_C, ← RingHom.congr_fun hψ_alg r]
            rfl
          · intro b
            have h1 : (MvPolynomial.sumAlgEquiv R (Fin d) (Fin m)).symm
                (MvPolynomial.C (MvPolynomial.X b : MvPolynomial (Fin m) R)) =
                MvPolynomial.X (Sum.inr b) := by
              apply (MvPolynomial.sumAlgEquiv R (Fin d) (Fin m)).injective
              rw [AlgEquiv.apply_symm_apply]
              simp
            have he_b : e_swap_alg (MvPolynomial.C (MvPolynomial.X b : MvPolynomial (Fin m) R)) =
                MvPolynomial.X b := by
              dsimp [e_swap_alg]
              rw [h1]
              simp
            change ψ_m (MvPolynomial.C (MvPolynomial.X b : MvPolynomial (Fin m) R)) =
              e_tens (f_mid (e_swap_alg (MvPolynomial.C (MvPolynomial.X b : MvPolynomial (Fin m) R))))
            rw [MvPolynomial.eval₂Hom_C, MvPolynomial.map_X, he_tens_mid, he_b, MvPolynomial.map_X]
        · intro i
          have h1 : (MvPolynomial.sumAlgEquiv R (Fin d) (Fin m)).symm
              (MvPolynomial.X i : MvPolynomial (Fin d) (MvPolynomial (Fin m) R)) =
              MvPolynomial.X (Sum.inl i) := by
            apply (MvPolynomial.sumAlgEquiv R (Fin d) (Fin m)).injective
            rw [AlgEquiv.apply_symm_apply]
            simp
          have he_i : e_swap_alg (MvPolynomial.X i : MvPolynomial (Fin d) (MvPolynomial (Fin m) R)) =
              MvPolynomial.C (MvPolynomial.X i) := by
            dsimp [e_swap_alg]
            rw [h1]
            simp
          change ψ_m (MvPolynomial.X i) =
            e_tens (f_mid (e_swap_alg (MvPolynomial.X i : MvPolynomial (Fin d) (MvPolynomial (Fin m) R))))
          rw [MvPolynomial.eval₂Hom_X', he_tens_mid, he_i, MvPolynomial.map_C]
      rw [hψm_factor]
      exact RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.of_bijective e_swap.bijective)
        (RingHom.Etale.stableUnderComposition _ _ hf_mid_et
          (RingHom.Etale.of_bijective e_tens.bijective))
    have hLeibniz : ∀ (j : Fin d) (F₁ F₂ : C_m),
        weilMvPolyMapCoeffs (der_C j) (F₁ * F₂) =
          F₁ • weilMvPolyMapCoeffs (der_C j) F₂ + F₂ • weilMvPolyMapCoeffs (der_C j) F₁ := by
      intro j F₁ F₂
      simp only [smul_eq_mul]
      refine MvPolynomial.induction_on' F₁ (fun m₁ c₁ => ?_) (fun P₁ Q₁ hP₁ hQ₁ => ?_)
      · refine MvPolynomial.induction_on' F₂ (fun m₂ c₂ => ?_) (fun P₂ Q₂ hP₂ hQ₂ => ?_)
        · rw [MvPolynomial.monomial_mul, hMC_monomial, hMC_monomial, hMC_monomial,
            Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, MvPolynomial.monomial_mul,
            MvPolynomial.monomial_mul, add_comm m₂ m₁]
        · rw [mul_add, hMC_add, hP₂, hQ₂, hMC_add]
          ring
      · rw [add_mul, hMC_add, hP₁, hQ₁, hMC_add]
        ring
    have hKillBase : ∀ (j : Fin d) (p : R_m),
        weilMvPolyMapCoeffs (der_C j) (MvPolynomial.map (algebraMap R C) p) = 0 := by
      intro j p
      apply MvPolynomial.ext
      intro μ
      rw [hMC_coeff (der_C j) (map_zero (der_C j)), MvPolynomial.coeff_map,
        Derivation.map_algebraMap]
      simp
    let D_poly : Fin d → Derivation R_m C_m C_m := fun j =>
      { toFun := weilMvPolyMapCoeffs (der_C j)
        map_add' := hMC_add (der_C j)
        map_smul' := fun p F => by
          change weilMvPolyMapCoeffs (der_C j) (MvPolynomial.map (algebraMap R C) p * F) =
            MvPolynomial.map (algebraMap R C) p * weilMvPolyMapCoeffs (der_C j) F
          rw [hLeibniz j, smul_eq_mul, smul_eq_mul, hKillBase j p, mul_zero, add_zero]
        map_one_eq_zero' := by
          change weilMvPolyMapCoeffs (der_C j) (MvPolynomial.C 1) = 0
          rw [hMC_C, Derivation.map_one_eq_zero, map_zero]
        leibniz' := hLeibniz j }
    refine ⟨⟨hψm_alg, hψm_et⟩, D_poly, (fun _ _ => rfl), ?_⟩
    intro j g
    refine MvPolynomial.induction_on
      (motive := fun g => D_poly j (ψ_m g) = ψ_m (MvPolynomial.pderiv j g)) g
      (fun p => ?_) (fun g₁ g₂ hg₁ hg₂ => ?_) (fun q i hq => ?_)
    · have hp1 : ψ_m (MvPolynomial.C p) = MvPolynomial.map (algebraMap R C) p :=
        MvPolynomial.eval₂Hom_C _ _ p
      have hp2 : MvPolynomial.pderiv j (MvPolynomial.C p : MvPolynomial (Fin d) R_m) = 0 :=
        Derivation.map_algebraMap (MvPolynomial.pderiv j) p
      rw [hp1, hp2, map_zero]
      exact hKillBase j p
    · rw [map_add, map_add, hg₁, hg₂, map_add, map_add]
    · rw [map_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul, hq,
        MvPolynomial.pderiv_mul, map_add, map_mul, map_mul]
      have hXi : D_poly j (ψ_m (MvPolynomial.X i)) =
          ψ_m (MvPolynomial.pderiv j (MvPolynomial.X i)) := by
        have h1 : ψ_m (MvPolynomial.X i) = MvPolynomial.C (ψ (MvPolynomial.X i)) :=
          MvPolynomial.eval₂Hom_X' _ _ i
        rw [h1]
        change weilMvPolyMapCoeffs (der_C j) (MvPolynomial.C (ψ (MvPolynomial.X i))) =
          ψ_m (MvPolynomial.pderiv j (MvPolynomial.X i))
        rw [hMC_C, hder_C j (MvPolynomial.X i), MvPolynomial.pderiv_X]
        by_cases hij : i = j
        · subst hij; simp
        · simp [hij]
      rw [hXi]
      ring

  have hPart3a : ∀ (m : ℕ) (der_C : Fin d → Derivation R C C),
      (∀ (i : Fin d) (f : MvPolynomial (Fin d) R), der_C i (ψ f) = ψ (MvPolynomial.pderiv i f)) →
      ∀ (F : Fin d → MvPolynomial (Fin m) C) (g_extra : MvPolynomial (Fin m) C),
        let Δ_F : MvPolynomial (Fin m) C :=
          Matrix.det (Matrix.of fun i j : Fin d => weilMvPolyMapCoeffs (der_C j) (F i))
        let δ : MvPolynomial (Fin m) C := Δ_F * g_extra
        let I_F : Ideal (MvPolynomial (Fin m) C) := Ideal.span (Set.range F)
        (((algebraMap (MvPolynomial (Fin m) C ⧸ I_F)
            (Localization.Away (Ideal.Quotient.mk I_F δ))).comp
          (Ideal.Quotient.mk I_F)).comp (MvPolynomial.map (algebraMap R C))).Etale := by
    intro m der_C hder_C F g_extra
    let R_m := MvPolynomial (Fin m) R
    let C_m := MvPolynomial (Fin m) C
    letI : Algebra R_m C_m := (MvPolynomial.map (algebraMap R C)).toAlgebra
    obtain ⟨⟨hψm_alg, hψm_et⟩, D_poly, hD_poly_eq, hD_poly_ψ⟩ := hS4 m der_C hder_C
    let ψ_m : MvPolynomial (Fin d) R_m →+* C_m :=
      MvPolynomial.eval₂Hom (MvPolynomial.map (algebraMap R C))
        (fun i : Fin d => MvPolynomial.C (ψ (MvPolynomial.X i)))
    obtain ⟨⟨hSm_Cm, hFP_Cm⟩, ⟨b_Cm, _, hb_Cm_D⟩, _⟩ :=
      hS2 R_m C_m ψ_m hψm_alg hψm_et
    haveI : Algebra.FormallySmooth R_m C_m := hSm_Cm
    haveI : Algebra.FinitePresentation R_m C_m := hFP_Cm
    have hD_Cm : ∀ f : C_m,
        KaehlerDifferential.D R_m C_m f =
          ∑ j : Fin d, (weilMvPolyMapCoeffs (der_C j) f) • b_Cm j := by
      intro f
      simpa only [hD_poly_eq] using hb_Cm_D D_poly hD_poly_ψ f
    exact hS3 R_m C_m b_Cm (fun j f => weilMvPolyMapCoeffs (der_C j) f) hD_Cm F g_extra

  have hPart2 : ∀ (der_C : Fin d → Derivation R C C),
      (∀ (i : Fin d) (f : MvPolynomial (Fin d) R), der_C i (ψ f) = ψ (MvPolynomial.pderiv i f)) →
      ∀ (z : Fin d → C),
        let Δ_z : C := Matrix.det (Matrix.of fun i j : Fin d => der_C j (z i))
        (MvPolynomial.eval₂Hom
          ((algebraMap C (Localization.Away Δ_z)).comp (algebraMap R C))
          (fun i : Fin d => algebraMap C (Localization.Away Δ_z) (z i))).Etale := by
    intro der_C hder_C z Δ_z
    let F_z : Fin d → MvPolynomial (Fin d) C :=
      fun i => MvPolynomial.C (z i) - MvPolynomial.X i
    have hEt_Fz := hPart3a d der_C hder_C F_z 1
    dsimp only at hEt_Fz
    let Δ_Fz : MvPolynomial (Fin d) C :=
      Matrix.det (Matrix.of fun i j : Fin d => weilMvPolyMapCoeffs (der_C j) (F_z i))
    let δ_z : MvPolynomial (Fin d) C := Δ_Fz * 1
    let I_Fz : Ideal (MvPolynomial (Fin d) C) := Ideal.span (Set.range F_z)
    let Q_z := MvPolynomial (Fin d) C ⧸ I_Fz
    have hΔ_Fz_eq : δ_z = MvPolynomial.C Δ_z := by
      dsimp [δ_z, Δ_Fz]
      rw [mul_one]
      have hMat : (Matrix.of fun i j : Fin d => weilMvPolyMapCoeffs (der_C j) (F_z i)) =
          (MvPolynomial.C : C →+* MvPolynomial (Fin d) C).mapMatrix
            (Matrix.of fun i j : Fin d => der_C j (z i)) := by
        ext i j : 1
        dsimp [F_z]
        rw [hMC_sub, hMC_C, hMC_X, sub_zero]
        rfl
      rw [hMat, ← RingHom.map_det]
    let ev := MvPolynomial.eval₂Hom (RingHom.id C) z
    have h_ker_ev : ∀ p ∈ I_Fz, ev p = 0 := by
      have hle : I_Fz ≤ RingHom.ker ev := Ideal.span_le.mpr fun _ ⟨i, hEq⟩ => by
        subst hEq
        rw [SetLike.mem_coe, RingHom.mem_ker]
        simp [ev, F_z]
      exact fun p hp => RingHom.mem_ker.mp (hle hp)
    let ev_Q := Ideal.Quotient.lift I_Fz ev h_ker_ev
    let inc_Q := (Ideal.Quotient.mk I_Fz).comp MvPolynomial.C
    have hev_inc : ev_Q.comp inc_Q = RingHom.id C := by
      apply RingHom.ext
      intro c
      change ev (MvPolynomial.C c) = c
      simp [ev]
    have hinc_ev : inc_Q.comp ev_Q = RingHom.id Q_z := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        change inc_Q (ev (MvPolynomial.C c)) = Ideal.Quotient.mk I_Fz (MvPolynomial.C c)
        simp [ev, inc_Q]
      · intro i
        change Ideal.Quotient.mk I_Fz (MvPolynomial.C (ev (MvPolynomial.X i))) =
          Ideal.Quotient.mk I_Fz (MvPolynomial.X i)
        rw [MvPolynomial.eval₂Hom_X']
        exact sub_eq_zero.mp (by
          rw [← map_sub]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i)))
    let bar_δz : Q_z := Ideal.Quotient.mk I_Fz δ_z
    have hev_δ : ev_Q bar_δz = Δ_z := by
      dsimp [bar_δz]
      rw [hΔ_Fz_eq]
      change ev (MvPolynomial.C Δ_z) = Δ_z
      simp [ev]
    have hinc_Δ : inc_Q Δ_z = bar_δz := by
      dsimp [bar_δz, inc_Q]
      rw [hΔ_Fz_eq]
    have h_unit_ev : IsUnit (((algebraMap C (Localization.Away Δ_z)).comp ev_Q) bar_δz) := by
      change IsUnit (algebraMap C (Localization.Away Δ_z) (ev_Q bar_δz))
      rw [hev_δ]
      exact IsLocalization.Away.algebraMap_isUnit Δ_z
    let α_loc : Localization.Away bar_δz →+* Localization.Away Δ_z :=
      IsLocalization.Away.lift bar_δz h_unit_ev
    have h_unit_inc : IsUnit (((algebraMap Q_z (Localization.Away bar_δz)).comp inc_Q) Δ_z) := by
      change IsUnit (algebraMap Q_z (Localization.Away bar_δz) (inc_Q Δ_z))
      rw [hinc_Δ]
      exact IsLocalization.Away.algebraMap_isUnit bar_δz
    let β_loc : Localization.Away Δ_z →+* Localization.Away bar_δz :=
      IsLocalization.Away.lift Δ_z h_unit_inc
    have hβα_loc : β_loc.comp α_loc = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers bar_δz)
      apply RingHom.ext
      intro q
      change β_loc (α_loc (algebraMap Q_z _ q)) = algebraMap Q_z _ q
      rw [IsLocalization.Away.lift_eq]
      change β_loc (algebraMap C _ (ev_Q q)) = _
      rw [IsLocalization.Away.lift_eq]
      change algebraMap Q_z _ ((inc_Q.comp ev_Q) q) = _
      rw [hinc_ev, RingHom.id_apply]
    have hαβ_loc : α_loc.comp β_loc = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ_z)
      apply RingHom.ext
      intro c
      change α_loc (β_loc (algebraMap C _ c)) = algebraMap C _ c
      rw [IsLocalization.Away.lift_eq]
      change α_loc (algebraMap Q_z _ (inc_Q c)) = _
      rw [IsLocalization.Away.lift_eq]
      change algebraMap C _ ((ev_Q.comp inc_Q) c) = _
      rw [hev_inc, RingHom.id_apply]
    have hα_bij : Function.Bijective α_loc := by
      refine ⟨fun x y hxy => ?_, fun y => ⟨β_loc y, RingHom.congr_fun hαβ_loc y⟩⟩
      have := congrArg β_loc hxy
      exact (RingHom.congr_fun hβα_loc x).symm.trans (this.trans (RingHom.congr_fun hβα_loc y))
    have hcomp_z : α_loc.comp
        (((algebraMap Q_z (Localization.Away bar_δz)).comp
          (Ideal.Quotient.mk I_Fz)).comp (MvPolynomial.map (algebraMap R C))) =
        MvPolynomial.eval₂Hom
          ((algebraMap C (Localization.Away Δ_z)).comp (algebraMap R C))
          (fun i : Fin d => algebraMap C (Localization.Away Δ_z) (z i)) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change α_loc (algebraMap Q_z _ (Ideal.Quotient.mk I_Fz
          (MvPolynomial.map (algebraMap R C) (MvPolynomial.C r)))) = _
        rw [MvPolynomial.map_C, IsLocalization.Away.lift_eq]
        change algebraMap C _ (ev (MvPolynomial.C (algebraMap R C r))) = _
        simp [ev]
      · intro i
        change α_loc (algebraMap Q_z _ (Ideal.Quotient.mk I_Fz
          (MvPolynomial.map (algebraMap R C) (MvPolynomial.X i)))) = _
        rw [MvPolynomial.map_X, IsLocalization.Away.lift_eq]
        change algebraMap C _ (ev (MvPolynomial.X i)) = _
        simp [ev]
    rw [← hcomp_z]
    exact RingHom.Etale.stableUnderComposition _ _ hEt_Fz (RingHom.Etale.of_bijective hα_bij)

  have hPart3b : ∀ (n : ℕ) (der_C : Fin d → Derivation R C C),
      (∀ (i : Fin d) (f : MvPolynomial (Fin d) R), der_C i (ψ f) = ψ (MvPolynomial.pderiv i f)) →
      1 ≤ d → ∀ (G : MvPolynomial (Fin n) C) (i_0 : Fin d),
        let I_G : Ideal (MvPolynomial (Fin n) C) :=
          Ideal.span ({G} : Set (MvPolynomial (Fin n) C))
        RingHom.IsStandardSmoothOfRelativeDimension (d - 1)
          (((algebraMap (MvPolynomial (Fin n) C ⧸ I_G)
              (Localization.Away (Ideal.Quotient.mk I_G (weilMvPolyMapCoeffs (der_C i_0) G)))).comp
            (Ideal.Quotient.mk I_G)).comp (MvPolynomial.map (algebraMap R C))) := by
    intro n der_C hder_C hd G i_0 I_G
    have hd_eq : (d - 1) + 1 = d := Nat.sub_add_cancel hd
    let e_d : Fin ((d - 1) + 1) ≃ Fin d := finCongr hd_eq
    let k_0 : Fin ((d - 1) + 1) := e_d.symm i_0
    let emb : Fin (d - 1) → Fin d := fun s => e_d (k_0.succAbove s)
    have hemb_inj : Function.Injective emb :=
      e_d.injective.comp Fin.succAbove_right_injective
    have hemb_ne : ∀ s : Fin (d - 1), emb s ≠ i_0 := by
      intro s hs
      have hk : k_0.succAbove s = k_0 :=
        e_d.injective (hs.trans (e_d.apply_symm_apply i_0).symm)
      exact Fin.succAbove_ne k_0 s hk
    have hemb_surj : ∀ (i : Fin d), i ≠ i_0 → ∃ s : Fin (d - 1), emb s = i := by
      intro i hi
      have hne : e_d.symm i ≠ k_0 := fun h => hi (e_d.symm.injective.eq_iff.mp h)
      obtain ⟨s, hs⟩ := Fin.exists_succAbove_eq_iff.mpr hne
      exact ⟨s, by simp [emb, hs]⟩
    let e_vars : Fin n ⊕ Fin (d - 1) ≃ Fin (n + (d - 1)) := finSumFinEquiv
    let inl_var : Fin n → Fin (n + (d - 1)) := fun b => e_vars (Sum.inl b)
    let inr_var : Fin (d - 1) → Fin (n + (d - 1)) := fun s => e_vars (Sum.inr s)
    let C_n := MvPolynomial (Fin n) C
    let C_ext := MvPolynomial (Fin (n + (d - 1))) C
    let F_slice : Fin d → C_ext := fun i =>
      if hi : i = i_0 then MvPolynomial.rename inl_var G
      else MvPolynomial.C (ψ (MvPolynomial.X i)) -
        MvPolynomial.X (inr_var (Classical.choose (hemb_surj i hi)))
    let r_G : Fin d → C_ext :=
      fun j => MvPolynomial.rename inl_var (weilMvPolyMapCoeffs (der_C j) G)
    let M_slice : Matrix (Fin d) (Fin d) C_ext :=
      Matrix.of fun i j : Fin d => weilMvPolyMapCoeffs (der_C j) (F_slice i)
    have hM_slice_eq : M_slice = (1 : Matrix (Fin d) (Fin d) C_ext).updateRow i_0 r_G := by
      ext i j : 1
      by_cases hi : i = i_0
      · subst hi
        simp only [M_slice, F_slice, ↓reduceDIte, Matrix.of_apply, Matrix.updateRow_self, r_G]
        exact hMC_rename (der_C j) inl_var G
      · simp only [M_slice, F_slice, hi, ↓reduceDIte, Matrix.of_apply, Matrix.updateRow_ne hi,
          Matrix.one_apply]
        rw [hMC_sub, hMC_C, hMC_X, sub_zero, hder_C j (MvPolynomial.X i), MvPolynomial.pderiv_X]
