        (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α'))
        ((inf_comm (U_chart α) (U_chart α')).trans (hInter α' α))⟩
  · 
    intro S _ _ s_ΩS W_S
    let fst_S := CategoryTheory.Limits.pullback.fst W.hom s_ΩS
    let snd_S := CategoryTheory.Limits.pullback.snd W.hom s_ΩS
