        · rintro ⟨p, rfl⟩
          have hp : (p : PrimeSpectrum κ₁) = bot_κ₁ := Subsingleton.elim _ _
          exact (congrArg i_w₁.base hp).trans hi_bot
        · rintro rfl
          exact ⟨bot_κ₁, hi_bot⟩
      rwa [← hRange_w₁]

theorem weil_algClosed_dvr_generic_pencil_scheme_closure (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (d N' : ℕ) (hd : 2 ≤ d) (hN' : 1 ≤ N')
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hIntW : AlgebraicGeometry.IsIntegral W.left)
    [AlgebraicGeometry.IsProper W.hom]
    (ι₁ : W ⟶ weilProjectiveSpaceOver Ω (N' + 1))
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left) :
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U_chart : Fin (N' + 1 + 1) → W.left.Opens :=
      fun α => (TopologicalSpace.Opens.map ι₁.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α))
    let B : Fin (N' + 1 + 1) → Type u :=
      fun α => ↑(W.left.presheaf.obj (Opposite.op (U_chart α)))
    ∀ (b₀ : W.left)
      (q₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left)
      (c_F : Fin (N' + 1) → Ω)
      (K₁ K₂ : Set W.left),
      b₀ ∈ K₁ →
      IsClosed ({b₀} : Set W.left) →
      q₀ ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) →
      Set.range q₀.base = {b₀} →
      ι₁.left.base b₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) →
      (∀ p : (weilProjectiveSpaceOver Ω (N' + 1)).left,
        p ≠ ι₁.left.base b₀ →
        ∃ β : Fin (N' + 1),
          p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β.succ)) →
      K₁ ∪ K₂ =
        { w : W.left | ι₁.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1)
          (∑ β : Fin (N' + 1), MvPolynomial.C (c_F β) * MvPolynomial.X β.succ) } →
      ∀ (hAff : ∀ α : Fin (N' + 1 + 1), AlgebraicGeometry.IsAffineOpen (U_chart α))
        [∀ α : Fin (N' + 1 + 1), Algebra Ω (B α)]
        [∀ α : Fin (N' + 1 + 1), Algebra.FiniteType Ω (B α)]
        (r_coord : ∀ α : Fin (N' + 1 + 1), Fin (N' + 1 + 1) → B α)
        (ev₀ : B 0 →ₐ[Ω] Ω),
      (∀ α : Fin (N' + 1 + 1), r_coord α α = 1) →
      (∀ (α : Fin (N' + 1 + 1)) (c : Fin (N' + 1 + 1) → Ω) (x : ↥(U_chart α)),
        ι₁.left.base x.1 ∈ weilProjHyperplaneSet Ω (N' + 1)
          (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ↔
        (∑ a : Fin (N' + 1 + 1), algebraMap Ω (B α) (c a) * r_coord α a) ∈
          ((hAff α).primeIdealOf x).asIdeal) →
      (∀ α : Fin (N' + 1 + 1),
        (hAff α).fromSpec ≫ W.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (B α)))) →
      (∀ α α' : Fin (N' + 1 + 1),
        U_chart α ⊓ U_chart α' = W.left.basicOpen (r_coord α α')) →
      (∀ α α' : Fin (N' + 1 + 1),
        let res_L := (W.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom
        let res_R := (W.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom
        (∀ c : Ω, res_R (algebraMap Ω (B α') c) = res_L (algebraMap Ω (B α) c)) ∧
        (∀ a : Fin (N' + 1 + 1),
          res_R (r_coord α' a) * res_L (r_coord α α') = res_L (r_coord α a))) →
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫ (hAff 0).fromSpec = q₀ ∧
        RingHom.ker ev₀.toRingHom =
          Ideal.span (Set.range (fun β : Fin (N' + 1) => r_coord 0 β.succ))) →
      IsDomain (B 0) →
      (∀ β : Fin (N' + 1), Nontrivial (B β.succ) → IsDomain (B β.succ)) →
      ∀ (L : Type u) [Field L] [Algebra Ω L]
        (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
        [Algebra Ω R] [Algebra L R] [IsScalarTower Ω L R]
        (ϖ : R) (ev_R : R →ₐ[L] L)
        (u_L : Fin (d - 2) → Fin (N' + 1) → L)
        (v_L : Fin (N' + 1) → L),
      let K_gen : Type u := FractionRing R
      let h_eq_R : ∀ (α : Fin (N' + 1 + 1)), Fin (d - 2) → TensorProduct Ω (B α) R :=
        fun α i => ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (algebraMap L R (u_L i γ))
      let p_eq_R : ∀ (α : Fin (N' + 1 + 1)), TensorProduct Ω (B α) R :=
        fun α =>
          (∑ γ : Fin (N' + 1),
            (algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ) ⊗ₜ[Ω] (1 : R)) +
          (∑ γ : Fin (N' + 1),
            (r_coord α γ.succ) ⊗ₜ[Ω] (ϖ * algebraMap L R (v_L γ)))
      let J_R : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) R) :=
        fun α => Ideal.span ({p_eq_R α} ∪ Set.range (h_eq_R α))
      let toK : ∀ (α : Fin (N' + 1 + 1)),
          TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) K_gen :=
        fun α =>
          (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
            (IsScalarTower.toAlgHom Ω R K_gen)).toRingHom
      let toL : ∀ (α : Fin (N' + 1 + 1)),
          TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) L :=
        fun α =>
          (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
            (ev_R.restrictScalars Ω)).toRingHom
      let J_K : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) K_gen) :=
        fun α => Ideal.map (toK α) (J_R α)
      let J_L : ∀ (β : Fin (N' + 1)), Ideal (TensorProduct Ω (B β.succ) L) :=
        fun β => Ideal.map (toL β.succ) (J_R β.succ)
      let m0_K : Ideal (TensorProduct Ω (B 0) K_gen) :=
        RingHom.ker
          (Algebra.TensorProduct.lift ((Algebra.ofId Ω K_gen).comp ev₀) (AlgHom.id Ω K_gen)
            (fun _ _ => Commute.all _ _)).toRingHom
      ϖ ≠ 0 →
      IsLocalRing.maximalIdeal R = Ideal.span {ϖ} →
      RingHom.ker ev_R.toRingHom = Ideal.span {ϖ} →
      (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
        IsDomain ((TensorProduct Ω (B β.succ) K_gen) ⧸ J_K β.succ) ∧
        ringKrullDim ((TensorProduct Ω (B β.succ) K_gen) ⧸ J_K β.succ) ≤ (1 : WithBot ℕ∞) ∧
        ∀ b : B β.succ, b ≠ 0 → b ⊗ₜ[Ω] (1 : K_gen) ∉ J_K β.succ) →
      (∃ (Q₀ : PrimeSpectrum (TensorProduct Ω (B 0) K_gen)) (β₁ : Fin (N' + 1)),
        J_K 0 ≤ Q₀.asIdeal ∧
        Q₀.asIdeal ≤ m0_K ∧
        r_coord 0 β₁.succ ⊗ₜ[Ω] (1 : K_gen) ∉ Q₀.asIdeal ∧
        (1 : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω (B 0) K_gen) ⧸ Q₀.asIdeal)) →
      (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
        ringKrullDim ((TensorProduct Ω (B β.succ) L) ⧸ J_L β) ≤ (1 : WithBot ℕ∞)) →
      ∀ (β₂ : Fin (N' + 1)),
      Nontrivial (B β₂.succ) →
      ∀ (𝔮_L : PrimeSpectrum (TensorProduct Ω (B β₂.succ) L)),
      (hAff β₂.succ).fromSpec.base
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeLeft :
            B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L).toRingHom 𝔮_L) ∈ K₂ →
      Ideal.comap (toK β₂.succ) (J_K β₂.succ) ≤
        (PrimeSpectrum.comap (toL β₂.succ) 𝔮_L).asIdeal →
      ∃ (N : ℕ)
        (𝒴_R : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsIntegral 𝒴_R)
        (p_R : 𝒴_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (_ : AlgebraicGeometry.IsProper p_R)
        (_ : AlgebraicGeometry.Surjective p_R)
        (σ_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ 𝒴_R)
        (gProj : 𝒴_R ⟶ (weilProjectiveSpaceOver L N).left)
        (hComm : gProj ≫ (weilProjectiveSpaceOver L N).hom =
          p_R ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L R)))
        (π_fib :
          ↥(CategoryTheory.Limits.pullback p_R
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) →
          ↥W.left),
        (σ_R ≫ p_R = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R))) ∧
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.lift gProj p_R hComm) ∧
        topologicalKrullDim
          ↥(CategoryTheory.Limits.pullback p_R
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) ≤
          (1 : WithBot ℕ∞) ∧
        Continuous π_fib ∧
        (∀ y₀, π_fib y₀ ∈ K₁ ∪ K₂) ∧
        (∃ y₁, π_fib y₁ ∈ K₁) ∧
        (∃ y₂, π_fib y₂ ∈ K₂) :=
by
  intro 𝒜 hGrad𝒜 U_chart B b₀ q₀ c_F K₁ K₂
    hb₀_K₁ hb₀_cl hq₀_hom hq₀_range hb₀_chart0 hCompl_b₀ hUnion
    hAff hAlgB hFTB r_coord ev₀ hr_diag hr_vanish hFromSpec hInter hScale hev₀
    hDom₀ hDom
    L hFieldL hAlgΩL R hCommR hDomR hLocR hAlgΩR hAlgLR hTowerΩLR
    ϖ ev_R u_L v_L
    K_gen h_eq_R p_eq_R J_R toK toL J_K J_L m0_K
    _hϖ_ne _hMax hev_R_ker hGen_dom hOrigin_Q₀ hSpec_dim
    β₂ hNontriv₂ 𝔮_L h𝔮_K₂ h𝔮_lift
  
  have hb₀_U0 : b₀ ∈ U_chart 0 := hb₀_chart0
  have hCover_compl : ∀ w : W.left, w ≠ b₀ → ∃ β : Fin (N' + 1), w ∈ U_chart β.succ := by
    intro w hw
    let _ : AlgebraicGeometry.IsClosedImmersion ι₁.left := hCl₁
    exact hCompl_b₀ (ι₁.left.base w) (fun h => hw (ι₁.left.isClosedEmbedding.injective h))
  obtain ⟨hLoc_ov, hChartBC, hKrullBound⟩ :=
    weil_algClosed_chart_baseChange_and_special_fiber_krullDim_le_one
      Ω N' W U_chart hAff r_coord b₀ q₀ ev₀ hFromSpec hInter
      hb₀_U0 hb₀_cl hq₀_range hev₀.1 hCover_compl
  let s_ΩR := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R))
  let W_R := CategoryTheory.Limits.pullback W.hom s_ΩR
  let fst_R := CategoryTheory.Limits.pullback.fst W.hom s_ΩR
  let snd_R := CategoryTheory.Limits.pullback.snd W.hom s_ΩR
  let s_ΩL := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω L))
  let W_L := CategoryTheory.Limits.pullback W.hom s_ΩL
  let fst_L := CategoryTheory.Limits.pullback.fst W.hom s_ΩL
  let snd_L := CategoryTheory.Limits.pullback.snd W.hom s_ΩL
  obtain ⟨ψ_R, hψ_R_fst, hψ_R_snd, hψ_R_open, hψ_R_range, hψ_R_ov⟩ := hChartBC R
  obtain ⟨ψ_L, hψ_L_fst, hψ_L_snd, hψ_L_open, hψ_L_range, _⟩ := hChartBC L

  
  let s_vec : Fin ((d - 2) + 1) → Fin (N' + 1) → K_gen :=
    Fin.cases
      (fun γ => algebraMap Ω K_gen (c_F γ) + algebraMap R K_gen (ϖ * algebraMap L R (v_L γ)))
      (fun i γ => algebraMap R K_gen (algebraMap L R (u_L i γ)))
  have hJK_eq : ∀ α : Fin (N' + 1 + 1),
      J_K α = Ideal.span
        (Set.range fun k : Fin ((d - 2) + 1) =>
          ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (s_vec k γ)) := by
    intro α
    have hp_map : toK α (p_eq_R α) =
        ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (s_vec 0 γ) := by
      dsimp [toK, p_eq_R, s_vec]
      simp only [map_add, map_sum, Algebra.TensorProduct.map_tmul,
        AlgHom.id_apply, IsScalarTower.toAlgHom_apply, map_one]
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun γ _ => ?_
      have hsmul : (algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ) ⊗ₜ[Ω] (1 : K_gen) =
          (r_coord α γ.succ) ⊗ₜ[Ω] (algebraMap Ω K_gen (c_F γ)) := by
        rw [← Algebra.smul_def, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      rw [hsmul, ← TensorProduct.tmul_add]
    have hh_map : ∀ i : Fin (d - 2),
        toK α (h_eq_R α i) =
          ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (s_vec i.succ γ) := by
      intro i
      dsimp [toK, h_eq_R, s_vec]
      simp only [map_sum, Algebra.TensorProduct.map_tmul,
        AlgHom.id_apply, IsScalarTower.toAlgHom_apply]
    dsimp [J_K, J_R]
    rw [Ideal.map_span]
    congr 1
    ext x
    simp only [Set.mem_image, Set.mem_range]
    constructor
    · rintro ⟨y, rfl | ⟨i, rfl⟩, rfl⟩
      · exact ⟨0, hp_map.symm⟩
      · exact ⟨i.succ, (hh_map i).symm⟩
    · rintro ⟨k, rfl⟩
      refine Fin.cases ?_ ?_ k
      · exact ⟨p_eq_R α, Or.inl rfl, hp_map⟩
      · intro i
        exact ⟨h_eq_R α i, Or.inr ⟨i, rfl⟩, hh_map i⟩

  
  have hOv_pt : ∀ (α α' : Fin (N' + 1 + 1))
      (Q_α : PrimeSpectrum (TensorProduct Ω (B α) K_gen))
      (Q_α' : PrimeSpectrum (TensorProduct Ω (B α') K_gen)),
      Nontrivial (B α') →
      IsDomain ((TensorProduct Ω (B α') K_gen) ⧸ J_K α') →
      ringKrullDim ((TensorProduct Ω (B α') K_gen) ⧸ J_K α') ≤ (1 : WithBot ℕ∞) →
      r_coord α' α ⊗ₜ[Ω] (1 : K_gen) ∉ J_K α' →
      Q_α'.asIdeal = J_K α' →
      J_K α ≤ Q_α.asIdeal →
      r_coord α α' ⊗ₜ[Ω] (1 : K_gen) ∉ Q_α.asIdeal →
      (Q_α.asIdeal = J_K α ∨
        (1 : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω (B α) K_gen) ⧸ Q_α.asIdeal)) →
      (ψ_R α).base (PrimeSpectrum.comap (toK α) Q_α) =
        (ψ_R α').base (PrimeSpectrum.comap (toK α') Q_α') := by
    intro α α' Q_α Q_α' _hNt' hDom_K' hDim_K' hr_R hQ_α'_eq hJK_le hr_L hDisj
    let C := ↑(W.left.presheaf.obj (Opposite.op (U_chart α ⊓ U_chart α')))
    let res_L := (W.left.presheaf.map
      (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom
    let res_R := (W.left.presheaf.map
      (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom
    have hΩ_ov : ∀ c : Ω, res_R (algebraMap Ω (B α') c) = res_L (algebraMap Ω (B α) c) :=
      (hScale α α').1
    have hUnit_ov : res_R (r_coord α' α) * res_L (r_coord α α') = 1 := by
      have h := (hScale α α').2 α
      rwa [hr_diag α, map_one] at h
    have hScale_ov : ∀ γ : Fin (N' + 1),
        res_R (r_coord α' γ.succ) * res_L (r_coord α α') = res_L (r_coord α γ.succ) :=
      fun γ => (hScale α α').2 γ.succ
    have hDom_I1 : IsDomain ((TensorProduct Ω (B α') K_gen) ⧸
        Ideal.span (Set.range fun k : Fin ((d - 2) + 1) =>
          ∑ γ : Fin (N' + 1), (r_coord α' γ.succ) ⊗ₜ[Ω] (s_vec k γ))) := by
      rwa [← hJK_eq α']
    have hDim_I1 : ringKrullDim ((TensorProduct Ω (B α') K_gen) ⧸
        Ideal.span (Set.range fun k : Fin ((d - 2) + 1) =>
          ∑ γ : Fin (N' + 1), (r_coord α' γ.succ) ⊗ₜ[Ω] (s_vec k γ))) ≤ (1 : WithBot ℕ∞) := by
      rwa [← hJK_eq α']
    have hr_R' : r_coord α' α ⊗ₜ[Ω] (1 : K_gen) ∉
        Ideal.span (Set.range fun k : Fin ((d - 2) + 1) =>
          ∑ γ : Fin (N' + 1), (r_coord α' γ.succ) ⊗ₜ[Ω] (s_vec k γ)) := by
      rwa [← hJK_eq α']
    have hI0_le : Ideal.span (Set.range fun k : Fin ((d - 2) + 1) =>
          ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (s_vec k γ)) ≤ Q_α.asIdeal := by
      rwa [← hJK_eq α]
    have hDisj' : Q_α.asIdeal = Ideal.span (Set.range fun k : Fin ((d - 2) + 1) =>
          ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (s_vec k γ)) ∨
        (1 : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω (B α) K_gen) ⧸ Q_α.asIdeal) := by
      rwa [← hJK_eq α]
    obtain ⟨P_ov, hP_L, hP_R_ideal⟩ :=
      weil_dvr_pencil_overlap_and_origin_prime_compatibility
        Ω K_gen (N' + 1) ((d - 2) + 1) (B α) (B α') C
        res_L res_R (r_coord α α') (r_coord α' α)
        (fun γ => r_coord α γ.succ) (fun γ => r_coord α' γ.succ) s_vec
        hΩ_ov (hLoc_ov α α').1 (hLoc_ov α α').2 hUnit_ov hScale_ov
        hDom_I1 hDim_I1 hr_R' Q_α hI0_le hr_L hDisj'
    let _ : Algebra Ω C := (res_L.comp (algebraMap Ω (B α))).toAlgebra
    have hP_R : PrimeSpectrum.comap
        (Algebra.TensorProduct.map (⟨res_R, hΩ_ov⟩ : B α' →ₐ[Ω] C)
          (AlgHom.id Ω K_gen)).toRingHom P_ov = Q_α' := by
      apply PrimeSpectrum.ext
      rw [hP_R_ideal, ← hJK_eq α', hQ_α'_eq]
    let toK_C : TensorProduct Ω C R →+* TensorProduct Ω C K_gen :=
      (Algebra.TensorProduct.map (AlgHom.id Ω C)
        (IsScalarTower.toAlgHom Ω R K_gen)).toRingHom
    let Φ_L_R : TensorProduct Ω (B α) R →+* TensorProduct Ω C R :=
      (Algebra.TensorProduct.map (⟨res_L, fun _ => rfl⟩ : B α →ₐ[Ω] C)
        (AlgHom.id Ω R)).toRingHom
    let Φ_R_R : TensorProduct Ω (B α') R →+* TensorProduct Ω C R :=
      (Algebra.TensorProduct.map (⟨res_R, hΩ_ov⟩ : B α' →ₐ[Ω] C)
        (AlgHom.id Ω R)).toRingHom
    have hComm_L : toK_C.comp Φ_L_R =
        (Algebra.TensorProduct.map (⟨res_L, fun _ => rfl⟩ : B α →ₐ[Ω] C)
          (AlgHom.id Ω K_gen)).toRingHom.comp (toK α) := by
      dsimp [toK_C, Φ_L_R, toK]
      rw [← AlgHom.comp_toRingHom, ← AlgHom.comp_toRingHom]
      congr 1
      ext x <;> simp
    have hComm_R : toK_C.comp Φ_R_R =
        (Algebra.TensorProduct.map (⟨res_R, hΩ_ov⟩ : B α' →ₐ[Ω] C)
          (AlgHom.id Ω K_gen)).toRingHom.comp (toK α') := by
      dsimp [toK_C, Φ_R_R, toK]
      rw [← AlgHom.comp_toRingHom, ← AlgHom.comp_toRingHom]
      congr 1
      ext x <;> simp
    let P_R := PrimeSpectrum.comap toK_C P_ov
    have hL_pt : PrimeSpectrum.comap Φ_L_R P_R = PrimeSpectrum.comap (toK α) Q_α := by
      dsimp [P_R]
      rw [← PrimeSpectrum.comap_comp_apply, hComm_L, PrimeSpectrum.comap_comp_apply, hP_L]
    have hR_pt : PrimeSpectrum.comap Φ_R_R P_R = PrimeSpectrum.comap (toK α') Q_α' := by
      dsimp [P_R]
      rw [← PrimeSpectrum.comap_comp_apply, hComm_R, PrimeSpectrum.comap_comp_apply, hP_R]
    have hOv_map := congrArg (fun f => f.base P_R) (hψ_R_ov α α' hΩ_ov)
    change (ψ_R α).base (PrimeSpectrum.comap Φ_L_R P_R) =
      (ψ_R α').base (PrimeSpectrum.comap Φ_R_R P_R) at hOv_map
    rwa [hL_pt, hR_pt] at hOv_map

  
  have hPrime_β : ∀ (β : Fin (N' + 1)), Nontrivial (B β.succ) → (J_K β.succ).IsPrime := by
    intro β hNt
    have _ : IsDomain ((TensorProduct Ω (B β.succ) K_gen) ⧸ J_K β.succ) := (hGen_dom β hNt).1
    exact (Ideal.Quotient.isDomain_iff_prime (J_K β.succ)).mp inferInstance
  let D_gen : Type u := (TensorProduct Ω (B β₂.succ) K_gen) ⧸ J_K β₂.succ
  let _ : IsDomain D_gen := (hGen_dom β₂ hNontriv₂).1
  let Q_β₂ : PrimeSpectrum (TensorProduct Ω (B β₂.succ) K_gen) :=
    ⟨J_K β₂.succ, hPrime_β β₂ hNontriv₂⟩
  let j_gen : AlgebraicGeometry.Spec (CommRingCat.of D_gen) ⟶ W_R :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk (J_K β₂.succ)).comp (toK β₂.succ))) ≫ ψ_R β₂.succ
  have hj_gen_bot : j_gen.base (⊥ : PrimeSpectrum D_gen) =
      (ψ_R β₂.succ).base (PrimeSpectrum.comap (toK β₂.succ) Q_β₂) := by
    change (ψ_R β₂.succ).base
      (PrimeSpectrum.comap ((Ideal.Quotient.mk (J_K β₂.succ)).comp (toK β₂.succ))
        (⊥ : PrimeSpectrum D_gen)) = _
    congr 1
    rw [PrimeSpectrum.comap_comp_apply]
    congr 1
    apply PrimeSpectrum.ext
    change Ideal.comap (Ideal.Quotient.mk (J_K β₂.succ)) ⊥ = J_K β₂.succ
    rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]

  
  have hGen_agree : ∀ (β : Fin (N' + 1)) (hNt : Nontrivial (B β.succ)),
      (ψ_R β.succ).base
        (PrimeSpectrum.comap (toK β.succ) ⟨J_K β.succ, hPrime_β β hNt⟩) =
      j_gen.base (⊥ : PrimeSpectrum D_gen) := by
    intro β hNt
    let _ : IrreducibleSpace ↥W.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral W.left
    have hNe_β : (U_chart β.succ : Set W.left).Nonempty := by
      obtain ⟨p⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNt
      rw [← (hAff β.succ).range_fromSpec]
      exact ⟨_, ⟨p, rfl⟩⟩
    have hNe_β₂ : (U_chart β₂.succ : Set W.left).Nonempty := by
      obtain ⟨p⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNontriv₂
      rw [← (hAff β₂.succ).range_fromSpec]
      exact ⟨_, ⟨p, rfl⟩⟩
    obtain ⟨w_ov, hw_β, hw_β₂⟩ := nonempty_preirreducible_inter
      (U_chart β.succ).isOpen (U_chart β₂.succ).isOpen hNe_β hNe_β₂
    have hr_L_ne : r_coord β.succ β₂.succ ≠ 0 := by
      intro h0
      have hw_in : w_ov ∈ U_chart β.succ ⊓ U_chart β₂.succ := ⟨hw_β, hw_β₂⟩
      rw [hInter β.succ β₂.succ, h0, AlgebraicGeometry.Scheme.basicOpen_zero] at hw_in
      exact hw_in
    have hr_R_ne : r_coord β₂.succ β.succ ≠ 0 := by
      intro h0
      have hw_in : w_ov ∈ U_chart β₂.succ ⊓ U_chart β.succ := ⟨hw_β₂, hw_β⟩
      rw [hInter β₂.succ β.succ, h0, AlgebraicGeometry.Scheme.basicOpen_zero] at hw_in
      exact hw_in
    rw [hj_gen_bot]
    exact hOv_pt β.succ β₂.succ ⟨J_K β.succ, hPrime_β β hNt⟩ Q_β₂
      hNontriv₂ (hGen_dom β₂ hNontriv₂).1 (hGen_dom β₂ hNontriv₂).2.1
      ((hGen_dom β₂ hNontriv₂).2.2 _ hr_R_ne) rfl (le_refl _)
      ((hGen_dom β hNt).2.2 _ hr_L_ne) (Or.inl rfl)

  
  obtain ⟨Q₀, β₁, hJK0_le, hQ₀_le_m0, hr0_β₁_not_mem, hQ₀_dim⟩ := hOrigin_Q₀
  have hr0_β₁_ne : r_coord 0 β₁.succ ≠ 0 := by
    intro h0
    apply hr0_β₁_not_mem
    rw [h0, TensorProduct.zero_tmul]
    exact Q₀.asIdeal.zero_mem
  let _ : IsDomain (B 0) := hDom₀
  have hbot_in_bo : (⊥ : PrimeSpectrum (B 0)) ∈ PrimeSpectrum.basicOpen (r_coord 0 β₁.succ) := by
    rw [PrimeSpectrum.mem_basicOpen]
    exact hr0_β₁_ne
  have hw0_in_inter : (hAff 0).fromSpec.base (⊥ : PrimeSpectrum (B 0)) ∈
      U_chart 0 ⊓ U_chart β₁.succ := by
    rw [hInter 0 β₁.succ]
    have hpre := (hAff 0).fromSpec_preimage_basicOpen (r_coord 0 β₁.succ)
    have hmem : (⊥ : PrimeSpectrum (B 0)) ∈
        (TopologicalSpace.Opens.map (hAff 0).fromSpec.base).obj
          (W.left.basicOpen (r_coord 0 β₁.succ)) := by
      rwa [hpre]
    exact hmem
  have hNontriv₁ : Nontrivial (B β₁.succ) :=
    PrimeSpectrum.nonempty_iff_nontrivial.mp
      ⟨(hAff β₁.succ).primeIdealOf ⟨_, hw0_in_inter.2⟩⟩
  have hr_β₁_0_ne : r_coord β₁.succ 0 ≠ 0 := by
    intro h0
    have hw_in : (hAff 0).fromSpec.base (⊥ : PrimeSpectrum (B 0)) ∈
        U_chart β₁.succ ⊓ U_chart 0 := ⟨hw0_in_inter.2, hw0_in_inter.1⟩
    rw [hInter β₁.succ 0, h0, AlgebraicGeometry.Scheme.basicOpen_zero] at hw_in
    exact hw_in
  have hQ₀_eq_gen : (ψ_R 0).base (PrimeSpectrum.comap (toK 0) Q₀) =
      j_gen.base (⊥ : PrimeSpectrum D_gen) := by
    calc (ψ_R 0).base (PrimeSpectrum.comap (toK 0) Q₀)
        = (ψ_R β₁.succ).base
            (PrimeSpectrum.comap (toK β₁.succ) ⟨J_K β₁.succ, hPrime_β β₁ hNontriv₁⟩) :=
          hOv_pt 0 β₁.succ Q₀ ⟨J_K β₁.succ, hPrime_β β₁ hNontriv₁⟩
            hNontriv₁ (hGen_dom β₁ hNontriv₁).1 (hGen_dom β₁ hNontriv₁).2.1
            ((hGen_dom β₁ hNontriv₁).2.2 _ hr_β₁_0_ne) rfl hJK0_le
            hr0_β₁_not_mem (Or.inr hQ₀_dim)
      _ = j_gen.base (⊥ : PrimeSpectrum D_gen) := hGen_agree β₁ hNontriv₁

  let σ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W_R :=
    CategoryTheory.Limits.pullback.lift (s_ΩR ≫ q₀)
      (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)))
      (by rw [CategoryTheory.Category.assoc, hq₀_hom,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let ev0_R : TensorProduct Ω (B 0) R →ₐ[Ω] R :=
    Algebra.TensorProduct.lift ((Algebra.ofId Ω R).comp ev₀) (AlgHom.id Ω R)
      (fun _ _ => Commute.all _ _)
  have hσ_W_eq :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_R.toRingHom) ≫ ψ_R 0 = σ_W := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hψ_R_fst 0, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hcomp_L : ev0_R.toRingHom.comp
          (Algebra.TensorProduct.includeLeft : B 0 →ₐ[Ω] TensorProduct Ω (B 0) R).toRingHom =
          (algebraMap Ω R).comp ev₀.toRingHom := by
        ext b
        simp [ev0_R]
      rw [hcomp_L, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, hev₀.1, CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Category.assoc, hψ_R_snd 0, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hcomp_R : ev0_R.toRingHom.comp
          (Algebra.TensorProduct.includeRight : R →ₐ[Ω] TensorProduct Ω (B 0) R).toRingHom =
          RingHom.id R := by
        ext r
        simp [ev0_R]
      rw [hcomp_R, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
        CategoryTheory.Limits.pullback.lift_snd]
  have hσ_W_mem_cl : σ_W.base (⊥ : PrimeSpectrum R) ∈
      closure ({j_gen.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) := by
    have hσ_pt : σ_W.base (⊥ : PrimeSpectrum R) =
        (ψ_R 0).base (PrimeSpectrum.comap ev0_R.toRingHom (⊥ : PrimeSpectrum R)) :=
      congrArg (fun f => f.base (⊥ : PrimeSpectrum R)) hσ_W_eq.symm
    rw [← hQ₀_eq_gen, hσ_pt]
    have hle_ideal : (PrimeSpectrum.comap (toK 0) Q₀).asIdeal ≤
        (PrimeSpectrum.comap ev0_R.toRingHom (⊥ : PrimeSpectrum R)).asIdeal := by
      intro z hz
      have hz_K : toK 0 z ∈ m0_K := hQ₀_le_m0 hz
      let ev0_K : TensorProduct Ω (B 0) K_gen →ₐ[Ω] K_gen :=
        Algebra.TensorProduct.lift ((Algebra.ofId Ω K_gen).comp ev₀) (AlgHom.id Ω K_gen)
          (fun _ _ => Commute.all _ _)
      have hcomm_ev : (IsScalarTower.toAlgHom Ω R K_gen).comp ev0_R =
          ev0_K.comp (Algebra.TensorProduct.map (AlgHom.id Ω (B 0))
            (IsScalarTower.toAlgHom Ω R K_gen)) := by
        ext x <;> simp [ev0_R, ev0_K, Algebra.ofId_apply, IsScalarTower.algebraMap_apply Ω R K_gen]
      have heval_zero : algebraMap R K_gen (ev0_R z) = 0 := by
        have h1 := AlgHom.congr_fun hcomm_ev z
        simpa only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply] using
          h1.trans (RingHom.mem_ker.mp hz_K)
      have hev0_z : ev0_R z = 0 :=
        (IsFractionRing.injective R K_gen) (heval_zero.trans (map_zero _).symm)
      change ev0_R z ∈ (⊥ : Ideal R)
      rw [hev0_z]
      exact Submodule.zero_mem ⊥
    let q₀_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω (B 0) R))) :=
      PrimeSpectrum.comap (toK 0) Q₀
    let p₀_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω (B 0) R))) :=
      PrimeSpectrum.comap ev0_R.toRingHom (⊥ : PrimeSpectrum R)
    have hmem_cl_spec : p₀_pt ∈ closure ({q₀_pt} : Set _) := by
      change PrimeSpectrum.comap ev0_R.toRingHom (⊥ : PrimeSpectrum R) ∈
        closure ({PrimeSpectrum.comap (toK 0) Q₀} : Set (PrimeSpectrum (TensorProduct Ω (B 0) R)))
      rw [PrimeSpectrum.closure_singleton]
      exact hle_ideal
    have himg := image_closure_subset_closure_image (ψ_R 0).continuous
      ⟨p₀_pt, hmem_cl_spec, rfl⟩
    rwa [Set.image_singleton] at himg

  
  obtain ⟨𝒴_R, hInt_𝒴, ι_𝒴, hCl_ι𝒴, p_R, hProp_pR, hSurj_pR, σ_R,
      hp_R_eq, hRange_ι𝒴, hσ_ι, hSec⟩ :=
    weil_dvr_schematic_closure_integral_and_section_lift
      Ω R D_gen W q₀ hq₀_hom j_gen hσ_W_mem_cl
  let _ : AlgebraicGeometry.IsClosedImmersion ι_𝒴 := hCl_ι𝒴
  obtain ⟨N, ι_WL, hCl_WL⟩ :=
    weil_isProjectiveOverField_baseChange Ω L W ⟨N' + 1, ι₁, hCl₁⟩
  let P_LN := weilProjectiveSpaceOver L N
  let ι_WL_hom : W_L ⟶ P_LN.left := ι_WL.left
  have hι_WL_w : ι_WL_hom ≫ P_LN.hom = snd_L := CategoryTheory.Over.w ι_WL
  let _ : AlgebraicGeometry.IsClosedImmersion ι_WL_hom := hCl_WL
  let s_LR := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L R))
  let bc_WL_WR : W_R ⟶ W_L := weilBaseChangeMap Ω L R W
  have hs_tower : s_LR ≫ s_ΩL = s_ΩR := by
    dsimp [s_LR, s_ΩL, s_ΩR]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq Ω L R]
  have hPB_WL_WR : CategoryTheory.IsPullback bc_WL_WR snd_R snd_L s_LR := by
    have hOuter : CategoryTheory.IsPullback (bc_WL_WR ≫ fst_L) snd_R W.hom (s_LR ≫ s_ΩL) := by
      have hfst_eq : bc_WL_WR ≫ fst_L = fst_R :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst_eq, hs_tower]
      exact CategoryTheory.IsPullback.of_hasPullback W.hom s_ΩR
    exact CategoryTheory.IsPullback.of_right hOuter
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback W.hom s_ΩL)
  have hφ_WR_comm : (bc_WL_WR ≫ ι_WL_hom) ≫ P_LN.hom = snd_R ≫ s_LR := by
    rw [CategoryTheory.Category.assoc, hι_WL_w]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  let φ_WR : W_R ⟶ CategoryTheory.Limits.pullback P_LN.hom s_LR :=
    CategoryTheory.Limits.pullback.lift (bc_WL_WR ≫ ι_WL_hom) snd_R hφ_WR_comm
  have hPB_φ_WR : CategoryTheory.IsPullback bc_WL_WR φ_WR ι_WL_hom
      (CategoryTheory.Limits.pullback.fst P_LN.hom s_LR) := by
    refine CategoryTheory.IsPullback.of_bot ?_
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      (CategoryTheory.IsPullback.of_hasPullback P_LN.hom s_LR)
    have hl : φ_WR ≫ CategoryTheory.Limits.pullback.snd P_LN.hom s_LR = snd_R :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    rw [hl, hι_WL_w]
    exact hPB_WL_WR
  let _ : AlgebraicGeometry.IsClosedImmersion φ_WR :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPB_φ_WR hCl_WL
  let gProj : 𝒴_R ⟶ P_LN.left := ι_𝒴 ≫ bc_WL_WR ≫ ι_WL_hom
  have hComm : gProj ≫ P_LN.hom = p_R ≫ s_LR := by
    dsimp [gProj]
    rw [CategoryTheory.Category.assoc, hφ_WR_comm, hp_R_eq, CategoryTheory.Category.assoc]
  have hLift_eq : CategoryTheory.Limits.pullback.lift gProj p_R hComm = ι_𝒴 ≫ φ_WR := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, hp_R_eq]
  have hClosed_lift :
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift gProj p_R hComm) := by
    rw [hLift_eq]
    infer_instance

  
  let I_ϖ : Ideal R := Ideal.span {ϖ}
  let ι_0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_ϖ))
  let 𝒴_0 := CategoryTheory.Limits.pullback p_R ι_0
  let fst_0 := CategoryTheory.Limits.pullback.fst p_R ι_0
  let snd_0 := CategoryTheory.Limits.pullback.snd p_R ι_0
  let π_fib : ↥𝒴_0 → ↥W.left := (fst_0 ≫ ι_𝒴 ≫ fst_R).base
  have hCont_π : Continuous π_fib := (fst_0 ≫ ι_𝒴 ≫ fst_R).continuous

  have hev_R_surj : Function.Surjective ev_R.toRingHom :=
    fun x => ⟨algebraMap L R x, ev_R.commutes x⟩
  let e_res : (R ⧸ I_ϖ) ≃+* L :=
    (Ideal.quotEquivOfEq hev_R_ker.symm).trans
      (RingHom.quotientKerEquivOfSurjective hev_R_surj)
  have he_res_mk : e_res.toRingHom.comp (Ideal.Quotient.mk I_ϖ) = ev_R.toRingHom := by
    ext r
    rfl
  let s_evR := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_R.toRingHom)
  let iso_0 : AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ I_ϖ)) ≅
      AlgebraicGeometry.Spec (CommRingCat.of L) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_res.symm.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_res.toRingHom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h : e_res.symm.toRingHom.comp e_res.toRingHom = RingHom.id (R ⧸ I_ϖ) := by
          ext x; exact e_res.symm_apply_apply x
        rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h : e_res.toRingHom.comp e_res.symm.toRingHom = RingHom.id L := by
          ext x; exact e_res.apply_symm_apply x
        rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  have hiso_0_hom_ι : iso_0.inv ≫ ι_0 = s_evR := by
    dsimp [iso_0, ι_0, s_evR]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
  have hiso_0_hom_ev : iso_0.hom ≫ s_evR = ι_0 := by
    rw [← hiso_0_hom_ι, CategoryTheory.Iso.hom_inv_id_assoc]

  
  let x₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ I_ϖ))) :=
    iso_0.inv.base (⊥ : PrimeSpectrum L)
  let τ₁ : AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ I_ϖ)) ⟶ 𝒴_0 :=
    CategoryTheory.Limits.pullback.lift (ι_0 ≫ σ_R)
      (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ I_ϖ))))
      (by rw [CategoryTheory.Category.assoc, hSec,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hy₁ : ∃ y₁ : ↥𝒴_0, π_fib y₁ ∈ K₁ := by
    refine ⟨τ₁.base x₀, ?_⟩
    have hσ_fst : σ_W ≫ fst_R = s_ΩR ≫ q₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hcomp_τ₁ : τ₁ ≫ fst_0 ≫ ι_𝒴 ≫ fst_R = ι_0 ≫ s_ΩR ≫ q₀ := by
      calc τ₁ ≫ fst_0 ≫ ι_𝒴 ≫ fst_R
          = (τ₁ ≫ fst_0) ≫ ι_𝒴 ≫ fst_R := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (ι_0 ≫ σ_R) ≫ ι_𝒴 ≫ fst_R := by rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = ι_0 ≫ (σ_R ≫ ι_𝒴) ≫ fst_R := by simp only [CategoryTheory.Category.assoc]
        _ = ι_0 ≫ σ_W ≫ fst_R := by rw [hσ_ι]
        _ = ι_0 ≫ s_ΩR ≫ q₀ := by rw [hσ_fst]
    have hmem_range : π_fib (τ₁.base x₀) ∈ Set.range q₀.base := by
      change (τ₁ ≫ fst_0 ≫ ι_𝒴 ≫ fst_R).base x₀ ∈ Set.range q₀.base
      rw [hcomp_τ₁]
      exact ⟨(ι_0 ≫ s_ΩR).base x₀, rfl⟩
    rw [hq₀_range, Set.mem_singleton_iff] at hmem_range
    rw [hmem_range]
    exact hb₀_K₁

  
  have hPre_ι𝒴 : ∀ (β : Fin (N' + 1)), Nontrivial (B β.succ) →
      (ψ_R β.succ).base ⁻¹' Set.range ι_𝒴.base =
        PrimeSpectrum.zeroLocus (Ideal.comap (toK β.succ) (J_K β.succ)) := by
    intro β hNt
    let _ : AlgebraicGeometry.IsOpenImmersion (ψ_R β.succ) := hψ_R_open β.succ
    let p_β : PrimeSpectrum (TensorProduct Ω (B β.succ) R) :=
      PrimeSpectrum.comap (toK β.succ) ⟨J_K β.succ, hPrime_β β hNt⟩
    have hOpenEmb := (ψ_R β.succ).isOpenEmbedding
    rw [hRange_ι𝒴, ← hGen_agree β hNt,
      hOpenEmb.isOpenMap.preimage_closure_eq_closure_preimage (ψ_R β.succ).continuous]
    have hpre_sing : (ψ_R β.succ).base ⁻¹' {(ψ_R β.succ).base p_β} =
        ({p_β} : Set (PrimeSpectrum (TensorProduct Ω (B β.succ) R))) := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => hOpenEmb.injective h, fun h => h ▸ rfl⟩
    rw [hpre_sing]
    exact PrimeSpectrum.closure_singleton p_β

  
  have hy₂ : ∃ y₂ : ↥𝒴_0, π_fib y₂ ∈ K₂ := by
    let 𝔮_R : PrimeSpectrum (TensorProduct Ω (B β₂.succ) R) :=
      PrimeSpectrum.comap (toL β₂.succ) 𝔮_L
    have h𝔮_in_zl : 𝔮_R ∈ PrimeSpectrum.zeroLocus (Ideal.comap (toK β₂.succ) (J_K β₂.succ)) :=
      h𝔮_lift
    rw [← hPre_ι𝒴 β₂ hNontriv₂] at h𝔮_in_zl
    obtain ⟨y₂_R, hy₂_R⟩ := h𝔮_in_zl
    have hsnd_𝔮 : snd_R.base ((ψ_R β₂.succ).base 𝔮_R) =
        PrimeSpectrum.comap
          (Algebra.TensorProduct.includeRight :
            R →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom 𝔮_R :=
      congrArg (fun f => f.base 𝔮_R) (hψ_R_snd β₂.succ)
    have hfst_𝔮 : fst_R.base ((ψ_R β₂.succ).base 𝔮_R) =
        (hAff β₂.succ).fromSpec.base
          (PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft :
              B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom 𝔮_R) :=
      congrArg (fun f => f.base 𝔮_R) (hψ_R_fst β₂.succ)
    have hp_eq_ι0 : p_R.base y₂_R = ι_0.base x₀ := by
      have hp_val : p_R.base y₂_R = snd_R.base (ι_𝒴.base y₂_R) := by
        rw [hp_R_eq]; rfl
      have hι0_x₀ : ι_0.base x₀ = PrimeSpectrum.comap ev_R.toRingHom (⊥ : PrimeSpectrum L) :=
        congrArg (fun f => f.base (⊥ : PrimeSpectrum L)) hiso_0_hom_ι
      have hcomp_R : (toL β₂.succ).comp
          (Algebra.TensorProduct.includeRight :
            R →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom =
          (Algebra.TensorProduct.includeRight :
            L →ₐ[Ω] TensorProduct Ω (B β₂.succ) L).toRingHom.comp ev_R.toRingHom := by
        ext r
        simp [toL]
      have hcomap_R :
          PrimeSpectrum.comap
            (Algebra.TensorProduct.includeRight :
              R →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom 𝔮_R =
          PrimeSpectrum.comap ev_R.toRingHom (⊥ : PrimeSpectrum L) := by
        apply PrimeSpectrum.ext
        change Ideal.comap ((toL β₂.succ).comp
            (Algebra.TensorProduct.includeRight :
              R →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom) 𝔮_L.asIdeal = _
        rw [hcomp_R]
        have hsub : PrimeSpectrum.comap
            (Algebra.TensorProduct.includeRight :
              L →ₐ[Ω] TensorProduct Ω (B β₂.succ) L).toRingHom 𝔮_L = (⊥ : PrimeSpectrum L) :=
          Subsingleton.elim _ _
        exact congrArg (fun p => (PrimeSpectrum.comap ev_R.toRingHom p).asIdeal) hsub
      rw [hp_val, hy₂_R, hsnd_𝔮, hι0_x₀]
      exact hcomap_R
    obtain ⟨y₂, hy₂_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₂_R x₀ hp_eq_ι0
    refine ⟨y₂, ?_⟩
    have hπ_y₂ : π_fib y₂ =
        (hAff β₂.succ).fromSpec.base
          (PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft :
              B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L).toRingHom 𝔮_L) := by
      have hcomp_L : (toL β₂.succ).comp
          (Algebra.TensorProduct.includeLeft :
            B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom =
          (Algebra.TensorProduct.includeLeft :
            B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L).toRingHom := by
        ext b
        simp [toL]
      have hcomap_L :
          PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft :
              B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom 𝔮_R =
          PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft :
              B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L).toRingHom 𝔮_L := by
        apply PrimeSpectrum.ext
        change Ideal.comap ((toL β₂.succ).comp
            (Algebra.TensorProduct.includeLeft :
              B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) R).toRingHom) 𝔮_L.asIdeal = _
        rw [hcomp_L]
        rfl
      change fst_R.base (ι_𝒴.base (fst_0.base y₂)) = _
      rw [hy₂_fst, hy₂_R, hfst_𝔮]
      exact congrArg (hAff β₂.succ).fromSpec.base hcomap_L
    rw [hπ_y₂]
    exact h𝔮_K₂

  
  have hs_evR_Ω : s_evR ≫ s_ΩR = s_ΩL := by
    dsimp [s_evR, s_ΩR, s_ΩL]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext c
    rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply Ω L R]
    exact ev_R.commutes (algebraMap Ω L c)
  let i_LR : W_L ⟶ W_R :=
    CategoryTheory.Limits.pullback.lift fst_L (snd_L ≫ s_evR)
      (by rw [CategoryTheory.Category.assoc, hs_evR_Ω]; exact CategoryTheory.Limits.pullback.condition)
  have hPB_WL : CategoryTheory.IsPullback i_LR snd_L snd_R s_evR := by
    have hOuter : CategoryTheory.IsPullback (i_LR ≫ fst_R) snd_L W.hom (s_evR ≫ s_ΩR) := by
      have hfst_eq : i_LR ≫ fst_R = fst_L := CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst_eq, hs_evR_Ω]
      exact CategoryTheory.IsPullback.of_hasPullback W.hom s_ΩL
    exact CategoryTheory.IsPullback.of_right hOuter
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback W.hom s_ΩR)
  have hcond_0 : fst_0 ≫ p_R = snd_0 ≫ ι_0 := CategoryTheory.Limits.pullback.condition
  have hι_𝒴0_comm : (fst_0 ≫ ι_𝒴 ≫ fst_R) ≫ W.hom = (snd_0 ≫ iso_0.hom) ≫ s_ΩL := by
    calc (fst_0 ≫ ι_𝒴 ≫ fst_R) ≫ W.hom
        = fst_0 ≫ ι_𝒴 ≫ (fst_R ≫ W.hom) := by simp only [CategoryTheory.Category.assoc]
      _ = fst_0 ≫ (ι_𝒴 ≫ snd_R) ≫ s_ΩR := by
          rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
      _ = (fst_0 ≫ p_R) ≫ s_ΩR := by rw [← hp_R_eq, CategoryTheory.Category.assoc]
      _ = (snd_0 ≫ ι_0) ≫ s_ΩR := by rw [hcond_0]
      _ = (snd_0 ≫ iso_0.hom ≫ s_evR) ≫ s_ΩR := by rw [hiso_0_hom_ev]
      _ = (snd_0 ≫ iso_0.hom) ≫ s_evR ≫ s_ΩR := by simp only [CategoryTheory.Category.assoc]
      _ = (snd_0 ≫ iso_0.hom) ≫ s_ΩL := by rw [hs_evR_Ω]
  let ι_𝒴0 : 𝒴_0 ⟶ W_L :=
    CategoryTheory.Limits.pullback.lift (fst_0 ≫ ι_𝒴 ≫ fst_R) (snd_0 ≫ iso_0.hom) hι_𝒴0_comm
  have hι_𝒴0_iLR : ι_𝒴0 ≫ i_LR = fst_0 ≫ ι_𝒴 := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
    · have hp_fst : fst_0 ≫ p_R = (fst_0 ≫ ι_𝒴) ≫ snd_R := by
        rw [CategoryTheory.Category.assoc]
        exact congrArg (fst_0 ≫ ·) hp_R_eq
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc, hiso_0_hom_ev, ← hcond_0, hp_fst]
  have hPB_𝒴0 : CategoryTheory.IsPullback fst_0 ι_𝒴0 ι_𝒴 i_LR := by
    refine CategoryTheory.IsPullback.of_bot ?_ hι_𝒴0_iLR.symm hPB_WL
    have hl : ι_𝒴0 ≫ snd_L = snd_0 ≫ iso_0.hom := CategoryTheory.Limits.pullback.lift_snd _ _ _
    rw [hl, ← hp_R_eq]
    exact CategoryTheory.IsPullback.of_iso
      (CategoryTheory.IsPullback.of_hasPullback p_R ι_0)
      (CategoryTheory.Iso.refl 𝒴_0) (CategoryTheory.Iso.refl 𝒴_R)
      iso_0 (CategoryTheory.Iso.refl _)
      (by simp [𝒴_0, fst_0]) (by simp [𝒴_0, snd_0]) (by simp) (by simp [hiso_0_hom_ev])
  have hCl_ι𝒴0 : AlgebraicGeometry.IsClosedImmersion ι_𝒴0 :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPB_𝒴0 hCl_ι𝒴

  have hψ_nat_LR : ∀ α : Fin (N' + 1 + 1),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (toL α)) ≫ ψ_R α = ψ_L α ≫ i_LR := by
    intro α
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hψ_R_fst α, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, hψ_L_fst α,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      congr 3
      ext b
      simp [toL]
    · rw [CategoryTheory.Category.assoc, hψ_R_snd α, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
        hψ_L_snd α, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2

  have hJL_le_range : ∀ (β : Fin (N' + 1)), Nontrivial (B β.succ) →
      ∀ q : PrimeSpectrum (TensorProduct Ω (B β.succ) L),
        (ψ_L β.succ).base q ∈ Set.range ι_𝒴0.base → J_L β ≤ q.asIdeal := by
    intro β hNt q ⟨y, hy⟩
    have hmem_R : (ψ_R β.succ).base (PrimeSpectrum.comap (toL β.succ) q) ∈ Set.range ι_𝒴.base := by
      have h1 : (ψ_R β.succ).base (PrimeSpectrum.comap (toL β.succ) q) =
          i_LR.base ((ψ_L β.succ).base q) :=
        congrArg (fun f => f.base q) (hψ_nat_LR β.succ)
      have h2 : i_LR.base (ι_𝒴0.base y) = ι_𝒴.base (fst_0.base y) :=
        congrArg (fun f => f.base y) hι_𝒴0_iLR
      exact ⟨fst_0.base y, by rw [h1, ← hy, h2]⟩
    have hzl : PrimeSpectrum.comap (toL β.succ) q ∈
        PrimeSpectrum.zeroLocus (Ideal.comap (toK β.succ) (J_K β.succ)) := by
      rw [← hPre_ι𝒴 β hNt]
      exact hmem_R
    have hJR_le : J_R β.succ ≤ Ideal.comap (toK β.succ) (J_K β.succ) := Ideal.le_comap_map
    exact Ideal.map_le_iff_le_comap.mpr (hJR_le.trans hzl)

  have hDim0 : topologicalKrullDim ↥𝒴_0 ≤ (1 : WithBot ℕ∞) :=
    hKrullBound L ψ_L hψ_L_fst hψ_L_snd hψ_L_open hψ_L_range
      𝒴_0 ι_𝒴0 hCl_ι𝒴0 J_L hSpec_dim hJL_le_range

  have hSub_π : ∀ y₀ : ↥𝒴_0, π_fib y₀ ∈ K₁ ∪ K₂ := by
    intro y₀
    by_cases hw_b0 : π_fib y₀ = b₀
    · rw [hw_b0]
      exact Or.inl hb₀_K₁
    · obtain ⟨β, hw_β⟩ := hCover_compl (π_fib y₀) hw_b0
      have hNt_β : Nontrivial (B β.succ) :=
        PrimeSpectrum.nonempty_iff_nontrivial.mp
          ⟨(hAff β.succ).primeIdealOf ⟨π_fib y₀, hw_β⟩⟩
      have hfst_ι0 : fst_L.base (ι_𝒴0.base y₀) = π_fib y₀ := by
        change (ι_𝒴0 ≫ fst_L).base y₀ = _
        rw [CategoryTheory.Limits.pullback.lift_fst]
      have hy0_range : ι_𝒴0.base y₀ ∈ Set.range (ψ_L β.succ).base := by
        rw [hψ_L_range β.succ, Set.mem_preimage, hfst_ι0]
        exact hw_β
      obtain ⟨q, hq_eq⟩ := hy0_range
      have hJL_q : J_L β ≤ q.asIdeal :=
        hJL_le_range β hNt_β q ⟨y₀, hq_eq.symm⟩
      have hp_mem_JR : p_eq_R β.succ ∈ J_R β.succ :=
        Ideal.subset_span (Or.inl rfl)
      have hp_mem_q : toL β.succ (p_eq_R β.succ) ∈ q.asIdeal :=
        hJL_q (Ideal.mem_map_of_mem (toL β.succ) hp_mem_JR)
      have hev_ϖ : ev_R ϖ = 0 :=
        RingHom.mem_ker.mp (hev_R_ker.symm ▸ Ideal.subset_span (Set.mem_singleton ϖ))
      have htoL_p : toL β.succ (p_eq_R β.succ) =
          (Algebra.TensorProduct.includeLeft :
            B β.succ →ₐ[Ω] TensorProduct Ω (B β.succ) L).toRingHom
            (∑ γ : Fin (N' + 1),
              algebraMap Ω (B β.succ) (c_F γ) * r_coord β.succ γ.succ) := by
        dsimp [toL, p_eq_R]
        simp only [map_add, map_sum, Algebra.TensorProduct.map_tmul,
          AlgHom.id_apply, AlgHom.restrictScalars_apply, map_one, map_mul, hev_ϖ,
          zero_mul, TensorProduct.tmul_zero, Finset.sum_const_zero, add_zero]
        exact (TensorProduct.sum_tmul Finset.univ
          (fun γ : Fin (N' + 1) =>
            algebraMap Ω (B β.succ) (c_F γ) * r_coord β.succ γ.succ)
          (1 : L)).symm
      rw [htoL_p] at hp_mem_q
      have hcomap_eq :
          PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft :
              B β.succ →ₐ[Ω] TensorProduct Ω (B β.succ) L).toRingHom q =
          (hAff β.succ).primeIdealOf ⟨π_fib y₀, hw_β⟩ := by
        let _ : AlgebraicGeometry.IsOpenImmersion (hAff β.succ).fromSpec := inferInstance
        apply (hAff β.succ).fromSpec.isOpenEmbedding.injective
        rw [(hAff β.succ).fromSpec_primeIdealOf ⟨π_fib y₀, hw_β⟩]
        have hfst_q : fst_L.base ((ψ_L β.succ).base q) =
            (hAff β.succ).fromSpec.base
              (PrimeSpectrum.comap
                (Algebra.TensorProduct.includeLeft :
                  B β.succ →ₐ[Ω] TensorProduct Ω (B β.succ) L).toRingHom q) :=
          congrArg (fun f => f.base q) (hψ_L_fst β.succ)
        rw [← hfst_q, hq_eq, hfst_ι0]
      let c_ext : Fin (N' + 1 + 1) → Ω := Fin.cases 0 c_F
      have hsum_B :
          (∑ a : Fin (N' + 1 + 1), algebraMap Ω (B β.succ) (c_ext a) * r_coord β.succ a) ∈
            ((hAff β.succ).primeIdealOf ⟨π_fib y₀, hw_β⟩).asIdeal := by
        rw [Fin.sum_univ_succ]
        dsimp [c_ext]
        simp only [map_zero, zero_mul, zero_add]
        rw [← hcomap_eq]
        exact hp_mem_q
      have hvan := (hr_vanish β.succ c_ext ⟨π_fib y₀, hw_β⟩).mpr hsum_B
      have hsum_P :
          (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c_ext a) * MvPolynomial.X a) =
          (∑ γ : Fin (N' + 1), MvPolynomial.C (c_F γ) * MvPolynomial.X γ.succ) := by
        rw [Fin.sum_univ_succ]
        dsimp [c_ext]
        simp only [map_zero, zero_mul, zero_add]
      rw [hsum_P] at hvan
      rw [hUnion]
      exact hvan

  exact ⟨N, 𝒴_R, hInt_𝒴, p_R, hProp_pR, hSurj_pR, σ_R, gProj, hComm, π_fib,
    hSec, hClosed_lift, hDim0, hCont_π, hSub_π, hy₁, hy₂⟩

theorem weil_algClosed_proj_hyperplane_section_connected (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (d M : ℕ) (hd : 2 ≤ d)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hIntW : AlgebraicGeometry.IsIntegral W.left)
    [AlgebraicGeometry.IsProper W.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d W.hom]
    (ι_W : W ⟶ weilProjectiveSpaceOver Ω M)
    (hCl_W : AlgebraicGeometry.IsClosedImmersion ι_W.left)
    (F : MvPolynomial (Fin (M + 1)) Ω)
    (hF_hom : F ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω 1)
    (hF_ne : F ≠ 0)
    (hF_nondeg : ∃ w : W.left, ι_W.left.base w ∉ weilProjHyperplaneSet Ω M F)
    (H : AlgebraicGeometry.Scheme.{u})
    (ι_H : H ⟶ W.left)
    (hCl_H : AlgebraicGeometry.IsClosedImmersion ι_H)
    (hRange_H : Set.range ι_H.base =
      { w : W.left | ι_W.left.base w ∈ weilProjHyperplaneSet Ω M F }) :
    ConnectedSpace ↥H :=
by
  have hDimW : topologicalKrullDim W.left = (d : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field Ω d W hIntW
  have hM2 : 2 ≤ M := by
    have hDimP₀ : topologicalKrullDim (weilProjectiveSpaceOver Ω M).left = (M : WithBot ℕ∞) :=
      (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso Ω M).2.2.1
    let _ : AlgebraicGeometry.IsClosedImmersion ι_W.left := hCl_W
    have hClEmb_W : Topology.IsClosedEmbedding ι_W.left.base := ι_W.left.isClosedEmbedding
    have hDimRangeW : topologicalKrullDim ↥(Set.range ι_W.left.base) = (d : WithBot ℕ∞) := by
      rw [← hClEmb_W.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq, hDimW]
    have hSubLe : topologicalKrullDim ↥(Set.range ι_W.left.base) ≤
        topologicalKrullDim (weilProjectiveSpaceOver Ω M).left :=
      topologicalKrullDim_subspace_le ..
    have hd_le_M_wb : (d : WithBot ℕ∞) ≤ (M : WithBot ℕ∞) := by
      rwa [hDimRangeW, hDimP₀] at hSubLe
    have hd_le_M : d ≤ M := by exact_mod_cast hd_le_M_wb
    omega
  obtain ⟨N', rfl⟩ : ∃ N' : ℕ, M = N' + 1 := ⟨M - 1, (Nat.sub_add_cancel (by omega)).symm⟩
  have hN' : 1 ≤ N' := by omega
  have hDimP : topologicalKrullDim (weilProjectiveSpaceOver Ω (N' + 1)).left =
      ((N' + 1 : ℕ) : WithBot ℕ∞) :=
    (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso Ω (N' + 1)).2.2.1
  let Y : Set W.left :=
    { w : W.left | ι_W.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F }
  have hCl_Y : IsClosed Y := by
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω) :=
      MvPolynomial.gradedAlgebra
    have hCl_hyp : IsClosed (weilProjHyperplaneSet Ω (N' + 1) F) :=
      (AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω) F).isOpen.isClosed_compl
    exact hCl_hyp.preimage ι_W.left.continuous
  have hNe_Y : Y.Nonempty := by
    let _ : AlgebraicGeometry.IsClosedImmersion ι_W.left := hCl_W
    have hClEmb_W : Topology.IsClosedEmbedding ι_W.left.base := ι_W.left.isClosedEmbedding
    have hDimRangeW : topologicalKrullDim ↥(Set.range ι_W.left.base) = (d : WithBot ℕ∞) := by
      rw [← hClEmb_W.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq, hDimW]
    have h1_le_dim : ((d : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥(Set.range ι_W.left.base) := by
      rw [hDimRangeW]
    obtain ⟨⟨p, ⟨w, hw⟩, hpF⟩, -⟩ :=
      (weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint Ω (N' + 1)).1
        (Set.range ι_W.left.base) hClEmb_W.isClosed_range d (by omega) h1_le_dim F hF_hom hF_ne
    refine ⟨w, ?_⟩
    change ι_W.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F
    rwa [hw]
  suffices hPreY : _root_.IsPreconnected Y by
    let _ : ConnectedSpace ↥Y := Subtype.connectedSpace ⟨hNe_Y, hPreY⟩
    let _ : AlgebraicGeometry.IsClosedImmersion ι_H := hCl_H
    let e_HY : ↥H ≃ₜ ↥Y :=
      ι_H.isClosedEmbedding.isEmbedding.toHomeomorph.trans (Homeomorph.setCongr hRange_H)
    exact Function.Surjective.connectedSpace e_HY.symm.surjective e_HY.symm.continuous
  by_contra hNotPre
  rw [isPreconnected_closed_iff] at hNotPre
  push Not at hNotPre
  obtain ⟨t₁, t₂, hCl_t₁, hCl_t₂, hSub_t, hNe_K₁, hNe_K₂, hNotNe_inter⟩ := hNotPre
  let K₁ : Set W.left := Y ∩ t₁
  let K₂ : Set W.left := Y ∩ t₂
  have hCl_K₁ : IsClosed K₁ := hCl_Y.inter hCl_t₁
  have hCl_K₂ : IsClosed K₂ := hCl_Y.inter hCl_t₂
  have hDisj : Disjoint K₁ K₂ := by
    rw [Set.disjoint_iff_inter_eq_empty]
    ext x
    simp only [K₁, K₂, Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false]
    intro ⟨⟨hxY, hxt₁⟩, ⟨_, hxt₂⟩⟩
    have hx_in : x ∈ Y ∩ (t₁ ∩ t₂) := ⟨hxY, hxt₁, hxt₂⟩
    rw [hNotNe_inter] at hx_in
    exact hx_in
  have hUnion_Y : K₁ ∪ K₂ = Y := by
    ext x
    simp only [K₁, K₂, Set.mem_union, Set.mem_inter_iff]
    constructor
    · rintro (⟨hxY, _⟩ | ⟨hxY, _⟩) <;> exact hxY
    · intro hxY
      rcases hSub_t hxY with hxt₁ | hxt₂
      · exact Or.inl ⟨hxY, hxt₁⟩
      · exact Or.inr ⟨hxY, hxt₂⟩
  have hK₁_sub : ∀ w ∈ K₁, ι_W.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F :=
    fun _ hw => hw.1
  obtain ⟨b₀, q₀, ι₁, c_F, hb₀_K₁, hb₀_cl, hq₀_hom, hq₀_range, hCl₁, hc_F,
      -, -, hEquiv_F₁, hb₀_chart0, hb₀_vanish, hCompl_b₀⟩ :=
    weil_algClosed_proj_hyperplane_swap_shear_centering Ω N' W hDimP ι_W hCl_W
      F hF_hom hF_ne K₁ hCl_K₁ hNe_K₁ hK₁_sub
  let F₁ : MvPolynomial (Fin (N' + 1 + 1)) Ω :=
    ∑ β : Fin (N' + 1), MvPolynomial.C (c_F β) * MvPolynomial.X β.succ
  have hNondeg₁ : ∃ w : W.left, ι₁.left.base w ∉ weilProjHyperplaneSet Ω (N' + 1) F₁ := by
    obtain ⟨w, hw⟩ := hF_nondeg
    exact ⟨w, fun h_in => hw ((hEquiv_F₁ w).mp h_in)⟩
  have hUnion₁ : K₁ ∪ K₂ =
      { w : W.left | ι₁.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F₁ } := by
    rw [hUnion_Y]
    ext w
    exact (hEquiv_F₁ w).symm
  obtain ⟨hAff, hAlg, hFT, r_coord, ev₀, hr_diag, hr_vanish, hFromSpec,
      hInter, hScale, hev₀, hDom₀, hDom, hSpec, hBezout⟩ :=
    weil_algClosed_smooth_proj_charts_specialization_and_codimOne Ω d N' hd hN'
      W hIntW hDimW hDimP ι₁ hCl₁ b₀ q₀ c_F hc_F K₁ K₂
      hb₀_K₁ hq₀_hom hq₀_range hb₀_chart0 hb₀_vanish hCompl_b₀
      hNondeg₁ hCl_K₁ hCl_K₂ hNe_K₂ hDisj hUnion₁
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let U_chart : Fin (N' + 1 + 1) → W.left.Opens :=
    fun α => (TopologicalSpace.Opens.map ι₁.left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α))
  let B : Fin (N' + 1 + 1) → Type u :=
    fun α => ↑(W.left.presheaf.obj (Opposite.op (U_chart α)))
  let _ : ∀ α : Fin (N' + 1 + 1), Algebra Ω (B α) := hAlg
  let _ : ∀ α : Fin (N' + 1 + 1), Algebra.FiniteType Ω (B α) := hFT
  have hd_sub : (d - 2) + 2 = d := Nat.sub_add_cancel hd
  have hDom₀' : IsDomain (B 0) ∧ ringKrullDim (B 0) = (((d - 2) + 2 : ℕ) : WithBot ℕ∞) := by
    rw [hd_sub]
    exact hDom₀
  have hDom' : ∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
      IsDomain (B β.succ) ∧
      ringKrullDim (B β.succ) = (((d - 2) + 2 : ℕ) : WithBot ℕ∞) ∧
      (∑ γ : Fin (N' + 1), algebraMap Ω (B β.succ) (c_F γ) * r_coord β.succ γ.succ) ≠ 0 := by
    intro β hNt
    rw [hd_sub]
    exact hDom β hNt
  obtain ⟨L, hFieldL, hInfL, hAlgΩL, R, hCommR, hDomR, hPIR_R, hLocR,
      hAlgΩR, hAlgLR, hTowerΩLR, ϖ, ev_R, u_L, v_L,
      ⟨hϖ_ne, hMax, hRes, hev_R_ker, hu_L_ne⟩, hGen_dom, hOrigin_Q₀, hSpec_fib⟩ :=
    weil_algClosed_pointed_generic_dvr_pencil_algebra_package Ω (d - 2) N' hN'
      B r_coord hr_diag c_F hc_F ev₀ hev₀.2 hDom₀' hDom' hSpec
  let _ : Field L := hFieldL
  let _ : Infinite L := hInfL
  let _ : Algebra Ω L := hAlgΩL
  let _ : CommRing R := hCommR
  let _ : IsDomain R := hDomR
  let _ : IsPrincipalIdealRing R := hPIR_R
  let _ : IsLocalRing R := hLocR
  let _ : Algebra Ω R := hAlgΩR
  let _ : Algebra L R := hAlgLR
  let _ : IsScalarTower Ω L R := hTowerΩLR
  obtain ⟨β₂, 𝔮_L, hNontriv₂, h𝔮_K₂, h𝔮_f, h𝔮_h⟩ := hBezout L u_L hu_L_ne
  let K_gen : Type u := FractionRing R
  let h_eq_R : ∀ (α : Fin (N' + 1 + 1)), Fin (d - 2) → TensorProduct Ω (B α) R :=
    fun α i => ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (algebraMap L R (u_L i γ))
  let p_eq_R : ∀ (α : Fin (N' + 1 + 1)), TensorProduct Ω (B α) R :=
    fun α =>
      (∑ γ : Fin (N' + 1),
        (algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ) ⊗ₜ[Ω] (1 : R)) +
      (∑ γ : Fin (N' + 1),
        (r_coord α γ.succ) ⊗ₜ[Ω] (ϖ * algebraMap L R (v_L γ)))
  let J_R : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) R) :=
    fun α => Ideal.span ({p_eq_R α} ∪ Set.range (h_eq_R α))
  let toK : ∀ (α : Fin (N' + 1 + 1)),
      TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) K_gen :=
    fun α =>
      (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
        (IsScalarTower.toAlgHom Ω R K_gen)).toRingHom
  let toL : ∀ (α : Fin (N' + 1 + 1)),
      TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) L :=
    fun α =>
      (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
        (ev_R.restrictScalars Ω)).toRingHom
  have hJL_le : Ideal.map (toL β₂.succ) (J_R β₂.succ) ≤ 𝔮_L.asIdeal := by
    rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    intro z hz
    simp only [Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hz
    rcases hz with rfl | ⟨i, rfl⟩
    · have hev_ϖ : ev_R ϖ = 0 :=
        RingHom.mem_ker.mp (hev_R_ker.symm ▸ Ideal.subset_span (Set.mem_singleton ϖ))
      have hmap_p : toL β₂.succ (p_eq_R β₂.succ) =
          ∑ γ : Fin (N' + 1),
            (algebraMap Ω (B β₂.succ) (c_F γ) * r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (1 : L) := by
        dsimp [toL, p_eq_R]
        simp only [map_add, map_sum, Algebra.TensorProduct.map_tmul,
          AlgHom.id_apply, AlgHom.restrictScalars_apply, map_one, map_mul, hev_ϖ, zero_mul,
          TensorProduct.tmul_zero, Finset.sum_const_zero, add_zero]
      change toL β₂.succ (p_eq_R β₂.succ) ∈ 𝔮_L.asIdeal
      rw [hmap_p]
      exact h𝔮_f
    · have hmap_h : toL β₂.succ (h_eq_R β₂.succ i) =
          ∑ γ : Fin (N' + 1), (r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (u_L i γ) := by
        dsimp [toL, h_eq_R]
        simp only [map_sum, Algebra.TensorProduct.map_tmul,
          AlgHom.id_apply, AlgHom.restrictScalars_apply, AlgHom.commutes]
        rfl
      change toL β₂.succ (h_eq_R β₂.succ i) ∈ 𝔮_L.asIdeal
      rw [hmap_h]
      exact h𝔮_h i
  have h𝔮_lift := (hSpec_fib β₂ hNontriv₂).2 𝔮_L hJL_le
  obtain ⟨N, 𝒴_R, hInt_𝒴, p_R, hProp_pR, hSurj_pR, σ_R, gProj, hComm, π_fib,
      hSec, hClosed_lift, hDim0, hCont_π, hSub_π, ⟨y₁, hy₁⟩, ⟨y₂, hy₂⟩⟩ :=
    weil_algClosed_dvr_generic_pencil_scheme_closure Ω d N' hd hN'
      W hIntW ι₁ hCl₁ b₀ q₀ c_F K₁ K₂
      hb₀_K₁ hb₀_cl hq₀_hom hq₀_range hb₀_chart0 hCompl_b₀ hUnion₁
      hAff r_coord ev₀ hr_diag hr_vanish hFromSpec hInter hScale hev₀
      hDom₀.1 (fun β hNt => (hDom β hNt).1)
      L R ϖ ev_R u_L v_L hϖ_ne hMax hev_R_ker
      hGen_dom hOrigin_Q₀ (fun β hNt => (hSpec_fib β hNt).1)
      β₂ hNontriv₂ 𝔮_L h𝔮_K₂ h𝔮_lift
  let _ : AlgebraicGeometry.IsIntegral 𝒴_R := hInt_𝒴
  let _ : AlgebraicGeometry.IsProper p_R := hProp_pR
  let _ : AlgebraicGeometry.Surjective p_R := hSurj_pR
  have hGlob : Function.Bijective (p_R.appTop).hom :=
    weil_integral_proper_section_appTop_bijective R 𝒴_R p_R σ_R hSec
  have hConn₀ :=
    weil_dvr_projective_curve_connected_special_fiber L R ϖ hϖ_ne hMax hRes
      N 𝒴_R p_R hGlob gProj hComm hClosed_lift hDim0
  let _ := hConn₀
  have hPre₀ : _root_.IsPreconnected
      (Set.univ : Set ↥(CategoryTheory.Limits.pullback p_R
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ})))))) :=
    isPreconnected_univ
  have hInter₀ := isPreconnected_closed_iff.mp hPre₀
    (π_fib ⁻¹' K₁) (π_fib ⁻¹' K₂)
    (hCl_K₁.preimage hCont_π) (hCl_K₂.preimage hCont_π)
    (fun y _ => hSub_π y)
    ⟨y₁, Set.mem_univ y₁, hy₁⟩
    ⟨y₂, Set.mem_univ y₂, hy₂⟩
  obtain ⟨y, -, hyK₁, hyK₂⟩ := hInter₀
  exact Set.disjoint_left.mp hDisj hyK₁ hyK₂

theorem weil_algClosed_incidence_blowup_and_hyperplane_slice (k : Type u) [Field k] [IsAlgClosed k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hM : 3 ≤ M)
    (hCl_ι : AlgebraicGeometry.IsClosedImmersion ι_bar.left)
    (hNondeg : ∀ L_form : MvPolynomial (Fin (M + 1)) k,
      L_form ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 → L_form ≠ 0 →
      ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M L_form)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (u_val : k)
    (hCoord_line : IsStandardProjLineCoord k j_aff s_inf)
    (hLine_plane : IsStandardProjLineInPlane k ι_line)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (hL_linIndep : ∀ c : Fin 3 → k, c ≠ 0 → (∑ r : Fin 3, MvPolynomial.C (c r) * L r) ≠ 0)
    (hTrans_axis : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m) 2 ![L 0, L 1])
    (hNet_m0 : m = 0 → ∀ z : Z_bar.left,
      ∃ r : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r))
    (hNet_pos : 1 ≤ m → IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m - 1) 3 L)
    (hTrans_u₀ : IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
      ![L 0 + MvPolynomial.C u_val * L 1]) :
    Nonempty (WeilAlgClosedIncidenceSlicePackage k m M Z_bar ι_bar L j_aff ι_line u_val) :=
by
  have hGeomOfInt :
      ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral Y.left →
        AlgebraicGeometry.GeometricallyIrreducible Y.hom := by
    intro Y hIntY
    haveI : Algebra.IsAlgebraic k k := Algebra.IsAlgebraic.of_finite k k
    have hpW : CategoryTheory.IsPullback (𝟙 Y.left) Y.hom Y.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k k))) := by
      have hid : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k k)) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        show AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id k)) = _
        rw [CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      rw [hid]
      exact CategoryTheory.IsPullback.of_horiz_isIso ⟨by simp⟩
    exact weil_geometricallyIrreducible_of_algClosure_pullback k k Y Y hIntY (𝟙 Y.left) hpW

  have hSlicePkg := weil_algClosed_transversal_slice_and_smooth_connected_integral k

  obtain ⟨B₀, ι_B, hCl_B, hProp_B₀, hProj_B₀, hSm_B₀, hRange_B₀', _, hCompl_B₀⟩ :=
    hSlicePkg.1 M (2 * m) 2 Z_bar ι_bar hCl_ι ![L 0, L 1] hTrans_axis
  have hRange_B₀ : Set.range ι_B.left.base =
      { z : Z_bar.left |
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 0) ∧
        ι_bar.left.base z ∈ weilProjHyperplaneSet k M (L 1) } := by
    rw [hRange_B₀']
    ext z
    simp [Fin.forall_fin_two]
  have hL0_ne : L 0 ≠ 0 := by
    let c₀ : Fin 3 → k := ![1, 0, 0]
    have hc₀ : c₀ ≠ 0 := by
      intro h0
      have h1 : c₀ 0 = 0 := congrFun h0 0
      simp [c₀] at h1
    have hSum0 : (∑ r : Fin 3, MvPolynomial.C (c₀ r) * L r) = L 0 := by
      simp [Fin.sum_univ_three, c₀]
    rw [← hSum0]
    exact hL_linIndep c₀ hc₀
  obtain ⟨z₀, hz₀⟩ := hNondeg (L 0) (hL_homog 0) hL0_ne
  obtain ⟨U_axis, hU_axis_eq, hU_axis_ne⟩ :=
    hCompl_B₀ (by omega) ⟨0, z₀, hz₀⟩

  obtain ⟨Y₂, π_Y, g₂, hNet_inc, hInt_Y₂, hProp_Y₂, hSm_Y₂, hProj_Y₂, hFlat_g₂, hProp_g₂⟩ :=
    weil_algClosed_net_incidence_smooth_flat k m M Z_bar hInt ι_bar hM hCl_ι hNondeg
      L hL_homog hL_linIndep hNet_m0 hNet_pos
  have hGeom_Y₂ : AlgebraicGeometry.GeometricallyIrreducible Y₂.hom :=
    hGeomOfInt Y₂ hInt_Y₂

  letI : AlgebraicGeometry.IsProper B₀.hom := hProp_B₀
  letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) B₀.hom := hSm_B₀
  obtain ⟨Z_tilde, π₀, f₀, ι_Ytilde, Z_u₀, ι_Zu₀, ι_Zu₀_M,
      hPb_line, hπ₀_eq, hInt_Ztilde, hProp_Ztilde, hSm_Ztilde, hProj_Ztilde,
      hProp_π₀, hSurj_π₀, hIso_π₀, hFlat_f₀, hProp_f₀, hSurj_f₀,
      hPb_Zu₀, hProp_Zu₀, hSm_Zu₀, hProj_Zu₀, hCl_Zu₀_M, hFib_id⟩ :=
    weil_algClosed_pencil_blowup_and_fiber_pullback k m M Z_bar hInt ι_bar hM hCl_ι hNondeg
      L j_aff s_inf ι_line u_val hCoord_line hLine_plane hL_homog hL_linIndep
      hTrans_axis hTrans_u₀ B₀ hProj_B₀ ι_B hCl_B hRange_B₀ U_axis hU_axis_eq hU_axis_ne
      Y₂ π_Y g₂ hNet_inc hProj_Y₂ hFlat_g₂ hProp_g₂
  have hGeom_Ztilde : AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom :=
    hGeomOfInt Z_tilde hInt_Ztilde

  have hFibConn_f₀ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback f₀.left s) := by
    intro Ω _ _ s
    obtain ⟨W_Ω, hProp_WΩ, hSm_WΩ, ι_WΩ, L_s, ι_fib,
        hInt_WΩ, hCl_WΩ, hLs_hom, hLs_ne, hLs_nondeg, hCl_fib, hRange_fib⟩ :=
      hFib_id Ω s
    letI : AlgebraicGeometry.IsProper W_Ω.hom := hProp_WΩ
    letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) W_Ω.hom := hSm_WΩ
    exact weil_algClosed_proj_hyperplane_section_connected Ω (2 * m + 2) M (by omega)
      W_Ω hInt_WΩ ι_WΩ hCl_WΩ L_s hLs_hom hLs_ne hLs_nondeg
      (CategoryTheory.Limits.pullback f₀.left s) ι_fib hCl_fib hRange_fib

  let u₀_sec : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom u_val)) ≫ j_aff
  haveI : ConnectedSpace ↥(CategoryTheory.Limits.pullback f₀.left u₀_sec) :=
    hFibConn_f₀ k u₀_sec
  let e_Zu₀ : Z_u₀.left ≅ CategoryTheory.Limits.pullback f₀.left u₀_sec :=
    hPb_Zu₀.isoPullback
  have hConn_Zu₀ : ConnectedSpace ↥Z_u₀.left := by
    refine Function.Surjective.connectedSpace
      (f := fun w : ↥(CategoryTheory.Limits.pullback f₀.left u₀_sec) => e_Zu₀.inv.base w)
      ?_ e_Zu₀.inv.continuous
    intro z
    refine ⟨e_Zu₀.hom.base z, ?_⟩
    show (e_Zu₀.hom ≫ e_Zu₀.inv).base z = z
    rw [e_Zu₀.hom_inv_id]
    rfl

  letI : AlgebraicGeometry.IsProper Z_u₀.hom := hProp_Zu₀
  letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom := hSm_Zu₀
  obtain ⟨hInt_Zu₀, hDim_Zu₀⟩ := hSlicePkg.2.1 (2 * m + 1) Z_u₀ hConn_Zu₀
  have hGeom_Zu₀ : AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom :=
    hGeomOfInt Z_u₀ hInt_Zu₀

  rcases Nat.eq_zero_or_pos m with rfl | hm_pos
  · obtain ⟨H₀, i_H, hInt_H₀, hProp_H₀, hSm_H₀, hProj_H₀, hCl_H⟩ :=
      hSlicePkg.2.2 Z_u₀ hInt_Zu₀ hProj_Zu₀
    have hGeom_H₀ : AlgebraicGeometry.GeometricallyIrreducible H₀.hom :=
      hGeomOfInt H₀ hInt_H₀
    have hAff_compl_H : 1 ≤ 0 → ∃ U_aff : Z_u₀.left.Opens,
        (U_aff : Set Z_u₀.left) = (Set.range i_H.left.base)ᶜ ∧
        AlgebraicGeometry.IsAffineOpen U_aff :=
      fun h => absurd h (by omega)
    exact ⟨{
      B₀ := B₀
      hProp_B₀ := hProp_B₀
      hSm_B₀ := hSm_B₀
      hProj_B₀ := hProj_B₀
      ι_B := ι_B
      hCl_B := hCl_B
      hRange_B₀ := hRange_B₀
      U_axis := U_axis
      hU_axis_eq := hU_axis_eq
      hU_axis_ne := hU_axis_ne
      Z_tilde := Z_tilde
      hInt_Ztilde := hInt_Ztilde
      hGeom_Ztilde := hGeom_Ztilde
      hProp_Ztilde := hProp_Ztilde
      hSm_Ztilde := hSm_Ztilde
      hProj_Ztilde := hProj_Ztilde
      π₀ := π₀
      hProp_π₀ := hProp_π₀
      hSurj_π₀ := hSurj_π₀
      hIso_π₀ := hIso_π₀
      f₀ := f₀
      hFlat_f₀ := hFlat_f₀
      hProp_f₀ := hProp_f₀
      hSurj_f₀ := hSurj_f₀
      hFibConn_f₀ := hFibConn_f₀
      Y₂ := Y₂
      hInt_Y₂ := hInt_Y₂
      hGeom_Y₂ := hGeom_Y₂
      hProp_Y₂ := hProp_Y₂
      hSm_Y₂ := hSm_Y₂
      hProj_Y₂ := hProj_Y₂
      π_Y := π_Y
      g₂ := g₂
      hNet_inc := hNet_inc
      hFlat_g₂ := hFlat_g₂
      hProp_g₂ := hProp_g₂
      ι_Ytilde := ι_Ytilde
      hPb_line := hPb_line
      hπ₀_eq := hπ₀_eq
      Z_u₀ := Z_u₀
      hInt_Zu₀ := hInt_Zu₀
      hGeom_Zu₀ := hGeom_Zu₀
      hProp_Zu₀ := hProp_Zu₀
      hSm_Zu₀ := hSm_Zu₀
      hProj_Zu₀ := hProj_Zu₀
      ι_Zu₀ := ι_Zu₀
      hPb_Zu₀ := hPb_Zu₀
      H₀ := H₀
      hInt_H₀ := hInt_H₀
      hGeom_H₀ := hGeom_H₀
      hProp_H₀ := hProp_H₀
      hSm_H₀ := hSm_H₀
      hProj_H₀ := hProj_H₀
      i_H := i_H
      hCl_H := hCl_H
      hAff_compl_H := hAff_compl_H
    }⟩
  · have hSm_Zu₀_top : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
        ((⊤ : Z_u₀.left.Opens).ι ≫ Z_u₀.hom) := by
      have h0 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (2 * m + 1))
          ((⊤ : Z_u₀.left.Opens).ι ≫ Z_u₀.hom) := inferInstance
      rwa [Nat.zero_add] at h0
    have hBert := weil_algClosed_bertini_transversal_step k M
    have hSl0 : IsTransversalLinearSlice k M Z_u₀ ι_Zu₀_M ⊤ (2 * m + 1) 0 Fin.elim0 :=
      hBert.1 Z_u₀ ι_Zu₀_M hCl_Zu₀_M ⊤ (2 * m + 1) hSm_Zu₀_top
    letI : AlgebraicGeometry.IsClosedImmersion ι_Zu₀_M.left := hCl_Zu₀_M
    have hClEmb_Zu₀ : Topology.IsClosedEmbedding ι_Zu₀_M.left.base :=
      ι_Zu₀_M.left.isClosedEmbedding
    let Y_range : Set (weilProjectiveSpaceOver k M).left := Set.range ι_Zu₀_M.left.base
    obtain ⟨L_H, hLH_hom, hLH_ne, hLH_dim, hLH_sl⟩ :=
      hBert.2 1 1 (fun _ => Y_range) (fun _ => hClEmb_Zu₀.isClosed_range)
        (fun _ => Z_u₀) (fun _ => ι_Zu₀_M) (fun _ => hCl_Zu₀_M)
        (fun _ => ⊤) (fun _ => 2 * m + 1) (fun _ => 0) (fun _ => by omega)
        (fun _ => Fin.elim0) (fun _ => hSl0)
    have hSnoc_eq : ∀ j : Fin 1,
        Fin.snoc (α := fun _ => MvPolynomial (Fin (M + 1)) k) Fin.elim0 L_H j = L_H := by
      intro j
      rw [Subsingleton.elim j (Fin.last 0), Fin.snoc_last]
    obtain ⟨H₀, i_H, hCl_H, hProp_H₀, hProj_H₀, hSm_H₀, hRange_H₀, hAff_H₀, _⟩ :=
      hSlicePkg.1 M (2 * m) 1 Z_u₀ ι_Zu₀_M hCl_Zu₀_M
        (Fin.snoc Fin.elim0 L_H) (hLH_sl 0)
    have hAff_compl_H : 1 ≤ m → ∃ U_aff : Z_u₀.left.Opens,
        (U_aff : Set Z_u₀.left) = (Set.range i_H.left.base)ᶜ ∧
        AlgebraicGeometry.IsAffineOpen U_aff :=
      fun _ => hAff_H₀ rfl (fun j => by rw [hSnoc_eq j]; exact hLH_ne)
    have hLH_nondeg : ∃ z : Z_u₀.left, ι_Zu₀_M.left.base z ∉ weilProjHyperplaneSet k M L_H := by
      by_contra! hAll
      have hInter : Y_range ∩ weilProjHyperplaneSet k M L_H = Y_range := by
        refine Set.inter_eq_self_of_subset_left ?_
        rintro _ ⟨z, rfl⟩
        exact hAll z
      have hDim_Y : topologicalKrullDim ↥Y_range = ((2 * m + 1 : ℕ) : WithBot ℕ∞) :=
        (hClEmb_Zu₀.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq).symm.trans
          hDim_Zu₀
      have hIneq := hLH_dim 0
      rw [hInter, hDim_Y] at hIneq
      change (((2 * m + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) + ((1 : ℕ∞) : WithBot ℕ∞) ≤
          (((2 * m + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) at hIneq
      rw [← WithBot.coe_add, WithBot.coe_le_coe] at hIneq
      norm_cast at hIneq
      omega
    have hRange_H₀' : Set.range i_H.left.base =
        { w : Z_u₀.left | ι_Zu₀_M.left.base w ∈ weilProjHyperplaneSet k M L_H } := by
      rw [hRange_H₀]
      ext w
      simp [Fin.forall_fin_one, hSnoc_eq 0]
    have hConn_H₀ : ConnectedSpace ↥H₀.left :=
      weil_algClosed_proj_hyperplane_section_connected k (2 * m + 1) M (by omega)
        Z_u₀ hInt_Zu₀ ι_Zu₀_M hCl_Zu₀_M L_H hLH_hom hLH_ne hLH_nondeg
        H₀.left i_H.left hCl_H hRange_H₀'
    letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) H₀.hom := hSm_H₀
    obtain ⟨hInt_H₀, _⟩ := hSlicePkg.2.1 (2 * m) H₀ hConn_H₀
    have hGeom_H₀ : AlgebraicGeometry.GeometricallyIrreducible H₀.hom :=
      hGeomOfInt H₀ hInt_H₀
    exact ⟨{
      B₀ := B₀
      hProp_B₀ := hProp_B₀
      hSm_B₀ := hSm_B₀
      hProj_B₀ := hProj_B₀
      ι_B := ι_B
      hCl_B := hCl_B
      hRange_B₀ := hRange_B₀
      U_axis := U_axis
      hU_axis_eq := hU_axis_eq
      hU_axis_ne := hU_axis_ne
      Z_tilde := Z_tilde
      hInt_Ztilde := hInt_Ztilde
      hGeom_Ztilde := hGeom_Ztilde
      hProp_Ztilde := hProp_Ztilde
      hSm_Ztilde := hSm_Ztilde
      hProj_Ztilde := hProj_Ztilde
      π₀ := π₀
      hProp_π₀ := hProp_π₀
      hSurj_π₀ := hSurj_π₀
      hIso_π₀ := hIso_π₀
      f₀ := f₀
      hFlat_f₀ := hFlat_f₀
      hProp_f₀ := hProp_f₀
      hSurj_f₀ := hSurj_f₀
      hFibConn_f₀ := hFibConn_f₀
      Y₂ := Y₂
      hInt_Y₂ := hInt_Y₂
      hGeom_Y₂ := hGeom_Y₂
      hProp_Y₂ := hProp_Y₂
      hSm_Y₂ := hSm_Y₂
      hProj_Y₂ := hProj_Y₂
      π_Y := π_Y
      g₂ := g₂
      hNet_inc := hNet_inc
      hFlat_g₂ := hFlat_g₂
      hProp_g₂ := hProp_g₂
      ι_Ytilde := ι_Ytilde
      hPb_line := hPb_line
      hπ₀_eq := hπ₀_eq
      Z_u₀ := Z_u₀
      hInt_Zu₀ := hInt_Zu₀
      hGeom_Zu₀ := hGeom_Zu₀
      hProp_Zu₀ := hProp_Zu₀
      hSm_Zu₀ := hSm_Zu₀
      hProj_Zu₀ := hProj_Zu₀
      ι_Zu₀ := ι_Zu₀
      hPb_Zu₀ := hPb_Zu₀
      H₀ := H₀
      hInt_H₀ := hInt_H₀
      hGeom_H₀ := hGeom_H₀
      hProp_H₀ := hProp_H₀
      hSm_H₀ := hSm_H₀
      hProj_H₀ := hProj_H₀
      i_H := i_H
      hCl_H := hCl_H
      hAff_compl_H := hAff_compl_H
    }⟩

theorem weil_algClosed_net_transversal_fiber_smoothness (k : Type u) [Field k] [IsAlgClosed k]
    (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (hLine_plane : IsStandardProjLineInPlane k ι_line)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Y : Y₂ ⟶ Z_bar)
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    [AlgebraicGeometry.IsProper g₂.left]
    (hNet_inc : IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver k 1)
    (ι_Ytilde : Z_tilde ⟶ Y₂)
    (hPb_line : CategoryTheory.IsPullback ι_Ytilde.left f₀.left g₂.left ι_line.left) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
      MvPolynomial.gradedAlgebra
    (∀ (w : Fin 3 → k), w ≠ 0 →
      ∀ (U_Z : Z_bar.left.Opens),
        IsTransversalLinearSlice k M Z_bar ι_bar U_Z (2 * m + 1) 1
          ![∑ r : Fin 3, MvPolynomial.C (w r) * L r] →
        ∀ (y : Y₂.left), π_Y.left.base y ∈ U_Z →
          (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
            F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d →
            (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (g₂.left.base y) ↔
              MvPolynomial.eval w F = 0)) →
          ∃ V : Y₂.left.Opens, y ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left)) ∧
    ((∀ (t : Fin 2 → k), t ≠ 0 →
      IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
        ![MvPolynomial.C (t 0) * L 0 + MvPolynomial.C (t 1) * L 1]) →
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) f₀.left) ∧
    (∀ (D_disc : ℕ) (P_disc : MvPolynomial (Fin 3) k)
        (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_disc : C_disc ⟶ weilProjectiveSpaceOver k 2)
        (U₀ : (weilProjectiveSpaceOver k 1).left.Opens),
      IsHomogeneousHypersurfacePullbackOver k 2 D_disc
        (𝟙 (weilProjectiveSpaceOver k 2)) P_disc ι_disc.left →
      ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) = (U₀ : Set _)ᶜ →
      (∀ w : Fin 3 → k, w ≠ 0 → MvPolynomial.eval w P_disc ≠ 0 →
        IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m + 1) 1
          ![∑ r : Fin 3, MvPolynomial.C (w r) * L r]) →
      ∃ U₂_sm : (weilProjectiveSpaceOver k 2).left.Opens,
        (U₂_sm : Set (weilProjectiveSpaceOver k 2).left) = (Set.range ι_disc.left.base)ᶜ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (g₂.left ∣_ U₂_sm) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀)) :=
by
  classical
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  letI : GradedAlgebra 𝒜_2 := MvPolynomial.gradedAlgebra
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
  let R_2 := MvPolynomial (Fin 2) k

  
  
  
  have hProj_cover : ∀ (N : ℕ),
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      ∀ p : (weilProjectiveSpaceOver k N).left,
        letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
        ∃ α : Fin (N + 1), p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α) := by
    intro N 𝒜_N p
    letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    by_contra hnone
    push_neg at hnone
    have hX_mem : ∀ α : Fin (N + 1),
        (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ p.asHomogeneousIdeal := by
      intro α
      by_contra hnot_in
      exact hnone α ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜_N (MvPolynomial.X α) p).mpr hnot_in)
    apply p.not_irrelevant_le
    rw [HomogeneousIdeal.irrelevant_le]
    intro i hi F hF
    change F ∈ p.asHomogeneousIdeal.toIdeal
    rw [MvPolynomial.as_sum F]
    refine Submodule.sum_mem p.asHomogeneousIdeal.toIdeal fun s hs => ?_
    have hdeg_s : (∑ α : Fin (N + 1), s α) = i := by
      have hhom := (MvPolynomial.mem_homogeneousSubmodule i F).mp hF
        (MvPolynomial.mem_support_iff.mp hs)
      simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hhom
    obtain ⟨α, hα_ne⟩ : ∃ α : Fin (N + 1), s α ≠ 0 := by
      by_contra hall
      push_neg at hall
      simp [hall] at hdeg_s
      omega
    have hα_pos : 1 ≤ s α := Nat.pos_of_ne_zero hα_ne
    let s' : Fin (N + 1) →₀ ℕ := s - Finsupp.single α 1
    have hs_eq : Finsupp.single α 1 + s' = s := by
      ext γ
      simp only [s', Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
      split_ifs with hγ
      · subst hγ; omega
      · omega
    have hmon : MvPolynomial.monomial s (F.coeff s) =
        MvPolynomial.X α * MvPolynomial.monomial s' (F.coeff s) := by
      rw [MvPolynomial.X, MvPolynomial.monomial_mul, one_mul, hs_eq]
    rw [hmon]
    exact p.asHomogeneousIdeal.toIdeal.mul_mem_right _ (hX_mem α)

  
  
  
  let u_coord : Fin 3 → Fin 3 → R_2 := fun β =>
    match β with
    | 0 => ![1, MvPolynomial.X 0, MvPolynomial.X 1]
    | 1 => ![MvPolynomial.X 0, 1, MvPolynomial.X 1]
    | 2 => ![MvPolynomial.X 0, MvPolynomial.X 1, 1]

  have hu_self : ∀ β : Fin 3, u_coord β β = 1 := by
    intro β; fin_cases β <;> rfl

  have hu_succAbove : ∀ (β : Fin 3) (j : Fin 2),
      u_coord β (β.succAbove j) = MvPolynomial.X j := by
    intro β j; fin_cases β <;> fin_cases j <;> rfl

  let c_w_fn : Fin 3 → (Fin 3 → k) → Fin 2 → k :=
    fun β w j => w (β.succAbove j) * (w β)⁻¹

  have hu_eval_cw : ∀ (β : Fin 3) (w : Fin 3 → k), w β ≠ 0 →
      ∀ r : Fin 3, MvPolynomial.eval (c_w_fn β w) (u_coord β r) = w r * (w β)⁻¹ := by
    intro β w hwβ r
    fin_cases β <;> fin_cases r <;>
      simp_all [u_coord, c_w_fn, Fin.succAbove]

  have hChart_β : ∀ β : Fin 3,
      ∃ e_β : R_2 ≃+* HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β),
        (∀ c : k, e_β (MvPolynomial.C c) =
          HomogeneousLocalization.fromZeroRingHom 𝒜_2
            (Submonoid.powers (MvPolynomial.X β)) (algebraMap k ↥(𝒜_2 0) c)) ∧
        (∀ r : Fin 3, e_β (u_coord β r) =
          HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
              ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩,
              Submonoid.mem_powers (MvPolynomial.X β)⟩) ∧
        (∀ (d : ℕ) (F : MvPolynomial (Fin 3) k) (hF : F ∈ 𝒜_2 d)
            (hXd : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ d ∈ 𝒜_2 d),
          e_β.symm (HomogeneousLocalization.mk
            ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X β ^ d, hXd⟩,
              pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) d⟩) =
            MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β) F) := by
    intro β
    let S_β := Submonoid.powers (MvPolynomial.X β : MvPolynomial (Fin 3) k)
    let R_β := HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β)
    let c_hom : k →+* R_β :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_2 S_β).comp (algebraMap k ↥(𝒜_2 0))
    let x_val : Fin 2 → R_β := fun j =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X (β.succAbove j), MvPolynomial.isHomogeneous_X k (β.succAbove j)⟩,
          ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩,
          Submonoid.mem_powers (MvPolynomial.X β)⟩
    let φ_fwd : R_2 →+* R_β := MvPolynomial.eval₂Hom c_hom x_val
    let ev_β : MvPolynomial (Fin 3) k →+* R_2 :=
      MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β)
    have hev_unit : IsUnit (ev_β (MvPolynomial.X β)) := by
      change IsUnit (MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β) (MvPolynomial.X β))
      rw [MvPolynomial.eval₂Hom_X', hu_self β]
      exact isUnit_one
    let val_hom : R_β →+* Localization S_β :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let lift_β : Localization S_β →+* R_2 :=
      IsLocalization.Away.lift (MvPolynomial.X β) hev_unit
    let φ_bwd : R_β →+* R_2 := lift_β.comp val_hom
    have h_val_c : ∀ c : k,
        (c_hom c).val = algebraMap (MvPolynomial (Fin 3) k) (Localization S_β) (MvPolynomial.C c) := by
      intro c
      rfl
    have h_fwd_u : ∀ r : Fin 3, φ_fwd (u_coord β r) =
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
            ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩,
            Submonoid.mem_powers (MvPolynomial.X β)⟩ := by
      intro r
      by_cases hr : r = β
      · subst hr
        rw [hu_self r, map_one, HomogeneousLocalization.ext_iff_val,
          HomogeneousLocalization.val_one, HomogeneousLocalization.val_mk]
        exact (Localization.mk_self ⟨MvPolynomial.X r, Submonoid.mem_powers (MvPolynomial.X r)⟩).symm
      · have hex : ∃ j : Fin 2, β.succAbove j = r := by
          fin_cases β <;> fin_cases r <;> simp at hr ⊢
        rcases hex with ⟨j, rfl⟩
        rw [hu_succAbove β j]
        exact MvPolynomial.eval₂Hom_X' c_hom x_val j
    have h_bwd_mk : ∀ (d : ℕ) (F : MvPolynomial (Fin 3) k) (hF : F ∈ 𝒜_2 d)
        (hXd : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ d ∈ 𝒜_2 d),
        φ_bwd (HomogeneousLocalization.mk
          ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X β ^ d, hXd⟩,
            pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) d⟩) =
          ev_β F := by
      intro d F hF hXd
      let den_sub : S_β := ⟨MvPolynomial.X β ^ d,
        pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) d⟩
      have hval_eq : (HomogeneousLocalization.mk
          ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X β ^ d, hXd⟩, den_sub.2⟩).val =
          Localization.mk F den_sub := HomogeneousLocalization.val_mk _
      change lift_β (HomogeneousLocalization.mk
        ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X β ^ d, hXd⟩, den_sub.2⟩).val = ev_β F
      rw [hval_eq, Localization.mk_eq_mk']
      dsimp [lift_β, IsLocalization.Away.lift]
      rw [IsLocalization.lift_mk'_spec]
      have hev_Xd : ev_β (den_sub : MvPolynomial (Fin 3) k) = 1 := by
        change ev_β (MvPolynomial.X β ^ d) = 1
        rw [map_pow]
        change (MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β) (MvPolynomial.X β)) ^ d = 1
        rw [MvPolynomial.eval₂Hom_X', hu_self β, one_pow]
      rw [hev_Xd, one_mul]
    have h_left_inv : φ_bwd.comp φ_fwd = RingHom.id R_2 := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply]
        change lift_β (φ_fwd (MvPolynomial.C c)).val = MvPolynomial.C c
        have hfc : φ_fwd (MvPolynomial.C c) = c_hom c := MvPolynomial.eval₂Hom_C c_hom x_val c
        rw [hfc, h_val_c c]
        dsimp [lift_β]
        exact (IsLocalization.Away.lift_eq (S := Localization S_β) (MvPolynomial.X β) hev_unit
          (MvPolynomial.C c)).trans (MvPolynomial.eval₂Hom_C MvPolynomial.C (u_coord β) c)
      · intro j
        simp only [RingHom.comp_apply]
        have hxj : φ_fwd (MvPolynomial.X j) = x_val j := MvPolynomial.eval₂Hom_X' c_hom x_val j
        rw [hxj]
        have hX1 : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ 1 ∈ 𝒜_2 1 :=
          (pow_one (MvPolynomial.X β : MvPolynomial (Fin 3) k)).symm ▸ MvPolynomial.isHomogeneous_X k β
        have h1 := h_bwd_mk 1 (MvPolynomial.X (β.succAbove j))
          (MvPolynomial.isHomogeneous_X k (β.succAbove j)) hX1
        have hx_eq : x_val j = HomogeneousLocalization.mk ⟨1,
            ⟨MvPolynomial.X (β.succAbove j), MvPolynomial.isHomogeneous_X k (β.succAbove j)⟩,
            ⟨MvPolynomial.X β ^ 1, hX1⟩,
            pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) 1⟩ := by
          rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mk,
            HomogeneousLocalization.val_mk]
          congr 1
          exact Subtype.ext (pow_one _).symm
        rw [hx_eq, h1]
        change MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β) (MvPolynomial.X (β.succAbove j)) =
          MvPolynomial.X j
        rw [MvPolynomial.eval₂Hom_X', hu_succAbove β j]
    have h_right_inv : ∀ z : R_β, φ_fwd (φ_bwd z) = z := by
      intro z
      induction z using Quotient.inductionOn' with
      | h t =>
        change φ_fwd (φ_bwd (HomogeneousLocalization.mk t)) = HomogeneousLocalization.mk t
        rcases t with ⟨d, ⟨F, hF⟩, ⟨g, hg⟩, hden⟩
        have hden' : ∃ n : ℕ, MvPolynomial.X β ^ n = g := hden
        rcases hden' with ⟨n, rfl⟩
        have hXn_mem : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ n ∈ 𝒜_2 n :=
          (MvPolynomial.mem_homogeneousSubmodule n _).mpr (MvPolynomial.isHomogeneous_X_pow β n)
        have hXn_ne : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ n ≠ 0 :=
          pow_ne_zero n (MvPolynomial.X_ne_zero β)
        have hdn : d = n := by
          have hc1 := MvPolynomial.homogeneousComponent_of_mem (m := d) hg
          have hc2 := MvPolynomial.homogeneousComponent_of_mem (m := d) hXn_mem
          rw [if_pos rfl] at hc1
          rw [hc1] at hc2
          by_contra hne
          rw [if_neg hne] at hc2
          exact hXn_ne hc2
        subst hdn
        let den_d : S_β := ⟨MvPolynomial.X β ^ d,
          pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) d⟩
        have hmk_eq_den : (HomogeneousLocalization.mk
            ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X β ^ d, hg⟩, ⟨d, rfl⟩⟩ : R_β) =
            HomogeneousLocalization.mk ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X β ^ d, hg⟩, den_d.2⟩ := rfl
        rw [hmk_eq_den, h_bwd_mk d F hF hg]
        rw [HomogeneousLocalization.ext_iff_val]
        have hval_rhs : (HomogeneousLocalization.mk
            ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X β ^ d, hg⟩, den_d.2⟩ : R_β).val =
            Localization.mk F den_d := HomogeneousLocalization.val_mk _
        rw [hval_rhs]
        change val_hom (φ_fwd (ev_β F)) = Localization.mk F den_d
        conv_lhs => rw [MvPolynomial.as_sum F]
        rw [map_sum, map_sum, map_sum]
        have hF_hom : F.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d F).mp hF
        have hsum_mk : (∑ x ∈ F.support,
            val_hom (φ_fwd (ev_β ((MvPolynomial.monomial x) (F.coeff x))))) =
            ∑ x ∈ F.support, Localization.mk ((MvPolynomial.monomial x) (F.coeff x)) den_d := by
          refine Finset.sum_congr rfl fun s hs => ?_
          have hdeg_s : (∑ i : Fin 3, s i) = d := by
            have hd_wt := hF_hom (MvPolynomial.mem_support_iff.mp hs)
            simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hd_wt
          have hev_mon : ev_β (MvPolynomial.monomial s (F.coeff s)) =
              MvPolynomial.C (F.coeff s) * ∏ i : Fin 3, (u_coord β i) ^ (s i) := by
            change MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β)
              (MvPolynomial.monomial s (F.coeff s)) = _
            rw [MvPolynomial.eval₂Hom_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
          rw [hev_mon, map_mul, map_prod, map_mul]
          have hfc : φ_fwd (MvPolynomial.C (F.coeff s)) = c_hom (F.coeff s) :=
            MvPolynomial.eval₂Hom_C c_hom x_val (F.coeff s)
          rw [hfc, show val_hom (c_hom (F.coeff s)) =
              algebraMap (MvPolynomial (Fin 3) k) (Localization S_β) (MvPolynomial.C (F.coeff s)) from
              h_val_c (F.coeff s), map_prod]
          have hprod_val : (∏ i : Fin 3, val_hom (φ_fwd (u_coord β i ^ s i))) =
              Localization.mk (∏ i : Fin 3, (MvPolynomial.X i : MvPolynomial (Fin 3) k) ^ s i)
                den_d := by
            have hterm : ∀ i : Fin 3, val_hom (φ_fwd (u_coord β i ^ s i)) =
                Localization.mk ((MvPolynomial.X i : MvPolynomial (Fin 3) k) ^ s i)
                  ⟨MvPolynomial.X β ^ s i,
                    pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) (s i)⟩ := by
              intro i
              rw [map_pow, map_pow, h_fwd_u i]
              change ((HomogeneousLocalization.mk _).val) ^ s i = _
              rw [HomogeneousLocalization.val_mk, Localization.mk_pow]
              rfl
            simp_rw [hterm]
            rw [Fin.prod_univ_three, Fin.prod_univ_three, Localization.mk_mul, Localization.mk_mul]
            congr 1
            apply Subtype.ext
            change MvPolynomial.X β ^ s 0 * MvPolynomial.X β ^ s 1 * MvPolynomial.X β ^ s 2 =
              MvPolynomial.X β ^ d
            rw [← pow_add, ← pow_add, ← Fin.sum_univ_three, hdeg_s]
          rw [hprod_val, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul]
          congr 1
          · have hmon_prod : (∏ i : Fin 3, (MvPolynomial.X i : MvPolynomial (Fin 3) k) ^ s i) =
                MvPolynomial.monomial s 1 := by
              rw [MvPolynomial.monomial_eq, MvPolynomial.C_1, one_mul,
                Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
            rw [hmon_prod, MvPolynomial.C_mul_monomial, mul_one]
          · exact Subtype.ext (one_mul _)
        rw [hsum_mk]
        have hmk_sum : ∀ (S : Finset (Fin 3 →₀ ℕ)),
            (∑ x ∈ S, Localization.mk ((MvPolynomial.monomial x) (F.coeff x)) den_d) =
            Localization.mk (∑ x ∈ S, (MvPolynomial.monomial x) (F.coeff x)) den_d := by
          intro S
          induction S using Finset.induction_on with
          | empty => simp [Localization.mk_zero]
          | insert a S ha ih =>
            rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
        rw [hmk_sum, ← MvPolynomial.as_sum F]
    let e_β : R_2 ≃+* R_β :=
      { φ_fwd with
        invFun := φ_bwd
        left_inv := fun p => RingHom.congr_fun h_left_inv p
        right_inv := h_right_inv }
    refine ⟨e_β, ?_, h_fwd_u, ?_⟩
    · intro c
      exact MvPolynomial.eval₂Hom_C c_hom x_val c
    · intro d F hF hXd
      exact h_bwd_mk d F hF hXd

  
  
  
  have hProj_mem_asIdeal_iff : ∀ {N : ℕ},
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      ∀ (α : Fin (N + 1)),
        letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
        ∀ (hXα : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
          (p : (weilProjectiveSpaceOver k N).left)
          (hp : p ∈ (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α) :
            (weilProjectiveSpaceOver k N).left.Opens))
          (d : ℕ) (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N d)
          (hXd : (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ^ d ∈ 𝒜_N d),
          HomogeneousLocalization.mk
              ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X α ^ d, hXd⟩,
                pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) d⟩ ∈
            ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom.base
              ⟨p, hp⟩).asIdeal ↔
          F ∈ ProjectiveSpectrum.asHomogeneousIdeal p := by
    intro N 𝒜_N α
    letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    intro hXα p hp d F hF hXd
    let p' : AlgebraicGeometry.Proj 𝒜_N := p
    have hp' : p' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α) := hp
    let t : HomogeneousLocalization.NumDenSameDeg 𝒜_N (Submonoid.powers (MvPolynomial.X α)) :=
      ⟨d, ⟨F, hF⟩, ⟨MvPolynomial.X α ^ d, hXd⟩,
        pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) d⟩
    have hpre := AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec_preimage_basicOpen 𝒜_N t
    have hmem_open := SetLike.ext_iff.mp hpre ⟨p', hp'⟩
    let q_pt : PrimeSpectrum (HomogeneousLocalization 𝒜_N (Submonoid.powers (MvPolynomial.X α))) :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α) hXα zero_lt_one).hom.base ⟨p', hp'⟩
    have hnot_ideal : HomogeneousLocalization.mk t ∉ q_pt.asIdeal ↔
        p' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N F := by
      change q_pt ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.mk t) ↔
        p' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N F at hmem_open
      rwa [PrimeSpectrum.mem_basicOpen] at hmem_open
    rw [AlgebraicGeometry.Proj.mem_basicOpen 𝒜_N F p'] at hnot_ideal
    exact not_iff_not.mp hnot_ideal

  
  
  
  have h_mod1 : ∀ (d : ℕ) {Y B Z L_sch : AlgebraicGeometry.Scheme.{u}}
      (g : Y ⟶ B) [AlgebraicGeometry.IsProper g]
      (f : Z ⟶ L_sch) (ι_Z : Z ⟶ Y) (ι_L : L_sch ⟶ B)
      (hPb : CategoryTheory.IsPullback ι_Z f g ι_L),
      ∃ (W_sm : B.Opens),
        (∀ b : B, b ∉ W_sm →
          ∃ y : Y, g.base y = b ∧
            ¬ ∃ V : Y.Opens, y ∈ V ∧
              AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ g)) ∧
        (∀ (U_B : B.Opens), U_B ≤ W_sm →
          AlgebraicGeometry.SmoothOfRelativeDimension d (g ∣_ U_B)) ∧
        (∀ (U_B : B.Opens) (U_L : L_sch.Opens),
          U_B ≤ W_sm →
          (TopologicalSpace.Opens.map ι_L.base).obj U_B = U_L →
          AlgebraicGeometry.SmoothOfRelativeDimension d (f ∣_ U_L)) ∧
        (Set.range ι_L.base ⊆ (W_sm : Set B) →
          AlgebraicGeometry.SmoothOfRelativeDimension d f) := by
    intro d Y B Z L_sch g _ f ι_Z ι_L hPb
    let S_open : Set Y.Opens := { V : Y.Opens | AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ g) }
    let U_sm : Y.Opens := sSup S_open
    have hSm_Usm : AlgebraicGeometry.SmoothOfRelativeDimension d (U_sm.ι ≫ g) := by
      refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun x => ?_
      obtain ⟨V : Y.Opens, hVS, hxV⟩ := TopologicalSpace.Opens.mem_sSup.mp x.2
      have hle_V : V ≤ U_sm := le_sSup (s := S_open) hVS
      let j : V.toScheme ⟶ U_sm.toScheme := Y.homOfLE hle_V
      have hj_ι : j ≫ U_sm.ι = V.ι := AlgebraicGeometry.Scheme.homOfLE_ι Y hle_V
      obtain ⟨U_aff, hAffU, V', hAffV', hxV', he', hStd'⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff d (V.ι ≫ g)).mp hVS ⟨x.1, hxV⟩
      let f_V : V'.toScheme ⟶ U_sm.toScheme := V'.ι ≫ j
      let W'_open : U_sm.toScheme.Opens := f_V.opensRange
      haveI : AlgebraicGeometry.IsAffine V'.toScheme := hAffV'
      have hAffW' : AlgebraicGeometry.IsAffineOpen W'_open :=
        AlgebraicGeometry.isAffineOpen_opensRange f_V
      have hxW' : x ∈ W'_open := by
        change x ∈ Set.range f_V.base
        let x_V' : V'.toScheme := ⟨⟨x.1, hxV⟩, hxV'⟩
        have hfV_ι : f_V ≫ U_sm.ι = V'.ι ≫ V.ι := by
          dsimp [f_V]
          rw [CategoryTheory.Category.assoc, hj_ι]
        have hι_eq : U_sm.ι.base (f_V.base x_V') = U_sm.ι.base x :=
          congrArg (fun h : V'.toScheme ⟶ Y => h.base x_V') hfV_ι
        exact ⟨x_V', Subtype.val_injective hι_eq⟩
      have heW' : W'_open ≤ (TopologicalSpace.Opens.map (U_sm.ι ≫ g).base).obj U_aff := by
        intro z hz
        rcases (show z ∈ Set.range f_V.base from hz) with ⟨y', rfl⟩
        change (f_V ≫ U_sm.ι ≫ g).base y' ∈ U_aff
        have hfV_eq : f_V ≫ U_sm.ι ≫ g = V'.ι ≫ (V.ι ≫ g) := by
          dsimp [f_V]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j, hj_ι]
        rw [hfV_eq]
        exact he' y'.2
      have hVW : V' ≤ (TopologicalSpace.Opens.map j.base).obj W'_open := by
        intro y' hy'
        change j.base y' ∈ Set.range f_V.base
        exact ⟨⟨y', hy'⟩, rfl⟩
      have hres_iso_eq : j.resLE W'_open V' hVW = f_V.isoOpensRange.hom := by
        apply (CategoryTheory.cancel_mono W'_open.ι).mp
        rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
          AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι]
      haveI : CategoryTheory.IsIso (j.resLE W'_open V' hVW) := by
        rw [hres_iso_eq]; infer_instance
      haveI : CategoryTheory.IsIso V'.toSpecΓ := by
        rw [← hAffV'.isoSpec_hom]; infer_instance
      haveI : CategoryTheory.IsIso W'_open.toSpecΓ := by
        rw [← hAffW'.isoSpec_hom]; infer_instance
      have hSpec_iso : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (j.appLE W'_open V' hVW)) := by
        have hnat := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE j W'_open V' hVW
        have heq : AlgebraicGeometry.Spec.map (j.appLE W'_open V' hVW) =
            CategoryTheory.inv V'.toSpecΓ ≫ j.resLE W'_open V' hVW ≫ W'_open.toSpecΓ := by
          rw [CategoryTheory.IsIso.eq_inv_comp, hnat]
        rw [heq]
        infer_instance
      haveI : CategoryTheory.IsIso (j.appLE W'_open V' hVW) := by
        let inv_mor := AlgebraicGeometry.Spec.preimage
          (@CategoryTheory.inv _ _ _ _ (AlgebraicGeometry.Spec.map (j.appLE W'_open V' hVW)) hSpec_iso)
        refine ⟨⟨inv_mor, ?_, ?_⟩⟩
        · apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            CategoryTheory.IsIso.inv_hom_id, AlgebraicGeometry.Spec.map_id]
        · apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            CategoryTheory.IsIso.hom_inv_id, AlgebraicGeometry.Spec.map_id]
      have happ_comp : (U_sm.ι ≫ g).appLE U_aff W'_open heW' ≫ j.appLE W'_open V' hVW =
          (V.ι ≫ g).appLE U_aff V' he' := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
        have hj_g : j ≫ U_sm.ι ≫ g = V.ι ≫ g := by
          rw [← CategoryTheory.Category.assoc, hj_ι]
        congr 1
      refine ⟨U_aff, hAffU, W'_open, hAffW', hxW', heW', ?_⟩
      exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d).cancel_right_isIso
        ((U_sm.ι ≫ g).appLE U_aff W'_open heW') (j.appLE W'_open V' hVW) |>.mp
        (by rw [← CommRingCat.hom_comp, happ_comp]; exact hStd')
    let Sigma_Y : Set Y := (U_sm : Set Y)ᶜ
    have hCl_Sigma : IsClosed Sigma_Y := U_sm.isOpen.isClosed_compl
    let W_sm : B.Opens := ⟨(g.base '' Sigma_Y)ᶜ, (g.isClosedMap Sigma_Y hCl_Sigma).isOpen_compl⟩
    have hSm_restrict : ∀ (U_B : B.Opens), U_B ≤ W_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension d (g ∣_ U_B) := by
      intro U_B hUB
      let V_B : Y.Opens := (TopologicalSpace.Opens.map g.base).obj U_B
      have hVB : V_B ≤ U_sm := by
        intro y hy
        by_contra hnot
        have hmem_im : g.base y ∈ g.base '' Sigma_Y := ⟨y, hnot, rfl⟩
        exact (hUB hy) hmem_im
      have hSm_VB : AlgebraicGeometry.SmoothOfRelativeDimension d (V_B.ι ≫ g) := by
        have hcomp_VB : V_B.ι ≫ g = Y.homOfLE hVB ≫ (U_sm.ι ≫ g) := by
          rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
        rw [hcomp_VB]
        haveI : AlgebraicGeometry.SmoothOfRelativeDimension d (U_sm.ι ≫ g) := hSm_Usm
        exact Nat.zero_add d ▸ AlgebraicGeometry.smoothOfRelativeDimension_comp 0 d
          (Y.homOfLE hVB) (U_sm.ι ≫ g)
      have hPb_VB : CategoryTheory.IsPullback (𝟙 V_B.toScheme) (g ∣_ U_B) (V_B.ι ≫ g) U_B.ι := by
        refine CategoryTheory.IsPullback.of_isLimit (c := CategoryTheory.Limits.PullbackCone.mk
          (𝟙 V_B.toScheme) (g ∣_ U_B) ?_) ?_
        · rw [CategoryTheory.Category.id_comp]
          exact (AlgebraicGeometry.morphismRestrict_ι g U_B).symm
        · refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
            (fun s => s.fst)
            (fun s => CategoryTheory.Category.comp_id s.fst)
            (fun s => ?_)
            (fun s m hm _ => by simpa using hm)
          apply (CategoryTheory.cancel_mono U_B.ι).mp
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι]
          exact s.condition
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_VB hSm_VB
    have hSm_pb_open : ∀ (U_B : B.Opens) (U_L : L_sch.Opens),
        U_B ≤ W_sm →
        (TopologicalSpace.Opens.map ι_L.base).obj U_B = U_L →
        AlgebraicGeometry.SmoothOfRelativeDimension d (f ∣_ U_L) := by
      intro U_B U_L hUB hUL_eq
      let V_L : Z.Opens := (TopologicalSpace.Opens.map f.base).obj U_L
      let V_B : Y.Opens := (TopologicalSpace.Opens.map g.base).obj U_B
      have hVL_VB : V_L ≤ (TopologicalSpace.Opens.map ι_Z.base).obj V_B := by
        intro z hz
        have hz' : f.base z ∈ (TopologicalSpace.Opens.map ι_L.base).obj U_B := by
          rwa [hUL_eq]
        change g.base (ι_Z.base z) ∈ U_B
        have hcomm_z : g.base (ι_Z.base z) = ι_L.base (f.base z) :=
          congrArg (fun h : Z ⟶ B => h.base z) hPb.w
        rw [hcomm_z]
        exact hz'
      let u_L : U_L.toScheme ⟶ U_B.toScheme :=
        L_sch.homOfLE (le_of_eq hUL_eq.symm) ≫ (ι_L ∣_ U_B)
      let u_Z : V_L.toScheme ⟶ V_B.toScheme :=
        Z.homOfLE hVL_VB ≫ (ι_Z ∣_ V_B)
      have hu_L : u_L ≫ U_B.ι = U_L.ι ≫ ι_L := by
        dsimp [u_L]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      have hu_Z : u_Z ≫ V_B.ι = V_L.ι ≫ ι_Z := by
        dsimp [u_Z]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      have hcomm_sq : u_Z ≫ (g ∣_ U_B) = (f ∣_ U_L) ≫ u_L := by
        apply (CategoryTheory.cancel_mono U_B.ι).mp
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.Category.assoc, hu_Z, CategoryTheory.Category.assoc, hPb.w,
          CategoryTheory.Category.assoc, hu_L, ← CategoryTheory.Category.assoc (f ∣_ U_L),
          AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
      have hPb_tot : CategoryTheory.IsPullback (u_Z ≫ V_B.ι) (f ∣_ U_L) g (u_L ≫ U_B.ι) := by
        rw [hu_Z, hu_L]
        exact ((AlgebraicGeometry.isPullback_morphismRestrict f U_L).flip).paste_horiz hPb
      have hPb_right : CategoryTheory.IsPullback V_B.ι (g ∣_ U_B) g U_B.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict g U_B).flip
      have hPb_left : CategoryTheory.IsPullback u_Z (f ∣_ U_L) (g ∣_ U_B) u_L :=
        CategoryTheory.IsPullback.of_right hPb_tot hcomm_sq hPb_right
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_left
        (hSm_restrict U_B hUB)
    refine ⟨W_sm, ?_, hSm_restrict, hSm_pb_open, ?_⟩
    · intro b hb
      have hb' : b ∈ g.base '' Sigma_Y := by
        by_contra hnot
        exact hb hnot
      rcases hb' with ⟨y, hy_notU, rfl⟩
      refine ⟨y, rfl, ?_⟩
      rintro ⟨V, hyV, hSmV⟩
      exact hy_notU (le_sSup (s := S_open) hSmV hyV)
    · intro hRange
      have hMap_top : (TopologicalSpace.Opens.map ι_L.base).obj W_sm = ⊤ := by
        apply le_antisymm le_top
        intro x _
        exact hRange ⟨x, rfl⟩
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension d (f ∣_ ⊤) :=
        hSm_pb_open W_sm ⊤ le_rfl hMap_top
      let O_Z : Z.Opens := (TopologicalSpace.Opens.map f.base).obj ⊤
      have hOZ_range : O_Z.ι.opensRange = ⊤ := by
        ext z
        simp [O_Z]
      haveI : CategoryTheory.IsIso O_Z.ι :=
        AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top O_Z.ι hOZ_range
      have hf_eq : f = CategoryTheory.inv O_Z.ι ≫ (f ∣_ ⊤) ≫ (⊤ : L_sch.Opens).ι := by
        rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.IsIso.inv_hom_id_assoc]
      rw [hf_eq]
      have hSm_d0 : AlgebraicGeometry.SmoothOfRelativeDimension (d + 0)
          ((f ∣_ ⊤) ≫ (⊤ : L_sch.Opens).ι) :=
        AlgebraicGeometry.smoothOfRelativeDimension_comp d 0 (f ∣_ ⊤) (⊤ : L_sch.Opens).ι
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension d
          ((f ∣_ ⊤) ≫ (⊤ : L_sch.Opens).ι) := Nat.add_zero d ▸ hSm_d0
      exact Nat.zero_add d ▸ AlgebraicGeometry.smoothOfRelativeDimension_comp 0 d
        (CategoryTheory.inv O_Z.ι) ((f ∣_ ⊤) ≫ (⊤ : L_sch.Opens).ι)

  
  
  
  have h_mod2 : ∀ (K : Set (weilProjectiveSpaceOver k 2).left), IsClosed K →
      ∀ (d_H : ℕ) (H : MvPolynomial (Fin 3) k), H ∈ 𝒜_2 d_H →
      (K ∩ (AlgebraicGeometry.Proj.basicOpen 𝒜_2 H :
        (weilProjectiveSpaceOver k 2).left.Opens).1).Nonempty →
      ∃ (p₀ : (weilProjectiveSpaceOver k 2).left) (w : Fin 3 → k),
        p₀ ∈ K ∧
        w ≠ 0 ∧
        MvPolynomial.eval w H ≠ 0 ∧
        (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
          F ∈ 𝒜_2 d →
          (F ∈ ProjectiveSpectrum.asHomogeneousIdeal p₀ ↔ MvPolynomial.eval w F = 0)) := by
    intro K hClosed_K d_H H hH_hom ⟨q_init, hq_K, hq_H⟩
    obtain ⟨β, hq_β⟩ := hProj_cover 2 q_init
    obtain ⟨e_β, _, _, he_symm_mk⟩ := hChart_β β
    let U_β : (weilProjectiveSpaceOver k 2).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)
    have hXβ : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
      MvPolynomial.isHomogeneous_X k β
    let iso_Specβ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_2 (MvPolynomial.X β) hXβ zero_lt_one
    have h_eβ_hom_inv : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_β.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_β.symm.toRingHom) = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        e_β.toRingHom_comp_symm_toRingHom, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have h_eβ_inv_hom : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_β.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_β.toRingHom) = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        e_β.symm_toRingHom_comp_toRingHom, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    let iso_eβ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of R_2) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_β.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_β.symm.toRingHom)
        hom_inv_id := h_eβ_hom_inv
        inv_hom_id := h_eβ_inv_hom }
    let φ_chart : U_β.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of R_2) :=
