    · intro z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨d, s⟩, hds⟩ := IsLocalization.surj q.primeCompl a
      have hs' : φ_D s.1 ∈ q'.primeCompl := by
        change φ_D s.1 ∉ q'
        rw [← Ideal.mem_comap, hcomap_q']
        exact s.2
      refine ⟨(φ_D d, ⟨φ_D s.1, hs'⟩), ?_⟩
      change Ideal.Quotient.mk I_A a * ψ_loc (φ_D s.1) = ψ_loc (φ_D d)
      rw [hψ_loc_apply, hψ_loc_apply, ← map_mul, hds]
    · intro x₁ x₂ h_eq
      obtain ⟨d₁, rfl⟩ := hφ_surj x₁
      obtain ⟨d₂, rfl⟩ := hφ_surj x₂
      change ψ_loc (φ_D d₁) = ψ_loc (φ_D d₂) at h_eq
      rw [hψ_loc_apply, hψ_loc_apply] at h_eq
      have hmem_IA : algebraMap D A (d₁ - d₂) ∈ I_A := by
        rw [map_sub]
        exact Ideal.Quotient.eq_zero_iff_mem.mp (sub_eq_zero.mpr h_eq)
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hmem_IA
      obtain ⟨⟨c, s₁⟩, hcs₁⟩ := IsLocalization.surj q.primeCompl b
      have hA_eq : algebraMap D A ((d₁ - d₂) * s₁.1) = algebraMap D A (ϖ_D * c) := by
        rw [map_mul, hb, mul_assoc, hcs₁, map_mul]
