            change (ρ.hom.app (Opposite.op V₁)) ((oneR_S.obj.map v₁.op) s) = 0
            rw [hnat_ρ, hs_zero, map_zero]
          exact h_lhs1.trans (h_lhs2.trans
            ((congrArg (ρ_app V₁) h_lhs3).trans (h_lhs4.trans hzero_rhs.symm)))
        have heq_mem :=
          Presheaf.IsLocallyInjective.equalizerSieve_mem
            (J := Z.smallEtaleTopology)
            (φ := toSheafify Z.smallEtaleTopology P_const_Z)
            (X := Opposite.op (B.obj V₁)) r_Z z_Z hr_Z_zero
        obtain ⟨W_Z, g_Z, _, hg_eq, _, _⟩ := hMemEtale.mp heq_mem z₁
        have hr_zero : r_val = 0 := hg_eq
        refine ⟨V₁, v₁, x₁, ⟨0, ?_⟩, hv₁_et, hx₁_eq⟩
        have hr_val' : (toSheafify S.smallEtaleTopology P_const_S).app (Opposite.op V₁) r_val =
            oneR_S.obj.map v₁.op s := hr_val
        rw [hr_zero, map_zero] at hr_val'
        exact (map_zero (κ.hom.app (Opposite.op V₁)).hom).trans hr_val'
    let x_fam : Presieve.FamilyOfElements
        (L_U.obj ⋙ coyoneda.obj (Opposite.op M_R)) R_s.arrows :=
      fun W g hg =>
        ModuleCat.ofHom (LinearMap.toSpanSingleton (ULift.{u, 0} (ZMod n)) _ (Classical.choose hg))
    have hx_compat : x_fam.Compatible := by
      intro Y₁ Y₂ X₀ f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      change x_fam g₁ hg₁ ≫ L_U.obj.map f₁.op = x_fam g₂ hg₂ ≫ L_U.obj.map f₂.op
      apply ModuleCat.hom_ext
      apply LinearMap.ext_ring
      apply hκ_inj X₀
      have hn1 := congrArg (fun u => u ((x_fam g₁ hg₁).hom (1 : R))) (κ.hom.naturality f₁.op)
      have hn2 := congrArg (fun u => u ((x_fam g₂ hg₂).hom (1 : R))) (κ.hom.naturality f₂.op)
      simp only [ConcreteCategory.comp_apply] at hn1 hn2
      change (κ.hom.app (Opposite.op X₀)) ((L_U.obj.map f₁.op) ((x_fam g₁ hg₁).hom (1 : R))) =
        (κ.hom.app (Opposite.op X₀)) ((L_U.obj.map f₂.op) ((x_fam g₂ hg₂).hom (1 : R)))
      rw [hn1, hn2]
      have hc1 : (x_fam g₁ hg₁).hom (1 : R) = Classical.choose hg₁ := by
        change (LinearMap.toSpanSingleton (ULift.{u, 0} (ZMod n)) _ (Classical.choose hg₁)) (1 : R) = _
        simp only [LinearMap.toSpanSingleton_apply, one_smul]
      have hc2 : (x_fam g₂ hg₂).hom (1 : R) = Classical.choose hg₂ := by
        change (LinearMap.toSpanSingleton (ULift.{u, 0} (ZMod n)) _ (Classical.choose hg₂)) (1 : R) = _
        simp only [LinearMap.toSpanSingleton_apply, one_smul]
      rw [hc1, hc2, Classical.choose_spec hg₁, Classical.choose_spec hg₂,
        ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply,
        ← oneR_S.obj.map_comp, ← oneR_S.obj.map_comp, ← op_comp, ← op_comp, hcomm]
    let u_V : M_R ⟶ L_U.obj.obj (Opposite.op V) :=
      (L_U.property M_R R_s hRs_mem).amalgamate x_fam hx_compat
    have hu_amalg := (L_U.property M_R R_s hRs_mem).isAmalgamation hx_compat
    let s_hom : M_R ⟶ oneR_S.obj.obj (Opposite.op V) :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton (ULift.{u, 0} (ZMod n)) _ s)
    let y_s : Presieve.FamilyOfElements
        (oneR_S.obj ⋙ coyoneda.obj (Opposite.op M_R)) R_s.arrows :=
      fun W g _ => s_hom ≫ oneR_S.obj.map g.op
    have hu_κ : u_V ≫ κ.hom.app (Opposite.op V) = s_hom := by
      refine (oneR_S.property M_R R_s hRs_mem).isSeparatedFor y_s _ _ ?_ (fun _ _ _ => rfl)
      intro W g hg
      change (u_V ≫ κ.hom.app (Opposite.op V)) ≫ oneR_S.obj.map g.op =
        s_hom ≫ oneR_S.obj.map g.op
      rw [Category.assoc, ← κ.hom.naturality g.op, ← Category.assoc]
      have hg_amalg : u_V ≫ L_U.obj.map g.op = x_fam g hg := hu_amalg g hg
      rw [hg_amalg]
      apply ModuleCat.hom_ext
      apply LinearMap.ext_ring
      change (κ.hom.app (Opposite.op W)) ((x_fam g hg).hom (1 : R)) =
        (oneR_S.obj.map g.op) (s_hom.hom (1 : R))
      have hc_x : (x_fam g hg).hom (1 : R) = Classical.choose hg := by
        change (LinearMap.toSpanSingleton (ULift.{u, 0} (ZMod n)) _ (Classical.choose hg)) (1 : R) = _
        simp only [LinearMap.toSpanSingleton_apply, one_smul]
      have hc_s : s_hom.hom (1 : R) = s := by
        change (LinearMap.toSpanSingleton (ULift.{u, 0} (ZMod n)) _ s) (1 : R) = _
        simp only [LinearMap.toSpanSingleton_apply, one_smul]
      rw [hc_x, hc_s]
      exact Classical.choose_spec hg
    refine ⟨u_V.hom (1 : R), ?_⟩
    have hap : (u_V ≫ κ.hom.app (Opposite.op V)).hom (1 : R) = s_hom.hom (1 : R) :=
      congrArg (fun (ψ : M_R ⟶ oneR_S.obj.obj (Opposite.op V)) => ψ.hom (1 : R)) hu_κ
    have hc_s : s_hom.hom (1 : R) = s := by
      change (LinearMap.toSpanSingleton (ULift.{u, 0} (ZMod n)) _ s) (1 : R) = _
      simp only [LinearMap.toSpanSingleton_apply, one_smul]
    exact (ConcreteCategory.comp_apply u_V (κ.hom.app (Opposite.op V)) (1 : R)).symm.trans
      (hap.trans hc_s)

  have hLiftFork : ∀ (fork : Limits.KernelFork ρ),
      ∃ lift_sh : fork.pt ⟶ L_U, lift_sh ≫ κ = fork.ι := by
    intro fork
    have hfork_zero : ∀ (V : S.Etale) (y : ↥(fork.pt.obj.obj (Opposite.op V))),
        (ρ.hom.app (Opposite.op V)) ((fork.ι.hom.app (Opposite.op V)) y) = 0 := by
      intro V y
      have hcond := congrArg
        (fun (u : fork.pt ⟶ P_push_R.obj oneR_Z) => (u.hom.app (Opposite.op V)) y) fork.condition
      change ((fork.ι.hom.app (Opposite.op V) ≫ ρ.hom.app (Opposite.op V)) y) = 0 at hcond
      rwa [ConcreteCategory.comp_apply] at hcond
    let lift_fun : ∀ (V : S.Etale),
        ↥(fork.pt.obj.obj (Opposite.op V)) → ↥(L_U.obj.obj (Opposite.op V)) :=
      fun V y => Classical.choose (hKerSec V _ (hfork_zero V y))
    have hlift_spec : ∀ (V : S.Etale) (y : ↥(fork.pt.obj.obj (Opposite.op V))),
        (κ.hom.app (Opposite.op V)) (lift_fun V y) = (fork.ι.hom.app (Opposite.op V)) y :=
      fun V y => Classical.choose_spec (hKerSec V _ (hfork_zero V y))
    let lift_sh : fork.pt ⟶ L_U :=
      { hom :=
          { app := fun opV => ModuleCat.ofHom
              { toFun := lift_fun opV.unop
                map_add' := fun y₁ y₂ => hκ_inj opV.unop (by
                  change (κ.hom.app opV) _ = (κ.hom.app opV) _
                  rw [map_add, hlift_spec opV.unop (y₁ + y₂), hlift_spec opV.unop y₁,
                    hlift_spec opV.unop y₂, map_add])
                map_smul' := fun r y => hκ_inj opV.unop (by
                  change (κ.hom.app opV) _ = (κ.hom.app opV) _
                  rw [map_smul, hlift_spec opV.unop (r • y), hlift_spec opV.unop y,
                    RingHom.id_apply, map_smul]) }
            naturality := fun {opV₂ opV₁} f => ModuleCat.hom_ext (LinearMap.ext fun y =>
              hκ_inj opV₁.unop (by
                have hnat_κ := congrArg (fun u => u (lift_fun opV₂.unop y)) (κ.hom.naturality f)
                have hnat_ι := congrArg (fun u => u y) (fork.ι.hom.naturality f)
                simp only [ConcreteCategory.comp_apply] at hnat_κ hnat_ι
                exact (hlift_spec opV₁.unop ((fork.pt.obj.map f) y)).trans
                  (hnat_ι.trans ((congrArg (oneR_S.obj.map f)
                    (hlift_spec opV₂.unop y).symm).trans hnat_κ.symm)))) } }
    refine ⟨lift_sh, ?_⟩
    apply ObjectProperty.hom_ext
    apply NatTrans.ext
    funext opV
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    exact hlift_spec opV.unop y

  have hIsLim_κ : Limits.IsLimit (Limits.KernelFork.ofι κ h0_κρ) :=
    Limits.Fork.IsLimit.mk _
      (fun fork => Classical.choose (hLiftFork fork))
      (fun fork => Classical.choose_spec (hLiftFork fork))
      (fun fork m hm => (cancel_mono κ).mp (hm.trans (Classical.choose_spec (hLiftFork fork)).symm))

  have hSES : (ShortComplex.mk κ ρ h0_κρ).ShortExact :=
    { exact := ShortComplex.exact_of_f_is_kernel _ hIsLim_κ
      mono_f := hMono_κ
      epi_g := hEpi_ρ }

  
  
  
  obtain ⟨θ_Z, hθ_Z⟩ := hModEx Z n q₁
  have hInj_Z : Function.Injective θ_Z := hModInj Z n q₁ θ_Z hθ_Z
  let FgtMod : (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) ⥤ AddCommGrpCat.{u} := forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) AddCommGrpCat.{u}
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))

  
  have hIntSmulEq : ∀ {M₀ : ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))} (k : ℤ) (x : M₀),
      k • x = (ULift.up (k : ZMod n) : ULift.{u, 0} (ZMod n)) • x := by
    intro M₀ k x
    induction k using Int.induction_on with
    | zero =>
      simp only [zero_zsmul, Int.cast_zero]
      change (0 : M₀) = (0 : ULift.{u, 0} (ZMod n)) • x
      rw [zero_smul]
    | succ m ih =>
      rw [add_zsmul, one_zsmul, ih, Int.cast_add, Int.cast_one]
      have hup : (ULift.up (((m : ℤ) : ZMod n) + 1) : ULift.{u, 0} (ZMod n)) =
          ULift.up ((m : ℤ) : ZMod n) + (1 : ULift.{u, 0} (ZMod n)) := rfl
      rw [hup, add_smul, one_smul]
    | pred m ih =>
      let m_int : ℤ := -(m : ℤ)
      change (m_int - 1) • x = (ULift.up ((m_int - 1 : ℤ) : ZMod n) : ULift.{u, 0} (ZMod n)) • x
      have ih' : m_int • x = (ULift.up (m_int : ZMod n) : ULift.{u, 0} (ZMod n)) • x := ih
      rw [sub_zsmul, one_zsmul, ih', Int.cast_sub, Int.cast_one]
      have hup : (ULift.up ((m_int : ZMod n) - 1) : ULift.{u, 0} (ZMod n)) =
          ULift.up (m_int : ZMod n) - (1 : ULift.{u, 0} (ZMod n)) := rfl
      rw [hup, sub_smul, one_smul, sub_eq_add_neg]

  have hRSmulValMin : ∀ {M₀ : ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))}
      (r : ULift.{u, 0} (ZMod n)) (x : M₀),
      r • x = (r.down.valMinAbs : ℤ) • x := by
    intro M₀ r x
    rw [hIntSmulEq (r.down.valMinAbs) x, ZMod.coe_valMinAbs]

  let ffFgtMod : FgtMod.FullyFaithful :=
    { preimage := fun {M₁ M₂} f => ModuleCat.ofHom
        { toAddHom := f.hom.toAddHom
          map_smul' := fun r x => by
            let y : M₂ := f.hom x
            change (f.hom (r • x) : M₂) = r • y
            rw [@hRSmulValMin M₁ r x, @hRSmulValMin M₂ r y]
            exact map_zsmul f.hom r.down.valMinAbs x }
      map_preimage := fun _ => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun _ => rfl)
      preimage_map := fun _ => ModuleCat.hom_ext (LinearMap.ext fun _ => rfl) }

  
  have hSheafHeq : ∀ {X : Scheme.{u}}
      {A₁ A₂ B₁ B₂ : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (p₁ : A₁ = B₁) (p₂ : A₂ = B₂) (opW : X.Etaleᵒᵖ)
      (u₁ : A₁.obj.obj opW ⟶ A₂.obj.obj opW)
      (u₂ : B₁.obj.obj opW ⟶ B₂.obj.obj opW),
      HEq u₁ u₂ →
      u₁ = ((eqToHom p₁).hom).app opW ≫ u₂ ≫ ((eqToHom p₂.symm).hom).app opW := by
    rintro X A₁ A₂ _ _ rfl rfl opW u₁ u₂ h
    simp only [eqToHom_refl]
    exact (eq_of_heq h).trans (by
      change u₂ = 𝟙 _ ≫ u₂ ≫ 𝟙 _
      rw [Category.comp_id, Category.id_comp])

  obtain ⟨U_S, hUS_obj, hUS_map, hAdd_US, hLim_US, hColim_US, T_S, hT_S, hTS_left, hTS_hom, hθ_S_rest⟩ := hθ_S
  obtain ⟨u_unit_S, hu_unit_S, βM_S, hαβ_S, hβα_S, hθS_eq⟩ := hθ_S_rest
  have hHasComp_S : S.smallEtaleTopology.HasSheafCompose FgtMod :=
