          _ = q_loc γ ≫ ((u₁ γ).isoOpensRange.hom ≫ (U₁_cov γ).ι) :=
                congrArg (q_loc γ ≫ ·)
                  (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι (u₁ γ)).symm
          _ = (q_loc γ ≫ (u₁ γ).isoOpensRange.hom) ≫ (U₁_cov γ).ι :=
                (CategoryTheory.Category.assoc _ _ _).symm
      · rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι (U₁_cov γ)]
        exact hUk_pre γ
    have hφ_tilde_k : ∀ γ : Γ,
        (q_loc γ ≫ (u₁ γ).isoOpensRange.hom) ≫ φ_tilde γ =
          u_k γ ≫ (φ_bar e).left ≫ p_tgt := by
      intro γ
      dsimp [φ_tilde, φ_loc, q_loc, u_k]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (u₁ γ).isoOpensRange.hom,
        (u₁ γ).isoOpensRange.hom_inv_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hθ₁_lam γ.1 γ.2.1 γ.2.2,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, ← (hTowerB γ.2.1).1,
        ← CategoryTheory.Category.assoc, hθ_bar_geom γ.1 γ.2.1 γ.2.2,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc]
    have h_iso_inv_hom_ι : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
        [AlgebraicGeometry.IsOpenImmersion f],
        f.isoOpensRange.inv ≫ f = f.opensRange.ι := by
      intro X Y f _
      calc f.isoOpensRange.inv ≫ f
          = f.isoOpensRange.inv ≫ (f.isoOpensRange.hom ≫ f.opensRange.ι) :=
              congrArg (f.isoOpensRange.inv ≫ ·)
                (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι f).symm
        _ = (f.isoOpensRange.inv ≫ f.isoOpensRange.hom) ≫ f.opensRange.ι :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = f.opensRange.ι := by
              rw [f.isoOpensRange.inv_hom_id, CategoryTheory.Category.id_comp]
    have hφ_tilde_over : ∀ γ : Γ, φ_tilde γ ≫ Y_tgt.hom = (U₁_cov γ).ι ≫ Y_src.hom := by
      intro γ
      have hloc_over : φ_loc γ ≫ Y_tgt.hom = u₁ γ ≫ Y_src.hom := by
        dsimp [φ_loc, u₁, ℓ₁]
        rw [CategoryTheory.Category.assoc, hβ₁_hom γ.2.1,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          hθ₁_alg γ.1 γ.2.1 γ.2.2, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, hα₁_hom γ.1]
      dsimp only [φ_tilde, U₁_cov]
      rw [CategoryTheory.Category.assoc, hloc_over, ← CategoryTheory.Category.assoc,
        h_iso_inv_hom_ι (u₁ γ)]
    
    let s_Lk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L k))
    haveI : AlgebraicGeometry.Flat s_Lk :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
        (RingHom.flat_algebraMap_iff.mpr inferInstance)
    haveI : AlgebraicGeometry.Surjective s_Lk := by
      obtain ⟨pt_k⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := inferInstance
      exact ⟨fun y => ⟨pt_k, Subsingleton.elim _ _⟩⟩
    let 𝒰₁ := Y_src.left.openCoverOfIsOpenCover U₁_cov hU₁_sup
    have hOverlap : ∀ γ₁ γ₂ : Γ,
        CategoryTheory.Limits.pullback.fst (U₁_cov γ₁).ι (U₁_cov γ₂).ι ≫ φ_tilde γ₁ =
          CategoryTheory.Limits.pullback.snd (U₁_cov γ₁).ι (U₁_cov γ₂).ι ≫ φ_tilde γ₂ := by
      intro γ₁ γ₂
      let π₁ := CategoryTheory.Limits.pullback.fst (U₁_cov γ₁).ι (U₁_cov γ₂).ι
      let π₂ := CategoryTheory.Limits.pullback.snd (U₁_cov γ₁).ι (U₁_cov γ₂).ι
      let g_Q := π₁ ≫ (U₁_cov γ₁).ι
      let W_Q := CategoryTheory.Limits.pullback g_Q p_src
      let q_Q : W_Q ⟶ CategoryTheory.Limits.pullback (U₁_cov γ₁).ι (U₁_cov γ₂).ι :=
        CategoryTheory.Limits.pullback.fst g_Q p_src
      let p_Q : W_Q ⟶ (W i).left := CategoryTheory.Limits.pullback.snd g_Q p_src
      have hp_WQ : CategoryTheory.IsPullback q_Q p_Q g_Q p_src :=
        CategoryTheory.IsPullback.of_hasPullback g_Q p_src
      have hp_sLk : CategoryTheory.IsPullback (p_Q ≫ (W i).hom) q_Q s_Lk (g_Q ≫ Y_src.hom) :=
        (hp_WQ.paste_vert hp_src_mod).flip
      haveI : AlgebraicGeometry.Flat q_Q :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_sLk inferInstance
      haveI : AlgebraicGeometry.Surjective q_Q :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_sLk inferInstance
      haveI : CategoryTheory.Epi q_Q := AlgebraicGeometry.Flat.epi_of_flat_of_surjective q_Q
      apply (cancel_epi q_Q).mp
      have hcomm₁ : (q_Q ≫ π₁) ≫ (U₁_cov γ₁).ι = p_Q ≫ p_src := by
        rw [CategoryTheory.Category.assoc]
        exact hp_WQ.w
      have hcomm₂ : (q_Q ≫ π₂) ≫ (U₁_cov γ₂).ι = p_Q ≫ p_src := by
        have h_f_eq : π₁ ≫ (U₁_cov γ₁).ι = π₂ ≫ (U₁_cov γ₂).ι :=
          CategoryTheory.Limits.pullback.condition
        rw [CategoryTheory.Category.assoc, ← h_f_eq]
        exact hp_WQ.w
      have h_eq₁ : q_Q ≫ π₁ ≫ φ_tilde γ₁ = p_Q ≫ (φ_bar e).left ≫ p_tgt := by
        rw [← CategoryTheory.Category.assoc, ← (hp_loc γ₁).lift_fst (q_Q ≫ π₁) p_Q hcomm₁,
          CategoryTheory.Category.assoc, hφ_tilde_k γ₁, ← CategoryTheory.Category.assoc,
          (hp_loc γ₁).lift_snd (q_Q ≫ π₁) p_Q hcomm₁]
      have h_eq₂ : q_Q ≫ π₂ ≫ φ_tilde γ₂ = p_Q ≫ (φ_bar e).left ≫ p_tgt := by
        rw [← CategoryTheory.Category.assoc, ← (hp_loc γ₂).lift_fst (q_Q ≫ π₂) p_Q hcomm₂,
          CategoryTheory.Category.assoc, hφ_tilde_k γ₂, ← CategoryTheory.Category.assoc,
          (hp_loc γ₂).lift_snd (q_Q ≫ π₂) p_Q hcomm₂]
      exact h_eq₁.trans h_eq₂.symm
    let φ_glued : Y_src.left ⟶ Y_tgt.left := 𝒰₁.glueMorphisms φ_tilde hOverlap
    have hφ_over : φ_glued ≫ Y_tgt.hom = Y_src.hom := by
      apply 𝒰₁.hom_ext
      intro (γ : Γ)
      change (U₁_cov γ).ι ≫ φ_glued ≫ Y_tgt.hom = (U₁_cov γ).ι ≫ Y_src.hom
      have h_glue_γ : (U₁_cov γ).ι ≫ φ_glued = φ_tilde γ :=
        𝒰₁.ι_glueMorphisms φ_tilde hOverlap γ
      rw [← CategoryTheory.Category.assoc, h_glue_γ]
      exact hφ_tilde_over γ
    let φ_L : Y_src ⟶ Y_tgt := CategoryTheory.Over.homMk φ_glued hφ_over
    refine ⟨L, hLE, inferInstance, p_src, p_tgt, φ_L,
      hp_src_mod, hp_src_fst, hp_tgt_mod, hp_tgt_fst, ?_⟩
    let 𝒰_k := (W i).left.openCoverOfIsOpenCover Uk_cov hUk_sup
    apply 𝒰_k.hom_ext
    intro (γ : Γ)
    change (u_k γ).opensRange.ι ≫ (p_src ≫ φ_glued) =
      (u_k γ).opensRange.ι ≫ ((φ_bar e).left ≫ p_tgt)
    have hu_eq : u_k γ ≫ (p_src ≫ φ_glued) = u_k γ ≫ ((φ_bar e).left ≫ p_tgt) := by
      rw [← CategoryTheory.Category.assoc, ← hq_u_comm γ,
        ← AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι (u₁ γ),
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      have h_glue_γ : (U₁_cov γ).ι ≫ φ_glued = φ_tilde γ :=
        𝒰₁.ι_glueMorphisms φ_tilde hOverlap γ
      change q_loc γ ≫ (u₁ γ).isoOpensRange.hom ≫ (U₁_cov γ).ι ≫ φ_glued = _
      rw [h_glue_γ, ← CategoryTheory.Category.assoc, hφ_tilde_k γ]
    calc (u_k γ).opensRange.ι ≫ (p_src ≫ φ_glued)
        = ((u_k γ).isoOpensRange.inv ≫ u_k γ) ≫ (p_src ≫ φ_glued) := by
            rw [h_iso_inv_hom_ι (u_k γ)]
      _ = (u_k γ).isoOpensRange.inv ≫ (u_k γ ≫ (p_src ≫ φ_glued)) :=
            CategoryTheory.Category.assoc _ _ _
      _ = (u_k γ).isoOpensRange.inv ≫ (u_k γ ≫ ((φ_bar e).left ≫ p_tgt)) := by
            rw [hu_eq]
      _ = ((u_k γ).isoOpensRange.inv ≫ u_k γ) ≫ ((φ_bar e).left ≫ p_tgt) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = (u_k γ).opensRange.ι ≫ ((φ_bar e).left ≫ p_tgt) := by
            rw [h_iso_inv_hom_ι (u_k γ)]

  
  choose L_mor hLE_mor hFD_mor hMor_pkg using hSpreadSingleMor
  choose L_open hLE_open hFD_open hOpen_pkg using
    fun u : OpenIdx => hSpreadSingleOpen (carrier_idx u) (U_bar u)
  haveI : ∀ e : Mor, FiniteDimensional F ↥(L_mor e) := hFD_mor
  haveI : ∀ u : OpenIdx, FiniteDimensional F ↥(L_open u) := hFD_open
  let L₁ : IntermediateField F k := L₀ ⊔ (⨆ e : Mor, L_mor e) ⊔ (⨆ u : OpenIdx, L_open u)
  have hLE : L₀ ≤ L₁ := le_sup_of_le_left le_sup_left
  haveI : FiniteDimensional F ↥(⨆ e : Mor, L_mor e) :=
    IntermediateField.finiteDimensional_iSup_of_finite
  haveI : FiniteDimensional F ↥(⨆ u : OpenIdx, L_open u) :=
    IntermediateField.finiteDimensional_iSup_of_finite
  haveI : FiniteDimensional F ↥L₁ :=
    IntermediateField.finiteDimensional_sup (L₀ ⊔ (⨆ e : Mor, L_mor e))
      (⨆ u : OpenIdx, L_open u)
  refine ⟨L₁, hLE, inferInstance, ?_⟩
  letI : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
  choose p₁ hp₁_mod hp₁_fst using fun i : Obj =>
    hTowerLift L₁ hLE (Y₀ i) (W i) (p₀ i) (hp₀ i)
  refine ⟨p₁, fun i => ⟨hp₁_mod i, hp₁_fst i⟩, ?_, ?_⟩
  · intro e
    obtain ⟨p_src, p_tgt, φ_e, hp_src_mod, hp_src_fst, _, hp_tgt_fst, hφ_e_comm⟩ := hMor_pkg e
    have hLE_e : L_mor e ≤ L₁ := (le_iSup L_mor e).trans (le_sup_of_le_left le_sup_right)
    exact hTowerTransportMor (L_mor e) L₁ (hLE_mor e) hLE hLE_e
      (Y₀ (src e)) (Y₀ (tgt e)) (W (src e)) (W (tgt e))
      (p₀ (src e)) (p₀ (tgt e)) (φ_bar e)
      p_src p_tgt (p₁ (src e)) (p₁ (tgt e)) φ_e
      hp_src_mod hp_src_fst hp_tgt_fst
      (hp₁_mod (src e)) (hp₁_fst (src e))
      (hp₁_mod (tgt e)) (hp₁_fst (tgt e))
      hφ_e_comm
  · intro u
    obtain ⟨p_u, U_u, hp_u_mod, hp_u_fst, hU_u_pre⟩ := hOpen_pkg u
    have hLE_u : L_open u ≤ L₁ := (le_iSup L_open u).trans le_sup_right
    exact hTowerTransportOpen (L_open u) L₁ (hLE_open u) hLE hLE_u
      (Y₀ (carrier_idx u)) (W (carrier_idx u)) (p₀ (carrier_idx u)) (U_bar u)
      p_u (p₁ (carrier_idx u)) U_u
      hp_u_mod hp_u_fst
      (hp₁_mod (carrier_idx u)) (hp₁_fst (carrier_idx u))
      hU_u_pre

theorem weil_fpqc_field_descent_morphism_and_fiber_props (E k : Type u) [Field E] [Field k]
    [IsAlgClosed k] [Algebra E k] [Algebra.IsAlgebraic E k] :
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p_W : W.left ⟶ Y.left),
      IsFieldPullbackModel E k Y W p_W →
      CategoryTheory.Epi p_W ∧ Function.Surjective p_W.base) ∧
    (∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p₁ : W₁.left ⟶ Y₁.left) (p₂ : W₂.left ⟶ Y₂.left)
        (φ_E : Y₁ ⟶ Y₂) (φ_k : W₁ ⟶ W₂),
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      p₁ ≫ φ_E.left = φ_k.left ≫ p₂ →
      (p₂.base ⁻¹' (Set.range φ_E.left.base) = Set.range φ_k.left.base) ∧
      (∀ (y : Y₁.left) (w₂ : W₂.left),
        φ_E.left.base y = p₂.base w₂ →
        ∃ w₁ : W₁.left, p₁.base w₁ = y ∧ φ_k.left.base w₁ = w₂) ∧
      (AlgebraicGeometry.Surjective φ_k.left → AlgebraicGeometry.Surjective φ_E.left) ∧
      (AlgebraicGeometry.IsOpenImmersion φ_k.left → AlgebraicGeometry.IsOpenImmersion φ_E.left) ∧
      (AlgebraicGeometry.Etale φ_k.left → AlgebraicGeometry.Etale φ_E.left) ∧
      (∀ d : ℕ, AlgebraicGeometry.SmoothOfRelativeDimension d φ_k.left →
        AlgebraicGeometry.SmoothOfRelativeDimension d φ_E.left) ∧
      (AlgebraicGeometry.Flat φ_k.left → AlgebraicGeometry.Flat φ_E.left) ∧
      (CompactSpace ↥Y₁.left → AlgebraicGeometry.IsSeparated Y₁.hom →
        AlgebraicGeometry.IsSeparated Y₂.hom →
        AlgebraicGeometry.IsClosedImmersion φ_k.left →
        AlgebraicGeometry.IsClosedImmersion φ_E.left) ∧
      (∀ (U_E : Y₂.left.Opens) (U_k : W₂.left.Opens),
        (TopologicalSpace.Opens.map p₂.base).obj U_E = U_k →
        (CategoryTheory.IsIso (φ_k.left ∣_ U_k) → CategoryTheory.IsIso (φ_E.left ∣_ U_E)) ∧
        (∀ d : ℕ, AlgebraicGeometry.SmoothOfRelativeDimension d (φ_k.left ∣_ U_k) →
          AlgebraicGeometry.SmoothOfRelativeDimension d (φ_E.left ∣_ U_E))) ∧
      (∀ (V_E : Y₁.left.Opens) (V_k : W₁.left.Opens),
        (TopologicalSpace.Opens.map p₁.base).obj V_E = V_k →
        ∀ d : ℕ, AlgebraicGeometry.SmoothOfRelativeDimension d (V_k.ι ≫ φ_k.left) →
          AlgebraicGeometry.SmoothOfRelativeDimension d (V_E.ι ≫ φ_E.left)) ∧
      ((∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s_k : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₂.left),
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback φ_k.left s_k)) →
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s_E : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y₂.left),
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback φ_E.left s_E)))) ∧
    (∀ (Y_P Y₁ Y₂ Y_S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W_P W₁ W₂ W_S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p_P : W_P.left ⟶ Y_P.left) (p₁ : W₁.left ⟶ Y₁.left)
        (p₂ : W₂.left ⟶ Y₂.left) (p_S : W_S.left ⟶ Y_S.left)
        (a_E : Y_P ⟶ Y₁) (b_E : Y_P ⟶ Y₂) (c_E : Y₁ ⟶ Y_S) (d_E : Y₂ ⟶ Y_S)
        (a_k : W_P ⟶ W₁) (b_k : W_P ⟶ W₂) (c_k : W₁ ⟶ W_S) (d_k : W₂ ⟶ W_S),
      IsFieldPullbackModel E k Y_P W_P p_P →
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      IsFieldPullbackModel E k Y_S W_S p_S →
      p_P ≫ a_E.left = a_k.left ≫ p₁ →
      p_P ≫ b_E.left = b_k.left ≫ p₂ →
      p₁ ≫ c_E.left = c_k.left ≫ p_S →
      p₂ ≫ d_E.left = d_k.left ≫ p_S →
      CategoryTheory.IsPullback a_k.left b_k.left c_k.left d_k.left →
      CategoryTheory.IsPullback a_E.left b_E.left c_E.left d_E.left) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p_W : W.left ⟶ Y.left)
        (U_E : Y.left.Opens) (U_k : W.left.Opens),
      IsFieldPullbackModel E k Y W p_W →
      CompactSpace ↥Y.left →
      AlgebraicGeometry.IsSeparated Y.hom →
      AlgebraicGeometry.LocallyOfFiniteType Y.hom →
      (TopologicalSpace.Opens.map p_W.base).obj U_E = U_k →
      AlgebraicGeometry.IsAffineOpen U_k →
      AlgebraicGeometry.IsAffineOpen U_E) :=
by
  let s_Ek : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of E) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E k))

  
  
  
  have hModelFPQC : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p_W : W.left ⟶ Y.left),
      IsFieldPullbackModel E k Y W p_W →
      AlgebraicGeometry.Surjective p_W ∧
      AlgebraicGeometry.Flat p_W ∧
      AlgebraicGeometry.QuasiCompact p_W ∧
      AlgebraicGeometry.IsAffineHom p_W ∧
      CategoryTheory.Epi p_W ∧
      Function.Surjective p_W.base := by
    intro Y W p_W hp_W
    have hp_surj : AlgebraicGeometry.Surjective p_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Surjective) hp_W.flip inferInstance
    have hp_flat : AlgebraicGeometry.Flat p_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Flat) hp_W.flip inferInstance
    have hp_qc : AlgebraicGeometry.QuasiCompact p_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.QuasiCompact) hp_W.flip inferInstance
    have hAffE : AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of E)) :=
      AlgebraicGeometry.isAffine_Spec (CommRingCat.of E)
    have hAffk : AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      AlgebraicGeometry.isAffine_Spec (CommRingCat.of k)
    have hs_aff : AlgebraicGeometry.IsAffineHom s_Ek :=
      @AlgebraicGeometry.isAffineHom_of_isAffine _ _ s_Ek hAffk hAffE
    have hp_aff : AlgebraicGeometry.IsAffineHom p_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsAffineHom) hp_W.flip hs_aff
    have hp_epi : CategoryTheory.Epi p_W :=
      @AlgebraicGeometry.Flat.epi_of_flat_of_surjective _ _ p_W hp_flat hp_surj
    exact ⟨hp_surj, hp_flat, hp_qc, hp_aff, hp_epi, hp_surj.surj⟩

  have hPart1 : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p_W : W.left ⟶ Y.left),
      IsFieldPullbackModel E k Y W p_W →
      CategoryTheory.Epi p_W ∧ Function.Surjective p_W.base := by
    intro Y W p_W hp_W
    obtain ⟨_, _, _, _, hepi, hsurj⟩ := hModelFPQC Y W p_W hp_W
    exact ⟨hepi, hsurj⟩

  have hCartSq : ∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
      (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p₁ : W₁.left ⟶ Y₁.left) (p₂ : W₂.left ⟶ Y₂.left)
      (φ_E : Y₁ ⟶ Y₂) (φ_k : W₁ ⟶ W₂),
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      p₁ ≫ φ_E.left = φ_k.left ≫ p₂ →
      CategoryTheory.IsPullback φ_k.left p₁ p₂ φ_E.left ∧
      CategoryTheory.IsPullback p₁ φ_k.left φ_E.left p₂ := by
    intro Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm
    have hOuter : CategoryTheory.IsPullback
        (φ_k.left ≫ W₂.hom) p₁ s_Ek (φ_E.left ≫ Y₂.hom) := by
      rw [CategoryTheory.Over.w φ_k, CategoryTheory.Over.w φ_E]
      exact hp₁.flip
    have hFlip : CategoryTheory.IsPullback φ_k.left p₁ p₂ φ_E.left :=
      CategoryTheory.IsPullback.of_right hOuter hcomm.symm hp₂.flip
    exact ⟨hFlip, hFlip.flip⟩

  have hOpenModel : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p_W : W.left ⟶ Y.left)
      (U_E : Y.left.Opens) (U_k : W.left.Opens),
      IsFieldPullbackModel E k Y W p_W →
      (TopologicalSpace.Opens.map p_W.base).obj U_E = U_k →
      ∃ (p_U : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ (U_E : AlgebraicGeometry.Scheme.{u})),
        p_U ≫ U_E.ι = U_k.ι ≫ p_W ∧
        CategoryTheory.IsPullback p_U U_k.ι U_E.ι p_W ∧
        IsFieldPullbackModel E k
          (CategoryTheory.Over.mk (U_E.ι ≫ Y.hom))
          (CategoryTheory.Over.mk (U_k.ι ≫ W.hom)) p_U := by
    intro Y W p_W U_E U_k hp_W hU
    have hpU_range : Set.range (U_k.ι ≫ p_W).base ⊆ Set.range U_E.ι.base := by
      rintro _ ⟨⟨x_k, hx_k⟩, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      change x_k ∈ (TopologicalSpace.Opens.map p_W.base).obj U_E
      rwa [hU]
    let p_U : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ (U_E : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift U_E.ι (U_k.ι ≫ p_W) hpU_range
    have hpU_fac : p_U ≫ U_E.ι = U_k.ι ≫ p_W :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_E.ι (U_k.ι ≫ p_W) hpU_range
    have hpU : CategoryTheory.IsPullback p_U U_k.ι U_E.ι p_W := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback p_U U_k.ι U_E.ι p_W hpU_fac.symm
      rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι, AlgebraicGeometry.Scheme.Opens.opensRange_ι]
      exact hU
    exact ⟨p_U, hpU_fac, hpU, hpU.paste_vert hp_W⟩

  
  
  
  have hIsoDescent : ∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
      (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p₁ : W₁.left ⟶ Y₁.left) (p₂ : W₂.left ⟶ Y₂.left)
      (φ_E : Y₁ ⟶ Y₂) (φ_k : W₁ ⟶ W₂),
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      p₁ ≫ φ_E.left = φ_k.left ≫ p₂ →
      CategoryTheory.IsIso φ_k.left →
      CategoryTheory.IsIso φ_E.left := by
    intro Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm hIso_k
    obtain ⟨hp₂_surj, hp₂_flat, hp₂_qc, _, _, _⟩ := hModelFPQC Y₂ W₂ p₂ hp₂
    obtain ⟨hSq_flip, _⟩ := hCartSq Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm
    exact CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
      (Q := @AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓
        @AlgebraicGeometry.QuasiCompact)
      hSq_flip ⟨⟨hp₂_surj, hp₂_flat⟩, hp₂_qc⟩ hIso_k

  have hOpenTgtRestrictModels :
      ∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
      (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p₁ : W₁.left ⟶ Y₁.left) (p₂ : W₂.left ⟶ Y₂.left)
      (φ_E : Y₁ ⟶ Y₂) (φ_k : W₁ ⟶ W₂)
      (U_E : Y₂.left.Opens) (U_k : W₂.left.Opens),
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      p₁ ≫ φ_E.left = φ_k.left ≫ p₂ →
      (TopologicalSpace.Opens.map p₂.base).obj U_E = U_k →
      let V_E : Y₁.left.Opens := φ_E.left ⁻¹ᵁ U_E
      let V_k : W₁.left.Opens := φ_k.left ⁻¹ᵁ U_k
      ∃ (p_V : (V_k : AlgebraicGeometry.Scheme.{u}) ⟶ (V_E : AlgebraicGeometry.Scheme.{u}))
        (p_U : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ (U_E : AlgebraicGeometry.Scheme.{u}))
        (ψ_E : CategoryTheory.Over.mk (V_E.ι ≫ Y₁.hom) ⟶ CategoryTheory.Over.mk (U_E.ι ≫ Y₂.hom))
        (ψ_k : CategoryTheory.Over.mk (V_k.ι ≫ W₁.hom) ⟶ CategoryTheory.Over.mk (U_k.ι ≫ W₂.hom)),
        ψ_E.left = (φ_E.left ∣_ U_E) ∧
        ψ_k.left = (φ_k.left ∣_ U_k) ∧
        IsFieldPullbackModel E k
          (CategoryTheory.Over.mk (V_E.ι ≫ Y₁.hom))
          (CategoryTheory.Over.mk (V_k.ι ≫ W₁.hom)) p_V ∧
        IsFieldPullbackModel E k
          (CategoryTheory.Over.mk (U_E.ι ≫ Y₂.hom))
          (CategoryTheory.Over.mk (U_k.ι ≫ W₂.hom)) p_U ∧
        p_V ≫ ψ_E.left = ψ_k.left ≫ p_U := by
    intro Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k U_E U_k hp₁ hp₂ hcomm hU V_E V_k
    have hV : (TopologicalSpace.Opens.map p₁.base).obj V_E = V_k := by
      ext w₁
      change (p₁ ≫ φ_E.left).base w₁ ∈ U_E ↔ φ_k.left.base w₁ ∈ U_k
      rw [hcomm, ← hU]
      rfl
    obtain ⟨p_U, hpU_fac, _, hpU_mod⟩ := hOpenModel Y₂ W₂ p₂ U_E U_k hp₂ hU
    obtain ⟨p_V, hpV_fac, _, hpV_mod⟩ := hOpenModel Y₁ W₁ p₁ V_E V_k hp₁ hV
    let ψ_E : CategoryTheory.Over.mk (V_E.ι ≫ Y₁.hom) ⟶
        CategoryTheory.Over.mk (U_E.ι ≫ Y₂.hom) :=
      CategoryTheory.Over.homMk (φ_E.left ∣_ U_E) (by
        dsimp
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Over.w φ_E])
    let ψ_k : CategoryTheory.Over.mk (V_k.ι ≫ W₁.hom) ⟶
        CategoryTheory.Over.mk (U_k.ι ≫ W₂.hom) :=
      CategoryTheory.Over.homMk (φ_k.left ∣_ U_k) (by
        dsimp
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Over.w φ_k])
    have hcomm_res : p_V ≫ ψ_E.left = ψ_k.left ≫ p_U := by
      apply (CategoryTheory.cancel_mono U_E.ι).mp
      calc (p_V ≫ ψ_E.left) ≫ U_E.ι
          = p_V ≫ ((φ_E.left ∣_ U_E) ≫ U_E.ι) := CategoryTheory.Category.assoc _ _ _
        _ = (p_V ≫ V_E.ι) ≫ φ_E.left := by
            rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        _ = V_k.ι ≫ p₁ ≫ φ_E.left := by rw [hpV_fac, CategoryTheory.Category.assoc]
        _ = (V_k.ι ≫ φ_k.left) ≫ p₂ := by rw [hcomm, CategoryTheory.Category.assoc]
        _ = ((φ_k.left ∣_ U_k) ≫ U_k.ι) ≫ p₂ := by rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (φ_k.left ∣_ U_k) ≫ (U_k.ι ≫ p₂) := CategoryTheory.Category.assoc _ _ _
        _ = (ψ_k.left ≫ p_U) ≫ U_E.ι := by rw [← hpU_fac, ← CategoryTheory.Category.assoc]; rfl
    exact ⟨p_V, p_U, ψ_E, ψ_k, rfl, rfl, hpV_mod, hpU_mod, hcomm_res⟩

  have hPart3 :
      ∀ (Y_P Y₁ Y₂ Y_S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W_P W₁ W₂ W_S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p_P : W_P.left ⟶ Y_P.left) (p₁ : W₁.left ⟶ Y₁.left)
        (p₂ : W₂.left ⟶ Y₂.left) (p_S : W_S.left ⟶ Y_S.left)
        (a_E : Y_P ⟶ Y₁) (b_E : Y_P ⟶ Y₂) (c_E : Y₁ ⟶ Y_S) (d_E : Y₂ ⟶ Y_S)
        (a_k : W_P ⟶ W₁) (b_k : W_P ⟶ W₂) (c_k : W₁ ⟶ W_S) (d_k : W₂ ⟶ W_S),
      IsFieldPullbackModel E k Y_P W_P p_P →
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      IsFieldPullbackModel E k Y_S W_S p_S →
      p_P ≫ a_E.left = a_k.left ≫ p₁ →
      p_P ≫ b_E.left = b_k.left ≫ p₂ →
      p₁ ≫ c_E.left = c_k.left ≫ p_S →
      p₂ ≫ d_E.left = d_k.left ≫ p_S →
      CategoryTheory.IsPullback a_k.left b_k.left c_k.left d_k.left →
      CategoryTheory.IsPullback a_E.left b_E.left c_E.left d_E.left := by
    intro Y_P Y₁ Y₂ Y_S W_P W₁ W₂ W_S p_P p₁ p₂ p_S a_E b_E c_E d_E a_k b_k c_k d_k
      hp_P hp₁ hp₂ hp_S ha hb hc hd hPb_k
    have : CategoryTheory.Epi p_P := (hPart1 Y_P W_P p_P hp_P).1
    dsimp only [IsFieldPullbackModel] at hp₁ hp₂ hp_S
    have hComm_E : a_E.left ≫ c_E.left = b_E.left ≫ d_E.left := by
      apply (CategoryTheory.cancel_epi p_P).mp
      calc p_P ≫ a_E.left ≫ c_E.left
          = (p_P ≫ a_E.left) ≫ c_E.left := (CategoryTheory.Category.assoc _ _ _).symm
        _ = a_k.left ≫ p₁ ≫ c_E.left := by rw [ha, CategoryTheory.Category.assoc]
        _ = (a_k.left ≫ c_k.left) ≫ p_S := by rw [hc, CategoryTheory.Category.assoc]
        _ = (b_k.left ≫ d_k.left) ≫ p_S := by rw [hPb_k.w]
        _ = b_k.left ≫ p₂ ≫ d_E.left := by rw [CategoryTheory.Category.assoc, ← hd]
        _ = (p_P ≫ b_E.left) ≫ d_E.left := by rw [← CategoryTheory.Category.assoc, ← hb]
        _ = p_P ≫ b_E.left ≫ d_E.left := CategoryTheory.Category.assoc _ _ _
    let P_E := CategoryTheory.Limits.pullback c_E.left d_E.left
    let P_k := CategoryTheory.Limits.pullback c_k.left d_k.left
    let fst_E := CategoryTheory.Limits.pullback.fst c_E.left d_E.left
    let snd_E := CategoryTheory.Limits.pullback.snd c_E.left d_E.left
    let fst_k := CategoryTheory.Limits.pullback.fst c_k.left d_k.left
    let snd_k := CategoryTheory.Limits.pullback.snd c_k.left d_k.left
    let g_PE : P_E ⟶ AlgebraicGeometry.Spec (CommRingCat.of E) := fst_E ≫ Y₁.hom
    let g_Pk : P_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := fst_k ≫ W₁.hom
    have hp_pb_cond : (fst_k ≫ p₁) ≫ c_E.left = (snd_k ≫ p₂) ≫ d_E.left := by
      rw [CategoryTheory.Category.assoc, hc, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, ← hd,
        ← CategoryTheory.Category.assoc]
    let p_pb : P_k ⟶ P_E :=
      CategoryTheory.Limits.pullback.lift (fst_k ≫ p₁) (snd_k ≫ p₂) hp_pb_cond
    have hp_pb_fst : p_pb ≫ fst_E = fst_k ≫ p₁ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hp_pb_snd : p_pb ≫ snd_E = snd_k ≫ p₂ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hw_pb : p_pb ≫ g_PE = g_Pk ≫ s_Ek := by
      dsimp [g_PE, g_Pk]
      rw [← CategoryTheory.Category.assoc, hp_pb_fst,
        CategoryTheory.Category.assoc, hp₁.w, CategoryTheory.Category.assoc]
    have h_pb_inj : ∀ {T : AlgebraicGeometry.Scheme.{u}} (m₁ m₂ : T ⟶ P_k),
        m₁ ≫ p_pb = m₂ ≫ p_pb → m₁ ≫ g_Pk = m₂ ≫ g_Pk → m₁ = m₂ := by
      intro T m₁ m₂ hm_p hm_g
      apply CategoryTheory.Limits.pullback.hom_ext
      · apply hp₁.hom_ext
        · calc (m₁ ≫ fst_k) ≫ p₁
              = m₁ ≫ p_pb ≫ fst_E := by rw [CategoryTheory.Category.assoc, hp_pb_fst]
            _ = (m₁ ≫ p_pb) ≫ fst_E := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (m₂ ≫ p_pb) ≫ fst_E := by rw [hm_p]
            _ = m₂ ≫ p_pb ≫ fst_E := CategoryTheory.Category.assoc _ _ _
            _ = (m₂ ≫ fst_k) ≫ p₁ := by rw [hp_pb_fst, CategoryTheory.Category.assoc]
        · exact hm_g
      · apply hp₂.hom_ext
        · calc (m₁ ≫ snd_k) ≫ p₂
              = m₁ ≫ p_pb ≫ snd_E := by rw [CategoryTheory.Category.assoc, hp_pb_snd]
            _ = (m₁ ≫ p_pb) ≫ snd_E := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (m₂ ≫ p_pb) ≫ snd_E := by rw [hm_p]
            _ = m₂ ≫ p_pb ≫ snd_E := CategoryTheory.Category.assoc _ _ _
            _ = (m₂ ≫ snd_k) ≫ p₂ := by rw [hp_pb_snd, CategoryTheory.Category.assoc]
        · have h_snd_hom : ∀ m : T ⟶ P_k, (m ≫ snd_k) ≫ W₂.hom = m ≫ g_Pk := fun m => by
            calc (m ≫ snd_k) ≫ W₂.hom
                = m ≫ (snd_k ≫ d_k.left) ≫ W_S.hom := by
                  rw [← CategoryTheory.Over.w d_k]
                  simp only [CategoryTheory.Category.assoc]
              _ = m ≫ (fst_k ≫ c_k.left) ≫ W_S.hom := by
                  rw [CategoryTheory.Limits.pullback.condition]
              _ = m ≫ g_Pk := by
                  dsimp [g_Pk]
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w c_k]
          rw [h_snd_hom m₁, h_snd_hom m₂, hm_g]
    have h_pb_lift : ∀ s : CategoryTheory.Limits.PullbackCone g_PE s_Ek,
        ∃ l : s.pt ⟶ P_k, l ≫ p_pb = s.fst ∧ l ≫ g_Pk = s.snd := by
      intro s
      have hs₁ : (s.fst ≫ fst_E) ≫ Y₁.hom = s.snd ≫ s_Ek := by
        rw [CategoryTheory.Category.assoc]
        exact s.condition
      have hs₂ : (s.fst ≫ snd_E) ≫ Y₂.hom = s.snd ≫ s_Ek := by
        calc (s.fst ≫ snd_E) ≫ Y₂.hom
            = s.fst ≫ (snd_E ≫ d_E.left) ≫ Y_S.hom := by
              rw [← CategoryTheory.Over.w d_E]
              simp only [CategoryTheory.Category.assoc]
          _ = s.fst ≫ (fst_E ≫ c_E.left) ≫ Y_S.hom := by
              rw [CategoryTheory.Limits.pullback.condition]
          _ = (s.fst ≫ fst_E) ≫ Y₁.hom := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w c_E,
                CategoryTheory.Category.assoc]
          _ = s.snd ≫ s_Ek := hs₁
      let l₁ := hp₁.lift (s.fst ≫ fst_E) s.snd hs₁
      let l₂ := hp₂.lift (s.fst ≫ snd_E) s.snd hs₂
      have hl_eq : l₁ ≫ c_k.left = l₂ ≫ d_k.left := by
        apply hp_S.hom_ext
        · calc (l₁ ≫ c_k.left) ≫ p_S
              = l₁ ≫ p₁ ≫ c_E.left := by rw [CategoryTheory.Category.assoc, ← hc]
            _ = s.fst ≫ fst_E ≫ c_E.left := by
                rw [← CategoryTheory.Category.assoc, hp₁.lift_fst, CategoryTheory.Category.assoc]
            _ = s.fst ≫ snd_E ≫ d_E.left := by rw [CategoryTheory.Limits.pullback.condition]
            _ = l₂ ≫ p₂ ≫ d_E.left := by
                rw [← CategoryTheory.Category.assoc, ← hp₂.lift_fst _ _ hs₂,
                  CategoryTheory.Category.assoc]
            _ = (l₂ ≫ d_k.left) ≫ p_S := by rw [hd, ← CategoryTheory.Category.assoc]
        · calc (l₁ ≫ c_k.left) ≫ W_S.hom
              = l₁ ≫ W₁.hom := by rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w c_k]
            _ = s.snd := hp₁.lift_snd _ _ _
            _ = l₂ ≫ W₂.hom := (hp₂.lift_snd _ _ hs₂).symm
            _ = (l₂ ≫ d_k.left) ≫ W_S.hom := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w d_k]
      refine ⟨CategoryTheory.Limits.pullback.lift l₁ l₂ hl_eq, ?_, ?_⟩
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hp_pb_fst,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            hp₁.lift_fst]
        · rw [CategoryTheory.Category.assoc, hp_pb_snd,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            hp₂.lift_fst]
      · dsimp [g_Pk]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hp₁.lift_snd]
    have hp_pb : IsFieldPullbackModel E k
        (CategoryTheory.Over.mk g_PE) (CategoryTheory.Over.mk g_Pk) p_pb := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw_pb
          (fun s => Classical.choose (h_pb_lift s))
          (fun s => (Classical.choose_spec (h_pb_lift s)).1)
          (fun s => (Classical.choose_spec (h_pb_lift s)).2)
          (fun s m hm₁ hm₂ => h_pb_inj m _
            (hm₁.trans (Classical.choose_spec (h_pb_lift s)).1.symm)
            (hm₂.trans (Classical.choose_spec (h_pb_lift s)).2.symm)))
    let Φ_E : CategoryTheory.Over.mk Y_P.hom ⟶ CategoryTheory.Over.mk g_PE :=
      CategoryTheory.Over.homMk
        (CategoryTheory.Limits.pullback.lift a_E.left b_E.left hComm_E)
        (by
          dsimp [g_PE, fst_E]
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Over.w a_E])
    let Φ_k : CategoryTheory.Over.mk W_P.hom ⟶ CategoryTheory.Over.mk g_Pk :=
      CategoryTheory.Over.homMk hPb_k.isoPullback.hom
        (by
          dsimp [g_Pk, fst_k]
          rw [← CategoryTheory.Category.assoc, hPb_k.isoPullback_hom_fst,
            CategoryTheory.Over.w a_k])
    have hp_P' : IsFieldPullbackModel E k
        (CategoryTheory.Over.mk Y_P.hom) (CategoryTheory.Over.mk W_P.hom) p_P := hp_P
    have hComm_Φ : p_P ≫ Φ_E.left = Φ_k.left ≫ p_pb := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (p_P ≫ CategoryTheory.Limits.pullback.lift a_E.left b_E.left hComm_E) ≫ fst_E =
          (hPb_k.isoPullback.hom ≫ p_pb) ≫ fst_E
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, hp_pb_fst,
          ← CategoryTheory.Category.assoc, hPb_k.isoPullback_hom_fst, ha]
      · change (p_P ≫ CategoryTheory.Limits.pullback.lift a_E.left b_E.left hComm_E) ≫ snd_E =
          (hPb_k.isoPullback.hom ≫ p_pb) ≫ snd_E
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, hp_pb_snd,
          ← CategoryTheory.Category.assoc, hPb_k.isoPullback_hom_snd, hb]
    have hIso_Φk : CategoryTheory.IsIso Φ_k.left := by
      change CategoryTheory.IsIso hPb_k.isoPullback.hom
      infer_instance
    have : CategoryTheory.IsIso Φ_E.left :=
      hIsoDescent _ _ _ _ p_P p_pb Φ_E Φ_k hp_P' hp_pb hComm_Φ hIso_Φk
    refine (CategoryTheory.IsPullback.of_hasPullback c_E.left d_E.left).of_iso
      (CategoryTheory.asIso Φ_E.left).symm
      (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
      ?_ ?_ (by simp) (by simp)
    · apply (CategoryTheory.cancel_epi Φ_E.left).mp
      simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
        CategoryTheory.Iso.symm_hom, CategoryTheory.asIso_inv,
        CategoryTheory.IsIso.hom_inv_id_assoc]
      exact CategoryTheory.Limits.pullback.lift_fst a_E.left b_E.left hComm_E
    · apply (CategoryTheory.cancel_epi Φ_E.left).mp
      simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
        CategoryTheory.Iso.symm_hom, CategoryTheory.asIso_inv,
        CategoryTheory.IsIso.hom_inv_id_assoc]
      exact CategoryTheory.Limits.pullback.lift_snd a_E.left b_E.left hComm_E

  
  
  
  have hRelDimUnique : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ Z) (x₀ : ↥X) (r d : ℕ),
      AlgebraicGeometry.SmoothOfRelativeDimension r g →
      AlgebraicGeometry.SmoothOfRelativeDimension d g →
      r = d := by
    intro X Z g x₀ r d hr hd
    obtain ⟨U₀, hU₀, hx₀U, _⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens
        (show g.base x₀ ∈ (⊤ : Z.Opens) from trivial)
    obtain ⟨V₀, hV₀, hx₀V, he₀'⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
        (show x₀ ∈ (g ⁻¹ᵁ U₀) from hx₀U)
    let A := ↑(Z.presheaf.obj (Opposite.op U₀))
    let B := ↑(X.presheaf.obj (Opposite.op V₀))
    let ψ : A →+* B := (g.appLE U₀ V₀ he₀').hom
    have hLoc_r : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension r) ψ :=
      (AlgebraicGeometry.HasRingHomProperty.iff_appLE
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension r)).mp hr ⟨U₀, hU₀⟩ ⟨V₀, hV₀⟩ he₀'
    have hLoc_d : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d) ψ :=
      (AlgebraicGeometry.HasRingHomProperty.iff_appLE
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension d)).mp hd ⟨U₀, hU₀⟩ ⟨V₀, hV₀⟩ he₀'
    obtain ⟨s₁, hs₁, hStd_r⟩ :=
      (RingHom.locally_iff_isLocalization
        (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso r) ψ).mp hLoc_r
    obtain ⟨s₂, hs₂, hStd_d⟩ :=
      (RingHom.locally_iff_isLocalization
        (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d) ψ).mp hLoc_d
    let q₀ : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op V₀)) :=
      hV₀.primeIdealOf ⟨x₀, hx₀V⟩
    have hq_prime : q₀.asIdeal.IsPrime := q₀.isPrime
    have hex_a : ∃ a ∈ s₁, a ∉ q₀.asIdeal := by
      by_contra h_all
      have hsub : (s₁ : Set B) ⊆ q₀.asIdeal := fun a ha =>
        Classical.not_not.mp fun hnot => h_all ⟨a, ha, hnot⟩
      have htop : (⊤ : Ideal B) ≤ q₀.asIdeal := hs₁ ▸ Ideal.span_le.mpr hsub
      exact hq_prime.ne_top (top_unique htop)
    have hex_b : ∃ b ∈ s₂, b ∉ q₀.asIdeal := by
      by_contra h_all
      have hsub : (s₂ : Set B) ⊆ q₀.asIdeal := fun b hb =>
        Classical.not_not.mp fun hnot => h_all ⟨b, hb, hnot⟩
      have htop : (⊤ : Ideal B) ≤ q₀.asIdeal := hs₂ ▸ Ideal.span_le.mpr hsub
      exact hq_prime.ne_top (top_unique htop)
    obtain ⟨a, ha_mem, ha_not⟩ := hex_a
    obtain ⟨b, hb_mem, hb_not⟩ := hex_b
    have hab_not : a * b ∉ q₀.asIdeal :=
      fun h => (hq_prime.mem_or_mem h).elim ha_not hb_not
    let _ : Algebra A B := ψ.toAlgebra
    let B_a := Localization.Away a
    let B_b := Localization.Away b
    have hAlg_Ba : Algebra.IsStandardSmoothOfRelativeDimension r A B_a := by
      rw [← RingHom.isStandardSmoothOfRelativeDimension_algebraMap,
        IsScalarTower.algebraMap_eq A B B_a]
      exact hStd_r a ha_mem B_a
    have hAlg_Bb : Algebra.IsStandardSmoothOfRelativeDimension d A B_b := by
      rw [← RingHom.isStandardSmoothOfRelativeDimension_algebraMap,
        IsScalarTower.algebraMap_eq A B B_b]
      exact hStd_d b hb_mem B_b
    let T₁ := Localization.Away (algebraMap B B_a b)
    let T₂ := Localization.Away (algebraMap B B_b a)
    have : Algebra.IsStandardSmoothOfRelativeDimension r A B_a := hAlg_Ba
    have : Algebra.IsStandardSmoothOfRelativeDimension d A B_b := hAlg_Bb
    have : Algebra.IsStandardSmoothOfRelativeDimension 0 B_a T₁ :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap B B_a b)
    have : Algebra.IsStandardSmoothOfRelativeDimension 0 B_b T₂ :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap B B_b a)
    have hT₁_r : Algebra.IsStandardSmoothOfRelativeDimension r A T₁ := by
      have h0 := Algebra.IsStandardSmoothOfRelativeDimension.trans r 0 A B_a T₁
      rwa [Nat.zero_add] at h0
    have hT₂_d : Algebra.IsStandardSmoothOfRelativeDimension d A T₂ := by
      have h0 := Algebra.IsStandardSmoothOfRelativeDimension.trans d 0 A B_b T₂
      rwa [Nat.zero_add] at h0
    have : IsLocalization.Away (a * b) T₁ := IsLocalization.Away.mul' B_a T₁ a b
    have : IsLocalization.Away (a * b) T₂ := IsLocalization.Away.mul B_b T₂ b a
    let e_B : T₂ ≃ₐ[B] T₁ := IsLocalization.algEquiv (Submonoid.powers (a * b)) T₂ T₁
    let e_A : T₂ ≃ₐ[A] T₁ := e_B.restrictScalars A
    have : Algebra.IsStandardSmoothOfRelativeDimension d A T₂ := hT₂_d
    have hT₁_d : Algebra.IsStandardSmoothOfRelativeDimension d A T₁ :=
      Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv d e_A
    have : Nontrivial T₁ := by
      rw [nontrivial_iff]
      refine ⟨0, 1, fun h01 => ?_⟩
      have hmap : algebraMap B T₁ 0 = algebraMap B T₁ 1 := by
        simpa only [map_zero, map_one] using h01
      obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers (a * b)) T₁).mp hmap
      simp only [mul_zero, mul_one] at hn
      have hpow_mem : (a * b) ^ n ∈ q₀.asIdeal := hn.symm ▸ q₀.asIdeal.zero_mem
      have hpow_not : ∀ m : ℕ, (a * b) ^ m ∉ q₀.asIdeal := by
        intro m
        induction m with
        | zero =>
          intro h1
          rw [pow_zero] at h1
          exact hq_prime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
        | succ m ih =>
          intro hm
          rw [pow_succ] at hm
          exact (hq_prime.mem_or_mem hm).elim ih hab_not
      exact hpow_not n hpow_mem
    have : Algebra.IsStandardSmoothOfRelativeDimension r A T₁ := hT₁_r
    have : Algebra.IsStandardSmooth A T₁ :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth r
    have hrk_r : Module.rank T₁ Ω[T₁⁄A] = (r : Cardinal) :=
      (Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth r).mp hT₁_r
    have hrk_d : Module.rank T₁ Ω[T₁⁄A] = (d : Cardinal) :=
      (Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth d).mp hT₁_d
    exact Nat.cast_injective (hrk_r.symm.trans hrk_d)

  have hSmoothRelDim :
      ∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p₁ : W₁.left ⟶ Y₁.left) (p₂ : W₂.left ⟶ Y₂.left)
        (φ_E : Y₁ ⟶ Y₂) (φ_k : W₁ ⟶ W₂),
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      p₁ ≫ φ_E.left = φ_k.left ≫ p₂ →
      ∀ d : ℕ, AlgebraicGeometry.SmoothOfRelativeDimension d φ_k.left →
        AlgebraicGeometry.SmoothOfRelativeDimension d φ_E.left := by
    intro Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm d hSm_k_d
    obtain ⟨hp₂_surj, hp₂_flat, hp₂_qc, _, _, _⟩ := hModelFPQC Y₂ W₂ p₂ hp₂
    obtain ⟨_, _, _, _, _, hp₁_surj_fn⟩ := hModelFPQC Y₁ W₁ p₁ hp₁
    obtain ⟨hSq_flip, hSq⟩ := hCartSq Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm
    have : AlgebraicGeometry.SmoothOfRelativeDimension d φ_k.left := hSm_k_d
    have hSm_k : AlgebraicGeometry.Smooth φ_k.left := by
      rw [AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.Smooth)]
      intro U V e
      rw [RingHom.smooth_iff_locally_isStandardSmooth]
      have hLoc_d : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
          (φ_k.left.appLE U.1 V.1 e).hom :=
        (AlgebraicGeometry.HasRingHomProperty.iff_appLE
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension d)).mp hSm_k_d U V e
      exact RingHom.locally_of_locally
        (fun {_ _ _ _ f} hf => RingHom.IsStandardSmoothOfRelativeDimension.isStandardSmooth d f hf)
        hLoc_d
    have hSm_E : AlgebraicGeometry.Smooth φ_E.left :=
      CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback
        (P := @AlgebraicGeometry.Smooth)
        (Q := @AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓
          @AlgebraicGeometry.QuasiCompact)
        hSq_flip ⟨⟨hp₂_surj, hp₂_flat⟩, hp₂_qc⟩ hSm_k
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun x => ?_
    obtain ⟨U, hU, V, hV, hx, e, hStd⟩ :=
      @AlgebraicGeometry.Smooth.exists_isStandardSmooth _ _ φ_E.left hSm_E x
    let ψ_hom := φ_E.left.appLE U V e
    let _ : Algebra ↑(Y₂.left.presheaf.obj (Opposite.op U))
        ↑(Y₁.left.presheaf.obj (Opposite.op V)) := ψ_hom.hom.toAlgebra
    have hAlgStd : Algebra.IsStandardSmooth
        ↑(Y₂.left.presheaf.obj (Opposite.op U))
        ↑(Y₁.left.presheaf.obj (Opposite.op V)) :=
      RingHom.IsStandardSmooth.toAlgebra hStd
    obtain ⟨ι, σ, hFinσ, hFinι, ⟨P⟩⟩ := Algebra.IsStandardSmooth.out (self := hAlgStd)
    let r : ℕ := P.dimension
    have hStd_r : RingHom.IsStandardSmoothOfRelativeDimension r ψ_hom.hom := by
      change RingHom.IsStandardSmoothOfRelativeDimension r (algebraMap _ _)
      rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
      exact ⟨ι, σ, hFinσ, hFinι, P, rfl⟩
    have hLoc_r : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension r) ψ_hom.hom :=
      RingHom.locally_of (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso r) ψ_hom.hom hStd_r
    have hSpec_r : AlgebraicGeometry.SmoothOfRelativeDimension r (AlgebraicGeometry.Spec.map ψ_hom) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension r)).mpr hLoc_r
    have hV_comp_eq : V.ι ≫ φ_E.left =
        hV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ψ_hom ≫ (hU.isoSpec.inv ≫ U.ι) := by
      have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE φ_E.left U V e
      rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hU,
        ← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hV] at h1
      calc V.ι ≫ φ_E.left
          = φ_E.left.resLE U V e ≫ U.ι :=
            (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι φ_E.left e).symm
        _ = (φ_E.left.resLE U V e ≫ hU.isoSpec.hom) ≫ (hU.isoSpec.inv ≫ U.ι) := by
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
        _ = (hV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ψ_hom) ≫ (hU.isoSpec.inv ≫ U.ι) := by
            rw [← h1]
        _ = hV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ψ_hom ≫ (hU.isoSpec.inv ≫ U.ι) :=
            CategoryTheory.Category.assoc _ _ _
    have hV_E_r : AlgebraicGeometry.SmoothOfRelativeDimension r (V.ι ≫ φ_E.left) := by
      rw [hV_comp_eq]
      have : AlgebraicGeometry.SmoothOfRelativeDimension r (AlgebraicGeometry.Spec.map ψ_hom) :=
        hSpec_r
      have h1 : AlgebraicGeometry.SmoothOfRelativeDimension (r + 0)
          (AlgebraicGeometry.Spec.map ψ_hom ≫ (hU.isoSpec.inv ≫ U.ι)) :=
        AlgebraicGeometry.smoothOfRelativeDimension_comp r 0
          (AlgebraicGeometry.Spec.map ψ_hom) (hU.isoSpec.inv ≫ U.ι)
      rw [Nat.add_zero] at h1
      have : AlgebraicGeometry.SmoothOfRelativeDimension r
          (AlgebraicGeometry.Spec.map ψ_hom ≫ (hU.isoSpec.inv ≫ U.ι)) := h1
      have h2 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + r)
          (hV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map ψ_hom ≫ (hU.isoSpec.inv ≫ U.ι)) :=
        AlgebraicGeometry.smoothOfRelativeDimension_comp 0 r
          hV.isoSpec.hom (AlgebraicGeometry.Spec.map ψ_hom ≫ (hU.isoSpec.inv ≫ U.ι))
      rwa [Nat.zero_add] at h2
    let V_k : W₁.left.Opens := p₁ ⁻¹ᵁ V
    have hSq_V : CategoryTheory.IsPullback (p₁ ∣_ V)
        (V_k.ι ≫ φ_k.left) (V.ι ≫ φ_E.left) p₂ :=
      (AlgebraicGeometry.isPullback_morphismRestrict p₁ V).paste_vert hSq
    have hVk_r : AlgebraicGeometry.SmoothOfRelativeDimension r (V_k.ι ≫ φ_k.left) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension r) hSq_V hV_E_r
    have hVk_d : AlgebraicGeometry.SmoothOfRelativeDimension d (V_k.ι ≫ φ_k.left) := by
      have h0 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d) (V_k.ι ≫ φ_k.left) :=
        AlgebraicGeometry.smoothOfRelativeDimension_comp 0 d V_k.ι φ_k.left
      rwa [Nat.zero_add] at h0
    obtain ⟨w₁, hw₁⟩ := hp₁_surj_fn x
    have hw₁_mem : w₁ ∈ V_k := by
      change p₁.base w₁ ∈ V
      rwa [hw₁]
    have hrd : r = d :=
      hRelDimUnique (V_k.ι ≫ φ_k.left) ⟨w₁, hw₁_mem⟩ r d hVk_r hVk_d
    exact ⟨U, hU, V, hV, hx, e, hrd ▸ hStd_r⟩

  
  
  
  obtain ⟨π_ret, hπ_ret⟩ : ∃ g : k →ₗ[E] E, g ∘ₗ Algebra.linearMap E k = LinearMap.id :=
    LinearMap.exists_leftInverse_of_injective (Algebra.linearMap E k)
      (LinearMap.ker_eq_bot.mpr (algebraMap E k).injective)
  have hπ_one : π_ret 1 = 1 := by
    have h1 : (π_ret ∘ₗ Algebra.linearMap E k) 1 = (LinearMap.id : E →ₗ[E] E) 1 :=
      congrArg (fun f => f 1) hπ_ret
    simpa only [LinearMap.comp_apply, Algebra.linearMap_apply, map_one, LinearMap.id_apply] using h1

  have hFlatRetractAlg : ∀ (R S : Type u) [CommRing R] [CommRing S]
      [Algebra E R] [Algebra E S] (ψ_alg : R →ₐ[E] S),
      RingHom.Flat (Algebra.TensorProduct.map (AlgHom.id k k) ψ_alg).toRingHom →
      RingHom.Flat ψ_alg.toRingHom := by
    intro R S _ _ _ _ ψ_alg hFlat_k
    let ψ_k := Algebra.TensorProduct.map (AlgHom.id k k) ψ_alg
    let _ : Algebra R S := ψ_alg.toRingHom.toAlgebra
    let _ : Algebra R (TensorProduct E k R) :=
      Algebra.TensorProduct.includeRight.toRingHom.toAlgebra
    let _ : Algebra (TensorProduct E k R) (TensorProduct E k S) := ψ_k.toRingHom.toAlgebra
    let _ : Algebra R (TensorProduct E k S) :=
      (ψ_k.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom).toAlgebra
    have : IsScalarTower R (TensorProduct E k R) (TensorProduct E k S) :=
      IsScalarTower.of_algebraMap_eq' rfl
    have : Module.Flat (TensorProduct E k R) (TensorProduct E k S) := hFlat_k
    have : Module.Flat R (TensorProduct E k R) := by
      let e_comm : TensorProduct E k R ≃ₐ[E] TensorProduct E R k :=
        Algebra.TensorProduct.comm E k R
      let e_lin : TensorProduct E k R ≃ₗ[R] TensorProduct E R k :=
        { toFun := e_comm
          invFun := e_comm.symm
          left_inv := e_comm.left_inv
          right_inv := e_comm.right_inv
          map_add' := map_add e_comm
          map_smul' := fun r z => by
            let f_L : TensorProduct E k R →ₗ[E] TensorProduct E R k :=
              e_comm.toLinearMap.comp (LinearMap.mulLeft E (1 ⊗ₜ[E] r))
            let f_R : TensorProduct E k R →ₗ[E] TensorProduct E R k :=
              { toFun := fun w => r • e_comm w
                map_add' := fun x y => by rw [map_add, smul_add]
                map_smul' := fun e x => by rw [map_smul, smul_comm]; rfl }
            have hf : f_L = f_R := by
              apply TensorProduct.ext'
              intro c x
              change e_comm ((1 ⊗ₜ[E] r) * (c ⊗ₜ[E] x)) =
                r • ((x ⊗ₜ[E] c) : TensorProduct E R k)
              rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, TensorProduct.smul_tmul']
              rfl
            exact congrArg (fun f => f z) hf }
      exact Module.Flat.of_linearEquiv e_lin
    have : Module.Flat R (TensorProduct E k S) :=
      Module.Flat.trans R (TensorProduct E k R) (TensorProduct E k S)
    let ρ_E : TensorProduct E k S →ₗ[E] S :=
      TensorProduct.lift
        { toFun := fun c => π_ret c • (LinearMap.id : S →ₗ[E] S)
          map_add' := fun c₁ c₂ => by rw [map_add, add_smul]
          map_smul' := fun e c => by rw [map_smul, smul_smul]; rfl }
    let i_map : S →ₗ[R] TensorProduct E k S :=
      { toFun := fun s => 1 ⊗ₜ[E] s
        map_add' := fun x y => TensorProduct.tmul_add 1 x y
        map_smul' := fun r s => by
          change 1 ⊗ₜ[E] (ψ_alg r * s) = (1 ⊗ₜ[E] ψ_alg r) * (1 ⊗ₜ[E] s)
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul] }
    let ρ_map : TensorProduct E k S →ₗ[R] S :=
      { toFun := ρ_E
        map_add' := map_add ρ_E
        map_smul' := fun r z => by
          have hf : ρ_E.comp (LinearMap.mulLeft E (1 ⊗ₜ[E] ψ_alg r)) =
              (LinearMap.mulLeft E (ψ_alg r)).comp ρ_E := by
            apply TensorProduct.ext'
            intro c s
            change ρ_E ((1 ⊗ₜ[E] ψ_alg r) * (c ⊗ₜ[E] s)) = ψ_alg r * ρ_E (c ⊗ₜ[E] s)
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            change π_ret c • (ψ_alg r * s) = ψ_alg r * (π_ret c • s)
            exact (mul_smul_comm (π_ret c) (ψ_alg r) s).symm
          exact congrArg (fun f => f z) hf }
    have h_retract : ρ_map ∘ₗ i_map = LinearMap.id := by
      ext s
      change π_ret 1 • s = s
      rw [hπ_one, one_smul]
    exact Module.Flat.of_retract i_map ρ_map h_retract

  have hSurjRetractAlg : ∀ (R S : Type u) [CommRing R] [CommRing S]
      [Algebra E R] [Algebra E S] (α_alg : R →ₐ[E] S),
      Function.Surjective (Algebra.TensorProduct.map (AlgHom.id k k) α_alg) →
      Function.Surjective α_alg := by
    intro R S _ _ _ _ α_alg hSurj_k s
    let ρ_R : TensorProduct E k R →ₗ[E] R :=
      TensorProduct.lift
        { toFun := fun c => π_ret c • (LinearMap.id : R →ₗ[E] R)
          map_add' := fun c₁ c₂ => by rw [map_add, add_smul]
          map_smul' := fun e c => by rw [map_smul, smul_smul]; rfl }
    let ρ_S : TensorProduct E k S →ₗ[E] S :=
      TensorProduct.lift
        { toFun := fun c => π_ret c • (LinearMap.id : S →ₗ[E] S)
          map_add' := fun c₁ c₂ => by rw [map_add, add_smul]
          map_smul' := fun e c => by rw [map_smul, smul_smul]; rfl }
    have h_intertwine : α_alg.toLinearMap ∘ₗ ρ_R =
        ρ_S ∘ₗ (Algebra.TensorProduct.map (AlgHom.id k k) α_alg).toLinearMap := by
      apply TensorProduct.ext'
      intro c r
      change α_alg (π_ret c • r) = π_ret c • α_alg r
      exact map_smul α_alg (π_ret c) r
    obtain ⟨z, hz⟩ := hSurj_k (1 ⊗ₜ[E] s)
    refine ⟨ρ_R z, ?_⟩
    have h1 : α_alg (ρ_R z) = ρ_S (Algebra.TensorProduct.map (AlgHom.id k k) α_alg z) :=
      congrArg (fun f => f z) h_intertwine
    rw [h1, hz]
    change π_ret 1 • s = s
    rw [hπ_one, one_smul]

  have hFlatDescent :
      ∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p₁ : W₁.left ⟶ Y₁.left) (p₂ : W₂.left ⟶ Y₂.left)
        (φ_E : Y₁ ⟶ Y₂) (φ_k : W₁ ⟶ W₂),
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      p₁ ≫ φ_E.left = φ_k.left ≫ p₂ →
      AlgebraicGeometry.Flat φ_k.left →
      AlgebraicGeometry.Flat φ_E.left := by
    intro Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm hFlat_k
    have : AlgebraicGeometry.Flat φ_k.left := hFlat_k
    rw [AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.Flat)]
    intro U V e
    have hU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
    have hV : AlgebraicGeometry.IsAffineOpen V.1 := V.2
    let R := ↑(Y₂.left.presheaf.obj (Opposite.op U.1))
    let S := ↑(Y₁.left.presheaf.obj (Opposite.op V.1))
    let ψ_hom := φ_E.left.appLE U.1 V.1 e
    let u_E : AlgebraicGeometry.Spec (Y₂.left.presheaf.obj (Opposite.op U.1)) ⟶ Y₂.left :=
      hU.isoSpec.inv ≫ U.1.ι
    let v_E : AlgebraicGeometry.Spec (Y₁.left.presheaf.obj (Opposite.op V.1)) ⟶ Y₁.left :=
      hV.isoSpec.inv ≫ V.1.ι
    have : AlgebraicGeometry.IsOpenImmersion u_E := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion v_E := inferInstance
    have huv_comm : AlgebraicGeometry.Spec.map ψ_hom ≫ u_E = v_E ≫ φ_E.left := by
      have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE φ_E.left U.1 V.1 e
      rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hU,
        ← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hV] at h1
      calc AlgebraicGeometry.Spec.map ψ_hom ≫ u_E
