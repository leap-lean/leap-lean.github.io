    let w : Fin 3 → k := fun r => MvPolynomial.eval u (u_coord β r)
    have hw_ne : w ≠ 0 := by
      intro h0
      have hwβ : w β = 0 := congrFun h0 β
      dsimp [w] at hwβ
      rw [hu_self β, map_one] at hwβ
      exact one_ne_zero hwβ
    have hp₀_iff : ∀ (F : MvPolynomial (Fin 3) k) (d : ℕ), F ∈ 𝒜_2 d →
