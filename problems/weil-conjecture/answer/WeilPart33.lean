  have h_mod4 : ∀ (s d : ℕ)
      (A_Z : Type u) [CommRing A_Z] [Algebra k A_Z]
      (φ : MvPolynomial (Fin (s + 1 + d)) k →+* A_Z)
      (hSurj_φ : Function.Surjective φ)
      (hAlg_φ : ∀ c : k, φ (MvPolynomial.C c) = algebraMap k A_Z c)
      (q : Fin s → MvPolynomial (Fin (s + 1 + d)) k)
      (hKer_φ : RingHom.ker φ = Ideal.span (Set.range q))
      (f_lift : MvPolynomial (Fin (s + 1 + d)) k)
      (idx : Fin (s + 1) → Fin (s + 1 + d))
      (hInj_idx : Function.Injective idx)
      (hDet : IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + 1) =>
