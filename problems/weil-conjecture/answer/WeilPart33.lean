          have h1 : (MvPolynomial.sumAlgEquiv R (Fin (d - 1)) (Fin n)).symm
              (MvPolynomial.C (MvPolynomial.C r : MvPolynomial (Fin n) R)) = MvPolynomial.C r := by
            apply (MvPolynomial.sumAlgEquiv R (Fin (d - 1)) (Fin n)).injective
            rw [AlgEquiv.apply_symm_apply]
            simp
          dsimp [e_base_alg]
          rw [h1, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
        rw [he_r, MvPolynomial.map_C, MvPolynomial.map_C, IsLocalization.Away.lift_eq]
        change algebraMap Q_G S_G (ev_slice (MvPolynomial.C (algebraMap R C r))) = _
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro b
        change α_slice (algebraMap Q_slice S_slice (Ideal.Quotient.mk I_slice
          (MvPolynomial.map (algebraMap R C)
            (e_base_alg (MvPolynomial.C (MvPolynomial.X b : MvPolynomial (Fin n) R)))))) =
          algebraMap Q_G S_G (Ideal.Quotient.mk I_G
            (MvPolynomial.map (algebraMap R C) (MvPolynomial.X b)))
        have he_b :
            e_base_alg (MvPolynomial.C (MvPolynomial.X b : MvPolynomial (Fin n) R)) =
              MvPolynomial.X (inl_var b) := by
          have h1 : (MvPolynomial.sumAlgEquiv R (Fin (d - 1)) (Fin n)).symm
              (MvPolynomial.C (MvPolynomial.X b : MvPolynomial (Fin n) R)) =
              MvPolynomial.X (Sum.inr b) := by
            apply (MvPolynomial.sumAlgEquiv R (Fin (d - 1)) (Fin n)).injective
            rw [AlgEquiv.apply_symm_apply]
            simp
          dsimp [e_base_alg, inl_var]
          rw [h1, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
          rfl
        rw [he_b, MvPolynomial.map_X, MvPolynomial.map_X, IsLocalization.Away.lift_eq]
        change algebraMap Q_G S_G (ev_slice (MvPolynomial.X (inl_var b))) = _
        rw [MvPolynomial.eval₂Hom_X']
        simp [var_val, inl_var]
    exact hStdSmooth R_n S_G (d - 1) f_target g_B hg_B_et hg_B_comp

  obtain ⟨_, _, hPart1⟩ := hS2 R C ψ hψ_alg hψ_et
  exact ⟨hPart1, hPart2, fun n der_C hder_C => ⟨hPart3a n der_C hder_C, hPart3b n der_C hder_C⟩⟩

theorem weil_ring_etale_retraction_and_morse_quadratic_taylor (k : Type u) [Field k] (d : ℕ)
    (A_Z : Type u) [CommRing A_Z] [Algebra k A_Z] :
    (∀ (ε_z : A_Z →+* k) [(RingHom.ker ε_z).IsPrime],
      ε_z.comp (algebraMap k A_Z) = RingHom.id k →
      ∀ (ψ_Z : MvPolynomial (Fin d) k →+* A_Z),
        ψ_Z.comp MvPolynomial.C = algebraMap k A_Z →
        (∀ i : Fin d, ψ_Z (MvPolynomial.X i) ∈ RingHom.ker ε_z) →
        ∀ (der_Z : Fin d → Derivation k A_Z A_Z),
          (∀ (i : Fin d) (f : MvPolynomial (Fin d) k),
            der_Z i (ψ_Z f) = ψ_Z (MvPolynomial.pderiv i f)) →
          ∀ (Q : MvPolynomial (Fin d) k),
            Q ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 2 →
            ∀ (ℓ_0 : A_Z),
              algebraMap A_Z (Localization.AtPrime (RingHom.ker ε_z)) (ℓ_0 - ψ_Z Q) ∈
                (IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker ε_z))) ^ 3 →
              ε_z ℓ_0 = 0 ∧
              (∀ i : Fin d, ε_z (der_Z i ℓ_0) = 0) ∧
              (∀ i j : Fin d,
                ε_z (der_Z j (der_Z i ℓ_0)) =
                  MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q)))) ∧
    (∀ (dG : Fin d → MvPolynomial (Fin 2) A_Z) (delta_crit : MvPolynomial (Fin 2) A_Z),
      ((weilCritLocTau dG delta_crit).comp (MvPolynomial.map (algebraMap k A_Z))).Etale →
      ∃ (N_diag : ℕ) (c_diag : Fin N_diag → MvPolynomial (Fin 2) A_Z)
        (r_diag : Fin N_diag → weilCritLocRingCat dG delta_crit),
        (∑ s : Fin N_diag, weilCritLocTau dG delta_crit (c_diag s) * r_diag s = 1) ∧
        (∀ (D : Type u) [CommRing D]
            (α : MvPolynomial (Fin 2) A_Z →+* D)
            (β : weilCritLocRingCat dG delta_crit →+* D),
          α.comp (MvPolynomial.map (algebraMap k A_Z)) =
            β.comp ((weilCritLocTau dG delta_crit).comp (MvPolynomial.map (algebraMap k A_Z))) →
          ∀ P : PrimeSpectrum D,
            (∑ s : Fin N_diag, α (c_diag s) * β (r_diag s)) ∉ P.asIdeal →
            (∀ i : Fin d, α (dG i) ∈ P.asIdeal) →
            ∀ c : MvPolynomial (Fin 2) A_Z,
              α c - β (weilCritLocTau dG delta_crit c) ∈ P.asIdeal)) ∧
    (∀ (ψ_Z : MvPolynomial (Fin d) k →+* A_Z),
      ψ_Z.comp MvPolynomial.C = algebraMap k A_Z →
      ψ_Z.Etale →
      ∀ (der_Z : Fin d → Derivation k A_Z A_Z),
        (∀ (i : Fin d) (f : MvPolynomial (Fin d) k),
          der_Z i (ψ_Z f) = ψ_Z (MvPolynomial.pderiv i f)) →
        ∀ (R : Type u) [CommRing R]
          (φ_R : MvPolynomial (Fin 2) k →+* R),
          φ_R.Etale →
          ∀ (τ_R : MvPolynomial (Fin 2) A_Z →+* R),
            τ_R.comp (MvPolynomial.map (algebraMap k A_Z)) = φ_R →
            ∀ (G_poly : MvPolynomial (Fin 2) A_Z),
              (∀ i : Fin d, τ_R (weilMvPolyMapCoeffs (der_Z i) G_poly) = 0) →
              ∃ (B_1 : CommRingCat.{u})
                (α_1 : MvPolynomial (Fin 2) A_Z →+* B_1)
                (ι_R1 : R →+* B_1) (σ_1 : B_1 →+* R)
                (y_1 : Fin d → B_1) (Q_hat : Fin d → Fin d → B_1),
                α_1.Etale ∧
                (MvPolynomial.eval₂Hom ι_R1 y_1).Etale ∧
                σ_1.comp ι_R1 = RingHom.id R ∧
                σ_1.comp α_1 = τ_R ∧
                α_1.comp (MvPolynomial.map (algebraMap k A_Z)) = ι_R1.comp φ_R ∧
                RingHom.ker σ_1 = Ideal.span (Set.range y_1) ∧
                (∀ i j : Fin d, j < i → Q_hat i j = 0) ∧
                ι_R1 (τ_R G_poly) - α_1 G_poly =
                  ∑ i : Fin d, ∑ j : Fin d, Q_hat i j * y_1 i * y_1 j ∧
                (∀ a b : Fin d,
                  (if a = b then 2 * σ_1 (Q_hat a a)
                   else if a < b then σ_1 (Q_hat a b)
                   else σ_1 (Q_hat b a)) =
                    -τ_R (weilMvPolyMapCoeffs (der_Z b) (weilMvPolyMapCoeffs (der_Z a) G_poly)))) :=
by
  have hAnn : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.Etale A B]
      (σ : B →ₐ[A] A), ∃ e : B, σ e = 1 ∧ ∀ x ∈ RingHom.ker σ.toRingHom, e * x = 0 := by
    intro A B _ _ _ _ σ
    classical
    let J : Ideal B := RingHom.ker σ.toRingHom
    have hFG : J.FG := by
      have : Algebra.FinitePresentation A B := Algebra.Etale.finitePresentation
      obtain ⟨S, hS⟩ := Algebra.FiniteType.out (R := A) (A := B)
      let S' : Finset B := S.image (fun s => s - algebraMap A B (σ s))
      have hI₀_le : Ideal.span (S' : Set B) ≤ J := by
        rw [Ideal.span_le]
        intro y hy
        rcases Finset.mem_coe.mp hy |> Finset.mem_image.mp with ⟨s, _, rfl⟩
        change σ (s - algebraMap A B (σ s)) = 0
        rw [map_sub, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      refine ⟨S', le_antisymm hI₀_le ?_⟩
      let I₀ : Ideal B := Ideal.span (S' : Set B)
      let π₀ : B →ₐ[A] B ⧸ I₀ := Ideal.Quotient.mkₐ A I₀
      have h_adjoin : Algebra.adjoin A (S : Set B) ≤ (⊥ : Subalgebra A (B ⧸ I₀)).comap π₀ := by
        rw [Algebra.adjoin_le_iff]
        intro s hs
        change π₀ s ∈ (⊥ : Subalgebra A (B ⧸ I₀))
        rw [Algebra.mem_bot]
        refine ⟨σ s, ?_⟩
        have hmem : s - algebraMap A B (σ s) ∈ I₀ :=
          Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hs))
        have hzero : Ideal.Quotient.mk I₀ (s - algebraMap A B (σ s)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hmem
        rw [map_sub] at hzero
        change algebraMap A (B ⧸ I₀) (σ s) = Ideal.Quotient.mk I₀ s
        rw [IsScalarTower.algebraMap_apply A B (B ⧸ I₀)]
        exact (sub_eq_zero.mp hzero).symm
      intro b hb
      have hb_top : b ∈ (⊤ : Subalgebra A B) := Algebra.mem_top
      rw [← hS] at hb_top
      have hb_bot : π₀ b ∈ (⊥ : Subalgebra A (B ⧸ I₀)) := h_adjoin hb_top
      rcases Algebra.mem_bot.mp hb_bot with ⟨a, ha⟩
      have hsub_mem : b - algebraMap A B a ∈ I₀ := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub]
        change π₀ b - Ideal.Quotient.mk I₀ (algebraMap A B a) = 0
        have ha' : Ideal.Quotient.mk I₀ (algebraMap A B a) = π₀ b := by
          rw [IsScalarTower.algebraMap_apply A B (B ⧸ I₀)] at ha
          exact ha
        rw [ha', sub_self]
      have ha_zero : a = 0 := by
        have hJ_mem : b - algebraMap A B a ∈ J := hI₀_le hsub_mem
        change σ (b - algebraMap A B a) = 0 at hJ_mem
        have hb0 : σ b = 0 := hb
        rw [map_sub, hb0, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply, zero_sub,
          neg_eq_zero] at hJ_mem
        exact hJ_mem
      rw [ha_zero, map_zero, sub_zero] at hsub_mem
      exact hsub_mem
    have h_le : J ≤ J • J := by
      have : Algebra.FormallyEtale A B := Algebra.Etale.formallyEtale
      let C := B ⧸ (J ^ 2)
      let I : Ideal C := Ideal.map (Ideal.Quotient.mk (J ^ 2)) J
      have hI2 : I ^ 2 = ⊥ := by
        dsimp [I]
        rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
      let f₁ : B →ₐ[A] C := Ideal.Quotient.mkₐ A (J ^ 2)
      let f₂ : B →ₐ[A] C := (Algebra.ofId A C).comp σ
      have hcomp_eq : (Ideal.Quotient.mkₐ A I).comp f₁ = (Ideal.Quotient.mkₐ A I).comp f₂ := by
        ext b
        change Ideal.Quotient.mk I (f₁ b) = Ideal.Quotient.mk I (f₂ b)
        rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        have h_diff : f₁ b - f₂ b = Ideal.Quotient.mk (J ^ 2) (b - algebraMap A B (σ b)) := by
          change Ideal.Quotient.mk (J ^ 2) b - algebraMap A C (σ b) = _
          rw [IsScalarTower.algebraMap_apply A B C, map_sub]
          rfl
        rw [h_diff]
        refine Ideal.mem_map_of_mem _ ?_
        change σ (b - algebraMap A B (σ b)) = 0
        rw [map_sub, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      have hf_eq : f₁ = f₂ :=
        Algebra.FormallyUnramified.comp_injective I hI2 hcomp_eq
      intro x hx
      rw [Ideal.smul_eq_mul, ← sq]
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change f₁ x = 0
      rw [hf_eq]
      change algebraMap A C (σ x) = 0
      have hx0 : σ x = 0 := hx
      rw [hx0, map_zero]
    obtain ⟨e, he_mem, he_ann⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J J hFG h_le
    refine ⟨e, ?_, fun x hx => ?_⟩
    · have h0 : σ (e - 1) = 0 := he_mem
      rw [map_sub, map_one] at h0
      exact sub_eq_zero.mp h0
    · simpa only [smul_eq_mul] using he_ann x hx

  have hPart4 : ∀ (ψ_Z : MvPolynomial (Fin d) k →+* A_Z),
      ψ_Z.comp MvPolynomial.C = algebraMap k A_Z →
      ψ_Z.Etale →
      ∀ (der_Z : Fin d → Derivation k A_Z A_Z),
        (∀ (i : Fin d) (f : MvPolynomial (Fin d) k),
          der_Z i (ψ_Z f) = ψ_Z (MvPolynomial.pderiv i f)) →
        ∀ (R : Type u) [CommRing R]
          (φ_R : MvPolynomial (Fin 2) k →+* R),
          φ_R.Etale →
          ∀ (τ_R : MvPolynomial (Fin 2) A_Z →+* R),
            τ_R.comp (MvPolynomial.map (algebraMap k A_Z)) = φ_R →
            ∃ (B_1 : CommRingCat.{u})
              (α_1 : MvPolynomial (Fin 2) A_Z →+* B_1)
              (ι_R1 : R →+* B_1) (σ_1 : B_1 →+* R)
              (y_1 : Fin d → B_1)
              (D_1 : Fin d → (B_1 →+ B_1)),
              α_1.Etale ∧
              (MvPolynomial.eval₂Hom ι_R1 y_1).Etale ∧
              σ_1.comp ι_R1 = RingHom.id R ∧
              σ_1.comp α_1 = τ_R ∧
              α_1.comp (MvPolynomial.map (algebraMap k A_Z)) = ι_R1.comp φ_R ∧
              RingHom.ker σ_1 = Ideal.span (Set.range y_1) ∧
              (∀ (j : Fin d) (x y : B_1), D_1 j (x * y) = x * D_1 j y + y * D_1 j x) ∧
              (∀ (j : Fin d) (r : R), D_1 j (ι_R1 r) = 0) ∧
              (∀ j i : Fin d, D_1 j (y_1 i) = if j = i then 1 else 0) ∧
              (∀ (j : Fin d) (F : MvPolynomial (Fin 2) A_Z),
                D_1 j (α_1 F) = α_1 (weilMvPolyMapCoeffs (der_Z j) F)) := by
    intro ψ_Z hψ_alg hψ_et der_Z hder_Z R _ φ_R hφ_R_et τ_R hτ_R
    have hPolyPushoutEtale : ∀ (n : ℕ) (C_alg E_alg : Type u)
        [CommRing C_alg] [Algebra k C_alg] [CommRing E_alg] [Algebra k E_alg]
        (θ : MvPolynomial (Fin n) k →+* E_alg),
        θ.comp MvPolynomial.C = algebraMap k E_alg →
        θ.Etale →
        (MvPolynomial.eval₂Hom
          (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := C_alg) (B := E_alg))
          (fun i : Fin n => (1 : C_alg) ⊗ₜ[k] θ (MvPolynomial.X i))).Etale := by
      intro n C_alg E_alg _ _ _ _ θ hθ_alg hθ_et
      let Pnk := MvPolynomial (Fin n) k
      let PnC := MvPolynomial (Fin n) C_alg
      let TP_k := TensorProduct k C_alg E_alg
      let ψ_push : PnC →+* TP_k :=
        MvPolynomial.eval₂Hom
          (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := C_alg) (B := E_alg))
          (fun i : Fin n => (1 : C_alg) ⊗ₜ[k] θ (MvPolynomial.X i))
      let _ : Algebra Pnk E_alg := θ.toAlgebra
      have h_alg_θ : algebraMap Pnk E_alg = θ := RingHom.algebraMap_toAlgebra θ
      have _ : Algebra.Etale Pnk E_alg := RingHom.etale_algebraMap.mp (by rwa [h_alg_θ])
      let _ : Algebra Pnk PnC := (MvPolynomial.map (algebraMap k C_alg)).toAlgebra
      let TP_P := TensorProduct Pnk PnC E_alg
      have _ : Algebra.Etale PnC TP_P := Algebra.Etale.baseChange Pnk E_alg PnC
      have h_base_et : (algebraMap PnC TP_P).Etale := RingHom.etale_algebraMap.mpr inferInstance
      let ι_E_k : E_alg →ₐ[k] TP_k := Algebra.TensorProduct.includeRight
      let _ : Algebra Pnk TP_k := (ι_E_k.toRingHom.comp θ).toAlgebra
      have hψ_comp : ψ_push.comp (MvPolynomial.map (algebraMap k C_alg)) = ι_E_k.toRingHom.comp θ := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, MvPolynomial.map_C, RingHom.comp_apply]
          dsimp [ψ_push, ι_E_k]
          rw [MvPolynomial.eval₂Hom_C, Algebra.TensorProduct.includeLeftRingHom_apply,
            Algebra.TensorProduct.includeRight_apply]
          have h1 : θ (MvPolynomial.C c) = algebraMap k E_alg c := RingHom.congr_fun hθ_alg c
          rw [h1, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul]
        · intro i
          rw [RingHom.comp_apply, MvPolynomial.map_X, RingHom.comp_apply]
          dsimp [ψ_push, ι_E_k]
          rw [MvPolynomial.eval₂Hom_X', Algebra.TensorProduct.includeRight_apply]
      let ψ_push_alg : PnC →ₐ[Pnk] TP_k :=
        { ψ_push with
          commutes' := fun p => RingHom.congr_fun hψ_comp p }
      let ι_E_alg : E_alg →ₐ[Pnk] TP_k :=
        { ι_E_k.toRingHom with
          commutes' := fun _ => rfl }
      let Φ : TP_P →+* TP_k := (Algebra.TensorProduct.productMap ψ_push_alg ι_E_alg).toRingHom
      let _ : Algebra k TP_P :=
        ((algebraMap PnC TP_P).comp (MvPolynomial.C.comp (algebraMap k C_alg))).toAlgebra
      let g_C : C_alg →ₐ[k] TP_P :=
        { (algebraMap PnC TP_P).comp MvPolynomial.C with
          commutes' := fun _ => rfl }
      let g_E : E_alg →ₐ[k] TP_P :=
        { (Algebra.TensorProduct.includeRight (R := Pnk) (A := PnC) (B := E_alg)).toRingHom with
          commutes' := fun c => by
            change (1 : PnC) ⊗ₜ[Pnk] (algebraMap k E_alg c) =
              (MvPolynomial.C (algebraMap k C_alg c)) ⊗ₜ[Pnk] (1 : E_alg)
            have h1 : algebraMap k E_alg c = θ (MvPolynomial.C c) := (RingHom.congr_fun hθ_alg c).symm
            have h2 : θ (MvPolynomial.C c) = (MvPolynomial.C c : Pnk) • (1 : E_alg) := by
              rw [Algebra.smul_def, mul_one]; rfl
            have h3 : (MvPolynomial.C c : Pnk) • (1 : PnC) = MvPolynomial.C (algebraMap k C_alg c) := by
              rw [Algebra.smul_def, mul_one]
              change MvPolynomial.map (algebraMap k C_alg) (MvPolynomial.C c) = _
              exact MvPolynomial.map_C _ _
            rw [h1, h2, ← TensorProduct.smul_tmul, h3] }
      let Ψ : TP_k →+* TP_P := (Algebra.TensorProduct.productMap g_C g_E).toRingHom
      have hΦΨ : Φ.comp Ψ = RingHom.id TP_k := by
        refine RingHom.ext fun t => ?_
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul x e =>
          rw [RingHom.comp_apply, RingHom.id_apply]
          dsimp [Ψ, Φ]
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_mul]
          change (Algebra.TensorProduct.productMap ψ_push_alg ι_E_alg (MvPolynomial.C x ⊗ₜ[Pnk] 1)) *
              (Algebra.TensorProduct.productMap ψ_push_alg ι_E_alg (1 ⊗ₜ[Pnk] e)) = x ⊗ₜ[k] e
          rw [Algebra.TensorProduct.productMap_apply_tmul,
            Algebra.TensorProduct.productMap_apply_tmul, map_one, map_one, mul_one, one_mul]
          change ψ_push (MvPolynomial.C x) * (1 ⊗ₜ[k] e) = x ⊗ₜ[k] e
          dsimp only [ψ_push]
          rw [MvPolynomial.eval₂Hom_C, Algebra.TensorProduct.includeLeftRingHom_apply,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add t₁ t₂ ih₁ ih₂ =>
          simp only [RingHom.comp_apply, RingHom.id_apply] at ih₁ ih₂ ⊢
          rw [map_add, map_add, ih₁, ih₂]
      have hΨΦ : Ψ.comp Φ = RingHom.id TP_P := by
        have h_left : (Ψ.comp Φ).comp (algebraMap PnC TP_P) = algebraMap PnC TP_P := by
          apply MvPolynomial.ringHom_ext
          · intro x
            rw [RingHom.comp_apply, RingHom.comp_apply]
            change Ψ (Algebra.TensorProduct.productMap ψ_push_alg ι_E_alg (MvPolynomial.C x ⊗ₜ[Pnk] 1)) =
              MvPolynomial.C x ⊗ₜ[Pnk] 1
            rw [Algebra.TensorProduct.productMap_apply_tmul]
            change Ψ (ψ_push (MvPolynomial.C x) * 1) = MvPolynomial.C x ⊗ₜ[Pnk] 1
            rw [mul_one]
            dsimp [ψ_push, Ψ]
            rw [MvPolynomial.eval₂Hom_C, Algebra.TensorProduct.includeLeftRingHom_apply,
              Algebra.TensorProduct.productMap_apply_tmul]
            change (MvPolynomial.C x ⊗ₜ[Pnk] (1 : E_alg)) * 1 = MvPolynomial.C x ⊗ₜ[Pnk] 1
            exact mul_one _
          · intro i
            rw [RingHom.comp_apply, RingHom.comp_apply]
            change Ψ (Algebra.TensorProduct.productMap ψ_push_alg ι_E_alg (MvPolynomial.X i ⊗ₜ[Pnk] 1)) =
              MvPolynomial.X i ⊗ₜ[Pnk] 1
            rw [Algebra.TensorProduct.productMap_apply_tmul]
            change Ψ (ψ_push (MvPolynomial.X i) * 1) = MvPolynomial.X i ⊗ₜ[Pnk] 1
            rw [mul_one]
            dsimp [ψ_push, Ψ]
            rw [MvPolynomial.eval₂Hom_X', Algebra.TensorProduct.productMap_apply_tmul]
            change (1 : TP_P) * ((1 : PnC) ⊗ₜ[Pnk] θ (MvPolynomial.X i)) = MvPolynomial.X i ⊗ₜ[Pnk] 1
            rw [one_mul]
            have hXi : θ (MvPolynomial.X i) = (MvPolynomial.X i : Pnk) • (1 : E_alg) := by
              rw [Algebra.smul_def, mul_one]; rfl
            have hXi' : (MvPolynomial.X i : Pnk) • (1 : PnC) = MvPolynomial.X i := by
              rw [Algebra.smul_def, mul_one]
              change MvPolynomial.map (algebraMap k C_alg) (MvPolynomial.X i) = _
              exact MvPolynomial.map_X _ _
            rw [hXi, ← TensorProduct.smul_tmul, hXi']
        refine RingHom.ext fun t => ?_
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul f e =>
          have hf : Ψ (Φ (f ⊗ₜ[Pnk] 1)) = f ⊗ₜ[Pnk] 1 := RingHom.congr_fun h_left f
          have he : Ψ (Φ (1 ⊗ₜ[Pnk] e)) = 1 ⊗ₜ[Pnk] e := by
            dsimp [Φ, Ψ]
            rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
            change Algebra.TensorProduct.productMap g_C g_E ((1 : C_alg) ⊗ₜ[k] e) = 1 ⊗ₜ[Pnk] e
            rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
            rfl
          have hmul : f ⊗ₜ[Pnk] e = (f ⊗ₜ[Pnk] (1 : E_alg)) * ((1 : PnC) ⊗ₜ[Pnk] e) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [RingHom.comp_apply, RingHom.id_apply, hmul, map_mul, map_mul, hf, he]
        | add t₁ t₂ ih₁ ih₂ =>
          simp only [RingHom.comp_apply, RingHom.id_apply] at ih₁ ih₂ ⊢
          rw [map_add, map_add, ih₁, ih₂]
      have hΦ_bij : Function.Bijective Φ := by
        refine ⟨fun x y hxy => ?_, fun y => ⟨Ψ y, RingHom.congr_fun hΦΨ y⟩⟩
        have h := congrArg Ψ hxy
        exact (RingHom.congr_fun hΨΦ x).symm.trans (h.trans (RingHom.congr_fun hΨΦ y))
      have hψ_eq : ψ_push = Φ.comp (algebraMap PnC TP_P) := by
        refine RingHom.ext fun f => ?_
        rw [RingHom.comp_apply]
        dsimp [Φ]
        change ψ_push f = Algebra.TensorProduct.productMap ψ_push_alg ι_E_alg (f ⊗ₜ[Pnk] 1)
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        change ψ_push f = ψ_push f * 1
        exact (mul_one _).symm
      change ψ_push.Etale
      rw [hψ_eq]
      exact RingHom.Etale.stableUnderComposition _ _ h_base_et (RingHom.Etale.of_bijective hΦ_bij)

    have hQuotZeroEtale : ∀ (n : ℕ) (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
        (y : Fin n → B),
        (MvPolynomial.eval₂Hom (algebraMap A B) y).Etale →
        Algebra.Etale A (B ⧸ Ideal.span (Set.range y)) := by
      intro n A B _ _ _ y hy_et
      let PnA := MvPolynomial (Fin n) A
      let ψ : PnA →+* B := MvPolynomial.eval₂Hom (algebraMap A B) y
      let I_y : Ideal B := Ideal.span (Set.range y)
      let B_q := B ⧸ I_y
      let _ : Algebra PnA B := ψ.toAlgebra
      have h_alg_ψ : algebraMap PnA B = ψ := RingHom.algebraMap_toAlgebra ψ
      have _ : Algebra.Etale PnA B := RingHom.etale_algebraMap.mp (by rwa [h_alg_ψ])
      let ε_A : PnA →+* A := MvPolynomial.constantCoeff
      let _ : Algebra PnA A := ε_A.toAlgebra
      let TP_q := TensorProduct PnA A B
      have _ : Algebra.Etale A TP_q := Algebra.Etale.baseChange PnA B A
      have h_base_et : (algebraMap A TP_q).Etale := RingHom.etale_algebraMap.mpr inferInstance
      let π_q : B →+* B_q := Ideal.Quotient.mk I_y
      let _ : Algebra PnA B_q := (π_q.comp ψ).toAlgebra
      have h_ε_comp : (algebraMap A B_q).comp ε_A = π_q.comp ψ := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, ε_A, MvPolynomial.constantCoeff_C,
            ψ, MvPolynomial.eval₂Hom_C, IsScalarTower.algebraMap_apply A B B_q]
          rfl
        · intro i
          simp only [RingHom.comp_apply, ε_A, MvPolynomial.constantCoeff_X, map_zero,
            ψ, MvPolynomial.eval₂Hom_X']
          symm
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
      let f_A_alg : A →ₐ[PnA] B_q :=
        { algebraMap A B_q with
          commutes' := fun p => RingHom.congr_fun h_ε_comp p }
      let f_B_alg : B →ₐ[PnA] B_q :=
        { π_q with
          commutes' := fun _ => rfl }
      let Φ_q : TP_q →+* B_q := (Algebra.TensorProduct.productMap f_A_alg f_B_alg).toRingHom
      let j_B : B →+* TP_q := (Algebra.TensorProduct.includeRight (R := PnA) (A := A) (B := B)).toRingHom
      have hj_ker : ∀ x ∈ I_y, j_B x = 0 := by
        have hle : I_y ≤ RingHom.ker j_B := by
          rw [Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          change j_B (y i) = 0
          have hy_ψ : y i = ψ (MvPolynomial.X i) := (MvPolynomial.eval₂Hom_X' _ _ i).symm
          rw [hy_ψ]
          change (1 : A) ⊗ₜ[PnA] (ψ (MvPolynomial.X i)) = 0
          have h1 : ψ (MvPolynomial.X i) = (MvPolynomial.X i : PnA) • (1 : B) := by
            rw [Algebra.smul_def, mul_one]; rfl
          have h2 : (MvPolynomial.X i : PnA) • (1 : A) = 0 := by
            rw [Algebra.smul_def, mul_one]
            change MvPolynomial.constantCoeff (MvPolynomial.X i : PnA) = 0
            simp
          rw [h1, ← TensorProduct.smul_tmul, h2, TensorProduct.zero_tmul]
        exact fun x hx => hle hx
      let Ψ_q : B_q →+* TP_q := Ideal.Quotient.lift I_y j_B hj_ker
      have hΦΨ_q : Φ_q.comp Ψ_q = RingHom.id B_q := by
        refine RingHom.ext fun q => ?_
        rcases Ideal.Quotient.mk_surjective q with ⟨b, rfl⟩
        rw [RingHom.comp_apply, RingHom.id_apply, Ideal.Quotient.lift_mk]
        dsimp [Φ_q, j_B]
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
      have hΨΦ_q : Ψ_q.comp Φ_q = RingHom.id TP_q := by
        refine RingHom.ext fun t => ?_
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul a b =>
          have ha : Ψ_q (Φ_q (a ⊗ₜ[PnA] 1)) = a ⊗ₜ[PnA] 1 := by
            dsimp [Φ_q, Ψ_q]
            rw [Algebra.TensorProduct.productMap_apply_tmul]
            change Ideal.Quotient.lift I_y j_B hj_ker (algebraMap A B_q a * 1) = a ⊗ₜ[PnA] 1
            rw [mul_one, IsScalarTower.algebraMap_apply A B B_q]
            change j_B (algebraMap A B a) = a ⊗ₜ[PnA] 1
            change (1 : A) ⊗ₜ[PnA] (algebraMap A B a) = a ⊗ₜ[PnA] 1
            have h1 : algebraMap A B a = (MvPolynomial.C a : PnA) • (1 : B) := by
              rw [Algebra.smul_def, mul_one]
              exact (MvPolynomial.eval₂Hom_C _ _ a).symm
            have h2 : (MvPolynomial.C a : PnA) • (1 : A) = a := by
              rw [Algebra.smul_def, mul_one]
              change MvPolynomial.constantCoeff (MvPolynomial.C a : PnA) = a
              simp
            rw [h1, ← TensorProduct.smul_tmul, h2]
          have hb : Ψ_q (Φ_q (1 ⊗ₜ[PnA] b)) = 1 ⊗ₜ[PnA] b := by
            dsimp [Φ_q, Ψ_q]
            rw [Algebra.TensorProduct.productMap_apply_tmul]
            change Ideal.Quotient.lift I_y j_B hj_ker (f_A_alg 1 * π_q b) = 1 ⊗ₜ[PnA] b
            rw [map_one, one_mul]
            rfl
          have hmul : a ⊗ₜ[PnA] b = (a ⊗ₜ[PnA] (1 : B)) * ((1 : A) ⊗ₜ[PnA] b) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [RingHom.comp_apply, RingHom.id_apply, hmul, map_mul, map_mul, ha, hb]
        | add t₁ t₂ ih₁ ih₂ =>
          simp only [RingHom.comp_apply, RingHom.id_apply] at ih₁ ih₂ ⊢
          rw [map_add, map_add, ih₁, ih₂]
      have hΦ_q_bij : Function.Bijective Φ_q := by
        refine ⟨fun x y hxy => ?_, fun y => ⟨Ψ_q y, RingHom.congr_fun hΦΨ_q y⟩⟩
        have h := congrArg Ψ_q hxy
        exact (RingHom.congr_fun hΨΦ_q x).symm.trans (h.trans (RingHom.congr_fun hΨΦ_q y))
      have halg_eq : algebraMap A B_q = Φ_q.comp (algebraMap A TP_q) := by
        refine RingHom.ext fun a => ?_
        rw [RingHom.comp_apply]
        dsimp [Φ_q]
        change algebraMap A B_q a = Algebra.TensorProduct.productMap f_A_alg f_B_alg (a ⊗ₜ[PnA] 1)
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        change algebraMap A B_q a = algebraMap A B_q a * 1
        exact (mul_one _).symm
      apply RingHom.etale_algebraMap.mp
      rw [halg_eq]
      exact RingHom.Etale.stableUnderComposition _ _ h_base_et (RingHom.Etale.of_bijective hΦ_q_bij)

    have hLiftLocDer : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S]
        (f : S) (D₀ : Derivation A S S),
        ∃ D₁ : Localization.Away f →+ Localization.Away f,
          (∀ x y : Localization.Away f, D₁ (x * y) = x * D₁ y + y * D₁ x) ∧
          (∀ a : A, D₁ (algebraMap S (Localization.Away f) (algebraMap A S a)) = 0) ∧
          (∀ s : S, D₁ (algebraMap S (Localization.Away f) s) =
            algebraMap S (Localization.Away f) (D₀ s)) := by
      intro A S _ _ _ f D₀
      let L := Localization.Away f
      have _ : Algebra.FormallyEtale S L := Algebra.FormallyEtale.of_isLocalization (Submonoid.powers f)
      let d0_L : Derivation A S L := (Algebra.linearMap S L).compDer D₀
      let l0 : Ω[S⁄A] →ₗ[S] L := d0_L.liftKaehlerDifferential
      let l1 : TensorProduct S L Ω[S⁄A] →ₗ[L] L := LinearMap.liftBaseChange L l0
      let eK : TensorProduct S L Ω[S⁄A] ≃ₗ[L] Ω[L⁄A] :=
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A S L
      let D₁ : Derivation A L L := (l1.comp eK.symm.toLinearMap).compDer (KaehlerDifferential.D A L)
      refine ⟨D₁.toLinearMap.toAddMonoidHom, ?_, ?_, ?_⟩
      · intro x y
        change D₁ (x * y) = x * D₁ y + y * D₁ x
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      · intro a
        change D₁ (algebraMap S L (algebraMap A S a)) = 0
        rw [← IsScalarTower.algebraMap_apply A S L, Derivation.map_algebraMap]
      · intro s
        change l1 (eK.symm (KaehlerDifferential.D A L (algebraMap S L s))) = algebraMap S L (D₀ s)
        rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap A S L s,
          LinearMap.liftBaseChange_one_tmul]
        exact Derivation.liftKaehlerDifferential_comp_D d0_L s

    let _ : Algebra k R := (φ_R.comp MvPolynomial.C).toAlgebra
    have hφ_R_alg : φ_R.comp MvPolynomial.C = algebraMap k R := rfl
    let B_prod := TensorProduct k R A_Z
    let ι_R0 : R →+* B_prod := algebraMap R B_prod
    let ι_Z0 : A_Z →ₐ[k] B_prod := Algebra.TensorProduct.includeRight
    let α_prod : MvPolynomial (Fin 2) A_Z →+* B_prod :=
      MvPolynomial.eval₂Hom ι_Z0.toRingHom (fun b : Fin 2 => ι_R0 (φ_R (MvPolynomial.X b)))
    have hα_prod_et : α_prod.Etale := by
      have h1 := hPolyPushoutEtale 2 A_Z R φ_R hφ_R_alg hφ_R_et
      let comm_eq := (Algebra.TensorProduct.comm k A_Z R).toRingEquiv
      have hcomm_et : comm_eq.toRingHom.Etale := RingHom.Etale.of_bijective comm_eq.bijective
      have hα_eq : α_prod = comm_eq.toRingHom.comp
          (MvPolynomial.eval₂Hom
            (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := A_Z) (B := R))
            (fun b : Fin 2 => (1 : A_Z) ⊗ₜ[k] φ_R (MvPolynomial.X b))) := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [α_prod, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
            Algebra.TensorProduct.includeLeftRingHom_apply, comm_eq,
            RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
            AlgEquiv.coe_ringEquiv, Algebra.TensorProduct.comm_tmul]
          rfl
        · intro b
          simp only [α_prod, MvPolynomial.eval₂Hom_X', RingHom.comp_apply, comm_eq,
            RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
            AlgEquiv.coe_ringEquiv, Algebra.TensorProduct.comm_tmul]
          rfl
      rw [hα_eq]
      exact RingHom.Etale.stableUnderComposition _ _ h1 hcomm_et
    have hα_prod_φ : α_prod.comp (MvPolynomial.map (algebraMap k A_Z)) = ι_R0.comp φ_R := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, MvPolynomial.map_C, α_prod, MvPolynomial.eval₂Hom_C,
          ι_Z0, ι_R0]
        change (1 : R) ⊗ₜ[k] (algebraMap k A_Z c) = (algebraMap k R c) ⊗ₜ[k] (1 : A_Z)
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
      · intro b
        simp [α_prod]
    let t_fn : Fin d → R := fun i => τ_R (MvPolynomial.C (ψ_Z (MvPolynomial.X i)))
    let y_0 : Fin d → B_prod := fun i => (1 : R) ⊗ₜ[k] ψ_Z (MvPolynomial.X i) - ι_R0 (t_fn i)
    let ψ_Y0 : MvPolynomial (Fin d) R →+* B_prod := MvPolynomial.eval₂Hom ι_R0 y_0
    have hψ_Y0_et : ψ_Y0.Etale := by
      have huntrans_et := hPolyPushoutEtale d R A_Z ψ_Z hψ_alg hψ_et
      let T_shift : MvPolynomial (Fin d) R →+* MvPolynomial (Fin d) R :=
        MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i - MvPolynomial.C (t_fn i))
      let T_inv : MvPolynomial (Fin d) R →+* MvPolynomial (Fin d) R :=
        MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i + MvPolynomial.C (t_fn i))
      have hT1 : T_inv.comp T_shift = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp [T_shift, T_inv]
        · intro i; simp [T_shift, T_inv]
      have hT2 : T_shift.comp T_inv = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp [T_shift, T_inv]
        · intro i; simp [T_shift, T_inv]
      have hT_bij : Function.Bijective T_shift := by
        refine ⟨fun x y hxy => ?_, fun y => ⟨T_inv y, RingHom.congr_fun hT2 y⟩⟩
        have h := congrArg T_inv hxy
        exact (RingHom.congr_fun hT1 x).symm.trans (h.trans (RingHom.congr_fun hT1 y))
      have hψ_eq : ψ_Y0 = (MvPolynomial.eval₂Hom
          (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := R) (B := A_Z))
          (fun i : Fin d => (1 : R) ⊗ₜ[k] ψ_Z (MvPolynomial.X i))).comp T_shift := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [ψ_Y0, T_shift, RingHom.comp_apply, MvPolynomial.eval₂Hom_C,
            Algebra.TensorProduct.includeLeftRingHom_apply]
          rfl
        · intro i
          simp only [ψ_Y0, T_shift, RingHom.comp_apply, MvPolynomial.eval₂Hom_X',
            map_sub, MvPolynomial.eval₂Hom_C, Algebra.TensorProduct.includeLeftRingHom_apply, y_0]
          rfl
      rw [hψ_eq]
      exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hT_bij) huntrans_et
    let τ_Z : A_Z →ₐ[k] R :=
      { τ_R.comp MvPolynomial.C with
        commutes' := fun c => by
          change τ_R (MvPolynomial.C (algebraMap k A_Z c)) = φ_R (MvPolynomial.C c)
          rw [← MvPolynomial.map_C]
          exact RingHom.congr_fun hτ_R (MvPolynomial.C c) }
    let σ_0_k : B_prod →ₐ[k] R := Algebra.TensorProduct.productMap (AlgHom.id k R) τ_Z
    let σ_0 : B_prod →ₐ[R] R :=
      { σ_0_k.toRingHom with
        commutes' := fun r => by
          change σ_0_k (r ⊗ₜ[k] 1) = r
          change r * τ_Z 1 = r
          rw [map_one, mul_one] }
    have hσ_0_α : σ_0.toRingHom.comp α_prod = τ_R := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, α_prod, MvPolynomial.eval₂Hom_C, ι_Z0]
        change σ_0_k (1 ⊗ₜ[k] a) = τ_R (MvPolynomial.C a)
        change 1 * τ_Z a = τ_R (MvPolynomial.C a)
        exact one_mul _
      · intro b
        simp only [RingHom.comp_apply, α_prod, MvPolynomial.eval₂Hom_X', ι_R0]
        change σ_0_k (φ_R (MvPolynomial.X b) ⊗ₜ[k] 1) = τ_R (MvPolynomial.X b)
        change φ_R (MvPolynomial.X b) * τ_Z 1 = τ_R (MvPolynomial.X b)
        rw [map_one, mul_one, ← RingHom.congr_fun hτ_R (MvPolynomial.X b),
          RingHom.comp_apply, MvPolynomial.map_X]
    have hy_0_ker : ∀ i : Fin d, σ_0 (y_0 i) = 0 := by
      intro i
      change σ_0_k ((1 : R) ⊗ₜ[k] ψ_Z (MvPolynomial.X i) - (t_fn i) ⊗ₜ[k] 1) = 0
      rw [map_sub]
      change 1 * t_fn i - t_fn i * τ_Z 1 = 0
      rw [map_one, one_mul, mul_one, sub_self]
    let I_Y : Ideal B_prod := Ideal.span (Set.range y_0)
    have hI_Y_ker : ∀ x ∈ I_Y, σ_0 x = 0 := by
      have hle : I_Y ≤ RingHom.ker σ_0.toRingHom := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        exact hy_0_ker i
      exact fun x hx => hle hx
    let B_bar := B_prod ⧸ I_Y
    have _ : Algebra.Etale R B_bar := hQuotZeroEtale d R B_prod y_0 hψ_Y0_et
    let bar_σ0 : B_bar →ₐ[R] R :=
      { Ideal.Quotient.lift I_Y σ_0.toRingHom hI_Y_ker with
        commutes' := fun r => by
          rw [IsScalarTower.algebraMap_apply R B_prod B_bar]
          exact σ_0.commutes r }
    obtain ⟨bar_f, hbar_f_one, hbar_f_ann⟩ := hAnn R B_bar bar_σ0
    obtain ⟨f_diag, hf_mk⟩ := Ideal.Quotient.mk_surjective bar_f
    have hf_one : σ_0 f_diag = 1 := by
      have h1 : bar_σ0 (Ideal.Quotient.mk I_Y f_diag) = σ_0 f_diag := rfl
      rw [← h1, hf_mk, hbar_f_one]
    have hf_ann : ∀ x : B_prod, σ_0 x = 0 → f_diag * x ∈ I_Y := by
      intro x hx
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [map_mul, hf_mk]
      apply hbar_f_ann
      exact hx
    let B_1_ring := Localization.Away f_diag
    let B_1 : CommRingCat.{u} := CommRingCat.of B_1_ring
    let ι_loc : B_prod →+* B_1_ring := algebraMap B_prod B_1_ring
    have hι_loc_et : ι_loc.Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway f_diag)
    let α_1 : MvPolynomial (Fin 2) A_Z →+* B_1 := ι_loc.comp α_prod
    let ι_R1 : R →+* B_1 := ι_loc.comp ι_R0
    let y_1 : Fin d → B_1 := fun i => ι_loc (y_0 i)
    have hα_1_et : α_1.Etale := RingHom.Etale.stableUnderComposition _ _ hα_prod_et hι_loc_et
    have hψ_Y1_et : (MvPolynomial.eval₂Hom ι_R1 y_1).Etale := by
      have heq : MvPolynomial.eval₂Hom ι_R1 y_1 = ι_loc.comp ψ_Y0 := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp [ι_R1, ψ_Y0]
        · intro i; simp [y_1, ψ_Y0]
      rw [heq]
      exact RingHom.Etale.stableUnderComposition _ _ hψ_Y0_et hι_loc_et
    have hUnit_σf : IsUnit (σ_0.toRingHom f_diag) := by
      change IsUnit (σ_0 f_diag)
      rw [hf_one]
      exact isUnit_one
    let σ_1 : B_1 →+* R := IsLocalization.Away.lift (S := B_1_ring) f_diag hUnit_σf
    have hσ_1_loc : ∀ b : B_prod, σ_1 (ι_loc b) = σ_0 b := fun b =>
      IsLocalization.Away.lift_eq (S := B_1_ring) f_diag hUnit_σf b
    have hσ_ι : σ_1.comp ι_R1 = RingHom.id R := by
      refine RingHom.ext fun r => ?_
      change σ_1 (ι_loc (algebraMap R B_prod r)) = r
      rw [hσ_1_loc, σ_0.commutes]
      rfl
    have hσ_α : σ_1.comp α_1 = τ_R := by
      refine RingHom.ext fun F => ?_
      change σ_1 (ι_loc (α_prod F)) = τ_R F
      rw [hσ_1_loc]
      exact RingHom.congr_fun hσ_0_α F
    have hα_φ : α_1.comp (MvPolynomial.map (algebraMap k A_Z)) = ι_R1.comp φ_R := by
      refine RingHom.ext fun p => ?_
      change ι_loc (α_prod (MvPolynomial.map (algebraMap k A_Z) p)) = ι_loc (ι_R0 (φ_R p))
      exact congrArg ι_loc (RingHom.congr_fun hα_prod_φ p)
    have hker_σ1 : RingHom.ker σ_1 = Ideal.span (Set.range y_1) := by
      refine le_antisymm ?_ ?_
      · intro w hw
        let w0 : B_1_ring := w
        have hsec := IsLocalization.Away.sec_spec (S := B_1_ring) f_diag w0
        set b := (IsLocalization.Away.sec (S := B_1_ring) f_diag w0).1
        set n := (IsLocalization.Away.sec (S := B_1_ring) f_diag w0).2
        have hsec' : w * ι_loc f_diag ^ n = ι_loc b := by
          change w0 * (algebraMap B_prod B_1_ring f_diag) ^ n = algebraMap B_prod B_1_ring b
          rw [← map_pow]
          exact hsec
        have hb_ker : σ_0 b = 0 := by
          have h1 := congrArg σ_1 hsec'
          have hw0 : σ_1 w = 0 := hw
          rw [map_mul, map_pow, hσ_1_loc f_diag, hf_one, one_pow, mul_one, hw0, hσ_1_loc b] at h1
          exact h1.symm
        have hfb_mem : f_diag * b ∈ I_Y := hf_ann b hb_ker
        have hmap_IY : Ideal.map ι_loc I_Y = Ideal.span (Set.range y_1) := by
          dsimp [I_Y, y_1]
          rw [Ideal.map_span]
          congr 1
          ext z
          simp
        have hloc_mem : ι_loc f_diag * ι_loc b ∈ Ideal.span (Set.range y_1) := by
          rw [← map_mul, ← hmap_IY]
          exact Ideal.mem_map_of_mem ι_loc hfb_mem
        have hwn1_mem : w * ι_loc f_diag ^ (n + 1) ∈ Ideal.span (Set.range y_1) := by
          have heq : w * ι_loc f_diag ^ (n + 1) = ι_loc f_diag * (w * ι_loc f_diag ^ n) := by ring
          rw [heq, hsec']
          exact hloc_mem
        have hUnit_loc : IsUnit (ι_loc f_diag ^ (n + 1)) :=
          (IsLocalization.Away.algebraMap_isUnit (S := B_1_ring) f_diag).pow (n + 1)
        let u_inv : B_1 := ↑(hUnit_loc.unit⁻¹)
        have hu_mul : ι_loc f_diag ^ (n + 1) * u_inv = 1 := IsUnit.mul_val_inv hUnit_loc
        have hw_eq : w = (w * ι_loc f_diag ^ (n + 1)) * u_inv := by
          rw [mul_assoc, hu_mul, mul_one]
        rw [hw_eq]
        exact (Ideal.span (Set.range y_1)).mul_mem_right u_inv hwn1_mem
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        change σ_1 (ι_loc (y_0 i)) = 0
        rw [hσ_1_loc]
        exact hy_0_ker i
    have hD0 : ∀ j : Fin d, ∃ D₀ : Derivation R B_prod B_prod,
        ∀ (r : R) (a : A_Z), D₀ (r ⊗ₜ[k] a) = r ⊗ₜ[k] der_Z j a := by
      intro j
      let fk : B_prod →ₗ[k] B_prod := LinearMap.lTensor R (der_Z j).toLinearMap
      have hfk_smul : ∀ (r₀ : R) (x : B_prod), fk (r₀ • x) = r₀ • fk x := by
        intro r₀ x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul r a =>
          rw [Algebra.smul_def, Algebra.smul_def, Algebra.TensorProduct.algebraMap_apply,
            Algebra.algebraMap_self, RingHom.id_apply,
            Algebra.TensorProduct.tmul_mul_tmul, one_mul]
          change (r₀ * r) ⊗ₜ[k] der_Z j a = (r₀ ⊗ₜ[k] 1) * (r ⊗ₜ[k] der_Z j a)
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        | add x₁ x₂ ih₁ ih₂ =>
          rw [smul_add, map_add, map_add, smul_add, ih₁, ih₂]
      let fR : B_prod →ₗ[R] B_prod :=
        { toFun := fk
          map_add' := fk.map_add
          map_smul' := hfk_smul }
      have hfk_leib : ∀ x y : B_prod, fk (x * y) = x • fk y + y • fk x := by
        intro x y
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul r₁ a₁ =>
          induction y using TensorProduct.induction_on with
          | zero => simp
          | tmul r₂ a₂ =>
            rw [smul_eq_mul, smul_eq_mul, Algebra.TensorProduct.tmul_mul_tmul]
            change (r₁ * r₂) ⊗ₜ[k] der_Z j (a₁ * a₂) =
              (r₁ ⊗ₜ[k] a₁) * (r₂ ⊗ₜ[k] der_Z j a₂) + (r₂ ⊗ₜ[k] a₂) * (r₁ ⊗ₜ[k] der_Z j a₁)
            rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, TensorProduct.tmul_add,
              Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
              mul_comm r₂ r₁]
          | add y₁ y₂ ihy₁ ihy₂ =>
            rw [mul_add, map_add, map_add, smul_add, add_smul, ihy₁, ihy₂]
            abel
        | add x₁ x₂ ihx₁ ihx₂ =>
          rw [add_mul, map_add, map_add, add_smul, smul_add, ihx₁, ihx₂]
          abel
      refine ⟨{ toLinearMap := fR
                map_one_eq_zero' := by
                  change (1 : R) ⊗ₜ[k] der_Z j 1 = 0
                  rw [Derivation.map_one_eq_zero, TensorProduct.tmul_zero]
                leibniz' := hfk_leib }, fun r a => rfl⟩
    choose D_0 hD_0_tmul using hD0
    choose D_1_raw hD_1_leib_raw hD_1_R_raw hD_1_loc using
      fun j : Fin d => hLiftLocDer R B_prod f_diag (D_0 j)
    let D_1 : Fin d → (B_1 →+ B_1) := fun j =>
      { toFun := fun x => D_1_raw j x
        map_zero' := (D_1_raw j).map_zero
        map_add' := fun x y => (D_1_raw j).map_add x y }
    refine ⟨B_1, α_1, ι_R1, σ_1, y_1, D_1, hα_1_et, hψ_Y1_et, hσ_ι, hσ_α, hα_φ, hker_σ1,
      fun j x y => hD_1_leib_raw j x y, fun j r => hD_1_R_raw j r, ?_, ?_⟩
    · intro j i
      change D_1_raw j (algebraMap B_prod B_1_ring (y_0 i)) = if j = i then 1 else 0
      rw [hD_1_loc j (y_0 i)]
      dsimp [y_0, ι_R0]
      rw [map_sub, hD_0_tmul j 1 (ψ_Z (MvPolynomial.X i)),
        Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        hD_0_tmul j (t_fn i) 1,
        Derivation.map_one_eq_zero, TensorProduct.tmul_zero, sub_zero,
        hder_Z j (MvPolynomial.X i), MvPolynomial.pderiv_X]
      by_cases hji : j = i
      · subst hji
        simp only [↓reduceIte, Pi.single_eq_same, map_one]
        exact map_one (algebraMap B_prod (Localization.Away f_diag))
      · have hij : i ≠ j := fun h => hji h.symm
        simp [hji, hij]
    · intro j F
      have hD_leib : ∀ x y : B_1, D_1 j (x * y) = x * D_1 j y + y * D_1 j x :=
        fun x y => hD_1_leib_raw j x y
      have hD_R : ∀ r : R, D_1 j (ι_R1 r) = 0 := fun r => hD_1_R_raw j r
      have hmon : ∀ (m : Fin 2 →₀ ℕ) (a : A_Z),
          D_1 j (α_1 (MvPolynomial.monomial m a)) = α_1 (MvPolynomial.monomial m (der_Z j a)) := by
        intro m a
        have hsplit_m : (MvPolynomial.monomial m a : MvPolynomial (Fin 2) A_Z) =
            MvPolynomial.C a * MvPolynomial.map (algebraMap k A_Z) (MvPolynomial.monomial m (1 : k)) := by
          rw [MvPolynomial.map_monomial, map_one, MvPolynomial.C_mul_monomial, mul_one]
        have hα_m1 : α_1 (MvPolynomial.map (algebraMap k A_Z) (MvPolynomial.monomial m (1 : k))) =
            ι_R1 (φ_R (MvPolynomial.monomial m (1 : k))) :=
          RingHom.congr_fun hα_φ (MvPolynomial.monomial m (1 : k))
        have hD_R1 : D_1 j (ι_R1 (φ_R (MvPolynomial.monomial m (1 : k)))) = 0 :=
          hD_R (φ_R (MvPolynomial.monomial m (1 : k)))
        have hD_Ca : D_1 j (α_1 (MvPolynomial.C a)) = α_1 (MvPolynomial.C (der_Z j a)) := by
          simp only [α_1, α_prod, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, ι_Z0]
          change D_1_raw j (algebraMap B_prod B_1_ring (1 ⊗ₜ[k] a)) =
            algebraMap B_prod B_1_ring (1 ⊗ₜ[k] der_Z j a)
          rw [hD_1_loc j (1 ⊗ₜ[k] a), hD_0_tmul j 1 a]
        have hsplit_der : (MvPolynomial.monomial m (der_Z j a) : MvPolynomial (Fin 2) A_Z) =
            MvPolynomial.C (der_Z j a) *
              MvPolynomial.map (algebraMap k A_Z) (MvPolynomial.monomial m (1 : k)) := by
          rw [MvPolynomial.map_monomial, map_one, MvPolynomial.C_mul_monomial, mul_one]
        rw [hsplit_m, map_mul, hα_m1, hD_leib, hD_R1, mul_zero, zero_add, hD_Ca,
          hsplit_der, map_mul, hα_m1, mul_comm]
      conv_lhs => rw [MvPolynomial.as_sum F]
      rw [map_sum, map_sum, weilMvPolyMapCoeffs, map_sum]
      exact Finset.sum_congr rfl fun m _ => hmon m (F.coeff m)

  have hPart5 : ∀ (m_d : ℕ) (R B_1 : Type u) [CommRing R] [CommRing B_1]
      (σ_1 : B_1 →+* R) (y_1 : Fin m_d → B_1),
      RingHom.ker σ_1 = Ideal.span (Set.range y_1) →
      ∀ (D_1 : Fin m_d → (B_1 →+ B_1)),
        (∀ (j : Fin m_d) (x y : B_1), D_1 j (x * y) = x * D_1 j y + y * D_1 j x) →
        (∀ j i : Fin m_d, D_1 j (y_1 i) = if j = i then 1 else 0) →
        ∀ (F_diff : B_1),
          σ_1 F_diff = 0 →
          (∀ a : Fin m_d, σ_1 (D_1 a F_diff) = 0) →
          ∃ (Q_hat : Fin m_d → Fin m_d → B_1),
            (∀ i j : Fin m_d, j < i → Q_hat i j = 0) ∧
            F_diff = ∑ i : Fin m_d, ∑ j : Fin m_d, Q_hat i j * y_1 i * y_1 j ∧
            (∀ a b : Fin m_d,
              (if a = b then 2 * σ_1 (Q_hat a a)
               else if a < b then σ_1 (Q_hat a b)
               else σ_1 (Q_hat b a)) = σ_1 (D_1 b (D_1 a F_diff))) := by
    intro m_d R B_1 _ _ σ_1 y_1 hker_σ1 D_1 hD_leib hD_y F_diff hF_zero hdF_zero
    have hy1_zero : ∀ i : Fin m_d, σ_1 (y_1 i) = 0 := by
      intro i
      change y_1 i ∈ RingHom.ker σ_1
      rw [hker_σ1]
      exact Ideal.subset_span (Set.mem_range_self i)
    have hF_mem : F_diff ∈ Ideal.span (Set.range y_1) := by
      rw [← hker_σ1]
      exact hF_zero
    obtain ⟨g, hg_sum⟩ := (Submodule.mem_span_range_iff_exists_fun B_1).mp hF_mem
    simp only [smul_eq_mul] at hg_sum
    have hg_ker : ∀ a : Fin m_d, g a ∈ Ideal.span (Set.range y_1) := by
      intro a
      rw [← hker_σ1]
      change σ_1 (g a) = 0
      have h1 : σ_1 (D_1 a F_diff) = σ_1 (g a) := by
        rw [← hg_sum, map_sum, map_sum]
        have hterm : ∀ i : Fin m_d, σ_1 (D_1 a (g i * y_1 i)) = if a = i then σ_1 (g i) else 0 := by
          intro i
          rw [hD_leib, map_add, map_mul, map_mul,
            hy1_zero i, zero_mul, add_zero, hD_y a i]
          split_ifs <;> simp
        simp_rw [hterm]
        rw [Finset.sum_eq_single a (fun i _ hia => ite_eq_right_iff.mpr fun h => absurd h.symm hia)
          (fun h => absurd (Finset.mem_univ a) h)]
        simp
      exact h1.symm.trans (hdF_zero a)
    choose H hH using fun i : Fin m_d => (Submodule.mem_span_range_iff_exists_fun B_1).mp (hg_ker i)
    have hH_sum : ∀ i : Fin m_d, ∑ j : Fin m_d, H i j * y_1 j = g i := by
      intro i
      simpa only [smul_eq_mul] using hH i
    have hF_H : F_diff = ∑ i : Fin m_d, ∑ j : Fin m_d, H i j * y_1 i * y_1 j := by
      rw [← hg_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← hH_sum i, Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      ring
    let Q_hat : Fin m_d → Fin m_d → B_1 := fun i j =>
      if j < i then 0 else if i = j then H i i else H i j + H j i
    have hQ_tri : ∀ i j : Fin m_d, j < i → Q_hat i j = 0 := by
      intro i j hij
      simp [Q_hat, hij]
    have hF_Q : F_diff = ∑ i : Fin m_d, ∑ j : Fin m_d, Q_hat i j * y_1 i * y_1 j := by
      rw [hF_H]
      have hsplit : (∑ i : Fin m_d, ∑ j : Fin m_d, H i j * y_1 i * y_1 j) =
          (∑ i : Fin m_d, ∑ j : Fin m_d, if j < i then 0 else H i j * y_1 i * y_1 j) +
          (∑ i : Fin m_d, ∑ j : Fin m_d, if j < i then H i j * y_1 i * y_1 j else 0) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        by_cases hji : j < i <;> simp [hji]
      have hswap : (∑ i : Fin m_d, ∑ j : Fin m_d, if j < i then H i j * y_1 i * y_1 j else 0) =
          ∑ i : Fin m_d, ∑ j : Fin m_d, if i < j then H j i * y_1 j * y_1 i else 0 :=
        Finset.sum_comm
      rw [hsplit, hswap, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      dsimp [Q_hat]
      rcases lt_trichotomy i j with hij | rfl | hji
      · have hnot_ji : ¬ j < i := lt_asymm hij
        have hne : i ≠ j := ne_of_lt hij
        simp only [hnot_ji, ↓reduceIte, hne, hij]
        ring
      · have hnot : ¬ i < i := lt_irrefl i
        simp only [hnot, ↓reduceIte, add_zero]
      · have hnot_ij : ¬ i < j := lt_asymm hji
        simp only [hji, ↓reduceIte, hnot_ij, add_zero, zero_mul]
    refine ⟨Q_hat, hQ_tri, hF_Q, ?_⟩
    intro a b
    have hquad_term : ∀ (q : B_1) (i j : Fin m_d),
        σ_1 (D_1 b (D_1 a (q * y_1 i * y_1 j))) =
          (if b = i ∧ a = j then σ_1 q else 0) + (if b = j ∧ a = i then σ_1 q else 0) := by
      intro q i j
      have h1 : D_1 a (q * y_1 i * y_1 j) =
          (if a = j then q * y_1 i else 0) +
          (if a = i then q * y_1 j else 0) +
          y_1 i * (y_1 j * D_1 a q) := by
        rw [hD_leib, hD_leib, hD_y a j, hD_y a i]
        split_ifs <;> simp <;> ring
      have h2_first : ∀ (s : Fin m_d) (p : Prop) [Decidable p],
          σ_1 (D_1 b (if p then q * y_1 s else 0)) = if b = s ∧ p then σ_1 q else 0 := by
        intro s p _
        by_cases hp : p
        · simp only [hp, ↓reduceIte, and_true]
          rw [hD_leib, map_add, map_mul, map_mul,
            hy1_zero s, zero_mul, add_zero, hD_y b s]
          by_cases hbs : b = s <;> simp [hbs]
        · simp [hp]
      have h2_rem : σ_1 (D_1 b (y_1 i * (y_1 j * D_1 a q))) = 0 := by
        rw [hD_leib, map_add, map_mul σ_1, map_mul σ_1, map_mul σ_1,
          hy1_zero i, hy1_zero j, zero_mul, zero_mul, zero_mul, add_zero]
      rw [h1, map_add, map_add, map_add, map_add, h2_first i (a = j), h2_first j (a = i),
        h2_rem, add_zero]
    have hrhs : σ_1 (D_1 b (D_1 a F_diff)) = σ_1 (Q_hat b a) + σ_1 (Q_hat a b) := by
      rw [hF_Q, map_sum, map_sum, map_sum]
      have hinner : ∀ i : Fin m_d,
          σ_1 (D_1 b (D_1 a (∑ j : Fin m_d, Q_hat i j * y_1 i * y_1 j))) =
            (if b = i then σ_1 (Q_hat i a) else 0) + σ_1 (Q_hat i b) * (if a = i then 1 else 0) := by
        intro i
        rw [map_sum, map_sum, map_sum]
        simp_rw [hquad_term _ i _]
        rw [Finset.sum_add_distrib]
        congr 1
        · rw [Finset.sum_eq_single a
            (fun j _ hja => by simp [hja.symm])
            (fun h => absurd (Finset.mem_univ a) h)]
          by_cases hbi : b = i <;> simp [hbi]
        · rw [Finset.sum_eq_single b
            (fun j _ hjb => by simp [hjb.symm])
            (fun h => absurd (Finset.mem_univ b) h)]
          by_cases hai : a = i <;> simp [hai]
      simp_rw [hinner]
      rw [Finset.sum_add_distrib]
      congr 1
      · rw [Finset.sum_eq_single b
          (fun i _ hib => by simp [hib.symm])
          (fun h => absurd (Finset.mem_univ b) h)]
        simp
      · rw [Finset.sum_eq_single a
          (fun i _ hia => by simp [hia.symm])
          (fun h => absurd (Finset.mem_univ a) h)]
        simp
    rw [hrhs]
    by_cases hab : a = b
    · subst hab
      simp [two_mul]
    · by_cases hlt : a < b
      · simp only [hab, ↓reduceIte, hlt]
        rw [hQ_tri b a hlt, map_zero, zero_add]
      · simp only [hab, ↓reduceIte, hlt]
        have hba : b < a := lt_of_le_of_ne (not_lt.mp hlt) (Ne.symm hab)
        rw [hQ_tri a b hba, map_zero, add_zero]

  refine ⟨?_, ?_, ?_⟩
  · intro ε_z _ hε_id ψ_Z hψ_alg hψ_ker der_Z hder_Z Q hQ ℓ_0 hℓ0_jet
    have hε_ψ : ε_z.comp ψ_Z = MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change ε_z (ψ_Z (MvPolynomial.C c)) = MvPolynomial.constantCoeff (MvPolynomial.C c)
        have h1 : ψ_Z (MvPolynomial.C c) = algebraMap k A_Z c := RingHom.congr_fun hψ_alg c
        have h2 : ε_z (algebraMap k A_Z c) = c := RingHom.congr_fun hε_id c
        rw [h1, h2, MvPolynomial.constantCoeff_C]
      · intro i
        change ε_z (ψ_Z (MvPolynomial.X i)) = MvPolynomial.constantCoeff (MvPolynomial.X i)
        have hi : ε_z (ψ_Z (MvPolynomial.X i)) = 0 := hψ_ker i
        rw [hi, MvPolynomial.constantCoeff_X]
    have hε_ψ_apply : ∀ f : MvPolynomial (Fin d) k, ε_z (ψ_Z f) = MvPolynomial.constantCoeff f :=
      fun f => RingHom.congr_fun hε_ψ f
    have hQ_hom : Q.IsHomogeneous 2 := (MvPolynomial.mem_homogeneousSubmodule 2 Q).mp hQ
    have hQ_eval0 : ε_z (ψ_Z Q) = 0 := by
      rw [hε_ψ_apply, MvPolynomial.constantCoeff_eq]
      exact hQ_hom.coeff_eq_zero (by simp)
    have hQ_eval1 : ∀ i : Fin d, ε_z (der_Z i (ψ_Z Q)) = 0 := by
      intro i
      rw [hder_Z, hε_ψ_apply, MvPolynomial.constantCoeff_eq, MvPolynomial.coeff_pderiv, zero_add]
      have hc0 : Q.coeff (Finsupp.single i 1) = 0 := by
        apply hQ_hom.coeff_eq_zero
        simp [Finsupp.degree_single]
      rw [hc0, zero_mul]
    have hQ_eval2 : ∀ i j : Fin d,
        ε_z (der_Z j (der_Z i (ψ_Z Q))) =
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q)) := by
      intro i j
      rw [hder_Z, hder_Z, hε_ψ_apply]
    let p_z : Ideal A_Z := RingHom.ker ε_z
    let L_z := Localization.AtPrime p_z
    let r : A_Z := ℓ_0 - ψ_Z Q
    have hmax3 : (IsLocalRing.maximalIdeal L_z) ^ 3 = Ideal.map (algebraMap A_Z L_z) (p_z ^ 3) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_z L_z, Ideal.map_pow]
    have hr_map : algebraMap A_Z L_z r ∈ Ideal.map (algebraMap A_Z L_z) (p_z ^ 3) := by
      rwa [← hmax3]
    obtain ⟨s, hs_compl, hsr_mem⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff p_z.primeCompl L_z (p_z ^ 3) r).mp hr_map
    have hs_ne : ε_z s ≠ 0 := hs_compl
    have hDer2 : ∀ (D : Derivation k A_Z A_Z) {x : A_Z}, x ∈ p_z ^ 2 → D x ∈ p_z := by
      intro D x hx
      rw [sq] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        exact p_z.add_mem (p_z.mul_mem_right _ ha) (p_z.mul_mem_right _ hb)
      · intro x₁ x₂ hx₁ hx₂
        rw [map_add]
        exact p_z.add_mem hx₁ hx₂
    have hDer3 : ∀ (D : Derivation k A_Z A_Z) {x : A_Z}, x ∈ p_z ^ 3 → D x ∈ p_z ^ 2 := by
      intro D x hx
      rw [pow_succ p_z 2] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        refine (p_z ^ 2).add_mem ((p_z ^ 2).mul_mem_right _ ha) ?_
        rw [sq]
        exact Ideal.mul_mem_mul hb (hDer2 D ha)
      · intro x₁ x₂ hx₁ hx₂
        rw [map_add]
        exact (p_z ^ 2).add_mem hx₁ hx₂
    have hr_ker : ε_z r = 0 := by
      have h1 : s * r ∈ p_z := Ideal.pow_le_self (by decide : 3 ≠ 0) (by simpa [mul_comm] using hsr_mem)
      change ε_z (s * r) = 0 at h1
      rw [map_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left hs_ne
    have hdr_ker : ∀ i : Fin d, ε_z (der_Z i r) = 0 := by
      intro i
