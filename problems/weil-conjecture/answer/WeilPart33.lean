      (fun a p => Prod.ext (mul_zero (π₀ a)).symm rfl)
  letI : CommRing E₀ := hCR₀
  have : IsReduced E₀ := hRed₀
  letI : CommRing E₁ := hCR₁
  have : IsReduced E₁ := hRed₁
  letI : Algebra A_node (E₀ × E₁) :=
    ((RingHom.prod h₀ h₁).comp (algebraMap A_node D)).toAlgebra
  let g_prod : P₁ × P₁ →ₐ[A_node] E₀ × E₁ :=
    ⟨RingHom.prod (g₀.comp (RingHom.fst P₁ P₁)) (g₁.comp (RingHom.snd P₁ P₁)),
      fun a => Prod.ext (hcomm₀ a) (hcomm₁ a)⟩
  let h_prod : D →ₐ[A_node] E₀ × E₁ := ⟨RingHom.prod h₀ h₁, fun _ => rfl⟩
  let Φ_W : W →+* E₀ × E₁ := (Algebra.TensorProduct.productMap g_prod h_prod).toRingHom
  let Ψ_W : E₀ × E₁ →+ W :=
    ψ₀.comp (AddMonoidHom.fst E₀ E₁) + ψ₁.comp (AddMonoidHom.snd E₀ E₁)
  have hLeftInv : ∀ w : W, Ψ_W (Φ_W w) = w := by
    intro w
    refine TensorProduct.induction_on (motive := fun w => Ψ_W (Φ_W w) = w)
      w ?_ (fun p d => ?_) (fun w₁ w₂ ih₁ ih₂ => ?_)
    · rw [map_zero, map_zero]
    · rcases p with ⟨p₀, p₁⟩
      change ψ₀ (g₀ p₀ * h₀ d) + ψ₁ (g₁ p₁ * h₁ d) = (p₀, p₁) ⊗ₜ[A_node] d
      rw [hψ₀ p₀ d, hψ₁ p₁ d, ← TensorProduct.add_tmul]
      change (p₀ + 0, 0 + p₁) ⊗ₜ[A_node] d = (p₀, p₁) ⊗ₜ[A_node] d
      rw [add_zero, zero_add]
    · rw [map_add, map_add, ih₁, ih₂]
  have hΦ_inj : Function.Injective Φ_W := Function.LeftInverse.injective hLeftInv
  have : IsReduced D := isReduced_of_injective (Φ_W.comp ι_D) (hΦ_inj.comp hιD_inj)
  exact instIsReducedLocalization q.primeCompl⟩

 have lemma_s3_cone_presentations :
    (∀ (m : ℕ), 1 ≤ m →
      IsDomain (MvPolynomial (Fin (m + 1) × Fin 2) k ⧸
        Ideal.span ({∑ j : Fin (m + 1),
          MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))} :
          Set (MvPolynomial (Fin (m + 1) × Fin 2) k)))) ∧
    (let A_cone1 := MvPolynomial (Fin (1 + 1) × Fin 2) k ⧸
        Ideal.span ({∑ j : Fin (1 + 1),
          MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))} :
          Set (MvPolynomial (Fin (1 + 1) × Fin 2) k))
      let ϖ₀ : A_cone1 := Ideal.Quotient.mk _
        (MvPolynomial.X ((1 : Fin 2), (0 : Fin 2)) -
          MvPolynomial.X ((0 : Fin 2), (0 : Fin 2)) -
          MvPolynomial.X ((0 : Fin 2), (1 : Fin 2)))
      let B₂ := MvPolynomial (Fin 3) k ⧸
        Ideal.span ({MvPolynomial.X (0 : Fin 3) * MvPolynomial.X (1 : Fin 3) -
          MvPolynomial.X (2 : Fin 3) ^ 2} : Set (MvPolynomial (Fin 3) k))
      ∃ α : A_cone1 →+* B₂,
        ϖ₀ ≠ 0 ∧
        Function.Surjective α ∧
        RingHom.ker α = Ideal.span ({ϖ₀} : Set A_cone1) ∧
        α (Ideal.Quotient.mk _ (MvPolynomial.X ((0 : Fin 2), (0 : Fin 2)) +
          MvPolynomial.X ((1 : Fin 2), (1 : Fin 2)))) =
          Ideal.Quotient.mk _ (MvPolynomial.X (0 : Fin 3)) ∧
        α (Ideal.Quotient.mk _ (MvPolynomial.X ((0 : Fin 2), (1 : Fin 2)) +
          MvPolynomial.X ((1 : Fin 2), (1 : Fin 2)))) =
          Ideal.Quotient.mk _ (MvPolynomial.X (1 : Fin 3)) ∧
        α (Ideal.Quotient.mk _ (MvPolynomial.X ((1 : Fin 2), (1 : Fin 2)))) =
          Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3))) ∧
    (∀ r : ℕ,
      let A_curr := MvPolynomial (Fin (r + 1) × Fin 2) k ⧸
        Ideal.span ({∑ j : Fin (r + 1),
          MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))} :
          Set (MvPolynomial (Fin (r + 1) × Fin 2) k))
      let A_next := MvPolynomial (Fin (r + 1 + 1) × Fin 2) k ⧸
        Ideal.span ({∑ j : Fin (r + 1 + 1),
          MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))} :
          Set (MvPolynomial (Fin (r + 1 + 1) × Fin 2) k))
      let ϖ₁ : A_next := Ideal.Quotient.mk _ (MvPolynomial.X (Fin.last (r + 1), (1 : Fin 2)))
      ∃ π₁ : A_next →+* Polynomial A_curr,
        ϖ₁ ≠ 0 ∧
        Function.Surjective π₁ ∧
        RingHom.ker π₁ = Ideal.span ({ϖ₁} : Set A_next) ∧
        π₁ (Ideal.Quotient.mk _ (MvPolynomial.X (Fin.last (r + 1), (0 : Fin 2)))) = Polynomial.X ∧
        (∀ idx : Fin (r + 1) × Fin 2,
          π₁ (Ideal.Quotient.mk _ (MvPolynomial.X (idx.1.castSucc, idx.2))) =
            Polynomial.C (Ideal.Quotient.mk _ (MvPolynomial.X idx)))) := by
  refine ⟨?_, ?_, ?_⟩
  · intro m hm
    let R₀ : Type u := MvPolynomial (Fin (m + 1) × Fin 2) k
    let Q_m : R₀ := ∑ j : Fin (m + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))
    let I_m : Ideal R₀ := Ideal.span ({Q_m} : Set R₀)
    let A_cone : Type u := R₀ ⧸ I_m
    let u₀ : R₀ := MvPolynomial.X ((0 : Fin (m + 1)), (0 : Fin 2))
    let v₀ : R₀ := MvPolynomial.X ((0 : Fin (m + 1)), (1 : Fin 2))
    let Q_tail : R₀ :=
      ∑ i : Fin m, MvPolynomial.X (i.succ, (0 : Fin 2)) * MvPolynomial.X (i.succ, (1 : Fin 2))
    have hQm_eq : Q_m = u₀ * v₀ + Q_tail := Fin.sum_univ_succ _
    have h01_ne_00 : ((0 : Fin (m + 1)), (1 : Fin 2)) ≠ ((0 : Fin (m + 1)), (0 : Fin 2)) := by
      intro h
      have h2 : (1 : Fin 2) = (0 : Fin 2) := congrArg Prod.snd h
      exact absurd h2 (by decide)
    have hv₀_ne : v₀ ≠ 0 := MvPolynomial.X_ne_zero _
    have hQtail_ne : Q_tail ≠ 0 := by
      intro h0
      let i₀ : Fin m := ⟨0, hm⟩
      have hev : MvPolynomial.eval
          (fun idx : Fin (m + 1) × Fin 2 => if idx.1 = i₀.succ then (1 : k) else 0) Q_tail = 1 := by
        simp only [Q_tail, map_sum, map_mul, MvPolynomial.eval_X, Fin.succ_inj]
        have hsum : (∑ i : Fin m,
            (if i = i₀ then (1 : k) else 0) * (if i = i₀ then (1 : k) else 0)) =
            ∑ i : Fin m, (if i = i₀ then (1 : k) else 0) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          split_ifs <;> ring
        rw [hsum, Finset.sum_ite_eq']
        simp
      rw [h0, map_zero] at hev
      exact one_ne_zero hev.symm
    let ev0_f : Fin (m + 1) × Fin 2 → R₀ :=
      fun idx => if idx = ((0 : Fin (m + 1)), (1 : Fin 2)) then 0 else MvPolynomial.X idx
    let ev0 : R₀ →+* R₀ := MvPolynomial.eval₂Hom MvPolynomial.C ev0_f
    have hev0_X : ∀ idx, ev0 (MvPolynomial.X idx) = ev0_f idx :=
      fun idx => MvPolynomial.eval₂Hom_X' MvPolynomial.C ev0_f idx
    have hev0_C : ∀ c, ev0 (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C ev0_f c
    have hev0_v0 : ev0 v₀ = 0 := by
      rw [show v₀ = MvPolynomial.X ((0 : Fin (m + 1)), (1 : Fin 2)) from rfl, hev0_X]
      simp [ev0_f]
    have hev0_Qtail : ev0 Q_tail = Q_tail := by
      simp only [Q_tail, map_sum, map_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hne0 : (i.succ, (0 : Fin 2)) ≠ ((0 : Fin (m + 1)), (1 : Fin 2)) :=
        fun h => Fin.succ_ne_zero i (congrArg Prod.fst h)
      have hne1 : (i.succ, (1 : Fin 2)) ≠ ((0 : Fin (m + 1)), (1 : Fin 2)) :=
        fun h => Fin.succ_ne_zero i (congrArg Prod.fst h)
      rw [hev0_X, hev0_X]
      simp [ev0_f, hne0, hne1]
    have hev0_Qm : ev0 Q_m = Q_tail := by
      rw [hQm_eq, map_add, map_mul, hev0_v0, mul_zero, zero_add, hev0_Qtail]
    let I_v0 : Ideal R₀ := Ideal.span ({v₀} : Set R₀)
    have hmk_ev0 : (Ideal.Quotient.mk I_v0).comp ev0 = Ideal.Quotient.mk I_v0 := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        change Ideal.Quotient.mk I_v0 (ev0 (MvPolynomial.C c)) = _
        rw [hev0_C]
        rfl
      · intro idx
        change Ideal.Quotient.mk I_v0 (ev0 (MvPolynomial.X idx)) = Ideal.Quotient.mk I_v0 (MvPolynomial.X idx)
        by_cases h : idx = ((0 : Fin (m + 1)), (1 : Fin 2))
        · subst h
          change Ideal.Quotient.mk I_v0 (ev0 v₀) = Ideal.Quotient.mk I_v0 v₀
          rw [hev0_v0, map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))).symm
        · rw [hev0_X]
          have hf : ev0_f idx = MvPolynomial.X idx := if_neg h
          rw [hf]
    have hv0_reg : ∀ x : A_cone, Ideal.Quotient.mk I_m v₀ * x = 0 → x = 0 := by
      intro x hx
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hx
      obtain ⟨G, hFG⟩ := Ideal.mem_span_singleton.mp hx
      have hev_eq : Q_tail * ev0 G = 0 := by
        have h1 := congrArg ev0 hFG
        rw [map_mul, hev0_v0, zero_mul, map_mul, hev0_Qm] at h1
        exact h1.symm
      have hev0_G : ev0 G = 0 := (mul_eq_zero.mp hev_eq).resolve_left hQtail_ne
      have hG_mem : G ∈ I_v0 := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [← RingHom.congr_fun hmk_ev0 G, RingHom.comp_apply, hev0_G, map_zero]
      obtain ⟨H, hGH⟩ := Ideal.mem_span_singleton.mp hG_mem
      have hFH : F = Q_m * H := by
        apply mul_left_cancel₀ hv₀_ne
        calc v₀ * F = Q_m * G := hFG
          _ = Q_m * (v₀ * H) := by rw [hGH]
          _ = v₀ * (Q_m * H) := by ring
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨H, hFH⟩)
    have hv0_pow_reg : ∀ (N : ℕ) (x : A_cone),
        (Ideal.Quotient.mk I_m v₀) ^ N * x = 0 → x = 0 := by
      intro N
      induction N with
      | zero => intro x hx; simpa using hx
      | succ N ih =>
        intro x hx
        rw [pow_succ', mul_assoc] at hx
        exact ih _ (hv0_reg _ hx)
    let K₀ : Type u := FractionRing R₀
    have hv0_K : algebraMap R₀ K₀ v₀ ≠ 0 :=
      fun h => hv₀_ne (IsFractionRing.injective R₀ K₀ (h.trans (map_zero _).symm))
    let ψ_f : Fin (m + 1) × Fin 2 → K₀ :=
      fun idx =>
        if idx = ((0 : Fin (m + 1)), (0 : Fin 2)) then
          -(algebraMap R₀ K₀ v₀)⁻¹ * algebraMap R₀ K₀ Q_tail
        else algebraMap R₀ K₀ (MvPolynomial.X idx)
    let ψ : R₀ →+* K₀ :=
      MvPolynomial.eval₂Hom ((algebraMap R₀ K₀).comp MvPolynomial.C) ψ_f
    have hψ_X : ∀ idx, ψ (MvPolynomial.X idx) = ψ_f idx :=
      fun idx => MvPolynomial.eval₂Hom_X' _ ψ_f idx
    have hψ_C : ∀ c, ψ (MvPolynomial.C c) = algebraMap R₀ K₀ (MvPolynomial.C c) :=
      fun c => MvPolynomial.eval₂Hom_C _ ψ_f c
    have hψ_u0 : ψ u₀ = -(algebraMap R₀ K₀ v₀)⁻¹ * algebraMap R₀ K₀ Q_tail := by
      rw [show u₀ = MvPolynomial.X ((0 : Fin (m + 1)), (0 : Fin 2)) from rfl, hψ_X]
      simp [ψ_f]
    have hψ_v0 : ψ v₀ = algebraMap R₀ K₀ v₀ := by
      rw [show v₀ = MvPolynomial.X ((0 : Fin (m + 1)), (1 : Fin 2)) from rfl, hψ_X]
      simp [ψ_f, h01_ne_00]
    have hψ_Qtail : ψ Q_tail = algebraMap R₀ K₀ Q_tail := by
      simp only [Q_tail, map_sum, map_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hne0 : (i.succ, (0 : Fin 2)) ≠ ((0 : Fin (m + 1)), (0 : Fin 2)) :=
        fun h => Fin.succ_ne_zero i (congrArg Prod.fst h)
      have hne1 : (i.succ, (1 : Fin 2)) ≠ ((0 : Fin (m + 1)), (0 : Fin 2)) :=
        fun h => Fin.succ_ne_zero i (congrArg Prod.fst h)
      rw [hψ_X, hψ_X]
      simp [ψ_f, hne0, hne1]
    have hker_ψ : I_m ≤ RingHom.ker ψ := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, hQm_eq, map_add, map_mul,
        hψ_u0, hψ_v0, hψ_Qtail]
      calc (-(algebraMap R₀ K₀ v₀)⁻¹ * algebraMap R₀ K₀ Q_tail) * algebraMap R₀ K₀ v₀ +
            algebraMap R₀ K₀ Q_tail
          = -((algebraMap R₀ K₀ v₀)⁻¹ * algebraMap R₀ K₀ v₀) * algebraMap R₀ K₀ Q_tail +
            algebraMap R₀ K₀ Q_tail := by ring
        _ = 0 := by rw [inv_mul_cancel₀ hv0_K]; ring
    let ψ_bar : A_cone →+* K₀ := Ideal.Quotient.lift I_m ψ hker_ψ
    let E₀ : Subring R₀ := RingHom.eqLocus ψ (algebraMap R₀ K₀)
    have hC_E0 : ∀ c : k, MvPolynomial.C c ∈ E₀ := fun c => hψ_C c
    have hX_E0 : ∀ idx : Fin (m + 1) × Fin 2,
        idx ≠ ((0 : Fin (m + 1)), (0 : Fin 2)) → MvPolynomial.X idx ∈ E₀ := fun idx hne => by
      change ψ (MvPolynomial.X idx) = algebraMap R₀ K₀ (MvPolynomial.X idx)
      rw [hψ_X]
      simp [ψ_f, hne]
    have hv0_E0 : v₀ ∈ E₀ := hX_E0 _ h01_ne_00
    have hQtail_E0 : -Q_tail ∈ E₀ :=
      Subring.neg_mem E₀ (Subring.sum_mem E₀ fun i _ =>
        Subring.mul_mem E₀
          (hX_E0 _ (fun h => Fin.succ_ne_zero i (congrArg Prod.fst h)))
          (hX_E0 _ (fun h => Fin.succ_ne_zero i (congrArg Prod.fst h))))
    have hv0_u0_rel : Ideal.Quotient.mk I_m v₀ * Ideal.Quotient.mk I_m u₀ =
        Ideal.Quotient.mk I_m (-Q_tail) := by
      apply sub_eq_zero.mp
      rw [← map_mul, ← map_sub]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      refine Ideal.mem_span_singleton.mpr ⟨1, ?_⟩
      rw [hQm_eq]
      ring
    have hElim : ∀ F : R₀, ∃ (N : ℕ) (F₀ : R₀),
        F₀ ∈ E₀ ∧ (Ideal.Quotient.mk I_m v₀) ^ N * Ideal.Quotient.mk I_m F =
          Ideal.Quotient.mk I_m F₀ := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C c =>
        exact ⟨0, MvPolynomial.C c, hC_E0 c, by simp⟩
      | add p q ihp ihq =>
        obtain ⟨N₁, p₀, hp₀, hp⟩ := ihp
        obtain ⟨N₂, q₀, hq₀, hq⟩ := ihq
        refine ⟨N₁ + N₂, v₀ ^ N₂ * p₀ + v₀ ^ N₁ * q₀,
          Subring.add_mem E₀ (Subring.mul_mem E₀ (Subring.pow_mem E₀ hv0_E0 N₂) hp₀)
            (Subring.mul_mem E₀ (Subring.pow_mem E₀ hv0_E0 N₁) hq₀), ?_⟩
        rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow]
        calc (Ideal.Quotient.mk I_m v₀) ^ (N₁ + N₂) *
              (Ideal.Quotient.mk I_m p + Ideal.Quotient.mk I_m q)
            = (Ideal.Quotient.mk I_m v₀) ^ N₂ * ((Ideal.Quotient.mk I_m v₀) ^ N₁ * Ideal.Quotient.mk I_m p) +
              (Ideal.Quotient.mk I_m v₀) ^ N₁ * ((Ideal.Quotient.mk I_m v₀) ^ N₂ * Ideal.Quotient.mk I_m q) := by ring
          _ = (Ideal.Quotient.mk I_m v₀) ^ N₂ * Ideal.Quotient.mk I_m p₀ +
              (Ideal.Quotient.mk I_m v₀) ^ N₁ * Ideal.Quotient.mk I_m q₀ := by rw [hp, hq]
      | mul_X p idx ihp =>
        obtain ⟨N₁, p₀, hp₀, hp⟩ := ihp
        by_cases hidx : idx = ((0 : Fin (m + 1)), (0 : Fin 2))
        · subst hidx
          refine ⟨N₁ + 1, p₀ * (-Q_tail), Subring.mul_mem E₀ hp₀ hQtail_E0, ?_⟩
          rw [map_mul, map_mul]
          calc (Ideal.Quotient.mk I_m v₀) ^ (N₁ + 1) *
                (Ideal.Quotient.mk I_m p * Ideal.Quotient.mk I_m u₀)
              = ((Ideal.Quotient.mk I_m v₀) ^ N₁ * Ideal.Quotient.mk I_m p) *
                (Ideal.Quotient.mk I_m v₀ * Ideal.Quotient.mk I_m u₀) := by ring
            _ = Ideal.Quotient.mk I_m p₀ * Ideal.Quotient.mk I_m (-Q_tail) := by
                rw [hp, hv0_u0_rel]
        · refine ⟨N₁, p₀ * MvPolynomial.X idx, Subring.mul_mem E₀ hp₀ (hX_E0 idx hidx), ?_⟩
          rw [map_mul, map_mul, ← mul_assoc, hp]
    have hψ_inj : Function.Injective ψ_bar := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro x hx
      rw [Submodule.mem_bot]
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨N, F₀, hF₀_E0, hF₀_eq⟩ := hElim F
      have hK0 : algebraMap R₀ K₀ F₀ = 0 := by
        have h1 : algebraMap R₀ K₀ F₀ = ψ F₀ := hF₀_E0.symm
        rw [h1]
        change ψ_bar (Ideal.Quotient.mk I_m F₀) = 0
        rw [← hF₀_eq, map_mul, RingHom.mem_ker.mp hx, mul_zero]
      have hF0_zero : F₀ = 0 :=
        IsFractionRing.injective R₀ K₀ (hK0.trans (map_zero _).symm)
      rw [hF0_zero, map_zero] at hF₀_eq
      exact hv0_pow_reg N _ hF₀_eq
    exact Function.Injective.isDomain ψ_bar hψ_inj
  · intro A_cone1 ϖ₀ B₂
    let R₁ : Type u := MvPolynomial (Fin (1 + 1) × Fin 2) k
    let Q₁ : R₁ := ∑ j : Fin (1 + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))
    let I₁ : Ideal R₁ := Ideal.span ({Q₁} : Set R₁)
    let w_poly : R₁ :=
      MvPolynomial.X ((1 : Fin 2), (0 : Fin 2)) -
      MvPolynomial.X ((0 : Fin 2), (0 : Fin 2)) -
      MvPolynomial.X ((0 : Fin 2), (1 : Fin 2))
    have hQ1_eq : Q₁ =
        MvPolynomial.X ((0 : Fin 2), (0 : Fin 2)) * MvPolynomial.X ((0 : Fin 2), (1 : Fin 2)) +
        MvPolynomial.X ((1 : Fin 2), (0 : Fin 2)) * MvPolynomial.X ((1 : Fin 2), (1 : Fin 2)) :=
      Fin.sum_univ_two _
    have hϖ₀_ne : ϖ₀ ≠ 0 := by
      intro h0
      let ev_pt_f : Fin (1 + 1) × Fin 2 → k :=
        fun idx => if idx = ((1 : Fin 2), (0 : Fin 2)) then 1 else 0
      let ev_pt : R₁ →+* k := MvPolynomial.eval₂Hom (RingHom.id k) ev_pt_f
      have hev_pt_X : ∀ idx, ev_pt (MvPolynomial.X idx) = ev_pt_f idx :=
        fun idx => MvPolynomial.eval₂Hom_X' _ ev_pt_f idx
      have hker_pt : I₁ ≤ RingHom.ker ev_pt := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, hQ1_eq,
          map_add, map_mul, map_mul, hev_pt_X, hev_pt_X, hev_pt_X, hev_pt_X]
        simp [ev_pt_f]
      have h1 : Ideal.Quotient.lift I₁ ev_pt hker_pt ϖ₀ = 1 := by
        change ev_pt w_poly = 1
        dsimp [w_poly]
        rw [map_sub, map_sub, hev_pt_X, hev_pt_X, hev_pt_X]
        simp [ev_pt_f]
      rw [h0, map_zero] at h1
      exact one_ne_zero h1.symm
    let I_B2 : Ideal (MvPolynomial (Fin 3) k) :=
      Ideal.span ({MvPolynomial.X (0 : Fin 3) * MvPolynomial.X (1 : Fin 3) -
        MvPolynomial.X (2 : Fin 3) ^ 2} : Set (MvPolynomial (Fin 3) k))
    let x : B₂ := Ideal.Quotient.mk I_B2 (MvPolynomial.X 0)
    let y : B₂ := Ideal.Quotient.mk I_B2 (MvPolynomial.X 1)
    let z : B₂ := Ideal.Quotient.mk I_B2 (MvPolynomial.X 2)
    have hxy_rel : x * y - z ^ 2 = 0 := by
      change Ideal.Quotient.mk I_B2 (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.X 2 ^ 2) = 0
