theorem weil_algClosed_singular_rat_fiber_etale_roof_and_isIntegral (k : Type u) [Field k] [IsAlgClosed k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hVer : IsCubicVeroneseEmbeddedOver k m M Z_bar ι_bar)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π₀ : Z_tilde ⟶ Z_bar)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver k 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (hSmStalkDom : ∀ (d : ℕ) (K : Type u) [Field K]
        (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (V : X.Opens) (x : X),
      x ∈ V →
      AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ p_X) →
      IsDomain ↑(X.presheaf.stalk x))
    (hIntOfStalkDom : ∀ (K : Type u) [Field K]
        (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
      AlgebraicGeometry.IsProper p_X →
      ConnectedSpace ↥X →
      (∀ x : X, IsDomain ↑(X.presheaf.stalk x)) →
      AlgebraicGeometry.IsIntegral X)
    (hConeDom : ∀ (m' : ℕ), 1 ≤ m' →
      let A_cone := MvPolynomial (Fin (m' + 1) × Fin 2) k ⧸
        Ideal.span {∑ j : Fin (m' + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))}
      ∀ (D : Type u) [CommRing D] [Algebra A_cone D] [Algebra.Etale A_cone D]
        (q : Ideal D) [q.IsPrime],
        (∀ idx : Fin (m' + 1) × Fin 2,
          algebraMap A_cone D (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ q) →
        IsDomain (Localization.AtPrime q))
    (hNodeRed :
      let A_node := MvPolynomial (Fin 2) k ⧸
        Ideal.span ({MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)} : Set (MvPolynomial (Fin 2) k))
      ∀ (D : Type u) [CommRing D] [Algebra A_node D] [Algebra.Etale A_node D]
        (q : Ideal D) [q.IsPrime],
        IsReduced (Localization.AtPrime q))
    (s_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left)
    (hs_pt : s_pt ≫ (weilProjectiveSpaceOver k 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hConn_pt : ConnectedSpace ↥(CategoryTheory.Limits.pullback f₀.left s_pt))
    (L_pt : MvPolynomial (Fin (M + 1)) k)
    (x_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_tilde.left)
    (hL_homog : L_pt ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (hL_ne : L_pt ≠ 0)
    (hx_sec : x_pt ≫ f₀.left = s_pt)
    (hSm_off : ∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_pt.base →
      z ∉ Set.range x_pt.base →
        ∃ V : Z_tilde.left.Opens, z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left))
    (hOdp : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
      IsEtaleSplitOdpPointOver m f₀ (x_pt.base pt) (s_pt.base pt))
    (hHyp : IsHomogeneousHypersurfacePullbackOver k M 1 ι_bar L_pt
      (CategoryTheory.Limits.pullback.fst f₀.left s_pt ≫ π₀.left)) :
    AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f₀.left s_pt) :=
by
  
  have hStalkInj : ∀ (F : AlgebraicGeometry.Scheme.{u}) (D : Type u) [CommRing D]
      (e1 : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ F),
      AlgebraicGeometry.Etale e1 →
      ∀ (d₀ : PrimeSpectrum D) (y₀ : ↥F),
        e1.base d₀ = y₀ →
        ∃ ψ : ↑(F.presheaf.stalk y₀) →+* Localization.AtPrime d₀.asIdeal,
          Function.Injective ψ := by
    intro F D _ e1 _ d₀ y₀ hd₀
    obtain ⟨U_F, hUF, hy₀_UF, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y₀) (U := ⊤) trivial
    have hd₀_pre : (d₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of D))) ∈
        (TopologicalSpace.Opens.map e1.base).obj U_F := by
      change e1.base d₀ ∈ U_F
      rwa [hd₀]
    obtain ⟨W_D, hWD, hd₀_WD, hWD_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := (d₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of D))))
        (U := (TopologicalSpace.Opens.map e1.base).obj U_F) hd₀_pre
    let y₀_U : ↥U_F := ⟨y₀, hy₀_UF⟩
    let d₀_W : ↥W_D := ⟨d₀, hd₀_WD⟩
    let p_F_pt := hUF.primeIdealOf y₀_U
    let p_F := p_F_pt.asIdeal
    let q'_pt := hWD.primeIdealOf d₀_W
    let q' := q'_pt.asIdeal
    let _ : Algebra ↑(F.presheaf.obj (Opposite.op U_F)) ↑(F.presheaf.stalk y₀) :=
      TopCat.Presheaf.algebra_section_stalk F.presheaf y₀_U
    have : IsLocalization.AtPrime (↑(F.presheaf.stalk y₀)) p_F :=
      hUF.isLocalization_stalk y₀_U
    let e_stalk_F : ↑(F.presheaf.stalk y₀) ≃+* Localization.AtPrime p_F :=
      (IsLocalization.algEquiv p_F.primeCompl
        (↑(F.presheaf.stalk y₀)) (Localization.AtPrime p_F)).toRingEquiv
    let _ : Algebra ↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.obj (Opposite.op W_D))
        ↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk d₀) :=
      TopCat.Presheaf.algebra_section_stalk
        (AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf d₀_W
    have : IsLocalization.AtPrime
        (↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk d₀)) q' :=
      hWD.isLocalization_stalk d₀_W
    let e_stalk_D' : Localization.AtPrime q' ≃+*
        ↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk d₀) :=
      (IsLocalization.algEquiv q'.primeCompl
        (Localization.AtPrime q')
        (↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk d₀))).toRingEquiv
    let e_stalk_D : ↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk d₀) ≃+*
        Localization.AtPrime d₀.asIdeal :=
      (AlgebraicGeometry.StructureSheaf.stalkIso D d₀).symm.toRingEquiv
    have hrange_WD : Set.range (hWD.fromSpec ≫ e1).base ⊆ Set.range hUF.fromSpec.base := by
      rintro _ ⟨pt, rfl⟩
      simp only [AlgebraicGeometry.Scheme.Hom.comp_apply]
      have hpt : hWD.fromSpec.base pt ∈ hWD.fromSpec.opensRange := ⟨pt, rfl⟩
      rw [hWD.opensRange_fromSpec] at hpt
      have hy_mem : e1.base (hWD.fromSpec.base pt) ∈ U_F := hWD_sub hpt
      rw [← hUF.opensRange_fromSpec] at hy_mem
      exact hy_mem
    let g_lift := AlgebraicGeometry.IsOpenImmersion.lift hUF.fromSpec (hWD.fromSpec ≫ e1) hrange_WD
    have hg_fac : g_lift ≫ hUF.fromSpec = hWD.fromSpec ≫ e1 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hUF.fromSpec (hWD.fromSpec ≫ e1) hrange_WD
    have : AlgebraicGeometry.Etale (hWD.fromSpec ≫ e1) := inferInstance
    have hEt_glift : AlgebraicGeometry.Etale g_lift := by
      have hcomp_et : AlgebraicGeometry.Etale (g_lift ≫ hUF.fromSpec) := by rwa [hg_fac]
      exact CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        g_lift hUF.fromSpec inferInstance hcomp_et
    let φ_F_hom := AlgebraicGeometry.Spec.preimage g_lift
    let φ_F := φ_F_hom.hom
    have hSpec_φF : AlgebraicGeometry.Spec.map φ_F_hom = g_lift :=
      AlgebraicGeometry.Spec.map_preimage g_lift
    have hφF_et : φ_F.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rwa [hSpec_φF]
    have hφF_flat : φ_F.Flat := by
      let _ := φ_F.toAlgebra
      have : Algebra.Etale _ _ := RingHom.etale_algebraMap.mp hφF_et
      exact RingHom.flat_algebraMap_iff.mpr inferInstance
    have hp_eq : p_F = Ideal.comap φ_F q' := by
      let q'_spec : ↥(AlgebraicGeometry.Spec
        ((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.obj (Opposite.op W_D))) := q'_pt
      have hbase := congrArg (fun f => f.base q'_spec)
        (hSpec_φF.symm ▸ hg_fac : AlgebraicGeometry.Spec.map φ_F_hom ≫ hUF.fromSpec = hWD.fromSpec ≫ e1)
      change hUF.fromSpec.base ((AlgebraicGeometry.Spec.map φ_F_hom).base q'_spec) =
        e1.base (hWD.fromSpec.base q'_pt) at hbase
      have hd₀_fp : hWD.fromSpec.base q'_pt = d₀ := hWD.fromSpec_primeIdealOf d₀_W
      have hy₀_fp : hUF.fromSpec.base p_F_pt = y₀ := hUF.fromSpec_primeIdealOf y₀_U
      rw [hd₀_fp] at hbase
      change hUF.fromSpec.base ((AlgebraicGeometry.Spec.map φ_F_hom).base q'_spec) = e1.base d₀ at hbase
      rw [hd₀, ← hy₀_fp] at hbase
      have hpt_eq := (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hUF.fromSpec).injective hbase
      have hideal := congrArg PrimeSpectrum.asIdeal hpt_eq
      exact hideal.symm
    let ψ_loc : Localization.AtPrime p_F →+* Localization.AtPrime q' :=
      Localization.localRingHom p_F q' φ_F hp_eq
    have : IsLocalHom ψ_loc := Localization.isLocalHom_localRingHom p_F q' φ_F hp_eq
    have hψ_flat : ψ_loc.Flat := hφF_flat.localRingHom q' p_F hp_eq
    have hψ_loc_inj : Function.Injective ψ_loc := by
      let _ : Algebra (Localization.AtPrime p_F) (Localization.AtPrime q') := ψ_loc.toAlgebra
      have : Module.Flat (Localization.AtPrime p_F) (Localization.AtPrime q') :=
        RingHom.flat_algebraMap_iff.mp hψ_flat
      have : IsLocalHom (algebraMap (Localization.AtPrime p_F) (Localization.AtPrime q')) := ‹IsLocalHom ψ_loc›
      have : Module.FaithfullyFlat (Localization.AtPrime p_F) (Localization.AtPrime q') :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      exact RingHom.FaithfullyFlat.injective (RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance)
    refine ⟨e_stalk_D.toRingHom.comp (e_stalk_D'.toRingHom.comp (ψ_loc.comp e_stalk_F.toRingHom)), ?_⟩
    exact e_stalk_D.injective.comp (e_stalk_D'.injective.comp (hψ_loc_inj.comp e_stalk_F.injective))

  
  have hFibGeom :
      let F_pt := CategoryTheory.Limits.pullback f₀.left s_pt
      let fst := CategoryTheory.Limits.pullback.fst f₀.left s_pt
      let p_pt := CategoryTheory.Limits.pullback.snd f₀.left s_pt
      AlgebraicGeometry.IsProper p_pt ∧
      Function.Injective fst.base ∧
      ∃ y₀ : ↥F_pt,
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)), fst.base y₀ = x_pt.base pt) ∧
        IsClosed ({y₀} : Set ↥F_pt) ∧
        (∀ y : ↥F_pt, y ≠ y₀ →
          ∃ W : F_pt.Opens, y ∈ W ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W.ι ≫ p_pt)) := by
    let F_pt := CategoryTheory.Limits.pullback f₀.left s_pt
    let fst := CategoryTheory.Limits.pullback.fst f₀.left s_pt
    let p_pt := CategoryTheory.Limits.pullback.snd f₀.left s_pt
    have hpb_fib : CategoryTheory.IsPullback fst p_pt f₀.left s_pt :=
      CategoryTheory.IsPullback.of_hasPullback f₀.left s_pt
    have hProp_pt : AlgebraicGeometry.IsProper p_pt :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_fib inferInstance
    have : AlgebraicGeometry.IsSeparated p_pt := inferInstance
    have hInj_fst : Function.Injective fst.base := by
      intro y₁ y₂ hy
      have : AlgebraicGeometry.IsClosedImmersion (fst ≫ π₀.left) := hHyp.1
      apply (AlgebraicGeometry.Scheme.Hom.isClosedEmbedding (fst ≫ π₀.left)).injective
      simp only [AlgebraicGeometry.Scheme.Hom.comp_apply, hy]
    let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := Classical.arbitrary _
    let y_sec : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ F_pt :=
      CategoryTheory.Limits.pullback.lift x_pt
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (by rw [hx_sec, CategoryTheory.Category.id_comp])
    let y₀ : ↥F_pt := y_sec.base pt_k
    have hy₀_fst_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
        fst.base y₀ = x_pt.base pt := by
      intro pt
      rw [Subsingleton.elim pt pt_k]
      have h1 := congrArg (fun g => g.base pt_k)
        (CategoryTheory.Limits.pullback.lift_fst x_pt
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (by rw [hx_sec, CategoryTheory.Category.id_comp]))
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using h1
    have hy₀_cl : IsClosed ({y₀} : Set ↥F_pt) := by
      have hy_sec_snd : y_sec ≫ p_pt = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have : AlgebraicGeometry.IsClosedImmersion (y_sec ≫ p_pt) := by
        rw [hy_sec_snd]
        infer_instance
      have : AlgebraicGeometry.IsClosedImmersion y_sec :=
        AlgebraicGeometry.IsClosedImmersion.of_comp y_sec p_pt
      have hrange_eq : Set.range y_sec.base = ({y₀} : Set ↥F_pt) := by
        ext z
        simp only [Set.mem_range, Set.mem_singleton_iff]
        refine ⟨?_, fun hz => ⟨pt_k, hz.symm⟩⟩
        rintro ⟨pt, rfl⟩
        rw [Subsingleton.elim pt pt_k]
      rw [← hrange_eq]
      exact (AlgebraicGeometry.Scheme.Hom.isClosedEmbedding y_sec).isClosed_range
    refine ⟨hProp_pt, hInj_fst, y₀, hy₀_fst_pt, hy₀_cl, ?_⟩
    intro y hy
    have hy_fib : f₀.left.base (fst.base y) ∈ Set.range s_pt.base := by
      have hcond := congrArg (fun g => g.base y)
        (CategoryTheory.Limits.pullback.condition (f := f₀.left) (g := s_pt))
      simp only [AlgebraicGeometry.Scheme.Hom.comp_apply] at hcond
      exact ⟨p_pt.base y, hcond.symm⟩
    have hy_not_x : fst.base y ∉ Set.range x_pt.base := by
      rintro ⟨pt, hpt⟩
      rw [← hy₀_fst_pt pt] at hpt
      exact hy (hInj_fst hpt.symm)
    obtain ⟨V_Z, hy_VZ, hSm_VZ⟩ := hSm_off (fst.base y) hy_fib hy_not_x
    let W_y : F_pt.Opens := (TopologicalSpace.Opens.map fst.base).obj V_Z
    have hpb_res : CategoryTheory.IsPullback (fst ∣_ V_Z) W_y.ι V_Z.ι fst :=
      AlgebraicGeometry.isPullback_morphismRestrict fst V_Z
    have hSm_Wy : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_y.ι ≫ p_pt) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hpb_res.paste_vert hpb_fib) hSm_VZ
    exact ⟨W_y, hy_VZ, hSm_Wy⟩

  
  have hRoof :
      let A_cone := MvPolynomial (Fin (m + 1) × Fin 2) k ⧸
        Ideal.span ({∑ j : Fin (m + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))} :
          Set (MvPolynomial (Fin (m + 1) × Fin 2) k))
      ∃ (D : Type u) (_ : CommRing D) (d₀ : PrimeSpectrum D)
        (e1_tilde : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶
          CategoryTheory.Limits.pullback f₀.left s_pt)
        (e2_tilde : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of A_cone)),
        AlgebraicGeometry.Etale e1_tilde ∧
        AlgebraicGeometry.Etale e2_tilde ∧
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
          (CategoryTheory.Limits.pullback.fst f₀.left s_pt).base (e1_tilde.base d₀) = x_pt.base pt) ∧
        (∀ idx : Fin (m + 1) × Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (e2_tilde.base d₀).asIdeal) ∧
        (e1_tilde ≫ CategoryTheory.Limits.pullback.snd f₀.left s_pt =
          e2_tilde ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
    let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := Classical.arbitrary _
    have hpt_k_bot : pt_k.asIdeal = ⊥ := by
      ext y
      simp only [Ideal.mem_bot]
      refine ⟨fun hy => ?_, fun hy => hy ▸ pt_k.asIdeal.zero_mem⟩
      by_contra hne
      exact pt_k.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hy (IsUnit.mk0 y hne))
    obtain ⟨_, R', _, e_B, h, V', v₀, e_Y, q, he_B, he_Y, hq, _, hv₀, _, _, hX_v₀, hCh_v₀, hComm_odp⟩ :=
      hOdp pt_k
    let I_R' : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R') :=
      Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h}
    let Q_R' := MvPolynomial (Fin (m + 1) × Fin 2) R' ⧸ I_R'
    let c_R' : R' →+* Q_R' := (Ideal.Quotient.mk I_R').comp MvPolynomial.C
    let p_QR' : AlgebraicGeometry.Spec (CommRingCat.of Q_R') ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_R')
    let u₁ : ↥(AlgebraicGeometry.Spec R') := (q ≫ p_QR').base v₀
    have he_u₁ : e_B.base u₁ = s_pt.base pt_k := by
      have h1 : ((q ≫ p_QR') ≫ e_B).base v₀ = (e_Y ≫ f₀.left).base v₀ := by
        rw [CategoryTheory.Category.assoc]
        exact congrArg (fun g => g.base v₀) hComm_odp.symm
      have h2 : (x_pt ≫ f₀.left).base pt_k = s_pt.base pt_k :=
        congrArg (fun g => g.base pt_k) hx_sec
      simp only [AlgebraicGeometry.Scheme.Hom.comp_apply] at h1 h2
      rw [hv₀, h2] at h1
      exact h1
    have hh_u₁ : h ∈ u₁.asIdeal := by
      have h1 : u₁ = p_QR'.base (q.base v₀) := by
        simp only [u₁, AlgebraicGeometry.Scheme.Hom.comp_apply]
      rw [h1]
      exact hCh_v₀

    have hSec : ∃ (ι_u₁ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Spec R')
        (χ : R' →+* k),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) = ι_u₁ ∧
        ι_u₁ ≫ e_B = s_pt ∧
        ι_u₁.base pt_k = u₁ ∧
        χ h = 0 := by
      let W_B := CategoryTheory.Limits.pullback e_B s_pt
      let π_B1 := CategoryTheory.Limits.pullback.fst e_B s_pt
      let π_B2 := CategoryTheory.Limits.pullback.snd e_B s_pt
      obtain ⟨w_B, hw_B1, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u₁ pt_k he_u₁
      have : AlgebraicGeometry.Etale π_B2 :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback e_B s_pt) he_B
      obtain ⟨U_W, hUW, hw_UW, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w_B) (U := ⊤) trivial
      let E_B : Type u := ↑(W_B.presheaf.obj (Opposite.op U_W))
      let φ_EB_hom := AlgebraicGeometry.Spec.preimage (hUW.fromSpec ≫ π_B2)
      let φ_E : k →+* E_B := φ_EB_hom.hom
      have hSpec_φE : AlgebraicGeometry.Spec.map φ_EB_hom = hUW.fromSpec ≫ π_B2 :=
        AlgebraicGeometry.Spec.map_preimage _
      have : AlgebraicGeometry.Etale (hUW.fromSpec ≫ π_B2) := inferInstance
      have hφE_et : φ_E.Etale := by
        apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        rwa [hSpec_φE]
      let _ : Algebra k E_B := φ_E.toAlgebra
      have : Algebra.Etale k E_B := RingHom.etale_algebraMap.mp hφE_et
      let p_w_pt := hUW.primeIdealOf ⟨w_B, hw_UW⟩
      let p_w : Ideal E_B := p_w_pt.asIdeal
      have hbij : Function.Bijective (algebraMap k (Localization.AtPrime p_w)) :=
        Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing k (Localization.AtPrime p_w)
      let e_loc : k ≃+* Localization.AtPrime p_w := RingEquiv.ofBijective _ hbij
      let ε_w : E_B →+* k := e_loc.symm.toRingHom.comp (algebraMap E_B (Localization.AtPrime p_w))
      have hε_comp : ε_w.comp φ_E = RingHom.id k := by
        ext c
        change e_loc.symm (algebraMap E_B (Localization.AtPrime p_w) (algebraMap k E_B c)) = c
        rw [← IsScalarTower.algebraMap_apply k E_B (Localization.AtPrime p_w)]
        exact e_loc.symm_apply_apply c
      have hε_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_w)).base pt_k = p_w_pt := by
        apply PrimeSpectrum.ext
        ext x
        change ε_w x ∈ pt_k.asIdeal ↔ x ∈ p_w
        rw [hpt_k_bot, Ideal.mem_bot,
          ← IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime p_w) p_w x,
          IsLocalRing.mem_maximalIdeal]
        change e_loc.symm (algebraMap E_B (Localization.AtPrime p_w) x) = 0 ↔ _
        rw [← not_ne_iff, ← isUnit_iff_ne_zero]
        exact not_congr ⟨fun hu => by
            have hu' := hu.map e_loc.toRingHom
            change IsUnit (e_loc (e_loc.symm _)) at hu'
            rwa [e_loc.apply_symm_apply] at hu',
          fun hu => hu.map e_loc.symm.toRingHom⟩
      let σ_B : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W_B :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_w) ≫ hUW.fromSpec
      have hσ_B2 : σ_B ≫ π_B2 = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        dsimp [σ_B]
        rw [CategoryTheory.Category.assoc, ← hSpec_φE, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp_hom : φ_EB_hom ≫ CommRingCat.ofHom ε_w = 𝟙 (CommRingCat.of k) :=
          CommRingCat.Hom.ext hε_comp
        rw [hcomp_hom, AlgebraicGeometry.Spec.map_id]
      let ι_u₁ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Spec R' := σ_B ≫ π_B1
      have hι_eB : ι_u₁ ≫ e_B = s_pt := by
        dsimp [ι_u₁]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← CategoryTheory.Category.assoc, hσ_B2, CategoryTheory.Category.id_comp]
      have hι_pt : ι_u₁.base pt_k = u₁ := by
        have hfp : hUW.fromSpec.base p_w_pt = w_B := hUW.fromSpec_primeIdealOf ⟨w_B, hw_UW⟩
        simp only [ι_u₁, σ_B, AlgebraicGeometry.Scheme.Hom.comp_apply, hε_pt, hfp]
        exact hw_B1
      let χ : R' →+* k := (AlgebraicGeometry.Spec.preimage ι_u₁).hom
      have hSpec_χ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) = ι_u₁ :=
        AlgebraicGeometry.Spec.map_preimage ι_u₁
      have hχ_h : χ h = 0 := by
        have hh' : h ∈ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base pt_k).asIdeal := by
          rwa [hSpec_χ, hι_pt]
        change χ h ∈ pt_k.asIdeal at hh'
        rwa [hpt_k_bot, Ideal.mem_bot] at hh'
      exact ⟨ι_u₁, χ, hSpec_χ, hι_eB, hι_pt, hχ_h⟩
    obtain ⟨ι_u₁, χ, hSpec_χ, hι_eB, hι_pt, hχ_h⟩ := hSec

    let I_cone : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) k) :=
      Ideal.span ({∑ j : Fin (m + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))} :
        Set (MvPolynomial (Fin (m + 1) × Fin 2) k))
    let A_cone := MvPolynomial (Fin (m + 1) × Fin 2) k ⧸ I_cone
    let c_k : k →+* A_cone := (Ideal.Quotient.mk I_cone).comp MvPolynomial.C
    let Φ_poly : MvPolynomial (Fin (m + 1) × Fin 2) R' →+* A_cone :=
      (Ideal.Quotient.mk I_cone).comp (MvPolynomial.map χ)
    have hΦ_ker : ∀ p ∈ I_R', Φ_poly p = 0 := by
      intro p hp
      have hle : I_R' ≤ RingHom.ker Φ_poly := by
        rw [Ideal.span_singleton_le_iff_mem]
        change Ideal.Quotient.mk I_cone (MvPolynomial.map χ
          ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h)) = 0
        rw [map_sub, map_sum]
        simp only [map_mul, MvPolynomial.map_X, MvPolynomial.map_C, hχ_h, MvPolynomial.C_0, sub_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      exact hle hp
    let Φ_χ : Q_R' →+* A_cone := Ideal.Quotient.lift I_R' Φ_poly hΦ_ker
    have hΦ_comm : Φ_χ.comp c_R' = c_k.comp χ := by
      ext r
      change Ideal.Quotient.mk I_cone (MvPolynomial.map χ (MvPolynomial.C r)) =
        Ideal.Quotient.mk I_cone (MvPolynomial.C (χ r))
      rw [MvPolynomial.map_C]
    have hΦ_univ : ∀ (T : Type u) [CommRing T] (α : Q_R' →+* T) (β : k →+* T),
        α.comp c_R' = β.comp χ →
        ∃! γ : A_cone →+* T, γ.comp Φ_χ = α ∧ γ.comp c_k = β := by
      intro T _ α β hαβ
      let γ_poly : MvPolynomial (Fin (m + 1) × Fin 2) k →+* T :=
        MvPolynomial.eval₂Hom β (fun idx => α (Ideal.Quotient.mk I_R' (MvPolynomial.X idx)))
      have hγ_ker : ∀ p ∈ I_cone, γ_poly p = 0 := by
        intro p hp
        have hle : I_cone ≤ RingHom.ker γ_poly := by
          rw [Ideal.span_singleton_le_iff_mem]
          change γ_poly (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) = 0
          rw [map_sum]
          simp only [γ_poly, map_mul, MvPolynomial.eval₂Hom_X']
          have hsum_α : (∑ x : Fin (m + 1),
              α (Ideal.Quotient.mk I_R' (MvPolynomial.X (x, 0))) *
                α (Ideal.Quotient.mk I_R' (MvPolynomial.X (x, 1)))) =
              α (Ideal.Quotient.mk I_R' (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) := by
            simp only [map_sum, map_mul]
          rw [hsum_α]
          have hrel : Ideal.Quotient.mk I_R'
              (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) = c_R' h := by
            apply Ideal.Quotient.eq.mpr
            exact Ideal.subset_span rfl
          rw [hrel]
          have hαh : α (c_R' h) = β (χ h) := RingHom.congr_fun hαβ h
          rw [hαh, hχ_h, map_zero]
        exact hle hp
      let γ : A_cone →+* T := Ideal.Quotient.lift I_cone γ_poly hγ_ker
      have hγ1 : γ.comp Φ_χ = α := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          change γ (Φ_χ (c_R' r)) = α (c_R' r)
          have h1 : Φ_χ (c_R' r) = c_k (χ r) := RingHom.congr_fun hΦ_comm r
          rw [h1]
          change γ_poly (MvPolynomial.C (χ r)) = α (c_R' r)
          rw [MvPolynomial.eval₂Hom_C]
          exact (RingHom.congr_fun hαβ r).symm
        · intro idx
          change γ (Ideal.Quotient.mk I_cone (MvPolynomial.map χ (MvPolynomial.X idx))) =
            α (Ideal.Quotient.mk I_R' (MvPolynomial.X idx))
          rw [MvPolynomial.map_X]
          exact MvPolynomial.eval₂Hom_X' _ _ idx
      have hγ2 : γ.comp c_k = β := by
        ext x
        exact MvPolynomial.eval₂Hom_C _ _ x
      refine ⟨γ, ⟨hγ1, hγ2⟩, ?_⟩
      rintro δ ⟨hδ1, hδ2⟩
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        exact (RingHom.congr_fun hδ2 x).trans (RingHom.congr_fun hγ2 x).symm
      · intro idx
        simp only [RingHom.comp_apply]
        have hX : Ideal.Quotient.mk I_cone (MvPolynomial.X idx) =
            Φ_χ (Ideal.Quotient.mk I_R' (MvPolynomial.X idx)) := by
          change _ = Ideal.Quotient.mk I_cone (MvPolynomial.map χ (MvPolynomial.X idx))
          rw [MvPolynomial.map_X]
        rw [hX]
        exact (RingHom.congr_fun hδ1 _).trans (RingHom.congr_fun hγ1 _).symm

    let ι_cone : AlgebraicGeometry.Spec (CommRingCat.of A_cone) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of Q_R') :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_χ)
    let p_cone : AlgebraicGeometry.Spec (CommRingCat.of A_cone) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_k)
    have hpb_cone : CategoryTheory.IsPullback ι_cone p_cone p_QR' ι_u₁ := by
      rw [← hSpec_χ]
      have h_sq : CommRingCat.ofHom c_R' ≫ CommRingCat.ofHom Φ_χ =
          CommRingCat.ofHom χ ≫ CommRingCat.ofHom c_k := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hΦ_comm]
      have h_colim : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.PushoutCocone.mk
          (CommRingCat.ofHom Φ_χ) (CommRingCat.ofHom c_k) h_sq) := by
        refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk h_sq
          (fun s => CommRingCat.ofHom (Classical.choose (hΦ_univ s.pt s.inl.hom s.inr.hom (by
            have hc := congrArg CommRingCat.Hom.hom s.condition
            simpa [CommRingCat.ofHom_comp] using hc))))
          (fun s => CommRingCat.Hom.ext
            (Classical.choose_spec (hΦ_univ s.pt s.inl.hom s.inr.hom (by
              have hc := congrArg CommRingCat.Hom.hom s.condition
              simpa [CommRingCat.ofHom_comp] using hc))).1.1)
          (fun s => CommRingCat.Hom.ext
            (Classical.choose_spec (hΦ_univ s.pt s.inl.hom s.inr.hom (by
              have hc := congrArg CommRingCat.Hom.hom s.condition
              simpa [CommRingCat.ofHom_comp] using hc))).1.2)
          (fun s m hm1 hm2 => CommRingCat.Hom.ext
            ((Classical.choose_spec (hΦ_univ s.pt s.inl.hom s.inr.hom (by
              have hc := congrArg CommRingCat.Hom.hom s.condition
              simpa [CommRingCat.ofHom_comp] using hc))).2 m.hom ⟨by
                have h1 := congrArg CommRingCat.Hom.hom hm1
                simpa [CommRingCat.ofHom_comp] using h1, by
                have h2 := congrArg CommRingCat.Hom.hom hm2
                simpa [CommRingCat.ofHom_comp] using h2⟩))
      have h_push : CategoryTheory.IsPushout (CommRingCat.ofHom c_R') (CommRingCat.ofHom χ)
          (CommRingCat.ofHom Φ_χ) (CommRingCat.ofHom c_k) :=
        { w := h_sq, isColimit' := ⟨h_colim⟩ }
      exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ h_push

    let F_pt := CategoryTheory.Limits.pullback f₀.left s_pt
    let fst := CategoryTheory.Limits.pullback.fst f₀.left s_pt
    let p_pt := CategoryTheory.Limits.pullback.snd f₀.left s_pt
    have hpb_fib : CategoryTheory.IsPullback fst p_pt f₀.left s_pt :=
      CategoryTheory.IsPullback.of_hasPullback f₀.left s_pt
    let F_R' := CategoryTheory.Limits.pullback f₀.left e_B
    let fst_R' := CategoryTheory.Limits.pullback.fst f₀.left e_B
    let snd_R' := CategoryTheory.Limits.pullback.snd f₀.left e_B
    have hpb_R' : CategoryTheory.IsPullback fst_R' snd_R' f₀.left e_B :=
      CategoryTheory.IsPullback.of_hasPullback f₀.left e_B
    have hEt_fstR' : AlgebraicGeometry.Etale fst_R' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_R'.flip he_B
    let e_YR' : V' ⟶ F_R' :=
      CategoryTheory.Limits.pullback.lift e_Y (q ≫ p_QR')
        (by rw [hComm_odp, CategoryTheory.Category.assoc])
    have hEt_eYR' : AlgebraicGeometry.Etale e_YR' := by
      have he_comp : AlgebraicGeometry.Etale (e_YR' ≫ fst_R') := by
        rw [CategoryTheory.Limits.pullback.lift_fst]
        exact he_Y
      exact CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        e_YR' fst_R' hEt_fstR' he_comp
    let g_F : F_pt ⟶ F_R' :=
      CategoryTheory.Limits.pullback.lift fst (p_pt ≫ ι_u₁)
        (by rw [CategoryTheory.Category.assoc, hι_eB, CategoryTheory.Limits.pullback.condition])
    have hgF_fst : g_F ≫ fst_R' = fst := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hgF_snd : g_F ≫ snd_R' = p_pt ≫ ι_u₁ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_F : CategoryTheory.IsPullback g_F p_pt snd_R' ι_u₁ := by
      have hpb_outer : CategoryTheory.IsPullback (g_F ≫ fst_R') p_pt f₀.left (ι_u₁ ≫ e_B) := by
        rw [hgF_fst, hι_eB]
        exact hpb_fib
      exact CategoryTheory.IsPullback.of_right hpb_outer hgF_snd hpb_R'

    let V'₀ := CategoryTheory.Limits.pullback (q ≫ p_QR') ι_u₁
    let π_V1 := CategoryTheory.Limits.pullback.fst (q ≫ p_QR') ι_u₁
    let π_V2 := CategoryTheory.Limits.pullback.snd (q ≫ p_QR') ι_u₁
    have hpb_V : CategoryTheory.IsPullback π_V1 π_V2 (q ≫ p_QR') ι_u₁ :=
      CategoryTheory.IsPullback.of_hasPullback (q ≫ p_QR') ι_u₁
    have hcomm_10 : (π_V1 ≫ e_YR') ≫ snd_R' = π_V2 ≫ ι_u₁ := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      exact CategoryTheory.Limits.pullback.condition
    let e_10 : V'₀ ⟶ F_pt := hpb_F.lift (π_V1 ≫ e_YR') π_V2 hcomm_10
    have he10_gF : e_10 ≫ g_F = π_V1 ≫ e_YR' := hpb_F.lift_fst _ _ hcomm_10
    have he10_p : e_10 ≫ p_pt = π_V2 := hpb_F.lift_snd _ _ hcomm_10
    have hpb_10 : CategoryTheory.IsPullback π_V1 e_10 e_YR' g_F := by
      have hpb_V10 : CategoryTheory.IsPullback (e_10 ≫ p_pt) π_V1 ι_u₁ (e_YR' ≫ snd_R') := by
        rw [he10_p, CategoryTheory.Limits.pullback.lift_snd]
        exact hpb_V.flip
      exact (CategoryTheory.IsPullback.of_right hpb_V10 he10_gF hpb_F.flip).flip
    have : AlgebraicGeometry.Etale e_10 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_10 hEt_eYR'

    have hcomm_20 : (π_V1 ≫ q) ≫ p_QR' = π_V2 ≫ ι_u₁ := by
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.Limits.pullback.condition
    let e_20 : V'₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_cone) :=
      hpb_cone.lift (π_V1 ≫ q) π_V2 hcomm_20
    have he20_ι : e_20 ≫ ι_cone = π_V1 ≫ q := hpb_cone.lift_fst _ _ hcomm_20
    have he20_p : e_20 ≫ p_cone = π_V2 := hpb_cone.lift_snd _ _ hcomm_20
    have hpb_20 : CategoryTheory.IsPullback π_V1 e_20 q ι_cone := by
      have hpb_V20 : CategoryTheory.IsPullback (e_20 ≫ p_cone) π_V1 ι_u₁ (q ≫ p_QR') := by
        rw [he20_p]
        exact hpb_V.flip
      exact (CategoryTheory.IsPullback.of_right hpb_V20 he20_ι hpb_cone.flip).flip
    have : AlgebraicGeometry.Etale e_20 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_20 hq

    obtain ⟨w'₀, hw'₀_1, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v₀ pt_k hι_pt.symm
    obtain ⟨U'₀, hU'₀, hw'₀_U, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w'₀) (U := ⊤) trivial
    let R_D : CommRingCat.{u} := V'₀.presheaf.obj (Opposite.op U'₀)
    let d₀ : PrimeSpectrum ↑R_D := hU'₀.primeIdealOf ⟨w'₀, hw'₀_U⟩
    let e1_tilde : AlgebraicGeometry.Spec R_D ⟶ F_pt := hU'₀.fromSpec ≫ e_10
    let e2_tilde : AlgebraicGeometry.Spec R_D ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_cone) := hU'₀.fromSpec ≫ e_20
    have hEt1 : AlgebraicGeometry.Etale e1_tilde := inferInstance
    have hEt2 : AlgebraicGeometry.Etale e2_tilde := inferInstance
    have hd₀_fst : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
        fst.base (e1_tilde.base d₀) = x_pt.base pt := by
      intro pt
      rw [Subsingleton.elim pt pt_k]
      have hcomp1 : e1_tilde ≫ fst = hU'₀.fromSpec ≫ π_V1 ≫ e_Y := by
        dsimp [e1_tilde]
        rw [← hgF_fst, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_10,
          he10_gF, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      let d₀_spec : ↥(AlgebraicGeometry.Spec R_D) := d₀
      have h1 := congrArg (fun g => g.base d₀_spec) hcomp1
      have hfp : hU'₀.fromSpec.base d₀ = w'₀ := hU'₀.fromSpec_primeIdealOf ⟨w'₀, hw'₀_U⟩
      change fst.base (e1_tilde.base d₀) = e_Y.base (π_V1.base (hU'₀.fromSpec.base d₀)) at h1
      rw [hfp, hw'₀_1, hv₀] at h1
      exact h1
    have hd₀_X : ∀ idx : Fin (m + 1) × Fin 2,
        Ideal.Quotient.mk I_cone (MvPolynomial.X idx) ∈ (e2_tilde.base d₀).asIdeal := by
      intro idx
      have hcomp2 : e2_tilde ≫ ι_cone = hU'₀.fromSpec ≫ π_V1 ≫ q := by
        dsimp [e2_tilde]
        rw [CategoryTheory.Category.assoc, he20_ι]
      let d₀_spec : ↥(AlgebraicGeometry.Spec R_D) := d₀
      have h2 := congrArg (fun g => g.base d₀_spec) hcomp2
      have hfp : hU'₀.fromSpec.base d₀ = w'₀ := hU'₀.fromSpec_primeIdealOf ⟨w'₀, hw'₀_U⟩
      change ι_cone.base (e2_tilde.base d₀) = q.base (π_V1.base (hU'₀.fromSpec.base d₀)) at h2
      rw [hfp, hw'₀_1] at h2
      have hmem : Ideal.Quotient.mk I_R' (MvPolynomial.X idx) ∈
          (ι_cone.base (e2_tilde.base d₀)).asIdeal := by
        rw [h2]
        exact hX_v₀ idx
      have hΦX : Φ_χ (Ideal.Quotient.mk I_R' (MvPolynomial.X idx)) =
          Ideal.Quotient.mk I_cone (MvPolynomial.X idx) := by
        change Ideal.Quotient.mk I_cone (MvPolynomial.map χ (MvPolynomial.X idx)) = _
        rw [MvPolynomial.map_X]
      rw [← hΦX]
      exact hmem
    have hComm_hom : e1_tilde ≫ p_pt = e2_tilde ≫ p_cone := by
      dsimp [e1_tilde, e2_tilde]
      rw [CategoryTheory.Category.assoc, he10_p, CategoryTheory.Category.assoc, he20_p]
    exact ⟨↑R_D, inferInstance, d₀, e1_tilde, e2_tilde, hEt1, hEt2, hd₀_fst, hd₀_X, hComm_hom⟩

  
  obtain ⟨hProp_pt, hInj_fst, y₀, hy₀_fst, hy₀_cl, hSm_y⟩ := hFibGeom
  obtain ⟨D, hCommD, d₀, e1_tilde, e2_tilde, hEt1, hEt2, hd₀_fst, hd₀_X, hComm_hom⟩ := hRoof
  let _ : CommRing D := hCommD
  let F_pt := CategoryTheory.Limits.pullback f₀.left s_pt
  let fst := CategoryTheory.Limits.pullback.fst f₀.left s_pt
  let p_pt := CategoryTheory.Limits.pullback.snd f₀.left s_pt
  let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := Classical.arbitrary _
  have hd₀_y₀ : e1_tilde.base d₀ = y₀ :=
    hInj_fst ((hd₀_fst pt_k).trans (hy₀_fst pt_k).symm)
  obtain ⟨ψ_stalk, hψ_inj⟩ := hStalkInj F_pt D e1_tilde hEt1 d₀ y₀ hd₀_y₀
  have hDom_off : ∀ y : ↥F_pt, y ≠ y₀ → IsDomain ↑(F_pt.presheaf.stalk y) := by
    intro y hy
    obtain ⟨W_y, hy_W, hSm_W⟩ := hSm_y y hy
    exact hSmStalkDom (2 * m + 1) k F_pt p_pt W_y y hy_W hSm_W

  let I_cone : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) k) :=
    Ideal.span ({∑ j : Fin (m + 1), MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))} :
      Set (MvPolynomial (Fin (m + 1) × Fin 2) k))
  let A_cone := MvPolynomial (Fin (m + 1) × Fin 2) k ⧸ I_cone
  let φ_cone_hom := AlgebraicGeometry.Spec.preimage e2_tilde
  let φ_cone : A_cone →+* D := φ_cone_hom.hom
  have hSpec_φcone : AlgebraicGeometry.Spec.map φ_cone_hom = e2_tilde :=
    AlgebraicGeometry.Spec.map_preimage e2_tilde
  have hφcone_et : φ_cone.Etale := by
    apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
    rwa [hSpec_φcone]

  rcases Nat.eq_zero_or_pos m with rfl | hm
  · 
    let I_node : Ideal (MvPolynomial (Fin 2) k) :=
      Ideal.span ({MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)} : Set (MvPolynomial (Fin 2) k))
    let A_node := MvPolynomial (Fin 2) k ⧸ I_node
    let e_idx : (Fin (0 + 1) × Fin 2) ≃ Fin 2 :=
      { toFun := Prod.snd
        invFun := fun b => (0, b)
        left_inv := fun ⟨j, _⟩ => Prod.ext (Fin.ext (by omega)) rfl
        right_inv := fun _ => rfl }
    let R_eq : MvPolynomial (Fin (0 + 1) × Fin 2) k ≃+* MvPolynomial (Fin 2) k :=
      (MvPolynomial.renameEquiv k e_idx).toRingEquiv
    have hI_map : I_node = Ideal.map (R_eq : MvPolynomial (Fin (0 + 1) × Fin 2) k →+* MvPolynomial (Fin 2) k) I_cone := by
      dsimp [I_node, I_cone]
      rw [Ideal.map_span, Set.image_singleton, Fin.sum_univ_one]
      have hgen : (R_eq : MvPolynomial (Fin (0 + 1) × Fin 2) k →+* MvPolynomial (Fin 2) k)
          (MvPolynomial.X (0, (0 : Fin 2)) * MvPolynomial.X (0, (1 : Fin 2))) =
          MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2) := by
        simp [R_eq, e_idx, map_mul, MvPolynomial.rename_X]
      rw [hgen]
    let θ_node : A_cone ≃+* A_node := Ideal.quotientEquiv I_cone I_node R_eq hI_map
    have hθ_X : ∀ b : Fin 2,
        θ_node.symm (Ideal.Quotient.mk I_node (MvPolynomial.X b)) =
          Ideal.Quotient.mk I_cone (MvPolynomial.X ((0 : Fin (0 + 1)), b)) := by
      intro b
      apply θ_node.injective
      rw [θ_node.apply_symm_apply]
      change Ideal.Quotient.mk I_node _ = Ideal.Quotient.mk I_node (R_eq (MvPolynomial.X ((0 : Fin (0 + 1)), b)))
      simp [R_eq, e_idx, MvPolynomial.rename_X]
    have hθ_C : θ_node.symm.toRingHom.comp ((Ideal.Quotient.mk I_node).comp MvPolynomial.C) =
        (Ideal.Quotient.mk I_cone).comp MvPolynomial.C := by
      ext x
      apply θ_node.injective
      change θ_node (θ_node.symm (Ideal.Quotient.mk I_node (MvPolynomial.C x))) =
        θ_node (Ideal.Quotient.mk I_cone (MvPolynomial.C x))
      rw [θ_node.apply_symm_apply]
      change Ideal.Quotient.mk I_node (MvPolynomial.C x) =
        Ideal.Quotient.mk I_node (R_eq (MvPolynomial.C x))
      simp [R_eq]
    have : CategoryTheory.IsIso (CommRingCat.ofHom θ_node.symm.toRingHom) :=
      ⟨⟨CommRingCat.ofHom θ_node.toRingHom,
        CommRingCat.Hom.ext (RingHom.ext fun x => θ_node.apply_symm_apply x),
        CommRingCat.Hom.ext (RingHom.ext fun x => θ_node.symm_apply_apply x)⟩⟩
    let e2_node : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_node) :=
      e2_tilde ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_node.symm.toRingHom)
    have hEt2_node : AlgebraicGeometry.Etale e2_node := inferInstance
    let C_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk p_pt
    have hCL_w : (fst ≫ π₀.left) ≫ Z_bar.hom = C_L.hom := by
      change (fst ≫ π₀.left) ≫ Z_bar.hom = p_pt
      rw [CategoryTheory.Category.assoc, π₀.w, ← f₀.w, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hs_pt,
        CategoryTheory.Category.comp_id]
    let ι_CL : C_L ⟶ Z_bar := CategoryTheory.Over.homMk (fst ≫ π₀.left) hCL_w
    have hd₀_X_node : ∀ b : Fin 2,
        Ideal.Quotient.mk I_node (MvPolynomial.X b) ∈ (e2_node.base d₀).asIdeal := by
      intro b
      let d₀_spec : ↥(AlgebraicGeometry.Spec (CommRingCat.of D)) := d₀
      have h1 : e2_node.base d₀_spec =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_node.symm.toRingHom)).base (e2_tilde.base d₀_spec) := by
        simp only [e2_node, AlgebraicGeometry.Scheme.Hom.comp_apply]
      change Ideal.Quotient.mk I_node (MvPolynomial.X b) ∈ (e2_node.base d₀_spec).asIdeal
      rw [h1]
      change θ_node.symm (Ideal.Quotient.mk I_node (MvPolynomial.X b)) ∈ (e2_tilde.base d₀).asIdeal
      rw [hθ_X b]
      exact hd₀_X (0, b)
    have hComm_node : e1_tilde ≫ C_L.hom =
        e2_node ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_node).comp MvPolynomial.C)) := by
      change e1_tilde ≫ p_pt =
        (e2_tilde ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_node.symm.toRingHom)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I_node).comp MvPolynomial.C))
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hhom_C : CommRingCat.ofHom ((Ideal.Quotient.mk I_node).comp MvPolynomial.C) ≫
          CommRingCat.ofHom θ_node.symm.toRingHom =
          CommRingCat.ofHom ((Ideal.Quotient.mk I_cone).comp MvPolynomial.C) :=
        CommRingCat.Hom.ext hθ_C
      rw [hhom_C]
      exact hComm_hom
    have : IrreducibleSpace ↥F_pt :=
      hVer.2.2.2.2.2 rfl L_pt hL_homog hL_ne C_L ι_CL hHyp hConn_pt
        (Or.inr ⟨y₀, hy₀_cl, hSm_y, AlgebraicGeometry.Spec (CommRingCat.of D), d₀,
          e1_tilde, e2_node, hEt1, hEt2_node, hd₀_y₀, hd₀_X_node, hComm_node⟩)

    let φ_node_hom := AlgebraicGeometry.Spec.preimage e2_node
    let φ_node : A_node →+* D := φ_node_hom.hom
    have hSpec_φnode : AlgebraicGeometry.Spec.map φ_node_hom = e2_node :=
      AlgebraicGeometry.Spec.map_preimage e2_node
    have hφnode_et : φ_node.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rwa [hSpec_φnode]
    let _ : Algebra A_node D := φ_node.toAlgebra
    have : Algebra.Etale A_node D := RingHom.etale_algebraMap.mp hφnode_et
    have : IsReduced (Localization.AtPrime d₀.asIdeal) := hNodeRed D d₀.asIdeal
    have hy₀_red : IsReduced ↑(F_pt.presheaf.stalk y₀) := isReduced_of_injective ψ_stalk hψ_inj
    have : ∀ x : ↥F_pt, IsReduced ↑(F_pt.presheaf.stalk x) := by
      intro x
      by_cases hx : x = y₀
      · subst hx
        exact hy₀_red
      · have : IsDomain ↑(F_pt.presheaf.stalk x) := hDom_off x hx
        refine ⟨fun a ⟨n, hn⟩ => ?_⟩
        induction n with
        | zero =>
          rw [pow_zero] at hn
          exact absurd hn one_ne_zero
        | succ n ih =>
          rw [pow_succ] at hn
          rcases mul_eq_zero.mp hn with h1 | h2
          · exact ih h1
          · exact h2
    have : AlgebraicGeometry.IsReduced F_pt := AlgebraicGeometry.isReduced_of_isReduced_stalk F_pt
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced F_pt
  · 
    let _ : Algebra A_cone D := φ_cone.toAlgebra
    have : Algebra.Etale A_cone D := RingHom.etale_algebraMap.mp hφcone_et
    have hd₀_alg : ∀ idx : Fin (m + 1) × Fin 2,
        algebraMap A_cone D (Ideal.Quotient.mk I_cone (MvPolynomial.X idx)) ∈ d₀.asIdeal := by
      intro idx
      have hmem := hd₀_X idx
      rw [← hSpec_φcone] at hmem
      exact hmem
    have : IsDomain (Localization.AtPrime d₀.asIdeal) := hConeDom m hm D d₀.asIdeal hd₀_alg
    have hy₀_dom : IsDomain ↑(F_pt.presheaf.stalk y₀) := Function.Injective.isDomain ψ_stalk hψ_inj
    have hAllDom : ∀ x : ↥F_pt, IsDomain ↑(F_pt.presheaf.stalk x) := by
      intro x
      by_cases hx : x = y₀
      · subst hx
        exact hy₀_dom
      · exact hDom_off x hx
    exact hIntOfStalkDom k F_pt p_pt hProp_pt hConn_pt hAllDom

theorem weil_projLine_geomPoint_dichotomy_and_integral_baseChange (k : Type u) [Field k] :
    (∀ (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
          (weilProjectiveSpaceOver k 1).left)
       (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left)
       (S_aff : Finset k)
       (U₀ : (weilProjectiveSpaceOver k 1).left.Opens),
      IsStandardProjLineCoord k j_aff s_inf →
      (U₀ : Set (weilProjectiveSpaceOver k 1).left) =
        j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
          ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } →
      ∀ (Ω : Type u) [Field Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
        Set.range s.base ⊆ (U₀ : Set (weilProjectiveSpaceOver k 1).left) ∨
        (∃ ρ_s : k →+* Ω,
          s = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫ s_inf) ∨
        (∃ a ∈ S_aff, ∃ ρ_s : k →+* Ω,
          s = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff))) ∧
    (∀ (hAlgDom : ∀ (E : Type u) [Field E] [Algebra k E]
          (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C],
          IsDomain (TensorProduct k C E))
       (hIntOfStalkDom : ∀ (K : Type u) [Field K]
          (X : AlgebraicGeometry.Scheme.{u})
          (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
          AlgebraicGeometry.IsProper p_X →
          ConnectedSpace ↥X →
          (∀ x : X, IsDomain ↑(X.presheaf.stalk x)) →
          AlgebraicGeometry.IsIntegral X)
       (F_k : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral F_k]
       (p_k : F_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)) [AlgebraicGeometry.IsProper p_k]
       (Ω : Type u) [Field Ω] (ρ_s : k →+* Ω),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback p_k
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s))) →
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback p_k
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s)))) :=
by
  have hRatSec : ∀ (P : AlgebraicGeometry.Scheme.{u})
      (p_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (s_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P),
      s_pt ≫ p_P = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      ∀ (Ω : Type u) [Field Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P),
      s.base default ∈ Set.range s_pt.base →
      ∃ ρ_s : k →+* Ω, s = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫ s_pt := by
    intro P p_P s_pt hs_pt Ω _ s hy_mem
    let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := default
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
    have hpt_Ω_bot : pt_Ω.asIdeal = ⊥ := @Ideal.eq_bot_of_prime Ω _ pt_Ω.asIdeal pt_Ω.isPrime
    set y : P := s.base pt_Ω
    rcases hy_mem with ⟨q_k, hq_k⟩
    have hy_pt : s_pt.base pt_k = y := by
      rwa [Subsingleton.elim q_k pt_k] at hq_k
    obtain ⟨V, hAffV, hyV, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show y ∈ (⊤ : P.Opens) from trivial)
    let R_V : CommRingCat.{u} := P.presheaf.obj (Opposite.op V)
    let j_V : AlgebraicGeometry.Spec R_V ⟶ P := hAffV.fromSpec
    haveI : AlgebraicGeometry.IsOpenImmersion j_V := hAffV.isOpenImmersion_fromSpec
    have hRange_pt : Set.range s_pt.base ⊆ Set.range j_V.base := by
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt_k, hy_pt, hAffV.range_fromSpec]
      exact hyV
    have hRange_s : Set.range s.base ⊆ Set.range j_V.base := by
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt_Ω, hAffV.range_fromSpec]
      exact hyV
    let g_pt := AlgebraicGeometry.IsOpenImmersion.lift j_V s_pt hRange_pt
    have hg_pt : g_pt ≫ j_V = s_pt := AlgebraicGeometry.IsOpenImmersion.lift_fac j_V s_pt hRange_pt
    let g_s := AlgebraicGeometry.IsOpenImmersion.lift j_V s hRange_s
    have hg_s : g_s ≫ j_V = s := AlgebraicGeometry.IsOpenImmersion.lift_fac j_V s hRange_s
    let f₀_cat : CommRingCat.of k ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_V ≫ p_P)
    have hf₀_map : AlgebraicGeometry.Spec.map f₀_cat = j_V ≫ p_P :=
      AlgebraicGeometry.Spec.map_preimage _
    let β_cat : R_V ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage g_pt
    have hβ_map : AlgebraicGeometry.Spec.map β_cat = g_pt :=
      AlgebraicGeometry.Spec.map_preimage _
    let ψ_cat : R_V ⟶ CommRingCat.of Ω := AlgebraicGeometry.Spec.preimage g_s
    have hψ_map : AlgebraicGeometry.Spec.map ψ_cat = g_s :=
      AlgebraicGeometry.Spec.map_preimage _
    have hcomp_id : f₀_cat ≫ β_cat = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hβ_map, hf₀_map,
        ← CategoryTheory.Category.assoc, hg_pt, hs_pt]
    have hβf₀ : ∀ c : k, β_cat.hom (f₀_cat.hom c) = c := fun c => by
      change (f₀_cat ≫ β_cat).hom c = c
      rw [hcomp_id]
      rfl
    have hg_eq_pt : g_s.base pt_Ω = g_pt.base pt_k := by
      apply (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding j_V).injective
      calc j_V.base (g_s.base pt_Ω)
        _ = (g_s ≫ j_V).base pt_Ω := rfl
        _ = s.base pt_Ω := by rw [hg_s]
        _ = s_pt.base pt_k := hy_pt.symm
        _ = (g_pt ≫ j_V).base pt_k := by rw [← hg_pt]
        _ = j_V.base (g_pt.base pt_k) := rfl
    let ρ_s : k →+* Ω := ψ_cat.hom.comp f₀_cat.hom
    have hψ_eq : ψ_cat = β_cat ≫ CommRingCat.ofHom ρ_s := by
      apply CommRingCat.hom_ext
      ext r
      let z : R_V := r - f₀_cat.hom (β_cat.hom r)
      have hβz : β_cat.hom z = 0 := by
        dsimp [z]
        rw [map_sub, hβf₀ (β_cat.hom r), sub_self]
      have hz_k : z ∈ ((AlgebraicGeometry.Spec.map β_cat).base pt_k).asIdeal := by
        change β_cat.hom z ∈ pt_k.asIdeal
        rw [hβz]
        exact zero_mem _
      have hz_Ω : z ∈ ((AlgebraicGeometry.Spec.map ψ_cat).base pt_Ω).asIdeal := by
        rwa [hβ_map, ← hg_eq_pt, ← hψ_map] at hz_k
      have hψz : ψ_cat.hom z ∈ pt_Ω.asIdeal := hz_Ω
      rw [hpt_Ω_bot, Ideal.mem_bot] at hψz
      dsimp [z] at hψz
      rw [map_sub, sub_eq_zero] at hψz
      exact hψz
    refine ⟨ρ_s, ?_⟩
    calc s = g_s ≫ j_V := hg_s.symm
      _ = AlgebraicGeometry.Spec.map ψ_cat ≫ j_V := by rw [hψ_map]
      _ = AlgebraicGeometry.Spec.map (β_cat ≫ CommRingCat.ofHom ρ_s) ≫ j_V := by rw [hψ_eq]
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫
            AlgebraicGeometry.Spec.map β_cat) ≫ j_V := by
          rw [AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫ (g_pt ≫ j_V) := by
          rw [CategoryTheory.Category.assoc, hβ_map]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫ s_pt := by rw [hg_pt]
  refine ⟨?_, ?_⟩
  · intro j_aff s_inf S_aff U₀ hCoord hU₀_eq Ω _ s
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
    have hpt_Ω_bot : pt_Ω.asIdeal = ⊥ := @Ideal.eq_bot_of_prime Ω _ pt_Ω.asIdeal pt_Ω.isPrime
    by_cases hy_aff : s.base pt_Ω ∈ Set.range j_aff.base
    · haveI : AlgebraicGeometry.IsOpenImmersion j_aff := hCoord.1
      have hRange_aff : Set.range s.base ⊆ Set.range j_aff.base := by
        rintro _ ⟨q, rfl⟩
        rwa [Subsingleton.elim q pt_Ω]
      let g_aff := AlgebraicGeometry.IsOpenImmersion.lift j_aff s hRange_aff
      have hg_aff : g_aff ≫ j_aff = s :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j_aff s hRange_aff
      let φ_cat : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of Ω :=
        AlgebraicGeometry.Spec.preimage g_aff
      have hφ_map : AlgebraicGeometry.Spec.map φ_cat = g_aff :=
        AlgebraicGeometry.Spec.map_preimage _
      let φ : Polynomial k →+* Ω := φ_cat.hom
      let p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) := g_aff.base pt_Ω
      by_cases hGood : ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal
      · left
        rintro _ ⟨q, rfl⟩
        rw [Subsingleton.elim q pt_Ω, hU₀_eq]
        exact ⟨p, hGood, by change (g_aff ≫ j_aff).base pt_Ω = s.base pt_Ω; rw [hg_aff]⟩
      · right; right
        push Not at hGood
        rcases hGood with ⟨a, ha, hmem⟩
        have hmem' : φ (Polynomial.X - Polynomial.C a) ∈ pt_Ω.asIdeal := by
          change (Polynomial.X - Polynomial.C a) ∈
            ((AlgebraicGeometry.Spec.map φ_cat).base pt_Ω).asIdeal
          rwa [hφ_map]
        rw [hpt_Ω_bot, Ideal.mem_bot, map_sub, sub_eq_zero] at hmem'
        let ρ_s : k →+* Ω := φ.comp Polynomial.C
        have hφ_eq : φ = ρ_s.comp (Polynomial.evalRingHom a) := by
          apply Polynomial.ringHom_ext'
          · ext c
            simp [ρ_s]
          · simp [ρ_s, hmem']
        have hφ_cat_eq :
            φ_cat = CommRingCat.ofHom (Polynomial.evalRingHom a) ≫ CommRingCat.ofHom ρ_s := by
          apply CommRingCat.hom_ext
          exact hφ_eq
        refine ⟨a, ha, ρ_s, ?_⟩
        calc s = g_aff ≫ j_aff := hg_aff.symm
          _ = AlgebraicGeometry.Spec.map φ_cat ≫ j_aff := by rw [hφ_map]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Polynomial.evalRingHom a) ≫ CommRingCat.ofHom ρ_s) ≫
                j_aff := by rw [hφ_cat_eq]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫
                  j_aff) := by
              rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    · right; left
      have hy_inf : s.base pt_Ω ∈ Set.range s_inf.base := by
        rw [← hCoord.2.2.2.2.1]
        exact hy_aff
      exact hRatSec (weilProjectiveSpaceOver k 1).left (weilProjectiveSpaceOver k 1).hom
        s_inf hCoord.2.2.1 Ω s hy_inf
  · intro hAlgDom hIntOfStalkDom F_k _ p_k _ Ω _ ρ_s hConn
    let g_ρ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s)
    let F_Ω := CategoryTheory.Limits.pullback p_k g_ρ
    let fst := CategoryTheory.Limits.pullback.fst p_k g_ρ
    let p_Ω := CategoryTheory.Limits.pullback.snd p_k g_ρ
    have hpb_base : CategoryTheory.IsPullback fst p_Ω p_k g_ρ :=
      CategoryTheory.IsPullback.of_hasPullback p_k g_ρ
    have hProp_Ω : AlgebraicGeometry.IsProper p_Ω :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_base inferInstance
    have hStalks : ∀ x : F_Ω, IsDomain ↑(F_Ω.presheaf.stalk x) := by
      intro x
      let y : F_k := fst.base x
      obtain ⟨U, hAffU, hyU, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show y ∈ (⊤ : F_k.Opens) from trivial)
      let C : Type u := ↑(F_k.presheaf.obj (Opposite.op U))
      haveI : IsDomain C := @AlgebraicGeometry.IsIntegral.component_integral F_k _ U ⟨⟨y, hyU⟩⟩
      let j_U : AlgebraicGeometry.Spec (CommRingCat.of C) ⟶ F_k := hAffU.fromSpec
      haveI : AlgebraicGeometry.IsOpenImmersion j_U := hAffU.isOpenImmersion_fromSpec
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType (j_U ≫ p_k) := inferInstance
      let φ_C_cat : CommRingCat.of k ⟶ CommRingCat.of C :=
        AlgebraicGeometry.Spec.preimage (j_U ≫ p_k)
      have hφ_C_map : AlgebraicGeometry.Spec.map φ_C_cat = j_U ≫ p_k :=
        AlgebraicGeometry.Spec.map_preimage _
      let φ_C : k →+* C := φ_C_cat.hom
      have hφ_C_ft : φ_C.FiniteType := by
        have hLFT' : AlgebraicGeometry.LocallyOfFiniteType
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_C)) := by
          change AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_C_cat)
          rwa [hφ_C_map]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT'
      letI : Algebra k C := φ_C.toAlgebra
      letI : Algebra k Ω := ρ_s.toAlgebra
      haveI : Algebra.FiniteType k C := RingHom.finiteType_algebraMap.mp hφ_C_ft
      haveI : IsDomain (TensorProduct k C Ω) := hAlgDom Ω C
      let W := CategoryTheory.Limits.pullback fst j_U
      let j_W := CategoryTheory.Limits.pullback.fst fst j_U
      let q_W := CategoryTheory.Limits.pullback.snd fst j_U
      have hpb_top : CategoryTheory.IsPullback q_W j_W j_U fst :=
        (CategoryTheory.IsPullback.of_hasPullback fst j_U).flip
      haveI : AlgebraicGeometry.IsOpenImmersion j_W :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_top
          inferInstance
      have hy_range : fst.base x ∈ Set.range j_U.base := by
        change y ∈ Set.range j_U.base
        rw [hAffU.range_fromSpec]
        exact hyU
      rcases hy_range with ⟨p_y, hp_y⟩
      obtain ⟨w_x, hw_x, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := fst) (g := j_U) x p_y hp_y.symm
      have hpasted : CategoryTheory.IsPullback q_W (j_W ≫ p_Ω)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k C)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k Ω))) := by
        have hp := hpb_top.paste_vert hpb_base
        have h1 : j_U ≫ p_k = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k C)) :=
          hφ_C_map.symm
        rw [h1] at hp
        exact hp
      let e_aff : W ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k C Ω)) :=
        hpasted.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso k C Ω
      let h_open : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k C Ω)) ⟶ F_Ω :=
        e_aff.inv ≫ j_W
      haveI : AlgebraicGeometry.IsOpenImmersion e_aff.inv :=
        AlgebraicGeometry.IsOpenImmersion.of_isIso e_aff.inv
      haveI : AlgebraicGeometry.IsOpenImmersion h_open := inferInstance
      let z₀ : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k C Ω)) :=
        e_aff.hom.base w_x
      have hz₀ : h_open.base z₀ = x := by
        calc h_open.base z₀ = j_W.base ((e_aff.hom ≫ e_aff.inv).base w_x) := rfl
          _ = j_W.base w_x := by rw [e_aff.hom_inv_id]; rfl
          _ = x := hw_x
      have hInt_Spec : AlgebraicGeometry.IsIntegral
          (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k C Ω))) :=
        (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of (TensorProduct k C Ω))).mpr
          (hAlgDom Ω C)
      haveI : IsDomain ↑((AlgebraicGeometry.Spec
          (CommRingCat.of (TensorProduct k C Ω))).presheaf.stalk z₀) :=
        @AlgebraicGeometry.instIsDomainCarrierStalkCommRingCatPresheafOfIsIntegral
          (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k C Ω))) hInt_Spec z₀
      haveI : CategoryTheory.IsIso (AlgebraicGeometry.Scheme.Hom.stalkMap h_open z₀) :=
        AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap h_open z₀
      let e_stalk :=
        (CategoryTheory.asIso (AlgebraicGeometry.Scheme.Hom.stalkMap h_open z₀)).commRingCatIsoToRingEquiv
      have hDom_z₀ : IsDomain ↑(F_Ω.presheaf.stalk (h_open.base z₀)) :=
        Function.Injective.isDomain e_stalk.toRingHom e_stalk.injective
      rwa [hz₀] at hDom_z₀
    haveI : AlgebraicGeometry.IsIntegral F_Ω :=
      hIntOfStalkDom Ω F_Ω p_Ω hProp_Ω hConn hStalks
    exact AlgebraicGeometry.irreducibleSpace_of_isIntegral F_Ω

theorem weil_algClosed_lefschetz_fiber_irreducible (k : Type u) [Field k] [IsAlgClosed k]
    (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hVer : IsCubicVeroneseEmbeddedOver k m M Z_bar ι_bar)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    (π₀ : Z_tilde ⟶ Z_bar)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver k 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (hFibConn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (hAlgDom : ∀ (E : Type u) [Field E] [Algebra k E]
        (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C],
      IsDomain (TensorProduct k C E)) :
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
        (CategoryTheory.Limits.pullback.snd f₀.left s) →
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s)) ∧
    (∀ (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
          (weilProjectiveSpaceOver k 1).left)
       (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left)
       (S_aff : Finset k)
       (U₀ : (weilProjectiveSpaceOver k 1).left.Opens),
      IsStandardProjLineCoord k j_aff s_inf →
      (U₀ : Set (weilProjectiveSpaceOver k 1).left) =
        j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
          ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } →
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀) →
      (∃ (L_inf : MvPolynomial (Fin (M + 1)) k)
         (x_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_tilde.left),
        L_inf ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 ∧
        L_inf ≠ 0 ∧
        x_inf ≫ f₀.left = s_inf ∧
        (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_inf.base →
          z ∉ Set.range x_inf.base →
            ∃ V : Z_tilde.left.Opens, z ∈ V ∧
              AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left)) ∧
        (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
          IsEtaleSplitOdpPointOver m f₀ (x_inf.base pt) (s_inf.base pt)) ∧
        IsHomogeneousHypersurfacePullbackOver k M 1 ι_bar L_inf
          (CategoryTheory.Limits.pullback.fst f₀.left s_inf ≫ π₀.left)) →
      (∀ a ∈ S_aff,
        let s_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff
        ∃ (L_a : MvPolynomial (Fin (M + 1)) k)
          (x_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_tilde.left),
          L_a ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 ∧
          L_a ≠ 0 ∧
          x_a ≫ f₀.left = s_a ∧
          (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_a.base →
            z ∉ Set.range x_a.base →
              ∃ V : Z_tilde.left.Opens, z ∈ V ∧
                AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left)) ∧
          (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
            IsEtaleSplitOdpPointOver m f₀ (x_a.base pt) (s_a.base pt)) ∧
          IsHomogeneousHypersurfacePullbackOver k M 1 ι_bar L_a
            (CategoryTheory.Limits.pullback.fst f₀.left s_a ≫ π₀.left)) →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
        IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s)) :=
by
  obtain ⟨hKrullDom, hEtPolyDom, hSmStalkDom, hIntOfStalkDom⟩ :=
    weil_etale_mvPolynomial_and_smooth_stalk_isDomain_isIntegral
  obtain ⟨hConeDom, hNodeRed⟩ :=
    weil_split_quadric_cone_etale_stalk_domain_and_nodal_reduced k hKrullDom hEtPolyDom
  obtain ⟨hDichot, hBC⟩ :=
    weil_projLine_geomPoint_dichotomy_and_integral_baseChange k
  have hPart1 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
