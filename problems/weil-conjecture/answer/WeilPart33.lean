  let U_std_Z : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) ⥤
      Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    CategoryTheory.sheafCompose Z.smallEtaleTopology FgtMod
  have hUZ_obj' : ∀ ℱ, U_Z.obj ℱ = U_std_Z.obj ℱ := fun ℱ => by
    apply ObjectProperty.FullSubcategory.ext
