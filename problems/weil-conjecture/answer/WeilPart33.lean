      change p ⊗ₜ[B₂] r = (p ⊗ₜ[B₂] (1 : R_loc)) * ((1 : P₂) ⊗ₜ[B₂] r)
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [hpr]
    exact (hp_int p).mul isIntegral_algebraMap
