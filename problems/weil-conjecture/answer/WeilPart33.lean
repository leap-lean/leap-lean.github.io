theorem weil_algClosed_even_quadForm_split_normal_form (k : Type u) [Field k] [IsAlgClosed k] (r : ℕ)
    (q : Fin (2 * r) → Fin (2 * r) → k)
    (hq_tri : ∀ i j : Fin (2 * r), j < i → q i j = 0)
    (hq_det : Matrix.det (Matrix.of fun i j : Fin (2 * r) =>
      if i = j then 2 * q i i else if i < j then q i j else q j i) ≠ 0) :
    ∃ C : Matrix (Fin (2 * r)) (Fin (2 * r)) k,
      IsUnit C.det ∧
      (∀ (S : Type u) [CommRing S] (ρ : k →+* S)
         (Q_S : Fin (2 * r) → Fin (2 * r) → S) (u : Fin (2 * r) → S),
        let v := (C.map ρ).mulVec u
        ∑ a : Fin (2 * r), ∑ b : Fin (2 * r),
          weilQuadTransform ρ C Q_S a b * u a * u b =
        ∑ i : Fin (2 * r), ∑ j : Fin (2 * r), Q_S i j * v i * v j) ∧
      (∀ a b : Fin (2 * r),
        weilQuadTransform (RingHom.id k) C q a b =
          if (a.1 % 2 = 0 ∧ (b.1 = a.1 ∨ b.1 = a.1 + 1)) then 1 else 0) :=
by
  
  have hPolyId : ∀ (n : ℕ) (C : Matrix (Fin n) (Fin n) k)
      (S : Type u) [CommRing S] (ρ : k →+* S)
      (Q_S : Fin n → Fin n → S) (u : Fin n → S),
      let v := (C.map ρ).mulVec u
      ∑ a : Fin n, ∑ b : Fin n,
        weilQuadTransform ρ C Q_S a b * u a * u b =
      ∑ i : Fin n, ∑ j : Fin n, Q_S i j * v i * v j := by
    intro n C S _ ρ Q_S u v
    let M : Fin n → Fin n → S := fun a b =>
      ∑ i : Fin n, ∑ j : Fin n, Q_S i j * ρ (C i a) * ρ (C j b)
    have hrhs : ∑ i : Fin n, ∑ j : Fin n, Q_S i j * v i * v j =
        ∑ a : Fin n, ∑ b : Fin n, M a b * u a * u b := by
      have h1 : ∀ i j : Fin n,
          Q_S i j * v i * v j =
            ∑ a : Fin n, ∑ b : Fin n, Q_S i j * ρ (C i a) * ρ (C j b) * u a * u b := by
        intro i j
        have hvi : v i = ∑ a : Fin n, ρ (C i a) * u a := by
          simp [v, Matrix.mulVec, dotProduct]
        have hvj : v j = ∑ b : Fin n, ρ (C j b) * u b := by
          simp [v, Matrix.mulVec, dotProduct]
        rw [hvi, hvj, mul_assoc, Finset.sum_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← mul_assoc, Finset.mul_sum]
        refine Finset.sum_congr rfl fun b _ => ?_
        ring
      have h2 : ∀ i : Fin n,
          ∑ j : Fin n, Q_S i j * v i * v j =
            ∑ a : Fin n, ∑ b : Fin n,
              (∑ j : Fin n, Q_S i j * ρ (C i a) * ρ (C j b)) * u a * u b := by
        intro i
        simp_rw [h1 i]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [Finset.sum_mul, Finset.sum_mul]
      simp_rw [h2]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun b _ => ?_
      dsimp [M]
      rw [Finset.sum_mul, Finset.sum_mul]
    let L₁ : Fin n → Fin n → S := fun a b => (if b < a then 0 else M a b) * u a * u b
    let L₂ : Fin n → Fin n → S := fun a b => (if a < b then M b a else 0) * u a * u b
    have hpt : ∀ a b : Fin n,
        weilQuadTransform ρ C Q_S a b * u a * u b = L₁ a b + L₂ a b := by
      intro a b
      dsimp [weilQuadTransform, L₁, L₂]
      rcases lt_trichotomy a b with hab | rfl | hba
      · have hnba : ¬ (b < a) := lt_asymm hab
        have hne : a ≠ b := ne_of_lt hab
        simp only [hnba, hne, hab, ↓reduceIte]
        have hsum : (∑ i : Fin n, ∑ j : Fin n,
            Q_S i j * (ρ (C i a) * ρ (C j b) + ρ (C i b) * ρ (C j a))) = M a b + M b a := by
          dsimp [M]
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          ring
        rw [hsum]
        ring
      · simp only [lt_irrefl, ↓reduceIte]
        dsimp [M]
        ring
      · have hnab : ¬ (a < b) := lt_asymm hba
        simp only [hba, hnab, ↓reduceIte]
        ring
    have hlhs : ∑ a : Fin n, ∑ b : Fin n, weilQuadTransform ρ C Q_S a b * u a * u b =
        ∑ a : Fin n, ∑ b : Fin n, M a b * u a * u b := by
      simp_rw [hpt, Finset.sum_add_distrib]
      have hcomm2 : (∑ a : Fin n, ∑ b : Fin n, L₂ a b) = ∑ a : Fin n, ∑ b : Fin n, L₂ b a :=
        Finset.sum_comm
      rw [hcomm2]
      simp_rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      refine Finset.sum_congr rfl fun b _ => ?_
      dsimp [L₁, L₂]
      by_cases hba : b < a
      · simp only [hba, ↓reduceIte]
        ring
      · simp only [hba, ↓reduceIte]
        ring
    exact hlhs.trans hrhs.symm

  
  let NMat : ∀ m : ℕ, Matrix (Fin (2 * m)) (Fin (2 * m)) k :=
    fun m => Matrix.of fun a b =>
      if (a.1 % 2 = 0 ∧ (b.1 = a.1 ∨ b.1 = a.1 + 1)) then 1 else 0
  have hNMat_tri : ∀ (m : ℕ) (a b : Fin (2 * m)), b < a → NMat m a b = 0 := by
    intro m a b hba
    dsimp [NMat]
    have hlt : b.1 < a.1 := hba
    have hfalse : ¬ (a.1 % 2 = 0 ∧ (b.1 = a.1 ∨ b.1 = a.1 + 1)) := by omega
    simp [hfalse]
  have hCongSym : ∀ {ι : Type} [Fintype ι] [DecidableEq ι] (Q C : Matrix ι ι k),
      (C.transpose * Q * C) + (C.transpose * Q * C).transpose =
        C.transpose * (Q + Q.transpose) * C := by
    intro ι _ _ Q C
    simp only [Matrix.transpose_mul, Matrix.transpose_transpose,
      Matrix.mul_add, Matrix.add_mul, Matrix.mul_assoc]
  have hCongDet : ∀ {ι : Type} [Fintype ι] [DecidableEq ι] (Q C : Matrix ι ι k),
      IsUnit C.det → (Q + Q.transpose).det ≠ 0 →
        ((C.transpose * Q * C) + (C.transpose * Q * C).transpose).det ≠ 0 := by
    intro ι _ _ Q C hC hQ
    rw [hCongSym, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    have hC0 : C.det ≠ 0 := IsUnit.ne_zero hC
    exact mul_ne_zero (mul_ne_zero hC0 hQ) hC0

  let J₂ : Matrix (Fin 2) (Fin 2) k := !![0, 1; 1, 0]
  have hJ₂_sq : J₂ * J₂ = 1 := by
    ext a b
    fin_cases a <;> fin_cases b <;> simp [J₂, Matrix.mul_apply, Fin.sum_univ_two]

  
  have hPivot : ∀ (n : ℕ) (Q₀ : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k),
      (Q₀ + Q₀.transpose).det ≠ 0 →
      ∃ C_piv : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k,
        IsUnit C_piv.det ∧
        let A₃ := (C_piv.transpose * Q₀ * C_piv).toBlocks₁₁
        A₃ 0 0 = 0 ∧ A₃ 1 1 = 0 ∧ A₃ + A₃.transpose = J₂ := by
    intro n Q₀ hQ₀
    let i₀ : Fin 2 ⊕ Fin n := Sum.inl 0
    let i₁ : Fin 2 ⊕ Fin n := Sum.inl 1
    have hStep1 : ∃ C₁ : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k,
        IsUnit C₁.det ∧ (C₁.transpose * Q₀ * C₁) i₀ i₀ = 0 := by
      let A₀ := Q₀.toBlocks₁₁
      by_cases ha00 : A₀ 0 0 = 0
      · refine ⟨1, ?_, ?_⟩
        · rw [Matrix.det_one]
          exact isUnit_one
        · rw [Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one]
          exact ha00
      · let P_iso : Polynomial k :=
          Polynomial.C (A₀ 0 0) * Polynomial.X ^ 2 +
            (Polynomial.C (A₀ 0 1 + A₀ 1 0) * Polynomial.X + Polynomial.C (A₀ 1 1))
        have hdeg2 : (Polynomial.C (A₀ 0 0) * Polynomial.X ^ 2).degree = 2 :=
          Polynomial.degree_C_mul_X_pow 2 ha00
        have hdeg1 :
            (Polynomial.C (A₀ 0 1 + A₀ 1 0) * Polynomial.X + Polynomial.C (A₀ 1 1)).degree < 2 := by
          calc
            (Polynomial.C (A₀ 0 1 + A₀ 1 0) * Polynomial.X + Polynomial.C (A₀ 1 1)).degree
              ≤ max (Polynomial.C (A₀ 0 1 + A₀ 1 0) * Polynomial.X).degree
                  (Polynomial.C (A₀ 1 1)).degree := Polynomial.degree_add_le _ _
            _ ≤ max (0 + 1) 0 :=
              max_le_max
                ((Polynomial.degree_mul_le _ _).trans
                  (add_le_add Polynomial.degree_C_le Polynomial.degree_X_le))
                Polynomial.degree_C_le
            _ < 2 := by decide
        have hP_deg : P_iso.degree ≠ 0 := by
          dsimp [P_iso]
          rw [Polynomial.degree_add_eq_left_of_degree_lt (hdeg1.trans_eq hdeg2.symm), hdeg2]
          decide
        obtain ⟨lam, hlam⟩ := IsAlgClosed.exists_root P_iso hP_deg
        have hlam_eq : A₀ 0 0 * lam ^ 2 + ((A₀ 0 1 + A₀ 1 0) * lam + A₀ 1 1) = 0 := by
          simpa [P_iso] using hlam
        let L_iso : Matrix (Fin 2) (Fin 2) k := !![lam, 1; 1, 0]
        let C₁ : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k := Matrix.fromBlocks L_iso 0 0 1
        refine ⟨C₁, ?_, ?_⟩
        · dsimp [C₁]
          rw [Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, mul_one]
          dsimp [L_iso]
          rw [Matrix.det_fin_two_of, mul_zero, zero_sub, mul_one]
          exact isUnit_iff_ne_zero.mpr (neg_ne_zero.mpr one_ne_zero)
        · have hblk : C₁.transpose * Q₀ * C₁ =
              C₁.transpose *
                Matrix.fromBlocks A₀ Q₀.toBlocks₁₂ Q₀.toBlocks₂₁ Q₀.toBlocks₂₂ * C₁ := by
            rw [Matrix.fromBlocks_toBlocks]
          rw [hblk]
          dsimp [C₁, i₀]
          simp only [Matrix.fromBlocks_transpose, Matrix.transpose_zero, Matrix.transpose_one,
            Matrix.fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add,
            Matrix.fromBlocks_apply₁₁]
          simp only [L_iso, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
            Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
          linear_combination hlam_eq
    obtain ⟨C₁, hC₁_unit, hQ₁_00⟩ := hStep1
    let Q₁ := C₁.transpose * Q₀ * C₁
    let B₁ := Q₁ + Q₁.transpose
    have hB₁_det : B₁.det ≠ 0 := hCongDet Q₀ C₁ hC₁_unit hQ₀
    have hB₁_00 : B₁ i₀ i₀ = 0 := by
      simp only [B₁, Matrix.add_apply, Matrix.transpose_apply]
      rw [show Q₁ i₀ i₀ = 0 from hQ₁_00, add_zero]
    have hex_j0 : ∃ j₀ : Fin 2 ⊕ Fin n, B₁ i₀ j₀ ≠ 0 := by
      by_contra hall
      exact hB₁_det (Matrix.det_eq_zero_of_row_eq_zero i₀ fun j =>
        not_ne_iff.mp (not_exists.mp hall j))
    obtain ⟨j₀, hc⟩ := hex_j0
    let c := B₁ i₀ j₀
    have hi0_j0 : i₀ ≠ j₀ := fun h => hc (h ▸ hB₁_00)
    have hi0_i1 : i₀ ≠ i₁ := by simp [i₀, i₁]
    let σ := Equiv.swap i₁ j₀
    have hσ_i0 : σ i₀ = i₀ := Equiv.swap_apply_of_ne_of_ne hi0_i1 hi0_j0
    have hσ_i1 : σ i₁ = j₀ := Equiv.swap_apply_left i₁ j₀
    let P_σ : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k :=
      (1 : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k).submatrix id σ
    have hP_tr : P_σ.transpose =
        (1 : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k).submatrix σ id := by
      dsimp [P_σ]
      rw [Matrix.transpose_submatrix, Matrix.transpose_one]
    have hP_unit : IsUnit P_σ.det := by
      have hmul : P_σ * P_σ.transpose = 1 := by
        rw [hP_tr]
        dsimp [P_σ]
        rw [Matrix.submatrix_mul_equiv _ _ id σ id, Matrix.mul_one, Matrix.submatrix_id_id]
      have hdet1 : P_σ.det * P_σ.det = 1 := by
        have hd := congrArg Matrix.det hmul
        rwa [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hd
      exact isUnit_iff_ne_zero.mpr fun h0 =>
        one_ne_zero (by rw [← hdet1, h0, zero_mul])
    have hP_conj : ∀ M : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k,
        P_σ.transpose * M * P_σ = M.submatrix σ σ := by
      intro M
      have hleft : P_σ.transpose * M = M.submatrix σ id := by
        rw [hP_tr]
        calc
          (1 : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k).submatrix σ id * M
            = (1 : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k).submatrix σ (Equiv.refl _) *
                M.submatrix (Equiv.refl _) id := rfl
          _ = (1 * M).submatrix σ id :=
              Matrix.submatrix_mul_equiv _ _ σ (Equiv.refl _) id
          _ = M.submatrix σ id := by rw [Matrix.one_mul]
      rw [hleft]
      calc
        M.submatrix σ id * P_σ
          = M.submatrix σ (Equiv.refl _) *
              (1 : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k).submatrix (Equiv.refl _) σ := rfl
        _ = (M * 1).submatrix σ σ :=
            Matrix.submatrix_mul_equiv _ _ σ (Equiv.refl _) σ
        _ = M.submatrix σ σ := by rw [Matrix.mul_one]
    let Q₁₅ := P_σ.transpose * Q₁ * P_σ
    have hQ₁₅_00 : Q₁₅ i₀ i₀ = 0 := by
      dsimp [Q₁₅]
      rw [hP_conj, Matrix.submatrix_apply, hσ_i0]
      exact hQ₁_00
    have hQ₁₅_01 : Q₁₅ i₀ i₁ + Q₁₅ i₁ i₀ = c := by
      dsimp [Q₁₅, c, B₁]
      rw [hP_conj]
      simp [Matrix.submatrix_apply, hσ_i0, hσ_i1]
    let S_sc : Matrix (Fin 2) (Fin 2) k := !![1, 0; 0, c⁻¹]
    let D_sc : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k := Matrix.fromBlocks S_sc 0 0 1
    have hD_unit : IsUnit D_sc.det := by
      dsimp [D_sc, S_sc]
      rw [Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, mul_one, Matrix.det_fin_two_of]
      simp only [one_mul, mul_zero, sub_zero, isUnit_iff_ne_zero]
      exact inv_ne_zero hc
    let Q₂ := D_sc.transpose * Q₁₅ * D_sc
    let A₂ := Q₂.toBlocks₁₁
    have hA₂_eq : A₂ = S_sc.transpose * Q₁₅.toBlocks₁₁ * S_sc := by
      have h := congrArg Matrix.toBlocks₁₁
        (show D_sc.transpose * Q₁₅ * D_sc =
          D_sc.transpose *
            Matrix.fromBlocks Q₁₅.toBlocks₁₁ Q₁₅.toBlocks₁₂ Q₁₅.toBlocks₂₁ Q₁₅.toBlocks₂₂ *
            D_sc by rw [Matrix.fromBlocks_toBlocks])
      simpa [A₂, Q₂, D_sc, Matrix.fromBlocks_transpose, Matrix.fromBlocks_multiply] using h
    have hA₂_00 : A₂ 0 0 = 0 := by
      rw [hA₂_eq]
      simp only [S_sc, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
      have h00 : Q₁₅.toBlocks₁₁ 0 0 = 0 := hQ₁₅_00
      linear_combination h00
    have hA₂_sum : A₂ 0 1 + A₂ 1 0 = 1 := by
      rw [hA₂_eq]
      simp only [S_sc, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
      have h01 : Q₁₅.toBlocks₁₁ 0 1 + Q₁₅.toBlocks₁₁ 1 0 = c := hQ₁₅_01
      calc
        (1 * Q₁₅.toBlocks₁₁ 0 0 + 0 * Q₁₅.toBlocks₁₁ 1 0) * 0 +
            (1 * Q₁₅.toBlocks₁₁ 0 1 + 0 * Q₁₅.toBlocks₁₁ 1 1) * c⁻¹ +
          ((0 * Q₁₅.toBlocks₁₁ 0 0 + c⁻¹ * Q₁₅.toBlocks₁₁ 1 0) * 1 +
            (0 * Q₁₅.toBlocks₁₁ 0 1 + c⁻¹ * Q₁₅.toBlocks₁₁ 1 1) * 0)
          = (Q₁₅.toBlocks₁₁ 0 1 + Q₁₅.toBlocks₁₁ 1 0) * c⁻¹ := by ring
        _ = c * c⁻¹ := by rw [h01]
        _ = 1 := mul_inv_cancel₀ hc
    let μ := A₂ 1 1
    let K_μ : Matrix (Fin 2) (Fin 2) k := !![1, -μ; 0, 1]
    let C₃ : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k := Matrix.fromBlocks K_μ 0 0 1
    have hC₃_unit : IsUnit C₃.det := by
      dsimp [C₃, K_μ]
      rw [Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, mul_one, Matrix.det_fin_two_of]
      simp
    let C_piv := C₁ * P_σ * D_sc * C₃
    have hCpiv_unit : IsUnit C_piv.det := by
      dsimp [C_piv]
      rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_mul]
      exact ((hC₁_unit.mul hP_unit).mul hD_unit).mul hC₃_unit
    have hQ₃_eq : C_piv.transpose * Q₀ * C_piv = C₃.transpose * Q₂ * C₃ := by
      dsimp [C_piv, Q₂, Q₁₅, Q₁]
      simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    have hA₃_eq : (C_piv.transpose * Q₀ * C_piv).toBlocks₁₁ = K_μ.transpose * A₂ * K_μ := by
      rw [hQ₃_eq]
      have h := congrArg Matrix.toBlocks₁₁
        (show C₃.transpose * Q₂ * C₃ =
          C₃.transpose *
            Matrix.fromBlocks A₂ Q₂.toBlocks₁₂ Q₂.toBlocks₂₁ Q₂.toBlocks₂₂ *
            C₃ by rw [Matrix.fromBlocks_toBlocks])
      simpa [C₃, Matrix.fromBlocks_transpose, Matrix.fromBlocks_multiply] using h
    refine ⟨C_piv, hCpiv_unit, ?_⟩
    dsimp only
    rw [hA₃_eq]
    have h3_00 : (K_μ.transpose * A₂ * K_μ) 0 0 = 0 := by
      simp only [K_μ, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, hA₂_00]
      ring
    have h3_11 : (K_μ.transpose * A₂ * K_μ) 1 1 = 0 := by
      simp only [K_μ, μ, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, hA₂_00]
      linear_combination -(A₂ 1 1) * hA₂_sum
    have h3_sum : (K_μ.transpose * A₂ * K_μ) 0 1 + (K_μ.transpose * A₂ * K_μ) 1 0 = 1 := by
      simp only [K_μ, μ, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, hA₂_00]
      linear_combination hA₂_sum
    refine ⟨h3_00, h3_11, ?_⟩
    ext a b
    simp only [Matrix.add_apply, Matrix.transpose_apply]
    fin_cases a <;> fin_cases b <;> simp only [Fin.zero_eta, Fin.mk_one]
    · rw [h3_00, add_zero]; rfl
    · exact h3_sum
    · rw [add_comm]; exact h3_sum
    · rw [h3_11, add_zero]; rfl

  
  have hSchur : ∀ (n : ℕ) (Q₃ : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k),
      (Q₃ + Q₃.transpose).det ≠ 0 →
      Q₃.toBlocks₁₁ 0 0 = 0 →
      Q₃.toBlocks₁₁ 1 1 = 0 →
      Q₃.toBlocks₁₁ + Q₃.toBlocks₁₁.transpose = J₂ →
      ∃ (C_schur : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k)
        (U₄ : Matrix (Fin 2) (Fin n) k)
        (L₄ : Matrix (Fin n) (Fin 2) k)
        (D' : Matrix (Fin n) (Fin n) k),
        IsUnit C_schur.det ∧
        C_schur.transpose * Q₃ * C_schur = Matrix.fromBlocks Q₃.toBlocks₁₁ U₄ L₄ D' ∧
        (C_schur.transpose * Q₃ * C_schur) + (C_schur.transpose * Q₃ * C_schur).transpose =
          Matrix.fromBlocks J₂ 0 0 (D' + D'.transpose) ∧
        (D' + D'.transpose).det ≠ 0 := by
    intro n Q₃ hQ₃_det hA₃_00 hA₃_11 hA₃_sym
    let A₃ := Q₃.toBlocks₁₁
    let U₃ := Q₃.toBlocks₁₂
    let L₃ := Q₃.toBlocks₂₁
    let D₃ := Q₃.toBlocks₂₂
    let W : Matrix (Fin 2) (Fin n) k := U₃ + L₃.transpose
    let X : Matrix (Fin 2) (Fin n) k := -(J₂ * W)
    let C_schur : Matrix (Fin 2 ⊕ Fin n) (Fin 2 ⊕ Fin n) k := Matrix.fromBlocks 1 X 0 1
    have hCs_unit : IsUnit C_schur.det := by
      dsimp [C_schur]
      rw [Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, Matrix.det_one, mul_one]
      exact isUnit_one
    let U₄ : Matrix (Fin 2) (Fin n) k := A₃ * X + U₃
    let L₄ : Matrix (Fin n) (Fin 2) k := X.transpose * A₃ + L₃
    let D' : Matrix (Fin n) (Fin n) k := (X.transpose * A₃ + L₃) * X + (X.transpose * U₃ + D₃)
    have hQ₄_blk : C_schur.transpose * Q₃ * C_schur = Matrix.fromBlocks A₃ U₄ L₄ D' := by
      have h := congrArg (fun M => C_schur.transpose * M * C_schur)
        (Matrix.fromBlocks_toBlocks Q₃).symm
      rw [h]
      dsimp [C_schur, A₃, U₃, L₃, D₃, U₄, L₄, D']
      simp only [Matrix.fromBlocks_transpose, Matrix.transpose_one, Matrix.transpose_zero,
        Matrix.fromBlocks_multiply, Matrix.one_mul, Matrix.mul_one, Matrix.zero_mul,
        Matrix.mul_zero, add_zero]
    have hcross : U₄ + L₄.transpose = 0 := by
      dsimp [U₄, L₄]
      rw [Matrix.transpose_add, Matrix.transpose_mul, Matrix.transpose_transpose]
      have h_rearrange : (A₃ * X + U₃) + (A₃.transpose * X + L₃.transpose) =
          (A₃ + A₃.transpose) * X + W := by
        dsimp [W]
        rw [Matrix.add_mul]
        abel
      rw [h_rearrange, hA₃_sym]
      dsimp [X]
      rw [Matrix.mul_neg, ← Matrix.mul_assoc, hJ₂_sq, Matrix.one_mul, neg_add_cancel]
    have hcross_tr : L₄ + U₄.transpose = 0 := by
      have ht := congrArg Matrix.transpose hcross
      rwa [Matrix.transpose_add, Matrix.transpose_transpose, Matrix.transpose_zero, add_comm] at ht
    have hQ₄_sym :
        (C_schur.transpose * Q₃ * C_schur) + (C_schur.transpose * Q₃ * C_schur).transpose =
          Matrix.fromBlocks J₂ 0 0 (D' + D'.transpose) := by
      rw [hQ₄_blk, Matrix.fromBlocks_transpose, Matrix.fromBlocks_add, hA₃_sym, hcross, hcross_tr]
    have hQ₄_det :
        ((C_schur.transpose * Q₃ * C_schur) + (C_schur.transpose * Q₃ * C_schur).transpose).det ≠ 0 :=
      hCongDet Q₃ C_schur hCs_unit hQ₃_det
    have hD'_det : (D' + D'.transpose).det ≠ 0 := by
      rw [hQ₄_sym, Matrix.det_fromBlocks_zero₂₁] at hQ₄_det
      exact right_ne_zero_of_mul hQ₄_det
    exact ⟨C_schur, U₄, L₄, D', hCs_unit, hQ₄_blk, hQ₄_sym, hD'_det⟩

  
  have hInd : ∀ (m : ℕ) (Q : Matrix (Fin (2 * m)) (Fin (2 * m)) k),
      (Q + Q.transpose).det ≠ 0 →
      ∃ C : Matrix (Fin (2 * m)) (Fin (2 * m)) k,
        IsUnit C.det ∧
        (∀ a : Fin (2 * m), (C.transpose * Q * C) a a = NMat m a a) ∧
        (C.transpose * Q * C) + (C.transpose * Q * C).transpose =
          NMat m + (NMat m).transpose := by
    intro m
    induction m with
    | zero =>
      intro Q _
      refine ⟨1, ?_, ?_, ?_⟩
      · rw [Matrix.det_one]
        exact isUnit_one
      · intro a
        exact Fin.elim0 a
      · ext a b
        exact Fin.elim0 a
    | succ m ih =>
      intro Q hQ_det
      let e : Fin 2 ⊕ Fin (2 * m) ≃ Fin (2 * (m + 1)) :=
        finSumFinEquiv.trans (finCongr (by omega : 2 + 2 * m = 2 * (m + 1)))
      have he_inl : ∀ a : Fin 2, (e (Sum.inl a)).1 = a.1 := by
        intro a
        simp [e, finSumFinEquiv_apply_left]
      have he_inr : ∀ s : Fin (2 * m), (e (Sum.inr s)).1 = 2 + s.1 := by
        intro s
        simp [e, finSumFinEquiv_apply_right, Nat.add_comm]
      let N₁ : Matrix (Fin 2) (Fin 2) k := !![1, 1; 0, 0]
      have hNMat_succ : (NMat (m + 1)).submatrix e e = Matrix.fromBlocks N₁ 0 0 (NMat m) := by
        ext x y
        rcases x with a | s <;> rcases y with b | t
        · fin_cases a <;> fin_cases b <;>
            simp [NMat, N₁, Matrix.submatrix_apply, he_inl]
        · simp only [NMat, Matrix.submatrix_apply, Matrix.fromBlocks_apply₁₂, Matrix.zero_apply,
            Matrix.of_apply, he_inl, he_inr]
          have ha2 : a.1 < 2 := a.2
          split_ifs <;> first | rfl | omega
        · simp only [NMat, Matrix.submatrix_apply, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
            Matrix.of_apply, he_inl, he_inr]
          have hb2 : b.1 < 2 := b.2
          split_ifs <;> first | rfl | omega
        · simp only [NMat, Matrix.submatrix_apply, Matrix.fromBlocks_apply₂₂,
            Matrix.of_apply, he_inr]
          split_ifs <;> first | rfl | omega
      let Q₀ := Q.submatrix e e
      have hQ₀_det : (Q₀ + Q₀.transpose).det ≠ 0 := by
        have hsub : Q₀ + Q₀.transpose = (Q + Q.transpose).submatrix e e := by
          ext x y
          rfl
        rw [hsub, Matrix.det_submatrix_equiv_self]
        exact hQ_det
      obtain ⟨C_piv, hCpiv_unit, hA₃_00, hA₃_11, hA₃_sym⟩ := hPivot (2 * m) Q₀ hQ₀_det
      let Q₃ := C_piv.transpose * Q₀ * C_piv
      have hQ₃_det : (Q₃ + Q₃.transpose).det ≠ 0 := hCongDet Q₀ C_piv hCpiv_unit hQ₀_det
      obtain ⟨C_schur, U₄, L₄, D', hCs_unit, hQ₄_blk, hQ₄_sym, hD'_det⟩ :=
        hSchur (2 * m) Q₃ hQ₃_det hA₃_00 hA₃_11 hA₃_sym
      obtain ⟨C_rem, hCrem_unit, hCrem_diag, hCrem_sym⟩ := ih D' hD'_det
      let S₁ : Matrix (Fin 2) (Fin 2) k := !![1, 0; 1, 1]
      let C_step2 : Matrix (Fin 2 ⊕ Fin (2 * m)) (Fin 2 ⊕ Fin (2 * m)) k :=
        Matrix.fromBlocks S₁ 0 0 C_rem
      have hCstep2_unit : IsUnit C_step2.det := by
        dsimp [C_step2, S₁]
        rw [Matrix.det_fromBlocks_zero₂₁, Matrix.det_fin_two_of]
        simp only [mul_one, sub_zero, one_mul]
        exact hCrem_unit
      let C_pre := C_piv * C_schur
      have hCpre_unit : IsUnit C_pre.det := by
        dsimp [C_pre]
        rw [Matrix.det_mul]
        exact hCpiv_unit.mul hCs_unit
      let C_blk := C_pre * C_step2
      have hCblk_unit : IsUnit C_blk.det := by
        dsimp [C_blk]
        rw [Matrix.det_mul]
        exact hCpre_unit.mul hCstep2_unit
      let A₃ := Q₃.toBlocks₁₁
      have hM_blk_eq : C_blk.transpose * Q₀ * C_blk =
          Matrix.fromBlocks (S₁.transpose * A₃ * S₁) (S₁.transpose * U₄ * C_rem)
            (C_rem.transpose * L₄ * S₁) (C_rem.transpose * D' * C_rem) := by
        have h1 : C_blk.transpose * Q₀ * C_blk =
            C_step2.transpose * (C_schur.transpose * Q₃ * C_schur) * C_step2 := by
          dsimp [C_blk, C_pre, Q₃]
          simp only [Matrix.transpose_mul, Matrix.mul_assoc]
        rw [h1, hQ₄_blk]
        dsimp [C_step2, A₃]
        simp only [Matrix.fromBlocks_transpose, Matrix.transpose_zero,
          Matrix.fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
      have hA₃_01 : A₃ 0 1 + A₃ 1 0 = 1 := by
        have h := congrArg (fun M => M 0 1) hA₃_sym
        simpa [A₃, J₂] using h
      have hS₁_diag : ∀ a : Fin 2, (S₁.transpose * A₃ * S₁) a a = N₁ a a := by
        intro a
        fin_cases a <;> simp only [Fin.zero_eta, Fin.mk_one]
        · simp only [S₁, N₁, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
            Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
          have h00 : A₃ 0 0 = 0 := hA₃_00
          have h11 : A₃ 1 1 = 0 := hA₃_11
          linear_combination h00 + hA₃_01 + h11
        · simp only [S₁, N₁, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two,
            Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
          have h11 : A₃ 1 1 = 0 := hA₃_11
          linear_combination h11
      have hM_blk_diag : ∀ x : Fin 2 ⊕ Fin (2 * m),
          (C_blk.transpose * Q₀ * C_blk) x x = ((NMat (m + 1)).submatrix e e) x x := by
        intro x
        rw [hM_blk_eq, hNMat_succ]
        rcases x with a | t
        · simp only [Matrix.fromBlocks_apply₁₁]
          exact hS₁_diag a
        · simp only [Matrix.fromBlocks_apply₂₂]
          exact hCrem_diag t
      have hS₁_J₂ : S₁.transpose * J₂ * S₁ = N₁ + N₁.transpose := by
        ext a b
        fin_cases a <;> fin_cases b <;>
          simp [S₁, J₂, N₁, Matrix.mul_apply, Fin.sum_univ_two]
      have hM_blk_sym :
          (C_blk.transpose * Q₀ * C_blk) + (C_blk.transpose * Q₀ * C_blk).transpose =
            (NMat (m + 1) + (NMat (m + 1)).transpose).submatrix e e := by
        have h1 : (C_blk.transpose * Q₀ * C_blk) + (C_blk.transpose * Q₀ * C_blk).transpose =
            C_step2.transpose *
              ((C_schur.transpose * Q₃ * C_schur) + (C_schur.transpose * Q₃ * C_schur).transpose) *
              C_step2 := by
          rw [← hCongSym]
          dsimp [C_blk, C_pre, Q₃]
          simp only [Matrix.transpose_mul, Matrix.mul_assoc]
        rw [h1, hQ₄_sym]
        dsimp [C_step2]
        simp only [Matrix.fromBlocks_transpose, Matrix.transpose_zero,
          Matrix.fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
        rw [hS₁_J₂, ← hCongSym D' C_rem, hCrem_sym]
        have hsub_n : (NMat (m + 1) + (NMat (m + 1)).transpose).submatrix e e =
            (NMat (m + 1)).submatrix e e + ((NMat (m + 1)).submatrix e e).transpose := by
          ext x y
          rfl
        rw [hsub_n, hNMat_succ]
        simp only [Matrix.fromBlocks_transpose, Matrix.transpose_zero,
          Matrix.fromBlocks_add, add_zero]
      let C := C_blk.submatrix e.symm e.symm
      have hC_unit : IsUnit C.det := by
        dsimp [C]
        rw [Matrix.det_submatrix_equiv_self]
        exact hCblk_unit
      have hC_conj : C.transpose * Q * C =
          (C_blk.transpose * Q₀ * C_blk).submatrix e.symm e.symm := by
        have hQ_eq : Q = Q₀.submatrix e.symm e.symm := by
          dsimp [Q₀]
          rw [Matrix.submatrix_submatrix, Equiv.self_comp_symm, Matrix.submatrix_id_id]
        have hCtr : C.transpose = C_blk.transpose.submatrix e.symm e.symm := by
          dsimp [C]
          rw [Matrix.transpose_submatrix]
        calc
          C.transpose * Q * C
            = (C_blk.transpose.submatrix e.symm e.symm * Q₀.submatrix e.symm e.symm) *
                C_blk.submatrix e.symm e.symm := by rw [hCtr, ← hQ_eq]
          _ = (C_blk.transpose * Q₀).submatrix e.symm e.symm *
                C_blk.submatrix e.symm e.symm := by
              rw [Matrix.submatrix_mul_equiv _ _ e.symm e.symm e.symm]
          _ = (C_blk.transpose * Q₀ * C_blk).submatrix e.symm e.symm :=
              Matrix.submatrix_mul_equiv _ _ e.symm e.symm e.symm
      refine ⟨C, hC_unit, ?_, ?_⟩
      · intro a
        rw [hC_conj, Matrix.submatrix_apply, hM_blk_diag (e.symm a)]
        simp [Matrix.submatrix_apply]
      · have hsub_c :
            (C_blk.transpose * Q₀ * C_blk).submatrix e.symm e.symm +
              ((C_blk.transpose * Q₀ * C_blk).submatrix e.symm e.symm).transpose =
            ((C_blk.transpose * Q₀ * C_blk) +
              (C_blk.transpose * Q₀ * C_blk).transpose).submatrix e.symm e.symm := by
          ext x y
          rfl
        rw [hC_conj, hsub_c, hM_blk_sym,
          Matrix.submatrix_submatrix, Equiv.self_comp_symm, Matrix.submatrix_id_id]

  
  let Q_init : Matrix (Fin (2 * r)) (Fin (2 * r)) k := Matrix.of q
  have hQ_init_polar : Q_init + Q_init.transpose =
      Matrix.of fun i j : Fin (2 * r) =>
        if i = j then 2 * q i i else if i < j then q i j else q j i := by
    ext i j
    simp only [Q_init, Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply]
    rcases lt_trichotomy i j with hij | rfl | hji
    · have hne : i ≠ j := ne_of_lt hij
      simp [hne, hij, hq_tri j i hij]
    · simp [two_mul]
    · have hne : i ≠ j := ne_of_gt hji
      have hnij : ¬ (i < j) := lt_asymm hji
      simp [hne, hnij, hq_tri i j hji]
  have hQ_init_det : (Q_init + Q_init.transpose).det ≠ 0 := by
    rw [hQ_init_polar]
    exact hq_det
  obtain ⟨C, hC_unit, hC_diag, hC_sym⟩ := hInd r Q_init hQ_init_det
  refine ⟨C, hC_unit, fun S _ ρ Q_S u => hPolyId (2 * r) C S ρ Q_S u, ?_⟩
  have hM_entry : ∀ a b : Fin (2 * r),
      (C.transpose * Q_init * C) a b =
        ∑ i : Fin (2 * r), ∑ j : Fin (2 * r), q i j * C i a * C j b := by
    intro a b
    simp only [Q_init, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply,
      Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  intro a b
  change weilQuadTransform (RingHom.id k) C q a b = NMat r a b
  dsimp [weilQuadTransform]
  rcases lt_trichotomy a b with hab | rfl | hba
  · have hnba : ¬ (b < a) := lt_asymm hab
    have hne : a ≠ b := ne_of_lt hab
    simp only [hnba, hne, ↓reduceIte]
    have hsum : (∑ i : Fin (2 * r), ∑ j : Fin (2 * r),
        q i j * (C i a * C j b + C i b * C j a)) =
        (C.transpose * Q_init * C) a b + (C.transpose * Q_init * C) b a := by
      rw [hM_entry a b, hM_entry b a, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [hsum]
    have hsym_ab := congrArg (fun M => M a b) hC_sym
    simp only [Matrix.add_apply, Matrix.transpose_apply] at hsym_ab
    rw [hsym_ab, hNMat_tri r b a hab, add_zero]
  · simp only [lt_irrefl, ↓reduceIte]
    rw [← hM_entry a a, hC_diag a]
  · simp only [hba, ↓reduceIte]
    exact (hNMat_tri r a b hba).symm

theorem weil_ring_hyperbolic_adjoinRoot_quad_splitting (k : Type u) [Field k] (r : ℕ)
    (S : Type u) [CommRing S] (ε_S : S →+* k)
    (A : Fin (2 * r) → Fin (2 * r) → S)
    (hA_tri : ∀ i j : Fin (2 * r), j < i → A i j = 0)
    (hA_eval : ∀ a b : Fin (2 * r),
      ε_S (A a b) = if (a.1 % 2 = 0 ∧ (b.1 = a.1 ∨ b.1 = a.1 + 1)) then 1 else 0) :
    ∃ (S' : CommRingCat.{u})
      (φ : S →+* S') (ε_S' : S' →+* k)
      (M_sq : Matrix (Fin (2 * r)) (Fin (2 * r)) S'),
      φ.Etale ∧
      ε_S'.comp φ = ε_S ∧
      IsUnit M_sq.det ∧
      (∀ w : Fin (2 * r) → S',
        ∑ s : Fin r,
          (∑ j : Fin (2 * r), M_sq ⟨2 * s.1, by omega⟩ j * w j) *
          (∑ j : Fin (2 * r), M_sq ⟨2 * s.1 + 1, by omega⟩ j * w j) =
        ∑ i : Fin (2 * r), ∑ j : Fin (2 * r), φ (A i j) * w i * w j) :=
by
  revert S
  induction r with
  | zero =>
    intro S _ ε_S A hA_tri hA_eval
    refine ⟨CommRingCat.of S, RingHom.id S, ε_S, 1, ?_, ?_, ?_, ?_⟩
    · exact RingHom.Etale.of_bijective Function.bijective_id
    · ext x; rfl
    · change IsUnit (1 : Matrix (Fin (2 * 0)) (Fin (2 * 0)) S).det
      rw [Matrix.det_one]
      exact isUnit_one
    · intro w
      have hL : (∑ s : Fin 0,
          (∑ j : Fin (2 * 0),
            (1 : Matrix (Fin (2 * 0)) (Fin (2 * 0)) S) ⟨2 * s.1, by omega⟩ j * w j) *
          (∑ j : Fin (2 * 0),
            (1 : Matrix (Fin (2 * 0)) (Fin (2 * 0)) S) ⟨2 * s.1 + 1, by omega⟩ j * w j)) = 0 := by
        simp
      have hR : (∑ i : Fin (2 * 0), ∑ j : Fin (2 * 0),
          (RingHom.id S) (A i j) * w i * w j) = 0 := by
        refine Finset.sum_eq_zero fun i _ => ?_
        exact absurd i.2 (by omega)
      exact hL.trans hR.symm
  | succ r ih =>
    intro S _ ε_S A hA_tri hA_eval
    have : Nontrivial S := ε_S.domain_nontrivial
    let i0 : Fin (2 * (r + 1)) := ⟨0, by omega⟩
    let i1 : Fin (2 * (r + 1)) := ⟨1, by omega⟩
    let a00 : S := A i0 i0
    let a01 : S := A i0 i1
    let a11 : S := A i1 i1
    have hA10 : A i1 i0 = 0 := hA_tri i1 i0 (by show (0 : ℕ) < 1; omega)
    have hε00 : ε_S a00 = 1 := by simpa [a00, i0] using hA_eval i0 i0
    have hε01 : ε_S a01 = 1 := by simpa [a01, i0, i1] using hA_eval i0 i1
    have hε11 : ε_S a11 = 0 := by simpa [a11, i1] using hA_eval i1 i1
    let D0 : S := a01 ^ 2 - 4 * a00 * a11
    let u0 : S := a00 * D0
    have hε_u0 : ε_S u0 = 1 := by
      simp only [u0, D0, map_mul, map_sub, map_pow, map_ofNat, hε00, hε01, hε11]
      ring
    let f0 : Polynomial S :=
      Polynomial.X ^ 2 - Polynomial.C a01 * Polynomial.X + Polynomial.C (a00 * a11)
    let g0 : Polynomial S := Polynomial.C u0
    have hf0_monic : f0.Monic := by
      have hrew : f0 = Polynomial.X ^ 2 +
          (-(Polynomial.C a01 * Polynomial.X) + Polynomial.C (a00 * a11)) := by
        dsimp [f0]; ring
      rw [hrew]
      refine (Polynomial.monic_X_pow 2).add_of_left ?_
      rw [Polynomial.degree_X_pow 2]
      have hd1 : (-(Polynomial.C a01 * Polynomial.X) : Polynomial S).degree ≤ 1 := by
        rw [Polynomial.degree_neg]
        exact Polynomial.degree_C_mul_X_le a01
      have hd2 : (Polynomial.C (a00 * a11) : Polynomial S).degree ≤ 1 :=
        (Polynomial.degree_C_le).trans (by decide)
      exact (Polynomial.degree_add_le _ _).trans_lt ((max_le hd1 hd2).trans_lt (by decide))
    have hderiv_f0 : Polynomial.derivative f0 = 2 * Polynomial.X - Polynomial.C a01 := by
      dsimp [f0]
      simp only [map_add, map_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C_mul,
        Polynomial.derivative_X, Polynomial.derivative_C, Nat.cast_ofNat, map_ofNat]
      ring
    have hbezout : ∃ p₁ p₂ n, Polynomial.derivative f0 * p₁ + f0 * p₂ = g0 ^ n := by
      refine ⟨Polynomial.C a00 * (2 * Polynomial.X - Polynomial.C a01),
        Polynomial.C (-4 * a00), 1, ?_⟩
      rw [hderiv_f0]
      dsimp [f0, g0, u0, D0]
      simp only [pow_one, map_mul, map_sub, map_pow, map_neg, map_ofNat]
      ring
    let P0 : StandardEtalePair S := StandardEtalePair.mk f0 hf0_monic g0 hbezout
    let S1 : Type u := P0.Ring
    let φ1 : S →+* S1 := algebraMap S S1
    let Θ : S1 := P0.X
    have hφ1_et : φ1.Etale := RingHom.etale_algebraMap.mpr inferInstance
    have hε1_pkg : ∃ ε1 : S1 →+* k, ε1.comp φ1 = ε_S := by
      let _ : Algebra S k := ε_S.toAlgebra
      have hAlg : algebraMap S k = ε_S := RingHom.algebraMap_toAlgebra ε_S
      have hHas0 : P0.HasMap (0 : k) := by
        refine ⟨?_, ?_⟩
        · change Polynomial.aeval (0 : k) f0 = 0
          simp only [f0, map_add, map_sub, map_mul, map_pow, Polynomial.aeval_X,
            Polynomial.aeval_C, hAlg, hε11]
          ring
        · change IsUnit (Polynomial.aeval (0 : k) g0)
          simp only [g0, Polynomial.aeval_C, hAlg, hε_u0]
          exact isUnit_one
      let ε1_alg : S1 →ₐ[S] k := P0.lift (0 : k) hHas0
      refine ⟨ε1_alg.toRingHom, ?_⟩
      ext s
      change ε1_alg (algebraMap S S1 s) = ε_S s
      rw [ε1_alg.commutes, hAlg]
    obtain ⟨ε1, hε1_comp⟩ := hε1_pkg
    have hε1_φ1 : ∀ s : S, ε1 (φ1 s) = ε_S s := RingHom.congr_fun hε1_comp
    let a00_bar : S1 := φ1 a00
    let a01_bar : S1 := φ1 a01
    let a11_bar : S1 := φ1 a11
    let D0_bar : S1 := φ1 D0
    have hD0_bar : D0_bar = a01_bar ^ 2 - 4 * a00_bar * a11_bar := by
      simp only [D0_bar, D0, a00_bar, a01_bar, a11_bar, map_sub, map_pow, map_mul, map_ofNat]
    have hHasΘ : P0.HasMap Θ := P0.hasMap_X
    have hΘ_root : Θ ^ 2 - a01_bar * Θ + a00_bar * a11_bar = 0 := by
      have h := hHasΘ.1
      change Polynomial.aeval Θ f0 = 0 at h
      simp only [f0, map_add, map_sub, map_mul, map_pow, Polynomial.aeval_X,
        Polynomial.aeval_C] at h
      exact h
    have hu0_unit : IsUnit (a00_bar * D0_bar) := by
      have h := hHasΘ.2
      change IsUnit (Polynomial.aeval Θ g0) at h
      simp only [g0, u0, Polynomial.aeval_C, map_mul] at h
      exact h
    obtain ⟨v0, hv0⟩ := hu0_unit.exists_right_inv
    let a00_inv : S1 := D0_bar * v0
    let D0_inv : S1 := a00_bar * v0
    have ha00_inv : a00_bar * a00_inv = 1 := by
      dsimp [a00_inv]; linear_combination hv0
    have hD0_inv : D0_bar * D0_inv = 1 := by
      dsimp [D0_inv]; linear_combination hv0
    let dE : S1 := a01_bar - 2 * Θ
    let dE_inv : S1 := dE * D0_inv
    have hdE_sq : dE ^ 2 = D0_bar := by
      dsimp [dE]
      rw [hD0_bar]
      linear_combination 4 * hΘ_root
    have hdE_inv : dE * dE_inv = 1 := by
      dsimp [dE_inv]
      linear_combination D0_inv * hdE_sq + hD0_inv
    have hdE_unit : IsUnit dE :=
      ⟨⟨dE, dE_inv, hdE_inv, mul_comm dE_inv dE ▸ hdE_inv⟩, rfl⟩
    let c11 : S1 := a00_inv * (a01_bar - Θ)
    have hc11_det : a00_bar * c11 - Θ = dE := by
      dsimp [c11, dE]
      linear_combination (a01_bar - Θ) * ha00_inv
    have hc11_tr : a00_bar * c11 + Θ = a01_bar := by
      dsimp [c11]
      linear_combination (a01_bar - Θ) * ha00_inv
    have hc11_prod : Θ * c11 = a11_bar := by
      dsimp [c11]
      linear_combination -a00_inv * hΘ_root + a11_bar * ha00_inv
    let e_split : Fin 2 ⊕ Fin (2 * r) ≃ Fin (2 * (r + 1)) :=
      { toFun := fun x => match x with
          | Sum.inl b => ⟨b.1, by omega⟩
          | Sum.inr t => ⟨t.1 + 2, by omega⟩
        invFun := fun i =>
          if h : i.1 < 2 then Sum.inl ⟨i.1, h⟩ else Sum.inr ⟨i.1 - 2, by omega⟩
        left_inv := fun x => by
          rcases x with ⟨b, hb⟩ | ⟨t, ht⟩
          · dsimp only
            rw [dite_eq_left_of_eq_true (eq_true hb)]
          · dsimp only
            rw [dite_eq_right_of_eq_false (eq_false (by omega))]
            rfl
        right_inv := fun ⟨i, hi⟩ => by
          dsimp
          by_cases h : i < 2
          · simp [h]
          · simp only [h, ↓reduceDIte]
            ext; dsimp; omega }
    have he_inl0 : e_split (Sum.inl 0) = i0 := by ext; rfl
    have he_inl1 : e_split (Sum.inl 1) = i1 := by ext; rfl
    let b0 : Fin (2 * r) → S1 := fun t => φ1 (A i0 (e_split (Sum.inr t)))
    let b1 : Fin (2 * r) → S1 := fun t => φ1 (A i1 (e_split (Sum.inr t)))
    let α : Fin (2 * r) → S1 := fun t => dE_inv * (c11 * b0 t - b1 t)
    let β : Fin (2 * r) → S1 := fun t => dE_inv * (-Θ * b0 t + a00_bar * b1 t)
    have hcross0 : ∀ t : Fin (2 * r), a00_bar * α t + β t = b0 t := by
      intro t
      dsimp [α, β]
      linear_combination (dE_inv * b0 t) * hc11_det + (b0 t) * hdE_inv
    have hcross1 : ∀ t : Fin (2 * r), Θ * α t + c11 * β t = b1 t := by
      intro t
      dsimp [α, β]
      linear_combination (dE_inv * b1 t) * hc11_det + (b1 t) * hdE_inv
    have hε1_b0 : ∀ t : Fin (2 * r), ε1 (b0 t) = 0 := by
      intro t
      dsimp [b0]
      rw [hε1_φ1, hA_eval, ite_eq_right_of_eq_false]
      apply eq_false
      rintro ⟨_, h⟩
      have ht2 : (e_split (Sum.inr t)).1 = t.1 + 2 := rfl
      have hi0_val : i0.1 = 0 := rfl
      omega
    have hε1_b1 : ∀ t : Fin (2 * r), ε1 (b1 t) = 0 := by
      intro t
      dsimp [b1]
      rw [hε1_φ1, hA_eval, ite_eq_right_of_eq_false]
      apply eq_false
      rintro ⟨hmod, _⟩
      exact absurd hmod (by change ¬ (1 % 2 = 0); decide)
    have hε1_α : ∀ t : Fin (2 * r), ε1 (α t) = 0 := by
      intro t
      simp only [α, map_mul, map_sub, hε1_b0 t, hε1_b1 t, mul_zero, sub_zero]
    let A_rem : Fin (2 * r) → Fin (2 * r) → S1 := fun a b =>
      φ1 (A (e_split (Sum.inr a)) (e_split (Sum.inr b))) -
        ((if a ≤ b then α a * β b else 0) + (if a < b then α b * β a else 0))
    have hA_rem_tri : ∀ a b : Fin (2 * r), b < a → A_rem a b = 0 := by
      intro a b hba
      dsimp [A_rem]
      have hlt : e_split (Sum.inr b) < e_split (Sum.inr a) := by
        show b.1 + 2 < a.1 + 2
        exact Nat.add_lt_add_right hba 2
      have h1 : ¬ (a ≤ b) := not_le.mpr hba
      have h2 : ¬ (a < b) := lt_asymm hba
      rw [hA_tri _ _ hlt, map_zero]
      simp [h1, h2]
    have hA_rem_eval : ∀ a b : Fin (2 * r),
        ε1 (A_rem a b) = if (a.1 % 2 = 0 ∧ (b.1 = a.1 ∨ b.1 = a.1 + 1)) then 1 else 0 := by
      intro a b
      have h0_le : ε1 (if a ≤ b then α a * β b else 0) = 0 := by
        split_ifs <;> simp [hε1_α]
      have h0_lt : ε1 (if a < b then α b * β a else 0) = 0 := by
        split_ifs <;> simp [hε1_α]
      dsimp [A_rem]
      rw [map_sub, map_add, h0_le, h0_lt, add_zero, sub_zero, hε1_φ1, hA_eval]
      have hcond : ((e_split (Sum.inr a)).1 % 2 = 0 ∧
          ((e_split (Sum.inr b)).1 = (e_split (Sum.inr a)).1 ∨
            (e_split (Sum.inr b)).1 = (e_split (Sum.inr a)).1 + 1)) ↔
          (a.1 % 2 = 0 ∧ (b.1 = a.1 ∨ b.1 = a.1 + 1)) := by
        dsimp [e_split]
        omega
      simp only [hcond]
    obtain ⟨S', φ_rem, ε_S', M_rem, hφ_rem_et, hε_rem_comp, hM_rem_det, hM_rem_split⟩ :=
      ih S1 ε1 A_rem hA_rem_tri hA_rem_eval
    let φ : S →+* S' := φ_rem.comp φ1
    have hφ_et : φ.Etale := RingHom.Etale.stableUnderComposition _ _ hφ1_et hφ_rem_et
    have hε_comp : ε_S'.comp φ = ε_S := by
      rw [← RingHom.comp_assoc, hε_rem_comp, hε1_comp]
    let B00 : Matrix (Fin 2) (Fin 2) S' := !![φ_rem a00_bar, φ_rem Θ; 1, φ_rem c11]
    let B01 : Matrix (Fin 2) (Fin (2 * r)) S' :=
      Matrix.of fun (b : Fin 2) (t : Fin (2 * r)) =>
        if b = 0 then φ_rem (β t) else φ_rem (α t)
    let M_blk : Matrix (Fin 2 ⊕ Fin (2 * r)) (Fin 2 ⊕ Fin (2 * r)) S' :=
      Matrix.fromBlocks B00 B01 0 M_rem
    let M_sq : Matrix (Fin (2 * (r + 1))) (Fin (2 * (r + 1))) S' :=
      Matrix.reindex e_split e_split M_blk
    have hB00_det : B00.det = φ_rem dE := by
      dsimp [B00]
      rw [Matrix.det_fin_two_of, mul_one, ← map_mul, ← map_sub, hc11_det]
    have hM_sq_det : IsUnit M_sq.det := by
      change IsUnit ((Matrix.reindex e_split e_split (Matrix.fromBlocks B00 B01 0 M_rem)).det)
      rw [Matrix.det_reindex_self, Matrix.det_fromBlocks_zero₂₁, hB00_det]
      exact (hdE_unit.map φ_rem).mul hM_rem_det
    refine ⟨S', φ, ε_S', M_sq, hφ_et, hε_comp, hM_sq_det, ?_⟩
    intro w
    let w0 : S' := w i0
    let w1 : S' := w i1
    let v : Fin (2 * r) → S' := fun t => w (e_split (Sum.inr t))
    have hM_sq_entry : ∀ x y : Fin 2 ⊕ Fin (2 * r),
        M_sq (e_split x) (e_split y) = M_blk x y := by
      intro x y
      simp [M_sq, Matrix.reindex_apply, Matrix.submatrix_apply]
    have hRowSum : ∀ x : Fin 2 ⊕ Fin (2 * r),
        (∑ j : Fin (2 * (r + 1)), M_sq (e_split x) j * w j) =
          (M_blk x (Sum.inl 0) * w0 + M_blk x (Sum.inl 1) * w1) +
            ∑ t : Fin (2 * r), M_blk x (Sum.inr t) * v t := by
      intro x
      rw [← e_split.sum_comp]
      simp_rw [hM_sq_entry]
      rw [Fintype.sum_sum_type, Fin.sum_univ_two, he_inl0, he_inl1]
    have hRow0 : (∑ j : Fin (2 * (r + 1)), M_sq ⟨0, by omega⟩ j * w j) =
        (φ_rem a00_bar * w0 + φ_rem Θ * w1) + ∑ t : Fin (2 * r), φ_rem (β t) * v t := by
      have hidx : (⟨0, by omega⟩ : Fin (2 * (r + 1))) = e_split (Sum.inl 0) := by ext; rfl
      rw [hidx, hRowSum (Sum.inl 0)]
      simp [M_blk, B00, B01]
    have hRow1 : (∑ j : Fin (2 * (r + 1)), M_sq ⟨1, by omega⟩ j * w j) =
        (w0 + φ_rem c11 * w1) + ∑ t : Fin (2 * r), φ_rem (α t) * v t := by
      have hidx : (⟨1, by omega⟩ : Fin (2 * (r + 1))) = e_split (Sum.inl 1) := by ext; rfl
      rw [hidx, hRowSum (Sum.inl 1)]
      simp [M_blk, B00, B01]
    have hRowInr : ∀ p : Fin (2 * r),
        (∑ j : Fin (2 * (r + 1)), M_sq (e_split (Sum.inr p)) j * w j) =
          ∑ t : Fin (2 * r), M_rem p t * v t := by
      intro p
      rw [hRowSum (Sum.inr p)]
      simp [M_blk]
    have hTail : (∑ s' : Fin r,
        (∑ j : Fin (2 * (r + 1)), M_sq ⟨2 * (s'.succ).1, by omega⟩ j * w j) *
        (∑ j : Fin (2 * (r + 1)), M_sq ⟨2 * (s'.succ).1 + 1, by omega⟩ j * w j)) =
        ∑ a : Fin (2 * r), ∑ b : Fin (2 * r), φ_rem (A_rem a b) * v a * v b := by
      rw [← hM_rem_split v]
      refine Finset.sum_congr rfl fun s' _ => ?_
      have he0 : (⟨2 * (s'.succ).1, by omega⟩ : Fin (2 * (r + 1))) =
          e_split (Sum.inr ⟨2 * s'.1, by omega⟩) := by
        ext; dsimp [e_split]; omega
      have he1 : (⟨2 * (s'.succ).1 + 1, by omega⟩ : Fin (2 * (r + 1))) =
          e_split (Sum.inr ⟨2 * s'.1 + 1, by omega⟩) := by
        ext; dsimp [e_split]; omega
      rw [he0, he1, hRowInr, hRowInr]
    have hSymSum : (∑ a : Fin (2 * r), ∑ b : Fin (2 * r), φ_rem (A_rem a b) * v a * v b) =
        (∑ a : Fin (2 * r), ∑ b : Fin (2 * r),
          φ (A (e_split (Sum.inr a)) (e_split (Sum.inr b))) * v a * v b) -
        (∑ a : Fin (2 * r), ∑ b : Fin (2 * r), φ_rem (α a) * φ_rem (β b) * v a * v b) := by
      let R_term : Fin (2 * r) → Fin (2 * r) → S' :=
        fun a b => φ_rem (α a) * φ_rem (β b) * v a * v b
      have hterm : ∀ a b : Fin (2 * r),
          φ_rem (A_rem a b) * v a * v b =
            φ (A (e_split (Sum.inr a)) (e_split (Sum.inr b))) * v a * v b -
              ((if a ≤ b then R_term a b else 0) + (if a < b then R_term b a else 0)) := by
        intro a b
        dsimp [A_rem, R_term, φ]
        simp only [map_sub, map_add, apply_ite φ_rem, map_mul, map_zero]
        split_ifs <;> ring
      simp_rw [hterm, Finset.sum_sub_distrib, Finset.sum_add_distrib]
      congr 1
      have hswap : (∑ a : Fin (2 * r), ∑ b : Fin (2 * r), if a < b then R_term b a else 0) =
          ∑ a : Fin (2 * r), ∑ b : Fin (2 * r), if b < a then R_term a b else 0 :=
        Finset.sum_comm
      rw [hswap, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun b _ => ?_
      by_cases hab : a ≤ b
      · have hnot : ¬ (b < a) := not_lt.mpr hab
        simp [hab, hnot, R_term]
      · have hlt : b < a := not_le.mp hab
        simp [hab, hlt, R_term]
    set U0 : S' := φ_rem a00_bar * w0 + φ_rem Θ * w1
    set U1 : S' := w0 + φ_rem c11 * w1
    set Lβ : S' := ∑ t : Fin (2 * r), φ_rem (β t) * v t
    set Lα : S' := ∑ t : Fin (2 * r), φ_rem (α t) * v t
    have hU0U1 : U0 * U1 = φ a00 * w0 * w0 + φ a01 * w0 * w1 + φ a11 * w1 * w1 := by
      have htr : φ_rem a00_bar * φ_rem c11 + φ_rem Θ = φ a01 := by
        rw [← map_mul, ← map_add, hc11_tr]; rfl
      have hpr : φ_rem Θ * φ_rem c11 = φ a11 := by
        rw [← map_mul, hc11_prod]; rfl
      have ha0 : φ_rem a00_bar = φ a00 := rfl
      dsimp [U0, U1]
      linear_combination (w0 * w0) * ha0 + (w0 * w1) * htr + (w1 * w1) * hpr
    have hCrossSum : U0 * Lα + U1 * Lβ =
        (∑ t : Fin (2 * r), φ (A i0 (e_split (Sum.inr t))) * w0 * v t) +
        (∑ t : Fin (2 * r), φ (A i1 (e_split (Sum.inr t))) * w1 * v t) := by
      dsimp [Lα, Lβ]
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun t _ => ?_
      have hc0 : φ_rem a00_bar * φ_rem (α t) + φ_rem (β t) = φ (A i0 (e_split (Sum.inr t))) := by
        rw [← map_mul, ← map_add, hcross0 t]; rfl
      have hc1 : φ_rem Θ * φ_rem (α t) + φ_rem c11 * φ_rem (β t) =
          φ (A i1 (e_split (Sum.inr t))) := by
        rw [← map_mul, ← map_mul, ← map_add, hcross1 t]; rfl
      dsimp [U0, U1]
      linear_combination (w0 * v t) * hc0 + (w1 * v t) * hc1
    have hLαLβ : Lα * Lβ =
        ∑ a : Fin (2 * r), ∑ b : Fin (2 * r), φ_rem (α a) * φ_rem (β b) * v a * v b := by
      dsimp [Lα, Lβ]
      rw [Finset.sum_mul_sum]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      ring
    have hLHS : (∑ s : Fin (r + 1),
        (∑ j : Fin (2 * (r + 1)), M_sq ⟨2 * s.1, by omega⟩ j * w j) *
        (∑ j : Fin (2 * (r + 1)), M_sq ⟨2 * s.1 + 1, by omega⟩ j * w j)) =
        (φ a00 * w0 * w0 + φ a01 * w0 * w1 + φ a11 * w1 * w1) +
        ((∑ t : Fin (2 * r), φ (A i0 (e_split (Sum.inr t))) * w0 * v t) +
          (∑ t : Fin (2 * r), φ (A i1 (e_split (Sum.inr t))) * w1 * v t)) +
        (∑ a : Fin (2 * r), ∑ b : Fin (2 * r),
          φ (A (e_split (Sum.inr a)) (e_split (Sum.inr b))) * v a * v b) := by
      rw [Fin.sum_univ_succ]
      change (∑ j : Fin (2 * (r + 1)), M_sq ⟨0, _⟩ j * w j) *
          (∑ j : Fin (2 * (r + 1)), M_sq ⟨1, _⟩ j * w j) +
        (∑ s' : Fin r,
          (∑ j : Fin (2 * (r + 1)), M_sq ⟨2 * (s'.succ).1, _⟩ j * w j) *
          (∑ j : Fin (2 * (r + 1)), M_sq ⟨2 * (s'.succ).1 + 1, _⟩ j * w j)) = _
      rw [hRow0, hRow1, hTail, hSymSum]
      have hexp : (U0 + Lβ) * (U1 + Lα) = U0 * U1 + (U0 * Lα + U1 * Lβ) + Lα * Lβ := by ring
      rw [hexp, hU0U1, hCrossSum, hLαLβ]
      ring
    have hRHS : (∑ i : Fin (2 * (r + 1)), ∑ j : Fin (2 * (r + 1)), φ (A i j) * w i * w j) =
        (φ a00 * w0 * w0 + φ a01 * w0 * w1 + φ a11 * w1 * w1) +
        ((∑ t : Fin (2 * r), φ (A i0 (e_split (Sum.inr t))) * w0 * v t) +
          (∑ t : Fin (2 * r), φ (A i1 (e_split (Sum.inr t))) * w1 * v t)) +
        (∑ a : Fin (2 * r), ∑ b : Fin (2 * r),
          φ (A (e_split (Sum.inr a)) (e_split (Sum.inr b))) * v a * v b) := by
      rw [← e_split.sum_comp, Fintype.sum_sum_type, Fin.sum_univ_two, he_inl0, he_inl1]
      have hIn0 : (∑ j : Fin (2 * (r + 1)), φ (A i0 j) * w i0 * w j) =
          (φ a00 * w0 * w0 + φ a01 * w0 * w1) +
            ∑ t : Fin (2 * r), φ (A i0 (e_split (Sum.inr t))) * w0 * v t := by
        rw [← e_split.sum_comp, Fintype.sum_sum_type, Fin.sum_univ_two, he_inl0, he_inl1]
      have hIn1 : (∑ j : Fin (2 * (r + 1)), φ (A i1 j) * w i1 * w j) =
          φ a11 * w1 * w1 +
            ∑ t : Fin (2 * r), φ (A i1 (e_split (Sum.inr t))) * w1 * v t := by
        rw [← e_split.sum_comp, Fintype.sum_sum_type, Fin.sum_univ_two, he_inl0, he_inl1]
        change (φ (A i1 i0) * w1 * w0 + φ a11 * w1 * w1) +
            ∑ t : Fin (2 * r), φ (A i1 (e_split (Sum.inr t))) * w1 * v t = _
        rw [hA10, map_zero, zero_mul, zero_mul, zero_add]
      have hInr : (∑ a : Fin (2 * r), ∑ j : Fin (2 * (r + 1)),
          φ (A (e_split (Sum.inr a)) j) * w (e_split (Sum.inr a)) * w j) =
          ∑ a : Fin (2 * r), ∑ b : Fin (2 * r),
            φ (A (e_split (Sum.inr a)) (e_split (Sum.inr b))) * v a * v b := by
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← e_split.sum_comp, Fintype.sum_sum_type]
        have hzero : (∑ b : Fin 2,
            φ (A (e_split (Sum.inr a)) (e_split (Sum.inl b))) * v a * w (e_split (Sum.inl b))) =
            0 := by
          refine Finset.sum_eq_zero fun b _ => ?_
          have hlt : e_split (Sum.inl b) < e_split (Sum.inr a) := by
            show b.1 < a.1 + 2
            omega
          rw [hA_tri _ _ hlt, map_zero, zero_mul, zero_mul]
        change (∑ b : Fin 2,
            φ (A (e_split (Sum.inr a)) (e_split (Sum.inl b))) * v a * w (e_split (Sum.inl b))) +
          (∑ b : Fin (2 * r),
            φ (A (e_split (Sum.inr a)) (e_split (Sum.inr b))) * v a * v b) = _
        rw [hzero, zero_add]
      rw [hIn0, hIn1, hInr]
      ring
    exact hLHS.trans hRHS.symm

theorem weil_ring_etale_section_open_surj_and_roof_baseChange (k : Type u) [Field k] (m d : ℕ)
    (A_Z : Type u) [CommRing A_Z] [Algebra k A_Z]
    (ε_z : A_Z →+* k)
    (G_poly Δ_0 : MvPolynomial (Fin 2) A_Z)
    (dG : Fin d → MvPolynomial (Fin 2) A_Z)
    (hΔ0_ne : MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) Δ_0 ≠ 0)
    (hdG_eval : ∀ i : Fin d, MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) (dG i) = 0)
    (ε_init : weilCritLocRingCat dG Δ_0 →+* k)
    (hε_init_τ : ∀ F : MvPolynomial (Fin 2) A_Z,
      ε_init (weilCritLocTau dG Δ_0 F) = MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) F)
    (B_1 B_amb : Type u) [CommRing B_1] [CommRing B_amb]
    (α_1 : MvPolynomial (Fin 2) A_Z →+* B_1)
    (ι_R1 : weilCritLocRingCat dG Δ_0 →+* B_1)
    (σ_1 : B_1 →+* weilCritLocRingCat dG Δ_0)
    (ψ_amb : B_1 →+* B_amb)
    (ε_amb : B_amb →+* k)
    (z_amb : Fin (m + 1) × Fin 2 → B_amb)
    (hα1_et : α_1.Etale)
    (hψ_amb_et : ψ_amb.Etale)
    (hσ_ι : σ_1.comp ι_R1 = RingHom.id _)
    (hσ_α : σ_1.comp α_1 = weilCritLocTau dG Δ_0)
    (hα_φ : α_1.comp (MvPolynomial.map (algebraMap k A_Z)) =
      ι_R1.comp ((weilCritLocTau dG Δ_0).comp (MvPolynomial.map (algebraMap k A_Z))))
    (hε_amb : ε_amb.comp ψ_amb = ε_init.comp σ_1)
    (hΦ_amb_et : (MvPolynomial.eval₂Hom (ψ_amb.comp ι_R1) z_amb).Etale)
    (hz_ker : ∀ idx : Fin (m + 1) × Fin 2, z_amb idx ∈ Ideal.map ψ_amb (RingHom.ker σ_1))
    (hz_sum : (∑ j : Fin (m + 1), z_amb (j, (0 : Fin 2)) * z_amb (j, (1 : Fin 2))) -
      ψ_amb (ι_R1 (weilCritLocTau dG Δ_0 G_poly)) = -(ψ_amb (α_1 G_poly))) :
    ∃ g_0 : MvPolynomial (Fin 2) A_Z,
      MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) g_0 ≠ 0 ∧
      (∀ p : PrimeSpectrum (MvPolynomial (Fin 2) A_Z),
        Δ_0 * g_0 ∉ p.asIdeal →
        ((∀ i : Fin d, dG i ∈ p.asIdeal) ↔
          ∃ u : PrimeSpectrum (weilCritLocRingCat dG (Δ_0 * g_0)),
            PrimeSpectrum.comap (weilCritLocTau dG (Δ_0 * g_0)) u = p)) ∧
      ∃ (B'_0 : CommRingCat.{u})
        (e_Y0 : (MvPolynomial (Fin 2) A_Z ⧸
          Ideal.span ({G_poly} : Set (MvPolynomial (Fin 2) A_Z))) →+* B'_0)
        (q_0 : (MvPolynomial (Fin (m + 1) × Fin 2) (weilCritLocRingCat dG (Δ_0 * g_0)) ⧸
          Ideal.span ({(∑ j : Fin (m + 1),
              MvPolynomial.X (j, (0 : Fin 2)) * MvPolynomial.X (j, (1 : Fin 2))) -
            MvPolynomial.C (weilCritLocTau dG (Δ_0 * g_0) G_poly)} :
            Set (MvPolynomial (Fin (m + 1) × Fin 2)
              (weilCritLocRingCat dG (Δ_0 * g_0))))) →+* B'_0),
        e_Y0.Etale ∧
        q_0.Etale ∧
        (e_Y0.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.map (algebraMap k A_Z))) =
          (q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp
            ((weilCritLocTau dG (Δ_0 * g_0)).comp (MvPolynomial.map (algebraMap k A_Z)))) ∧
        (∀ u : PrimeSpectrum (weilCritLocRingCat dG (Δ_0 * g_0)),
          weilCritLocTau dG (Δ_0 * g_0) G_poly ∈ u.asIdeal →
          ∃ v : PrimeSpectrum B'_0,
            PrimeSpectrum.comap (e_Y0.comp (Ideal.Quotient.mk _)) v =
              PrimeSpectrum.comap (weilCritLocTau dG (Δ_0 * g_0)) u ∧
            PrimeSpectrum.comap (q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) v = u ∧
            (∀ idx : Fin (m + 1) × Fin 2,
              q_0 (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ v.asIdeal) ∧
            q_0 (Ideal.Quotient.mk _
              (MvPolynomial.C (weilCritLocTau dG (Δ_0 * g_0) G_poly))) ∈ v.asIdeal) :=
by
  have _ := hdG_eval
  
  have h_s2 : ∃ g_surj : weilCritLocRingCat dG Δ_0,
      ε_init g_surj ≠ 0 ∧
      ∀ u : PrimeSpectrum (weilCritLocRingCat dG Δ_0),
        g_surj ∉ u.asIdeal →
        ∃ v_amb : PrimeSpectrum B_amb,
          PrimeSpectrum.comap ψ_amb v_amb = PrimeSpectrum.comap σ_1 u := by
    let R : Type u := weilCritLocRingCat dG Δ_0
    letI : Algebra B_1 R := σ_1.toAlgebra
    letI : Algebra B_1 B_amb := ψ_amb.toAlgebra
    haveI : Algebra.Etale B_1 B_amb := RingHom.etale_algebraMap.mp hψ_amb_et
    let E := TensorProduct B_1 R B_amb
    haveI : Algebra.Etale R E := Algebra.Etale.baseChange B_1 B_amb R
    haveI : Algebra.FinitePresentation R E := Algebra.Etale.finitePresentation
    haveI : Module.Flat R E := Algebra.Smooth.flat R E
    haveI : Algebra.HasGoingDown R E := Algebra.HasGoingDown.of_flat
    have hOpen : IsOpenMap (PrimeSpectrum.comap (algebraMap R E)) :=
      PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
    have hRangeOpen : IsOpen (Set.range (PrimeSpectrum.comap (algebraMap R E))) :=
      hOpen.isOpen_range
    letI : Algebra B_1 k := (ε_init.comp σ_1).toAlgebra
    let ε_R_alg : R →ₐ[B_1] k :=
      { toRingHom := ε_init
        commutes' := fun _ => rfl }
    let ε_amb_alg : B_amb →ₐ[B_1] k :=
      { toRingHom := ε_amb
        commutes' := fun b => RingHom.congr_fun hε_amb b }
    let ε_E : E →+* k :=
      (Algebra.TensorProduct.lift ε_R_alg ε_amb_alg (fun _ _ => Commute.all _ _)).toRingHom
    have hε_E_R : ∀ r : R, ε_E (algebraMap R E r) = ε_init r := by
      intro r
      change (Algebra.TensorProduct.lift ε_R_alg ε_amb_alg _) (r ⊗ₜ[B_1] (1 : B_amb)) = ε_init r
      rw [Algebra.TensorProduct.lift_tmul]
      change ε_init r * ε_amb 1 = ε_init r
      rw [map_one, mul_one]
    let u_0 : PrimeSpectrum R := ⟨RingHom.ker ε_init, RingHom.ker_isPrime ε_init⟩
    let w_0 : PrimeSpectrum E := ⟨RingHom.ker ε_E, RingHom.ker_isPrime ε_E⟩
    have hw_0 : PrimeSpectrum.comap (algebraMap R E) w_0 = u_0 := by
      ext r
      change ε_E (algebraMap R E r) = 0 ↔ ε_init r = 0
      rw [hε_E_R]
    have hu_0_mem : u_0 ∈ Set.range (PrimeSpectrum.comap (algebraMap R E)) := ⟨w_0, hw_0⟩
    have h_nhds : Set.range (PrimeSpectrum.comap (algebraMap R E)) ∈ nhds u_0 :=
      hRangeOpen.mem_nhds hu_0_mem
    rw [PrimeSpectrum.isTopologicalBasis_basic_opens.mem_nhds_iff] at h_nhds
    rcases h_nhds with ⟨_, ⟨g_surj, rfl⟩, hu_0_basic, hbasic_sub⟩
    refine ⟨g_surj, ?_, ?_⟩
    · change u_0 ∈ (PrimeSpectrum.basicOpen g_surj : Set (PrimeSpectrum R)) at hu_0_basic
      rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hu_0_basic
      exact hu_0_basic
    · intro u hg_not_mem
      have hu_basic : u ∈ (PrimeSpectrum.basicOpen g_surj : Set (PrimeSpectrum R)) := by
        rwa [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      rcases hbasic_sub hu_basic with ⟨w, rfl⟩
      let ι_amb : B_amb →+* E := (Algebra.TensorProduct.includeRight : B_amb →ₐ[B_1] E).toRingHom
      refine ⟨PrimeSpectrum.comap ι_amb w, ?_⟩
      ext b
      change ι_amb (ψ_amb b) ∈ w.asIdeal ↔ algebraMap R E (σ_1 b) ∈ w.asIdeal
      have hcomm_b : ι_amb (ψ_amb b) = algebraMap R E (σ_1 b) := by
        change ((1 : R) ⊗ₜ[B_1] (algebraMap B_1 B_amb b) : E) =
          (algebraMap B_1 R b) ⊗ₜ[B_1] (1 : B_amb)
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
        exact (TensorProduct.smul_tmul b (1 : R) (1 : B_amb)).symm
      rw [hcomm_b]

  
  let C_Z2 := MvPolynomial (Fin 2) A_Z
  let I_crit : Ideal C_Z2 := Ideal.span (Set.range dG)
  let Q_crit := C_Z2 ⧸ I_crit
  let π_crit : C_Z2 →+* Q_crit := Ideal.Quotient.mk I_crit
  let R_x := Localization.Away (π_crit Δ_0)
  obtain ⟨g_surj, hg_surj_ne, hLift_amb⟩ := h_s2
  let g_surj_x : R_x := g_surj
  let sec_g := IsLocalization.Away.sec (π_crit Δ_0) g_surj_x
  obtain ⟨g_0, hg_0_mk⟩ := Ideal.Quotient.mk_surjective sec_g.1
  have hsec_eq : g_surj * (weilCritLocTau dG Δ_0 Δ_0) ^ sec_g.2 = weilCritLocTau dG Δ_0 g_0 := by
    have hspec : g_surj_x * algebraMap Q_crit R_x (π_crit Δ_0 ^ sec_g.2) =
        algebraMap Q_crit R_x sec_g.1 :=
      IsLocalization.Away.sec_spec (π_crit Δ_0) g_surj_x
    rw [map_pow, ← hg_0_mk] at hspec
    exact hspec
  have hg_0_ne : MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) g_0 ≠ 0 := by
    rw [← hε_init_τ g_0, ← hsec_eq, map_mul, map_pow, hε_init_τ Δ_0]
    exact mul_ne_zero hg_surj_ne (pow_ne_zero _ hΔ0_ne)

  
  let R_xy := Localization.Away (π_crit (Δ_0 * g_0))
  have hCrit_iff : ∀ p : PrimeSpectrum C_Z2,
      Δ_0 * g_0 ∉ p.asIdeal →
      ((∀ i : Fin d, dG i ∈ p.asIdeal) ↔
        ∃ u : PrimeSpectrum (weilCritLocRingCat dG (Δ_0 * g_0)),
          PrimeSpectrum.comap (weilCritLocTau dG (Δ_0 * g_0)) u = p) := by
    intro p hp_not_mem
    constructor
    · intro hdG_mem
      have hI_le : I_crit ≤ p.asIdeal := by
        rw [Ideal.span_le, Set.range_subset_iff]
        exact hdG_mem
      haveI : p.asIdeal.IsPrime := p.isPrime
      let D_p := C_Z2 ⧸ p.asIdeal
      let K_p := FractionRing D_p
      let η_p : C_Z2 →+* K_p := (algebraMap D_p K_p).comp (Ideal.Quotient.mk p.asIdeal)
      have hη_ker : ∀ c : C_Z2, η_p c = 0 ↔ c ∈ p.asIdeal := by
        intro c
        change algebraMap D_p K_p (Ideal.Quotient.mk p.asIdeal c) = 0 ↔ c ∈ p.asIdeal
        rw [(injective_iff_map_eq_zero' (algebraMap D_p K_p)).mp
          (IsFractionRing.injective D_p K_p), Ideal.Quotient.eq_zero_iff_mem]
      let bar_η_p : Q_crit →+* K_p :=
        Ideal.Quotient.lift I_crit η_p (fun c hc => (hη_ker c).mpr (hI_le hc))
      have hUnit_xy : IsUnit (bar_η_p (π_crit (Δ_0 * g_0))) := by
        apply IsUnit.mk0
        change η_p (Δ_0 * g_0) ≠ 0
        intro hzero
        exact hp_not_mem ((hη_ker _).mp hzero)
      let tilde_η_p : R_xy →+* K_p := IsLocalization.Away.lift (π_crit (Δ_0 * g_0)) hUnit_xy
      let tilde_η_cat : weilCritLocRingCat dG (Δ_0 * g_0) →+* K_p := tilde_η_p
      let u : PrimeSpectrum (weilCritLocRingCat dG (Δ_0 * g_0)) :=
        ⟨RingHom.ker tilde_η_cat, RingHom.ker_isPrime tilde_η_cat⟩
      refine ⟨u, ?_⟩
      ext c
      change tilde_η_p (algebraMap Q_crit R_xy (π_crit c)) = 0 ↔ c ∈ p.asIdeal
      rw [IsLocalization.Away.lift_eq (π_crit (Δ_0 * g_0)) hUnit_xy (π_crit c)]
      exact hη_ker c
    · rintro ⟨u, rfl⟩ i
      change weilCritLocTau dG (Δ_0 * g_0) (dG i) ∈ u.asIdeal
      have hzero : π_crit (dG i) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
      have htau_zero : weilCritLocTau dG (Δ_0 * g_0) (dG i) = 0 := by
        change algebraMap Q_crit R_xy (π_crit (dG i)) = 0
        rw [hzero, map_zero]
      rw [htau_zero]
      exact u.asIdeal.zero_mem

  have h_s3_loc : ∃ ρ : weilCritLocRingCat dG Δ_0 →+* weilCritLocRingCat dG (Δ_0 * g_0),
      ρ.comp (weilCritLocTau dG Δ_0) = weilCritLocTau dG (Δ_0 * g_0) ∧
      IsUnit (ρ (weilCritLocTau dG Δ_0 g_0)) ∧
      @IsLocalization.Away (weilCritLocRingCat dG Δ_0) _
        (weilCritLocTau dG Δ_0 g_0) (weilCritLocRingCat dG (Δ_0 * g_0)) _ ρ.toAlgebra := by
    have hUnit_prod : IsUnit (algebraMap Q_crit R_xy (π_crit Δ_0) *
        algebraMap Q_crit R_xy (π_crit g_0)) := by
      rw [← map_mul, ← map_mul]
      exact IsLocalization.Away.algebraMap_isUnit (π_crit (Δ_0 * g_0))
    have hUnit_Δ : IsUnit (algebraMap Q_crit R_xy (π_crit Δ_0)) :=
      isUnit_of_mul_isUnit_left hUnit_prod
    have hUnit_g : IsUnit (algebraMap Q_crit R_xy (π_crit g_0)) :=
      isUnit_of_mul_isUnit_right hUnit_prod
    let ρ_raw : R_x →+* R_xy := IsLocalization.Away.lift (π_crit Δ_0) hUnit_Δ
    have hρ_alg : ∀ q : Q_crit, ρ_raw (algebraMap Q_crit R_x q) = algebraMap Q_crit R_xy q :=
      fun q => IsLocalization.Away.lift_eq (π_crit Δ_0) hUnit_Δ q
    let g_1_raw : R_x := algebraMap Q_crit R_x (π_crit g_0)
    have hρ_g_raw : IsUnit (ρ_raw g_1_raw) := by
      dsimp [g_1_raw]
      rw [hρ_alg]
      exact hUnit_g
    have hLoc_raw : @IsLocalization.Away R_x _ g_1_raw R_xy _ ρ_raw.toAlgebra := by
      letI : Algebra R_x R_xy := ρ_raw.toAlgebra
      refine
        { map_units := ?_
          surj := ?_
          exists_of_eq := ?_ }
      · rintro ⟨_, n, rfl⟩
        change IsUnit (ρ_raw (g_1_raw ^ n))
        rw [map_pow]
        exact hρ_g_raw.pow n
      · intro z
        let sec_z := IsLocalization.Away.sec (π_crit (Δ_0 * g_0)) z
        have hz_spec : z * algebraMap Q_crit R_xy (π_crit (Δ_0 * g_0) ^ sec_z.2) =
            algebraMap Q_crit R_xy sec_z.1 :=
          IsLocalization.Away.sec_spec (π_crit (Δ_0 * g_0)) z
        have hUnit_Δ_Rx : IsUnit (algebraMap Q_crit R_x (π_crit Δ_0)) :=
          IsLocalization.Away.algebraMap_isUnit (π_crit Δ_0)
        rcases hUnit_Δ_Rx with ⟨u_Δ, hu_Δ⟩
        let r : R_x := algebraMap Q_crit R_x sec_z.1 * ((↑(u_Δ⁻¹) : R_x) ^ sec_z.2)
        refine ⟨⟨r, ⟨g_1_raw ^ sec_z.2, sec_z.2, rfl⟩⟩, ?_⟩
        change z * ρ_raw (g_1_raw ^ sec_z.2) = ρ_raw r
        have hΔ_inv : algebraMap Q_crit R_x (π_crit Δ_0) * (↑(u_Δ⁻¹) : R_x) = 1 := by
          rw [← hu_Δ]
          exact Units.mul_inv u_Δ
        have hr_eq : ρ_raw r = algebraMap Q_crit R_xy sec_z.1 * (ρ_raw (↑(u_Δ⁻¹) : R_x)) ^ sec_z.2 := by
          dsimp [r]
          rw [map_mul, hρ_alg, map_pow]
        rw [hr_eq, ← hz_spec]
        have hpow_xy : algebraMap Q_crit R_xy (π_crit (Δ_0 * g_0) ^ sec_z.2) =
            (ρ_raw (algebraMap Q_crit R_x (π_crit Δ_0))) ^ sec_z.2 *
              (ρ_raw g_1_raw) ^ sec_z.2 := by
          have hbase_xy : algebraMap Q_crit R_xy (π_crit (Δ_0 * g_0)) =
              ρ_raw (algebraMap Q_crit R_x (π_crit Δ_0)) * ρ_raw g_1_raw := by
            have h1 : π_crit (Δ_0 * g_0) = π_crit Δ_0 * π_crit g_0 := map_mul π_crit Δ_0 g_0
            have h2 : algebraMap Q_crit R_xy (π_crit (Δ_0 * g_0)) =
                algebraMap Q_crit R_xy (π_crit Δ_0 * π_crit g_0) :=
              congrArg (algebraMap Q_crit R_xy) h1
            exact h2.trans ((map_mul (algebraMap Q_crit R_xy) (π_crit Δ_0) (π_crit g_0)).trans
              (by dsimp [g_1_raw]; rw [hρ_alg, hρ_alg]))
          exact (map_pow (algebraMap Q_crit R_xy) (π_crit (Δ_0 * g_0)) sec_z.2).trans
            ((congrArg (· ^ sec_z.2) hbase_xy).trans (mul_pow _ _ _))
        rw [hpow_xy, RingHom.map_pow ρ_raw]
        have hρ_inv : ρ_raw (algebraMap Q_crit R_x (π_crit Δ_0)) * ρ_raw (↑(u_Δ⁻¹) : R_x) = 1 := by
          rw [← RingHom.map_mul ρ_raw, hΔ_inv, RingHom.map_one ρ_raw]
        calc
          z * ρ_raw g_1_raw ^ sec_z.2
            = z * ρ_raw g_1_raw ^ sec_z.2 * 1 ^ sec_z.2 := by ring
          _ = z * ρ_raw g_1_raw ^ sec_z.2 *
                (ρ_raw (algebraMap Q_crit R_x (π_crit Δ_0)) * ρ_raw (↑(u_Δ⁻¹) : R_x)) ^ sec_z.2 := by
                rw [hρ_inv]
          _ = z * (ρ_raw (algebraMap Q_crit R_x (π_crit Δ_0)) ^ sec_z.2 *
                ρ_raw g_1_raw ^ sec_z.2) *
                ρ_raw (↑(u_Δ⁻¹) : R_x) ^ sec_z.2 := by
                ring
      · intro x_1 x_2 hx_eq
        have hsub_zero : ρ_raw (x_1 - x_2) = 0 := by
          rw [RingHom.map_sub ρ_raw]
          exact sub_eq_zero.mpr hx_eq
        let sec_d := IsLocalization.Away.sec (π_crit Δ_0) (x_1 - x_2)
        have hd_spec : (x_1 - x_2) * algebraMap Q_crit R_x (π_crit Δ_0 ^ sec_d.2) =
            algebraMap Q_crit R_x sec_d.1 :=
          IsLocalization.Away.sec_spec (π_crit Δ_0) (x_1 - x_2)
        have hq_zero : algebraMap Q_crit R_xy sec_d.1 = algebraMap Q_crit R_xy 0 := by
          rw [map_zero, ← hρ_alg, ← hd_spec, map_mul, hsub_zero, zero_mul]
        rcases (IsLocalization.eq_iff_exists (Submonoid.powers (π_crit (Δ_0 * g_0))) R_xy).mp
          hq_zero with ⟨⟨_, k_2, rfl⟩, hk_2⟩
        simp only [mul_zero] at hk_2
        refine ⟨⟨g_1_raw ^ k_2, k_2, rfl⟩, ?_⟩
        suffices hdiff : g_1_raw ^ k_2 * (x_1 - x_2) = 0 by
          linear_combination hdiff
        have hk_2_Rx : algebraMap Q_crit R_x ((π_crit (Δ_0 * g_0)) ^ k_2 * sec_d.1) = 0 := by
          rw [hk_2, map_zero]
        have h_expand : algebraMap Q_crit R_x ((π_crit (Δ_0 * g_0)) ^ k_2 * sec_d.1) =
            (algebraMap Q_crit R_x (π_crit Δ_0)) ^ (k_2 + sec_d.2) *
              (g_1_raw ^ k_2 * (x_1 - x_2)) := by
          dsimp [g_1_raw]
          rw [map_mul, ← hd_spec, map_pow, map_mul, map_mul, mul_pow, map_pow, pow_add]
          ring
        rw [h_expand] at hk_2_Rx
        have hUnit_pow : IsUnit ((algebraMap Q_crit R_x (π_crit Δ_0)) ^ (k_2 + sec_d.2)) :=
          (IsLocalization.Away.algebraMap_isUnit (π_crit Δ_0)).pow (k_2 + sec_d.2)
        rcases hUnit_pow with ⟨u_p, hu_p⟩
        rw [← hu_p] at hk_2_Rx
        have hcancel := congrArg ((↑(u_p⁻¹) : R_x) * ·) hk_2_Rx
        rw [← mul_assoc, Units.inv_mul, one_mul, mul_zero] at hcancel
        exact hcancel
    let ρ : weilCritLocRingCat dG Δ_0 →+* weilCritLocRingCat dG (Δ_0 * g_0) := ρ_raw
    have hρ_comp : ρ.comp (weilCritLocTau dG Δ_0) = weilCritLocTau dG (Δ_0 * g_0) := by
      apply RingHom.ext
      intro F
      exact hρ_alg (π_crit F)
    exact ⟨ρ, hρ_comp, hρ_g_raw, hLoc_raw⟩

  obtain ⟨ρ, hρ_comp, hUnit_g1, hLoc_R0⟩ := h_s3_loc
  have hρ_τ : ∀ F : C_Z2, ρ (weilCritLocTau dG Δ_0 F) = weilCritLocTau dG (Δ_0 * g_0) F :=
    fun F => RingHom.congr_fun hρ_comp F

  
  have h_et_quot : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B)
      (hf : f.Etale) (I : Ideal A) (J : Ideal B) (hJ : J = Ideal.map f I)
      (hIJ : ∀ a ∈ I, (Ideal.Quotient.mk J).comp f a = 0),
      (Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp f) hIJ).Etale := by
    intro A B _ _ f hf I J hJ hIJ
    subst hJ
    letI : Algebra A B := f.toAlgebra
    haveI : Algebra.Etale A B := RingHom.etale_algebraMap.mp hf
    let E_Q := TensorProduct A (A ⧸ I) B
    haveI : Algebra.Etale (A ⧸ I) E_Q := Algebra.Etale.baseChange A B (A ⧸ I)
    let η_L : (A ⧸ I) →+* E_Q := algebraMap (A ⧸ I) E_Q
    have hη_L_et : η_L.Etale := RingHom.etale_algebraMap.mpr inferInstance
    let e_1 : E_Q ≃+* TensorProduct A B (A ⧸ I) :=
      (Algebra.TensorProduct.comm A (A ⧸ I) B).toRingEquiv
    let e_2 : TensorProduct A B (A ⧸ I) ≃+* (B ⧸ Ideal.map (algebraMap A B) I) :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm.toRingEquiv
    let e_quot : E_Q ≃+* (B ⧸ Ideal.map f I) := e_1.trans e_2
    have he_et : e_quot.toRingHom.Etale := RingHom.Etale.of_bijective e_quot.bijective
    have hcomp_et : (e_quot.toRingHom.comp η_L).Etale :=
      RingHom.Etale.stableUnderComposition η_L e_quot.toRingHom hη_L_et he_et
    suffices heq : Ideal.Quotient.lift I ((Ideal.Quotient.mk (Ideal.map f I)).comp f) hIJ =
        e_quot.toRingHom.comp η_L by
      rwa [heq]
    apply RingHom.ext
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    have h1 : e_1 (η_L (Ideal.Quotient.mk I a)) = (1 : B) ⊗ₜ[A] (Ideal.Quotient.mk I a) := rfl
    have h2 : ((1 : B) ⊗ₜ[A] (Ideal.Quotient.mk I a) : TensorProduct A B (A ⧸ I)) =
        (f a) ⊗ₜ[A] (1 : A ⧸ I) := by
      have hmk : Ideal.Quotient.mk I a = a • (1 : A ⧸ I) := by
        rw [← Algebra.algebraMap_eq_smul_one]
        rfl
      rw [hmk, ← TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one]
      rfl
    have h3 : e_2 ((f a) ⊗ₜ[A] (1 : A ⧸ I)) =
        Ideal.Quotient.mk (Ideal.map (algebraMap A B) I) (f a) := by
      apply (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).injective
      change (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I)
        ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm _) = _
      rw [AlgEquiv.apply_symm_apply, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      e_quot, RingEquiv.trans_apply]
    rw [h1, h2, h3]
    rfl

  have h_s4_bc : ∀ (σ : Type) {R_1 R_2 B' : Type u} [CommRing R_1] [CommRing R_2] [CommRing B']
      (ρ_loc : R_1 →+* R_2) (g : R_1)
      (_ : @IsLocalization.Away R_1 _ g R_2 _ ρ_loc.toAlgebra)
      (H_1 : MvPolynomial σ R_1) (H_2 : MvPolynomial σ R_2)
      (hH : MvPolynomial.map ρ_loc H_1 = H_2)
      (q_1 : (MvPolynomial σ R_1 ⧸ Ideal.span ({H_1} : Set (MvPolynomial σ R_1))) →+* B')
      (hq_1_et : q_1.Etale),
      let I_1 := Ideal.span ({H_1} : Set (MvPolynomial σ R_1))
      let I_2 := Ideal.span ({H_2} : Set (MvPolynomial σ R_2))
      let s_0 : B' := q_1 (Ideal.Quotient.mk I_1 (MvPolynomial.C g))
      ∃ q_0 : (MvPolynomial σ R_2 ⧸ I_2) →+* Localization.Away s_0,
        q_0.Etale ∧
        (∀ r : R_1, q_0 (Ideal.Quotient.mk I_2 (MvPolynomial.C (ρ_loc r))) =
          algebraMap B' (Localization.Away s_0) (q_1 (Ideal.Quotient.mk I_1 (MvPolynomial.C r)))) ∧
        (∀ idx : σ, q_0 (Ideal.Quotient.mk I_2 (MvPolynomial.X idx)) =
          algebraMap B' (Localization.Away s_0) (q_1 (Ideal.Quotient.mk I_1 (MvPolynomial.X idx)))) := by
    intro σ R_1 R_2 B' _ _ _ ρ_loc g hLoc H_1 H_2 hH q_1 hq_1_et I_1 I_2 s_0
    letI : Algebra R_1 R_2 := ρ_loc.toAlgebra
    haveI : IsLocalization.Away g R_2 := hLoc
    letI : Algebra (MvPolynomial σ R_1) (MvPolynomial σ R_2) := MvPolynomial.algebraMvPolynomial
    have halg_mv : algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2) = MvPolynomial.map ρ_loc :=
      MvPolynomial.algebraMap_def
    have hLoc_mv_map : IsLocalization (Submonoid.map MvPolynomial.C (Submonoid.powers g))
        (MvPolynomial σ R_2) :=
      MvPolynomial.isLocalization (Submonoid.powers g) R_2
    have hLoc_mv : IsLocalization.Away (MvPolynomial.C g : MvPolynomial σ R_1)
        (MvPolynomial σ R_2) := by
      rwa [Submonoid.map_powers] at hLoc_mv_map
    have hI_map : Ideal.map (algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2)) I_1 = I_2 := by
      change Ideal.map (MvPolynomial.map ρ_loc) (Ideal.span {H_1}) = Ideal.span {H_2}
      rw [Ideal.map_span, Set.image_singleton, hH]
    let M_1 := MvPolynomial σ R_1 ⧸ I_1
    let M_2 := MvPolynomial σ R_2 ⧸ I_2
    have hIJ_M : ∀ P ∈ I_1,
        ((Ideal.Quotient.mk I_2).comp (algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2))) P = 0 := by
      intro P hP
      change Ideal.Quotient.mk I_2 (algebraMap _ _ P) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hI_map]
      exact Ideal.mem_map_of_mem _ hP
    let ρ_M : M_1 →+* M_2 :=
      Ideal.Quotient.lift I_1
        ((Ideal.Quotient.mk I_2).comp (algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2))) hIJ_M
    letI : Algebra M_1 M_2 := ρ_M.toAlgebra
    let bar_g : M_1 := Ideal.Quotient.mk I_1 (MvPolynomial.C g)
    haveI hLoc_M : IsLocalization (Submonoid.powers bar_g) M_2 :=
      { map_units := by
          rintro ⟨_, n, rfl⟩
          change IsUnit (ρ_M (bar_g ^ n))
          rw [map_pow]
          apply IsUnit.pow
          have hCg_unit : IsUnit (algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2)
              (MvPolynomial.C g)) :=
            IsLocalization.Away.algebraMap_isUnit (MvPolynomial.C g)
          exact hCg_unit.map (Ideal.Quotient.mk I_2)
        surj := by
          intro y_bar
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
          let sec_y := IsLocalization.Away.sec (MvPolynomial.C g : MvPolynomial σ R_1) y
          have hy_spec : y * algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2)
              ((MvPolynomial.C g) ^ sec_y.2) =
            algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2) sec_y.1 :=
            IsLocalization.Away.sec_spec (MvPolynomial.C g : MvPolynomial σ R_1) y
          refine ⟨⟨Ideal.Quotient.mk I_1 sec_y.1, ⟨bar_g ^ sec_y.2, sec_y.2, rfl⟩⟩, ?_⟩
          change Ideal.Quotient.mk I_2 y * ρ_M (bar_g ^ sec_y.2) =
            ρ_M (Ideal.Quotient.mk I_1 sec_y.1)
          have hbar_pow : bar_g ^ sec_y.2 =
              Ideal.Quotient.mk I_1 ((MvPolynomial.C g) ^ sec_y.2) :=
            (map_pow (Ideal.Quotient.mk I_1) (MvPolynomial.C g) sec_y.2).symm
          rw [hbar_pow]
          change Ideal.Quotient.mk I_2 y *
              Ideal.Quotient.mk I_2 (algebraMap _ _ ((MvPolynomial.C g) ^ sec_y.2)) =
            Ideal.Quotient.mk I_2 (algebraMap _ _ sec_y.1)
          rw [← map_mul, hy_spec]
