    letI : Algebra R_loc R_tilde := ι_R.toAlgebra
    have hs_int : IsIntegral R_loc (s ⊗ₜ[B₂] (1 : R_loc)) := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.C (algebraMap B₂ R_loc (mk_B2 (MvPolynomial.X 0))),
