        hDet' ℓ_r w β hwβ hflift_eq ↑(Y₂.left.presheaf.obj (Opposite.op V_pb))
        π_quot hSurj_π hKer_π
    let V : Y₂.left.Opens := Y₂.left.basicOpen δ_B
    have hle_V : V ≤ V_pb := Y₂.left.basicOpen_le δ_B
    have hy_V : y ∈ V := by
      have hpre := AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen V_pb δ_B
      have hmem_iff := SetLike.ext_iff.mp hpre ⟨y, hy_Vpb⟩
      have hnot := hδ_notMem (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩).asIdeal
        (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩).isPrime hy_ideal
      have hin_spec : V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩ ∈ PrimeSpectrum.basicOpen δ_B :=
