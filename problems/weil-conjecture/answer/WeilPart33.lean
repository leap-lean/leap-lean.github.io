            ((AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X γ)).1 \ {s'.base pt}) := by
        ext q
        simp only [Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_sdiff]
        constructor
        · intro hne
