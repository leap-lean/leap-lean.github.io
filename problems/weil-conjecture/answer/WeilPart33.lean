              (ConcreteCategory.comp_apply (ηS_app V₁) (ρ_app V₁) r_val)
          have h_lhs3 : (ηS_app V₁) r_val = oneR_S.obj.map v₁.op s :=
            (congrArg (fun τ : P_const_S ⟶ oneR_S.obj => (τ.app (Opposite.op V₁)) r_val)
              hηS_eq).trans hr_val
          have hnat_ρ := congrArg (fun u => u s) (ρ.hom.naturality v₁.op)
          simp only [ConcreteCategory.comp_apply] at hnat_ρ
