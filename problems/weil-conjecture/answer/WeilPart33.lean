          (homOfLE (inf_le_left : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.1)).op)
      dsimp at hnat
      have hmap_c : (Z_k.presheaf.map (homOfLE (hle_left q)).op).hom
          (algebraMap k ↑(Z_k.presheaf.obj (Opposite.op (U_k_cov q.1))) c) =
          algebraMap k ↑(Z_k.presheaf.obj (Opposite.op (p ⁻¹ᵁ (U_cov q.1 ⊓ U_cov q.2)))) c :=
        hMapCompZk (hle_left q) le_top le_top (α_k.hom c)
      rw [hmap_c, hnat]
    have hf₂_intertwine :
        eB.toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id k k) f₂) =
          f₂_k.comp eA.toAlgHom := by
      apply Algebra.TensorProduct.ext'
      intro c s
      funext q
      change (Φ (U_cov q.1 ⊓ U_cov q.2))
        (c ⊗ₜ[E] (Z.presheaf.map (homOfLE inf_le_right).op).hom (s q.2)) =
        (Z_k.presheaf.map (homOfLE (hle_right q)).op).hom ((Φ (U_cov q.2)) (c ⊗ₜ[E] s q.2))
      rw [hΦ_tmul, hΦ_tmul, map_mul]
      have hnat := congrArg (fun φ => φ.hom (s q.2))
        (AlgebraicGeometry.Scheme.Hom.naturality p
          (homOfLE (inf_le_right : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.2)).op)
      dsimp at hnat
      have hmap_c : (Z_k.presheaf.map (homOfLE (hle_right q)).op).hom
          (algebraMap k ↑(Z_k.presheaf.obj (Opposite.op (U_k_cov q.2))) c) =
          algebraMap k ↑(Z_k.presheaf.obj (Opposite.op (p ⁻¹ᵁ (U_cov q.1 ⊓ U_cov q.2)))) c :=
        hMapCompZk (hle_right q) le_top le_top (α_k.hom c)
      rw [hmap_c, hnat]
    let resZk : ↑(Z_k.presheaf.obj (Opposite.op ⊤)) →ₐ[k] ↥(f₁_k.equalizer f₂_k) :=
      { toFun := fun t =>
          ⟨fun i => (Z_k.presheaf.map (homOfLE le_top).op).hom t, by
            funext q
            exact (hMapCompZk (hle_left q) le_top le_top t).trans
              (hMapCompZk (hle_right q) le_top le_top t).symm⟩
        map_one' := Subtype.ext <| funext fun i =>
          map_one (Z_k.presheaf.map (homOfLE (le_top : U_k_cov i ≤ ⊤)).op).hom
        map_mul' := fun x y => Subtype.ext <| funext fun i =>
          map_mul (Z_k.presheaf.map (homOfLE (le_top : U_k_cov i ≤ ⊤)).op).hom x y
        map_zero' := Subtype.ext <| funext fun i =>
          map_zero (Z_k.presheaf.map (homOfLE (le_top : U_k_cov i ≤ ⊤)).op).hom
        map_add' := fun x y => Subtype.ext <| funext fun i =>
          map_add (Z_k.presheaf.map (homOfLE (le_top : U_k_cov i ≤ ⊤)).op).hom x y
        commutes' := fun c => Subtype.ext <| funext fun i =>
          hMapCompZk (le_top : U_k_cov i ≤ ⊤) le_top le_top (α_k.hom c) }
    have hBij_resZk : Function.Bijective resZk := by
      constructor
      · intro t₁ t₂ h
        have hglue := Z_k.sheaf.existsUnique_gluing' U_k_cov ⊤ (fun i => homOfLE le_top)
          (by rw [hSupUk]) (fun i => (Z_k.presheaf.map (homOfLE le_top).op).hom t₁)
          (fun i j => (hMapCompZk inf_le_left le_top le_top t₁).trans
            (hMapCompZk inf_le_right le_top le_top t₁).symm)
        exact hglue.unique (fun _ => rfl) (fun i => congrFun (congrArg Subtype.val h.symm) i)
      · rintro ⟨sf, hsf⟩
        have hglue := Z_k.sheaf.existsUnique_gluing' U_k_cov ⊤ (fun i => homOfLE le_top)
          (by rw [hSupUk]) sf (fun i j => congrFun hsf (i, j))
        obtain ⟨t, ht, _⟩ := hglue
        exact ⟨t, Subtype.ext (funext ht)⟩
    let eZk : ↑(Z_k.presheaf.obj (Opposite.op ⊤)) ≃ₐ[k] ↥(f₁_k.equalizer f₂_k) :=
      AlgEquiv.ofBijective resZk hBij_resZk
    let eEq : ↥((Algebra.TensorProduct.map (AlgHom.id k k) f₁).equalizer
        (Algebra.TensorProduct.map (AlgHom.id k k) f₂)) ≃ₐ[k] ↥(f₁_k.equalizer f₂_k) :=
      { toFun := fun x =>
          ⟨eA x.1, by
            change f₁_k (eA x.1) = f₂_k (eA x.1)
            have hx : (Algebra.TensorProduct.map (AlgHom.id k k) f₁) x.1 =
                (Algebra.TensorProduct.map (AlgHom.id k k) f₂) x.1 := x.2
            have h1 := congrArg (fun φ => φ x.1) hf₁_intertwine
            have h2 := congrArg (fun φ => φ x.1) hf₂_intertwine
            dsimp at h1 h2
            rw [← h1, ← h2, hx]⟩
        invFun := fun y =>
          ⟨eA.symm y.1, by
            change (Algebra.TensorProduct.map (AlgHom.id k k) f₁) (eA.symm y.1) =
              (Algebra.TensorProduct.map (AlgHom.id k k) f₂) (eA.symm y.1)
            apply eB.injective
            have h1 := congrArg (fun φ => φ (eA.symm y.1)) hf₁_intertwine
            have h2 := congrArg (fun φ => φ (eA.symm y.1)) hf₂_intertwine
            dsimp at h1 h2
            rw [h1, h2, eA.apply_symm_apply]
            exact y.2⟩
        left_inv := fun x => Subtype.ext (eA.symm_apply_apply x.1)
        right_inv := fun y => Subtype.ext (eA.apply_symm_apply y.1)
        map_mul' := fun x y => Subtype.ext (map_mul eA x.1 y.1)
        map_add' := fun x y => Subtype.ext (map_add eA x.1 y.1)
        commutes' := fun c => Subtype.ext (eA.commutes c) }
    let eTensorZ : TensorProduct E k ↑(Z.presheaf.obj (Opposite.op ⊤)) ≃ₐ[k]
        TensorProduct E k ↥(f₁.equalizer f₂) :=
      Algebra.TensorProduct.congr AlgEquiv.refl eZ
    let Ψ : TensorProduct E k ↑(Z.presheaf.obj (Opposite.op ⊤)) ≃ₐ[k]
        ↑(Z_k.presheaf.obj (Opposite.op ⊤)) :=
      eTensorZ.trans ((AlgHom.tensorEqualizerEquiv k k f₁ f₂).trans (eEq.trans eZk.symm))
    have hΨ_eq : Ψ.toAlgHom = Φ_top := by
      apply Algebra.TensorProduct.ext'
      intro c t
      apply eZk.injective
      apply Subtype.ext
      funext i
      have hLHS : (eZk (Ψ (c ⊗ₜ[E] t))).1 i =
          (Φ (U_cov i)) (c ⊗ₜ[E] ((Z.presheaf.map (homOfLE le_top).op).hom t)) := by
        simp only [Ψ, AlgEquiv.trans_apply, eZk.apply_symm_apply]
        rfl
      change (eZk (Ψ (c ⊗ₜ[E] t))).1 i = (eZk (Φ_top (c ⊗ₜ[E] t))).1 i
      rw [hLHS]
      change (Φ (U_cov i)) (c ⊗ₜ[E] ((Z.presheaf.map (homOfLE le_top).op).hom t)) =
        (Z_k.presheaf.map (homOfLE (le_top : U_k_cov i ≤ ⊤)).op).hom (Φ_top (c ⊗ₜ[E] t))
      rw [hΦ_tmul, hΦtop_tmul, map_mul]
      have hnat := congrArg (fun φ => φ.hom t)
        (AlgebraicGeometry.Scheme.Hom.naturality p (homOfLE (le_top : U_cov i ≤ ⊤)).op)
      dsimp at hnat
      have hmap_c : (Z_k.presheaf.map (homOfLE (le_top : U_k_cov i ≤ ⊤)).op).hom
          (algebraMap k ↑(Z_k.presheaf.obj (Opposite.op ⊤)) c) =
          algebraMap k ↑(Z_k.presheaf.obj (Opposite.op (U_k_cov i))) c :=
        hMapCompZk (le_top : U_k_cov i ≤ ⊤) le_top le_top (α_k.hom c)
      rw [hmap_c, hnat]
      rfl
    have hBijTop : Function.Bijective Φ_top := by
      rw [← hΨ_eq]
      exact Ψ.bijective
    let φ_top : CommRingCat.of (TensorProduct E k ↑(Z.presheaf.obj (Opposite.op ⊤))) ⟶
        Z_k.presheaf.obj (Opposite.op ⊤) :=
      CommRingCat.ofHom Φ_top.toRingHom
    haveI : CategoryTheory.IsIso φ_top :=
      (ConcreteCategory.isIso_iff_bijective φ_top).mpr hBijTop
    have hPush : CategoryTheory.IsPushout α_E (CommRingCat.ofHom (algebraMap E k))
        p.appTop α_k := by
      have hPush0 :=
        (CommRingCat.isPushout_tensorProduct E k ↑(Z.presheaf.obj (Opposite.op ⊤))).flip
      refine hPush0.of_iso (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) (CategoryTheory.asIso φ_top)
        ?_ (by simp) ?_ ?_
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
        ext x
        exact hMapIdZ le_top (α_E.hom x)
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.id_comp,
          CategoryTheory.asIso_hom]
        ext r
        change Φ_top (1 ⊗ₜ[E] r) = p.appTop.hom r
        rw [hΦtop_tmul, map_one, one_mul]
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.id_comp,
          CategoryTheory.asIso_hom]
        ext c
        change Φ_top (c ⊗ₜ[E] 1) = α_k.hom c
        rw [hΦtop_tmul, map_one, mul_one]
        exact hMapIdZk le_top (α_k.hom c)
    have hpSpec : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map p.appTop)
        (AlgebraicGeometry.Spec.map α_k) (AlgebraicGeometry.Spec.map α_E) s_Ek :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    have hg_fac : Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_E = g := by
      calc Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_E
          = (Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map g.appTop) ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv := by
            dsimp only [α_E]
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = g ≫ (AlgebraicGeometry.Spec (CommRingCat.of E)).toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv := by
            rw [← AlgebraicGeometry.Scheme.toSpecΓ_naturality g, CategoryTheory.Category.assoc]
        _ = g := by
            rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom (CommRingCat.of E),
              ← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
    have hgk_fac : Z_k.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_k = g_k := by
      calc Z_k.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_k
          = (Z_k.toSpecΓ ≫ AlgebraicGeometry.Spec.map g_k.appTop) ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
            dsimp only [α_k]
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = g_k ≫ (AlgebraicGeometry.Spec (CommRingCat.of k)).toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
            rw [← AlgebraicGeometry.Scheme.toSpecΓ_naturality g_k, CategoryTheory.Category.assoc]
        _ = g_k := by
            rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom (CommRingCat.of k),
              ← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
    have hp_outer : CategoryTheory.IsPullback p
        (Z_k.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_k)
        (Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map α_E) s_Ek := by
      rwa [hgk_fac, hg_fac]
    have hpTop : CategoryTheory.IsPullback p Z_k.toSpecΓ Z.toSpecΓ
        (AlgebraicGeometry.Spec.map p.appTop) :=
      CategoryTheory.IsPullback.of_bot hp_outer
        (AlgebraicGeometry.Scheme.toSpecΓ_naturality p) hpSpec
    have hp_surj : AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map p.appTop) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Surjective) hpSpec.flip inferInstance
    have hp_flat : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map p.appTop) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Flat) hpSpec.flip inferInstance
    have hp_qc : AlgebraicGeometry.QuasiCompact (AlgebraicGeometry.Spec.map p.appTop) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.QuasiCompact) hpSpec.flip inferInstance
    have hIsoZk : (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
        Z_k.toSpecΓ :=
      @AlgebraicGeometry.IsAffine.affine Z_k hAff_Zk
    haveI : CategoryTheory.IsIso Z.toSpecΓ :=
      CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback
        (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
        (Q := @AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓
          @AlgebraicGeometry.QuasiCompact)
        hpTop.flip ⟨⟨hp_surj, hp_flat⟩, hp_qc⟩ hIsoZk
    exact AlgebraicGeometry.IsAffine.mk inferInstance

  have hOpenAffineDescent :
      ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p_W : W.left ⟶ Y.left)
        (U_E : Y.left.Opens) (U_k : W.left.Opens),
      IsFieldPullbackModel E k Y W p_W →
      AlgebraicGeometry.IsSeparated Y.hom →
      (TopologicalSpace.Opens.map p_W.base).obj U_E = U_k →
      AlgebraicGeometry.IsAffineOpen U_k →
      AlgebraicGeometry.IsAffineOpen U_E := by
    intro Y W p_W U_E U_k hp_W hSepY hU hAff_Uk
    obtain ⟨p_U, _, _, hpU_mod⟩ := hOpenModel Y W p_W U_E U_k hp_W hU
    obtain ⟨_, _, _, _, _, hpU_surj⟩ :=
      hModelFPQC (CategoryTheory.Over.mk (U_E.ι ≫ Y.hom))
        (CategoryTheory.Over.mk (U_k.ι ≫ W.hom)) p_U hpU_mod
    have hComp_Uk : CompactSpace ↥(U_k : AlgebraicGeometry.Scheme.{u}) := by
      have : AlgebraicGeometry.IsAffine (U_k : AlgebraicGeometry.Scheme.{u}) := hAff_Uk
      infer_instance
    have hComp_UE : CompactSpace ↥(U_E : AlgebraicGeometry.Scheme.{u}) := by
      refine ⟨?_⟩
      rw [← Set.image_univ_of_surjective hpU_surj]
      exact (@isCompact_univ _ _ hComp_Uk).image p_U.continuous
    have hSep_UE : AlgebraicGeometry.IsSeparated (U_E.ι ≫ Y.hom) :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _
        (AlgebraicGeometry.IsSeparated.isSeparated_of_mono U_E.ι) hSepY
    exact (hAffCore (U_E : AlgebraicGeometry.Scheme.{u}) (U_k : AlgebraicGeometry.Scheme.{u})
      (U_E.ι ≫ Y.hom) (U_k.ι ≫ W.hom) p_U hpU_mod).2 hComp_UE hSep_UE hAff_Uk

  have hPart4 :
      ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p_W : W.left ⟶ Y.left)
        (U_E : Y.left.Opens) (U_k : W.left.Opens),
      IsFieldPullbackModel E k Y W p_W →
      CompactSpace ↥Y.left →
      AlgebraicGeometry.IsSeparated Y.hom →
      AlgebraicGeometry.LocallyOfFiniteType Y.hom →
      (TopologicalSpace.Opens.map p_W.base).obj U_E = U_k →
      AlgebraicGeometry.IsAffineOpen U_k →
      AlgebraicGeometry.IsAffineOpen U_E := by
    intro Y W p_W U_E U_k hp_W _ hSepY _ hU hAff_Uk
    exact hOpenAffineDescent Y W p_W U_E U_k hp_W hSepY hU hAff_Uk

  have hClosedImmDescent :
      ∀ (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
        (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p₁ : W₁.left ⟶ Y₁.left) (p₂ : W₂.left ⟶ Y₂.left)
        (φ_E : Y₁ ⟶ Y₂) (φ_k : W₁ ⟶ W₂),
      IsFieldPullbackModel E k Y₁ W₁ p₁ →
      IsFieldPullbackModel E k Y₂ W₂ p₂ →
      p₁ ≫ φ_E.left = φ_k.left ≫ p₂ →
      CompactSpace ↥Y₁.left →
      AlgebraicGeometry.IsSeparated Y₁.hom →
      AlgebraicGeometry.IsSeparated Y₂.hom →
      AlgebraicGeometry.IsClosedImmersion φ_k.left →
      AlgebraicGeometry.IsClosedImmersion φ_E.left := by
    intro Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm _ hSep₁ _ hCl_k
    have : AlgebraicGeometry.IsClosedImmersion φ_k.left := hCl_k
    obtain ⟨_, _, _, hp₂_aff, _, _⟩ := hModelFPQC Y₂ W₂ p₂ hp₂
    have : AlgebraicGeometry.IsAffineHom p₂ := hp₂_aff
    have hAffHom_φE : AlgebraicGeometry.IsAffineHom φ_E.left := by
      rw [AlgebraicGeometry.isAffineHom_iff]
      intro U hU
      let U_k : W₂.left.Opens := p₂ ⁻¹ᵁ U
      have hUk : AlgebraicGeometry.IsAffineOpen U_k :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage U hU
      let V : Y₁.left.Opens := φ_E.left ⁻¹ᵁ U
      let V_k : W₁.left.Opens := φ_k.left ⁻¹ᵁ U_k
      have hVk : AlgebraicGeometry.IsAffineOpen V_k :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage U_k hUk
      have hV_eq : (TopologicalSpace.Opens.map p₁.base).obj V = V_k := by
        ext w₁
        change (p₁ ≫ φ_E.left).base w₁ ∈ U ↔ (φ_k.left ≫ p₂).base w₁ ∈ U
        rw [hcomm]
      exact hOpenAffineDescent Y₁ W₁ p₁ V V_k hp₁ hSep₁ hV_eq hVk
    rw [AlgebraicGeometry.isClosedImmersion_iff_isAffineHom]
    refine ⟨hAffHom_φE, fun U hU => ?_⟩
    have : AlgebraicGeometry.IsAffineHom φ_E.left := hAffHom_φE
    let V : Y₁.left.Opens := φ_E.left ⁻¹ᵁ U
    have hV : AlgebraicGeometry.IsAffineOpen V :=
      AlgebraicGeometry.IsAffineHom.isAffine_preimage U hU
    let U_k : W₂.left.Opens := p₂ ⁻¹ᵁ U
    have hUk : AlgebraicGeometry.IsAffineOpen U_k :=
      AlgebraicGeometry.IsAffineHom.isAffine_preimage U hU
    let V_k : W₁.left.Opens := φ_k.left ⁻¹ᵁ U_k
    have hVk_eq : V_k = p₁ ⁻¹ᵁ V := by
      ext w₁
      change (φ_k.left ≫ p₂).base w₁ ∈ U ↔ (p₁ ≫ φ_E.left).base w₁ ∈ U
      rw [hcomm]
    let α_E₂ : CommRingCat.of E ⟶ Γ(Y₂.left, ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ Y₂.hom.appTop
    let α_E₁ : CommRingCat.of E ⟶ Γ(Y₁.left, ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ Y₁.hom.appTop
    let α_k₂ : CommRingCat.of k ⟶ Γ(W₂.left, ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ W₂.hom.appTop
    let α_k₁ : CommRingCat.of k ⟶ Γ(W₁.left, ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ W₁.hom.appTop
    let R := ↑(Y₂.left.presheaf.obj (Opposite.op U))
    let S := ↑(Y₁.left.presheaf.obj (Opposite.op V))
    let R' := ↑(W₂.left.presheaf.obj (Opposite.op U_k))
    let S' := ↑(W₁.left.presheaf.obj (Opposite.op (p₁ ⁻¹ᵁ V)))
    let _ : Algebra E R :=
      ((α_E₂ ≫ Y₂.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom).toAlgebra
    let _ : Algebra E S :=
      ((α_E₁ ≫ Y₁.left.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom).toAlgebra
    let _ : Algebra k R' :=
      ((α_k₂ ≫ W₂.left.presheaf.map (homOfLE (le_top : U_k ≤ ⊤)).op).hom).toAlgebra
    let _ : Algebra k S' :=
      ((α_k₁ ≫ W₁.left.presheaf.map (homOfLE (le_top : p₁ ⁻¹ᵁ V ≤ ⊤)).op).hom).toAlgebra
    let _ : Algebra E S' :=
      (((α_k₁ ≫ W₁.left.presheaf.map (homOfLE (le_top : p₁ ⁻¹ᵁ V ≤ ⊤)).op).hom).comp
        (algebraMap E k)).toAlgebra
    have : IsScalarTower E k S' := IsScalarTower.of_algebraMap_eq' rfl
    obtain ⟨Φ_U, hBij_U, hΦ_U⟩ := (hAffCore Y₂.left W₂.left Y₂.hom W₂.hom p₂ hp₂).1 U hU
    obtain ⟨Φ_V, hBij_V, hΦ_V⟩ := (hAffCore Y₁.left W₁.left Y₁.hom W₁.hom p₁ hp₁).1 V hV
    let α_alg : R →ₐ[E] S :=
      { toRingHom := (φ_E.left.app U).hom
        commutes' := fun c => by
          have hw : Y₂.hom.appTop ≫ φ_E.left.appTop = Y₁.hom.appTop := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Over.w φ_E]
          have hα : α_E₂ ≫ φ_E.left.appTop = α_E₁ := by
            dsimp [α_E₂, α_E₁]
            rw [CategoryTheory.Category.assoc, hw]
          have hnat := congrArg (fun f => f.hom (α_E₂.hom c))
            (AlgebraicGeometry.Scheme.Hom.naturality φ_E.left (homOfLE (le_top : U ≤ ⊤)).op)
          have hc := congrArg (fun f => f.hom c) hα
          dsimp at hnat hc ⊢
          calc (φ_E.left.app U).hom
                ((Y₂.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (α_E₂.hom c))
              = (Y₁.left.presheaf.map ((TopologicalSpace.Opens.map φ_E.left.base).map
                  (homOfLE (le_top : U ≤ ⊤))).op).hom (φ_E.left.appTop.hom (α_E₂.hom c)) := hnat
            _ = (Y₁.left.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (α_E₁.hom c) := by
                rw [hc]; rfl }
    let e_Vk : W₁.left.presheaf.obj (Opposite.op V_k) ⟶
        W₁.left.presheaf.obj (Opposite.op (p₁ ⁻¹ᵁ V)) :=
      W₁.left.presheaf.map (eqToHom hVk_eq.symm).op
    have hSurj_eVk : Function.Surjective e_Vk.hom :=
      ((ConcreteCategory.isIso_iff_bijective e_Vk).mp inferInstance).2
    have hSurj_φk : Function.Surjective (φ_k.left.app U_k).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective φ_k.left U_k hUk
    let β_hom : W₂.left.presheaf.obj (Opposite.op U_k) ⟶
        W₁.left.presheaf.obj (Opposite.op (p₁ ⁻¹ᵁ V)) :=
      φ_k.left.app U_k ≫ e_Vk
    have hSurj_β : Function.Surjective β_hom.hom := hSurj_eVk.comp hSurj_φk
    have hβ_comm_p : p₂.app U ≫ β_hom = φ_E.left.app U ≫ p₁.app V := by
      have h1 := AlgebraicGeometry.Scheme.Hom.congr_app hcomm.symm U
      have h2 := congrArg (· ≫ e_Vk) h1
      rw [AlgebraicGeometry.Scheme.Hom.comp_app, AlgebraicGeometry.Scheme.Hom.comp_app] at h2
      dsimp only [β_hom, e_Vk] at h2 ⊢
      rw [← CategoryTheory.Category.assoc, h2]
      have hEq1 : (φ_k.left ≫ p₂) ⁻¹ᵁ U = (p₁ ≫ φ_E.left) ⁻¹ᵁ U := by rw [hcomm]
      have h_id : W₁.left.presheaf.map (eqToHom hEq1).op ≫
          W₁.left.presheaf.map (eqToHom hVk_eq.symm).op = 𝟙 _ :=
        (W₁.left.presheaf.map_comp _ _).symm.trans
          ((congrArg W₁.left.presheaf.map (Subsingleton.elim _ _)).trans
            (W₁.left.presheaf.map_id _))
      exact (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg ((φ_E.left.app U ≫ p₁.app V) ≫ ·) h_id).trans
          (CategoryTheory.Category.comp_id _))
    have hβ_alg : ∀ c : k,
        β_hom.hom ((α_k₂ ≫ W₂.left.presheaf.map (homOfLE (le_top : U_k ≤ ⊤)).op).hom c) =
          (α_k₁ ≫ W₁.left.presheaf.map (homOfLE (le_top : p₁ ⁻¹ᵁ V ≤ ⊤)).op).hom c := by
      intro c
      have hw : W₂.hom.appTop ≫ φ_k.left.appTop = W₁.hom.appTop := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Over.w φ_k]
      have hα : α_k₂ ≫ φ_k.left.appTop = α_k₁ := by
        dsimp [α_k₂, α_k₁]
        rw [CategoryTheory.Category.assoc, hw]
      have hnat : W₂.left.presheaf.map (homOfLE (le_top : U_k ≤ ⊤)).op ≫ φ_k.left.app U_k =
          φ_k.left.appTop ≫ W₁.left.presheaf.map (homOfLE (le_top : V_k ≤ ⊤)).op :=
        AlgebraicGeometry.Scheme.Hom.naturality φ_k.left (homOfLE (le_top : U_k ≤ ⊤)).op
      have hmap_eq : W₁.left.presheaf.map (homOfLE (le_top : V_k ≤ ⊤)).op ≫ e_Vk =
          W₁.left.presheaf.map (homOfLE (le_top : p₁ ⁻¹ᵁ V ≤ ⊤)).op := by
        dsimp [e_Vk]
        rw [← W₁.left.presheaf.map_comp]
        exact congrArg W₁.left.presheaf.map (Subsingleton.elim _ _)
      have htot : (α_k₂ ≫ W₂.left.presheaf.map (homOfLE (le_top : U_k ≤ ⊤)).op) ≫ β_hom =
          α_k₁ ≫ W₁.left.presheaf.map (homOfLE (le_top : p₁ ⁻¹ᵁ V ≤ ⊤)).op := by
        calc (α_k₂ ≫ W₂.left.presheaf.map (homOfLE (le_top : U_k ≤ ⊤)).op) ≫ β_hom
            = α_k₂ ≫ (W₂.left.presheaf.map (homOfLE (le_top : U_k ≤ ⊤)).op ≫ φ_k.left.app U_k) ≫ e_Vk := by
              dsimp [β_hom]
              simp only [CategoryTheory.Category.assoc]
          _ = α_k₂ ≫ (φ_k.left.appTop ≫ W₁.left.presheaf.map (homOfLE (le_top : V_k ≤ ⊤)).op) ≫ e_Vk := by
              rw [hnat]
          _ = (α_k₂ ≫ φ_k.left.appTop) ≫ (W₁.left.presheaf.map (homOfLE (le_top : V_k ≤ ⊤)).op ≫ e_Vk) := by
              simp only [CategoryTheory.Category.assoc]
          _ = α_k₁ ≫ W₁.left.presheaf.map (homOfLE (le_top : p₁ ⁻¹ᵁ V ≤ ⊤)).op := by
              rw [hα, hmap_eq]
      exact congrArg (fun f => f.hom c) htot
    let β_alg : R' →ₐ[k] S' :=
      { toRingHom := β_hom.hom
        commutes' := hβ_alg }
    let M_α := Algebra.TensorProduct.map (AlgHom.id k k) α_alg
    have hInter_alg : β_alg.comp Φ_U = Φ_V.comp M_α := by
      apply Algebra.TensorProduct.ext'
      intro c r
      change β_hom.hom (Φ_U (c ⊗ₜ[E] r)) = Φ_V (c ⊗ₜ[E] (φ_E.left.app U).hom r)
      rw [hΦ_U, hΦ_V, map_mul, hβ_alg c]
      have hr := congrArg (fun f => f.hom r) hβ_comm_p
      dsimp at hr
      rw [hr]
    have hInter : ∀ z : TensorProduct E k R, β_hom.hom (Φ_U z) = Φ_V (M_α z) :=
      fun z => congrArg (fun f => f z) hInter_alg
    have hSurj_M : Function.Surjective M_α := by
      intro w
      obtain ⟨x, hx⟩ := hSurj_β (Φ_V w)
      obtain ⟨z, hz⟩ := hBij_U.2 x
      refine ⟨z, hBij_V.1 ?_⟩
      rw [← hInter z, hz, hx]
    exact hSurjRetractAlg R S α_alg hSurj_M

  
  
  
  refine ⟨hPart1, ?_, hPart3, hPart4⟩
  intro Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm
  obtain ⟨hp₂_surj, hp₂_flat, hp₂_qc, _, _, _⟩ := hModelFPQC Y₂ W₂ p₂ hp₂
  obtain ⟨hSq_flip, hSq⟩ := hCartSq Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm
  have hFibLift : ∀ (y : Y₁.left) (w₂ : W₂.left),
      φ_E.left.base y = p₂.base w₂ →
      ∃ w₁ : W₁.left, p₁.base w₁ = y ∧ φ_k.left.base w₁ = w₂ := by
    intro y w₂ hyw
    obtain ⟨z, hz_fst, hz_snd⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y w₂ hyw
    refine ⟨hSq.isoPullback.inv.base z, ?_, ?_⟩
    · calc p₁.base (hSq.isoPullback.inv.base z)
          = (hSq.isoPullback.inv ≫ p₁).base z := rfl
        _ = (CategoryTheory.Limits.pullback.fst φ_E.left p₂).base z := by
            rw [hSq.isoPullback_inv_fst]
        _ = y := hz_fst
    · calc φ_k.left.base (hSq.isoPullback.inv.base z)
          = (hSq.isoPullback.inv ≫ φ_k.left).base z := rfl
        _ = (CategoryTheory.Limits.pullback.snd φ_E.left p₂).base z := by
            rw [hSq.isoPullback_inv_snd]
        _ = w₂ := hz_snd
  have hPreRange : p₂.base ⁻¹' (Set.range φ_E.left.base) = Set.range φ_k.left.base := by
    ext w₂
    constructor
    · rintro ⟨y, hy⟩
      obtain ⟨w₁, _, hw₂⟩ := hFibLift y w₂ hy
      exact ⟨w₁, hw₂⟩
    · rintro ⟨w₁, rfl⟩
      refine ⟨p₁.base w₁, ?_⟩
      change (p₁ ≫ φ_E.left).base w₁ = (φ_k.left ≫ p₂).base w₁
      rw [hcomm]
  have hSurjDesc : AlgebraicGeometry.Surjective φ_k.left →
      AlgebraicGeometry.Surjective φ_E.left :=
    fun h => CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback
      (P := @AlgebraicGeometry.Surjective)
      (Q := @AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓
        @AlgebraicGeometry.QuasiCompact)
      hSq_flip ⟨⟨hp₂_surj, hp₂_flat⟩, hp₂_qc⟩ h
  have hOpenImmDesc : AlgebraicGeometry.IsOpenImmersion φ_k.left →
      AlgebraicGeometry.IsOpenImmersion φ_E.left :=
    fun h => CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion)
      (Q := @AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓
        @AlgebraicGeometry.QuasiCompact)
      hSq_flip ⟨⟨hp₂_surj, hp₂_flat⟩, hp₂_qc⟩ h
  have hEtaleDesc : AlgebraicGeometry.Etale φ_k.left →
      AlgebraicGeometry.Etale φ_E.left :=
    fun h => CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback
      (P := @AlgebraicGeometry.Etale)
      (Q := @AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓
        @AlgebraicGeometry.QuasiCompact)
      hSq_flip ⟨⟨hp₂_surj, hp₂_flat⟩, hp₂_qc⟩ h
  have hTgtOpenProps : ∀ (U_E : Y₂.left.Opens) (U_k : W₂.left.Opens),
      (TopologicalSpace.Opens.map p₂.base).obj U_E = U_k →
      (CategoryTheory.IsIso (φ_k.left ∣_ U_k) → CategoryTheory.IsIso (φ_E.left ∣_ U_E)) ∧
      (∀ d : ℕ, AlgebraicGeometry.SmoothOfRelativeDimension d (φ_k.left ∣_ U_k) →
        AlgebraicGeometry.SmoothOfRelativeDimension d (φ_E.left ∣_ U_E)) := by
    intro U_E U_k hU
    obtain ⟨p_V, p_U, ψ_E, ψ_k, hψE, hψk, hpV_mod, hpU_mod, hcomm_res⟩ :=
      hOpenTgtRestrictModels Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k U_E U_k hp₁ hp₂ hcomm hU
    refine ⟨fun hIso_k => ?_, fun d hSm_k => ?_⟩
    · rw [← hψE]
      rw [← hψk] at hIso_k
      exact hIsoDescent _ _ _ _ p_V p_U ψ_E ψ_k hpV_mod hpU_mod hcomm_res hIso_k
    · rw [← hψE]
      rw [← hψk] at hSm_k
      exact hSmoothRelDim _ _ _ _ p_V p_U ψ_E ψ_k hpV_mod hpU_mod hcomm_res d hSm_k
  have hSrcOpenProps : ∀ (V_E : Y₁.left.Opens) (V_k : W₁.left.Opens),
      (TopologicalSpace.Opens.map p₁.base).obj V_E = V_k →
      ∀ d : ℕ, AlgebraicGeometry.SmoothOfRelativeDimension d (V_k.ι ≫ φ_k.left) →
        AlgebraicGeometry.SmoothOfRelativeDimension d (V_E.ι ≫ φ_E.left) := by
    intro V_E V_k hV d hSm_k
    obtain ⟨p_V, hpV_fac, _, hpV_mod⟩ := hOpenModel Y₁ W₁ p₁ V_E V_k hp₁ hV
    let ψ_E : CategoryTheory.Over.mk (V_E.ι ≫ Y₁.hom) ⟶ Y₂ :=
      CategoryTheory.Over.homMk (V_E.ι ≫ φ_E.left)
        (by dsimp; rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w φ_E])
    let ψ_k : CategoryTheory.Over.mk (V_k.ι ≫ W₁.hom) ⟶ W₂ :=
      CategoryTheory.Over.homMk (V_k.ι ≫ φ_k.left)
        (by dsimp; rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w φ_k])
    have hcomm_V : p_V ≫ ψ_E.left = ψ_k.left ≫ p₂ := by
      change p_V ≫ (V_E.ι ≫ φ_E.left) = (V_k.ι ≫ φ_k.left) ≫ p₂
      rw [← CategoryTheory.Category.assoc, hpV_fac, CategoryTheory.Category.assoc, hcomm,
        ← CategoryTheory.Category.assoc]
    exact hSmoothRelDim _ Y₂ _ W₂ p_V p₂ ψ_E ψ_k hpV_mod hp₂ hcomm_V d hSm_k
  have hGeomFibIrred :
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_k : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₂.left),
        IrreducibleSpace ↥(CategoryTheory.Limits.pullback φ_k.left s_k)) →
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_E : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y₂.left),
        IrreducibleSpace ↥(CategoryTheory.Limits.pullback φ_E.left s_E)) := by
    intro hIrred_k Ω _ _ s_E
    let ψ_EΩ : CommRingCat.of E ⟶ CommRingCat.of Ω :=
      AlgebraicGeometry.Spec.preimage (s_E ≫ Y₂.hom)
    have hψ_EΩ : AlgebraicGeometry.Spec.map ψ_EΩ = s_E ≫ Y₂.hom :=
      AlgebraicGeometry.Spec.map_preimage (s_E ≫ Y₂.hom)
    letI : Algebra E Ω := ψ_EΩ.hom.toAlgebra
    let σ : k →ₐ[E] Ω := IsAlgClosed.lift (R := E) (S := k) (M := Ω)
    let s_kΩ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)
    have hs_comm : s_E ≫ Y₂.hom = s_kΩ ≫ s_Ek := by
      rw [← hψ_EΩ]
      dsimp [s_kΩ, s_Ek]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      ext x
      exact (σ.commutes x).symm
    let s_k : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₂.left :=
      hp₂.lift s_E s_kΩ hs_comm
    have hs_k_fac : s_k ≫ p₂ = s_E := hp₂.lift_fst s_E s_kΩ hs_comm
    have hPb_Ω : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst φ_k.left s_k ≫ p₁)
        (CategoryTheory.Limits.pullback.snd φ_k.left s_k)
        φ_E.left s_E := by
      rw [← hs_k_fac]
      exact (CategoryTheory.IsPullback.of_hasPullback φ_k.left s_k).paste_horiz hSq
    let e_top := TopCat.homeoOfIso
      (AlgebraicGeometry.Scheme.forgetToTop.mapIso hPb_Ω.isoPullback)
    exact (Homeomorph.irreducibleSpace_iff e_top).mp (hIrred_k Ω s_k)
  exact ⟨hPreRange, hFibLift, hSurjDesc, hOpenImmDesc, hEtaleDesc,
    hSmoothRelDim Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm,
    hFlatDescent Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm,
    hClosedImmDescent Y₁ Y₂ W₁ W₂ p₁ p₂ φ_E φ_k hp₁ hp₂ hcomm,
    hTgtOpenProps, hSrcOpenProps, hGeomFibIrred⟩

theorem weil_spread_out_finite_etale_odp_roof_tuple (F : Type u) [Field F]
    (m d_B : ℕ) (i₀ : Fin d_B)
    (Idx : Type) [Finite Idx]
    (L₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F ↥L₀]
    (B₀ Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
    (B_bar Y_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (p_B₀ : B_bar.left ⟶ B₀.left) (p_Y₀ : Y_bar.left ⟶ Y₀.left)
    (g₀ : Y₀ ⟶ B₀) (g_bar : Y_bar ⟶ B_bar)
    [CompactSpace ↥B₀.left] [AlgebraicGeometry.IsSeparated B₀.hom]
    [AlgebraicGeometry.LocallyOfFiniteType B₀.hom]
    [CompactSpace ↥Y₀.left] [AlgebraicGeometry.IsSeparated Y₀.hom]
    [AlgebraicGeometry.LocallyOfFiniteType Y₀.hom]
    (hpB₀ : IsFieldPullbackModel ↥L₀ (AlgebraicClosure F) B₀ B_bar p_B₀)
    (hpY₀ : IsFieldPullbackModel ↥L₀ (AlgebraicClosure F) Y₀ Y_bar p_Y₀)
    (hg₀ : p_Y₀ ≫ g₀.left = g_bar.left ≫ p_B₀)
    (R'_k B'_k : Idx → CommRingCat.{u})
    (h_k : ∀ α : Idx, R'_k α)
    (ψ_Bk : ∀ α : Idx, MvPolynomial (Fin d_B) (AlgebraicClosure F) →+* R'_k α)
    (e_Bk : ∀ α : Idx, AlgebraicGeometry.Spec (R'_k α) ⟶ B_bar.left)
    (e_Yk : ∀ α : Idx, AlgebraicGeometry.Spec (B'_k α) ⟶ Y_bar.left)
    (q_k : ∀ α : Idx, AlgebraicGeometry.Spec (B'_k α) ⟶ weilOdpModelSpec m (R'_k α) (h_k α))
    (hRoof_k : ∀ α : Idx,
      AlgebraicGeometry.Etale (e_Bk α) ∧
      AlgebraicGeometry.Etale (e_Yk α) ∧
      AlgebraicGeometry.Etale (q_k α) ∧
      ψ_Bk α (MvPolynomial.X i₀) = h_k α ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Bk α))) ∧
      (e_Bk α ≫ B_bar.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Bk α)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
      (e_Yk α ≫ g_bar.left =
        q_k α ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_Bk α)) :
    ∃ (L₁ : IntermediateField F (AlgebraicClosure F))
      (hLE : L₀ ≤ L₁)
      (_ : FiniteDimensional F ↥L₁),
      ∀ (L : IntermediateField F (AlgebraicClosure F)) (hL : L₁ ≤ L),
        letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion (hLE.trans hL)).toRingHom.toAlgebra
        ∀ (B_L Y_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L)))
          (g_L : Y_L ⟶ B_L)
          (q_B : B_L.left ⟶ B₀.left) (q_Y : Y_L.left ⟶ Y₀.left)
          (p_BL : B_bar.left ⟶ B_L.left) (p_YL : Y_bar.left ⟶ Y_L.left),
          IsFieldPullbackModel ↥L₀ ↥L B₀ B_L q_B →
          IsFieldPullbackModel ↥L₀ ↥L Y₀ Y_L q_Y →
          q_Y ≫ g₀.left = g_L.left ≫ q_B →
          IsFieldPullbackModel ↥L (AlgebraicClosure F) B_L B_bar p_BL →
          IsFieldPullbackModel ↥L (AlgebraicClosure F) Y_L Y_bar p_YL →
          p_BL ≫ q_B = p_B₀ →
          p_YL ≫ q_Y = p_Y₀ →
          ∃ (R'_L B'_L : Idx → CommRingCat.{u})
            (h_L : ∀ α : Idx, R'_L α)
            (ψ_BL : ∀ α : Idx, MvPolynomial (Fin d_B) ↥L →+* R'_L α)
            (e_BL : ∀ α : Idx, AlgebraicGeometry.Spec (R'_L α) ⟶ B_L.left)
            (e_YL : ∀ α : Idx, AlgebraicGeometry.Spec (B'_L α) ⟶ Y_L.left)
            (q_L : ∀ α : Idx, AlgebraicGeometry.Spec (B'_L α) ⟶ weilOdpModelSpec m (R'_L α) (h_L α))
            (ι_R : ∀ α : Idx, R'_L α →+* R'_k α)
            (ι_B : ∀ α : Idx, B'_L α →+* B'_k α),
            ∀ α : Idx,
              let p_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_R α))
              let p_B := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B α))
              AlgebraicGeometry.Etale (e_BL α) ∧
              AlgebraicGeometry.Etale (e_YL α) ∧
              AlgebraicGeometry.Etale (q_L α) ∧
              ψ_BL α (MvPolynomial.X i₀) = h_L α ∧
              AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_BL α))) ∧
              (e_BL α ≫ B_L.hom =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_BL α)) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
              (e_YL α ≫ g_L.left =
                q_L α ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_BL α) ∧
              Function.Surjective p_R.base ∧
              p_R ≫ e_BL α = e_Bk α ≫ p_BL ∧
              p_B ≫ e_YL α = e_Yk α ≫ p_YL ∧
              (∀ u_bar : AlgebraicGeometry.Spec (R'_k α),
                h_k α ∈ u_bar.asIdeal ↔ h_L α ∈ (p_R.base u_bar).asIdeal) ∧
              (∀ v_bar : AlgebraicGeometry.Spec (B'_k α),
                ((∀ idx : Fin (m + 1) × Fin 2,
                    Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ ((q_k α).base v_bar).asIdeal) →
                  (∀ idx : Fin (m + 1) × Fin 2,
                    Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈
                      ((q_L α).base (p_B.base v_bar)).asIdeal)) ∧
                (Ideal.Quotient.mk _ (MvPolynomial.C (h_k α)) ∈ ((q_k α).base v_bar).asIdeal →
                  Ideal.Quotient.mk _ (MvPolynomial.C (h_L α)) ∈
                    ((q_L α).base (p_B.base v_bar)).asIdeal)) :=
by
  classical
  let k : Type u := AlgebraicClosure F
  let weilOdpModelRing : ∀ (R' : CommRingCat.{u}) (h : R'), Type u :=
    fun R' h => MvPolynomial (Fin (m + 1) × Fin 2) R' ⧸ Ideal.span
      {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C h}

  
  have s2a_pushout_mvPoly : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (φ : A →+* B) (σ : Type),
      CategoryTheory.IsPushout
        (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (MvPolynomial.C : A →+* MvPolynomial σ A))
        (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial σ B))
        (CommRingCat.ofHom (MvPolynomial.map φ : MvPolynomial σ A →+* MvPolynomial σ B)) := by
    intro A B _ _ φ σ
    have hcomm :
        CommRingCat.ofHom φ ≫ CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial σ B) =
          CommRingCat.ofHom (MvPolynomial.C : A →+* MvPolynomial σ A) ≫
            CommRingCat.ofHom (MvPolynomial.map φ) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      ext a
      simp
    let t := CategoryTheory.Limits.PushoutCocone.mk
      (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial σ B))
      (CommRingCat.ofHom (MvPolynomial.map φ)) hcomm
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.isColimitAux t
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inl.hom (fun j => s.inr.hom (MvPolynomial.X j))))
        ?_ ?_ ?_)
    · intro s
      change CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom _ = s.inl
      rw [← CommRingCat.ofHom_comp]
      apply CommRingCat.hom_ext
      ext b
      simp
    · intro s
      change CommRingCat.ofHom (MvPolynomial.map φ) ≫ CommRingCat.ofHom _ = s.inr
      rw [← CommRingCat.ofHom_comp]
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply MvPolynomial.ringHom_ext
      · intro a
        have ha := congrArg (fun fn => fn.hom a) s.condition
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at ha
        simp only [RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        exact ha
      · intro j
        simp
    · intro s m_hom hm
      let m' : CommRingCat.of (MvPolynomial σ B) ⟶ s.pt := m_hom
      have hl : CommRingCat.ofHom MvPolynomial.C ≫ m' = s.inl :=
        hm CategoryTheory.Limits.WalkingSpan.left
      have hr : CommRingCat.ofHom (MvPolynomial.map φ) ≫ m' = s.inr :=
        hm CategoryTheory.Limits.WalkingSpan.right
      change m' = CommRingCat.ofHom _
      apply CommRingCat.hom_ext
      change m'.hom = MvPolynomial.eval₂Hom s.inl.hom (fun j => s.inr.hom (MvPolynomial.X j))
      apply MvPolynomial.ringHom_ext
      · intro b
        have hb : m'.hom (MvPolynomial.C b) = s.inl.hom b :=
          congrArg (fun fn => fn.hom b) hl
        simp only [MvPolynomial.eval₂Hom_C]
        exact hb
      · intro j
        have hj : m'.hom (MvPolynomial.map φ (MvPolynomial.X j)) =
            s.inr.hom (MvPolynomial.X j) :=
          congrArg (fun fn => fn.hom (MvPolynomial.X j)) hr
        rw [MvPolynomial.map_X] at hj
        simp only [MvPolynomial.eval₂Hom_X']
        exact hj

  
  have s2b_pushout_surj_mvPoly :
      ∀ {A B R_A R_B : Type u} [CommRing A] [CommRing B] [CommRing R_A] [CommRing R_B]
        (φ : A →+* B) (σ : Type)
        (mk_A : MvPolynomial σ A →+* R_A)
        (mk_B : MvPolynomial σ B →+* R_B)
        (c_A : A →+* R_A) (c_B : B →+* R_B)
        (ψ : R_A →+* R_B),
        Function.Surjective mk_A →
        Function.Surjective mk_B →
        mk_A.comp MvPolynomial.C = c_A →
        mk_B.comp MvPolynomial.C = c_B →
        ψ.comp mk_A = mk_B.comp (MvPolynomial.map φ) →
        RingHom.ker mk_B ≤ Ideal.span ((MvPolynomial.map φ) '' (RingHom.ker mk_A : Set _)) →
        CategoryTheory.IsPushout
          (CommRingCat.ofHom φ)
          (CommRingCat.ofHom c_A)
          (CommRingCat.ofHom c_B)
          (CommRingCat.ofHom ψ) := by
    intro A B R_A R_B _ _ _ _ φ σ mk_A mk_B c_A c_B ψ
      hSurj_A hSurj_B hc_A hc_B hψ_mk hKer_B
    have hcomm :
        CommRingCat.ofHom φ ≫ CommRingCat.ofHom c_B =
          CommRingCat.ofHom c_A ≫ CommRingCat.ofHom ψ := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      rw [← hc_A, ← hc_B, ← RingHom.comp_assoc, hψ_mk, RingHom.comp_assoc]
      apply RingHom.ext
      intro a
      simp
    let t := CategoryTheory.Limits.PushoutCocone.mk
      (CommRingCat.ofHom c_B) (CommRingCat.ofHom ψ) hcomm
    let w_poly : ∀ s : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom φ) (CommRingCat.ofHom c_A), MvPolynomial σ B →+* ↥s.pt :=
      fun s => MvPolynomial.eval₂Hom s.inl.hom (fun j => s.inr.hom (mk_A (MvPolynomial.X j)))
    have hw_map : ∀ s, (w_poly s).comp (MvPolynomial.map φ) = s.inr.hom.comp mk_A := by
      intro s
      apply MvPolynomial.ringHom_ext
      · intro a
        have ha := congrArg (fun fn => fn.hom a) s.condition
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, ← hc_A] at ha
        simp only [RingHom.comp_apply, MvPolynomial.map_C, w_poly, MvPolynomial.eval₂Hom_C]
        exact ha
      · intro j
        simp [w_poly]
    have hw_ker : ∀ s, ∀ q ∈ RingHom.ker mk_B, w_poly s q = 0 := by
      intro s
      have h_le : RingHom.ker mk_B ≤ RingHom.ker (w_poly s) := by
        refine hKer_B.trans (Ideal.span_le.mpr ?_)
        rintro _ ⟨p, hp, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        have hp_eq := RingHom.congr_fun (hw_map s) p
        simp only [RingHom.comp_apply] at hp_eq
        have hp0 : mk_A p = 0 := hp
        rw [hp_eq, hp0, map_zero]
      intro q hq
      exact RingHom.mem_ker.mp (h_le hq)
    let e_quot := RingHom.quotientKerEquivOfSurjective hSurj_B
    let l_ring : ∀ s : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom φ) (CommRingCat.ofHom c_A), R_B →+* ↥s.pt :=
      fun s => (Ideal.Quotient.lift (RingHom.ker mk_B) (w_poly s) (hw_ker s)).comp
        e_quot.symm.toRingHom
    have hl_mk : ∀ (s : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom φ) (CommRingCat.ofHom c_A)) (q : MvPolynomial σ B),
        l_ring s (mk_B q) = w_poly s q := by
      intro s q
      have he : e_quot.symm (mk_B q) = Ideal.Quotient.mk (RingHom.ker mk_B) q := by
        apply e_quot.injective
        rw [RingEquiv.apply_symm_apply]
        rfl
      change Ideal.Quotient.lift (RingHom.ker mk_B) (w_poly s) (hw_ker s) (e_quot.symm (mk_B q)) =
        w_poly s q
      rw [he, Ideal.Quotient.lift_mk]
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.isColimitAux t
        (fun s => CommRingCat.ofHom (l_ring s)) ?_ ?_ ?_)
    · intro s
      change CommRingCat.ofHom c_B ≫ CommRingCat.ofHom (l_ring s) = s.inl
      rw [← CommRingCat.ofHom_comp]
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply RingHom.ext
      intro b
      change l_ring s (c_B b) = s.inl.hom b
      have hb_c : c_B b = mk_B (MvPolynomial.C b) :=
        (RingHom.congr_fun hc_B b).symm
      rw [hb_c, hl_mk s]
      simp [w_poly]
    · intro s
      change CommRingCat.ofHom ψ ≫ CommRingCat.ofHom (l_ring s) = s.inr
      rw [← CommRingCat.ofHom_comp]
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply RingHom.ext
      intro r_a
      obtain ⟨p, rfl⟩ := hSurj_A r_a
      have hp_ψ := RingHom.congr_fun hψ_mk p
      simp only [RingHom.comp_apply] at hp_ψ ⊢
      rw [hp_ψ, hl_mk s]
      exact RingHom.congr_fun (hw_map s) p
    · intro s m_hom hm
      let m' : CommRingCat.of R_B ⟶ s.pt := m_hom
      have hl : CommRingCat.ofHom c_B ≫ m' = s.inl :=
        hm CategoryTheory.Limits.WalkingSpan.left
      have hr : CommRingCat.ofHom ψ ≫ m' = s.inr :=
        hm CategoryTheory.Limits.WalkingSpan.right
      change m' = CommRingCat.ofHom (l_ring s)
      apply CommRingCat.hom_ext
      ext r_b
      obtain ⟨q, rfl⟩ := hSurj_B r_b
      change m'.hom (mk_B q) = l_ring s (mk_B q)
      rw [hl_mk s]
      change (m'.hom.comp mk_B) q = w_poly s q
      revert q
      rw [← RingHom.ext_iff]
      apply MvPolynomial.ringHom_ext
      · intro b
        have hb : m'.hom (c_B b) = s.inl.hom b :=
          congrArg (fun fn => fn.hom b) hl
        rw [← hc_B, RingHom.comp_apply] at hb
        simp only [RingHom.comp_apply, w_poly, MvPolynomial.eval₂Hom_C]
        exact hb
      · intro j
        have hj : m'.hom (ψ (mk_A (MvPolynomial.X j))) =
            s.inr.hom (mk_A (MvPolynomial.X j)) :=
          congrArg (fun fn => fn.hom (mk_A (MvPolynomial.X j))) hr
        have hX := RingHom.congr_fun hψ_mk (MvPolynomial.X j)
        simp only [RingHom.comp_apply, MvPolynomial.map_X] at hX
        rw [hX] at hj
        simp only [RingHom.comp_apply, w_poly, MvPolynomial.eval₂Hom_X']
        exact hj

  
  have s2c_field_descent : ∀ (E K : Type u) [Field E] [Field K] (α : E →+* K),
      (∀ {X_K X_E : AlgebraicGeometry.Scheme.{u}}
          {s_K : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)}
          {s_E : X_E ⟶ AlgebraicGeometry.Spec (CommRingCat.of E)}
          (f : X_K ⟶ X_E),
        CategoryTheory.IsPullback f s_K s_E
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) →
        Function.Surjective f.base ∧
        CategoryTheory.Epi f ∧
        ∀ {A_top Y_bot : AlgebraicGeometry.Scheme.{u}}
          {fst : A_top ⟶ X_K} {snd : A_top ⟶ Y_bot} {g : Y_bot ⟶ X_E},
          CategoryTheory.IsPullback fst snd f g →
          AlgebraicGeometry.Etale fst →
          AlgebraicGeometry.Etale g) ∧
      (∀ {A_E A_K : CommRingCat.{u}}
          {c_E : CommRingCat.of E ⟶ A_E} {c_K : CommRingCat.of K ⟶ A_K}
          (ι_A : A_E ⟶ A_K),
        CategoryTheory.IsPushout (CommRingCat.ofHom α) c_E c_K ι_A →
        Function.Injective ι_A.hom ∧
        Function.Surjective (AlgebraicGeometry.Spec.map ι_A).base ∧
        CategoryTheory.Epi (AlgebraicGeometry.Spec.map ι_A)) := by
    intro E K _ _ α
    have hPb : ∀ {X_K X_E : AlgebraicGeometry.Scheme.{u}}
        {s_K : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)}
        {s_E : X_E ⟶ AlgebraicGeometry.Spec (CommRingCat.of E)}
        (f : X_K ⟶ X_E),
        CategoryTheory.IsPullback f s_K s_E
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) →
        Function.Surjective f.base ∧
        CategoryTheory.Epi f ∧
        ∀ {A_top Y_bot : AlgebraicGeometry.Scheme.{u}}
          {fst : A_top ⟶ X_K} {snd : A_top ⟶ Y_bot} {g : Y_bot ⟶ X_E},
          CategoryTheory.IsPullback fst snd f g →
          AlgebraicGeometry.Etale fst →
          AlgebraicGeometry.Etale g := by
      intro X_K X_E s_K s_E f hp
      have : AlgebraicGeometry.Surjective f :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp.flip inferInstance
      have : AlgebraicGeometry.Flat f :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp.flip inferInstance
      have : AlgebraicGeometry.QuasiCompact f :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp.flip inferInstance
      refine ⟨f.surjective, AlgebraicGeometry.Flat.epi_of_flat_of_surjective f, ?_⟩
      intro A_top Y_bot fst snd g hSq hEt
      exact CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback
        (P := @AlgebraicGeometry.Etale.{u})
        (Q := @AlgebraicGeometry.Surjective.{u} ⊓ @AlgebraicGeometry.Flat.{u} ⊓
          @AlgebraicGeometry.QuasiCompact.{u})
        hSq ⟨⟨‹_›, ‹_›⟩, ‹_›⟩ hEt
    refine ⟨hPb, ?_⟩
    intro A_E A_K c_E c_K ι_A hPush
    have hp_spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map ι_A)
        (AlgebraicGeometry.Spec.map c_K)
        (AlgebraicGeometry.Spec.map c_E)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush).flip
    obtain ⟨hSurj, hEpi, _⟩ := hPb (AlgebraicGeometry.Spec.map ι_A) hp_spec
    refine ⟨?_, hSurj, hEpi⟩
    let _ : Algebra E K := α.toAlgebra
    let _ : Algebra E ↥A_E := c_E.hom.toAlgebra
    have h_comm_tp : CommRingCat.ofHom α ≫
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := E) (A := K) (B := ↥A_E)) =
        c_E ≫ CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := E) (A := K) (B := ↥A_E)).toRingHom := by
      apply CommRingCat.hom_ext
      ext x
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul x
    have h_inr := hPush.inr_desc
      (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := E) (A := K) (B := ↥A_E)))
      (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := E) (A := K) (B := ↥A_E)).toRingHom)
      h_comm_tp
    let f_lin : E →ₗ[E] K := Algebra.linearMap E K
    have h_rt_inj : Function.Injective (LinearMap.rTensor ↥A_E f_lin) :=
      Module.Flat.rTensor_preserves_injective_linearMap f_lin α.injective
    intro x y hxy
    apply (TensorProduct.lid E ↥A_E).symm.injective
    apply h_rt_inj
    rw [TensorProduct.lid_symm_apply, TensorProduct.lid_symm_apply,
      LinearMap.rTensor_tmul, LinearMap.rTensor_tmul]
    have hf1 : f_lin 1 = (1 : K) := map_one α
    rw [hf1]
    have h1 := congrArg (fun fn => fn.hom x) h_inr
    have h2 := congrArg (fun fn => fn.hom y) h_inr
    dsimp at h1 h2
    change _ = (1 : K) ⊗ₜ[E] x at h1
    change _ = (1 : K) ⊗ₜ[E] y at h2
    rw [← h1, ← h2, hxy]

  
  have s3_alg_spread_out : ∀ (R'_0k B'_0k : CommRingCat.{u})
      (h_0k : R'_0k)
      (ψ_0k : MvPolynomial (Fin d_B) k →+* R'_0k)
      (q_0k : AlgebraicGeometry.Spec B'_0k ⟶ weilOdpModelSpec m R'_0k h_0k),
      ψ_0k (MvPolynomial.X i₀) = h_0k →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0k)) →
      AlgebraicGeometry.Etale q_0k →
      let θ_qk : weilOdpModelRing R'_0k h_0k →+* B'_0k := (AlgebraicGeometry.Spec.preimage q_0k).hom
      ∃ (L_alg : IntermediateField F k)
        (hLE_alg : L₀ ≤ L_alg)
        (_ : FiniteDimensional F ↥L_alg)
        (R'_fam B'_fam : ∀ (E : IntermediateField F k), L_alg ≤ E → CommRingCat.{u})
        (h_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), R'_fam E hE)
        (ψ_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          MvPolynomial (Fin d_B) ↥E →+* R'_fam E hE)
        (θ_q_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          weilOdpModelRing (R'_fam E hE) (h_fam E hE) →+* B'_fam E hE)
        (ι_R_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), R'_fam E hE →+* R'_0k)
        (ι_Q_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          weilOdpModelRing (R'_fam E hE) (h_fam E hE) →+* weilOdpModelRing R'_0k h_0k)
        (ι_B_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), B'_fam E hE →+* B'_0k)
        (τ_R : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂),
          E₁ ≤ E₂ → (R'_fam E₁ h₁ →+* R'_fam E₂ h₂))
        (τ_B : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂),
          E₁ ≤ E₂ → (B'_fam E₁ h₁ →+* B'_fam E₂ h₂)),
        (∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          ψ_fam E hE (MvPolynomial.X i₀) = h_fam E hE ∧ ι_R_fam E hE (h_fam E hE) = h_0k) ∧
        (∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          (ι_R_fam E hE).comp (ψ_fam E hE) = ψ_0k.comp (MvPolynomial.map (algebraMap ↥E k)) ∧
          (ι_Q_fam E hE).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
            ((Ideal.Quotient.mk _).comp MvPolynomial.C).comp (ι_R_fam E hE) ∧
          (ι_B_fam E hE).comp (θ_q_fam E hE) = θ_qk.comp (ι_Q_fam E hE)) ∧
        (∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          (∀ idx : Fin (m + 1) × Fin 2,
            ι_Q_fam E hE (Ideal.Quotient.mk _ (MvPolynomial.X idx)) =
              Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∧
          ι_Q_fam E hE (Ideal.Quotient.mk _ (MvPolynomial.C (h_fam E hE))) =
            Ideal.Quotient.mk _ (MvPolynomial.C h_0k)) ∧
        (∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂) (h₁₂ : E₁ ≤ E₂),
          (ι_R_fam E₂ h₂).comp (τ_R h₁ h₂ h₁₂) = ι_R_fam E₁ h₁ ∧
          (τ_R h₁ h₂ h₁₂).comp ((ψ_fam E₁ h₁).comp MvPolynomial.C) =
            ((ψ_fam E₂ h₂).comp MvPolynomial.C).comp (IntermediateField.inclusion h₁₂).toRingHom ∧
          (ι_B_fam E₂ h₂).comp (τ_B h₁ h₂ h₁₂) = ι_B_fam E₁ h₁ ∧
          (τ_B h₁ h₂ h₁₂).comp
              ((θ_q_fam E₁ h₁).comp (((Ideal.Quotient.mk _).comp MvPolynomial.C).comp
                ((ψ_fam E₁ h₁).comp MvPolynomial.C))) =
            ((θ_q_fam E₂ h₂).comp (((Ideal.Quotient.mk _).comp MvPolynomial.C).comp
                ((ψ_fam E₂ h₂).comp MvPolynomial.C))).comp
              (IntermediateField.inclusion h₁₂).toRingHom) ∧
        (∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          CategoryTheory.IsPushout
            (CommRingCat.ofHom (MvPolynomial.map (algebraMap ↥E k)))
            (CommRingCat.ofHom (ψ_fam E hE))
            (CommRingCat.ofHom ψ_0k)
            (CommRingCat.ofHom (ι_R_fam E hE)) ∧
          CategoryTheory.IsPushout
            (CommRingCat.ofHom (ι_R_fam E hE))
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
            (CommRingCat.ofHom (ι_Q_fam E hE)) ∧
          CategoryTheory.IsPushout
            (CommRingCat.ofHom (ι_Q_fam E hE))
            (CommRingCat.ofHom (θ_q_fam E hE))
            (CommRingCat.ofHom θ_qk)
            (CommRingCat.ofHom (ι_B_fam E hE))) ∧
        (∀ x_bar : R'_0k,
          ∃ (E' : IntermediateField F k) (hE' : L_alg ≤ E') (_ : FiniteDimensional F ↥E')
            (x_E : R'_fam E' hE'),
            ι_R_fam E' hE' x_E = x_bar) ∧
        (∀ y_bar : B'_0k,
          ∃ (E' : IntermediateField F k) (hE' : L_alg ≤ E') (_ : FiniteDimensional F ↥E')
            (y_E : B'_fam E' hE'),
            ι_B_fam E' hE' y_E = y_bar) := by
    intro R'_0k B'_0k h_0k ψ_0k q_0k hψ_X hEt_ψ hEt_q θ_qk
    have : Algebra.IsAlgebraic F k := AlgebraicClosure.isAlgebraic F
    have : Algebra.IsIntegral F k := Algebra.IsAlgebraic.isIntegral
    have hLiftMvPoly : ∀ {A₀ A : Type u} [CommRing A₀] [CommRing A]
        (φ : A₀ →+* A) {σ : Type} (G : MvPolynomial σ A)
        (c₀ : ∀ ν ∈ G.support, A₀),
        (∀ ν (hν : ν ∈ G.support), φ (c₀ ν hν) = G.coeff ν) →
        MvPolynomial.map φ (∑ x ∈ G.support.attach, MvPolynomial.monomial x.1 (c₀ x.1 x.2)) = G := by
      intro A₀ A _ _ φ σ G c₀ hc₀
      rw [map_sum]
      conv_rhs => rw [MvPolynomial.as_sum G, ← Finset.sum_attach G.support]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [MvPolynomial.map_monomial, hc₀ x.1 x.2]

    have hMvQuotPkg : ∀ (A : CommRingCat.{u}) (n : ℕ)
        (I : Ideal (MvPolynomial (Fin n) ↥A)),
        ∃ (Q : CommRingCat.{u})
          (mkQ : MvPolynomial (Fin n) ↥A →+* ↥Q),
          Function.Surjective mkQ ∧
          RingHom.ker mkQ = I ∧
          ∀ {S : Type u} [CommRing S] (f : MvPolynomial (Fin n) ↥A →+* S),
            (∀ p ∈ I, f p = 0) →
            ∃ g : ↥Q →+* S, g.comp mkQ = f := by
      intro A n I
      refine ⟨CommRingCat.of (MvPolynomial (Fin n) ↥A ⧸ I),
        Ideal.Quotient.mk I,
        Ideal.Quotient.mk_surjective,
        ?_, ?_⟩
      · ext p
        exact Ideal.Quotient.eq_zero_iff_mem
      · intro S _ f hf
        exact ⟨Ideal.Quotient.lift I f hf, RingHom.ext fun _ => rfl⟩

    have hExtractFP : ∀ (R A : Type u) [CommRing R] [CommRing A] (φ : R →+* A),
        RingHom.Etale φ →
        ∃ (n : ℕ)
          (mk_A : MvPolynomial (Fin n) R →+* A)
          (F_S : Finset (MvPolynomial (Fin n) R)),
          Function.Surjective mk_A ∧
          mk_A.comp MvPolynomial.C = φ ∧
          Ideal.span (F_S : Set (MvPolynomial (Fin n) R)) = RingHom.ker mk_A := by
      intro R A _ _ φ hEt
      let _ : Algebra R A := φ.toAlgebra
      have : Algebra.Etale R A := hEt.toAlgebra
      have : Algebra.FinitePresentation R A := Algebra.Etale.finitePresentation
      obtain ⟨n, I, e_alg, hI_fg⟩ := (Algebra.FinitePresentation.iff (R := R) (A := A)).mp inferInstance
      obtain ⟨S_set, hS_fin, hS_span⟩ := Submodule.fg_def.mp hI_fg
      let mk_A : MvPolynomial (Fin n) R →+* A :=
        e_alg.toRingEquiv.toRingHom.comp (Ideal.Quotient.mk I)
      have hker : RingHom.ker mk_A = I := by
        ext p
        simp only [RingHom.mem_ker, mk_A, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe]
        exact (map_eq_zero_iff e_alg.toRingEquiv e_alg.injective).trans
          Ideal.Quotient.eq_zero_iff_mem
      refine ⟨n, mk_A, hS_fin.toFinset,
        e_alg.surjective.comp Ideal.Quotient.mk_surjective,
        RingHom.ext fun r => e_alg.commutes r, ?_⟩
      rw [Set.Finite.coe_toFinset, hker]
      exact hS_span

    let P_k := MvPolynomial (Fin d_B) k
    let Q_k := weilOdpModelRing R'_0k h_0k
    have hq_k_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_qk) = q_0k :=
      AlgebraicGeometry.Spec.map_preimage q_0k
    have hREt_ψ : RingHom.Etale ψ_0k :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale.{u})).mp hEt_ψ
    have hREt_θ : RingHom.Etale θ_qk := by
      have hEt_map : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_qk)) := by
        rwa [hq_k_eq]
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale.{u})).mp hEt_map

    obtain ⟨n_R, mk_Rk, F_Rk, hSurj_Rk, hmk_Rk_C, hF_Rk_span⟩ := hExtractFP P_k ↥R'_0k ψ_0k hREt_ψ
    obtain ⟨n_B, mk_Bk, F_Bk, hSurj_Bk, hmk_Bk_C, hF_Bk_span⟩ := hExtractFP Q_k ↥B'_0k θ_qk hREt_θ

    let S₁ : P_k → Finset k := fun p => p.support.image p.coeff
    let S₂ : MvPolynomial (Fin n_R) P_k → Finset k :=
      fun G => G.support.biUnion (fun ν => S₁ (G.coeff ν))
    let G_repr : ↥R'_0k → MvPolynomial (Fin n_R) P_k := fun x => (hSurj_Rk x).choose
    have hG_repr : ∀ x : ↥R'_0k, mk_Rk (G_repr x) = x := fun x => (hSurj_Rk x).choose_spec
    let H_repr : Q_k → MvPolynomial (Fin (m + 1) × Fin 2) ↥R'_0k :=
      fun z => (Ideal.Quotient.mk_surjective z).choose
    have hH_repr : ∀ z : Q_k, Ideal.Quotient.mk _ (H_repr z) = z :=
      fun z => (Ideal.Quotient.mk_surjective z).choose_spec
    let S₃ : Q_k → Finset k :=
      fun z => (H_repr z).support.biUnion (fun μ => S₂ (G_repr ((H_repr z).coeff μ)))
    let S₄ : MvPolynomial (Fin n_B) Q_k → Finset k :=
      fun M => M.support.biUnion (fun ν => S₃ (M.coeff ν))

    let S_alg : Finset k := (F_Rk.biUnion S₂) ∪ (F_Bk.biUnion S₄)
    let L_alg : IntermediateField F k := L₀ ⊔ IntermediateField.adjoin F (S_alg : Set k)
    have hLE_alg : L₀ ≤ L_alg := le_sup_left
    have hFD_alg : FiniteDimensional F ↥L_alg := by
      have : Finite ↥(S_alg : Set k) := S_alg.finite_toSet
      have : FiniteDimensional F ↥(IntermediateField.adjoin F (S_alg : Set k)) :=
        IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
      exact IntermediateField.finiteDimensional_sup L₀ _

    have hLift₁ : ∀ (E : IntermediateField F k) (p : P_k),
        (S₁ p : Set k) ⊆ (E : Set k) →
        ∃ p_E : MvPolynomial (Fin d_B) ↥E, MvPolynomial.map (algebraMap ↥E k) p_E = p := by
      intro E p hp
      let c₀ : ∀ μ ∈ p.support, ↥E :=
        fun μ hμ => ⟨p.coeff μ, hp (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hμ))⟩
      exact ⟨∑ x ∈ p.support.attach, MvPolynomial.monomial x.1 (c₀ x.1 x.2),
        hLiftMvPoly (algebraMap ↥E k) p c₀ (fun _ _ => rfl)⟩

    have hLift₂ : ∀ (E : IntermediateField F k) (G : MvPolynomial (Fin n_R) P_k),
        (S₂ G : Set k) ⊆ (E : Set k) →
        ∃ G_E : MvPolynomial (Fin n_R) (MvPolynomial (Fin d_B) ↥E),
          MvPolynomial.map (MvPolynomial.map (algebraMap ↥E k)) G_E = G := by
      intro E G hG
      have hc : ∀ ν ∈ G.support, ∃ p_E : MvPolynomial (Fin d_B) ↥E,
          MvPolynomial.map (algebraMap ↥E k) p_E = G.coeff ν := by
        intro ν hν
        refine hLift₁ E (G.coeff ν) fun c hc_mem => hG ?_
        exact Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨ν, hν, hc_mem⟩)
      let c₀ : ∀ ν ∈ G.support, MvPolynomial (Fin d_B) ↥E := fun ν hν => (hc ν hν).choose
      exact ⟨∑ x ∈ G.support.attach, MvPolynomial.monomial x.1 (c₀ x.1 x.2),
        hLiftMvPoly (MvPolynomial.map (algebraMap ↥E k)) G c₀ (fun ν hν => (hc ν hν).choose_spec)⟩

    have hSub_Salg : (S_alg : Set k) ⊆ (L_alg : Set k) := by
      have h_adj_le : IntermediateField.adjoin F (S_alg : Set k) ≤ L_alg := le_sup_right
      exact fun x hx => h_adj_le (IntermediateField.subset_adjoin F (S_alg : Set k) hx)

    let P_E : IntermediateField F k → CommRingCat.{u} :=
      fun E => CommRingCat.of (MvPolynomial (Fin d_B) ↥E)
    let map_PE_inc : ∀ {E₁ E₂ : IntermediateField F k}, E₁ ≤ E₂ → (↥(P_E E₁) →+* ↥(P_E E₂)) :=
      fun h₁₂ => MvPolynomial.map (IntermediateField.inclusion h₁₂).toRingHom
    let map_PE_k : ∀ (E : IntermediateField F k), ↥(P_E E) →+* P_k :=
      fun E => MvPolynomial.map (algebraMap ↥E k)

    have hf_R0_ex : ∀ f : ↥F_Rk,
        ∃ f₀ : MvPolynomial (Fin n_R) ↥(P_E L_alg),
          MvPolynomial.map (map_PE_k L_alg) f₀ = f.1 := by
      intro f
      refine hLift₂ L_alg f.1 fun c hc => hSub_Salg ?_
      exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨f.1, f.2, hc⟩))
    choose f_R0 hf_R0 using hf_R0_ex

    let f_RE : ∀ (E : IntermediateField F k) (_ : L_alg ≤ E),
        ↥F_Rk → MvPolynomial (Fin n_R) ↥(P_E E) :=
      fun _ hE f => MvPolynomial.map (map_PE_inc hE) (f_R0 f)
    have hf_RE_map : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E) (f : ↥F_Rk),
        MvPolynomial.map (map_PE_k E) (f_RE E hE f) = f.1 := by
      intro E hE f
      dsimp [f_RE]
      rw [MvPolynomial.map_map]
      have hcomp : (map_PE_k E).comp (map_PE_inc hE) = map_PE_k L_alg :=
        RingHom.ext fun q => MvPolynomial.map_map _ _ q
      rw [hcomp]
      exact hf_R0 f

    let I_RE : ∀ (E : IntermediateField F k) (_ : L_alg ≤ E),
        Ideal (MvPolynomial (Fin n_R) ↥(P_E E)) :=
      fun E hE => Ideal.span (Set.range (f_RE E hE))
    choose R'_fam mk_RE hSurj_mkRE hKer_mkRE hLift_mkRE using
      fun (E : IntermediateField F k) (hE : L_alg ≤ E) => hMvQuotPkg (P_E E) n_R (I_RE E hE)

    have hExt_mkRE : ∀ {E : IntermediateField F k} {hE : L_alg ≤ E}
        {S : Type u} [CommRing S] {g₁ g₂ : ↥(R'_fam E hE) →+* S},
        g₁.comp (mk_RE E hE) = g₂.comp (mk_RE E hE) → g₁ = g₂ := by
      intro E hE S _ g₁ g₂ heq
      apply RingHom.ext
      intro x
      obtain ⟨p, rfl⟩ := hSurj_mkRE E hE x
      exact RingHom.congr_fun heq p

    let ψ_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        MvPolynomial (Fin d_B) ↥E →+* R'_fam E hE :=
      fun E hE => (mk_RE E hE).comp MvPolynomial.C
    let h_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), R'_fam E hE :=
      fun E hE => ψ_fam E hE (MvPolynomial.X i₀)

    have hI_RE_to_k : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), ∀ p ∈ I_RE E hE,
        (mk_Rk.comp (MvPolynomial.map (map_PE_k E))) p = 0 := by
      intro E hE
      have hle : I_RE E hE ≤ Ideal.comap (MvPolynomial.map (map_PE_k E)) (RingHom.ker mk_Rk) := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨f, rfl⟩
        change MvPolynomial.map (map_PE_k E) (f_RE E hE f) ∈ RingHom.ker mk_Rk
        rw [hf_RE_map E hE f, ← hF_Rk_span]
        exact Ideal.subset_span (Finset.mem_coe.mpr f.2)
      intro p hp
      exact hle hp

    choose ι_R_fam hι_R_comp using fun (E : IntermediateField F k) (hE : L_alg ≤ E) =>
      hLift_mkRE E hE (mk_Rk.comp (MvPolynomial.map (map_PE_k E))) (hI_RE_to_k E hE)

    have hι_R_mk : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E)
        (G : MvPolynomial (Fin n_R) ↥(P_E E)),
        ι_R_fam E hE (mk_RE E hE G) = mk_Rk (MvPolynomial.map (map_PE_k E) G) :=
      fun E hE G => RingHom.congr_fun (hι_R_comp E hE) G

    have hι_R_ψ : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        (ι_R_fam E hE).comp (ψ_fam E hE) = ψ_0k.comp (MvPolynomial.map (algebraMap ↥E k)) := by
      intro E hE
      apply RingHom.ext
      intro p
      change ι_R_fam E hE (mk_RE E hE (MvPolynomial.C p)) = ψ_0k (map_PE_k E p)
      rw [hι_R_mk, MvPolynomial.map_C]
      exact RingHom.congr_fun hmk_Rk_C (map_PE_k E p)

    have hι_R_h : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        ι_R_fam E hE (h_fam E hE) = h_0k := by
      intro E hE
      have h1 := RingHom.congr_fun (hι_R_ψ E hE) (MvPolynomial.X i₀)
      simpa [h_fam, hψ_X] using h1

    have hI_RE_trans : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂)
        (h₁₂ : E₁ ≤ E₂) (p : MvPolynomial (Fin n_R) ↥(P_E E₁)),
        p ∈ I_RE E₁ h₁ →
        ((mk_RE E₂ h₂).comp (MvPolynomial.map (map_PE_inc h₁₂))) p = 0 := by
      intro E₁ E₂ h₁ h₂ h₁₂
      have hle : I_RE E₁ h₁ ≤
          Ideal.comap (MvPolynomial.map (map_PE_inc h₁₂)) (RingHom.ker (mk_RE E₂ h₂)) := by
        rw [hKer_mkRE E₂ h₂]
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨f, rfl⟩
        change MvPolynomial.map (map_PE_inc h₁₂) (f_RE E₁ h₁ f) ∈ I_RE E₂ h₂
        have heq : MvPolynomial.map (map_PE_inc h₁₂) (f_RE E₁ h₁ f) = f_RE E₂ h₂ f := by
          dsimp [f_RE]
          rw [MvPolynomial.map_map]
          have hcomp : (map_PE_inc h₁₂).comp (map_PE_inc h₁) = map_PE_inc h₂ :=
            RingHom.ext fun q => MvPolynomial.map_map _ _ q
          rw [hcomp]
        rw [heq]
        exact Ideal.subset_span ⟨f, rfl⟩
      intro p hp
      exact hle hp

    let τ_R : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂),
        E₁ ≤ E₂ → (R'_fam E₁ h₁ →+* R'_fam E₂ h₂) :=
      fun {E₁ E₂} h₁ h₂ h₁₂ =>
        (hLift_mkRE E₁ h₁ ((mk_RE E₂ h₂).comp (MvPolynomial.map (map_PE_inc h₁₂)))
          (hI_RE_trans h₁ h₂ h₁₂)).choose
    have hτ_R_comp : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂)
        (h₁₂ : E₁ ≤ E₂),
        (τ_R h₁ h₂ h₁₂).comp (mk_RE E₁ h₁) =
          (mk_RE E₂ h₂).comp (MvPolynomial.map (map_PE_inc h₁₂)) :=
      fun {E₁ E₂} h₁ h₂ h₁₂ =>
        (hLift_mkRE E₁ h₁ ((mk_RE E₂ h₂).comp (MvPolynomial.map (map_PE_inc h₁₂)))
          (hI_RE_trans h₁ h₂ h₁₂)).choose_spec

    have hτ_R_h : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂) (h₁₂ : E₁ ≤ E₂),
        τ_R h₁ h₂ h₁₂ (h_fam E₁ h₁) = h_fam E₂ h₂ := by
      intro E₁ E₂ h₁ h₂ h₁₂
      have h1 := RingHom.congr_fun (hτ_R_comp h₁ h₂ h₁₂) (MvPolynomial.C (MvPolynomial.X i₀))
      simp only [RingHom.comp_apply, MvPolynomial.map_C] at h1
      change τ_R h₁ h₂ h₁₂ (h_fam E₁ h₁) =
        mk_RE E₂ h₂ (MvPolynomial.C (MvPolynomial.map (IntermediateField.inclusion h₁₂).toRingHom
          (MvPolynomial.X i₀))) at h1
      rw [MvPolynomial.map_X] at h1
      exact h1

    let odpGen : ∀ (R' : CommRingCat.{u}) (h : R'), MvPolynomial (Fin (m + 1) × Fin 2) R' :=
      fun R' h =>
        (∑ j : Fin (m + 1),
          (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R') *
            MvPolynomial.X (j, 1)) - MvPolynomial.C h
    have hodp_map : ∀ {R₁ R₂ : CommRingCat.{u}} {h₁ : R₁} {h₂ : R₂} (φ : R₁ →+* R₂),
        φ h₁ = h₂ → MvPolynomial.map φ (odpGen R₁ h₁) = odpGen R₂ h₂ := by
      intro R₁ R₂ h₁ h₂ φ hφ
      simp [odpGen, hφ]
    have hodp_mem : ∀ {R₁ R₂ : CommRingCat.{u}} {h₁ : R₁} {h₂ : R₂} (φ : R₁ →+* R₂),
        φ h₁ = h₂ →
        ∀ p ∈ Ideal.span {odpGen R₁ h₁}, MvPolynomial.map φ p ∈ Ideal.span {odpGen R₂ h₂} := by
      intro R₁ R₂ h₁ h₂ φ hφ
      have hle : Ideal.span {odpGen R₁ h₁} ≤
          Ideal.comap (MvPolynomial.map φ) (Ideal.span {odpGen R₂ h₂}) := by
        rw [Ideal.span_singleton_le_iff_mem]
        change MvPolynomial.map φ (odpGen R₁ h₁) ∈ Ideal.span {odpGen R₂ h₂}
        rw [hodp_map φ hφ]
        exact Ideal.subset_span rfl
      intro p hp
      exact hle hp

    let ι_Q_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        weilOdpModelRing (R'_fam E hE) (h_fam E hE) →+* Q_k :=
      fun E hE => Ideal.Quotient.lift (Ideal.span {odpGen (R'_fam E hE) (h_fam E hE)})
        ((Ideal.Quotient.mk (Ideal.span {odpGen R'_0k h_0k})).comp (MvPolynomial.map (ι_R_fam E hE)))
        (fun p hp => Ideal.Quotient.eq_zero_iff_mem.mpr (hodp_mem (ι_R_fam E hE) (hι_R_h E hE) p hp))

    let τ_Q : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂),
        E₁ ≤ E₂ →
        (weilOdpModelRing (R'_fam E₁ h₁) (h_fam E₁ h₁) →+*
          weilOdpModelRing (R'_fam E₂ h₂) (h_fam E₂ h₂)) :=
      fun h₁ h₂ h₁₂ => Ideal.Quotient.lift (Ideal.span {odpGen _ (h_fam _ h₁)})
        ((Ideal.Quotient.mk (Ideal.span {odpGen _ (h_fam _ h₂)})).comp
          (MvPolynomial.map (τ_R h₁ h₂ h₁₂)))
        (fun p hp => Ideal.Quotient.eq_zero_iff_mem.mpr (hodp_mem (τ_R h₁ h₂ h₁₂) (hτ_R_h h₁ h₂ h₁₂) p hp))

    have hι_Q_mk : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E)
        (P : MvPolynomial (Fin (m + 1) × Fin 2) (R'_fam E hE)),
        ι_Q_fam E hE (Ideal.Quotient.mk _ P) =
          Ideal.Quotient.mk _ (MvPolynomial.map (ι_R_fam E hE) P) :=
      fun _ _ _ => rfl
    have hτ_Q_mk : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂)
        (h₁₂ : E₁ ≤ E₂) (P : MvPolynomial (Fin (m + 1) × Fin 2) (R'_fam E₁ h₁)),
        τ_Q h₁ h₂ h₁₂ (Ideal.Quotient.mk _ P) =
          Ideal.Quotient.mk _ (MvPolynomial.map (τ_R h₁ h₂ h₁₂) P) :=
      fun _ _ _ _ => rfl

    have hτ_R_ι : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂) (h₁₂ : E₁ ≤ E₂),
        (ι_R_fam E₂ h₂).comp (τ_R h₁ h₂ h₁₂) = ι_R_fam E₁ h₁ := by
      intro E₁ E₂ h₁ h₂ h₁₂
      apply hExt_mkRE
      rw [RingHom.comp_assoc, hτ_R_comp h₁ h₂ h₁₂, ← RingHom.comp_assoc,
        hι_R_comp E₂ h₂, hι_R_comp E₁ h₁]
      apply MvPolynomial.ringHom_ext
      · intro p
        simp only [RingHom.comp_apply, MvPolynomial.map_C]
        have hp_eq : map_PE_k E₂ (map_PE_inc h₁₂ p) = map_PE_k E₁ p := by
          dsimp [map_PE_k, map_PE_inc]
          rw [MvPolynomial.map_map]
          rfl
        rw [hp_eq]
      · intro j; simp

    have hτ_Q_ι : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂) (h₁₂ : E₁ ≤ E₂),
        (ι_Q_fam E₂ h₂).comp (τ_Q h₁ h₂ h₁₂) = ι_Q_fam E₁ h₁ := by
      intro E₁ E₂ h₁ h₂ h₁₂
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        change ι_Q_fam E₂ h₂ (τ_Q h₁ h₂ h₁₂ (Ideal.Quotient.mk _ (MvPolynomial.C r))) =
          ι_Q_fam E₁ h₁ (Ideal.Quotient.mk _ (MvPolynomial.C r))
        rw [hτ_Q_mk, MvPolynomial.map_C, hι_Q_mk E₂ h₂, hι_Q_mk E₁ h₁,
          MvPolynomial.map_C, MvPolynomial.map_C]
        have hr : ι_R_fam E₂ h₂ (τ_R h₁ h₂ h₁₂ r) = ι_R_fam E₁ h₁ r :=
          RingHom.congr_fun (hτ_R_ι h₁ h₂ h₁₂) r
        rw [hr]
      · intro idx
        change ι_Q_fam E₂ h₂ (τ_Q h₁ h₂ h₁₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx))) =
          ι_Q_fam E₁ h₁ (Ideal.Quotient.mk _ (MvPolynomial.X idx))
        rw [hτ_Q_mk, MvPolynomial.map_X, hι_Q_mk E₂ h₂, hι_Q_mk E₁ h₁,
          MvPolynomial.map_X, MvPolynomial.map_X]

    have hτ_Q_trans : ∀ {E₁ E₂ E₃ : IntermediateField F k}
        (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂) (h₃ : L_alg ≤ E₃)
        (h₁₂ : E₁ ≤ E₂) (h₂₃ : E₂ ≤ E₃),
        (τ_Q h₂ h₃ h₂₃).comp (τ_Q h₁ h₂ h₁₂) = τ_Q h₁ h₃ (h₁₂.trans h₂₃) := by
      intro E₁ E₂ E₃ h₁ h₂ h₃ h₁₂ h₂₃
      have hτ_R_tr : (τ_R h₂ h₃ h₂₃).comp (τ_R h₁ h₂ h₁₂) = τ_R h₁ h₃ (h₁₂.trans h₂₃) := by
        apply hExt_mkRE
        rw [RingHom.comp_assoc, hτ_R_comp h₁ h₂ h₁₂, ← RingHom.comp_assoc,
          hτ_R_comp h₂ h₃ h₂₃, hτ_R_comp h₁ h₃ (h₁₂.trans h₂₃)]
        apply MvPolynomial.ringHom_ext
        · intro p
          simp only [RingHom.comp_apply, MvPolynomial.map_C]
          have hp_eq : map_PE_inc h₂₃ (map_PE_inc h₁₂ p) = map_PE_inc (h₁₂.trans h₂₃) p := by
            dsimp [map_PE_inc]
            rw [MvPolynomial.map_map]
            rfl
          rw [hp_eq]
        · intro j; simp
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        change τ_Q h₂ h₃ h₂₃ (τ_Q h₁ h₂ h₁₂ (Ideal.Quotient.mk _ (MvPolynomial.C r))) =
          τ_Q h₁ h₃ (h₁₂.trans h₂₃) (Ideal.Quotient.mk _ (MvPolynomial.C r))
        rw [hτ_Q_mk h₁ h₂ h₁₂, MvPolynomial.map_C, hτ_Q_mk h₂ h₃ h₂₃,
          hτ_Q_mk h₁ h₃ (h₁₂.trans h₂₃), MvPolynomial.map_C, MvPolynomial.map_C]
        have hr : τ_R h₂ h₃ h₂₃ (τ_R h₁ h₂ h₁₂ r) = τ_R h₁ h₃ (h₁₂.trans h₂₃) r :=
          RingHom.congr_fun hτ_R_tr r
        rw [hr]
      · intro idx
        change τ_Q h₂ h₃ h₂₃ (τ_Q h₁ h₂ h₁₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx))) =
          τ_Q h₁ h₃ (h₁₂.trans h₂₃) (Ideal.Quotient.mk _ (MvPolynomial.X idx))
        rw [hτ_Q_mk h₁ h₂ h₁₂, MvPolynomial.map_X, hτ_Q_mk h₂ h₃ h₂₃,
          hτ_Q_mk h₁ h₃ (h₁₂.trans h₂₃), MvPolynomial.map_X, MvPolynomial.map_X]

    have hLift₃ : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E) (z : Q_k),
        (S₃ z : Set k) ⊆ (E : Set k) →
        ∃ z_E : weilOdpModelRing (R'_fam E hE) (h_fam E hE), ι_Q_fam E hE z_E = z := by
      intro E hE z hz
      have hc : ∀ μ ∈ (H_repr z).support,
          ∃ x_E : R'_fam E hE, ι_R_fam E hE x_E = (H_repr z).coeff μ := by
        intro μ hμ
        have hsub : (S₂ (G_repr ((H_repr z).coeff μ)) : Set k) ⊆ (E : Set k) := fun c hc_mem =>
          hz (Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨μ, hμ, hc_mem⟩))
        obtain ⟨G_E, hG_E⟩ := hLift₂ E (G_repr ((H_repr z).coeff μ)) hsub
        refine ⟨mk_RE E hE G_E, ?_⟩
        rw [hι_R_mk, hG_E, hG_repr]
      let c₀ : ∀ μ ∈ (H_repr z).support, R'_fam E hE := fun μ hμ => (hc μ hμ).choose
      let H_E : MvPolynomial (Fin (m + 1) × Fin 2) (R'_fam E hE) :=
        ∑ x ∈ (H_repr z).support.attach, MvPolynomial.monomial x.1 (c₀ x.1 x.2)
      have hHE : MvPolynomial.map (ι_R_fam E hE) H_E = H_repr z :=
        hLiftMvPoly (ι_R_fam E hE) (H_repr z) c₀ (fun μ hμ => (hc μ hμ).choose_spec)
      refine ⟨Ideal.Quotient.mk _ H_E, ?_⟩
      change Ideal.Quotient.mk _ (MvPolynomial.map (ι_R_fam E hE) H_E) = z
      rw [hHE, hH_repr]

    have hLift₄ : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E) (M : MvPolynomial (Fin n_B) Q_k),
        (S₄ M : Set k) ⊆ (E : Set k) →
        ∃ M_E : MvPolynomial (Fin n_B) (weilOdpModelRing (R'_fam E hE) (h_fam E hE)),
          MvPolynomial.map (ι_Q_fam E hE) M_E = M := by
      intro E hE M hM
      have hc : ∀ ν ∈ M.support,
          ∃ z_E : weilOdpModelRing (R'_fam E hE) (h_fam E hE),
            ι_Q_fam E hE z_E = M.coeff ν := by
        intro ν hν
        refine hLift₃ E hE (M.coeff ν) fun c hc_mem => hM ?_
        exact Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨ν, hν, hc_mem⟩)
      let c₀ : ∀ ν ∈ M.support, weilOdpModelRing (R'_fam E hE) (h_fam E hE) :=
        fun ν hν => (hc ν hν).choose
      exact ⟨∑ x ∈ M.support.attach, MvPolynomial.monomial x.1 (c₀ x.1 x.2),
        hLiftMvPoly (ι_Q_fam E hE) M c₀ (fun ν hν => (hc ν hν).choose_spec)⟩

    have hg_Q0_ex : ∀ g : ↥F_Bk,
        ∃ g₀ : MvPolynomial (Fin n_B) (weilOdpModelRing (R'_fam L_alg le_rfl) (h_fam L_alg le_rfl)),
          MvPolynomial.map (ι_Q_fam L_alg le_rfl) g₀ = g.1 := by
      intro g
      refine hLift₄ L_alg le_rfl g.1 fun c hc => hSub_Salg ?_
      exact Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨g.1, g.2, hc⟩))
    choose g_Q0 hg_Q0 using hg_Q0_ex

    let Q_E_cat : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), CommRingCat.{u} :=
      fun E hE => CommRingCat.of (weilOdpModelRing (R'_fam E hE) (h_fam E hE))
    let g_QE : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        ↥F_Bk → MvPolynomial (Fin n_B) ↥(Q_E_cat E hE) :=
      fun _ hE g => MvPolynomial.map (τ_Q le_rfl hE hE) (g_Q0 g)
    have hg_QE_map : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E) (g : ↥F_Bk),
        MvPolynomial.map (ι_Q_fam E hE) (g_QE E hE g) = g.1 := by
      intro E hE g
      dsimp [g_QE]
      rw [MvPolynomial.map_map, hτ_Q_ι le_rfl hE hE]
      exact hg_Q0 g

    let I_BE : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        Ideal (MvPolynomial (Fin n_B) ↥(Q_E_cat E hE)) :=
      fun E hE => Ideal.span (Set.range (g_QE E hE))
    choose B'_fam mk_BE hSurj_mkBE hKer_mkBE hLift_mkBE using
      fun (E : IntermediateField F k) (hE : L_alg ≤ E) => hMvQuotPkg (Q_E_cat E hE) n_B (I_BE E hE)

    have hExt_mkBE : ∀ {E : IntermediateField F k} {hE : L_alg ≤ E}
        {S : Type u} [CommRing S] {g₁ g₂ : ↥(B'_fam E hE) →+* S},
        g₁.comp (mk_BE E hE) = g₂.comp (mk_BE E hE) → g₁ = g₂ := by
      intro E hE S _ g₁ g₂ heq
      apply RingHom.ext
      intro y
      obtain ⟨p, rfl⟩ := hSurj_mkBE E hE y
      exact RingHom.congr_fun heq p

    let θ_q_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        weilOdpModelRing (R'_fam E hE) (h_fam E hE) →+* B'_fam E hE :=
      fun E hE => (mk_BE E hE).comp MvPolynomial.C

    have hI_BE_to_k : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), ∀ p ∈ I_BE E hE,
        (mk_Bk.comp (MvPolynomial.map (ι_Q_fam E hE))) p = 0 := by
      intro E hE
      have hle : I_BE E hE ≤ Ideal.comap (MvPolynomial.map (ι_Q_fam E hE)) (RingHom.ker mk_Bk) := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨g, rfl⟩
        change MvPolynomial.map (ι_Q_fam E hE) (g_QE E hE g) ∈ RingHom.ker mk_Bk
        rw [hg_QE_map E hE g, ← hF_Bk_span]
        exact Ideal.subset_span (Finset.mem_coe.mpr g.2)
      intro p hp
      exact hle hp

    choose ι_B_fam hι_B_comp using fun (E : IntermediateField F k) (hE : L_alg ≤ E) =>
      hLift_mkBE E hE (mk_Bk.comp (MvPolynomial.map (ι_Q_fam E hE))) (hI_BE_to_k E hE)

    have hι_B_mk : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E)
        (M : MvPolynomial (Fin n_B) ↥(Q_E_cat E hE)),
        ι_B_fam E hE (mk_BE E hE M) = mk_Bk (MvPolynomial.map (ι_Q_fam E hE) M) :=
      fun E hE M => RingHom.congr_fun (hι_B_comp E hE) M

    have hI_BE_trans : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂)
        (h₁₂ : E₁ ≤ E₂) (p : MvPolynomial (Fin n_B) ↥(Q_E_cat E₁ h₁)),
        p ∈ I_BE E₁ h₁ →
        ((mk_BE E₂ h₂).comp (MvPolynomial.map (τ_Q h₁ h₂ h₁₂))) p = 0 := by
      intro E₁ E₂ h₁ h₂ h₁₂
      have hle : I_BE E₁ h₁ ≤ Ideal.comap (MvPolynomial.map (τ_Q h₁ h₂ h₁₂)) (RingHom.ker (mk_BE E₂ h₂)) := by
        rw [hKer_mkBE E₂ h₂]
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨g, rfl⟩
        change MvPolynomial.map (τ_Q h₁ h₂ h₁₂) (g_QE E₁ h₁ g) ∈ I_BE E₂ h₂
        have heq : MvPolynomial.map (τ_Q h₁ h₂ h₁₂) (g_QE E₁ h₁ g) = g_QE E₂ h₂ g := by
          dsimp [g_QE]
          rw [MvPolynomial.map_map, hτ_Q_trans le_rfl h₁ h₂ h₁ h₁₂]
        rw [heq]
        exact Ideal.subset_span ⟨g, rfl⟩
      intro p hp
      exact hle hp

    let τ_B : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂),
        E₁ ≤ E₂ → (B'_fam E₁ h₁ →+* B'_fam E₂ h₂) :=
      fun {E₁ E₂} h₁ h₂ h₁₂ =>
        (hLift_mkBE E₁ h₁ ((mk_BE E₂ h₂).comp (MvPolynomial.map (τ_Q h₁ h₂ h₁₂)))
          (hI_BE_trans h₁ h₂ h₁₂)).choose
    have hτ_B_comp : ∀ {E₁ E₂ : IntermediateField F k} (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂)
        (h₁₂ : E₁ ≤ E₂),
        (τ_B h₁ h₂ h₁₂).comp (mk_BE E₁ h₁) =
          (mk_BE E₂ h₂).comp (MvPolynomial.map (τ_Q h₁ h₂ h₁₂)) :=
      fun {E₁ E₂} h₁ h₂ h₁₂ =>
        (hLift_mkBE E₁ h₁ ((mk_BE E₂ h₂).comp (MvPolynomial.map (τ_Q h₁ h₂ h₁₂)))
          (hI_BE_trans h₁ h₂ h₁₂)).choose_spec

    refine ⟨L_alg, hLE_alg, hFD_alg, R'_fam, B'_fam, h_fam, ψ_fam, θ_q_fam,
      ι_R_fam, ι_Q_fam, ι_B_fam, @τ_R, @τ_B, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro E hE
      exact ⟨rfl, hι_R_h E hE⟩
    · intro E hE
      refine ⟨hι_R_ψ E hE, ?_, ?_⟩
      · apply RingHom.ext
        intro r
        change ι_Q_fam E hE (Ideal.Quotient.mk _ (MvPolynomial.C r)) =
          Ideal.Quotient.mk _ (MvPolynomial.C (ι_R_fam E hE r))
        rw [hι_Q_mk, MvPolynomial.map_C]
      · apply RingHom.ext; intro z
        change ι_B_fam E hE (mk_BE E hE (MvPolynomial.C z)) = θ_qk (ι_Q_fam E hE z)
        rw [hι_B_mk, MvPolynomial.map_C]
        exact RingHom.congr_fun hmk_Bk_C (ι_Q_fam E hE z)
    · intro E hE
      refine ⟨fun idx => ?_, ?_⟩
      · rw [hι_Q_mk, MvPolynomial.map_X]
      · rw [hι_Q_mk, MvPolynomial.map_C, hι_R_h E hE]
    · intro E₁ E₂ h₁ h₂ h₁₂
      have hcR_eq : ∀ c : ↥E₁,
          τ_R h₁ h₂ h₁₂ (ψ_fam E₁ h₁ (MvPolynomial.C c)) =
            ψ_fam E₂ h₂ (MvPolynomial.C ((IntermediateField.inclusion h₁₂).toRingHom c)) := by
        intro c
        have hc := RingHom.congr_fun (hτ_R_comp h₁ h₂ h₁₂) (MvPolynomial.C (MvPolynomial.C c))
        change τ_R h₁ h₂ h₁₂ (ψ_fam E₁ h₁ (MvPolynomial.C c)) =
          mk_RE E₂ h₂ ((MvPolynomial.map (map_PE_inc h₁₂)) (MvPolynomial.C (MvPolynomial.C c))) at hc
        rw [MvPolynomial.map_C] at hc
        change τ_R h₁ h₂ h₁₂ (ψ_fam E₁ h₁ (MvPolynomial.C c)) =
          mk_RE E₂ h₂ (MvPolynomial.C
            (MvPolynomial.map (IntermediateField.inclusion h₁₂).toRingHom (MvPolynomial.C c))) at hc
        rw [MvPolynomial.map_C] at hc
        exact hc
      refine ⟨hτ_R_ι h₁ h₂ h₁₂, ?_, ?_, ?_⟩
      · apply RingHom.ext
        exact hcR_eq
      · apply hExt_mkBE
        rw [RingHom.comp_assoc, hτ_B_comp h₁ h₂ h₁₂, ← RingHom.comp_assoc,
          hι_B_comp E₂ h₂, hι_B_comp E₁ h₁]
        apply MvPolynomial.ringHom_ext
        · intro z
          have hz := RingHom.congr_fun (hτ_Q_ι h₁ h₂ h₁₂) z
          simpa using congrArg (fun w => mk_Bk (MvPolynomial.C w)) hz
        · intro ν; simp
      · apply RingHom.ext
        intro c
        have hcB := RingHom.congr_fun (hτ_B_comp h₁ h₂ h₁₂)
          (MvPolynomial.C (Ideal.Quotient.mk _ (MvPolynomial.C (ψ_fam E₁ h₁ (MvPolynomial.C c)))))
        change τ_B h₁ h₂ h₁₂ (θ_q_fam E₁ h₁
            (Ideal.Quotient.mk _ (MvPolynomial.C (ψ_fam E₁ h₁ (MvPolynomial.C c))))) =
          mk_BE E₂ h₂ ((MvPolynomial.map (τ_Q h₁ h₂ h₁₂))
            (MvPolynomial.C (Ideal.Quotient.mk _ (MvPolynomial.C (ψ_fam E₁ h₁ (MvPolynomial.C c)))))) at hcB
        rw [MvPolynomial.map_C, hτ_Q_mk, MvPolynomial.map_C, hcR_eq c] at hcB
        exact hcB
    · intro E hE
      refine ⟨?_, ?_, ?_⟩
      · have hKer_R : RingHom.ker mk_Rk ≤
            Ideal.span ((MvPolynomial.map (map_PE_k E)) '' (RingHom.ker (mk_RE E hE) : Set _)) := by
          rw [← hF_Rk_span, hKer_mkRE E hE]
          refine Ideal.span_mono ?_
          intro f hf
          exact ⟨f_RE E hE ⟨f, Finset.mem_coe.mp hf⟩, Ideal.subset_span ⟨⟨f, Finset.mem_coe.mp hf⟩, rfl⟩,
            hf_RE_map E hE ⟨f, Finset.mem_coe.mp hf⟩⟩
        exact s2b_pushout_surj_mvPoly (map_PE_k E) (Fin n_R) (mk_RE E hE) mk_Rk
          (ψ_fam E hE) ψ_0k (ι_R_fam E hE)
          (hSurj_mkRE E hE) hSurj_Rk rfl hmk_Rk_C (hι_R_comp E hE) hKer_R
      · let mk_QE := Ideal.Quotient.mk (Ideal.span {odpGen (R'_fam E hE) (h_fam E hE)})
        let mk_Qk := Ideal.Quotient.mk (Ideal.span {odpGen R'_0k h_0k})
        have hKer_QE : RingHom.ker mk_QE = Ideal.span {odpGen (R'_fam E hE) (h_fam E hE)} := by
          ext p; exact Ideal.Quotient.eq_zero_iff_mem
        have hKer_Qk : RingHom.ker mk_Qk = Ideal.span {odpGen R'_0k h_0k} := by
          ext p; exact Ideal.Quotient.eq_zero_iff_mem
        have hKer_Q : RingHom.ker mk_Qk ≤
            Ideal.span ((MvPolynomial.map (ι_R_fam E hE)) '' (RingHom.ker mk_QE : Set _)) := by
          rw [hKer_QE, hKer_Qk]
          refine Ideal.span_mono ?_
          rintro _ rfl
          exact ⟨odpGen (R'_fam E hE) (h_fam E hE), Ideal.subset_span rfl,
            hodp_map (ι_R_fam E hE) (hι_R_h E hE)⟩
        exact s2b_pushout_surj_mvPoly (ι_R_fam E hE) (Fin (m + 1) × Fin 2) mk_QE mk_Qk
          ((Ideal.Quotient.mk _).comp MvPolynomial.C)
          ((Ideal.Quotient.mk _).comp MvPolynomial.C)
          (ι_Q_fam E hE)
          Ideal.Quotient.mk_surjective Ideal.Quotient.mk_surjective
          rfl rfl (RingHom.ext fun _ => rfl) hKer_Q
      · have hKer_B : RingHom.ker mk_Bk ≤
            Ideal.span ((MvPolynomial.map (ι_Q_fam E hE)) '' (RingHom.ker (mk_BE E hE) : Set _)) := by
          rw [← hF_Bk_span, hKer_mkBE E hE]
          refine Ideal.span_mono ?_
          intro g hg
          exact ⟨g_QE E hE ⟨g, Finset.mem_coe.mp hg⟩, Ideal.subset_span ⟨⟨g, Finset.mem_coe.mp hg⟩, rfl⟩,
            hg_QE_map E hE ⟨g, Finset.mem_coe.mp hg⟩⟩
        exact s2b_pushout_surj_mvPoly (ι_Q_fam E hE) (Fin n_B) (mk_BE E hE) mk_Bk
          (θ_q_fam E hE) θ_qk (ι_B_fam E hE)
          (hSurj_mkBE E hE) hSurj_Bk rfl hmk_Bk_C (hι_B_comp E hE) hKer_B
    · intro x_bar
      let S_x := S₂ (G_repr x_bar)
      let E' : IntermediateField F k := L_alg ⊔ IntermediateField.adjoin F (S_x : Set k)
      have hE' : L_alg ≤ E' := le_sup_left
      have hFD' : FiniteDimensional F ↥E' := by
        have : Finite ↥(S_x : Set k) := S_x.finite_toSet
        have : FiniteDimensional F ↥(IntermediateField.adjoin F (S_x : Set k)) :=
          IntermediateField.finiteDimensional_adjoin fun c _ => Algebra.IsIntegral.isIntegral c
        exact IntermediateField.finiteDimensional_sup L_alg _
      have hsub : (S_x : Set k) ⊆ (E' : Set k) := by
        have h_adj_le : IntermediateField.adjoin F (S_x : Set k) ≤ E' := le_sup_right
        exact fun c hc => h_adj_le (IntermediateField.subset_adjoin F (S_x : Set k) hc)
      obtain ⟨G_E, hG_E⟩ := hLift₂ E' (G_repr x_bar) hsub
      refine ⟨E', hE', hFD', mk_RE E' hE' G_E, ?_⟩
      rw [hι_R_mk, hG_E, hG_repr]
    · intro y_bar
      obtain ⟨M_y, hM_y⟩ := hSurj_Bk y_bar
      let S_y := S₄ M_y
      let E' : IntermediateField F k := L_alg ⊔ IntermediateField.adjoin F (S_y : Set k)
      have hE' : L_alg ≤ E' := le_sup_left
      have hFD' : FiniteDimensional F ↥E' := by
        have : Finite ↥(S_y : Set k) := S_y.finite_toSet
        have : FiniteDimensional F ↥(IntermediateField.adjoin F (S_y : Set k)) :=
          IntermediateField.finiteDimensional_adjoin fun c _ => Algebra.IsIntegral.isIntegral c
        exact IntermediateField.finiteDimensional_sup L_alg _
      have hsub : (S_y : Set k) ⊆ (E' : Set k) := by
        have h_adj_le : IntermediateField.adjoin F (S_y : Set k) ≤ E' := le_sup_right
        exact fun c hc => h_adj_le (IntermediateField.subset_adjoin F (S_y : Set k) hc)
      obtain ⟨M_E, hM_E⟩ := hLift₄ E' hE' M_y hsub
      refine ⟨E', hE', hFD', mk_BE E' hE' M_E, ?_⟩
      rw [hι_B_mk, hM_E, hM_y]

  
  have s4_spread_out_spec_colimit_morphism :
      ∀ (L_alg : IntermediateField F k)
        (hLE₀ : L₀ ≤ L_alg)
        [FiniteDimensional F ↥L_alg]
        (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
        (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (p_Z₀ : Z_bar.left ⟶ Z₀.left)
        [CompactSpace ↥Z₀.left] [AlgebraicGeometry.IsSeparated Z₀.hom]
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
        (_hpZ₀ : IsFieldPullbackModel ↥L₀ k Z₀ Z_bar p_Z₀)
        (A_k : CommRingCat.{u})
        (ρ_k : k →+* A_k)
        (A_fam : ∀ (E : IntermediateField F k), L_alg ≤ E → CommRingCat.{u})
        (ρ_fam : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), ↥E →+* A_fam E hE)
        (ι_A : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), A_fam E hE →+* A_k)
        (τ_A : ∀ {E₁ E₂ : IntermediateField F k}
          (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂), E₁ ≤ E₂ → (A_fam E₁ h₁ →+* A_fam E₂ h₂))
        (_hρ_ι : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          (ι_A E hE).comp (ρ_fam E hE) = ρ_k.comp (algebraMap ↥E k))
        (_hτ_ι : ∀ {E₁ E₂ : IntermediateField F k}
          (h₁ : L_alg ≤ E₁) (h₂ : L_alg ≤ E₂) (h₁₂ : E₁ ≤ E₂),
          (ι_A E₂ h₂).comp (τ_A h₁ h₂ h₁₂) = ι_A E₁ h₁)
        (_hInj_A : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          Function.Injective (ι_A E hE))
        (_hPush_A : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
          CategoryTheory.IsPushout
            (CommRingCat.ofHom (algebraMap ↥E k))
            (CommRingCat.ofHom (ρ_fam E hE))
            (CommRingCat.ofHom ρ_k)
            (CommRingCat.ofHom (ι_A E hE)))
        (_hExhaust_A : ∀ x_bar : A_k,
          ∃ (E' : IntermediateField F k)
            (hE' : L_alg ≤ E') (_ : FiniteDimensional F ↥E')
            (x_E : A_fam E' hE'),
            ι_A E' hE' x_E = x_bar)
        (e_k : AlgebraicGeometry.Spec A_k ⟶ Z_bar.left)
        (_he_k_hom : e_k ≫ Z_bar.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_k)),
        ∃ (L₁ : IntermediateField F k)
          (hLE₁ : L_alg ≤ L₁)
          (_ : FiniteDimensional F ↥L₁),
          ∀ (L : IntermediateField F k) (hL : L₁ ≤ L),
            let hL_alg : L_alg ≤ L := hLE₁.trans hL
            letI : Algebra ↥L₀ ↥L :=
              (IntermediateField.inclusion (hLE₀.trans hL_alg)).toRingHom.toAlgebra
            ∀ (Z_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L)))
              (q_Z : Z_L.left ⟶ Z₀.left)
              (p_ZL : Z_bar.left ⟶ Z_L.left),
              IsFieldPullbackModel ↥L₀ ↥L Z₀ Z_L q_Z →
              IsFieldPullbackModel ↥L k Z_L Z_bar p_ZL →
              p_ZL ≫ q_Z = p_Z₀ →
              ∃ (e_L : AlgebraicGeometry.Spec (A_fam L hL_alg) ⟶ Z_L.left),
                e_L ≫ Z_L.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ_fam L hL_alg)) ∧
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_A L hL_alg)) ≫ e_L = e_k ≫ p_ZL := by
    intro L_alg hLE₀ _ Z₀ Z_bar p_Z₀ _ _ _ hpZ₀ A_k ρ_k A_fam ρ_fam ι_A τ_A
      hρ_ι hτ_ι hInj_A hPush_A hExhaust_A e_k he_k_hom

    have hPullOpen :
        ∀ (B₀ E R : Type u) [CommRing B₀] [CommRing E] [CommRing R]
          [Algebra B₀ E] [Algebra B₀ R]
          (Z Z_E : AlgebraicGeometry.Scheme.{u})
          (g : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
          (g_E : Z_E ⟶ AlgebraicGeometry.Spec (CommRingCat.of E))
          (q_E : Z_E ⟶ Z)
          (_hqE : CategoryTheory.IsPullback q_E g_E g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))))
          (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Z)
          [AlgebraicGeometry.IsOpenImmersion ι₀]
          (_hι₀ : ι₀ ≫ g = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R))),
          ∃ (ι_E : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ E R)) ⟶ Z_E)
            (hOpenE : AlgebraicGeometry.IsOpenImmersion ι_E),
            @AlgebraicGeometry.Scheme.Hom.opensRange _ _ ι_E hOpenE =
              (TopologicalSpace.Opens.map q_E.base).obj ι₀.opensRange ∧
            ι_E ≫ q_E =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom) ≫
                ι₀ ∧
            ι_E ≫ g_E =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := E) (B := R))) := by
      intro B₀ E R _ _ _ _ _ Z Z_E g g_E q_E hqE ι₀ _ hι₀
      let U : Z.Opens := ι₀.opensRange
      let U_E : Z_E.Opens := (TopologicalSpace.Opens.map q_E.base).obj U
      let e₀ : AlgebraicGeometry.Spec (CommRingCat.of R) ≅ (U : AlgebraicGeometry.Scheme.{u}) :=
        ι₀.isoOpensRange
      have he₀ : e₀.hom ≫ U.ι = ι₀ := ι₀.isoOpensRange_hom_ι
      have hp_res : CategoryTheory.IsPullback (q_E ∣_ U) U_E.ι U.ι q_E :=
        AlgebraicGeometry.isPullback_morphismRestrict q_E U
      have hp_vert : CategoryTheory.IsPullback (q_E ∣_ U) (U_E.ι ≫ g_E) (U.ι ≫ g)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))) :=
        hp_res.paste_vert hqE
      have hp_e₀ : CategoryTheory.IsPullback e₀.inv (U.ι ≫ g)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R))) (𝟙 _) := by
        refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
        rw [CategoryTheory.Category.comp_id]
        exact (CategoryTheory.Iso.inv_comp_eq e₀).mpr (by rw [← CategoryTheory.Category.assoc, he₀, hι₀])
      have hp_geom : CategoryTheory.IsPullback ((q_E ∣_ U) ≫ e₀.inv) (U_E.ι ≫ g_E)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))) := by
        simpa [CategoryTheory.Category.comp_id] using hp_vert.paste_horiz hp_e₀
      have hp_alg : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom))
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := E) (B := R))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))) :=
        (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
          (CommRingCat.isPushout_tensorProduct B₀ E R)).flip
      let iso_E : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ E R)) ≅
          (U_E : AlgebraicGeometry.Scheme.{u}) :=
        CategoryTheory.IsPullback.isoIsPullback _ _ hp_alg hp_geom
      let ι_E : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ E R)) ⟶ Z_E :=
        iso_E.hom ≫ U_E.ι
      have hOpenE : AlgebraicGeometry.IsOpenImmersion ι_E :=
        CategoryTheory.MorphismProperty.comp_mem @AlgebraicGeometry.IsOpenImmersion _ _
          inferInstance inferInstance
      have hRange : @AlgebraicGeometry.Scheme.Hom.opensRange _ _ ι_E hOpenE = U_E := by
        ext x
        change x ∈ Set.range (iso_E.hom ≫ U_E.ι).base ↔ x ∈ U_E
        rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
          (ConcreteCategory.bijective_of_isIso iso_E.hom.base).2.range_eq, Set.image_univ,
          AlgebraicGeometry.Scheme.Opens.range_ι]
        rfl
      have hq : ι_E ≫ q_E =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom) ≫
            ι₀ := by
        dsimp [ι_E]
        rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι q_E U]
        calc
          iso_E.hom ≫ (q_E ∣_ U) ≫ U.ι
            = (iso_E.hom ≫ ((q_E ∣_ U) ≫ e₀.inv)) ≫ (e₀.hom ≫ U.ι) := by
              simp [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom) ≫
                ι₀ := by
              rw [CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hp_alg hp_geom, he₀]
      have hg : ι_E ≫ g_E =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := E) (B := R))) := by
        dsimp [ι_E]
        rw [CategoryTheory.Category.assoc]
        exact CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hp_alg hp_geom
      exact ⟨ι_E, hOpenE, hRange, hq, hg⟩

    have hCompTop : IsCompact (((⊤ : Z₀.left.Opens) : Set ↥Z₀.left)) := isCompact_univ
    obtain ⟨S_cov, hS_fin, hS_eq⟩ :=
      AlgebraicGeometry.isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hCompTop
    let _ : Fintype S_cov := hS_fin.fintype
    let n_Z : ℕ := Fintype.card S_cov
    let eqv_Z : Fin n_Z ≃ S_cov := (Fintype.equivFin S_cov).symm
    let U_Z : Fin n_Z → Z₀.left.Opens := fun b => (eqv_Z b).1.1
    have hAff_UZ : ∀ b : Fin n_Z, AlgebraicGeometry.IsAffineOpen (U_Z b) := fun b => (eqv_Z b).1.2
    let C_cat : Fin n_Z → CommRingCat.{u} := fun b => Z₀.left.presheaf.obj (Opposite.op (U_Z b))
    let j₀ : ∀ b : Fin n_Z, AlgebraicGeometry.Spec (C_cat b) ⟶ Z₀.left :=
      fun b => (hAff_UZ b).fromSpec
    have hOpen_j₀ : ∀ b : Fin n_Z, AlgebraicGeometry.IsOpenImmersion (j₀ b) :=
      fun _ => inferInstance
    let ρ_C : ∀ b : Fin n_Z, CommRingCat.of ↥L₀ ⟶ C_cat b :=
      fun b => AlgebraicGeometry.Spec.preimage (j₀ b ≫ Z₀.hom)
    have hj₀_hom : ∀ b : Fin n_Z, j₀ b ≫ Z₀.hom = AlgebraicGeometry.Spec.map (ρ_C b) :=
      fun b => (AlgebraicGeometry.Spec.map_preimage (j₀ b ≫ Z₀.hom)).symm
    have hFT_C : ∀ b : Fin n_Z, ((ρ_C b).hom).FiniteType := by
      intro b
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map (ρ_C b)) := by
        rw [← hj₀_hom b]
        exact CategoryTheory.MorphismProperty.comp_mem @AlgebraicGeometry.LocallyOfFiniteType _ _
          inferInstance inferInstance
      exact (@AlgebraicGeometry.HasRingHomProperty.Spec_iff
        @AlgebraicGeometry.LocallyOfFiniteType _
        AlgebraicGeometry.instHasRingHomPropertyLocallyOfFiniteTypeFiniteType _ _ (ρ_C b)).mp hLFT
    have hCov_Z₀ : (⨆ b : Fin n_Z, @AlgebraicGeometry.Scheme.Hom.opensRange _ _ (j₀ b) (hOpen_j₀ b)) = ⊤ := by
      apply eq_top_iff.mpr
      intro z hz
      have hz' : z ∈ (⨆ i ∈ S_cov, (i : Z₀.left.Opens)) := by
        rw [← hS_eq]; exact hz
      rw [TopologicalSpace.Opens.mem_iSup] at hz' ⊢
      obtain ⟨u, hz'⟩ := hz'
      rw [TopologicalSpace.Opens.mem_iSup] at hz'
      obtain ⟨huS, hzu⟩ := hz'
      refine ⟨eqv_Z.symm ⟨u, huS⟩, ?_⟩
      have h_range : @AlgebraicGeometry.Scheme.Hom.opensRange _ _
          (j₀ (eqv_Z.symm ⟨u, huS⟩)) (hOpen_j₀ (eqv_Z.symm ⟨u, huS⟩)) = u.1 := by
        simp [j₀, U_Z, AlgebraicGeometry.IsAffineOpen.opensRange_fromSpec]
      rw [h_range]
      exact hzu

    let C : Fin n_Z → Type u := fun b => ↥(C_cat b)
    let _ : ∀ b : Fin n_Z, CommRing (C b) := fun b => inferInstanceAs (CommRing ↥(C_cat b))
    let _ : ∀ b : Fin n_Z, Algebra ↥L₀ (C b) := fun b => (ρ_C b).hom.toAlgebra
    have : ∀ b : Fin n_Z, Algebra.FiniteType ↥L₀ (C b) := hFT_C
    have : ∀ b : Fin n_Z, AlgebraicGeometry.IsOpenImmersion (j₀ b) := hOpen_j₀

    have h_pres_C : ∀ b : Fin n_Z, ∃ (t : ℕ) (π : MvPolynomial (Fin t) ↥L₀ →ₐ[↥L₀] C b),
        Function.Surjective π :=
      fun b => (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := ↥L₀) (S := C b)).mp inferInstance
    choose t π_C hπ_C_surj using h_pres_C
    let gen_C : ∀ b : Fin n_Z, Fin (t b) → C b := fun b τ => π_C b (MvPolynomial.X τ)

    have hj_k_ex : ∀ b : Fin n_Z,
        ∃ (j_k : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥L₀ k (C b))) ⟶ Z_bar.left)
          (hOpen : AlgebraicGeometry.IsOpenImmersion j_k),
          @AlgebraicGeometry.Scheme.Hom.opensRange _ _ j_k hOpen =
            (TopologicalSpace.Opens.map p_Z₀.base).obj (j₀ b).opensRange ∧
          j_k ≫ p_Z₀ =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := k) (B := C b)).toRingHom) ≫
              j₀ b ∧
          j_k ≫ Z_bar.hom =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := k) (B := C b))) :=
      fun b => hPullOpen ↥L₀ k (C b) Z₀.left Z_bar.left Z₀.hom Z_bar.hom p_Z₀ hpZ₀ (j₀ b) (hj₀_hom b)
    choose j_k hOpen_jk hjk_range hjk_pZ₀ hjk_hom using hj_k_ex
    have : ∀ b : Fin n_Z, AlgebraicGeometry.IsOpenImmersion (j_k b) := hOpen_jk

    have : AlgebraicGeometry.IsSeparated Z_bar.hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpZ₀ inferInstance
    have : AlgebraicGeometry.IsAffineHom e_k := by
      have h_comp_aff : AlgebraicGeometry.IsAffineHom (e_k ≫ Z_bar.hom) := by
        rw [he_k_hom]
        exact AlgebraicGeometry.isAffineHom_of_isAffine _
      exact @AlgebraicGeometry.IsAffineHom.of_comp _ _ _ e_k Z_bar.hom h_comp_aff inferInstance

    let O_sch : ∀ b : Fin n_Z, (AlgebraicGeometry.Spec A_k).Opens :=
      fun b => (TopologicalSpace.Opens.map e_k.base).obj (j_k b).opensRange
    let O : ∀ b : Fin n_Z, TopologicalSpace.Opens (_root_.PrimeSpectrum ↥A_k) := O_sch
    have hO_comp : ∀ b : Fin n_Z, IsCompact (O b).carrier := by
      intro b
      have hAff_jk : AlgebraicGeometry.IsAffineOpen (j_k b).opensRange :=
        AlgebraicGeometry.isAffineOpen_opensRange (j_k b)
      have hAff_O : AlgebraicGeometry.IsAffineOpen (O_sch b) :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage (f := e_k) (j_k b).opensRange hAff_jk
      exact hAff_O.isCompact

    have h_basic_ex : ∀ b : Fin n_Z,
        ∃ (q : ℕ) (u : Fin q → ↥A_k),
          O b = ⨆ μ : Fin q, _root_.PrimeSpectrum.basicOpen (u μ) := by
      intro b
      obtain ⟨Us, hUs_sub, hUs_fin, hUs_eq⟩ :=
        (@_root_.PrimeSpectrum.isBasis_basic_opens ↥A_k _).exists_finite_of_isCompact
          (U := O b) (hO_comp b)
      let _ : Fintype Us := hUs_fin.fintype
      let q := Fintype.card Us
      let eqv : Fin q ≃ Us := (Fintype.equivFin Us).symm
      have h_mem : ∀ μ : Fin q, ∃ f : ↥A_k, _root_.PrimeSpectrum.basicOpen f = (eqv μ).1 :=
        fun μ => hUs_sub (eqv μ).2
      choose u hu using h_mem
      refine ⟨q, u, ?_⟩
      rw [hUs_eq]
      apply le_antisymm
      · refine sSup_le fun v hv => ?_
        refine le_iSup_of_le (eqv.symm ⟨v, hv⟩) ?_
        rw [hu (eqv.symm ⟨v, hv⟩)]
        simp
      · refine iSup_le fun μ => ?_
        rw [hu μ]
        exact le_sSup (eqv μ).2
    choose q u_bar hu_bar using h_basic_ex

    let P : Type := Σ b : Fin n_Z, Fin (q b)
    have hSpan_bar : Ideal.span (Set.range fun p : P => u_bar p.1 p.2) = ⊤ := by
      rw [← _root_.PrimeSpectrum.iSup_basicOpen_eq_top_iff]
      apply eq_top_iff.mpr
      intro x _
      have hx_Z₀ : p_Z₀.base (e_k.base x) ∈
          (⨆ b : Fin n_Z, @AlgebraicGeometry.Scheme.Hom.opensRange _ _ (j₀ b) (hOpen_j₀ b)) := by
        rw [hCov_Z₀]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hx_Z₀
      obtain ⟨b, hxb⟩ := hx_Z₀
      have hxb_jk : e_k.base x ∈ (j_k b).opensRange := by
        rw [hjk_range b]; exact hxb
      have hx_O : x ∈ O b := hxb_jk
      rw [hu_bar b, TopologicalSpace.Opens.mem_iSup] at hx_O
      obtain ⟨μ, hxμ⟩ := hx_O
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨b, μ⟩, hxμ⟩

    have h_bezout : ∃ c : P → ↥A_k, ∑ p : P, c p * u_bar p.1 p.2 = 1 := by
      have h1 : (1 : ↥A_k) ∈ Ideal.span (Set.range fun p : P => u_bar p.1 p.2) := by
        rw [hSpan_bar]; trivial
      exact Ideal.mem_span_range_iff_exists_fun.mp h1
    obtain ⟨c_bar, hc_bar⟩ := h_bezout

    let ℓ_bar : ∀ (b : Fin n_Z) (μ : Fin (q b)),
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (u_bar b μ))) ⟶
          AlgebraicGeometry.Spec A_k :=
      fun b μ => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥A_k (Localization.Away (u_bar b μ))))
    have h_range_sub : ∀ (b : Fin n_Z) (μ : Fin (q b)),
        Set.range (ℓ_bar b μ ≫ e_k).base ⊆ Set.range (j_k b).base := by
      intro b μ y hy
      obtain ⟨z, rfl⟩ := hy
      let x_z : _root_.PrimeSpectrum ↥A_k := (ℓ_bar b μ).base z
      have hz_basic : x_z ∈ _root_.PrimeSpectrum.basicOpen (u_bar b μ) := by
        have h_rng := _root_.PrimeSpectrum.localization_away_comap_range
          (Localization.Away (u_bar b μ)) (u_bar b μ)
        have hz_mem : x_z ∈
            Set.range (_root_.PrimeSpectrum.comap (algebraMap ↥A_k (Localization.Away (u_bar b μ)))) :=
          ⟨z, rfl⟩
        rw [h_rng] at hz_mem
        exact hz_mem
      have hz_O : x_z ∈ O b := by
        rw [hu_bar b]
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨μ, hz_basic⟩
      exact hz_O

    let m_bar := fun b μ =>
      AlgebraicGeometry.IsOpenImmersion.lift (j_k b) (ℓ_bar b μ ≫ e_k) (h_range_sub b μ)
    let ϑ_bar : ∀ (b : Fin n_Z) (μ : Fin (q b)),
        TensorProduct ↥L₀ k (C b) →+* Localization.Away (u_bar b μ) :=
      fun b μ => (AlgebraicGeometry.Spec.preimage (m_bar b μ)).hom
    have hm_bar_eq : ∀ b μ,
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ϑ_bar b μ)) = m_bar b μ :=
      fun b μ => AlgebraicGeometry.Spec.map_preimage (m_bar b μ)

    have hϑ_bar_alg : ∀ (b : Fin n_Z) (μ : Fin (q b)),
        (ϑ_bar b μ).comp Algebra.TensorProduct.includeLeftRingHom =
          (algebraMap ↥A_k (Localization.Away (u_bar b μ))).comp ρ_k := by
      intro b μ
      have h_spec :
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((ϑ_bar b μ).comp Algebra.TensorProduct.includeLeftRingHom)) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap ↥A_k (Localization.Away (u_bar b μ))).comp ρ_k)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hm_bar_eq b μ,
          ← hjk_hom b, ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.lift_fac,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← he_k_hom]
        dsimp [ℓ_bar]
        rw [CategoryTheory.Category.assoc]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h_spec)

    let sec_pair := fun (b : Fin n_Z) (μ : Fin (q b)) (τ : Fin (t b)) =>
      IsLocalization.Away.sec (u_bar b μ) (ϑ_bar b μ ((1 : k) ⊗ₜ[↥L₀] gen_C b τ))
    let w_bar := fun b μ τ => (sec_pair b μ τ).1
    let e_exp := fun b μ τ => (sec_pair b μ τ).2

    let Idx_elem : Type := P ⊕ P ⊕ (Σ (b : Fin n_Z) (_ : Fin (q b)), Fin (t b))
    let elem_bar : Idx_elem → ↥A_k := fun idx => match idx with
      | Sum.inl p => u_bar p.1 p.2
      | Sum.inr (Sum.inl p) => c_bar p
      | Sum.inr (Sum.inr ⟨b, μ, τ⟩) => w_bar b μ τ
    choose E_el hLE_el hFD_el x_el hx_el using fun idx : Idx_elem => hExhaust_A (elem_bar idx)

    let L₁ : IntermediateField F k := L_alg ⊔ ⨆ idx : Idx_elem, E_el idx
    have hLE₁ : L_alg ≤ L₁ := le_sup_left
    have hFD₁ : FiniteDimensional F ↥L₁ := by
      have : ∀ idx : Idx_elem, FiniteDimensional F ↥(E_el idx) := hFD_el
      have : FiniteDimensional F ↥(⨆ idx : Idx_elem, E_el idx) :=
        IntermediateField.finiteDimensional_iSup_of_finite
      exact IntermediateField.finiteDimensional_sup L_alg _

    let elem_1 : Idx_elem → A_fam L₁ hLE₁ := fun idx =>
      τ_A (hLE_el idx) hLE₁ ((le_iSup E_el idx).trans le_sup_right) (x_el idx)
    have helem_1 : ∀ idx : Idx_elem, ι_A L₁ hLE₁ (elem_1 idx) = elem_bar idx := by
      intro idx
      dsimp [elem_1]
      have hcomp := RingHom.congr_fun
        (hτ_ι (hLE_el idx) hLE₁ ((le_iSup E_el idx).trans le_sup_right)) (x_el idx)
      simpa only [RingHom.comp_apply, hx_el idx] using hcomp

    refine ⟨L₁, hLE₁, hFD₁, ?_⟩
    intro L hL hL_alg
    let _ : Algebra ↥L₀ ↥L := (IntermediateField.inclusion (hLE₀.trans hL_alg)).toRingHom.toAlgebra
    have : IsScalarTower ↥L₀ ↥L k := IsScalarTower.of_algebraMap_eq' rfl
    intro Z_L q_Z p_ZL hqZ hpZL hp_comp

    let A_L := A_fam L hL_alg
    let u_L : ∀ (b : Fin n_Z), Fin (q b) → ↥A_L :=
      fun b μ => τ_A hLE₁ hL_alg hL (elem_1 (Sum.inl ⟨b, μ⟩))
    let c_L : P → ↥A_L :=
      fun p => τ_A hLE₁ hL_alg hL (elem_1 (Sum.inr (Sum.inl p)))
    let w_L : ∀ (b : Fin n_Z) (μ : Fin (q b)), Fin (t b) → ↥A_L :=
      fun b μ τ => τ_A hLE₁ hL_alg hL (elem_1 (Sum.inr (Sum.inr ⟨b, μ, τ⟩)))

    have hu_eq : ∀ b μ, ι_A L hL_alg (u_L b μ) = u_bar b μ := by
      intro b μ
      have hcomp := RingHom.congr_fun (hτ_ι hLE₁ hL_alg hL) (elem_1 (Sum.inl ⟨b, μ⟩))
      simpa only [RingHom.comp_apply, helem_1] using hcomp
    have hc_eq : ∀ p, ι_A L hL_alg (c_L p) = c_bar p := by
      intro p
      have hcomp := RingHom.congr_fun (hτ_ι hLE₁ hL_alg hL) (elem_1 (Sum.inr (Sum.inl p)))
      simpa only [RingHom.comp_apply, helem_1] using hcomp
    have hw_eq : ∀ b μ τ, ι_A L hL_alg (w_L b μ τ) = w_bar b μ τ := by
      intro b μ τ
      have hcomp := RingHom.congr_fun (hτ_ι hLE₁ hL_alg hL) (elem_1 (Sum.inr (Sum.inr ⟨b, μ, τ⟩)))
      simpa only [RingHom.comp_apply, helem_1] using hcomp

    have hSpan_L : Ideal.span (Set.range fun p : P => u_L p.1 p.2) = ⊤ := by
      rw [Ideal.eq_top_iff_one, Ideal.mem_span_range_iff_exists_fun]
      refine ⟨c_L, hInj_A L hL_alg ?_⟩
      rw [map_sum, map_one, ← hc_bar]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [map_mul, hc_eq p, hu_eq p.1 p.2]

    have h_sub_pow : ∀ b μ,
        Submonoid.powers (u_L b μ) ≤ (Submonoid.powers (u_bar b μ)).comap (ι_A L hL_alg) := by
      intro b μ
      refine Submonoid.powers_le.mpr ?_
      change ι_A L hL_alg (u_L b μ) ∈ Submonoid.powers (u_bar b μ)
      rw [hu_eq b μ]
      exact Submonoid.mem_powers _

    let lam : ∀ (b : Fin n_Z) (μ : Fin (q b)),
        Localization.Away (u_L b μ) →+* Localization.Away (u_bar b μ) :=
      fun b μ => IsLocalization.map (Localization.Away (u_bar b μ)) (ι_A L hL_alg) (h_sub_pow b μ)
    have hlam_alg : ∀ b μ,
        (lam b μ).comp (algebraMap ↥A_L (Localization.Away (u_L b μ))) =
          (algebraMap ↥A_k (Localization.Away (u_bar b μ))).comp (ι_A L hL_alg) :=
      fun b μ => IsLocalization.map_comp (h_sub_pow b μ)

    have hlam_inj : ∀ b μ, Function.Injective (lam b μ) := by
      intro b μ
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro z hz_ker
      have hz : lam b μ z = 0 := RingHom.mem_ker.mp hz_ker
      change z = 0
      obtain ⟨⟨x, s_pow⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers (u_L b μ)) z
      have h_map_x : algebraMap ↥A_k (Localization.Away (u_bar b μ)) (ι_A L hL_alg x) = 0 := by
        have h1 : lam b μ (z * algebraMap _ _ s_pow.1) = lam b μ (algebraMap _ _ x) :=
          congrArg (lam b μ) hzs
        rw [map_mul, hz, zero_mul] at h1
        have h2 := RingHom.congr_fun (hlam_alg b μ) x
        dsimp at h2
        rw [h2] at h1
        exact h1.symm
      obtain ⟨⟨m_bar, N, rfl⟩, hm_eq⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (u_bar b μ))
          (Localization.Away (u_bar b μ)) (ι_A L hL_alg x)).mp h_map_x
      have hx0 : u_L b μ ^ N * x = 0 := by
        apply hInj_A L hL_alg
        rw [map_mul, map_pow, hu_eq b μ, map_zero]
        exact hm_eq
      have hz_unit : (algebraMap _ (Localization.Away (u_L b μ)) (u_L b μ ^ N) * z) *
          algebraMap _ (Localization.Away (u_L b μ)) s_pow.1 = 0 := by
        rw [mul_assoc, hzs, ← map_mul, hx0, map_zero]
      have hu1 : IsUnit (algebraMap _ (Localization.Away (u_L b μ)) s_pow.1) :=
        IsLocalization.map_units (Localization.Away (u_L b μ)) s_pow
      have hu2 : IsUnit (algebraMap _ (Localization.Away (u_L b μ)) (u_L b μ ^ N)) :=
        IsLocalization.map_units (Localization.Away (u_L b μ))
          ⟨u_L b μ ^ N, Submonoid.pow_mem _ (Submonoid.mem_powers _) N⟩
      have hz1 : algebraMap _ (Localization.Away (u_L b μ)) (u_L b μ ^ N) * z = 0 :=
        hu1.mul_right_cancel (by rw [hz_unit, zero_mul])
      exact hu2.mul_left_cancel (by rw [hz1, mul_zero])

    let tpMap : ∀ b : Fin n_Z, TensorProduct ↥L₀ ↥L (C b) →+* TensorProduct ↥L₀ k (C b) :=
      fun b => (Algebra.TensorProduct.map
        ({ toRingHom := algebraMap ↥L k, commutes' := fun _ => rfl } : ↥L →ₐ[↥L₀] k)
        (AlgHom.id ↥L₀ (C b))).toRingHom

    have hϑ_L_ex : ∀ (b : Fin n_Z) (μ : Fin (q b)),
        ∃ ϑ_L : TensorProduct ↥L₀ ↥L (C b) →+* Localization.Away (u_L b μ),
          ϑ_L.comp Algebra.TensorProduct.includeLeftRingHom =
            (algebraMap ↥A_L (Localization.Away (u_L b μ))).comp (ρ_fam L hL_alg) ∧
          (lam b μ).comp ϑ_L = (ϑ_bar b μ).comp (tpMap b) := by
      intro b μ
      let Loc_L := Localization.Away (u_L b μ)
      let Loc_bar := Localization.Away (u_bar b μ)
      let α_L : ↥L →+* Loc_L := (algebraMap ↥A_L Loc_L).comp (ρ_fam L hL_alg)
      let frac_L : Fin (t b) → Loc_L := fun τ =>
        IsLocalization.mk' Loc_L (w_L b μ τ)
          ⟨u_L b μ ^ e_exp b μ τ, Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩
      let θ_poly : MvPolynomial (Fin (t b)) ↥L₀ →+* Loc_L :=
        MvPolynomial.eval₂Hom (α_L.comp (algebraMap ↥L₀ ↥L)) frac_L
      have h_poly_comm : (lam b μ).comp θ_poly =
          (ϑ_bar b μ).comp
            ((Algebra.TensorProduct.includeRight (R := ↥L₀) (A := k) (B := C b)).toRingHom.comp
              (π_C b).toRingHom) := by
        apply MvPolynomial.ringHom_ext
        · intro c₀
          simp only [RingHom.comp_apply, θ_poly, MvPolynomial.eval₂Hom_C, α_L]
          have h1 := RingHom.congr_fun (hlam_alg b μ) (ρ_fam L hL_alg (algebraMap ↥L₀ ↥L c₀))
          dsimp at h1
          rw [h1]
          have hρ_c := RingHom.congr_fun (hρ_ι L hL_alg) (algebraMap ↥L₀ ↥L c₀)
          dsimp at hρ_c
          rw [hρ_c]
          change (algebraMap ↥A_k Loc_bar) (ρ_k (algebraMap ↥L₀ k c₀)) = _
          have h2 := RingHom.congr_fun (hϑ_bar_alg b μ) (algebraMap ↥L₀ k c₀)
          dsimp at h2
          rw [← h2]
          congr 1
          have hc_comm : (π_C b).toRingHom (MvPolynomial.C c₀) = algebraMap ↥L₀ (C b) c₀ :=
            (π_C b).commutes c₀
          rw [hc_comm]
          exact Algebra.TensorProduct.tmul_one_eq_one_tmul (R := ↥L₀) (A := k) (B := C b) c₀
        · intro τ
          simp only [RingHom.comp_apply, θ_poly, MvPolynomial.eval₂Hom_X']
          have h_spec_L : frac_L τ * algebraMap ↥A_L Loc_L (u_L b μ ^ e_exp b μ τ) =
              algebraMap ↥A_L Loc_L (w_L b μ τ) :=
            IsLocalization.mk'_spec Loc_L (w_L b μ τ)
              ⟨u_L b μ ^ e_exp b μ τ, Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩
          have h_lam_u := congrArg (lam b μ) h_spec_L
          rw [map_mul] at h_lam_u
          have hl1 := RingHom.congr_fun (hlam_alg b μ) (u_L b μ ^ e_exp b μ τ)
          have hl2 := RingHom.congr_fun (hlam_alg b μ) (w_L b μ τ)
          dsimp at hl1 hl2
          rw [hl1, hl2, map_pow, hu_eq b μ, hw_eq b μ τ] at h_lam_u
          have h_sec := IsLocalization.Away.sec_spec (u_bar b μ)
            (ϑ_bar b μ ((1 : k) ⊗ₜ[↥L₀] gen_C b τ))
          have hu_unit : IsUnit (algebraMap ↥A_k Loc_bar (u_bar b μ ^ e_exp b μ τ)) :=
            IsLocalization.map_units Loc_bar
              ⟨u_bar b μ ^ e_exp b μ τ, Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩
          exact hu_unit.mul_right_cancel (h_lam_u.trans h_sec.symm)
      have h_ker : ∀ y ∈ RingHom.ker (π_C b).toRingHom, θ_poly y = 0 := by
        intro y hy
        apply hlam_inj b μ
        rw [map_zero]
        have hcy := RingHom.congr_fun h_poly_comm y
        simp only [RingHom.comp_apply] at hcy
        rw [hcy, RingHom.mem_ker.mp hy, map_zero, map_zero]
      let e_quot := RingHom.quotientKerEquivOfSurjective (hπ_C_surj b)
      let θ_C : C b →+* Loc_L :=
        (Ideal.Quotient.lift (RingHom.ker (π_C b).toRingHom) θ_poly h_ker).comp e_quot.symm.toRingHom
      have hθ_C_π : ∀ y : MvPolynomial (Fin (t b)) ↥L₀, θ_C (π_C b y) = θ_poly y := by
        intro y
        have he : e_quot.symm (π_C b y) = Ideal.Quotient.mk (RingHom.ker (π_C b).toRingHom) y := by
          apply e_quot.injective
          rw [RingEquiv.apply_symm_apply]
          rfl
        change Ideal.Quotient.lift (RingHom.ker (π_C b).toRingHom) θ_poly h_ker (e_quot.symm (π_C b y)) =
          θ_poly y
        rw [he]
        rfl
      have h_agree :
          CommRingCat.ofHom (algebraMap ↥L₀ ↥L) ≫ CommRingCat.ofHom α_L =
            CommRingCat.ofHom (algebraMap ↥L₀ (C b)) ≫ CommRingCat.ofHom θ_C := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 1
        ext c₀
        simp only [RingHom.comp_apply]
        have hc_π : algebraMap ↥L₀ (C b) c₀ = π_C b (MvPolynomial.C c₀) := ((π_C b).commutes c₀).symm
        rw [hc_π, hθ_C_π (MvPolynomial.C c₀)]
        simp [θ_poly]
      let hp_push := CommRingCat.isPushout_tensorProduct ↥L₀ ↥L (C b)
      let ϑ_cat := hp_push.desc (CommRingCat.ofHom α_L) (CommRingCat.ofHom θ_C) h_agree
      refine ⟨ϑ_cat.hom, ?_, ?_⟩
      · exact congrArg CommRingCat.Hom.hom
          (hp_push.inl_desc (CommRingCat.ofHom α_L) (CommRingCat.ofHom θ_C) h_agree)
      · have h_cat_eq :
            ϑ_cat ≫ CommRingCat.ofHom (lam b μ) =
              CommRingCat.ofHom (tpMap b) ≫ CommRingCat.ofHom (ϑ_bar b μ) := by
          apply hp_push.hom_ext
          · rw [← CategoryTheory.Category.assoc,
              hp_push.inl_desc (CommRingCat.ofHom α_L) (CommRingCat.ofHom θ_C) h_agree,
              ← CommRingCat.ofHom_comp, ← CategoryTheory.Category.assoc,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            congr 1
            ext x_L
            simp only [RingHom.comp_apply, α_L]
            have h1 := RingHom.congr_fun (hlam_alg b μ) (ρ_fam L hL_alg x_L)
            dsimp at h1
            rw [h1]
            have hρ_x := RingHom.congr_fun (hρ_ι L hL_alg) x_L
            dsimp at hρ_x
            rw [hρ_x]
            have h2 := RingHom.congr_fun (hϑ_bar_alg b μ) (algebraMap ↥L k x_L)
            dsimp at h2
            exact h2.symm
          · rw [← CategoryTheory.Category.assoc,
              hp_push.inr_desc (CommRingCat.ofHom α_L) (CommRingCat.ofHom θ_C) h_agree,
              ← CommRingCat.ofHom_comp, ← CategoryTheory.Category.assoc,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            congr 1
            ext r_c
            obtain ⟨y, rfl⟩ := hπ_C_surj b r_c
            simp only [RingHom.comp_apply, hθ_C_π y]
            have hcy := RingHom.congr_fun h_poly_comm y
            simp only [RingHom.comp_apply] at hcy
            exact hcy
        exact congrArg CommRingCat.Hom.hom h_cat_eq
    choose ϑ_L hϑ_L_alg hlam_ϑ using hϑ_L_ex

    have hj_L_ex : ∀ b : Fin n_Z,
        ∃ (j_L : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥L₀ ↥L (C b))) ⟶ Z_L.left)
          (hOpen : AlgebraicGeometry.IsOpenImmersion j_L),
          @AlgebraicGeometry.Scheme.Hom.opensRange _ _ j_L hOpen =
            (TopologicalSpace.Opens.map q_Z.base).obj (j₀ b).opensRange ∧
          j_L ≫ q_Z =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := ↥L) (B := C b)).toRingHom) ≫
              j₀ b ∧
          j_L ≫ Z_L.hom =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := C b))) :=
      fun b => hPullOpen ↥L₀ ↥L (C b) Z₀.left Z_L.left Z₀.hom Z_L.hom q_Z hqZ (j₀ b) (hj₀_hom b)
    choose j_L hOpen_jL hjL_range hjL_qZ hjL_hom using hj_L_ex
    have : ∀ b : Fin n_Z, AlgebraicGeometry.IsOpenImmersion (j_L b) := hOpen_jL

    have hj_comm : ∀ b : Fin n_Z,
        j_k b ≫ p_ZL = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (tpMap b)) ≫ j_L b := by
      intro b
      have hqZ' : CategoryTheory.IsPullback q_Z Z_L.hom Z₀.hom _ := hqZ
      have hpZL' : CategoryTheory.IsPullback p_ZL Z_bar.hom Z_L.hom _ := hpZL
      apply hqZ'.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hp_comp,
          hjk_pZ₀ b, hjL_qZ b, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hpZL'.w,
          ← CategoryTheory.Category.assoc, hjk_hom b, hjL_hom b,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 2

    let p_A : AlgebraicGeometry.Spec A_k ⟶ AlgebraicGeometry.Spec A_L :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_A L hL_alg))
    let s_Lk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L k))
    have hp_A_base : CategoryTheory.IsPullback
        p_A
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_k))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ_fam L hL_alg)))
        s_Lk :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPush_A L hL_alg)).flip

    let ℓ_L : ∀ p : P,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (u_L p.1 p.2))) ⟶
          AlgebraicGeometry.Spec A_L :=
      fun p => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥A_L (Localization.Away (u_L p.1 p.2))))
    have : ∀ p : P, AlgebraicGeometry.IsOpenImmersion (ℓ_L p) := fun _ => inferInstance
    have : ∀ b μ, AlgebraicGeometry.IsOpenImmersion (ℓ_bar b μ) := fun _ _ => inferInstance

    let U_cov : P → (AlgebraicGeometry.Spec A_L).Opens := fun p => (ℓ_L p).opensRange
    have hCov_AL : ∀ y : AlgebraicGeometry.Spec A_L, ∃ p : P, y ∈ U_cov p := by
      intro y
      let y_ps : _root_.PrimeSpectrum ↥A_L := y
      have h_top : (⨆ p : P, _root_.PrimeSpectrum.basicOpen (u_L p.1 p.2)) = ⊤ :=
        (_root_.PrimeSpectrum.iSup_basicOpen_eq_top_iff).mpr hSpan_L
      have hy_mem : y_ps ∈ (⨆ p : P, _root_.PrimeSpectrum.basicOpen (u_L p.1 p.2)) := by
        rw [h_top]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hy_mem
      obtain ⟨p, hy_basic⟩ := hy_mem
      have h_rng := _root_.PrimeSpectrum.localization_away_comap_range
        (Localization.Away (u_L p.1 p.2)) (u_L p.1 p.2)
      have hy_rng : y_ps ∈ Set.range
          (_root_.PrimeSpectrum.comap (algebraMap ↥A_L (Localization.Away (u_L p.1 p.2)))) := by
        rw [h_rng]; exact hy_basic
      obtain ⟨z₀, hz₀⟩ := hy_rng
      exact ⟨p, z₀, hz₀⟩

    have hSup_AL : (⨆ p : P, U_cov p) = ⊤ := by
      apply eq_top_iff.mpr
      intro y _
      obtain ⟨p, hp⟩ := hCov_AL y
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨p, hp⟩

    let 𝒰 : (AlgebraicGeometry.Spec A_L).OpenCover :=
      (AlgebraicGeometry.Spec A_L).openCoverOfIsOpenCover U_cov hSup_AL
    let e_iso : ∀ p : P,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (u_L p.1 p.2))) ≅
          (U_cov p : AlgebraicGeometry.Scheme.{u}) :=
      fun p => (ℓ_L p).isoOpensRange
    have he_hom : ∀ p : P, (e_iso p).hom ≫ (U_cov p).ι = ℓ_L p :=
      fun p => (ℓ_L p).isoOpensRange_hom_ι
    have he_inv : ∀ p : P, (e_iso p).inv ≫ ℓ_L p = (U_cov p).ι := fun p => by
      rw [← he_hom p, CategoryTheory.Iso.inv_hom_id_assoc]

    let q_loc : ∀ p : P,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (u_bar p.1 p.2))) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (u_L p.1 p.2))) :=
      fun p => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (lam p.1 p.2))
    let φ_loc : ∀ p : P,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (u_L p.1 p.2))) ⟶ Z_L.left :=
      fun p => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ϑ_L p.1 p.2)) ≫ j_L p.1
    let φ_tilde : ∀ p : P, (U_cov p : AlgebraicGeometry.Scheme.{u}) ⟶ Z_L.left :=
      fun p => (e_iso p).inv ≫ φ_loc p
    let q_tilde : ∀ p : P,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (u_bar p.1 p.2))) ⟶
          (U_cov p : AlgebraicGeometry.Scheme.{u}) :=
      fun p => q_loc p ≫ (e_iso p).hom

    have hq_comm : ∀ p : P, q_loc p ≫ ℓ_L p = ℓ_bar p.1 p.2 ≫ p_A := by
      intro ⟨b, μ⟩
      dsimp [q_loc, ℓ_L, ℓ_bar, p_A]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hlam_alg b μ]

    have hq_range : ∀ p : P,
        (TopologicalSpace.Opens.map p_A.base).obj (U_cov p) = (ℓ_bar p.1 p.2).opensRange := by
      intro ⟨b, μ⟩
      ext x_bar
      let xk_ps : _root_.PrimeSpectrum ↥A_k := x_bar
      let xL_ps : _root_.PrimeSpectrum ↥A_L := p_A.base x_bar
      have h_rngL := _root_.PrimeSpectrum.localization_away_comap_range
        (Localization.Away (u_L b μ)) (u_L b μ)
      have h_rngk := _root_.PrimeSpectrum.localization_away_comap_range
        (Localization.Away (u_bar b μ)) (u_bar b μ)
      have hL_iff : xL_ps ∈ Set.range
          (_root_.PrimeSpectrum.comap (algebraMap ↥A_L (Localization.Away (u_L b μ)))) ↔
          u_L b μ ∉ xL_ps.asIdeal := by
        rw [h_rngL]; rfl
      have hk_iff : xk_ps ∈ Set.range
          (_root_.PrimeSpectrum.comap (algebraMap ↥A_k (Localization.Away (u_bar b μ)))) ↔
          u_bar b μ ∉ xk_ps.asIdeal := by
        rw [h_rngk]; rfl
      change xL_ps ∈ Set.range
          (_root_.PrimeSpectrum.comap (algebraMap ↥A_L (Localization.Away (u_L b μ)))) ↔
        xk_ps ∈ Set.range
          (_root_.PrimeSpectrum.comap (algebraMap ↥A_k (Localization.Away (u_bar b μ))))
      rw [hL_iff, hk_iff]
      have h_comap : u_L b μ ∈ xL_ps.asIdeal ↔ u_bar b μ ∈ xk_ps.asIdeal := by
        change u_L b μ ∈ (_root_.PrimeSpectrum.comap (ι_A L hL_alg) xk_ps).asIdeal ↔ _
        rw [_root_.PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hu_eq b μ]
      exact not_congr h_comap

    have hp_loc : ∀ p : P,
        CategoryTheory.IsPullback (q_tilde p) (ℓ_bar p.1 p.2) (U_cov p).ι p_A := by
      intro p
      apply AlgebraicGeometry.IsOpenImmersion.isPullback
      · dsimp [q_tilde]
        rw [CategoryTheory.Category.assoc, he_hom p, hq_comm p]
      · change (TopologicalSpace.Opens.map p_A.base).obj (U_cov p).ι.opensRange =
          (ℓ_bar p.1 p.2).opensRange
        rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
        exact hq_range p

    have hφ_comm : ∀ p : P, q_loc p ≫ φ_loc p = ℓ_bar p.1 p.2 ≫ e_k ≫ p_ZL := by
      intro ⟨b, μ⟩
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (lam b μ)) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ϑ_L b μ)) ≫ j_L b)
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((lam b μ).comp (ϑ_L b μ))) ≫ j_L b := by
            rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ϑ_bar b μ).comp (tpMap b))) ≫ j_L b := by
            rw [hlam_ϑ b μ]
        _ = m_bar b μ ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (tpMap b)) ≫ j_L b) := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc, hm_bar_eq b μ]
        _ = (m_bar b μ ≫ j_k b) ≫ p_ZL := by
            rw [← hj_comm b, CategoryTheory.Category.assoc]
        _ = ℓ_bar b μ ≫ e_k ≫ p_ZL := by
            rw [AlgebraicGeometry.IsOpenImmersion.lift_fac, CategoryTheory.Category.assoc]

    have h_overlap : ∀ (p₁ p₂ : P),
        CategoryTheory.Limits.pullback.fst (U_cov p₁).ι (U_cov p₂).ι ≫ φ_tilde p₁ =
          CategoryTheory.Limits.pullback.snd (U_cov p₁).ι (U_cov p₂).ι ≫ φ_tilde p₂ := by
      intro p₁ p₂
      let π₁ := CategoryTheory.Limits.pullback.fst (U_cov p₁).ι (U_cov p₂).ι
      let π₂ := CategoryTheory.Limits.pullback.snd (U_cov p₁).ι (U_cov p₂).ι
      let i_WQ := CategoryTheory.Limits.pullback.fst p_A (π₁ ≫ (U_cov p₁).ι)
      let p_Q := CategoryTheory.Limits.pullback.snd p_A (π₁ ≫ (U_cov p₁).ι)
      have hp_WQ : CategoryTheory.IsPullback i_WQ p_Q p_A (π₁ ≫ (U_cov p₁).ι) :=
        CategoryTheory.IsPullback.of_hasPullback p_A (π₁ ≫ (U_cov p₁).ι)
      have hp_Q_base : CategoryTheory.IsPullback
          (i_WQ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_k)) p_Q s_Lk
          (π₁ ≫ (U_cov p₁).ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ_fam L hL_alg))) := by
        simpa [CategoryTheory.Category.assoc] using hp_WQ.paste_horiz hp_A_base.flip
      have : AlgebraicGeometry.Flat p_Q :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_Q_base inferInstance
      have : AlgebraicGeometry.Surjective p_Q :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_Q_base inferInstance
      have : CategoryTheory.Epi p_Q := AlgebraicGeometry.Flat.epi_of_flat_of_surjective p_Q
      apply (CategoryTheory.cancel_epi p_Q).mp
      have h1 : p_Q ≫ π₁ ≫ φ_tilde p₁ = i_WQ ≫ e_k ≫ p_ZL := by
        have hw₁ : (p_Q ≫ π₁) ≫ (U_cov p₁).ι = i_WQ ≫ p_A := by
          rw [CategoryTheory.Category.assoc]; exact hp_WQ.w.symm
        let l₁ := (hp_loc p₁).lift (p_Q ≫ π₁) i_WQ hw₁
        calc
          p_Q ≫ π₁ ≫ φ_tilde p₁
            = (l₁ ≫ q_tilde p₁) ≫ φ_tilde p₁ := by
              dsimp [l₁]; rw [(hp_loc p₁).lift_fst, CategoryTheory.Category.assoc]
          _ = l₁ ≫ q_loc p₁ ≫ φ_loc p₁ := by
              dsimp [q_tilde, φ_tilde]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                CategoryTheory.Iso.hom_inv_id_assoc]
          _ = l₁ ≫ ℓ_bar p₁.1 p₁.2 ≫ e_k ≫ p_ZL := by rw [hφ_comm p₁]
          _ = i_WQ ≫ e_k ≫ p_ZL := by
              dsimp [l₁]; rw [← CategoryTheory.Category.assoc, (hp_loc p₁).lift_snd]
      have h2 : p_Q ≫ π₂ ≫ φ_tilde p₂ = i_WQ ≫ e_k ≫ p_ZL := by
        have hw₂ : (p_Q ≫ π₂) ≫ (U_cov p₂).ι = i_WQ ≫ p_A := by
          rw [CategoryTheory.Category.assoc,
            ← CategoryTheory.Limits.pullback.condition (f := (U_cov p₁).ι) (g := (U_cov p₂).ι)]
          exact hp_WQ.w.symm
        let l₂ := (hp_loc p₂).lift (p_Q ≫ π₂) i_WQ hw₂
        calc
          p_Q ≫ π₂ ≫ φ_tilde p₂
            = (l₂ ≫ q_tilde p₂) ≫ φ_tilde p₂ := by
              dsimp [l₂]; rw [(hp_loc p₂).lift_fst, CategoryTheory.Category.assoc]
          _ = l₂ ≫ q_loc p₂ ≫ φ_loc p₂ := by
              dsimp [q_tilde, φ_tilde]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                CategoryTheory.Iso.hom_inv_id_assoc]
          _ = l₂ ≫ ℓ_bar p₂.1 p₂.2 ≫ e_k ≫ p_ZL := by rw [hφ_comm p₂]
          _ = i_WQ ≫ e_k ≫ p_ZL := by
              dsimp [l₂]; rw [← CategoryTheory.Category.assoc, (hp_loc p₂).lift_snd]
      exact h1.trans h2.symm

    let e_L : AlgebraicGeometry.Spec A_L ⟶ Z_L.left := 𝒰.glueMorphisms φ_tilde h_overlap
    have h_ι_glue : ∀ p : P, (U_cov p).ι ≫ e_L = φ_tilde p :=
      fun p => 𝒰.ι_glueMorphisms φ_tilde h_overlap p

    refine ⟨e_L, ?_, ?_⟩
    · apply 𝒰.hom_ext
      intro ⟨b, μ⟩
      change (U_cov ⟨b, μ⟩).ι ≫ (e_L ≫ Z_L.hom) =
        (U_cov ⟨b, μ⟩).ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ_fam L hL_alg))
      rw [← CategoryTheory.Category.assoc, h_ι_glue ⟨b, μ⟩]
      dsimp [φ_tilde, φ_loc]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hjL_hom b,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hϑ_L_alg b μ,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        ← CategoryTheory.Category.assoc, he_inv ⟨b, μ⟩]
    · apply AlgebraicGeometry.Scheme.hom_ext_of_forall
      intro x_bar
      obtain ⟨p, hp⟩ := hCov_AL (p_A.base x_bar)
      have hx_bar : x_bar ∈ (ℓ_bar p.1 p.2).opensRange := by
        rw [← hq_range p]; exact hp
      refine ⟨(ℓ_bar p.1 p.2).opensRange, hx_bar, ?_⟩
      have h_u_eq : ℓ_bar p.1 p.2 ≫ p_A ≫ e_L = ℓ_bar p.1 p.2 ≫ e_k ≫ p_ZL := by
        calc
          ℓ_bar p.1 p.2 ≫ p_A ≫ e_L
            = (ℓ_bar p.1 p.2 ≫ p_A) ≫ e_L := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (q_loc p ≫ ℓ_L p) ≫ e_L := by rw [hq_comm p]
          _ = q_tilde p ≫ ((U_cov p).ι ≫ e_L) := by
              dsimp [q_tilde]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc (e_iso p).hom, he_hom p]
          _ = q_tilde p ≫ φ_tilde p := by rw [h_ι_glue p]
          _ = q_loc p ≫ φ_loc p := by
              dsimp [q_tilde, φ_tilde]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
          _ = ℓ_bar p.1 p.2 ≫ e_k ≫ p_ZL := hφ_comm p
      have h_ι : (ℓ_bar p.1 p.2).opensRange.ι = (ℓ_bar p.1 p.2).isoOpensRange.inv ≫ ℓ_bar p.1 p.2 :=
        (CategoryTheory.Iso.eq_inv_comp (ℓ_bar p.1 p.2).isoOpensRange).mpr
          (ℓ_bar p.1 p.2).isoOpensRange_hom_ι
      rw [h_ι, CategoryTheory.Category.assoc, h_u_eq, ← CategoryTheory.Category.assoc]

  
  have hSingle : ∀ α : Idx,
      ∃ (L_α : IntermediateField F k)
        (hLE_α : L₀ ≤ L_α)
        (_ : FiniteDimensional F ↥L_α),
        ∀ (L : IntermediateField F k) (hL_α : L_α ≤ L),
          letI : Algebra ↥L₀ ↥L :=
            (IntermediateField.inclusion (hLE_α.trans hL_α)).toRingHom.toAlgebra
          ∀ (B_L Y_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L)))
            (g_L : Y_L ⟶ B_L)
            (q_B : B_L.left ⟶ B₀.left) (q_Y : Y_L.left ⟶ Y₀.left)
            (p_BL : B_bar.left ⟶ B_L.left) (p_YL : Y_bar.left ⟶ Y_L.left),
            IsFieldPullbackModel ↥L₀ ↥L B₀ B_L q_B →
            IsFieldPullbackModel ↥L₀ ↥L Y₀ Y_L q_Y →
            q_Y ≫ g₀.left = g_L.left ≫ q_B →
            IsFieldPullbackModel ↥L k B_L B_bar p_BL →
            IsFieldPullbackModel ↥L k Y_L Y_bar p_YL →
            p_BL ≫ q_B = p_B₀ →
            p_YL ≫ q_Y = p_Y₀ →
            ∃ (R'_L B'_L : CommRingCat.{u})
              (h_L : R'_L)
              (ψ_BL : MvPolynomial (Fin d_B) ↥L →+* R'_L)
              (e_BL : AlgebraicGeometry.Spec R'_L ⟶ B_L.left)
              (e_YL : AlgebraicGeometry.Spec B'_L ⟶ Y_L.left)
              (q_L : AlgebraicGeometry.Spec B'_L ⟶ weilOdpModelSpec m R'_L h_L)
              (ι_R : R'_L →+* R'_k α)
              (ι_B : B'_L →+* B'_k α),
              let p_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)
              let p_B := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
              AlgebraicGeometry.Etale e_BL ∧
              AlgebraicGeometry.Etale e_YL ∧
              AlgebraicGeometry.Etale q_L ∧
              ψ_BL (MvPolynomial.X i₀) = h_L ∧
              AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BL)) ∧
              (e_BL ≫ B_L.hom =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BL) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
              (e_YL ≫ g_L.left =
                q_L ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_BL) ∧
              Function.Surjective p_R.base ∧
              p_R ≫ e_BL = e_Bk α ≫ p_BL ∧
              p_B ≫ e_YL = e_Yk α ≫ p_YL ∧
              (∀ u_bar : AlgebraicGeometry.Spec (R'_k α),
                h_k α ∈ u_bar.asIdeal ↔ h_L ∈ (p_R.base u_bar).asIdeal) ∧
              (∀ v_bar : AlgebraicGeometry.Spec (B'_k α),
                ((∀ idx : Fin (m + 1) × Fin 2,
                    Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ ((q_k α).base v_bar).asIdeal) →
                  (∀ idx : Fin (m + 1) × Fin 2,
                    Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈
                      (q_L.base (p_B.base v_bar)).asIdeal)) ∧
                (Ideal.Quotient.mk _ (MvPolynomial.C (h_k α)) ∈ ((q_k α).base v_bar).asIdeal →
                  Ideal.Quotient.mk _ (MvPolynomial.C h_L) ∈
                    (q_L.base (p_B.base v_bar)).asIdeal)) := by
    intro α
    obtain ⟨hEt_eBk, hEt_eYk, hEt_qk, hψ_Xk, hEt_ψk, heBk_hom, heYk_gbar⟩ := hRoof_k α
    let θ_qk : weilOdpModelRing (R'_k α) (h_k α) →+* B'_k α :=
      (AlgebraicGeometry.Spec.preimage (q_k α)).hom
    have hθ_qk_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_qk) = q_k α :=
      AlgebraicGeometry.Spec.map_preimage (q_k α)
    obtain ⟨L_alg, hLE_alg, hFD_alg, R'_fam, B'_fam, h_fam, ψ_fam, θ_q_fam,
      ι_R_fam, ι_Q_fam, ι_B_fam, τ_R, τ_B,
      h_s3_1, h_s3_2, h_s3_3, h_s3_4, h_s3_5, hExhaust_R, hExhaust_B⟩ :=
      s3_alg_spread_out (R'_k α) (B'_k α) (h_k α) (ψ_Bk α) (q_k α) hψ_Xk hEt_ψk hEt_qk
    have : FiniteDimensional F ↥L_alg := hFD_alg

    let ρ_Rk : k →+* R'_k α := (ψ_Bk α).comp MvPolynomial.C
    let ρ_R : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), ↥E →+* R'_fam E hE :=
      fun E hE => (ψ_fam E hE).comp MvPolynomial.C
    let c_Qk : R'_k α →+* weilOdpModelRing (R'_k α) (h_k α) :=
      (Ideal.Quotient.mk _).comp MvPolynomial.C
    let c_Q : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        R'_fam E hE →+* weilOdpModelRing (R'_fam E hE) (h_fam E hE) :=
      fun _ _ => (Ideal.Quotient.mk _).comp MvPolynomial.C
    let ρ_Qk : k →+* weilOdpModelRing (R'_k α) (h_k α) := c_Qk.comp ρ_Rk
    let ρ_Q : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        ↥E →+* weilOdpModelRing (R'_fam E hE) (h_fam E hE) :=
      fun E hE => (c_Q E hE).comp (ρ_R E hE)
    let ρ_Bk : k →+* B'_k α := θ_qk.comp ρ_Qk
    let ρ_B : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E), ↥E →+* B'_fam E hE :=
      fun E hE => (θ_q_fam E hE).comp (ρ_Q E hE)

    have hPush_R : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom (algebraMap ↥E k))
          (CommRingCat.ofHom (ρ_R E hE))
          (CommRingCat.ofHom ρ_Rk)
          (CommRingCat.ofHom (ι_R_fam E hE)) := by
      intro E hE
      have hp := (s2a_pushout_mvPoly (algebraMap ↥E k) (Fin d_B)).paste_vert (h_s3_5 E hE).1
      rwa [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at hp

    have hPush_Q : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom (algebraMap ↥E k))
          (CommRingCat.ofHom (ρ_Q E hE))
          (CommRingCat.ofHom ρ_Qk)
          (CommRingCat.ofHom (ι_Q_fam E hE)) := by
      intro E hE
      have hp := (hPush_R E hE).paste_vert (h_s3_5 E hE).2.1
      rwa [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at hp

    have hPush_B : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom (algebraMap ↥E k))
          (CommRingCat.ofHom (ρ_B E hE))
          (CommRingCat.ofHom ρ_Bk)
          (CommRingCat.ofHom (ι_B_fam E hE)) := by
      intro E hE
      have hp := (hPush_Q E hE).paste_vert (h_s3_5 E hE).2.2
      rwa [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at hp

    have hρ_R_ι : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        (ι_R_fam E hE).comp (ρ_R E hE) = ρ_Rk.comp (algebraMap ↥E k) := by
      intro E hE
      have hw := (hPush_R E hE).w.symm
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at hw
      exact congrArg CommRingCat.Hom.hom hw

    have hρ_B_ι : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        (ι_B_fam E hE).comp (ρ_B E hE) = ρ_Bk.comp (algebraMap ↥E k) := by
      intro E hE
      have hw := (hPush_B E hE).w.symm
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at hw
      exact congrArg CommRingCat.Hom.hom hw

    have hInj_R : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        Function.Injective (ι_R_fam E hE) :=
      fun E hE => ((s2c_field_descent ↥E k (algebraMap ↥E k)).2
        (CommRingCat.ofHom (ι_R_fam E hE)) (hPush_R E hE)).1

    have hInj_B : ∀ (E : IntermediateField F k) (hE : L_alg ≤ E),
        Function.Injective (ι_B_fam E hE) :=
      fun E hE => ((s2c_field_descent ↥E k (algebraMap ↥E k)).2
        (CommRingCat.ofHom (ι_B_fam E hE)) (hPush_B E hE)).1

    have heBk_ρ : e_Bk α ≫ B_bar.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_Rk) := by
      rw [heBk_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

