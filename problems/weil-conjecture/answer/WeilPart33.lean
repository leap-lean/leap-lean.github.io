            have hw₂ := congrArg (fun f => f.hom ⟨(y : κ), hmem_F_of (y : κ)⟩) (s.w i₂)
            have heq_sup : (D_fld.map i₁).hom y =
                (D_fld.map i₂).hom ⟨(y : κ), hmem_F_of (y : κ)⟩ := Subtype.ext rfl
            dsimp [CommRingCat.comp_apply] at hw₁ hw₂
            exact hw₁.symm.trans ((congrArg (s.ι.app F_sup).hom heq_sup).trans hw₂)
          CommRingCat.ofHom
            { toFun := descFun
              map_one' := by
                have h := h_indep F_bot 1
                rw [map_one] at h
                exact h.symm
              map_mul' := fun x z => by
                let _ : FiniteDimensional K_sep ↥(F_of x).1 := (F_of x).2
                let _ : FiniteDimensional K_sep ↥(F_of z).1 := (F_of z).2
                let F_xz : ℐ :=
                  ⟨(F_of x).1 ⊔ (F_of z).1,
                    IntermediateField.finiteDimensional_sup (F_of x).1 (F_of z).1⟩
                let yx : ↥F_xz.1 := ⟨x, (le_sup_left : (F_of x).1 ≤ F_xz.1) (hmem_F_of x)⟩
                let yz : ↥F_xz.1 := ⟨z, (le_sup_right : (F_of z).1 ≤ F_xz.1) (hmem_F_of z)⟩
                calc
                  descFun (x * z) = (s.ι.app F_xz).hom (yx * yz) := (h_indep F_xz (yx * yz)).symm
                  _ = (s.ι.app F_xz).hom yx * (s.ι.app F_xz).hom yz := map_mul _ _ _
                  _ = descFun x * descFun z := by rw [h_indep F_xz yx, h_indep F_xz yz]
              map_zero' := by
                have h := h_indep F_bot 0
                rw [map_zero] at h
                exact h.symm
              map_add' := fun x z => by
                let _ : FiniteDimensional K_sep ↥(F_of x).1 := (F_of x).2
                let _ : FiniteDimensional K_sep ↥(F_of z).1 := (F_of z).2
                let F_xz : ℐ :=
                  ⟨(F_of x).1 ⊔ (F_of z).1,
                    IntermediateField.finiteDimensional_sup (F_of x).1 (F_of z).1⟩
                let yx : ↥F_xz.1 := ⟨x, (le_sup_left : (F_of x).1 ≤ F_xz.1) (hmem_F_of x)⟩
                let yz : ↥F_xz.1 := ⟨z, (le_sup_right : (F_of z).1 ≤ F_xz.1) (hmem_F_of z)⟩
                calc
                  descFun (x + z) = (s.ι.app F_xz).hom (yx + yz) := (h_indep F_xz (yx + yz)).symm
                  _ = (s.ι.app F_xz).hom yx + (s.ι.app F_xz).hom yz := map_add _ _ _
                  _ = descFun x + descFun z := by rw [h_indep F_xz yx, h_indep F_xz yz] }
        fac := fun s F => by
          apply CommRingCat.hom_ext
          ext y
          let _ : FiniteDimensional K_sep ↥F.1 := F.2
          let _ : FiniteDimensional K_sep ↥(F_of (y : κ)).1 := (F_of (y : κ)).2
          let F_sup : ℐ :=
            ⟨F.1 ⊔ (F_of (y : κ)).1,
              IntermediateField.finiteDimensional_sup F.1 (F_of (y : κ)).1⟩
          let i₁ : F ⟶ F_sup := CategoryTheory.homOfLE (le_sup_left : F.1 ≤ F_sup.1)
          let i₂ : F_of (y : κ) ⟶ F_sup :=
            CategoryTheory.homOfLE (le_sup_right : (F_of (y : κ)).1 ≤ F_sup.1)
          have hw₁ := congrArg (fun f => f.hom y) (s.w i₁)
          have hw₂ := congrArg (fun f => f.hom ⟨(y : κ), hmem_F_of (y : κ)⟩) (s.w i₂)
          have heq_sup : (D_fld.map i₁).hom y =
              (D_fld.map i₂).hom ⟨(y : κ), hmem_F_of (y : κ)⟩ := Subtype.ext rfl
          exact hw₂.symm.trans ((congrArg (s.ι.app F_sup).hom heq_sup.symm).trans hw₁)
        uniq := fun s m hm => by
          apply CommRingCat.hom_ext
          ext x
          have hx := congrArg (fun f => f.hom ⟨x, hmem_F_of x⟩) (hm (F_of x))
          exact hx }
