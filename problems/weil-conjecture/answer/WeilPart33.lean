      exact hmem_iff.mp hin_spec
    have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffVpb.basicOpen δ_B
    let B_pb := ↑(Y₂.left.presheaf.obj (Opposite.op V_pb))
    let B_loc := ↑(Y₂.left.presheaf.obj (Opposite.op V))
    let res_V : B_pb →+* B_loc := (Y₂.left.presheaf.map (CategoryTheory.homOfLE hle_V).op).hom
    letI : Algebra B_pb B_loc := res_V.toAlgebra
    haveI : IsLocalization.Away δ_B B_loc := hAffVpb.isLocalization_basicOpen δ_B
    have hSm_ring : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 1)
        ((algebraMap B_pb B_loc).comp
          (π_quot.comp Algebra.TensorProduct.includeRight.toRingHom)) :=
      hδ_sm B_loc
    have hV_UP : V ≤ (TopologicalSpace.Opens.map g₂.left.base).obj U_P :=
      le_trans hle_V hVpb_UP
    have htop_UP : (⊤ : V.toScheme.Opens) ≤
        (TopologicalSpace.Opens.map (V.ι ≫ g₂.left).base).obj U_P := by
      intro z _
      exact hV_UP z.2
    have hSm_V : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left) := by
      haveI : AlgebraicGeometry.IsAffine V.toScheme := hAffV
      refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun z =>
        ⟨U_P, hAffUP, ⊤, AlgebraicGeometry.isAffineOpen_top V.toScheme, trivial, htop_UP, ?_⟩
      have happ_factor : CommRingCat.ofHom
            ((algebraMap B_pb B_loc).comp
              (π_quot.comp Algebra.TensorProduct.includeRight.toRingHom)) ≫
          V.topIso.inv =
          e_UP_cat.hom ≫ (V.ι ≫ g₂.left).appLE U_P ⊤ htop_UP := by
        have h1 : CommRingCat.ofHom
              ((algebraMap B_pb B_loc).comp
                (π_quot.comp Algebra.TensorProduct.includeRight.toRingHom)) =
            e_UP_cat.hom ≫ g₂.left.appLE U_P V_pb hVpb_UP ≫
              Y₂.left.presheaf.map (CategoryTheory.homOfLE hle_V).op := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro p
          change res_V (π_quot (TensorProduct.tmul k 1 p)) =
            res_V ((g₂.left.appLE U_P V_pb hVpb_UP).hom (e_UP_cat.hom.hom p))
          rw [hg₂_app p]
        rw [h1, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        congr 1
        have h2 : g₂.left.appLE U_P V_pb hVpb_UP ≫
            Y₂.left.presheaf.map (CategoryTheory.homOfLE hle_V).op =
