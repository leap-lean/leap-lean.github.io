      let e_alg := polyEquivTensor' R C
      change CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom))
            (AlgebraicGeometry.pullbackSpecIso R C (Polynomial R)).inv)
