        have hbase_mod : q_𝔭.comp ρ_B = (((q_𝔭.comp i_Z).comp φ).comp MvPolynomial.C).comp ev_w := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
