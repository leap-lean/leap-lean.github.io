        (CategoryTheory.ShortComplex.mk (j s) (p s) (hjp s))
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel
          (CategoryTheory.ShortComplex.mk (j s) (p s) (hjp s))
          (CategoryTheory.Limits.cokernelIsCokernel (j s)))
        inferInstance inferInstance
    have hSubOfIso : ∀ {A₁ A₂ : 𝒞_B} (e : A₁ ≅ A₂) (r : ℕ),
