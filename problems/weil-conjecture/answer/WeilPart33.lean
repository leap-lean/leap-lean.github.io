  have hModNsmulId : ∀ (ℱ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))) (k : ℕ) (opV : S.Etaleᵒᵖ)
      (x : ↥(ℱ.obj.obj opV)),
      (((k • 𝟙 ℱ).hom).app opV) x = k • x := by
    intro ℱ k opV x
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul]
      change (((m • 𝟙 ℱ).hom).app opV) x + x = m • x + x
      rw [ih]

  have hModNZero : ∀ (ℱ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))), n • 𝟙 ℱ = 0 := by
    intro ℱ
    apply ObjectProperty.hom_ext
    apply NatTrans.ext
    funext opV
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    change (((n • 𝟙 ℱ).hom).app opV) x = 0
    rw [hModNsmulId ℱ n opV x, ← natCast_zsmul, hIntSmulEq (n : ℤ) x,
      Int.cast_natCast, CharP.cast_eq_zero]
    change (0 : R) • x = 0
    exact zero_smul R x

  have hAbNsmulId : ∀ (𝒢 : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (k : ℕ) (opW : Z.Etaleᵒᵖ)
      (x : ↥(𝒢.obj.obj opW)),
      (((k • 𝟙 𝒢).hom).app opW) x = k • x := by
    intro 𝒢 k opW x
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul]
      change (((m • 𝟙 𝒢).hom).app opW) x + x = m • x + x
      rw [ih]

  have hPullZTors : ∀ (ℱ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))) (opW : Z.Etaleᵒᵖ)
      (x : ↥((P_pull_ℤ.obj (U_std_S.obj ℱ)).obj.obj opW)),
      (n : ℤ) • x = 0 := by
    intro ℱ opW x
    rw [natCast_zsmul]
    have h0 : n • 𝟙 (P_pull_ℤ.obj (U_std_S.obj ℱ)) = 0 := by
      rw [← P_pull_ℤ.map_id, ← U_std_S.map_id, ← P_pull_ℤ.map_nsmul, ← U_std_S.map_nsmul,
        hModNZero ℱ, U_std_S.map_zero, P_pull_ℤ.map_zero]
    rw [← hAbNsmulId (P_pull_ℤ.obj (U_std_S.obj ℱ)) n opW x, h0]
    rfl

  let mkTorsMod : ∀ (G₀ : AddCommGrpCat.{u}),
      (∀ x : ↥G₀, (n : ℤ) • x = 0) → ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)) :=
    fun G₀ htors =>
      have h_int_eq : ∀ (a₁ b₁ : ℤ) (x : ↥G₀),
          (a₁ : ZMod n) = (b₁ : ZMod n) → a₁ • x = b₁ • x := by
        intro a₁ b₁ x hab
        obtain ⟨k, hk⟩ := (ZMod.intCast_eq_intCast_iff_dvd_sub a₁ b₁ n).mp hab
        have hsub : (b₁ - a₁) • x = 0 := by
          rw [hk, mul_comm, mul_zsmul, htors x, zsmul_zero]
        rw [sub_zsmul, ← sub_eq_add_neg] at hsub
        exact (sub_eq_zero.mp hsub).symm
      letI : Module (ULift.{u, 0} (ZMod n)) ↥G₀ :=
        { smul := fun r x => (r.down.valMinAbs : ℤ) • x
          one_smul := fun x => by
            have h1 : (((1 : ULift.{u, 0} (ZMod n)).down.valMinAbs : ℤ) : ZMod n) =
                ((1 : ℤ) : ZMod n) := by
              rw [ZMod.coe_valMinAbs, Int.cast_one]; rfl
            exact (h_int_eq _ 1 x h1).trans (one_zsmul x)
          mul_smul := fun r s x => by
            have hm : (((r * s).down.valMinAbs : ℤ) : ZMod n) =
                ((r.down.valMinAbs * s.down.valMinAbs : ℤ) : ZMod n) := by
              rw [ZMod.coe_valMinAbs, Int.cast_mul, ZMod.coe_valMinAbs, ZMod.coe_valMinAbs]; rfl
            exact (h_int_eq _ _ x hm).trans (mul_zsmul x _ _)
          smul_zero := fun r => zsmul_zero _
          smul_add := fun r x y => zsmul_add x y _
          add_smul := fun r s x => by
            have ha : (((r + s).down.valMinAbs : ℤ) : ZMod n) =
                ((r.down.valMinAbs + s.down.valMinAbs : ℤ) : ZMod n) := by
              rw [ZMod.coe_valMinAbs, Int.cast_add, ZMod.coe_valMinAbs, ZMod.coe_valMinAbs]; rfl
            exact (h_int_eq _ _ x ha).trans (add_zsmul x _ _)
          zero_smul := fun x => by
            have hz : (((0 : ULift.{u, 0} (ZMod n)).down.valMinAbs : ℤ) : ZMod n) =
                ((0 : ℤ) : ZMod n) := by
              rw [ZMod.coe_valMinAbs, Int.cast_zero]; rfl
            exact (h_int_eq _ 0 x hz).trans (zero_zsmul x) }
      ModuleCat.of (ULift.{u, 0} (ZMod n)) ↥G₀

  let pullPreR : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) →
      (Z.Etaleᵒᵖ ⥤ ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) :=
    fun ℱ =>
      { obj := fun opW => mkTorsMod _ (hPullZTors ℱ opW)
        map := fun {opW₁ opW₂} f =>
          ffFgtMod.preimage (X := mkTorsMod _ (hPullZTors ℱ opW₁))
            (Y := mkTorsMod _ (hPullZTors ℱ opW₂))
            ((P_pull_ℤ.obj (U_std_S.obj ℱ)).obj.map f)
        map_id := fun opW => ffFgtMod.map_injective (by
          rw [ffFgtMod.map_preimage, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
          rfl)
        map_comp := fun f g => ffFgtMod.map_injective (by
          rw [ffFgtMod.map_preimage, CategoryTheory.Functor.map_comp,
            CategoryTheory.Functor.map_comp, ffFgtMod.map_preimage, ffFgtMod.map_preimage]) }

  have hPullPreR_map : ∀ (ℱ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))))
      {opW₁ opW₂ : Z.Etaleᵒᵖ} (f : opW₁ ⟶ opW₂),
      FgtMod.map ((pullPreR ℱ).map f) = (P_pull_ℤ.obj (U_std_S.obj ℱ)).obj.map f :=
    fun ℱ {opW₁ opW₂} f =>
      ffFgtMod.map_preimage (X := (pullPreR ℱ).obj opW₁) (Y := (pullPreR ℱ).obj opW₂)
        ((P_pull_ℤ.obj (U_std_S.obj ℱ)).obj.map f)

  have hPullPreR_sheaf : ∀ (ℱ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))),
      Presheaf.IsSheaf Z.smallEtaleTopology (pullPreR ℱ) := by
    intro ℱ E W S_sieve hS_sieve x_fam hx_compat
    let G_sh : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := P_pull_ℤ.obj (U_std_S.obj ℱ)
    have hG_for : Presieve.IsSheafFor
        (G_sh.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E))) S_sieve.arrows :=
      G_sh.property (FgtMod.obj E) S_sieve hS_sieve
    let y_fam : Presieve.FamilyOfElements
        (G_sh.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E))) S_sieve.arrows :=
      fun Y f hf => FgtMod.map (x_fam f hf)
    have hy_compat : y_fam.Compatible := by
      intro Y₁ Y₂ Z_c g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hx : x_fam f₁ hf₁ ≫ (pullPreR ℱ).map g₁.op =
          x_fam f₂ hf₂ ≫ (pullPreR ℱ).map g₂.op :=
        hx_compat g₁ g₂ hf₁ hf₂ hcomm
      have hmap := congrArg FgtMod.map hx
      rw [FgtMod.map_comp, FgtMod.map_comp] at hmap
      change y_fam f₁ hf₁ ≫ G_sh.obj.map g₁.op = y_fam f₂ hf₂ ≫ G_sh.obj.map g₂.op
      rw [← hPullPreR_map ℱ g₁.op, ← hPullPreR_map ℱ g₂.op]
      exact hmap
    let g_glue : FgtMod.obj E ⟶ FgtMod.obj ((pullPreR ℱ).obj (Opposite.op W)) :=
      hG_for.amalgamate y_fam hy_compat
    refine ⟨ffFgtMod.preimage g_glue, ?_, ?_⟩
    · intro Y f hf
      apply ffFgtMod.map_injective
      change FgtMod.map (ffFgtMod.preimage g_glue ≫ (pullPreR ℱ).map f.op) = y_fam f hf
      rw [FgtMod.map_comp, ffFgtMod.map_preimage g_glue, hPullPreR_map ℱ f.op]
      exact hG_for.isAmalgamation hy_compat f hf
    · intro m hm
      have hm_y : y_fam.IsAmalgamation (FgtMod.map m) := by
        intro Y f hf
        change FgtMod.map m ≫ G_sh.obj.map f.op = FgtMod.map (x_fam f hf)
        rw [← hPullPreR_map ℱ f.op, ← FgtMod.map_comp]
        exact congrArg FgtMod.map (hm f hf)
      apply ffFgtMod.map_injective
      rw [ffFgtMod.map_preimage g_glue]
      exact hG_for.isSeparatedFor y_fam (FgtMod.map m) g_glue
        hm_y (hG_for.isAmalgamation hy_compat)

  let pullMapAppℤ : ∀ {ℱ₁ ℱ₂ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))}
      (u : ℱ₁ ⟶ ℱ₂) (opW : Z.Etaleᵒᵖ),
      FgtMod.obj ((pullPreR ℱ₁).obj opW) ⟶ FgtMod.obj ((pullPreR ℱ₂).obj opW) :=
    fun u opW => ((P_pull_ℤ.map (U_std_S.map u)).hom).app opW

  let P_pull_R : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) ⥤
      Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) :=
    { obj := fun ℱ => ⟨pullPreR ℱ, hPullPreR_sheaf ℱ⟩
      map := fun {ℱ₁ ℱ₂} u =>
        { hom :=
            { app := fun opW => ffFgtMod.preimage (pullMapAppℤ u opW)
              naturality := fun {opW₁ opW₂} f => ffFgtMod.map_injective (by
                dsimp only
                rw [FgtMod.map_comp, FgtMod.map_comp, hPullPreR_map ℱ₁ f,
                  ffFgtMod.map_preimage (pullMapAppℤ u opW₂),
                  ffFgtMod.map_preimage (pullMapAppℤ u opW₁), hPullPreR_map ℱ₂ f]
                exact ((P_pull_ℤ.map (U_std_S.map u)).hom).naturality f) } }
      map_id := fun ℱ => by
        apply CategoryTheory.Sheaf.hom_ext
        apply NatTrans.ext
        funext opW
        apply ffFgtMod.map_injective
        change FgtMod.map (ffFgtMod.preimage (pullMapAppℤ (𝟙 ℱ) opW)) =
          FgtMod.map (𝟙 ((pullPreR ℱ).obj opW))
        rw [ffFgtMod.map_preimage (pullMapAppℤ (𝟙 ℱ) opW), FgtMod.map_id]
        change ((P_pull_ℤ.map (U_std_S.map (𝟙 ℱ))).hom).app opW = _
        rw [U_std_S.map_id, P_pull_ℤ.map_id]
        rfl
      map_comp := fun {ℱ₁ ℱ₂ ℱ₃} u v => by
        apply CategoryTheory.Sheaf.hom_ext
        apply NatTrans.ext
        funext opW
        apply ffFgtMod.map_injective
        change FgtMod.map (ffFgtMod.preimage (pullMapAppℤ (u ≫ v) opW)) =
          FgtMod.map (ffFgtMod.preimage (pullMapAppℤ u opW) ≫
            ffFgtMod.preimage (pullMapAppℤ v opW))
        rw [FgtMod.map_comp, ffFgtMod.map_preimage (pullMapAppℤ (u ≫ v) opW),
          ffFgtMod.map_preimage (pullMapAppℤ u opW),
          ffFgtMod.map_preimage (pullMapAppℤ v opW)]
        change ((P_pull_ℤ.map (U_std_S.map (u ≫ v))).hom).app opW = _
        rw [U_std_S.map_comp, P_pull_ℤ.map_comp]
        rfl }

  have hPullR_obj : ∀ ℱ, (P_pull_R ⋙ U_std_Z).obj ℱ = (U_std_S ⋙ P_pull_ℤ).obj ℱ := fun ℱ => by
    apply ObjectProperty.FullSubcategory.ext
    refine CategoryTheory.Functor.ext (fun _ => rfl) (fun _ _ f => ?_)
    exact (hPullPreR_map ℱ f).trans
      ((Category.comp_id _).symm.trans (Category.id_comp _).symm)
  have hPullR_comp_UZ : P_pull_R ⋙ U_std_Z = U_std_S ⋙ P_pull_ℤ := by
    refine CategoryTheory.Functor.ext hPullR_obj (fun ℱ₁ ℱ₂ u => ?_)
    apply CategoryTheory.Sheaf.hom_ext
    apply NatTrans.ext
    funext opW
    exact hSheafHeq (hPullR_obj ℱ₁) (hPullR_obj ℱ₂) opW _ _
      (heq_of_eq (ffFgtMod.map_preimage (pullMapAppℤ u opW)))

  have : P_pull_R.Additive :=
    { map_add := fun {ℱ₁ ℱ₂} {u v} => ffUZ.map_injective (by
        rw [U_std_Z.map_add]
        apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext opW
        change FgtMod.map (ffFgtMod.preimage (pullMapAppℤ (u + v) opW)) =
          FgtMod.map (ffFgtMod.preimage (pullMapAppℤ u opW)) +
            FgtMod.map (ffFgtMod.preimage (pullMapAppℤ v opW))
        rw [ffFgtMod.map_preimage, ffFgtMod.map_preimage, ffFgtMod.map_preimage]
        change ((P_pull_ℤ.map (U_std_S.map (u + v))).hom).app opW = _
        rw [U_std_S.map_add, P_pull_ℤ.map_add]
        rfl) }

  have : Limits.PreservesFiniteLimits (P_pull_R ⋙ U_std_Z) := by
    rw [hPullR_comp_UZ]; infer_instance
  have : Limits.PreservesFiniteColimits (P_pull_R ⋙ U_std_Z) := by
    rw [hPullR_comp_UZ]; infer_instance
  have : Limits.PreservesFiniteLimits P_pull_R :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves P_pull_R U_std_Z
  have : Limits.PreservesFiniteColimits P_pull_R :=
    Limits.preservesFiniteColimits_of_reflects_of_preserves P_pull_R U_std_Z

  
  let isoPullUZ : ∀ ℱ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))),
      U_std_Z.obj (P_pull_R.obj ℱ) ≅ P_pull_ℤ.obj (U_std_S.obj ℱ) :=
    fun ℱ => eqToIso (CategoryTheory.Functor.congr_obj hPullR_comp_UZ ℱ)
  let isoPushUZ : ∀ 𝒢 : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))),
      P_push_ℤ.obj (U_std_Z.obj 𝒢) ≅ U_std_S.obj (P_push_R.obj 𝒢) :=
    fun _ => eqToIso rfl
  let adj_pull_R : P_pull_R ⊣ P_push_R :=
    Adjunction.mkOfHomEquiv
      { homEquiv := fun ℱ 𝒢 =>
          (ffUZ.homEquiv (X := P_pull_R.obj ℱ) (Y := 𝒢)).trans
            ((Iso.homCongr (isoPullUZ ℱ) (Iso.refl (U_std_Z.obj 𝒢))).trans
              ((adj_pull_ℤ.homEquiv (U_std_S.obj ℱ) (U_std_Z.obj 𝒢)).trans
                ((Iso.homCongr (Iso.refl (U_std_S.obj ℱ)) (isoPushUZ 𝒢)).trans
                  (ffUS.homEquiv (X := ℱ) (Y := P_push_R.obj 𝒢)).symm)))
        homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} f g => by
          apply ffUZ.map_injective
          simp only [Equiv.symm_trans_apply, Equiv.symm_symm, Iso.homCongr_symm, Iso.refl_symm,
            Iso.homCongr_apply, Iso.refl_hom, Iso.refl_inv, Iso.symm_hom, Iso.symm_inv,
            Category.comp_id, Category.id_comp,
            Functor.FullyFaithful.homEquiv_apply, Functor.FullyFaithful.homEquiv_symm_apply,
            Functor.FullyFaithful.map_preimage, U_std_Z.map_comp]
          have hnat_f := CategoryTheory.Functor.congr_hom hPullR_comp_UZ f
          dsimp only [Functor.comp_obj, Functor.comp_map] at hnat_f
          rw [hnat_f]
          have hadj := adj_pull_ℤ.homEquiv_naturality_left_symm (U_std_S.map f)
            (U_std_S.map g ≫ (isoPushUZ 𝒢).inv)
          have hg_comp : U_std_S.map (f ≫ g) ≫ (isoPushUZ 𝒢).inv =
              U_std_S.map f ≫ U_std_S.map g ≫ (isoPushUZ 𝒢).inv := by
            rw [U_std_S.map_comp, Category.assoc]
          rw [hg_comp, hadj]
          simp only [isoPullUZ, eqToIso.hom, Category.assoc,
            eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
          rfl
        homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} f g => by
          apply ffUS.map_injective
          simp only [Equiv.trans_apply, Iso.homCongr_apply, Iso.refl_hom,
            Category.comp_id,
            Functor.FullyFaithful.homEquiv_apply, Functor.FullyFaithful.homEquiv_symm_apply,
            Functor.FullyFaithful.map_preimage, U_std_S.map_comp, U_std_Z.map_comp,
            ← Category.assoc, adj_pull_ℤ.homEquiv_naturality_right]
          simp only [Category.assoc]
          congr 1 }

  have : P_push_R.Additive :=
    { map_add := fun {_ _} {_ _} =>
        CategoryTheory.Sheaf.hom_ext (NatTrans.ext (funext fun _ => rfl)) }
  have : P_push_R.IsRightAdjoint := adj_pull_R.isRightAdjoint
  have : Limits.PreservesFiniteLimits P_push_R := inferInstance
  have : Limits.PreservesFiniteColimits P_push_R := by
    rw [Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi]
    intro SC hSC
    have : Epi SC.g := hSC.epi_g
    exact ⟨hSC.exact.map_of_mono_of_preservesKernel P_push_R hSC.mono_f inferInstance,
      hPushEpi SC.g⟩

  
  let π_R : P_pull_R.obj oneR_S ⟶ oneR_Z := (adj_pull_R.homEquiv oneR_S oneR_Z).symm ρ
  have hadjR_πR : adj_pull_R.homEquiv oneR_S oneR_Z π_R = ρ :=
    Equiv.apply_symm_apply _ _
  have hIsIsoOfHeqId : ∀ {X₁ X₂ : Scheme.{u}} (_ : X₁ = X₂) (f : X₁ ⟶ X₂),
      HEq f (𝟙 X₂) → IsIso f := by
    rintro X₁ _ rfl f hf
    rw [eq_of_heq hf]
    infer_instance
  have : IsIso T_S.hom := hIsIsoOfHeqId hTS_left T_S.hom hTS_hom
  have hBT_S : Limits.IsTerminal (B.obj T_S) :=
    Limits.IsTerminal.ofUniqueHom
      (fun W => MorphismProperty.Over.homMk
        (Limits.pullback.lift ((W.hom ≫ i) ≫ inv T_S.hom) W.hom
          (by simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id]))
        (Limits.pullback.lift_snd _ _ _)
        trivial)
      (fun W m => by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · refine ((cancel_mono T_S.hom).mp ?_).trans (Limits.pullback.lift_fst _ _ _).symm
          have hp_cond : Limits.pullback.fst T_S.hom i ≫ T_S.hom =
              Limits.pullback.snd T_S.hom i ≫ i :=
            (IsPullback.of_hasPullback T_S.hom i).w
          have hm_w : m.left ≫ Limits.pullback.snd T_S.hom i = W.hom :=
            MorphismProperty.Over.w m
          calc
            (m.left ≫ Limits.pullback.fst T_S.hom i) ≫ T_S.hom
              = m.left ≫ (Limits.pullback.fst T_S.hom i ≫ T_S.hom) := Category.assoc _ _ _
            _ = m.left ≫ (Limits.pullback.snd T_S.hom i ≫ i) := congrArg (m.left ≫ ·) hp_cond
            _ = (m.left ≫ Limits.pullback.snd T_S.hom i) ≫ i := (Category.assoc _ _ _).symm
            _ = W.hom ≫ i := congrArg (· ≫ i) hm_w
            _ = ((W.hom ≫ i) ≫ inv T_S.hom) ≫ T_S.hom := by
                simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id]
        · exact (MorphismProperty.Over.w m).trans (Limits.pullback.lift_snd _ _ _).symm)

  let adjR_S := constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) hT_S
  let adjR_BT := constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) hBT_S
  have hConstUnit : ∀ {X : Scheme.{u}} {D_cat : Type (u + 1)} [Category.{u, u + 1} D_cat]
      [HasWeakSheafify X.smallEtaleTopology D_cat]
      {T_X : X.Etale} (hT_X : Limits.IsTerminal T_X) (A₀ : D_cat),
      (constantSheafAdj X.smallEtaleTopology D_cat hT_X).unit.app A₀ =
        ((sheafificationAdjunction X.smallEtaleTopology D_cat).unit.app
          ((Functor.const X.Etaleᵒᵖ).obj A₀)).app (Opposite.op T_X) := by
    intro X D_cat _ _ T_X hT_X A₀
    change ((constantPresheafAdj D_cat hT_X).comp
      (sheafificationAdjunction X.smallEtaleTopology D_cat)).unit.app A₀ = _
    rw [Adjunction.comp_unit_app, constantPresheafAdj_unit_app, Category.id_comp]
    rfl
  have hConstHomEquiv : ∀ {X : Scheme.{u}} {D_cat : Type (u + 1)} [Category.{u, u + 1} D_cat]
      [HasWeakSheafify X.smallEtaleTopology D_cat]
      {T_X : X.Etale} (hT_X : Limits.IsTerminal T_X) (A₀ : D_cat)
      (𝒢 : Sheaf X.smallEtaleTopology D_cat)
      (f : (constantSheaf X.smallEtaleTopology D_cat).obj A₀ ⟶ 𝒢),
      (constantSheafAdj X.smallEtaleTopology D_cat hT_X).homEquiv A₀ 𝒢 f =
        ((sheafificationAdjunction X.smallEtaleTopology D_cat).unit.app
          ((Functor.const X.Etaleᵒᵖ).obj A₀)).app (Opposite.op T_X) ≫
          f.hom.app (Opposite.op T_X) := by
    intro X D_cat _ _ T_X hT_X A₀ 𝒢 f
    rw [Adjunction.homEquiv_unit, hConstUnit hT_X A₀]
    rfl

  let isoSecBT : ∀ 𝒢 : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))),
      ((sheafSections S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).obj
        (Opposite.op T_S)).obj (P_push_R.obj 𝒢) ≅
      ((sheafSections Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).obj
        (Opposite.op (B.obj T_S))).obj 𝒢 :=
    fun _ => eqToIso rfl
  let pullUnitEquiv : ∀ (𝒢 : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))),
      (P_pull_R.obj oneR_S ⟶ 𝒢) ≃ (oneR_Z ⟶ 𝒢) :=
    fun 𝒢 =>
      (adj_pull_R.homEquiv oneR_S 𝒢).trans
        ((adjR_S.homEquiv M_R (P_push_R.obj 𝒢)).trans
          ((Iso.homCongr (Iso.refl M_R) (isoSecBT 𝒢)).trans
            (adjR_BT.homEquiv M_R 𝒢).symm))
  have hpullUnit_nat : ∀ {𝒢₁ 𝒢₂ : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))}
      (u : P_pull_R.obj oneR_S ⟶ 𝒢₁) (f : 𝒢₁ ⟶ 𝒢₂),
      pullUnitEquiv 𝒢₂ (u ≫ f) = pullUnitEquiv 𝒢₁ u ≫ f := by
    intro 𝒢₁ 𝒢₂ u f
    apply (adjR_BT.homEquiv M_R 𝒢₂).injective
    simp only [pullUnitEquiv, Equiv.trans_apply, Iso.homCongr_apply,
      Equiv.apply_symm_apply, adj_pull_R.homEquiv_naturality_right,
      adjR_S.homEquiv_naturality_right, adjR_BT.homEquiv_naturality_right, Category.assoc]
    congr 1
  have hpullUnit_πR : pullUnitEquiv oneR_Z π_R = 𝟙 oneR_Z := by
    apply (adjR_BT.homEquiv M_R oneR_Z).injective
    dsimp only [pullUnitEquiv, Equiv.trans_apply, Iso.homCongr_apply, Iso.refl_hom, Category.id_comp]
    rw [Equiv.apply_symm_apply, hadjR_πR,
      hConstHomEquiv hT_S M_R (P_push_R.obj oneR_Z) ρ,
      hConstHomEquiv hBT_S M_R oneR_Z (𝟙 oneR_Z)]
    change (ηS_app T_S ≫ ρ_app T_S) ≫ 𝟙 _ = ηZ_app (B.obj T_S) ≫ 𝟙 _
    rw [hρ_app T_S]
  let ι_R : oneR_Z ⟶ P_pull_R.obj oneR_S :=
    pullUnitEquiv (P_pull_R.obj oneR_S) (𝟙 (P_pull_R.obj oneR_S))
  have hιπ_R : ι_R ≫ π_R = 𝟙 oneR_Z := by
    have h := hpullUnit_nat (𝟙 (P_pull_R.obj oneR_S)) π_R
    rw [Category.id_comp, hpullUnit_πR] at h
    exact h.symm
  have hπι_R : π_R ≫ ι_R = 𝟙 (P_pull_R.obj oneR_S) := by
    apply (pullUnitEquiv (P_pull_R.obj oneR_S)).injective
    rw [hpullUnit_nat π_R ι_R, hpullUnit_πR, Category.id_comp]

  
  have hExtMapId : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜] [Abelian 𝒜]
      [HasExt.{u} 𝒜] [EnoughInjectives 𝒜]
      (k : ℕ) {X Y : 𝒜} (x : Abelian.Ext.{u} X Y k),
      Abelian.Ext.mapExactFunctor (Functor.id 𝒜) x = x := by
    intro 𝒜 _ _ _ _ k
    induction k with
    | zero =>
      intro X Y x
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective X Y).2 x
      rw [Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ r ih =>
      intro X Y x
      let I : 𝒜 := Injective.under Y
      let ι : Y ⟶ I := Injective.ι Y
      let π_c : I ⟶ Limits.cokernel ι := Limits.cokernel.π ι
      let SC : ShortComplex 𝒜 := ShortComplex.mk ι π_c (Limits.cokernel.condition ι)
      have hSC : SC.ShortExact :=
        { exact := ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      have hx_ι : x.comp (Abelian.Ext.mk₀ ι) (Nat.add_zero (r + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hSC x hx_ι rfl
      rw [Abelian.Ext.mapExactFunctor_comp, ih y, Abelian.Ext.mapExactFunctor_extClass]

  have hExtMapComp : ∀ {𝒜₁ 𝒜₂ 𝒜₃ : Type (u + 1)}
      [Category.{u + 1, u + 1} 𝒜₁] [Abelian 𝒜₁] [HasExt.{u} 𝒜₁] [EnoughInjectives 𝒜₁]
      [Category.{u + 1, u + 1} 𝒜₂] [Abelian 𝒜₂] [HasExt.{u} 𝒜₂]
      [Category.{u + 1, u + 1} 𝒜₃] [Abelian 𝒜₃] [HasExt.{u} 𝒜₃]
      (F₁ : 𝒜₁ ⥤ 𝒜₂) [F₁.Additive] [Limits.PreservesFiniteLimits F₁] [Limits.PreservesFiniteColimits F₁]
      (F₂ : 𝒜₂ ⥤ 𝒜₃) [F₂.Additive] [Limits.PreservesFiniteLimits F₂] [Limits.PreservesFiniteColimits F₂]
      (k : ℕ) {X Y : 𝒜₁} (x : Abelian.Ext.{u} X Y k),
      Abelian.Ext.mapExactFunctor (F₁ ⋙ F₂) x =
        Abelian.Ext.mapExactFunctor F₂ (Abelian.Ext.mapExactFunctor F₁ x) := by
    intro 𝒜₁ 𝒜₂ 𝒜₃ _ _ _ _ _ _ _ _ _ _ F₁ _ _ _ F₂ _ _ _ k
    induction k with
    | zero =>
      intro X Y x
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective X Y).2 x
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ r ih =>
      intro X Y x
      let I : 𝒜₁ := Injective.under Y
      let ι : Y ⟶ I := Injective.ι Y
      let π_c : I ⟶ Limits.cokernel ι := Limits.cokernel.π ι
      let SC : ShortComplex 𝒜₁ := ShortComplex.mk ι π_c (Limits.cokernel.condition ι)
      have hSC : SC.ShortExact :=
        { exact := ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      have hx_ι : x.comp (Abelian.Ext.mk₀ ι) (Nat.add_zero (r + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hSC x hx_ι rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, ih y, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]

  have hExtNat : ∀ {𝒜₁ 𝒜₂ : Type (u + 1)}
      [Category.{u + 1, u + 1} 𝒜₁] [Abelian 𝒜₁] [HasExt.{u} 𝒜₁] [EnoughInjectives 𝒜₁]
      [Category.{u + 1, u + 1} 𝒜₂] [Abelian 𝒜₂] [HasExt.{u} 𝒜₂]
      {F G : 𝒜₁ ⥤ 𝒜₂}
      [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (α : F ⟶ G) (k : ℕ) {X Y : 𝒜₁} (x : Abelian.Ext.{u} X Y k),
      (Abelian.Ext.mk₀ (α.app X)).comp (Abelian.Ext.mapExactFunctor G x) (Nat.zero_add k) =
        (Abelian.Ext.mapExactFunctor F x).comp (Abelian.Ext.mk₀ (α.app Y)) (Nat.add_zero k) := by
    intro 𝒜₁ 𝒜₂ _ _ _ _ _ _ _ F G _ _ _ _ _ _ α k
    induction k with
    | zero =>
      intro X Y x
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective X Y).2 x
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, α.naturality f]
    | succ r ih =>
      intro X Y x
      let I : 𝒜₁ := Injective.under Y
      let ι : Y ⟶ I := Injective.ι Y
      let Q : 𝒜₁ := Limits.cokernel ι
      let π_c : I ⟶ Q := Limits.cokernel.π ι
      let SC : ShortComplex 𝒜₁ := ShortComplex.mk ι π_c (Limits.cokernel.condition ι)
      have hSC : SC.ShortExact :=
        { exact := ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      have hx_ι : x.comp (Abelian.Ext.mk₀ ι) (Nat.add_zero (r + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hSC x hx_ι rfl
      have hF_SC : (SC.map F).ShortExact := hSC.map_of_exact F
      have hG_SC : (SC.map G).ShortExact := hSC.map_of_exact G
      let φ_SC : SC.map F ⟶ SC.map G :=
        { τ₁ := α.app Y
          τ₂ := α.app I
          τ₃ := α.app Q
          comm₁₂ := (α.naturality ι).symm
          comm₂₃ := (α.naturality π_c).symm }
      have hnat_ext := ShortComplex.ShortExact.extClass_naturality hF_SC hG_SC φ_SC
      change hF_SC.extClass.comp (Abelian.Ext.mk₀ (α.app Y)) (Nat.add_zero 1) =
        (Abelian.Ext.mk₀ (α.app Q)).comp hG_SC.extClass (Nat.zero_add 1) at hnat_ext
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]
      calc
        (Abelian.Ext.mk₀ (α.app X)).comp
            ((Abelian.Ext.mapExactFunctor G y).comp hG_SC.extClass rfl) (Nat.zero_add (r + 1))
          = ((Abelian.Ext.mk₀ (α.app X)).comp (Abelian.Ext.mapExactFunctor G y) (Nat.zero_add r)).comp
              hG_SC.extClass rfl := by
            exact (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (α.app X))
              (Abelian.Ext.mapExactFunctor G y) hG_SC.extClass
              (Nat.zero_add r) rfl (by omega)).symm
        _ = ((Abelian.Ext.mapExactFunctor F y).comp (Abelian.Ext.mk₀ (α.app Q)) (Nat.add_zero r)).comp
              hG_SC.extClass rfl := by rw [ih y]
        _ = (Abelian.Ext.mapExactFunctor F y).comp
              ((Abelian.Ext.mk₀ (α.app Q)).comp hG_SC.extClass (Nat.zero_add 1)) rfl := by
            exact Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor F y)
              (Abelian.Ext.mk₀ (α.app Q)) hG_SC.extClass
              (Nat.add_zero r) (Nat.zero_add 1) (by omega)
        _ = (Abelian.Ext.mapExactFunctor F y).comp
              (hF_SC.extClass.comp (Abelian.Ext.mk₀ (α.app Y)) (Nat.add_zero 1)) rfl := by
            rw [← hnat_ext]
        _ = ((Abelian.Ext.mapExactFunctor F y).comp hF_SC.extClass rfl).comp
              (Abelian.Ext.mk₀ (α.app Y)) (Nat.add_zero (r + 1)) := by
            exact (Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor F y)
              hF_SC.extClass (Abelian.Ext.mk₀ (α.app Y))
              rfl (Nat.add_zero 1) (by omega)).symm

  
  let p_R_a : weilCupPDModH Z n q₁ :=
    ((Abelian.Ext.mk₀ ι_R).comp (Abelian.Ext.mapExactFunctor P_pull_R a)
      (Nat.zero_add q₁)).comp (Abelian.Ext.mk₀ π_R) (Nat.add_zero q₁)

  let Cℤ_S := constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let Cℤ_Z := constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
  let ιM_hom : AM ⟶ FgtMod.obj M_R := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιℤ_hom : Aℤ ⟶ FgtMod.obj M_R :=
    (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
      Aℤ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)) ≫
      (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod n))) ≫
        ιM_hom)
  let adjℤ_S := constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
  let adjℤ_Z := constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
  let adjR_Z := constantSheafAdj Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) hT_Z
  let ηℤ_S : Cℤ_S.obj Aℤ ⟶ U_std_S.obj oneR_S :=
    (adjℤ_S.homEquiv Aℤ (U_std_S.obj oneR_S)).symm
      (ιℤ_hom ≫ FgtMod.map (adjR_S.unit.app M_R))
  let αM_S : Cℤ_S.obj AM ⟶ U_std_S.obj oneR_S :=
    (adjℤ_S.homEquiv AM (U_std_S.obj oneR_S)).symm
      (ιM_hom ≫ FgtMod.map (adjR_S.unit.app M_R))
  let ηℤ_Z : Cℤ_Z.obj Aℤ ⟶ U_std_Z.obj oneR_Z :=
    (adjℤ_Z.homEquiv Aℤ (U_std_Z.obj oneR_Z)).symm
      (ιℤ_hom ≫ FgtMod.map (adjR_Z.unit.app M_R))
  let αM_Z : Cℤ_Z.obj AM ⟶ U_std_Z.obj oneR_Z :=
    (adjℤ_Z.homEquiv AM (U_std_Z.obj oneR_Z)).symm
      (ιM_hom ≫ FgtMod.map (adjR_Z.unit.app M_R))

  let adjℤ_hp₁ := constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT₁_hp
  let adjℤ_hp₂ := constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT₂_hp
  let τ_hp : B.obj T₂_hp ⟶ T₁_hp := hT₁_hp.from (B.obj T₂_hp)
  let πA_hp : ∀ (A₀ : AddCommGrpCat.{u}), P_pull_ℤ.obj (Cℤ_S.obj A₀) ⟶ Cℤ_Z.obj A₀ :=
    fun A₀ =>
      (adj_pull_ℤ.homEquiv (Cℤ_S.obj A₀) (Cℤ_Z.obj A₀)).symm
        ((adjℤ_hp₂.homEquiv A₀ (P_push_ℤ.obj (Cℤ_Z.obj A₀))).symm
          (adjℤ_hp₁.unit.app A₀ ≫ (Cℤ_Z.obj A₀).obj.map τ_hp.op))

  let u_pull_nat : P_pull_R ⋙ U_std_Z ⟶ U_std_S ⋙ P_pull_ℤ := (eqToIso hPullR_comp_UZ).hom
  let u_pull : U_std_Z.obj (P_pull_R.obj oneR_S) ⟶ P_pull_ℤ.obj (U_std_S.obj oneR_S) :=
    u_pull_nat.app oneR_S
  let u_pull_inv : P_pull_ℤ.obj (U_std_S.obj oneR_S) ⟶ U_std_Z.obj (P_pull_R.obj oneR_S) :=
    ((eqToIso hPullR_comp_UZ).inv).app oneR_S
  have hu_pull_id1 : u_pull ≫ u_pull_inv = 𝟙 _ := by
    change ((eqToIso hPullR_comp_UZ).hom ≫ (eqToIso hPullR_comp_UZ).inv).app oneR_S = _
    rw [Iso.hom_inv_id]; rfl
  have hu_pull_id2 : u_pull_inv ≫ u_pull = 𝟙 _ := by
    change ((eqToIso hPullR_comp_UZ).inv ≫ (eqToIso hPullR_comp_UZ).hom).app oneR_S = _
    rw [Iso.inv_hom_id]; rfl

  let ρ_ℤ : U_std_S.obj oneR_S ⟶ P_push_ℤ.obj (U_std_Z.obj oneR_Z) :=
    U_std_S.map ρ ≫ (isoPushUZ oneR_Z).inv
  have hadjZ_πR : adj_pull_ℤ.homEquiv (U_std_S.obj oneR_S) (U_std_Z.obj oneR_Z)
      (u_pull_inv ≫ U_std_Z.map π_R) = ρ_ℤ := by
    apply (Iso.homCongr (Iso.refl (U_std_S.obj oneR_S)) (isoPushUZ oneR_Z)).injective
    apply (ffUS.homEquiv (X := oneR_S) (Y := P_push_R.obj oneR_Z)).symm.injective
    have h_eq : (ffUS.homEquiv (X := oneR_S) (Y := P_push_R.obj oneR_Z)).symm
        ((Iso.homCongr (Iso.refl (U_std_S.obj oneR_S)) (isoPushUZ oneR_Z))
          (adj_pull_ℤ.homEquiv (U_std_S.obj oneR_S) (U_std_Z.obj oneR_Z)
            (u_pull_inv ≫ U_std_Z.map π_R))) =
        adj_pull_R.homEquiv oneR_S oneR_Z π_R := rfl
    rw [h_eq, hadjR_πR]
    simp only [ρ_ℤ, Iso.homCongr_apply, Category.assoc,
      Iso.inv_hom_id, Category.comp_id, Functor.FullyFaithful.homEquiv_symm_apply]
    exact (ffUS.preimage_map ρ).symm

  
  have hConstMorApp : ∀ {X : Scheme.{u}} {D_cat : Type (u + 1)} [Category.{u, u + 1} D_cat]
      [HasWeakSheafify X.smallEtaleTopology D_cat]
      {T_X : X.Etale} (hT_X : Limits.IsTerminal T_X) (A₀ : D_cat)
      (𝒢 : Sheaf X.smallEtaleTopology D_cat)
      (g₀ : A₀ ⟶ 𝒢.obj.obj (Opposite.op T_X)) (V : X.Etale),
      let η_X : (Functor.const X.Etaleᵒᵖ).obj A₀ ⟶
        ((constantSheaf X.smallEtaleTopology D_cat).obj A₀).obj :=
        (sheafificationAdjunction X.smallEtaleTopology D_cat).unit.app
          ((Functor.const X.Etaleᵒᵖ).obj A₀)
      let φ := ((constantSheafAdj X.smallEtaleTopology D_cat hT_X).homEquiv A₀ 𝒢).symm g₀
      η_X.app (Opposite.op V) ≫ φ.hom.app (Opposite.op V) =
        g₀ ≫ 𝒢.obj.map (hT_X.from V).op := by
    intro X D_cat _ _ T_X hT_X A₀ 𝒢 g₀ V η_X φ
    have hT_eq : η_X.app (Opposite.op T_X) ≫ φ.hom.app (Opposite.op T_X) = g₀ :=
      (hConstHomEquiv hT_X A₀ 𝒢 φ).symm.trans (Equiv.apply_symm_apply _ _)
    let t_V : V ⟶ T_X := hT_X.from V
    have hnat_η : η_X.app (Opposite.op T_X) ≫
        ((constantSheaf X.smallEtaleTopology D_cat).obj A₀).obj.map t_V.op =
        η_X.app (Opposite.op V) := by
      have hn := (η_X.naturality t_V.op).symm
      dsimp only [Functor.const_obj_map] at hn
      exact hn.trans (Category.id_comp (η_X.app (Opposite.op V)))
    rw [← hnat_η, Category.assoc, φ.hom.naturality t_V.op, ← Category.assoc, hT_eq]

  have hMateUnified : ∀ (A₀ : AddCommGrpCat.{u}) (γ : A₀ ⟶ FgtMod.obj M_R),
      let φ_S : Cℤ_S.obj A₀ ⟶ U_std_S.obj oneR_S :=
        (adjℤ_S.homEquiv A₀ (U_std_S.obj oneR_S)).symm (γ ≫ FgtMod.map (adjR_S.unit.app M_R))
      let φ_Z : Cℤ_Z.obj A₀ ⟶ U_std_Z.obj oneR_Z :=
        (adjℤ_Z.homEquiv A₀ (U_std_Z.obj oneR_Z)).symm (γ ≫ FgtMod.map (adjR_Z.unit.app M_R))
      P_pull_ℤ.map φ_S ≫ u_pull_inv ≫ U_std_Z.map π_R = πA_hp A₀ ≫ φ_Z := by
    intro A₀ γ φ_S φ_Z
    apply (adj_pull_ℤ.homEquiv (Cℤ_S.obj A₀) (U_std_Z.obj oneR_Z)).injective
    have hlhs : adj_pull_ℤ.homEquiv _ _ (P_pull_ℤ.map φ_S ≫ (u_pull_inv ≫ U_std_Z.map π_R)) =
        φ_S ≫ ρ_ℤ := by
      rw [adj_pull_ℤ.homEquiv_naturality_left, hadjZ_πR]
    have hrhs : adj_pull_ℤ.homEquiv _ _ (πA_hp A₀ ≫ φ_Z) =
        adj_pull_ℤ.homEquiv _ _ (πA_hp A₀) ≫ P_push_ℤ.map φ_Z :=
      adj_pull_ℤ.homEquiv_naturality_right (πA_hp A₀) φ_Z
    rw [hlhs, hrhs]
    apply (adjℤ_hp₂.homEquiv A₀ (P_push_ℤ.obj (U_std_Z.obj oneR_Z))).injective
    have hrhs2 : adjℤ_hp₂.homEquiv _ _ (adj_pull_ℤ.homEquiv _ _ (πA_hp A₀) ≫ P_push_ℤ.map φ_Z) =
        (adjℤ_hp₁.unit.app A₀ ≫ (Cℤ_Z.obj A₀).obj.map τ_hp.op) ≫
          φ_Z.hom.app (Opposite.op (B.obj T₂_hp)) := by
      rw [adjℤ_hp₂.homEquiv_naturality_right]
      dsimp only [πA_hp]
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      rfl
    rw [hrhs2, hConstHomEquiv hT₂_hp A₀ _ (φ_S ≫ ρ_ℤ)]
    let ηA_S : (Functor.const S.Etaleᵒᵖ).obj A₀ ⟶ (Cℤ_S.obj A₀).obj :=
      (sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        ((Functor.const S.Etaleᵒᵖ).obj A₀)
    let ηA_Z : (Functor.const Z.Etaleᵒᵖ).obj A₀ ⟶ (Cℤ_Z.obj A₀).obj :=
      (sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        ((Functor.const Z.Etaleᵒᵖ).obj A₀)
    have h_S_side : ηA_S.app (Opposite.op T₂_hp) ≫ (φ_S ≫ ρ_ℤ).hom.app (Opposite.op T₂_hp) =
        γ ≫ FgtMod.map (ηZ_app (B.obj T₂_hp)) := by
      have h1 : ηA_S.app (Opposite.op T₂_hp) ≫ φ_S.hom.app (Opposite.op T₂_hp) =
          (γ ≫ FgtMod.map (adjR_S.unit.app M_R)) ≫
            (U_std_S.obj oneR_S).obj.map (hT_S.from T₂_hp).op :=
        hConstMorApp hT_S A₀ (U_std_S.obj oneR_S) _ T₂_hp
      have h2 : FgtMod.map (adjR_S.unit.app M_R) ≫
          (U_std_S.obj oneR_S).obj.map (hT_S.from T₂_hp).op =
          FgtMod.map (ηS_app T₂_hp) := by
        rw [hConstUnit hT_S M_R]
        exact (FgtMod.map_comp (ηS_app T_S) (oneR_S.obj.map (hT_S.from T₂_hp).op)).symm.trans
          (congrArg FgtMod.map (hηS_nat (hT_S.from T₂_hp)))
      have h3 : ρ_ℤ.hom.app (Opposite.op T₂_hp) = FgtMod.map (ρ_app T₂_hp) :=
        Category.comp_id _
      have h4 : FgtMod.map (ηS_app T₂_hp) ≫ FgtMod.map (ρ_app T₂_hp) =
          FgtMod.map (ηZ_app (B.obj T₂_hp)) :=
        (FgtMod.map_comp _ _).symm.trans (congrArg FgtMod.map (hρ_app T₂_hp))
      exact (Category.assoc (ηA_S.app (Opposite.op T₂_hp))
        (φ_S.hom.app (Opposite.op T₂_hp)) (ρ_ℤ.hom.app (Opposite.op T₂_hp))).symm.trans
        ((congrArg (· ≫ ρ_ℤ.hom.app (Opposite.op T₂_hp))
          (h1.trans ((Category.assoc _ _ _).trans (congrArg (γ ≫ ·) h2)))).trans
          ((Category.assoc γ _ _).trans (congrArg (γ ≫ ·)
            ((congrArg (FgtMod.map (ηS_app T₂_hp) ≫ ·) h3).trans h4))))
    have hηZ_τ : adjℤ_hp₁.unit.app A₀ ≫ (Cℤ_Z.obj A₀).obj.map τ_hp.op =
        ηA_Z.app (Opposite.op (B.obj T₂_hp)) := by
      rw [hConstUnit hT₁_hp A₀]
      have hn := (ηA_Z.naturality τ_hp.op).symm
      dsimp only [Functor.const_obj_map] at hn
      exact hn.trans (Category.id_comp (ηA_Z.app (Opposite.op (B.obj T₂_hp))))
    have h_Z_side : (adjℤ_hp₁.unit.app A₀ ≫ (Cℤ_Z.obj A₀).obj.map τ_hp.op) ≫
        φ_Z.hom.app (Opposite.op (B.obj T₂_hp)) =
        γ ≫ FgtMod.map (ηZ_app (B.obj T₂_hp)) := by
      have h1 : ηA_Z.app (Opposite.op (B.obj T₂_hp)) ≫ φ_Z.hom.app (Opposite.op (B.obj T₂_hp)) =
          (γ ≫ FgtMod.map (adjR_Z.unit.app M_R)) ≫
            (U_std_Z.obj oneR_Z).obj.map (hT_Z.from (B.obj T₂_hp)).op :=
        hConstMorApp hT_Z A₀ (U_std_Z.obj oneR_Z) _ (B.obj T₂_hp)
      have h2 : FgtMod.map (adjR_Z.unit.app M_R) ≫
          (U_std_Z.obj oneR_Z).obj.map (hT_Z.from (B.obj T₂_hp)).op =
          FgtMod.map (ηZ_app (B.obj T₂_hp)) := by
        rw [hConstUnit hT_Z M_R]
        exact (FgtMod.map_comp (ηZ_app T_Z)
          (oneR_Z.obj.map (hT_Z.from (B.obj T₂_hp)).op)).symm.trans
          (congrArg FgtMod.map (hηZ_nat (hT_Z.from (B.obj T₂_hp))))
      exact (congrArg (· ≫ φ_Z.hom.app (Opposite.op (B.obj T₂_hp))) hηZ_τ).trans
        (h1.trans ((Category.assoc _ _ _).trans (congrArg (γ ≫ ·) h2)))
    exact h_S_side.trans h_Z_side.symm

  have hLeftDeg0 : ηℤ_Z ≫ U_std_Z.map ι_R ≫ u_pull = ιℤ_hp ≫ P_pull_ℤ.map ηℤ_S := by
    have hm := hMateUnified Aℤ ιℤ_hom
    change P_pull_ℤ.map ηℤ_S ≫ u_pull_inv ≫ U_std_Z.map π_R = πA_hp Aℤ ≫ ηℤ_Z at hm
    have h1 := congrArg (ιℤ_hp ≫ ·) hm.symm
    have hιπ_hp' : ιℤ_hp ≫ πA_hp Aℤ = 𝟙 _ := hιπℤ_hp
    rw [← Category.assoc ιℤ_hp, hιπ_hp', Category.id_comp] at h1
    have h2 := congrArg (· ≫ U_std_Z.map ι_R ≫ u_pull) h1
    rw [Category.assoc, Category.assoc (P_pull_ℤ.map ηℤ_S), Category.assoc u_pull_inv,
      ← Category.assoc (U_std_Z.map π_R), ← U_std_Z.map_comp, hπι_R, U_std_Z.map_id,
      Category.id_comp, hu_pull_id2, Category.comp_id] at h2
    exact h2

  have hRightDeg0 : u_pull_inv ≫ U_std_Z.map π_R ≫ βM_Z = P_pull_ℤ.map βM_S ≫ πA_hp AM := by
    have hm := hMateUnified AM ιM_hom
    change P_pull_ℤ.map αM_S ≫ u_pull_inv ≫ U_std_Z.map π_R = πA_hp AM ≫ αM_Z at hm
    calc
      u_pull_inv ≫ U_std_Z.map π_R ≫ βM_Z
        = (𝟙 _ ≫ (u_pull_inv ≫ U_std_Z.map π_R)) ≫ βM_Z := by
            simp only [Category.id_comp, Category.assoc]
      _ = ((P_pull_ℤ.map βM_S ≫ P_pull_ℤ.map αM_S) ≫ (u_pull_inv ≫ U_std_Z.map π_R)) ≫ βM_Z := by
            rw [← P_pull_ℤ.map_comp, hβα_S, P_pull_ℤ.map_id]
      _ = P_pull_ℤ.map βM_S ≫ (P_pull_ℤ.map αM_S ≫ u_pull_inv ≫ U_std_Z.map π_R) ≫ βM_Z := by
            simp only [Category.assoc]
      _ = P_pull_ℤ.map βM_S ≫ πA_hp AM ≫ (αM_Z ≫ βM_Z) := by
            rw [hm]; simp only [Category.assoc]
      _ = P_pull_ℤ.map βM_S ≫ πA_hp AM := by
            rw [hαβ_Z, Category.comp_id]

  let a_S : Abelian.Ext.{u} oneR_S oneR_S q₁ := a
  have hIntertwine : p (θ_S a) = θ_Z p_R_a := by
    rw [hp_formula (θ_S a), hθS_eq a, hθZ_eq p_R_a]
    change (((Abelian.Ext.mk₀ ιℤ_hp).comp
        (Abelian.Ext.mapExactFunctor P_pull_ℤ
          (((Abelian.Ext.mk₀ ηℤ_S).comp (Abelian.Ext.mapExactFunctor U_std_S a_S)
            (Nat.zero_add q₁)).comp (Abelian.Ext.mk₀ βM_S) (Nat.add_zero q₁)))
        (Nat.zero_add q₁)).comp (Abelian.Ext.mk₀ (πA_hp AM)) (Nat.add_zero q₁)) =
      (((Abelian.Ext.mk₀ ηℤ_Z).comp (Abelian.Ext.mapExactFunctor U_std_Z p_R_a)
        (Nat.zero_add q₁)).comp (Abelian.Ext.mk₀ βM_Z) (Nat.add_zero q₁))
    dsimp only [p_R_a]
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀]
    have h_comp1 : Abelian.Ext.mapExactFunctor P_pull_ℤ (Abelian.Ext.mapExactFunctor U_std_S a_S) =
        Abelian.Ext.mapExactFunctor (U_std_S ⋙ P_pull_ℤ) a_S :=
      (hExtMapComp U_std_S P_pull_ℤ q₁ a_S).symm
    have h_comp2 : Abelian.Ext.mapExactFunctor (P_pull_R ⋙ U_std_Z) a_S =
        Abelian.Ext.mapExactFunctor U_std_Z (Abelian.Ext.mapExactFunctor P_pull_R a_S) :=
      hExtMapComp P_pull_R U_std_Z q₁ a_S
    have hnat_iso : (Abelian.Ext.mk₀ u_pull).comp
          (Abelian.Ext.mapExactFunctor P_pull_ℤ (Abelian.Ext.mapExactFunctor U_std_S a_S))
          (Nat.zero_add q₁) =
        (Abelian.Ext.mapExactFunctor U_std_Z (Abelian.Ext.mapExactFunctor P_pull_R a_S)).comp
          (Abelian.Ext.mk₀ u_pull) (Nat.add_zero q₁) :=
      (congrArg ((Abelian.Ext.mk₀ u_pull).comp · (Nat.zero_add q₁)) h_comp1).trans
        ((hExtNat u_pull_nat q₁ a_S).trans
          (congrArg (fun z : Abelian.Ext.{u} (U_std_Z.obj (P_pull_R.obj oneR_S))
              (U_std_Z.obj (P_pull_R.obj oneR_S)) q₁ =>
            z.comp (Abelian.Ext.mk₀ u_pull) (Nat.add_zero q₁)) h_comp2))
    set X_ab := Abelian.Ext.mapExactFunctor P_pull_ℤ (Abelian.Ext.mapExactFunctor U_std_S a_S)
    set X_mod := Abelian.Ext.mapExactFunctor U_std_Z (Abelian.Ext.mapExactFunctor P_pull_R a_S)
    have hX_eq : X_mod = ((Abelian.Ext.mk₀ u_pull).comp X_ab (Nat.zero_add q₁)).comp
        (Abelian.Ext.mk₀ u_pull_inv) (Nat.add_zero q₁) := by
      rw [hnat_iso, Abelian.Ext.comp_assoc X_mod (Abelian.Ext.mk₀ u_pull)
        (Abelian.Ext.mk₀ u_pull_inv) (Nat.add_zero q₁) (Nat.add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, hu_pull_id1]
      simp
    rw [hX_eq]
    have hlhs_assoc :
        (((Abelian.Ext.mk₀ ιℤ_hp).comp
          (((Abelian.Ext.mk₀ (P_pull_ℤ.map ηℤ_S)).comp X_ab (Nat.zero_add q₁)).comp
            (Abelian.Ext.mk₀ (P_pull_ℤ.map βM_S)) (Nat.add_zero q₁))
          (Nat.zero_add q₁)).comp (Abelian.Ext.mk₀ (πA_hp AM)) (Nat.add_zero q₁)) =
        ((Abelian.Ext.mk₀ (ιℤ_hp ≫ P_pull_ℤ.map ηℤ_S)).comp X_ab (Nat.zero_add q₁)).comp
          (Abelian.Ext.mk₀ (P_pull_ℤ.map βM_S ≫ πA_hp AM)) (Nat.add_zero q₁) := by
      rw [← Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ ιℤ_hp) _ _
          (Nat.zero_add q₁) (Nat.add_zero q₁) (by omega),
        ← Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ ιℤ_hp)
          (Abelian.Ext.mk₀ (P_pull_ℤ.map ηℤ_S))
          X_ab (Nat.zero_add 0) (Nat.zero_add q₁) (by omega),
        Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc (a := q₁) _ (Abelian.Ext.mk₀ (P_pull_ℤ.map βM_S))
          (Abelian.Ext.mk₀ (πA_hp AM)) (Nat.add_zero q₁) (Nat.add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    have hrhs_assoc :
        (((Abelian.Ext.mk₀ ηℤ_Z).comp
          (((Abelian.Ext.mk₀ (U_std_Z.map ι_R)).comp
            (((Abelian.Ext.mk₀ u_pull).comp X_ab (Nat.zero_add q₁)).comp
              (Abelian.Ext.mk₀ u_pull_inv) (Nat.add_zero q₁))
            (Nat.zero_add q₁)).comp (Abelian.Ext.mk₀ (U_std_Z.map π_R)) (Nat.add_zero q₁))
          (Nat.zero_add q₁)).comp (Abelian.Ext.mk₀ βM_Z) (Nat.add_zero q₁)) =
        ((Abelian.Ext.mk₀ (ηℤ_Z ≫ U_std_Z.map ι_R ≫ u_pull)).comp X_ab (Nat.zero_add q₁)).comp
          (Abelian.Ext.mk₀ (u_pull_inv ≫ U_std_Z.map π_R ≫ βM_Z)) (Nat.add_zero q₁) := by
      rw [← Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ (U_std_Z.map ι_R)) _
          (Abelian.Ext.mk₀ u_pull_inv) (Nat.zero_add q₁) (Nat.add_zero q₁) (by omega),
        ← Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ (U_std_Z.map ι_R))
          (Abelian.Ext.mk₀ u_pull) X_ab (Nat.zero_add 0) (Nat.zero_add q₁) (by omega),
        Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc (a := q₁) _ (Abelian.Ext.mk₀ u_pull_inv)
          (Abelian.Ext.mk₀ (U_std_Z.map π_R)) (Nat.add_zero q₁) (Nat.add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀,
        ← Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ ηℤ_Z) _ _
          (Nat.zero_add q₁) (Nat.add_zero q₁) (by omega),
        ← Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ ηℤ_Z)
          (Abelian.Ext.mk₀ (U_std_Z.map ι_R ≫ u_pull)) X_ab
          (Nat.zero_add 0) (Nat.zero_add q₁) (by omega),
        Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc (a := q₁) _ (Abelian.Ext.mk₀ (u_pull_inv ≫ U_std_Z.map π_R))
          (Abelian.Ext.mk₀ βM_Z) (Nat.add_zero q₁) (Nat.add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Category.assoc u_pull_inv]
    rw [hlhs_assoc, hrhs_assoc, hLeftDeg0, hRightDeg0]

  have hpR_zero : p_R_a = 0 := by
    apply hInj_Z
    rw [← hIntertwine, ha, map_zero]

  
  let η_adj_S : oneR_S ⟶ P_push_R.obj (P_pull_R.obj oneR_S) := adj_pull_R.unit.app oneR_S
  have hunit_πR : η_adj_S ≫ P_push_R.map π_R = ρ :=
    (Adjunction.homEquiv_unit adj_pull_R oneR_S oneR_Z π_R).symm.trans hadjR_πR
  have hunit_ιR : η_adj_S = ρ ≫ P_push_R.map ι_R := by
    rw [← hunit_πR, Category.assoc, ← P_push_R.map_comp, hπι_R, P_push_R.map_id, Category.comp_id]

  have h_aρ : a_S.comp (Abelian.Ext.mk₀ ρ) (Nat.add_zero q₁) = 0 := by
    have h_id_a : Abelian.Ext.mapExactFunctor (Functor.id _) a_S = a_S :=
      hExtMapId q₁ a_S
    have h_comp_R : Abelian.Ext.mapExactFunctor P_push_R (Abelian.Ext.mapExactFunctor P_pull_R a_S) =
        Abelian.Ext.mapExactFunctor (P_pull_R ⋙ P_push_R) a_S :=
      (hExtMapComp P_pull_R P_push_R q₁ a_S).symm
    have hnat_unit : (Abelian.Ext.mk₀ η_adj_S).comp
          (Abelian.Ext.mapExactFunctor P_push_R (Abelian.Ext.mapExactFunctor P_pull_R a_S))
          (Nat.zero_add q₁) =
        a_S.comp (Abelian.Ext.mk₀ η_adj_S) (Nat.add_zero q₁) :=
      (congrArg ((Abelian.Ext.mk₀ η_adj_S).comp · (Nat.zero_add q₁)) h_comp_R).trans
        ((hExtNat adj_pull_R.unit q₁ a_S).trans
          (congrArg (fun z : Abelian.Ext.{u} oneR_S oneR_S q₁ =>
            z.comp (Abelian.Ext.mk₀ η_adj_S) (Nat.add_zero q₁)) h_id_a))
    have hpost := congrArg
      (fun z : Abelian.Ext.{u} oneR_S (P_push_R.obj (P_pull_R.obj oneR_S)) q₁ =>
        z.comp (Abelian.Ext.mk₀ (P_push_R.map π_R)) (Nat.add_zero q₁))
      hnat_unit.symm
    rw [Abelian.Ext.comp_assoc a_S (Abelian.Ext.mk₀ η_adj_S)
        (Abelian.Ext.mk₀ (P_push_R.map π_R)) (Nat.add_zero q₁) (Nat.add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hunit_πR] at hpost
    rw [hpost, hunit_ιR, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ ρ) (Abelian.Ext.mk₀ (P_push_R.map ι_R))
        (Abelian.Ext.mapExactFunctor P_push_R (Abelian.Ext.mapExactFunctor P_pull_R a_S))
        (Nat.zero_add 0) (Nat.zero_add q₁) (by omega),
      Abelian.Ext.comp_assoc (a := q₁) (Abelian.Ext.mk₀ ρ) _
        (Abelian.Ext.mk₀ (P_push_R.map π_R)) (Nat.zero_add q₁) (Nat.add_zero q₁) (by omega),
      ← Abelian.Ext.mapExactFunctor_mk₀ P_push_R ι_R,
      ← Abelian.Ext.mapExactFunctor_mk₀ P_push_R π_R,
      ← Abelian.Ext.mapExactFunctor_comp P_push_R,
      ← Abelian.Ext.mapExactFunctor_comp P_push_R]
    change (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor P_push_R p_R_a)
      (Nat.zero_add q₁) = 0
    have hzero_map : Abelian.Ext.mapExactFunctor P_push_R (0 : weilCupPDModH Z n q₁) = 0 :=
      (P_push_R.mapExtAddHom oneR_Z oneR_Z q₁).map_zero
    rw [hpR_zero, hzero_map, Abelian.Ext.comp_zero]

  
  
  
  exact Abelian.Ext.covariant_sequence_exact₂ oneR_S hSES a_S h_aρ

theorem weil_aff_cd_noether_norm_and_stalk_support_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (d q : ℕ) (U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsAffine U.left] [AlgebraicGeometry.LocallyOfFiniteType U.hom],
      topologicalKrullDim U.left ≤ (d : WithBot ℕ∞) →
      (∀ (s : ℕ), s ≤ d →
        ∀ (𝒢 : CategoryTheory.Sheaf (weilAffineSpaceOver k s).left.smallEtaleTopology
            AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 → Subsingleton (𝒢.H q)) →
      ∀ (ℱ : CategoryTheory.Sheaf U.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id ℱ = 0 → Subsingleton (ℱ.H q)) ∧
    (∀ (e m q : ℕ),
      (∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine W.left] [AlgebraicGeometry.LocallyOfFiniteType W.hom],
        topologicalKrullDim W.left ≤ (e : WithBot ℕ∞) →
        ∀ (𝒢 : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 → Subsingleton (𝒢.H q)) →
      ∀ (ℱ : CategoryTheory.Sheaf (weilAffineSpaceOver k m).left.smallEtaleTopology
          AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id ℱ = 0 →
        (∀ y : ↥(weilAffineSpaceOver k m).left,
          (e : WithBot ℕ∞) <
            topologicalKrullDim ↥(closure ({y} : Set ↥(weilAffineSpaceOver k m).left)) →
          WeilAltCdStalkZeroAt (weilAffineSpaceOver k m).left ℱ y) →
        Subsingleton (ℱ.H q)) :=
by
  classical
  have hNoetherNorm : ∀ (d : ℕ)
      (U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsAffine U.left]
      [AlgebraicGeometry.LocallyOfFiniteType U.hom],
      topologicalKrullDim U.left ≤ (d : WithBot ℕ∞) →
      ∃ (s : ℕ), s ≤ d ∧
        ∃ (π : U.left ⟶ (weilAffineSpaceOver k s).left), AlgebraicGeometry.IsFinite π := by
    intro d U _ _ hDim
    let R_cat : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op ⊤)
    let R : Type u := ↑R_cat
    let e_Spec : U.left ≅ AlgebraicGeometry.Spec R_cat := U.left.isoSpec
    let φ_k : CommRingCat.of k ⟶ R_cat :=
      AlgebraicGeometry.Spec.preimage (e_Spec.inv ≫ U.hom)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_Spec.inv ≫ U.hom :=
      AlgebraicGeometry.Spec.map_preimage (e_Spec.inv ≫ U.hom)
    have hLFT_φ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_k) := by
      rw [hmap_φ]
      infer_instance
    have hFT_hom : φ_k.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_φ
    let _ : Algebra k R := φ_k.hom.toAlgebra
    have _ : Algebra.FiniteType k R := RingHom.finiteType_algebraMap.mp hFT_hom
    have hHomeo : IsHomeomorph e_Spec.hom.base :=
      (AlgebraicGeometry.Scheme.Hom.homeomorph e_Spec.hom).isHomeomorph
    have hDimSpec : topologicalKrullDim U.left =
        topologicalKrullDim (AlgebraicGeometry.Spec R_cat) :=
      IsHomeomorph.topologicalKrullDim_eq e_Spec.hom.base hHomeo
    have hRingDim : ringKrullDim R ≤ (d : WithBot ℕ∞) := by
      have h1 : topologicalKrullDim (PrimeSpectrum R) = ringKrullDim R :=
        PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim R
      change topologicalKrullDim U.left = topologicalKrullDim (PrimeSpectrum R) at hDimSpec
      rwa [hDimSpec, h1] at hDim
    by_cases hSub : Subsingleton R
    · have _ : Subsingleton R := hSub
      let g₀ : MvPolynomial (Fin 0) k →+* R :=
        (MvPolynomial.aeval (R := k) (Fin.elim0 : Fin 0 → R)).toRingHom
      have hg₀_surj : Function.Surjective g₀ := fun r => ⟨0, Subsingleton.elim _ _⟩
      have hg₀_fin : g₀.Finite := RingHom.Finite.of_surjective g₀ hg₀_surj
      let f₀ : AlgebraicGeometry.Spec R_cat ⟶ (weilAffineSpaceOver k 0).left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom g₀)
      have _ : AlgebraicGeometry.IsFinite f₀ :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom g₀)).mpr hg₀_fin
      exact ⟨0, Nat.zero_le d, e_Spec.hom ≫ f₀, inferInstance⟩
    · have _ : Nontrivial R := not_subsingleton_iff_nontrivial.mp hSub
      obtain ⟨s, g, hg_inj, hg_fin⟩ := exists_finite_inj_algHom_of_fg k R
      let P_s := MvPolynomial (Fin s) k
      let _ : Algebra P_s R := g.toRingHom.toAlgebra
      have _ : Module.Finite P_s R := RingHom.finite_algebraMap.mp hg_fin
      have _ : Algebra.IsIntegral P_s R := Algebra.IsIntegral.of_finite P_s R
      have hLiftChain : ∀ (l : LTSeries (PrimeSpectrum P_s)) (n_len : ℕ) (hm : n_len ≤ l.length),
          ∃ q_ser : LTSeries (PrimeSpectrum R),
            q_ser.length = n_len ∧
            Ideal.under P_s (q_ser.last).asIdeal =
              (l.toFun ⟨n_len, Nat.lt_succ_of_le hm⟩).asIdeal := by
        intro l n_len
        induction n_len with
        | zero =>
          intro hm
          let p₀ : PrimeSpectrum P_s := l.toFun ⟨0, Nat.lt_succ_of_le hm⟩
          have _ : p₀.asIdeal.IsPrime := p₀.isPrime
          have hbot : Ideal.under P_s (⊥ : Ideal R) ≤ p₀.asIdeal := by
            intro a ha
            rw [Ideal.mem_comap, Ideal.mem_bot] at ha
            have ha0 : a = 0 := hg_inj (ha.trans (map_zero g).symm)
            rw [ha0]
            exact p₀.asIdeal.zero_mem
          obtain ⟨Q₀, _, hQ₀_prime, hQ₀_over⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral p₀.asIdeal (⊥ : Ideal R) hbot
          let q₀_ser : LTSeries (PrimeSpectrum R) :=
            { length := 0
              toFun := fun _ => ⟨Q₀, hQ₀_prime⟩
              step := fun i => Fin.elim0 i }
          exact ⟨q₀_ser, rfl, hQ₀_over⟩
        | succ n_len ih =>
          intro hm1
          obtain ⟨q', hq'_len, hq'_last⟩ := ih (Nat.le_of_succ_le hm1)
          let p_prev : PrimeSpectrum P_s :=
            l.toFun ⟨n_len, Nat.lt_succ_of_le (Nat.le_of_succ_le hm1)⟩
          let p_next : PrimeSpectrum P_s := l.toFun ⟨n_len + 1, Nat.lt_succ_of_le hm1⟩
          have hstep : p_prev < p_next := l.step ⟨n_len, hm1⟩
          have _ : p_next.asIdeal.IsPrime := p_next.isPrime
          have hle_next : Ideal.under P_s (q'.last).asIdeal ≤ p_next.asIdeal := by
            rw [hq'_last]
            exact le_of_lt hstep
          obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_over⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral p_next.asIdeal (q'.last).asIdeal hle_next
          let q_next_pt : PrimeSpectrum R := ⟨Q_next, hQ_prime⟩
          have hlt_R : q'.last < q_next_pt := by
            refine lt_of_le_of_ne hQ_ge (fun heq => ?_)
            have h_id_eq : (q'.last).asIdeal = Q_next := congrArg PrimeSpectrum.asIdeal heq
            have hp_eq : p_prev.asIdeal = p_next.asIdeal := by
              rw [← hq'_last, h_id_eq, hQ_over]
            exact ne_of_lt hstep (PrimeSpectrum.ext hp_eq)
          refine ⟨q'.snoc q_next_pt hlt_R, ?_, ?_⟩
          · rw [RelSeries.snoc_length, hq'_len]
          · rw [RelSeries.last_snoc]
            exact hQ_over
      have _ : Nonempty (PrimeSpectrum P_s) := inferInstance
      have hPs_le_d : ringKrullDim P_s ≤ (d : WithBot ℕ∞) := by
        change Order.krullDim (PrimeSpectrum P_s) ≤ ((d : ℕ∞) : WithBot ℕ∞)
        rw [Order.krullDim_eq_iSup_length]
        refine WithBot.coe_le_coe.mpr (iSup_le (fun l => ?_))
        obtain ⟨q_ser, hq_len, _⟩ := hLiftChain l l.length (le_refl _)
        have hlen_le : ((q_ser.length : ℕ) : WithBot ℕ∞) ≤ (d : WithBot ℕ∞) :=
          (Order.LTSeries.length_le_krullDim q_ser).trans hRingDim
        rw [hq_len] at hlen_le
        exact WithBot.coe_le_coe.mp hlen_le
      have hPs_eq : ringKrullDim P_s = (s : WithBot ℕ∞) := by
        dsimp [P_s]
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
          zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
        rfl
      have hs_withbot : (s : WithBot ℕ∞) ≤ (d : WithBot ℕ∞) := by
        rwa [hPs_eq] at hPs_le_d
      have hs_le : s ≤ d := by exact_mod_cast hs_withbot
      let f_s : AlgebraicGeometry.Spec R_cat ⟶ (weilAffineSpaceOver k s).left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom g.toRingHom)
      have _ : AlgebraicGeometry.IsFinite f_s :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom g.toRingHom)).mpr hg_fin
      exact ⟨s, hs_le, e_Spec.hom ≫ f_s, inferInstance⟩

  have hChartSupport : ∀ (e : ℕ)
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType W.hom]
      (ℱ : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u})
      (_hSupp : ∀ y : ↥W.left,
        (e : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({y} : Set ↥W.left)) →
        WeilAltCdStalkZeroAt W.left ℱ y)
      (U : W.left.Etale) [CompactSpace ↥U.left]
      (s : ↥(ℱ.obj.obj (Opposite.op U))),
      ∃ pts : Finset ↥W.left,
        (∀ y ∈ pts, topologicalKrullDim ↥(closure ({y} : Set ↥W.left)) ≤ (e : WithBot ℕ∞)) ∧
        ∀ (V : W.left.Etale) (v : V ⟶ U),
          (∀ y ∈ pts, Disjoint (Set.range V.hom.base) (closure ({y} : Set ↥W.left))) →
          ℱ.obj.map (Opposite.op v) s = 0 := by
    intro e W _ ℱ hSupp U _ s
    have hMapComp : ∀ {Y₁ Y₂ Y₃ : W.left.Etale} (a : Y₁ ⟶ Y₂) (b : Y₂ ⟶ Y₃)
        (x : ↥(ℱ.obj.obj (Opposite.op Y₃))),
        ℱ.obj.map (Opposite.op (a ≫ b)) x =
          ℱ.obj.map (Opposite.op a) (ℱ.obj.map (Opposite.op b) x) :=
      fun {Y₁ Y₂ Y₃} a b x =>
        congrArg (fun (m : ℱ.obj.obj (Opposite.op Y₃) ⟶ ℱ.obj.obj (Opposite.op Y₁)) => m x)
          (ℱ.obj.map_comp (Opposite.op b) (Opposite.op a))
    have hFU_loc : ∀ {A B : Type u} [CommRing A] [CommRing B] (g : A →+* B),
        g.FormallyUnramified → ∀ (J : Ideal B) (_ : J.IsPrime),
        (Localization.localRingHom (Ideal.comap g J) J g rfl).FormallyUnramified := by
      intro A B _ _ g hg J _
      let _ : Algebra A B := g.toAlgebra
      have _ : Algebra.FormallyUnramified A B := RingHom.formallyUnramified_algebraMap.mp hg
      have _ : (Ideal.comap g J).IsPrime := Ideal.IsPrime.comap g
      let locMap := Localization.localRingHom (Ideal.comap g J) J g rfl
      have hcomp : locMap.comp (algebraMap A (Localization.AtPrime (Ideal.comap g J))) =
          (algebraMap B (Localization.AtPrime J)).comp g := by
        ext a
        exact Localization.localRingHom_to_map (Ideal.comap g J) J g rfl a
      have _ : Algebra.FormallyUnramified A (Localization.AtPrime J) :=
        Algebra.FormallyUnramified.instLocalization J.primeCompl
