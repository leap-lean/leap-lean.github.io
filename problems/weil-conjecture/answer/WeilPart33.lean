        have hdeg1 : q - (t + 1) = r₀ + 1 := by omega
        have hdeg2 : q - t = (r₀ + 1) + 1 := by omega
        have hIH : Subsingleton ((P_push.obj (W t)).H ((r₀ + 1) + 1)) := by
          rw [← hdeg2]
          exact ih (by omega)
        let _ : CategoryTheory.Injective (I t) := hInj t
        let _ : CategoryTheory.Injective (P_push.obj (I t)) := hInjPush (I t) (hInj t)
        obtain ⟨ℬ_t, π_B, ι_B, δ_B, h₁, h₂, _hfac, hSE1, hSE2⟩ :=
          (hStep (W t) (I t) (W (t + 1)) (j t) (p t) (hjp t) (hSE t)).2
        have hSub_ℬ : Subsingleton (ℬ_t.H (r₀ + 1)) := hSubExact₃_inj hSE1 r₀ hIH
        obtain ⟨isoR⟩ := hRShift1 t
        have hSub_R_ℱ : Subsingleton ((weilAltCdHigherDirectImage f (t + 1) ℱ).H (r₀ + 1)) := by
          rw [← hdeg1]
          exact hRPush (t + 1) (by omega) (by omega)
        have hSub_R1 : Subsingleton ((weilAltCdHigherDirectImage f 1 (W t)).H (r₀ + 1)) :=
          hSubOfIso isoR (r₀ + 1) hSub_R_ℱ
        rw [hdeg1]
        exact hSubExact₂ hSE2 (r₀ + 1) hSub_ℬ hSub_R1
    have hSub_PW1 : Subsingleton ((P_push.obj (W (q - 1))).H 1) := by
      have h := hBaseDesc (q - 1) (le_refl (q - 1))
      have hsub : q - (q - 1) = 1 := by omega
      rwa [hsub] at h
    have hSub_R1_0 : Subsingleton ((weilAltCdHigherDirectImage f 1 (W (q - 1))).H 0) := by
      obtain ⟨isoRq⟩ := hRShift1 (q - 1)
      have hq_eq : (q - 1) + 1 = q := by omega
      let isoRq' : weilAltCdHigherDirectImage f 1 (W (q - 1)) ≅ weilAltCdHigherDirectImage f q ℱ :=
        isoRq.trans (CategoryTheory.eqToIso (by rw [hq_eq]))
      have hRq0 : Subsingleton ((weilAltCdHigherDirectImage f q ℱ).H 0) := by
        have h := hRPush q hq (le_refl q)
        rwa [Nat.sub_self] at h
      exact hSubOfIso isoRq' 0 hRq0
    have hLiftB : ∀ u : (P_push.obj (W ((q - 1) + 1))).H 0,
        ∃ w : (P_push.obj (I (q - 1))).H 0,
          w.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map (p (q - 1)))) (Nat.add_zero 0) = u := by
      intro u
      let _ : CategoryTheory.Injective (I (q - 1)) := hInj (q - 1)
      obtain ⟨ℬ, π_B, ι_B, δ_B, h₁, h₂, hfac, hSE1, hSE2⟩ :=
        (hStep (W (q - 1)) (I (q - 1)) (W ((q - 1) + 1))
          (j (q - 1)) (p (q - 1)) (hjp (q - 1)) (hSE (q - 1))).2
      have hu_δ : u.comp (CategoryTheory.Abelian.Ext.mk₀ δ_B) (Nat.add_zero 0) = 0 :=
        @Subsingleton.elim _ hSub_R1_0 _ 0
      obtain ⟨v, hv⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_B hSE2 u hu_δ
      have hv_ext : v.comp hSE1.extClass (Nat.zero_add 1) = 0 :=
        @Subsingleton.elim _ hSub_PW1 _ 0
      obtain ⟨w, hw⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_B hSE1 v (Nat.zero_add 1) hv_ext
      refine ⟨w, ?_⟩
      rw [← hfac, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ π_B ι_B,
        ← CategoryTheory.Abelian.Ext.comp_assoc w (CategoryTheory.Abelian.Ext.mk₀ π_B)
          (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
        hw, hv]
    have hLiftX : ∀ u' : (W ((q - 1) + 1)).H 0,
        ∃ w' : (I (q - 1)).H 0,
          w'.comp (CategoryTheory.Abelian.Ext.mk₀ (p (q - 1))) (Nat.add_zero 0) = u' := by
      intro u'
      obtain ⟨w, hw⟩ := hLiftB ((e₀ (W ((q - 1) + 1))).symm u')
      refine ⟨e₀ (I (q - 1)) w, ?_⟩
      rw [← he₀_nat (p (q - 1)) w, hw, AddEquiv.apply_symm_apply]
    have hSub_W1 : Subsingleton ((W (q - 1)).H 1) := by
      refine ⟨fun z₁ z₂ => ?_⟩
      suffices hz0 : ∀ z : (W (q - 1)).H 1, z = 0 by
        rw [hz0 z₁, hz0 z₂]
      intro z
      let _ : CategoryTheory.Injective (I (q - 1)) := hInj (q - 1)
      have hz_j :
          CategoryTheory.Abelian.Ext.comp z (CategoryTheory.Abelian.Ext.mk₀ (j (q - 1)))
            (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨u', hu'⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X (hSE (q - 1)) z hz_j
          (Nat.zero_add 1)
      obtain ⟨w', hw'⟩ := hLiftX u'
      calc
        z = CategoryTheory.Abelian.Ext.comp u' (hSE (q - 1)).extClass (Nat.zero_add 1) := hu'.symm
        _ = CategoryTheory.Abelian.Ext.comp
              (CategoryTheory.Abelian.Ext.comp w' (CategoryTheory.Abelian.Ext.mk₀ (p (q - 1)))
                (Nat.add_zero 0))
              (hSE (q - 1)).extClass (Nat.zero_add 1) := by rw [hw']
        _ = CategoryTheory.Abelian.Ext.comp w'
              (CategoryTheory.Abelian.Ext.comp (CategoryTheory.Abelian.Ext.mk₀ (p (q - 1)))
                (hSE (q - 1)).extClass (Nat.zero_add 1))
              (Nat.zero_add 1) :=
          CategoryTheory.Abelian.Ext.comp_assoc w' _ _ (Nat.add_zero 0) (Nat.zero_add 1)
            (Nat.zero_add 1)
        _ = 0 := by
          rw [(hSE (q - 1)).comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    have hShiftX : ∀ (s n₀ : ℕ),
        Subsingleton ((W (s + 1)).H (n₀ + 1)) → Subsingleton ((W s).H ((n₀ + 1) + 1)) := by
      intro s n₀ hSubNext
      refine ⟨fun a₁ a₂ => ?_⟩
      suffices hx0 : ∀ x₁ : (W s).H ((n₀ + 1) + 1), x₁ = 0 by
        rw [hx0 a₁, hx0 a₂]
      intro x₁
      let _ : CategoryTheory.Injective (I s) := hInj s
      have hx₁ :
          CategoryTheory.Abelian.Ext.comp x₁ (CategoryTheory.Abelian.Ext.mk₀ (j s))
            (Nat.add_zero ((n₀ + 1) + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X (hSE s) x₁ hx₁ rfl
      have hx₃_zero : x₃ = 0 := @Subsingleton.elim _ hSubNext _ 0
      rw [← hx₃, hx₃_zero, CategoryTheory.Abelian.Ext.zero_comp]
    have hUpward : ∀ k : ℕ, k ≤ q - 1 → Subsingleton ((W (q - 1 - k)).H (k + 1)) := by
      intro k
      induction k with
      | zero =>
        intro _
        rw [Nat.sub_zero]
        exact hSub_W1
      | succ k ih =>
        intro hk1
        set s := q - 1 - (k + 1)
        have hs : s + 1 = q - 1 - k := by omega
        have hIH : Subsingleton ((W (s + 1)).H (k + 1)) := by
          rw [hs]
          exact ih (by omega)
        exact hShiftX s k hIH
    have hFinal := hUpward (q - 1) (le_refl (q - 1))
    have hq_eq : (q - 1) + 1 = q := by omega
    rwa [Nat.sub_self, hW0, hq_eq] at hFinal

theorem weil_aff_cd_affineSpace_proj_leray_of_strictLocal_line (k : Type u) [Field k] [IsAlgClosed k]
    (m ℓ q : ℕ) [Fact (Nat.Prime ℓ)] (hm : 1 ≤ m) (hℓ : (ℓ : k) ≠ 0) (hq : m + 1 < q)
    (hSubAff : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ], (ℓ : κ) ≠ 0 →
      ∀ (e r : ℕ), e ≤ m → e < r →
      ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ)))
        [AlgebraicGeometry.IsAffine W.left] [AlgebraicGeometry.LocallyOfFiniteType W.hom],
        topologicalKrullDim W.left ≤ (e : WithBot ℕ∞) →
        ∀ (𝒢 : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 → Subsingleton (𝒢.H r))
    (hStalkSupp : ∀ (e r : ℕ), e ≤ m → e < r →
      ∀ (ℋ : CategoryTheory.Sheaf (weilAffineSpaceOver k m).left.smallEtaleTopology
          AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id ℋ = 0 →
        (∀ y : ↥(weilAffineSpaceOver k m).left,
          (e : WithBot ℕ∞) <
            topologicalKrullDim ↥(closure ({y} : Set ↥(weilAffineSpaceOver k m).left)) →
          WeilAltCdStalkZeroAt (weilAffineSpaceOver k m).left ℋ y) →
        Subsingleton (ℋ.H r))
    (hStrictLocalLine : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ], (ℓ : κ) ≠ 0 →
      ∀ (e b : ℕ), 2 ≤ e → e ≤ m + 1 → e < b →
      ∀ (R₁ : Type u) [CommRing R₁] [Algebra κ R₁] [Algebra.FiniteType κ R₁],
        ringKrullDim R₁ ≤ ((e - 1 : ℕ) : WithBot ℕ∞) →
        ∀ (σ : R₁ →ₐ[κ] κ)
          (ℱ₀ : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R₁))).smallEtaleTopology
            AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id ℱ₀ = 0 →
          ∀ (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ))),
            WeilAltCdStalkZeroAt (AlgebraicGeometry.Spec (CommRingCat.of R₁))
              (weilAltCdHigherDirectImage
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (Polynomial.C : R₁ →+* Polynomial R₁))) b ℱ₀)
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)).base pt))
    (ℱ : CategoryTheory.Sheaf (weilAffineSpaceOver k (m + 1)).left.smallEtaleTopology
      AddCommGrpCat.{u})
    (hℓ_ℱ : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0) :
    Subsingleton (ℱ.H q) :=
by
  obtain ⟨hc_all, hr_all, hSite⟩ := weil_etale_site_pullback_rightAdjoint_and_exact_package
  haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  have hEtDesc := weil_filtered_colimit_etale_presentation_and_cover_descent
  have hAff0 := weil_affine_filtered_ring_colimit_degree_zero (@hc_all) (@hr_all) hSite hEtDesc
  have hAffAll : ∀ b : ℕ, WeilAffineFilteredRingColimitAtDegreeHolds.{u} (@hc_all) (@hr_all) b :=
    fun b => weil_affine_filtered_ring_colimit_all_degrees_of_deg_zero
      (@hc_all) (@hr_all) hSite hEtDesc hAff0 b
  have hSliceIso := weil_etale_slice_cohomology_bijective (@hc_all) (@hr_all) hSite
  have hBaseExt := weil_etale_base_ext_functoriality_and_affine_slice_colimit (@hc_all) (@hr_all) hSite

  have hMapsTo_of_pull : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (r : ℕ)
      (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj F₀).H r),
      WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq F₀ r x₂
        (weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite π₁ π₂ h h_eq F₀ r x₂) := by
    intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq F₀ r x₂
    exact ⟨@hc_all Y₁ Y₂ h, @hr_all Y₁ Y₂ h, (hSite.1 h).1, (hSite.1 h).2.1,
      (hSite.1 h).2.2.1, (hSite.1 h).2.2.2, rfl⟩

  have hMapsTo_unique : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (r : ℕ)
      (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj F₀).H r)
      (y₁ y₂ : (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₁.smallEtaleTopology).obj F₀).H r),
      WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq F₀ r x₂ y₁ →
      WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq F₀ r x₂ y₂ →
      y₁ = y₂ := by
    intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq F₀ r x₂ y₁ y₂ h1 h2
    rcases h1 with ⟨hc1, hr1, hAdd1, hLim1, hColim1, hIso1, heq1⟩
    rcases h2 with ⟨hc2, hr2, hAdd2, hLim2, hColim2, hIso2, heq2⟩
    have : hc1 = hc2 := Subsingleton.elim _ _; subst this
    have : hr1 = hr2 := Subsingleton.elim _ _; subst this
    have : hAdd1 = hAdd2 := Subsingleton.elim _ _; subst this
    have : hLim1 = hLim2 := Subsingleton.elim _ _; subst this
    have : hColim1 = hColim2 := Subsingleton.elim _ _; subst this
    have : hIso1 = hIso2 := Subsingleton.elim _ _; subst this
    exact heq1.symm.trans heq2

  have hTor_pb : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂)
      (G : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      ℓ • CategoryTheory.CategoryStruct.id
        (((weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).obj G) = 0 := by
    intro Z₁ Z₂ f G hG
    let pb := (weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u}
      Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    haveI : pb.Additive := (hSite.1 f).1
    change ℓ • CategoryTheory.CategoryStruct.id (pb.obj G) = 0
    rw [← pb.map_id, ← pb.map_nsmul, hG, pb.map_zero]

  have hEtale_of_isPushout : ∀ {R A B₀ P : Type u} [CommRing R] [CommRing A] [CommRing B₀]
      [CommRing P] (f : R →+* A) (g : R →+* B₀) (inl : A →+* P) (inr : B₀ →+* P),
      CategoryTheory.IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
        (CommRingCat.ofHom inl) (CommRingCat.ofHom inr) →
      g.Etale → inl.Etale := by
    intro R A B₀ P _ _ _ _ f g inl inr hP hg
    haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have h1 : (CategoryTheory.Limits.pushout.inl
        (CommRingCat.ofHom f) (CommRingCat.ofHom g)).hom.Etale :=
      RingHom.Etale.isStableUnderBaseChange.pushout_inl RingHom.Etale.respectsIso
        (CommRingCat.ofHom f) (CommRingCat.ofHom g) hg
    have h1_sch : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map
          (CategoryTheory.Limits.pushout.inl (CommRingCat.ofHom f) (CommRingCat.ofHom g))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr h1
    let e := hP.isoPushout
    have heq : CommRingCat.ofHom inl =
        CategoryTheory.Limits.pushout.inl (CommRingCat.ofHom f) (CommRingCat.ofHom g) ≫ e.inv := by
      rw [← hP.inl_isoPushout_inv]
    have h_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inl)) := by
      rw [heq, AlgebraicGeometry.Spec.map_comp]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
        inferInstance h1_sch
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp h_sch

  
  let P_m := MvPolynomial (Fin m) k
  let P_m1 := MvPolynomial (Fin (m + 1)) k
  let B : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of P_m)
  let A_m1 : AlgebraicGeometry.Scheme.{u} := (weilAffineSpaceOver k (m + 1)).left
  let X : AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Spec (CommRingCat.of (Polynomial P_m))
  let e_alg := MvPolynomial.finSuccEquiv k m
  let f_XA : Quiver.Hom X A_m1 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom)
  let f_AX : Quiver.Hom A_m1 X :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)
  have h_ring_id : e_alg.symm.toRingHom.comp e_alg.toRingHom = RingHom.id P_m1 :=
    RingHom.ext fun z => e_alg.symm_apply_apply z
  have h_AX_XA : CategoryTheory.CategoryStruct.comp f_AX f_XA =
      CategoryTheory.CategoryStruct.id A_m1 := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of P_m1))
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_ring_id,
      CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  let ℱ₁ := ((weilEtaleSitePullback f_XA).sheafPullback AddCommGrpCat.{u}
    A_m1.smallEtaleTopology X.smallEtaleTopology).obj ℱ
  have hℓ_ℱ₁ : ℓ • CategoryTheory.CategoryStruct.id ℱ₁ = 0 := hTor_pb f_XA ℱ hℓ_ℱ

  
  let p_proj : Quiver.Hom X B :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : P_m →+* Polynomial P_m))

  have hKeyStalk : ∀ (b : ℕ), 2 ≤ b → ∀ (y : ↥B),
      (m + 1 < b ∨ ((m + 1 - b : ℕ) : WithBot ℕ∞) <
        topologicalKrullDim ↥(closure ({y} : Set ↥B))) →
      WeilAltCdStalkZeroAt B (weilAltCdHigherDirectImage p_proj b ℱ₁) y := by
    intro b hb2 y hy_cond
    apply (weil_aff_cd_poly_higherDirectImage_affine_stalk_bridge
      (@hc_all) (@hr_all) hSite hSliceIso hBaseExt b).1 P_m ℱ₁ y
    intro ev hker halg C₀ _ f_C₀ u₀ hf_C₀ hu₀ Z₀ π₀ 𝒢₀ ξ_id
    let κ : Type u := AlgebraicClosure ↥(B.residueField y)
    have hℓ_κ : (ℓ : κ) ≠ 0 := by
      let φ_kκ : k →+* κ := ev.comp (MvPolynomial.C : k →+* P_m)
      have hmap : φ_kκ (ℓ : k) = (ℓ : κ) := map_natCast φ_kκ ℓ
      rw [← hmap]
      exact (map_ne_zero_iff φ_kκ φ_kκ.injective).mpr hℓ
    obtain ⟨c, hc_le, ψ, K_sep, hField_Ksep, hAlg_Ksep, hPureInsep, φ_sep,
      ℐ, hSmall_ℐ, hFilt_ℐ, D, α_D, colim_c, hColim_c, e_pt,
      hDim_y, hcomp_φsep, hα_et, hα_comp, hGen, hNonGen⟩ :=
      weil_aff_cd_noether_proj_and_sepClosure_etale_colimit k m hm y κ ev hker halg
    letI : Field K_sep := hField_Ksep
    letI : Algebra K_sep κ := hAlg_Ksep
    letI : IsPurelyInseparable K_sep κ := hPureInsep
    letI : CategoryTheory.SmallCategory ℐ := hSmall_ℐ
    letI : CategoryTheory.IsFiltered ℐ := hFilt_ℐ

    have hb_gt : m + 1 - c < b := by
      rcases hy_cond with hgt | hlt_dim
      · omega
      · have hDim_y' : topologicalKrullDim ↥(closure ({y} : Set ↥B)) = (c : WithBot ℕ∞) := hDim_y
        rw [hDim_y'] at hlt_dim
        have hlt_nat : m + 1 - b < c := Nat.cast_lt.mp hlt_dim
        omega

    let P_c := MvPolynomial (Fin c) k
    let f_c : P_c →+* C₀ := f_C₀.comp ψ.toRingHom

    
    let B_sep_cat := CategoryTheory.Limits.pushout
      (CommRingCat.ofHom φ_sep) (CommRingCat.ofHom f_c)
    let B_sep : Type u := ↥B_sep_cat
    let i_sep : K_sep →+* B_sep :=
      (CategoryTheory.Limits.pushout.inl (CommRingCat.ofHom φ_sep) (CommRingCat.ofHom f_c)).hom
    let j_C₀ : C₀ →+* B_sep :=
      (CategoryTheory.Limits.pushout.inr (CommRingCat.ofHom φ_sep) (CommRingCat.ofHom f_c)).hom
    have hPush_sep : CategoryTheory.IsPushout
        (CommRingCat.ofHom φ_sep) (CommRingCat.ofHom f_c)
        (CommRingCat.ofHom i_sep) (CommRingCat.ofHom j_C₀) :=
      CategoryTheory.IsPushout.of_hasPushout
        (CommRingCat.ofHom φ_sep) (CommRingCat.ofHom f_c)
    have h_usep_w : CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_sep)
        (CommRingCat.ofHom (algebraMap K_sep κ)) =
        CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_c) (CommRingCat.ofHom u₀) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      have h1 : ev.comp ψ.toRingHom = u₀.comp f_c := by
        rw [← hu₀]
