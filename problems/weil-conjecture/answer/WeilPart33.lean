        change AlgebraicGeometry.IsFinite (e_Y'.inv ≫ g_left); infer_instance
      have hSurj_gspec : AlgebraicGeometry.Surjective g_spec := by
        change AlgebraicGeometry.Surjective (e_Y'.inv ≫ g_left); infer_instance
      let φ_B : CommRingCat.of (MvPolynomial (Fin 1) k) ⟶ B'_cat :=
        AlgebraicGeometry.Spec.preimage g_spec
      have hmap_φB : AlgebraicGeometry.Spec.map φ_B = g_spec :=
        AlgebraicGeometry.Spec.map_preimage g_spec
      have hFin_φB : RingHom.Finite φ_B.hom :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff φ_B).mp (by rw [hmap_φB]; exact hFin_gspec)
      have hInt_φB : RingHom.IsIntegral φ_B.hom := hFin_φB.to_isIntegral
      have hInj_φB : Function.Injective φ_B.hom := by
        rw [injective_iff_map_eq_zero]
        intro p hp
