    have hRs_mem : R_s ∈ S.smallEtaleTopology V := by
      refine hMemEtale.mpr fun x => ?_
      by_cases hxU : V.hom.base x ∈ (U : Set S)
      · let V_U : V.left.Opens := (TopologicalSpace.Opens.map V.hom.base).obj U
        have hW₀_et : AlgebraicGeometry.Etale (V_U.ι ≫ V.hom) := by
          have : AlgebraicGeometry.Etale V.hom := V.prop
          infer_instance
        let W₀ : S.Etale := MorphismProperty.Over.mk ⊤ (V_U.ι ≫ V.hom) hW₀_et
        let g₀ : W₀ ⟶ V := MorphismProperty.Over.homMk V_U.ι rfl trivial
        let x₀ : ↥W₀.left := ⟨x, hxU⟩
        have hInW₀ : InOpen W₀ := by
          rintro _ ⟨q, rfl⟩
          exact ⟨⟨V.hom.base q.1, q.2⟩, rfl⟩
        have hmem₀ := hMemEtale.mp
          (Presheaf.imageSieve_mem S.smallEtaleTopology
            (toSheafify S.smallEtaleTopology P_const_S) (oneR_S.obj.map g₀.op s)) x₀
        obtain ⟨W_x, h_x, w₀, ⟨r_x, hr_x⟩, hhx_et, hw₀_eq⟩ := hmem₀
        have hInWx : InOpen W_x := inOpen_of_hom h_x hInW₀
        let u_Wx : W_x ⟶ U_et := liftToU W_x hInWx
        let ι_LU : M_R ⟶ L_U.obj.obj (Opposite.op U_et) := Sheaf.freeYonedaHomEquiv (𝟙 L_U)
        have hι_κ : ι_LU ≫ κ.hom.app (Opposite.op U_et) = ηS_app U_et := by
          have h1 := hfy_comp (𝟙 L_U) κ
          rw [Category.id_comp] at h1
          exact h1.symm.trans (Equiv.apply_symm_apply _ _)
        refine ⟨W_x, h_x ≫ g₀, w₀, ?_, ?_, ?_⟩
        · refine ⟨L_U.obj.map u_Wx.op (ι_LU r_x), ?_⟩
          have hmor : ι_LU ≫ L_U.obj.map u_Wx.op ≫ κ.hom.app (Opposite.op W_x) = ηS_app W_x := by
            rw [κ.hom.naturality u_Wx.op, ← Category.assoc, hι_κ]
            exact hηS_nat u_Wx
          have heval : (κ.hom.app (Opposite.op W_x)) ((L_U.obj.map u_Wx.op) (ι_LU r_x)) =
              (ηS_app W_x) r_x :=
            (ConcreteCategory.comp_apply (L_U.obj.map u_Wx.op) (κ.hom.app (Opposite.op W_x))
              (ι_LU r_x)).symm.trans
              ((ConcreteCategory.comp_apply ι_LU _ r_x).symm.trans
                (congrArg (fun u => u r_x) hmor))
          have hηS_eq : η_sh_S = toSheafify S.smallEtaleTopology P_const_S :=
            sheafificationAdjunction_unit_app S.smallEtaleTopology P_const_S
          have hr_x' : (ηS_app W_x) r_x =
              oneR_S.obj.map h_x.op (oneR_S.obj.map g₀.op s) :=
            (congrArg (fun τ : P_const_S ⟶ oneR_S.obj => (τ.app (Opposite.op W_x)) r_x)
              hηS_eq).trans hr_x
          rw [heval, hr_x', ← ConcreteCategory.comp_apply, ← oneR_S.obj.map_comp, ← op_comp]
        · have : AlgebraicGeometry.Etale h_x.left := hhx_et
          have : AlgebraicGeometry.Etale g₀.left :=
            (inferInstance : AlgebraicGeometry.Etale V_U.ι)
          change AlgebraicGeometry.Etale (h_x.left ≫ g₀.left)
          infer_instance
        · change V_U.ι.base (h_x.left.base w₀) = x
          rw [hw₀_eq]
          rfl
      · have hxZ : V.hom.base x ∈ Set.range i.base := by
          rw [hU, Set.mem_compl_iff, Classical.not_not] at hxU
          exact hxU
        rcases hxZ with ⟨z₀, hz₀⟩
        have hmem₁ := hMemEtale.mp
          (Presheaf.imageSieve_mem S.smallEtaleTopology
            (toSheafify S.smallEtaleTopology P_const_S) s) x
        obtain ⟨V₁, v₁, x₁, ⟨r_val, hr_val⟩, hv₁_et, hx₁_eq⟩ := hmem₁
        have hv₁_z₀ : V₁.hom.base x₁ = i.base z₀ := by
          have hw : V₁.hom.base x₁ = V.hom.base (v₁.left.base x₁) := by
            change V₁.hom.base x₁ = (v₁.left ≫ V.hom).base x₁
            rw [MorphismProperty.Over.w v₁]
          rw [hw, hx₁_eq, hz₀]
        obtain ⟨z₁, _, _⟩ := Scheme.Pullback.exists_preimage_pullback x₁ z₀ hv₁_z₀
        have hηS_eq : η_sh_S = toSheafify S.smallEtaleTopology P_const_S :=
          sheafificationAdjunction_unit_app S.smallEtaleTopology P_const_S
        have hηZ_eq : η_sh_Z = toSheafify Z.smallEtaleTopology P_const_Z :=
          sheafificationAdjunction_unit_app Z.smallEtaleTopology P_const_Z
        let r_Z : ToType (P_const_Z.obj (Opposite.op (B.obj V₁))) := r_val
        let z_Z : ToType (P_const_Z.obj (Opposite.op (B.obj V₁))) := 0
        have hr_Z_zero : ((toSheafify Z.smallEtaleTopology P_const_Z).app
