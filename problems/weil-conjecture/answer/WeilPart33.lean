      exact fun P hP => RingHom.mem_ker.mp (hle hP)
    let bar_ev := Ideal.Quotient.lift I_slice ev_slice h_ker_ev_slice
    let inc_slice := (Ideal.Quotient.mk I_slice).comp (MvPolynomial.rename inl_var).toRingHom
    have h_ker_inc_slice : ∀ P ∈ I_G, inc_slice P = 0 := by
      have hle : I_G ≤ RingHom.ker inc_slice := Ideal.span_le.mpr fun x hEq => by
        rw [Set.mem_singleton_iff] at hEq
        rw [hEq, SetLike.mem_coe, RingHom.mem_ker]
        change Ideal.Quotient.mk I_slice (MvPolynomial.rename inl_var G) = 0
        have hFi0 : MvPolynomial.rename inl_var G = F_slice i_0 := by simp [F_slice]
        rw [hFi0]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i_0))
      exact fun P hP => RingHom.mem_ker.mp (hle hP)
    let bar_inc := Ideal.Quotient.lift I_G inc_slice h_ker_inc_slice
    have hev_inc_G : bar_ev.comp bar_inc = RingHom.id Q_G := by
      apply Ideal.Quotient.ringHom_ext
      apply RingHom.ext
      intro P
      change ev_slice (MvPolynomial.rename inl_var P) = Ideal.Quotient.mk I_G P
      exact hev_rename P
    have hinc_ev_G : bar_inc.comp bar_ev = RingHom.id Q_slice := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        change bar_inc (ev_slice (MvPolynomial.C c)) = Ideal.Quotient.mk I_slice (MvPolynomial.C c)
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        change inc_slice (MvPolynomial.C c) = _
        simp [inc_slice]
      · intro v
        change bar_inc (ev_slice (MvPolynomial.X v)) = Ideal.Quotient.mk I_slice (MvPolynomial.X v)
        rw [MvPolynomial.eval₂Hom_X']
        obtain ⟨w, rfl⟩ := e_vars.surjective v
        cases w with
        | inl b =>
          simp only [var_val, Equiv.symm_apply_apply, Sum.elim_inl]
