    let n := s + 1 + d
    
    let L0 : Fin 3 → MvPolynomial (Fin n) k := fun r => Classical.choose (hSurj_φ (ℓ_r r))
    have hL0 : ∀ r : Fin 3, φ (L0 r) = ℓ_r r :=
