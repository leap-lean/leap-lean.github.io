          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom P_pkg.e_Y0)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.Etale)).mpr P_pkg.he_Y0_et
      dsimp [e_Y0_sch]
      infer_instance
    have hComm_0_sch : e_Y0_sch ≫ g₂.left =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (P_pkg.q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) ≫ e_B0 := by
      have hhom0 :
          CommRingCat.ofHom
              ((Ideal.Quotient.mk (Ideal.span ({G_poly} : Set _))).comp
                (MvPolynomial.map (algebraMap k A_Z))) ≫
            (CommRingCat.ofHom P_pkg.e_Y0 : _ ⟶ P_pkg.B'_0) =
          (CommRingCat.ofHom P_pkg.φ_P : _ ⟶ P_pkg.R'_0) ≫
            (CommRingCat.ofHom (P_pkg.q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) :
              P_pkg.R'_0 ⟶ P_pkg.B'_0) :=
        CommRingCat.hom_ext P_pkg.hComm_0
      dsimp only [e_Y0_sch, e_B0]
      rw [CategoryTheory.Category.assoc, hj_Q_comm, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, hhom0, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc]
    exact hModFib Y₂.left (weilProjectiveSpaceOver k 2).left g₂.left U₂_sm hSm_g₂_U₂
      P_pkg.R'_0 P_pkg.B'_0 h_0 e_B0 he_B0_et e_Y0_sch he_Y0_et P_pkg.q_0 P_pkg.hq_0_et
      hComm_0_sch (P_pkg.φ_P.comp MvPolynomial.C) ε_u hεu_id hεu_h0 v_0 hv_0_u hv_0_X hMem_U₂
  · 
    intro g_match hε_match R_loc _ _ _
    let g_tot : P_pkg.R'_0 := g_exc * g_match
    obtain ⟨B'_2, ι_B, q_loc, hEt_φloc, hEt_eYloc, hEt_qloc, hComm_loc, hLift_R, hLift_B⟩ :=
      hModLoc Q_ring P_pkg.R'_0 P_pkg.B'_0 f_base P_pkg.φ_P P_pkg.hφ_P_et
        h_0 g_tot R_loc P_pkg.e_Y0 P_pkg.he_Y0_et P_pkg.q_0 P_pkg.hq_0_et P_pkg.hComm_0
    let e_Bloc : AlgebraicGeometry.Spec (CommRingCat.of R_loc) ⟶
        (weilProjectiveSpaceOver k 2).left :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P)) ≫ j_P
    let e_Y2 : AlgebraicGeometry.Spec B'_2 ⟶ Y₂.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B.comp P_pkg.e_Y0) : _ ⟶ B'_2) ≫ j_Q
    let q_2 : AlgebraicGeometry.Spec B'_2 ⟶
        AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin (m + 1) × Fin 2) R_loc ⧸ Ideal.span
            {(∑ j : Fin (m + 1),
                (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R_loc) *
                  MvPolynomial.X (j, 1)) -
              MvPolynomial.C (algebraMap P_pkg.R'_0 R_loc h_0)})) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_loc : _ ⟶ B'_2)
    have he_Bloc_et : AlgebraicGeometry.Etale e_Bloc := by
      have : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P))) := hEt_φloc
      dsimp [e_Bloc]
      infer_instance
    have he_Y2_et : AlgebraicGeometry.Etale e_Y2 := by
      have : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B.comp P_pkg.e_Y0) : _ ⟶ B'_2)) :=
        hEt_eYloc
      dsimp [e_Y2]
      infer_instance
    have hComm_2 : e_Y2 ≫ g₂.left =
        q_2 ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_Bloc := by
      have hhom2 :
          CommRingCat.ofHom
              ((Ideal.Quotient.mk (Ideal.span ({G_poly} : Set _))).comp
                (MvPolynomial.map (algebraMap k A_Z))) ≫
            (CommRingCat.ofHom (ι_B.comp P_pkg.e_Y0) : _ ⟶ B'_2) =
          CommRingCat.ofHom ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P) ≫
            CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) ≫
            (CommRingCat.ofHom q_loc : _ ⟶ B'_2) :=
        CommRingCat.hom_ext hComm_loc
      dsimp only [e_Y2, q_2, e_Bloc]
      rw [CategoryTheory.Category.assoc, hj_Q_comm, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, hhom2,
        AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    let u_orig : PrimeSpectrum P_pkg.R'_0 :=
      ⟨RingHom.ker P_pkg.ε_R, RingHom.ker_isPrime P_pkg.ε_R⟩
    have hg_tot_not_orig : g_tot ∉ u_orig.asIdeal := by
      change P_pkg.ε_R (g_exc * g_match) ≠ 0
      rw [map_mul]
      exact mul_ne_zero hε_exc hε_match
    obtain ⟨u_2_ps, hu_2_orig⟩ := hLift_R u_orig hg_tot_not_orig
    let u_2 : AlgebraicGeometry.Spec (CommRingCat.of R_loc) := u_2_ps
    have hh0_orig : h_0 ∈ u_orig.asIdeal := by
      change P_pkg.ε_R (P_pkg.τ_crit G_poly) = 0
      rw [P_pkg.hε_R_τ]
      dsimp [G_poly]
      simp only [MvPolynomial.eval₂_add, MvPolynomial.eval₂_C, MvPolynomial.eval₂_mul,
        MvPolynomial.eval₂_X, hε_ℓ0, Pi.zero_apply, zero_mul, add_zero]
    have hu_2_h0 : algebraMap P_pkg.R'_0 R_loc h_0 ∈ u_2.asIdeal := by
      change h_0 ∈ (PrimeSpectrum.comap (algebraMap P_pkg.R'_0 R_loc) u_2_ps).asIdeal
      rw [hu_2_orig]
      exact hh0_orig
    have hu_2_X : ∀ b : Fin 2,
        ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P) (MvPolynomial.X b) ∈ u_2.asIdeal := by
      intro b
      change P_pkg.φ_P (MvPolynomial.X b) ∈
        (PrimeSpectrum.comap (algebraMap P_pkg.R'_0 R_loc) u_2_ps).asIdeal
      rw [hu_2_orig]
      change P_pkg.ε_R (P_pkg.φ_P (MvPolynomial.X b)) = 0
      rw [P_pkg.hε_R_φ, MvPolynomial.eval_X, Pi.zero_apply]
    obtain ⟨v_orig, hv_orig_q, hv_orig_u, hv_orig_X, hv_orig_C⟩ :=
      P_pkg.hSec_surj u_orig hh0_orig
    obtain ⟨v_2_ps, hv_2_orig, _, hv_2_X_imp, hv_2_C_imp⟩ :=
      hLift_B u_2_ps v_orig (hv_orig_u.trans hu_2_orig.symm)
    let v_2 : AlgebraicGeometry.Spec B'_2 := v_2_ps
    have hv0_eq_qorig : ∀ v'_0 : PrimeSpectrum P_pkg.B'_0,
        PrimeSpectrum.comap (P_pkg.e_Y0.comp (Ideal.Quotient.mk I_G)) v'_0 =
          PrimeSpectrum.comap P_pkg.τ_crit u_orig →
        PrimeSpectrum.comap P_pkg.e_Y0 v'_0 = q_orig := by
      intro v'_0 hv'
      apply PrimeSpectrum.comap_injective_of_surjective
        (Ideal.Quotient.mk I_G) Ideal.Quotient.mk_surjective
      change PrimeSpectrum.comap (P_pkg.e_Y0.comp (Ideal.Quotient.mk I_G)) v'_0 = _
      rw [hv']
      apply PrimeSpectrum.ext
      ext F
      change P_pkg.ε_R (P_pkg.τ_crit F) = 0 ↔ ε_Q (Ideal.Quotient.mk I_G F) = 0
      rw [P_pkg.hε_R_τ, hε_Q]
    have hv_orig_eq_q : PrimeSpectrum.comap P_pkg.e_Y0 v_orig = q_orig :=
      hv0_eq_qorig v_orig hv_orig_q
    have he_Y2_v2 : e_Y2.base v_2 = j_Q.base q_orig := by
      change j_Q.base (PrimeSpectrum.comap P_pkg.e_Y0 (PrimeSpectrum.comap ι_B v_2_ps)) = _
      rw [hv_2_orig, hv_orig_eq_q]
    refine ⟨B'_2, u_2, v_2, e_Y2, q_2, he_Bloc_et, he_Y2_et, hEt_qloc, hComm_2,
      hu_2_h0, hu_2_X, ?_, ?_, ?_, ?_⟩
    · intro idx
      exact hv_2_X_imp hv_orig_X idx
    · exact hv_2_C_imp hv_orig_C
    · intro pt
      have hpt_bot : pt.asIdeal = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        by_contra hx0
        exact pt.isPrime.ne_top (pt.asIdeal.eq_top_of_isUnit_mem hx (IsUnit.mk0 x hx0))
      refine ⟨?_, ?_⟩
      · change j_P.base (PrimeSpectrum.comap P_pkg.φ_P
            (PrimeSpectrum.comap (algebraMap P_pkg.R'_0 R_loc) u_2_ps)) =
          j_P.base ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k)))).base pt)
        rw [hu_2_orig]
        congr 1
        let pt_P : PrimeSpectrum (MvPolynomial (Fin 2) k) :=
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k)))).base pt
        have hideal : (PrimeSpectrum.comap P_pkg.φ_P u_orig).asIdeal = pt_P.asIdeal := by
          ext P
          change P_pkg.ε_R (P_pkg.φ_P P) = 0 ↔ MvPolynomial.eval (0 : Fin 2 → k) P ∈ pt.asIdeal
          rw [P_pkg.hε_R_φ, hpt_bot, Ideal.mem_bot]
        exact PrimeSpectrum.ext hideal
      · rw [he_Y2_v2]
        exact hy_pt_eq pt
    · intro u hu_h0
      let u_ps : PrimeSpectrum R_loc := u
      let u_0 : PrimeSpectrum P_pkg.R'_0 :=
        PrimeSpectrum.comap (algebraMap P_pkg.R'_0 R_loc) u_ps
      have hh0_u0 : h_0 ∈ u_0.asIdeal := hu_h0
      have hg_exc_not_u0 : g_exc ∉ u_0.asIdeal := by
        intro hg_mem
        have hgtot_mem : g_tot ∈ u_0.asIdeal := u_0.asIdeal.mul_mem_right g_match hg_mem
        have hunit : IsUnit (algebraMap P_pkg.R'_0 R_loc g_tot) :=
          IsLocalization.Away.algebraMap_isUnit (S := R_loc) g_tot
        exact u_ps.isPrime.ne_top (u_ps.asIdeal.eq_top_of_isUnit_mem hgtot_mem hunit)
      obtain ⟨v_0, hv_0_q, hv_0_u0, hv_0_X, hv_0_C⟩ := P_pkg.hSec_surj u_0 hh0_u0
      obtain ⟨v_ps, hv_v0, hv_u, hv_X_imp, hv_C_imp⟩ := hLift_B u_ps v_0 hv_0_u0
      let v : AlgebraicGeometry.Spec B'_2 := v_ps
      have hqv_u :
          (q_2 ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))).base v = u := by
        have hcomp_eq : q_2 ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (q_loc.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
          dsimp [q_2]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rw [hcomp_eq]
        exact hv_u
      refine ⟨v, hqv_u, fun idx => hv_X_imp hv_0_X idx, hv_C_imp hv_0_C, ?_, ?_⟩
      · intro hu_eq
        have hu0_eq : u_0 = u_orig := by
          change PrimeSpectrum.comap (algebraMap P_pkg.R'_0 R_loc) u = _
          rw [hu_eq]
          exact hu_2_orig
        have hv0_eq : PrimeSpectrum.comap P_pkg.e_Y0 v_0 = q_orig := by
          apply hv0_eq_qorig
          rwa [← hu0_eq]
        rw [he_Y2_v2]
        change j_Q.base (PrimeSpectrum.comap P_pkg.e_Y0 (PrimeSpectrum.comap ι_B v_ps)) = _
        rw [hv_v0, hv0_eq]
      · intro y' hy'_eq hy'_ne
        have hy'_u0 : g₂.left.base y' =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom P_pkg.φ_P) ≫ j_P).base u_0 :=
          hy'_eq
        rcases hExc u_0 hg_exc_not_u0 y' hy'_u0 with hSm | ⟨_, q, hjQ_q, hcomap_q⟩
        · exact hSm
        · exfalso
          have hq_eq : (q : PrimeSpectrum Q_ring) = PrimeSpectrum.comap P_pkg.e_Y0 v_0 := by
            apply PrimeSpectrum.comap_injective_of_surjective
              (Ideal.Quotient.mk I_G) Ideal.Quotient.mk_surjective
            exact hcomap_q.trans hv_0_q.symm
          have heY2_v : e_Y2.base v = y' := by
            change j_Q.base (PrimeSpectrum.comap P_pkg.e_Y0 (PrimeSpectrum.comap ι_B v_ps)) = y'
            rw [hv_v0, ← hq_eq]
            exact hjQ_q
          exact hy'_ne heY2_v.symm

theorem weil_algClosed_jacobson_closedPoint_finite_subcover (k : Type u) [Field k] [IsAlgClosed k] (N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : X ⟶ weilProjectiveSpaceOver k N)
    (hCl_X : AlgebraicGeometry.IsClosedImmersion ι_X.left)
    (U : X.left.Opens)
    (W : { c : X.left // c ∈ U ∧ IsClosed ({c} : Set X.left) } →
      (weilProjectiveSpaceOver k N).left.Opens)
    (hW : ∀ p : { c : X.left // c ∈ U ∧ IsClosed ({c} : Set X.left) },
      ι_X.left.base p.1 ∈ W p) :
    ∃ (r_chart : ℕ)
      (idx : Fin r_chart → { c : X.left // c ∈ U ∧ IsClosed ({c} : Set X.left) }),
      ∀ c : X.left, c ∈ U → ∃ α : Fin r_chart, ι_X.left.base c ∈ W (idx α) :=
by
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
    MvPolynomial.gradedAlgebra
  have hSurj₀ : Function.Surjective
      ⇑(Algebra.ofId k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) := by
    intro x
    have hcomp1 : MvPolynomial.homogeneousComponent 0 x.1 = x.1 := by
      simpa using MvPolynomial.homogeneousComponent_of_mem x.2 (m := 0)
    rw [MvPolynomial.homogeneousComponent_zero] at hcomp1
    have hofC : ∀ c : k, MvPolynomial.C c = x.1 →
        ∃ a : k, (Algebra.ofId k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) a = x := by
      intro c hc
      refine ⟨c, Subtype.ext ?_⟩
      change ↑((algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c) = x.1
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      exact hc
    exact hofC _ hcomp1
  haveI : Algebra.FiniteType k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) :=
    Algebra.FiniteType.of_surjective _ hSurj₀
  haveI : IsNoetherianRing ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) :=
    Algebra.FiniteType.isNoetherianRing k _
  haveI : IsJacobsonRing ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) :=
    isJacobsonRing_of_finiteType (A := k)
  haveI : IsScalarTower k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)
      (MvPolynomial (Fin (N + 1)) k) :=
    IsScalarTower.of_algebraMap_eq fun c =>
      ((SetLike.GradeZero.algebraMap_apply
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        ((algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c)).trans
        (SetLike.GradeZero.coe_algebraMap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c)).symm
  haveI : Algebra.FiniteType ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)
      (MvPolynomial (Fin (N + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k _ _
  have hJac_P := AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace
    (AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k))
  haveI : JacobsonSpace ↥(weilProjectiveSpaceOver k N).left := hJac_P
  haveI : AlgebraicGeometry.IsLocallyNoetherian
      (AlgebraicGeometry.Spec (CommRingCat.of
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) :=
    AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
  have hLocNoeth_P0 := AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
    (AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k))
  have hLocNoeth_P : AlgebraicGeometry.IsLocallyNoetherian
      (weilProjectiveSpaceOver k N).left := hLocNoeth_P0
  have hComp_univ_P : IsCompact (Set.univ : Set ↥(weilProjectiveSpaceOver k N).left) := by
    have hpre := AlgebraicGeometry.QuasiCompact.isCompact_preimage
      (f := AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k))
      Set.univ isOpen_univ isCompact_univ
    rw [Set.preimage_univ] at hpre
    exact hpre
  have hComp_P : CompactSpace ↥(weilProjectiveSpaceOver k N).left :=
    ⟨hComp_univ_P⟩
  haveI : AlgebraicGeometry.IsNoetherian (weilProjectiveSpaceOver k N).left :=
    (AlgebraicGeometry.isNoetherian_iff (weilProjectiveSpaceOver k N).left).mpr
      ⟨hLocNoeth_P, hComp_P⟩
  haveI : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N).left :=
    AlgebraicGeometry.IsNoetherian.noetherianSpace
  haveI : AlgebraicGeometry.IsClosedImmersion ι_X.left := hCl_X
  have hEmb : Topology.IsClosedEmbedding ⇑ι_X.left :=
    AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_X.left
  have hJac_X : JacobsonSpace ↥X.left :=
    JacobsonSpace.of_isClosedEmbedding hEmb
  have hNoeth_X : TopologicalSpace.NoetherianSpace ↥X.left :=
    hEmb.isEmbedding.isInducing.noetherianSpace
  let S_cl := { c : X.left // c ∈ U ∧ IsClosed ({c} : Set X.left) }
  let V : S_cl → Set ↥X.left := fun p => ι_X.left.base ⁻¹' (W p : Set _)
  have hOpen_V : ∀ p : S_cl, IsOpen (V p) :=
    fun p => (W p).isOpen.preimage ι_X.left.continuous
  have hSub : (U : Set ↥X.left) ⊆ ⋃ p : S_cl, V p := by
    intro x hxU
    by_contra hxNot
    let Z : Set ↥X.left := (U : Set ↥X.left) ∩ (⋃ p : S_cl, V p)ᶜ
    have hZ_ne : Z.Nonempty := ⟨x, hxU, hxNot⟩
    have hZ_lc : IsLocallyClosed Z :=
      U.isOpen.isLocallyClosed.inter (isOpen_iUnion hOpen_V).isClosed_compl.isLocallyClosed
    obtain ⟨c₀, hc₀⟩ := (jacobsonSpace_iff_locallyClosed.mp hJac_X) Z hZ_ne hZ_lc
    have hc₀_U : c₀ ∈ U := hc₀.1.1
    have hc₀_not : c₀ ∉ ⋃ p : S_cl, V p := hc₀.1.2
    have hc₀_cl : IsClosed ({c₀} : Set ↥X.left) := mem_closedPoints_iff.mp hc₀.2
    let p₀ : S_cl := ⟨c₀, hc₀_U, hc₀_cl⟩
    exact hc₀_not (Set.mem_iUnion.mpr ⟨p₀, hW p₀⟩)
  have hComp_U : IsCompact (U : Set ↥X.left) :=
    @TopologicalSpace.NoetherianSpace.isCompact ↥X.left _ hNoeth_X (U : Set ↥X.left)
  obtain ⟨t, hFin⟩ := IsCompact.elim_finite_subcover hComp_U V hOpen_V hSub
  refine ⟨t.card, fun α => (t.equivFin.symm α).1, fun c hc => ?_⟩
  obtain ⟨p, hp, hcV⟩ := Set.mem_iUnion₂.mp (hFin hc)
  refine ⟨t.equivFin ⟨p, hp⟩, ?_⟩
  dsimp only
  have hp_eq : (t.equivFin.symm (t.equivFin ⟨p, hp⟩)).1 = p :=
    congrArg Subtype.val (t.equivFin.symm_apply_apply ⟨p, hp⟩)
  rwa [hp_eq]

theorem weil_algClosed_net_2d_odp_atlas_over_disc (k : Type u) [Field k] [IsAlgClosed k]
    (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hVer : IsCubicVeroneseEmbeddedOver k m M Z_bar ι_bar)
    (D_net : WeilAlgClosedDualNetAndPencilLine k m M Z_bar ι_bar)
    (I_inc : WeilAlgClosedIncidenceSlicePackage k m M Z_bar ι_bar
      D_net.L D_net.j_aff D_net.ι_line D_net.u_val)
    (S_aff : Finset k)
    (U₀ : (weilProjectiveSpaceOver k 1).left.Opens)
    (D_disc : ℕ)
    (P_disc : MvPolynomial (Fin 3) k)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver k 2)
    (U_disc_reg : C_disc.left.Opens)
    (hD_pos : 1 ≤ D_disc)
    (hP_irr : Irreducible P_disc)
    (hHyp_disc : IsHomogeneousHypersurfacePullbackOver k 2 D_disc
      (𝟙 (weilProjectiveSpaceOver k 2)) P_disc ι_disc.left)
    (hInt_disc : AlgebraicGeometry.IsIntegral C_disc.left)
    (hProp_disc : AlgebraicGeometry.IsProper C_disc.hom)
    (hUdisc_ne : Nonempty U_disc_reg)
    (hSm_Udisc : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom))
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver k 1).left) =
