          ((m.hom.app opU) s₀) (evalPt U₀ s₀) ?_
        intro V g hmem
        rcases hmem with ⟨j, hj⟩
        rw [heval_spec U₀ s₀ g j hj]
        have hnat_m := congrArg
          (fun (f : ℱ.obj.obj opU ⟶ t.pt.obj.obj (Opposite.op V)) => f s₀)
