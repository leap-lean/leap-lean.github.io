        refine hSheafSep t.pt U₂ R₂ hR₂
          (evalPt U₂ (ℱ.obj.map f s₁))
          (t.pt.obj.map f (evalPt U₁ s₁)) ?_
        intro V g hmem
        rcases hmem with ⟨j, hj⟩
        have hcomp_s : ℱ.obj.map (Opposite.op g) (ℱ.obj.map f s₁) =
            ℱ.obj.map (Opposite.op (g ≫ u)) s₁ :=
