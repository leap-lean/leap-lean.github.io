      fun C _ f _ =>
        letI : Algebra R C := f.toAlgebra
        let e_alg := polyEquivTensor' R C
        let e_poly_iso : CategoryTheory.Iso
            (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial C)))
            (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R C (Polynomial R)))) :=
          { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)
            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom)
            hom_inv_id := (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
              ((congrArg AlgebraicGeometry.Spec.map
                ((CommRingCat.ofHom_comp _ _).symm.trans
                  (CommRingCat.hom_ext (RingHom.ext e_alg.symm_apply_apply)))).trans
                (AlgebraicGeometry.Spec.map_id _))
            inv_hom_id := (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
              ((congrArg AlgebraicGeometry.Spec.map
                ((CommRingCat.ofHom_comp _ _).symm.trans
