        MvPolynomial.monomial n c = MvPolynomial.C c * s ^ (n 0) * t ^ (n 1) := by
      intro n c
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two, ← mul_assoc]
    have hsq_mon : ∀ (n : Fin 2 →₀ ℕ) (c : k),
        sq (MvPolynomial.monomial n c) = MvPolynomial.monomial (n + n) c := by
      intro n c
      rw [hmon_eq n c, hmon_eq (n + n) c, Finsupp.add_apply, Finsupp.add_apply]
      have hs_sq : sq s = s ^ 2 := by
        change φ_raw (ι01 (MvPolynomial.X 0)) = s ^ 2
        rw [hι01_X, show (0 : Fin 2).castSucc = (0 : Fin 3) from rfl, hφ_X]
        rfl
      have ht_sq : sq t = t ^ 2 := by
        change φ_raw (ι01 (MvPolynomial.X 1)) = t ^ 2
        rw [hι01_X, show (1 : Fin 2).castSucc = (1 : Fin 3) from rfl, hφ_X]
        rfl
      have hc_sq : sq (MvPolynomial.C c) = MvPolynomial.C c := by
        change φ_raw (ι01 (MvPolynomial.C c)) = MvPolynomial.C c
        rw [hι01_C, hφ_C]
      simp only [map_mul, map_pow, hc_sq, hs_sq, ht_sq]
      ring
    let e01 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
    have hst_sq_mon : ∀ (n : Fin 2 →₀ ℕ) (c : k),
        (s * t) * sq (MvPolynomial.monomial n c) = MvPolynomial.monomial (n + n + e01) c := by
      intro n c
      rw [hsq_mon, hmon_eq (n + n) c, hmon_eq (n + n + e01) c]
      have he0 : (n + n + e01) 0 = (n + n) 0 + 1 := by simp [e01]
      have he1 : (n + n + e01) 1 = (n + n) 1 + 1 := by simp [e01]
      rw [he0, he1]
      ring
    have hsq_coeff : ∀ P : P₂,
        (∀ d : Fin 2 →₀ ℕ, d 0 % 2 = 1 → (sq P).coeff d = 0) ∧
        (∀ m : Fin 2 →₀ ℕ, (sq P).coeff (m + m) = P.coeff m) := by
      intro P
      induction P using MvPolynomial.induction_on' with
      | monomial n c =>
        rw [hsq_mon]
        refine ⟨fun d hd => ?_, fun m => ?_⟩
        · rw [MvPolynomial.coeff_monomial]
          split_ifs with h
          · exfalso
            have h0 := congrArg (fun f : Fin 2 →₀ ℕ => f 0) h
            simp only [Finsupp.add_apply] at h0
            omega
          · rfl
        · rw [MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial]
          have hiff : n + n = m + m ↔ n = m := by
            constructor
            · intro h
              ext j
              have hj := congrArg (fun f : Fin 2 →₀ ℕ => f j) h
              simp only [Finsupp.add_apply] at hj
              omega
            · intro h; subst h; rfl
          simp [hiff]
      | add p₁ p₂ ih₁ ih₂ =>
        rw [map_add]
        refine ⟨fun d hd => ?_, fun m => ?_⟩
        · rw [MvPolynomial.coeff_add, ih₁.1 d hd, ih₂.1 d hd, add_zero]
        · rw [MvPolynomial.coeff_add, MvPolynomial.coeff_add, ih₁.2 m, ih₂.2 m]
    have hst_coeff : ∀ P : P₂,
        (∀ m : Fin 2 →₀ ℕ, ((s * t) * sq P).coeff (m + m) = 0) ∧
        (∀ m : Fin 2 →₀ ℕ, ((s * t) * sq P).coeff (m + m + e01) = P.coeff m) := by
      intro P
      induction P using MvPolynomial.induction_on' with
      | monomial n c =>
        rw [hst_sq_mon]
        refine ⟨fun m => ?_, fun m => ?_⟩
        · rw [MvPolynomial.coeff_monomial]
          split_ifs with h
          · exfalso
            have h0 := congrArg (fun f : Fin 2 →₀ ℕ => f 0) h
            simp [e01] at h0
            omega
          · rfl
        · rw [MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial]
          have hiff : n + n + e01 = m + m + e01 ↔ n = m := by
            constructor
            · intro h
              ext j
              revert j
              rw [Fin.forall_fin_two]
              have h0 := congrArg (fun f : Fin 2 →₀ ℕ => f 0) h
              have h1 := congrArg (fun f : Fin 2 →₀ ℕ => f 1) h
              simp [e01] at h0 h1
              omega
            · intro h; subst h; rfl
          simp [hiff]
      | add p₁ p₂ ih₁ ih₂ =>
        rw [map_add, mul_add]
        refine ⟨fun m => ?_, fun m => ?_⟩
        · rw [MvPolynomial.coeff_add, ih₁.1 m, ih₂.1 m, add_zero]
        · rw [MvPolynomial.coeff_add, MvPolynomial.coeff_add, ih₁.2 m, ih₂.2 m]
    rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
    intro b hb
    rw [Submodule.mem_bot]
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨P₀, P₁, hF_eq⟩ := hNormForm F
    change mk_B2 F = 0
    rw [RingHom.mem_ker] at hb
    change φ_cone (mk_B2 F) = 0 at hb
    rw [hF_eq, hφ_mk] at hb
    have hsum_zero : sq P₀ + (s * t) * sq P₁ = 0 := by
      have hX2 : φ_raw (MvPolynomial.X 2) = s * t := hφ_X 2
      rw [map_add, map_mul, hX2] at hb
      exact hb
    have hP0_zero : P₀ = 0 := by
      ext m
      have hm := congrArg (fun p : P₂ => p.coeff (m + m)) hsum_zero
      rw [MvPolynomial.coeff_add, (hsq_coeff P₀).2 m, (hst_coeff P₁).1 m, add_zero,
        MvPolynomial.coeff_zero] at hm
      exact hm
    have hP1_zero : P₁ = 0 := by
      ext m
      have hm := congrArg (fun p : P₂ => p.coeff (m + m + e01)) hsum_zero
      have hodd : (m + m + e01) 0 % 2 = 1 := by
        have h0 : (m + m + e01) 0 = m 0 + m 0 + 1 := by simp [e01]
        omega
      rw [MvPolynomial.coeff_add, (hsq_coeff P₀).1 _ hodd, (hst_coeff P₁).2 m, zero_add,
        MvPolynomial.coeff_zero] at hm
      exact hm
    rw [hF_eq, hP0_zero, hP1_zero, map_zero, mul_zero, add_zero, map_zero]
  letI : Algebra B₂ P₂ := φ_cone.toAlgebra
  let R_loc : Type u := Localization.AtPrime q
  let R_tilde : Type u := TensorProduct B₂ P₂ R_loc
  let ι_R : R_loc →+* R_tilde :=
