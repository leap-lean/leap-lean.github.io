  have hs_sq_tmul : (s ⊗ₜ[B₂] (1 : R_loc)) ^ 2 =
      (1 : P₂) ⊗ₜ[B₂] (algebraMap B₂ R_loc (mk_B2 (MvPolynomial.X 0))) := by
    have h1 : (s ⊗ₜ[B₂] (1 : R_loc)) ^ 2 = (s ^ 2) ⊗ₜ[B₂] (1 : R_loc) := by
      rw [pow_two (s ⊗ₜ[B₂] (1 : R_loc)), Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← pow_two s]
    have h2 : s ^ 2 = φ_cone (mk_B2 (MvPolynomial.X 0)) := (hφ_X 0).symm
    rw [h1, h2, htmul_alg]
