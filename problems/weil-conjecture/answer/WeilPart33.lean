        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext; intro c; simp
        · intro r; simp [w]
      have hev_F : MvPolynomial.eval u (MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β) F) =
