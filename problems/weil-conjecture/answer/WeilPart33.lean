              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g₁)) :=
          (congrArg (fun m => CategoryTheory.CategoryStruct.comp m _)
            (CategoryTheory.MorphismProperty.Over.pullback_map_left
              (@AlgebraicGeometry.Etale) ⊤ p (w_of R f₀ hf₀ g₁ hf₁))).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have h_ring : (Polynomial.mapRingHom g₁).comp Polynomial.C = Polynomial.C.comp g₁ :=
