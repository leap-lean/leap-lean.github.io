by
  
  have hRelFrobBij : ∀ (p₀ : ℕ) [Fact (Nat.Prime p₀)]
      (R A B : Type u) [CommRing R] [CommRing A] [CommRing B],
      (p₀ : R) = 0 →
      ∀ (f : R →+* A), f.Etale →
      ∀ (φ_R : R →+* R), (∀ r₀ : R, φ_R r₀ = r₀ ^ p₀) →
      ∀ (φ_A : A →+* A), (∀ a : A, φ_A a = a ^ p₀) →
      ∀ (inl_R : R →+* B) (inr_A : A →+* B),
      CategoryTheory.IsPushout
        (CommRingCat.ofHom φ_R) (CommRingCat.ofHom f)
        (CommRingCat.ofHom inl_R) (CommRingCat.ofHom inr_A) →
      ∀ (ψ : B →+* A),
      ψ.comp inl_R = f →
      ψ.comp inr_A = φ_A →
      Function.Bijective ψ := by
    clear! K_sep κ B_sep B_κ C'_κ hEtDesc b hc_all hr_all
    intro p _ R A B _ _ _ hpR f hf φ_R hφ_R φ_A hφ_A inl_R inr_A hPush ψ hψ_R hψ_A
    have hp : Nat.Prime p := Fact.out
    have hpB : (p : B) = 0 := by
      rw [← map_natCast inl_R p, hpR, map_zero]
    have hCharP_of_zero : ∀ (S : Type u) [CommRing S] [Nontrivial S],
        (p : S) = 0 → CharP S p := by
      intro S _ _ hpS
      refine ⟨fun n => ⟨fun hn => ?_, fun hdvd => ?_⟩⟩
      · by_contra hndvd
        have hcop : Nat.Coprime p n := hp.coprime_iff_not_dvd.mpr hndvd
        have hgcd : (p.gcd n : ℤ) = (p : ℤ) * p.gcdA n + (n : ℤ) * p.gcdB n :=
          Nat.gcd_eq_gcd_ab p n
        rw [hcop, Nat.cast_one] at hgcd
        have hcast := congrArg (Int.castRingHom S) hgcd
        simp only [map_one, map_add, map_mul, Int.coe_castRingHom, Int.cast_natCast,
          hpS, hn, zero_mul, add_zero] at hcast
        exact one_ne_zero hcast
      · rcases hdvd with ⟨k, rfl⟩
        rw [Nat.cast_mul, hpS, zero_mul]
    let φ_B : B →+* B :=
      { toFun := fun b => b ^ p
        map_one' := one_pow p
        map_mul' := fun x y => mul_pow x y p
        map_zero' := zero_pow hp.ne_zero
        map_add' := fun x y => by
          by_cases hN : Nontrivial B
          · have : CharP B p := @hCharP_of_zero B _ hN hpB
            exact add_pow_char x y p
          · have : Subsingleton B := not_nontrivial_iff_subsingleton.mp hN
            exact Subsingleton.elim _ _ }
    have hinr_ψ_eq : CommRingCat.ofHom (inr_A.comp ψ) = CommRingCat.ofHom φ_B := by
      apply hPush.hom_ext
      · rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        have hpush_w : inr_A.comp f = inl_R.comp φ_R :=
          (congrArg CommRingCat.Hom.hom hPush.w).symm
        congr 1
        ext r
