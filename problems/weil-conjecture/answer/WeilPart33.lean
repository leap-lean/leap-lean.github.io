    let T_D : MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      MvPolynomial.C T_loc
    let T_inv_D : MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      MvPolynomial.C T_inv_loc
    have hT_D_mul : T_D * T_inv_D = 1 := by rw [← map_mul, hT_loc_mul, map_one]

    let w_β : σ_tot → MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      fun idx =>
        if hγ : idx.2 ≠ β then
          MvPolynomial.X ⟨idx, hγ⟩
        else if idx.1 = Fin.last k_sl then
          -(T_inv_D * ι_B₁ f₁ +
            ∑ γ' : Fin (N' + 1),
              if hne : γ' ≠ β then
                ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(Fin.last k_sl, γ'), hne⟩
              else 0)
        else
          -(∑ γ' : Fin (N' + 1),
              if hne : γ' ≠ β then
                ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(idx.1, γ'), hne⟩
              else 0)

    have hw_sum_dite : ∀ j : Fin (k_sl + 1),
        (∑ γ' : Fin (N' + 1),
          if hne : γ' ≠ β then ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(j, γ'), hne⟩ else 0) =
        ∑ γ' ∈ Finset.univ.erase β, ι_B₁ (r₁ γ') * w_β (j, γ') := by
      intro j
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β)]
      have h0 : (if hne : β ≠ β then ι_B₁ (r₁ β) * MvPolynomial.X ⟨(j, β), hne⟩ else 0) = 0 := by
        simp
      rw [h0, zero_add]
      refine Finset.sum_congr rfl fun γ' hγ' => ?_
      have hne : γ' ≠ β := Finset.ne_of_mem_erase hγ'
      simp [w_β, hne]

    have hw_slice : ∀ i : Fin k_sl,
        ∑ γ : Fin (N' + 1), ι_B₁ (r₁ γ) * w_β (i.castSucc, γ) = 0 := by
      intro i
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β)]
      have hi_ne : (i.castSucc : Fin (k_sl + 1)) ≠ Fin.last k_sl :=
        ne_of_lt (Fin.castSucc_lt_last i)
      have hw0 : w_β (i.castSucc, β) =
          -(∑ γ' ∈ Finset.univ.erase β, ι_B₁ (r₁ γ') * w_β (i.castSucc, γ')) := by
        have h_unfold : w_β (i.castSucc, β) =
            -(∑ γ' : Fin (N' + 1),
              if hne : γ' ≠ β then ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(i.castSucc, γ'), hne⟩ else 0) := by
          simp [w_β, hi_ne]
        rw [h_unfold, hw_sum_dite]
      rw [hr_β, map_one, one_mul, hw0, neg_add_cancel]

    have hw_pencil :
        ι_B₁ f₁ + T_D * (∑ γ : Fin (N' + 1), ι_B₁ (r₁ γ) * w_β (Fin.last k_sl, γ)) = 0 := by
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β)]
      have hwL : w_β (Fin.last k_sl, β) =
          -(T_inv_D * ι_B₁ f₁ +
            ∑ γ' ∈ Finset.univ.erase β, ι_B₁ (r₁ γ') * w_β (Fin.last k_sl, γ')) := by
        have h_unfold : w_β (Fin.last k_sl, β) =
            -(T_inv_D * ι_B₁ f₁ +
              ∑ γ' : Fin (N' + 1),
                if hne : γ' ≠ β then
                  ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(Fin.last k_sl, γ'), hne⟩
                else 0) := by
          simp [w_β]
        rw [h_unfold, hw_sum_dite]
      rw [hr_β, map_one, one_mul, hwL]
      calc ι_B₁ f₁ + T_D * (-(T_inv_D * ι_B₁ f₁ +
            ∑ γ' ∈ Finset.univ.erase β, ι_B₁ (r₁ γ') * w_β (Fin.last k_sl, γ')) +
            ∑ γ' ∈ Finset.univ.erase β, ι_B₁ (r₁ γ') * w_β (Fin.last k_sl, γ'))
          = ι_B₁ f₁ - (T_D * T_inv_D) * ι_B₁ f₁ := by ring
        _ = 0 := by rw [hT_D_mul, one_mul, sub_self]

    let ψ_coeff : MvPolynomial σ_tot Ω →ₐ[Ω]
        MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      MvPolynomial.aeval w_β
    let ψ_β_ring : Polynomial (MvPolynomial σ_tot Ω) →+*
        MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D
    let ψ_β : Polynomial (MvPolynomial σ_tot Ω) →ₐ[Ω]
        MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      { ψ_β_ring with
        commutes' := fun c => by
          change ψ_β_ring (algebraMap Ω (Polynomial (MvPolynomial σ_tot Ω)) c) = _
          rw [IsScalarTower.algebraMap_apply Ω (MvPolynomial σ_tot Ω) _ c, Polynomial.algebraMap_eq]
          change (Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D)
            (Polynomial.C (algebraMap Ω (MvPolynomial σ_tot Ω) c)) = _
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact ψ_coeff.commutes c }

    have hInj_ψβ : Function.Injective ψ_β := by
      rw [injective_iff_map_eq_zero]
      intro G hG_zero
      by_contra hG_ne
      have hex_coeff : ∃ d₀ : ℕ, G.coeff d₀ ≠ 0 := by
        by_contra! hall
        exact hG_ne (Polynomial.ext hall)
      obtain ⟨d₀, hd₀⟩ := hex_coeff
      have hex_u₀ : ∃ u₀ : σ_tot → Ω, MvPolynomial.eval u₀ (G.coeff d₀) ≠ 0 := by
        by_contra! hall
        apply hd₀
        exact MvPolynomial.funext fun u₀ => by rw [hall u₀, map_zero]
      obtain ⟨u₀, hu₀⟩ := hex_u₀
      let g₀ : Polynomial Ω := G.map (MvPolynomial.eval u₀)
      have hg₀_ne : g₀ ≠ 0 := by
        intro h0
        have hc : g₀.coeff d₀ = 0 := by rw [h0, Polynomial.coeff_zero]
        rw [Polynomial.coeff_map] at hc
        exact hu₀ hc
      have hXg₀_ne : Polynomial.X * g₀ ≠ 0 := mul_ne_zero Polynomial.X_ne_zero hg₀_ne
      have hex_t₀ : ∃ t₀ : Ω, (Polynomial.X * g₀).eval t₀ ≠ 0 := by
        by_contra! hall
        apply hXg₀_ne
        exact Polynomial.funext fun t₀ => by rw [hall t₀, Polynomial.eval_zero]
      obtain ⟨t₀, ht₀_prod⟩ := hex_t₀
      rw [Polynomial.eval_mul, Polynomial.eval_X] at ht₀_prod
      have ht₀_ne : t₀ ≠ 0 := left_ne_zero_of_mul ht₀_prod
      have hg₀_t₀ : g₀.eval t₀ ≠ 0 := right_ne_zero_of_mul ht₀_prod
      let P : MvPolynomial σ_tot Ω := G.eval (MvPolynomial.C t₀)
      have hP_ne : P ≠ 0 := by
        intro hP0
        have hevP : MvPolynomial.eval u₀ P = g₀.eval t₀ := by
          dsimp [P, g₀]
          rw [Polynomial.eval_map, Polynomial.eval, Polynomial.hom_eval₂]
          simp
        rw [hP0, map_zero] at hevP
        exact hg₀_t₀ hevP.symm
      obtain ⟨u_val, ev_w, hev_w_id, hu_P, hu_sl, hu_pen⟩ := hSpec₁ t₀ ht₀_ne P hP_ne
      have hev_w_alg : ∀ c : Ω, ev_w (algebraMap Ω B₁ c) = c := fun c =>
        RingHom.congr_fun hev_w_id c
      let ev_BT : Polynomial B₁ →+* Ω := Polynomial.eval₂RingHom ev_w t₀
      have hev_BT_X : IsUnit (ev_BT Polynomial.X) := by
        change IsUnit ((Polynomial.eval₂RingHom ev_w t₀) Polynomial.X)
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        exact isUnit_iff_ne_zero.mpr ht₀_ne
      let ev_loc : Localization.Away (Polynomial.X : Polynomial B₁) →+* Ω :=
        IsLocalization.Away.lift (Polynomial.X : Polynomial B₁) hev_BT_X
      have hev_loc_eq : ∀ q : Polynomial B₁, ev_loc (algebraMap _ _ q) = ev_BT q :=
        IsLocalization.Away.lift_eq (Polynomial.X : Polynomial B₁) hev_BT_X
      have hev_loc_T : ev_loc T_loc = t₀ := by
        dsimp [T_loc]
        rw [hev_loc_eq]
        change (Polynomial.eval₂RingHom ev_w t₀) Polynomial.X = t₀
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      have hev_loc_Tinv : ev_loc T_inv_loc = t₀⁻¹ := by
        have h1 : ev_loc (T_loc * T_inv_loc) = ev_loc 1 := congrArg ev_loc hT_loc_mul
        rw [map_mul, map_one, hev_loc_T] at h1
        exact mul_left_cancel₀ ht₀_ne (h1.trans (mul_inv_cancel₀ ht₀_ne).symm)
      let ev_tot : MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) →+* Ω :=
        MvPolynomial.eval₂Hom ev_loc (fun idx : Idx_rem => u_val idx.1)
      have hev_tot_ιB₁ : ∀ b : B₁, ev_tot (ι_B₁ b) = ev_w b := by
        intro b
        rw [hι_B₁_eq]
        change (MvPolynomial.eval₂Hom _ _) (MvPolynomial.C _) = _
        rw [MvPolynomial.eval₂Hom_C, hev_loc_eq]
        change (Polynomial.eval₂RingHom ev_w t₀) (Polynomial.C b) = _
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      have hev_tot_w : ∀ idx : σ_tot, ev_tot (w_β idx) = u_val idx := by
        rintro ⟨j, γ⟩
        by_cases hγ : γ ≠ β
        · have hw_eq : w_β (j, γ) = MvPolynomial.X ⟨(j, γ), hγ⟩ := by simp [w_β, hγ]
          rw [hw_eq]
          exact MvPolynomial.eval₂Hom_X' ev_loc (fun idx : Idx_rem => u_val idx.1) ⟨(j, γ), hγ⟩
        · push Not at hγ
          have hγ' : β = γ := hγ.symm
          subst hγ'
          have hsum_dite_eval : ∀ j' : Fin (k_sl + 1),
              ev_tot (∑ γ' : Fin (N' + 1),
                if hne : γ' ≠ β then ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(j', γ'), hne⟩ else 0) =
              ∑ γ' ∈ Finset.univ.erase β, u_val (j', γ') * ev_w (r₁ γ') := by
            intro j'
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β)]
            have h0 : (if hne : β ≠ β then ι_B₁ (r₁ β) * MvPolynomial.X ⟨(j', β), hne⟩ else 0) = 0 := by
              simp
            rw [h0, zero_add, map_sum]
            refine Finset.sum_congr rfl fun γ' hγ' => ?_
            have hne : γ' ≠ β := Finset.ne_of_mem_erase hγ'
            have hdite : (if h : γ' ≠ β then
                ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(j', γ'), h⟩ else 0) =
                ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(j', γ'), hne⟩ := by simp [hne]
            rw [hdite, map_mul, hev_tot_ιB₁]
            have hX : ev_tot (MvPolynomial.X ⟨(j', γ'), hne⟩) = u_val (j', γ') :=
              MvPolynomial.eval₂Hom_X' ev_loc (fun idx : Idx_rem => u_val idx.1) ⟨(j', γ'), hne⟩
            rw [hX, mul_comm]
          by_cases hj : j = Fin.last k_sl
          · subst hj
            have h_w_eq : w_β (Fin.last k_sl, β) =
                -(T_inv_D * ι_B₁ f₁ +
                  ∑ γ' : Fin (N' + 1),
                    if hne : γ' ≠ β then
                      ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(Fin.last k_sl, γ'), hne⟩
                    else 0) := by
              simp [w_β]
            rw [h_w_eq, map_neg, map_add, map_mul, hsum_dite_eval, hev_tot_ιB₁]
            have hev_Tinv : ev_tot T_inv_D = t₀⁻¹ := by
              change (MvPolynomial.eval₂Hom _ _) (MvPolynomial.C T_inv_loc) = _
              rw [MvPolynomial.eval₂Hom_C, hev_loc_Tinv]
            have hev_f₁ : ev_w f₁ = ∑ γ : Fin (N' + 1), c_F' γ * ev_w (r₁ γ) := by
              simp only [f₁, map_sum, map_mul, hev_w_alg]
            rw [hev_Tinv, hev_f₁]
            rw [← Finset.add_sum_erase _ (fun γ => u_val (Fin.last k_sl, γ) * ev_w (r₁ γ))
              (Finset.mem_univ β), hr_β, map_one, mul_one] at hu_pen
            have hpen2 : t₀⁻¹ * ((∑ γ : Fin (N' + 1), c_F' γ * ev_w (r₁ γ)) +
                t₀ * (u_val (Fin.last k_sl, β) +
                  ∑ x ∈ Finset.univ.erase β, u_val (Fin.last k_sl, x) * ev_w (r₁ x))) = 0 := by
              rw [hu_pen, mul_zero]
            have hpen3 : t₀⁻¹ * (∑ γ : Fin (N' + 1), c_F' γ * ev_w (r₁ γ)) +
                u_val (Fin.last k_sl, β) +
                ∑ x ∈ Finset.univ.erase β, u_val (Fin.last k_sl, x) * ev_w (r₁ x) = 0 := by
              calc t₀⁻¹ * (∑ γ : Fin (N' + 1), c_F' γ * ev_w (r₁ γ)) +
                    u_val (Fin.last k_sl, β) +
                    ∑ x ∈ Finset.univ.erase β, u_val (Fin.last k_sl, x) * ev_w (r₁ x)
                  = t₀⁻¹ * (∑ γ : Fin (N' + 1), c_F' γ * ev_w (r₁ γ)) +
                    (t₀⁻¹ * t₀) * (u_val (Fin.last k_sl, β) +
                      ∑ x ∈ Finset.univ.erase β, u_val (Fin.last k_sl, x) * ev_w (r₁ x)) := by
                    rw [inv_mul_cancel₀ ht₀_ne, one_mul]; ring
                _ = _ := by rw [← hpen2]; ring
            linear_combination -hpen3
          · obtain ⟨i, rfl⟩ := Fin.eq_castSucc_of_ne_last hj
            have h_w_eq : w_β (i.castSucc, β) =
                -(∑ γ' : Fin (N' + 1),
                  if hne : γ' ≠ β then
                    ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(i.castSucc, γ'), hne⟩
                  else 0) := by
              simp [w_β, hj]
            rw [h_w_eq, map_neg, hsum_dite_eval]
            have hsl_i := hu_sl i
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β), hr_β, map_one, mul_one] at hsl_i
            linear_combination -hsl_i
      have hev_comp_coeff : ev_tot.comp ψ_coeff.toRingHom = MvPolynomial.eval u_val := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          change ev_tot (ψ_coeff (MvPolynomial.C c)) = (MvPolynomial.eval u_val) (MvPolynomial.C c)
          rw [MvPolynomial.aeval_C, ← ι_B₁.commutes c, hev_tot_ιB₁, hev_w_alg, MvPolynomial.eval_C]
        · intro idx
          change ev_tot (ψ_coeff (MvPolynomial.X idx)) = (MvPolynomial.eval u_val) (MvPolynomial.X idx)
          rw [MvPolynomial.aeval_X, hev_tot_w, MvPolynomial.eval_X]
      have hev_comp_all :
          ev_tot.comp ψ_β_ring = (MvPolynomial.eval u_val).comp
            (Polynomial.evalRingHom (MvPolynomial.C t₀)) := by
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun Q => ?_
          simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
          dsimp only [ψ_β_ring]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact RingHom.congr_fun hev_comp_coeff Q
        · simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X,
            MvPolynomial.eval_C]
          dsimp only [ψ_β_ring]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          change (MvPolynomial.eval₂Hom _ _) (MvPolynomial.C T_loc) = t₀
          rw [MvPolynomial.eval₂Hom_C, hev_loc_T]
      have h_eval_G : ev_tot (ψ_β G) = MvPolynomial.eval u_val P :=
        RingHom.congr_fun hev_comp_all G
      rw [hG_zero, map_zero] at h_eval_G
      exact hu_P h_eval_G.symm

    let S_β : Submonoid (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁))) :=
      (nonZeroDivisors (Polynomial (MvPolynomial σ_tot Ω))).map ψ_β.toRingHom.toMonoidHom
    let : CommRing (Localization S_β) := inferInstance
    have hSβ_nzd : S_β ≤ nonZeroDivisors _ := by
      rintro _ ⟨g, hg, rfl⟩
      have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hg
      exact mem_nonZeroDivisors_of_ne_zero
        (fun h0 => hg_ne (hInj_ψβ (h0.trans (map_zero ψ_β).symm)))
    have : IsDomain (Localization S_β) := IsLocalization.isDomain_localization hSβ_nzd
    have hInj_Dloc : Function.Injective (algebraMap _ (Localization S_β)) :=
      IsLocalization.injective (Localization S_β) hSβ_nzd
    have hSβ_units : ∀ y : nonZeroDivisors (Polynomial (MvPolynomial σ_tot Ω)),
        IsUnit (((algebraMap _ (Localization S_β)).comp ψ_β.toRingHom) y) := by
      intro y
      exact IsLocalization.map_units (Localization S_β)
        ⟨ψ_β y.1, Submonoid.mem_map_of_mem ψ_β.toRingHom.toMonoidHom y.2⟩
    let lam_F_ring : FractionRing (Polynomial (MvPolynomial σ_tot Ω)) →+* Localization S_β :=
      IsLocalization.lift (S := FractionRing (Polynomial (MvPolynomial σ_tot Ω))) hSβ_units
    have hlam_F_eq : ∀ g : Polynomial (MvPolynomial σ_tot Ω),
        lam_F_ring (algebraMap _ _ g) = algebraMap _ (Localization S_β) (ψ_β g) :=
      IsLocalization.lift_eq (S := FractionRing (Polynomial (MvPolynomial σ_tot Ω))) hSβ_units
    let lam_F : FractionRing (Polynomial (MvPolynomial σ_tot Ω)) →ₐ[Ω] Localization S_β :=
      { lam_F_ring with
        commutes' := fun c => by
          change lam_F_ring (algebraMap Ω _ c) = algebraMap Ω (Localization S_β) c
          rw [IsScalarTower.algebraMap_apply Ω (Polynomial (MvPolynomial σ_tot Ω)) _ c, hlam_F_eq,
            ψ_β.commutes,
            ← IsScalarTower.algebraMap_apply Ω
              (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)))
              (Localization S_β) c] }
    let α_K : FractionRing R →ₐ[Ω] Localization S_β := lam_F.comp Ξ_K.symm.toAlgHom
    let α_B : B₁ →ₐ[Ω] Localization S_β :=
      (IsScalarTower.toAlgHom Ω _ (Localization S_β)).comp ι_B₁
    have hα_K_u : ∀ (i : Fin k_sl) (γ : Fin (N' + 1)),
        α_K (u_K i γ) = algebraMap _ (Localization S_β) (w_β (i.castSucc, γ)) := by
      intro i γ
      change lam_F_ring (Ξ_K.symm (u_K i γ)) = _
      dsimp only [u_K]
      rw [← hΞ_u i γ, AlgEquiv.symm_apply_apply, hlam_F_eq]
      congr 1
      change (Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D)
        (Polynomial.C (MvPolynomial.X (i.castSucc, γ))) = _
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      exact MvPolynomial.aeval_X w_β (i.castSucc, γ)
    have hα_K_v : ∀ γ : Fin (N' + 1),
        α_K (v_K γ) = algebraMap _ (Localization S_β) (w_β (Fin.last k_sl, γ)) := by
      intro γ
      change lam_F_ring (Ξ_K.symm (v_K γ)) = _
      dsimp only [v_K]
      rw [← hΞ_v γ, AlgEquiv.symm_apply_apply, hlam_F_eq]
      congr 1
      change (Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D)
        (Polynomial.C (MvPolynomial.X (Fin.last k_sl, γ))) = _
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      exact MvPolynomial.aeval_X w_β (Fin.last k_sl, γ)
    have hα_K_ϖ : α_K ϖ_K = algebraMap _ (Localization S_β) T_D := by
      change lam_F_ring (Ξ_K.symm ϖ_K) = _
      dsimp only [ϖ_K]
      rw [← hΞ_T, AlgEquiv.symm_apply_apply, hlam_F_eq]
      congr 1
      change (Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D) Polynomial.X = T_D
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

    let Φ_tilde : TensorProduct Ω B₁ K_gen →ₐ[Ω] Localization S_β :=
      Algebra.TensorProduct.lift α_B α_K (fun _ _ => Commute.all _ _)
    have hJK_ker : ∀ z ∈ J_K₁, Φ_tilde z = 0 := by
      have hle : J_K₁ ≤ RingHom.ker Φ_tilde.toRingHom := by
        dsimp [J_K₁, J_R₁]
        rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
        intro z hz
        rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
        change Φ_tilde (toK₁ z) = 0
        rcases hz with rfl | ⟨i, rfl⟩
        · have hp_map : toK₁ p_eq_R =
              (∑ γ : Fin (N' + 1), (algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : K_gen)) +
              (∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (ϖ_K * v_K γ)) := by
            simp [toK₁, p_eq_R, ϖ_K, v_K, K_gen]
          rw [hp_map, map_add, map_sum, map_sum]
          have hs1 : (∑ γ : Fin (N' + 1),
              Φ_tilde ((algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : K_gen))) =
              algebraMap _ (Localization S_β) (ι_B₁ f₁) := by
            simp only [Φ_tilde, Algebra.TensorProduct.lift_tmul, map_one, mul_one, α_B,
              AlgHom.comp_apply, IsScalarTower.coe_toAlgHom', f₁, map_sum]
          have hs2 : (∑ γ : Fin (N' + 1), Φ_tilde ((r₁ γ) ⊗ₜ[Ω] (ϖ_K * v_K γ))) =
              algebraMap _ (Localization S_β)
                (T_D * ∑ γ : Fin (N' + 1), ι_B₁ (r₁ γ) * w_β (Fin.last k_sl, γ)) := by
            rw [map_mul, map_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl fun γ _ => ?_
            simp only [Φ_tilde, Algebra.TensorProduct.lift_tmul, map_mul, hα_K_ϖ, hα_K_v,
              α_B, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom']
            ring
          rw [hs1, hs2, ← map_add, hw_pencil, map_zero]
        · have hh_map : toK₁ (h_eq_R i) = ∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (u_K i γ) := by
            simp [toK₁, h_eq_R, u_K, K_gen]
          rw [hh_map, map_sum]
          have hs : (∑ γ : Fin (N' + 1), Φ_tilde ((r₁ γ) ⊗ₜ[Ω] (u_K i γ))) =
              algebraMap _ (Localization S_β)
                (∑ γ : Fin (N' + 1), ι_B₁ (r₁ γ) * w_β (i.castSucc, γ)) := by
            rw [map_sum]
            refine Finset.sum_congr rfl fun γ _ => ?_
            simp [Φ_tilde, Algebra.TensorProduct.lift_tmul, hα_K_u, α_B]
          rw [hs, hw_slice i, map_zero]
      exact fun z hz => hle hz

    let π_K : TensorProduct Ω B₁ K_gen →ₐ[Ω] ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      Ideal.Quotient.mkₐ Ω J_K₁
    let Φ_β : ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) →ₐ[Ω] Localization S_β :=
      Ideal.Quotient.liftₐ J_K₁ Φ_tilde hJK_ker

    let β_B : B₁ →+* ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      π_K.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom
    let β_BT : Polynomial B₁ →+* ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      Polynomial.eval₂RingHom β_B (π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K))
    have hinv_ϖ_Q : π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) * π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K) = 1 := by
      rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, inv_mul_cancel₀ hϖ_K_ne]
      exact map_one π_K
    have hϖK_unit_Q : IsUnit (β_BT Polynomial.X) := by
      change IsUnit ((Polynomial.eval₂RingHom β_B (π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K))) Polynomial.X)
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      refine IsUnit.of_mul_eq_one (π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹)) ?_
      rw [mul_comm]
      exact hinv_ϖ_Q
    let β_loc : Localization.Away (Polynomial.X : Polynomial B₁) →+*
        ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      IsLocalization.Away.lift (Polynomial.X : Polynomial B₁) hϖK_unit_Q
    have hβ_loc_eq : ∀ q : Polynomial B₁, β_loc (algebraMap _ _ q) = β_BT q :=
      IsLocalization.Away.lift_eq (Polynomial.X : Polynomial B₁) hϖK_unit_Q
    have hβ_loc_T : β_loc T_loc = π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K) := by
      dsimp [T_loc]
      rw [hβ_loc_eq]
      change (Polynomial.eval₂RingHom β_B _) Polynomial.X = _
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have hβ_loc_Tinv : β_loc T_inv_loc = π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) := by
      have h1 : β_loc (T_loc * T_inv_loc) = β_loc 1 := congrArg β_loc hT_loc_mul
      rw [map_mul, map_one, hβ_loc_T] at h1
      calc β_loc T_inv_loc
          = (π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) * π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K)) * β_loc T_inv_loc := by
            rw [hinv_ϖ_Q, one_mul]
        _ = π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) * (π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K) * β_loc T_inv_loc) :=
            mul_assoc _ _ _
        _ = π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) := by rw [h1, mul_one]
    let j_AP : Polynomial (MvPolynomial σ_tot Ω) →+*
        FractionRing (Polynomial (MvPolynomial σ_tot Ω)) :=
      algebraMap (Polynomial (MvPolynomial σ_tot Ω))
        (FractionRing (Polynomial (MvPolynomial σ_tot Ω)))
    let f_idx : Idx_rem → ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      fun idx => π_K ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP (Polynomial.C (MvPolynomial.X idx.1))))
    let β_poly : MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)) →+*
        ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      MvPolynomial.eval₂Hom β_loc f_idx
    have hβ_poly_ιB₁ : ∀ b : B₁, β_poly (ι_B₁ b) = π_K (b ⊗ₜ[Ω] (1 : K_gen)) := by
      intro b
      rw [hι_B₁_eq]
      change (MvPolynomial.eval₂Hom β_loc f_idx) (MvPolynomial.C _) = _
      rw [MvPolynomial.eval₂Hom_C, hβ_loc_eq]
      change (Polynomial.eval₂RingHom β_B _) (Polynomial.C b) = _
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rfl
    have hπK_slice : ∀ i : Fin k_sl,
        ∑ γ : Fin (N' + 1), π_K ((r₁ γ) ⊗ₜ[Ω] (1 : K_gen)) * π_K ((1 : B₁) ⊗ₜ[Ω] (u_K i γ)) = 0 := by
      intro i
      have hmem : toK₁ (h_eq_R i) ∈ J_K₁ :=
        Ideal.mem_map_of_mem _ (Ideal.subset_span (Or.inr ⟨i, rfl⟩))
      have h0 : π_K (toK₁ (h_eq_R i)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      have hh_map : toK₁ (h_eq_R i) = ∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (u_K i γ) := by
        simp [toK₁, h_eq_R, u_K, K_gen]
      rw [hh_map, map_sum] at h0
      rw [← h0]
      refine Finset.sum_congr rfl fun γ _ => ?_
      rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hπK_pencil :
        π_K (f₁ ⊗ₜ[Ω] (1 : K_gen)) + π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K) *
          (∑ γ : Fin (N' + 1), π_K ((r₁ γ) ⊗ₜ[Ω] (1 : K_gen)) * π_K ((1 : B₁) ⊗ₜ[Ω] (v_K γ))) = 0 := by
      have hmem : toK₁ p_eq_R ∈ J_K₁ :=
        Ideal.mem_map_of_mem _ (Ideal.subset_span (Or.inl rfl))
      have h0 : π_K (toK₁ p_eq_R) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      have hp_map : toK₁ p_eq_R =
          (∑ γ : Fin (N' + 1), (algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : K_gen)) +
          (∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (ϖ_K * v_K γ)) := by
        simp [toK₁, p_eq_R, ϖ_K, v_K, K_gen]
      rw [hp_map, map_add, map_sum, map_sum] at h0
      have hs1 : π_K (f₁ ⊗ₜ[Ω] (1 : K_gen)) =
          ∑ γ : Fin (N' + 1), π_K ((algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : K_gen)) := by
        have hf_tmul : (f₁ ⊗ₜ[Ω] (1 : K_gen)) =
            ∑ γ : Fin (N' + 1), (algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : K_gen) :=
          map_sum (Algebra.TensorProduct.includeLeft : B₁ →ₐ[Ω] TensorProduct Ω B₁ K_gen) _ _
        rw [hf_tmul, map_sum]
      have hs2 : π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K) *
            (∑ γ : Fin (N' + 1), π_K ((r₁ γ) ⊗ₜ[Ω] (1 : K_gen)) * π_K ((1 : B₁) ⊗ₜ[Ω] (v_K γ))) =
          ∑ γ : Fin (N' + 1), π_K ((r₁ γ) ⊗ₜ[Ω] (ϖ_K * v_K γ)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun γ _ => ?_
        rw [← map_mul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, one_mul]
      rw [hs1, hs2, h0]
    have hβ_poly_w : ∀ idx : σ_tot,
        β_poly (w_β idx) = π_K ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP (Polynomial.C (MvPolynomial.X idx)))) := by
      rintro ⟨j, γ⟩
      by_cases hγ : γ ≠ β
      · have hw_eq : w_β (j, γ) = MvPolynomial.X ⟨(j, γ), hγ⟩ := by simp [w_β, hγ]
        rw [hw_eq]
        exact MvPolynomial.eval₂Hom_X' β_loc f_idx ⟨(j, γ), hγ⟩
      · push Not at hγ
        have hγ' : β = γ := hγ.symm
        subst hγ'
        have hsum_dite_Q : ∀ j' : Fin (k_sl + 1),
            β_poly (∑ γ' : Fin (N' + 1),
              if hne : γ' ≠ β then ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(j', γ'), hne⟩ else 0) =
            ∑ γ' ∈ Finset.univ.erase β,
              π_K ((r₁ γ') ⊗ₜ[Ω] (1 : K_gen)) *
                π_K ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP (Polynomial.C (MvPolynomial.X (j', γ'))))) := by
          intro j'
          rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β)]
          have h0 : (if hne : β ≠ β then ι_B₁ (r₁ β) * MvPolynomial.X ⟨(j', β), hne⟩ else 0) = 0 := by
            simp
          rw [h0, zero_add, map_sum]
          refine Finset.sum_congr rfl fun γ' hγ' => ?_
          have hne : γ' ≠ β := Finset.ne_of_mem_erase hγ'
          have hdite : (if h : γ' ≠ β then
              ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(j', γ'), h⟩ else 0) =
              ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(j', γ'), hne⟩ := by simp [hne]
          rw [hdite, map_mul, hβ_poly_ιB₁]
          congr 1
          exact MvPolynomial.eval₂Hom_X' β_loc f_idx ⟨(j', γ'), hne⟩
        by_cases hj : j = Fin.last k_sl
        · subst hj
          have h_w_eq : w_β (Fin.last k_sl, β) =
              -(T_inv_D * ι_B₁ f₁ +
                ∑ γ' : Fin (N' + 1),
                  if hne : γ' ≠ β then
                    ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(Fin.last k_sl, γ'), hne⟩
                  else 0) := by
            simp [w_β]
          rw [h_w_eq, map_neg, map_add, map_mul, hsum_dite_Q, hβ_poly_ιB₁]
          have hβ_Tinv : β_poly T_inv_D = π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) := by
            change (MvPolynomial.eval₂Hom _ _) (MvPolynomial.C T_inv_loc) = _
            rw [MvPolynomial.eval₂Hom_C, hβ_loc_Tinv]
          rw [hβ_Tinv]
          dsimp only [j_AP, σ_tot]
          simp only [hΞ_v]
          have hpen := hπK_pencil
          rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β), hr_β] at hpen
          have h1_one : π_K ((1 : B₁) ⊗ₜ[Ω] (1 : K_gen)) = 1 := map_one π_K
          rw [h1_one, one_mul] at hpen
          have hpen_mul : π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) *
              (π_K (f₁ ⊗ₜ[Ω] (1 : K_gen)) + π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K) *
                (π_K ((1 : B₁) ⊗ₜ[Ω] v_K β) +
                  ∑ x ∈ Finset.univ.erase β,
                    π_K ((r₁ x) ⊗ₜ[Ω] (1 : K_gen)) * π_K ((1 : B₁) ⊗ₜ[Ω] v_K x))) = 0 := by
            rw [hpen, mul_zero]
          have hpen_simp : π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) * π_K (f₁ ⊗ₜ[Ω] (1 : K_gen)) +
              π_K ((1 : B₁) ⊗ₜ[Ω] v_K β) +
              ∑ x ∈ Finset.univ.erase β,
                π_K ((r₁ x) ⊗ₜ[Ω] (1 : K_gen)) * π_K ((1 : B₁) ⊗ₜ[Ω] v_K x) = 0 := by
            calc π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) * π_K (f₁ ⊗ₜ[Ω] (1 : K_gen)) +
                  π_K ((1 : B₁) ⊗ₜ[Ω] v_K β) +
                  ∑ x ∈ Finset.univ.erase β,
                    π_K ((r₁ x) ⊗ₜ[Ω] (1 : K_gen)) * π_K ((1 : B₁) ⊗ₜ[Ω] v_K x)
                = π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) * π_K (f₁ ⊗ₜ[Ω] (1 : K_gen)) +
                  (π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K⁻¹) * π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K)) *
                    (π_K ((1 : B₁) ⊗ₜ[Ω] v_K β) +
                      ∑ x ∈ Finset.univ.erase β,
                        π_K ((r₁ x) ⊗ₜ[Ω] (1 : K_gen)) * π_K ((1 : B₁) ⊗ₜ[Ω] v_K x)) := by
                  rw [hinv_ϖ_Q, one_mul, add_assoc]
              _ = _ := by rw [← hpen_mul]; ring
          linear_combination -hpen_simp
        · obtain ⟨i, rfl⟩ := Fin.eq_castSucc_of_ne_last hj
          have h_w_eq : w_β (i.castSucc, β) =
              -(∑ γ' : Fin (N' + 1),
                if hne : γ' ≠ β then
                  ι_B₁ (r₁ γ') * MvPolynomial.X ⟨(i.castSucc, γ'), hne⟩
                else 0) := by
            simp [w_β, hj]
          rw [h_w_eq, map_neg, hsum_dite_Q]
          dsimp only [j_AP, σ_tot]
          simp only [hΞ_u]
          have hsl := hπK_slice i
          rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β), hr_β] at hsl
          have h1_one : π_K ((1 : B₁) ⊗ₜ[Ω] (1 : K_gen)) = 1 := map_one π_K
          rw [h1_one, one_mul] at hsl
          linear_combination -hsl

    let incR_K : K_gen →+* ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      π_K.toRingHom.comp
        (Algebra.TensorProduct.includeRight : K_gen →ₐ[Ω] TensorProduct Ω B₁ K_gen).toRingHom
    have hβ_comp_coeff : β_poly.comp ψ_coeff.toRingHom =
        incR_K.comp (Ξ_K.toRingHom.comp (j_AP.comp Polynomial.C)) := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        change β_poly (ψ_coeff (MvPolynomial.C c)) =
          π_K ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP (Polynomial.C (MvPolynomial.C c))))
        rw [MvPolynomial.aeval_C, ← ι_B₁.commutes c, hβ_poly_ιB₁]
        have hΞ_c : Ξ_K (j_AP (Polynomial.C (MvPolynomial.C c))) = algebraMap Ω K_gen c := by
          dsimp only [j_AP]
          rw [← MvPolynomial.algebraMap_eq, ← Polynomial.algebraMap_eq,
            ← IsScalarTower.algebraMap_apply Ω (MvPolynomial σ_tot Ω) _ c,
            ← IsScalarTower.algebraMap_apply Ω (Polynomial (MvPolynomial σ_tot Ω)) _ c,
            Ξ_K.commutes]
        rw [hΞ_c]
        congr 1
        calc (algebraMap Ω B₁ c) ⊗ₜ[Ω] (1 : K_gen)
            = (c • (1 : B₁)) ⊗ₜ[Ω] (1 : K_gen) := by
              congr 1; symm; rw [Algebra.smul_def, mul_one]
          _ = (1 : B₁) ⊗ₜ[Ω] (c • (1 : K_gen)) := TensorProduct.smul_tmul _ _ _
          _ = (1 : B₁) ⊗ₜ[Ω] algebraMap Ω K_gen c := by
              congr 1; rw [Algebra.smul_def, mul_one]
      · intro idx
        change β_poly (ψ_coeff (MvPolynomial.X idx)) = _
        rw [MvPolynomial.aeval_X]
        exact hβ_poly_w idx
    have hβ_comp_ψ' : β_poly.comp ψ_β_ring = incR_K.comp (Ξ_K.toRingHom.comp j_AP) := by
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun Q => ?_
        change β_poly ((Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D) (Polynomial.C Q)) = _
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact RingHom.congr_fun hβ_comp_coeff Q
      · change β_poly ((Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D) Polynomial.X) =
          π_K ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP Polynomial.X))
        dsimp only [j_AP]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hΞ_T]
        change (MvPolynomial.eval₂Hom _ _) (MvPolynomial.C T_loc) = _
        rw [MvPolynomial.eval₂Hom_C, hβ_loc_T]

    have hβ_S_units : ∀ y : S_β, IsUnit (β_poly y) := by
      rintro ⟨_, g, hg, rfl⟩
      have h1 : β_poly (ψ_β_ring g) = incR_K (Ξ_K (j_AP g)) :=
        RingHom.congr_fun hβ_comp_ψ' g
      change IsUnit (β_poly (ψ_β_ring g))
      rw [h1]
      exact (IsLocalization.map_units _ ⟨g, hg⟩).map (incR_K.comp Ξ_K.toRingHom)
    let Ψ_β : Localization S_β →+* ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      IsLocalization.lift (S := Localization S_β) hβ_S_units
    have hΨ_β_eq : ∀ d, Ψ_β (algebraMap _ (Localization S_β) d) = β_poly d :=
      IsLocalization.lift_eq (S := Localization S_β) hβ_S_units

    have hΨΦ : Ψ_β.comp Φ_β.toRingHom = RingHom.id _ := by
      have h_incR : (Ψ_β.comp Φ_β.toRingHom).comp incR_K = incR_K := by
        have h_frac : ((Ψ_β.comp Φ_β.toRingHom).comp incR_K).comp Ξ_K.toRingHom =
            incR_K.comp Ξ_K.toRingHom := by
          apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial (MvPolynomial σ_tot Ω)))
          refine RingHom.ext fun g => ?_
          change Ψ_β (Φ_β (incR_K (Ξ_K (j_AP g)))) = incR_K (Ξ_K (j_AP g))
          have hΦg : Φ_β (incR_K (Ξ_K (j_AP g))) =
              algebraMap _ (Localization S_β) (ψ_β g) := by
            change Φ_tilde ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP g)) = _
            simp only [Φ_tilde, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            change lam_F_ring (Ξ_K.symm (Ξ_K (j_AP g))) = _
            rw [AlgEquiv.symm_apply_apply, hlam_F_eq]
          rw [hΦg, hΨ_β_eq]
          exact RingHom.congr_fun hβ_comp_ψ' g
        refine RingHom.ext fun k => ?_
        have hk := RingHom.congr_fun h_frac (Ξ_K.symm k)
        change Ψ_β (Φ_β (incR_K (Ξ_K (Ξ_K.symm k)))) = incR_K (Ξ_K (Ξ_K.symm k)) at hk
        rwa [AlgEquiv.apply_symm_apply] at hk
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun z => ?_
      change Ψ_β (Φ_β (π_K z)) = π_K z
      induction z using TensorProduct.inductionOn with
      | tmul b k =>
        have hdecomp : (b ⊗ₜ[Ω] k : TensorProduct Ω B₁ K_gen) =
            (b ⊗ₜ[Ω] (1 : K_gen)) * ((1 : B₁) ⊗ₜ[Ω] k) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hdecomp, map_mul, map_mul, map_mul]
        have hb : Ψ_β (Φ_β (π_K (b ⊗ₜ[Ω] (1 : K_gen)))) = π_K (b ⊗ₜ[Ω] (1 : K_gen)) := by
          change Ψ_β (Φ_tilde (b ⊗ₜ[Ω] (1 : K_gen))) = _
          simp only [Φ_tilde, Algebra.TensorProduct.lift_tmul, map_one, mul_one, α_B,
            AlgHom.comp_apply, IsScalarTower.coe_toAlgHom']
          rw [hΨ_β_eq, hβ_poly_ιB₁]
        have hk : Ψ_β (Φ_β (incR_K k)) = incR_K k := RingHom.congr_fun h_incR k
        rw [hb]
        exact congrArg (π_K (b ⊗ₜ[Ω] (1 : K_gen)) * ·) hk
      | add x y hx hy =>
        rw [map_add, map_add, map_add, hx, hy]

    have hΦΨ : Φ_β.toRingHom.comp Ψ_β = RingHom.id (Localization S_β) := by
      apply IsLocalization.ringHom_ext S_β
      apply MvPolynomial.ringHom_ext'
      · apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial B₁))
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun b => ?_
          simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
          rw [← hι_B₁_eq b, hΨ_β_eq, hβ_poly_ιB₁]
          change Φ_tilde (b ⊗ₜ[Ω] (1 : K_gen)) = _
          simp [Φ_tilde, α_B]
        · change Φ_β (Ψ_β (algebraMap _ (Localization S_β) T_D)) =
            algebraMap _ (Localization S_β) T_D
          rw [hΨ_β_eq]
          have hT : β_poly T_D = π_K ((1 : B₁) ⊗ₜ[Ω] ϖ_K) := by
            change (MvPolynomial.eval₂Hom _ _) (MvPolynomial.C T_loc) = _
            rw [MvPolynomial.eval₂Hom_C, hβ_loc_T]
          rw [hT]
          change Φ_tilde ((1 : B₁) ⊗ₜ[Ω] ϖ_K) = _
          simp [Φ_tilde, hα_K_ϖ]
      · intro idx
        change Φ_β (Ψ_β (algebraMap _ (Localization S_β) (MvPolynomial.X idx))) =
          algebraMap _ (Localization S_β) (MvPolynomial.X idx)
        rw [hΨ_β_eq]
        have hX_eval : β_poly (MvPolynomial.X idx) =
            π_K ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP (Polynomial.C (MvPolynomial.X idx.1)))) :=
          MvPolynomial.eval₂Hom_X' β_loc f_idx idx
        rw [hX_eval]
        change Φ_tilde ((1 : B₁) ⊗ₜ[Ω] Ξ_K (j_AP (Polynomial.C (MvPolynomial.X idx.1)))) = _
        simp only [Φ_tilde, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        change lam_F_ring (Ξ_K.symm (Ξ_K (j_AP (Polynomial.C (MvPolynomial.X idx.1))))) = _
        rw [AlgEquiv.symm_apply_apply, hlam_F_eq]
        congr 1
        change (Polynomial.eval₂RingHom ψ_coeff.toRingHom T_D)
          (Polynomial.C (MvPolynomial.X idx.1)) = MvPolynomial.X idx
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change ψ_coeff (MvPolynomial.X idx.1) = _
        rw [MvPolynomial.aeval_X]
        simp [w_β, idx.2]

    let e_gen : ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) ≃ₐ[Ω] Localization S_β :=
      AlgEquiv.ofAlgHom Φ_β
        { Ψ_β with
          commutes' := fun c => by
            have h1 : Φ_β (Ψ_β (algebraMap Ω (Localization S_β) c)) =
                algebraMap Ω (Localization S_β) c :=
              RingHom.congr_fun hΦΨ (algebraMap Ω (Localization S_β) c)
            have h2 : Φ_β (algebraMap Ω _ c) = algebraMap Ω (Localization S_β) c := Φ_β.commutes c
            have hinj : Function.Injective Φ_β := fun x y hxy => by
              have hx := RingHom.congr_fun hΨΦ x
              have hy := RingHom.congr_fun hΨΦ y
              simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
                RingHom.id_apply] at hx hy
              rw [← hx, ← hy, hxy]
            exact hinj (h1.trans h2.symm) }
        (AlgHom.ext fun d => RingHom.congr_fun hΦΨ d)
        (AlgHom.ext fun q => RingHom.congr_fun hΨΦ q)

    have hIsDom_QK : IsDomain ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) :=
      Function.Injective.isDomain e_gen.toRingHom e_gen.injective

    have hb_notin : ∀ b : B₁, b ≠ 0 → b ⊗ₜ[Ω] (1 : K_gen) ∉ J_K₁ := by
      intro b hb hmem
      have hπ0 : π_K (b ⊗ₜ[Ω] (1 : K_gen)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      have hΦb : Φ_β (π_K (b ⊗ₜ[Ω] (1 : K_gen))) = algebraMap _ (Localization S_β) (ι_B₁ b) := by
        change Φ_tilde (b ⊗ₜ[Ω] (1 : K_gen)) = _
        simp [Φ_tilde, α_B]
      rw [hπ0, map_zero] at hΦb
      have h01 : ι_B₁ b = 0 :=
        hInj_Dloc (hΦb.symm.trans (map_zero (algebraMap _ (Localization S_β))).symm)
      exact hb (hInj_ιB₁ (h01.trans (map_zero ι_B₁).symm))

    let e_comm_B₁ : TensorProduct Ω B₁ K_gen ≃ₐ[Ω] TensorProduct Ω K_gen B₁ :=
      Algebra.TensorProduct.comm Ω B₁ K_gen
    let J'_Kβ : Ideal (TensorProduct Ω K_gen B₁) := Ideal.map e_comm_B₁ J_K₁
    let : CommRing ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ) := inferInstance
    let e_quot_comm : ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) ≃ₐ[Ω] ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ) :=
      Ideal.quotientEquivAlg J_K₁ J'_Kβ e_comm_B₁ rfl
    have : IsDomain ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) := hIsDom_QK
    have : IsDomain ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ) :=
      Function.Injective.isDomain e_quot_comm.symm.toRingHom e_quot_comm.symm.injective
    obtain ⟨s_Q, hDim_Q'K, hTr_Q'K⟩ := hDimTrdeg K_gen ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ)
    obtain ⟨s_B₁, hDim_B₁', hTr_B₁⟩ := hDimTrdeg Ω B₁
    have hs_B₁_eq : s_B₁ = k_sl + 2 :=
      Nat.cast_injective (WithBot.coe_inj.mp (hDim_B₁'.symm.trans hDimB₁))
    subst hs_B₁_eq

    have : FaithfulSMul Ω B₁ :=
      (faithfulSMul_iff_algebraMap_injective Ω B₁).mpr (algebraMap Ω B₁).injective
    have : FaithfulSMul B₁ (Polynomial B₁) :=
      (faithfulSMul_iff_algebraMap_injective B₁ _).mpr Polynomial.C_injective
    have : FaithfulSMul Ω (Polynomial B₁) :=
      (faithfulSMul_iff_algebraMap_injective Ω _).mpr (algebraMap Ω _).injective
    have : FaithfulSMul (Polynomial B₁) (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hInj_B₁_loc
    have : FaithfulSMul Ω (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      (faithfulSMul_iff_algebraMap_injective Ω _).mpr (algebraMap Ω _).injective
    have : FaithfulSMul (Localization.Away (Polynomial.X : Polynomial B₁))
        (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁))) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (MvPolynomial.C_injective _ _)
    have : FaithfulSMul Ω (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁))) :=
      (faithfulSMul_iff_algebraMap_injective Ω _).mpr (algebraMap Ω _).injective
    have : FaithfulSMul (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)))
        (Localization S_β) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hInj_Dloc
    have : Algebra.IsAlgebraic (Polynomial B₁) (Localization.Away (Polynomial.X : Polynomial B₁)) :=
      IsLocalization.isAlgebraic _ (Submonoid.powers (Polynomial.X : Polynomial B₁))
    have : Algebra.IsAlgebraic
        (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)))
        (Localization S_β) :=
      IsLocalization.isAlgebraic (Localization S_β) S_β

    have hTr_BT : Algebra.trdeg Ω (Polynomial B₁) = ((k_sl + 2 + 1 : ℕ) : Cardinal.{u}) := by
      rw [← trdeg_add_eq Ω B₁ (A := Polynomial B₁), hTr_B₁, Polynomial.trdeg_of_isDomain]
      push_cast; rfl
    have hTr_Bloc : Algebra.trdeg Ω (Localization.Away (Polynomial.X : Polynomial B₁)) =
        ((k_sl + 3 : ℕ) : Cardinal.{u}) := by
      rw [← trdeg_add_eq Ω (Polynomial B₁)
        (A := Localization.Away (Polynomial.X : Polynomial B₁)),
        hTr_BT, trdeg_eq_zero, add_zero]
    have hTr_Dpoly :
        Algebra.trdeg Ω (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁))) =
        ((k_sl + 3 + (k_sl + 1) * N' : ℕ) : Cardinal.{u}) := by
      rw [← trdeg_add_eq Ω (Localization.Away (Polynomial.X : Polynomial B₁))
        (A := MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁))),
        hTr_Bloc, MvPolynomial.trdeg_of_isDomain]
      simp [hCard_rem]
    have hTr_Dloc : Algebra.trdeg Ω (Localization S_β) =
        ((k_sl + 3 + (k_sl + 1) * N' : ℕ) : Cardinal.{u}) := by
      rw [← trdeg_add_eq Ω (MvPolynomial Idx_rem (Localization.Away (Polynomial.X : Polynomial B₁)))
        (A := Localization S_β), hTr_Dpoly, trdeg_eq_zero, add_zero]

    have : FaithfulSMul Ω (MvPolynomial σ_tot Ω) :=
      (faithfulSMul_iff_algebraMap_injective Ω _).mpr (MvPolynomial.C_injective _ _)
    have : FaithfulSMul (MvPolynomial σ_tot Ω) (Polynomial (MvPolynomial σ_tot Ω)) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr Polynomial.C_injective
    have : FaithfulSMul Ω (Polynomial (MvPolynomial σ_tot Ω)) :=
      (faithfulSMul_iff_algebraMap_injective Ω _).mpr (algebraMap Ω _).injective
    have : FaithfulSMul (Polynomial (MvPolynomial σ_tot Ω))
        (FractionRing (Polynomial (MvPolynomial σ_tot Ω))) :=
      (faithfulSMul_iff_algebraMap_injective (Polynomial (MvPolynomial σ_tot Ω))
        (FractionRing (Polynomial (MvPolynomial σ_tot Ω)))).mpr (IsFractionRing.injective _ _)
    have : Algebra.IsAlgebraic (Polynomial (MvPolynomial σ_tot Ω))
        (FractionRing (Polynomial (MvPolynomial σ_tot Ω))) :=
      IsLocalization.isAlgebraic _ (nonZeroDivisors _)
    have hTr_Pcoeff : Algebra.trdeg Ω (MvPolynomial σ_tot Ω) =
        (((k_sl + 1) * (N' + 1) : ℕ) : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain]
      simp [σ_tot]
    have hTr_Apoly : Algebra.trdeg Ω (Polynomial (MvPolynomial σ_tot Ω)) =
        (((k_sl + 1) * (N' + 1) + 1 : ℕ) : Cardinal.{u}) := by
      rw [← trdeg_add_eq Ω (MvPolynomial σ_tot Ω) (A := Polynomial (MvPolynomial σ_tot Ω)),
        hTr_Pcoeff, Polynomial.trdeg_of_isDomain]
      push_cast; rfl
    have hTr_Kgen : Algebra.trdeg Ω K_gen =
        (((k_sl + 1) * (N' + 1) + 1 : ℕ) : Cardinal.{u}) := by
      rw [← AlgEquiv.trdeg_eq Ξ_K,
        ← trdeg_add_eq Ω (Polynomial (MvPolynomial σ_tot Ω))
          (A := FractionRing (Polynomial (MvPolynomial σ_tot Ω))),
        hTr_Apoly, trdeg_eq_zero, add_zero]

    have : FaithfulSMul Ω K_gen :=
      (faithfulSMul_iff_algebraMap_injective Ω K_gen).mpr (algebraMap Ω K_gen).injective
    have : FaithfulSMul K_gen ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ) :=
      (faithfulSMul_iff_algebraMap_injective K_gen ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ)).mpr
        (algebraMap K_gen ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ)).injective
    have hTr_Q'K_Ω : Algebra.trdeg Ω ((TensorProduct Ω K_gen B₁) ⧸ J'_Kβ) =
        ((k_sl + 3 + (k_sl + 1) * N' : ℕ) : Cardinal.{u}) := by
      rw [← AlgEquiv.trdeg_eq e_quot_comm, AlgEquiv.trdeg_eq e_gen, hTr_Dloc]
    have hTr_sum : (((k_sl + 1) * (N' + 1) + 1 + s_Q : ℕ) : Cardinal.{u}) =
        ((k_sl + 3 + (k_sl + 1) * N' : ℕ) : Cardinal.{u}) := by
      have hadd := trdeg_add_eq Ω K_gen (A := (TensorProduct Ω K_gen B₁) ⧸ J'_Kβ)
      rw [hTr_Kgen, hTr_Q'K, hTr_Q'K_Ω] at hadd
      exact_mod_cast hadd
    have hs_Q_eq : s_Q = 1 := by
      have hnat := Nat.cast_injective hTr_sum
      have hident : (k_sl + 1) * (N' + 1) = (k_sl + 1) * N' + (k_sl + 1) := by ring
      omega
    have hDim_QK : ringKrullDim ((TensorProduct Ω B₁ K_gen) ⧸ J_K₁) ≤ (1 : WithBot ℕ∞) := by
      rw [RingEquiv.ringKrullDim e_quot_comm.toRingEquiv, hDim_Q'K, hs_Q_eq]
      exact le_rfl
    exact ⟨hIsDom_QK, hDim_QK, hb_notin⟩

  
  
  
  have hConj4 : ∀ (L : Type u) [Field L] [Algebra Ω L]
      [Algebra (MvPolynomial (Fin (k_sl + 1) × Fin (N' + 1)) Ω) L]
      [IsScalarTower Ω (MvPolynomial (Fin (k_sl + 1) × Fin (N' + 1)) Ω) L]
      [IsFractionRing (MvPolynomial (Fin (k_sl + 1) × Fin (N' + 1)) Ω) L]
      (P_t : Ideal (Polynomial L)) [P_t.IsPrime],
      P_t = Ideal.span ({Polynomial.X} : Set (Polynomial L)) →
      ∀ (R : Type u) [CommRing R] [IsDomain R]
        [Algebra Ω R] [Algebra L R] [IsScalarTower Ω L R]
        [Algebra (Polynomial L) R] [IsScalarTower L (Polynomial L) R]
        [IsLocalization.AtPrime R P_t]
        (ϖ : R), ϖ = algebraMap (Polynomial L) R Polynomial.X →
      ∀ (ev_R : R →ₐ[L] L), ev_R ϖ = 0 →
      (∀ f : Polynomial L, ev_R (algebraMap (Polynomial L) R f) = f.eval 0) →
      ∀ (u_L : Fin k_sl → Fin (N' + 1) → L),
      (∀ i γ, u_L i γ =
        algebraMap (MvPolynomial (Fin (k_sl + 1) × Fin (N' + 1)) Ω) L
          (MvPolynomial.X (i.castSucc, γ))) →
      ∀ (v_L : Fin (N' + 1) → L)
        (B₁ : Type u) [CommRing B₁] [IsDomain B₁] [Algebra Ω B₁] [Algebra.FiniteType Ω B₁],
      ringKrullDim B₁ = ((k_sl + 2 : ℕ) : WithBot ℕ∞) →
      (IsDomain (TensorProduct Ω B₁ L) ∧
        ringKrullDim (TensorProduct Ω B₁ L) = ((k_sl + 2 : ℕ) : WithBot ℕ∞)) →
      ∀ (r₁ : Fin (N' + 1) → B₁) (β : Fin (N' + 1)), r₁ β = 1 →
      ∀ (c_F' : Fin (N' + 1) → Ω),
      (∑ γ : Fin (N' + 1), algebraMap Ω B₁ (c_F' γ) * r₁ γ) ≠ 0 →
      let K_gen : Type u := FractionRing R
      let h_eq_R : Fin k_sl → TensorProduct Ω B₁ R :=
        fun i => ∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (algebraMap L R (u_L i γ))
      let p_eq_R : TensorProduct Ω B₁ R :=
        (∑ γ : Fin (N' + 1), (algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : R)) +
        (∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (ϖ * algebraMap L R (v_L γ)))
      let J_R₁ : Ideal (TensorProduct Ω B₁ R) :=
        Ideal.span ({p_eq_R} ∪ Set.range h_eq_R)
      let toK₁ : TensorProduct Ω B₁ R →+* TensorProduct Ω B₁ K_gen :=
        (Algebra.TensorProduct.map (AlgHom.id Ω B₁) (IsScalarTower.toAlgHom Ω R K_gen)).toRingHom
      let toL₁ : TensorProduct Ω B₁ R →+* TensorProduct Ω B₁ L :=
        (Algebra.TensorProduct.map (AlgHom.id Ω B₁) (ev_R.restrictScalars Ω)).toRingHom
      let J_K₁ : Ideal (TensorProduct Ω B₁ K_gen) := Ideal.map toK₁ J_R₁
      let J_L₁ : Ideal (TensorProduct Ω B₁ L) := Ideal.map toL₁ J_R₁
      ringKrullDim ((TensorProduct Ω B₁ L) ⧸ J_L₁) ≤ (1 : WithBot ℕ∞) ∧
      (∀ 𝔮_L : PrimeSpectrum (TensorProduct Ω B₁ L),
        J_L₁ ≤ 𝔮_L.asIdeal →
        Ideal.comap toK₁ J_K₁ ≤ (PrimeSpectrum.comap toL₁ 𝔮_L).asIdeal) := by
    intro L _ _ _ _ _ P_t _ hPt R _ _ _ _ _ _ _ _ ϖ hϖ ev_R hev_ϖ hev_poly
      u_L hu_L v_L B₁ _ _ _ _ hDimB₁ hDomCL r₁ β hr_β c_F' hf₁_ne
    classical
    intro K_gen h_eq_R p_eq_R J_R₁ toK₁ toL₁ J_K₁ J_L₁
    let f₁ : B₁ := ∑ γ : Fin (N' + 1), algebraMap Ω B₁ (c_F' γ) * r₁ γ

    have htoL_p : toL₁ p_eq_R = f₁ ⊗ₜ[Ω] (1 : L) := by
      have hf_tmul : f₁ ⊗ₜ[Ω] (1 : L) =
          ∑ γ : Fin (N' + 1), (algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : L) :=
        map_sum (Algebra.TensorProduct.includeLeft : B₁ →ₐ[Ω] TensorProduct Ω B₁ L) _ _
      rw [hf_tmul]
      simp only [toL₁, p_eq_R, map_add, map_sum, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgHom.restrictScalars_apply,
        map_one, map_mul, hev_ϖ, zero_mul, TensorProduct.tmul_zero, Finset.sum_const_zero, add_zero]

    have htoL_h : ∀ i : Fin k_sl,
        toL₁ (h_eq_R i) = ∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (u_L i γ) := by
      intro i
      simp only [toL₁, h_eq_R, map_sum, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgHom.restrictScalars_apply,
        AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]

    have hDimJL : ringKrullDim ((TensorProduct Ω B₁ L) ⧸ J_L₁) ≤ (1 : WithBot ℕ∞) := by
      let Idx_L : Type := { idx : σ_tot // idx.1 = Fin.last k_sl ∨ idx.2 ≠ β }
      let e_compl_L : Fin k_sl ≃ { idx : σ_tot // ¬ (idx.1 = Fin.last k_sl ∨ idx.2 ≠ β) } :=
        { toFun := fun i => ⟨(i.castSucc, β), by
            push Not
            exact ⟨ne_of_lt (Fin.castSucc_lt_last i), rfl⟩⟩
          invFun := fun ⟨⟨j, _⟩, hnot⟩ =>
            let hj : j ≠ Fin.last k_sl := fun h => hnot (Or.inl h)
            Classical.choose (Fin.eq_castSucc_of_ne_last hj)
          left_inv := fun i => by
            have hj : (i.castSucc : Fin (k_sl + 1)) ≠ Fin.last k_sl :=
              ne_of_lt (Fin.castSucc_lt_last i)
            exact Fin.castSucc_injective k_sl (Classical.choose_spec (Fin.eq_castSucc_of_ne_last hj))
          right_inv := fun ⟨⟨j, γ⟩, hnot⟩ => by
            have hj : j ≠ Fin.last k_sl := fun h => hnot (Or.inl h)
            have hγ : γ = β := by_contra fun h => hnot (Or.inr h)
            apply Subtype.ext
            exact Prod.ext (Classical.choose_spec (Fin.eq_castSucc_of_ne_last hj)) hγ.symm }
      have hCard_IdxL : Fintype.card Idx_L = (k_sl + 1) * (N' + 1) - k_sl := by
        have h1 := Fintype.card_subtype_compl
          (fun idx : σ_tot => ¬ (idx.1 = Fin.last k_sl ∨ idx.2 ≠ β))
        have heq_sub : Idx_L ≃ { idx : σ_tot // ¬ ¬ (idx.1 = Fin.last k_sl ∨ idx.2 ≠ β) } :=
          Equiv.subtypeEquivRight fun _ => not_not.symm
        rw [Fintype.card_congr heq_sub, h1, Fintype.card_congr e_compl_L.symm, Fintype.card_fin]
        simp [σ_tot]
      have hk_le_tot : k_sl ≤ (k_sl + 1) * (N' + 1) := by nlinarith

      change Order.krullDim (PrimeSpectrum ((TensorProduct Ω B₁ L) ⧸ J_L₁)) ≤ (1 : WithBot ℕ∞)
      rw [Order.krullDim]
      refine iSup_le fun s_ch => ?_
      let q_JL : TensorProduct Ω B₁ L →+* ((TensorProduct Ω B₁ L) ⧸ J_L₁) :=
        Ideal.Quotient.mk J_L₁
      let 𝔓 : Ideal (TensorProduct Ω B₁ L) := Ideal.comap q_JL (s_ch 0).asIdeal
      have : 𝔓.IsPrime := (s_ch 0).isPrime.comap q_JL
      have hJL_le_𝔓 : J_L₁ ≤ 𝔓 := by
        intro z hz
        change q_JL z ∈ (s_ch 0).asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hz]
        exact (s_ch 0).asIdeal.zero_mem
      have hs_len_le : (s_ch.length : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω B₁ L) ⧸ 𝔓) := by
        rw [ringKrullDim_quotient]
        let g_emb : PrimeSpectrum ((TensorProduct Ω B₁ L) ⧸ J_L₁) →
            PrimeSpectrum (TensorProduct Ω B₁ L) := PrimeSpectrum.comap q_JL
        have hg_strict : StrictMono g_emb := by
          intro p₁ p₂ hlt
          change Ideal.comap q_JL p₁.asIdeal < Ideal.comap q_JL p₂.asIdeal
          refine lt_of_le_of_ne (Ideal.comap_mono hlt.le) fun heq => hlt.ne ?_
          apply PrimeSpectrum.ext
          ext z
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
          exact SetLike.ext_iff.mp heq x
        let f_z : Fin (s_ch.length + 1) → ↥(PrimeSpectrum.zeroLocus (𝔓 : Set (TensorProduct Ω B₁ L))) :=
          fun k => ⟨g_emb (s_ch k), by
            rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
            exact Ideal.comap_mono (s_ch.monotone (Fin.zero_le k))⟩
        have hf_z_strict : StrictMono f_z := fun k₁ k₂ hlt => hg_strict (s_ch.strictMono hlt)
        let s' : LTSeries ↥(PrimeSpectrum.zeroLocus (𝔓 : Set (TensorProduct Ω B₁ L))) :=
          LTSeries.mk s_ch.length f_z hf_z_strict
        have hlen_eq : s_ch.length = s'.length := (LTSeries.mk_length _ _ _).symm
        rw [hlen_eq]
        exact Order.LTSeries.length_le_krullDim s'

      refine hs_len_le.trans ?_
      have : IsDomain ((TensorProduct Ω B₁ L) ⧸ 𝔓) := Ideal.Quotient.isDomain 𝔓
      let 𝔭_B : Ideal B₁ :=
        Ideal.comap (Algebra.TensorProduct.includeLeftRingHom : B₁ →+* TensorProduct Ω B₁ L) 𝔓
      have : 𝔭_B.IsPrime := Ideal.IsPrime.comap _
      have : IsDomain (B₁ ⧸ 𝔭_B) := Ideal.Quotient.isDomain 𝔭_B
      have : IsNoetherianRing (B₁ ⧸ 𝔭_B) := Algebra.FiniteType.isNoetherianRing Ω (B₁ ⧸ 𝔭_B)
      have hf₁_mem_𝔭 : f₁ ∈ 𝔭_B := by
        change f₁ ⊗ₜ[Ω] (1 : L) ∈ 𝔓
        rw [← htoL_p]
        exact hJL_le_𝔓 (Ideal.mem_map_of_mem _ (Ideal.subset_span (Or.inl rfl)))
      have hDim_AB_succ : ringKrullDim (B₁ ⧸ 𝔭_B) + 1 ≤ ((k_sl + 2 : ℕ) : WithBot ℕ∞) := by
        rw [← hDimB₁]
        exact ringKrullDim_succ_le_of_surjective (Ideal.Quotient.mk 𝔭_B)
          Ideal.Quotient.mk_surjective (mem_nonZeroDivisors_of_ne_zero hf₁_ne)
          (Ideal.Quotient.eq_zero_iff_mem.mpr hf₁_mem_𝔭)
      have hDim_Pθ : ringKrullDim (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B)) ≤
          (((k_sl + 1) * (N' + 1) + 1 : ℕ) : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ENat.card_eq_coe_fintype_card,
          hCard_IdxL]
        obtain ⟨s_AB, hDim_AB, _⟩ := hDimTrdeg Ω (B₁ ⧸ 𝔭_B)
        rw [hDim_AB] at hDim_AB_succ ⊢
        have hs_le : s_AB + 1 ≤ k_sl + 2 := by
          change (((s_AB : ℕ) : ℕ∞) : WithBot ℕ∞) + (((1 : ℕ) : ℕ∞) : WithBot ℕ∞) ≤
            (((k_sl + 2 : ℕ) : ℕ∞) : WithBot ℕ∞) at hDim_AB_succ
          rw [← WithBot.coe_add, WithBot.coe_le_coe, ← Nat.cast_add, Nat.cast_le] at hDim_AB_succ
          exact hDim_AB_succ
        have htot_le : s_AB + ((k_sl + 1) * (N' + 1) - k_sl) ≤ (k_sl + 1) * (N' + 1) + 1 := by omega
        exact_mod_cast WithBot.coe_le_coe.mpr (Nat.cast_le.mpr htot_le)

      let mk_𝔓 : TensorProduct Ω B₁ L →ₐ[Ω] ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        Ideal.Quotient.mkₐ Ω 𝔓
      let ι_AB : (B₁ ⧸ 𝔭_B) →ₐ[Ω] ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        Ideal.Quotient.liftₐ 𝔭_B (mk_𝔓.comp Algebra.TensorProduct.includeLeft)
          (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr hb)
      let θ_ring : MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) →+* ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        MvPolynomial.eval₂Hom ι_AB.toRingHom (fun idx : Idx_L =>
          mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L (MvPolynomial.X idx.1)))
      let θ : MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) →ₐ[Ω] ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        { θ_ring with
          commutes' := fun c => by
            change θ_ring (algebraMap Ω (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B)) c) =
              algebraMap Ω ((TensorProduct Ω B₁ L) ⧸ 𝔓) c
            rw [IsScalarTower.algebraMap_apply Ω (B₁ ⧸ 𝔭_B) (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B)) c,
              MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C]
            exact ι_AB.commutes c }
      have : (RingHom.ker θ.toRingHom).IsPrime := RingHom.ker_isPrime θ.toRingHom
      have : IsDomain (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) :=
        Ideal.Quotient.isDomain (RingHom.ker θ.toRingHom)
      have : Algebra.FiniteType Ω (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω (RingHom.ker θ.toRingHom))
          Ideal.Quotient.mk_surjective
      obtain ⟨s_θ, hDim_Qθ, hTr_Qθ⟩ := hDimTrdeg Ω (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)
      have hs_θ_le : s_θ ≤ (k_sl + 1) * (N' + 1) + 1 := by
        have hle : ((s_θ : ℕ) : WithBot ℕ∞) ≤ (((k_sl + 1) * (N' + 1) + 1 : ℕ) : WithBot ℕ∞) :=
          hDim_Qθ.symm.trans_le ((ringKrullDim_quotient_le (RingHom.ker θ.toRingHom)).trans hDim_Pθ)
        exact Nat.cast_le.mp (WithBot.coe_le_coe.mp hle)

      let : CommRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) := inferInstance
      let : CommRing (FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)) :=
        inferInstance
      let : CommRing ((TensorProduct Ω B₁ L) ⧸ 𝔓) := inferInstance
      let : CommRing (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓)) := inferInstance
      let j_E : ((TensorProduct Ω B₁ L) ⧸ 𝔓) →+* FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        algebraMap ((TensorProduct Ω B₁ L) ⧸ 𝔓) (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓))
      let θ_lift : (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) →ₐ[Ω]
          ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        Ideal.Quotient.liftₐ (RingHom.ker θ.toRingHom) θ (fun _ h => h)
      have hInj_θlift : Function.Injective θ_lift := by
        intro q₁ q₂ hq
        obtain ⟨p₁, rfl⟩ := Ideal.Quotient.mk_surjective q₁
        obtain ⟨p₂, rfl⟩ := Ideal.Quotient.mk_surjective q₂
        rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, RingHom.mem_ker, map_sub]
        exact sub_eq_zero.mpr hq
      let ι_Qθ : (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) →+*
          FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        j_E.comp θ_lift.toRingHom
      have hInj_ιQθ : Function.Injective ι_Qθ :=
        (IsFractionRing.injective ((TensorProduct Ω B₁ L) ⧸ 𝔓)
          (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓))).comp hInj_θlift
      have hQθ_units : ∀ y : nonZeroDivisors (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom),
          IsUnit (ι_Qθ y) := by
        intro y
        have hy : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        exact isUnit_iff_ne_zero.mpr fun h0 => hy (hInj_ιQθ (h0.trans (map_zero _).symm))
      let ξ_θ : FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) →+*
          FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        IsLocalization.lift (S := FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)) hQθ_units
      have hξ_θ_eq : ∀ q : MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom,
          ξ_θ (algebraMap _ _ q) = ι_Qθ q :=
        IsLocalization.lift_eq (S := FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)) hQθ_units
      have hSurj_ξθ : Function.Surjective ξ_θ := by
        let S_θ : Subfield (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓)) := ξ_θ.fieldRange
        have hθ_mem : ∀ p : MvPolynomial Idx_L (B₁ ⧸ 𝔭_B), j_E (θ p) ∈ S_θ := fun p =>
          ⟨algebraMap _ _ (Ideal.Quotient.mk (RingHom.ker θ.toRingHom) p), by
            rw [hξ_θ_eq]; rfl⟩
        have hb_mem : ∀ b : B₁, j_E (mk_𝔓 (b ⊗ₜ[Ω] (1 : L))) ∈ S_θ := by
          intro b
          have heq : mk_𝔓 (b ⊗ₜ[Ω] (1 : L)) = θ (MvPolynomial.C (Ideal.Quotient.mk 𝔭_B b)) := by
            change _ = θ_ring (MvPolynomial.C (Ideal.Quotient.mk 𝔭_B b))
            rw [MvPolynomial.eval₂Hom_C]
            rfl
          rw [heq]
          exact hθ_mem _
        have hX_mem : ∀ idx : σ_tot,
            j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L (MvPolynomial.X idx))) ∈ S_θ := by
          intro idx
          by_cases h_in : idx.1 = Fin.last k_sl ∨ idx.2 ≠ β
          · have heq : mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L (MvPolynomial.X idx)) =
                θ (MvPolynomial.X ⟨idx, h_in⟩) := by
              change _ = θ_ring (MvPolynomial.X ⟨idx, h_in⟩)
              rw [MvPolynomial.eval₂Hom_X']
            rw [heq]
            exact hθ_mem _
          · push Not at h_in
            rcases idx with ⟨j, γ⟩
            dsimp at h_in
            obtain ⟨i, rfl⟩ := Fin.eq_castSucc_of_ne_last h_in.1
            have hγ' : β = γ := h_in.2.symm
            subst hγ'
            have hmem_JL : toL₁ (h_eq_R i) ∈ 𝔓 :=
              hJL_le_𝔓 (Ideal.mem_map_of_mem _ (Ideal.subset_span (Or.inr ⟨i, rfl⟩)))
            have h0 : mk_𝔓 (toL₁ (h_eq_R i)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem_JL
            rw [htoL_h i, map_sum] at h0
            have hprod_sum : (∑ γ' : Fin (N' + 1),
                mk_𝔓 ((r₁ γ') ⊗ₜ[Ω] (1 : L)) * mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] (u_L i γ'))) = 0 := by
              rw [← h0]
              refine Finset.sum_congr rfl fun γ' _ => ?_
              rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ β), hr_β] at hprod_sum
            have h1_one : mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] (1 : L)) = 1 := map_one mk_𝔓
            rw [h1_one, one_mul] at hprod_sum
            have hu_eq : mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] (u_L i β)) =
                -(∑ x ∈ Finset.univ.erase β,
                  mk_𝔓 ((r₁ x) ⊗ₜ[Ω] (1 : L)) * mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] (u_L i x))) :=
              eq_neg_of_add_eq_zero_left hprod_sum
            rw [← hu_L i β, hu_eq, map_neg, map_sum]
            refine S_θ.neg_mem (Subfield.sum_mem S_θ fun γ' hγ'_er => ?_)
            rw [map_mul, hu_L i γ']
            have hne : γ' ≠ β := Finset.ne_of_mem_erase hγ'_er
            have heq_X : mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L (MvPolynomial.X (i.castSucc, γ'))) =
                θ (MvPolynomial.X ⟨(i.castSucc, γ'), Or.inr hne⟩) := by
              change _ = θ_ring (MvPolynomial.X ⟨(i.castSucc, γ'), Or.inr hne⟩)
              rw [MvPolynomial.eval₂Hom_X']
            rw [heq_X]
            exact S_θ.mul_mem (hb_mem (r₁ γ')) (hθ_mem _)
        let ψ_P : P_coeff →+* FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
          j_E.comp (mk_𝔓.toRingHom.comp
            ((Algebra.TensorProduct.includeRight : L →ₐ[Ω] TensorProduct Ω B₁ L).toRingHom.comp
              (algebraMap P_coeff L)))
        have hP_mem : ∀ p : P_coeff, ψ_P p ∈ S_θ := by
          intro p
          induction p using MvPolynomial.induction_on with
          | C c =>
            change j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L (MvPolynomial.C c))) ∈ S_θ
            rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply Ω P_coeff L c]
            have hc_eq : ((1 : B₁) ⊗ₜ[Ω] algebraMap Ω L c) = (algebraMap Ω B₁ c) ⊗ₜ[Ω] (1 : L) := by
              calc (1 : B₁) ⊗ₜ[Ω] algebraMap Ω L c
                  = (1 : B₁) ⊗ₜ[Ω] (c • (1 : L)) := by congr 1; symm; rw [Algebra.smul_def, mul_one]
                _ = (c • (1 : B₁)) ⊗ₜ[Ω] (1 : L) := (TensorProduct.smul_tmul c (1 : B₁) (1 : L)).symm
                _ = (algebraMap Ω B₁ c) ⊗ₜ[Ω] (1 : L) := by congr 1; rw [Algebra.smul_def, mul_one]
            rw [hc_eq]
            exact hb_mem (algebraMap Ω B₁ c)
          | add p₁ p₂ hp₁ hp₂ =>
            rw [map_add]
            exact S_θ.add_mem hp₁ hp₂
          | mul_X p₁ idx hp₁ =>
            rw [map_mul]
            exact S_θ.mul_mem hp₁ (hX_mem idx)
        have hL_mem : ∀ ℓ : L, j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] ℓ)) ∈ S_θ := by
          intro ℓ
          obtain ⟨⟨p₁, p₂⟩, hp⟩ := IsLocalization.surj (nonZeroDivisors P_coeff) ℓ
          have hp₂_ne_L : algebraMap P_coeff L p₂.1 ≠ 0 := by
            have h0 : p₂.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp p₂.2
            exact fun hz => h0 ((IsFractionRing.injective P_coeff L) (hz.trans (map_zero _).symm))
          have hp₂_unit_E : IsUnit (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L p₂.1)) := by
            refine IsUnit.of_mul_eq_one (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] (algebraMap P_coeff L p₂.1)⁻¹)) ?_
            rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
              mul_inv_cancel₀ hp₂_ne_L]
            exact map_one mk_𝔓
          have hp₂_ne : ψ_P p₂.1 ≠ 0 := by
            change j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L p₂.1)) ≠ 0
            exact (hp₂_unit_E.map j_E).ne_zero
          have hmul : j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] ℓ)) * ψ_P p₂.1 = ψ_P p₁ := by
            change j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] ℓ)) *
                j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L p₂.1)) =
              j_E (mk_𝔓 ((1 : B₁) ⊗ₜ[Ω] algebraMap P_coeff L p₁))
            rw [← map_mul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, hp]
          have hmem := S_θ.mul_mem (hP_mem p₁) (S_θ.inv_mem (hP_mem p₂.1))
          rwa [← hmul, mul_inv_cancel_right₀ hp₂_ne] at hmem
        have hE_mem : ∀ y : (TensorProduct Ω B₁ L) ⧸ 𝔓, j_E y ∈ S_θ := by
          intro y
          obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
          change j_E (mk_𝔓 z) ∈ S_θ
          induction z using TensorProduct.inductionOn with
          | tmul b ℓ =>
            have hdecomp : (b ⊗ₜ[Ω] ℓ : TensorProduct Ω B₁ L) =
                (b ⊗ₜ[Ω] (1 : L)) * ((1 : B₁) ⊗ₜ[Ω] ℓ) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            rw [hdecomp, map_mul, map_mul]
            exact S_θ.mul_mem (hb_mem b) (hL_mem ℓ)
          | add z₁ z₂ hz₁ hz₂ =>
            rw [map_add, map_add]
            exact S_θ.add_mem hz₁ hz₂
        intro w
        obtain ⟨⟨y₁, y₂⟩, hy⟩ := IsLocalization.surj (nonZeroDivisors ((TensorProduct Ω B₁ L) ⧸ 𝔓)) w
        have hy₂_ne : j_E y₂.1 ≠ 0 := by
          have h0 : y₂.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y₂.2
          exact fun hz => h0 ((IsFractionRing.injective _ _) (hz.trans (map_zero _).symm))
        have hmem := S_θ.mul_mem (hE_mem y₁) (S_θ.inv_mem (hE_mem y₂.1))
        rwa [← hy, mul_inv_cancel_right₀ hy₂_ne] at hmem

      let Ξ_θ_ring : FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) ≃+*
          FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        RingEquiv.ofBijective ξ_θ ⟨ξ_θ.injective, hSurj_ξθ⟩
      let Ξ_θ : FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) ≃ₐ[Ω]
          FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        { Ξ_θ_ring with
          commutes' := fun c => by
            change ξ_θ (algebraMap Ω _ c) = algebraMap Ω _ c
            rw [IsScalarTower.algebraMap_apply Ω
              (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) _ c, hξ_θ_eq]
            change j_E (θ_lift (algebraMap Ω _ c)) = _
            rw [θ_lift.commutes]
            exact (IsScalarTower.algebraMap_apply Ω ((TensorProduct Ω B₁ L) ⧸ 𝔓) _ c).symm }

      let e_comm_L : TensorProduct Ω B₁ L ≃ₐ[Ω] TensorProduct Ω L B₁ :=
        Algebra.TensorProduct.comm Ω B₁ L
      let 𝔓' : Ideal (TensorProduct Ω L B₁) := Ideal.map e_comm_L 𝔓
      let e_E_comm : ((TensorProduct Ω B₁ L) ⧸ 𝔓) ≃ₐ[Ω] ((TensorProduct Ω L B₁) ⧸ 𝔓') :=
        Ideal.quotientEquivAlg 𝔓 𝔓' e_comm_L rfl
      have : IsDomain ((TensorProduct Ω L B₁) ⧸ 𝔓') :=
        Function.Injective.isDomain e_E_comm.symm.toRingHom e_E_comm.symm.injective
      obtain ⟨s_E, hDim_E', hTr_E'⟩ := hDimTrdeg L ((TensorProduct Ω L B₁) ⧸ 𝔓')

      have : FaithfulSMul Ω (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom) :=
        (faithfulSMul_iff_algebraMap_injective Ω _).mpr (algebraMap Ω _).injective
      have : FaithfulSMul (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)
          (FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)) :=
        (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
      have : Algebra.IsAlgebraic (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)
          (FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)) :=
        IsLocalization.isAlgebraic _ (nonZeroDivisors _)
      have : FaithfulSMul Ω ((TensorProduct Ω B₁ L) ⧸ 𝔓) :=
        (faithfulSMul_iff_algebraMap_injective Ω _).mpr (algebraMap Ω _).injective
      have : FaithfulSMul ((TensorProduct Ω B₁ L) ⧸ 𝔓)
          (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓)) :=
        (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
      have : Algebra.IsAlgebraic ((TensorProduct Ω B₁ L) ⧸ 𝔓)
          (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓)) :=
        IsLocalization.isAlgebraic _ (nonZeroDivisors _)
      have : FaithfulSMul Ω P_coeff :=
        (faithfulSMul_iff_algebraMap_injective Ω P_coeff).mpr (MvPolynomial.C_injective _ _)
      have : FaithfulSMul P_coeff L :=
        (faithfulSMul_iff_algebraMap_injective P_coeff L).mpr (IsFractionRing.injective P_coeff L)
      have : Algebra.IsAlgebraic P_coeff L :=
        IsLocalization.isAlgebraic L (nonZeroDivisors P_coeff)
      have : FaithfulSMul Ω L :=
        (faithfulSMul_iff_algebraMap_injective Ω L).mpr (algebraMap Ω L).injective
      have : FaithfulSMul L ((TensorProduct Ω L B₁) ⧸ 𝔓') :=
        (faithfulSMul_iff_algebraMap_injective L ((TensorProduct Ω L B₁) ⧸ 𝔓')).mpr
          (algebraMap L ((TensorProduct Ω L B₁) ⧸ 𝔓')).injective

      have hTr_L : Algebra.trdeg Ω L = (((k_sl + 1) * (N' + 1) : ℕ) : Cardinal.{u}) := by
        rw [← trdeg_add_eq Ω P_coeff (A := L), MvPolynomial.trdeg_of_isDomain, trdeg_eq_zero, add_zero]
        simp [σ_tot]
      have hTr_E_Ω : Algebra.trdeg Ω ((TensorProduct Ω L B₁) ⧸ 𝔓') = (s_θ : Cardinal.{u}) := by
        calc Algebra.trdeg Ω ((TensorProduct Ω L B₁) ⧸ 𝔓')
            = Algebra.trdeg Ω ((TensorProduct Ω B₁ L) ⧸ 𝔓) := (AlgEquiv.trdeg_eq e_E_comm).symm
          _ = Algebra.trdeg Ω ((TensorProduct Ω B₁ L) ⧸ 𝔓) +
                Algebra.trdeg ((TensorProduct Ω B₁ L) ⧸ 𝔓)
                  (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓)) := by
                rw [trdeg_eq_zero (R := (TensorProduct Ω B₁ L) ⧸ 𝔓), add_zero]
          _ = Algebra.trdeg Ω (FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓)) :=
                trdeg_add_eq Ω ((TensorProduct Ω B₁ L) ⧸ 𝔓)
                  (A := FractionRing ((TensorProduct Ω B₁ L) ⧸ 𝔓))
          _ = Algebra.trdeg Ω
                (FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)) :=
                (AlgEquiv.trdeg_eq Ξ_θ).symm
          _ = (s_θ : Cardinal.{u}) := by
                rw [← trdeg_add_eq Ω (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)
                  (A := FractionRing (MvPolynomial Idx_L (B₁ ⧸ 𝔭_B) ⧸ RingHom.ker θ.toRingHom)),
                  hTr_Qθ, trdeg_eq_zero, add_zero]
      have hTr_eq : (((k_sl + 1) * (N' + 1) + s_E : ℕ) : Cardinal.{u}) = (s_θ : Cardinal.{u}) := by
        have hadd := trdeg_add_eq Ω L (A := (TensorProduct Ω L B₁) ⧸ 𝔓')
        rw [hTr_L, hTr_E', hTr_E_Ω] at hadd
        exact_mod_cast hadd
      have hs_E_le : s_E ≤ 1 := by
        have hnat := Nat.cast_injective hTr_eq
        omega
      rw [RingEquiv.ringKrullDim e_E_comm.toRingEquiv, hDim_E']
      exact_mod_cast WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hs_E_le)

    
    refine ⟨hDimJL, fun 𝔮_L hJL_le_𝔮 => ?_⟩
    let e_comm_BL : TensorProduct Ω B₁ L ≃ₐ[Ω] TensorProduct Ω L B₁ :=
      Algebra.TensorProduct.comm Ω B₁ L
    have : IsDomain (TensorProduct Ω B₁ L) := hDomCL.1
    have : IsDomain (TensorProduct Ω L B₁) :=
      Function.Injective.isDomain e_comm_BL.symm.toRingHom e_comm_BL.symm.injective
    have : IsNoetherianRing (TensorProduct Ω L B₁) :=
      Algebra.FiniteType.isNoetherianRing L (TensorProduct Ω L B₁)
    have hDim_C'L : ringKrullDim (TensorProduct Ω L B₁) = ((k_sl + 2 : ℕ) : WithBot ℕ∞) :=
      (RingEquiv.ringKrullDim e_comm_BL.symm.toRingEquiv).trans hDomCL.2
    have hDim_AT : ringKrullDim (Polynomial (TensorProduct Ω L B₁)) =
        ((k_sl + 3 : ℕ) : WithBot ℕ∞) := by
      rw [Polynomial.ringKrullDim_of_isNoetherianRing, hDim_C'L]
      rfl

    have hLiftTensorΩ : ∀ {E T : Type u} [CommRing E] [Algebra Ω E] [CommRing T]
        (fB : B₁ →+* T) (fE : E →+* T),
        fB.comp (algebraMap Ω B₁) = fE.comp (algebraMap Ω E) →
        ∃ F : TensorProduct Ω B₁ E →+* T,
          ∀ (b : B₁) (e : E), F (b ⊗ₜ[Ω] e) = fB b * fE e := by
      intro E T _ _ _ fB fE hagree
      let : Algebra Ω T := (fB.comp (algebraMap Ω B₁)).toAlgebra
      let fB_alg : B₁ →ₐ[Ω] T := { fB with commutes' := fun _ => rfl }
      let fE_alg : E →ₐ[Ω] T :=
        { fE with commutes' := fun c => (RingHom.congr_fun hagree c).symm }
      let F := Algebra.TensorProduct.lift fB_alg fE_alg (fun _ _ => Commute.all _ _)
      exact ⟨F.toRingHom, fun b e => Algebra.TensorProduct.lift_tmul fB_alg fE_alg _ b e⟩

    let φ₀ : TensorProduct Ω L B₁ →ₐ[Ω] TensorProduct Ω B₁ R :=
      (Algebra.TensorProduct.comm Ω R B₁).toAlgHom.comp
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom Ω L R) (AlgHom.id Ω B₁))
    have hφ₀_tmul : ∀ (ℓ : L) (b : B₁), φ₀ (ℓ ⊗ₜ[Ω] b) = b ⊗ₜ[Ω] algebraMap L R ℓ :=
      fun _ _ => rfl
    let φ_TR : Polynomial (TensorProduct Ω L B₁) →+* TensorProduct Ω B₁ R :=
      Polynomial.eval₂RingHom φ₀.toRingHom ((1 : B₁) ⊗ₜ[Ω] ϖ)
    let ι_LT : Polynomial L →+* Polynomial (TensorProduct Ω L B₁) :=
      Polynomial.mapRingHom
        (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct Ω L B₁)
    let incR_DR : R →+* TensorProduct Ω B₁ R :=
      (Algebra.TensorProduct.includeRight : R →ₐ[Ω] TensorProduct Ω B₁ R).toRingHom
    have hφ_ιLT : φ_TR.comp ι_LT = incR_DR.comp (algebraMap (Polynomial L) R) := by
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun ℓ => ?_
        change φ_TR ((Polynomial.mapRingHom _) (Polynomial.C ℓ)) =
          (1 : B₁) ⊗ₜ[Ω] algebraMap (Polynomial L) R (Polynomial.C ℓ)
        rw [Polynomial.coe_mapRingHom, Polynomial.map_C, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C]
        change φ₀ (ℓ ⊗ₜ[Ω] (1 : B₁)) = _
        rw [hφ₀_tmul, ← Polynomial.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply L (Polynomial L) R ℓ]
      · change φ_TR ((Polynomial.mapRingHom _) Polynomial.X) =
          (1 : B₁) ⊗ₜ[Ω] algebraMap (Polynomial L) R Polynomial.X
        rw [Polynomial.coe_mapRingHom, Polynomial.map_X, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_X, hϖ]

    let M_0A : Submonoid (Polynomial (TensorProduct Ω L B₁)) := P_t.primeCompl.map ι_LT.toMonoidHom
    let : CommRing (Localization M_0A) := inferInstance
    have hM0A_units : ∀ y : M_0A, IsUnit (φ_TR y) := by
      rintro ⟨_, g, hg, rfl⟩
      have h1 : φ_TR (ι_LT g) = incR_DR (algebraMap (Polynomial L) R g) :=
        RingHom.congr_fun hφ_ιLT g
      change IsUnit (φ_TR (ι_LT g))
      rw [h1]
      exact (IsLocalization.map_units R ⟨g, hg⟩).map incR_DR
    let Φ_R : Localization M_0A →+* TensorProduct Ω B₁ R :=
      IsLocalization.lift (S := Localization M_0A) hM0A_units
    let ι_locR : Polynomial (TensorProduct Ω L B₁) →+* Localization M_0A :=
      algebraMap (Polynomial (TensorProduct Ω L B₁)) (Localization M_0A)
    let ψ_B_R : B₁ →+* Localization M_0A :=
      ι_locR.comp (Polynomial.C.comp
        (Algebra.TensorProduct.includeRight : B₁ →ₐ[Ω] TensorProduct Ω L B₁).toRingHom)
    have hPt_units_locR : ∀ g : P_t.primeCompl, IsUnit ((ι_locR.comp ι_LT) g) := by
      intro g
      exact IsLocalization.map_units (Localization M_0A)
        ⟨ι_LT g.1, Submonoid.mem_map_of_mem ι_LT.toMonoidHom g.2⟩
    let ψ_R_R : R →+* Localization M_0A := IsLocalization.lift (S := R) hPt_units_locR
    have hψ_R_poly : ∀ g : Polynomial L, ψ_R_R (algebraMap (Polynomial L) R g) = ι_locR (ι_LT g) :=
      IsLocalization.lift_eq (S := R) hPt_units_locR
    have hψ_R_L : ∀ ℓ : L, ψ_R_R (algebraMap L R ℓ) = ι_locR (Polynomial.C (ℓ ⊗ₜ[Ω] (1 : B₁))) := by
      intro ℓ
      rw [IsScalarTower.algebraMap_apply L (Polynomial L) R ℓ, Polynomial.algebraMap_eq, hψ_R_poly]
      change ι_locR ((Polynomial.mapRingHom _) (Polynomial.C ℓ)) = _
      rw [Polynomial.coe_mapRingHom, Polynomial.map_C]
      rfl
    have hψ_BR_agree : ψ_B_R.comp (algebraMap Ω B₁) = ψ_R_R.comp (algebraMap Ω R) := by
      ext c
      simp only [ψ_B_R, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Algebra.TensorProduct.includeRight_apply]
      rw [IsScalarTower.algebraMap_apply Ω L R c, hψ_R_L]
      congr 2
      calc (1 : L) ⊗ₜ[Ω] algebraMap Ω B₁ c
          = (1 : L) ⊗ₜ[Ω] (c • (1 : B₁)) := by congr 1; symm; rw [Algebra.smul_def, mul_one]
        _ = (c • (1 : L)) ⊗ₜ[Ω] (1 : B₁) := (TensorProduct.smul_tmul c (1 : L) (1 : B₁)).symm
        _ = (algebraMap Ω L c) ⊗ₜ[Ω] (1 : B₁) := by congr 1; rw [Algebra.smul_def, mul_one]
    obtain ⟨Ψ_R, hΨ_R_tmul⟩ := hLiftTensorΩ ψ_B_R ψ_R_R hψ_BR_agree
    have hΨΦ_R : Ψ_R.comp Φ_R = RingHom.id (Localization M_0A) := by
      apply IsLocalization.ringHom_ext M_0A
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun z => ?_
        change Ψ_R (Φ_R (ι_locR (Polynomial.C z))) = ι_locR (Polynomial.C z)
        rw [IsLocalization.lift_eq]
        dsimp only [φ_TR]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change Ψ_R (φ₀ z) = ι_locR (Polynomial.C z)
        induction z using TensorProduct.inductionOn with
        | tmul ℓ b =>
          rw [hφ₀_tmul, hΨ_R_tmul, hψ_R_L]
          simp only [ψ_B_R, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.includeRight_apply, ← map_mul,
            Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
      · change Ψ_R (Φ_R (ι_locR Polynomial.X)) = ι_locR Polynomial.X
        rw [IsLocalization.lift_eq]
        dsimp only [φ_TR]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        rw [hΨ_R_tmul, map_one, one_mul, hϖ, hψ_R_poly]
        change ι_locR ((Polynomial.mapRingHom _) Polynomial.X) = _
        rw [Polynomial.coe_mapRingHom, Polynomial.map_X]
    have hΦΨ_R : ∀ d : TensorProduct Ω B₁ R, Φ_R (Ψ_R d) = d := by
      have hΦ_ψR : Φ_R.comp ψ_R_R = incR_DR := by
        apply IsLocalization.ringHom_ext P_t.primeCompl
        refine RingHom.ext fun g => ?_
        change Φ_R (ψ_R_R (algebraMap (Polynomial L) R g)) = incR_DR (algebraMap (Polynomial L) R g)
        rw [hψ_R_poly, IsLocalization.lift_eq]
        exact RingHom.congr_fun hφ_ιLT g
      intro d
      induction d using TensorProduct.inductionOn with
      | tmul b r =>
        rw [hΨ_R_tmul, map_mul]
        have hb : Φ_R (ψ_B_R b) = b ⊗ₜ[Ω] (1 : R) := by
          change Φ_R (ι_locR (Polynomial.C ((1 : L) ⊗ₜ[Ω] b))) = _
          rw [IsLocalization.lift_eq]
          change φ_TR (Polynomial.C ((1 : L) ⊗ₜ[Ω] b)) = _
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          change φ₀ ((1 : L) ⊗ₜ[Ω] b) = _
          rw [hφ₀_tmul, map_one]
        have hr : Φ_R (ψ_R_R r) = (1 : B₁) ⊗ₜ[Ω] r := RingHom.congr_fun hΦ_ψR r
        rw [hb, hr, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    let e_R : Localization M_0A ≃+* TensorProduct Ω B₁ R :=
      { Φ_R with
        invFun := Ψ_R
        left_inv := fun z => RingHom.congr_fun hΨΦ_R z
        right_inv := hΦΨ_R }
    have he_R_symm : ∀ x : Polynomial (TensorProduct Ω L B₁), e_R.symm (φ_TR x) = ι_locR x := by
      intro x
      change Ψ_R (φ_TR x) = ι_locR x
      have hx : Φ_R (ι_locR x) = φ_TR x := IsLocalization.lift_eq (S := Localization M_0A) hM0A_units x
      rw [← hx]
      exact RingHom.congr_fun hΨΦ_R (ι_locR x)

    let M_R : Submonoid (TensorProduct Ω B₁ R) := (nonZeroDivisors R).map incR_DR.toMonoidHom
    have hMR_units : ∀ y : M_R, IsUnit (toK₁ y) := by
      rintro ⟨_, r, hr, rfl⟩
      have hunit : IsUnit (algebraMap R K_gen r) := IsLocalization.map_units K_gen ⟨r, hr⟩
      have heq : toK₁ (incR_DR r) =
          (Algebra.TensorProduct.includeRight : K_gen →ₐ[Ω] TensorProduct Ω B₁ K_gen)
            (algebraMap R K_gen r) := by
        simp [toK₁, incR_DR]
      change IsUnit (toK₁ (incR_DR r))
      rw [heq]
      exact hunit.map _
    let Φ_K : Localization M_R →+* TensorProduct Ω B₁ K_gen :=
      IsLocalization.lift (S := Localization M_R) hMR_units
    let ι_locK : TensorProduct Ω B₁ R →+* Localization M_R :=
      algebraMap (TensorProduct Ω B₁ R) (Localization M_R)
    let ψ_B_K : B₁ →+* Localization M_R :=
      ι_locK.comp Algebra.TensorProduct.includeLeftRingHom
    have hR_units_locK : ∀ s : nonZeroDivisors R, IsUnit ((ι_locK.comp incR_DR) s) := by
      intro s
      exact IsLocalization.map_units (Localization M_R)
        ⟨incR_DR s.1, Submonoid.mem_map_of_mem incR_DR.toMonoidHom s.2⟩
    let ψ_K_K : K_gen →+* Localization M_R := IsLocalization.lift (S := K_gen) hR_units_locK
    have hψ_K_eq : ∀ r : R, ψ_K_K (algebraMap R K_gen r) = ι_locK ((1 : B₁) ⊗ₜ[Ω] r) :=
      IsLocalization.lift_eq (S := K_gen) hR_units_locK
    have hψ_BK_agree : ψ_B_K.comp (algebraMap Ω B₁) = ψ_K_K.comp (algebraMap Ω K_gen) := by
      ext c
      simp only [ψ_B_K, RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
      rw [IsScalarTower.algebraMap_apply Ω R K_gen c, hψ_K_eq]
      congr 1
      calc (algebraMap Ω B₁ c) ⊗ₜ[Ω] (1 : R)
          = (c • (1 : B₁)) ⊗ₜ[Ω] (1 : R) := by congr 1; symm; rw [Algebra.smul_def, mul_one]
        _ = (1 : B₁) ⊗ₜ[Ω] (c • (1 : R)) := TensorProduct.smul_tmul c (1 : B₁) (1 : R)
        _ = (1 : B₁) ⊗ₜ[Ω] algebraMap Ω R c := by congr 1; rw [Algebra.smul_def, mul_one]
    obtain ⟨Ψ_K, hΨ_K_tmul⟩ := hLiftTensorΩ ψ_B_K ψ_K_K hψ_BK_agree
    have hΨΦ_K : Ψ_K.comp Φ_K = RingHom.id (Localization M_R) := by
      apply IsLocalization.ringHom_ext M_R
      refine RingHom.ext fun d => ?_
      change Ψ_K (Φ_K (ι_locK d)) = ι_locK d
      rw [IsLocalization.lift_eq]
      induction d using TensorProduct.inductionOn with
      | tmul b r =>
        simp only [toK₁, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.map_tmul,
          AlgHom.id_apply, IsScalarTower.coe_toAlgHom', hΨ_K_tmul, hψ_K_eq, ψ_B_K,
          RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply, ← map_mul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
    have hΦΨ_K : ∀ w : TensorProduct Ω B₁ K_gen, Φ_K (Ψ_K w) = w := by
      have hΦ_ψK : Φ_K.comp ψ_K_K =
          (Algebra.TensorProduct.includeRight : K_gen →ₐ[Ω] TensorProduct Ω B₁ K_gen).toRingHom := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R)
        refine RingHom.ext fun r => ?_
        change Φ_K (ψ_K_K (algebraMap R K_gen r)) = (1 : B₁) ⊗ₜ[Ω] algebraMap R K_gen r
        rw [hψ_K_eq, IsLocalization.lift_eq]
        simp [toK₁]
      intro w
      induction w using TensorProduct.inductionOn with
      | tmul b k =>
        rw [hΨ_K_tmul, map_mul]
        have hb : Φ_K (ψ_B_K b) = b ⊗ₜ[Ω] (1 : K_gen) := by
          change Φ_K (ι_locK (b ⊗ₜ[Ω] (1 : R))) = _
          rw [IsLocalization.lift_eq]
          simp [toK₁]
        have hk : Φ_K (ψ_K_K k) = (1 : B₁) ⊗ₜ[Ω] k := RingHom.congr_fun hΦ_ψK k
        rw [hb, hk, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    let e_K : Localization M_R ≃+* TensorProduct Ω B₁ K_gen :=
      { Φ_K with
        invFun := Ψ_K
        left_inv := fun z => RingHom.congr_fun hΨΦ_K z
        right_inv := hΦΨ_K }
    have he_K_symm : ∀ d : TensorProduct Ω B₁ R, e_K.symm (toK₁ d) = ι_locK d := by
      intro d
      change Ψ_K (toK₁ d) = ι_locK d
      have hd : Φ_K (ι_locK d) = toK₁ d := IsLocalization.lift_eq (S := Localization M_R) hMR_units d
      rw [← hd]
      exact RingHom.congr_fun hΨΦ_K (ι_locK d)

    let H_T : Fin k_sl → Polynomial (TensorProduct Ω L B₁) :=
      fun i => Polynomial.C (∑ γ : Fin (N' + 1), (u_L i γ) ⊗ₜ[Ω] (r₁ γ))
    let F_const : TensorProduct Ω L B₁ :=
      ∑ γ : Fin (N' + 1), (1 : L) ⊗ₜ[Ω] (algebraMap Ω B₁ (c_F' γ) * r₁ γ)
    let V_lin : TensorProduct Ω L B₁ := ∑ γ : Fin (N' + 1), (v_L γ) ⊗ₜ[Ω] (r₁ γ)
    let P_T : Polynomial (TensorProduct Ω L B₁) := Polynomial.C F_const + Polynomial.X * Polynomial.C V_lin
    let S_eq : Finset (Polynomial (TensorProduct Ω L B₁)) := insert P_T (Finset.univ.image H_T)
    have hCardSeq : S_eq.card ≤ k_sl + 1 := by
      calc S_eq.card ≤ (Finset.univ.image H_T).card + 1 := Finset.card_insert_le _ _
        _ ≤ (Finset.univ : Finset (Fin k_sl)).card + 1 := Nat.add_le_add_right Finset.card_image_le 1
        _ = k_sl + 1 := by simp

    have hφ_HT : ∀ i : Fin k_sl, φ_TR (H_T i) = h_eq_R i := by
      intro i
      dsimp only [H_T, φ_TR, h_eq_R]
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, map_sum]
      refine Finset.sum_congr rfl fun γ _ => hφ₀_tmul (u_L i γ) (r₁ γ)

    have hφ_PT : φ_TR P_T = p_eq_R := by
      dsimp only [P_T, F_const, V_lin, φ_TR, p_eq_R]
      rw [map_add, map_mul, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, Polynomial.eval₂_X,
        Polynomial.eval₂_C, map_sum, map_sum, Finset.mul_sum]
      congr 1
      · refine Finset.sum_congr rfl fun γ _ => ?_
        change φ₀ ((1 : L) ⊗ₜ[Ω] (algebraMap Ω B₁ (c_F' γ) * r₁ γ)) = _
        rw [hφ₀_tmul, map_one]
      · refine Finset.sum_congr rfl fun γ _ => ?_
        change (1 : B₁) ⊗ₜ[Ω] ϖ * φ₀ ((v_L γ) ⊗ₜ[Ω] (r₁ γ)) = _
        rw [hφ₀_tmul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]

    let 𝔮_R : Ideal (TensorProduct Ω B₁ R) := (PrimeSpectrum.comap toL₁ 𝔮_L).asIdeal
    have : 𝔮_R.IsPrime := (PrimeSpectrum.comap toL₁ 𝔮_L).isPrime
    have hJR_le_𝔮R : J_R₁ ≤ 𝔮_R := Ideal.map_le_iff_le_comap.mp hJL_le_𝔮
    let q_tilde : Ideal (Polynomial (TensorProduct Ω L B₁)) := Ideal.comap φ_TR 𝔮_R
    have : q_tilde.IsPrime := Ideal.IsPrime.comap φ_TR
    have hSeq_le_q : Ideal.span (S_eq : Set (Polynomial (TensorProduct Ω L B₁))) ≤ q_tilde := by
      rw [Ideal.span_le]
      intro x hx
      simp only [S_eq, Finset.coe_insert, Finset.coe_image, Finset.coe_univ, Set.image_univ,
        Set.mem_insert_iff, Set.mem_range] at hx
      change φ_TR x ∈ 𝔮_R
      rcases hx with rfl | ⟨i, rfl⟩
      · rw [hφ_PT]
        exact hJR_le_𝔮R (Ideal.subset_span (Or.inl rfl))
      · rw [hφ_HT i]
        exact hJR_le_𝔮R (Ideal.subset_span (Or.inr ⟨i, rfl⟩))

    obtain ⟨P, hP_min, hP_le_q⟩ := Ideal.exists_minimalPrimes_le hSeq_le_q
    have hP_prime : P.IsPrime := hP_min.1.1
    have hDim_ATP_raw := hMinPrimeQuot L (Polynomial (TensorProduct Ω L B₁))
      (k_sl + 3) (k_sl + 1) hDim_AT S_eq hCardSeq P hP_min
    have hsub2 : (k_sl + 3) - (k_sl + 1) = 2 := by omega
    rw [hsub2] at hDim_ATP_raw

    have hPt_compl_notin_P : ∀ g : Polynomial L, g ∈ P_t.primeCompl → ι_LT g ∉ P := by
      intro g hg hmemP
      have hmem_qR : φ_TR (ι_LT g) ∈ 𝔮_R := hP_le_q hmemP
      have hφg : φ_TR (ι_LT g) = (1 : B₁) ⊗ₜ[Ω] algebraMap (Polynomial L) R g :=
        RingHom.congr_fun hφ_ιLT g
      have hmem_qL : toL₁ ((1 : B₁) ⊗ₜ[Ω] algebraMap (Polynomial L) R g) ∈ 𝔮_L.asIdeal := by
        rw [← hφg]
        exact hmem_qR
      have htoL_g : toL₁ ((1 : B₁) ⊗ₜ[Ω] algebraMap (Polynomial L) R g) =
          (1 : B₁) ⊗ₜ[Ω] (g.eval 0) := by
        simp [toL₁, hev_poly]
      rw [htoL_g] at hmem_qL
      have hg0_ne : g.eval 0 ≠ 0 := by
        intro h0
        have hc0 : g.coeff 0 = 0 := (Polynomial.coeff_zero_eq_eval_zero g).trans h0
        exact hg (hPt ▸ Ideal.mem_span_singleton.mpr (Polynomial.X_dvd_iff.mpr hc0))
      have hunit : IsUnit ((1 : B₁) ⊗ₜ[Ω] (g.eval 0)) := by
        refine IsUnit.of_mul_eq_one ((1 : B₁) ⊗ₜ[Ω] (g.eval 0)⁻¹) ?_
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_inv_cancel₀ hg0_ne]
        rfl
      exact 𝔮_L.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem 𝔮_L.asIdeal hmem_qL hunit)

    have hComap_LT_bot : Ideal.comap ι_LT P = ⊥ := by
      by_contra hne_bot
      obtain ⟨g, hg_mem, hg_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne_bot
      have hFactor : ∀ n : ℕ, ∀ f : Polynomial L, f.natDegree = n → f ≠ 0 →
          ∃ (e : ℕ) (u₀ : Polynomial L), u₀ ∈ P_t.primeCompl ∧ f = Polynomial.X ^ e * u₀ := by
        intro n
        induction n using Nat.strong_induction_on with
        | h n ih =>
          intro f hdeg hf_ne
          by_cases hmem : f ∈ P_t
          · obtain ⟨f₁, hf₁⟩ := Ideal.mem_span_singleton.mp (hPt ▸ hmem)
            have hf₁_ne : f₁ ≠ 0 := by
              rintro rfl; simp at hf₁; exact hf_ne hf₁
            have hdeg_lt : f₁.natDegree < n := by
              rw [← hdeg, hf₁, Polynomial.natDegree_mul Polynomial.X_ne_zero hf₁_ne,
                Polynomial.natDegree_X]
              omega
            obtain ⟨e₁, u₀, hu₀, hf₁_eq⟩ := ih f₁.natDegree hdeg_lt f₁ rfl hf₁_ne
            exact ⟨e₁ + 1, u₀, hu₀, by rw [hf₁, hf₁_eq, pow_succ', mul_assoc]⟩
          · exact ⟨0, f, hmem, by simp⟩
      obtain ⟨e, u₀, hu₀, hg_eq⟩ := hFactor g.natDegree g rfl hg_ne
      have hprod_P : ι_LT (Polynomial.X ^ e) * ι_LT u₀ ∈ P := by
        rw [← map_mul, ← hg_eq]
        exact hg_mem
      have hpow_P : (Polynomial.X : Polynomial (TensorProduct Ω L B₁)) ^ e ∈ P := by
        have hX_map : ι_LT (Polynomial.X ^ e) =
            (Polynomial.X : Polynomial (TensorProduct Ω L B₁)) ^ e := by
          rw [map_pow]
          congr 1
          change (Polynomial.mapRingHom _) Polynomial.X = Polynomial.X
          rw [Polynomial.coe_mapRingHom, Polynomial.map_X]
        rw [← hX_map]
        rcases hP_prime.mem_or_mem hprod_P with h1 | h2
        · exact h1
        · exact absurd h2 (hPt_compl_notin_P u₀ hu₀)
      have hX_in_P : (Polynomial.X : Polynomial (TensorProduct Ω L B₁)) ∈ P :=
        hP_prime.mem_of_pow_mem e hpow_P

      let π_LP : TensorProduct Ω B₁ L →+* (Polynomial (TensorProduct Ω L B₁) ⧸ P) :=
        (Ideal.Quotient.mk P).comp (Polynomial.C.comp e_comm_BL.toRingHom)
      have hSurj_πLP : Function.Surjective π_LP := by
        intro z
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
        refine ⟨e_comm_BL.symm (F.coeff 0), ?_⟩
        change Ideal.Quotient.mk P (Polynomial.C (e_comm_BL (e_comm_BL.symm (F.coeff 0)))) =
          Ideal.Quotient.mk P F
        rw [AlgEquiv.apply_symm_apply]
        have hc0 : (F - Polynomial.C (F.coeff 0)).coeff 0 = 0 := by simp
        obtain ⟨F₁, hF₁⟩ := Polynomial.X_dvd_iff.mpr hc0
        have hdiff_P : Polynomial.C (F.coeff 0) - F ∈ P := by
          have hneg : Polynomial.C (F.coeff 0) - F = -(F - Polynomial.C (F.coeff 0)) := by ring
          rw [hneg, hF₁]
          exact P.neg_mem (P.mul_mem_right F₁ hX_in_P)
        rwa [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      have hJL_ker_πLP : ∀ w ∈ J_L₁, π_LP w = 0 := by
        have hle : J_L₁ ≤ RingHom.ker π_LP := by
          dsimp [J_L₁, J_R₁]
          rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
          intro z hz
          rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
          change π_LP (toL₁ z) = 0
          rcases hz with rfl | ⟨i, rfl⟩
          · rw [htoL_p]
            have hFc : e_comm_BL (f₁ ⊗ₜ[Ω] (1 : L)) = F_const := by
              have hf_tmul : f₁ ⊗ₜ[Ω] (1 : L) =
                  ∑ γ : Fin (N' + 1), (algebraMap Ω B₁ (c_F' γ) * r₁ γ) ⊗ₜ[Ω] (1 : L) :=
                map_sum (Algebra.TensorProduct.includeLeft : B₁ →ₐ[Ω] TensorProduct Ω B₁ L) _ _
              rw [hf_tmul, map_sum]
              rfl
            change Ideal.Quotient.mk P (Polynomial.C (e_comm_BL (f₁ ⊗ₜ[Ω] (1 : L)))) = 0
            rw [hFc, Ideal.Quotient.eq_zero_iff_mem]
            have hPT_in_P : P_T ∈ P :=
              hP_min.1.2 (Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_insert_self _ _)))
            have hFC_eq : Polynomial.C F_const = P_T - Polynomial.X * Polynomial.C V_lin := by
              dsimp [P_T]; ring
            rw [hFC_eq]
            exact P.sub_mem hPT_in_P (P.mul_mem_right _ hX_in_P)
          · rw [htoL_h i]
            have hHi : Polynomial.C (e_comm_BL (∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (u_L i γ))) =
                H_T i := by
              rw [map_sum]; rfl
            change Ideal.Quotient.mk P
              (Polynomial.C (e_comm_BL (∑ γ : Fin (N' + 1), (r₁ γ) ⊗ₜ[Ω] (u_L i γ)))) = 0
            rw [hHi, Ideal.Quotient.eq_zero_iff_mem]
            exact hP_min.1.2 (Ideal.subset_span (Finset.mem_coe.mpr
              (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ i)))))
        exact fun w hw => hle hw
      let π_bar : ((TensorProduct Ω B₁ L) ⧸ J_L₁) →+* (Polynomial (TensorProduct Ω L B₁) ⧸ P) :=
        Ideal.Quotient.lift J_L₁ π_LP hJL_ker_πLP
      have hSurj_bar : Function.Surjective π_bar := by
        intro z
        obtain ⟨w, rfl⟩ := hSurj_πLP z
        exact ⟨Ideal.Quotient.mk J_L₁ w, rfl⟩
      have hle1 : ringKrullDim (Polynomial (TensorProduct Ω L B₁) ⧸ P) ≤
          ringKrullDim ((TensorProduct Ω B₁ L) ⧸ J_L₁) :=
        ringKrullDim_le_of_surjective π_bar hSurj_bar
      have h2le1 : ((2 : ℕ) : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) :=
        hDim_ATP_raw.trans (hle1.trans hDimJL)
      norm_num at h2le1

    have hDisj_M0A :
        Disjoint (M_0A : Set (Polynomial (TensorProduct Ω L B₁)))
          (P : Set (Polynomial (TensorProduct Ω L B₁))) := by
      rw [Set.disjoint_left]
      rintro _ ⟨g, hg, rfl⟩ hxP
      exact hPt_compl_notin_P g hg hxP
    let P_loc : Ideal (Localization M_0A) := Ideal.map ι_locR P
    have : P_loc.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M_0A (Localization M_0A) P hP_prime hDisj_M0A
    have hP_loc_under : Ideal.comap ι_locR P_loc = P := by
      rw [← Ideal.under_def]
      exact IsLocalization.under_map_of_isPrime_disjoint M_0A (Localization M_0A) hP_prime hDisj_M0A
    let P_R : Ideal (TensorProduct Ω B₁ R) := Ideal.comap e_R.symm.toRingHom P_loc
    have hPR_prime : P_R.IsPrime := Ideal.IsPrime.comap e_R.symm.toRingHom
    have hPR_comap : Ideal.comap φ_TR P_R = P := by
      ext x
      change e_R.symm (φ_TR x) ∈ P_loc ↔ x ∈ P
      rw [he_R_symm, ← Ideal.mem_comap, hP_loc_under]
    have hJR_le_PR : J_R₁ ≤ P_R := by
      dsimp [J_R₁]
      rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | ⟨i, rfl⟩
      · rw [← hφ_PT]
        change P_T ∈ Ideal.comap φ_TR P_R
        rw [hPR_comap]
        exact hP_min.1.2 (Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_insert_self _ _)))
      · rw [← hφ_HT i]
        change H_T i ∈ Ideal.comap φ_TR P_R
        rw [hPR_comap]
        exact hP_min.1.2 (Ideal.subset_span (Finset.mem_coe.mpr
          (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ i)))))
    have hPR_le_𝔮R : P_R ≤ 𝔮_R := by
      have hPloc_le : P_loc ≤ Ideal.comap e_R.toRingHom 𝔮_R := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hxP
        change Φ_R (ι_locR x) ∈ 𝔮_R
        rw [IsLocalization.lift_eq]
        exact hP_le_q hxP
      intro d hd
      have h1 : e_R.toRingHom (e_R.symm d) ∈ 𝔮_R := hPloc_le hd
      change e_R (e_R.symm d) ∈ 𝔮_R at h1
      rwa [RingEquiv.apply_symm_apply] at h1

    have hDisj_MR : Disjoint (M_R : Set (TensorProduct Ω B₁ R)) (P_R : Set (TensorProduct Ω B₁ R)) := by
      rw [Set.disjoint_left]
      rintro _ ⟨r, hr_nzd, rfl⟩ hr_PR
      have hr_ne : r ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hr_nzd
      obtain ⟨⟨f, g⟩, hfg⟩ := IsLocalization.surj P_t.primeCompl r
      have hf_ne : f ≠ 0 := by
        rintro rfl
        rw [map_zero] at hfg
        exact hr_ne ((IsLocalization.map_units R g).mul_left_eq_zero.mp hfg)
      have hφf_mem : φ_TR (ι_LT f) ∈ P_R := by
        have h1 : φ_TR (ι_LT f) = incR_DR (algebraMap (Polynomial L) R f) :=
          RingHom.congr_fun hφ_ιLT f
        rw [h1, ← hfg, map_mul]
        exact P_R.mul_mem_right _ hr_PR
      have hf_in_bot : f ∈ (⊥ : Ideal (Polynomial L)) := by
        rw [← hComap_LT_bot]
        change ι_LT f ∈ P
        rw [← hPR_comap]
        exact hφf_mem
      exact hf_ne (Ideal.mem_bot.mp hf_in_bot)

    let PR_loc : Ideal (Localization M_R) := Ideal.map ι_locK P_R
    have : PR_loc.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M_R (Localization M_R) P_R hPR_prime hDisj_MR
    have hPR_loc_under : Ideal.comap ι_locK PR_loc = P_R := by
      rw [← Ideal.under_def]
      exact IsLocalization.under_map_of_isPrime_disjoint M_R (Localization M_R) hPR_prime hDisj_MR
    let P_K : Ideal (TensorProduct Ω B₁ K_gen) := Ideal.comap e_K.symm.toRingHom PR_loc
    have hPK_comap : Ideal.comap toK₁ P_K = P_R := by
      ext d
      change e_K.symm (toK₁ d) ∈ PR_loc ↔ d ∈ P_R
      rw [he_K_symm, ← Ideal.mem_comap, hPR_loc_under]
    have hJK_le_PK : J_K₁ ≤ P_K := by
      dsimp [J_K₁]
      rw [Ideal.map_le_iff_le_comap, hPK_comap]
      exact hJR_le_PR
    calc Ideal.comap toK₁ J_K₁ ≤ Ideal.comap toK₁ P_K := Ideal.comap_mono hJK_le_PK
      _ = P_R := hPK_comap
      _ ≤ 𝔮_R := hPR_le_𝔮R

  
  
  
  have hMain : ∀ (L : Type u) [Field L] [Infinite L] [Algebra Ω L]
      [Algebra P_coeff L] [IsScalarTower Ω P_coeff L] [IsFractionRing P_coeff L]
      (P_t : Ideal (Polynomial L)) [P_t.IsPrime]
      (hPt : P_t = Ideal.span ({Polynomial.X} : Set (Polynomial L)))
      (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [IsLocalRing R]
      [Algebra Ω R] [Algebra L R] [IsScalarTower Ω L R]
      [Algebra (Polynomial L) R] [IsScalarTower L (Polynomial L) R]
      [IsLocalization.AtPrime R P_t]
      (ϖ : R) (hϖ : ϖ = algebraMap (Polynomial L) R Polynomial.X),
      ∃ (ev_R : R →ₐ[L] L)
        (u_L : Fin k_sl → Fin (N' + 1) → L)
        (v_L : Fin (N' + 1) → L),
        let K_gen : Type u := FractionRing R
        let h_eq_R : ∀ (α : Fin (N' + 1 + 1)), Fin k_sl → TensorProduct Ω (B α) R :=
          fun α i => ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (algebraMap L R (u_L i γ))
        let p_eq_R : ∀ (α : Fin (N' + 1 + 1)), TensorProduct Ω (B α) R :=
          fun α =>
            (∑ γ : Fin (N' + 1),
              (algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ) ⊗ₜ[Ω] (1 : R)) +
            (∑ γ : Fin (N' + 1),
              (r_coord α γ.succ) ⊗ₜ[Ω] (ϖ * algebraMap L R (v_L γ)))
        let J_R : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) R) :=
          fun α => Ideal.span ({p_eq_R α} ∪ Set.range (h_eq_R α))
        let toK : ∀ (α : Fin (N' + 1 + 1)),
            TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) K_gen :=
          fun α =>
            (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
              (IsScalarTower.toAlgHom Ω R K_gen)).toRingHom
        let toL : ∀ (α : Fin (N' + 1 + 1)),
            TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) L :=
          fun α =>
            (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
              (ev_R.restrictScalars Ω)).toRingHom
        let J_K : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) K_gen) :=
          fun α => Ideal.map (toK α) (J_R α)
        let J_L : ∀ (β : Fin (N' + 1)), Ideal (TensorProduct Ω (B β.succ) L) :=
          fun β => Ideal.map (toL β.succ) (J_R β.succ)
        let m0_K : Ideal (TensorProduct Ω (B 0) K_gen) :=
          RingHom.ker
            (Algebra.TensorProduct.lift ((Algebra.ofId Ω K_gen).comp ev₀) (AlgHom.id Ω K_gen)
              (fun _ _ => Commute.all _ _)).toRingHom
        (ϖ ≠ 0 ∧
          IsLocalRing.maximalIdeal R = Ideal.span {ϖ} ∧
          Function.Bijective ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap L R)) ∧
          RingHom.ker ev_R.toRingHom = Ideal.span {ϖ} ∧
          ∀ i : Fin k_sl, u_L i ≠ 0) ∧
        (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
          IsDomain ((TensorProduct Ω (B β.succ) K_gen) ⧸ J_K β.succ) ∧
          ringKrullDim ((TensorProduct Ω (B β.succ) K_gen) ⧸ J_K β.succ) ≤ (1 : WithBot ℕ∞) ∧
          ∀ b : B β.succ, b ≠ 0 → b ⊗ₜ[Ω] (1 : K_gen) ∉ J_K β.succ) ∧
        (∃ (Q₀ : PrimeSpectrum (TensorProduct Ω (B 0) K_gen)) (β₁ : Fin (N' + 1)),
          J_K 0 ≤ Q₀.asIdeal ∧
          Q₀.asIdeal ≤ m0_K ∧
          r_coord 0 β₁.succ ⊗ₜ[Ω] (1 : K_gen) ∉ Q₀.asIdeal ∧
          (1 : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω (B 0) K_gen) ⧸ Q₀.asIdeal)) ∧
        (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
          ringKrullDim ((TensorProduct Ω (B β.succ) L) ⧸ J_L β) ≤ (1 : WithBot ℕ∞) ∧
          ∀ 𝔮_L : PrimeSpectrum (TensorProduct Ω (B β.succ) L),
            J_L β ≤ 𝔮_L.asIdeal →
            Ideal.comap (toK β.succ) (J_K β.succ) ≤
              (PrimeSpectrum.comap (toL β.succ) 𝔮_L).asIdeal) := by
    intro L _ _ _ _ _ _ P_t _ hPt R _ _ _ _ _ _ _ _ _ _ ϖ hϖ
    
    have hPt_nzd : P_t.primeCompl ≤ nonZeroDivisors (Polynomial L) := by
      intro g hg
      exact mem_nonZeroDivisors_of_ne_zero (fun h0 => hg (h0 ▸ P_t.zero_mem))
    have hInjPolyR : Function.Injective (algebraMap (Polynomial L) R) :=
      IsLocalization.injective R hPt_nzd
    have hϖ_ne : ϖ ≠ 0 := by
      rw [hϖ]
      exact fun h0 => Polynomial.X_ne_zero (hInjPolyR (h0.trans (map_zero _).symm))
    have hMax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P_t R, hPt, Ideal.map_span,
        Set.image_singleton, ← hϖ]
    have hev_units : ∀ g : P_t.primeCompl, IsUnit ((Polynomial.evalRingHom (0 : L)) g.1) := by
      rintro ⟨g_val, hg_not_mem⟩
      have hg_eval : g_val.eval 0 ≠ 0 := by
        intro h0
        have hc0 : g_val.coeff 0 = 0 := (Polynomial.coeff_zero_eq_eval_zero g_val).trans h0
        have hdvd : Polynomial.X ∣ g_val := Polynomial.X_dvd_iff.mpr hc0
        have hmem_Pt : g_val ∈ P_t := by
          rw [hPt]
          exact Ideal.mem_span_singleton.mpr hdvd
        exact hg_not_mem hmem_Pt
      exact isUnit_iff_ne_zero.mpr hg_eval
    let ev_ring : R →+* L := IsLocalization.lift (S := R) hev_units
    have hev_poly : ∀ f : Polynomial L, ev_ring (algebraMap (Polynomial L) R f) = f.eval 0 :=
      IsLocalization.lift_eq (S := R) hev_units
    let ev_R : R →ₐ[L] L :=
      { ev_ring with
        commutes' := fun c => by
          change ev_ring (algebraMap L R c) = c
          rw [IsScalarTower.algebraMap_apply L (Polynomial L) R c, Polynomial.algebraMap_eq,
            hev_poly, Polynomial.eval_C] }
    have hev_ϖ : ev_R ϖ = 0 := by
      change ev_ring ϖ = 0
      rw [hϖ, hev_poly, Polynomial.eval_X]
    have hev_ker : RingHom.ker ev_R.toRingHom = Ideal.span {ϖ} := by
      apply le_antisymm
      · intro r hr
        rw [RingHom.mem_ker] at hr
        obtain ⟨⟨f, g⟩, hfg⟩ := IsLocalization.surj P_t.primeCompl r
        have hf0 : f.eval 0 = 0 := by
          have h1 : ev_ring (r * algebraMap (Polynomial L) R g.1) =
              ev_ring (algebraMap (Polynomial L) R f) := congrArg ev_ring hfg
          rw [map_mul, hev_poly, hev_poly] at h1
          have hr' : ev_ring r = 0 := hr
          rw [hr', zero_mul] at h1
          exact h1.symm
        have hc0 : f.coeff 0 = 0 := (Polynomial.coeff_zero_eq_eval_zero f).trans hf0
        obtain ⟨f₁, hf₁⟩ := Polynomial.X_dvd_iff.mpr hc0
        obtain ⟨u_g, hu_g⟩ := IsLocalization.map_units R g
        have hmul : r = ϖ * (algebraMap (Polynomial L) R f₁ * ↑u_g⁻¹) := by
          have h2 : r * ↑u_g = ϖ * algebraMap (Polynomial L) R f₁ := by
            rw [hu_g, hfg, hf₁, map_mul, ← hϖ]
          calc r = (r * ↑u_g) * ↑u_g⁻¹ := by rw [mul_assoc, Units.mul_inv, mul_one]
            _ = (ϖ * algebraMap (Polynomial L) R f₁) * ↑u_g⁻¹ := by rw [h2]
            _ = ϖ * (algebraMap (Polynomial L) R f₁ * ↑u_g⁻¹) := mul_assoc _ _ _
        exact Ideal.mem_span_singleton.mpr ⟨_, hmul⟩
      · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        exact hev_ϖ
    let q₀ : R →+* R ⧸ Ideal.span {ϖ} := Ideal.Quotient.mk (Ideal.span {ϖ})
    have hRes : Function.Bijective (q₀.comp (algebraMap L R)) := by
      let ev_bar : (R ⧸ Ideal.span {ϖ}) →+* L :=
        Ideal.Quotient.lift (Ideal.span {ϖ}) ev_R.toRingHom (fun r hr => by
          rw [← hev_ker] at hr; exact hr)
      refine Function.bijective_iff_has_inverse.mpr ⟨ev_bar, ?_, ?_⟩
      · intro c
        change ev_bar (q₀ (algebraMap L R c)) = c
        exact ev_R.commutes c
      · intro z
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
        change q₀ (algebraMap L R (ev_R r)) = q₀ r
        have hdiff : algebraMap L R (ev_R r) - r ∈ Ideal.span {ϖ} := by
          rw [← hev_ker, RingHom.mem_ker]
          change ev_R (algebraMap L R (ev_R r) - r) = 0
          rw [map_sub, ev_R.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
        rwa [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]

    let u_L : Fin k_sl → Fin (N' + 1) → L :=
      fun i γ => algebraMap P_coeff L (MvPolynomial.X (i.castSucc, γ))
    let v_L : Fin (N' + 1) → L :=
      fun γ => algebraMap P_coeff L (MvPolynomial.X (Fin.last k_sl, γ))
    have hu_L_ne : ∀ i : Fin k_sl, u_L i ≠ 0 := by
      intro i h0
      have h00 : u_L i 0 = 0 := congrFun h0 0
      have hX0 : (MvPolynomial.X (i.castSucc, (0 : Fin (N' + 1))) : P_coeff) = 0 :=
        (IsFractionRing.injective P_coeff L) (h00.trans (map_zero _).symm)
      have hev := congrArg (MvPolynomial.eval (fun _ : σ_tot => (1 : Ω))) hX0
      simp at hev

    let A_poly : Type u := Polynomial P_coeff
    let K_gen : Type u := FractionRing R
    let ι_A : A_poly →+* K_gen :=
      (algebraMap R K_gen).comp ((algebraMap (Polynomial L) R).comp
        (Polynomial.mapRingHom (algebraMap P_coeff L)))
    have hι_A_C : ∀ p : P_coeff,
        ι_A (Polynomial.C p) = algebraMap R K_gen (algebraMap L R (algebraMap P_coeff L p)) := by
      intro p
      change algebraMap R K_gen (algebraMap (Polynomial L) R
        ((Polynomial.mapRingHom (algebraMap P_coeff L)) (Polynomial.C p))) = _
      rw [Polynomial.coe_mapRingHom, Polynomial.map_C, ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply L (Polynomial L) R]
    have hι_A_X : ι_A Polynomial.X = algebraMap R K_gen ϖ := by
      change algebraMap R K_gen (algebraMap (Polynomial L) R
        ((Polynomial.mapRingHom (algebraMap P_coeff L)) Polynomial.X)) = _
      rw [Polynomial.coe_mapRingHom, Polynomial.map_X, hϖ]
    have hInj_ιA : Function.Injective ι_A :=
      (IsFractionRing.injective R K_gen).comp
        (hInjPolyR.comp (Polynomial.map_injective _ (IsFractionRing.injective P_coeff L)))
    have hιA_units : ∀ y : nonZeroDivisors A_poly, IsUnit (ι_A y.1) := by
      intro y
      have hy : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      exact isUnit_iff_ne_zero.mpr fun h0 => hy (hInj_ιA (h0.trans (map_zero _).symm))
    let ξ : FractionRing A_poly →+* K_gen :=
      IsLocalization.lift (S := FractionRing A_poly) hιA_units
    have hξ_alg : ∀ g : A_poly, ξ (algebraMap A_poly (FractionRing A_poly) g) = ι_A g :=
      IsLocalization.lift_eq (S := FractionRing A_poly) hιA_units
    have hSurj_ξ : Function.Surjective ξ := by
      let S : Subfield K_gen := ξ.fieldRange
      have hι_mem : ∀ g : A_poly, ι_A g ∈ S := fun g =>
        ⟨algebraMap A_poly (FractionRing A_poly) g, hξ_alg g⟩
      let ψ_PL : P_coeff →+* K_gen :=
        (algebraMap R K_gen).comp ((algebraMap L R).comp (algebraMap P_coeff L))
      have hP_mem : ∀ p : P_coeff, ψ_PL p ∈ S := by
        intro p
        change algebraMap R K_gen (algebraMap L R (algebraMap P_coeff L p)) ∈ S
        rw [← hι_A_C p]
        exact hι_mem (Polynomial.C p)
      have hInj_ψPL : Function.Injective ψ_PL :=
        (IsFractionRing.injective R K_gen).comp
          ((algebraMap L R).injective.comp (IsFractionRing.injective P_coeff L))
      have hL_mem : ∀ ℓ : L, algebraMap R K_gen (algebraMap L R ℓ) ∈ S := by
        intro ℓ
        obtain ⟨⟨p₁, p₂⟩, hp⟩ := IsLocalization.surj (nonZeroDivisors P_coeff) ℓ
        have hp₂_ne : ψ_PL p₂.1 ≠ 0 := by
          have h0 : p₂.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp p₂.2
          exact fun hz => h0 (hInj_ψPL (hz.trans (map_zero _).symm))
        have hmul : algebraMap R K_gen (algebraMap L R ℓ) * ψ_PL p₂.1 = ψ_PL p₁ := by
          change (algebraMap R K_gen).comp (algebraMap L R) ℓ *
              (algebraMap R K_gen).comp (algebraMap L R) (algebraMap P_coeff L p₂.1) =
            (algebraMap R K_gen).comp (algebraMap L R) (algebraMap P_coeff L p₁)
          rw [← map_mul, hp]
        have hmem := S.mul_mem (hP_mem p₁) (S.inv_mem (hP_mem p₂.1))
        rwa [← hmul, mul_inv_cancel_right₀ hp₂_ne] at hmem
      have hX_mem : algebraMap R K_gen ϖ ∈ S := by
        rw [← hι_A_X]
        exact hι_mem Polynomial.X
      have hPoly_mem : ∀ f : Polynomial L,
          algebraMap R K_gen (algebraMap (Polynomial L) R f) ∈ S := by
        intro f
        induction f using Polynomial.induction_on' with
        | add f₁ f₂ hf₁ hf₂ =>
          rw [map_add, map_add]
          exact S.add_mem hf₁ hf₂
        | monomial n c =>
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow]
          have hC : algebraMap (Polynomial L) R (Polynomial.C c) = algebraMap L R c := by
            rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply L (Polynomial L) R]
          rw [hC, ← hϖ]
          exact S.mul_mem (hL_mem c) (S.pow_mem hX_mem n)
      have hR_mem : ∀ r : R, algebraMap R K_gen r ∈ S := by
        intro r
        obtain ⟨⟨f, g⟩, hfg⟩ := IsLocalization.surj P_t.primeCompl r
        have hg_ne : algebraMap R K_gen (algebraMap (Polynomial L) R g.1) ≠ 0 := by
          have hg0 : g.1 ≠ 0 := fun h0 => g.2 (h0 ▸ P_t.zero_mem)
          intro hz
          have hz1 : algebraMap (Polynomial L) R g.1 = 0 :=
            (IsFractionRing.injective R K_gen) (hz.trans (map_zero _).symm)
          exact hg0 (hInjPolyR (hz1.trans (map_zero _).symm))
        have hmul : algebraMap R K_gen r * algebraMap R K_gen (algebraMap (Polynomial L) R g.1) =
            algebraMap R K_gen (algebraMap (Polynomial L) R f) := by
          rw [← map_mul, hfg]
        have hmem := S.mul_mem (hPoly_mem f) (S.inv_mem (hPoly_mem g.1))
        rwa [← hmul, mul_inv_cancel_right₀ hg_ne] at hmem
      intro z
      obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj (nonZeroDivisors R) z
      have hs_ne : algebraMap R K_gen s.1 ≠ 0 := by
        have hs0 : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        exact fun hz => hs0 ((IsFractionRing.injective R K_gen) (hz.trans (map_zero _).symm))
      have hmem := S.mul_mem (hR_mem r) (S.inv_mem (hR_mem s.1))
      rwa [← hrs, mul_inv_cancel_right₀ hs_ne] at hmem
    let Ξ_ring : FractionRing A_poly ≃+* K_gen :=
      RingEquiv.ofBijective ξ ⟨ξ.injective, hSurj_ξ⟩
    let Ξ_K : FractionRing A_poly ≃ₐ[Ω] K_gen :=
      { Ξ_ring with
        commutes' := fun c => by
          change ξ (algebraMap Ω (FractionRing A_poly) c) = algebraMap Ω K_gen c
          rw [IsScalarTower.algebraMap_apply Ω A_poly (FractionRing A_poly) c,
            IsScalarTower.algebraMap_apply Ω P_coeff A_poly c, hξ_alg,
            Polynomial.algebraMap_eq, hι_A_C,
            ← IsScalarTower.algebraMap_apply Ω P_coeff L c,
            ← IsScalarTower.algebraMap_apply Ω L R c,
            ← IsScalarTower.algebraMap_apply Ω R K_gen c] }
    have hΞ_Xs : ∀ s : σ_tot,
        Ξ_K (algebraMap A_poly (FractionRing A_poly) (Polynomial.C (MvPolynomial.X s))) =
          algebraMap R K_gen (algebraMap L R (algebraMap P_coeff L (MvPolynomial.X s))) := by
      intro s
      change ξ (algebraMap A_poly (FractionRing A_poly) (Polynomial.C (MvPolynomial.X s))) = _
      rw [hξ_alg, hι_A_C]
    have hΞ_T :
        Ξ_K (algebraMap A_poly (FractionRing A_poly) Polynomial.X) = algebraMap R K_gen ϖ := by
      change ξ (algebraMap A_poly (FractionRing A_poly) Polynomial.X) = _
      rw [hξ_alg, hι_A_X]

    refine ⟨ev_R, u_L, v_L, ?_⟩
    dsimp only
    let h_eq_R : ∀ (α : Fin (N' + 1 + 1)), Fin k_sl → TensorProduct Ω (B α) R :=
      fun α i => ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (algebraMap L R (u_L i γ))
    let p_eq_R : ∀ (α : Fin (N' + 1 + 1)), TensorProduct Ω (B α) R :=
      fun α =>
        (∑ γ : Fin (N' + 1),
          (algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ) ⊗ₜ[Ω] (1 : R)) +
        (∑ γ : Fin (N' + 1),
          (r_coord α γ.succ) ⊗ₜ[Ω] (ϖ * algebraMap L R (v_L γ)))
    let J_R : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) R) :=
      fun α => Ideal.span ({p_eq_R α} ∪ Set.range (h_eq_R α))
    let toK : ∀ (α : Fin (N' + 1 + 1)),
        TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) K_gen :=
      fun α =>
        (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
          (IsScalarTower.toAlgHom Ω R K_gen)).toRingHom
    let toL : ∀ (α : Fin (N' + 1 + 1)),
        TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) L :=
      fun α =>
        (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
          (ev_R.restrictScalars Ω)).toRingHom
    let J_K : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) K_gen) :=
      fun α => Ideal.map (toK α) (J_R α)
    let J_L : ∀ (β : Fin (N' + 1)), Ideal (TensorProduct Ω (B β.succ) L) :=
      fun β => Ideal.map (toL β.succ) (J_R β.succ)
    let m0_K : Ideal (TensorProduct Ω (B 0) K_gen) :=
      RingHom.ker
        (Algebra.TensorProduct.lift ((Algebra.ofId Ω K_gen).comp ev₀) (AlgHom.id Ω K_gen)
          (fun _ _ => Commute.all _ _)).toRingHom

    refine ⟨⟨hϖ_ne, hMax, hRes, hev_ker, hu_L_ne⟩, ?_, ?_, ?_⟩
    · 
      
      
      intro β hNt
      obtain ⟨hDomB₁, hDimB₁, _⟩ := hDom β hNt
      have : IsDomain (B β.succ) := hDomB₁
      exact hConj2 L R ϖ hϖ_ne u_L v_L Ξ_K
        (fun i γ => hΞ_Xs (i.castSucc, γ)) (fun γ => hΞ_Xs (Fin.last k_sl, γ)) hΞ_T
        (B β.succ) hDimB₁ (fun γ => r_coord β.succ γ.succ) β (hr_diag β.succ) c_F (hSpec β hNt)

    · 
      
      
      classical
      let : Field K_gen := inferInstance
      let Φ₀ : TensorProduct Ω (B 0) K_gen →ₐ[Ω] K_gen :=
        Algebra.TensorProduct.lift ((Algebra.ofId Ω K_gen).comp ev₀) (AlgHom.id Ω K_gen)
          (fun _ _ => Commute.all _ _)
      have hSurj_Φ₀ : Function.Surjective Φ₀.toRingHom := fun k =>
        ⟨(1 : B 0) ⊗ₜ[Ω] k, by
          change Φ₀ ((1 : B 0) ⊗ₜ[Ω] k) = k
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl⟩
      have hm0_max : m0_K.IsMaximal :=
        RingHom.ker_isMaximal_of_surjective Φ₀.toRingHom hSurj_Φ₀
      have hm0_prime : m0_K.IsPrime := hm0_max.isPrime
      let : CommRing ((TensorProduct Ω (B 0) K_gen) ⧸ m0_K) := inferInstance
      have hDim_m0 : ringKrullDim ((TensorProduct Ω (B 0) K_gen) ⧸ m0_K) = 0 :=
        ringKrullDim_eq_zero_of_isField
          ((Ideal.Quotient.maximal_ideal_iff_isField_quotient m0_K).mp hm0_max)

      let S₀ : Finset (TensorProduct Ω (B 0) K_gen) :=
        insert (toK 0 (p_eq_R 0)) (Finset.univ.image (fun i : Fin k_sl => toK 0 (h_eq_R 0 i)))
      have hCardS₀ : S₀.card ≤ k_sl + 1 := by
        calc S₀.card ≤ (Finset.univ.image (fun i : Fin k_sl => toK 0 (h_eq_R 0 i))).card + 1 :=
              Finset.card_insert_le _ _
          _ ≤ (Finset.univ : Finset (Fin k_sl)).card + 1 :=
              Nat.add_le_add_right Finset.card_image_le 1
          _ = k_sl + 1 := by simp
      have hev₀_r : ∀ γ : Fin (N' + 1), ev₀ (r_coord 0 γ.succ) = 0 := by
        intro γ
        change r_coord 0 γ.succ ∈ RingHom.ker ev₀.toRingHom
        rw [hev₀_ker]
        exact Ideal.subset_span ⟨γ, rfl⟩
      have hΦ₀_toK : ∀ (b : B 0) (r : R),
          Φ₀ (toK 0 (b ⊗ₜ[Ω] r)) = algebraMap Ω K_gen (ev₀ b) * algebraMap R K_gen r := by
        intro b r
        change Φ₀ ((Algebra.TensorProduct.map (AlgHom.id Ω (B 0))
          (IsScalarTower.toAlgHom Ω R K_gen)) (b ⊗ₜ[Ω] r)) = _
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, IsScalarTower.coe_toAlgHom',
          Algebra.TensorProduct.lift_tmul, AlgHom.comp_apply, Algebra.ofId_apply, AlgHom.id_apply]
      have hS₀_sub : (↑S₀ : Set (TensorProduct Ω (B 0) K_gen)) ⊆
          (m0_K : Set (TensorProduct Ω (B 0) K_gen)) := by
        intro z hz
        simp only [S₀, Finset.coe_insert, Finset.coe_image, Finset.coe_univ, Set.image_univ,
          Set.mem_insert_iff, Set.mem_range] at hz
        change Φ₀ z = 0
        rcases hz with rfl | ⟨i, rfl⟩
        · dsimp only [p_eq_R]
          rw [map_add, map_sum, map_sum, map_add, map_sum, map_sum]
          have hs1 : ∑ γ : Fin (N' + 1),
              Φ₀ (toK 0 ((algebraMap Ω (B 0) (c_F γ) * r_coord 0 γ.succ) ⊗ₜ[Ω] (1 : R))) = 0 :=
            Finset.sum_eq_zero fun γ _ => by
              rw [hΦ₀_toK, map_mul, hev₀_r, mul_zero, map_zero, zero_mul]
          have hs2 : ∑ γ : Fin (N' + 1),
              Φ₀ (toK 0 ((r_coord 0 γ.succ) ⊗ₜ[Ω] (ϖ * algebraMap L R (v_L γ)))) = 0 :=
            Finset.sum_eq_zero fun γ _ => by
              rw [hΦ₀_toK, hev₀_r, map_zero, zero_mul]
          rw [hs1, hs2, add_zero]
        · dsimp only [h_eq_R]
          rw [map_sum, map_sum]
          exact Finset.sum_eq_zero fun γ _ => by
            rw [hΦ₀_toK, hev₀_r, map_zero, zero_mul]

      have : IsDomain (B 0) := hDom₀.1
      have : IsDomain (TensorProduct Ω (B 0) K_gen) := hTensDom K_gen (B 0)
      have hDim_C₀K : ringKrullDim (TensorProduct Ω (B 0) K_gen) =
          ((k_sl + 2 : ℕ) : WithBot ℕ∞) :=
        (hTensDim Ω K_gen (B 0)).trans hDom₀.2
      let e_comm₀ : TensorProduct Ω (B 0) K_gen ≃ₐ[Ω] TensorProduct Ω K_gen (B 0) :=
        Algebra.TensorProduct.comm Ω (B 0) K_gen
      have : IsDomain (TensorProduct Ω K_gen (B 0)) :=
        Function.Injective.isDomain e_comm₀.symm.toRingHom e_comm₀.symm.injective
      have hDim_C'₀K : ringKrullDim (TensorProduct Ω K_gen (B 0)) =
          ((k_sl + 2 : ℕ) : WithBot ℕ∞) :=
        (RingEquiv.ringKrullDim e_comm₀.symm.toRingEquiv).trans hDim_C₀K
      let S'₀ : Finset (TensorProduct Ω K_gen (B 0)) := S₀.image e_comm₀
      have hCardS'₀ : S'₀.card ≤ k_sl + 1 := Finset.card_image_le.trans hCardS₀
      let m'0_K : Ideal (TensorProduct Ω K_gen (B 0)) := Ideal.comap e_comm₀.symm.toRingHom m0_K
      have : m'0_K.IsPrime := Ideal.IsPrime.comap e_comm₀.symm.toRingHom
      have hSpanS'₀_le : Ideal.span (S'₀ : Set (TensorProduct Ω K_gen (B 0))) ≤ m'0_K := by
        rw [Ideal.span_le]
        intro z hz
        rw [Finset.mem_coe, Finset.mem_image] at hz
        obtain ⟨x, hx, rfl⟩ := hz
        change e_comm₀.symm (e_comm₀ x) ∈ m0_K
        rw [AlgEquiv.symm_apply_apply]
        exact hS₀_sub hx
      obtain ⟨Q'₀, hQ'₀_min, hQ'₀_le⟩ := Ideal.exists_minimalPrimes_le hSpanS'₀_le
      have : Q'₀.IsPrime := hQ'₀_min.1.1
      have hDim_Q'₀_raw :=
        hMinPrimeQuot K_gen (TensorProduct Ω K_gen (B 0))
          (k_sl + 2) (k_sl + 1) hDim_C'₀K S'₀ hCardS'₀ Q'₀ hQ'₀_min
      have hsub1 : (k_sl + 2) - (k_sl + 1) = 1 := by omega
      rw [hsub1] at hDim_Q'₀_raw
      let Q₀_id : Ideal (TensorProduct Ω (B 0) K_gen) := Ideal.comap e_comm₀.toRingHom Q'₀
      have : Q₀_id.IsPrime := Ideal.IsPrime.comap e_comm₀.toRingHom
      have hS₀_le_Q₀ : ∀ x ∈ S₀, x ∈ Q₀_id := by
        intro x hx
        change e_comm₀ x ∈ Q'₀
        exact hQ'₀_min.1.2 (Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx)))
      have hJ_le_Q₀ : J_K 0 ≤ Q₀_id := by
        dsimp only [J_K, J_R]
        rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
        rintro z (hz | ⟨i, rfl⟩)
        · rw [Set.mem_singleton_iff] at hz
          subst hz
          exact hS₀_le_Q₀ _ (Finset.mem_insert_self _ _)
        · exact hS₀_le_Q₀ _ (Finset.mem_insert_of_mem
            (Finset.mem_image_of_mem _ (Finset.mem_univ i)))
      have hQ₀_le_m0 : Q₀_id ≤ m0_K := by
        intro x hx
        have h1 : e_comm₀ x ∈ m'0_K := hQ'₀_le hx
        change e_comm₀.symm (e_comm₀ x) ∈ m0_K at h1
        rwa [AlgEquiv.symm_apply_apply] at h1
      have hMapEq : Q'₀ = Ideal.map e_comm₀ Q₀_id := by
        ext y
        constructor
        · intro hy
          have hmem : e_comm₀.symm y ∈ Q₀_id := by
            change e_comm₀ (e_comm₀.symm y) ∈ Q'₀
            rwa [AlgEquiv.apply_symm_apply]
          have hmap := Ideal.mem_map_of_mem e_comm₀ hmem
          rwa [AlgEquiv.apply_symm_apply] at hmap
        · intro hy
          exact (Ideal.map_le_iff_le_comap.mpr le_rfl) hy
      let : CommRing ((TensorProduct Ω K_gen (B 0)) ⧸ Q'₀) := inferInstance
      let : CommRing ((TensorProduct Ω (B 0) K_gen) ⧸ Q₀_id) := inferInstance
      have hDim_Q₀ : (1 : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω (B 0) K_gen) ⧸ Q₀_id) := by
        have heq := RingEquiv.ringKrullDim
          (Ideal.quotientEquivAlg Q₀_id Q'₀ e_comm₀ hMapEq).toRingEquiv
        rw [heq]
        exact hDim_Q'₀_raw
      have hex_β₁ : ∃ β₁ : Fin (N' + 1), r_coord 0 β₁.succ ⊗ₜ[Ω] (1 : K_gen) ∉ Q₀_id := by
        by_contra hAllNot
        push Not at hAllNot
        have hker_le : RingHom.ker ev₀.toRingHom ≤
            Ideal.comap
              (Algebra.TensorProduct.includeLeftRingHom :
                B 0 →+* TensorProduct Ω (B 0) K_gen) Q₀_id := by
          rw [hev₀_ker, Ideal.span_le]
          rintro _ ⟨β, rfl⟩
          exact hAllNot β
        have hmod : ∀ z : TensorProduct Ω (B 0) K_gen, z - (1 : B 0) ⊗ₜ[Ω] Φ₀ z ∈ Q₀_id := by
          intro z
          induction z using TensorProduct.inductionOn with
          | tmul b k =>
            let b₀ : B 0 := b - algebraMap Ω (B 0) (ev₀ b)
            have hb₀_ker : b₀ ∈ RingHom.ker ev₀.toRingHom := by
              rw [RingHom.mem_ker]
              change ev₀ (b - algebraMap Ω (B 0) (ev₀ b)) = 0
              rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
            have hb₀_Q : b₀ ⊗ₜ[Ω] (1 : K_gen) ∈ Q₀_id := hker_le hb₀_ker
            have hb₀k_Q : b₀ ⊗ₜ[Ω] k ∈ Q₀_id := by
              have hmul : b₀ ⊗ₜ[Ω] k = (b₀ ⊗ₜ[Ω] (1 : K_gen)) * ((1 : B 0) ⊗ₜ[Ω] k) := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
              rw [hmul]
              exact Q₀_id.mul_mem_right _ hb₀_Q
            have hscalar : (algebraMap Ω (B 0) (ev₀ b)) ⊗ₜ[Ω] k =
                (1 : B 0) ⊗ₜ[Ω] Φ₀ (b ⊗ₜ[Ω] k) := by
              have hs1 : algebraMap Ω (B 0) (ev₀ b) = (ev₀ b) • (1 : B 0) := by
                rw [Algebra.smul_def, mul_one]
              rw [hs1, TensorProduct.smul_tmul]
              congr 1
              simp [Φ₀, Algebra.TensorProduct.lift_tmul, Algebra.smul_def]
            have hsub_eq : b ⊗ₜ[Ω] k - (1 : B 0) ⊗ₜ[Ω] Φ₀ (b ⊗ₜ[Ω] k) = b₀ ⊗ₜ[Ω] k := by
              rw [← hscalar, ← TensorProduct.sub_tmul]
            rw [hsub_eq]
            exact hb₀k_Q
          | add x y hx hy =>
            have heq : (x + y) - (1 : B 0) ⊗ₜ[Ω] Φ₀ (x + y) =
                (x - (1 : B 0) ⊗ₜ[Ω] Φ₀ x) + (y - (1 : B 0) ⊗ₜ[Ω] Φ₀ y) := by
              rw [map_add, TensorProduct.tmul_add]
              ring
            rw [heq]
            exact Q₀_id.add_mem hx hy
        have hm0_le : m0_K ≤ Q₀_id := by
          intro z hz
          have hz0 : Φ₀ z = 0 := hz
          have hm := hmod z
          rwa [hz0, TensorProduct.tmul_zero, sub_zero] at hm
        have hEq : Q₀_id = m0_K := le_antisymm hQ₀_le_m0 hm0_le
        rw [hEq, hDim_m0] at hDim_Q₀
        norm_num at hDim_Q₀
      obtain ⟨β₁, hβ₁⟩ := hex_β₁
      exact ⟨⟨Q₀_id, inferInstance⟩, β₁, hJ_le_Q₀, hQ₀_le_m0, hβ₁, hDim_Q₀⟩

    · 
      
      
      intro β hNt
      obtain ⟨hDomB₁, hDimB₁, hf₁_ne⟩ := hDom β hNt
      have : IsDomain (B β.succ) := hDomB₁
      exact hConj4 L P_t hPt R ϖ hϖ ev_R hev_ϖ hev_poly u_L (fun _ _ => rfl) v_L
        (B β.succ) hDimB₁
        ⟨hTensDom L (B β.succ), (hTensDim Ω L (B β.succ)).trans hDimB₁⟩
        (fun γ => r_coord β.succ γ.succ) β (hr_diag β.succ) c_F hf₁_ne

  
  
  
  let L : Type u := FractionRing P_coeff
  have : Infinite L := Infinite.of_injective (algebraMap Ω L) (algebraMap Ω L).injective
  let P_t : Ideal (Polynomial L) := Ideal.span ({Polynomial.X} : Set (Polynomial L))
  have : P_t.IsPrime := (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr Polynomial.prime_X
  let R : Type u := Localization.AtPrime P_t
  let ϖ : R := algebraMap (Polynomial L) R Polynomial.X
  obtain ⟨ev_R, u_L, v_L, hBody⟩ := hMain L P_t rfl R ϖ rfl
  exact ⟨L, inferInstance, inferInstance, inferInstance,
    R, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    ϖ, ev_R, u_L, v_L, hBody⟩

theorem weil_dvr_pencil_overlap_and_origin_prime_compatibility (Ω K : Type u) [Field Ω] [Field K] [Algebra Ω K]
    (M_ch n_eq : ℕ)
    (B₀ B₁ C : Type u) [CommRing B₀] [CommRing B₁] [CommRing C]
    [Algebra Ω B₀] [Algebra.FiniteType Ω B₀]
    [Algebra Ω B₁] [Algebra.FiniteType Ω B₁]
    (res_L : B₀ →+* C) (res_R : B₁ →+* C)
    (r_L : B₀) (r_R : B₁)
    (r₀ : Fin M_ch → B₀) (r₁ : Fin M_ch → B₁)
    (s_vec : Fin n_eq → Fin M_ch → K)
    (hΩ_comm : ∀ c : Ω, res_R (algebraMap Ω B₁ c) = res_L (algebraMap Ω B₀ c))
    (hLoc_L : @IsLocalization.Away B₀ _ r_L C _ res_L.toAlgebra)
    (hLoc_R : @IsLocalization.Away B₁ _ r_R C _ res_R.toAlgebra)
    (hUnit : res_R r_R * res_L r_L = 1)
    (hScale_r : ∀ γ : Fin M_ch, res_R (r₁ γ) * res_L r_L = res_L (r₀ γ)) :
    let I₀ : Ideal (TensorProduct Ω B₀ K) :=
      Ideal.span (Set.range fun k : Fin n_eq => ∑ γ : Fin M_ch, (r₀ γ) ⊗ₜ[Ω] (s_vec k γ))
    let I₁ : Ideal (TensorProduct Ω B₁ K) :=
      Ideal.span (Set.range fun k : Fin n_eq => ∑ γ : Fin M_ch, (r₁ γ) ⊗ₜ[Ω] (s_vec k γ))
    IsDomain ((TensorProduct Ω B₁ K) ⧸ I₁) →
    ringKrullDim ((TensorProduct Ω B₁ K) ⧸ I₁) ≤ (1 : WithBot ℕ∞) →
    r_R ⊗ₜ[Ω] (1 : K) ∉ I₁ →
    letI : Algebra Ω C := (res_L.comp (algebraMap Ω B₀)).toAlgebra
    let res_L_alg : B₀ →ₐ[Ω] C := ⟨res_L, fun _ => rfl⟩
    let res_R_alg : B₁ →ₐ[Ω] C := ⟨res_R, hΩ_comm⟩
    let Φ_L := (Algebra.TensorProduct.map res_L_alg (AlgHom.id Ω K)).toRingHom
    let Φ_R := (Algebra.TensorProduct.map res_R_alg (AlgHom.id Ω K)).toRingHom
    ∀ (Q₀ : PrimeSpectrum (TensorProduct Ω B₀ K)),
      I₀ ≤ Q₀.asIdeal →
      r_L ⊗ₜ[Ω] (1 : K) ∉ Q₀.asIdeal →
      (Q₀.asIdeal = I₀ ∨
        (1 : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω B₀ K) ⧸ Q₀.asIdeal)) →
      ∃ P_ov : PrimeSpectrum (TensorProduct Ω C K),
        PrimeSpectrum.comap Φ_L P_ov = Q₀ ∧
        (PrimeSpectrum.comap Φ_R P_ov).asIdeal = I₁ :=
by
  intro I₀ I₁ hDom₁ hDim₁ hr_R_not_mem
  let _ : Algebra Ω C := (res_L.comp (algebraMap Ω B₀)).toAlgebra
  intro res_L_alg res_R_alg Φ_L Φ_R Q₀ hI₀_le hr_L_not_mem hDisj
  let A₀ := TensorProduct Ω B₀ K
  let A₁ := TensorProduct Ω B₁ K
  let A_ov := TensorProduct Ω C K
  let M_L : Submonoid A₀ := Algebra.algebraMapSubmonoid A₀ (Submonoid.powers r_L)
  let M_R : Submonoid A₁ := Algebra.algebraMapSubmonoid A₁ (Submonoid.powers r_R)
  have hLoc_ΦL : @IsLocalization A₀ _ M_L A_ov _ Φ_L.toAlgebra := by
    let _ : Algebra B₀ C := res_L.toAlgebra
    have : IsScalarTower Ω B₀ C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let _ : Algebra A₀ A_ov := Φ_L.toAlgebra
    have : IsScalarTower B₀ A₀ A_ov := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have : IsLocalization (Submonoid.powers r_L) C := hLoc_L
    refine IsLocalization.tensorProduct_tensorProduct Ω K (Submonoid.powers r_L) C ?_
    ext x
    simp [Φ_L, res_L_alg, RingHom.algebraMap_toAlgebra]
  have hLoc_ΦR : @IsLocalization A₁ _ M_R A_ov _ Φ_R.toAlgebra := by
    let _ : Algebra B₁ C := res_R.toAlgebra
    have : IsScalarTower Ω B₁ C := IsScalarTower.of_algebraMap_eq (fun c => (hΩ_comm c).symm)
    let _ : Algebra A₁ A_ov := Φ_R.toAlgebra
    have : IsScalarTower B₁ A₁ A_ov := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have : IsLocalization (Submonoid.powers r_R) C := hLoc_R
    refine IsLocalization.tensorProduct_tensorProduct Ω K (Submonoid.powers r_R) C ?_
    ext x
    simp [Φ_R, res_R_alg, RingHom.algebraMap_toAlgebra]
  let u : A_ov := res_L r_L ⊗ₜ[Ω] (1 : K)
  let v : A_ov := res_R r_R ⊗ₜ[Ω] (1 : K)
  have hv_mul_u : v * u = 1 := by
    dsimp [u, v]
    rw [Algebra.TensorProduct.tmul_mul_tmul, hUnit, mul_one]
    rfl
  let g₀ : Fin n_eq → A₀ := fun k => ∑ γ : Fin M_ch, (r₀ γ) ⊗ₜ[Ω] (s_vec k γ)
  let g₁ : Fin n_eq → A₁ := fun k => ∑ γ : Fin M_ch, (r₁ γ) ⊗ₜ[Ω] (s_vec k γ)
  have hu_scale : ∀ k : Fin n_eq, u * Φ_R (g₁ k) = Φ_L (g₀ k) := by
    intro k
    dsimp [u, g₀, g₁, Φ_L, Φ_R, res_L_alg, res_R_alg]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun γ _ => ?_
    simp only [Algebra.TensorProduct.map_tmul, AlgHom.coe_mk, AlgHom.id_apply]
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm (res_L r_L) (res_R (r₁ γ)),
      hScale_r γ]
  have hv_scale : ∀ k : Fin n_eq, v * Φ_L (g₀ k) = Φ_R (g₁ k) := by
    intro k
    rw [← hu_scale k, ← mul_assoc, hv_mul_u, one_mul]
  have hMap_eq : Ideal.map Φ_L I₀ = Ideal.map Φ_R I₁ := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      change Φ_L (g₀ k) ∈ Ideal.map Φ_R I₁
      rw [← hu_scale k]
      exact Ideal.mul_mem_left _ u (Ideal.mem_map_of_mem Φ_R (Ideal.subset_span ⟨k, rfl⟩))
    · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      change Φ_R (g₁ k) ∈ Ideal.map Φ_L I₀
      rw [← hv_scale k]
      exact Ideal.mul_mem_left _ v (Ideal.mem_map_of_mem Φ_L (Ideal.subset_span ⟨k, rfl⟩))
  have hDisj_L : Disjoint (M_L : Set A₀) (Q₀.asIdeal : Set A₀) := by
    rw [Set.disjoint_left]
    intro x hxM hxQ
    rcases hxM with ⟨y, ⟨n, rfl⟩, rfl⟩
    rw [map_pow] at hxQ
    have hmem : algebraMap B₀ A₀ r_L ∈ Q₀.asIdeal := Q₀.isPrime.mem_of_pow_mem n hxQ
    exact hr_L_not_mem hmem
  let P_ideal : Ideal A_ov := Ideal.map Φ_L Q₀.asIdeal
  have hP_L_props : P_ideal.IsPrime ∧ Ideal.comap Φ_L P_ideal = Q₀.asIdeal := by
    let _ : Algebra A₀ A_ov := Φ_L.toAlgebra
    have : IsLocalization M_L A_ov := hLoc_ΦL
    refine ⟨IsLocalization.isPrime_of_isPrime_disjoint M_L A_ov Q₀.asIdeal Q₀.isPrime hDisj_L, ?_⟩
    exact IsLocalization.under_map_of_isPrime_disjoint M_L A_ov Q₀.isPrime hDisj_L
  have hP_prime : P_ideal.IsPrime := hP_L_props.1
  have hUnder_L : Ideal.comap Φ_L P_ideal = Q₀.asIdeal := hP_L_props.2
  let P_ov : PrimeSpectrum A_ov := ⟨P_ideal, hP_prime⟩
  have hComap_L : PrimeSpectrum.comap Φ_L P_ov = Q₀ := PrimeSpectrum.ext hUnder_L
  let Q₁ : Ideal A₁ := Ideal.comap Φ_R P_ideal
  have hI₁_le_Q₁ : I₁ ≤ Q₁ := by
    rw [← Ideal.map_le_iff_le_comap, ← hMap_eq]
    exact Ideal.map_mono hI₀_le
  refine ⟨P_ov, hComap_L, ?_⟩
  change Q₁ = I₁
  rcases hDisj with hEq | hDim_Q₀
  · have hI₁_prime : I₁.IsPrime := (Ideal.Quotient.isDomain_iff_prime I₁).mp hDom₁
    have hDisj_R : Disjoint (M_R : Set A₁) (I₁ : Set A₁) := by
      rw [Set.disjoint_left]
      intro x hxM hxI
      rcases hxM with ⟨y, ⟨n, rfl⟩, rfl⟩
      rw [map_pow] at hxI
      exact hr_R_not_mem (hI₁_prime.mem_of_pow_mem n hxI)
    have hP_eq_R : P_ideal = Ideal.map Φ_R I₁ := by
      dsimp [P_ideal]
      rw [hEq, hMap_eq]
    dsimp [Q₁]
    rw [hP_eq_R]
    let _ : Algebra A₁ A_ov := Φ_R.toAlgebra
    have : IsLocalization M_R A_ov := hLoc_ΦR
    exact IsLocalization.under_map_of_isPrime_disjoint M_R A_ov hI₁_prime hDisj_R
  · by_contra hQ₁_ne
    have hQ₁_prime : Q₁.IsPrime := Ideal.comap_isPrime Φ_R P_ideal
    let D₁ := A₁ ⧸ I₁
    let π₁ : A₁ →+* D₁ := Ideal.Quotient.mk I₁
    let Qbar : Ideal D₁ := Ideal.map π₁ Q₁
    have hComap_Qbar : Ideal.comap π₁ Qbar = Q₁ := by
      rw [Ideal.comap_map_of_surjective π₁ Ideal.Quotient.mk_surjective Q₁,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hI₁_le_Q₁]
    have hQbar_ne : Qbar ≠ ⊥ := by
      intro hbot
      apply hQ₁_ne
      rw [← hComap_Qbar, hbot, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    have hQbar_prime : Qbar.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hI₁_le_Q₁)
    have hKrullLE : Ring.KrullDimLE 1 D₁ := Ring.krullDimLE_iff.mpr hDim₁
    have hQbar_max : Qbar.IsMaximal :=
      (Ring.krullDimLE_one_iff_of_isPrime_bot.mp hKrullLE) Qbar hQbar_ne hQbar_prime
    have hQ₁_max : Q₁.IsMaximal := by
      rw [← hComap_Qbar]
      exact Ideal.comap_isMaximal_of_surjective π₁ Ideal.Quotient.mk_surjective
    obtain ⟨M, hM_max, hPM⟩ := Ideal.exists_le_maximal P_ideal hP_prime.ne_top
    have hM_prime : M.IsPrime := hM_max.isPrime
    have hComapM_prime : (Ideal.comap Φ_R M).IsPrime := Ideal.comap_isPrime Φ_R M
    have hQ₁_eq_M : Q₁ = Ideal.comap Φ_R M :=
      hQ₁_max.eq_of_le hComapM_prime.ne_top (Ideal.comap_mono hPM)
    have hP_eq_M : P_ideal = M := by
      let _ : Algebra A₁ A_ov := Φ_R.toAlgebra
      have : IsLocalization M_R A_ov := hLoc_ΦR
      have h1 : Ideal.map Φ_R Q₁ = P_ideal := IsLocalization.map_under M_R A_ov P_ideal
      have h2 : Ideal.map Φ_R (Ideal.comap Φ_R M) = M := IsLocalization.map_under M_R A_ov M
      rw [← h1, hQ₁_eq_M, h2]
    have hP_max : P_ideal.IsMaximal := hP_eq_M ▸ hM_max
    let E_ov := A_ov ⧸ P_ideal
    let _ : Field E_ov := Ideal.Quotient.field P_ideal
    have hFT_C : Algebra.FiniteType Ω C := by
      let _ : Algebra B₀ C := res_L.toAlgebra
      have : IsScalarTower Ω B₀ C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      have : IsLocalization.Away r_L C := hLoc_L
      have hFT_B₀C : Algebra.FiniteType B₀ C :=
        Algebra.FiniteType.equiv inferInstance
          (IsLocalization.Away.mvPolynomialQuotientEquiv C r_L)
      exact Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType Ω B₀) hFT_B₀C
    have hFT_algK : (algebraMap K (TensorProduct Ω K C)).FiniteType :=
      RingHom.finiteType_algebraMap.mpr inferInstance
    let e_comm : TensorProduct Ω K C →+* A_ov :=
      (Algebra.TensorProduct.comm Ω K C).toRingEquiv.toRingHom
    have hFT_ecomm : e_comm.FiniteType :=
      RingHom.FiniteType.of_surjective e_comm
        (Algebra.TensorProduct.comm Ω K C).toRingEquiv.surjective
    let ι_C : K →+* A_ov := (Algebra.TensorProduct.includeRight : K →ₐ[Ω] A_ov).toRingHom
    have hι_C_eq : ι_C = e_comm.comp (algebraMap K (TensorProduct Ω K C)) := by
      ext x
      simp [ι_C, e_comm, Algebra.TensorProduct.algebraMap_apply]
    have hFT_ιC : ι_C.FiniteType := by
      rw [hι_C_eq]
      exact hFT_ecomm.comp hFT_algK
    let π_P : A_ov →+* E_ov := Ideal.Quotient.mk P_ideal
    have hFT_πP : π_P.FiniteType :=
      RingHom.FiniteType.of_surjective π_P Ideal.Quotient.mk_surjective
    let f_KE : K →+* E_ov := π_P.comp ι_C
    have hf_FT : f_KE.FiniteType := hFT_πP.comp hFT_ιC
    have hf_Fin : f_KE.Finite := RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hf_FT
    have hf_Int : f_KE.IsIntegral := RingHom.Finite.to_isIntegral hf_Fin
    let D₀ := A₀ ⧸ Q₀.asIdeal
    have : IsDomain D₀ := (Ideal.Quotient.isDomain_iff_prime Q₀.asIdeal).mpr Q₀.isPrime
    let ψ : D₀ →+* E_ov := Ideal.quotientMap P_ideal Φ_L (le_of_eq hUnder_L.symm)
    have hψ_inj : Function.Injective ψ := Ideal.quotientMap_injective' (le_of_eq hUnder_L)
    let f_KD₀ : K →+* D₀ :=
      (Ideal.Quotient.mk Q₀.asIdeal).comp
        (Algebra.TensorProduct.includeRight : K →ₐ[Ω] A₀).toRingHom
    have hψ_comp : ∀ x : K, ψ (f_KD₀ x) = f_KE x := by
      intro x
      change Ideal.quotientMap P_ideal Φ_L (le_of_eq hUnder_L.symm)
          (Ideal.Quotient.mk Q₀.asIdeal
            ((Algebra.TensorProduct.includeRight : K →ₐ[Ω] A₀) x)) =
        Ideal.Quotient.mk P_ideal
          ((Algebra.TensorProduct.includeRight : K →ₐ[Ω] A_ov) x)
      rw [Ideal.quotientMap_mk]
      congr 1
      simp [Φ_L]
    have hField_D₀ : IsField D₀ := by
      let _ : Algebra K D₀ := f_KD₀.toAlgebra
      let _ : Algebra K E_ov := f_KE.toAlgebra
      have : Algebra.IsIntegral K E_ov := Algebra.isIntegral_def.mpr hf_Int
      let ψ_alg : D₀ →ₐ[K] E_ov := ⟨ψ, hψ_comp⟩
      have : Algebra.IsIntegral K D₀ := Algebra.IsIntegral.of_injective ψ_alg hψ_inj
      exact (Algebra.IsIntegral.isField_iff_isField (R := K) (S := D₀)
        (RingHom.injective (algebraMap K D₀))).mp (Field.toIsField K)
    have hDim0 : ringKrullDim D₀ = 0 := ringKrullDim_eq_zero_of_isField hField_D₀
    rw [hDim0] at hDim_Q₀
    exact absurd hDim_Q₀ (by decide)

theorem weil_dvr_schematic_closure_integral_and_section_lift (Ω R D_gen : Type u) [Field Ω] [CommRing R] [IsDomain R] [Algebra Ω R]
    [CommRing D_gen] [IsDomain D_gen]
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsProper W.hom]
    (q₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left)
    (hq₀_hom : q₀ ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) :
    let s_ΩR := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R))
    let W_R := CategoryTheory.Limits.pullback W.hom s_ΩR
    let snd_R := CategoryTheory.Limits.pullback.snd W.hom s_ΩR
    let σ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W_R :=
      CategoryTheory.Limits.pullback.lift (s_ΩR ≫ q₀)
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)))
        (by rw [CategoryTheory.Category.assoc, hq₀_hom,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    ∀ (j : AlgebraicGeometry.Spec (CommRingCat.of D_gen) ⟶ W_R),
      σ_W.base (⊥ : PrimeSpectrum R) ∈
        closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) →
      ∃ (𝒴_R : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsIntegral 𝒴_R)
        (ι_𝒴 : 𝒴_R ⟶ W_R)
        (_ : AlgebraicGeometry.IsClosedImmersion ι_𝒴)
        (p_R : 𝒴_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (_ : AlgebraicGeometry.IsProper p_R)
        (_ : AlgebraicGeometry.Surjective p_R)
        (σ_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ 𝒴_R),
        p_R = ι_𝒴 ≫ snd_R ∧
        Set.range ι_𝒴.base = closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) ∧
        σ_R ≫ ι_𝒴 = σ_W ∧
        σ_R ≫ p_R = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) :=
by
  intro s_ΩR W_R snd_R σ_W j hMem
  have : QuasiSeparatedSpace ↥W_R :=
    (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace snd_R).mp inferInstance
  have : AlgebraicGeometry.QuasiCompact j :=
    AlgebraicGeometry.quasiCompact_of_compactSpace j
  have : AlgebraicGeometry.QuasiCompact σ_W :=
    AlgebraicGeometry.quasiCompact_of_compactSpace σ_W
  let 𝒴_R : AlgebraicGeometry.Scheme.{u} := j.image
  let ι_𝒴 : 𝒴_R ⟶ W_R := j.imageι
  let p_R : 𝒴_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) := ι_𝒴 ≫ snd_R
  have hCl_eq : closure (Set.range j.base) =
      closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) := by
    apply Set.Subset.antisymm
    · refine closure_minimal ?_ isClosed_closure
      rintro _ ⟨x, rfl⟩
      have hx : x ∈ closure ({(⊥ : PrimeSpectrum D_gen)} : Set (PrimeSpectrum D_gen)) :=
        (PrimeSpectrum.le_iff_mem_closure (⊥ : PrimeSpectrum D_gen) x).mp bot_le
      have hSubPre : ({(⊥ : PrimeSpectrum D_gen)} : Set (PrimeSpectrum D_gen)) ⊆
          (j.base : PrimeSpectrum D_gen → ↥W_R) ⁻¹'
            closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) :=
        Set.singleton_subset_iff.mpr (subset_closure (Set.mem_singleton _))
      have hClosedPre : IsClosed
          ((j.base : PrimeSpectrum D_gen → ↥W_R) ⁻¹'
            closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R)) :=
        isClosed_closure.preimage j.continuous
      exact closure_minimal hSubPre hClosedPre hx
    · exact closure_mono (Set.singleton_subset_iff.mpr ⟨(⊥ : PrimeSpectrum D_gen), rfl⟩)
  have hSupp : (j.ker.support : Set ↥W_R) =
      closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) := by
    have h1 : (j.ker.support : Set ↥W_R) = closure (Set.range j.base) := j.support_ker
    exact h1.trans hCl_eq
  have hRange : Set.range ι_𝒴.base =
      closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) := by
    have h0 : Set.range ι_𝒴.base = (j.ker.support : Set ↥W_R) := j.ker.range_subschemeι
    exact h0.trans hSupp
  let e_j : AlgebraicGeometry.Spec (CommRingCat.of D_gen) ⟶ 𝒴_R := j.toImage
  have hPre : PreirreducibleSpace ↥𝒴_R := by
    refine ⟨?_⟩
    have huniv_src : IsPreirreducible
        (Set.univ : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D_gen))) :=
      PreirreducibleSpace.isPreirreducible_univ
    have hrange_pre : IsPreirreducible (Set.range e_j.base) := by
      rw [← Set.image_univ]
      exact huniv_src.image e_j.base e_j.continuous.continuousOn
    have hcl_pre : IsPreirreducible (closure (Set.range e_j.base)) := hrange_pre.closure
    have hdense : closure (Set.range e_j.base) = Set.univ :=
      denseRange_iff_closure_range.mp (AlgebraicGeometry.IsDominant.denseRange (f := e_j))
    rwa [hdense] at hcl_pre
  have : IrreducibleSpace ↥𝒴_R :=
    @IrreducibleSpace.mk _ _ hPre ⟨e_j.base (⊥ : PrimeSpectrum D_gen)⟩
  let 𝒰 : 𝒴_R.OpenCover := j.ker.subschemeCover.openCover
  have : ∀ U : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X U) := by
    intro U
    let φ_U := (j.app U.1).hom
    have : _root_.IsReduced ↑((AlgebraicGeometry.Spec (CommRingCat.of D_gen)).presheaf.obj
        (Opposite.op (j ⁻¹ᵁ U.1))) :=
      AlgebraicGeometry.IsReduced.component_reduced (j ⁻¹ᵁ U.1)
    have hker_U : j.ker.ideal U = RingHom.ker φ_U := j.ker_apply U
    let ψ_U := φ_U.kerLift.comp (Ideal.quotEquivOfEq hker_U).toRingHom
    have hψ_inj : Function.Injective ψ_U :=
      (RingHom.kerLift_injective φ_U).comp (Ideal.quotEquivOfEq hker_U).injective
    have : _root_.IsReduced (↑(W_R.presheaf.obj (Opposite.op U.1)) ⧸ j.ker.ideal U) :=
      isReduced_of_injective ψ_U hψ_inj
    change AlgebraicGeometry.IsReduced
      (AlgebraicGeometry.Spec (CommRingCat.of
        (↑(W_R.presheaf.obj (Opposite.op U.1)) ⧸ j.ker.ideal U)))
    exact inferInstance
  have : AlgebraicGeometry.IsReduced 𝒴_R :=
    AlgebraicGeometry.IsReduced.of_openCover 𝒴_R 𝒰
  have hInt : AlgebraicGeometry.IsIntegral 𝒴_R :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced 𝒴_R
  have hσ_supp : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of R)),
      σ_W.base p ∈ j.ker.support := by
    intro p
    have hp_cl : p ∈ closure ({(⊥ : PrimeSpectrum R)} : Set (PrimeSpectrum R)) :=
      (PrimeSpectrum.le_iff_mem_closure (⊥ : PrimeSpectrum R) p).mp bot_le
    have hSubPre : ({(⊥ : PrimeSpectrum R)} : Set (PrimeSpectrum R)) ⊆
        (σ_W.base : PrimeSpectrum R → ↥W_R) ⁻¹'
          closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) :=
      Set.singleton_subset_iff.mpr hMem
    have hClosedPre : IsClosed
        ((σ_W.base : PrimeSpectrum R → ↥W_R) ⁻¹'
          closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R)) :=
      isClosed_closure.preimage σ_W.continuous
    have hmem_cl : σ_W.base p ∈ closure ({j.base (⊥ : PrimeSpectrum D_gen)} : Set ↥W_R) :=
      closure_minimal hSubPre hClosedPre hp_cl
    change σ_W.base p ∈ (j.ker.support : Set ↥W_R)
    rwa [hSupp]
  have hKerLE : ι_𝒴.ker ≤ σ_W.ker := by
    change j.ker.subschemeι.ker ≤ σ_W.ker
    rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.le_def]
    intro U a ha
    rw [σ_W.ker_apply U, RingHom.mem_ker, ← AlgebraicGeometry.basicOpen_eq_bot_iff,
      ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen σ_W a, eq_bot_iff]
    intro p hp
    have hp_bo : σ_W.base p ∈ W_R.basicOpen a := hp
    have hp_zl := (AlgebraicGeometry.Scheme.IdealSheafData.mem_support_iff.mp (hσ_supp p)) U
    exact False.elim (((W_R.mem_zeroLocus_iff _ _).mp hp_zl) a ha hp_bo)
  let σ_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ 𝒴_R :=
    AlgebraicGeometry.IsClosedImmersion.lift ι_𝒴 σ_W hKerLE
  have hσ_ι : σ_R ≫ ι_𝒴 = σ_W :=
    AlgebraicGeometry.IsClosedImmersion.lift_fac ι_𝒴 σ_W hKerLE
  have hSec : σ_R ≫ p_R = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) := by
    change σ_R ≫ (ι_𝒴 ≫ snd_R) = _
    rw [← CategoryTheory.Category.assoc, hσ_ι]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hSurjComp : AlgebraicGeometry.Surjective (σ_R ≫ p_R) := by
    rw [hSec]
    exact inferInstance
  have hSurj : AlgebraicGeometry.Surjective p_R :=
    @AlgebraicGeometry.Surjective.of_comp _ _ _ σ_R p_R hSurjComp
  exact ⟨𝒴_R, hInt, ι_𝒴, inferInstance, p_R, inferInstance, hSurj, σ_R, rfl, hRange, hσ_ι, hSec⟩

theorem weil_algClosed_chart_baseChange_and_special_fiber_krullDim_le_one (Ω : Type u) [Field Ω] (N' : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsProper W.hom]
    (U_chart : Fin (N' + 1 + 1) → W.left.Opens)
    (hAff : ∀ α : Fin (N' + 1 + 1), AlgebraicGeometry.IsAffineOpen (U_chart α)) :
    let B : Fin (N' + 1 + 1) → Type u :=
      fun α => ↑(W.left.presheaf.obj (Opposite.op (U_chart α)))
    ∀ [∀ α : Fin (N' + 1 + 1), Algebra Ω (B α)]
      [∀ α : Fin (N' + 1 + 1), Algebra.FiniteType Ω (B α)]
      (r_coord : ∀ α : Fin (N' + 1 + 1), Fin (N' + 1 + 1) → B α)
      (b₀ : W.left)
      (q₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left)
      (ev₀ : B 0 →ₐ[Ω] Ω),
      (∀ α : Fin (N' + 1 + 1),
        (hAff α).fromSpec ≫ W.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (B α)))) →
      (∀ α α' : Fin (N' + 1 + 1),
        U_chart α ⊓ U_chart α' = W.left.basicOpen (r_coord α α')) →
      b₀ ∈ U_chart 0 →
      IsClosed ({b₀} : Set W.left) →
      Set.range q₀.base = {b₀} →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫ (hAff 0).fromSpec = q₀ →
      (∀ w : W.left, w ≠ b₀ → ∃ β : Fin (N' + 1), w ∈ U_chart β.succ) →
      (∀ α α' : Fin (N' + 1 + 1),
        @IsLocalization.Away (B α) _ (r_coord α α')
          ↑(W.left.presheaf.obj (Opposite.op (U_chart α ⊓ U_chart α'))) _
          ((W.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom).toAlgebra ∧
        @IsLocalization.Away (B α') _ (r_coord α' α)
          ↑(W.left.presheaf.obj (Opposite.op (U_chart α ⊓ U_chart α'))) _
          ((W.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom).toAlgebra) ∧
      (∀ (S : Type u) [CommRing S] [Algebra Ω S],
        let s_ΩS := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω S))
        let W_S := CategoryTheory.Limits.pullback W.hom s_ΩS
        ∃ ψ : ∀ α : Fin (N' + 1 + 1),
            AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω (B α) S)) ⟶ W_S,
          (∀ α : Fin (N' + 1 + 1),
            ψ α ≫ CategoryTheory.Limits.pullback.fst W.hom s_ΩS =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.includeLeft : B α →ₐ[Ω] TensorProduct Ω (B α) S).toRingHom) ≫
                (hAff α).fromSpec) ∧
          (∀ α : Fin (N' + 1 + 1),
            ψ α ≫ CategoryTheory.Limits.pullback.snd W.hom s_ΩS =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.includeRight : S →ₐ[Ω] TensorProduct Ω (B α) S).toRingHom)) ∧
          (∀ α : Fin (N' + 1 + 1), AlgebraicGeometry.IsOpenImmersion (ψ α)) ∧
          (∀ α : Fin (N' + 1 + 1),
            Set.range (ψ α).base =
              (CategoryTheory.Limits.pullback.fst W.hom s_ΩS).base ⁻¹' (U_chart α : Set W.left)) ∧
          (∀ α α' : Fin (N' + 1 + 1),
            let res_L := (W.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom
            let res_R := (W.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom
            ∀ (hΩ : ∀ c : Ω, res_R (algebraMap Ω (B α') c) = res_L (algebraMap Ω (B α) c)),
              letI : Algebra Ω ↑(W.left.presheaf.obj (Opposite.op (U_chart α ⊓ U_chart α'))) :=
                (res_L.comp (algebraMap Ω (B α))).toAlgebra
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.map
                  (⟨res_L, fun _ => rfl⟩ : B α →ₐ[Ω] _) (AlgHom.id Ω S)).toRingHom) ≫ ψ α =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.map
                  (⟨res_R, hΩ⟩ : B α' →ₐ[Ω] _) (AlgHom.id Ω S)).toRingHom) ≫ ψ α')) ∧
      (∀ (L : Type u) [Field L] [Algebra Ω L],
        let s_ΩL := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω L))
        let W_L := CategoryTheory.Limits.pullback W.hom s_ΩL
        ∀ (ψ_L : ∀ α : Fin (N' + 1 + 1),
            AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω (B α) L)) ⟶ W_L),
          (∀ α : Fin (N' + 1 + 1),
            ψ_L α ≫ CategoryTheory.Limits.pullback.fst W.hom s_ΩL =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.includeLeft : B α →ₐ[Ω] TensorProduct Ω (B α) L).toRingHom) ≫
                (hAff α).fromSpec) →
          (∀ α : Fin (N' + 1 + 1),
            ψ_L α ≫ CategoryTheory.Limits.pullback.snd W.hom s_ΩL =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.includeRight : L →ₐ[Ω] TensorProduct Ω (B α) L).toRingHom)) →
          (∀ α : Fin (N' + 1 + 1), AlgebraicGeometry.IsOpenImmersion (ψ_L α)) →
          (∀ α : Fin (N' + 1 + 1),
            Set.range (ψ_L α).base =
              (CategoryTheory.Limits.pullback.fst W.hom s_ΩL).base ⁻¹' (U_chart α : Set W.left)) →
          ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι_Z : Z ⟶ W_L),
            AlgebraicGeometry.IsClosedImmersion ι_Z →
            ∀ (J_L : ∀ β : Fin (N' + 1), Ideal (TensorProduct Ω (B β.succ) L)),
              (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
                ringKrullDim ((TensorProduct Ω (B β.succ) L) ⧸ J_L β) ≤ (1 : WithBot ℕ∞)) →
              (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
                ∀ q : PrimeSpectrum (TensorProduct Ω (B β.succ) L),
                  (ψ_L β.succ).base q ∈ Set.range ι_Z.base → J_L β ≤ q.asIdeal) →
              topologicalKrullDim ↥Z ≤ (1 : WithBot ℕ∞)) :=
by
  intro B hAlgB hFTB r_coord b₀ q₀ ev₀ hFromSpec hInter hb₀_U0 hb₀_cl hq₀_range hev₀ hCover_compl
  refine ⟨?_, ?_, ?_⟩
