          have h2 : ψ_κ (MvPolynomial.X 2) = (π_κ P_H)⁻¹ := by
            change MvPolynomial.eval₂Hom _ _ (MvPolynomial.X (Fin.last 2)) = _
            rw [MvPolynomial.eval₂Hom_X', Fin.lastCases_last]
          rw [h1, h2, mul_inv_cancel₀ hPH_ne, sub_self]
      intro htop
      rw [htop, top_le_iff] at hJ_le_ker
      have h1_mem : (1 : MvPolynomial (Fin 3) k) ∈ RingHom.ker ψ_κ := by
        rw [hJ_le_ker]; trivial
      have h10 : ψ_κ 1 = 0 := RingHom.mem_ker.mp h1_mem
      rw [map_one] at h10
      exact one_ne_zero h10
    obtain ⟨𝔪, h𝔪_max, hJ_le_𝔪⟩ := Ideal.exists_le_maximal J hJ_ne_top
    obtain ⟨v, rfl⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp h𝔪_max
    let u : Fin 2 → k := fun j => v j.castSucc
    have hev_ι23 : ∀ g : R_2, MvPolynomial.eval v (ι_23 g) = MvPolynomial.eval u g := by
      intro g
      change MvPolynomial.eval v (MvPolynomial.rename Fin.castSucc g) = MvPolynomial.eval u g
      rw [MvPolynomial.eval_rename]
      rfl
    have hmem_van : ∀ P : MvPolynomial (Fin 3) k,
        P ∈ MvPolynomial.vanishingIdeal k ({v} : Set (Fin 3 → k)) → MvPolynomial.eval v P = 0 := by
      intro P hP
      have haev := (MvPolynomial.mem_vanishingIdeal_singleton_iff v P).mp hP
