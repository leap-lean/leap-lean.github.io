        have : AlgebraicGeometry.IsOpenImmersion w_γ := by
          dsimp [w_γ]
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          infer_instance
        have hw_γ_range : Set.range w_γ.base = U_γ.1 :=
