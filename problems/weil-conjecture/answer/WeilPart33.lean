      have hd2 : der_Z i (s * r) ∈ p_z ^ 2 := hDer3 (der_Z i) hsr3
      have hd1 : der_Z i (s * r) ∈ p_z := Ideal.pow_le_self (by decide : 2 ≠ 0) hd2
      change ε_z (der_Z i (s * r)) = 0 at hd1
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
        hr_ker, zero_mul, add_zero] at hd1
