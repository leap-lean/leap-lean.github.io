theorem weil_algClosed_ring_morse_and_hyperbolic_odp_splitting (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ)
    (A_Z : Type u) [CommRing A_Z] [Algebra k A_Z]
    (ε_z : A_Z →+* k) [(RingHom.ker ε_z).IsPrime]
    (hε_id : ε_z.comp (algebraMap k A_Z) = RingHom.id k)
    (ψ_Z : MvPolynomial (Fin (2 * m + 2)) k →+* A_Z)
    (hψ_alg : ψ_Z.comp MvPolynomial.C = algebraMap k A_Z)
    (hψ_et : ψ_Z.Etale)
    (hψ_ker : ∀ i : Fin (2 * m + 2), ψ_Z (MvPolynomial.X i) ∈ RingHom.ker ε_z)
    (Q : MvPolynomial (Fin (2 * m + 2)) k)
    (hQ_homog : Q ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) k 2)
    (hQ_det : Matrix.det (Matrix.of fun i j : Fin (2 * m + 2) =>
      MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))) ≠ 0)
    (ℓ_0 ℓ_1 ℓ_2 : A_Z)
    (hℓ0_jet : algebraMap A_Z (Localization.AtPrime (RingHom.ker ε_z)) (ℓ_0 - ψ_Z Q) ∈
      (IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker ε_z))) ^ 3)
    (hℓ12_ne : ε_z ℓ_1 ≠ 0 ∨ ε_z ℓ_2 ≠ 0) :
    Nonempty (WeilRingSplitOdpChartPkg k m A_Z ε_z ℓ_0 ℓ_1 ℓ_2) :=
by
  let _ := hℓ12_ne
  let G_poly : MvPolynomial (Fin 2) A_Z :=
    MvPolynomial.C ℓ_0 + MvPolynomial.X (0 : Fin 2) * MvPolynomial.C ℓ_1 +
      MvPolynomial.X (1 : Fin 2) * MvPolynomial.C ℓ_2
  have hEtPkg_Z :=
    weil_ring_etale_derivation_and_submersive_jacobian k (2 * m + 2) A_Z ψ_Z hψ_alg hψ_et
  obtain ⟨der_Z, hder_Z_ψ, hder_Z_uniq⟩ := hEtPkg_Z.1
  let dG : Fin (2 * m + 2) → MvPolynomial (Fin 2) A_Z :=
    fun i => weilMvPolyMapCoeffs (der_Z i) G_poly
  let Δ_0 : MvPolynomial (Fin 2) A_Z :=
    Matrix.det (Matrix.of fun i j : Fin (2 * m + 2) => weilMvPolyMapCoeffs (der_Z j) (dG i))
  have hSm_off_crit : ∀ i : Fin (2 * m + 2),
      let I_G : Ideal (MvPolynomial (Fin 2) A_Z) :=
        Ideal.span ({G_poly} : Set (MvPolynomial (Fin 2) A_Z))
      let Q_ring := MvPolynomial (Fin 2) A_Z ⧸ I_G
      let f_base : MvPolynomial (Fin 2) k →+* Q_ring :=
        (Ideal.Quotient.mk I_G).comp (MvPolynomial.map (algebraMap k A_Z))
      RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 1)
        ((algebraMap Q_ring (Localization.Away (Ideal.Quotient.mk I_G (dG i)))).comp f_base) := by
    intro i
    exact (hEtPkg_Z.2.2 2 der_Z hder_Z_ψ).2 (by omega) G_poly i
  have hCoeff : ∀ (D : Derivation k A_Z A_Z) (f : MvPolynomial (Fin 2) A_Z) (n : Fin 2 →₀ ℕ),
      (weilMvPolyMapCoeffs D f).coeff n = D (f.coeff n) := by
    intro D f n
