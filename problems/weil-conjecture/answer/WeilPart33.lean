          intro x_1 x_2 hx_eq
          obtain ⟨P_1, rfl⟩ := Ideal.Quotient.mk_surjective x_1
          obtain ⟨P_2, rfl⟩ := Ideal.Quotient.mk_surjective x_2
          have hmem_I2 : algebraMap (MvPolynomial σ R_1) (MvPolynomial σ R_2) (P_1 - P_2) ∈
