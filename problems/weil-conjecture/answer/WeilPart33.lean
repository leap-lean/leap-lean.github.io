      apply sub_eq_zero.mp
      rw [← mul_sub, ← map_sub, ← map_mul]
      have hd_eq : s.1 * (d₁ - d₂) = ϖ_D * (s₂.1 * c) := by
        change (s₁.1 * s₂.1) * (d₁ - d₂) = ϖ_D * (s₂.1 * c)
        calc (s₁.1 * s₂.1) * (d₁ - d₂) = s₂.1 * ((d₁ - d₂) * s₁.1) := by ring
          _ = s₂.1 * (ϖ_D * c) := hs₂
          _ = ϖ_D * (s₂.1 * c) := by ring
      rw [hd_eq, map_mul, hφ_ϖ, zero_mul]
  let e_loc : A_bar ≃ₐ[D'] Localization.AtPrime q' :=
    IsLocalization.algEquiv q'.primeCompl A_bar (Localization.AtPrime q')
  have : IsDomain A_bar := Function.Injective.isDomain e_loc.toRingHom e_loc.injective
  exact hKrull_pkg.2 A ϖ_A hϖ_max hϖ_A_reg ‹_›⟩

 have hNode_pkg : True ∧ (
    let A_node := MvPolynomial (Fin 2) k ⧸
        Ideal.span ({MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)} : Set (MvPolynomial (Fin 2) k))
    ∀ (D : Type u) [CommRing D] [Algebra A_node D] [Algebra.Etale A_node D]
      (q : Ideal D) [q.IsPrime],
      IsReduced (Localization.AtPrime q)) := ⟨trivial, by
  intro A_node D _ _ _ q _
  let R_node : Type u := MvPolynomial (Fin 2) k
  let I_node : Ideal R_node :=
    Ideal.span ({MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)} : Set R_node)
  let P₁ : Type u := MvPolynomial (Fin 1) k
  let T : P₁ := MvPolynomial.X (0 : Fin 1)
  let f0 : Fin 2 → P₁ := fun i => if i = 0 then T else 0
  let f1 : Fin 2 → P₁ := fun i => if i = 0 then 0 else T
  let π0_raw : R_node →+* P₁ := MvPolynomial.eval₂Hom MvPolynomial.C f0
  let π1_raw : R_node →+* P₁ := MvPolynomial.eval₂Hom MvPolynomial.C f1
  have hπ0_X : ∀ i, π0_raw (MvPolynomial.X i) = f0 i :=
    fun i => MvPolynomial.eval₂Hom_X' MvPolynomial.C f0 i
  have hπ0_C : ∀ c, π0_raw (MvPolynomial.C c) = MvPolynomial.C c :=
    fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C f0 c
  have hπ1_X : ∀ i, π1_raw (MvPolynomial.X i) = f1 i :=
    fun i => MvPolynomial.eval₂Hom_X' MvPolynomial.C f1 i
  have hπ1_C : ∀ c, π1_raw (MvPolynomial.C c) = MvPolynomial.C c :=
    fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C f1 c
  have hker₀ : I_node ≤ RingHom.ker π0_raw := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_mul, hπ0_X, hπ0_X]
    change T * 0 = 0
    exact mul_zero T
  have hker₁ : I_node ≤ RingHom.ker π1_raw := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_mul, hπ1_X, hπ1_X]
    change 0 * T = 0
    exact zero_mul T
  let π₀ : A_node →+* P₁ := Ideal.Quotient.lift I_node π0_raw hker₀
  let π₁ : A_node →+* P₁ := Ideal.Quotient.lift I_node π1_raw hker₁
  let ι_node : A_node →+* P₁ × P₁ := RingHom.prod π₀ π₁
  have hι_inj : Function.Injective ι_node := by
    rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
    intro a ha
    rw [Submodule.mem_bot]
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [RingHom.mem_ker] at ha
    have hf₀ : π0_raw f = 0 := congrArg Prod.fst ha
    have hf₁ : π1_raw f = 0 := congrArg Prod.snd ha
    let g0_f : Fin 1 → R_node := fun _ => MvPolynomial.X (0 : Fin 2)
    let g1_f : Fin 1 → R_node := fun _ => MvPolynomial.X (1 : Fin 2)
    let j₀ : P₁ →+* R_node := MvPolynomial.eval₂Hom MvPolynomial.C g0_f
    let j₁ : P₁ →+* R_node := MvPolynomial.eval₂Hom MvPolynomial.C g1_f
    have hj0_X : j₀ T = MvPolynomial.X (0 : Fin 2) :=
      MvPolynomial.eval₂Hom_X' MvPolynomial.C g0_f 0
    have hj0_C : ∀ c, j₀ (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C g0_f c
    have hj1_X : j₁ T = MvPolynomial.X (1 : Fin 2) :=
      MvPolynomial.eval₂Hom_X' MvPolynomial.C g1_f 0
    have hj1_C : ∀ c, j₁ (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C g1_f c
    let ev₁₀ : R_node →+* R_node := j₀.comp π0_raw
    let ev₀₁ : R_node →+* R_node := j₁.comp π1_raw
    let I_X1 : Ideal R_node := Ideal.span ({MvPolynomial.X (1 : Fin 2)} : Set R_node)
    let I_X0 : Ideal R_node := Ideal.span ({MvPolynomial.X (0 : Fin 2)} : Set R_node)
    have hmk₁ : (Ideal.Quotient.mk I_X1).comp ev₁₀ = Ideal.Quotient.mk I_X1 := by
