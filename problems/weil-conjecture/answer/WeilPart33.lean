    have hev₀₁_f : ev₀₁ f = 0 := by
      change j₁ (π1_raw f) = 0
      rw [hf₁, map_zero]
    have hev₀₁_X₁ : ev₀₁ (MvPolynomial.X (1 : Fin 2)) = MvPolynomial.X (1 : Fin 2) := by
      change j₁ (π1_raw (MvPolynomial.X 1)) = MvPolynomial.X 1
      rw [hπ1_X]
      exact hj1_X
    rw [hg, map_mul, hev₀₁_X₁] at hev₀₁_f
    have hX₁_ne : (MvPolynomial.X (1 : Fin 2) : R_node) ≠ 0 :=
