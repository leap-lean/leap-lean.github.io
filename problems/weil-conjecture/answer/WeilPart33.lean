            ((toSheafify Z.smallEtaleTopology P_const_Z).app
            (Opposite.op (B.obj V₁))) z_Z := by
          have hzero_rhs : ((toSheafify Z.smallEtaleTopology P_const_Z).app
              (Opposite.op (B.obj V₁))) z_Z = 0 := map_zero _
          have h_lhs1 : ((toSheafify Z.smallEtaleTopology P_const_Z).app
              (Opposite.op (B.obj V₁))) r_Z = (ηZ_app (B.obj V₁)) r_val :=
