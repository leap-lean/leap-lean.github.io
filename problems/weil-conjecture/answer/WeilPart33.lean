        ((CategoryTheory.Category.assoc (iso_Z C f hf).inv (iso_Z C f hf).hom V_C.hom).symm.trans
          ((congrArg (fun m => CategoryTheory.CategoryStruct.comp m V_C.hom)
            (iso_Z C f hf).inv_hom_id).trans
            (CategoryTheory.Category.id_comp V_C.hom)))
