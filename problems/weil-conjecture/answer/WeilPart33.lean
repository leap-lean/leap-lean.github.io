    have ht_int : IsIntegral R_loc (t ⊗ₜ[B₂] (1 : R_loc)) := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.C (algebraMap B₂ R_loc (mk_B2 (MvPolynomial.X 1))),
        Polynomial.monic_X_pow_sub_C _ (by decide), ?_⟩
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      change (t ⊗ₜ[B₂] (1 : R_loc)) ^ 2 -
