            rw [hθ_qk_spec, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_Bk) := by
            rw [heBk_ρ, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]

    obtain ⟨L_eB, hLE_eB, hFD_eB, hSpread_eB⟩ :=
      s4_spread_out_spec_colimit_morphism L_alg hLE_alg B₀ B_bar p_B₀ hpB₀
        (R'_k α) ρ_Rk R'_fam ρ_R ι_R_fam @τ_R hρ_R_ι
        (fun h₁ h₂ h₁₂ => (h_s3_4 h₁ h₂ h₁₂).1) hInj_R hPush_R hExhaust_R (e_Bk α) heBk_ρ
    obtain ⟨L_eY, hLE_eY, hFD_eY, hSpread_eY⟩ :=
      s4_spread_out_spec_colimit_morphism L_alg hLE_alg Y₀ Y_bar p_Y₀ hpY₀
        (B'_k α) ρ_Bk B'_fam ρ_B ι_B_fam @τ_B hρ_B_ι
        (fun h₁ h₂ h₁₂ => (h_s3_4 h₁ h₂ h₁₂).2.2.1) hInj_B hPush_B hExhaust_B (e_Yk α) heYk_ρ

    have : FiniteDimensional F ↥L_eB := hFD_eB
    have : FiniteDimensional F ↥L_eY := hFD_eY
    let L_α : IntermediateField F k := L_eB ⊔ L_eY
    have hLE_α : L₀ ≤ L_α := hLE_alg.trans (hLE_eB.trans le_sup_left)
    have hFD_α : FiniteDimensional F ↥L_α := IntermediateField.finiteDimensional_sup L_eB L_eY

    refine ⟨L_α, hLE_α, hFD_α, ?_⟩
    intro L hL_α
    let _ : Algebra ↥L₀ ↥L :=
      (IntermediateField.inclusion (hLE_α.trans hL_α)).toRingHom.toAlgebra
    intro B_L Y_L g_L q_B q_Y p_BL p_YL hqB hqY hq_g hpBL hpYL hpB_comp hpY_comp

    have hL_eB : L_eB ≤ L := le_sup_left.trans hL_α
    have hL_eY : L_eY ≤ L := le_sup_right.trans hL_α
    let hL_alg : L_alg ≤ L := hLE_eB.trans hL_eB

    obtain ⟨e_BL, heBL_ρ, hpR_eBL⟩ := hSpread_eB L hL_eB B_L q_B p_BL hqB hpBL hpB_comp
    obtain ⟨e_YL, heYL_ρ, hpB_eYL⟩ := hSpread_eY L hL_eY Y_L q_Y p_YL hqY hpYL hpY_comp

    let R'_L := R'_fam L hL_alg
    let B'_L := B'_fam L hL_alg
    let h_L := h_fam L hL_alg
    let ψ_BL := ψ_fam L hL_alg
    let q_L : AlgebraicGeometry.Spec B'_L ⟶ weilOdpModelSpec m R'_L h_L :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_q_fam L hL_alg))
    let ι_R := ι_R_fam L hL_alg
    let ι_B := ι_B_fam L hL_alg
    let p_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)
    let p_B := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
    let p_Q := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_Q_fam L hL_alg))
    let p_Poly := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (MvPolynomial.map (algebraMap ↥L k) :
        MvPolynomial (Fin d_B) ↥L →+* MvPolynomial (Fin d_B) k))
    let s_Lk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L k))

    obtain ⟨hDescPb, hDescPush⟩ := s2c_field_descent ↥L k (algebraMap ↥L k)
    obtain ⟨_, hSurj_pR, _⟩ := hDescPush (CommRingCat.ofHom ι_R) (hPush_R L hL_alg)
    obtain ⟨_, _, hEpi_pB⟩ := hDescPush (CommRingCat.ofHom ι_B) (hPush_B L hL_alg)
    have : CategoryTheory.Epi p_B := hEpi_pB

    have hEt_ψL : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BL)) := by
      have hp_Poly : CategoryTheory.IsPullback p_Poly _ _ s_Lk :=
        (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
          (s2a_pushout_mvPoly (algebraMap ↥L k) (Fin d_B))).flip
      have hSq_ψ := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (h_s3_5 L hL_alg).1
      exact (hDescPb p_Poly hp_Poly).2.2 hSq_ψ hEt_ψk

    have hEt_qL : AlgebraicGeometry.Etale q_L := by
      have hp_Q : CategoryTheory.IsPullback p_Q _ _ s_Lk :=
        (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPush_Q L hL_alg)).flip
      have hSq_q := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (h_s3_5 L hL_alg).2.2
      change CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_qk)) p_B p_Q q_L at hSq_q
      rw [hθ_qk_spec] at hSq_q
      exact (hDescPb p_Q hp_Q).2.2 hSq_q hEt_qk

    have hEt_eBL : AlgebraicGeometry.Etale e_BL := by
      have hOuter_B := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPush_R L hL_alg)
      rw [← heBk_ρ, ← heBL_ρ] at hOuter_B
      have hSq_eB : CategoryTheory.IsPullback (e_Bk α) p_R p_BL e_BL :=
        CategoryTheory.IsPullback.of_right hOuter_B hpR_eBL.symm hpBL.flip
      exact (hDescPb p_BL hpBL).2.2 hSq_eB hEt_eBk

    have hEt_eYL : AlgebraicGeometry.Etale e_YL := by
      have hOuter_Y := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPush_B L hL_alg)
      rw [← heYk_ρ, ← heYL_ρ] at hOuter_Y
      have hSq_eY : CategoryTheory.IsPullback (e_Yk α) p_B p_YL e_YL :=
        CategoryTheory.IsPullback.of_right hOuter_Y hpB_eYL.symm hpYL.flip
      exact (hDescPb p_YL hpYL).2.2 hSq_eY hEt_eYk

    have heBL_hom : e_BL ≫ B_L.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BL) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      rw [heBL_ρ, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

    have hq_comm_spec : p_B ≫ q_L = q_k α ≫ p_Q := by
      dsimp only [p_B, q_L, p_Q, ι_B]
      rw [← hθ_qk_spec, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, (h_s3_2 L hL_alg).2.2]

    have hcQ_comm_spec :
        p_Q ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_Q L hL_alg)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Qk) ≫ p_R := by
      dsimp only [p_Q, p_R, ι_R]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, (h_s3_2 L hL_alg).2.1]

    have hg_L_bar : p_YL ≫ g_L.left = g_bar.left ≫ p_BL := by
      have hqB' : CategoryTheory.IsPullback q_B B_L.hom B₀.hom _ := hqB
      have hpBL' : CategoryTheory.IsPullback p_BL B_bar.hom B_L.hom _ := hpBL
      have hpYL' : CategoryTheory.IsPullback p_YL Y_bar.hom Y_L.hom _ := hpYL
      apply hqB'.hom_ext
      · rw [CategoryTheory.Category.assoc, ← hq_g, ← CategoryTheory.Category.assoc, hpY_comp,
          hg₀, CategoryTheory.Category.assoc, hpB_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w g_L, hpYL'.w,
          CategoryTheory.Category.assoc, hpBL'.w, ← CategoryTheory.Category.assoc,
          CategoryTheory.Over.w g_bar]

    have heYL_gL : e_YL ≫ g_L.left =
        q_L ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_BL := by
      apply (CategoryTheory.cancel_epi p_B).mp
      calc
        p_B ≫ e_YL ≫ g_L.left
          = (p_B ≫ e_YL) ≫ g_L.left := (CategoryTheory.Category.assoc _ _ _).symm
        _ = e_Yk α ≫ (p_YL ≫ g_L.left) := by rw [hpB_eYL, CategoryTheory.Category.assoc]
        _ = (e_Yk α ≫ g_bar.left) ≫ p_BL := by rw [hg_L_bar, CategoryTheory.Category.assoc]
        _ = (q_k α ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Qk) ≫ e_Bk α) ≫ p_BL := by
            rw [heYk_gbar]
        _ = q_k α ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Qk) ≫ p_R) ≫ e_BL := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hpR_eBL,
              CategoryTheory.Category.assoc]
        _ = (q_k α ≫ p_Q) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_Q L hL_alg)) ≫ e_BL := by
            rw [← hcQ_comm_spec, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = p_B ≫ q_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_Q L hL_alg)) ≫ e_BL := by
            rw [← hq_comm_spec, CategoryTheory.Category.assoc]

    refine ⟨R'_L, B'_L, h_L, ψ_BL, e_BL, e_YL, q_L, ι_R, ι_B,
      hEt_eBL, hEt_eYL, hEt_qL, (h_s3_1 L hL_alg).1, hEt_ψL, heBL_hom, heYL_gL,
      hSurj_pR, hpR_eBL, hpB_eYL, ?_, ?_⟩
    · intro u_bar
      let u_ps : _root_.PrimeSpectrum ↥(R'_k α) := u_bar
      change h_k α ∈ u_ps.asIdeal ↔ h_L ∈ (_root_.PrimeSpectrum.comap ι_R u_ps).asIdeal
      rw [_root_.PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, (h_s3_1 L hL_alg).2]
    · intro v_bar
      let w_ps : _root_.PrimeSpectrum (weilOdpModelRing (R'_k α) (h_k α)) := (q_k α).base v_bar
      have hw_mem : ∀ z : weilOdpModelRing R'_L h_L,
          z ∈ (q_L.base (p_B.base v_bar)).asIdeal ↔ ι_Q_fam L hL_alg z ∈ w_ps.asIdeal := by
        intro z
        have hq_pt : q_L.base (p_B.base v_bar) = p_Q.base ((q_k α).base v_bar) :=
          congrArg (fun f => f.base v_bar) hq_comm_spec
        rw [hq_pt]
        change z ∈ (_root_.PrimeSpectrum.comap (ι_Q_fam L hL_alg) w_ps).asIdeal ↔ _
        rw [_root_.PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      refine ⟨fun hX idx => ?_, fun hh => ?_⟩
      · rw [hw_mem, (h_s3_3 L hL_alg).1 idx]
        exact hX idx
      · rw [hw_mem, (h_s3_3 L hL_alg).2]
        exact hh

  
  choose L_α hLE_α hFD_α hSpec_α using hSingle
  let L₁ : IntermediateField F k := L₀ ⊔ ⨆ α : Idx, L_α α
  have hLE : L₀ ≤ L₁ := le_sup_left
  have hFD₁ : FiniteDimensional F ↥L₁ := by
    have : ∀ α : Idx, FiniteDimensional F ↥(L_α α) := hFD_α
    have : FiniteDimensional F ↥(⨆ α : Idx, L_α α) :=
      IntermediateField.finiteDimensional_iSup_of_finite
    exact IntermediateField.finiteDimensional_sup L₀ _

  refine ⟨L₁, hLE, hFD₁, ?_⟩
  intro L hL
  let _ : Algebra ↥L₀ ↥L := (IntermediateField.inclusion (hLE.trans hL)).toRingHom.toAlgebra
  intro B_L Y_L g_L q_B q_Y p_BL p_YL hqB hqY hq_g hpBL hpYL hpB_comp hpY_comp
  have hL_α : ∀ α : Idx, L_α α ≤ L :=
    fun α => (le_iSup L_α α).trans (le_sup_right.trans hL)
  choose R'_L B'_L h_L ψ_BL e_BL e_YL q_L ι_R ι_B hRoof_L using fun α : Idx =>
    hSpec_α α L (hL_α α) B_L Y_L g_L q_B q_Y p_BL p_YL hqB hqY hq_g hpBL hpYL hpB_comp hpY_comp
  exact ⟨R'_L, B'_L, h_L, ψ_BL, e_BL, e_YL, q_L, ι_R, ι_B, hRoof_L⟩

theorem weil_descent_lefschetz_pencil_from_algClosure (K : Type u) [Finite K] [Field K] (m : ℕ)
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z.hom]
    (P_bar : WeilAlgClosedProjectiveLefschetzPencil (AlgebraicClosure K) m
      (weilBaseChangeOver K (AlgebraicClosure K) Z)) :
    ∃ (K₁ : Type u) (_ : Finite K₁) (_ : Field K₁) (_ : Algebra K K₁)
      (_ : FiniteDimensional K K₁),
      Nonempty (WeilRationalLefschetzPencil K₁ m (weilBaseChangeOver K K₁ Z)) :=
by
  classical
  let k : Type u := AlgebraicClosure K
  let Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    weilBaseChangeOver K k Z
  let Q : WeilRationalLefschetzPencil k m Z_bar := P_bar.toPencil
  obtain ⟨hProjProper, hPolyProps, hPolyModel, hProjSpacePkg⟩ :=
    weil_canonical_and_projective_baseChange_models.{u}
  obtain ⟨π_P1, hProj_P1, hModel_P1, hComp_P1⟩ := hProjSpacePkg 1
  obtain ⟨π_P2, hProj_P2, hModel_P2, hComp_P2⟩ := hProjSpacePkg 2
  have hProperExtras : ∀ (E : Type u) [Field E]
      (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E))),
      AlgebraicGeometry.IsProper V.hom →
      CompactSpace ↥V.left ∧
      AlgebraicGeometry.IsSeparated V.hom ∧
      AlgebraicGeometry.LocallyOfFiniteType V.hom := by
    intro E _ V hProp
    exact ⟨AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace V.hom,
      inferInstance, inferInstance⟩
  have hSpecProps : ∀ (E : Type u) [Field E],
      CompactSpace ↥(weilSpecFieldOver E).left ∧
      AlgebraicGeometry.IsSeparated (weilSpecFieldOver E).hom ∧
      AlgebraicGeometry.LocallyOfFiniteType (weilSpecFieldOver E).hom := by
    intro E _
    have hProp : AlgebraicGeometry.IsProper (weilSpecFieldOver E).hom := by
      change AlgebraicGeometry.IsProper (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of E)))
      infer_instance
    exact hProperExtras E (weilSpecFieldOver E) hProp
  have hSpecModel : ∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
      IsFieldPullbackModel E₀ E₁ (weilSpecFieldOver E₀) (weilSpecFieldOver E₁)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))) := by
    intro E₀ E₁ _ _ _
    dsimp only [IsFieldPullbackModel, weilSpecFieldOver, CategoryTheory.Over.mk_left,
      CategoryTheory.Over.mk_hom]
    exact CategoryTheory.IsPullback.of_vert_isIso
      ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
  have hZBaseModel : ∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁]
      [Algebra K E₀] [Algebra K E₁] [Algebra E₀ E₁] [IsScalarTower K E₀ E₁],
      AlgebraicGeometry.IsProper (weilBaseChangeOver K E₀ Z).hom ∧
      IsFieldPullbackModel E₀ E₁ (weilBaseChangeOver K E₀ Z) (weilBaseChangeOver K E₁ Z)
        (weilBaseChangeMap K E₀ E₁ Z) := by
    intro E₀ E₁ _ _ _ _ _ _
    have hPropE₀ : AlgebraicGeometry.IsProper (weilBaseChangeOver K E₀ Z).hom := by
      change AlgebraicGeometry.IsProper
        (CategoryTheory.Limits.pullback.snd Z.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₀))))
      infer_instance
    refine ⟨hPropE₀, ?_⟩
    dsimp only [IsFieldPullbackModel, weilBaseChangeMap, weilBaseChangeOver,
      CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
    let s_E₀E₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))
    have hs : s_E₀E₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₀)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₁)) := by
      dsimp [s_E₀E₁]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq K E₀ E₁]
    have hOuter : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst Z.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₁))))
          (CategoryTheory.Limits.pullback.snd Z.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₁))) ≫ s_E₀E₁)
          (by rw [CategoryTheory.Category.assoc, hs]; exact CategoryTheory.Limits.pullback.condition) ≫
          CategoryTheory.Limits.pullback.fst Z.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₀))))
        (CategoryTheory.Limits.pullback.snd Z.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₁))))
        Z.hom
        (s_E₀E₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₀))) := by
      rw [CategoryTheory.Limits.pullback.lift_fst, hs]
      exact CategoryTheory.IsPullback.of_hasPullback Z.hom _
    exact CategoryTheory.IsPullback.of_right hOuter
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback Z.hom _)
  have hZBaseComp : ∀ (E₀ E₁ E₂ : Type u) [Field E₀] [Field E₁] [Field E₂]
      [Algebra K E₀] [Algebra K E₁] [Algebra K E₂]
      [Algebra E₀ E₁] [Algebra E₁ E₂] [Algebra E₀ E₂]
      [IsScalarTower K E₀ E₁] [IsScalarTower K E₁ E₂]
      [IsScalarTower K E₀ E₂] [IsScalarTower E₀ E₁ E₂],
      weilBaseChangeMap K E₁ E₂ Z ≫ weilBaseChangeMap K E₀ E₁ Z =
        weilBaseChangeMap K E₀ E₂ Z := by
    intro E₀ E₁ E₂ _ _ _ _ _ _ _ _ _ _ _ _ _
    dsimp only [weilBaseChangeMap, weilBaseChangeOver, CategoryTheory.Over.mk_left]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq E₀ E₁ E₂]
  have hTransportProjModel : ∀ (L_W L_tgt : IntermediateField K k) (hLE : L_W ≤ L_tgt)
      (Y_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L_W)))
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p_W : W.left ⟶ Y_W.left),
      IsProjectiveOverField ↥L_W Y_W →
      IsFieldPullbackModel ↥L_W k Y_W W p_W →
      letI : Algebra ↥L_W ↥L_tgt := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
      IsProjectiveOverField ↥L_tgt (weilBaseChangeOver ↥L_W ↥L_tgt Y_W) ∧
      ∃ (p_tgt : W.left ⟶ (weilBaseChangeOver ↥L_W ↥L_tgt Y_W).left),
        IsFieldPullbackModel ↥L_tgt k (weilBaseChangeOver ↥L_W ↥L_tgt Y_W) W p_tgt ∧
        p_tgt ≫ CategoryTheory.Limits.pullback.fst Y_W.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W ↥L_tgt))) = p_W := by
    intro L_W L_tgt hLE Y_W W p_W hProjW hpW
    letI : Algebra ↥L_W ↥L_tgt := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    haveI : IsScalarTower ↥L_W ↥L_tgt k := IsScalarTower.of_algebraMap_eq' rfl
    refine ⟨weil_isProjectiveOverField_baseChange ↥L_W ↥L_tgt Y_W hProjW, ?_⟩
    dsimp only [IsFieldPullbackModel, weilBaseChangeOver, CategoryTheory.Over.mk_left,
      CategoryTheory.Over.mk_hom] at hpW ⊢
    let s_Wt := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W ↥L_tgt))
    let s_tk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_tgt k))
    have hs : s_tk ≫ s_Wt =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W k)) := by
      dsimp [s_Wt, s_tk]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq ↥L_W ↥L_tgt k]
    have hcomm : p_W ≫ Y_W.hom = (W.hom ≫ s_tk) ≫ s_Wt := by
      rw [CategoryTheory.Category.assoc, hs]
      exact hpW.w
    let p_tgt : W.left ⟶ CategoryTheory.Limits.pullback Y_W.hom s_Wt :=
      CategoryTheory.Limits.pullback.lift p_W (W.hom ≫ s_tk) hcomm
    have hOuter : CategoryTheory.IsPullback
        (p_tgt ≫ CategoryTheory.Limits.pullback.fst Y_W.hom s_Wt)
        W.hom Y_W.hom (s_tk ≫ s_Wt) := by
      dsimp [p_tgt]
      rw [CategoryTheory.Limits.pullback.lift_fst, hs]
      exact hpW
    exact ⟨p_tgt,
      CategoryTheory.IsPullback.of_right hOuter
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback Y_W.hom s_Wt),
      CategoryTheory.Limits.pullback.lift_fst _ _ _⟩
  have hIsoModelSwap : ∀ {E₀ E₁ : Type u} [Field E₀] [Field E₁]
      [Algebra E₀ E₁] [Algebra E₀ k] [Algebra E₁ k] [IsScalarTower E₀ E₁ k]
      (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₀)))
      (Y₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₁)))
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (q₀₁ : Y₁.left ⟶ Y₀.left) (p₀ : W.left ⟶ Y₀.left)
      (p₁ : W.left ⟶ Y₁.left)
      (p₁' : W.left ⟶ (weilBaseChangeOver E₀ E₁ Y₀).left),
      IsFieldPullbackModel E₀ E₁ Y₀ Y₁ q₀₁ →
      IsFieldPullbackModel E₁ k Y₁ W p₁ →
      IsFieldPullbackModel E₁ k (weilBaseChangeOver E₀ E₁ Y₀) W p₁' →
      p₁ ≫ q₀₁ = p₀ →
      p₁' ≫ CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))) = p₀ →
      ∃ e : Y₁ ≅ weilBaseChangeOver E₀ E₁ Y₀,
        p₁ ≫ e.hom.left = p₁' ∧ p₁' ≫ e.inv.left = p₁ := by
    intro E₀ E₁ _ _ _ _ _ _ Y₀ Y₁ W q₀₁ p₀ p₁ p₁' hq₀₁ hp₁ hp₁' hcomp₁ hcomp₁'
    have hq₀₁' : CategoryTheory.IsPullback q₀₁ Y₁.hom Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))) := hq₀₁
    let e : Y₁ ≅ weilBaseChangeOver E₀ E₁ Y₀ :=
      CategoryTheory.Over.isoMk hq₀₁'.isoPullback hq₀₁'.isoPullback_hom_snd
    have he_left : e.hom.left = hq₀₁'.isoPullback.hom := rfl
    have he_hom : p₁ ≫ e.hom.left = p₁' := by
      rw [he_left]
      have hp₁_w : p₁ ≫ Y₁.hom =
          W.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k)) := hp₁.w
      have hp₁'_w : p₁' ≫ (weilBaseChangeOver E₀ E₁ Y₀).hom =
          W.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k)) := hp₁'.w
      revert p₁' hp₁' hp₁'_w hcomp₁'
      dsimp only [IsFieldPullbackModel, weilBaseChangeOver,
        CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
      intro p₁' _ hcomp₁' hp₁'_w
      apply CategoryTheory.Limits.pullback.hom_ext
