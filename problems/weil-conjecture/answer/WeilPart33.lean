    have hδ_slice_eq : δ_slice = MvPolynomial.rename inl_var g_i0 := by
      dsimp [δ_slice, g_i0]
      rw [mul_one, hΔ_slice]
    have hev_bar_δ : bar_ev bar_δslice = bar_g := by
      dsimp [bar_δslice, bar_g]
      rw [hδ_slice_eq]
