      · intro F hF
        have hπ0 : π_quot (Ψ_0 F) = 0 := hF
        rw [← RingHom.mem_ker, hKer_π, ← hΨ0_Φ, Ideal.mem_span_singleton'] at hπ0
        rcases hπ0 with ⟨z, hz⟩
        obtain ⟨Z, rfl⟩ := hSurj_Ψ0 z
        have hsub_ker : F - Z * Φ_poly ∈ RingHom.ker Ψ_0 := by
          rw [RingHom.mem_ker, map_sub, map_mul, hz, sub_self]
        rw [hKer_Ψ0] at hsub_ker
        have hq_sub : Ideal.span (Set.range fun a : Fin s => ι_RP (q a)) ≤
