        (hRingDim φ_B.hom hInj_φB hInt_φB).trans hRingDim_A₁
      have hDim_Y' : topologicalKrullDim Y' = ((1 : ℕ) : WithBot ℕ∞) := by
        have h1 : topologicalKrullDim Y' = topologicalKrullDim (AlgebraicGeometry.Spec B'_cat) :=
          (AlgebraicGeometry.Scheme.homeoOfIso e_Y').isHomeomorph.topologicalKrullDim_eq
        exact h1.trans ((PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim B').trans hRingDim_B')

      have hW'_drop : ∀ (W' : AlgebraicGeometry.Scheme.{u}) (iW' : W' ⟶ Y'),
          AlgebraicGeometry.IsClosedImmersion iW' →
          ¬ CategoryTheory.IsIso iW' →
          topologicalKrullDim W' ≤ (0 : WithBot ℕ∞) := by
        intro W' iW' hClW' hNotIsoW'
        have : AlgebraicGeometry.IsClosedImmersion iW' := hClW'
        have hRange_ne : Set.range ⇑iW'.base ≠ Set.univ := by
          intro hUniv
          have : AlgebraicGeometry.Surjective iW' := ⟨Set.range_eq_univ.mp hUniv⟩
          exact hNotIsoW' (AlgebraicGeometry.isIso_of_isClosedImmersion_of_surjective iW')
        exact hKrullDrop ↥Y' hDim_Y' ↥W' ⇑iW'.base iW'.isClosedEmbedding hRange_ne

      let _ : Algebra (MvPolynomial (Fin 1) k) B' := φ_B.hom.toAlgebra
      let _ : Algebra k B' := (φ_B.hom.comp (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k)).toAlgebra
      have : IsScalarTower k (MvPolynomial (Fin 1) k) B' := IsScalarTower.of_algebraMap_eq' rfl
      have : Module.Finite (MvPolynomial (Fin 1) k) B' := hFin_φB
      have : Algebra.FiniteType (MvPolynomial (Fin 1) k) B' := inferInstance
      have : Algebra.FiniteType k B' :=
        Algebra.FiniteType.trans (S := MvPolynomial (Fin 1) k) inferInstance inferInstance

      obtain ⟨V_cl, U_cl, e_cl₀, hInt_Vcl, hProj_Vcl, hDim_Vcl_eq, hAff_Ucl, hNe_Ucl, he_cl₀_hom, _⟩ :=
        weil_finiteType_domain_projective_schematic_closure k B' hStdChart
      have hDim_Vcl : topologicalKrullDim V_cl.left = ((1 : ℕ) : WithBot ℕ∞) :=
        hDim_Vcl_eq.trans hRingDim_B'

      obtain ⟨C_bar, ν_cl, U_ν, hInt_Cbar, hFin_νcl, _, hSurj_νcl, hNe_Uν, hIso_Uν, hNormCov⟩ :=
        weil_algClosed_scheme_normalization_finite_birational k V_cl hInt_Vcl hProj_Vcl
          (fun A _ _ _ _ K _ _ _ => weil_algClosed_finiteType_domain_integralClosure_finite k A K)
      have : AlgebraicGeometry.IsIntegral C_bar.left := hInt_Cbar
      have : AlgebraicGeometry.IsFinite ν_cl.left := hFin_νcl
      have : AlgebraicGeometry.Surjective ν_cl.left := hSurj_νcl
      have : CategoryTheory.IsIso (ν_cl.left ∣_ U_ν) := hIso_Uν

      obtain ⟨hProj_Cbar, hDim_Cbar_eq⟩ :=
        weil_isFinite_projective_and_krullDim_over_field k ν_cl
          hInt_Cbar hInt_Vcl hProj_Vcl hFin_νcl hSurj_νcl
      have hDim_Cbar : topologicalKrullDim C_bar.left = ((1 : ℕ) : WithBot ℕ∞) :=
        hDim_Cbar_eq.trans hDim_Vcl

      obtain ⟨W_reg, hSm_Wreg, hDim_Sing⟩ :=
        weil_affineNormal_scheme_codim2_smooth_open k 0 C_bar
          hInt_Cbar hProj_Cbar hDim_Cbar hNormCov
          (fun d₀ A _ _ _ _ _ hDimA p _ hp =>
            weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k d₀ A hDimA p hp)
      have hWreg_top : W_reg = ⊤ := by
        by_contra hne_top
        have hCompl_ne : ((W_reg : Set ↥C_bar.left)ᶜ).Nonempty := by
          by_contra hemp
          rw [Set.not_nonempty_iff_eq_empty, Set.compl_empty_iff] at hemp
          exact hne_top (TopologicalSpace.Opens.ext hemp)
        obtain ⟨z₀, hz₀⟩ := hCompl_ne
        let K₀ : TopologicalSpace.IrreducibleCloseds ↥((W_reg : Set ↥C_bar.left)ᶜ) :=
          ⟨closure ({⟨z₀, hz₀⟩} : Set ↥((W_reg : Set ↥C_bar.left)ᶜ)),
            (isIrreducible_singleton (x := (⟨z₀, hz₀⟩ : ↥((W_reg : Set ↥C_bar.left)ᶜ)))).closure,
            isClosed_closure⟩
        let l₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥((W_reg : Set ↥C_bar.left)ᶜ)) :=
          RelSeries.singleton _ K₀
        have h0_le : ((0 : ℕ) : WithBot ℕ∞) ≤
            topologicalKrullDim ↥((W_reg : Set ↥C_bar.left)ᶜ) :=
          Order.LTSeries.length_le_krullDim l₀
        have h2_le : ((0 : ℕ) : WithBot ℕ∞) + 2 ≤ ((1 : ℕ) : WithBot ℕ∞) :=
          (add_le_add h0_le le_rfl).trans hDim_Sing
        norm_cast at h2_le
      have hIso_Wreg_ι : CategoryTheory.IsIso W_reg.ι := by
        rw [hWreg_top]
        exact (inferInstance : CategoryTheory.IsIso (C_bar.left.topIso).hom)
      have : CategoryTheory.IsIso W_reg.ι := hIso_Wreg_ι
      have hSm_Cbar : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom := by
        have h_eq : C_bar.hom = CategoryTheory.inv W_reg.ι ≫ (W_reg.ι ≫ C_bar.hom) := by
          rw [CategoryTheory.IsIso.inv_hom_id_assoc]
        rw [h_eq]
        have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_reg.ι ≫ C_bar.hom) := hSm_Wreg
        have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
            (CategoryTheory.inv W_reg.ι ≫ (W_reg.ι ≫ C_bar.hom)) := inferInstance
        simpa using h01

      let W_aff : C_bar.left.Opens := ν_cl.left ⁻¹ᵁ U_cl
      have hAff_Waff : AlgebraicGeometry.IsAffineOpen W_aff := hAff_Ucl.preimage ν_cl.left
      obtain ⟨u_cl_pt⟩ := hNe_Ucl
      obtain ⟨w_pt, hw_pt⟩ := ν_cl.left.surjective u_cl_pt.1
      have hNe_Waff : Nonempty ↥W_aff :=
        ⟨⟨w_pt, by change ν_cl.left.base w_pt ∈ U_cl; rw [hw_pt]; exact u_cl_pt.2⟩⟩

      let e_cl : Y' ≅ U_cl.toScheme := e_Y' ≪≫ e_cl₀
      let π_norm : W_aff.toScheme ⟶ Y' := (ν_cl.left ∣_ U_cl) ≫ e_cl.inv
      have hFin_π : AlgebraicGeometry.IsFinite π_norm := by
        dsimp [π_norm]; infer_instance

      have hBase_Y' : e_Y'.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B')) =
          (ν ≫ iY₀) ≫ A₁.hom := by
        have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B')) =
            g_spec ≫ A₁.hom := by
          dsimp [A₁, weilAffineSpaceOver]
          rw [← hmap_φB, ← AlgebraicGeometry.Spec.map_comp]
          rfl
        rw [h1]
        calc e_Y'.hom ≫ (g_spec ≫ A₁.hom)
            = (e_Y'.hom ≫ e_Y'.inv) ≫ ((ν ≫ iY₀) ≫ A₁.hom) := by
                change e_Y'.hom ≫ ((e_Y'.inv ≫ (ν ≫ iY₀)) ≫ A₁.hom) = _
                simp only [CategoryTheory.Category.assoc]
          _ = (ν ≫ iY₀) ≫ A₁.hom := by
                rw [e_Y'.hom_inv_id, CategoryTheory.Category.id_comp]
      have hComm_π : π_norm ≫ ((ν ≫ iY₀) ≫ A₁.hom) = W_aff.ι ≫ C_bar.hom := by
        calc π_norm ≫ ((ν ≫ iY₀) ≫ A₁.hom)
            = (ν_cl.left ∣_ U_cl) ≫ e_cl₀.inv ≫ e_Y'.inv ≫
                (e_Y'.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B'))) := by
                rw [hBase_Y']
                dsimp [π_norm, e_cl]
                simp only [CategoryTheory.Category.assoc]
          _ = (ν_cl.left ∣_ U_cl) ≫ e_cl₀.inv ≫
                (e_cl₀.hom ≫ (U_cl.ι ≫ V_cl.hom)) := by
                rw [CategoryTheory.Iso.inv_hom_id_assoc, he_cl₀_hom]
          _ = ((ν_cl.left ∣_ U_cl) ≫ U_cl.ι) ≫ V_cl.hom := by
                rw [CategoryTheory.Iso.inv_hom_id_assoc, CategoryTheory.Category.assoc]
          _ = (W_aff.ι ≫ ν_cl.left) ≫ V_cl.hom := by
                rw [AlgebraicGeometry.morphismRestrict_ι ν_cl.left U_cl]
          _ = W_aff.ι ≫ C_bar.hom := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ν_cl]

      have : IrreducibleSpace ↥V_cl.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral V_cl.left
      obtain ⟨u_ν_pt⟩ := hNe_Uν
      have hInter_ne : ((U_cl : Set ↥V_cl.left) ∩ (U_ν : Set ↥V_cl.left)).Nonempty :=
        (IrreducibleSpace.isIrreducible_univ ↥V_cl.left).2
          (U_cl : Set ↥V_cl.left) (U_ν : Set ↥V_cl.left) U_cl.isOpen U_ν.isOpen
          ⟨u_cl_pt.1, trivial, u_cl_pt.2⟩ ⟨u_ν_pt.1, trivial, u_ν_pt.2⟩ |>
          fun ⟨x, _, hx1, hx2⟩ => ⟨x, hx1, hx2⟩
      let U_inter : V_cl.left.Opens := U_cl ⊓ U_ν
      let C_Y : Y'.Opens := (e_cl.hom ≫ U_cl.ι) ⁻¹ᵁ U_inter
      obtain ⟨v_int, hv_cl, hv_ν⟩ := hInter_ne
      have hNe_CY : Nonempty ↥C_Y := by
        refine ⟨⟨e_cl.inv.base ⟨v_int, hv_cl⟩, ?_⟩⟩
        change U_cl.ι.base ((e_cl.inv ≫ e_cl.hom).base ⟨v_int, hv_cl⟩) ∈ U_inter
        rw [e_cl.inv_hom_id]
        exact ⟨hv_cl, hv_ν⟩

      have hPb_π : CategoryTheory.IsPullback (π_norm ∣_ C_Y) (π_norm ⁻¹ᵁ C_Y).ι C_Y.ι π_norm :=
        AlgebraicGeometry.isPullback_morphismRestrict π_norm C_Y
      have hPb_νUcl : CategoryTheory.IsPullback (ν_cl.left ∣_ U_cl) W_aff.ι U_cl.ι ν_cl.left :=
        AlgebraicGeometry.isPullback_morphismRestrict ν_cl.left U_cl
      have hPb_νUν : CategoryTheory.IsPullback (ν_cl.left ∣_ U_ν) (ν_cl.left ⁻¹ᵁ U_ν).ι U_ν.ι ν_cl.left :=
        AlgebraicGeometry.isPullback_morphismRestrict ν_cl.left U_ν
      have hPb_comp : CategoryTheory.IsPullback π_norm W_aff.ι (e_cl.hom ≫ U_cl.ι) ν_cl.left := by
        have hSq_top : CategoryTheory.IsPullback π_norm (𝟙 W_aff.toScheme)
            e_cl.hom (ν_cl.left ∣_ U_cl) :=
          { w := by
              dsimp [π_norm]
              rw [CategoryTheory.Category.assoc, e_cl.inv_hom_id,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
              (fun s => s.snd)
              (fun s => by
                rw [← CategoryTheory.cancel_mono e_cl.hom]
                dsimp [π_norm]
                rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                  e_cl.inv_hom_id, CategoryTheory.Category.comp_id]
                exact s.condition.symm)
              (fun s => CategoryTheory.Category.comp_id s.snd)
              (fun s m _ hm₂ => by rw [← hm₂, CategoryTheory.Category.comp_id])⟩ }
        have hPasted := hSq_top.paste_vert hPb_νUcl
        rwa [CategoryTheory.Category.id_comp] at hPasted
      have hPb_outer : CategoryTheory.IsPullback (π_norm ∣_ C_Y)
          ((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι) (C_Y.ι ≫ e_cl.hom ≫ U_cl.ι) ν_cl.left :=
        hPb_π.paste_vert hPb_comp
      have hRange_CY_Uν : Set.range (C_Y.ι ≫ e_cl.hom ≫ U_cl.ι).base ⊆ Set.range U_ν.ι.base := by
        rintro _ ⟨y, rfl⟩
        exact ⟨⟨(C_Y.ι ≫ e_cl.hom ≫ U_cl.ι).base y, y.2.2⟩, rfl⟩
      let g_CY_ν : C_Y.toScheme ⟶ U_ν.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_ν.ι (C_Y.ι ≫ e_cl.hom ≫ U_cl.ι) hRange_CY_Uν
      have hg_CY_ν : g_CY_ν ≫ U_ν.ι = C_Y.ι ≫ e_cl.hom ≫ U_cl.ι :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_ν.ι (C_Y.ι ≫ e_cl.hom ≫ U_cl.ι) hRange_CY_Uν
      have hRange_VU_Uν : Set.range ((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι).base ⊆
          Set.range (ν_cl.left ⁻¹ᵁ U_ν).ι.base := by
        rintro _ ⟨w, rfl⟩
        have hw_eq : (((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι) ≫ ν_cl.left).base w =
            ((π_norm ∣_ C_Y) ≫ C_Y.ι ≫ e_cl.hom ≫ U_cl.ι).base w :=
          congrArg (fun f => f.base w) hPb_outer.w.symm
        have hw_mem : ν_cl.left.base (((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι).base w) ∈ U_ν := by
          change (((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι) ≫ ν_cl.left).base w ∈ U_ν
          rw [hw_eq]
          exact ((π_norm ∣_ C_Y).base w).2.2
        exact ⟨⟨((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι).base w, hw_mem⟩, rfl⟩
      let g_VU_ν : (π_norm ⁻¹ᵁ C_Y).toScheme ⟶ (ν_cl.left ⁻¹ᵁ U_ν).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (ν_cl.left ⁻¹ᵁ U_ν).ι
          ((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι) hRange_VU_Uν
      have hg_VU_ν : g_VU_ν ≫ (ν_cl.left ⁻¹ᵁ U_ν).ι = (π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (ν_cl.left ⁻¹ᵁ U_ν).ι
          ((π_norm ⁻¹ᵁ C_Y).ι ≫ W_aff.ι) hRange_VU_Uν
      have hComm_top : (π_norm ∣_ C_Y) ≫ g_CY_ν = g_VU_ν ≫ (ν_cl.left ∣_ U_ν) := by
        rw [← CategoryTheory.cancel_mono U_ν.ι, CategoryTheory.Category.assoc, hg_CY_ν,
          CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι ν_cl.left U_ν,
          ← CategoryTheory.Category.assoc g_VU_ν, hg_VU_ν]
        exact hPb_outer.w
      have hPb_outer' : CategoryTheory.IsPullback (π_norm ∣_ C_Y)
          (g_VU_ν ≫ (ν_cl.left ⁻¹ᵁ U_ν).ι) (g_CY_ν ≫ U_ν.ι) ν_cl.left := by
        rwa [hg_VU_ν, hg_CY_ν]
      have hPb_top : CategoryTheory.IsPullback (π_norm ∣_ C_Y) g_VU_ν g_CY_ν (ν_cl.left ∣_ U_ν) :=
        CategoryTheory.IsPullback.of_bot hPb_outer' hComm_top hPb_νUν
      have hIso_π_CY : CategoryTheory.IsIso (π_norm ∣_ C_Y) := hPb_top.isIso_fst_of_isIso
      have : CategoryTheory.IsIso (π_norm ∣_ C_Y) := hIso_π_CY

      let I_Y := weilAltClosedComplIdeal Y' C_Y
      let C_compl_Y : TopologicalSpace.Closeds ↥Y' := ⟨(C_Y : Set ↥Y')ᶜ, C_Y.isOpen.isClosed_compl⟩
      have hRange_IY : Set.range ⇑I_Y.subschemeι.base = (C_Y : Set ↥Y')ᶜ :=
        (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_compl_Y)).trans
          (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C_compl_Y)
      let c_y_pt : ↥C_Y := Classical.choice hNe_CY
      have hNe_IY : Set.range ⇑I_Y.subschemeι.base ≠ Set.univ := by
        rw [hRange_IY]
        intro hUniv
        have : c_y_pt.1 ∈ (C_Y : Set ↥Y')ᶜ := hUniv ▸ Set.mem_univ _
        exact this c_y_pt.2
      have hDim_ZY : topologicalKrullDim I_Y.subscheme ≤ (0 : WithBot ℕ∞) :=
        hKrullDrop ↥Y' hDim_Y' _ ⇑I_Y.subschemeι.base I_Y.subschemeι.isClosedEmbedding hNe_IY

      have : Nonempty ↥W_aff.toScheme := hNe_Waff
      have hInt_Waff : AlgebraicGeometry.IsIntegral W_aff.toScheme :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion W_aff.ι
      have : AlgebraicGeometry.IsIntegral W_aff.toScheme := hInt_Waff
      have : IrreducibleSpace ↥W_aff.toScheme :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral W_aff.toScheme
      let W_ov_dim : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (W_aff.ι ≫ C_bar.hom)
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 W_ov_dim.hom := by
        have : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom := hSm_Cbar
        have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (W_aff.ι ≫ C_bar.hom) :=
          inferInstance
        change AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_aff.ι ≫ C_bar.hom)
        simpa using h01
      have hDim_Waff : topologicalKrullDim W_aff.toScheme = ((1 : ℕ) : WithBot ℕ∞) :=
        weil_smooth_integral_krullDim_over_field k 1 W_ov_dim hInt_Waff

      let V_U : W_aff.toScheme.Opens := π_norm ⁻¹ᵁ C_Y
      let v_u_pt : ↥V_U := (CategoryTheory.asIso (π_norm ∣_ C_Y)).inv.base c_y_pt
      let I_W := weilAltClosedComplIdeal W_aff.toScheme V_U
      let C_compl_W : TopologicalSpace.Closeds ↥W_aff.toScheme :=
        ⟨(V_U : Set ↥W_aff.toScheme)ᶜ, V_U.isOpen.isClosed_compl⟩
      have hRange_IW : Set.range ⇑I_W.subschemeι.base = (V_U : Set ↥W_aff.toScheme)ᶜ :=
        (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_compl_W)).trans
          (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C_compl_W)
      have hNe_IW : Set.range ⇑I_W.subschemeι.base ≠ Set.univ := by
        rw [hRange_IW]
        intro hUniv
        have : v_u_pt.1 ∈ (V_U : Set ↥W_aff.toScheme)ᶜ := hUniv ▸ Set.mem_univ _
        exact this v_u_pt.2
      have hDim_ZW : topologicalKrullDim I_W.subscheme ≤ (0 : WithBot ℕ∞) :=
        hKrullDrop ↥W_aff.toScheme hDim_Waff _ ⇑I_W.subschemeι.base I_W.subschemeι.isClosedEmbedding
          hNe_IW

      exact ⟨hW'_drop, C_bar, W_aff, π_norm, C_Y, hInt_Cbar, hProj_Cbar, hSm_Cbar, hDim_Cbar,
        hAff_Waff, hNe_Waff, hFin_π, hComm_π, hNe_CY, hIso_π_CY, hDim_ZY, hDim_ZW⟩

  
  
  
  have hMkIdTerm : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 Y)) := by
    intro Y
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun V => CategoryTheory.MorphismProperty.Over.homMk V.hom
        (CategoryTheory.Category.comp_id V.hom)) ?_
    intro V m
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    let m_l : V.left ⟶ Y := m.left
    let v_h : V.left ⟶ Y := V.hom
    have hw : m_l ≫ 𝟙 Y = v_h := m.w
    exact (CategoryTheory.Category.comp_id m_l).symm.trans hw

  have hIso0 : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      Nonempty (CategoryTheory.Iso
        (CategoryTheory.sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology 0)) := by
    intro Y
    let J := Y.smallEtaleTopology
    let S_pre := CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}
    let L_sh := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let adj_ab := AddCommGrpCat.adj
    let adj_w := adj_ab.whiskerRight (Opposite Y.Etale)
    let F_E : Y.Etale → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      fun E => L_sh.obj ((CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free)
    let evHom : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : Y.Etale),
        (F_E E ⟶ G) ≃ ↥((S_pre.obj G).obj (Opposite.op E)) :=
      fun G E =>
        ((adj_sh.homEquiv ((CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free) G).trans
          (adj_w.homEquiv (CategoryTheory.yoneda.obj E) (S_pre.obj G))).trans
          CategoryTheory.yonedaEquiv
    have hevHom : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : Y.Etale)
        (f : F_E E ⟶ G),
        evHom G E f =
          ((S_pre.map f).app (Opposite.op E))
            (((adj_sh.unit.app ((CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free)).app
              (Opposite.op E)) (adj_ab.unit.app (E ⟶ E) (𝟙 E))) := by
      intro G E f
      dsimp [evHom]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.yonedaEquiv_comp]
      rfl
    let addEquivObj : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : Y.Etale),
        CategoryTheory.Abelian.Ext (F_E E) G 0 ≃+
          ↥((S_pre.obj G).obj (Opposite.op E)) :=
      fun G E =>
        AddEquiv.mk'
          (CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans (evHom G E))
          (fun α β => by
            change evHom G E (CategoryTheory.Abelian.Ext.addEquiv₀ (α + β)) =
              evHom G E (CategoryTheory.Abelian.Ext.addEquiv₀ α) +
                evHom G E (CategoryTheory.Abelian.Ext.addEquiv₀ β)
            rw [map_add, hevHom, hevHom, hevHom, S_pre.map_add]
            rfl)
    let addEquivAt : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : Opposite Y.Etale),
        ↥(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0).obj G).obj W) ≃+
          ↥((S_pre.obj G).obj W) :=
      fun G W => addEquivObj G W.unop
    let isoShRev : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0).obj G ≅ S_pre.obj G :=
      fun G => CategoryTheory.NatIso.ofComponents
        (fun W => (addEquivAt G W).toAddCommGrpIso)
        (fun {W₁ W₂} v => by
          apply AddCommGrpCat.ext
          intro α
          rw [AddCommGrpCat.comp_apply, AddCommGrpCat.comp_apply,
