    have hCl_q₀ : IsClosed ({s₂.base pt₀} : Set (weilProjectiveSpaceOver k 2).left) :=
      (hCompB β).2.2 s₂ hs₂_sec pt₀
    have hCl_c₀ : IsClosed ({c₀} : Set C_disc.left) := by
      have : IsClosedImmersion ι_disc.left := hHyp_disc.1
      have hPre_c₀ : ({c₀} : Set C_disc.left) = ι_disc.left.base ⁻¹' {s₂.base pt₀} := by
        ext c'
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl
          exact hc₀_eq
        · intro heq
          exact ι_disc.left.isClosedEmbedding.injective (heq.trans hc₀_eq.symm)
      rw [hPre_c₀]
      exact hCl_q₀.preimage ι_disc.left.continuous
    refine ⟨c₀, hc₀_reg, hCl_c₀, hc₀_pt_all, ?_⟩
    intro w _ hw_ideal
    have hw_β : w β ≠ 0 := by
      have hnot_mem : MvPolynomial.X β ∉ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c₀) := by
        rw [hc₀_pt_all pt₀]
        exact (hc_homog pt₀ 0).1
      intro hw0
      apply hnot_mem
      rw [hw_ideal (MvPolynomial.X β) 1 (MvPolynomial.isHomogeneous_X k β),
        MvPolynomial.eval_X]
      exact hw0
    have hw_r : ∀ r : Fin 3, w r = c_pt r * w β := by
      intro r
      let F_r : MvPolynomial (Fin 3) k :=
        MvPolynomial.X r - MvPolynomial.C (c_pt r) * MvPolynomial.X β
      have hFr_hom : F_r ∈ 𝒜_2 1 := by
        dsimp [F_r]
        rw [MvPolynomial.C_mul']
        exact Submodule.sub_mem _ (MvPolynomial.isHomogeneous_X k r)
          (Submodule.smul_mem _ (c_pt r) (MvPolynomial.isHomogeneous_X k β))
      have hmem : F_r ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c₀) := by
        rw [hc₀_pt_all pt₀]
        exact (hc_homog pt₀ r).2
      have hev0 : MvPolynomial.eval w F_r = 0 := (hw_ideal F_r 1 hFr_hom).mp hmem
      dsimp [F_r] at hev0
      rw [map_sub, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C,
        MvPolynomial.eval_X] at hev0
      exact sub_eq_zero.mp hev0
    have hw_div : ∀ r : Fin 3, w r / w β = c_pt r := by
      intro r
      rw [hw_r r, mul_div_cancel_right₀ (c_pt r) hw_β]
    have hBdry_v_pderiv :
        w 2 = 0 ∧
        weilProjPlaneShiftedCoordVec k β w 2 = MvPolynomial.X 1 ∧
        MvPolynomial.eval (0 : Fin 2 → k)
          (MvPolynomial.pderiv (0 : Fin 2)
            (MvPolynomial.eval₂Hom MvPolynomial.C
              (weilProjPlaneShiftedCoordVec k β w) P_disc)) ≠ 0 := by
      rcases hc_cases with ⟨hb1, hc_eq⟩ | ⟨a, ha, hb0, hc_eq⟩
      · have hw0 : w 0 = 0 := by rw [hw_r 0, hc_eq]; simp
        have hw2 : w 2 = 0 := by rw [hw_r 2, hc_eq]; simp
        have hβ1 : β = 1 := by dsimp [β]; rw [hb1]; rfl
        rw [hβ1] at hw_β ⊢
        obtain ⟨hv2, hpderiv⟩ := hCompA.2.1 w hw_β hw0 hw2
        refine ⟨hw2, hv2, ?_⟩
        rw [hpderiv P_disc]
        exact hpderiv_inf
      · have hw1 : w 1 = a * w 0 := by
          have h1 := hw_r 1
          rw [hc_eq] at h1
          have hβ0 : β = 0 := by dsimp [β]; rw [hb0]; rfl
          rw [hβ0] at h1
          simpa using h1
        have hw2 : w 2 = 0 := by rw [hw_r 2, hc_eq]; simp
        have hβ0 : β = 0 := by dsimp [β]; rw [hb0]; rfl
        rw [hβ0] at hw_β ⊢
        obtain ⟨hv2, hpderiv⟩ := hCompA.2.2 a w hw_β hw1 hw2
        refine ⟨hw2, hv2, ?_⟩
        rw [hpderiv P_disc]
        exact hpderiv_aff a ha
    refine ⟨hw_β, hBdry_v_pderiv.1, hBdry_v_pderiv.2.1, hBdry_v_pderiv.2.2, ?_⟩
    intro j_P hj_range hj_hom hj_coord
    let ev0 := Spec.map (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k)))
    let s₁ := ev0 ≫ j_P
    have hs₁_sec : s₁ ≫ (weilProjectiveSpaceOver k 2).hom = 𝟙 _ := by
      dsimp [s₁, ev0]
      rw [Category.assoc, hj_hom, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hid : (MvPolynomial.eval (0 : Fin 2 → k)).comp MvPolynomial.C = RingHom.id k := by
        apply RingHom.ext; intro c; simp
      rw [hid, CommRingCat.ofHom_id, Spec.map_id]
    have hj_le : (⊤ : (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens) ≤
        (TopologicalSpace.Opens.map j_P.base).obj U_P := by
      intro p _
      have hp_rng : j_P.base p ∈ Set.range j_P.base := ⟨p, rfl⟩
      rwa [hj_range] at hp_rng
    have hs₁_le : (⊤ : (Spec (CommRingCat.of k)).Opens) ≤
        (TopologicalSpace.Opens.map s₁.base).obj U_P :=
      fun _ _ => hj_le trivial
    apply (hCompB β).2.1 s₁ s₂ hs₁_sec hs₂_sec hs₁_le hs₂_le
    intro r
    let ev0' : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) := ev0
    let j_P' : Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶ Proj 𝒜_2 := j_P
    let s₁' : Spec (CommRingCat.of k) ⟶ Proj 𝒜_2 := s₁
    have hj_le' : (⊤ : (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens) ≤
        (TopologicalSpace.Opens.map j_P'.base).obj U_P := hj_le
    have hs₁_app : s₁'.appLE U_P ⊤ hs₁_le = j_P'.appLE U_P ⊤ hj_le' ≫ ev0'.appTop :=
      (Scheme.Hom.appLE_comp_appLE ev0' j_P' U_P ⊤ ⊤ hj_le' le_top).symm
    have hnat_ev0 : ev0'.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of k)).hom =
        (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 2) k))).hom ≫
          CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k)) :=
      Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k)))
    let hXβ : MvPolynomial.X β ∈ 𝒜_2 1 := MvPolynomial.isHomogeneous_X k β
    let ξ : Fin 3 → HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X β) := fun r' =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X r', MvPolynomial.isHomogeneous_X k r'⟩,
          ⟨MvPolynomial.X β, hXβ⟩, ⟨1, pow_one _⟩⟩
    have hlhs : ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β)
          hXβ zero_lt_one).hom ≫
        s₁'.appLE U_P ⊤ hs₁_le ≫
        (Scheme.ΓSpecIso (CommRingCat.of k)).hom).hom (ξ r) =
        MvPolynomial.eval (0 : Fin 2 → k) (weilProjPlaneShiftedCoordVec k β w r) := by
      rw [hs₁_app, Category.assoc, hnat_ev0]
      exact congrArg (MvPolynomial.eval (0 : Fin 2 → k)) (hj_coord hj_le r)
    exact (hlhs.trans ((hCompA.1 β w hw_β).1 r)).trans ((hw_div r).trans (hc_eval r).symm)

theorem weil_algClosed_odp_point_not_in_net_axis_and_unpack (k : Type u) [Field k] [IsAlgClosed k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hCl_bar : AlgebraicGeometry.IsClosedImmersion ι_bar.left)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (hNet_m0 : m = 0 → ∀ z : Z_bar.left,
      ∃ r : Fin 3, ι_bar.left.base z ∉ weilProjHyperplaneSet k M (L r))
    (hNet_pos : 1 ≤ m → IsTransversalLinearSlice k M Z_bar ι_bar ⊤ (2 * m - 1) 3 L)
    (hRatPt : ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      IsProjectiveOverField k X →
      ∀ (x : X.left), IsClosed ({x} : Set X.left) →
        ∃ q_x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X.left,
          q_x ≫ X.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
          x ∈ Set.range q_x.base)
    (w : Fin 3 → k) (β : Fin 3) (hwβ : w β ≠ 0)
    (z_c : Z_bar.left) (hClosed_zc : IsClosed ({z_c} : Set Z_bar.left))
    (hOdp_zc : IsEtaleLocalOdpHypersurfaceAt k m M Z_bar ι_bar
      (∑ r : Fin 3, MvPolynomial.C (w r) * L r) z_c) :
    let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
    ∃ (α₀ : Fin (M + 1))
      (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
      (V_Z : Z_bar.left.Opens)
      (hAffV : AlgebraicGeometry.IsAffineOpen V_Z)
      (hz_c : z_c ∈ V_Z)
      (hVα : V_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)))
      (ε_z : ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)) →+* k)
      (ψ_Z : MvPolynomial (Fin (2 * m + 2)) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)))
      (Q' : MvPolynomial (Fin (2 * m + 2)) k),
      RingHom.ker ε_z = (hAffV.primeIdealOf ⟨z_c, hz_c⟩).asIdeal ∧
      ε_z.comp (ψ_Z.comp MvPolynomial.C) = RingHom.id k ∧
      ψ_Z.Etale ∧
      (V_Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Z) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V_Z.ι ≫ Z_bar.hom) ∧
      (∀ i : Fin (2 * m + 2), ψ_Z (MvPolynomial.X i) ∈ RingHom.ker ε_z) ∧
      Q' ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) k 2 ∧
      Matrix.det (Matrix.of fun i j : Fin (2 * m + 2) =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q'))) ≠ 0 ∧
      letI : (RingHom.ker ε_z).IsPrime := RingHom.ker_isPrime ε_z
      let ℓ_raw : Fin 3 → ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)) := fun r =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)) V_Z hVα).hom
          (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)
      let ℓ_0 := ℓ_raw β +
        ψ_Z (MvPolynomial.C (w (β.succAbove 0) / w β)) * ℓ_raw (β.succAbove 0) +
        ψ_Z (MvPolynomial.C (w (β.succAbove 1) / w β)) * ℓ_raw (β.succAbove 1)
      let ℓ_1 := ℓ_raw (β.succAbove 0)
      let ℓ_2 := ℓ_raw (β.succAbove 1)
      algebraMap _ (Localization.AtPrime (RingHom.ker ε_z)) (ℓ_0 - ψ_Z Q') ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker ε_z))) ^ 3 ∧
      ε_z ℓ_0 = 0 ∧
      (ε_z ℓ_1 ≠ 0 ∨ ε_z ℓ_2 ≠ 0) :=
by
  classical
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
  let ι_P : Z_bar.left ⟶ AlgebraicGeometry.Proj 𝒜_M := ι_bar.left

  
  have hRatEval :
      ∀ (q_x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_bar.left),
        q_x ≫ Z_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        z_c ∈ Set.range q_x.base →
        ∀ (V : Z_bar.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V) (hz_V : z_c ∈ V)
          (n : ℕ) (χ : MvPolynomial (Fin n) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V))),
          (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom) →
          (AlgebraicGeometry.Etale
            (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)) → χ.Etale) ∧
          ∃ ε_V : ↑(Z_bar.left.presheaf.obj (Opposite.op V)) →+* k,
            RingHom.ker ε_V = (hAffV.primeIdealOf ⟨z_c, hz_V⟩).asIdeal ∧
            ε_V.comp (χ.comp MvPolynomial.C) = RingHom.id k := by
    intro q_x hq_hom hz_range V hAffV hz_V n χ hComm
    have hInv_toSpec : hAffV.isoSpec.inv ≫ V.toSpecΓ = 𝟙 _ := by
      rw [← hAffV.isoSpec_hom, CategoryTheory.Iso.inv_hom_id]
    refine ⟨?_, ?_⟩
    · intro hEt_comp
      have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)) := by
        have _ := hEt_comp
        have heq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) =
            hAffV.isoSpec.inv ≫ (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)) := by
          rw [← CategoryTheory.Category.assoc, hInv_toSpec, CategoryTheory.Category.id_comp]
        rw [heq]
        infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec
    · obtain ⟨pt₀, hpt₀⟩ := hz_range
      have _ : Unique ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        change Unique (PrimeSpectrum k)
        infer_instance
      have hRange_sub : Set.range q_x.base ⊆ Set.range hAffV.fromSpec.base := by
        rintro _ ⟨pt, rfl⟩
        rw [Subsingleton.elim pt pt₀, hpt₀]
        exact ⟨hAffV.primeIdealOf ⟨z_c, hz_V⟩, hAffV.fromSpec_primeIdealOf ⟨z_c, hz_V⟩⟩
      let q_Spec : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op V)) :=
        AlgebraicGeometry.IsOpenImmersion.lift hAffV.fromSpec q_x hRange_sub
      have hq_lift : q_Spec ≫ hAffV.fromSpec = q_x :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hAffV.fromSpec q_x hRange_sub
      let e_mor : Z_bar.left.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of k :=
        AlgebraicGeometry.Spec.preimage q_Spec
      have he_mor : AlgebraicGeometry.Spec.map e_mor = q_Spec :=
        AlgebraicGeometry.Spec.map_preimage q_Spec
      let ε_V : ↑(Z_bar.left.presheaf.obj (Opposite.op V)) →+* k := e_mor.hom
      refine ⟨ε_V, ?_, ?_⟩
      · have hbase_eq : hAffV.fromSpec.base (q_Spec.base pt₀) =
            hAffV.fromSpec.base (hAffV.primeIdealOf ⟨z_c, hz_V⟩) := by
          change (q_Spec ≫ hAffV.fromSpec).base pt₀ = _
          rw [hq_lift, hpt₀, hAffV.fromSpec_primeIdealOf]
        have hq_pt₀ : q_Spec.base pt₀ = hAffV.primeIdealOf ⟨z_c, hz_V⟩ :=
          hAffV.fromSpec.isOpenEmbedding.injective hbase_eq
        let p_k : PrimeSpectrum k := pt₀
        ext a
        rw [← hq_pt₀, ← he_mor]
        change ε_V a = 0 ↔ ε_V a ∈ p_k.asIdeal
        refine ⟨fun h0 => h0.symm ▸ p_k.asIdeal.zero_mem, fun hc => ?_⟩
        by_contra hne
        exact p_k.isPrime.ne_top (p_k.asIdeal.eq_top_of_isUnit_mem hc (IsUnit.mk0 _ hne))
      · have hSpec_eq :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ε_V.comp (χ.comp MvPolynomial.C))) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id k)) := by
          have hmor : CommRingCat.ofHom (ε_V.comp (χ.comp MvPolynomial.C)) =
              (CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom χ) ≫ e_mor := by
            ext x
            rfl
          rw [hmor, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp, he_mor,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
          calc
            q_Spec ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
              = q_Spec ≫ (hAffV.isoSpec.inv ≫ V.toSpecΓ) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) := by
                  rw [hInv_toSpec, CategoryTheory.Category.id_comp]
            _ = q_Spec ≫ hAffV.isoSpec.inv ≫
                  (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) := by
                  simp only [CategoryTheory.Category.assoc]
            _ = q_Spec ≫ hAffV.isoSpec.inv ≫ (V.ι ≫ Z_bar.hom) := by rw [hComm]
            _ = (q_Spec ≫ (hAffV.isoSpec.inv ≫ V.ι)) ≫ Z_bar.hom := by
                  simp only [CategoryTheory.Category.assoc]
            _ = (q_Spec ≫ hAffV.fromSpec) ≫ Z_bar.hom := by rw [hAffV.isoSpec_inv_ι]
            _ = q_x ≫ Z_bar.hom := by rw [hq_lift]
            _ = 𝟙 _ := hq_hom
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_eq)

  
  have hFromSpec_away :
      ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (V : Z_bar.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
        (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α))),
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V hVα) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one =
        hAffV.fromSpec ≫ ι_bar.left := by
    intro α hXα V hAffV hVα
    let D_α : (AlgebraicGeometry.Proj 𝒜_M).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
    have hVα' : V ≤ (TopologicalSpace.Opens.map ι_P.base).obj D_α := hVα
    change AlgebraicGeometry.Spec.map
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_P.appLE D_α V hVα') ≫
        AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one =
      hAffV.fromSpec ≫ ι_P
    have hDα_away :
        D_α.toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one = D_α.ι := by
      have h1 : D_α.toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom := by
        rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom, AlgebraicGeometry.Proj.basicOpenIsoSpec_hom]
        rfl
      rw [← CategoryTheory.Category.assoc, h1,
        ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one,
        CategoryTheory.Iso.hom_inv_id_assoc]
    have hToSpec :
        V.toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
              ι_P.appLE D_α V hVα') ≫
          AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one =
        V.ι ≫ ι_P := by
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc, hDα_away,
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    have hInv : hAffV.isoSpec.inv ≫ V.toSpecΓ = 𝟙 _ := by
      rw [← hAffV.isoSpec_hom, CategoryTheory.Iso.inv_hom_id]
    have hpre := congrArg (hAffV.isoSpec.inv ≫ ·) hToSpec
    simpa only [← CategoryTheory.Category.assoc, hInv, CategoryTheory.Category.id_comp,
      hAffV.isoSpec_inv_ι] using hpre

  have hProjLinearSplit :
      ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (V : Z_bar.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
        (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
        (n : ℕ) (χ : MvPolynomial (Fin n) k →+* ↑(Z_bar.left.presheaf.obj (Opposite.op V))),
        (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ Z_bar.hom) →
        ∀ (hLw : (∑ r : Fin 3, MvPolynomial.C (w r) * L r) ∈ 𝒜_M 1),
        let Φ_V :=
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V hVα).hom
        let ℓ_r : Fin 3 → ↑(Z_bar.left.presheaf.obj (Opposite.op V)) := fun r =>
          Φ_V (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
        Φ_V (HomogeneousLocalization.mk
          ⟨1, ⟨∑ r : Fin 3, MvPolynomial.C (w r) * L r, hLw⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩) =
          ∑ r : Fin 3, χ (MvPolynomial.C (w r)) * ℓ_r r := by
    intro α hXα V hAffV hVα n χ hComm hLw Φ_V ℓ_r
    have hScalar :
        ∀ c : k,
          Φ_V (HomogeneousLocalization.fromZeroRingHom 𝒜_M
            (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_M 0) c)) =
            χ (MvPolynomial.C c) := by
      have hLHS :
          (AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
              ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V hVα) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one) ≫
            (weilProjectiveSpaceOver k M).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Φ_V.comp ((HomogeneousLocalization.fromZeroRingHom 𝒜_M
              (Submonoid.powers (MvPolynomial.X α))).comp (algebraMap k ↥(𝒜_M 0))))) := by
        change (_ ≫ AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one) ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜_M ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)))) = _
        rw [CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one),
          AlgebraicGeometry.Proj.awayι_toSpecZero,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
      have hRHS :
          (hAffV.fromSpec ≫ ι_bar.left) ≫ (weilProjectiveSpaceOver k M).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ.comp MvPolynomial.C)) := by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_bar, ← hAffV.isoSpec_inv_ι,
          CategoryTheory.Category.assoc, ← hComm]
        have hInv : hAffV.isoSpec.inv ≫ V.toSpecΓ = 𝟙 _ := by
          rw [← hAffV.isoSpec_hom, CategoryTheory.Iso.inv_hom_id]
        rw [← CategoryTheory.Category.assoc hAffV.isoSpec.inv V.toSpecΓ, hInv,
          CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      have hEqSpec := (hLHS.symm.trans (congrArg (· ≫ (weilProjectiveSpaceOver k M).hom)
        (hFromSpec_away α hXα V hAffV hVα))).trans hRHS
      have hEqHom := congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hEqSpec)
      intro c
      exact RingHom.congr_fun hEqHom c
    let s_r : Fin 3 → HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α) := fun r =>
      HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩
    have hAwayEq :
        (HomogeneousLocalization.mk
          ⟨1, ⟨∑ r : Fin 3, MvPolynomial.C (w r) * L r, hLw⟩,
            ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α)) =
        ∑ r : Fin 3,
          HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X α))
            (algebraMap k ↥(𝒜_M 0) (w r)) * s_r r := by
      apply HomogeneousLocalization.val_injective
      let d_X : Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) :=
        ⟨MvPolynomial.X α, ⟨1, pow_one _⟩⟩
      let c_loc : Fin 3 → Localization (Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k)) :=
        fun r => Localization.mk (MvPolynomial.C (w r)) 1 * Localization.mk (L r) d_X
      rw [Fin.sum_univ_three (fun r => HomogeneousLocalization.fromZeroRingHom 𝒜_M
        (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_M 0) (w r)) * s_r r)]
      simp only [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mul]
      change Localization.mk (∑ r : Fin 3, MvPolynomial.C (w r) * L r) d_X =
        c_loc 0 + c_loc 1 + c_loc 2
      simp only [c_loc, Localization.mk_eq_mk', ← IsLocalization.mk'_mul, one_mul]
      rw [← IsLocalization.mk'_add, ← IsLocalization.mk'_add, IsLocalization.mk'_eq_iff_eq]
      simp only [d_X, Submonoid.coe_mul, Fin.sum_univ_three]
      ring
    rw [hAwayEq, map_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [map_mul, hScalar (w r)]

  have hHypMem :
      ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (V : Z_bar.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V) (hz : z_c ∈ V)
        (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
        (F : MvPolynomial (Fin (M + 1)) k) (hF : F ∈ 𝒜_M 1),
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V hVα).hom
          (HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩) ∈
            (hAffV.primeIdealOf ⟨z_c, hz⟩).asIdeal →
        ι_bar.left.base z_c ∈ weilProjHyperplaneSet k M F := by
    intro α hXα V hAffV hz hVα F hF hmem_p
    let P_pt := hAffV.primeIdealOf ⟨z_c, hz⟩
    let Φ_mor :=
      (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
        ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V hVα
    have hbase :
        (AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).base
          ((AlgebraicGeometry.Spec.map Φ_mor).base P_pt) = ι_bar.left.base z_c := by
      change (AlgebraicGeometry.Spec.map Φ_mor ≫
        AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).base P_pt = _
      rw [hFromSpec_away α hXα V hAffV hVα]
      change ι_bar.left.base (hAffV.fromSpec.base P_pt) = _
      rw [hAffV.fromSpec_primeIdealOf ⟨z_c, hz⟩]
    intro hInBasic
    change ι_bar.left.base z_c ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M F at hInBasic
    rw [← hbase] at hInBasic
    have hPre :
        (AlgebraicGeometry.Spec.map Φ_mor).base P_pt ∈
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M F) := hInBasic
    rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_M hXα zero_lt_one hF zero_lt_one] at hPre
    have hNotMem :
        HomogeneousLocalization.Away.isLocalizationElem hXα hF ∉
          ((AlgebraicGeometry.Spec.map Φ_mor).base P_pt).asIdeal := hPre
    have hElemEq :
        HomogeneousLocalization.Away.isLocalizationElem hXα hF =
          (HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩ :
            HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α)) := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.mk]
    rw [hElemEq] at hNotMem
    exact hNotMem hmem_p

  have hStalkSqTransfer :
      ∀ (F : MvPolynomial (Fin (M + 1)) k) (hF : F ∈ 𝒜_M 1)
        (α₀ α₁ : Fin (M + 1))
        (hXα₀ : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (hXα₁ : (MvPolynomial.X α₁ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (V₀ V₁ : Z_bar.left.Opens)
        (hAff₀ : AlgebraicGeometry.IsAffineOpen V₀) (hz₀ : z_c ∈ V₀)
        (hVα₀ : V₀ ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)))
        (hAff₁ : AlgebraicGeometry.IsAffineOpen V₁) (hz₁ : z_c ∈ V₁)
        (hVα₁ : V₁ ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₁))),
        let p₀ := (hAff₀.primeIdealOf ⟨z_c, hz₀⟩).asIdeal
        let p₁ := (hAff₁.primeIdealOf ⟨z_c, hz₁⟩).asIdeal
        algebraMap _ (Localization.AtPrime p₀)
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα₀ zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)) V₀ hVα₀).hom
            (HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α₀, hXα₀⟩, ⟨1, pow_one _⟩⟩)) ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p₀)) ^ 2 →
        algebraMap _ (Localization.AtPrime p₁)
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₁) hXα₁ zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₁)) V₁ hVα₁).hom
            (HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α₁, hXα₁⟩, ⟨1, pow_one _⟩⟩)) ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p₁)) ^ 2 := by
    intro F hF α₀ α₁ hXα₀ hXα₁ V₀ V₁ hAff₀ hz₀ hVα₀ hAff₁ hz₁ hVα₁ p₀ p₁ hSq₀
    let y := ι_P.base z_c
    have _ : y.asHomogeneousIdeal.toIdeal.IsPrime := ProjectiveSpectrum.isPrime y
    have hy₀ : y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀) := hVα₀ hz₀
    have hy₁ : y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₁) := hVα₁ hz₁
    let φ_stalk : HomogeneousLocalization.AtPrime 𝒜_M y.asHomogeneousIdeal.toIdeal →+*
        ↑(Z_bar.left.presheaf.stalk z_c) :=
      (ι_P.stalkMap z_c).hom.comp (AlgebraicGeometry.Proj.stalkIso' 𝒜_M y).symm.toRingHom
    have hGermAway :
        ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
          (V : Z_bar.left.Opens) (hz : z_c ∈ V)
          (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
          (s : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α))
          (hsub : Submonoid.powers (MvPolynomial.X α) ≤
            y.asHomogeneousIdeal.toIdeal.primeCompl),
          (Z_bar.left.presheaf.germ V z_c hz).hom
            (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
              ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V hVα).hom s) =
          φ_stalk (HomogeneousLocalization.mapId 𝒜_M hsub s) := by
      intro α hXα V hz hVα s hsub
      let D_α : (AlgebraicGeometry.Proj 𝒜_M).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
      have hVα' : V ≤ (TopologicalSpace.Opens.map ι_P.base).obj D_α := hVα
      have hy : y ∈ D_α := hVα hz
      change (Z_bar.left.presheaf.germ V z_c hz).hom
        ((ι_P.appLE D_α V hVα').hom
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom.hom s)) =
        (ι_P.stalkMap z_c).hom
          ((AlgebraicGeometry.Proj.stalkIso' 𝒜_M y).symm
            (HomogeneousLocalization.mapId 𝒜_M hsub s))
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
      change (Z_bar.left.presheaf.germ V z_c hz).hom
        ((Z_bar.left.presheaf.map (CategoryTheory.homOfLE hVα').op).hom
          ((ι_P.app D_α).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X α)).hom s))) = _
      rw [TopCat.Presheaf.germ_res_apply Z_bar.left.presheaf (CategoryTheory.homOfLE hVα') z_c hz]
      rw [← AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply ι_P D_α z_c hy]
      congr 1
      have haway_germ :=
        congrArg (fun f => f.hom s)
          (AlgebraicGeometry.ProjectiveSpectrum.Proj.awayToSection_germ 𝒜_M (MvPolynomial.X α) y hy)
      exact haway_germ
    have hsub₀ : Submonoid.powers (MvPolynomial.X α₀) ≤ y.asHomogeneousIdeal.toIdeal.primeCompl := by
      rw [Submonoid.powers_le]
      exact (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_M (MvPolynomial.X α₀) y).mp hy₀
    have hsub₁ : Submonoid.powers (MvPolynomial.X α₁) ≤ y.asHomogeneousIdeal.toIdeal.primeCompl := by
      rw [Submonoid.powers_le]
      exact (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_M (MvPolynomial.X α₁) y).mp hy₁
    let s₀_mk : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀) :=
      HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α₀, hXα₀⟩, ⟨1, pow_one _⟩⟩
    let s₁_mk : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₁) :=
      HomogeneousLocalization.mk ⟨1, ⟨F, hF⟩, ⟨MvPolynomial.X α₁, hXα₁⟩, ⟨1, pow_one _⟩⟩
    let u₀₁_mk : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₁) :=
      HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X α₀, hXα₀⟩, ⟨MvPolynomial.X α₁, hXα₁⟩, ⟨1, pow_one _⟩⟩
    have hAtPrime_mul :
        HomogeneousLocalization.mapId 𝒜_M hsub₁ s₁_mk =
          HomogeneousLocalization.mapId 𝒜_M hsub₁ u₀₁_mk *
            HomogeneousLocalization.mapId 𝒜_M hsub₀ s₀_mk := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul]
      change Localization.mk F ⟨MvPolynomial.X α₁, hsub₁ ⟨1, pow_one _⟩⟩ =
        Localization.mk (MvPolynomial.X α₀) ⟨MvPolynomial.X α₁, hsub₁ ⟨1, pow_one _⟩⟩ *
          Localization.mk F ⟨MvPolynomial.X α₀, hsub₀ ⟨1, pow_one _⟩⟩
      simp only [Localization.mk_eq_mk', ← IsLocalization.mk'_mul]
      rw [IsLocalization.mk'_eq_iff_eq, Submonoid.coe_mul]
      congr 1
      ring
    let ℓ_V₀ :=
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα₀ zero_lt_one).hom ≫
        ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)) V₀ hVα₀).hom s₀_mk
    let ℓ_V₁ :=
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₁) hXα₁ zero_lt_one).hom ≫
        ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₁)) V₁ hVα₁).hom s₁_mk
    let r_stalk : ↑(Z_bar.left.presheaf.stalk z_c) :=
      φ_stalk (HomogeneousLocalization.mapId 𝒜_M hsub₁ u₀₁_mk)
    have hStalkEq :
        (Z_bar.left.presheaf.germ V₁ z_c hz₁).hom ℓ_V₁ =
          r_stalk * (Z_bar.left.presheaf.germ V₀ z_c hz₀).hom ℓ_V₀ := by
      rw [hGermAway α₁ hXα₁ V₁ hz₁ hVα₁ s₁_mk hsub₁, hGermAway α₀ hXα₀ V₀ hz₀ hVα₀ s₀_mk hsub₀,
        hAtPrime_mul, map_mul]
    let S_z := ↑(Z_bar.left.presheaf.stalk z_c)
    let e₀ : Localization.AtPrime p₀ ≃+* S_z := by
      letI : Algebra ↑(Z_bar.left.presheaf.obj (Opposite.op V₀)) S_z :=
        TopCat.Presheaf.algebra_section_stalk Z_bar.left.presheaf ⟨z_c, hz₀⟩
      haveI : IsLocalization.AtPrime S_z p₀ := hAff₀.isLocalization_stalk ⟨z_c, hz₀⟩
      exact (Localization.algEquiv p₀.primeCompl S_z).toRingEquiv
    have he₀_alg : ∀ a, e₀ (algebraMap _ (Localization.AtPrime p₀) a) =
        (Z_bar.left.presheaf.germ V₀ z_c hz₀).hom a := by
      intro a
      let _ : Algebra ↑(Z_bar.left.presheaf.obj (Opposite.op V₀)) S_z :=
        TopCat.Presheaf.algebra_section_stalk Z_bar.left.presheaf ⟨z_c, hz₀⟩
      have _ : IsLocalization.AtPrime S_z p₀ := hAff₀.isLocalization_stalk ⟨z_c, hz₀⟩
      change (Localization.algEquiv p₀.primeCompl S_z) (algebraMap _ _ a) = _
      rw [AlgEquiv.commutes]
      exact congrFun (congrArg DFunLike.coe
        (TopCat.Presheaf.stalk_open_algebraMap Z_bar.left.presheaf ⟨z_c, hz₀⟩)) a
    let e₁ : Localization.AtPrime p₁ ≃+* S_z := by
      letI : Algebra ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)) S_z :=
        TopCat.Presheaf.algebra_section_stalk Z_bar.left.presheaf ⟨z_c, hz₁⟩
      haveI : IsLocalization.AtPrime S_z p₁ := hAff₁.isLocalization_stalk ⟨z_c, hz₁⟩
      exact (Localization.algEquiv p₁.primeCompl S_z).toRingEquiv
    have he₁_alg : ∀ a, e₁ (algebraMap _ (Localization.AtPrime p₁) a) =
        (Z_bar.left.presheaf.germ V₁ z_c hz₁).hom a := by
      intro a
      let _ : Algebra ↑(Z_bar.left.presheaf.obj (Opposite.op V₁)) S_z :=
        TopCat.Presheaf.algebra_section_stalk Z_bar.left.presheaf ⟨z_c, hz₁⟩
      have _ : IsLocalization.AtPrime S_z p₁ := hAff₁.isLocalization_stalk ⟨z_c, hz₁⟩
      change (Localization.algEquiv p₁.primeCompl S_z) (algebraMap _ _ a) = _
      rw [AlgEquiv.commutes]
      exact congrFun (congrArg DFunLike.coe
        (TopCat.Presheaf.stalk_open_algebraMap Z_bar.left.presheaf ⟨z_c, hz₁⟩)) a
    let E₀₁ : Localization.AtPrime p₀ ≃+* Localization.AtPrime p₁ := e₀.trans e₁.symm
    have hE_max : ∀ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p₀),
        E₀₁ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p₁) := by
      intro x hx
      rw [IsLocalRing.mem_maximalIdeal] at hx ⊢
      intro hUnit
      exact hx (by simpa using hUnit.map E₀₁.symm)
    have hE_sq : E₀₁ (algebraMap _ (Localization.AtPrime p₀) ℓ_V₀) ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p₁)) ^ 2 := by
      rw [sq] at hSq₀ ⊢
      refine Submodule.mul_induction_on hSq₀ ?_ ?_
      · intro a ha b hb
        rw [map_mul]
        exact Ideal.mul_mem_mul (hE_max a ha) (hE_max b hb)
      · intro a b ha hb
        rw [map_add]
        exact add_mem ha hb
    have hLoc₁_eq :
        algebraMap _ (Localization.AtPrime p₁) ℓ_V₁ =
          e₁.symm r_stalk * E₀₁ (algebraMap _ (Localization.AtPrime p₀) ℓ_V₀) := by
      apply e₁.injective
      dsimp [E₀₁]
      rw [he₁_alg, hStalkEq, ← he₀_alg, map_mul, RingEquiv.apply_symm_apply,
        RingEquiv.apply_symm_apply]
    rw [hLoc₁_eq]
    exact Ideal.mul_mem_left _ _ hE_sq

  
  have hJacObstruction :
      ∀ (s N_var : ℕ) (A_T : Type u) [CommRing A_T]
        (ε_T : A_T →+* k) (p_T : Ideal A_T) [p_T.IsPrime],
        RingHom.ker ε_T = p_T →
        ∀ (φ_T : MvPolynomial (Fin N_var) k →+* A_T),
          Function.Surjective φ_T →
          ε_T.comp (φ_T.comp MvPolynomial.C) = RingHom.id k →
          ∀ (q : Fin s → MvPolynomial (Fin N_var) k),
            RingHom.ker φ_T = Ideal.span (Set.range q) →
            ∀ (f_lift : Fin 3 → MvPolynomial (Fin N_var) k)
              (idx : Fin (s + 3) → Fin N_var),
              IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + 3) =>
                φ_T (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a)))) →
              algebraMap A_T (Localization.AtPrime p_T)
                (φ_T (∑ r : Fin 3, MvPolynomial.C (w r) * f_lift r)) ∉
                (IsLocalRing.maximalIdeal (Localization.AtPrime p_T)) ^ 2 := by
    intro s N_var A_T _ ε_T p_T _ hKer_T φ_T hSurj_T hεT_id q hKer_φT f_lift idx hUnit_jac hInSq
    let P_poly := MvPolynomial (Fin N_var) k
    let F_w : P_poly := ∑ r : Fin 3, MvPolynomial.C (w r) * f_lift r
    have hFw_mem_max :
        algebraMap A_T (Localization.AtPrime p_T) (φ_T F_w) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime p_T) :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) hInSq
    have hφFw_mem_pT : φ_T F_w ∈ p_T :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime p_T) p_T (φ_T F_w)).mp
        hFw_mem_max
    have hMapSq :
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_T)) ^ 2 =
          Ideal.map (algebraMap A_T (Localization.AtPrime p_T)) (p_T ^ 2) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_T (Localization.AtPrime p_T),
        Ideal.map_pow]
    rw [hMapSq, IsLocalization.algebraMap_mem_map_algebraMap_iff p_T.primeCompl] at hInSq
    obtain ⟨s₀, hs₀_compl, hs₀_mul⟩ := hInSq
    have hs₀_notMem : s₀ ∉ p_T := hs₀_compl
    let ε_bar : P_poly →+* k := ε_T.comp φ_T
    have hε_bar_C : ∀ a : k, ε_bar (MvPolynomial.C a) = a := fun a =>
      RingHom.congr_fun hεT_id a
    have hε_bar_Fw : ε_bar F_w = 0 := by
      change ε_T (φ_T F_w) = 0
      rw [← RingHom.mem_ker, hKer_T]
      exact hφFw_mem_pT
    obtain ⟨S₀, hS₀_eq⟩ := hSurj_T s₀
    have hε_bar_S₀ : ε_bar S₀ ≠ 0 := by
      intro h0
      have hmem : s₀ ∈ RingHom.ker ε_T := by
        rw [← hS₀_eq]
        exact h0
      rw [hKer_T] at hmem
      exact hs₀_notMem hmem
    let 𝔪_P : Ideal P_poly := Ideal.comap φ_T p_T
    have hpT_sq_eq : p_T ^ 2 = Ideal.map φ_T (𝔪_P ^ 2) := by
      rw [Ideal.map_pow, Ideal.map_comap_of_surjective φ_T hSurj_T p_T]
    have hS0Fw_in_map : φ_T (S₀ * F_w) ∈ Ideal.map φ_T (𝔪_P ^ 2) := by
      rw [← hpT_sq_eq, map_mul, hS₀_eq]
      exact hs₀_mul
    rw [Ideal.mem_map_iff_of_surjective φ_T hSurj_T] at hS0Fw_in_map
    obtain ⟨H₂, hH₂_mem, hH₂_eq⟩ := hS0Fw_in_map
    have hDiff_ker : S₀ * F_w - H₂ ∈ Ideal.span (Set.range q) := by
      rw [← hKer_φT, RingHom.mem_ker, map_sub, hH₂_eq, sub_self]
    rw [Ideal.mem_span_range_iff_exists_fun] at hDiff_ker
    obtain ⟨G, hG_sum⟩ := hDiff_ker
    have hMasterEq : S₀ * F_w = H₂ + ∑ a : Fin s, G a * q a := by
      rw [hG_sum]
      ring
    have hε_bar_mem : ∀ f ∈ 𝔪_P, ε_bar f = 0 := by
      intro f hf
      have hf' : φ_T f ∈ RingHom.ker ε_T := by rwa [hKer_T]
      exact hf'
    have hDeriv_H₂ : ∀ b : Fin (s + 3), ε_bar (MvPolynomial.pderiv (idx b) H₂) = 0 := by
      intro b
      rw [sq] at hH₂_mem
      refine Submodule.mul_induction_on hH₂_mem ?_ ?_
      · intro u hu v hv
        rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul,
          hε_bar_mem u hu, hε_bar_mem v hv, mul_zero, zero_mul, add_zero]
      · intro u v hu hv
        rw [map_add, map_add, hu, hv, add_zero]
    have hε_bar_q : ∀ a : Fin s, ε_bar (q a) = 0 := by
      intro a
      have hqa : q a ∈ RingHom.ker φ_T := by
        rw [hKer_φT]
        exact Ideal.subset_span ⟨a, rfl⟩
      change ε_T (φ_T (q a)) = 0
      rw [RingHom.mem_ker.mp hqa, map_zero]
    have hDeriv_eq :
        ∀ b : Fin (s + 3),
          ∑ a : Fin s, ε_bar (G a) * ε_bar (MvPolynomial.pderiv (idx b) (q a)) =
            ε_bar S₀ * ∑ r : Fin 3, w r * ε_bar (MvPolynomial.pderiv (idx b) (f_lift r)) := by
      intro b
      have hBoth := congrArg (fun f => ε_bar (MvPolynomial.pderiv (idx b) f)) hMasterEq
      have hL :
          ε_bar (MvPolynomial.pderiv (idx b) (S₀ * F_w)) =
            ε_bar S₀ * ∑ r : Fin 3, w r * ε_bar (MvPolynomial.pderiv (idx b) (f_lift r)) := by
        rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hε_bar_Fw, mul_zero, zero_add]
        congr 1
        dsimp [F_w]
        rw [map_sum, map_sum]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [MvPolynomial.pderiv_C_mul, map_mul, hε_bar_C]
      have hR :
          ε_bar (MvPolynomial.pderiv (idx b) (H₂ + ∑ a : Fin s, G a * q a)) =
            ∑ a : Fin s, ε_bar (G a) * ε_bar (MvPolynomial.pderiv (idx b) (q a)) := by
        rw [map_add, map_add, hDeriv_H₂ b, zero_add, map_sum, map_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hε_bar_q a, mul_zero, zero_add]
      exact hR.symm.trans (hBoth.symm.trans hL)
    let M_jac : Matrix (Fin (s + 3)) (Fin (s + 3)) A_T :=
      Matrix.of fun a b => φ_T (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))
    let J_k : Matrix (Fin (s + 3)) (Fin (s + 3)) k := ε_T.mapMatrix M_jac
    have hDet_Jk : IsUnit J_k.det := by
      rw [← RingHom.map_det]
      exact hUnit_jac.map ε_T
    have hDetT_ne : J_k.transpose.det ≠ 0 := by
      rw [Matrix.det_transpose]
      exact hDet_Jk.ne_zero
    let v_ker : Fin (s + 3) → k :=
      Fin.addCases (fun a : Fin s => -(ε_bar (G a) * (ε_bar S₀)⁻¹)) (fun r : Fin 3 => w r)
    have hv_mulVec : J_k.transpose.mulVec v_ker = 0 := by
      ext b
      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Pi.zero_apply]
      rw [Fin.sum_univ_add]
      have h1 :
          (∑ a : Fin s, J_k (Fin.castAdd 3 a) b * v_ker (Fin.castAdd 3 a)) =
            -(ε_bar S₀)⁻¹ * ∑ a : Fin s, ε_bar (G a) * ε_bar (MvPolynomial.pderiv (idx b) (q a)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        simp only [J_k, M_jac, v_ker, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
          Fin.addCases_left]
        change ε_bar (MvPolynomial.pderiv (idx b) (q a)) * -(ε_bar (G a) * (ε_bar S₀)⁻¹) = _
        ring
      have h2 :
          (∑ r : Fin 3, J_k (Fin.natAdd s r) b * v_ker (Fin.natAdd s r)) =
            ∑ r : Fin 3, w r * ε_bar (MvPolynomial.pderiv (idx b) (f_lift r)) := by
        refine Finset.sum_congr rfl fun r _ => ?_
        simp only [J_k, M_jac, v_ker, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
          Fin.addCases_right]
        change ε_bar (MvPolynomial.pderiv (idx b) (f_lift r)) * w r = _
        ring
      rw [h1, h2, hDeriv_eq b, ← mul_assoc, neg_mul, inv_mul_cancel₀ hε_bar_S₀, neg_one_mul,
        neg_add_cancel]
    have hv_zero : v_ker = 0 := Matrix.eq_zero_of_mulVec_eq_zero hDetT_ne hv_mulVec
    have hwβ_zero : w β = 0 := by
      have h := congrFun hv_zero (Fin.natAdd s β)
      simpa [v_ker, Fin.addCases_right] using h
    exact hwβ hwβ_zero

  
  rcases hOdp_zc with ⟨hLw, α₀, hXα, V_Z, hAffV, hz_c, hVα, ψ_Z, Q,
    hEt_mor, hComm_Z, hX_mem, hQ_homog, hQ_det, hJet_V⟩
  obtain ⟨q_zc, hq_hom, hz_range⟩ := hRatPt Z_bar ⟨M, ι_bar, hCl_bar⟩ z_c hClosed_zc
  obtain ⟨hEt_imp, ε_z, hKer_εz, hεz_id⟩ :=
    hRatEval q_zc hq_hom hz_range V_Z hAffV hz_c (2 * m + 2) ψ_Z hComm_Z
  have hψZ_et : ψ_Z.Etale := hEt_imp hEt_mor
  have hX_ker : ∀ i : Fin (2 * m + 2), ψ_Z (MvPolynomial.X i) ∈ RingHom.ker ε_z := by
    intro i
    rw [hKer_εz]
    exact hX_mem i

  let Q' : MvPolynomial (Fin (2 * m + 2)) k := MvPolynomial.C (w β)⁻¹ * Q
  have hQ'_homog : Q' ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) k 2 := by
    dsimp [Q']
    rw [MvPolynomial.C_mul']
    exact Submodule.smul_mem _ (w β)⁻¹ hQ_homog
  have hQ'_det :
      Matrix.det (Matrix.of fun i j : Fin (2 * m + 2) =>
        MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q'))) ≠ 0 := by
    have hMat_smul :
        (Matrix.of fun i j : Fin (2 * m + 2) =>
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q'))) =
        (w β)⁻¹ • (Matrix.of fun i j : Fin (2 * m + 2) =>
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.pderiv i Q))) := by
      ext i j
      dsimp [Q']
      rw [MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_C_mul,
        map_mul, MvPolynomial.constantCoeff_C]
    rw [hMat_smul, Matrix.det_smul, Fintype.card_fin]
    exact mul_ne_zero (pow_ne_zero (2 * m + 2) (inv_ne_zero hwβ)) hQ_det

  let A_Z := ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z))
  let p_Z := (hAffV.primeIdealOf ⟨z_c, hz_c⟩).asIdeal
  let Φ_Z :=
    ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
      ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)) V_Z hVα).hom
  let ℓ_V : A_Z :=
    Φ_Z (HomogeneousLocalization.mk ⟨1, ⟨∑ r : Fin 3, MvPolynomial.C (w r) * L r, hLw⟩,
      ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)
  let ℓ_raw : Fin 3 → A_Z := fun r =>
    Φ_Z (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)
  let ℓ_0 : A_Z := ℓ_raw β +
    ψ_Z (MvPolynomial.C (w (β.succAbove 0) / w β)) * ℓ_raw (β.succAbove 0) +
    ψ_Z (MvPolynomial.C (w (β.succAbove 1) / w β)) * ℓ_raw (β.succAbove 1)
  let ℓ_1 : A_Z := ℓ_raw (β.succAbove 0)
  let ℓ_2 : A_Z := ℓ_raw (β.succAbove 1)

  have hℓV_eq : ℓ_V = ψ_Z (MvPolynomial.C (w β)) * ℓ_0 := by
    have hSplit := hProjLinearSplit α₀ hXα V_Z hAffV hVα (2 * m + 2) ψ_Z hComm_Z hLw
    change ℓ_V = ∑ r : Fin 3, ψ_Z (MvPolynomial.C (w r)) * ℓ_raw r at hSplit
    rw [hSplit, Fin.sum_univ_succAbove _ β, Fin.sum_univ_two]
    dsimp [ℓ_0]
    rw [mul_add, mul_add]
    have hdiv0 : w β * (w (β.succAbove 0) / w β) = w (β.succAbove 0) :=
      mul_div_cancel₀ _ hwβ
    have hdiv1 : w β * (w (β.succAbove 1) / w β) = w (β.succAbove 1) :=
      mul_div_cancel₀ _ hwβ
    have hc0 : ψ_Z (MvPolynomial.C (w β)) * ψ_Z (MvPolynomial.C (w (β.succAbove 0) / w β)) =
        ψ_Z (MvPolynomial.C (w (β.succAbove 0))) := by
      rw [← map_mul, ← map_mul, hdiv0]
    have hc1 : ψ_Z (MvPolynomial.C (w β)) * ψ_Z (MvPolynomial.C (w (β.succAbove 1) / w β)) =
        ψ_Z (MvPolynomial.C (w (β.succAbove 1))) := by
      rw [← map_mul, ← map_mul, hdiv1]
    rw [← mul_assoc, hc0, ← mul_assoc (ψ_Z (MvPolynomial.C (w β))), hc1, add_assoc]

  have hDiff_rescale : ℓ_0 - ψ_Z Q' = ψ_Z (MvPolynomial.C (w β)⁻¹) * (ℓ_V - ψ_Z Q) := by
    dsimp [Q']
    rw [hℓV_eq, mul_sub, ← mul_assoc, ← map_mul, ← map_mul, inv_mul_cancel₀ hwβ,
      map_one, map_one, one_mul, map_mul]

  have hJet_pZ :
      algebraMap A_Z (Localization.AtPrime p_Z) (ℓ_0 - ψ_Z Q') ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_Z)) ^ 3 := by
    rw [hDiff_rescale, map_mul]
    exact Ideal.mul_mem_left _ _ hJet_V

  let _ : (RingHom.ker ε_z).IsPrime := RingHom.ker_isPrime ε_z
  have hJet_ker :
      algebraMap A_Z (Localization.AtPrime (RingHom.ker ε_z)) (ℓ_0 - ψ_Z Q') ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker ε_z))) ^ 3 := by
    have hTr : ∀ (I₁ I₂ : Ideal A_Z) [I₁.IsPrime] [I₂.IsPrime], I₁ = I₂ →
        ∀ x : A_Z,
          algebraMap A_Z (Localization.AtPrime I₁) x ∈
            (IsLocalRing.maximalIdeal (Localization.AtPrime I₁)) ^ 3 →
          algebraMap A_Z (Localization.AtPrime I₂) x ∈
            (IsLocalRing.maximalIdeal (Localization.AtPrime I₂)) ^ 3 := by
      rintro I₁ _ h₁ h₂ rfl x hx
      convert hx
    exact hTr p_Z (RingHom.ker ε_z) hKer_εz.symm _ hJet_pZ

  have hψQ'_mem_sq : ψ_Z Q' ∈ p_Z ^ 2 := by
    have hProd_pow : ∀ (S : Finset (Fin (2 * m + 2))) (e : Fin (2 * m + 2) →₀ ℕ),
        (∏ i ∈ S, ψ_Z (MvPolynomial.X i) ^ e i) ∈ p_Z ^ (∑ i ∈ S, e i) := by
      intro S e
      induction S using Finset.induction_on with
      | empty =>
        simp
      | @insert i S hi ih =>
        rw [Finset.prod_insert hi, Finset.sum_insert hi, pow_add]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (hX_mem i) (e i)) ih
    rw [Q'.as_sum, map_sum]
    refine Submodule.sum_mem _ fun d hd => ?_
    have hdeg_d : ∑ i : Fin (2 * m + 2), d i = 2 := by
      have hHom : Q'.IsHomogeneous 2 :=
        (MvPolynomial.mem_homogeneousSubmodule 2 Q').mp hQ'_homog
      have hw_d := hHom (MvPolynomial.mem_support_iff.mp hd)
      rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => zero_mul _)] at hw_d
      simpa using hw_d
    rw [MvPolynomial.monomial_eq, map_mul, Finsupp.prod_of_support_subset _ (Finset.subset_univ _)
      _ (fun _ _ => pow_zero _), map_prod]
    simp only [map_pow]
    have hmem_prod := hProd_pow Finset.univ d
    rw [hdeg_d] at hmem_prod
    exact Ideal.mul_mem_left _ _ hmem_prod

  have hLoc_ψQ'_sq :
      algebraMap A_Z (Localization.AtPrime p_Z) (ψ_Z Q') ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_Z)) ^ 2 := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_Z (Localization.AtPrime p_Z),
      ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hψQ'_mem_sq

  have hLoc_ℓ0_sq :
      algebraMap A_Z (Localization.AtPrime p_Z) ℓ_0 ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_Z)) ^ 2 := by
    have hJet_sq :
        algebraMap A_Z (Localization.AtPrime p_Z) (ℓ_0 - ψ_Z Q') ∈
          (IsLocalRing.maximalIdeal (Localization.AtPrime p_Z)) ^ 2 :=
      Ideal.pow_le_pow_right (by decide : 2 ≤ 3) hJet_pZ
    have hsum := add_mem hJet_sq hLoc_ψQ'_sq
    rwa [← map_add, sub_add_cancel] at hsum

  have hε_ℓ0 : ε_z ℓ_0 = 0 := by
    have hmem_max :
        algebraMap A_Z (Localization.AtPrime p_Z) ℓ_0 ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime p_Z) :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) hLoc_ℓ0_sq
    have hmem_pZ : ℓ_0 ∈ p_Z :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime p_Z) p_Z ℓ_0).mp
        hmem_max
    rw [← RingHom.mem_ker, hKer_εz]
    exact hmem_pZ

  have hLoc_ℓV_sq :
      algebraMap A_Z (Localization.AtPrime p_Z) ℓ_V ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_Z)) ^ 2 := by
    rw [hℓV_eq, map_mul]
    exact Ideal.mul_mem_left _ _ hLoc_ℓ0_sq

  have hε_ℓ12 : ε_z ℓ_1 ≠ 0 ∨ ε_z ℓ_2 ≠ 0 := by
    by_contra! hBoth
    rcases hBoth with ⟨hε1, hε2⟩
    have hεβ : ε_z (ℓ_raw β) = 0 := by
      have h0 := hε_ℓ0
      dsimp [ℓ_0] at h0
      rw [map_add, map_add, map_mul, map_mul] at h0
      change ε_z (ℓ_raw β) + _ * ε_z ℓ_1 + _ * ε_z ℓ_2 = 0 at h0
      rw [hε1, hε2, mul_zero, mul_zero, add_zero, add_zero] at h0
      exact h0
    have hAll_pZ : ∀ r : Fin 3, ℓ_raw r ∈ p_Z := by
      intro r
      change ℓ_raw r ∈ (hAffV.primeIdealOf ⟨z_c, hz_c⟩).asIdeal
      rw [← hKer_εz, RingHom.mem_ker]
      rcases Fin.eq_self_or_eq_succAbove β r with rfl | ⟨j, rfl⟩
      · exact hεβ
      · fin_cases j
        · exact hε1
        · exact hε2
    have hAllHyp : ∀ r : Fin 3, ι_bar.left.base z_c ∈ weilProjHyperplaneSet k M (L r) :=
      fun r => hHypMem α₀ hXα V_Z hAffV hz_c hVα (L r) (hL_homog r) (hAll_pZ r)
    rcases Nat.eq_zero_or_pos m with hm0 | hm_pos
    · obtain ⟨r, hr_not⟩ := hNet_m0 hm0 z_c
      exact hr_not (hAllHyp r)
    · obtain ⟨α₁, V_T, hAffT, hz_T, -, hVTα, hXα₁, hpos, s, φ_T, q, f_lift, idx,
        hSurj_T, -, hComm_T, hKer_φT, hf_lift_eq, -, hUnit_jac⟩ :=
        (hNet_pos hm_pos).2 z_c trivial hAllHyp
      obtain ⟨-, ε_T, hKer_εT, hεT_id⟩ :=
        hRatEval q_zc hq_hom hz_range V_T hAffT hz_T (s + 3 + (2 * m - 1)) φ_T hComm_T
      let p_T := (hAffT.primeIdealOf ⟨z_c, hz_T⟩).asIdeal
      have hSq_T :=
        hStalkSqTransfer (∑ r : Fin 3, MvPolynomial.C (w r) * L r) hLw
          α₀ α₁ hXα hXα₁ V_Z V_T hAffV hz_c hVα hAffT hz_T hVTα hLoc_ℓV_sq
      have hSplit_T :=
        hProjLinearSplit α₁ hXα₁ V_T hAffT hVTα (s + 3 + (2 * m - 1)) φ_T hComm_T hLw
      have hpos_eq : hpos = zero_lt_one := Subsingleton.elim _ _
      have hℓT_eq :
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₁) hXα₁ zero_lt_one).hom ≫
            ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₁)) V_T hVTα).hom
            (HomogeneousLocalization.mk ⟨1, ⟨∑ r : Fin 3, MvPolynomial.C (w r) * L r, hLw⟩,
              ⟨MvPolynomial.X α₁, hXα₁⟩, ⟨1, pow_one _⟩⟩)) =
          φ_T (∑ r : Fin 3, MvPolynomial.C (w r) * f_lift r) := by
        rw [hSplit_T, map_sum]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [map_mul]
        congr 1
        have hfl := hf_lift_eq r (hL_homog r)
        rw [hpos_eq] at hfl
        exact hfl.symm
      rw [hℓT_eq] at hSq_T
      exact hJacObstruction s (s + 3 + (2 * m - 1)) _ ε_T p_T hKer_εT φ_T hSurj_T hεT_id
        q hKer_φT f_lift idx hUnit_jac hSq_T

  exact ⟨α₀, hXα, V_Z, hAffV, hz_c, hVα, ε_z, ψ_Z, Q',
    hKer_εz, hεz_id, hψZ_et, hComm_Z, hX_ker, hQ'_homog, hQ'_det,
    hJet_ker, hε_ℓ0, hε_ℓ12⟩

theorem weil_algClosed_incidence_chart_and_diagonal_excision (k : Type u) [Field k] [IsAlgClosed k] (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (hCl_bar : AlgebraicGeometry.IsClosedImmersion ι_bar.left)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (hL_homog : ∀ r : Fin 3, L r ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Y : Y₂ ⟶ Z_bar)
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    [AlgebraicGeometry.IsProper g₂.left]
    (hNet_inc : IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂)
    (U₂_sm : (weilProjectiveSpaceOver k 2).left.Opens)
    (hSm_g₂_U₂ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (g₂.left ∣_ U₂_sm))
    (hPtSm :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
        MvPolynomial.gradedAlgebra
      ∀ (w : Fin 3 → k), w ≠ 0 →
        ∀ (U_Z : Z_bar.left.Opens),
          IsTransversalLinearSlice k M Z_bar ι_bar U_Z (2 * m + 1) 1
            ![∑ r : Fin 3, MvPolynomial.C (w r) * L r] →
          ∀ (y : Y₂.left), π_Y.left.base y ∈ U_Z →
            (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
              F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d →
