    (j_P : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
      (weilProjectiveSpaceOver k 2).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_P)
    (hj_hom : j_P ≫ (weilProjectiveSpaceOver k 2).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (ℓ_0 ℓ_1 ℓ_2 : ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)))
    (hε_ℓ0 : ε_z ℓ_0 = 0)
    (P_pkg : WeilRingSplitOdpChartPkg k m ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z))
      ε_z ℓ_0 ℓ_1 ℓ_2) :
    let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
    letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
    letI : GradedAlgebra 𝒜_2 := MvPolynomial.gradedAlgebra
    let A_Z := ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z))
    let G_poly : MvPolynomial (Fin 2) A_Z :=
      MvPolynomial.C ℓ_0 + MvPolynomial.X (0 : Fin 2) * MvPolynomial.C ℓ_1 +
        MvPolynomial.X (1 : Fin 2) * MvPolynomial.C ℓ_2
    let h_0 := P_pkg.τ_crit G_poly
    ∀ (hVα : V_Z ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀))),
      Set.range j_P.base = (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)).1 →
      (∀ (h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens) ≤
          (TopologicalSpace.Opens.map j_P.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)))
        (r : Fin 3),
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2
            (MvPolynomial.X β) (MvPolynomial.isHomogeneous_X k β) zero_lt_one).hom ≫
          j_P.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)) ⊤ h_le ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 2) k))).hom).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
              ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩) =
          weilProjPlaneShiftedCoordVec k β w r) →
      (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ),
        F ∈ 𝒜_2 d →
        (F ∈ ProjectiveSpectrum.asHomogeneousIdeal
          (j_P.base ⟨RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k)),
            RingHom.ker_isPrime _⟩) ↔
          MvPolynomial.eval w F = 0)) →
      (let ℓ_raw : Fin 3 → A_Z := fun r =>
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα zero_lt_one).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)) V_Z hVα).hom
          (HomogeneousLocalization.mk ⟨1, ⟨L r, hL_homog r⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩)
       ℓ_0 = ℓ_raw β +
         algebraMap k A_Z (w (β.succAbove 0) / w β) * ℓ_raw (β.succAbove 0) +
         algebraMap k A_Z (w (β.succAbove 1) / w β) * ℓ_raw (β.succAbove 1) ∧
       ℓ_1 = ℓ_raw (β.succAbove 0) ∧
       ℓ_2 = ℓ_raw (β.succAbove 1)) →
      ∃ (y_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Y₂.left)
      (g_exc : P_pkg.R'_0),
      P_pkg.ε_R g_exc ≠ 0 ∧
      y_pt ≫ Y₂.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      y_pt ≫ g₂.left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k))) ≫ j_P ∧
      (∀ ε_u : P_pkg.R'_0 →+* k,
        ε_u.comp (P_pkg.φ_P.comp MvPolynomial.C) = RingHom.id k →
        ε_u g_exc ≠ 0 →
        ε_u h_0 = 0 →
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom P_pkg.φ_P) ≫ j_P).base
          ⟨RingHom.ker ε_u, RingHom.ker_isPrime _⟩ ∈ U₂_sm →
        ∃ (S_u : Type u) (_ : CommRing S_u) (_ : Algebra k S_u)
          (ε_S : S_u →+* k)
          (ψ_sm : MvPolynomial (Fin (2 * m + 1)) k →+* S_u)
          (ψ_cone : (MvPolynomial (Fin (m + 1) × Fin 2) k ⧸ Ideal.span
            {∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)}) →+* S_u),
          ε_S.comp (algebraMap k S_u) = RingHom.id k ∧
          ψ_sm.comp MvPolynomial.C = algebraMap k S_u ∧
          ψ_sm.Etale ∧
          ψ_cone.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap k S_u ∧
          ψ_cone.Etale ∧
          ∀ idx : Fin (m + 1) × Fin 2,
            ψ_cone (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ RingHom.ker ε_S) ∧
      (∀ g_match : P_pkg.R'_0,
        P_pkg.ε_R g_match ≠ 0 →
        ∀ (R_loc : Type u) [CommRing R_loc] [Algebra P_pkg.R'_0 R_loc]
          [IsLocalization.Away (g_exc * g_match) R_loc],
        ∃ (B'_2 : CommRingCat.{u})
          (u_2 : AlgebraicGeometry.Spec (CommRingCat.of R_loc))
          (v_2 : AlgebraicGeometry.Spec B'_2)
          (e_Y2 : AlgebraicGeometry.Spec B'_2 ⟶ Y₂.left)
          (q_2 : AlgebraicGeometry.Spec B'_2 ⟶
            AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin (m + 1) × Fin 2) R_loc ⧸ Ideal.span
                {(∑ j : Fin (m + 1),
                    (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R_loc) *
                      MvPolynomial.X (j, 1)) -
                  MvPolynomial.C (algebraMap P_pkg.R'_0 R_loc h_0)}))),
          AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P)) ≫ j_P) ∧
          AlgebraicGeometry.Etale e_Y2 ∧
          AlgebraicGeometry.Etale q_2 ∧
          e_Y2 ≫ g₂.left =
            q_2 ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P)) ≫ j_P) ∧
          algebraMap P_pkg.R'_0 R_loc h_0 ∈ u_2.asIdeal ∧
          (∀ b : Fin 2,
            ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P) (MvPolynomial.X b) ∈ u_2.asIdeal) ∧
          (∀ idx : Fin (m + 1) × Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_2.base v_2).asIdeal) ∧
          Ideal.Quotient.mk _ (MvPolynomial.C (algebraMap P_pkg.R'_0 R_loc h_0)) ∈
            (q_2.base v_2).asIdeal ∧
          (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P)) ≫ j_P).base u_2 =
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k))) ≫ j_P).base pt ∧
            e_Y2.base v_2 = y_pt.base pt) ∧
          (∀ u : AlgebraicGeometry.Spec (CommRingCat.of R_loc),
            algebraMap P_pkg.R'_0 R_loc h_0 ∈ u.asIdeal →
            ∃ v : AlgebraicGeometry.Spec B'_2,
              (q_2 ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))).base v = u ∧
              (∀ idx : Fin (m + 1) × Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_2.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.C (algebraMap P_pkg.R'_0 R_loc h_0)) ∈
                (q_2.base v).asIdeal ∧
              (u = u_2 → e_Y2.base v = e_Y2.base v_2) ∧
              ∀ y' : Y₂.left,
                g₂.left.base y' =
                  (AlgebraicGeometry.Spec.map
                    (CommRingCat.ofHom ((algebraMap P_pkg.R'_0 R_loc).comp P_pkg.φ_P)) ≫ j_P).base u →
                y' ≠ e_Y2.base v →
                ∃ V : Y₂.left.Opens, y' ∈ V ∧
                  AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left))) :=
by
  classical
  
  have hModLoc : ∀ (Q_0 : Type u) [CommRing Q_0]
      (R_0 B_0 : CommRingCat.{u})
      (f_base : MvPolynomial (Fin 2) k →+* Q_0)
      (φ_P : MvPolynomial (Fin 2) k →+* R_0),
      φ_P.Etale →
      ∀ (h_0 g_tot : R_0)
        (R_loc : Type u) [CommRing R_loc] [Algebra R_0 R_loc] [IsLocalization.Away g_tot R_loc]
        (e_Y0 : Q_0 →+* B_0),
        e_Y0.Etale →
        ∀ (q_0 : (MvPolynomial (Fin (m + 1) × Fin 2) R_0 ⧸ Ideal.span
            ({(∑ j : Fin (m + 1),
                (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R_0) *
                  MvPolynomial.X (j, 1)) -
              MvPolynomial.C h_0} : Set (MvPolynomial (Fin (m + 1) × Fin 2) R_0))) →+* B_0),
          q_0.Etale →
          e_Y0.comp f_base =
            (q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp φ_P →
          ∃ (B_loc : CommRingCat.{u})
            (ι_B : B_0 →+* B_loc)
            (q_loc : (MvPolynomial (Fin (m + 1) × Fin 2) R_loc ⧸ Ideal.span
              ({(∑ j : Fin (m + 1),
                  (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R_loc) *
                    MvPolynomial.X (j, 1)) -
                MvPolynomial.C (algebraMap R_0 R_loc h_0)} :
                Set (MvPolynomial (Fin (m + 1) × Fin 2) R_loc))) →+* B_loc),
            AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap R_0 R_loc).comp φ_P))) ∧
            AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B.comp e_Y0))) ∧
            AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_loc)) ∧
            (ι_B.comp e_Y0).comp f_base =
              (q_loc.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp
                ((algebraMap R_0 R_loc).comp φ_P) ∧
            (∀ u_0 : PrimeSpectrum R_0, g_tot ∉ u_0.asIdeal →
              ∃ u : PrimeSpectrum R_loc, PrimeSpectrum.comap (algebraMap R_0 R_loc) u = u_0) ∧
            (∀ (u : PrimeSpectrum R_loc) (v_0 : PrimeSpectrum B_0),
              PrimeSpectrum.comap (q_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) v_0 =
                PrimeSpectrum.comap (algebraMap R_0 R_loc) u →
              ∃ v : PrimeSpectrum B_loc,
                PrimeSpectrum.comap ι_B v = v_0 ∧
                PrimeSpectrum.comap (q_loc.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) v = u ∧
                ((∀ idx : Fin (m + 1) × Fin 2,
                    q_0 (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ v_0.asIdeal) →
                  ∀ idx : Fin (m + 1) × Fin 2,
                    q_loc (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ v.asIdeal) ∧
                (q_0 (Ideal.Quotient.mk _ (MvPolynomial.C h_0)) ∈ v_0.asIdeal →
                  q_loc (Ideal.Quotient.mk _ (MvPolynomial.C (algebraMap R_0 R_loc h_0))) ∈
                    v.asIdeal)) := by
    intro Q_0 _ R_0 B_0 f_base φ_P hφ_et h_0 g_tot R_loc _ _ _ e_Y0 he_Y0_et q_0 hq_0_et hComm_0
    let rel_0 : MvPolynomial (Fin (m + 1) × Fin 2) R_0 :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h_0
    let I_0 : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R_0) := Ideal.span {rel_0}
    let rel_loc : MvPolynomial (Fin (m + 1) × Fin 2) R_loc :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C (algebraMap R_0 R_loc h_0)
    let I_loc : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R_loc) := Ideal.span {rel_loc}
    let c_0 : R_0 →+* (MvPolynomial (Fin (m + 1) × Fin 2) R_0 ⧸ I_0) :=
      (Ideal.Quotient.mk I_0).comp MvPolynomial.C
    let c_loc : R_loc →+* (MvPolynomial (Fin (m + 1) × Fin 2) R_loc ⧸ I_loc) :=
      (Ideal.Quotient.mk I_loc).comp MvPolynomial.C
    let ψ_poly : MvPolynomial (Fin (m + 1) × Fin 2) R_0 →+*
        (MvPolynomial (Fin (m + 1) × Fin 2) R_loc ⧸ I_loc) :=
      (Ideal.Quotient.mk I_loc).comp (MvPolynomial.map (algebraMap R_0 R_loc))
    have hψ_rel : ∀ p ∈ I_0, ψ_poly p = 0 := by
      intro p hp
      have hle : I_0 ≤ RingHom.ker ψ_poly := by
        rw [Ideal.span_singleton_le_iff_mem]
        change Ideal.Quotient.mk I_loc (MvPolynomial.map (algebraMap R_0 R_loc) rel_0) = 0
        have hmap_rel : MvPolynomial.map (algebraMap R_0 R_loc) rel_0 = rel_loc := by
          dsimp [rel_0, rel_loc]
          simp only [map_sub, map_sum, map_mul, MvPolynomial.map_X, MvPolynomial.map_C]
        rw [hmap_rel]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      exact hle hp
    let ψ_cone : (MvPolynomial (Fin (m + 1) × Fin 2) R_0 ⧸ I_0) →+*
        (MvPolynomial (Fin (m + 1) × Fin 2) R_loc ⧸ I_loc) :=
      Ideal.Quotient.lift I_0 ψ_poly hψ_rel
    have hψ_cone_c : ∀ r : R_0, ψ_cone (c_0 r) = c_loc (algebraMap R_0 R_loc r) := by
      intro r
      change Ideal.Quotient.lift I_0 ψ_poly hψ_rel (Ideal.Quotient.mk I_0 (MvPolynomial.C r)) = _
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.mk I_loc (MvPolynomial.map (algebraMap R_0 R_loc) (MvPolynomial.C r)) = _
      rw [MvPolynomial.map_C]
      rfl
    have hψ_cone_X : ∀ idx : Fin (m + 1) × Fin 2,
        ψ_cone (Ideal.Quotient.mk I_0 (MvPolynomial.X idx)) =
          Ideal.Quotient.mk I_loc (MvPolynomial.X idx) := by
      intro idx
      change Ideal.Quotient.lift I_0 ψ_poly hψ_rel (Ideal.Quotient.mk I_0 (MvPolynomial.X idx)) = _
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.mk I_loc (MvPolynomial.map (algebraMap R_0 R_loc) (MvPolynomial.X idx)) = _
      rw [MvPolynomial.map_X]
    let g_B0 : B_0 := q_0 (c_0 g_tot)
    let B_loc : CommRingCat.{u} := CommRingCat.of (Localization.Away g_B0)
    let ι_B : B_0 →+* B_loc := algebraMap B_0 (Localization.Away g_B0)
    have hUnit_gB0 : IsUnit ((ι_B.comp (q_0.comp c_0)) g_tot) := by
      change IsUnit (algebraMap B_0 (Localization.Away g_B0) g_B0)
      exact IsLocalization.Away.algebraMap_isUnit g_B0
    let ρ_R : R_loc →+* B_loc :=
      IsLocalization.Away.lift (S := R_loc) (g := ι_B.comp (q_0.comp c_0)) g_tot hUnit_gB0
    have hρ_R_eq : ∀ r : R_0, ρ_R (algebraMap R_0 R_loc r) = ι_B (q_0 (c_0 r)) :=
      fun r => IsLocalization.Away.lift_eq (S := R_loc) (g := ι_B.comp (q_0.comp c_0)) g_tot hUnit_gB0 r
    let q_poly : MvPolynomial (Fin (m + 1) × Fin 2) R_loc →+* B_loc :=
      MvPolynomial.eval₂Hom ρ_R (fun idx => ι_B (q_0 (Ideal.Quotient.mk I_0 (MvPolynomial.X idx))))
