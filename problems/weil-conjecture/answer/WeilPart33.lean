    have hu_PH_ne : MvPolynomial.eval u P_H ≠ 0 := by
      have hgen_mem : ι_23 P_H * MvPolynomial.X 2 - 1 ∈
          MvPolynomial.vanishingIdeal k ({v} : Set (Fin 3 → k)) :=
        hJ_le_𝔪 ((le_sup_right : _ ≤ J) (Ideal.subset_span (Set.mem_singleton _)))
      have hev0 := hmem_van _ hgen_mem
      rw [map_sub, map_mul, map_one, hev_ι23, MvPolynomial.eval_X] at hev0
      intro hzero
      rw [hzero, zero_mul, zero_sub, neg_eq_zero] at hev0
      exact one_ne_zero hev0
    let 𝔪_u : PrimeSpectrum R_2 := ⟨RingHom.ker (MvPolynomial.eval u), RingHom.ker_isPrime _⟩
    have h𝔪u_ZK : 𝔪_u ∈ Z_K := by
      rw [hZK_eq, PrimeSpectrum.mem_zeroLocus]
      intro g hg
      have hg_mem : ι_23 g ∈ MvPolynomial.vanishingIdeal k ({v} : Set (Fin 3 → k)) :=
        hJ_le_𝔪 ((le_sup_left : _ ≤ J) (Ideal.mem_map_of_mem ι_23 hg))
      change MvPolynomial.eval u g = 0
      rw [← hev_ι23 g]
      exact hmem_van _ hg_mem
    let p₀_U : ↥U_β.toScheme := φ_chart.inv.base 𝔪_u
    let p₀ : (weilProjectiveSpaceOver k 2).left := U_β.ι.base p₀_U
    have hp₀_β : p₀ ∈ U_β := p₀_U.2
    have hp₀_chart : φ_chart.hom.base ⟨p₀, hp₀_β⟩ = 𝔪_u := by
      have h1 : (⟨p₀, hp₀_β⟩ : ↥U_β.toScheme) = φ_chart.inv.base 𝔪_u := Subtype.ext rfl
      rw [h1]
