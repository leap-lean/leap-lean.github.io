          Ideal.comap e_β.toRingHom (iso_Specβ.hom.base ⟨p, hp⟩).asIdeal := rfl
      rw [hcomap, Ideal.mem_comap, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
        e_β.apply_symm_apply]
      exact hProj_mem_asIdeal_iff β hXβ p hp d F hF hXd
    let Z_K : Set (PrimeSpectrum R_2) := (φ_chart.inv ≫ U_β.ι).base ⁻¹' K
    have hClosed_ZK : IsClosed Z_K :=
      hClosed_K.preimage (φ_chart.inv ≫ U_β.ι).continuous
    obtain ⟨I_K, hZK_eq⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z_K).mp hClosed_ZK
    let q₀ : PrimeSpectrum R_2 := φ_chart.hom.base ⟨q_init, hq_β⟩
    have hq₀_ZK : q₀ ∈ Z_K := by
      change U_β.ι.base (φ_chart.inv.base (φ_chart.hom.base ⟨q_init, hq_β⟩)) ∈ K
      have hinv_hom : φ_chart.inv.base (φ_chart.hom.base ⟨q_init, hq_β⟩) = ⟨q_init, hq_β⟩ :=
        congrArg (fun h : U_β.toScheme ⟶ U_β.toScheme => h.base ⟨q_init, hq_β⟩) φ_chart.hom_inv_id
      rw [hinv_hom]
      exact hq_K
    have hIK_le : I_K ≤ q₀.asIdeal := by
      rw [hZK_eq, PrimeSpectrum.mem_zeroLocus] at hq₀_ZK
      exact hq₀_ZK
    let P_H : R_2 := MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β) H
    have hPH_notMem : P_H ∉ q₀.asIdeal := by
      rw [hchart_mem_iff q_init hq_β d_H H hH_hom]
      exact (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_2 H q_init).mp hq_H
    let ι_23 : R_2 →+* MvPolynomial (Fin 3) k :=
      (MvPolynomial.rename (Fin.castSucc : Fin 2 → Fin 3)).toRingHom
    let J : Ideal (MvPolynomial (Fin 3) k) :=
      Ideal.map ι_23 I_K ⊔ Ideal.span {ι_23 P_H * MvPolynomial.X 2 - 1}
    have hJ_ne_top : J ≠ ⊤ := by
      letI : q₀.asIdeal.IsPrime := q₀.isPrime
      let Q_dom := R_2 ⧸ q₀.asIdeal
      let κ := FractionRing Q_dom
      let π_κ : R_2 →+* κ := (algebraMap Q_dom κ).comp (Ideal.Quotient.mk q₀.asIdeal)
      have hPH_ne : π_κ P_H ≠ 0 := by
        intro h0
        have hq_zero : Ideal.Quotient.mk q₀.asIdeal P_H = 0 :=
          (IsFractionRing.injective Q_dom κ) (h0.trans (map_zero _).symm)
        exact hPH_notMem (Ideal.Quotient.eq_zero_iff_mem.mp hq_zero)
      let ψ_κ : MvPolynomial (Fin 3) k →+* κ :=
        MvPolynomial.eval₂Hom (π_κ.comp MvPolynomial.C)
          (Fin.lastCases (π_κ P_H)⁻¹ (fun j : Fin 2 => π_κ (MvPolynomial.X j)))
      have hψ_comp : ψ_κ.comp ι_23 = π_κ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp [ψ_κ, ι_23]
        · intro j
          simp only [RingHom.comp_apply, ι_23, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
            MvPolynomial.rename_X]
          change MvPolynomial.eval₂Hom _ _ (MvPolynomial.X j.castSucc) = _
          rw [MvPolynomial.eval₂Hom_X', Fin.lastCases_castSucc]
      have hJ_le_ker : J ≤ RingHom.ker ψ_κ := by
        refine sup_le ?_ ?_
        · rw [Ideal.map_le_iff_le_comap]
          intro g hg
          change ψ_κ (ι_23 g) = 0
          have h1 : ψ_κ (ι_23 g) = π_κ g := RingHom.congr_fun hψ_comp g
