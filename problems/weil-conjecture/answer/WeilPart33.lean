      apply symm
      apply sub_eq_zero.mp
      rw [← map_sub]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      refine Ideal.mem_span_singleton.mpr ⟨1, ?_⟩
      have hst : ι01 (s * t) = MvPolynomial.X 0 * MvPolynomial.X 1 := by
        change ι01 (MvPolynomial.X 0 * MvPolynomial.X 1) = _
        rw [map_mul, hι01_X, hι01_X]
        rfl
      rw [hst, mul_one]
    have hNormForm : ∀ F : MvPolynomial (Fin 3) k,
