      let D_scale : Fin (s + 1) → A_Z :=
        Fin.addCases (fun _ : Fin s => (1 : A_Z)) ![algebraMap k A_Z (w β)⁻¹]
      have hmat_spec : ((φ.comp spec_w).mapMatrix P_pre.jacobiMatrix).transpose =
          Matrix.diagonal D_scale * M_0 := by
        ext a b
        simp only [Matrix.transpose_apply, RingHom.mapMatrix_apply, Matrix.map_apply,
          RingHom.comp_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
          Matrix.diagonal_mul, M_0, Matrix.of_apply]
        change φ (spec_w (MvPolynomial.pderiv (idx b) (Q_rel a))) = _
        dsimp [spec_w]
        rw [← MvPolynomial.pderiv_map, hspec_Qrel a]
        refine Fin.addCases (fun a₀ => ?_) (fun i₀ => ?_) a
        · simp [D_scale]
        · fin_cases i₀
          simp only [Fin.mk_zero, Fin.addCases_right, Matrix.cons_val_zero, D_scale]
          rw [Derivation.leibniz, MvPolynomial.pderiv_C, smul_zero, add_zero,
            smul_eq_mul, map_mul, hAlg_φ]
      have hunit_det : IsUnit (φ (spec_w Δ_poly)) := by
        have hdet_map : φ (spec_w Δ_poly) = ((φ.comp spec_w).mapMatrix P_pre.jacobiMatrix).det :=
          RingHom.map_det (φ.comp spec_w) P_pre.jacobiMatrix
        rw [hdet_map, ← Matrix.det_transpose, hmat_spec, Matrix.det_mul, Matrix.det_diagonal]
        refine IsUnit.mul ?_ hDet
        rw [Fin.prod_univ_add]
        simp only [D_scale, Fin.addCases_left, Finset.prod_const_one, one_mul,
