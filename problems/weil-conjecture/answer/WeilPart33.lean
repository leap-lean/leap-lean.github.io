        ∀ (b : ℕ), CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g.left (b + 1) 𝒢)) ∧
      (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
        (W' : AlgebraicGeometry.Scheme.{u}) (iW' : W' ⟶ Y.left),
