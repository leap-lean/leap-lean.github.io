        · subst hij; simp
        · simp [hij]
    have hr_G_sum : r_G = ∑ k : Fin d, r_G k • (1 : Matrix (Fin d) (Fin d) C_ext) k := by
      ext j
      simp only [Finset.sum_apply, Pi.smul_apply, Matrix.one_apply, smul_eq_mul]
      rw [Finset.sum_eq_single j
        (fun k _ hkj => by simp [hkj])
        (fun hj => absurd (Finset.mem_univ j) hj)]
      simp
    have hΔ_slice : M_slice.det =
        MvPolynomial.rename inl_var (weilMvPolyMapCoeffs (der_C i_0) G) := by
      rw [hM_slice_eq, hr_G_sum, Matrix.det_updateRow_sum, Matrix.det_one, smul_eq_mul, mul_one]
    have hCrit := hPart3a (n + (d - 1)) der_C hder_C F_slice 1
    dsimp only at hCrit
    let δ_slice : C_ext := M_slice.det * 1
    let I_slice : Ideal C_ext := Ideal.span (Set.range F_slice)
    let Q_slice := C_ext ⧸ I_slice
    let bar_δslice : Q_slice := Ideal.Quotient.mk I_slice δ_slice
    let S_slice := Localization.Away bar_δslice
    let Q_G := C_n ⧸ I_G
    let g_i0 : C_n := weilMvPolyMapCoeffs (der_C i_0) G
    let bar_g : Q_G := Ideal.Quotient.mk I_G g_i0
    let S_G := Localization.Away bar_g
    let var_val : Fin (n + (d - 1)) → Q_G := fun v =>
      Sum.elim
        (fun b : Fin n => Ideal.Quotient.mk I_G (MvPolynomial.X b))
        (fun s : Fin (d - 1) => Ideal.Quotient.mk I_G (MvPolynomial.C (ψ (MvPolynomial.X (emb s)))))
        (e_vars.symm v)
    let ev_slice := MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_G).comp MvPolynomial.C) var_val
    have hev_rename : ∀ P : C_n,
        ev_slice (MvPolynomial.rename inl_var P) = Ideal.Quotient.mk I_G P := by
      intro P
      have hcomp : ev_slice.comp (MvPolynomial.rename inl_var).toRingHom =
          Ideal.Quotient.mk I_G := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
            MvPolynomial.rename_C]
          dsimp [ev_slice]
          rw [MvPolynomial.eval₂_C, RingHom.comp_apply]
        · intro b
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
            MvPolynomial.rename_X]
          dsimp [ev_slice]
          rw [MvPolynomial.eval₂_X]
