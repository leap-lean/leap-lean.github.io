              MvPolynomial.eval w F = 0)) →
          ∃ V : Y₂.left.Opens, y ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left) := by
    intro w hw U_Z hSlice y hy_UZ hy_w
    obtain ⟨β, hwβ⟩ := Function.ne_iff.mp hw
    have hx_hyp := h_mod3_A w β hwβ y hy_w
    obtain ⟨α₀, V_Z, hAffVZ, hx_VZ, _, hVZ, hXα, hpos, s, φ, q, f_lift, idx,
