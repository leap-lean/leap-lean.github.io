              let hKi_sub : ∀ z ∈ (Ki : Set U₁₂), z.1 ∈ (C₀ : Set ↥S) :=
                fun z hz => hK₀ z (hSubTop i hz)
              let ρ_i : ↥(Ki : Set U₁₂) → ↥(C₀ : Set ↥S) :=
                fun w => ⟨w.1.1, hKi_sub w.1 w.2⟩
              have hρ_cont : Continuous ρ_i :=
                (continuous_subtype_val.comp continuous_subtype_val).subtype_mk _
              have hRange_eq : Set.range ρ_i = ι₀ ⁻¹' (Ki : Set U₁₂) := by
                ext x
                constructor
                · rintro ⟨w, hw⟩
                  have hx_val : x.1 = w.1.1 := (congrArg Subtype.val hw).symm
                  have hιx : ι₀ x = w.1 := Subtype.ext hx_val
                  change ι₀ x ∈ (Ki : Set U₁₂)
                  rw [hιx]
                  exact w.2
                · intro hx
                  exact ⟨⟨ι₀ x, hx⟩, Subtype.ext rfl⟩
              have hUniv_irr : IsIrreducible (Set.univ : Set ↥(Ki : Set U₁₂)) :=
                (isIrreducible_iff_irreducibleSpace.mp Ki.isIrreducible).isIrreducible_univ
              have hPre_irr : IsIrreducible (ι₀ ⁻¹' (Ki : Set U₁₂)) := by
                rw [← hRange_eq, ← Set.image_univ]
                exact hUniv_irr.image ρ_i hρ_cont.continuousOn
              { carrier := ι₀ ⁻¹' (Ki : Set U₁₂)
                isIrreducible' := hPre_irr
                isClosed' := Ki.isClosed.preimage hι₀_cont }
          let l₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(C₀ : Set ↥S)) :=
            { length := l.length
              toFun := pullIC
              step := fun j => by
                have hstep : l.toFun j.castSucc < l.toFun j.succ := l.step j
                have hsub_step : (l.toFun j.castSucc : Set U₁₂) ⊆ (l.toFun j.succ : Set U₁₂) :=
                  le_of_lt hstep
                have hle : pullIC j.castSucc ≤ pullIC j.succ :=
                  fun x hx => hsub_step hx
                refine lt_of_le_of_ne hle (fun heq => ?_)
                have hset_eq : (pullIC j.castSucc : Set ↥(C₀ : Set ↥S)) =
                    (pullIC j.succ : Set ↥(C₀ : Set ↥S)) := congrArg SetLike.coe heq
                apply ne_of_lt hstep
                ext z
                constructor
                · intro hz
                  exact le_of_lt hstep hz
                · intro hz
                  have hz_c₀ : z.1 ∈ (C₀ : Set ↥S) := hK₀ z (hSubTop j.succ hz)
                  have hmem_succ : (⟨z.1, hz_c₀⟩ : ↥(C₀ : Set ↥S)) ∈
                      (pullIC j.succ : Set ↥(C₀ : Set ↥S)) := hz
                  rw [← hset_eq] at hmem_succ
                  exact hmem_succ }
          have hlen_le : ((l₀.length : ℕ) : WithBot ℕ∞) ≤ (e : WithBot ℕ∞) :=
            (Order.LTSeries.length_le_krullDim l₀).trans hDim₀
          exact WithBot.coe_le_coe.mp hlen_le
        rcases hK_in_one with h₁ | h₂
        · exact hPullBound C₁ le_sup_left hDim₁ h₁
        · exact hPullBound C₂ le_sup_right hDim₂ h₂
    let Idx : Type u :=
      { C : TopologicalSpace.Closeds ↥S // topologicalKrullDim ↥(C : Set ↥S) ≤ (e : WithBot ℕ∞) }
    let instSupIdx : SemilatticeSup Idx :=
      { (inferInstance : PartialOrder Idx) with
        sup := fun a b => ⟨a.1 ⊔ b.1, hSupDim a.1 b.1 a.2 b.2⟩
        le_sup_left := fun a b => (le_sup_left : a.1 ≤ a.1 ⊔ b.1)
        le_sup_right := fun a b => (le_sup_right : b.1 ≤ a.1 ⊔ b.1)
        sup_le := fun a b c (h₁ : a.1 ≤ c.1) (h₂ : b.1 ≤ c.1) =>
          (sup_le h₁ h₂ : a.1 ⊔ b.1 ≤ c.1) }
    let _ : SemilatticeSup Idx := instSupIdx
    let botIdx : Idx := ⟨⊥, hBotDim⟩
    let _ : OrderBot Idx :=
      { bot := botIdx
        bot_le := fun _ => (bot_le : (⊥ : TopologicalSpace.Closeds ↥S) ≤ _) }
    have _ : Nonempty Idx := ⟨botIdx⟩
    let instSmall : CategoryTheory.SmallCategory Idx := inferInstance
    have instFilt : CategoryTheory.IsFiltered Idx :=
      CategoryTheory.isFiltered_of_semilatticeSup_nonempty Idx
    let A_sub : ∀ (j : Idx) (U : S.Etale), AddSubgroup ↥(ℱ.obj.obj (Opposite.op U)) :=
      fun j U =>
        { carrier := { s | ∀ (V : S.Etale) (v : V ⟶ U),
              Set.range V.hom.base ⊆ (j.1 : Set ↥S)ᶜ → ℱ.obj.map (Opposite.op v) s = 0 }
          zero_mem' := fun V v _ => map_zero _
          add_mem' := fun {a b} ha hb V v hv => by
            rw [map_add, ha V v hv, hb V v hv, add_zero]
          neg_mem' := fun {a} ha V v hv => by
            rw [map_neg, ha V v hv, neg_zero] }
    let P_sub : Idx → ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      fun j =>
        { obj := fun opU => AddCommGrpCat.of ↥(A_sub j (Opposite.unop opU))
          map := fun {opU₁ opU₂} f =>
            AddCommGrpCat.ofHom
              { toFun := fun x =>
                  ⟨ℱ.obj.map f x.1, fun V v hv =>
                    (hMapComp ℱ v f.unop x.1).symm.trans (x.2 V (v ≫ f.unop) hv)⟩
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun x y => Subtype.ext (map_add _ x.1 y.1) }
          map_id := fun opU => by
            apply AddCommGrpCat.ext
            intro x
            exact Subtype.ext (hMapId ℱ (Opposite.unop opU) x.1)
          map_comp := fun f g => by
            apply AddCommGrpCat.ext
            intro x
            exact Subtype.ext (hMapComp ℱ g.unop f.unop x.1) }
    let ι_pre : ∀ j : Idx, P_sub j ⟶ ℱ.obj :=
      fun j =>
        { app := fun opU => AddCommGrpCat.ofHom (A_sub j (Opposite.unop opU)).subtype
          naturality := fun _ _ _ => rfl }
    let map_pre : ∀ {j₁ j₂ : Idx}, j₁ ≤ j₂ → (P_sub j₁ ⟶ P_sub j₂) :=
      fun {j₁ j₂} hle =>
        { app := fun opU =>
            AddCommGrpCat.ofHom
              { toFun := fun x =>
                  ⟨x.1, fun V v hv =>
                    x.2 V v (hv.trans (Set.compl_subset_compl.mpr hle))⟩
                map_zero' := rfl
                map_add' := fun _ _ => rfl }
          naturality := fun _ _ _ => rfl }
    have hSh_F := (CategoryTheory.Presheaf.isSheaf_iff_isLimit _ ℱ.obj).mp ℱ.property
    have hSheafSep : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (U : S.Etale) (R : CategoryTheory.Sieve U),
        R ∈ S.smallEtaleTopology U →
        ∀ (x y : ↥(𝒢.obj.obj (Opposite.op U))),
          (∀ (V : S.Etale) (g : V ⟶ U), R.arrows g →
            𝒢.obj.map (Opposite.op g) x = 𝒢.obj.map (Opposite.op g) y) →
          x = y := by
      intro 𝒢 U R hR x y hEq
      obtain ⟨hLim⟩ := ((CategoryTheory.Presheaf.isSheaf_iff_isLimit _ 𝒢.obj).mp 𝒢.property) R hR
      let Z₀ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
      let d : ↥(𝒢.obj.obj (Opposite.op U)) := x - y
      let α_d : Z₀ ⟶ (𝒢.obj.mapCone R.arrows.cocone.op).pt :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • d
            map_zero' := zero_zsmul d
            map_add' := fun a b => add_zsmul d a.down b.down }
      have hα0 : α_d = 0 := by
        refine hLim.hom_ext (fun j => ?_)
        rw [Limits.zero_comp]
        apply AddCommGrpCat.ext
        intro ⟨n⟩
        let V_j : S.Etale := j.unop.obj.left
        let g_j : V_j ⟶ U := j.unop.obj.hom
        have hj : (𝒢.obj.map g_j.op) d = 0 := by
          dsimp [d]
          rw [map_sub]
          exact sub_eq_zero.mpr (hEq V_j g_j j.unop.property)
        change (𝒢.obj.map g_j.op) (n • d) = 0
        rw [map_zsmul, hj, zsmul_zero]
      have h1 : d = 0 := by
        have h := congrArg
          (fun (f : Z₀ ⟶ (𝒢.obj.mapCone R.arrows.cocone.op).pt) => f (ULift.up (1 : ℤ))) hα0
        change (1 : ℤ) • d = 0 at h
        rwa [one_zsmul] at h
      exact sub_eq_zero.mp h1
    have hIsSheaf_sub : ∀ j : Idx,
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (P_sub j) := by
      intro j
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro U R hR
      obtain ⟨hLimF⟩ := hSh_F R hR
      let toConeF : Limits.Cone (R.arrows.diagram.op ⋙ P_sub j) →
          Limits.Cone (R.arrows.diagram.op ⋙ ℱ.obj) :=
        (Limits.Cone.postcompose (Functor.whiskerLeft R.arrows.diagram.op (ι_pre j))).obj
      refine ⟨{
        lift := fun m =>
          let mF := toConeF m
          let LF : m.pt ⟶ (ℱ.obj.mapCone R.arrows.cocone.op).pt := hLimF.lift mF
          AddCommGrpCat.ofHom
            { toFun := fun x =>
                let s_U : ↥(ℱ.obj.obj (Opposite.op U)) := LF x
                ⟨s_U, fun V v hv_out => by
                  let R' : CategoryTheory.Sieve V := R.pullback v
                  have hR' : R' ∈ S.smallEtaleTopology V :=
                    S.smallEtaleTopology.pullback_stable v hR
                  refine hSheafSep ℱ V R' hR' (ℱ.obj.map (Opposite.op v) s_U) 0 ?_
                  intro W' w hw
                  rw [map_zero]
                  have hwv : R.arrows (w ≫ v) := hw
                  let obj_wv : R.arrows.category :=
                    CategoryTheory.ObjectProperty.FullSubcategory.mk
                      (CategoryTheory.Over.mk (w ≫ v)) hwv
                  have hfac := hLimF.fac mF (Opposite.op obj_wv)
                  have hfac_x : ℱ.obj.map (Opposite.op (w ≫ v)) s_U =
                      ((m.π.app (Opposite.op obj_wv)) x).1 :=
                    congrArg (fun (f : m.pt ⟶ ℱ.obj.obj (Opposite.op W')) => f x) hfac
                  have hW'_out : Set.range W'.hom.base ⊆ (j.1 : Set ↥S)ᶜ := by
                    rintro y ⟨z, rfl⟩
                    have hw_hom : W'.hom.base z = V.hom.base (w.left.base z) :=
                      congrArg (fun h => h.base z) (CategoryTheory.MorphismProperty.Over.w w).symm
                    rw [hw_hom]
                    exact hv_out ⟨w.left.base z, rfl⟩
                  have h_id_zero := ((m.π.app (Opposite.op obj_wv)) x).2 W' (𝟙 W') hW'_out
                  exact (hMapComp ℱ w v s_U).symm.trans
                    (hfac_x.trans ((hMapId ℱ W' _).symm.trans h_id_zero))⟩
              map_zero' := Subtype.ext (map_zero _)
              map_add' := fun a b => Subtype.ext (map_add _ a b) }
        fac := fun m k => by
          apply AddCommGrpCat.ext
          intro x
          apply Subtype.ext
          have hfac := hLimF.fac (toConeF m) k
          exact congrArg (fun (f : m.pt ⟶ ℱ.obj.obj (Opposite.op k.unop.obj.left)) => f x) hfac
        uniq := fun m f_cone hf_cone => by
          apply AddCommGrpCat.ext
          intro x
          apply Subtype.ext
          let f_F : (toConeF m).pt ⟶ (ℱ.obj.mapCone R.arrows.cocone.op).pt :=
            f_cone ≫ (ι_pre j).app (Opposite.op (Over.forgetCocone U).pt)
          have huniq := hLimF.uniq (toConeF m) f_F (fun k => by
            apply AddCommGrpCat.ext
            intro (y : ↥m.pt)
            have hfk := congrArg (fun (h : m.pt ⟶ (P_sub j).obj (Opposite.op k.unop.obj.left)) =>
              h y) (hf_cone k)
            exact congrArg Subtype.val hfk)
          exact congrArg (fun (g : m.pt ⟶ (ℱ.obj.mapCone R.arrows.cocone.op).pt) => g x) huniq
      }⟩
    let D : CategoryTheory.Functor Idx
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      { obj := fun j => ⟨P_sub j, hIsSheaf_sub j⟩
        map := fun {j₁ j₂} u => ⟨map_pre (leOfHom u)⟩
        map_id := fun _ => ObjectProperty.hom_ext _ rfl
        map_comp := fun _ _ => ObjectProperty.hom_ext _ rfl }
    let c_colim : CategoryTheory.Limits.Cocone D :=
      { pt := ℱ
        ι :=
          { app := fun j => ⟨ι_pre j⟩
            naturality := fun _ _ _ => ObjectProperty.hom_ext _ rfl } }
    have hMono_c : ∀ j : Idx, CategoryTheory.Mono (c_colim.ι.app j) := by
      intro j
      refine ⟨fun {𝒢} u₁ u₂ hu => ?_⟩
      apply ObjectProperty.hom_ext
      ext opU : 2
      apply AddCommGrpCat.ext
      intro x
      have happ := congrArg (fun (w : 𝒢 ⟶ ℱ) => (w.hom.app opU) x) hu
      exact Subtype.ext happ
    have hQcExh : ∀ (U_z : S.Etale) [CompactSpace ↥U_z.left]
        (s' : ↥(ℱ.obj.obj (Opposite.op U_z))),
        ∃ j : Idx, s' ∈ A_sub j U_z := by
      intro U_z _ s'
      obtain ⟨pts, hDimPts, hDisjZero⟩ := hChartPts U_z s'
      let j_fn : ↥pts → Idx :=
        fun y => ⟨⟨closure ({y.1} : Set ↥S), isClosed_closure⟩, hDimPts y.1 y.2⟩
      let j_star : Idx := pts.attach.sup j_fn
      refine ⟨j_star, fun V v hv_out => hDisjZero V v (fun y hy => ?_)⟩
      have hj_le : j_fn ⟨y, hy⟩ ≤ j_star :=
        Finset.le_sup (f := j_fn) (Finset.mem_attach pts ⟨y, hy⟩)
      exact Set.disjoint_left.mpr (fun z hzV hzy => hv_out hzV (hj_le hzy))
    let R_exh : ∀ (U₀ : S.Etale), ↥(ℱ.obj.obj (Opposite.op U₀)) → CategoryTheory.Sieve U₀ :=
      fun U₀ s₀ =>
        { arrows := fun {V} g => ∃ j : Idx, ℱ.obj.map (Opposite.op g) s₀ ∈ A_sub j V
          downward_closed := fun {V W'} {g} ⟨j, hj⟩ h =>
            ⟨j, by
              rw [hMapComp ℱ h g s₀]
              exact ((P_sub j).map (Opposite.op h) ⟨_, hj⟩).2⟩ }
    have hRexh_mem : ∀ (U₀ : S.Etale) (s₀ : ↥(ℱ.obj.obj (Opposite.op U₀))),
        R_exh U₀ s₀ ∈ S.smallEtaleTopology U₀ := by
      intro U₀ s₀
      let P_et : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
      have hJ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (le_refl P_et)
      change R_exh U₀ s₀ ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S U₀
      rw [hJ]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U₀ (R_exh U₀ s₀)).mpr (fun z => ?_)
      obtain ⟨O_z, hAff_Oz, hz_Oz, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := (⊤ : U₀.left.Opens)) trivial (x := z)
      let _ : AlgebraicGeometry.IsAffine (O_z : AlgebraicGeometry.Scheme.{u}) := hAff_Oz
      have hOz_et : P_et (O_z.ι ≫ U₀.hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et O_z.ι U₀.hom inferInstance U₀.prop
      let V_z : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_z.ι ≫ U₀.hom) hOz_et
      let g_z : V_z ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk O_z.ι rfl trivial
      have _ : CompactSpace ↥V_z.left :=
        (inferInstance : CompactSpace ↥(O_z : AlgebraicGeometry.Scheme.{u}))
      obtain ⟨j_z, hj_z⟩ := hQcExh V_z (ℱ.obj.map (Opposite.op g_z) s₀)
      exact ⟨V_z, g_z, ⟨z, hz_Oz⟩, ⟨j_z, hj_z⟩, inferInstance, rfl⟩
    have hValIndep : ∀ (t : CategoryTheory.Limits.Cocone D)
        {V : S.Etale} (s_V : ↥(ℱ.obj.obj (Opposite.op V)))
        (j₁ j₂ : Idx) (h₁ : s_V ∈ A_sub j₁ V) (h₂ : s_V ∈ A_sub j₂ V),
        ((t.ι.app j₁).hom.app (Opposite.op V)) ⟨s_V, h₁⟩ =
          ((t.ι.app j₂).hom.app (Opposite.op V)) ⟨s_V, h₂⟩ := by
      intro t V s_V j₁ j₂ h₁ h₂
      let j₁₂ : Idx := j₁ ⊔ j₂
      have h₁₂ : s_V ∈ A_sub j₁₂ V :=
        (map_pre (le_sup_left : j₁ ≤ j₁₂)).app (Opposite.op V) ⟨s_V, h₁⟩ |>.2
      have hw₁ := t.w (homOfLE (le_sup_left : j₁ ≤ j₁₂))
      have hw₂ := t.w (homOfLE (le_sup_right : j₂ ≤ j₁₂))
      have heq₁ :=
        congrArg (fun (f : D.obj j₁ ⟶ t.pt) => (f.hom.app (Opposite.op V)) ⟨s_V, h₁⟩) hw₁
      have heq₂ :=
        congrArg (fun (f : D.obj j₂ ⟶ t.pt) => (f.hom.app (Opposite.op V)) ⟨s_V, h₂⟩) hw₂
      exact heq₁.symm.trans heq₂
    have hDescEx : ∀ (t : CategoryTheory.Limits.Cocone D),
        ∃ (φ : ℱ ⟶ t.pt),
          (∀ j : Idx, c_colim.ι.app j ≫ φ = t.ι.app j) ∧
          ∀ (m : ℱ ⟶ t.pt), (∀ j : Idx, c_colim.ι.app j ≫ m = t.ι.app j) → m = φ := by
      intro t
      let Sh_t := (CategoryTheory.Presheaf.isSheaf_iff_isLimit _ t.pt.obj).mp t.pt.property
      let Z_pt : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
      let cone_s₀ : ∀ (U₀ : S.Etale) (s₀ : ↥(ℱ.obj.obj (Opposite.op U₀))),
          Limits.Cone ((R_exh U₀ s₀).arrows.diagram.op ⋙ t.pt.obj) :=
        fun U₀ s₀ =>
          { pt := Z_pt
            π :=
              { app := fun k =>
                  let V_k : S.Etale := k.unop.obj.left
                  let g_k : V_k ⟶ U₀ := k.unop.obj.hom
                  let hk_prop : ∃ j : Idx, ℱ.obj.map (Opposite.op g_k) s₀ ∈ A_sub j V_k :=
                    k.unop.property
                  let j_k : Idx := Classical.choose hk_prop
                  let hj_k := Classical.choose_spec hk_prop
                  let val_k : ↥(t.pt.obj.obj (Opposite.op V_k)) :=
                    ((t.ι.app j_k).hom.app (Opposite.op V_k)) ⟨_, hj_k⟩
                  AddCommGrpCat.ofHom
                    { toFun := fun n => n.down • val_k
                      map_zero' := zero_zsmul val_k
                      map_add' := fun a b => add_zsmul val_k a.down b.down }
                naturality := fun {k₁ k₂} u => by
                  apply AddCommGrpCat.ext
                  intro ⟨n⟩
                  let V₁ : S.Etale := k₁.unop.obj.left
                  let g₁ : V₁ ⟶ U₀ := k₁.unop.obj.hom
                  let hk₁_prop : ∃ j : Idx, ℱ.obj.map (Opposite.op g₁) s₀ ∈ A_sub j V₁ :=
                    k₁.unop.property
                  let j₁ := Classical.choose hk₁_prop
                  let hj₁ := Classical.choose_spec hk₁_prop
                  let V₂ : S.Etale := k₂.unop.obj.left
                  let g₂ : V₂ ⟶ U₀ := k₂.unop.obj.hom
                  let hk₂_prop : ∃ j : Idx, ℱ.obj.map (Opposite.op g₂) s₀ ∈ A_sub j V₂ :=
                    k₂.unop.property
                  let j₂ := Classical.choose hk₂_prop
                  let hj₂ := Classical.choose_spec hk₂_prop
                  let u_mor : V₂ ⟶ V₁ := u.unop.hom.left
                  have hu_w : u_mor ≫ g₁ = g₂ := CategoryTheory.Over.w u.unop.hom
                  let op_u : Opposite.op V₁ ⟶ Opposite.op V₂ := Opposite.op u_mor
                  have hnat_mor : (P_sub j₁).map op_u ≫
                      (t.ι.app j₁).hom.app (Opposite.op V₂) =
                      (t.ι.app j₁).hom.app (Opposite.op V₁) ≫
                        t.pt.obj.map op_u :=
                    (t.ι.app j₁).hom.naturality op_u
                  have hnat_j₁ := congrArg
                    (fun (f : (P_sub j₁).obj (Opposite.op V₁) ⟶ t.pt.obj.obj (Opposite.op V₂)) =>
                      f ⟨_, hj₁⟩) hnat_mor
                  change (𝟙 Z_pt ≫ _) (ULift.up n) = _
                  rw [Category.id_comp]
                  change n • (((t.ι.app j₂).hom.app (Opposite.op V₂)) ⟨_, hj₂⟩) =
                    (t.pt.obj.map (Opposite.op u_mor))
                      (n • (((t.ι.app j₁).hom.app (Opposite.op V₁)) ⟨_, hj₁⟩))
                  rw [map_zsmul]
                  congr 1
                  have h_eq_sec : ℱ.obj.map g₂.op s₀ =
                      ℱ.obj.map op_u (ℱ.obj.map g₁.op s₀) :=
                    (congrArg (fun (h : V₂ ⟶ U₀) => ℱ.obj.map h.op s₀) hu_w.symm).trans
                      (hMapComp ℱ u_mor g₁ s₀)
                  have hj₁_pull : ℱ.obj.map g₂.op s₀ ∈ A_sub j₁ V₂ := by
                    rw [h_eq_sec]
                    exact ((P_sub j₁).map op_u ⟨_, hj₁⟩).2
                  have hind := hValIndep t (ℱ.obj.map g₂.op s₀)
                    j₂ j₁ hj₂ hj₁_pull
                  refine hind.trans ?_
                  have hsub_eq : (⟨ℱ.obj.map g₂.op s₀, hj₁_pull⟩ :
                        ↥(A_sub j₁ V₂)) =
                      (P_sub j₁).map op_u ⟨_, hj₁⟩ :=
                    Subtype.ext h_eq_sec
                  rw [hsub_eq]
                  exact hnat_j₁ } }
      let evalPt : ∀ (U₀ : S.Etale), ↥(ℱ.obj.obj (Opposite.op U₀)) →
          ↥(t.pt.obj.obj (Opposite.op U₀)) :=
        fun U₀ s₀ =>
          let hLim_t := Classical.choice (Sh_t (R_exh U₀ s₀) (hRexh_mem U₀ s₀))
          (hLim_t.lift (cone_s₀ U₀ s₀)) (ULift.up (1 : ℤ))
      have heval_spec : ∀ (U₀ : S.Etale) (s₀ : ↥(ℱ.obj.obj (Opposite.op U₀)))
          {V : S.Etale} (g : V ⟶ U₀) (j : Idx)
          (hj : ℱ.obj.map (Opposite.op g) s₀ ∈ A_sub j V),
          t.pt.obj.map (Opposite.op g) (evalPt U₀ s₀) =
            ((t.ι.app j).hom.app (Opposite.op V)) ⟨_, hj⟩ := by
        intro U₀ s₀ V g j hj
        let R₀ := R_exh U₀ s₀
        let hLim_t := Classical.choice (Sh_t R₀ (hRexh_mem U₀ s₀))
        have hg_mem : R₀.arrows g := ⟨j, hj⟩
        let obj_g : R₀.arrows.category :=
          CategoryTheory.ObjectProperty.FullSubcategory.mk (CategoryTheory.Over.mk g) hg_mem
        have hfac := hLim_t.fac (cone_s₀ U₀ s₀) (Opposite.op obj_g)
        have hfac_1 := congrArg
          (fun (f : Z_pt ⟶ t.pt.obj.obj (Opposite.op V)) => f (ULift.up (1 : ℤ))) hfac
        dsimp [evalPt]
        refine hfac_1.trans ?_
        change (1 : ℤ) • (((t.ι.app (Classical.choose hg_mem)).hom.app (Opposite.op V))
          ⟨_, Classical.choose_spec hg_mem⟩) = _
        rw [one_zsmul]
        exact hValIndep t _ (Classical.choose hg_mem) j (Classical.choose_spec hg_mem) hj
      have heval_zero : ∀ (U₀ : S.Etale), evalPt U₀ 0 = 0 := by
        intro U₀
        have h0_mem : ℱ.obj.map (Opposite.op (𝟙 U₀)) 0 ∈ A_sub botIdx U₀ := by simp
        have hid := heval_spec U₀ 0 (𝟙 U₀) botIdx h0_mem
        rw [hMapId t.pt U₀ (evalPt U₀ 0)] at hid
        have hsub0 : (⟨ℱ.obj.map (Opposite.op (𝟙 U₀)) 0, h0_mem⟩ :
            ↥(A_sub botIdx U₀)) = 0 := Subtype.ext (map_zero _)
        exact hid.trans
          ((congrArg ((t.ι.app botIdx).hom.app (Opposite.op U₀)) hsub0).trans
            (map_zero _))
      have heval_add : ∀ (U₀ : S.Etale) (s₁ s₂ : ↥(ℱ.obj.obj (Opposite.op U₀))),
          evalPt U₀ (s₁ + s₂) = evalPt U₀ s₁ + evalPt U₀ s₂ := by
        intro U₀ s₁ s₂
        let R₁₂ := R_exh U₀ s₁ ⊓ R_exh U₀ s₂
        have hR₁₂ : R₁₂ ∈ S.smallEtaleTopology U₀ :=
          S.smallEtaleTopology.intersection_covering
            (hRexh_mem U₀ s₁) (hRexh_mem U₀ s₂)
        refine hSheafSep t.pt U₀ R₁₂ hR₁₂ (evalPt U₀ (s₁ + s₂))
          (evalPt U₀ s₁ + evalPt U₀ s₂) ?_
        intro V g hmem
        rcases hmem with ⟨⟨j₁, hj₁⟩, ⟨j₂, hj₂⟩⟩
        let j := j₁ ⊔ j₂
        have hj₁' : ℱ.obj.map (Opposite.op g) s₁ ∈ A_sub j V :=
          (map_pre (le_sup_left : j₁ ≤ j)).app (Opposite.op V) ⟨_, hj₁⟩ |>.2
        have hj₂' : ℱ.obj.map (Opposite.op g) s₂ ∈ A_sub j V :=
          (map_pre (le_sup_right : j₂ ≤ j)).app (Opposite.op V) ⟨_, hj₂⟩ |>.2
        have hj_sum : ℱ.obj.map (Opposite.op g) (s₁ + s₂) ∈ A_sub j V := by
          rw [map_add]
          exact (A_sub j V).add_mem hj₁' hj₂'
        rw [map_add, heval_spec U₀ (s₁ + s₂) g j hj_sum,
          heval_spec U₀ s₁ g j hj₁', heval_spec U₀ s₂ g j hj₂', ← map_add]
        congr 1
        exact Subtype.ext (map_add _ s₁ s₂)
      have heval_nat : ∀ {opU₁ opU₂ : (S.Etale)ᵒᵖ} (f : opU₁ ⟶ opU₂)
