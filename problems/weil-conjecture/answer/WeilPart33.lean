        have hj_g : ℱ.obj.map (Opposite.op g) (ℱ.obj.map f s₁) ∈ A_sub j V := by
          rwa [hcomp_s]
        rw [heval_spec U₂ (ℱ.obj.map f s₁) g j hj_g]
        have hcomp_t : t.pt.obj.map (Opposite.op g) (t.pt.obj.map f (evalPt U₁ s₁)) =
            t.pt.obj.map (Opposite.op (g ≫ u)) (evalPt U₁ s₁) :=
          (hMapComp t.pt g u (evalPt U₁ s₁)).symm
        rw [hcomp_t, heval_spec U₁ s₁ (g ≫ u) j hj]
        congr 1
        exact Subtype.ext hcomp_s
      let φ : ℱ ⟶ t.pt :=
        ObjectProperty.homMk
          { app := fun opU =>
              AddCommGrpCat.ofHom
                { toFun := evalPt (Opposite.unop opU)
                  map_zero' := heval_zero (Opposite.unop opU)
                  map_add' := heval_add (Opposite.unop opU) }
