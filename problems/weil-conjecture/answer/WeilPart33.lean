by
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all

  have hEtale_inr : ∀ {R A B : CommRingCat.{u}} (f : R ⟶ A) (g : R ⟶ B),
      f.hom.Etale → (CategoryTheory.Limits.pushout.inr f g).hom.Etale := by
    intro R A B f g hf
    have h1 : (CategoryTheory.Limits.pushout.inl g f).hom.Etale :=
      RingHom.Etale.isStableUnderBaseChange.pushout_inl RingHom.Etale.respectsIso g f hf
    have hP_flip : CategoryTheory.IsPushout g f
        (CategoryTheory.Limits.pushout.inr f g) (CategoryTheory.Limits.pushout.inl f g) :=
      (CategoryTheory.IsPushout.of_hasPushout f g).flip
    let e := hP_flip.isoPushout
    have heq : CategoryTheory.Limits.pushout.inr f g =
        CategoryTheory.Limits.pushout.inl g f ≫ e.inv :=
      (hP_flip.inl_isoPushout_inv).symm
    have h_sch : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CategoryTheory.Limits.pushout.inr f g)) := by
      rw [heq, AlgebraicGeometry.Spec.map_comp]
      have h1_sch : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CategoryTheory.Limits.pushout.inl g f)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr h1
      have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
        inferInstance h1_sch
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp h_sch

  have hPushoutColim : ∀ (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥] [CategoryTheory.IsFiltered 𝒥]
      {R₀ S₀ P_inf : CommRingCat.{u}}
      (F : CategoryTheory.Functor 𝒥 CommRingCat.{u})
      (α : Quiver.Hom ((CategoryTheory.Functor.const 𝒥).obj R₀) F)
      (c_F : CategoryTheory.Limits.Cocone F)
      (hc_F : CategoryTheory.Limits.IsColimit c_F)
      (ψ : R₀ ⟶ S₀) (φ : R₀ ⟶ c_F.pt) (j_S : S₀ ⟶ P_inf) (i_inf : c_F.pt ⟶ P_inf)
      (hP : CategoryTheory.IsPushout ψ φ j_S i_inf)
      (hα : ∀ j : 𝒥, α.app j ≫ c_F.ι.app j = φ),
      ∃ (G : CategoryTheory.Functor 𝒥 CommRingCat.{u})
        (γ : Quiver.Hom ((CategoryTheory.Functor.const 𝒥).obj S₀) G)
        (δ : Quiver.Hom F G)
        (β : Quiver.Hom G ((CategoryTheory.Functor.const 𝒥).obj P_inf)),
        Nonempty (CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk P_inf β)) ∧
        (∀ j : 𝒥, γ.app j ≫ β.app j = j_S) ∧
        (∀ j : 𝒥, δ.app j ≫ β.app j = c_F.ι.app j ≫ i_inf) ∧
        (∀ j : 𝒥, (α.app j).hom.Etale → (γ.app j).hom.Etale) ∧
        (ψ.hom.Etale → ∀ j : 𝒥, (δ.app j).hom.Etale) := by
    intro 𝒥 _ _ R₀ S₀ P_inf F α c_F hc_F ψ φ j_S i_inf hP hα
    have hα_nat : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂), α.app j₁ ≫ F.map θ = α.app j₂ := by
      intro j₁ j₂ θ
      have h := α.naturality θ
      dsimp at h
      rw [CategoryTheory.Category.id_comp] at h
      exact h.symm
    have hG_cond : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂),
        ψ ≫ CategoryTheory.Limits.pushout.inl ψ (α.app j₂) =
          α.app j₁ ≫ (F.map θ ≫ CategoryTheory.Limits.pushout.inr ψ (α.app j₂)) := by
      intro j₁ j₂ θ
      rw [← CategoryTheory.Category.assoc, hα_nat θ]
      exact CategoryTheory.Limits.pushout.condition
    let G : CategoryTheory.Functor 𝒥 CommRingCat.{u} :=
      { obj := fun j => CategoryTheory.Limits.pushout ψ (α.app j)
        map := fun θ => CategoryTheory.Limits.pushout.desc
          (CategoryTheory.Limits.pushout.inl ψ (α.app _))
          (F.map θ ≫ CategoryTheory.Limits.pushout.inr ψ (α.app _)) (hG_cond θ)
        map_id := fun j => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Limits.pushout.inr_desc, F.map_id,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
        map_comp := fun {j₁ j₂ j₃} θ₁ θ₂ => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc,
              CategoryTheory.Limits.pushout.inl_desc_assoc,
              CategoryTheory.Limits.pushout.inl_desc]
          · rw [CategoryTheory.Limits.pushout.inr_desc,
              CategoryTheory.Limits.pushout.inr_desc_assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pushout.inr_desc, F.map_comp, CategoryTheory.Category.assoc] }
    let γ : Quiver.Hom ((CategoryTheory.Functor.const 𝒥).obj S₀) G :=
      { app := fun j => CategoryTheory.Limits.pushout.inl ψ (α.app j)
        naturality := fun {j₁ j₂} θ => by
          dsimp [G]
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Limits.pushout.inl_desc] }
    let δ : Quiver.Hom F G :=
      { app := fun j => CategoryTheory.Limits.pushout.inr ψ (α.app j)
        naturality := fun {j₁ j₂} θ => by
          dsimp [G]
          exact (CategoryTheory.Limits.pushout.inr_desc _ _ _).symm }
    have hβ_cond : ∀ j : 𝒥, ψ ≫ j_S = α.app j ≫ (c_F.ι.app j ≫ i_inf) := by
      intro j
      rw [← CategoryTheory.Category.assoc, hα j]
      exact hP.w
    let β : Quiver.Hom G ((CategoryTheory.Functor.const 𝒥).obj P_inf) :=
      { app := fun j => CategoryTheory.Limits.pushout.desc j_S (c_F.ι.app j ≫ i_inf) (hβ_cond j)
        naturality := fun {j₁ j₂} θ => by
          dsimp [G]
          rw [CategoryTheory.Category.comp_id]
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc_assoc,
              CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Limits.pushout.inl_desc]
          · rw [CategoryTheory.Limits.pushout.inr_desc_assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pushout.inr_desc, CategoryTheory.Limits.pushout.inr_desc,
              ← CategoryTheory.Category.assoc, c_F.w θ] }
    have : Nonempty 𝒥 := CategoryTheory.IsFiltered.nonempty
    let j₀ : 𝒥 := Classical.arbitrary 𝒥
    have hinl_const : ∀ (s : CategoryTheory.Limits.Cocone G) (j : 𝒥),
        γ.app j ≫ s.ι.app j = γ.app j₀ ≫ s.ι.app j₀ := by
      intro s j
      let k := CategoryTheory.IsFiltered.max j j₀
      let θ₁ := CategoryTheory.IsFiltered.leftToMax j j₀
      let θ₂ := CategoryTheory.IsFiltered.rightToMax j j₀
      have h1 : γ.app j ≫ s.ι.app j = γ.app k ≫ s.ι.app k := by
        rw [← s.w θ₁, ← CategoryTheory.Category.assoc]
        dsimp [G, γ]
        rw [CategoryTheory.Limits.pushout.inl_desc]
      have h2 : γ.app j₀ ≫ s.ι.app j₀ = γ.app k ≫ s.ι.app k := by
        rw [← s.w θ₂, ← CategoryTheory.Category.assoc]
        dsimp [G, γ]
        rw [CategoryTheory.Limits.pushout.inl_desc]
      exact h1.trans h2.symm
    let s_F_of : ∀ (s : CategoryTheory.Limits.Cocone G), CategoryTheory.Limits.Cocone F :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun j => δ.app j ≫ s.ι.app j
              naturality := fun {j₁ j₂} θ => by
                dsimp
                rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
                  δ.naturality θ, CategoryTheory.Category.assoc, s.w θ] } }
    have hd_cond : ∀ (s : CategoryTheory.Limits.Cocone G),
        ψ ≫ (γ.app j₀ ≫ s.ι.app j₀) = φ ≫ hc_F.desc (s_F_of s) := by
      intro s
      rw [← hα j₀, CategoryTheory.Category.assoc, hc_F.fac (s_F_of s) j₀]
      dsimp [s_F_of, γ, δ]
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
      exact congrArg (· ≫ s.ι.app j₀) CategoryTheory.Limits.pushout.condition
    have hc_G : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.Cocone.mk P_inf β) :=
      { desc := fun s => hP.desc (γ.app j₀ ≫ s.ι.app j₀) (hc_F.desc (s_F_of s)) (hd_cond s)
        fac := fun s j => by
          dsimp [G, β]
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc_assoc, hP.inl_desc]
            exact (hinl_const s j).symm
          · rw [CategoryTheory.Limits.pushout.inr_desc_assoc, CategoryTheory.Category.assoc,
              hP.inr_desc, hc_F.fac (s_F_of s) j]
        uniq := fun s m hm => by
          apply hP.hom_ext
          · rw [hP.inl_desc]
            have hmj₀ := hm j₀
            dsimp [β, γ] at hmj₀ ⊢
            rw [← hmj₀, CategoryTheory.Limits.pushout.inl_desc_assoc]
          · rw [hP.inr_desc]
            apply hc_F.hom_ext
            intro j
            rw [hc_F.fac (s_F_of s) j]
            have hmj := hm j
            dsimp [s_F_of, β, δ] at hmj ⊢
            rw [← hmj, CategoryTheory.Limits.pushout.inr_desc_assoc]
            exact (CategoryTheory.Category.assoc _ _ _).symm }
    exact ⟨G, γ, δ, β, ⟨hc_G⟩,
      fun j => CategoryTheory.Limits.pushout.inl_desc _ _ _,
      fun j => CategoryTheory.Limits.pushout.inr_desc _ _ _,
      fun j h => RingHom.Etale.isStableUnderBaseChange.pushout_inl RingHom.Etale.respectsIso
        ψ (α.app j) h,
      fun h j => hEtale_inr ψ (α.app j) h⟩

  let c_K := colim_c.extend e_pt.hom
  have hc_K : CategoryTheory.Limits.IsColimit c_K := hColim.extendIso e_pt.hom
  obtain ⟨B_D, γ_B, _, β_B, ⟨hc_B⟩, hγβ_B, _, hγB_et_imp, _⟩ :=
    hPushoutColim ℐ D α_D c_K hc_K
      (CommRingCat.ofHom f_c) (CommRingCat.ofHom φ_sep)
      (CommRingCat.ofHom j_C₀) (CommRingCat.ofHom i_sep)
      hPush.flip hα_comp
  have hγB_et : ∀ i : ℐ, (CommRingCat.Hom.hom (γ_B.app i)).Etale :=
    fun i => hγB_et_imp i (hα_et i)

  let c_B := CategoryTheory.Limits.Cocone.mk (CommRingCat.of B_sep) β_B
  obtain ⟨i₀, n, J₀, g₀, hf_E₀, hPush_E₀⟩ :=
    (hEtDesc.1 ℐ B_D c_B hc_B).1 (CommRingCat.of C'_sep) (CommRingCat.ofHom g_sep) hg_sep
  let E₀ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin n) ↑(B_D.obj i₀) ⧸ J₀)
  let f_E₀ : B_D.obj i₀ ⟶ E₀ := CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)

  let ℐ' : Type u := CategoryTheory.Under i₀
  let U_fgt := CategoryTheory.Under.forget i₀
  let B_D' := U_fgt.comp B_D
  let c_B' := c_B.whisker U_fgt
  have hc_B' : CategoryTheory.Limits.IsColimit c_B' :=
    (CategoryTheory.Functor.Final.isColimitWhiskerEquiv U_fgt c_B).symm hc_B
  let α_B' : Quiver.Hom ((CategoryTheory.Functor.const ℐ').obj (B_D.obj i₀)) B_D' :=
    { app := fun u => B_D.map u.hom
      naturality := fun {u₁ u₂} θ => by
        dsimp [B_D', U_fgt]
        rw [CategoryTheory.Category.id_comp, ← B_D.map_comp, CategoryTheory.Under.w θ] }
  have hα_B'_comp : ∀ u : ℐ', α_B'.app u ≫ c_B'.ι.app u = β_B.app i₀ := by
    intro u
    dsimp [α_B', c_B', c_B, U_fgt]
    have hnat := β_B.naturality u.hom
    dsimp at hnat
    rw [CategoryTheory.Category.comp_id] at hnat
    exact hnat

  obtain ⟨E_D, _, δ_E, β_E, ⟨hc_E⟩, _, hδβ_E, _, hδE_et_imp⟩ :=
    hPushoutColim ℐ' B_D' α_B' c_B' hc_B'
      f_E₀ (β_B.app i₀) g₀ (CommRingCat.ofHom g_sep)
      hPush_E₀.flip hα_B'_comp
  have hδE_et : ∀ u : ℐ', (CommRingCat.Hom.hom (δ_E.app u)).Etale :=
    hδE_et_imp hf_E₀

  let γ_B' : Quiver.Hom ((CategoryTheory.Functor.const ℐ').obj (CommRingCat.of C₀)) B_D' :=
    { app := fun u => γ_B.app u.right
      naturality := fun {u₁ u₂} θ => by
        dsimp [B_D', U_fgt]
        exact γ_B.naturality θ.right }
  let γ_E : Quiver.Hom ((CategoryTheory.Functor.const ℐ').obj (CommRingCat.of C₀)) E_D :=
    γ_B' ≫ δ_E

  have hγE_et : ∀ u : ℐ', (CommRingCat.Hom.hom (γ_E.app u)).Etale := by
    intro u
    change (CommRingCat.Hom.hom (γ_B'.app u ≫ δ_E.app u)).Etale
    rw [CommRingCat.hom_comp]
    exact RingHom.Etale.stableUnderComposition _ _ (hγB_et u.right) (hδE_et u)

  have hγE_βE : ∀ u : ℐ', γ_E.app u ≫ β_E.app u = CommRingCat.ofHom (g_sep.comp j_C₀) := by
    intro u
    change (γ_B'.app u ≫ δ_E.app u) ≫ β_E.app u = _
    rw [CategoryTheory.Category.assoc, hδβ_E u]
    change γ_B.app u.right ≫ (β_B.app u.right ≫ CommRingCat.ofHom g_sep) = _
    rw [← CategoryTheory.Category.assoc, hγβ_B u.right, ← CommRingCat.ofHom_comp]

  have hu₁_comp : ∀ u : ℐ', (u'_sep.comp (β_E.app u).hom).comp (γ_E.app u).hom = u₀ := by
    intro u
    calc
      (u'_sep.comp (β_E.app u).hom).comp (γ_E.app u).hom
        = u'_sep.comp ((β_E.app u).hom.comp (γ_E.app u).hom) := RingHom.comp_assoc _ _ _
      _ = u'_sep.comp (CommRingCat.Hom.hom (γ_E.app u ≫ β_E.app u)) := by
          rw [← CommRingCat.hom_comp]
      _ = u'_sep.comp (g_sep.comp j_C₀) := by rw [hγE_βE u]; rfl
      _ = (u'_sep.comp g_sep).comp j_C₀ := (RingHom.comp_assoc _ _ _).symm
      _ = u_sep.comp j_C₀ := by rw [hu'_sep]
      _ = u₀ := hu_sep_j

  let P_poly : CategoryTheory.Functor CommRingCat.{u} CommRingCat.{u} :=
    { obj := fun R => CommRingCat.of (Polynomial ↥R)
      map := fun f => CommRingCat.ofHom (Polynomial.mapRingHom (CommRingCat.Hom.hom f))
      map_id := fun R =>
        (congrArg CommRingCat.ofHom
          ((congrArg Polynomial.mapRingHom (CommRingCat.hom_id (R := R))).trans
            (Polynomial.mapRingHom_id (R := ↥R)))).trans
          CommRingCat.ofHom_id
      map_comp := fun f g =>
        (congrArg CommRingCat.ofHom
          ((congrArg Polynomial.mapRingHom (CommRingCat.hom_comp f g)).trans
            (Polynomial.mapRingHom_comp g.hom f.hom).symm)).trans
          (CommRingCat.ofHom_comp (Polynomial.mapRingHom f.hom) (Polynomial.mapRingHom g.hom)) }

  let c_E := CategoryTheory.Limits.Cocone.mk (CommRingCat.of C'_sep) β_E
  let P_E := E_D.comp P_poly
  let c_P := P_poly.mapCocone c_E

  have hC_nat : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S),
      f ≫ CommRingCat.ofHom Polynomial.C = CommRingCat.ofHom Polynomial.C ≫ P_poly.map f := by
    intro R S f
    apply CommRingCat.hom_ext
    ext r
    simp [P_poly]

  have hc_P : CategoryTheory.Limits.IsColimit c_P := by
    have : Nonempty ℐ' := CategoryTheory.IsFiltered.nonempty
    let u_arb : ℐ' := Classical.arbitrary ℐ'
    let s_coeff_of : ∀ (s : CategoryTheory.Limits.Cocone P_E), CategoryTheory.Limits.Cocone E_D :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun u => CommRingCat.ofHom Polynomial.C ≫ s.ι.app u
              naturality := fun {u₁ u₂} θ => by
                dsimp
                rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
                  hC_nat (E_D.map θ), CategoryTheory.Category.assoc]
                exact congrArg (CommRingCat.ofHom Polynomial.C ≫ ·) (s.w θ) } }
    have hwX_const : ∀ (s : CategoryTheory.Limits.Cocone P_E) (u : ℐ'),
        (s.ι.app u).hom Polynomial.X = (s.ι.app u_arb).hom Polynomial.X := by
      intro s u
      let k := CategoryTheory.IsFiltered.max u u_arb
      let θ₁ := CategoryTheory.IsFiltered.leftToMax u u_arb
      let θ₂ := CategoryTheory.IsFiltered.rightToMax u u_arb
      have h1 : (s.ι.app u).hom Polynomial.X = (s.ι.app k).hom Polynomial.X := by
        rw [← s.w θ₁]
        simp [P_E, P_poly]
        rfl
      have h2 : (s.ι.app u_arb).hom Polynomial.X = (s.ι.app k).hom Polynomial.X := by
        rw [← s.w θ₂]
        simp [P_E, P_poly]
        rfl
      exact h1.trans h2.symm
    refine
      { desc := fun s =>
          CommRingCat.ofHom
            (Polynomial.eval₂RingHom (hc_E.desc (s_coeff_of s)).hom ((s.ι.app u_arb).hom Polynomial.X))
        fac := fun s u => by
          apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · ext r
            have hfac := congrArg (fun k => k.hom r) (hc_E.fac (s_coeff_of s) u)
            simpa [c_P, c_E, P_poly, s_coeff_of] using hfac
          · simp [c_P, c_E, P_poly, hwX_const s u]
        uniq := fun s m hm => by
          have hm_coeff : CommRingCat.ofHom Polynomial.C ≫ m = hc_E.desc (s_coeff_of s) := by
            apply hc_E.hom_ext
            intro u
            rw [hc_E.fac (s_coeff_of s) u, ← CategoryTheory.Category.assoc]
            dsimp [c_E, s_coeff_of]
            rw [hC_nat (β_E.app u), CategoryTheory.Category.assoc]
            exact congrArg (CommRingCat.ofHom Polynomial.C ≫ ·) (hm u)
          apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · ext r
            have h1 := congrArg (fun k => k.hom r) hm_coeff
            simpa using h1
          · have hm_u₀ := congrArg (fun k => k.hom Polynomial.X) (hm u_arb)
            simpa [c_P, c_E, P_poly] using hm_u₀ }

  let B₀ : CommRingCat.{u} := CommRingCat.of (Polynomial C₀)
  let Z₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B₀
  let α_P : Quiver.Hom ((CategoryTheory.Functor.const ℐ').obj B₀) P_E :=
    { app := fun u => P_poly.map (γ_E.app u)
      naturality := fun {u₁ u₂} θ => by
        dsimp [P_E]
        rw [CategoryTheory.Category.id_comp, ← P_poly.map_comp]
        have hnat := γ_E.naturality θ
        dsimp at hnat
        rw [CategoryTheory.Category.id_comp] at hnat
        rw [← hnat] }

  let f_inf : Quiver.Hom B₀ c_P.pt :=
    CommRingCat.ofHom (Polynomial.mapRingHom (g_sep.comp j_C₀))
  have hα_P_comp : ∀ u : ℐ',
      CategoryTheory.CategoryStruct.comp (α_P.app u) (c_P.ι.app u) = f_inf := by
    intro u
    dsimp [α_P, c_P, c_E, f_inf]
    rw [← P_poly.map_comp, hγE_βE u]

  have hMapsTo_of_pull : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (r : ℕ)
      (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj F₀).H r),
      WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq F₀ r x₂
        (weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite π₁ π₂ h h_eq F₀ r x₂) := by
    intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq F₀ r x₂
    exact ⟨@hc_all Y₁ Y₂ h, @hr_all Y₁ Y₂ h, (hSite.1 h).1, (hSite.1 h).2.1,
      (hSite.1 h).2.2.1, (hSite.1 h).2.2.2, rfl⟩

  have hMapsTo_unique : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (r : ℕ)
      (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj F₀).H r)
      (y₁ y₂ : (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₁.smallEtaleTopology).obj F₀).H r),
      WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq F₀ r x₂ y₁ →
      WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq F₀ r x₂ y₂ →
      y₁ = y₂ := by
    intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq F₀ r x₂ y₁ y₂ h1 h2
    rcases h1 with ⟨hc1, hr1, hAdd1, hLim1, hColim1, hIso1, heq1⟩
    rcases h2 with ⟨hc2, hr2, hAdd2, hLim2, hColim2, hIso2, heq2⟩
    have : hc1 = hc2 := Subsingleton.elim _ _; subst this
    have : hr1 = hr2 := Subsingleton.elim _ _; subst this
    have : hAdd1 = hAdd2 := Subsingleton.elim _ _; subst this
    have : hLim1 = hLim2 := Subsingleton.elim _ _; subst this
    have : hColim1 = hColim2 := Subsingleton.elim _ _; subst this
    have : hIso1 = hIso2 := Subsingleton.elim _ _; subst this
    exact heq1.symm.trans heq2

  have : Nonempty ℐ' := CategoryTheory.IsFiltered.nonempty
  let u_init : ℐ' := Classical.arbitrary ℐ'
  let p_i : ∀ u : ℐ', Quiver.Hom (AlgebraicGeometry.Spec (P_E.obj u)) Z₀ :=
    fun u => AlgebraicGeometry.Spec.map (α_P.app u)
  let p_inf : Quiver.Hom (AlgebraicGeometry.Spec c_P.pt) Z₀ :=
    AlgebraicGeometry.Spec.map f_inf
  let u_i : ∀ u : ℐ', Quiver.Hom (AlgebraicGeometry.Spec c_P.pt)
      (AlgebraicGeometry.Spec (P_E.obj u)) :=
    fun u => AlgebraicGeometry.Spec.map (c_P.ι.app u)
  have hu_init : CategoryTheory.CategoryStruct.comp (u_i u_init) (p_i u_init) = p_inf :=
    (AlgebraicGeometry.Spec.map_comp (α_P.app u_init) (c_P.ι.app u_init)).symm.trans
      (congrArg AlgebraicGeometry.Spec.map (hα_P_comp u_init))

  let s₀ := weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite
    (p_i u_init) (CategoryTheory.CategoryStruct.id Z₀) (p_i u_init)
    (CategoryTheory.Category.comp_id (p_i u_init)) 𝒢₀ b ξ_id
  have hm₁ : WeilEtaleTrianglePullbackMapsTo
      (p_i u_init) (CategoryTheory.CategoryStruct.id Z₀) (p_i u_init)
      (CategoryTheory.Category.comp_id (p_i u_init)) 𝒢₀ b ξ_id s₀ :=
    hMapsTo_of_pull _ _ _ _ 𝒢₀ b ξ_id

  let s_inf := weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite
    p_inf (p_i u_init) (u_i u_init) hu_init 𝒢₀ b s₀
  have hm₂ : WeilEtaleTrianglePullbackMapsTo
      p_inf (p_i u_init) (u_i u_init) hu_init 𝒢₀ b s₀ s_inf :=
    hMapsTo_of_pull _ _ _ _ 𝒢₀ b s₀

  have hm_comp_raw := hSite.2.2.2.1 (p_i u_init) (CategoryTheory.CategoryStruct.id Z₀) p_inf
    (p_i u_init) (u_i u_init) (CategoryTheory.Category.comp_id (p_i u_init)) hu_init
    (by rw [hu_init, CategoryTheory.Category.comp_id])
    𝒢₀ b ξ_id s₀ s_inf hm₁ hm₂
  have hm_comp : WeilEtaleTrianglePullbackMapsTo
      p_inf (CategoryTheory.CategoryStruct.id Z₀) p_inf
      (CategoryTheory.Category.comp_id p_inf) 𝒢₀ b ξ_id s_inf := by
    simpa only [hu_init] using hm_comp_raw

  have hVan_inf : WeilEtaleTrianglePullbackMapsTo
      p_inf (CategoryTheory.CategoryStruct.id Z₀) p_inf
      (CategoryTheory.Category.comp_id p_inf) 𝒢₀ b ξ_id 0 := hVan_sep

  have hs_inf_zero : s_inf = 0 :=
    hMapsTo_unique _ _ _ _ 𝒢₀ b ξ_id s_inf 0 hm_comp hVan_inf

  have hm₂_zero : WeilEtaleTrianglePullbackMapsTo
      p_inf (p_i u_init) (u_i u_init) hu_init 𝒢₀ b s₀ 0 := by
    rwa [hs_inf_zero] at hm₂

  obtain ⟨v, θ, hθ, hm_θ⟩ :=
    (hAffColim ℐ' B₀ P_E α_P c_P hc_P f_inf hα_P_comp 𝒢₀).2 u_init hu_init s₀ hm₂_zero
  have hθ' : CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (P_E.map θ)) (p_i u_init) = p_i v := hθ

  have hv_raw := hSite.2.2.2.1 (p_i u_init) (CategoryTheory.CategoryStruct.id Z₀) (p_i v)
    (p_i u_init) (AlgebraicGeometry.Spec.map (P_E.map θ))
    (CategoryTheory.Category.comp_id (p_i u_init)) hθ'
    (by rw [hθ', CategoryTheory.Category.comp_id])
    𝒢₀ b ξ_id s₀ 0 hm₁ hm_θ
  have hv : WeilEtaleTrianglePullbackMapsTo
      (p_i v) (CategoryTheory.CategoryStruct.id Z₀) (p_i v)
      (CategoryTheory.Category.comp_id (p_i v)) 𝒢₀ b ξ_id 0 := by
    simpa only [hθ'] using hv_raw

  refine ⟨↥(E_D.obj v), inferInstance, (γ_E.app v).hom, u'_sep.comp (β_E.app v).hom,
    hγE_et v, hu₁_comp v, ?_⟩
  exact hv

theorem weil_aff_cd_poly_higherDirectImage_affine_stalk_bridge (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (hSliceIso : WeilEtaleSliceCohomologyIsoHolds.{u} (@hc_all) (@hr_all) hSite)
    (hBaseExt : WeilEtaleBaseExtAndSliceColimitHolds.{u} (@hc_all) (@hr_all) hSite)
    (b : ℕ) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback f).IsContinuous
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
    (∀ (R : Type u) [CommRing R]
       (ℱ : CategoryTheory.Sheaf
         (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))).smallEtaleTopology
         AddCommGrpCat.{u})
       (y : ↥(AlgebraicGeometry.Spec (CommRingCat.of R))),
      let B := AlgebraicGeometry.Spec (CommRingCat.of R)
      let X := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))
      let p : Quiver.Hom X B :=
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))
      let Ω := AlgebraicClosure ↥(B.residueField y)
      (∀ (ev : R →+* Ω),
        RingHom.ker ev = y.asIdeal →
        (∀ z : Ω, ∃ P : Polynomial R,
          Polynomial.map ev P ≠ 0 ∧ Polynomial.eval₂ ev z P = 0) →
        ∀ (C₀ : Type u) [CommRing C₀] (f_C₀ : R →+* C₀) (u₀ : C₀ →+* Ω),
          f_C₀.Etale →
          u₀.comp f_C₀ = ev →
          let Z₀ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial C₀))
          let π₀ : Quiver.Hom Z₀ X :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom f_C₀))
          let 𝒢₀ := ((weilEtaleSitePullback π₀).sheafPullback AddCommGrpCat.{u}
            X.smallEtaleTopology Z₀.smallEtaleTopology).obj ℱ
          ∀ (ξ_id : (((weilEtaleSitePullback (CategoryTheory.CategoryStruct.id Z₀)).sheafPullback
              AddCommGrpCat.{u} Z₀.smallEtaleTopology Z₀.smallEtaleTopology).obj 𝒢₀).H b),
            ∃ (C₁ : Type u) (_ : CommRing C₁) (g₁ : C₀ →+* C₁) (u₁ : C₁ →+* Ω),
              g₁.Etale ∧
              u₁.comp g₁ = u₀ ∧
              let π₁ : Quiver.Hom
                  (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial C₁))) Z₀ :=
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom g₁))
              WeilEtaleTrianglePullbackMapsTo
                π₁ (CategoryTheory.CategoryStruct.id Z₀) π₁
                (CategoryTheory.Category.comp_id π₁) 𝒢₀ b ξ_id 0) →
      WeilAltCdStalkZeroAt
        (AlgebraicGeometry.Spec (CommRingCat.of R))
        (weilAltCdHigherDirectImage
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))) b ℱ)
        y) ∧
    (∀ (κ R₁ B_κ : Type u) [Field κ] [IsAlgClosed κ] [CommRing R₁] [Algebra κ R₁]
       [CommRing B_κ]
       (σ : R₁ →ₐ[κ] κ)
       (g_R₁ : R₁ →+* B_κ) (u_κ : B_κ →+* κ)
       (ℱ₀ : CategoryTheory.Sheaf
         (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R₁))).smallEtaleTopology
         AddCommGrpCat.{u}),
      g_R₁.Etale →
      u_κ.comp g_R₁ = σ.toRingHom →
      (∀ (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ))),
        WeilAltCdStalkZeroAt (AlgebraicGeometry.Spec (CommRingCat.of R₁))
          (weilAltCdHigherDirectImage
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.C : R₁ →+* Polynomial R₁))) b ℱ₀)
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)).base pt)) →
      let X₁ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R₁))
      let Z_B := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B_κ))
      let π_B : Quiver.Hom Z_B X₁ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom g_R₁))
      let 𝒢_B := ((weilEtaleSitePullback π_B).sheafPullback AddCommGrpCat.{u}
        X₁.smallEtaleTopology Z_B.smallEtaleTopology).obj ℱ₀
      ∀ (ξ_id : (((weilEtaleSitePullback (CategoryTheory.CategoryStruct.id Z_B)).sheafPullback
          AddCommGrpCat.{u} Z_B.smallEtaleTopology Z_B.smallEtaleTopology).obj 𝒢_B).H b),
        ∃ (C'_κ : Type u) (_ : CommRing C'_κ) (g_κ : B_κ →+* C'_κ) (u'_κ : C'_κ →+* κ),
          g_κ.Etale ∧
          u'_κ.comp g_κ = u_κ ∧
          let π_C : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial C'_κ))) Z_B :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom g_κ))
          WeilEtaleTrianglePullbackMapsTo
            π_C (CategoryTheory.CategoryStruct.id Z_B) π_C
            (CategoryTheory.Category.comp_id π_C) 𝒢_B b ξ_id 0) :=
by
  classical
  let _ := hBaseExt
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all

  
  have hFunc : WeilEtaleBasePullExtFunctorialityHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_basePullExt_functoriality_and_rebase (@hc_all) (@hr_all) hSite
  have hCore : WeilFreeYonedaPullbackCoreHolds.{u} (@hc_all) (@hr_all) :=
    (weil_etale_freeYoneda_pullback_resolution_and_pushout_effacement
      (@hc_all) (@hr_all) hSite hFunc).1
  have hConst : WeilSliceColimConstAndTerminalHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_const_pullback_cocycle_and_terminal_colimit (@hc_all) (@hr_all) hSite hFunc hCore
  obtain ⟨Θ, _, hΘ_contra⟩ :=
    weil_etale_cohomologyPresheaf_slice_equiv_and_naturality
      (@hc_all) (@hr_all) hSite hFunc hCore hSliceIso hConst

  have hEtComp : ∀ {A₁ A₂ A₃ : Type u} [CommRing A₁] [CommRing A₂] [CommRing A₃]
      {f : A₁ →+* A₂} {g : A₂ →+* A₃},
      f.Etale → g.Etale → (g.comp f).Etale := by
    intro A₁ A₂ A₃ _ _ _ f g hf hg
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hf_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
    have hg_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg
    have hcomp_sch : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (g.comp f))) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _ hg_sch hf_sch
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      hcomp_sch

  let U_of : ∀ (R₀ : Type u) [CommRing R₀] (C : Type u) [CommRing C] (f_C : R₀ →+* C),
      f_C.Etale → (AlgebraicGeometry.Spec (CommRingCat.of R₀)).Etale :=
    fun _ _ _ _ f_C hf_C =>
      CategoryTheory.MorphismProperty.Over.mk ⊤
