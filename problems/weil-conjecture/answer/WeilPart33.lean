          AlgebraicGeometry.Scheme.Hom.appLE_map _ _ _
        rw [← CategoryTheory.Category.assoc, h2]
        have hV_top : (⊤ : V.toScheme.Opens) ≤
            (TopologicalSpace.Opens.map V.ι.base).obj V := by
          intro x _
          exact x.2
        have h3 : V.ι.appLE V ⊤ hV_top = V.topIso.inv := by
          rw [AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.topIso_inv]
          congr 1
        rw [← h3, AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
      have hStd_comp : RingHom.IsStandardSmoothOfRelativeDimension (2 * m + 1)
          (e_UP_cat.hom ≫ (V.ι ≫ g₂.left).appLE U_P ⊤ htop_UP).hom := by
        rw [← happ_factor]
        exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso (2 * m + 1)).cancel_right_isIso
