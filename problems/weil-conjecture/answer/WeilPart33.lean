          { u : AlgebraicGeometry.Spec R'_2 | h_2 ∈ u.asIdeal } := by
      apply Set.ext
      intro u
      have h1 : u ∈ e_B2.base ⁻¹' (Set.range ι_disc.left.base) ↔
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_2)).base u ∈
            j_P.base ⁻¹' (Set.range ι_disc.left.base) := Iff.rfl
      rw [h1, hj_disc]
      exact hDisc_iff u
    let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of k) :=
      ⟨RingHom.ker (RingHom.id k), RingHom.ker_isPrime (RingHom.id k)⟩
    have hu_2_eq : e_B2.base u_2 = ι_disc.left.base c₀ := by
      rw [(hPt_u2_v2 pt₀).1]
      change j_P.base ((AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k)))).base pt₀) = _
      have hpt_eq :
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k)))).base pt₀ =
          ⟨RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k)), RingHom.ker_isPrime _⟩ :=
        PrimeSpectrum.ext rfl
      rw [hpt_eq, hj_c₀]
    exact ⟨{
      j_P := j_P
      y_pt := y_pt
      R'_2 := R'_2
      B'_2 := B'_2
      φ_2 := φ_2
      u_2 := u_2
      v_2 := v_2
      e_B2 := e_B2
      h_2 := h_2
      ψ_B2 := ψ_B2
      e_Y2 := e_Y2
      q_2 := q_2
      hj_range := hj_range
      hj_hom := hj_hom
      hj_coord := hj_coord
      he_B2_def := rfl
      hy_hom := hy_hom
      hy_g₂ := hy_g₂
      he_B2_et := he_B2_et
      he_Y2_et := he_Y2_et
      hq_2_et := hq_2_et
      hψ_X0 := hψ_X0
      hψ_X1_lead0 := hψ_X1_lead0
      hSpec_ψ_et := hSpec_ψ_et
      he_B2_hom := he_B2_hom
      he_B2_disc := he_B2_disc
      hComm_2 := hComm_2
      hu_2_h := hu_2_h
      hu_2_X := hu_2_X
      hv_2_X := hv_2_X
      hv_2_C := hv_2_C
      hPt_u2_v2 := hPt_u2_v2
      hu_2_eq := hu_2_eq
      hUniv_u := hUniv_u }⟩
  have hBdryAt :
      ∀ (b_idx : Fin 2)
        (s_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left),
        ((b_idx = 1 ∧ s_pt = D_net.s_inf) ∨
          (∃ a ∈ S_aff, b_idx = 0 ∧
            s_pt = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫
              D_net.j_aff)) →
        IsBoundaryAligned2dOdpChartAt k m I_inc.Y₂ I_inc.g₂ D_net.ι_line b_idx s_pt := by
    intro b_idx s_pt hs_case
    obtain ⟨c₀, hc₀, hCl_c₀, _, hw_bdry⟩ := hLineBdry b_idx s_pt hs_case
    obtain ⟨w, z_c, hClosed_zc, hw_ne, hw_ideal, hOdp_zc, hTrans_compl⟩ :=
      hOdp_cl c₀ hc₀ hCl_c₀
    obtain ⟨hw_β, _, hv2_eq, hpderiv0, hj_sec_all⟩ := hw_bdry w hw_ne hw_ideal
    obtain ⟨C⟩ := hBuildChart c₀ hc₀ hCl_c₀ w z_c hClosed_zc hw_ne hw_ideal
      hOdp_zc hTrans_compl b_idx.castSucc hw_β
    have hj_sec :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k))) ≫ C.j_P =
          s_pt ≫ D_net.ι_line.left :=
      hj_sec_all C.j_P C.hj_range C.hj_hom C.hj_coord
    let U₂ := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b_idx.castSucc)
    have h_leP : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens) ≤
        (TopologicalSpace.Opens.map C.j_P.base).obj U₂ := by
      intro p _
      have hp : C.j_P.base p ∈ Set.range C.j_P.base := ⟨p, rfl⟩
      rwa [C.hj_range] at hp
    have h_le2 : (⊤ : (AlgebraicGeometry.Spec C.R'_2).Opens) ≤
        (TopologicalSpace.Opens.map C.e_B2.base).obj U₂ := by
      intro u _
      rw [C.he_B2_def]
      exact h_leP trivial
    have hψ_X1 : C.ψ_B2 (MvPolynomial.X 1) = C.φ_2 (MvPolynomial.X 1) :=
      C.hψ_X1_lead0 hpderiv0
    have hψ_X1_coord :
        C.ψ_B2 (MvPolynomial.X 1) =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b_idx.castSucc)
              (MvPolynomial.isHomogeneous_X k b_idx.castSucc) zero_lt_one).hom ≫
            C.e_B2.appLE U₂ ⊤ h_le2 ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso C.R'_2).hom).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X 2, MvPolynomial.isHomogeneous_X k 2⟩,
                ⟨MvPolynomial.X b_idx.castSucc, MvPolynomial.isHomogeneous_X k b_idx.castSucc⟩,
                ⟨1, pow_one _⟩⟩) := by
      have he_app : C.e_B2.appLE U₂ ⊤ h_le2 ≫ (AlgebraicGeometry.Scheme.ΓSpecIso C.R'_2).hom =
          C.j_P.appLE U₂ ⊤ h_leP ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 2) k))).hom ≫
            CommRingCat.ofHom C.φ_2 := by
        have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom C.φ_2)) C.j_P U₂ ⊤ ⊤ h_leP le_top
        have he_eq : C.e_B2.appLE U₂ ⊤ h_le2 =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom C.φ_2) ≫ C.j_P).appLE U₂ ⊤
              (by rw [← C.he_B2_def]; exact h_le2) := by
          congr 1
          exact C.he_B2_def
        rw [he_eq, ← hcomp, CategoryTheory.Category.assoc]
        congr 1
        exact AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom C.φ_2)
      let x_mk : HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X b_idx.castSucc) :=
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X 2, MvPolynomial.isHomogeneous_X k 2⟩,
            ⟨MvPolynomial.X b_idx.castSucc, MvPolynomial.isHomogeneous_X k b_idx.castSucc⟩,
            ⟨1, pow_one _⟩⟩
      have happ_mk := congrArg (fun f => f.hom x_mk)
        (congrArg (fun g =>
          (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b_idx.castSucc)
            (MvPolynomial.isHomogeneous_X k b_idx.castSucc) zero_lt_one).hom ≫ g) he_app)
      exact (hψ_X1.trans (congrArg C.φ_2 (hv2_eq.symm.trans (C.hj_coord h_leP 2).symm))).trans
        happ_mk.symm
    have hψ_X1_mem : C.ψ_B2 (MvPolynomial.X 1) ∈ C.u_2.asIdeal := by
      rw [hψ_X1]
      exact C.hu_2_X 1
    have hSm_compl_pt :
        ∀ y' : I_inc.Y₂.left,
          I_inc.g₂.left.base y' ∈ Set.range (s_pt ≫ D_net.ι_line.left).base →
          y' ∉ Set.range C.y_pt.base →
          ∃ V : I_inc.Y₂.left.Opens, y' ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ I_inc.g₂.left) := by
      rintro y' ⟨pt, hy'_pt⟩ hy'_not
      obtain ⟨v, _, _, _, hv_eq_v2, hSm_y'⟩ := C.hUniv_u C.u_2 C.hu_2_h
      have hu2_eq : C.e_B2.base C.u_2 = (s_pt ≫ D_net.ι_line.left).base pt := by
        rw [(C.hPt_u2_v2 pt).1, hj_sec]
      have hy'_ne : y' ≠ C.e_Y2.base v := by
        rw [hv_eq_v2 rfl, (C.hPt_u2_v2 pt).2]
        intro hEq
        exact hy'_not ⟨pt, hEq.symm⟩
      exact hSm_y' y' (hy'_pt.symm.trans hu2_eq.symm) hy'_ne
    refine ⟨C.y_pt, C.R'_2, C.B'_2, C.u_2, C.e_B2, C.h_2, C.ψ_B2, C.v_2, C.e_Y2, C.q_2, h_le2,
      C.hy_hom, C.hy_g₂.trans hj_sec, hSm_compl_pt,
      C.he_B2_et, C.he_Y2_et, C.hq_2_et, C.hψ_X0, hψ_X1_coord, C.hSpec_ψ_et,
      C.he_B2_hom, C.hu_2_h, hψ_X1_mem, C.hv_2_X, C.hv_2_C, C.hComm_2, ?_⟩
    intro pt
    refine ⟨?_, (C.hPt_u2_v2 pt).2⟩
    rw [(C.hPt_u2_v2 pt).1, hj_sec]
  refine ⟨?_, hBdryAt 1 D_net.s_inf (Or.inl ⟨rfl, rfl⟩),
    fun a ha => hBdryAt 0 _ (Or.inr ⟨a, ha, rfl, rfl⟩)⟩
  let S_cl := { c : C_disc.left // c ∈ U_disc_reg ∧ IsClosed ({c} : Set C_disc.left) }
  have hPointEx : ∀ p : S_cl,
      ∃ (β : Fin 3) (w : Fin 3 → k),
        Nonempty (WeilPointed2dOdpChartData k m I_inc.Y₂ I_inc.g₂ C_disc ι_disc P_disc p.1 β w) := by
    intro p
    obtain ⟨w, z_c, hClosed_zc, hw_ne, hw_ideal, hOdp_zc, hTrans_compl⟩ :=
      hOdp_cl p.1 p.2.1 p.2.2
    obtain ⟨β, hwβ⟩ : ∃ β : Fin 3, w β ≠ 0 := Function.ne_iff.mp hw_ne
    exact ⟨β, w, hBuildChart p.1 p.2.1 p.2.2 w z_c hClosed_zc hw_ne hw_ideal
      hOdp_zc hTrans_compl β hwβ⟩
  let β_cl : S_cl → Fin 3 := fun p => (hPointEx p).choose
  let w_cl : S_cl → (Fin 3 → k) := fun p => (hPointEx p).choose_spec.choose
  let C_cl : ∀ p : S_cl,
      WeilPointed2dOdpChartData k m I_inc.Y₂ I_inc.g₂ C_disc ι_disc P_disc p.1 (β_cl p) (w_cl p) :=
    fun p => Classical.choice (hPointEx p).choose_spec.choose_spec
  let W_cov : S_cl → (weilProjectiveSpaceOver k 2).left.Opens := fun p =>
    ⟨Set.range (C_cl p).e_B2.base, by
      have _ : AlgebraicGeometry.Etale (C_cl p).e_B2 := (C_cl p).he_B2_et
      exact (C_cl p).e_B2.isOpenMap.isOpen_range⟩
  have hW_mem : ∀ p : S_cl, ι_disc.left.base p.1 ∈ W_cov p :=
    fun p => ⟨(C_cl p).u_2, (C_cl p).hu_2_eq⟩
  obtain ⟨r_chart, idx, hCov_idx⟩ :=
    weil_algClosed_jacobson_closedPoint_finite_subcover k 2 C_disc ι_disc hCl_disc
      U_disc_reg W_cov hW_mem
  refine ⟨r_chart,
    fun α => (C_cl (idx α)).R'_2,
    fun α => (C_cl (idx α)).B'_2,
    fun α => (C_cl (idx α)).e_B2,
    fun α => (C_cl (idx α)).h_2,
    fun α => (C_cl (idx α)).ψ_B2,
    fun α => (C_cl (idx α)).e_Y2,
    fun α => (C_cl (idx α)).q_2,
    ?_, ?_⟩
  · intro α
    let C_α := C_cl (idx α)
    exact ⟨C_α.he_B2_et, C_α.he_Y2_et, C_α.hq_2_et, C_α.hψ_X0,
      C_α.hSpec_ψ_et, C_α.he_B2_hom, C_α.he_B2_disc, C_α.hComm_2⟩
  · intro c hc
    obtain ⟨α, u_pt, hu_pt⟩ := hCov_idx c hc
    let C_α := C_cl (idx α)
    have hu_in_disc : C_α.e_B2.base u_pt ∈ Set.range ι_disc.left.base :=
      ⟨c, hu_pt.symm⟩
    have hu_h : C_α.h_2 ∈ u_pt.asIdeal := by
      have hpre : u_pt ∈ C_α.e_B2.base ⁻¹' (Set.range ι_disc.left.base) := hu_in_disc
      rwa [C_α.he_B2_disc] at hpre
    obtain ⟨v_pt, hv_u, hv_X, hv_C, _, hv_sm⟩ := C_α.hUniv_u u_pt hu_h
    refine ⟨C_α.e_Y2.base v_pt, ?_, ?_, α, u_pt, v_pt, hu_pt, rfl, hv_X, hv_C⟩
    · calc
        I_inc.g₂.left.base (C_α.e_Y2.base v_pt)
            = (C_α.e_Y2 ≫ I_inc.g₂.left).base v_pt := rfl
        _ = (C_α.q_2 ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫
              C_α.e_B2).base v_pt := by rw [C_α.hComm_2]
        _ = C_α.e_B2.base
              ((C_α.q_2 ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))).base v_pt) := rfl
        _ = C_α.e_B2.base u_pt := by rw [hv_u]
        _ = ι_disc.left.base c := hu_pt
    · intro y' hy'_eq hy'_ne
      exact hv_sm y' (hy'_eq.trans hu_pt.symm) hy'_ne

theorem weil_algClosed_1d_odp_roofs_from_2d_line_pullback (k : Type u) [Field k] [IsAlgClosed k]
    (m M : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
    (L : Fin 3 → MvPolynomial (Fin (M + 1)) k)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (hCoord_line : IsStandardProjLineCoord k j_aff s_inf)
    (hLine_plane : IsStandardProjLineInPlane k ι_line)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Y : Y₂ ⟶ Z_bar)
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver k 2)
    (hNet_inc : IsLinearNetIncidenceFamily k M Z_bar ι_bar L Y₂ π_Y g₂)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π₀ : Z_tilde ⟶ Z_bar)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver k 1)
    (ι_Ytilde : Z_tilde ⟶ Y₂)
    (hPb_line : CategoryTheory.IsPullback ι_Ytilde.left f₀.left g₂.left ι_line.left)
    (hπ₀_eq : ι_Ytilde ≫ π_Y = π₀)
    (b_idx : Fin 2)
    (s_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left)
    (L_pt : MvPolynomial (Fin (M + 1)) k)
    (hs_case : (b_idx = 1 ∧ s_pt = s_inf ∧ L_pt = L 1) ∨
      (∃ a : k, b_idx = 0 ∧
        s_pt = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff ∧
        L_pt = L 0 + MvPolynomial.C a * L 1))
    (hAligned : IsBoundaryAligned2dOdpChartAt k m Y₂ g₂ ι_line b_idx s_pt) :
    (∃ (x_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_tilde.left)
       (R'_1 B'_1 : CommRingCat.{u})
       (u_1 : AlgebraicGeometry.Spec R'_1)
       (e_B1 : AlgebraicGeometry.Spec R'_1 ⟶ (weilProjectiveSpaceOver k 1).left)
       (h_1 : R'_1) (ψ_B1 : Polynomial k →+* R'_1)
       (v_1 : AlgebraicGeometry.Spec B'_1)
       (e_Y1 : AlgebraicGeometry.Spec B'_1 ⟶ Z_tilde.left)
       (q_1 : AlgebraicGeometry.Spec B'_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of
         (MvPolynomial (Fin (m + 1) × Fin 2) R'_1 ⧸ Ideal.span
           {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
             MvPolynomial.C h_1}))),
      x_pt ≫ f₀.left = s_pt ∧
      (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_pt.base →
        z ∉ Set.range x_pt.base →
          ∃ V : Z_tilde.left.Opens, z ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left)) ∧
      AlgebraicGeometry.Etale e_B1 ∧ AlgebraicGeometry.Etale e_Y1 ∧
      AlgebraicGeometry.Etale q_1 ∧
      ψ_B1 Polynomial.X = h_1 ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B1)) ∧
      e_B1 ≫ (weilProjectiveSpaceOver k 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B1) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      h_1 ∈ u_1.asIdeal ∧
      (∀ idx : Fin (m + 1) × Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_1.base v_1).asIdeal) ∧
      Ideal.Quotient.mk _ (MvPolynomial.C h_1) ∈ (q_1.base v_1).asIdeal ∧
      e_Y1 ≫ f₀.left =
        q_1 ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B1 ∧
      (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
        e_B1.base u_1 = s_pt.base pt ∧ e_Y1.base v_1 = x_pt.base pt)) ∧
    (∃ x_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_tilde.left,
      x_pt ≫ f₀.left = s_pt ∧
      (∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_pt.base →
        z ∉ Set.range x_pt.base →
          ∃ V : Z_tilde.left.Opens, z ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left)) ∧
      ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
        IsEtaleSplitOdpPointOver m f₀ (x_pt.base pt) (s_pt.base pt)) ∧
    IsHomogeneousHypersurfacePullbackOver k M 1 ι_bar L_pt
      (CategoryTheory.Limits.pullback.fst f₀.left s_pt ≫ π₀.left) :=
by
  classical
  
  have hSpecPullbackQuotient : ∀ {A A' B : Type u} [CommRing A] [CommRing A'] [CommRing B]
      (π : A →+* A') (_ : Function.Surjective π)
      (f : A →+* B) (w : B)
      (f' : A' →+* (B ⧸ Ideal.span ({w} : Set B))),
      f'.comp π = (Ideal.Quotient.mk (Ideal.span ({w} : Set B))).comp f →
      (∃ a₀ : A, f a₀ = w ∧ π a₀ = 0) →
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({w} : Set B)))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f'))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π)) := by
    intro A A' B _ _ _ π hπ f w f' hcomm ha₀
    let I_w : Ideal B := Ideal.span ({w} : Set B)
    let mk_w : B →+* (B ⧸ I_w) := Ideal.Quotient.mk I_w
    have hsq : CommRingCat.ofHom π ≫ CommRingCat.ofHom f' =
        CommRingCat.ofHom f ≫ CommRingCat.ofHom mk_w := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm]
    have hPush : CategoryTheory.IsPushout
        (CommRingCat.ofHom π) (CommRingCat.ofHom f)
        (CommRingCat.ofHom f') (CommRingCat.ofHom mk_w) := by
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.isColimitAux'
          (CategoryTheory.Limits.PushoutCocone.mk
            (CommRingCat.ofHom f') (CommRingCat.ofHom mk_w) hsq)
          fun s => ?_)
      have hcond : s.inl.hom.comp π = s.inr.hom.comp f := by
        ext a
        exact congrArg (fun g : CommRingCat.of A ⟶ s.pt => g.hom a) s.condition
      have hw_zero : ∀ x ∈ I_w, s.inr.hom x = 0 := by
        obtain ⟨a₀, hfa₀, hπa₀⟩ := ha₀
        intro x hx
        rw [Ideal.mem_span_singleton] at hx
        rcases hx with ⟨r, rfl⟩
        have hbw : s.inr.hom w = 0 := by
          rw [← hfa₀]
          change (s.inr.hom.comp f) a₀ = 0
          rw [← hcond, RingHom.comp_apply, hπa₀, map_zero]
        rw [map_mul, hbw, zero_mul]
      let γ : (B ⧸ I_w) →+* s.pt := Ideal.Quotient.lift I_w s.inr.hom hw_zero
      refine ⟨CommRingCat.ofHom γ, ?_, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro y
        obtain ⟨x, rfl⟩ := hπ y
        change γ (f' (π x)) = s.inl.hom (π x)
        have hfx : f' (π x) = mk_w (f x) := congrArg (fun g : A →+* B ⧸ I_w => g x) hcomm
        rw [hfx]
        change s.inr.hom (f x) = s.inl.hom (π x)
        exact (congrArg (fun g : A →+* s.pt => g x) hcond).symm
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro b
        rfl
      · intro m _ hm_inr
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
        exact congrArg (fun g : CommRingCat.of B ⟶ s.pt => g.hom b) hm_inr
    exact (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush).flip

  
  have hSpecFactorFromSpec : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hAffU : AlgebraicGeometry.IsAffineOpen U) {R : CommRingCat.{u}}
      (g : AlgebraicGeometry.Spec R ⟶ X)
      (h_le : (⊤ : (AlgebraicGeometry.Spec R).Opens) ≤ (TopologicalSpace.Opens.map g.base).obj U),
      AlgebraicGeometry.Spec.map (g.appLE U ⊤ h_le ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R).hom) ≫
        hAffU.fromSpec = g := by
    intro X U hAffU R g h_le
    have hrange_U : Set.range U.ι.base = (U : Set X) := by
      ext x
      simp
    have hsub : Set.range g.base ⊆ Set.range U.ι.base := by
      rw [hrange_U]
      rintro _ ⟨p, rfl⟩
      exact h_le trivial
    let g_U : AlgebraicGeometry.Spec R ⟶ U := AlgebraicGeometry.IsOpenImmersion.lift U.ι g hsub
    have hg_U : g_U ≫ U.ι = g := AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι g hsub
    let f₂ : AlgebraicGeometry.Spec R ⟶ AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U)) :=
      g_U ≫ hAffU.isoSpec.hom
    have hf₂_fac : f₂ ≫ hAffU.fromSpec = g := by
      dsimp [f₂]
      rw [← hAffU.isoSpec_inv_ι, CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
        hg_U]
    let ψ := AlgebraicGeometry.Spec.preimage f₂
    have hψ : AlgebraicGeometry.Spec.map ψ = f₂ := AlgebraicGeometry.Spec.map_preimage f₂
    have hf_in : (⊤ : (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).Opens) ≤
        (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj U := by
      intro p _
      change hAffU.fromSpec.base p ∈ U
      rw [← hAffU.isoSpec_inv_ι]
      exact (hAffU.isoSpec.inv.base p).2
    have happ : g.appLE U ⊤ h_le ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R).hom = ψ := by
      have hg_eq : g = AlgebraicGeometry.Spec.map ψ ≫ hAffU.fromSpec := by
        rw [hψ, hf₂_fac]
      have h1 : g.appLE U ⊤ h_le =
          (AlgebraicGeometry.Spec.map ψ ≫ hAffU.fromSpec).appLE U ⊤
            (by rw [← hg_eq]; exact h_le) := by
        congr 1
      rw [h1, ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ U ⊤ ⊤ hf_in le_rfl]
      have hfrom_app : hAffU.fromSpec.appLE U ⊤ hf_in =
          (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv := by
        have hself := hAffU.fromSpec_app_self
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE] at hself
        have heq_top : (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj U = ⊤ :=
          top_unique hf_in
        have hmap_eq : hAffU.fromSpec.appLE U ⊤ hf_in =
            hAffU.fromSpec.appLE U ((TopologicalSpace.Opens.map hAffU.fromSpec.base).obj U) le_rfl ≫
              (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).presheaf.map
                (CategoryTheory.eqToHom heq_top.symm).op := by
          dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
          congr 2
        rw [hmap_eq, hself, CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp,
          ← op_comp, CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_refl, op_id,
          CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
      have htop_eq : (AlgebraicGeometry.Spec.map ψ).appLE ⊤ ⊤ le_rfl =
          (AlgebraicGeometry.Spec.map ψ).appTop := by
        rw [AlgebraicGeometry.Scheme.Hom.appTop, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        rfl
      rw [hfrom_app, htop_eq, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality, CategoryTheory.Iso.inv_hom_id_assoc]
    rw [happ, hψ, hf₂_fac]

  have hFromSpecComm : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      {U : Y.Opens} (hAffU : AlgebraicGeometry.IsAffineOpen U)
      {V : X.Opens} (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hVU : V ≤ (TopologicalSpace.Opens.map f.base).obj U),
      hAffV.fromSpec ≫ f = AlgebraicGeometry.Spec.map (f.appLE U V hVU) ≫ hAffU.fromSpec := by
    intro X Y f U hAffU V hAffV hVU
    have hV_in : (⊤ : (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op V))).Opens) ≤
        (TopologicalSpace.Opens.map hAffV.fromSpec.base).obj V := by
      intro p _
      change hAffV.fromSpec.base p ∈ V
      rw [← hAffV.isoSpec_inv_ι]
      exact (hAffV.isoSpec.inv.base p).2
    have h_le : (⊤ : (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op V))).Opens) ≤
        (TopologicalSpace.Opens.map (hAffV.fromSpec ≫ f).base).obj U :=
      hV_in.trans ((TopologicalSpace.Opens.map hAffV.fromSpec.base).monotone hVU)
    rw [← hSpecFactorFromSpec hAffU (hAffV.fromSpec ≫ f) h_le]
    congr 2
    rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ U V ⊤ hVU hV_in,
      CategoryTheory.Category.assoc]
    have hfrom_app : hAffV.fromSpec.appLE V ⊤ hV_in =
        (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op V))).inv := by
      have hself := hAffV.fromSpec_app_self
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE] at hself
      have heq_top : (TopologicalSpace.Opens.map hAffV.fromSpec.base).obj V = ⊤ :=
        top_unique hV_in
      have hmap_eq : hAffV.fromSpec.appLE V ⊤ hV_in =
          hAffV.fromSpec.appLE V ((TopologicalSpace.Opens.map hAffV.fromSpec.base).obj V) le_rfl ≫
            (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op V))).presheaf.map
              (CategoryTheory.eqToHom heq_top.symm).op := by
        dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
        congr 2
      rw [hmap_eq, hself, CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp,
        ← op_comp, CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_refl, op_id,
        CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
    rw [hfrom_app, CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]

  
  have hProjCover : ∀ (N : ℕ) (q : (weilProjectiveSpaceOver k N).left),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      ∃ μ : Fin (N + 1),
        q ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X μ) := by
    intro N q
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    by_contra hnone
    have hX_mem : ∀ μ : Fin (N + 1), MvPolynomial.X μ ∈ q.asHomogeneousIdeal := by
      intro μ
      by_contra hnot
      exact hnone ⟨μ, (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X μ) q).mpr hnot⟩
    apply q.not_irrelevant_le
    intro p hp
    have hp0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin (N + 1)) k) = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
    have hcoeff0 : p.coeff 0 = 0 := by
      have hsum := DirectSum.sum_support_decompose 𝒜 p
      have h1 := congrArg (fun f : MvPolynomial (Fin (N + 1)) k => f.coeff 0) hsum.symm
      rw [MvPolynomial.coeff_sum] at h1
      rw [h1]
      refine Finset.sum_eq_zero fun i _ => ?_
      rcases Nat.eq_zero_or_pos i with rfl | hi
      · rw [hp0]
        rfl
      · have hhom : ((DirectSum.decompose 𝒜 p i : 𝒜 i) : MvPolynomial (Fin (N + 1)) k).IsHomogeneous i :=
          (DirectSum.decompose 𝒜 p i).2
        by_contra hne
        have hdeg := hhom hne
        rw [map_zero] at hdeg
        omega
    rw [p.as_sum]
    refine Ideal.sum_mem q.asHomogeneousIdeal.toIdeal fun d hd => ?_
    have hd_ne : d ≠ 0 := by
      intro hd0
      subst hd0
      exact (MvPolynomial.mem_support_iff.mp hd) hcoeff0
    have hex : ∃ μ : Fin (N + 1), d μ ≠ 0 := by
      by_contra hall
      refine hd_ne (Finsupp.ext fun μ => ?_)
      by_contra hμ
      exact hall ⟨μ, hμ⟩
    obtain ⟨μ, hμ⟩ := hex
    let d' : Fin (N + 1) →₀ ℕ := d - Finsupp.single μ 1
    have hge : Finsupp.single μ 1 ≤ d := by
      intro i
      by_cases hi : i = μ
      · subst hi; simp; omega
      · simp [Ne.symm hi]
    have hd_eq : d = d' + Finsupp.single μ 1 := (tsub_add_cancel_of_le hge).symm
    rw [MvPolynomial.monomial_eq,
      Finsupp.prod_of_support_subset _ (Finset.subset_univ _) _ (fun _ _ => pow_zero _)]
    have hprod : (∏ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^ (d i)) =
        (∏ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^ (d' i)) *
          (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) := by
      calc
        (∏ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^ (d i))
          = (∏ i : Fin (N + 1), ((MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^ (d' i) *
              (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^
                ((Finsupp.single μ 1 : Fin (N + 1) →₀ ℕ) i))) := by
            refine Finset.prod_congr rfl fun i _ => ?_
            have hdi : d i = d' i + (Finsupp.single μ 1 : Fin (N + 1) →₀ ℕ) i := by
              conv_lhs => rw [hd_eq]
              rfl
            rw [hdi, pow_add]
        _ = (∏ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^ (d' i)) *
              (∏ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^
                ((Finsupp.single μ 1 : Fin (N + 1) →₀ ℕ) i)) :=
            Finset.prod_mul_distrib
        _ = (∏ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ^ (d' i)) *
              (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) := by
            congr 1
            rw [Finset.prod_eq_single μ]
            · simp
            · intro b _ hb
              simp [Ne.symm hb]
            · intro hmem; exact absurd (Finset.mem_univ μ) hmem
    rw [hprod, ← mul_assoc]
    exact q.asHomogeneousIdeal.toIdeal.mul_mem_left _ (hX_mem μ)

  
  have hHomogLocMonomials : ∀ (N : ℕ) (β : Fin (N + 1)),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let C := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β)
      let c_hom : k →+* C :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X β))).comp
          (algebraMap k ↥(𝒜 0))
      let ξ : Fin (N + 1) → C := fun i =>
        HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X i, MvPolynomial.isHomogeneous_X k i⟩,
            ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩
      ∀ z : C, ∃ (S : Finset (Fin (N + 1) →₀ ℕ)) (coeff : (Fin (N + 1) →₀ ℕ) → k),
        z = ∑ d ∈ S, c_hom (coeff d) * ∏ i : Fin (N + 1), (ξ i) ^ (d i) := by
    intro N β
    dsimp only
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let C := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β)
    let c_hom : k →+* C :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X β))).comp
        (algebraMap k ↥(𝒜 0))
    let ξ : Fin (N + 1) → C := fun i =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X i, MvPolynomial.isHomogeneous_X k i⟩,
          ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩
    intro z
    obtain ⟨v, rfl⟩ := HomogeneousLocalization.mk_surjective z
    obtain ⟨m_pow, hm_eq⟩ := v.den_mem
    dsimp only at hm_eq
    have hm_deg : m_pow = v.deg := by
      have h1 : ((MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k) ^ m_pow).IsHomogeneous m_pow := by
        simpa using (MvPolynomial.isHomogeneous_X k β).pow m_pow
      have h2 : ((MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k) ^ m_pow).IsHomogeneous v.deg := by
        rw [hm_eq]; exact v.den.2
      have hne : ((MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k) ^ m_pow) ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) h0
        simp at hev
      exact MvPolynomial.IsHomogeneous.inj_right h1 h2 hne
    subst hm_deg
    let P : MvPolynomial (Fin (N + 1)) k := v.num.1
    refine ⟨P.support, P.coeff, ?_⟩
    apply HomogeneousLocalization.val_injective
    let S_pow : Submonoid (MvPolynomial (Fin (N + 1)) k) :=
      Submonoid.powers (MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k)
    let ιC := algebraMap (HomogeneousLocalization 𝒜 S_pow) (Localization S_pow)
    rw [HomogeneousLocalization.val_mk]
    simp only [← HomogeneousLocalization.algebraMap_apply, map_sum, map_mul, map_prod, map_pow]
    have hc_val : ∀ a : k,
        ιC (c_hom a) = Localization.mk (MvPolynomial.C a) (⟨1, S_pow.one_mem⟩ : S_pow) := by
      intro a
      exact HomogeneousLocalization.val_mk _
    have hξ_val : ∀ i : Fin (N + 1),
        ιC (ξ i) = Localization.mk (MvPolynomial.X i)
          (⟨MvPolynomial.X β, ⟨1, pow_one _⟩⟩ : S_pow) := by
      intro i
      exact HomogeneousLocalization.val_mk _
    have hterm : ∀ d ∈ P.support,
        ιC (c_hom (P.coeff d)) * (∏ i : Fin (N + 1), ιC (ξ i) ^ (d i)) =
          Localization.mk (MvPolynomial.monomial d (P.coeff d)) (⟨v.den.1, v.den_mem⟩ : S_pow) := by
      intro d hd
      have hdeg_d : (∑ i : Fin (N + 1), d i) = v.deg := by
        have hh := v.num.2 (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hh
      rw [hc_val]
      have hprod_ξ : (∏ i : Fin (N + 1), ιC (ξ i) ^ (d i)) =
          Localization.mk (∏ i : Fin (N + 1), MvPolynomial.X i ^ (d i))
            (⟨MvPolynomial.X β ^ (∑ i : Fin (N + 1), d i),
              S_pow.pow_mem (Submonoid.mem_powers _) _⟩ : S_pow) := by
        have haux : ∀ (s : Finset (Fin (N + 1))),
            (∏ i ∈ s, Localization.mk (MvPolynomial.X i)
                (⟨MvPolynomial.X β, ⟨1, pow_one _⟩⟩ : S_pow) ^ (d i)) =
              Localization.mk (∏ i ∈ s, MvPolynomial.X i ^ (d i))
                (⟨MvPolynomial.X β ^ (∑ i ∈ s, d i),
                  S_pow.pow_mem (Submonoid.mem_powers _) _⟩ : S_pow) := by
          intro s
          refine Finset.induction_on s ?_ ?_
          · simp
          · intro a s has ih
            rw [Finset.prod_insert has, Finset.prod_insert has, ih, Localization.mk_pow,
              Localization.mk_mul]
            congr 1
            apply Subtype.ext
            simp [Finset.sum_insert has, pow_add]
        simpa only [hξ_val] using haux Finset.univ
      rw [hprod_ξ, Localization.mk_mul]
      have hmon : MvPolynomial.monomial d (P.coeff d) =
          MvPolynomial.C (P.coeff d) * ∏ i : Fin (N + 1), MvPolynomial.X i ^ (d i) := by
        rw [MvPolynomial.monomial_eq,
          Finsupp.prod_of_support_subset _ (Finset.subset_univ _) _ (fun _ _ => pow_zero _)]
      congr 1
      · exact hmon.symm
      · apply Subtype.ext
        simp only [Submonoid.coe_mul, one_mul]
        rw [hdeg_d, hm_eq]
    change Localization.mk ↑v.num ⟨↑v.den, v.den_mem⟩ =
      ∑ d ∈ P.support, ιC (c_hom (P.coeff d)) * ∏ i : Fin (N + 1), ιC (ξ i) ^ (d i)
    rw [Finset.sum_congr rfl hterm]
    have hsum_mk : ∀ (s : Finset (Fin (N + 1) →₀ ℕ)),
        (∑ d ∈ s, Localization.mk (MvPolynomial.monomial d (P.coeff d)) ⟨v.den.1, v.den_mem⟩) =
          Localization.mk (∑ d ∈ s, MvPolynomial.monomial d (P.coeff d)) ⟨v.den.1, v.den_mem⟩ := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · simp [Localization.mk_zero]
      · intro a s has ih
        rw [Finset.sum_insert has, Finset.sum_insert has, ih, Localization.add_mk_self]
    rw [hsum_mk]
    congr 1
    exact P.as_sum

  
  have hProjAffine : ∀ (N : ℕ) (β : Fin (N + 1)),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsAffineOpen
        ((AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X β) :
          (weilProjectiveSpaceOver k N).left.Opens)) := by
    intro N β
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let hXβ : (MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
      MvPolynomial.isHomogeneous_X k β
    haveI : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one) := by
      rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one]
      infer_instance
    change AlgebraicGeometry.IsAffineOpen (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β))
    rw [← AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one]
    exact AlgebraicGeometry.isAffineOpen_opensRange
      (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one)

  have hProjAwayιEq : ∀ (N : ℕ) (β : Fin (N + 1))
      (hXβ : (MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let U : (weilProjectiveSpaceOver k N).left.Opens :=
        AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β)
      let isoAway : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β)) ≅
          (weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op U) :=
        AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
      (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one :
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β))) ⟶
          (weilProjectiveSpaceOver k N).left) =
        AlgebraicGeometry.Spec.map isoAway.inv ≫ (hProjAffine N β).fromSpec := by
    intro N β hXβ
    dsimp only
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β)
    let hAff : AlgebraicGeometry.IsAffineOpen U := hProjAffine N β
    let isoS := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
    let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
    change AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one =
      AlgebraicGeometry.Spec.map isoA.inv ≫ hAff.fromSpec
    rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one,
      ← hAff.isoSpec_inv_ι, ← CategoryTheory.Category.assoc]
    congr 1
    change isoS.inv = AlgebraicGeometry.Spec.map isoA.inv ≫ hAff.isoSpec.inv
    have hhom : isoS.hom = hAff.isoSpec.hom ≫ AlgebraicGeometry.Spec.map isoA.hom := by
      rw [hAff.isoSpec_hom]
      rfl
    rw [← CategoryTheory.cancel_epi isoS.hom, isoS.hom_inv_id, hhom,
      CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map isoA.hom),
      ← AlgebraicGeometry.Spec.map_comp, isoA.inv_hom_id,
      AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp,
      hAff.isoSpec.hom_inv_id]

  have hProjScalarCompat : ∀ (N : ℕ) (β : Fin (N + 1))
      (hXβ : (MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      {S : AlgebraicGeometry.Scheme.{u}}
      (p_S : S ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (g : S ⟶ (weilProjectiveSpaceOver k N).left)
      (hg : g ≫ (weilProjectiveSpaceOver k N).hom = p_S)
      (V : S.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hVU : V ≤ (TopologicalSpace.Opens.map g.base).obj
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
          MvPolynomial.gradedAlgebra
         (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X β) :
          (weilProjectiveSpaceOver k N).left.Opens)))
      (c : k),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let U : (weilProjectiveSpaceOver k N).left.Opens :=
        AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β)
      let isoAway : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β)) ≅
          (weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op U) :=
        AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
      (isoAway.hom ≫ g.appLE U V hVU).hom
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X β))
          (algebraMap k ↥(𝒜 0) c)) =
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        p_S.appLE ⊤ V le_top).hom c := by
    intro N β hXβ S p_S g hg V hAffV hVU c
    dsimp only
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U : (weilProjectiveSpaceOver k N).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β)
    let hAffU : AlgebraicGeometry.IsAffineOpen U := hProjAffine N β
    let isoAway : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β)) ≅
        (weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op U) :=
      AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
    let hAffTop : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens) :=
      AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of k))
    let w : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β))) ⟶
        (weilProjectiveSpaceOver k N).left :=
      AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
    have haway_eq : w = AlgebraicGeometry.Spec.map isoAway.inv ≫ hAffU.fromSpec :=
      hProjAwayιEq N β hXβ
    have h1 : hAffV.fromSpec ≫ g =
        AlgebraicGeometry.Spec.map (isoAway.hom ≫ g.appLE U V hVU) ≫ w := by
      rw [haway_eq, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map isoAway.hom),
        ← AlgebraicGeometry.Spec.map_comp, isoAway.inv_hom_id,
        AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
      exact hFromSpecComm g hAffU hAffV hVU
    have h2 : hAffV.fromSpec ≫ p_S =
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ p_S.appLE ⊤ V le_top) := by
      have hcomm_p := hFromSpecComm p_S hAffTop hAffV le_top
      have hfrom_top : hAffTop.fromSpec =
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
        symm
        let Xk := AlgebraicGeometry.Spec (CommRingCat.of k)
        let id_k : Xk ⟶ Xk := 𝟙 Xk
        have htriv : (⊤ : Xk.Opens) ≤ (TopologicalSpace.Opens.map id_k.base).obj ⊤ := le_rfl
        have hf := hSpecFactorFromSpec hAffTop id_k htriv
        have hid_app : id_k.appLE ⊤ ⊤ htriv = 𝟙 _ := by
          have h1' : id_k.appLE ⊤ ⊤ htriv =
              id_k.app ⊤ ≫ Xk.presheaf.map (CategoryTheory.homOfLE htriv).op := rfl
          have h2' : (id_k.app ⊤ : Xk.presheaf.obj (Opposite.op ⊤) ⟶
              Xk.presheaf.obj (Opposite.op ⊤)) = 𝟙 _ := by
            dsimp [id_k]
          have h3' : (Xk.presheaf.map (CategoryTheory.homOfLE htriv).op :
              Xk.presheaf.obj (Opposite.op ⊤) ⟶ Xk.presheaf.obj (Opposite.op ⊤)) = 𝟙 _ :=
            (congrArg (fun m : (⊤ : Xk.Opens) ⟶ ⊤ => Xk.presheaf.map m.op)
              (Subsingleton.elim (CategoryTheory.homOfLE htriv) (𝟙 (⊤ : Xk.Opens)))).trans
              (CategoryTheory.Functor.map_id Xk.presheaf (Opposite.op ⊤))
          exact h1'.trans ((congrArg₂ CategoryTheory.CategoryStruct.comp h2' h3').trans
            (CategoryTheory.Category.id_comp _))
        rw [hid_app, CategoryTheory.Category.id_comp] at hf
        dsimp [id_k] at hf
        calc
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                (AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
                  hAffTop.fromSpec) := by rw [hf, CategoryTheory.Category.comp_id]
          _ = (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom) ≫
                hAffTop.fromSpec := by rw [CategoryTheory.Category.assoc]
          _ = hAffTop.fromSpec := by
                rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.hom_inv_id,
                  AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
      rw [hcomm_p, hfrom_top, ← AlgebraicGeometry.Spec.map_comp]
    have h3 : (hAffV.fromSpec ≫ g) ≫ (weilProjectiveSpaceOver k N).hom = hAffV.fromSpec ≫ p_S := by
      rw [CategoryTheory.Category.assoc, hg]
    rw [h1, h2] at h3
    change (AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _ at h3
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
      (AlgebraicGeometry.Proj.awayι _ _ _ _),
      AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp] at h3
    have h4 := AlgebraicGeometry.Spec.map_injective h3
    exact congrArg (fun φ : CommRingCat.of k ⟶ S.presheaf.obj (Opposite.op V) => φ.hom c) h4

  have hProjBasicOpenAway : ∀ (N : ℕ) (β : Fin (N + 1))
      (hXβ : (MvPolynomial.X β : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (F : MvPolynomial (Fin (N + 1)) k)
      (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k ((1 : ℕ) • 1)),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      (weilProjectiveSpaceOver k N).left.basicOpen
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X β)).hom
          (HomogeneousLocalization.Away.mk 𝒜 hXβ 1 F hF)) =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β) :
          (weilProjectiveSpaceOver k N).left.Opens) ⊓
        (AlgebraicGeometry.Proj.basicOpen 𝒜 F :
          (weilProjectiveSpaceOver k N).left.Opens) := by
    intro N β hXβ F hF
    dsimp only
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U : (weilProjectiveSpaceOver k N).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β)
    let hAffU : AlgebraicGeometry.IsAffineOpen U := hProjAffine N β
    let isoAway : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β)) ≅
        (weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op U) :=
      AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
    let ζ := HomogeneousLocalization.Away.mk 𝒜 hXβ 1 F hF
    let s : ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op U)) :=
      (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X β)).hom ζ
    let w : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β))) ⟶
        (weilProjectiveSpaceOver k N).left :=
      AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
    have hF1 : F ∈ 𝒜 1 := by simpa only [one_smul] using hF
    have hζ_eq : ζ = HomogeneousLocalization.Away.isLocalizationElem hXβ hF1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      change Localization.mk F _ = HomogeneousLocalization.val
        (HomogeneousLocalization.Away.mk 𝒜 hXβ 1 (F ^ 1) _)
      rw [HomogeneousLocalization.Away.val_mk]
      congr 1; simp
    have hpre_lhs : (TopologicalSpace.Opens.map w.base).obj
        ((weilProjectiveSpaceOver k N).left.basicOpen s) =
        PrimeSpectrum.basicOpen ζ := by
      have hw_eq : w = AlgebraicGeometry.Spec.map isoAway.inv ≫ hAffU.fromSpec :=
        hProjAwayιEq N β hXβ
      rw [hw_eq]
      change (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map isoAway.inv).base).obj
          ((TopologicalSpace.Opens.map hAffU.fromSpec.base).obj
            ((weilProjectiveSpaceOver k N).left.basicOpen s)) = _
      rw [hAffU.fromSpec_preimage_basicOpen, AlgebraicGeometry.SpecMap_preimage_basicOpen]
      congr 1
      change isoAway.inv.hom (isoAway.hom.hom ζ) = ζ
      exact congrArg
        (fun φ : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β)) ⟶ _ => φ.hom ζ)
        isoAway.hom_inv_id
    have hpre_rhs : (TopologicalSpace.Opens.map w.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 F : (weilProjectiveSpaceOver k N).left.Opens) =
        PrimeSpectrum.basicOpen ζ := by
      rw [hζ_eq]
      exact AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hXβ zero_lt_one hF1 zero_lt_one
    have hw_range : Set.range w.base = (U : Set (weilProjectiveSpaceOver k N).left) := by
      have hr := AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X β) hXβ zero_lt_one
      exact congrArg (fun O : (AlgebraicGeometry.Proj 𝒜).Opens => O.1) hr
    ext q
    constructor
    · intro hq
      have hqU : q ∈ U := (weilProjectiveSpaceOver k N).left.basicOpen_le s hq
      have hq_rng : q ∈ Set.range w.base := by rwa [hw_range]
      rcases hq_rng with ⟨p, rfl⟩
      refine ⟨hqU, ?_⟩
      change p ∈ (TopologicalSpace.Opens.map w.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 F : (weilProjectiveSpaceOver k N).left.Opens)
      rw [hpre_rhs, ← hpre_lhs]
      exact hq
    · rintro ⟨hqU, hqF⟩
      have hq_rng : q ∈ Set.range w.base := by rwa [hw_range]
      rcases hq_rng with ⟨p, rfl⟩
      change p ∈ (TopologicalSpace.Opens.map w.base).obj
        ((weilProjectiveSpaceOver k N).left.basicOpen s)
      rw [hpre_lhs, ← hpre_rhs]
      exact hqF

  
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
    MvPolynomial.gradedAlgebra
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 3) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  let U₁_fn : Fin 2 → (weilProjectiveSpaceOver k 1).left.Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X a)
  let U₂_fn : Fin 2 → (weilProjectiveSpaceOver k 2).left.Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X a.castSucc)

  have hLinePreimEq : U₁_fn b_idx =
      (TopologicalSpace.Opens.map ι_line.left.base).obj (U₂_fn b_idx) := by
    obtain ⟨h_b, _, _⟩ := hLine_plane.2.2 b_idx
    apply le_antisymm h_b
    intro q hq
    by_contra hq_not
    obtain ⟨μ, hq_μ⟩ := hProjCover 1 q
    obtain ⟨h_μ0, hcoord_μ, _⟩ := hLine_plane.2.2 μ
    have h_μ : U₁_fn μ ≤ (TopologicalSpace.Opens.map ι_line.left.base).obj (U₂_fn μ) := h_μ0
    have hq_U2μ : ι_line.left.base q ∈ U₂_fn μ := h_μ hq_μ
    let hXμ2 : (MvPolynomial.X μ.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
      MvPolynomial.isHomogeneous_X k μ.castSucc
    let hXb2 : (MvPolynomial.X b_idx.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 ((1 : ℕ) • 1) := by
      rw [one_smul]; exact MvPolynomial.isHomogeneous_X k b_idx.castSucc
    let hXμ1 : (MvPolynomial.X μ : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
      MvPolynomial.isHomogeneous_X k μ
    let hXb1 : (MvPolynomial.X b_idx : MvPolynomial (Fin 2) k) ∈ 𝒜_1 ((1 : ℕ) • 1) := by
      rw [one_smul]; exact MvPolynomial.isHomogeneous_X k b_idx
    let ζ₂ := HomogeneousLocalization.Away.mk 𝒜_2 hXμ2 1 (MvPolynomial.X b_idx.castSucc) hXb2
    let ζ₁ := HomogeneousLocalization.Away.mk 𝒜_1 hXμ1 1 (MvPolynomial.X b_idx) hXb1
    let s₂ : ↑((weilProjectiveSpaceOver k 2).left.presheaf.obj (Opposite.op (U₂_fn μ))) :=
      (AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X μ.castSucc)).hom ζ₂
    let s₁ : ↑((weilProjectiveSpaceOver k 1).left.presheaf.obj (Opposite.op (U₁_fn μ))) :=
      (AlgebraicGeometry.Proj.awayToSection 𝒜_1 (MvPolynomial.X μ)).hom ζ₁
    have hq_s₂ : ι_line.left.base q ∈ (weilProjectiveSpaceOver k 2).left.basicOpen s₂ := by
      rw [hProjBasicOpenAway 2 μ.castSucc hXμ2 (MvPolynomial.X b_idx.castSucc) hXb2]
      exact ⟨hq_U2μ, hq⟩
    have hs₁_eq : (ι_line.left.appLE (U₂_fn μ) (U₁_fn μ) h_μ).hom s₂ = s₁ := by
      dsimp [s₂, s₁]
      rw [← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_2 (MvPolynomial.X μ.castSucc) hXμ2 zero_lt_one,
        ← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_1 (MvPolynomial.X μ) hXμ1 zero_lt_one]
      have hζ₂ : ζ₂ = (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X b_idx.castSucc, MvPolynomial.isHomogeneous_X k b_idx.castSucc⟩,
            ⟨MvPolynomial.X μ.castSucc, hXμ2⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X μ.castSucc)) := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mk]
        congr 1; simp
      have hζ₁ : ζ₁ = (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X b_idx, MvPolynomial.isHomogeneous_X k b_idx⟩,
            ⟨MvPolynomial.X μ, hXμ1⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X μ)) := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mk]
        congr 1; simp
      rw [hζ₂, hζ₁]
      exact hcoord_μ b_idx
    have hq_s₁ : q ∈ (weilProjectiveSpaceOver k 1).left.basicOpen s₁ := by
      rw [← hs₁_eq]
      have hpre := AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι_line.left s₂
      have hq_pre : q ∈ (TopologicalSpace.Opens.map ι_line.left.base).obj
          ((weilProjectiveSpaceOver k 2).left.basicOpen s₂) := hq_s₂
      rw [hpre] at hq_pre
      have hres : (weilProjectiveSpaceOver k 1).left.basicOpen
          ((ι_line.left.appLE (U₂_fn μ) (U₁_fn μ) h_μ).hom s₂) =
          U₁_fn μ ⊓ (weilProjectiveSpaceOver k 1).left.basicOpen
            ((ι_line.left.app (U₂_fn μ)).hom s₂) := by
        dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
        exact (weilProjectiveSpaceOver k 1).left.basicOpen_res
          ((ι_line.left.app (U₂_fn μ)).hom s₂) (CategoryTheory.homOfLE h_μ).op
      rw [hres]
      exact ⟨hq_μ, hq_pre⟩
    rw [hProjBasicOpenAway 1 μ hXμ1 (MvPolynomial.X b_idx) hXb1] at hq_s₁
    exact hq_not hq_s₁.2

  
  rcases hAligned with ⟨y_pt, R'_2, B'_2, u_2, e_B2, h_2, ψ_B2, v_2, e_Y2, q_2, h_le2,
    hy_hom, hy_g2, hy_sm, he_B2_et, he_Y2_et, hq_2_et, hψ_0, hψ_1, hψ_B2_et, he_B2_hom,
    hh2_u2, hw2_u2, hX_v2, hh2_v2, hComm_2, hpt_2⟩

  let w_2 : R'_2 := ψ_B2 (MvPolynomial.X 1)
  let I_w2 : Ideal R'_2 := Ideal.span ({w_2} : Set R'_2)
  let mk_R : R'_2 →+* (R'_2 ⧸ I_w2) := Ideal.Quotient.mk I_w2
  let R'_1 : CommRingCat.{u} := CommRingCat.of (R'_2 ⧸ I_w2)
  let ι_R1 : AlgebraicGeometry.Spec R'_1 ⟶ AlgebraicGeometry.Spec R'_2 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_R)
  let h_1 : R'_1 := mk_R h_2
  let ψ_B1 : Polynomial k →+* R'_1 :=
    Polynomial.eval₂RingHom (mk_R.comp (ψ_B2.comp MvPolynomial.C)) h_1

  
  have hExists_eB1 : ∃ e_B1 : AlgebraicGeometry.Spec R'_1 ⟶ (weilProjectiveSpaceOver k 1).left,
      CategoryTheory.IsPullback ι_R1 e_B1 e_B2 ι_line.left := by
    obtain ⟨h_b0, hcoord_b, hw_b⟩ := hLine_plane.2.2 b_idx
    have h_b : U₁_fn b_idx ≤ (TopologicalSpace.Opens.map ι_line.left.base).obj (U₂_fn b_idx) := h_b0
    let C₁ := HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X b_idx)
    let C₂ := HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X b_idx.castSucc)
    let hXb1 : (MvPolynomial.X b_idx : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
      MvPolynomial.isHomogeneous_X k b_idx
    let hXb2 : (MvPolynomial.X b_idx.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
      MvPolynomial.isHomogeneous_X k b_idx.castSucc
    let iso₁ : CommRingCat.of C₁ ≅
        (weilProjectiveSpaceOver k 1).left.presheaf.obj (Opposite.op (U₁_fn b_idx)) :=
      AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_1 (MvPolynomial.X b_idx) hXb1 zero_lt_one
    let iso₂ : CommRingCat.of C₂ ≅
        (weilProjectiveSpaceOver k 2).left.presheaf.obj (Opposite.op (U₂_fn b_idx)) :=
      AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b_idx.castSucc) hXb2 zero_lt_one
    let ρ_line : C₂ →+* C₁ := (iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b ≫ iso₁.inv).hom
    have hdeg_ren : ∀ (i : ℕ) (p : MvPolynomial (Fin 2) k),
        p ∈ 𝒜_1 i → (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom p ∈ 𝒜_2 i := by
      intro i p hp
      change (MvPolynomial.rename Fin.castSucc p : MvPolynomial (Fin 3) k) ∈ 𝒜_2 i
      rw [p.as_sum, map_sum]
      refine Submodule.sum_mem (𝒜_2 i) fun d hd => ?_
      have hd_deg : (∑ a : Fin 2, d a) = i := by
        have hh := hp (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hh
      rw [MvPolynomial.monomial_eq,
        Finsupp.prod_of_support_subset _ (Finset.subset_univ _) _ (fun _ _ => pow_zero _),
        map_mul, map_prod, MvPolynomial.rename_C]
      have hC_hom : (MvPolynomial.C (p.coeff d) : MvPolynomial (Fin 3) k).IsHomogeneous 0 :=
        MvPolynomial.isHomogeneous_C _ _
      have hprod_hom : ∀ (s : Finset (Fin 2)),
          (∏ a ∈ s, (MvPolynomial.rename (R := k) Fin.castSucc (MvPolynomial.X a ^ d a))).IsHomogeneous
            (∑ a ∈ s, d a) := by
        intro s
        refine Finset.induction_on s ?_ ?_
        · simp [MvPolynomial.isHomogeneous_one]
        · intro a s has ih
          rw [Finset.prod_insert has, Finset.sum_insert has, map_pow, MvPolynomial.rename_X]
          have hpow : ((MvPolynomial.X a.castSucc : MvPolynomial (Fin 3) k) ^ d a).IsHomogeneous (d a) := by
            simpa using (MvPolynomial.isHomogeneous_X k a.castSucc).pow (d a)
          exact hpow.mul ih
      rw [MvPolynomial.mem_homogeneousSubmodule, ← hd_deg, ← zero_add (∑ a : Fin 2, d a)]
      exact hC_hom.mul (hprod_hom Finset.univ)
    let ren_gr : GradedRingHom 𝒜_1 𝒜_2 :=
      { toRingHom := (MvPolynomial.rename (R := k) Fin.castSucc).toRingHom
        map_mem := fun {i p} hp => hdeg_ren i p hp }
    have hsub_ren : Submonoid.powers (MvPolynomial.X b_idx : MvPolynomial (Fin 2) k) ≤
        Submonoid.comap ren_gr
          (Submonoid.powers (MvPolynomial.X b_idx.castSucc : MvPolynomial (Fin 3) k)) := by
      rintro _ ⟨n, rfl⟩
      exact ⟨n, by simp [ren_gr]⟩
    let σ_line : C₁ →+* C₂ := HomogeneousLocalization.map ren_gr hsub_ren
    let c₁_hom : k →+* C₁ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_1 (Submonoid.powers (MvPolynomial.X b_idx))).comp
        (algebraMap k ↥(𝒜_1 0))
    let c₂_hom : k →+* C₂ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_2
        (Submonoid.powers (MvPolynomial.X b_idx.castSucc))).comp (algebraMap k ↥(𝒜_2 0))
    let ξ₁ : Fin 2 → C₁ := fun a =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X a, MvPolynomial.isHomogeneous_X k a⟩,
          ⟨MvPolynomial.X b_idx, MvPolynomial.isHomogeneous_X k b_idx⟩, ⟨1, pow_one _⟩⟩
    let ξ₂ : Fin 3 → C₂ := fun r =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
          ⟨MvPolynomial.X b_idx.castSucc, MvPolynomial.isHomogeneous_X k b_idx.castSucc⟩,
          ⟨1, pow_one _⟩⟩
    have hσ_c : ∀ c : k, σ_line (c₁_hom c) = c₂_hom c := by
      intro c
      apply HomogeneousLocalization.val_injective
      let nd₁ : HomogeneousLocalization.NumDenSameDeg 𝒜_1
          (Submonoid.powers (MvPolynomial.X b_idx : MvPolynomial (Fin 2) k)) :=
        ⟨0, algebraMap k ↥(𝒜_1 0) c, 1, Submonoid.one_mem _⟩
      let nd₂ : HomogeneousLocalization.NumDenSameDeg 𝒜_2
          (Submonoid.powers (MvPolynomial.X b_idx.castSucc : MvPolynomial (Fin 3) k)) :=
        ⟨0, algebraMap k ↥(𝒜_2 0) c, 1, Submonoid.one_mem _⟩
      change HomogeneousLocalization.val
        (HomogeneousLocalization.map ren_gr hsub_ren (HomogeneousLocalization.mk nd₁)) =
        HomogeneousLocalization.val (HomogeneousLocalization.mk nd₂)
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
        HomogeneousLocalization.val_mk]
      congr 1
      · change MvPolynomial.rename Fin.castSucc (MvPolynomial.C c) = MvPolynomial.C c
        exact MvPolynomial.rename_C Fin.castSucc c
      · apply Subtype.ext
        simp [nd₁, nd₂, ren_gr]
    have hσ_ξ : ∀ a : Fin 2, σ_line (ξ₁ a) = ξ₂ a.castSucc := by
      intro a
      apply HomogeneousLocalization.val_injective
      dsimp only [σ_line, ξ₁, ξ₂]
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
        HomogeneousLocalization.val_mk]
      congr 1 <;> simp [ren_gr]
    have hρ_c : ∀ c : k, ρ_line (c₂_hom c) = c₁_hom c := by
      intro c
      let P1 := (weilProjectiveSpaceOver k 1).left
      let id_P1 : P1 ⟶ P1 := 𝟙 P1
      have h_id_U1 : (U₁_fn b_idx) ≤
          (TopologicalSpace.Opens.map id_P1.base).obj (U₁_fn b_idx) := le_rfl
      have hsc_line : (iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b).hom (c₂_hom c) =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (weilProjectiveSpaceOver k 1).hom.appLE ⊤ (U₁_fn b_idx) le_top).hom c :=
        hProjScalarCompat 2 b_idx.castSucc hXb2 (weilProjectiveSpaceOver k 1).hom
          ι_line.left ι_line.w (U₁_fn b_idx) (hProjAffine 1 b_idx) h_b c
      have hsc_id : (iso₁.hom ≫ id_P1.appLE (U₁_fn b_idx) (U₁_fn b_idx) h_id_U1).hom (c₁_hom c) =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (weilProjectiveSpaceOver k 1).hom.appLE ⊤ (U₁_fn b_idx) le_top).hom c :=
        hProjScalarCompat 1 b_idx hXb1 (weilProjectiveSpaceOver k 1).hom
          id_P1 (CategoryTheory.Category.id_comp _) (U₁_fn b_idx) (hProjAffine 1 b_idx) h_id_U1 c
      have hid_app : id_P1.appLE (U₁_fn b_idx) (U₁_fn b_idx) h_id_U1 = 𝟙 _ := by
        have h1' : id_P1.appLE (U₁_fn b_idx) (U₁_fn b_idx) h_id_U1 =
            id_P1.app (U₁_fn b_idx) ≫
              P1.presheaf.map (CategoryTheory.homOfLE h_id_U1).op := rfl
        have h2' : (id_P1.app (U₁_fn b_idx) :
            P1.presheaf.obj (Opposite.op (U₁_fn b_idx)) ⟶
              P1.presheaf.obj (Opposite.op (U₁_fn b_idx))) = 𝟙 _ := by
          dsimp [id_P1]
        have h3' : (P1.presheaf.map (CategoryTheory.homOfLE h_id_U1).op :
            P1.presheaf.obj (Opposite.op (U₁_fn b_idx)) ⟶
              P1.presheaf.obj (Opposite.op (U₁_fn b_idx))) = 𝟙 _ :=
          (congrArg (fun m : U₁_fn b_idx ⟶ U₁_fn b_idx => P1.presheaf.map m.op)
            (Subsingleton.elim (CategoryTheory.homOfLE h_id_U1) (𝟙 (U₁_fn b_idx)))).trans
            (CategoryTheory.Functor.map_id P1.presheaf (Opposite.op (U₁_fn b_idx)))
        exact h1'.trans ((congrArg₂ CategoryTheory.CategoryStruct.comp h2' h3').trans
          (CategoryTheory.Category.id_comp _))
      rw [hid_app, CategoryTheory.Category.comp_id] at hsc_id
      have hmid : (iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b).hom (c₂_hom c) =
          iso₁.hom.hom (c₁_hom c) := hsc_line.trans hsc_id.symm
      dsimp [ρ_line]
      change iso₁.inv.hom
        ((iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b).hom (c₂_hom c)) = _
      rw [hmid]
      exact congrArg (fun φ : CommRingCat.of C₁ ⟶ _ => φ.hom (c₁_hom c)) iso₁.hom_inv_id
    have hρ_ξ : ∀ a : Fin 2, ρ_line (ξ₂ a.castSucc) = ξ₁ a := by
      intro a
      have hc_a : (iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b).hom (ξ₂ a.castSucc) =
          iso₁.hom.hom (ξ₁ a) := hcoord_b a
      dsimp [ρ_line]
      change (iso₁.inv).hom
        ((iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b).hom (ξ₂ a.castSucc)) = _
      rw [hc_a]
      exact congrArg (fun φ : CommRingCat.of C₁ ⟶ _ => φ.hom (ξ₁ a)) iso₁.hom_inv_id
    have hρ_w : ρ_line (ξ₂ 2) = 0 := by
      have hw_0 : (iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b).hom (ξ₂ 2) = 0 := hw_b
      dsimp [ρ_line]
      change (iso₁.inv).hom
        ((iso₂.hom ≫ ι_line.left.appLE (U₂_fn b_idx) (U₁_fn b_idx) h_b).hom (ξ₂ 2)) = 0
      rw [hw_0]
      exact RingHom.map_zero iso₁.inv.hom
    have hρσ_id : ∀ y : C₁, ρ_line (σ_line y) = y := by
      intro y
      obtain ⟨S, coeff, hy_eq⟩ := hHomogLocMonomials 1 b_idx y
      change y = ∑ d ∈ S, c₁_hom (coeff d) * ∏ a : Fin 2, (ξ₁ a) ^ (d a) at hy_eq
      rw [hy_eq, map_sum, map_sum]
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [map_mul, map_mul, map_prod, map_prod, hσ_c, hρ_c]
      congr 1
      refine Finset.prod_congr rfl fun a _ => ?_
      rw [map_pow, map_pow, hσ_ξ, hρ_ξ]
    have hρ_surj : Function.Surjective ρ_line := fun y => ⟨σ_line y, hρσ_id y⟩
    have hker_σρ : ∀ z : C₂, z - σ_line (ρ_line z) ∈ Ideal.span ({ξ₂ 2} : Set C₂) := by
      intro z
      obtain ⟨S, coeff, hz_eq⟩ := hHomogLocMonomials 2 b_idx.castSucc z
      change z = ∑ d ∈ S, c₂_hom (coeff d) * ∏ r : Fin 3, (ξ₂ r) ^ (d r) at hz_eq
      rw [hz_eq, map_sum, map_sum, ← Finset.sum_sub_distrib]
      refine Ideal.sum_mem _ fun d _ => ?_
      rw [Fin.prod_univ_three]
      simp only [map_mul, map_pow]
      rw [hρ_c, hσ_c]
      have h0 : σ_line (ρ_line (ξ₂ 0)) = ξ₂ 0 := by
        change σ_line (ρ_line (ξ₂ (0 : Fin 2).castSucc)) = _
        rw [hρ_ξ, hσ_ξ]; rfl
      have h1 : σ_line (ρ_line (ξ₂ 1)) = ξ₂ 1 := by
        change σ_line (ρ_line (ξ₂ (1 : Fin 2).castSucc)) = _
        rw [hρ_ξ, hσ_ξ]; rfl
      rw [h0, h1, hρ_w, RingHom.map_zero σ_line]
      rcases Nat.eq_zero_or_pos (d 2) with hd2 | hd2
      · rw [hd2, pow_zero, pow_zero, sub_self]
        exact Ideal.zero_mem _
      · obtain ⟨t, ht⟩ := Nat.exists_eq_succ_of_ne_zero hd2.ne'
        rw [ht, zero_pow (Nat.succ_ne_zero t), mul_zero, mul_zero, sub_zero, pow_succ]
        rw [Ideal.mem_span_singleton]
        exact ⟨c₂_hom (coeff d) * (ξ₂ 0 ^ d 0 * ξ₂ 1 ^ d 1 * ξ₂ 2 ^ t), by ring⟩
    have h_le2' : (⊤ : (AlgebraicGeometry.Spec R'_2).Opens) ≤
        (TopologicalSpace.Opens.map e_B2.base).obj (U₂_fn b_idx) := h_le2
    let φ_B2_hom : CommRingCat.of C₂ ⟶ R'_2 :=
      iso₂.hom ≫ e_B2.appLE (U₂_fn b_idx) ⊤ h_le2' ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R'_2).hom
    let φ_B2 : C₂ →+* R'_2 := φ_B2_hom.hom
    have hw2_eq : φ_B2 (ξ₂ 2) = w_2 := hψ_1.symm
    let φ_B1 : C₁ →+* R'_1 := mk_R.comp (φ_B2.comp σ_line)
    have hcomm_φ : φ_B1.comp ρ_line = mk_R.comp φ_B2 := by
      apply RingHom.ext
      intro z
      have hmem := hker_σρ z
      rw [Ideal.mem_span_singleton] at hmem
      rcases hmem with ⟨u, hu⟩
      have hdiff : mk_R (φ_B2 (z - σ_line (ρ_line z))) = 0 := by
        rw [hu, map_mul, map_mul, hw2_eq]
        have hw0 : mk_R w_2 = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton w_2))
        rw [hw0, zero_mul]
      rw [map_sub, map_sub, sub_eq_zero] at hdiff
      exact hdiff.symm
    have hPb_Spec := hSpecPullbackQuotient ρ_line hρ_surj φ_B2 w_2 φ_B1 hcomm_φ ⟨ξ₂ 2, hw2_eq, hρ_w⟩
    let isoSpec₁ : (U₁_fn b_idx).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of C₁) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X b_idx) hXb1 zero_lt_one
    let isoSpec₂ : (U₂_fn b_idx).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of C₂) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_2
        (MvPolynomial.X b_idx.castSucc) hXb2 zero_lt_one
    let e_B1 : AlgebraicGeometry.Spec R'_1 ⟶ (weilProjectiveSpaceOver k 1).left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B1) ≫ isoSpec₁.inv ≫ (U₁_fn b_idx).ι
    let hAff₁ : AlgebraicGeometry.IsAffineOpen (U₁_fn b_idx) := hProjAffine 1 b_idx
    let hAff₂ : AlgebraicGeometry.IsAffineOpen (U₂_fn b_idx) := hProjAffine 2 b_idx.castSucc
    let w₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ (weilProjectiveSpaceOver k 1).left :=
      AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b_idx) hXb1 zero_lt_one
    let w₂ : AlgebraicGeometry.Spec (CommRingCat.of C₂) ⟶ (weilProjectiveSpaceOver k 2).left :=
      AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X b_idx.castSucc) hXb2 zero_lt_one
    have haway_inv₁ : isoSpec₁.inv ≫ (U₁_fn b_idx).ι = w₁ :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_1 (MvPolynomial.X b_idx) hXb1 zero_lt_one
    have haway_inv₂ : isoSpec₂.inv ≫ (U₂_fn b_idx).ι = w₂ :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_2
        (MvPolynomial.X b_idx.castSucc) hXb2 zero_lt_one
    have haway₁ : w₁ = AlgebraicGeometry.Spec.map iso₁.inv ≫ hAff₁.fromSpec :=
      hProjAwayιEq 1 b_idx hXb1
    have haway₂ : w₂ = AlgebraicGeometry.Spec.map iso₂.inv ≫ hAff₂.fromSpec :=
      hProjAwayιEq 2 b_idx.castSucc hXb2
    have he_B2_fac : e_B2 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B2) ≫ isoSpec₂.inv ≫ (U₂_fn b_idx).ι := by
      rw [haway_inv₂, haway₂]
      change e_B2 = AlgebraicGeometry.Spec.map φ_B2_hom ≫
        AlgebraicGeometry.Spec.map iso₂.inv ≫ hAff₂.fromSpec
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hcancel : iso₂.inv ≫ φ_B2_hom =
          e_B2.appLE (U₂_fn b_idx) ⊤ h_le2' ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R'_2).hom := by
        dsimp [φ_B2_hom]
        rw [← CategoryTheory.Category.assoc, iso₂.inv_hom_id, CategoryTheory.Category.id_comp]
      rw [hcancel]
      exact (hSpecFactorFromSpec hAff₂ e_B2 h_le2').symm
    let U₁_pre : (weilProjectiveSpaceOver k 1).left.Opens := ι_line.left ⁻¹ᵁ (U₂_fn b_idx)
    have hLinePreimEq' : U₁_fn b_idx = U₁_pre := hLinePreimEq
    let ι_res_pre : (U₁_pre : AlgebraicGeometry.Scheme.{u}) ⟶ (U₂_fn b_idx : AlgebraicGeometry.Scheme.{u}) :=
      ι_line.left ∣_ (U₂_fn b_idx)
    let eq_U1 : (U₁_fn b_idx : AlgebraicGeometry.Scheme.{u}) ≅ (U₁_pre : AlgebraicGeometry.Scheme.{u}) :=
      { hom := (weilProjectiveSpaceOver k 1).left.homOfLE (le_of_eq hLinePreimEq')
        inv := (weilProjectiveSpaceOver k 1).left.homOfLE (le_of_eq hLinePreimEq'.symm)
        hom_inv_id := by
          rw [← CategoryTheory.cancel_mono (U₁_fn b_idx).ι, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι,
            CategoryTheory.Category.id_comp]
        inv_hom_id := by
          rw [← CategoryTheory.cancel_mono U₁_pre.ι, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι,
            CategoryTheory.Category.id_comp] }
    let ι_res : (U₁_fn b_idx : AlgebraicGeometry.Scheme.{u}) ⟶ (U₂_fn b_idx : AlgebraicGeometry.Scheme.{u}) :=
      eq_U1.hom ≫ ι_res_pre
    have hι_res_comm : ι_res ≫ (U₂_fn b_idx).ι = (U₁_fn b_idx).ι ≫ ι_line.left := by
      dsimp [ι_res, eq_U1, ι_res_pre]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    have hPb_res : CategoryTheory.IsPullback ι_res (U₁_fn b_idx).ι (U₂_fn b_idx).ι ι_line.left := by
      have hpb0 := AlgebraicGeometry.isPullback_morphismRestrict ι_line.left (U₂_fn b_idx)
      refine CategoryTheory.IsPullback.of_iso hpb0 eq_U1.symm
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        ?_ ?_ ?_ ?_
      · dsimp [ι_res]
        rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
          eq_U1.inv_hom_id, CategoryTheory.Category.id_comp]
      · dsimp [eq_U1]
        rw [CategoryTheory.Category.comp_id, AlgebraicGeometry.Scheme.homOfLE_ι]
      · simp
      · simp
    have hρ_iso : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_line) ≫ isoSpec₂.inv =
        isoSpec₁.inv ≫ ι_res := by
      rw [← CategoryTheory.cancel_mono (U₂_fn b_idx).ι, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hι_res_comm, ← CategoryTheory.Category.assoc isoSpec₁.inv,
        haway_inv₁, haway_inv₂, haway₂, haway₁,
        CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
        ← AlgebraicGeometry.Spec.map_comp]
      have hcomm_from := hFromSpecComm ι_line.left hAff₂ hAff₁ h_b
      rw [hcomm_from, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      dsimp [ρ_line]
      rw [← CategoryTheory.Category.assoc, iso₂.inv_hom_id, CategoryTheory.Category.id_comp]
    have hPb_chart : CategoryTheory.IsPullback ι_R1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B1) ≫ isoSpec₁.inv)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B2) ≫ isoSpec₂.inv)
        ι_res := by
      refine CategoryTheory.IsPullback.of_iso hPb_Spec
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) isoSpec₁.symm isoSpec₂.symm
        ?_ ?_ ?_ ?_
      · simp [ι_R1]
      · simp
      · simp
      · simpa using hρ_iso
    refine ⟨e_B1, ?_⟩
    have hpasted := hPb_chart.paste_vert hPb_res
    rwa [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← he_B2_fac] at hpasted

  obtain ⟨e_B1, hPb_eB⟩ := hExists_eB1

  
  have hψ_B1_X : ψ_B1 Polynomial.X = h_1 := by
    dsimp [ψ_B1]
    simp
  have hψ_B1_C : ψ_B1.comp Polynomial.C = mk_R.comp (ψ_B2.comp MvPolynomial.C) := by
    apply RingHom.ext
    intro c
    dsimp [ψ_B1]
    simp
  have hψ_B1_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B1)) := by
    let π_P : MvPolynomial (Fin 2) k →+* Polynomial k :=
      MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0]
    have hπ_P_surj : Function.Surjective π_P := by
      intro p
      refine ⟨Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) p, ?_⟩
      induction p using Polynomial.induction_on' with
      | add p q ihp ihq => simp [Polynomial.eval₂_add, ihp, ihq]
      | monomial n a =>
        simp [Polynomial.eval₂_monomial, π_P, Polynomial.C_mul_X_pow_eq_monomial]
    have hcomm_P : ψ_B1.comp π_P = mk_R.comp ψ_B2 := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        change ψ_B1 (π_P (MvPolynomial.C c)) = mk_R (ψ_B2 (MvPolynomial.C c))
        simp [π_P, ψ_B1]
      · intro i
        fin_cases i
        · simp [π_P, ψ_B1, h_1, hψ_0]
        · simp only [π_P, Fin.mk_one, MvPolynomial.eval₂Hom_X', Matrix.cons_val_one,
            Matrix.cons_val_zero, RingHom.comp_apply, map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.subset_span (Set.mem_singleton w_2))).symm
    have hPb_P := hSpecPullbackQuotient π_P hπ_P_surj ψ_B2 w_2 ψ_B1 hcomm_P
      ⟨MvPolynomial.X 1, rfl, by simp [π_P]⟩
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_P hψ_B2_et

  let P_odp2 := MvPolynomial (Fin (m + 1) × Fin 2) R'_2
  let g_odp2 : P_odp2 :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h_2
  let I_odp2 : Ideal P_odp2 := Ideal.span ({g_odp2} : Set P_odp2)
  let Q_odp2 := P_odp2 ⧸ I_odp2
  let c_Q2 : R'_2 →+* Q_odp2 := (Ideal.Quotient.mk I_odp2).comp MvPolynomial.C

  let P_odp1 := MvPolynomial (Fin (m + 1) × Fin 2) R'_1
  let g_odp1 : P_odp1 :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h_1
  let I_odp1 : Ideal P_odp1 := Ideal.span ({g_odp1} : Set P_odp1)
  let Q_odp1 := P_odp1 ⧸ I_odp1
  let c_Q1 : R'_1 →+* Q_odp1 := (Ideal.Quotient.mk I_odp1).comp MvPolynomial.C

  have hmap_godp : MvPolynomial.map mk_R g_odp2 = g_odp1 := by
    dsimp [g_odp2, g_odp1, h_1]
    simp [map_sub, map_sum, map_mul]
  have hπ_Q_ker : ∀ x ∈ I_odp2,
      ((Ideal.Quotient.mk I_odp1).comp (MvPolynomial.map mk_R)) x = 0 := by
    intro x hx
    rw [Ideal.mem_span_singleton] at hx
    rcases hx with ⟨r, rfl⟩
    simp only [RingHom.comp_apply, map_mul, hmap_godp]
    have hg0 : Ideal.Quotient.mk I_odp1 g_odp1 = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton g_odp1))
    rw [hg0, zero_mul]
  let π_Q : Q_odp2 →+* Q_odp1 :=
    Ideal.Quotient.lift I_odp2 ((Ideal.Quotient.mk I_odp1).comp (MvPolynomial.map mk_R)) hπ_Q_ker
  have hπ_Q_surj : Function.Surjective π_Q := by
    intro y
    obtain ⟨p₁, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨p₂, rfl⟩ := MvPolynomial.map_surjective mk_R Ideal.Quotient.mk_surjective p₁
    exact ⟨Ideal.Quotient.mk I_odp2 p₂, rfl⟩

  let φ_Q2_hom := AlgebraicGeometry.Spec.preimage q_2
  let φ_Q2 : Q_odp2 →+* B'_2 := φ_Q2_hom.hom
  have hq2_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Q2) = q_2 :=
    AlgebraicGeometry.Spec.map_preimage q_2

  let w_tilde2 : B'_2 := φ_Q2 (c_Q2 w_2)
  let I_wtilde2 : Ideal B'_2 := Ideal.span ({w_tilde2} : Set B'_2)
  let mk_B : B'_2 →+* (B'_2 ⧸ I_wtilde2) := Ideal.Quotient.mk I_wtilde2
  let B'_1 : CommRingCat.{u} := CommRingCat.of (B'_2 ⧸ I_wtilde2)
  let ι_B1 : AlgebraicGeometry.Spec B'_1 ⟶ AlgebraicGeometry.Spec B'_2 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_B)

  have hcB_ker : ∀ x ∈ I_w2, (mk_B.comp (φ_Q2.comp c_Q2)) x = 0 := by
    intro x hx
    rw [Ideal.mem_span_singleton] at hx
    rcases hx with ⟨r, rfl⟩
    simp only [RingHom.comp_apply, map_mul]
    have hw0 : mk_B w_tilde2 = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton w_tilde2))
    change mk_B w_tilde2 * mk_B (φ_Q2 (c_Q2 r)) = 0
    rw [hw0, zero_mul]
  let c_B1 : R'_1 →+* B'_1 := Ideal.Quotient.lift I_w2 (mk_B.comp (φ_Q2.comp c_Q2)) hcB_ker

  let φ_P1 : P_odp1 →+* B'_1 :=
    MvPolynomial.eval₂Hom c_B1 (fun idx => mk_B (φ_Q2 (Ideal.Quotient.mk I_odp2 (MvPolynomial.X idx))))
  have hφ_P1_ker : ∀ x ∈ I_odp1, φ_P1 x = 0 := by
    intro x hx
    rw [Ideal.mem_span_singleton] at hx
    rcases hx with ⟨r, rfl⟩
    rw [map_mul]
    have hg0 : φ_P1 g_odp1 = 0 := by
      have hX_eval : ∀ idx : Fin (m + 1) × Fin 2,
          φ_P1 (MvPolynomial.X idx) = mk_B (φ_Q2 (Ideal.Quotient.mk I_odp2 (MvPolynomial.X idx))) :=
        fun idx => MvPolynomial.eval₂Hom_X' c_B1 _ idx
      have hC_eval : φ_P1 (MvPolynomial.C h_1) = mk_B (φ_Q2 (c_Q2 h_2)) := by
        dsimp [φ_P1, c_B1, h_1, mk_R, R'_1]
        rw [MvPolynomial.eval₂Hom_C, Ideal.Quotient.lift_mk]
        rfl
      dsimp [g_odp1]
      rw [map_sub, map_sum, hC_eval]
      simp only [map_mul, hX_eval]
      simp only [← map_mul, ← map_sum, ← map_sub]
      have hg2_zero : Ideal.Quotient.mk I_odp2 g_odp2 = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton g_odp2))
      change mk_B (φ_Q2 (Ideal.Quotient.mk I_odp2 g_odp2)) = 0
      rw [hg2_zero, map_zero, map_zero]
    rw [hg0, zero_mul]
  let φ_Q1 : Q_odp1 →+* B'_1 := Ideal.Quotient.lift I_odp1 φ_P1 hφ_P1_ker
  let q_1 : AlgebraicGeometry.Spec B'_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of Q_odp1) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Q1)

  have hcomm_Q : φ_Q1.comp π_Q = mk_B.comp φ_Q2 := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext'
    · ext r
      dsimp [π_Q, φ_Q1, φ_P1, c_B1, c_Q2, mk_R, R'_1, P_odp1, P_odp2, I_odp1]
      rw [Ideal.Quotient.lift_mk, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C,
        Ideal.Quotient.lift_mk]
      rfl
    · intro idx
      dsimp [π_Q, φ_Q1, φ_P1, mk_R, R'_1, P_odp1, P_odp2, I_odp1]
      rw [Ideal.Quotient.lift_mk, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
  have hπQ_w2 : π_Q (c_Q2 w_2) = 0 := by
    have hw0 : mk_R w_2 = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton w_2))
    dsimp [π_Q, c_Q2, P_odp1, P_odp2]
    rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C, hw0, map_zero, map_zero]
  have ha₀_Q : ∃ a₀ : Q_odp2, φ_Q2 a₀ = w_tilde2 ∧ π_Q a₀ = 0 := ⟨c_Q2 w_2, rfl, hπQ_w2⟩
  have hPb_Q := @hSpecPullbackQuotient Q_odp2 Q_odp1 B'_2 _ _ _
    π_Q hπ_Q_surj φ_Q2 w_tilde2 φ_Q1 hcomm_Q ha₀_Q
  rw [hq2_map] at hPb_Q
  have hq_1_et : AlgebraicGeometry.Etale q_1 :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Q hq_2_et

  have hcomm_RB : (φ_Q1.comp c_Q1).comp mk_R = mk_B.comp (φ_Q2.comp c_Q2) := by
    apply RingHom.ext
    intro r
    dsimp [φ_Q1, φ_P1, c_Q1, c_B1, c_Q2, mk_R, R'_1, P_odp1, P_odp2, I_odp1]
    rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, Ideal.Quotient.lift_mk]
    rfl
  have hPb_RB₀ := hSpecPullbackQuotient mk_R Ideal.Quotient.mk_surjective
    (φ_Q2.comp c_Q2) w_tilde2 (φ_Q1.comp c_Q1) hcomm_RB
    ⟨w_2, rfl, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton w_2))⟩
  have hPb_RB : CategoryTheory.IsPullback ι_B1
      (q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1))
      (q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2))
      ι_R1 := by
    have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_Q1.comp c_Q1)) =
        q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_Q2.comp c_Q2)) =
        q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2) := by
      rw [← hq2_map, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rwa [h1, h2] at hPb_RB₀

  
  let x_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_tilde.left :=
    hPb_line.lift y_pt s_pt hy_g2
  have hx_Y : x_pt ≫ ι_Ytilde.left = y_pt := hPb_line.lift_fst y_pt s_pt hy_g2
  have hx_f0 : x_pt ≫ f₀.left = s_pt := hPb_line.lift_snd y_pt s_pt hy_g2

  have hCl_line : AlgebraicGeometry.IsClosedImmersion ι_line.left := hLine_plane.1
  have hCl_Ytilde : AlgebraicGeometry.IsClosedImmersion ι_Ytilde.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_line.flip hCl_line
  have hinj_line : Function.Injective ι_line.left.base :=
    ((AlgebraicGeometry.isClosedImmersion_iff ι_line.left).mp hCl_line).2.injective
  have hinj_Ytilde : Function.Injective ι_Ytilde.left.base :=
    ((AlgebraicGeometry.isClosedImmersion_iff ι_Ytilde.left).mp hCl_Ytilde).2.injective

  have hx_sm : ∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s_pt.base →
      z ∉ Set.range x_pt.base →
        ∃ V : Z_tilde.left.Opens, z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left) := by
    rintro z ⟨pt₀, hpt₀⟩ hz_not
    have hy_in : g₂.left.base (ι_Ytilde.left.base z) ∈ Set.range (s_pt ≫ ι_line.left).base := by
      refine ⟨pt₀, ?_⟩
      change (s_pt ≫ ι_line.left).base pt₀ = (ι_Ytilde.left ≫ g₂.left).base z
      rw [hPb_line.w]
      change ι_line.left.base (s_pt.base pt₀) = ι_line.left.base (f₀.left.base z)
      rw [hpt₀]
    have hy_not : ι_Ytilde.left.base z ∉ Set.range y_pt.base := by
      rintro ⟨pt₁, hpt₁⟩
      apply hz_not
      refine ⟨pt₁, hinj_Ytilde ?_⟩
      change (x_pt ≫ ι_Ytilde.left).base pt₁ = ι_Ytilde.left.base z
      rw [hx_Y]
      exact hpt₁
    obtain ⟨V₂, hz_V₂, hSm_V₂⟩ := hy_sm (ι_Ytilde.left.base z) hy_in hy_not
    let V₁ : Z_tilde.left.Opens := (TopologicalSpace.Opens.map ι_Ytilde.left.base).obj V₂
    have hpb_V := (AlgebraicGeometry.isPullback_morphismRestrict ι_Ytilde.left V₂).paste_vert hPb_line
    exact ⟨V₁, hz_V₂,
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_V hSm_V₂⟩

  have he_B1_et : AlgebraicGeometry.Etale e_B1 :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_eB he_B2_et

  have he_B1_hom : e_B1 ≫ (weilProjectiveSpaceOver k 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B1) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    calc
      e_B1 ≫ (weilProjectiveSpaceOver k 1).hom
        = e_B1 ≫ (ι_line.left ≫ (weilProjectiveSpaceOver k 2).hom) := by rw [ι_line.w]
      _ = (e_B1 ≫ ι_line.left) ≫ (weilProjectiveSpaceOver k 2).hom := by
          rw [CategoryTheory.Category.assoc]
      _ = (ι_R1 ≫ e_B2) ≫ (weilProjectiveSpaceOver k 2).hom := by rw [hPb_eB.w]
      _ = ι_R1 ≫ (e_B2 ≫ (weilProjectiveSpaceOver k 2).hom) := by
          rw [CategoryTheory.Category.assoc]
      _ = ι_R1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B2) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by rw [he_B2_hom]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (mk_R.comp (ψ_B2.comp MvPolynomial.C))) := by
          dsimp [ι_R1]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_B1.comp Polynomial.C)) := by
          rw [hψ_B1_C]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B1) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  have he_Y1_comm_sq : (ι_B1 ≫ e_Y2) ≫ g₂.left =
      (q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1) ≫ e_B1) ≫ ι_line.left := by
    calc
      (ι_B1 ≫ e_Y2) ≫ g₂.left
        = ι_B1 ≫ (e_Y2 ≫ g₂.left) := by rw [CategoryTheory.Category.assoc]
      _ = ι_B1 ≫ (q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2) ≫ e_B2) := by
          rw [hComm_2]
      _ = (ι_B1 ≫ (q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2))) ≫ e_B2 := by
          simp only [CategoryTheory.Category.assoc]
      _ = ((q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1)) ≫ ι_R1) ≫ e_B2 := by
          rw [hPb_RB.w]
      _ = (q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1)) ≫ (ι_R1 ≫ e_B2) := by
          rw [CategoryTheory.Category.assoc]
      _ = (q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1)) ≫ (e_B1 ≫ ι_line.left) := by
          rw [hPb_eB.w]
      _ = (q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1) ≫ e_B1) ≫ ι_line.left := by
          simp only [CategoryTheory.Category.assoc]

  let e_Y1 : AlgebraicGeometry.Spec B'_1 ⟶ Z_tilde.left :=
    hPb_line.lift (ι_B1 ≫ e_Y2)
      (q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1) ≫ e_B1) he_Y1_comm_sq
  have he_Y1_Y : e_Y1 ≫ ι_Ytilde.left = ι_B1 ≫ e_Y2 :=
    hPb_line.lift_fst _ _ he_Y1_comm_sq
  have hComm_1 : e_Y1 ≫ f₀.left =
      q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1) ≫ e_B1 :=
    hPb_line.lift_snd _ _ he_Y1_comm_sq

  have he_Y1_et : AlgebraicGeometry.Etale e_Y1 := by
    have hPb_tot := hPb_RB.paste_vert hPb_eB
    have h1 : (q_1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q1)) ≫ e_B1 =
        e_Y1 ≫ f₀.left := by
      rw [CategoryTheory.Category.assoc, hComm_1]
    have h2 : (q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2)) ≫ e_B2 =
        e_Y2 ≫ g₂.left := by
      rw [CategoryTheory.Category.assoc, hComm_2]
    rw [h1, h2] at hPb_tot
    have hPb_eY := CategoryTheory.IsPullback.of_bot hPb_tot he_Y1_Y.symm hPb_line
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_eY he_Y2_et

  
  have hu2_zero : u_2 ∈ PrimeSpectrum.zeroLocus (I_w2 : Set R'_2) := by
    intro x hx
    change x ∈ Ideal.span ({w_2} : Set R'_2) at hx
    rw [Ideal.mem_span_singleton] at hx
    rcases hx with ⟨r, rfl⟩
    exact (u_2 : PrimeSpectrum R'_2).asIdeal.mul_mem_right r hw2_u2
  let u_1 : AlgebraicGeometry.Spec R'_1 :=
    (Ideal.primeSpectrumQuotientOrderIsoZeroLocus I_w2).symm ⟨u_2, hu2_zero⟩
  have hu1_map : ι_R1.base u_1 = u_2 := by
    have h := (Ideal.primeSpectrumQuotientOrderIsoZeroLocus I_w2).apply_symm_apply ⟨u_2, hu2_zero⟩
    exact congrArg Subtype.val h
  have hh1_u1 : h_1 ∈ u_1.asIdeal := by
    have h : h_2 ∈ (ι_R1.base u_1).asIdeal := by
      rw [hu1_map]; exact hh2_u2
    exact h

  
  have hSpecBasicOpenTop : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      {R : CommRingCat.{u}} (g : AlgebraicGeometry.Spec R ⟶ X)
      (h_le : (⊤ : (AlgebraicGeometry.Spec R).Opens) ≤ (TopologicalSpace.Opens.map g.base).obj U)
      (s : ↑(X.presheaf.obj (Opposite.op U))),
      (AlgebraicGeometry.Spec R).basicOpen ((g.app U).hom s) =
        PrimeSpectrum.basicOpen
          (((g.appLE U ⊤ h_le) ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R).hom).hom s) := by
    intro X U R g h_le s
    have hres : (AlgebraicGeometry.Spec R).basicOpen ((g.appLE U ⊤ h_le).hom s) =
        (⊤ : (AlgebraicGeometry.Spec R).Opens) ⊓
          (AlgebraicGeometry.Spec R).basicOpen ((g.app U).hom s) := by
      dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
      exact (AlgebraicGeometry.Spec R).basicOpen_res ((g.app U).hom s) (CategoryTheory.homOfLE h_le).op
    rw [top_inf_eq] at hres
    rw [← hres, AlgebraicGeometry.basicOpen_eq_of_affine']
    rfl

  
  let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of k) := (⊥ : PrimeSpectrum k)
  let u'_2 : AlgebraicGeometry.Spec R'_2 :=
    (q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2)).base v_2
  have hu'2_in_line : e_B2.base u'_2 ∈ Set.range ι_line.left.base := by
    have h1 : e_B2.base u'_2 =
        (q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2) ≫ e_B2).base v_2 := rfl
    rw [← hComm_2] at h1
    have h2 : (e_Y2 ≫ g₂.left).base v_2 = g₂.left.base (e_Y2.base v_2) := rfl
    rw [h1, h2, (hpt_2 pt₀).2]
    change (y_pt ≫ g₂.left).base pt₀ ∈ Set.range ι_line.left.base
    rw [hy_g2]
    exact ⟨s_pt.base pt₀, rfl⟩
  have hw2_u'2 : w_2 ∈ u'_2.asIdeal := by
    rw [hLine_plane.2.1] at hu'2_in_line
    let hXb2 : (MvPolynomial.X b_idx.castSucc : MvPolynomial (Fin 3) k) ∈ 𝒜_2 1 :=
      MvPolynomial.isHomogeneous_X k b_idx.castSucc
    let hX2 : (MvPolynomial.X 2 : MvPolynomial (Fin 3) k) ∈ 𝒜_2 ((1 : ℕ) • 1) := by
      rw [one_smul]; exact MvPolynomial.isHomogeneous_X k 2
    let ζ_w := HomogeneousLocalization.Away.mk 𝒜_2 hXb2 1 (MvPolynomial.X 2) hX2
    let s_w : ↑((weilProjectiveSpaceOver k 2).left.presheaf.obj (Opposite.op (U₂_fn b_idx))) :=
      (AlgebraicGeometry.Proj.awayToSection 𝒜_2 (MvPolynomial.X b_idx.castSucc)).hom ζ_w
    have hu'2_not : e_B2.base u'_2 ∉ (weilProjectiveSpaceOver k 2).left.basicOpen s_w := by
      rw [hProjBasicOpenAway 2 b_idx.castSucc hXb2 (MvPolynomial.X 2) hX2]
      rintro ⟨_, hmem2⟩
      exact hu'2_in_line hmem2
    have h_le2_U2 : (⊤ : (AlgebraicGeometry.Spec R'_2).Opens) ≤
        (TopologicalSpace.Opens.map e_B2.base).obj (U₂_fn b_idx) := h_le2
    have hpre_w := AlgebraicGeometry.Scheme.Hom.preimage_basicOpen e_B2 s_w
    have hu'2_not_pre : u'_2 ∉ (TopologicalSpace.Opens.map e_B2.base).obj
        ((weilProjectiveSpaceOver k 2).left.basicOpen s_w) := hu'2_not
    rw [hpre_w, hSpecBasicOpenTop e_B2 h_le2_U2 s_w] at hu'2_not_pre
    have hw_sec_eq : ((e_B2.appLE (U₂_fn b_idx) ⊤ h_le2_U2 ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso R'_2).hom).hom s_w) = w_2 := by
      have hζw_eq : ζ_w = (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X 2, MvPolynomial.isHomogeneous_X k 2⟩,
            ⟨MvPolynomial.X b_idx.castSucc, hXb2⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X b_idx.castSucc)) := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mk]
        congr 1; simp
      dsimp [w_2]
      rw [hψ_1]
      dsimp [s_w]
      rw [hζw_eq]
      rfl
    rw [hw_sec_eq] at hu'2_not_pre
    by_contra hnot
    exact hu'2_not_pre hnot

  have hwtilde_v2 : w_tilde2 ∈ v_2.asIdeal := by
    have h1 : w_2 ∈ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_Q2.comp c_Q2))).base v_2).asIdeal := by
      have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_Q2.comp c_Q2)) =
          q_2 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Q2) := by
        rw [← hq2_map, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hmap]
      exact hw2_u'2
    exact h1

  have hv2_zero : v_2 ∈ PrimeSpectrum.zeroLocus (I_wtilde2 : Set B'_2) := by
    intro x hx
    change x ∈ Ideal.span ({w_tilde2} : Set B'_2) at hx
    rw [Ideal.mem_span_singleton] at hx
    rcases hx with ⟨r, rfl⟩
