    let e_Z₀ := e_pullIso π₀ V₀.hom (iso_Z C₀ f₀ hf₀)
      (h_iso_proj C₀ f₀ hf₀).1 (h_iso_proj C₀ f₀ hf₀).2 ℱ
    let Ξ := (Θ X V₀ ℱ b).trans
      (e_Z₀.trans (reb₀ (CategoryTheory.CategoryStruct.id Z₀) π₀
        (CategoryTheory.Category.id_comp π₀)).symm)
    refine ⟨Ξ, ?_⟩
    intro C₁ _ g₁ _hg₁ hf₁ s₀ π₁
    let f₁ := g₁.comp f₀
    let U₁ := U_of R C₁ f₁ hf₁
    let V₁ := (weilAltCdSitePullback p).obj U₁
    let w_tilde := (weilAltCdSitePullback p).map (w_of R f₀ hf₀ g₁ hf₁)
    let π_C₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial C₁))) X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom f₁))
    let e_Z₁ := e_pullIso π_C₁ V₁.hom (iso_Z C₁ f₁ hf₁)
      (h_iso_proj C₁ f₁ hf₁).1 (h_iso_proj C₁ f₁ hf₁).2 ℱ
    have hπ_comp : CategoryTheory.CategoryStruct.comp π₁ π₀ = π_C₁ :=
      (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp _ _).symm.trans
            (congrArg CommRingCat.ofHom (Polynomial.mapRingHom_comp g₁ f₀))))
    have h_sq :
        CategoryTheory.CategoryStruct.comp (iso_Z C₁ f₁ hf₁).hom w_tilde.left =
        CategoryTheory.CategoryStruct.comp π₁ (iso_Z C₀ f₀ hf₀).hom :=
      h_iso_nat C₀ C₁ f₀ hf₀ g₁ hf₁
    have h_pull_eq :
        e_Z₁ (Θ X V₁ ℱ b ((P_ℱ.map (Opposite.op (w_of R f₀ hf₀ g₁ hf₁))).hom s₀)) =
        weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite π_C₁ π₀ π₁ hπ_comp ℱ b
          (reb₀ (CategoryTheory.CategoryStruct.id Z₀) π₀
            (CategoryTheory.Category.id_comp π₀) (Ξ s₀)) := by
      have h1 :
          Θ X V₁ ℱ b ((P_ℱ.map (Opposite.op (w_of R f₀ hf₀ g₁ hf₁))).hom s₀) =
          weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite V₁.hom V₀.hom w_tilde.left
            (CategoryTheory.MorphismProperty.Over.w w_tilde) ℱ b (Θ X V₀ ℱ b s₀) :=
        hΘ_contra X w_tilde ℱ b s₀
      have h2 :
          e_Z₁ (weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite V₁.hom V₀.hom
            w_tilde.left (CategoryTheory.MorphismProperty.Over.w w_tilde) ℱ b (Θ X V₀ ℱ b s₀)) =
          weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite π_C₁ π₀ π₁ hπ_comp ℱ b
            (e_Z₀ (Θ X V₀ ℱ b s₀)) :=
        (hTriPullComp V₁.hom V₀.hom π_C₁ w_tilde.left (iso_Z C₁ f₁ hf₁).hom
          (CategoryTheory.MorphismProperty.Over.w w_tilde) (h_iso_proj C₁ f₁ hf₁).1
          (by rw [CategoryTheory.Category.assoc, CategoryTheory.MorphismProperty.Over.w w_tilde,
            (h_iso_proj C₁ f₁ hf₁).1])
          ℱ (Θ X V₀ ℱ b s₀)).symm.trans
          ((hTriPullCongr π_C₁ V₀.hom
            (CategoryTheory.CategoryStruct.comp (iso_Z C₁ f₁ hf₁).hom w_tilde.left)
            (CategoryTheory.CategoryStruct.comp π₁ (iso_Z C₀ f₀ hf₀).hom)
            h_sq _
            (by rw [CategoryTheory.Category.assoc, (h_iso_proj C₀ f₀ hf₀).1, hπ_comp])
            ℱ (Θ X V₀ ℱ b s₀)).trans
            (hTriPullComp π₀ V₀.hom π_C₁ (iso_Z C₀ f₀ hf₀).hom π₁
              (h_iso_proj C₀ f₀ hf₀).1 hπ_comp _ ℱ (Θ X V₀ ℱ b s₀)))
      have h3 :
          e_Z₀ (Θ X V₀ ℱ b s₀) =
          reb₀ (CategoryTheory.CategoryStruct.id Z₀) π₀
            (CategoryTheory.Category.id_comp π₀) (Ξ s₀) :=
        ((reb₀ (CategoryTheory.CategoryStruct.id Z₀) π₀
          (CategoryTheory.Category.id_comp π₀)).apply_symm_apply _).symm
      exact (congrArg e_Z₁ h1).trans (h2.trans (congrArg _ h3))
    have h_zero_iff :
        (P_ℱ.map (Opposite.op (w_of R f₀ hf₀ g₁ hf₁))).hom s₀ = 0 ↔
        e_Z₁ (Θ X V₁ ℱ b ((P_ℱ.map (Opposite.op (w_of R f₀ hf₀ g₁ hf₁))).hom s₀)) = 0 :=
      (AddEquiv.map_eq_zero_iff (Θ X V₁ ℱ b)).symm.trans (AddEquiv.map_eq_zero_iff e_Z₁).symm
    have h_eq_zero_iff :
        e_Z₁ (Θ X V₁ ℱ b ((P_ℱ.map (Opposite.op (w_of R f₀ hf₀ g₁ hf₁))).hom s₀)) = 0 ↔
        weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite π_C₁ π₀ π₁ hπ_comp ℱ b
