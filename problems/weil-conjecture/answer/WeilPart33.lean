      { desc := fun s =>
          let descFun : κ → ↑s.pt := fun x =>
            (s.ι.app (F_of x)).hom ⟨x, hmem_F_of x⟩
          have h_indep : ∀ (F : ℐ) (y : ↥F.1),
              (s.ι.app F).hom y = descFun (y : κ) := by
            intro F y
            let _ : FiniteDimensional K_sep ↥F.1 := F.2
            let _ : FiniteDimensional K_sep ↥(F_of (y : κ)).1 := (F_of (y : κ)).2
            let F_sup : ℐ :=
              ⟨F.1 ⊔ (F_of (y : κ)).1,
                IntermediateField.finiteDimensional_sup F.1 (F_of (y : κ)).1⟩
            let i₁ : F ⟶ F_sup := CategoryTheory.homOfLE (le_sup_left : F.1 ≤ F_sup.1)
            let i₂ : F_of (y : κ) ⟶ F_sup :=
              CategoryTheory.homOfLE (le_sup_right : (F_of (y : κ)).1 ≤ F_sup.1)
