        let w_γ : Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_2 (MvPolynomial.X γ))) ⟶ Proj 𝒜_2 :=
          AlgebraicGeometry.Proj.awayι 𝒜_2 (MvPolynomial.X γ) hXγ zero_lt_one
        let χ_γ := (isoAway_γ.hom ≫ s'.appLE U_γ ⊤ hs_γ ≫ (Scheme.ΓSpecIso (CommRingCat.of k)).hom).hom
