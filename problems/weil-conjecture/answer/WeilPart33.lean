      have : AlgebraicGeometry.IsFinite ν := hFin_ν
      have : AlgebraicGeometry.Surjective (ν ∣_ U₂) := hSurj_νU₂
      let g_left : Y' ⟶ A₁.left := ν ≫ iY₀
      have hFin_g : AlgebraicGeometry.IsFinite g_left := inferInstance
      have : AlgebraicGeometry.IsFinite g_left := hFin_g
      have : AlgebraicGeometry.IsProper g_left := inferInstance
      have : AlgebraicGeometry.IsAffineHom g_left := inferInstance
      have : AlgebraicGeometry.IsAffine Y' := AlgebraicGeometry.isAffine_of_isAffineHom g_left
      have hCl_bad : IsClosed (⇑iY₀.base '' ((U₂ : Set ↥Y₀)ᶜ)) :=
