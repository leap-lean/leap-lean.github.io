            rw [hI_map, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub, sub_eq_zero]
            exact hx_eq
          rcases (IsLocalization.algebraMap_mem_map_algebraMap_iff
              (Submonoid.powers (MvPolynomial.C g : MvPolynomial σ R_1))
              (MvPolynomial σ R_2) I_1 (P_1 - P_2)).mp hmem_I2 with ⟨_, ⟨n, rfl⟩, hn_mem⟩
          refine ⟨⟨bar_g ^ n, n, rfl⟩, ?_⟩
          suffices hsub : bar_g ^ n * (Ideal.Quotient.mk I_1 P_1 - Ideal.Quotient.mk I_1 P_2) = 0 by
            linear_combination hsub
          change (Ideal.Quotient.mk I_1 (MvPolynomial.C g)) ^ n *
            (Ideal.Quotient.mk I_1 P_1 - Ideal.Quotient.mk I_1 P_2) = 0
          rw [← map_pow, ← map_sub, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
