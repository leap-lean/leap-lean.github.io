    have hKrullDrop : ∀ (T : Type u) [TopologicalSpace T] [IrreducibleSpace T],
        topologicalKrullDim T = ((1 : ℕ) : WithBot ℕ∞) →
        ∀ (S : Type u) [TopologicalSpace S] (e : S → T),
        Topology.IsClosedEmbedding e →
        Set.range e ≠ Set.univ →
        topologicalKrullDim S ≤ (0 : WithBot ℕ∞) := by
      intro T _ _ hDimT S _ e he hne
      suffices hlt : Order.krullDim (TopologicalSpace.IrreducibleCloseds S) <
          ((1 : ℕ) : WithBot ℕ∞) by
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds S) ≤ (0 : WithBot ℕ∞)
        rcases h_eq : Order.krullDim (TopologicalSpace.IrreducibleCloseds S) with _ | d_enat
        · exact bot_le
        · rw [h_eq] at hlt
          rcases d_enat with _ | k_nat
          · exact absurd (WithBot.coe_lt_coe.mp hlt) not_top_lt
          · have hk : (k_nat : ℕ∞) < ((1 : ℕ) : ℕ∞) := WithBot.coe_lt_coe.mp hlt
            have hk' : k_nat < 1 := ENat.natCast_lt_natCast.mp hk
            exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr (by omega))
      rw [Order.krullDim_lt_coe_iff]
      intro l
      let Φ : TopologicalSpace.IrreducibleCloseds S → TopologicalSpace.IrreducibleCloseds T :=
        fun K => ⟨e '' K.carrier, K.isIrreducible'.image e he.continuous.continuousOn,
          he.isClosedMap _ K.isClosed'⟩
      have hStrict : StrictMono Φ := by
        intro K₁ K₂ hK
        rw [lt_iff_le_not_ge] at hK ⊢
        refine ⟨Set.image_mono hK.1, fun hge => hK.2 (fun x hx => ?_)⟩
        obtain ⟨y, hy, hyx⟩ := hge ⟨x, hx, rfl⟩
        exact he.injective hyx ▸ hy
      let l' : LTSeries (TopologicalSpace.IrreducibleCloseds T) := l.map Φ hStrict
      let U_top : TopologicalSpace.IrreducibleCloseds T :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ T, isClosed_univ⟩
      have hlast_lt : l'.last < U_top := by
        rw [lt_iff_le_not_ge]
        refine ⟨Set.subset_univ _, fun hge => hne (Set.eq_univ_of_forall fun t => ?_)⟩
        have ht : t ∈ (l'.last : Set T) := hge (Set.mem_univ t)
        have hlast_eq : l'.last = Φ l.last := rfl
        rw [hlast_eq] at ht
        obtain ⟨s, _, rfl⟩ := ht
        exact ⟨s, rfl⟩
      let l'' : LTSeries (TopologicalSpace.IrreducibleCloseds T) := l'.snoc U_top hlast_lt
      have hDimT_lt : Order.krullDim (TopologicalSpace.IrreducibleCloseds T) <
          ((2 : ℕ) : WithBot ℕ∞) := by
        change topologicalKrullDim T < ((2 : ℕ) : WithBot ℕ∞)
        rw [hDimT]
        exact WithBot.coe_lt_coe.mpr (ENat.natCast_lt_natCast.mpr (by omega))
      have hlen := (Order.krullDim_lt_coe_iff.mp hDimT_lt) l''
      have hlen_eq : l''.length = l.length + 1 := RelSeries.snoc_length l' U_top hlast_lt
      omega

    have hRingDim : ∀ {R B : Type u} [CommRing R] [CommRing B] (φ : R →+* B),
        Function.Injective φ → RingHom.IsIntegral φ → ringKrullDim B = ringKrullDim R := by
      intro R B _ _ φ hInj hInt
      let _ : Algebra R B := φ.toAlgebra
      have : Algebra.IsIntegral R B := ⟨hInt⟩
      apply le_antisymm
      · apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap φ)
        intro q₁ q₂ hlt
        have h_not_le : ¬ (q₂.asIdeal ≤ q₁.asIdeal) := not_le_of_gt hlt
        obtain ⟨x, hxq₂, hxq₁⟩ := Set.not_subset.mp h_not_le
        have hx_sdiff : x ∈ (q₂.asIdeal : Set B) \ (q₁.asIdeal : Set B) := ⟨hxq₂, hxq₁⟩
        have h_int_x : IsIntegral R x := hInt x
        have := q₁.isPrime
        exact Ideal.under_lt_under_of_integral_mem_sdiff (R := R) (le_of_lt hlt) hx_sdiff h_int_x
      · have h_lift : ∀ (m : ℕ) (p : LTSeries (PrimeSpectrum R)), p.length = m →
            ∃ (q : LTSeries (PrimeSpectrum B)),
              q.length = m ∧ Ideal.under R q.last.asIdeal = p.last.asIdeal := by
          intro m
          induction m with
          | zero =>
            intro p _
            have h_bot : Ideal.under R (⊥ : Ideal B) ≤ p.last.asIdeal := by
              intro r hr
              have hr0 : φ r = 0 := Ideal.mem_bot.mp hr
              have hr_eq : r = 0 := hInj (hr0.trans (map_zero φ).symm)
              rw [hr_eq]
              exact p.last.asIdeal.zero_mem
            have := p.last.isPrime
            obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
              Ideal.exists_ideal_over_prime_of_isIntegral (R := R) (S := B)
                p.last.asIdeal (⊥ : Ideal B) h_bot
            exact ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, hQ₀_under⟩
          | succ m ih =>
            intro p hp_len
            let p' : LTSeries (PrimeSpectrum R) := p.eraseLast
            have hp'_len : p'.length = m := by
              rw [RelSeries.eraseLast_length, hp_len]
              omega
            have hp'_lt : p'.last < p.last := p.eraseLast_last_rel_last (by omega)
            obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
            have h_le_under : Ideal.under R q'.last.asIdeal ≤ p.last.asIdeal := by
              rw [hq'_under]
              exact le_of_lt hp'_lt
            have := p.last.isPrime
            have := q'.last.isPrime
            obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
              Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (R := R) (S := B)
                p.last.asIdeal q'.last.asIdeal h_le_under
            have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum B) := by
              refine lt_of_le_not_ge hQ_ge (fun h_ge => ?_)
              have h_eq : Q_next = q'.last.asIdeal := le_antisymm h_ge hQ_ge
              have h_under_eq : p.last.asIdeal = p'.last.asIdeal := by
                rw [← hQ_under, h_eq, hq'_under]
              exact (ne_of_lt hp'_lt) (PrimeSpectrum.ext h_under_eq.symm)
            let q : LTSeries (PrimeSpectrum B) := q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q
            refine ⟨q, ?_, ?_⟩
            · rw [RelSeries.snoc_length, hq'_len]
            · rw [RelSeries.last_snoc]
              exact hQ_under
        change ⨆ (p : LTSeries (PrimeSpectrum R)), (p.length : WithBot ℕ∞) ≤ ringKrullDim B
        apply iSup_le
        intro p
        obtain ⟨q, hq_len, _⟩ := h_lift p.length p rfl
        calc (p.length : WithBot ℕ∞)
            = (q.length : WithBot ℕ∞) := by rw [hq_len]
          _ ≤ Order.krullDim (PrimeSpectrum B) := Order.LTSeries.length_le_krullDim q
          _ = ringKrullDim B := rfl

    intro A₁ Y₀ iY₀
