                Localization.mk (∑ m ∈ s, g m) (y₁ ^ n) := by
            intro s g
            induction s using Finset.induction_on with
            | empty => rw [Finset.sum_empty, Finset.sum_empty, Localization.mk_zero]
            | @insert m₀ s' hm₀ ihs =>
