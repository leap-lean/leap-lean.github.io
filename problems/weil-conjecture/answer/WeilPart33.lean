      intro hmem
      have hzero : q_𝔭 δ_B = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      exact hunit_q.ne_zero hzero
    
    refine ⟨δ_B, hδ_notMem, ?_⟩
    intro B_loc _ _ _
    let f_tot : R_2 →+* B_loc := (algebraMap B_pb B_loc).comp ρ_B
