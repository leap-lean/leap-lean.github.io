    (w : Fin 3 → k) (hw_ne : w ≠ 0)
    (β : Fin 3) (hwβ : w β ≠ 0)
    (z_c : Z_bar.left) (hClosed_zc : IsClosed ({z_c} : Set Z_bar.left))
    (hTrans_compl : IsTransversalLinearSlice k M Z_bar ι_bar
      ⟨{z_c}ᶜ, hClosed_zc.isOpen_compl⟩ (2 * m + 1) 1
      ![∑ r : Fin 3, MvPolynomial.C (w r) * L r])
    (α₀ : Fin (M + 1))
    (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1)
    (V_Z : Z_bar.left.Opens)
    (hAffV : AlgebraicGeometry.IsAffineOpen V_Z)
    (hz_c : z_c ∈ V_Z)
    [Algebra k ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z))]
