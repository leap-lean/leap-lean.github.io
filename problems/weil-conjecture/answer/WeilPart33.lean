theorem weil_algClosed_pointed_generic_dvr_pencil_algebra_package (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (k_sl N' : ℕ) (hN' : 1 ≤ N')
    (B : Fin (N' + 1 + 1) → Type u)
    [∀ α : Fin (N' + 1 + 1), CommRing (B α)]
    [∀ α : Fin (N' + 1 + 1), Algebra Ω (B α)]
    [∀ α : Fin (N' + 1 + 1), Algebra.FiniteType Ω (B α)]
    (r_coord : ∀ α : Fin (N' + 1 + 1), Fin (N' + 1 + 1) → B α)
    (hr_diag : ∀ α : Fin (N' + 1 + 1), r_coord α α = 1)
    (c_F : Fin (N' + 1) → Ω) (hc_F : c_F ≠ 0)
    (ev₀ : B 0 →ₐ[Ω] Ω)
    (hev₀_ker : RingHom.ker ev₀.toRingHom =
      Ideal.span (Set.range (fun β : Fin (N' + 1) => r_coord 0 β.succ)))
    (hDom₀ : IsDomain (B 0) ∧ ringKrullDim (B 0) = ((k_sl + 2 : ℕ) : WithBot ℕ∞))
    (hDom : ∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
      IsDomain (B β.succ) ∧
      ringKrullDim (B β.succ) = ((k_sl + 2 : ℕ) : WithBot ℕ∞) ∧
      (∑ γ : Fin (N' + 1), algebraMap Ω (B β.succ) (c_F γ) * r_coord β.succ γ.succ) ≠ 0)
    (hSpec : ∀ (β : Fin (N' + 1)), Nontrivial (B β.succ) →
      ∀ (t₀ : Ω), t₀ ≠ 0 →
      ∀ (P : MvPolynomial (Fin (k_sl + 1) × Fin (N' + 1)) Ω), P ≠ 0 →
      ∃ (u_val : Fin (k_sl + 1) × Fin (N' + 1) → Ω)
        (ev_w : B β.succ →+* Ω),
        ev_w.comp (algebraMap Ω (B β.succ)) = RingHom.id Ω ∧
        MvPolynomial.eval u_val P ≠ 0 ∧
        (∀ i : Fin k_sl,
          ∑ γ : Fin (N' + 1), u_val (i.castSucc, γ) * ev_w (r_coord β.succ γ.succ) = 0) ∧
        (∑ γ : Fin (N' + 1), c_F γ * ev_w (r_coord β.succ γ.succ)) +
          t₀ * (∑ γ : Fin (N' + 1),
            u_val (Fin.last k_sl, γ) * ev_w (r_coord β.succ γ.succ)) = 0) :
    ∃ (L : Type u) (_ : Field L) (_ : Infinite L) (_ : Algebra Ω L)
      (R : Type u) (_ : CommRing R) (_ : IsDomain R)
      (_ : IsPrincipalIdealRing R) (_ : IsLocalRing R)
      (_ : Algebra Ω R) (_ : Algebra L R) (_ : IsScalarTower Ω L R)
      (ϖ : R)
      (ev_R : R →ₐ[L] L)
      (u_L : Fin k_sl → Fin (N' + 1) → L)
      (v_L : Fin (N' + 1) → L),
      let K_gen : Type u := FractionRing R
      let h_eq_R : ∀ (α : Fin (N' + 1 + 1)), Fin k_sl → TensorProduct Ω (B α) R :=
        fun α i => ∑ γ : Fin (N' + 1), (r_coord α γ.succ) ⊗ₜ[Ω] (algebraMap L R (u_L i γ))
      let p_eq_R : ∀ (α : Fin (N' + 1 + 1)), TensorProduct Ω (B α) R :=
        fun α =>
          (∑ γ : Fin (N' + 1),
            (algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ) ⊗ₜ[Ω] (1 : R)) +
          (∑ γ : Fin (N' + 1),
            (r_coord α γ.succ) ⊗ₜ[Ω] (ϖ * algebraMap L R (v_L γ)))
      let J_R : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) R) :=
        fun α => Ideal.span ({p_eq_R α} ∪ Set.range (h_eq_R α))
      let toK : ∀ (α : Fin (N' + 1 + 1)),
          TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) K_gen :=
        fun α =>
          (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
            (IsScalarTower.toAlgHom Ω R K_gen)).toRingHom
      let toL : ∀ (α : Fin (N' + 1 + 1)),
          TensorProduct Ω (B α) R →+* TensorProduct Ω (B α) L :=
        fun α =>
          (Algebra.TensorProduct.map (AlgHom.id Ω (B α))
            (ev_R.restrictScalars Ω)).toRingHom
      let J_K : ∀ (α : Fin (N' + 1 + 1)), Ideal (TensorProduct Ω (B α) K_gen) :=
        fun α => Ideal.map (toK α) (J_R α)
      let J_L : ∀ (β : Fin (N' + 1)), Ideal (TensorProduct Ω (B β.succ) L) :=
        fun β => Ideal.map (toL β.succ) (J_R β.succ)
      let m0_K : Ideal (TensorProduct Ω (B 0) K_gen) :=
        RingHom.ker
          (Algebra.TensorProduct.lift ((Algebra.ofId Ω K_gen).comp ev₀) (AlgHom.id Ω K_gen)
            (fun _ _ => Commute.all _ _)).toRingHom
      (ϖ ≠ 0 ∧
        IsLocalRing.maximalIdeal R = Ideal.span {ϖ} ∧
        Function.Bijective ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap L R)) ∧
        RingHom.ker ev_R.toRingHom = Ideal.span {ϖ} ∧
        ∀ i : Fin k_sl, u_L i ≠ 0) ∧
      (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
        IsDomain ((TensorProduct Ω (B β.succ) K_gen) ⧸ J_K β.succ) ∧
        ringKrullDim ((TensorProduct Ω (B β.succ) K_gen) ⧸ J_K β.succ) ≤ (1 : WithBot ℕ∞) ∧
        ∀ b : B β.succ, b ≠ 0 → b ⊗ₜ[Ω] (1 : K_gen) ∉ J_K β.succ) ∧
      (∃ (Q₀ : PrimeSpectrum (TensorProduct Ω (B 0) K_gen)) (β₁ : Fin (N' + 1)),
        J_K 0 ≤ Q₀.asIdeal ∧
        Q₀.asIdeal ≤ m0_K ∧
        r_coord 0 β₁.succ ⊗ₜ[Ω] (1 : K_gen) ∉ Q₀.asIdeal ∧
        (1 : WithBot ℕ∞) ≤ ringKrullDim ((TensorProduct Ω (B 0) K_gen) ⧸ Q₀.asIdeal)) ∧
      (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
        ringKrullDim ((TensorProduct Ω (B β.succ) L) ⧸ J_L β) ≤ (1 : WithBot ℕ∞) ∧
        ∀ 𝔮_L : PrimeSpectrum (TensorProduct Ω (B β.succ) L),
          J_L β ≤ 𝔮_L.asIdeal →
          Ideal.comap (toK β.succ) (J_K β.succ) ≤
            (PrimeSpectrum.comap (toL β.succ) 𝔮_L).asIdeal) :=
by
  have : Infinite Ω := IsAlgClosed.instInfinite
  have _ := hc_F

  
  
  
  have hNull : ∀ (A : Type u) [CommRing A] [Nontrivial A] [Algebra Ω A] [Algebra.FiniteType Ω A],
      Nonempty (A →ₐ[Ω] Ω) := by
    intro A _ _ _ _
    obtain ⟨n, φ, hφ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := Ω) (S := A)).mp inferInstance
    let J : Ideal (MvPolynomial (Fin n) Ω) := RingHom.ker φ.toRingHom
    have hJ_ne_top : J ≠ ⊤ := by
      rw [Ideal.ne_top_iff_one]
      change φ 1 ≠ 0
      rw [map_one]
      exact one_ne_zero
    obtain ⟨m_max, hm_max, hJ_le⟩ := Ideal.exists_le_maximal J hJ_ne_top
    obtain ⟨x₀, rfl⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := Ω)).mp hm_max
    have hker : ∀ p : MvPolynomial (Fin n) Ω, φ p = 0 → MvPolynomial.aeval x₀ p = 0 := by
      intro p hp
      have hpm : p ∈ MvPolynomial.vanishingIdeal Ω ({x₀} : Set (Fin n → Ω)) := hJ_le hp
      rw [MvPolynomial.mem_vanishingIdeal_iff] at hpm
      exact hpm x₀ (Set.mem_singleton x₀)
    let pre : A → MvPolynomial (Fin n) Ω := fun a => Classical.choose (hφ_surj a)
    have hpre : ∀ a : A, φ (pre a) = a := fun a => Classical.choose_spec (hφ_surj a)
    have heval_eq : ∀ p : MvPolynomial (Fin n) Ω,
        MvPolynomial.aeval x₀ (pre (φ p)) = MvPolynomial.aeval x₀ p := by
      intro p
      have hsub : φ (pre (φ p) - p) = 0 := by rw [map_sub, hpre, sub_self]
      have h0 := hker _ hsub
      rwa [map_sub, sub_eq_zero] at h0
    refine ⟨{
      toFun := fun a => MvPolynomial.aeval x₀ (pre a)
      map_one' := by rw [← map_one φ, heval_eq, map_one]
      map_mul' := fun a b => by
        nth_rw 1 [← hpre a, ← hpre b]
        rw [← map_mul φ, heval_eq, map_mul]
      map_zero' := by rw [← map_zero φ, heval_eq, map_zero]
      map_add' := fun a b => by
        nth_rw 1 [← hpre a, ← hpre b]
        rw [← map_add φ, heval_eq, map_add]
      commutes' := fun c => by
        have hc : algebraMap Ω A c = φ (MvPolynomial.C c) := by simp
        rw [hc, heval_eq, MvPolynomial.aeval_C]
    }⟩

  have hTensDom : ∀ (E : Type u) [Field E] [Algebra Ω E]
      (C : Type u) [CommRing C] [IsDomain C] [Algebra Ω C] [Algebra.FiniteType Ω C],
      IsDomain (TensorProduct Ω C E) := by
    intro E _ _ C _ _ _ _
    obtain ⟨ψ₀⟩ := hNull C
    let Ψ₀ : TensorProduct Ω C E →ₐ[Ω] E :=
      Algebra.TensorProduct.lift ((Algebra.ofId Ω E).comp ψ₀) (AlgHom.id Ω E)
        (fun _ _ => Commute.all _ _)
    have : Nontrivial (TensorProduct Ω C E) := by
      refine ⟨⟨1, 0, fun h10 => ?_⟩⟩
      have hE : (1 : E) = 0 := by
        calc (1 : E) = Ψ₀ 1 := (map_one Ψ₀).symm
          _ = Ψ₀ 0 := congrArg Ψ₀ h10
          _ = 0 := map_zero Ψ₀
      exact one_ne_zero hE
    let b := Module.Basis.ofVectorSpace Ω E
    let B_bas := Algebra.TensorProduct.basis C b
    have hcoord : ∀ (ψ : C →ₐ[Ω] Ω) (z : TensorProduct Ω C E)
        (i : Module.Basis.ofVectorSpaceIndex Ω E),
        (b.repr (Algebra.TensorProduct.lift ((Algebra.ofId Ω E).comp ψ) (AlgHom.id Ω E)
          (fun _ _ => Commute.all _ _) z)) i = ψ ((B_bas.repr z) i) := by
      intro ψ z i
      let Ψ : TensorProduct Ω C E →ₐ[Ω] E :=
        Algebra.TensorProduct.lift ((Algebra.ofId Ω E).comp ψ) (AlgHom.id Ω E)
          (fun _ _ => Commute.all _ _)
      change (b.repr (Ψ z)) i = ψ ((B_bas.repr z) i)
      induction z using TensorProduct.inductionOn with
      | tmul c e =>
        have hΨ : Ψ (c ⊗ₜ[Ω] e) = ψ c • e := by
          simp [Ψ, Algebra.TensorProduct.lift_tmul, Algebra.smul_def]
        rw [hΨ, map_smul, Finsupp.smul_apply, smul_eq_mul]
        have hB : (B_bas.repr (c ⊗ₜ[Ω] e)) i = c * algebraMap Ω C ((b.repr e) i) := by
          simp [B_bas, Algebra.TensorProduct.basis_repr_tmul, Finsupp.mapRange_apply, smul_eq_mul]
        rw [hB, map_mul, AlgHom.commutes]
        simp
      | add x y hx hy =>
        simp [map_add, hx, hy]
    have : NoZeroDivisors (TensorProduct Ω C E) := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra hnot
      push Not at hnot
      rcases hnot with ⟨hx, hy⟩
      have hBx : B_bas.repr x ≠ 0 := fun h => hx (B_bas.repr.injective (by simpa using h))
      have hBy : B_bas.repr y ≠ 0 := fun h => hy (B_bas.repr.injective (by simpa using h))
      obtain ⟨i₀, ha₀⟩ : ∃ i₀, (B_bas.repr x) i₀ ≠ 0 := by
        by_contra h; push Not at h; exact hBx (Finsupp.ext h)
      obtain ⟨j₀, hb₀⟩ : ∃ j₀, (B_bas.repr y) j₀ ≠ 0 := by
        by_contra h; push Not at h; exact hBy (Finsupp.ext h)
      let c₀ : C := (B_bas.repr x) i₀ * (B_bas.repr y) j₀
      have hc₀ : c₀ ≠ 0 := mul_ne_zero ha₀ hb₀
      have hle : Submonoid.powers c₀ ≤ nonZeroDivisors C :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hc₀)
      let C' := Localization.Away c₀
      have : IsDomain C' := IsLocalization.isDomain_localization hle
      have : Algebra.FiniteType Ω C' :=
        Algebra.FiniteType.trans (S := C) inferInstance inferInstance
      obtain ⟨ψ'⟩ := hNull C'
      let ψ : C →ₐ[Ω] Ω := ψ'.comp (IsScalarTower.toAlgHom Ω C C')
      have hψc₀ : ψ c₀ ≠ 0 := by
        intro h0
        have hmul : ψ' (algebraMap C C' c₀ * IsLocalization.Away.invSelf (S := C') c₀) = ψ' 1 :=
          congrArg ψ' (IsLocalization.Away.mul_invSelf c₀)
        rw [map_mul, map_one] at hmul
        have h1 : ψ' (algebraMap C C' c₀) = ψ c₀ := rfl
        rw [h1, h0, zero_mul] at hmul
        exact zero_ne_one hmul
      have hψa₀ : ψ ((B_bas.repr x) i₀) ≠ 0 := fun h0 => hψc₀ (by simp [c₀, map_mul, h0])
      have hψb₀ : ψ ((B_bas.repr y) j₀) ≠ 0 := fun h0 => hψc₀ (by simp [c₀, map_mul, h0])
      let Ψ : TensorProduct Ω C E →ₐ[Ω] E :=
        Algebra.TensorProduct.lift ((Algebra.ofId Ω E).comp ψ) (AlgHom.id Ω E)
          (fun _ _ => Commute.all _ _)
      have hΨx : Ψ x ≠ 0 := by
        intro h0
        have := hcoord ψ x i₀
        change (b.repr (Ψ x)) i₀ = ψ ((B_bas.repr x) i₀) at this
        rw [h0, map_zero, Finsupp.zero_apply] at this
        exact hψa₀ this.symm
      have hΨy : Ψ y ≠ 0 := by
        intro h0
        have := hcoord ψ y j₀
        change (b.repr (Ψ y)) j₀ = ψ ((B_bas.repr y) j₀) at this
        rw [h0, map_zero, Finsupp.zero_apply] at this
        exact hψb₀ this.symm
      have hΨxy : Ψ x * Ψ y = 0 := by rw [← map_mul, hxy, map_zero]
      exact mul_ne_zero hΨx hΨy hΨxy
    exact NoZeroDivisors.to_isDomain (TensorProduct Ω C E)

  have hIntDim : ∀ (A D : Type u) [CommRing A] [CommRing D] [Algebra A D]
      [Algebra.IsIntegral A D], Function.Injective (algebraMap A D) →
      ringKrullDim D = ringKrullDim A := by
    intro A D _ _ _ _ hinj
    have hstrict : StrictMono (PrimeSpectrum.comap (algebraMap A D)) := by
      intro Q₁ Q₂ hlt
      have hle : Q₁.asIdeal ≤ Q₂.asIdeal := hlt.le
      obtain ⟨x, hx₂, hx₁⟩ := Set.not_subset.mp hlt.not_ge
      exact Ideal.under_lt_under_of_integral_mem_sdiff hle ⟨hx₂, hx₁⟩
        (Algebra.IsIntegral.isIntegral x)
    have hle₁ : ringKrullDim D ≤ ringKrullDim A :=
      Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A D)) hstrict
    have hlift : ∀ (n : ℕ) (q : LTSeries (PrimeSpectrum A)), q.length = n →
        ∃ p : LTSeries (PrimeSpectrum D), p.length = n ∧
          Ideal.comap (algebraMap A D) (RelSeries.last p).asIdeal = (RelSeries.last q).asIdeal := by
      intro n
      induction n with
      | zero =>
        intro q _
        have hker : Ideal.comap (algebraMap A D) (⊥ : Ideal D) ≤ (RelSeries.last q).asIdeal := by
          intro x hx
          rw [Ideal.mem_comap, Ideal.mem_bot] at hx
          have hx0 : x = 0 := (map_eq_zero_iff (algebraMap A D) hinj).mp hx
          rw [hx0]
          exact Ideal.zero_mem _
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_over⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (RelSeries.last q).asIdeal (⊥ : Ideal D) hker
        refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, ?_⟩
        simpa using hQ₀_over
      | succ m ih =>
        intro q hq
        have hlen_er : q.eraseLast.length = m := by simp [hq]
        have hlt_q : (RelSeries.last q.eraseLast).asIdeal < (RelSeries.last q).asIdeal :=
          RelSeries.eraseLast_last_rel_last q (by omega)
        obtain ⟨p₀, hp₀_len, hp₀_over⟩ := ih q.eraseLast hlen_er
        have hle_over : Ideal.comap (algebraMap A D) (RelSeries.last p₀).asIdeal ≤
            (RelSeries.last q).asIdeal := by
          rw [hp₀_over]
          exact hlt_q.le
        obtain ⟨Q, hQ_ge, hQ_prime, hQ_over⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
            (RelSeries.last q).asIdeal (RelSeries.last p₀).asIdeal hle_over
        have hQ_lt : (RelSeries.last p₀) < (⟨Q, hQ_prime⟩ : PrimeSpectrum D) := by
          change (RelSeries.last p₀).asIdeal < Q
          refine lt_of_le_of_ne hQ_ge ?_
          intro heq
          apply hlt_q.ne
          rw [← hp₀_over, heq]
          exact hQ_over
        refine ⟨p₀.snoc ⟨Q, hQ_prime⟩ hQ_lt, ?_, ?_⟩
        · simp [hp₀_len]
        · simpa using hQ_over
    have hle₂ : ringKrullDim A ≤ ringKrullDim D := by
      change Order.krullDim (PrimeSpectrum A) ≤ Order.krullDim (PrimeSpectrum D)
      rw [Order.krullDim]
      refine iSup_le fun q => ?_
      obtain ⟨p, hp_len, _⟩ := hlift q.length q rfl
      rw [← hp_len]
      exact Order.LTSeries.length_le_krullDim p
    exact le_antisymm hle₁ hle₂

  have hMvDim : ∀ (F : Type u) [Field F] (s : ℕ),
      ringKrullDim (MvPolynomial (Fin s) F) = ((s : ℕ) : WithBot ℕ∞) := by
    intro F _ s
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing,
        ringKrullDim_eq_zero_of_isField (Field.toIsField F),
        ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
    rfl

  have hDimTrdeg : ∀ (F : Type u) [Field F]
      (A : Type u) [CommRing A] [IsDomain A] [Algebra F A] [Algebra.FiniteType F A],
      ∃ s : ℕ, ringKrullDim A = ((s : ℕ) : WithBot ℕ∞) ∧
        Algebra.trdeg F A = (s : Cardinal.{u}) := by
    intro F _ A _ _ _ _
    obtain ⟨s, g₀, hg₀_inj, hg₀_int⟩ := exists_integral_inj_algHom_of_fg F A
    let P₀ := MvPolynomial (Fin s) F
    refine ⟨s, ?_, ?_⟩
    · let : Algebra P₀ A := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ A := ⟨hg₀_int⟩
      rw [hIntDim P₀ A hg₀_inj, hMvDim F s]
    · let : Algebra P₀ A := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ A := ⟨hg₀_int⟩
      have : IsScalarTower F P₀ A := IsScalarTower.of_algebraMap_eq' g₀.comp_algebraMap.symm
      have : FaithfulSMul F P₀ :=
        (faithfulSMul_iff_algebraMap_injective F P₀).mpr (MvPolynomial.C_injective (Fin s) F)
      have : FaithfulSMul P₀ A :=
        (faithfulSMul_iff_algebraMap_injective P₀ A).mpr hg₀_inj
      have : Algebra.IsAlgebraic P₀ A := Algebra.IsIntegral.isAlgebraic
      have htr0 : Algebra.trdeg P₀ A = 0 := trdeg_eq_zero
      have hadd : Algebra.trdeg F P₀ + Algebra.trdeg P₀ A = Algebra.trdeg F A :=
        trdeg_add_eq F P₀ (A := A)
      have htrP : Algebra.trdeg F P₀ = (s : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain]
        simp
      rw [← hadd, htrP, htr0, add_zero]

  have hTensDim : ∀ (F : Type u) [Field F] (E : Type u) [Field E] [Algebra F E]
      (C : Type u) [CommRing C] [IsDomain C] [Algebra F C] [Algebra.FiniteType F C],
      ringKrullDim (TensorProduct F C E) = ringKrullDim C := by
    intro F _ E _ _ C _ _ _ _
    obtain ⟨s, g₀, hg₀_inj, hg₀_int⟩ := exists_integral_inj_algHom_of_fg F C
    let P₀ := MvPolynomial (Fin s) F
    have hDimC : ringKrullDim C = ((s : ℕ) : WithBot ℕ∞) := by
      let : Algebra P₀ C := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ C := ⟨hg₀_int⟩
      rw [hIntDim P₀ C hg₀_inj, hMvDim F s]
    let φ_E : TensorProduct F E P₀ →ₐ[F] TensorProduct F E C :=
      Algebra.TensorProduct.map (AlgHom.id F E) g₀
    have hφ_eq : (⇑φ_E : TensorProduct F E P₀ → TensorProduct F E C) =
        ⇑(LinearMap.lTensor E g₀.toLinearMap) := by
      ext z
      induction z using TensorProduct.inductionOn with
      | tmul e p => simp [φ_E]
      | add x y hx hy => simp [map_add, hx, hy]
    have hφ_inj : Function.Injective φ_E := by
      rw [hφ_eq]
      exact Module.Flat.lTensor_preserves_injective_linearMap g₀.toLinearMap hg₀_inj
    have hφ_int : φ_E.toRingHom.IsIntegral := by
      intro z
      induction z using TensorProduct.inductionOn with
      | tmul e c =>
        have hdecomp : (e ⊗ₜ[F] c : TensorProduct F E C) = (e ⊗ₜ[F] 1) * (1 ⊗ₜ[F] c) := by
          simp [Algebra.TensorProduct.tmul_mul_tmul]
        rw [hdecomp]
        refine RingHom.IsIntegralElem.mul φ_E.toRingHom ?_ ?_
        · have he : (e ⊗ₜ[F] (1 : C)) = φ_E.toRingHom (e ⊗ₜ[F] (1 : P₀)) := by simp [φ_E]
          rw [he]
          exact RingHom.isIntegralElem_map φ_E.toRingHom
        · let j₀ : P₀ →+* TensorProduct F E P₀ :=
            (Algebra.TensorProduct.includeRight (R := F) (A := E) (B := P₀)).toRingHom
          let j₁ : C →+* TensorProduct F E C :=
            (Algebra.TensorProduct.includeRight (R := F) (A := E) (B := C)).toRingHom
          have hcomp : j₁.comp g₀.toRingHom = φ_E.toRingHom.comp j₀ := by
            refine MvPolynomial.ringHom_ext ?_ ?_
            · intro a
              change (1 : E) ⊗ₜ[F] g₀ (MvPolynomial.C a) = φ_E ((1 : E) ⊗ₜ[F] MvPolynomial.C a)
              simp only [φ_E, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
                ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
              rw [g₀.commutes]
            · intro i
              change (1 : E) ⊗ₜ[F] g₀ (MvPolynomial.X i) = φ_E ((1 : E) ⊗ₜ[F] MvPolynomial.X i)
              simp [φ_E]
          have hc1 : (j₁.comp g₀.toRingHom).IsIntegralElem (j₁ c) := (hg₀_int c).map j₁
          rw [hcomp] at hc1
          exact hc1.of_comp
      | add x y hx hy => exact RingHom.IsIntegralElem.add φ_E.toRingHom hx hy
    have hDimEC : ringKrullDim (TensorProduct F E C) = ringKrullDim (TensorProduct F E P₀) := by
      let : Algebra (TensorProduct F E P₀) (TensorProduct F E C) := φ_E.toRingHom.toAlgebra
      have : Algebra.IsIntegral (TensorProduct F E P₀) (TensorProduct F E C) := ⟨hφ_int⟩
      exact hIntDim (TensorProduct F E P₀) (TensorProduct F E C) hφ_inj
    have hComm : ringKrullDim (TensorProduct F C E) = ringKrullDim (TensorProduct F E C) :=
      RingEquiv.ringKrullDim (Algebra.TensorProduct.comm F C E).toRingEquiv
    have hEP : ringKrullDim (TensorProduct F E P₀) = ringKrullDim (MvPolynomial (Fin s) E) :=
      RingEquiv.ringKrullDim
        (MvPolynomial.scalarRTensorAlgEquiv (R := F) (N := E) (σ := Fin s)).toRingEquiv
    rw [hComm, hDimEC, hEP, hMvDim E s, hDimC]

  have hMinPrimeQuot : ∀ (F : Type u) [Field F]
      (C_F : Type u) [CommRing C_F] [IsDomain C_F] [Algebra F C_F] [Algebra.FiniteType F C_F]
      (d k₀ : ℕ), ringKrullDim C_F = ((d : ℕ) : WithBot ℕ∞) →
      ∀ (S : Finset C_F), S.card ≤ k₀ →
      ∀ P ∈ (Ideal.span (S : Set C_F)).minimalPrimes,
        ((d - k₀ : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (C_F ⧸ P) := by
    have hLocDim : ∀ (F : Type u) [Field F]
        (C : Type u) [CommRing C] [IsDomain C] [Algebra F C] [Algebra.FiniteType F C]
        (g : C), g ≠ 0 → ringKrullDim (Localization.Away g) = ringKrullDim C := by
      intro F _ C _ _ _ _ g hg
      have hle : Submonoid.powers g ≤ nonZeroDivisors C :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg)
      let C' := Localization.Away g
      have : IsDomain C' := IsLocalization.isDomain_localization hle
      have : Algebra.FiniteType F C' := Algebra.FiniteType.trans (S := C) inferInstance inferInstance
      obtain ⟨s, hDimC, hTrC⟩ := hDimTrdeg F C
      obtain ⟨s', hDimC', hTrC'⟩ := hDimTrdeg F C'
      have hhinj : Function.Injective (algebraMap C C') := IsLocalization.injective C' hle
      have : FaithfulSMul F C :=
        (faithfulSMul_iff_algebraMap_injective F C).mpr (algebraMap F C).injective
      have : FaithfulSMul C C' := (faithfulSMul_iff_algebraMap_injective C C').mpr hhinj
      have : Algebra.IsAlgebraic C C' := IsLocalization.isAlgebraic C' (Submonoid.powers g)
      have htr0 : Algebra.trdeg C C' = 0 := trdeg_eq_zero
      have hadd : Algebra.trdeg F C + Algebra.trdeg C C' = Algebra.trdeg F C' :=
        trdeg_add_eq F C (A := C')
      have hcast : (s' : Cardinal.{u}) = (s : Cardinal.{u}) := by
        rw [← hTrC', ← hadd, hTrC, htr0, add_zero]
      have hss : s' = s := Nat.cast_injective hcast
      rw [hDimC', hss, hDimC]
    have hMaxHeight : ∀ (F : Type u) [Field F]
        (A : Type u) [CommRing A] [IsDomain A] [Algebra F A] [Algebra.FiniteType F A]
        (d : ℕ), ringKrullDim A = ((d : ℕ) : WithBot ℕ∞) →
        ∀ (M : Ideal A), M.IsMaximal → ((d : ℕ) : ℕ∞) ≤ M.height := by
      intro F _ A _ _ _ _ d hDimA M hM_max
      have : M.IsMaximal := hM_max
      have : M.IsPrime := hM_max.isPrime
      obtain ⟨s, g₀, hg₀_inj, hg₀_int⟩ := exists_integral_inj_algHom_of_fg F A
      let P₀ := MvPolynomial (Fin s) F
      have hs_eq_d : s = d := by
        have hDimA' : ringKrullDim A = ((s : ℕ) : WithBot ℕ∞) := by
          let : Algebra P₀ A := g₀.toRingHom.toAlgebra
          have : Algebra.IsIntegral P₀ A := ⟨hg₀_int⟩
          rw [hIntDim P₀ A hg₀_inj, hMvDim F s]
        have h1 : ((s : ℕ) : WithBot ℕ∞) = ((d : ℕ) : WithBot ℕ∞) := hDimA'.symm.trans hDimA
        exact Nat.cast_injective (WithBot.coe_inj.mp h1)
      subst hs_eq_d
      let m0 : Ideal P₀ := Ideal.comap g₀.toRingHom M
      have hm0_max : m0.IsMaximal := by
        let : Algebra P₀ A := g₀.toRingHom.toAlgebra
        have : Algebra.IsIntegral P₀ A := ⟨hg₀_int⟩
        exact Ideal.IsMaximal.under P₀ M
      let F_bar := AlgebraicClosure F
      let P_bar := MvPolynomial (Fin s) F_bar
      let ι : P₀ →+* P_bar := MvPolynomial.map (algebraMap F F_bar)
      have hι_inj : Function.Injective ι :=
        MvPolynomial.map_injective (algebraMap F F_bar) (algebraMap F F_bar).injective
      have hι_int : ι.IsIntegral := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C α =>
          have hα : (algebraMap F F_bar).IsIntegralElem α :=
            Algebra.IsIntegral.isIntegral (R := F) α
          have hcomp : (MvPolynomial.C : F_bar →+* P_bar).comp (algebraMap F F_bar) =
              ι.comp (MvPolynomial.C : F →+* P₀) := by
            ext x : 1
            dsimp [ι]
            exact (MvPolynomial.map_C (algebraMap F F_bar) x).symm
          have h1 := hα.map (MvPolynomial.C : F_bar →+* P_bar)
          rw [hcomp] at h1
          exact h1.of_comp
        | add p₁ p₂ hp₁ hp₂ => exact RingHom.IsIntegralElem.add ι hp₁ hp₂
        | mul_X p₁ i hp₁ =>
          have hX : ι.IsIntegralElem (MvPolynomial.X i) := by
            have : (MvPolynomial.X i : P_bar) = ι (MvPolynomial.X i) := by
              dsimp [ι]
              exact (MvPolynomial.map_X (algebraMap F F_bar) i).symm
            rw [this]
            exact RingHom.isIntegralElem_map ι
          exact hp₁.mul _ hX
      have hl₀_exists : ∃ l₀ : LTSeries (PrimeSpectrum P₀),
          l₀.length = s ∧ (RelSeries.last l₀).asIdeal = m0 := by
        let : Algebra P₀ P_bar := ι.toAlgebra
        have : Algebra.IsIntegral P₀ P_bar := ⟨hι_int⟩
        have : m0.IsMaximal := hm0_max
        have hker : RingHom.ker (algebraMap P₀ P_bar) ≤ m0 := by
          intro x hx
          rw [RingHom.mem_ker] at hx
          have hx0 : x = 0 := (map_eq_zero_iff ι hι_inj).mp hx
          rw [hx0]
          exact Ideal.zero_mem _
        obtain ⟨m0_tilde, hm0_tilde_max, hm0_tilde_over⟩ :=
          Ideal.exists_ideal_over_maximal_of_isIntegral m0 hker
        obtain ⟨c, hm_eq⟩ :=
          (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := F_bar)).mp hm0_tilde_max
        let σ : Fin (s + 1) → (P_bar →ₐ[F_bar] P_bar) := fun r =>
          MvPolynomial.aeval (fun i : Fin s =>
            if i.1 < r.1 then MvPolynomial.C (c i) else MvPolynomial.X i)
        let q : Fin (s + 1) → PrimeSpectrum P_bar := fun r =>
          ⟨RingHom.ker (σ r).toRingHom, RingHom.ker_isPrime (σ r).toRingHom⟩
        have hq_step : ∀ r : Fin s, q r.castSucc < q r.succ := by
          intro r
          change RingHom.ker (σ r.castSucc).toRingHom < RingHom.ker (σ r.succ).toRingHom
          have hcomp_σ : (σ r.succ).comp (σ r.castSucc) = σ r.succ := by
            apply MvPolynomial.algHom_ext
            intro i
            rw [AlgHom.comp_apply]
            dsimp [σ]
            rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
            split_ifs with h1 h2 h2
            · rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
            · exact absurd (Nat.lt_succ_of_lt h1) h2
            · rw [MvPolynomial.aeval_X]
              simp only [h2, ↓reduceIte]
            · rw [MvPolynomial.aeval_X]
              simp only [h2, ↓reduceIte]
          have hle : RingHom.ker (σ r.castSucc).toRingHom ≤ RingHom.ker (σ r.succ).toRingHom := by
            intro f hf
            rw [RingHom.mem_ker] at hf ⊢
            change (σ r.succ) f = 0
            rw [← hcomp_σ, AlgHom.comp_apply]
            change (σ r.succ) ((σ r.castSucc).toRingHom f) = 0
            rw [hf, map_zero]
          refine lt_of_le_of_ne hle ?_
          intro heq
          let w : P_bar := MvPolynomial.X r - MvPolynomial.C (c r)
          have hw_in : w ∈ RingHom.ker (σ r.succ).toRingHom := by
            rw [RingHom.mem_ker]
            change (σ r.succ) (MvPolynomial.X r - MvPolynomial.C (c r)) = 0
            rw [map_sub]
            dsimp [σ]
            rw [MvPolynomial.aeval_X, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
            split_ifs with hr_c
            · exact sub_self _
            · exact absurd (Nat.lt_succ_self r.1) hr_c
          have hw_in0 : w ∈ RingHom.ker (σ r.castSucc).toRingHom := heq ▸ hw_in
          rw [RingHom.mem_ker] at hw_in0
          change (σ r.castSucc) (MvPolynomial.X r - MvPolynomial.C (c r)) = 0 at hw_in0
          have hw_eq : (σ r.castSucc) (MvPolynomial.X r - MvPolynomial.C (c r)) = w := by
            rw [map_sub]
            dsimp [σ]
            rw [MvPolynomial.aeval_X, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
            split_ifs with hr_c
            · exact absurd hr_c (Nat.lt_irrefl r.1)
            · rfl
          rw [hw_eq] at hw_in0
          have heval := congrArg (MvPolynomial.aeval (Function.update c r (c r + 1))) hw_in0
          simp [w] at heval
        have hq_mono : StrictMono q := Fin.strictMono_iff_lt_succ.mpr hq_step
        have hq_last : (q (Fin.last s)).asIdeal = m0_tilde := by
          ext p
          have hmem1 : p ∈ (q (Fin.last s)).asIdeal ↔ (σ (Fin.last s)) p = 0 := Iff.rfl
          have hmem2 : p ∈ m0_tilde ↔ (MvPolynomial.aeval c) p = 0 := by
