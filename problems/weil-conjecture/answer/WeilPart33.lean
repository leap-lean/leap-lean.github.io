  have hψ_loc_apply : ∀ d : D, ψ_loc (φ_D d) = Ideal.Quotient.mk I_A (algebraMap D A d) := by
    intro d
    have heq : (RingHom.quotientKerEquivOfSurjective hφ_surj).symm (φ_D d) =
        Ideal.Quotient.mk (RingHom.ker φ_D) d :=
      (RingHom.quotientKerEquivOfSurjective hφ_surj).injective (by simp)
    change Ideal.Quotient.lift (RingHom.ker φ_D) η hker_η
      ((RingHom.quotientKerEquivOfSurjective hφ_surj).symm (φ_D d)) = _
    rw [heq]
    rfl
  letI : Algebra D' A_bar := ψ_loc.toAlgebra
  have : IsLocalization q'.primeCompl A_bar := by
    refine ⟨?_, ?_, ?_⟩
    · intro y
      obtain ⟨s, hs_eq⟩ := hφ_surj y.1
      have hs_not : s ∉ q := by
        intro hs_in
