    have hs_qtilde : (1 : P₂) ⊗ₜ[B₂] s_el.1 ∈ q_tilde.primeCompl :=
      IsLocalRing.notMem_maximalIdeal.mpr hu_Rtilde
    exact IsLocalization.map_units L_q ⟨(1 : P₂) ⊗ₜ[B₂] s_el.1, hs_qtilde⟩
  let g_Rloc : R_loc →+* L_q := IsLocalization.lift hgD_units
  have hcomp_eq : Ψ_stalk.comp g_Rloc = ι_R := by
    apply IsLocalization.ringHom_ext q.primeCompl
    ext d
    simp only [RingHom.comp_apply, g_Rloc, Ψ_stalk, IsLocalization.lift_eq, g_D]
    change locMap ((1 : P₂) ⊗ₜ[B₂] d) = ι_R (algebraMap D R_loc d)
    change (Algebra.TensorProduct.includeLeft (R := B₂) (S := B₂) (A := P₂) (B := R_loc) 1) *
      (ι_R (algebraMap D R_loc d)) = _
    rw [map_one, one_mul]
  have hg_inj : Function.Injective g_Rloc := by
    intro r₁ r₂ hr
    apply hιR_inj
    rw [← RingHom.congr_fun hcomp_eq r₁, ← RingHom.congr_fun hcomp_eq r₂]
    exact congrArg Ψ_stalk hr
  exact Function.Injective.isDomain g_Rloc hg_inj⟩

 exact (by
