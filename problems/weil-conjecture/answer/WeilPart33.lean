      (∀ x d₁ d₂, tmul_fn x (d₁ + d₂) = tmul_fn x d₁ + tmul_fn x d₂) →
      (∀ (a : A_node) x d, tmul_fn (ι_node a * x) d = a • tmul_fn x d) →
