        _ = φ_x (ℓ • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id ℱ)) :=
          (map_nsmul φ_x ℓ _).symm
        _ = φ_x (CategoryTheory.Abelian.Ext.mk₀ (ℓ • CategoryTheory.CategoryStruct.id ℱ)) := by
