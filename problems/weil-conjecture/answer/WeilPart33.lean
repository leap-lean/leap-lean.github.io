    have hinc_bar_g : bar_inc bar_g = bar_δslice := by
      dsimp [bar_δslice, bar_g]
      rw [hδ_slice_eq]
      rfl
    have h_unit_ev_slice : IsUnit (((algebraMap Q_G S_G).comp bar_ev) bar_δslice) := by
      change IsUnit (algebraMap Q_G S_G (bar_ev bar_δslice))
      rw [hev_bar_δ]
      exact IsLocalization.Away.algebraMap_isUnit bar_g
    let α_slice : S_slice →+* S_G := IsLocalization.Away.lift bar_δslice h_unit_ev_slice
    have h_unit_inc_slice : IsUnit (((algebraMap Q_slice S_slice).comp bar_inc) bar_g) := by
