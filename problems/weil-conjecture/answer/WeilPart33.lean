        exact RingHom.congr_fun hΨ0_ι (L_tilde r)
      rw [h1, h2, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
    let G_pre : Algebra.Generators R_2 B_pb (Fin n) :=
