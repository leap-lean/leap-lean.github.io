      fun α => AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeft : B α →ₐ[Ω] TensorProduct Ω (B α) S).toRingHom)
    let i_R : ∀ α : Fin (N' + 1 + 1),
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω (B α) S)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of S) :=
      fun α => AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : S →ₐ[Ω] TensorProduct Ω (B α) S).toRingHom)
    have hcomm : ∀ α : Fin (N' + 1 + 1),
