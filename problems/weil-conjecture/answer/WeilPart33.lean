    letI : Algebra k A_Z := (φ.comp MvPolynomial.C).toAlgebra
    have hAlg_VZ : V_Z.toSpecΓ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A_Z)) =
        V_Z.ι ≫ Z_bar.hom := by
      have hk_eq : CommRingCat.ofHom (algebraMap k A_Z) =
          CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom φ := by
        rw [← CommRingCat.ofHom_comp]
      rw [hk_eq, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
      exact hAlgk
    obtain ⟨U_P, hAffUP, V_pb, hAffVpb, hy_Vpb, hVpb_UP, _, e_UP_cat, ℓ_r, π_quot,
        hLw_sum, hSurj_π, hKer_π, hg₂_app, _, hy_ideal⟩ :=
      h_mod3_B w β hwβ y hy_w α₀ V_Z hAffVZ hx_VZ hVZ hAlg_VZ
    have hflift_vec : f_lift = ![f_lift 0] := by
      ext j; fin_cases j; rfl
    have hDet' : IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + 1) =>
        φ (MvPolynomial.pderiv (idx b) (Fin.addCases q ![f_lift 0] a)))) := by
      rwa [← hflift_vec]
    have hLw_hom : (∑ r : Fin 3, MvPolynomial.C (w r) * L r) ∈ 𝒜_M 1 := hSlice.1 0
    have hflift_eq : φ (f_lift 0) = ∑ r : Fin 3, algebraMap k A_Z (w r) * ℓ_r r :=
      (hf_lift 0 hLw_hom).trans (hLw_sum hLw_hom hXα hpos)
    obtain ⟨δ_B, hδ_notMem, hδ_sm⟩ :=
