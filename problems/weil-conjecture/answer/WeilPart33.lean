        exact hcongr_appLE hcomp_πY V_Z _ hVpb_VZ
      exact (congrArg (fun f => f.hom a) happ_eq).symm
    have hy_ideal : ∀ j : Fin 2,
        π_quot (TensorProduct.tmul k 1
          (MvPolynomial.X j - MvPolynomial.C (c_w_fn β w j))) ∈
        (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩).asIdeal := by
      intro j
      let r_j := β.succAbove j
      let H_j : MvPolynomial (Fin 3) k :=
        MvPolynomial.C (w β) * MvPolynomial.X r_j - MvPolynomial.C (w r_j) * MvPolynomial.X β
      have hHj_hom : H_j ∈ 𝒜_2 1 := by
        dsimp [H_j]
        rw [MvPolynomial.C_mul', MvPolynomial.C_mul']
        exact Submodule.sub_mem _
          (Submodule.smul_mem _ _ (MvPolynomial.isHomogeneous_X k r_j))
          (Submodule.smul_mem _ _ hXβ)
      have hHj_eval : MvPolynomial.eval w H_j = 0 := by
        dsimp [H_j]
        simp [mul_comm]
      have hHj_mem : H_j ∈ ProjectiveSpectrum.asHomogeneousIdeal (g₂.left.base y) :=
        (hy_w H_j 1 hHj_hom).mpr hHj_eval
      have hX1 : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ 1 ∈ 𝒜_2 1 :=
        (pow_one (MvPolynomial.X β : MvPolynomial (Fin 3) k)).symm ▸ hXβ
      have hmk_mem := (hProj_mem_asIdeal_iff β hXβ (g₂.left.base y) hy_UP 1 H_j hHj_hom hX1).mpr hHj_mem
      let t_Hj : HomogeneousLocalization.NumDenSameDeg 𝒜_2 (Submonoid.powers (MvPolynomial.X β)) :=
        ⟨1, ⟨H_j, hHj_hom⟩, ⟨MvPolynomial.X β ^ 1, hX1⟩,
          pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) 1⟩
      have hmk_mem' : HomogeneousLocalization.mk t_Hj ∈
          (iso_Specβ.hom.base ⟨g₂.left.base y, hy_UP⟩).asIdeal := hmk_mem
      have hmem_UP : iso_Awayβ.hom.hom (HomogeneousLocalization.mk t_Hj) ∈
          (U_P.toSpecΓ.base ⟨g₂.left.base y, hy_UP⟩).asIdeal := by
        rw [hiso_Specβ] at hmk_mem'
        have hcomp_pt : (U_P.toSpecΓ ≫ AlgebraicGeometry.Spec.map iso_Awayβ.hom).base
            ⟨g₂.left.base y, hy_UP⟩ =
            PrimeSpectrum.comap iso_Awayβ.hom.hom (U_P.toSpecΓ.base ⟨g₂.left.base y, hy_UP⟩) :=
          AlgebraicGeometry.Spec.map_apply iso_Awayβ.hom (U_P.toSpecΓ.base ⟨g₂.left.base y, hy_UP⟩)
        rw [hcomp_pt] at hmk_mem'
        exact hmk_mem'
      have hev_Hj : e_β.symm (HomogeneousLocalization.mk t_Hj) =
          MvPolynomial.C (w β) * (MvPolynomial.X j - MvPolynomial.C (c_w_fn β w j)) := by
        rw [he_β_symm 1 H_j hHj_hom hX1]
        change MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β)
          (MvPolynomial.C (w β) * MvPolynomial.X r_j - MvPolynomial.C (w r_j) * MvPolynomial.X β) = _
        rw [map_sub, map_mul, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', hu_succAbove β j, hu_self β]
        dsimp [c_w_fn, r_j]
        rw [mul_one, mul_sub, ← MvPolynomial.C_mul, mul_comm (w β), inv_mul_cancel_right₀ hwβ]
      have heUP_Hj : iso_Awayβ.hom.hom (HomogeneousLocalization.mk t_Hj) =
          e_UP_cat.hom.hom
            (MvPolynomial.C (w β) * (MvPolynomial.X j - MvPolynomial.C (c_w_fn β w j))) := by
        change iso_Awayβ.hom.hom (HomogeneousLocalization.mk t_Hj) =
          iso_Awayβ.hom.hom (e_β (MvPolynomial.C (w β) *
            (MvPolynomial.X j - MvPolynomial.C (c_w_fn β w j))))
        rw [← hev_Hj, e_β.apply_symm_apply]
      rw [heUP_Hj, map_mul] at hmem_UP
      have hunit_UP : IsUnit (e_UP_cat.hom.hom (MvPolynomial.C (w β))) :=
        IsUnit.map e_UP_cat.hom.hom (IsUnit.map MvPolynomial.C (IsUnit.mk0 (w β) hwβ))
      have hlin_UP : e_UP_cat.hom.hom (MvPolynomial.X j - MvPolynomial.C (c_w_fn β w j)) ∈
          (U_P.toSpecΓ.base ⟨g₂.left.base y, hy_UP⟩).asIdeal := by
        rcases hunit_UP with ⟨u_wb, hu_wb⟩
        have hmul := (U_P.toSpecΓ.base ⟨g₂.left.base y, hy_UP⟩).asIdeal.mul_mem_left (↑u_wb⁻¹) hmem_UP
        rwa [← hu_wb, ← mul_assoc, Units.inv_mul, one_mul] at hmul
      
      have hnat := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE g₂.left U_P V_pb hVpb_UP
      have hpt := congrArg
        (fun h : V_pb.toScheme ⟶ AlgebraicGeometry.Spec
            ((weilProjectiveSpaceOver k 2).left.presheaf.obj (Opposite.op U_P)) =>
          h.base ⟨y, hy_Vpb⟩) hnat
      have hres_pt : (g₂.left.resLE U_P V_pb hVpb_UP).base ⟨y, hy_Vpb⟩ = ⟨g₂.left.base y, hy_UP⟩ := by
        apply Subtype.ext
        exact congrArg (fun h : V_pb.toScheme ⟶ (weilProjectiveSpaceOver k 2).left =>
            h.base ⟨y, hy_Vpb⟩)
          (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι g₂.left hVpb_UP)
      rw [← hg₂_app]
      have hcomap_pt : (PrimeSpectrum.comap (g₂.left.appLE U_P V_pb hVpb_UP).hom
          (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩)).asIdeal =
          (U_P.toSpecΓ.base ⟨g₂.left.base y, hy_UP⟩).asIdeal := by
        rw [← hres_pt]
        have hspec_pt : (V_pb.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            (g₂.left.appLE U_P V_pb hVpb_UP)).base ⟨y, hy_Vpb⟩ =
            PrimeSpectrum.comap (g₂.left.appLE U_P V_pb hVpb_UP).hom
              (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩) :=
          AlgebraicGeometry.Spec.map_apply _ _
        exact congrArg PrimeSpectrum.asIdeal (hspec_pt.symm.trans hpt)
      change e_UP_cat.hom.hom (MvPolynomial.X j - MvPolynomial.C (c_w_fn β w j)) ∈
        (PrimeSpectrum.comap (g₂.left.appLE U_P V_pb hVpb_UP).hom
          (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩)).asIdeal
      rwa [hcomap_pt]
    have hLw_sum : ∀ (hLw : (∑ r : Fin 3, MvPolynomial.C (w r) * L r) ∈ 𝒜_M 1)
        (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
        (hpos : 0 < 1),
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα hpos).hom ≫
          ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀))
            V_Z hVZ).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨∑ r : Fin 3, MvPolynomial.C (w r) * L r, hLw⟩,
              ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) =
        ∑ r : Fin 3, algebraMap k A_Z (w r) * ℓ_r r := by
      intro hLw hXα hpos
      let iso_Awayα : CommRingCat.of (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀)) ≅
          (weilProjectiveSpaceOver k M).left.presheaf.obj (Opposite.op D_α₀) :=
        AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α₀) hXα hpos
      let iso_Specα : D_α₀.toScheme ≅
          AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀))) :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X α₀) hXα hpos
      have hiso_Specα : iso_Specα.hom = D_α₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map iso_Awayα.hom := by
        dsimp [weilProjectiveSpaceOver, D_α₀, iso_Specα, iso_Awayα]
        rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom, AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        rfl
      let ψ_α := (iso_Awayα.hom ≫ ι_bar.left.appLE D_α₀ V_Z hVZ).hom
      have hscalar_α : ∀ c : k,
          ψ_α (HomogeneousLocalization.fromZeroRingHom 𝒜_M
            (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_M 0) c)) =
          algebraMap k A_Z c := by
        have hmor : CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_M
              (Submonoid.powers (MvPolynomial.X α₀))).comp (algebraMap k ↥(𝒜_M 0))) ≫
            iso_Awayα.hom ≫
            ι_bar.left.appLE D_α₀ V_Z hVZ =
            CommRingCat.ofHom (algebraMap k A_Z) := by
          apply AlgebraicGeometry.Spec.map_injective
          apply (CategoryTheory.cancel_epi V_Z.toSpecΓ).mp
          rw [hAlg_VZ]
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]
          rw [CategoryTheory.Category.assoc (ι_bar.left.resLE D_α₀ V_Z hVZ),
            ← hiso_Specα]
          have hDα_hom : iso_Specα.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                ((HomogeneousLocalization.fromZeroRingHom 𝒜_M
                  (Submonoid.powers (MvPolynomial.X α₀))).comp (algebraMap k ↥(𝒜_M 0)))) =
              D_α₀.ι ≫ (weilProjectiveSpaceOver k M).hom := by
            rw [← CategoryTheory.Iso.eq_inv_comp]
            dsimp [weilProjectiveSpaceOver, D_α₀, iso_Specα]
            rw [AlgebraicGeometry.Spec.map_comp,
              ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
              AlgebraicGeometry.Proj.awayι_toSpecZero]
          rw [CategoryTheory.Category.assoc, hDα_hom, ← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.assoc, ι_bar.w]
        intro c
        exact congrArg (fun f => f.hom c) hmor
      have hmk_lin : (HomogeneousLocalization.mk
          ⟨1, ⟨∑ r : Fin 3, MvPolynomial.C (w r) * L r, hLw⟩,
            ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩ :
          HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀)) =
          ∑ r : Fin 3,
            HomogeneousLocalization.fromZeroRingHom 𝒜_M
              (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_M 0) (w r)) *
            HomogeneousLocalization.mk
              ⟨1, ⟨L r, hL_hom r⟩, ⟨MvPolynomial.X α₀, hXα⟩,
                Submonoid.mem_powers (MvPolynomial.X α₀)⟩ := by
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mk]
        let val_M : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α₀) →+*
            Localization (Submonoid.powers (MvPolynomial.X α₀)) :=
          { toFun := HomogeneousLocalization.val
            map_one' := HomogeneousLocalization.val_one
            map_mul' := HomogeneousLocalization.val_mul
            map_zero' := HomogeneousLocalization.val_zero
            map_add' := HomogeneousLocalization.val_add }
        have hterm_M : ∀ r : Fin 3,
            val_M (HomogeneousLocalization.fromZeroRingHom 𝒜_M
              (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_M 0) (w r)) *
              HomogeneousLocalization.mk
                ⟨1, ⟨L r, hL_hom r⟩, ⟨MvPolynomial.X α₀, hXα⟩,
                  Submonoid.mem_powers (MvPolynomial.X α₀)⟩) =
            Localization.mk (MvPolynomial.C (w r) * L r)
              ⟨MvPolynomial.X α₀, Submonoid.mem_powers (MvPolynomial.X α₀)⟩ := by
          intro r
          rw [map_mul]
          change Localization.mk (MvPolynomial.C (w r)) 1 *
            (HomogeneousLocalization.mk _).val = _
          rw [HomogeneousLocalization.val_mk, Localization.mk_mul]
          congr 1
          exact Subtype.ext (one_mul _)
        have hval_sum : (∑ r : Fin 3,
            HomogeneousLocalization.fromZeroRingHom 𝒜_M
              (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_M 0) (w r)) *
            HomogeneousLocalization.mk
              ⟨1, ⟨L r, hL_hom r⟩, ⟨MvPolynomial.X α₀, hXα⟩,
                Submonoid.mem_powers (MvPolynomial.X α₀)⟩).val =
            val_M (∑ r : Fin 3,
              HomogeneousLocalization.fromZeroRingHom 𝒜_M
                (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_M 0) (w r)) *
              HomogeneousLocalization.mk
                ⟨1, ⟨L r, hL_hom r⟩, ⟨MvPolynomial.X α₀, hXα⟩,
                  Submonoid.mem_powers (MvPolynomial.X α₀)⟩) := rfl
        rw [hval_sum, map_sum]
        simp_rw [hterm_M, Fin.sum_univ_three, Localization.add_mk_self]
      change ψ_α _ = _
      rw [hmk_lin, map_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_mul, hscalar_α (w r)]
    exact ⟨U_P, hAffUP, V_pb, hAffVpb, hy_Vpb, hVpb_UP, hVpb_VZ, e_UP_cat, ℓ_r, π_quot,
      hLw_sum, hSurj_π, hKer_π, hg₂_app, hπY_app, hy_ideal⟩

  
  have h_mod3_A : ∀ (w : Fin 3 → k) (β : Fin 3), w β ≠ 0 → ∀ (y : Y₂.left),
      (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ), F ∈ 𝒜_2 d →
        (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (g₂.left.base y) ↔
          MvPolynomial.eval w F = 0)) →
      ι_bar.left.base (π_Y.left.base y) ∈
        weilProjHyperplaneSet k M (∑ r : Fin 3, MvPolynomial.C (w r) * L r) := by
    intro w β hwβ y hy_w
    let x := π_Y.left.base y
    obtain ⟨α₀, hx_α⟩ := hProj_cover M (ι_bar.left.base x)
    let D_α : (weilProjectiveSpaceOver k M).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α₀)
    obtain ⟨V_Z_aff : Z_bar.left.Opens, hAffVZ, hx_VZ, hVZ⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z_bar.left.isBasis_affineOpens
        (show x ∈ (TopologicalSpace.Opens.map ι_bar.left.base).obj D_α from hx_α)
    let A_Z := ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z_aff))
    haveI : CategoryTheory.IsIso V_Z_aff.toSpecΓ := by
      rw [← hAffVZ.isoSpec_hom]; infer_instance
    let k_to_AZ : CommRingCat.of k ⟶ Z_bar.left.presheaf.obj (Opposite.op V_Z_aff) :=
      AlgebraicGeometry.Spec.preimage (CategoryTheory.inv V_Z_aff.toSpecΓ ≫ V_Z_aff.ι ≫ Z_bar.hom)
    letI : Algebra k A_Z := k_to_AZ.hom.toAlgebra
    have hAlg_VZ : V_Z_aff.toSpecΓ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A_Z)) =
        V_Z_aff.ι ≫ Z_bar.hom := by
      have hk_eq : CommRingCat.ofHom (algebraMap k A_Z) = k_to_AZ := rfl
      rw [hk_eq]
      dsimp [k_to_AZ]
      rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.hom_inv_id_assoc]
    obtain ⟨U_P, _, V_pb, _, hy_Vpb, _, hVpb_VZ, _, ℓ_r, π_quot,
        hLw_sum, _, hKer_π, _, hπY_app, hy_ideal⟩ :=
      h_mod3_B w β hwβ y hy_w α₀ V_Z_aff hAffVZ hx_VZ hVZ hAlg_VZ
    let 𝔭_y := (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩).asIdeal
    have hsum_zero : π_quot (∑ r : Fin 3, TensorProduct.tmul k (ℓ_r r) (u_coord β r)) = 0 := by
      rw [← RingHom.mem_ker, hKer_π]
      exact Ideal.subset_span (Set.mem_singleton _)
    have hu_diff_mem : ∀ r : Fin 3,
        π_quot (TensorProduct.tmul k 1
          (u_coord β r - MvPolynomial.C (w r * (w β)⁻¹))) ∈ 𝔭_y := by
      intro r
      by_cases hr : r = β
      · subst hr
        rw [hu_self r, mul_inv_cancel₀ hwβ, map_one, sub_self, TensorProduct.tmul_zero, map_zero]
        exact 𝔭_y.zero_mem
      · have hex : ∃ j : Fin 2, β.succAbove j = r := by
          fin_cases β <;> fin_cases r <;> simp at hr ⊢
        rcases hex with ⟨j, rfl⟩
        rw [hu_succAbove β j]
        exact hy_ideal j
    have hsum_cw_mem : π_quot (∑ r : Fin 3,
        TensorProduct.tmul k (ℓ_r r) (MvPolynomial.C (w r * (w β)⁻¹))) ∈ 𝔭_y := by
      have hdiff : π_quot (∑ r : Fin 3, TensorProduct.tmul k (ℓ_r r) (u_coord β r)) -
          π_quot (∑ r : Fin 3,
            TensorProduct.tmul k (ℓ_r r) (MvPolynomial.C (w r * (w β)⁻¹))) ∈ 𝔭_y := by
        rw [← map_sub, ← Finset.sum_sub_distrib, map_sum]
        refine Ideal.sum_mem 𝔭_y fun r _ => ?_
        have htmul_sub : TensorProduct.tmul k (ℓ_r r) (u_coord β r) -
            TensorProduct.tmul k (ℓ_r r) (MvPolynomial.C (w r * (w β)⁻¹)) =
            TensorProduct.tmul k (ℓ_r r) 1 *
              TensorProduct.tmul k 1 (u_coord β r - MvPolynomial.C (w r * (w β)⁻¹)) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, TensorProduct.tmul_sub]
        rw [htmul_sub, map_mul]
        exact 𝔭_y.mul_mem_left _ (hu_diff_mem r)
      rw [hsum_zero, zero_sub] at hdiff
      exact 𝔭_y.neg_mem_iff.mp hdiff
    have hLw_AZ_mem : π_quot (TensorProduct.tmul k
        (∑ r : Fin 3, algebraMap k A_Z (w r) * ℓ_r r) 1) ∈ 𝔭_y := by
      have hmul := 𝔭_y.mul_mem_left
        (π_quot (TensorProduct.tmul k (algebraMap k A_Z (w β)) 1)) hsum_cw_mem
      rw [← map_mul, Finset.mul_sum] at hmul
      have hsum_eq : (∑ r : Fin 3,
          TensorProduct.tmul k (algebraMap k A_Z (w β)) (1 : R_2) *
            TensorProduct.tmul k (ℓ_r r) (MvPolynomial.C (w r * (w β)⁻¹))) =
          TensorProduct.tmul k (∑ r : Fin 3, algebraMap k A_Z (w r) * ℓ_r r) 1 := by
        rw [TensorProduct.sum_tmul]
        refine Finset.sum_congr rfl fun r _ => ?_
        have hC_smul : (MvPolynomial.C (w r * (w β)⁻¹) : R_2) = (w r * (w β)⁻¹) • (1 : R_2) := by
          rw [Algebra.smul_def, mul_one]; rfl
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hC_smul, ← TensorProduct.smul_tmul,
          Algebra.smul_def]
        congr 1
        rw [← mul_assoc, ← map_mul, mul_assoc (w r), inv_mul_cancel₀ hwβ, mul_one]
      rwa [hsum_eq] at hmul
    rw [← hπY_app] at hLw_AZ_mem
    
    have hnat_πY := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE π_Y.left V_Z_aff V_pb hVpb_VZ
    have hpt_πY := congrArg
      (fun h : V_pb.toScheme ⟶ AlgebraicGeometry.Spec (Z_bar.left.presheaf.obj (Opposite.op V_Z_aff)) =>
        h.base ⟨y, hy_Vpb⟩) hnat_πY
    have hres_πY : (π_Y.left.resLE V_Z_aff V_pb hVpb_VZ).base ⟨y, hy_Vpb⟩ = ⟨x, hx_VZ⟩ := by
      apply Subtype.ext
      exact congrArg (fun h : V_pb.toScheme ⟶ Z_bar.left => h.base ⟨y, hy_Vpb⟩)
        (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι π_Y.left hVpb_VZ)
    have hmem_VZ : (∑ r : Fin 3, algebraMap k A_Z (w r) * ℓ_r r) ∈
        (V_Z_aff.toSpecΓ.base ⟨x, hx_VZ⟩).asIdeal := by
      have hcomap_πY : (PrimeSpectrum.comap (π_Y.left.appLE V_Z_aff V_pb hVpb_VZ).hom
          (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩)).asIdeal =
          (V_Z_aff.toSpecΓ.base ⟨x, hx_VZ⟩).asIdeal := by
        rw [← hres_πY]
        have hspec_πY : (V_pb.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            (π_Y.left.appLE V_Z_aff V_pb hVpb_VZ)).base ⟨y, hy_Vpb⟩ =
            PrimeSpectrum.comap (π_Y.left.appLE V_Z_aff V_pb hVpb_VZ).hom
              (V_pb.toSpecΓ.base ⟨y, hy_Vpb⟩) :=
          AlgebraicGeometry.Spec.map_apply _ _
        exact congrArg PrimeSpectrum.asIdeal (hspec_πY.symm.trans hpt_πY)
      rw [← hcomap_πY]
      exact hLw_AZ_mem
    let L_w := ∑ r : Fin 3, MvPolynomial.C (w r) * L r
