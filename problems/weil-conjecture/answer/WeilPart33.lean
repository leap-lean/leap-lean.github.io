            rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w g_bar]
        _ = (q_k α ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Qk) ≫ e_Bk α) ≫ B_bar.hom := by
