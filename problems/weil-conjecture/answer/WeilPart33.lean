    refine ⟨hAff_A₁, hLFT_A₁, hQC_A₁, hSep_A₁, hIso_iY₀, hIntY₀, ?_, ?_⟩
    · intro U₂ ⟨u₂⟩
      have hCl_bad : IsClosed (⇑iY₀.base '' ((U₂ : Set ↥Y₀)ᶜ)) :=
        iY₀.isClosedEmbedding.isClosedMap _ U₂.isOpen.isClosed_compl
      let C_bad : TopologicalSpace.Closeds ↥A₁.left := ⟨⇑iY₀.base '' ((U₂ : Set ↥Y₀)ᶜ), hCl_bad⟩
      have hNe_bad : (C_bad : Set ↥A₁.left) ≠ Set.univ := by
