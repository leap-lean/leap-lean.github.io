    have hchart_mem_iff : ∀ (p : (weilProjectiveSpaceOver k 2).left) (hp : p ∈ U_β)
        (d : ℕ) (F : MvPolynomial (Fin 3) k) (hF : F ∈ 𝒜_2 d),
        MvPolynomial.eval₂Hom MvPolynomial.C (u_coord β) F ∈
          (φ_chart.hom.base ⟨p, hp⟩).asIdeal ↔
        F ∈ ProjectiveSpectrum.asHomogeneousIdeal p := by
      intro p hp d F hF
      have hXd : (MvPolynomial.X β : MvPolynomial (Fin 3) k) ^ d ∈ 𝒜_2 d :=
        (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow β d)
      rw [← he_symm_mk d F hF hXd]
