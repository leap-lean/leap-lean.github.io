theorem weil_veronese_lefschetz_pencil_existence (K : Type u) [Finite K] [Field K]
    (m : ℕ)
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z.hom]
    (hProjZ : ∃ (N : ℕ) (ι : Z ⟶ weilProjectiveSpaceOver K N),
      AlgebraicGeometry.IsClosedImmersion ι.left) :
    ∃ (K₁ : Type u) (_ : Finite K₁) (_ : Field K₁) (_ : Algebra K K₁)
      (_ : FiniteDimensional K K₁),
      Nonempty (WeilRationalLefschetzPencil K₁ m (weilBaseChangeOver K K₁ Z)) :=
by
  let k := AlgebraicClosure K
  let Z_bar := weilBaseChangeOver K k Z
  obtain ⟨hIntZ, hPropZ, hSmZ⟩ :=
    weil_smooth_algClosure_baseChange_integral K Z (2 * m + 2)
  have : AlgebraicGeometry.IsProper Z_bar.hom := hPropZ
  have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom := hSmZ
  have hProjZ_bar : IsProjectiveOverField k Z_bar :=
    weil_isProjectiveOverField_baseChange K k Z hProjZ
  obtain ⟨M, ι_bar, hVer⟩ :=
    weil_algClosed_cubic_veronese_embedding_and_irred k m Z_bar hIntZ hProjZ_bar
  obtain ⟨D_net⟩ :=
    weil_algClosed_dual_variety_net_and_pencil_line k m M Z_bar hIntZ ι_bar hVer
  obtain ⟨I_inc⟩ :=
    weil_algClosed_incidence_blowup_and_hyperplane_slice k m M Z_bar hIntZ ι_bar
      hVer.1 hVer.2.1 hVer.2.2.1
      D_net.L D_net.j_aff D_net.s_inf D_net.ι_line D_net.u_val
      D_net.hCoord_line D_net.hLine_plane D_net.hL_homog D_net.hL_linIndep
      D_net.hTrans_axis D_net.hNet_m0 D_net.hNet_pos D_net.hTrans_u₀
  obtain ⟨P_bar⟩ :=
    weil_algClosed_etale_split_odp_and_fiber_irred k m M Z_bar hIntZ ι_bar hVer D_net I_inc
  exact weil_descent_lefschetz_pencil_from_algClosure K m Z P_bar

theorem weil_wl_closed_compl_zero_bdry_lift (hModInj : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
      (θ : weilCupPDModH W m j →+ weilEtaleTorsionH W m j),
      WeilCupPDIsModComparison W m j θ → Function.Injective θ)
    (hModEx : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m j : ℕ),
