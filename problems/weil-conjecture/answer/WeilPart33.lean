  refine ⟨c, hc_le, ψ, K_sep, hField_Ksep, hAlg_Ksep, hPure_Ksep, φ_sep,
    ℐ, hSmall_ℐ, hFilt_ℐ, D, α_D, colim_c, hColim_c, e_pt,
    hDim_y, hcomp_φsep, hEt_α, hcomp_α, ?_, ?_⟩

  
  · intro hcm C₀ B_κ _ _ f_C₀ j_κ ι_C₀ hf_et hPush
    have hψ_bij : Function.Bijective ψ := hBij_cm hcm
    let e_ψ : P_c ≃+* P_m := RingEquiv.ofBijective ψ.toRingHom hψ_bij
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom ψ.toRingHom) :=
      ⟨⟨CommRingCat.ofHom e_ψ.symm.toRingHom,
        CommRingCat.hom_ext (RingHom.ext e_ψ.left_inv),
        CommRingCat.hom_ext (RingHom.ext e_ψ.right_inv)⟩⟩
    have hfψ_et : (f_C₀.comp ψ.toRingHom).Etale := by
      have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      have hf_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_C₀)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf_et
      have hψ_sch : AlgebraicGeometry.Etale
