    (CategoryTheory.Category.id_comp π_Csep)
  let η := e_id.symm ξ_Csep
  have hVan_Φ : WeilEtaleTrianglePullbackMapsTo
      Φ_r (CategoryTheory.CategoryStruct.id Z_Csep) Φ_r
      (CategoryTheory.Category.comp_id Φ_r) 𝒢_Csep b η 0 := by
    apply (hreb Φ_r (CategoryTheory.CategoryStruct.id Z_Csep) π_comp π_Csep
      rfl (CategoryTheory.Category.id_comp π_Csep) Φ_r
      (CategoryTheory.Category.comp_id Φ_r) rfl η 0).mpr
    change WeilEtaleTrianglePullbackMapsTo π_comp π_Csep Φ_r rfl 𝒢_sep b
      (e_id η) ((reb Φ_r π_comp rfl) 0)
    rw [e_id.apply_symm_apply, map_zero]
    exact hMap_Φ
  have hη0 : η = 0 :=
    @hPartD (Polynomial C'_sep) _ (ringExpChar K_sep) hExpPoly r 𝒢_Csep η hVan_Φ
  have hξ_Csep0 : ξ_Csep = 0 := by
    have h1 : e_id η = ξ_Csep := e_id.apply_symm_apply ξ_Csep
    rw [← h1, hη0, map_zero]
  rw [hξ_Csep0] at hMap_Csep
  exact ⟨C'_sep, inferInstance, g_sep, u'_sep, hg_sep, hu'_sep, hMap_Csep⟩

theorem weil_aff_cd_filtered_etale_tensor_poly_descent (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
