              map_mul' := HomogeneousLocalization.val_mul
              map_zero' := HomogeneousLocalization.val_zero
              map_add' := HomogeneousLocalization.val_add }
          change valHom (HomogeneousLocalization.Away.mk 𝒜_2 hXβ n F hF) = valHom _
          rw [show valHom (HomogeneousLocalization.Away.mk 𝒜_2 hXβ n F hF) = Localization.mk F (y₁ ^ n)
            from hval_lhs]
          conv_lhs => rw [F.as_sum]
