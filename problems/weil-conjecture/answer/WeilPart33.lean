        (Algebra.TensorProduct.includeLeftRingHom (R := B₂) (A := P₂) (B := R_loc))) =
        (Ideal.Quotient.mk M).comp (ι_R.comp c_map) := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, c_map, MvPolynomial.constantCoeff_C]
        have hc : (MvPolynomial.C c : P₂) = φ_cone (mk_B2 (MvPolynomial.C c)) :=
          (hφ_C c).symm
        change Ideal.Quotient.mk M ((MvPolynomial.C c : P₂) ⊗ₜ[B₂] (1 : R_loc)) =
          Ideal.Quotient.mk M ((1 : P₂) ⊗ₜ[B₂] (algebraMap B₂ R_loc (mk_B2 (MvPolynomial.C c))))
        rw [hc, htmul_alg]
      · intro j
        fin_cases j
        · simp only [RingHom.comp_apply, c_map, MvPolynomial.constantCoeff_X, map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hs_in_M
        · simp only [RingHom.comp_apply, c_map, MvPolynomial.constantCoeff_X, map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr ht_in_M
    have hw_rep : ∀ w : R_tilde, ∃ r_w : R_loc,
        Ideal.Quotient.mk M w = Ideal.Quotient.mk M (ι_R r_w) ∧ ε w = π_κ r_w := by
      intro w
      refine TensorProduct.induction_on
        (motive := fun w => ∃ r_w : R_loc,
          Ideal.Quotient.mk M w = Ideal.Quotient.mk M (ι_R r_w) ∧ ε w = π_κ r_w)
        w ?_ (fun p r => ?_) (fun w₁ w₂ ih₁ ih₂ => ?_)
      · exact ⟨0, by simp, by simp⟩
      · refine ⟨c_map p * r, ?_, ?_⟩
        · have hpM := RingHom.congr_fun hP2_mod_M p
          simp only [RingHom.comp_apply] at hpM
          have hmul : p ⊗ₜ[B₂] r =
              (Algebra.TensorProduct.includeLeftRingHom p) * (ι_R r) := by
            change p ⊗ₜ[B₂] r = (p ⊗ₜ[B₂] (1 : R_loc)) * ((1 : P₂) ⊗ₜ[B₂] r)
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hmul, map_mul, hpM, ← map_mul, ← map_mul]
        · change ε_P2_ring p * π_κ r = π_κ (c_map p * r)
          rw [map_mul]
          rfl
      · obtain ⟨r₁, hM₁, hε₁⟩ := ih₁
        obtain ⟨r₂, hM₂, hε₂⟩ := ih₂
        exact ⟨r₁ + r₂, by rw [map_add, hM₁, hM₂, map_add, map_add],
          by rw [map_add, hε₁, hε₂, map_add]⟩
    have hI₀_le_M : I₀ ≤ M := by
      intro w hw
      obtain ⟨r_w, hM_w, hε_w⟩ := hw_rep w
      have hr_mem : r_w ∈ m_loc := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change π_κ r_w = 0
        rw [← hε_w]
        exact hw
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [hM_w]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hmloc_in_M r_w hr_mem)
    exact (hI₀_max.eq_of_le hM.ne_top hI₀_le_M).symm
  let D_tilde : Type u := TensorProduct B₂ P₂ D
  have : Algebra.Etale P₂ D_tilde := Algebra.Etale.baseChange B₂ D P₂
  let locMap : D_tilde →+* R_tilde :=
    (Algebra.TensorProduct.productMap
      (Algebra.TensorProduct.includeLeft (R := B₂) (S := B₂) (A := P₂) (B := R_loc))
      ((Algebra.TensorProduct.includeRight (R := B₂) (A := P₂) (B := R_loc)).comp
        (IsScalarTower.toAlgHom B₂ D R_loc))).toRingHom
  let m_Rtilde : Ideal R_tilde := IsLocalRing.maximalIdeal R_tilde
  let q_tilde : Ideal D_tilde := Ideal.comap locMap m_Rtilde
  have : q_tilde.IsPrime := Ideal.IsPrime.comap locMap
  let L_q : Type u := Localization.AtPrime q_tilde
  have : IsDomain L_q := hEt_pkg.2 2 k D_tilde q_tilde
  have hloc_units : ∀ y : q_tilde.primeCompl, IsUnit (locMap y.1) := by
    intro y
    exact IsLocalRing.notMem_maximalIdeal.mp y.2
