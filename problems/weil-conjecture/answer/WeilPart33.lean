    have h1 : (t ⊗ₜ[B₂] (1 : R_loc)) ^ 2 = (t ^ 2) ⊗ₜ[B₂] (1 : R_loc) := by
      rw [pow_two (t ⊗ₜ[B₂] (1 : R_loc)), Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← pow_two t]
    have h2 : t ^ 2 = φ_cone (mk_B2 (MvPolynomial.X 1)) := (hφ_X 1).symm
    rw [h1, h2, htmul_alg]
