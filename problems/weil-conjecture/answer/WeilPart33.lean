          (AlgebraicGeometry.pullbackSpecIso R C (Polynomial R)).symm
    have h_fst : ∀ (C : Type u) [CommRing C] (f : R →+* C) (hf : f.Etale),
        CategoryTheory.CategoryStruct.comp (iso_Z C f hf).hom
          (CategoryTheory.Limits.pullback.fst (U_of R C f hf).hom p) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : C →+* Polynomial C)) := by
      intro C _ f hf
