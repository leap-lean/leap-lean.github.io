    have hLa_homog : ∀ a : k, D_net.L 0 + MvPolynomial.C a * D_net.L 1 ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 1 := by
      intro a
      rw [MvPolynomial.C_mul']
      exact Submodule.add_mem _ (D_net.hL_homog 0) (Submodule.smul_mem _ a (D_net.hL_homog 1))
    have hLa_ne : ∀ a : k, D_net.L 0 + MvPolynomial.C a * D_net.L 1 ≠ 0 := by
      intro a
      have hc : (![(1 : k), a, 0] : Fin 3 → k) ≠ 0 := by
        intro h0
        have : (![(1 : k), a, 0] : Fin 3 → k) 0 = 0 := congrFun h0 0
        exact one_ne_zero this
      have hsum := D_net.hL_linIndep ![(1 : k), a, 0] hc
      simpa [Fin.sum_univ_three] using hsum
    have hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left),
        IrreducibleSpace ↥(CategoryTheory.Limits.pullback I_inc.f₀.left s) := by
      obtain ⟨x_inf, hx_inf_f₀, hSm_compl_inf, hOdp_inf⟩ := hRoof_inf.2.1
      refine hIrredPkg.2 D_net.j_aff D_net.s_inf S_aff U₀ D_net.hCoord_line hU₀_eq hSm_f₀_U₀
        ⟨D_net.L 1, x_inf, D_net.hL_homog 1, hL1_ne, hx_inf_f₀, hSm_compl_inf,
          hOdp_inf, hRoof_inf.2.2⟩
        (fun a ha => ?_)
      obtain ⟨x_a, hx_a_f₀, hSm_compl_a, hOdp_a⟩ := (hRoof_aff a ha).2.1
      exact ⟨D_net.L 0 + MvPolynomial.C a * D_net.L 1, x_a, hLa_homog a, hLa_ne a,
        hx_a_f₀, hSm_compl_a, hOdp_a, (hRoof_aff a ha).2.2⟩
    have hCov_2d_ex : ∀ c ∈ U_disc_reg, ∃ y_c : I_inc.Y₂.left,
        I_inc.g₂.left.base y_c = ι_disc.left.base c ∧
        (∀ y' : I_inc.Y₂.left, I_inc.g₂.left.base y' = ι_disc.left.base c → y' ≠ y_c →
          ∃ V : I_inc.Y₂.left.Opens, y' ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ I_inc.g₂.left)) ∧
        ∃ (R' : CommRingCat.{u}) (u_pt : AlgebraicGeometry.Spec R')
          (e_B : AlgebraicGeometry.Spec R' ⟶ (weilProjectiveSpaceOver k 2).left)
          (h : R') (V' : AlgebraicGeometry.Scheme.{u}) (v_pt : V') (e_Y : V' ⟶ I_inc.Y₂.left)
          (q : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin (m + 1) × Fin 2) R' ⧸ Ideal.span
              {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
                MvPolynomial.C h}))),
          AlgebraicGeometry.Etale e_B ∧
          AlgebraicGeometry.Etale e_Y ∧
          AlgebraicGeometry.Etale q ∧
          e_B.base u_pt = ι_disc.left.base c ∧
          e_Y.base v_pt = y_c ∧
          (∃ ψ_B : MvPolynomial (Fin 2) k →+* R',
            ψ_B (MvPolynomial.X 0) = h ∧
            AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) ∧
            e_B ≫ (weilProjectiveSpaceOver k 2).hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
          e_B.base ⁻¹' (Set.range ι_disc.left.base) =
            { u : AlgebraicGeometry.Spec R' | h ∈ u.asIdeal } ∧
          (∀ idx : Fin (m + 1) × Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q.base v_pt).asIdeal) ∧
          Ideal.Quotient.mk _ (MvPolynomial.C h) ∈ (q.base v_pt).asIdeal ∧
          e_Y ≫ I_inc.g₂.left =
            q ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_B := by
      intro c hc
      obtain ⟨y_c, hy_c_eq, hy_c_sm, α, u_pt, v_pt, hu_pt, hv_pt, hX_pt, hC_pt⟩ := hCov_2d c hc
      obtain ⟨he_B_et, he_Y_et, hq_et, hψ_X0, hψ_et, he_B_hom, hPreim_h, hComm_2d⟩ := hCharts_2d α
      refine ⟨y_c, hy_c_eq, hy_c_sm, R'_2d α, u_pt, e_B2d α, h_2d α,
        AlgebraicGeometry.Spec (B'_2d α), v_pt, e_Y2d α, q_2d α, ?_⟩
      exact ⟨he_B_et, he_Y_et, hq_et, hu_pt, hv_pt,
        ⟨ψ_B2d α, hψ_X0, hψ_et, he_B_hom⟩, hPreim_h, hX_pt, hC_pt, hComm_2d⟩
    let P_rat : WeilRationalLefschetzPencil k m Z_bar := {
      B₀ := I_inc.B₀
      hProp_B₀ := I_inc.hProp_B₀
      hSm_B₀ := I_inc.hSm_B₀
      ι_B := I_inc.ι_B
      hCl_B := I_inc.hCl_B
      U_axis := I_inc.U_axis
      hU_axis_eq := I_inc.hU_axis_eq
      hU_axis_ne := I_inc.hU_axis_ne
      Z_tilde := I_inc.Z_tilde
      hGeom_Ztilde := I_inc.hGeom_Ztilde
      hProp_Ztilde := I_inc.hProp_Ztilde
      hSm_Ztilde := I_inc.hSm_Ztilde
      hProj_Ztilde := I_inc.hProj_Ztilde
      π₀ := I_inc.π₀
      hProp_π₀ := I_inc.hProp_π₀
      hSurj_π₀ := I_inc.hSurj_π₀
      hIso_π₀ := I_inc.hIso_π₀
      f₀ := I_inc.f₀
      hFlat_f₀ := I_inc.hFlat_f₀
      hProp_f₀ := I_inc.hProp_f₀
      hSurj_f₀ := I_inc.hSurj_f₀
      hFibIrred_f₀ := hFibIrred
      Y₂ := I_inc.Y₂
      hGeom_Y₂ := I_inc.hGeom_Y₂
      hProp_Y₂ := I_inc.hProp_Y₂
      hSm_Y₂ := I_inc.hSm_Y₂
      g₂ := I_inc.g₂
      hFlat_g₂ := I_inc.hFlat_g₂
      hProp_g₂ := I_inc.hProp_g₂
      ι_line := D_net.ι_line
      hCl_line := D_net.hLine_plane.1
      ι_Ytilde := I_inc.ι_Ytilde
      hPb_line := I_inc.hPb_line
      u₀ := u₀
      hu₀_sec := hu₀_sec
      Z_u₀ := I_inc.Z_u₀
      hGeom_Zu₀ := I_inc.hGeom_Zu₀
      hProp_Zu₀ := I_inc.hProp_Zu₀
      hSm_Zu₀ := I_inc.hSm_Zu₀
      hProj_Zu₀ := I_inc.hProj_Zu₀
      ι_Zu₀ := I_inc.ι_Zu₀
      hPb_Zu₀ := I_inc.hPb_Zu₀
      H₀ := I_inc.H₀
      hGeom_H₀ := I_inc.hGeom_H₀
      hProp_H₀ := I_inc.hProp_H₀
      hSm_H₀ := I_inc.hSm_H₀
      hProj_H₀ := I_inc.hProj_H₀
      i_H := I_inc.i_H
      hCl_H := I_inc.hCl_H
      hAff_compl_H := I_inc.hAff_compl_H
      hSing_dichotomy := by
        right
        refine ⟨D_net.j_aff, D_net.s_inf, S_aff, U₀, C_disc, ι_disc, U_disc_reg, ?_⟩
        refine ⟨D_net.hCoord_line.1, D_net.hCoord_line.2.1, D_net.hCoord_line.2.2.1,
          D_net.hCoord_line.2.2.2.2.1, hU₀_eq, hu₀_in_U₀, hSm_f₀_U₀,
          hGeom_disc, hProp_disc, hCl_disc, hUdisc_ne, hSm_Udisc,
          ⟨U₂_sm, hU₂_sm_eq, hSm_g₂_U₂⟩, hPreim_disc, hImg_line, ?_⟩
        exact ⟨hRoof_inf.2.1, fun a ha => (hRoof_aff a ha).2.1, hCov_2d_ex⟩ }
    refine ⟨{
      toPencil := P_rat
      hProj_B₀ := I_inc.hProj_B₀
      hProj_Y₂ := I_inc.hProj_Y₂
      hInt_Ztilde := I_inc.hInt_Ztilde
      hInt_Y₂ := I_inc.hInt_Y₂
      hInt_Zu₀ := I_inc.hInt_Zu₀
      hInt_H₀ := I_inc.hInt_H₀
      hSing_proj_atlas := by
        right
        refine ⟨D_net.j_aff, D_net.s_inf, S_aff, U₀, C_disc, ι_disc, U_disc_reg,
          r_chart, R'_2d, B'_2d, e_B2d, h_2d, ψ_B2d, e_Y2d, q_2d, ?_⟩
        refine ⟨D_net.hCoord_line.1, D_net.hCoord_line.2.1, D_net.hCoord_line.2.2.1,
          D_net.hCoord_line.2.2.2.2.1, hU₀_eq, hu₀_in_U₀, hSm_f₀_U₀,
          hInt_disc, hGeom_disc, hProp_disc, hCl_disc, hUdisc_ne, hSm_Udisc,
          ⟨U₂_sm, hU₂_sm_eq, hSm_g₂_U₂⟩, hPreim_disc, hImg_line, ?_⟩
        exact ⟨hRoof_inf.1, fun a ha => (hRoof_aff a ha).1, hCharts_2d, hCov_2d⟩ }⟩

theorem weil_canonical_and_projective_baseChange_models : (∀ (E : Type u) [Field E]
        (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E))),
      IsProjectiveOverField E V → AlgebraicGeometry.IsProper V.hom) ∧
    (∀ (E : Type u) [Field E],
      CompactSpace ↥(weilPolyLineSpecOver E).left ∧
      AlgebraicGeometry.IsSeparated (weilPolyLineSpecOver E).hom ∧
      AlgebraicGeometry.LocallyOfFiniteType (weilPolyLineSpecOver E).hom) ∧
    (∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
      IsFieldPullbackModel E₀ E₁ (weilPolyLineSpecOver E₀) (weilPolyLineSpecOver E₁)
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap E₀ E₁))))) ∧
    (∀ (N : ℕ),
      ∃ π_P : ∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
          (weilProjectiveSpaceOver E₁ N).left ⟶ (weilProjectiveSpaceOver E₀ N).left,
        (∀ (E : Type u) [Field E], IsProjectiveOverField E (weilProjectiveSpaceOver E N)) ∧
        (∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
          IsFieldPullbackModel E₀ E₁ (weilProjectiveSpaceOver E₀ N)
            (weilProjectiveSpaceOver E₁ N) (π_P E₀ E₁)) ∧
        (∀ (E₀ E₁ E₂ : Type u) [Field E₀] [Field E₁] [Field E₂]
            [Algebra E₀ E₁] [Algebra E₁ E₂] [Algebra E₀ E₂] [IsScalarTower E₀ E₁ E₂],
          π_P E₁ E₂ ≫ π_P E₀ E₁ = π_P E₀ E₂)) :=
by
  classical
  have hProjProper : ∀ (E : Type u) [Field E]
      (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E))),
      IsProjectiveOverField E V → AlgebraicGeometry.IsProper V.hom := by
    intro E _ V ⟨N, ι, hClosed⟩
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower E ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) E) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E) :=
      Algebra.FiniteType.of_restrictScalars_finiteType E ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E)
    let f₀ : CommRingCat.of E ⟶ CommRingCat.of ↥(𝒜 0) :=
      CommRingCat.ofHom (algebraMap E ↥(𝒜 0))
    have : Nontrivial ↥(𝒜 0) :=
      ⟨⟨0, zero_mem (𝒜 0)⟩, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩
    have hBij₀ : Function.Bijective f₀.hom := by
      refine ⟨(algebraMap E ↥(𝒜 0)).injective, fun p => ?_⟩
      have hp1 : (p : MvPolynomial (Fin (N + 1)) E) ∈
          (1 : Submodule E (MvPolynomial (Fin (N + 1)) E)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (N + 1))]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      refine ⟨c, Subtype.ext ?_⟩
      calc (algebraMap E ↥(𝒜 0) c : MvPolynomial (Fin (N + 1)) E)
          = c • (1 : MvPolynomial (Fin (N + 1)) E) := Algebra.algebraMap_eq_smul_one c
        _ = algebraMap E (MvPolynomial (Fin (N + 1)) E) c := (Algebra.algebraMap_eq_smul_one c).symm
        _ = p.1 := hc
    have : CategoryTheory.IsIso f₀ :=
      (ConcreteCategory.isIso_iff_bijective f₀).mpr hBij₀
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f₀) := inferInstance
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver E N).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ AlgebraicGeometry.Spec.map f₀)
      infer_instance
    rw [← CategoryTheory.Over.w ι]
    infer_instance

  have hPolyProps : ∀ (E : Type u) [Field E],
      CompactSpace ↥(weilPolyLineSpecOver E).left ∧
      AlgebraicGeometry.IsSeparated (weilPolyLineSpecOver E).hom ∧
      AlgebraicGeometry.LocallyOfFiniteType (weilPolyLineSpecOver E).hom := by
    intro E _
    dsimp only [weilPolyLineSpecOver, CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
    refine ⟨inferInstance, inferInstance, ?_⟩
    rw [← Polynomial.algebraMap_eq]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr
      ((RingHom.finiteType_algebraMap (A := E) (B := Polynomial E)).mpr inferInstance)

  have hPolyModel : ∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
      IsFieldPullbackModel E₀ E₁ (weilPolyLineSpecOver E₀) (weilPolyLineSpecOver E₁)
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap E₀ E₁)))) := by
    intro E₀ E₁ _ _ _
    let f₀ : CommRingCat.of E₀ ⟶ CommRingCat.of (Polynomial E₀) :=
      CommRingCat.ofHom Polynomial.C
    let g₀ : CommRingCat.of E₀ ⟶ CommRingCat.of E₁ :=
      CommRingCat.ofHom (algebraMap E₀ E₁)
    let inl₀ : CommRingCat.of (Polynomial E₀) ⟶ CommRingCat.of (Polynomial E₁) :=
      CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap E₀ E₁))
    let inr₀ : CommRingCat.of E₁ ⟶ CommRingCat.of (Polynomial E₁) :=
      CommRingCat.ofHom Polynomial.C
    have hcomm₀ : f₀ ≫ inl₀ = g₀ ≫ inr₀ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      simp [f₀, g₀, inl₀, inr₀]
    let cocone₀ : CategoryTheory.Limits.PushoutCocone f₀ g₀ :=
      CategoryTheory.Limits.PushoutCocone.mk inl₀ inr₀ hcomm₀
    have hColim₀ : CategoryTheory.Limits.IsColimit cocone₀ :=
      CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm₀
        (fun s => CommRingCat.ofHom
          (Polynomial.eval₂RingHom s.inr.hom (s.inl.hom Polynomial.X)))
        (fun s => by
          apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            have hcond := congrArg (fun k => k.hom r) s.condition
            simpa [f₀, g₀, inl₀] using hcond.symm
          · simp [inl₀])
        (fun s => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro r
          simp [inr₀])
        (fun s m hm_inl hm_inr => by
          apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            have hr := congrArg (fun k => k.hom r) hm_inr
            simpa [inr₀] using hr
          · have hX := congrArg (fun k => k.hom Polynomial.X) hm_inl
            simpa [inl₀] using hX)
    have hPush₀ : CategoryTheory.IsPushout f₀ g₀ inl₀ inr₀ :=
      CategoryTheory.IsPushout.of_isColimit hColim₀
    exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout f₀ g₀ inl₀ inr₀ hPush₀

  have hProjSpacePkg : ∀ (N : ℕ),
      ∃ π_P : ∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
          (weilProjectiveSpaceOver E₁ N).left ⟶ (weilProjectiveSpaceOver E₀ N).left,
        (∀ (E : Type u) [Field E], IsProjectiveOverField E (weilProjectiveSpaceOver E N)) ∧
        (∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
          IsFieldPullbackModel E₀ E₁ (weilProjectiveSpaceOver E₀ N)
            (weilProjectiveSpaceOver E₁ N) (π_P E₀ E₁)) ∧
        (∀ (E₀ E₁ E₂ : Type u) [Field E₀] [Field E₁] [Field E₂]
            [Algebra E₀ E₁] [Algebra E₁ E₂] [Algebra E₀ E₂] [IsScalarTower E₀ E₁ E₂],
          π_P E₁ E₂ ≫ π_P E₀ E₁ = π_P E₀ E₂) := by
    intro N
    have hFromZero_mk : ∀ {A : Type u} [CommRing A]
        (ℬ : ℕ → Submodule A (MvPolynomial (Fin (N + 1)) A)) [GradedAlgebra ℬ]
        (S : Submonoid (MvPolynomial (Fin (N + 1)) A)) (z : ↥(ℬ 0)),
        HomogeneousLocalization.fromZeroRingHom ℬ S z =
          HomogeneousLocalization.mk
            { deg := 0
              num := z
              den := ⟨1, SetLike.one_mem_graded ℬ⟩
              den_mem := S.one_mem } := by
      intro A _ ℬ _ S z
      rfl

    have hIrrel : ∀ (K : Type u) [CommRing K],
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
          MvPolynomial.gradedAlgebra
        (HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)) := by
      intro K _
      let 𝒜_K := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
      let _ : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
      intro p hp
      have hp0 : GradedRing.proj 𝒜_K 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜_K p).mp hp
      have hcoeff0 : p.coeff 0 = 0 := by
        have hdecomp := DirectSum.sum_support_decompose 𝒜_K p
        have hsum_coeff :
            (∑ i ∈ (DirectSum.decompose 𝒜_K p).support,
              ((DirectSum.decompose 𝒜_K p i : MvPolynomial (Fin (N + 1)) K)).coeff 0) =
            p.coeff 0 := by
          rw [← MvPolynomial.coeff_sum, hdecomp]
        rw [← hsum_coeff]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜_K p 0 : MvPolynomial (Fin (N + 1)) K) = 0 := hp0
          rw [h0]
          rfl
        · by_contra hne
          have hhom : ((DirectSum.decompose 𝒜_K p i :
              MvPolynomial (Fin (N + 1)) K)).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜_K p i).2
          have hdeg := hhom hne
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg
          exact hi hdeg.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro h0
        rw [h0] at hm
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      by_contra h_all
      apply hm_ne
      ext i
      by_contra hmi
      exact h_all ⟨i, Set.mem_univ i, hmi⟩

    let f_grad : ∀ (E₀ E₁ : Type u) [CommRing E₀] [CommRing E₁] [Algebra E₀ E₁],
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀) :=
          MvPolynomial.gradedAlgebra
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁) :=
          MvPolynomial.gradedAlgebra
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀ →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁ :=
      fun E₀ E₁ _ _ _ =>
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀) :=
          MvPolynomial.gradedAlgebra
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁) :=
          MvPolynomial.gradedAlgebra
        { toRingHom := MvPolynomial.map (algebraMap E₀ E₁)
          map_mem := fun {i p} hp => by
            rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
            intro d hd
            rw [MvPolynomial.coeff_map] at hd
            exact hp fun h0 => hd (by rw [h0, map_zero]) }

    have hf_irrel : ∀ (E₀ E₁ : Type u) [CommRing E₀] [CommRing E₁] [Algebra E₀ E₁],
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀) :=
          MvPolynomial.gradedAlgebra
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁) :=
          MvPolynomial.gradedAlgebra
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁) ≤
          HomogeneousIdeal.map (f_grad E₀ E₁)
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀)) := by
      intro E₀ E₁ _ _ _
      let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁
      let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
      change (HomogeneousIdeal.irrelevant 𝒜₁).toIdeal ≤
        (HomogeneousIdeal.map (f_grad E₀ E₁) (HomogeneousIdeal.irrelevant 𝒜₀)).toIdeal
      rw [HomogeneousIdeal.toIdeal_map]
      refine (hIrrel E₁).trans (Ideal.span_le.mpr ?_)
      rintro _ ⟨a, rfl⟩
      have hXa_mem : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E₀) ∈
          (HomogeneousIdeal.irrelevant 𝒜₀).toIdeal := by
        change MvPolynomial.X a ∈ HomogeneousIdeal.irrelevant 𝒜₀
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
        have hXa1 : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E₀) ∈ 𝒜₀ 1 :=
          MvPolynomial.isHomogeneous_X E₀ a
        rw [DirectSum.decompose_of_mem_ne 𝒜₀ hXa1 (by decide)]
      have hmap_X : (f_grad E₀ E₁).toRingHom (MvPolynomial.X a) = MvPolynomial.X a :=
        MvPolynomial.map_X (algebraMap E₀ E₁) a
      rw [← hmap_X]
      exact Ideal.mem_map_of_mem _ hXa_mem

    let π_P : ∀ (E₀ E₁ : Type u) [Field E₀] [Field E₁] [Algebra E₀ E₁],
        (weilProjectiveSpaceOver E₁ N).left ⟶ (weilProjectiveSpaceOver E₀ N).left :=
      fun E₀ E₁ _ _ _ =>
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀) :=
          MvPolynomial.gradedAlgebra
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁) :=
          MvPolynomial.gradedAlgebra
        AlgebraicGeometry.Proj.map (f_grad E₀ E₁) (hf_irrel E₀ E₁)

    have hEquiv : ∀ (a : Fin (N + 1)) (K : Type u) [CommRing K],
        let 𝒜_K := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
        letI : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
        ∀ (x : MvPolynomial (Fin (N + 1)) K), x = MvPolynomial.X a →
          ∃ e : MvPolynomial {b : Fin (N + 1) // b ≠ a} K ≃+* HomogeneousLocalization.Away 𝒜_K x,
            (∀ c : K, e (MvPolynomial.C c) =
              HomogeneousLocalization.fromZeroRingHom 𝒜_K (Submonoid.powers x)
                (algebraMap K ↥(𝒜_K 0) c)) ∧
            (∀ b : {b : Fin (N + 1) // b ≠ a}, (e (MvPolynomial.X b)).val =
              Localization.mk (MvPolynomial.X b.1) ⟨x, Submonoid.mem_powers x⟩) := by
      intro a K _ 𝒜_K x hx
      let _ : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
      subst hx
      let τ_a := {b : Fin (N + 1) // b ≠ a}
      let X_a : MvPolynomial (Fin (N + 1)) K := MvPolynomial.X a
      have hXa : X_a ∈ 𝒜_K 1 := MvPolynomial.isHomogeneous_X K a
      let s₁ : Submonoid.powers X_a := ⟨X_a, Submonoid.mem_powers X_a⟩
      let ι_K : K →+* HomogeneousLocalization.Away 𝒜_K X_a :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_K (Submonoid.powers X_a)).comp
          (algebraMap K ↥(𝒜_K 0))
      let u_K : τ_a → HomogeneousLocalization.Away 𝒜_K X_a := fun b =>
        HomogeneousLocalization.mk
          { deg := 1
            num := ⟨MvPolynomial.X b.1, MvPolynomial.isHomogeneous_X K b.1⟩
            den := ⟨X_a, hXa⟩
            den_mem := Submonoid.mem_powers X_a }
      let α_K : MvPolynomial τ_a K →+* HomogeneousLocalization.Away 𝒜_K X_a :=
        MvPolynomial.eval₂Hom ι_K u_K
      let w_K : Fin (N + 1) → MvPolynomial τ_a K :=
        fun j => if h : j = a then 1 else MvPolynomial.X ⟨j, h⟩
      let dehom_K : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial τ_a K :=
        MvPolynomial.eval₂Hom MvPolynomial.C w_K
      have hdehom_Xa : dehom_K X_a = 1 := by
        simp [dehom_K, X_a, w_K]
      have hg_unit : ∀ y : Submonoid.powers X_a, IsUnit (dehom_K y.1) := by
        rintro ⟨_, ⟨n, rfl⟩⟩
        rw [map_pow, hdehom_Xa, one_pow]
        exact isUnit_one
      let β_loc : Localization (Submonoid.powers X_a) →+* MvPolynomial τ_a K :=
        IsLocalization.lift hg_unit
      let valHom : HomogeneousLocalization.Away 𝒜_K X_a →+* Localization (Submonoid.powers X_a) :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
      let β_K : HomogeneousLocalization.Away 𝒜_K X_a →+* MvPolynomial τ_a K :=
        β_loc.comp valHom
      have hβ_mk : ∀ (p : MvPolynomial (Fin (N + 1)) K) (s : Submonoid.powers X_a),
          dehom_K s.1 = 1 → β_loc (Localization.mk p s) = dehom_K p := by
        intro p s hs1
        have hmk' : Localization.mk p s =
            IsLocalization.mk' (Localization (Submonoid.powers X_a)) p s :=
          congrFun (congrFun Localization.mk_eq_mk' p) s
        rw [hmk']
        exact (IsLocalization.lift_mk'_spec hg_unit p (dehom_K p) s).mpr (by rw [hs1, one_mul])
      have hι_val : ∀ c : K, (ι_K c).val = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        have hc_val : (algebraMap K ↥(𝒜_K 0) c : MvPolynomial (Fin (N + 1)) K) =
            MvPolynomial.C c := by
          calc (algebraMap K ↥(𝒜_K 0) c : MvPolynomial (Fin (N + 1)) K)
              = c • (1 : MvPolynomial (Fin (N + 1)) K) := Algebra.algebraMap_eq_smul_one c
            _ = MvPolynomial.C c := by rw [Algebra.smul_def, mul_one]; rfl
        change (HomogeneousLocalization.fromZeroRingHom 𝒜_K (Submonoid.powers X_a)
          (algebraMap K ↥(𝒜_K 0) c)).val = Localization.mk (MvPolynomial.C c) 1
        rw [hFromZero_mk, HomogeneousLocalization.val_mk]
        exact congrArg (fun q => Localization.mk q 1) hc_val
      have h_left : ∀ P : MvPolynomial τ_a K, β_K (α_K P) = P := by
        have hcomp : β_K.comp α_K = RingHom.id (MvPolynomial τ_a K) := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            change β_loc ((α_K (MvPolynomial.C c)).val) = MvPolynomial.C c
            rw [MvPolynomial.eval₂Hom_C, hι_val c, hβ_mk _ 1 (map_one dehom_K)]
            simp [dehom_K]
          · intro b
            change β_loc ((α_K (MvPolynomial.X b)).val) = MvPolynomial.X b
            rw [MvPolynomial.eval₂Hom_X']
            change β_loc (Localization.mk (MvPolynomial.X b.1) s₁) = MvPolynomial.X b
            rw [hβ_mk _ s₁ hdehom_Xa]
            simp [dehom_K, w_K, b.2]
        exact fun P => congrArg (fun f => f P) hcomp
      have h_right : ∀ z : HomogeneousLocalization.Away 𝒜_K X_a, α_K (β_K z) = z := by
        rcases subsingleton_or_nontrivial K with hSub | hNontriv
        · have : Subsingleton K := hSub
          have h01 : (0 : HomogeneousLocalization.Away 𝒜_K X_a) = 1 := by
            rw [← map_zero ι_K, ← map_one ι_K, Subsingleton.elim (0 : K) 1]
          have : Subsingleton (HomogeneousLocalization.Away 𝒜_K X_a) :=
            subsingleton_of_zero_eq_one h01
          intro z
          exact Subsingleton.elim _ _
        · have : Nontrivial K := hNontriv
          let φ : MvPolynomial (Fin (N + 1)) K →+* Localization (Submonoid.powers X_a) :=
            valHom.comp (α_K.comp dehom_K)
          have hφ_C : ∀ c : K, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
            intro c
            change (α_K (dehom_K (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) 1
            simp [dehom_K, α_K, hι_val]
          have hφ_X : ∀ j : Fin (N + 1),
              φ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) s₁ := by
            intro j
            change (α_K (dehom_K (MvPolynomial.X j))).val = Localization.mk (MvPolynomial.X j) s₁
            rw [MvPolynomial.eval₂Hom_X']
            dsimp [w_K]
            split_ifs with hj
            · subst hj
              rw [map_one, HomogeneousLocalization.val_one]
              exact (Localization.mk_self s₁).symm
            · rw [MvPolynomial.eval₂Hom_X']
              rfl
          have hProd_mk : ∀ (S : Finset (Fin (N + 1))) (m : Fin (N + 1) →₀ ℕ),
              (∏ j ∈ S, Localization.mk (MvPolynomial.X j ^ m j) (s₁ ^ m j)) =
                Localization.mk (∏ j ∈ S, MvPolynomial.X j ^ m j)
                  (s₁ ^ (∑ j ∈ S, m j)) := by
            intro S m
            induction S using Finset.induction_on with
            | empty =>
              simp [Localization.mk_one]
            | @insert j S hj ih =>
              rw [Finset.prod_insert hj, Finset.prod_insert hj, Finset.sum_insert hj,
                ih, Localization.mk_mul, pow_add]
          have hφ_mon : ∀ (m : Fin (N + 1) →₀ ℕ) (c : K),
              φ (MvPolynomial.monomial m c) =
                Localization.mk (MvPolynomial.monomial m c) (s₁ ^ (∑ j ∈ m.support, m j)) := by
            intro m c
            conv_lhs => rw [MvPolynomial.monomial_eq]
            rw [map_mul, hφ_C c, Finsupp.prod, map_prod]
            have hprod_eq : (∏ j ∈ m.support, φ (MvPolynomial.X j ^ m j)) =
                ∏ j ∈ m.support, Localization.mk (MvPolynomial.X j ^ m j) (s₁ ^ m j) := by
              refine Finset.prod_congr rfl fun j _ => ?_
              rw [map_pow, hφ_X j, Localization.mk_pow]
            rw [hprod_eq, hProd_mk, Localization.mk_mul, one_mul,
              ← Finsupp.prod, ← MvPolynomial.monomial_eq]
          intro z
          refine Quotient.inductionOn' z fun nd => ?_
          apply HomogeneousLocalization.val_injective
          obtain ⟨n, hn⟩ : ∃ n : ℕ, (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ^ n =
              nd.den.1 := nd.den_mem
          have hd_eq : nd.deg = n := by
            have hden_hom1 : nd.den.1.IsHomogeneous nd.deg :=
              (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
            have hden_hom2 : nd.den.1.IsHomogeneous n := by
              rw [← hn]
              have hmem : X_a ^ n ∈ 𝒜_K (n • 1) := SetLike.pow_mem_graded n hXa
              rw [nsmul_one] at hmem
              exact (MvPolynomial.mem_homogeneousSubmodule n (X_a ^ n)).mp hmem
            have hcoeff_ne : nd.den.1.coeff (Finsupp.single a n) ≠ 0 := by
              rw [← hn]
              simp only [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_monomial, ↓reduceIte]
              exact one_ne_zero
            exact (hden_hom1 hcoeff_ne).symm.trans (hden_hom2 hcoeff_ne)
          have hden_dehom : dehom_K nd.den.1 = 1 := by
            rw [← hn, map_pow, hdehom_Xa, one_pow]
          have hβ_nd : β_K (HomogeneousLocalization.mk nd) = dehom_K nd.num.1 := by
            change β_loc (HomogeneousLocalization.mk nd).val = dehom_K nd.num.1
            rw [HomogeneousLocalization.val_mk]
            exact hβ_mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩ hden_dehom
          rw [hβ_nd, HomogeneousLocalization.val_mk]
          change φ nd.num.1 = Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩
          have hnum_hom : nd.num.1.IsHomogeneous n := by
            rw [← hd_eq]
            exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
          have hSum_mk : ∀ (S : Finset (Fin (N + 1) →₀ ℕ)),
              (∀ m ∈ S, (∑ j ∈ m.support, m j) = n) →
              φ (∑ m ∈ S, MvPolynomial.monomial m (nd.num.1.coeff m)) =
                Localization.mk (∑ m ∈ S, MvPolynomial.monomial m (nd.num.1.coeff m)) (s₁ ^ n) := by
            intro S hS
            induction S using Finset.induction_on with
            | empty =>
              simp [Localization.mk_zero]
            | @insert m S hm ih =>
              rw [Finset.sum_insert hm, map_add,
                hφ_mon m _, hS m (Finset.mem_insert_self m S),
                ih (fun m' hm' => hS m' (Finset.mem_insert_of_mem hm')),
                Localization.add_mk_self]
          have hsupp_deg : ∀ m ∈ nd.num.1.support, (∑ j ∈ m.support, m j) = n := by
            intro m hm
            have h := hnum_hom (MvPolynomial.mem_support_iff.mp hm)
            simpa [Finsupp.weight_apply, Finsupp.sum] using h
          have hsum_eq := hSum_mk nd.num.1.support hsupp_deg
          rw [← MvPolynomial.as_sum nd.num.1] at hsum_eq
          have hs_eq : s₁ ^ n = ⟨nd.den.1, nd.den_mem⟩ := Subtype.ext hn
          rwa [hs_eq] at hsum_eq
      refine ⟨{ toFun := α_K
                invFun := β_K
                left_inv := h_left
                right_inv := h_right
                map_mul' := map_mul α_K
                map_add' := map_add α_K }, ?_, ?_⟩
      · intro c
        exact MvPolynomial.eval₂Hom_C ι_K u_K c
      · intro b
        change (α_K (MvPolynomial.X b)).val = _
        rw [MvPolynomial.eval₂Hom_X']
        rfl

    have hPush : ∀ (E₀ E₁ : Type u) [CommRing E₀] [CommRing E₁] [Algebra E₀ E₁]
        (a : Fin (N + 1)),
        let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀
        let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁
        letI : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
        letI : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
        let g := f_grad E₀ E₁
        CategoryTheory.IsPushout
          (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜₀
                (Submonoid.powers (MvPolynomial.X a))).comp
              (algebraMap E₀ ↥(𝒜₀ 0))))
          (CommRingCat.ofHom (algebraMap E₀ E₁))
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map g (MvPolynomial.X a)))
          (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
                (Submonoid.powers (g (MvPolynomial.X a)))).comp
              (algebraMap E₁ ↥(𝒜₁ 0)))) := by
      intro E₀ E₁ _ _ _ a 𝒜₀ 𝒜₁ g
      let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
      let τ_a := {b : Fin (N + 1) // b ≠ a}
      let f_p : CommRingCat.of E₀ ⟶ CommRingCat.of (MvPolynomial τ_a E₀) :=
        CommRingCat.ofHom MvPolynomial.C
      let g_p : CommRingCat.of E₀ ⟶ CommRingCat.of E₁ :=
        CommRingCat.ofHom (algebraMap E₀ E₁)
      let inl_p : CommRingCat.of (MvPolynomial τ_a E₀) ⟶ CommRingCat.of (MvPolynomial τ_a E₁) :=
        CommRingCat.ofHom (MvPolynomial.map (algebraMap E₀ E₁))
      let inr_p : CommRingCat.of E₁ ⟶ CommRingCat.of (MvPolynomial τ_a E₁) :=
        CommRingCat.ofHom MvPolynomial.C
      have hcomm_p : f_p ≫ inl_p = g_p ≫ inr_p := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        simp [f_p, g_p, inl_p, inr_p]
      let cocone_p : CategoryTheory.Limits.PushoutCocone f_p g_p :=
        CategoryTheory.Limits.PushoutCocone.mk inl_p inr_p hcomm_p
      have hColim_p : CategoryTheory.Limits.IsColimit cocone_p :=
        CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_p
          (fun s => CommRingCat.ofHom
            (MvPolynomial.eval₂Hom s.inr.hom (fun b => s.inl.hom (MvPolynomial.X b))))
          (fun s => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro r
              have hcond := congrArg (fun k => k.hom r) s.condition
              simpa [f_p, g_p, inl_p] using hcond.symm
            · intro b
              simp [inl_p])
          (fun s => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro r
            simp [inr_p])
          (fun s m hm_inl hm_inr => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro r
              have hr := congrArg (fun k => k.hom r) hm_inr
              simpa [inr_p] using hr
            · intro b
              have hb := congrArg (fun k => k.hom (MvPolynomial.X b)) hm_inl
              simpa [inl_p] using hb)
      have hPush_p : CategoryTheory.IsPushout f_p g_p inl_p inr_p :=
        CategoryTheory.IsPushout.of_isColimit hColim_p
      have hg_Xa : g (MvPolynomial.X a) = MvPolynomial.X a :=
        MvPolynomial.map_X (algebraMap E₀ E₁) a
      obtain ⟨e₀, he₀_C, he₀_X⟩ := hEquiv a E₀ (MvPolynomial.X a) rfl
      obtain ⟨e₁, he₁_C, he₁_X⟩ := hEquiv a E₁ (g (MvPolynomial.X a)) hg_Xa
      refine CategoryTheory.IsPushout.of_iso hPush_p
        (CategoryTheory.Iso.refl _) e₀.toCommRingCatIso
        (CategoryTheory.Iso.refl _) e₁.toCommRingCatIso
        ?_ ?_ ?_ ?_
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact he₀_C c
      · simp [g_p]
      · apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          apply HomogeneousLocalization.val_injective
          change (e₁ (MvPolynomial.map (algebraMap E₀ E₁) (MvPolynomial.C c))).val =
            (HomogeneousLocalization.Away.map g (MvPolynomial.X a) (e₀ (MvPolynomial.C c))).val
          rw [MvPolynomial.map_C, he₀_C c, he₁_C (algebraMap E₀ E₁ c),
            hFromZero_mk, hFromZero_mk]
          symm
          change (HomogeneousLocalization.map g _ (HomogeneousLocalization.mk _)).val = _
          rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
            HomogeneousLocalization.val_mk]
          have hc0 : (algebraMap E₀ ↥(𝒜₀ 0) c : MvPolynomial (Fin (N + 1)) E₀) =
              MvPolynomial.C c := by
            rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]; rfl
          have hc1 : (algebraMap E₁ ↥(𝒜₁ 0) (algebraMap E₀ E₁ c) :
              MvPolynomial (Fin (N + 1)) E₁) = MvPolynomial.C (algebraMap E₀ E₁ c) := by
            rw [Algebra.algebraMap_eq_smul_one, Algebra.smul_def, mul_one]; rfl
          have hg_c : g (algebraMap E₀ ↥(𝒜₀ 0) c : MvPolynomial (Fin (N + 1)) E₀) =
              (algebraMap E₁ ↥(𝒜₁ 0) (algebraMap E₀ E₁ c) : MvPolynomial (Fin (N + 1)) E₁) := by
            rw [hc0, hc1]
            exact MvPolynomial.map_C (algebraMap E₀ E₁) c
          exact congrArg₂ Localization.mk hg_c (Subtype.ext (map_one g))
        · intro b
          apply HomogeneousLocalization.val_injective
          change (e₁ (MvPolynomial.map (algebraMap E₀ E₁) (MvPolynomial.X b))).val =
            (HomogeneousLocalization.Away.map g (MvPolynomial.X a) (e₀ (MvPolynomial.X b))).val
          rw [MvPolynomial.map_X, he₁_X b]
          symm
          have he₀_mk : e₀ (MvPolynomial.X b) = HomogeneousLocalization.mk
              { deg := 1
                num := ⟨MvPolynomial.X b.1,
                  (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E₀ b.1)⟩
                den := ⟨MvPolynomial.X a,
                  (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E₀ a)⟩
                den_mem := Submonoid.mem_powers (MvPolynomial.X a) } := by
            apply HomogeneousLocalization.val_injective
            rw [he₀_X b, HomogeneousLocalization.val_mk]
          rw [he₀_mk]
          change (HomogeneousLocalization.map g _ (HomogeneousLocalization.mk _)).val = _
          rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
          exact congrArg
            (fun p => Localization.mk p ⟨g (MvPolynomial.X a), Submonoid.mem_powers (g (MvPolynomial.X a))⟩)
            (MvPolynomial.map_X (algebraMap E₀ E₁) b.1)
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact he₁_C c

    refine ⟨π_P, ?_, ?_, ?_⟩
    · intro E _
      refine ⟨N, 𝟙 (weilProjectiveSpaceOver E N), ?_⟩
      change AlgebraicGeometry.IsClosedImmersion (𝟙 (weilProjectiveSpaceOver E N).left)
      infer_instance
    · intro E₀ E₁ _ _ _
      let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁
      let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
      let g := f_grad E₀ E₁
      let hg_irr := hf_irrel E₀ E₁
      let π : AlgebraicGeometry.Proj 𝒜₁ ⟶ AlgebraicGeometry.Proj 𝒜₀ :=
        AlgebraicGeometry.Proj.map g hg_irr
      let p₀_hom : AlgebraicGeometry.Proj 𝒜₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of E₀) :=
        AlgebraicGeometry.Proj.toSpecZero 𝒜₀ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ ↥(𝒜₀ 0)))
      let p₁_hom : AlgebraicGeometry.Proj 𝒜₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of E₁) :=
        AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ ↥(𝒜₁ 0)))
      let s : AlgebraicGeometry.Spec (CommRingCat.of E₁) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of E₀) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))
      change CategoryTheory.IsPullback π p₁_hom p₀_hom s
      have hSpecPB : ∀ a : Fin (N + 1),
          CategoryTheory.IsPullback
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map g (MvPolynomial.X a))))
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
                    (Submonoid.powers (g (MvPolynomial.X a)))).comp
                  (algebraMap E₁ ↥(𝒜₁ 0)))))
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                ((HomogeneousLocalization.fromZeroRingHom 𝒜₀
                    (Submonoid.powers (MvPolynomial.X a))).comp
                  (algebraMap E₀ ↥(𝒜₀ 0)))))
            s :=
        fun a => AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPush E₀ E₁ a)
      have hCov₀ : (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜₀ (MvPolynomial.X a)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜₀ MvPolynomial.X (hIrrel E₀)
      have hCov₁ : (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜₁ MvPolynomial.X (hIrrel E₁)
      have hAway_p₀ : ∀ (a : Fin (N + 1))
          (hXa₀ : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E₀) ∈ 𝒜₀ 1),
          AlgebraicGeometry.Proj.awayι 𝒜₀ (MvPolynomial.X a) hXa₀ zero_lt_one ≫ p₀_hom =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                ((HomogeneousLocalization.fromZeroRingHom 𝒜₀
                    (Submonoid.powers (MvPolynomial.X a))).comp
                  (algebraMap E₀ ↥(𝒜₀ 0)))) := by
        intro a hXa₀
        change AlgebraicGeometry.Proj.awayι 𝒜₀ (MvPolynomial.X a) hXa₀ zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜₀ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ ↥(𝒜₀ 0))) = _
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      have hAway_p₁ : ∀ (a : Fin (N + 1))
          (hXa₁ : g (MvPolynomial.X a) ∈ 𝒜₁ 1),
          AlgebraicGeometry.Proj.awayι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one ≫ p₁_hom =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
                    (Submonoid.powers (g (MvPolynomial.X a)))).comp
                  (algebraMap E₁ ↥(𝒜₁ 0)))) := by
        intro a hXa₁
        change AlgebraicGeometry.Proj.awayι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ ↥(𝒜₁ 0))) = _
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      have hComm : π ≫ p₀_hom = p₁_hom ≫ s := by
        refine AlgebraicGeometry.Scheme.hom_ext_of_forall _ _ fun x => ?_
        have hx_top : x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜₁).Opens) := trivial
        rw [← hCov₁, TopologicalSpace.Opens.mem_iSup] at hx_top
        obtain ⟨a, ha⟩ := hx_top
        have hg_Xa : g (MvPolynomial.X a) = MvPolynomial.X a :=
          MvPolynomial.map_X (algebraMap E₀ E₁) a
        let U₁_a : (AlgebraicGeometry.Proj 𝒜₁).Opens :=
          AlgebraicGeometry.Proj.basicOpen 𝒜₁ (g (MvPolynomial.X a))
        have hx_U₁ : x ∈ U₁_a := by dsimp [U₁_a]; rwa [hg_Xa]
        refine ⟨U₁_a, hx_U₁, ?_⟩
        have hXa₀ : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E₀) ∈ 𝒜₀ 1 :=
          MvPolynomial.isHomogeneous_X E₀ a
        have hXa₁ : g (MvPolynomial.X a) ∈ 𝒜₁ 1 := g.map_mem hXa₀
        let iso₁ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one
        rw [← CategoryTheory.cancel_epi iso₁.inv, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one]
        calc AlgebraicGeometry.Proj.awayι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one ≫ π ≫ p₀_hom
            = (AlgebraicGeometry.Proj.awayι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one ≫ π) ≫ p₀_hom :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.Away.map g (MvPolynomial.X a))) ≫
              (AlgebraicGeometry.Proj.awayι 𝒜₀ (MvPolynomial.X a) hXa₀ zero_lt_one ≫ p₀_hom) := by
              rw [AlgebraicGeometry.Proj.awayι_comp_map g hg_irr zero_lt_one (MvPolynomial.X a) hXa₀,
                CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.Away.map g (MvPolynomial.X a))) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  ((HomogeneousLocalization.fromZeroRingHom 𝒜₀
                      (Submonoid.powers (MvPolynomial.X a))).comp
                    (algebraMap E₀ ↥(𝒜₀ 0)))) := by
              rw [hAway_p₀ a hXa₀]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
                      (Submonoid.powers (g (MvPolynomial.X a)))).comp
                    (algebraMap E₁ ↥(𝒜₁ 0)))) ≫ s := (hSpecPB a).w
          _ = (AlgebraicGeometry.Proj.awayι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one ≫ p₁_hom) ≫ s := by
              rw [← hAway_p₁ a hXa₁]
          _ = AlgebraicGeometry.Proj.awayι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one ≫ p₁_hom ≫ s :=
              CategoryTheory.Category.assoc _ _ _
      let U₀ : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜₀).Opens :=
        fun a => AlgebraicGeometry.Proj.basicOpen 𝒜₀ (MvPolynomial.X a)
      have hChartPB : ∀ a : Fin (N + 1),
          CategoryTheory.IsPullback
            (π ∣_ U₀ a)
            ((π ⁻¹ᵁ U₀ a).ι ≫ p₁_hom)
            ((U₀ a).ι ≫ p₀_hom)
            s := by
        intro a
        have hXa₀ : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E₀) ∈ 𝒜₀ 1 :=
          MvPolynomial.isHomogeneous_X E₀ a
        have hXa₁ : g (MvPolynomial.X a) ∈ 𝒜₁ 1 := g.map_mem hXa₀
        have hEq_a : π ⁻¹ᵁ U₀ a = AlgebraicGeometry.Proj.basicOpen 𝒜₁ (g (MvPolynomial.X a)) :=
          AlgebraicGeometry.Proj.map_preimage_basicOpen g hg_irr (MvPolynomial.X a)
        let e₁ := (AlgebraicGeometry.Proj 𝒜₁).isoOfEq hEq_a ≪≫
          AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one
        let e₀ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₀ (MvPolynomial.X a) hXa₀ zero_lt_one
        have he₁_ι : e₁.symm.hom ≫ (π ⁻¹ᵁ U₀ a).ι =
            AlgebraicGeometry.Proj.awayι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one := by
          change ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one).inv ≫
              ((AlgebraicGeometry.Proj 𝒜₁).isoOfEq hEq_a).inv) ≫ (π ⁻¹ᵁ U₀ a).ι = _
          have hiso_ι : ((AlgebraicGeometry.Proj 𝒜₁).isoOfEq hEq_a).inv ≫ (π ⁻¹ᵁ U₀ a).ι =
              (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (g (MvPolynomial.X a))).ι := by
            rw [CategoryTheory.Iso.inv_comp_eq, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
          rw [CategoryTheory.Category.assoc, hiso_ι,
            AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₁ (g (MvPolynomial.X a)) hXa₁ zero_lt_one]
        have he₀_ι : e₀.symm.hom ≫ (U₀ a).ι =
            AlgebraicGeometry.Proj.awayι 𝒜₀ (MvPolynomial.X a) hXa₀ zero_lt_one :=
          AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₀ (MvPolynomial.X a) hXa₀ zero_lt_one
        refine CategoryTheory.IsPullback.of_iso (hSpecPB a)
          e₁.symm e₀.symm (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          ?_ ?_ ?_ ?_
        · rw [← CategoryTheory.cancel_mono (U₀ a).ι, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            he₀_ι, ← CategoryTheory.Category.assoc, he₁_ι,
            AlgebraicGeometry.Proj.awayι_comp_map g hg_irr zero_lt_one (MvPolynomial.X a) hXa₀]
        · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
            ← CategoryTheory.Category.assoc, he₁_ι, hAway_p₁ a hXa₁]
        · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
            ← CategoryTheory.Category.assoc, he₀_ι, hAway_p₀ a hXa₀]
        · simp
      let p₁ := CategoryTheory.Limits.pullback.fst p₀_hom s
      let p₂ := CategoryTheory.Limits.pullback.snd p₀_hom s
      let Φ : AlgebraicGeometry.Proj 𝒜₁ ⟶ CategoryTheory.Limits.pullback p₀_hom s :=
        CategoryTheory.Limits.pullback.lift π p₁_hom hComm
      let W : Fin (N + 1) → (CategoryTheory.Limits.pullback p₀_hom s).Opens :=
        fun a => p₁ ⁻¹ᵁ U₀ a
      have hCovW : iSup W = ⊤ := by
        rw [eq_top_iff]
        intro x _
        have hx : p₁.base x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜₀).Opens) := trivial
        rw [← hCov₀, TopologicalSpace.Opens.mem_iSup] at hx
        obtain ⟨a, ha⟩ := hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
      have hIsoΦ : CategoryTheory.IsIso Φ := by
        change CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme Φ
        rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
          (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) W hCovW]
        intro a
        change CategoryTheory.IsIso (Φ ∣_ W a)
        have hΦ_p₁ : Φ ≫ p₁ = π := CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hVU : Φ ⁻¹ᵁ W a = π ⁻¹ᵁ U₀ a := by
          ext x
          change p₁.base (Φ.base x) ∈ U₀ a ↔ π.base x ∈ U₀ a
          rw [← hΦ_p₁]
          rfl
        let e_V := (AlgebraicGeometry.Proj 𝒜₁).isoOfEq hVU
        have h_comp_res : (Φ ∣_ W a) ≫ (p₁ ∣_ U₀ a) = e_V.hom ≫ (π ∣_ U₀ a) := by
          rw [← CategoryTheory.cancel_mono (U₀ a).ι, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            ← CategoryTheory.Category.assoc (Φ ∣_ W a), AlgebraicGeometry.morphismRestrict_ι,
            CategoryTheory.Category.assoc, hΦ_p₁,
            AlgebraicGeometry.morphismRestrict_ι π (U₀ a),
            ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
        have hPB_V : CategoryTheory.IsPullback
            ((Φ ∣_ W a) ≫ (p₁ ∣_ U₀ a))
            ((Φ ⁻¹ᵁ W a).ι ≫ p₁_hom)
            ((U₀ a).ι ≫ p₀_hom)
            s := by
          refine CategoryTheory.IsPullback.of_iso (hChartPB a)
            e_V.symm (CategoryTheory.Iso.refl _)
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            ?_ ?_ ?_ ?_
          · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
              h_comp_res, CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.inv_hom_id_assoc]
          · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
              CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.eq_inv_comp,
              ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
          · simp
          · simp
        have hPB_W : CategoryTheory.IsPullback
            (p₁ ∣_ U₀ a)
            ((W a).ι ≫ p₂)
            ((U₀ a).ι ≫ p₀_hom)
            s :=
          CategoryTheory.IsPullback.paste_vert
            (AlgebraicGeometry.isPullback_morphismRestrict p₁ (U₀ a))
            (CategoryTheory.IsPullback.of_hasPullback p₀_hom s)
        let e_cone := CategoryTheory.IsPullback.isoIsPullback _ _ hPB_V hPB_W
        have hΦ_eq : Φ ∣_ W a = e_cone.hom := by
          apply hPB_W.hom_ext
          · exact (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_V hPB_W).symm
          · rw [CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_V hPB_W,
              ← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              CategoryTheory.Category.assoc]
            congr 1
            exact CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [hΦ_eq]
        infer_instance
      have : CategoryTheory.IsIso Φ := hIsoΦ
      exact CategoryTheory.IsPullback.of_iso_pullback ⟨hComm⟩ (CategoryTheory.asIso Φ)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    · intro E₀ E₁ E₂ _ _ _ _ _ _ _
      let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₀
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₁
      let 𝒜₂ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E₂
      let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
      let _ : GradedAlgebra 𝒜₂ := MvPolynomial.gradedAlgebra
      have hf_comp : (f_grad E₁ E₂).comp (f_grad E₀ E₁) = f_grad E₀ E₂ := by
        apply GradedRingHom.ext
        intro p
        change MvPolynomial.map (algebraMap E₁ E₂) (MvPolynomial.map (algebraMap E₀ E₁) p) =
          MvPolynomial.map (algebraMap E₀ E₂) p
        rw [MvPolynomial.map_map, ← IsScalarTower.algebraMap_eq E₀ E₁ E₂]
      have hProjMapCongr : ∀ {f' g' : 𝒜₀ →+*ᵍ 𝒜₂} (hfg : f' = g')
          (hf' : HomogeneousIdeal.irrelevant 𝒜₂ ≤
            HomogeneousIdeal.map f' (HomogeneousIdeal.irrelevant 𝒜₀))
          (hg' : HomogeneousIdeal.irrelevant 𝒜₂ ≤
            HomogeneousIdeal.map g' (HomogeneousIdeal.irrelevant 𝒜₀)),
          AlgebraicGeometry.Proj.map f' hf' = AlgebraicGeometry.Proj.map g' hg' := by
        intro f' g' hfg hf' hg'
        subst hfg
        rfl
      change AlgebraicGeometry.Proj.map (f_grad E₁ E₂) (hf_irrel E₁ E₂) ≫
          AlgebraicGeometry.Proj.map (f_grad E₀ E₁) (hf_irrel E₀ E₁) =
        AlgebraicGeometry.Proj.map (f_grad E₀ E₂) (hf_irrel E₀ E₂)
      rw [← AlgebraicGeometry.Proj.map_comp (f_grad E₀ E₁) (f_grad E₁ E₂)
        (hf_irrel E₀ E₁) (hf_irrel E₁ E₂)]
      exact hProjMapCongr hf_comp _ (hf_irrel E₀ E₂)

  exact ⟨hProjProper, hPolyProps, hPolyModel, hProjSpacePkg⟩

theorem weil_spread_out_finite_diagram_morphisms_and_opens (F : Type u) [Field F]
    (L₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F ↥L₀]
    (Obj Mor OpenIdx : Type) [Finite Obj] [Finite Mor] [Finite OpenIdx]
    (W : Obj → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (Y₀ : Obj → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
    (p₀ : ∀ i : Obj, (W i).left ⟶ (Y₀ i).left)
    (hComp : ∀ i : Obj, CompactSpace ↥(Y₀ i).left)
    (hSep : ∀ i : Obj, AlgebraicGeometry.IsSeparated (Y₀ i).hom)
    (hLFT : ∀ i : Obj, AlgebraicGeometry.LocallyOfFiniteType (Y₀ i).hom)
    (hp₀ : ∀ i : Obj, IsFieldPullbackModel ↥L₀ (AlgebraicClosure F) (Y₀ i) (W i) (p₀ i))
    (src tgt : Mor → Obj)
    (φ_bar : ∀ e : Mor, W (src e) ⟶ W (tgt e))
    (carrier_idx : OpenIdx → Obj)
    (U_bar : ∀ u : OpenIdx, (W (carrier_idx u)).left.Opens) :
    ∃ (L₁ : IntermediateField F (AlgebraicClosure F))
      (hLE : L₀ ≤ L₁)
      (_ : FiniteDimensional F ↥L₁),
      letI : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
      ∃ (p₁ : ∀ i : Obj, (W i).left ⟶ (weilBaseChangeOver ↥L₀ ↥L₁ (Y₀ i)).left),
        (∀ i : Obj,
          IsFieldPullbackModel ↥L₁ (AlgebraicClosure F)
            (weilBaseChangeOver ↥L₀ ↥L₁ (Y₀ i)) (W i) (p₁ i) ∧
          p₁ i ≫ CategoryTheory.Limits.pullback.fst (Y₀ i).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L₁))) = p₀ i) ∧
        (∀ e : Mor,
          ∃ φ₁ : weilBaseChangeOver ↥L₀ ↥L₁ (Y₀ (src e)) ⟶
              weilBaseChangeOver ↥L₀ ↥L₁ (Y₀ (tgt e)),
            p₁ (src e) ≫ φ₁.left = (φ_bar e).left ≫ p₁ (tgt e)) ∧
        (∀ u : OpenIdx,
          ∃ U₁ : (weilBaseChangeOver ↥L₀ ↥L₁ (Y₀ (carrier_idx u))).left.Opens,
            (TopologicalSpace.Opens.map (p₁ (carrier_idx u)).base).obj U₁ = U_bar u) :=
by
  classical
  let _ := hSep
  let k : Type u := AlgebraicClosure F
  haveI : Algebra.IsAlgebraic F k := AlgebraicClosure.isAlgebraic F
  haveI : Algebra.IsIntegral F k := Algebra.IsAlgebraic.isIntegral

  
  have hTowerLift : ∀ (L : IntermediateField F k) (hLE : L₀ ≤ L)
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
      (W_X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p : W_X.left ⟶ Y.left),
      IsFieldPullbackModel ↥L₀ k Y W_X p →
      letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
      ∃ (p_L : W_X.left ⟶ (weilBaseChangeOver ↥L₀ ↥L Y).left),
        IsFieldPullbackModel ↥L k (weilBaseChangeOver ↥L₀ ↥L Y) W_X p_L ∧
        p_L ≫ CategoryTheory.Limits.pullback.fst Y.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L))) = p := by
    intro L hLE Y W_X p hp
    letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    haveI : IsScalarTower ↥L₀ ↥L k := IsScalarTower.of_algebraMap_eq' rfl
    dsimp only [IsFieldPullbackModel, weilBaseChangeOver, CategoryTheory.Over.mk_left,
      CategoryTheory.Over.mk_hom] at hp ⊢
    let s₀L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L))
    let sLk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L k))
    have hs : sLk ≫ s₀L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ k)) := by
      dsimp [s₀L, sLk]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq ↥L₀ ↥L k]
    have hcomm : p ≫ Y.hom = (W_X.hom ≫ sLk) ≫ s₀L := by
      rw [CategoryTheory.Category.assoc, hs]
      exact hp.w
    let p_L : W_X.left ⟶ CategoryTheory.Limits.pullback Y.hom s₀L :=
      CategoryTheory.Limits.pullback.lift p (W_X.hom ≫ sLk) hcomm
    have hOuter : CategoryTheory.IsPullback
        (p_L ≫ CategoryTheory.Limits.pullback.fst Y.hom s₀L) W_X.hom Y.hom (sLk ≫ s₀L) := by
      dsimp [p_L]
      rw [CategoryTheory.Limits.pullback.lift_fst, hs]
      exact hp
    exact ⟨p_L,
      CategoryTheory.IsPullback.of_right hOuter
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback Y.hom s₀L),
      CategoryTheory.Limits.pullback.lift_fst _ _ _⟩

  
  have hTowerTransportMor : ∀ (L L' : IntermediateField F k)
      (h₀ : L₀ ≤ L) (h₁ : L₀ ≤ L') (hLL' : L ≤ L')
      (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
      (W₁ W₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p₀₁ : W₁.left ⟶ Y₁.left) (p₀₂ : W₂.left ⟶ Y₂.left)
      (ψ_bar : W₁ ⟶ W₂),
      let alg₀ : Algebra ↥L₀ ↥L := (IntermediateField.inclusion h₀).toRingHom.toAlgebra
      let alg₁ : Algebra ↥L₀ ↥L' := (IntermediateField.inclusion h₁).toRingHom.toAlgebra
      ∀ (p_L₁ : W₁.left ⟶ (@weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y₁).left)
        (p_L₂ : W₂.left ⟶ (@weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y₂).left)
        (p_L'₁ : W₁.left ⟶ (@weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y₁).left)
        (p_L'₂ : W₂.left ⟶ (@weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y₂).left)
        (ψ_L : @weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y₁ ⟶ @weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y₂),
        IsFieldPullbackModel ↥L k (@weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y₁) W₁ p_L₁ →
        p_L₁ ≫ CategoryTheory.Limits.pullback.fst Y₁.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L _ _ alg₀))) = p₀₁ →
        p_L₂ ≫ CategoryTheory.Limits.pullback.fst Y₂.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L _ _ alg₀))) = p₀₂ →
        IsFieldPullbackModel ↥L' k (@weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y₁) W₁ p_L'₁ →
        p_L'₁ ≫ CategoryTheory.Limits.pullback.fst Y₁.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L' _ _ alg₁))) = p₀₁ →
        IsFieldPullbackModel ↥L' k (@weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y₂) W₂ p_L'₂ →
        p_L'₂ ≫ CategoryTheory.Limits.pullback.fst Y₂.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L' _ _ alg₁))) = p₀₂ →
        p_L₁ ≫ ψ_L.left = ψ_bar.left ≫ p_L₂ →
        ∃ ψ_L' : @weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y₁ ⟶ @weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y₂,
          p_L'₁ ≫ ψ_L'.left = ψ_bar.left ≫ p_L'₂ := by
    intro L L' h₀ h₁ hLL' Y₁ Y₂ W₁ W₂ p₀₁ p₀₂ ψ_bar alg₀ alg₁
    let algLL' : Algebra ↥L ↥L' := (IntermediateField.inclusion hLL').toRingHom.toAlgebra
    letI : Algebra ↥L₀ ↥L := alg₀
    letI : Algebra ↥L₀ ↥L' := alg₁
    letI : Algebra ↥L ↥L' := algLL'
    have hScalar₀LL' : @IsScalarTower ↥L₀ ↥L ↥L' alg₀.toSMul algLL'.toSMul alg₁.toSMul :=
      @IsScalarTower.of_algebraMap_eq' ↥L₀ ↥L ↥L' _ _ _ alg₀ algLL' alg₁
        (RingHom.ext fun _ => Subtype.ext rfl)
    have hScalarLL'k : @IsScalarTower ↥L ↥L' k algLL'.toSMul _ _ :=
      @IsScalarTower.of_algebraMap_eq' ↥L ↥L' k _ _ _ algLL' _ _ rfl
    dsimp only [IsFieldPullbackModel, weilBaseChangeOver, CategoryTheory.Over.mk_left,
      CategoryTheory.Over.mk_hom]
    intro p_L₁ p_L₂ p_L'₁ p_L'₂ ψ_L
      hp_L₁ hp_L₁_fst hp_L₂_fst hp_L'₁ hp_L'₁_fst hp_L'₂ hp_L'₂_fst hψ_comm
    let s₀L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L _ _ alg₀))
    let s₀L' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L' _ _ alg₁))
    let sLL' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L ↥L' _ _ algLL'))
    let sLk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L k))
    let sL'k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L' k))
    have hs₀ : sLL' ≫ s₀L = s₀L' := by
      dsimp [s₀L, s₀L', sLL']
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← @IsScalarTower.algebraMap_eq ↥L₀ ↥L ↥L' _ _ _ alg₀ algLL' alg₁ hScalar₀LL']
    have hsk : sL'k ≫ sLL' = sLk := by
      dsimp [sLL', sLk, sL'k]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← @IsScalarTower.algebraMap_eq ↥L ↥L' k _ _ _ algLL' _ _ hScalarLL'k]
    have hq₁_cond : CategoryTheory.Limits.pullback.fst Y₁.hom s₀L' ≫ Y₁.hom =
        (CategoryTheory.Limits.pullback.snd Y₁.hom s₀L' ≫ sLL') ≫ s₀L := by
      rw [CategoryTheory.Category.assoc, hs₀]
      exact CategoryTheory.Limits.pullback.condition
    let q₁ : CategoryTheory.Limits.pullback Y₁.hom s₀L' ⟶
        CategoryTheory.Limits.pullback Y₁.hom s₀L :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst Y₁.hom s₀L')
        (CategoryTheory.Limits.pullback.snd Y₁.hom s₀L' ≫ sLL')
        hq₁_cond
    have hpq₁ : p_L'₁ ≫ q₁ = p_L₁ := by
      dsimp [q₁]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hp_L'₁_fst, hp_L₁_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc]
        have hw' : p_L'₁ ≫ CategoryTheory.Limits.pullback.snd Y₁.hom s₀L' = W₁.hom ≫ sL'k :=
          hp_L'₁.w
        have hw : p_L₁ ≫ CategoryTheory.Limits.pullback.snd Y₁.hom s₀L = W₁.hom ≫ sLk :=
          hp_L₁.w
        rw [hw', CategoryTheory.Category.assoc, hsk, ← hw]
    have hψw : ψ_L.left ≫ CategoryTheory.Limits.pullback.snd Y₂.hom s₀L =
        CategoryTheory.Limits.pullback.snd Y₁.hom s₀L := CategoryTheory.Over.w ψ_L
    have hφ_cond : (q₁ ≫ ψ_L.left ≫ CategoryTheory.Limits.pullback.fst Y₂.hom s₀L) ≫ Y₂.hom =
        CategoryTheory.Limits.pullback.snd Y₁.hom s₀L' ≫ s₀L' := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc ψ_L.left,
        hψw]
      dsimp [q₁]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc, hs₀]
    let ψ_L'_left : CategoryTheory.Limits.pullback Y₁.hom s₀L' ⟶
        CategoryTheory.Limits.pullback Y₂.hom s₀L' :=
      CategoryTheory.Limits.pullback.lift
        (q₁ ≫ ψ_L.left ≫ CategoryTheory.Limits.pullback.fst Y₂.hom s₀L)
        (CategoryTheory.Limits.pullback.snd Y₁.hom s₀L')
        hφ_cond
    let ψ_L' : CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd Y₁.hom s₀L') ⟶
        CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd Y₂.hom s₀L') :=
      CategoryTheory.Over.homMk ψ_L'_left (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    refine ⟨ψ_L', ?_⟩
    change p_L'₁ ≫ ψ_L'_left = ψ_bar.left ≫ p_L'₂
    dsimp [ψ_L'_left]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc p_L'₁ q₁, hpq₁,
        ← CategoryTheory.Category.assoc p_L₁ ψ_L.left, hψ_comm,
        CategoryTheory.Category.assoc, hp_L₂_fst,
        CategoryTheory.Category.assoc, hp_L'₂_fst]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      have hw₁ : p_L'₁ ≫ CategoryTheory.Limits.pullback.snd Y₁.hom s₀L' = W₁.hom ≫ sL'k :=
        hp_L'₁.w
      have hw₂ : p_L'₂ ≫ CategoryTheory.Limits.pullback.snd Y₂.hom s₀L' = W₂.hom ≫ sL'k :=
        hp_L'₂.w
      rw [hw₁, CategoryTheory.Category.assoc, hw₂, ← CategoryTheory.Category.assoc,
        CategoryTheory.Over.w ψ_bar]

  
  have hTowerTransportOpen : ∀ (L L' : IntermediateField F k)
      (h₀ : L₀ ≤ L) (h₁ : L₀ ≤ L') (hLL' : L ≤ L')
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
      (W_X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p : W_X.left ⟶ Y.left)
      (U_b : W_X.left.Opens),
      let alg₀ : Algebra ↥L₀ ↥L := (IntermediateField.inclusion h₀).toRingHom.toAlgebra
      let alg₁ : Algebra ↥L₀ ↥L' := (IntermediateField.inclusion h₁).toRingHom.toAlgebra
      ∀ (p_L : W_X.left ⟶ (@weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y).left)
        (p_L' : W_X.left ⟶ (@weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y).left)
        (U_L : (@weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y).left.Opens),
        IsFieldPullbackModel ↥L k (@weilBaseChangeOver ↥L₀ ↥L _ _ alg₀ Y) W_X p_L →
        p_L ≫ CategoryTheory.Limits.pullback.fst Y.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L _ _ alg₀))) = p →
        IsFieldPullbackModel ↥L' k (@weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y) W_X p_L' →
        p_L' ≫ CategoryTheory.Limits.pullback.fst Y.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L' _ _ alg₁))) = p →
        (TopologicalSpace.Opens.map p_L.base).obj U_L = U_b →
        ∃ U_L' : (@weilBaseChangeOver ↥L₀ ↥L' _ _ alg₁ Y).left.Opens,
          (TopologicalSpace.Opens.map p_L'.base).obj U_L' = U_b := by
    intro L L' h₀ h₁ hLL' Y W_X p U_b alg₀ alg₁
    let algLL' : Algebra ↥L ↥L' := (IntermediateField.inclusion hLL').toRingHom.toAlgebra
    letI : Algebra ↥L₀ ↥L := alg₀
    letI : Algebra ↥L₀ ↥L' := alg₁
    letI : Algebra ↥L ↥L' := algLL'
    have hScalar₀LL' : @IsScalarTower ↥L₀ ↥L ↥L' alg₀.toSMul algLL'.toSMul alg₁.toSMul :=
      @IsScalarTower.of_algebraMap_eq' ↥L₀ ↥L ↥L' _ _ _ alg₀ algLL' alg₁
        (RingHom.ext fun _ => Subtype.ext rfl)
    have hScalarLL'k : @IsScalarTower ↥L ↥L' k algLL'.toSMul _ _ :=
      @IsScalarTower.of_algebraMap_eq' ↥L ↥L' k _ _ _ algLL' _ _ rfl
    dsimp only [IsFieldPullbackModel, weilBaseChangeOver, CategoryTheory.Over.mk_left,
      CategoryTheory.Over.mk_hom]
    intro p_L p_L' U_L hp_L hp_L_fst hp_L' hp_L'_fst hU_L
    let s₀L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L _ _ alg₀))
    let s₀L' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L₀ ↥L' _ _ alg₁))
    let sLL' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap ↥L ↥L' _ _ algLL'))
    let sLk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L k))
    let sL'k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L' k))
    have hs₀ : sLL' ≫ s₀L = s₀L' := by
      dsimp [s₀L, s₀L', sLL']
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← @IsScalarTower.algebraMap_eq ↥L₀ ↥L ↥L' _ _ _ alg₀ algLL' alg₁ hScalar₀LL']
    have hsk : sL'k ≫ sLL' = sLk := by
      dsimp [sLL', sLk, sL'k]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← @IsScalarTower.algebraMap_eq ↥L ↥L' k _ _ _ algLL' _ _ hScalarLL'k]
    have hq_cond : CategoryTheory.Limits.pullback.fst Y.hom s₀L' ≫ Y.hom =
        (CategoryTheory.Limits.pullback.snd Y.hom s₀L' ≫ sLL') ≫ s₀L := by
      rw [CategoryTheory.Category.assoc, hs₀]
      exact CategoryTheory.Limits.pullback.condition
    let q : CategoryTheory.Limits.pullback Y.hom s₀L' ⟶
        CategoryTheory.Limits.pullback Y.hom s₀L :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst Y.hom s₀L')
        (CategoryTheory.Limits.pullback.snd Y.hom s₀L' ≫ sLL')
        hq_cond
    have hpq : p_L' ≫ q = p_L := by
      dsimp [q]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hp_L'_fst, hp_L_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc]
        have hw' : p_L' ≫ CategoryTheory.Limits.pullback.snd Y.hom s₀L' = W_X.hom ≫ sL'k :=
          hp_L'.w
        have hw : p_L ≫ CategoryTheory.Limits.pullback.snd Y.hom s₀L = W_X.hom ≫ sLk :=
          hp_L.w
        rw [hw', CategoryTheory.Category.assoc, hsk, ← hw]
    refine ⟨(TopologicalSpace.Opens.map q.base).obj U_L, ?_⟩
    ext w
    change (p_L' ≫ q).base w ∈ U_L ↔ w ∈ U_b
    rw [hpq, ← hU_L]
    rfl

  
  have hFiniteSpecCover : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀))),
      CompactSpace ↥Y.left →
      AlgebraicGeometry.LocallyOfFiniteType Y.hom →
      ∃ (n : ℕ) (R : Fin n → Type u) (_ : ∀ a, CommRing (R a))
        (_ : ∀ a, Algebra ↥L₀ (R a)) (_ : ∀ a, Algebra.FiniteType ↥L₀ (R a))
        (ι₀ : ∀ a : Fin n, AlgebraicGeometry.Spec (CommRingCat.of (R a)) ⟶ Y.left)
        (hOpen : ∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι₀ a)),
        (∀ a : Fin n, ι₀ a ≫ Y.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ (R a)))) ∧
        (⨆ a : Fin n, @AlgebraicGeometry.Scheme.Hom.opensRange _ _ (ι₀ a) (hOpen a)) = ⊤ := by
    intro Y hCY hFTY
    haveI : CompactSpace ↥Y.left := hCY
    haveI : AlgebraicGeometry.LocallyOfFiniteType Y.hom := hFTY
    have hTopComp : IsCompact ((⊤ : Y.left.Opens) : Set ↥Y.left) := isCompact_univ
    obtain ⟨S, hS_fin, hTop_eq⟩ :=
      AlgebraicGeometry.isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hTopComp
    letI : Fintype ↥S := hS_fin.fintype
    let n : ℕ := Fintype.card ↥S
    let eS : Fin n ≃ ↥S := (Fintype.equivFin ↥S).symm
    let U : Fin n → Y.left.Opens := fun a => (eS a).1.1
    have hAff : ∀ a : Fin n, AlgebraicGeometry.IsAffineOpen (U a) := fun a => (eS a).1.2
    let R_cat : Fin n → CommRingCat.{u} := fun a => Y.left.presheaf.obj (Opposite.op (U a))
    let R : Fin n → Type u := fun a => ↥(R_cat a)
    let ι₀ : ∀ a : Fin n, AlgebraicGeometry.Spec (CommRingCat.of (R a)) ⟶ Y.left :=
      fun a => (hAff a).fromSpec
    have hOpen : ∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι₀ a) := fun a => by
      dsimp [ι₀]
      infer_instance
    let ρ : ∀ a : Fin n, CommRingCat.of ↥L₀ ⟶ CommRingCat.of (R a) :=
      fun a => AlgebraicGeometry.Spec.preimage (ι₀ a ≫ Y.hom)
    have hSpec_ρ : ∀ a : Fin n, AlgebraicGeometry.Spec.map (ρ a) = ι₀ a ≫ Y.hom :=
      fun a => AlgebraicGeometry.Spec.map_preimage _
    let algR : ∀ a : Fin n, Algebra ↥L₀ (R a) := fun a => (ρ a).hom.toAlgebra
    have hFT_R : ∀ a : Fin n, @Algebra.FiniteType ↥L₀ (R a) _ _ (algR a) := by
      intro a
      haveI : AlgebraicGeometry.IsOpenImmersion (ι₀ a) := hOpen a
      have hLFT_map : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map (ρ a)) := by
        rw [hSpec_ρ a]
        infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_map
    refine ⟨n, R, inferInstance, algR, hFT_R, ι₀, hOpen, ?_, ?_⟩
    · intro a
      have hρ_eq : CommRingCat.ofHom (@algebraMap ↥L₀ (R a) _ _ (algR a)) = ρ a := by
        ext x
        rfl
      rw [hρ_eq, hSpec_ρ a]
    · apply le_antisymm le_top
      intro y _
      have hy' : y ∈ (⨆ i ∈ S, (i : Y.left.Opens)) := by
        rw [← hTop_eq]
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hy' ⊢
      obtain ⟨u, hu⟩ := hy'
      rw [TopologicalSpace.Opens.mem_iSup] at hu
      obtain ⟨huS, hyu⟩ := hu
      refine ⟨eS.symm ⟨u, huS⟩, ?_⟩
      have h_range : @AlgebraicGeometry.Scheme.Hom.opensRange _ _
          (ι₀ (eS.symm ⟨u, huS⟩)) (hOpen _) = u.1 := by
        change (hAff (eS.symm ⟨u, huS⟩)).fromSpec.opensRange = u.1
        rw [(hAff _).opensRange_fromSpec]
        dsimp [U]
        rw [eS.apply_symm_apply]
      rwa [h_range]

  
  have hTensorChartPullback : ∀ (K_ext : Type u) [Field K_ext] [Algebra ↥L₀ K_ext]
      (R : Type u) [CommRing R] [Algebra ↥L₀ R]
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
      (W_X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K_ext)))
      (p : W_X.left ⟶ Y.left)
      (hp : IsFieldPullbackModel ↥L₀ K_ext Y W_X p)
      (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y.left)
      [AlgebraicGeometry.IsOpenImmersion ι₀],
      ι₀ ≫ Y.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ R)) →
      ∃ (ι_K : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥L₀ K_ext R)) ⟶ W_X.left)
        (hOpenK : AlgebraicGeometry.IsOpenImmersion ι_K),
        @AlgebraicGeometry.Scheme.Hom.opensRange _ _ ι_K hOpenK =
          (TopologicalSpace.Opens.map p.base).obj ι₀.opensRange ∧
        ι_K ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := K_ext) (B := R)).toRingHom) ≫ ι₀ ∧
        ι_K ≫ W_X.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := K_ext) (B := R))) := by
    intro K_ext _ _ R _ _ Y W_X p hp ι₀ _ hι₀
    let U : Y.left.Opens := ι₀.opensRange
    let U_K : W_X.left.Opens := (TopologicalSpace.Opens.map p.base).obj U
    let e₀ : AlgebraicGeometry.Spec (CommRingCat.of R) ≅ U.toScheme := ι₀.isoOpensRange
    let s_LK := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ K_ext))
    let s_LR := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ R))
    have hp_res : CategoryTheory.IsPullback (p ∣_ U) U_K.ι U.ι p :=
      AlgebraicGeometry.isPullback_morphismRestrict p U
    have hp_paste : CategoryTheory.IsPullback (p ∣_ U) (U_K.ι ≫ W_X.hom) (U.ι ≫ Y.hom) s_LK :=
      hp_res.paste_vert hp
    have he₀_fac : e₀.hom ≫ U.ι = ι₀ := AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι₀
    have he₀_inv_fac : e₀.inv ≫ ι₀ = U.ι := by
      rw [← he₀_fac, ← CategoryTheory.Category.assoc, e₀.inv_hom_id,
        CategoryTheory.Category.id_comp]
    have h_comm_geom : ((p ∣_ U) ≫ e₀.inv) ≫ s_LR = (U_K.ι ≫ W_X.hom) ≫ s_LK := by
      dsimp [s_LR]
      rw [← hι₀, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e₀.inv,
        he₀_inv_fac, ← CategoryTheory.Category.assoc]
      exact hp_paste.w
    have hp_geom : CategoryTheory.IsPullback
        ((p ∣_ U) ≫ e₀.inv) (U_K.ι ≫ W_X.hom) s_LR s_LK :=
      { w := h_comm_geom
        isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk h_comm_geom
          (fun c => hp_paste.lift (c.fst ≫ e₀.hom) c.snd (by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e₀.hom,
              he₀_fac, hι₀]
            exact c.condition))
          (fun c => by
            rw [← CategoryTheory.Category.assoc, hp_paste.lift_fst,
              CategoryTheory.Category.assoc, e₀.hom_inv_id, CategoryTheory.Category.comp_id])
          (fun c => hp_paste.lift_snd _ _ _)
          (fun c m hm₁ hm₂ => by
            apply hp_paste.hom_ext
            · rw [hp_paste.lift_fst]
              have hm₁' := congrArg (· ≫ e₀.hom) hm₁
              simpa only [CategoryTheory.Category.assoc, e₀.inv_hom_id,
                CategoryTheory.Category.comp_id] using hm₁'
            · rw [hp_paste.lift_snd]
              exact hm₂)⟩ }
    have hp_alg : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := K_ext) (B := R)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := K_ext) (B := R))))
        s_LR s_LK :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct ↥L₀ K_ext R)).flip
    let iso_K : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥L₀ K_ext R)) ≅
        U_K.toScheme :=
      CategoryTheory.IsPullback.isoIsPullback _ _ hp_alg hp_geom
    let ι_K := iso_K.hom ≫ U_K.ι
    have hOpenK : AlgebraicGeometry.IsOpenImmersion ι_K := by
      dsimp [ι_K]
      infer_instance
    refine ⟨ι_K, hOpenK, ?_, ?_, ?_⟩
    · ext w
      change w ∈ Set.range (iso_K.hom ≫ U_K.ι).base ↔ w ∈ (U_K : Set ↥W_X.left)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U_K]
      constructor
      · rintro ⟨z, rfl⟩
        exact ⟨iso_K.hom.base z, rfl⟩
      · rintro ⟨u_pt, rfl⟩
        refine ⟨iso_K.inv.base u_pt, ?_⟩
        have h_id : (iso_K.inv ≫ iso_K.hom).base u_pt = u_pt := by
          rw [iso_K.inv_hom_id]
          rfl
        change U_K.ι.base ((iso_K.inv ≫ iso_K.hom).base u_pt) = U_K.ι.base u_pt
        rw [h_id]
    · dsimp [ι_K]
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι p U,
        ← he₀_inv_fac, ← CategoryTheory.Category.assoc (p ∣_ U) e₀.inv ι₀,
        ← CategoryTheory.Category.assoc iso_K.hom]
      rw [CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hp_alg hp_geom]
      rfl
    · dsimp [ι_K]
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hp_alg hp_geom

  
  have hTensorChartTower : ∀ (L : IntermediateField F k) (hLE : L₀ ≤ L)
      (R : Type u) [CommRing R] [Algebra ↥L₀ R]
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
      (W_X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p : W_X.left ⟶ Y.left),
      letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
      let Y_L := weilBaseChangeOver ↥L₀ ↥L Y
      let q := CategoryTheory.Limits.pullback.fst Y.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L)))
      let ψ : TensorProduct ↥L₀ ↥L R →+* TensorProduct ↥L₀ k R :=
        (Algebra.TensorProduct.map
          ({ toRingHom := algebraMap ↥L k, commutes' := fun _ => rfl } : ↥L →ₐ[↥L₀] k)
          (AlgHom.id ↥L₀ R)).toRingHom
      ∀ (p_L : W_X.left ⟶ Y_L.left)
        (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y.left)
        (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥L₀ ↥L R)) ⟶ Y_L.left)
        (ι_k : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥L₀ k R)) ⟶ W_X.left)
        [AlgebraicGeometry.IsOpenImmersion ι₀]
        [AlgebraicGeometry.IsOpenImmersion ι₁]
        [AlgebraicGeometry.IsOpenImmersion ι_k],
        IsFieldPullbackModel ↥L k Y_L W_X p_L →
        p_L ≫ q = p →
        ι₁.opensRange = (TopologicalSpace.Opens.map q.base).obj ι₀.opensRange →
        ι_k.opensRange = (TopologicalSpace.Opens.map p.base).obj ι₀.opensRange →
        ι₁ ≫ q = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := ↥L) (B := R)).toRingHom) ≫ ι₀ →
        ι₁ ≫ Y_L.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := R))) →
        ι_k ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := k) (B := R)).toRingHom) ≫ ι₀ →
        ι_k ≫ W_X.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := k) (B := R))) →
        (ι_k ≫ p_L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι₁) ∧
        (ι_k.opensRange = (TopologicalSpace.Opens.map p_L.base).obj ι₁.opensRange) ∧
        (∀ (g₁ : TensorProduct ↥L₀ ↥L R) (g_k : TensorProduct ↥L₀ k R),
          ψ g₁ = g_k →
          p_L.base ⁻¹' (ι₁.base '' (_root_.PrimeSpectrum.basicOpen g₁).1) =
            ι_k.base '' (_root_.PrimeSpectrum.basicOpen g_k).1) := by
    intro L hLE R _ _ Y W_X p
    letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    haveI : IsScalarTower ↥L₀ ↥L k := IsScalarTower.of_algebraMap_eq' rfl
    intro Y_L q ψ p_L ι₀ ι₁ ι_k _ _ _ hp_L hp_q hRange₁ hRange_k hι₁_q hι₁_hom hιk_p hιk_hom
    have hψ_right : CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := ↥L) (B := R)).toRingHom ≫
        CommRingCat.ofHom ψ =
        CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := k) (B := R)).toRingHom := by
      ext x
      change Algebra.TensorProduct.map _ _ (1 ⊗ₜ[↥L₀] x) = 1 ⊗ₜ[↥L₀] x
      rw [Algebra.TensorProduct.map_tmul, map_one]
      rfl
    have hψ_left : CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := R)) ≫
        CommRingCat.ofHom ψ =
        CommRingCat.ofHom (algebraMap ↥L k) ≫ CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := k) (B := R)) := by
      ext x
      change Algebra.TensorProduct.map _ _ (x ⊗ₜ[↥L₀] 1) = (algebraMap ↥L k x) ⊗ₜ[↥L₀] 1
      rw [Algebra.TensorProduct.map_tmul]
      rfl
    have hcomm_chart : ι_k ≫ p_L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι₁ := by
      dsimp only [Y_L, q, IsFieldPullbackModel, weilBaseChangeOver, CategoryTheory.Over.mk_left,
        CategoryTheory.Over.mk_hom] at hp_L hp_q hι₁_q hι₁_hom p_L ι₁ ⊢
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hp_q, hιk_p,
          CategoryTheory.Category.assoc, hι₁_q, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, hψ_right]
      · have hw : p_L ≫ CategoryTheory.Limits.pullback.snd Y.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L))) =
            W_X.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L k)) := hp_L.w
        rw [CategoryTheory.Category.assoc, hw, ← CategoryTheory.Category.assoc, hιk_hom,
          CategoryTheory.Category.assoc, hι₁_hom,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hψ_left]
    have hRange_rel : ι_k.opensRange = (TopologicalSpace.Opens.map p_L.base).obj ι₁.opensRange := by
      ext w
      rw [hRange_k]
      change p.base w ∈ ι₀.opensRange ↔ p_L.base w ∈ ι₁.opensRange
      rw [hRange₁, ← hp_q]
      rfl
    refine ⟨hcomm_chart, hRange_rel, ?_⟩
    intro g₁ g_k hg_eq
    ext w
    constructor
    · rintro ⟨y, hy_basic, hy_eq⟩
      have hw_mem : w ∈ ι_k.opensRange := by
        rw [hRange_rel]
        exact ⟨y, hy_eq⟩
      obtain ⟨z, rfl⟩ := hw_mem
      have hz_comm : ι₁.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base z) =
          p_L.base (ι_k.base z) := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι₁).base z =
          (ι_k ≫ p_L).base z
        rw [hcomm_chart]
      have hz_eq_y : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base z = y :=
        ι₁.isOpenEmbedding.injective (hz_comm.trans hy_eq.symm)
      refine ⟨z, ?_, rfl⟩
      rw [← hg_eq]
      change ψ g₁ ∉ z.asIdeal
      have hy_not : g₁ ∉ y.asIdeal := hy_basic
      rwa [← hz_eq_y] at hy_not
    · rintro ⟨z, hz_basic, rfl⟩
      refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base z, ?_, ?_⟩
      · change g₁ ∉ (ψ ⁻¹' z.asIdeal)
        change ψ g₁ ∉ z.asIdeal
        rwa [hg_eq]
      · change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι₁).base z = (ι_k ≫ p_L).base z
        rw [hcomm_chart]

  
  have hLiftTensorFamily : ∀ (J : Type) [Finite J]
      (M : J → Type u) [∀ j, AddCommGroup (M j)] [∀ j, Module ↥L₀ (M j)]
      (x : ∀ j : J, TensorProduct ↥L₀ k (M j)),
      ∃ (L : IntermediateField F k) (hLE : L₀ ≤ L) (_ : FiniteDimensional F ↥L),
        letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
        let ι_lin : ↥L →ₗ[↥L₀] k :=
          { toFun := algebraMap ↥L k
            map_add' := map_add _
            map_smul' := fun _ _ => rfl }
        ∃ (x_L : ∀ j : J, TensorProduct ↥L₀ ↥L (M j)),
          ∀ j : J, LinearMap.rTensor (M j) ι_lin (x_L j) = x j := by
    intro J _ M _ _ x
    choose T hT using fun j : J => TensorProduct.exists_finset (R := ↥L₀) (x j)
    let S : Set k := ⋃ j : J, ((T j).image Prod.fst : Set k)
    have hS_fin : S.Finite := Set.finite_iUnion fun j => ((T j).image Prod.fst).finite_toSet
    haveI : Finite ↥S := hS_fin.to_subtype
    let L_adj : IntermediateField F k := IntermediateField.adjoin F S
    haveI : FiniteDimensional F ↥L_adj :=
      IntermediateField.finiteDimensional_adjoin fun z _ => Algebra.IsIntegral.isIntegral z
    let L : IntermediateField F k := L₀ ⊔ L_adj
    have hLE : L₀ ≤ L := le_sup_left
    have hLE_adj : L_adj ≤ L := le_sup_right
    haveI : FiniteDimensional F ↥L := IntermediateField.finiteDimensional_sup L₀ L_adj
    letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    let ι_lin : ↥L →ₗ[↥L₀] k :=
      { toFun := algebraMap ↥L k
        map_add' := map_add _
        map_smul' := fun _ _ => rfl }
    have hmem_L : ∀ (j : J) (q : ↥(T j)), q.1.1 ∈ L := by
      intro j q
      apply hLE_adj
      apply IntermediateField.subset_adjoin F S
      exact Set.mem_iUnion.mpr ⟨j, Finset.mem_coe.mpr (Finset.mem_image_of_mem Prod.fst q.2)⟩
    let x_L : ∀ j : J, TensorProduct ↥L₀ ↥L (M j) := fun j =>
      ∑ q ∈ (T j).attach,
        TensorProduct.tmul ↥L₀ (⟨q.1.1, hmem_L j q⟩ : ↥L) q.1.2
    refine ⟨L, hLE, inferInstance, x_L, ?_⟩
    intro j
    dsimp [x_L]
    rw [map_sum]
    conv_rhs => rw [hT j, ← Finset.sum_attach (s := T j)]
    refine Finset.sum_congr rfl fun q _ => ?_
    rfl

  
  have hSpreadSingleOpen : ∀ (i : Obj) (U_b : (W i).left.Opens),
      ∃ (L : IntermediateField F k) (hLE : L₀ ≤ L) (_ : FiniteDimensional F ↥L),
        letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
        ∃ (p_L : (W i).left ⟶ (weilBaseChangeOver ↥L₀ ↥L (Y₀ i)).left)
          (U_L : (weilBaseChangeOver ↥L₀ ↥L (Y₀ i)).left.Opens),
          IsFieldPullbackModel ↥L k (weilBaseChangeOver ↥L₀ ↥L (Y₀ i)) (W i) p_L ∧
          p_L ≫ CategoryTheory.Limits.pullback.fst (Y₀ i).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L))) = p₀ i ∧
          (TopologicalSpace.Opens.map p_L.base).obj U_L = U_b := by
    intro i U_b
    obtain ⟨s, R, hCommR, hAlgR, hFTR, e₀, hOpen₀, he₀_hom, he₀_sup⟩ :=
      hFiniteSpecCover (Y₀ i) (hComp i) (hLFT i)
    letI := hCommR
    letI := hAlgR
    letI := hFTR
    letI := hOpen₀
    choose j_k hOpen_jk hj_k_range hj_k_p hj_k_hom using fun b : Fin s =>
      hTensorChartPullback k (R b) (Y₀ i) (W i) (p₀ i) (hp₀ i) (e₀ b) (he₀_hom b)
    letI := hOpen_jk
    have hNoeth : ∀ b : Fin s, IsNoetherianRing (TensorProduct ↥L₀ k (R b)) := by
      intro b
      haveI : Algebra.FiniteType k (TensorProduct ↥L₀ k (R b)) := Algebra.FiniteType.baseChange k
      exact Algebra.FiniteType.isNoetherianRing k (TensorProduct ↥L₀ k (R b))
    let W_b : ∀ b : Fin s, TopologicalSpace.Opens (_root_.PrimeSpectrum (TensorProduct ↥L₀ k (R b))) :=
      fun b => (TopologicalSpace.Opens.map (j_k b).base).obj U_b
    have hBasicPres : ∀ b : Fin s,
        ∃ (m : ℕ) (g : Fin m → TensorProduct ↥L₀ k (R b)),
          (W_b b).1 = ⋃ ν : Fin m, (_root_.PrimeSpectrum.basicOpen (g ν)).1 := by
      intro b
      haveI := hNoeth b
      have hCompW : IsCompact (W_b b).1 :=
        TopologicalSpace.NoetherianSpace.isCompact _
      obtain ⟨ S_b, hSb_fin, hWb_eq ⟩ :=
        (TopologicalSpace.Opens.IsBasis.isCompact_open_iff_eq_finite_iUnion
          (_root_.PrimeSpectrum.basicOpen (R := TensorProduct ↥L₀ k (R b)))
          _root_.PrimeSpectrum.isBasis_basic_opens
          _root_.PrimeSpectrum.isCompact_basicOpen (W_b b).1).mp ⟨hCompW, (W_b b).isOpen⟩
      letI : Fintype ↥S_b := hSb_fin.fintype
      let m := Fintype.card ↥S_b
      let e_b : Fin m ≃ ↥S_b := (Fintype.equivFin ↥S_b).symm
      refine ⟨m, fun ν => (e_b ν).1, ?_⟩
      ext z
      rw [hWb_eq]
      simp only [Set.mem_iUnion]
      exact ⟨fun ⟨g₀, hg₀, hz⟩ => ⟨e_b.symm ⟨g₀, hg₀⟩, by simpa using hz⟩,
        fun ⟨ν, hz⟩ => ⟨(e_b ν).1, (e_b ν).2, hz⟩⟩
    choose m_b g_bar hg_bar_eq using hBasicPres
    let J_open := Σ b : Fin s, Fin (m_b b)
    obtain ⟨L, hLE, hFD_L, g₁, hg₁_map⟩ :=
      hLiftTensorFamily J_open (fun p => R p.1) (fun p => g_bar p.1 p.2)
    haveI : FiniteDimensional F ↥L := hFD_L
    letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    obtain ⟨p_L, hp_L_mod, hp_L_fst⟩ := hTowerLift L hLE (Y₀ i) (W i) (p₀ i) (hp₀ i)
    let Y_L := weilBaseChangeOver ↥L₀ ↥L (Y₀ i)
    let q_L := CategoryTheory.Limits.pullback.fst (Y₀ i).hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L)))
    have hq_L_mod : IsFieldPullbackModel ↥L₀ ↥L (Y₀ i) Y_L q_L :=
      CategoryTheory.IsPullback.of_hasPullback (Y₀ i).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L)))
    choose j_1 hOpen_j1 hj_1_range hj_1_q hj_1_hom using fun b : Fin s =>
      hTensorChartPullback ↥L (R b) (Y₀ i) Y_L q_L hq_L_mod (e₀ b) (he₀_hom b)
    letI := hOpen_j1
    have hPre_b : ∀ (b : Fin s) (ν : Fin (m_b b)),
        p_L.base ⁻¹' ((j_1 b).base '' (_root_.PrimeSpectrum.basicOpen (g₁ ⟨b, ν⟩)).1) =
          (j_k b).base '' (_root_.PrimeSpectrum.basicOpen (g_bar b ν)).1 := by
      intro b ν
      have hTower := hTensorChartTower L hLE (R b) (Y₀ i) (W i) (p₀ i) p_L (e₀ b) (j_1 b) (j_k b)
        hp_L_mod hp_L_fst (hj_1_range b) (hj_k_range b) (hj_1_q b) (hj_1_hom b)
        (hj_k_p b) (hj_k_hom b)
      exact hTower.2.2 (g₁ ⟨b, ν⟩) (g_bar b ν) (hg₁_map ⟨b, ν⟩)
    let U_piece : ∀ (b : Fin s) (ν : Fin (m_b b)), Y_L.left.Opens :=
      fun b ν => ⟨(j_1 b).base '' (_root_.PrimeSpectrum.basicOpen (g₁ ⟨b, ν⟩)).1,
        (j_1 b).isOpenEmbedding.isOpenMap _ (_root_.PrimeSpectrum.basicOpen _).isOpen⟩
    let U_L : Y_L.left.Opens := ⨆ (b : Fin s) (ν : Fin (m_b b)), U_piece b ν
    refine ⟨L, hLE, inferInstance, p_L, U_L, hp_L_mod, hp_L_fst, ?_⟩
    ext w
    change p_L.base w ∈ U_L ↔ w ∈ U_b
    simp only [U_L, TopologicalSpace.Opens.mem_iSup]
    constructor
    · rintro ⟨b, ν, hw_mem⟩
      have hw_pre : w ∈ p_L.base ⁻¹'
          ((j_1 b).base '' (_root_.PrimeSpectrum.basicOpen (g₁ ⟨b, ν⟩)).1) := hw_mem
      rw [hPre_b b ν] at hw_pre
      rcases hw_pre with ⟨z, hz_basic, rfl⟩
      have hz_W : z ∈ (W_b b).1 := by
        rw [hg_bar_eq b]
        exact Set.mem_iUnion.mpr ⟨ν, hz_basic⟩
      exact hz_W
    · intro hw_U
      have hw_top : (p₀ i).base w ∈ (⊤ : (Y₀ i).left.Opens) := trivial
      rw [← he₀_sup, TopologicalSpace.Opens.mem_iSup] at hw_top
      obtain ⟨b, hb_mem⟩ := hw_top
      have hw_jk : w ∈ (j_k b).opensRange := by
        rw [hj_k_range b]
        exact hb_mem
      obtain ⟨z, rfl⟩ := hw_jk
      let z' : _root_.PrimeSpectrum (TensorProduct ↥L₀ k (R b)) := z
      have hz_W : z' ∈ (W_b b).1 := hw_U
      rw [hg_bar_eq b, Set.mem_iUnion] at hz_W
      obtain ⟨ν, hz_basic⟩ := hz_W
      have hw_img : (j_k b).base z ∈
          (j_k b).base '' (_root_.PrimeSpectrum.basicOpen (g_bar b ν)).1 :=
        ⟨z, hz_basic, rfl⟩
      rw [← hPre_b b ν] at hw_img
      exact ⟨b, ν, hw_img⟩

  
  have hAlgDescentHoms : ∀ {r s : ℕ}
      (A : Fin r → Type u) [∀ a, CommRing (A a)] [∀ a, Algebra ↥L₀ (A a)]
      (B : Fin s → Type u) [∀ b, CommRing (B b)] [∀ b, Algebra ↥L₀ (B b)]
      [∀ b, Algebra.FiniteType ↥L₀ (B b)]
      (q : Fin r → Fin s → ℕ)
      (h_bar : ∀ (a : Fin r) (b : Fin s), Fin (q a b) → TensorProduct ↥L₀ k (A a)),
      (∀ a : Fin r,
        Ideal.span (Set.range fun p : Σ b : Fin s, Fin (q a b) => h_bar a p.1 p.2) = ⊤) →
      ∀ (θ_bar : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)),
          TensorProduct ↥L₀ k (B b) →+* Localization.Away (h_bar a b μ)),
      (∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)),
        (θ_bar a b μ).comp
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := k) (B := B b)) =
        (algebraMap (TensorProduct ↥L₀ k (A a)) (Localization.Away (h_bar a b μ))).comp
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := k) (B := A a))) →
      ∃ (L : IntermediateField F k) (hLE : L₀ ≤ L) (_ : FiniteDimensional F ↥L),
        letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
        let ψ_A := fun a : Fin r => (Algebra.TensorProduct.map
          ({ toRingHom := algebraMap ↥L k, commutes' := fun _ => rfl } : ↥L →ₐ[↥L₀] k)
          (AlgHom.id ↥L₀ (A a))).toRingHom
        let ψ_B := fun b : Fin s => (Algebra.TensorProduct.map
          ({ toRingHom := algebraMap ↥L k, commutes' := fun _ => rfl } : ↥L →ₐ[↥L₀] k)
          (AlgHom.id ↥L₀ (B b))).toRingHom
        ∃ (h₁ : ∀ (a : Fin r) (b : Fin s), Fin (q a b) → TensorProduct ↥L₀ ↥L (A a))
          (θ₁ : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)),
            TensorProduct ↥L₀ ↥L (B b) →+* Localization.Away (h₁ a b μ))
          (lam : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)),
            Localization.Away (h₁ a b μ) →+* Localization.Away (h_bar a b μ)),
          (∀ a b μ, ψ_A a (h₁ a b μ) = h_bar a b μ) ∧
          (∀ a : Fin r,
            Ideal.span (Set.range fun p : Σ b : Fin s, Fin (q a b) => h₁ a p.1 p.2) = ⊤) ∧
          (∀ a b μ,
            (θ₁ a b μ).comp
              (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := B b)) =
            (algebraMap (TensorProduct ↥L₀ ↥L (A a)) (Localization.Away (h₁ a b μ))).comp
              (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := A a))) ∧
          (∀ a b μ,
            (lam a b μ).comp
              (algebraMap (TensorProduct ↥L₀ ↥L (A a)) (Localization.Away (h₁ a b μ))) =
            (algebraMap (TensorProduct ↥L₀ k (A a)) (Localization.Away (h_bar a b μ))).comp
              (ψ_A a)) ∧
          (∀ a b μ, (lam a b μ).comp (θ₁ a b μ) = (θ_bar a b μ).comp (ψ_B b)) := by
    intro r s A _ _ B _ _ _ q h_bar hSpan_bar θ_bar hθ_bar_alg
    choose t_b π_B hπ_B_surj using fun b : Fin s =>
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := ↥L₀) (S := B b)).mp inferInstance
    let gen : ∀ b : Fin s, Fin (t_b b) → B b := fun b τ => π_B b (MvPolynomial.X τ)
    have hBezout_bar : ∀ a : Fin r,
        ∃ c : (Σ b : Fin s, Fin (q a b)) → TensorProduct ↥L₀ k (A a),
          (∑ p : Σ b : Fin s, Fin (q a b), c p * h_bar a p.1 p.2) = 1 := by
      intro a
      have h1 : (1 : TensorProduct ↥L₀ k (A a)) ∈
          Submodule.span (TensorProduct ↥L₀ k (A a))
            (Set.range fun p : Σ b : Fin s, Fin (q a b) => h_bar a p.1 p.2) := by
        change (1 : TensorProduct ↥L₀ k (A a)) ∈ Ideal.span _
        rw [hSpan_bar a]
        trivial
      obtain ⟨cf, hcf⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp h1
      refine ⟨fun p => cf p, ?_⟩
      rw [← hcf, Finsupp.sum_fintype cf (fun i a_1 => a_1 • h_bar a i.1 i.2)
        (fun i => zero_smul _ (h_bar a i.1 i.2))]
      rfl
    choose c_bar hc_bar using hBezout_bar
    have hSec_bar : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)) (τ : Fin (t_b b)),
        ∃ (w : TensorProduct ↥L₀ k (A a)) (n : ℕ),
          θ_bar a b μ (TensorProduct.tmul ↥L₀ 1 (gen b τ)) *
            algebraMap _ (Localization.Away (h_bar a b μ)) ((h_bar a b μ) ^ n) =
          algebraMap _ (Localization.Away (h_bar a b μ)) w := by
      intro a b μ τ
      obtain ⟨⟨w, s_pow⟩, hspec⟩ := IsLocalization.surj (Submonoid.powers (h_bar a b μ))
        (θ_bar a b μ (TensorProduct.tmul ↥L₀ 1 (gen b τ)))
      obtain ⟨n, hn⟩ := s_pow.2
      dsimp only at hn
      refine ⟨w, n, ?_⟩
      rw [hn]
      exact hspec
    choose w_bar n_exp hw_bar using hSec_bar
    let J_h := Σ a : Fin r, Σ b : Fin s, Fin (q a b)
    let J_w := Σ a : Fin r, Σ b : Fin s, Fin (q a b) × Fin (t_b b)
    let J_all := J_h ⊕ J_h ⊕ J_w
    let idxA : J_all → Fin r := fun idx => match idx with
      | Sum.inl p => p.1
      | Sum.inr (Sum.inl p) => p.1
      | Sum.inr (Sum.inr p) => p.1
    let M_all : J_all → Type u := fun idx => A (idxA idx)
    let x_all : ∀ idx : J_all, TensorProduct ↥L₀ k (M_all idx) := fun idx => match idx with
      | Sum.inl ⟨a, b, μ⟩ => h_bar a b μ
      | Sum.inr (Sum.inl ⟨a, b, μ⟩) => c_bar a ⟨b, μ⟩
      | Sum.inr (Sum.inr ⟨a, b, μ, τ⟩) => w_bar a b μ τ
    obtain ⟨L, hLE, hFD_L, x_L, hx_L⟩ := hLiftTensorFamily J_all M_all x_all
    haveI : FiniteDimensional F ↥L := hFD_L
    letI : Algebra ↥L₀ ↥L := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    haveI : IsScalarTower ↥L₀ ↥L k := IsScalarTower.of_algebraMap_eq' rfl
    let ι_alg : ↥L →ₐ[↥L₀] k := { toRingHom := algebraMap ↥L k, commutes' := fun _ => rfl }
    let ι_lin : ↥L →ₗ[↥L₀] k := ι_alg.toLinearMap
    let ψ_A : ∀ a : Fin r, TensorProduct ↥L₀ ↥L (A a) →+* TensorProduct ↥L₀ k (A a) :=
      fun a => (Algebra.TensorProduct.map ι_alg (AlgHom.id ↥L₀ (A a))).toRingHom
    let ψ_B : ∀ b : Fin s, TensorProduct ↥L₀ ↥L (B b) →+* TensorProduct ↥L₀ k (B b) :=
      fun b => (Algebra.TensorProduct.map ι_alg (AlgHom.id ↥L₀ (B b))).toRingHom
    have hψ_eq_rTensor : ∀ (a : Fin r) (z : TensorProduct ↥L₀ ↥L (A a)),
        ψ_A a z = LinearMap.rTensor (A a) ι_lin z := by
      intro a
      have hlin : (Algebra.TensorProduct.map ι_alg (AlgHom.id ↥L₀ (A a))).toLinearMap =
          LinearMap.rTensor (A a) ι_lin :=
        TensorProduct.ext' fun _ _ => rfl
      intro z
      exact LinearMap.congr_fun hlin z
    have hψ_inj : ∀ a : Fin r, Function.Injective (ψ_A a) := by
      intro a z₁ z₂ hz
      rw [hψ_eq_rTensor a z₁, hψ_eq_rTensor a z₂] at hz
      exact Module.Flat.rTensor_preserves_injective_linearMap (M := A a) ι_lin
        (RingHom.injective (algebraMap ↥L k)) hz
    let h₁ : ∀ (a : Fin r) (b : Fin s), Fin (q a b) → TensorProduct ↥L₀ ↥L (A a) :=
      fun a b μ => x_L (Sum.inl ⟨a, b, μ⟩)
    let c₁ : ∀ (a : Fin r), (Σ b : Fin s, Fin (q a b)) → TensorProduct ↥L₀ ↥L (A a) :=
      fun a p => x_L (Sum.inr (Sum.inl ⟨a, p.1, p.2⟩))
    let w₁ : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)), Fin (t_b b) → TensorProduct ↥L₀ ↥L (A a) :=
      fun a b μ τ => x_L (Sum.inr (Sum.inr ⟨a, b, μ, τ⟩))
    have hh₁ : ∀ a b μ, ψ_A a (h₁ a b μ) = h_bar a b μ := by
      intro a b μ
      rw [hψ_eq_rTensor]
      exact hx_L (Sum.inl ⟨a, b, μ⟩)
    have hc₁ : ∀ a p, ψ_A a (c₁ a p) = c_bar a p := by
      intro a p
      rw [hψ_eq_rTensor]
      exact hx_L (Sum.inr (Sum.inl ⟨a, p.1, p.2⟩))
    have hw₁ : ∀ a b μ τ, ψ_A a (w₁ a b μ τ) = w_bar a b μ τ := by
      intro a b μ τ
      rw [hψ_eq_rTensor]
      exact hx_L (Sum.inr (Sum.inr ⟨a, b, μ, τ⟩))
    have hSpan₁ : ∀ a : Fin r,
        Ideal.span (Set.range fun p : Σ b : Fin s, Fin (q a b) => h₁ a p.1 p.2) = ⊤ := by
      intro a
      have hsum₁ : (∑ p : Σ b : Fin s, Fin (q a b), c₁ a p * h₁ a p.1 p.2) = 1 := by
        apply hψ_inj a
        rw [map_sum, map_one, ← hc_bar a]
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [map_mul, hc₁ a p, hh₁ a p.1 p.2]
      apply Ideal.eq_top_of_isUnit_mem _ _ isUnit_one
      rw [← hsum₁]
      exact Submodule.sum_mem _ fun p _ =>
        Ideal.mul_mem_left _ (c₁ a p) (Ideal.subset_span ⟨p, rfl⟩)
    have hPowMap : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)),
        Submonoid.powers (h₁ a b μ) ≤
          Submonoid.comap (ψ_A a) (Submonoid.powers (h_bar a b μ)) := by
      rintro a b μ x hx
      obtain ⟨m, rfl⟩ := hx
      dsimp only
      rw [Submonoid.mem_comap, map_pow, hh₁ a b μ]
      exact pow_mem (Submonoid.mem_powers (h_bar a b μ)) m
    let lam : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)),
        Localization.Away (h₁ a b μ) →+* Localization.Away (h_bar a b μ) :=
      fun a b μ => IsLocalization.map (Localization.Away (h_bar a b μ)) (ψ_A a) (hPowMap a b μ)
    have hlam_comp : ∀ a b μ,
        (lam a b μ).comp (algebraMap (TensorProduct ↥L₀ ↥L (A a)) (Localization.Away (h₁ a b μ))) =
        (algebraMap (TensorProduct ↥L₀ k (A a)) (Localization.Away (h_bar a b μ))).comp (ψ_A a) :=
      fun a b μ => IsLocalization.map_comp (hPowMap a b μ)
    have hlam_inj : ∀ a b μ, Function.Injective (lam a b μ) := by
      intro a b μ
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨x, s_pow⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers (h₁ a b μ)) z
      have hlam_x : algebraMap _ (Localization.Away (h_bar a b μ)) (ψ_A a x) = 0 := by
        have h1 := congrArg (lam a b μ) hzs
        rw [map_mul, hz, zero_mul] at h1
        have h2 := RingHom.congr_fun (hlam_comp a b μ) x
        exact h2.symm.trans h1.symm
      obtain ⟨t_pow, ht_zero⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (h_bar a b μ))
          (Localization.Away (h_bar a b μ)) (ψ_A a x)).mp hlam_x
      obtain ⟨N, hN⟩ := t_pow.2
      dsimp only at hN
      have hx_kill : (h₁ a b μ) ^ N * x = 0 := by
        apply hψ_inj a
        rw [map_mul, map_pow, hh₁ a b μ, hN, map_zero]
        exact ht_zero
      have hloc_kill : algebraMap _ (Localization.Away (h₁ a b μ)) ((h₁ a b μ) ^ N) *
          (z * algebraMap _ (Localization.Away (h₁ a b μ)) s_pow.1) = 0 := by
        rw [hzs, ← map_mul, hx_kill, map_zero]
      have huN : IsUnit (algebraMap _ (Localization.Away (h₁ a b μ)) ((h₁ a b μ) ^ N)) :=
        IsLocalization.map_units (Localization.Away (h₁ a b μ))
          ⟨(h₁ a b μ) ^ N, pow_mem (Submonoid.mem_powers (h₁ a b μ)) N⟩
      have hus : IsUnit (algebraMap _ (Localization.Away (h₁ a b μ)) s_pow.1) :=
        IsLocalization.map_units (Localization.Away (h₁ a b μ)) s_pow
      have hzs0 : z * algebraMap _ (Localization.Away (h₁ a b μ)) s_pow.1 = 0 :=
        huN.mul_left_cancel (hloc_kill.trans (mul_zero _).symm)
      exact hus.mul_right_cancel (hzs0.trans (zero_mul _).symm)
    have hBuildθ₁ : ∀ (a : Fin r) (b : Fin s) (μ : Fin (q a b)),
        ∃ θ : TensorProduct ↥L₀ ↥L (B b) →+* Localization.Away (h₁ a b μ),
          θ.comp (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := B b)) =
            (algebraMap (TensorProduct ↥L₀ ↥L (A a)) (Localization.Away (h₁ a b μ))).comp
              (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := A a)) ∧
          (lam a b μ).comp θ = (θ_bar a b μ).comp (ψ_B b) := by
      intro a b μ
      let Loc₁ := Localization.Away (h₁ a b μ)
      let Loc_bar := Localization.Away (h_bar a b μ)
      let α₁ : ↥L →+* Loc₁ :=
        (algebraMap (TensorProduct ↥L₀ ↥L (A a)) Loc₁).comp
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := A a))
      let u₁ : Fin (t_b b) → Loc₁ := fun τ =>
        IsLocalization.mk' Loc₁ (w₁ a b μ τ)
          ⟨(h₁ a b μ) ^ (n_exp a b μ τ),
            pow_mem (Submonoid.mem_powers (h₁ a b μ)) (n_exp a b μ τ)⟩
      have hlam_u₁ : ∀ τ : Fin (t_b b),
          lam a b μ (u₁ τ) = θ_bar a b μ (TensorProduct.tmul ↥L₀ 1 (gen b τ)) := by
        intro τ
        have hmk := IsLocalization.mk'_spec'_mk Loc₁ (w₁ a b μ τ)
          ((h₁ a b μ) ^ (n_exp a b μ τ))
          (pow_mem (Submonoid.mem_powers (h₁ a b μ)) (n_exp a b μ τ))
        have h1 := congrArg (lam a b μ) hmk
        rw [map_mul] at h1
        have hc_w := RingHom.congr_fun (hlam_comp a b μ) (w₁ a b μ τ)
        have hc_h := RingHom.congr_fun (hlam_comp a b μ) ((h₁ a b μ) ^ (n_exp a b μ τ))
        change lam a b μ _ = algebraMap _ Loc_bar (ψ_A a (w₁ a b μ τ)) at hc_w
        change lam a b μ _ = algebraMap _ Loc_bar (ψ_A a ((h₁ a b μ) ^ (n_exp a b μ τ))) at hc_h
        rw [hw₁ a b μ τ] at hc_w
        rw [RingHom.map_pow (ψ_A a), hh₁ a b μ] at hc_h
        have h_eq : algebraMap _ Loc_bar ((h_bar a b μ) ^ (n_exp a b μ τ)) * lam a b μ (u₁ τ) =
            algebraMap _ Loc_bar ((h_bar a b μ) ^ (n_exp a b μ τ)) *
              θ_bar a b μ (TensorProduct.tmul ↥L₀ 1 (gen b τ)) := by
          rw [← hc_h, h1, hc_w, ← hw_bar a b μ τ, mul_comm, hc_h]
        have hu_bar : IsUnit (algebraMap _ Loc_bar ((h_bar a b μ) ^ (n_exp a b μ τ))) :=
          IsLocalization.map_units Loc_bar
            ⟨(h_bar a b μ) ^ (n_exp a b μ τ),
              pow_mem (Submonoid.mem_powers (h_bar a b μ)) (n_exp a b μ τ)⟩
        exact hu_bar.mul_left_cancel h_eq
      let θ_poly : MvPolynomial (Fin (t_b b)) ↥L₀ →+* Loc₁ :=
        MvPolynomial.eval₂Hom (α₁.comp (algebraMap ↥L₀ ↥L)) u₁
      have hlam_poly : (lam a b μ).comp θ_poly =
          (θ_bar a b μ).comp
            ((Algebra.TensorProduct.includeRight (R := ↥L₀) (A := k) (B := B b)).toRingHom.comp
              (π_B b).toRingHom) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [θ_poly, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, α₁]
          have h1 := RingHom.congr_fun (hlam_comp a b μ)
            (Algebra.TensorProduct.includeLeftRingHom (algebraMap ↥L₀ ↥L c))
          simp only [RingHom.comp_apply] at h1
          rw [h1]
          have hleft : ψ_A a (Algebra.TensorProduct.includeLeftRingHom (algebraMap ↥L₀ ↥L c)) =
              Algebra.TensorProduct.includeLeftRingHom (algebraMap ↥L₀ k c) := by
            change Algebra.TensorProduct.map _ _ ((algebraMap ↥L₀ ↥L c) ⊗ₜ[↥L₀] 1) =
              (algebraMap ↥L₀ k c) ⊗ₜ[↥L₀] 1
            rw [Algebra.TensorProduct.map_tmul]
            change (algebraMap ↥L k (algebraMap ↥L₀ ↥L c)) ⊗ₜ[↥L₀] (1 : A a) = _
            rw [← IsScalarTower.algebraMap_apply ↥L₀ ↥L k c]
          rw [hleft]
          have h2 := RingHom.congr_fun (hθ_bar_alg a b μ) (algebraMap ↥L₀ k c)
          simp only [RingHom.comp_apply] at h2
          rw [← h2]
          congr 1
          have hπc : (π_B b).toRingHom (MvPolynomial.C c) = algebraMap ↥L₀ (B b) c :=
            (π_B b).commutes c
          rw [hπc]
          change TensorProduct.tmul ↥L₀ (algebraMap ↥L₀ k c) (1 : B b) =
            TensorProduct.tmul ↥L₀ (1 : k) (algebraMap ↥L₀ (B b) c)
          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul]
        · intro τ
          simp only [θ_poly, RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
          exact hlam_u₁ τ
      have hker_poly : ∀ y ∈ RingHom.ker (π_B b).toRingHom, θ_poly y = 0 := by
        intro y hy
        apply hlam_inj a b μ
        have hy0 : (π_B b).toRingHom y = 0 := hy
        have h1 := RingHom.congr_fun hlam_poly y
        simp only [RingHom.comp_apply, hy0, map_zero] at h1
        rw [h1, map_zero]
      let e_ker := RingHom.quotientKerEquivOfSurjective (f := (π_B b).toRingHom) (hπ_B_surj b)
      let θ_B : B b →+* Loc₁ :=
        (Ideal.Quotient.lift (RingHom.ker (π_B b).toRingHom) θ_poly hker_poly).comp
          e_ker.symm.toRingHom
      have hθ_B_π : ∀ P : MvPolynomial (Fin (t_b b)) ↥L₀, θ_B (π_B b P) = θ_poly P := by
        intro P
        have he : e_ker.symm ((π_B b).toRingHom P) =
            Ideal.Quotient.mk (RingHom.ker (π_B b).toRingHom) P := by
          apply e_ker.injective
          rw [e_ker.apply_symm_apply]
          rfl
        change Ideal.Quotient.lift _ θ_poly hker_poly (e_ker.symm ((π_B b).toRingHom P)) = _
        rw [he]
        rfl
      have h_push_comm : CommRingCat.ofHom (algebraMap ↥L₀ ↥L) ≫ CommRingCat.ofHom α₁ =
          CommRingCat.ofHom (algebraMap ↥L₀ (B b)) ≫ CommRingCat.ofHom θ_B := by
        ext c
        change α₁ (algebraMap ↥L₀ ↥L c) = θ_B (algebraMap ↥L₀ (B b) c)
        have hπc : π_B b (MvPolynomial.C c) = algebraMap ↥L₀ (B b) c := (π_B b).commutes c
        rw [← hπc, hθ_B_π]
        simp [θ_poly]
      let hp_push := CommRingCat.isPushout_tensorProduct ↥L₀ ↥L (B b)
      let θ_cat := hp_push.desc (CommRingCat.ofHom α₁) (CommRingCat.ofHom θ_B) h_push_comm
      let θ : TensorProduct ↥L₀ ↥L (B b) →+* Loc₁ := θ_cat.hom
      have hθ_left : θ.comp
          (Algebra.TensorProduct.includeLeftRingHom (R := ↥L₀) (A := ↥L) (B := B b)) = α₁ := by
        have h_inl := hp_push.inl_desc (CommRingCat.ofHom α₁) (CommRingCat.ofHom θ_B) h_push_comm
        ext x
        exact congrArg (fun φ => φ.hom x) h_inl
      have hθ_right : θ.comp
          (Algebra.TensorProduct.includeRight (R := ↥L₀) (A := ↥L) (B := B b)).toRingHom = θ_B := by
        have h_inr := hp_push.inr_desc (CommRingCat.ofHom α₁) (CommRingCat.ofHom θ_B) h_push_comm
        ext x
        exact congrArg (fun φ => φ.hom x) h_inr
      refine ⟨θ, hθ_left, ?_⟩
      have h_cat_eq : CommRingCat.ofHom ((lam a b μ).comp θ) =
          CommRingCat.ofHom ((θ_bar a b μ).comp (ψ_B b)) := by
        apply hp_push.hom_ext
        · ext x
          change lam a b μ (θ (Algebra.TensorProduct.includeLeftRingHom x)) =
            θ_bar a b μ (ψ_B b (Algebra.TensorProduct.includeLeftRingHom x))
          have hx1 := RingHom.congr_fun hθ_left x
          simp only [RingHom.comp_apply] at hx1
          rw [hx1]
          dsimp [α₁]
          have hx2 := RingHom.congr_fun (hlam_comp a b μ)
            (Algebra.TensorProduct.includeLeftRingHom x)
          simp only [RingHom.comp_apply] at hx2
          rw [hx2]
          have hψL_A : ψ_A a (Algebra.TensorProduct.includeLeftRingHom x) =
              Algebra.TensorProduct.includeLeftRingHom (algebraMap ↥L k x) :=
            Algebra.TensorProduct.map_tmul _ _ _ _
          have hψL_B : ψ_B b (Algebra.TensorProduct.includeLeftRingHom x) =
              Algebra.TensorProduct.includeLeftRingHom (algebraMap ↥L k x) :=
            Algebra.TensorProduct.map_tmul _ _ _ _
          rw [hψL_A, hψL_B]
          exact (RingHom.congr_fun (hθ_bar_alg a b μ) (algebraMap ↥L k x)).symm
        · ext y
          obtain ⟨P, rfl⟩ := hπ_B_surj b y
          change lam a b μ (θ ((Algebra.TensorProduct.includeRight (R := ↥L₀) (A := ↥L) (B := B b)).toRingHom (π_B b P))) =
