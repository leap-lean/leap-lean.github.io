    obtain ⟨e_bc₀⟩ := hBC_ν ℳ₀ hTor_M₀
    have hZero_TU₂_R0M₀ : CategoryTheory.Limits.IsZero
        (T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ₀)) :=
      CategoryTheory.Limits.IsZero.of_iso ((hDir0Props ν (T_U' ℳ₀)).1 hZero_TU'M₀) e_bc₀.symm
    obtain ⟨i₀, r₀_ret, hRet₀⟩ :=
      hTU₂_retract ℒ₀ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ₀) ⟨i_L₀, r_L₀, hRet_L₀⟩
    have hZero_TU₂L₀ : CategoryTheory.Limits.IsZero (T_U₂ ℒ₀) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← hRet₀,
        hZero_TU₂_R0M₀.eq_of_tgt i₀ 0, CategoryTheory.Limits.zero_comp]
    have hZero_R0_TU₂L₀ : CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage iY₀ 0 (T_U₂ ℒ₀)) :=
      (hDir0Props iY₀ (T_U₂ ℒ₀)).1 hZero_TU₂L₀
    obtain ⟨S_Fl, hSFl_ex, hSFl_X₁, hSFl_X₂, hSFl_X₃⟩ :=
      hExc_A₁ (weilEtaleTorsionSheaf A₁.left ℓ) (weilEtaleTorsionSheaf Z_bad ℓ) ℒ₀
        (hConstrTorsion A₁.left) (hVacTop (weilEtaleTorsionSheaf A₁.left ℓ))
        (hPullConst iC_bad A_ℓ) (hPullConst (U₂.ι ≫ iY₀) A_ℓ)
    have hZero_SFlX₁ : CategoryTheory.Limits.IsZero S_Fl.X₁ := hSFl_X₁ ▸ hZero_R0_TU₂L₀
    have hf0_Fl : S_Fl.f = 0 := hZero_SFlX₁.eq_of_src S_Fl.f 0
    have : CategoryTheory.Mono S_Fl.g := hSFl_ex.exact.mono_g_iff.mpr hf0_Fl
    have : CategoryTheory.Epi S_Fl.g := hSFl_ex.epi_g
    have hIso_gFl : CategoryTheory.IsIso S_Fl.g :=
      CategoryTheory.isIso_of_mono_of_epi S_Fl.g
    let e_Fl_bad : weilEtaleTorsionSheaf A₁.left ℓ ≅
        weilEtaleHigherDirectImage iC_bad 0 (weilEtaleTorsionSheaf Z_bad ℓ) :=
      (CategoryTheory.eqToIso hSFl_X₂).symm ≪≫
        @CategoryTheory.asIso _ _ _ _ S_Fl.g hIso_gFl ≪≫
        CategoryTheory.eqToIso hSFl_X₃
    exact hNonIso_bad A₁ C_bad hC_bad_ne ⟨e_Fl_bad⟩

  
  have hDimW' : topologicalKrullDim W' ≤ (0 : WithBot ℕ∞) := hW'_drop W' iW' hClW' hNotIsoW'
  have : AlgebraicGeometry.IsClosedImmersion iW' := hClW'
  let W'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (iW' ≫ Y'_ov.hom)
  have : AlgebraicGeometry.LocallyOfFiniteType W'_ov.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType (iW' ≫ Y'_ov.hom)
    infer_instance
  have : AlgebraicGeometry.QuasiCompact W'_ov.hom := by
    change AlgebraicGeometry.QuasiCompact (iW' ≫ Y'_ov.hom)
    infer_instance
  have hSub_W'_r₀ : Subsingleton ((weilEtaleTorsionSheaf W' ℓ).H r₀) :=
    hZeroDim W'_ov hDimW' (weilEtaleTorsionSheaf W' ℓ) r₀ hr₀_ge
  let iW'_ov : W'_ov ⟶ Y'_ov := CategoryTheory.Over.homMk iW' rfl
  have hAcyc_iW' : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage iW' (b + 1) (weilEtaleTorsionSheaf W' ℓ)) :=
    hFinAcyclic W'_ov Y'_ov iW'_ov (show AlgebraicGeometry.IsFinite iW' from inferInstance)
      (weilEtaleTorsionSheaf W' ℓ) (hTorConst W')
  have hSub_S₀X₃_r₀ : Subsingleton (S₀.X₃.H r₀) := by
    rw [hS₀_X₃]
    exact ((hDir0Props iW' (weilEtaleTorsionSheaf W' ℓ)).2 hAcyc_iW' r₀ hSub_W'_r₀).1
  have hSub_S₀X₂_r₀1 : Subsingleton (S₀.X₂.H (r₀ + 1)) := by
    rw [hS₀_X₂, hr₀_eq]
    exact hVanishConstY'
  have hVanishTU'_Fl : Subsingleton ((T_U' (weilEtaleTorsionSheaf U'.toScheme ℓ)).H q) := by
    have h1 := ((hExtProps Y').2.2.2 S₀ hS₀_ex).2.2 r₀ hSub_S₀X₃_r₀ hSub_S₀X₂_r₀1
    rwa [hS₀_X₁, hr₀_eq] at h1

  
  obtain ⟨ℒ, hPull_L, hTor_L_imp, -⟩ := hPullEx (U₂.ι ≫ iY₀) ℬ
  have hTor_L : ℓ • CategoryTheory.CategoryStruct.id ℒ = 0 := hTor_L_imp hTorℬ
  obtain ⟨F_bad₀, hPull_bad, hTor_bad_imp, -⟩ := hPullEx iC_bad ℬ
  have hTor_bad : ℓ • CategoryTheory.CategoryStruct.id F_bad₀ = 0 := hTor_bad_imp hTorℬ

  have hPull_q₀_ℬ : WeilIsEtaleSheafPullback (q₀ ≫ (p₀ ≫ (U₀.ι ≫ iY₀))) ℬ
      ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
    (hPullComp q₀ (p₀ ≫ (U₀.ι ≫ iY₀)) ℬ _ _).1 hPull_p₀ (hPullConst q₀ A)
  have hMor_eq : (π' ≫ (ν ∣_ U₂)) ≫ (U₂.ι ≫ iY₀) = q₀ ≫ (p₀ ≫ (U₀.ι ≫ iY₀)) := by
    calc
      (π' ≫ (ν ∣_ U₂)) ≫ (U₂.ι ≫ iY₀) = ((π' ≫ (ν ∣_ U₂)) ≫ U₂.ι) ≫ iY₀ :=
        (CategoryTheory.Category.assoc _ _ _).symm
      _ = (q₀ ≫ p₀ ≫ U₀.ι) ≫ iY₀ := by rw [hComm_q₀]
      _ = q₀ ≫ (p₀ ≫ (U₀.ι ≫ iY₀)) := by simp only [CategoryTheory.Category.assoc]
  have hPull_comp_ℬ : WeilIsEtaleSheafPullback ((π' ≫ (ν ∣_ U₂)) ≫ (U₂.ι ≫ iY₀)) ℬ
      ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    rwa [hMor_eq]
  have hTriv_L : WeilIsEtaleSheafPullback (π' ≫ (ν ∣_ U₂)) ℒ
      ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
    (hPullComp (π' ≫ (ν ∣_ U₂)) (U₂.ι ≫ iY₀) ℬ ℒ _).2 hPull_L hPull_comp_ℬ

  obtain ⟨ℳ, m, 𝒩, hPull_ℳ, ⟨i_L, r_L, hRet_L⟩, hN_0, hN_m, hN_step⟩ :=
    weil_etale_sylow_trace_retract_and_pgroup_filtration ℓ
      U₂.toScheme U'.toScheme U'' (ν ∣_ U₂) π'
      hEt_νU₂ hSurj_νU₂ hIntU'' hEt_π' hSurj_π'
      I_G S_idx H hCoprime hPGrp actG secS γ_G hSec hPerm hγG hCovG
      actH γ_H hActH_hom hActH_one hActH_mul hγH hCovH
      A hFinA hTorA ℒ hTor_L hTriv_L

  
  have hSub_filt : ∀ idx : Fin (m + 1), Subsingleton ((T_U' (𝒩 idx)).H q) := by
    intro idx
    induction idx using Fin.induction with
    | zero =>
      exact (hExtProps Y').1 (T_U' (𝒩 0)) q ((hTU'_basic (𝒩 0) (𝒩 0)).1 hN_0)
    | succ r ih =>
      obtain ⟨S_r, hSr_ex, hSr_X₁, hSr_X₂, hSr_X₃⟩ := hN_step r
      obtain ⟨S'_r, hS'r_ex, hS'r_X₁, hS'r_X₂, hS'r_X₃⟩ := hTU'_exact S_r hSr_ex
      have hSub1 : Subsingleton (S'_r.X₁.H q) := by rw [hS'r_X₁, hSr_X₁]; exact ih
      have hSub3 : Subsingleton (S'_r.X₃.H q) := by
        rw [hS'r_X₃, hSr_X₃]; exact hVanishTU'_Fl
      have hSub2 : Subsingleton (S'_r.X₂.H q) :=
        ((hExtProps Y').2.2.2 S'_r hS'r_ex).2.1 q hSub1 hSub3
      rwa [hS'r_X₂, hSr_X₂] at hSub2
  have hSub_TU'M : Subsingleton ((T_U' ℳ).H q) :=
    (hExtProps Y').2.2.1 q
      ((hTU'_basic ℳ (𝒩 (Fin.last m))).2.2 ⟨hN_m.some.symm⟩)
      (hSub_filt (Fin.last m))

  
  have hTor_M : ℓ • CategoryTheory.CategoryStruct.id ℳ = 0 :=
    hTorOfPull (ν ∣_ U₂) ℒ ℳ hTor_L hPull_ℳ
  have hTor_TU'M : ℓ • CategoryTheory.CategoryStruct.id (T_U' ℳ) = 0 :=
    (hTU'_basic ℳ ℳ).2.1 hTor_M
  let Y₀_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (iY₀ ≫ A₁.hom)
  have : AlgebraicGeometry.LocallyOfFiniteType Y₀_ov.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType (iY₀ ≫ A₁.hom)
    infer_instance
  let ν_ov : Y'_ov ⟶ Y₀_ov :=
    CategoryTheory.Over.homMk ν (CategoryTheory.Category.assoc _ _ _).symm
  have hAcyc_ν : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage ν (b + 1) (T_U' ℳ)) :=
    hFinAcyclic Y'_ov Y₀_ov ν_ov hFin_ν (T_U' ℳ) hTor_TU'M
  have hSub_R0_TU'M : Subsingleton ((weilEtaleHigherDirectImage ν 0 (T_U' ℳ)).H q) :=
    ((hDir0Props ν (T_U' ℳ)).2 hAcyc_ν q hSub_TU'M).1
  obtain ⟨e_bc⟩ := hBC_ν ℳ hTor_M
  have hSub_TU₂_R0M : Subsingleton
      ((T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ)).H q) :=
    (hExtProps Y₀).2.2.1 q ⟨e_bc.symm⟩ hSub_R0_TU'M
  have hTor_R0_TU'M : ℓ • CategoryTheory.CategoryStruct.id
      (weilEtaleHigherDirectImage ν 0 (T_U' ℳ)) = 0 :=
    hTorPush Y' Y₀ ν 0 (T_U' ℳ) hTor_TU'M
  have hTor_TU₂_R0M : ℓ • CategoryTheory.CategoryStruct.id
      (T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ)) = 0 :=
    hTorOfIso ⟨e_bc.symm⟩ hTor_R0_TU'M
  obtain ⟨i₀_L, r₀_L, hRet_TU₂L⟩ :=
    hTU₂_retract ℒ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ) ⟨i_L, r_L, hRet_L⟩
  have hSub_TU₂L : Subsingleton ((T_U₂ ℒ).H q) :=
    (hExtProps Y₀).2.1 i₀_L r₀_L q hRet_TU₂L hSub_TU₂_R0M
  have hTor_TU₂L : ℓ • CategoryTheory.CategoryStruct.id (T_U₂ ℒ) = 0 := by
    calc
      ℓ • CategoryTheory.CategoryStruct.id (T_U₂ ℒ)
          = ℓ • (i₀_L ≫ 𝟙 _ ≫ r₀_L) := by
            rw [CategoryTheory.Category.id_comp, hRet_TU₂L]
      _ = i₀_L ≫ (ℓ • 𝟙 _) ≫ r₀_L := by
            rw [← CategoryTheory.Preadditive.comp_nsmul,
              ← CategoryTheory.Preadditive.nsmul_comp]
      _ = 0 := by
            rw [hTor_TU₂_R0M, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  
  let iY₀_ov : Y₀_ov ⟶ A₁ := CategoryTheory.Over.homMk iY₀ rfl
  have hAcyc_iY₀ : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage iY₀ (b + 1) (T_U₂ ℒ)) :=
    hFinAcyclic Y₀_ov A₁ iY₀_ov (show AlgebraicGeometry.IsFinite iY₀ from inferInstance)
      (T_U₂ ℒ) hTor_TU₂L
  have hSub_R0_TU₂L : Subsingleton ((weilEtaleHigherDirectImage iY₀ 0 (T_U₂ ℒ)).H q) :=
    ((hDir0Props iY₀ (T_U₂ ℒ)).2 hAcyc_iY₀ q hSub_TU₂L).1

  let Z_bad_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (iC_bad ≫ A₁.hom)
  have : AlgebraicGeometry.LocallyOfFiniteType Z_bad_ov.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType (iC_bad ≫ A₁.hom)
    infer_instance
  have : AlgebraicGeometry.QuasiCompact Z_bad_ov.hom := by
    change AlgebraicGeometry.QuasiCompact (iC_bad ≫ A₁.hom)
    infer_instance
  have hSub_Fbad : Subsingleton (F_bad₀.H q) :=
    hZeroDim Z_bad_ov hDim_bad F_bad₀ q hq_ge
  let iC_bad_ov : Z_bad_ov ⟶ A₁ := CategoryTheory.Over.homMk iC_bad rfl
  have hAcyc_iCbad : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage iC_bad (b + 1) F_bad₀) :=
    hFinAcyclic Z_bad_ov A₁ iC_bad_ov (show AlgebraicGeometry.IsFinite iC_bad from inferInstance)
      F_bad₀ hTor_bad
  have hSub_R0_Fbad : Subsingleton ((weilEtaleHigherDirectImage iC_bad 0 F_bad₀).H q) :=
    ((hDir0Props iC_bad F_bad₀).2 hAcyc_iCbad q hSub_Fbad).1

  obtain ⟨S_F, hSF_ex, hSF_X₁, hSF_X₂, hSF_X₃⟩ :=
    hExc_A₁ ℬ F_bad₀ ℒ ⟨hTorℬ, hGenℬ⟩ (hVacTop ℬ) hPull_bad hPull_L
  have hSub_SF_X₁ : Subsingleton (S_F.X₁.H q) := hSF_X₁.symm ▸ hSub_R0_TU₂L
  have hSub_SF_X₃ : Subsingleton (S_F.X₃.H q) := hSF_X₃.symm ▸ hSub_R0_Fbad
  have hSub_SF_X₂ : Subsingleton (S_F.X₂.H q) :=
    ((hExtProps A₁.left).2.2.2 S_F hSF_ex).2.1 q hSub_SF_X₁ hSub_SF_X₃
  rwa [hSF_X₂] at hSub_SF_X₂

theorem weil_aff_cd_noether_proj_and_sepClosure_etale_colimit (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ) (hm : 1 ≤ m)
    (y : ↥(weilAffineSpaceOver k m).left)
    (κ : Type u) [Field κ] [IsAlgClosed κ]
    (ev : MvPolynomial (Fin m) k →+* κ)
    (hker : RingHom.ker ev = y.asIdeal)
    (halg : ∀ z : κ, ∃ P : Polynomial (MvPolynomial (Fin m) k),
      Polynomial.map ev P ≠ 0 ∧ Polynomial.eval₂ ev z P = 0) :
    ∃ (c : ℕ) (_ : c ≤ m)
      (ψ : MvPolynomial (Fin c) k →ₐ[k] MvPolynomial (Fin m) k)
      (K_sep : Type u) (_ : Field K_sep) (_ : Algebra K_sep κ)
      (_ : IsPurelyInseparable K_sep κ)
      (φ_sep : MvPolynomial (Fin c) k →+* K_sep)
      (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
      (D : CategoryTheory.Functor ℐ CommRingCat.{u})
      (α_D : Quiver.Hom
        ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (MvPolynomial (Fin c) k))) D)
      (colim_c : CategoryTheory.Limits.Cocone D)
      (_ : CategoryTheory.Limits.IsColimit colim_c)
      (e_pt : CategoryTheory.Iso colim_c.pt (CommRingCat.of K_sep)),
      topologicalKrullDim
        ↥(closure ({y} : Set ↥(weilAffineSpaceOver k m).left)) =
          (c : WithBot ℕ∞) ∧
      (algebraMap K_sep κ).comp φ_sep = ev.comp ψ.toRingHom ∧
      (∀ i : ℐ, (CommRingCat.Hom.hom (α_D.app i)).Etale) ∧
      (∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α_D.app i)
        (CategoryTheory.CategoryStruct.comp (colim_c.ι.app i) e_pt.hom) =
          CommRingCat.ofHom φ_sep) ∧
      (c = m →
        ∀ (C₀ B_κ : Type u) [CommRing C₀] [CommRing B_κ]
          (f_C₀ : MvPolynomial (Fin m) k →+* C₀)
          (j_κ : κ →+* B_κ) (ι_C₀ : C₀ →+* B_κ),
          f_C₀.Etale →
          CategoryTheory.IsPushout
            (CommRingCat.ofHom (ev.comp ψ.toRingHom))
            (CommRingCat.ofHom (f_C₀.comp ψ.toRingHom))
            (CommRingCat.ofHom j_κ) (CommRingCat.ofHom ι_C₀) →
          AlgebraicGeometry.LocallyOfFiniteType
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.C.comp j_κ))) ∧
          topologicalKrullDim
            (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B_κ))) ≤
              (1 : WithBot ℕ∞)) ∧
      (c < m →
        ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra κ R₁)
          (_ : Algebra.FiniteType κ R₁)
          (σ : R₁ →ₐ[κ] κ) (ι_Pm : MvPolynomial (Fin m) k →+* R₁),
          ringKrullDim R₁ ≤ ((m - c : ℕ) : WithBot ℕ∞) ∧
          σ.toRingHom.comp ι_Pm = ev ∧
          CategoryTheory.IsPushout
            (CommRingCat.ofHom (ev.comp ψ.toRingHom))
            (CommRingCat.ofHom ψ.toRingHom)
            (CommRingCat.ofHom (algebraMap κ R₁))
            (CommRingCat.ofHom ι_Pm)) :=
by
  classical
  
  
  
  have hKrullLe_of_isIntegral : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (f : A →+* B), f.IsIntegral → ringKrullDim B ≤ ringKrullDim A := by
    intro A B _ _ f hf
    have hStrict : StrictMono (PrimeSpectrum.comap f) := by
      intro q₁ q₂ hlt
      have hle : PrimeSpectrum.comap f q₁ ≤ PrimeSpectrum.comap f q₂ :=
        fun _ ha => hlt.le ha
      apply lt_of_le_of_ne hle
      intro heq
      have hsub_lt : q₁.asIdeal < q₂.asIdeal := hlt
      obtain ⟨b, hb₂, hb₁⟩ := SetLike.exists_of_lt hsub_lt
      have h1_ne_0_B : (1 : B) ≠ 0 := by
        intro h10
        exact q₁.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (h10 ▸ q₁.asIdeal.zero_mem))
      have h1_ne_0_A : (1 : A) ≠ 0 := by
        intro h10
        have : (1 : B) = 0 := by rw [← map_one f, h10, map_zero]
        exact h1_ne_0_B this
      have hex : ∃ d : ℕ, ∃ P : Polynomial A,
          P.Monic ∧ P.natDegree = d ∧ Polynomial.eval₂ f b P ∈ q₁.asIdeal := by
        obtain ⟨P, hP_mon, hP_eval⟩ := hf b
        exact ⟨P.natDegree, P, hP_mon, rfl, hP_eval.symm ▸ q₁.asIdeal.zero_mem⟩
      set d₀ : ℕ := Nat.find hex
      obtain ⟨P₀, hP₀_mon, hP₀_deg, hP₀_mem⟩ := Nat.find_spec hex
      have hd₀_eq : P₀.natDegree = d₀ := hP₀_deg
      have hd₀_pos : 1 ≤ d₀ := by
        rcases Nat.eq_zero_or_pos d₀ with hd0 | hpos
        · have hP₀_one : P₀ = 1 :=
            Polynomial.eq_one_of_monic_natDegree_zero hP₀_mon (hd₀_eq.trans hd0)
          rw [hP₀_one, Polynomial.eval₂_one] at hP₀_mem
          exact False.elim (q₁.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hP₀_mem))
        · exact hpos
      let P₁ : Polynomial A := P₀.divX
      let a₀ : A := P₀.coeff 0
      have hP₁_deg_le : P₁.natDegree ≤ d₀ - 1 := by
        rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro n hn
        rw [Polynomial.coeff_divX]
        exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      have hP₁_coeff : P₁.coeff (d₀ - 1) = 1 := by
        rw [Polynomial.coeff_divX, Nat.sub_add_cancel hd₀_pos, ← hd₀_eq]
        exact hP₀_mon.leadingCoeff
      have hP₁_deg : P₁.natDegree = d₀ - 1 :=
        Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hP₁_deg_le (hP₁_coeff.symm ▸ h1_ne_0_A)
      have hP₁_mon : P₁.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff, hP₁_deg, hP₁_coeff]
      have hdecomp : P₁ * Polynomial.X + Polynomial.C a₀ = P₀ :=
        Polynomial.divX_mul_X_add P₀
      have heval_eq : Polynomial.eval₂ f b P₁ * b + f a₀ = Polynomial.eval₂ f b P₀ := by
        conv_rhs => rw [← hdecomp]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
      have hsum_q₁ : Polynomial.eval₂ f b P₁ * b + f a₀ ∈ q₁.asIdeal := by
        rwa [heval_eq]
      have hsum_q₂ : Polynomial.eval₂ f b P₁ * b + f a₀ ∈ q₂.asIdeal :=
        hlt.le hsum_q₁
      have hfa₀_q₂ : f a₀ ∈ q₂.asIdeal := by
        have hmul_q₂ : Polynomial.eval₂ f b P₁ * b ∈ q₂.asIdeal :=
          q₂.asIdeal.mul_mem_left _ hb₂
        have hsub := q₂.asIdeal.sub_mem hsum_q₂ hmul_q₂
        simpa only [add_sub_cancel_left] using hsub
      have ha₀_comap : a₀ ∈ (PrimeSpectrum.comap f q₁).asIdeal := by
        rw [heq]
        exact hfa₀_q₂
      have hfa₀_q₁ : f a₀ ∈ q₁.asIdeal := ha₀_comap
      have hmul_q₁ : Polynomial.eval₂ f b P₁ * b ∈ q₁.asIdeal := by
        have hsub := q₁.asIdeal.sub_mem hsum_q₁ hfa₀_q₁
        simpa only [add_sub_cancel_right] using hsub
      have heval_P₁_q₁ : Polynomial.eval₂ f b P₁ ∈ q₁.asIdeal :=
        (q₁.isPrime.mem_or_mem hmul_q₁).resolve_right hb₁
      exact Nat.find_min hex (by omega : d₀ - 1 < d₀) ⟨P₁, hP₁_mon, hP₁_deg, heval_P₁_q₁⟩
    change Order.krullDim (PrimeSpectrum B) ≤ Order.krullDim (PrimeSpectrum A)
    unfold Order.krullDim
    apply iSup_le
    intro l
    let lA : LTSeries (PrimeSpectrum A) :=
      { length := l.length
        toFun := fun i => PrimeSpectrum.comap f (l.toFun i)
        step := fun i => hStrict (l.step i) }
    exact Order.LTSeries.length_le_krullDim lA

  have hKrullGe_of_inj_isIntegral : ∀ {A B : Type u} [CommRing A] [CommRing B] [Nontrivial A]
      (f : A →+* B), Function.Injective f → f.IsIntegral → ringKrullDim A ≤ ringKrullDim B := by
    intro A B _ _ _ f hf_inj hf_int
    let _ : Algebra A B := f.toAlgebra
    have _ : Algebra.IsIntegral A B := ⟨hf_int⟩
    have hLiftChain : ∀ (n : ℕ) (m_fn : Fin (n + 1) → PrimeSpectrum A),
        (∀ i : Fin n, m_fn i.castSucc < m_fn i.succ) →
        ∃ (q_fn : Fin (n + 1) → PrimeSpectrum B),
          (∀ i : Fin n, q_fn i.castSucc < q_fn i.succ) ∧
          PrimeSpectrum.comap f (q_fn (Fin.last n)) = m_fn (Fin.last n) := by
      intro n
      induction n with
      | zero =>
        intro m_fn _
        have hbot_le : Ideal.under A (⊥ : Ideal B) ≤ (m_fn (Fin.last 0)).asIdeal := by
          intro a ha
          have hfa : f a = 0 := ha
          have ha0 : a = 0 := hf_inj (hfa.trans (map_zero f).symm)
          rw [ha0]
          exact (m_fn (Fin.last 0)).asIdeal.zero_mem
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_over⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (m_fn (Fin.last 0)).asIdeal (⊥ : Ideal B) hbot_le
        refine ⟨fun _ => ⟨Q₀, hQ₀_prime⟩, fun i => Fin.elim0 i, ?_⟩
        ext x
        exact SetLike.ext_iff.mp hQ₀_over x
      | succ n ih =>
        intro m_fn hm_step
        obtain ⟨q₀, hq₀_step, hq₀_last⟩ :=
          ih (fun i => m_fn i.castSucc) (fun i => by
            simpa only [Fin.succ_castSucc] using hm_step i.castSucc)
        have hlt_last : m_fn (Fin.castSucc (Fin.last n)) < m_fn (Fin.last (n + 1)) :=
          hm_step (Fin.last n)
        have hunder_le : Ideal.under A (q₀ (Fin.last n)).asIdeal ≤
            (m_fn (Fin.last (n + 1))).asIdeal := by
          have heq_id : Ideal.under A (q₀ (Fin.last n)).asIdeal =
              (m_fn (Fin.castSucc (Fin.last n))).asIdeal :=
            congrArg PrimeSpectrum.asIdeal hq₀_last
          rw [heq_id]
          exact hlt_last.le
        obtain ⟨Q₁, hQ₁_ge, hQ₁_prime, hQ₁_over⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (m_fn (Fin.last (n + 1))).asIdeal
            (q₀ (Fin.last n)).asIdeal hunder_le
        let z₁ : PrimeSpectrum B := ⟨Q₁, hQ₁_prime⟩
        have hz₁_comap : PrimeSpectrum.comap f z₁ = m_fn (Fin.last (n + 1)) := by
          ext x
          exact SetLike.ext_iff.mp hQ₁_over x
        have hz₁_le : q₀ (Fin.last n) ≤ z₁ := hQ₁_ge
        have hz₁_lt : q₀ (Fin.last n) < z₁ := by
          apply lt_of_le_of_ne hz₁_le
          intro heq_z
          apply hlt_last.ne
          rw [← hq₀_last, ← hz₁_comap, heq_z]
        refine ⟨Fin.snoc q₀ z₁, ?_, by simp [Fin.snoc_last, hz₁_comap]⟩
        intro i
        refine Fin.lastCases ?_ ?_ i
        · simp only [Fin.snoc_castSucc, Fin.succ_last, Fin.snoc_last]
          exact hz₁_lt
        · intro j
          simp only [Fin.snoc_castSucc, ← Fin.castSucc_succ]
          exact hq₀_step j
    change Order.krullDim (PrimeSpectrum A) ≤ Order.krullDim (PrimeSpectrum B)
    unfold Order.krullDim
    apply iSup_le
    intro l
    obtain ⟨q_fn, hq_step, _⟩ := hLiftChain l.length l.toFun l.step
    let qB : LTSeries (PrimeSpectrum B) :=
      { length := l.length
        toFun := q_fn
        step := hq_step }
    exact Order.LTSeries.length_le_krullDim qB

  have hKrullMvPoly : ∀ (K₀ : Type u) [Field K₀] (n : ℕ),
      ringKrullDim (MvPolynomial (Fin n) K₀) = (n : WithBot ℕ∞) := by
    intro K₀ _ n
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field K₀,
      zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
    rfl

  
  
  
  have hStep2 : ∀ (y' : PrimeSpectrum (MvPolynomial (Fin m) k)),
      ∃ (c : ℕ) (_ : c ≤ m)
        (ψ : MvPolynomial (Fin c) k →ₐ[k] MvPolynomial (Fin m) k),
        topologicalKrullDim
          ↥(closure ({y'} : Set (PrimeSpectrum (MvPolynomial (Fin m) k)))) =
            (c : WithBot ℕ∞) ∧
        Function.Injective ((Ideal.Quotient.mk y'.asIdeal).comp ψ.toRingHom) ∧
        ((Ideal.Quotient.mk y'.asIdeal).comp ψ.toRingHom).IsIntegral ∧
        (c = m → Function.Bijective ψ) := by
    intro y'
    let P_m := MvPolynomial (Fin m) k
    let p_y : Ideal P_m := y'.asIdeal
    let _ : p_y.IsPrime := y'.isPrime
    let Q := P_m ⧸ p_y
    let π : P_m →+* Q := Ideal.Quotient.mk p_y
    have hπ_surj : Function.Surjective π := Ideal.Quotient.mk_surjective
    have _ : IsDomain Q := Ideal.Quotient.isDomain p_y
    have _ : Algebra.FiniteType k Q :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k p_y) hπ_surj

    have hDimClosure :
        topologicalKrullDim ↥(closure ({y'} : Set (PrimeSpectrum P_m))) =
          ringKrullDim Q := by
      have hrange : Set.range (PrimeSpectrum.comap π) =
          closure ({y'} : Set (PrimeSpectrum P_m)) := by
        rw [range_comap_of_surjective Q π hπ_surj, Ideal.mk_ker, ← PrimeSpectrum.closure_singleton]
      have hClosedEmb : Topology.IsClosedEmbedding (PrimeSpectrum.comap π) :=
        PrimeSpectrum.isClosedEmbedding_comap_of_surjective Q π hπ_surj
      let e_range : PrimeSpectrum Q ≃ₜ ↥(Set.range (PrimeSpectrum.comap π)) :=
        hClosedEmb.isEmbedding.toHomeomorph
      let e_cl : PrimeSpectrum Q ≃ₜ ↥(closure ({y'} : Set (PrimeSpectrum P_m))) :=
        e_range.trans (Homeomorph.setCongr hrange)
      rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Q]
      exact (IsHomeomorph.topologicalKrullDim_eq e_cl e_cl.isHomeomorph).symm

    obtain ⟨c, ψ_bar, hψ_bar_inj, hψ_bar_fin⟩ := exists_finite_inj_algHom_of_fg k Q
    let P_c := MvPolynomial (Fin c) k
    have hψ_bar_int : ψ_bar.toRingHom.IsIntegral := by
      have hInt : @Algebra.IsIntegral P_c Q _ _ ψ_bar.toRingHom.toAlgebra :=
        @Algebra.IsIntegral.of_finite P_c Q _ _ ψ_bar.toRingHom.toAlgebra hψ_bar_fin
      exact fun q => @Algebra.IsIntegral.isIntegral P_c Q _ _ ψ_bar.toRingHom.toAlgebra hInt q

    have hKrull_Q : ringKrullDim Q = (c : WithBot ℕ∞) := by
      have hle := hKrullLe_of_isIntegral ψ_bar.toRingHom hψ_bar_int
      have hge := hKrullGe_of_inj_isIntegral ψ_bar.toRingHom hψ_bar_inj hψ_bar_int
      rw [hKrullMvPoly k c] at hle hge
      exact le_antisymm hle hge

    have hc_le : c ≤ m := by
      have hq_le : ringKrullDim Q ≤ ringKrullDim P_m := ringKrullDim_quotient_le p_y
      rw [hKrull_Q, hKrullMvPoly k m] at hq_le
      exact_mod_cast hq_le

    have hp_bot_of_cm : c = m → p_y = ⊥ := by
      intro hcm
      by_contra hp_ne_bot
      have hπ_strict : StrictMono (PrimeSpectrum.comap π) := by
        intro q₁ q₂ hlt
        exact lt_of_le_of_ne (fun _ ha => hlt.le ha) fun heq =>
          hlt.ne (PrimeSpectrum.comap_injective_of_surjective π hπ_surj heq)
      have hbot_prime : (⊥ : Ideal P_m).IsPrime :=
        ⟨bot_ne_top, fun {a b} hab => mul_eq_zero.mp hab⟩
      let z_bot : PrimeSpectrum P_m := ⟨⊥, hbot_prime⟩
      have hKrull_le_sub : ringKrullDim Q ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
        change Order.krullDim (PrimeSpectrum Q) ≤ ((m - 1 : ℕ) : WithBot ℕ∞)
        unfold Order.krullDim
        apply iSup_le
        intro l
        have hhead_ge : p_y ≤ (PrimeSpectrum.comap π (l.toFun 0)).asIdeal := by
          intro a ha
          change π a ∈ (l.toFun 0).asIdeal
          have hπa : π a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
          rw [hπa]
          exact (l.toFun 0).asIdeal.zero_mem
        have hbot_lt : z_bot < PrimeSpectrum.comap π (l.toFun 0) := by
          apply lt_of_le_of_ne bot_le
          intro heq
          have : (⊥ : Ideal P_m) = (PrimeSpectrum.comap π (l.toFun 0)).asIdeal :=
            congrArg PrimeSpectrum.asIdeal heq
          exact hp_ne_bot (le_bot_iff.mp (this ▸ hhead_ge))
        let l_ext : LTSeries (PrimeSpectrum P_m) :=
          { length := l.length + 1
            toFun := Fin.cons z_bot (fun i => PrimeSpectrum.comap π (l.toFun i))
            step := Fin.cases hbot_lt (fun i => hπ_strict (l.step i)) }
        have hlen_le : ((l.length + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim P_m :=
          Order.LTSeries.length_le_krullDim l_ext
        rw [hKrullMvPoly k m] at hlen_le
        have hlen_nat : l.length + 1 ≤ m := by exact_mod_cast hlen_le
        have hlen_sub : l.length ≤ m - 1 := by omega
        exact_mod_cast hlen_sub
      rw [hKrull_Q, hcm] at hKrull_le_sub
      have hm_le : m ≤ m - 1 := by exact_mod_cast hKrull_le_sub
      omega

    let ψ : P_c →ₐ[k] P_m :=
      if hcm : c = m then
        (MvPolynomial.renameEquiv k (finCongr hcm)).toAlgHom
      else
        MvPolynomial.aeval (fun i : Fin c => Classical.choose (hπ_surj (ψ_bar (MvPolynomial.X i))))

    refine ⟨c, hc_le, ψ, hDimClosure.trans hKrull_Q, ?_⟩
    by_cases hcm : c = m
    · have hψ_eq : ψ = (MvPolynomial.renameEquiv k (finCongr hcm)).toAlgHom := by
        simp only [ψ, hcm, ↓reduceDIte]
      have hψ_bij : Function.Bijective ψ := by
        rw [hψ_eq]
        exact (MvPolynomial.renameEquiv k (finCongr hcm)).bijective
      have hp_bot : p_y = ⊥ := hp_bot_of_cm hcm
      have hπ_inj : Function.Injective π := by
        rw [RingHom.injective_iff_ker_eq_bot, Ideal.mk_ker]
        exact hp_bot
      have hπ_bij : Function.Bijective π := ⟨hπ_inj, hπ_surj⟩
      have hcomp_bij : Function.Bijective (π.comp ψ.toRingHom) := hπ_bij.comp hψ_bij
      exact ⟨hcomp_bij.1, RingHom.isIntegral_of_surjective _ hcomp_bij.2, fun _ => hψ_bij⟩
    · have hψ_eq : ψ = MvPolynomial.aeval
          (fun i : Fin c => Classical.choose (hπ_surj (ψ_bar (MvPolynomial.X i)))) := by
        simp only [ψ, hcm, ↓reduceDIte]
      have hcomp_eq : π.comp ψ.toRingHom = ψ_bar.toRingHom := by
        have halg_eq : (Ideal.Quotient.mkₐ k p_y).comp ψ = ψ_bar := by
          apply MvPolynomial.algHom_ext
          intro i
          rw [AlgHom.comp_apply, hψ_eq, MvPolynomial.aeval_X]
          exact Classical.choose_spec (hπ_surj (ψ_bar (MvPolynomial.X i)))
        exact congrArg AlgHom.toRingHom halg_eq
      rw [hcomp_eq]
      exact ⟨hψ_bar_inj, hψ_bar_int, fun h => False.elim (hcm h)⟩

  
  
  
  have hStep3 : ∀ (R S : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing S]
      (K₀ : Type u) [Field K₀] [Algebra R K₀] [IsFractionRing R K₀]
      (φ₀ : R →+* κ) (ev_S : S →+* κ),
      Function.Injective φ₀ →
      (∀ s : S, ∃ Q_poly : Polynomial R, Q_poly.Monic ∧ Polynomial.eval₂ φ₀ (ev_S s) Q_poly = 0) →
      (∀ z : κ, ∃ P : Polynomial S, Polynomial.map ev_S P ≠ 0 ∧ Polynomial.eval₂ ev_S z P = 0) →
      ∃ (K_sep : Type u) (_ : Field K_sep) (_ : Algebra K_sep κ)
        (_ : IsPurelyInseparable K_sep κ)
        (φ_sep : R →+* K_sep)
        (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
        (D : CategoryTheory.Functor ℐ CommRingCat.{u})
        (α_D : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R)) D)
        (colim_c : CategoryTheory.Limits.Cocone D)
        (_ : CategoryTheory.Limits.IsColimit colim_c)
        (e_pt : CategoryTheory.Iso colim_c.pt (CommRingCat.of K_sep)),
        (algebraMap K_sep κ).comp φ_sep = φ₀ ∧
        (∀ i : ℐ, (CommRingCat.Hom.hom (α_D.app i)).Etale) ∧
        (∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α_D.app i)
          (CategoryTheory.CategoryStruct.comp (colim_c.ι.app i) e_pt.hom) =
            CommRingCat.ofHom φ_sep) := by
    intro R S _ _ _ _ K₀ _ _ _ φ₀ ev_S hφ₀_inj hInt_im halg_S
    have hφ₀_units : ∀ y_el : nonZeroDivisors R, IsUnit (φ₀ y_el) := by
      intro y_el
      have hy0 : (y_el : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y_el.2
      exact Ne.isUnit (fun h0 => hy0 (hφ₀_inj (h0.trans (map_zero φ₀).symm)))
    let ι_K₀ : K₀ →+* κ := IsLocalization.lift (M := nonZeroDivisors R) hφ₀_units
    have hι_K₀_comp : ι_K₀.comp (algebraMap R K₀) = φ₀ :=
      RingHom.ext fun r => IsLocalization.lift_eq hφ₀_units r
    let _ : Algebra K₀ κ := ι_K₀.toAlgebra
    have hInt_ev : ∀ s : S, IsIntegral K₀ (ev_S s) := by
      intro s
      obtain ⟨Q_poly, hQ_mon, hQ_eval⟩ := hInt_im s
      refine ⟨Q_poly.map (algebraMap R K₀), hQ_mon.map (algebraMap R K₀), ?_⟩
      rw [Polynomial.eval₂_map]
      change Polynomial.eval₂ (ι_K₀.comp (algebraMap R K₀)) (ev_S s) Q_poly = 0
      rwa [hι_K₀_comp]
    let E_im : IntermediateField K₀ κ := IntermediateField.adjoin K₀ (Set.range ev_S)
    have _ : Algebra.IsAlgebraic K₀ ↥E_im :=
      IntermediateField.isAlgebraic_adjoin (by rintro _ ⟨s, rfl⟩; exact hInt_ev s)
    have _ : Algebra.IsIntegral K₀ ↥E_im := Algebra.IsAlgebraic.isIntegral
    have _ : Algebra.IsIntegral ↥E_im κ := by
      refine ⟨fun z => ?_⟩
      obtain ⟨P, hP_ne, hP_eval⟩ := halg_S z
      let ev_E : S →+* ↥E_im :=
        ev_S.codRestrict E_im.toSubring (fun s =>
          IntermediateField.subset_adjoin K₀ (Set.range ev_S) ⟨s, rfl⟩)
      have hev_E_comp : (algebraMap ↥E_im κ).comp ev_E = ev_S :=
        RingHom.ext fun _ => rfl
      let P_E : Polynomial ↥E_im := P.map ev_E
      have hPE_ne : P_E ≠ 0 := by
        intro h0
        apply hP_ne
        have hmap_eq : Polynomial.map (algebraMap ↥E_im κ) P_E = Polynomial.map ev_S P := by
          dsimp [P_E]
          rw [Polynomial.map_map, hev_E_comp]
        rw [← hmap_eq, h0, Polynomial.map_zero]
      have hPE_eval : Polynomial.aeval z P_E = 0 := by
        change Polynomial.eval₂ (algebraMap ↥E_im κ) z (P.map ev_E) = 0
        rwa [Polynomial.eval₂_map, hev_E_comp]
      exact IsAlgebraic.isIntegral ⟨P_E, hPE_ne, hPE_eval⟩
    have _ : Algebra.IsIntegral K₀ κ := Algebra.IsIntegral.trans ↥E_im
    have _ : Algebra.IsAlgebraic K₀ κ :=
      ⟨fun z => (Algebra.IsIntegral.isIntegral (R := K₀) z).isAlgebraic⟩

    let K_sep : Type u := ↥(separableClosure K₀ κ)
    have _ : IsPurelyInseparable K_sep κ := separableClosure.isPurelyInseparable K₀ κ
    have _ : Algebra.IsSeparable K₀ K_sep := separableClosure.isSeparable K₀ κ
    have _ : Algebra.IsIntegral K₀ K_sep := inferInstance
    let φ_sep : R →+* K_sep := (algebraMap K₀ K_sep).comp (algebraMap R K₀)
    have hcomp_φ_sep : (algebraMap K_sep κ).comp φ_sep = φ₀ := by
      have hsc : (algebraMap K_sep κ).comp (algebraMap K₀ K_sep) = algebraMap K₀ κ := rfl
      rw [← RingHom.comp_assoc, hsc]
      exact hι_K₀_comp
    let _ : Algebra R K_sep := φ_sep.toAlgebra
    have _ : IsScalarTower R K₀ K_sep := IsScalarTower.of_algebraMap_eq' rfl
    have hφ_sep_inj : Function.Injective φ_sep := by
      intro r₁ r₂ h
      apply hφ₀_inj
      rw [← hcomp_φ_sep]
      exact congrArg (algebraMap K_sep κ) h

    have hClearPoly : ∀ Q_k : Polynomial K₀, ∃ (s : nonZeroDivisors R) (Q_r : Polynomial R),
        Q_r.map (algebraMap R K₀) = Polynomial.C (algebraMap R K₀ s) * Q_k := by
      intro Q_k
      refine Polynomial.induction_on' Q_k ?_ ?_
      · rintro p₁ p₂ ⟨s₁, Q₁, hQ₁⟩ ⟨s₂, Q₂, hQ₂⟩
        refine ⟨s₁ * s₂, Polynomial.C (s₂ : R) * Q₁ + Polynomial.C (s₁ : R) * Q₂, ?_⟩
        rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
          Polynomial.map_C, hQ₁, hQ₂, Submonoid.coe_mul, map_mul, Polynomial.C_mul]
        ring
      · intro n a
        obtain ⟨⟨num, den⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors R) a
        refine ⟨den, Polynomial.monomial n num, ?_⟩
        rw [Polynomial.map_monomial, ← hsurj, mul_comm a, Polynomial.C_mul_monomial]

    have hMasterEtale : ∀ G : Finset K_sep,
        ∃ A : Subalgebra R K_sep, Algebra.Etale R ↥A ∧ (G : Set K_sep) ⊆ A := by
      intro G
      let E : IntermediateField K₀ K_sep := IntermediateField.adjoin K₀ (G : Set K_sep)
      have _ : FiniteDimensional K₀ ↥E :=
        IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
      have _ : Algebra.IsSeparable K₀ ↥E :=
        Algebra.isSeparable_tower_bot_of_isSeparable K₀ ↥E K_sep
      obtain ⟨α₀, hα₀_prim⟩ := Field.exists_primitive_element K₀ ↥E
      let _ : Algebra R ↥E := ((algebraMap K₀ ↥E).comp (algebraMap R K₀)).toAlgebra
      have _ : IsScalarTower R K₀ ↥E := IsScalarTower.of_algebraMap_eq' rfl
      have hα₀_int : IsIntegral K₀ α₀ := Algebra.IsIntegral.isIntegral α₀
      obtain ⟨d₀, hd₀_int⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors R) α₀ hα₀_int
      let β_E : ↥E := d₀ • α₀
      have hβE_prim : IntermediateField.adjoin K₀ ({β_E} : Set ↥E) = ⊤ := by
        apply top_unique
        rw [← hα₀_prim, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        have hd₀_ne : (d₀ : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d₀.2
        have hc₀_ne : algebraMap R K₀ d₀ ≠ 0 :=
          fun h0 => hd₀_ne (IsFractionRing.injective R K₀ (h0.trans (map_zero _).symm))
        have hβE_eq : β_E = algebraMap R K₀ d₀ • α₀ := by
          change (d₀ : R) • α₀ = _
          rw [algebra_compatible_smul K₀ (d₀ : R) α₀]
        have hα₀_eq : α₀ = (algebraMap R K₀ d₀)⁻¹ • β_E := by
          rw [hβE_eq, inv_smul_smul₀ hc₀_ne]
        rw [hα₀_eq]
        exact Submodule.smul_mem
          (IntermediateField.adjoin K₀ ({β_E} : Set ↥E)).toSubalgebra.toSubmodule _
          (IntermediateField.mem_adjoin_simple_self K₀ β_E)

      let β : K_sep := β_E.1
      let hE_val_alg : ↥E →ₐ[R] K_sep := E.val.restrictScalars R
      have hβ_int_R : IsIntegral R β := by
        change IsIntegral R (hE_val_alg (d₀ • α₀))
        exact IsIntegral.map hE_val_alg hd₀_int
      have hβE_int_K₀ : IsIntegral K₀ β_E := Algebra.IsIntegral.isIntegral β_E

      let f_β : Polynomial R := minpoly R β
      have hf_β_mon : f_β.Monic := minpoly.monic hβ_int_R
      set f_K₀ : Polynomial K₀ := minpoly K₀ β
      have hf_eq : f_K₀ = f_β.map (algebraMap R K₀) :=
        minpoly.isIntegrallyClosed_eq_field_fractions' K₀ hβ_int_R

      have hf_sep : f_K₀.Separable := Algebra.IsSeparable.isSeparable K₀ β
      obtain ⟨A₀, B₀, hBez_K₀⟩ := hf_sep
      obtain ⟨s_A, A', hA'⟩ := hClearPoly A₀
      obtain ⟨s_B, B', hB'⟩ := hClearPoly B₀
      let s_sep : nonZeroDivisors R := s_A * s_B
      let A_tilde : Polynomial R := Polynomial.C (s_B : R) * A'
      let B_tilde : Polynomial R := Polynomial.C (s_A : R) * B'
      have hBez_R : Polynomial.derivative f_β * B_tilde + f_β * A_tilde =
          Polynomial.C (s_sep : R) := by
        apply Polynomial.map_injective (algebraMap R K₀) (IsFractionRing.injective R K₀)
        dsimp only [A_tilde, B_tilde, s_sep]
        simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
          ← Polynomial.derivative_map, ← hf_eq, hA', hB', Submonoid.coe_mul, map_mul]
        calc
          Polynomial.derivative f_K₀ *
              (Polynomial.C (algebraMap R K₀ s_A) *
                (Polynomial.C (algebraMap R K₀ s_B) * B₀)) +
            f_K₀ *
              (Polynomial.C (algebraMap R K₀ s_B) *
                (Polynomial.C (algebraMap R K₀ s_A) * A₀)) =
            Polynomial.C (algebraMap R K₀ s_A) * Polynomial.C (algebraMap R K₀ s_B) *
              (A₀ * f_K₀ + B₀ * Polynomial.derivative f_K₀) := by ring
          _ = Polynomial.C (algebraMap R K₀ s_A) * Polynomial.C (algebraMap R K₀ s_B) * 1 := by
            rw [hBez_K₀]
          _ = Polynomial.C (algebraMap R K₀ s_A) * Polynomial.C (algebraMap R K₀ s_B) :=
            mul_one _

      have hGen_G : ∀ x : ↥G,
          ∃ (s_x : nonZeroDivisors R) (Q_x : Polynomial R),
            φ_sep (s_x : R) * x.1 = Polynomial.aeval β Q_x := by
        intro x
        have hx_G : x.1 ∈ (G : Set K_sep) := Finset.mem_coe.mpr x.2
        let x_E : ↥E := ⟨x.1, IntermediateField.subset_adjoin K₀ (G : Set K_sep) hx_G⟩
        have hx_mem : x_E ∈ IntermediateField.adjoin K₀ ({β_E} : Set ↥E) := by
          rw [hβE_prim]
          trivial
        let pb := IntermediateField.adjoin.powerBasis hβE_int_K₀
        obtain ⟨Q_k, hQ_k⟩ := PowerBasis.exists_eq_aeval' pb ⟨x_E, hx_mem⟩
        have hQ_k_val : Polynomial.aeval β Q_k = x.1 := by
          let ι_sub : ↥(IntermediateField.adjoin K₀ ({β_E} : Set ↥E)) →ₐ[K₀] K_sep :=
            E.val.comp (IntermediateField.adjoin K₀ ({β_E} : Set ↥E)).val
          have h1 : ι_sub ⟨x_E, hx_mem⟩ = x.1 := rfl
          have hgen : ι_sub pb.gen = β := by
            change (pb.gen : ↥E).1 = β
            rw [IntermediateField.adjoin.powerBasis_gen]
            rfl
          rw [← h1, hQ_k, ← Polynomial.aeval_algHom_apply ι_sub pb.gen Q_k, hgen]
        obtain ⟨s_x, Q_x, hQ_x⟩ := hClearPoly Q_k
        refine ⟨s_x, Q_x, ?_⟩
        have haeval_map : Polynomial.aeval β (Q_x.map (algebraMap R K₀)) =
            Polynomial.aeval β Q_x := by
          rw [Polynomial.aeval_map_algebraMap]
        rw [← haeval_map, hQ_x, map_mul, Polynomial.aeval_C, hQ_k_val]
        rfl

      let s_fn : ↥G → nonZeroDivisors R := fun x => Classical.choose (hGen_G x)
      let Q_fn : ↥G → Polynomial R :=
        fun x => Classical.choose (Classical.choose_spec (hGen_G x))
      have hQ_fn_spec : ∀ x : ↥G,
          φ_sep (s_fn x : R) * x.1 = Polynomial.aeval β (Q_fn x) :=
        fun x => Classical.choose_spec (Classical.choose_spec (hGen_G x))

      let p_prod : nonZeroDivisors R := ∏ x : ↥G, s_fn x
      let h_nzd : nonZeroDivisors R := s_sep * p_prod
      let h_el : R := h_nzd.1
      have hh_ne : h_el ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp h_nzd.2
      have hφh_ne : φ_sep h_el ≠ 0 := fun h0 => hh_ne (hφ_sep_inj (h0.trans (map_zero φ_sep).symm))
      have hBez_h : ∃ p₁ p₂ n,
          Polynomial.derivative f_β * p₁ + f_β * p₂ = (Polynomial.C h_el) ^ n := by
        refine ⟨Polynomial.C (p_prod : R) * B_tilde, Polynomial.C (p_prod : R) * A_tilde, 1, ?_⟩
        rw [pow_one]
        have hmul := congrArg (· * Polynomial.C (p_prod : R)) hBez_R
        have hrhs : Polynomial.C (s_sep : R) * Polynomial.C (p_prod : R) =
            Polynomial.C h_el := by
          rw [← Polynomial.C_mul]
          rfl
        rw [hrhs] at hmul
        calc
          Polynomial.derivative f_β * (Polynomial.C (p_prod : R) * B_tilde) +
              f_β * (Polynomial.C (p_prod : R) * A_tilde) =
            (Polynomial.derivative f_β * B_tilde + f_β * A_tilde) *
              Polynomial.C (p_prod : R) := by ring
          _ = Polynomial.C h_el := hmul

      let P_pair : StandardEtalePair R :=
        StandardEtalePair.mk f_β hf_β_mon (Polynomial.C h_el) hBez_h
      have hMap_β : P_pair.HasMap β := by
        refine ⟨minpoly.aeval R β, ?_⟩
        dsimp [P_pair]
        rw [Polynomial.aeval_C]
        exact Ne.isUnit hφh_ne
      let L : P_pair.Ring →ₐ[R] K_sep := P_pair.lift β hMap_β

      have hL_inj : Function.Injective L := by
        let R_quot := AdjoinRoot f_β
        let Φ₀ : R_quot →ₐ[R] K_sep :=
          AdjoinRoot.liftAlgHom f_β (Algebra.ofId R K_sep) β (minpoly.aeval R β)
        have hΦ₀_inj : Function.Injective Φ₀ := by
          rw [injective_iff_map_eq_zero]
          intro z hz
          obtain ⟨q_p, rfl⟩ := AdjoinRoot.mk_surjective z
          let r_p : Polynomial R := q_p %ₘ f_β
          have hmk_eq : AdjoinRoot.mk f_β q_p = AdjoinRoot.mk f_β r_p := by
            conv_lhs => rw [← Polynomial.modByMonic_add_div q_p f_β]
            rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
          have hr_eval : Polynomial.aeval β r_p = 0 := by
            have hz' : Φ₀ (AdjoinRoot.mk f_β r_p) = 0 := hmk_eq ▸ hz
            have hlmk : Φ₀ (AdjoinRoot.mk f_β r_p) = Polynomial.aeval β r_p :=
              AdjoinRoot.liftAlgHom_mk f_β (Algebra.ofId R K_sep) β (minpoly.aeval R β) r_p
            exact hlmk.symm.trans hz'
          have hr_eval_K₀ : Polynomial.aeval β (r_p.map (algebraMap R K₀)) = 0 := by
            rwa [Polynomial.aeval_map_algebraMap]
          have hdvd : f_K₀ ∣ r_p.map (algebraMap R K₀) := minpoly.dvd K₀ β hr_eval_K₀
          have hr_zero : r_p = 0 := by
            by_contra hr_ne
            have hrmap_ne : r_p.map (algebraMap R K₀) ≠ 0 :=
              fun h0 => hr_ne (Polynomial.map_injective _ (IsFractionRing.injective R K₀)
                (h0.trans (Polynomial.map_zero _).symm))
            have hdeg1 : f_K₀.degree ≤ (r_p.map (algebraMap R K₀)).degree :=
              Polynomial.degree_le_of_dvd hdvd hrmap_ne
            have hdeg2 : (r_p.map (algebraMap R K₀)).degree ≤ r_p.degree :=
              Polynomial.degree_map_le
            have hdeg3 : r_p.degree < f_β.degree :=
              Polynomial.degree_modByMonic_lt q_p hf_β_mon
            have hdeg_f : f_K₀.degree = f_β.degree := by
              rw [hf_eq, hf_β_mon.degree_map]
            rw [hdeg_f] at hdeg1
            exact lt_irrefl _ ((hdeg1.trans hdeg2).trans_lt hdeg3)
          rw [hmk_eq, hr_zero, map_zero]

        let u₀ : R_quot := AdjoinRoot.of f_β h_el
        let R_et := Localization.Away u₀
        have hu₀_unit_Ksep : IsUnit (Φ₀.toRingHom u₀) := by
          change IsUnit (Φ₀ (algebraMap R R_quot h_el))
          rw [Φ₀.commutes]
          exact Ne.isUnit hφh_ne
        let φ_loc : R_et →+* K_sep := IsLocalization.Away.lift u₀ hu₀_unit_Ksep
        let Φ : R_et →ₐ[R] K_sep :=
          { φ_loc with
            commutes' := fun r => by
              change φ_loc (algebraMap R_quot R_et (algebraMap R R_quot r)) = algebraMap R K_sep r
              rw [IsLocalization.Away.lift_eq]
              exact Φ₀.commutes r }
        have hΦ_inj : Function.Injective Φ := by
          rw [injective_iff_map_eq_zero]
          intro z hz
          obtain ⟨⟨w, s_pow⟩, hsurj⟩ := IsLocalization.surj (Submonoid.powers u₀) z
          have hΦw : Φ₀ w = 0 := by
            have h1 := congrArg Φ hsurj
            rw [map_mul, hz, zero_mul] at h1
            have h2 : Φ (algebraMap R_quot R_et w) = Φ₀ w :=
              IsLocalization.Away.lift_eq u₀ hu₀_unit_Ksep w
            exact h2.symm.trans h1.symm
          have hw0 : w = 0 := hΦ₀_inj (hΦw.trans (map_zero Φ₀).symm)
          rw [hw0, map_zero] at hsurj
          obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units R_et s_pow
          calc
            z = z * (↑u_s * ↑u_s⁻¹) := by rw [Units.mul_inv, mul_one]
            _ = (z * algebraMap R_quot R_et s_pow) * ↑u_s⁻¹ := by rw [← mul_assoc, hu_s]
            _ = 0 := by rw [hsurj, zero_mul]

        let x₀ : R_et := IsScalarTower.toAlgHom R R_quot R_et (AdjoinRoot.root f_β)
        have hx₀_map : P_pair.HasMap x₀ := by
          refine ⟨?_, ?_⟩
          · change Polynomial.aeval
              (IsScalarTower.toAlgHom R R_quot R_et (AdjoinRoot.root f_β)) f_β = 0
            rw [Polynomial.aeval_algHom_apply, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, map_zero]
          · dsimp [P_pair]
            rw [Polynomial.aeval_C]
            change IsUnit (algebraMap R_quot R_et u₀)
            exact IsLocalization.Away.algebraMap_isUnit u₀
        let j_pair : P_pair.Ring →ₐ[R] R_et := P_pair.lift x₀ hx₀_map
        have hX_map : P_pair.HasMap P_pair.X := (P_pair.homEquiv (AlgHom.id R P_pair.Ring)).2
        let Ψ₀ : R_quot →ₐ[R] P_pair.Ring :=
          AdjoinRoot.liftAlgHom f_β (Algebra.ofId R P_pair.Ring) P_pair.X hX_map.1
        have hu₀_unit_P : IsUnit (Ψ₀.toRingHom u₀) := by
          change IsUnit (Ψ₀ (algebraMap R R_quot h_el))
          rw [Ψ₀.commutes]
          have hCh : Polynomial.aeval P_pair.X P_pair.g = algebraMap R P_pair.Ring h_el := by
            dsimp [P_pair]
            exact Polynomial.aeval_C P_pair.X h_el
          rw [← hCh]
          exact hX_map.2
        let ψ_loc : R_et →+* P_pair.Ring := IsLocalization.Away.lift u₀ hu₀_unit_P
        let Ψ : R_et →ₐ[R] P_pair.Ring :=
          { ψ_loc with
            commutes' := fun r => by
              change ψ_loc (algebraMap R_quot R_et (algebraMap R R_quot r)) = _
              rw [IsLocalization.Away.lift_eq]
              exact Ψ₀.commutes r }
        have hΨ_x₀ : Ψ x₀ = P_pair.X := by
          change ψ_loc (algebraMap R_quot R_et (AdjoinRoot.root f_β)) = P_pair.X
          rw [IsLocalization.Away.lift_eq]
          exact AdjoinRoot.liftAlgHom_root f_β (Algebra.ofId R P_pair.Ring) P_pair.X hX_map.1
        have h_left_inv : Ψ.comp j_pair = AlgHom.id R P_pair.Ring := by
          apply P_pair.homEquiv.injective
          apply Subtype.ext
          change (Ψ.comp j_pair) P_pair.X = (AlgHom.id R P_pair.Ring) P_pair.X
          rw [AlgHom.comp_apply, P_pair.lift_X, hΨ_x₀, AlgHom.id_apply]
        have hj_inj : Function.Injective j_pair := by
          intro a₁ a₂ ha
          have := congrArg Ψ ha
          simpa only [← AlgHom.comp_apply, h_left_inv, AlgHom.id_apply] using this
        have hL_eq : L = Φ.comp j_pair := by
          apply P_pair.homEquiv.injective
          apply Subtype.ext
          change L P_pair.X = (Φ.comp j_pair) P_pair.X
          rw [P_pair.lift_X, AlgHom.comp_apply, P_pair.lift_X]
          change β = φ_loc (algebraMap R_quot R_et (AdjoinRoot.root f_β))
          rw [IsLocalization.Away.lift_eq]
          exact (AdjoinRoot.liftAlgHom_root f_β (Algebra.ofId R K_sep) β
            (minpoly.aeval R β)).symm
        rw [hL_eq]
        exact hΦ_inj.comp hj_inj

      let A_G : Subalgebra R K_sep := L.range
      have hX_map : P_pair.HasMap P_pair.X := (P_pair.homEquiv (AlgHom.id R P_pair.Ring)).2
      let x_A : ↥A_G := L.rangeRestrict P_pair.X
      have hx_A_map : P_pair.HasMap x_A := by
        refine ⟨?_, ?_⟩
        · dsimp only [x_A]
          rw [Polynomial.aeval_algHom_apply L.rangeRestrict P_pair.X P_pair.f,
            hX_map.1, map_zero]
        · dsimp only [x_A]
          rw [Polynomial.aeval_algHom_apply L.rangeRestrict P_pair.X P_pair.g]
          exact hX_map.2.map L.rangeRestrict
      have hlift_xA : P_pair.lift x_A hx_A_map = L.rangeRestrict := by
        apply P_pair.homEquiv.injective
        apply Subtype.ext
        change (P_pair.lift x_A hx_A_map) P_pair.X = L.rangeRestrict P_pair.X
        exact P_pair.lift_X x_A hx_A_map
      have hbij_xA : Function.Bijective (P_pair.lift x_A hx_A_map) := by
        rw [hlift_xA]
        refine ⟨fun a₁ a₂ h => hL_inj (congrArg Subtype.val h), L.rangeRestrict_surjective⟩
      have _ : Algebra.IsStandardEtale R ↥A_G :=
        Algebra.IsStandardEtale.mk ⟨StandardEtalePresentation.mk P_pair x_A hx_A_map hbij_xA⟩
      have hEt_AG : Algebra.Etale R ↥A_G := inferInstance

      refine ⟨A_G, hEt_AG, ?_⟩
      intro g hg
      let x_g : ↥G := ⟨g, Finset.mem_coe.mp hg⟩
      have haeval_mem : Polynomial.aeval β (Q_fn x_g) ∈ A_G := by
        have hval : (Polynomial.aeval x_A (Q_fn x_g) : ↥A_G).1 = Polynomial.aeval β (Q_fn x_g) := by
          have hx_val : A_G.val x_A = β := P_pair.lift_X β hMap_β
          rw [← hx_val]
          exact (Polynomial.aeval_algHom_apply A_G.val x_A (Q_fn x_g)).symm
        rw [← hval]
        exact (Polynomial.aeval x_A (Q_fn x_g)).2
      obtain ⟨u_h, hu_h⟩ := hX_map.2
      have hu_h_eq : algebraMap R P_pair.Ring h_el = ↑u_h := by
        have hCh : Polynomial.aeval P_pair.X P_pair.g = algebraMap R P_pair.Ring h_el := by
          dsimp [P_pair]
          exact Polynomial.aeval_C P_pair.X h_el
        exact hCh.symm.trans hu_h.symm
      let h_inv_K : K_sep := L (↑u_h⁻¹ : P_pair.Ring)
      have hh_inv_mem : h_inv_K ∈ A_G := ⟨↑u_h⁻¹, rfl⟩
      have hh_mul_inv : φ_sep h_el * h_inv_K = 1 := by
        calc
          φ_sep h_el * L (↑u_h⁻¹) = L (algebraMap R P_pair.Ring h_el) * L (↑u_h⁻¹) := by
            rw [L.commutes]
            rfl
          _ = L (algebraMap R P_pair.Ring h_el * ↑u_h⁻¹) := (map_mul L _ _).symm
          _ = L (↑u_h * ↑u_h⁻¹) := by rw [hu_h_eq]
          _ = L 1 := by rw [Units.mul_inv]
          _ = 1 := map_one L
      have hdvd_p : s_fn x_g ∣ p_prod :=
        Finset.dvd_prod_of_mem s_fn (Finset.mem_univ x_g)
      obtain ⟨q_nzd, hq_nzd⟩ := hdvd_p
      let r_cof : R := (s_sep : R) * (q_nzd : R)
      have hh_factor : h_el = (s_fn x_g : R) * r_cof := by
        dsimp [h_el, h_nzd, r_cof]
        have hp_coe : (p_prod : R) = (s_fn x_g : R) * (q_nzd : R) :=
          congrArg Subtype.val hq_nzd
        rw [hp_coe]
        ring
      let s_inv_K : K_sep := φ_sep r_cof * h_inv_K
      have hs_inv_mem : s_inv_K ∈ A_G :=
        A_G.mul_mem (A_G.algebraMap_mem r_cof) hh_inv_mem
      have hs_mul_inv : s_inv_K * φ_sep (s_fn x_g : R) = 1 := by
        dsimp [s_inv_K]
        calc
          (φ_sep r_cof * h_inv_K) * φ_sep (s_fn x_g : R) =
              (φ_sep (s_fn x_g : R) * φ_sep r_cof) * h_inv_K := by ring
          _ = φ_sep h_el * h_inv_K := by rw [← map_mul, ← hh_factor]
          _ = 1 := hh_mul_inv
      have hg_eq : g = s_inv_K * Polynomial.aeval β (Q_fn x_g) := by
        calc
          g = 1 * x_g.1 := (one_mul g).symm
          _ = (s_inv_K * φ_sep (s_fn x_g : R)) * x_g.1 := by rw [hs_mul_inv]
          _ = s_inv_K * (φ_sep (s_fn x_g : R) * x_g.1) := by ring
          _ = s_inv_K * Polynomial.aeval β (Q_fn x_g) := by rw [hQ_fn_spec x_g]
      rw [hg_eq]
      exact A_G.mul_mem hs_inv_mem haeval_mem

    let ℐ : Type u := { A : Subalgebra R K_sep // Algebra.Etale R ↥A }
    have hNonempty_ℐ : Nonempty ℐ := by
      obtain ⟨A₀, hEt₀, _⟩ := hMasterEtale ∅
      exact ⟨⟨A₀, hEt₀⟩⟩
    have hDir_ℐ : IsDirected ℐ (· ≤ ·) := by
      refine ⟨fun i₁ i₂ => ?_⟩
      have _ : Algebra.Etale R ↥i₁.1 := i₁.2
      have _ : Algebra.Etale R ↥i₂.1 := i₂.2
      have hFT₁ : Algebra.FiniteType R ↥i₁.1 := inferInstance
      have hFT₂ : Algebra.FiniteType R ↥i₂.1 := inferInstance
      obtain ⟨S₁, hS₁⟩ := hFT₁.out
      obtain ⟨S₂, hS₂⟩ := hFT₂.out
      let G_join : Finset K_sep := S₁.image Subtype.val ∪ S₂.image Subtype.val
      obtain ⟨A₃, hEt₃, hSub₃⟩ := hMasterEtale G_join
      have hle₁ : i₁.1 ≤ A₃ := by
        intro x hx
        have hx_top : (⟨x, hx⟩ : ↥i₁.1) ∈ (⊤ : Subalgebra R ↥i₁.1) := trivial
        rw [← hS₁] at hx_top
        have hx_map : x ∈ (Algebra.adjoin R (S₁ : Set ↥i₁.1)).map i₁.1.val :=
          ⟨⟨x, hx⟩, hx_top, rfl⟩
        rw [AlgHom.map_adjoin] at hx_map
        refine Algebra.adjoin_le ?_ hx_map
        rintro _ ⟨y, hy, rfl⟩
        apply hSub₃
        exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem Subtype.val hy))
      have hle₂ : i₂.1 ≤ A₃ := by
        intro x hx
        have hx_top : (⟨x, hx⟩ : ↥i₂.1) ∈ (⊤ : Subalgebra R ↥i₂.1) := trivial
        rw [← hS₂] at hx_top
        have hx_map : x ∈ (Algebra.adjoin R (S₂ : Set ↥i₂.1)).map i₂.1.val :=
          ⟨⟨x, hx⟩, hx_top, rfl⟩
        rw [AlgHom.map_adjoin] at hx_map
        refine Algebra.adjoin_le ?_ hx_map
        rintro _ ⟨y, hy, rfl⟩
        apply hSub₃
        exact Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem Subtype.val hy))
      exact ⟨⟨A₃, hEt₃⟩, hle₁, hle₂⟩
    have hFilt_ℐ : CategoryTheory.IsFiltered ℐ := inferInstance

    let D : CategoryTheory.Functor ℐ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of ↥i.1
        map := fun {i j} h => CommRingCat.ofHom (Subalgebra.inclusion (leOfHom h)).toRingHom
        map_id := fun _ => by ext x; rfl
        map_comp := fun _ _ => by ext x; rfl }
    let α_D : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R)) D :=
      { app := fun i => CommRingCat.ofHom (algebraMap R ↥i.1)
        naturality := fun _ _ _ => by ext r; rfl }
    let colim_c : CategoryTheory.Limits.Cocone D :=
      { pt := CommRingCat.of K_sep
        ι :=
          { app := fun i => CommRingCat.ofHom i.1.val.toRingHom
            naturality := fun _ _ _ => by ext x; rfl } }
    let e_pt : CategoryTheory.Iso colim_c.pt (CommRingCat.of K_sep) :=
      CategoryTheory.Iso.refl (CommRingCat.of K_sep)

    have hExh : ∀ x : K_sep, ∃ i : ℐ, x ∈ i.1 := by
      intro x
      obtain ⟨A_x, hEt_x, hSub_x⟩ := hMasterEtale {x}
      exact ⟨⟨A_x, hEt_x⟩, hSub_x (Finset.mem_coe.mpr (Finset.mem_singleton_self x))⟩

    let hColim_c : CategoryTheory.Limits.IsColimit colim_c :=
      let idx : K_sep → ℐ := fun x => Classical.choose (hExh x)
      let mem_idx : ∀ x : K_sep, x ∈ (idx x).1 := fun x => Classical.choose_spec (hExh x)
      { desc := fun s =>
          let fn : K_sep → ↥s.pt := fun x => (s.ι.app (idx x)).hom ⟨x, mem_idx x⟩
          have hIndep : ∀ (x : K_sep) (i : ℐ) (hx : x ∈ i.1),
              fn x = (s.ι.app i).hom ⟨x, hx⟩ := by
            intro x i hx
            obtain ⟨k_ub, h₁, h₂⟩ := hDir_ℐ.directed (idx x) i
            have hw₁ := congrArg (fun f => f.hom ⟨x, mem_idx x⟩) (s.w (homOfLE h₁))
            have hw₂ := congrArg (fun f => f.hom ⟨x, hx⟩) (s.w (homOfLE h₂))
            exact hw₁.symm.trans hw₂
          let i₀ : ℐ := Classical.arbitrary ℐ
          CommRingCat.ofHom
            { toFun := fn
              map_one' := (hIndep 1 i₀ i₀.1.one_mem).trans (map_one (s.ι.app i₀).hom)
              map_mul' := fun x y => by
                obtain ⟨k_ub, h₁, h₂⟩ := hDir_ℐ.directed (idx x) (idx y)
                have hx_k : x ∈ k_ub.1 := h₁ (mem_idx x)
                have hy_k : y ∈ k_ub.1 := h₂ (mem_idx y)
                rw [hIndep x k_ub hx_k, hIndep y k_ub hy_k,
                  hIndep (x * y) k_ub (k_ub.1.mul_mem hx_k hy_k)]
                exact map_mul (s.ι.app k_ub).hom ⟨x, hx_k⟩ ⟨y, hy_k⟩
              map_zero' := (hIndep 0 i₀ i₀.1.zero_mem).trans (map_zero (s.ι.app i₀).hom)
              map_add' := fun x y => by
                obtain ⟨k_ub, h₁, h₂⟩ := hDir_ℐ.directed (idx x) (idx y)
                have hx_k : x ∈ k_ub.1 := h₁ (mem_idx x)
                have hy_k : y ∈ k_ub.1 := h₂ (mem_idx y)
                rw [hIndep x k_ub hx_k, hIndep y k_ub hy_k,
                  hIndep (x + y) k_ub (k_ub.1.add_mem hx_k hy_k)]
                exact map_add (s.ι.app k_ub).hom ⟨x, hx_k⟩ ⟨y, hy_k⟩ }
        fac := fun s i => by
          ext ⟨x, hx⟩
          change (s.ι.app (idx x)).hom ⟨x, mem_idx x⟩ = (s.ι.app i).hom ⟨x, hx⟩
          obtain ⟨k_ub, h₁, h₂⟩ := hDir_ℐ.directed (idx x) i
          have hw₁ := congrArg (fun f => f.hom ⟨x, mem_idx x⟩) (s.w (homOfLE h₁))
          have hw₂ := congrArg (fun f => f.hom ⟨x, hx⟩) (s.w (homOfLE h₂))
          exact hw₁.symm.trans hw₂
        uniq := fun s m_hom hm => by
          ext x
          exact congrArg (fun f => f.hom ⟨x, mem_idx x⟩) (hm (idx x)) }

    refine ⟨K_sep, inferInstance, inferInstance, inferInstance, φ_sep,
      ℐ, inferInstance, hFilt_ℐ, D, α_D, colim_c, hColim_c, e_pt,
      hcomp_φ_sep, ?_, ?_⟩
    · intro i
      exact RingHom.etale_algebraMap.mpr i.2
    · intro i
      exact CommRingCat.hom_ext (RingHom.ext fun _ => rfl)

  
  
  
  have hStep5_core : ∀ (c : ℕ) (hc_le : c ≤ m)
      (P_c P_m K₀ : Type u)
      [CommRing P_c] [IsDomain P_c] [Algebra k P_c]
      [CommRing P_m] [IsDomain P_m] [Algebra k P_m] [Algebra.FiniteType k P_m]
      [Field K₀] [Algebra P_c K₀] [IsFractionRing P_c K₀]
      [Algebra k K₀] [IsScalarTower k P_c K₀]
      (ψ : P_c →ₐ[k] P_m) (ev_m : P_m →+* κ)
      (M_c : Submonoid P_m)
      (D₀ : Type u) [CommRing D₀] [Algebra P_m D₀] [IsLocalization M_c D₀]
      [Algebra k D₀] [IsScalarTower k P_m D₀],
      Algebra.trdeg k P_c = (c : Cardinal.{u}) →
      Algebra.trdeg k P_m = (m : Cardinal.{u}) →
      (∃ g_gen : Fin m → P_m, Algebra.adjoin k (Set.range g_gen) = ⊤) →
      M_c = (nonZeroDivisors P_c).map ψ.toMonoidHom →
      Function.Injective ψ →
      Function.Injective (ev_m.comp ψ.toRingHom) →
      ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra κ R₁)
        (_ : Algebra.FiniteType κ R₁)
        (σ : R₁ →ₐ[κ] κ) (ι_Pm : P_m →+* R₁),
        ringKrullDim R₁ ≤ ((m - c : ℕ) : WithBot ℕ∞) ∧
        σ.toRingHom.comp ι_Pm = ev_m ∧
        CategoryTheory.IsPushout
          (CommRingCat.ofHom (ev_m.comp ψ.toRingHom))
          (CommRingCat.ofHom ψ.toRingHom)
          (CommRingCat.ofHom (algebraMap κ R₁))
          (CommRingCat.ofHom ι_Pm) := by
    intro c hc_le P_c P_m K₀ _ _ _ _ _ _ _ _ _ _ _ _ ψ ev_m M_c D₀ _ _ _ _ _
      htr_Pc htr_Pm hGen_Pm hMc_eq hψ_inj hφ₀_inj
    let φ₀ : P_c →+* κ := ev_m.comp ψ.toRingHom
    have hφ₀_units : ∀ y_el : nonZeroDivisors P_c, IsUnit (φ₀ y_el) := by
      intro y_el
      have hy0 : (y_el : P_c) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y_el.2
      exact Ne.isUnit (fun h0 => hy0 (hφ₀_inj (h0.trans (map_zero φ₀).symm)))
    let ι_K₀ : K₀ →+* κ := IsLocalization.lift (M := nonZeroDivisors P_c) hφ₀_units
    have hι_K₀_comp : ι_K₀.comp (algebraMap P_c K₀) = φ₀ :=
      RingHom.ext fun r => IsLocalization.lift_eq hφ₀_units r

    have hMc_le : M_c ≤ nonZeroDivisors P_m := by
      rw [hMc_eq]
      rintro _ ⟨s, hs, rfl⟩
      have hs0 : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
      exact mem_nonZeroDivisors_iff_ne_zero.mpr
        (fun h0 => hs0 (hψ_inj (h0.trans (map_zero ψ).symm)))
    have _ : IsDomain D₀ := IsLocalization.isDomain_of_le_nonZeroDivisors D₀ hMc_le
    have hψ_loc_units : ∀ y_el : nonZeroDivisors P_c,
        IsUnit (((algebraMap P_m D₀).comp ψ.toRingHom) y_el) := by
      intro y_el
      have hmem : ψ y_el.1 ∈ M_c := by
        rw [hMc_eq]
        exact ⟨y_el.1, y_el.2, rfl⟩
      exact IsLocalization.map_units D₀ ⟨ψ y_el.1, hmem⟩
    let j_K₀ : K₀ →+* D₀ := IsLocalization.lift (M := nonZeroDivisors P_c) hψ_loc_units
    have hj_K₀_comp : j_K₀.comp (algebraMap P_c K₀) = (algebraMap P_m D₀).comp ψ.toRingHom :=
      RingHom.ext fun r => IsLocalization.lift_eq hψ_loc_units r

    have hPkg_R₁ :
        ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra κ R₁)
          (_ : Algebra.FiniteType κ R₁)
          (σ : R₁ →ₐ[κ] κ) (ι_Pm : P_m →+* R₁),
          (let _ : Algebra K₀ κ := ι_K₀.toAlgebra
           let _ : Algebra K₀ D₀ := j_K₀.toAlgebra
           Nonempty (R₁ ≃+* TensorProduct K₀ κ D₀)) ∧
          σ.toRingHom.comp ι_Pm = ev_m ∧
          CategoryTheory.IsPushout
            (CommRingCat.ofHom φ₀)
            (CommRingCat.ofHom ψ.toRingHom)
            (CommRingCat.ofHom (algebraMap κ R₁))
            (CommRingCat.ofHom ι_Pm) := by
      let _ : Algebra P_c κ := φ₀.toAlgebra
      let _ : Algebra P_c P_m := ψ.toRingHom.toAlgebra
      have _ : IsScalarTower k P_c P_m :=
        IsScalarTower.of_algebraMap_eq fun a => (ψ.commutes a).symm
      have _ : Algebra.FiniteType P_c P_m :=
        Algebra.FiniteType.of_restrictScalars_finiteType k P_c P_m
      let R₁ := TensorProduct P_c κ P_m
      let ι_Pm : P_m →+* R₁ :=
        (Algebra.TensorProduct.includeRight : P_m →ₐ[P_c] R₁).toRingHom
      have hPush₁ : CategoryTheory.IsPushout
          (CommRingCat.ofHom φ₀)
          (CommRingCat.ofHom ψ.toRingHom)
          (CommRingCat.ofHom (algebraMap κ R₁))
          (CommRingCat.ofHom ι_Pm) :=
        CommRingCat.isPushout_tensorProduct P_c κ P_m
      let ev_alg : P_m →ₐ[P_c] κ := { ev_m with commutes' := fun _ => rfl }
      let σ₀ : R₁ →ₐ[P_c] κ :=
        Algebra.TensorProduct.lift (AlgHom.id P_c κ) ev_alg (fun _ _ => Commute.all _ _)
      let σ : R₁ →ₐ[κ] κ :=
        { σ₀.toRingHom with
          commutes' := fun x => by
            change σ₀ (x ⊗ₜ[P_c] 1) = x
            rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one] }
      have hσ_ev : σ.toRingHom.comp ι_Pm = ev_m :=
        RingHom.ext fun p => by
          change σ₀ (1 ⊗ₜ[P_c] p) = ev_m p
          rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, one_mul]
          rfl

      have hIso_R₁_R₂ :
          (let _ : Algebra K₀ κ := ι_K₀.toAlgebra
           let _ : Algebra K₀ D₀ := j_K₀.toAlgebra
           Nonempty (R₁ ≃+* TensorProduct K₀ κ D₀)) := by
        let _ : Algebra K₀ κ := ι_K₀.toAlgebra
        let _ : Algebra K₀ D₀ := j_K₀.toAlgebra
        let R₂ := TensorProduct K₀ κ D₀
        let i₁ : κ →+* R₁ := @algebraMap κ R₁ _ _ Algebra.TensorProduct.leftAlgebra
        let i₂ : κ →+* R₂ := @algebraMap κ R₂ _ _ Algebra.TensorProduct.leftAlgebra
        let ι_D₀ : D₀ →+* R₂ :=
          (Algebra.TensorProduct.includeRight : D₀ →ₐ[K₀] R₂).toRingHom
        have hPush₂ : CategoryTheory.IsPushout
            (CommRingCat.ofHom ι_K₀)
            (CommRingCat.ofHom j_K₀)
            (CommRingCat.ofHom i₂)
            (CommRingCat.ofHom ι_D₀) :=
          CommRingCat.isPushout_tensorProduct K₀ κ D₀
        have hw₁ : CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom φ₀) (CommRingCat.ofHom i₂) =
            CategoryTheory.CategoryStruct.comp
              (CommRingCat.ofHom ψ.toRingHom)
              (CommRingCat.ofHom (ι_D₀.comp (algebraMap P_m D₀))) := by
          apply CommRingCat.hom_ext
          refine RingHom.ext fun r => ?_
          have hw := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hPush₂.w)
            (algebraMap P_c K₀ r)
          have h1 := DFunLike.congr_fun hι_K₀_comp r
          have h2 := DFunLike.congr_fun hj_K₀_comp r
          change i₂ (φ₀ r) = ι_D₀ (algebraMap P_m D₀ (ψ r))
          have h1' : ι_K₀ (algebraMap P_c K₀ r) = φ₀ r := h1
          have hw' : i₂ (ι_K₀ (algebraMap P_c K₀ r)) = ι_D₀ (j_K₀ (algebraMap P_c K₀ r)) := hw
          have h2' : j_K₀ (algebraMap P_c K₀ r) = algebraMap P_m D₀ (ψ r) := h2
          rw [← h1', hw', h2']
        let f₁₂ := hPush₁.desc (CommRingCat.ofHom i₂)
          (CommRingCat.ofHom (ι_D₀.comp (algebraMap P_m D₀))) hw₁
        have hMc_units_R₁ : ∀ y_el : M_c, IsUnit (ι_Pm y_el) := by
          intro y_el
          have hy_mem : y_el.1 ∈ (nonZeroDivisors P_c).map ψ.toMonoidHom := hMc_eq ▸ y_el.2
          rcases hy_mem with ⟨s, hs, hs_eq⟩
          have hs_eq' : ψ s = y_el.1 := hs_eq
          have hw_s : i₁ (φ₀ s) = ι_Pm (ψ s) :=
            DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hPush₁.w) s
          change IsUnit (ι_Pm y_el.1)
          rw [← hs_eq', ← hw_s]
          exact (hφ₀_units ⟨s, hs⟩).map i₁
        let g_D₀ : D₀ →+* R₁ := IsLocalization.lift (M := M_c) hMc_units_R₁
        have hg_D₀_comp : g_D₀.comp (algebraMap P_m D₀) = ι_Pm :=
          RingHom.ext fun p => IsLocalization.lift_eq hMc_units_R₁ p
        have hw₂_ring : i₁.comp ι_K₀ = g_D₀.comp j_K₀ := by
          apply IsLocalization.ringHom_ext (nonZeroDivisors P_c)
          refine RingHom.ext fun r => ?_
          have h1 : ι_K₀ (algebraMap P_c K₀ r) = φ₀ r := DFunLike.congr_fun hι_K₀_comp r
          have h2 : j_K₀ (algebraMap P_c K₀ r) = algebraMap P_m D₀ (ψ r) :=
            DFunLike.congr_fun hj_K₀_comp r
          have h3 : g_D₀ (algebraMap P_m D₀ (ψ r)) = ι_Pm (ψ r) :=
            DFunLike.congr_fun hg_D₀_comp (ψ r)
          have hw_r : i₁ (φ₀ r) = ι_Pm (ψ r) :=
            DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hPush₁.w) r
          change i₁ (ι_K₀ (algebraMap P_c K₀ r)) = g_D₀ (j_K₀ (algebraMap P_c K₀ r))
          rw [h1, h2, h3, hw_r]
        have hw₂ : CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom ι_K₀) (CommRingCat.ofHom i₁) =
            CategoryTheory.CategoryStruct.comp
              (CommRingCat.ofHom j_K₀) (CommRingCat.ofHom g_D₀) := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hw₂_ring]
        let f₂₁ := hPush₂.desc (CommRingCat.ofHom i₁) (CommRingCat.ofHom g_D₀) hw₂
        have hf₁₂_₂₁ : CategoryTheory.CategoryStruct.comp f₁₂ f₂₁ =
            CategoryTheory.CategoryStruct.id (CommRingCat.of R₁) := by
          apply hPush₁.hom_ext
          · rw [← CategoryTheory.Category.assoc, hPush₁.inl_desc, hPush₂.inl_desc,
              CategoryTheory.Category.comp_id]
          · rw [← CategoryTheory.Category.assoc, hPush₁.inr_desc,
              CommRingCat.ofHom_comp, CategoryTheory.Category.assoc,
              hPush₂.inr_desc, ← CommRingCat.ofHom_comp, hg_D₀_comp,
              CategoryTheory.Category.comp_id]
        have hf₂₁_₁₂ : CategoryTheory.CategoryStruct.comp f₂₁ f₁₂ =
            CategoryTheory.CategoryStruct.id (CommRingCat.of R₂) := by
          apply hPush₂.hom_ext
          · rw [← CategoryTheory.Category.assoc, hPush₂.inl_desc, hPush₁.inl_desc,
              CategoryTheory.Category.comp_id]
          · rw [← CategoryTheory.Category.assoc, hPush₂.inr_desc,
              CategoryTheory.Category.comp_id]
            apply CommRingCat.hom_ext
            apply IsLocalization.ringHom_ext M_c
            change (f₁₂.hom.comp g_D₀).comp (algebraMap P_m D₀) = ι_D₀.comp (algebraMap P_m D₀)
            rw [RingHom.comp_assoc, hg_D₀_comp]
            exact congrArg CommRingCat.Hom.hom (hPush₁.inr_desc _ _ hw₁)
        exact ⟨{ f₁₂.hom with
          invFun := f₂₁.hom
          left_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hf₁₂_₂₁) x
          right_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hf₂₁_₁₂) x }⟩

      exact ⟨R₁, inferInstance, inferInstance, inferInstance, σ, ι_Pm,
        hIso_R₁_R₂, hσ_ev, hPush₁⟩

    obtain ⟨R₁, hRingR₁, hAlgR₁, hFTR₁, σ, ι_Pm, ⟨e_R₁_R₂⟩, hσ_ev, hPush₁⟩ := hPkg_R₁

    have hDim_R₂ :
        (let _ : Algebra K₀ κ := ι_K₀.toAlgebra
         let _ : Algebra K₀ D₀ := j_K₀.toAlgebra
         ringKrullDim (TensorProduct K₀ κ D₀) ≤ ((m - c : ℕ) : WithBot ℕ∞)) := by
      let _ : Algebra K₀ κ := ι_K₀.toAlgebra
      let _ : Algebra K₀ D₀ := j_K₀.toAlgebra
      have _ : IsScalarTower k K₀ D₀ := by
        refine IsScalarTower.of_algebraMap_eq fun a => ?_
        calc
          algebraMap k D₀ a = algebraMap P_m D₀ (algebraMap k P_m a) :=
            IsScalarTower.algebraMap_apply k P_m D₀ a
          _ = algebraMap P_m D₀ (ψ (algebraMap k P_c a)) := by rw [ψ.commutes]
          _ = j_K₀ (algebraMap P_c K₀ (algebraMap k P_c a)) :=
            (DFunLike.congr_fun hj_K₀_comp (algebraMap k P_c a)).symm
          _ = j_K₀ (algebraMap k K₀ a) := by
            rw [← IsScalarTower.algebraMap_apply k P_c K₀ a]
      obtain ⟨g_gen, hg_gen⟩ := hGen_Pm
      have _ : Algebra.FiniteType K₀ D₀ := by
        refine ⟨⟨Finset.univ.image (fun i : Fin m => algebraMap P_m D₀ (g_gen i)), ?_⟩⟩
        apply top_unique
        intro z _
        set A_gen : Subalgebra K₀ D₀ :=
          Algebra.adjoin K₀
            ((Finset.univ.image (fun i : Fin m => algebraMap P_m D₀ (g_gen i)) :
              Finset D₀) : Set D₀)
        let φ_Pm_D₀ : P_m →ₐ[k] D₀ := IsScalarTower.toAlgHom k P_m D₀
        have hPm_mem : ∀ p : P_m, algebraMap P_m D₀ p ∈ A_gen := by
          intro p
          have hp_top : p ∈ (⊤ : Subalgebra k P_m) := trivial
          rw [← hg_gen] at hp_top
          have hp_map : φ_Pm_D₀ p ∈ (Algebra.adjoin k (Set.range g_gen)).map φ_Pm_D₀ :=
            ⟨p, hp_top, rfl⟩
          rw [AlgHom.map_adjoin] at hp_map
          have hsub_k : (Algebra.adjoin k (φ_Pm_D₀ '' Set.range g_gen) : Set D₀) ⊆ A_gen := by
            refine Algebra.adjoin_le (S := A_gen.restrictScalars k) ?_
            rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
            exact Algebra.subset_adjoin
              (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i)))
          exact hsub_k hp_map
        obtain ⟨⟨p, m_el⟩, hsurj⟩ := IsLocalization.surj M_c z
        have hm_mem : m_el.1 ∈ (nonZeroDivisors P_c).map ψ.toMonoidHom := hMc_eq ▸ m_el.2
        rcases hm_mem with ⟨s, hs, hs_eq⟩
        have hs_eq' : ψ s = m_el.1 := hs_eq
        have hs0 : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
        have hus_ne : algebraMap P_c K₀ s ≠ 0 :=
          fun h0 => hs0 (IsFractionRing.injective P_c K₀ (h0.trans (map_zero _).symm))
        have hinv_mul : algebraMap K₀ D₀ (algebraMap P_c K₀ s)⁻¹ *
            algebraMap P_m D₀ m_el.1 = 1 := by
          have hj_s : algebraMap P_m D₀ (ψ s) = j_K₀ (algebraMap P_c K₀ s) :=
            (DFunLike.congr_fun hj_K₀_comp s).symm
          rw [← hs_eq', hj_s]
          change j_K₀ (algebraMap P_c K₀ s)⁻¹ * j_K₀ (algebraMap P_c K₀ s) = 1
          rw [← map_mul, inv_mul_cancel₀ hus_ne, map_one]
        have hz_eq : z = algebraMap K₀ D₀ (algebraMap P_c K₀ s)⁻¹ * algebraMap P_m D₀ p := by
          calc
            z = z * 1 := (mul_one z).symm
            _ = z * (algebraMap K₀ D₀ (algebraMap P_c K₀ s)⁻¹ * algebraMap P_m D₀ m_el.1) := by
              rw [hinv_mul]
            _ = algebraMap K₀ D₀ (algebraMap P_c K₀ s)⁻¹ * (z * algebraMap P_m D₀ m_el.1) := by
              ring
            _ = algebraMap K₀ D₀ (algebraMap P_c K₀ s)⁻¹ * algebraMap P_m D₀ p := by
              rw [hsurj]
        rw [hz_eq]
        exact A_gen.mul_mem (A_gen.algebraMap_mem _) (hPm_mem p)

      obtain ⟨s₀, g₁, hg₁_inj, hg₁_fin⟩ := exists_finite_inj_algHom_of_fg K₀ D₀
      have hg₁_int : g₁.toRingHom.IsIntegral := by
        have hInt : @Algebra.IsIntegral (MvPolynomial (Fin s₀) K₀) D₀ _ _ g₁.toRingHom.toAlgebra :=
          @Algebra.IsIntegral.of_finite (MvPolynomial (Fin s₀) K₀) D₀ _ _
            g₁.toRingHom.toAlgebra hg₁_fin
        exact fun d => @Algebra.IsIntegral.isIntegral (MvPolynomial (Fin s₀) K₀) D₀ _ _
          g₁.toRingHom.toAlgebra hInt d

      have hs₀_le_sub : s₀ ≤ m - c := by
        have hg₁_aeval : MvPolynomial.aeval (fun i : Fin s₀ => g₁ (MvPolynomial.X i)) = g₁ := by
          apply MvPolynomial.algHom_ext
          intro i
          exact MvPolynomial.aeval_X _ i
        have hAlgInd : AlgebraicIndependent K₀ (fun i : Fin s₀ => g₁ (MvPolynomial.X i)) := by
          rw [algebraicIndependent_iff_injective_aeval, hg₁_aeval]
          exact hg₁_inj
        have hs₀_trdeg : (s₀ : Cardinal.{u}) ≤ Algebra.trdeg K₀ D₀ := by
          have hlift := hAlgInd.lift_cardinalMk_le_trdeg
          simpa only [Cardinal.mk_fintype, Fintype.card_fin, Cardinal.lift_natCast,
            Cardinal.lift_uzero] using hlift
        have _ : Algebra.IsAlgebraic P_c K₀ :=
          IsLocalization.isAlgebraic K₀ (nonZeroDivisors P_c)
        have _ : FaithfulSMul P_c K₀ :=
          (faithfulSMul_iff_algebraMap_injective P_c K₀).mpr (IsFractionRing.injective P_c K₀)
        have htr_Pc_K₀ : Algebra.trdeg P_c K₀ = 0 := trdeg_eq_zero
        have htrdeg_K₀ : Algebra.trdeg k K₀ = (c : Cardinal.{u}) := by
          rw [← trdeg_add_eq k P_c, htr_Pc_K₀, add_zero, htr_Pc]
        have _ : Algebra.IsAlgebraic P_m D₀ := by
          refine ⟨fun z => ?_⟩
          obtain ⟨⟨p, m_el, hm_el⟩, hsurj⟩ := IsLocalization.surj M_c z
          have hm_ne : m_el ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp (hMc_le hm_el)
          let P_alg : Polynomial P_m := Polynomial.C m_el * Polynomial.X - Polynomial.C p
          have hP_ne : P_alg ≠ 0 := by
            intro h0
            have hc1 := congrArg (fun f => Polynomial.coeff f 1) h0
            simp [P_alg] at hc1
            exact hm_ne hc1
          refine ⟨P_alg, hP_ne, ?_⟩
          dsimp [P_alg]
          rw [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, Polynomial.aeval_C,
            mul_comm, hsurj, sub_self]
        have hPm_D₀_inj : Function.Injective (algebraMap P_m D₀) :=
          IsLocalization.injective D₀ hMc_le
        have _ : FaithfulSMul P_m D₀ :=
          (faithfulSMul_iff_algebraMap_injective P_m D₀).mpr hPm_D₀_inj
        have htr_Pm_D₀ : Algebra.trdeg P_m D₀ = 0 := trdeg_eq_zero
        have htrdeg_D₀ : Algebra.trdeg k D₀ = (m : Cardinal.{u}) := by
          rw [← trdeg_add_eq k P_m, htr_Pm_D₀, add_zero, htr_Pm]
        have hsum_card : ((c + s₀ : ℕ) : Cardinal.{u}) ≤ (m : Cardinal.{u}) := by
          push_cast
          calc
            (c : Cardinal.{u}) + (s₀ : Cardinal.{u}) ≤
                Algebra.trdeg k K₀ + Algebra.trdeg K₀ D₀ := by
              rw [htrdeg_K₀]
              exact add_le_add_right hs₀_trdeg _
            _ = Algebra.trdeg k D₀ := trdeg_add_eq k K₀
            _ = (m : Cardinal.{u}) := htrdeg_D₀
        have hsum_nat : c + s₀ ≤ m := Nat.cast_le.mp hsum_card
        omega

      let R₂ := TensorProduct K₀ κ D₀
      let G_κ : MvPolynomial (Fin s₀) κ →ₐ[κ] R₂ :=
        MvPolynomial.aeval (fun i : Fin s₀ => (1 : κ) ⊗ₜ[K₀] g₁ (MvPolynomial.X i))
      let μ_coeff : MvPolynomial (Fin s₀) K₀ →+* MvPolynomial (Fin s₀) κ :=
        MvPolynomial.map (algebraMap K₀ κ)
      let ι_D₀ : D₀ →+* R₂ :=
        (Algebra.TensorProduct.includeRight : D₀ →ₐ[K₀] R₂).toRingHom
      have hG_μ_comp : G_κ.toRingHom.comp μ_coeff = ι_D₀.comp g₁.toRingHom := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          change G_κ (MvPolynomial.map (algebraMap K₀ κ) (MvPolynomial.C a)) =
            (1 : κ) ⊗ₜ[K₀] g₁ (algebraMap K₀ (MvPolynomial (Fin s₀) K₀) a)
          rw [MvPolynomial.map_C, g₁.commutes]
          change G_κ (algebraMap κ (MvPolynomial (Fin s₀) κ) (algebraMap K₀ κ a)) =
            (Algebra.TensorProduct.includeRight : D₀ →ₐ[K₀] R₂) (algebraMap K₀ D₀ a)
          rw [G_κ.commutes, (Algebra.TensorProduct.includeRight : D₀ →ₐ[K₀] R₂).commutes]
          rfl
        · intro i
          change G_κ (MvPolynomial.map (algebraMap K₀ κ) (MvPolynomial.X i)) =
            (1 : κ) ⊗ₜ[K₀] g₁ (MvPolynomial.X i)
          rw [MvPolynomial.map_X]
          exact MvPolynomial.aeval_X _ i
      have hG_κ_int : G_κ.toRingHom.IsIntegral := by
        intro z
        induction z using TensorProduct.inductionOn with
        | tmul x d =>
          have hx_int : G_κ.toRingHom.IsIntegralElem (x ⊗ₜ[K₀] (1 : D₀)) := by
            have hx_eq : x ⊗ₜ[K₀] (1 : D₀) = G_κ.toRingHom (MvPolynomial.C x) :=
              (G_κ.commutes x).symm
            rw [hx_eq]
            exact RingHom.isIntegralElem_map G_κ.toRingHom
          have hd_int : G_κ.toRingHom.IsIntegralElem ((1 : κ) ⊗ₜ[K₀] d) := by
            obtain ⟨P, hP_mon, hP_eval⟩ := hg₁_int d
            refine ⟨P.map μ_coeff, hP_mon.map μ_coeff, ?_⟩
            rw [Polynomial.eval₂_map, hG_μ_comp]
            change Polynomial.eval₂ (ι_D₀.comp g₁.toRingHom) (ι_D₀ d) P = 0
            rw [← Polynomial.hom_eval₂, hP_eval, map_zero]
          have hprod : x ⊗ₜ[K₀] d = (x ⊗ₜ[K₀] (1 : D₀)) * ((1 : κ) ⊗ₜ[K₀] d) := by
            simp
          rw [hprod]
          exact RingHom.IsIntegralElem.mul G_κ.toRingHom hx_int hd_int
        | add u v hu hv =>
          exact RingHom.IsIntegralElem.add G_κ.toRingHom hu hv

      calc
        ringKrullDim R₂ ≤ ringKrullDim (MvPolynomial (Fin s₀) κ) :=
          hKrullLe_of_isIntegral G_κ.toRingHom hG_κ_int
        _ = (s₀ : WithBot ℕ∞) := hKrullMvPoly κ s₀
        _ ≤ ((m - c : ℕ) : WithBot ℕ∞) := by exact_mod_cast hs₀_le_sub

    let _ : CommRing R₁ := hRingR₁
    let _ : Algebra κ R₁ := hAlgR₁
    let _ : Algebra.FiniteType κ R₁ := hFTR₁
    refine ⟨R₁, hRingR₁, hAlgR₁, hFTR₁, σ, ι_Pm, ?_, hσ_ev, hPush₁⟩
    let _ : Algebra K₀ κ := ι_K₀.toAlgebra
    let _ : Algebra K₀ D₀ := j_K₀.toAlgebra
    rw [ringKrullDim_eq_of_ringEquiv e_R₁_R₂]
    exact hDim_R₂

  
  
  
  obtain ⟨c, hc_le, ψ, hDim_y, hInj_quot, hInt_quot, hBij_cm⟩ :=
    hStep2 (y : PrimeSpectrum (MvPolynomial (Fin m) k))
  let P_c := MvPolynomial (Fin c) k
