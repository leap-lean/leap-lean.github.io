  obtain ⟨U_Z, hUZ_obj, hUZ_map, hAdd_UZ, hLim_UZ, hColim_UZ, T_Z, hT_Z, _, _, hθ_Z_rest⟩ := hθ_Z
  obtain ⟨u_unit_Z, hu_unit_Z, βM_Z, hαβ_Z, hβα_Z, hθZ_eq⟩ := hθ_Z_rest
  have hHasComp_Z : Z.smallEtaleTopology.HasSheafCompose FgtMod :=
    ⟨fun P hP => by
