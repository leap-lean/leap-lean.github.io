    let e_base : B ≃+* MvPolynomial (Fin (n + (d - 1))) R := e_base_alg.toRingEquiv
    let f_crit : MvPolynomial (Fin (n + (d - 1))) R →+* S_slice :=
      (((algebraMap Q_slice S_slice).comp (Ideal.Quotient.mk I_slice)).comp
