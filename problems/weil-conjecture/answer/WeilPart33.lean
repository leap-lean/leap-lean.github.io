    have hu_Rtilde : IsUnit (locMap ((1 : P₂) ⊗ₜ[B₂] s_el.1)) := by
      have heq : locMap ((1 : P₂) ⊗ₜ[B₂] s_el.1) = ι_R (algebraMap D R_loc s_el.1) := by
        change (Algebra.TensorProduct.includeLeft (R := B₂) (S := B₂) (A := P₂) (B := R_loc) 1) *
          (ι_R (algebraMap D R_loc s_el.1)) = _
        rw [map_one, one_mul]
