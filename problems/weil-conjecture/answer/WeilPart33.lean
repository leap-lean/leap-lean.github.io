    have hev_bar_comp : ev_bar.comp (π.comp ψ.toRingHom) = φ₀ :=
      RingHom.ext fun _ => rfl
    intro s
    obtain ⟨Q_poly, hQ_mon, hQ_eval⟩ := hInt_quot (π s)
    refine ⟨Q_poly, hQ_mon, ?_⟩
    have hpush := Polynomial.hom_eval₂ Q_poly (π.comp ψ.toRingHom) ev_bar (π s)
