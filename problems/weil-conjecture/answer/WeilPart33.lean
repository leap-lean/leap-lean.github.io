      exact ((Algebra.TensorProduct.includeLeft : B α →ₐ[Ω] TensorProduct Ω (B α) S).commutes c).trans
        ((Algebra.TensorProduct.includeRight : S →ₐ[Ω] TensorProduct Ω (B α) S).commutes c).symm
    let ψ : ∀ α : Fin (N' + 1 + 1),
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω (B α) S)) ⟶ W_S :=
      fun α => CategoryTheory.Limits.pullback.lift (i_L α ≫ (hAff α).fromSpec) (i_R α) (hcomm α)
    have hψ_fst : ∀ α : Fin (N' + 1 + 1), ψ α ≫ fst_S = i_L α ≫ (hAff α).fromSpec :=
      fun α => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hψ_snd : ∀ α : Fin (N' + 1 + 1), ψ α ≫ snd_S = i_R α :=
      fun α => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPB : ∀ α : Fin (N' + 1 + 1),
        CategoryTheory.IsPullback (i_L α) (ψ α) (hAff α).fromSpec fst_S := by
      intro α
      let s_ΩB := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (B α)))
      have hIncL : (Algebra.TensorProduct.includeLeft : B α →ₐ[Ω] TensorProduct Ω (B α) S).toRingHom =
