      apply RingHom.ext
      intro q
      change β_slice (α_slice (algebraMap Q_slice S_slice q)) = algebraMap Q_slice S_slice q
      rw [IsLocalization.Away.lift_eq]
      change β_slice (algebraMap Q_G S_G (bar_ev q)) = _
      rw [IsLocalization.Away.lift_eq]
      change algebraMap Q_slice S_slice ((bar_inc.comp bar_ev) q) = _
      rw [hinc_ev_G, RingHom.id_apply]
    have hαβ_slice : α_slice.comp β_slice = RingHom.id S_G := by
      apply IsLocalization.ringHom_ext (Submonoid.powers bar_g)
      apply RingHom.ext
      intro q
