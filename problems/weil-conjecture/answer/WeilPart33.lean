          rw [map_mul] at hu_gb
          have hu_exc : IsUnit (ι_b g_exc) := isUnit_of_mul_isUnit_right hu_gb
          exact (hu_exc.map (χ.comp (Ideal.Quotient.mk I_hb))).ne_zero
        have hεu_h0 : ε_u h_0 = 0 := by
          change χ (Ideal.Quotient.mk I_hb (ι_b h_0)) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self (ι_b h_0)),
            map_zero]
        exact hVanish ε_u hεu_id hεu_exc hεu_h0
      have hmem_hb : ι_b (φ_0 p_disc) ∈ I_hb :=
        Ideal.Quotient.eq_zero_iff_mem.mp ha_zero
      obtain ⟨c_b, hc_b⟩ := Ideal.mem_span_singleton.mp hmem_hb
      let n_sec : ℕ := (IsLocalization.Away.sec g_b c_b).2
      let r_sec : R'_0 := (IsLocalization.Away.sec g_b c_b).1
      have hsec : c_b * ι_b (g_b ^ n_sec) = ι_b r_sec :=
        IsLocalization.Away.sec_spec g_b c_b
      have hloc_eq : ι_b (g_b ^ n_sec * φ_0 p_disc) = ι_b (r_sec * h_0) := by
        rw [map_mul, map_mul, hc_b]
        calc
          ι_b (g_b ^ n_sec) * (ι_b h_0 * c_b) = (c_b * ι_b (g_b ^ n_sec)) * ι_b h_0 := by ring
          _ = ι_b r_sec * ι_b h_0 := by rw [hsec]
      obtain ⟨k_pow, hk_pow⟩ :=
        IsLocalization.Away.exists_of_eq (S := R_b) g_b hloc_eq
      let G_c : R'_0 := g_b ^ k_pow * g_b ^ n_sec
      let c_tilde : R'_0 := g_b ^ k_pow * r_sec
      have hEq_R0 : G_c * φ_0 p_disc = c_tilde * h_0 := by
        dsimp [G_c, c_tilde]
        calc
          (g_b ^ k_pow * g_b ^ n_sec) * φ_0 p_disc =
              g_b ^ k_pow * (g_b ^ n_sec * φ_0 p_disc) := by ring
          _ = g_b ^ k_pow * (r_sec * h_0) := hk_pow
          _ = (g_b ^ k_pow * r_sec) * h_0 := by ring
      have hG_ne : ε_0 G_c ≠ 0 := by
        dsimp [G_c]
        rw [map_mul, map_pow, map_pow]
        exact mul_ne_zero (pow_ne_zero k_pow hgb_ne) (pow_ne_zero n_sec hgb_ne)
      have hDeriv_eq : ∀ a : Fin 2,
          ε_0 G_c * MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv a p_disc) =
            ε_0 c_tilde * ε_0 (D_0 a h_0) := by
        intro a
        have h1 : ε_0 (D_0 a (G_c * φ_0 p_disc)) =
            ε_0 G_c * MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv a p_disc) := by
          rw [(hD_lin a G_c (φ_0 p_disc)).2, hD_φ a p_disc, map_add,
            map_mul ε_0 G_c, map_mul ε_0 (φ_0 p_disc),
            hε_0 (MvPolynomial.pderiv a p_disc), hε_0 p_disc, hp_zero, zero_mul, add_zero]
        have h2 : ε_0 (D_0 a (c_tilde * h_0)) = ε_0 c_tilde * ε_0 (D_0 a h_0) := by
          rw [(hD_lin a c_tilde h_0).2, map_add,
            map_mul ε_0 c_tilde, map_mul ε_0 h_0, hε_h0, zero_mul, add_zero]
        rw [← h1, ← h2, hEq_R0]
      have hc_ne : ε_0 c_tilde ≠ 0 := by
        rcases hp_grad with hd0 | hd1
        · have h0 := hDeriv_eq 0
          have hlhs : ε_0 G_c * MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv 0 p_disc) ≠ 0 :=
            mul_ne_zero hG_ne hd0
          rw [h0] at hlhs
          exact left_ne_zero_of_mul hlhs
        · have h1 := hDeriv_eq 1
          have hlhs : ε_0 G_c * MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv 1 p_disc) ≠ 0 :=
            mul_ne_zero hG_ne hd1
          rw [h1] at hlhs
          exact left_ne_zero_of_mul hlhs
      exact ⟨G_c, c_tilde, hG_ne, hc_ne, hEq_R0, hDeriv_eq⟩
    refine ⟨?_, ?_⟩
    · 
      intro hp0
      rcases hD_or with h0 | h1
      · exact h0
      · obtain ⟨G_c, c_tilde, hG_ne, _, _, hDeriv_eq⟩ := hFactor 1 h1
        have h0 := hDeriv_eq 0
        have hlhs : ε_0 G_c * MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv 0 p_disc) ≠ 0 :=
          mul_ne_zero hG_ne hp0
        rw [h0] at hlhs
        exact right_ne_zero_of_mul hlhs
    · 
      intro b_lead hb_lead
      obtain ⟨G_c, c_tilde, hG_ne, hc_ne, hEq_R0, _⟩ := hFactor b_lead hb_lead
      let g_match : R'_0 := D_0 b_lead h_0 * G_c * c_tilde
      refine ⟨g_match, ?_, ?_⟩
      · dsimp [g_match]
        rw [map_mul, map_mul]
        exact mul_ne_zero (mul_ne_zero hb_lead hG_ne) hc_ne
      · intro R'_2 ι_2 ψ_B2
        have hψ_et : ψ_B2.Etale :=
          (hCoordSwap R'_0 φ_0 hφ_0_et D_0 hD_lin hD_φ h_0 b_lead
            (g_exc * g_match) (g_exc * G_c * c_tilde) (by dsimp [g_match]; ring)).1
        refine ⟨hψ_et, fun u => ?_⟩
        have hu_tot : IsUnit (ι_2 (g_exc * g_match)) :=
          IsLocalization.Away.algebraMap_isUnit (g_exc * g_match)
        have hmul_G : ι_2 (g_exc * g_match) =
            ι_2 G_c * ι_2 (g_exc * D_0 b_lead h_0 * c_tilde) :=
          (congrArg ι_2 (by dsimp [g_match]; ring :
            g_exc * g_match = G_c * (g_exc * D_0 b_lead h_0 * c_tilde))).trans
            (map_mul ι_2 G_c (g_exc * D_0 b_lead h_0 * c_tilde))
        have hu_G : IsUnit (ι_2 G_c) :=
          isUnit_of_mul_isUnit_left (Eq.mp (congrArg IsUnit hmul_G) hu_tot)
        have hmul_c : ι_2 (g_exc * g_match) =
            ι_2 c_tilde * ι_2 (g_exc * D_0 b_lead h_0 * G_c) :=
          (congrArg ι_2 (by dsimp [g_match]; ring :
            g_exc * g_match = c_tilde * (g_exc * D_0 b_lead h_0 * G_c))).trans
            (map_mul ι_2 c_tilde (g_exc * D_0 b_lead h_0 * G_c))
        have hu_c : IsUnit (ι_2 c_tilde) :=
          isUnit_of_mul_isUnit_left (Eq.mp (congrArg IsUnit hmul_c) hu_tot)
        rcases hu_G with ⟨u_G, hu_G_eq⟩
        rcases hu_c with ⟨u_c, hu_c_eq⟩
        have hEq_R2 : (u_G : R'_2) * ι_2 (φ_0 p_disc) = (u_c : R'_2) * ι_2 h_0 :=
          calc
            (u_G : R'_2) * ι_2 (φ_0 p_disc) = ι_2 G_c * ι_2 (φ_0 p_disc) :=
              congrArg (· * ι_2 (φ_0 p_disc)) hu_G_eq
            _ = ι_2 (G_c * φ_0 p_disc) := (map_mul ι_2 G_c (φ_0 p_disc)).symm
            _ = ι_2 (c_tilde * h_0) := congrArg ι_2 hEq_R0
            _ = ι_2 c_tilde * ι_2 h_0 := map_mul ι_2 c_tilde h_0
            _ = (u_c : R'_2) * ι_2 h_0 := congrArg (· * ι_2 h_0) hu_c_eq.symm
        constructor
        · intro hp_mem
          have hh_eq : ι_2 h_0 = (↑u_c⁻¹ * ↑u_G) * ι_2 (φ_0 p_disc) :=
            calc
              ι_2 h_0 = 1 * ι_2 h_0 := (one_mul _).symm
              _ = ((↑u_c⁻¹ : R'_2) * (u_c : R'_2)) * ι_2 h_0 :=
                congrArg (· * ι_2 h_0) (Units.inv_mul u_c).symm
              _ = (↑u_c⁻¹ : R'_2) * ((u_c : R'_2) * ι_2 h_0) := mul_assoc _ _ _
              _ = (↑u_c⁻¹ : R'_2) * ((u_G : R'_2) * ι_2 (φ_0 p_disc)) :=
                congrArg ((↑u_c⁻¹ : R'_2) * ·) hEq_R2.symm
              _ = (↑u_c⁻¹ * ↑u_G) * ι_2 (φ_0 p_disc) := (mul_assoc _ _ _).symm
          exact Eq.mpr (congrArg (· ∈ u.asIdeal) hh_eq) (u.asIdeal.mul_mem_left _ hp_mem)
        · intro hh_mem
          have hp_eq : ι_2 (φ_0 p_disc) = (↑u_G⁻¹ * ↑u_c) * ι_2 h_0 :=
            calc
              ι_2 (φ_0 p_disc) = 1 * ι_2 (φ_0 p_disc) := (one_mul _).symm
              _ = ((↑u_G⁻¹ : R'_2) * (u_G : R'_2)) * ι_2 (φ_0 p_disc) :=
                congrArg (· * ι_2 (φ_0 p_disc)) (Units.inv_mul u_G).symm
              _ = (↑u_G⁻¹ : R'_2) * ((u_G : R'_2) * ι_2 (φ_0 p_disc)) := mul_assoc _ _ _
              _ = (↑u_G⁻¹ : R'_2) * ((u_c : R'_2) * ι_2 h_0) :=
                congrArg ((↑u_G⁻¹ : R'_2) * ·) hEq_R2
              _ = (↑u_G⁻¹ * ↑u_c) * ι_2 h_0 := (mul_assoc _ _ _).symm
          exact Eq.mpr (congrArg (· ∈ u.asIdeal) hp_eq) (u.asIdeal.mul_mem_left _ hh_mem)

theorem weil_algClosed_projPlane_shifted_chart_and_line_boundary (k : Type u) [Field k] [IsAlgClosed k]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (ι_line : weilProjectiveSpaceOver k 1 ⟶ weilProjectiveSpaceOver k 2)
    (hCoord_line : IsStandardProjLineCoord k j_aff s_inf)
    (hLine_plane : IsStandardProjLineInPlane k ι_line)
    (S_aff : Finset k)
    (U₀ : (weilProjectiveSpaceOver k 1).left.Opens)
    (D_disc : ℕ)
    (P_disc : MvPolynomial (Fin 3) k)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver k 2)
    (U_disc_reg : C_disc.left.Opens)
    (hD_pos : 1 ≤ D_disc)
    (hHyp_disc : IsHomogeneousHypersurfacePullbackOver k 2 D_disc
      (𝟙 (weilProjectiveSpaceOver k 2)) P_disc ι_disc.left)
    (hSm_Udisc : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_disc_reg.ι ≫ C_disc.hom))
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver k 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (hImg_line : ι_line.left.base '' ((U₀ : Set _)ᶜ) ⊆
      ι_disc.left.base '' (U_disc_reg : Set C_disc.left))
    (hpderiv_inf : MvPolynomial.eval ![0, 1, 0] (MvPolynomial.pderiv (0 : Fin 3) P_disc) ≠ 0)
    (hpderiv_aff : ∀ a ∈ S_aff,
      MvPolynomial.eval ![1, a, 0] (MvPolynomial.pderiv (1 : Fin 3) P_disc) ≠ 0)
    (hRatPt : ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      IsProjectiveOverField k X →
      ∀ (x : X.left), IsClosed ({x} : Set X.left) →
        ∃ q_x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X.left,
          q_x ≫ X.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
          x ∈ Set.range q_x.base) :
    let 𝒜_2 := MvPolynomial.homogeneousSubmodule (Fin 3) k
    letI : GradedAlgebra 𝒜_2 := MvPolynomial.gradedAlgebra
    (∀ (β : Fin 3) (w : Fin 3 → k), w β ≠ 0 →
      let U_P := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X β)
      let p_disc := MvPolynomial.eval₂Hom MvPolynomial.C (weilProjPlaneShiftedCoordVec k β w) P_disc
      ∃ j_P : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
          (weilProjectiveSpaceOver k 2).left,
        AlgebraicGeometry.IsOpenImmersion j_P ∧
        Set.range j_P.base = U_P.1 ∧
        j_P ≫ (weilProjectiveSpaceOver k 2).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ∧
        (∀ (h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens) ≤
            (TopologicalSpace.Opens.map j_P.base).obj U_P)
           (r : Fin 3),
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X β)
              (MvPolynomial.isHomogeneous_X k β) zero_lt_one).hom ≫
            j_P.appLE U_P ⊤ h_le ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 2) k))).hom).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
                ⟨MvPolynomial.X β, MvPolynomial.isHomogeneous_X k β⟩, ⟨1, pow_one _⟩⟩) =
            weilProjPlaneShiftedCoordVec k β w r) ∧
        j_P.base ⁻¹' (Set.range ι_disc.left.base) =
          { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
            p_disc ∈ p.asIdeal } ∧
        (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ), F ∈ 𝒜_2 d →
          (F ∈ ProjectiveSpectrum.asHomogeneousIdeal
            (j_P.base ⟨RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k)),
              RingHom.ker_isPrime _⟩) ↔
            MvPolynomial.eval w F = 0)) ∧
        (∀ c₀ : C_disc.left, c₀ ∈ U_disc_reg → IsClosed ({c₀} : Set C_disc.left) →
          (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ), F ∈ 𝒜_2 d →
            (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c₀) ↔
              MvPolynomial.eval w F = 0)) →
          j_P.base ⟨RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k)),
            RingHom.ker_isPrime _⟩ = ι_disc.left.base c₀ ∧
          MvPolynomial.eval (0 : Fin 2 → k) p_disc = 0 ∧
          ∃ (S_c : Type u) (_ : CommRing S_c) (_ : Algebra k S_c)
            (ε_S : S_c →+* k)
            (ψ_1 : MvPolynomial (Fin 1) k →+* S_c)
            (ψ_hyp : (MvPolynomial (Fin 2) k ⧸ Ideal.span {p_disc}) →+* S_c),
            ε_S.comp (algebraMap k S_c) = RingHom.id k ∧
            ψ_1.comp MvPolynomial.C = algebraMap k S_c ∧
            ψ_1.Etale ∧
            ψ_hyp.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap k S_c ∧
            ψ_hyp.Etale ∧
            ∀ b : Fin 2,
              ψ_hyp (Ideal.Quotient.mk _ (MvPolynomial.X b)) ∈ RingHom.ker ε_S)) ∧
    (∀ (b_idx : Fin 2)
       (s_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left),
      ((b_idx = 1 ∧ s_pt = s_inf) ∨
        (∃ a ∈ S_aff, b_idx = 0 ∧
          s_pt = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫
            j_aff)) →
      ∃ c₀ : C_disc.left,
        c₀ ∈ U_disc_reg ∧
        IsClosed ({c₀} : Set C_disc.left) ∧
        (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
          ι_disc.left.base c₀ = (s_pt ≫ ι_line.left).base pt) ∧
        ∀ w : Fin 3 → k, w ≠ 0 →
          (∀ (F : MvPolynomial (Fin 3) k) (d : ℕ), F ∈ 𝒜_2 d →
            (F ∈ ProjectiveSpectrum.asHomogeneousIdeal (ι_disc.left.base c₀) ↔
              MvPolynomial.eval w F = 0)) →
          w b_idx.castSucc ≠ 0 ∧
          w 2 = 0 ∧
          weilProjPlaneShiftedCoordVec k b_idx.castSucc w 2 = MvPolynomial.X 1 ∧
          MvPolynomial.eval (0 : Fin 2 → k)
            (MvPolynomial.pderiv (0 : Fin 2)
              (MvPolynomial.eval₂Hom MvPolynomial.C
                (weilProjPlaneShiftedCoordVec k b_idx.castSucc w) P_disc)) ≠ 0 ∧
          ∀ (j_P : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
              (weilProjectiveSpaceOver k 2).left),
            Set.range j_P.base =
              (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b_idx.castSucc)).1 →
            j_P ≫ (weilProjectiveSpaceOver k 2).hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) →
            (∀ (h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens) ≤
                (TopologicalSpace.Opens.map j_P.base).obj
                  (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b_idx.castSucc)))
               (r : Fin 3),
              ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_2 (MvPolynomial.X b_idx.castSucc)
                  (MvPolynomial.isHomogeneous_X k b_idx.castSucc) zero_lt_one).hom ≫
                j_P.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X b_idx.castSucc))
                  ⊤ h_le ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso
                  (CommRingCat.of (MvPolynomial (Fin 2) k))).hom).hom
                (HomogeneousLocalization.mk
                  ⟨1, ⟨MvPolynomial.X r, MvPolynomial.isHomogeneous_X k r⟩,
                    ⟨MvPolynomial.X b_idx.castSucc,
                      MvPolynomial.isHomogeneous_X k b_idx.castSucc⟩,
                    ⟨1, pow_one _⟩⟩) =
                weilProjPlaneShiftedCoordVec k b_idx.castSucc w r) →
            AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (MvPolynomial.eval (0 : Fin 2 → k))) ≫ j_P =
              s_pt ≫ ι_line.left) :=
by
  classical
  intro 𝒜_2
  let _ : GradedAlgebra 𝒜_2 := MvPolynomial.gradedAlgebra
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  let _ : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
  
  have hSpec_k_subsingleton : Subsingleton (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    refine ⟨fun p q => PrimeSpectrum.ext ?_⟩
    have hp : p.asIdeal = ⊥ := (Ideal.eq_bot_or_top p.asIdeal).resolve_right p.isPrime.ne_top
    have hq : q.asIdeal = ⊥ := (Ideal.eq_bot_or_top q.asIdeal).resolve_right q.isPrime.ne_top
    exact hp.trans hq.symm
  have h_appLE_congr : ∀ {X Y : Scheme.{u}} {f₁ f₂ : X ⟶ Y} (hf : f₁ = f₂)
      (U : Y.Opens) (V : X.Opens)
      (h₁ : V ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (h₂ : V ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      f₁.appLE U V h₁ = f₂.appLE U V h₂ := by
    rintro _ _ _ _ rfl _ _ _ _
    rfl
  have hFromSpec_app : ∀ {X : Scheme.{u}} {U : X.Opens} (hAff : IsAffineOpen U)
      {R : CommRingCat.{u}} (φ : X.presheaf.obj (Opposite.op U) ⟶ R)
      (h_le : (⊤ : (Spec R).Opens) ≤
        (TopologicalSpace.Opens.map (Spec.map φ ≫ hAff.fromSpec).base).obj U),
      (Spec.map φ ≫ hAff.fromSpec).appLE U ⊤ h_le ≫ (Scheme.ΓSpecIso R).hom = φ := by
    intro X U hAff R φ h_le
    have h_from : (⊤ : (Spec (X.presheaf.obj (Opposite.op U))).Opens) ≤
        (TopologicalSpace.Opens.map hAff.fromSpec.base).obj U := by
      intro p _
      change hAff.fromSpec.base p ∈ U
      rw [← hAff.isoSpec_inv_ι]
      exact (hAff.isoSpec.inv.base p).2
    have hcomp := Scheme.Hom.appLE_comp_appLE (Spec.map φ) hAff.fromSpec U ⊤ ⊤ h_from le_top
    rw [hcomp.symm, Category.assoc]
    have happTop : (Spec.map φ).appLE ⊤ ⊤ le_top = (Spec.map φ).appTop := rfl
    rw [happTop, Scheme.ΓSpecIso_naturality φ]
    have h_all_op : ∀ (f : Opposite.op (⊤ : (Spec (X.presheaf.obj (Opposite.op U))).Opens) ⟶
        Opposite.op (⊤ : (Spec (X.presheaf.obj (Opposite.op U))).Opens)),
        (Spec (X.presheaf.obj (Opposite.op U))).presheaf.map f = 𝟙 _ := by
      intro f
      rw [Subsingleton.elim f (𝟙 _), CategoryTheory.Functor.map_id]
    have hself : hAff.fromSpec.appLE U ⊤ h_from =
        (Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv := by
      rw [Scheme.Hom.appLE, hAff.fromSpec_app_self, Category.assoc,
        ← CategoryTheory.Functor.map_comp, h_all_op, Category.comp_id]
    rw [hself, Iso.inv_hom_id_assoc]
  have hFromSpec_fac : ∀ {X : Scheme.{u}} {U : X.Opens} (hAff : IsAffineOpen U)
      {R : CommRingCat.{u}} (g : Spec R ⟶ X)
      (h_le : (⊤ : (Spec R).Opens) ≤ (TopologicalSpace.Opens.map g.base).obj U),
      g = Spec.map (g.appLE U ⊤ h_le ≫ (Scheme.ΓSpecIso R).hom) ≫ hAff.fromSpec := by
    intro X U hAff R g h_le
    have hsub : Set.range g.base ⊆ Set.range hAff.fromSpec.base := by
      rintro _ ⟨p, rfl⟩
      have hpU : g.base p ∈ U := h_le (by trivial : p ∈ (⊤ : (Spec R).Opens))
      refine ⟨hAff.isoSpec.hom.base ⟨g.base p, hpU⟩, ?_⟩
