      intro A₁ A₂ e r hSub
      refine subsingleton_of_forall_eq 0 (fun x => ?_)
      have hx : x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero r) = 0 :=
