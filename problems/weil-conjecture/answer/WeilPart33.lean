import WeilPart32
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_algClosed_proj_hyperplane_swap_shear_centering (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (N' : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsProper W.hom]
    (hDimP : topologicalKrullDim (weilProjectiveSpaceOver Ω (N' + 1)).left =
      ((N' + 1 : ℕ) : WithBot ℕ∞))
    (ι_W : W ⟶ weilProjectiveSpaceOver Ω (N' + 1))
    (hCl_W : AlgebraicGeometry.IsClosedImmersion ι_W.left)
    (F : MvPolynomial (Fin (N' + 1 + 1)) Ω)
    (hF_hom : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω 1)
    (hF_ne : F ≠ 0)
    (K₁ : Set W.left)
    (hCl_K₁ : IsClosed K₁)
    (hNe_K₁ : K₁.Nonempty)
    (hK₁_sub : ∀ w ∈ K₁, ι_W.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F) :
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    ∃ (b₀ : W.left)
      (q₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left)
      (ι₁ : W ⟶ weilProjectiveSpaceOver Ω (N' + 1))
      (c_F : Fin (N' + 1) → Ω),
      let F₁ : MvPolynomial (Fin (N' + 1 + 1)) Ω :=
        ∑ β : Fin (N' + 1), MvPolynomial.C (c_F β) * MvPolynomial.X β.succ
      b₀ ∈ K₁ ∧
      IsClosed ({b₀} : Set W.left) ∧
      q₀ ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
      Set.range q₀.base = {b₀} ∧
      AlgebraicGeometry.IsClosedImmersion ι₁.left ∧
      c_F ≠ 0 ∧
      F₁ ∈ 𝒜 1 ∧
      F₁ ≠ 0 ∧
      (∀ w : W.left,
        ι₁.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F₁ ↔
        ι_W.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F) ∧
      ι₁.left.base b₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) ∧
      (∀ β : Fin (N' + 1),
        ι₁.left.base b₀ ∈ weilProjHyperplaneSet Ω (N' + 1) (MvPolynomial.X β.succ)) ∧
      (∀ p : (weilProjectiveSpaceOver Ω (N' + 1)).left,
        p ≠ ι₁.left.base b₀ →
        ∃ β : Fin (N' + 1),
          p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β.succ)) :=
by
  classical
  intro 𝒜 hGA
  let _ : GradedAlgebra 𝒜 := hGA
  let M : ℕ := N' + 1

  have hAlg0_val : ∀ r : Ω,
      ((algebraMap Ω ↥(𝒜 0) r : ↥(𝒜 0)) : MvPolynomial (Fin (M + 1)) Ω) =
        MvPolynomial.C r := by
    intro r
    rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul, SetLike.GradeZero.coe_one,
      Algebra.smul_def, MvPolynomial.algebraMap_eq, mul_one]

  
  have hCov_X : ∀ y : ↥(AlgebraicGeometry.Proj 𝒜),
      ∃ a : Fin (M + 1), y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) := by
    intro y
    by_contra! hNone
    let I_all : Ideal (MvPolynomial (Fin (M + 1)) Ω) :=
      Ideal.span (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) Ω))
    have hI_le : I_all ≤ y.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      exact (not_iff_comm.mp (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X a) y)).mp
        (hNone a)
    have hDiff_all : ∀ Q : MvPolynomial (Fin (M + 1)) Ω,
        Q - MvPolynomial.C (MvPolynomial.constantCoeff Q) ∈ I_all := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C r =>
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact I_all.zero_mem
      | add p q hp hq =>
        have heq : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
          rw [map_add, map_add]
          ring
        rw [heq]
        exact I_all.add_mem hp hq
      | mul_X p a _ =>
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
        exact I_all.mul_mem_left p (Ideal.subset_span ⟨a, rfl⟩)
    apply y.not_irrelevant_le
    rw [HomogeneousIdeal.irrelevant_le]
    intro d hd Q hQ
    have hQ_hom : Q.IsHomogeneous d := hQ
    have hdeg0 : Finsupp.degree (0 : Fin (M + 1) →₀ ℕ) ≠ d := by
      rw [map_zero]
      exact Nat.ne_of_lt hd
    have hc0 : MvPolynomial.constantCoeff Q = 0 := by
      rw [MvPolynomial.constantCoeff_eq]
      exact hQ_hom.coeff_eq_zero hdeg0
    have hQ_mem : Q ∈ I_all := by
      simpa [hc0] using hDiff_all Q
    exact hI_le hQ_mem

  
  have _ : AlgebraicGeometry.IsClosedImmersion ι_W.left := hCl_W
  obtain ⟨w_init, hw_init⟩ := hNe_K₁
  obtain ⟨a₀, hp_init⟩ := hCov_X (ι_W.left.base w_init)
  let U_a₀ : (AlgebraicGeometry.Proj 𝒜).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a₀)
  have hXa₀ : (MvPolynomial.X a₀ : MvPolynomial (Fin (M + 1)) Ω) ∈ 𝒜 1 :=
    MvPolynomial.isHomogeneous_X Ω a₀
  let A₀ := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a₀)
  let iso_a₀ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one
  let away_hom := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one
  have h_away_eq : iso_a₀.inv ≫ U_a₀.ι = away_hom :=
    AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one

  let Z : Set ↥(AlgebraicGeometry.Proj 𝒜) := ι_W.left.base '' K₁
  have hCl_Z : IsClosed Z := ι_W.left.isClosedEmbedding.isClosedMap K₁ hCl_K₁
  let Z_aff : Set (PrimeSpectrum A₀) := away_hom.base ⁻¹' Z
  have hCl_Zaff : IsClosed Z_aff := hCl_Z.preimage away_hom.continuous

  let x_init : PrimeSpectrum A₀ := iso_a₀.hom.base ⟨ι_W.left.base w_init, hp_init⟩
  have hx_init_away : away_hom.base x_init = ι_W.left.base w_init := by
    change (iso_a₀.hom ≫ away_hom).base ⟨ι_W.left.base w_init, hp_init⟩ = _
    rw [← h_away_eq, CategoryTheory.Iso.hom_inv_id_assoc]
    rfl
  have hx_init_mem : x_init ∈ Z_aff := by
    change away_hom.base x_init ∈ Z
    rw [hx_init_away]
    exact ⟨w_init, hw_init, rfl⟩

  have hZero_Zaff :
      PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal Z_aff : Set A₀) = Z_aff :=
    (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure Z_aff).trans hCl_Zaff.closure_eq
  have hVan_le_init : PrimeSpectrum.vanishingIdeal Z_aff ≤ x_init.asIdeal := by
    intro a ha
    exact (PrimeSpectrum.mem_vanishingIdeal Z_aff a).mp ha x_init hx_init_mem
  have hVan_ne_top : PrimeSpectrum.vanishingIdeal Z_aff ≠ ⊤ := by
    intro htop
    apply x_init.isPrime.ne_top
    exact top_unique (htop ▸ hVan_le_init)

  obtain ⟨𝔪, h𝔪_max, hVan_le_𝔪⟩ := Ideal.exists_le_maximal _ hVan_ne_top
  let _ : 𝔪.IsMaximal := h𝔪_max
  let x_max : PrimeSpectrum A₀ := ⟨𝔪, h𝔪_max.isPrime⟩
  have hx_max_mem : x_max ∈ Z_aff := by
    rw [← hZero_Zaff, PrimeSpectrum.mem_zeroLocus]
    exact hVan_le_𝔪
  obtain ⟨b₀, hb₀_K₁, hb₀_eq_away⟩ : ∃ b₀ ∈ K₁, ι_W.left.base b₀ = away_hom.base x_max :=
    hx_max_mem
  let p₀ : ↥(AlgebraicGeometry.Proj 𝒜) := ι_W.left.base b₀
  have h_away_p : away_hom.base x_max = p₀ := hb₀_eq_away.symm
  have hp₀_a₀ : p₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a₀) := by
    change p₀ ∈ U_a₀
    rw [← h_away_p, ← h_away_eq]
    change U_a₀.ι.base (iso_a₀.inv.base x_max) ∈ U_a₀
    exact (iso_a₀.inv.base x_max).2

  
  let S_a₀ : Submonoid (MvPolynomial (Fin (M + 1)) Ω) := Submonoid.powers (MvPolynomial.X a₀)
  let d₁ : ↥S_a₀ := ⟨MvPolynomial.X a₀, Submonoid.mem_powers (MvPolynomial.X a₀)⟩
  have hMk_add_same : ∀ (d : ↥S_a₀) (a b : MvPolynomial (Fin (M + 1)) Ω),
      Localization.mk a d + Localization.mk b d = Localization.mk (a + b) d := by
    intro d a b
    calc Localization.mk a d + Localization.mk b d
        = Localization.mk ((d : MvPolynomial (Fin (M + 1)) Ω) * (a + b)) (d * d) := by
            rw [Localization.add_mk]
            congr 1
            ring
      _ = Localization.mk (d : MvPolynomial (Fin (M + 1)) Ω) d * Localization.mk (a + b) d := by
            rw [Localization.mk_mul]
      _ = Localization.mk (a + b) d := by
            rw [Localization.mk_self, one_mul]
  have hMk_sum : ∀ {ι_s : Type} (d : ↥S_a₀) (T : Finset ι_s)
      (a : ι_s → MvPolynomial (Fin (M + 1)) Ω),
      (∑ t ∈ T, Localization.mk (a t) d) = Localization.mk (∑ t ∈ T, a t) d := by
    intro ι_s d T a
    induction T using Finset.cons_induction with
    | empty =>
      simp only [Finset.sum_empty]
      have h0 : Localization.mk (0 : MvPolynomial (Fin (M + 1)) Ω) d +
          Localization.mk (0 : MvPolynomial (Fin (M + 1)) Ω) d =
          Localization.mk (0 : MvPolynomial (Fin (M + 1)) Ω) d + 0 := by
        rw [hMk_add_same, add_zero, add_zero]
      exact (add_left_cancel h0).symm
    | cons t T _ ih =>
      rw [Finset.sum_cons, Finset.sum_cons, ih, hMk_add_same]
  have hMk_prod : ∀ {ι_s : Type} (T : Finset ι_s)
      (a : ι_s → MvPolynomial (Fin (M + 1)) Ω) (d : ι_s → ↥S_a₀),
      (∏ t ∈ T, Localization.mk (a t) (d t)) = Localization.mk (∏ t ∈ T, a t) (∏ t ∈ T, d t) := by
    intro ι_s T a d
    induction T using Finset.cons_induction with
    | empty =>
      simp only [Finset.prod_empty, Localization.mk_one]
    | cons t T _ ih =>
      rw [Finset.prod_cons, Finset.prod_cons, Finset.prod_cons, ih, Localization.mk_mul]

  let ι₀_Ω : Ω →+* A₀ :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a₀).comp (algebraMap Ω ↥(𝒜 0))
  let y_gen : Fin (M + 1) → A₀ :=
    fun b => HomogeneousLocalization.Away.isLocalizationElem hXa₀ (MvPolynomial.isHomogeneous_X Ω b)
  let ψ_dehom : MvPolynomial (Fin (M + 1)) Ω →+* A₀ :=
    MvPolynomial.eval₂Hom ι₀_Ω y_gen
  let valHom : A₀ →+* Localization S_a₀ :=
    { toFun := HomogeneousLocalization.val
      map_one' := HomogeneousLocalization.val_one
      map_mul' := HomogeneousLocalization.val_mul
      map_zero' := HomogeneousLocalization.val_zero
      map_add' := HomogeneousLocalization.val_add }

  have hVal_ι₀ : ∀ r : Ω, valHom (ι₀_Ω r) = Localization.mk (MvPolynomial.C r) 1 := by
    intro r
    change (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a₀ (algebraMap Ω ↥(𝒜 0) r)).val = _
    erw [HomogeneousLocalization.val_mk]
    congr 1 <;>
      simp only [hAlg0_val, Subtype.ext_iff, SetLike.GradeZero.coe_one, Submonoid.coe_one]

  have hVal_y : ∀ b : Fin (M + 1), valHom (y_gen b) = Localization.mk (MvPolynomial.X b) d₁ := by
    intro b
    change (HomogeneousLocalization.Away.isLocalizationElem hXa₀
      (MvPolynomial.isHomogeneous_X Ω b)).val = _
    rw [HomogeneousLocalization.Away.val_mk]
    congr 1 <;> simp only [Subtype.ext_iff, pow_one, d₁]

  have hSurj_dehom : Function.Surjective ψ_dehom := by
    intro z
    obtain ⟨n, Q_num, hQ_num, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hXa₀ z
    have hQ_hom : Q_num.IsHomogeneous n := by
      have hQ' : Q_num.IsHomogeneous (n • 1) := hQ_num
      rwa [nsmul_eq_mul, mul_one] at hQ'
    refine ⟨Q_num, ?_⟩
    apply HomogeneousLocalization.val_injective
    change valHom (ψ_dehom Q_num) = (HomogeneousLocalization.Away.mk 𝒜 hXa₀ n Q_num hQ_num).val
    rw [HomogeneousLocalization.Away.val_mk]
    have hLHS : valHom (ψ_dehom Q_num) = Localization.mk Q_num (d₁ ^ n) := by
      calc valHom (ψ_dehom Q_num)
          = ∑ s ∈ Q_num.support,
              valHom (ψ_dehom (MvPolynomial.monomial s (Q_num.coeff s))) := by
                conv_lhs => rw [MvPolynomial.as_sum Q_num]
                rw [map_sum, map_sum]
        _ = ∑ s ∈ Q_num.support,
              Localization.mk (MvPolynomial.monomial s (Q_num.coeff s)) (d₁ ^ n) := by
                refine Finset.sum_congr rfl (fun s hs => ?_)
                have hdeg_s : Finsupp.degree s = n := by
                  by_contra hne
                  exact (MvPolynomial.mem_support_iff.mp hs) (hQ_hom.coeff_eq_zero hne)
                have hsum_s : (∑ b : Fin (M + 1), s b) = n := by
                  rw [← Finsupp.degree_eq_sum]
                  exact hdeg_s
                change valHom (MvPolynomial.eval₂Hom ι₀_Ω y_gen
                  (MvPolynomial.monomial s (Q_num.coeff s))) = _
                rw [MvPolynomial.eval₂Hom_monomial, Finsupp.prod_pow, map_mul, map_prod,
                  hVal_ι₀]
                have hprod_eq :
                    (∏ b : Fin (M + 1), valHom (y_gen b ^ s b)) =
                      Localization.mk (∏ b : Fin (M + 1), MvPolynomial.X b ^ s b) (d₁ ^ n) := by
                  have hp1 : (∏ b : Fin (M + 1), valHom (y_gen b ^ s b)) =
                      ∏ b : Fin (M + 1), Localization.mk (MvPolynomial.X b ^ s b) (d₁ ^ s b) := by
                    refine Finset.prod_congr rfl (fun b _ => ?_)
                    rw [map_pow, hVal_y, Localization.mk_pow]
                  rw [hp1,
                    hMk_prod Finset.univ (fun b : Fin (M + 1) => MvPolynomial.X b ^ s b)
                      (fun b : Fin (M + 1) => d₁ ^ s b),
                    Finset.prod_pow_eq_pow_sum, hsum_s]
                rw [hprod_eq, Localization.mk_mul, one_mul, MvPolynomial.monomial_eq,
                  Finsupp.prod_pow]
        _ = Localization.mk
              (∑ s ∈ Q_num.support, MvPolynomial.monomial s (Q_num.coeff s)) (d₁ ^ n) :=
                hMk_sum (d₁ ^ n) Q_num.support _
        _ = Localization.mk Q_num (d₁ ^ n) := by
                rw [← MvPolynomial.as_sum Q_num]
    rw [hLHS]
    congr 1 <;> simp only [Subtype.ext_iff, d₁, Submonoid.coe_pow]

  have hMax_comap : (Ideal.comap ψ_dehom 𝔪).IsMaximal :=
    Ideal.comap_isMaximal_of_surjective ψ_dehom hSurj_dehom
  obtain ⟨v_pt, hv_pt⟩ :=
    (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hMax_comap
  let ev_poly : MvPolynomial (Fin (M + 1)) Ω →+* Ω := (MvPolynomial.aeval v_pt).toRingHom
  have hMem_iff : ∀ P : MvPolynomial (Fin (M + 1)) Ω,
      ψ_dehom P ∈ 𝔪 ↔ ev_poly P = 0 := by
    intro P
    change P ∈ Ideal.comap ψ_dehom 𝔪 ↔ (MvPolynomial.aeval v_pt) P = 0
    rw [hv_pt, MvPolynomial.mem_vanishingIdeal_iff]
    simp

  have hKer_le : ∀ P ∈ RingHom.ker ψ_dehom, ev_poly P = 0 := by
    intro P hP
    rw [← hMem_iff, RingHom.mem_ker.mp hP]
    exact 𝔪.zero_mem
  let q_equiv := RingHom.quotientKerEquivOfSurjective (f := ψ_dehom) hSurj_dehom
  let ev₀ : A₀ →+* Ω :=
    (Ideal.Quotient.lift (RingHom.ker ψ_dehom) ev_poly hKer_le).comp q_equiv.symm.toRingHom
  have hev₀_dehom : ∀ P : MvPolynomial (Fin (M + 1)) Ω,
      ev₀ (ψ_dehom P) = ev_poly P := by
    intro P
    dsimp [ev₀, q_equiv]
    rw [RingHom.quotientKerEquivOfSurjective_symm_apply hSurj_dehom P, Ideal.Quotient.lift_mk]
  have hKer_ev₀ : RingHom.ker ev₀ = 𝔪 := by
    ext z
    obtain ⟨P, rfl⟩ := hSurj_dehom z
    rw [RingHom.mem_ker, hev₀_dehom, ← hMem_iff]
  have hev₀_ι₀ : ∀ r : Ω, ev₀ (ι₀_Ω r) = r := by
    intro r
    have hCr : ψ_dehom (MvPolynomial.C r) = ι₀_Ω r :=
      MvPolynomial.eval₂Hom_C ι₀_Ω y_gen r
    rw [← hCr, hev₀_dehom]
    change (MvPolynomial.aeval v_pt) (MvPolynomial.C r) = r
    simp

  let π_M : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)))
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Proj 𝒜 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ away_hom
  have hs₀_sec : s₀ ≫ π_M = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    dsimp [s₀, π_M, away_hom]
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one),
      AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    have hHom_id :
        (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a₀)) ≫
          CommRingCat.ofHom ev₀ =
        𝟙 (CommRingCat.of Ω) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      exact hev₀_ι₀ r
    rw [hHom_id, AlgebraicGeometry.Spec.map_id]

  have _ : AlgebraicGeometry.IsSeparated π_M := by
    dsimp [π_M]
    infer_instance
  have _ : AlgebraicGeometry.IsClosedImmersion (s₀ ≫ π_M) := by
    rw [hs₀_sec]
    infer_instance
  have _ : AlgebraicGeometry.IsClosedImmersion s₀ :=
    AlgebraicGeometry.IsClosedImmersion.of_comp s₀ π_M

  have hs₀_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), s₀.base pt = p₀ := by
    intro pt
    have hSpec_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt = x_max := by
      apply PrimeSpectrum.ext
      change Ideal.comap ev₀ (pt : PrimeSpectrum Ω).asIdeal = 𝔪
      have hbot : (pt : PrimeSpectrum Ω).asIdeal = ⊥ :=
        @Ideal.eq_bot_of_prime Ω _ (pt : PrimeSpectrum Ω).asIdeal (pt : PrimeSpectrum Ω).isPrime
      rw [hbot]
      exact hKer_ev₀
    change away_hom.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt) = p₀
    rw [hSpec_pt, h_away_p]
  have hs₀_range : Set.range s₀.base = ({p₀} : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨pt, hpt⟩ => hpt.symm.trans (hs₀_pt pt),
      fun hy => ⟨default, (hs₀_pt default).trans hy.symm⟩⟩
  have hp₀_cl : IsClosed ({p₀} : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    rw [← hs₀_range]
    exact s₀.isClosedEmbedding.isClosed_range
  have hPre_b₀ : ι_W.left.base ⁻¹' ({p₀} : Set ↥(AlgebraicGeometry.Proj 𝒜)) =
      ({b₀} : Set W.left) := by
    ext w
    simp only [Set.mem_preimage, Set.mem_singleton_iff, p₀]
    exact ⟨fun hw => ι_W.left.isClosedEmbedding.injective hw, fun hw => hw ▸ rfl⟩
  have hb₀_cl : IsClosed ({b₀} : Set W.left) := by
    rw [← hPre_b₀]
    exact hp₀_cl.preimage ι_W.left.continuous

  let ι_W_proj : W.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι_W.left
  have _ : AlgebraicGeometry.IsClosedImmersion ι_W_proj := hCl_W
  let P_fib := CategoryTheory.Limits.pullback ι_W_proj s₀
  let π₁_fib : P_fib ⟶ W.left := CategoryTheory.Limits.pullback.fst ι_W_proj s₀
  let π₂_fib : P_fib ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    CategoryTheory.Limits.pullback.snd ι_W_proj s₀
  have _ : AlgebraicGeometry.IsClosedImmersion π₂_fib := by
    dsimp [π₂_fib]
    infer_instance
  have _ : AlgebraicGeometry.IsAffine P_fib := by
    dsimp [P_fib]
    infer_instance
  obtain ⟨z₀_fib, -, -⟩ :=
    AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
      (f := ι_W_proj) (g := s₀) b₀
      (default : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))) (hs₀_pt default).symm
  let B₀_fib : CommRingCat.{u} := P_fib.presheaf.obj (Opposite.op ⊤)
  let x₀_fib : PrimeSpectrum B₀_fib := P_fib.isoSpec.hom.base z₀_fib
  have _ : Nontrivial B₀_fib := by
    refine ⟨⟨0, 1, fun h01 => x₀_fib.isPrime.ne_top ?_⟩⟩
    rw [Ideal.eq_top_iff_one, ← h01]
    exact x₀_fib.asIdeal.zero_mem
  let g_aff : AlgebraicGeometry.Spec B₀_fib ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    P_fib.isoSpec.inv ≫ π₂_fib
  have hg_cl : AlgebraicGeometry.IsClosedImmersion g_aff := inferInstance
  let φ_fib : CommRingCat.of Ω ⟶ B₀_fib := AlgebraicGeometry.Spec.preimage g_aff
  have hSpec_φ : AlgebraicGeometry.Spec.map φ_fib = g_aff :=
    AlgebraicGeometry.Spec.map_preimage g_aff
  have hSurj_app : Function.Surjective (g_aff.app ⊤).hom :=
    (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hg_cl).2 ⊤
      (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
  have hSurj_φ : Function.Surjective φ_fib.hom := by
    have hSurj_map : Function.Surjective ((AlgebraicGeometry.Spec.map φ_fib).appTop).hom := by
      rw [hSpec_φ]
      exact hSurj_app
    intro b
    let eΩ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)
    let eB := AlgebraicGeometry.Scheme.ΓSpecIso B₀_fib
    have hnat : (AlgebraicGeometry.Spec.map φ_fib).appTop ≫ eB.hom = eΩ.hom ≫ φ_fib :=
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_fib
    obtain ⟨u, hu⟩ := hSurj_map (eB.inv.hom b)
    refine ⟨eΩ.hom.hom u, ?_⟩
    have h1 := congrArg
      (fun m : Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), ⊤) ⟶ B₀_fib => m.hom u) hnat.symm
    change φ_fib.hom (eΩ.hom.hom u) =
      eB.hom.hom (((AlgebraicGeometry.Spec.map φ_fib).appTop).hom u) at h1
    rw [hu] at h1
    have h2 : eB.hom.hom (eB.inv.hom b) = b :=
      congrArg (fun m : B₀_fib ⟶ B₀_fib => m.hom b) eB.inv_hom_id
    exact h1.trans h2
  have hBij_φ : Function.Bijective φ_fib.hom := ⟨φ_fib.hom.injective, hSurj_φ⟩
  let eqv_φ : Ω ≃+* B₀_fib := RingEquiv.ofBijective φ_fib.hom hBij_φ
  let ψ_fib : B₀_fib ⟶ CommRingCat.of Ω := CommRingCat.ofHom eqv_φ.symm.toRingHom
  have hφψ : φ_fib ≫ ψ_fib = 𝟙 (CommRingCat.of Ω) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    exact eqv_φ.symm_apply_apply r
  let q₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left :=
    AlgebraicGeometry.Spec.map ψ_fib ≫ P_fib.isoSpec.inv ≫ π₁_fib
  have hq₀_fac : q₀ ≫ ι_W_proj = s₀ := by
    calc q₀ ≫ ι_W_proj
        = AlgebraicGeometry.Spec.map ψ_fib ≫ P_fib.isoSpec.inv ≫
            (CategoryTheory.Limits.pullback.fst ι_W_proj s₀ ≫ ι_W_proj) := by
            dsimp [q₀, π₁_fib]
            simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map ψ_fib ≫ P_fib.isoSpec.inv ≫
            (CategoryTheory.Limits.pullback.snd ι_W_proj s₀ ≫ s₀) := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = (AlgebraicGeometry.Spec.map ψ_fib ≫ g_aff) ≫ s₀ := by
            dsimp [g_aff, π₂_fib]
            simp only [CategoryTheory.Category.assoc]
      _ = (AlgebraicGeometry.Spec.map ψ_fib ≫ AlgebraicGeometry.Spec.map φ_fib) ≫ s₀ := by
            rw [hSpec_φ]
      _ = AlgebraicGeometry.Spec.map (φ_fib ≫ ψ_fib) ≫ s₀ := by
            rw [← AlgebraicGeometry.Spec.map_comp]
      _ = s₀ := by
            rw [hφψ, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
  have hq₀_hom : q₀ ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    have hw : ι_W_proj ≫ π_M = W.hom := CategoryTheory.Over.w ι_W
    calc q₀ ≫ W.hom
        = (q₀ ≫ ι_W_proj) ≫ π_M := by
            rw [← hw]
            simp only [q₀, CategoryTheory.Category.assoc]
      _ = s₀ ≫ π_M := by rw [hq₀_fac]
      _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := hs₀_sec
  have hq₀_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), q₀.base pt = b₀ := by
    intro pt
    apply ι_W.left.isClosedEmbedding.injective
    have hpt_eq : (q₀ ≫ ι_W_proj).base pt = s₀.base pt :=
      congrArg
        (fun m : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Proj 𝒜 =>
          m.base pt) hq₀_fac
    exact hpt_eq.trans (hs₀_pt pt)
  have hq₀_range : Set.range q₀.base = ({b₀} : Set W.left) := by
    ext w
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨pt, hpt⟩ => hpt.symm.trans (hq₀_pt pt),
      fun hw => ⟨default, (hq₀_pt default).trans hw.symm⟩⟩

  let σ : Equiv.Perm (Fin (M + 1)) := Equiv.swap (0 : Fin (M + 1)) a₀
  let c : Fin M → Ω := fun β => v_pt (σ β.succ)

  have hp₀_not_Li : ∀ β : Fin M,
      p₀ ∉ AlgebraicGeometry.Proj.basicOpen 𝒜
        (MvPolynomial.X (σ β.succ) - MvPolynomial.C (c β) * MvPolynomial.X a₀) := by
    intro β
    let L_β : MvPolynomial (Fin (M + 1)) Ω :=
      MvPolynomial.X (σ β.succ) - MvPolynomial.C (c β) * MvPolynomial.X a₀
    have hXσ : (MvPolynomial.X (σ β.succ) : MvPolynomial (Fin (M + 1)) Ω) ∈ 𝒜 1 :=
      MvPolynomial.isHomogeneous_X Ω (σ β.succ)
    have hLβ : L_β ∈ 𝒜 1 := by
      refine Submodule.sub_mem _ hXσ ?_
      change (MvPolynomial.C (c β) * MvPolynomial.X a₀).IsHomogeneous 1
      simpa using (MvPolynomial.isHomogeneous_C (Fin (M + 1)) (c β)).mul
        (MvPolynomial.isHomogeneous_X Ω a₀)
    have hElem_eq :
        HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLβ =
          ψ_dehom (MvPolynomial.X (σ β.succ) - MvPolynomial.C (c β)) := by
      change HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLβ =
        MvPolynomial.eval₂Hom ι₀_Ω y_gen (MvPolynomial.X (σ β.succ) - MvPolynomial.C (c β))
      rw [map_sub, MvPolynomial.eval₂Hom_X' ι₀_Ω y_gen (σ β.succ),
        MvPolynomial.eval₂Hom_C ι₀_Ω y_gen (c β)]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.Away.val_mk]
      change Localization.mk (L_β ^ 1) _ =
        valHom (y_gen (σ β.succ)) - valHom (ι₀_Ω (c β))
      rw [hVal_y, hVal_ι₀, Localization.sub_mk]
      congr 1
      · simp only [Submonoid.coe_one, d₁, pow_one, L_β]
        ring
      · apply Subtype.ext
        simp [d₁]
    have hElem_mem : HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLβ ∈ x_max.asIdeal := by
      change HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLβ ∈ 𝔪
      rw [hElem_eq, hMem_iff]
      change (MvPolynomial.aeval v_pt) (MvPolynomial.X (σ β.succ) - MvPolynomial.C (c β)) = 0
      simp [c]
    intro hp_mem
    have hpre_mem : x_max ∈
        (TopologicalSpace.Opens.map away_hom.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 L_β) := by
      change away_hom.base x_max ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 L_β
      rwa [h_away_p]
    rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hXa₀ zero_lt_one hLβ zero_lt_one]
      at hpre_mem
    exact hpre_mem hElem_mem

  
  let F_gen : Fin (M + 1) → MvPolynomial (Fin (M + 1)) Ω :=
    Fin.cases (MvPolynomial.X a₀)
      (fun β : Fin M => MvPolynomial.X (σ β.succ) - MvPolynomial.C (c β) * MvPolynomial.X a₀)
  let G_gen : Fin (M + 1) → MvPolynomial (Fin (M + 1)) Ω := fun b =>
    Fin.cases (MvPolynomial.X 0)
      (fun β : Fin M => MvPolynomial.X β.succ + MvPolynomial.C (c β) * MvPolynomial.X 0) (σ b)

  have hFgen_hom : ∀ j : Fin (M + 1), (F_gen j).IsHomogeneous 1 := by
    refine Fin.cases ?_ (fun β => ?_)
    · exact MvPolynomial.isHomogeneous_X Ω a₀
    · dsimp [F_gen]
      have h1 : (MvPolynomial.X (σ β.succ) : MvPolynomial (Fin (M + 1)) Ω) ∈ 𝒜 1 :=
        MvPolynomial.isHomogeneous_X Ω (σ β.succ)
      have h2 : (MvPolynomial.C (c β) * MvPolynomial.X a₀ : MvPolynomial (Fin (M + 1)) Ω) ∈
          𝒜 1 := by
        change (MvPolynomial.C (c β) * MvPolynomial.X a₀).IsHomogeneous 1
        simpa using (MvPolynomial.isHomogeneous_C (Fin (M + 1)) (c β)).mul
          (MvPolynomial.isHomogeneous_X Ω a₀)
      exact Submodule.sub_mem _ h1 h2

  have hGgen_hom : ∀ b : Fin (M + 1), (G_gen b).IsHomogeneous 1 := by
    intro b
    dsimp only [G_gen]
    generalize σ b = u
    refine Fin.cases ?_ (fun β => ?_) u
    · exact MvPolynomial.isHomogeneous_X Ω 0
    · dsimp only [Fin.cases_succ]
      refine (MvPolynomial.isHomogeneous_X Ω β.succ).add ?_
      simpa using (MvPolynomial.isHomogeneous_C (Fin (M + 1)) (c β)).mul
        (MvPolynomial.isHomogeneous_X Ω 0)

  let Φ₀ : MvPolynomial (Fin (M + 1)) Ω →+* MvPolynomial (Fin (M + 1)) Ω :=
    MvPolynomial.eval₂Hom MvPolynomial.C F_gen
  let Ψ₀ : MvPolynomial (Fin (M + 1)) Ω →+* MvPolynomial (Fin (M + 1)) Ω :=
    MvPolynomial.eval₂Hom MvPolynomial.C G_gen

  let f : 𝒜 →+*ᵍ 𝒜 :=
    { toRingHom := Φ₀
      map_mem := fun {n p} hp => by
        have hp' : p.IsHomogeneous n := hp
        have hev := hp'.eval₂ MvPolynomial.C F_gen
          (fun r => MvPolynomial.isHomogeneous_C (Fin (M + 1)) r) hFgen_hom
        rw [Nat.one_mul] at hev
        exact hev }
  let g : 𝒜 →+*ᵍ 𝒜 :=
    { toRingHom := Ψ₀
      map_mem := fun {n p} hp => by
        have hp' : p.IsHomogeneous n := hp
        have hev := hp'.eval₂ MvPolynomial.C G_gen
          (fun r => MvPolynomial.isHomogeneous_C (Fin (M + 1)) r) hGgen_hom
        rw [Nat.one_mul] at hev
        exact hev }

  have hC : ∀ r : Ω, f (MvPolynomial.C r) = MvPolynomial.C r :=
    fun r => MvPolynomial.eval₂Hom_C MvPolynomial.C F_gen r
  have hf0 : f (MvPolynomial.X 0) = MvPolynomial.X a₀ := by
    change Φ₀ (MvPolynomial.X 0) = MvPolynomial.X a₀
    rw [MvPolynomial.eval₂Hom_X' MvPolynomial.C F_gen 0]
    rfl
  have hf_succ : ∀ β : Fin M,
      f (MvPolynomial.X β.succ) =
        MvPolynomial.X (σ β.succ) - MvPolynomial.C (c β) * MvPolynomial.X a₀ := by
    intro β
    change Φ₀ (MvPolynomial.X β.succ) = _
    rw [MvPolynomial.eval₂Hom_X' MvPolynomial.C F_gen β.succ]
    rfl

  have hgf_ring : Ψ₀.comp Φ₀ = RingHom.id (MvPolynomial (Fin (M + 1)) Ω) := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      simp [Φ₀, Ψ₀]
    · refine Fin.cases ?_ (fun β => ?_)
      · simp only [RingHom.comp_apply, RingHom.id_apply, Φ₀, Ψ₀,
          MvPolynomial.eval₂Hom_X', F_gen, Fin.cases_zero, G_gen]
        have hσa : σ a₀ = 0 := Equiv.swap_apply_right (0 : Fin (M + 1)) a₀
        rw [hσa, Fin.cases_zero]
      · simp only [RingHom.comp_apply, RingHom.id_apply, Φ₀, Ψ₀,
          MvPolynomial.eval₂Hom_X', F_gen, Fin.cases_succ, map_sub, map_mul,
          MvPolynomial.eval₂Hom_C, G_gen]
        have hσs : σ (σ β.succ) = β.succ := Equiv.swap_apply_self (0 : Fin (M + 1)) a₀ β.succ
        have hσa : σ a₀ = 0 := Equiv.swap_apply_right (0 : Fin (M + 1)) a₀
        rw [hσs, hσa, Fin.cases_succ, Fin.cases_zero]
        ring

  have hfg_ring : Φ₀.comp Ψ₀ = RingHom.id (MvPolynomial (Fin (M + 1)) Ω) := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      simp [Φ₀, Ψ₀]
    · intro b
      simp only [RingHom.comp_apply, RingHom.id_apply, Ψ₀, MvPolynomial.eval₂Hom_X', G_gen]
      have hb_inv : σ (σ b) = b := Equiv.swap_apply_self (0 : Fin (M + 1)) a₀ b
      revert hb_inv
      generalize σ b = u
      refine Fin.cases ?_ (fun β => ?_) u
      · intro hb0
        have ha : a₀ = b := by
          calc a₀ = σ 0 := (Equiv.swap_apply_left (0 : Fin (M + 1)) a₀).symm
            _ = b := hb0
        simp only [Fin.cases_zero, Φ₀, MvPolynomial.eval₂Hom_X', F_gen, ha]
      · intro hbs
        simp only [Fin.cases_succ, map_add, map_mul, Φ₀, MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, F_gen, Fin.cases_zero, hbs]
        ring

  have hgf : g.comp f = GradedRingHom.id 𝒜 := by
    apply GradedRingHom.ext
    intro x
    exact congrArg
      (fun φ : MvPolynomial (Fin (M + 1)) Ω →+* MvPolynomial (Fin (M + 1)) Ω => φ x) hgf_ring
  have hfg : f.comp g = GradedRingHom.id 𝒜 := by
    apply GradedRingHom.ext
    intro x
    exact congrArg
      (fun φ : MvPolynomial (Fin (M + 1)) Ω →+* MvPolynomial (Fin (M + 1)) Ω => φ x) hfg_ring

  have hIrrel_of_comp :
      ∀ (u v : 𝒜 →+*ᵍ 𝒜),
        u.comp v = GradedRingHom.id 𝒜 →
        HomogeneousIdeal.irrelevant 𝒜 ≤
          HomogeneousIdeal.map u (HomogeneousIdeal.irrelevant 𝒜) := by
    intro u v huv
    rw [HomogeneousIdeal.irrelevant_le]
    intro d hd x hx
    have hvx : v x ∈ HomogeneousIdeal.irrelevant 𝒜 :=
      HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hd (v.map_mem hx)
    have huvx : u (v x) ∈ (HomogeneousIdeal.map u (HomogeneousIdeal.irrelevant 𝒜)).toIdeal :=
      Ideal.mem_map_of_mem u.toRingHom hvx
    have heq : u (v x) = x := congrArg (fun φ : 𝒜 →+*ᵍ 𝒜 => φ x) huv
    rwa [heq] at huvx

  have hf : HomogeneousIdeal.irrelevant 𝒜 ≤
      HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜) :=
    hIrrel_of_comp f g hfg
  have hg : HomogeneousIdeal.irrelevant 𝒜 ≤
      HomogeneousIdeal.map g (HomogeneousIdeal.irrelevant 𝒜) :=
    hIrrel_of_comp g f hgf

  
  let τ_left : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Proj 𝒜 :=
    AlgebraicGeometry.Proj.map f hf
  let τ_inv : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Proj 𝒜 :=
    AlgebraicGeometry.Proj.map g hg

  have hMap_eq_id :
      ∀ (h : 𝒜 →+*ᵍ 𝒜)
        (hh : HomogeneousIdeal.irrelevant 𝒜 ≤
          HomogeneousIdeal.map h (HomogeneousIdeal.irrelevant 𝒜)),
        h = GradedRingHom.id 𝒜 →
        AlgebraicGeometry.Proj.map h hh = 𝟙 (AlgebraicGeometry.Proj 𝒜) := by
    rintro _ hh rfl
    exact AlgebraicGeometry.Proj.map_id

  have hτ_hom_inv : τ_left ≫ τ_inv = 𝟙 (AlgebraicGeometry.Proj 𝒜) := by
    dsimp [τ_left, τ_inv]
    rw [← AlgebraicGeometry.Proj.map_comp g f hg hf]
    exact hMap_eq_id (f.comp g) _ hfg

  have hτ_inv_hom : τ_inv ≫ τ_left = 𝟙 (AlgebraicGeometry.Proj 𝒜) := by
    dsimp [τ_left, τ_inv]
    rw [← AlgebraicGeometry.Proj.map_comp f g hf hg]
    exact hMap_eq_id (g.comp f) _ hgf

  have hIso_τ_left : CategoryTheory.IsIso τ_left := ⟨⟨τ_inv, hτ_hom_inv, hτ_inv_hom⟩⟩
  have hPre_τ : ∀ s : MvPolynomial (Fin (M + 1)) Ω,
      (TopologicalSpace.Opens.map τ_left.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜 s) =
        AlgebraicGeometry.Proj.basicOpen 𝒜 (f s) :=
    fun s => AlgebraicGeometry.Proj.map_preimage_basicOpen f hf s

  let V_cov : Fin (M + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (f (MvPolynomial.X a))
  have hSup_V : (⨆ a : Fin (M + 1), V_cov a) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨a, ha⟩ := hCov_X (τ_left.base y)
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨a, ?_⟩
    have hpre_y : y ∈ (TopologicalSpace.Opens.map τ_left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)) := ha
    rwa [hPre_τ (MvPolynomial.X a)] at hpre_y

  have hτ_over_local :
      ∀ a : Fin (M + 1),
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (f (MvPolynomial.X a))).ι ≫ (τ_left ≫ π_M) =
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (f (MvPolynomial.X a))).ι ≫ π_M := by
    intro a
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (M + 1)) Ω) ∈ 𝒜 1 :=
      MvPolynomial.isHomogeneous_X Ω a
    have hfXa : f (MvPolynomial.X a) ∈ 𝒜 1 := f.map_mem hXa
    apply (CategoryTheory.cancel_epi
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f (MvPolynomial.X a)) hfXa zero_lt_one).inv).mp
    calc
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f (MvPolynomial.X a)) hfXa zero_lt_one).inv ≫
          ((AlgebraicGeometry.Proj.basicOpen 𝒜 (f (MvPolynomial.X a))).ι ≫ (τ_left ≫ π_M))
        = (AlgebraicGeometry.Proj.awayι 𝒜 (f (MvPolynomial.X a)) hfXa zero_lt_one ≫
            AlgebraicGeometry.Proj.map f hf) ≫ π_M := by
            dsimp only [τ_left]
            rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (f (MvPolynomial.X a))
              hfXa zero_lt_one]
            simp only [CategoryTheory.Category.assoc]
      _ = (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) hXa zero_lt_one) ≫ π_M := by
            rw [AlgebraicGeometry.Proj.awayι_comp_map f hf zero_lt_one (MvPolynomial.X a) hXa]
      _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) hXa zero_lt_one ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0))) := by
            dsimp only [π_M]
            simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)) ≫
              CommRingCat.ofHom
                (HomogeneousLocalization.fromZeroRingHom 𝒜
                  (Submonoid.powers (MvPolynomial.X a))) ≫
              CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) := by
            rw [AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X a) hXa zero_lt_one,
              AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)) ≫
              CommRingCat.ofHom
                (HomogeneousLocalization.fromZeroRingHom 𝒜
                  (Submonoid.powers (f (MvPolynomial.X a))))) := by
            congr 1
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro r
            change HomogeneousLocalization.Away.map f (MvPolynomial.X a)
                (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a))
                  (algebraMap Ω ↥(𝒜 0) r)) =
              HomogeneousLocalization.fromZeroRingHom 𝒜
                (Submonoid.powers (f (MvPolynomial.X a)))
                (algebraMap Ω ↥(𝒜 0) r)
            apply HomogeneousLocalization.val_injective
            erw [HomogeneousLocalization.map_mk]
            rw [HomogeneousLocalization.val_mk]
            erw [HomogeneousLocalization.val_mk]
            congr 1 <;>
              simp only [hAlg0_val, hC, Subtype.ext_iff, SetLike.GradeZero.coe_one,
                Submonoid.coe_one, map_one]
      _ = (AlgebraicGeometry.Proj.awayι 𝒜 (f (MvPolynomial.X a)) hfXa zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0))) := by
            rw [AlgebraicGeometry.Spec.map_comp,
              AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (f (MvPolynomial.X a)) hfXa zero_lt_one]
      _ = (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f (MvPolynomial.X a)) hfXa
            zero_lt_one).inv ≫
          ((AlgebraicGeometry.Proj.basicOpen 𝒜 (f (MvPolynomial.X a))).ι ≫ π_M) := by
            dsimp only [π_M]
            rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (f (MvPolynomial.X a))
              hfXa zero_lt_one]
            simp only [CategoryTheory.Category.assoc]

  have hτ_over : τ_left ≫ π_M = π_M :=
    AlgebraicGeometry.Scheme.Cover.hom_ext
      ((AlgebraicGeometry.Proj 𝒜).openCoverOfIsOpenCover V_cov
        (TopologicalSpace.IsOpenCover.mk hSup_V))
      (τ_left ≫ π_M) π_M (fun a => hτ_over_local a)

  let τ : weilProjectiveSpaceOver Ω M ⟶ weilProjectiveSpaceOver Ω M :=
    CategoryTheory.Over.homMk τ_left hτ_over

  
  let ι₁ : W ⟶ weilProjectiveSpaceOver Ω M := ι_W ≫ τ
  have hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left := by
    have _ : CategoryTheory.IsIso τ.left := hIso_τ_left
    change AlgebraicGeometry.IsClosedImmersion (ι_W.left ≫ τ.left)
    infer_instance

  let q_star : ↥(weilProjectiveSpaceOver Ω M).left := ι₁.left.base b₀
  have hq0 : q_star ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) := by
    change p₀ ∈ (TopologicalSpace.Opens.map τ_left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0))
    rw [hPre_τ (MvPolynomial.X 0), hf0]
    exact hp₀_a₀
  have hq_succ : ∀ β : Fin M,
      q_star ∈ weilProjHyperplaneSet Ω M (MvPolynomial.X β.succ) := by
    intro β hmem
    have hpre : p₀ ∈ (TopologicalSpace.Opens.map τ_left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β.succ)) := hmem
    rw [hPre_τ (MvPolynomial.X β.succ), hf_succ β] at hpre
    exact hp₀_not_Li β hpre

  have hOriginCompl :
      ∀ p : (weilProjectiveSpaceOver Ω M).left,
        p ≠ q_star →
        ∃ β : Fin M, p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β.succ) := by
    intro p hp_ne
    by_contra! hAll
    obtain ⟨a_p, ha_p⟩ := hCov_X p
    have hp_X0 : p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) := by
      revert ha_p
      refine Fin.cases ?_ (fun β hβ => False.elim (hAll β hβ)) a_p
      exact id
    let g₀ : Fin (M + 1) → MvPolynomial (Fin (M + 1)) Ω :=
      Fin.cases (MvPolynomial.X 0) (fun _ : Fin M => 0)
    let ρ₀ : MvPolynomial (Fin (M + 1)) Ω →+* MvPolynomial (Fin (M + 1)) Ω :=
      MvPolynomial.eval₂Hom MvPolynomial.C g₀
    let I₁ : Ideal (MvPolynomial (Fin (M + 1)) Ω) :=
      Ideal.span (Set.range (fun β : Fin M => (MvPolynomial.X β.succ : MvPolynomial (Fin (M + 1)) Ω)))
    have hDiff_ρ₀ : ∀ R : MvPolynomial (Fin (M + 1)) Ω, R - ρ₀ R ∈ I₁ := by
      intro R
      induction R using MvPolynomial.induction_on with
      | C r =>
        simp only [ρ₀, MvPolynomial.eval₂Hom_C, sub_self]
        exact I₁.zero_mem
      | add R₁ R₂ h₁ h₂ =>
        have heq : R₁ + R₂ - ρ₀ (R₁ + R₂) = (R₁ - ρ₀ R₁) + (R₂ - ρ₀ R₂) := by
          rw [map_add]
          ring
        rw [heq]
        exact I₁.add_mem h₁ h₂
      | mul_X R b hR =>
        refine Fin.cases ?_ (fun β => ?_) b
        · have heq : R * MvPolynomial.X 0 - ρ₀ (R * MvPolynomial.X 0) =
              (R - ρ₀ R) * MvPolynomial.X 0 := by
            simp only [map_mul, ρ₀, MvPolynomial.eval₂Hom_X', g₀, Fin.cases_zero]
            ring
          rw [heq]
          exact I₁.mul_mem_right _ hR
        · simp only [map_mul, ρ₀, MvPolynomial.eval₂Hom_X', g₀, Fin.cases_succ, mul_zero,
            sub_zero]
          exact I₁.mul_mem_left R (Ideal.subset_span ⟨β, rfl⟩)
    have hHom_ρ₀ : ∀ (d : ℕ) (Q : MvPolynomial (Fin (M + 1)) Ω),
        Q.IsHomogeneous d →
        ∃ c_d : Ω, ρ₀ Q = MvPolynomial.C c_d * MvPolynomial.X 0 ^ d := by
      intro d Q hQ
      let c_term : (Fin (M + 1) →₀ ℕ) → Ω := fun s =>
        if ∀ β : Fin M, s β.succ = 0 then Q.coeff s else 0
      refine ⟨∑ s ∈ Q.support, c_term s, ?_⟩
      conv_lhs => rw [MvPolynomial.as_sum Q]
      rw [map_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun s hs => ?_)
      have hdeg_s : Finsupp.degree s = d := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hs) (hQ.coeff_eq_zero hne)
      have hsum_s : s 0 + ∑ β : Fin M, s β.succ = d := by
        rw [← Fin.sum_univ_succ, ← Finsupp.degree_eq_sum]
        exact hdeg_s
      change MvPolynomial.eval₂Hom MvPolynomial.C g₀
          (MvPolynomial.monomial s (Q.coeff s)) = _
      rw [MvPolynomial.eval₂Hom_monomial, Finsupp.prod_pow, Fin.prod_univ_succ]
      dsimp only [g₀, Fin.cases_zero, Fin.cases_succ, c_term]
      by_cases hall0 : ∀ β : Fin M, s β.succ = 0
      · rw [if_pos hall0]
        have hsum0 : (∑ β : Fin M, s β.succ) = 0 :=
          Finset.sum_eq_zero (fun β _ => hall0 β)
        have hs0 : s 0 = d := by omega
        have hprod1 :
            (∏ β : Fin M, (0 : MvPolynomial (Fin (M + 1)) Ω) ^ s β.succ) = 1 := by
          refine Finset.prod_eq_one (fun β _ => ?_)
          rw [hall0 β, pow_zero]
        rw [hprod1, mul_one, hs0]
      · rw [if_neg hall0, MvPolynomial.C.map_zero, zero_mul]
        push_neg at hall0
        obtain ⟨β, hβ⟩ := hall0
        have hprod0 :
            (∏ β' : Fin M, (0 : MvPolynomial (Fin (M + 1)) Ω) ^ s β'.succ) = 0 :=
          Finset.prod_eq_zero (Finset.mem_univ β) (zero_pow hβ)
        rw [hprod0, mul_zero, mul_zero]
    have hEqKer : ∀ 𝔮 : ProjectiveSpectrum 𝒜,
        (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) Ω) ∉ 𝔮.asHomogeneousIdeal →
        (∀ β : Fin M,
          (MvPolynomial.X β.succ : MvPolynomial (Fin (M + 1)) Ω) ∈ 𝔮.asHomogeneousIdeal.toIdeal) →
        𝔮.asHomogeneousIdeal.toIdeal = RingHom.ker ρ₀ := by
      intro 𝔮 hX0_not hXβ_mem
      have hI₁_le : I₁ ≤ 𝔮.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨β, rfl⟩
        exact hXβ_mem β
      apply le_antisymm
      · intro R hR
        rw [RingHom.mem_ker, ← MvPolynomial.sum_homogeneousComponent R, map_sum]
        refine Finset.sum_eq_zero (fun d _ => ?_)
        let Q := MvPolynomial.homogeneousComponent d R
        have hQ_mem : Q ∈ 𝔮.asHomogeneousIdeal.toIdeal := by
          dsimp [Q]
          rw [← MvPolynomial.decomposition.decompose'_apply R d]
          exact (Ideal.IsHomogeneous.mem_iff 𝒜 𝔮.asHomogeneousIdeal.isHomogeneous).mp hR d
        have hρQ_mem : ρ₀ Q ∈ 𝔮.asHomogeneousIdeal.toIdeal := by
          have hsub := 𝔮.asHomogeneousIdeal.toIdeal.sub_mem hQ_mem (hI₁_le (hDiff_ρ₀ Q))
          simpa using hsub
        obtain ⟨c_d, hρQ_eq⟩ := hHom_ρ₀ d Q (MvPolynomial.homogeneousComponent_isHomogeneous d R)
        rw [hρQ_eq] at hρQ_mem ⊢
        by_cases hc0 : c_d = 0
        · rw [hc0, map_zero, zero_mul]
        · exfalso
          have hpow_mem :
              (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) Ω) ^ d ∈
                𝔮.asHomogeneousIdeal.toIdeal := by
            have hmul := 𝔮.asHomogeneousIdeal.toIdeal.mul_mem_left (MvPolynomial.C c_d⁻¹) hρQ_mem
            have hcancel :
                (MvPolynomial.C c_d⁻¹ : MvPolynomial (Fin (M + 1)) Ω) *
                  (MvPolynomial.C c_d * MvPolynomial.X 0 ^ d) = MvPolynomial.X 0 ^ d := by
              rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc0, map_one, one_mul]
            rwa [hcancel] at hmul
          cases d with
          | zero =>
            rw [pow_zero] at hpow_mem
            exact 𝔮.isPrime.ne_top
              (Ideal.eq_top_of_isUnit_mem 𝔮.asHomogeneousIdeal.toIdeal hpow_mem isUnit_one)
          | succ d' =>
            exact hX0_not (𝔮.isPrime.mem_of_pow_mem (d' + 1) hpow_mem)
      · intro R hR
        rw [RingHom.mem_ker] at hR
        have hmem := hI₁_le (hDiff_ρ₀ R)
        rwa [hR, sub_zero] at hmem
    let p_proj : ProjectiveSpectrum 𝒜 := p
    let qstar_proj : ProjectiveSpectrum 𝒜 := q_star
    have hp_ker : p_proj.asHomogeneousIdeal.toIdeal = RingHom.ker ρ₀ :=
      hEqKer p_proj
        ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 0) p_proj).mp hp_X0)
        (fun β => (not_iff_comm.mp
          (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X β.succ) p_proj)).mp (hAll β))
    have hqstar_ker : qstar_proj.asHomogeneousIdeal.toIdeal = RingHom.ker ρ₀ :=
      hEqKer qstar_proj
        ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 0) qstar_proj).mp hq0)
        (fun β => (not_iff_comm.mp
          (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X β.succ) qstar_proj)).mp
            (hq_succ β))
    have heq_pt : p = q_star :=
      ProjectiveSpectrum.ext (HomogeneousIdeal.toIdeal_injective (hp_ker.trans hqstar_ker.symm))
    exact hp_ne heq_pt

  
  let G : MvPolynomial (Fin (M + 1)) Ω := g F
  have hG_mem1 : G ∈ 𝒜 1 := g.map_mem hF_hom
  have hG_hom : G.IsHomogeneous 1 := hG_mem1
  have hfG : f G = F := congrArg (fun φ : 𝒜 →+*ᵍ 𝒜 => φ F) hfg
  have hG_ne : G ≠ 0 := by
    intro h0
    apply hF_ne
    rw [← hfG, h0, map_zero]
  have hEquiv_G : ∀ w : W.left,
      ι₁.left.base w ∈ weilProjHyperplaneSet Ω M G ↔
        ι_W.left.base w ∈ weilProjHyperplaneSet Ω M F := by
    intro w
    change ι₁.left.base w ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 G ↔
      ι_W.left.base w ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 F
    refine not_congr ?_
    change ι_W.left.base w ∈ (TopologicalSpace.Opens.map τ_left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜 G) ↔
        ι_W.left.base w ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 F
    rw [hPre_τ G, hfG]
  have hq_G : q_star ∈ weilProjHyperplaneSet Ω M G :=
    (hEquiv_G b₀).mpr (hK₁_sub b₀ hb₀_K₁)

  let φ_s : Fin (M + 1) → (Fin (M + 1) →₀ ℕ) := fun a => Finsupp.single a 1
  have hφ_inj : Function.Injective φ_s := by
    intro a₁ a₂ heq
    by_contra hne
    have h1 : φ_s a₁ a₁ = φ_s a₂ a₁ := congrArg (fun fn => fn a₁) heq
    simp only [φ_s, Finsupp.single_eq_same, Finsupp.single_eq_of_ne hne] at h1
    exact one_ne_zero h1
  have hSupp_sub : G.support ⊆ Finset.univ.image φ_s := by
    intro s hs
    have hs_deg : Finsupp.degree s = 1 := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hs) (hG_hom.coeff_eq_zero hne)
    have hsum : (∑ b : Fin (M + 1), s b) = 1 := by
      rw [← Finsupp.degree_eq_sum]
      exact hs_deg
    have hex : ∃ a : Fin (M + 1), s a ≠ 0 := by
      by_contra! hall0
      simp [hall0] at hsum
    obtain ⟨a, hsa⟩ := hex
    have hsplit := Finset.add_sum_erase Finset.univ s (Finset.mem_univ a)
    rw [hsum] at hsplit
    have hsa_pos : 1 ≤ s a := Nat.pos_of_ne_zero hsa
    have hsa_eq1 : s a = 1 := by omega
    have herase_zero : (∑ b ∈ Finset.univ.erase a, s b) = 0 := by omega
    have hs_eq : φ_s a = s := by
      ext b
      by_cases hba : b = a
      · subst hba
        simp [φ_s, hsa_eq1]
      · have hb_mem : b ∈ Finset.univ.erase a :=
          Finset.mem_erase.mpr ⟨hba, Finset.mem_univ b⟩
        have hsb0 : s b = 0 :=
          (Finset.sum_eq_zero_iff_of_nonneg (fun _ _ => Nat.zero_le _)).mp herase_zero b hb_mem
        simp [φ_s, Finsupp.single_eq_of_ne hba, hsb0]
    exact Finset.mem_image.mpr ⟨a, Finset.mem_univ a, hs_eq⟩

  let c₀ : Ω := G.coeff (Finsupp.single (0 : Fin (M + 1)) 1)
  let c_F : Fin M → Ω := fun β => G.coeff (Finsupp.single β.succ 1)
  let F₁ : MvPolynomial (Fin (M + 1)) Ω :=
    ∑ β : Fin M, MvPolynomial.C (c_F β) * MvPolynomial.X β.succ

  have hG_expand : G = MvPolynomial.C c₀ * MvPolynomial.X 0 + F₁ := by
    calc G
        = ∑ s ∈ G.support, MvPolynomial.monomial s (G.coeff s) := MvPolynomial.as_sum G
      _ = ∑ s ∈ Finset.univ.image φ_s, MvPolynomial.monomial s (G.coeff s) := by
            refine Finset.sum_subset hSupp_sub (fun s _ hs_not => ?_)
            rw [MvPolynomial.notMem_support_iff.mp hs_not, map_zero]
      _ = ∑ a : Fin (M + 1), MvPolynomial.monomial (φ_s a) (G.coeff (φ_s a)) := by
            rw [Finset.sum_image (fun a₁ _ a₂ _ h => hφ_inj h)]
      _ = ∑ a : Fin (M + 1), MvPolynomial.C (G.coeff (Finsupp.single a 1)) * MvPolynomial.X a := by
            refine Finset.sum_congr rfl (fun a _ => ?_)
            dsimp [φ_s]
            rw [MvPolynomial.C_mul_X_eq_monomial]
      _ = MvPolynomial.C c₀ * MvPolynomial.X 0 + F₁ := by
            rw [Fin.sum_univ_succ]

  let q_proj : ProjectiveSpectrum 𝒜 := q_star
  have hX0_not_q :
      (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) Ω) ∉ q_proj.asHomogeneousIdeal :=
    (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 0) q_proj).mp hq0
  have hXsucc_in_q : ∀ β : Fin M,
      (MvPolynomial.X β.succ : MvPolynomial (Fin (M + 1)) Ω) ∈
        q_proj.asHomogeneousIdeal.toIdeal :=
    fun β => (not_iff_comm.mp
      (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X β.succ) q_proj)).mp (hq_succ β)
  have hG_in_q : G ∈ q_proj.asHomogeneousIdeal.toIdeal :=
    (not_iff_comm.mp (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 G q_proj)).mp hq_G
  have hF₁_in_q : F₁ ∈ q_proj.asHomogeneousIdeal.toIdeal :=
    Submodule.sum_mem q_proj.asHomogeneousIdeal.toIdeal (fun β _ =>
      q_proj.asHomogeneousIdeal.toIdeal.mul_mem_left _ (hXsucc_in_q β))
  have hc₀_zero : c₀ = 0 := by
    by_contra hc₀_ne
    have hc₀X0_mem :
        MvPolynomial.C c₀ * MvPolynomial.X 0 ∈ q_proj.asHomogeneousIdeal.toIdeal := by
      have hsub := q_proj.asHomogeneousIdeal.toIdeal.sub_mem hG_in_q hF₁_in_q
      rwa [hG_expand, add_sub_cancel_right] at hsub
    have hmul := q_proj.asHomogeneousIdeal.toIdeal.mul_mem_left (MvPolynomial.C c₀⁻¹) hc₀X0_mem
    have hcancel :
        (MvPolynomial.C c₀⁻¹ : MvPolynomial (Fin (M + 1)) Ω) *
          (MvPolynomial.C c₀ * MvPolynomial.X 0) = MvPolynomial.X 0 := by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc₀_ne, map_one, one_mul]
    rw [hcancel] at hmul
    exact hX0_not_q hmul

  have hF₁_eq_G : F₁ = G := by
    rw [hG_expand, hc₀_zero, map_zero, zero_mul, zero_add]
  have hc_F_ne : c_F ≠ 0 := by
    intro hc0
    apply hG_ne
    rw [← hF₁_eq_G]
    dsimp [F₁]
    refine Finset.sum_eq_zero (fun β _ => ?_)
    have hβ : c_F β = 0 := congrFun hc0 β
    rw [hβ, map_zero, zero_mul]

  refine ⟨b₀, q₀, ι₁, c_F, ?_⟩
  dsimp only
  refine ⟨hb₀_K₁, hb₀_cl, hq₀_hom, hq₀_range, hCl₁, hc_F_ne, ?_, ?_, ?_, hq0, hq_succ,
    hOriginCompl⟩
  · change F₁ ∈ 𝒜 1
    rwa [hF₁_eq_G]
  · change F₁ ≠ 0
    rwa [hF₁_eq_G]
  · intro w
    change ι₁.left.base w ∈ weilProjHyperplaneSet Ω M F₁ ↔ _
    rw [hF₁_eq_G]
    exact hEquiv_G w

theorem weil_closedImmersion_proj_chart_coords_and_origin_eval (k : Type u) [Field k] (N' : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₁ : W ⟶ weilProjectiveSpaceOver k (N' + 1))
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left) :
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U_chart : Fin (N' + 1 + 1) → W.left.Opens :=
      fun α => (TopologicalSpace.Opens.map ι₁.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α))
    let B : Fin (N' + 1 + 1) → Type u :=
      fun α => ↑(W.left.presheaf.obj (Opposite.op (U_chart α)))
    ∃ (hAff : ∀ α : Fin (N' + 1 + 1), AlgebraicGeometry.IsAffineOpen (U_chart α))
      (_ : ∀ α : Fin (N' + 1 + 1), Algebra k (B α))
      (_ : ∀ α : Fin (N' + 1 + 1), Algebra.FiniteType k (B α))
      (r_coord : ∀ α : Fin (N' + 1 + 1), Fin (N' + 1 + 1) → B α)
      (θ_away : ∀ α : Fin (N' + 1 + 1),
        HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) →+* B α),
      (∀ α : Fin (N' + 1 + 1), r_coord α α = 1) ∧
      (∀ α : Fin (N' + 1 + 1),
        Function.Surjective (θ_away α) ∧
        (∀ c : k,
          θ_away α (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X α))
            ⟨MvPolynomial.C c, MvPolynomial.isHomogeneous_C _ c⟩) =
          algebraMap k (B α) c) ∧
        (∀ a : Fin (N' + 1 + 1),
          θ_away α (HomogeneousLocalization.Away.mk 𝒜
            (MvPolynomial.isHomogeneous_X k α) 1
            (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X k a)) =
          r_coord α a) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α)
            (MvPolynomial.isHomogeneous_X k α) zero_lt_one =
          (hAff α).fromSpec ≫ ι₁.left) ∧
      (∀ (α : Fin (N' + 1 + 1)) (c : Fin (N' + 1 + 1) → k) (x : ↥(U_chart α)),
        ι₁.left.base x.1 ∈ weilProjHyperplaneSet k (N' + 1)
          (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ↔
        (∑ a : Fin (N' + 1 + 1), algebraMap k (B α) (c a) * r_coord α a) ∈
          ((hAff α).primeIdealOf x).asIdeal) ∧
      (∀ α : Fin (N' + 1 + 1),
        (hAff α).fromSpec ≫ W.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (B α)))) ∧
      (∀ α α' : Fin (N' + 1 + 1),
        U_chart α ⊓ U_chart α' = W.left.basicOpen (r_coord α α')) ∧
      (∀ α α' : Fin (N' + 1 + 1),
        let res_L := (W.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom
        let res_R := (W.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom
        (∀ c : k, res_R (algebraMap k (B α') c) = res_L (algebraMap k (B α) c)) ∧
        (∀ a : Fin (N' + 1 + 1),
          res_R (r_coord α' a) * res_L (r_coord α α') = res_L (r_coord α a))) ∧
      (∀ (b₀ : W.left)
         (q₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W.left),
        q₀ ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        Set.range q₀.base = {b₀} →
        ι₁.left.base b₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) →
        (∀ β : Fin (N' + 1),
          ι₁.left.base b₀ ∈ weilProjHyperplaneSet k (N' + 1) (MvPolynomial.X β.succ)) →
        ∃ ev₀ : B 0 →ₐ[k] k,
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫ (hAff 0).fromSpec = q₀ ∧
          RingHom.ker ev₀.toRingHom =
            Ideal.span (Set.range (fun β : Fin (N' + 1) => r_coord 0 β.succ))) :=
by
  intro 𝒜 hGrad U_chart B
  let _ : GradedAlgebra 𝒜 := hGrad
  let _ : AlgebraicGeometry.IsClosedImmersion ι₁.left := hCl₁
  let n : ℕ := N' + 1 + 1
  have hX : ∀ α : Fin n, MvPolynomial.X α ∈ 𝒜 1 :=
    fun α => MvPolynomial.isHomogeneous_X k α
  have hX1 : ∀ a : Fin n, MvPolynomial.X a ∈ 𝒜 (1 • 1) :=
    fun a => MvPolynomial.isHomogeneous_X k a
  have hC0 : ∀ c : k, MvPolynomial.C c ∈ 𝒜 0 :=
    fun c => MvPolynomial.isHomogeneous_C _ c

  
  let valHom : ∀ S : Submonoid (MvPolynomial (Fin n) k),
      HomogeneousLocalization 𝒜 S →+* Localization S := fun S =>
    { toFun := HomogeneousLocalization.val
      map_one' := HomogeneousLocalization.val_one
      map_mul' := fun x y => HomogeneousLocalization.val_mul x y
      map_zero' := HomogeneousLocalization.val_zero
      map_add' := fun x y => HomogeneousLocalization.val_add x y }
  have hLocSum : ∀ {S : Submonoid (MvPolynomial (Fin n) k)} {ι : Type}
      (s : Finset ι) (g : ι → MvPolynomial (Fin n) k) (d : S),
      (∑ i ∈ s, Localization.mk (g i) d) = Localization.mk (∑ i ∈ s, g i) d := by
    intro S ι s g d
    classical
    induction s using Finset.induction_on with
    | empty => simp [Localization.mk_zero]
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
  have hLocProd : ∀ {S : Submonoid (MvPolynomial (Fin n) k)} {ι : Type}
      (s : Finset ι) (g : ι → MvPolynomial (Fin n) k) (e : ι → S),
      (∏ i ∈ s, Localization.mk (g i) (e i)) =
        Localization.mk (∏ i ∈ s, g i) (∏ i ∈ s, e i) := by
    intro S ι s g e
    classical
    induction s using Finset.induction_on with
    | empty => simp [Localization.mk_one]
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.prod_insert ha, Finset.prod_insert ha,
        ih, Localization.mk_mul]
  have hLocPow : ∀ {S : Submonoid (MvPolynomial (Fin n) k)}
      (g : MvPolynomial (Fin n) k) (e : S) (m : ℕ),
      (Localization.mk g e) ^ m = Localization.mk (g ^ m) (e ^ m) := by
    intro S g e m
    induction m with
    | zero => simp [Localization.mk_one]
    | succ m ih => rw [pow_succ, pow_succ, pow_succ, ih, Localization.mk_mul]
  have hAlgZero : ∀ c : k,
      algebraMap k ↥(𝒜 0) c = ⟨MvPolynomial.C c, hC0 c⟩ := by
    intro c
    apply Subtype.ext
    calc (algebraMap k ↥(𝒜 0) c).1
      _ = (c • (1 : ↥(𝒜 0))).1 := by rw [Algebra.algebraMap_eq_smul_one]
      _ = c • (1 : MvPolynomial (Fin n) k) := by simp
      _ = algebraMap k (MvPolynomial (Fin n) k) c := (Algebra.algebraMap_eq_smul_one c).symm
      _ = MvPolynomial.C c := by rw [MvPolynomial.algebraMap_eq]
  have hAwayDiag : ∀ α : Fin n,
      HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X α) (hX1 α) = 1 := by
    intro α
    apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X α))
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
    let d₁ : Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin n) k) :=
      ⟨(MvPolynomial.X α) ^ 1, ⟨1, rfl⟩⟩
    have hd : (⟨(MvPolynomial.X α) ^ 1, ⟨1, rfl⟩⟩ :
        Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin n) k)) = d₁ := rfl
    rw [hd, ← Localization.mk_self d₁]
    congr 1
    exact (pow_one _).symm
  have hLinearHomog : ∀ c : Fin n → k,
      (∑ a : Fin n, MvPolynomial.C (c a) * MvPolynomial.X a) ∈ 𝒜 1 := by
    intro c
    refine Submodule.sum_mem (𝒜 1) fun a _ => ?_
    change MvPolynomial.IsHomogeneous (MvPolynomial.C (c a) * MvPolynomial.X a) 1
    have hmul := (MvPolynomial.isHomogeneous_C (Fin n) (c a)).mul
      (MvPolynomial.isHomogeneous_X k a)
    rwa [zero_add] at hmul
  have hValFromZero : ∀ (S : Submonoid (MvPolynomial (Fin n) k)) (z : ↥(𝒜 0)),
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S z).val = Localization.mk z.1 1 := by
    intro S z
    simp [HomogeneousLocalization.fromZeroRingHom]
    congr 1
  have hAwayLinear : ∀ (α : Fin n) (c : Fin n → k)
      (hFc : (∑ a : Fin n, MvPolynomial.C (c a) * MvPolynomial.X a) ∈ 𝒜 1),
      HomogeneousLocalization.Away.isLocalizationElem (hX α) hFc =
      ∑ a : Fin n,
        HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X α)) ⟨MvPolynomial.C (c a), hC0 (c a)⟩ *
        HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X a) (hX1 a) := by
    intro α c hFc
    let Sα := Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin n) k)
    let d₁ : Sα := ⟨(MvPolynomial.X α) ^ 1, ⟨1, rfl⟩⟩
    let lhs := HomogeneousLocalization.Away.isLocalizationElem (hX α) hFc
    let rhs := ∑ a : Fin n,
      HomogeneousLocalization.fromZeroRingHom 𝒜 Sα ⟨MvPolynomial.C (c a), hC0 (c a)⟩ *
      HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X a) (hX1 a)
    apply HomogeneousLocalization.val_injective Sα
    change valHom Sα lhs = valHom Sα rhs
    dsimp [rhs]
    rw [map_sum]
    have hRHS : ∀ a : Fin n,
        valHom Sα
          (HomogeneousLocalization.fromZeroRingHom 𝒜 Sα ⟨MvPolynomial.C (c a), hC0 (c a)⟩ *
          HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X a) (hX1 a)) =
        Localization.mk (MvPolynomial.C (c a) * MvPolynomial.X a) d₁ := by
      intro a
      rw [map_mul]
      change (HomogeneousLocalization.fromZeroRingHom 𝒜 Sα _).val *
        (HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X a) (hX1 a)).val = _
      rw [hValFromZero, HomogeneousLocalization.Away.val_mk, Localization.mk_mul, one_mul]
    simp_rw [hRHS]
    rw [hLocSum]
    change lhs.val = _
    dsimp [lhs, HomogeneousLocalization.Away.isLocalizationElem]
    rw [pow_one]
  have hAwayCocycle : ∀ α α' a : Fin n,
      HomogeneousLocalization.awayMap 𝒜 (hX α)
        (mul_comm (MvPolynomial.X α) (MvPolynomial.X α'))
        (HomogeneousLocalization.Away.mk 𝒜 (hX α') 1 (MvPolynomial.X a) (hX1 a)) *
      HomogeneousLocalization.awayMap 𝒜 (hX α') rfl
        (HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X α') (hX1 α')) =
      HomogeneousLocalization.awayMap 𝒜 (hX α') rfl
        (HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X a) (hX1 a)) := by
    intro α α' a
    let Smul := Submonoid.powers
      ((MvPolynomial.X α * MvPolynomial.X α') : MvPolynomial (Fin n) k)
    let d_mul : Smul := ⟨(MvPolynomial.X α * MvPolynomial.X α') ^ 1, ⟨1, rfl⟩⟩
    rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
      HomogeneousLocalization.awayMap_mk]
    apply HomogeneousLocalization.val_injective Smul
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
    have hd : ∀ hmem, (⟨(MvPolynomial.X α * MvPolynomial.X α') ^ 1, hmem⟩ : Smul) = d_mul :=
      fun _ => Subtype.ext rfl
    rw [hd, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    change (1 : MvPolynomial (Fin n) k) * _ = (1 : MvPolynomial (Fin n) k) * _
    simp only [Submonoid.coe_mul, d_mul]
    ring
  have hAwayDehomog : ∀ (α : Fin n) (x : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)),
      ∃ P : MvPolynomial {a : Fin n // a ≠ α} k,
        MvPolynomial.eval₂
          ((HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X α))).comp (algebraMap k ↥(𝒜 0)))
          (fun j : {a : Fin n // a ≠ α} =>
            HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X j.1) (hX1 j.1)) P = x := by
    intro α x
    classical
    let Sα := Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin n) k)
    let ψ₀ := (HomogeneousLocalization.fromZeroRingHom 𝒜 Sα).comp (algebraMap k ↥(𝒜 0))
    let u₀ : {a : Fin n // a ≠ α} → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) :=
      fun j => HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X j.1) (hX1 j.1)
    obtain ⟨m, G, hG, rfl⟩ :=
      HomogeneousLocalization.Away.mk_surjective 𝒜 (hX α) x
    let P : MvPolynomial {a : Fin n // a ≠ α} k :=
      ∑ d ∈ G.support,
        MvPolynomial.C (G.coeff d) *
          ∏ j : {a : Fin n // a ≠ α}, (MvPolynomial.X j) ^ (d j.1)
    refine ⟨P, ?_⟩
    apply HomogeneousLocalization.val_injective Sα
    change valHom Sα (MvPolynomial.eval₂ ψ₀ u₀ P) = _
    rw [MvPolynomial.hom_eval₂]
    dsimp [P]
    rw [MvPolynomial.eval₂_sum]
    let hd_pow : ℕ → Sα := fun k_exp => ⟨(MvPolynomial.X α) ^ k_exp, ⟨k_exp, rfl⟩⟩
    have hd_mul : ∀ a_e b_e : ℕ, hd_pow a_e * hd_pow b_e = hd_pow (a_e + b_e) := by
      intro a_e b_e
      apply Subtype.ext
      simp [hd_pow, pow_add]
    have hd_prod : ∀ {ι : Type} (s : Finset ι) (f_e : ι → ℕ),
        (∏ i ∈ s, hd_pow (f_e i)) = hd_pow (∑ i ∈ s, f_e i) := by
      intro ι s f_e
      induction s using Finset.induction_on with
      | empty =>
        apply Subtype.ext
        simp [hd_pow]
      | @insert a_i s ha_i ih =>
        rw [Finset.prod_insert ha_i, Finset.sum_insert ha_i, ih, hd_mul]
    have hTerm : ∀ d ∈ G.support,
        MvPolynomial.eval₂ ((valHom Sα).comp ψ₀) (fun j => valHom Sα (u₀ j))
          (MvPolynomial.C (G.coeff d) *
            ∏ j : {a : Fin n // a ≠ α}, (MvPolynomial.X j) ^ (d j.1)) =
        Localization.mk (MvPolynomial.monomial d (G.coeff d)) (hd_pow m) := by
      intro d hd_supp
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_prod]
      have hψ_val : ((valHom Sα).comp ψ₀) (G.coeff d) =
          Localization.mk (MvPolynomial.C (G.coeff d)) 1 := by
        change (HomogeneousLocalization.fromZeroRingHom 𝒜 Sα (algebraMap k ↥(𝒜 0) (G.coeff d))).val = _
        rw [hAlgZero, hValFromZero]
      have hu_pow : ∀ j : {a : Fin n // a ≠ α},
          MvPolynomial.eval₂ ((valHom Sα).comp ψ₀) (fun j => valHom Sα (u₀ j))
            ((MvPolynomial.X j) ^ (d j.1)) =
          Localization.mk ((MvPolynomial.X j.1) ^ (d j.1)) (hd_pow (d j.1)) := by
        intro j
        rw [MvPolynomial.eval₂_pow, MvPolynomial.eval₂_X]
        change ((u₀ j).val) ^ (d j.1) = _
        have hu_val : (u₀ j).val =
            Localization.mk (MvPolynomial.X j.1) (hd_pow 1) := rfl
        rw [hu_val, hLocPow]
        congr 1
        apply Subtype.ext
        simp [hd_pow]
      rw [hψ_val]
      simp_rw [hu_pow]
      rw [hLocProd, hd_prod, Localization.mk_mul, one_mul]
      have hG_hom : MvPolynomial.IsHomogeneous G m := by
        have hm1 : m • (1 : ℕ) = m := smul_eq_mul m 1 |>.trans (mul_one m)
        rwa [hm1] at hG
      have hd_coeff_ne : G.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd_supp
      have hd_deg : (∑ a : Fin n, d a) = m := by
        have h1 : (Finsupp.weight 1) d = m := hG_hom hd_coeff_ne
        have h2 : (Finsupp.weight 1) d = ∑ a : Fin n, d a := by
          change Finsupp.linearCombination ℕ (fun _ : Fin n => (1 : ℕ)) d = _
          rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype _ _ (by simp)]
          simp
        exact h2.symm.trans h1
      have hsub_sum : (∑ j : {a : Fin n // a ≠ α}, d j.1) =
          ∑ a ∈ Finset.univ.erase α, d a := by
        symm
        refine Finset.sum_subtype (Finset.univ.erase α) (fun a => ?_) (fun a => d a)
        simp [Finset.mem_erase]
      have hm_split : d α + ∑ j : {a : Fin n // a ≠ α}, d j.1 = m := by
        rw [hsub_sum, Finset.add_sum_erase Finset.univ (fun a => d a) (Finset.mem_univ α), hd_deg]
      have hsub_prod : (∏ j : {a : Fin n // a ≠ α},
            (MvPolynomial.X j.1 : MvPolynomial (Fin n) k) ^ (d j.1)) =
          ∏ a ∈ Finset.univ.erase α, (MvPolynomial.X a : MvPolynomial (Fin n) k) ^ (d a) := by
        symm
        refine Finset.prod_subtype (Finset.univ.erase α) (fun a => ?_)
          (fun a => (MvPolynomial.X a : MvPolynomial (Fin n) k) ^ (d a))
        simp [Finset.mem_erase]
      have hmon_split : MvPolynomial.monomial d (G.coeff d) =
          MvPolynomial.C (G.coeff d) *
            ((MvPolynomial.X α) ^ (d α) *
              ∏ j : {a : Fin n // a ≠ α}, (MvPolynomial.X j.1) ^ (d j.1)) := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          ← Finset.mul_prod_erase Finset.univ
            (fun a => (MvPolynomial.X a : MvPolynomial (Fin n) k) ^ (d a)) (Finset.mem_univ α),
          ← hsub_prod]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      change (1 : MvPolynomial (Fin n) k) * _ = (1 : MvPolynomial (Fin n) k) * _
      simp only [hd_pow, hmon_split, ← hm_split, pow_add]
      ring
    rw [Finset.sum_congr rfl hTerm, hLocSum, ← MvPolynomial.as_sum G]

  
  let ι : W.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι₁.left
  let _ : AlgebraicGeometry.IsClosedImmersion ι := hCl₁
  let hAff₀ : ∀ α : Fin n,
      AlgebraicGeometry.IsAffineOpen
        (ι ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α)) := fun α =>
    (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X α)
      (hX α) zero_lt_one).preimage ι
  let hAff : ∀ α : Fin n, AlgebraicGeometry.IsAffineOpen (U_chart α) := hAff₀
  let g_chart : ∀ α : Fin n,
      AlgebraicGeometry.Spec
        (W.left.presheaf.obj
          (Opposite.op (ι ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α)))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of
          (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α))) := fun α =>
    (hAff₀ α).isoSpec.inv ≫
      (ι ∣_ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α)) ≫
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X α)
        (hX α) zero_lt_one).hom
  let θ_away : ∀ α : Fin n,
      HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) →+* B α := fun α =>
    (AlgebraicGeometry.Spec.preimage (g_chart α)).hom
  have hSpec_θ : ∀ α : Fin n,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) = g_chart α := by
    intro α
    exact AlgebraicGeometry.Spec.map_preimage (g_chart α)
  have hChartFac : ∀ α : Fin n,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one =
        (hAff α).fromSpec ≫ ι₁.left := by
    intro α
    have hFac₀ : g_chart α ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one =
        (hAff₀ α).fromSpec ≫ ι := by
      rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one]
      dsimp [g_chart]
      rw [Category.assoc, Category.assoc, Iso.hom_inv_id_assoc,
        AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc,
        AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
    exact (congrArg (· ≫ AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one)
      (hSpec_θ α)).trans hFac₀
  have hSurj_θ : ∀ α : Fin n, Function.Surjective (θ_away α) := by
    intro α
    have _ : AlgebraicGeometry.IsClosedImmersion (g_chart α) := by
      dsimp [g_chart]
      infer_instance
    have hSurj_app : Function.Surjective
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α))).appTop).hom := by
      rw [hSpec_θ α]
      exact AlgebraicGeometry.Scheme.Hom.app_surjective (g_chart α) ⊤
        (AlgebraicGeometry.isAffineOpen_top _)
    have hNat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (θ_away α))
    have hEq_hom : CommRingCat.ofHom (θ_away α) =
        (AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α))).appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso _).hom) := by
      rw [hNat, Iso.inv_hom_id_assoc]
    have hSurj_inv : Function.Surjective
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)))).inv.hom :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv.symm).surjective
    have hSurj_hom : Function.Surjective
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (B α))).hom.hom :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv).surjective
    intro b
    obtain ⟨z₁, hz₁⟩ := hSurj_hom b
    obtain ⟨z₂, hz₂⟩ := hSurj_app z₁
    obtain ⟨z₃, hz₃⟩ := hSurj_inv z₂
    refine ⟨z₃, ?_⟩
    have hApp : θ_away α z₃ =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (B α))).hom.hom
          (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α))).appTop).hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)))).inv.hom z₃)) :=
      congrArg (fun f => f.hom z₃) hEq_hom
    rw [hApp, hz₃, hz₂, hz₁]
  have hOverlapLift : ∀ α α' : Fin n,
      let res_L := (W.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom
      let res_R := (W.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom
      ∃ θ_inter : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α * MvPolynomial.X α') →+*
          ↑(W.left.presheaf.obj (Opposite.op (U_chart α ⊓ U_chart α'))),
        (∀ z, res_L (θ_away α z) =
          θ_inter (HomogeneousLocalization.awayMap 𝒜 (hX α') rfl z)) ∧
        (∀ z', res_R (θ_away α' z') =
          θ_inter (HomogeneousLocalization.awayMap 𝒜 (hX α)
            (mul_comm (MvPolynomial.X α) (MvPolynomial.X α')) z')) := by
    intro α α' res_L res_R
    have hMul : (MvPolynomial.X α * MvPolynomial.X α' : MvPolynomial (Fin n) k) ∈ 𝒜 (1 + 1) :=
      SetLike.GradedMonoid.toGradedMul.mul_mem (hX α) (hX α')
    have hPos2 : 0 < 1 + 1 := Nat.zero_lt_succ 1
    let D_inter := AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α * MvPolynomial.X α')
    have hD_eq : D_inter =
        AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α) ⊓
          AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α') :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X α) (MvPolynomial.X α')
    have hU_inter_eq : (TopologicalSpace.Opens.map ι.base).obj D_inter = U_chart α ⊓ U_chart α' := by
      rw [hD_eq]
      rfl
    have hAff_inter : AlgebraicGeometry.IsAffineOpen (U_chart α ⊓ U_chart α') := by
      rw [← hU_inter_eq]
      exact (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
        (MvPolynomial.X α * MvPolynomial.X α') hMul hPos2).preimage ι
    let away_inter := AlgebraicGeometry.Proj.awayι 𝒜
      (MvPolynomial.X α * MvPolynomial.X α') hMul hPos2
    let iso_inter := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜
      (MvPolynomial.X α * MvPolynomial.X α') hMul hPos2
    have hRange : Set.range (hAff_inter.fromSpec ≫ ι).base ⊆ Set.range away_inter.base := by
      rintro _ ⟨p, rfl⟩
      have hp_U : hAff_inter.fromSpec.base p ∈ (U_chart α ⊓ U_chart α' : Set W.left) := by
        have hp_mem : hAff_inter.fromSpec.base p ∈ Set.range hAff_inter.fromSpec.base :=
          Set.mem_range_self p
        rwa [hAff_inter.range_fromSpec] at hp_mem
      have hp_D : ι.base (hAff_inter.fromSpec.base p) ∈ (D_inter : Set (AlgebraicGeometry.Proj 𝒜)) := by
        have hp_pre : hAff_inter.fromSpec.base p ∈
            ((TopologicalSpace.Opens.map ι.base).obj D_inter : Set W.left) := by
          rwa [hU_inter_eq]
        exact hp_pre
      refine ⟨iso_inter.hom.base ⟨ι.base (hAff_inter.fromSpec.base p), hp_D⟩, ?_⟩
      have hIsoAway : away_inter = iso_inter.inv ≫ D_inter.ι :=
        (AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜
          (MvPolynomial.X α * MvPolynomial.X α') hMul hPos2).symm
      have hComp : iso_inter.hom ≫ away_inter = D_inter.ι := by
        rw [hIsoAway, Iso.hom_inv_id_assoc]
      exact congrArg (fun f => f.base ⟨ι.base (hAff_inter.fromSpec.base p), hp_D⟩) hComp
    have _ : AlgebraicGeometry.IsOpenImmersion away_inter := by
      dsimp [away_inter]
      infer_instance
    let lift_inter := AlgebraicGeometry.IsOpenImmersion.lift away_inter
      (hAff_inter.fromSpec ≫ ι) hRange
    have hLift_fac : lift_inter ≫ away_inter = hAff_inter.fromSpec ≫ ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac away_inter (hAff_inter.fromSpec ≫ ι) hRange
    let θ_inter : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α * MvPolynomial.X α') →+*
        ↑(W.left.presheaf.obj (Opposite.op (U_chart α ⊓ U_chart α'))) :=
      (AlgebraicGeometry.Spec.preimage lift_inter).hom
    have hSpec_inter : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_inter) = lift_inter :=
      AlgebraicGeometry.Spec.map_preimage lift_inter
    refine ⟨θ_inter, ?_, ?_⟩
    · let res_L_cat := W.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op
      let ρ_L := HomogeneousLocalization.awayMap 𝒜 (hX α')
        (rfl : MvPolynomial.X α * MvPolynomial.X α' = MvPolynomial.X α * MvPolynomial.X α')
      let away_α := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one
      have _ : CategoryTheory.Mono away_α := by
        dsimp [away_α]
        infer_instance
      have hEqSpec :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α) ≫ res_L_cat) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L ≫ CommRingCat.ofHom θ_inter) := by
        rw [← cancel_mono away_α]
        calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α) ≫ res_L_cat) ≫ away_α
          _ = AlgebraicGeometry.Spec.map res_L_cat ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫ away_α) := by
              rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
          _ = (AlgebraicGeometry.Spec.map res_L_cat ≫ (hAff α).fromSpec) ≫ ι := by
              rw [hChartFac α]
              simp only [Category.assoc]
              rfl
          _ = hAff_inter.fromSpec ≫ ι := by
              rw [AlgebraicGeometry.IsAffineOpen.map_fromSpec (hAff α) hAff_inter
                (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op]
          _ = lift_inter ≫ away_inter := hLift_fac.symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_inter) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L) ≫ away_α) := by
              rw [hSpec_inter,
                AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX α) zero_lt_one (hX α') rfl]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L ≫ CommRingCat.ofHom θ_inter) ≫
                away_α := by
              rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
      have hEqHom := AlgebraicGeometry.Spec.map_injective hEqSpec
      intro z
      exact congrArg (fun f => f.hom z) hEqHom
    · let res_R_cat := W.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op
      let ρ_R := HomogeneousLocalization.awayMap 𝒜 (hX α)
        (mul_comm (MvPolynomial.X α) (MvPolynomial.X α'))
      let away_α' := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α') (hX α') zero_lt_one
      have _ : CategoryTheory.Mono away_α' := by
        dsimp [away_α']
        infer_instance
      have hEqSpec :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α') ≫ res_R_cat) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_R ≫ CommRingCat.ofHom θ_inter) := by
        rw [← cancel_mono away_α']
        calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α') ≫ res_R_cat) ≫ away_α'
          _ = AlgebraicGeometry.Spec.map res_R_cat ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α')) ≫ away_α') := by
              rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
          _ = (AlgebraicGeometry.Spec.map res_R_cat ≫ (hAff α').fromSpec) ≫ ι := by
              rw [hChartFac α']
              simp only [Category.assoc]
              rfl
          _ = hAff_inter.fromSpec ≫ ι := by
              rw [AlgebraicGeometry.IsAffineOpen.map_fromSpec (hAff α') hAff_inter
                (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op]
          _ = lift_inter ≫ away_inter := hLift_fac.symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_inter) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_R) ≫ away_α') := by
              rw [hSpec_inter, AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX α') zero_lt_one
                (hX α) (mul_comm (MvPolynomial.X α) (MvPolynomial.X α'))]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_R ≫ CommRingCat.ofHom θ_inter) ≫
                away_α' := by
              rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
      have hEqHom := AlgebraicGeometry.Spec.map_injective hEqSpec
      intro z'
      exact congrArg (fun f => f.hom z') hEqHom

  
  let φ_k : ∀ α : Fin n, k →+* B α := fun α =>
    (θ_away α).comp
      ((HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X α))).comp (algebraMap k ↥(𝒜 0)))
  let hAlg : ∀ α : Fin n, Algebra k (B α) := fun α => (φ_k α).toAlgebra
  let _ : ∀ α : Fin n, Algebra k (B α) := hAlg
  let r_coord : ∀ α : Fin n, Fin n → B α := fun α a =>
    θ_away α (HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X a) (hX1 a))
  have hAlg_apply : ∀ (α : Fin n) (c : k),
      θ_away α (HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X α))
        ⟨MvPolynomial.C c, MvPolynomial.isHomogeneous_C _ c⟩) =
      algebraMap k (B α) c := by
    intro α c
    have hEq : (⟨MvPolynomial.C c, MvPolynomial.isHomogeneous_C _ c⟩ : ↥(𝒜 0)) =
        algebraMap k ↥(𝒜 0) c := (hAlgZero c).symm
    rw [hEq]
    rfl
  have hChartGen : ∀ α : Fin n,
      Function.Surjective
        (MvPolynomial.aeval (R := k) (S₁ := B α)
          (fun j : {a : Fin n // a ≠ α} => r_coord α j.1)) := by
    intro α b
    obtain ⟨x, rfl⟩ := hSurj_θ α b
    obtain ⟨P, hP⟩ := hAwayDehomog α x
    refine ⟨P, ?_⟩
    rw [MvPolynomial.aeval_def, ← hP, MvPolynomial.hom_eval₂]
    rfl
  have hFT : ∀ α : Fin n, Algebra.FiniteType k (B α) := fun α =>
    Algebra.FiniteType.of_surjective
      (MvPolynomial.aeval (R := k) (S₁ := B α)
        (fun j : {a : Fin n // a ≠ α} => r_coord α j.1))
      (hChartGen α)
  have hConj1 : ∀ α : Fin n, r_coord α α = 1 := by
    intro α
    dsimp [r_coord]
    rw [hAwayDiag α, map_one]
  have hConj3 : ∀ (α : Fin n) (c : Fin n → k) (x : ↥(U_chart α)),
      ι₁.left.base x.1 ∈ weilProjHyperplaneSet k (N' + 1)
        (∑ a : Fin n, MvPolynomial.C (c a) * MvPolynomial.X a) ↔
      (∑ a : Fin n, algebraMap k (B α) (c a) * r_coord α a) ∈
        ((hAff α).primeIdealOf x).asIdeal := by
    intro α c x
    let F : MvPolynomial (Fin n) k := ∑ a : Fin n, MvPolynomial.C (c a) * MvPolynomial.X a
    have hFc : F ∈ 𝒜 1 := hLinearHomog c
    let p_x : PrimeSpectrum (B α) := (hAff α).primeIdealOf x
    let q_x : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α))).base p_x
    have hp_base : ι.base x.1 =
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one).base q_x := by
      have h1 :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one).base p_x =
          ((hAff α).fromSpec ≫ ι₁.left).base p_x :=
        congrArg (fun f => f.base p_x) (hChartFac α)
      have h1_lhs :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one).base p_x =
          (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one).base q_x := rfl
      have h1_rhs : ((hAff α).fromSpec ≫ ι₁.left).base p_x = ι.base x.1 :=
        congrArg ι.base ((hAff α).fromSpec_primeIdealOf x)
      exact h1_rhs.symm.trans (h1.symm.trans h1_lhs)
    have hStep1 :
        (ι₁.left.base x.1 ∈ weilProjHyperplaneSet k (N' + 1) F) ↔
        ¬ ((AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one).base q_x ∈
          AlgebraicGeometry.Proj.basicOpen 𝒜 F) := by
      have hDef : (ι₁.left.base x.1 ∈ weilProjHyperplaneSet k (N' + 1) F) ↔
          ¬ (ι.base x.1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 F) := Iff.rfl
      rw [hp_base] at hDef
      exact hDef
    have hPre := SetLike.ext_iff.mp
      (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX α) zero_lt_one hFc zero_lt_one) q_x
    have hStep2 :
        ¬ ((AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one).base q_x ∈
          AlgebraicGeometry.Proj.basicOpen 𝒜 F) ↔
        ¬ (q_x ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hX α) hFc)) :=
      not_congr hPre
    have hStep3 :
        ¬ (q_x ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hX α) hFc)) ↔
        HomogeneousLocalization.Away.isLocalizationElem (hX α) hFc ∈ q_x.asIdeal :=
      (not_congr (PrimeSpectrum.mem_basicOpen _ _)).trans Classical.not_not
    have hStep4 :
        HomogeneousLocalization.Away.isLocalizationElem (hX α) hFc ∈ q_x.asIdeal ↔
        (∑ a : Fin n, algebraMap k (B α) (c a) * r_coord α a) ∈ p_x.asIdeal := by
      change HomogeneousLocalization.Away.isLocalizationElem (hX α) hFc ∈
        Ideal.comap (θ_away α) p_x.asIdeal ↔ _
      rw [Ideal.mem_comap, hAwayLinear α c hFc, map_sum]
      have hSumEq :
          (∑ a : Fin n,
            θ_away α
              (HomogeneousLocalization.fromZeroRingHom 𝒜
                (Submonoid.powers (MvPolynomial.X α)) ⟨MvPolynomial.C (c a), hC0 (c a)⟩ *
              HomogeneousLocalization.Away.mk 𝒜 (hX α) 1 (MvPolynomial.X a) (hX1 a))) =
          ∑ a : Fin n, algebraMap k (B α) (c a) * r_coord α a := by
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [map_mul, hAlg_apply α (c a)]
      rw [hSumEq]
    exact hStep1.trans (hStep2.trans (hStep3.trans hStep4))
  have hConj4 : ∀ α : Fin n,
      (hAff α).fromSpec ≫ W.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (B α))) := by
    intro α
    have hw : ι₁.left ≫ (weilProjectiveSpaceOver k (N' + 1)).hom = W.hom :=
      CategoryTheory.Over.w ι₁
    calc (hAff α).fromSpec ≫ W.hom
      _ = ((hAff α).fromSpec ≫ ι₁.left) ≫ (weilProjectiveSpaceOver k (N' + 1)).hom := by
          rw [← hw, Category.assoc]
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one) ≫
            (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) := by
          rw [← hChartFac α]
          rfl
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
            (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) := by
          simp only [Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.fromZeroRingHom 𝒜
                (Submonoid.powers (MvPolynomial.X α)))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) := by
          rw [AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X α) (hX α) zero_lt_one]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (B α))) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
  have hSinglePoly : ∀ α' : Fin n,
      (∑ a : Fin n, MvPolynomial.C ((Pi.single α' (1 : k) : Fin n → k) a) *
        MvPolynomial.X a) = MvPolynomial.X α' := by
    intro α'
    rw [Finset.sum_eq_single α']
    · simp
    · intro a _ ha
      simp [Pi.single_eq_of_ne ha]
    · intro h
      exact False.elim (h (Finset.mem_univ α'))
  have hSingleCoord : ∀ α α' : Fin n,
      (∑ a : Fin n, algebraMap k (B α) ((Pi.single α' (1 : k) : Fin n → k) a) *
        r_coord α a) = r_coord α α' := by
    intro α α'
    rw [Finset.sum_eq_single α']
    · simp
    · intro a _ ha
      simp [Pi.single_eq_of_ne ha]
    · intro h
      exact False.elim (h (Finset.mem_univ α'))
  have hConj5 : ∀ α α' : Fin n,
      U_chart α ⊓ U_chart α' = W.left.basicOpen (r_coord α α') := by
    intro α α'
    apply TopologicalSpace.Opens.ext
    ext w
    by_cases hw : w ∈ U_chart α
    · let x : ↥(U_chart α) := ⟨w, hw⟩
      have hv := hConj3 α (Pi.single α' 1) x
      rw [hSinglePoly α', hSingleCoord α α'] at hv
      have hHypIff :
          (ι₁.left.base x.1 ∈ weilProjHyperplaneSet k (N' + 1) (MvPolynomial.X α')) ↔
          ¬ (w ∈ U_chart α') := Iff.rfl
      have hv_not : w ∈ U_chart α' ↔
          r_coord α α' ∉ ((hAff α).primeIdealOf x).asIdeal :=
        Classical.not_not.symm.trans (not_congr (hHypIff.symm.trans hv))
      let p_x : PrimeSpectrum (B α) := (hAff α).primeIdealOf x
      have hBasic : w ∈ W.left.basicOpen (r_coord α α') ↔
          r_coord α α' ∉ p_x.asIdeal := by
        have hx_eq : (hAff α).fromSpec.base p_x = w :=
          (hAff α).fromSpec_primeIdealOf x
        have hMem1 : w ∈ W.left.basicOpen (r_coord α α') ↔
            (hAff α).fromSpec.base p_x ∈ W.left.basicOpen (r_coord α α') := by
          rw [hx_eq]
        have hPre :
            ((hAff α).fromSpec.base p_x ∈ W.left.basicOpen (r_coord α α')) ↔
            p_x ∈ PrimeSpectrum.basicOpen (r_coord α α') :=
          SetLike.ext_iff.mp ((hAff α).fromSpec_preimage_basicOpen (r_coord α α')) p_x
        exact hMem1.trans (hPre.trans (PrimeSpectrum.mem_basicOpen _ _))
      change (w ∈ U_chart α ∧ w ∈ U_chart α') ↔ w ∈ W.left.basicOpen (r_coord α α')
      exact (and_iff_right hw).trans (hv_not.trans hBasic.symm)
    · have hNotInter : w ∉ (U_chart α ⊓ U_chart α' : W.left.Opens) :=
        fun h => hw h.1
      have hNotBasic : w ∉ W.left.basicOpen (r_coord α α') :=
        fun h => hw (W.left.basicOpen_le (r_coord α α') h)
      exact iff_of_false hNotInter hNotBasic
  have hConj6 : ∀ α α' : Fin n,
      let res_L := (W.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom
      let res_R := (W.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom
      (∀ c : k, res_R (algebraMap k (B α') c) = res_L (algebraMap k (B α) c)) ∧
      (∀ a : Fin n,
        res_R (r_coord α' a) * res_L (r_coord α α') = res_L (r_coord α a)) := by
    intro α α' res_L res_R
    obtain ⟨θ_inter, hL, hR⟩ := hOverlapLift α α'
    refine ⟨?_, ?_⟩
    · intro c
      let c₀ : ↥(𝒜 0) := algebraMap k ↥(𝒜 0) c
      change res_R (θ_away α' (HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X α')) c₀)) =
        res_L (θ_away α (HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X α)) c₀))
      rw [hR, hL, HomogeneousLocalization.awayMap_fromZeroRingHom,
        HomogeneousLocalization.awayMap_fromZeroRingHom]
    · intro a
      dsimp [r_coord]
      rw [hR, hL, hL, ← map_mul, hAwayCocycle α α' a]

  
  have hConj7 : ∀ (b₀ : W.left)
      (q₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W.left),
      q₀ ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      Set.range q₀.base = {b₀} →
      ι₁.left.base b₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) →
      (∀ β : Fin (N' + 1),
        ι₁.left.base b₀ ∈ weilProjHyperplaneSet k (N' + 1) (MvPolynomial.X β.succ)) →
      ∃ ev₀ : B 0 →ₐ[k] k,
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫ (hAff 0).fromSpec = q₀ ∧
        RingHom.ker ev₀.toRingHom =
          Ideal.span (Set.range (fun β : Fin (N' + 1) => r_coord 0 β.succ)) := by
    intro b₀ q₀ hq₀_hom hq₀_range hb₀_chart0 hb₀_vanish
    have hb₀_U : b₀ ∈ U_chart 0 := hb₀_chart0
    have hSub : Set.range q₀.base ⊆ Set.range (hAff 0).fromSpec.base := by
      rw [hq₀_range, (hAff 0).range_fromSpec, Set.singleton_subset_iff]
      exact hb₀_U
    let lift₀ := AlgebraicGeometry.IsOpenImmersion.lift (hAff 0).fromSpec q₀ hSub
    have hLift₀_fac : lift₀ ≫ (hAff 0).fromSpec = q₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (hAff 0).fromSpec q₀ hSub
    let φ₀ : B 0 →+* k := (AlgebraicGeometry.Spec.preimage lift₀).hom
    have hSpec_φ₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) = lift₀ :=
      AlgebraicGeometry.Spec.map_preimage lift₀
    have hComm_k : φ₀.comp (algebraMap k (B 0)) = RingHom.id k := by
      have hSpecEq :
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap k (B 0)) ≫ CommRingCat.ofHom φ₀) =
          AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
        rw [AlgebraicGeometry.Spec.map_comp, hSpec_φ₀, ← hConj4 0, ← Category.assoc,
          hLift₀_fac, hq₀_hom, AlgebraicGeometry.Spec.map_id]
      have hHomEq := AlgebraicGeometry.Spec.map_injective hSpecEq
      ext c
      exact congrArg (fun f => f.hom c) hHomEq
    let ev₀ : B 0 →ₐ[k] k :=
      { φ₀ with
        commutes' := fun c => RingHom.congr_fun hComm_k c }
    have hev₀_fac :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫ (hAff 0).fromSpec = q₀ := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ (hAff 0).fromSpec = q₀
      rw [hSpec_φ₀, hLift₀_fac]
    refine ⟨ev₀, hev₀_fac, ?_⟩
    obtain ⟨pt₀⟩ : Nonempty (PrimeSpectrum k) :=
      PrimeSpectrum.nonempty_iff_nontrivial.mpr inferInstance
    have hpt₀_bot : pt₀.asIdeal = ⊥ := by
      ext c
      simp only [Ideal.mem_bot]
      refine ⟨fun hc => ?_, fun hc => hc.symm ▸ pt₀.asIdeal.zero_mem⟩
      by_contra hc0
      exact pt₀.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem pt₀.asIdeal hc (IsUnit.mk0 c hc0))
    have hq₀_pt : q₀.base pt₀ = b₀ := by
      have hmem : q₀.base pt₀ ∈ Set.range q₀.base := Set.mem_range_self pt₀
      rwa [hq₀_range, Set.mem_singleton_iff] at hmem
    have hPrimeEq :
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom)).base pt₀ =
        (hAff 0).primeIdealOf ⟨b₀, hb₀_U⟩ := by
      apply (hAff 0).fromSpec.isOpenEmbedding.injective
      have h1 :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫
            (hAff 0).fromSpec).base pt₀ = q₀.base pt₀ :=
        congrArg (fun f => f.base pt₀) hev₀_fac
      have h1_lhs :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫
            (hAff 0).fromSpec).base pt₀ =
          (hAff 0).fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom)).base pt₀) := rfl
      have hb₀_spec : (hAff 0).fromSpec.base ((hAff 0).primeIdealOf ⟨b₀, hb₀_U⟩) = b₀ :=
        (hAff 0).fromSpec_primeIdealOf ⟨b₀, hb₀_U⟩
      exact h1_lhs.symm.trans (h1.trans (hq₀_pt.trans hb₀_spec.symm))
    have hKerIdeal : RingHom.ker ev₀.toRingHom =
        ((hAff 0).primeIdealOf ⟨b₀, hb₀_U⟩).asIdeal := by
      have hAsIdeal := congrArg PrimeSpectrum.asIdeal hPrimeEq
      have hComap :
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom)).base pt₀ :
            PrimeSpectrum (B 0)).asIdeal =
          RingHom.ker ev₀.toRingHom := by
        change Ideal.comap ev₀.toRingHom pt₀.asIdeal = RingHom.ker ev₀.toRingHom
        rw [hpt₀_bot]
        rfl
      exact hComap.symm.trans hAsIdeal
    let y : Fin (N' + 1) → B 0 := fun β => r_coord 0 β.succ
    have hy_mem_ker : ∀ β : Fin (N' + 1), y β ∈ RingHom.ker ev₀.toRingHom := by
      intro β
      rw [hKerIdeal]
      have hv := hConj3 0 (Pi.single β.succ 1) ⟨b₀, hb₀_U⟩
      rw [hSinglePoly β.succ, hSingleCoord 0 β.succ] at hv
      exact hv.mp (hb₀_vanish β)
    apply le_antisymm
    · intro b hb
      let e₀ : Fin (N' + 1) ≃ {a : Fin n // a ≠ 0} :=
        { toFun := fun β => ⟨β.succ, Fin.succ_ne_zero β⟩
          invFun := fun a => a.1.pred a.2
          left_inv := fun β => Fin.pred_succ β
          right_inv := fun a => Subtype.ext (Fin.succ_pred a.1 a.2) }
      let Ψ₀ : MvPolynomial (Fin (N' + 1)) k →ₐ[k] B 0 := MvPolynomial.aeval y
      have hΨ₀_eq :
          Ψ₀ = (MvPolynomial.aeval (R := k) (S₁ := B 0)
            (fun j : {a : Fin n // a ≠ 0} => r_coord 0 j.1)).comp
            (MvPolynomial.renameEquiv k e₀).toAlgHom := by
        apply MvPolynomial.algHom_ext
        intro β
        simp [Ψ₀, e₀, y]
      have hΨ₀_surj : Function.Surjective Ψ₀ := by
        rw [hΨ₀_eq]
        exact (hChartGen 0).comp (MvPolynomial.renameEquiv k e₀).surjective
      obtain ⟨Q, rfl⟩ := hΨ₀_surj b
      have hev_Ψ₀ : ev₀.comp Ψ₀ = MvPolynomial.aeval (0 : Fin (N' + 1) → k) := by
        apply MvPolynomial.algHom_ext
        intro β
        simp only [AlgHom.comp_apply, Ψ₀, MvPolynomial.aeval_X, Pi.zero_apply]
        exact RingHom.mem_ker.mp (hy_mem_ker β)
      have hQ0 : Q.coeff 0 = 0 := by
        have h1 : (ev₀.comp Ψ₀) Q = ev₀ (Ψ₀ Q) := rfl
        have h2 : ev₀ (Ψ₀ Q) = 0 := RingHom.mem_ker.mp hb
        rw [hev_Ψ₀] at h1
        have h3 : (MvPolynomial.aeval (0 : Fin (N' + 1) → k)) Q = Q.coeff 0 := by
          rw [← MvPolynomial.constantCoeff_eq, MvPolynomial.aeval_zero]
          rfl
        exact h3.symm.trans (h1.trans h2)
      have hQ_mem : Q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (N' + 1) → _)) := by
        rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
        intro d hd
        have hd_ne : d ≠ 0 := by
          intro hd0
          rw [hd0] at hd
          exact (MvPolynomial.mem_support_iff.mp hd) hQ0
        obtain ⟨β, hβ⟩ : ∃ β : Fin (N' + 1), d β ≠ 0 := by
          by_contra! hall
          apply hd_ne
          ext γ
          exact hall γ
        exact ⟨β, Set.mem_univ β, hβ⟩
      have hMapMem : Ψ₀.toRingHom Q ∈
          Ideal.map Ψ₀.toRingHom (Ideal.span (Set.range MvPolynomial.X)) :=
        Ideal.mem_map_of_mem Ψ₀.toRingHom hQ_mem
      rw [Ideal.map_span, ← Set.range_comp] at hMapMem
      have hCompY : (Ψ₀.toRingHom ∘ MvPolynomial.X) = y := by
        ext β
        exact MvPolynomial.aeval_X y β
      rwa [hCompY] at hMapMem
    · rw [Ideal.span_le]
      rintro _ ⟨β, rfl⟩
      exact hy_mem_ker β

  exact ⟨hAff, hAlg, hFT, r_coord, θ_away,
    hConj1,
    fun α => ⟨hSurj_θ α, hAlg_apply α, fun _ => rfl, hChartFac α⟩,
    hConj3, hConj4, hConj5, hConj6, hConj7⟩

theorem weil_algClosed_pointed_bertini_chart_specialization (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (k_sl N' : ℕ) (hN' : 1 ≤ N')
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hIntW : AlgebraicGeometry.IsIntegral W.left)
    (hDimW : topologicalKrullDim W.left = ((k_sl + 2 : ℕ) : WithBot ℕ∞))
    (ι₁ : W ⟶ weilProjectiveSpaceOver Ω (N' + 1))
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left) :
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U_chart : Fin (N' + 1 + 1) → W.left.Opens :=
      fun α => (TopologicalSpace.Opens.map ι₁.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α))
    let B : Fin (N' + 1 + 1) → Type u :=
      fun α => ↑(W.left.presheaf.obj (Opposite.op (U_chart α)))
    (∀ (Y : Set (weilProjectiveSpaceOver Ω (N' + 1)).left), IsClosed Y →
      ∀ (e : ℕ), 1 ≤ e → ((e : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y →
      ∀ (F : MvPolynomial (Fin (N' + 1 + 1)) Ω),
        F ∈ 𝒜 1 → F ≠ 0 →
        (Y ∩ weilProjHyperplaneSet Ω (N' + 1) F).Nonempty ∧
        (((e - 1 : ℕ) : WithBot ℕ∞) ≤
          topologicalKrullDim ↥(Y ∩ weilProjHyperplaneSet Ω (N' + 1) F))) →
    (∀ (Y : Set (weilProjectiveSpaceOver Ω (N' + 1)).left), IsClosed Y →
      ∃ Δ_closed : MvPolynomial (Fin (N' + 1)) Ω,
        Δ_closed ≠ 0 ∧
        ∀ c' : Fin (N' + 1) → Ω,
          MvPolynomial.eval c' Δ_closed ≠ 0 →
          topologicalKrullDim ↥(Y ∩ weilProjHyperplaneSet Ω (N' + 1)
            (∑ γ : Fin (N' + 1), MvPolynomial.C (c' γ) * MvPolynomial.X γ.succ)) + 1 ≤
            max (topologicalKrullDim ↥Y) ((1 : ℕ) : WithBot ℕ∞)) →
    ∀ (β : Fin (N' + 1))
      (hAff_β : AlgebraicGeometry.IsAffineOpen (U_chart β.succ))
      [Algebra Ω (B β.succ)]
      [Algebra.FiniteType Ω (B β.succ)]
      (r_β : Fin (N' + 1 + 1) → B β.succ),
      (∀ (c : Fin (N' + 1 + 1) → Ω) (x : ↥(U_chart β.succ)),
        ι₁.left.base x.1 ∈ weilProjHyperplaneSet Ω (N' + 1)
          (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ↔
        (∑ a : Fin (N' + 1 + 1), algebraMap Ω (B β.succ) (c a) * r_β a) ∈
          (hAff_β.primeIdealOf x).asIdeal) →
      Nontrivial (B β.succ) →
      ∀ (c_F : Fin (N' + 1) → Ω)
        (t₀ : Ω), t₀ ≠ 0 →
      ∀ (P : MvPolynomial (Fin (k_sl + 1) × Fin (N' + 1)) Ω), P ≠ 0 →
      ∃ (u_val : Fin (k_sl + 1) × Fin (N' + 1) → Ω)
        (ev_w : B β.succ →+* Ω),
        ev_w.comp (algebraMap Ω (B β.succ)) = RingHom.id Ω ∧
        MvPolynomial.eval u_val P ≠ 0 ∧
        (∀ i : Fin k_sl,
          ∑ γ : Fin (N' + 1), u_val (i.castSucc, γ) * ev_w (r_β γ.succ) = 0) ∧
        (∑ γ : Fin (N' + 1), c_F γ * ev_w (r_β γ.succ)) +
          t₀ * (∑ γ : Fin (N' + 1),
            u_val (Fin.last k_sl, γ) * ev_w (r_β γ.succ)) = 0 :=
by
  intro 𝒜 _ U_chart B hBezout hPointedAvoid β hAff_β _ _ r_β hr_vanish hNt c_F t₀ ht₀ P hP
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let _ : AlgebraicGeometry.IsIntegral W.left := hIntW
  let _ : AlgebraicGeometry.IsClosedImmersion ι₁.left := hCl₁
  have wb_le_of_add_one_le : ∀ (z : WithBot ℕ∞) (m : ℕ),
      z + 1 ≤ ((m + 1 : ℕ) : WithBot ℕ∞) → z ≤ ((m : ℕ) : WithBot ℕ∞) := by
    intro z m hz
    cases z with
    | bot => exact bot_le
    | coe a =>
      cases a with
      | top =>
        have htop : (((m + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) = ((⊤ : ℕ∞) : WithBot ℕ∞) :=
          top_le_iff.mp hz
        exact absurd (WithBot.coe_inj.mp htop) (ENat.natCast_ne_top (m + 1))
      | coe n =>
        change ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((m + 1 : ℕ) : WithBot ℕ∞) at hz
        have hnm : n + 1 ≤ m + 1 := by exact_mod_cast hz
        have hnm' : n ≤ m := by omega
        exact_mod_cast hnm'
  have hProperClosedDim : ∀ (X : Type u) [TopologicalSpace X] [IrreducibleSpace X]
      (C : Set X), IsClosed C → C ≠ Set.univ →
      topologicalKrullDim ↥C + 1 ≤ topologicalKrullDim X := by
    intro X _ _ C hC hProper
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥C) + 1 ≤
      Order.krullDim (TopologicalSpace.IrreducibleCloseds X)
    by_cases hEmpty : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥C)
    · rw [@Order.krullDim_eq_bot _ _ hEmpty, WithBot.bot_add]
      exact bot_le
    · rw [not_isEmpty_iff] at hEmpty
      rw [← @Order.krullDim_WithTop _ _ hEmpty]
      let ι_C : TopologicalSpace.IrreducibleCloseds ↥C → TopologicalSpace.IrreducibleCloseds X :=
        fun K =>
          { carrier := (Subtype.val : ↥C → X) '' K.carrier
            isIrreducible' := K.isIrreducible'.image Subtype.val continuous_subtype_val.continuousOn
            isClosed' := hC.isClosedEmbedding_subtypeVal.isClosedMap K.carrier K.isClosed' }
      let T_univ : TopologicalSpace.IrreducibleCloseds X :=
        { carrier := Set.univ
          isIrreducible' := IrreducibleSpace.isIrreducible_univ X
          isClosed' := isClosed_univ }
      let F : WithTop (TopologicalSpace.IrreducibleCloseds ↥C) →
          TopologicalSpace.IrreducibleCloseds X :=
        fun x => match x with
          | ⊤ => T_univ
          | (K : TopologicalSpace.IrreducibleCloseds ↥C) => ι_C K
      apply Order.krullDim_le_of_strictMono F
      intro a b hab
      cases a with
      | top => exact absurd hab not_top_lt
      | coe K₁ =>
        cases b with
        | top =>
          change (ι_C K₁).carrier ⊂ T_univ.carrier
          rw [Set.ssubset_iff_subset_ne]
          refine ⟨Set.subset_univ _, fun hEq => hProper ?_⟩
          apply Set.eq_univ_of_univ_subset
          intro x hx
          have hx' : x ∈ (ι_C K₁).carrier := by
            change x ∈ T_univ.carrier at hx
            rwa [← hEq] at hx
          rcases hx' with ⟨y, _, rfl⟩
          exact y.2
        | coe K₂ =>
          have hK1 : K₁ < K₂ := WithTop.coe_lt_coe.mp hab
          have hK : K₁.carrier ⊂ K₂.carrier := hK1
          change (ι_C K₁).carrier ⊂ (ι_C K₂).carrier
          rw [Set.ssubset_def] at hK ⊢
          refine ⟨Set.image_mono hK.1, fun hsub => hK.2 fun y hy => ?_⟩
          rcases hsub ⟨y, hy, rfl⟩ with ⟨z, hz, hzy⟩
          rwa [Subtype.val_injective hzy] at hz
  let P_proj := (weilProjectiveSpaceOver Ω (N' + 1)).left
  let V_hyp : MvPolynomial (Fin (N' + 1 + 1)) Ω → Set P_proj :=
    weilProjHyperplaneSet Ω (N' + 1)
  have hCl_hyp : ∀ F : MvPolynomial (Fin (N' + 1 + 1)) Ω, IsClosed (V_hyp F) :=
    fun F => (AlgebraicGeometry.Proj.basicOpen 𝒜 F).isOpen.isClosed_compl
  have krullDim_mono_of_subset : ∀ {S₁ S₂ : Set P_proj} (hS : S₁ ⊆ S₂),
      topologicalKrullDim ↥S₁ ≤ topologicalKrullDim ↥S₂ := by
    intro S₁ S₂ hS
    have hemb : Topology.IsEmbedding (Set.inclusion hS) := Topology.IsEmbedding.inclusion hS
    rw [hemb.toHomeomorph.isHomeomorph.topologicalKrullDim_eq]
    exact topologicalKrullDim_subspace_le ↥S₂ (Set.range (Set.inclusion hS))
  have exists_eval_ne_zero : ∀ {σ : Type} (G : MvPolynomial σ Ω),
      G ≠ 0 → ∃ x : σ → Ω, MvPolynomial.eval x G ≠ 0 := by
    intro σ G hG
    by_contra hAll
    simp only [not_exists, Classical.not_not] at hAll
    apply hG
    rw [@MvPolynomial.funext_set_iff Ω _ _ σ G 0 (fun _ => Set.univ) (fun _ => Set.infinite_univ)]
    intro x _
    rw [hAll x, map_zero]
  let H_pt : (Fin (N' + 1) → Ω) → MvPolynomial (Fin (N' + 1 + 1)) Ω :=
    fun d => ∑ γ : Fin (N' + 1), MvPolynomial.C (d γ) * MvPolynomial.X γ.succ
  have hH_pt_mem : ∀ d : Fin (N' + 1) → Ω, H_pt d ∈ 𝒜 1 := by
    intro d
    apply Submodule.sum_mem
    intro γ _
    change MvPolynomial.IsHomogeneous (MvPolynomial.C (d γ) * MvPolynomial.X γ.succ) 1
    simpa using (MvPolynomial.isHomogeneous_C (Fin (N' + 1 + 1)) (d γ)).mul
      (MvPolynomial.isHomogeneous_X Ω γ.succ)
  have hH_pt_ne : ∀ d : Fin (N' + 1) → Ω, d 0 ≠ 0 → H_pt d ≠ 0 := by
    intro d hd0 hZero
    let e_pt : Fin (N' + 1 + 1) → Ω := fun a => if a = (0 : Fin (N' + 1)).succ then 1 else 0
    have hev : MvPolynomial.eval e_pt (H_pt d) = d 0 := by
      simp only [H_pt, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      rw [Finset.sum_eq_single (0 : Fin (N' + 1))]
      · have hsame : e_pt (0 : Fin (N' + 1)).succ = 1 := if_pos rfl
        rw [hsame, mul_one]
      · intro γ _ hγ
        have hne : γ.succ ≠ (0 : Fin (N' + 1)).succ := fun h => hγ (Fin.succ_inj.mp h)
        have hdiff : e_pt γ.succ = 0 := if_neg hne
        rw [hdiff, mul_zero]
      · intro h0
        exact absurd (Finset.mem_univ _) h0
    rw [hZero, map_zero] at hev
    exact hd0 hev.symm
  have hAvoidWitness : ∀ (k : ℕ) (Y_S Y_Z : Set P_proj),
      IsClosed Y_S →
      IsClosed Y_Z →
      ((k + 2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y_S →
      topologicalKrullDim ↥Y_Z ≤ ((k + 1 : ℕ) : WithBot ℕ∞) →
      ∀ (P₀ : MvPolynomial (Fin (k + 1) × Fin (N' + 1)) Ω), P₀ ≠ 0 →
      ∃ (u_val : Fin (k + 1) × Fin (N' + 1) → Ω)
        (p₀ : P_proj),
        p₀ ∈ Y_S ∧
        p₀ ∉ Y_Z ∧
        MvPolynomial.eval u_val P₀ ≠ 0 ∧
        (∀ i : Fin k,
          p₀ ∈ V_hyp
            (∑ γ : Fin (N' + 1),
              MvPolynomial.C (u_val (i.castSucc, γ)) * MvPolynomial.X γ.succ)) ∧
        p₀ ∈ V_hyp
          (∑ γ : Fin (N' + 1),
            MvPolynomial.C (c_F γ + t₀ * u_val (Fin.last k, γ)) * MvPolynomial.X γ.succ) := by
    intro k
    induction k with
    | zero =>
      intro Y_S Y_Z hCl_YS hCl_YZ hDim_YS hDim_YZ P₀ hP₀
      let e₀ : (Fin 1 × Fin (N' + 1)) ≃ Fin (N' + 1) :=
        { toFun := fun p => p.2
          invFun := fun γ => (0, γ)
          left_inv := fun ⟨j, γ⟩ => Prod.ext (Subsingleton.elim 0 j) rfl
          right_inv := fun _ => rfl }
      let P_last : MvPolynomial (Fin (N' + 1)) Ω := MvPolynomial.renameEquiv Ω e₀ P₀
      have hP_last : P_last ≠ 0 :=
        fun h0 => hP₀ ((MvPolynomial.renameEquiv Ω e₀).injective (h0.trans (map_zero _).symm))
      obtain ⟨Δ_last, hΔ_ne, hΔ_bound⟩ := hPointedAvoid Y_Z hCl_YZ
      let φ_fwd : MvPolynomial (Fin (N' + 1)) Ω →+* MvPolynomial (Fin (N' + 1)) Ω :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun γ => MvPolynomial.C (c_F γ) + MvPolynomial.C t₀ * MvPolynomial.X γ)
      let φ_inv : MvPolynomial (Fin (N' + 1)) Ω →+* MvPolynomial (Fin (N' + 1)) Ω :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun γ => MvPolynomial.C t₀⁻¹ * (MvPolynomial.X γ - MvPolynomial.C (c_F γ)))
      have hφ_comp : φ_inv.comp φ_fwd = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [φ_fwd, φ_inv]
        · intro γ
          simp only [RingHom.comp_apply, RingHom.id_apply, φ_fwd, φ_inv, MvPolynomial.eval₂Hom_X',
            map_add, map_mul, MvPolynomial.eval₂Hom_C]
          rw [← mul_assoc, ← MvPolynomial.C_mul, mul_inv_cancel₀ ht₀, MvPolynomial.C_1, one_mul,
            add_sub_cancel]
      have hφ_inj : Function.Injective φ_fwd :=
        Function.LeftInverse.injective (fun Q =>
          show φ_inv (φ_fwd Q) = Q from RingHom.congr_fun hφ_comp Q)
      have hX0_ne : (MvPolynomial.X (0 : Fin (N' + 1)) : MvPolynomial (Fin (N' + 1)) Ω) ≠ 0 :=
        MvPolynomial.X_ne_zero 0
      have hφX0_ne : φ_fwd (MvPolynomial.X 0) ≠ 0 :=
        fun h0 => hX0_ne (hφ_inj (h0.trans (map_zero φ_fwd).symm))
      have hφΔ_ne : φ_fwd Δ_last ≠ 0 :=
        fun h0 => hΔ_ne (hφ_inj (h0.trans (map_zero φ_fwd).symm))
      let G_last : MvPolynomial (Fin (N' + 1)) Ω :=
        φ_fwd (MvPolynomial.X 0) * φ_fwd Δ_last * P_last
      have hG_ne : G_last ≠ 0 := mul_ne_zero (mul_ne_zero hφX0_ne hφΔ_ne) hP_last
      obtain ⟨v, hv⟩ := exists_eval_ne_zero G_last hG_ne
      let u_val : Fin 1 × Fin (N' + 1) → Ω := fun p => v p.2
      let c' : Fin (N' + 1) → Ω := fun γ => c_F γ + t₀ * v γ
      have hev_φ : (MvPolynomial.eval v).comp φ_fwd = MvPolynomial.eval c' := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [φ_fwd]
        · intro γ
          simp [φ_fwd, c']
      have hv_X0 : MvPolynomial.eval v (φ_fwd (MvPolynomial.X 0)) ≠ 0 :=
        fun h0 => hv (by simp [G_last, h0])
      have hv_Δ : MvPolynomial.eval v (φ_fwd Δ_last) ≠ 0 :=
        fun h0 => hv (by simp [G_last, h0])
      have hv_P : MvPolynomial.eval v P_last ≠ 0 :=
        fun h0 => hv (by simp [G_last, h0])
      have hc'0 : c' 0 ≠ 0 := by
        have h1 : MvPolynomial.eval c' (MvPolynomial.X 0) = c' 0 := MvPolynomial.eval_X 0
        rw [← h1, ← hev_φ]
        exact hv_X0
      have hc'_Δ : MvPolynomial.eval c' Δ_last ≠ 0 := by
        rw [← hev_φ]
        exact hv_Δ
      have hDim_YZ_cut : topologicalKrullDim ↥(Y_Z ∩ V_hyp (H_pt c')) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
        apply wb_le_of_add_one_le _ 0
        calc
          topologicalKrullDim ↥(Y_Z ∩ V_hyp (H_pt c')) + 1
            ≤ max (topologicalKrullDim ↥Y_Z) ((1 : ℕ) : WithBot ℕ∞) := hΔ_bound c' hc'_Δ
          _ ≤ ((0 + 1 : ℕ) : WithBot ℕ∞) := max_le hDim_YZ le_rfl
      obtain ⟨_, hDim_YS_cut⟩ :=
        hBezout Y_S hCl_YS 2 (by decide) hDim_YS (H_pt c') (hH_pt_mem c') (hH_pt_ne c' hc'0)
      have hNotSub : ¬ (Y_S ∩ V_hyp (H_pt c') ⊆ Y_Z ∩ V_hyp (H_pt c')) := by
        intro hSub
        have h10 : (((2 - 1 : ℕ) : WithBot ℕ∞)) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
          hDim_YS_cut.trans ((krullDim_mono_of_subset hSub).trans hDim_YZ_cut)
        norm_num at h10
      obtain ⟨p₀, hp₀_YS_cut, hp₀_not_YZ_cut⟩ := Set.not_subset.mp hNotSub
      have hp₀_YS : p₀ ∈ Y_S := hp₀_YS_cut.1
      have hp₀_hyp : p₀ ∈ V_hyp (H_pt c') := hp₀_YS_cut.2
      have hp₀_not_YZ : p₀ ∉ Y_Z := fun hYZ => hp₀_not_YZ_cut ⟨hYZ, hp₀_hyp⟩
      have hev_u : MvPolynomial.eval u_val P₀ ≠ 0 := by
        have hren : MvPolynomial.eval v P_last = MvPolynomial.eval (v ∘ e₀) P₀ :=
          MvPolynomial.eval_rename e₀ v P₀
        have hcomp : v ∘ e₀ = u_val := rfl
        rwa [← hcomp, ← hren]
      exact ⟨u_val, p₀, hp₀_YS, hp₀_not_YZ, hev_u, fun i => Fin.elim0 i, hp₀_hyp⟩
    | succ k ih =>
      intro Y_S Y_Z hCl_YS hCl_YZ hDim_YS hDim_YZ P₀ hP₀
      let S₁ := Fin (k + 1) × Fin (N' + 1)
      let S₂ := Fin (N' + 1)
      let e_split : (Fin ((k + 1) + 1) × Fin (N' + 1)) ≃ S₁ ⊕ S₂ :=
        { toFun := fun ⟨j, γ⟩ => Fin.cases (Sum.inr γ) (fun j' => Sum.inl (j', γ)) j
          invFun := Sum.elim (fun q => (q.1.succ, q.2)) (fun γ => (0, γ))
          left_inv := fun ⟨j, γ⟩ => by
            refine Fin.cases ?_ ?_ j
            · rfl
            · intro j'; rfl
          right_inv := fun x => by
            cases x with
            | inl q => rfl
            | inr γ => rfl }
      let P_sum : MvPolynomial (S₁ ⊕ S₂) Ω := MvPolynomial.renameEquiv Ω e_split P₀
      have hP_sum : P_sum ≠ 0 :=
        fun h0 => hP₀ ((MvPolynomial.renameEquiv Ω e_split).injective (h0.trans (map_zero _).symm))
      obtain ⟨Δ_0, hΔ0_ne, hΔ0_bound⟩ := hPointedAvoid Y_Z hCl_YZ
      have hXr0_ne : (MvPolynomial.X (Sum.inr (0 : S₂)) : MvPolynomial (S₁ ⊕ S₂) Ω) ≠ 0 :=
        MvPolynomial.X_ne_zero _
      let Δ_lift : MvPolynomial (S₁ ⊕ S₂) Ω := MvPolynomial.rename Sum.inr Δ_0
      have hΔ_lift_ne : Δ_lift ≠ 0 := by
        intro h0
        let proj_inr : S₁ ⊕ S₂ → S₂ := Sum.elim (fun _ => 0) id
        have hrec : MvPolynomial.rename proj_inr Δ_lift = Δ_0 := by
          dsimp [Δ_lift]
          rw [MvPolynomial.rename_rename]
          have hid : proj_inr ∘ Sum.inr = id := rfl
          rw [hid, MvPolynomial.rename_id, AlgHom.id_apply]
        rw [h0, map_zero] at hrec
        exact hΔ0_ne hrec.symm
      let G_0 : MvPolynomial (S₁ ⊕ S₂) Ω := MvPolynomial.X (Sum.inr 0) * Δ_lift * P_sum
      have hG0_ne : G_0 ≠ 0 := mul_ne_zero (mul_ne_zero hXr0_ne hΔ_lift_ne) hP_sum
      obtain ⟨w, hw⟩ := exists_eval_ne_zero G_0 hG0_ne
      let u_head : S₂ → Ω := fun γ => w (Sum.inr γ)
      let w_tail : S₁ → Ω := fun q => w (Sum.inl q)
      have hu0_ne : u_head 0 ≠ 0 :=
        fun h0 => hw (by simp [G_0, u_head] at h0 ⊢; simp [h0])
      have huΔ_ne : MvPolynomial.eval u_head Δ_0 ≠ 0 := by
        have hren : MvPolynomial.eval w Δ_lift = MvPolynomial.eval (w ∘ Sum.inr) Δ_0 :=
          MvPolynomial.eval_rename Sum.inr w Δ_0
        have hwΔ : MvPolynomial.eval w Δ_lift ≠ 0 :=
          fun h0 => hw (by simp [G_0, h0])
        rwa [hren] at hwΔ
      have hwP_ne : MvPolynomial.eval w P_sum ≠ 0 :=
        fun h0 => hw (by simp [G_0, h0])
      let eval_head : MvPolynomial (S₁ ⊕ S₂) Ω →+* MvPolynomial S₁ Ω :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (Sum.elim MvPolynomial.X (fun γ => MvPolynomial.C (u_head γ)))
      have hev_head : ∀ t_tail : S₁ → Ω,
          (MvPolynomial.eval t_tail).comp eval_head = MvPolynomial.eval (Sum.elim t_tail u_head) := by
        intro t_tail
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [eval_head]
        · intro s
          cases s with
          | inl q => simp [eval_head]
          | inr γ => simp [eval_head]
      let P' : MvPolynomial S₁ Ω := eval_head P_sum
      have hP' : P' ≠ 0 := by
        intro h0
        have hev0 : MvPolynomial.eval w_tail P' = 0 := by rw [h0, map_zero]
        have hEq : MvPolynomial.eval w_tail P' = MvPolynomial.eval (Sum.elim w_tail u_head) P_sum :=
          RingHom.congr_fun (hev_head w_tail) P_sum
        have hw_elim : Sum.elim w_tail u_head = w := by
          ext s; cases s <;> rfl
        rw [hEq, hw_elim] at hev0
        exact hwP_ne hev0
      let Y_S' : Set P_proj := Y_S ∩ V_hyp (H_pt u_head)
      let Y_Z' : Set P_proj := Y_Z ∩ V_hyp (H_pt u_head)
      have hCl_YS' : IsClosed Y_S' := hCl_YS.inter (hCl_hyp _)
      have hCl_YZ' : IsClosed Y_Z' := hCl_YZ.inter (hCl_hyp _)
      obtain ⟨_, hDim_YS'⟩ :=
        hBezout Y_S hCl_YS (k + 3) (by omega) hDim_YS
          (H_pt u_head) (hH_pt_mem u_head) (hH_pt_ne u_head hu0_ne)
      have hDim_YZ' : topologicalKrullDim ↥Y_Z' ≤ ((k + 1 : ℕ) : WithBot ℕ∞) := by
        apply wb_le_of_add_one_le _ (k + 1)
        calc
          topologicalKrullDim ↥Y_Z' + 1
            ≤ max (topologicalKrullDim ↥Y_Z) ((1 : ℕ) : WithBot ℕ∞) := hΔ0_bound u_head huΔ_ne
          _ ≤ ((k + 1 + 1 : ℕ) : WithBot ℕ∞) := by
            apply max_le hDim_YZ
            have h1le : (1 : ℕ) ≤ k + 1 + 1 := by omega
            exact_mod_cast h1le
      obtain ⟨u_tail, p₀, hp₀_YS', hp₀_not_YZ', hev_P', hHyp_tail, hHyp_last⟩ :=
        ih Y_S' Y_Z' hCl_YS' hCl_YZ' hDim_YS' hDim_YZ' P' hP'
      let u_val : Fin ((k + 1) + 1) × Fin (N' + 1) → Ω :=
        fun ⟨j, γ⟩ => Fin.cases (u_head γ) (fun j' => u_tail (j', γ)) j
      have hev_u : MvPolynomial.eval u_val P₀ ≠ 0 := by
        have hEq1 : MvPolynomial.eval u_tail P' =
            MvPolynomial.eval (Sum.elim u_tail u_head) P_sum :=
          RingHom.congr_fun (hev_head u_tail) P_sum
        have hEq2 : MvPolynomial.eval (Sum.elim u_tail u_head) P_sum =
            MvPolynomial.eval ((Sum.elim u_tail u_head) ∘ e_split) P₀ :=
          MvPolynomial.eval_rename e_split (Sum.elim u_tail u_head) P₀
        have hEq3 : (Sum.elim u_tail u_head) ∘ e_split = u_val := by
          ext ⟨j, γ⟩
          refine Fin.cases ?_ ?_ j
          · rfl
          · intro j'; rfl
        rw [← hEq3, ← hEq2, ← hEq1]
        exact hev_P'
      refine ⟨u_val, p₀, hp₀_YS'.1, fun hYZ => hp₀_not_YZ' ⟨hYZ, hp₀_YS'.2⟩, hev_u, ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ ?_ i
        · change p₀ ∈ V_hyp (H_pt u_head)
          exact hp₀_YS'.2
        · intro i'
          rw [← Fin.succ_castSucc]
          exact hHyp_tail i'
      · rw [← Fin.succ_last]
        exact hHyp_last
  have hNullstellensatz : ∀ (A : Type u) [CommRing A] [Algebra Ω A] [Algebra.FiniteType Ω A]
      (I : Ideal A), I ≠ ⊤ →
      ∃ ev : A →+* Ω,
        ev.comp (algebraMap Ω A) = RingHom.id Ω ∧
        I ≤ RingHom.ker ev := by
    intro A _ _ _ I hI
    obtain ⟨𝔪, h𝔪, hI_le⟩ := Ideal.exists_le_maximal I hI
    have : 𝔪.IsMaximal := h𝔪
    obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType Ω A›
    let 𝔪_P : Ideal (MvPolynomial (Fin n) Ω) := Ideal.comap φ.toRingHom 𝔪
    have h𝔪_P : 𝔪_P.IsMaximal := Ideal.comap_isMaximal_of_surjective φ.toRingHom hφ
    obtain ⟨a, ha⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp h𝔪_P
    let ε_a : MvPolynomial (Fin n) Ω →ₐ[Ω] Ω := MvPolynomial.aeval a
    have hmem_iff : ∀ Q : MvPolynomial (Fin n) Ω, φ Q ∈ 𝔪 ↔ ε_a Q = 0 := by
      intro Q
      change Q ∈ 𝔪_P ↔ ε_a Q = 0
      rw [ha, MvPolynomial.mem_vanishingIdeal_iff]
      simp [ε_a]
    have hker : RingHom.ker φ.toRingHom ≤ RingHom.ker ε_a.toRingHom := by
      intro Q hQ
      rw [RingHom.mem_ker] at hQ ⊢
      have hQ' : φ Q = 0 := hQ
      exact (hmem_iff Q).mp (by rw [hQ']; exact 𝔪.zero_mem)
    let ev : A →+* Ω :=
      RingHom.liftOfRightInverse φ.toRingHom (Function.surjInv hφ)
        (Function.rightInverse_surjInv hφ) ⟨ε_a.toRingHom, hker⟩
    have hev_φ : ∀ Q : MvPolynomial (Fin n) Ω, ev (φ Q) = ε_a Q := fun Q =>
      RingHom.congr_fun
        (RingHom.liftOfRightInverse_comp φ.toRingHom (Function.surjInv hφ)
          (Function.rightInverse_surjInv hφ) ⟨ε_a.toRingHom, hker⟩) Q
    refine ⟨ev, ?_, ?_⟩
    · ext c
      rw [RingHom.comp_apply, RingHom.id_apply, ← φ.commutes c, hev_φ, ε_a.commutes c]
      simp
    · intro x hx
      rw [RingHom.mem_ker, ← Function.rightInverse_surjInv hφ x, hev_φ]
      apply (hmem_iff _).mp
      rw [Function.rightInverse_surjInv hφ x]
      exact hI_le hx
  obtain ⟨p_spec⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNt
  have hp_mem : hAff_β.fromSpec.base p_spec ∈ (U_chart β.succ : Set W.left) := by
    rw [← hAff_β.range_fromSpec]
    exact Set.mem_range_self p_spec
  let C_bad : Set W.left := (U_chart β.succ : Set W.left)ᶜ
  have hCl_C : IsClosed C_bad := (U_chart β.succ).isOpen.isClosed_compl
  have hProp_C : C_bad ≠ Set.univ := by
    intro hEq
    have h_in : hAff_β.fromSpec.base p_spec ∈ C_bad := by
      rw [hEq]
      exact Set.mem_univ _
    exact h_in hp_mem
  have _ : IrreducibleSpace W.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral W.left
  have hDim_C_succ : topologicalKrullDim ↥C_bad + 1 ≤ ((k_sl + 1 + 1 : ℕ) : WithBot ℕ∞) := by
    have h1 := hProperClosedDim W.left C_bad hCl_C hProp_C
    rwa [hDimW] at h1
  have hDim_C : topologicalKrullDim ↥C_bad ≤ ((k_sl + 1 : ℕ) : WithBot ℕ∞) :=
    wb_le_of_add_one_le _ (k_sl + 1) hDim_C_succ
  have hClEmb : Topology.IsClosedEmbedding ι₁.left.base := ι₁.left.isClosedEmbedding
  let Y_S : Set P_proj := Set.range ι₁.left.base
  let Y_Z : Set P_proj := ι₁.left.base '' C_bad
  have hCl_YS : IsClosed Y_S := hClEmb.isClosed_range
  have hDim_YS : ((k_sl + 2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y_S := by
    rw [← hClEmb.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq, hDimW]
  have hCl_YZ : IsClosed Y_Z := hClEmb.isClosedMap C_bad hCl_C
  have hDim_YZ : topologicalKrullDim ↥Y_Z ≤ ((k_sl + 1 : ℕ) : WithBot ℕ∞) := by
    have hg : Topology.IsEmbedding (ι₁.left.base ∘ (Subtype.val : ↥C_bad → W.left)) :=
      hClEmb.isEmbedding.comp Topology.IsEmbedding.subtypeVal
    have hRange : Set.range (ι₁.left.base ∘ (Subtype.val : ↥C_bad → W.left)) = Y_Z := by
      rw [Set.range_comp, Subtype.range_coe]
    let e : ↥C_bad ≃ₜ ↥Y_Z := hg.toHomeomorph.trans (Homeomorph.setCongr hRange)
    rw [← e.isHomeomorph.topologicalKrullDim_eq]
    exact hDim_C
  obtain ⟨u_val, p₀, hp₀_YS, hp₀_not_YZ, hev_P, hHyp_i, hHyp_last⟩ :=
    hAvoidWitness k_sl Y_S Y_Z hCl_YS hCl_YZ hDim_YS hDim_YZ P hP
  rcases hp₀_YS with ⟨w₀, hw₀_eq⟩
  have hw₀_not_C : w₀ ∉ C_bad := fun hwC => hp₀_not_YZ ⟨w₀, hwC, hw₀_eq⟩
  have hw₀_U : w₀ ∈ U_chart β.succ := by
    by_contra hwNot
    exact hw₀_not_C hwNot
  let x₀ : ↥(U_chart β.succ) := ⟨w₀, hw₀_U⟩
  let 𝔭₀ : Ideal (B β.succ) := (hAff_β.primeIdealOf x₀).asIdeal
  have h𝔭₀_ne : 𝔭₀ ≠ ⊤ := (hAff_β.primeIdealOf x₀).isPrime.ne_top
  obtain ⟨ev_w, hev_id, hev_ker⟩ := hNullstellensatz (B β.succ) 𝔭₀ h𝔭₀_ne
  have hev_alg : ∀ z : Ω, ev_w (algebraMap Ω (B β.succ) z) = z :=
    fun z => RingHom.congr_fun hev_id z
  have hVanishEval : ∀ d_vec : Fin (N' + 1) → Ω,
      p₀ ∈ V_hyp
        (∑ γ : Fin (N' + 1), MvPolynomial.C (d_vec γ) * MvPolynomial.X γ.succ) →
      ∑ γ : Fin (N' + 1), d_vec γ * ev_w (r_β γ.succ) = 0 := by
    intro d_vec hp_mem_hyp
    let c_ext : Fin (N' + 1 + 1) → Ω := Fin.cases 0 d_vec
    have hPoly_eq :
        (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c_ext a) * MvPolynomial.X a) =
        ∑ γ : Fin (N' + 1), MvPolynomial.C (d_vec γ) * MvPolynomial.X γ.succ := by
      rw [Fin.sum_univ_succ]
      simp [c_ext]
    have hSum_eq :
        (∑ a : Fin (N' + 1 + 1), algebraMap Ω (B β.succ) (c_ext a) * r_β a) =
        ∑ γ : Fin (N' + 1), algebraMap Ω (B β.succ) (d_vec γ) * r_β γ.succ := by
      rw [Fin.sum_univ_succ]
      simp [c_ext]
    have hx₀_hyp : ι₁.left.base x₀.1 ∈ weilProjHyperplaneSet Ω (N' + 1)
        (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c_ext a) * MvPolynomial.X a) := by
      rw [hPoly_eq]
      change ι₁.left.base w₀ ∈ _
      rwa [hw₀_eq]
    have h_in_𝔭₀ :
        (∑ γ : Fin (N' + 1), algebraMap Ω (B β.succ) (d_vec γ) * r_β γ.succ) ∈ 𝔭₀ := by
      rw [← hSum_eq]
      exact (hr_vanish c_ext x₀).mp hx₀_hyp
    have h_ker : ev_w (∑ γ : Fin (N' + 1), algebraMap Ω (B β.succ) (d_vec γ) * r_β γ.succ) = 0 :=
      hev_ker h_in_𝔭₀
    simpa only [map_sum, map_mul, hev_alg] using h_ker
  refine ⟨u_val, ev_w, hev_id, hev_P, ?_, ?_⟩
  · intro i
    exact hVanishEval (fun γ => u_val (i.castSucc, γ)) (hHyp_i i)
  · have hLast0 := hVanishEval (fun γ => c_F γ + t₀ * u_val (Fin.last k_sl, γ)) hHyp_last
    have hExpand :
        (∑ γ : Fin (N' + 1), (c_F γ + t₀ * u_val (Fin.last k_sl, γ)) * ev_w (r_β γ.succ)) =
        (∑ γ : Fin (N' + 1), c_F γ * ev_w (r_β γ.succ)) +
          t₀ * (∑ γ : Fin (N' + 1), u_val (Fin.last k_sl, γ) * ev_w (r_β γ.succ)) := by
      simp only [add_mul, mul_assoc, Finset.sum_add_distrib, Finset.mul_sum]
    rwa [hExpand] at hLast0

theorem weil_algClosed_domain_maximal_hypersurface_codimOne_prime (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (d : ℕ) (hd : 1 ≤ d)
    (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [Algebra Ω B₀] [Algebra.FiniteType Ω B₀]
    (hDim : ringKrullDim B₀ = (d : WithBot ℕ∞))
    (𝔪 : Ideal B₀) [h𝔪 : 𝔪.IsMaximal]
    (f₀ : B₀) (hf₀_ne : f₀ ≠ 0) (hf₀_mem : f₀ ∈ 𝔪) :
    ∃ 𝔮 : PrimeSpectrum B₀,
      f₀ ∈ 𝔮.asIdeal ∧
      𝔮.asIdeal ≤ 𝔪 ∧
      ((d - 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (B₀ ⧸ 𝔮.asIdeal) :=
by
  let _ := hf₀_ne
  obtain ⟨s, g₀, hg₀_inj, hg₀_int⟩ := exists_integral_inj_algHom_of_fg Ω B₀
  have hHt : ((d : ℕ) : ℕ∞) ≤ 𝔪.height := by
    letI : Algebra (MvPolynomial (Fin s) Ω) B₀ := g₀.toRingHom.toAlgebra
    have hAlgMap : (algebraMap (MvPolynomial (Fin s) Ω) B₀ : MvPolynomial (Fin s) Ω → B₀) = g₀ :=
      rfl
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) Ω) B₀ := ⟨fun x => hg₀_int x⟩
    haveI : FaithfulSMul (MvPolynomial (Fin s) Ω) B₀ :=
      (faithfulSMul_iff_algebraMap_injective (MvPolynomial (Fin s) Ω) B₀).mpr
        (by simpa [hAlgMap] using hg₀_inj)
    have hStrictComap :
        StrictMono (PrimeSpectrum.comap (algebraMap (MvPolynomial (Fin s) Ω) B₀)) := by
      intro Q₁ Q₂ hlt
      have hnot : ¬ ((Q₂.asIdeal : Set B₀) ⊆ (Q₁.asIdeal : Set B₀)) := hlt.not_ge
      obtain ⟨x, hx₂, hx₁⟩ := Set.not_subset.mp hnot
      exact Ideal.under_lt_under_of_integral_mem_sdiff hlt.le ⟨hx₂, hx₁⟩
        (Algebra.IsIntegral.isIntegral x)
    have hDimB_le_P : ringKrullDim B₀ ≤ ringKrullDim (MvPolynomial (Fin s) Ω) :=
      Order.krullDim_le_of_strictMono _ hStrictComap
    have hDimP : ringKrullDim (MvPolynomial (Fin s) Ω) = ((s : ℕ) : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing,
        ringKrullDim_eq_zero_of_isField (Field.toIsField Ω),
        ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
      rfl
    have hd_le_s : d ≤ s := by
      have hle : ((d : ℕ) : WithBot ℕ∞) ≤ ((s : ℕ) : WithBot ℕ∞) := by
        rw [← hDim, ← hDimP]
        exact hDimB_le_P
      exact Nat.cast_le.mp hle
    haveI : 𝔪.IsPrime := h𝔪.isPrime
    let 𝔪₀ : Ideal (MvPolynomial (Fin s) Ω) := Ideal.under (MvPolynomial (Fin s) Ω) 𝔪
    haveI : 𝔪₀.IsMaximal := Ideal.IsMaximal.under (MvPolynomial (Fin s) Ω) 𝔪
    obtain ⟨c, hm_eq⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := 𝔪₀)).mp inferInstance
    let σ : Fin (s + 1) → (MvPolynomial (Fin s) Ω →ₐ[Ω] MvPolynomial (Fin s) Ω) := fun r =>
      MvPolynomial.aeval (fun i : Fin s =>
        if i.1 < r.1 then MvPolynomial.C (c i) else MvPolynomial.X i)
    let q : Fin (s + 1) → PrimeSpectrum (MvPolynomial (Fin s) Ω) := fun r =>
      ⟨RingHom.ker (σ r).toRingHom, RingHom.ker_isPrime (σ r).toRingHom⟩
    have hq_step : ∀ r : Fin s, q r.castSucc < q r.succ := by
      intro r
      have hcomp : (σ r.succ).comp (σ r.castSucc) = σ r.succ := by
        apply MvPolynomial.algHom_ext
        intro i
        dsimp only [σ]
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X]
        by_cases h1 : i.1 < r.1
        · have h1_cs : i.1 < (r.castSucc).1 := h1
          have h1_su : i.1 < (r.succ).1 := Nat.lt_succ_of_lt h1
          rw [if_pos h1_cs, MvPolynomial.aeval_X, if_pos h1_su,
            MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
        · have h1_cs : ¬ (i.1 < (r.castSucc).1) := h1
          rw [if_neg h1_cs]
      have hle : (q r.castSucc).asIdeal ≤ (q r.succ).asIdeal := by
        intro f hf
        change (σ r.castSucc) f = 0 at hf
        change (σ r.succ) f = 0
        rw [← hcomp, AlgHom.comp_apply, hf, map_zero]
      let w : MvPolynomial (Fin s) Ω := MvPolynomial.X r - MvPolynomial.C (c r)
      have hw_mem : w ∈ (q r.succ).asIdeal := by
        change (σ r.succ) w = 0
        have hr_lt : r.1 < (r.succ).1 := Nat.lt_succ_self r.1
        dsimp only [w, σ]
        rw [map_sub, MvPolynomial.aeval_X, if_pos hr_lt,
          MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, sub_self]
      have hw_not : w ∉ (q r.castSucc).asIdeal := by
        intro hw
        change (σ r.castSucc) w = 0 at hw
        have hr_nlt : ¬ (r.1 < (r.castSucc).1) := Nat.lt_irrefl r.1
        dsimp only [w, σ] at hw
        rw [map_sub, MvPolynomial.aeval_X, if_neg hr_nlt,
          MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq] at hw
        have hev := congrArg (MvPolynomial.eval (Function.update c r (c r + 1))) hw
        rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C,
          Function.update_self, add_sub_cancel_left, map_zero] at hev
        exact one_ne_zero hev
      exact lt_of_le_not_ge hle (fun hge => hw_not (hge hw_mem))
    have hq_mono : StrictMono q := Fin.strictMono_iff_lt_succ.mpr hq_step
    let l₀ : LTSeries (PrimeSpectrum (MvPolynomial (Fin s) Ω)) := LTSeries.mk s q hq_mono
    have hl₀_len : l₀.length = s := LTSeries.mk_length s q hq_mono
    have hl₀_last : (RelSeries.last l₀).asIdeal = 𝔪₀ := by
      have hlast_q : RelSeries.last l₀ = q (Fin.last s) := rfl
      rw [hlast_q]
      have hσ_last : σ (Fin.last s) =
          (Algebra.ofId Ω (MvPolynomial (Fin s) Ω)).comp (MvPolynomial.aeval c) := by
        apply MvPolynomial.algHom_ext
        intro i
        have hi_lt : i.1 < (Fin.last s).1 := i.isLt
        dsimp only [σ]
        rw [MvPolynomial.aeval_X, if_pos hi_lt, AlgHom.comp_apply,
          MvPolynomial.aeval_X, Algebra.ofId_apply, MvPolynomial.algebraMap_eq]
      ext f
      change (σ (Fin.last s)) f = 0 ↔ f ∈ 𝔪₀
      rw [hσ_last, AlgHom.comp_apply, Algebra.ofId_apply, MvPolynomial.algebraMap_eq,
        map_eq_zero_iff (MvPolynomial.C) (MvPolynomial.C_injective (Fin s) Ω),
        congrFun (MvPolynomial.aeval_eq_eval c) f, hm_eq, MvPolynomial.mem_vanishingIdeal_iff]
      constructor
      · intro hf x hx
        rw [Set.mem_singleton_iff.mp hx]
        exact hf
      · intro hf
        exact hf c (Set.mem_singleton c)
    haveI : IsIntegrallyClosed (MvPolynomial (Fin s) Ω) :=
      UniqueFactorizationMonoid.instIsIntegrallyClosed
    haveI : Algebra.HasGoingDown (MvPolynomial (Fin s) Ω) B₀ := inferInstance
    haveI : 𝔪.LiesOver (RelSeries.last l₀).asIdeal := by
      rw [Ideal.liesOver_iff, hl₀_last]
    obtain ⟨L_B, hLB_len, hLB_last, _⟩ := Ideal.exists_ltSeries_of_hasGoingDown l₀ 𝔪
    have hChainHt : ∀ (n : ℕ) (f : Fin (n + 1) → PrimeSpectrum B₀),
        StrictMono f → ∀ (Q : Ideal B₀) [Q.IsPrime],
          (f (Fin.last n)).asIdeal ≤ Q → ((n : ℕ) : ℕ∞) ≤ Q.height := by
      intro n
      induction n with
      | zero =>
        intro _ _ _ _ _
        simp
      | succ n' ih =>
        intro f hf Q hQ hleQ
        let Q' : PrimeSpectrum B₀ := f (Fin.last n').castSucc
        have hlt_f : Q' < f (Fin.last (n' + 1)) :=
          hf (Fin.castSucc_lt_last (Fin.last n'))
        have hltQ : Q'.asIdeal < Q := lt_of_lt_of_le hlt_f hleQ
        have ihQ' : ((n' : ℕ) : ℕ∞) ≤ Q'.asIdeal.height :=
          ih (fun i => f i.castSucc) (fun i j hij => hf hij) Q'.asIdeal le_rfl
        by_contra hnot
        have hQ_le : Q.height ≤ (n' : ℕ∞) := by
          cases hQh : Q.height using ENat.recTopCoe with
          | top =>
            rw [hQh] at hnot
            exact absurd le_top hnot
          | coe r =>
            rw [hQh] at hnot
            have hr : ¬ (n' + 1 ≤ r) := by exact_mod_cast hnot
            exact ENat.coe_le_coe.mpr (by omega)
        have hQ'_lt : Q'.asIdeal.height < (n' : ℕ∞) :=
          (Ideal.height_le_iff.mp hQ_le) Q'.asIdeal Q'.isPrime hltQ
        exact not_lt_of_ge ihQ' hQ'_lt
    have hs_le_ht : ((s : ℕ) : ℕ∞) ≤ 𝔪.height := by
      rw [← hl₀_len, ← hLB_len]
      exact hChainHt L_B.length L_B L_B.strictMono 𝔪
        (le_of_eq (congrArg PrimeSpectrum.asIdeal hLB_last))
    exact (ENat.coe_le_coe.mpr hd_le_s).trans hs_le_ht
  haveI : IsNoetherianRing B₀ := Algebra.FiniteType.isNoetherianRing Ω B₀
  haveI : 𝔪.IsPrime := h𝔪.isPrime
  let R_loc := Localization.AtPrime 𝔪
  haveI : IsNoetherianRing R_loc :=
    IsLocalization.isNoetherianRing 𝔪.primeCompl R_loc inferInstance
  let M_loc : Ideal R_loc := IsLocalRing.maximalIdeal R_loc
  haveI : M_loc.IsPrime := (inferInstance : M_loc.IsMaximal).isPrime
  have hM_ht : ((d : ℕ) : WithBot ℕ∞) ≤ (M_loc.height : WithBot ℕ∞) := by
    rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := R_loc),
      IsLocalization.AtPrime.ringKrullDim_eq_height 𝔪 R_loc]
    exact WithBot.coe_le_coe.mpr hHt
  let f_loc : R_loc := algebraMap B₀ R_loc f₀
  have hf_loc_mem : f_loc ∈ M_loc :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc 𝔪 f₀).mpr hf₀_mem
  let Q_ring := R_loc ⧸ Ideal.span {f_loc}
  have hKrull_add : ((d : ℕ) : WithBot ℕ∞) ≤ ringKrullDim Q_ring + 1 :=
    hM_ht.trans
      (@Ideal.height_le_ringKrullDim_quotient_add_one R_loc _ _ f_loc M_loc _ hf_loc_mem)
  have hDimQ : ((d - 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim Q_ring := by
    cases hq : ringKrullDim Q_ring using WithBot.recBotCoe with
    | bot =>
      rw [hq] at hKrull_add
      exact absurd hKrull_add (by simp)
    | coe a =>
      cases a using ENat.recTopCoe with
      | top =>
        exact WithBot.coe_le_coe.mpr le_top
      | coe r =>
        rw [hq] at hKrull_add
        have hdr : d ≤ r + 1 := by exact_mod_cast hKrull_add
        change ((d - 1 : ℕ) : WithBot ℕ∞) ≤ ((r : ℕ) : WithBot ℕ∞)
        exact Nat.cast_le.mpr (by omega)
  have hNotLt : ¬ Order.krullDim (PrimeSpectrum Q_ring) < ((d - 1 : ℕ) : WithBot ℕ∞) :=
    not_lt_of_ge hDimQ
  rw [Order.krullDim_lt_coe_iff, not_forall] at hNotLt
  obtain ⟨l, hl_not_lt⟩ := hNotLt
  have hl_len : d - 1 ≤ l.length := not_lt.mp hl_not_lt
  let π : R_loc →+* Q_ring := Ideal.Quotient.mk (Ideal.span {f_loc})
  let pull : PrimeSpectrum Q_ring → PrimeSpectrum B₀ :=
    fun p => PrimeSpectrum.comap (algebraMap B₀ R_loc) (PrimeSpectrum.comap π p)
  let 𝔮 : PrimeSpectrum B₀ := pull (l 0)
  have hf₀_in_𝔮 : f₀ ∈ 𝔮.asIdeal := by
    change π (algebraMap B₀ R_loc f₀) ∈ (l 0).asIdeal
    have hzero : π (algebraMap B₀ R_loc f₀) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [hzero]
    exact Ideal.zero_mem (l 0).asIdeal
  have h𝔮_le_𝔪 : 𝔮.asIdeal ≤ 𝔪 := by
    let Q₀ : PrimeSpectrum R_loc := PrimeSpectrum.comap π (l 0)
    have hQ₀_le : Q₀.asIdeal ≤ M_loc := IsLocalRing.le_maximalIdeal Q₀.isPrime.ne_top
    have hcomap_le : Ideal.comap (algebraMap B₀ R_loc) Q₀.asIdeal ≤
        Ideal.comap (algebraMap B₀ R_loc) M_loc :=
      Ideal.comap_mono hQ₀_le
    have hunder : Ideal.comap (algebraMap B₀ R_loc) M_loc = 𝔪 :=
      @Localization.AtPrime.under_maximalIdeal B₀ _ 𝔪 _
    exact hcomap_le.trans_eq hunder
  have hπ_strict : StrictMono (PrimeSpectrum.comap π) := by
    intro p₁ p₂ hlt
    refine lt_of_le_not_ge (Ideal.comap_mono hlt.le) ?_
    intro hge
    apply hlt.not_ge
    intro y hy
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact hge hy
  have hloc_strict : StrictMono (PrimeSpectrum.comap (algebraMap B₀ R_loc)) := by
    intro q₁ q₂ hlt
    refine lt_of_le_not_ge (Ideal.comap_mono hlt.le) ?_
    intro hge
    apply hlt.not_ge
    have hmap : Ideal.map (algebraMap B₀ R_loc) (Ideal.comap (algebraMap B₀ R_loc) q₂.asIdeal) ≤
        Ideal.map (algebraMap B₀ R_loc) (Ideal.comap (algebraMap B₀ R_loc) q₁.asIdeal) :=
      Ideal.map_mono hge
    rwa [IsLocalization.map_comap 𝔪.primeCompl R_loc q₂.asIdeal,
      IsLocalization.map_comap 𝔪.primeCompl R_loc q₁.asIdeal] at hmap
  have hpull_strict : StrictMono pull := hloc_strict.comp hπ_strict
  let f_chain : Fin (l.length + 1) → ↥(PrimeSpectrum.zeroLocus (𝔮.asIdeal : Set B₀)) :=
    fun i => ⟨pull (l i), by
      rw [PrimeSpectrum.mem_zeroLocus]
      exact hpull_strict.monotone (l.monotone (Fin.zero_le i))⟩
  have hf_strict : StrictMono f_chain := by
    intro i j hij
    exact hpull_strict (l.strictMono hij)
  let l_B : LTSeries ↥(PrimeSpectrum.zeroLocus (𝔮.asIdeal : Set B₀)) :=
    LTSeries.mk l.length f_chain hf_strict
  have hDim_quot : ((d - 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (B₀ ⧸ 𝔮.asIdeal) := by
    rw [ringKrullDim_quotient]
    calc
      ((d - 1 : ℕ) : WithBot ℕ∞) ≤ ((l.length : ℕ) : WithBot ℕ∞) := Nat.cast_le.mpr hl_len
      _ = ((l_B.length : ℕ) : WithBot ℕ∞) := by rw [LTSeries.mk_length]
      _ ≤ Order.krullDim ↥(PrimeSpectrum.zeroLocus (𝔮.asIdeal : Set B₀)) :=
          Order.LTSeries.length_le_krullDim l_B
  exact ⟨𝔮, hf₀_in_𝔮, h𝔮_le_𝔪, hDim_quot⟩

theorem weil_algClosed_proj_baseChange_codimOne_bezout_witness (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (d N' : ℕ) (hd : 2 ≤ d) (hN' : 1 ≤ N')
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (ι₁ : W ⟶ weilProjectiveSpaceOver Ω (N' + 1))
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left) :
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U_chart : Fin (N' + 1 + 1) → W.left.Opens :=
      fun α => (TopologicalSpace.Opens.map ι₁.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α))
    let B : Fin (N' + 1 + 1) → Type u :=
      fun α => ↑(W.left.presheaf.obj (Opposite.op (U_chart α)))
    ∀ (hAff : ∀ α : Fin (N' + 1 + 1), AlgebraicGeometry.IsAffineOpen (U_chart α))
      [∀ α : Fin (N' + 1 + 1), Algebra Ω (B α)]
      [∀ α : Fin (N' + 1 + 1), Algebra.FiniteType Ω (B α)]
      (r_coord : ∀ α : Fin (N' + 1 + 1), Fin (N' + 1 + 1) → B α)
      (θ_away : ∀ α : Fin (N' + 1 + 1),
        HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) →+* B α),
    (∀ α : Fin (N' + 1 + 1),
      Function.Surjective (θ_away α) ∧
      (∀ c : Ω,
        θ_away α (HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X α))
          ⟨MvPolynomial.C c, MvPolynomial.isHomogeneous_C _ c⟩) =
        algebraMap Ω (B α) c) ∧
      (∀ a : Fin (N' + 1 + 1),
        θ_away α (HomogeneousLocalization.Away.mk 𝒜
          (MvPolynomial.isHomogeneous_X Ω α) 1
          (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X Ω a)) =
        r_coord α a) ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α)) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α)
          (MvPolynomial.isHomogeneous_X Ω α) zero_lt_one =
        (hAff α).fromSpec ≫ ι₁.left) →
    (∀ (α : Fin (N' + 1 + 1)) (c : Fin (N' + 1 + 1) → Ω) (x : ↥(U_chart α)),
      ι₁.left.base x.1 ∈ weilProjHyperplaneSet Ω (N' + 1)
        (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ↔
      (∑ a : Fin (N' + 1 + 1), algebraMap Ω (B α) (c a) * r_coord α a) ∈
        ((hAff α).primeIdealOf x).asIdeal) →
    ∀ (b₀ : W.left),
    (∀ p : (weilProjectiveSpaceOver Ω (N' + 1)).left,
      p ≠ ι₁.left.base b₀ →
      ∃ β : Fin (N' + 1),
        p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β.succ)) →
    ∀ (c_F : Fin (N' + 1) → Ω)
      (K₁ K₂ : Set W.left),
    b₀ ∈ K₁ →
    IsClosed K₂ →
    Disjoint K₁ K₂ →
    K₁ ∪ K₂ =
      { w : W.left | ι₁.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1)
        (∑ β : Fin (N' + 1), MvPolynomial.C (c_F β) * MvPolynomial.X β.succ) } →
    ∀ (α₂ : Fin (N' + 1 + 1))
      (𝔮_B : PrimeSpectrum (B α₂)),
    (hAff α₂).fromSpec.base 𝔮_B ∈ K₂ →
    ((d - 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (B α₂ ⧸ 𝔮_B.asIdeal) →
    (∀ (E : Type u) [Field E] [Algebra Ω E]
       (C : Type u) [CommRing C] [IsDomain C] [Algebra Ω C] [Algebra.FiniteType Ω C],
      IsDomain (TensorProduct Ω C E) ∧
      ringKrullDim (TensorProduct Ω C E) = ringKrullDim C) →
    (∀ (E : Type u) [Field E] [IsAlgClosed E]
       (Y : Set (weilProjectiveSpaceOver E (N' + 1)).left), IsClosed Y →
      ∀ (e : ℕ), 1 ≤ e → ((e : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y →
      ∀ (F : MvPolynomial (Fin (N' + 1 + 1)) E),
        F ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) E 1 → F ≠ 0 →
        (Y ∩ weilProjHyperplaneSet E (N' + 1) F).Nonempty ∧
        (((e - 1 : ℕ) : WithBot ℕ∞) ≤
          topologicalKrullDim ↥(Y ∩ weilProjHyperplaneSet E (N' + 1) F))) →
    ∀ (L₀ : Type u) [Field L₀] [Algebra Ω L₀]
      (u_L₀ : Fin (d - 2) → Fin (N' + 1) → L₀),
    (∀ i : Fin (d - 2), u_L₀ i ≠ 0) →
    ∃ (β₂ : Fin (N' + 1))
      (𝔮_L : PrimeSpectrum (TensorProduct Ω (B β₂.succ) L₀)),
      Nontrivial (B β₂.succ) ∧
      (hAff β₂.succ).fromSpec.base
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeLeft :
            B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L₀).toRingHom 𝔮_L) ∈ K₂ ∧
      (∑ γ : Fin (N' + 1),
        (algebraMap Ω (B β₂.succ) (c_F γ) * r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (1 : L₀)) ∈
        𝔮_L.asIdeal ∧
      (∀ i : Fin (d - 2),
        ∑ γ : Fin (N' + 1),
          (r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (u_L₀ i γ) ∈ 𝔮_L.asIdeal) :=
by
  intro 𝒜 _ U_chart B hAff hAlgB hFTB r_coord θ_away hθ hr_vanish
    b₀ hCompl_b₀ c_F K₁ K₂ hb₀_K₁ hCl_K₂ hDisj hUnion
    α₂ 𝔮_B h𝔮_K₂ hDim_𝔮 hTensorDim hBezout L₀ hFieldL₀ hAlgL₀ u_L₀ hu_L₀
  have _ : 1 ≤ N' := hN'
  have _ : AlgebraicGeometry.IsClosedImmersion ι₁.left := hCl₁
  let M : ℕ := N' + 1
  
  let E : Type u := AlgebraicClosure L₀
  let 𝒜_E := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E
  let _ : GradedAlgebra 𝒜_E := MvPolynomial.gradedAlgebra

  
  let cZeroHom : ∀ (R : Type u) [CommRing R],
      R →+* ↥(MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R 0) :=
    fun R _ =>
      { toFun := fun r => ⟨MvPolynomial.C r, MvPolynomial.isHomogeneous_C _ r⟩
        map_one' := Subtype.ext (map_one MvPolynomial.C)
        map_mul' := fun x y => Subtype.ext (map_mul MvPolynomial.C x y)
        map_zero' := Subtype.ext (map_zero MvPolynomial.C)
        map_add' := fun x y => Subtype.ext (map_add MvPolynomial.C x y) }

  let valHom : ∀ {R : Type u} [CommRing R]
      (𝒜_R : ℕ → Submodule R (MvPolynomial (Fin (M + 1)) R)) [GradedAlgebra 𝒜_R]
      (S : Submonoid (MvPolynomial (Fin (M + 1)) R)),
      HomogeneousLocalization 𝒜_R S →+* Localization S :=
    fun {_} [_] _ [_] S =>
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }

  
  have hHomogEvalVal : ∀ (R : Type u) [CommRing R]
      (t_α : MvPolynomial (Fin (M + 1)) R)
      (ht_α : t_α ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R 1),
      let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R
      let _ : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
      let ψ_R : MvPolynomial (Fin (M + 1)) R →+* HomogeneousLocalization.Away 𝒜_R t_α :=
        MvPolynomial.eval₂Hom
          ((HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers t_α)).comp (cZeroHom R))
          (fun a => HomogeneousLocalization.Away.mk 𝒜_R ht_α 1
            (MvPolynomial.X a)
            (show MvPolynomial.X a ∈ 𝒜_R (1 • 1) from MvPolynomial.isHomogeneous_X R a))
      ∀ (n : ℕ) (F : MvPolynomial (Fin (M + 1)) R),
        F ∈ 𝒜_R n →
        (ψ_R F).val =
          Localization.mk F ⟨t_α ^ n, pow_mem (Submonoid.mem_powers t_α) n⟩ := by
    intro R _ t_α ht_α 𝒜_R _ ψ_R n F hF
    have hmk_pow : ∀ (p : MvPolynomial (Fin (M + 1)) R) (k : ℕ),
        (Localization.mk p ⟨t_α ^ 1, pow_mem (Submonoid.mem_powers t_α) 1⟩) ^ k =
          Localization.mk (p ^ k) ⟨t_α ^ k, pow_mem (Submonoid.mem_powers t_α) k⟩ := by
      intro p k
      induction k with
      | zero =>
        simp only [pow_zero]
        exact Localization.mk_one.symm
      | succ k ih =>
        rw [pow_succ, ih, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        exact (pow_add t_α k 1).symm
    have hmk_prod : ∀ (m : Fin (M + 1) →₀ ℕ) (s : Finset (Fin (M + 1))),
        (∏ a ∈ s, Localization.mk ((MvPolynomial.X a : MvPolynomial (Fin (M + 1)) R) ^ (m a))
            ⟨t_α ^ (m a), pow_mem (Submonoid.mem_powers t_α) (m a)⟩) =
          Localization.mk (∏ a ∈ s, (MvPolynomial.X a : MvPolynomial (Fin (M + 1)) R) ^ (m a))
            ⟨t_α ^ (∑ a ∈ s, m a), pow_mem (Submonoid.mem_powers t_α) (∑ a ∈ s, m a)⟩ := by
      intro m s
      induction s using Finset.cons_induction with
      | empty =>
        simp only [Finset.prod_empty, Finset.sum_empty, pow_zero]
        exact Localization.mk_one.symm
      | cons a s has ih =>
        rw [Finset.prod_cons, Finset.prod_cons, Finset.sum_cons, ih, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        exact (pow_add t_α (m a) (∑ b ∈ s, m b)).symm
    have hmk_sum : ∀ (s : Finset (Fin (M + 1) →₀ ℕ))
        (f : (Fin (M + 1) →₀ ℕ) → MvPolynomial (Fin (M + 1)) R)
        (den : Submonoid.powers t_α),
        (∑ m ∈ s, Localization.mk (f m) den) = Localization.mk (∑ m ∈ s, f m) den := by
      intro s f den
      induction s using Finset.cons_induction with
      | empty =>
        simp only [Finset.sum_empty]
        exact (Localization.mk_zero den).symm
      | cons m s hms ih =>
        rw [Finset.sum_cons, Finset.sum_cons, ih, Localization.add_mk_self]
    change valHom 𝒜_R (Submonoid.powers t_α) (ψ_R F) = _
    conv_lhs => rw [MvPolynomial.as_sum F]
    rw [map_sum, map_sum]
    have hterm : ∀ m ∈ F.support,
        valHom 𝒜_R (Submonoid.powers t_α) (ψ_R (MvPolynomial.monomial m (F.coeff m))) =
          Localization.mk (MvPolynomial.monomial m (F.coeff m))
            ⟨t_α ^ n, pow_mem (Submonoid.mem_powers t_α) n⟩ := by
      intro m hm
      have hdeg_m : (∑ a : Fin (M + 1), m a) = n := by
        have h1 : (Finsupp.weight 1) m = n := hF (MvPolynomial.mem_support_iff.mp hm)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        map_mul, map_mul, MvPolynomial.eval₂Hom_C, map_prod, map_prod]
      have hC_val : valHom 𝒜_R (Submonoid.powers t_α)
          (((HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers t_α)).comp (cZeroHom R))
            (F.coeff m)) =
          Localization.mk (MvPolynomial.C (F.coeff m)) ⟨1, one_mem (Submonoid.powers t_α)⟩ :=
        HomogeneousLocalization.val_mk _
      rw [hC_val]
      have hX_pow : (∏ x : Fin (M + 1),
          valHom 𝒜_R (Submonoid.powers t_α)
            (ψ_R ((MvPolynomial.X x : MvPolynomial (Fin (M + 1)) R) ^ (m x)))) =
          Localization.mk
            (∏ x : Fin (M + 1), (MvPolynomial.X x : MvPolynomial (Fin (M + 1)) R) ^ (m x))
            ⟨t_α ^ n, pow_mem (Submonoid.mem_powers t_α) n⟩ := by
        have hcongr : ∀ x : Fin (M + 1),
            valHom 𝒜_R (Submonoid.powers t_α)
              (ψ_R ((MvPolynomial.X x : MvPolynomial (Fin (M + 1)) R) ^ (m x))) =
              Localization.mk ((MvPolynomial.X x : MvPolynomial (Fin (M + 1)) R) ^ (m x))
                ⟨t_α ^ (m x), pow_mem (Submonoid.mem_powers t_α) (m x)⟩ := by
          intro x
          rw [map_pow, map_pow, MvPolynomial.eval₂Hom_X']
          have hx_val : HomogeneousLocalization.val
              (HomogeneousLocalization.Away.mk 𝒜_R ht_α 1 (MvPolynomial.X x)
                (show MvPolynomial.X x ∈ 𝒜_R (1 • 1) from MvPolynomial.isHomogeneous_X R x)) =
              Localization.mk (MvPolynomial.X x)
                ⟨t_α ^ 1, pow_mem (Submonoid.mem_powers t_α) 1⟩ :=
            HomogeneousLocalization.Away.val_mk 𝒜_R 1 ht_α (MvPolynomial.X x) _
          change (HomogeneousLocalization.val
            (HomogeneousLocalization.Away.mk 𝒜_R ht_α 1 (MvPolynomial.X x)
              (show MvPolynomial.X x ∈ 𝒜_R (1 • 1) from MvPolynomial.isHomogeneous_X R x))) ^ (m x) = _
          rw [hx_val, hmk_pow]
        simp_rw [hcongr]
        rw [hmk_prod m Finset.univ]
        congr 1
        apply Subtype.ext
        rw [hdeg_m]
      rw [hX_pow, Localization.mk_mul, ← Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        ← MvPolynomial.monomial_eq]
      congr 1
      apply Subtype.ext
      exact one_mul (t_α ^ n)
    rw [Finset.sum_congr rfl hterm, hmk_sum]
    congr 1
    exact (MvPolynomial.as_sum F).symm

  
  letI hAlgAway : ∀ α : Fin (M + 1), Algebra Ω (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) :=
    fun α =>
      ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X α))).comp
        (cZeroHom Ω)).toAlgebra
  let θ_alg : ∀ α : Fin (M + 1), HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) →ₐ[Ω] B α :=
    fun α =>
      { θ_away α with
        commutes' := fun c => (hθ α).2.1 c }

  
  let f_gr : 𝒜 →+*ᵍ 𝒜_E :=
    { toRingHom := MvPolynomial.map (algebraMap Ω E)
      map_mem := fun {i} p hp => MvPolynomial.IsHomogeneous.map hp (algebraMap Ω E) }
  have hf_irrel : HomogeneousIdeal.irrelevant 𝒜_E ≤
      HomogeneousIdeal.map f_gr (HomogeneousIdeal.irrelevant 𝒜) := by
    rw [HomogeneousIdeal.irrelevant_le]
    intro i hi p hp
    have hp_span : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (M + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hdeg_m : (∑ a : Fin (M + 1), m a) = i := by
        have h1 : (Finsupp.weight 1) m = i := hp (MvPolynomial.mem_support_iff.mp hm)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
      by_contra! hall
      have h0 : (∑ a : Fin (M + 1), m a) = 0 :=
        Finset.sum_eq_zero fun a _ => hall a (Set.mem_univ a)
      omega
    refine Ideal.span_le.mpr ?_ hp_span
    rintro _ ⟨a, _, rfl⟩
    change (MvPolynomial.X a : MvPolynomial (Fin (M + 1)) E) ∈
      Ideal.map f_gr.toRingHom (HomogeneousIdeal.irrelevant 𝒜).toIdeal
    have hXa_mem : (MvPolynomial.X a : MvPolynomial (Fin (M + 1)) Ω) ∈
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal :=
      HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 zero_lt_one (MvPolynomial.isHomogeneous_X Ω a)
    have hmap_Xa : f_gr.toRingHom (MvPolynomial.X a) = MvPolynomial.X a :=
      MvPolynomial.map_X (algebraMap Ω E) a
    rw [← hmap_Xa]
    exact Ideal.mem_map_of_mem f_gr.toRingHom hXa_mem

  let π_proj : (weilProjectiveSpaceOver E M).left ⟶ (weilProjectiveSpaceOver Ω M).left :=
    AlgebraicGeometry.Proj.map f_gr hf_irrel

  have hπ_pre : ∀ α : Fin (M + 1),
      (TopologicalSpace.Opens.map π_proj.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α)) =
        AlgebraicGeometry.Proj.basicOpen 𝒜_E (MvPolynomial.X α) := by
    intro α
    have h1 := AlgebraicGeometry.Proj.map_preimage_basicOpen f_gr hf_irrel (MvPolynomial.X α)
    have h2 : f_gr (MvPolynomial.X α) = MvPolynomial.X α :=
      MvPolynomial.map_X (algebraMap Ω E) α
    rwa [h2] at h1

  have hChartTens : ∀ α : Fin (M + 1),
      ∃ ι_tens : AlgebraicGeometry.Spec
          (CommRingCat.of (TensorProduct Ω (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) E)) ⟶
          (weilProjectiveSpaceOver E M).left,
        AlgebraicGeometry.IsOpenImmersion ι_tens ∧
        Set.range ι_tens.base =
          (AlgebraicGeometry.Proj.basicOpen 𝒜_E (MvPolynomial.X α)).1 ∧
        ι_tens ≫ π_proj =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Algebra.TensorProduct.includeLeft :
                HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) →ₐ[Ω]
                  TensorProduct Ω (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) E).toRingHom) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α)
              (MvPolynomial.isHomogeneous_X Ω α) zero_lt_one ∧
        (∀ (c_E : Fin (M + 1) → E)
           (𝔓 : PrimeSpectrum (TensorProduct Ω (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) E)),
          ι_tens.base 𝔓 ∈ weilProjHyperplaneSet E M
            (∑ a : Fin (M + 1), MvPolynomial.C (c_E a) * MvPolynomial.X a) ↔
          (∑ a : Fin (M + 1),
            (HomogeneousLocalization.Away.mk 𝒜 (MvPolynomial.isHomogeneous_X Ω α) 1
              (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X Ω a)) ⊗ₜ[Ω] (c_E a)) ∈ 𝔓.asIdeal) := by
    intro α
    let A_Ω := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)
    have hXα_Ω : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) Ω) ∈ 𝒜 1 :=
      MvPolynomial.isHomogeneous_X Ω α
    let s_α : MvPolynomial (Fin (M + 1)) E := f_gr (MvPolynomial.X α)
    have hs_α : s_α ∈ 𝒜_E 1 := f_gr.map_mem hXα_Ω
    have hs_eq : s_α = MvPolynomial.X α := MvPolynomial.map_X (algebraMap Ω E) α
    let A_E := HomogeneousLocalization.Away 𝒜_E s_α
    letI : Algebra Ω A_E :=
      ((HomogeneousLocalization.fromZeroRingHom 𝒜_E (Submonoid.powers s_α)).comp
        ((cZeroHom E).comp (algebraMap Ω E))).toAlgebra
    let φ_left : A_Ω →ₐ[Ω] A_E :=
      { HomogeneousLocalization.Away.map f_gr (MvPolynomial.X α) with
        commutes' := fun c => by
          apply HomogeneousLocalization.val_injective
          change HomogeneousLocalization.val
            (HomogeneousLocalization.map f_gr _
              (HomogeneousLocalization.mk ⟨0, cZeroHom Ω c, 1, one_mem _⟩)) =
            HomogeneousLocalization.val
              (HomogeneousLocalization.mk ⟨0, cZeroHom E (algebraMap Ω E c), 1, one_mem _⟩)
          rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
            HomogeneousLocalization.val_mk]
          congr 1
          · exact MvPolynomial.map_C (algebraMap Ω E) c
          · apply Subtype.ext
            exact map_one f_gr.toRingHom }
    let φ_right : E →ₐ[Ω] A_E :=
      { (HomogeneousLocalization.fromZeroRingHom 𝒜_E (Submonoid.powers s_α)).comp (cZeroHom E) with
        commutes' := fun _ => rfl }
    let g₁ : TensorProduct Ω A_Ω E →ₐ[Ω] A_E :=
      Algebra.TensorProduct.lift φ_left φ_right (fun _ _ => Commute.all _ _)
    let u_Ω : Fin (M + 1) → A_Ω :=
      fun a => HomogeneousLocalization.Away.mk 𝒜 hXα_Ω 1
        (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X Ω a)
    have hu_α : u_Ω α = 1 := by
      apply HomogeneousLocalization.val_injective
      have hval_u : (u_Ω α).val =
          Localization.mk (MvPolynomial.X α)
            ⟨(MvPolynomial.X α : MvPolynomial (Fin (M + 1)) Ω) ^ 1,
              pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) 1⟩ :=
        HomogeneousLocalization.Away.val_mk 𝒜 1 hXα_Ω (MvPolynomial.X α) _
      rw [hval_u, HomogeneousLocalization.val_one]
      have hd1 : (⟨(MvPolynomial.X α : MvPolynomial (Fin (M + 1)) Ω) ^ 1,
          pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) 1⟩ :
          Submonoid.powers (MvPolynomial.X α)) =
          ⟨MvPolynomial.X α, Submonoid.mem_powers (MvPolynomial.X α)⟩ := by
        apply Subtype.ext; exact pow_one _
      rw [hd1]
      exact Localization.mk_self ⟨MvPolynomial.X α, Submonoid.mem_powers (MvPolynomial.X α)⟩
    let Φ : MvPolynomial (Fin (M + 1)) E →+* TensorProduct Ω A_Ω E :=
      MvPolynomial.eval₂Hom Algebra.TensorProduct.includeRight.toRingHom
        (fun a => (u_Ω a) ⊗ₜ[Ω] (1 : E))
    have hΦ_s : Φ s_α = 1 := by
      rw [hs_eq, MvPolynomial.eval₂Hom_X', hu_α, Algebra.TensorProduct.one_def]
    have hΦ_pow : ∀ y : Submonoid.powers s_α, Φ y.1 = 1 := by
      rintro ⟨_, ⟨n, rfl⟩⟩
      rw [map_pow, hΦ_s, one_pow]
    have hΦ_unit : ∀ y : Submonoid.powers s_α, IsUnit (Φ y.1) := by
      intro y
      rw [hΦ_pow y]
      exact isUnit_one
    let β_loc : Localization (Submonoid.powers s_α) →+* TensorProduct Ω A_Ω E :=
      IsLocalization.lift hΦ_unit
    have hβ_mk : ∀ (p : MvPolynomial (Fin (M + 1)) E) (y : Submonoid.powers s_α),
        β_loc (Localization.mk p y) = Φ p := by
      intro p y
      rw [Localization.mk_eq_mk', IsLocalization.lift_mk'_spec, hΦ_pow y, one_mul]
    let g₂ : A_E →+* TensorProduct Ω A_Ω E :=
      β_loc.comp (valHom 𝒜_E (Submonoid.powers s_α))
    have hg₁_Φ : ∀ F : MvPolynomial (Fin (M + 1)) E,
        g₁.toRingHom (Φ F) =
          MvPolynomial.eval₂Hom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_E (Submonoid.powers s_α)).comp (cZeroHom E))
            (fun a => HomogeneousLocalization.Away.mk 𝒜_E hs_α 1
              (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X E a)) F := by
      have hext : g₁.toRingHom.comp Φ =
          MvPolynomial.eval₂Hom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_E (Submonoid.powers s_α)).comp (cZeroHom E))
            (fun a => HomogeneousLocalization.Away.mk 𝒜_E hs_α 1
              (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X E a)) := by
        apply MvPolynomial.ringHom_ext
        · intro e
          simp only [RingHom.coe_comp, Function.comp_apply, Φ, MvPolynomial.eval₂Hom_C,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply,
            g₁, Algebra.TensorProduct.lift_tmul, map_one, one_mul, φ_right]
          rfl
        · intro a
          simp only [RingHom.coe_comp, Function.comp_apply, Φ, MvPolynomial.eval₂Hom_X',
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe, g₁, Algebra.TensorProduct.lift_tmul,
            map_one, mul_one]
          apply HomogeneousLocalization.val_injective
          change HomogeneousLocalization.val
              (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X α) (u_Ω a)) =
            HomogeneousLocalization.val
              (HomogeneousLocalization.Away.mk 𝒜_E hs_α 1
                (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X E a))
          dsimp [HomogeneousLocalization.Away.map, HomogeneousLocalization.Away.mk, u_Ω]
          rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
          congr 1
          · exact MvPolynomial.map_X (algebraMap Ω E) a
          · apply Subtype.ext
            exact map_pow f_gr.toRingHom (MvPolynomial.X α) 1
      exact RingHom.congr_fun hext
    have h_left_inv : Function.LeftInverse g₁.toRingHom g₂ := by
      intro z
      obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_E hs_α z
      have hF' : F ∈ 𝒜_E n := by simpa [nsmul_one] using hF
      have hg₂ : g₂ (HomogeneousLocalization.Away.mk 𝒜_E hs_α n F hF) = Φ F := by
        change β_loc (HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜_E hs_α n F hF)) = _
        rw [HomogeneousLocalization.Away.val_mk, hβ_mk]
      rw [hg₂, hg₁_Φ F]
      apply HomogeneousLocalization.val_injective
      rw [hHomogEvalVal E s_α hs_α n F hF', HomogeneousLocalization.Away.val_mk]
    have hg₂_fgr : ∀ F : MvPolynomial (Fin (M + 1)) Ω,
        Φ (f_gr F) =
          (Algebra.TensorProduct.includeLeft : A_Ω →ₐ[Ω] TensorProduct Ω A_Ω E)
            (MvPolynomial.eval₂Hom
              ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X α))).comp
                (cZeroHom Ω))
              (fun a => HomogeneousLocalization.Away.mk 𝒜 hXα_Ω 1
                (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X Ω a)) F) := by
      have hext : Φ.comp f_gr.toRingHom =
          (Algebra.TensorProduct.includeLeft : A_Ω →ₐ[Ω] TensorProduct Ω A_Ω E).toRingHom.comp
            (MvPolynomial.eval₂Hom
              ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X α))).comp
                (cZeroHom Ω))
              (fun a => HomogeneousLocalization.Away.mk 𝒜 hXα_Ω 1
                (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X Ω a))) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.coe_comp, Function.comp_apply, f_gr,
            MvPolynomial.map_C, Φ, MvPolynomial.eval₂Hom_C, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply,
            Algebra.TensorProduct.includeLeft_apply]
          rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul]
          rfl
        · intro a
          simp only [RingHom.coe_comp, Function.comp_apply, f_gr,
            MvPolynomial.map_X, Φ, MvPolynomial.eval₂Hom_X', AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, Algebra.TensorProduct.includeLeft_apply]
          rfl
      exact RingHom.congr_fun hext
    let g₂_alg : A_E →ₐ[Ω] TensorProduct Ω A_Ω E :=
      { g₂ with
        commutes' := fun c => by
          change β_loc (HomogeneousLocalization.val
            (HomogeneousLocalization.mk ⟨0, cZeroHom E (algebraMap Ω E c), 1, one_mem _⟩)) = _
          rw [HomogeneousLocalization.val_mk, hβ_mk]
          change Φ (MvPolynomial.C (algebraMap Ω E c)) = _
          rw [MvPolynomial.eval₂Hom_C]
          exact (Algebra.TensorProduct.includeRight : E →ₐ[Ω] TensorProduct Ω A_Ω E).commutes c }
    have h_right_inv : Function.RightInverse g₁.toRingHom g₂ := by
      have hext_alg : g₂_alg.comp g₁ = AlgHom.id Ω (TensorProduct Ω A_Ω E) := by
        apply Algebra.TensorProduct.ext
        · ext z
          simp only [AlgHom.comp_apply, Algebra.TensorProduct.includeLeft_apply, AlgHom.id_apply,
            g₁, Algebra.TensorProduct.lift_tmul, map_one, mul_one]
          obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hXα_Ω z
          have hF' : F ∈ 𝒜 n := by simpa [nsmul_one] using hF
          change β_loc (HomogeneousLocalization.val
            (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X α)
              (HomogeneousLocalization.Away.mk 𝒜 hXα_Ω n F hF))) = _
          have hval_map : HomogeneousLocalization.val
              (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X α)
                (HomogeneousLocalization.Away.mk 𝒜 hXα_Ω n F hF)) =
              Localization.mk (f_gr F) ⟨s_α ^ n, pow_mem (Submonoid.mem_powers s_α) n⟩ := by
            dsimp [HomogeneousLocalization.Away.map, HomogeneousLocalization.Away.mk]
            rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
            congr 1
            apply Subtype.ext
            exact map_pow f_gr.toRingHom (MvPolynomial.X α) n
          rw [hval_map, hβ_mk, hg₂_fgr F]
          change (Algebra.TensorProduct.includeLeft : A_Ω →ₐ[Ω] TensorProduct Ω A_Ω E) _ =
            (Algebra.TensorProduct.includeLeft : A_Ω →ₐ[Ω] TensorProduct Ω A_Ω E)
              (HomogeneousLocalization.Away.mk 𝒜 hXα_Ω n F hF)
          congr 1
          apply HomogeneousLocalization.val_injective
          rw [hHomogEvalVal Ω (MvPolynomial.X α) hXα_Ω n F hF',
            HomogeneousLocalization.Away.val_mk]
        · ext e
          change g₂_alg (g₁ (1 ⊗ₜ[Ω] e)) = 1 ⊗ₜ[Ω] e
          simp only [g₁, Algebra.TensorProduct.lift_tmul, map_one, one_mul, φ_right]
          change β_loc (HomogeneousLocalization.val
            (HomogeneousLocalization.mk ⟨0, cZeroHom E e, 1, one_mem _⟩)) = _
          rw [HomogeneousLocalization.val_mk, hβ_mk]
          change Φ (MvPolynomial.C e) = 1 ⊗ₜ[Ω] e
          rw [MvPolynomial.eval₂Hom_C]
          rfl
      intro t
      exact AlgHom.congr_fun hext_alg t
    let e_away : A_E ≃+* TensorProduct Ω A_Ω E :=
      { g₂ with
        invFun := g₁.toRingHom
        left_inv := h_left_inv
        right_inv := h_right_inv }
    let iso_comm : CommRingCat.of A_E ≅ CommRingCat.of (TensorProduct Ω A_Ω E) :=
      { hom := CommRingCat.ofHom e_away.toRingHom
        inv := CommRingCat.ofHom e_away.symm.toRingHom
        hom_inv_id := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_id]
          congr 1
          exact RingHom.ext h_left_inv
        inv_hom_id := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_id]
          congr 1
          exact RingHom.ext h_right_inv }
    let map_iso : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω A_Ω E)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of A_E) :=
      { hom := AlgebraicGeometry.Spec.map iso_comm.hom
        inv := AlgebraicGeometry.Spec.map iso_comm.inv
        hom_inv_id := by rw [← AlgebraicGeometry.Spec.map_comp, iso_comm.inv_hom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by rw [← AlgebraicGeometry.Spec.map_comp, iso_comm.hom_inv_id, AlgebraicGeometry.Spec.map_id] }
    let ι_tens : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct Ω A_Ω E)) ⟶
        (weilProjectiveSpaceOver E M).left :=
      map_iso.hom ≫ AlgebraicGeometry.Proj.awayι 𝒜_E s_α hs_α zero_lt_one
    refine ⟨ι_tens, ?_, ?_, ?_, ?_⟩
    · have _ : CategoryTheory.IsIso map_iso.hom := map_iso.isIso_hom
      exact AlgebraicGeometry.IsOpenImmersion.comp map_iso.hom
        (AlgebraicGeometry.Proj.awayι 𝒜_E s_α hs_α zero_lt_one)
    · have hsurj : Function.Surjective map_iso.hom.base := by
        intro y
        refine ⟨map_iso.inv.base y, ?_⟩
        change (map_iso.inv ≫ map_iso.hom).base y = y
        rw [map_iso.inv_hom_id]
        rfl
      have hrng : Set.range ι_tens.base =
          Set.range (AlgebraicGeometry.Proj.awayι 𝒜_E s_α hs_α zero_lt_one).base := by
        change Set.range ((AlgebraicGeometry.Proj.awayι 𝒜_E s_α hs_α zero_lt_one).base ∘
          map_iso.hom.base) = _
        exact hsurj.range_comp _
      rw [hrng]
      have hop := congrArg (fun U => U.1)
        (AlgebraicGeometry.Proj.opensRange_awayι 𝒜_E s_α hs_α zero_lt_one)
      change Set.range (AlgebraicGeometry.Proj.awayι 𝒜_E s_α hs_α zero_lt_one).base =
        (AlgebraicGeometry.Proj.basicOpen 𝒜_E s_α).1 at hop
      rw [hop, hs_eq]
    · change (map_iso.hom ≫ AlgebraicGeometry.Proj.awayι 𝒜_E s_α hs_α zero_lt_one) ≫
          AlgebraicGeometry.Proj.map f_gr hf_irrel = _
      rw [CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one (MvPolynomial.X α) hXα_Ω,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      change CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X α)) ≫
          CommRingCat.ofHom e_away.toRingHom = _
      rw [← CommRingCat.ofHom_comp]
      congr 1
      ext z
      have hg₁_z : g₁.toRingHom (z ⊗ₜ[Ω] (1 : E)) =
          HomogeneousLocalization.Away.map f_gr (MvPolynomial.X α) z := by
        simp [g₁, φ_left]
      change g₂ (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X α) z) = z ⊗ₜ[Ω] (1 : E)
      rw [← hg₁_z]
      exact h_right_inv (z ⊗ₜ[Ω] (1 : E))
    · intro c_E 𝔓
      let F_E : MvPolynomial (Fin (M + 1)) E :=
        ∑ a : Fin (M + 1), MvPolynomial.C (c_E a) * MvPolynomial.X a
      have hFE : F_E ∈ 𝒜_E 1 := by
        dsimp [F_E]
        refine Submodule.sum_mem _ fun a _ => ?_
        have h1 : MvPolynomial.IsHomogeneous (MvPolynomial.C (c_E a) * MvPolynomial.X a) (0 + 1) :=
          (MvPolynomial.isHomogeneous_C _ (c_E a)).mul (MvPolynomial.isHomogeneous_X E a)
        rwa [zero_add] at h1
      have hpre := congrArg (fun U => U.1)
        (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_E hs_α zero_lt_one hFE zero_lt_one)
      change (AlgebraicGeometry.Proj.awayι 𝒜_E s_α hs_α zero_lt_one).base ⁻¹'
          (AlgebraicGeometry.Proj.basicOpen 𝒜_E F_E).1 =
        (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hs_α hFE)).1 at hpre
      let 𝔓_E : PrimeSpectrum A_E := map_iso.hom.base 𝔓
      have hmem_iff1 : ι_tens.base 𝔓 ∈ weilProjHyperplaneSet E M F_E ↔
          𝔓_E ∉ (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hs_α hFE) :
            Set (PrimeSpectrum A_E)) := by
        refine not_iff_not.mpr ?_
        have hpre_pt := Set.ext_iff.mp hpre (map_iso.hom.base 𝔓)
        exact hpre_pt
      have hmem_iff2 :
          𝔓_E ∉ (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hs_α hFE) :
            Set (PrimeSpectrum A_E)) ↔
          HomogeneousLocalization.Away.isLocalizationElem hs_α hFE ∈ 𝔓_E.asIdeal := by
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, not_not]
      have heval_elem : e_away (HomogeneousLocalization.Away.isLocalizationElem hs_α hFE) =
          ∑ a : Fin (M + 1), (u_Ω a) ⊗ₜ[Ω] (c_E a) := by
        change β_loc (HomogeneousLocalization.val
          (HomogeneousLocalization.Away.isLocalizationElem hs_α hFE)) = _
        dsimp [HomogeneousLocalization.Away.isLocalizationElem]
        rw [hβ_mk, pow_one]
        dsimp only [F_E]
        rw [map_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        dsimp only [Φ]
        rw [map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      have hmem_iff3 :
          HomogeneousLocalization.Away.isLocalizationElem hs_α hFE ∈ 𝔓_E.asIdeal ↔
          (∑ a : Fin (M + 1), (u_Ω a) ⊗ₜ[Ω] (c_E a)) ∈ 𝔓.asIdeal := by
        change e_away (HomogeneousLocalization.Away.isLocalizationElem hs_α hFE) ∈ 𝔓.asIdeal ↔ _
        rw [heval_elem]
      exact (hmem_iff1.trans hmem_iff2).trans hmem_iff3

  let ι_tens : ∀ α : Fin (M + 1),
      AlgebraicGeometry.Spec
        (CommRingCat.of (TensorProduct Ω (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) E)) ⟶
        (weilProjectiveSpaceOver E M).left :=
    fun α => Classical.choose (hChartTens α)
  have hι_open : ∀ α : Fin (M + 1), AlgebraicGeometry.IsOpenImmersion (ι_tens α) :=
    fun α => (Classical.choose_spec (hChartTens α)).1
  have hι_range : ∀ α : Fin (M + 1),
      Set.range (ι_tens α).base =
        (AlgebraicGeometry.Proj.basicOpen 𝒜_E (MvPolynomial.X α)).1 :=
    fun α => (Classical.choose_spec (hChartTens α)).2.1
  have hι_sq : ∀ α : Fin (M + 1),
      ι_tens α ≫ π_proj =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeft :
              HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α) →ₐ[Ω]
                TensorProduct Ω (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) E).toRingHom) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α)
            (MvPolynomial.isHomogeneous_X Ω α) zero_lt_one :=
    fun α => (Classical.choose_spec (hChartTens α)).2.2.1
  have hι_hyp : ∀ (α : Fin (M + 1)) (c_E : Fin (M + 1) → E)
      (𝔓 : PrimeSpectrum (TensorProduct Ω (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α)) E)),
      (ι_tens α).base 𝔓 ∈ weilProjHyperplaneSet E M
        (∑ a : Fin (M + 1), MvPolynomial.C (c_E a) * MvPolynomial.X a) ↔
      (∑ a : Fin (M + 1),
        (HomogeneousLocalization.Away.mk 𝒜 (MvPolynomial.isHomogeneous_X Ω α) 1
          (MvPolynomial.X a) (MvPolynomial.isHomogeneous_X Ω a)) ⊗ₜ[Ω] (c_E a)) ∈ 𝔓.asIdeal :=
    fun α => (Classical.choose_spec (hChartTens α)).2.2.2

  
  have hMultiBezout : ∀ (Y₀ : Set (weilProjectiveSpaceOver E M).left), IsClosed Y₀ →
      ∀ (k e : ℕ), k < e → ((e : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y₀ →
      ∀ (H : Fin k → MvPolynomial (Fin (M + 1)) E),
        (∀ i : Fin k, H i ∈ 𝒜_E 1) → (∀ i : Fin k, H i ≠ 0) →
        ∃ p_E : (weilProjectiveSpaceOver E M).left,
          p_E ∈ Y₀ ∧ ∀ i : Fin k, p_E ∈ weilProjHyperplaneSet E M (H i) := by
    intro Y₀ hCl_Y₀ k
    have hCl_hyp_E : ∀ F : MvPolynomial (Fin (M + 1)) E, IsClosed (weilProjHyperplaneSet E M F) :=
      fun F => (AlgebraicGeometry.Proj.basicOpen 𝒜_E F).isOpen.isClosed_compl
    have hInd : ∀ (k : ℕ) (e : ℕ), k < e → ((e : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y₀ →
        ∀ (H : Fin k → MvPolynomial (Fin (M + 1)) E),
          (∀ i : Fin k, H i ∈ 𝒜_E 1) → (∀ i : Fin k, H i ≠ 0) →
          let S_k : Set (weilProjectiveSpaceOver E M).left :=
            Y₀ ∩ ⋂ i : Fin k, weilProjHyperplaneSet E M (H i)
          IsClosed S_k ∧ S_k.Nonempty ∧
            (((e - k : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥S_k) := by
      intro k₀
      induction k₀ with
      | zero =>
        intro e h0e hDim H _ _
        have hS0 : (Y₀ ∩ ⋂ i : Fin 0, weilProjHyperplaneSet E M (H i)) = Y₀ := by
          simp [Set.iInter_of_empty]
        dsimp only
        rw [hS0, Nat.sub_zero]
        obtain ⟨hNe_inter, _⟩ := hBezout E Y₀ hCl_Y₀ e (by omega) hDim
          (MvPolynomial.X 0) (MvPolynomial.isHomogeneous_X E 0) (MvPolynomial.X_ne_zero 0)
        exact ⟨hCl_Y₀, hNe_inter.left, hDim⟩
      | succ k' ih =>
        intro e hk'e hDim H hH_hom hH_ne
        let H_init : Fin k' → MvPolynomial (Fin (M + 1)) E := fun i => H i.castSucc
        let F_last : MvPolynomial (Fin (M + 1)) E := H (Fin.last k')
        obtain ⟨hCl_init, _, hDim_init⟩ :=
          ih e (by omega) hDim H_init
            (fun i => hH_hom i.castSucc) (fun i => hH_ne i.castSucc)
        obtain ⟨hNe_next, hDim_next⟩ :=
          hBezout E (Y₀ ∩ ⋂ i : Fin k', weilProjHyperplaneSet E M (H_init i))
            hCl_init (e - k') (by omega) hDim_init F_last
            (hH_hom (Fin.last k')) (hH_ne (Fin.last k'))
        have hSet_eq :
            (Y₀ ∩ ⋂ i : Fin (k' + 1), weilProjHyperplaneSet E M (H i)) =
            (Y₀ ∩ ⋂ i : Fin k', weilProjHyperplaneSet E M (H_init i)) ∩
              weilProjHyperplaneSet E M F_last := by
          ext p
          simp only [Set.mem_inter_iff, Set.mem_iInter, Fin.forall_fin_succ', H_init, F_last,
            and_assoc]
        dsimp only
        rw [hSet_eq, Nat.sub_add_eq]
        exact ⟨hCl_init.inter (hCl_hyp_E F_last), hNe_next, hDim_next⟩
    intro e hke hDim H hH_hom hH_ne
    obtain ⟨_, ⟨p_E, hp_Y₀, hp_inter⟩, _⟩ := hInd k e hke hDim H hH_hom hH_ne
    exact ⟨p_E, hp_Y₀, fun i => Set.mem_iInter.mp hp_inter i⟩

  
  let w_gen : W.left := (hAff α₂).fromSpec.base 𝔮_B
  let p_gen : (weilProjectiveSpaceOver Ω M).left := ι₁.left.base w_gen
  let Z_Ω : Set (weilProjectiveSpaceOver Ω M).left := closure {p_gen}
  let Y_E : Set (weilProjectiveSpaceOver E M).left := π_proj.base ⁻¹' Z_Ω
  have hCl_YE : IsClosed Y_E := isClosed_closure.preimage π_proj.continuous
  have hZ_sub : Z_Ω ⊆ ι₁.left.base '' K₂ := by
    have hCl_img : IsClosed (ι₁.left.base '' K₂) :=
      ι₁.left.isClosedEmbedding.isClosedMap K₂ hCl_K₂
    exact hCl_img.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr ⟨w_gen, h𝔮_K₂, rfl⟩)

  have hDim_YE : ((d - 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y_E := by
    let A₂ := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α₂)
    let D₀ : Type u := B α₂ ⧸ 𝔮_B.asIdeal
    let π_q : B α₂ →ₐ[Ω] D₀ := Ideal.Quotient.mkₐ Ω 𝔮_B.asIdeal
    have _ : IsDomain D₀ := Ideal.Quotient.isDomain 𝔮_B.asIdeal
    have _ : Algebra.FiniteType Ω D₀ :=
      Algebra.FiniteType.of_surjective π_q Ideal.Quotient.mk_surjective
    let T : Type u := TensorProduct Ω D₀ E
    have hDim_T_ring : ((d - 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim T := by
      rw [(hTensorDim E D₀).2]
      exact hDim_𝔮
    let ψ_D₀ : A₂ →ₐ[Ω] D₀ := π_q.comp (θ_alg α₂)
    have hψ_surj : Function.Surjective ψ_D₀ :=
      Ideal.Quotient.mk_surjective.comp (hθ α₂).1
    let Ψ_D₀ : TensorProduct Ω A₂ E →ₐ[Ω] T :=
      Algebra.TensorProduct.map ψ_D₀ (AlgHom.id Ω E)
    have hΨ_surj : Function.Surjective Ψ_D₀.toRingHom :=
      TensorProduct.map_surjective hψ_surj Function.surjective_id
    let f_T : PrimeSpectrum T → PrimeSpectrum (TensorProduct Ω A₂ E) :=
      PrimeSpectrum.comap Ψ_D₀.toRingHom
    have hf_T_emb : Topology.IsEmbedding f_T :=
      (PrimeSpectrum.isClosedEmbedding_comap_of_surjective T Ψ_D₀.toRingHom hΨ_surj).isEmbedding
    have _ : AlgebraicGeometry.IsOpenImmersion (ι_tens α₂) := hι_open α₂
    let g_emb : PrimeSpectrum T → (weilProjectiveSpaceOver E M).left :=
      (ι_tens α₂).base ∘ f_T
    have hg_emb : Topology.IsEmbedding g_emb :=
      (ι_tens α₂).isOpenEmbedding.isEmbedding.comp hf_T_emb
    have hg_in_YE : ∀ x : PrimeSpectrum T, g_emb x ∈ Y_E := by
      intro x
      let 𝔭' : PrimeSpectrum (B α₂) :=
        PrimeSpectrum.comap π_q.toRingHom
          (PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft : D₀ →ₐ[Ω] T).toRingHom x)
      have hle : 𝔮_B ≤ 𝔭' := by
        intro b hb
        change π_q b ⊗ₜ[Ω] (1 : E) ∈ x.asIdeal
        have hπ0 : π_q b = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb
        rw [hπ0, TensorProduct.zero_tmul]
        exact x.asIdeal.zero_mem
      have hcomap_eq :
          PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft : A₂ →ₐ[Ω] TensorProduct Ω A₂ E).toRingHom (f_T x) =
          PrimeSpectrum.comap (θ_away α₂) 𝔭' := by
        ext a
        rfl
      have hproj_x : π_proj.base (g_emb x) = ((hAff α₂).fromSpec ≫ ι₁.left).base 𝔭' := by
        change ((ι_tens α₂) ≫ π_proj).base (f_T x) = _
        rw [hι_sq α₂]
        change (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α₂)
          (MvPolynomial.isHomogeneous_X Ω α₂) zero_lt_one).base
            (PrimeSpectrum.comap
              (Algebra.TensorProduct.includeLeft : A₂ →ₐ[Ω] TensorProduct Ω A₂ E).toRingHom
              (f_T x)) = _
        rw [hcomap_eq]
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away α₂)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α₂)
            (MvPolynomial.isHomogeneous_X Ω α₂) zero_lt_one).base 𝔭' = _
        rw [(hθ α₂).2.2.2]
        rfl
      change π_proj.base (g_emb x) ∈ closure {p_gen}
      rw [hproj_x]
      have hmem_cl : 𝔭' ∈ closure ({𝔮_B} : Set (PrimeSpectrum (B α₂))) :=
        (PrimeSpectrum.le_iff_mem_closure 𝔮_B 𝔭').mp hle
      have himg_sub :=
        image_closure_subset_closure_image ((hAff α₂).fromSpec ≫ ι₁.left).continuous
          (s := ({𝔮_B} : Set (PrimeSpectrum (B α₂))))
      refine (himg_sub.trans (closure_mono ?_)) ⟨𝔭', hmem_cl, rfl⟩
      rintro _ ⟨_, rfl, rfl⟩
      rfl
    let g_sub : PrimeSpectrum T → ↥Y_E := fun x => ⟨g_emb x, hg_in_YE x⟩
    have hg_sub_emb : Topology.IsEmbedding g_sub :=
      Topology.IsEmbedding.codRestrict hg_emb Y_E hg_in_YE
    have hDim_range : topologicalKrullDim (PrimeSpectrum T) =
        topologicalKrullDim ↥(Set.range g_sub) :=
      hg_sub_emb.toHomeomorph.isHomeomorph.topologicalKrullDim_eq
    calc ((d - 1 : ℕ) : WithBot ℕ∞)
        ≤ ringKrullDim T := hDim_T_ring
      _ = topologicalKrullDim (PrimeSpectrum T) :=
          (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim T).symm
      _ = topologicalKrullDim ↥(Set.range g_sub) := hDim_range
      _ ≤ topologicalKrullDim ↥Y_E := topologicalKrullDim_subspace_le ..

  let H : Fin (d - 2) → MvPolynomial (Fin (M + 1)) E :=
    fun i => ∑ γ : Fin (N' + 1),
      MvPolynomial.C (algebraMap L₀ E (u_L₀ i γ)) * MvPolynomial.X γ.succ
  have hH_hom : ∀ i : Fin (d - 2), H i ∈ 𝒜_E 1 := by
    intro i
    dsimp [H]
    refine Submodule.sum_mem _ fun γ _ => ?_
    have h1 : MvPolynomial.IsHomogeneous
        (MvPolynomial.C (algebraMap L₀ E (u_L₀ i γ)) * MvPolynomial.X γ.succ) (0 + 1) :=
      (MvPolynomial.isHomogeneous_C _ _).mul (MvPolynomial.isHomogeneous_X E γ.succ)
    rwa [zero_add] at h1
  have hH_ne : ∀ i : Fin (d - 2), H i ≠ 0 := by
    intro i h0
    obtain ⟨γ₀, hγ₀⟩ := Function.ne_iff.mp (hu_L₀ i)
    have hc := congrArg (fun P => P.coeff (Finsupp.single γ₀.succ 1)) h0
    simp only [AddMonoidAlgebra.coeff_zero] at hc
    dsimp [H] at hc
    simp_rw [MvPolynomial.C_mul_X_eq_monomial] at hc
    rw [MvPolynomial.coeff_sum] at hc
    have hsum_eq : (∑ γ : Fin (N' + 1),
        (MvPolynomial.monomial (Finsupp.single γ.succ 1)
          (algebraMap L₀ E (u_L₀ i γ))).coeff (Finsupp.single γ₀.succ 1)) =
        algebraMap L₀ E (u_L₀ i γ₀) := by
      rw [Finset.sum_eq_single γ₀]
      · simp only [MvPolynomial.coeff_monomial, ↓reduceIte]
      · intro γ _ hne
        rw [MvPolynomial.coeff_monomial]
        split_ifs with hsingle
        · exfalso
          have hval := congrArg (fun f => f γ.succ) hsingle
          have hne_succ : γ₀.succ ≠ γ.succ := fun h => hne (Fin.succ_injective _ h.symm)
          simp only [Finsupp.single_eq_same, Finsupp.single_eq_of_ne hne_succ.symm] at hval
          exact one_ne_zero hval
        · rfl
      · intro hnot
        exact absurd (Finset.mem_univ γ₀) hnot
    rw [hsum_eq] at hc
    exact hγ₀ ((algebraMap L₀ E).injective (hc.trans (map_zero _).symm))

  obtain ⟨p_E, hp_YE, hp_H⟩ :=
    hMultiBezout Y_E hCl_YE (d - 2) (d - 1) (by omega) hDim_YE H hH_hom hH_ne

  let p_Ω : (weilProjectiveSpaceOver Ω M).left := π_proj.base p_E
  obtain ⟨w_Ω, hw_K₂, hw_eq⟩ : ∃ w_Ω ∈ K₂, ι₁.left.base w_Ω = p_Ω := hZ_sub hp_YE
  have hp_ne_b₀ : p_Ω ≠ ι₁.left.base b₀ := by
    intro heq
    have hw_b₀ : w_Ω = b₀ := ι₁.left.isClosedEmbedding.injective (hw_eq.trans heq)
    rw [hw_b₀] at hw_K₂
    exact Set.disjoint_left.mp hDisj hb₀_K₁ hw_K₂

  obtain ⟨β₂, hp_chart⟩ := hCompl_b₀ p_Ω hp_ne_b₀
  have hw_U : w_Ω ∈ U_chart β₂.succ := by
    change ι₁.left.base w_Ω ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β₂.succ)
    rwa [hw_eq]
  let 𝔭_w : PrimeSpectrum (B β₂.succ) := (hAff β₂.succ).primeIdealOf ⟨w_Ω, hw_U⟩
  have hNt_β₂ : Nontrivial (B β₂.succ) :=
    PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨𝔭_w⟩

  have hpE_range : p_E ∈ Set.range (ι_tens β₂.succ).base := by
    rw [hι_range β₂.succ]
    have hpre_eq := congrArg (fun U => U.1) (hπ_pre β₂.succ)
    change π_proj.base ⁻¹'
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β₂.succ)).1 =
      (AlgebraicGeometry.Proj.basicOpen 𝒜_E (MvPolynomial.X β₂.succ)).1 at hpre_eq
    rw [← hpre_eq]
    exact hp_chart
  obtain ⟨𝔓, h𝔓_eq⟩ := hpE_range

  let A_β := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X β₂.succ)
  have hcomap_β :
      PrimeSpectrum.comap
        (Algebra.TensorProduct.includeLeft : A_β →ₐ[Ω] TensorProduct Ω A_β E).toRingHom 𝔓 =
      PrimeSpectrum.comap (θ_away β₂.succ) 𝔭_w := by
    have hXβ : (MvPolynomial.X β₂.succ : MvPolynomial (Fin (N' + 1 + 1)) Ω) ∈ 𝒜 1 :=
      MvPolynomial.isHomogeneous_X Ω β₂.succ
    apply (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β₂.succ) hXβ zero_lt_one).isOpenEmbedding.injective
    have hlhs : (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β₂.succ) hXβ zero_lt_one).base
          (PrimeSpectrum.comap
            (Algebra.TensorProduct.includeLeft : A_β →ₐ[Ω] TensorProduct Ω A_β E).toRingHom 𝔓) =
        p_Ω := by
      change (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeft : A_β →ₐ[Ω] TensorProduct Ω A_β E).toRingHom) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β₂.succ)
          (MvPolynomial.isHomogeneous_X Ω β₂.succ) zero_lt_one).base 𝔓 = p_Ω
      rw [← hι_sq β₂.succ]
      change π_proj.base ((ι_tens β₂.succ).base 𝔓) = p_Ω
      rw [h𝔓_eq]
    have hrhs : (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β₂.succ) hXβ zero_lt_one).base
        (PrimeSpectrum.comap (θ_away β₂.succ) 𝔭_w) = p_Ω := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_away β₂.succ)) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β₂.succ)
          (MvPolynomial.isHomogeneous_X Ω β₂.succ) zero_lt_one).base 𝔭_w = p_Ω
      rw [(hθ β₂.succ).2.2.2]
      change ι₁.left.base ((hAff β₂.succ).fromSpec.base 𝔭_w) = p_Ω
      rw [(hAff β₂.succ).fromSpec_primeIdealOf ⟨w_Ω, hw_U⟩, hw_eq]
    exact hlhs.trans hrhs.symm

  
  let Ψ_B : TensorProduct Ω A_β E →ₐ[Ω] TensorProduct Ω (B β₂.succ) E :=
    Algebra.TensorProduct.map (θ_alg β₂.succ) (AlgHom.id Ω E)
  have hΨB_surj : Function.Surjective Ψ_B.toRingHom :=
    TensorProduct.map_surjective (hθ β₂.succ).1 Function.surjective_id
  have hker_ΨB : RingHom.ker Ψ_B.toRingHom ≤ 𝔓.asIdeal := by
    have hrker : RingHom.ker Ψ_B =
        Ideal.map (Algebra.TensorProduct.includeLeft : A_β →ₐ[Ω] TensorProduct Ω A_β E)
          (RingHom.ker (θ_alg β₂.succ)) :=
      Algebra.TensorProduct.rTensor_ker (R := Ω) (S := Ω) (θ_alg β₂.succ) (hθ β₂.succ).1
    change RingHom.ker Ψ_B ≤ 𝔓.asIdeal
    rw [hrker, Ideal.map_le_iff_le_comap]
    intro a ha
    have ha_p : a ∈ (PrimeSpectrum.comap (θ_away β₂.succ) 𝔭_w).asIdeal := by
      change θ_away β₂.succ a ∈ 𝔭_w.asIdeal
      have h0 : θ_away β₂.succ a = 0 := ha
      rw [h0]
      exact 𝔭_w.asIdeal.zero_mem
    rw [← hcomap_β] at ha_p
    exact ha_p
  have h𝔓_range : 𝔓 ∈ Set.range (PrimeSpectrum.comap Ψ_B.toRingHom) := by
    rw [range_comap_of_surjective _ Ψ_B.toRingHom hΨB_surj]
    exact hker_ΨB
  obtain ⟨𝔮_E, h𝔮_E⟩ := h𝔓_range

  let ι_LE : TensorProduct Ω (B β₂.succ) L₀ →ₐ[Ω] TensorProduct Ω (B β₂.succ) E :=
    Algebra.TensorProduct.map (AlgHom.id Ω (B β₂.succ)) (IsScalarTower.toAlgHom Ω L₀ E)
  let 𝔮_L : PrimeSpectrum (TensorProduct Ω (B β₂.succ) L₀) :=
    PrimeSpectrum.comap ι_LE.toRingHom 𝔮_E

  have hcomap_𝔮L :
      PrimeSpectrum.comap
        (Algebra.TensorProduct.includeLeft :
          B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L₀).toRingHom 𝔮_L = 𝔭_w := by
    apply PrimeSpectrum.comap_injective_of_surjective (θ_away β₂.succ) (hθ β₂.succ).1
    have h1 : PrimeSpectrum.comap (θ_away β₂.succ)
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeLeft :
            B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L₀).toRingHom 𝔮_L) =
        PrimeSpectrum.comap
          (Algebra.TensorProduct.includeLeft : A_β →ₐ[Ω] TensorProduct Ω A_β E).toRingHom
          (PrimeSpectrum.comap Ψ_B.toRingHom 𝔮_E) := by
      ext a
      rfl
    rw [h1, h𝔮_E, hcomap_β]

  refine ⟨β₂, 𝔮_L, hNt_β₂, ?_, ?_, ?_⟩
  · rw [hcomap_𝔮L, (hAff β₂.succ).fromSpec_primeIdealOf ⟨w_Ω, hw_U⟩]
    exact hw_K₂
  · have hw_union : w_Ω ∈ K₁ ∪ K₂ := Or.inr hw_K₂
    rw [hUnion] at hw_union
    let c_ext : Fin (M + 1) → Ω := Fin.cases 0 c_F
    have hc_poly : (∑ a : Fin (M + 1), MvPolynomial.C (c_ext a) * MvPolynomial.X a) =
        ∑ γ : Fin (N' + 1), MvPolynomial.C (c_F γ) * MvPolynomial.X γ.succ := by
      rw [Fin.sum_univ_succ]
      simp [c_ext]
      rfl
    have hc_B : (∑ a : Fin (M + 1), algebraMap Ω (B β₂.succ) (c_ext a) * r_coord β₂.succ a) =
        ∑ γ : Fin (N' + 1), algebraMap Ω (B β₂.succ) (c_F γ) * r_coord β₂.succ γ.succ := by
      rw [Fin.sum_univ_succ]
      simp [c_ext]
      rfl
    have hv := (hr_vanish β₂.succ c_ext ⟨w_Ω, hw_U⟩).mp (by rwa [hc_poly])
    rw [hc_B] at hv
    have hmem_comap : (∑ γ : Fin (N' + 1),
        algebraMap Ω (B β₂.succ) (c_F γ) * r_coord β₂.succ γ.succ) ∈
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeLeft :
            B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L₀).toRingHom 𝔮_L).asIdeal := by
      rw [hcomap_𝔮L]
      exact hv
    change (∑ γ : Fin (N' + 1),
        algebraMap Ω (B β₂.succ) (c_F γ) * r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (1 : L₀) ∈
      𝔮_L.asIdeal at hmem_comap
    rwa [TensorProduct.sum_tmul] at hmem_comap
  · intro i
    let c_Ei : Fin (M + 1) → E := Fin.cases 0 (fun γ => algebraMap L₀ E (u_L₀ i γ))
    have hH_eq : (∑ a : Fin (M + 1), MvPolynomial.C (c_Ei a) * MvPolynomial.X a) = H i := by
      rw [Fin.sum_univ_succ]
      simp [c_Ei, H]
      rfl
    have hp_Hi : (ι_tens β₂.succ).base 𝔓 ∈
        weilProjHyperplaneSet E M (∑ a : Fin (M + 1), MvPolynomial.C (c_Ei a) * MvPolynomial.X a) := by
      rw [h𝔓_eq, hH_eq]
      exact hp_H i
    have h𝔓_mem := (hι_hyp β₂.succ c_Ei 𝔓).mp hp_Hi
    rw [Fin.sum_univ_succ] at h𝔓_mem
    simp only [c_Ei, Fin.cases_zero, Fin.cases_succ, TensorProduct.tmul_zero, zero_add] at h𝔓_mem
    rw [← h𝔮_E] at h𝔓_mem
    change Ψ_B (∑ γ : Fin (N' + 1),
      (HomogeneousLocalization.Away.mk 𝒜 (MvPolynomial.isHomogeneous_X Ω β₂.succ) 1
        (MvPolynomial.X γ.succ) (MvPolynomial.isHomogeneous_X Ω γ.succ)) ⊗ₜ[Ω]
        algebraMap L₀ E (u_L₀ i γ)) ∈ 𝔮_E.asIdeal at h𝔓_mem
    have hΨ_eq : Ψ_B (∑ γ : Fin (N' + 1),
        (HomogeneousLocalization.Away.mk 𝒜 (MvPolynomial.isHomogeneous_X Ω β₂.succ) 1
          (MvPolynomial.X γ.succ) (MvPolynomial.isHomogeneous_X Ω γ.succ)) ⊗ₜ[Ω]
          algebraMap L₀ E (u_L₀ i γ)) =
        ι_LE (∑ γ : Fin (N' + 1), (r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (u_L₀ i γ)) := by
      simp only [Ψ_B, ι_LE, map_sum, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        IsScalarTower.coe_toAlgHom']
      refine Finset.sum_congr rfl fun γ _ => ?_
      congr 1
      exact (hθ β₂.succ).2.2.1 γ.succ
    rw [hΨ_eq] at h𝔓_mem
    exact h𝔓_mem

theorem weil_algClosed_smooth_proj_charts_specialization_and_codimOne (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (d N' : ℕ) (hd : 2 ≤ d) (hN' : 1 ≤ N')
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hIntW : AlgebraicGeometry.IsIntegral W.left)
    [AlgebraicGeometry.IsProper W.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d W.hom]
    (hDimW : topologicalKrullDim W.left = (d : WithBot ℕ∞))
    (hDimP : topologicalKrullDim (weilProjectiveSpaceOver Ω (N' + 1)).left =
      ((N' + 1 : ℕ) : WithBot ℕ∞))
    (ι₁ : W ⟶ weilProjectiveSpaceOver Ω (N' + 1))
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left) :
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) Ω
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U_chart : Fin (N' + 1 + 1) → W.left.Opens :=
      fun α => (TopologicalSpace.Opens.map ι₁.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α))
    let B : Fin (N' + 1 + 1) → Type u :=
      fun α => ↑(W.left.presheaf.obj (Opposite.op (U_chart α)))
    ∀ (b₀ : W.left)
      (q₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left)
      (c_F : Fin (N' + 1) → Ω),
      c_F ≠ 0 →
      let F₁ : MvPolynomial (Fin (N' + 1 + 1)) Ω :=
        ∑ β : Fin (N' + 1), MvPolynomial.C (c_F β) * MvPolynomial.X β.succ
      ∀ (K₁ K₂ : Set W.left),
      b₀ ∈ K₁ →
      q₀ ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) →
      Set.range q₀.base = {b₀} →
      ι₁.left.base b₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) →
      (∀ β : Fin (N' + 1),
        ι₁.left.base b₀ ∈ weilProjHyperplaneSet Ω (N' + 1) (MvPolynomial.X β.succ)) →
      (∀ p : (weilProjectiveSpaceOver Ω (N' + 1)).left,
        p ≠ ι₁.left.base b₀ →
        ∃ β : Fin (N' + 1),
          p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β.succ)) →
      (∃ w : W.left, ι₁.left.base w ∉ weilProjHyperplaneSet Ω (N' + 1) F₁) →
      IsClosed K₁ →
      IsClosed K₂ →
      K₂.Nonempty →
      Disjoint K₁ K₂ →
      K₁ ∪ K₂ = { w : W.left | ι₁.left.base w ∈ weilProjHyperplaneSet Ω (N' + 1) F₁ } →
      ∃ (hAff : ∀ α : Fin (N' + 1 + 1), AlgebraicGeometry.IsAffineOpen (U_chart α))
        (_ : ∀ α : Fin (N' + 1 + 1), Algebra Ω (B α))
        (_ : ∀ α : Fin (N' + 1 + 1), Algebra.FiniteType Ω (B α))
        (r_coord : ∀ α : Fin (N' + 1 + 1), Fin (N' + 1 + 1) → B α)
        (ev₀ : B 0 →ₐ[Ω] Ω),
          (∀ α : Fin (N' + 1 + 1), r_coord α α = 1) ∧
          (∀ (α : Fin (N' + 1 + 1)) (c : Fin (N' + 1 + 1) → Ω) (x : ↥(U_chart α)),
            ι₁.left.base x.1 ∈ weilProjHyperplaneSet Ω (N' + 1)
              (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ↔
            (∑ a : Fin (N' + 1 + 1), algebraMap Ω (B α) (c a) * r_coord α a) ∈
              ((hAff α).primeIdealOf x).asIdeal) ∧
          (∀ α : Fin (N' + 1 + 1),
            (hAff α).fromSpec ≫ W.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (B α)))) ∧
          (∀ α α' : Fin (N' + 1 + 1),
            U_chart α ⊓ U_chart α' = W.left.basicOpen (r_coord α α')) ∧
          (∀ α α' : Fin (N' + 1 + 1),
            let res_L := (W.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : U_chart α ⊓ U_chart α' ≤ U_chart α)).op).hom
            let res_R := (W.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : U_chart α ⊓ U_chart α' ≤ U_chart α')).op).hom
            (∀ c : Ω, res_R (algebraMap Ω (B α') c) = res_L (algebraMap Ω (B α) c)) ∧
            (∀ a : Fin (N' + 1 + 1),
              res_R (r_coord α' a) * res_L (r_coord α α') = res_L (r_coord α a))) ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom) ≫ (hAff 0).fromSpec = q₀ ∧
            RingHom.ker ev₀.toRingHom =
              Ideal.span (Set.range (fun β : Fin (N' + 1) => r_coord 0 β.succ))) ∧
          (IsDomain (B 0) ∧ ringKrullDim (B 0) = (d : WithBot ℕ∞)) ∧
          (∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
            IsDomain (B β.succ) ∧
            ringKrullDim (B β.succ) = (d : WithBot ℕ∞) ∧
            (∑ γ : Fin (N' + 1), algebraMap Ω (B β.succ) (c_F γ) * r_coord β.succ γ.succ) ≠ 0) ∧
          (∀ (β : Fin (N' + 1)), Nontrivial (B β.succ) →
            ∀ (t₀ : Ω), t₀ ≠ 0 →
            ∀ (P : MvPolynomial (Fin ((d - 2) + 1) × Fin (N' + 1)) Ω), P ≠ 0 →
            ∃ (u_val : Fin ((d - 2) + 1) × Fin (N' + 1) → Ω)
              (ev_w : B β.succ →+* Ω),
              ev_w.comp (algebraMap Ω (B β.succ)) = RingHom.id Ω ∧
              MvPolynomial.eval u_val P ≠ 0 ∧
              (∀ i : Fin (d - 2),
                ∑ γ : Fin (N' + 1), u_val (i.castSucc, γ) * ev_w (r_coord β.succ γ.succ) = 0) ∧
              (∑ γ : Fin (N' + 1), c_F γ * ev_w (r_coord β.succ γ.succ)) +
                t₀ * (∑ γ : Fin (N' + 1),
                  u_val (Fin.last (d - 2), γ) * ev_w (r_coord β.succ γ.succ)) = 0) ∧
          (∀ (L₀ : Type u) [Field L₀] [Algebra Ω L₀]
              (u_L₀ : Fin (d - 2) → Fin (N' + 1) → L₀),
            (∀ i : Fin (d - 2), u_L₀ i ≠ 0) →
            ∃ (β₂ : Fin (N' + 1))
              (𝔮_L : PrimeSpectrum (TensorProduct Ω (B β₂.succ) L₀)),
              Nontrivial (B β₂.succ) ∧
              (hAff β₂.succ).fromSpec.base
                (PrimeSpectrum.comap
                  (Algebra.TensorProduct.includeLeft :
                    B β₂.succ →ₐ[Ω] TensorProduct Ω (B β₂.succ) L₀).toRingHom 𝔮_L) ∈ K₂ ∧
              (∑ γ : Fin (N' + 1),
                (algebraMap Ω (B β₂.succ) (c_F γ) * r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (1 : L₀)) ∈
                𝔮_L.asIdeal ∧
              (∀ i : Fin (d - 2),
                ∑ γ : Fin (N' + 1),
                  (r_coord β₂.succ γ.succ) ⊗ₜ[Ω] (u_L₀ i γ) ∈ 𝔮_L.asIdeal)) :=
by
  intro 𝒜 _ U_chart B b₀ q₀ c_F _hc_F F₁ K₁ K₂
    hb₀_K₁ hq₀_hom hq₀_range hb₀_chart0 hb₀_vanish hCompl_b₀
    hNondeg₁ hCl_K₁ hCl_K₂ hNe_K₂ hDisj hUnion
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let _ : AlgebraicGeometry.IsClosedImmersion ι₁.left := hCl₁
  let _ : AlgebraicGeometry.IsIntegral W.left := hIntW
  obtain ⟨hAff, hAlg, hFT, r_coord, θ_away,
      hr_diag, hθ_away, hr_vanish, hFromSpec, hInter, hScale, hOrigin⟩ :=
    weil_closedImmersion_proj_chart_coords_and_origin_eval Ω N' W ι₁ hCl₁
  let _ : ∀ α : Fin (N' + 1 + 1), Algebra Ω (B α) := hAlg
  let _ : ∀ α : Fin (N' + 1 + 1), Algebra.FiniteType Ω (B α) := hFT
  obtain ⟨ev₀, hev₀⟩ :=
    hOrigin b₀ q₀ hq₀_hom hq₀_range hb₀_chart0 hb₀_vanish
  have hChartDomDim : ∀ α : Fin (N' + 1 + 1), Nontrivial (B α) →
      IsDomain (B α) ∧ ringKrullDim (B α) = (d : WithBot ℕ∞) := by
    intro α hNt
    obtain ⟨p₀⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNt
    have hp₀_mem : (hAff α).fromSpec.base p₀ ∈ (U_chart α : Set W.left) := by
      rw [← (hAff α).range_fromSpec]
      exact Set.mem_range_self p₀
    have _ : Nonempty ↥(U_chart α) := ⟨⟨(hAff α).fromSpec.base p₀, hp₀_mem⟩⟩
    have _ : Nonempty ↥(U_chart α).toScheme := ⟨⟨(hAff α).fromSpec.base p₀, hp₀_mem⟩⟩
    have hDom_α : IsDomain (B α) :=
      AlgebraicGeometry.IsIntegral.component_integral (X := W.left) (U_chart α)
    have hInt_U : AlgebraicGeometry.IsIntegral (U_chart α).toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion (U_chart α).ι
    have hSm0 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d)
        ((U_chart α).ι ≫ W.hom) := inferInstance
    have hSm_U : AlgebraicGeometry.SmoothOfRelativeDimension d ((U_chart α).ι ≫ W.hom) := by
      rwa [Nat.zero_add] at hSm0
    have hDim_U : topologicalKrullDim (U_chart α).toScheme = (d : WithBot ℕ∞) :=
      @weil_smooth_integral_krullDim_over_field Ω _ d
        (CategoryTheory.Over.mk ((U_chart α).ι ≫ W.hom)) hInt_U hSm_U
    have hHomeo : IsHomeomorph (hAff α).isoSpec.hom.base :=
      (TopCat.homeoOfIso
        (AlgebraicGeometry.Scheme.forgetToTop.mapIso (hAff α).isoSpec)).isHomeomorph
    have hDim_eq : topologicalKrullDim (U_chart α).toScheme = ringKrullDim (B α) :=
      hHomeo.topologicalKrullDim_eq.trans
        (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (B α))
    exact ⟨hDom_α, hDim_eq.symm.trans hDim_U⟩
  let c_ext : Fin (N' + 1 + 1) → Ω := Fin.cases 0 c_F
  have hPoly_F₁ :
      (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c_ext a) * MvPolynomial.X a) = F₁ := by
    rw [Fin.sum_univ_succ]
    simp [c_ext, F₁]
  have hSum_B : ∀ α : Fin (N' + 1 + 1),
      (∑ a : Fin (N' + 1 + 1), algebraMap Ω (B α) (c_ext a) * r_coord α a) =
      ∑ γ : Fin (N' + 1), algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ := by
    intro α
    rw [Fin.sum_univ_succ]
    simp [c_ext]
  have hVanishF₁ : ∀ (α : Fin (N' + 1 + 1)) (x : ↥(U_chart α)),
      ι₁.left.base x.1 ∈ weilProjHyperplaneSet Ω (N' + 1) F₁ ↔
      (∑ γ : Fin (N' + 1), algebraMap Ω (B α) (c_F γ) * r_coord α γ.succ) ∈
        ((hAff α).primeIdealOf x).asIdeal := by
    intro α x
    have hv := hr_vanish α c_ext x
    rwa [hPoly_F₁, hSum_B α] at hv
  have hNt₀ : Nontrivial (B 0) := ev₀.toRingHom.domain_nontrivial
  have hDom₀ : IsDomain (B 0) ∧ ringKrullDim (B 0) = (d : WithBot ℕ∞) :=
    hChartDomDim 0 hNt₀
  have hDom : ∀ β : Fin (N' + 1), Nontrivial (B β.succ) →
      IsDomain (B β.succ) ∧
      ringKrullDim (B β.succ) = (d : WithBot ℕ∞) ∧
      (∑ γ : Fin (N' + 1), algebraMap Ω (B β.succ) (c_F γ) * r_coord β.succ γ.succ) ≠ 0 := by
    intro β hNt
    obtain ⟨hDom_β, hDim_β⟩ := hChartDomDim β.succ hNt
    refine ⟨hDom_β, hDim_β, ?_⟩
    intro hZero
    obtain ⟨p₀⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNt
    have hp₀_mem : (hAff β.succ).fromSpec.base p₀ ∈ (U_chart β.succ : Set W.left) := by
      rw [← (hAff β.succ).range_fromSpec]
      exact Set.mem_range_self p₀
    have hU_ne : (U_chart β.succ : Set W.left).Nonempty :=
      ⟨(hAff β.succ).fromSpec.base p₀, hp₀_mem⟩
