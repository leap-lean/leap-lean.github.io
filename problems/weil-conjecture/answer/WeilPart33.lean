      intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq F₀ r x₂ y₁ y₂ h1 h2
      rcases h1 with ⟨hc1, hr1, hAdd1, hLim1, hColim1, hIso1, heq1⟩
      rcases h2 with ⟨hc2, hr2, hAdd2, hLim2, hColim2, hIso2, heq2⟩
      have : hc1 = hc2 := Subsingleton.elim _ _; subst this
      have : hr1 = hr2 := Subsingleton.elim _ _; subst this
      have : hAdd1 = hAdd2 := Subsingleton.elim _ _; subst this
      have : hLim1 = hLim2 := Subsingleton.elim _ _; subst this
      have : hColim1 = hColim2 := Subsingleton.elim _ _; subst this
      have : hIso1 = hIso2 := Subsingleton.elim _ _; subst this
      exact heq1.symm.trans heq2
    let mkPushoutDiag : ∀ {J : Type u} [CategoryTheory.SmallCategory J]
        {R₀ S₀ : CommRingCat.{u}} (G : J ⥤ CommRingCat.{u})
        (α : (CategoryTheory.Functor.const J).obj R₀ ⟶ G) (f₀ : R₀ ⟶ S₀),
        J ⥤ CommRingCat.{u} :=
      fun {J} _ {R₀ S₀} G α f₀ =>
        { obj := fun j => CategoryTheory.Limits.pushout (α.app j) f₀
          map := fun {j₁ j₂} u =>
            CategoryTheory.Limits.pushout.desc
              (G.map u ≫ CategoryTheory.Limits.pushout.inl (α.app j₂) f₀)
              (CategoryTheory.Limits.pushout.inr (α.app j₂) f₀)
              (by
                have hnat : α.app j₂ = α.app j₁ ≫ G.map u := by
                  simpa using α.naturality u
                rw [← CategoryTheory.Category.assoc, ← hnat,
                  CategoryTheory.Limits.pushout.condition])
          map_id := fun j => by
            apply CategoryTheory.Limits.pushout.hom_ext
            · rw [CategoryTheory.Limits.pushout.inl_desc, G.map_id,
                CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
            · rw [CategoryTheory.Limits.pushout.inr_desc, CategoryTheory.Category.comp_id]
          map_comp := fun {j₁ j₂ j₃} u v => by
            apply CategoryTheory.Limits.pushout.hom_ext
            · rw [CategoryTheory.Limits.pushout.inl_desc, G.map_comp,
                CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
                  (CategoryTheory.Limits.pushout.inl _ _),
                CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pushout.inl_desc]
            · rw [CategoryTheory.Limits.pushout.inr_desc,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
                CategoryTheory.Limits.pushout.inr_desc] }
    let mkPushoutCocone : ∀ {J : Type u} [CategoryTheory.SmallCategory J]
        {R₀ S₀ P_inf : CommRingCat.{u}} (G : J ⥤ CommRingCat.{u})
        (α : (CategoryTheory.Functor.const J).obj R₀ ⟶ G)
        (c_G : CategoryTheory.Limits.Cocone G)
        (f_inf : R₀ ⟶ c_G.pt)
        (hf_inf : ∀ j : J, α.app j ≫ c_G.ι.app j = f_inf)
        (f₀ : R₀ ⟶ S₀) (inl_inf : c_G.pt ⟶ P_inf) (inr_inf : S₀ ⟶ P_inf)
        (hP : CategoryTheory.IsPushout f_inf f₀ inl_inf inr_inf),
        CategoryTheory.Limits.Cocone (mkPushoutDiag G α f₀) :=
      fun {J} _ {R₀ S₀ P_inf} G α c_G f_inf hf_inf f₀ inl_inf inr_inf hP =>
        { pt := P_inf
          ι :=
            { app := fun j =>
                CategoryTheory.Limits.pushout.desc
                  (c_G.ι.app j ≫ inl_inf) inr_inf
                  (by rw [← CategoryTheory.Category.assoc, hf_inf j, hP.w])
              naturality := fun {j₁ j₂} u => by
                dsimp only [Functor.const_obj_obj, Functor.const_obj_map]
                rw [CategoryTheory.Category.comp_id]
                apply CategoryTheory.Limits.pushout.hom_ext
                · rw [← CategoryTheory.Category.assoc,
                    CategoryTheory.Limits.pushout.inl_desc,
                    CategoryTheory.Category.assoc,
                    CategoryTheory.Limits.pushout.inl_desc,
                    ← CategoryTheory.Category.assoc, c_G.w u,
                    CategoryTheory.Limits.pushout.inl_desc]
                · rw [← CategoryTheory.Category.assoc,
                    CategoryTheory.Limits.pushout.inr_desc,
                    CategoryTheory.Limits.pushout.inr_desc,
                    CategoryTheory.Limits.pushout.inr_desc] } }
    have hPushoutIsColimit : ∀ {J : Type u} [CategoryTheory.SmallCategory J]
        [CategoryTheory.IsFiltered J]
        {R₀ S₀ P_inf : CommRingCat.{u}} (G : J ⥤ CommRingCat.{u})
        (α : (CategoryTheory.Functor.const J).obj R₀ ⟶ G)
        (c_G : CategoryTheory.Limits.Cocone G)
        (hc_G : CategoryTheory.Limits.IsColimit c_G)
        (f_inf : R₀ ⟶ c_G.pt)
        (hf_inf : ∀ j : J, α.app j ≫ c_G.ι.app j = f_inf)
        (f₀ : R₀ ⟶ S₀) (inl_inf : c_G.pt ⟶ P_inf) (inr_inf : S₀ ⟶ P_inf)
        (hP : CategoryTheory.IsPushout f_inf f₀ inl_inf inr_inf),
        Nonempty (CategoryTheory.Limits.IsColimit
          (mkPushoutCocone G α c_G f_inf hf_inf f₀ inl_inf inr_inf hP)) := by
      intro J _ _ R₀ S₀ P_inf G α c_G hc_G f_inf hf_inf f₀ inl_inf inr_inf hP
      let j₀ : J := CategoryTheory.IsFiltered.nonempty.some
      let P_diag := mkPushoutDiag G α f₀
      let c_P := mkPushoutCocone G α c_G f_inf hf_inf f₀ inl_inf inr_inf hP
      have hinr_const : ∀ (s : CategoryTheory.Limits.Cocone P_diag) (j : J),
          CategoryTheory.Limits.pushout.inr (α.app j) f₀ ≫ s.ι.app j =
            CategoryTheory.Limits.pushout.inr (α.app j₀) f₀ ≫ s.ι.app j₀ := by
        intro s j
        let k := CategoryTheory.IsFiltered.max j j₀
        let u₁ : j ⟶ k := CategoryTheory.IsFiltered.leftToMax j j₀
        let u₂ : j₀ ⟶ k := CategoryTheory.IsFiltered.rightToMax j j₀
        calc
          CategoryTheory.Limits.pushout.inr (α.app j) f₀ ≫ s.ι.app j =
              CategoryTheory.Limits.pushout.inr (α.app j) f₀ ≫
                P_diag.map u₁ ≫ s.ι.app k := by rw [s.w u₁]
          _ = CategoryTheory.Limits.pushout.inr (α.app k) f₀ ≫ s.ι.app k := by
            rw [← CategoryTheory.Category.assoc]
            change (CategoryTheory.Limits.pushout.inr (α.app j) f₀ ≫
              CategoryTheory.Limits.pushout.desc _ _ _) ≫ s.ι.app k = _
            rw [CategoryTheory.Limits.pushout.inr_desc]
          _ = CategoryTheory.Limits.pushout.inr (α.app j₀) f₀ ≫
                P_diag.map u₂ ≫ s.ι.app k := by
            rw [← CategoryTheory.Category.assoc]
            change _ = (CategoryTheory.Limits.pushout.inr (α.app j₀) f₀ ≫
              CategoryTheory.Limits.pushout.desc _ _ _) ≫ s.ι.app k
            rw [CategoryTheory.Limits.pushout.inr_desc]
          _ = CategoryTheory.Limits.pushout.inr (α.app j₀) f₀ ≫ s.ι.app j₀ := by
            rw [s.w u₂]
      let mkSG : CategoryTheory.Limits.Cocone P_diag → CategoryTheory.Limits.Cocone G :=
        fun s =>
          { pt := s.pt
            ι :=
              { app := fun j => CategoryTheory.Limits.pushout.inl (α.app j) f₀ ≫ s.ι.app j
                naturality := fun {j₁ j₂} u => by
                  dsimp only [Functor.const_obj_obj, Functor.const_obj_map]
                  rw [CategoryTheory.Category.comp_id, ← s.w u, ← CategoryTheory.Category.assoc]
                  symm
                  change (CategoryTheory.Limits.pushout.inl (α.app j₁) f₀ ≫
                    CategoryTheory.Limits.pushout.desc _ _ _) ≫ s.ι.app j₂ = _
                  rw [CategoryTheory.Limits.pushout.inl_desc] } }
      refine ⟨{
        desc := fun s =>
          hP.desc (hc_G.desc (mkSG s))
            (CategoryTheory.Limits.pushout.inr (α.app j₀) f₀ ≫ s.ι.app j₀)
            (by
              rw [← hf_inf j₀, CategoryTheory.Category.assoc, hc_G.fac (mkSG s) j₀]
              change α.app j₀ ≫ CategoryTheory.Limits.pushout.inl (α.app j₀) f₀ ≫ s.ι.app j₀ = _
              rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.condition,
                CategoryTheory.Category.assoc])
        fac := fun s j => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [← CategoryTheory.Category.assoc]
            change (CategoryTheory.Limits.pushout.inl (α.app j) f₀ ≫
              CategoryTheory.Limits.pushout.desc _ _ _) ≫ _ = _
            rw [CategoryTheory.Limits.pushout.inl_desc,
              CategoryTheory.Category.assoc, hP.inl_desc, hc_G.fac (mkSG s) j]
          · rw [← CategoryTheory.Category.assoc]
            change (CategoryTheory.Limits.pushout.inr (α.app j) f₀ ≫
              CategoryTheory.Limits.pushout.desc _ _ _) ≫ _ = _
            rw [CategoryTheory.Limits.pushout.inr_desc,
              hP.inr_desc, ← hinr_const s j]
        uniq := fun s m hm => by
          apply hP.hom_ext
          · rw [hP.inl_desc]
            apply hc_G.uniq (mkSG s)
            intro j
            have h1 : c_G.ι.app j ≫ inl_inf =
                CategoryTheory.Limits.pushout.inl (α.app j) f₀ ≫ c_P.ι.app j :=
              (CategoryTheory.Limits.pushout.inl_desc _ _ _).symm
            change (c_G.ι.app j ≫ inl_inf) ≫ m = _
            rw [h1, CategoryTheory.Category.assoc, hm j]
          · rw [hP.inr_desc]
            have h2 : inr_inf =
                CategoryTheory.Limits.pushout.inr (α.app j₀) f₀ ≫ c_P.ι.app j₀ :=
              (CategoryTheory.Limits.pushout.inr_desc _ _ _).symm
            nth_rw 1 [h2]
            rw [CategoryTheory.Category.assoc, hm j₀] }⟩
    let ℐ : Type u := { F : IntermediateField K_sep κ // FiniteDimensional K_sep ↥F }
    let _ : Preorder ℐ := Subtype.preorder _
    let _ : CategoryTheory.SmallCategory ℐ := Preorder.smallCategory ℐ
    let F_bot : ℐ := ⟨⊥, inferInstance⟩
    have : CategoryTheory.IsFilteredOrEmpty ℐ :=
      { cocone_objs := fun F₁ F₂ =>
          let _ : FiniteDimensional K_sep ↥F₁.1 := F₁.2
          let _ : FiniteDimensional K_sep ↥F₂.1 := F₂.2
          ⟨⟨F₁.1 ⊔ F₂.1, IntermediateField.finiteDimensional_sup F₁.1 F₂.1⟩,
            CategoryTheory.homOfLE (le_sup_left : F₁.1 ≤ F₁.1 ⊔ F₂.1),
            CategoryTheory.homOfLE (le_sup_right : F₂.1 ≤ F₁.1 ⊔ F₂.1), trivial⟩
        cocone_maps := fun {F₁ F₂} f g =>
          ⟨F₂, CategoryTheory.CategoryStruct.id F₂, Subsingleton.elim _ _⟩ }
    have : CategoryTheory.IsFiltered ℐ :=
      { toIsFilteredOrEmpty := inferInstance
        nonempty := ⟨F_bot⟩ }
    let F_of : κ → ℐ := fun x =>
      ⟨IntermediateField.adjoin K_sep ({x} : Set κ),
        IntermediateField.adjoin.finiteDimensional
          ((isPurelyInseparable_iff.mp inferInstance x).1)⟩
    have hmem_F_of : ∀ x : κ, x ∈ (F_of x).1 :=
      fun x => IntermediateField.mem_adjoin_simple_self K_sep x
    let D_fld : ℐ ⥤ CommRingCat.{u} :=
      { obj := fun F => CommRingCat.of ↥F.1
        map := fun {F₁ F₂} u =>
          CommRingCat.ofHom (IntermediateField.inclusion (CategoryTheory.leOfHom u)).toRingHom
        map_id := fun _ => CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
        map_comp := fun _ _ => CommRingCat.hom_ext (RingHom.ext fun _ => rfl) }
    let c_κ : CategoryTheory.Limits.Cocone D_fld :=
      { pt := CommRingCat.of κ
        ι :=
          { app := fun F => CommRingCat.ofHom F.1.val.toRingHom
            naturality := fun _ _ _ => CommRingCat.hom_ext (RingHom.ext fun _ => rfl) } }
