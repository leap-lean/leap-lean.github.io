    let g_B : B →+* S_G := α_slice.comp (f_crit.comp e_base.toRingHom)
    have hg_B_et : g_B.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.of_bijective e_base.bijective) hCrit)
        (RingHom.Etale.of_bijective hα_slice_bij)
    let f_target : R_n →+* S_G :=
      (((algebraMap Q_G S_G).comp (Ideal.Quotient.mk I_G)).comp
        (MvPolynomial.map (algebraMap R C)))
    have hg_B_comp : g_B.comp MvPolynomial.C = f_target := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change α_slice (algebraMap Q_slice S_slice (Ideal.Quotient.mk I_slice
          (MvPolynomial.map (algebraMap R C)
            (e_base_alg (MvPolynomial.C (MvPolynomial.C r : MvPolynomial (Fin n) R)))))) =
          algebraMap Q_G S_G (Ideal.Quotient.mk I_G
            (MvPolynomial.map (algebraMap R C) (MvPolynomial.C r)))
        have he_r :
            e_base_alg (MvPolynomial.C (MvPolynomial.C r : MvPolynomial (Fin n) R)) =
