      let x_ext : CategoryTheory.Abelian.Ext.{u} _ ℱ b := x
      change ℓ • x_ext = 0
      let φ_x := x_ext.precomp ℱ (Nat.add_zero b)
      have hx_id :
          φ_x (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id ℱ)) = x_ext :=
        CategoryTheory.Abelian.Ext.comp_mk₀_id x_ext
