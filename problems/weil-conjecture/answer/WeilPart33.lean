        have hzero : ∀ z : ↥(SC'.X₁.obj.obj (Opposite.op T_Ω)), z = 0 := by
          intro z
          apply hInj_f
          rw [map_zero]
          apply hInj_g
          rw [map_zero]
          exact congrArg (fun (η : SC'.X₁ ⟶ SC'.X₃) => η.hom.app (Opposite.op T_Ω) z) SC'.zero
        exact (hzero z₁).trans (hzero z₂).symm
      rw [← hSC'_X₁]
      exact hZeroOfSub SC'.X₁ hSub_X₁
    · intro V _ C_bad hNe_bad ⟨e_iso⟩
      have hCompl_ne : ((C_bad : Set ↥V.left)ᶜ).Nonempty :=
        Set.nonempty_compl.mpr hNe_bad
      obtain ⟨x₀, hx₀_not_mem⟩ := hCompl_ne
      let Ω₀ : Type u := AlgebraicClosure ↥(V.left.residueField x₀)
      let S_Ω₀ := AlgebraicGeometry.Spec (CommRingCat.of Ω₀)
      let x : S_Ω₀ ⟶ V.left :=
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥(V.left.residueField x₀) Ω₀)) ≫
          V.left.fromSpecResidueField x₀
      let Z_bad := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_bad).subscheme
      let iC_bad := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_bad).subschemeι
      have hRange_bad : Set.range ⇑iC_bad.base = (C_bad : Set ↥V.left) := by
        dsimp [iC_bad]
        rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
          AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      have hProp_bad : AlgebraicGeometry.IsProper iC_bad := inferInstance
      let X'_bad := CategoryTheory.Limits.pullback iC_bad x
      let g'_bad : X'_bad ⟶ Z_bad := CategoryTheory.Limits.pullback.fst iC_bad x
      let f'_bad : X'_bad ⟶ S_Ω₀ := CategoryTheory.Limits.pullback.snd iC_bad x
      have hEmpty_X' : IsEmpty ↥X'_bad := by
        refine ⟨fun q_pt => ?_⟩
        have hcond : (g'_bad ≫ iC_bad).base q_pt = (f'_bad ≫ x).base q_pt :=
          congrArg (fun (h : X'_bad ⟶ V.left) => h.base q_pt) CategoryTheory.Limits.pullback.condition
        have hx_in_x0 : x.base (f'_bad.base q_pt) ∈
            Set.range ⇑(V.left.fromSpecResidueField x₀).base := ⟨_, rfl⟩
        rw [AlgebraicGeometry.Scheme.range_fromSpecResidueField x₀,
          Set.mem_singleton_iff] at hx_in_x0
        have hx0_in_bad : x₀ ∈ Set.range ⇑iC_bad.base := by
          refine ⟨g'_bad.base q_pt, ?_⟩
          calc
            iC_bad.base (g'_bad.base q_pt) = (g'_bad ≫ iC_bad).base q_pt := rfl
            _ = (f'_bad ≫ x).base q_pt := hcond
            _ = x.base (f'_bad.base q_pt) := rfl
            _ = x₀ := hx_in_x0
        rw [hRange_bad] at hx0_in_bad
        exact hx₀_not_mem hx0_in_bad
      have hZero_Gbad : CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage f'_bad 0 (weilEtaleTorsionSheaf X'_bad ℓ)) :=
        hEmptyZero X'_bad S_Ω₀ f'_bad hEmpty_X'
      let Z_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (iC_bad ≫ V.hom)
      let S'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (x ≫ V.hom)
      let X'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (f'_bad ≫ S'_ov.hom)
      let f_ov : Z_ov ⟶ V := CategoryTheory.Over.homMk iC_bad rfl
      let g_ov : S'_ov ⟶ V := CategoryTheory.Over.homMk x rfl
      let f'_ov : X'_ov ⟶ S'_ov := CategoryTheory.Over.homMk f'_bad rfl
      let g'_ov : X'_ov ⟶ Z_ov := CategoryTheory.Over.homMk g'_bad (by
        dsimp [X'_ov, S'_ov, Z_ov]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc])
      let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      have hPull_R0 : WeilIsEtaleSheafPullback x
          (weilEtaleHigherDirectImage iC_bad 0 (weilEtaleTorsionSheaf Z_bad ℓ))
          (weilEtaleHigherDirectImage f'_bad 0 (weilEtaleTorsionSheaf X'_bad ℓ)) :=
        hPBC Z_ov V S'_ov X'_ov f_ov g_ov f'_ov g'_ov hProp_bad
          (CategoryTheory.IsPullback.of_hasPullback iC_bad x)
          (weilEtaleTorsionSheaf Z_bad ℓ) (weilEtaleTorsionSheaf X'_bad ℓ)
          (hTorConst Z_bad) (hPullConst g'_bad A_ℓ) 0
      have hPull_Fl_zero : WeilIsEtaleSheafPullback x (weilEtaleTorsionSheaf V.left ℓ)
          (weilEtaleHigherDirectImage f'_bad 0 (weilEtaleTorsionSheaf X'_bad ℓ)) :=
        hPullIso x _ _ _ _ hPull_R0 ⟨e_iso.symm⟩ ⟨CategoryTheory.Iso.refl _⟩
      have hPull_Fl_std : WeilIsEtaleSheafPullback x (weilEtaleTorsionSheaf V.left ℓ)
          (weilEtaleTorsionSheaf S_Ω₀ ℓ) :=
        hPullConst x A_ℓ
      obtain ⟨_, _, ⟨e₁⟩⟩ := hPull_Fl_zero
      obtain ⟨_, _, ⟨e₂⟩⟩ := hPull_Fl_std
      have hZero_Fl : CategoryTheory.Limits.IsZero (weilEtaleTorsionSheaf S_Ω₀ ℓ) :=
        CategoryTheory.Limits.IsZero.of_iso hZero_Gbad (e₁.symm ≪≫ e₂).symm
      exact (hSpecΩPkg Ω₀).2.2.2.2 hZero_Fl

  obtain ⟨hFinAcyclic, hIsoW'_zero, hNonIso_bad⟩ := hZeroDimPkg

  
  
  
  have hCruxAffineCurveVanish :
      ∀ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (hIntC : AlgebraicGeometry.IsIntegral C_bar.left)
        (hProjC : IsProjectiveOverField k C_bar)
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom]
        (hDimC : topologicalKrullDim C_bar.left = ((1 : ℕ) : WithBot ℕ∞))
        (W_aff : C_bar.left.Opens)
        (hAffW : AlgebraicGeometry.IsAffineOpen W_aff)
        (hNeW : Nonempty ↥W_aff),
        Subsingleton (weilEtaleTorsionH W_aff.toScheme ℓ q) := by
    intro C_bar hIntC hProjC _ hDimC W_aff hAffW hNeW
    have hPrime : Nat.Prime ℓ := Fact.out
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have : AlgebraicGeometry.IsIntegral C_bar.left := hIntC
    have : IrreducibleSpace ↥C_bar.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral C_bar.left

    let W : AlgebraicGeometry.Scheme.{u} := W_aff.toScheme
    let j : W ⟶ C_bar.left := W_aff.ι
    let W_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (j ≫ C_bar.hom)
    have : AlgebraicGeometry.IsAffine W := hAffW
    have : CompactSpace ↥W := inferInstance
    have : W.IsSeparated := inferInstance
    have : Nonempty ↥W := hNeW
    have hIntW : AlgebraicGeometry.IsIntegral W :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion j
    have : AlgebraicGeometry.IsIntegral W := hIntW
    have : AlgebraicGeometry.IsIntegral W_ov.left := hIntW
    have : CompactSpace ↥W_ov.left := ‹CompactSpace ↥W›
    have : W_ov.left.IsSeparated := ‹W.IsSeparated›
    have : IrreducibleSpace ↥W := AlgebraicGeometry.irreducibleSpace_of_isIntegral W
    have hSmW : AlgebraicGeometry.SmoothOfRelativeDimension 1 W_ov.hom := by
      have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (j ≫ C_bar.hom) :=
        inferInstance
      change AlgebraicGeometry.SmoothOfRelativeDimension 1 (j ≫ C_bar.hom)
      simpa using h01
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 W_ov.hom := hSmW
    have hDimW : topologicalKrullDim W = ((1 : ℕ) : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field k 1 W_ov hIntW

    obtain ⟨_, Z_inf, ι_Z, hCl_Z, hFin_Z, _, hSurj_Z, hCompl_Z⟩ :=
      weil_algClosed_smooth_proj_curve_affine_compl_etale_surj k C_bar
        hIntC hProjC hDimC W_aff hAffW hNeW
    have : AlgebraicGeometry.IsClosedImmersion ι_Z := hCl_Z
    have : AlgebraicGeometry.IsFinite (ι_Z ≫ C_bar.hom) := hFin_Z
    have : AlgebraicGeometry.Surjective (ι_Z ≫ C_bar.hom) := hSurj_Z
    have : AlgebraicGeometry.IsAffineHom (ι_Z ≫ C_bar.hom) := inferInstance
    have : AlgebraicGeometry.IsAffine Z_inf :=
      AlgebraicGeometry.isAffine_of_isAffineHom (ι_Z ≫ C_bar.hom)
    let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      Classical.choice ((PrimeSpectrum.nonempty_iff_nontrivial (R := k)).mpr inferInstance)
    obtain ⟨z₀_inf, -⟩ := (ι_Z ≫ C_bar.hom).surjective pt_k
    let e_Z := Z_inf.isoSpec
    let R_Z : Type u := ↑(Z_inf.presheaf.obj (Opposite.op ⊤))
    have : Nontrivial R_Z :=
      (PrimeSpectrum.nonempty_iff_nontrivial (R := R_Z)).mp ⟨e_Z.hom.base z₀_inf⟩
    obtain ⟨m_Z, hm_Z⟩ := Ideal.exists_maximal R_Z
    let q_Z : PrimeSpectrum R_Z := ⟨m_Z, hm_Z.isPrime⟩
    have hq_cl : IsClosed ({q_Z} : Set ↥(AlgebraicGeometry.Spec (Z_inf.presheaf.obj (Opposite.op ⊤)))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_Z).mpr hm_Z
    let z_inf : ↥Z_inf := e_Z.inv.base q_Z
    have hz_cl : IsClosed ({z_inf} : Set ↥Z_inf) := by
      have heq : ({z_inf} : Set ↥Z_inf) = e_Z.inv.base '' {q_Z} := Set.image_singleton.symm
      rw [heq]
      exact (AlgebraicGeometry.Scheme.homeoOfIso e_Z.symm).isClosedMap _ hq_cl
    let P_inf : ↥C_bar.left := ι_Z.base z_inf
    have hCl_Pinf : IsClosed ({P_inf} : Set ↥C_bar.left) := by
      have heq : ({P_inf} : Set ↥C_bar.left) = ι_Z.base '' {z_inf} := Set.image_singleton.symm
      rw [heq]
      exact ι_Z.isClosedEmbedding.isClosedMap _ hz_cl
    have hNotMem_Pinf : P_inf ∉ W_aff := by
      change P_inf ∉ (W_aff : Set ↥C_bar.left)
      rw [← hCompl_Z]
      exact fun h => h ⟨z_inf, rfl⟩

    let η_W : ↥W := genericPoint ↥W
    let η_C : ↥C_bar.left := genericPoint ↥C_bar.left
    have hGen_jη : IsGenericPoint (j.base η_W) (Set.univ : Set ↥C_bar.left) := by
      rw [IsGenericPoint, Set.eq_univ_iff_forall]
      intro c
      rw [mem_closure_iff]
      intro V hV hcV
      obtain ⟨w₀⟩ := hNeW
      obtain ⟨u, -, huW, huV⟩ := (IrreducibleSpace.isIrreducible_univ ↥C_bar.left).2
        (W_aff : Set ↥C_bar.left) V W_aff.isOpen hV
        ⟨w₀.1, trivial, w₀.2⟩ ⟨c, trivial, hcV⟩
      have hu_cl : (⟨u, huW⟩ : ↥W) ∈ closure ({η_W} : Set ↥W) := by
        rw [genericPoint_spec ↥W]
        trivial
      obtain ⟨w_v, hvV, hvη⟩ := mem_closure_iff.mp hu_cl (j.base ⁻¹' V)
        (hV.preimage j.continuous) huV
      have hv_eq : (w_v : ↥W) = η_W := hvη
      exact ⟨j.base η_W, hv_eq ▸ hvV, rfl⟩
    have hη_eq : j.base η_W = η_C := hGen_jη.eq (genericPoint_spec ↥C_bar.left)

    let Pt_W := { x : ↥W // IsClosed ({x} : Set ↥W) }
    let Pt_bar := { y : ↥C_bar.left // IsClosed ({y} : Set ↥C_bar.left) }
    have hClosedImg : ∀ x : Pt_W, IsClosed ({j.base x.1} : Set ↥C_bar.left) := by
      intro ⟨x, hx_cl⟩
      have hx_ne_η : x ≠ η_W := by
        intro h_eq
        have huniv : ({x} : Set ↥W) = Set.univ := by
          calc ({x} : Set ↥W)
              = closure ({x} : Set ↥W) := hx_cl.closure_eq.symm
            _ = closure ({η_W} : Set ↥W) := by rw [h_eq]
            _ = Set.univ := genericPoint_spec ↥W
        have hSubW : ∀ w : ↥W, w = x := fun w =>
          Set.mem_singleton_iff.mp (huniv.symm ▸ Set.mem_univ w)
        have hSubIC : ∀ K₁ K₂ : TopologicalSpace.IrreducibleCloseds ↥W, K₁ = K₂ := by
          have hK_univ : ∀ K : TopologicalSpace.IrreducibleCloseds ↥W, K.carrier = Set.univ := by
            intro K
            obtain ⟨w, hw⟩ := K.isIrreducible.nonempty
            rw [hSubW w] at hw
            exact Set.eq_univ_of_forall fun z => hSubW z ▸ hw
          intro K₁ K₂
          ext z
          change z ∈ K₁.carrier ↔ z ∈ K₂.carrier
          rw [hK_univ K₁, hK_univ K₂]
        have hDim_lt : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥W) <
            ((1 : ℕ) : WithBot ℕ∞) := by
          rw [Order.krullDim_lt_coe_iff]
          intro l
          by_contra hge
          have hlt01 : l ⟨0, by omega⟩ < l ⟨1, by omega⟩ := l.step ⟨0, by omega⟩
          exact (ne_of_lt hlt01) (hSubIC _ _)
        change topologicalKrullDim W < ((1 : ℕ) : WithBot ℕ∞) at hDim_lt
        rw [hDimW] at hDim_lt
        exact lt_irrefl _ hDim_lt
      let y : ↥C_bar.left := j.base x
      have hy_ne_η : y ≠ η_C := by
        intro hy
        exact hx_ne_η (j.isOpenEmbedding.injective (hy.trans hη_eq.symm))
      have hcl_y_ne_univ : closure ({y} : Set ↥C_bar.left) ≠ Set.univ := by
        intro huniv
        have hgen : IsGenericPoint y (Set.univ : Set ↥C_bar.left) := huniv
        exact hy_ne_η (hgen.eq (genericPoint_spec ↥C_bar.left))
      by_contra hnot_cl
      have hnot_sub : ¬ (closure ({y} : Set ↥C_bar.left) ⊆ {y}) := by
        intro hsub
        have heq : closure ({y} : Set ↥C_bar.left) = {y} :=
          Set.Subset.antisymm hsub subset_closure
        exact hnot_cl (heq ▸ isClosed_closure)
      obtain ⟨z, hz_mem, hz_ne⟩ := Set.not_subset.mp hnot_sub
      rw [Set.mem_singleton_iff] at hz_ne
      have hcl_zy_sub : closure ({z} : Set ↥C_bar.left) ⊆ closure ({y} : Set ↥C_bar.left) :=
        closure_minimal (Set.singleton_subset_iff.mpr hz_mem) isClosed_closure
      have hcl_zy_ne : closure ({z} : Set ↥C_bar.left) ≠ closure ({y} : Set ↥C_bar.left) := by
        intro heq
        exact hz_ne ((inseparable_iff_closure_eq.mpr heq).eq)
      let K₀ : TopologicalSpace.IrreducibleCloseds ↥C_bar.left :=
        ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
      let K₁ : TopologicalSpace.IrreducibleCloseds ↥C_bar.left :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      let K₂ : TopologicalSpace.IrreducibleCloseds ↥C_bar.left :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥C_bar.left, isClosed_univ⟩
      have hK01 : K₀ < K₁ := lt_of_le_of_ne hcl_zy_sub
        (fun h => hcl_zy_ne (congrArg TopologicalSpace.IrreducibleCloseds.carrier h))
      have hK12 : K₁ < K₂ := lt_of_le_of_ne (Set.subset_univ _)
        (fun h => hcl_y_ne_univ (congrArg TopologicalSpace.IrreducibleCloseds.carrier h))
      let l₂ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C_bar.left) :=
        { length := 2
          toFun := ![K₀, K₁, K₂]
          step := Fin.forall_fin_two.mpr ⟨hK01, hK12⟩ }
      have hDimC_lt : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥C_bar.left) <
          ((2 : ℕ) : WithBot ℕ∞) := by
        change topologicalKrullDim C_bar.left < ((2 : ℕ) : WithBot ℕ∞)
        rw [hDimC]
        exact WithBot.coe_lt_coe.mpr (ENat.natCast_lt_natCast.mpr (by omega))
      have hlen := (Order.krullDim_lt_coe_iff.mp hDimC_lt) l₂
      have hlen_eq : l₂.length = 2 := rfl
      omega

    let emb_Pt : Pt_W → Pt_bar := fun x => ⟨j.base x.1, hClosedImg x⟩
    have hemb_inj : Function.Injective emb_Pt := by
      intro x₁ x₂ h
      exact Subtype.ext (j.isOpenEmbedding.injective (congrArg (fun p : Pt_bar => p.1) h))

    let r_Div : (Pt_bar →₀ ℤ) →+ (Pt_W →₀ ℤ) := Finsupp.comapDomain.addMonoidHom hemb_inj
    have hr_Div_apply : ∀ (D : Pt_bar →₀ ℤ) (x : Pt_W), r_Div D x = D (emb_Pt x) := by
      intro D x
      dsimp [r_Div]
      rw [Finsupp.comapDomain.addMonoidHom_apply, Finsupp.comapDomain_apply]
    have hr_Div_surj : Function.Surjective r_Div := by
      intro E
      refine ⟨Finsupp.mapDomain emb_Pt E, ?_⟩
      refine Finsupp.induction E ?_ ?_
      · simp
      · intro a m f _ _ ih
        rw [Finsupp.mapDomain_add, map_add, ih, Finsupp.mapDomain_single]
        congr 1
        ext x
        simp only [hr_Div_apply, Finsupp.single_apply, hemb_inj.eq_iff]

    let P_inf_pt : Pt_bar := ⟨P_inf, hCl_Pinf⟩
    have hr_Div_Pinf : r_Div (Finsupp.single P_inf_pt 1) = 0 := by
      ext x
      rw [hr_Div_apply, Finsupp.zero_apply, Finsupp.single_eq_of_ne]
      intro h_eq
      have hx_in : P_inf ∈ W_aff := by
        have hval : x.1.1 = P_inf := congrArg Subtype.val h_eq
        rw [← hval]
        exact x.1.2
      exact hNotMem_Pinf hx_in

    have hRingMaxMap : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
        [IsLocalRing R₁] [IsLocalRing R₂] (e : R₁ ≃+* R₂),
        Ideal.map e.toRingHom (IsLocalRing.maximalIdeal R₁) = IsLocalRing.maximalIdeal R₂ := by
      intro R₁ R₂ _ _ _ _ e
      ext y
      rw [Ideal.mem_map_iff_of_surjective e.toRingHom e.surjective]
      constructor
      · rintro ⟨r, hr, rfl⟩
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hr ⊢
        intro hu
        exact hr (by simpa [e.symm_apply_apply] using e.symm.toRingHom.isUnit_map hu)
      · intro hy
        refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hy ⊢
        intro hu
        exact hy (by simpa [e.apply_symm_apply] using e.toRingHom.isUnit_map hu)

    let e_η₀ : C_bar.left.presheaf.stalk (j.base η_W) ≅ C_bar.left.presheaf.stalk η_C :=
      C_bar.left.presheaf.stalkCongr (Inseparable.of_eq hη_eq)
    let iso_K : C_bar.left.functionField ≅ W.functionField :=
      e_η₀.symm ≪≫ CategoryTheory.asIso (j.stalkMap η_W)
    let φ_K : ↑C_bar.left.functionField ≃+* ↑W.functionField :=
      iso_K.commRingCatIsoToRingEquiv

    have hStalkAlgComm : ∀ (x : Pt_W) (r : ↑(C_bar.left.presheaf.stalk (emb_Pt x).1)),
        φ_K (algebraMap ↑(C_bar.left.presheaf.stalk (emb_Pt x).1) ↑C_bar.left.functionField r) =
          algebraMap ↑(W.presheaf.stalk x.1) ↑W.functionField
            ((CategoryTheory.asIso (j.stalkMap x.1)).commRingCatIsoToRingEquiv r) := by
      intro x r
      have hspec_W : η_W ⤳ x.1 := genericPoint_specializes x.1
      have hspec_j : j.base η_W ⤳ j.base x.1 := hspec_W.map j.continuous
      have hspec_C : η_C ⤳ j.base x.1 := genericPoint_specializes (j.base x.1)
      have h1 : C_bar.left.presheaf.stalkSpecializes hspec_C ≫ e_η₀.inv =
          C_bar.left.presheaf.stalkSpecializes hspec_j := by
        change C_bar.left.presheaf.stalkSpecializes hspec_C ≫
            C_bar.left.presheaf.stalkSpecializes (specializes_of_eq hη_eq) = _
        exact TopCat.Presheaf.stalkSpecializes_comp C_bar.left.presheaf
          (specializes_of_eq hη_eq) hspec_C
      have h2 : C_bar.left.presheaf.stalkSpecializes hspec_j ≫ j.stalkMap η_W =
          j.stalkMap x.1 ≫ W.presheaf.stalkSpecializes hspec_W :=
        j.stalkSpecializes_stalkMap η_W x.1 hspec_W
      have h3 : C_bar.left.presheaf.stalkSpecializes hspec_C ≫ iso_K.hom =
          j.stalkMap x.1 ≫ W.presheaf.stalkSpecializes hspec_W := by
        dsimp [iso_K]
        rw [← CategoryTheory.Category.assoc, h1]
        exact h2
      exact congrArg (fun m => m.hom r) h3

    have hr_Div_prin : ∀ D ∈ weilCurvePrincipalSubgroup C_bar.left,
        r_Div D ∈ weilCurvePrincipalSubgroup W := by
      intro D hD
      refine AddSubgroup.closure_induction ?_ ?_ ?_ ?_ hD
      · intro D₀ ⟨f, hf⟩
        refine AddSubgroup.subset_closure ⟨Units.map φ_K.toRingHom.toMonoidHom f, ?_⟩
        intro x
        obtain ⟨a, b, na, nb, ha0, hb0, hab, hspan_a, hspan_b, hDx⟩ := hf (emb_Pt x)
        let e_x : ↑(C_bar.left.presheaf.stalk (emb_Pt x).1) ≃+* ↑(W.presheaf.stalk x.1) :=
          (CategoryTheory.asIso (j.stalkMap x.1)).commRingCatIsoToRingEquiv
        refine ⟨e_x a, e_x b, na, nb,
          fun h => ha0 (e_x.injective (h.trans (map_zero e_x).symm)),
          fun h => hb0 (e_x.injective (h.trans (map_zero e_x).symm)),
          ?_, ?_, ?_, ?_⟩
        · have h_ap := congrArg φ_K hab
          rw [hStalkAlgComm x a, map_mul, hStalkAlgComm x b] at h_ap
          exact h_ap
        · have hmap := congrArg (Ideal.map e_x.toRingHom) hspan_a
          rw [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hRingMaxMap e_x] at hmap
          exact hmap
        · have hmap := congrArg (Ideal.map e_x.toRingHom) hspan_b
          rw [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hRingMaxMap e_x] at hmap
          exact hmap
        · rw [hr_Div_apply, hDx]
      · rw [map_zero]
        exact ZeroMemClass.zero_mem _
      · intro D₁ D₂ _ _ ih₁ ih₂
        rw [map_add]
        exact AddSubgroup.add_mem _ ih₁ ih₂
      · intro D₁ _ ih₁
        rw [map_neg]
        exact AddSubgroup.neg_mem _ ih₁

    let res_Cl : weilCurveClGroup C_bar.left →+ weilCurveClGroup W :=
      QuotientAddGroup.lift (weilCurvePrincipalSubgroup C_bar.left)
        ((QuotientAddGroup.mk' (weilCurvePrincipalSubgroup W)).comp r_Div)
        (fun D hD => (QuotientAddGroup.eq_zero_iff (r_Div D)).mpr (hr_Div_prin D hD))
    have hres_Cl_surj : Function.Surjective res_Cl := by
      intro c_W
      obtain ⟨E, rfl⟩ := QuotientAddGroup.mk'_surjective (weilCurvePrincipalSubgroup W) c_W
      obtain ⟨D, hDE⟩ := hr_Div_surj E
      exact ⟨QuotientAddGroup.mk' _ D, congrArg (QuotientAddGroup.mk' _) hDE⟩
    let p_inf_cl : weilCurveClGroup C_bar.left :=
      QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C_bar.left) (Finsupp.single P_inf_pt 1)
    have hres_Pinf : res_Cl p_inf_cl = 0 := by
      change QuotientAddGroup.mk' (weilCurvePrincipalSubgroup W)
        (r_Div (Finsupp.single P_inf_pt 1)) = 0
      rw [hr_Div_Pinf, map_zero]

    have hRiemann :=
      weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj k C_bar hProjC
    obtain ⟨_, hCard_quot⟩ :=
      weil_smooth_proj_curve_picZero_divisible_and_torsion_finite k C_bar hProjC ℓ hℓ hRiemann
    obtain ⟨deg_Cl, _, _, hdeg_mk, _, _⟩ := hRiemann
    have hdeg_Pinf : deg_Cl p_inf_cl = 1 :=
      (hdeg_mk (Finsupp.single P_inf_pt 1)).trans (Finsupp.sum_single_index rfl)
    let L_range : AddSubgroup (weilCurveClGroup C_bar.left) :=
      (zsmulAddGroupHom (ℓ : ℤ) :
        weilCurveClGroup C_bar.left →+ weilCurveClGroup C_bar.left).range
    let φ_mod : weilCurveClGroup C_bar.left →+ ZMod ℓ :=
      (Int.castAddHom (ZMod ℓ)).comp deg_Cl
    have hφ_ker : ∀ c ∈ L_range, φ_mod c = 0 := by
      rintro c ⟨d, rfl⟩
      change φ_mod ((ℓ : ℤ) • d) = 0
      rw [natCast_zsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    let deg_mod_ℓ : (weilCurveClGroup C_bar.left ⧸ L_range) →+ ZMod ℓ :=
      QuotientAddGroup.lift L_range φ_mod hφ_ker
    have hdeg_mod_surj : Function.Surjective deg_mod_ℓ := by
      intro z
      refine ⟨QuotientAddGroup.mk' L_range ((z.val : ℤ) • p_inf_cl), ?_⟩
      change ((deg_Cl ((z.val : ℤ) • p_inf_cl) : ℤ) : ZMod ℓ) = z
      rw [map_zsmul, hdeg_Pinf, smul_eq_mul, mul_one, Int.cast_natCast, ZMod.natCast_zmod_val]
    let Q_ℓ := weilCurveClGroup C_bar.left ⧸ L_range
    have hFin_Qℓ : Finite Q_ℓ :=
      Nat.finite_of_card_ne_zero (by rw [hCard_quot]; exact hPrime.ne_zero)
    let _ : Fintype Q_ℓ := Fintype.ofFinite Q_ℓ
    have hCard_eq : Fintype.card Q_ℓ = Fintype.card (ZMod ℓ) := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hCard_quot, Nat.card_zmod]
    have hdeg_mod_bij : Function.Bijective deg_mod_ℓ :=
      (Fintype.bijective_iff_surjective_and_card deg_mod_ℓ).mpr ⟨hdeg_mod_surj, hCard_eq⟩

    have hDiv_ClW : ∀ c_W : weilCurveClGroup W, ∃ d_W : weilCurveClGroup W, ℓ • d_W = c_W := by
      intro c_W
      obtain ⟨c, rfl⟩ := hres_Cl_surj c_W
      let c₀ : weilCurveClGroup C_bar.left := c - (deg_Cl c) • p_inf_cl
      have hdeg_c₀ : deg_Cl c₀ = 0 := by
        dsimp [c₀]
        rw [map_sub, map_zsmul, hdeg_Pinf, smul_eq_mul, mul_one, sub_self]
      have hmod_c₀ : deg_mod_ℓ (QuotientAddGroup.mk' L_range c₀) = 0 := by
        change ((deg_Cl c₀ : ℤ) : ZMod ℓ) = 0
        rw [hdeg_c₀, Int.cast_zero]
      have hmk_c₀ : QuotientAddGroup.mk' L_range c₀ = 0 :=
        hdeg_mod_bij.1 (hmod_c₀.trans (map_zero deg_mod_ℓ).symm)
      have hmem_c₀ : c₀ ∈ L_range := (QuotientAddGroup.eq_zero_iff c₀).mp hmk_c₀
      obtain ⟨d, hd⟩ := hmem_c₀
      have hd_nsmul : ℓ • d = c₀ := by simpa [zsmulAddGroupHom_apply, natCast_zsmul] using hd
      refine ⟨res_Cl d, ?_⟩
      calc ℓ • res_Cl d
          = res_Cl (ℓ • d) := (map_nsmul res_Cl ℓ d).symm
        _ = res_Cl c₀ := by rw [hd_nsmul]
        _ = res_Cl c - (deg_Cl c) • res_Cl p_inf_cl := by
            dsimp [c₀]
            rw [map_sub, map_zsmul]
        _ = res_Cl c := by rw [hres_Pinf, smul_zero, sub_zero]

    obtain ⟨hKSheaf, Div_sh, ι_gm, div_mor, h0_div, valDiv, hSE_div, hValProp, hValNat, ⟨e_Cl⟩⟩ :=
      weil_etale_curve_weil_divisor_short_exact k W_ov
        weil_etale_gm_isSheaf_and_proj_H0_divisible.1
    have hVanDiv : ∀ r : ℕ, 1 ≤ r → Subsingleton (Div_sh.H r) := by
      intro r hr
      apply weil_etale_qc_sep_cech_vanishing_implies_H_subsingleton W_ov.left Div_sh _ r hr
      intro U W_et _ _ _ w _ p c hc
      have hComp_p : CompactSpace ↥(weilEtaleCechObj w p).left :=
        (weil_etale_curve_divisor_finsupp_cech_vanishing k W_ov U W_et w p).1
      have hComp_p1 : CompactSpace ↥(weilEtaleCechObj w (p + 1)).left :=
        (weil_etale_curve_divisor_finsupp_cech_vanishing k W_ov U W_et w (p + 1)).1
      let c_fn := valDiv (weilEtaleCechObj w (p + 1)) c
      have hc_mem : c_fn ∈ Set.range (valDiv (weilEtaleCechObj w (p + 1))) := ⟨c, rfl⟩
      rw [(hValProp (weilEtaleCechObj w (p + 1))).2 hComp_p1] at hc_mem
      have hc_cocycle : ∀ z : { y : ↥(weilEtaleCechObj w (p + 2)).left //
          IsClosed ({(weilEtaleCechObj w (p + 2)).hom.base y} : Set ↥W_ov.left) },
          (Finset.univ.sum fun j_idx : Fin (p + 3) =>
            (-1 : ℤ) ^ (j_idx : ℕ) *
              c_fn ⟨(weilEtaleCechFace w (p + 1) j_idx).left.base z.1, by
                rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                  CategoryTheory.MorphismProperty.Over.w (weilEtaleCechFace w (p + 1) j_idx)]
                exact z.2⟩) = 0 := by
        intro z
        have hval0 : valDiv (weilEtaleCechObj w (p + 2))
            (weilEtaleCechDiff Div_sh.obj w (p + 1) c) z = 0 := by
          rw [hc, map_zero, Pi.zero_apply]
        rw [← hval0]
        dsimp [weilEtaleCechDiff, c_fn]
        rw [AddMonoidHom.finsetSum_apply, map_sum, Finset.sum_apply]
        apply Finset.sum_congr rfl
        intro j_idx _
        rw [AddMonoidHom.smul_apply, map_zsmul, Pi.smul_apply, zsmul_eq_mul, Int.cast_id,
          hValNat (weilEtaleCechFace w (p + 1) j_idx) c z]
      obtain ⟨b_fn, hb_fin, hb_eq⟩ :=
        (weil_etale_curve_divisor_finsupp_cech_vanishing k W_ov U W_et w p).2 c_fn hc_mem hc_cocycle
      have hb_mem : b_fn ∈ Set.range (valDiv (weilEtaleCechObj w p)) := by
        rw [(hValProp (weilEtaleCechObj w p)).2 hComp_p]
        exact hb_fin
      obtain ⟨b, hb⟩ := hb_mem
      refine ⟨b, (hValProp (weilEtaleCechObj w (p + 1))).1 ?_⟩
      ext y
      change valDiv (weilEtaleCechObj w (p + 1)) (weilEtaleCechDiff Div_sh.obj w p b) y = c_fn y
      rw [← hb_eq y]
      dsimp [weilEtaleCechDiff]
      rw [AddMonoidHom.finsetSum_apply, map_sum, Finset.sum_apply]
      apply Finset.sum_congr rfl
      intro j_idx _
      rw [AddMonoidHom.smul_apply, map_zsmul, Pi.smul_apply, zsmul_eq_mul, Int.cast_id,
        hValNat (weilEtaleCechFace w p j_idx) b y, hb]

    have hVanK : ∀ r : ℕ, 1 ≤ r → Subsingleton ((weilEtaleKSheaf W_ov.left).H r) := by
      intro r hr
      apply weil_etale_qc_sep_cech_vanishing_implies_H_subsingleton W_ov.left
        (weilEtaleKSheaf W_ov.left) _ r hr
      intro U W_et _ _ _ w _ p c hc
      let isoK : weilEtaleKPresheaf W_ov.left ≅ (weilEtaleKSheaf W_ov.left).obj :=
        CategoryTheory.isoSheafify W_ov.left.smallEtaleTopology hKSheaf
      have hDiffInv : ∀ (m : ℕ)
          (x : ↥((weilEtaleKSheaf W_ov.left).obj.obj (Opposite.op (weilEtaleCechObj w m)))),
          (isoK.inv.app (Opposite.op (weilEtaleCechObj w (m + 1)))).hom
            (weilEtaleCechDiff (weilEtaleKSheaf W_ov.left).obj w m x) =
          weilEtaleCechDiff (weilEtaleKPresheaf W_ov.left) w m
            ((isoK.inv.app (Opposite.op (weilEtaleCechObj w m))).hom x) := by
        intro m x
        dsimp [weilEtaleCechDiff]
        rw [AddMonoidHom.finsetSum_apply, AddMonoidHom.finsetSum_apply, map_sum]
        apply Finset.sum_congr rfl
        intro j_idx _
        rw [AddMonoidHom.smul_apply, AddMonoidHom.smul_apply, map_zsmul]
        congr 1
        have hnat := isoK.inv.naturality (weilEtaleCechFace w m j_idx).op
        exact congrArg (fun φ => φ.hom x) hnat
      have hDiffHom : ∀ (m : ℕ)
          (x : ↥((weilEtaleKPresheaf W_ov.left).obj (Opposite.op (weilEtaleCechObj w m)))),
          (isoK.hom.app (Opposite.op (weilEtaleCechObj w (m + 1)))).hom
            (weilEtaleCechDiff (weilEtaleKPresheaf W_ov.left) w m x) =
          weilEtaleCechDiff (weilEtaleKSheaf W_ov.left).obj w m
            ((isoK.hom.app (Opposite.op (weilEtaleCechObj w m))).hom x) := by
        intro m x
        dsimp [weilEtaleCechDiff]
        rw [AddMonoidHom.finsetSum_apply, AddMonoidHom.finsetSum_apply, map_sum]
        apply Finset.sum_congr rfl
        intro j_idx _
        rw [AddMonoidHom.smul_apply, AddMonoidHom.smul_apply, map_zsmul]
        congr 1
        have hnat := isoK.hom.naturality (weilEtaleCechFace w m j_idx).op
        exact congrArg (fun φ => φ.hom x) hnat
      let c₀ := (isoK.inv.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom c
      have hc₀ : weilEtaleCechDiff (weilEtaleKPresheaf W_ov.left) w (p + 1) c₀ = 0 := by
        rw [← hDiffInv (p + 1) c, hc, map_zero]
      obtain ⟨b₀, hb₀⟩ :=
        weil_etale_curve_generic_gm_cech_vanishing k W_ov
          (fun E L _ _ _ _ _ _ _ n hn =>
            weil_tsen_c1_galois_units_cohomology_vanishing k E L n hn)
          U W_et w p c₀ hc₀
      refine ⟨(isoK.hom.app (Opposite.op (weilEtaleCechObj w p))).hom b₀, ?_⟩
      rw [← hDiffHom p b₀, hb₀]
      exact congrArg (fun φ => φ.hom c)
        (isoK.inv_hom_id_app (Opposite.op (weilEtaleCechObj w (p + 1))))

    let Fℤ := (CategoryTheory.constantSheaf W_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let SC_div := CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div
    let e_H1_Cl : (weilEtaleGmSheaf W_ov.left).H 1 ≃+ weilCurveClGroup W_ov.left := by
      let δ₀ : Div_sh.H 0 →+ (weilEtaleGmSheaf W_ov.left).H 1 :=
        hSE_div.extClass.postcomp Fℤ (rfl : 0 + 1 = 1)
      let p₀ : (weilEtaleKSheaf W_ov.left).H 0 →+ Div_sh.H 0 :=
        (CategoryTheory.Abelian.Ext.mk₀ div_mor).postcomp Fℤ (Nat.add_zero 0)
      have hSubK1 : Subsingleton ((weilEtaleKSheaf W_ov.left).H 1) := hVanK 1 le_rfl
      have hδ₀_surj : Function.Surjective δ₀ := by
        intro a
        have ha0 : a.comp (CategoryTheory.Abelian.Ext.mk₀ SC_div.f) (Nat.add_zero 1) = 0 :=
          @Subsingleton.elim _ hSubK1 _ _
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE_div a ha0 (rfl : 0 + 1 = 1)
      have hker : δ₀.ker = p₀.range := by
        ext d
        simp only [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
        constructor
        · intro hd
          exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hSE_div d (rfl : 0 + 1 = 1) hd
        · rintro ⟨y, rfl⟩
          have hex₃ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' Fℤ hSE_div 0 1 rfl
          have hzero := (fun {S : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : S.Exact) =>
            S.zero) hex₃
          exact congrArg (fun φ => φ.hom y) hzero
      exact ((QuotientAddGroup.quotientKerEquivOfSurjective δ₀ hδ₀_surj).symm.trans
        (QuotientAddGroup.quotientAddEquivOfEq hker)).trans e_Cl

    have hVanGm : ∀ t : ℕ, 2 ≤ t → Subsingleton ((weilEtaleGmSheaf W_ov.left).H t) := by
      intro t ht
      obtain ⟨n₀, rfl⟩ : ∃ n₀ : ℕ, n₀ + 1 = t := ⟨t - 1, by omega⟩
      have hn₀ : 1 ≤ n₀ := by omega
      have hSubKn : Subsingleton ((weilEtaleKSheaf W_ov.left).H (n₀ + 1)) := hVanK (n₀ + 1) (by omega)
      have hSubDn : Subsingleton (Div_sh.H n₀) := hVanDiv n₀ hn₀
      refine ⟨fun a₁ a₂ => ?_⟩
      have ha0 : ∀ a : (weilEtaleGmSheaf W_ov.left).H (n₀ + 1), a = 0 := by
        intro a
        have hi0 : a.comp (CategoryTheory.Abelian.Ext.mk₀ SC_div.f) (Nat.add_zero (n₀ + 1)) = 0 :=
          @Subsingleton.elim _ hSubKn _ _
        obtain ⟨c, hc⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE_div a hi0 (rfl : n₀ + 1 = n₀ + 1)
        have hc0 : c = 0 := @Subsingleton.elim _ hSubDn _ _
        rw [← hc, hc0]
        exact (hSE_div.extClass.postcomp Fℤ (rfl : n₀ + 1 = n₀ + 1)).map_zero
      rw [ha0 a₁, ha0 a₂]

    obtain ⟨_, ι_kum, p_kum, h0_kum, hp_kum, hSE_kum⟩ :=
      weil_etale_kummer_mod_prime_short_exact k W_ov ℓ hℓ
    let G_W := weilEtaleGmSheaf W_ov.left
    let SC_kum := CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum
    have hp_ext : ∀ (s : ℕ) (x : G_W.H s),
        x.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero s) = ℓ • x := by
      intro s x
      rw [hp_kum]
      have hnsmul : ∀ (n : ℕ),
          x.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id G_W))
            (Nat.add_zero s) = n • x := by
        intro n
        induction n with
        | zero => simp [CategoryTheory.Abelian.Ext.mk₀_zero]
        | succ n ih =>
          rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
            ih, CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
      exact hnsmul ℓ

    obtain ⟨r₀, rfl⟩ : ∃ r₀ : ℕ, r₀ + 1 = q := ⟨q - 1, by omega⟩
    have hr₀ : 1 ≤ r₀ := by omega
    have hSubGm_succ : Subsingleton (G_W.H (r₀ + 1)) := hVanGm (r₀ + 1) (by omega)
    refine ⟨fun a₁ a₂ => ?_⟩
    have ha0 : ∀ a : weilEtaleTorsionH W_ov.left ℓ (r₀ + 1), a = 0 := by
      intro a
      have hi0 : a.comp (CategoryTheory.Abelian.Ext.mk₀ SC_kum.f) (Nat.add_zero (r₀ + 1)) = 0 :=
        @Subsingleton.elim _ hSubGm_succ _ _
      obtain ⟨x, hx⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE_kum a hi0 (rfl : r₀ + 1 = r₀ + 1)
      have hx_div : ∃ y : G_W.H r₀, ℓ • y = x := by
        by_cases hr₀1 : r₀ = 1
        · subst hr₀1
          obtain ⟨d_W, hd_W⟩ := hDiv_ClW (e_H1_Cl x)
          refine ⟨e_H1_Cl.symm d_W, ?_⟩
          apply e_H1_Cl.injective
          rw [map_nsmul, e_H1_Cl.apply_symm_apply, hd_W]
        · have hSubGm_r : Subsingleton (G_W.H r₀) := hVanGm r₀ (by omega)
          exact ⟨0, by rw [nsmul_zero]; exact @Subsingleton.elim _ hSubGm_r _ _⟩
      obtain ⟨y, hy⟩ := hx_div
      have hpy : y.comp (CategoryTheory.Abelian.Ext.mk₀ SC_kum.g) (Nat.add_zero r₀) = x := by
        dsimp [SC_kum]
        rw [hp_ext r₀ y, hy]
      rw [← hx, ← hpy]
      have hex₃ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' Fℤ hSE_kum r₀ (r₀ + 1) rfl
      have hzero := (fun {S : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : S.Exact) => S.zero) hex₃
      exact congrArg (fun φ => φ.hom y) hzero
    rw [ha0 a₁, ha0 a₂]

  
  
  
  let r₀ : ℕ := q - 1
  have hr₀_eq : r₀ + 1 = q := by omega
  have hr₀_ge : 1 ≤ r₀ := by omega
  have hq_ge : 1 ≤ q := by omega

  let A_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  have : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩

  have hConstrTorsion : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ S (weilEtaleTorsionSheaf S ℓ) := by
    intro S
    have hFin_Aℓ : Finite A_ℓ := Finite.of_equiv (ZMod ℓ) Equiv.ulift.symm
    have hTor_Aℓ : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
      ext ⟨x⟩
      change ULift.up (ℓ • x) = ULift.up 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    refine ⟨hTorConst S, fun Z iZ _ hIntZ => ?_⟩
    have : AlgebraicGeometry.IsIntegral Z := hIntZ
    have : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
    obtain ⟨z₀⟩ := IrreducibleSpace.toNonempty (X := ↥Z)
    let U_top : Z.Opens := ⊤
    exact ⟨U_top, ⟨⟨z₀, trivial⟩⟩, U_top.toScheme, 𝟙 U_top.toScheme, A_ℓ,
      inferInstance, inferInstance, inferInstance, hFin_Aℓ, hTor_Aℓ,
      hPullConst (𝟙 U_top.toScheme ≫ U_top.ι ≫ iZ) A_ℓ⟩

  have hTorOfIso : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}},
      Nonempty (G₁ ≅ G₂) →
      ℓ • CategoryTheory.CategoryStruct.id G₂ = 0 →
      ℓ • CategoryTheory.CategoryStruct.id G₁ = 0 := by
    intro Z G₁ G₂ ⟨e⟩ hT₂
    calc
      ℓ • CategoryTheory.CategoryStruct.id G₁ = ℓ • (e.hom ≫ 𝟙 G₂ ≫ e.inv) := by
        rw [CategoryTheory.Category.id_comp, e.hom_inv_id]
      _ = e.hom ≫ (ℓ • 𝟙 G₂) ≫ e.inv := by
        rw [← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp]
      _ = 0 := by rw [hT₂, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hTorOfPull : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂)
      (G₂ : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u})
      (G₁ : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G₂ = 0 →
      WeilIsEtaleSheafPullback f G₂ G₁ →
      ℓ • CategoryTheory.CategoryStruct.id G₁ = 0 := by
    intro Z₁ Z₂ f G₂ G₁ hT₂ hP₁
    obtain ⟨G₁', hP₁', hT₁', -⟩ := hPullEx f G₂
    obtain ⟨_, _, ⟨e₁⟩⟩ := hP₁
    obtain ⟨_, _, ⟨e₁'⟩⟩ := hP₁'
    exact hTorOfIso ⟨e₁.symm ≪≫ e₁'⟩ (hT₁' hT₂)

