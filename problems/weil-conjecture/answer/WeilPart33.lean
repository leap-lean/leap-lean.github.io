            (CategoryTheory.Category.id_comp π₀) (Ξ s₀)) =
          reb₀ π₁ π_C₁ hπ_comp 0 := by
      rw [h_pull_eq, map_zero]
    exact h_zero_iff.trans
      (h_eq_zero_iff.trans
        ((hConst.1 π_C₁ π₀ π₁ hπ_comp ℱ b _ _).symm.trans
          (hreb₀ π₁ (CategoryTheory.CategoryStruct.id Z₀) π_C₁ π₀ hπ_comp
            (CategoryTheory.Category.id_comp π₀) π₁ (CategoryTheory.Category.comp_id π₁)
            hπ_comp (Ξ s₀) 0).symm))

  
  refine ⟨?_, ?_⟩
  · intro R _ ℱ y B X p Ω hKill
    obtain ⟨ev, heq_gy, hker, halg⟩ := h_s6.1 R y
    let P_ℱ : CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilAltCdSitePullback p).op
        (CategoryTheory.Sheaf.cohomologyPresheaf ℱ b)
    apply (h_s7 R P_ℱ y ev heq_gy).mpr
    intro C₀ _ f₀ u₀ hf₀ hu₀ s₀
    obtain ⟨Ξ, hΞ_iff⟩ := h_s8 R ℱ C₀ f₀ hf₀
    obtain ⟨C₁, hRing₁, g₁, u₁, hg₁, hu₁, hMapsTo⟩ :=
      hKill ev hker halg C₀ f₀ u₀ hf₀ hu₀ (Ξ s₀)
    letI : CommRing C₁ := hRing₁
    have hf₁ : (g₁.comp f₀).Etale := hEtComp hf₀ hg₁
    exact ⟨C₁, hRing₁, g₁, u₁, hg₁, hf₁, hu₁, (hΞ_iff C₁ g₁ hg₁ hf₁ s₀).mpr hMapsTo⟩
  · intro κ R₁ B_κ _ _ _ _ _ σ g_R₁ u_κ ℱ₀ hg_et hu_comp hStalk X₁ Z_B π_B 𝒢_B ξ_id
    obtain ⟨pt₀, ψ_Ω, hψ_gy⟩ := h_s6.2 κ R₁ σ
    let B₁ := AlgebraicGeometry.Spec (CommRingCat.of R₁)
