      haveI : Nontrivial (B_pb ⧸ 𝔭) := Ideal.Quotient.nontrivial_iff.mpr h𝔭.ne_top
      let q_𝔭 : B_pb →+* (B_pb ⧸ 𝔭) := Ideal.Quotient.mk 𝔭
      let ev_w : R_2 →+* k := MvPolynomial.eval (c_w_fn β w)
      let spec_w : MvPolynomial (Fin n) R_2 →+* MvPolynomial (Fin n) k := MvPolynomial.map ev_w
      have hspec_ι : spec_w.comp ι_RP = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
