        dsimp [L_tilde]; rw [if_pos rfl]
      rw [hβ_eq, mul_add, ← mul_assoc, ← MvPolynomial.C_mul, mul_inv_cancel₀ hwβ, map_one, one_mul]
      rw [← Finset.add_sum_erase _ (fun r' => MvPolynomial.C (w r') * L0 r') (Finset.mem_univ β)]
