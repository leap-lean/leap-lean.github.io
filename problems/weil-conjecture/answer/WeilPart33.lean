    have hKer_aeval : Ideal.span (Set.range Q_rel) = G_pre.ker := by
      change Ideal.span (Set.range Q_rel) =
        RingHom.ker (MvPolynomial.aeval (R := R_2) (S₁ := B_pb) val_B).toRingHom
      rw [haeval_eq]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨a, rfl⟩
        refine Fin.addCases (fun a₀ => ?_) (fun i₀ => ?_) a
        · change π_quot (Ψ_0 (Fin.addCases _ _ (Fin.castAdd 1 a₀))) = 0
          rw [Fin.addCases_left]
          have h0 : Ψ_0 (ι_RP (q a₀)) = 0 := by
            rw [← RingHom.mem_ker, hKer_Ψ0]
            exact Ideal.subset_span ⟨a₀, rfl⟩
