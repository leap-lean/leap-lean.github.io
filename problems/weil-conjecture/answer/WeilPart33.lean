      exact hφ_ϖ
  have hker_le_q : RingHom.ker φ_D ≤ q := by
    rw [hφ_ker, Ideal.span_singleton_le_iff_mem]
    exact hϖ_mem
  let q' : Ideal D' := Ideal.map φ_D q
  have : q'.IsPrime := Ideal.map_isPrime_of_surjective hφ_surj hker_le_q
  have hcomap_q' : Ideal.comap φ_D q' = q := by
    rw [Ideal.comap_map_of_surjective' φ_D hφ_surj q, sup_eq_left.mpr hker_le_q]
