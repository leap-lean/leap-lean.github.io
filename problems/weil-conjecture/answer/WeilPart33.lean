            (π_quot.comp Algebra.TensorProduct.includeRight.toRingHom)))
          V.topIso.inv |>.mpr hSm_ring
      exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso (2 * m + 1)).cancel_left_isIso
        e_UP_cat.hom ((V.ι ≫ g₂.left).appLE U_P ⊤ htop_UP) |>.mp hStd_comp
    exact ⟨V, hy_V, hSm_V⟩

  
  
  
