  have hZeroDimPkg :
      (∀ (X₁ X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType X₂.hom]
        (g : X₁ ⟶ X₂),
        AlgebraicGeometry.IsFinite g.left →
        ∀ (𝒢 : CategoryTheory.Sheaf X₁.left.smallEtaleTopology AddCommGrpCat.{u}),
