      rw [hCompl_eq]
      refine isOpen_iUnion fun γ => ?_
      let hXγ : MvPolynomial.X γ ∈ 𝒜_2 1 := MvPolynomial.isHomogeneous_X k γ
      let U_γ : (Proj 𝒜_2).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_2 (MvPolynomial.X γ)
      by_cases hpt_γ : s'.base pt ∈ U_γ
