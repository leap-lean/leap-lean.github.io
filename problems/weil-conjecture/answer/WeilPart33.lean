      · ext c
        change Ideal.Quotient.mk I_X1 (j₀ (π0_raw (MvPolynomial.C c))) = _
        rw [hπ0_C, hj0_C]
        rfl
      · intro i
        change Ideal.Quotient.mk I_X1 (j₀ (π0_raw (MvPolynomial.X i))) =
          Ideal.Quotient.mk I_X1 (MvPolynomial.X i)
        rw [hπ0_X]
        fin_cases i
        · change Ideal.Quotient.mk I_X1 (j₀ T) = Ideal.Quotient.mk I_X1 (MvPolynomial.X 0)
          rw [hj0_X]
        · change Ideal.Quotient.mk I_X1 (j₀ 0) = Ideal.Quotient.mk I_X1 (MvPolynomial.X 1)
          rw [map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))).symm
    have hmk₀ : (Ideal.Quotient.mk I_X0).comp ev₀₁ = Ideal.Quotient.mk I_X0 := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        change Ideal.Quotient.mk I_X0 (j₁ (π1_raw (MvPolynomial.C c))) = _
        rw [hπ1_C, hj1_C]
        rfl
      · intro i
        change Ideal.Quotient.mk I_X0 (j₁ (π1_raw (MvPolynomial.X i))) =
          Ideal.Quotient.mk I_X0 (MvPolynomial.X i)
        rw [hπ1_X]
        fin_cases i
        · change Ideal.Quotient.mk I_X0 (j₁ 0) = Ideal.Quotient.mk I_X0 (MvPolynomial.X 0)
          rw [map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))).symm
        · change Ideal.Quotient.mk I_X0 (j₁ T) = Ideal.Quotient.mk I_X0 (MvPolynomial.X 1)
          rw [hj1_X]
    have hf_span₁ : f ∈ I_X1 := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [← RingHom.congr_fun hmk₁ f]
      change Ideal.Quotient.mk I_X1 (j₀ (π0_raw f)) = 0
      rw [hf₀, map_zero, map_zero]
