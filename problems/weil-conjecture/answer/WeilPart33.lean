  let mk_B2 : MvPolynomial (Fin 3) k →+* B₂ := Ideal.Quotient.mk I_B2
  let P₂ : Type u := MvPolynomial (Fin 2) k
  let s : P₂ := MvPolynomial.X (0 : Fin 2)
  let t : P₂ := MvPolynomial.X (1 : Fin 2)
  let φ_f : Fin 3 → P₂ := fun i => if i = 0 then s ^ 2 else if i = 1 then t ^ 2 else s * t
  let φ_raw : MvPolynomial (Fin 3) k →+* P₂ := MvPolynomial.eval₂Hom MvPolynomial.C φ_f
  have hφ_X : ∀ i, φ_raw (MvPolynomial.X i) = φ_f i :=
    fun i => MvPolynomial.eval₂Hom_X' MvPolynomial.C φ_f i
  have hφ_C : ∀ c, φ_raw (MvPolynomial.C c) = MvPolynomial.C c :=
    fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C φ_f c
  have hker_φ : I_B2 ≤ RingHom.ker φ_raw := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_sub, map_mul, map_pow,
      hφ_X, hφ_X, hφ_X]
    change s ^ 2 * t ^ 2 - (s * t) ^ 2 = 0
    ring
  let φ_cone : B₂ →+* P₂ := Ideal.Quotient.lift I_B2 φ_raw hker_φ
  have hφ_mk : ∀ F : MvPolynomial (Fin 3) k, φ_cone (mk_B2 F) = φ_raw F := fun _ => rfl
  have hφ_inj : Function.Injective φ_cone := by
    let ι01_f : Fin 2 → MvPolynomial (Fin 3) k := fun j => MvPolynomial.X j.castSucc
    let ι01 : P₂ →+* MvPolynomial (Fin 3) k := MvPolynomial.eval₂Hom MvPolynomial.C ι01_f
    have hι01_X : ∀ j, ι01 (MvPolynomial.X j) = MvPolynomial.X j.castSucc :=
      fun j => MvPolynomial.eval₂Hom_X' MvPolynomial.C ι01_f j
    have hι01_C : ∀ c, ι01 (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C ι01_f c
    let sq : P₂ →+* P₂ := φ_raw.comp ι01
