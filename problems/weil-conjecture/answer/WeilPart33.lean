      exact ⟨e.trans (CategoryTheory.eqToIso (by rw [hidx]))⟩
    have hBaseDesc : ∀ t : ℕ, t ≤ q - 1 → Subsingleton ((P_push.obj (W t)).H (q - t)) := by
      intro t
      induction t with
      | zero =>
        intro _
        rw [Nat.sub_zero, hW0]
        exact hSubPush
      | succ t ih =>
        intro ht1
