    let Shf := CategoryTheory.presheafToSheaf B.smallEtaleTopology AddCommGrpCat.{u}
    have hWhisk0 :
        ℓ • CategoryTheory.CategoryStruct.id (W_left.obj (ℱ.cohomologyPresheaf b)) = 0 := by
      rw [← W_left.map_id, ← CategoryTheory.Functor.map_nsmul, hPre0,
