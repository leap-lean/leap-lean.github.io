    rw [Polynomial.ringKrullDim_of_isNoetherianRing]
    have _ : Module.Finite κ B_κ := Module.Finite.of_quasiFinite
    have hInt_Bκ : Algebra.IsIntegral κ B_κ := Algebra.IsIntegral.of_finite κ B_κ
    have hj_int : j_κ.IsIntegral :=
      fun b => @Algebra.IsIntegral.isIntegral κ B_κ _ _ _ hInt_Bκ b
    have hB_le : ringKrullDim B_κ ≤ (0 : WithBot ℕ∞) := by
      have hle := hKrullLe_of_isIntegral j_κ hj_int
      rwa [ringKrullDim_eq_zero_of_field κ] at hle
    simpa using add_le_add_left hB_le 1

  
  · intro _hc_lt
    let M_c : Submonoid P_m := (nonZeroDivisors P_c).map ψ.toMonoidHom
    have htr_Pc : Algebra.trdeg k P_c = (c : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain]
      simp only [Cardinal.mk_fintype, Fintype.card_fin, Cardinal.lift_natCast]
    have htr_Pm : Algebra.trdeg k P_m = (m : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain]
      simp only [Cardinal.mk_fintype, Fintype.card_fin, Cardinal.lift_natCast]
    have hGen_Pm : ∃ g_gen : Fin m → P_m, Algebra.adjoin k (Set.range g_gen) = ⊤ :=
      ⟨MvPolynomial.X, MvPolynomial.adjoin_range_X⟩
    exact hStep5_core c hc_le P_c P_m (FractionRing P_c) ψ ev M_c (Localization M_c)
      htr_Pc htr_Pm hGen_Pm rfl hψ_inj hφ₀_inj

