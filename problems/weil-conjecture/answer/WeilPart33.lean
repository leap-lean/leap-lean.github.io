    have hSpec_comm1 : Spec.map (fst_V.appLE V_aff Z_aff (le_refl Z_aff)) ≫ hV_aff.fromSpec =
        hZ_aff.fromSpec ≫ fst_V :=
      hV_aff.SpecMap_appLE_fromSpec fst_V hZ_aff (le_refl Z_aff)
    have hSpec_comm2 : Spec.map (g.left.appLE Z_aff W_aff hW_le) ≫ hZ_aff.fromSpec =
        hW_aff.fromSpec ≫ g.left :=
      hZ_aff.SpecMap_appLE_fromSpec g.left hW_aff hW_le
    have hπB_uA : Spec.map (CommRingCat.ofHom π_B) ≫ u_A =
        hW_aff.fromSpec ≫ g.left ≫ fst_V := by
      dsimp [u_A]
      rw [← Category.assoc, ← Spec.map_comp, ← hPush.w, Spec.map_comp, Category.assoc]
      change Spec.map (g.left.appLE Z_aff W_aff hW_le) ≫
        (Spec.map (fst_V.appLE V_aff Z_aff (le_refl Z_aff)) ≫ hV_aff.fromSpec) = _
      rw [hSpec_comm1, ← Category.assoc, hSpec_comm2, Category.assoc]
    have hy_eq : v_x.left.base y = x := by
      change (Spec.map (CommRingCat.ofHom π_B) ≫ u_A).base p_w = x
      rw [hπB_uA]
      change fst_V.base (g.left.base (hW_aff.fromSpec.base p_w)) = x
      rw [hpw_eq]
    have hPb1 : IsPullback
        (Spec.map (g.left.appLE Z_aff W_aff hW_le))
        (Spec.map (CommRingCat.ofHom π_B))
        (Spec.map (fst_V.appLE V_aff Z_aff (le_refl Z_aff)))
        (Spec.map (CommRingCat.ofHom f_A)) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    have hiso_sq : hZ_aff.isoSpec.inv ≫ (fst_V ∣_ V_aff) =
        Spec.map (fst_V.appLE V_aff Z_aff (le_refl Z_aff)) ≫ hV_aff.isoSpec.inv := by
      apply (cancel_mono V_aff.ι).mp
      rw [Category.assoc, AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc,
        Category.assoc]
      exact hSpec_comm1.symm
    have hPb2a : IsPullback hZ_aff.isoSpec.inv
        (Spec.map (fst_V.appLE V_aff Z_aff (le_refl Z_aff)))
        (fst_V ∣_ V_aff) hV_aff.isoSpec.inv :=
      IsPullback.of_horiz_isIso ⟨hiso_sq⟩
    have hPb2b : IsPullback Z_aff.ι (fst_V ∣_ V_aff) fst_V V_aff.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst_V V_aff).flip
    have hPb2 : IsPullback hZ_aff.fromSpec
        (Spec.map (fst_V.appLE V_aff Z_aff (le_refl Z_aff))) fst_V hV_aff.fromSpec :=
      hPb2a.paste_horiz hPb2b
    have hPb123 : IsPullback
        (Spec.map (g.left.appLE Z_aff W_aff hW_le) ≫ hZ_aff.fromSpec ≫ snd_V)
        (Spec.map (CommRingCat.ofHom π_B))
        i
        (u_A ≫ V.hom) := by
      have h := (hPb1.paste_horiz hPb2).paste_horiz hPb_V.flip
      simpa only [Category.assoc, u_A] using h
    have htop_eq : Spec.map (g.left.appLE Z_aff W_aff hW_le) ≫ hZ_aff.fromSpec ≫ snd_V =
        hW_aff.fromSpec ≫ W_Z.hom := by
      rw [← Category.assoc, hSpec_comm2, Category.assoc]
      exact congrArg (hW_aff.fromSpec ≫ ·) (MorphismProperty.Over.w g)
    rw [htop_eq] at hPb123
    have hPb_flip : IsPullback (Spec.map (CommRingCat.ofHom π_B))
        (hW_aff.fromSpec ≫ W_Z.hom) V_x.hom i := hPb123.flip
    let inv_pb : (B.obj V_x).left ⟶ Spec Γ(W_Z.left, W_aff) := hPb_flip.isoPullback.inv
    have he_fst : inv_pb ≫ Spec.map (CommRingCat.ofHom π_B) = Limits.pullback.fst V_x.hom i :=
      hPb_flip.isoPullback_inv_fst
    have he_snd : inv_pb ≫ (hW_aff.fromSpec ≫ W_Z.hom) = (B.obj V_x).hom :=
      hPb_flip.isoPullback_inv_snd
    let w_x : B.obj V_x ⟶ W_Z :=
      MorphismProperty.Over.homMk (inv_pb ≫ hW_aff.fromSpec) (by rw [Category.assoc, he_snd]) trivial
    refine ⟨V_x, v_x, y, w_x, huA_et, hy_eq, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    apply Limits.pullback.hom_ext
    · change (inv_pb ≫ hW_aff.fromSpec ≫ g.left) ≫ fst_V = (B.map v_x).left ≫ fst_V
      rw [Category.assoc, Category.assoc, ← hπB_uA, ← Category.assoc, he_fst]
      exact (Limits.pullback.lift_fst _ _ _).symm
    · change (inv_pb ≫ hW_aff.fromSpec ≫ g.left) ≫ snd_V = (B.map v_x).left ≫ snd_V
      have hg_snd : g.left ≫ snd_V = W_Z.hom := MorphismProperty.Over.w g
      rw [Category.assoc, Category.assoc, hg_snd, he_snd]
      exact (MorphismProperty.Over.w (B.map v_x)).symm

  
  have hPushEpi : ∀ {𝒢₁ 𝒢₂ : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))} (φ : 𝒢₁ ⟶ 𝒢₂) [Epi φ],
      Epi (P_push_R.map φ) := by
    intro 𝒢₁ 𝒢₂ φ _
    have hLocSurj_Z : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) φ).mpr inferInstance
    have hLocSurj_S : Sheaf.IsLocallySurjective (P_push_R.map φ) := by
      refine ⟨fun {V} t => hMemEtale.mpr fun x => ?_⟩
      let fst_V : (B.obj V).left ⟶ V.left := Limits.pullback.fst V.hom i
      have hCl_fst : IsClosedImmersion fst_V :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (IsPullback.of_hasPullback V.hom i).flip hCl
      by_cases hx : x ∈ Set.range fst_V.base
      · rcases hx with ⟨z, hzx⟩
        let t_Z : ↥(𝒢₂.obj.obj (Opposite.op (B.obj V))) := t
        have hmemZ := hMemEtale.mp (Presheaf.imageSieve_mem Z.smallEtaleTopology φ.hom t_Z) z
        obtain ⟨W_Z, g, w, ⟨s_W, hs_W⟩, _, hw_z⟩ := hmemZ
        obtain ⟨V_x, v_x, y, w_x, hvx_et, hy_eq, hwx_comm⟩ := hChartLift V W_Z g w
        refine ⟨V_x, v_x, y, ?_, hvx_et,
          hy_eq.trans ((congrArg fst_V.base hw_z).trans hzx)⟩
        refine ⟨𝒢₁.obj.map w_x.op s_W, ?_⟩
        have hnat := congrArg (fun (u : 𝒢₁.obj.obj (Opposite.op W_Z) ⟶ _) => u s_W)
          (φ.hom.naturality w_x.op)
        simp only [ConcreteCategory.comp_apply] at hnat
        have hs_W' : (φ.hom.app (Opposite.op W_Z)) s_W = (𝒢₂.obj.map g.op) t_Z := hs_W
        change (φ.hom.app (Opposite.op (B.obj V_x))) ((𝒢₁.obj.map w_x.op) s_W) =
          (𝒢₂.obj.map (B.map v_x).op) t_Z
        rw [hnat, hs_W', ← ConcreteCategory.comp_apply, ← 𝒢₂.obj.map_comp, ← op_comp, hwx_comm]
      · let O₀ : V.left.Opens :=
          ⟨(Set.range fst_V.base)ᶜ, (IsClosedImmersion.isClosedEmbedding fst_V).isClosed_range.isOpen_compl⟩
        have hV₀_et : AlgebraicGeometry.Etale (O₀.ι ≫ V.hom) := by
          have : AlgebraicGeometry.Etale V.hom := V.prop
          infer_instance
        let V₀ : S.Etale := MorphismProperty.Over.mk ⊤ (O₀.ι ≫ V.hom) hV₀_et
        let v₀ : V₀ ⟶ V := MorphismProperty.Over.homMk O₀.ι rfl trivial
        have hv₀_fst : (B.map v₀).left ≫ fst_V = Limits.pullback.fst V₀.hom i ≫ O₀.ι :=
          Limits.pullback.lift_fst _ _ _
        have hEmp : IsEmpty ↥(B.obj V₀).left := ⟨fun q => by
          let y₀ : ↥O₀ := (Limits.pullback.fst V₀.hom i).base q
          have hy₀_mem : O₀.ι.base y₀ = fst_V.base ((B.map v₀).left.base q) :=
            congrArg (fun k => k.base q) hv₀_fst.symm
          exact y₀.2 ⟨(B.map v₀).left.base q, hy₀_mem.symm⟩⟩
        have : Subsingleton ↑((P_push_R.obj 𝒢₂).obj.obj (Opposite.op V₀)) :=
          hEmptySub (B.obj V₀) hEmp 𝒢₂
        refine ⟨V₀, v₀, ⟨x, hx⟩, ⟨0, Subsingleton.elim _ _⟩, inferInstance, rfl⟩
    exact Sheaf.epi_of_isLocallySurjective (P_push_R.map φ)

  
  let oneR_S : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) :=
    weilCupPDModUnit S n
  let oneR_Z : Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) :=
    weilCupPDModUnit Z n
  let L_U : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) :=
    weilCupPDLocalFreeSheaf S n U_et
  let κ : L_U ⟶ oneR_S := weilCupPDLocalCounit S n U_et
  let P_const_S : S.Etaleᵒᵖ ⥤ ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)) :=
    (Functor.const S.Etaleᵒᵖ).obj M_R
  let P_const_Z : Z.Etaleᵒᵖ ⥤ ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)) :=
    (Functor.const Z.Etaleᵒᵖ).obj M_R
  let η_sh_S : P_const_S ⟶ oneR_S.obj :=
    (sheafificationAdjunction S.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).unit.app P_const_S
  let η_sh_Z : P_const_Z ⟶ oneR_Z.obj :=
    (sheafificationAdjunction Z.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).unit.app P_const_Z
  let ηS_app : ∀ V : S.Etale, M_R ⟶ oneR_S.obj.obj (Opposite.op V) :=
    fun V => η_sh_S.app (Opposite.op V)
  let ηZ_app : ∀ W : Z.Etale, M_R ⟶ oneR_Z.obj.obj (Opposite.op W) :=
    fun W => η_sh_Z.app (Opposite.op W)
  have hηS_nat : ∀ {V₁ V₂ : S.Etale} (u : V₁ ⟶ V₂),
      ηS_app V₂ ≫ oneR_S.obj.map u.op = ηS_app V₁ := by
    intro V₁ V₂ u
    have hn := (η_sh_S.naturality u.op).symm
    dsimp only [P_const_S, Functor.const_obj_map] at hn
    exact hn.trans (Category.id_comp (ηS_app V₁))
  have hηZ_nat : ∀ {W₁ W₂ : Z.Etale} (u : W₁ ⟶ W₂),
      ηZ_app W₂ ≫ oneR_Z.obj.map u.op = ηZ_app W₁ := by
    intro W₁ W₂ u
    have hn := (η_sh_Z.naturality u.op).symm
    dsimp only [P_const_Z, Functor.const_obj_map] at hn
    exact hn.trans (Category.id_comp (ηZ_app W₁))
  let ρ_pre : P_const_S ⟶ (P_push_R.obj oneR_Z).obj := Functor.whiskerLeft B.op η_sh_Z
  let ρ : oneR_S ⟶ P_push_R.obj oneR_Z :=
    ((sheafificationAdjunction S.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).homEquiv P_const_S (P_push_R.obj oneR_Z)).symm ρ_pre
  let ρ_app : ∀ V : S.Etale,
      oneR_S.obj.obj (Opposite.op V) ⟶ oneR_Z.obj.obj (Opposite.op (B.obj V)) :=
    fun V => ρ.hom.app (Opposite.op V)
  have hρ_app : ∀ V : S.Etale, ηS_app V ≫ ρ_app V = ηZ_app (B.obj V) := by
    intro V
    have h_unit := (sheafificationAdjunction S.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).homEquiv_unit
      P_const_S (P_push_R.obj oneR_Z) ρ
    have h_eq : η_sh_S ≫ ρ.hom = ρ_pre := by
      change (sheafificationAdjunction S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).unit.app P_const_S ≫
        (sheafToPresheaf S.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).map ρ = ρ_pre
      rw [← h_unit]
      exact Equiv.apply_symm_apply _ _
    exact congrArg (fun τ => τ.app (Opposite.op V)) h_eq

  have hfy_comp : ∀ {𝒢₁ 𝒢₂ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))}
      (u : L_U ⟶ 𝒢₁) (f : 𝒢₁ ⟶ 𝒢₂),
      Sheaf.freeYonedaHomEquiv (u ≫ f) =
        Sheaf.freeYonedaHomEquiv u ≫ f.hom.app (Opposite.op U_et) :=
    fun u f =>
      (congrArg Presheaf.freeYonedaHomEquiv
        ((sheafificationAdjunction S.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).homEquiv_naturality_right u f)).trans
        (Presheaf.freeYonedaHomEquiv_comp _
          ((sheafToPresheaf S.smallEtaleTopology
            (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).map f))

  have h0_κρ : κ ≫ ρ = 0 := by
    apply Sheaf.freeYonedaHomEquiv.injective
    rw [hfy_comp κ ρ]
    have hκ_fy : Sheaf.freeYonedaHomEquiv κ = ηS_app U_et :=
      Equiv.apply_symm_apply _ _
    rw [hκ_fy]
    change ηS_app U_et ≫ ρ_app U_et = 0
    rw [hρ_app U_et]
    have hEmp_BU : IsEmpty ↥(B.obj U_et).left := ⟨fun q => by
      have hcomm_q : U.ι.base ((Limits.pullback.fst U_et.hom i).base q) =
          i.base ((Limits.pullback.snd U_et.hom i).base q) :=
        congrArg (fun k => k.base q) (IsPullback.of_hasPullback U_et.hom i).w
      have hmemU : U.ι.base ((Limits.pullback.fst U_et.hom i).base q) ∈ (U : Set S) :=
        ((Limits.pullback.fst U_et.hom i).base q).2
      rw [hcomm_q, hU] at hmemU
      exact hmemU ⟨(Limits.pullback.snd U_et.hom i).base q, rfl⟩⟩
    have : Subsingleton ↥(oneR_Z.obj.obj (Opposite.op (B.obj U_et))) :=
      hEmptySub (B.obj U_et) hEmp_BU oneR_Z
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro r
    exact Subsingleton.elim _ _

  have hEpi_ρ : Epi ρ := by
    have hLocSurj_ρ : Sheaf.IsLocallySurjective ρ := by
      refine ⟨fun {V} t => hMemEtale.mpr fun x => ?_⟩
      let fst_V : (B.obj V).left ⟶ V.left := Limits.pullback.fst V.hom i
      have hCl_fst : IsClosedImmersion fst_V :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (IsPullback.of_hasPullback V.hom i).flip hCl
      by_cases hx : x ∈ Set.range fst_V.base
      · rcases hx with ⟨z, hzx⟩
        let t_Z : ↥(oneR_Z.obj.obj (Opposite.op (B.obj V))) := t
        have hmemZ := hMemEtale.mp
          (Presheaf.imageSieve_mem Z.smallEtaleTopology
            (toSheafify Z.smallEtaleTopology P_const_Z) t_Z) z
        obtain ⟨W_Z, g, w, ⟨r_val, hr_val⟩, _, hw_z⟩ := hmemZ
        obtain ⟨V_x, v_x, y, w_x, hvx_et, hy_eq, hwx_comm⟩ := hChartLift V W_Z g w
        refine ⟨V_x, v_x, y, ?_, hvx_et,
          hy_eq.trans ((congrArg fst_V.base hw_z).trans hzx)⟩
        refine ⟨(ηS_app V_x) r_val, ?_⟩
        change (ρ_app V_x) ((ηS_app V_x) r_val) = (oneR_Z.obj.map (B.map v_x).op) t_Z
        have h1 : (ρ_app V_x) ((ηS_app V_x) r_val) = (ηZ_app (B.obj V_x)) r_val :=
          (ConcreteCategory.comp_apply (ηS_app V_x) (ρ_app V_x) r_val).symm.trans
            (congrArg (fun u => u r_val) (hρ_app V_x))
        have h2 : (ηZ_app (B.obj V_x)) r_val =
            (oneR_Z.obj.map w_x.op) ((ηZ_app W_Z) r_val) :=
          (congrArg (fun u => u r_val) (hηZ_nat w_x).symm).trans
            (ConcreteCategory.comp_apply (ηZ_app W_Z) (oneR_Z.obj.map w_x.op) r_val)
        have hηZ_eq : η_sh_Z = toSheafify Z.smallEtaleTopology P_const_Z :=
          sheafificationAdjunction_unit_app Z.smallEtaleTopology P_const_Z
        have h3 : (ηZ_app W_Z) r_val = (oneR_Z.obj.map g.op) t_Z :=
          (congrArg (fun τ : P_const_Z ⟶ oneR_Z.obj => (τ.app (Opposite.op W_Z)) r_val)
            hηZ_eq).trans hr_val
        rw [h1, h2, h3, ← ConcreteCategory.comp_apply, ← oneR_Z.obj.map_comp,
          ← op_comp, hwx_comm]
      · let O₀ : V.left.Opens :=
          ⟨(Set.range fst_V.base)ᶜ, (IsClosedImmersion.isClosedEmbedding fst_V).isClosed_range.isOpen_compl⟩
        have hV₀_et : AlgebraicGeometry.Etale (O₀.ι ≫ V.hom) := by
          have : AlgebraicGeometry.Etale V.hom := V.prop
          infer_instance
        let V₀ : S.Etale := MorphismProperty.Over.mk ⊤ (O₀.ι ≫ V.hom) hV₀_et
        let v₀ : V₀ ⟶ V := MorphismProperty.Over.homMk O₀.ι rfl trivial
        have hv₀_fst : (B.map v₀).left ≫ fst_V = Limits.pullback.fst V₀.hom i ≫ O₀.ι :=
          Limits.pullback.lift_fst _ _ _
        have hEmp : IsEmpty ↥(B.obj V₀).left := ⟨fun q => by
          let y₀ : ↥O₀ := (Limits.pullback.fst V₀.hom i).base q
          have hy₀_mem : O₀.ι.base y₀ = fst_V.base ((B.map v₀).left.base q) :=
            congrArg (fun k => k.base q) hv₀_fst.symm
          exact y₀.2 ⟨(B.map v₀).left.base q, hy₀_mem.symm⟩⟩
        have : Subsingleton ↑((P_push_R.obj oneR_Z).obj.obj (Opposite.op V₀)) :=
          hEmptySub (B.obj V₀) hEmp oneR_Z
        refine ⟨V₀, v₀, ⟨x, hx⟩, ⟨0, Subsingleton.elim _ _⟩, inferInstance, rfl⟩
    exact Sheaf.epi_of_isLocallySurjective ρ

  
  let InOpen : S.Etale → Prop := fun W => Set.range W.hom.base ⊆ Set.range U.ι.base
  have inOpen_of_hom : ∀ {W₁ W₂ : S.Etale} (u : W₁ ⟶ W₂), InOpen W₂ → InOpen W₁ := by
    intro W₁ W₂ u h₂ y ⟨x, hx⟩
    rw [← hx]
    have hw : W₁.hom.base x = W₂.hom.base (u.left.base x) := by
      change W₁.hom.base x = (u.left ≫ W₂.hom).base x
      rw [MorphismProperty.Over.w u]
    rw [hw]
    exact h₂ ⟨u.left.base x, rfl⟩
  let liftToU : ∀ (W : S.Etale), InOpen W → (W ⟶ U_et) := fun W h =>
    let l : W.left ⟶ (U : Scheme.{u}) := AlgebraicGeometry.IsOpenImmersion.lift U.ι W.hom h
    have hl : l ≫ U.ι = W.hom := AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι W.hom h
    MorphismProperty.Over.homMk l hl trivial
  have hSubHomU : ∀ (W : S.Etale) (u₁ u₂ : W ⟶ U_et), u₁ = u₂ := by
    intro W u₁ u₂
    apply MorphismProperty.Over.Hom.ext
    apply (cancel_mono U.ι).mp
    exact (MorphismProperty.Over.w u₁).trans (MorphismProperty.Over.w u₂).symm
  let Z₀ : (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) :=
    ModuleCat.of (ULift.{u, 0} (ZMod n)) PUnit.{u + 1}
  have hSubFromZ₀ : ∀ (X₀ : (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))) (f₁ f₂ : Z₀ ⟶ X₀), f₁ = f₂ :=
    fun _ _ _ => ModuleCat.hom_ext (LinearMap.ext fun p => by
      rw [Subsingleton.elim p 0, map_zero, map_zero])
  have hSubToZ₀ : ∀ (X₀ : (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))) (f₁ f₂ : X₀ ⟶ Z₀), f₁ = f₂ :=
    fun _ _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ => Subsingleton.elim _ _)
  let PU_obj : S.Etaleᵒᵖ → ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)) :=
    fun opW => if InOpen opW.unop then M_R else Z₀
  have hPU_pos : ∀ (opW : S.Etaleᵒᵖ), InOpen opW.unop → PU_obj opW = M_R :=
    fun opW h => by simp only [PU_obj, h, ↓reduceIte]
  have hPU_neg : ∀ (opW : S.Etaleᵒᵖ), ¬ InOpen opW.unop → PU_obj opW = Z₀ :=
    fun opW h => by simp only [PU_obj, h, ↓reduceIte]
  let fromPU : ∀ (opW : S.Etaleᵒᵖ), InOpen opW.unop → (PU_obj opW ⟶ M_R) :=
    fun opW h => eqToHom (hPU_pos opW h)
  let toPU : ∀ (opW : S.Etaleᵒᵖ), InOpen opW.unop → (M_R ⟶ PU_obj opW) :=
    fun opW h => eqToHom (hPU_pos opW h).symm
  let PU_map : ∀ {opW₂ opW₁ : S.Etaleᵒᵖ} (f : opW₂ ⟶ opW₁), PU_obj opW₂ ⟶ PU_obj opW₁ :=
    fun {opW₂ opW₁} f =>
      if h₂ : InOpen opW₂.unop then
        fromPU opW₂ h₂ ≫ toPU opW₁ (inOpen_of_hom f.unop h₂)
      else 0
  let P_U : S.Etaleᵒᵖ ⥤ ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)) :=
    { obj := PU_obj
      map := fun f => PU_map f
      map_id := fun opW => by
        by_cases h : InOpen opW.unop
        · simp only [PU_map, fromPU, toPU, h, ↓reduceDIte, eqToHom_trans, eqToHom_refl]
        · have hZ : PU_obj opW = Z₀ := hPU_neg opW h
          exact (cancel_epi (eqToHom hZ.symm)).mp (hSubFromZ₀ _ _ _)
      map_comp := fun {opW₃ opW₂ opW₁} f g => by
        by_cases h₃ : InOpen opW₃.unop
        · have h₂ : InOpen opW₂.unop := inOpen_of_hom f.unop h₃
          simp only [PU_map, fromPU, toPU, h₃, h₂, ↓reduceDIte, eqToHom_trans]
        · have hZ : PU_obj opW₃ = Z₀ := hPU_neg opW₃ h₃
          exact (cancel_epi (eqToHom hZ.symm)).mp (hSubFromZ₀ _ _ _) }
  let ι_pre : P_U ⟶ P_const_S :=
    { app := fun opW => if h : InOpen opW.unop then fromPU opW h else 0
      naturality := fun {opW₂ opW₁} f => by
        by_cases h₂ : InOpen opW₂.unop
        · have h₁ : InOpen opW₁.unop := inOpen_of_hom f.unop h₂
          change PU_map f ≫ (if h : InOpen opW₁.unop then fromPU opW₁ h else 0) =
            (if h : InOpen opW₂.unop then fromPU opW₂ h else 0) ≫ P_const_S.map f
          simp only [PU_map, fromPU, toPU, P_const_S, Functor.const_obj_map,
            h₂, h₁, ↓reduceDIte, eqToHom_trans, Category.comp_id]
        · have hZ : PU_obj opW₂ = Z₀ := hPU_neg opW₂ h₂
          exact (cancel_epi (eqToHom hZ.symm)).mp (hSubFromZ₀ _ _ _) }
  have hMono_ιpre : Mono ι_pre := by
    rw [NatTrans.mono_iff_mono_app]
    intro opW
    by_cases h : InOpen opW.unop
    · change Mono (if h' : InOpen opW.unop then fromPU opW h' else 0)
      simp only [h, ↓reduceDIte]
      infer_instance
    · refine ⟨fun {X₀} u₁ u₂ _ => ?_⟩
      have hZ : P_U.obj opW = Z₀ := hPU_neg opW h
      exact (cancel_mono (eqToHom hZ)).mp (hSubToZ₀ _ _ _)
  have hInU : InOpen U_et := Set.Subset.rfl
  let preEquivU : ∀ (𝒢 : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))),
      (P_U ⟶ 𝒢.obj) ≃ (M_R ⟶ 𝒢.obj.obj (Opposite.op U_et)) :=
    fun 𝒢 =>
      { toFun := fun α => toPU (Opposite.op U_et) hInU ≫ α.app (Opposite.op U_et)
        invFun := fun φ =>
          { app := fun opW =>
              if h : InOpen opW.unop then
                fromPU opW h ≫ φ ≫ 𝒢.obj.map (liftToU opW.unop h).op
              else 0
            naturality := fun {opW₂ opW₁} f => by
              by_cases h₂ : InOpen opW₂.unop
              · have h₁ : InOpen opW₁.unop := inOpen_of_hom f.unop h₂
                have hlift_comp : f.unop ≫ liftToU opW₂.unop h₂ = liftToU opW₁.unop h₁ :=
                  hSubHomU _ _ _
                change PU_map f ≫
                    (if h : InOpen opW₁.unop then
                      fromPU opW₁ h ≫ φ ≫ 𝒢.obj.map (liftToU opW₁.unop h).op else 0) =
                  (if h : InOpen opW₂.unop then
                    fromPU opW₂ h ≫ φ ≫ 𝒢.obj.map (liftToU opW₂.unop h).op else 0) ≫
                    𝒢.obj.map f
                simp only [PU_map, fromPU, toPU, h₂, h₁, ↓reduceDIte, Category.assoc,
                  eqToHom_trans_assoc]
                congr 2
                have hf_eq : f = f.unop.op := rfl
                rw [hf_eq, ← 𝒢.obj.map_comp, ← op_comp, hlift_comp]
              · have hZ : PU_obj opW₂ = Z₀ := hPU_neg opW₂ h₂
                exact (cancel_epi (eqToHom hZ.symm)).mp (hSubFromZ₀ _ _ _) }
        left_inv := fun α => NatTrans.ext (funext fun opW => by
          by_cases h : InOpen opW.unop
          · dsimp only
            simp only [h, ↓reduceDIte]
            have hnat := α.naturality (liftToU opW.unop h).op
            change PU_map (liftToU opW.unop h).op ≫ α.app opW =
              α.app (Opposite.op U_et) ≫ 𝒢.obj.map (liftToU opW.unop h).op at hnat
            calc
              fromPU opW h ≫ (toPU (Opposite.op U_et) hInU ≫ α.app (Opposite.op U_et)) ≫
                  𝒢.obj.map (liftToU opW.unop h).op
                = fromPU opW h ≫ toPU (Opposite.op U_et) hInU ≫
                    (α.app (Opposite.op U_et) ≫ 𝒢.obj.map (liftToU opW.unop h).op) := by
                  simp only [Category.assoc]
              _ = fromPU opW h ≫ toPU (Opposite.op U_et) hInU ≫
                    PU_map (liftToU opW.unop h).op ≫ α.app opW := by rw [← hnat]
              _ = α.app opW := by
                  simp only [PU_map, fromPU, toPU, hInU, ↓reduceDIte,
                    eqToHom_trans_assoc, eqToHom_trans, eqToHom_refl, Category.id_comp]
          · have hZ : PU_obj opW = Z₀ := hPU_neg opW h
            exact (cancel_epi (eqToHom hZ.symm)).mp (hSubFromZ₀ _ _ _))
        right_inv := fun φ => by
          dsimp only
          simp only [hInU, ↓reduceDIte]
          have hlift_id : liftToU U_et hInU = 𝟙 U_et := hSubHomU U_et _ _
          rw [hlift_id, op_id, 𝒢.obj.map_id, Category.comp_id, ← Category.assoc]
          dsimp only [fromPU, toPU]
          rw [eqToHom_trans, eqToHom_refl, Category.id_comp] }
  let shfPU : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n))) :=
    (presheafToSheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).obj P_U
  let shfEquivU : ∀ (𝒢 : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))), (shfPU ⟶ 𝒢) ≃ (L_U ⟶ 𝒢) :=
    fun 𝒢 =>
      ((sheafificationAdjunction S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).homEquiv P_U 𝒢).trans
        ((preEquivU 𝒢).trans Sheaf.freeYonedaHomEquiv.symm)
  have hshfEquiv_nat : ∀ {𝒢₁ 𝒢₂ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))}
      (u : shfPU ⟶ 𝒢₁) (f : 𝒢₁ ⟶ 𝒢₂),
      shfEquivU 𝒢₂ (u ≫ f) = shfEquivU 𝒢₁ u ≫ f := by
    intro 𝒢₁ 𝒢₂ u f
    apply Sheaf.freeYonedaHomEquiv.injective
    rw [hfy_comp]
    dsimp only [shfEquivU, Equiv.trans_apply]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      (sheafificationAdjunction S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).homEquiv_naturality_right]
    dsimp only [preEquivU, Equiv.coe_fn_mk, NatTrans.comp_app]
    rw [Category.assoc]
    rfl
  let ψ_LU_to_PU : L_U ⟶ shfPU := shfEquivU shfPU (𝟙 shfPU)
  let φ_PU_to_LU : shfPU ⟶ L_U := (shfEquivU L_U).symm (𝟙 L_U)
  have hψφ_LU : ψ_LU_to_PU ≫ φ_PU_to_LU = 𝟙 L_U := by
    have h := hshfEquiv_nat (𝟙 shfPU) φ_PU_to_LU
    rw [Category.id_comp, Equiv.apply_symm_apply] at h
    exact h.symm
  have hMono_ψLU : Mono ψ_LU_to_PU := mono_of_mono_fac hψφ_LU
  let κ_PU : shfPU ⟶ oneR_S := (presheafToSheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).map ι_pre
  have : (presheafToSheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).PreservesMonomorphisms :=
    inferInstanceAs
      (presheafToSheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).PreservesMonomorphisms
  have hMono_κPU : Mono κ_PU := (presheafToSheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).map_mono ι_pre
  have hψ_κPU : ψ_LU_to_PU ≫ κ_PU = κ := by
    have h1 := (hshfEquiv_nat (𝟙 shfPU) κ_PU).symm
    rw [Category.id_comp] at h1
    refine h1.trans ?_
    apply Sheaf.freeYonedaHomEquiv.injective
    dsimp only [shfEquivU, Equiv.trans_apply]
    rw [Equiv.apply_symm_apply]
    have hκ_fy : Sheaf.freeYonedaHomEquiv κ = η_sh_S.app (Opposite.op U_et) :=
      Equiv.apply_symm_apply _ _
    rw [hκ_fy]
    have h_adj : (sheafificationAdjunction S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).homEquiv P_U oneR_S κ_PU =
        ι_pre ≫ η_sh_S := by
      rw [Adjunction.homEquiv_unit]
      exact ((sheafificationAdjunction S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).unit.naturality ι_pre).symm
    rw [h_adj]
    dsimp only [preEquivU, Equiv.coe_fn_mk, NatTrans.comp_app, ι_pre, fromPU, toPU]
    simp only [hInU, ↓reduceDIte, ← Category.assoc, eqToHom_trans, eqToHom_refl, Category.id_comp]
  have hMono_κ : Mono κ := by
    rw [← hψ_κPU]
    exact mono_comp ψ_LU_to_PU κ_PU
  have hκ_inj : ∀ W : S.Etale, Function.Injective (κ.hom.app (Opposite.op W)).hom := by
    intro W
    have : (sheafToPresheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).PreservesMonomorphisms :=
      inferInstanceAs
        (sheafToPresheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).PreservesMonomorphisms
    have hMono_hom : Mono κ.hom := (sheafToPresheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod n)))).map_mono κ
    have hMono_app : Mono (κ.hom.app (Opposite.op W)) :=
      (NatTrans.mono_iff_mono_app κ.hom).mp hMono_hom (Opposite.op W)
    exact (ModuleCat.mono_iff_injective (κ.hom.app (Opposite.op W))).mp hMono_app

  
  have hKerSec : ∀ (V : S.Etale) (s : ↥(oneR_S.obj.obj (Opposite.op V))),
      (ρ.hom.app (Opposite.op V)) s = 0 →
      ∃ t : ↥(L_U.obj.obj (Opposite.op V)), (κ.hom.app (Opposite.op V)) t = s := by
    intro V s hs_zero
    let R_s : Sieve V :=
      { arrows := fun {W} (g : W ⟶ V) =>
          ∃ t_W : ↥(L_U.obj.obj (Opposite.op W)),
            (κ.hom.app (Opposite.op W)) t_W = oneR_S.obj.map g.op s
        downward_closed := fun {W Y} {g} ⟨t_W, ht_W⟩ h => by
          refine ⟨L_U.obj.map h.op t_W, ?_⟩
          have hnat := congrArg (fun u => u t_W) (κ.hom.naturality h.op)
          simp only [ConcreteCategory.comp_apply] at hnat
