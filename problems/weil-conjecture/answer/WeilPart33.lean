        · fin_cases i₀
          change π_quot (Ψ_0 (Fin.addCases _ _ (Fin.natAdd s 0))) = 0
          rw [Fin.addCases_right, Matrix.cons_val_zero, hΨ0_Φ, ← RingHom.mem_ker, hKer_π]
