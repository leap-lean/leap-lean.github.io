      V_Z.ι ≫ Z_bar.hom)
    (ε_z : ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z)) →+* k)
    (hKer_εz : RingHom.ker ε_z = (hAffV.primeIdealOf ⟨z_c, hz_c⟩).asIdeal)
    (hεz_id : ε_z.comp (algebraMap k ↑(Z_bar.left.presheaf.obj (Opposite.op V_Z))) =
