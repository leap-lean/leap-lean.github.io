      (ℓ_r : Fin 3 → A_Z)
      (w : Fin 3 → k) (β : Fin 3) (hwβ : w β ≠ 0)
      (hflift_eq : φ f_lift = ∑ r : Fin 3, algebraMap k A_Z (w r) * ℓ_r r)
