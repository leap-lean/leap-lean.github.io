    change ε_amb (algebraMap S' B_amb (φ_S b)) = ε_B1 b
    rw [IsLocalization.Away.lift_eq]
    exact RingHom.congr_fun hε_S'_φ b
  have hz_ker : ∀ idx : Fin (m + 1) × Fin 2, z_amb idx ∈ Ideal.map ψ_amb (RingHom.ker σ_1) := by
    intro idx
    dsimp [z_amb, z_S']
    rw [map_sum]
    refine Ideal.sum_mem _ fun i _ => ?_
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hy'1_ker i))
  have hz_sum : (∑ j : Fin (m + 1), z_amb (j, (0 : Fin 2)) * z_amb (j, (1 : Fin 2))) -
      ψ_amb (ι_R1 (τ_init G_poly)) = -(ψ_amb (α_1 G_poly)) := by
    have hsplit := hM_split (fun j => φ_S (y'_1 j))
    have hrhs_eq : ∑ i : Fin (2 * (m + 1)), ∑ j : Fin (2 * (m + 1)),
        φ_S (A_hat i j) * φ_S (y'_1 i) * φ_S (y'_1 j) =
        φ_S (ι_R1 (τ_init G_poly) - α_1 G_poly) := by
      rw [← hA_hat_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul]
    have hlhs_eq : ∑ j : Fin (m + 1), z_S' (e_pair (j, (0 : Fin 2))) *
        z_S' (e_pair (j, (1 : Fin 2))) =
        ∑ s : Fin (m + 1),
          (∑ i : Fin (2 * (m + 1)), M_sq ⟨2 * s.1, by omega⟩ i * φ_S (y'_1 i)) *
          (∑ i : Fin (2 * (m + 1)), M_sq ⟨2 * s.1 + 1, by omega⟩ i * φ_S (y'_1 i)) := by
      refine Finset.sum_congr rfl fun s _ => ?_
      have he0 : e_pair (s, (0 : Fin 2)) = ⟨2 * s.1, by omega⟩ := by
        ext; rfl
      have he1 : e_pair (s, (1 : Fin 2)) = ⟨2 * s.1 + 1, by omega⟩ := by
        ext; rfl
      rw [he0, he1]
      rfl
    have hsum_S' : ∑ j : Fin (m + 1), z_S' (e_pair (j, (0 : Fin 2))) *
        z_S' (e_pair (j, (1 : Fin 2))) =
        φ_S (ι_R1 (τ_init G_poly) - α_1 G_poly) :=
      hlhs_eq.trans (hsplit.trans hrhs_eq)
    have hmap := congrArg (algebraMap S' B_amb) hsum_S'
    simp only [map_sum, map_mul, map_sub] at hmap
    change (∑ j : Fin (m + 1), z_amb (j, (0 : Fin 2)) * z_amb (j, (1 : Fin 2))) -
      algebraMap S' B_amb (φ_S (ι_R1 (τ_init G_poly))) =
      -(algebraMap S' B_amb (φ_S (α_1 G_poly)))
    rw [hmap]
    ring
  obtain ⟨g_0, hg0_ne, hCrit_iff, B'_0, e_Y0, q_0,
      he_Y0_et, hq_0_et, hComm_0, hSec_surj⟩ :=
    weil_ring_etale_section_open_surj_and_roof_baseChange k m (2 * m + 2) A_Z ε_z
      G_poly Δ_0 dG hΔ0_ne hdG_eval ε_init hε_init_τ B_1 B_amb α_1 ι_R1 σ_1 ψ_amb ε_amb z_amb
      hα1_et hψ_amb_et hσ_ι hσ_α hα_φ hε_amb_comp hΦ_amb_et hz_ker hz_sum
  let delta_crit : MvPolynomial (Fin 2) A_Z := Δ_0 * g_0
  let R'_0 : CommRingCat.{u} := weilCritLocRingCat dG delta_crit
  let τ_crit : MvPolynomial (Fin 2) A_Z →+* R'_0 := weilCritLocTau dG delta_crit
  let φ_P : MvPolynomial (Fin 2) k →+* R'_0 :=
    τ_crit.comp (MvPolynomial.map (algebraMap k A_Z))
  have hφ_P_et : φ_P.Etale :=
    (hEtPkg_Z.2.2 2 der_Z hder_Z_ψ).1 dG g_0
  have hΔ_eval_ne : MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) delta_crit ≠ 0 := by
    change ε_Z2 (Δ_0 * g_0) ≠ 0
    rw [map_mul]
    exact mul_ne_zero hΔ0_ne hg0_ne
  have hε_Q_δ : IsUnit (ε_Q (Ideal.Quotient.mk I_crit delta_crit)) :=
    IsUnit.mk0 _ hΔ_eval_ne
  let ε_R : R'_0 →+* k :=
    IsLocalization.Away.lift (S := Localization.Away (Ideal.Quotient.mk I_crit delta_crit))
      (Ideal.Quotient.mk I_crit delta_crit) hε_Q_δ
  have hε_R_τ : ∀ F : MvPolynomial (Fin 2) A_Z,
      ε_R (τ_crit F) = MvPolynomial.eval₂ ε_z (0 : Fin 2 → k) F := by
    intro F
    change IsLocalization.Away.lift (S := Localization.Away (Ideal.Quotient.mk I_crit delta_crit))
      (Ideal.Quotient.mk I_crit delta_crit) hε_Q_δ
      (algebraMap Q_crit (Localization.Away (Ideal.Quotient.mk I_crit delta_crit))
        (Ideal.Quotient.mk I_crit F)) = _
    rw [IsLocalization.Away.lift_eq]
    rfl
  have hε_R_φ : ∀ P : MvPolynomial (Fin 2) k,
      ε_R (φ_P P) = MvPolynomial.eval (0 : Fin 2 → k) P := by
    intro P
    change ε_R (τ_crit (MvPolynomial.map (algebraMap k A_Z) P)) = _
    rw [hε_R_τ, MvPolynomial.eval₂_map]
    have hcomp : ε_z.comp (algebraMap k A_Z) = RingHom.id k := hε_id
    rw [hcomp]
    rfl
  have hΔ_unit : ε_R (τ_crit delta_crit) ≠ 0 := by
    rw [hε_R_τ]
    exact hΔ_eval_ne
  obtain ⟨N_diag, c_diag, r_diag, hDiag_sum, hDiag_isol⟩ :=
    hMorsePkg.2.1 dG delta_crit hφ_P_et
  let _ : Algebra k R'_0 := (φ_P.comp MvPolynomial.C).toAlgebra
  have hφ_P_alg : φ_P.comp MvPolynomial.C = algebraMap k R'_0 :=
    (RingHom.algebraMap_toAlgebra (φ_P.comp MvPolynomial.C)).symm
  obtain ⟨D_base_der, hD_φ_der, _⟩ :=
    (weil_ring_etale_derivation_and_submersive_jacobian k 2 R'_0 φ_P hφ_P_alg hφ_P_et).1
  let D_base : Fin 2 → (R'_0 → R'_0) := fun b x => D_base_der b x
  have hD_lin : ∀ (b : Fin 2) (x y : R'_0),
      D_base b (x + y) = D_base b x + D_base b y ∧
      D_base b (x * y) = x * D_base b y + y * D_base b x :=
    fun b x y => ⟨map_add (D_base_der b) x y, Derivation.leibniz (D_base_der b) x y⟩
  have hD_h0 : ε_R (D_base (0 : Fin 2) (τ_crit G_poly)) = ε_z ℓ_1 ∧
      ε_R (D_base (1 : Fin 2) (τ_crit G_poly)) = ε_z ℓ_2 := by
    let τ_Z : A_Z →+* R'_0 := τ_crit.comp MvPolynomial.C
    let _ : Algebra A_Z R'_0 := τ_Z.toAlgebra
    have : IsScalarTower k A_Z R'_0 := IsScalarTower.of_algebraMap_eq fun x => by
      rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra]
      change φ_P (MvPolynomial.C x) = τ_crit (MvPolynomial.C (algebraMap k A_Z x))
      rw [← MvPolynomial.map_C]
      rfl
    have hD_τZ : ∀ (b : Fin 2) (c : A_Z),
        D_base_der b (τ_Z c) =
          ∑ i : Fin (2 * m + 2), τ_Z (der_Z i c) * D_base_der b (τ_Z (ψ_Z (MvPolynomial.X i))) := by
      intro b c
      let E_b : Derivation k A_Z R'_0 :=
        { toFun := fun a => D_base_der b (τ_Z a)
          map_add' := fun a₁ a₂ => by simp
          map_smul' := fun r a => by
            dsimp
            rw [Algebra.smul_def, map_mul]
            have hr : τ_Z (algebraMap k A_Z r) = algebraMap k R'_0 r := by
              rw [IsScalarTower.algebraMap_apply k A_Z R'_0 r, RingHom.algebraMap_toAlgebra]
            rw [hr, ← Algebra.smul_def, Derivation.map_smul]
          map_one_eq_zero' := by simp
          leibniz' := fun a₁ a₂ => by
            dsimp
            rw [map_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul,
              Algebra.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra] }
      have huniq := hder_Z_uniq R'_0 E_b c
      change D_base_der b (τ_Z c) =
        ∑ i : Fin (2 * m + 2), (der_Z i c) • D_base_der b (τ_Z (ψ_Z (MvPolynomial.X i))) at huniq
      simpa only [Algebra.smul_def, RingHom.algebraMap_toAlgebra] using huniq
    have hdG_τ_crit : ∀ i : Fin (2 * m + 2),
        τ_Z (der_Z i ℓ_0) + φ_P (MvPolynomial.X (0 : Fin 2)) * τ_Z (der_Z i ℓ_1) +
          φ_P (MvPolynomial.X (1 : Fin 2)) * τ_Z (der_Z i ℓ_2) = 0 := by
      intro i
      have hmem : τ_crit (dG i) = 0 := by
        change algebraMap Q_crit (Localization.Away (Ideal.Quotient.mk I_crit delta_crit))
          (Ideal.Quotient.mk I_crit (dG i)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i)), map_zero]
      have hexp : τ_crit (dG i) =
          τ_Z (der_Z i ℓ_0) + φ_P (MvPolynomial.X (0 : Fin 2)) * τ_Z (der_Z i ℓ_1) +
            φ_P (MvPolynomial.X (1 : Fin 2)) * τ_Z (der_Z i ℓ_2) := by
        change τ_crit (weilMvPolyMapCoeffs (der_Z i) G_poly) = _
        rw [hLinG]
        simp only [map_add, map_mul, τ_Z, φ_P, RingHom.comp_apply, MvPolynomial.map_X]
      exact hexp.symm.trans hmem
    have hG_exp : τ_crit G_poly =
        τ_Z ℓ_0 + φ_P (MvPolynomial.X (0 : Fin 2)) * τ_Z ℓ_1 +
          φ_P (MvPolynomial.X (1 : Fin 2)) * τ_Z ℓ_2 := by
      simp only [G_poly, map_add, map_mul, τ_Z, φ_P, RingHom.comp_apply, MvPolynomial.map_X]
    have hD_X : ∀ b s : Fin 2,
        D_base_der b (φ_P (MvPolynomial.X s)) = if b = s then 1 else 0 := by
      intro b s
      rw [hD_φ_der b (MvPolynomial.X s), MvPolynomial.pderiv_X]
      split_ifs with hbs
      · subst hbs; simp
      · have hsb : s ≠ b := fun h => hbs h.symm
        simp [hsb]
    have hEnv : ∀ b : Fin 2,
        D_base_der b (τ_crit G_poly) =
          (if b = (0 : Fin 2) then 1 else 0) * τ_Z ℓ_1 +
          (if b = (1 : Fin 2) then 1 else 0) * τ_Z ℓ_2 := by
      intro b
      rw [hG_exp, map_add, map_add, Derivation.leibniz, Derivation.leibniz,
        smul_eq_mul, smul_eq_mul, smul_eq_mul, smul_eq_mul,
        hD_X b 0, hD_X b 1, hD_τZ b ℓ_0, hD_τZ b ℓ_1, hD_τZ b ℓ_2]
      have hsum_zero :
          (∑ i : Fin (2 * m + 2), τ_Z (der_Z i ℓ_0) * D_base_der b (τ_Z (ψ_Z (MvPolynomial.X i)))) +
          φ_P (MvPolynomial.X (0 : Fin 2)) *
            (∑ i : Fin (2 * m + 2), τ_Z (der_Z i ℓ_1) * D_base_der b (τ_Z (ψ_Z (MvPolynomial.X i)))) +
          φ_P (MvPolynomial.X (1 : Fin 2)) *
            (∑ i : Fin (2 * m + 2), τ_Z (der_Z i ℓ_2) * D_base_der b (τ_Z (ψ_Z (MvPolynomial.X i)))) =
          ∑ i : Fin (2 * m + 2),
            (τ_Z (der_Z i ℓ_0) + φ_P (MvPolynomial.X (0 : Fin 2)) * τ_Z (der_Z i ℓ_1) +
              φ_P (MvPolynomial.X (1 : Fin 2)) * τ_Z (der_Z i ℓ_2)) *
              D_base_der b (τ_Z (ψ_Z (MvPolynomial.X i))) := by
        simp_rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
      have hrhs0 : ∑ i : Fin (2 * m + 2),
          (τ_Z (der_Z i ℓ_0) + φ_P (MvPolynomial.X (0 : Fin 2)) * τ_Z (der_Z i ℓ_1) +
            φ_P (MvPolynomial.X (1 : Fin 2)) * τ_Z (der_Z i ℓ_2)) *
            D_base_der b (τ_Z (ψ_Z (MvPolynomial.X i))) = 0 := by
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [hdG_τ_crit i, zero_mul]
      linear_combination hsum_zero + hrhs0
    refine ⟨?_, ?_⟩
    · change ε_R (D_base_der 0 (τ_crit G_poly)) = ε_z ℓ_1
      rw [hEnv 0]
      have h01 : ((0 : Fin 2) = (1 : Fin 2)) = False := by decide
      simp only [↓reduceIte, h01, one_mul, zero_mul, add_zero, τ_Z, RingHom.comp_apply,
        hε_R_τ, MvPolynomial.eval₂_C]
    · change ε_R (D_base_der 1 (τ_crit G_poly)) = ε_z ℓ_2
      rw [hEnv 1]
      have h10 : ((1 : Fin 2) = (0 : Fin 2)) = False := by decide
      simp only [↓reduceIte, h10, one_mul, zero_mul, zero_add, τ_Z, RingHom.comp_apply,
        hε_R_τ, MvPolynomial.eval₂_C]
  exact ⟨{
    dG := dG
    delta_crit := delta_crit
    R'_0 := R'_0
    φ_P := φ_P
    ε_R := ε_R
    τ_crit := τ_crit
    N_diag := N_diag
    c_diag := c_diag
    r_diag := r_diag
    D_base := D_base
    B'_0 := B'_0
    e_Y0 := e_Y0
    q_0 := q_0
    hφ_P_et := hφ_P_et
    hε_R_φ := hε_R_φ
    hε_R_τ := hε_R_τ
    hτ_φ := fun _ => rfl
    hΔ_unit := hΔ_unit
    hCrit_iff := hCrit_iff
    hDiag_sum := hDiag_sum
    hDiag_isol := hDiag_isol
    hSm_off_crit := hSm_off_crit
    hD_lin := hD_lin
    hD_φ := hD_φ_der
    hD_h0 := hD_h0
    he_Y0_et := he_Y0_et
    hq_0_et := hq_0_et
    hComm_0 := hComm_0
    hSec_surj := hSec_surj }⟩

theorem weil_etale_mvPolynomial_and_smooth_stalk_isDomain_isIntegral : (∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (ϖ : A),
      ϖ ∈ IsLocalRing.maximalIdeal A →
      (∀ x : A, ϖ * x = 0 → x = 0) →
      IsDomain (A ⧸ Ideal.span ({ϖ} : Set A)) →
      IsDomain A) ∧
    (∀ (d : ℕ) (K : Type u) [Field K]
        (S : Type u) [CommRing S] [Algebra (MvPolynomial (Fin d) K) S]
        [Algebra.Etale (MvPolynomial (Fin d) K) S]
        (q : Ideal S) [q.IsPrime],
      IsDomain (Localization.AtPrime q)) ∧
    (∀ (d : ℕ) (K : Type u) [Field K]
        (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (V : X.Opens) (x : X),
      x ∈ V →
      AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ p_X) →
      IsDomain ↑(X.presheaf.stalk x)) ∧
    (∀ (K : Type u) [Field K]
        (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
      AlgebraicGeometry.IsProper p_X →
      ConnectedSpace ↥X →
      (∀ x : X, IsDomain ↑(X.presheaf.stalk x)) →
      AlgebraicGeometry.IsIntegral X) :=
by
  have hDomOfField (F : Type u) [Field F] : IsDomain F := inferInstance
  have hPolyInsts (F : Type u) [Field F] :
      IsDomain (Polynomial F) ∧ IsPrincipalIdealRing (Polynomial F) :=
    ⟨inferInstance, inferInstance⟩

  have hTransfer {P P' : Type u} (S : Type u) [CommRing P] [CommRing P'] [CommRing S]
      [Algebra P' S] [Algebra.Etale P' S] (e : P ≃+* P') :
      ∃ (hAlg : Algebra P S), @Algebra.Etale P S _ _ hAlg := by
    let _ : Algebra P P' := e.toRingHom.toAlgebra
    have _ : Algebra.Etale P P' := (RingHom.Etale.of_bijective e.bijective).toAlgebra
    let hAlg : Algebra P S := ((algebraMap P' S).comp e.toRingHom).toAlgebra
    have _ : IsScalarTower P P' S := IsScalarTower.of_algebraMap_eq' rfl
    exact ⟨hAlg, Algebra.Etale.comp P P' S⟩

  have hKrull (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (ϖ : A)
      (_ : ϖ ∈ IsLocalRing.maximalIdeal A)
      (hϖ_reg : ∀ x : A, ϖ * x = 0 → x = 0)
      (hQuot : IsDomain (A ⧸ Ideal.span ({ϖ} : Set A))) :
      IsDomain A := by
    let I : Ideal A := Ideal.span ({ϖ} : Set A)
    have hI_prime : I.IsPrime := (Ideal.Quotient.isDomain_iff_prime I).mp hQuot
    have hKrull_bot : (⨅ n : ℕ, I ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing I hI_prime.ne_top
    have h_cancel : ∀ (k : ℕ) (z : A), ϖ ^ k * z = 0 → z = 0 := by
      intro k
      induction k with
      | zero =>
        intro z hz
        simpa using hz
      | succ k ih =>
        intro z hz
        rw [pow_succ', mul_assoc] at hz
        exact ih z (hϖ_reg (ϖ ^ k * z) hz)
    have h_factor : ∀ (m : ℕ) (x : A), x ∉ I ^ m →
        ∃ (k : ℕ) (v : A), x = ϖ ^ k * v ∧ v ∉ I := by
      intro m
      induction m with
      | zero =>
        intro x hx
        exfalso
        apply hx
        rw [pow_zero, Ideal.one_eq_top]
        trivial
      | succ m ih =>
        intro x hx
        by_cases hxm : x ∈ I ^ m
        · have hxm' : x ∈ Ideal.span ({ϖ ^ m} : Set A) := by
            rwa [← Ideal.span_singleton_pow]
          obtain ⟨v, hv_eq⟩ := Ideal.mem_span_singleton.mp hxm'
          refine ⟨m, v, hv_eq, ?_⟩
          intro hvI
          obtain ⟨v', hv'_eq⟩ := Ideal.mem_span_singleton.mp hvI
          apply hx
          rw [Ideal.span_singleton_pow]
          refine Ideal.mem_span_singleton.mpr ⟨v', ?_⟩
          rw [hv_eq, hv'_eq]
          ring
        · exact ih x hxm
    have _ : NoZeroDivisors A := ⟨by
      intro a b hab
      by_cases hb : b = 0
      · exact Or.inr hb
      · left
        have hb_not_bot : b ∉ (⊥ : Ideal A) := by
          rwa [Submodule.mem_bot]
        rw [← hKrull_bot, Ideal.mem_iInf, not_forall] at hb_not_bot
        obtain ⟨m, hbm⟩ := hb_not_bot
        obtain ⟨k, v, hbv, hv_not⟩ := h_factor m b hbm
        have hav : a * v = 0 := by
          apply h_cancel k (a * v)
          calc ϖ ^ k * (a * v) = a * (ϖ ^ k * v) := by ring
            _ = a * b := by rw [← hbv]
            _ = 0 := hab
        have ha_all : ∀ n : ℕ, a ∈ I ^ n := by
          intro n
          induction n with
          | zero =>
            rw [pow_zero, Ideal.one_eq_top]
            trivial
          | succ n ih =>
            have han : a ∈ Ideal.span ({ϖ ^ n} : Set A) := by
              rwa [← Ideal.span_singleton_pow]
            obtain ⟨u, hau⟩ := Ideal.mem_span_singleton.mp han
            have huv : u * v = 0 := by
              apply h_cancel n (u * v)
              calc ϖ ^ n * (u * v) = (ϖ ^ n * u) * v := by ring
                _ = a * v := by rw [← hau]
                _ = 0 := hav
            have huv_mem : u * v ∈ I := by
              rw [huv]
              exact I.zero_mem
            have huI : u ∈ I := (hI_prime.mem_or_mem huv_mem).resolve_right hv_not
            obtain ⟨u', hu'⟩ := Ideal.mem_span_singleton.mp huI
            rw [Ideal.span_singleton_pow]
            refine Ideal.mem_span_singleton.mpr ⟨u', ?_⟩
            rw [hau, hu']
            ring
        have ha_bot : a ∈ (⊥ : Ideal A) := by
          rw [← hKrull_bot]
          exact Ideal.mem_iInf.mpr ha_all
        rwa [Submodule.mem_bot] at ha_bot⟩
    exact NoZeroDivisors.to_isDomain A

  have hEtField (K : Type u) [Field K]
      (S : Type u) [CommRing S] [Algebra K S] [Algebra.Etale K S]
      (q : Ideal S) [hq_prime : q.IsPrime] :
      IsDomain (Localization.AtPrime q) := by
    classical
    rcases (Algebra.Etale.iff_exists_algEquiv_prod K S).mp inferInstance with
      ⟨I, hFin, Ai, hField, hAlg, ⟨e⟩⟩
    let _ : Finite I := hFin
    let _ : Fintype I := Fintype.ofFinite I
    have hsum1 : (∑ i : I, e.symm (Pi.single i (1 : Ai i))) = 1 := by
      rw [← map_sum]
      have hpi : (∑ i : I, Pi.single i (1 : Ai i)) = 1 := by
        ext j
        simp
      rw [hpi, map_one]
    have h1_not_q : (1 : S) ∉ q := q.ne_top_iff_one.mp hq_prime.ne_top
    have hex_i : ∃ i₀ : I, e.symm (Pi.single i₀ (1 : Ai i₀)) ∉ q := by
      by_contra hall
      apply h1_not_q
      rw [← hsum1]
      exact q.sum_mem fun i _ => not_not.mp fun hi => hall ⟨i, hi⟩
    obtain ⟨i₀, hu₀_not⟩ := hex_i
    let u₀ : S := e.symm (Pi.single i₀ (1 : Ai i₀))
    have hu₀_not' : u₀ ∉ q := hu₀_not
    let π : S →+* Ai i₀ := (Pi.evalRingHom Ai i₀).comp e.toRingHom
    have h_ann : ∀ x : S, π x = 0 → x * u₀ = 0 := by
      intro x hx
      apply e.injective
      rw [map_mul, map_zero]
      have heu₀ : e u₀ = Pi.single i₀ (1 : Ai i₀) := e.apply_symm_apply _
      rw [heu₀]
      ext j
      change e x j * Pi.single i₀ (1 : Ai i₀) j = 0
      by_cases hj : j = i₀
      · rw [hj, Pi.single_eq_same, mul_one]
        exact hx
      · simp [Pi.single_eq_of_ne hj]
    have h_units : ∀ y : q.primeCompl, IsUnit (π y.1) := by
      intro y
      apply IsUnit.mk0
      intro hy0
      have hyu : y.1 * u₀ = 0 := h_ann y.1 hy0
      have hmem : y.1 * u₀ ∈ q := by
        rw [hyu]
        exact q.zero_mem
      rcases hq_prime.mem_or_mem hmem with hyq | huq
      · exact y.2 hyq
      · exact hu₀_not' huq
    let ψ : Localization.AtPrime q →+* Ai i₀ := IsLocalization.lift h_units
    have hψ_inj : Function.Injective ψ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨r, s⟩, hzs⟩ := IsLocalization.surj q.primeCompl z
      have hπr : π r = 0 := by
        have h1 := congrArg ψ hzs
        rw [map_mul, hz, zero_mul, IsLocalization.lift_eq] at h1
        exact h1.symm
      have hru₀ : r * u₀ = 0 := h_ann r hπr
      have hmul0 : (z * algebraMap S (Localization.AtPrime q) s.1) *
          algebraMap S (Localization.AtPrime q) u₀ = 0 := by
        rw [hzs, ← map_mul, hru₀, map_zero]
      let u₀_sub : q.primeCompl := ⟨u₀, hu₀_not'⟩
      rcases IsLocalization.map_units (Localization.AtPrime q) s with ⟨us, hus⟩
      rcases IsLocalization.map_units (Localization.AtPrime q) u₀_sub with ⟨uu, huu⟩
      have huu' : (↑uu : Localization.AtPrime q) = algebraMap S (Localization.AtPrime q) u₀ := huu
      have hzs0 : z * algebraMap S (Localization.AtPrime q) s.1 = 0 := by
        calc z * algebraMap S (Localization.AtPrime q) s.1
            = (z * algebraMap S (Localization.AtPrime q) s.1) * (↑uu * ↑uu⁻¹) := by
                rw [Units.mul_inv, mul_one]
          _ = ((z * algebraMap S (Localization.AtPrime q) s.1) *
                algebraMap S (Localization.AtPrime q) u₀) * ↑uu⁻¹ := by
                rw [huu']
                ring
          _ = 0 := by rw [hmul0, zero_mul]
      calc z = z * (↑us * ↑us⁻¹) := by rw [Units.mul_inv, mul_one]
        _ = (z * algebraMap S (Localization.AtPrime q) s.1) * ↑us⁻¹ := by
              rw [hus, mul_assoc]
        _ = 0 := by rw [hzs0, zero_mul]
    have _ : IsDomain (Ai i₀) := @hDomOfField (Ai i₀) (hField i₀)
    exact Function.Injective.isDomain ψ hψ_inj

  have hPidStep (d : ℕ)
      (R₀ : Type u) [CommRing R₀] [IsDomain R₀] [IsPrincipalIdealRing R₀]
      (S : Type u) [CommRing S] [Algebra (MvPolynomial (Fin d) R₀) S]
      [Algebra.Etale (MvPolynomial (Fin d) R₀) S]
      (q : Ideal S) [q.IsPrime]
      (hField : ∀ (K₁ : Type u) [Field K₁]
          (S₁ : Type u) [CommRing S₁] [Algebra (MvPolynomial (Fin d) K₁) S₁]
          [Algebra.Etale (MvPolynomial (Fin d) K₁) S₁]
          (q₁ : Ideal S₁) [q₁.IsPrime],
        IsDomain (Localization.AtPrime q₁)) :
      IsDomain (Localization.AtPrime q) := by
    let _ : Algebra R₀ S := ((algebraMap (MvPolynomial (Fin d) R₀) S).comp MvPolynomial.C).toAlgebra
    have _ : IsScalarTower R₀ (MvPolynomial (Fin d) R₀) S := IsScalarTower.of_algebraMap_eq' rfl
    have hBC_dom (K₁ : Type u) [Field K₁] [Algebra R₀ K₁]
        (B : Type u) [CommRing B] (e_B : TensorProduct R₀ S K₁ ≃+* B)
        (q₁ : Ideal B) [q₁.IsPrime] :
        IsDomain (Localization.AtPrime q₁) := by
      let _ : Algebra (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K₁) :=
        (MvPolynomial.map (algebraMap R₀ K₁)).toAlgebra
      have _ : Algebra.Etale (MvPolynomial (Fin d) K₁)
          (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K₁) S) :=
        Algebra.Etale.baseChange (MvPolynomial (Fin d) R₀) S (MvPolynomial (Fin d) K₁)
      let e_P₁_ring : MvPolynomial (Fin d) K₁ ≃+*
          TensorProduct R₀ (MvPolynomial (Fin d) R₀) K₁ :=
        (MvPolynomial.algebraTensorAlgEquiv R₀ K₁).symm.toRingEquiv.trans
          (Algebra.TensorProduct.comm R₀ K₁ (MvPolynomial (Fin d) R₀)).toRingEquiv
      have he_P₁_comm : ∀ p : MvPolynomial (Fin d) R₀,
          e_P₁_ring (algebraMap (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K₁) p) =
            algebraMap (MvPolynomial (Fin d) R₀)
              (TensorProduct R₀ (MvPolynomial (Fin d) R₀) K₁) p := by
        intro p
        change (Algebra.TensorProduct.comm R₀ K₁ (MvPolynomial (Fin d) R₀))
          ((MvPolynomial.algebraTensorAlgEquiv R₀ K₁).symm
            (MvPolynomial.map (algebraMap R₀ K₁) p)) = p ⊗ₜ[R₀] 1
        have h1 : (MvPolynomial.algebraTensorAlgEquiv R₀ K₁) ((1 : K₁) ⊗ₜ[R₀] p) =
            MvPolynomial.map (algebraMap R₀ K₁) p := by
          rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
        rw [← h1, AlgEquiv.symm_apply_apply]
        rfl
      let e_P₁ : MvPolynomial (Fin d) K₁ ≃ₐ[MvPolynomial (Fin d) R₀]
          TensorProduct R₀ (MvPolynomial (Fin d) R₀) K₁ :=
        AlgEquiv.ofRingEquiv (f := e_P₁_ring) he_P₁_comm
      let e_bc : TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K₁) S ≃+*
          TensorProduct R₀ S K₁ :=
        ((Algebra.TensorProduct.comm (MvPolynomial (Fin d) R₀)
            (MvPolynomial (Fin d) K₁) S).trans
          ((Algebra.TensorProduct.congr AlgEquiv.refl e_P₁).trans
            (Algebra.TensorProduct.cancelBaseChange R₀ (MvPolynomial (Fin d) R₀)
              (MvPolynomial (Fin d) R₀) S K₁))).toRingEquiv
      let e_tot := e_bc.trans e_B
      let _ : Algebra (MvPolynomial (Fin d) K₁) B :=
        (e_tot.toRingHom.comp (algebraMap (MvPolynomial (Fin d) K₁)
          (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K₁) S))).toAlgebra
      have _ : Algebra.Etale (MvPolynomial (Fin d) K₁) B :=
        Algebra.Etale.of_equiv (AlgEquiv.ofRingEquiv (f := e_tot) (fun _ => rfl))
      exact hField K₁ B q₁
    let p₀ : Ideal R₀ := Ideal.comap (algebraMap R₀ S) q
    have _ : p₀.IsPrime := Ideal.IsPrime.comap (algebraMap R₀ S)
    by_cases hp₀ : p₀ = ⊥
    · let K₁ := FractionRing R₀
      let M₀ : Submonoid R₀ := nonZeroDivisors R₀
      let M_S : Submonoid S := Algebra.algebraMapSubmonoid S M₀
      let B := Localization M_S
      have _ : IsLocalization M_S (TensorProduct R₀ S K₁) :=
        IsLocalization.tensor K₁ M₀
      let e_B : TensorProduct R₀ S K₁ ≃+* B :=
        (IsLocalization.algEquiv M_S (TensorProduct R₀ S K₁) B).toRingEquiv
      have hDisj : Disjoint (M_S : Set S) (q : Set S) := by
        rw [Set.disjoint_left]
        rintro _ ⟨r, hr_M₀, rfl⟩ hr_q
        have hr_p₀ : r ∈ p₀ := hr_q
        rw [hp₀, Submodule.mem_bot] at hr_p₀
        exact mem_nonZeroDivisors_iff_ne_zero.mp hr_M₀ hr_p₀
      let Q₁ := (IsLocalization.orderIsoOfPrime M_S B).symm ⟨q, ⟨inferInstance, hDisj⟩⟩
      let q₁ : Ideal B := Q₁.1
      have _ : q₁.IsPrime := Q₁.2
      have hq₁_comap : Ideal.comap (algebraMap S B) q₁ = q :=
        congrArg Subtype.val ((IsLocalization.orderIsoOfPrime M_S B).apply_symm_apply
          ⟨q, ⟨inferInstance, hDisj⟩⟩)
      have _ : IsDomain (Localization.AtPrime q₁) := hBC_dom K₁ B e_B q₁
      let e_loc : Localization.AtPrime (Ideal.comap (algebraMap S B) q₁) ≃+*
          Localization.AtPrime q₁ :=
        (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M_S q₁).toRingEquiv
      have hDom_comap : IsDomain (Localization.AtPrime (Ideal.comap (algebraMap S B) q₁)) :=
        Function.Injective.isDomain e_loc.toRingHom e_loc.injective
      have h_eq_dom : ∀ (p : Ideal S) (_ : p.IsPrime), p = Ideal.comap (algebraMap S B) q₁ →
          IsDomain (Localization.AtPrime p) := by
        rintro p _ rfl
        exact hDom_comap
      exact h_eq_dom q inferInstance hq₁_comap.symm
    · have _ : p₀.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hp₀
      let K₁ := R₀ ⧸ p₀
      let _ : Field K₁ := Ideal.Quotient.field p₀
      let π₀ : R₀ := Submodule.IsPrincipal.generator p₀
      have hp₀_span : Ideal.span ({π₀} : Set R₀) = p₀ :=
        Submodule.IsPrincipal.span_singleton_generator p₀
      have hπ₀_ne : π₀ ≠ 0 := by
        intro h0
        apply hp₀
        rw [← hp₀_span, h0, Ideal.span_singleton_eq_bot]
      have hπ₀_nzd : π₀ ∈ nonZeroDivisors R₀ := mem_nonZeroDivisors_iff_ne_zero.mpr hπ₀_ne
      let A := Localization.AtPrime q
      have _ : IsNoetherianRing S :=
        Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin d) R₀) S
      have _ : IsNoetherianRing A :=
        IsLocalization.isNoetherianRing q.primeCompl A inferInstance
      let s₀ : S := algebraMap R₀ S π₀
      let ϖ : A := algebraMap S A s₀
      have hs₀_q : s₀ ∈ q := by
        change π₀ ∈ p₀
        rw [← hp₀_span]
        exact Ideal.subset_span (Set.mem_singleton π₀)
      have hϖ_mem : ϖ ∈ IsLocalRing.maximalIdeal A :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff A q s₀).mpr hs₀_q
      have _ : Module.Flat R₀ S :=
        Module.Flat.trans R₀ (MvPolynomial (Fin d) R₀) S
      have _ : Module.Flat R₀ A := Module.Flat.trans R₀ S A
      have hReg : IsSMulRegular A π₀ :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors hπ₀_nzd
      have hϖ_reg : ∀ x : A, ϖ * x = 0 → x = 0 := by
        intro x hx
        apply hReg
        change π₀ • x = π₀ • (0 : A)
        rw [Algebra.smul_def, smul_zero, IsScalarTower.algebraMap_apply R₀ S A π₀]
        exact hx
      let I_S : Ideal S := Ideal.map (algebraMap R₀ S) p₀
      have hIS_span : I_S = Ideal.span ({s₀} : Set S) := by
        dsimp [I_S, s₀]
        rw [← hp₀_span, Ideal.map_span, Set.image_singleton]
      let B := S ⧸ I_S
      let e_B : TensorProduct R₀ S K₁ ≃+* B :=
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot S p₀).symm.toRingEquiv
      let f : S →+* B := Ideal.Quotient.mk I_S
      have hf_surj : Function.Surjective f := Ideal.Quotient.mk_surjective
      have hIS_le_q : I_S ≤ q := by
        rw [hIS_span, Ideal.span_singleton_le_iff_mem]
        exact hs₀_q
      have hker_f : RingHom.ker f = I_S := Ideal.mk_ker
      let q_B : Ideal B := Ideal.map f q
      have _ : q_B.IsPrime :=
        Ideal.map_isPrime_of_surjective hf_surj (hker_f.trans_le hIS_le_q)
      have hqB_comap : Ideal.comap f q_B = q := by
        rw [Ideal.comap_map_of_surjective f hf_surj q, ← RingHom.ker_eq_comap_bot, hker_f,
          sup_eq_left.mpr hIS_le_q]
      have _ : IsDomain (Localization.AtPrime q_B) := hBC_dom K₁ B e_B q_B
      let I_A : Ideal A := Ideal.span ({ϖ} : Set A)
      let Q_A := A ⧸ I_A
      let g : A →+* Q_A := Ideal.Quotient.mk I_A
      have hg_surj : Function.Surjective g := Ideal.Quotient.mk_surjective
      have h_map_ker : Ideal.map (algebraMap S A) I_S ≤ I_A := by
        rw [hIS_span, Ideal.map_span, Set.image_singleton]
      let φ_BQ : B →+* Q_A :=
        Ideal.Quotient.lift I_S (g.comp (algebraMap S A)) (by
          intro x hx
          change g (algebraMap S A x) = 0
          rw [← RingHom.mem_ker, Ideal.mk_ker]
          exact h_map_ker (Ideal.mem_map_of_mem (algebraMap S A) hx))
      let _ : Algebra B Q_A := φ_BQ.toAlgebra
      have hcomm_fg : g.comp (algebraMap S A) = (algebraMap B Q_A).comp f := by
        ext x
        rfl
      have hker_g_le : RingHom.ker g ≤ Ideal.map (algebraMap S A) (RingHom.ker f) := by
        rw [Ideal.mk_ker, hker_f, hIS_span, Ideal.map_span, Set.image_singleton]
      have hLoc_map : IsLocalization (Submonoid.map f q.primeCompl) Q_A :=
        IsLocalization.of_surjective q.primeCompl A f hf_surj g hg_surj hcomm_fg hker_g_le
      have hSub_eq : Submonoid.map f q.primeCompl = q_B.primeCompl := by
        ext y
        constructor
        · rintro ⟨x, hx, rfl⟩
          intro hfx
          have hx_q : x ∈ Ideal.comap f q_B := hfx
          rw [hqB_comap] at hx_q
          exact hx hx_q
        · intro hy
          obtain ⟨x, rfl⟩ := hf_surj y
          refine ⟨x, ?_, rfl⟩
          intro hxq
          exact hy (Ideal.mem_map_of_mem f hxq)
      rw [hSub_eq] at hLoc_map
      let e_QA : Q_A ≃+* Localization.AtPrime q_B :=
        (IsLocalization.algEquiv q_B.primeCompl Q_A (Localization.AtPrime q_B)).toRingEquiv
      have hDom_QA : IsDomain Q_A :=
        Function.Injective.isDomain e_QA.toRingHom e_QA.injective
      exact hKrull A ϖ hϖ_mem hϖ_reg hDom_QA

  have hEtPolyDom : ∀ (d : ℕ) (K : Type u) [Field K]
      (S : Type u) [CommRing S] [Algebra (MvPolynomial (Fin d) K) S]
      [Algebra.Etale (MvPolynomial (Fin d) K) S]
      (q : Ideal S) [q.IsPrime],
      IsDomain (Localization.AtPrime q) := by
    intro d
    induction d with
    | zero =>
      intro K hK S hS hAlg hEt q hq
      let _ : Field K := hK
      let _ : CommRing S := hS
      let _ : Algebra (MvPolynomial (Fin 0) K) S := hAlg
      have _ : Algebra.Etale (MvPolynomial (Fin 0) K) S := hEt
      have _ : q.IsPrime := hq
      let e₀ : K ≃+* MvPolynomial (Fin 0) K :=
        (MvPolynomial.isEmptyAlgEquiv K (Fin 0)).symm.toRingEquiv
      obtain ⟨hAlgKS, hEtKS⟩ := hTransfer S e₀
      exact @hEtField K hK S hS hAlgKS hEtKS q hq
    | succ d ih =>
      intro K hK S hS hAlg hEt q hq
      let _ : Field K := hK
      let _ : CommRing S := hS
      let _ : Algebra (MvPolynomial (Fin (d + 1)) K) S := hAlg
      have _ : Algebra.Etale (MvPolynomial (Fin (d + 1)) K) S := hEt
      have _ : q.IsPrime := hq
      obtain ⟨hDomPoly, hPIRPoly⟩ := @hPolyInsts K hK
      let e₁ : MvPolynomial (Fin d) (Polynomial K) ≃+*
          MvPolynomial (Fin d) (MvPolynomial (Fin 1) K) :=
        (MvPolynomial.mapAlgEquiv (Fin d)
          (MvPolynomial.uniqueAlgEquiv K (Fin 1)).symm).toRingEquiv
      let e₂ : MvPolynomial (Fin d) (MvPolynomial (Fin 1) K) ≃+*
          MvPolynomial (Fin d ⊕ Fin 1) K :=
        (MvPolynomial.sumAlgEquiv K (Fin d) (Fin 1)).symm.toRingEquiv
      let e₃ : MvPolynomial (Fin d ⊕ Fin 1) K ≃+* MvPolynomial (Fin (d + 1)) K :=
        (MvPolynomial.renameEquiv K finSumFinEquiv).toRingEquiv
      obtain ⟨hAlgPS, hEtPS⟩ := hTransfer S (e₁.trans (e₂.trans e₃))
      exact @hPidStep d (Polynomial K) _ hDomPoly hPIRPoly S hS hAlgPS hEtPS q hq ih

  have hSmStalkDom (d : ℕ) (K : Type u) [Field K]
      (X : AlgebraicGeometry.Scheme.{u})
      (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (V : X.Opens) (x : X)
      (hx : x ∈ V)
      (hSm : AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ p_X)) :
      IsDomain ↑(X.presheaf.stalk x) := by
    let xV : ↥(V : AlgebraicGeometry.Scheme.{u}) := ⟨x, hx⟩
    let e_stalk : ↑(X.presheaf.stalk x) ≃+* ↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.stalk xV) :=
      (AlgebraicGeometry.Scheme.Opens.stalkIso V xV).symm.commRingCatIsoToRingEquiv
    have _ : IsDomain ↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.stalk xV) := by
      obtain ⟨U, _, W, hW, hxW, e, hf⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff d (V.ι ≫ p_X)).mp hSm xV
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := (V.ι ≫ p_X).base xV
      have hpt₀ : pt₀ ∈ U := e hxW
      have hU_top : U = ⊤ := by
        ext y
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        have hy : y = pt₀ := Subsingleton.elim y pt₀
        rwa [hy]
      let iso_RU : (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U) ≅
          CommRingCat.of K :=
        (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.mapIso
            (eqToIso (congrArg Opposite.op hU_top)) ≪≫
          AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)
      let e_KR : K ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U)) :=
        iso_RU.symm.commRingCatIsoToRingEquiv
      let e_P : MvPolynomial (Fin d) K ≃+*
          MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U)) :=
        MvPolynomial.mapEquiv (Fin d) e_KR
      obtain ⟨g_et, _, hg_et⟩ :=
        RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hf
      let S : Type u := ↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op W))
      let _ : Algebra (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U))) S :=
        g_et.toAlgebra
      have _ : Algebra.Etale (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U))) S :=
        hg_et.toAlgebra
      obtain ⟨hAlgKS, hEtKS⟩ := hTransfer S e_P
      let xW : ↥W := ⟨xV, hxW⟩
      let q : Ideal S := (hW.primeIdealOf xW).asIdeal
      have _ : IsDomain (Localization.AtPrime q) :=
        @hEtPolyDom d K _ S _ hAlgKS hEtKS q inferInstance
      let _ : Algebra S ↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.stalk xV) :=
        TopCat.Presheaf.algebra_section_stalk (V : AlgebraicGeometry.Scheme.{u}).presheaf xW
      have _ : IsLocalization.AtPrime ↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.stalk xV) q :=
        hW.isLocalization_stalk xW
      let e_loc : ↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.stalk xV) ≃+* Localization.AtPrime q :=
        (IsLocalization.algEquiv q.primeCompl
          (↑((V : AlgebraicGeometry.Scheme.{u}).presheaf.stalk xV))
          (Localization.AtPrime q)).toRingEquiv
      exact Function.Injective.isDomain e_loc.toRingHom e_loc.injective
    exact Function.Injective.isDomain e_stalk.toRingHom e_stalk.injective

  have hIntOfStalkDom (K : Type u) [Field K]
      (X : AlgebraicGeometry.Scheme.{u})
      (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (hProp : AlgebraicGeometry.IsProper p_X)
      (hConn : ConnectedSpace ↥X)
      (hStalks : ∀ x : X, IsDomain ↑(X.presheaf.stalk x)) :
      AlgebraicGeometry.IsIntegral X := by
    have _ : AlgebraicGeometry.IsProper p_X := hProp
    have _ : ConnectedSpace ↥X := hConn
    have _ : AlgebraicGeometry.IsLocallyNoetherian X :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_X
    have hOpenIrred : ∀ x : X, ∃ W : Set X, IsOpen W ∧ x ∈ W ∧ IsIrreducible W := by
      intro x
      obtain ⟨U, hU, hx, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
      let B := ↑(X.presheaf.obj (Opposite.op U))
      have _ : IsNoetherianRing B :=
        AlgebraicGeometry.IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
      have hFinMin : (minimalPrimes B).Finite := minimalPrimes.finite_of_isNoetherianRing B
      let xU : ↥U := ⟨x, hx⟩
      let q_x : PrimeSpectrum B := hU.primeIdealOf xU
      let Stalk_x := ↑(X.presheaf.stalk x)
      have _ : IsDomain Stalk_x := hStalks x
      let _ : Algebra B Stalk_x := TopCat.Presheaf.algebra_section_stalk X.presheaf xU
      have _ : IsLocalization.AtPrime Stalk_x q_x.asIdeal := hU.isLocalization_stalk xU
      let e_ord := IsLocalization.AtPrime.orderIsoOfPrime Stalk_x q_x.asIdeal
      let P₀ := e_ord ⟨⊥, inferInstance⟩
      let p₀ : Ideal B := P₀.1
      have hp₀_prime : p₀.IsPrime := P₀.2.1
      have hp₀_least : ∀ (p : Ideal B), p.IsPrime → p ≤ q_x.asIdeal → p₀ ≤ p := by
        intro p hp_prime hp_le
        let Q_p := e_ord.symm ⟨p, ⟨hp_prime, hp_le⟩⟩
        have hbot_le : (⟨⊥, inferInstance⟩ : {P : Ideal Stalk_x // P.IsPrime}) ≤ Q_p :=
          Subtype.mk_le_mk.mpr bot_le
        have hmono := e_ord.monotone hbot_le
        rwa [e_ord.apply_symm_apply] at hmono
      have hp₀_uniq : ∀ p ∈ minimalPrimes B, p ≤ q_x.asIdeal → p = p₀ := by
        intro p hp hp_le
        have hp₀_le_p : p₀ ≤ p := hp₀_least p hp.1.1 hp_le
        have hp_le_p₀ : p ≤ p₀ := hp.2 ⟨hp₀_prime, bot_le⟩ hp₀_le_p
        exact le_antisymm hp_le_p₀ hp₀_le_p
      let S_other : Set (Ideal B) := minimalPrimes B \ {p₀}
      let C₀ : Set (PrimeSpectrum B) := ⋃ p ∈ S_other, PrimeSpectrum.zeroLocus (p : Set B)
      have hC₀_closed : IsClosed C₀ :=
        hFinMin.sdiff.isClosed_biUnion fun p _ => PrimeSpectrum.isClosed_zeroLocus (p : Set B)
      let V₀ : Set (PrimeSpectrum B) := C₀ᶜ
      have hV₀_open : IsOpen V₀ := hC₀_closed.isOpen_compl
      have hqx_V₀ : q_x ∈ V₀ := by
        intro hqx_C₀
        simp only [C₀, Set.mem_iUnion] at hqx_C₀
        obtain ⟨p, hp_other, hqx_Z⟩ := hqx_C₀
        rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe] at hqx_Z
        exact hp_other.2 (hp₀_uniq p hp_other.1 hqx_Z)
      let Z₀ : Set (PrimeSpectrum B) := PrimeSpectrum.zeroLocus (p₀ : Set B)
      have hV₀_sub : V₀ ⊆ Z₀ := by
        intro q hq_V₀
        obtain ⟨p, hp_min, hp_le_q⟩ :=
          Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal B)) (J := q.asIdeal) bot_le
        by_cases hp_eq : p = p₀
        · subst hp_eq
          rwa [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
        · exfalso
          apply hq_V₀
          simp only [C₀, Set.mem_iUnion]
          refine ⟨p, ⟨hp_min, hp_eq⟩, ?_⟩
          rwa [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
      have hZ₀_irred : IsIrreducible Z₀ := by
        rw [PrimeSpectrum.isIrreducible_zeroLocus_iff, hp₀_prime.radical]
        exact hp₀_prime
      have hV₀_irred : IsIrreducible V₀ := by
        refine ⟨⟨q_x, hqx_V₀⟩, ?_⟩
        intro O₁ O₂ hO₁ hO₂ h1 h2
        have hZ1 : (Z₀ ∩ (V₀ ∩ O₁)).Nonempty := by
          obtain ⟨y, hyV, hyO⟩ := h1
          exact ⟨y, hV₀_sub hyV, hyV, hyO⟩
        have hZ2 : (Z₀ ∩ (V₀ ∩ O₂)).Nonempty := by
          obtain ⟨y, hyV, hyO⟩ := h2
          exact ⟨y, hV₀_sub hyV, hyV, hyO⟩
        obtain ⟨y, _, ⟨hyV, hyO₁⟩, ⟨_, hyO₂⟩⟩ :=
          hZ₀_irred.isPreirreducible (V₀ ∩ O₁) (V₀ ∩ O₂) (hV₀_open.inter hO₁)
            (hV₀_open.inter hO₂) hZ1 hZ2
        exact ⟨y, hyV, hyO₁, hyO₂⟩
      have hEmb := AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hU.fromSpec
      refine ⟨hU.fromSpec.base '' V₀, hEmb.isOpenMap V₀ hV₀_open,
        ⟨q_x, hqx_V₀, hU.fromSpec_primeIdealOf xU⟩,
        hV₀_irred.image hU.fromSpec.base hEmb.continuous.continuousOn⟩
    let x₀ : X := Classical.arbitrary ↥X
    let E₀ : Set X := irreducibleComponent x₀
    have hE₀_open : IsOpen E₀ := by
      rw [isOpen_iff_forall_mem_open]
      intro x hxE₀
      obtain ⟨W, hW_open, hxW, hW_irred⟩ := hOpenIrred x
      refine ⟨W, ?_, hW_open, hxW⟩
      have hE₀_sub_cl : E₀ ⊆ closure W := by
        intro y hyE₀
        rw [mem_closure_iff]
        intro O hO hyO
        obtain ⟨z, _, hzO, hzW⟩ :=
          isIrreducible_irreducibleComponent.isPreirreducible O W hO hW_open
            ⟨y, hyE₀, hyO⟩ ⟨x, hxE₀, hxW⟩
        exact ⟨z, hzO, hzW⟩
      have hcl_sub_E₀ : closure W ⊆ E₀ :=
        (irreducibleComponent_mem_irreducibleComponents x₀).2 hW_irred.closure hE₀_sub_cl
      exact subset_closure.trans hcl_sub_E₀
    have hE₀_clopen : IsClopen E₀ := ⟨isClosed_irreducibleComponent, hE₀_open⟩
    have hE₀_univ : E₀ = Set.univ :=
      hE₀_clopen.eq_univ ⟨x₀, mem_irreducibleComponent⟩
    have _ : IrreducibleSpace ↥X := by
      rw [irreducibleSpace_def]
      change IsIrreducible Set.univ
      rw [← hE₀_univ]
      exact isIrreducible_irreducibleComponent
    have _ : ∀ x : ↥X, IsReduced ↑(X.presheaf.stalk x) := fun x => by
      have _ : IsDomain ↑(X.presheaf.stalk x) := hStalks x
      infer_instance
    have _ : AlgebraicGeometry.IsReduced X := AlgebraicGeometry.isReduced_of_isReduced_stalk X
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X

  exact ⟨hKrull, hEtPolyDom, hSmStalkDom, hIntOfStalkDom⟩

theorem weil_algClosed_etale_coord_swap_and_disc_factorization (k : Type u) [Field k] [IsAlgClosed k] :
    ((∀ (m : ℕ) (S : Type u) [CommRing S] [Algebra k S] (ε_S : S →+* k),
        ε_S.comp (algebraMap k S) = RingHom.id k →
        ∀ (ψ_sm : MvPolynomial (Fin (2 * m + 1)) k →+* S)
          (ψ_cone : (MvPolynomial (Fin (m + 1) × Fin 2) k ⧸ Ideal.span
            {∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)}) →+* S),
          ψ_sm.comp MvPolynomial.C = algebraMap k S →
          ψ_sm.Etale →
          ψ_cone.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap k S →
          ψ_cone.Etale →
          (∀ idx : Fin (m + 1) × Fin 2,
            ψ_cone (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ RingHom.ker ε_S) →
          False) ∧
      (∀ (p : MvPolynomial (Fin 2) k),
        MvPolynomial.eval (0 : Fin 2 → k) p = 0 →
        ∀ (S : Type u) [CommRing S] [Algebra k S] (ε_S : S →+* k),
          ε_S.comp (algebraMap k S) = RingHom.id k →
          ∀ (ψ_1 : MvPolynomial (Fin 1) k →+* S)
            (ψ_hyp : (MvPolynomial (Fin 2) k ⧸ Ideal.span {p}) →+* S),
            ψ_1.comp MvPolynomial.C = algebraMap k S →
            ψ_1.Etale →
            ψ_hyp.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap k S →
            ψ_hyp.Etale →
            (∀ b : Fin 2,
              ψ_hyp (Ideal.Quotient.mk _ (MvPolynomial.X b)) ∈ RingHom.ker ε_S) →
            MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv (0 : Fin 2) p) ≠ 0 ∨
              MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv (1 : Fin 2) p) ≠ 0)) ∧
    (∀ (R'_0 : Type u) [CommRing R'_0]
       (φ_0 : MvPolynomial (Fin 2) k →+* R'_0),
      φ_0.Etale →
      ∀ (ε_0 : R'_0 →+* k),
        (∀ P : MvPolynomial (Fin 2) k, ε_0 (φ_0 P) = MvPolynomial.eval (0 : Fin 2 → k) P) →
        ∀ (D_0 : Fin 2 → (R'_0 → R'_0)),
          (∀ (b : Fin 2) (x y : R'_0),
            D_0 b (x + y) = D_0 b x + D_0 b y ∧
            D_0 b (x * y) = x * D_0 b y + y * D_0 b x) →
          (∀ (b : Fin 2) (P : MvPolynomial (Fin 2) k),
            D_0 b (φ_0 P) = φ_0 (MvPolynomial.pderiv b P)) →
          ∀ (h_0 g_exc : R'_0),
            ε_0 h_0 = 0 →
            ε_0 g_exc ≠ 0 →
            (ε_0 (D_0 0 h_0) ≠ 0 ∨ ε_0 (D_0 1 h_0) ≠ 0) →
            ∀ (p_disc : MvPolynomial (Fin 2) k),
              MvPolynomial.eval (0 : Fin 2 → k) p_disc = 0 →
              (MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv (0 : Fin 2) p_disc) ≠ 0 ∨
                MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv (1 : Fin 2) p_disc) ≠ 0) →
              (∀ ε_u : R'_0 →+* k,
                ε_u.comp (φ_0.comp MvPolynomial.C) = RingHom.id k →
                ε_u g_exc ≠ 0 →
                ε_u h_0 = 0 →
                ε_u (φ_0 p_disc) = 0) →
              (MvPolynomial.eval (0 : Fin 2 → k) (MvPolynomial.pderiv (0 : Fin 2) p_disc) ≠ 0 →
                ε_0 (D_0 0 h_0) ≠ 0) ∧
              (∀ b_lead : Fin 2,
                ε_0 (D_0 b_lead h_0) ≠ 0 →
                ∃ g_match : R'_0,
                  ε_0 g_match ≠ 0 ∧
                  let R'_2 := Localization.Away (g_exc * g_match)
                  let ι_2 : R'_0 →+* R'_2 := algebraMap R'_0 R'_2
                  let ψ_B2 : MvPolynomial (Fin 2) k →+* R'_2 :=
                    MvPolynomial.eval₂Hom (ι_2.comp (φ_0.comp MvPolynomial.C))
                      ![ι_2 h_0, ι_2 (φ_0 (MvPolynomial.X (1 - b_lead)))]
                  ψ_B2.Etale ∧
                  ∀ u : PrimeSpectrum R'_2,
                    ι_2 (φ_0 p_disc) ∈ u.asIdeal ↔ ι_2 h_0 ∈ u.asIdeal)) :=
by
  
  have hEtaleDerEquiv : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra k A] [Algebra k S]
      (ψ : A →+* S) (hψ_alg : ψ.comp (algebraMap k A) = algebraMap k S) (hψ_et : ψ.Etale)
      (ε_S : S →+* k) (hε : ε_S.comp (algebraMap k S) = RingHom.id k),
      letI : Algebra S k := ε_S.toAlgebra
      letI : Algebra A k := (ε_S.comp ψ).toAlgebra
      Nonempty (Derivation k S k ≃ₗ[k] Derivation k A k) := by
    intro A S _ _ _ _ ψ hψ_alg hψ_et ε_S hε
    letI : Algebra A S := ψ.toAlgebra
    haveI : IsScalarTower k A S := IsScalarTower.of_algebraMap_eq' hψ_alg.symm
    haveI : Algebra.Etale A S := hψ_et.toAlgebra
    letI : Algebra S k := ε_S.toAlgebra
    letI : Algebra A k := (ε_S.comp ψ).toAlgebra
    haveI : IsScalarTower k S k := IsScalarTower.of_algebraMap_eq' hε.symm
    haveI : IsScalarTower A S k := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower k A k := IsScalarTower.of_algebraMap_eq' (by
      ext c
      change c = ε_S (ψ (algebraMap k A c))
      have h1 : ψ (algebraMap k A c) = algebraMap k S c := RingHom.congr_fun hψ_alg c
      rw [h1]
      exact (RingHom.congr_fun hε c).symm)
    let e1 : Derivation k S k ≃ₗ[k] (Ω[S⁄k] →ₗ[S] k) :=
      (KaehlerDifferential.linearMapEquivDerivation k S (M := k)).symm.restrictScalars k
    let e2 : (TensorProduct A S Ω[A⁄k] →ₗ[S] k) ≃ₗ[k] (Ω[S⁄k] →ₗ[S] k) :=
      LinearEquiv.congrLeft k k (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k A S)
    let e3 : (Ω[A⁄k] →ₗ[A] k) ≃ₗ[k] (TensorProduct A S Ω[A⁄k] →ₗ[S] k) :=
      (LinearMap.liftBaseChangeEquiv S (R := A) (M := Ω[A⁄k]) (N := k)).restrictScalars k
    let e4 : (Ω[A⁄k] →ₗ[A] k) ≃ₗ[k] Derivation k A k :=
      (KaehlerDifferential.linearMapEquivDerivation k A (M := k)).restrictScalars k
    exact ⟨e1.trans (e2.symm.trans (e3.symm.trans e4))⟩

  
  have hMvPolyDerEquiv : ∀ (σ : Type) (ε_P : MvPolynomial σ k →+* k)
      (hε_P : ε_P.comp MvPolynomial.C = RingHom.id k),
      letI : Algebra (MvPolynomial σ k) k := ε_P.toAlgebra
      Nonempty (Derivation k (MvPolynomial σ k) k ≃ₗ[k] (σ → k)) := by
    intro σ ε_P hε_P
    letI : Algebra (MvPolynomial σ k) k := ε_P.toAlgebra
    haveI : IsScalarTower k (MvPolynomial σ k) k := IsScalarTower.of_algebraMap_eq' hε_P.symm
    refine ⟨{
      toFun := fun D i => D (MvPolynomial.X i)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      invFun := MvPolynomial.mkDerivation k
      left_inv := fun D => MvPolynomial.derivation_ext fun i =>
        MvPolynomial.mkDerivation_X k (fun j => D (MvPolynomial.X j)) i
      right_inv := fun f => funext fun i => MvPolynomial.mkDerivation_X k f i }⟩

  
  have hQuotDerEquiv : ∀ (σ : Type) (F : MvPolynomial σ k)
      (ε_Q : (MvPolynomial σ k ⧸ Ideal.span ({F} : Set (MvPolynomial σ k))) →+* k)
      (hε_Q : ε_Q.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = RingHom.id k),
      let I := Ideal.span ({F} : Set (MvPolynomial σ k))
      let ε_P : MvPolynomial σ k →+* k := ε_Q.comp (Ideal.Quotient.mk I)
      (letI : Algebra (MvPolynomial σ k) k := ε_P.toAlgebra
       ∀ D : Derivation k (MvPolynomial σ k) k, D F = 0) →
      letI : Algebra (MvPolynomial σ k ⧸ I) k := ε_Q.toAlgebra
      Nonempty (Derivation k (MvPolynomial σ k ⧸ I) k ≃ₗ[k] (σ → k)) := by
    intro σ F ε_Q hε_Q I ε_P hDF
    let A_Q := MvPolynomial σ k ⧸ I
    letI : Algebra A_Q k := ε_Q.toAlgebra
    letI : Algebra (MvPolynomial σ k) k := ε_P.toAlgebra
    have hεP_C : ε_P.comp MvPolynomial.C = RingHom.id k := by
      ext c
      exact RingHom.congr_fun hε_Q c
    have hεP_F : ε_P F = 0 := by
      change ε_Q (Ideal.Quotient.mk I F) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self F), map_zero]
    let pullD : Derivation k A_Q k → Derivation k (MvPolynomial σ k) k := fun D_Q =>
      { toLinearMap := D_Q.toLinearMap.comp (Ideal.Quotient.mkₐ k I).toLinearMap
        map_one_eq_zero' := by
          change D_Q (Ideal.Quotient.mk I 1) = 0
          rw [map_one, D_Q.map_one_eq_zero]
        leibniz' := fun P Q => by
          change D_Q (Ideal.Quotient.mk I (P * Q)) =
            P • D_Q (Ideal.Quotient.mk I Q) + Q • D_Q (Ideal.Quotient.mk I P)
          rw [map_mul, D_Q.leibniz]
          rfl }
    have hI_zero : ∀ (D : Derivation k (MvPolynomial σ k) k), ∀ x ∈ I, D x = 0 := by
      intro D x hx
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hx
      rw [D.leibniz, hDF D, smul_zero, add_zero]
      change ε_P F * D r = 0
      rw [hεP_F, zero_mul]
    let pushD : Derivation k (MvPolynomial σ k) k → Derivation k A_Q k := fun D =>
      let f_quot : A_Q → k := fun q =>
        Quotient.liftOn' q D fun a b hab => by
          have hsub : a - b ∈ I := (Submodule.quotientRel_def I).mp hab
          have h0 : D (a - b) = 0 := hI_zero D (a - b) hsub
          rw [map_sub, sub_eq_zero] at h0
          exact h0
      { toLinearMap :=
          { toFun := f_quot
            map_add' := fun x y => by
              induction x using Quotient.inductionOn'
              induction y using Quotient.inductionOn'
              exact D.map_add _ _
            map_smul' := fun c x => by
              induction x using Quotient.inductionOn'
              exact D.map_smul c _ }
        map_one_eq_zero' := D.map_one_eq_zero
        leibniz' := fun x y => by
          induction x using Quotient.inductionOn'
          induction y using Quotient.inductionOn'
          exact D.leibniz _ _ }
    let e_QP : Derivation k A_Q k ≃ₗ[k] Derivation k (MvPolynomial σ k) k :=
      { toFun := pullD
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        invFun := pushD
        left_inv := fun D_Q => by
          ext q
          induction q using Quotient.inductionOn'
          rfl
        right_inv := fun D => by
          ext P
          rfl }
    obtain ⟨e_P⟩ := hMvPolyDerEquiv σ ε_P hεP_C
    exact ⟨e_QP.trans e_P⟩

  
  have hCoordSwap : ∀ (R'_0 : Type u) [CommRing R'_0]
      (φ_0 : MvPolynomial (Fin 2) k →+* R'_0) (hφ_0_et : φ_0.Etale)
      (D_0 : Fin 2 → (R'_0 → R'_0))
      (hD_lin : ∀ (b : Fin 2) (x y : R'_0),
        D_0 b (x + y) = D_0 b x + D_0 b y ∧ D_0 b (x * y) = x * D_0 b y + y * D_0 b x)
      (hD_φ : ∀ (b : Fin 2) (P : MvPolynomial (Fin 2) k),
        D_0 b (φ_0 P) = φ_0 (MvPolynomial.pderiv b P))
      (h_0 : R'_0) (b : Fin 2) (g_tot y : R'_0) (hg_tot : g_tot = D_0 b h_0 * y),
      let R_loc := Localization.Away g_tot
      let ι : R'_0 →+* R_loc := algebraMap R'_0 R_loc
      let ψ : MvPolynomial (Fin 2) k →+* R_loc :=
        MvPolynomial.eval₂Hom (ι.comp (φ_0.comp MvPolynomial.C))
          ![ι h_0, ι (φ_0 (MvPolynomial.X (1 - b)))]
      let A_quot := R_loc ⧸ Ideal.span ({ι h_0} : Set R_loc)
      letI : Algebra k A_quot :=
        ((Ideal.Quotient.mk (Ideal.span ({ι h_0} : Set R_loc))).comp
          (ι.comp (φ_0.comp MvPolynomial.C))).toAlgebra
      ψ.Etale ∧ IsReduced A_quot ∧ Algebra.FiniteType k A_quot := by
    intro R'_0 _ φ_0 hφ_0_et D_0 hD_lin hD_φ h_0 b g_tot y hg_tot R_loc ι ψ A_quot
    have hψ_et : ψ.Etale := by
      letI : Algebra k R'_0 := (φ_0.comp MvPolynomial.C).toAlgebra
      have hD_C : ∀ (j : Fin 2) (c : k), D_0 j (algebraMap k R'_0 c) = 0 := by
        intro j c
        change D_0 j (φ_0 (MvPolynomial.C c)) = 0
        rw [hD_φ, MvPolynomial.pderiv_C, map_zero]
      let der_0 : Fin 2 → Derivation k R'_0 R'_0 := fun j =>
        { toLinearMap :=
            { toFun := D_0 j
              map_add' := fun x₁ x₂ => (hD_lin j x₁ x₂).1
              map_smul' := fun c x => by
                simp only [Algebra.smul_def, RingHom.id_apply]
                rw [(hD_lin j _ _).2, hD_C j c, mul_zero, add_zero] }
          map_one_eq_zero' := by
            change D_0 j 1 = 0
            have h1 : (1 : R'_0) = algebraMap k R'_0 1 := (map_one _).symm
            rw [h1, hD_C j 1]
          leibniz' := fun x₁ x₂ => by
            simp only [smul_eq_mul]
            exact (hD_lin j x₁ x₂).2 }
      let z_b : Fin 2 → R'_0 := ![h_0, φ_0 (MvPolynomial.X (1 - b))]
      let Δ_b : R'_0 := Matrix.det (Matrix.of fun i j : Fin 2 => der_0 j (z_b i))
      have hψ_Δ_et : (MvPolynomial.eval₂Hom
          ((algebraMap R'_0 (Localization.Away Δ_b)).comp (algebraMap k R'_0))
          (fun i : Fin 2 => algebraMap R'_0 (Localization.Away Δ_b) (z_b i))).Etale :=
        (weil_ring_etale_derivation_and_submersive_jacobian k 2 R'_0 φ_0 rfl hφ_0_et).2.1
          der_0 (fun i f => hD_φ i f) z_b
      let y' : R'_0 := if b = 0 then y else -y
      have hΔ_mul : Δ_b * y' = g_tot := by
        rw [hg_tot]
        dsimp [Δ_b, z_b, der_0, y']
        rw [Matrix.det_fin_two]
        fin_cases b
        · simp [hD_φ, MvPolynomial.pderiv_X]
        · simp [hD_φ, MvPolynomial.pderiv_X]
      let S_Δ := Localization.Away Δ_b
      let T_loc := Localization.Away (algebraMap R'_0 S_Δ y')
      haveI : Algebra.Etale S_Δ T_loc :=
        Algebra.Etale.of_isLocalizationAway (algebraMap R'_0 S_Δ y')
      have hST_et : (algebraMap S_Δ T_loc).Etale := RingHom.etale_algebraMap.mpr inferInstance
      haveI : IsLocalization.Away (Δ_b * y') T_loc :=
        IsLocalization.Away.mul' S_Δ T_loc Δ_b y'
      haveI : IsLocalization.Away g_tot T_loc := by
        rwa [← hΔ_mul]
      let e_loc : T_loc ≃ₐ[R'_0] R_loc :=
        IsLocalization.algEquiv (Submonoid.powers g_tot) T_loc R_loc
      have he_loc_et : e_loc.toRingHom.Etale := RingHom.Etale.of_bijective e_loc.bijective
      have hcomp_et : (e_loc.toRingHom.comp ((algebraMap S_Δ T_loc).comp
          (MvPolynomial.eval₂Hom ((algebraMap R'_0 S_Δ).comp (algebraMap k R'_0))
            (fun i : Fin 2 => algebraMap R'_0 S_Δ (z_b i))))).Etale :=
        RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _ hψ_Δ_et hST_et) he_loc_et
      have hψ_eq : ψ = e_loc.toRingHom.comp ((algebraMap S_Δ T_loc).comp
          (MvPolynomial.eval₂Hom ((algebraMap R'_0 S_Δ).comp (algebraMap k R'_0))
            (fun i : Fin 2 => algebraMap R'_0 S_Δ (z_b i)))) := by
        apply MvPolynomial.ringHom_ext'
