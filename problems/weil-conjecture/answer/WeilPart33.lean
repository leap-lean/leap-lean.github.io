      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : R₁ →+* Polynomial R₁))
    let y_σ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)).base pt₀
    let Ω_σ := AlgebraicClosure ↥(B₁.residueField y_σ)
    let ev_σ : R₁ →+* Ω_σ := ψ_Ω.toRingHom.comp σ.toRingHom
    let P_ℱ₀ : CategoryTheory.Functor (Opposite B₁.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilAltCdSitePullback p₁).op
        (CategoryTheory.Sheaf.cohomologyPresheaf ℱ₀ b)
    let u_Ω : B_κ →+* Ω_σ := ψ_Ω.toRingHom.comp u_κ
    have hu_Ω_ev : u_Ω.comp g_R₁ = ev_σ :=
      RingHom.ext fun x => congrArg ψ_Ω (DFunLike.congr_fun hu_comp x)
    obtain ⟨Ξ, hΞ_iff⟩ := h_s8 R₁ ℱ₀ B_κ g_R₁ hg_et
    let s_B := Ξ.symm ξ_id
    obtain ⟨C'_κ, hRingC, g_κ, u'_Ω, hg_κ, hf_C, hu'_Ω, hP_zero⟩ :=
      (h_s7 R₁ P_ℱ₀ y_σ ev_σ hψ_gy).mp (hStalk pt₀) B_κ g_R₁ u_Ω hg_et hu_Ω_ev s_B
    letI : CommRing C'_κ := hRingC
    let u'_κ : C'_κ →+* κ := ψ_Ω.symm.toRingHom.comp u'_Ω
    have hu'_κ_comp : u'_κ.comp g_κ = u_κ := by
      ext x
      dsimp [u'_κ]
      have hx := congrArg ψ_Ω.symm (DFunLike.congr_fun hu'_Ω x)
      dsimp [u_Ω] at hx
      exact hx.trans (ψ_Ω.symm_apply_apply (u_κ x))
    have hMapsTo_sB := (hΞ_iff C'_κ g_κ hg_κ hf_C s_B).mp hP_zero
    dsimp only [s_B] at hMapsTo_sB
    rw [Ξ.apply_symm_apply] at hMapsTo_sB
    exact ⟨C'_κ, hRingC, g_κ, u'_κ, hg_κ, hu'_κ_comp, hMapsTo_sB⟩

theorem weil_aff_cd_morphism_leray_syzygy_vanishing {X B : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X B)
    [hCont : (weilAltCdSitePullback f).IsContinuous B.smallEtaleTopology X.smallEtaleTopology]
    (ℓ : ℕ)
    (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_ℱ : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0) :
    let P_push := (weilAltCdSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
      B.smallEtaleTopology X.smallEtaleTopology
    (∀ b : ℕ, ℓ • CategoryTheory.CategoryStruct.id (weilAltCdHigherDirectImage f b ℱ) = 0) ∧
    (∀ [P_push.Additive] (q : ℕ), 1 ≤ q →
      (∀ (I : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Injective I → CategoryTheory.Injective (P_push.obj I)) →
      (∃ (e₀ : ∀ (M : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          (P_push.obj M).H 0 ≃+ M.H 0),
        ∀ {M₁ M₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom M₁ M₂) (z : (P_push.obj M₁).H 0),
          e₀ M₂ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map φ)) (Nat.add_zero 0)) =
            (e₀ M₁ z).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) →
      (∀ (W I Q : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective I]
        (j : Quiver.Hom W I) (p : Quiver.Hom I Q)
        (hjp : CategoryTheory.CategoryStruct.comp j p = 0),
        (CategoryTheory.ShortComplex.mk j p hjp).ShortExact →
        (∀ (r : ℕ), 1 ≤ r →
          Nonempty (weilAltCdHigherDirectImage f r Q ≅
            weilAltCdHigherDirectImage f (r + 1) W)) ∧
        ∃ (ℬ : CategoryTheory.Sheaf B.smallEtaleTopology AddCommGrpCat.{u})
          (π_B : Quiver.Hom (P_push.obj I) ℬ)
          (ι_B : Quiver.Hom ℬ (P_push.obj Q))
          (δ_B : Quiver.Hom (P_push.obj Q) (weilAltCdHigherDirectImage f 1 W))
          (h₁ : CategoryTheory.CategoryStruct.comp (P_push.map j) π_B = 0)
          (h₂ : CategoryTheory.CategoryStruct.comp ι_B δ_B = 0),
          CategoryTheory.CategoryStruct.comp π_B ι_B = P_push.map p ∧
          (CategoryTheory.ShortComplex.mk (P_push.map j) π_B h₁).ShortExact ∧
          (CategoryTheory.ShortComplex.mk ι_B δ_B h₂).ShortExact) →
      Subsingleton ((P_push.obj ℱ).H q) →
      (∀ (b : ℕ), 1 ≤ b → b ≤ q →
        Subsingleton ((weilAltCdHigherDirectImage f b ℱ).H (q - b))) →
      Subsingleton (ℱ.H q)) :=
by
  intro P_push
  refine ⟨?_, ?_⟩
  · intro b
    have hmk₀_nsmul : ∀ (n : ℕ) (g : Quiver.Hom ℱ ℱ),
        CategoryTheory.Abelian.Ext.mk₀ (n • g) = n • CategoryTheory.Abelian.Ext.mk₀ g := by
      intro n g
      induction n with
      | zero => rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero]
      | succ n ih => rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih]
    have hPre0 : ℓ • CategoryTheory.CategoryStruct.id (ℱ.cohomologyPresheaf b) = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
        CategoryTheory.NatTrans.app_zero]
      change (ℓ • CategoryTheory.CategoryStruct.id ((ℱ.cohomologyPresheaf b).obj U)).hom x =
        (0 : (ℱ.cohomologyPresheaf b).obj U ⟶ (ℱ.cohomologyPresheaf b).obj U).hom x
      rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero]
