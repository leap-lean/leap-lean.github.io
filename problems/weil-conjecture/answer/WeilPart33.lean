    have h_ker_ev_slice : ∀ P ∈ I_slice, ev_slice P = 0 := by
      have hle : I_slice ≤ RingHom.ker ev_slice := Ideal.span_le.mpr fun _ ⟨i, hEq⟩ => by
        subst hEq
        rw [SetLike.mem_coe, RingHom.mem_ker]
        by_cases hi : i = i_0
        · subst hi
