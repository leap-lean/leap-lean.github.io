        f₁₂ ≫ φ₂ = φ₁ ≫ g₁₂ →
        f₂₃ ≫ φ₃ = φ₂ ≫ g₂₃ →
        f₃₄ ≫ φ₄ = φ₃ ≫ g₃₄ →
        CategoryTheory.Epi φ₀ →
        CategoryTheory.IsIso φ₁ →
        CategoryTheory.IsIso φ₃ →
        CategoryTheory.Mono φ₄ →
        CategoryTheory.IsIso φ₂) ∧
    (∀ {A B : 𝒞}, CategoryTheory.Limits.IsZero A → CategoryTheory.Limits.IsZero B →
      ∀ (φ : A ⟶ B), CategoryTheory.IsIso φ) ∧
    (∀ (F : 𝒞) (ℓ m' : ℕ),
      (ℓ * m') • CategoryTheory.CategoryStruct.id F = 0 →
      let μ_ℓ : F ⟶ F := ℓ • CategoryTheory.CategoryStruct.id F
