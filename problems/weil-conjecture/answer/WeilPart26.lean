    obtain ⟨hFinCoh, -, -, hCard2⟩ := hCurveCoh C_z_ov hInt_Cz hProj_Cz
    have : Finite (weilEtaleTorsionH C_z ℓ 2) := hFinCoh 2
    let eqv_z := trf C_z_ov Z_b_ov ν_z U_z _ e_W_z he_W_z 2
    let eqv_full :
        weilEtaleLocalTorsionH Z_b_ov.left ℓ _ 2 ≃+ weilEtaleTorsionH C_z ℓ 2 :=
      eqv_z.trans (AddEquiv.ofBijective _ hCounitBij)
    have hFin_loc : Finite (weilEtaleLocalTorsionH Z_b_ov.left ℓ _ 2) :=
      Finite.of_equiv _ eqv_full.symm.toEquiv
    have hCard_loc : Nat.card (weilEtaleLocalTorsionH Z_b_ov.left ℓ _ 2) = ℓ :=
      (Nat.card_congr eqv_full.toEquiv).trans hCard2
    refine ⟨hFin_loc, hCard_loc, ?_⟩
    intro p_z hp_z h_zero

    
    let τ_ιC_left : ((weilEtaleSitePullback ι_C).obj W_Y₂_et).left ⟶ U_z.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_z.ι
        (CategoryTheory.Limits.pullback.snd W_Y₂_open.ι ι_C)
        (by
          rintro _ ⟨w, rfl⟩
          have hw_eq : W_Y₂_open.ι.base
              ((CategoryTheory.Limits.pullback.fst W_Y₂_open.ι ι_C).base w) =
              ι_C.base ((CategoryTheory.Limits.pullback.snd W_Y₂_open.ι ι_C).base w) :=
            congrArg (fun g => g.base w)
              (CategoryTheory.Limits.pullback.condition (f := W_Y₂_open.ι) (g := ι_C))
          have hmem : (CategoryTheory.Limits.pullback.snd W_Y₂_open.ι ι_C).base w ∈ U_z := by
            change ι_C.base _ ∈ (W_Y₂_open : Set ↥Y_V₂)
            rw [← hw_eq]
            exact ((CategoryTheory.Limits.pullback.fst W_Y₂_open.ι ι_C).base w).2
          exact ⟨⟨(CategoryTheory.Limits.pullback.snd W_Y₂_open.ι ι_C).base w, hmem⟩, rfl⟩)
    let τ_ιC : (weilEtaleSitePullback ι_C).obj W_Y₂_et ⟶ U_z_et :=
      CategoryTheory.MorphismProperty.Over.homMk τ_ιC_left
        (AlgebraicGeometry.IsOpenImmersion.lift_fac U_z.ι _ _) trivial
    obtain ⟨p_ιC, hp_ιC, -⟩ := hLocPullEx ι_C U_z_et W_Y₂_et τ_ιC 2

    let ι_Cv : C_z ⟶ P.Y := CategoryTheory.CategoryStruct.comp ι_C fst₂
    let τ_Cv_left : ((weilEtaleSitePullback ι_Cv).obj W_P_et).left ⟶ U_z.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_z.ι
        (CategoryTheory.Limits.pullback.snd P.W_open.ι ι_Cv)
        (by
          rintro _ ⟨w, rfl⟩
          have hw_eq : P.W_open.ι.base
              ((CategoryTheory.Limits.pullback.fst P.W_open.ι ι_Cv).base w) =
              ι_Cv.base ((CategoryTheory.Limits.pullback.snd P.W_open.ι ι_Cv).base w) :=
            congrArg (fun g => g.base w)
              (CategoryTheory.Limits.pullback.condition (f := P.W_open.ι) (g := ι_Cv))
          have hmem : (CategoryTheory.Limits.pullback.snd P.W_open.ι ι_Cv).base w ∈ U_z := by
            change fst₂.base (ι_C.base _) ∈ (P.W_open : Set ↥P.Y)
            change ι_Cv.base _ ∈ (P.W_open : Set ↥P.Y)
            rw [← hw_eq]
            exact ((CategoryTheory.Limits.pullback.fst P.W_open.ι ι_Cv).base w).2
          exact ⟨⟨(CategoryTheory.Limits.pullback.snd P.W_open.ι ι_Cv).base w, hmem⟩, rfl⟩)
    let τ_Cv : (weilEtaleSitePullback ι_Cv).obj W_P_et ⟶ U_z_et :=
      CategoryTheory.MorphismProperty.Over.homMk τ_Cv_left
        (AlgebraicGeometry.IsOpenImmersion.lift_fac U_z.ι _ _) trivial
    obtain ⟨p_Cv, hp_Cv, -⟩ := hLocPullEx ι_Cv U_z_et W_P_et τ_Cv 2
    obtain ⟨φ_Cv, hφ_Cv⟩ := hTorPullEx ι_Cv

    
    have htrf_eq : eqv_z (p_z η₂) = p_ιC (trf_ν₂ η₂) :=
      htrf_nat Y_V₂_ov Z_V₂_ov C_z_ov Z_b_ov ν₂_ov ν_z ι_C _ hpb_z
        W_Y₂_open U_z rfl W₂_diag _ e_W₂ he_W₂_diag e_W_z he_W_z
        (CategoryTheory.CategoryStruct.id _) τ_ιC 2 p_z p_ιC hCompat_z hp_z hp_ιC η₂
    have htrf_symm : trf_ν₂ η₂ = p_fst₂ η_kum := trf_ν₂.apply_symm_apply (p_fst₂ η_kum)

    
    let Fgt_Cz := AlgebraicGeometry.Scheme.Etale.forget C_z
    let Fgt_YV₂ := AlgebraicGeometry.Scheme.Etale.forget Y_V₂
    let Fgt_PY := AlgebraicGeometry.Scheme.Etale.forget P.Y
    let B_ιC := weilEtaleSitePullback ι_C
    let B_fst₂ := weilEtaleSitePullback fst₂
    let c₁₂ : (Fgt_Cz.obj (B_ιC.obj (B_fst₂.obj W_P_et))).left ⟶
        (Fgt_Cz.obj ((weilEtaleSitePullback ι_Cv).obj W_P_et)).left :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (Fgt_YV₂.obj (B_fst₂.obj W_P_et)).hom ι_C ≫
          CategoryTheory.Limits.pullback.fst (Fgt_PY.obj W_P_et).hom fst₂)
        (CategoryTheory.Limits.pullback.snd (Fgt_YV₂.obj (B_fst₂.obj W_P_et)).hom ι_C)
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·)
            (CategoryTheory.Limits.pullback.condition
              (f := (Fgt_PY.obj W_P_et).hom) (g := fst₂))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ fst₂)
                (CategoryTheory.Limits.pullback.condition
                  (f := (Fgt_YV₂.obj (B_fst₂.obj W_P_et)).hom) (g := ι_C))).trans
                (CategoryTheory.Category.assoc _ _ _)))))
    have hc₁₂_τ :
        CategoryTheory.CategoryStruct.comp c₁₂ ((Fgt_Cz.map τ_Cv).left) =
          CategoryTheory.CategoryStruct.comp
            ((Fgt_Cz.map (B_ιC.map τ_fst₂)).left) ((Fgt_Cz.map τ_ιC).left) := by
      apply (cancel_mono U_z.ι).mp
      have hL : (c₁₂ ≫ (Fgt_Cz.map τ_Cv).left) ≫ U_z.ι =
          CategoryTheory.Limits.pullback.snd (Fgt_YV₂.obj (B_fst₂.obj W_P_et)).hom ι_C :=
        (CategoryTheory.Category.assoc c₁₂ _ U_z.ι).trans
          ((congrArg (c₁₂ ≫ ·) (CategoryTheory.Over.w (Fgt_Cz.map τ_Cv))).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      have hR : (((Fgt_Cz.map (B_ιC.map τ_fst₂)).left) ≫ (Fgt_Cz.map τ_ιC).left) ≫ U_z.ι =
          CategoryTheory.Limits.pullback.snd (Fgt_YV₂.obj (B_fst₂.obj W_P_et)).hom ι_C :=
        (CategoryTheory.Category.assoc _ _ U_z.ι).trans
          ((congrArg (_ ≫ ·) (CategoryTheory.Over.w (Fgt_Cz.map τ_ιC))).trans
            (CategoryTheory.Over.w (Fgt_Cz.map (B_ιC.map τ_fst₂))))
      exact hL.trans hR.symm
    have hp_comp : p_Cv = p_ιC.comp p_fst₂ :=
      hLocPullComp ι_C fst₂ U_z_et W_Y₂_et W_P_et τ_ιC τ_fst₂ τ_Cv p_ιC p_fst₂ p_Cv
        c₁₂ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) hc₁₂_τ hp_ιC hp_fst₂ hp_Cv
    have hcounit_eq :
        weilEtaleLocalTorsionCounitH C_z ℓ U_z_et 2 (p_Cv η_kum) = φ_Cv α_P := by
      have hc : weilEtaleLocalTorsionCounitH C_z ℓ U_z_et 2 (p_Cv η_kum) =
          φ_Cv (weilEtaleLocalTorsionCounitH P.Y ℓ W_P_et 2 η_kum) :=
        DFunLike.congr_fun
          (hLocPullCounit ι_Cv U_z_et W_P_et τ_Cv p_Cv φ_Cv hp_Cv hφ_Cv) η_kum
      exact hc.trans (congrArg φ_Cv hη_kum)
    have hφ_Cv_zero : φ_Cv α_P = 0 := by
      have h1 : p_Cv η_kum = p_ιC (p_fst₂ η_kum) :=
        congrArg (fun f => f η_kum) hp_comp
      have h2 : p_Cv η_kum = eqv_z 0 :=
        h1.trans ((congrArg p_ιC htrf_symm.symm).trans
          (htrf_eq.symm.trans (congrArg eqv_z h_zero)))
      have h3 : p_Cv η_kum = 0 := h2.trans (map_zero eqv_z)
      exact hcounit_eq.symm.trans
        ((congrArg (weilEtaleLocalTorsionCounitH C_z ℓ U_z_et 2) h3).trans
          (map_zero (weilEtaleLocalTorsionCounitH C_z ℓ U_z_et 2)))

    
    let s_v : S_k ⟶ (Fgt_V.obj P.V).left := s_z ≫ (Fgt_V.map h₂).left
    have hs_v_sec : s_v ≫ ((Fgt_V.obj P.V).hom ≫ E.V_bar.hom) = 𝟙 S_k :=
      (CategoryTheory.Category.assoc s_z (Fgt_V.map h₂).left _).trans
        ((congrArg (s_z ≫ ·)
          ((CategoryTheory.Category.assoc (Fgt_V.map h₂).left _ _).symm.trans
            (congrArg (· ≫ E.V_bar.hom) (CategoryTheory.Over.w (Fgt_V.map h₂))))).trans hs_z)
    have hpb_Cv : CategoryTheory.IsPullback ι_Cv C_z_ov.hom P.f_bar s_v :=
      (CategoryTheory.IsPullback.of_hasPullback f₂ s_z).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback P.f_bar ((Fgt_V.map h₂).left))
    let τ_int_Y : (Fgt_V.obj P.V).left ⟶ P.Y := τ_int ≫ P.W_open.ι
    let s_P : S_k ⟶ C_z :=
      hpb_Cv.lift (s_v ≫ τ_int_Y) (𝟙 S_k)
        ((CategoryTheory.Category.assoc s_v τ_int_Y P.f_bar).trans
          ((congrArg (s_v ≫ ·)
            ((CategoryTheory.Category.assoc τ_int P.W_open.ι P.f_bar).trans hSec₁.1)).trans
            ((CategoryTheory.Category.comp_id s_v).trans
              (CategoryTheory.Category.id_comp s_v).symm)))
    let P_pt : ↥C_z := s_P.base pt_k
    have hs_P_fst : s_P ≫ ι_Cv = s_v ≫ τ_int_Y := hpb_Cv.lift_fst _ _ _
    have hs_P_sec : s_P ≫ C_z_ov.hom = 𝟙 S_k := hpb_Cv.lift_snd _ _ _
    have : AlgebraicGeometry.IsProper C_z_ov.hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Cv P.hProp_f
    have : AlgebraicGeometry.IsClosedImmersion (s_P ≫ C_z_ov.hom) := by
      rw [hs_P_sec]; infer_instance
    have : AlgebraicGeometry.IsClosedImmersion s_P :=
      AlgebraicGeometry.IsClosedImmersion.of_comp s_P C_z_ov.hom
    have hrange_sP : Set.range s_P.base = ({P_pt} : Set ↥C_z) := by
      ext y
      simp only [Set.mem_range, Set.mem_singleton_iff]
      refine ⟨fun ⟨q, hq⟩ => ?_, fun hy => ⟨pt_k, hy.symm⟩⟩
      rw [hSub_k.elim q pt_k] at hq
      exact hq.symm
    have hP_cl : IsClosed ({P_pt} : Set ↥C_z) := by
      rw [← hrange_sP]
      exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding s_P).isClosed_range
    have : AlgebraicGeometry.IsClosedImmersion (s_v ≫ p_k_PV) := by
      rw [hs_v_sec]; infer_instance
    have hCl_sv : AlgebraicGeometry.IsClosedImmersion s_v :=
      AlgebraicGeometry.IsClosedImmersion.of_comp s_v p_k_PV
    have : AlgebraicGeometry.IsClosedImmersion ι_Cv :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_Cv.flip hCl_sv
    have hInj_ιCv : Function.Injective ι_Cv.base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_Cv).injective
    have hU₂_Cz : ((TopologicalSpace.Opens.map ι_Cv.base).obj U₂ : Set ↥C_z) =
        ({P_pt} : Set ↥C_z)ᶜ := by
      rw [← hrange_sP]
      ext y
      change ι_Cv.base y ∈ (U₂ : Set ↥P.Y) ↔ y ∉ Set.range s_P.base
      rw [hSec₂.2.1, Set.mem_compl_iff]
      apply not_congr
      simp only [Set.mem_range]
      refine ⟨?_, ?_⟩
      · rintro ⟨v_p, hv_p⟩
        have hv_sec : (τ_int ≫ P.W_open.ι ≫ P.f_bar).base v_p = v_p := by
          rw [hSec₁.1]
          rfl
        have hv_eq : v_p = s_v.base (C_z_ov.hom.base y) := by
          calc
            v_p = P.f_bar.base (τ_int_Y.base v_p) := hv_sec.symm
            _ = P.f_bar.base (ι_Cv.base y) := congrArg P.f_bar.base hv_p
            _ = (ι_Cv ≫ P.f_bar).base y := rfl
            _ = (C_z_ov.hom ≫ s_v).base y :=
                  congrArg (fun g : AlgebraicGeometry.Scheme.Hom _ _ => g.base y) hpb_Cv.w
            _ = s_v.base (C_z_ov.hom.base y) := rfl
        refine ⟨C_z_ov.hom.base y, hInj_ιCv ?_⟩
        exact (congrArg (fun g : AlgebraicGeometry.Scheme.Hom S_k P.Y => g.base (C_z_ov.hom.base y))
          hs_P_fst).trans
          ((congrArg τ_int_Y.base hv_eq.symm).trans hv_p)
      · rintro ⟨q, rfl⟩
        refine ⟨s_v.base q, ?_⟩
        exact (congrArg (fun g : AlgebraicGeometry.Scheme.Hom S_k P.Y => g.base q) hs_P_fst).symm
    have hP_mem : P_pt ∈ (TopologicalSpace.Opens.map ι_Cv.base).obj U₁ := by
      have hcov_pt : ι_Cv.base P_pt ∈ (U₁ ⊔ U₂ : P.Y.Opens) := by
        rw [hSec₂.2.2.1]; trivial
      rcases hcov_pt with h1 | h2
      · exact h1
      · exfalso
        have h2' : P_pt ∈ ((TopologicalSpace.Opens.map ι_Cv.base).obj U₂ : Set ↥C_z) := h2
        rw [hU₂_Cz, Set.mem_compl_iff, Set.mem_singleton_iff] at h2'
        exact h2' rfl
    have hP_img : ι_Cv.base P_pt = τ_int_Y.base (s_v.base pt_k) :=
      congrArg (fun g : AlgebraicGeometry.Scheme.Hom S_k P.Y => g.base pt_k) hs_P_fst
    have hSpan := hSec₂.2.2.2.2 s_v pt_k C_z_ov ι_Cv P_pt hP_mem hs_v_sec hpb_Cv hP_img
    have hι_Cv_k : ι_Cv ≫ p_k_PY = C_z_ov.hom :=
      (CategoryTheory.Category.assoc ι_Cv P.f_bar p_k_PV).symm.trans
        ((congrArg (· ≫ p_k_PV) hpb_Cv.w).trans
          ((CategoryTheory.Category.assoc C_z_ov.hom s_v p_k_PV).trans
            ((congrArg (C_z_ov.hom ≫ ·) hs_v_sec).trans
              (CategoryTheory.Category.comp_id C_z_ov.hom))))
    exact hα_nonvan C_z_ov hInt_Cz hProj_Cz ι_Cv hι_Cv_k φ_Cv hφ_Cv
      P_pt hP_cl hP_mem g_sec hSec₂.2.2.2.1 hU₂_Cz hSpan hφ_Cv_zero

  
  obtain ⟨Φ₂, Φ', hComm_Φ, hStalkBij⟩ :=
    hClopenR2 V₂ V' w₁ W₂ W'₂ w_tilde₁ f_W₂ hComm_W₂ f_W'₂ hPb_W'₂ η₂ hη₂_fib
  have hIso_Φ₂ : CategoryTheory.IsIso Φ₂ := by
    apply hIsoCons E.V_bar Φ₂
    intro s_b hs_b
    obtain ⟨hCont, hAdj, hBij₂, -⟩ := hStalkBij s_b hs_b
    exact ⟨hCont, hAdj, hBij₂⟩
  have hIso_Φ' : CategoryTheory.IsIso Φ' := by
    apply hIsoCons E.V_bar Φ'
    intro s_b hs_b
    obtain ⟨hCont, hAdj, -, hBij'⟩ := hStalkBij s_b hs_b
    exact ⟨hCont, hAdj, hBij'⟩
  have : CategoryTheory.IsIso Φ₂ := hIso_Φ₂
  have : CategoryTheory.IsIso Φ' := hIso_Φ'
  exact ⟨W'₂, w_tilde₁, x'₂, CategoryTheory.asIso Φ', CategoryTheory.asIso Φ₂,
    hAff_W'₂, hx'₂_cl, hx'₂_map, hR0_W'₂, hR0_W₂, hR0_W₁, hR3_all, hComm_Φ⟩

theorem weil_etale_elementary_fibration_r1_effacement (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hProjCurveNonDeg :
      ∀ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral C_bar.left →
        IsProjectiveOverField k C_bar →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom],
          Finite (weilCupPDModH C_bar.left ℓ 1) ∧
          ∀ a : weilCupPDModH C_bar.left ℓ 1,
            (∀ b : weilCupPDModH C_bar.left ℓ 1,
              CategoryTheory.Abelian.Ext.comp a b (rfl : 1 + 1 = 2) = 0) →
            a = 0)
    (hDual_U :
      ∀ (U_et C'_et : E.C_fib.left.Etale)
        (v_et : Quiver.Hom C'_et U_et)
        (e_U : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj U_et).left
          E.U_fib.toScheme),
        CategoryTheory.CategoryStruct.comp e_U.hom E.U_fib.ι =
          ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj U_et).hom →
        ConnectedSpace ↥((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj C'_et).left →
        AlgebraicGeometry.IsFinite
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).map v_et).left e_U.hom) →
        AlgebraicGeometry.Etale
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).map v_et).left e_U.hom) →
        AlgebraicGeometry.Surjective
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).map v_et).left e_U.hom) →
        (∃ p₁ : weilEtaleTorsionH E.U_fib.toScheme ℓ 1 →+
            weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj C'_et).left ℓ 1,
          WeilIsTorsionEtalePullback
            (CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).map v_et).left e_U.hom)
            ℓ 1 p₁ ∧
          ∀ β : weilEtaleTorsionH E.U_fib.toScheme ℓ 1, p₁ β = 0) →
        weilEtaleLocalTorsionMapH E.C_fib.left ℓ v_et 1 = 0) :
    ∃ (V₂ : E.V_bar.left.Etale)
      (g_V₂ : Quiver.Hom V₂ E.V₁)
      (v₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
      (W₂ : E.Y_bar.left.Etale)
      (u₁_W : Quiver.Hom W₂ E.W₁)
      (x₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left ∧
      IsClosed ({v₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left) ∧
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map g_V₂).left.base v₂ = E.v₁ ∧
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left ∧
      IsClosed ({x₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left) ∧
      ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map u₁_W).left.base x₂ = E.x₁ ∧
      weilEtaleHigherDirectImageMap E.π_bar.left 1
        (weilEtaleLocalTorsionMap E.Y_bar.left ℓ u₁_W) = 0 ∧
      ∀ (V' : E.V_bar.left.Etale)
        (w₁ : Quiver.Hom V' V₂)
        (v'₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left),
        AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left →
        IsClosed ({v'₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left) →
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map w₁).left.base v'₂ = v₂ →
        ∃ (W'₂ : E.Y_bar.left.Etale)
          (w_tilde₁ : Quiver.Hom W'₂ W₂)
          (x'₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W'₂).left)
          (e_R2' : CategoryTheory.Iso
            (weilEtaleLocalTorsionSheaf E.V_bar.left ℓ V')
            (weilEtaleHigherDirectImage E.π_bar.left 2
              (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W'₂)))
          (e_R2 : CategoryTheory.Iso
            (weilEtaleLocalTorsionSheaf E.V_bar.left ℓ V₂)
            (weilEtaleHigherDirectImage E.π_bar.left 2
              (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W₂))),
          AlgebraicGeometry.IsAffine
            ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W'₂).left ∧
          IsClosed
            ({x'₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W'₂).left) ∧
          ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map w_tilde₁).left.base x'₂ = x₂ ∧
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage E.π_bar.left 0
              (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W'₂)) ∧
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage E.π_bar.left 0
              (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W₂)) ∧
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage E.π_bar.left 0
              (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ E.W₁)) ∧
          (∀ k_deg : ℕ, 3 ≤ k_deg →
            CategoryTheory.Limits.IsZero
              (weilEtaleHigherDirectImage E.π_bar.left k_deg
                (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W'₂)) ∧
            CategoryTheory.Limits.IsZero
              (weilEtaleHigherDirectImage E.π_bar.left k_deg
                (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W₂)) ∧
            CategoryTheory.Limits.IsZero
              (weilEtaleHigherDirectImage E.π_bar.left k_deg
                (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ E.W₁))) ∧
          CategoryTheory.CategoryStruct.comp
              (weilEtaleLocalTorsionMap E.V_bar.left ℓ w₁) e_R2.hom =
            CategoryTheory.CategoryStruct.comp e_R2'.hom
              (weilEtaleHigherDirectImageMap E.π_bar.left 2
                (weilEtaleLocalTorsionMap E.Y_bar.left ℓ w_tilde₁)) :=
by
  classical
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl

  
  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S U₁ U₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom) := by
      rw [hvw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom U₂.prop hEt_comp

  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W] (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_B : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_B (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_k := by
      dsimp [s]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_k : PrimeSpectrum k).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_hom_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k) = x
    rw [hs_pt_spec]
    change (e_W.hom ≫ e_W.inv).base x = x
    rw [e_W.hom_inv_id]
    rfl

  have hClosedOfSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) (s : S_k ⟶ W),
        s ≫ p_W = 𝟙 S_k →
        IsClosed ({s.base pt_k} : Set ↥W) := by
    intro W _ p_W s hs
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    let ψ : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s ≫ e_W.hom)
    have hφψ : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_W.hom, e_W.hom_inv_id,
        CategoryTheory.Category.id_comp, hs, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ.hom := fun c =>
      ⟨φ_k.hom c, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφψ⟩
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := (AlgebraicGeometry.Spec.map ψ).base pt_k
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_max : q_spec.asIdeal.IsMaximal := by
      change (Ideal.comap ψ.hom (pt_k : PrimeSpectrum k).asIdeal).IsMaximal
      rw [hpt_bot]
      haveI : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      exact Ideal.comap_isMaximal_of_surjective ψ.hom hψ_surj
    have hq_cl : IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mpr hq_max
    have hpre : ({s.base pt_k} : Set ↥W) =
        e_W.hom.base ⁻¹' ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) := by
      have hq_eq : q_pt = e_W.hom.base (s.base pt_k) := by
        dsimp [q_pt, ψ]
        rw [AlgebraicGeometry.Spec.map_preimage]
        rfl
      rw [hq_eq]
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; rfl
      · intro hz
        have hz' := congrArg e_W.inv.base hz
        change (e_W.hom ≫ e_W.inv).base z = (e_W.hom ≫ e_W.inv).base (s.base pt_k) at hz'
        rwa [e_W.hom_inv_id] at hz'
    rw [hpre]
    exact hq_cl.preimage e_W.hom.continuous

  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine V]
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = 𝟙 S_k →
        s₂ ≫ p_V = 𝟙 S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V _ p_V s₁ s₂ hs₁ hs₂ hpt
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hpt
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp

  
  have hmap_id_V : (Fgt_V.map (𝟙 E.V₁)).left = 𝟙 (Fgt_V.obj E.V₁).left := by simp
  have hmap_id_W : (Fgt_Y.map (𝟙 E.W₁)).left = 𝟙 (Fgt_Y.obj E.W₁).left := by simp
  have hComm_Y₁_0 :
      CategoryTheory.CategoryStruct.comp (𝟙 E.Y₁) E.f_bar₁ =
        CategoryTheory.CategoryStruct.comp E.f_bar₁ (Fgt_V.map (𝟙 E.V₁)).left := by
    change 𝟙 E.Y₁ ≫ E.f_bar₁ = E.f_bar₁ ≫ (Fgt_V.map (𝟙 E.V₁)).left
    rw [hmap_id_V, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
  let φ_rel := CategoryTheory.Limits.pullback.lift (𝟙 E.Y₁) E.f_bar₁ hComm_Y₁_0
  have hIso_rel : CategoryTheory.IsIso φ_rel := by
    refine ⟨⟨CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map (𝟙 E.V₁)).left,
      CategoryTheory.Limits.pullback.lift_fst _ _ _, ?_⟩⟩
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.condition, hmap_id_V,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  haveI : CategoryTheory.IsIso φ_rel := hIso_rel
  have hComm_W_0 :
      CategoryTheory.CategoryStruct.comp (Fgt_Y.map (𝟙 E.W₁)).left
        (CategoryTheory.CategoryStruct.comp E.e_W₁.hom
          (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁)) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp E.e_W₁.hom
          (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁))
        (Fgt_V.map (𝟙 E.V₁)).left := by
    change (Fgt_Y.map (𝟙 E.W₁)).left ≫ (E.e_W₁.hom ≫ E.W₁_open.ι ≫ E.f_bar₁) =
      (E.e_W₁.hom ≫ E.W₁_open.ι ≫ E.f_bar₁) ≫ (Fgt_V.map (𝟙 E.V₁)).left
    rw [hmap_id_W, hmap_id_V, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
  let φ_W := CategoryTheory.Limits.pullback.lift (Fgt_Y.map (𝟙 E.W₁)).left
    (CategoryTheory.CategoryStruct.comp E.e_W₁.hom
      (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁))
    hComm_W_0
  have hIso_W : CategoryTheory.IsIso φ_W := by
    refine ⟨⟨CategoryTheory.Limits.pullback.fst _ _, ?_, ?_⟩⟩
    · rw [CategoryTheory.Limits.pullback.lift_fst]
      exact hmap_id_W
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hmap_id_W, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.condition, hmap_id_V,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  haveI : CategoryTheory.IsIso φ_W := hIso_W
  let P₀ : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E :=
    { V := E.V₁
      g_V := 𝟙 E.V₁
      v := E.v₁
      Y := E.Y₁
      f_bar := E.f_bar₁
      π_Y₁ := 𝟙 E.Y₁
      m_pts := E.s_pts
      τ_bdry := E.σ
      W_open := E.W₁_open
      W := E.W₁
      e_W := E.e_W₁
      u_W := 𝟙 E.W₁
      x := E.x₁
      hAff_V := E.hAff_V₁
      hInt_V := E.hInt_V₁
      hv_cl := E.hv₁_cl
      hv_map := by rw [hmap_id_V]; rfl
      hInt_Y := E.hInt_Y₁
      hProp_f := E.hProp_f₁
      hSm_f := E.hSm_f₁
      hComm_Y₁ := hComm_Y₁_0
      hFin_rel := inferInstance
      hSurj_rel := inferInstance
      hIrred_fib := E.hIrred_fib
      hm_pts_pos := E.hs_pts_pos
      hτ_sec := E.hσ_sec
      hτ_cl := E.hσ_cl
      hτ_disj := E.hσ_disj
      hW_compl := E.hW₁_compl
      hAff_Wopen := E.hAff_W₁open
      he_W_hom := by
        change E.e_W₁.hom ≫ E.W₁_open.ι ≫ 𝟙 E.Y₁ ≫ E.g_Y₁ = (Fgt_Y.obj E.W₁).hom
        rw [CategoryTheory.Category.id_comp]
        exact E.he_W₁_hom
      hu_W_comp := by
        change (Fgt_Y.map (𝟙 E.W₁)).left ≫ (E.e_W₁.hom ≫ E.W₁_open.ι) =
          E.e_W₁.hom ≫ (E.W₁_open.ι ≫ 𝟙 E.Y₁)
        rw [hmap_id_W, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      hComm_W := hComm_W_0
      hFin_W_rel := inferInstance
      hEt_W_rel := inferInstance
      hSurj_W_rel := inferInstance
      hx_cl := E.hx₁_cl
