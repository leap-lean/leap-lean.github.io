        exact hPin_Y T_Y
      have hPinB' : adj_B.unit.app AM ≫ e_loc_B.hom.hom.app (Opposite.op T_B) =
          weilAltLocConstConstHom B₀ T_B n := by
        rw [hConstSheafAdjUnit hT_B AM]
        exact hPin_B T_B
      have hLHS : adj_Y.unit.app AM ≫
          (ρ_a a ≫ (pf_fun a).map e_loc_B.hom).hom.app (Opposite.op T_Y) =
          weilAltLocConstConstHom B₀ ((weilEtaleSitePullback (τ a)).obj T_Y) n := by
