            apply (adj_bot.homEquiv ℱ ((P_pull_ν ⋙ P_pull_Y).obj ℱ)).injective
            exact (hΦ_mate_inv (Φ_hom_app ℱ)).trans
              ((congrArg (· ≫ e_push.inv.app _)
                (Equiv.apply_symm_apply (adj_top.homEquiv ℱ _) _)).trans
                ((CategoryTheory.Category.assoc (adj_bot.unit.app ℱ)
