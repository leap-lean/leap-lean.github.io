        @weilEtaleConstPullbackHom _ _ f hc_f hr_f T_Y₂ hT_Y₂ T_B₂ hT_B₂ A) ∧
    ((∀ (G : CategoryTheory.Sheaf B.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        n • CategoryTheory.CategoryStruct.id G = 0 →
        2 * δ < q →
        Subsingleton (G.H q)) →
      let pf_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        B.smallEtaleTopology Y.smallEtaleTopology hc_f
      let pb_f := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        B.smallEtaleTopology Y.smallEtaleTopology hc_f hr_f
      let adj_f := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        B.smallEtaleTopology Y.smallEtaleTopology hc_f hr_f
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ_B := (CategoryTheory.constantSheaf B.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      ∀ (hr₂ : (2 * δ + 1) + 1 = 2 * δ')
        (hAdd_f : pb_f.Additive)
        (hLim_f : CategoryTheory.Limits.PreservesFiniteLimits pb_f)
        (hColim_f : CategoryTheory.Limits.PreservesFiniteColimits pb_f)
        (ιℤ_f : Quiver.Hom Fℤ_Y (pb_f.obj Fℤ_B))
        (F M_0 Q_1 M_1 Q_2 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (R₂ : CategoryTheory.Sheaf B.smallEtaleTopology AddCommGrpCat.{u})
        (i_0 : Quiver.Hom F M_0) (p_0 : Quiver.Hom M_0 Q_1)
        (h0_0 : CategoryTheory.CategoryStruct.comp i_0 p_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk i_0 p_0 h0_0).ShortExact)
        (i_1 : Quiver.Hom Q_1 M_1) (p_1 : Quiver.Hom M_1 Q_2)
        (h0_1 : CategoryTheory.CategoryStruct.comp i_1 p_1 = 0)
        (hSE_1 : (CategoryTheory.ShortComplex.mk i_1 p_1 h0_1).ShortExact)
        (Δ₂ : Quiver.Hom (pf_f.obj Q_2) R₂)
        (h0_Δ : CategoryTheory.CategoryStruct.comp (pf_f.map p_1) Δ₂ = 0),
        let leray_G : ∀ (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
            CategoryTheory.Abelian.Ext Fℤ_B (pf_f.obj G) (2 * δ) →
              CategoryTheory.Abelian.Ext Fℤ_Y G (2 * δ) :=
