            funext ℱ
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext U
            dsimp [η_bar, ε_bar, P, P_push, CategoryTheory.Functor.sheafPushforwardContinuous]
            rw [CategoryTheory.Category.id_comp, ← ℱ.obj.map_comp, ← op_comp,
              adj_site.left_triangle_components (Opposite.unop U)]
            exact ℱ.obj.map_id _
          right_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext ℋ
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext V
            dsimp [η_bar, ε_bar, P, P_push, CategoryTheory.Functor.sheafPushforwardContinuous]
            rw [CategoryTheory.Category.id_comp, ← ℋ.obj.map_comp, ← op_comp,
              adj_site.right_triangle_components (Opposite.unop V)]
            exact ℋ.obj.map_id _ }
    have := adj_site.rightAdjoint_preservesLimits
    have hBT : CategoryTheory.Limits.IsTerminal (B_g.obj T) :=
      CategoryTheory.Limits.IsTerminal.isTerminalObj B_g T hT
    let τ : Quiver.Hom (B_g.obj T) T := hT.from (B_g.obj T)
    let τ_inv : Quiver.Hom T (B_g.obj T) := hBT.from T
    have hτ_inv : CategoryTheory.CategoryStruct.comp τ τ_inv =
        CategoryTheory.CategoryStruct.id (B_g.obj T) := hBT.hom_ext _ _
    have hinv_τ : CategoryTheory.CategoryStruct.comp τ_inv τ =
        CategoryTheory.CategoryStruct.id T := hT.hom_ext _ _
    let α_hom : ∀ A : D, Quiver.Hom (C.obj A) (P.obj (C.obj A)) := fun A =>
      (adj.homEquiv A (P.obj (C.obj A))).symm
        (CategoryTheory.CategoryStruct.comp (adj.unit.app A) ((C.obj A).obj.map μ.op))
    let π_hom : ∀ A : D, Quiver.Hom (P.obj (C.obj A)) (C.obj A) := fun A =>
      (adj_pull.homEquiv (C.obj A) (C.obj A)).symm
        ((adj.homEquiv A (P_push.obj (C.obj A))).symm
          (CategoryTheory.CategoryStruct.comp (adj.unit.app A)
            ((C.obj A).obj.map τ.op)))
    let E_map : ∀ (A : D) (𝒢 : CategoryTheory.Sheaf J D),
        Quiver.Hom (P.obj (C.obj A)) 𝒢 → Quiver.Hom (C.obj A) 𝒢 := fun A 𝒢 φ =>
      (adj.homEquiv A 𝒢).symm
        (CategoryTheory.CategoryStruct.comp
          (adj.homEquiv A (P_push.obj 𝒢) (adj_pull.homEquiv (C.obj A) 𝒢 φ))
          (𝒢.obj.map τ_inv.op))
    have hE_inj : ∀ (A : D) (𝒢 : CategoryTheory.Sheaf J D),
        Function.Injective (E_map A 𝒢) := by
      intro A 𝒢 φ₁ φ₂ hEq
      have h1 := (adj.homEquiv A 𝒢).symm.injective hEq
      have h2 := congrArg
        (fun u => CategoryTheory.CategoryStruct.comp u (𝒢.obj.map τ.op)) h1
      have hcomp_id : CategoryTheory.CategoryStruct.comp
          (𝒢.obj.map τ_inv.op) (𝒢.obj.map τ.op) =
          CategoryTheory.CategoryStruct.id (𝒢.obj.obj (Opposite.op (B_g.obj T))) := by
        rw [← 𝒢.obj.map_comp, ← op_comp, hτ_inv]
        exact 𝒢.obj.map_id _
      have hcancel : ∀ u : Quiver.Hom A (𝒢.obj.obj (Opposite.op (B_g.obj T))),
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp u (𝒢.obj.map τ_inv.op))
            (𝒢.obj.map τ.op) = u := by
        intro u
        rw [CategoryTheory.Category.assoc, hcomp_id, CategoryTheory.Category.comp_id]
      have h3 : adj.homEquiv A (P_push.obj 𝒢) (adj_pull.homEquiv (C.obj A) 𝒢 φ₁) =
          adj.homEquiv A (P_push.obj 𝒢) (adj_pull.homEquiv (C.obj A) 𝒢 φ₂) := by
        exact (hcancel _).symm.trans (h2.trans (hcancel _))
      exact (adj_pull.homEquiv (C.obj A) 𝒢).injective
        ((adj.homEquiv A (P_push.obj 𝒢)).injective h3)
    have hE_comp : ∀ (A : D) (𝒢 : CategoryTheory.Sheaf J D)
        (φ : Quiver.Hom (P.obj (C.obj A)) (C.obj A))
        (ψ_hom : Quiver.Hom (C.obj A) 𝒢),
        E_map A 𝒢 (CategoryTheory.CategoryStruct.comp φ ψ_hom) =
          CategoryTheory.CategoryStruct.comp (E_map A (C.obj A) φ) ψ_hom := by
      intro A 𝒢 φ ψ_hom
      dsimp only [E_map]
      rw [adj_pull.homEquiv_naturality_right, adj.homEquiv_naturality_right,
        ← adj.homEquiv_naturality_right_symm]
      congr 1
      let u₀ : Quiver.Hom A ((C.obj A).obj.obj (Opposite.op (B_g.obj T))) :=
        adj.homEquiv A (P_push.obj (C.obj A)) (adj_pull.homEquiv (C.obj A) (C.obj A) φ)
      change CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp u₀
            (ψ_hom.hom.app (Opposite.op (B_g.obj T))))
          (𝒢.obj.map τ_inv.op) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp u₀
            ((C.obj A).obj.map τ_inv.op))
          (ψ_hom.hom.app (Opposite.op T))
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        (ψ_hom.hom.naturality τ_inv.op).symm]
    have hE_π : ∀ A : D, E_map A (C.obj A) (π_hom A) =
        CategoryTheory.CategoryStruct.id (C.obj A) := by
      intro A
      have h_inner :
          adj.homEquiv A (P_push.obj (C.obj A))
            (adj_pull.homEquiv (C.obj A) (C.obj A) (π_hom A)) =
          CategoryTheory.CategoryStruct.comp (adj.unit.app A)
            ((C.obj A).obj.map τ.op) := by
        dsimp [π_hom]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      have h_id :
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp
              (adj.unit.app A : Quiver.Hom A ((C.obj A).obj.obj (Opposite.op T)))
              ((C.obj A).obj.map τ.op))
            ((C.obj A).obj.map τ_inv.op) =
          (adj.unit.app A : Quiver.Hom A ((C.obj A).obj.obj (Opposite.op T))) := by
        rw [CategoryTheory.Category.assoc, ← (C.obj A).obj.map_comp, ← op_comp,
          hinv_τ, op_id, (C.obj A).obj.map_id]
        exact CategoryTheory.Category.comp_id _
      have h_unit_id : adj.homEquiv A (C.obj A) (CategoryTheory.CategoryStruct.id (C.obj A)) =
          adj.unit.app A := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
        exact CategoryTheory.Category.comp_id _
      apply (adj.homEquiv A (C.obj A)).injective
      dsimp only [E_map]
      rw [Equiv.apply_symm_apply, h_unit_id]
      exact (congrArg
        (fun u : Quiver.Hom A ((C.obj A).obj.obj (Opposite.op (B_g.obj T))) =>
          CategoryTheory.CategoryStruct.comp u ((C.obj A).obj.map τ_inv.op))
        h_inner).trans h_id
    have hE_id : ∀ A : D,
        E_map A (P.obj (C.obj A)) (CategoryTheory.CategoryStruct.id (P.obj (C.obj A))) =
          α_hom A := by
      intro A
      dsimp only [E_map, α_hom]
      congr 1
      have h_pull_id :
          adj_pull.homEquiv (C.obj A) (P.obj (C.obj A))
            (CategoryTheory.CategoryStruct.id (P.obj (C.obj A))) =
          η_bar.app (C.obj A) := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
        exact CategoryTheory.Category.comp_id (η_bar.app (C.obj A))
      rw [h_pull_id, CategoryTheory.Adjunction.homEquiv_unit]
      change CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp
          (adj.unit.app A : Quiver.Hom A ((C.obj A).obj.obj (Opposite.op T)))
          ((C.obj A).obj.map (adj_site.counit.app T).op))
        ((C.obj A).obj.map (G.map τ_inv).op) =
        CategoryTheory.CategoryStruct.comp
          (adj.unit.app A : Quiver.Hom A ((C.obj A).obj.obj (Opposite.op T)))
          ((C.obj A).obj.map μ.op)
      rw [CategoryTheory.Category.assoc, ← (C.obj A).obj.map_comp, ← op_comp]
      have hμ_eq :
          CategoryTheory.CategoryStruct.comp (G.map τ_inv) (adj_site.counit.app T) = μ :=
        hT.hom_ext _ _
      rw [hμ_eq]
    have hπα : ∀ A : D,
        CategoryTheory.CategoryStruct.comp (π_hom A) (α_hom A) =
          CategoryTheory.CategoryStruct.id (P.obj (C.obj A)) := by
      intro A
      apply hE_inj A (P.obj (C.obj A))
      rw [hE_comp, hE_π, CategoryTheory.Category.id_comp, hE_id]
    have hαπ : ∀ A : D,
        CategoryTheory.CategoryStruct.comp (α_hom A) (π_hom A) =
          CategoryTheory.CategoryStruct.id (C.obj A) := by
      intro A
      have h1 :
          CategoryTheory.CategoryStruct.comp (π_hom A)
            (CategoryTheory.CategoryStruct.comp (α_hom A) (π_hom A)) =
          CategoryTheory.CategoryStruct.comp (π_hom A)
            (CategoryTheory.CategoryStruct.id (C.obj A)) := by
        rw [← CategoryTheory.Category.assoc, hπα A,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      have h2 := congrArg (E_map A (C.obj A)) h1
      rwa [hE_comp, hE_comp, hE_π, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.id_comp] at h2
    have hβαM' : CategoryTheory.CategoryStruct.comp βM (α_hom AM) =
        CategoryTheory.CategoryStruct.id (P.obj FM) := hβαM
    have hπM_eq : π_hom AM = βM := by
      calc
        π_hom AM = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.id (P.obj FM)) (π_hom AM) :=
          (CategoryTheory.Category.id_comp _).symm
        _ = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp βM (α_hom AM)) (π_hom AM) := by
          rw [← hβαM']
        _ = CategoryTheory.CategoryStruct.comp βM
            (CategoryTheory.CategoryStruct.comp (α_hom AM) (π_hom AM)) :=
          CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.CategoryStruct.comp βM
            (CategoryTheory.CategoryStruct.id FM) := by
          rw [hαπ AM]
        _ = βM := CategoryTheory.Category.comp_id _
    refine ⟨hBg_cont, P, adj_pull, hP_add, hP_lim, hP_colim,
      T, hT, T, hT, α_hom Aℤ, hαπ Aℤ, hπα Aℤ, ?_⟩
    intro x
    change f x = (CategoryTheory.Abelian.Ext.mk₀ (π_hom AM)).postcomp Fℤ (Nat.add_zero k)
      ((CategoryTheory.Abelian.Ext.mk₀ (α_hom Aℤ)).comp
        ((P.mapExtAddHom Fℤ FM k) x) (Nat.zero_add k))
    rw [hπM_eq]
    exact hf_eq x

theorem weil_abs_frob_pow_torsion_pullback_id (p : ℕ) [Fact (Nat.Prime p)]
    (ν m k : ℕ) (W : AlgebraicGeometry.Scheme.{u})
    (φ_abs : Quiver.Hom W W) (hφ_abs : WeilTopDegIsIteratedAbsFrob p ν W φ_abs) :
    WeilTopDegTorsionPullback φ_abs m k (AddMonoidHom.id _) :=
by
  classical
  have hp : Nat.Prime p := Fact.out
  have hq_pos : 0 < p ^ ν := pow_pos hp.pos ν
  have hq_ne : p ^ ν ≠ 0 := hq_pos.ne'
  
  have h_add_pow_p : ∀ {R : Type u} [CommRing R], ((p : ℕ) : R) = 0 →
      ∀ x y : R, (x + y) ^ p = x ^ p + y ^ p := by
    intro R _ hpR x y
    rw [add_pow, Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one, Nat.choose_self,
      Nat.cast_one, mul_one]
    have hsum : ∑ i ∈ Finset.range p, x ^ i * y ^ (p - i) * (p.choose i : R) = y ^ p := by
      rw [Finset.sum_eq_single 0]
      · simp
      · intro i hi hi0
        have hip : i < p := Finset.mem_range.mp hi
        obtain ⟨c, hc⟩ := hp.dvd_choose_self hi0 hip
        rw [hc, Nat.cast_mul, hpR, zero_mul, mul_zero]
      · intro h0
        exact absurd (Finset.mem_range.mpr hp.pos) h0
    rw [hsum, add_comm]
  have h_add_pow_q : ∀ {R : Type u} [CommRing R], ((p : ℕ) : R) = 0 →
      ∀ (μ : ℕ) (x y : R), (x + y) ^ (p ^ μ) = x ^ (p ^ μ) + y ^ (p ^ μ) := by
    intro R _ hpR μ
    induction μ with
    | zero =>
      intro x y
      simp
    | succ μ ih =>
      intro x y
      rw [pow_succ, pow_mul, ih x y, h_add_pow_p hpR, ← pow_mul, ← pow_mul]
  let frobPowRingHom : ∀ (R : Type u) [CommRing R], ((p : ℕ) : R) = 0 → (R →+* R) :=
    fun R _ hpR =>
      { toFun := fun s => s ^ (p ^ ν)
        map_one' := one_pow (p ^ ν)
        map_mul' := fun a b => mul_pow a b (p ^ ν)
        map_zero' := zero_pow hq_ne
        map_add' := fun a b => h_add_pow_q hpR ν a b }
  have hExFrob : ∀ {X : AlgebraicGeometry.Scheme.{u}} (v : X ⟶ W),
      ∃ φ_X : X ⟶ X, WeilTopDegIsIteratedAbsFrob p ν X φ_X := by
    intro X v
    have hpX : ∀ U : X.Opens, ((p : ℕ) : ↑(X.presheaf.obj (Opposite.op U))) = 0 := by
      intro U
      let ψ := (v.appLE ⊤ U (fun _ _ => trivial)).hom
      calc
        ((p : ℕ) : ↑(X.presheaf.obj (Opposite.op U)))
            = ψ ((p : ℕ) : ↑(W.presheaf.obj (Opposite.op ⊤))) := (map_natCast ψ p).symm
        _ = ψ 0 := by rw [hφ_abs.1 ⊤]
        _ = 0 := map_zero ψ
    let c : X.presheaf ⟶
        (TopCat.Presheaf.pushforward CommRingCat.{u} (𝟙 X.toTopCat)).obj X.presheaf :=
      { app := fun U => CommRingCat.ofHom (frobPowRingHom _ (hpX (Opposite.unop U)))
        naturality := fun U₁ U₂ i => by
          ext s
          exact (map_pow (X.presheaf.map i).hom s (p ^ ν)).symm }
    let toHom : X.toPresheafedSpace ⟶ X.toPresheafedSpace :=
      AlgebraicGeometry.PresheafedSpace.Hom.mk (𝟙 X.toTopCat) c
    have hloc : ∀ x : ↥X.toPresheafedSpace, IsLocalHom (toHom.stalkMap x).hom := by
      intro x
      refine ⟨fun g hg => ?_⟩
      obtain ⟨U, hxU, s, rfl⟩ := X.presheaf.exists_germ_eq g
      have h_st : (toHom.stalkMap x).hom
          ((CategoryTheory.ConcreteCategory.hom (X.presheaf.germ U x hxU)) s) =
          ((CategoryTheory.ConcreteCategory.hom (X.presheaf.germ U x hxU)) s) ^ (p ^ ν) :=
        (AlgebraicGeometry.PresheafedSpace.stalkMap_germ_apply toHom U x hxU s).trans
          (map_pow (X.presheaf.germ U x hxU).hom s (p ^ ν))
      have hg' : IsUnit (((CategoryTheory.ConcreteCategory.hom (X.presheaf.germ U x hxU)) s) ^ (p ^ ν)) := by
        rwa [← h_st]
      have h_exp : p ^ ν = 1 + (p ^ ν - 1) := by omega
      rw [h_exp, pow_add, pow_one] at hg'
      exact isUnit_of_mul_isUnit_left hg'
    let φ_X : X ⟶ X :=
      AlgebraicGeometry.Scheme.Hom.mk (AlgebraicGeometry.LocallyRingedSpace.Hom.mk toHom hloc)
    refine ⟨φ_X, hpX, rfl, ?_⟩
    intro U e s
    have h_app : φ_X.appLE U U e = φ_X.app U := (φ_X.app_eq_appLE (U := U)).symm
    rw [h_app]
    rfl
  have hNatFrob : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (φ_X : X ⟶ X) (φ_Y : Y ⟶ Y) (g : X ⟶ Y),
      WeilTopDegIsIteratedAbsFrob p ν X φ_X →
      WeilTopDegIsIteratedAbsFrob p ν Y φ_Y →
      φ_X ≫ g = g ≫ φ_Y := by
    intro X Y φ_X φ_Y g hφ_X hφ_Y
    have h_base : (φ_X ≫ g).base = (g ≫ φ_Y).base := by
      change φ_X.base ≫ g.base = g.base ≫ φ_Y.base
      rw [hφ_X.2.1, hφ_Y.2.1]
      exact (CategoryTheory.Category.id_comp g.base).trans
        (CategoryTheory.Category.comp_id g.base).symm
    refine AlgebraicGeometry.Scheme.Hom.ext h_base (fun U => ?_)
    let V : X.Opens := (TopologicalSpace.Opens.map g.base).obj U
    have hV_eq : (TopologicalSpace.Opens.map (g ≫ φ_Y).base).obj U = V := by
      change (TopologicalSpace.Opens.map (g.base ≫ φ_Y.base)).obj U = V
      rw [hφ_Y.2.1]
      rfl
    have eV : V ≤ (TopologicalSpace.Opens.map φ_X.base).obj V := by
      rw [hφ_X.2.1]; exact le_rfl
    have eU : U ≤ (TopologicalSpace.Opens.map φ_Y.base).obj U := by
      rw [hφ_Y.2.1]; exact le_rfl
    rw [(φ_X ≫ g).app_eq_appLE, (φ_X ≫ g).appLE_map, (g ≫ φ_Y).app_eq_appLE]
    have h_eq1 : (φ_X ≫ g).appLE U ((TopologicalSpace.Opens.map (g ≫ φ_Y).base).obj U)
        (by rw [h_base]) =
        (φ_X ≫ g).appLE U V (by rw [h_base, hV_eq]) ≫
          X.presheaf.map (CategoryTheory.eqToHom hV_eq).op := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
    have h_eq2 : (g ≫ φ_Y).appLE U ((TopologicalSpace.Opens.map (g ≫ φ_Y).base).obj U) le_rfl =
        (g ≫ φ_Y).appLE U V (by rw [hV_eq]) ≫
          X.presheaf.map (CategoryTheory.eqToHom hV_eq).op := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
    rw [h_eq1, h_eq2]
    congr 1
    rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE φ_X g U V V le_rfl eV,
      ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE g φ_Y U U V eU le_rfl]
    ext t
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hφ_X.2.2 V eV, hφ_Y.2.2 U eU, map_pow]

  
  have hRingBij : ∀ {B A : Type u} [CommRing B] [CommRing A]
      (hpB : ((p : ℕ) : B) = 0) (Φ : B →+* A) (θ : A →+* B),
      Φ.Etale →
      (∀ a : A, Φ (θ a) = a ^ (p ^ ν)) →
      (∀ b : B, θ (Φ b) = b ^ (p ^ ν)) →
      Function.Bijective Φ := by
    intro B A _ _ hpB Φ θ hΦ_et hΦθ hθΦ
    let _ : Algebra B A := Φ.toAlgebra
    have halg : algebraMap B A = Φ := rfl
    obtain ⟨hUnram, hSm⟩ := (RingHom.etale_iff_formallyUnramified_and_smooth Φ).mp hΦ_et
    have : Module.Flat B A := (RingHom.flat_algebraMap_iff).mp hSm.flat
    have : Algebra.FinitePresentation B A :=
      (RingHom.finitePresentation_algebraMap).mp hSm.finitePresentation
    have : Algebra.FiniteType B A := Algebra.FiniteType.of_finitePresentation
    have : Algebra.EssFiniteType B A := Algebra.EssFiniteType.of_finiteType B A
    have : Algebra.FormallyUnramified B A := (RingHom.formallyUnramified_algebraMap).mp hUnram
    have h_rad_surj : ∀ a : A, ∃ n > 0, a ^ n ∈ Φ.range :=
      fun a => ⟨p ^ ν, hq_pos, θ a, hΦθ a⟩
    have h_ker_nil : RingHom.ker Φ ≤ nilradical B := by
      intro b hb
      rw [RingHom.mem_ker] at hb
      rw [mem_nilradical]
      exact ⟨p ^ ν, by rw [← hθΦ b, hb, map_zero]⟩
    have h_comap_surj : Function.Surjective (PrimeSpectrum.comap (algebraMap B A)) :=
      (PrimeSpectrum.isHomeomorph_comap Φ h_rad_surj h_ker_nil).bijective.2
    have : Module.FaithfullyFlat B A := Module.FaithfullyFlat.of_comap_surjective h_comap_surj
    have hΦ_inj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := B) (B := A) B
      change (1 : A) ⊗ₜ[B] b = (1 : A) ⊗ₜ[B] (0 : B)
      rw [TensorProduct.tmul_zero]
      calc
        (1 : A) ⊗ₜ[B] b = (1 : A) ⊗ₜ[B] (b • (1 : B)) := by rw [smul_eq_mul, mul_one]
        _ = (b • (1 : A)) ⊗ₜ[B] (1 : B) := (TensorProduct.smul_tmul b (1 : A) (1 : B)).symm
        _ = (Φ b) ⊗ₜ[B] (1 : B) := by rw [Algebra.smul_def, mul_one, halg]
        _ = 0 := by rw [hb, TensorProduct.zero_tmul]
    obtain ⟨t, ht_ann, ht_mul⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := B) (S := A)).mp inferInstance
    let S := TensorProduct B A A
    have hpS : ((p : ℕ) : S) = 0 := by
      rw [← map_natCast (algebraMap B S) p, hpB, map_zero]
    let F_S : S →+* S := frobPowRingHom S hpS
    let D' : S →+ S :=
      (Algebra.TensorProduct.includeLeft (R := B) (S := B) (A := A) (B := A)).toAddMonoidHom.comp
        (Algebra.TensorProduct.lmul' B (S := A)).toAddMonoidHom - AddMonoidHom.id S
    have hD_prop : ∀ z : S, D' z * t = 0 ∧ F_S (D' z) = 0 := by
      intro z
      refine TensorProduct.inductionOn (motive := fun z => D' z * t = 0 ∧ F_S (D' z) = 0) z
        (fun x y => ?_) (fun _ _ hz₁ hz₂ => ?_)
      · have hD_xy : D' (x ⊗ₜ[B] y) =
            -(x ⊗ₜ[B] (1 : A)) * ((1 : A) ⊗ₜ[B] y - y ⊗ₜ[B] (1 : A)) := by
          change (x * y) ⊗ₜ[B] (1 : A) - x ⊗ₜ[B] y =
            -(x ⊗ₜ[B] (1 : A)) * ((1 : A) ⊗ₜ[B] y - y ⊗ₜ[B] (1 : A))
          rw [neg_mul, mul_sub, Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, mul_one, neg_sub]
        refine ⟨?_, ?_⟩
        · rw [hD_xy, mul_assoc, ht_ann y, mul_zero]
        · rw [hD_xy, map_mul, map_sub]
          have h_frob_eq : F_S ((1 : A) ⊗ₜ[B] y) = F_S (y ⊗ₜ[B] (1 : A)) := by
            let iR : A →ₐ[B] S := Algebra.TensorProduct.includeRight
            let iL : A →ₐ[B] S :=
              Algebra.TensorProduct.includeLeft (R := B) (S := B) (A := A) (B := A)
            change (iR y) ^ (p ^ ν) = (iL y) ^ (p ^ ν)
            rw [← map_pow, ← map_pow, ← hΦθ y, ← halg, iR.commutes, iL.commutes]
          rw [h_frob_eq, sub_self, mul_zero]
      · rw [map_add, add_mul, hz₁.1, hz₂.1, add_zero, map_add, hz₁.2, hz₂.2, add_zero]
        exact ⟨rfl, rfl⟩
    have hDt : D' t = (1 : S) - t := by
      change (Algebra.TensorProduct.lmul' B t) ⊗ₜ[B] (1 : A) - t = (1 : S) - t
      rw [ht_mul]
      rfl
    obtain ⟨h_ann_1t, h_pow_1t⟩ := hD_prop t
    rw [hDt] at h_ann_1t h_pow_1t
    have h_idem : IsIdempotentElem ((1 : S) - t) := by
      change ((1 : S) - t) * ((1 : S) - t) = (1 : S) - t
      rw [mul_sub, mul_one, h_ann_1t, sub_zero]
    have h_exp_pred : (p ^ ν - 1) + 1 = p ^ ν := Nat.sub_add_cancel hq_pos
    have h_1t_zero : (1 : S) - t = 0 := by
      calc
        (1 : S) - t = ((1 : S) - t) ^ ((p ^ ν - 1) + 1) := (h_idem.pow_succ_eq (p ^ ν - 1)).symm
        _ = ((1 : S) - t) ^ (p ^ ν) := by rw [h_exp_pred]
        _ = F_S ((1 : S) - t) := rfl
        _ = 0 := h_pow_1t
    have ht_one : t = 1 := (sub_eq_zero.mp h_1t_zero).symm
    have h_tmul_eq : ∀ a : A, (1 : A) ⊗ₜ[B] a = a ⊗ₜ[B] (1 : A) := by
      intro a
      have h0 := ht_ann a
      rw [ht_one, mul_one] at h0
      exact sub_eq_zero.mp h0
    have hΦ_surj : Function.Surjective Φ := by
      intro a
      let M₀ : Submodule B A := LinearMap.range (Algebra.linearMap B A)
      let q : A →ₗ[B] A ⧸ M₀ := Submodule.mkQ M₀
      have hq1 : q 1 = 0 :=
        (Submodule.Quotient.mk_eq_zero M₀).mpr ⟨1, by rw [Algebra.linearMap_apply, map_one]⟩
      have h_tens_q : (1 : A) ⊗ₜ[B] (q a) = 0 := by
        have h1 := congrArg (LinearMap.lTensor A q) (h_tmul_eq a)
        simp only [LinearMap.lTensor_tmul, hq1, TensorProduct.tmul_zero] at h1
        exact h1
      have hqa : q a = 0 := by
        apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := B) (B := A) (A ⧸ M₀)
        change (1 : A) ⊗ₜ[B] (q a) = (1 : A) ⊗ₜ[B] (0 : A ⧸ M₀)
        rw [TensorProduct.tmul_zero]
        exact h_tens_q
      obtain ⟨b, hb⟩ := (Submodule.Quotient.mk_eq_zero M₀).mp hqa
      exact ⟨b, hb⟩
    exact ⟨hΦ_inj, hΦ_surj⟩

  have hSchemeIso : ∀ {V P : AlgebraicGeometry.Scheme.{u}}
      (r : V ⟶ P) (π₁ : P ⟶ V) (φ_V : V ⟶ V) (φ_P : P ⟶ P),
      AlgebraicGeometry.Etale r →
      AlgebraicGeometry.IsAffineHom π₁ →
      WeilTopDegIsIteratedAbsFrob p ν V φ_V →
      WeilTopDegIsIteratedAbsFrob p ν P φ_P →
      r ≫ π₁ = φ_V →
      π₁ ≫ r = φ_P →
      CategoryTheory.IsIso r := by
    intro V P r π₁ φ_V φ_P hr_et hπ₁_aff hφ_V hφ_P hrπ hπr
    have hrπ_base : r.base ≫ π₁.base = 𝟙 V.toTopCat := by
      change (r ≫ π₁).base = (CategoryTheory.CategoryStruct.id V).base
      rw [hrπ, hφ_V.2.1]
    have hπr_base : π₁.base ≫ r.base = 𝟙 P.toTopCat := by
      change (π₁ ≫ r).base = (CategoryTheory.CategoryStruct.id P).base
      rw [hπr, hφ_P.2.1]
    have hIsoBase : CategoryTheory.IsIso r.base := ⟨⟨π₁.base, hrπ_base, hπr_base⟩⟩
    have hπr_pt : ∀ y : ↥P, r.base (π₁.base y) = y := fun y =>
      congrArg (fun f => f.hom y) hπr_base
    have hrπ_pt : ∀ x : ↥V, π₁.base (r.base x) = x := fun x =>
      congrArg (fun f => f.hom x) hrπ_base
    have hAffBij : ∀ (U' : V.Opens), AlgebraicGeometry.IsAffineOpen U' →
        let U : P.Opens := (TopologicalSpace.Opens.map π₁.base).obj U'
        ∀ (e₁ : U' ≤ (TopologicalSpace.Opens.map r.base).obj U),
          Function.Bijective (r.appLE U U' e₁).hom := by
      intro U' hU' U e₁
      have hU : AlgebraicGeometry.IsAffineOpen U :=
        @AlgebraicGeometry.IsAffineHom.isAffine_preimage _ _ π₁ hπ₁_aff U' hU'
      have e₂ : U ≤ (TopologicalSpace.Opens.map π₁.base).obj U' := le_rfl
      have hEt_Φ : RingHom.Etale (r.appLE U U' e₁).hom :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) r hr_et
          ⟨U, hU⟩ ⟨U', hU'⟩ e₁
      have hΦθ : ∀ a : ↑(V.presheaf.obj (Opposite.op U')),
          (r.appLE U U' e₁).hom ((π₁.appLE U' U e₂).hom a) = a ^ (p ^ ν) := by
        intro a
        have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE r π₁ U' U U' e₂ e₁
        have heq : (π₁.appLE U' U e₂ ≫ r.appLE U U' e₁) =
            φ_V.appLE U' U' (by rw [hφ_V.2.1]; exact le_rfl) := by
          rw [hcomp]
          congr 1
        exact (congrArg (fun f => f.hom a) heq).trans (hφ_V.2.2 U' _ a)
      have hθΦ : ∀ b : ↑(P.presheaf.obj (Opposite.op U)),
          (π₁.appLE U' U e₂).hom ((r.appLE U U' e₁).hom b) = b ^ (p ^ ν) := by
        intro b
        have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE π₁ r U U' U e₁ e₂
        have heq : (r.appLE U U' e₁ ≫ π₁.appLE U' U e₂) =
            φ_P.appLE U U (by rw [hφ_P.2.1]; exact le_rfl) := by
          rw [hcomp]
          congr 1
        exact (congrArg (fun f => f.hom b) heq).trans (hφ_P.2.2 U _ b)
      exact hRingBij (hφ_P.1 U) (r.appLE U U' e₁).hom (π₁.appLE U' U e₂).hom hEt_Φ hΦθ hθΦ
    have h_stalk_appLE : ∀ (U : P.Opens) (U' : V.Opens)
        (e₁ : U' ≤ (TopologicalSpace.Opens.map r.base).obj U)
        (x : ↥V) (hxU' : x ∈ U') (b : ↑(P.presheaf.obj (Opposite.op U))),
        (r.stalkMap x).hom ((P.presheaf.germ U (r.base x) (e₁ hxU')).hom b) =
          (V.presheaf.germ U' x hxU').hom ((r.appLE U U' e₁).hom b) := by
      intro U U' e₁ x hxU' b
      have h1 := congrArg (fun f => f.hom b) (r.germ_stalkMap U x (e₁ hxU'))
      have h2 := congrArg (fun f => f.hom ((r.app U).hom b))
        (V.presheaf.germ_res (CategoryTheory.homOfLE e₁) x hxU')
      have h3 : (V.presheaf.map (CategoryTheory.homOfLE e₁).op).hom ((r.app U).hom b) =
          (r.appLE U U' e₁).hom b := by
        have happ := r.appLE_map (le_rfl : (TopologicalSpace.Opens.map r.base).obj U ≤ _)
          (CategoryTheory.homOfLE e₁).op
        rw [← r.app_eq_appLE] at happ
        exact congrArg (fun f => f.hom b) happ
      exact h1.trans (h2.symm.trans (congrArg (V.presheaf.germ U' x hxU').hom h3))
    refine (AlgebraicGeometry.isIso_iff_isIso_stalkMap r).mpr ⟨hIsoBase, fun x => ?_⟩
    rw [CategoryTheory.ConcreteCategory.isIso_iff_bijective]
    change Function.Bijective (r.stalkMap x).hom
    refine ⟨?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro ξ hξ
      obtain ⟨W₁, hrxW₁, b₁, rfl⟩ := P.presheaf.exists_germ_eq ξ
      obtain ⟨U', hU', hxU', hU'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x)
          (U := (TopologicalSpace.Opens.map r.base).obj W₁) hrxW₁
      let U : P.Opens := (TopologicalSpace.Opens.map π₁.base).obj U'
      have e₁ : U' ≤ (TopologicalSpace.Opens.map r.base).obj U := by
        intro z hz
        change π₁.base (r.base z) ∈ U'
        rwa [hrπ_pt z]
      have hUW₁ : U ≤ W₁ := by
        intro y hy
        have h1 : r.base (π₁.base y) ∈ W₁ := hU'_sub hy
        rwa [hπr_pt y] at h1
      let b : ↑(P.presheaf.obj (Opposite.op U)) :=
        (P.presheaf.map (CategoryTheory.homOfLE hUW₁).op).hom b₁
      have hb_germ : (P.presheaf.germ U (r.base x) (e₁ hxU')).hom b =
          (P.presheaf.germ W₁ (r.base x) hrxW₁).hom b₁ :=
        congrArg (fun f => f.hom b₁)
          (P.presheaf.germ_res (CategoryTheory.homOfLE hUW₁) (r.base x) (e₁ hxU'))
      have hg0 : (V.presheaf.germ U' x hxU').hom ((r.appLE U U' e₁).hom b) =
          (V.presheaf.germ U' x hxU').hom 0 := by
        rw [← h_stalk_appLE U U' e₁ x hxU' b, hb_germ, hξ, map_zero]
      obtain ⟨V₀, hxV₀, iV₀, jV₀, hres0⟩ :=
        V.presheaf.germ_eq (x := x) hxU' hxU' ((r.appLE U U' e₁).hom b) 0 hg0
      rw [map_zero] at hres0
      obtain ⟨U'', hU'', hxU'', hU''_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hxV₀
      have hU''_U' : U'' ≤ U' := fun z hz => iV₀.le (hU''_sub hz)
      let U₂ : P.Opens := (TopologicalSpace.Opens.map π₁.base).obj U''
      have hU₂_U : U₂ ≤ U := fun y hy => hU''_U' hy
      have e₁'' : U'' ≤ (TopologicalSpace.Opens.map r.base).obj U₂ := by
        intro z hz
        change π₁.base (r.base z) ∈ U''
        rwa [hrπ_pt z]
      let b₂ : ↑(P.presheaf.obj (Opposite.op U₂)) :=
        (P.presheaf.map (CategoryTheory.homOfLE hU₂_U).op).hom b
      have hb₂_map : (r.appLE U₂ U'' e₁'').hom b₂ = 0 := by
        have hm1 := r.map_appLE e₁'' (CategoryTheory.homOfLE hU₂_U).op
        have hm2 := r.appLE_map e₁ (CategoryTheory.homOfLE hU''_U').op
        have heq_app : CategoryTheory.CategoryStruct.comp
            (P.presheaf.map (CategoryTheory.homOfLE hU₂_U).op) (r.appLE U₂ U'' e₁'') =
            CategoryTheory.CategoryStruct.comp (r.appLE U U' e₁)
              (V.presheaf.map (CategoryTheory.homOfLE hU''_U').op) := hm1.trans hm2.symm
        have heval := congrArg (fun f => f.hom b) heq_app
        change (r.appLE U₂ U'' e₁'').hom b₂ =
          (V.presheaf.map (CategoryTheory.homOfLE hU''_U').op).hom ((r.appLE U U' e₁).hom b) at heval
        have hcomp_i : CategoryTheory.homOfLE hU''_U' =
            CategoryTheory.homOfLE hU''_sub ≫ iV₀ := Subsingleton.elim _ _
        have hmap_i : V.presheaf.map (CategoryTheory.homOfLE hU''_U').op =
            V.presheaf.map iV₀.op ≫ V.presheaf.map (CategoryTheory.homOfLE hU''_sub).op := by
          rw [hcomp_i]
          exact V.presheaf.map_comp iV₀.op (CategoryTheory.homOfLE hU''_sub).op
        rw [hmap_i, CommRingCat.hom_comp, RingHom.comp_apply, hres0, map_zero] at heval
        exact heval
      have hb₂_zero : b₂ = 0 :=
        (hAffBij U'' hU'' e₁'').1 (hb₂_map.trans (map_zero _).symm)
      have hb₂_germ : (P.presheaf.germ U₂ (r.base x) (e₁'' hxU'')).hom b₂ =
          (P.presheaf.germ U (r.base x) (e₁ hxU')).hom b :=
        congrArg (fun f => f.hom b)
          (P.presheaf.germ_res (CategoryTheory.homOfLE hU₂_U) (r.base x) (e₁'' hxU''))
      rw [← hb_germ, ← hb₂_germ, hb₂_zero, map_zero]
    · intro g
      obtain ⟨W₀, hxW₀, a₀, rfl⟩ := V.presheaf.exists_germ_eq g
      obtain ⟨U', hU', hxU', hU'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hxW₀
      let U : P.Opens := (TopologicalSpace.Opens.map π₁.base).obj U'
      have e₁ : U' ≤ (TopologicalSpace.Opens.map r.base).obj U := by
        intro z hz
        change π₁.base (r.base z) ∈ U'
        rwa [hrπ_pt z]
      let a' : ↑(V.presheaf.obj (Opposite.op U')) :=
        (V.presheaf.map (CategoryTheory.homOfLE hU'_sub).op).hom a₀
      obtain ⟨b, hb⟩ := (hAffBij U' hU' e₁).2 a'
      refine ⟨(P.presheaf.germ U (r.base x) (e₁ hxU')).hom b, ?_⟩
      rw [h_stalk_appLE U U' e₁ x hxU' b, hb]
      exact congrArg (fun f => f.hom a₀)
        (V.presheaf.germ_res (CategoryTheory.homOfLE hU'_sub) x hxU')

  
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) φ_abs :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) φ_abs :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hppb hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hppb hg)
  let B : CategoryTheory.Functor W.Etale W.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ φ_abs
  have hφ_aff : AlgebraicGeometry.IsAffineHom φ_abs := by
    refine AlgebraicGeometry.IsAffineHom.mk (fun U hU => ?_)
    have hpre : (TopologicalSpace.Opens.map φ_abs.base).obj U = U := by
      rw [hφ_abs.2.1]; rfl
    rwa [hpre]
  let φ_obj : ∀ V : W.Etale, V.left ⟶ V.left :=
    fun V => Classical.choose (hExFrob V.hom)
  have hφ_obj : ∀ V : W.Etale, WeilTopDegIsIteratedAbsFrob p ν V.left (φ_obj V) :=
    fun V => Classical.choose_spec (hExFrob V.hom)
  have hcomm_obj : ∀ V : W.Etale, φ_obj V ≫ V.hom = V.hom ≫ φ_abs :=
    fun V => hNatFrob (φ_obj V) φ_abs V.hom (hφ_obj V) hφ_abs
  let r_obj : ∀ V : W.Etale, V.left ⟶ CategoryTheory.Limits.pullback V.hom φ_abs :=
    fun V => CategoryTheory.Limits.pullback.lift (φ_obj V) V.hom (hcomm_obj V)
  let ρ : CategoryTheory.Functor.id W.Etale ⟶ B :=
    { app := fun V => CategoryTheory.MorphismProperty.Over.homMk (r_obj V)
        (by
          change r_obj V ≫ CategoryTheory.Limits.pullback.snd V.hom φ_abs = V.hom
          exact CategoryTheory.Limits.pullback.lift_snd _ _ _)
        trivial
      naturality := fun V₁ V₂ u => by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        have hBmap := CategoryTheory.MorphismProperty.Over.pullback_map_left
          (@AlgebraicGeometry.Etale) ⊤ φ_abs u
        have hw_u : CategoryTheory.Limits.pullback.fst V₁.hom φ_abs ≫ u.left ≫ V₂.hom =
            CategoryTheory.Limits.pullback.snd V₁.hom φ_abs ≫ φ_abs := by
          rw [CategoryTheory.MorphismProperty.Over.w u, CategoryTheory.Limits.pullback.condition]
        have h_pb : u.left ≫ r_obj V₂ =
            r_obj V₁ ≫ CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst V₁.hom φ_abs ≫ u.left)
              (CategoryTheory.Limits.pullback.snd V₁.hom φ_abs) hw_u := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hL : (u.left ≫ r_obj V₂) ≫ CategoryTheory.Limits.pullback.fst V₂.hom φ_abs =
                φ_obj V₁ ≫ u.left :=
              (CategoryTheory.Category.assoc u.left (r_obj V₂) _).trans
                ((congrArg (u.left ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  (hNatFrob (φ_obj V₁) (φ_obj V₂) u.left (hφ_obj V₁) (hφ_obj V₂)).symm)
            have hR : (r_obj V₁ ≫ CategoryTheory.Limits.pullback.lift
                  (CategoryTheory.Limits.pullback.fst V₁.hom φ_abs ≫ u.left)
                  (CategoryTheory.Limits.pullback.snd V₁.hom φ_abs) hw_u) ≫
                CategoryTheory.Limits.pullback.fst V₂.hom φ_abs = φ_obj V₁ ≫ u.left :=
              (CategoryTheory.Category.assoc (r_obj V₁) _ _).trans
                ((congrArg (r_obj V₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((CategoryTheory.Category.assoc (r_obj V₁) _ u.left).symm.trans
                    (congrArg (· ≫ u.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
            exact hL.trans hR.symm
          · have hL : (u.left ≫ r_obj V₂) ≫ CategoryTheory.Limits.pullback.snd V₂.hom φ_abs =
                V₁.hom :=
              (CategoryTheory.Category.assoc u.left (r_obj V₂) _).trans
                ((congrArg (u.left ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  (CategoryTheory.MorphismProperty.Over.w u))
            have hR : (r_obj V₁ ≫ CategoryTheory.Limits.pullback.lift
                  (CategoryTheory.Limits.pullback.fst V₁.hom φ_abs ≫ u.left)
                  (CategoryTheory.Limits.pullback.snd V₁.hom φ_abs) hw_u) ≫
                CategoryTheory.Limits.pullback.snd V₂.hom φ_abs = V₁.hom :=
              (CategoryTheory.Category.assoc (r_obj V₁) _ _).trans
                ((congrArg (r_obj V₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _))
            exact hL.trans hR.symm
        exact h_pb.trans (congrArg (r_obj V₁ ≫ ·) hBmap.symm) }
  have hρ_iso : ∀ V : W.Etale, CategoryTheory.IsIso (ρ.app V) := by
    intro V
    let P_V := CategoryTheory.Limits.pullback V.hom φ_abs
    let π₁ : P_V ⟶ V.left := CategoryTheory.Limits.pullback.fst V.hom φ_abs
    let π₂ : P_V ⟶ W := CategoryTheory.Limits.pullback.snd V.hom φ_abs
    obtain ⟨φ_P, hφ_P⟩ := hExFrob π₂
    have hr_snd : r_obj V ≫ π₂ = V.hom := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hr_et : AlgebraicGeometry.Etale (r_obj V) := by
      refine @CategoryTheory.MorphismProperty.of_postcomp _ _
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) inferInstance _ _ _
        (r_obj V) π₂ (B.obj V).prop ?_
      rw [hr_snd]
      exact V.prop
    have hπ₁_aff : AlgebraicGeometry.IsAffineHom π₁ := by
      have h_st : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.IsAffineHom) V.hom :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hppb hg =>
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hppb hg)
      exact @CategoryTheory.MorphismProperty.pullback_fst _ _
        (@AlgebraicGeometry.IsAffineHom) _ _ _ V.hom φ_abs _ h_st hφ_aff
    have hrπ : r_obj V ≫ π₁ = φ_obj V := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hπr : π₁ ≫ r_obj V = φ_P := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hrπ]
        exact (hNatFrob φ_P (φ_obj V) π₁ hφ_P (hφ_obj V)).symm
      · rw [CategoryTheory.Category.assoc, hr_snd, CategoryTheory.Limits.pullback.condition]
        exact (hNatFrob φ_P φ_abs π₂ hφ_P hφ_abs).symm
    have hIso_r : CategoryTheory.IsIso (r_obj V) :=
      hSchemeIso (r_obj V) π₁ (φ_obj V) φ_P hr_et hπ₁_aff (hφ_obj V) hφ_P hrπ hπr
    let e_r : V.left ≅ (B.obj V).left := @CategoryTheory.asIso _ _ _ _ (r_obj V) hIso_r
    let iso_V : V ≅ B.obj V :=
      CategoryTheory.MorphismProperty.Over.isoMk e_r hr_snd
    have h_hom_eq : iso_V.hom = ρ.app V := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact CategoryTheory.MorphismProperty.Over.isoMk_hom_left e_r hr_snd
    rw [← h_hom_eq]
    infer_instance
  have : CategoryTheory.IsIso ρ := CategoryTheory.NatIso.isIso_of_isIso_app ρ
  let e : CategoryTheory.Functor.id W.Etale ≅ B := CategoryTheory.asIso ρ

  
  have hB_cont : B.IsContinuous W.smallEtaleTopology W.smallEtaleTopology :=
    @CategoryTheory.Functor.isContinuous_of_iso _ _ _ _
      (CategoryTheory.Functor.id W.Etale) B e
      W.smallEtaleTopology W.smallEtaleTopology
      (CategoryTheory.Functor.isContinuous_id W.smallEtaleTopology)
  let e_push : CategoryTheory.Functor.id
      (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) ≅
      B.sheafPushforwardContinuous AddCommGrpCat.{u}
        W.smallEtaleTopology W.smallEtaleTopology :=
    CategoryTheory.NatIso.ofComponents
      (fun ℱ =>
        { hom := CategoryTheory.ObjectProperty.homMk
            { app := fun X => ℱ.obj.map (Opposite.op (e.inv.app X.unop))
              naturality := fun X Y f => by
                change ℱ.obj.map f ≫ ℱ.obj.map (Opposite.op (e.inv.app Y.unop)) =
                  ℱ.obj.map (Opposite.op (e.inv.app X.unop)) ≫
                    ℱ.obj.map (Opposite.op (B.map f.unop))
                rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                exact congrArg (fun g => ℱ.obj.map (Opposite.op g)) (e.inv.naturality f.unop).symm }
          inv := CategoryTheory.ObjectProperty.homMk
            { app := fun X => ℱ.obj.map (Opposite.op (e.hom.app X.unop))
              naturality := fun X Y f => by
                change ℱ.obj.map (Opposite.op (B.map f.unop)) ≫
                    ℱ.obj.map (Opposite.op (e.hom.app Y.unop)) =
                  ℱ.obj.map (Opposite.op (e.hom.app X.unop)) ≫ ℱ.obj.map f
                rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                exact congrArg (fun g => ℱ.obj.map (Opposite.op g)) (e.hom.naturality f.unop).symm }
          hom_inv_id := by
            ext X : 3
            change ℱ.obj.map (Opposite.op (e.inv.app X.unop)) ≫
              ℱ.obj.map (Opposite.op (e.hom.app X.unop)) = 𝟙 (ℱ.obj.obj X)
            rw [← ℱ.obj.map_comp]
            exact (congrArg (fun g => ℱ.obj.map (Opposite.op g))
              (e.hom_inv_id_app X.unop)).trans (ℱ.obj.map_id X)
          inv_hom_id := by
            ext X : 3
            change ℱ.obj.map (Opposite.op (e.hom.app X.unop)) ≫
              ℱ.obj.map (Opposite.op (e.inv.app X.unop)) =
                𝟙 (ℱ.obj.obj (Opposite.op (B.obj X.unop)))
            rw [← ℱ.obj.map_comp]
            exact (congrArg (fun g => ℱ.obj.map (Opposite.op g))
              (e.inv_hom_id_app X.unop)).trans
              (ℱ.obj.map_id (Opposite.op (B.obj X.unop))) })
      (fun {ℱ₁ ℱ₂} φ => by
        ext X : 3
        exact (φ.hom.naturality (Opposite.op (e.inv.app X.unop))).symm)
  let adj_pull := CategoryTheory.Adjunction.id.ofNatIsoRight e_push
  let T₁ : W.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id W)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id W))
  let hT₁ : CategoryTheory.Limits.IsTerminal T₁ :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun V => CategoryTheory.MorphismProperty.Over.homMk V.hom
        (CategoryTheory.Category.comp_id V.hom) trivial)
      (fun V g => by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g))
  let adj := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT₁
  let τ : B.obj T₁ ⟶ T₁ := hT₁.from (B.obj T₁)
  have he_τ : e.inv.app T₁ = τ := hT₁.hom_ext (e.inv.app T₁) τ
  have hπ_id : ∀ A : AddCommGrpCat.{u},
      let CA := (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A
      (adj_pull.homEquiv CA CA).symm
        ((adj.homEquiv A
          ((B.sheafPushforwardContinuous AddCommGrpCat.{u}
            W.smallEtaleTopology W.smallEtaleTopology).obj CA)).symm
          (adj.unit.app A ≫ CA.obj.map (Opposite.op τ))) = 𝟙 CA := by
    intro A CA
    have h1 : adj_pull.homEquiv CA CA (𝟙 CA) = e_push.hom.app CA := by
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      dsimp [adj_pull, CategoryTheory.Adjunction.ofNatIsoRight]
      simp
    have h2 : adj.homEquiv A
        ((B.sheafPushforwardContinuous AddCommGrpCat.{u}
          W.smallEtaleTopology W.smallEtaleTopology).obj CA)
        (adj_pull.homEquiv CA CA (𝟙 CA)) =
        adj.unit.app A ≫ CA.obj.map (Opposite.op τ) := by
      rw [h1, CategoryTheory.Adjunction.homEquiv_unit]
      change adj.unit.app A ≫ CA.obj.map (Opposite.op (e.inv.app T₁)) =
        adj.unit.app A ≫ CA.obj.map (Opposite.op τ)
      rw [he_τ]
    exact (congrArg (fun z => (adj_pull.homEquiv CA CA).symm
      ((adj.homEquiv A _).symm z)) h2.symm).trans (by simp)
  refine ⟨hB_cont,
    CategoryTheory.Functor.id (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
    adj_pull, inferInstance, inferInstance, inferInstance,
    T₁, hT₁, T₁, hT₁,
    𝟙 ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))),
    ?_, ?_, ?_⟩
  · dsimp only
    rw [hπ_id, CategoryTheory.Category.id_comp]
  · dsimp only
    rw [hπ_id]
    exact CategoryTheory.Category.id_comp _
  · intro x
    dsimp only
    rw [hπ_id]
    change x = ((CategoryTheory.Abelian.Ext.mk₀ (𝟙 _)).comp
      (((CategoryTheory.Functor.id _).mapExtAddHom _ _ k) x) (Nat.zero_add k)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (𝟙 _)) (Nat.add_zero k)
    rw [CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.id_mapExactFunctor,
      CategoryTheory.Abelian.Ext.mk₀_id_comp,
      CategoryTheory.Abelian.Ext.comp_mk₀_id]

theorem weil_rel_frob_factorization_and_locally_free_rank (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Z.hom] :
    let k := AlgebraicClosure K
    let X_bar := weilBaseChangeOver K k Z
    let S := weilGeomScheme K Z
    ∃ (p ν : ℕ) (φ_abs φ_rel : Quiver.Hom S S),
      Nat.Prime p ∧
      WeilTopDegIsIteratedAbsFrob p ν S φ_abs ∧
      CategoryTheory.CategoryStruct.comp φ_abs (weilGeomFrobHom K Z) = φ_rel ∧
      CategoryTheory.CategoryStruct.comp φ_rel X_bar.hom = X_bar.hom ∧
      WeilTopDegFiniteLocallyFreeOfRank (Nat.card K ^ d) φ_rel :=
by
  classical
  intro k X_bar S
  let _ : Fintype K := Fintype.ofFinite K
  have hcard_eq : Fintype.card K = Nat.card K := (Nat.card_eq_fintype_card (α := K)).symm
  let p : ℕ := ringChar K
  obtain ⟨n_pos, hp_prime, hcard_fin⟩ := FiniteField.card K p
  let ν : ℕ := n_pos.val
  have hq_pow : Nat.card K = p ^ ν := hcard_eq.symm.trans hcard_fin
  let Q : ℕ := p ^ ν
  have hQ_pos : 0 < Q := pow_pos hp_prime.pos ν
  have hQ_ne : Q ≠ 0 := hQ_pos.ne'
  have hp_K : ((p : ℕ) : K) = 0 := CharP.cast_eq_zero K p
  have hc_K : ∀ c : K, c ^ Q = c := fun c => by
    change c ^ (p ^ ν) = c
    rw [← hcard_fin]
    exact FiniteField.pow_card c
  let φ_arith := @FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
    (AlgebraicClosure K) _ _ _
  let ψ := φ_arith.symm
  have hψ_pow : ∀ c : AlgebraicClosure K, (ψ c) ^ Q = c := by
    intro c
    change (ψ c) ^ (p ^ ν) = c
    rw [← hcard_fin, ← FiniteField.frobeniusAlgEquivOfAlgebraic_apply K (AlgebraicClosure K) (ψ c)]
    exact φ_arith.apply_symm_apply c
  have h_spec_ext : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}} (h₁ h₂ : T ⟶ Spec R),
      h₁.appTop = h₂.appTop → h₁ = h₂ := by
    intro T R h₁ h₂ heq
    let φ₁ : R ⟶ T.presheaf.obj (Opposite.op ⊤) :=
      ((ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm h₁).unop
    let φ₂ : R ⟶ T.presheaf.obj (Opposite.op ⊤) :=
      ((ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm h₂).unop
    have e₁ : (Scheme.ΓSpecIso R).hom ≫ φ₁ = h₁.appTop := by
      rw [← ΓSpec_adjunction_homEquiv_eq φ₁]
      congr 1
      exact (ΓSpec.adjunction.homEquiv T (Opposite.op R)).apply_symm_apply h₁
    have e₂ : (Scheme.ΓSpecIso R).hom ≫ φ₂ = h₂.appTop := by
      rw [← ΓSpec_adjunction_homEquiv_eq φ₂]
      congr 1
      exact (ΓSpec.adjunction.homEquiv T (Opposite.op R)).apply_symm_apply h₂
    have hφ : φ₁ = φ₂ :=
      (Iso.cancel_iso_hom_left (Scheme.ΓSpecIso R) φ₁ φ₂).mp (by rw [e₁, heq, ← e₂])
    exact (ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm.injective
      (Quiver.Hom.unop_inj hφ)
  have h_add_p : ∀ (A : Type u) [CommRing A], ((p : ℕ) : A) = 0 →
      ∀ x y : A, (x + y) ^ p = x ^ p + y ^ p := by
    intro A _ hpA x y
    rw [add_pow, Finset.sum_range_succ]
    have hsum0 : (∑ m ∈ Finset.range p, x ^ m * y ^ (p - m) * (p.choose m : A)) = y ^ p := by
      rw [Finset.sum_eq_single 0]
      · simp
      · intro m hm hm0
        obtain ⟨l, hl⟩ := hp_prime.dvd_choose_self hm0 (Finset.mem_range.mp hm)
        have hchoose : ((p.choose m : ℕ) : A) = 0 := by
          rw [hl, Nat.cast_mul, hpA, zero_mul]
        rw [hchoose, mul_zero]
      · intro h0
        exact False.elim (h0 (Finset.mem_range.mpr hp_prime.pos))
    rw [hsum0]
    simp [add_comm]
  let iterFrob : ∀ (A : Type u) [CommRing A], ((p : ℕ) : A) = 0 → (A →+* A) :=
    fun A _ hpA =>
      let frob₁ : A →+* A :=
        { toFun := fun a => a ^ p
          map_one' := one_pow p
          map_mul' := fun x y => mul_pow x y p
          map_zero' := zero_pow hp_prime.ne_zero
          map_add' := h_add_p A hpA }
      Nat.rec (RingHom.id A) (fun _ g => frob₁.comp g) ν
  have h_iterFrob : ∀ (A : Type u) [CommRing A] (hpA : ((p : ℕ) : A) = 0) (a : A),
      iterFrob A hpA a = a ^ Q := by
    intro A _ hpA
    let frob₁ : A →+* A :=
      { toFun := fun a => a ^ p
        map_one' := one_pow p
        map_mul' := fun x y => mul_pow x y p
        map_zero' := zero_pow hp_prime.ne_zero
        map_add' := h_add_p A hpA }
    have hrec : ∀ (n : ℕ) (a : A),
        (Nat.rec (RingHom.id A) (fun _ g => frob₁.comp g) n : A →+* A) a = a ^ (p ^ n) := by
      intro n
      induction n with
      | zero => intro a; simp
      | succ n ih =>
        intro a
        change ((Nat.rec (RingHom.id A) (fun _ g => frob₁.comp g) n : A →+* A) a) ^ p =
          a ^ (p ^ (n + 1))
        rw [ih a, ← pow_mul, ← pow_succ]
    exact hrec ν
  have hp_sec : ∀ (W : Scheme.{u}) (hW : W ⟶ Spec (CommRingCat.of K)) (U : W.Opens),
      ((p : ℕ) : ↑(W.presheaf.obj (Opposite.op U))) = 0 := by
    intro W hW U
    let κU : K →+* ↑(W.presheaf.obj (Opposite.op U)) :=
      ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ hW.appTop ≫
        W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
    rw [← map_natCast κU p, hp_K, map_zero]
  let frOfHom : ∀ (W : Scheme.{u}), (W ⟶ Spec (CommRingCat.of K)) → (W ⟶ W) :=
    fun W hW =>
      let pHom : W.toPresheafedSpace ⟶ W.toPresheafedSpace :=
        { base := 𝟙 W.toTopCat
          c :=
            { app := fun U =>
                CommRingCat.ofHom (iterFrob _ (hp_sec W hW (Opposite.unop U)))
              naturality := fun U V i => by
                ext s
                change iterFrob _ (hp_sec W hW (Opposite.unop V)) ((W.presheaf.map i).hom s) =
                  (W.presheaf.map i).hom (iterFrob _ (hp_sec W hW (Opposite.unop U)) s)
                rw [h_iterFrob _ (hp_sec W hW (Opposite.unop V)),
                  h_iterFrob _ (hp_sec W hW (Opposite.unop U)), map_pow] } }
      AlgebraicGeometry.Scheme.Hom.mk
        (AlgebraicGeometry.LocallyRingedSpace.Hom.mk pHom (fun x => by
          refine ⟨fun a ha => ?_⟩
          obtain ⟨U, hxU, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq W.presheaf a
          have hst := AlgebraicGeometry.PresheafedSpace.stalkMap_germ_apply pHom U x hxU s
          erw [hst] at ha
          let g_hom : ↑(W.presheaf.obj (Opposite.op U)) →+* ↑(W.presheaf.stalk x) :=
            (W.presheaf.germ U x hxU).hom
          have ha' : IsUnit (g_hom (iterFrob _ (hp_sec W hW U) s)) := ha
          rw [h_iterFrob _ (hp_sec W hW U), map_pow] at ha'
          exact (isUnit_pow_iff hQ_ne).mp ha'))
  have h_fr_app : ∀ (W : Scheme.{u}) (hW : W ⟶ Spec (CommRingCat.of K)) (U : W.Opens)
      (s : ↑(W.presheaf.obj (Opposite.op U))),
      ((frOfHom W hW).app U).hom s = s ^ Q :=
    fun W hW U s => h_iterFrob _ (hp_sec W hW U) s
  have h_fr_prop : ∀ (W : Scheme.{u}) (hW : W ⟶ Spec (CommRingCat.of K)),
      WeilTopDegIsIteratedAbsFrob p ν W (frOfHom W hW) := by
    intro W hW
    refine ⟨hp_sec W hW, rfl, ?_⟩
    intro U e s
    have heq_app : (frOfHom W hW).appLE U U e = (frOfHom W hW).app U :=
      Scheme.Hom.appLE_eq_app (frOfHom W hW)
    rw [heq_app]
    exact h_fr_app W hW U s
  let f₂ : Spec (CommRingCat.of (AlgebraicClosure K)) ⟶ Spec (CommRingCat.of K) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
  let P : Scheme.{u} := CategoryTheory.Limits.pullback Z.hom f₂
  let fst : P ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom f₂
  let snd : P ⟶ Spec (CommRingCat.of (AlgebraicClosure K)) :=
    CategoryTheory.Limits.pullback.snd Z.hom f₂
  let frZ : Z.left ⟶ Z.left := frOfHom Z.left Z.hom
  have hfrZ_prop : WeilTopDegIsIteratedAbsFrob p ν Z.left frZ := h_fr_prop Z.left Z.hom
  let φ_abs : P ⟶ P := frOfHom P (fst ≫ Z.hom)
  have hφ_abs_prop : WeilTopDegIsIteratedAbsFrob p ν P φ_abs := h_fr_prop P (fst ≫ Z.hom)
  have h_nat : φ_abs ≫ fst = fst ≫ frZ := by
    refine AlgebraicGeometry.Scheme.Hom.ext rfl (fun U => ?_)
    erw [P.presheaf.map_id, Category.comp_id]
    ext s
    change ((frOfHom P (fst ≫ Z.hom)).app ((TopologicalSpace.Opens.map fst.base).obj U)).hom
        ((fst.app U).hom s) =
      (fst.app U).hom (((frOfHom Z.left Z.hom).app U).hom s)
    rw [h_fr_app P (fst ≫ Z.hom), h_fr_app Z.left Z.hom, map_pow]
  have hfrZ_over : frZ ≫ Z.hom = Z.hom := by
    apply h_spec_ext
    apply (Iso.cancel_iso_inv_left (Scheme.ΓSpecIso (CommRingCat.of K))
      (frZ ≫ Z.hom).appTop Z.hom.appTop).mp
    ext c
    rw [Scheme.Hom.comp_appTop, ← Category.assoc]
    change ((frOfHom Z.left Z.hom).app ⊤).hom
        (((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ Z.hom.appTop).hom c) =
      ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ Z.hom.appTop).hom c
    rw [h_fr_app Z.left Z.hom, ← map_pow, hc_K]
  let φ_rel : P ⟶ P := CategoryTheory.Limits.pullback.map Z.hom f₂ Z.hom f₂
    frZ (𝟙 (Spec (CommRingCat.of (AlgebraicClosure K)))) (𝟙 (Spec (CommRingCat.of K)))
    (by rw [Category.comp_id, hfrZ_over])
    (by rw [Category.id_comp, Category.comp_id])
  have hφ_over : φ_rel ≫ snd = snd := by
    dsimp [φ_rel, snd]
    rw [CategoryTheory.Limits.pullback.lift_snd, Category.comp_id]
  have hφ_fst : φ_rel ≫ fst = fst ≫ frZ := by
    dsimp [φ_rel, fst]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  let g_frob : P ⟶ P := weilGeomFrobHom K Z
  have hFactor : φ_abs ≫ g_frob = φ_rel := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc]
      have hg_fst : g_frob ≫ fst = fst := by
        dsimp [g_frob, weilGeomFrobHom, fst, f₂]
        rw [CategoryTheory.Limits.pullback.lift_fst, Category.comp_id]
      rw [hg_fst, h_nat, hφ_fst]
    · rw [hφ_over, Category.assoc]
      let i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
      have hg_snd : g_frob ≫ snd = snd ≫ i₂ := by
        dsimp [g_frob, weilGeomFrobHom, snd, f₂, i₂, ψ, φ_arith]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [hg_snd, ← Category.assoc]
      apply h_spec_ext
      apply (Iso.cancel_iso_inv_left (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K)))
        ((φ_abs ≫ snd) ≫ i₂).appTop snd.appTop).mp
      have hnat_i₂ := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ψ.toRingHom)
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, ← Category.assoc, ← Category.assoc]
      have hrew : (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K))).inv ≫ i₂.appTop =
          CommRingCat.ofHom ψ.toRingHom ≫
            (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K))).inv := by
        apply (Iso.cancel_iso_hom_right _ _
          (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K)))).mp
        rw [Category.assoc, hnat_i₂, Category.assoc, Iso.inv_hom_id, Category.comp_id,
          ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
      rw [hrew]
      ext c
      simp only [Category.assoc, CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
      change ((frOfHom P (fst ≫ Z.hom)).app ⊤).hom
          (((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K))).inv ≫ snd.appTop).hom (ψ c)) =
        ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K))).inv ≫ snd.appTop).hom c
      rw [h_fr_app P (fst ≫ Z.hom), ← map_pow, hψ_pow]
  have h_poly_basis : ∀ (R : Type u) [CommRing R],
      ((p : ℕ) : R) = 0 → (∀ c : R, c ^ Q = c) →
      ∃ (σ_R : MvPolynomial (Fin d) R →+* MvPolynomial (Fin d) R)
        (m : Fin (Q ^ d) → MvPolynomial (Fin d) R),
        (∀ P_pol : MvPolynomial (Fin d) R, σ_R P_pol = P_pol ^ Q) ∧
        Function.Bijective (fun (f : Fin (Q ^ d) → MvPolynomial (Fin d) R) =>
          ∑ j : Fin (Q ^ d), σ_R (f j) * m j) := by
    intro R _ hp_zero hc
    have hp_poly : ((p : ℕ) : MvPolynomial (Fin d) R) = 0 := by
      rw [← MvPolynomial.C_eq_coe_nat, hp_zero, map_zero]
    let σ_R : MvPolynomial (Fin d) R →+* MvPolynomial (Fin d) R := iterFrob _ hp_poly
    have hσ_R : ∀ P_pol : MvPolynomial (Fin d) R, σ_R P_pol = P_pol ^ Q := h_iterFrob _ hp_poly
    have hmon_pow : ∀ (n : ℕ) (s : Fin d →₀ ℕ) (c : R),
        (MvPolynomial.monomial s c) ^ n = MvPolynomial.monomial (n • s) (c ^ n) := by
      intro n s c
      induction n with
      | zero => simp [MvPolynomial.monomial_zero']
      | succ n ih =>
        rw [pow_succ, ih, MvPolynomial.monomial_mul_monomial, add_smul, one_smul, pow_succ]
    have hσ_mon : ∀ (s : Fin d →₀ ℕ) (c : R),
        σ_R (MvPolynomial.monomial s c) = MvPolynomial.monomial (Q • s) c := by
      intro s c
      rw [hσ_R, hmon_pow Q s c, hc c]
    have hcard : Fintype.card (Fin d → Fin Q) = Q ^ d := by simp
    let e_idx : Fin (Q ^ d) ≃ (Fin d → Fin Q) := (Fintype.equivFinOfCardEq hcard).symm
    let e_hat : Fin (Q ^ d) → (Fin d →₀ ℕ) :=
      fun j => Finsupp.equivFunOnFinite.symm (fun i => (e_idx j i).val)
    let m : Fin (Q ^ d) → MvPolynomial (Fin d) R :=
      fun j => MvPolynomial.monomial (e_hat j) 1
    let j_mod : (Fin d →₀ ℕ) → Fin (Q ^ d) :=
      fun t => e_idx.symm (fun i => ⟨t i % Q, Nat.mod_lt (t i) hQ_pos⟩)
    let t_div : (Fin d →₀ ℕ) → (Fin d →₀ ℕ) :=
      fun t => Finsupp.equivFunOnFinite.symm (fun i => t i / Q)
    have h_decomp : ∀ t : Fin d →₀ ℕ, Q • t_div t + e_hat (j_mod t) = t := by
      intro t
      ext i
      simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, t_div, e_hat, j_mod,
        Finsupp.coe_equivFunOnFinite_symm, Equiv.apply_symm_apply]
      exact Nat.div_add_mod (t i) Q
    have h_div_eq : ∀ (s : Fin d →₀ ℕ) (j : Fin (Q ^ d)),
        t_div (Q • s + e_hat j) = s := by
      intro s j
      ext i
      simp only [t_div, Finsupp.coe_equivFunOnFinite_symm, Finsupp.add_apply,
        Finsupp.smul_apply, smul_eq_mul, e_hat]
      rw [add_comm, mul_comm Q (s i), Nat.add_mul_div_right _ _ hQ_pos,
        Nat.div_eq_of_lt (e_idx j i).isLt, zero_add]
    have h_mod_eq : ∀ (s : Fin d →₀ ℕ) (j : Fin (Q ^ d)),
        j_mod (Q • s + e_hat j) = j := by
      intro s j
      apply e_idx.injective
      rw [Equiv.apply_symm_apply]
      ext i
      simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, e_hat,
        Finsupp.coe_equivFunOnFinite_symm]
      rw [add_comm, mul_comm Q (s i), Nat.add_mul_mod_self_right,
        Nat.mod_eq_of_lt (e_idx j i).isLt]
    have h_coeff_term : ∀ (g : MvPolynomial (Fin d) R) (j : Fin (Q ^ d)) (t : Fin d →₀ ℕ),
        (σ_R g * m j).coeff t =
          if j = j_mod t then g.coeff (t_div t) else 0 := by
      intro g j t
      conv_lhs => rw [MvPolynomial.as_sum g]
      rw [map_sum, Finset.sum_mul, MvPolynomial.coeff_sum]
      have hterm : ∀ x ∈ g.support,
          (σ_R (MvPolynomial.monomial x (g.coeff x)) * m j).coeff t =
            if Q • x + e_hat j = t then g.coeff x else 0 := by
        intro x _
        dsimp [m]
        rw [hσ_mon, MvPolynomial.monomial_mul_monomial, mul_one, MvPolynomial.coeff_monomial]
      rw [Finset.sum_congr rfl hterm]
      split_ifs with hj
      · subst hj
        by_cases hmem : t_div t ∈ g.support
        · rw [Finset.sum_eq_single (t_div t)]
          · simp [h_decomp t]
          · intro x _ hx_ne
            simp only [ite_eq_right_iff]
            intro heq
            exact False.elim (hx_ne (heq ▸ h_div_eq x (j_mod t)).symm)
          · intro hnot
            exact False.elim (hnot hmem)
        · rw [MvPolynomial.notMem_support_iff.mp hmem]
          apply Finset.sum_eq_zero
          intro x hx
          simp only [ite_eq_right_iff]
          intro heq
          exact False.elim (hmem ((heq ▸ h_div_eq x (j_mod t)) ▸ hx))
      · apply Finset.sum_eq_zero
        intro x _
        simp only [ite_eq_right_iff]
        intro heq
        exact False.elim (hj (heq ▸ h_mod_eq x j).symm)
    let Φ : (Fin (Q ^ d) → MvPolynomial (Fin d) R) → MvPolynomial (Fin d) R :=
      fun f => ∑ j : Fin (Q ^ d), σ_R (f j) * m j
    let Ψ : MvPolynomial (Fin d) R → (Fin (Q ^ d) → MvPolynomial (Fin d) R) :=
      fun P_pol j => ∑ t ∈ P_pol.support,
        if j = j_mod t then MvPolynomial.monomial (t_div t) (P_pol.coeff t) else 0
    have hΨ_coeff : ∀ (P_pol : MvPolynomial (Fin d) R) (j : Fin (Q ^ d)) (s : Fin d →₀ ℕ),
        (Ψ P_pol j).coeff s = P_pol.coeff (Q • s + e_hat j) := by
      intro P_pol j s
      dsimp [Ψ]
      rw [MvPolynomial.coeff_sum]
      by_cases hmem : Q • s + e_hat j ∈ P_pol.support
      · rw [Finset.sum_eq_single (Q • s + e_hat j)]
        · have hj_eq : j = j_mod (Q • s + e_hat j) := (h_mod_eq s j).symm
          have hs_eq : t_div (Q • s + e_hat j) = s := h_div_eq s j
          rw [ite_eq_left_iff.mpr (fun h => False.elim (h hj_eq)), MvPolynomial.coeff_monomial,
            ite_eq_left_iff.mpr (fun h => False.elim (h hs_eq))]
        · intro t _ ht_ne
          split_ifs with hj
          · rw [MvPolynomial.coeff_monomial]
            simp only [ite_eq_right_iff]
            intro hs
            exact False.elim (ht_ne (by rw [← hs, hj, h_decomp t]))
          · rfl
        · intro hnot
          exact False.elim (hnot hmem)
      · rw [MvPolynomial.notMem_support_iff.mp hmem]
        apply Finset.sum_eq_zero
        intro t ht
        split_ifs with hj
        · rw [MvPolynomial.coeff_monomial]
          simp only [ite_eq_right_iff]
          intro hs
          have hteq : Q • s + e_hat j = t := by rw [← hs, hj, h_decomp t]
          exact False.elim (hmem (hteq.symm ▸ ht))
        · rfl
    refine ⟨σ_R, m, hσ_R, ?_⟩
    refine Equiv.bijective ⟨Φ, Ψ, ?_, ?_⟩
    · intro f
      ext j s
      rw [hΨ_coeff]
      dsimp [Φ]
      rw [MvPolynomial.coeff_sum]
      simp_rw [h_coeff_term]
      rw [Finset.sum_ite_eq' Finset.univ (j_mod (Q • s + e_hat j))]
      simp [h_mod_eq, h_div_eq]
    · intro P_pol
      ext t
      dsimp [Φ]
      rw [MvPolynomial.coeff_sum]
      simp_rw [h_coeff_term]
      rw [Finset.sum_ite_eq' Finset.univ (j_mod t)]
      simp [hΨ_coeff, h_decomp]
  have h_etale_transfer : ∀ (R₀ A₀ : Type u) [CommRing R₀] [CommRing A₀] (N : ℕ),
      ((p : ℕ) : R₀) = 0 →
      ∀ (α₀ : R₀ →+* A₀), α₀.Etale →
      ∀ (σ_R : R₀ →+* R₀), (∀ r : R₀, σ_R r = r ^ Q) →
      ∀ (m : Fin N → R₀),
        Function.Bijective (fun f : Fin N → R₀ => ∑ j : Fin N, σ_R (f j) * m j) →
        ∃ (σ_A : A₀ →+* A₀),
          (∀ a : A₀, σ_A a = a ^ Q) ∧
          Function.Bijective (fun c : Fin N → A₀ => ∑ j : Fin N, σ_A (c j) * α₀ (m j)) := by
    intro R₀ A₀ _ _ N hp_R₀ α₀ hα₀ σ_R hσ_R m hm
    have hp_A₀ : ((p : ℕ) : A₀) = 0 := by
      rw [← map_natCast α₀ p, hp_R₀, map_zero]
    let σ_A : A₀ →+* A₀ := iterFrob A₀ hp_A₀
    have hσ_A : ∀ a : A₀, σ_A a = a ^ Q := h_iterFrob A₀ hp_A₀
    have hα_comm : ∀ r : R₀, σ_A (α₀ r) = α₀ (σ_R r) := by
      intro r
      rw [hσ_A, hσ_R, map_pow]
    let R₀' : Type u := ↥(⊤ : Subring R₀)
    let A₀_1 : Type u := ↥(⊤ : Subring A₀)
    let A₀_2 : Type u := ↥(⊤ : Subring A₀_1)
    let eR' : R₀ ≃+* R₀' := Subring.topEquiv.symm
    let eA₁ : A₀ ≃+* A₀_1 := Subring.topEquiv.symm
    let eA₂ : A₀ ≃+* A₀_2 := eA₁.trans Subring.topEquiv.symm
    let _ : Algebra R₀ R₀' := (eR'.toRingHom.comp σ_R).toAlgebra
    let _ : Algebra R₀ A₀_1 := (eA₁.toRingHom.comp α₀).toAlgebra
    have hEt_A₁ : (eA₁.toRingHom.comp α₀).Etale :=
      RingHom.Etale.respectsIso.left α₀ eA₁ hα₀
    have _ : Algebra.Etale R₀ A₀_1 := hEt_A₁.toAlgebra
    let T₀ := TensorProduct R₀ R₀' A₀_1
    have _ : Algebra.Etale R₀' T₀ := Algebra.Etale.baseChange R₀ A₀_1 R₀'
    let Φ_R : (Fin N → R₀) → R₀ := fun f => ∑ j : Fin N, σ_R (f j) * m j
    let e_R : (Fin N → R₀) ≃ R₀ := Equiv.ofBijective Φ_R hm
    have he_R_apply : ∀ f : Fin N → R₀, e_R f = Φ_R f := fun _ => rfl
    have he_R_add : ∀ (x y : R₀) (j : Fin N),
        e_R.symm (x + y) j = e_R.symm x j + e_R.symm y j := by
      intro x y j
      have h1 : e_R (fun l => e_R.symm x l + e_R.symm y l) = e_R (e_R.symm (x + y)) := by
        rw [e_R.apply_symm_apply, he_R_apply]
        dsimp [Φ_R]
        simp_rw [map_add, add_mul, Finset.sum_add_distrib]
        exact congrArg₂ (· + ·) (e_R.apply_symm_apply x) (e_R.apply_symm_apply y)
      exact congrFun (e_R.injective h1).symm j
    have he_R_smul : ∀ (r₀ x : R₀) (j : Fin N),
        e_R.symm (σ_R r₀ * x) j = r₀ * e_R.symm x j := by
      intro r₀ x j
      have h1 : e_R (fun l => r₀ * e_R.symm x l) = e_R (e_R.symm (σ_R r₀ * x)) := by
        rw [e_R.apply_symm_apply, he_R_apply]
        dsimp [Φ_R]
        simp_rw [map_mul, mul_assoc, ← Finset.mul_sum]
        exact congrArg (σ_R r₀ * ·) (e_R.apply_symm_apply x)
      exact congrFun (e_R.injective h1).symm j
    have he_R_single : ∀ (j₀ l : Fin N),
        e_R.symm (m j₀) l = Pi.single (M := fun _ : Fin N => R₀) j₀ 1 l := by
      intro j₀ l
      have h1 : e_R (Pi.single (M := fun _ : Fin N => R₀) j₀ 1) = e_R (e_R.symm (m j₀)) := by
        rw [e_R.apply_symm_apply, he_R_apply]
        dsimp [Φ_R]
        rw [Finset.sum_eq_single j₀]
        · simp
        · intro j _ hj
          rw [Pi.single_eq_of_ne hj, map_zero, zero_mul]
        · intro hnot
          exact False.elim (hnot (Finset.mem_univ j₀))
      exact congrFun (e_R.injective h1).symm l
    let ξ : Fin N → (T₀ →ₗ[R₀] A₀_1) := fun l =>
      TensorProduct.lift
        { toFun := fun r' =>
            { toFun := fun a₁ => eA₁ (α₀ (e_R.symm r'.val l) * a₁.val)
              map_add' := fun a₁ a₂ => by
                change eA₁ (α₀ _ * (a₁.val + a₂.val)) = _
                rw [mul_add, map_add]
              map_smul' := fun r₀ a₁ => by
                change eA₁ (α₀ (e_R.symm r'.val l) * (α₀ r₀ * a₁.val)) =
                  eA₁ (α₀ r₀ * (α₀ (e_R.symm r'.val l) * a₁.val))
                congr 1; ring }
          map_add' := fun r₁' r₂' => by
            ext a₁
            change α₀ (e_R.symm (r₁'.val + r₂'.val) l) * a₁.val =
              α₀ (e_R.symm r₁'.val l) * a₁.val + α₀ (e_R.symm r₂'.val l) * a₁.val
            rw [he_R_add, map_add, add_mul]
          map_smul' := fun r₀ r' => by
            ext a₁
            change α₀ (e_R.symm (σ_R r₀ * r'.val) l) * a₁.val =
              α₀ r₀ * (α₀ (e_R.symm r'.val l) * a₁.val)
            rw [he_R_smul, map_mul, mul_assoc] }
    let Ξ : (Fin N → A₀) → T₀ :=
      fun c => ∑ j : Fin N, (eR' (m j)) ⊗ₜ[R₀] (eA₁ (c j))
    let Ξ_inv : T₀ → (Fin N → A₀) :=
      fun z l => (ξ l z).val
    have hΞ_bij : Function.Bijective Ξ := by
      refine Equiv.bijective ⟨Ξ, Ξ_inv, ?_, ?_⟩
      · intro c
        ext l
        dsimp [Ξ_inv, Ξ]
        rw [map_sum]
        change eA₁.symm (∑ j : Fin N, ξ l ((eR' (m j)) ⊗ₜ[R₀] (eA₁ (c j)))) = c l
        rw [map_sum]
        have hlift : ∀ j : Fin N,
            eA₁.symm (ξ l ((eR' (m j)) ⊗ₜ[R₀] (eA₁ (c j)))) = α₀ (e_R.symm (m j) l) * c j :=
          fun _ => rfl
        simp_rw [hlift, he_R_single]
        rw [Finset.sum_eq_single l]
        · simp
        · intro j _ hj
          rw [Pi.single_eq_of_ne hj.symm, map_zero, zero_mul]
        · intro hnot
          exact False.elim (hnot (Finset.mem_univ l))
      · intro z
        refine TensorProduct.inductionOn (motive := fun z => Ξ (Ξ_inv z) = z) z ?_ ?_
        · intro r' a₁
          dsimp [Ξ, Ξ_inv]
          have hterm : ∀ j : Fin N,
              (eR' (m j)) ⊗ₜ[R₀] (eA₁ (ξ j (r' ⊗ₜ[R₀] a₁)).val) =
                ((e_R.symm r'.val j) • eR' (m j)) ⊗ₜ[R₀] a₁ := by
            intro j
            rw [TensorProduct.smul_tmul]
            congr 1
          simp_rw [hterm]
          rw [← TensorProduct.sum_tmul]
          congr 1
          apply eR'.symm.injective
          rw [map_sum]
          exact e_R.apply_symm_apply r'.val
        · intro x y ihx ihy
          dsimp [Ξ, Ξ_inv] at ihx ihy ⊢
          simp_rw [map_add]
          have hval_add : ∀ j : Fin N, (ξ j x + ξ j y).val = (ξ j x).val + (ξ j y).val :=
            fun _ => rfl
          simp_rw [hval_add, map_add, TensorProduct.tmul_add, Finset.sum_add_distrib]
          rw [ihx, ihy]
    let _ : Algebra R₀ A₀_2 := (eA₂.toRingHom.comp (α₀.comp σ_R)).toAlgebra
    let f_left : R₀' →ₐ[R₀] A₀_2 :=
      { toRingHom := eA₂.toRingHom.comp (α₀.comp eR'.symm.toRingHom)
        commutes' := fun _ => rfl }
    let f_right : A₀_1 →ₐ[R₀] A₀_2 :=
      { toRingHom := eA₂.toRingHom.comp (σ_A.comp eA₁.symm.toRingHom)
        commutes' := fun r => congrArg eA₂ (hα_comm r) }
    let Φ₀_alg : T₀ →ₐ[R₀] A₀_2 :=
      Algebra.TensorProduct.lift f_left f_right (fun _ _ => mul_comm _ _)
    let Φ₀ : T₀ →+* A₀ := eA₂.symm.toRingHom.comp Φ₀_alg.toRingHom
    have hΦ₀_tmul : ∀ (r' : R₀') (a₁ : A₀_1),
        Φ₀ (r' ⊗ₜ[R₀] a₁) = α₀ r'.val * σ_A a₁.val := fun _ _ => rfl
    let Θ₀ : A₀ →+* T₀ :=
      (Algebra.TensorProduct.includeRight : A₀_1 →ₐ[R₀] T₀).toRingHom.comp eA₁.toRingHom
    have hΦΘ : ∀ a : A₀, Φ₀ (Θ₀ a) = a ^ Q := by
      intro a
      change α₀ (1 : R₀) * σ_A a = a ^ Q
      rw [map_one, one_mul, hσ_A]
    have hp_T₀ : ((p : ℕ) : T₀) = 0 := by
      rw [← map_natCast Θ₀ p, hp_A₀, map_zero]
    let σ_T : T₀ →+* T₀ := iterFrob T₀ hp_T₀
    have hσ_T : ∀ z : T₀, σ_T z = z ^ Q := h_iterFrob T₀ hp_T₀
    have hΘΦ : ∀ z : T₀, Θ₀ (Φ₀ z) = z ^ Q := by
      intro z
      rw [← hσ_T z]
      refine TensorProduct.inductionOn (motive := fun z => Θ₀ (Φ₀ z) = σ_T z) z ?_ ?_
      · intro r' a₁
        change (1 : R₀') ⊗ₜ[R₀] eA₁ (α₀ r'.val * σ_A a₁.val) = σ_T (r' ⊗ₜ[R₀] a₁)
        have hmul : (1 : R₀') ⊗ₜ[R₀] eA₁ (α₀ r'.val * σ_A a₁.val) =
            ((1 : R₀') ⊗ₜ[R₀] (r'.val • (1 : A₀_1))) * ((1 : R₀') ⊗ₜ[R₀] eA₁ (a₁.val ^ Q)) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hσ_A]
          congr 1
          apply eA₁.symm.injective
          change α₀ r'.val * a₁.val ^ Q = (α₀ r'.val * 1) * a₁.val ^ Q
          rw [mul_one]
        rw [hmul, ← TensorProduct.smul_tmul]
        have hr' : r'.val • (1 : R₀') = r' ^ Q := by
          change eR' (σ_R r'.val * 1) = r' ^ Q
          rw [mul_one, hσ_R, map_pow]
          rfl
        have ha₁ : eA₁ (a₁.val ^ Q) = a₁ ^ Q := by
          rw [map_pow]
          rfl
        rw [hr', ha₁, hσ_T]
        have hl_pow : (r' ^ Q) ⊗ₜ[R₀] (1 : A₀_1) = (r' ⊗ₜ[R₀] (1 : A₀_1)) ^ Q := by
          rw [← Algebra.TensorProduct.includeLeftRingHom_apply, map_pow,
            Algebra.TensorProduct.includeLeftRingHom_apply]
        have hr_pow : (1 : R₀') ⊗ₜ[R₀] (a₁ ^ Q) = ((1 : R₀') ⊗ₜ[R₀] a₁) ^ Q := by
          change (Algebra.TensorProduct.includeRight : A₀_1 →ₐ[R₀] T₀) (a₁ ^ Q) = _
          rw [map_pow]
          rfl
        rw [hl_pow, hr_pow, ← mul_pow, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · intro x y ihx ihy
        rw [map_add, map_add, map_add, ihx, ihy]
    let _ : Algebra R₀' A₀ := (α₀.comp eR'.symm.toRingHom).toAlgebra
    have hEt_R'A : (α₀.comp eR'.symm.toRingHom).Etale :=
      RingHom.Etale.respectsIso.right α₀ eR'.symm hα₀
    have _ : Algebra.Etale R₀' A₀ := hEt_R'A.toAlgebra
    let _ : Algebra T₀ A₀ := Φ₀.toAlgebra
    have _ : IsScalarTower R₀' T₀ A₀ :=
      @IsScalarTower.of_algebraMap_eq' R₀' T₀ A₀ _ _ _ _ _ _ <|
        RingHom.ext fun r' => by
          change α₀ r'.val = α₀ r'.val * σ_A 1
          rw [map_one, mul_one]
    have _ : Algebra.Etale T₀ A₀ := Algebra.Etale.of_restrictScalars R₀' T₀ A₀
    have hsurj_comap : Function.Surjective (PrimeSpectrum.comap (algebraMap T₀ A₀)) := by
      intro P_id
      refine ⟨PrimeSpectrum.comap Θ₀ P_id, ?_⟩
      ext z
      change Θ₀ (Φ₀ z) ∈ P_id.asIdeal ↔ z ∈ P_id.asIdeal
      rw [hΘΦ z]
      exact P_id.isPrime.pow_mem_iff_mem Q hQ_pos
    have _ : Module.FaithfullyFlat T₀ A₀ :=
      Module.FaithfullyFlat.of_comap_surjective hsurj_comap
    let B_diag := TensorProduct T₀ A₀ A₀
    have hp_B : ((p : ℕ) : B_diag) = 0 := by
      rw [← map_natCast (algebraMap T₀ B_diag) p, hp_T₀, map_zero]
    let σ_B : B_diag →+* B_diag := iterFrob B_diag hp_B
    have hσ_B : ∀ b : B_diag, σ_B b = b ^ Q := h_iterFrob B_diag hp_B
    have hdiff_pow : ∀ a : A₀, (a ⊗ₜ[T₀] (1 : A₀) - (1 : A₀) ⊗ₜ[T₀] a) ^ Q = 0 := by
      intro a
      rw [← hσ_B, map_sub]
      have hl : σ_B (a ⊗ₜ[T₀] (1 : A₀)) = (a ^ Q) ⊗ₜ[T₀] (1 : A₀) := by
        rw [hσ_B, ← Algebra.TensorProduct.includeLeftRingHom_apply, ← map_pow,
          Algebra.TensorProduct.includeLeftRingHom_apply]
      have hr : σ_B ((1 : A₀) ⊗ₜ[T₀] a) = (1 : A₀) ⊗ₜ[T₀] (a ^ Q) := by
        rw [hσ_B]
        change ((Algebra.TensorProduct.includeRight : A₀ →ₐ[T₀] B_diag) a) ^ Q = _
        rw [← map_pow]
        rfl
      rw [hl, hr, ← hΦΘ a]
      have heq_alg : (algebraMap T₀ A₀ (Θ₀ a)) ⊗ₜ[T₀] (1 : A₀) =
          (1 : A₀) ⊗ₜ[T₀] (algebraMap T₀ A₀ (Θ₀ a)) :=
        ((Algebra.TensorProduct.includeLeft : A₀ →ₐ[T₀] B_diag).commutes (Θ₀ a)).trans
          ((Algebra.TensorProduct.includeRight : A₀ →ₐ[T₀] B_diag).commutes (Θ₀ a)).symm
      exact sub_eq_zero.mpr heq_alg
    obtain ⟨s_gen, hs_gen⟩ := (inferInstance : Algebra.FiniteType T₀ A₀).out
    let J : Ideal B_diag :=
      Ideal.span ((fun a : A₀ => a ⊗ₜ[T₀] (1 : A₀) - (1 : A₀) ⊗ₜ[T₀] a) '' (↑s_gen : Set A₀))
    have hJ_fg : J.FG := Submodule.fg_span (s_gen.finite_toSet.image _)
    have hJ_le : J ≤ nilradical B_diag := by
      rw [Ideal.span_le]
      rintro x ⟨a, _, rfl⟩
      exact ⟨Q, hdiff_pow a⟩
    have hJ_nilp : IsNilpotent J := (Ideal.FG.isNilpotent_iff_le_nilradical hJ_fg).mpr hJ_le
    let qJ : B_diag →ₐ[T₀] B_diag ⧸ J := Ideal.Quotient.mkₐ T₀ J
    have hq_eq : qJ.comp Algebra.TensorProduct.includeLeft =
        qJ.comp (Algebra.TensorProduct.includeRight : A₀ →ₐ[T₀] B_diag) := by
      apply AlgHom.ext_of_adjoin_eq_top hs_gen
      intro a ha
      change Ideal.Quotient.mk J (a ⊗ₜ[T₀] (1 : A₀)) = Ideal.Quotient.mk J ((1 : A₀) ⊗ₜ[T₀] a)
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨a, ha, rfl⟩)
    have hinc_eq : (Algebra.TensorProduct.includeLeft : A₀ →ₐ[T₀] B_diag) =
        (Algebra.TensorProduct.includeRight : A₀ →ₐ[T₀] B_diag) :=
      Algebra.FormallyUnramified.ext J hJ_nilp (fun x => AlgHom.congr_fun hq_eq x)
