          Φ_loc.hom.app (Opposite.op U_et) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv Φ_zero ≫
          (weilAltZeroBdrySubpresheafι S U n).app (Opposite.op U_et)
      rw [hcounit, hΦ_loc_pin U_et, hΦ_zero_equiv]
      exact AddCommGrpCat.ext (fun _ => rfl)

    have hConstSheafAdjUnit : ∀ {S : AlgebraicGeometry.Scheme.{u}} {T : S.Etale}
        (hT : CategoryTheory.Limits.IsTerminal T) (M : AddCommGrpCat.{u}),
        (CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT).unit.app M =
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
            ((CategoryTheory.Functor.const (Opposite S.Etale)).obj M)).app (Opposite.op T)) := by
      intro S T hT M
      let u_sh : M ⟶ ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj M).obj.obj
          (Opposite.op T) :=
        (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite S.Etale)).obj M)).app (Opposite.op T))
      change (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT).unit.app M ≫ u_sh = u_sh
      exact (congrArg (· ≫ u_sh)
        (CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT M)).trans
        (CategoryTheory.Category.id_comp u_sh)

    obtain ⟨hSh_loc_Y, e_loc_Y, hPin_Y, hZeroPkg_Y⟩ := hLocConstIso Y₀
    obtain ⟨hSh_zero_Y, e_zero_Y, hCounitSq_Y⟩ := hZeroPkg_Y W_open
    obtain ⟨hSh_loc_B, e_loc_B, hPin_B, -⟩ := hLocConstIso B₀

    let J_Y := Y₀.smallEtaleTopology
    let J_B := B₀.smallEtaleTopology
    let T_Y : Y₀.Etale := weilEtaleIdTerminal.{u} Y₀
    let hT_Y : CategoryTheory.Limits.IsTerminal T_Y := weilEtaleIdTerminalIsTerminal.{u} Y₀
    let T_B : B₀.Etale := weilEtaleIdTerminal.{u} B₀
    let hT_B : CategoryTheory.Limits.IsTerminal T_B := weilEtaleIdTerminalIsTerminal.{u} B₀
    let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
    let adj_B := CategoryTheory.constantSheafAdj J_B AddCommGrpCat.{u} hT_B
    let F_Y := weilEtaleTorsionSheaf Y₀ n
    let F_B := weilEtaleTorsionSheaf B₀ n
    let L_loc_Y : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf Y₀ n, hSh_loc_Y⟩
    let L_loc_B : CategoryTheory.Sheaf J_B AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf B₀ n, hSh_loc_B⟩
    let K_zero_Y : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
      ⟨weilAltZeroBdrySubpresheaf Y₀ W_open n, hSh_zero_Y⟩
    let ι_zero_Y : K_zero_Y ⟶ L_loc_Y :=
      CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι Y₀ W_open n)

    let pf_fun : Fin m → CategoryTheory.Functor
