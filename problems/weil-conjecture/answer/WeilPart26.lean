        rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
        change CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology P_loc_set
        rw [hJ_eq, CategoryTheory.Presieve.isSheaf_pretopology]
        intro W R hR
        exact hSheafFor_loc R (hR_surj hR)
      let W_sub : ∀ (W : S.Etale), ((Fgt.obj W).left).Opens → S.Etale :=
        fun W V_open =>
          CategoryTheory.MorphismProperty.Over.mk ⊤ (V_open.ι ≫ (Fgt.obj W).hom) inferInstance
      let u_sub : ∀ (W : S.Etale) (V_open : ((Fgt.obj W).left).Opens), W_sub W V_open ⟶ W :=
        fun _ V_open => CategoryTheory.MorphismProperty.Over.homMk V_open.ι rfl trivial
      let hom_sub_le : ∀ (W : S.Etale) {V₁ V₂ : ((Fgt.obj W).left).Opens},
          V₁ ≤ V₂ → (W_sub W V₁ ⟶ W_sub W V₂) :=
        fun W {_ _} hle =>
          CategoryTheory.MorphismProperty.Over.homMk (((Fgt.obj W).left).homOfLE hle)
            (AlgebraicGeometry.Scheme.homOfLE_ι_assoc ((Fgt.obj W).left) hle (Fgt.obj W).hom)
            trivial
      have h_sub_le_comp : ∀ (W : S.Etale) {V₁ V₂ : ((Fgt.obj W).left).Opens} (hle : V₁ ≤ V₂),
          hom_sub_le W hle ≫ u_sub W V₂ = u_sub W V₁ := by
        intro W V₁ V₂ hle
        exact CategoryTheory.MorphismProperty.Over.Hom.ext
          (AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt.obj W).left) hle)
      have hMap_comp_apply : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
          {V₁ V₂ V₃ : S.Etale} (f₁ : V₁ ⟶ V₂) (f₂ : V₂ ⟶ V₃)
          (s : ↥(𝒢.obj.obj (Opposite.op V₃))),
          (𝒢.obj.map (f₁ ≫ f₂).op).hom s =
            (𝒢.obj.map f₁.op).hom ((𝒢.obj.map f₂.op).hom s) := by
        intro 𝒢 V₁ V₂ V₃ f₁ f₂ s
        have hop : (f₁ ≫ f₂).op = (f₂.op ≫ f₁.op) := rfl
        rw [hop, 𝒢.obj.map_comp]; rfl
      have hOpenArrows : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale)
          {ι : Type u} (O : ι → ((Fgt.obj W).left).Opens),
          (∀ w : ↥(Fgt.obj W).left, ∃ i : ι, w ∈ O i) →
          ∀ (s : ∀ i : ι, ↥(𝒢.obj.obj (Opposite.op (W_sub W (O i))))),
            CategoryTheory.Presieve.Arrows.Compatible
              (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
              (fun i => u_sub W (O i)) s →
            ∃! t : ↥(𝒢.obj.obj (Opposite.op W)),
              ∀ i : ι, (𝒢.obj.map (u_sub W (O i)).op).hom t = s i := by
        intro 𝒢 W ι O hcov
        let X_cov : ι → S.Etale := fun i => W_sub W (O i)
        let π_cov : ∀ i : ι, X_cov i ⟶ W := fun i => u_sub W (O i)
        have hMemPre : CategoryTheory.Presieve.ofArrows X_cov π_cov ∈ K_et.coverings W := by
          change CategoryTheory.Presieve.map (CategoryTheory.Over.forget S)
              (CategoryTheory.Presieve.map Fgt (CategoryTheory.Presieve.ofArrows X_cov π_cov)) ∈
            (AlgebraicGeometry.Scheme.precoverage P_et_prop).coverings ((Over.forget S).obj (Fgt.obj W))
          rw [CategoryTheory.Presieve.map_ofArrows, CategoryTheory.Presieve.map_ofArrows]
          exact (AlgebraicGeometry.Scheme.ofArrows_mem_precoverage_iff P_et_prop).mpr
            ⟨fun w => let ⟨i, hi⟩ := hcov w; ⟨i, h_exists_iota hi⟩,
             fun i => (inferInstance : AlgebraicGeometry.Etale (O i).ι)⟩
        have hMemJ : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows X_cov π_cov) ∈
            J W := by
          change _ ∈ S.smallEtaleTopology W
          rw [hJ_eq, CategoryTheory.Pretopology.mem_toGrothendieck]
          exact ⟨CategoryTheory.Presieve.ofArrows X_cov π_cov, hMemPre,
            CategoryTheory.Sieve.le_generate _⟩
        have hPresieve𝒢 : CategoryTheory.Presieve.IsSheaf J
            (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
          (CategoryTheory.isSheaf_iff_isSheaf_of_type _ _).mp
            ((CategoryTheory.sheafCompose J (CategoryTheory.forget AddCommGrpCat.{u})).obj 𝒢).property
        have hShFor : CategoryTheory.Presieve.IsSheafFor
            (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
            (CategoryTheory.Presieve.ofArrows X_cov π_cov) :=
          (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (hPresieve𝒢 _ hMemJ)
        exact (CategoryTheory.Presieve.isSheafFor_arrows_iff
          (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) π_cov).mp hShFor
      have hOpenSep : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale)
          {ι : Type u} (O : ι → ((Fgt.obj W).left).Opens),
          (∀ w : ↥(Fgt.obj W).left, ∃ i : ι, w ∈ O i) →
          ∀ (t₁ t₂ : ↥(𝒢.obj.obj (Opposite.op W))),
            (∀ i : ι, (𝒢.obj.map (u_sub W (O i)).op).hom t₁ =
              (𝒢.obj.map (u_sub W (O i)).op).hom t₂) →
            t₁ = t₂ := by
        intro 𝒢 W ι O hcov t₁ t₂ heq
        have hCompat : CategoryTheory.Presieve.Arrows.Compatible
            (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
            (fun i => u_sub W (O i))
            (fun i => (𝒢.obj.map (u_sub W (O i)).op).hom t₁) := by
          intro i j Z gi gj hg
          change (𝒢.obj.map gi.op).hom ((𝒢.obj.map (u_sub W (O i)).op).hom t₁) =
            (𝒢.obj.map gj.op).hom ((𝒢.obj.map (u_sub W (O j)).op).hom t₁)
          rw [← hMap_comp_apply 𝒢 gi (u_sub W (O i)) t₁,
            ← hMap_comp_apply 𝒢 gj (u_sub W (O j)) t₁, hg]
        exact (hOpenArrows 𝒢 W O hcov _ hCompat).unique (fun _ => rfl) (fun i => (heq i).symm)
      have hEmptySub : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (Y : S.Etale),
          IsEmpty ↥(Fgt.obj Y).left →
          ∀ (a b : ↥(𝒢.obj.obj (Opposite.op Y))), a = b := by
        intro 𝒢 Y hEmpty a b
        exact hOpenSep 𝒢 Y (ι := PEmpty.{u + 1}) PEmpty.elim
          (fun y => hEmpty.elim y) a b (fun i => PEmpty.elim i)
      have hOpenGlue : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale)
          {ι : Type u} (O : ι → ((Fgt.obj W).left).Opens),
          (∀ w : ↥(Fgt.obj W).left, ∃ i : ι, w ∈ O i) →
          ∀ (s : ∀ i : ι, ↥(𝒢.obj.obj (Opposite.op (W_sub W (O i))))),
            (∀ (i₁ i₂ : ι) (Y : S.Etale) (f₁ : Y ⟶ W_sub W (O i₁)) (f₂ : Y ⟶ W_sub W (O i₂)),
              f₁ ≫ u_sub W (O i₁) = f₂ ≫ u_sub W (O i₂) →
              ∀ (w₀ : ↥(Fgt.obj W).left), w₀ ∈ O i₁ → w₀ ∈ O i₂ →
