                      rw [← h_sub_le_comp W hle₁, hMap_comp_apply F_tor, hψ_loc_spec W g₁ x, hη_nat]
                    have hr₂ : (F_tor.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_loc_fun W g₂) =
                        η_hom (W_sub W (O₁₂ x)) (g₂ x) := by
                      rw [← h_sub_le_comp W hle₂, hMap_comp_apply F_tor, hψ_loc_spec W g₂ x, hη_nat]
                    have hr₁₂ : (F_tor.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_loc_fun W (g₁ + g₂)) =
                        η_hom (W_sub W (O₁₂ x)) (g₁ x + g₂ x) := by
                      rw [← h_sub_le_comp W hle₁₂, hMap_comp_apply F_tor,
                        hψ_loc_spec W (g₁ + g₂) x, hη_nat]; rfl
                    rw [map_add, hr₁, hr₂, hr₁₂, map_add] }
            naturality := fun {opW₁ opW₂} f_op => by
              let W := Opposite.unop opW₁
              let W' := Opposite.unop opW₂
              let f : W' ⟶ W := f_op.unop
              apply AddCommGrpCat.ext
              intro (g : LocallyConstant ↥(Fgt.obj W).left A)
              let g' : LocallyConstant ↥(Fgt.obj W').left A :=
                ((weilAltLocConstPresheaf S n).map f_op).hom g
              change ψ_loc_fun W' g' = (F_tor.obj.map f.op).hom (ψ_loc_fun W g)
              apply hOpenSep F_tor W' (O_loc W' g') (fun y => ⟨y, rfl⟩)
              intro y
              rw [hψ_loc_spec W' g' y]
              let x : ↥(Fgt.obj W).left := (Fgt.map f).left y
              have hrange : Set.range ⇑((O_loc W' g' y).ι ≫ (Fgt.map f).left) ⊆
                  Set.range ⇑(O_loc W g x).ι := by
                rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                rintro _ ⟨q, rfl⟩
                exact h_mem_iota (O_loc W' g' y) q
              let ℓ_y := AlgebraicGeometry.IsOpenImmersion.lift (O_loc W g x).ι
                ((O_loc W' g' y).ι ≫ (Fgt.map f).left) hrange
              have hℓ_fac : ℓ_y ≫ (O_loc W g x).ι = (O_loc W' g' y).ι ≫ (Fgt.map f).left :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hrange
