        apply LocallyConstant.ext
        intro w
        obtain ⟨Z, u, hu, z, rfl⟩ := hSurj w
        calc
          val_loc g' ((Fgt.map u).left z) = val_loc ((P_loc_set.map u.op) g') z := rfl
