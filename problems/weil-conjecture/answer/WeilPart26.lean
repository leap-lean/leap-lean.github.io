        have h1 : adj_Y.unit.app AM ≫
            (ρ_a a ≫ (pf_fun a).map e_loc_B.hom).hom.app (Opposite.op T_Y) =
            (adj_Y.unit.app AM ≫ (ρ_a a).hom.app (Opposite.op T_Y)) ≫ e_app :=
          (CategoryTheory.Category.assoc _ _ _).symm
        have h2 : (adj_Y.unit.app AM ≫ (ρ_a a).hom.app (Opposite.op T_Y)) ≫ e_app =
            (adj_B.unit.app AM ≫ F_B.obj.map u_t.op) ≫ e_app :=
