              apply AddCommGrpCat.ext; intro e'
              exact congrArg (fun tup => tup a) (congrArg (fun k => k.hom e') (ht' u hu)))
        exact congrArg (fun k => k.hom e) ht'_a
    let Q_prod_sh : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := ⟨Q_prod_pre, hSh_prod⟩
    let π_prod : ∀ a : Fin m, Q_prod_sh ⟶ pf_loc_a a := fun a =>
