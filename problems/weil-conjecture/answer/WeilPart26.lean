        {ι : Type u} (O : ι → ((Fgt.obj W).left).Opens),
        (∀ w : ↥(Fgt.obj W).left, ∃ i : ι, w ∈ O i) →
        ∀ (t₁ t₂ : ↥(𝒢.obj.obj (Opposite.op W))),
