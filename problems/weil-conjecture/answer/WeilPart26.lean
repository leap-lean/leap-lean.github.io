        obtain ⟨V₂, g_V₂, v₂, W₂, u₁_W, x₂, hAff_V₂, hv₂_cl, hv₂_map,
          hAff_W₂, hx₂_cl, hx₂_map, hR1_zero, hPull⟩ :=
          weil_etale_elementary_fibration_r1_effacement k ℓ hℓ_ne δ₀ W₀_m
