      have _ : CategoryTheory.Injective (𝒥 p) := hInj𝒥 p
      exact CategoryTheory.HasInjectiveDimensionLT.subsingleton (𝒥 p) 1 k hk X
    let kerTopHom : ∀ F : 𝒞,
        ↑((C₀ N).obj F) →+ ↥(LinearMap.ker (((d_C₀ N).app F).hom)) :=
      fun F => AddMonoidHom.mk'
        (fun v => ⟨v, by rw [LinearMap.mem_ker, h_dN F, LinearMap.zero_apply]⟩)
        (fun _ _ => rfl)
    cases N with
    | zero =>
      have hEpi_tS : CategoryTheory.Epi t_S := hExCases
      have _ : CategoryTheory.IsIso t_S :=
        @CategoryTheory.isIso_of_mono_of_epi _ _ _ _ _ t_S hMono_tS hEpi_tS
      have hDeg0 : ∀ (F : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR F 0 →+ ZMod m),
          ∃! f : CategoryTheory.Abelian.Ext.{u} F oneR 0,
            ∀ α : CategoryTheory.Abelian.Ext.{u} oneR F 0,
              τ_N (α.comp f (Nat.add_zero 0)) = φ α := by
        intro F φ
        let μ_φ : ↑((C₀ 0).obj F) →ₗ[R] R :=
          addHomToLinear (φ.comp ((Υ₀ F 0).comp (kerTopHom F)))
        let f_hom : Quiver.Hom F oneR :=
          CategoryTheory.CategoryStruct.comp (Ψ 0 F μ_φ) (CategoryTheory.inv t_S)
        have hf_tS : CategoryTheory.CategoryStruct.comp f_hom t_S = Ψ 0 F μ_φ := by
          dsimp [f_hom]
          rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
            CategoryTheory.Category.comp_id]
        refine ⟨CategoryTheory.Abelian.Ext.mk₀ f_hom, ?_, ?_⟩
        · intro α
          obtain ⟨w, rfl⟩ := hΥ_surj 0 F α
          rw [← hPair F f_hom w, hf_tS, (Ψ 0 F).symm_apply_apply]
          rfl
        · intro f' hf'
          let g' : Quiver.Hom F oneR := CategoryTheory.Abelian.Ext.addEquiv₀ f'
          have hg'_mk : CategoryTheory.Abelian.Ext.mk₀ g' = f' :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply f'
          have h_symm_eq : (Ψ 0 F).symm (CategoryTheory.CategoryStruct.comp g' t_S) =
              (Ψ 0 F).symm (CategoryTheory.CategoryStruct.comp f_hom t_S) := by
            apply LinearMap.ext
            intro v
            apply ULift.ext
            let w := kerTopHom F v
            change ((((Ψ 0 F).symm (CategoryTheory.CategoryStruct.comp g' t_S)) w.1).down) =
              ((((Ψ 0 F).symm (CategoryTheory.CategoryStruct.comp f_hom t_S)) w.1).down)
            rw [hPair F g' w, hg'_mk, hf' (Υ₀ F 0 w), hf_tS, (Ψ 0 F).symm_apply_apply]
            rfl
          have hg'_eq : g' = f_hom :=
            (CategoryTheory.cancel_mono t_S).mp ((Ψ 0 F).symm.injective h_symm_eq)
          rw [← hg'_mk, hg'_eq]
      refine ⟨hDeg0, fun A _ q hq => by omega, ?_⟩
      let ev_hom : ∀ G : 𝒞,
          CategoryTheory.Abelian.Ext.{u} G oneR 0 →+
            (CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m) :=
        fun G => AddMonoidHom.mk'
          (fun f => AddMonoidHom.mk'
            (fun β => τ_N (β.comp f (Nat.add_zero 0)))
            (fun β₁ β₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add]))
          (fun f₁ f₂ => by
            ext β
            simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply,
              CategoryTheory.Abelian.Ext.comp_add, map_add])
      have hev_bij : ∀ G : 𝒞, Function.Bijective (ev_hom G) := by
        intro G
        refine ⟨?_, ?_⟩
        · intro f₁ f₂ h12
          obtain ⟨f₀, _, hf₀_uniq⟩ := hDeg0 G (ev_hom G f₂)
          have h1 : f₁ = f₀ := hf₀_uniq f₁ (fun α => DFunLike.congr_fun h12 α)
          have h2 : f₂ = f₀ := hf₀_uniq f₂ (fun _ => rfl)
          exact h1.trans h2.symm
        · intro φ
          obtain ⟨f, hf, _⟩ := hDeg0 G φ
          exact ⟨f, AddMonoidHom.ext hf⟩
      let E_top : ∀ G : 𝒞,
          (CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m) ≃+
            CategoryTheory.Abelian.Ext.{u} G oneR 0 :=
        fun G => (AddEquiv.ofBijective (ev_hom G) (hev_bij G)).symm
      refine ⟨E_top, ?_⟩
      intro G φ α
      apply (hev_bij oneR).1
      have h_app : ev_hom oneR (E_top oneR (φ.comp (α.postcomp oneR (Nat.add_zero 0)))) =
          φ.comp (α.postcomp oneR (Nat.add_zero 0)) :=
        (AddEquiv.ofBijective (ev_hom oneR) (hev_bij oneR)).apply_symm_apply _
      rw [h_app]
      ext β
      change τ_N (β.comp (α.comp (E_top G φ) (Nat.zero_add 0)) (Nat.add_zero 0)) =
        φ (β.comp α (Nat.add_zero 0))
      rw [← CategoryTheory.Abelian.Ext.comp_assoc β α (E_top G φ)
        (Nat.add_zero 0) (Nat.zero_add 0) (Nat.add_zero 0)]
      have hG_app : ev_hom G (E_top G φ) = φ :=
        (AddEquiv.ofBijective (ev_hom G) (hev_bij G)).apply_symm_apply φ
      exact DFunLike.congr_fun hG_app (β.comp α (Nat.add_zero 0))
    | succ n =>
      obtain ⟨⟨ht, hEx_top⟩, hEpi0, hEx_mid⟩ := hExCases
      let B : ℕ → 𝒞 := fun r => CategoryTheory.Limits.kernel (diffDual r)
      let κ : ∀ r : ℕ, Quiver.Hom (B r) (𝒥 (r + 1)) :=
        fun r => CategoryTheory.Limits.kernel.ι (diffDual r)
      have hκ_mono : ∀ r : ℕ, CategoryTheory.Mono (κ r) :=
        fun _ => CategoryTheory.Limits.equalizer.ι_mono
      let e_dual : Quiver.Hom oneR (B n) :=
        CategoryTheory.Limits.kernel.lift (diffDual n) t_S ht
      have he_dual_κ : CategoryTheory.CategoryStruct.comp e_dual (κ n) = t_S :=
        CategoryTheory.Limits.kernel.lift_ι _ _ _
      have he_dual_mono : CategoryTheory.Mono e_dual :=
        @CategoryTheory.mono_of_mono_fac _ _ _ _ _ _ _ _ hMono_tS he_dual_κ
      have he_dual_epi : CategoryTheory.Epi e_dual :=
        CategoryTheory.ShortComplex.Exact.epi_kernelLift hEx_top
      have _ : CategoryTheory.IsIso e_dual :=
        @CategoryTheory.isIso_of_mono_of_epi _ _ _ _ _ e_dual he_dual_mono he_dual_epi
      let Sc₀ : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk (κ 0) (diffDual 0)
          (CategoryTheory.Limits.kernel.condition (diffDual 0))
      have hSc₀ : Sc₀.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_kernel (diffDual 0)
          mono_f := hκ_mono 0
          epi_g := hEpi0 }
      let ε₀ : CategoryTheory.Abelian.Ext.{u} (𝒥 0) (B 0) 1 := hSc₀.extClass
      let q_step : ∀ r : ℕ, Quiver.Hom (𝒥 (r + 2)) (B r) :=
        fun r => CategoryTheory.Limits.kernel.lift (diffDual r) (diffDual (r + 1)) (hDiffZero r)
      have hq_step_κ : ∀ r : ℕ,
          CategoryTheory.CategoryStruct.comp (q_step r) (κ r) = diffDual (r + 1) :=
        fun r => CategoryTheory.Limits.kernel.lift_ι _ _ _
      have hκ_q : ∀ r : ℕ,
          CategoryTheory.CategoryStruct.comp (κ (r + 1)) (q_step r) = 0 := by
        intro r
        have _ := hκ_mono r
        rw [← CategoryTheory.cancel_mono (κ r), CategoryTheory.Category.assoc, hq_step_κ,
          CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
      let Sc_step : ∀ r : ℕ, CategoryTheory.ShortComplex 𝒞 :=
        fun r => CategoryTheory.ShortComplex.mk (κ (r + 1)) (q_step r) (hκ_q r)
      have hSc_step : ∀ r : ℕ, r < n → (Sc_step r).ShortExact := by
        intro r hr
        obtain ⟨_, hEx_r⟩ := hEx_mid r hr
        have _ := hκ_mono (r + 1)
        have hLim : CategoryTheory.Limits.IsLimit
            (CategoryTheory.Limits.KernelFork.ofι (κ (r + 1)) (hκ_q r)) :=
          CategoryTheory.Limits.KernelFork.IsLimit.ofι (κ (r + 1)) (hκ_q r)
            (fun {W} w hw =>
              CategoryTheory.Limits.kernel.lift (diffDual (r + 1)) w
                (by
                  rw [← hq_step_κ r, ← CategoryTheory.Category.assoc, hw,
                    CategoryTheory.Limits.zero_comp]))
            (fun {W} w hw => CategoryTheory.Limits.kernel.lift_ι _ _ _)
            (fun {W} w hw b hb => by
              rw [← CategoryTheory.cancel_mono (κ (r + 1)), hb,
