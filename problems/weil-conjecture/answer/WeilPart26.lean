          have h2 := congrArg (fun m : (L_s s).obj H ⟶ (L_s s).obj H => m b) hr_fac
          change r_s (((L_s s).map π_δ) a) = a at h1
          change r_s (((L_s s).map π_δ) b) = b at h2
          rw [← h1, ← h2, hab]
        have : CategoryTheory.Epi ((L_s s).map π_δ) := (L_s s).map_epi π_δ
        have hSurj : Function.Surjective ⇑((L_s s).map π_δ) :=
          (AddCommGrpCat.epi_iff_surjective ((L_s s).map π_δ)).mp inferInstance
        exact ⟨hInj, hSurj⟩
      apply (CategoryTheory.cancel_mono π_δ).mp
      rw [CategoryTheory.Limits.cokernel.condition δ, CategoryTheory.Limits.zero_comp]
    have hEpiOfSurj : ∀ {G H : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}}
        (u : G ⟶ H),
        (∀ s : Quiver.Hom S_k B.left,
          CategoryTheory.CategoryStruct.comp s B.hom = CategoryTheory.CategoryStruct.id S_k →
          Function.Surjective (((L_s s).map u).hom)) →
        CategoryTheory.Epi u := by
      intro G H u hu_surj
      rw [CategoryTheory.Preadditive.epi_iff_isZero_cokernel]
      apply hConsZero (CategoryTheory.Limits.cokernel u)
      intro s hs
      let C_u := CategoryTheory.Limits.cokernel u
      let π_u := CategoryTheory.Limits.cokernel.π u
      have hπ0 : (L_s s).map π_u = 0 := by
        apply AddCommGrpCat.ext
        intro y
        obtain ⟨x, rfl⟩ := hu_surj s hs y
        change ((L_s s).map u ≫ (L_s s).map π_u) x = 0
        rw [← (L_s s).map_comp, CategoryTheory.Limits.cokernel.condition u, hLs_zero s]
        rfl
      have hid0 : 𝟙 ((L_s s).obj C_u) = (0 : (L_s s).obj C_u ⟶ (L_s s).obj C_u) := by
        apply ((adj_Ls s).homEquiv C_u ((L_s s).obj C_u)).injective
        apply (CategoryTheory.cancel_epi π_u).mp
        have h1 := ((adj_Ls s).homEquiv_naturality_left π_u (𝟙 ((L_s s).obj C_u))).symm
        have h2 := ((adj_Ls s).homEquiv_naturality_left π_u
          (0 : (L_s s).obj C_u ⟶ (L_s s).obj C_u)).symm
        rw [h1, h2, hπ0, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
      refine Subsingleton.intro fun a b => ?_
      have ha := congrArg (fun f : (L_s s).obj C_u ⟶ (L_s s).obj C_u => f a) hid0
      have hb := congrArg (fun f : (L_s s).obj C_u ⟶ (L_s s).obj C_u => f b) hid0
      change a = 0 at ha
      change b = 0 at hb
      exact ha.trans hb.symm

    refine ⟨?_, ?_⟩
    · 
      intro F α₁ α₂ hα_eq
      apply sub_eq_zero.mp
      apply hHomZero (α₁ - α₂)
      intro s hs
      have : (pb_of s).Additive := (hPb_props s).1
      let πM_s := @weilEtaleConstPullbackHom _ _ s (@hc_all S_k B.left s) (@hr_all S_k B.left s)
        T_0 hT_0 (weilEtaleIdTerminal.{u} B.left) (weilEtaleIdTerminalIsTerminal.{u} B.left) AM
      have : CategoryTheory.IsIso πM_s :=
        @hConstIso S_k B.left s (@hc_all S_k B.left s) (@hr_all S_k B.left s)
          _ hT_0 _ (weilEtaleIdTerminalIsTerminal.{u} B.left) AM
      have : CategoryTheory.IsIso (Ev_0.map πM_s) := inferInstance
      have heq_s : (L_s s).map α₁ = (L_s s).map α₂ := by
        apply (CategoryTheory.cancel_mono (Ev_0.map πM_s)).mp
        exact hα_eq s hs
      change ((pb_of s).map (α₁ - α₂)).hom.app (Opposite.op T_0) = 0
      rw [(pb_of s).map_sub]
      exact sub_eq_zero.mpr heq_s
    · 
      intro O hSh_L hSh_0 T_B hT_B Φ_B _hNorm_B K_O ι_O F α hα_pts
      let L_B' : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u} :=
        ⟨weilAltLocConstPresheaf B.left n, hSh_L⟩
      let ι_sub : Quiver.Hom K_O L_B' := { hom := weilAltZeroBdrySubpresheafι B.left O n }
      let α_L : Quiver.Hom F L_B' := α ≫ Φ_B.hom
      have : CategoryTheory.Mono ι_sub :=
        (@hBdryDichotomy B.left B.left (𝟙 B.left) O hSh_L hSh_0
          (@hc_all B.left B.left (𝟙 B.left)) (@hr_all B.left B.left (𝟙 B.left))).1
      let π_bdry := CategoryTheory.Limits.cokernel.π ι_sub
      let : Unique ↥S_k := PrimeSpectrum.instUnique
      let pt₀ : ↥S_k := default
      have hα_bdry : α_L ≫ π_bdry = 0 := by
        apply hHomZero (α_L ≫ π_bdry)
        intro s hs
        obtain ⟨_, hOut_s, hIn_s⟩ :=
          @hBdryDichotomy S_k B.left s O hSh_L hSh_0 (@hc_all S_k B.left s) (@hr_all S_k B.left s)
        by_cases hmem : s.base pt₀ ∈ O
        · have hall_in : ∀ pt : ↥S_k, s.base pt ∈ O := fun pt => by
            rw [Subsingleton.elim pt pt₀]
            exact hmem
          have : CategoryTheory.IsIso ((pb_of s).map ι_sub) := hIn_s hall_in
          have : CategoryTheory.IsIso ((L_s s).map ι_sub) := Ev_0.map_isIso ((pb_of s).map ι_sub)
          have hπ_s0 : (L_s s).map π_bdry = 0 := by
            apply (CategoryTheory.cancel_epi ((L_s s).map ι_sub)).mp
            rw [← (L_s s).map_comp, CategoryTheory.Limits.cokernel.condition ι_sub, hLs_zero s,
              CategoryTheory.Limits.comp_zero]
          rw [(L_s s).map_comp, hπ_s0, CategoryTheory.Limits.comp_zero]
        · have hall_out : ∀ pt : ↥S_k, s.base pt ∉ O := fun pt => by
            rw [Subsingleton.elim pt pt₀]
            exact hmem
          let πM_s := @weilEtaleConstPullbackHom _ _ s (@hc_all S_k B.left s) (@hr_all S_k B.left s)
            T_0 hT_0 (weilEtaleIdTerminal.{u} B.left) (weilEtaleIdTerminalIsTerminal.{u} B.left) AM
          have : CategoryTheory.IsIso πM_s :=
            @hConstIso S_k B.left s (@hc_all S_k B.left s) (@hr_all S_k B.left s)
              _ hT_0 _ (weilEtaleIdTerminalIsTerminal.{u} B.left) AM
          let e_comp : (pb_of s).obj L_B' ⟶ weilEtaleTorsionSheaf S_k n :=
            (pb_of s).map Φ_B.inv ≫ πM_s
          have : CategoryTheory.IsIso e_comp := inferInstance
          have : CategoryTheory.IsIso (Ev_0.map e_comp) := inferInstance
          have hα0_raw := (hα_pts s hs).1 hall_out
          have hαL_0 : (L_s s).map α_L = 0 := by
            apply (CategoryTheory.cancel_mono (Ev_0.map e_comp)).mp
            rw [CategoryTheory.Limits.zero_comp]
            have hfac : α_L ≫ Φ_B.inv = α := by
              dsimp [α_L]
              rw [CategoryTheory.Category.assoc, Φ_B.hom_inv_id, CategoryTheory.Category.comp_id]
            calc
              (L_s s).map α_L ≫ Ev_0.map e_comp
                  = Ev_0.map ((pb_of s).map α_L ≫ ((pb_of s).map Φ_B.inv ≫ πM_s)) :=
                    (Ev_0.map_comp _ _).symm
              _ = Ev_0.map (((pb_of s).map α_L ≫ (pb_of s).map Φ_B.inv) ≫ πM_s) := by
                    rw [CategoryTheory.Category.assoc]
              _ = Ev_0.map ((pb_of s).map α ≫ πM_s) := by
                    rw [← (pb_of s).map_comp, hfac]
              _ = 0 := hα0_raw
          rw [(L_s s).map_comp, hαL_0, CategoryTheory.Limits.zero_comp]
      have hLim_sub := CategoryTheory.Abelian.monoIsKernelOfCokernel _
        (CategoryTheory.Limits.cokernelIsCokernel ι_sub)
      let τ₀ : F ⟶ K_O := CategoryTheory.Limits.Fork.IsLimit.lift hLim_sub α_L hα_bdry
      have hτ₀_fac : τ₀ ≫ ι_sub = α_L :=
        CategoryTheory.Limits.Fork.IsLimit.lift_ι hLim_sub
      have hτ₀_O : τ₀ ≫ ι_O = α := by
        dsimp [ι_O, α_L]
        rw [← CategoryTheory.Category.assoc, hτ₀_fac, CategoryTheory.Category.assoc,
          Φ_B.hom_inv_id, CategoryTheory.Category.comp_id]
      have hEpi_τ₀ : CategoryTheory.Epi τ₀ := by
        apply hEpiOfSurj τ₀
        intro s hs
        obtain ⟨_, hOut_s, hIn_s⟩ :=
          @hBdryDichotomy S_k B.left s O hSh_L hSh_0 (@hc_all S_k B.left s) (@hr_all S_k B.left s)
        by_cases hmem : s.base pt₀ ∈ O
        · have hall_in : ∀ pt : ↥S_k, s.base pt ∈ O := fun pt => by
            rw [Subsingleton.elim pt pt₀]
            exact hmem
          have : CategoryTheory.IsIso ((pb_of s).map ι_sub) := hIn_s hall_in
          have : CategoryTheory.IsIso ((L_s s).map ι_sub) := Ev_0.map_isIso ((pb_of s).map ι_sub)
          let i_iso := CategoryTheory.asIso ((L_s s).map ι_sub)
          let πM_s := @weilEtaleConstPullbackHom _ _ s (@hc_all S_k B.left s) (@hr_all S_k B.left s)
            T_0 hT_0 (weilEtaleIdTerminal.{u} B.left) (weilEtaleIdTerminalIsTerminal.{u} B.left) AM
          have : CategoryTheory.IsIso πM_s :=
            @hConstIso S_k B.left s (@hc_all S_k B.left s) (@hr_all S_k B.left s)
              _ hT_0 _ (weilEtaleIdTerminalIsTerminal.{u} B.left) AM
          let e_comp : (pb_of s).obj L_B' ⟶ weilEtaleTorsionSheaf S_k n :=
            (pb_of s).map Φ_B.inv ≫ πM_s
          have : CategoryTheory.IsIso e_comp := inferInstance
          have : CategoryTheory.IsIso (Ev_0.map e_comp) := inferInstance
          let e_iso := CategoryTheory.asIso (Ev_0.map e_comp)
          have hsurj_raw := (hα_pts s hs).2 hall_in
          intro w
          obtain ⟨x, hx⟩ := hsurj_raw (e_iso.hom.hom (i_iso.hom.hom w))
          refine ⟨x, ?_⟩
          have hcomp_eq : ((pb_of s).map α ≫ πM_s).hom.app (Opposite.op T_0) =
              ((L_s s).map τ₀ ≫ i_iso.hom) ≫ e_iso.hom := by
            have hfac : (τ₀ ≫ ι_sub) ≫ Φ_B.inv = α := by
              rw [hτ₀_fac]
              dsimp [α_L]
              rw [CategoryTheory.Category.assoc, Φ_B.hom_inv_id, CategoryTheory.Category.comp_id]
            calc
              ((pb_of s).map α ≫ πM_s).hom.app (Opposite.op T_0)
                  = Ev_0.map ((pb_of s).map ((τ₀ ≫ ι_sub) ≫ Φ_B.inv) ≫ πM_s) := by rw [hfac]; rfl
              _ = Ev_0.map (((pb_of s).map τ₀ ≫ (pb_of s).map ι_sub) ≫ e_comp) := by
                    rw [(pb_of s).map_comp, (pb_of s).map_comp, CategoryTheory.Category.assoc,
                      CategoryTheory.Category.assoc]
              _ = ((L_s s).map τ₀ ≫ i_iso.hom) ≫ e_iso.hom := by
                    rw [Ev_0.map_comp, Ev_0.map_comp]
                    rfl
          rw [hcomp_eq] at hx
          change e_iso.hom.hom (i_iso.hom.hom (((L_s s).map τ₀).hom x)) =
            e_iso.hom.hom (i_iso.hom.hom w) at hx
          have hx1 := congrArg e_iso.inv.hom hx
          have he_left : ∀ z, e_iso.inv.hom (e_iso.hom.hom z) = z := fun z =>
            congrArg (fun m : Ev_0.obj ((pb_of s).obj L_B') ⟶ Ev_0.obj ((pb_of s).obj L_B') =>
              m.hom z) e_iso.hom_inv_id
          rw [he_left, he_left] at hx1
          have hx2 := congrArg i_iso.inv.hom hx1
          have hi_left : ∀ z, i_iso.inv.hom (i_iso.hom.hom z) = z := fun z =>
            congrArg (fun m : (L_s s).obj K_O ⟶ (L_s s).obj K_O => m.hom z) i_iso.hom_inv_id
          rw [hi_left, hi_left] at hx2
          exact hx2
        · have hall_out : ∀ pt : ↥S_k, s.base pt ∉ O := fun pt => by
            rw [Subsingleton.elim pt pt₀]
            exact hmem
          have hZero_KO : CategoryTheory.Limits.IsZero ((pb_of s).obj K_O) := hOut_s hall_out
          have hid0_KO : 𝟙 ((L_s s).obj K_O) = 0 :=
            (Ev_0.map_id ((pb_of s).obj K_O)).symm.trans
              ((congrArg Ev_0.map (hZero_KO.eq_of_src (𝟙 ((pb_of s).obj K_O)) 0)).trans rfl)
          intro w
