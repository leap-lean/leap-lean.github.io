          (fun k : L_U.obj.obj (Opposite.op W) ⟶
              (weilAltZeroBdrySubpresheaf S U n).obj (Opposite.op (W_sub W (O_zero W g0 x))) =>
            (k.hom (ψ_zero_fun W g0) : ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀)
          (Φ_zero.hom.naturality (u_sub W (O_zero W g0 x)).op)
        change ((Φ_zero.hom.app (Opposite.op (W_sub W (O_zero W g0 x)))).hom
            ((L_U.obj.map (u_sub W (O_zero W g0 x)).op).hom (ψ_zero_fun W g0)) :
            ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀ =
          ((Φ_zero.hom.app (Opposite.op W)).hom (ψ_zero_fun W g0) :
            ↥(weilAltZeroBdrySubgroup S U n W)).1 ((O_zero W g0 x).ι y₀) at hev
        rw [hy₀, hψ_zero_spec W g0 x] at hev
        change ((Φ_zero.hom.app (Opposite.op W)).hom (ψ_zero_fun W g0) :
            ↥(weilAltZeroBdrySubgroup S U n W)).1 x = g0.1 x
        rw [← hev]
        dsimp only [τ_zero]; split_ifs with hx
        · have hev_h := congrArg
            (fun k : L_U.obj.obj (Opposite.op U_et) ⟶
                (weilAltZeroBdrySubpresheaf S U n).obj (Opposite.op (W_sub W (O_zero W g0 x))) =>
              (k.hom (η_U_hom (g0.1 x)) : ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀)
            (Φ_zero.hom.naturality (lift_Uet W g0 x hx).op)
          change ((Φ_zero.hom.app (Opposite.op (W_sub W (O_zero W g0 x)))).hom
              ((L_U.obj.map (lift_Uet W g0 x hx).op).hom (η_U_hom (g0.1 x))) :
              ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀ =
            (((weilAltZeroBdrySubpresheaf S U n).map (lift_Uet W g0 x hx).op).hom
              ((Φ_zero.hom.app (Opposite.op U_et)).hom (η_U_hom (g0.1 x))) :
              ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀ at hev_h
          rw [hev_h]
          have hα_eq : (Φ_zero.hom.app (Opposite.op U_et)).hom (η_U_hom (g0.1 x)) =
              α₀_hom (g0.1 x) :=
            congrArg (fun k : AM ⟶ K_U.obj.obj (Opposite.op U_et) => k.hom (g0.1 x)) hΦ_zero_η
