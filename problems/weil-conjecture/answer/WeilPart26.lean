      let Fgt_Zc := AlgebraicGeometry.Scheme.Etale.forget Z_c
      letI : CategoryTheory.Limits.PreservesLimitsOfSize (CategoryTheory.Over.pullback i_Z) :=
        (CategoryTheory.Over.mapPullbackAdj i_Z).rightAdjoint_preservesLimits
      letI : CategoryTheory.Limits.PreservesFiniteLimits (CategoryTheory.Over.pullback i_Z) :=
        CategoryTheory.Limits.PreservesLimits.preservesFiniteLimits _
      have hComp_eq : B_Z ⋙ Fgt_Zc = Fgt_Z ⋙ CategoryTheory.Over.pullback i_Z := rfl
      letI : CategoryTheory.Limits.PreservesFiniteLimits (B_Z ⋙ Fgt_Zc) := by
        rw [hComp_eq]
        exact CategoryTheory.Limits.comp_preservesFiniteLimits Fgt_Z (CategoryTheory.Over.pullback i_Z)
      exact CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B_Z Fgt_Zc
    letI : CategoryTheory.Limits.PreservesFiniteLimits B_Z := hLim_BZ
    have hBT_Z : CategoryTheory.Limits.IsTerminal (B_Z.obj (weilEtaleIdTerminal.{u} Z)) :=
      CategoryTheory.Limits.IsTerminal.isTerminalObj B_Z (weilEtaleIdTerminal.{u} Z)
        (weilEtaleIdTerminalIsTerminal.{u} Z)
    have _ : CategoryTheory.RepresentablyFlat B_Z :=
      CategoryTheory.flat_of_preservesFiniteLimits B_Z
    have hCov_BZ : CategoryTheory.CoverPreserving
        Z.smallEtaleTopology Z_c.smallEtaleTopology B_Z := by
      refine ⟨fun {U} R hR => ?_⟩
      rw [hMem_et]
      intro z
      let pr₁ : (B_Z.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom i_Z
      let x : ↥U.left := pr₁ z
      obtain ⟨Y, f, y, hfR, _, hy⟩ := (hMem_et Z U R).mp hR x
      obtain ⟨w₀, _, hw₀_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y z hy
      let l_pb : CategoryTheory.Limits.pullback f.left pr₁ ⟶ (B_Z.obj Y).left :=
        CategoryTheory.Limits.pullback.lift
