theorem weil_top_deg_kummer_two_step_syzygy_edge_iso (n : ℕ) (hn : 1 ≤ n)
    (hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
    (hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f)).IsRightAdjoint) :
    WeilPolyP1ModelTraceTwoStepResPkg n (@hc_all) ∧
    ∀ (δ δ' : ℕ), δ + 1 = δ' →
      ∀ (B : AlgebraicGeometry.Scheme.{u}),
        (∀ (G : CategoryTheory.Sheaf B.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
          n • CategoryTheory.CategoryStruct.id G = 0 →
          2 * δ < q →
          Subsingleton (G.H q)) →
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y B),
          (∀ (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (b : ℕ),
            n • CategoryTheory.CategoryStruct.id F = 0 →
            3 ≤ b →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F)) →
          ∀ (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
            n • CategoryTheory.CategoryStruct.id F = 0 →
            2 * δ' < q →
            Subsingleton (F.H q)) ∧
        (∃ E_edge : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y B)
            (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
            n • CategoryTheory.CategoryStruct.id F = 0 →
            (∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F)) →
            CategoryTheory.Abelian.Ext
              ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              F (2 * δ') ≃+
            CategoryTheory.Abelian.Ext
              ((CategoryTheory.constantSheaf B.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              (weilEtaleHigherDirectImage f 2 F) (2 * δ),
          WeilPolyP1ModelTraceEdgeSyzygyPkg n δ δ' B (@hc_all) (@hr_all) E_edge) :=
by
  classical
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  
  have hMate_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂),
      let pb_h := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
      let Fℤ₁ := (CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ₂ := (CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      (pb_h.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits pb_h ∧
        CategoryTheory.Limits.PreservesFiniteColimits pb_h) ∧
      ∃ ιℤ_0 : Quiver.Hom Fℤ₁ (pb_h.obj Fℤ₂),
        ∃ (T₁ : X₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          (T₂ : X₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
          let πℤ := @weilEtaleConstPullbackHom _ _ h (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
            T₁ hT₁ T₂ hT₂ Aℤ
          CategoryTheory.CategoryStruct.comp ιℤ_0 πℤ =
            CategoryTheory.CategoryStruct.id Fℤ₁ ∧
          CategoryTheory.CategoryStruct.comp πℤ ιℤ_0 =
            CategoryTheory.CategoryStruct.id (pb_h.obj Fℤ₂) := by
    intro X₁ X₂ h
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    obtain ⟨hCont, P_pull, adj_pull, hAdd_P, hLim_P, hColim_P, T₁, hT₁, T₂, hT₂,
      ιℤ_P, h_ιπ_P, h_πι_P, _, _⟩ := weil_etale_pullback_exact_adjoint h
    have hCont_eq : hCont = @hc_all X₁ X₂ h := Subsingleton.elim _ _
    subst hCont_eq
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let pf_h := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback h) AddCommGrpCat.{u} _ J₂ J₁ (@hc_all X₁ X₂ h)
    let pb_h := @CategoryTheory.Functor.sheafPullback _ _ _ _
      (weilEtaleSitePullback h) AddCommGrpCat.{u} _ J₂ J₁ (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
    let adj_h := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      (weilEtaleSitePullback h) AddCommGrpCat.{u} _ J₂ J₁ (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
    let hom_app : ∀ A : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}, P_pull.obj A ⟶ pb_h.obj A :=
      fun A => (adj_pull.homEquiv A (pb_h.obj A)).symm (adj_h.unit.app A)
    let inv_app : ∀ A : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}, pb_h.obj A ⟶ P_pull.obj A :=
      fun A => (adj_h.homEquiv A (P_pull.obj A)).symm (adj_pull.unit.app A)
    have h_hom_comp : ∀ {A : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}}
        {G : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}} (g : pb_h.obj A ⟶ G),
        adj_pull.homEquiv A G (hom_app A ≫ g) = adj_h.homEquiv A G g := by
      intro A G g
      rw [adj_pull.homEquiv_naturality_right]
      dsimp [hom_app]
      rw [Equiv.apply_symm_apply, ← adj_h.homEquiv_unit]
    have h_inv_comp : ∀ {A : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}}
        {G : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}} (g : P_pull.obj A ⟶ G),
        adj_h.homEquiv A G (inv_app A ≫ g) = adj_pull.homEquiv A G g := by
      intro A G g
      rw [adj_h.homEquiv_naturality_right]
      dsimp [inv_app]
      rw [Equiv.apply_symm_apply, ← adj_pull.homEquiv_unit]
    let e_L : P_pull ≅ pb_h :=
      CategoryTheory.NatIso.ofComponents
        (fun A =>
          { hom := hom_app A
            inv := inv_app A
            hom_inv_id := (adj_pull.homEquiv A (P_pull.obj A)).injective (by
              rw [h_hom_comp, Equiv.apply_symm_apply, adj_pull.homEquiv_unit]
              exact ((congrArg (adj_pull.unit.app A ≫ ·) (pf_h.map_id (P_pull.obj A))).trans
                (CategoryTheory.Category.comp_id (adj_pull.unit.app A))).symm)
            inv_hom_id := (adj_h.homEquiv A (pb_h.obj A)).injective (by
              rw [h_inv_comp, Equiv.apply_symm_apply, adj_h.homEquiv_unit]
              exact ((congrArg (adj_h.unit.app A ≫ ·) (pf_h.map_id (pb_h.obj A))).trans
                (CategoryTheory.Category.comp_id (adj_h.unit.app A))).symm) })
        (fun {A₁ A₂} u => (adj_pull.homEquiv A₁ (pb_h.obj A₂)).injective
          ((adj_pull.homEquiv_naturality_left u (hom_app A₂)).trans
            ((congrArg (u ≫ ·)
              (Equiv.apply_symm_apply (adj_pull.homEquiv A₂ (pb_h.obj A₂))
                (adj_h.unit.app A₂))).trans
              ((adj_h.unit.naturality u).trans
                ((adj_h.homEquiv_unit A₁ (pb_h.obj A₂) (pb_h.map u)).symm.trans
                  (h_hom_comp (pb_h.map u)).symm)))))
    haveI : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim_P
    haveI : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim_P
    haveI hLim_pb : CategoryTheory.Limits.PreservesFiniteLimits pb_h :=
      CategoryTheory.Limits.preservesFiniteLimits_of_natIso e_L
