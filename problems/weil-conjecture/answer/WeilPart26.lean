                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)))
      · have hmap_snd :
            CategoryTheory.CategoryStruct.comp ((B a).map u).left
              (CategoryTheory.Limits.pullback.snd W.hom (σ a)) =
            CategoryTheory.Limits.pullback.snd W'.hom (σ a) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        exact (CategoryTheory.Category.assoc (bwd a W' γ).1 ((B a).map u).left
          (CategoryTheory.Limits.pullback.snd W.hom (σ a))).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (bwd a W' γ).1) hmap_snd).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm))
    let π_coord : ∀ a : Fin m, 𝒮_I ⟶ (pf a).obj J_base :=
      fun a => CategoryTheory.ObjectProperty.homMk
        { app := fun opW =>
            AddCommGrpCat.ofHom
              { toFun := fun s b s₀ =>
                  s a (fwd a (Opposite.unop opW)
                    (Eq.mp (by rw [Subsingleton.elim b (0 : Fin 1)]; rfl) s₀))
                map_zero' := rfl
                map_add' := fun _ _ => rfl }
          naturality := fun {opW₁ opW₂} f => by
            apply AddCommGrpCat.ext
            intro s
            funext b s₀
            have hb : b = 0 := Subsingleton.elim _ _
            subst hb
            exact congrArg (s a) (h_fwd_nat a f.unop s₀).symm }
    refine CategoryTheory.Injective.mk (fun {𝒜 ℬ} g f _ => ?_)
    have h_ex : ∀ a : Fin m, ∃ h_a : ℬ ⟶ (pf a).obj J_base, f ≫ h_a = g ≫ π_coord a := by
      intro a
      have : CategoryTheory.Injective ((pf a).obj J_base) := hInj_pf a
