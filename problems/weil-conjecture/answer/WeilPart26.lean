      CategoryTheory.CategoryStruct.id (pb_h.obj Fℤ₂) := by
    change CategoryTheory.CategoryStruct.comp
        (@weilEtaleConstPullbackHom Y₁ Y₂ h hc_h hr_h T'₁ hT'₁ T'₂ hT'₂ Aℤ) ιℤ = _ at hι_r
    rwa [hConstPull_indep Aℤ hT'₁ hT'₂] at hι_r
  have hp_w : p_h w =
      (CategoryTheory.Abelian.Ext.mk₀ πM_T).postcomp Fℤ₁ (Nat.add_zero i)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((pb_h.mapExtAddHom Fℤ₂ (weilEtaleTorsionSheaf Y₂ n) i) w)
          (Nat.zero_add i)) := by
    have hpw := hp_eq w
    change p_h w =
      (CategoryTheory.Abelian.Ext.mk₀
          (@weilEtaleConstPullbackHom Y₁ Y₂ h hc_h hr_h T'₁ hT'₁ T'₂ hT'₂ AM)).postcomp
        Fℤ₁ (Nat.add_zero i)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((pb_h.mapExtAddHom Fℤ₂ (weilEtaleTorsionSheaf Y₂ n) i) w)
          (Nat.zero_add i)) at hpw
    rwa [hConstPull_indep AM hT'₁ hT'₂] at hpw
  let R₂ := weilPolyP1CohomologyRepSheaf Y₂ T₂
  let c₁ := weilPolyP1CohomologyRepToConst Y₁ T₁ hT₁
  let c₂ := weilPolyP1CohomologyRepToConst Y₂ T₂ hT₂
  let ρ_T := @weilPolyP1CohomologyRepPullHom Y₁ Y₂ h hc_h hr_h T₂ T₁ u_T
  have hYoneda_pre : CategoryTheory.CategoryStruct.comp ρ_T
      (CategoryTheory.CategoryStruct.comp (pb_h.map c₂) πℤ_T) = c₁ := by
    let φ : Quiver.Hom (pb_h.obj R₂) Fℤ₁ := CategoryTheory.CategoryStruct.comp (pb_h.map c₂) πℤ_T
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let ι₂ : ↑(R₂.obj.obj (Opposite.op T₂)) :=
      weilPolyP1CohomologyRepHomEquiv Y₂ T₂ R₂ (CategoryTheory.CategoryStruct.id R₂)
    apply (weilPolyP1CohomologyRepHomEquiv Y₁ T₁ Fℤ₁).injective
    rw [hRepHomEquiv_right Y₁ T₁ ρ_T φ]
    have hc₁_ev : weilPolyP1CohomologyRepHomEquiv Y₁ T₁ Fℤ₁ c₁ =
        (adj₁.unit.app Aℤ) (ULift.up (1 : ℤ)) := by
      dsimp only [c₁, weilPolyP1CohomologyRepToConst]
      exact (weilPolyP1CohomologyRepHomEquiv Y₁ T₁ Fℤ₁).apply_symm_apply _
    have hρ_ev : weilPolyP1CohomologyRepHomEquiv Y₁ T₁ (pb_h.obj R₂) ρ_T =
        ((pb_h.obj R₂).obj.map (Opposite.op u_T))
          (((adj_h.unit.app R₂).hom.app (Opposite.op T₂)) ι₂) := by
      dsimp only [ρ_T, weilPolyP1CohomologyRepPullHom]
      exact (weilPolyP1CohomologyRepHomEquiv Y₁ T₁ (pb_h.obj R₂)).apply_symm_apply _
    rw [hc₁_ev, hρ_ev]
    have hnat_u : (φ.hom.app (Opposite.op T₁))
        (((pb_h.obj R₂).obj.map (Opposite.op u_T))
          (((adj_h.unit.app R₂).hom.app (Opposite.op T₂)) ι₂)) =
        (Fℤ₁.obj.map (Opposite.op u_T))
          ((φ.hom.app (Opposite.op (B_h.obj T₂)))
            (((adj_h.unit.app R₂).hom.app (Opposite.op T₂)) ι₂)) := by
      have hn := congrArg (fun m => m (((adj_h.unit.app R₂).hom.app (Opposite.op T₂)) ι₂))
        (φ.hom.naturality (Opposite.op u_T))
      exact hn
    rw [hnat_u]
    have hmate_sq : CategoryTheory.CategoryStruct.comp (adj_h.unit.app R₂) (pf_h.map φ) =
        CategoryTheory.CategoryStruct.comp c₂ (adj_h.homEquiv Fℤ₂ Fℤ₁ πℤ_T) :=
      (adj_h.homEquiv_unit R₂ Fℤ₁ φ).symm.trans (adj_h.homEquiv_naturality_left c₂ πℤ_T)
    have hmate_ev : (φ.hom.app (Opposite.op (B_h.obj T₂)))
        (((adj_h.unit.app R₂).hom.app (Opposite.op T₂)) ι₂) =
        (((adj_h.homEquiv Fℤ₂ Fℤ₁ πℤ_T).hom.app (Opposite.op T₂))
          ((c₂.hom.app (Opposite.op T₂)) ι₂)) :=
      congrArg (fun m => (m.hom.app (Opposite.op T₂)) ι₂) hmate_sq
    rw [hmate_ev]
    have hc₂_ev : (c₂.hom.app (Opposite.op T₂)) ι₂ =
        (adj₂.unit.app Aℤ) (ULift.up (1 : ℤ)) := by
      have h1 := (hRepHomEquiv_right Y₂ T₂ (CategoryTheory.CategoryStruct.id R₂) c₂).symm
      rw [CategoryTheory.Category.id_comp] at h1
      refine h1.trans ?_
      dsimp only [c₂, weilPolyP1CohomologyRepToConst]
      exact (weilPolyP1CohomologyRepHomEquiv Y₂ T₂ Fℤ₂).apply_symm_apply _
    rw [hc₂_ev]
    have hπ_mate : CategoryTheory.CategoryStruct.comp (adj₂.unit.app Aℤ)
        ((adj_h.homEquiv Fℤ₂ Fℤ₁ πℤ_T).hom.app (Opposite.op T₂)) =
        CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
          (Fℤ₁.obj.map (hT₁.from (B_h.obj T₂)).op) := by
      change adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁) (adj_h.homEquiv Fℤ₂ Fℤ₁ πℤ_T) = _
      dsimp only [πℤ_T, weilEtaleConstPullbackHom]
      rw [(adj_h.homEquiv Fℤ₂ Fℤ₁).apply_symm_apply,
        (adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁)).apply_symm_apply]
      rfl
    have hπ_ev := congrArg (fun m => m (ULift.up (1 : ℤ))) hπ_mate
    change (Fℤ₁.obj.map (Opposite.op u_T))
        ((CategoryTheory.CategoryStruct.comp (adj₂.unit.app Aℤ)
          ((adj_h.homEquiv Fℤ₂ Fℤ₁ πℤ_T).hom.app (Opposite.op T₂))) (ULift.up (1 : ℤ))) = _
    rw [hπ_ev]
    change ((CategoryTheory.CategoryStruct.comp
        (Fℤ₁.obj.map (hT₁.from (B_h.obj T₂)).op)
        (Fℤ₁.obj.map u_T.op))
          ((adj₁.unit.app Aℤ) (ULift.up (1 : ℤ)))) = _
    rw [← Fℤ₁.obj.map_comp, ← op_comp,
      hT₁.hom_ext (CategoryTheory.CategoryStruct.comp u_T (hT₁.from (B_h.obj T₂)))
        (CategoryTheory.CategoryStruct.id T₁),
      op_id, Fℤ₁.obj.map_id]
    rfl
  have hYoneda_sq : CategoryTheory.CategoryStruct.comp c₁ ιℤ =
      CategoryTheory.CategoryStruct.comp ρ_T (pb_h.map c₂) := by
    rw [← hYoneda_pre, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      hι_r', CategoryTheory.Category.comp_id]
  rw [hp_w]
  let z_w := (pb_h.mapExtAddHom Fℤ₂ (weilEtaleTorsionSheaf Y₂ n) i) w
  have hmap_c₂ :
      (pb_h.mapExtAddHom R₂ (weilEtaleTorsionSheaf Y₂ n) i)
        ((CategoryTheory.Abelian.Ext.mk₀ c₂).comp w (Nat.zero_add i)) =
      (CategoryTheory.Abelian.Ext.mk₀ (pb_h.map c₂)).comp z_w (Nat.zero_add i) := by
    dsimp only [z_w]
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
  change (CategoryTheory.Abelian.Ext.mk₀ c₁).comp
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp z_w (Nat.zero_add i)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_T) (Nat.add_zero i))
      (Nat.zero_add i) =
    ((CategoryTheory.Abelian.Ext.mk₀ ρ_T).comp
      ((pb_h.mapExtAddHom R₂ (weilEtaleTorsionSheaf Y₂ n) i)
        ((CategoryTheory.Abelian.Ext.mk₀ c₂).comp w (Nat.zero_add i)))
      (Nat.zero_add i)).comp
      (CategoryTheory.Abelian.Ext.mk₀ πM_T) (Nat.add_zero i)
  rw [hmap_c₂,
    ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
      (CategoryTheory.Abelian.Ext.mk₀ c₁) _ (CategoryTheory.Abelian.Ext.mk₀ πM_T) (Nat.zero_add i),
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc c₁ ιℤ z_w,
    hYoneda_sq,
    ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc ρ_T (pb_h.map c₂) z_w]

theorem weil_acyclic_leray_composition_and_edge_spec_eval (n : ℕ)
    (hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
    (hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f)).IsRightAdjoint)
    (hExact_pb : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f) (@hr_all X₁ X₂ f)
      pb.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let pf_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h)
    let pb_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
    let adj_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
    let Fℤ_of := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
      (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let πℤ_of : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (u : Quiver.Hom Z₁ Z₂),
        Quiver.Hom ((pb_of u).obj (Fℤ_of Z₂)) (Fℤ_of Z₁) :=
      fun {Z₁ Z₂} u =>
        @weilEtaleConstPullbackHom Z₁ Z₂ u (@hc_all Z₁ Z₂ u) (@hr_all Z₁ Z₂ u)
          (weilEtaleIdTerminal.{u} Z₁) (weilEtaleIdTerminalIsTerminal.{u} Z₁)
          (weilEtaleIdTerminal.{u} Z₂) (weilEtaleIdTerminalIsTerminal.{u} Z₂) Aℤ
    let leray_fn : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (u : Quiver.Hom Z₁ Z₂)
        (_ : Quiver.Hom (Fℤ_of Z₁) ((pb_of u).obj (Fℤ_of Z₂)))
        (G : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}) (r : ℕ),
        (((pf_of u).obj G).H r) → (G.H r) :=
      fun {Z₁ Z₂} u ι G r z =>
        (CategoryTheory.Abelian.Ext.mk₀ ((adj_of u).counit.app G)).postcomp (Fℤ_of Z₁) (Nat.add_zero r)
          ((CategoryTheory.Abelian.Ext.mk₀ ι).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ (pb_of u)
              (hExact_pb u).1 (hExact_pb u).2.1 (hExact_pb u).2.2 _ _
              (Fℤ_of Z₂) ((pf_of u).obj G) r) z)
            (Nat.zero_add r))
    let θ_push : ∀ {W₀ Y₀ B₀ : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom W₀ Y₀) (f : Quiver.Hom Y₀ B₀) (h : Quiver.Hom W₀ B₀)
        (_hgf : CategoryTheory.CategoryStruct.comp g f = h)
        (M : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Iso ((pf_of h).obj M) ((pf_of f).obj ((pf_of g).obj M)) :=
      fun {W₀ Y₀ B₀} g f h hgf M =>
        let e_B : CategoryTheory.Iso (weilEtaleSitePullback h)
            (CategoryTheory.Functor.comp (weilEtaleSitePullback f) (weilEtaleSitePullback g)) :=
          CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr hgf.symm)
            (CategoryTheory.MorphismProperty.Over.pullbackComp g f)
        letI : (weilEtaleSitePullback h).IsContinuous B₀.smallEtaleTopology W₀.smallEtaleTopology :=
          @hc_all W₀ B₀ h
        letI : (CategoryTheory.Functor.comp (weilEtaleSitePullback f) (weilEtaleSitePullback g)).IsContinuous
            B₀.smallEtaleTopology W₀.smallEtaleTopology :=
          @CategoryTheory.Functor.isContinuous_comp _ _ _ _ _ _
            (weilEtaleSitePullback f) (weilEtaleSitePullback g)
            B₀.smallEtaleTopology Y₀.smallEtaleTopology W₀.smallEtaleTopology
            (@hc_all Y₀ B₀ f) (@hc_all W₀ Y₀ g)
        (CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
          AddCommGrpCat.{u} B₀.smallEtaleTopology W₀.smallEtaleTopology).app M
    ((∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (u : Quiver.Hom Z₁ Z₂)
        (ι : Quiver.Hom (Fℤ_of Z₁) ((pb_of u).obj (Fℤ_of Z₂))),
        CategoryTheory.CategoryStruct.comp ι (πℤ_of u) = CategoryTheory.CategoryStruct.id (Fℤ_of Z₁) →
        CategoryTheory.CategoryStruct.comp (πℤ_of u) ι = CategoryTheory.CategoryStruct.id ((pb_of u).obj (Fℤ_of Z₂)) →
        ∀ (G : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
          (∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u p G)) →
          ∀ r : ℕ, Function.Bijective (leray_fn u ι G r)) ∧
      (∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (u : Quiver.Hom Z₁ Z₂)
        (ι : Quiver.Hom (Fℤ_of Z₁) ((pb_of u).obj (Fℤ_of Z₂)))
        {G G' : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}}
        (ψ : Quiver.Hom G G') (r : ℕ) (z : ((pf_of u).obj G).H r),
        CategoryTheory.CategoryStruct.comp ι (πℤ_of u) = CategoryTheory.CategoryStruct.id (Fℤ_of Z₁) →
        CategoryTheory.CategoryStruct.comp (πℤ_of u) ι = CategoryTheory.CategoryStruct.id ((pb_of u).obj (Fℤ_of Z₂)) →
        leray_fn u ι G' r (((CategoryTheory.Abelian.Ext.mk₀ ((pf_of u).map ψ)).postcomp
          (Fℤ_of Z₂) (Nat.add_zero r)) z) =
        ((CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp (Fℤ_of Z₁) (Nat.add_zero r))
          (leray_fn u ι G r z)) ∧
      (∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X Y)
        (ιℤ_f : Quiver.Hom (Fℤ_of X) ((pb_of f).obj (Fℤ_of Y)))
        (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact),
        letI : (pf_of f).Additive := CategoryTheory.Functor.additive_of_preserves_binary_products (pf_of f)
        ∀ (hSE' : (SC.map (pf_of f)).ShortExact)
          (q r : ℕ) (hqr : q + 1 = r)
          (β : ((pf_of f).obj SC.X₃).H q),
          leray_fn f ιℤ_f SC.X₁ r (β.comp hSE'.extClass hqr) =
            (leray_fn f ιℤ_f SC.X₃ q β).comp hSE.extClass hqr) ∧
      (∀ {W₀ Y₀ B₀ : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom W₀ Y₀) (f : Quiver.Hom Y₀ B₀) (h : Quiver.Hom W₀ B₀)
        (hgf : CategoryTheory.CategoryStruct.comp g f = h)
        (ι_g : Quiver.Hom (Fℤ_of W₀) ((pb_of g).obj (Fℤ_of Y₀)))
        (ι_f : Quiver.Hom (Fℤ_of Y₀) ((pb_of f).obj (Fℤ_of B₀)))
        (ι_h : Quiver.Hom (Fℤ_of W₀) ((pb_of h).obj (Fℤ_of B₀))),
        CategoryTheory.CategoryStruct.comp ι_g (πℤ_of g) = CategoryTheory.CategoryStruct.id _ →
        CategoryTheory.CategoryStruct.comp (πℤ_of g) ι_g = CategoryTheory.CategoryStruct.id _ →
        CategoryTheory.CategoryStruct.comp ι_f (πℤ_of f) = CategoryTheory.CategoryStruct.id _ →
        CategoryTheory.CategoryStruct.comp (πℤ_of f) ι_f = CategoryTheory.CategoryStruct.id _ →
        CategoryTheory.CategoryStruct.comp ι_h (πℤ_of h) = CategoryTheory.CategoryStruct.id _ →
        CategoryTheory.CategoryStruct.comp (πℤ_of h) ι_h = CategoryTheory.CategoryStruct.id _ →
        ∀ (M : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
          (z : ((pf_of h).obj M).H q),
          leray_fn h ι_h M q z =
            leray_fn g ι_g M q
              (leray_fn f ι_f ((pf_of g).obj M) q
                (((CategoryTheory.Abelian.Ext.mk₀ (θ_push g f h hgf M).hom).postcomp
                  (Fℤ_of B₀) (Nat.add_zero q)) z)))) ∧
    (∀ (k : Type u) [Field k] [IsAlgClosed k],
      let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
      let J_k := S_k.smallEtaleTopology
      let T_0 : S_k.Etale := weilEtaleIdTerminal.{u} S_k
      let hT_0 : CategoryTheory.Limits.IsTerminal T_0 := weilEtaleIdTerminalIsTerminal.{u} S_k
      ∀ {Y : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y S_k)
        (hT_Bf : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_0))
        (ιℤ_f : Quiver.Hom (Fℤ_of Y) ((pb_of f).obj (Fℤ_of S_k)))
        (_ : CategoryTheory.CategoryStruct.comp ιℤ_f
          (@weilEtaleConstPullbackHom _ _ f (@hc_all Y S_k f) (@hr_all Y S_k f)
            ((weilEtaleSitePullback f).obj T_0) hT_Bf T_0 hT_0 Aℤ) =
          CategoryTheory.CategoryStruct.id _)
        (F M_0 Q_1 M_1 Q_2 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (i_0 : Quiver.Hom F M_0) (p_0 : Quiver.Hom M_0 Q_1)
        (h0_0 : CategoryTheory.CategoryStruct.comp i_0 p_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk i_0 p_0 h0_0).ShortExact)
        (i_1 : Quiver.Hom Q_1 M_1) (p_1 : Quiver.Hom M_1 Q_2)
        (h0_1 : CategoryTheory.CategoryStruct.comp i_1 p_1 = 0)
        (hSE_1 : (CategoryTheory.ShortComplex.mk i_1 p_1 h0_1).ShortExact)
        (Δ₂ : Quiver.Hom ((pf_of f).obj Q_2) (weilEtaleHigherDirectImage f 2 F)),
        (let Q_F := CategoryTheory.Sheaf.cohomologyPresheaf F 2
         let P_F := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_F
         let η_F := (CategoryTheory.sheafificationAdjunction J_k AddCommGrpCat.{u}).unit.app P_F
         ∀ (V : S_k.Etale) (s : ↑(((pf_of f).obj Q_2).obj.obj (Opposite.op V))),
           let U_V : Y.Etale := (weilEtaleSitePullback f).obj V
           let s_ext : ↑(Q_F.obj (Opposite.op U_V)) :=
             (((CategoryTheory.Abelian.Ext.mk₀
                 ((weilPolyP1CohomologyRepHomEquiv Y U_V Q_2).symm s)).comp
               hSE_1.extClass (Nat.zero_add 1)).comp
               hSE_0.extClass (Nat.one_add 1))
           (Δ₂.hom.app (Opposite.op V)) s = (η_F.app (Opposite.op V)) s_ext) →
        ∀ (x : F.H 2) (q_2 : Q_2.H 0) (q_base : ((pf_of f).obj Q_2).H 0),
          (q_2.comp hSE_1.extClass (Nat.zero_add 1)).comp hSE_0.extClass (Nat.one_add 1) = x →
          leray_fn f ιℤ_f Q_2 0 q_base = q_2 →
          let Q_F := CategoryTheory.Sheaf.cohomologyPresheaf F 2
