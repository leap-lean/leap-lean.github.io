      rw [h_ulift_natCast r.down.val]
      exact ZMod.natCast_zmod_val r.down

    have hRn_smul_eq_nsmul : ∀ {M : Type u} [AddCommGroup M] [Module R_n M] (r : R_n) (m : M),
        r • m = r.down.val • m := by
      intro M _ _ r m
      conv_lhs => rw [← h_Rn_val_cast r]
      exact Nat.cast_smul_eq_nsmul R_n r.down.val m

    have hRn_lin : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R_n M₁]
        [AddCommGroup M₂] [Module R_n M₂] (g : M₁ →+ M₂) (r : R_n) (m : M₁),
        g (r • m) = r • g m := by
      intro M₁ M₂ _ _ _ _ g r m
      rw [hRn_smul_eq_nsmul, hRn_smul_eq_nsmul, map_nsmul]

    
    have hTor_U0 : ∀ K : CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R_n),
        n • CategoryTheory.CategoryStruct.id (U_0.obj K) = 0 := by
      intro K
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext V
      ext x
      rw [h_nsmul_sh (U_0.obj K) n V x]
      let x' : ↑(K.obj.obj V) := x
      change n • x' = 0
      rw [← Nat.cast_smul_eq_nsmul R_n n x', h_Rn_n_zero, zero_smul]

    
    let liftHom : ∀ {K₁ K₂ : CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R_n)},
        (U_0.obj K₁ ⟶ U_0.obj K₂) → (K₁ ⟶ K₂) :=
      fun {K₁ K₂} f =>
        CategoryTheory.ObjectProperty.homMk
          { app := fun V =>
              let gV : ↑(K₁.obj.obj V) →+ ↑(K₂.obj.obj V) := (f.hom.app V).hom
              ModuleCat.ofHom
                { toAddHom := gV.toAddHom
                  map_smul' := fun r x => hRn_lin gV r x }
            naturality := fun {V₁ V₂} u => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro x
              exact congrArg (fun ψ => ψ.hom x) (f.hom.naturality u) }

    have h_liftHom_spec : ∀ {K₁ K₂ : CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R_n)}
        (f : U_0.obj K₁ ⟶ U_0.obj K₂), U_0.map (liftHom f) = f := by
      intro K₁ K₂ f
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext V
      ext x
      rfl

    
    let mkMod : ∀ (A : AddCommGrpCat.{u}), (∀ x : ↑A, n • x = 0) → Module R_n ↑A :=
      fun A hA =>
        have h_mod : ∀ (m : ℕ) (x : ↑A), (m % n) • x = m • x := by
          intro m x
          conv_rhs => rw [← Nat.div_add_mod m n]
          rw [add_nsmul, mul_comm n (m / n), mul_nsmul', hA x, nsmul_zero, zero_add]
        { smul := fun r x => r.down.val • x
          one_smul := fun x => by
            change (1 : ZMod n).val • x = x
            rw [ZMod.val_one_eq_one_mod n, h_mod 1 x, one_nsmul]
          mul_smul := fun r s x => by
            change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
            rw [ZMod.val_mul, h_mod _ x, mul_nsmul']
          smul_zero := fun r => nsmul_zero r.down.val
          smul_add := fun r x y => nsmul_add x y r.down.val
          add_smul := fun r s x => by
            change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
            rw [ZMod.val_add, h_mod _ x, add_nsmul]
          zero_smul := fun x => by
            change (0 : ZMod n).val • x = 0
            rw [ZMod.val_zero, zero_nsmul] }

    let L_tor : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        n • CategoryTheory.CategoryStruct.id G = 0 →
        CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R_n) :=
      fun G hG =>
        have hG_pt : ∀ (V : Opposite W.Etale) (x : ↑(G.obj.obj V)), n • x = 0 := by
          intro V x
          rw [← h_nsmul_sh G n V x, hG]
          rfl
        let P_G : CategoryTheory.Functor (Opposite W.Etale) (ModuleCat.{u, u} R_n) :=
          { obj := fun V => @ModuleCat.of R_n _ ↑(G.obj.obj V) _ (mkMod (G.obj.obj V) (hG_pt V))
            map := fun {V₁ V₂} u =>
              letI : Module R_n ↑(G.obj.obj V₁) := mkMod (G.obj.obj V₁) (hG_pt V₁)
              letI : Module R_n ↑(G.obj.obj V₂) := mkMod (G.obj.obj V₂) (hG_pt V₂)
              ModuleCat.ofHom
                { toAddHom := (G.obj.map u).hom.toAddHom
                  map_smul' := fun r x => hRn_lin (G.obj.map u).hom r x }
            map_id := fun V => by
              let _ : Module R_n ↑(G.obj.obj V) := mkMod (G.obj.obj V) (hG_pt V)
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro x
              exact congrArg (fun ψ => ψ.hom x) (G.obj.map_id V)
            map_comp := fun {V₁ V₂ V₃} u v => by
              let _ : Module R_n ↑(G.obj.obj V₁) := mkMod (G.obj.obj V₁) (hG_pt V₁)
              let _ : Module R_n ↑(G.obj.obj V₂) := mkMod (G.obj.obj V₂) (hG_pt V₂)
              let _ : Module R_n ↑(G.obj.obj V₃) := mkMod (G.obj.obj V₃) (hG_pt V₃)
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro x
              exact congrArg (fun ψ => ψ.hom x) (G.obj.map_comp u v) }
        ⟨P_G, CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J_W P_G Fgt G.2⟩

    
    intro E hTor_E
    let E_mod := L_tor E hTor_E
    let I_mod : CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R_n) := CategoryTheory.Injective.under E_mod
    let ι_mod : E_mod ⟶ I_mod := CategoryTheory.Injective.ι E_mod
    let I : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} := U_0.obj I_mod
    let i : E ⟶ I := U_0.map ι_mod

    have hMono_i : CategoryTheory.Mono i := by
      have : CategoryTheory.Mono ι_mod.hom :=
        (CategoryTheory.sheafToPresheaf J_W (ModuleCat.{u, u} R_n)).map_mono ι_mod
      have : ∀ V : Opposite W.Etale, CategoryTheory.Mono (i.hom.app V) := by
        intro V
        have hMono_app : CategoryTheory.Mono (ι_mod.hom.app V) :=
          ((CategoryTheory.evaluation (Opposite W.Etale) (ModuleCat.{u, u} R_n)).obj V).map_mono
            ι_mod.hom
        have hInj : Function.Injective (ι_mod.hom.app V).hom :=
          (ModuleCat.mono_iff_injective (ι_mod.hom.app V)).mp hMono_app
        exact (AddCommGrpCat.mono_iff_injective (i.hom.app V)).mpr hInj
      have hMono_i_psh : CategoryTheory.Mono i.hom :=
        CategoryTheory.NatTrans.mono_of_mono_app i.hom
      exact (CategoryTheory.sheafToPresheaf J_W AddCommGrpCat.{u}).mono_of_mono_map hMono_i_psh

    let Q : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel i
    let p : I ⟶ Q := CategoryTheory.Limits.cokernel.π i
    have h0 : CategoryTheory.CategoryStruct.comp i p = 0 := CategoryTheory.Limits.cokernel.condition i
    have hSE : (CategoryTheory.ShortComplex.mk i p h0).ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_cokernel i }
    have hTor_I : n • CategoryTheory.CategoryStruct.id I = 0 := hTor_U0 I_mod
    have hTor_Q : n • CategoryTheory.CategoryStruct.id Q = 0 := by
      apply (CategoryTheory.cancel_epi p).mp
      calc
        p ≫ (n • CategoryTheory.CategoryStruct.id Q)
          = n • (p ≫ CategoryTheory.CategoryStruct.id Q) :=
              CategoryTheory.Preadditive.comp_nsmul p (CategoryTheory.CategoryStruct.id Q) n
        _ = n • (CategoryTheory.CategoryStruct.id I ≫ p) := by
              rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        _ = (n • CategoryTheory.CategoryStruct.id I) ≫ p :=
              (CategoryTheory.Preadditive.nsmul_comp (CategoryTheory.CategoryStruct.id I) p n).symm
        _ = 0 ≫ p := by rw [hTor_I]
        _ = p ≫ 0 := by rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

    refine ⟨I, Q, i, p, h0, ⟨hTor_I, hTor_Q, hSE⟩, ?_, ?_⟩
    · 
      intro A B_sh ι hMono_ι hTor_B α
      have hTor_A : n • CategoryTheory.CategoryStruct.id A = 0 := by
        apply (CategoryTheory.cancel_mono ι).mp
        calc
          (n • CategoryTheory.CategoryStruct.id A) ≫ ι
            = n • (CategoryTheory.CategoryStruct.id A ≫ ι) :=
                CategoryTheory.Preadditive.nsmul_comp (CategoryTheory.CategoryStruct.id A) ι n
          _ = n • (ι ≫ CategoryTheory.CategoryStruct.id B_sh) := by
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
          _ = ι ≫ (n • CategoryTheory.CategoryStruct.id B_sh) :=
                (CategoryTheory.Preadditive.comp_nsmul ι (CategoryTheory.CategoryStruct.id B_sh) n).symm
          _ = ι ≫ 0 := by rw [hTor_B]
          _ = 0 ≫ ι := by rw [CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
      let A_mod := L_tor A hTor_A
      let B_mod := L_tor B_sh hTor_B
      let ι_mod' : A_mod ⟶ B_mod := liftHom ι
      have h_ι_eq : U_0.map ι_mod' = ι := @h_liftHom_spec A_mod B_mod ι
      have hMono_map : CategoryTheory.Mono (U_0.map ι_mod') := by
        rw [h_ι_eq]
        exact hMono_ι
      have : CategoryTheory.Mono ι_mod' := U_0.mono_of_mono_map hMono_map
      let α_mod : A_mod ⟶ I_mod := liftHom α
      have h_α_eq : U_0.map α_mod = α := @h_liftHom_spec A_mod I_mod α
      let β_mod : B_mod ⟶ I_mod := CategoryTheory.Injective.factorThru α_mod ι_mod'
      refine ⟨U_0.map β_mod, ?_⟩
      change U_0.map ι_mod' ≫ U_0.map β_mod = α
      rw [← U_0.map_comp, CategoryTheory.Injective.comp_factorThru]
      exact h_α_eq

    · 
      let J : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} := CategoryTheory.Injective.under I
      let ι_J : I ⟶ J := CategoryTheory.Injective.ι I
      let m_J : J ⟶ J := n • CategoryTheory.CategoryStruct.id J
      have hιJ_ker : ι_J ≫ m_J = 0 := by
        dsimp [m_J]
        calc
          ι_J ≫ (n • CategoryTheory.CategoryStruct.id J)
            = n • (ι_J ≫ CategoryTheory.CategoryStruct.id J) :=
                CategoryTheory.Preadditive.comp_nsmul ι_J (CategoryTheory.CategoryStruct.id J) n
          _ = n • (CategoryTheory.CategoryStruct.id I ≫ ι_J) := by
                rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          _ = (n • CategoryTheory.CategoryStruct.id I) ≫ ι_J :=
                (CategoryTheory.Preadditive.nsmul_comp (CategoryTheory.CategoryStruct.id I) ι_J n).symm
          _ = 0 ≫ ι_J := by rw [hTor_I]
          _ = 0 := CategoryTheory.Limits.zero_comp
      let H := CategoryTheory.Limits.kernel m_J
      let κ : H ⟶ J := CategoryTheory.Limits.kernel.ι m_J
      let α_I : I ⟶ H := CategoryTheory.Limits.kernel.lift m_J ι_J hιJ_ker
      have hακ : α_I ≫ κ = ι_J := CategoryTheory.Limits.kernel.lift_ι m_J ι_J hιJ_ker
      have hMono_αI : CategoryTheory.Mono α_I := by
        have : CategoryTheory.Mono (α_I ≫ κ) := by
          rw [hακ]
          infer_instance
        exact CategoryTheory.mono_of_mono α_I κ
      have hTor_H : n • CategoryTheory.CategoryStruct.id H = 0 := by
        apply (CategoryTheory.cancel_mono κ).mp
        calc
          (n • CategoryTheory.CategoryStruct.id H) ≫ κ
            = n • (CategoryTheory.CategoryStruct.id H ≫ κ) :=
                CategoryTheory.Preadditive.nsmul_comp (CategoryTheory.CategoryStruct.id H) κ n
          _ = n • (κ ≫ CategoryTheory.CategoryStruct.id J) := by
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
          _ = κ ≫ m_J :=
                (CategoryTheory.Preadditive.comp_nsmul κ (CategoryTheory.CategoryStruct.id J) n).symm
          _ = 0 := CategoryTheory.Limits.kernel.condition m_J
          _ = 0 ≫ κ := CategoryTheory.Limits.zero_comp.symm
      let H_mod := L_tor H hTor_H
      let α_mod : I_mod ⟶ H_mod := liftHom α_I
      have h_αI_eq : U_0.map α_mod = α_I := @h_liftHom_spec I_mod H_mod α_I
      have hMono_αmap : CategoryTheory.Mono (U_0.map α_mod) := by
        rw [h_αI_eq]
        exact hMono_αI
      have : CategoryTheory.Mono α_mod := U_0.mono_of_mono_map hMono_αmap
      let ρ_mod : H_mod ⟶ I_mod :=
        CategoryTheory.Injective.factorThru (CategoryTheory.CategoryStruct.id I_mod) α_mod
      refine ⟨J, inferInstance, α_I, U_0.map ρ_mod, ?_⟩
      calc
        α_I ≫ U_0.map ρ_mod
          = U_0.map α_mod ≫ U_0.map ρ_mod := (congrArg (· ≫ U_0.map ρ_mod) h_αI_eq).symm
        _ = U_0.map (α_mod ≫ ρ_mod) := (U_0.map_comp α_mod ρ_mod).symm
        _ = U_0.map (CategoryTheory.CategoryStruct.id I_mod) := by
              rw [CategoryTheory.Injective.comp_factorThru]
        _ = CategoryTheory.CategoryStruct.id I := U_0.map_id I_mod

  
  
  
  have hStep2 : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
      (M J : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective J]
      (α : Quiver.Hom M (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J)))
      (ρ : Quiver.Hom (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J)) M),
      CategoryTheory.CategoryStruct.comp α ρ = CategoryTheory.CategoryStruct.id M →
      let pf_h := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        S₂.smallEtaleTopology S₁.smallEtaleTopology (@hc_all S₁ S₂ h)
      ∃ (J' : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
        (_ : CategoryTheory.Injective J')
        (α' : Quiver.Hom (pf_h.obj M)
          (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J')))
        (ρ' : Quiver.Hom
          (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J'))
          (pf_h.obj M)),
        CategoryTheory.CategoryStruct.comp α' ρ' = CategoryTheory.CategoryStruct.id (pf_h.obj M) := by
    intro S₁ S₂ h M J _ α ρ hαρ pf_h
    have : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
      @hc_all S₁ S₂ h
    have : pf_h.IsRightAdjoint := @hr_all S₁ S₂ h
    let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    have : CategoryTheory.Limits.PreservesFiniteLimits pb_h := (hExact_pb h).2.1
    let adj_h := (weilEtaleSitePullback h).sheafAdjunctionContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    let J' := pf_h.obj J
    have hInj' : CategoryTheory.Injective J' :=
      CategoryTheory.Injective.injective_of_adjoint adj_h J
    have : pf_h.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products pf_h
    have hm : pf_h.map (n • CategoryTheory.CategoryStruct.id J) =
        n • CategoryTheory.CategoryStruct.id J' := by
      rw [pf_h.map_nsmul, pf_h.map_id]
    let e_pres := CategoryTheory.Limits.PreservesKernel.iso pf_h
      (n • CategoryTheory.CategoryStruct.id J)
    let κ₁ := CategoryTheory.Limits.kernel.ι (pf_h.map (n • CategoryTheory.CategoryStruct.id J))
    let κ₂ := CategoryTheory.Limits.kernel.ι (n • CategoryTheory.CategoryStruct.id J')
    let u₁₂ : CategoryTheory.Limits.kernel (pf_h.map (n • CategoryTheory.CategoryStruct.id J)) ⟶
        CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J') :=
      CategoryTheory.Limits.kernel.lift (n • CategoryTheory.CategoryStruct.id J') κ₁
        (by rw [← hm]; exact CategoryTheory.Limits.kernel.condition _)
    let u₂₁ : CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J') ⟶
        CategoryTheory.Limits.kernel (pf_h.map (n • CategoryTheory.CategoryStruct.id J)) :=
      CategoryTheory.Limits.kernel.lift (pf_h.map (n • CategoryTheory.CategoryStruct.id J)) κ₂
        (by rw [hm]; exact CategoryTheory.Limits.kernel.condition _)
    have hu₁₂_₂₁ : u₁₂ ≫ u₂₁ = CategoryTheory.CategoryStruct.id _ := by
      apply (CategoryTheory.cancel_mono κ₁).mp
      simp [u₁₂, u₂₁, κ₁, κ₂]
    refine ⟨J', hInj', pf_h.map α ≫ e_pres.hom ≫ u₁₂, u₂₁ ≫ e_pres.inv ≫ pf_h.map ρ, ?_⟩
    calc
      (pf_h.map α ≫ e_pres.hom ≫ u₁₂) ≫ (u₂₁ ≫ e_pres.inv ≫ pf_h.map ρ)
        = pf_h.map α ≫ e_pres.hom ≫ (u₁₂ ≫ u₂₁) ≫ e_pres.inv ≫ pf_h.map ρ := by
            simp only [CategoryTheory.Category.assoc]
      _ = pf_h.map α ≫ (e_pres.hom ≫ e_pres.inv) ≫ pf_h.map ρ := by
            rw [hu₁₂_₂₁, CategoryTheory.Category.id_comp]
            simp only [CategoryTheory.Category.assoc]
      _ = pf_h.map α ≫ pf_h.map ρ := by
            rw [e_pres.hom_inv_id, CategoryTheory.Category.id_comp]
      _ = pf_h.map (α ≫ ρ) := (pf_h.map_comp α ρ).symm
      _ = pf_h.map (CategoryTheory.CategoryStruct.id M) := by rw [hαρ]
      _ = CategoryTheory.CategoryStruct.id (pf_h.obj M) := pf_h.map_id M

  
  
  
  have hStep3 : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (M J : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective J]
      (α : Quiver.Hom M (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J)))
      (ρ : Quiver.Hom (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J)) M),
      CategoryTheory.CategoryStruct.comp α ρ = CategoryTheory.CategoryStruct.id M →
      ∀ (p : ℕ), 1 ≤ p →
        Subsingleton (M.H p) ∧
        (∀ {T : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S T),
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h p M)) := by
    intro S M J _ α ρ hαρ p hp
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, p = m + 1 := ⟨p - 1, by omega⟩
    let J_S := S.smallEtaleTopology
    let sh := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
    let adj_sh := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_S := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj Aℤ
    let P_free : S.Etale → CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      fun V => (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
    let Z_sh : S.Etale → CategoryTheory.Sheaf J_S AddCommGrpCat.{u} :=
      fun V => sh.obj (P_free V)

    
    have hMono_sh_of_tf : ∀ (P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}),
        (∀ (U : Opposite S.Etale) (a b : ↑(P.obj U)), n • a = n • b → a = b) →
        CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (sh.obj P)) := by
      intro P h_tf
      have : ∀ U : Opposite S.Etale,
          CategoryTheory.Mono ((n • CategoryTheory.CategoryStruct.id P).app U) := by
        intro U
        rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        rw [h_nsmul_psh P n U a, h_nsmul_psh P n U b] at hab
        exact h_tf U a b hab
      have hMono_P : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P) :=
        CategoryTheory.NatTrans.mono_of_mono_app (n • CategoryTheory.CategoryStruct.id P)
      have h_map_eq : n • CategoryTheory.CategoryStruct.id (sh.obj P) =
          sh.map (n • CategoryTheory.CategoryStruct.id P) := by
        rw [sh.map_nsmul, sh.map_id]
      rw [h_map_eq]
      exact sh.map_mono (n • CategoryTheory.CategoryStruct.id P)

    have hMono_const : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id Fℤ_S) := by
      change CategoryTheory.Mono
        (n • CategoryTheory.CategoryStruct.id
          (sh.obj ((CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℤ)))
      apply hMono_sh_of_tf
      intro U a b hab
      apply ULift.ext
      have hdown : n • a.down = n • b.down := congrArg ULift.down hab
      exact nsmul_right_injective hn_ne hdown

    have hMono_free : ∀ V : S.Etale,
        CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (Z_sh V)) := by
      intro V
      apply hMono_sh_of_tf
      intro U a b hab
      let a' : FreeAbelianGroup (U.unop ⟶ V) := a
      let b' : FreeAbelianGroup (U.unop ⟶ V) := b
      have hab' : n • a' = n • b' := hab
      let e_fs := FreeAbelianGroup.equivFinsupp (U.unop ⟶ V)
      change a' = b'
      apply e_fs.injective
      ext u
      have hu : n • (e_fs a' u) = n • (e_fs b' u) := by
        change (n • e_fs a') u = (n • e_fs b') u
        rw [← map_nsmul, ← map_nsmul, hab']
      exact nsmul_right_injective hn_ne hu

    
    let m_J : J ⟶ J := n • CategoryTheory.CategoryStruct.id J
    let H := CategoryTheory.Limits.kernel m_J
    let κ : H ⟶ J := CategoryTheory.Limits.kernel.ι m_J

    have hDiv : ∀ (K : CategoryTheory.Sheaf J_S AddCommGrpCat.{u})
        [CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id K)] (g : K ⟶ J),
        ∃ h₀ : K ⟶ J, h₀ ≫ m_J = g := by
      intro K _ g
      let h₀ : K ⟶ J :=
        CategoryTheory.Injective.factorThru g (n • CategoryTheory.CategoryStruct.id K)
      refine ⟨h₀, ?_⟩
      calc
        h₀ ≫ m_J
          = n • (h₀ ≫ CategoryTheory.CategoryStruct.id J) :=
              CategoryTheory.Preadditive.comp_nsmul h₀ (CategoryTheory.CategoryStruct.id J) n
        _ = n • (CategoryTheory.CategoryStruct.id K ≫ h₀) := by
              rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        _ = (n • CategoryTheory.CategoryStruct.id K) ≫ h₀ :=
              (CategoryTheory.Preadditive.nsmul_comp (CategoryTheory.CategoryStruct.id K) h₀ n).symm
        _ = g := CategoryTheory.Injective.comp_factorThru g (n • CategoryTheory.CategoryStruct.id K)

    have hEpi_mJ : CategoryTheory.Epi m_J := by
      have hSurj : ∀ (V : S.Etale) (s : ↑(J.obj.obj (Opposite.op V))),
          ∃ t : ↑(J.obj.obj (Opposite.op V)), (m_J.hom.app (Opposite.op V)).hom t = s := by
        intro V s
        let g'_s : P_free V ⟶ J.obj :=
          { app := fun U => AddCommGrpCat.ofHom
              (FreeAbelianGroup.lift (fun u : U.unop ⟶ V => (J.obj.map u.op).hom s))
            naturality := fun {U₁ U₂} v => by
              apply AddCommGrpCat.ext
              intro (z : FreeAbelianGroup (U₁.unop ⟶ V))
              change (FreeAbelianGroup.lift (fun u : U₂.unop ⟶ V => (J.obj.map u.op).hom s))
                  ((FreeAbelianGroup.map (fun g : U₁.unop ⟶ V => v.unop ≫ g)) z) =
                (J.obj.map v).hom
                  ((FreeAbelianGroup.lift (fun u : U₁.unop ⟶ V => (J.obj.map u.op).hom s)) z)
              induction z using FreeAbelianGroup.induction_on with
              | zero => simp
              | of u =>
                simp only [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
                  CategoryTheory.op_comp, J.obj.map_comp]
                rfl
              | neg u _ => simp
              | add z₁ z₂ ih₁ ih₂ => simp [ih₁, ih₂] }
        let g_s : Z_sh V ⟶ J := (adj_sh.homEquiv (P_free V) J).symm g'_s
        have : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (Z_sh V)) := hMono_free V
        obtain ⟨h₀, hh₀⟩ := hDiv (Z_sh V) g_s
        have h_mate : adj_sh.homEquiv (P_free V) J h₀ ≫ m_J.hom = g'_s := by
          have h1 := adj_sh.homEquiv_naturality_right h₀ m_J
          change adj_sh.homEquiv (P_free V) J (h₀ ≫ m_J) =
            adj_sh.homEquiv (P_free V) J h₀ ≫ m_J.hom at h1
          rw [hh₀, Equiv.apply_symm_apply] at h1
          exact h1.symm
        let id_gen : ↑((P_free V).obj (Opposite.op V)) :=
          FreeAbelianGroup.of (CategoryTheory.CategoryStruct.id V)
        let t : ↑(J.obj.obj (Opposite.op V)) :=
          (((adj_sh.homEquiv (P_free V) J h₀).app (Opposite.op V)).hom) id_gen
        refine ⟨t, ?_⟩
        have hev := congrArg
          (fun ψ : P_free V ⟶ J.obj => ((ψ.app (Opposite.op V)).hom) id_gen)
          h_mate
        change (m_J.hom.app (Opposite.op V)).hom t =
          (FreeAbelianGroup.lift (fun u : V ⟶ V => (J.obj.map u.op).hom s))
            (FreeAbelianGroup.of (CategoryTheory.CategoryStruct.id V)) at hev
        rw [hev, FreeAbelianGroup.lift_apply_of, CategoryTheory.op_id, J.obj.map_id]
        rfl
      refine ⟨fun {Z_sh'} f₁ f₂ hf => ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U
      ext s
      obtain ⟨t, rfl⟩ := hSurj U.unop s
      exact congrArg (fun ψ => ((ψ.hom.app U).hom) t) hf

    let SC := CategoryTheory.ShortComplex.mk κ m_J (CategoryTheory.Limits.kernel.condition m_J)
    have hSE : SC.ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_kernel m_J }

    
    have hExt_M_zero : ∀ (K : CategoryTheory.Sheaf J_S AddCommGrpCat.{u})
        [CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id K)]
        (y : CategoryTheory.Abelian.Ext K M (m + 1)), y = 0 := by
      intro K _ y
      have hExt_H_zero : ∀ x : CategoryTheory.Abelian.Ext K H (m + 1), x = 0 := by
        intro x
        have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (m + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ K hSE x hx0 rfl
        rw [← hx₃]
        cases m with
        | zero =>
          let g : K ⟶ J := CategoryTheory.Abelian.Ext.homEquiv₀ x₃
          have hg_eq : CategoryTheory.Abelian.Ext.mk₀ g = x₃ :=
            CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x₃
          obtain ⟨h₀, hh₀⟩ := hDiv K g
          rw [← hg_eq, ← hh₀, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ h₀ m_J,
            CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ h₀)
              (CategoryTheory.Abelian.Ext.mk₀ SC.g) hSE.extClass
              (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
            hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        | succ k =>
          have hx₃_0 : x₃ = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective x₃
          rw [hx₃_0]
          exact CategoryTheory.Abelian.Ext.zero_comp K (k + 1) hSE.extClass (k + 1 + 1) rfl
      calc
        y = y.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id M))
              (Nat.add_zero (m + 1)) :=
              (CategoryTheory.Abelian.Ext.comp_mk₀_id y).symm
        _ = y.comp (CategoryTheory.Abelian.Ext.mk₀ (α ≫ ρ)) (Nat.add_zero (m + 1)) := by
              rw [← hαρ]
        _ = y.comp ((CategoryTheory.Abelian.Ext.mk₀ α).comp
              (CategoryTheory.Abelian.Ext.mk₀ ρ) (Nat.add_zero 0)) (Nat.add_zero (m + 1)) := by
              rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ α ρ]
        _ = (y.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero (m + 1))).comp
              (CategoryTheory.Abelian.Ext.mk₀ ρ) (Nat.add_zero (m + 1)) :=
              (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero y
                (CategoryTheory.Abelian.Ext.mk₀ α) (CategoryTheory.Abelian.Ext.mk₀ ρ)
                (Nat.add_zero (m + 1))).symm
        _ = (0 : CategoryTheory.Abelian.Ext K H (m + 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ ρ) (Nat.add_zero (m + 1)) := by
              rw [hExt_H_zero (y.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero (m + 1)))]
        _ = 0 :=
              CategoryTheory.Abelian.Ext.zero_comp K (m + 1)
                (CategoryTheory.Abelian.Ext.mk₀ ρ) (m + 1) (Nat.add_zero (m + 1))

    refine ⟨?_, ?_⟩
    · 
      have : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id Fℤ_S) := hMono_const
      refine ⟨fun y₁ y₂ => ?_⟩
      exact (hExt_M_zero Fℤ_S y₁).trans (hExt_M_zero Fℤ_S y₂).symm
    · 
      intro T h
      have hZero_obj : ∀ U : Opposite S.Etale,
          CategoryTheory.Limits.IsZero ((M.cohomologyPresheaf (m + 1)).obj U) := by
        intro U
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        ext y
        have : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (Z_sh U.unop)) :=
          hMono_free U.unop
        exact hExt_M_zero (Z_sh U.unop) y
      have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_h : CategoryTheory.Functor T.Etale S.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      have hZero_comp : CategoryTheory.Limits.IsZero
          (CategoryTheory.Functor.comp B_h.op (M.cohomologyPresheaf (m + 1))) := by
        rw [CategoryTheory.Functor.isZero_iff]
        intro V
        exact hZero_obj (B_h.op.obj V)
      exact (CategoryTheory.presheafToSheaf T.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
        hZero_comp

  
  
  
  obtain ⟨I_0, Q_1, i_0, p_0, h0_0, ⟨hTor_I0, hTor_Q1, hSE_0⟩, hExt_I0,
    ⟨J_0, hInj_J0, α_0, ρ_0, hαρ_0⟩⟩ := hStep1 F hTor
  obtain ⟨I_1, Q_2, i_1, p_1, h0_1, ⟨hTor_I1, hTor_Q2, hSE_1⟩, hExt_I1,
    ⟨J_1, hInj_J1, α_1, ρ_1, hαρ_1⟩⟩ := hStep1 Q_1 hTor_Q1

  refine ⟨I_0, Q_1, I_1, Q_2, i_0, p_0, h0_0, i_1, p_1, h0_1,
    hTor_I0, hTor_Q1, hTor_I1, hTor_Q2, hSE_0, hSE_1, ?_, ?_, ?_⟩
  · 
    intro A B_sh ι _ hTor_B
    exact ⟨hExt_I0 ι hTor_B, hExt_I1 ι hTor_B⟩
  · 
    intro p hp
    exact ⟨(@hStep3 W I_0 J_0 hInj_J0 α_0 ρ_0 hαρ_0 p hp).1,
      (@hStep3 W I_1 J_1 hInj_J1 α_1 ρ_1 hαρ_1 p hp).1⟩
  · 
    intro Z g pf_g
    obtain ⟨J'_0, hInj'_0, α'_0, ρ'_0, hαρ'_0⟩ :=
      @hStep2 W Z g I_0 J_0 hInj_J0 α_0 ρ_0 hαρ_0
    obtain ⟨J'_1, hInj'_1, α'_1, ρ'_1, hαρ'_1⟩ :=
      @hStep2 W Z g I_1 J_1 hInj_J1 α_1 ρ_1 hαρ_1
    refine ⟨?_, ?_⟩
    · intro p hp
      exact ⟨(@hStep3 W I_0 J_0 hInj_J0 α_0 ρ_0 hαρ_0 p hp).2 g,
        (@hStep3 W I_1 J_1 hInj_J1 α_1 ρ_1 hαρ_1 p hp).2 g,
        (@hStep3 Z (pf_g.obj I_0) J'_0 hInj'_0 α'_0 ρ'_0 hαρ'_0 p hp).1,
        (@hStep3 Z (pf_g.obj I_1) J'_1 hInj'_1 α'_1 ρ'_1 hαρ'_1 p hp).1⟩
    · intro B f pf_f p hp
      obtain ⟨J''_1, hInj''_1, α''_1, ρ''_1, hαρ''_1⟩ :=
        @hStep2 Z B f (pf_g.obj I_1) J'_1 hInj'_1 α'_1 ρ'_1 hαρ'_1
      exact ⟨(@hStep3 Z (pf_g.obj I_0) J'_0 hInj'_0 α'_0 ρ'_0 hαρ'_0 p hp).2 f,
        (@hStep3 Z (pf_g.obj I_1) J'_1 hInj'_1 α'_1 ρ'_1 hαρ'_1 p hp).2 f,
        (@hStep3 B (pf_f.obj (pf_g.obj I_1)) J''_1 hInj''_1 α''_1 ρ''_1 hαρ''_1 p hp).1⟩

theorem weil_two_step_double_connecting_sheaf_hom_exact_and_natural {Y B : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y B)
    (hc_f : (weilEtaleSitePullback f).IsContinuous B.smallEtaleTopology Y.smallEtaleTopology) :
    let pf_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback f) AddCommGrpCat.{u} _
      B.smallEtaleTopology Y.smallEtaleTopology hc_f
    (∀ (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      weilTopDegKummerHigherDirectImageMap f 2 (CategoryTheory.CategoryStruct.id F) =
        CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f 2 F)) ∧
    (∀ (F M_0 Q_1 M_1 Q_2 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (i_0 : Quiver.Hom F M_0) (p_0 : Quiver.Hom M_0 Q_1)
        (h0_0 : CategoryTheory.CategoryStruct.comp i_0 p_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk i_0 p_0 h0_0).ShortExact)
        (i_1 : Quiver.Hom Q_1 M_1) (p_1 : Quiver.Hom M_1 Q_2)
        (h0_1 : CategoryTheory.CategoryStruct.comp i_1 p_1 = 0)
        (hSE_1 : (CategoryTheory.ShortComplex.mk i_1 p_1 h0_1).ShortExact),
      ∃ Δ₂ : Quiver.Hom (pf_f.obj Q_2) (weilEtaleHigherDirectImage f 2 F),
        (let Q_F : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
           CategoryTheory.Sheaf.cohomologyPresheaf F 2
         let P_F : CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u} :=
           CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_F
         let η_F := (CategoryTheory.sheafificationAdjunction B.smallEtaleTopology
           AddCommGrpCat.{u}).unit.app P_F
         ∀ (V : B.Etale) (s : ↑((pf_f.obj Q_2).obj.obj (Opposite.op V))),
           let U_V : Y.Etale := (weilEtaleSitePullback f).obj V
           let s_ext : ↑(Q_F.obj (Opposite.op U_V)) :=
             (((CategoryTheory.Abelian.Ext.mk₀
                 ((weilPolyP1CohomologyRepHomEquiv Y U_V Q_2).symm s)).comp
               hSE_1.extClass (Nat.zero_add 1)).comp
               hSE_0.extClass (Nat.one_add 1))
           (Δ₂.hom.app (Opposite.op V)) s = (η_F.app (Opposite.op V)) s_ext) ∧
        ((∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p M_0) ∧
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p M_1)) →
          ∃ h0_Δ : CategoryTheory.CategoryStruct.comp (pf_f.map p_1) Δ₂ = 0,
            CategoryTheory.Epi Δ₂ ∧
            (CategoryTheory.ShortComplex.mk (pf_f.map p_1) Δ₂ h0_Δ).Exact)) ∧
    (∀ (F M_0 Q_1 M_1 Q_2 F' M'_0 Q'_1 M'_1 Q'_2 :
          CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (i_0 : Quiver.Hom F M_0) (p_0 : Quiver.Hom M_0 Q_1)
        (h0_0 : CategoryTheory.CategoryStruct.comp i_0 p_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk i_0 p_0 h0_0).ShortExact)
        (i_1 : Quiver.Hom Q_1 M_1) (p_1 : Quiver.Hom M_1 Q_2)
        (h0_1 : CategoryTheory.CategoryStruct.comp i_1 p_1 = 0)
        (hSE_1 : (CategoryTheory.ShortComplex.mk i_1 p_1 h0_1).ShortExact)
        (i'_0 : Quiver.Hom F' M'_0) (p'_0 : Quiver.Hom M'_0 Q'_1)
        (h0'_0 : CategoryTheory.CategoryStruct.comp i'_0 p'_0 = 0)
        (hSE'_0 : (CategoryTheory.ShortComplex.mk i'_0 p'_0 h0'_0).ShortExact)
        (i'_1 : Quiver.Hom Q'_1 M'_1) (p'_1 : Quiver.Hom M'_1 Q'_2)
        (h0'_1 : CategoryTheory.CategoryStruct.comp i'_1 p'_1 = 0)
        (hSE'_1 : (CategoryTheory.ShortComplex.mk i'_1 p'_1 h0'_1).ShortExact)
        (Δ₂ : Quiver.Hom (pf_f.obj Q_2) (weilEtaleHigherDirectImage f 2 F))
        (Δ'₂ : Quiver.Hom (pf_f.obj Q'_2) (weilEtaleHigherDirectImage f 2 F'))
        (φ : Quiver.Hom F F') (μ_0 : Quiver.Hom M_0 M'_0)
        (κ_1 : Quiver.Hom Q_1 Q'_1) (μ_1 : Quiver.Hom M_1 M'_1)
        (κ_2 : Quiver.Hom Q_2 Q'_2),
      (let Q_F : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
         CategoryTheory.Sheaf.cohomologyPresheaf F 2
       let P_F : CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u} :=
         CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_F
       let η_F := (CategoryTheory.sheafificationAdjunction B.smallEtaleTopology
         AddCommGrpCat.{u}).unit.app P_F
       ∀ (V : B.Etale) (s : ↑((pf_f.obj Q_2).obj.obj (Opposite.op V))),
         let U_V : Y.Etale := (weilEtaleSitePullback f).obj V
         let s_ext : ↑(Q_F.obj (Opposite.op U_V)) :=
           (((CategoryTheory.Abelian.Ext.mk₀
               ((weilPolyP1CohomologyRepHomEquiv Y U_V Q_2).symm s)).comp
             hSE_1.extClass (Nat.zero_add 1)).comp
             hSE_0.extClass (Nat.one_add 1))
         (Δ₂.hom.app (Opposite.op V)) s = (η_F.app (Opposite.op V)) s_ext) →
      (let Q_F' : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
         CategoryTheory.Sheaf.cohomologyPresheaf F' 2
       let P_F' : CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u} :=
         CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_F'
       let η_F' := (CategoryTheory.sheafificationAdjunction B.smallEtaleTopology
         AddCommGrpCat.{u}).unit.app P_F'
       ∀ (V : B.Etale) (s' : ↑((pf_f.obj Q'_2).obj.obj (Opposite.op V))),
         let U_V : Y.Etale := (weilEtaleSitePullback f).obj V
         let s'_ext : ↑(Q_F'.obj (Opposite.op U_V)) :=
           (((CategoryTheory.Abelian.Ext.mk₀
               ((weilPolyP1CohomologyRepHomEquiv Y U_V Q'_2).symm s')).comp
             hSE'_1.extClass (Nat.zero_add 1)).comp
             hSE'_0.extClass (Nat.one_add 1))
         (Δ'₂.hom.app (Opposite.op V)) s' = (η_F'.app (Opposite.op V)) s'_ext) →
      CategoryTheory.CategoryStruct.comp φ i'_0 = CategoryTheory.CategoryStruct.comp i_0 μ_0 →
      CategoryTheory.CategoryStruct.comp μ_0 p'_0 = CategoryTheory.CategoryStruct.comp p_0 κ_1 →
      CategoryTheory.CategoryStruct.comp κ_1 i'_1 = CategoryTheory.CategoryStruct.comp i_1 μ_1 →
      CategoryTheory.CategoryStruct.comp μ_1 p'_1 = CategoryTheory.CategoryStruct.comp p_1 κ_2 →
      CategoryTheory.CategoryStruct.comp (pf_f.map κ_2) Δ'₂ =
        CategoryTheory.CategoryStruct.comp Δ₂ (weilTopDegKummerHigherDirectImageMap f 2 φ)) :=
by
  intro pf_f
  let B_f : CategoryTheory.Functor B.Etale Y.Etale := weilEtaleSitePullback f
  have : B_f.IsContinuous B.smallEtaleTopology Y.smallEtaleTopology := hc_f
  let J_Y := Y.smallEtaleTopology
  let J_B := B.smallEtaleTopology
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite B.Etale) (Opposite Y.Etale)
      AddCommGrpCat.{u}).obj B_f.op
  let Sh_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_B AddCommGrpCat.{u}) :=
    CategoryTheory.presheafToSheaf J_B AddCommGrpCat.{u}
  let U_B := CategoryTheory.sheafToPresheaf J_B AddCommGrpCat.{u}
  let adj_sh_B := CategoryTheory.sheafificationAdjunction J_B AddCommGrpCat.{u}
  let E_B := W_B.comp Sh_B
  let Φ : ℕ → CategoryTheory.Functor
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_B AddCommGrpCat.{u}) :=
    fun q => (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).comp E_B
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Sh_Y := CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
  let U_Y := CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}
  let L_tot := Free_PSh ⋙ Sh_Y
  let adj_free_Y := AddCommGrpCat.adj.whiskerRight (Opposite Y.Etale)
  let adj_sh_Y := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
  let Z_fun : Y.Etale ⥤ CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite Y.Etale → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  have hRep_symm_nat : ∀ (U : Y.Etale)
      {G G' : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (ψ : G ⟶ G') (s : ↑(G.obj.obj (Opposite.op U))),
      (weilPolyP1CohomologyRepHomEquiv Y U G').symm ((ψ.hom.app (Opposite.op U)) s) =
        (weilPolyP1CohomologyRepHomEquiv Y U G).symm s ≫ ψ := by
    intro U G G' ψ s
    have hRep_fwd : ∀ (u : weilPolyP1CohomologyRepSheaf Y U ⟶ G),
        weilPolyP1CohomologyRepHomEquiv Y U G' (u ≫ ψ) =
          (ψ.hom.app (Opposite.op U)) (weilPolyP1CohomologyRepHomEquiv Y U G u) := by
      intro u
      dsimp [weilPolyP1CohomologyRepHomEquiv]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply]
      rfl
    apply (weilPolyP1CohomologyRepHomEquiv Y U G').injective
    rw [Equiv.apply_symm_apply, hRep_fwd, Equiv.apply_symm_apply]
  let e_raw : ∀ (W : Opposite Y.Etale) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext (Z_obj W) G 0 ≃ ↑(G.obj.obj W) :=
    fun W G =>
