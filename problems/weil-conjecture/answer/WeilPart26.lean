    by_cases hex : ∃ γ₀ ∈ c.support, g ≫ γ₀ = δ
    · obtain ⟨γ₀, hγ₀_mem, rfl⟩ := hex
      let p₀ : ↥(FgtY.obj (B_ν.obj U)).left := (γ_tilde γ₀).base u₀
