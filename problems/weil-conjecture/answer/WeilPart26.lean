theorem weil_pbc_sec_abelian_five_lemma_and_nsmul_shortExact {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Abelian 𝒞] :
    (∀ {A₀ A₁ A₂ A₃ A₄ B₀ B₁ B₂ B₃ B₄ : 𝒞}
        (f₀₁ : A₀ ⟶ A₁) (f₁₂ : A₁ ⟶ A₂) (f₂₃ : A₂ ⟶ A₃) (f₃₄ : A₃ ⟶ A₄)
