          · change (ℓ₁₂ ≫ m_map σ) ≫ π₂ = W.ι ≫ π₂
            dsimp [ℓ₁₂, m_map, CategoryTheory.Limits.pullback.map, π₂]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
