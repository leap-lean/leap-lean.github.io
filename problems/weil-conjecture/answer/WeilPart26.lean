            τ_N ((Υ F N w).comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero N))) ∧
        CategoryTheory.Mono t_S ∧
        @Nat.casesOn (fun k => Quiver.Hom oneR (𝒥 k) → Prop) N
