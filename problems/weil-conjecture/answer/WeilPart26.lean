      (CategoryTheory.ShortComplex.mk f₁₂ f₂₃ hf₁).Exact →
      (CategoryTheory.ShortComplex.mk f₂₃ f₃₄ hf₂).Exact →
      (CategoryTheory.ShortComplex.mk g₀₁ g₁₂ hg₀).Exact →
      (CategoryTheory.ShortComplex.mk g₁₂ g₂₃ hg₁).Exact →
      (CategoryTheory.ShortComplex.mk g₂₃ g₃₄ hg₂).Exact →
      ∀ (φ₀ : A₀ ⟶ B₀) (φ₁ : A₁ ⟶ B₁) (φ₂ : A₂ ⟶ B₂) (φ₃ : A₃ ⟶ B₃) (φ₄ : A₄ ⟶ B₄),
