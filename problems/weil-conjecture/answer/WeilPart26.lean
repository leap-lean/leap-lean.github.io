      let u_W : P_R ⟶ W_open.toScheme := ι_R ≫ (fst_Q ≫ (fst_Z ≫ e_W.hom))
      have hu_fac : u_W ≫ σ_ν_sch = ι_R ≫ p_Q_to_Bν := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc u_W σ_ν_sch _).trans
            ((congrArg (u_W ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Category.assoc ι_R _ e_W.inv).trans
                ((congrArg (ι_R ≫ ·) (CategoryTheory.Category.assoc fst_Q _ e_W.inv)).trans
                  ((congrArg (fun k_hom => ι_R ≫ (fst_Q ≫ k_hom))
                    ((CategoryTheory.Category.assoc fst_Z e_W.hom e_W.inv).trans
                      ((congrArg (fst_Z ≫ ·) e_W.hom_inv_id).trans
                        (CategoryTheory.Category.comp_id _)))).trans
                    ((congrArg (ι_R ≫ ·) hp_Q_fst.symm).trans
                      (CategoryTheory.Category.assoc ι_R p_Q_to_Bν _).symm)))))
        · exact (CategoryTheory.Category.assoc u_W σ_ν_sch _).trans
            ((congrArg (u_W ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              ((CategoryTheory.Category.assoc ι_R _ W_open.ι).trans
                ((congrArg (ι_R ≫ ·) (CategoryTheory.Category.assoc fst_Q _ W_open.ι)).trans
                  ((congrArg (fun k_hom => ι_R ≫ (fst_Q ≫ k_hom))
                    (CategoryTheory.Category.assoc fst_Z e_W.hom W_open.ι)).trans
                    ((congrArg (fun k_hom => ι_R ≫ (fst_Q ≫ k_hom)) hCompat.symm).trans
                      ((congrArg (ι_R ≫ ·)
                        (CategoryTheory.Category.assoc fst_Q _ ι_Y).symm).trans
                        ((congrArg (fun k_hom => ι_R ≫ (k_hom ≫ ι_Y))
                          (CategoryTheory.Category.assoc fst_Q
                            (Fgt_Z'.map τ_Z).left (e_W'.hom ≫ W'_open.ι)).symm).trans
                          ((CategoryTheory.Category.assoc ι_R _ ι_Y).symm.trans
                            ((congrArg (· ≫ ι_Y)
                              (CategoryTheory.Category.assoc ι_R
                                (fst_Q ≫ (Fgt_Z'.map τ_Z).left)
                                (e_W'.hom ≫ W'_open.ι)).symm).trans
                              ((congrArg (fun k_hom =>
                                  (k_hom ≫ (e_W'.hom ≫ W'_open.ι)) ≫ ι_Y) hR1.symm).trans
                                ((congrArg (· ≫ ι_Y)
                                  ((CategoryTheory.Category.assoc π_W' e_W'.inv
                                    (e_W'.hom ≫ W'_open.ι)).trans
                                    (congrArg (π_W' ≫ ·)
                                      ((CategoryTheory.Category.assoc
                                        e_W'.inv e_W'.hom W'_open.ι).symm.trans
                                        ((congrArg (· ≫ W'_open.ι) e_W'.inv_hom_id).trans
                                          (CategoryTheory.Category.id_comp
                                            W'_open.ι)))))).trans
                                  ((congrArg (· ≫ ι_Y) hR2).trans
                                    ((CategoryTheory.Category.assoc ι_R snd_Q ι_Y).trans
                                      ((congrArg (ι_R ≫ ·) hp_Q_snd.symm).trans
                                        (CategoryTheory.Category.assoc ι_R
                                          p_Q_to_Bν _).symm))))))))))))))
      refine ⟨u_W.base z_R, ?_⟩
      exact (congrArg (fun k_hom : P_R ⟶ P_Bν => k_hom.base z_R) hu_fac).trans
        (congrArg p_Q_to_Bν.base hz_R)

  let x_ext : CategoryTheory.Abelian.Ext Fℤ_Z L_Z q := x
  have h_ext_eq := hExtNatIso P_pull_Z P_pull_ν' P_pull_ν P_pull_Y Φ_pb
    (A₁ := Fℤ_Z) (B₁ := L_Z) (A₂ := Fℤ_Z') (B₂ := L_Z')
    (A₃ := Fℤ_Y) (B₃ := L_Y) (A₄ := Fℤ_Y') (B₄ := L_Y')
    ιℤ_Z π_loc_Z ιℤ_ν' ψ_tilde_ν' ιℤ_ν ψ_tilde_ν ιℤ_Y π_loc_Y
    h_src h_tgt q x_ext
  exact (htrf_ν'_eq q (p_Z x)).trans
    ((congrArg (fun z => (CategoryTheory.Abelian.Ext.mk₀ ψ_tilde_ν').postcomp Fℤ_Y'
        (Nat.add_zero q) ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_ν').comp
          ((P_pull_ν'.mapExtAddHom Fℤ_Z' L_Z' q) z) (Nat.zero_add q)))
      (hp_Z_eq x)).trans
      (h_ext_eq.trans
        ((congrArg (fun z => (CategoryTheory.Abelian.Ext.mk₀ π_loc_Y).postcomp Fℤ_Y'
            (Nat.add_zero q) ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y).comp
              ((P_pull_Y.mapExtAddHom Fℤ_Y L_Y q) z) (Nat.zero_add q)))
          (htrf_ν_eq q x).symm).trans
          (hp_Y_eq (Classical.choose (hTrfDataEx Y₀ Z₀ ν W_open W_diag e_W he_W) q x)).symm)))

theorem weil_etale_algClosed_spec_stalk_and_nonsep_fiber_clopen_cover (k : Type u) [Field k] [IsAlgClosed k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
    (∀ (S : CategoryTheory.Sieve T_k),
      S ∈ S_k.smallEtaleTopology T_k →
      S.arrows (CategoryTheory.CategoryStruct.id T_k)) ∧
    ((∀ (m : ℕ),
        Function.Bijective
          ((CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id
              (weilEtaleLocalTorsionSheaf S_k m T_k))).hom)) ∧
      (∀ (Y₀ : AlgebraicGeometry.Scheme.{u})
          (f_k : Quiver.Hom Y₀ S_k)
          (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})
          (q : ℕ),
        Nonempty (↥((weilEtaleHigherDirectImage f_k q F₀).obj.obj (Opposite.op T_k)) ≃+ F₀.H q) ∧
        (Subsingleton (F₀.H q) →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f_k q F₀)))) ∧
    (∀ (V_bar : CategoryTheory.Over S_k)
        [AlgebraicGeometry.LocallyOfFiniteType V_bar.hom]
        (V : V_bar.left.Etale)
        [AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget V_bar.left).obj V).left]
        (s_b : Quiver.Hom S_k V_bar.left),
      CategoryTheory.CategoryStruct.comp s_b V_bar.hom =
        CategoryTheory.CategoryStruct.id S_k →
      let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget V_bar.left
      let Fgt_k := AlgebraicGeometry.Scheme.Etale.forget S_k
      let B_b := weilEtaleSitePullback s_b
      ∃ (r : ℕ)
        (κ_V : Fin r → Quiver.Hom T_k (B_b.obj V))
        (s_z : Fin r → Quiver.Hom S_k (Fgt_V.obj V).left)
        (hs_z_eq : ∀ i : Fin r,
          CategoryTheory.CategoryStruct.comp (s_z i) (Fgt_V.obj V).hom = s_b),
        (∀ i : Fin r, AlgebraicGeometry.IsOpenImmersion ((Fgt_k.map (κ_V i)).left)) ∧
        (_root_.Pairwise fun i j : Fin r =>
          Disjoint
            (Set.range ((Fgt_k.map (κ_V i)).left).base)
            (Set.range ((Fgt_k.map (κ_V j)).left).base)) ∧
        ((⋃ i : Fin r, Set.range ((Fgt_k.map (κ_V i)).left).base) = Set.univ) ∧
        (∀ i : Fin r,
          CategoryTheory.CategoryStruct.comp
            ((Fgt_k.map (κ_V i)).left)
            (CategoryTheory.Limits.pullback.fst (Fgt_V.obj V).hom s_b) = s_z i) ∧
        (∀ (Y_bar : CategoryTheory.Over S_k)
            (π_bar : Quiver.Hom Y_bar V_bar)
            (W : Y_bar.left.Etale)
            (f_W : Quiver.Hom
              ((AlgebraicGeometry.Scheme.Etale.forget Y_bar.left).obj W).left
              (Fgt_V.obj V).left)
            (hComm_W : CategoryTheory.CategoryStruct.comp f_W (Fgt_V.obj V).hom =
              CategoryTheory.CategoryStruct.comp
                ((AlgebraicGeometry.Scheme.Etale.forget Y_bar.left).obj W).hom π_bar.left),
          let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y_bar.left
          let Y_V := ((weilEtaleSitePullback π_bar.left).obj V).left
          let j_diag : Quiver.Hom (Fgt_Y.obj W).left Y_V :=
            CategoryTheory.Limits.pullback.lift f_W (Fgt_Y.obj W).hom hComm_W
          let W_diag : Y_V.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ j_diag
              (CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
                j_diag ((weilEtaleSitePullback π_bar.left).obj V).hom
                ((weilEtaleSitePullback π_bar.left).obj V).prop
                (Eq.mp
                  (congrArg AlgebraicGeometry.Etale
                    (CategoryTheory.Limits.pullback.lift_snd f_W (Fgt_Y.obj W).hom hComm_W).symm)
                  W.prop))
          let Y_b := CategoryTheory.Limits.pullback π_bar.left s_b
          let snd_b := CategoryTheory.Limits.pullback.snd π_bar.left s_b
          let fst_b := CategoryTheory.Limits.pullback.fst π_bar.left s_b
          let ι_z_i : Fin r → Quiver.Hom Y_b Y_V := fun i =>
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.CategoryStruct.comp snd_b (s_z i))
              fst_b
              ((CategoryTheory.Category.assoc snd_b (s_z i) (Fgt_V.obj V).hom).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp snd_b) (hs_z_eq i)).trans
                  (CategoryTheory.Limits.pullback.condition (f := π_bar.left) (g := s_b)).symm))
          ∃ (κ_W : ∀ i : Fin r,
              Quiver.Hom
                ((weilEtaleSitePullback (ι_z_i i)).obj W_diag)
                ((weilEtaleSitePullback fst_b).obj W)),
            (∀ i : Fin r,
              CategoryTheory.CategoryStruct.comp
                (((AlgebraicGeometry.Scheme.Etale.forget Y_b).map (κ_W i)).left)
                (CategoryTheory.Limits.pullback.fst (Fgt_Y.obj W).hom fst_b) =
              CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget Y_V).obj W_diag).hom (ι_z_i i)) ∧
            (∀ i : Fin r,
              AlgebraicGeometry.IsOpenImmersion
                (((AlgebraicGeometry.Scheme.Etale.forget Y_b).map (κ_W i)).left)) ∧
            (_root_.Pairwise fun i j : Fin r =>
              Disjoint
                (Set.range (((AlgebraicGeometry.Scheme.Etale.forget Y_b).map (κ_W i)).left).base)
                (Set.range (((AlgebraicGeometry.Scheme.Etale.forget Y_b).map (κ_W j)).left).base)) ∧
            ((⋃ i : Fin r,
              Set.range (((AlgebraicGeometry.Scheme.Etale.forget Y_b).map (κ_W i)).left).base) =
                Set.univ))) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
  let hT_k : CategoryTheory.Limits.IsTerminal T_k := weilEtaleIdTerminalIsTerminal.{u} S_k
  let Fgt_k := AlgebraicGeometry.Scheme.Etale.forget S_k
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl

  
  have hPtSec :
      ∀ (U_k : S_k.Etale) (y : ↥(Fgt_k.obj U_k).left),
        ∃ γ : Quiver.Hom T_k U_k,
          AlgebraicGeometry.IsOpenImmersion ((Fgt_k.map γ).left) ∧
          Set.range (((Fgt_k.map γ).left).base) = {y} := by
    intro U_k y
    let U_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_k.obj U_k).left
    let p_U : U_sch ⟶ S_k := (Fgt_k.obj U_k).hom
    have : AlgebraicGeometry.Etale p_U := U_k.prop
    obtain ⟨O_y, hAff, hy, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    let R_cat := U_sch.presheaf.obj (Opposite.op O_y)
    let ι_aff : AlgebraicGeometry.Spec R_cat ⟶ U_sch := hAff.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion ι_aff := inferInstance
    have : AlgebraicGeometry.Etale ι_aff := inferInstance
    have hy_range : y ∈ Set.range ι_aff.base := by
      change y ∈ Set.range hAff.fromSpec.base
      rw [hAff.range_fromSpec]
      exact hy
    obtain ⟨z₀, hz₀⟩ := hy_range
    let z₀_spec : PrimeSpectrum ↑R_cat := z₀
    obtain ⟨m₀, hm₀_max, hm₀_le⟩ :=
      Ideal.exists_le_maximal z₀_spec.asIdeal z₀_spec.isPrime.ne_top
    let z₁_spec : PrimeSpectrum ↑R_cat := ⟨m₀, hm₀_max.isPrime⟩
    let z₁ : ↥(AlgebraicGeometry.Spec R_cat) := z₁_spec
    have hz₁_cl : z₁ ∈ closure ({z₀} : Set ↥(AlgebraicGeometry.Spec R_cat)) :=
      (PrimeSpectrum.le_iff_mem_closure z₀_spec z₁_spec).mp hm₀_le
    let q_aff : AlgebraicGeometry.Spec R_cat ⟶ S_k := ι_aff ≫ p_U
    have : AlgebraicGeometry.Etale q_aff := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType q_aff := inferInstance
    let φ_k : CommRingCat.of k ⟶ R_cat := AlgebraicGeometry.Spec.preimage q_aff
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = q_aff :=
      AlgebraicGeometry.Spec.map_preimage q_aff
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    letI : Algebra k ↑R_cat := φ_k.hom.toAlgebra
    have hFT_alg : Algebra.FiniteType k ↑R_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑R_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom m₀
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ m₀
        rw [hf_p]
        exact m₀.zero_mem
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
      exact hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_R : ↑R_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_R = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_R (algebraMap k (↑R_cat) c) = c
      have hq_C : q_hom (MvPolynomial.C c) = algebraMap k (↑R_cat) c := q_mv.commutes c
      rw [← hq_C]
      dsimp [σ_R]
      have heq_q : e_quot.symm (q_hom (MvPolynomial.C c)) =
          Ideal.Quotient.mk (RingHom.ker q_hom) (MvPolynomial.C c) := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
      exact (MvPolynomial.aeval a_pt).commutes c
    let σ : S_k ⟶ AlgebraicGeometry.Spec R_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_R)
    have hσ_sec : σ ≫ q_aff = 𝟙 S_k := by
      dsimp [σ]
      rw [← hmap_φ, ← AlgebraicGeometry.Spec.map_comp, hσ_comp,
        AlgebraicGeometry.Spec.map_id]
    have hσ_pt : σ.base pt_k = z₁ := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_R (pt_k : PrimeSpectrum k).asIdeal = m₀
      rw [hpt_bot]
      ext r
      obtain ⟨f_p, rfl⟩ := hq_hom_surj r
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      change σ_R (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ m₀
      rw [Ideal.mem_bot]
      dsimp [σ_R]
      rw [heq_q, Ideal.Quotient.lift_mk]
      change ev_hom f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    have hEt_σ_comp : AlgebraicGeometry.Etale (σ ≫ q_aff) := by
      rw [hσ_sec]
      infer_instance
    have : AlgebraicGeometry.Etale σ :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        σ q_aff (inferInstance : AlgebraicGeometry.Etale q_aff) hEt_σ_comp
    have : AlgebraicGeometry.IsClosedImmersion (σ ≫ q_aff) := by
      rw [hσ_sec]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion σ :=
      AlgebraicGeometry.IsClosedImmersion.of_comp σ q_aff
    have : AlgebraicGeometry.IsOpenImmersion σ :=
      AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono σ
    have hOpen_range_σ : IsOpen (Set.range σ.base) := σ.isOpenEmbedding.isOpen_range
    have hz₁_in_range : z₁ ∈ Set.range σ.base := ⟨pt_k, hσ_pt⟩
    obtain ⟨w_pt, ⟨pt', hpt'⟩, hw_sing⟩ :=
      mem_closure_iff.mp hz₁_cl (Set.range σ.base) hOpen_range_σ hz₁_in_range
    rw [Set.mem_singleton_iff] at hw_sing
    rw [hSub_k.elim pt' pt_k, hσ_pt] at hpt'
    have hz₁_eq_z₀ : z₁ = z₀ := hpt'.trans hw_sing
    let τ : S_k ⟶ U_sch := σ ≫ ι_aff
    have hOpen_τ : AlgebraicGeometry.IsOpenImmersion τ := inferInstance
    have hτ_hom : τ ≫ p_U = (Fgt_k.obj T_k).hom := by
      change (σ ≫ ι_aff) ≫ p_U = 𝟙 S_k
      rw [CategoryTheory.Category.assoc]
      exact hσ_sec
    let γ : Quiver.Hom T_k U_k :=
      CategoryTheory.MorphismProperty.Over.homMk τ hτ_hom trivial
    refine ⟨γ, hOpen_τ, ?_⟩
    ext w
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨q, rfl⟩
      rw [hSub_k.elim q pt_k]
      change ι_aff.base (σ.base pt_k) = y
      rw [hσ_pt, hz₁_eq_z₀, hz₀]
    · rintro rfl
      refine ⟨pt_k, ?_⟩
      change ι_aff.base (σ.base pt_k) = w
      rw [hσ_pt, hz₁_eq_z₀, hz₀]

  
  let EtProp : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hSieve_k :
      ∀ (S : CategoryTheory.Sieve T_k),
        S ∈ S_k.smallEtaleTopology T_k →
        S.arrows (CategoryTheory.CategoryStruct.id T_k) := by
    letI : CategoryTheory.Category (CategoryTheory.MorphismProperty.Over EtProp ⊤ S_k) :=
      (inferInstance : CategoryTheory.Category S_k.Etale)
    letI : CategoryTheory.Limits.HasPullbacks
        (CategoryTheory.MorphismProperty.Over EtProp ⊤ S_k) :=
      (inferInstance : CategoryTheory.Limits.HasPullbacks S_k.Etale)
    have : EtProp.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    intro S hS
    have hEqTop :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S_k (le_refl EtProp)
    have hS' : S ∈ (AlgebraicGeometry.Scheme.smallPretopology EtProp EtProp).toGrothendieck T_k :=
      Eq.mp (congrArg (fun J => S ∈ J T_k) hEqTop) hS
    obtain ⟨R, hR_cov, hR_le⟩ :=
      (CategoryTheory.Pretopology.mem_toGrothendieck _ T_k S).mp hS'
    have hR_map : CategoryTheory.Presieve.map (CategoryTheory.Over.forget S_k)
        (CategoryTheory.Presieve.map Fgt_k R) ∈
        (AlgebraicGeometry.Scheme.precoverage EtProp).coverings S_k := hR_cov
    have hUnpack0 : ∀ {X_set : Type u}
        {g_set : X_set ⟶ AlgebraicGeometry.Scheme.forget.obj S_k},
        CategoryTheory.Presieve.map AlgebraicGeometry.Scheme.forget
          (CategoryTheory.Presieve.map (CategoryTheory.Over.forget S_k)
            (CategoryTheory.Presieve.map Fgt_k R)) g_set →
        Nonempty X_set →
        ∃ (Z : AlgebraicGeometry.Scheme.{u}) (g_Z : Z ⟶ S_k),
          CategoryTheory.Presieve.map (CategoryTheory.Over.forget S_k)
            (CategoryTheory.Presieve.map Fgt_k R) g_Z ∧ Nonempty ↥Z := by
      rintro _ _ ⟨hz⟩ hne
      exact ⟨_, _, hz, hne⟩
    have hUnpack1 : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {g_Z : Z ⟶ S_k},
        CategoryTheory.Presieve.map (CategoryTheory.Over.forget S_k)
          (CategoryTheory.Presieve.map Fgt_k R) g_Z →
        Nonempty ↥Z →
        ∃ (W_ov : CategoryTheory.Over S_k) (w_ov : W_ov ⟶ Fgt_k.obj T_k),
          CategoryTheory.Presieve.map Fgt_k R w_ov ∧ Nonempty ↥W_ov.left := by
      rintro _ _ ⟨hw⟩ hne
      exact ⟨_, _, hw, hne⟩
    have hUnpack2 : ∀ {W_ov : CategoryTheory.Over S_k} {w_ov : W_ov ⟶ Fgt_k.obj T_k},
        CategoryTheory.Presieve.map Fgt_k R w_ov →
        Nonempty ↥W_ov.left →
        ∃ (V_j : S_k.Etale) (v_j : V_j ⟶ T_k),
          R v_j ∧ Nonempty ↥(Fgt_k.obj V_j).left := by
      rintro _ _ ⟨hv⟩ hne
      exact ⟨_, _, hv, hne⟩
    obtain ⟨_, _, hg_set, y_set, _⟩ := hR_map.1 pt_k
