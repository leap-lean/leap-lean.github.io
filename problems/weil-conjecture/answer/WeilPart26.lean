  let Fgt_Z := AlgebraicGeometry.Scheme.Etale.forget Z₀.left
  let Fgt_Z' := AlgebraicGeometry.Scheme.Etale.forget Z'₀.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y₀.left
  let Fgt_Y' := AlgebraicGeometry.Scheme.Etale.forget Y'₀.left

  let hom_sch : ∀ U : Z₀.left.Etale,
      (Fgt_Y'.obj (B_Y.obj (B_ν.obj U))).left ⟶
        (Fgt_Y'.obj (B_ν'.obj (B_Z.obj U))).left := fun U =>
    let u_hom := (Fgt_Z.obj U).hom
    let bν_hom := (Fgt_Y.obj (B_ν.obj U)).hom
    let bZ_hom := (Fgt_Z'.obj (B_Z.obj U)).hom
    let fst₁ := CategoryTheory.Limits.pullback.fst bν_hom ι_Y
    let snd₁ := CategoryTheory.Limits.pullback.snd bν_hom ι_Y
    let fst_ν := CategoryTheory.Limits.pullback.fst u_hom ν.left
    have h_inner : (fst₁ ≫ fst_ν) ≫ u_hom = (snd₁ ≫ ν'.left) ≫ ι_Z :=
      (CategoryTheory.Category.assoc fst₁ fst_ν u_hom).trans
        ((congrArg (fst₁ ≫ ·)
          (CategoryTheory.Limits.pullback.condition (f := u_hom) (g := ν.left))).trans
          ((CategoryTheory.Category.assoc fst₁ bν_hom ν.left).symm.trans
            ((congrArg (· ≫ ν.left)
              (CategoryTheory.Limits.pullback.condition (f := bν_hom) (g := ι_Y))).trans
              ((CategoryTheory.Category.assoc snd₁ ι_Y ν.left).trans
                ((congrArg (snd₁ ≫ ·) _hpb.w).trans
                  (CategoryTheory.Category.assoc snd₁ ν'.left ι_Z).symm)))))
    let m_BZ : (Fgt_Y'.obj (B_Y.obj (B_ν.obj U))).left ⟶ (Fgt_Z'.obj (B_Z.obj U)).left :=
      CategoryTheory.Limits.pullback.lift (fst₁ ≫ fst_ν) (snd₁ ≫ ν'.left) h_inner
    have h_outer : m_BZ ≫ bZ_hom = snd₁ ≫ ν'.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    CategoryTheory.Limits.pullback.lift m_BZ snd₁ h_outer

  let inv_sch : ∀ U : Z₀.left.Etale,
      (Fgt_Y'.obj (B_ν'.obj (B_Z.obj U))).left ⟶
        (Fgt_Y'.obj (B_Y.obj (B_ν.obj U))).left := fun U =>
    let u_hom := (Fgt_Z.obj U).hom
    let bν_hom := (Fgt_Y.obj (B_ν.obj U)).hom
    let bZ_hom := (Fgt_Z'.obj (B_Z.obj U)).hom
    let fst₂ := CategoryTheory.Limits.pullback.fst bZ_hom ν'.left
    let snd₂ := CategoryTheory.Limits.pullback.snd bZ_hom ν'.left
    let fst_Z := CategoryTheory.Limits.pullback.fst u_hom ι_Z
    have h_inner : (fst₂ ≫ fst_Z) ≫ u_hom = (snd₂ ≫ ι_Y) ≫ ν.left :=
      (CategoryTheory.Category.assoc fst₂ fst_Z u_hom).trans
        ((congrArg (fst₂ ≫ ·)
          (CategoryTheory.Limits.pullback.condition (f := u_hom) (g := ι_Z))).trans
          ((CategoryTheory.Category.assoc fst₂ bZ_hom ι_Z).symm.trans
            ((congrArg (· ≫ ι_Z)
              (CategoryTheory.Limits.pullback.condition (f := bZ_hom) (g := ν'.left))).trans
              ((CategoryTheory.Category.assoc snd₂ ν'.left ι_Z).trans
                ((congrArg (snd₂ ≫ ·) _hpb.w.symm).trans
                  (CategoryTheory.Category.assoc snd₂ ι_Y ν.left).symm)))))
    let m_Bν : (Fgt_Y'.obj (B_ν'.obj (B_Z.obj U))).left ⟶ (Fgt_Y.obj (B_ν.obj U)).left :=
      CategoryTheory.Limits.pullback.lift (fst₂ ≫ fst_Z) (snd₂ ≫ ι_Y) h_inner
    have h_outer : m_Bν ≫ bν_hom = snd₂ ≫ ι_Y :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    CategoryTheory.Limits.pullback.lift m_Bν snd₂ h_outer

  have h_hom_fst_fst : ∀ U : Z₀.left.Etale,
      (hom_sch U ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U)).hom ν'.left) ≫
        CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ι_Z =
      CategoryTheory.Limits.pullback.fst (Fgt_Y.obj (B_ν.obj U)).hom ι_Y ≫
        CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ν.left := fun U =>
    (congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
  have h_hom_fst_snd : ∀ U : Z₀.left.Etale,
      (hom_sch U ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U)).hom ν'.left) ≫
        CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U).hom ι_Z =
      CategoryTheory.Limits.pullback.snd (Fgt_Y.obj (B_ν.obj U)).hom ι_Y ≫ ν'.left := fun U =>
    (congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have h_hom_snd : ∀ U : Z₀.left.Etale,
      hom_sch U ≫ CategoryTheory.Limits.pullback.snd (Fgt_Z'.obj (B_Z.obj U)).hom ν'.left =
      CategoryTheory.Limits.pullback.snd (Fgt_Y.obj (B_ν.obj U)).hom ι_Y := fun _ =>
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  have h_inv_fst_fst : ∀ U : Z₀.left.Etale,
      (inv_sch U ≫ CategoryTheory.Limits.pullback.fst (Fgt_Y.obj (B_ν.obj U)).hom ι_Y) ≫
        CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ν.left =
      CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U)).hom ν'.left ≫
        CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ι_Z := fun U =>
    (congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
  have h_inv_fst_snd : ∀ U : Z₀.left.Etale,
      (inv_sch U ≫ CategoryTheory.Limits.pullback.fst (Fgt_Y.obj (B_ν.obj U)).hom ι_Y) ≫
        CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U).hom ν.left =
      CategoryTheory.Limits.pullback.snd (Fgt_Z'.obj (B_Z.obj U)).hom ν'.left ≫ ι_Y := fun U =>
    (congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have h_inv_snd : ∀ U : Z₀.left.Etale,
      inv_sch U ≫ CategoryTheory.Limits.pullback.snd (Fgt_Y.obj (B_ν.obj U)).hom ι_Y =
      CategoryTheory.Limits.pullback.snd (Fgt_Z'.obj (B_Z.obj U)).hom ν'.left := fun _ =>
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  have h_hom_inv : ∀ U : Z₀.left.Etale, hom_sch U ≫ inv_sch U = 𝟙 _ := by
    intro U
    apply CategoryTheory.Limits.pullback.hom_ext
    · apply CategoryTheory.Limits.pullback.hom_ext
      · exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ν.left)
          (CategoryTheory.Category.assoc (hom_sch U) (inv_sch U) _)).trans
          ((CategoryTheory.Category.assoc (hom_sch U) _ _).trans
            ((congrArg (hom_sch U ≫ ·) (h_inv_fst_fst U)).trans
              ((CategoryTheory.Category.assoc (hom_sch U) _ _).symm.trans
                ((h_hom_fst_fst U).trans
                  (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ν.left)
                    (CategoryTheory.Category.id_comp _).symm)))))
      · exact (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U).hom ν.left)
          (CategoryTheory.Category.assoc (hom_sch U) (inv_sch U) _)).trans
          ((CategoryTheory.Category.assoc (hom_sch U) _ _).trans
            ((congrArg (hom_sch U ≫ ·) (h_inv_fst_snd U)).trans
              ((CategoryTheory.Category.assoc (hom_sch U) _ _).symm.trans
                ((congrArg (· ≫ ι_Y) (h_hom_snd U)).trans
                  ((CategoryTheory.Limits.pullback.condition
                    (f := (Fgt_Y.obj (B_ν.obj U)).hom) (g := ι_Y)).symm.trans
                    (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U).hom ν.left)
                      (CategoryTheory.Category.id_comp _).symm))))))
    · exact (CategoryTheory.Category.assoc (hom_sch U) (inv_sch U) _).trans
        ((congrArg (hom_sch U ≫ ·) (h_inv_snd U)).trans
          ((h_hom_snd U).trans (CategoryTheory.Category.id_comp _).symm))

  have h_inv_hom : ∀ U : Z₀.left.Etale, inv_sch U ≫ hom_sch U = 𝟙 _ := by
    intro U
    apply CategoryTheory.Limits.pullback.hom_ext
    · apply CategoryTheory.Limits.pullback.hom_ext
      · exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ι_Z)
          (CategoryTheory.Category.assoc (inv_sch U) (hom_sch U) _)).trans
          ((CategoryTheory.Category.assoc (inv_sch U) _ _).trans
            ((congrArg (inv_sch U ≫ ·) (h_hom_fst_fst U)).trans
              ((CategoryTheory.Category.assoc (inv_sch U) _ _).symm.trans
                ((h_inv_fst_fst U).trans
                  (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U).hom ι_Z)
                    (CategoryTheory.Category.id_comp _).symm)))))
      · exact (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U).hom ι_Z)
          (CategoryTheory.Category.assoc (inv_sch U) (hom_sch U) _)).trans
          ((CategoryTheory.Category.assoc (inv_sch U) _ _).trans
            ((congrArg (inv_sch U ≫ ·) (h_hom_fst_snd U)).trans
              ((CategoryTheory.Category.assoc (inv_sch U) _ _).symm.trans
                ((congrArg (· ≫ ν'.left) (h_inv_snd U)).trans
                  ((CategoryTheory.Limits.pullback.condition
                    (f := (Fgt_Z'.obj (B_Z.obj U)).hom) (g := ν'.left)).symm.trans
                    (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U).hom ι_Z)
                      (CategoryTheory.Category.id_comp _).symm))))))
    · exact (CategoryTheory.Category.assoc (inv_sch U) (hom_sch U) _).trans
        ((congrArg (inv_sch U ≫ ·) (h_hom_snd U)).trans
          ((h_inv_snd U).trans (CategoryTheory.Category.id_comp _).symm))

  let e_site : (B_ν ⋙ B_Y) ≅ (B_Z ⋙ B_ν') :=
    CategoryTheory.NatIso.ofComponents
      (fun U =>
        { hom := CategoryTheory.MorphismProperty.Over.homMk
            (hom_sch U) (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
          inv := CategoryTheory.MorphismProperty.Over.homMk
            (inv_sch U) (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext (h_hom_inv U)
          inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext (h_inv_hom U) })
      (by
        intro U₁ U₂ f
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        let m_L := (Fgt_Y'.map (B_Y.map (B_ν.map f))).left
        let m_R := (Fgt_Y'.map (B_ν'.map (B_Z.map f))).left
        change m_L ≫ hom_sch U₂ = hom_sch U₁ ≫ m_R
        have hbY_fst : m_L ≫
            CategoryTheory.Limits.pullback.fst (Fgt_Y.obj (B_ν.obj U₂)).hom ι_Y =
            CategoryTheory.Limits.pullback.fst (Fgt_Y.obj (B_ν.obj U₁)).hom ι_Y ≫
              (Fgt_Y.map (B_ν.map f)).left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hbY_snd : m_L ≫
            CategoryTheory.Limits.pullback.snd (Fgt_Y.obj (B_ν.obj U₂)).hom ι_Y =
            CategoryTheory.Limits.pullback.snd (Fgt_Y.obj (B_ν.obj U₁)).hom ι_Y :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hbν_fst : (Fgt_Y.map (B_ν.map f)).left ≫
            CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₂).hom ν.left =
            CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₁).hom ν.left ≫
              (Fgt_Z.map f).left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hbν'_fst : m_R ≫
            CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U₂)).hom ν'.left =
            CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U₁)).hom ν'.left ≫
              (Fgt_Z'.map (B_Z.map f)).left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hbν'_snd : m_R ≫
            CategoryTheory.Limits.pullback.snd (Fgt_Z'.obj (B_Z.obj U₂)).hom ν'.left =
            CategoryTheory.Limits.pullback.snd (Fgt_Z'.obj (B_Z.obj U₁)).hom ν'.left :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hbZ_fst : (Fgt_Z'.map (B_Z.map f)).left ≫
            CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₂).hom ι_Z =
            CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₁).hom ι_Z ≫
              (Fgt_Z.map f).left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hbZ_snd : (Fgt_Z'.map (B_Z.map f)).left ≫
            CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U₂).hom ι_Z =
            CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U₁).hom ι_Z :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        apply CategoryTheory.Limits.pullback.hom_ext
        · apply CategoryTheory.Limits.pullback.hom_ext
          · have hLHS : ((m_L ≫ hom_sch U₂) ≫
                CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U₂)).hom ν'.left) ≫
                CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₂).hom ι_Z =
                (CategoryTheory.Limits.pullback.fst (Fgt_Y.obj (B_ν.obj U₁)).hom ι_Y ≫
                  CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₁).hom ν.left) ≫
                  (Fgt_Z.map f).left :=
              (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₂).hom ι_Z)
                (CategoryTheory.Category.assoc m_L (hom_sch U₂) _)).trans
                ((CategoryTheory.Category.assoc m_L _ _).trans
                  ((congrArg (m_L ≫ ·) (h_hom_fst_fst U₂)).trans
                    ((CategoryTheory.Category.assoc m_L _ _).symm.trans
                      ((congrArg (· ≫ _) hbY_fst).trans
                        ((CategoryTheory.Category.assoc _ _ _).trans
                          ((congrArg (_ ≫ ·) hbν_fst).trans
                            (CategoryTheory.Category.assoc _ _ _).symm))))))
            have hRHS : ((hom_sch U₁ ≫ m_R) ≫
                CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U₂)).hom ν'.left) ≫
                CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₂).hom ι_Z =
                (CategoryTheory.Limits.pullback.fst (Fgt_Y.obj (B_ν.obj U₁)).hom ι_Y ≫
                  CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₁).hom ν.left) ≫
                  (Fgt_Z.map f).left :=
              (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (Fgt_Z.obj U₂).hom ι_Z)
                ((CategoryTheory.Category.assoc (hom_sch U₁) m_R _).trans
                  (congrArg (hom_sch U₁ ≫ ·) hbν'_fst))).trans
                ((CategoryTheory.Category.assoc (hom_sch U₁) _ _).trans
                  ((congrArg (hom_sch U₁ ≫ ·)
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      ((congrArg (_ ≫ ·) hbZ_fst).trans
                        (CategoryTheory.Category.assoc _ _ _).symm))).trans
                    ((CategoryTheory.Category.assoc (hom_sch U₁) _ (Fgt_Z.map f).left).symm.trans
                      (congrArg (· ≫ (Fgt_Z.map f).left)
                        ((CategoryTheory.Category.assoc (hom_sch U₁) _ _).symm.trans
                          (h_hom_fst_fst U₁))))))
            exact hLHS.trans hRHS.symm
          · have hLHS : ((m_L ≫ hom_sch U₂) ≫
                CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U₂)).hom ν'.left) ≫
                CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U₂).hom ι_Z =
                CategoryTheory.Limits.pullback.snd (Fgt_Y.obj (B_ν.obj U₁)).hom ι_Y ≫ ν'.left :=
              (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U₂).hom ι_Z)
                (CategoryTheory.Category.assoc m_L (hom_sch U₂) _)).trans
                ((CategoryTheory.Category.assoc m_L _ _).trans
                  ((congrArg (m_L ≫ ·) (h_hom_fst_snd U₂)).trans
                    ((CategoryTheory.Category.assoc m_L _ _).symm.trans
                      (congrArg (· ≫ ν'.left) hbY_snd))))
            have hRHS : ((hom_sch U₁ ≫ m_R) ≫
                CategoryTheory.Limits.pullback.fst (Fgt_Z'.obj (B_Z.obj U₂)).hom ν'.left) ≫
                CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U₂).hom ι_Z =
                CategoryTheory.Limits.pullback.snd (Fgt_Y.obj (B_ν.obj U₁)).hom ι_Y ≫ ν'.left :=
              (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (Fgt_Z.obj U₂).hom ι_Z)
                ((CategoryTheory.Category.assoc (hom_sch U₁) m_R _).trans
                  (congrArg (hom_sch U₁ ≫ ·) hbν'_fst))).trans
                ((CategoryTheory.Category.assoc (hom_sch U₁) _ _).trans
                  ((congrArg (hom_sch U₁ ≫ ·)
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      (congrArg (_ ≫ ·) hbZ_snd))).trans
                    ((CategoryTheory.Category.assoc (hom_sch U₁) _ _).symm.trans
                      (h_hom_fst_snd U₁))))
            exact hLHS.trans hRHS.symm
        · exact ((CategoryTheory.Category.assoc m_L (hom_sch U₂) _).trans
            ((congrArg (m_L ≫ ·) (h_hom_snd U₂)).trans hbY_snd)).trans
            ((CategoryTheory.Category.assoc (hom_sch U₁) m_R _).trans
              ((congrArg (hom_sch U₁ ≫ ·) hbν'_snd).trans (h_hom_snd U₁))).symm)

  letI : (B_ν ⋙ B_Y).IsContinuous J_Z J_Y' :=
    CategoryTheory.Functor.isContinuous_comp B_ν B_Y J_Z J_Y J_Y'
  letI : (B_Z ⋙ B_ν').IsContinuous J_Z J_Y' :=
    CategoryTheory.Functor.isContinuous_comp B_Z B_ν' J_Z J_Z' J_Y'
  let e_push : (P_push_Y ⋙ P_push_ν) ≅ (P_push_ν' ⋙ P_push_Z) :=
    CategoryTheory.Functor.sheafPushforwardContinuousIso e_site AddCommGrpCat.{u} J_Z J_Y'

  
  let adj_top : (P_pull_Z ⋙ P_pull_ν') ⊣ (P_push_ν' ⋙ P_push_Z) := adj_Z.comp adj_ν'
  let adj_bot : (P_pull_ν ⋙ P_pull_Y) ⊣ (P_push_Y ⋙ P_push_ν) := adj_ν.comp adj_Y

  let Φ_hom_app : ∀ ℱ : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u},
      (P_pull_Z ⋙ P_pull_ν').obj ℱ ⟶ (P_pull_ν ⋙ P_pull_Y).obj ℱ := fun ℱ =>
    (adj_top.homEquiv ℱ ((P_pull_ν ⋙ P_pull_Y).obj ℱ)).symm
      (adj_bot.unit.app ℱ ≫ e_push.hom.app ((P_pull_ν ⋙ P_pull_Y).obj ℱ))

  let Φ_inv_app : ∀ ℱ : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u},
      (P_pull_ν ⋙ P_pull_Y).obj ℱ ⟶ (P_pull_Z ⋙ P_pull_ν').obj ℱ := fun ℱ =>
    (adj_bot.homEquiv ℱ ((P_pull_Z ⋙ P_pull_ν').obj ℱ)).symm
      (adj_top.unit.app ℱ ≫ e_push.inv.app ((P_pull_Z ⋙ P_pull_ν').obj ℱ))

  have hΦ_mate : ∀ {ℱ : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}}
      {𝒢 : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}}
      (g : (P_pull_ν ⋙ P_pull_Y).obj ℱ ⟶ 𝒢),
      (adj_top.homEquiv ℱ 𝒢) (Φ_hom_app ℱ ≫ g) =
        (adj_bot.homEquiv ℱ 𝒢) g ≫ e_push.hom.app 𝒢 := fun {ℱ 𝒢} g =>
    (adj_top.homEquiv_naturality_right (Φ_hom_app ℱ) g).trans
      ((congrArg (· ≫ (P_push_ν' ⋙ P_push_Z).map g)
        (Equiv.apply_symm_apply (adj_top.homEquiv ℱ _) _)).trans
        ((CategoryTheory.Category.assoc (adj_bot.unit.app ℱ)
          (e_push.hom.app _) ((P_push_ν' ⋙ P_push_Z).map g)).trans
          ((congrArg (adj_bot.unit.app ℱ ≫ ·) (e_push.hom.naturality g).symm).trans
            ((CategoryTheory.Category.assoc (adj_bot.unit.app ℱ)
              ((P_push_Y ⋙ P_push_ν).map g) (e_push.hom.app 𝒢)).symm.trans
              (congrArg (· ≫ e_push.hom.app 𝒢) (adj_bot.homEquiv_unit ℱ 𝒢 g).symm)))))

  have hΦ_mate_inv : ∀ {ℱ : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}}
      {𝒢 : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}}
      (g : (P_pull_Z ⋙ P_pull_ν').obj ℱ ⟶ 𝒢),
      (adj_bot.homEquiv ℱ 𝒢) (Φ_inv_app ℱ ≫ g) =
        (adj_top.homEquiv ℱ 𝒢) g ≫ e_push.inv.app 𝒢 := fun {ℱ 𝒢} g =>
    (adj_bot.homEquiv_naturality_right (Φ_inv_app ℱ) g).trans
      ((congrArg (· ≫ (P_push_Y ⋙ P_push_ν).map g)
        (Equiv.apply_symm_apply (adj_bot.homEquiv ℱ _) _)).trans
        ((CategoryTheory.Category.assoc (adj_top.unit.app ℱ)
          (e_push.inv.app _) ((P_push_Y ⋙ P_push_ν).map g)).trans
          ((congrArg (adj_top.unit.app ℱ ≫ ·) (e_push.inv.naturality g).symm).trans
            ((CategoryTheory.Category.assoc (adj_top.unit.app ℱ)
              ((P_push_ν' ⋙ P_push_Z).map g) (e_push.inv.app 𝒢)).symm.trans
              (congrArg (· ≫ e_push.inv.app 𝒢) (adj_top.homEquiv_unit ℱ 𝒢 g).symm)))))

  let Φ_pb : (P_pull_Z ⋙ P_pull_ν') ≅ (P_pull_ν ⋙ P_pull_Y) :=
    CategoryTheory.NatIso.ofComponents
      (fun ℱ =>
        { hom := Φ_hom_app ℱ
