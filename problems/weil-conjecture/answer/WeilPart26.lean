      hAlg_push ↥(Algebra.adjoin k (Set.range w)) R₀ A e_R.symm.toRingHom
        e_R.symm.injective hcomp_R hw_alg
    let F₀ := FractionRing R₀
    let K := FractionRing A
    have h_sub : nonZeroDivisors R₀ ≤ Submonoid.comap ψ.toRingHom (nonZeroDivisors A) := by
      intro r hr
      rw [Submonoid.mem_comap]
      exact mem_nonZeroDivisors_of_ne_zero
        (fun h0 => nonZeroDivisors.ne_zero hr (hψ_inj (h0.trans (map_zero ψ).symm)))
    let ψ_K : F₀ →+* K := IsLocalization.map K ψ.toRingHom h_sub
    letI algFK : Algebra F₀ K := ψ_K.toAlgebra
    have hcomp_FK : (algebraMap F₀ K).comp (algebraMap R₀ F₀) = algebraMap R₀ K := by
      apply RingHom.ext
      intro r
      simp only [RingHom.comp_apply]
      change ψ_K (algebraMap R₀ F₀ r) = algebraMap R₀ K r
      rw [IsLocalization.map_eq h_sub r, IsScalarTower.algebraMap_apply R₀ A K]
      rfl
    letI : IsScalarTower R₀ F₀ K := IsScalarTower.of_algebraMap_eq' hcomp_FK.symm
    haveI : Algebra.IsAlgebraic A K := hAlg_frac A
    haveI hAlg_RK : Algebra.IsAlgebraic R₀ K := Algebra.IsAlgebraic.trans R₀ A K
