        AddCommGrpCat.ofHom
          { toFun := fun e a => (t_a_fun a).hom e
            map_zero' := funext fun a => map_zero (t_a_fun a).hom
            map_add' := fun e₁ e₂ => funext fun a => map_add (t_a_fun a).hom e₁ e₂ }
      refine ⟨t_all, ?_, ?_⟩
      · intro V u hu
        apply AddCommGrpCat.ext; intro e; funext a
        exact congrArg (fun k => k.hom e) (ht_a_spec a u hu)
      · intro t' ht'
        apply AddCommGrpCat.ext; intro e; funext a
        have ht'_a : t' ≫ AddCommGrpCat.ofHom (Pi.evalAddMonoidHom _ a) = t_a_fun a :=
