            simp
          rw [hidx, hw₁_last, ← hw₂_0, h0_last, hw₂_last]
        · have hidx : (⟨N₁ + N₂ - N₁, by omega⟩ : Fin (N₂ + 1)) = Fin.last N₂ := by
            ext
            simp
          rw [hidx, hw₂_last]
      · intro s
        dsimp [w]
        split_ifs
        · exact hw₁_tb _
        · exact hw₂_tb _
      · intro s
        by_cases hs : s.1 < N₁
        · let s₁ : Fin N₁ := ⟨s.1, hs⟩
          have h1 : s.1 + 1 ≤ N₁ := by omega
          have h2 : s.1 ≤ N₁ := by omega
          have heq1 : w s.succ = w₁ s₁.succ := by
            dsimp [w]
            split_ifs
            congr 1
          have heq2 : w s.castSucc = w₁ s₁.castSucc := by
            dsimp [w]
            split_ifs
            congr 1
          rw [heq1, heq2]
          exact hw₁_step s₁
        · let s₂ : Fin N₂ := ⟨s.1 - N₁, by omega⟩
          have h1 : ¬ s.1 + 1 ≤ N₁ := by omega
          have heq1 : w s.succ = w₂ s₂.succ := by
            dsimp [w]
            split_ifs
            congr 1
            ext
            simp [s₂]
            omega
          have heq2 : w s.castSucc = w₂ s₂.castSucc := by
            dsimp [w]
            split_ifs with heqN
            · have hs_eq : s.1 = N₁ := by omega
              have hidx1 : (⟨s.1, Nat.lt_succ_of_le heqN⟩ : Fin (N₁ + 1)) = Fin.last N₁ := by
                ext
                simp [hs_eq]
              have hidx2 : s₂.castSucc = 0 := by
                ext
                simp [s₂, hs_eq]
              rw [hidx1, hw₁_last, hidx2, hw₂_0]
            · congr 1
          rw [heq1, heq2]
          exact hw₂_step s₂
    haveI : FaithfulSMul k A := ⟨fun {c₁ c₂} h => by
      have h1 : algebraMap k A (c₁ - c₂) = 0 := by
        calc
          algebraMap k A (c₁ - c₂) = (c₁ - c₂) • (1 : A) := by
            rw [Algebra.smul_def, mul_one]
          _ = c₁ • (1 : A) - c₂ • (1 : A) := sub_smul c₁ c₂ (1 : A)
          _ = 0 := sub_eq_zero.mpr (h 1)
      by_contra hne
      have hunit : algebraMap k A (c₁ - c₂) * algebraMap k A (c₁ - c₂)⁻¹ = 1 := by
        rw [← map_mul, mul_inv_cancel₀ (sub_ne_zero.mpr hne), map_one]
      rw [h1, zero_mul] at hunit
      exact zero_ne_one hunit⟩
    let M_tr : Matroid A := AlgebraicIndependent.matroid k A
    have hBase_iff : ∀ x : Fin d → A,
        IsTranscendenceBasis k x ↔ Function.Injective x ∧ M_tr.IsBase (Set.range x) := by
      intro x
      constructor
      · intro hx
        have hx_inj : Function.Injective x :=
          (isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hx).1.injective
        refine ⟨hx_inj, ?_⟩
        let e_x : Fin d ≃ ↥(Set.range x) := Equiv.ofInjective x hx_inj
        have hcomp : x ∘ e_x.symm = (Subtype.val : Set.range x → A) := by
          funext y
          change (e_x (e_x.symm y)).1 = y.1
          rw [e_x.apply_symm_apply]
        have hx_sub : IsTranscendenceBasis k (Subtype.val : Set.range x → A) := by
          rw [← hcomp]
          exact hx.comp_equiv e_x.symm
        exact (AlgebraicIndependent.matroid_isBase_iff (R := k) (A := A)).mpr hx_sub
      · rintro ⟨hx_inj, hB⟩
        have hx_sub : IsTranscendenceBasis k (Subtype.val : Set.range x → A) :=
          (AlgebraicIndependent.matroid_isBase_iff (R := k) (A := A)).mp hB
        let e_x : Fin d ≃ ↥(Set.range x) := Equiv.ofInjective x hx_inj
        have hcomp : (Subtype.val : Set.range x → A) ∘ e_x = x := by
          funext i
          rfl
        rw [← hcomp]
        exact hx_sub.comp_equiv e_x
    let badSet : (Fin d → A) → Finset (Fin d) :=
      fun cur => Finset.univ.filter (fun i => cur i ∉ Set.range v)
    have hStage1 : ∀ (m : ℕ) (cur : Fin d → A),
        IsTranscendenceBasis k cur →
        (badSet cur).card = m →
        ∃ cur_mid : Fin d → A,
          ChainConn cur cur_mid ∧ IsTranscendenceBasis k cur_mid ∧ Set.range cur_mid = Set.range v := by
      intro m
      induction m with
      | zero =>
        intro cur hcur hcard0
        have hemp : badSet cur = ∅ := Finset.card_eq_zero.mp hcard0
        have hsub_range : ∀ i : Fin d, cur i ∈ Set.range v := by
          intro i
          by_contra hnot
          have hmem : i ∈ badSet cur := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hnot⟩
          rw [hemp] at hmem
          exact Finset.notMem_empty i hmem
        have hcur_inj : Function.Injective cur := ((hBase_iff cur).mp hcur).1
        have hv_inj : Function.Injective v := ((hBase_iff v).mp hv).1
        let S₁ : Finset A := Finset.univ.image cur
        let S₂ : Finset A := Finset.univ.image v
        have hS_sub : S₁ ⊆ S₂ := by
          intro a ha
          obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
          obtain ⟨j, hj⟩ := hsub_range i
          exact Finset.mem_image.mpr ⟨j, Finset.mem_univ j, hj⟩
        have hS_eq : S₁ = S₂ := by
          apply Finset.eq_of_subset_of_card_le hS_sub
          rw [Finset.card_image_of_injective _ hcur_inj, Finset.card_image_of_injective _ hv_inj]
        have hrange_eq : Set.range cur = Set.range v := by
          have hcoe := congrArg (fun S : Finset A => (S : Set A)) hS_eq
          simpa [S₁, S₂] using hcoe
        exact ⟨cur, hRefl cur hcur, hcur, hrange_eq⟩
      | succ m ih =>
        intro cur hcur hcard
        have hne : (badSet cur).Nonempty := Finset.card_pos.mp (by omega)
        obtain ⟨i₀, hi₀_mem⟩ := hne
        have hi₀_not : cur i₀ ∉ Set.range v := (Finset.mem_filter.mp hi₀_mem).2
        obtain ⟨hcur_inj, hB_cur⟩ := (hBase_iff cur).mp hcur
        have hB_v : M_tr.IsBase (Set.range v) := ((hBase_iff v).mp hv).2
        have hx_diff : cur i₀ ∈ Set.range cur \ Set.range v := ⟨⟨i₀, rfl⟩, hi₀_not⟩
        obtain ⟨y, hy_diff, hB_new⟩ := Matroid.IsBase.exchange hB_cur hB_v hx_diff
        let cur' : Fin d → A := Function.update cur i₀ y
        have hcur'_inj : Function.Injective cur' := by
          intro a b hab
          dsimp only [cur'] at hab
          by_cases ha : a = i₀ <;> by_cases hb : b = i₀
          · rw [ha, hb]
          · rw [ha, Function.update_self, Function.update_of_ne hb] at hab
            exact False.elim (hy_diff.2 ⟨b, hab.symm⟩)
          · rw [hb, Function.update_of_ne ha, Function.update_self] at hab
            exact False.elim (hy_diff.2 ⟨a, hab⟩)
          · rw [Function.update_of_ne ha, Function.update_of_ne hb] at hab
            exact hcur_inj hab
        have hrange_cur' : Set.range cur' = insert y (Set.range cur \ {cur i₀}) := by
          ext z
          simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_sdiff, Set.mem_singleton_iff]
          constructor
          · rintro ⟨j, hjz⟩
            dsimp only [cur'] at hjz
            by_cases hj : j = i₀
            · left
              rw [hj, Function.update_self] at hjz
              exact hjz.symm
            · right
              rw [Function.update_of_ne hj] at hjz
              exact ⟨⟨j, hjz⟩, fun heq => hj (hcur_inj (hjz.trans heq))⟩
          · rintro (hzy | ⟨⟨j, hjz⟩, hne_x⟩)
            · refine ⟨i₀, ?_⟩
              dsimp only [cur']
              rw [Function.update_self, hzy]
            · have hj : j ≠ i₀ := fun h => hne_x (hjz.symm.trans (congrArg cur h))
              refine ⟨j, ?_⟩
              dsimp only [cur']
              rw [Function.update_of_ne hj, hjz]
        have hcur'_tb : IsTranscendenceBasis k cur' :=
          (hBase_iff cur').mpr ⟨hcur'_inj, hrange_cur' ▸ hB_new⟩
        have hstep_cur' : ChainConn cur cur' :=
          hStep cur cur' i₀ hcur hcur'_tb (fun j hj => Function.update_of_ne hj y cur)
        have hbad_eq : badSet cur' = (badSet cur).erase i₀ := by
          ext j
          simp only [badSet, Finset.mem_erase, Finset.mem_filter, Finset.mem_univ, true_and]
          by_cases hj : j = i₀
          · rw [hj]
            simp [cur', hy_diff.1]
          · simp [cur', hj]
        have hcard' : (badSet cur').card = m := by
          rw [hbad_eq, Finset.card_erase_of_mem hi₀_mem, hcard]
          rfl
        obtain ⟨cur_mid, hch_mid, htb_mid, hrange_mid⟩ := ih cur' hcur'_tb hcard'
        exact ⟨cur_mid, hTrans hstep_cur' hch_mid, htb_mid, hrange_mid⟩
    have hShear : ∀ (w : Fin d → A) (p q : Fin d) (α : kˣ) (β : k),
        IsTranscendenceBasis k w →
        p ≠ q →
        IsTranscendenceBasis k (Function.update w p ((α : k) • w p + β • w q)) := by
      intro w p q α β hw hpq
      obtain ⟨hw_ind, hw_alg⟩ := isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hw
      let w' : Fin d → A := Function.update w p ((α : k) • w p + β • w q)
      let Φ : MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin d) k := MvPolynomial.aeval
        (Function.update MvPolynomial.X p
          ((α : k) • MvPolynomial.X p + β • MvPolynomial.X q))
      let Ψ : MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin d) k := MvPolynomial.aeval
        (Function.update MvPolynomial.X p
          (((α⁻¹ : kˣ) : k) • (MvPolynomial.X p - β • MvPolynomial.X q)))
      have hq_ne_p : q ≠ p := hpq.symm
      have hΨΦ : Ψ.comp Φ = AlgHom.id k (MvPolynomial (Fin d) k) := by
        apply MvPolynomial.algHom_ext
        intro r
        change Ψ (Φ (MvPolynomial.X r)) = MvPolynomial.X r
        by_cases hr : r = p
        · rw [hr]
          dsimp only [Φ, Ψ]
          rw [MvPolynomial.aeval_X, Function.update_self, map_add, map_smul, map_smul,
            MvPolynomial.aeval_X, MvPolynomial.aeval_X,
            Function.update_self, Function.update_of_ne hq_ne_p,
            smul_smul, Units.mul_inv, one_smul, sub_add_cancel]
        · dsimp only [Φ, Ψ]
          rw [MvPolynomial.aeval_X, Function.update_of_ne hr,
            MvPolynomial.aeval_X, Function.update_of_ne hr]
      have hli : Function.LeftInverse Ψ Φ := fun f => AlgHom.congr_fun hΨΦ f
      have hΦ_inj : Function.Injective Φ := hli.injective
      have haeval_w' : (MvPolynomial.aeval w).comp Φ = MvPolynomial.aeval w' := by
        apply MvPolynomial.algHom_ext
        intro r
        simp only [AlgHom.comp_apply]
        by_cases hr : r = p
        · rw [hr]
          simp [Φ, w']
        · simp [Φ, w', hr]
      have hw'_ind : AlgebraicIndependent k w' := by
        rw [algebraicIndependent_iff_injective_aeval] at hw_ind ⊢
        rw [← haeval_w']
        exact hw_ind.comp hΦ_inj
      have hadj_eq : Algebra.adjoin k (Set.range w') = Algebra.adjoin k (Set.range w) := by
        apply le_antisymm
        · apply Algebra.adjoin_le
          rintro _ ⟨r, rfl⟩
          by_cases hr : r = p
          · rw [hr]
            dsimp only [w']
            rw [Function.update_self]
            have hwp_mem : w p ∈ Algebra.adjoin k (Set.range w) := Algebra.subset_adjoin ⟨p, rfl⟩
            have hwq_mem : w q ∈ Algebra.adjoin k (Set.range w) := Algebra.subset_adjoin ⟨q, rfl⟩
            exact Subalgebra.add_mem _
              (Subalgebra.smul_mem _ hwp_mem _)
              (Subalgebra.smul_mem _ hwq_mem _)
          · dsimp only [w']
            rw [Function.update_of_ne hr]
            exact Algebra.subset_adjoin ⟨r, rfl⟩
        · apply Algebra.adjoin_le
          rintro _ ⟨r, rfl⟩
          by_cases hr : r = p
          · rw [hr]
            have hwp : w p = ((α⁻¹ : kˣ) : k) • (w' p - β • w' q) := by
              have hw'p : w' p = (α : k) • w p + β • w q := Function.update_self p _ w
              have hw'q : w' q = w q := Function.update_of_ne hq_ne_p _ w
              rw [hw'p, hw'q, add_sub_cancel_right, smul_smul, Units.inv_mul, one_smul]
            rw [hwp]
            have hw'p_mem : w' p ∈ Algebra.adjoin k (Set.range w') := Algebra.subset_adjoin ⟨p, rfl⟩
            have hw'q_mem : w' q ∈ Algebra.adjoin k (Set.range w') := Algebra.subset_adjoin ⟨q, rfl⟩
            exact Subalgebra.smul_mem _
              (Subalgebra.sub_mem _ hw'p_mem (Subalgebra.smul_mem _ hw'q_mem _)) _
          · have hwr : w r = w' r := (Function.update_of_ne hr _ w).symm
            rw [hwr]
            exact Algebra.subset_adjoin ⟨r, rfl⟩
      have hw'_alg : Algebra.IsAlgebraic ↥(Algebra.adjoin k (Set.range w')) A := by
        rw [hadj_eq]
        exact hw_alg
      exact isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mpr ⟨hw'_ind, hw'_alg⟩
    have hSwap : ∀ (cur : Fin d → A) (i j : Fin d),
        IsTranscendenceBasis k cur →
        i ≠ j →
        ChainConn cur (cur ∘ Equiv.swap i j) := by
      intro cur i j hcur hij
      have hji : j ≠ i := hij.symm
      let w₁ := Function.update cur i (((1 : kˣ) : k) • cur i + (1 : k) • cur j)
      have hw₁ : IsTranscendenceBasis k w₁ := hShear cur i j 1 1 hcur hij
      have hc₁ : ChainConn cur w₁ :=
        hStep cur w₁ i hcur hw₁ (fun r hr => Function.update_of_ne hr _ cur)
      let w₂ := Function.update w₁ j (((-1 : kˣ) : k) • w₁ j + (1 : k) • w₁ i)
      have hw₂ : IsTranscendenceBasis k w₂ := hShear w₁ j i (-1) 1 hw₁ hji
      have hc₂ : ChainConn w₁ w₂ :=
        hStep w₁ w₂ j hw₁ hw₂ (fun r hr => Function.update_of_ne hr _ w₁)
      let w₃ := Function.update w₂ i (((1 : kˣ) : k) • w₂ i + (-1 : k) • w₂ j)
      have hw₃ : IsTranscendenceBasis k w₃ := hShear w₂ i j 1 (-1) hw₂ hij
      have hc₃ : ChainConn w₂ w₃ :=
        hStep w₂ w₃ i hw₂ hw₃ (fun r hr => Function.update_of_ne hr _ w₂)
      have hw₃_eq : w₃ = cur ∘ Equiv.swap i j := by
        funext r
        by_cases hri : r = i
        · rw [hri]
          simp only [w₃, w₂, w₁, Function.comp_apply, Equiv.swap_apply_left,
            Function.update_self, Function.update_of_ne hij, Function.update_of_ne hji,
            Units.val_one, Units.val_neg, one_smul, neg_one_smul]
          abel
        · by_cases hrj : r = j
          · rw [hrj]
            simp only [w₃, w₂, w₁, Function.comp_apply, Equiv.swap_apply_right,
              Function.update_self, Function.update_of_ne hji,
              Units.val_one, Units.val_neg, one_smul, neg_one_smul]
            abel
          · simp only [w₃, w₂, w₁, Function.comp_apply,
              Equiv.swap_apply_of_ne_of_ne hri hrj,
              Function.update_of_ne hri, Function.update_of_ne hrj]
      rw [← hw₃_eq]
      exact hTrans (hTrans hc₁ hc₂) hc₃
    let diffSet : (Fin d → A) → Finset (Fin d) :=
      fun cur => Finset.univ.filter (fun i => cur i ≠ v i)
    have hStage2 : ∀ (m : ℕ) (cur : Fin d → A),
        IsTranscendenceBasis k cur →
        Set.range cur = Set.range v →
        (diffSet cur).card ≤ m →
        ChainConn cur v := by
      intro m
      induction m with
      | zero =>
        intro cur hcur _ hle
        have hemp : diffSet cur = ∅ := Finset.card_eq_zero.mp (Nat.le_zero.mp hle)
        have heq : cur = v := by
          funext i
          by_contra hne
          have hmem : i ∈ diffSet cur := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩
          rw [hemp] at hmem
          exact Finset.notMem_empty i hmem
        rw [← heq]
        exact hRefl cur hcur
      | succ m ih =>
        intro cur hcur hrange hle
        rcases Nat.eq_zero_or_pos (diffSet cur).card with h0 | hpos
        · exact ih cur hcur hrange (by omega)
        · obtain ⟨i, hi_mem⟩ := Finset.card_pos.mp hpos
          have hi_ne : cur i ≠ v i := (Finset.mem_filter.mp hi_mem).2
          have hvi_mem : v i ∈ Set.range cur := by
            rw [hrange]
            exact ⟨i, rfl⟩
          obtain ⟨j, hj_eq⟩ := hvi_mem
          have hij : i ≠ j := fun h => hi_ne (h ▸ hj_eq)
          have hv_inj : Function.Injective v := ((hBase_iff v).mp hv).1
          have hj_ne : cur j ≠ v j := by
            intro hcj
            apply hij
            exact hv_inj (hj_eq.symm.trans hcj)
          let cur' : Fin d → A := cur ∘ Equiv.swap i j
          have hc_swap : ChainConn cur cur' := hSwap cur i j hcur hij
          have hcur' : IsTranscendenceBasis k cur' := hcur.comp_equiv (Equiv.swap i j)
          have hrange' : Set.range cur' = Set.range v := by
            have hr_eq : Set.range cur' = Set.range cur := by
              ext z
              simp only [cur', Function.comp_apply, Set.mem_range]
              constructor
              · rintro ⟨y, rfl⟩
                exact ⟨Equiv.swap i j y, rfl⟩
              · rintro ⟨y, rfl⟩
                exact ⟨Equiv.swap i j y, by simp⟩
            rw [hr_eq, hrange]
          have hsub : diffSet cur' ⊆ (diffSet cur).erase i := by
            intro r hr
            have hr_ne : cur' r ≠ v r := (Finset.mem_filter.mp hr).2
            have hri : r ≠ i := by
              intro h
              subst h
              apply hr_ne
              simp [cur', hj_eq]
            rw [Finset.mem_erase]
            refine ⟨hri, Finset.mem_filter.mpr ⟨Finset.mem_univ r, ?_⟩⟩
            by_cases hrj : r = j
            · subst hrj
              exact hj_ne
            · simpa [cur', Equiv.swap_apply_of_ne_of_ne hri hrj] using hr_ne
          have hcard' : (diffSet cur').card ≤ m := by
            have h1 := Finset.card_le_card hsub
            rw [Finset.card_erase_of_mem hi_mem] at h1
            omega
          exact hTrans hc_swap (ih cur' hcur' hrange' hcard')
    obtain ⟨cur_mid, hc1, htb_mid, hrange_mid⟩ := hStage1 (badSet u).card u hu rfl
    have hc2 : ChainConn cur_mid v := hStage2 (diffSet cur_mid).card cur_mid htb_mid hrange_mid le_rfl
    exact hTrans hc1 hc2

theorem weil_top_deg_kummer_polyP1_coord_compactification (k : Type u) [Field k] :
    ∃ (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
        (weilProjectiveSpaceOver k 1).left)
      (ι_aff : ∀ δ : ℕ,
        Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left),
      WeilTopDegKummerPolyP1CoordPkg k ι_P1 ι_aff :=
by
  classical
  
  have hIntegralOfPointedCover :
      ∀ {Z A : AlgebraicGeometry.Scheme.{u}} (hIntA : AlgebraicGeometry.IsIntegral A)
        {I : Type} [Nonempty I] (w : I → (A ⟶ Z))
        (hw_open : ∀ i : I, AlgebraicGeometry.IsOpenImmersion (w i))
        (hw_cov : (⋃ i : I, Set.range (w i).base) = Set.univ)
        (z₀ : ↥Z) (hz₀ : ∀ i : I, z₀ ∈ Set.range (w i).base),
        AlgebraicGeometry.IsIntegral Z := by
    intro Z A hIntA I hNeI w hw_open hw_cov z₀ hz₀
    have hRedA : AlgebraicGeometry.IsReduced A :=
      @AlgebraicGeometry.isReduced_of_isIntegral A hIntA
    let U : ULift.{u} I → Z.Opens := fun idx =>
      let _ := hw_open idx.down
      (w idx.down).opensRange
    have hSup : (⨆ idx : ULift.{u} I, U idx) = ⊤ := by
      apply TopologicalSpace.Opens.ext
      ext z
      simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top,
        Set.mem_iUnion, Set.mem_univ, iff_true]
      have hz_mem : z ∈ (⋃ i : I, Set.range (w i).base) := by rw [hw_cov]; trivial
      rcases Set.mem_iUnion.mp hz_mem with ⟨i, hi⟩
      exact ⟨ULift.up i, hi⟩
    have hRed_U : ∀ idx : ULift.{u} I, AlgebraicGeometry.IsReduced (U idx).toScheme := by
      intro idx
      let _ := hw_open idx.down
      exact @AlgebraicGeometry.isReduced_of_isOpenImmersion _ A
        (w idx.down).isoOpensRange.inv inferInstance hRedA
    have hRed_sup : AlgebraicGeometry.IsReduced (⨆ idx : ULift.{u} I, U idx).toScheme := by
      let 𝒰 := AlgebraicGeometry.Scheme.Opens.iSupOpenCover U
      have _ : ∀ j : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X j) := fun j => hRed_U j
      exact AlgebraicGeometry.IsReduced.of_openCover _ 𝒰
    have _ : AlgebraicGeometry.IsReduced (⊤ : Z.Opens).toScheme := hSup ▸ hRed_sup
    have _ : AlgebraicGeometry.IsReduced Z :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion Z.topIso.inv
    have hIrredA : IrreducibleSpace ↥A :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral A hIntA
    have hIrredU : ∀ i : I, IsIrreducible (Set.range (w i).base) := by
      intro i
      rw [← Set.image_univ]
      exact hIrredA.isIrreducible_univ.image (w i).base (w i).continuous.continuousOn
    have hOpenU : ∀ i : I, IsOpen (Set.range (w i).base) := by
      intro i
      let _ := hw_open i
      exact (w i).isOpenEmbedding.isOpen_range
    have _ : IrreducibleSpace ↥Z :=
      { toPreirreducibleSpace :=
          { isPreirreducible_univ := fun V₁ V₂ hV₁ hV₂ ⟨p₁, _, hp₁⟩ ⟨p₂, _, hp₂⟩ => by
              have hp₁_u : p₁ ∈ ⋃ i : I, Set.range (w i).base := by rw [hw_cov]; trivial
              have hp₂_u : p₂ ∈ ⋃ i : I, Set.range (w i).base := by rw [hw_cov]; trivial
              rcases Set.mem_iUnion.mp hp₁_u with ⟨i₁, hi₁⟩
              rcases Set.mem_iUnion.mp hp₂_u with ⟨i₂, hi₂⟩
              obtain ⟨p', _, hp'_V₁, hp'_i₂⟩ :=
                (hIrredU i₁).isPreirreducible V₁ (Set.range (w i₂).base) hV₁ (hOpenU i₂)
                  ⟨p₁, hi₁, hp₁⟩ ⟨z₀, hz₀ i₁, hz₀ i₂⟩
              obtain ⟨q, _, hq₁, hq₂⟩ :=
                (hIrredU i₂).isPreirreducible V₁ V₂ hV₁ hV₂
                  ⟨p', hp'_i₂, hp'_V₁⟩ ⟨p₂, hi₂, hp₂⟩
              exact ⟨q, trivial, hq₁, hq₂⟩ }
        toNonempty := ⟨z₀⟩ }
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Z

  
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let A_1 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
  let f_A1 : A_1 ⟶ S_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
  let R_2 := MvPolynomial (Fin (1 + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let Proj_P1 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let f_P1 : Proj_P1 ⟶ S_k :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
  let P_1 := weilProjectiveSpaceOver k 1

  
  have _ : Algebra.FiniteType ↥(𝒜 0) R_2 := by
    let gen : Finset R_2 := Finset.univ.image (MvPolynomial.X : Fin (1 + 1) → R_2)
    have h_mem : ∀ p : R_2, p ∈ Algebra.adjoin ↥(𝒜 0) (↑gen : Set R_2) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c =>
        exact Subalgebra.algebraMap_mem _ (algebraMap k ↥(𝒜 0) c)
      | add p q hp hq =>
        exact Subalgebra.add_mem _ hp hq
      | mul_X p i hp =>
        refine Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ?_)
        exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))
    exact ⟨⟨gen, eq_top_iff.mpr fun p _ => h_mem p⟩⟩
  have hBij_A0 : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
    refine ⟨fun c₁ c₂ hc => ?_, fun z => ?_⟩
    · have hval : (algebraMap k ↥(𝒜 0) c₁ : R_2) = (algebraMap k ↥(𝒜 0) c₂ : R_2) :=
        congrArg Subtype.val hc
      exact MvPolynomial.C_injective (Fin (1 + 1)) k hval
    · refine ⟨z.1.coeff 0, Subtype.ext ?_⟩
      change MvPolynomial.C (z.1.coeff 0) = z.1
      ext d
      by_cases hd : d = 0
      · subst hd
        rw [MvPolynomial.coeff_C, ite_eq_left_iff.mpr fun h => absurd rfl h]
      · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h0 => absurd h0.symm hd]
        symm
        by_contra hcoeff
        have hhom : z.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 z.1).mp z.2
        have hdeg0 := hhom hcoeff
        simp only [Finsupp.weight_apply, Pi.one_apply, smul_eq_mul, mul_one] at hdeg0
        have hall0 : ∀ i : Fin (1 + 1), d i = 0 := by
          intro i
          by_contra hi
          have hmem : i ∈ d.support := Finsupp.mem_support_iff.mpr hi
          have hle : d i ≤ ∑ j ∈ d.support, d j :=
            Finset.single_le_sum (fun _ _ => Nat.zero_le _) hmem
          change (∑ j ∈ d.support, d j) = 0 at hdeg0
          omega
        apply hd
        ext i
        exact hall0 i
  let e_A0 : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hBij_A0
  have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
    ⟨⟨CommRingCat.ofHom e_A0.symm.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun c => e_A0.symm_apply_apply c),
      CommRingCat.hom_ext (RingHom.ext fun z => e_A0.apply_symm_apply z)⟩⟩
  have hProp1_raw : AlgebraicGeometry.IsProper f_P1 := inferInstance
  have hProp1 : AlgebraicGeometry.IsProper P_1.hom := hProp1_raw
  have hProj1 : IsProjectiveOverField k P_1 :=
    ⟨1, 𝟙 P_1, by change AlgebraicGeometry.IsClosedImmersion (𝟙 P_1.left); infer_instance⟩

  
  have hChartEquiv : ∀ (i_den i_num : Fin (1 + 1)) (hne : i_den ≠ i_num),
      let hXd : (MvPolynomial.X i_den : R_2) ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k i_den
      let hXn : (MvPolynomial.X i_num : R_2) ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k i_num
      ∃ e : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i_den),
        e.toRingHom.comp Polynomial.C =
          (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X i_den))).comp (algebraMap k ↥(𝒜 0)) ∧
        e Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) hXd hXn := by
    intro i_den i_num hne hXd hXn
    let X_d : R_2 := MvPolynomial.X i_den
    let X_n : R_2 := MvPolynomial.X i_num
    let Aw := HomogeneousLocalization.Away 𝒜 X_d
    let Loc := Localization.Away X_d
    let ι_L : R_2 →+* Loc := algebraMap R_2 Loc
    let c₀ : k →+* Aw :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers X_d)).comp
        (algebraMap k ↥(𝒜 0))
    let τ : Aw := HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) hXd hXn
    let φ : Polynomial k →+* Aw := Polynomial.eval₂RingHom c₀ τ
    let ev : R_2 →+* Polynomial k :=
      MvPolynomial.eval₂Hom Polynomial.C
        (fun j : Fin (1 + 1) => if j = i_den then (1 : Polynomial k) else Polynomial.X)
    have hev_Xd : ev X_d = 1 := by
      dsimp [ev, X_d]
      rw [MvPolynomial.eval₂Hom_X', ite_eq_left_iff.mpr fun h => absurd rfl h]
    have hev_Xn : ev X_n = Polynomial.X := by
      dsimp [ev, X_n]
      rw [MvPolynomial.eval₂Hom_X', ite_eq_right_iff.mpr fun h => absurd h hne.symm]
    let ψ_loc : Loc →+* Polynomial k :=
      IsLocalization.Away.lift X_d (g := ev) (hev_Xd.symm ▸ isUnit_one)
    let valHom : Aw →+* Loc :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let ψ : Aw →+* Polynomial k := ψ_loc.comp valHom
    have hc₀_val : ∀ a : k, (c₀ a).val = ι_L (MvPolynomial.C a) := by
      intro a
      change (HomogeneousLocalization.mk
        { deg := 0
          num := algebraMap k ↥(𝒜 0) a
          den := ⟨1, SetLike.one_mem_graded 𝒜⟩
          den_mem := Submonoid.one_mem (Submonoid.powers X_d) }).val = ι_L (MvPolynomial.C a)
      rw [HomogeneousLocalization.val_mk]
      dsimp [ι_L]
      exact Localization.mk_one_eq_algebraMap (MvPolynomial.C a)
    have hτ_mul : τ.val * ι_L X_d = ι_L X_n := by
      simp [τ, ι_L, Loc, X_d, X_n, Localization.mk_eq_mk']
    have h_left : ψ.comp φ = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro a
        change ψ_loc (φ (Polynomial.C a)).val = Polynomial.C a
        dsimp [φ]
        rw [Polynomial.eval₂_C, hc₀_val, IsLocalization.Away.lift_eq]
        exact MvPolynomial.eval₂Hom_C _ _ a
      · change ψ_loc (φ Polynomial.X).val = Polynomial.X
        dsimp [φ]
        rw [Polynomial.eval₂_X]
        have hmul := congrArg ψ_loc hτ_mul
        rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
          hev_Xd, hev_Xn, mul_one] at hmul
        exact hmul
    have hFin2_cover : ∀ j : Fin (1 + 1), j = i_den ∨ j = i_num := by
      intro j
      fin_cases j <;> fin_cases i_den <;> fin_cases i_num <;> omega
    have hHom_eq : ∀ (m : ℕ) (f : R_2), f ∈ 𝒜 m →
        (φ (ev f)).val * ι_L (X_d ^ m) = ι_L f := by
      intro m f hf
      have hf_hom : f.IsHomogeneous m := (MvPolynomial.mem_homogeneousSubmodule m f).mp hf
      conv_lhs => rw [MvPolynomial.as_sum f]
      conv_rhs => rw [MvPolynomial.as_sum f]
      rw [map_sum, map_sum, show ∀ s : Finset (Fin (1 + 1) →₀ ℕ),
        (∑ x ∈ s, φ (ev (MvPolynomial.monomial x (f.coeff x)))).val =
          ∑ x ∈ s, (φ (ev (MvPolynomial.monomial x (f.coeff x)))).val from
            fun s => map_sum valHom _ s,
        Finset.sum_mul, map_sum]
      refine Finset.sum_congr rfl fun d hd => ?_
      have hd_ne : f.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
      have hd_decomp : d = Finsupp.single i_den (d i_den) + Finsupp.single i_num (d i_num) := by
        ext j
        rcases hFin2_cover j with rfl | rfl
        · simp [hne]
        · simp [hne.symm]
      have hd_sum : d i_den + d i_num = m := by
        have h1 := hf_hom hd_ne
        simp only [Finsupp.weight_apply, Pi.one_apply, smul_eq_mul, mul_one] at h1
        have h2 : d.sum (fun _ a => a) = ∑ i : Fin (1 + 1), d i :=
          Finsupp.sum_fintype d _ (fun _ => rfl)
        have h3 : (∑ i : Fin (1 + 1), d i) = d i_den + d i_num := by
          conv_lhs => rw [hd_decomp]
          simp [Finset.sum_add_distrib]
        exact h3.symm.trans (h2.symm.trans h1)
      have hmon_eq : MvPolynomial.monomial d (f.coeff d) =
          MvPolynomial.C (f.coeff d) * X_d ^ (d i_den) * X_n ^ (d i_num) := by
        dsimp [X_d, X_n]
        rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
          MvPolynomial.C_mul_monomial, mul_one, MvPolynomial.monomial_mul_monomial,
          mul_one, ← hd_decomp]
      have hev_mon : ev (MvPolynomial.monomial d (f.coeff d)) =
          Polynomial.C (f.coeff d) * Polynomial.X ^ d i_num := by
        rw [hmon_eq, map_mul, map_mul, map_pow, map_pow, MvPolynomial.eval₂Hom_C,
          hev_Xd, hev_Xn, one_pow, mul_one]
      have hφ_mon : (φ (Polynomial.C (f.coeff d) * Polynomial.X ^ d i_num)).val =
          ι_L (MvPolynomial.C (f.coeff d)) * τ.val ^ d i_num := by
        change (Polynomial.eval₂ c₀ τ (Polynomial.C (f.coeff d) * Polynomial.X ^ d i_num)).val = _
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_pow, Polynomial.eval₂_C, Polynomial.eval₂_X,
          HomogeneousLocalization.val_mul,
          show (τ ^ d i_num).val = τ.val ^ d i_num from map_pow valHom τ (d i_num), hc₀_val]
      rw [hev_mon, hφ_mon, hmon_eq, ← hd_sum, pow_add, map_mul, map_pow, map_pow]
      calc
        ι_L (MvPolynomial.C (f.coeff d)) * τ.val ^ d i_num *
            (ι_L X_d ^ d i_den * ι_L X_d ^ d i_num)
          = ι_L (MvPolynomial.C (f.coeff d)) * ι_L X_d ^ d i_den *
              (τ.val * ι_L X_d) ^ d i_num := by ring
        _ = ι_L (MvPolynomial.C (f.coeff d)) * ι_L X_d ^ d i_den *
              (ι_L X_n) ^ d i_num := by rw [hτ_mul]
        _ = ι_L (MvPolynomial.C (f.coeff d) * X_d ^ d i_den * X_n ^ d i_num) := by
              rw [map_mul, map_mul, map_pow, map_pow]
    have h_right : ∀ z : Aw, φ (ψ z) = z := by
      intro z
      induction z using Quotient.inductionOn with
      | h nd =>
        let z₀ : Aw := HomogeneousLocalization.mk nd
        change φ (ψ z₀) = z₀
        rcases nd.den_mem with ⟨r, hr⟩
        dsimp only at hr
        have hXd_r_ne : (X_d ^ r : R_2) ≠ 0 := by
          intro h0
          have hev1 := congrArg (MvPolynomial.eval (fun _ : Fin (1 + 1) => (1 : k))) h0
          simp [X_d] at hev1
        have hXd_r_hom : (X_d ^ r : R_2).IsHomogeneous r := by
          simpa [X_d] using (MvPolynomial.isHomogeneous_X k i_den).pow r
        have hden_hom : nd.den.1.IsHomogeneous nd.deg :=
          (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
        have hdeg_eq : nd.deg = r := by
          have hsupp : (X_d ^ r : R_2).support.Nonempty :=
            MvPolynomial.support_nonempty.mpr hXd_r_ne
          rcases hsupp with ⟨d, hd⟩
          have hd_ne : (X_d ^ r : R_2).coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
          have h1 := hXd_r_hom hd_ne
          have h2 : (Finsupp.weight 1) d = nd.deg := by
            apply hden_hom
            rwa [← hr]
          exact h2.symm.trans h1
        have hnum_mem : nd.num.1 ∈ 𝒜 r := hdeg_eq ▸ nd.num.2
        have hz₀_mul : z₀.val * ι_L (X_d ^ r) = ι_L nd.num.1 := by
          dsimp [z₀, ι_L]
          rw [Localization.mk_eq_mk', hr]
          exact IsLocalization.mk'_spec Loc nd.num.1 ⟨nd.den.1, nd.den_mem⟩
        have hψ_z₀ : ψ z₀ = ev nd.num.1 := by
          have h1 := congrArg ψ_loc hz₀_mul
          dsimp [ι_L] at h1
          rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
            map_pow, hev_Xd, one_pow, mul_one] at h1
          exact h1
        apply HomogeneousLocalization.val_injective
        let s_pow : Submonoid.powers X_d := ⟨X_d ^ r, r, rfl⟩
        have hunit : IsUnit (ι_L s_pow.1) := IsLocalization.map_units Loc s_pow
        apply hunit.mul_right_cancel
        dsimp [s_pow]
        rw [hψ_z₀, hHom_eq r nd.num.1 hnum_mem, hz₀_mul]
    let e_equiv : Polynomial k ≃+* Aw :=
      { φ with
        invFun := ψ
        left_inv := fun p => RingHom.congr_fun h_left p
        right_inv := h_right }
    refine ⟨e_equiv, ?_, ?_⟩
    · apply RingHom.ext
      intro a
      change Polynomial.eval₂ c₀ τ (Polynomial.C a) = c₀ a
      exact Polynomial.eval₂_C c₀ τ
    · exact Polynomial.eval₂_X c₀ τ

  
  have hX0 : (MvPolynomial.X (0 : Fin (1 + 1)) : R_2) ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k 0
  have hX1 : (MvPolynomial.X (1 : Fin (1 + 1)) : R_2) ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k 1
  obtain ⟨e10, he10_C, he10_X⟩ := hChartEquiv 1 0 (by decide)
  obtain ⟨e01, he01_C, he01_X⟩ := hChartEquiv 0 1 (by decide)
  have _ : CategoryTheory.IsIso (CommRingCat.ofHom e10.symm.toRingHom) :=
    ⟨⟨CommRingCat.ofHom e10.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun x => e10.apply_symm_apply x),
      CommRingCat.hom_ext (RingHom.ext fun x => e10.symm_apply_apply x)⟩⟩
  have _ : CategoryTheory.IsIso (CommRingCat.ofHom e01.symm.toRingHom) :=
    ⟨⟨CommRingCat.ofHom e01.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun x => e01.apply_symm_apply x),
      CommRingCat.hom_ext (RingHom.ext fun x => e01.symm_apply_apply x)⟩⟩
  let ι_P1_raw : A_1 ⟶ Proj_P1 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom) ≫
      AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one
  let ι_inf_raw : A_1 ⟶ Proj_P1 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom) ≫
      AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one
  have hOpen_P1_raw : AlgebraicGeometry.IsOpenImmersion ι_P1_raw := inferInstance
  have hOpen_inf_raw : AlgebraicGeometry.IsOpenImmersion ι_inf_raw := inferInstance
  let ι_P1 : A_1 ⟶ P_1.left := ι_P1_raw
  let ι_inf : A_1 ⟶ P_1.left := ι_inf_raw
  have hOpen_P1 : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen_P1_raw
  have hOpen_inf : AlgebraicGeometry.IsOpenImmersion ι_inf := hOpen_inf_raw

  have hOver_P1 : ι_P1 ≫ P_1.hom = f_A1 := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom) ≫
      AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = f_A1
    rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜 _ _ _),
      AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply RingHom.ext
    intro a
    have h1 := RingHom.congr_fun he10_C a
    simpa using (congrArg e10.symm h1).symm
  have hOver_inf : ι_inf ≫ P_1.hom = f_A1 := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom) ≫
      AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = f_A1
    rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜 _ _ _),
      AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply RingHom.ext
    intro a
    have h1 := RingHom.congr_fun he01_C a
    simpa using (congrArg e01.symm h1).symm

  
  have hRange_P1 : Set.range ι_P1_raw.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) : Set ↥Proj_P1) := by
    have hsurj : Function.Surjective
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom)).base :=
      (AlgebraicGeometry.Scheme.Hom.homeomorph
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom))).surjective
    change Set.range ((AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one).base ∘
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom)).base) = _
    rw [Set.range_comp, hsurj.range_eq, Set.image_univ]
    exact congrArg SetLike.coe
      (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one)
  have hRange_inf : Set.range ι_inf_raw.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥Proj_P1) := by
    have hsurj : Function.Surjective
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom)).base :=
      (AlgebraicGeometry.Scheme.Hom.homeomorph
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom))).surjective
    change Set.range ((AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one).base ∘
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom)).base) = _
    rw [Set.range_comp, hsurj.range_eq, Set.image_univ]
    exact congrArg SetLike.coe
      (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one)

  have hTwoChartCov_raw : Set.range ι_P1_raw.base ∪ Set.range ι_inf_raw.base = Set.univ := by
    ext p
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    rw [hRange_P1, hRange_inf]
    by_contra hp_not
    have hp1 : (MvPolynomial.X 1 : R_2) ∈ p.asHomogeneousIdeal := by
      by_contra hp1_not
      exact hp_not (Or.inl ((ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X 1) p).mpr hp1_not))
    have hp0 : (MvPolynomial.X 0 : R_2) ∈ p.asHomogeneousIdeal := by
      by_contra hp0_not
      exact hp_not (Or.inr ((ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X 0) p).mpr hp0_not))
    apply p.not_irrelevant_le
    intro f hf
    rw [HomogeneousIdeal.mem_irrelevant_iff] at hf
    change f ∈ p.asHomogeneousIdeal.toIdeal
    rw [MvPolynomial.as_sum f]
    refine Ideal.sum_mem _ fun d hd => ?_
    by_cases hd0 : d = 0
    · subst hd0
      have hc0 : f.coeff 0 = 0 := by
        have hproj_sum : (GradedRing.proj 𝒜 0) f = MvPolynomial.monomial 0 (f.coeff 0) := by
          conv_lhs => rw [MvPolynomial.as_sum f]
          rw [map_sum]
          have hterm : ∀ e ∈ f.support,
              (GradedRing.proj 𝒜 0) (MvPolynomial.monomial e (f.coeff e)) =
                if e = 0 then MvPolynomial.monomial 0 (f.coeff 0) else 0 := by
            intro e _
            by_cases he : e = 0
            · subst he
              rw [ite_eq_left_iff.mpr fun h => absurd rfl h]
              have hmem0 : MvPolynomial.monomial (0 : Fin (1 + 1) →₀ ℕ) (f.coeff 0) ∈ 𝒜 0 :=
                (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr
                  (MvPolynomial.isHomogeneous_monomial _ rfl)
              exact (GradedRing.proj_apply 𝒜 0 _).trans (DirectSum.decompose_of_mem_same 𝒜 hmem0)
            · rw [ite_eq_right_iff.mpr fun h => absurd h he]
              have hdeg_pos : Finsupp.degree e ≠ 0 := by
                intro hw0
                apply he
                ext i
                rw [Finsupp.coe_zero, Pi.zero_apply]
                by_contra hi
                have hmem : i ∈ e.support := Finsupp.mem_support_iff.mpr hi
                have hle : e i ≤ ∑ j ∈ e.support, e j :=
                  Finset.single_le_sum (fun _ _ => Nat.zero_le _) hmem
                change (∑ j ∈ e.support, e j) = 0 at hw0
                omega
              have hmeme : MvPolynomial.monomial e (f.coeff e) ∈ 𝒜 (Finsupp.degree e) :=
                (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
                  (MvPolynomial.isHomogeneous_monomial _ rfl)
              exact (GradedRing.proj_apply 𝒜 0 _).trans
                (DirectSum.decompose_of_mem_ne 𝒜 hmeme hdeg_pos)
          rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq']
          by_cases h0_mem : (0 : Fin (1 + 1) →₀ ℕ) ∈ f.support
          · rw [ite_eq_left_iff.mpr fun h => absurd h0_mem h]
          · rw [ite_eq_right_iff.mpr fun h => absurd h h0_mem]
            have hc : f.coeff 0 = 0 := MvPolynomial.notMem_support_iff.mp h0_mem
            simp [hc]
        rw [hproj_sum] at hf
        have hcoeff := congrArg (fun q : R_2 => q.coeff 0) hf
        simpa using hcoeff
      simp [hc0]
    · have hex : ∃ j : Fin (1 + 1), d j ≠ 0 := by
        by_contra hall
        apply hd0
        ext j
        by_contra hj
        exact hall ⟨j, hj⟩
      rcases hex with ⟨j, hj⟩
      obtain ⟨k_exp, hk_exp⟩ := Nat.exists_eq_succ_of_ne_zero hj
      have hd_split : d = Finsupp.single j 1 + d.update j k_exp := by
        ext i
        by_cases hi : i = j
        · subst hi; simp [hk_exp]; omega
        · simp [hi, Finsupp.coe_update]
      have hmon_mul : MvPolynomial.monomial d (f.coeff d) =
          MvPolynomial.X j * MvPolynomial.monomial (d.update j k_exp) (f.coeff d) := by
        rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, ← hd_split]
      rw [hmon_mul]
      refine Ideal.mul_mem_right _ _ ?_
      fin_cases j
      · exact hp0
      · exact hp1
  have hTwoChartCov : Set.range ι_P1.base ∪ Set.range ι_inf.base = Set.univ := hTwoChartCov_raw

  
  have hPre_inf_P1 : ∀ q : PrimeSpectrum (Polynomial k),
      ι_inf.base q ∈ Set.range ι_P1.base ↔ Polynomial.X ∉ q.asIdeal := by
    intro q
    change ι_inf_raw.base q ∈ Set.range ι_P1_raw.base ↔ _
    rw [hRange_P1]
    have hpre := Set.ext_iff.mp
      (congrArg SetLike.coe
        (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hX0 zero_lt_one hX1 zero_lt_one))
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom)).base q)
    change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom)).base q ∈
      ((TopologicalSpace.Opens.map
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1)) : Set _)) ↔ _
    rw [hpre]
    change HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) hX0 hX1 ∉
      Ideal.comap e01.symm.toRingHom q.asIdeal ↔ _
    rw [Ideal.mem_comap, ← he01_X]
    simp
  have hPre_P1_inf : ∀ q : PrimeSpectrum (Polynomial k),
      ι_P1.base q ∈ Set.range ι_inf.base ↔ Polynomial.X ∉ q.asIdeal := by
    intro q
    change ι_P1_raw.base q ∈ Set.range ι_inf_raw.base ↔ _
    rw [hRange_inf]
    have hpre := Set.ext_iff.mp
      (congrArg SetLike.coe
        (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hX1 zero_lt_one hX0 zero_lt_one))
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom)).base q)
    change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom)).base q ∈
      ((TopologicalSpace.Opens.map
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)) : Set _)) ↔ _
    rw [hpre]
    change HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) hX1 hX0 ∉
      Ideal.comap e10.symm.toRingHom q.asIdeal ↔ _
    rw [Ideal.mem_comap, ← he10_X]
    simp

  
  let ev0 : Polynomial k →+* k := Polynomial.eval₂RingHom (RingHom.id k) 0
  let σ_0 : S_k ⟶ A_1 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0)
  let s_inf : S_k ⟶ P_1.left := σ_0 ≫ ι_inf
  have hs_inf_over : s_inf ≫ P_1.hom = 𝟙 S_k := by
    dsimp [s_inf, σ_0]
    rw [Category.assoc, hOver_inf, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hid : ev0.comp Polynomial.C = RingHom.id k := by ext c; simp [ev0]
    rw [hid]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of k)
  have hDisj_inf : Disjoint (Set.range ι_P1.base) (Set.range s_inf.base) := by
    rw [Set.disjoint_left]
    rintro _ hx ⟨pt, rfl⟩
    let q0 : PrimeSpectrum (Polynomial k) := σ_0.base pt
    change ι_inf.base q0 ∈ Set.range ι_P1.base at hx
    rw [hPre_inf_P1 q0] at hx
    apply hx
    change ev0 Polynomial.X ∈ pt.asIdeal
    simp [ev0, pt.asIdeal.zero_mem]
  have hUniv_inf : Set.range ι_P1.base ∪ Set.range s_inf.base = Set.univ := by
    ext x
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    by_cases hx : x ∈ Set.range ι_P1.base
    · exact Or.inl hx
    · right
      have hx_cov : x ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base := by
        rw [hTwoChartCov]; trivial
      rcases hx_cov with hx1 | ⟨q, rfl⟩
      · exact absurd hx1 hx
      · let q' : PrimeSpectrum (Polynomial k) := q
        have hXq : Polynomial.X ∈ q'.asIdeal := by
          by_contra hXnot
          exact hx ((hPre_inf_P1 q').mpr hXnot)
        let pt : ↥S_k := f_A1.base q
        refine ⟨pt, ?_⟩
        change ι_inf.base (σ_0.base pt) = ι_inf.base q
        congr 1
        apply PrimeSpectrum.ext
        ext p
        obtain ⟨g, hg⟩ := Polynomial.X_dvd_sub_C (p := p)
        have hp_eq : p = Polynomial.C (p.coeff 0) + Polynomial.X * g := by
          linear_combination hg
        have hev0_p : ev0 p = p.coeff 0 := by
          conv_lhs => rw [hp_eq]
          simp [ev0]
        change ev0 p ∈ Ideal.comap Polynomial.C q'.asIdeal ↔ p ∈ q'.asIdeal
        rw [Ideal.mem_comap, hev0_p]
        conv_rhs => rw [hp_eq]
        exact (Ideal.add_mem_iff_left q'.asIdeal
          (q'.asIdeal.mul_mem_right g hXq)).symm

  let ev1 : Polynomial k →+* k := Polynomial.eval₂RingHom (RingHom.id k) 1
  let σ_1 : S_k ⟶ A_1 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev1)
  let s_one : S_k ⟶ P_1.left := σ_1 ≫ ι_P1
  have hs_one_over : s_one ≫ P_1.hom = 𝟙 S_k := by
    dsimp [s_one, σ_1]
    rw [Category.assoc, hOver_P1, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hid : ev1.comp Polynomial.C = RingHom.id k := by ext c; simp [ev1]
    rw [hid]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of k)
  have hs_one_mem : Set.range s_one.base ⊆ Set.range ι_P1.base ∩ Set.range ι_inf.base := by
    rintro _ ⟨pt, rfl⟩
    let q1 : PrimeSpectrum (Polynomial k) := σ_1.base pt
    refine ⟨⟨q1, rfl⟩, ?_⟩
    change ι_P1.base q1 ∈ Set.range ι_inf.base
    rw [hPre_P1_inf q1]
    change ev1 Polynomial.X ∉ pt.asIdeal
    simp [ev1, pt.isPrime.one_notMem]

  
  have hStd_polyC : RingHom.IsStandardSmoothOfRelativeDimension 1
      (Polynomial.C : k →+* Polynomial k) := by
    have hStd_mv : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card (Fin 1))
        k (MvPolynomial (Fin 1) k) :=
      Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial k (Fin 1)
    have hcard1 : Nat.card (Fin 1) = 1 := by simp
    rw [hcard1] at hStd_mv
    have hStd_alg : RingHom.IsStandardSmoothOfRelativeDimension 1
        (algebraMap k (MvPolynomial (Fin 1) k)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hStd_mv
    let e_u := MvPolynomial.uniqueAlgEquiv k (Fin 1)
    have h_eq : e_u.toRingEquiv.toRingHom.comp (algebraMap k (MvPolynomial (Fin 1) k)) =
        (Polynomial.C : k →+* Polynomial k) :=
      RingHom.ext fun c => e_u.commutes c
    rw [← h_eq]
    exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).1
      (algebraMap k (MvPolynomial (Fin 1) k)) e_u.toRingEquiv hStd_alg
  have h_appLE_congr : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}
      {O₂ : Z₂.Opens} {O₁ : Z₁.Opens}
      (g₁ g₂ : Z₁ ⟶ Z₂), g₁ = g₂ →
      ∀ (h₁ : O₁ ≤ (TopologicalSpace.Opens.map g₁.base).obj O₂)
        (h₂ : O₁ ≤ (TopologicalSpace.Opens.map g₂.base).obj O₂),
      g₁.appLE O₂ O₁ h₁ = g₂.appLE O₂ O₁ h₂ := by
    rintro _ _ _ _ g₁ _ rfl _ _
    rfl
  have hChartStdSmooth : ∀ (ι : A_1 ⟶ P_1.left) (hOpen : AlgebraicGeometry.IsOpenImmersion ι),
      ι ≫ P_1.hom = f_A1 →
      ∀ (x : ↥P_1.left), x ∈ Set.range ι.base →
      ∃ U, ∃ (_ : AlgebraicGeometry.IsAffineOpen U),
        ∃ V, ∃ (_ : AlgebraicGeometry.IsAffineOpen V) (_ : x ∈ V)
          (e : V ≤ (TopologicalSpace.Opens.map P_1.hom.base).obj U),
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appLE P_1.hom U V e)) := by
    intro ι hOpen hOver x hx
    let _ := hOpen
    let V : P_1.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι
    have _ : AlgebraicGeometry.IsAffine A_1 := by
      change AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      infer_instance
    have hAff_V : AlgebraicGeometry.IsAffineOpen V :=
      AlgebraicGeometry.isAffineOpen_opensRange ι
    let hle_V : V ≤ (TopologicalSpace.Opens.map P_1.hom.base).obj ⊤ := fun _ _ => trivial
    refine ⟨⊤, isAffineOpen_top S_k, V, hAff_V, hx, hle_V, ?_⟩
    let e_sch : A_1 ≅ V.toScheme := ι.isoOpensRange
    let e_ι_app : P_1.left.presheaf.obj (Opposite.op V) ≅
        V.toScheme.presheaf.obj (Opposite.op ⊤) :=
      CategoryTheory.asIso
        (AlgebraicGeometry.Scheme.Hom.appLE V.ι V ⊤ (fun y _ => y.2))
    let e_appTop : V.toScheme.presheaf.obj (Opposite.op ⊤) ≅
        A_1.presheaf.obj (Opposite.op ⊤) :=
      { hom := e_sch.hom.appTop
        inv := e_sch.inv.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    let Φ_ring : P_1.left.presheaf.obj (Opposite.op V) ≅ CommRingCat.of (Polynomial k) :=
      e_ι_app ≪≫ e_appTop ≪≫ AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))
    have h_app_eq : e_ι_app.hom ≫ e_sch.hom.appTop =
        AlgebraicGeometry.Scheme.Hom.appLE ι V ⊤ (fun y _ => ⟨y, rfl⟩) :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e_sch.hom V.ι V ⊤ ⊤
        (fun y _ => y.2) (fun _ _ => trivial)).trans
        (h_appLE_congr (e_sch.hom ≫ V.ι) ι
          (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι) _ _)
    have hΦ_hom_eq : Φ_ring.hom =
        AlgebraicGeometry.Scheme.Hom.appLE ι V ⊤ (fun y _ => ⟨y, rfl⟩) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom :=
      (Category.assoc e_ι_app.hom e_sch.hom.appTop
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom).symm.trans
        (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom)
          h_app_eq)
    have h_comp1 : P_1.hom.appLE ⊤ V hle_V ≫ ι.appLE V ⊤ (fun y _ => ⟨y, rfl⟩) =
        f_A1.appTop := by
      have h1 := (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι P_1.hom ⊤ V ⊤
        hle_V (fun y _ => ⟨y, rfl⟩)).trans
        (h_appLE_congr (O₂ := ⊤) (O₁ := ⊤) (ι ≫ P_1.hom) f_A1 hOver
          (fun _ _ => trivial) (fun _ _ => trivial))
      have h2 : f_A1.appLE ⊤ ⊤ (fun _ _ => trivial) = f_A1.appTop := by
        change f_A1.app ⊤ ≫
          A_1.presheaf.map (𝟙 (Opposite.op (⊤ : TopologicalSpace.Opens ↥A_1))) = f_A1.app ⊤
        erw [A_1.presheaf.map_id, Category.comp_id]
      exact h1.trans h2
    have h_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        (f_A1.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom) =
        CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) :=
      (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
        (AlgebraicGeometry.Scheme.ΓSpecIso_naturality
          (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))).trans
        (CategoryTheory.Iso.inv_hom_id_assoc _ _)
    have h_chain : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        P_1.hom.appLE ⊤ V hle_V ≫ Φ_ring.hom =
        CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) := by
      rw [hΦ_hom_eq, ← Category.assoc (P_1.hom.appLE ⊤ V hle_V), h_comp1]
      exact h_nat
    have happ_eq : P_1.hom.appLE ⊤ V hle_V =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
          CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) ≫ Φ_ring.inv := by
      calc
        P_1.hom.appLE ⊤ V hle_V
          = 𝟙 _ ≫ P_1.hom.appLE ⊤ V hle_V ≫ 𝟙 _ := by
              rw [Category.comp_id, Category.id_comp]
        _ = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv) ≫
              P_1.hom.appLE ⊤ V hle_V ≫ (Φ_ring.hom ≫ Φ_ring.inv) := by
              rw [CategoryTheory.Iso.hom_inv_id, CategoryTheory.Iso.hom_inv_id]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                P_1.hom.appLE ⊤ V hle_V ≫ Φ_ring.hom) ≫ Φ_ring.inv := by
              simp only [Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
              CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) ≫ Φ_ring.inv := by
              rw [h_chain]
    rw [happ_eq, CommRingCat.hom_comp, CommRingCat.hom_comp]
    have h1 := (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).1
      (Polynomial.C : k →+* Polynomial k) Φ_ring.symm.commRingCatIsoToRingEquiv hStd_polyC
    exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).2 _
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv h1

  have hSm1 : AlgebraicGeometry.SmoothOfRelativeDimension 1 P_1.hom := by
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro x
    have hx : x ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base := by rw [hTwoChartCov]; trivial
    rcases hx with hx1 | hx0
    · exact hChartStdSmooth ι_P1 hOpen_P1 hOver_P1 x hx1
    · exact hChartStdSmooth ι_inf hOpen_inf hOver_inf x hx0

  obtain ⟨pt₀⟩ : Nonempty ↥S_k := inferInstance
  have hInt_A1 : AlgebraicGeometry.IsIntegral A_1 :=
    @AlgebraicGeometry.instIsIntegralSpecOfIsDomainCarrier
      (CommRingCat.of (Polynomial k)) (inferInstance : IsDomain (Polynomial k))
  have hInt1 : AlgebraicGeometry.IsIntegral P_1.left := by
    let v_P1 : Bool → (A_1 ⟶ P_1.left) := fun b => cond b ι_inf ι_P1
    refine hIntegralOfPointedCover hInt_A1 v_P1
      (fun b => by cases b; exact hOpen_P1; exact hOpen_inf)
      (by
