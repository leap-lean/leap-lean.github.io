    exact CategoryTheory.Abelian.isIso_of_epi_of_isIso_of_isIso_of_mono hR₁ hR₂ Φ hφ₀ hφ₁ hφ₃ hφ₄
  · intro A B hA hB φ
    exact ⟨⟨0, hA.eq_of_src _ _, hB.eq_of_tgt _ _⟩⟩
  · intro F ℓ m' hF μ_ℓ K i M p
    let j : M ⟶ F := CategoryTheory.Limits.image.ι μ_ℓ
    have hfac : p ≫ j = μ_ℓ := CategoryTheory.Limits.image.fac μ_ℓ
    have h0 : i ≫ p = 0 := by
      apply (CategoryTheory.cancel_mono j).mp
      rw [CategoryTheory.Category.assoc, hfac, CategoryTheory.Limits.kernel.condition μ_ℓ,
        CategoryTheory.Limits.zero_comp]
    refine ⟨h0, ?_, ?_, ?_⟩
    · let S := CategoryTheory.ShortComplex.mk i p h0
      have hlim : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι i h0) :=
        CategoryTheory.Limits.KernelFork.IsLimit.ofι i h0
          (fun {W} t ht => CategoryTheory.Limits.kernel.lift μ_ℓ t (by
            rw [← hfac, ← CategoryTheory.Category.assoc, ht, CategoryTheory.Limits.zero_comp]))
          (fun {W} t ht => CategoryTheory.Limits.kernel.lift_ι μ_ℓ t _)
          (fun {W} t ht b hb => by
            apply (CategoryTheory.cancel_mono i).mp
            rw [hb, CategoryTheory.Limits.kernel.lift_ι])
      have hex : S.Exact := S.exact_of_f_is_kernel hlim
      exact CategoryTheory.ShortComplex.ShortExact.mk' hex inferInstance inferInstance
    · apply (CategoryTheory.cancel_mono i).mp
      calc
        (ℓ • CategoryTheory.CategoryStruct.id K) ≫ i
          = ℓ • (CategoryTheory.CategoryStruct.id K ≫ i) :=
              CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = ℓ • i := by rw [CategoryTheory.Category.id_comp]
        _ = ℓ • (i ≫ CategoryTheory.CategoryStruct.id F) := by
              rw [CategoryTheory.Category.comp_id]
        _ = i ≫ (ℓ • CategoryTheory.CategoryStruct.id F) :=
              (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = i ≫ μ_ℓ := rfl
        _ = 0 := CategoryTheory.Limits.kernel.condition μ_ℓ
        _ = 0 ≫ i := CategoryTheory.Limits.zero_comp.symm
    · apply (CategoryTheory.cancel_mono j).mp
      apply (CategoryTheory.cancel_epi p).mp
      calc
        p ≫ ((m' • CategoryTheory.CategoryStruct.id M) ≫ j)
          = p ≫ (m' • (CategoryTheory.CategoryStruct.id M ≫ j)) := by
              rw [CategoryTheory.Preadditive.nsmul_comp]
        _ = p ≫ (m' • j) := by rw [CategoryTheory.Category.id_comp]
        _ = m' • (p ≫ j) := CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = m' • μ_ℓ := by rw [hfac]
        _ = m' • (ℓ • CategoryTheory.CategoryStruct.id F) := rfl
        _ = (ℓ * m') • CategoryTheory.CategoryStruct.id F :=
              (mul_nsmul (CategoryTheory.CategoryStruct.id F) ℓ m').symm
        _ = 0 := hF
        _ = p ≫ (0 ≫ j) := by
              rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

theorem weil_pbc_sec_mod_prime_dim_shift_isIso (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
    (hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f)).IsRightAdjoint)
    (hExact_pb : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f) (@hr_all X₁ X₂ f)
      pb.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb)
    {X₀ S₀ S' X' : AlgebraicGeometry.Scheme.{u}}
    (f₀ : Quiver.Hom X₀ S₀) (g : Quiver.Hom S' S₀)
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X₀)
    (hpb : CategoryTheory.IsPullback g' f' f₀ g)
    (hPBC_ℓ : WeilCanonicalModPrimePBC ℓ f₀) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let pf_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h)
    let pb_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
    let adj_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
    let U_sh := CategoryTheory.Sheaf.composeAndSheafify X₀.smallEtaleTopology
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))) AddCommGrpCat.{u})
    let bc₀_sq := fun (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}) =>
      let B_f := weilEtaleSitePullback f₀
      let B_g := weilEtaleSitePullback g
      let B_f' := weilEtaleSitePullback f'
      let B_g' := weilEtaleSitePullback g'
      let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_f B_g')
          (CategoryTheory.Functor.comp B_g B_f') :=
        CategoryTheory.Iso.trans
          (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g' f₀))
          (CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb.w)
            (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))
      letI : (CategoryTheory.Functor.comp B_f B_g').IsContinuous
          S₀.smallEtaleTopology X'.smallEtaleTopology :=
        @CategoryTheory.Functor.isContinuous_comp _ _ _ _ _ _ B_f B_g'
          S₀.smallEtaleTopology X₀.smallEtaleTopology X'.smallEtaleTopology
          (@hc_all X₀ S₀ f₀) (@hc_all X' X₀ g')
      letI : (CategoryTheory.Functor.comp B_g B_f').IsContinuous
          S₀.smallEtaleTopology X'.smallEtaleTopology :=
        @CategoryTheory.Functor.isContinuous_comp _ _ _ _ _ _ B_g B_f'
          S₀.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
          (@hc_all S' S₀ g) (@hc_all X' S' f')
      let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun
        AddCommGrpCat.{u} S₀.smallEtaleTopology X'.smallEtaleTopology
      ((adj_of g).homEquiv ((pf_of f₀).obj F) ((pf_of f').obj ((pb_of g').obj F))).symm
        (CategoryTheory.CategoryStruct.comp
          ((pf_of f₀).map ((adj_of g').unit.app F))
          (e_pf.hom.app ((pb_of g').obj F)))
    (∀ (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ∃ (I : CategoryTheory.Sheaf X₀.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
        (_ : CategoryTheory.Injective I)
        (Q : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
        (u : F ⟶ U_sh.obj I) (v : U_sh.obj I ⟶ Q) (huv : u ≫ v = 0),
        ℓ • CategoryTheory.CategoryStruct.id (U_sh.obj I) = 0 ∧
        ℓ • CategoryTheory.CategoryStruct.id Q = 0 ∧
        (CategoryTheory.ShortComplex.mk u v huv).ShortExact) →
    (∀ (I : CategoryTheory.Sheaf X₀.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
      [CategoryTheory.Injective I] (p : ℕ), 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ p (U_sh.obj I))) →
    ∀ (bc_sq : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
          Quiver.Hom ((pb_of g).obj (weilEtaleHigherDirectImage f₀ q F))
            (weilEtaleHigherDirectImage f' q ((pb_of g').obj F)))
      (e0_f : ∀ (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Iso (weilEtaleHigherDirectImage f₀ 0 F) ((pf_of f₀).obj F))
      (e0_f' : ∀ (G : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Iso (weilEtaleHigherDirectImage f' 0 G) ((pf_of f').obj G))
      (δ_conn : ∀ {Y B : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y B)
          (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE : SC.ShortExact) (q : ℕ),
          Quiver.Hom (weilEtaleHigherDirectImage h q SC.X₃)
            (weilEtaleHigherDirectImage h (q + 1) SC.X₁)),
      (∀ (q : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom F₁ F₂),
        CategoryTheory.CategoryStruct.comp
          ((pb_of g).map (weilTopDegKummerHigherDirectImageMap f₀ q φ)) (bc_sq q F₂) =
        CategoryTheory.CategoryStruct.comp
          (bc_sq q F₁) (weilTopDegKummerHigherDirectImageMap f' q ((pb_of g').map φ))) →
      (∀ (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
        bc_sq 0 F = CategoryTheory.CategoryStruct.comp ((pb_of g).map (e0_f F).hom)
          (CategoryTheory.CategoryStruct.comp (bc₀_sq F) (e0_f' ((pb_of g').obj F)).inv)) →
      (∀ {Y B : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y B)
          (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE : SC.ShortExact) (q : ℕ),
        (∃ h0 : CategoryTheory.CategoryStruct.comp
              (weilTopDegKummerHigherDirectImageMap h q SC.g) (δ_conn h SC hSE q) = 0,
          (CategoryTheory.ShortComplex.mk
            (weilTopDegKummerHigherDirectImageMap h q SC.g) (δ_conn h SC hSE q) h0).Exact) ∧
        (∃ h0 : CategoryTheory.CategoryStruct.comp
              (δ_conn h SC hSE q) (weilTopDegKummerHigherDirectImageMap h (q + 1) SC.f) = 0,
          (CategoryTheory.ShortComplex.mk
            (δ_conn h SC hSE q) (weilTopDegKummerHigherDirectImageMap h (q + 1) SC.f) h0).Exact)) →
      (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE : SC.ShortExact) (q : ℕ),
        letI : (pb_of g').Additive := (hExact_pb g').1
        letI : CategoryTheory.Limits.PreservesFiniteLimits (pb_of g') := (hExact_pb g').2.1
        letI : CategoryTheory.Limits.PreservesFiniteColimits (pb_of g') := (hExact_pb g').2.2
        CategoryTheory.CategoryStruct.comp ((pb_of g).map (δ_conn f₀ SC hSE q))
          (bc_sq (q + 1) SC.X₁) =
        CategoryTheory.CategoryStruct.comp (bc_sq q SC.X₃)
          (δ_conn f' (SC.map (pb_of g')) (hSE.map_of_exact (pb_of g')) q)) →
      ∀ (q : ℕ) (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        CategoryTheory.IsIso (bc_sq q F) :=
by
  intro pf_of pb_of adj_of U_sh bc₀_sq hRes_ℓ hVanish_ℓ bc_sq e0_f e0_f' δ_conn
    hbc_nat hbc_zero hExact_δ hbc_δ_comm
  letI : (pb_of g).Additive := (hExact_pb g).1
  letI : CategoryTheory.Limits.PreservesFiniteLimits (pb_of g) := (hExact_pb g).2.1
  letI : CategoryTheory.Limits.PreservesFiniteColimits (pb_of g) := (hExact_pb g).2.2
  letI : (pb_of g').Additive := (hExact_pb g').1
  letI : CategoryTheory.Limits.PreservesFiniteLimits (pb_of g') := (hExact_pb g').2.1
  letI : CategoryTheory.Limits.PreservesFiniteColimits (pb_of g') := (hExact_pb g').2.2
  obtain ⟨hc_f, hc_g, hc_f', hc_g', hr_g, hr_g', hBC₀_prime, hInj_prime⟩ :=
    hPBC_ℓ S' X' g f' g' hpb
  obtain rfl : hc_f = @hc_all X₀ S₀ f₀ := Subsingleton.elim _ _
  obtain rfl : hc_g = @hc_all S' S₀ g := Subsingleton.elim _ _
  obtain rfl : hc_f' = @hc_all X' S' f' := Subsingleton.elim _ _
  obtain rfl : hc_g' = @hc_all X' X₀ g' := Subsingleton.elim _ _
  obtain rfl : hr_g = @hr_all S' S₀ g := Subsingleton.elim _ _
  obtain rfl : hr_g' = @hr_all X' X₀ g' := Subsingleton.elim _ _
  have hIso_of_isZero :
      ∀ {A B : CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}},
        CategoryTheory.Limits.IsZero A →
        CategoryTheory.Limits.IsZero B →
        ∀ (φ : A ⟶ B), CategoryTheory.IsIso φ :=
    fun hA hB _ => ⟨⟨0, hA.eq_of_src _ _, hB.eq_of_tgt _ _⟩⟩
  intro q
  induction q with
  | zero =>
    intro F hF_tor
    rw [hbc_zero F]
    have h1 : CategoryTheory.IsIso ((pb_of g).map (e0_f F).hom) :=
      ((pb_of g).mapIso (e0_f F)).isIso_hom
    have h2 : CategoryTheory.IsIso (bc₀_sq F) := hBC₀_prime F hF_tor
    have h3 : CategoryTheory.IsIso (e0_f' ((pb_of g').obj F)).inv :=
      (e0_f' ((pb_of g').obj F)).isIso_inv
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ h1
      (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ h2 h3)
  | succ q ih =>
    intro F hF_tor
    obtain ⟨I, hInjI, Q, u, v, huv, hJI_tor, hQ_tor, hSE⟩ := hRes_ℓ F hF_tor
    letI : CategoryTheory.Injective I := hInjI
    let J_I := U_sh.obj I
    let SC := CategoryTheory.ShortComplex.mk u v huv
    let hSE' : (SC.map (pb_of g')).ShortExact := hSE.map_of_exact (pb_of g')
    let A₃ : CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u} :=
      (pb_of g).obj (weilEtaleHigherDirectImage f₀ (q + 1) J_I)
    let B₃ : CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u} :=
      weilEtaleHigherDirectImage f' (q + 1) ((pb_of g').obj J_I)
    have hZero_f : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ (q + 1) J_I) :=
      hVanish_ℓ I (q + 1) (Nat.le_add_left 1 q)
    have hZero_A3 : CategoryTheory.Limits.IsZero A₃ := (pb_of g).map_isZero hZero_f
    have hZero_B3 : CategoryTheory.Limits.IsZero B₃ :=
      hInj_prime I (q + 1) (Nat.le_add_left 1 q)
    obtain ⟨⟨h0_top₁, hEx_top₁⟩, ⟨h0_top₂, hEx_top₂⟩⟩ := hExact_δ f₀ SC hSE q
    obtain ⟨⟨h0_bot₁, hEx_bot₁⟩, ⟨h0_bot₂, hEx_bot₂⟩⟩ :=
      hExact_δ f' (SC.map (pb_of g')) hSE' q
    let S_top₁ := (CategoryTheory.ShortComplex.mk
      (weilTopDegKummerHigherDirectImageMap f₀ q v)
      (δ_conn f₀ SC hSE q) h0_top₁).map (pb_of g)
    let S_top₂ := (CategoryTheory.ShortComplex.mk
      (δ_conn f₀ SC hSE q)
      (weilTopDegKummerHigherDirectImageMap f₀ (q + 1) u) h0_top₂).map (pb_of g)
    let S_top₃ := CategoryTheory.ShortComplex.mk S_top₂.g (0 : A₃ ⟶ A₃)
      CategoryTheory.Limits.comp_zero
    have hEx_pb_top₁ : S_top₁.Exact := hEx_top₁.map (pb_of g)
    have hEx_pb_top₂ : S_top₂.Exact := hEx_top₂.map (pb_of g)
    have hEx_top₃ : S_top₃.Exact :=
      CategoryTheory.ShortComplex.exact_of_isZero_X₂ S_top₃ hZero_A3
    let R₁ : CategoryTheory.ComposableArrows
        (CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}) 4 :=
      CategoryTheory.ComposableArrows.mk₄ S_top₁.f S_top₁.g S_top₂.g (0 : A₃ ⟶ A₃)
    have hR₁ : R₁.Exact :=
      CategoryTheory.ComposableArrows.exact_of_δ₀ hEx_pb_top₁.exact_toComposableArrows
        (CategoryTheory.ComposableArrows.exact_of_δ₀ hEx_pb_top₂.exact_toComposableArrows
          hEx_top₃.exact_toComposableArrows)
    let S_bot₁ := CategoryTheory.ShortComplex.mk
      (weilTopDegKummerHigherDirectImageMap f' q ((pb_of g').map v))
      (δ_conn f' (SC.map (pb_of g')) hSE' q) h0_bot₁
    let S_bot₂ := CategoryTheory.ShortComplex.mk
      (δ_conn f' (SC.map (pb_of g')) hSE' q)
      (weilTopDegKummerHigherDirectImageMap f' (q + 1) ((pb_of g').map u)) h0_bot₂
    let S_bot₃ := CategoryTheory.ShortComplex.mk S_bot₂.g (0 : B₃ ⟶ B₃)
      CategoryTheory.Limits.comp_zero
    have hEx_bot₃ : S_bot₃.Exact :=
      CategoryTheory.ShortComplex.exact_of_isZero_X₂ S_bot₃ hZero_B3
    let R₂ : CategoryTheory.ComposableArrows
        (CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}) 4 :=
      CategoryTheory.ComposableArrows.mk₄ S_bot₁.f S_bot₁.g S_bot₂.g (0 : B₃ ⟶ B₃)
    have hR₂ : R₂.Exact :=
      CategoryTheory.ComposableArrows.exact_of_δ₀ hEx_bot₁.exact_toComposableArrows
        (CategoryTheory.ComposableArrows.exact_of_δ₀ hEx_bot₂.exact_toComposableArrows
          hEx_bot₃.exact_toComposableArrows)
    let φ₀ := bc_sq q J_I
    let φ₁ := bc_sq q Q
    let φ₂ := bc_sq (q + 1) F
    let φ₃ := bc_sq (q + 1) J_I
    let Φ : R₁ ⟶ R₂ :=
      CategoryTheory.ComposableArrows.homMk₄ φ₀ φ₁ φ₂ φ₃ φ₃
        (hbc_nat q v) (hbc_δ_comm SC hSE q) (hbc_nat (q + 1) u) (hZero_A3.eq_of_src _ _)
    have hIso_0 : CategoryTheory.IsIso φ₀ := ih J_I hJI_tor
    have hIso_3 : CategoryTheory.IsIso φ₃ := hIso_of_isZero hZero_A3 hZero_B3 φ₃
    have h0_epi : CategoryTheory.Epi (CategoryTheory.ComposableArrows.app' Φ 0 (by omega)) :=
      @CategoryTheory.IsIso.epi_of_iso _ _ _ _ φ₀ hIso_0
    have h1_iso : CategoryTheory.IsIso (CategoryTheory.ComposableArrows.app' Φ 1 (by omega)) :=
      ih Q hQ_tor
    have h3_iso : CategoryTheory.IsIso (CategoryTheory.ComposableArrows.app' Φ 3 (by omega)) :=
      hIso_3
    have h4_mono : CategoryTheory.Mono (CategoryTheory.ComposableArrows.app' Φ 4 (by omega)) :=
      @CategoryTheory.IsIso.mono_of_iso _ _ _ _ φ₃ hIso_3
    exact CategoryTheory.Abelian.isIso_of_epi_of_isIso_of_isIso_of_mono
      hR₁ hR₂ Φ h0_epi h1_iso h3_iso h4_mono

theorem weil_etale_torsion_pbc_isIso_of_section_bc (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
    (hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f)).IsRightAdjoint)
    (hExact_pb : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f) (@hr_all X₁ X₂ f)
      pb.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb)
    (hPBC_prime : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
