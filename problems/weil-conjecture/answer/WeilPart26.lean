        haveI : AlgebraicGeometry.Etale w₁_sch := hEt_of_etale_hom w₁_Pd
        haveI : AlgebraicGeometry.Etale (Fgt_Vbar.obj V₂).hom := V₂.prop
        let V' : E.V_bar.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (w₁_sch ≫ (Fgt_Vbar.obj V₂).hom) inferInstance
        let w₁ : V' ⟶ V₂ :=
          CategoryTheory.MorphismProperty.Over.homMk w₁_sch rfl trivial

        
