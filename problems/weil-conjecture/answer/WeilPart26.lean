            epi_g := CategoryTheory.ShortComplex.Exact.epi_kernelLift hEx_r }
      have hDeg0 : ∀ (F : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR F (n + 1) →+ ZMod m),
          ∃! f : CategoryTheory.Abelian.Ext.{u} F oneR 0,
            ∀ α : CategoryTheory.Abelian.Ext.{u} oneR F (n + 1),
              τ_N (α.comp f (Nat.add_zero (n + 1))) = φ α := by
        intro F φ
        let μ_φ : ↑((C₀ (n + 1)).obj F) →ₗ[R] R :=
          addHomToLinear (φ.comp ((Υ₀ F (n + 1)).comp (kerTopHom F)))
        have hμ_d : μ_φ.comp (((d_C₀ n).app F).hom) = 0 := by
          apply LinearMap.ext
          intro u
          apply ULift.ext
          let w := kerTopHom F ((((d_C₀ n).app F).hom) u)
          have hw0 : Υ₀ F (n + 1) w = 0 := (hΥ_ker n F w).mpr ⟨u, rfl⟩
          change φ (Υ₀ F (n + 1) w) = 0
          rw [hw0, map_zero]
        have hΨ_ker : CategoryTheory.CategoryStruct.comp (Ψ (n + 1) F μ_φ) (diffDual n) = 0 := by
          rw [hΨ_diff, hμ_d, hΨ_zero]
        let b_hom : Quiver.Hom F (B n) :=
          CategoryTheory.Limits.kernel.lift (diffDual n) (Ψ (n + 1) F μ_φ) hΨ_ker
        let f_hom : Quiver.Hom F oneR :=
          CategoryTheory.CategoryStruct.comp b_hom (CategoryTheory.inv e_dual)
        have hf_tS : CategoryTheory.CategoryStruct.comp f_hom t_S = Ψ (n + 1) F μ_φ := by
          dsimp [f_hom, b_hom]
          rw [← he_dual_κ, CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (CategoryTheory.inv e_dual) e_dual (κ n),
            CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp,
            CategoryTheory.Limits.kernel.lift_ι]
        refine ⟨CategoryTheory.Abelian.Ext.mk₀ f_hom, ?_, ?_⟩
        · intro α
          obtain ⟨w, rfl⟩ := hΥ_surj (n + 1) F α
          rw [← hPair F f_hom w, hf_tS, (Ψ (n + 1) F).symm_apply_apply]
          rfl
        · intro f' hf'
          let g' : Quiver.Hom F oneR := CategoryTheory.Abelian.Ext.addEquiv₀ f'
          have hg'_mk : CategoryTheory.Abelian.Ext.mk₀ g' = f' :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply f'
          have h_symm_eq : (Ψ (n + 1) F).symm (CategoryTheory.CategoryStruct.comp g' t_S) =
              (Ψ (n + 1) F).symm (CategoryTheory.CategoryStruct.comp f_hom t_S) := by
            apply LinearMap.ext
            intro v
            apply ULift.ext
            let w := kerTopHom F v
            change ((((Ψ (n + 1) F).symm (CategoryTheory.CategoryStruct.comp g' t_S)) w.1).down) =
              ((((Ψ (n + 1) F).symm (CategoryTheory.CategoryStruct.comp f_hom t_S)) w.1).down)
            rw [hPair F g' w, hg'_mk, hf' (Υ₀ F (n + 1) w), hf_tS,
              (Ψ (n + 1) F).symm_apply_apply]
            rfl
          have hg'_eq : g' = f_hom :=
            (CategoryTheory.cancel_mono t_S).mp ((Ψ (n + 1) F).symm.injective h_symm_eq)
          rw [← hg'_mk, hg'_eq]
      have hVan : ∀ (A : 𝒞),
          (∀ k : ℕ, 1 ≤ k → Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR A k)) →
          ∀ q : ℕ, q < n + 1 → Subsingleton (CategoryTheory.Abelian.Ext.{u} A oneR q) := by
        intro A hA
        have hSub_Bs1 : ∀ s : ℕ, s < n →
            Subsingleton (CategoryTheory.Abelian.Ext.{u} A (B (s + 1)) 1) := by
          intro s hs
          refine Subsingleton.intro fun x₁ y₁ => ?_
          suffices hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} A (B (s + 1)) 1, z = 0 by
            rw [hzero x₁, hzero y₁]
          intro z
          have hz_inj : z.comp (CategoryTheory.Abelian.Ext.mk₀ (Sc_step s).f)
              (Nat.add_zero 1) = 0 :=
            @Subsingleton.elim _ (hInjSub (s + 2) A 1 (le_refl 1)) _ 0
          obtain ⟨x₀, hx₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            A (hSc_step s hs) z hz_inj (Nat.zero_add 1)
          let g : Quiver.Hom A (B s) := CategoryTheory.Abelian.Ext.addEquiv₀ x₀
          have hg_mk : CategoryTheory.Abelian.Ext.mk₀ g = x₀ :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x₀
          let lam : ↑((C₀ (s + 1)).obj A) →ₗ[R] R :=
            (Ψ (s + 1) A).symm (CategoryTheory.CategoryStruct.comp g (κ s))
          have hlam_d : lam.comp (((d_C₀ s).app A).hom) = 0 := by
            apply (Ψ s A).injective
            rw [← hΨ_diff, (Ψ (s + 1) A).apply_symm_apply, hΨ_zero,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.condition,
              CategoryTheory.Limits.comp_zero]
          have hker_le : LinearMap.ker (((d_C₀ (s + 1)).app A).hom) ≤ LinearMap.ker lam := by
            intro w hw
            rw [LinearMap.mem_ker]
            have hΥ0 : Υ₀ A (s + 1) ⟨w, hw⟩ = 0 :=
              @Subsingleton.elim _ (hA (s + 1) (by omega)) _ 0
            obtain ⟨u, hu⟩ := (hΥ_ker s A ⟨w, hw⟩).mp hΥ0
            change (((d_C₀ s).app A).hom) u = w at hu
            change lam w = 0
            rw [← hu]
            exact LinearMap.congr_fun hlam_d u
          obtain ⟨μ, hμ⟩ := hExtend (((d_C₀ (s + 1)).app A).hom) lam hker_le
          let h_lift : Quiver.Hom A (𝒥 (s + 2)) := Ψ (s + 2) A μ
          have hh_q : CategoryTheory.CategoryStruct.comp h_lift (q_step s) = g := by
            have _ := hκ_mono s
            rw [← CategoryTheory.cancel_mono (κ s), CategoryTheory.Category.assoc, hq_step_κ]
            dsimp [h_lift]
            rw [hΨ_diff, hμ, (Ψ (s + 1) A).apply_symm_apply]
          rw [← hx₀, ← hg_mk, ← hh_q, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ h_lift)
              (CategoryTheory.Abelian.Ext.mk₀ (q_step s))
              (hSc_step s hs).extClass
              (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1)]
          have hqε : (CategoryTheory.Abelian.Ext.mk₀ (q_step s)).comp
              (hSc_step s hs).extClass (Nat.zero_add 1) = 0 :=
            (hSc_step s hs).comp_extClass
          rw [hqε, CategoryTheory.Abelian.Ext.comp_zero]
        have hSub_Br : ∀ r : ℕ, r ≤ n → ∀ q : ℕ, 1 ≤ q → q ≤ r →
            Subsingleton (CategoryTheory.Abelian.Ext.{u} A (B r) q) := by
          intro r
          induction r with
          | zero =>
            intro _ q hq1 hq0
            omega
          | succ s ih =>
            intro hs1 q hq1 hqs1
            have hs : s < n := by omega
            cases q with
            | zero => omega
            | succ q' =>
              by_cases hq'0 : q' = 0
              · subst hq'0
                exact hSub_Bs1 s hs
              · have hq'1 : 1 ≤ q' := by omega
                have hq's : q' ≤ s := by omega
                have hIH := ih (by omega) q' hq'1 hq's
                refine Subsingleton.intro fun x₁ y₁ => ?_
                suffices hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} A (B (s + 1)) (q' + 1),
                    z = 0 by
                  rw [hzero x₁, hzero y₁]
                intro z
                have hz_inj : z.comp (CategoryTheory.Abelian.Ext.mk₀ (Sc_step s).f)
                    (Nat.add_zero (q' + 1)) = 0 :=
                  @Subsingleton.elim _ (hInjSub (s + 2) A (q' + 1) (by omega)) _ 0
                obtain ⟨w, hw⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
                  A (hSc_step s hs) z hz_inj (Nat.add_one q')
                have hw0 : w = 0 := @Subsingleton.elim _ hIH w 0
                rw [← hw, hw0, CategoryTheory.Abelian.Ext.zero_comp]
        intro q hq_lt
        cases q with
        | zero =>
          refine Subsingleton.intro fun f₁ f₂ => ?_
          obtain ⟨f₀, _, hf₀_uniq⟩ := hDeg0 A 0
          have hSub_top : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR A (n + 1)) :=
            hA (n + 1) (by omega)
          have hf₁ : f₁ = f₀ := hf₀_uniq f₁ (fun α => by
            rw [@Subsingleton.elim _ hSub_top α 0, CategoryTheory.Abelian.Ext.zero_comp,
              map_zero, AddMonoidHom.zero_apply])
          have hf₂ : f₂ = f₀ := hf₀_uniq f₂ (fun α => by
            rw [@Subsingleton.elim _ hSub_top α 0, CategoryTheory.Abelian.Ext.zero_comp,
              map_zero, AddMonoidHom.zero_apply])
          exact hf₁.trans hf₂.symm
        | succ q' =>
          have hBn := hSub_Br n (le_refl n) (q' + 1) (by omega) (by omega)
          refine Subsingleton.intro fun x₁ y₁ => ?_
          have h1 : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual) (Nat.add_zero (q' + 1)) =
              y₁.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual) (Nat.add_zero (q' + 1)) :=
            @Subsingleton.elim _ hBn _ _
          have h2 := congrArg
            (fun u : CategoryTheory.Abelian.Ext.{u} A (B n) (q' + 1) =>
              u.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual))
                (Nat.add_zero (q' + 1))) h1
          simpa only [CategoryTheory.Abelian.Ext.comp_assoc _
              (CategoryTheory.Abelian.Ext.mk₀ e_dual)
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual))
              (Nat.add_zero (q' + 1)) (Nat.add_zero 0) (Nat.add_zero (q' + 1)),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id] using h2
      refine ⟨hDeg0, hVan, ?_⟩
      let e_Υ₀ : ∀ G : 𝒞,
          ↥(LinearMap.ker (((d_C₀ 0).app G).hom)) ≃+ CategoryTheory.Abelian.Ext.{u} oneR G 0 :=
        fun G => AddEquiv.ofBijective (Υ₀ G 0) ⟨hΥ_inj0 G, hΥ_surj 0 G⟩
      let Ω₀ : ∀ G : 𝒞, Quiver.Hom G (𝒥 0) →+ CategoryTheory.Abelian.Ext.{u} G (B 0) 1 :=
        fun G => AddMonoidHom.mk'
          (fun f => (CategoryTheory.Abelian.Ext.mk₀ f).comp ε₀ (Nat.zero_add 1))
          (fun f₁ f₂ => by
            rw [CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.add_comp])
      have hΩ₀_surj : ∀ G : 𝒞, Function.Surjective (Ω₀ G) := by
        intro G x
        have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ Sc₀.f) (Nat.add_zero 1) = 0 :=
          @Subsingleton.elim _ (hInjSub 1 G 1 (le_refl 1)) _ 0
        obtain ⟨x₀, hx₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          G hSc₀ x hx0 (Nat.zero_add 1)
        refine ⟨CategoryTheory.Abelian.Ext.addEquiv₀ x₀, ?_⟩
        change (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ x₀)).comp
          ε₀ (Nat.zero_add 1) = x
        have hx₀_mk : CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.Abelian.Ext.addEquiv₀ x₀) = x₀ :=
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x₀
        rw [hx₀_mk]
        exact hx₀
      have hΩ₀_ker : ∀ (G : 𝒞) (f : Quiver.Hom G (𝒥 0)),
          Ω₀ G f = 0 ↔ ∃ g : Quiver.Hom G (𝒥 1),
            CategoryTheory.CategoryStruct.comp g (diffDual 0) = f := by
        intro G f
        constructor
        · intro hf0
          obtain ⟨g₀, hg₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            G hSc₀ (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.zero_add 1) hf0
          let g : Quiver.Hom G (𝒥 1) := CategoryTheory.Abelian.Ext.addEquiv₀ g₀
          have hg_mk : CategoryTheory.Abelian.Ext.mk₀ g = g₀ :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply g₀
          rw [← hg_mk, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hg₀
          exact ⟨g, CategoryTheory.Abelian.Ext.addEquiv₀.symm.injective hg₀⟩
        · rintro ⟨g, rfl⟩
          change (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.comp g (diffDual 0))).comp ε₀ (Nat.zero_add 1) = 0
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ g)
              (CategoryTheory.Abelian.Ext.mk₀ (diffDual 0))
              ε₀ (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1)]
          have hdε : (CategoryTheory.Abelian.Ext.mk₀ (diffDual 0)).comp ε₀ (Nat.zero_add 1) = 0 :=
            hSc₀.comp_extClass
          rw [hdε, CategoryTheory.Abelian.Ext.comp_zero]
      let Θ₀ : ∀ G : 𝒞,
          Quiver.Hom G (𝒥 0) →+ (CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m) :=
        fun G => AddMonoidHom.mk'
          (fun f => AddMonoidHom.mk'
            (fun α => ((((Ψ 0 G).symm f) ((e_Υ₀ G).symm α).1).down))
            (fun α₁ α₂ => by
              rw [map_add]
              change ((((Ψ 0 G).symm f) (((e_Υ₀ G).symm α₁).1 + ((e_Υ₀ G).symm α₂).1)).down) = _
              rw [map_add]
              rfl))
          (fun f₁ f₂ => by
            ext α
            simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply]
            rw [hΨ_symm_add]
            rfl)
      have hΘ₀_surj : ∀ G : 𝒞, Function.Surjective (Θ₀ G) := by
        intro G φ
        let K₀ := LinearMap.ker (((d_C₀ 0).app G).hom)
        let φ_lin : ↥K₀ →ₗ[R] R := addHomToLinear (φ.comp (Υ₀ G 0))
        obtain ⟨lam, hlam⟩ := hInjR.out K₀.subtype Subtype.val_injective φ_lin
        refine ⟨Ψ 0 G lam, ?_⟩
        ext α
        change ((((Ψ 0 G).symm (Ψ 0 G lam)) ((e_Υ₀ G).symm α).1).down) = φ α
        have hlam_ap : lam ((e_Υ₀ G).symm α).1 = φ_lin ((e_Υ₀ G).symm α) :=
          hlam ((e_Υ₀ G).symm α)
        rw [(Ψ 0 G).symm_apply_apply, hlam_ap]
        change φ (Υ₀ G 0 ((e_Υ₀ G).symm α)) = φ α
        have h_app : Υ₀ G 0 ((e_Υ₀ G).symm α) = α := (e_Υ₀ G).apply_symm_apply α
        rw [h_app]
      have hΘ₀_ker : ∀ (G : 𝒞) (f : Quiver.Hom G (𝒥 0)),
          Θ₀ G f = 0 ↔ Ω₀ G f = 0 := by
        intro G f
        rw [hΩ₀_ker]
        let lam := (Ψ 0 G).symm f
        constructor
        · intro h0
          have hker_le : LinearMap.ker (((d_C₀ 0).app G).hom) ≤ LinearMap.ker lam := by
            intro v hv
            rw [LinearMap.mem_ker]
            apply ULift.ext
            have h_ap := DFunLike.congr_fun h0 (e_Υ₀ G ⟨v, hv⟩)
            change ((lam ((e_Υ₀ G).symm (e_Υ₀ G ⟨v, hv⟩)).1).down) = 0 at h_ap
            rwa [(e_Υ₀ G).symm_apply_apply] at h_ap
          obtain ⟨μ, hμ⟩ := hExtend (((d_C₀ 0).app G).hom) lam hker_le
          refine ⟨Ψ 1 G μ, ?_⟩
          rw [hΨ_diff, hμ, (Ψ 0 G).apply_symm_apply]
        · rintro ⟨g, rfl⟩
          ext α
          change ((((Ψ 0 G).symm (CategoryTheory.CategoryStruct.comp g (diffDual 0)))
              ((e_Υ₀ G).symm α).1).down) = 0
          have hg_eq : g = Ψ 1 G ((Ψ 1 G).symm g) := ((Ψ 1 G).apply_symm_apply g).symm
          conv_lhs => rw [hg_eq, hΨ_diff, (Ψ 0 G).symm_apply_apply]
          change ((((Ψ 1 G).symm g) ((((d_C₀ 0).app G).hom) ((e_Υ₀ G).symm α).1)).down) = 0
          rw [((e_Υ₀ G).symm α).2, map_zero]
          rfl
      have hΘΩ_eq : ∀ (G : 𝒞) (f₁ f₂ : Quiver.Hom G (𝒥 0)),
          Θ₀ G f₁ = Θ₀ G f₂ ↔ Ω₀ G f₁ = Ω₀ G f₂ := by
        intro G f₁ f₂
        rw [← sub_eq_zero, ← map_sub, hΘ₀_ker, map_sub, sub_eq_zero]
      let E₀ : ∀ G : 𝒞,
          (CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m) ≃+
            CategoryTheory.Abelian.Ext.{u} G (B 0) 1 :=
        fun G =>
          { toFun := fun φ => Ω₀ G (Classical.choose (hΘ₀_surj G φ))
            invFun := fun x => Θ₀ G (Classical.choose (hΩ₀_surj G x))
            left_inv := fun φ => by
              let f := Classical.choose (hΘ₀_surj G φ)
              have hf : Θ₀ G f = φ := Classical.choose_spec (hΘ₀_surj G φ)
              let f' := Classical.choose (hΩ₀_surj G (Ω₀ G f))
              have hf' : Ω₀ G f' = Ω₀ G f := Classical.choose_spec (hΩ₀_surj G (Ω₀ G f))
              exact ((hΘΩ_eq G f' f).mpr hf').trans hf
            right_inv := fun x => by
              let f := Classical.choose (hΩ₀_surj G x)
              have hf : Ω₀ G f = x := Classical.choose_spec (hΩ₀_surj G x)
              let f' := Classical.choose (hΘ₀_surj G (Θ₀ G f))
              have hf' : Θ₀ G f' = Θ₀ G f := Classical.choose_spec (hΘ₀_surj G (Θ₀ G f))
              exact ((hΘΩ_eq G f' f).mp hf').trans hf
            map_add' := fun φ₁ φ₂ => by
              let f₁ := Classical.choose (hΘ₀_surj G φ₁)
              let f₂ := Classical.choose (hΘ₀_surj G φ₂)
              let f₁₂ := Classical.choose (hΘ₀_surj G (φ₁ + φ₂))
              have h12 : Θ₀ G f₁₂ = Θ₀ G (f₁ + f₂) := by
                rw [map_add, Classical.choose_spec (hΘ₀_surj G (φ₁ + φ₂)),
                  Classical.choose_spec (hΘ₀_surj G φ₁),
                  Classical.choose_spec (hΘ₀_surj G φ₂)]
              exact ((hΘΩ_eq G f₁₂ (f₁ + f₂)).mp h12).trans (map_add (Ω₀ G) f₁ f₂) }
      have hE₀_spec : ∀ (G : 𝒞) (f : Quiver.Hom G (𝒥 0)),
          E₀ G (Θ₀ G f) = Ω₀ G f :=
        fun G f => (hΘΩ_eq G _ f).mp (Classical.choose_spec (hΘ₀_surj G (Θ₀ G f)))
      have hE₀_nat : ∀ (G : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m)
          (α : CategoryTheory.Abelian.Ext.{u} oneR G 0),
          α.comp (E₀ G φ) (Nat.zero_add 1) =
            E₀ oneR (φ.comp (α.postcomp oneR (Nat.add_zero 0))) := by
        intro G φ α
        obtain ⟨f, rfl⟩ := hΘ₀_surj G φ
        rw [hE₀_spec G f]
        let s : Quiver.Hom oneR G := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hs_mk : CategoryTheory.Abelian.Ext.mk₀ s = α :=
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply α
        have hLHS : α.comp (Ω₀ G f) (Nat.zero_add 1) =
            Ω₀ oneR (CategoryTheory.CategoryStruct.comp s f) := by
          change α.comp ((CategoryTheory.Abelian.Ext.mk₀ f).comp ε₀ (Nat.zero_add 1))
              (Nat.zero_add 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp s f)).comp
              ε₀ (Nat.zero_add 1)
          rw [← hs_mk, ← CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ s)
              (CategoryTheory.Abelian.Ext.mk₀ f)
              ε₀ (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        rw [hLHS, ← hE₀_spec oneR (CategoryTheory.CategoryStruct.comp s f)]
        congr 1
        ext β
        let w := (e_Υ₀ oneR).symm β
        have hw_β : Υ₀ oneR 0 w = β := (e_Υ₀ oneR).apply_symm_apply β
        obtain ⟨hw_G, hnat_w⟩ := hΥ_nat 0 s w
        have h_eG : (e_Υ₀ G).symm (β.comp α (Nat.add_zero 0)) =
            ⟨((C₀ 0).map s).hom w.1, hw_G⟩ := by
          apply (e_Υ₀ G).injective
          rw [(e_Υ₀ G).apply_symm_apply]
          change β.comp α (Nat.add_zero 0) = Υ₀ G 0 ⟨((C₀ 0).map s).hom w.1, hw_G⟩
          rw [← hnat_w, hw_β, hs_mk]
        change ((((Ψ 0 oneR).symm (CategoryTheory.CategoryStruct.comp s f)) w.1).down) =
          ((((Ψ 0 G).symm f) ((e_Υ₀ G).symm (β.comp α (Nat.add_zero 0))).1).down)
        rw [h_eG, hΨ_symm_nat]
        rfl
      have hStep_bij : ∀ (s : ℕ) (hs : s < n) (G : 𝒞),
          Function.Bijective
            (fun x : CategoryTheory.Abelian.Ext.{u} G (B s) (s + 1) =>
              x.comp (hSc_step s hs).extClass (Nat.add_one (s + 1))) := by
        intro s hs G
        let δ_map : CategoryTheory.Abelian.Ext.{u} G (B s) (s + 1) →+
            CategoryTheory.Abelian.Ext.{u} G (B (s + 1)) (s + 2) :=
          AddMonoidHom.mk'
            (fun x => x.comp (hSc_step s hs).extClass (Nat.add_one (s + 1)))
            (fun x₁ x₂ => CategoryTheory.Abelian.Ext.add_comp x₁ x₂ _ (Nat.add_one (s + 1)))
        change Function.Bijective δ_map
        refine ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro x hx
          obtain ⟨x₂, hx₂⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            G (hSc_step s hs) x (Nat.add_one (s + 1)) hx
          have hx₂0 : x₂ = 0 :=
            @Subsingleton.elim _ (hInjSub (s + 2) G (s + 1) (by omega)) x₂ 0
          rw [← hx₂, hx₂0, CategoryTheory.Abelian.Ext.zero_comp]
        · intro y
          have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ (Sc_step s).f)
              (Nat.add_zero (s + 2)) = 0 :=
            @Subsingleton.elim _ (hInjSub (s + 2) G (s + 2) (by omega)) _ 0
          exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            G (hSc_step s hs) y hy0 (Nat.add_one (s + 1))
      have hTower : ∀ (r : ℕ), r ≤ n →
          ∃ E_r : ∀ G : 𝒞,
            (CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m) ≃+
              CategoryTheory.Abelian.Ext.{u} G (B r) (r + 1),
            ∀ (G : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m)
              (α : CategoryTheory.Abelian.Ext.{u} oneR G 0),
              α.comp (E_r G φ) (Nat.zero_add (r + 1)) =
                E_r oneR (φ.comp (α.postcomp oneR (Nat.add_zero 0))) := by
        intro r
        induction r with
        | zero =>
          intro _
          exact ⟨E₀, hE₀_nat⟩
        | succ s ih =>
          intro hs1
          have hs : s < n := by omega
          obtain ⟨E_s, hEs_nat⟩ := ih (by omega)
          let Δ_s : ∀ G : 𝒞,
              CategoryTheory.Abelian.Ext.{u} G (B s) (s + 1) ≃+
                CategoryTheory.Abelian.Ext.{u} G (B (s + 1)) (s + 2) :=
            fun G => AddEquiv.ofBijective
              (AddMonoidHom.mk'
                (fun x => x.comp (hSc_step s hs).extClass (Nat.add_one (s + 1)))
                (fun x₁ x₂ => CategoryTheory.Abelian.Ext.add_comp x₁ x₂ _ (Nat.add_one (s + 1))))
              (hStep_bij s hs G)
          refine ⟨fun G => (E_s G).trans (Δ_s G), ?_⟩
          intro G φ α
          change α.comp ((E_s G φ).comp (hSc_step s hs).extClass (Nat.add_one (s + 1)))
              (Nat.zero_add (s + 2)) =
            (E_s oneR (φ.comp (α.postcomp oneR (Nat.add_zero 0)))).comp
              (hSc_step s hs).extClass (Nat.add_one (s + 1))
          rw [← CategoryTheory.Abelian.Ext.comp_assoc α (E_s G φ) (hSc_step s hs).extClass
              (Nat.zero_add (s + 1)) (Nat.add_one (s + 1)) (Nat.zero_add (s + 2)),
            hEs_nat G φ α]
      obtain ⟨E_n, hEn_nat⟩ := hTower n (le_refl n)
      let e_iso_ext : ∀ G : 𝒞,
          CategoryTheory.Abelian.Ext.{u} G (B n) (n + 1) ≃+
            CategoryTheory.Abelian.Ext.{u} G oneR (n + 1) :=
        fun G =>
          { toFun := fun x =>
              x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual))
                (Nat.add_zero (n + 1))
            invFun := fun y =>
              y.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual) (Nat.add_zero (n + 1))
            left_inv := fun x => by
              dsimp only
              rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _
                  (Nat.add_zero (n + 1)) (Nat.add_zero 0) (Nat.add_zero (n + 1)),
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
                CategoryTheory.Abelian.Ext.comp_mk₀_id]
            right_inv := fun y => by
              dsimp only
              rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _
                  (Nat.add_zero (n + 1)) (Nat.add_zero 0) (Nat.add_zero (n + 1)),
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
                CategoryTheory.Abelian.Ext.comp_mk₀_id]
            map_add' := fun x₁ x₂ =>
              CategoryTheory.Abelian.Ext.add_comp x₁ x₂ _ (Nat.add_zero (n + 1)) }
      refine ⟨fun G => (E_n G).trans (e_iso_ext G), ?_⟩
      intro G φ α
      change α.comp ((E_n G φ).comp
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual)) (Nat.add_zero (n + 1)))
          (Nat.zero_add (n + 1)) =
        (E_n oneR (φ.comp (α.postcomp oneR (Nat.add_zero 0)))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual)) (Nat.add_zero (n + 1))
      rw [← CategoryTheory.Abelian.Ext.comp_assoc α (E_n G φ)
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual))
          (Nat.zero_add (n + 1)) (Nat.add_zero (n + 1)) (Nat.zero_add (n + 1)),
        hEn_nat G φ α]
  exact hGen (2 * d) τ C d_C Υ hComp hDualEx

theorem weil_etale_verdier_duality_of_local_effacement (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S]
    (d m : ℕ) (hm : 1 ≤ m)
    (τ : weilEtaleModuleH S m (2 * d) →+ ZMod m)
    (hGod : WeilHasTruncatedGodementComplex S d m)
    (hEff : WeilHasLocalEffacement S d m τ) :
    Function.Bijective τ ∧
    ∀ (i : ℕ) (hi : i ≤ 2 * d),
      (∀ a : weilEtaleModuleH S m i,
        (∀ b : weilEtaleModuleH S m (2 * d - i),
          τ (CategoryTheory.Abelian.Ext.comp a b (Nat.add_sub_of_le hi)) = 0) →
        a = 0) ∧
      (∀ b : weilEtaleModuleH S m (2 * d - i),
        (∀ a : weilEtaleModuleH S m i,
          τ (CategoryTheory.Abelian.Ext.comp a b (Nat.add_sub_of_le hi)) = 0) →
        b = 0) :=
by
  classical
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR := weilEtaleModuleUnit S m
  
  have hInjR : Module.Injective R R := by
    apply Module.Baer.injective
    intro I g
    by_cases hm1 : m = 1
    · subst hm1
      have : Subsingleton (ZMod 1) := inferInstance
      have : Subsingleton R := Equiv.ulift.subsingleton
      exact ⟨0, fun x hx => Subsingleton.elim _ _⟩
    · have : NeZero m := ⟨by omega⟩
      by_cases hZero : ∀ y : I, (y : R) = 0
      · refine ⟨0, fun x hx => ?_⟩
        have hx0 : (⟨x, hx⟩ : I) = 0 := Subtype.ext (hZero ⟨x, hx⟩)
        simp [hx0]
      · obtain ⟨y₀, hy₀⟩ := not_forall.mp hZero
        have hy₀_down : (y₀ : R).down ≠ 0 := fun h => hy₀ (ULift.ext _ _ h)
        have hy₀_pos : 0 < (y₀ : R).down.val :=
          Nat.pos_of_ne_zero (fun hv => hy₀_down ((ZMod.val_eq_zero _).mp hv))
        let P : ℕ → Prop := fun k => 0 < k ∧ ∃ y : I, (y : R).down.val = k
        have hex : ∃ k, P k := ⟨(y₀ : R).down.val, hy₀_pos, y₀, rfl⟩
        let d₀ : ℕ := Nat.find hex
        have hd₀_spec : P d₀ := Nat.find_spec hex
        have hd₀_pos : 0 < d₀ := hd₀_spec.1
        obtain ⟨e₀, he₀_val⟩ := hd₀_spec.2
        have hd₀_lt : d₀ < m := he₀_val ▸ ZMod.val_lt (e₀ : R).down
        have he₀_cast : ((d₀ : ℕ) : ZMod m) = (e₀ : R).down := by
          rw [← he₀_val, ZMod.natCast_zmod_val]
        have hd₀_dvd_m : d₀ ∣ m := by
          let q := m / d₀
          let r := m % d₀
          have hdiv : d₀ * q + r = m := Nat.div_add_mod m d₀
          have hr_lt : r < d₀ := Nat.mod_lt m hd₀_pos
          let z : I := -(q • e₀)
          have hz_down : (z : R).down = (r : ZMod m) := by
            change -(q • (e₀ : R).down) = (r : ZMod m)
            rw [nsmul_eq_mul, ← he₀_cast]
            have hm0 : ((d₀ * q + r : ℕ) : ZMod m) = 0 := by
              rw [hdiv, ZMod.natCast_self]
            push_cast at hm0
            linear_combination -hm0
          have hz_val : (z : R).down.val = r := by
            rw [hz_down]
            exact ZMod.val_natCast_of_lt (lt_trans hr_lt hd₀_lt)
          by_cases hr0 : r = 0
          · exact Nat.dvd_of_mod_eq_zero hr0
          · exfalso
            exact Nat.find_min hex hr_lt ⟨Nat.pos_of_ne_zero hr0, z, hz_val⟩
        have hgen : ∀ y : I, y = ((y : R).down.val / d₀) • e₀ := by
          intro y
          let v := (y : R).down.val
          let k := v / d₀
          let rem := v % d₀
          have hdiv_v : d₀ * k + rem = v := Nat.div_add_mod v d₀
          have hrem_lt : rem < d₀ := Nat.mod_lt v hd₀_pos
          let z : I := y - k • e₀
          have hz_down : (z : R).down = (rem : ZMod m) := by
            change (y : R).down - k • (e₀ : R).down = (rem : ZMod m)
            have hv_cast : ((v : ℕ) : ZMod m) = (y : R).down := ZMod.natCast_zmod_val _
            rw [← hv_cast, ← hdiv_v, nsmul_eq_mul, ← he₀_cast]
            push_cast
            ring
          have hz_val : (z : R).down.val = rem := by
            rw [hz_down]
            exact ZMod.val_natCast_of_lt (lt_trans hrem_lt hd₀_lt)
          have hrem0 : rem = 0 := by
            by_contra hne
            exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hne, z, hz_val⟩
          have hz0 : z = 0 := by
            apply Subtype.ext
            apply ULift.ext
            rw [hz_down, hrem0, Nat.cast_zero]
            rfl
          exact sub_eq_zero.mp hz0
        let q := m / d₀
        have hqd₀ : q * d₀ = m := Nat.div_mul_cancel hd₀_dvd_m
        have hq_pos : 0 < q := by
          by_contra hq0
          have hq_eq : q = 0 := Nat.eq_zero_of_not_pos hq0
          rw [hq_eq, zero_mul] at hqd₀
          omega
        have hqe₀ : q • e₀ = 0 := by
          apply Subtype.ext
          apply ULift.ext
          change q • (e₀ : R).down = 0
          rw [nsmul_eq_mul, ← he₀_cast]
          exact_mod_cast (by rw [hqd₀, ZMod.natCast_self] : ((q * d₀ : ℕ) : ZMod m) = 0)
        have hqg : q • g e₀ = 0 := by
          rw [← map_nsmul, hqe₀, map_zero]
        have hdvd_prod : m ∣ q * (g e₀).down.val := by
          have hcast0 : ((q * (g e₀).down.val : ℕ) : ZMod m) = 0 := by
            have h1 : q • (g e₀).down = 0 := congrArg ULift.down hqg
            rw [nsmul_eq_mul, ← ZMod.natCast_zmod_val (g e₀).down] at h1
            exact_mod_cast h1
          exact (ZMod.natCast_eq_zero_iff _ _).mp hcast0
        let v_g : ℕ := (g e₀).down.val
        have hdvd_prod' : q * d₀ ∣ q * v_g := by
          change m ∣ q * v_g at hdvd_prod
          rwa [← hqd₀] at hdvd_prod
        obtain ⟨c₀, hc₀⟩ := (Nat.mul_dvd_mul_iff_left hq_pos).mp hdvd_prod'
        have hc₀' : (g e₀).down.val = d₀ * c₀ := hc₀
        let c : R := ULift.up (c₀ : ZMod m)
        refine ⟨LinearMap.lsmul R R c, fun x hx => ?_⟩
        have hx_gen := hgen ⟨x, hx⟩
        let k := (x : R).down.val / d₀
        have hx_val : x = k • (e₀ : R) := congrArg Subtype.val hx_gen
        have hge₀ : LinearMap.lsmul R R c (e₀ : R) = g e₀ := by
          apply ULift.ext
          change ((c₀ : ZMod m) * (e₀ : R).down) = (g e₀).down
          rw [← he₀_cast, ← ZMod.natCast_zmod_val (g e₀).down, hc₀']
          push_cast
          ring
        calc
          LinearMap.lsmul R R c x = LinearMap.lsmul R R c (k • (e₀ : R)) := by rw [hx_val]
          _ = k • LinearMap.lsmul R R c (e₀ : R) := map_nsmul _ _ _
          _ = k • g e₀ := by rw [hge₀]
          _ = g (k • e₀) := (map_nsmul g k e₀).symm
          _ = g ⟨x, hx⟩ := by rw [← hx_gen]
  
  have hCog : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, m • x = 0) →
      ∀ a : A, (∀ φ : A →+ ZMod m, φ a = 0) → a = 0 := by
    intro A _ hTors a ha
    have hrem : ∀ (n : ℕ) (x : A), n • x = (n % m) • x := by
      intro n x
      conv_lhs => rw [← Nat.div_add_mod n m]
      rw [add_nsmul, mul_comm m (n / m), mul_smul, hTors x, smul_zero, zero_add]
    by_cases hm1 : m = 1
    · subst hm1
      simpa using hTors a
    · have : NeZero m := ⟨by omega⟩
      have : Fact (1 < m) := ⟨by omega⟩
      by_contra ha_ne
      let instSMulRA : SMul R A := ⟨fun r x => r.down.val • x⟩
      let _ := instSMulRA
      have hsmul_def : ∀ (r : R) (x : A), r • x = r.down.val • x := fun _ _ => rfl
      let instModRA : Module R A :=
        { one_smul := fun x => by
            rw [hsmul_def]
            change (1 : ZMod m).val • x = x
            rw [ZMod.val_one m, one_nsmul]
          mul_smul := fun r s x => by
            rw [hsmul_def, hsmul_def, hsmul_def]
            change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
            rw [ZMod.val_mul, ← hrem, mul_smul]
          smul_zero := fun r => by rw [hsmul_def, nsmul_zero]
          smul_add := fun r x y => by rw [hsmul_def, hsmul_def, hsmul_def, nsmul_add]
          add_smul := fun r s x => by
            rw [hsmul_def, hsmul_def, hsmul_def]
            change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
            rw [ZMod.val_add, ← hrem, add_nsmul]
          zero_smul := fun x => by
            rw [hsmul_def]
            change (0 : ZMod m).val • x = 0
            rw [ZMod.val_zero, zero_nsmul] }
      let _ := instModRA
      let P : ℕ → Prop := fun k => 0 < k ∧ k • a = 0
      have hex : ∃ k, P k := ⟨m, by omega, hTors a⟩
      let d₀ : ℕ := Nat.find hex
      have hd₀_spec : P d₀ := Nat.find_spec hex
      have hd₀_pos : 0 < d₀ := hd₀_spec.1
      have hd₀_ann : d₀ • a = 0 := hd₀_spec.2
      have hd₀_ge2 : 2 ≤ d₀ := by
        by_contra hlt
        have hd1 : d₀ = 1 := by omega
        rw [hd1, one_nsmul] at hd₀_ann
        exact ha_ne hd₀_ann
      have hd₀_dvd : ∀ n : ℕ, n • a = 0 → d₀ ∣ n := by
        intro n hn
        let rem := n % d₀
        have hrem_lt : rem < d₀ := Nat.mod_lt n hd₀_pos
        have hrem_ann : rem • a = 0 := by
          have hdiv : d₀ * (n / d₀) + rem = n := Nat.div_add_mod n d₀
          have h1 : (d₀ * (n / d₀)) • a + rem • a = 0 := by
            rw [← add_nsmul, hdiv, hn]
          rw [mul_comm d₀ (n / d₀), mul_smul, hd₀_ann, smul_zero, zero_add] at h1
          exact h1
        by_cases hr0 : rem = 0
        · exact Nat.dvd_of_mod_eq_zero hr0
        · exfalso
          exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hr0, hrem_ann⟩
      have hd₀_dvd_m : d₀ ∣ m := hd₀_dvd m (hTors a)
      let q : ℕ := m / d₀
      have hqd₀ : q * d₀ = m := Nat.div_mul_cancel hd₀_dvd_m
      have hq_pos : 0 < q := by
        by_contra hq0
        have hq_eq : q = 0 := Nat.eq_zero_of_not_pos hq0
        rw [hq_eq, zero_mul] at hqd₀
        omega
      have hq_lt_m : q < m := by nlinarith
      have hq_cast_ne : (q : ZMod m) ≠ 0 := by
        intro hq0
        have hv := congrArg ZMod.val hq0
        rw [ZMod.val_natCast_of_lt hq_lt_m, ZMod.val_zero] at hv
        omega
      let μ : R →ₗ[R] A := LinearMap.toSpanSingleton R A a
      let g_tilde : R →ₗ[R] R := LinearMap.lsmul R R (ULift.up (q : ZMod m))
      have hker : LinearMap.ker μ ≤ LinearMap.ker g_tilde := by
        intro r hr
        rw [LinearMap.mem_ker] at hr ⊢
        change r.down.val • a = 0 at hr
        obtain ⟨k, hk⟩ := hd₀_dvd r.down.val hr
        apply ULift.ext
        change (q : ZMod m) * r.down = 0
        rw [← ZMod.natCast_zmod_val r.down, hk]
        have hqm0 : ((q * d₀ : ℕ) : ZMod m) = 0 := by rw [hqd₀, ZMod.natCast_self]
        push_cast at hqm0 ⊢
        linear_combination (k : ZMod m) * hqm0
      let g₀ : LinearMap.range μ →ₗ[R] R :=
        (Submodule.liftQ (LinearMap.ker μ) g_tilde hker).comp
          (LinearMap.quotKerEquivRange μ).symm.toLinearMap
      obtain ⟨lam, hlam⟩ := hInjR.out (LinearMap.range μ).subtype Subtype.val_injective g₀
      let φ : A →+ ZMod m :=
        { toFun := fun x => (lam x).down
          map_zero' := by rw [map_zero]; rfl
          map_add' := fun x y => by rw [map_add]; rfl }
      have hφa : φ a = (q : ZMod m) := by
        have ha_mu : μ (1 : R) = a := one_smul R a
        have hmem : a ∈ LinearMap.range μ := ⟨1, ha_mu⟩
        have h1 : lam a = g₀ ⟨a, hmem⟩ := hlam ⟨a, hmem⟩
        have h2 : (LinearMap.quotKerEquivRange μ) (Submodule.Quotient.mk (1 : R)) = ⟨a, hmem⟩ :=
          Subtype.ext ha_mu
        have h3 : (LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩ =
            Submodule.Quotient.mk (1 : R) := by
          rw [← h2, LinearEquiv.symm_apply_apply]
        have h4 : g₀ ⟨a, hmem⟩ = g_tilde (1 : R) := by
          change Submodule.liftQ (LinearMap.ker μ) g_tilde hker
            ((LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩) = g_tilde 1
          rw [h3, Submodule.liftQ_apply]
        change (lam a).down = (q : ZMod m)
        rw [h1, h4]
        change ((q : ZMod m) * (1 : ZMod m)) = (q : ZMod m)
        exact mul_one _
      exact hq_cast_ne (hφa.symm.trans (ha φ))
  
  have hTrCrit : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, m • x = 0) →
      ∀ τ₀ : A →+ ZMod m,
        (∀ φ : A →+ ZMod m, ∃! c : ZMod m, ∀ x : A, φ x = c * τ₀ x) →
        Function.Bijective τ₀ := by
    intro A _ hTors τ₀ hCrit
    have hrem : ∀ (n : ℕ) (x : A), n • x = (n % m) • x := by
      intro n x
      conv_lhs => rw [← Nat.div_add_mod n m]
      rw [add_nsmul, mul_comm m (n / m), mul_smul, hTors x, smul_zero, zero_add]
    by_cases hm1 : m = 1
    · subst hm1
      have : Subsingleton (ZMod 1) := inferInstance
      refine ⟨fun x y _ => ?_, fun z => ⟨0, Subsingleton.elim _ _⟩⟩
      calc
        x = 1 • x := (one_nsmul x).symm
        _ = 0 := hTors x
        _ = 1 • y := (hTors y).symm
        _ = y := one_nsmul y
    · have : NeZero m := ⟨by omega⟩
      have : Fact (1 < m) := ⟨by omega⟩
      have h1_mem : (1 : ZMod m) ∈ τ₀.range := by
        by_contra hnot
        let Q₀ := ZMod m ⧸ τ₀.range
        let B := ULift.{u, 0} Q₀
        let q_mk : ZMod m →+ B :=
          { toFun := fun z => ULift.up (QuotientAddGroup.mk' τ₀.range z)
            map_zero' := ULift.ext _ _ (map_zero _)
            map_add' := fun x y => ULift.ext _ _ (map_add _ x y) }
        have hB_tors : ∀ b : B, m • b = 0 := by
          intro b
          obtain ⟨z, hz⟩ := QuotientAddGroup.mk'_surjective τ₀.range b.down
          have hb_eq : b = q_mk z := ULift.ext _ _ hz.symm
          rw [hb_eq, ← map_nsmul]
          have hmz : m • z = 0 := by
            rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
          rw [hmz, map_zero]
        have hq1_ne : q_mk 1 ≠ 0 := by
          intro h0
          have h0' : QuotientAddGroup.mk' τ₀.range (1 : ZMod m) = 0 :=
            congrArg ULift.down h0
          exact hnot ((QuotientAddGroup.eq_zero_iff (1 : ZMod m)).mp h0')
        have hnot_all : ¬ ∀ χ : B →+ ZMod m, χ (q_mk 1) = 0 :=
          fun hall => hq1_ne (hCog B hB_tors (q_mk 1) hall)
        obtain ⟨χ, hχ⟩ := not_forall.mp hnot_all
        let c : ZMod m := χ (q_mk 1)
        have hc_ann : ∀ x : A, (0 : A →+ ZMod m) x = c * τ₀ x := by
          intro x
          have hmem : τ₀ x ∈ τ₀.range := ⟨x, rfl⟩
          have hqx0 : q_mk (τ₀ x) = 0 :=
            ULift.ext _ _ ((QuotientAddGroup.eq_zero_iff (τ₀ x)).mpr hmem)
          have hval : τ₀ x = (τ₀ x).val • (1 : ZMod m) := by
            rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
          have h0 : χ (q_mk (τ₀ x)) = 0 := by rw [hqx0, map_zero]
          rw [hval, map_nsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val] at h0
          change (0 : ZMod m) = c * τ₀ x
          rw [mul_comm]
          exact h0.symm
        obtain ⟨c₀, _, hc₀_uniq⟩ := hCrit 0
        have hc_eq : c = c₀ := hc₀_uniq c hc_ann
        have h0_eq : (0 : ZMod m) = c₀ := hc₀_uniq 0 (fun x => by simp)
        exact hχ (hc_eq.trans h0_eq.symm)
      obtain ⟨e₀, he₀⟩ := h1_mem
      have hSurj : Function.Surjective τ₀ := by
        intro z
        refine ⟨z.val • e₀, ?_⟩
        rw [map_nsmul, he₀, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
      have hInj : Function.Injective τ₀ := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        by_contra hz_ne
        let K := τ₀.ker
        have hK_tors : ∀ u : ↥K, m • u = 0 := fun u => Subtype.ext (hTors u.1)
        let zK : ↥K := ⟨z, hz⟩
        have hzK_ne : zK ≠ 0 := fun h0 => hz_ne (congrArg Subtype.val h0)
        have hnot_all : ¬ ∀ ψ : ↥K →+ ZMod m, ψ zK = 0 :=
          fun hall => hzK_ne (hCog ↥K hK_tors zK hall)
        obtain ⟨ψ, hψ⟩ := not_forall.mp hnot_all
        let π : A →+ ↥K :=
          { toFun := fun x => ⟨x - (τ₀ x).val • e₀, by
              rw [AddMonoidHom.mem_ker, map_sub, map_nsmul, he₀, nsmul_eq_mul,
                mul_one, ZMod.natCast_zmod_val, sub_self]⟩
            map_zero' := by
              apply Subtype.ext
              simp
            map_add' := fun x y => by
              apply Subtype.ext
              change (x + y) - (τ₀ (x + y)).val • e₀ =
                (x - (τ₀ x).val • e₀) + (y - (τ₀ y).val • e₀)
              have hval_add : (τ₀ (x + y)).val • e₀ = (τ₀ x).val • e₀ + (τ₀ y).val • e₀ := by
                rw [map_add, ZMod.val_add, ← hrem, add_nsmul]
              rw [hval_add]
              abel }
        let φ : A →+ ZMod m := ψ.comp π
        obtain ⟨c, hc, _⟩ := hCrit φ
        have hc0 : c = 0 := by
          have he := hc e₀
          have hπe₀ : π e₀ = 0 := by
            apply Subtype.ext
            change e₀ - (τ₀ e₀).val • e₀ = 0
            rw [he₀, ZMod.val_one m, one_nsmul, sub_self]
          have hφe₀ : φ e₀ = 0 := by
            change ψ (π e₀) = 0
            rw [hπe₀, map_zero]
          rw [hφe₀, he₀, mul_one] at he
          exact he.symm
        have hφz : φ z = 0 := by rw [hc z, hc0, zero_mul]
        have hπz : π z = zK := by
          apply Subtype.ext
          change z - (τ₀ z).val • e₀ = z
          rw [hz, ZMod.val_zero, zero_nsmul, sub_zero]
        have hφz' : φ z = ψ zK := by
          change ψ (π z) = ψ zK
          rw [hπz]
        exact hψ (hφz'.symm.trans hφz)
      exact ⟨hInj, hSurj⟩
  
  obtain ⟨hEnd, hGeomLift, hLocConst⟩ :=
    weil_etale_connected_unit_end_and_geom_point_lift S m hm
  have hDualRep : WeilHasVerdierDualSheafRep S m :=
    weil_etale_colimit_preserving_dual_injective_sheaf S m hm hInjR
