          cases h3 with
          | @of Z u hu =>
            exact ⟨Z, u, hu, z, hz⟩
    let P_loc_set : S.Etaleᵒᵖ ⥤ Type u :=
      weilAltLocConstPresheaf S ℓ ⋙ CategoryTheory.forget AddCommGrpCat.{u}
