    (Y B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
    [AlgebraicGeometry.LocallyOfFiniteType B.hom]
    (f : Quiver.Hom Y.left B.left)
    (hf : CategoryTheory.CategoryStruct.comp f B.hom = Y.hom)
    (m : ℕ)
    (τ : Fin m → Quiver.Hom B.left Y.left)
    (hτ_sec : ∀ a : Fin m,
      CategoryTheory.CategoryStruct.comp (τ a) f = CategoryTheory.CategoryStruct.id B.left)
