import WeilPart25
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_etale_algClosed_section_skyscraper_H_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (X : AlgebraicGeometry.Scheme.{u})
    (m : ℕ)
    (σ : Fin m → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) X)
    (hPull : ∀ a : Fin m,
      ∃ (hc : (weilEtaleSitePullback (σ a)).IsContinuous
          X.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
        (hr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback (σ a)) AddCommGrpCat.{u} _
          X.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology hc).IsRightAdjoint),
        CategoryTheory.Limits.PreservesFiniteLimits
          (@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback (σ a)) AddCommGrpCat.{u} _
            X.smallEtaleTopology
            (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology hc hr))
    (hSh : ∀ N : AddCommGrpCat.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilPunctCurveSkyscraperPresheaf σ N))
    (M : AddCommGrpCat.{u}) (q : ℕ) (hq : 1 ≤ q) :
    Subsingleton
      (CategoryTheory.Sheaf.H
        (⟨weilPunctCurveSkyscraperPresheaf σ M, hSh M⟩ :
          CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) q) :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let J_k := S_k.smallEtaleTopology
  let J_X := X.smallEtaleTopology
  let σ_id : Fin 1 → Quiver.Hom S_k S_k := fun _ => CategoryTheory.CategoryStruct.id S_k
  let T_k : S_k.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id S_k) inferInstance
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)

  
  have hSieveTk : ∀ (R₀ : CategoryTheory.Sieve T_k),
      R₀ ∈ J_k T_k → R₀.arrows (CategoryTheory.CategoryStruct.id T_k) := by
    intro R₀ hR₀
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : AlgebraicGeometry.Scheme.IsJointlySurjectivePreserving P_et :=
      ⟨fun _ x y hxy =>
        let ⟨a, ha, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x y hxy
        ⟨a, ha⟩⟩
    have hR₀' : R₀ ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S_k T_k := hR₀
    obtain ⟨𝒰, hOver, hEt, hle⟩ :=
      (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (P := P_et) T_k R₀).mp hR₀'
    let _ : AlgebraicGeometry.Scheme.Cover.Over S_k 𝒰 := hOver
    obtain ⟨_, _, ⟨⟨j⟩⟩, y_j, _⟩ := 𝒰.mem₀.1 pt_k
    let _ : (𝒰.X j).Over S_k := hOver.over j
    have _ : AlgebraicGeometry.Scheme.Hom.IsOver (𝒰.f j) S_k := hOver.isOver_map j
    let V_j : S_k.Etale := (𝒰.X j).asOverProp (P := P_et) S_k (hEt j)
    let v_j : V_j ⟶ T_k := (𝒰.f j).asOverProp (P := P_et) S_k (hX := hEt j) (hY := T_k.prop)
    have hv_j : R₀.arrows v_j := hle _ _ (CategoryTheory.Presieve.ofArrows.mk j)
    let y_V : ↥V_j.left := y_j
    obtain ⟨W_aff, hAff, hy_W, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y_V) (U := ⊤) trivial
    let R_cat := V_j.left.presheaf.obj (Opposite.op W_aff)
    let ι_aff : AlgebraicGeometry.Spec R_cat ⟶ V_j.left := hAff.fromSpec
    have hy_range : y_V ∈ Set.range ι_aff.base := by
      rw [hAff.range_fromSpec]
      exact hy_W
    obtain ⟨z_spec, _⟩ := hy_range
    have : Nontrivial ↑R_cat :=
      (PrimeSpectrum.nonempty_iff_nontrivial (R := ↑R_cat)).mp ⟨z_spec⟩
    have : AlgebraicGeometry.Etale V_j.hom := V_j.prop
    have : AlgebraicGeometry.Etale (ι_aff ≫ V_j.hom) := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType (ι_aff ≫ V_j.hom) := inferInstance
    let φ_k : CommRingCat.of k ⟶ R_cat := AlgebraicGeometry.Spec.preimage (ι_aff ≫ V_j.hom)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = ι_aff ≫ V_j.hom :=
      AlgebraicGeometry.Spec.map_preimage (ι_aff ≫ V_j.hom)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let _ : Algebra k ↑R_cat := φ_k.hom.toAlgebra
    have hFT_alg : Algebra.FiniteType k ↑R_cat := hFT_hom
    obtain ⟨m_R, hm_R⟩ := Ideal.exists_maximal (↑R_cat)
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑R_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom m_R
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ m_R
        rw [hf_p]
        exact m_R.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_R : ↑R_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_R = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_R (algebraMap k (↑R_cat) c) = c
      rw [← q_mv.commutes c]
      change (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le)
        (e_quot.symm (q_hom (MvPolynomial.C c))) = c
      have heq_q : e_quot.symm (q_hom (MvPolynomial.C c)) =
          Ideal.Quotient.mk (RingHom.ker q_hom) (MvPolynomial.C c) := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
      exact (MvPolynomial.aeval a_pt).commutes c
    let τ : S_k ⟶ V_j.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_R) ≫ ι_aff
    have hτ_hom : τ ≫ V_j.hom = T_k.hom := by
      dsimp [τ]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
      rfl
    let g_τ : T_k ⟶ V_j := CategoryTheory.MorphismProperty.Over.homMk τ hτ_hom trivial
    have hv_left : v_j.left = V_j.hom :=
      (CategoryTheory.Category.comp_id v_j.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w v_j)
    have hg_comp : g_τ ≫ v_j = CategoryTheory.CategoryStruct.id T_k := by
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · change τ ≫ v_j.left = 𝟙 S_k
        rw [hv_left]
        exact hτ_hom
      · exact Subsingleton.elim _ _
    have h_mem := R₀.downward_closed hv_j g_τ
    rwa [hg_comp] at h_mem

  let u_of_lift : ∀ {U_k : S_k.Etale} (a : Fin 1),
      weilPunctCurveSectionLift σ_id a U_k → (T_k ⟶ U_k) :=
    fun {_} _ γ => CategoryTheory.MorphismProperty.Over.homMk γ.1 γ.2 trivial
  let id_lift : ∀ a : Fin 1, weilPunctCurveSectionLift σ_id a T_k :=
    fun _ => ⟨CategoryTheory.CategoryStruct.id S_k, CategoryTheory.Category.id_comp _⟩

  have hSh_id : ∀ N : AddCommGrpCat.{u},
      CategoryTheory.Presheaf.IsSheaf J_k (weilPunctCurveSkyscraperPresheaf σ_id N) := by
    intro N E U_k R hR x hx
    let P := weilPunctCurveSkyscraperPresheaf σ_id N
    have hu_mem : ∀ (a : Fin 1) (γ : weilPunctCurveSectionLift σ_id a U_k),
        R.arrows (u_of_lift a γ) := by
      intro a γ
      have hpb : R.pullback (u_of_lift a γ) ∈ J_k T_k :=
        J_k.pullback_stable (u_of_lift a γ) hR
      have hid := hSieveTk (R.pullback (u_of_lift a γ)) hpb
      rw [CategoryTheory.Sieve.pullback_apply, CategoryTheory.Category.id_comp] at hid
      exact hid
    let t : E ⟶ P.obj (Opposite.op U_k) :=
      AddCommGrpCat.ofHom
        { toFun := fun e a γ => ((x (u_of_lift a γ) (hu_mem a γ)).hom e) a (id_lift a)
          map_zero' := by
            funext a γ
            exact congrFun (congrFun ((x (u_of_lift a γ) (hu_mem a γ)).hom.map_zero) a) (id_lift a)
          map_add' := fun e₁ e₂ => by
            funext a γ
            exact congrFun
              (congrFun ((x (u_of_lift a γ) (hu_mem a γ)).hom.map_add e₁ e₂) a) (id_lift a) }
    refine ⟨t, ?_, ?_⟩
    · intro Y f hf
      apply AddCommGrpCat.ext
      intro e
      funext a δ
      let γ : weilPunctCurveSectionLift σ_id a U_k :=
        ⟨CategoryTheory.CategoryStruct.comp δ.1
          ((AlgebraicGeometry.Scheme.Etale.forget S_k).map f).left,
          (CategoryTheory.Category.assoc δ.1
            ((AlgebraicGeometry.Scheme.Etale.forget S_k).map f).left _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp δ.1)
              ((AlgebraicGeometry.Scheme.Etale.forget S_k).map f).w).trans δ.2)⟩
      have hcomm : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id T_k)
          (u_of_lift a γ) =
          CategoryTheory.CategoryStruct.comp (u_of_lift a δ) f := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact CategoryTheory.Category.id_comp _
        · exact Subsingleton.elim _ _
      have hcompat := hx (CategoryTheory.CategoryStruct.id T_k) (u_of_lift a δ)
        (hu_mem a γ) hf hcomm
      have hval := congrFun (congrFun (congrArg (fun m : E ⟶ P.obj (Opposite.op T_k) => m.hom e)
        hcompat) a) (id_lift a)
      have hLHS : (((CategoryTheory.ConcreteCategory.hom
          ((P.comp (CategoryTheory.coyoneda.obj (Opposite.op E))).map
            (CategoryTheory.CategoryStruct.id T_k).op))
          (x (u_of_lift a γ) (hu_mem a γ))).hom e) a (id_lift a) =
          ((x (u_of_lift a γ) (hu_mem a γ)).hom e) a (id_lift a) := by
        change ((x (u_of_lift a γ) (hu_mem a γ) ≫ P.map (𝟙 (Opposite.op T_k))).hom e) a
          (id_lift a) = _
        rw [P.map_id, CategoryTheory.Category.comp_id]
      have hRHS : (((CategoryTheory.ConcreteCategory.hom
          ((P.comp (CategoryTheory.coyoneda.obj (Opposite.op E))).map (u_of_lift a δ).op))
          (x f hf)).hom e) a (id_lift a) =
          ((x f hf).hom e) a δ := by
        change ((x f hf).hom e) a ⟨CategoryTheory.CategoryStruct.id S_k ≫ δ.1, _⟩ =
          ((x f hf).hom e) a δ
        exact congrArg (((x f hf).hom e) a) (Subtype.ext (CategoryTheory.Category.id_comp δ.1))
      exact (hLHS.symm.trans hval).trans hRHS
    · intro t' ht'
      apply AddCommGrpCat.ext
      intro e
      funext a γ
      have hval := congrFun (congrFun (congrArg (fun m : E ⟶ P.obj (Opposite.op T_k) => m.hom e)
        (ht' (u_of_lift a γ) (hu_mem a γ))) a) (id_lift a)
      have hLHS : (((CategoryTheory.ConcreteCategory.hom
          ((P.comp (CategoryTheory.coyoneda.obj (Opposite.op E))).map (u_of_lift a γ).op)) t').hom
          e) a (id_lift a) = (t'.hom e) a γ := by
        change (t'.hom e) a ⟨CategoryTheory.CategoryStruct.id S_k ≫ γ.1, _⟩ = (t'.hom e) a γ
        exact congrArg ((t'.hom e) a) (Subtype.ext (CategoryTheory.Category.id_comp γ.1))
      exact hLHS.symm.trans hval

  let L_k : CategoryTheory.Sheaf J_k AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
    CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (Opposite S_k.Etale) AddCommGrpCat.{u}).obj (Opposite.op T_k)
  let R_k : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf J_k AddCommGrpCat.{u} :=
    { obj := fun N => ⟨weilPunctCurveSkyscraperPresheaf σ_id N, hSh_id N⟩
      map := fun φ => CategoryTheory.ObjectProperty.homMk (weilPunctCurveSkyscraperMap σ_id φ)
      map_id := fun _ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext opU s
        rfl
      map_comp := fun _ _ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext opU s
        rfl }
  let adj_k : L_k ⊣ R_k :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun ℱ N =>
          { toFun := fun ψ =>
              CategoryTheory.ObjectProperty.homMk
                { app := fun opU =>
                    AddCommGrpCat.ofHom
                      { toFun := fun z a γ =>
                          ψ.hom ((ℱ.obj.map (u_of_lift a γ).op).hom z)
                        map_zero' := by
                          funext a γ
                          rw [map_zero, map_zero]
                          rfl
                        map_add' := fun z₁ z₂ => by
                          funext a γ
                          rw [map_add, map_add]
                          rfl }
                  naturality := fun {opU₁ opU₂} f => by
                    apply AddCommGrpCat.ext
                    intro z
                    funext a δ
                    change ψ.hom ((ℱ.obj.map (u_of_lift a δ).op).hom ((ℱ.obj.map f).hom z)) =
                      ψ.hom ((ℱ.obj.map (u_of_lift a ⟨δ.1 ≫
                        ((AlgebraicGeometry.Scheme.Etale.forget S_k).map f.unop).left, _⟩).op).hom z)
                    have hu_eq : u_of_lift a ⟨δ.1 ≫
                        ((AlgebraicGeometry.Scheme.Etale.forget S_k).map f.unop).left,
                        (CategoryTheory.Category.assoc δ.1 _ _).trans
                          ((congrArg (CategoryTheory.CategoryStruct.comp δ.1)
                            ((AlgebraicGeometry.Scheme.Etale.forget S_k).map f.unop).w).trans δ.2)⟩ =
                        u_of_lift a δ ≫ f.unop :=
                      CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
                    have hop : (u_of_lift a δ ≫ f.unop).op = f ≫ (u_of_lift a δ).op := rfl
                    rw [hu_eq, hop, ℱ.obj.map_comp]
                    rfl }
            invFun := fun α =>
              AddCommGrpCat.ofHom
                { toFun := fun z => ((α.hom.app (Opposite.op T_k)).hom z) 0 (id_lift 0)
                  map_zero' := congrFun
                    (congrFun ((α.hom.app (Opposite.op T_k)).hom.map_zero) 0) (id_lift 0)
                  map_add' := fun z₁ z₂ => congrFun
                    (congrFun ((α.hom.app (Opposite.op T_k)).hom.map_add z₁ z₂) 0) (id_lift 0) }
            left_inv := fun ψ => by
              apply AddCommGrpCat.ext
              intro z
              have hid_u : u_of_lift 0 (id_lift 0) = CategoryTheory.CategoryStruct.id T_k :=
                CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
              change ψ.hom ((ℱ.obj.map (u_of_lift 0 (id_lift 0)).op).hom z) = ψ.hom z
              rw [hid_u]
              have hop_id : (CategoryTheory.CategoryStruct.id T_k).op = 𝟙 (Opposite.op T_k) := rfl
              rw [hop_id, ℱ.obj.map_id]
              rfl
            right_inv := fun α => by
              apply CategoryTheory.Sheaf.hom_ext
              ext opU z
              funext a γ
              have ha : (0 : Fin 1) = a := Subsingleton.elim _ _
              subst ha
              have hnat := α.hom.naturality (u_of_lift 0 γ).op
              have hval := congrFun (congrFun (congrArg
                (fun m : ℱ.obj.obj opU ⟶ (R_k.obj N).obj.obj (Opposite.op T_k) => m.hom z) hnat)
                0) (id_lift 0)
              change (((ℱ.obj.map (u_of_lift 0 γ).op ≫ α.hom.app (Opposite.op T_k)).hom) z)
                0 (id_lift 0) = ((α.hom.app opU).hom z) 0 γ
              rw [hval]
              change ((α.hom.app opU).hom z) 0 ⟨CategoryTheory.CategoryStruct.id S_k ≫ γ.1, _⟩ =
                ((α.hom.app opU).hom z) 0 γ
              exact congrArg (((α.hom.app opU).hom z) 0)
                (Subtype.ext (CategoryTheory.Category.id_comp γ.1)) }
        homEquiv_naturality_left_symm := fun {ℱ' ℱ N} f g => by
          apply AddCommGrpCat.ext
          intro z
          rfl
        homEquiv_naturality_right := fun {ℱ N N'} f g => by
          apply CategoryTheory.Sheaf.hom_ext
          ext opU z
          rfl }
  have : L_k.PreservesMonomorphisms := by
    dsimp [L_k]
    infer_instance
  have hInj_id : ∀ (I : AddCommGrpCat.{u}) [CategoryTheory.Injective I],
      CategoryTheory.Injective (R_k.obj I) :=
    fun I _ => CategoryTheory.Injective.injective_of_adjoint adj_k I

  
  have hInj_X : ∀ (I : AddCommGrpCat.{u}) [CategoryTheory.Injective I],
      CategoryTheory.Injective
        (⟨weilPunctCurveSkyscraperPresheaf σ I, hSh I⟩ :
          CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) := by
    intro I _
    let J_base : CategoryTheory.Sheaf J_k AddCommGrpCat.{u} := R_k.obj I
    have : CategoryTheory.Injective J_base := hInj_id I
    let 𝒮_I : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      ⟨weilPunctCurveSkyscraperPresheaf σ I, hSh I⟩
    let hc : ∀ a : Fin m, (weilEtaleSitePullback (σ a)).IsContinuous J_X J_k :=
      fun a => Classical.choose (hPull a)
    let hr : ∀ a : Fin m,
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback (σ a)) AddCommGrpCat.{u} _ J_X J_k (hc a)).IsRightAdjoint :=
      fun a => Classical.choose (Classical.choose_spec (hPull a))
    have hLim : ∀ a : Fin m,
        CategoryTheory.Limits.PreservesFiniteLimits
          (@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback (σ a)) AddCommGrpCat.{u} _ J_X J_k (hc a) (hr a)) :=
      fun a => Classical.choose_spec (Classical.choose_spec (hPull a))
    let B : ∀ a : Fin m, X.Etale ⥤ S_k.Etale := fun a => weilEtaleSitePullback (σ a)
    let pf : ∀ a : Fin m,
        CategoryTheory.Sheaf J_k AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      fun a => @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (B a) AddCommGrpCat.{u} _ J_X J_k (hc a)
    let pb : ∀ a : Fin m,
        CategoryTheory.Sheaf J_X AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf J_k AddCommGrpCat.{u} :=
      fun a => @CategoryTheory.Functor.sheafPullback _ _ _ _
        (B a) AddCommGrpCat.{u} _ J_X J_k (hc a) (hr a)
    let adj_a : ∀ a : Fin m, pb a ⊣ pf a :=
      fun a => @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (B a) AddCommGrpCat.{u} _ J_X J_k (hc a) (hr a)
    have hInj_pf : ∀ a : Fin m, CategoryTheory.Injective ((pf a).obj J_base) := by
      intro a
      have : CategoryTheory.Limits.PreservesFiniteLimits (pb a) := hLim a
      have : (pb a).PreservesMonomorphisms := inferInstance
      exact CategoryTheory.Adjunction.map_injective (adj_a a) J_base inferInstance
    let fwd : ∀ (a : Fin m) (W : X.Etale),
        weilPunctCurveSectionLift σ_id 0 ((B a).obj W) → weilPunctCurveSectionLift σ a W :=
      fun a W s =>
        ⟨CategoryTheory.CategoryStruct.comp s.1 (CategoryTheory.Limits.pullback.fst W.hom (σ a)),
          (CategoryTheory.Category.assoc s.1
            (CategoryTheory.Limits.pullback.fst W.hom (σ a)) W.hom).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp s.1)
              (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := σ a))).trans
              ((CategoryTheory.Category.assoc s.1
                (CategoryTheory.Limits.pullback.snd W.hom (σ a)) (σ a)).symm.trans
                ((congrArg (fun m => CategoryTheory.CategoryStruct.comp m (σ a)) s.2).trans
                  (CategoryTheory.Category.id_comp (σ a)))))⟩
    let bwd : ∀ (a : Fin m) (W : X.Etale),
        weilPunctCurveSectionLift σ a W → weilPunctCurveSectionLift σ_id 0 ((B a).obj W) :=
      fun a W γ =>
        ⟨CategoryTheory.Limits.pullback.lift γ.1 (CategoryTheory.CategoryStruct.id S_k)
          (γ.2.trans (CategoryTheory.Category.id_comp (σ a)).symm),
          CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
    have h_fwd_bwd : ∀ (a : Fin m) (W : X.Etale) (γ : weilPunctCurveSectionLift σ a W),
        fwd a W (bwd a W γ) = γ :=
      fun a W γ => Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have h_fwd_nat : ∀ (a : Fin m) {W' W : X.Etale} (u : W' ⟶ W)
        (s : weilPunctCurveSectionLift σ_id 0 ((B a).obj W')),
        fwd a W ⟨s.1 ≫ ((AlgebraicGeometry.Scheme.Etale.forget S_k).map ((B a).map u)).left,
          (CategoryTheory.Category.assoc s.1 _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp s.1)
              ((AlgebraicGeometry.Scheme.Etale.forget S_k).map ((B a).map u)).w).trans s.2)⟩ =
        ⟨(fwd a W' s).1 ≫ ((AlgebraicGeometry.Scheme.Etale.forget X).map u).left,
