          (CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom f_A1 ⟶ P_succ) :=
        fun σ =>
          CategoryTheory.Limits.pullback.map
            (weilAffineSpaceOver k δ).hom f_A1
            (weilPolyP1Over k δ).hom P_1.hom
            (u_δ (fun i => σ (Fin.castSucc i)))
            (v_P1 (σ (Fin.last δ)))
            (𝟙 S_k)
            ((Category.comp_id _).trans (hu_over _).symm)
            ((Category.comp_id _).trans (hv_over _).symm)
      let u_succ : (Fin (δ + 1) → Bool) → (A_succ ⟶ P_succ) :=
        fun σ => Φ_δ ≫ m_map σ
      let s_succ : S_k ⟶ P_succ :=
        CategoryTheory.Limits.pullback.lift s_δ s_one (hs_over.trans hs_one_over.symm)
      have hu_succ_fst : ∀ σ : Fin (δ + 1) → Bool,
          u_succ σ ≫ π₁ = p_head δ ≫ u_δ (fun i => σ (Fin.castSucc i)) := by
        intro σ
        dsimp [u_succ, m_map, CategoryTheory.Limits.pullback.map, Φ_δ, π₁]
        rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      have hu_succ_snd : ∀ σ : Fin (δ + 1) → Bool,
          u_succ σ ≫ π₂ = p_last δ ≫ v_P1 (σ (Fin.last δ)) := by
        intro σ
        dsimp [u_succ, m_map, CategoryTheory.Limits.pullback.map, Φ_δ, π₂]
        rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      let ι_aff_succ : A_succ ⟶ P_succ := ι_aff (δ + 1)
      have hu_succ_false : u_succ (fun _ => false) = ι_aff_succ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (hu_succ_fst (fun _ => false)).trans
            ((congrArg (p_head δ ≫ ·) hu_false).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
        · exact (hu_succ_snd (fun _ => false)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
      have hu_succ_open : ∀ σ : Fin (δ + 1) → Bool,
          AlgebraicGeometry.IsOpenImmersion (u_succ σ) := by
        intro σ
        let _ := hu_open (fun i => σ (Fin.castSucc i))
        let _ := hv_open (σ (Fin.last δ))
        have _ : AlgebraicGeometry.IsOpenImmersion (m_map σ) :=
          AlgebraicGeometry.Scheme.pullback_map_isOpenImmersion _ _ _ _ _ _ _ _ _
        dsimp [u_succ]
        infer_instance
      have hu_succ_over : ∀ σ : Fin (δ + 1) → Bool,
          u_succ σ ≫ (π₁ ≫ (weilPolyP1Over k δ).hom) = (weilAffineSpaceOver k (δ + 1)).hom := by
        intro σ
        rw [← Category.assoc, hu_succ_fst, Category.assoc, hu_over, h_head_over δ]
      have hu_succ_range : ∀ (σ : Fin (δ + 1) → Bool) (z : ↥P_succ),
          π₁.base z ∈ Set.range (u_δ (fun i => σ (Fin.castSucc i))).base →
          π₂.base z ∈ Set.range (v_P1 (σ (Fin.last δ))).base →
          z ∈ Set.range (u_succ σ).base := by
        intro σ z hz₁ hz₂
        let u_i := u_δ (fun i => σ (Fin.castSucc i))
        let v_j := v_P1 (σ (Fin.last δ))
        let _ := hu_open (fun i => σ (Fin.castSucc i))
        let _ := hv_open (σ (Fin.last δ))
        let W : P_succ.Opens :=
