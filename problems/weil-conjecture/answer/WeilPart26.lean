            rw [hL_inv, CategoryTheory.Category.id_comp]

  
  
  
  have hFreeYoneda_comp :
      ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} {U₀ : S₀.Etale}
        {F G : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S₀ ℓ U₀ ⟶ F) (m : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ m) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ m.hom.app (Opposite.op U₀) := by
    intro S₀ U₀ F G α m
    let adj_sh₀ := CategoryTheory.sheafificationAdjunction S₀.smallEtaleTopology AddCommGrpCat.{u}
    let α' : (CategoryTheory.presheafToSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda U₀ AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv (((adj_sh₀.homEquiv _ G) (α' ≫ m)))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            ((adj_sh₀.homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).map m) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ m.hom.app (Opposite.op U₀) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  
  let ρ_Y : K_Y ⟶ P_push_Y.obj K_Y' :=
    CategoryTheory.ObjectProperty.homMk
      { app := fun opV =>
          let V := Opposite.unop opV
          let fst_V := CategoryTheory.Limits.pullback.fst (Fgt_Y.obj V).hom ι_Y
          AddCommGrpCat.ofHom
            { toFun := fun g0 =>
                ⟨(⟨fun y' => g0.1 (fst_V.base y'),
                  fun s => (g0.1.isLocallyConstant s).preimage fst_V.continuous⟩ :
                    LocallyConstant ↥(Fgt_Y'.obj (B_Y.obj V)).left A_mod), by
                  intro y' hy'
                  apply g0.2 (fst_V.base y')
                  intro h_in
                  apply hy'
                  rw [_hW']
                  change ι_Y.base (((Fgt_Y'.obj (B_Y.obj V)).hom).base y') ∈ (W_open : Set ↥Y₀.left)
                  have hcond_hom : (Fgt_Y'.obj (B_Y.obj V)).hom ≫ ι_Y =
                      fst_V ≫ (Fgt_Y.obj V).hom :=
                    (CategoryTheory.Limits.pullback.condition
                      (f := (Fgt_Y.obj V).hom) (g := ι_Y)).symm
                  have hcond : ((Fgt_Y'.obj (B_Y.obj V)).hom ≫ ι_Y).base y' =
                      (fst_V ≫ (Fgt_Y.obj V).hom).base y' :=
                    congrArg (fun k_hom : (Fgt_Y'.obj (B_Y.obj V)).left ⟶ Y₀.left =>
                      k_hom.base y') hcond_hom
                  exact hcond.symm ▸ h_in⟩
              map_zero' := Subtype.ext (LocallyConstant.ext (fun _ => rfl))
              map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)) }
        naturality := fun {opV₁ opV₂} f_op => by
          let V₁ := Opposite.unop opV₁
          let V₂ := Opposite.unop opV₂
          let f : V₂ ⟶ V₁ := f_op.unop
          apply AddCommGrpCat.ext
          intro (g0 : ↥(weilAltZeroBdrySubgroup Y₀.left W_open ℓ V₁))
          apply Subtype.ext
          apply LocallyConstant.ext
          intro y'
          change g0.1 ((CategoryTheory.Limits.pullback.fst (Fgt_Y.obj V₂).hom ι_Y ≫
              (Fgt_Y.map f).left).base y') =
            g0.1 (((Fgt_Y'.map (B_Y.map f)).left ≫
              CategoryTheory.Limits.pullback.fst (Fgt_Y.obj V₁).hom ι_Y).base y')
          have h_pb_nat : (Fgt_Y'.map (B_Y.map f)).left ≫
              CategoryTheory.Limits.pullback.fst (Fgt_Y.obj V₁).hom ι_Y =
              CategoryTheory.Limits.pullback.fst (Fgt_Y.obj V₂).hom ι_Y ≫
                (Fgt_Y.map f).left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          exact congrArg (fun k_hom : (Fgt_Y'.obj (B_Y.obj V₂)).left ⟶
              (Fgt_Y.obj V₁).left => g0.1 (k_hom.base y')) h_pb_nat.symm }

  have hρ_Y_adj :
      (adj_Y.homEquiv L_Y K_Y') (π_loc_Y ≫ α_Y'.hom) = α_Y.hom ≫ ρ_Y := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    let ι_BU_Y' : AM ⟶ (P_push_Y.obj L_BU_Y).obj.obj (Opposite.op W_et) := ι_BU_Y
    let η_BU_Y : L_Y ⟶ P_push_Y.obj L_BU_Y :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU_Y'
    have hL : CategoryTheory.Sheaf.freeYonedaHomEquiv
        ((adj_Y.homEquiv L_Y K_Y') (π_loc_Y ≫ α_Y'.hom)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α_Y'.hom ≫
          K_Y'.obj.map (Opposite.op τ_Y) := by
      have h_adj_step : (adj_Y.homEquiv L_Y K_Y') (π_loc_Y ≫ α_Y'.hom) =
          η_BU_Y ≫ P_push_Y.map (weilEtaleLocalTorsionMap Y'₀.left ℓ τ_Y ≫ α_Y'.hom) :=
        (congrArg (adj_Y.homEquiv L_Y K_Y')
          (CategoryTheory.Category.assoc π_BU_Y
            (weilEtaleLocalTorsionMap Y'₀.left ℓ τ_Y) α_Y'.hom)).trans
          ((adj_Y.homEquiv_naturality_right π_BU_Y _).trans
            (congrArg (· ≫ P_push_Y.map (weilEtaleLocalTorsionMap Y'₀.left ℓ τ_Y ≫ α_Y'.hom))
              (Equiv.apply_symm_apply (adj_Y.homEquiv L_Y L_BU_Y) η_BU_Y)))
      have hη_Y : CategoryTheory.Sheaf.freeYonedaHomEquiv η_BU_Y = ι_BU_Y :=
        Equiv.apply_symm_apply CategoryTheory.Sheaf.freeYonedaHomEquiv ι_BU_Y'
      have hmap_eq : ι_BU_Y ≫
          (weilEtaleLocalTorsionMap Y'₀.left ℓ τ_Y).hom.app (Opposite.op (B_Y.obj W_et)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_Y') ≫
            L_Y'.obj.map (Opposite.op τ_Y) := by
        have h1 := hFreeYoneda_comp (𝟙 L_BU_Y) (weilEtaleLocalTorsionMap Y'₀.left ℓ τ_Y)
        rw [CategoryTheory.Category.id_comp] at h1
        exact h1.symm.trans (Equiv.apply_symm_apply _ _)
      have h2 := (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.Category.id_comp α_Y'.hom).symm).trans
          (hFreeYoneda_comp (𝟙 L_Y') α_Y'.hom)
      exact (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv h_adj_step).trans
