            ∃ t : ↥(𝒢.obj.obj (Opposite.op W)),
              ∀ i : ι, (𝒢.obj.map (u_sub W (O i)).op).hom t = s i := by
        intro 𝒢 W ι O hcov s hs
        obtain ⟨t, ht, -⟩ := hOpenArrows 𝒢 W O hcov s (by
          intro i₁ i₂ Y f₁ f₂ hcomm
          by_cases hne : Nonempty ↥(Fgt.obj Y).left
          · obtain ⟨z₀⟩ := hne
            let w₀ : ↥(Fgt.obj W).left := (O i₁).ι ((Fgt.map f₁).left z₀)
            have hw₁ : w₀ ∈ O i₁ := h_mem_iota (O i₁) ((Fgt.map f₁).left z₀)
            have hw₂ : w₀ ∈ O i₂ := by
              have heq_w : w₀ = (O i₂).ι ((Fgt.map f₂).left z₀) :=
