            (TopologicalSpace.Opens.map π₂.base).obj v_j.opensRange
        have hzW : z ∈ W := ⟨hz₁, hz₂⟩
        have hW₁ : Set.range (W.ι ≫ π₁).base ⊆ Set.range u_i.base := by
          rintro _ ⟨w, rfl⟩
          exact w.2.1
        have hW₂ : Set.range (W.ι ≫ π₂).base ⊆ Set.range v_j.base := by
          rintro _ ⟨w, rfl⟩
          exact w.2.2
        let ℓ₁ : W.toScheme ⟶ (weilAffineSpaceOver k δ).left :=
          AlgebraicGeometry.IsOpenImmersion.lift u_i (W.ι ≫ π₁) hW₁
        let ℓ₂ : W.toScheme ⟶ A_1 :=
          AlgebraicGeometry.IsOpenImmersion.lift v_j (W.ι ≫ π₂) hW₂
        have hℓ_comm : ℓ₁ ≫ (weilAffineSpaceOver k δ).hom = ℓ₂ ≫ f_A1 := by
          calc
            ℓ₁ ≫ (weilAffineSpaceOver k δ).hom
              = ℓ₁ ≫ (u_i ≫ (weilPolyP1Over k δ).hom) := by rw [hu_over]
            _ = (ℓ₁ ≫ u_i) ≫ (weilPolyP1Over k δ).hom := (Category.assoc _ _ _).symm
            _ = (W.ι ≫ π₁) ≫ (weilPolyP1Over k δ).hom := by
                  rw [AlgebraicGeometry.IsOpenImmersion.lift_fac]
            _ = W.ι ≫ (π₁ ≫ (weilPolyP1Over k δ).hom) := Category.assoc _ _ _
            _ = W.ι ≫ (π₂ ≫ P_1.hom) := by
                  dsimp [π₁, π₂]
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = (W.ι ≫ π₂) ≫ P_1.hom := (Category.assoc _ _ _).symm
            _ = (ℓ₂ ≫ v_j) ≫ P_1.hom := by
                  rw [AlgebraicGeometry.IsOpenImmersion.lift_fac]
            _ = ℓ₂ ≫ (v_j ≫ P_1.hom) := Category.assoc _ _ _
            _ = ℓ₂ ≫ f_A1 := by rw [hv_over]
        let ℓ₁₂ : W.toScheme ⟶ CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom f_A1 :=
          CategoryTheory.Limits.pullback.lift ℓ₁ ℓ₂ hℓ_comm
