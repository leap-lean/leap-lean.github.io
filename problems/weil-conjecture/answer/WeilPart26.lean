    let c_inf : CategoryTheory.Abelian.Ext Fℤ Gm 1 :=
      d_inf.comp hEx_div.extClass (Nat.zero_add 1)
    let w_inf : CategoryTheory.Abelian.Ext Fℤ FM 2 :=
      c_inf.comp hEx_kum.extClass (Nat.one_add 1)
    let E_1 : Pt →₀ ℤ := Finsupp.single Q_inf₀ (1 : ℤ)

    have hE1_mem : (fun y : { y : ↥T_id.left // IsClosed ({T_id.hom.base y} : Set ↥X) } =>
        E_1 ⟨y.1, y.2⟩) ∈ Set.range (valDiv T_id) := by
      rw [(hVal_props T_id).2.2 hComp_Tid]
      refine E_1.support.finite_toSet.subset (fun y hy => ?_)
      exact Finsupp.mem_support_iff.mpr hy
    obtain ⟨s_E1, hs_E1⟩ := hE1_mem
    let φ_1 : Fℤ ⟶ Div_sh := (adj_id.homEquiv Aℤ Div_sh).symm (zLift _ s_E1)
    let d_1 : CategoryTheory.Abelian.Ext Fℤ Div_sh 0 :=
      (CategoryTheory.Abelian.Ext.addEquiv₀).symm φ_1
    have hd1_sec : ((adj_id.homEquiv Aℤ Div_sh
        (CategoryTheory.Abelian.Ext.addEquiv₀ d_1)).hom (ULift.up (1 : ℤ))) = s_E1 := by
      dsimp [d_1]
      rw [CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply,
        (adj_id.homEquiv Aℤ Div_sh).apply_symm_apply, hzLift_eval]
    have hd1_cinf : d_1.comp hEx_div.extClass (Nat.zero_add 1) = c_inf := by
      have hr := hDeg_red_id d_1 E_1 (fun y => by rw [hd1_sec]; exact congrFun hs_E1 y)
      have hsum1 : (E_1.sum fun _ m => m) = (1 : ℤ) := by
        dsimp [E_1]; exact Finsupp.sum_single_index rfl
      rw [hsum1, one_zsmul] at hr
      exact hr

    have hSurj_cinf : ∀ c : CategoryTheory.Abelian.Ext Fℤ Gm 1, ∃ m : ℤ, m • c_inf = c := by
      intro c
      have hc_K : c.comp (CategoryTheory.Abelian.Ext.mk₀ ι_gm) (Nat.add_zero 1) = 0 :=
        @Subsingleton.elim (K_sh.H 1) hKH1 _ 0
      obtain ⟨d₀, hd₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hEx_div c hc_K (Nat.zero_add 1)
      let s₀ := ((adj_id.homEquiv Aℤ Div_sh
        (CategoryTheory.Abelian.Ext.addEquiv₀ d₀)).hom (ULift.up (1 : ℤ)))
      have hfin₀ : { y : Pt | valDiv T_id s₀ y ≠ 0 }.Finite := by
        have hmem : valDiv T_id s₀ ∈ Set.range (valDiv T_id) := ⟨s₀, rfl⟩
        rwa [(hVal_props T_id).2.2 hComp_Tid] at hmem
      let E₀ : Pt →₀ ℤ := Finsupp.ofSupportFinite (valDiv T_id s₀) hfin₀
      refine ⟨E₀.sum fun _ m => m, ?_⟩
      exact (hDeg_red_id d₀ E₀ (fun _ => rfl)).symm.trans hd₀

    have hFree_cinf : ∀ m : ℤ, m • c_inf = 0 → m = 0 := by
      intro m hm0
      have hmd1 : (m • d_1).comp hEx_div.extClass (Nat.zero_add 1) = 0 := by
        change (hEx_div.extClass.postcomp Fℤ (Nat.zero_add 1)) (m • d_1) = 0
        rw [map_zsmul]
        change m • (d_1.comp hEx_div.extClass (Nat.zero_add 1)) = 0
        rw [hd1_cinf, hm0]
      obtain ⟨k₀, hk₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hEx_div (m • d_1)
          (Nat.zero_add 1) hmd1
      let ψ_K : Fℤ ⟶ K_sh := CategoryTheory.Abelian.Ext.addEquiv₀ k₀
      have hψ_div : ψ_K ≫ div_mor = m • φ_1 := by
        apply hMk0_inj
        rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ψ_K div_mor]
        dsimp [ψ_K]
        rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply, hk₀]
        have h_mφ : CategoryTheory.Abelian.Ext.addEquiv₀ (m • d_1) = m • φ_1 := by
          dsimp [d_1]
          rw [map_zsmul, CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply]
        rw [← h_mφ, CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
      let k_sec : ↥(K_sh.obj.obj (Opposite.op T_id)) :=
        ((adj_id.homEquiv Aℤ K_sh ψ_K).hom (ULift.up (1 : ℤ)))
      let K_sh_conc : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨K_pre, hKSheaf⟩
      let e_K : K_sh_conc ≅ K_sh := CategoryTheory.sheafificationIso K_sh_conc
      let s_K : ↥(K_pre.obj (Opposite.op T_id)) :=
        (e_K.inv.hom.app (Opposite.op T_id)).hom k_sec
      have hs_K_eq : ((shAdj.unit.app K_pre).app (Opposite.op T_id)).hom s_K = k_sec := by
        change (e_K.inv.hom.app (Opposite.op T_id) ≫ e_K.hom.hom.app (Opposite.op T_id)).hom k_sec =
          k_sec
        have h_id : e_K.inv ≫ e_K.hom = 𝟙 K_sh := e_K.inv_hom_id
        exact congrArg (fun θ : K_sh ⟶ K_sh => (θ.hom.app (Opposite.op T_id)).hom k_sec) h_id
      have hdiv_ksec : (div_mor.hom.app (Opposite.op T_id)).hom k_sec = m • s_E1 := by
        have h1 : (div_mor.hom.app (Opposite.op T_id)).hom k_sec =
            ((adj_id.homEquiv Aℤ Div_sh (ψ_K ≫ div_mor)).hom (ULift.up (1 : ℤ))) := by
          dsimp [k_sec, adj_id]
          rw [hAdj_eval hT_id₀ ψ_K, hAdj_eval hT_id₀ (ψ_K ≫ div_mor)]
          rfl
        have h2 : adj_id.homEquiv Aℤ Div_sh (m • φ_1) = m • (adj_id.homEquiv Aℤ Div_sh φ_1) := by
          dsimp [adj_id]
          rw [hAdj_eval hT_id₀ (m • φ_1), hAdj_eval hT_id₀ φ_1]
          change ((shAdj.unit.app Pℤ).app (Opposite.op T_id)) ≫ (m • φ_1.hom.app (Opposite.op T_id)) =
            m • (((shAdj.unit.app Pℤ).app (Opposite.op T_id)) ≫ φ_1.hom.app (Opposite.op T_id))
          exact CategoryTheory.Preadditive.comp_zsmul _ _ m
        rw [h1, hψ_div, h2]
        have h3 : (adj_id.homEquiv Aℤ Div_sh φ_1).hom (ULift.up (1 : ℤ)) = s_E1 := by
          dsimp [φ_1]
          rw [(adj_id.homEquiv Aℤ Div_sh).apply_symm_apply, hzLift_eval]
        change (m • (adj_id.homEquiv Aℤ Div_sh φ_1)).hom (ULift.up (1 : ℤ)) = m • s_E1
        rw [← h3]; rfl
      have hm_princ : m • E_1 ∈ weilCurvePrincipalSubgroup X := by
        apply hBridge_bwd s_K (m • E_1)
        intro x
        rw [hs_K_eq, hdiv_ksec, map_zsmul]
        change (m • valDiv T_id s_E1) x = (m • E_1) x
        rw [hs_E1]; rfl
      exact hPrinc_inf m hm_princ

    have hPost_nsmul : ∀ (c : CategoryTheory.Abelian.Ext Fℤ Gm 1) (k_nat : ℕ),
        c.comp (CategoryTheory.Abelian.Ext.mk₀ (k_nat • CategoryTheory.CategoryStruct.id Gm))
          (Nat.add_zero 1) = k_nat • c := by
      intro c k_nat
      induction k_nat with
      | zero =>
        rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
      | succ k_nat ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih,
          CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]

    have hnw_zero : (n : ℤ) • w_inf = 0 := by
      rw [natCast_zsmul]
      have h1 : n • w_inf = (n • c_inf).comp hEx_kum.extClass (Nat.one_add 1) := by
        change n • ((hEx_kum.extClass.postcomp Fℤ (Nat.one_add 1)) c_inf) =
          (hEx_kum.extClass.postcomp Fℤ (Nat.one_add 1)) (n • c_inf)
        exact (map_nsmul (hEx_kum.extClass.postcomp Fℤ (Nat.one_add 1)) n c_inf).symm
      rw [h1, ← hPost_nsmul c_inf n, ← hp_kum,
        CategoryTheory.Abelian.Ext.comp_assoc c_inf _ _ (Nat.add_zero 1) (Nat.zero_add 1)
          (Nat.one_add 1),
        hEx_kum.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]

    let z_hom : ℤ →+ FM.H 2 :=
      { toFun := fun m => m • w_inf
        map_zero' := zero_zsmul w_inf
        map_add' := fun m₁ m₂ => add_zsmul w_inf m₁ m₂ }
    let Φ : ZMod n →+ FM.H 2 := ZMod.lift n ⟨z_hom, hnw_zero⟩
    have hΦ_coe : ∀ m : ℤ, Φ (m : ZMod n) = m • w_inf :=
      fun m => ZMod.lift_coe n ⟨z_hom, hnw_zero⟩ m

    have hΦ_surj : Function.Surjective Φ := by
      intro w
      have hw_gm : w.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 2) = 0 :=
        @Subsingleton.elim (Gm.H 2) hGmH2 _ 0
      obtain ⟨c, hc⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hEx_kum w hw_gm (Nat.one_add 1)
      obtain ⟨m, rfl⟩ := hSurj_cinf c
      refine ⟨(m : ZMod n), ?_⟩
      rw [hΦ_coe]
      have h1 : (m • c_inf).comp hEx_kum.extClass (Nat.one_add 1) = m • w_inf :=
        map_zsmul (hEx_kum.extClass.postcomp Fℤ (Nat.one_add 1)) m c_inf
      exact h1.symm.trans hc

    have hΦ_inj : Function.Injective Φ := by
      rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro a ha
      rw [AddMonoidHom.mem_ker] at ha
      let m : ℤ := (a.val : ℤ)
      have hma : (m : ZMod n) = a := by
        dsimp [m]; rw [Int.cast_natCast, ZMod.natCast_zmod_val]
      have hmw0 : (m • c_inf).comp hEx_kum.extClass (Nat.one_add 1) = 0 := by
        have h1 : (m • c_inf).comp hEx_kum.extClass (Nat.one_add 1) = m • w_inf :=
          map_zsmul (hEx_kum.extClass.postcomp Fℤ (Nat.one_add 1)) m c_inf
        rw [h1, ← hΦ_coe m, hma, ha]
      obtain ⟨c', hc'⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hEx_kum (m • c_inf)
          (Nat.one_add 1) hmw0
      obtain ⟨q, rfl⟩ := hSurj_cinf c'
      change (q • c_inf).comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero 1) = m • c_inf at hc'
      rw [hp_kum, hPost_nsmul (q • c_inf) n, ← natCast_zsmul, ← mul_zsmul] at hc'
      have hmq0 : (m - (n : ℤ) * q) • c_inf = 0 := by
        rw [sub_zsmul, hc']
        exact add_neg_cancel (m • c_inf)
      have hmq_eq : m = (n : ℤ) * q := sub_eq_zero.mp (hFree_cinf _ hmq0)
      rw [AddSubgroup.mem_bot, ← hma, hmq_eq]
      push_cast
      simp

    let e_tr : ZMod n ≃+ FM.H 2 := AddEquiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩
    let tr_1 : FM.H 2 →+ ZMod n := e_tr.symm.toAddMonoidHom
    refine ⟨tr_1, e_tr.symm.bijective, fun hT_id d₀ D hEval w_kum hw_heq => ?_⟩
    have hEval' : ∀ y : { y : ↥T_id.left // IsClosed ({T_id.hom.base y} : Set ↥X) },
        valDiv T_id
          (((adj_id.homEquiv Aℤ Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀ d₀)).hom
            (ULift.up (1 : ℤ)))) y = D ⟨y.1, y.2⟩ := by
      intro y
      have heq_hom : adj_id.homEquiv Aℤ Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀ d₀) =
          (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_id).homEquiv Aℤ Div_sh
            (CategoryTheory.Abelian.Ext.addEquiv₀ d₀) :=
        (hAdj_eval hT_id₀ _).trans (hAdj_eval hT_id _).symm
      rw [heq_hom]
      exact hEval y
    have hd0_c : d₀.comp hEx_div.extClass (Nat.zero_add 1) = (D.sum fun _ m => m) • c_inf :=
      hDeg_red_id d₀ D hEval'
    have hw_eq : w_kum = (D.sum fun _ m => m) • w_inf := by
      have h1 : w_kum = (d₀.comp hEx_div.extClass (Nat.zero_add 1)).comp
          hEx_kum.extClass (Nat.one_add 1) := eq_of_heq hw_heq
      rw [h1, hd0_c]
      exact map_zsmul (hEx_kum.extClass.postcomp Fℤ (Nat.one_add 1)) _ c_inf
    have hw_etr : w_kum = e_tr ((D.sum fun _ m => m : ℤ) : ZMod n) := by
      change w_kum = Φ ((D.sum fun _ m => m : ℤ) : ZMod n)
      rw [hΦ_coe, hw_eq]
    change e_tr.symm w_kum = ((D.sum fun _ m => m : ℤ) : ZMod n)
    rw [hw_etr, e_tr.symm_apply_apply]

  obtain ⟨tr_1, hBij_tr1, hDeg_tr1⟩ := hLadder_pkg
  refine ⟨tr_1, hBij_tr1, fun s_inf _hs_over hs_disj => ?_⟩
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt₀ : ↥S_k := (⊥ : PrimeSpectrum k)
  have hs_pt_eq : s_inf.base pt₀ = s_inf₀.base pt₀ := by
    have hnot : s_inf.base pt₀ ∉ Set.range ι_1.base :=
      fun hm => Set.disjoint_left.mp hs_disj hm ⟨pt₀, rfl⟩
    have hmem : s_inf.base pt₀ ∈ (Set.range ι_1.base)ᶜ := hnot
    rwa [hCompl_inf, Set.mem_singleton_iff] at hmem
  have hClosed_inf : IsClosed ({s_inf.base pt₀} : Set ↥P₁_ov.left) := by
    rw [hs_pt_eq]; exact hCl_inf₀
  refine ⟨ι_kum, p_kum, h0_kum, hEx_kum, T_P1, hT_P1, Div_sh, ι_gm, div_mor, h0_div, hEx_div,
    valDiv, pt₀, hClosed_inf, hp_kum, hKum_norm, hVal_props, ?_, hBridge_fwd, hDeg_tr1⟩
  intro U₁ U₂ g d y₁
  exact hVal_pull g d y₁

theorem weil_zero_bdry_locConst_sheaf_iso_and_closed_excision (n : ℕ) :
    (∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilAltLocConstPresheaf Z n) ∧
      (∀ V₀ : Z.Opens,
        CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
          (weilAltZeroBdrySubpresheaf Z V₀ n)) ∧
      (∀ hSh_loc : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
          (weilAltLocConstPresheaf Z n),
        ∃ Φ : CategoryTheory.Iso (weilEtaleTorsionSheaf Z n)
            ⟨weilAltLocConstPresheaf Z n, hSh_loc⟩,
          CategoryTheory.CategoryStruct.comp
            ((CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u}
              (weilEtaleIdTerminalIsTerminal.{u} Z)).unit.app
              (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))))
            (Φ.hom.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Z))) =
            weilAltLocConstConstHom Z (weilEtaleIdTerminal.{u} Z) n)) ∧
    (∀ (Z : AlgebraicGeometry.Scheme.{u}) (V₀ : Z.Opens)
      (hSh_loc : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
        (weilAltLocConstPresheaf Z n))
      (hSh_zero : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
        (weilAltZeroBdrySubpresheaf Z V₀ n))
      (Φ : CategoryTheory.Iso (weilEtaleTorsionSheaf Z n)
        ⟨weilAltLocConstPresheaf Z n, hSh_loc⟩)
      (q₀ q : ℕ),
      q₀ + 1 = q →
      Subsingleton (weilEtaleTorsionH (weilAltClosedComplIdeal Z V₀).subscheme n q₀) →
      Subsingleton (weilEtaleTorsionH (weilAltClosedComplIdeal Z V₀).subscheme n q) →
      Function.Bijective
        ((CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.comp
            ({ hom := weilAltZeroBdrySubpresheafι Z V₀ n } :
              Quiver.Hom
                (⟨weilAltZeroBdrySubpresheaf Z V₀ n, hSh_zero⟩ :
                  CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
                (⟨weilAltLocConstPresheaf Z n, hSh_loc⟩ :
                  CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}))
            Φ.inv)).postcomp
          (weilTopDegKummerZeroBdryFℤ Z) (Nat.add_zero q))) :=
by
  classical
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have _ : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEt_hom : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Z.Etale} (f : U₁ ⟶ U₂),
      AlgebraicGeometry.Etale f.left := by
    intro Z U₁ U₂ f
    have h₁ : P_et U₁.hom := U₁.prop
    have h₂ : P_et U₂.hom := U₂.prop
    have hw : f.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w f
    rw [← hw] at h₁
    exact CategoryTheory.MorphismProperty.of_postcomp P_et f.left U₂.hom h₂ h₁
  have hMem_et : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale) (R : CategoryTheory.Sieve U),
      R ∈ Z.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (Y : Z.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro Z U R
    have htop : Z.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology Z
        (le_refl P_et)
    rw [htop]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R
  have hEmpty_sub : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (Z₀ : Z.Etale), IsEmpty ↥Z₀.left → Subsingleton ↥(𝒢.obj.obj (Opposite.op Z₀)) := by
    intro Z 𝒢 Z₀ hEmp
    have hSh_type : CategoryTheory.Presieve.IsSheaf Z.smallEtaleTopology
        (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type Z.smallEtaleTopology _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf Z.smallEtaleTopology 𝒢.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) 𝒢.property)
    have hBot_mem : (⊥ : CategoryTheory.Sieve Z₀) ∈ Z.smallEtaleTopology Z₀ := by
      rw [hMem_et]
      intro x
      exact IsEmpty.elim hEmp x
    have hFor := hSh_type (⊥ : CategoryTheory.Sieve Z₀) hBot_mem
    refine ⟨fun a b => ?_⟩
    let empFam : CategoryTheory.Presieve.FamilyOfElements
        (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
        ((⊥ : CategoryTheory.Sieve Z₀) : CategoryTheory.Presieve Z₀) :=
      fun _ _ hf => False.elim hf
    have ha : empFam.IsAmalgamation a := fun _ _ hf => False.elim hf
    have hb : empFam.IsAmalgamation b := fun _ _ hf => False.elim hf
    exact hFor.isSeparatedFor empFam a b ha hb

  
  have hPart1 : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilAltLocConstPresheaf Z n) ∧
      (∀ V₀ : Z.Opens,
        CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
          (weilAltZeroBdrySubpresheaf Z V₀ n)) ∧
      (∀ hSh_loc : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
          (weilAltLocConstPresheaf Z n),
        ∃ Φ : CategoryTheory.Iso (weilEtaleTorsionSheaf Z n)
            ⟨weilAltLocConstPresheaf Z n, hSh_loc⟩,
          CategoryTheory.CategoryStruct.comp
            ((CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u}
              (weilEtaleIdTerminalIsTerminal.{u} Z)).unit.app
              (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))))
            (Φ.hom.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Z))) =
            weilAltLocConstConstHom Z (weilEtaleIdTerminal.{u} Z) n) := by
    intro Z
    have hSh_locZ : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
        (weilAltLocConstPresheaf Z n) := by
      apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp Z.smallEtaleTopology
        (weilAltLocConstPresheaf Z n) (CategoryTheory.forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
      intro U R hR sec hcompat
      have hcov := (hMem_et Z U R).mp hR
      let Yx : ↥U.left → Z.Etale := fun x => (hcov x).choose
      let fx : ∀ x : ↥U.left, Yx x ⟶ U := fun x => (hcov x).choose_spec.choose
      let yx : ∀ x : ↥U.left, ↥(Yx x).left := fun x => (hcov x).choose_spec.choose_spec.choose
      have hfx : ∀ x : ↥U.left,
          R.arrows (fx x) ∧ AlgebraicGeometry.Etale (fx x).left ∧ (fx x).left (yx x) = x :=
        fun x => (hcov x).choose_spec.choose_spec.choose_spec
      let secFn : ∀ {Y : Z.Etale} (f : Y ⟶ U), R.arrows f →
          LocallyConstant ↥Y.left (ULift.{u} (ZMod n)) :=
        fun f hf => sec f hf
      let t_fun : ↥U.left → ULift.{u} (ZMod n) :=
        fun x => (secFn (fx x) (hfx x).1) (yx x)
      have ht_eval : ∀ {Y : Z.Etale} (f : Y ⟶ U) (hf : R.arrows f) (y : ↥Y.left),
          (secFn f hf) y = t_fun (f.left y) := by
        intro Y f hf y
        let x : ↥U.left := f.left y
        have _ : AlgebraicGeometry.Etale f.left := hEt_hom f
        have _ : AlgebraicGeometry.Etale (fx x).left := (hfx x).2.1
        have _ : AlgebraicGeometry.Etale Y.hom := Y.prop
        let P_sch := CategoryTheory.Limits.pullback f.left (fx x).left
        let pr₁ : P_sch ⟶ Y.left := CategoryTheory.Limits.pullback.fst f.left (fx x).left
        let pr₂ : P_sch ⟶ (Yx x).left := CategoryTheory.Limits.pullback.snd f.left (fx x).left
        let P_et : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (pr₁ ≫ Y.hom) inferInstance
        let p₁ : P_et ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl
        let p₂ : P_et ⟶ Yx x :=
          CategoryTheory.MorphismProperty.Over.homMk pr₂
            (by
              change pr₂ ≫ (Yx x).hom = pr₁ ≫ Y.hom
              rw [← CategoryTheory.MorphismProperty.Over.w (fx x),
                ← CategoryTheory.MorphismProperty.Over.w f,
                ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.condition])
        have hp_comm : p₁ ≫ f = p₂ ≫ fx x :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y (yx x) ((hfx x).2.2).symm
        have hc := hcompat p₁ p₂ hf (hfx x).1 hp_comm
        have hc_z : (secFn f hf) (pr₁ z) = (secFn (fx x) (hfx x).1) (pr₂ z) :=
          congrArg (fun (g : LocallyConstant ↥P_et.left (ULift.{u} (ZMod n))) => g z) hc
        rw [hz₁, hz₂] at hc_z
        exact hc_z
      have ht_loc : IsLocallyConstant t_fun := by
        intro E
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        let s_x : LocallyConstant ↥(Yx x).left (ULift.{u} (ZMod n)) := secFn (fx x) (hfx x).1
        have _ : AlgebraicGeometry.Etale (fx x).left := (hfx x).2.1
        have hOpen_im : IsOpen (⇑(fx x).left '' (⇑s_x ⁻¹' E)) :=
          AlgebraicGeometry.Scheme.Hom.isOpenMap (fx x).left (⇑s_x ⁻¹' E) (s_x.isLocallyConstant E)
