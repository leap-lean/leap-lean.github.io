                s u hu ≫ AddCommGrpCat.ofHom (Pi.evalAddMonoidHom _ a) := by
        intro a
        let s_a : ∀ ⦃V : Y₀.Etale⦄ (u : V ⟶ W), R.arrows u →
            (E ⟶ (pf_loc_a a).obj.obj (Opposite.op V)) :=
          fun _ u hu => s u hu ≫ AddCommGrpCat.ofHom (Pi.evalAddMonoidHom _ a)
        refine (pf_loc_a a).property E R hR s_a ?_
        intro V₁ V₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        have h1 := hs g₁ g₂ hf₁ hf₂ hcomm
        apply AddCommGrpCat.ext; intro e
        exact congrArg (fun tup => tup a) (congrArg (fun k => k.hom e) h1)
      let t_a_fun : ∀ a : Fin m, E ⟶ (pf_loc_a a).obj.obj (Opposite.op W) :=
