                CategoryTheory.Category.assoc _ _ _
              _ = (γ_tilde ≫ fst_V) ≫ (FgtZ.map γ).left := by
                rw [hm_fst, CategoryTheory.Category.assoc]
              _ = (FgtZ.map γ).left := by
                rw [htilde_fst, CategoryTheory.Category.id_comp]
              _ = (FgtZ.map γ).left ≫ (e_W.hom ≫ e_W.inv) := by
                rw [e_W.hom_inv_id, CategoryTheory.Category.comp_id]
