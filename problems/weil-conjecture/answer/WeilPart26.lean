    let Pℤ_Y' := (CategoryTheory.Functor.const (Opposite Y'₀.left.Etale)).obj Aℤ
    let G_target := (P_push_ν' ⋙ P_push_Z).obj Fℤ_Y'
    apply (adj_top.homEquiv Fℤ_Z Fℤ_Y').injective
    have hL_adj : (adj_top.homEquiv Fℤ_Z Fℤ_Y')
