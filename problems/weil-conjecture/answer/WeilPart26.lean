        have h4 : (adj_B.unit.app AM ≫ e_loc_B.hom.hom.app (Opposite.op T_B)) ≫ L_loc_B.obj.map u_t.op =
            weilAltLocConstConstHom B₀ T_B n ≫ L_loc_B.obj.map u_t.op :=
          congrArg (· ≫ L_loc_B.obj.map u_t.op) hPinB'
        exact (h1.trans (h2.trans (h3.trans h4))).trans
