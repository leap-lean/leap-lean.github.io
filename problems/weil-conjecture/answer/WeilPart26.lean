            CategoryTheory.MorphismProperty.Over.Hom.ext h_left_eq
          have h_tilde_eq : O.ι ≫ γ_tilde γ = O.ι ≫ γ_tilde γ₀ := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · change (O.ι ≫ γ_tilde γ) ≫ fst_U = (O.ι ≫ γ_tilde γ₀) ≫ fst_U
              rw [CategoryTheory.Category.assoc, htilde_fst,
                CategoryTheory.Category.assoc, htilde_fst]
            · change (O.ι ≫ γ_tilde γ) ≫ snd_U = (O.ι ≫ γ_tilde γ₀) ≫ snd_U
