        exact hs_b'

      let pf_b := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback s_b) AddCommGrpCat.{u} _
        V_bar.left.smallEtaleTopology S_k.smallEtaleTopology
        (@hc_all S_k V_bar.left s_b)
      let pb_b := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback s_b) AddCommGrpCat.{u} _
        V_bar.left.smallEtaleTopology S_k.smallEtaleTopology
        (@hc_all S_k V_bar.left s_b) (@hr_all S_k V_bar.left s_b)
      let adj_b := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback s_b) AddCommGrpCat.{u} _
        V_bar.left.smallEtaleTopology S_k.smallEtaleTopology
        (@hc_all S_k V_bar.left s_b) (@hr_all S_k V_bar.left s_b)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      let L_V := weilEtaleLocalTorsionSheaf V_bar.left ℓ V
      let L_BV := weilEtaleLocalTorsionSheaf S_k ℓ ((weilEtaleSitePullback s_b).obj V)
      let L_Tk := weilEtaleLocalTorsionSheaf S_k ℓ T_k
      let u_LV : Quiver.Hom L_V (pf_b.obj (pb_b.obj L_V)) := adj_b.unit.app L_V
      let η_V0 : Quiver.Hom AM ((pf_b.obj (pb_b.obj L_V)).obj.obj (Opposite.op V)) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv u_LV
      let η_V1 : Quiver.Hom AM
          ((pb_b.obj L_V).obj.obj (Opposite.op ((weilEtaleSitePullback s_b).obj V))) := η_V0
      let ι_pull_V : Quiver.Hom L_BV (pb_b.obj L_V) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.symm η_V1
      haveI : CategoryTheory.IsIso ι_pull_V := (hPullIso s_b V).1

      obtain ⟨r, κ_V, s_z, hs_z_eq, hOpen_V, hDisj_V, hUniv_V, hκV_fst, hFibW⟩ :=
        hFibClopen V_bar V s_b hs_b
      obtain ⟨κ_W, hκW_fst, hOpen_W, hDisj_W, hUniv_W⟩ :=
        hFibW Y_bar π_bar W f_W hComm_W

      
      let D_b := ↥((pb_b.obj L_V).obj.obj (Opposite.op T_k))
      let e_unit : ULift.{u} (ZMod ℓ) ≃ ↥(L_Tk.obj.obj (Opposite.op T_k)) :=
        Equiv.ofBijective _ (hTermUnitBij ℓ)
      obtain ⟨_π_V, -, -, -, hBij_secV, -⟩ :=
        weil_etale_clopen_disjoint_cover_localTorsion_biproduct
          S_k ℓ ((weilEtaleSitePullback s_b).obj V) r (fun _ => T_k)
          κ_V hOpen_V hDisj_V hUniv_V
      let e_secV : (Fin r → ↥(L_Tk.obj.obj (Opposite.op T_k))) ≃
          ↥(L_BV.obj.obj (Opposite.op T_k)) :=
        Equiv.ofBijective _ (hBij_secV T_k)
      let E_dom : (Fin r → ULift.{u} (ZMod ℓ)) ≃ D_b :=
        (Equiv.piCongrRight (fun _ => e_unit)).trans
          (e_secV.trans (sheafIsoAppEquiv (CategoryTheory.asIso ι_pull_V) (Opposite.op T_k)))
      have hCard_ulift : Nat.card (ULift.{u} (ZMod ℓ)) = ℓ :=
        (Nat.card_ulift (ZMod ℓ)).trans
          (Nat.card_eq_fintype_card.trans (ZMod.card ℓ))
      haveI : Finite (ULift.{u} (ZMod ℓ)) := Finite.of_fintype (ULift.{u} (ZMod ℓ))
      haveI : Finite (Fin r → ULift.{u} (ZMod ℓ)) := Pi.finite
      haveI : Finite D_b := Finite.of_equiv (Fin r → ULift.{u} (ZMod ℓ)) E_dom
      have hCard_D : Nat.card D_b = ℓ ^ r := by
        rw [← Nat.card_congr E_dom, Nat.card_pi]
        have hprod : (∏ _i : Fin r, Nat.card (ULift.{u} (ZMod ℓ))) = ∏ _i : Fin r, ℓ :=
          Finset.prod_congr rfl (fun _ _ => hCard_ulift)
        rw [hprod, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

      
      let Y_b := CategoryTheory.Limits.pullback π_bar.left s_b
      let snd_b := CategoryTheory.Limits.pullback.snd π_bar.left s_b
      let fst_b := CategoryTheory.Limits.pullback.fst π_bar.left s_b
      let F' := weilEtaleLocalTorsionSheaf Y_b ℓ ((weilEtaleSitePullback fst_b).obj W)
      let C_b := ↥((pb_b.obj
        (weilEtaleHigherDirectImage π_bar.left 2
          (weilEtaleLocalTorsionSheaf Y_bar.left ℓ W))).obj.obj (Opposite.op T_k))
      let ι_z_i : Fin r → Quiver.Hom Y_b Y_V := fun i =>
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.comp snd_b (s_z i))
          fst_b
          ((CategoryTheory.Category.assoc snd_b (s_z i) (Fgt_V.obj V).hom).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp snd_b) (hs_z_eq i)).trans
              (CategoryTheory.Limits.pullback.condition (f := π_bar.left) (g := s_b)).symm))
      let H_i : Fin r → Type u := fun i =>
        weilEtaleLocalTorsionH Y_b ℓ ((weilEtaleSitePullback (ι_z_i i)).obj W_diag) 2

      obtain ⟨_hc_pbc, _hr_pbc, ⟨e_pbc⟩⟩ := hPBC_sec W 2 s_b hs_b
      obtain ⟨e_eval2⟩ := (hHigherDirEval Y_b snd_b F' 2).1
      obtain ⟨π_W, hπW_diag, hπW_off, -, -, hBij_HW⟩ :=
        weil_etale_clopen_disjoint_cover_localTorsion_biproduct
          Y_b ℓ ((weilEtaleSitePullback fst_b).obj W) r _ κ_W hOpen_W hDisj_W hUniv_W
      let E_cod : C_b ≃ (∀ i : Fin r, H_i i) :=
        (sheafIsoAppEquiv e_pbc (Opposite.op T_k)).trans
          (e_eval2.toEquiv.trans (Equiv.ofBijective _ (hBij_HW 2)))

      have hFin_Hi : ∀ i : Fin r, Finite (H_i i) :=
        fun i => (hFib_transfer (s_z i) s_b (hs_z_eq i) hs_b).1
      have hCard_Hi : ∀ i : Fin r, Nat.card (H_i i) = ℓ :=
        fun i => (hFib_transfer (s_z i) s_b (hs_z_eq i) hs_b).2.1
      haveI : ∀ i : Fin r, Finite (H_i i) := hFin_Hi
      haveI : Finite (∀ i : Fin r, H_i i) := Pi.finite
      haveI : Finite C_b := Finite.of_equiv (∀ i : Fin r, H_i i) E_cod.symm
      have hCard_C : Nat.card C_b = ℓ ^ r := by
        rw [Nat.card_congr E_cod, Nat.card_pi]
        have hprod : (∏ i : Fin r, Nat.card (H_i i)) = ∏ _i : Fin r, ℓ :=
          Finset.prod_congr rfl (fun i _ => hCard_Hi i)
        rw [hprod, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

      
      obtain ⟨ev_fib, hev_fib⟩ :=
        hΦ_eval S_k hTriv_k s_b V W f_W hComm_W η
      let p_i : ∀ i : Fin r, weilEtaleLocalTorsionH Y_V ℓ W_diag 2 →+ H_i i :=
        fun i => Classical.choose
          (hLocPullEx (ι_z_i i) ((weilEtaleSitePullback (ι_z_i i)).obj W_diag) W_diag
            (CategoryTheory.CategoryStruct.id _) 2)
      have hp_i : ∀ i : Fin r,
          WeilIsLocalTorsionPullback (ι_z_i i)
            ((weilEtaleSitePullback (ι_z_i i)).obj W_diag) W_diag
            (CategoryTheory.CategoryStruct.id _) ℓ 2 (p_i i) :=
        fun i => (Classical.choose_spec
          (hLocPullEx (ι_z_i i) ((weilEtaleSitePullback (ι_z_i i)).obj W_diag) W_diag
            (CategoryTheory.CategoryStruct.id _) 2)).1
      have hv_i : ∀ i : Fin r, p_i i η ≠ 0 :=
        fun i => (hFib_transfer (s_z i) s_b (hs_z_eq i) hs_b).2.2 (p_i i) (hp_i i)

      let Φ_stalk := ((pb_b.map (Φ_of V W f_W hComm_W η)).hom.app (Opposite.op T_k)).hom
      let Fℤ_Yb := (CategoryTheory.constantSheaf Y_b.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      let proj_W : ∀ j : Fin r,
          weilEtaleLocalTorsionH Y_b ℓ ((weilEtaleSitePullback fst_b).obj W) 2 →+ H_i j :=
        fun j => (CategoryTheory.Abelian.Ext.mk₀ (π_W j)).postcomp Fℤ_Yb (Nat.add_zero 2)

      have hDiagProj :
          ∀ (i j : Fin r) (x : H_i i),
            proj_W j (weilEtaleLocalTorsionMapH Y_b ℓ (κ_W i) 2 x) =
              if h : i = j then h ▸ x else 0 := by
        intro i j x
        have hcomp :
            proj_W j (weilEtaleLocalTorsionMapH Y_b ℓ (κ_W i) 2 x) =
              x.comp
                (CategoryTheory.Abelian.Ext.mk₀
                  (CategoryTheory.CategoryStruct.comp
                    (weilEtaleLocalTorsionMap Y_b ℓ (κ_W i)) (π_W j)))
                (Nat.add_zero 2) := by
          change (x.comp
              (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap Y_b ℓ (κ_W i)))
              (Nat.add_zero 2)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (π_W j)) (Nat.add_zero 2) = _
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        rw [hcomp]
        split_ifs with hij
        · subst hij
          rw [hπW_diag i, CategoryTheory.Abelian.Ext.comp_mk₀_id]
        · rw [hπW_off i j hij, CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero]

      have hEvalCoord :
          ∀ (c : Fin r → ULift.{u} (ZMod ℓ)) (j : Fin r),
            proj_W j (ev_fib (Φ_stalk (E_dom c))) = (c j).down.val • p_i j η := by
        intro c j
        have hsum1 :
            ev_fib (Φ_stalk (E_dom c)) =
              ∑ i : Fin r, (c i).down.val • weilEtaleLocalTorsionMapH Y_b ℓ (κ_W i) 2 (p_i i η) := by
          change ev_fib (Φ_stalk ((ι_pull_V.hom.app (Opposite.op T_k)).hom
            (∑ i : Fin r,
              (((weilEtaleLocalTorsionMap S_k ℓ (κ_V i)).hom.app (Opposite.op T_k)).hom
                ((CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (CategoryTheory.CategoryStruct.id L_Tk)).hom (c i)))))) = _
          rw [map_sum, map_sum, map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          exact hev_fib (κ_V i) (s_z i) (hκV_fst i) (hs_z_eq i)
            (κ_W i) (hκW_fst i) (p_i i) (hp_i i) (c i)
        rw [hsum1, map_sum]
        rw [Finset.sum_eq_single j]
        · rw [map_nsmul, hDiagProj j j (p_i j η), dif_pos rfl]
        · intro i _ hij
          rw [map_nsmul, hDiagProj i j (p_i i η), dif_neg hij, nsmul_zero]
        · intro hj_abs
          exact absurd (Finset.mem_univ j) hj_abs

      have hInj_Φ : Function.Injective Φ_stalk := by
        intro x₁ x₂ hx
        have hc_eq : E_dom.symm x₁ = E_dom.symm x₂ := by
          apply funext
          intro j
          have hcoord :
              (E_dom.symm x₁ j).down.val • p_i j η =
                (E_dom.symm x₂ j).down.val • p_i j η := by
            rw [← hEvalCoord (E_dom.symm x₁) j, ← hEvalCoord (E_dom.symm x₂) j,
              E_dom.apply_symm_apply x₁, E_dom.apply_symm_apply x₂, hx]
          exact (hPrimeGenBij (H_i j) (hCard_Hi j)
            ((hModAnn Y_b ((weilEtaleSitePullback (ι_z_i j)).obj W_diag)).2 2)
            (p_i j η) (hv_i j)).injective hcoord
        calc
          x₁ = E_dom (E_dom.symm x₁) := (E_dom.apply_symm_apply x₁).symm
          _ = E_dom (E_dom.symm x₂) := by rw [hc_eq]
          _ = x₂ := E_dom.apply_symm_apply x₂

      obtain ⟨e_CD⟩ := Finite.card_eq.mp (hCard_C.trans hCard_D.symm)
      have hBij_comp : Function.Bijective (e_CD ∘ Φ_stalk) :=
        Finite.injective_iff_bijective.mp (e_CD.injective.comp hInj_Φ)
      have hΦ_eq : (Φ_stalk : D_b → C_b) = e_CD.symm ∘ (e_CD ∘ Φ_stalk) :=
        funext fun x => (e_CD.symm_apply_apply (Φ_stalk x)).symm
      change Function.Bijective Φ_stalk
      rw [hΦ_eq]
      exact e_CD.symm.bijective.comp hBij_comp

    intro V₂ V' _hAff_V₂ _hAff_V' w₁ W₂ W'₂ w_tilde₁ f_W₂ hComm_W₂ f_W'₂ hPb_W'₂
      _Y_V₂ _j_diag₂ _W₂_diag η₂ hFib_η₂
    have hComm_W'₂ :
        CategoryTheory.CategoryStruct.comp f_W'₂ (Fgt_V.obj V').hom =
          CategoryTheory.CategoryStruct.comp (Fgt_Y.obj W'₂).hom π_bar.left :=
      (congrArg (f_W'₂ ≫ ·) (CategoryTheory.Over.w (Fgt_V.map w₁)).symm).trans
        ((CategoryTheory.Category.assoc f_W'₂ _ _).symm.trans
          ((congrArg (· ≫ (Fgt_V.obj V₂).hom) hPb_W'₂.w.symm).trans
            ((CategoryTheory.Category.assoc _ f_W₂ _).trans
              ((congrArg ((Fgt_Y.map w_tilde₁).left ≫ ·) hComm_W₂).trans
                ((CategoryTheory.Category.assoc _ _ π_bar.left).symm.trans
                  (congrArg (· ≫ π_bar.left)
                    (CategoryTheory.Over.w (Fgt_Y.map w_tilde₁))))))))

    obtain ⟨e_diag, he_diag_fst, hTransfer⟩ :=
      hDiagTransfer S_k Y_bar V_bar π_bar V₂ V' w₁ W₂ W'₂ w_tilde₁
        f_W₂ hComm_W₂ f_W'₂ hComm_W'₂ hPb_W'₂
    let w_YV := (Fgt_Y.map ((weilEtaleSitePullback π_bar.left).map w₁)).left
    obtain ⟨p_wYV, hp_wYV, -⟩ :=
      hLocPullEx w_YV _ _ e_diag.hom 2
    let η' := p_wYV η₂
    have hFib_η' := hTransfer η₂ hFib_η₂ p_wYV hp_wYV

    let Φ₂ := Φ_of V₂ W₂ f_W₂ hComm_W₂ η₂
    let Φ' := Φ_of V' W'₂ f_W'₂ hComm_W'₂ η'
    refine ⟨Φ₂, Φ', ?_, ?_⟩
    · exact hΦ_comm V₂ V' w₁ W₂ W'₂ w_tilde₁ f_W₂ hComm_W₂ f_W'₂ hComm_W'₂
        e_diag he_diag_fst η₂ p_wYV hp_wYV
    · intro s_b hs_b
      exact ⟨@hc_all S_k V_bar.left s_b, @hr_all S_k V_bar.left s_b,
        hUniformStalkBij V₂ W₂ f_W₂ hComm_W₂ η₂ hFib_η₂ s_b hs_b,
        hUniformStalkBij V' W'₂ f_W'₂ hComm_W'₂ η' hFib_η' s_b hs_b⟩

theorem weil_etale_rel_curve_cover_baseChange_vanishing_and_clopen_diag_r2 (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (P : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
    (τ_int : Quiver.Hom ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left
      P.W_open.toScheme)
    (U₁ U₂ : P.Y.Opens)
    (g_sec : ↑(P.Y.presheaf.obj (Opposite.op U₁)))
    (u₁₂ : Units ↑(P.Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂))))
    (V₂ : E.V_bar.left.Etale)
    (h₂ : Quiver.Hom V₂ P.V)
    (v₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
    (W₂ : E.Y_bar.left.Etale)
    (h_W₂ : Quiver.Hom W₂ P.W)
    (f_W₂ : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
    (x₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left)
    (V' : E.V_bar.left.Etale)
    (w₁ : Quiver.Hom V' V₂)
    (v'₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left)
    (hSec₁ :
      CategoryTheory.CategoryStruct.comp τ_int
          (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar) =
        CategoryTheory.CategoryStruct.id
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left ∧
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι) ∧
        τ_int.base P.v = P.e_W.hom.base P.x)
    (hSec₂ :
      U₁ ≤ P.W_open ∧
        (U₂ : Set ↥P.Y) =
          (Set.range (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι).base)ᶜ ∧
        U₁ ⊔ U₂ = ⊤ ∧
        (P.Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
          (u₁₂ : ↑(P.Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) ∧
        ∀ (s_v : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
            ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left)
          (pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)))
          (C_v : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_Cv : Quiver.Hom C_v.left P.Y)
          (P_pt : ↥C_v.left)
          (hP_mem : P_pt ∈ (TopologicalSpace.Opens.map ι_Cv.base).obj U₁),
          CategoryTheory.CategoryStruct.comp s_v
              (CategoryTheory.CategoryStruct.comp
                ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).hom
                E.V_bar.hom) =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
          CategoryTheory.IsPullback ι_Cv C_v.hom P.f_bar s_v →
          ι_Cv.base P_pt =
            (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι).base (s_v.base pt_k) →
          Ideal.span {(C_v.left.presheaf.germ
              ((TopologicalSpace.Opens.map ι_Cv.base).obj U₁) P_pt hP_mem).hom
            ((ι_Cv.app U₁).hom g_sec)} =
            IsLocalRing.maximalIdeal ↑(C_v.left.presheaf.stalk P_pt))
    (hAff_V₂ : AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
    (hv₂_cl : IsClosed ({v₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left))
    (hv₂_map : ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h₂).left.base v₂ = P.v)
    (hAff_W₂ : AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left)
    (hx₂_cl : IsClosed ({x₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left))
    (hx₂_fib : f_W₂.base x₂ = v₂)
    (hPb_W₂ : CategoryTheory.IsPullback
      (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map h_W₂).left)
      f_W₂
      (CategoryTheory.CategoryStruct.comp P.e_W.hom
        (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
      (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h₂).left))
    (hAff_V' : AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left)
    (hv'₂_cl : IsClosed ({v'₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left))
    (hv'₂_map : ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map w₁).left.base v'₂ = v₂) :
    ∃ (W'₂ : E.Y_bar.left.Etale)
      (w_tilde₁ : Quiver.Hom W'₂ W₂)
      (x'₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W'₂).left)
      (e_R2' : CategoryTheory.Iso
        (weilEtaleLocalTorsionSheaf E.V_bar.left ℓ V')
        (weilEtaleHigherDirectImage E.π_bar.left 2
          (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W'₂)))
      (e_R2 : CategoryTheory.Iso
        (weilEtaleLocalTorsionSheaf E.V_bar.left ℓ V₂)
        (weilEtaleHigherDirectImage E.π_bar.left 2
          (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W₂))),
      AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W'₂).left ∧
      IsClosed
        ({x'₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W'₂).left) ∧
      ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map w_tilde₁).left.base x'₂ = x₂ ∧
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage E.π_bar.left 0
          (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W'₂)) ∧
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage E.π_bar.left 0
          (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W₂)) ∧
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage E.π_bar.left 0
          (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ E.W₁)) ∧
      (∀ k_deg : ℕ, 3 ≤ k_deg →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage E.π_bar.left k_deg
            (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W'₂)) ∧
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage E.π_bar.left k_deg
            (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W₂)) ∧
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage E.π_bar.left k_deg
            (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ E.W₁))) ∧
      CategoryTheory.CategoryStruct.comp
          (weilEtaleLocalTorsionMap E.V_bar.left ℓ w₁) e_R2.hom =
        CategoryTheory.CategoryStruct.comp e_R2'.hom
          (weilEtaleHigherDirectImageMap E.π_bar.left 2
            (weilEtaleLocalTorsionMap E.Y_bar.left ℓ w_tilde₁)) :=
by
  classical
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance

  haveI : AlgebraicGeometry.IsProper E.Y_bar.hom := E.hProp_Ybar
  haveI : AlgebraicGeometry.IsProper E.V_bar.hom := E.hProp_Vbar
  haveI : AlgebraicGeometry.IsProper E.π_bar.left := E.hProp_πbar
  haveI : AlgebraicGeometry.IsProper E.f_bar₁ := E.hProp_f₁
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 E.f_bar₁ := E.hSm_f₁
  haveI : AlgebraicGeometry.IsProper P.f_bar := P.hProp_f
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 P.f_bar := P.hSm_f
  haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj E.V₁).left := E.hAff_V₁
  haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj P.V).left := P.hAff_V
  haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj V₂).left := hAff_V₂
  haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj V').left := hAff_V'
  haveI : AlgebraicGeometry.IsAffine (Fgt_Y.obj W₂).left := hAff_W₂

  
  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U_a U_b : S.Etale} (v : U_a ⟶ U_b),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S U_a U_b v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U_b).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U_a).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U_b).hom) := by
      rw [hvw]
      exact U_a.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U_b).hom U_b.prop hEt_comp

  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W] (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_B : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_B (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_k := by
      dsimp [s]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_k : PrimeSpectrum k).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_hom_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k) = x
    rw [hs_pt_spec]
    change (e_W.hom ≫ e_W.inv).base x = x
    rw [e_W.hom_inv_id]
    rfl

  have hClosedOfSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) (s : S_k ⟶ W),
        s ≫ p_W = 𝟙 S_k →
        IsClosed ({s.base pt_k} : Set ↥W) := by
    intro W _ p_W s hs
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    let ψ : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s ≫ e_W.hom)
    have hφψ : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_W.hom, e_W.hom_inv_id,
        CategoryTheory.Category.id_comp, hs, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ.hom := fun c =>
      ⟨φ_k.hom c, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφψ⟩
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := (AlgebraicGeometry.Spec.map ψ).base pt_k
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_max : q_spec.asIdeal.IsMaximal := by
      change (Ideal.comap ψ.hom (pt_k : PrimeSpectrum k).asIdeal).IsMaximal
      rw [hpt_bot]
      haveI : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      exact Ideal.comap_isMaximal_of_surjective ψ.hom hψ_surj
    have hq_cl : IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mpr hq_max
    have hpre : ({s.base pt_k} : Set ↥W) =
        e_W.hom.base ⁻¹' ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) := by
      have hq_eq : q_pt = e_W.hom.base (s.base pt_k) := by
        dsimp [q_pt, ψ]
        rw [AlgebraicGeometry.Spec.map_preimage]
        rfl
      rw [hq_eq]
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; rfl
      · intro hz
        have hz' := congrArg e_W.inv.base hz
        change (e_W.hom ≫ e_W.inv).base z = (e_W.hom ≫ e_W.inv).base (s.base pt_k) at hz'
        rwa [e_W.hom_inv_id] at hz'
    rw [hpre]
    exact hq_cl.preimage e_W.hom.continuous

  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine V]
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = 𝟙 S_k →
        s₂ ≫ p_V = 𝟙 S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V _ p_V s₁ s₂ hs₁ hs₂ hpt
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hpt
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp

  have hSmoothCurveIntegral :
      ∀ (C_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.SmoothOfRelativeDimension 1 C_ov.hom →
        IrreducibleSpace ↥C_ov.left →
        AlgebraicGeometry.IsIntegral C_ov.left := by
    intro C_ov hSm hIrred
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_ov.hom := hSm
    haveI : IrreducibleSpace ↥C_ov.left := hIrred
    have hRedStalk : ∀ x : ↥C_ov.left, _root_.IsReduced ↑(C_ov.left.presheaf.stalk x) := by
      intro x
      obtain ⟨U, _hU, V, hV, hx, e, hf⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C_ov.hom).mp hSm x
      have : Nonempty U := ⟨⟨C_ov.hom.base x, e hx⟩⟩
      obtain ⟨g_et, _, hg_et⟩ := hf.exists_etale_mvPolynomial
      letI : Algebra
          (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
          ↑Γ(C_ov.left, V) := g_et.toAlgebra
      have : Algebra.Etale
          (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
          ↑Γ(C_ov.left, V) := hg_et.toAlgebra
      have : _root_.IsReduced
          (TensorProduct
            (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
            (FractionRing (MvPolynomial (Fin 1)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U)))
            ↑Γ(C_ov.left, V)) :=
        Algebra.FormallyUnramified.isReduced_of_field
          (FractionRing (MvPolynomial (Fin 1)
            ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))) _
      have hInjPK : Function.Injective
          (Algebra.linearMap
            (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
            (FractionRing (MvPolynomial (Fin 1)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U)))) :=
        fun _ _ h => IsFractionRing.injective _ _ h
      have hInjRT : Function.Injective
          (LinearMap.rTensor ↑Γ(C_ov.left, V)
            (Algebra.linearMap
              (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
              (FractionRing (MvPolynomial (Fin 1)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))))) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ hInjPK
      have hEq : ∀ s : ↑Γ(C_ov.left, V),
          LinearMap.rTensor ↑Γ(C_ov.left, V)
            (Algebra.linearMap
              (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
              (FractionRing (MvPolynomial (Fin 1)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))))
            ((TensorProduct.lid
              (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
              ↑Γ(C_ov.left, V)).symm s) =
            (Algebra.TensorProduct.includeRight :
              ↑Γ(C_ov.left, V) →ₐ[MvPolynomial (Fin 1)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U)]
                TensorProduct
                  (MvPolynomial (Fin 1)
                    ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
                  (FractionRing (MvPolynomial (Fin 1)
                    ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U)))
                  ↑Γ(C_ov.left, V)) s := by
        intro s
        rw [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, Algebra.linearMap_apply, map_one,
          Algebra.TensorProduct.includeRight_apply]
      have hInj : Function.Injective
          (Algebra.TensorProduct.includeRight :
            ↑Γ(C_ov.left, V) →ₐ[MvPolynomial (Fin 1)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U)]
              TensorProduct
                (MvPolynomial (Fin 1)
                  ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
                (FractionRing (MvPolynomial (Fin 1)
                  ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U)))
                ↑Γ(C_ov.left, V)) := by
        intro s₁ s₂ hs
        apply (TensorProduct.lid
          (MvPolynomial (Fin 1) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U))
          ↑Γ(C_ov.left, V)).symm.injective
        apply hInjRT
        rw [hEq, hEq, hs]
      have hRedS : _root_.IsReduced ↑Γ(C_ov.left, V) :=
        isReduced_of_injective _ hInj
      let xV : ↥V := ⟨x, hx⟩
      exact @isReduced_localizationPreserves ↑Γ(C_ov.left, V) _
        (hV.primeIdealOf xV).asIdeal.primeCompl
        ↑(C_ov.left.presheaf.stalk ↑xV) _
        (TopCat.Presheaf.algebra_section_stalk C_ov.left.presheaf xV)
        (hV.isLocalization_stalk xV) hRedS
    haveI : AlgebraicGeometry.IsReduced C_ov.left :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk C_ov.left
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C_ov.left

  
  let V₂_sch := (Fgt_V.obj V₂).left
  let V'_sch := (Fgt_V.obj V').left
  let W₂_sch := (Fgt_Y.obj W₂).left
  let w₁_sch : V'_sch ⟶ V₂_sch := (Fgt_V.map w₁).left
  haveI : AlgebraicGeometry.Etale w₁_sch := hEt_of_etale_hom w₁
  haveI : AlgebraicGeometry.Etale (Fgt_Y.obj W₂).hom := W₂.prop
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj V₂).hom := V₂.prop
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj V').hom := V'.prop
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj E.V₁).hom := E.V₁.prop
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj P.V).hom := P.V.prop

  let W'₂_sch := CategoryTheory.Limits.pullback f_W₂ w₁_sch
  let p_W'₂ : W'₂_sch ⟶ W₂_sch := CategoryTheory.Limits.pullback.fst f_W₂ w₁_sch
  let f_W'₂ : W'₂_sch ⟶ V'_sch := CategoryTheory.Limits.pullback.snd f_W₂ w₁_sch
  have hAff_W'₂ : AlgebraicGeometry.IsAffine W'₂_sch := inferInstance
  haveI : AlgebraicGeometry.IsAffine W'₂_sch := hAff_W'₂
  haveI : AlgebraicGeometry.Etale p_W'₂ := inferInstance
  let W'₂ : E.Y_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (p_W'₂ ≫ (Fgt_Y.obj W₂).hom) inferInstance
  let w_tilde₁ : Quiver.Hom W'₂ W₂ :=
