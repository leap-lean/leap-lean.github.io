            exact AlgebraicGeometry.IsOpenImmersion.lift_fac v_j (W.ι ≫ π₂) hW₂
        refine ⟨(ℓ₁₂ ≫ inv Φ_δ).base ⟨z, hzW⟩, ?_⟩
        exact congrArg (fun g : W.toScheme ⟶ P_succ => g.base ⟨z, hzW⟩) hfac
