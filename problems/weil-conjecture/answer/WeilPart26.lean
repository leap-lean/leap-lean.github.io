    let shAdj_Z := CategoryTheory.sheafificationAdjunction J_Z AddCommGrpCat.{u}
    let shAdj_Z' := CategoryTheory.sheafificationAdjunction J_Z' AddCommGrpCat.{u}
    let shAdj_Y := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let shAdj_Y' := CategoryTheory.sheafificationAdjunction J_Y' AddCommGrpCat.{u}
