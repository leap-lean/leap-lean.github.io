      rw [happ k, CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
    have hLocMap_counit : ∀ {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂),
        CategoryTheory.CategoryStruct.comp (weilEtaleLocalFreeMap S m u)
          (weilEtaleLocalCounit S m U₂) = weilEtaleLocalCounit S m U₁ := by
      intro U₁ U₂ u
      let P_const : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R) :=
        (CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R)
      let η_const : Quiver.Hom P_const oneR.obj :=
        (CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).unit.app P_const
