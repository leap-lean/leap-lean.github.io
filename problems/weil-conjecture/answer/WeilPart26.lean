        exact (CategoryTheory.Category.assoc (bwd a W' γ).1 ((B a).map u).left
          (CategoryTheory.Limits.pullback.fst W.hom (σ a))).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (bwd a W' γ).1) hmap_fst).trans
