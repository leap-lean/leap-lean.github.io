      · intro q hq
        omega
      · exact (hModel.2.1 r₀).comp (hTermCounitBij S_k (ℓ ^ r₀))

    | succ δ₀ ih_δ =>
      let P_d := weilPolyP1Over k δ₀
      let P_d1 := weilPolyP1Over k (δ₀ + 1)
