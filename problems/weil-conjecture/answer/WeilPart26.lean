            (CategoryTheory.Category.assoc _ _ _).symm))
  have : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift E.g_Y₁ E.f_bar₁ E.hComm_Y₁) := E.hClosed_Y₁
  have : AlgebraicGeometry.IsClosedImmersion e_sym_V₁.hom := inferInstance
  have hCl_ν₁ : AlgebraicGeometry.IsClosedImmersion ν₁_left :=
    Eq.mp (congrArg AlgebraicGeometry.IsClosedImmersion hν₁_eq.symm)
      (inferInstance : AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift E.g_Y₁ E.f_bar₁ E.hComm_Y₁ ≫ e_sym_V₁.hom))
  have : AlgebraicGeometry.IsClosedImmersion ν₁_left := hCl_ν₁
  have hFin_ν₁ : AlgebraicGeometry.IsFinite ν₁_left := inferInstance
  let f_W₁ : (Fgt_Y.obj E.W₁).left ⟶ (Fgt_V.obj E.V₁).left :=
    E.e_W₁.hom ≫ E.W₁_open.ι ≫ E.f_bar₁
  have hComm_W₁ :
      CategoryTheory.CategoryStruct.comp f_W₁ (Fgt_V.obj E.V₁).hom =
        CategoryTheory.CategoryStruct.comp (Fgt_Y.obj E.W₁).hom E.π_bar.left := by
    calc
      (E.e_W₁.hom ≫ E.W₁_open.ι ≫ E.f_bar₁) ≫ (Fgt_V.obj E.V₁).hom
        = E.e_W₁.hom ≫ E.W₁_open.ι ≫ (E.f_bar₁ ≫ (Fgt_V.obj E.V₁).hom) := by
            simp only [CategoryTheory.Category.assoc]
      _ = (E.e_W₁.hom ≫ (E.W₁_open.ι ≫ E.g_Y₁)) ≫ E.π_bar.left := by
            rw [← E.hComm_Y₁]
            simp only [CategoryTheory.Category.assoc]
      _ = (Fgt_Y.obj E.W₁).hom ≫ E.π_bar.left := by
            rw [E.he_W₁_hom]
  have he_W₁_diag :
      E.e_W₁.hom ≫ E.W₁_open.ι ≫ ν₁_left =
        CategoryTheory.Limits.pullback.lift f_W₁ (Fgt_Y.obj E.W₁).hom hComm_W₁ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc E.e_W₁.hom _ _).trans
        ((congrArg (E.e_W₁.hom ≫ ·) (CategoryTheory.Category.assoc E.W₁_open.ι ν₁_left _)).trans
          ((congrArg (fun u => E.e_W₁.hom ≫ E.W₁_open.ι ≫ u)
            (CategoryTheory.Limits.pullback.lift_fst E.f_bar₁ E.g_Y₁ E.hComm_Y₁.symm)).trans
            (CategoryTheory.Limits.pullback.lift_fst f_W₁ (Fgt_Y.obj E.W₁).hom hComm_W₁).symm))
    · exact (CategoryTheory.Category.assoc E.e_W₁.hom _ _).trans
        ((congrArg (E.e_W₁.hom ≫ ·) (CategoryTheory.Category.assoc E.W₁_open.ι ν₁_left _)).trans
          ((congrArg (fun u => E.e_W₁.hom ≫ E.W₁_open.ι ≫ u)
            (CategoryTheory.Limits.pullback.lift_snd E.f_bar₁ E.g_Y₁ E.hComm_Y₁.symm)).trans
            (E.he_W₁_hom.trans
              (CategoryTheory.Limits.pullback.lift_snd f_W₁ (Fgt_Y.obj E.W₁).hom hComm_W₁).symm)))

  
  let Z_PV := (Fgt_Y.obj (B_π.obj P.V)).left
  have hComm_PY_Z : P.f_bar ≫ (Fgt_V.obj P.V).hom = (P.π_Y₁ ≫ E.g_Y₁) ≫ E.π_bar.left :=
    (congrArg (P.f_bar ≫ ·) (CategoryTheory.Over.w (Fgt_V.map P.g_V)).symm).trans
      ((CategoryTheory.Category.assoc P.f_bar _ _).symm.trans
        ((congrArg (· ≫ (Fgt_V.obj E.V₁).hom) P.hComm_Y₁.symm).trans
          ((CategoryTheory.Category.assoc P.π_Y₁ _ _).trans
            ((congrArg (P.π_Y₁ ≫ ·) E.hComm_Y₁.symm).trans
              (CategoryTheory.Category.assoc P.π_Y₁ E.g_Y₁ E.π_bar.left).symm))))
  let ν_P : P.Y ⟶ Z_PV :=
    CategoryTheory.Limits.pullback.lift P.f_bar (P.π_Y₁ ≫ E.g_Y₁) hComm_PY_Z
  have hFin_νP : AlgebraicGeometry.IsFinite ν_P := by
    let φ_rel_P := CategoryTheory.Limits.pullback.lift P.π_Y₁ P.f_bar P.hComm_Y₁
    have : AlgebraicGeometry.IsFinite φ_rel_P := P.hFin_rel
    have : AlgebraicGeometry.IsFinite ν₁_left := hFin_ν₁
    let hPb_gV := hPb_Bπ P.g_V
    let ι_rel : CategoryTheory.Limits.pullback E.f_bar₁ (Fgt_V.map P.g_V).left ⟶ Z_PV :=
      hPb_gV.flip.lift
        (CategoryTheory.Limits.pullback.snd E.f_bar₁ (Fgt_V.map P.g_V).left)
        (CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map P.g_V).left ≫ ν₁_left)
        ((CategoryTheory.Limits.pullback.condition
          (f := E.f_bar₁) (g := (Fgt_V.map P.g_V).left)).symm.trans
          ((congrArg (CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map P.g_V).left ≫ ·)
            (CategoryTheory.Limits.pullback.lift_fst E.f_bar₁ E.g_Y₁ E.hComm_Y₁.symm).symm).trans
            (CategoryTheory.Category.assoc _ _ _).symm))
    have hPb_ιrel : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map P.g_V).left)
        ι_rel ν₁_left ((Fgt_Y.map (B_π.map P.g_V)).left) :=
      CategoryTheory.IsPullback.of_bot
        (Eq.mp
          (congrArg₂
            (fun u v => CategoryTheory.IsPullback
              (CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map P.g_V).left)
              u v ((Fgt_V.map P.g_V).left))
            (hPb_gV.flip.lift_fst _ _ _).symm
            (CategoryTheory.Limits.pullback.lift_fst E.f_bar₁ E.g_Y₁ E.hComm_Y₁.symm).symm)
          (CategoryTheory.IsPullback.of_hasPullback E.f_bar₁ (Fgt_V.map P.g_V).left))
        (hPb_gV.flip.lift_snd _ _ _).symm
        hPb_gV
    have : AlgebraicGeometry.IsFinite ι_rel :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_ιrel hFin_ν₁
    have hνP_fac : ν_P = φ_rel_P ≫ ι_rel := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Limits.pullback.lift_fst P.f_bar (P.π_Y₁ ≫ E.g_Y₁) hComm_PY_Z).trans
          ((CategoryTheory.Limits.pullback.lift_snd P.π_Y₁ P.f_bar P.hComm_Y₁).symm.trans
            ((congrArg (φ_rel_P ≫ ·) (hPb_gV.flip.lift_fst _ _ _).symm).trans
              (CategoryTheory.Category.assoc φ_rel_P ι_rel _).symm))
      · have h_snd_map :
            (Fgt_Y.map (B_π.map P.g_V)).left ≫
              CategoryTheory.Limits.pullback.snd (Fgt_V.obj E.V₁).hom E.π_bar.left =
            CategoryTheory.Limits.pullback.snd (Fgt_V.obj P.V).hom E.π_bar.left :=
          CategoryTheory.Over.w (Fgt_Y.map (B_π.map P.g_V))
        have hι_rel_snd :
            CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map P.g_V).left ≫ ν₁_left =
              ι_rel ≫ (Fgt_Y.map (B_π.map P.g_V)).left :=
          (hPb_gV.flip.lift_snd _ _ _).symm
        have h1 : P.π_Y₁ ≫ E.g_Y₁ =
            (φ_rel_P ≫ CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map P.g_V).left) ≫
              (ν₁_left ≫ CategoryTheory.Limits.pullback.snd (Fgt_V.obj E.V₁).hom E.π_bar.left) :=
          congrArg₂ (· ≫ ·)
            (CategoryTheory.Limits.pullback.lift_fst P.π_Y₁ P.f_bar P.hComm_Y₁).symm
            (CategoryTheory.Limits.pullback.lift_snd E.f_bar₁ E.g_Y₁ E.hComm_Y₁.symm).symm
        exact (CategoryTheory.Limits.pullback.lift_snd P.f_bar (P.π_Y₁ ≫ E.g_Y₁) hComm_PY_Z).trans
          (h1.trans
            (((CategoryTheory.Category.assoc φ_rel_P _ _).trans
              (congrArg (φ_rel_P ≫ ·)
                ((CategoryTheory.Category.assoc _ ν₁_left _).symm.trans
                  ((congrArg
                    (· ≫ CategoryTheory.Limits.pullback.snd (Fgt_V.obj E.V₁).hom E.π_bar.left)
                    hι_rel_snd).trans
                    ((CategoryTheory.Category.assoc ι_rel _ _).trans
                      (congrArg (ι_rel ≫ ·) h_snd_map)))))).trans
              (CategoryTheory.Category.assoc φ_rel_P ι_rel _).symm))
    exact Eq.mp (congrArg AlgebraicGeometry.IsFinite hνP_fac.symm)
      (inferInstance : AlgebraicGeometry.IsFinite (φ_rel_P ≫ ι_rel))
  have : AlgebraicGeometry.IsFinite ν_P := hFin_νP

  
  have hBaseChangeCover :
      ∀ (V_c : E.V_bar.left.Etale) (h_c : V_c ⟶ P.V)
        (W_c : E.Y_bar.left.Etale) (h_Wc : W_c ⟶ P.W)
        (f_Wc : (Fgt_Y.obj W_c).left ⟶ (Fgt_V.obj V_c).left)
        (hComm_Wc : CategoryTheory.CategoryStruct.comp f_Wc (Fgt_V.obj V_c).hom =
          CategoryTheory.CategoryStruct.comp (Fgt_Y.obj W_c).hom E.π_bar.left),
        CategoryTheory.IsPullback
          ((Fgt_Y.map h_Wc).left) f_Wc
          (CategoryTheory.CategoryStruct.comp P.e_W.hom
            (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
          ((Fgt_V.map h_c).left) →
        let Y_c := CategoryTheory.Limits.pullback P.f_bar ((Fgt_V.map h_c).left)
        let fst_c := CategoryTheory.Limits.pullback.fst P.f_bar ((Fgt_V.map h_c).left)
        let f_c := CategoryTheory.Limits.pullback.snd P.f_bar ((Fgt_V.map h_c).left)
        let W_c_open : Y_c.Opens := (TopologicalSpace.Opens.map fst_c.base).obj P.W_open
        let Z_c := (Fgt_Y.obj (B_π.obj V_c)).left
        ∃ (ν_c : Y_c ⟶ Z_c)
          (e_Wc : (Fgt_Y.obj W_c).left ≅ W_c_open.toScheme),
          AlgebraicGeometry.IsFinite ν_c ∧
          ν_c ≫ CategoryTheory.Limits.pullback.fst (Fgt_V.obj V_c).hom E.π_bar.left = f_c ∧
          ν_c ≫ CategoryTheory.Limits.pullback.snd (Fgt_V.obj V_c).hom E.π_bar.left =
            fst_c ≫ P.π_Y₁ ≫ E.g_Y₁ ∧
          e_Wc.hom ≫ W_c_open.ι ≫ ν_c =
            CategoryTheory.Limits.pullback.lift f_Wc (Fgt_Y.obj W_c).hom hComm_Wc ∧
          e_Wc.hom ≫ (fst_c ∣_ P.W_open) = (Fgt_Y.map h_Wc).left ≫ P.e_W.hom := by
    intro V_c h_c W_c h_Wc f_Wc hComm_Wc hPb_c
    let Y_c := CategoryTheory.Limits.pullback P.f_bar ((Fgt_V.map h_c).left)
    let fst_c := CategoryTheory.Limits.pullback.fst P.f_bar ((Fgt_V.map h_c).left)
    let f_c := CategoryTheory.Limits.pullback.snd P.f_bar ((Fgt_V.map h_c).left)
    let W_c_open : Y_c.Opens := (TopologicalSpace.Opens.map fst_c.base).obj P.W_open
    let Z_c := (Fgt_Y.obj (B_π.obj V_c)).left
    let hPb_hc := hPb_Bπ h_c
    let ν_c : Y_c ⟶ Z_c :=
      hPb_hc.flip.lift f_c (fst_c ≫ ν_P)
        ((CategoryTheory.Limits.pullback.condition
          (f := P.f_bar) (g := (Fgt_V.map h_c).left)).symm.trans
          ((congrArg (fst_c ≫ ·)
            (CategoryTheory.Limits.pullback.lift_fst P.f_bar (P.π_Y₁ ≫ E.g_Y₁) hComm_PY_Z).symm).trans
            (CategoryTheory.Category.assoc _ _ _).symm))
    have hPb_νc : CategoryTheory.IsPullback fst_c ν_c ν_P ((Fgt_Y.map (B_π.map h_c)).left) :=
      CategoryTheory.IsPullback.of_bot
        (Eq.mp
          (congrArg₂
            (fun u v => CategoryTheory.IsPullback fst_c u v ((Fgt_V.map h_c).left))
            (hPb_hc.flip.lift_fst _ _ _).symm
            (CategoryTheory.Limits.pullback.lift_fst P.f_bar (P.π_Y₁ ≫ E.g_Y₁) hComm_PY_Z).symm)
          (CategoryTheory.IsPullback.of_hasPullback P.f_bar ((Fgt_V.map h_c).left)))
        (hPb_hc.flip.lift_snd _ _ _).symm
        hPb_hc
    have hFin_νc : AlgebraicGeometry.IsFinite ν_c :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_νc hFin_νP
    have hνc_fst : ν_c ≫ CategoryTheory.Limits.pullback.fst (Fgt_V.obj V_c).hom E.π_bar.left = f_c :=
      hPb_hc.flip.lift_fst _ _ _
    have hνc_snd : ν_c ≫ CategoryTheory.Limits.pullback.snd (Fgt_V.obj V_c).hom E.π_bar.left =
        fst_c ≫ P.π_Y₁ ≫ E.g_Y₁ :=
      (congrArg (ν_c ≫ ·) (CategoryTheory.Over.w (Fgt_Y.map (B_π.map h_c))).symm).trans
        ((CategoryTheory.Category.assoc ν_c _ _).symm.trans
          ((congrArg (· ≫ _) (hPb_hc.flip.lift_snd _ _ _)).trans
            ((CategoryTheory.Category.assoc fst_c ν_P _).trans
              (congrArg (fst_c ≫ ·)
                (CategoryTheory.Limits.pullback.lift_snd P.f_bar (P.π_Y₁ ≫ E.g_Y₁) hComm_PY_Z)))))
    have hIsoSq_eW : CategoryTheory.IsPullback
        P.e_W.hom
        (CategoryTheory.CategoryStruct.comp P.e_W.hom
          (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
        (P.W_open.ι ≫ P.f_bar)
        (𝟙 (Fgt_V.obj P.V).left) :=
      CategoryTheory.IsPullback.of_horiz_isIso
        ⟨(CategoryTheory.Category.comp_id _).symm⟩
    have hPb_c' : CategoryTheory.IsPullback
        ((Fgt_Y.map h_Wc).left ≫ P.e_W.hom)
        f_Wc
        (P.W_open.ι ≫ P.f_bar)
        ((Fgt_V.map h_c).left) :=
      Eq.mp
        (congrArg
          (CategoryTheory.IsPullback ((Fgt_Y.map h_Wc).left ≫ P.e_W.hom) f_Wc
            (P.W_open.ι ≫ P.f_bar))
          (CategoryTheory.Category.comp_id ((Fgt_V.map h_c).left)))
        (hPb_c.paste_horiz hIsoSq_eW)
    have hPb_open : CategoryTheory.IsPullback
        (fst_c ∣_ P.W_open)
        (W_c_open.ι ≫ f_c)
        (P.W_open.ι ≫ P.f_bar)
        ((Fgt_V.map h_c).left) :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst_c P.W_open).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback P.f_bar ((Fgt_V.map h_c).left))
    let e_Wc : (Fgt_Y.obj W_c).left ≅ W_c_open.toScheme :=
      CategoryTheory.IsPullback.isoIsPullback P.W_open.toScheme (Fgt_V.obj V_c).left
        hPb_c' hPb_open
    have he_Wc_snd : e_Wc.hom ≫ (W_c_open.ι ≫ f_c) = f_Wc :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd
        P.W_open.toScheme (Fgt_V.obj V_c).left hPb_c' hPb_open
    have he_Wc_fst : e_Wc.hom ≫ (fst_c ∣_ P.W_open) = (Fgt_Y.map h_Wc).left ≫ P.e_W.hom :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst
        P.W_open.toScheme (Fgt_V.obj V_c).left hPb_c' hPb_open
    refine ⟨ν_c, e_Wc, hFin_νc, hνc_fst, hνc_snd, ?_, he_Wc_fst⟩
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc e_Wc.hom _ _).trans
        ((congrArg (e_Wc.hom ≫ ·)
          ((CategoryTheory.Category.assoc W_c_open.ι ν_c _).trans
            (congrArg (W_c_open.ι ≫ ·) hνc_fst))).trans
          (he_Wc_snd.trans
            (CategoryTheory.Limits.pullback.lift_fst f_Wc (Fgt_Y.obj W_c).hom hComm_Wc).symm))
    · have hhWc_w : (Fgt_Y.map h_Wc).left ≫ (Fgt_Y.obj P.W).hom = (Fgt_Y.obj W_c).hom :=
        CategoryTheory.Over.w (Fgt_Y.map h_Wc)
      have hstep1 : (e_Wc.hom ≫ W_c_open.ι ≫ ν_c) ≫
          CategoryTheory.Limits.pullback.snd (Fgt_V.obj V_c).hom E.π_bar.left =
          e_Wc.hom ≫ (W_c_open.ι ≫ fst_c) ≫ (P.π_Y₁ ≫ E.g_Y₁) :=
        (CategoryTheory.Category.assoc e_Wc.hom _ _).trans
          (congrArg (e_Wc.hom ≫ ·)
            ((CategoryTheory.Category.assoc W_c_open.ι ν_c _).trans
              ((congrArg (W_c_open.ι ≫ ·) hνc_snd).trans
                (CategoryTheory.Category.assoc W_c_open.ι fst_c _).symm)))
      have hstep2 : e_Wc.hom ≫ (W_c_open.ι ≫ fst_c) ≫ (P.π_Y₁ ≫ E.g_Y₁) =
          (Fgt_Y.obj W_c).hom :=
        (congrArg (fun u => e_Wc.hom ≫ u ≫ (P.π_Y₁ ≫ E.g_Y₁))
          (AlgebraicGeometry.morphismRestrict_ι fst_c P.W_open).symm).trans
          ((congrArg (e_Wc.hom ≫ ·) (CategoryTheory.Category.assoc _ P.W_open.ι _)).trans
            ((CategoryTheory.Category.assoc e_Wc.hom _ _).symm.trans
              ((congrArg (· ≫ (P.W_open.ι ≫ P.π_Y₁ ≫ E.g_Y₁)) he_Wc_fst).trans
                ((CategoryTheory.Category.assoc _ P.e_W.hom _).trans
                  ((congrArg ((Fgt_Y.map h_Wc).left ≫ ·) P.he_W_hom).trans hhWc_w)))))
      exact hstep1.trans
        (hstep2.trans
          (CategoryTheory.Limits.pullback.lift_snd f_Wc (Fgt_Y.obj W_c).hom hComm_Wc).symm)

  have hComm_W'₂ :
      CategoryTheory.CategoryStruct.comp f_W'₂ (Fgt_V.obj V').hom =
        CategoryTheory.CategoryStruct.comp (Fgt_Y.obj W'₂).hom E.π_bar.left :=
    (congrArg (f_W'₂ ≫ ·) (CategoryTheory.Over.w (Fgt_V.map w₁)).symm).trans
      ((CategoryTheory.Category.assoc f_W'₂ _ _).symm.trans
        ((congrArg (· ≫ (Fgt_V.obj V₂).hom) hPb_W'₂.w.symm).trans
          ((CategoryTheory.Category.assoc _ f_W₂ _).trans
            ((congrArg ((Fgt_Y.map w_tilde₁).left ≫ ·) hComm_W₂).trans
              ((CategoryTheory.Category.assoc _ _ E.π_bar.left).symm.trans
                (congrArg (· ≫ E.π_bar.left)
                  (CategoryTheory.Over.w (Fgt_Y.map w_tilde₁))))))))

  have hPb_W'₂_P : CategoryTheory.IsPullback
      ((Fgt_Y.map (w_tilde₁ ≫ h_W₂)).left) f_W'₂
      (CategoryTheory.CategoryStruct.comp P.e_W.hom
        (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
      ((Fgt_V.map (w₁ ≫ h₂)).left) := by
    have hm1 : (Fgt_Y.map (w_tilde₁ ≫ h_W₂)).left =
        (Fgt_Y.map w_tilde₁).left ≫ (Fgt_Y.map h_W₂).left := rfl
    have hm2 : (Fgt_V.map (w₁ ≫ h₂)).left =
        (Fgt_V.map w₁).left ≫ (Fgt_V.map h₂).left := rfl
    rw [hm1, hm2]
    exact hPb_W'₂.paste_horiz hPb_W₂

  obtain ⟨ν₂_left, e_W₂, hFin_ν₂, hν₂_fst, hν₂_snd, he_W₂_diag, he_W₂_fst⟩ :=
    hBaseChangeCover V₂ h₂ W₂ h_W₂ f_W₂ hComm_W₂ hPb_W₂
  obtain ⟨ν'_left, e_W'₂, hFin_ν', hν'_fst, hν'_snd, he_W'₂_diag, -⟩ :=
    hBaseChangeCover V' (w₁ ≫ h₂) W'₂ (w_tilde₁ ≫ h_W₂) f_W'₂ hComm_W'₂ hPb_W'₂_P

  
  have hFiberSetup :
      ∀ (V_c : E.V_bar.left.Etale) [AlgebraicGeometry.IsAffine (Fgt_V.obj V_c).left]
        (Y_c : AlgebraicGeometry.Scheme.{u})
        (f_c : Y_c ⟶ (Fgt_V.obj V_c).left)
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_c]
        (m_c : ℕ) (τ_c : Fin m_c → ((Fgt_V.obj V_c).left ⟶ Y_c))
        (hτ_sec_c : ∀ a : Fin m_c, τ_c a ≫ f_c = 𝟙 (Fgt_V.obj V_c).left)
        (hτ_disj_c : _root_.Pairwise fun a b : Fin m_c =>
          Disjoint (Set.range (τ_c a).base) (Set.range (τ_c b).base))
        (W_c_open : Y_c.Opens)
        (hW_compl_c : (W_c_open : Set ↥Y_c) = (⋃ a : Fin m_c, Set.range (τ_c a).base)ᶜ)
        (W_c : E.Y_bar.left.Etale)
        (f_Wc : (Fgt_Y.obj W_c).left ⟶ (Fgt_V.obj V_c).left)
        (hComm_Wc : CategoryTheory.CategoryStruct.comp f_Wc (Fgt_V.obj V_c).hom =
          CategoryTheory.CategoryStruct.comp (Fgt_Y.obj W_c).hom E.π_bar.left)
        (ν_c : Y_c ⟶ (Fgt_Y.obj (B_π.obj V_c)).left)
        [AlgebraicGeometry.IsFinite ν_c]
        (hν_fst : ν_c ≫ CategoryTheory.Limits.pullback.fst (Fgt_V.obj V_c).hom E.π_bar.left = f_c)
        (e_Wc : (Fgt_Y.obj W_c).left ≅ W_c_open.toScheme)
        (he_Wc : e_Wc.hom ≫ W_c_open.ι ≫ ν_c =
