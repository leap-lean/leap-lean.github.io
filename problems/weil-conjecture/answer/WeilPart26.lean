      CategoryTheory.Precoverage.generate_mem_toGrothendieck hmem_left
    refine CategoryTheory.GrothendieckTopology.superset_covering _ ?_ hgen_left
    erw [CategoryTheory.Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    refine ⟨(AlgebraicGeometry.Scheme.Etale.forget Z).obj (W i),
      (AlgebraicGeometry.Scheme.Etale.forget Z).map (j i), 𝟙 (W i).left, ?_, ?_⟩
    · exact ⟨_, 𝟙 _, _,
