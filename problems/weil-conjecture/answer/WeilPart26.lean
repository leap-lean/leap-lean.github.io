      CategoryTheory.Functor.isoWhiskerRight θ_zero E_B ≪≫
        (CategoryTheory.Functor.associator U_Y W_B Sh_B).symm ≪≫
        CategoryTheory.Functor.isoWhiskerRight e_pre_B Sh_B ≪≫
        CategoryTheory.Functor.associator pf_π U_B Sh_B ≪≫
        CategoryTheory.Functor.isoWhiskerLeft pf_π e_counit_B ≪≫
        CategoryTheory.Functor.rightUnitor pf_π
