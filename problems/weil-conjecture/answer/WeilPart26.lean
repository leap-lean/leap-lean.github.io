        Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]

    obtain ⟨R₁, hRingR₁, hAlgR₀R₁, hEtR₀R₁, hAlgR₁Ω, hTow₀₁Ω,
      r, B₁, hRingB₁, hAlgR₁B₁, e₁, hSplit_m⟩ := hSplit R₀ B₀ Ω
    letI : CommRing R₁ := hRingR₁
    letI : Algebra R₀ R₁ := hAlgR₀R₁
