      set z_a := α.comp (CategoryTheory.Abelian.Ext.mk₀ (ρ_a a)) (Nat.add_zero 2)
      have hι_Λ : (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp (Λ₀ 2 F_B z_a) (Nat.zero_add 2) = 0 := by
        have h1 : Λ₀ 2 F_B z_a =
