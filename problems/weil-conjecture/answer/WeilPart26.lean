  intro Z V₀ hSh_loc hSh_zero Φ q₀ q hq₀ hSub_q₀ hSub_q
  let I_Z := weilAltClosedComplIdeal Z V₀
  let Z_c := I_Z.subscheme
  let i_Z : Z_c ⟶ Z := I_Z.subschemeι
