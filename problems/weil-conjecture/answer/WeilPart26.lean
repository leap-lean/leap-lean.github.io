        let Fgt_Vbar := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
        let Fgt_Ybar := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
        let V₂_sch := (Fgt_Vbar.obj V₂).left
