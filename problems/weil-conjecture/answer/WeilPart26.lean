      fun a => Classical.choose_spec (h_ex a)
    let h_tot : ℬ ⟶ 𝒮_I :=
      CategoryTheory.ObjectProperty.homMk
        { app := fun opW =>
            AddCommGrpCat.ofHom
              { toFun := fun y a γ =>
                  (((h_a a).hom.app opW).hom y) 0 (bwd a (Opposite.unop opW) γ)
