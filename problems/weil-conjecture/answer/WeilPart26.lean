  have hAbsConstZ :
      ∀ {C₁ C₂ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₁]
        [CategoryTheory.Category.{u, u + 1} C₂]
        (J₁ : CategoryTheory.GrothendieckTopology C₁)
        (J₂ : CategoryTheory.GrothendieckTopology C₂)
        [CategoryTheory.HasSheafify J₁ AddCommGrpCat.{u}]
        [CategoryTheory.HasSheafify J₂ AddCommGrpCat.{u}]
        (B : CategoryTheory.Functor C₂ C₁)
        [B.IsContinuous J₂ J₁]
        {T₁ : C₁} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : C₂} (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let Fℤ₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj Aℤ
        let Pℤ₁ := (CategoryTheory.Functor.const C₁ᵒᵖ).obj Aℤ
        let Pℤ₂ := (CategoryTheory.Functor.const C₂ᵒᵖ).obj Aℤ
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
        (adj₂.homEquiv Aℤ (pf.obj Fℤ₁)).symm (adj₁.unit.app Aℤ ≫ Fℤ₁.obj.map (Opposite.op τ)) =
        ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv Pℤ₂ (pf.obj Fℤ₁)).symm
          (CategoryTheory.Functor.whiskerLeft B.op
            ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app Pℤ₁)) := by
    intro C₁ C₂ _ _ J₁ J₂ _ _ B _ T₁ hT₁ T₂ hT₂ Aℤ pf Fℤ₁ Pℤ₁ Pℤ₂ adj₁ adj₂ τ
    let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let uℤ := (shAdj₂.homEquiv Pℤ₂ (pf.obj Fℤ₁)).symm
      (CategoryTheory.Functor.whiskerLeft B.op (shAdj₁.unit.app Pℤ₁))
    apply (adj₂.homEquiv Aℤ (pf.obj Fℤ₁)).injective
    rw [(adj₂.homEquiv Aℤ (pf.obj Fℤ₁)).apply_symm_apply]
    change adj₁.unit.app Aℤ ≫ Fℤ₁.obj.map (Opposite.op τ) =
      (shAdj₂.unit.app Pℤ₂).app (Opposite.op T₂) ≫ uℤ.hom.app (Opposite.op T₂)
    have huℤ : shAdj₂.unit.app Pℤ₂ ≫ uℤ.hom =
        CategoryTheory.Functor.whiskerLeft B.op (shAdj₁.unit.app Pℤ₁) :=
      (shAdj₂.homEquiv Pℤ₂ (pf.obj Fℤ₁)).apply_symm_apply _
    have hR := congrArg (fun α => α.app (Opposite.op T₂)) huℤ
    dsimp at hR
    rw [hR]
    have hnat := (shAdj₁.unit.app Pℤ₁).naturality (Opposite.op τ)
    dsimp [Pℤ₁] at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm

  have hPullbackCompInvFst :
      ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}}
        (h : Quiver.Hom X Y) (π₂ : Quiver.Hom Y Z) (π₁ : Quiver.Hom X Z)
        (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁) (W₀ : Z.Etale),
        letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
            CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
          fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
            CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
          fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
        let e_B : CategoryTheory.Iso (weilEtaleSitePullback π₁)
            (CategoryTheory.Functor.comp (weilEtaleSitePullback π₂) (weilEtaleSitePullback h)) :=
          CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
            (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
        CategoryTheory.CategoryStruct.comp
          ((e_B.inv.app W₀).left)
          (CategoryTheory.Limits.pullback.fst W₀.hom π₁) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback π₂).obj W₀).hom h)
          (CategoryTheory.Limits.pullback.fst W₀.hom π₂) := by
    intro X Y Z h π₂ π₁ h_eq W₀
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong P_et f :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et f :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let e_B : CategoryTheory.Iso
        (CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ π₁)
        (CategoryTheory.Functor.comp
          (CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ π₂)
          (CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ h)) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) h_eq.symm)
        (CategoryTheory.MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) h π₂)
    have h_hom :
        CategoryTheory.CategoryStruct.comp (e_B.hom.app W₀).left
          (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.fst
              ((CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ π₂).obj W₀).hom h)
            (CategoryTheory.Limits.pullback.fst W₀.hom π₂)) =
        CategoryTheory.Limits.pullback.fst W₀.hom π₁ := by
      have h1 := CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
        (P := P_et) (Q := ⊤) h π₂ W₀
      try rw [CategoryTheory.Category.assoc] at h1
      have h2 := CategoryTheory.MorphismProperty.Over.pullbackCongr_hom_app_left_fst
        (P := P_et) (Q := ⊤) h_eq.symm W₀
      let c_hom := (CategoryTheory.MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) h_eq.symm).hom.app W₀
      let p_hom := (CategoryTheory.MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) h π₂).hom.app W₀
      have he_left : (e_B.hom.app W₀).left = CategoryTheory.CategoryStruct.comp c_hom.left p_hom.left := rfl
      exact (congrArg (fun m => CategoryTheory.CategoryStruct.comp m _) he_left).trans
        ((CategoryTheory.Category.assoc c_hom.left p_hom.left _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp c_hom.left) h1).trans h2))
    have h_inv_hom : CategoryTheory.CategoryStruct.comp (e_B.inv.app W₀).left (e_B.hom.app W₀).left =
        CategoryTheory.CategoryStruct.id _ :=
      congrArg (fun m :
          ((CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ π₂ ⋙
            CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ h).obj W₀) ⟶ _ => m.left)
        (e_B.inv_hom_id_app W₀)
    exact (congrArg (fun m => CategoryTheory.CategoryStruct.comp (e_B.inv.app W₀).left m) h_hom.symm).trans
      ((CategoryTheory.Category.assoc _ _ _).symm.trans
        ((congrArg (fun m => CategoryTheory.CategoryStruct.comp m _) h_inv_hom).trans
          (CategoryTheory.Category.id_comp _)))

