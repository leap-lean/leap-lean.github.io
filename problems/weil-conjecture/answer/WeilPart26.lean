        apply AddCommGrpCat.ext
        rintro ⟨z⟩
        exact map_zsmul f.hom z s
      have hVet_subterm : ∀ {Y : Z.Etale} (m₁ m₂ : Y ⟶ V_et), m₁ = m₂ := by
        intro Y m₁ m₂
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · have hw : m₁.left ≫ V.ι = m₂.left ≫ V.ι := m₁.w.trans m₂.w.symm
          exact (CategoryTheory.cancel_mono V.ι).mp hw
        · exact Subsingleton.elim _ _
      let W_of : ∀ (U : Z.Etale), U.left.Opens → Z.Etale := fun U O =>
        have : AlgebraicGeometry.Etale U.hom := U.prop
        CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ U.hom) inferInstance
      let j_of : ∀ (U : Z.Etale) (O : U.left.Opens), W_of U O ⟶ U := fun U O =>
        CategoryTheory.MorphismProperty.Over.homMk O.ι rfl trivial
      have hSep_opens : ∀ (U : Z.Etale) {I : Type u} (O : I → U.left.Opens),
          (∀ x : ↥U.left, ∃ i : I, x ∈ O i) →
          ∀ (s₁ s₂ : ↥(G.obj.obj (Opposite.op U))),
            (∀ i : I, (G.obj.map (j_of U (O i)).op).hom s₁ =
              (G.obj.map (j_of U (O i)).op).hom s₂) →
            s₁ = s₂ := by
