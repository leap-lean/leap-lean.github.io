theorem weil_etale_polyP1_pinned_closed_point_local_effacement (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (ι_aff : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (tr_Pd : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r))
    (hModel : WeilIsPolyP1ModelTracePkg k ℓ Ψ ι_aff tr_Pd)
    (hChartIndep : WeilChartTraceIndependent k ℓ Ψ ι_aff tr_Pd)
    (δ r : ℕ)
    (U₀ : (weilPolyP1Over k δ).left.Etale)
    (u₀ : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₀).left
      (weilAffineSpaceOver k δ).left)
    (x₀ : ↥((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₀).left)
    (hx₀ : IsClosed ({x₀} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₀).left))
    (hAff₀ : AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₀).left)
    (hEt_u₀ : AlgebraicGeometry.Etale u₀)
    (hu₀_comm : CategoryTheory.CategoryStruct.comp u₀ (ι_aff δ) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U₀).hom) :
    ∃ (U' : (weilPolyP1Over k δ).left.Etale)
      (v₀ : Quiver.Hom U' U₀)
      (x'₀ : ↥((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U').left),
      AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U').left ∧
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).map v₀).left.base x'₀ = x₀ ∧
      (∀ (q : ℕ), q < 2 * δ →
        ∀ z : weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) U' q,
          weilEtaleLocalTorsionMapH (weilPolyP1Over k δ).left (ℓ ^ r) v₀ q z = 0) ∧
      Function.Bijective
        (fun z : weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) U' (2 * δ) =>
          tr_Pd δ r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k δ).left (ℓ ^ r) U' (2 * δ) z)) :=
by
  classical
  
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : (ℓ : k) ≠ 0 := by
    intro h0
    have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
    rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
      · exact hℓ heq.symm
    · rw [hz, zero_dvd_iff] at hdvd
      exact hPrime.ne_zero hdvd

  
  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S V₁ V₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₁).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₂).hom) := by
      rw [hvw]
      exact V₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₂).hom V₂.prop hEt_comp

  have hEquiv_comp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ} {W_et : S.Etale}
        {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S m W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro S m W_et F G α g
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hLocMap_comp :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
        {V₁ V₂ V₃ : S.Etale} (u₁ : V₁ ⟶ V₂) (u₂ : V₂ ⟶ V₃),
        weilEtaleLocalTorsionMap S m (u₁ ≫ u₂) =
          weilEtaleLocalTorsionMap S m u₁ ≫ weilEtaleLocalTorsionMap S m u₂ := by
    intro S m V₁ V₂ V₃ u₁ u₂
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S m (u₁ ≫ u₂))
        = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op (u₁ ≫ u₂)) :=
            Equiv.apply_symm_apply _ _
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
            ((weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₂) ≫
              (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁)) := by
            have hop : Opposite.op (u₁ ≫ u₂) =
                (Opposite.op u₂ ≫ Opposite.op u₁ : Opposite.op V₃ ⟶ Opposite.op V₁) := rfl
            rw [hop, CategoryTheory.Functor.map_comp]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₂)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₂)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁) := by
            have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
                (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₂) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
                (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₂) := by
              rw [← hEquiv_comp (𝟙 (weilEtaleLocalTorsionSheaf S m V₂))
                (weilEtaleLocalTorsionMap S m u₂), CategoryTheory.Category.id_comp]
              exact Equiv.apply_symm_apply _ _
            rw [h2]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            ((weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₂) ≫
              (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁)) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            ((weilEtaleLocalTorsionSheaf S m V₂).obj.map (Opposite.op u₁) ≫
              (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₁)) := by
            rw [← (weilEtaleLocalTorsionMap S m u₂).hom.naturality (Opposite.op u₁)]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            (weilEtaleLocalTorsionSheaf S m V₂).obj.map (Opposite.op u₁)) ≫
            (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap S m u₁) ≫
            (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₁) := by
            have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (weilEtaleLocalTorsionMap S m u₁) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
                (weilEtaleLocalTorsionSheaf S m V₂).obj.map (Opposite.op u₁) :=
              Equiv.apply_symm_apply _ _
            rw [h1]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap S m u₁ ≫ weilEtaleLocalTorsionMap S m u₂) :=
            (hEquiv_comp (weilEtaleLocalTorsionMap S m u₁)
              (weilEtaleLocalTorsionMap S m u₂)).symm

  have hLocMapH_comp :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
        {V₁ V₂ V₃ : S.Etale} (u₁ : V₁ ⟶ V₂) (u₂ : V₂ ⟶ V₃) (q : ℕ)
        (z : weilEtaleLocalTorsionH S m V₁ q),
        weilEtaleLocalTorsionMapH S m (u₁ ≫ u₂) q z =
          weilEtaleLocalTorsionMapH S m u₂ q (weilEtaleLocalTorsionMapH S m u₁ q z) := by
    intro S m V₁ V₂ V₃ u₁ u₂ q z
    change z.comp (CategoryTheory.Abelian.Ext.mk₀
        (weilEtaleLocalTorsionMap S m (u₁ ≫ u₂))) (Nat.add_zero q) =
      (z.comp (CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleLocalTorsionMap S m u₁)) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleLocalTorsionMap S m u₂)) (Nat.add_zero q)
    rw [hLocMap_comp S m u₁ u₂, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]

  have hLocNsmulZero :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (U : S.Etale),
        m • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U) = 0 := by
    intro S m U
    let LT := weilEtaleLocalTorsionSheaf S m U
    let J := S.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hL : CategoryTheory.Sheaf.freeYonedaHomEquiv (m • CategoryTheory.CategoryStruct.id LT) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT) ≫
          (m • CategoryTheory.CategoryStruct.id LT).hom.app (Opposite.op U) := by
      simpa using hEquiv_comp (CategoryTheory.CategoryStruct.id LT)
        (m • CategoryTheory.CategoryStruct.id LT)
    have hR : CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : LT ⟶ LT) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT) ≫
          (0 : LT ⟶ LT).hom.app (Opposite.op U) := by
      simpa using hEquiv_comp (CategoryTheory.CategoryStruct.id LT) (0 : LT ⟶ LT)
    rw [hL, hR]
    let EV : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj (Opposite.op U)
    have hEV_nsmul : (m • CategoryTheory.CategoryStruct.id LT).hom.app (Opposite.op U) =
        m • CategoryTheory.CategoryStruct.id (LT.obj.obj (Opposite.op U)) := by
      change EV.map (m • CategoryTheory.CategoryStruct.id LT) =
        m • CategoryTheory.CategoryStruct.id (EV.obj LT)
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have hEV_zero : (0 : LT ⟶ LT).hom.app (Opposite.op U) = 0 := by
      change EV.map (0 : LT ⟶ LT) = 0
      exact EV.map_zero LT LT
    have hmAM : (m • CategoryTheory.CategoryStruct.id AM : AM ⟶ AM) = 0 := by
      ext ⟨b⟩
      change ULift.up (m • b) = ULift.up 0
      simp
    rw [hEV_nsmul, hEV_zero, CategoryTheory.Preadditive.comp_nsmul, Limits.comp_zero,
      CategoryTheory.Category.comp_id, ← CategoryTheory.Category.id_comp
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT)),
      ← CategoryTheory.Preadditive.nsmul_comp, hmAM, Limits.zero_comp]

  have hMapH_congr_mod :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {m₁ m₂ : ℕ} (hm : m₁ = m₂)
        {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂) (q : ℕ),
        (∀ z : weilEtaleLocalTorsionH S m₁ V₁ q, weilEtaleLocalTorsionMapH S m₁ v q z = 0) ↔
        (∀ z : weilEtaleLocalTorsionH S m₂ V₁ q, weilEtaleLocalTorsionMapH S m₂ v q z = 0) := by
    intro S m₁ m₂ hm V₁ V₂ v q
    subst hm
    exact Iff.rfl

  have hTermCounitBij :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
        Function.Bijective
          (weilEtaleLocalTorsionCounitH S m (weilEtaleIdTerminal.{u} S) 0) := by
    intro S m
    let T := weilEtaleIdTerminal.{u} S
    let hT := weilEtaleIdTerminalIsTerminal.{u} S
    let J := S.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let LT := weilEtaleLocalTorsionSheaf S m T
    let FM := weilEtaleTorsionSheaf S m
    let counit : LT ⟶ FM := weilEtaleLocalTorsionCounit S m T
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let inv_c : FM ⟶ LT :=
      (adj_c.homEquiv AM LT).symm
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT))
    have hcounit : CategoryTheory.Sheaf.freeYonedaHomEquiv counit =
        ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)).app (Opposite.op T) :=
      Equiv.apply_symm_apply _ _
    have hUnit_eq :
        CategoryTheory.Sheaf.freeYonedaHomEquiv counit = adj_c.unit.app AM := by
      rw [hcounit]
      dsimp [T, adj_c, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp]
      ext ⟨b⟩
      simp
    have hci : counit ≫ inv_c = 𝟙 LT := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquiv_comp counit inv_c, hUnit_eq]
      calc
        adj_c.unit.app AM ≫ inv_c.hom.app (Opposite.op T)
          = adj_c.homEquiv AM LT inv_c := (adj_c.homEquiv_unit AM LT inv_c).symm
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT) :=
            Equiv.apply_symm_apply _ _
    have hic : inv_c ≫ counit = 𝟙 FM := by
      apply (adj_c.homEquiv AM FM).injective
      rw [adj_c.homEquiv_naturality_right inv_c counit]
      have h1 : adj_c.homEquiv AM LT inv_c =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT) :=
        Equiv.apply_symm_apply _ _
      rw [h1]
      change CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT) ≫
        counit.hom.app (Opposite.op T) = _
      rw [← hEquiv_comp (CategoryTheory.CategoryStruct.id LT) counit,
        CategoryTheory.Category.id_comp, hUnit_eq]
      exact (adj_c.homEquiv_unit AM FM (CategoryTheory.CategoryStruct.id FM)).symm
    let g_inv : weilEtaleTorsionH S m 0 → weilEtaleLocalTorsionH S m T 0 :=
      (CategoryTheory.Abelian.Ext.mk₀ inv_c).postcomp Fℤ (Nat.add_zero 0)
    refine Function.bijective_iff_has_inverse.mpr ⟨g_inv, ?_, ?_⟩
    · intro z
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ counit) (Nat.add_zero 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ inv_c) (Nat.add_zero 0) = z
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hci,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · intro w
      change (w.comp (CategoryTheory.Abelian.Ext.mk₀ inv_c) (Nat.add_zero 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ counit) (Nat.add_zero 0) = w
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hic,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]

  
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hNonempty_k : Nonempty ↥S_k :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := k)).mpr inferInstance
  let pt_k : ↥S_k := Classical.choice hNonempty_k
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := by
    ext c
    simp only [Ideal.mem_bot]
    constructor
    · intro hc
      by_contra hne
      exact (pt_k : PrimeSpectrum k).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hne))
    · rintro rfl
      exact (pt_k : PrimeSpectrum k).asIdeal.zero_mem

  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W]
        (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_B : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_B (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_k := by
      dsimp [s]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_k : PrimeSpectrum k).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_hom_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k) = x
    rw [hs_pt_spec]
    change (e_W.hom ≫ e_W.inv).base x = x
    rw [e_W.hom_inv_id]
    rfl

  have hClosedOfSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) (s : S_k ⟶ W),
        s ≫ p_W = 𝟙 S_k →
        IsClosed ({s.base pt_k} : Set ↥W) := by
    intro W _ p_W s hs
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    let ψ : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s ≫ e_W.hom)
    have hφψ : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_W.hom, e_W.hom_inv_id,
        CategoryTheory.Category.id_comp, hs, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ.hom := fun c =>
      ⟨φ_k.hom c, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφψ⟩
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := (AlgebraicGeometry.Spec.map ψ).base pt_k
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_max : q_spec.asIdeal.IsMaximal := by
      change (Ideal.comap ψ.hom (pt_k : PrimeSpectrum k).asIdeal).IsMaximal
      rw [hpt_bot]
      haveI : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      exact Ideal.comap_isMaximal_of_surjective ψ.hom hψ_surj
    have hq_cl : IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mpr hq_max
    have hpre : ({s.base pt_k} : Set ↥W) =
        e_W.hom.base ⁻¹' ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) := by
      have hq_eq : q_pt = e_W.hom.base (s.base pt_k) := by
        dsimp [q_pt, ψ]
        rw [AlgebraicGeometry.Spec.map_preimage]
        rfl
      rw [hq_eq]
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; rfl
      · intro hz
        have hz' := congrArg e_W.inv.base hz
        change (e_W.hom ≫ e_W.inv).base z = (e_W.hom ≫ e_W.inv).base (s.base pt_k) at hz'
        rwa [e_W.hom_inv_id] at hz'
    rw [hpre]
    exact hq_cl.preimage e_W.hom.continuous

  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine V]
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = 𝟙 S_k →
        s₂ ≫ p_V = 𝟙 S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V _ p_V s₁ s₂ hs₁ hs₂ hpt
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hpt
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp

  
  have hProjCurveNonDeg :
      ∀ (C_bar : CategoryTheory.Over S_k),
