  have hOfArrows_mem : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale)
      {I : Type u} (W : I → Z.Etale) (j : ∀ i : I, W i ⟶ U),
      (∀ x : ↥U.left, ∃ (i : I) (y : ↥(W i).left), (j i).left.base y = x) →
