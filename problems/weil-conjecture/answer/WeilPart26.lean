      (G : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ s : Quiver.Hom S_k W,
        CategoryTheory.CategoryStruct.comp s f_W = CategoryTheory.CategoryStruct.id S_k →
        CategoryTheory.Limits.IsZero ((pt W s).sheafFiber.obj G)) →
      CategoryTheory.Limits.IsZero G := by
    intro W f_W _ G hFib
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext opE
    induction opE with
    | op E =>
      apply AddCommGrpCat.ext
      intro x
      change x = 0
      let R_x : CategoryTheory.Sieve E :=
        { arrows := fun {_} u => (G.obj.map (Opposite.op u)).hom x = 0
          downward_closed := fun {Y Z} u hu g => by
            have hmap : G.obj.map (Opposite.op (g ≫ u)) =
                G.obj.map (Opposite.op u) ≫ G.obj.map (Opposite.op g) :=
              G.obj.map_comp (Opposite.op u) (Opposite.op g)
            change (G.obj.map (Opposite.op (g ≫ u))).hom x = 0
            rw [hmap]
            change (G.obj.map (Opposite.op g)).hom ((G.obj.map (Opposite.op u)).hom x) = 0
            rw [hu, map_zero] }
      let O_x : Set ↥E.left :=
        { y : ↥E.left | ∃ (E' : W.Etale) (u : Quiver.Hom E' E) (y' : ↥E'.left),
            R_x.arrows u ∧ AlgebraicGeometry.Etale u.left ∧ u.left y' = y }
      have hOpen_Ox : IsOpen O_x := by
        refine isOpen_iff_forall_mem_open.mpr ?_
        rintro y ⟨E', u, y', hu_R, hu_Et, hy'⟩
        have : AlgebraicGeometry.Etale u.left := hu_Et
        refine ⟨Set.range u.left.base, ?_, u.left.isOpenMap.isOpen_range, ⟨y', hy'⟩⟩
        rintro z ⟨z', rfl⟩
        exact ⟨E', u, z', hu_R, hu_Et, rfl⟩
      have hAll_Ox : ∀ y : ↥E.left, y ∈ O_x := by
        intro y
        have : AlgebraicGeometry.Etale E.hom := E.prop
        obtain ⟨s_E, hs_E, h_spec⟩ := hNull E.left (E.hom ≫ f_W) y
        let s : Quiver.Hom S_k W := s_E ≫ E.hom
        have hs : s ≫ f_W = CategoryTheory.CategoryStruct.id S_k :=
          (CategoryTheory.Category.assoc s_E E.hom f_W).trans hs_E
        have hZero_s : CategoryTheory.Limits.IsZero ((pt W s).sheafFiber.obj G) := hFib s hs
        let pt_E : (pt W s).fiber.obj E := ⟨s_E, rfl⟩
        have h_to0 : (pt W s).toPresheafFiber E pt_E G.obj = 0 :=
          hZero_s.eq_of_tgt _ _
        have h_eq0 : (CategoryTheory.ConcreteCategory.hom
              ((pt W s).toPresheafFiber E pt_E G.obj)) x =
            (CategoryTheory.ConcreteCategory.hom
              ((pt W s).toPresheafFiber E pt_E G.obj)) 0 := by
          rw [h_to0]
          rfl
        obtain ⟨E', u, pt_E', h_map_pt, h_map_x⟩ :=
          ((pt W s).toPresheafFiber_eq_iff' E pt_E x 0).mp h_eq0
        have hu_R : R_x.arrows u := by
          change (G.obj.map (Opposite.op u)).hom x = 0
          have hm : (G.obj.map (Opposite.op u)).hom x = (G.obj.map (Opposite.op u)).hom 0 :=
            h_map_x
          exact hm.trans (map_zero _)
        have hu_Et : AlgebraicGeometry.Etale u.left := by
          have : AlgebraicGeometry.Etale E'.hom := E'.prop
          have hw_u : u.left ≫ E.hom = E'.hom := CategoryTheory.MorphismProperty.Over.w u
          exact CategoryTheory.MorphismProperty.of_postcomp
            (@AlgebraicGeometry.Etale) u.left E.hom E.prop (hw_u.symm ▸ E'.prop)
        let pt_k : ↥S_k := (⊥ : PrimeSpectrum k)
        have h_base : s_E.base pt_k ∈ O_x := by
          refine ⟨E', u, pt_E'.1 pt_k, hu_R, hu_Et, ?_⟩
          have hs_eq : pt_E'.1 ≫ u.left = s_E := congrArg Subtype.val h_map_pt
          exact (AlgebraicGeometry.Scheme.Hom.comp_apply pt_E'.1 u.left pt_k).symm.trans
            (congrArg (fun m : Quiver.Hom S_k E.left => m pt_k) hs_eq)
        exact (specializes_iff_forall_open.mp (h_spec pt_k)) O_x hOpen_Ox h_base
      have hRx_cov : R_x ∈ W.smallEtaleTopology E := by
        change R_x ∈ W.smallGrothendieckTopology (@AlgebraicGeometry.Etale) E
        rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology W
          (Q := @AlgebraicGeometry.Etale) (le_refl _)]
        exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology E R_x).mpr hAll_Ox
      exact G.isSeparated E R_x hRx_cov x 0 (fun Y u hu => by
        have hx0 : (G.obj.map (Opposite.op u)).hom x = 0 := hu
        exact hx0.trans (map_zero _).symm)

  have hConj5 : ∀ (B : CategoryTheory.Over S_k) [AlgebraicGeometry.LocallyOfFiniteType B.hom]
      (G : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ s : Quiver.Hom S_k B.left,
        CategoryTheory.CategoryStruct.comp s B.hom = CategoryTheory.CategoryStruct.id S_k →
        Subsingleton ↑(((pb_of s).obj G).obj.obj (Opposite.op T_0))) →
      CategoryTheory.Limits.IsZero G := by
    intro B _ G hSub
    refine hZero_of_fiber B.left B.hom G (fun s hs => ?_)
    obtain ⟨e_s⟩ := hStalkIso B.left s
    have : Subsingleton ↑((CategoryTheory.Functor.comp (pb_of s) Ev_T0).obj G) := hSub s hs
    have hZero_ev : CategoryTheory.Limits.IsZero ((CategoryTheory.Functor.comp (pb_of s) Ev_T0).obj G) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro z
      exact Subsingleton.elim z 0
    exact hZero_ev.of_iso (e_s.app G).symm

  have hZero_Sk : ∀ (M : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
      Subsingleton ↑(Ev_T0.obj M) → CategoryTheory.Limits.IsZero M := by
    intro M hSub
    have : Subsingleton ↑(Ev_T0.obj M) := hSub
    have hZero_ev : CategoryTheory.Limits.IsZero (Ev_T0.obj M) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro z
      exact Subsingleton.elim z 0
    refine hZero_of_fiber S_k (CategoryTheory.CategoryStruct.id S_k) M (fun s hs => ?_)
    have hs_id : s = CategoryTheory.CategoryStruct.id S_k :=
      (CategoryTheory.Category.comp_id s).symm.trans hs
    subst hs_id
    exact hZero_ev.of_iso (e_stalk_0.app M).symm

  have hConj4a : ∀ (G H : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}) (Φ : Quiver.Hom G H),
      Function.Bijective (Φ.hom.app (Opposite.op T_0)).hom →
      CategoryTheory.IsIso Φ := by
    intro G H Φ hBij
    let K := CategoryTheory.Limits.kernel Φ
    let ι_K := CategoryTheory.Limits.kernel.ι Φ
    have hMono_ι : CategoryTheory.Mono (Ev_T0.map ι_K) := by
      dsimp [Ev_T0]
      infer_instance
    have hInj_ι : Function.Injective (Ev_T0.map ι_K).hom :=
      (AddCommGrpCat.mono_iff_injective (Ev_T0.map ι_K)).mp hMono_ι
    have hSub_K : Subsingleton ↑(Ev_T0.obj K) := by
      refine subsingleton_iff_forall_eq 0 |>.mpr fun a => ?_
      apply hInj_ι
      rw [map_zero]
      apply hBij.1
      rw [map_zero]
      have hcond : Ev_T0.map (ι_K ≫ Φ) = 0 := by
        rw [CategoryTheory.Limits.kernel.condition]
        rfl
      rw [Ev_T0.map_comp] at hcond
      exact congrArg (fun m => m.hom a) hcond
    have : CategoryTheory.Mono Φ :=
      CategoryTheory.Preadditive.mono_of_isZero_kernel _ (hZero_Sk K hSub_K)
    let C := CategoryTheory.Limits.cokernel Φ
    let π_C := CategoryTheory.Limits.cokernel.π Φ
    have hMap_π0 : Ev_T0.map π_C = 0 := by
      apply AddCommGrpCat.ext
      intro y
      obtain ⟨x, rfl⟩ := hBij.2 y
      have hcond : Ev_T0.map (Φ ≫ π_C) = 0 := by
        rw [CategoryTheory.Limits.cokernel.condition]
        rfl
      rw [Ev_T0.map_comp] at hcond
      exact congrArg (fun m => m.hom x) hcond
    have hSub_C : Subsingleton ↑(Ev_T0.obj C) := by
      have hid0 : CategoryTheory.CategoryStruct.id (Ev_T0.obj C) = 0 := by
        apply (adj_ev.homEquiv C (Ev_T0.obj C)).injective
        apply CategoryTheory.Limits.coequalizer.hom_ext
        have h1 := (adj_ev.homEquiv_naturality_left π_C
          (CategoryTheory.CategoryStruct.id (Ev_T0.obj C))).symm
        have h2 := (adj_ev.homEquiv_naturality_left π_C
          (0 : Quiver.Hom (Ev_T0.obj C) (Ev_T0.obj C))).symm
        rw [CategoryTheory.Category.comp_id, hMap_π0] at h1
        rw [hMap_π0, CategoryTheory.Limits.zero_comp] at h2
        exact h1.trans h2.symm
      refine subsingleton_iff_forall_eq 0 |>.mpr fun z => ?_
      exact congrArg (fun m => m.hom z) hid0
    have : CategoryTheory.Epi Φ :=
      CategoryTheory.Preadditive.epi_of_isZero_cokernel _ (hZero_Sk C hSub_C)
    exact CategoryTheory.isIso_of_mono_of_epi Φ

  have hConj4c : ∀ (G : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
      CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj J_k AddCommGrpCat.{u} hT_0).counit.app G) := by
    intro G
    let adj_0 := CategoryTheory.constantSheafAdj J_k AddCommGrpCat.{u} hT_0
    let A := G.obj.obj (Opposite.op T_0)
    have hIso_u : CategoryTheory.IsIso (adj_0.unit.app A) := by
      rw [hConstUnit S_k hT_0 A]
      exact hUnitIso_k _
    have h_tri : adj_0.unit.app A ≫ (adj_0.counit.app G).hom.app (Opposite.op T_0) =
        CategoryTheory.CategoryStruct.id A :=
      adj_0.right_triangle_components G
    let e_u := @CategoryTheory.asIso _ _ _ _ (adj_0.unit.app A) hIso_u
    have h_inv : (adj_0.counit.app G).hom.app (Opposite.op T_0) = e_u.inv := by
      calc
        (adj_0.counit.app G).hom.app (Opposite.op T_0) =
            (e_u.inv ≫ e_u.hom) ≫ (adj_0.counit.app G).hom.app (Opposite.op T_0) := by
          rw [e_u.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = e_u.inv ≫ (adj_0.unit.app A ≫ (adj_0.counit.app G).hom.app (Opposite.op T_0)) :=
          CategoryTheory.Category.assoc _ _ _
        _ = e_u.inv :=
          (congrArg (e_u.inv ≫ ·) h_tri).trans (CategoryTheory.Category.comp_id e_u.inv)
    have hBij_c : Function.Bijective ((adj_0.counit.app G).hom.app (Opposite.op T_0)).hom := by
      rw [h_inv]
      refine Function.bijective_iff_has_inverse.mpr ⟨e_u.hom.hom, ?_, ?_⟩
      · intro a
        exact congrArg (fun m => m.hom a) e_u.inv_hom_id
      · intro b
        exact congrArg (fun m => m.hom b) e_u.hom_inv_id
    exact hConj4a _ G (adj_0.counit.app G) hBij_c

  have hConj4b : ∀ (G H : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}) (Φ₁ Φ₂ : Quiver.Hom G H),
      Φ₁.hom.app (Opposite.op T_0) = Φ₂.hom.app (Opposite.op T_0) →
      Φ₁ = Φ₂ := by
    intro G H Φ₁ Φ₂ h_eq
    let adj_0 := CategoryTheory.constantSheafAdj J_k AddCommGrpCat.{u} hT_0
    have := hConj4c G
    apply (CategoryTheory.cancel_epi (adj_0.counit.app G)).mp
    have hn1 := (adj_0.counit.naturality Φ₁).symm
    have hn2 := (adj_0.counit.naturality Φ₂).symm
    change adj_0.counit.app G ≫ Φ₁ =
      (CategoryTheory.constantSheaf J_k AddCommGrpCat.{u}).map (Φ₁.hom.app (Opposite.op T_0)) ≫
        adj_0.counit.app H at hn1
    change adj_0.counit.app G ≫ Φ₂ =
      (CategoryTheory.constantSheaf J_k AddCommGrpCat.{u}).map (Φ₂.hom.app (Opposite.op T_0)) ≫
        adj_0.counit.app H at hn2
    rw [hn1, hn2, h_eq]

  
  
  
  have hConj6 : ∀ (C : CategoryTheory.Over S_k) [AlgebraicGeometry.IsProper C.hom],
      topologicalKrullDim C.left ≤ (1 : WithBot ℕ∞) →
      ∀ (G : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u}),
        n • CategoryTheory.CategoryStruct.id G = 0 →
        ∀ (q : ℕ), 2 < q → Subsingleton (G.H q) := by
    intro C _ hDim G hTor q hq
    let J_C := C.left.smallEtaleTopology
    let Fℤ_C := (CategoryTheory.constantSheaf J_C AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hInd : ∀ (m : ℕ), 1 ≤ m → m ∣ n →
        ∀ (H : CategoryTheory.Sheaf J_C AddCommGrpCat.{u}),
          m • CategoryTheory.CategoryStruct.id H = 0 →
          Subsingleton (H.H q) := by
      intro m
      induction m using Nat.strong_induction_on with
      | h m ih =>
        intro hm1 hmn H hHm
        rcases eq_or_lt_of_le hm1 with rfl | hm2
        · refine subsingleton_iff_forall_eq 0 |>.mpr fun z => ?_
          have hid0 : CategoryTheory.CategoryStruct.id H = 0 := by
            simpa only [one_smul] using hHm
          calc
            z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id H))
                  (Nat.add_zero q) := (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
            _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ 0) (Nat.add_zero q) := by rw [hid0]
            _ = 0 := by
              rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        · have hm_ne1 : m ≠ 1 := by omega
          let ℓ := m.minFac
          have hPrime : Nat.Prime ℓ := Nat.minFac_prime hm_ne1
          have : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
          have hℓ_m : ℓ ∣ m := Nat.minFac_dvd m
          have hℓ_n : ℓ ∣ n := dvd_trans hℓ_m hmn
          have hℓ_ne : (ℓ : k) ≠ 0 := by
            intro h0
            rcases hℓ_n with ⟨d, rfl⟩
            apply hUnit.ne_zero
            push_cast
            rw [h0, zero_mul]
          let m' := m / ℓ
          have h_mul : ℓ * m' = m := Nat.mul_div_cancel' hℓ_m
          have hm'_lt : m' < m := Nat.div_lt_self (by omega) hPrime.one_lt
          have hm'_ge1 : 1 ≤ m' := by
            rcases Nat.eq_zero_or_pos m' with hm'0 | hm'_pos
            · exfalso
              rw [hm'0, mul_zero] at h_mul
              omega
            · exact hm'_pos
          have hm'_n : m' ∣ n := by
            rcases hmn with ⟨c, rfl⟩
            exact ⟨ℓ * c, by rw [← h_mul]; ring⟩
          let μ : Quiver.Hom H H := ℓ • CategoryTheory.CategoryStruct.id H
          let K := CategoryTheory.Limits.kernel μ
          let i : Quiver.Hom K H := CategoryTheory.Limits.kernel.ι μ
          let M := CategoryTheory.Limits.image μ
          let p : Quiver.Hom H M := CategoryTheory.Limits.factorThruImage μ
          let j : Quiver.Hom M H := CategoryTheory.Limits.image.ι μ
          have hpj : p ≫ j = μ := CategoryTheory.Limits.image.fac μ
          have hip : i ≫ p = 0 := by
            apply (CategoryTheory.cancel_mono j).mp
            rw [CategoryTheory.Category.assoc, hpj, CategoryTheory.Limits.kernel.condition,
              CategoryTheory.Limits.zero_comp]
          let isLim : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι i hip) :=
            CategoryTheory.Limits.Fork.IsLimit.mk _
              (fun s => CategoryTheory.Limits.kernel.lift μ s.ι (by
                have hs : s.ι ≫ p = 0 := s.condition
                calc
                  s.ι ≫ μ = s.ι ≫ (p ≫ j) := by rw [hpj]
                  _ = (s.ι ≫ p) ≫ j := (CategoryTheory.Category.assoc _ _ _).symm
                  _ = 0 ≫ j := by rw [hs]
                  _ = 0 := CategoryTheory.Limits.zero_comp))
              (fun s => CategoryTheory.Limits.kernel.lift_ι _ _ _)
              (fun s g hg => by
                apply (CategoryTheory.cancel_mono i).mp
                rw [CategoryTheory.Limits.kernel.lift_ι]
                exact hg)
          let SC := CategoryTheory.ShortComplex.mk i p hip
          have hSE : SC.ShortExact :=
            { exact := SC.exact_of_f_is_kernel isLim
              mono_f := inferInstance
              epi_g := inferInstance }
          have hK_tor : ℓ • CategoryTheory.CategoryStruct.id K = 0 := by
            apply (CategoryTheory.cancel_mono i).mp
            calc
              (ℓ • CategoryTheory.CategoryStruct.id K) ≫ i =
                  ℓ • (CategoryTheory.CategoryStruct.id K ≫ i) :=
                CategoryTheory.Preadditive.nsmul_comp _ _ _
              _ = ℓ • (i ≫ CategoryTheory.CategoryStruct.id H) := by
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
              _ = i ≫ (ℓ • CategoryTheory.CategoryStruct.id H) :=
                (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
              _ = 0 ≫ i := by
                rw [CategoryTheory.Limits.kernel.condition μ, CategoryTheory.Limits.zero_comp]
          have hM_tor : m' • CategoryTheory.CategoryStruct.id M = 0 := by
            apply (CategoryTheory.cancel_epi p).mp
            apply (CategoryTheory.cancel_mono j).mp
            rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
              CategoryTheory.Preadditive.nsmul_comp, hpj,
              CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
            change m' • (ℓ • CategoryTheory.CategoryStruct.id H) = 0
            rw [← mul_smul, mul_comm m' ℓ, h_mul]
            exact hHm
          have hSubK : Subsingleton (K.H q) := hCD1_prime k ℓ hℓ_ne C hDim K hK_tor q hq
          have hSubM : Subsingleton (M.H q) := ih m' hm'_lt hm'_ge1 hm'_n M hM_tor
          refine subsingleton_iff_forall_eq 0 |>.mpr fun x => ?_
          have hxp : x.comp (CategoryTheory.Abelian.Ext.mk₀ p) (Nat.add_zero q) = 0 :=
            @Subsingleton.elim _ hSubM _ 0
          obtain ⟨y, hy⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_C hSE x hxp
          have hy0 : y = 0 := @Subsingleton.elim _ hSubK y 0
          rw [← hy, hy0, CategoryTheory.Abelian.Ext.zero_comp]
    exact hInd n hn (dvd_refl n) G hTor

  exact ⟨hConj1, hConj2, hConj3, ⟨hConj4a, hConj4b, hConj4c⟩, hConj5, hConj6⟩

theorem weil_leray_extClass_and_double_connecting_spec_eval : (∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X Y)
        [_hc_f : (weilEtaleSitePullback f).IsContinuous Y.smallEtaleTopology X.smallEtaleTopology]
        [_hr_f : ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology).IsRightAdjoint],
      let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology X.smallEtaleTopology
      let pb_f := (weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u}
        Y.smallEtaleTopology X.smallEtaleTopology
      let adj_f := (weilEtaleSitePullback f).sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology X.smallEtaleTopology
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      ∀ [_hAdd : pb_f.Additive]
        [_hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_f]
        [_hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_f]
        (ιℤ_f : Quiver.Hom Fℤ_X (pb_f.obj Fℤ_Y))
        (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact),
        letI : pf_f.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products pf_f
        ∀ (hSE' : (SC.map pf_f).ShortExact)
          (q r : ℕ) (hqr : q + 1 = r)
          (β : (pf_f.obj SC.X₃).H q),
          (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app SC.X₁)).postcomp Fℤ_X (Nat.add_zero r)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
              ((pb_f.mapExtAddHom Fℤ_Y (pf_f.obj SC.X₁) r) (β.comp hSE'.extClass hqr))
              (Nat.zero_add r)) =
          ((CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app SC.X₃)).postcomp Fℤ_X (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
              ((pb_f.mapExtAddHom Fℤ_Y (pf_f.obj SC.X₃) q) β)
              (Nat.zero_add q))).comp hSE.extClass hqr) ∧
    (∀ {Y B : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y B)
        [_hc_f : (weilEtaleSitePullback f).IsContinuous B.smallEtaleTopology Y.smallEtaleTopology]
        [_hr_f : ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          B.smallEtaleTopology Y.smallEtaleTopology).IsRightAdjoint],
      let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        B.smallEtaleTopology Y.smallEtaleTopology
      let pb_f := (weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u}
        B.smallEtaleTopology Y.smallEtaleTopology
      let adj_f := (weilEtaleSitePullback f).sheafAdjunctionContinuous AddCommGrpCat.{u}
        B.smallEtaleTopology Y.smallEtaleTopology
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ_B := (CategoryTheory.constantSheaf B.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      ∀ [_hAdd : pb_f.Additive]
        [_hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_f]
        [_hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_f]
        {T_0 : B.Etale} (hT_0 : CategoryTheory.Limits.IsTerminal T_0)
        (hT_Bf : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_0))
        (ιℤ_f : Quiver.Hom Fℤ_Y (pb_f.obj Fℤ_B))
        (_ : CategoryTheory.CategoryStruct.comp ιℤ_f
          (weilEtaleConstPullbackHom f hT_Bf hT_0 Aℤ) =
          CategoryTheory.CategoryStruct.id Fℤ_Y)
        (F M_0 Q_1 M_1 Q_2 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (i_0 : Quiver.Hom F M_0) (p_0 : Quiver.Hom M_0 Q_1)
        (h0_0 : CategoryTheory.CategoryStruct.comp i_0 p_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk i_0 p_0 h0_0).ShortExact)
        (i_1 : Quiver.Hom Q_1 M_1) (p_1 : Quiver.Hom M_1 Q_2)
        (h0_1 : CategoryTheory.CategoryStruct.comp i_1 p_1 = 0)
        (hSE_1 : (CategoryTheory.ShortComplex.mk i_1 p_1 h0_1).ShortExact)
        (Δ₂ : Quiver.Hom (pf_f.obj Q_2) (weilEtaleHigherDirectImage f 2 F)),
        (let Q_F := CategoryTheory.Sheaf.cohomologyPresheaf F 2
         let P_F := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_F
         let η_F := (CategoryTheory.sheafificationAdjunction B.smallEtaleTopology AddCommGrpCat.{u}).unit.app P_F
         ∀ (V : B.Etale) (s : ↑((pf_f.obj Q_2).obj.obj (Opposite.op V))),
           let U_V : Y.Etale := (weilEtaleSitePullback f).obj V
           let s_ext : ↑(Q_F.obj (Opposite.op U_V)) :=
             (((CategoryTheory.Abelian.Ext.mk₀
                 ((weilPolyP1CohomologyRepHomEquiv Y U_V Q_2).symm s)).comp
               hSE_1.extClass (Nat.zero_add 1)).comp
               hSE_0.extClass (Nat.one_add 1))
           (Δ₂.hom.app (Opposite.op V)) s = (η_F.app (Opposite.op V)) s_ext) →
        ∀ (x : F.H 2) (q_2 : Q_2.H 0) (q_base : (pf_f.obj Q_2).H 0),
          (q_2.comp hSE_1.extClass (Nat.zero_add 1)).comp hSE_0.extClass (Nat.one_add 1) = x →
          (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q_2)).postcomp Fℤ_Y (Nat.add_zero 0)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
              ((pb_f.mapExtAddHom Fℤ_B (pf_f.obj Q_2) 0) q_base)
              (Nat.zero_add 0)) = q_2 →
          let Q_F := CategoryTheory.Sheaf.cohomologyPresheaf F 2
          let P_F := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_F
          let η_F := (CategoryTheory.sheafificationAdjunction B.smallEtaleTopology AddCommGrpCat.{u}).unit.app P_F
