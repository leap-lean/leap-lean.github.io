    change τ (id_ext0.comp (E_top oneR φ₁) (Nat.zero_add (2 * d))) = φ₁ id_ext0 * u₀ at h1
    rw [CategoryTheory.Abelian.Ext.mk₀_id_comp, (E_top oneR).apply_symm_apply w₁, hw₁] at h1
    exact h1.symm
  let v₀ : ZMod m := φ₁ id_ext0
  have hu₀_mul : u₀ * v₀ = 1 := by rw [mul_comm]; exact hv₀_mul
  have hΦ_base : ∀ (q : ℕ) (hq : 0 + q = 2 * d) (G : 𝒞),
      Function.Bijective (Φ G 0 q hq) := by
    intro q hq G
    have hq_eq : q = 2 * d := by omega
    subst hq_eq
    have hhpq : hq = Nat.zero_add (2 * d) := Subsingleton.elim _ _
    rw [hhpq]
    have hscale_bij : Function.Bijective
        (fun φ : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m =>
          Φ G 0 (2 * d) (Nat.zero_add (2 * d)) (E_top G φ)) := by
      refine ⟨?_, ?_⟩
      · intro ψ_a ψ_b h_eq
        ext α
        have h_ap := DFunLike.congr_fun h_eq α
        rw [hΦ_top_eval G ψ_a α, hΦ_top_eval G ψ_b α] at h_ap
        calc
          ψ_a α = ψ_a α * (u₀ * v₀) := by rw [hu₀_mul, mul_one]
          _ = (ψ_a α * u₀) * v₀ := (mul_assoc _ _ _).symm
          _ = (ψ_b α * u₀) * v₀ := by rw [h_ap]
          _ = ψ_b α * (u₀ * v₀) := mul_assoc _ _ _
          _ = ψ_b α := by rw [hu₀_mul, mul_one]
      · intro χ
        let φ_pre : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m :=
          AddMonoidHom.mk' (fun α => χ α * v₀) (fun α₁ α₂ => by rw [map_add, add_mul])
        refine ⟨φ_pre, ?_⟩
        ext α
        rw [hΦ_top_eval G φ_pre α]
        change (χ α * v₀) * u₀ = χ α
        rw [mul_assoc, hv₀_mul, mul_one]
    exact Function.Bijective.of_comp_iff (Φ G 0 (2 * d) (Nat.zero_add (2 * d)))
      (E_top G).bijective |>.mp hscale_bij
  have hΦ_bij : ∀ (p q : ℕ) (hpq : p + q = 2 * d) (G : 𝒞),
      Function.Bijective (Φ G p q hpq) := by
    intro p
    induction p with
    | zero => exact hΦ_base
    | succ p ih =>
      intro q hpq G
      have hq_lt : q < 2 * d := by omega
      have hpq' : p + (q + 1) = 2 * d := by omega
      have h1q : 1 + q = q + 1 := Nat.one_add q
      let f_G : Quiver.Hom G ((𝒯 0).obj G) := η.app G
      let Q : 𝒞 := CategoryTheory.Limits.cokernel f_G
      let π₀ : Quiver.Hom ((𝒯 0).obj G) Q := CategoryTheory.Limits.cokernel.π f_G
      have h_epi_π₀ : CategoryTheory.Epi π₀ := CategoryTheory.Limits.coequalizer.π_epi
      let S_G : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk f_G π₀ (CategoryTheory.Limits.cokernel.condition f_G)
      have hSG : S_G.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel f_G
          mono_f := hMonoη G
          epi_g := h_epi_π₀ }
      let δ : CategoryTheory.Abelian.Ext.{u} Q G 1 := hSG.extClass
      have hSub_T0_q : Subsingleton (CategoryTheory.Abelian.Ext.{u} ((𝒯 0).obj G) oneR q) :=
        hVan ((𝒯 0).obj G) (fun k hk => hAcyc 0 k hk G) q hq_lt
      have hSub_T0_p1 : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((𝒯 0).obj G) (p + 1)) :=
        hAcyc 0 (p + 1) (by omega) G
      have hQ_bij := ih (q + 1) hpq' Q
      have hT_bij := ih (q + 1) hpq' ((𝒯 0).obj G)
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro β hβ0
        have hδβ_zero : Φ Q p (q + 1) hpq' (δ.comp β h1q) = 0 := by
          ext ξ
          change τ (ξ.comp (δ.comp β h1q) hpq') = 0
          have hassoc : (ξ.comp δ rfl).comp β hpq = ξ.comp (δ.comp β h1q) hpq' :=
            CategoryTheory.Abelian.Ext.comp_assoc ξ δ β rfl h1q (by omega)
          rw [← hassoc]
          exact DFunLike.congr_fun hβ0 (ξ.comp δ rfl)
        have hδβ : δ.comp β h1q = 0 :=
          (injective_iff_map_eq_zero _).mp hQ_bij.1 (δ.comp β h1q) hδβ_zero
        obtain ⟨γ, hγ⟩ :=
          CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁ hSG oneR β h1q hδβ
        have hγ0 : γ = 0 := @Subsingleton.elim _ hSub_T0_q γ 0
        rw [← hγ, hγ0, CategoryTheory.Abelian.Ext.comp_zero]
      · intro ψ
        let ψ_Q : CategoryTheory.Abelian.Ext.{u} oneR Q p →+ ZMod m :=
          AddMonoidHom.mk' (fun ξ => ψ (ξ.comp δ rfl))
            (fun ξ₁ ξ₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add])
        obtain ⟨x₃, hx₃⟩ := hQ_bij.2 ψ_Q
        have hπ_x₃_zero : Φ ((𝒯 0).obj G) p (q + 1) hpq'
            ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1))) = 0 := by
          ext ζ
          change τ (ζ.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1))) hpq') = 0
          have hassoc : (ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp x₃ hpq' =
              ζ.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1))) hpq' :=
            CategoryTheory.Abelian.Ext.comp_assoc ζ (CategoryTheory.Abelian.Ext.mk₀ π₀) x₃
              (Nat.add_zero p) (Nat.zero_add (q + 1)) (by omega)
          rw [← hassoc]
          have h1 := DFunLike.congr_fun hx₃
            (ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p))
          change τ ((ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp x₃ hpq') =
            ψ ((ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp δ rfl) at h1
          have hπδ : (CategoryTheory.Abelian.Ext.mk₀ π₀).comp δ (Nat.zero_add 1) = 0 :=
            hSG.comp_extClass
          have hassoc2 : (ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp δ rfl =
              ζ.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp δ (Nat.zero_add 1)) rfl :=
            CategoryTheory.Abelian.Ext.comp_assoc ζ (CategoryTheory.Abelian.Ext.mk₀ π₀) δ
              (Nat.add_zero p) (Nat.zero_add 1) (by omega)
          rw [h1, hassoc2, hπδ, CategoryTheory.Abelian.Ext.comp_zero, map_zero]
        have hπ_x₃ : (CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1)) = 0 :=
          (injective_iff_map_eq_zero _).mp hT_bij.1 _ hπ_x₃_zero
        obtain ⟨β, hβ⟩ :=
          CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSG oneR x₃ hπ_x₃ h1q
        refine ⟨β, ?_⟩
        ext α
        have hα_f : α.comp (CategoryTheory.Abelian.Ext.mk₀ f_G) (Nat.add_zero (p + 1)) = 0 :=
          @Subsingleton.elim _ hSub_T0_p1 _ 0
        obtain ⟨ξ, hξ⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hSG α hα_f rfl
        change τ (α.comp β hpq) = ψ α
        have hassoc3 : (ξ.comp δ rfl).comp β hpq = ξ.comp (δ.comp β h1q) hpq' :=
          CategoryTheory.Abelian.Ext.comp_assoc ξ δ β rfl h1q (by omega)
        rw [← hξ, hassoc3, hβ]
        exact DFunLike.congr_fun hx₃ ξ
  refine ⟨hτ_bij, fun i hi => ?_⟩
  have hBij_i := hΦ_bij i (2 * d - i) (Nat.add_sub_of_le hi) oneR
  refine ⟨?_, ?_⟩
  · intro a ha0
    apply hCog (weilEtaleModuleH S m i) (hExt_tors oneR oneR i) a
    intro φ
    obtain ⟨b, hb⟩ := hBij_i.2 φ
    rw [← hb]
    exact ha0 b
  · intro b hb0
    apply (injective_iff_map_eq_zero _).mp hBij_i.1 b
    ext a
    exact hb0 a

theorem weil_etale_smooth_proper_torsion_poincare_duality (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k) :
    ∃ tr : ∀ r : ℕ, weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+ ZMod (ℓ ^ r),
      (∀ r : ℕ, Function.Bijective (tr r)) ∧
      (∀ (r : ℕ) (w : weilEtaleTorsionH X.left (ℓ ^ (r + 1)) (2 * d)),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr (r + 1) w) =
          tr r (weilEtaleTorsionTransition X.left ℓ r (2 * d) w)) ∧
      (∀ (r i : ℕ) (hi : i ≤ 2 * d)
        (θ_top : weilEtaleModuleH X.left (ℓ ^ r) (2 * d) →+
          weilEtaleTorsionH X.left (ℓ ^ r) (2 * d)),
        WeilIsModuleToTorsionComparison X.left (ℓ ^ r) (2 * d) θ_top →
        (∀ a : weilEtaleModuleH X.left (ℓ ^ r) i,
          (∀ b : weilEtaleModuleH X.left (ℓ ^ r) (2 * d - i),
            tr r (θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.add_sub_of_le hi))) = 0) →
          a = 0) ∧
        (∀ b : weilEtaleModuleH X.left (ℓ ^ r) (2 * d - i),
          (∀ a : weilEtaleModuleH X.left (ℓ ^ r) i,
            tr r (θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.add_sub_of_le hi))) = 0) →
          b = 0)) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : (ℓ : k) ≠ 0 := by
    intro h0
    have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
    rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
      · exact hℓ heq.symm
    · rw [hz, zero_dvd_iff] at hdvd
      exact hPrime.ne_zero hdvd
  have hUnit : ∀ r : ℕ, IsUnit ((ℓ ^ r : ℕ) : k) := by
    intro r
    rw [Nat.cast_pow]
    exact Ne.isUnit (pow_ne_zero r hℓ_ne)
  have hm : ∀ r : ℕ, 1 ≤ ℓ ^ r :=
    fun r => Nat.one_le_pow r ℓ hPrime.pos
  have : NeZero (ℓ : k) := ⟨hℓ_ne⟩
  have hdeg_cyc : (Polynomial.cyclotomic ℓ k).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic]
    have htot : Nat.totient ℓ = ℓ - 1 := Nat.totient_prime hPrime
    have h2 : 2 ≤ ℓ := hPrime.two_le
    have hpos : 0 < Nat.totient ℓ := by omega
    exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hpos)
  obtain ⟨z₁, hz₁_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ k) hdeg_cyc
  have hz₁_prim : IsPrimitiveRoot z₁ ℓ :=
    (Polynomial.isRoot_cyclotomic_iff (R := k) (n := ℓ)).mp hz₁_root
  have hz₁_pow : z₁ ^ ℓ = 1 := hz₁_prim.pow_eq_one
  have hz₁_ne : z₁ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hPrime.ne_zero] at hz₁_pow
    exact zero_ne_one hz₁_pow
  let u₁ : kˣ := Units.mk0 z₁ hz₁_ne
  have hu₁_prim : IsPrimitiveRoot ((u₁ : kˣ) : k) (ℓ ^ 1) := by
    simpa [u₁, pow_one] using hz₁_prim
  have hu₁_pow : u₁ ^ ℓ = 1 := by
    ext
    simpa [u₁, Units.val_pow_eq_pow_val] using hz₁_pow
  have hStep : ∀ (s : ℕ) (u : kˣ),
      IsPrimitiveRoot ((u : kˣ) : k) (ℓ ^ (s + 1)) →
      ∃ v : kˣ, IsPrimitiveRoot ((v : kˣ) : k) (ℓ ^ (s + 2)) ∧ v ^ ℓ = u := by
    intro s u hu
    let Q : Polynomial k := Polynomial.X ^ ℓ - Polynomial.C ((u : kˣ) : k)
    have hdegQ : Q.degree ≠ 0 := by
      dsimp [Q]
      rw [Polynomial.degree_X_pow_sub_C hPrime.pos ((u : kˣ) : k)]
      exact Nat.cast_ne_zero.mpr hPrime.ne_zero
    obtain ⟨w, hw_root⟩ := IsAlgClosed.exists_root Q hdegQ
    have hw_pow : w ^ ℓ = ((u : kˣ) : k) := by
      have hev : Polynomial.eval w Q = 0 := hw_root
      simp only [Q, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C, sub_eq_zero] at hev
      exact hev
    have hw_ne : w ≠ 0 := by
      intro hw0
      rw [hw0, zero_pow hPrime.ne_zero] at hw_pow
      exact u.ne_zero hw_pow.symm
    let v : kˣ := Units.mk0 w hw_ne
    have hv_pow : v ^ ℓ = u := by
      ext
      simpa [v, Units.val_pow_eq_pow_val] using hw_pow
    have hw_prim : IsPrimitiveRoot w (ℓ ^ (s + 2)) := by
      refine IsPrimitiveRoot.mk ?_ ?_
      · have hexp : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
        rw [hexp, pow_mul, hw_pow]
        exact hu.pow_eq_one
      · intro m_exp hm_exp
        have hexp2 : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
        have hw_top : w ^ (ℓ ^ (s + 2)) = 1 := by
          rw [hexp2, pow_mul, hw_pow]
          exact hu.pow_eq_one
        have hord_top : orderOf w ∣ ℓ ^ (s + 2) := orderOf_dvd_of_pow_eq_one hw_top
        have hord_m : orderOf w ∣ m_exp := orderOf_dvd_of_pow_eq_one hm_exp
        obtain ⟨j, hj_le, hord_eq⟩ := (Nat.dvd_prime_pow hPrime).mp hord_top
        by_cases hj : j ≤ s + 1
        · exfalso
          have hdvd_prev : orderOf w ∣ ℓ ^ (s + 1) := by
            rw [hord_eq]
            exact pow_dvd_pow ℓ hj
          obtain ⟨q, hq⟩ := hdvd_prev
          have hw_prev : w ^ (ℓ ^ (s + 1)) = 1 := by
            rw [hq, pow_mul, pow_orderOf_eq_one, one_pow]
          have hexp1 : ℓ ^ (s + 1) = ℓ * ℓ ^ s := by ring
          rw [hexp1, pow_mul, hw_pow] at hw_prev
          have hdvd_bad : ℓ ^ (s + 1) ∣ ℓ ^ s :=
            (hu.pow_eq_one_iff_dvd (ℓ ^ s)).mp hw_prev
          have hle_bad : ℓ ^ (s + 1) ≤ ℓ ^ s :=
            Nat.le_of_dvd (pow_pos hPrime.pos s) hdvd_bad
          have hlt_good : ℓ ^ s < ℓ ^ (s + 1) :=
            Nat.pow_lt_pow_right hPrime.one_lt (Nat.lt_succ_self s)
          omega
        · have hj_eq : j = s + 2 := by omega
          rw [← hj_eq, ← hord_eq]
          exact hord_m
    exact ⟨v, by simpa [v] using hw_prim, hv_pow⟩
  let tower : ∀ s : ℕ, { u : kˣ // IsPrimitiveRoot ((u : kˣ) : k) (ℓ ^ (s + 1)) } :=
    Nat.rec ⟨u₁, hu₁_prim⟩ (fun s prev =>
      ⟨Classical.choose (hStep s prev.1 prev.2),
       (Classical.choose_spec (hStep s prev.1 prev.2)).1⟩)
  let ζ : ℕ → kˣ := fun r =>
    match r with
    | 0 => 1
    | s + 1 => (tower s).1
  have hPrim : ∀ r : ℕ, IsPrimitiveRoot ((ζ r : kˣ) : k) (ℓ ^ r) := by
    intro r
    cases r with
    | zero => exact IsPrimitiveRoot.one
    | succ s => exact (tower s).2
  have hPow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r := by
    intro r
    cases r with
    | zero => exact hu₁_pow
    | succ s => exact (Classical.choose_spec (hStep s (tower s).1 (tower s).2)).2
  have hDim : topologicalKrullDim X.left ≤ (d : WithBot ℕ∞) :=
    le_of_eq (weil_smooth_integral_krullDim_over_field k d X hInt)
  have : AlgebraicGeometry.IsIntegral X.left := hInt
  have : IrreducibleSpace ↥X.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral X.left
  have : ConnectedSpace ↥X.left := IrreducibleSpace.connectedSpace ↥X.left
  have hMod1 := weil_etale_module_ext_comparison.{u}.1
  let θ_std : ∀ r : ℕ, weilEtaleModuleH X.left (ℓ ^ r) (2 * d) →+
      weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) :=
    fun r => Classical.choose (hMod1 X.left (ℓ ^ r) (2 * d)).1
  have hθ_std : ∀ r : ℕ, WeilIsModuleToTorsionComparison X.left (ℓ ^ r) (2 * d) (θ_std r) :=
    fun r => (Classical.choose_spec (hMod1 X.left (ℓ ^ r) (2 * d)).1).1
  have hθ_bij : ∀ r : ℕ, Function.Bijective (θ_std r) :=
    fun r => (Classical.choose_spec (hMod1 X.left (ℓ ^ r) (2 * d)).1).2
  have hGod : ∀ r : ℕ, WeilHasTruncatedGodementComplex X.left d (ℓ ^ r) :=
    fun r => weil_etale_truncated_godement_acyclic_complex k X d (ℓ ^ r) (hm r) (hUnit r) hDim
  obtain ⟨tr, hTrCompat, hEff⟩ :=
    weil_etale_smooth_proper_trace_and_local_effacement k X hInt d ℓ hℓ ζ hPrim hPow
  refine ⟨tr, ?_, hTrCompat, ?_⟩
  · intro r
    have hCompBij : Function.Bijective ((tr r).comp (θ_std r)) :=
      (weil_etale_verdier_duality_of_local_effacement X.left d (ℓ ^ r) (hm r)
        ((tr r).comp (θ_std r)) (hGod r) (hEff r (θ_std r) (hθ_std r))).1
    refine ⟨?_, ?_⟩
    · intro w₁ w₂ hw
      obtain ⟨v₁, rfl⟩ := (hθ_bij r).2 w₁
      obtain ⟨v₂, rfl⟩ := (hθ_bij r).2 w₂
      exact congrArg (θ_std r) (hCompBij.1 hw)
    · intro z
      obtain ⟨v, hv⟩ := hCompBij.2 z
      exact ⟨θ_std r v, hv⟩
  · intro r i hi θ_top hθ_top
    exact (weil_etale_verdier_duality_of_local_effacement X.left d (ℓ ^ r) (hm r)
      ((tr r).comp θ_top) (hGod r) (hEff r θ_top hθ_top)).2 i hi

theorem weil_top_deg_torsion_pullback_functoriality : (∀ {W₁ W₂ W₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Quiver.Hom W₁ W₂) (h₂ : Quiver.Hom W₂ W₃) (m k : ℕ)
      (p₁ : weilEtaleTorsionH W₂ m k →+ weilEtaleTorsionH W₁ m k)
      (p₂ : weilEtaleTorsionH W₃ m k →+ weilEtaleTorsionH W₂ m k),
      WeilTopDegTorsionPullback h₁ m k p₁ →
      WeilTopDegTorsionPullback h₂ m k p₂ →
      WeilTopDegTorsionPullback (CategoryTheory.CategoryStruct.comp h₁ h₂) m k (p₁.comp p₂)) ∧
    (∀ (K : Type u) [Finite K] [Field K]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (m k : ℕ)
      (f : weilEtaleTorsionH (weilGeomScheme K Z) m k →+
        weilEtaleTorsionH (weilGeomScheme K Z) m k),
      WeilIsTorsionGeomFrobAction K Z m k f →
      WeilTopDegTorsionPullback (weilGeomFrobHom K Z) m k f) :=
by
  refine ⟨?_, ?_⟩
  · 
    intro W₁ W₂ W₃ h₁ h₂ m k p₁ p₂ hp₁ hp₂
    let h₁₂ : Quiver.Hom W₁ W₃ := CategoryTheory.CategoryStruct.comp h₁ h₂
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h₁ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h₂ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h₁₂ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h₁₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B₁ : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₁
    let B₂ : CategoryTheory.Functor W₃.Etale W₂.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₂
    let B₁₂ : CategoryTheory.Functor W₃.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h₁₂
    let D := AddCommGrpCat.{u}
