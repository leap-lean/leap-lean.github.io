  · have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
        (CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u})),
        (∀ (W : Opposite Y.Etale),
          (K.map ((CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
