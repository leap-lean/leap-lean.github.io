        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X le_rfl
      intro U R
      have hmem := AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) U R
      exact (congrArg (fun K => R ∈ K U) hJ_eq).to_iff.trans hmem

    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let zLift : ∀ (M : AddCommGrpCat.{u}), ↑M → (Aℤ ⟶ M) :=
      fun M s => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun z => z.down • s) (fun z₁ z₂ => add_zsmul s z₁.down z₂.down))
    have hzLift_eval : ∀ (M : AddCommGrpCat.{u}) (s : ↑M),
        (zLift M s).hom (ULift.up 1) = s := fun _ s => one_zsmul s
    have hzLift_inj : ∀ {M : AddCommGrpCat.{u}} {φ₁ φ₂ : Aℤ ⟶ M},
        φ₁.hom (ULift.up 1) = φ₂.hom (ULift.up 1) → φ₁ = φ₂ := by
      intro M φ₁ φ₂ h1
      apply AddCommGrpCat.hom_ext
      ext z
      have hz : z = z.down • (ULift.up 1 : ULift.{u} ℤ) :=
        ULift.ext _ _ (by change z.down = z.down • (1 : ℤ); simp)
      rw [hz, map_zsmul, map_zsmul, h1]
    have hzLift_comp : ∀ {M N : AddCommGrpCat.{u}} (s : ↑M) (h : M ⟶ N),
        zLift M s ≫ h = zLift N (h.hom s) := fun s h =>
      hzLift_inj (by change h.hom ((zLift _ s).hom _) = _; rw [hzLift_eval, hzLift_eval])

    have hEmpty_sub : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : X.Etale),
        IsEmpty ↥W.left → Subsingleton ↑(F.obj.obj (Opposite.op W)) := by
      intro F W hEmp
      let f_emp : PEmpty.{u + 1} → X.Etale := fun i => PEmpty.elim i
      let g_emp : ∀ i : PEmpty.{u + 1}, f_emp i ⟶ W := fun i => PEmpty.elim i
      have hcov_emp : CategoryTheory.Sieve.ofArrows f_emp g_emp ∈ J W :=
        (hJ_iff W _).mpr (fun x => IsEmpty.elim hEmp x)
      refine ⟨fun s₁ s₂ => ?_⟩
      have heq : zLift _ s₁ = zLift _ s₂ :=
        F.2.hom_ext_ofArrows g_emp hcov_emp (fun i => PEmpty.elim i)
      exact (hzLift_eval _ s₁).symm.trans
        ((congrArg (fun φ => φ.hom (ULift.up 1)) heq).trans (hzLift_eval _ s₂))

    let ν : ZMod n → k := fun a => ((ζ : kˣ) : k) ^ a.val
    have hz_pow : ((ζ : kˣ) : k) ^ n = 1 := hζ.pow_eq_one
    have hζu_pow : ζ ^ n = 1 := Units.ext (by push_cast; exact hz_pow)
    have hν_inj : Function.Injective ν := fun a b hab =>
      ZMod.val_injective n (hζ.pow_inj (ZMod.val_lt a) (ZMod.val_lt b) hab)
    have hζu_add : ∀ a b : ZMod n, ζ ^ (a + b).val = ζ ^ a.val * ζ ^ b.val := by
      intro a b
      calc
        ζ ^ (a + b).val = ζ ^ ((a.val + b.val) % n) := by rw [ZMod.val_add]
        _ = (ζ ^ n) ^ ((a.val + b.val) / n) * ζ ^ ((a.val + b.val) % n) := by
          rw [hζu_pow, one_pow, one_mul]
        _ = ζ ^ (n * ((a.val + b.val) / n) + (a.val + b.val) % n) := by
          rw [pow_add, pow_mul]
        _ = ζ ^ (a.val + b.val) := by rw [Nat.div_add_mod]
        _ = ζ ^ a.val * ζ ^ b.val := pow_add ζ a.val b.val
    have hν_pow : ∀ a : ZMod n, (ν a) ^ n = 1 := by
      intro a; dsimp [ν]; rw [← pow_mul, mul_comm, pow_mul, hz_pow, one_pow]
    let L_poly : ZMod n → Polynomial k := fun a => Lagrange.basis Finset.univ ν a
    have hIdemp : ∀ (R : Type u) [CommRing R] (φ : k →+* R) (v : R),
        v ^ n = 1 →
        let e : ZMod n → R := fun a => Polynomial.eval₂ φ v (L_poly a)
        (Finset.univ : Finset (ZMod n)).sum e = 1 ∧
        (∀ a b : ZMod n, a ≠ b → e a * e b = 0) ∧
        (∀ a : ZMod n, v * e a = φ (ν a) * e a) := by
      let P_prod : Polynomial k :=
        (Finset.univ : Finset (ZMod n)).prod (fun b => Polynomial.X - Polynomial.C (ν b))
      have hcop : Set.Pairwise (↑(Finset.univ : Finset (ZMod n)))
          (fun a b => IsCoprime (Polynomial.X - Polynomial.C (ν a))
            (Polynomial.X - Polynomial.C (ν b))) :=
        fun _ _ _ _ hab => Polynomial.pairwise_coprime_X_sub_C hν_inj hab
      have hP_dvd : ∀ F : Polynomial k,
          (∀ m : ZMod n, Polynomial.eval (ν m) F = 0) → P_prod ∣ F := fun F hF =>
        Finset.prod_dvd_of_coprime hcop (fun m _ => Polynomial.dvd_iff_isRoot.mpr (hF m))
      have hP_monic : P_prod.Monic :=
        Polynomial.monic_prod_of_monic _ _ (fun b _ => Polynomial.monic_X_sub_C (ν b))
      have hP_deg : P_prod.natDegree = n := by
        rw [Polynomial.natDegree_prod_of_monic _ _ (fun b _ => Polynomial.monic_X_sub_C (ν b))]
        simp [ZMod.card]
      have hQ_monic : (Polynomial.X ^ n - (1 : Polynomial k)).Monic := by
        rw [← map_one Polynomial.C]
        exact Polynomial.monic_X_pow_sub_C (1 : k) (by omega)
      have hQ_deg : (Polynomial.X ^ n - (1 : Polynomial k)).natDegree = n := by
        rw [← map_one Polynomial.C]
        exact Polynomial.natDegree_X_pow_sub_C
      have hP_eq : P_prod = Polynomial.X ^ n - 1 := by
        obtain ⟨C_q, hC_q⟩ := hP_dvd (Polynomial.X ^ n - 1) (fun m => by simp [hν_pow m])
        have hC_ne : C_q ≠ 0 := by
          rintro rfl; rw [mul_zero] at hC_q; exact hQ_monic.ne_zero hC_q
        have hdeg_s : n = n + C_q.natDegree := by
          have h1 := congrArg Polynomial.natDegree hC_q
          rwa [hQ_deg, Polynomial.natDegree_mul hP_monic.ne_zero hC_ne, hP_deg] at h1
        have hC_const : C_q = Polynomial.C (C_q.coeff 0) :=
          Polynomial.eq_C_of_natDegree_eq_zero (by omega)
        have hc0 : C_q.coeff 0 = 1 := by
          have hlc := congrArg Polynomial.leadingCoeff hC_q
          rw [hQ_monic.leadingCoeff, hC_const, Polynomial.leadingCoeff_mul,
            hP_monic.leadingCoeff, one_mul, Polynomial.leadingCoeff_C] at hlc
          exact hlc.symm
        rw [hC_q, hC_const, hc0, map_one, mul_one]
      have hL_sum : (Finset.univ : Finset (ZMod n)).sum L_poly = 1 :=
        Lagrange.sum_basis hν_inj.injOn Finset.univ_nonempty
      have hL_orth : ∀ a b : ZMod n, a ≠ b → (Polynomial.X ^ n - 1) ∣ L_poly a * L_poly b := by
        intro a b hab; rw [← hP_eq]; apply hP_dvd; intro m; rw [Polynomial.eval_mul]
        by_cases hma : m = a
        · subst hma; rw [Lagrange.eval_basis_of_ne hab.symm (Finset.mem_univ m), mul_zero]
        · rw [Lagrange.eval_basis_of_ne (Ne.symm hma) (Finset.mem_univ m), zero_mul]
      have hL_eig : ∀ a : ZMod n,
          (Polynomial.X ^ n - 1) ∣ (Polynomial.X - Polynomial.C (ν a)) * L_poly a := by
        intro a; rw [← hP_eq]; apply hP_dvd; intro m
        rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
        by_cases hma : m = a
        · subst hma; rw [sub_self, zero_mul]
        · rw [Lagrange.eval_basis_of_ne (Ne.symm hma) (Finset.mem_univ m), mul_zero]
      intro R _ φ v hv
      let ψ : Polynomial k →+* R := Polynomial.eval₂RingHom φ v
      have hkill : ∀ F : Polynomial k, (Polynomial.X ^ n - 1) ∣ F → ψ F = 0 := by
        rintro F ⟨G, rfl⟩; simp [ψ, hv]
      refine ⟨?_, ?_, ?_⟩
      · change (Finset.univ : Finset (ZMod n)).sum (fun a => ψ (L_poly a)) = 1
        rw [← map_sum ψ, hL_sum, map_one]
      · intro a b hab; change ψ (L_poly a) * ψ (L_poly b) = 0
        rw [← map_mul]; exact hkill _ (hL_orth a b hab)
      · intro a
        have h0 := hkill _ (hL_eig a)
        rw [map_mul, map_sub] at h0
        have hX : ψ Polynomial.X = v := Polynomial.eval₂_X φ v
        have hC : ψ (Polynomial.C (ν a)) = φ (ν a) := Polynomial.eval₂_C φ v
        rw [hX, hC, sub_mul] at h0
        exact sub_eq_zero.mp h0

    let K_sub : ∀ U : Opposite X.Etale, AddSubgroup ↑(G_pre.obj U) :=
      fun U => AddMonoidHom.ker (n • AddMonoidHom.id ↑(G_pre.obj U))
    let K_pre : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
      { obj := fun U => AddCommGrpCat.of ↥(K_sub U)
        map := fun {_ _} f => AddCommGrpCat.ofHom
          { toFun := fun u => ⟨(G_pre.map f).hom u.1, by
              change n • ((G_pre.map f).hom u.1) = 0
              rw [← map_nsmul, show n • u.1 = 0 from u.2, map_zero]⟩
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun x y => Subtype.ext (map_add _ x.1 y.1) }
        map_id := fun U => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun u =>
          Subtype.ext (congrArg (fun φ : G_pre.obj U ⟶ G_pre.obj U => φ.hom u.1) (G_pre.map_id U)))
        map_comp := fun {U₁ _ U₃} f g => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun u =>
          Subtype.ext (congrArg (fun φ : G_pre.obj U₁ ⟶ G_pre.obj U₃ => φ.hom u.1)
            (G_pre.map_comp f g))) }
    let i_K_pre : K_pre ⟶ G_pre :=
      { app := fun U => AddCommGrpCat.ofHom (K_sub U).subtype
        naturality := fun _ _ _ => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun _ => rfl) }
    have hK_sh : CategoryTheory.Presheaf.IsSheaf J K_pre := by
      intro E U R hR
      have hgen : CategoryTheory.Sieve.generate R.arrows ∈ J U := by
        rwa [CategoryTheory.Sieve.generate_sieve]
      have hG_for : CategoryTheory.Presieve.IsSheafFor
          (G_pre ⋙ CategoryTheory.coyoneda.obj (Opposite.op E)) R.arrows :=
        (hGmSheaf X E).isSheafFor R.arrows hgen
      intro x hx
      let y : CategoryTheory.Presieve.FamilyOfElements
          (G_pre ⋙ CategoryTheory.coyoneda.obj (Opposite.op E)) R.arrows :=
        fun V f hf => x f hf ≫ i_K_pre.app (Opposite.op V)
      have hy : y.Compatible := by
        intro V₁ V₂ W g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        have hx_eq : (x f₁ hf₁ : E ⟶ _) ≫ K_pre.map g₁.op =
            (x f₂ hf₂ : E ⟶ _) ≫ K_pre.map g₂.op := hx g₁ g₂ hf₁ hf₂ hcomm
        change (x f₁ hf₁ ≫ i_K_pre.app (Opposite.op V₁)) ≫ G_pre.map g₁.op =
          (x f₂ hf₂ ≫ i_K_pre.app (Opposite.op V₂)) ≫ G_pre.map g₂.op
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← i_K_pre.naturality g₁.op, ← i_K_pre.naturality g₂.op,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ i_K_pre.app (Opposite.op W)) hx_eq
      obtain ⟨φ_G_raw, hφ_G, hφ_uniq⟩ := hG_for y hy
      let φ_G : E ⟶ G_pre.obj (Opposite.op U) := φ_G_raw
      have hn_φ : ∀ e : E, n • (φ_G.hom e) = 0 := by
        let y0 : CategoryTheory.Presieve.FamilyOfElements
            (G_pre ⋙ CategoryTheory.coyoneda.obj (Opposite.op E)) R.arrows :=
          fun V _ _ => (0 : E ⟶ G_pre.obj (Opposite.op V))
        have hy0 : y0.Compatible := by
          intro V₁ V₂ W g₁ g₂ f₁ f₂ hf₁ hf₂ _
          change (0 : E ⟶ _) ≫ G_pre.map g₁.op = (0 : E ⟶ _) ≫ G_pre.map g₂.op
          simp
        obtain ⟨_, _, huniq0⟩ := hG_for y0 hy0
        have h1 := huniq0 (n • φ_G) (fun V f hf => by
          change (n • φ_G) ≫ G_pre.map f.op = (0 : E ⟶ G_pre.obj (Opposite.op V))
          rw [CategoryTheory.Preadditive.nsmul_comp]
          have hf_eq : φ_G ≫ G_pre.map f.op = x f hf ≫ i_K_pre.app (Opposite.op V) := hφ_G f hf
          rw [hf_eq]
          apply AddCommGrpCat.hom_ext; ext e
          exact ((x f hf).hom e).2)
        have h2 := huniq0 (0 : E ⟶ G_pre.obj (Opposite.op U)) (fun V f hf => by
          change (0 : E ⟶ _) ≫ G_pre.map f.op = (0 : E ⟶ _)
          simp)
        intro e
        exact congrArg (fun ψ : E ⟶ G_pre.obj (Opposite.op U) => ψ.hom e) (h1.trans h2.symm)
      let φ_K : E ⟶ K_pre.obj (Opposite.op U) := AddCommGrpCat.ofHom
        { toFun := fun e => ⟨φ_G.hom e, hn_φ e⟩
          map_zero' := Subtype.ext (map_zero φ_G.hom)
          map_add' := fun e₁ e₂ => Subtype.ext (map_add φ_G.hom e₁ e₂) }
      refine ⟨φ_K, fun V f hf => ?_, fun ψ hψ => ?_⟩
      · apply AddCommGrpCat.hom_ext; ext e
        exact congrArg (fun θ : E ⟶ G_pre.obj (Opposite.op V) => θ.hom e) (hφ_G f hf)
      · have hψ_G : (ψ : E ⟶ _) ≫ i_K_pre.app (Opposite.op U) = φ_G := hφ_uniq _ (fun V f hf => by
          change ((ψ : E ⟶ _) ≫ i_K_pre.app (Opposite.op U)) ≫ G_pre.map f.op = y f hf
          rw [CategoryTheory.Category.assoc, ← i_K_pre.naturality f.op,
            ← CategoryTheory.Category.assoc]
          exact congrArg (· ≫ i_K_pre.app (Opposite.op V)) (hψ f hf))
        apply AddCommGrpCat.hom_ext; ext e
        exact congrArg (fun θ : E ⟶ G_pre.obj (Opposite.op U) => θ.hom e) hψ_G
    let K_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨K_pre, hK_sh⟩
    let i_K : K_sh ⟶ G_sh := ⟨i_K_pre⟩
    let p_conc : G_sh ⟶ G_sh := n • CategoryTheory.CategoryStruct.id G_sh

    let kMap : ∀ U : X.Etale, k →+* ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      fun U => CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.CategoryStruct.comp (Fgt.obj U).hom P₁_ov.hom)))
    have hkMap_nat : ∀ {U' U : X.Etale} (u : Quiver.Hom U' U) (c : k),
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop u.left)) (kMap U c) =
          kMap U' c := by
      intro U' U u c
      have hw : (Fgt.map u).left ≫ ((Fgt.obj U).hom ≫ P₁_ov.hom) = (Fgt.obj U').hom ≫ P₁_ov.hom :=
        (CategoryTheory.Category.assoc (Fgt.map u).left (Fgt.obj U).hom P₁_ov.hom).symm.trans
          (congrArg (· ≫ P₁_ov.hom) (CategoryTheory.Over.w (Fgt.map u)))
      have happ : AlgebraicGeometry.Scheme.Hom.appTop ((Fgt.obj U).hom ≫ P₁_ov.hom) ≫
          AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map u).left =
          AlgebraicGeometry.Scheme.Hom.appTop ((Fgt.obj U').hom ≫ P₁_ov.hom) :=
        (AlgebraicGeometry.Scheme.Hom.comp_appTop (Fgt.map u).left
          ((Fgt.obj U).hom ≫ P₁_ov.hom)).symm.trans
          (congrArg AlgebraicGeometry.Scheme.Hom.appTop hw)
      have hcomp : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appTop ((Fgt.obj U).hom ≫ P₁_ov.hom)) ≫
          AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map u).left =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appTop ((Fgt.obj U').hom ≫ P₁_ov.hom) :=
        (CategoryTheory.Category.assoc _ _ _).trans (congrArg _ happ)
      exact congrArg (fun φ => φ.hom c) hcomp

    have hToMul_nsmul : ∀ {G_m : Type u} [CommGroup G_m] (u : Additive G_m) (m : ℕ),
        Additive.toMul (m • u) = (Additive.toMul u) ^ m := by
      intro G_m _ u m
      induction m with
      | zero => simp
      | succ m ih => rw [succ_nsmul, toMul_add, ih, pow_succ]
    have hOfMul_pow : ∀ {G_m : Type u} [CommGroup G_m] (g : G_m) (m : ℕ),
        m • Additive.ofMul g = Additive.ofMul (g ^ m) := by
      intro G_m _ g m
      apply Additive.toMul.injective
      rw [hToMul_nsmul, toMul_ofMul, toMul_ofMul]

    let GmUnit (U : X.Etale) := Units ↑(U.left.presheaf.obj (Opposite.op ⊤))
    let α_fun : ∀ U : X.Etale, AM → ↥(K_sub (Opposite.op U)) := fun U a =>
      ⟨(Additive.ofMul (Units.map (kMap U).toMonoidHom (ζ ^ a.down.val)) : Additive (GmUnit U)), by
        change n • (Additive.ofMul (Units.map (kMap U).toMonoidHom (ζ ^ a.down.val)) :
          Additive (GmUnit U)) = (0 : Additive (GmUnit U))
        rw [hOfMul_pow, ← map_pow, ← pow_mul, mul_comm, pow_mul, hζu_pow, one_pow, map_one,
          ofMul_one]⟩
    let α_pre : P_const ⟶ K_pre :=
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := α_fun U.unop
            map_zero' := Subtype.ext (by
              change (Additive.ofMul (Units.map (kMap U.unop).toMonoidHom
                (ζ ^ (0 : ZMod n).val)) : Additive (GmUnit U.unop)) = (0 : Additive (GmUnit U.unop))
              rw [ZMod.val_zero, pow_zero, map_one, ofMul_one])
            map_add' := fun a b => Subtype.ext (by
              change (Additive.ofMul (Units.map (kMap U.unop).toMonoidHom
                (ζ ^ (a.down + b.down).val)) : Additive (GmUnit U.unop)) =
                (Additive.ofMul (Units.map (kMap U.unop).toMonoidHom (ζ ^ a.down.val)) :
                  Additive (GmUnit U.unop)) +
                (Additive.ofMul (Units.map (kMap U.unop).toMonoidHom (ζ ^ b.down.val)) :
                  Additive (GmUnit U.unop))
              rw [← ofMul_mul, ← map_mul, ← hζu_add a.down b.down]) }
        naturality := fun {U₁ U₂} f => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun a =>
          Subtype.ext (by
            change (Additive.ofMul (Units.map (kMap U₂.unop).toMonoidHom (ζ ^ a.down.val)) :
                Additive (GmUnit U₂.unop)) =
              (Additive.ofMul (Units.map (f.unop.left.appTop).hom.toMonoidHom
                (Units.map (kMap U₁.unop).toMonoidHom (ζ ^ a.down.val))) :
                Additive (GmUnit U₂.unop))
            congr 1; apply Units.ext
            simp only [Units.coe_map, map_pow, Units.val_pow_eq_pow_val]
            exact congrArg (· ^ a.down.val) (hkMap_nat f.unop ((ζ : kˣ) : k)).symm)) }
    let Φ_μ : C.obj AM ⟶ K_sh := (shAdj.homEquiv P_const K_sh).symm α_pre
    have hη_Φ : η_const ≫ Φ_μ.hom = α_pre :=
      (shAdj.homEquiv_unit P_const K_sh Φ_μ).symm.trans
        ((shAdj.homEquiv P_const K_sh).apply_symm_apply α_pre)

    let valK : ∀ {U : X.Etale}, ↥(K_sub (Opposite.op U)) → ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      fun {U} u => (@Additive.toMul (GmUnit U) u.1).val
    have hvalK_pow : ∀ {U : X.Etale} (u : ↥(K_sub (Opposite.op U))), (valK u) ^ n = 1 := by
      intro U u
      let u0 : Additive (GmUnit U) := u.1
      have hu0 : n • u0 = 0 := u.2
      have hu1 : (@Additive.toMul (GmUnit U) u0) ^ n = 1 := by
        rw [← hToMul_nsmul u0 n, hu0, toMul_zero]
      exact (Units.val_pow_eq_pow_val _ n).symm.trans (congrArg Units.val hu1)
    have hvalK_map : ∀ {U' U : X.Etale} (h : U' ⟶ U) (u : ↥(K_sub (Opposite.op U))),
        valK ((K_pre.map h.op).hom u) = (h.left.appTop).hom (valK u) :=
      fun _ _ => rfl
    have hvalK_α : ∀ (W : X.Etale) (a : ZMod n),
        valK ((α_pre.app (Opposite.op W)).hom (ULift.up a : AM)) = kMap W (ν a) :=
      fun W a => congrArg (kMap W) (Units.val_pow_eq_pow_val ζ a.val)

    let eIdemp : ∀ (U : X.Etale), ↥(K_sub (Opposite.op U)) → ZMod n →
        ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      fun U u a => Polynomial.eval₂ (kMap U) (valK u) (L_poly a)
    have heIdemp_map : ∀ {U' U : X.Etale} (h : U' ⟶ U) (u : ↥(K_sub (Opposite.op U))) (a : ZMod n),
        (h.left.appTop).hom (eIdemp U u a) = eIdemp U' ((K_pre.map h.op).hom u) a := by
      intro U' U h u a
      dsimp [eIdemp]
      rw [Polynomial.hom_eval₂, hvalK_map]
      congr 1; ext c; exact hkMap_nat h c

    let O_cov : ∀ (U : X.Etale), ↥(K_sub (Opposite.op U)) → ZMod n → U.left.Opens :=
      fun U u a => U.left.basicOpen (eIdemp U u a)
    let V_cov : ∀ (U : X.Etale), ↥(K_sub (Opposite.op U)) → ZMod n → X.Etale :=
      fun U u a =>
        have _ : AlgebraicGeometry.Etale U.hom := U.prop
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_cov U u a).ι ≫ U.hom) inferInstance
    let f_cov : ∀ (U : X.Etale) (u : ↥(K_sub (Opposite.op U))) (a : ZMod n), V_cov U u a ⟶ U :=
      fun U u a => CategoryTheory.MorphismProperty.Over.homMk (O_cov U u a).ι rfl

    have hf_cov_mem : ∀ (U : X.Etale) (u : ↥(K_sub (Opposite.op U))),
        CategoryTheory.Sieve.ofArrows (V_cov U u) (f_cov U u) ∈ J U := by
      intro U u
      obtain ⟨hsum, _, _⟩ := hIdemp _ (kMap U) (valK u) (hvalK_pow u)
      refine (hJ_iff U _).mpr (fun x => ?_)
      have hex : ∃ a : ZMod n, x ∈ O_cov U u a := by
        by_contra hall
        have hmem : ∀ a : ZMod n,
            (U.left.presheaf.Γgerm x).hom (eIdemp U u a) ∈
              IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk x) := by
          intro a
          by_contra hnot
          have hu := IsLocalRing.notMem_maximalIdeal.mp hnot
          exact hall ⟨a, (AlgebraicGeometry.RingedSpace.mem_top_basicOpen
            U.left.toRingedSpace (eIdemp U u a) x).mpr hu⟩
        have hs := Submodule.sum_mem _ (fun a (_ : a ∈ (Finset.univ : Finset (ZMod n))) => hmem a)
        rw [← map_sum, hsum, map_one] at hs
        exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) hs
      obtain ⟨a, ha⟩ := hex
      refine ⟨V_cov U u a, f_cov U u a, ⟨x, ha⟩,
        CategoryTheory.Sieve.ofArrows_mk (V_cov U u) (f_cov U u) a, ?_, rfl⟩
      change AlgebraicGeometry.Etale (O_cov U u a).ι
      infer_instance

    have hf_disj_empty : ∀ (U : X.Etale) (u : ↥(K_sub (Opposite.op U))) {W : X.Etale}
        {a b : ZMod n} (ga : W ⟶ V_cov U u a) (gb : W ⟶ V_cov U u b),
        ga ≫ f_cov U u a = gb ≫ f_cov U u b → a ≠ b → IsEmpty ↥W.left := by
      intro U u W a b ga gb hcomm hab
      obtain ⟨_, horth, _⟩ := hIdemp _ (kMap U) (valK u) (hvalK_pow u)
      refine ⟨fun z => ?_⟩
      let ya : ↥(O_cov U u a) := ga.left.base z
      let yb : ↥(O_cov U u b) := gb.left.base z
      have hxy : ya.1 = yb.1 := congrArg (fun k : W ⟶ U => k.left.base z) hcomm
      have hxa : ya.1 ∈ O_cov U u a := ya.2
      have hxb : ya.1 ∈ O_cov U u b := hxy.symm ▸ yb.2
      have hua : IsUnit ((U.left.presheaf.Γgerm ya.1).hom (eIdemp U u a)) :=
        (AlgebraicGeometry.RingedSpace.mem_top_basicOpen U.left.toRingedSpace _ ya.1).mp hxa
      have hub : IsUnit ((U.left.presheaf.Γgerm ya.1).hom (eIdemp U u b)) :=
        (AlgebraicGeometry.RingedSpace.mem_top_basicOpen U.left.toRingedSpace _ ya.1).mp hxb
      have hmul := hua.mul hub
      rw [← map_mul, horth a b hab, map_zero] at hmul
      exact hmul.ne_zero rfl

    have hf_val_eq : ∀ (U : X.Etale) (u : ↥(K_sub (Opposite.op U))) (a : ZMod n),
        (K_pre.map (f_cov U u a).op).hom u =
          (α_pre.app (Opposite.op (V_cov U u a))).hom (ULift.up a) := by
      intro U u a
      obtain ⟨_, _, heig⟩ := hIdemp _ (kMap U) (valK u) (hvalK_pow u)
      let Oa := O_cov U u a
      have hv_eq : (Oa.ι.appTop).hom (valK u) = kMap (V_cov U u a) (ν a) := by
        apply TopCat.Presheaf.section_ext Oa.toScheme.sheaf ⊤
        intro z _
        have hz_mem : z.1 ∈ Oa := z.2
        have huz_base : IsUnit ((U.left.presheaf.Γgerm z.1).hom (eIdemp U u a)) :=
          (AlgebraicGeometry.RingedSpace.mem_top_basicOpen U.left.toRingedSpace _ z.1).mp hz_mem
        have huz : IsUnit ((Oa.toScheme.presheaf.Γgerm z).hom ((Oa.ι.appTop).hom (eIdemp U u a))) := by
          rw [hAppTopGerm Oa.ι z (eIdemp U u a)]
          exact huz_base.map (AlgebraicGeometry.Scheme.Hom.stalkMap Oa.ι z).hom
        have hk_eq : (Oa.ι.appTop).hom (kMap U (ν a)) = kMap (V_cov U u a) (ν a) :=
          hkMap_nat (f_cov U u a) (ν a)
        have hmul_eq :
            (Oa.toScheme.presheaf.Γgerm z).hom ((Oa.ι.appTop).hom (valK u)) *
              (Oa.toScheme.presheaf.Γgerm z).hom ((Oa.ι.appTop).hom (eIdemp U u a)) =
            (Oa.toScheme.presheaf.Γgerm z).hom (kMap (V_cov U u a) (ν a)) *
              (Oa.toScheme.presheaf.Γgerm z).hom ((Oa.ι.appTop).hom (eIdemp U u a)) := by
          rw [← hk_eq, ← map_mul, ← map_mul, ← map_mul, ← map_mul]
          exact congrArg (Oa.toScheme.presheaf.Γgerm z).hom (congrArg (Oa.ι.appTop).hom (heig a))
        exact huz.mul_right_cancel hmul_eq
      apply Subtype.ext
      apply (@Additive.toMul (GmUnit (V_cov U u a))).injective
      apply Units.ext
      exact hv_eq.trans (hvalK_α (V_cov U u a) a).symm

    let x_amalg : ∀ (U : X.Etale) (u : ↥(K_sub (Opposite.op U))) (a : ZMod n),
        Aℤ ⟶ (C.obj AM).obj.obj (Opposite.op (V_cov U u a)) :=
      fun U u a => zLift _ ((η_const.app (Opposite.op (V_cov U u a))).hom (ULift.up a))
    have hx_amalg_compat : ∀ (U : X.Etale) (u : ↥(K_sub (Opposite.op U)))
        ⦃W : X.Etale⦄ ⦃a b : ZMod n⦄ (ga : W ⟶ V_cov U u a) (gb : W ⟶ V_cov U u b),
        ga ≫ f_cov U u a = gb ≫ f_cov U u b →
        x_amalg U u a ≫ (C.obj AM).obj.map ga.op = x_amalg U u b ≫ (C.obj AM).obj.map gb.op := by
      intro U u W a b ga gb hcomm
      by_cases hab : a = b
      · subst hab
        dsimp [x_amalg]
        rw [hzLift_comp, hzLift_comp]
        have h1 := congrArg (fun ψ : AM ⟶ _ => ψ.hom (ULift.up a)) (η_const.naturality ga.op)
        have h2 := congrArg (fun ψ : AM ⟶ _ => ψ.hom (ULift.up a)) (η_const.naturality gb.op)
        exact congrArg (zLift _) (h1.symm.trans h2)
      · have _ : Subsingleton ↑((C.obj AM).obj.obj (Opposite.op W)) :=
          hEmpty_sub (C.obj AM) W (hf_disj_empty U u ga gb hcomm hab)
        exact hzLift_inj (Subsingleton.elim _ _)

    let Ψ_fun : ∀ (U : X.Etale), ↥(K_sub (Opposite.op U)) → ↑((C.obj AM).obj.obj (Opposite.op U)) :=
      fun U u => (((C.obj AM).2.amalgamateOfArrows (f_cov U u) (hf_cov_mem U u)
        (x_amalg U u) (hx_amalg_compat U u)).hom (ULift.up 1))
    have hΨ_map : ∀ (U : X.Etale) (u : ↥(K_sub (Opposite.op U))) (a : ZMod n),
        ((C.obj AM).obj.map (f_cov U u a).op).hom (Ψ_fun U u) =
          (η_const.app (Opposite.op (V_cov U u a))).hom (ULift.up a) := by
      intro U u a
      have hm := (C.obj AM).2.amalgamateOfArrows_map (f_cov U u) (hf_cov_mem U u)
        (x_amalg U u) (hx_amalg_compat U u) a
      exact (congrArg (fun ψ : Aℤ ⟶ _ => ψ.hom (ULift.up 1)) hm).trans (hzLift_eval _ _)

    have hΨ_char : ∀ {W U : X.Etale} (h : W ⟶ U) (u : ↥(K_sub (Opposite.op U))) (c : ZMod n),
        (K_pre.map h.op).hom u = (α_pre.app (Opposite.op W)).hom (ULift.up c) →
        ((C.obj AM).obj.map h.op).hom (Ψ_fun U u) =
          (η_const.app (Opposite.op W)).hom (ULift.up c) := by
      intro W U h u c huW
      let uW : ↥(K_sub (Opposite.op W)) := (K_pre.map h.op).hom u
      have heq_z : zLift _ (((C.obj AM).obj.map h.op).hom (Ψ_fun U u)) =
          zLift _ ((η_const.app (Opposite.op W)).hom (ULift.up c)) := by
        apply (C.obj AM).2.hom_ext_ofArrows (f_cov W uW) (hf_cov_mem W uW)
        intro a
        rw [hzLift_comp, hzLift_comp]
        have h_range : Set.range ((O_cov W uW a).ι ≫ h.left).base ⊆
            Set.range (O_cov U u a).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨y, rfl⟩
          change h.left.base y.1 ∈ O_cov U u a
          have huy : IsUnit ((W.left.presheaf.Γgerm y.1).hom (eIdemp W uW a)) :=
            (AlgebraicGeometry.RingedSpace.mem_top_basicOpen W.left.toRingedSpace _ y.1).mp y.2
          rw [← heIdemp_map h u a, hAppTopGerm h.left y.1 (eIdemp U u a), isUnit_map_iff] at huy
          exact (AlgebraicGeometry.RingedSpace.mem_top_basicOpen
            U.left.toRingedSpace _ _).mpr huy
        let g_lift : (O_cov W uW a).toScheme ⟶ (O_cov U u a).toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift (O_cov U u a).ι
            ((O_cov W uW a).ι ≫ h.left) h_range
        have hg_comm : g_lift ≫ (O_cov U u a).ι = (O_cov W uW a).ι ≫ h.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ h_range
        let g_et : V_cov W uW a ⟶ V_cov U u a :=
          CategoryTheory.MorphismProperty.Over.homMk g_lift (by
            change g_lift ≫ ((O_cov U u a).ι ≫ U.hom) = (O_cov W uW a).ι ≫ W.hom
            exact (CategoryTheory.Category.assoc g_lift _ _).symm.trans
              ((congrArg (· ≫ U.hom) hg_comm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg ((O_cov W uW a).ι ≫ ·) (CategoryTheory.MorphismProperty.Over.w h)))))
        have hcomm_et : g_et ≫ f_cov U u a = f_cov W uW a ≫ h :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hg_comm
        have hLHS : ((C.obj AM).obj.map (f_cov W uW a).op).hom
            (((C.obj AM).obj.map h.op).hom (Ψ_fun U u)) =
            (η_const.app (Opposite.op (V_cov W uW a))).hom (ULift.up a) := by
          change ((C.obj AM).obj.map h.op ≫ (C.obj AM).obj.map (f_cov W uW a).op).hom _ = _
          rw [← (C.obj AM).obj.map_comp, ← op_comp, ← hcomm_et, op_comp, (C.obj AM).obj.map_comp]
          change ((C.obj AM).obj.map g_et.op).hom
            (((C.obj AM).obj.map (f_cov U u a).op).hom (Ψ_fun U u)) = _
          rw [hΨ_map U u a]
          exact (congrArg (fun ψ : AM ⟶ _ => ψ.hom (ULift.up a))
            (η_const.naturality g_et.op)).symm
        have hRHS : ((C.obj AM).obj.map (f_cov W uW a).op).hom
            ((η_const.app (Opposite.op W)).hom (ULift.up c)) =
            (η_const.app (Opposite.op (V_cov W uW a))).hom (ULift.up c) :=
          (congrArg (fun ψ : AM ⟶ _ => ψ.hom (ULift.up c))
            (η_const.naturality (f_cov W uW a).op)).symm
        rw [hLHS, hRHS]
        by_cases hac : a = c
        · subst hac; rfl
        · have hEmp : IsEmpty ↥(V_cov W uW a).left := by
            refine ⟨fun z => hac ?_⟩
            have heq_u : (K_pre.map (f_cov W uW a).op).hom uW =
                (α_pre.app (Opposite.op (V_cov W uW a))).hom (ULift.up c) :=
              (congrArg (K_pre.map (f_cov W uW a).op).hom huW).trans
                (congrArg (fun ψ : AM ⟶ _ => ψ.hom (ULift.up c))
                  (α_pre.naturality (f_cov W uW a).op)).symm
            have heq_a := hf_val_eq W uW a
            have hval_eq := (hvalK_α (V_cov W uW a) a).symm.trans
              ((congrArg valK (heq_a.symm.trans heq_u)).trans (hvalK_α (V_cov W uW a) c))
            let γz : k →+* ↑(((V_cov W uW a).left).presheaf.stalk z) :=
              (((V_cov W uW a).left).presheaf.Γgerm z).hom.comp (kMap (V_cov W uW a))
            exact hν_inj (γz.injective
              (congrArg (((V_cov W uW a).left).presheaf.Γgerm z).hom hval_eq))
          have _ : Subsingleton ↑((C.obj AM).obj.obj (Opposite.op (V_cov W uW a))) :=
            hEmpty_sub (C.obj AM) _ hEmp
          exact congrArg (zLift _) (Subsingleton.elim _ _)
      exact (hzLift_eval _ _).symm.trans
        ((congrArg (fun φ => φ.hom (ULift.up 1)) heq_z).trans (hzLift_eval _ _))

    have hΨ_α : ∀ (U : X.Etale) (a : AM),
        Ψ_fun U ((α_pre.app (Opposite.op U)).hom a) =
          (η_const.app (Opposite.op U)).hom a := by
      intro U a
      have h1 := hΨ_char (𝟙 U) ((α_pre.app (Opposite.op U)).hom a) a.down
        (congrArg (fun φ : K_pre.obj _ ⟶ K_pre.obj _ => φ.hom _) (K_pre.map_id (Opposite.op U)))
      have h2 : ((C.obj AM).obj.map (Opposite.op (𝟙 U))).hom
          (Ψ_fun U ((α_pre.app (Opposite.op U)).hom a)) =
          Ψ_fun U ((α_pre.app (Opposite.op U)).hom a) :=
        congrArg (fun φ : (C.obj AM).obj.obj _ ⟶ _ => φ.hom _)
          ((C.obj AM).obj.map_id (Opposite.op U))
      exact h2.symm.trans h1

    have hΨ_nat : ∀ {W U : X.Etale} (h : W ⟶ U) (u : ↥(K_sub (Opposite.op U))),
        Ψ_fun W ((K_pre.map h.op).hom u) = ((C.obj AM).obj.map h.op).hom (Ψ_fun U u) := by
      intro W U h u
      let uW := (K_pre.map h.op).hom u
      have heq_z : zLift _ (Ψ_fun W uW) = zLift _ (((C.obj AM).obj.map h.op).hom (Ψ_fun U u)) := by
        apply (C.obj AM).2.hom_ext_ofArrows (f_cov W uW) (hf_cov_mem W uW)
        intro a
        rw [hzLift_comp, hzLift_comp, hΨ_map W uW a]
        have hcomp_m : ((C.obj AM).obj.map (f_cov W uW a).op).hom
            (((C.obj AM).obj.map h.op).hom (Ψ_fun U u)) =
            ((C.obj AM).obj.map (f_cov W uW a ≫ h).op).hom (Ψ_fun U u) := by
          change ((C.obj AM).obj.map h.op ≫ (C.obj AM).obj.map (f_cov W uW a).op).hom _ = _
          rw [← (C.obj AM).obj.map_comp, ← op_comp]
        rw [hcomp_m, hΨ_char (f_cov W uW a ≫ h) u a]
        change (K_pre.map h.op ≫ K_pre.map (f_cov W uW a).op).hom u = _
        exact hf_val_eq W uW a
      exact (hzLift_eval _ _).symm.trans
        ((congrArg (fun φ => φ.hom (ULift.up 1)) heq_z).trans (hzLift_eval _ _))

    have hΨ_add : ∀ (U : X.Etale) (u₁ u₂ : ↥(K_sub (Opposite.op U))),
        Ψ_fun U (u₁ + u₂) = Ψ_fun U u₁ + Ψ_fun U u₂ := by
      intro U u₁ u₂
      have heq_z : zLift _ (Ψ_fun U (u₁ + u₂)) = zLift _ (Ψ_fun U u₁ + Ψ_fun U u₂) := by
        apply (C.obj AM).2.hom_ext_ofArrows (f_cov U u₁) (hf_cov_mem U u₁)
        intro a
        let Va := V_cov U u₁ a
        let fa := f_cov U u₁ a
        let u₂a := (K_pre.map fa.op).hom u₂
        apply (C.obj AM).2.hom_ext_ofArrows (f_cov Va u₂a) (hf_cov_mem Va u₂a)
        intro b
        let Wab := V_cov Va u₂a b
        let fb := f_cov Va u₂a b
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← (C.obj AM).obj.map_comp, ← op_comp, hzLift_comp, hzLift_comp]
        have hu12 : (K_pre.map (fb ≫ fa).op).hom (u₁ + u₂) =
            (α_pre.app (Opposite.op Wab)).hom (ULift.up (a + b)) := by
          rw [map_add, op_comp, K_pre.map_comp]
          change (K_pre.map fb.op).hom ((K_pre.map fa.op).hom u₁) +
            (K_pre.map fb.op).hom u₂a = _
          rw [hf_val_eq U u₁ a, hf_val_eq Va u₂a b]
          have hnat_a : (K_pre.map fb.op).hom ((α_pre.app (Opposite.op Va)).hom (ULift.up a)) =
              (α_pre.app (Opposite.op Wab)).hom (ULift.up a) :=
            (congrArg (fun ψ : AM ⟶ _ => ψ.hom (ULift.up a)) (α_pre.naturality fb.op)).symm
          rw [hnat_a]
          exact (map_add (α_pre.app (Opposite.op Wab)).hom (ULift.up a : AM) (ULift.up b : AM)).symm
        rw [hΨ_char (fb ≫ fa) (u₁ + u₂) (a + b) hu12]
        rw [map_add ((C.obj AM).obj.map (fb ≫ fa).op).hom]
        have h1 : ((C.obj AM).obj.map (fb ≫ fa).op).hom (Ψ_fun U u₁) =
            (η_const.app (Opposite.op Wab)).hom (ULift.up a) :=
          hΨ_char (fb ≫ fa) u₁ a (by
            rw [op_comp, K_pre.map_comp]
            change (K_pre.map fb.op).hom ((K_pre.map fa.op).hom u₁) = _
            rw [hf_val_eq U u₁ a]
            exact (congrArg (fun ψ : AM ⟶ _ => ψ.hom (ULift.up a)) (α_pre.naturality fb.op)).symm)
        have h2 : ((C.obj AM).obj.map (fb ≫ fa).op).hom (Ψ_fun U u₂) =
            (η_const.app (Opposite.op Wab)).hom (ULift.up b) :=
          hΨ_char (fb ≫ fa) u₂ b (hf_val_eq Va u₂a b)
        rw [h1, h2]
        exact congrArg (zLift _) (map_add (η_const.app (Opposite.op Wab)).hom
          (ULift.up a) (ULift.up b))
      exact (hzLift_eval _ _).symm.trans
        ((congrArg (fun φ => φ.hom (ULift.up 1)) heq_z).trans (hzLift_eval _ _))

    let Ψ_pre : K_pre ⟶ (C.obj AM).obj :=
      { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk' (Ψ_fun U.unop) (hΨ_add U.unop))
        naturality := fun {_ _} f => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun u =>
          hΨ_nat f.unop u) }
    let Ψ_μ : K_sh ⟶ C.obj AM := ⟨Ψ_pre⟩
    have hΦ_Ψ_id : Φ_μ ≫ Ψ_μ = 𝟙 (C.obj AM) := by
      apply (shAdj.homEquiv P_const (C.obj AM)).injective
      have hu₁ := shAdj.homEquiv_unit P_const (C.obj AM) (Φ_μ ≫ Ψ_μ)
      have hu₂ := shAdj.homEquiv_unit P_const (C.obj AM) (𝟙 (C.obj AM))
      have hmid : η_const ≫ (Φ_μ.hom ≫ Ψ_pre) = η_const ≫ 𝟙 (C.obj AM).obj := by
        rw [← CategoryTheory.Category.assoc, hη_Φ, CategoryTheory.Category.comp_id]
        ext U a
        exact hΨ_α U.unop a
      exact hu₁.trans (hmid.trans hu₂.symm)
    have hΨ_Φ_id : Ψ_μ ≫ Φ_μ = 𝟙 K_sh := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext ⟨U⟩
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro u
      have heq_z : zLift _ ((Φ_μ.hom.app (Opposite.op U)).hom (Ψ_fun U u)) = zLift _ u := by
        apply hK_sh.hom_ext_ofArrows (f_cov U u) (hf_cov_mem U u)
        intro a
        rw [hzLift_comp, hzLift_comp]
        have hnat : (K_pre.map (f_cov U u a).op).hom
            ((Φ_μ.hom.app (Opposite.op U)).hom (Ψ_fun U u)) =
            (Φ_μ.hom.app (Opposite.op (V_cov U u a))).hom
              (((C.obj AM).obj.map (f_cov U u a).op).hom (Ψ_fun U u)) :=
          (congrArg (fun ψ : (C.obj AM).obj.obj (Opposite.op U) ⟶ _ => ψ.hom (Ψ_fun U u))
            (Φ_μ.hom.naturality (f_cov U u a).op)).symm
        rw [hnat, hΨ_map U u a]
        have hη_ev : (Φ_μ.hom.app (Opposite.op (V_cov U u a))).hom
            ((η_const.app (Opposite.op (V_cov U u a))).hom (ULift.up a)) =
            (α_pre.app (Opposite.op (V_cov U u a))).hom (ULift.up a) :=
          congrArg (fun θ : P_const ⟶ K_pre =>
            (θ.app (Opposite.op (V_cov U u a))).hom (ULift.up a)) hη_Φ
        rw [hη_ev, hf_val_eq U u a]
      exact (hzLift_eval _ _).symm.trans
        ((congrArg (fun φ => φ.hom (ULift.up 1)) heq_z).trans (hzLift_eval _ _))

    let ι_conc : C.obj AM ⟶ G_sh := Φ_μ ≫ i_K
    have _ : CategoryTheory.Mono i_K := ⟨fun {W_sh} q₁ q₂ hq => by
      ext U w
      exact congrArg (fun θ : W_sh ⟶ G_sh => (θ.hom.app U).hom w) hq⟩
    have _ : CategoryTheory.IsIso Φ_μ := ⟨⟨Ψ_μ, hΦ_Ψ_id, hΨ_Φ_id⟩⟩
    have _ : CategoryTheory.Mono ι_conc := CategoryTheory.mono_comp Φ_μ i_K
    have h0_K : i_K ≫ p_conc = 0 := by
      ext U u
      change n • u.1 = 0
      exact u.2
    have h0_conc : ι_conc ≫ p_conc = 0 := by
      dsimp [ι_conc]; rw [CategoryTheory.Category.assoc, h0_K, CategoryTheory.Limits.comp_zero]
    let lift_K : ∀ {W_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (g : W_sh ⟶ G_sh),
        g ≫ p_conc = 0 → (W_sh ⟶ K_sh) :=
      fun {W_sh} g hg =>
        { hom :=
            { app := fun U => AddCommGrpCat.ofHom
                { toFun := fun w => ⟨(g.hom.app U).hom w,
                    congrArg (fun θ : W_sh ⟶ G_sh => (θ.hom.app U).hom w) hg⟩
                  map_zero' := Subtype.ext (map_zero _)
                  map_add' := fun w₁ w₂ => Subtype.ext (map_add _ w₁ w₂) }
              naturality := fun {U₁ U₂} f => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun w =>
                Subtype.ext (congrArg (fun θ : W_sh.obj.obj U₁ ⟶ G_pre.obj U₂ => θ.hom w)
                  (g.hom.naturality f))) } }
    have hlift_K_fac : ∀ {W_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (g : W_sh ⟶ G_sh)
        (hg : g ≫ p_conc = 0), (lift_K g hg ≫ Ψ_μ) ≫ ι_conc = g := by
      intro W_sh g hg
      dsimp [ι_conc]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc Ψ_μ, hΨ_Φ_id,
        CategoryTheory.Category.id_comp]
      ext U w; rfl
    have hKer_conc : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι ι_conc h0_conc) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun g hg => lift_K g hg ≫ Ψ_μ)
        (fun g hg => hlift_K_fac g hg)
        (fun g hg _ hm => (cancel_mono ι_conc).mp (hm.trans (hlift_K_fac g hg).symm))
    have hExact_conc : (CategoryTheory.ShortComplex.mk ι_conc p_conc h0_conc).Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer_conc
    let ι_kum : C.obj AM ⟶ weilEtaleGmSheaf X := ι_conc ≫ e_gm.hom
    let p_kum : weilEtaleGmSheaf X ⟶ weilEtaleGmSheaf X :=
      n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X)
    have hp_comm : p_conc ≫ e_gm.hom = e_gm.hom ≫ p_kum := by
      dsimp [p_conc, p_kum]
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have h0_kum : ι_kum ≫ p_kum = 0 := by
      dsimp [ι_kum]
      rw [CategoryTheory.Category.assoc, ← hp_comm, ← CategoryTheory.Category.assoc, h0_conc,
        CategoryTheory.Limits.zero_comp]
    let sc_iso : CategoryTheory.ShortComplex.mk ι_conc p_conc h0_conc ≅
        CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum :=
      CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _) e_gm e_gm
        (CategoryTheory.Category.id_comp ι_kum).symm hp_comm.symm
    have hExact_kum : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_iso sc_iso).mp hExact_conc
    have _ : CategoryTheory.Mono ι_kum := CategoryTheory.mono_comp ι_conc e_gm.hom
    have hEx_kum : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).ShortExact :=
      { exact := hExact_kum }

    have hUnit_eq : (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_P1).unit.app AM =
        η_const.app (Opposite.op T_P1) := by
      have hcomp_u := CategoryTheory.Adjunction.comp_unit_app
        (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_P1) shAdj AM
      have hid_u := CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT_P1 AM
      exact hcomp_u.trans ((congrArg (· ≫ η_const.app (Opposite.op T_P1)) hid_u).trans
        (CategoryTheory.Category.id_comp _))

    refine ⟨ι_kum, p_kum, h0_kum, hEx_kum, rfl, fun a => ?_⟩
    let u_pre : ↑(G_pre.obj (Opposite.op T_P1)) :=
      (i_K_pre.app (Opposite.op T_P1)).hom ((α_pre.app (Opposite.op T_P1)).hom (ULift.up a))
    refine ⟨u_pre, ?_, ?_⟩
    · change ((shAdj.unit.app G_pre).app (Opposite.op T_P1)).hom u_pre =
        (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_P1).unit.app AM) ≫
          (ι_kum.hom.app (Opposite.op T_P1))).hom (ULift.up a)
      rw [hUnit_eq]
      have h1 : (ι_conc.hom.app (Opposite.op T_P1)).hom
          ((η_const.app (Opposite.op T_P1)).hom (ULift.up a)) = u_pre := by
        change ((η_const ≫ Φ_μ.hom ≫ i_K_pre).app (Opposite.op T_P1)).hom (ULift.up a) = u_pre
        rw [← CategoryTheory.Category.assoc η_const, hη_Φ]
        rfl
      change ((shAdj.unit.app G_pre).app (Opposite.op T_P1)).hom u_pre =
        (e_gm.hom.hom.app (Opposite.op T_P1)).hom
          ((ι_conc.hom.app (Opposite.op T_P1)).hom
            ((η_const.app (Opposite.op T_P1)).hom (ULift.up a)))
      rw [h1]; rfl
    · exact map_pow (kMap T_P1) ((ζ : kˣ) : k) a.val

  
  have hTid_pkg :
      let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
      let pt₀ : ↥S_k := (⊥ : PrimeSpectrum k)
      let T_id : P₁_ov.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.id P₁_ov.left)
        (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id P₁_ov.left))
      let η_K := (CategoryTheory.sheafificationAdjunction P₁_ov.left.smallEtaleTopology
        AddCommGrpCat.{u}).unit.app (weilEtaleKPresheaf P₁_ov.left)
      (∃ hCl_inf₀ : IsClosed ({s_inf₀.base pt₀} : Set ↥P₁_ov.left),
        (Set.range ι_1.base)ᶜ = {s_inf₀.base pt₀} ∧
        ∀ m : ℤ,
          m • Finsupp.single ⟨s_inf₀.base pt₀, hCl_inf₀⟩ (1 : ℤ) ∈
            weilCurvePrincipalSubgroup P₁_ov.left → m = 0) ∧
      (∀ f : Units ↑P₁_ov.left.functionField,
        ∃ s : ↥((weilEtaleKPresheaf P₁_ov.left).obj (Opposite.op T_id)),
          ∀ x : { x : ↥P₁_ov.left // IsClosed ({x} : Set ↥P₁_ov.left) },
            let Rx := ↑(P₁_ov.left.presheaf.stalk x.1)
            let mx := IsLocalRing.maximalIdeal Rx
            ∃ (a b : Rx) (na nb : ℕ),
              a ≠ 0 ∧ b ≠ 0 ∧
              algebraMap Rx ↑P₁_ov.left.functionField a =
                (f : ↑P₁_ov.left.functionField) * algebraMap Rx ↑P₁_ov.left.functionField b ∧
              Ideal.span ({a} : Set Rx) = mx ^ na ∧
              Ideal.span ({b} : Set Rx) = mx ^ nb ∧
              valDiv T_id
                ((div_mor.hom.app (Opposite.op T_id)).hom
                  ((η_K.app (Opposite.op T_id)).hom s))
                ⟨x.1, x.2⟩ = (na : ℤ) - (nb : ℤ)) ∧
      (∀ (s : ↥((weilEtaleKPresheaf P₁_ov.left).obj (Opposite.op T_id)))
          (D : { x : ↥P₁_ov.left // IsClosed ({x} : Set ↥P₁_ov.left) } →₀ ℤ),
        (∀ x : { x : ↥P₁_ov.left // IsClosed ({x} : Set ↥P₁_ov.left) },
          valDiv T_id
            ((div_mor.hom.app (Opposite.op T_id)).hom
              ((η_K.app (Opposite.op T_id)).hom s))
            ⟨x.1, x.2⟩ = D x) →
        D ∈ weilCurvePrincipalSubgroup P₁_ov.left) := by
    intro S_k pt₀ T_id η_K
    let X := P₁_ov.left
    let Pt := { x : ↥X // IsClosed ({x} : Set ↥X) }
    have _ : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    have _ : AlgebraicGeometry.IsOpenImmersion ι_1 := hOpen_1
    have hOrd_Tid := hOrd_all T_id

    let P_inf₀ : ↥X := s_inf₀.base pt₀
    have hCompl_inf : (Set.range ι_1.base)ᶜ = {P_inf₀} := by
      ext z
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      constructor
      · intro hz
        have hcov : z ∈ Set.range ι_1.base ∪ Set.range s_inf₀.base := hs₀_cov.symm ▸ Set.mem_univ z
        rcases hcov with h1 | ⟨p, rfl⟩
        · exact False.elim (hz h1)
        · exact congrArg s_inf₀.base (Subsingleton.elim p pt₀)
      · rintro rfl hz
        exact Set.disjoint_left.mp hs₀_disj hz ⟨pt₀, rfl⟩
    have hCl_inf₀ : IsClosed ({P_inf₀} : Set ↥X) := by
      rw [← hCompl_inf]
      exact (AlgebraicGeometry.IsOpenImmersion.isOpen_range ι_1).isClosed_compl
    let Q_inf₀ : Pt := ⟨P_inf₀, hCl_inf₀⟩
    let E_1 : Pt →₀ ℤ := Finsupp.single Q_inf₀ 1

    have h_appLE_congr : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} {O₂ : Z₂.Opens} {O₁ : Z₁.Opens}
        (g₁ g₂ : Z₁ ⟶ Z₂), g₁ = g₂ →
        ∀ (h₁ : O₁ ≤ (TopologicalSpace.Opens.map g₁.base).obj O₂)
          (h₂ : O₁ ≤ (TopologicalSpace.Opens.map g₂.base).obj O₂),
        g₁.appLE O₂ O₁ h₁ = g₂.appLE O₂ O₁ h₂ := by
      rintro _ _ _ _ _ _ rfl _ _; rfl

    have hPrinc_inf : ∀ m : ℤ, m • E_1 ∈ weilCurvePrincipalSubgroup X → m = 0 := by
      intro m hm_mem
      by_contra hm_ne
      let k_m : ℕ := m.natAbs
      have hk_pos : 1 ≤ k_m := Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hm_ne)
      let D_neg : Pt →₀ ℤ := (-(k_m : ℤ)) • E_1
      have hD_mem : D_neg ∈ weilCurvePrincipalSubgroup X := by
        rcases Int.natAbs_eq m with hm_eq | hm_eq
        · have h1 : D_neg = -(m • E_1) := by dsimp [D_neg]; rw [← hm_eq, neg_zsmul]
          rw [h1]; exact (weilCurvePrincipalSubgroup X).neg_mem hm_mem
        · have h1 : D_neg = m • E_1 := by dsimp [D_neg]; congr 1; omega
          rw [h1]; exact hm_mem
      rw [← hRange_div] at hD_mem
      obtain ⟨u_add, hu_div⟩ := hD_mem
      let u : Units ↑X.functionField := Additive.toMul u_add
      have hu_ofMul : Additive.ofMul u = u_add := rfl

      let U_aff : X.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_1
      have _ : AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        inferInstance
      have hAff_U : AlgebraicGeometry.IsAffineOpen U_aff :=
        AlgebraicGeometry.isAffineOpen_opensRange ι_1
      let p_zero : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))).base pt₀
      have _ : Nonempty ↥(U_aff : AlgebraicGeometry.Scheme.{u}) :=
        ⟨⟨ι_1.base p_zero, ⟨p_zero, rfl⟩⟩⟩
      have _ : IsFractionRing ↑(X.presheaf.obj (Opposite.op U_aff)) ↑X.functionField :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X U_aff hAff_U
      let e_sch : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ≅ U_aff.toScheme :=
        ι_1.isoOpensRange
      let e_ι_app : X.presheaf.obj (Opposite.op U_aff) ≅
          U_aff.toScheme.presheaf.obj (Opposite.op ⊤) :=
        CategoryTheory.asIso (AlgebraicGeometry.Scheme.Hom.appLE U_aff.ι U_aff ⊤ (fun x _ => x.2))
      let e_appTop : U_aff.toScheme.presheaf.obj (Opposite.op ⊤) ≅
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).presheaf.obj (Opposite.op ⊤) :=
        { hom := e_sch.hom.appTop
          inv := e_sch.inv.appTop
          hom_inv_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] }
      let Φ_ring : X.presheaf.obj (Opposite.op U_aff) ≅ CommRingCat.of (Polynomial k) :=
        e_ι_app ≪≫ e_appTop ≪≫ AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))
      have hΦ_hom_eq : Φ_ring.hom =
          AlgebraicGeometry.Scheme.Hom.appLE ι_1 U_aff ⊤ (fun x _ => ⟨x, rfl⟩) ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom := by
        have h_app_eq : e_ι_app.hom ≫ e_sch.hom.appTop =
            AlgebraicGeometry.Scheme.Hom.appLE ι_1 U_aff ⊤ (fun x _ => ⟨x, rfl⟩) :=
          (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e_sch.hom U_aff.ι U_aff ⊤ ⊤
            (fun x _ => x.2) (fun _ _ => trivial)).trans
            (h_appLE_congr (e_sch.hom ≫ U_aff.ι) ι_1
              (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_1) _ _)
        exact (CategoryTheory.Category.assoc e_ι_app.hom e_sch.hom.appTop _).symm.trans
          (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom)
            h_app_eq)
      let ψ_hom : CommRingCat.of (Polynomial k) ⟶ X.functionField :=
        Φ_ring.inv ≫ X.germToFunctionField U_aff
      let ψ : Polynomial k →+* ↑X.functionField := ψ_hom.hom
      have hψ_inj : Function.Injective ψ := by
        intro p₁ p₂ hp
        exact Φ_ring.symm.commRingCatIsoToRingEquiv.injective
          (IsFractionRing.injective ↑(X.presheaf.obj (Opposite.op U_aff)) ↑X.functionField hp)

      let e_ev : k → (S_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        fun c => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))
      let s_ev : k → (S_k ⟶ X) := fun c => e_ev c ≫ ι_1
      have hs_ev_over : ∀ c : k, s_ev c ≫ P₁_ov.hom = 𝟙 S_k := by
        intro c
        dsimp [s_ev, e_ev]
        rw [CategoryTheory.Category.assoc, hOver_1, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        have h_id : (Polynomial.evalRingHom c).comp (Polynomial.C : k →+* Polynomial k) =
            RingHom.id k := by ext x; simp
        rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      have hs_ev_cl : ∀ c : k, IsClosed ({(s_ev c).base pt₀} : Set ↥X) := by
        intro c
        have _ : AlgebraicGeometry.IsClosedImmersion (s_ev c ≫ P₁_ov.hom) := by
          rw [hs_ev_over c]; infer_instance
        have _ : AlgebraicGeometry.IsClosedImmersion (s_ev c) :=
          AlgebraicGeometry.IsClosedImmersion.of_comp (s_ev c) P₁_ov.hom
        have hrange : Set.range (s_ev c).base = {(s_ev c).base pt₀} := by
          ext z; simp only [Set.mem_range, Set.mem_singleton_iff]
          exact ⟨fun ⟨p, hp⟩ => hp.symm.trans (congrArg (s_ev c).base (Subsingleton.elim p pt₀)),
            fun hz => ⟨pt₀, hz.symm⟩⟩
        rw [← hrange]
        exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (s_ev c)).isClosed_range
      let Q_c : k → Pt := fun c => ⟨(s_ev c).base pt₀, hs_ev_cl c⟩
      have hQc_ne_inf : ∀ c : k, Q_c c ≠ Q_inf₀ := by
        intro c heq
        have hmem : P_inf₀ ∈ Set.range ι_1.base := by
          have h1 : (Q_c c).1 = P_inf₀ := congrArg Subtype.val heq
          rw [← h1]; exact ⟨(e_ev c).base pt₀, rfl⟩
        exact Set.disjoint_left.mp hs₀_disj hmem ⟨pt₀, rfl⟩

      have hPoly_of_reg : ∀ w : Units ↑X.functionField,
          (∀ c : k, 0 ≤ div_fn (Additive.ofMul w) (Q_c c)) →
          ∃ P : Polynomial k, ψ P = (w : ↑X.functionField) := by
        intro w hw
        obtain ⟨a_u, ⟨b_u, hb_nzd, hdiv_u⟩⟩ :=
          IsFractionRing.div_surjective (A := ↑(X.presheaf.obj (Opposite.op U_aff)))
            (w : ↑X.functionField)
        let A₀ : Polynomial k := Φ_ring.hom.hom a_u
        let B₀ : Polynomial k := Φ_ring.hom.hom b_u
        have hB₀_ne : B₀ ≠ 0 := fun h0 =>
          nonZeroDivisors.ne_zero hb_nzd
            (Φ_ring.commRingCatIsoToRingEquiv.injective (h0.trans (map_zero _).symm))
        have hψA₀ : ψ A₀ = algebraMap _ ↑X.functionField a_u := by
          change (Φ_ring.hom ≫ Φ_ring.inv ≫ X.germToFunctionField U_aff).hom a_u = _
          rw [Φ_ring.hom_inv_id_assoc]; rfl
        have hψB₀ : ψ B₀ = algebraMap _ ↑X.functionField b_u := by
          change (Φ_ring.hom ≫ Φ_ring.inv ≫ X.germToFunctionField U_aff).hom b_u = _
          rw [Φ_ring.hom_inv_id_assoc]; rfl
        let G : Polynomial k := EuclideanDomain.gcd A₀ B₀
        have hG_dvd_A : G ∣ A₀ := EuclideanDomain.gcd_dvd_left A₀ B₀
        have hG_dvd_B : G ∣ B₀ := EuclideanDomain.gcd_dvd_right A₀ B₀
        have hG_ne : G ≠ 0 := fun h0 => hB₀_ne (zero_dvd_iff.mp (h0 ▸ hG_dvd_B))
        let A : Polynomial k := A₀ / G
        let B : Polynomial k := B₀ / G
        have hGA : G * A = A₀ := EuclideanDomain.mul_div_cancel' hG_ne hG_dvd_A
        have hGB : G * B = B₀ := EuclideanDomain.mul_div_cancel' hG_ne hG_dvd_B
        have hB_ne : B ≠ 0 := fun h0 => hB₀_ne (by rw [← hGB, h0, mul_zero])
        let U_bez : Polynomial k := EuclideanDomain.gcdA A₀ B₀
        let V_bez : Polynomial k := EuclideanDomain.gcdB A₀ B₀
        have hBez : A * U_bez + B * V_bez = 1 := by
          apply mul_left_cancel₀ hG_ne
          have hgcd := EuclideanDomain.gcd_eq_gcd_ab A₀ B₀
          calc
            G * (A * U_bez + B * V_bez) = (G * A) * U_bez + (G * B) * V_bez := by ring
            _ = A₀ * U_bez + B₀ * V_bez := by rw [hGA, hGB]
            _ = G * 1 := by dsimp [G, U_bez, V_bez]; rw [← hgcd, mul_one]
        have hwB_eq_A : (w : ↑X.functionField) * ψ B = ψ A := by
          have hψB₀_ne : ψ B₀ ≠ 0 := fun h0 => hB₀_ne (hψ_inj (h0.trans (map_zero ψ).symm))
          have hwB₀ : (w : ↑X.functionField) * ψ B₀ = ψ A₀ := by
            have hb_K_ne : algebraMap ↑(X.presheaf.obj (Opposite.op U_aff))
                ↑X.functionField b_u ≠ 0 := hψB₀ ▸ hψB₀_ne
            rw [hψA₀, hψB₀]
            exact ((div_eq_iff hb_K_ne).mp hdiv_u).symm
          have hψG_ne : ψ G ≠ 0 := fun h0 => hG_ne (hψ_inj (h0.trans (map_zero ψ).symm))
          apply mul_left_cancel₀ hψG_ne
          calc
            ψ G * ((w : ↑X.functionField) * ψ B) = (w : ↑X.functionField) * (ψ G * ψ B) := by ring
            _ = (w : ↑X.functionField) * ψ B₀ := by rw [← map_mul, hGB]
            _ = ψ A₀ := hwB₀
            _ = ψ G * ψ A := by rw [← hGA, map_mul]
        have hB_deg0 : B.degree = 0 := by
          by_contra hdeg
          obtain ⟨c, hc_root⟩ := IsAlgClosed.exists_root B hdeg
          obtain ⟨r_c, hr_c⟩ := (hPos_div (Q_c c) w).mp (hw c)
          have hqc_mem : (Q_c c).1 ∈ U_aff := ⟨(e_ev c).base pt₀, rfl⟩
          let σ_c : Polynomial k →+* ↑(X.presheaf.stalk (Q_c c).1) :=
            (Φ_ring.inv ≫ X.presheaf.germ U_aff (Q_c c).1 hqc_mem).hom
          have halg_σ : ∀ P : Polynomial k,
              algebraMap ↑(X.presheaf.stalk (Q_c c).1) ↑X.functionField (σ_c P) = ψ P := by
            intro P
            have hg := TopCat.Presheaf.germ_stalkSpecializes X.presheaf hqc_mem
              (genericPoint_specializes (Q_c c).1)
            exact congrArg (fun θ => (Φ_ring.inv ≫ θ).hom P) hg
          have hrel_c : r_c * σ_c B = σ_c A := by
            apply IsFractionRing.injective ↑(X.presheaf.stalk (Q_c c).1) ↑X.functionField
            rw [map_mul, hr_c, halg_σ B, halg_σ A, hwB_eq_A]
          have hUnit_B : IsUnit (σ_c B) := by
            refine IsUnit.of_mul_eq_one (r_c * σ_c U_bez + σ_c V_bez) ?_
            calc
              σ_c B * (r_c * σ_c U_bez + σ_c V_bez) =
                  (r_c * σ_c B) * σ_c U_bez + σ_c B * σ_c V_bez := by ring
              _ = σ_c (A * U_bez + B * V_bez) := by rw [hrel_c]; simp
              _ = 1 := by rw [hBez, map_one]
          let stk_map := AlgebraicGeometry.Scheme.Hom.stalkMap (s_ev c) pt₀
          have hstk_comm : Φ_ring.inv ≫ X.presheaf.germ U_aff (Q_c c).1 hqc_mem ≫ stk_map =
              CommRingCat.ofHom (Polynomial.evalRingHom c) ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                S_k.presheaf.Γgerm pt₀ := by
            have h1 : X.presheaf.germ U_aff (Q_c c).1 hqc_mem ≫ stk_map =
                (s_ev c).appLE U_aff ⊤ (fun x _ => ⟨(e_ev c).base x, rfl⟩) ≫
                  S_k.presheaf.Γgerm pt₀ := by
              have hle_c : (⊤ : S_k.Opens) ≤ (TopologicalSpace.Opens.map (s_ev c).base).obj U_aff :=
                fun x _ => ⟨(e_ev c).base x, rfl⟩
              have hg1 : X.presheaf.germ U_aff (Q_c c).1 hqc_mem ≫ stk_map =
                  (s_ev c).app U_aff ≫ S_k.presheaf.germ _ pt₀ hqc_mem :=
                AlgebraicGeometry.Scheme.Hom.germ_stalkMap (s_ev c) U_aff pt₀ hqc_mem
              have hg2 : S_k.presheaf.map (CategoryTheory.homOfLE hle_c).op ≫
                  S_k.presheaf.Γgerm pt₀ =
                  S_k.presheaf.germ _ pt₀ hqc_mem :=
                TopCat.Presheaf.germ_res S_k.presheaf (CategoryTheory.homOfLE hle_c) pt₀ trivial
              exact hg1.trans ((congrArg ((s_ev c).app U_aff ≫ ·) hg2.symm).trans
                (CategoryTheory.Category.assoc _ _ _).symm)
            have h2 : (s_ev c).appLE U_aff ⊤ (fun x _ => ⟨(e_ev c).base x, rfl⟩) =
                ι_1.appLE U_aff ⊤ (fun x _ => ⟨x, rfl⟩) ≫ (e_ev c).appTop :=
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE (e_ev c) ι_1 U_aff ⊤ ⊤
                (fun x _ => ⟨x, rfl⟩) (fun _ _ => trivial)
            have h3 : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
                (e_ev c).appTop =
                CommRingCat.ofHom (Polynomial.evalRingHom c) ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
              rw [CategoryTheory.Iso.inv_comp_eq, ← CategoryTheory.Category.assoc,
                CategoryTheory.Iso.eq_comp_inv]
              exact AlgebraicGeometry.Scheme.ΓSpecIso_naturality
                (CommRingCat.ofHom (Polynomial.evalRingHom c))
            have hΦ_app : Φ_ring.inv ≫ ι_1.appLE U_aff ⊤ (fun x _ => ⟨x, rfl⟩) =
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv := by
              rw [CategoryTheory.Iso.inv_comp_eq, CategoryTheory.Iso.eq_comp_inv]
              exact hΦ_hom_eq.symm
            calc
              Φ_ring.inv ≫ X.presheaf.germ U_aff (Q_c c).1 hqc_mem ≫ stk_map
                = Φ_ring.inv ≫
                    (ι_1.appLE U_aff ⊤ (fun x _ => ⟨x, rfl⟩) ≫ (e_ev c).appTop) ≫
                    S_k.presheaf.Γgerm pt₀ := by
                  rw [h1, h2]
              _ = (Φ_ring.inv ≫ ι_1.appLE U_aff ⊤ (fun x _ => ⟨x, rfl⟩)) ≫
                    (e_ev c).appTop ≫ S_k.presheaf.Γgerm pt₀ := by
                  simp only [CategoryTheory.Category.assoc]
              _ = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
                  (e_ev c).appTop) ≫ S_k.presheaf.Γgerm pt₀ := by
                  rw [hΦ_app, CategoryTheory.Category.assoc]
              _ = CommRingCat.ofHom (Polynomial.evalRingHom c) ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  S_k.presheaf.Γgerm pt₀ := by rw [h3, CategoryTheory.Category.assoc]
          have h0_unit : IsUnit (stk_map.hom (σ_c B)) := hUnit_B.map stk_map.hom
          have h_eval0 : stk_map.hom (σ_c B) = 0 := by
            have hc := congrArg (fun θ => θ.hom B) hstk_comm
            change stk_map.hom (σ_c B) =
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                S_k.presheaf.Γgerm pt₀).hom (Polynomial.eval c B) at hc
            rw [hc, show Polynomial.eval c B = 0 from hc_root, map_zero]
          rw [h_eval0] at h0_unit
          have _ : Nontrivial ↑(S_k.presheaf.stalk pt₀) :=
            (inferInstance : IsLocalRing ↑(S_k.presheaf.stalk pt₀)).toNontrivial
          exact h0_unit.ne_zero rfl
        have hB_eq : B = Polynomial.C (B.coeff 0) :=
          Polynomial.eq_C_of_degree_le_zero (le_of_eq hB_deg0)
        let b₀ : k := B.coeff 0
        have hb₀_ne : b₀ ≠ 0 := fun h0 => hB_ne (by rw [hB_eq, show B.coeff 0 = 0 from h0, map_zero])
        refine ⟨Polynomial.C b₀⁻¹ * A, ?_⟩
        have hψC_inv : ψ (Polynomial.C b₀⁻¹) * ψ B = 1 := by
          rw [hB_eq, ← map_mul, ← map_mul, inv_mul_cancel₀ hb₀_ne, map_one, map_one]
        calc
          ψ (Polynomial.C b₀⁻¹ * A) = ψ (Polynomial.C b₀⁻¹) * ψ A := map_mul _ _ _
          _ = ψ (Polynomial.C b₀⁻¹) * ((w : ↑X.functionField) * ψ B) := by rw [← hwB_eq_A]
          _ = (w : ↑X.functionField) * (ψ (Polynomial.C b₀⁻¹) * ψ B) := by ring
          _ = (w : ↑X.functionField) := by rw [hψC_inv, mul_one]

      have hu_Qc : ∀ c : k, div_fn (Additive.ofMul u) (Q_c c) = 0 := by
        intro c
        rw [hu_ofMul, hu_div]
        simp only [D_neg, E_1, Finsupp.smul_single, smul_eq_mul, mul_one,
          Finsupp.single_apply]
        exact ite_eq_right_iff.mpr (fun h => False.elim ((hQc_ne_inf c) h.symm))
      obtain ⟨P₀, hP₀⟩ := hPoly_of_reg u (fun c => by rw [hu_Qc c])
      obtain ⟨Q₀, hQ₀⟩ := hPoly_of_reg u⁻¹ (fun c => by
        rw [ofMul_inv, map_neg, Finsupp.neg_apply, hu_Qc c, neg_zero])
      have hPQ1 : P₀ * Q₀ = 1 := hψ_inj (by rw [map_mul, hP₀, hQ₀, Units.mul_inv, map_one])
      obtain ⟨c₀, _, hc₀_eq⟩ := Polynomial.isUnit_iff.mp (IsUnit.of_mul_eq_one Q₀ hPQ1)

      let κ_top : CommRingCat.of k ⟶ X.presheaf.obj (Opposite.op ⊤) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ P₁_ov.hom.appTop
      have hκ_res : κ_top ≫ X.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op =
          CommRingCat.ofHom Polynomial.C ≫ Φ_ring.inv := by
        rw [CategoryTheory.Iso.eq_comp_inv, CategoryTheory.Category.assoc, hΦ_hom_eq]
        have h1 : P₁_ov.hom.appTop ≫ X.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
            ι_1.appLE U_aff ⊤ (fun x _ => ⟨x, rfl⟩) =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))).appTop := by
          have ha : P₁_ov.hom.appTop ≫ X.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op =
              P₁_ov.hom.appLE ⊤ U_aff le_top := rfl
          rw [← CategoryTheory.Category.assoc, ha]
          exact (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_1 P₁_ov.hom ⊤ U_aff ⊤
            (fun _ _ => trivial) (fun x _ => ⟨x, rfl⟩)).trans
            (@h_appLE_congr _ _ ⊤ ⊤ (ι_1 ≫ P₁_ov.hom)
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
              hOver_1 _ (fun _ _ => trivial))
        calc
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ P₁_ov.hom.appTop) ≫
              X.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
              (ι_1.appLE U_aff ⊤ (fun x _ => ⟨x, rfl⟩) ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom)
            = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                (P₁_ov.hom.appTop ≫ X.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
                  ι_1.appLE U_aff ⊤ (fun x _ => ⟨x, rfl⟩)) ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom := by
              simp only [CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))).appTop ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom := by
              rw [h1]
          _ = CommRingCat.ofHom Polynomial.C := by
              rw [AlgebraicGeometry.Scheme.ΓSpecIso_naturality, CategoryTheory.Iso.inv_hom_id_assoc]
      have hψC_stalk : ∃ r_inf : ↑(X.presheaf.stalk Q_inf₀.1),
          algebraMap ↑(X.presheaf.stalk Q_inf₀.1) ↑X.functionField r_inf =
            (u : ↑X.functionField) := by
        have _ : Nonempty ↥((⊤ : X.Opens) : AlgebraicGeometry.Scheme.{u}) :=
          ⟨⟨P_inf₀, trivial⟩⟩
        refine ⟨(X.presheaf.Γgerm Q_inf₀.1).hom (κ_top.hom c₀), ?_⟩
        rw [← hP₀, ← hc₀_eq]
        have hchain : κ_top ≫ X.presheaf.Γgerm Q_inf₀.1 ≫
            X.presheaf.stalkSpecializes (genericPoint_specializes Q_inf₀.1) =
            CommRingCat.ofHom Polynomial.C ≫ ψ_hom := by
          have hg1 : X.presheaf.Γgerm Q_inf₀.1 ≫
              X.presheaf.stalkSpecializes (genericPoint_specializes Q_inf₀.1) =
              X.germToFunctionField ⊤ :=
            TopCat.Presheaf.germ_stalkSpecializes X.presheaf
              (show Q_inf₀.1 ∈ (⊤ : X.Opens) from trivial)
              (genericPoint_specializes Q_inf₀.1)
          have hg2 : X.presheaf.map (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)).op ≫
              X.germToFunctionField U_aff = X.germToFunctionField ⊤ :=
            TopCat.Presheaf.germ_res X.presheaf (CategoryTheory.homOfLE (le_top : U_aff ≤ ⊤)) _ _
          rw [hg1, ← hg2, ← CategoryTheory.Category.assoc, hκ_res, CategoryTheory.Category.assoc]
        exact congrArg (fun θ => θ.hom c₀) hchain
      have hge0 : 0 ≤ div_fn (Additive.ofMul u) Q_inf₀ := (hPos_div Q_inf₀ u).mpr hψC_stalk
      rw [hu_ofMul, hu_div] at hge0
      simp only [D_neg, E_1, Finsupp.smul_single, smul_eq_mul, mul_one,
        Finsupp.single_eq_same] at hge0
      omega

    let η_pt : ↥X := genericPoint ↥X
    let K_cat : CommRingCat.{u} := X.presheaf.stalk η_pt
    let η_X : AlgebraicGeometry.Spec K_cat ⟶ X := X.fromSpecStalk η_pt
    let id_X : X ⟶ X := CategoryTheory.CategoryStruct.id X
    let snd_T : CategoryTheory.Limits.pullback id_X η_X ⟶ AlgebraicGeometry.Spec K_cat :=
      CategoryTheory.Limits.pullback.snd id_X η_X
    let l_T : AlgebraicGeometry.Spec K_cat ⟶ CategoryTheory.Limits.pullback id_X η_X :=
      CategoryTheory.Limits.pullback.lift η_X (𝟙 (AlgebraicGeometry.Spec K_cat))
        (by simp [id_X])
    have hl_snd : l_T ≫ snd_T = 𝟙 (AlgebraicGeometry.Spec K_cat) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hsnd_l : snd_T ≫ l_T = 𝟙 _ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.id_comp]
        have hc := CategoryTheory.Limits.pullback.condition (f := id_X) (g := η_X)
        dsimp [id_X] at hc
        rw [CategoryTheory.Category.comp_id] at hc
        exact hc.symm
      · rw [CategoryTheory.Category.assoc, hl_snd, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
    let σ_T : K_cat ⟶ (CategoryTheory.Limits.pullback id_X η_X).presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).inv ≫ snd_T.appTop
    let τ_T : (CategoryTheory.Limits.pullback id_X η_X).presheaf.obj (Opposite.op ⊤) ⟶ K_cat :=
      l_T.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom
    have hτ_σ : τ_T ≫ σ_T = 𝟙 _ := by
      dsimp [σ_T, τ_T]
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom,
        CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hsnd_l,
        AlgebraicGeometry.Scheme.Hom.id_appTop]

    have hFwd_sf : ∀ f : Units ↑X.functionField,
        let s_f : ↥((weilEtaleKPresheaf X).obj (Opposite.op T_id)) :=
          Additive.ofMul (Units.map σ_T.hom.toMonoidHom f)
        ∀ x : Pt,
          let Rx := ↑(X.presheaf.stalk x.1)
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ (a b : Rx) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Rx ↑X.functionField a =
              (f : ↑X.functionField) * algebraMap Rx ↑X.functionField b ∧
            Ideal.span ({a} : Set Rx) = mx ^ na ∧
            Ideal.span ({b} : Set Rx) = mx ^ nb ∧
            valDiv T_id
              ((div_mor.hom.app (Opposite.op T_id)).hom
                ((η_K.app (Opposite.op T_id)).hom s_f))
              ⟨x.1, x.2⟩ = (na : ℤ) - (nb : ℤ) := by
      intro f s_f x
      let Rx := ↑(X.presheaf.stalk x.1)
      let mx := IsLocalRing.maximalIdeal Rx
      have _ : IsDiscreteValuationRing Rx := hDVR x
      obtain ⟨a, ⟨b, hb_nzd, hdiv⟩⟩ :=
        IsFractionRing.div_surjective (A := Rx) (f : ↑X.functionField)
      have hb : b ≠ 0 := nonZeroDivisors.ne_zero hb_nzd
      have hb_K : algebraMap Rx ↑X.functionField b ≠ 0 := fun h0 =>
        hb (IsFractionRing.injective Rx ↑X.functionField (h0.trans (map_zero _).symm))
      have hab_K : algebraMap Rx ↑X.functionField a =
          (f : ↑X.functionField) * algebraMap Rx ↑X.functionField b :=
        (div_eq_iff hb_K).mp hdiv
      have ha : a ≠ 0 := by
        intro ha0; rw [ha0, map_zero] at hab_K
        exact mul_ne_zero f.ne_zero hb_K hab_K.symm
      obtain ⟨na, hna⟩ := exists_maximalIdeal_pow_eq_of_principal Rx inferInstance
        (Ideal.span ({a} : Set Rx)) (Submodule.span_singleton_eq_bot.not.mpr ha)
      obtain ⟨nb, hnb⟩ := exists_maximalIdeal_pow_eq_of_principal Rx inferInstance
        (Ideal.span ({b} : Set Rx)) (Submodule.span_singleton_eq_bot.not.mpr hb)
      obtain ⟨U_a, hx_a, a_U, ha_U⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf a
      obtain ⟨U_b, hx_b, b_U, hb_U⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf b
      let O : X.Opens := U_a ⊓ U_b
      have hy_O : x.1 ∈ O := ⟨hx_a, hx_b⟩
      let a_O : ↑(X.presheaf.obj (Opposite.op O)) :=
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O ≤ U_a)).op).hom a_U
      let b_O : ↑(X.presheaf.obj (Opposite.op O)) :=
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O ≤ U_b)).op).hom b_U
      have ha_germ : (X.presheaf.germ O x.1 hy_O).hom a_O = a := by
        dsimp [a_O]
        have hr := TopCat.Presheaf.germ_res X.presheaf
          (CategoryTheory.homOfLE (inf_le_left : O ≤ U_a)) x.1 hy_O
        exact (congrArg (fun ψ => ψ.hom a_U) hr).trans ha_U
      have hb_germ : (X.presheaf.germ O x.1 hy_O).hom b_O = b := by
        dsimp [b_O]
        have hr := TopCat.Presheaf.germ_res X.presheaf
          (CategoryTheory.homOfLE (inf_le_right : O ≤ U_b)) x.1 hy_O
        exact (congrArg (fun ψ => ψ.hom b_U) hr).trans hb_U
      let o_hom : O.toScheme ⟶ X := CategoryTheory.CategoryStruct.comp O.ι T_id.hom
      let O_et : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ o_hom
        (by
          change AlgebraicGeometry.Etale (O.ι ≫ 𝟙 X)
          rw [CategoryTheory.Category.comp_id]; infer_instance)
      let j_O : O_et ⟶ T_id := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
      let a₀ : ↑(O.toScheme.presheaf.obj (Opposite.op ⊤)) := O.topIso.inv.hom a_O
      let b₀ : ↑(O.toScheme.presheaf.obj (Opposite.op ⊤)) := O.topIso.inv.hom b_O
      have ha_stk : (X.presheaf.germ O x.1 hy_O).hom (O.topIso.hom.hom a₀) = a := by
        change (X.presheaf.germ O x.1 hy_O).hom ((O.topIso.inv ≫ O.topIso.hom).hom a_O) = a
        rw [O.topIso.inv_hom_id]; exact ha_germ
      have hb_stk : (X.presheaf.germ O x.1 hy_O).hom (O.topIso.hom.hom b₀) = b := by
        change (X.presheaf.germ O x.1 hy_O).hom ((O.topIso.inv ≫ O.topIso.hom).hom b_O) = b
        rw [O.topIso.inv_hom_id]; exact hb_germ
      have hη_O : η_pt ∈ O := (genericPoint_specializes x.1).mem_open O.isOpen hy_O
      let η_O : AlgebraicGeometry.Spec K_cat ⟶ O.toScheme := O.fromSpecStalkOfMem η_pt hη_O
      have hη_O_comp : η_O ≫ o_hom = η_X := by
        change η_O ≫ O.ι ≫ 𝟙 X = η_X
        rw [CategoryTheory.Category.comp_id, AlgebraicGeometry.Scheme.Opens.fromSpecStalkOfMem_ι]
      let snd_O := CategoryTheory.Limits.pullback.snd o_hom η_X
      let l_O : AlgebraicGeometry.Spec K_cat ⟶ CategoryTheory.Limits.pullback o_hom η_X :=
        CategoryTheory.Limits.pullback.lift η_O (𝟙 (AlgebraicGeometry.Spec K_cat))
          (by rw [hη_O_comp, CategoryTheory.Category.id_comp])
      have hsnd_l_O : snd_O ≫ l_O = 𝟙 _ := by
        have _ : CategoryTheory.Mono o_hom := by
          change CategoryTheory.Mono (O.ι ≫ 𝟙 X)
          rw [CategoryTheory.Category.comp_id]; infer_instance
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.id_comp, ← cancel_mono o_hom,
            CategoryTheory.Category.assoc, hη_O_comp, CategoryTheory.Limits.pullback.condition]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      let τ_O := l_O.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom
      have hτ_O_inj : Function.Injective τ_O.hom := by
        intro r₁ r₂ hr
        have h_inv : τ_O ≫ (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).inv ≫ snd_O.appTop = 𝟙 _ := by
          dsimp [τ_O]
          rw [CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom,
            CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hsnd_l_O,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        exact (congrArg (fun θ => θ.hom r₁) h_inv).symm.trans
          ((congrArg (((AlgebraicGeometry.Scheme.ΓSpecIso K_cat).inv ≫ snd_O.appTop).hom) hr).trans
            (congrArg (fun θ => θ.hom r₂) h_inv))
      have hτ_fst : ∀ (c_O : ↑(X.presheaf.obj (Opposite.op O))),
          τ_O.hom (((CategoryTheory.Limits.pullback.fst o_hom η_X).appTop).hom
            (O.topIso.inv.hom c_O)) =
          algebraMap Rx ↑X.functionField ((X.presheaf.germ O x.1 hy_O).hom c_O) := by
        intro c_O
        have htop_le : O.topIso.inv = O.ι.appLE O ⊤ (fun z _ => z.2) :=
          (AlgebraicGeometry.Scheme.Opens.topIso_inv O).trans
            ((congrArg X.presheaf.map (congrArg Opposite.op (Subsingleton.elim _ _))).trans
              (AlgebraicGeometry.Scheme.Opens.ι_appLE O O ⊤ (fun z _ => z.2)).symm)
        have h_eta_eq : η_O ≫ O.ι = η_X :=
          AlgebraicGeometry.Scheme.Opens.fromSpecStalkOfMem_ι O η_pt hη_O
        have h₁_le : (⊤ : (AlgebraicGeometry.Spec K_cat).Opens) ≤
            (TopologicalSpace.Opens.map (η_O ≫ O.ι).base).obj O :=
          fun z _ => (η_O.base z).2
        have h₂_le : (⊤ : (AlgebraicGeometry.Spec K_cat).Opens) ≤
            (TopologicalSpace.Opens.map η_X.base).obj O :=
          h_eta_eq ▸ h₁_le
        have h_comp1 : O.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst o_hom η_X).appTop ≫ τ_O =
            ((η_O ≫ O.ι).appLE O ⊤ h₁_le) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom := by
          dsimp [τ_O]
          rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst o_hom η_X).appTop,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Limits.pullback.lift_fst,
            htop_le, ← CategoryTheory.Category.assoc]
          congr 1
          exact AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE η_O O.ι O ⊤ ⊤
            (fun z _ => z.2) (fun _ _ => trivial)
        have h_from : (η_X.appLE O ⊤ h₂_le) ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom =
            X.presheaf.germ O η_pt hη_O := by
          dsimp [η_X, K_cat]
          let R_K := X.presheaf.stalk η_pt
          have hmaps : ∀ {W : (AlgebraicGeometry.Spec R_K).Opens}
              (f_op : Opposite.op (⊤ : (AlgebraicGeometry.Spec R_K).Opens) ⟶ Opposite.op W)
              (g_op : Opposite.op W ⟶ Opposite.op (⊤ : (AlgebraicGeometry.Spec R_K).Opens)),
              (AlgebraicGeometry.Spec R_K).presheaf.map f_op ≫
                (AlgebraicGeometry.Spec R_K).presheaf.map g_op = 𝟙 _ := by
            intro W f_op g_op
            rw [← CategoryTheory.Functor.map_comp, Subsingleton.elim (f_op ≫ g_op) (𝟙 _),
              CategoryTheory.Functor.map_id]
          have h_app : (X.fromSpecStalk η_pt).appLE O ⊤ h₂_le =
              X.presheaf.germ O η_pt hη_O ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R_K).inv ≫
                ((AlgebraicGeometry.Spec R_K).presheaf.map
                    (CategoryTheory.homOfLE (le_top : (X.fromSpecStalk η_pt) ⁻¹ᵁ O ≤ ⊤)).op ≫
                  (AlgebraicGeometry.Spec R_K).presheaf.map (CategoryTheory.homOfLE h₂_le).op) := by
            change (X.fromSpecStalk η_pt).app O ≫
                (AlgebraicGeometry.Spec R_K).presheaf.map (CategoryTheory.homOfLE h₂_le).op = _
            rw [AlgebraicGeometry.Scheme.fromSpecStalk_app hη_O]
            simp only [CategoryTheory.Category.assoc]; rfl
          rw [h_app, hmaps, CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
        have h_germ_eq : X.presheaf.germ O x.1 hy_O ≫
            X.presheaf.stalkSpecializes (genericPoint_specializes x.1) =
            X.presheaf.germ O η_pt hη_O :=
          TopCat.Presheaf.germ_stalkSpecializes X.presheaf hy_O (genericPoint_specializes x.1)
        have h_all : O.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst o_hom η_X).appTop ≫ τ_O =
            X.presheaf.germ O x.1 hy_O ≫
              X.presheaf.stalkSpecializes (genericPoint_specializes x.1) := by
          rw [h_comp1, h_appLE_congr (η_O ≫ O.ι) η_X h_eta_eq h₁_le h₂_le, h_from, ← h_germ_eq]
        exact congrArg (fun θ => θ.hom c_O) h_all
      have hτ_sf : τ_O.hom ((Additive.toMul (((weilEtaleKPresheaf X).map j_O.op).hom s_f) :
          Units ↑((CategoryTheory.Limits.pullback o_hom η_X).presheaf.obj
            (Opposite.op ⊤))).val) = (f : ↑X.functionField) := by
        let m_jO : CategoryTheory.Limits.pullback o_hom η_X ⟶
            CategoryTheory.Limits.pullback id_X η_X :=
          ((CategoryTheory.Over.pullback η_X).map
            ((AlgebraicGeometry.Scheme.Etale.forget X).map j_O)).left
        have hm_snd : m_jO ≫ snd_T = snd_O :=
          CategoryTheory.Over.w ((CategoryTheory.Over.pullback η_X).map
            ((AlgebraicGeometry.Scheme.Etale.forget X).map j_O))
        have h_id_K : σ_T ≫ m_jO.appTop ≫ τ_O = 𝟙 K_cat := by
          dsimp [σ_T, τ_O]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc snd_T.appTop,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hm_snd,
            ← CategoryTheory.Category.assoc snd_O.appTop,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
            CategoryTheory.Limits.pullback.lift_snd,
            AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
            CategoryTheory.Iso.inv_hom_id]
        exact congrArg (fun θ => θ.hom (f : ↑X.functionField)) h_id_K
      have hgen_eq : ((CategoryTheory.Limits.pullback.fst o_hom η_X).appTop).hom b₀ *
          (Additive.toMul (((weilEtaleKPresheaf X).map j_O.op).hom s_f) :
            Units ↑((CategoryTheory.Limits.pullback o_hom η_X).presheaf.obj
              (Opposite.op ⊤))).val =
          ((CategoryTheory.Limits.pullback.fst o_hom η_X).appTop).hom a₀ := by
        apply hτ_O_inj
        rw [map_mul, hτ_fst b_O, hτ_sf, hτ_fst a_O, hb_germ, ha_germ, hab_K, mul_comm]
      refine ⟨a, b, na, nb, ha, hb, hab_K, hna, hnb, ?_⟩
      exact hOrd_Tid s_f ⟨x.1, x.2⟩ O hy_O a₀ b₀ na nb hgen_eq
        (ha_stk ▸ ha) (hb_stk ▸ hb) (ha_stk ▸ hna) (hb_stk ▸ hnb)

    refine ⟨⟨hCl_inf₀, hCompl_inf, hPrinc_inf⟩, fun f => ⟨_, hFwd_sf f⟩, fun s D hD_eq => ?_⟩
    let f_s : Units ↑X.functionField := Units.map τ_T.hom.toMonoidHom (Additive.toMul s)
    have hs_eq : (Additive.ofMul (Units.map σ_T.hom.toMonoidHom f_s) :
        ↥((weilEtaleKPresheaf X).obj (Opposite.op T_id))) = s := by
      apply (@Additive.toMul (Units ↑((CategoryTheory.Limits.pullback id_X η_X).presheaf.obj
        (Opposite.op ⊤)))).injective
      apply Units.ext
      change (τ_T ≫ σ_T).hom (@Additive.toMul (Units ↑((CategoryTheory.Limits.pullback id_X η_X).presheaf.obj
        (Opposite.op ⊤))) s).val =
        (@Additive.toMul (Units ↑((CategoryTheory.Limits.pullback id_X η_X).presheaf.obj
          (Opposite.op ⊤))) s).val
      rw [hτ_σ]; rfl
    apply AddSubgroup.subset_closure
    refine ⟨f_s, fun x => ?_⟩
    obtain ⟨a, b, na, nb, ha, hb, hab_K, hna, hnb, hval⟩ := hFwd_sf f_s x
    rw [hs_eq, hD_eq x] at hval
    exact ⟨a, b, na, nb, ha, hb, hab_K, hna, hnb, hval⟩

  obtain ⟨ι_kum, p_kum, h0_kum, hEx_kum, hp_kum, hKum_norm⟩ := hKum_pkg
  obtain ⟨⟨hCl_inf₀, hCompl_inf, hPrinc_inf⟩, hBridge_fwd, hBridge_bwd⟩ := hTid_pkg

  
  have hLadder_pkg :
      ∃ tr_1 : weilEtaleTorsionH P₁_ov.left n 2 →+ ZMod n,
        Function.Bijective tr_1 ∧
        let T_id : P₁_ov.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.id P₁_ov.left)
          (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id P₁_ov.left))
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        ∀ (hT_id : CategoryTheory.Limits.IsTerminal T_id)
          (d₀ : CategoryTheory.Abelian.Ext
            ((CategoryTheory.constantSheaf P₁_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
            Div_sh 0)
          (D : { x : ↥P₁_ov.left // IsClosed ({x} : Set ↥P₁_ov.left) } →₀ ℤ),
        (∀ y : { y : ↥T_id.left // IsClosed ({T_id.hom.base y} : Set ↥P₁_ov.left) },
          valDiv T_id
            (((CategoryTheory.constantSheafAdj P₁_ov.left.smallEtaleTopology AddCommGrpCat.{u} hT_id).homEquiv
              Aℤ Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀ d₀)).hom (ULift.up (1 : ℤ))) y =
            D ⟨y.1, y.2⟩) →
        ∀ (w_kum : weilEtaleTorsionH P₁_ov.left n 2),
          HEq w_kum ((d₀.comp hEx_div.extClass (Nat.zero_add 1)).comp
            hEx_kum.extClass (Nat.one_add 1)) →
          tr_1 w_kum = ((D.sum fun _ m => m : ℤ) : ZMod n) := by
    have _ : NeZero n := ⟨by omega⟩
    let X := P₁_ov.left
    let FM := weilEtaleTorsionSheaf X n
    let Gm := weilEtaleGmSheaf X
    let K_pre := weilEtaleKPresheaf X
    let K_sh := weilEtaleKSheaf X
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let pt₀ : ↥S_k := (⊥ : PrimeSpectrum k)
    let Q_inf₀ : { x : ↥X // IsClosed ({x} : Set ↥X) } := ⟨s_inf₀.base pt₀, hCl_inf₀⟩
    let T_id : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id X)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id X))
    let J := X.smallEtaleTopology
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let Pt := { x : ↥X // IsClosed ({x} : Set ↥X) }
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let Pℤ : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const (Opposite X.Etale)).obj Aℤ
    have hT_id₀ : CategoryTheory.Limits.IsTerminal T_id := hT_P1
    let adj_id := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_id₀
    have hDeg_red_id : ∀ (d₀ : CategoryTheory.Abelian.Ext Fℤ Div_sh 0) (E : Pt →₀ ℤ),
        (∀ y : { y : ↥T_id.left // IsClosed ({T_id.hom.base y} : Set ↥X) },
          valDiv T_id
            (((adj_id.homEquiv Aℤ Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀ d₀)).hom
              (ULift.up (1 : ℤ)))) y = E ⟨y.1, y.2⟩) →
        d₀.comp hEx_div.extClass (Nat.zero_add 1) =
          (E.sum fun _ m => m) • (d_inf.comp hEx_div.extClass (Nat.zero_add 1)) := hDeg_red

    have hComp_Tid : CompactSpace ↥T_id.left := by
      change CompactSpace ↥X; infer_instance

    have hUnit_Aℤ : ∀ (hT : CategoryTheory.Limits.IsTerminal T_id),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app Aℤ =
          (shAdj.unit.app Pℤ).app (Opposite.op T_id) := by
      intro hT
      have h2 := CategoryTheory.Adjunction.comp_unit_app
        (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT) shAdj Aℤ
      have h3 := CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT Aℤ
      exact h2.trans ((congrArg (· ≫ (shAdj.unit.app Pℤ).app (Opposite.op T_id)) h3).trans
        (CategoryTheory.Category.id_comp _))

    have hAdj_eval : ∀ (hT : CategoryTheory.Limits.IsTerminal T_id)
        {G : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (φ : Fℤ ⟶ G),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).homEquiv Aℤ G φ =
          ((shAdj.unit.app Pℤ).app (Opposite.op T_id)) ≫ φ.hom.app (Opposite.op T_id) := by
      intro hT G φ
      exact ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).homEquiv_unit
        Aℤ G φ).trans (congrArg (· ≫ φ.hom.app (Opposite.op T_id)) (hUnit_Aℤ hT))

    have hMk0_inj : ∀ {G₁ G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        {f g : G₁ ⟶ G₂},
        CategoryTheory.Abelian.Ext.mk₀ f = CategoryTheory.Abelian.Ext.mk₀ g → f = g := by
      intro G₁ G₂ f g hfg
      have h_inv : ∀ h : G₁ ⟶ G₂,
          CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ h) = h := by
        intro h
        have h1 := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
          (CategoryTheory.Abelian.Ext.addEquiv₀.symm h)
        rw [CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply] at h1
        rw [h1, CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply]
      rw [← h_inv f, ← h_inv g, hfg]

    let zLift : ∀ (M : AddCommGrpCat.{u}), ↑M → (Aℤ ⟶ M) :=
