          rw [Category.assoc, ih.2, h_head_over δ]⟩)
  let ι_aff : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left :=
    fun δ => (affPair δ).1

  have hInd : ∀ δ : ℕ,
      AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension δ (weilPolyP1Over k δ).hom ∧
      AlgebraicGeometry.IsIntegral (weilPolyP1Over k δ).left ∧
      ∃ (u_δ : (Fin δ → Bool) →
          Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
        (s_δ : Quiver.Hom S_k (weilPolyP1Over k δ).left),
        u_δ (fun _ => false) = ι_aff δ ∧
        (∀ σ : Fin δ → Bool, AlgebraicGeometry.IsOpenImmersion (u_δ σ)) ∧
        (∀ σ : Fin δ → Bool, u_δ σ ≫ (weilPolyP1Over k δ).hom = (weilAffineSpaceOver k δ).hom) ∧
        (⋃ σ : Fin δ → Bool, Set.range (u_δ σ).base) = Set.univ ∧
