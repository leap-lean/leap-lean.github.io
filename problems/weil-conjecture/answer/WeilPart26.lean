            ((X₀.presheaf.Γgerm (f.base y)).hom r) :=
      fun f y r => (AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial r).symm

    have hJ_iff : ∀ (U : X.Etale) (R : CategoryTheory.Sieve U),
        R ∈ J U ↔ ∀ (x : ↥U.left), ∃ (V : X.Etale) (f : V ⟶ U) (y : ↥V.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
