theorem weil_etale_finite_open_pushforward_localTorsionH_iso (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    ∃ trf : ∀ (Y₀ Z₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
        (ν : Quiver.Hom Y₀ Z₀) [AlgebraicGeometry.IsFinite ν.left]
        (W_open : Y₀.left.Opens)
        (W_diag : Z₀.left.Etale)
        (e_W : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget Z₀.left).obj W_diag).left W_open.toScheme),
        CategoryTheory.CategoryStruct.comp e_W.hom
            (CategoryTheory.CategoryStruct.comp W_open.ι ν.left) =
          ((AlgebraicGeometry.Scheme.Etale.forget Z₀.left).obj W_diag).hom →
        ∀ (q : ℕ),
          weilEtaleLocalTorsionH Z₀.left ℓ W_diag q ≃+
            weilEtaleLocalTorsionH Y₀.left ℓ
              (CategoryTheory.MorphismProperty.Over.mk ⊤ W_open.ι inferInstance) q,
      ∀ (Y₀ Z₀ Y'₀ Z'₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
        [AlgebraicGeometry.LocallyOfFiniteType Z'₀.hom]
        (ν : Quiver.Hom Y₀ Z₀) [AlgebraicGeometry.IsFinite ν.left]
        (ν' : Quiver.Hom Y'₀ Z'₀) [AlgebraicGeometry.IsFinite ν'.left]
        (ι_Y : Quiver.Hom Y'₀.left Y₀.left)
        (ι_Z : Quiver.Hom Z'₀.left Z₀.left)
        (_hpb : CategoryTheory.IsPullback ι_Y ν'.left ν.left ι_Z)
        (W_open : Y₀.left.Opens)
        (W'_open : Y'₀.left.Opens)
        (_hW' : W'_open = (TopologicalSpace.Opens.map ι_Y.base).obj W_open)
        (W_diag : Z₀.left.Etale)
        (W'_diag : Z'₀.left.Etale)
        (e_W : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget Z₀.left).obj W_diag).left W_open.toScheme)
        (he_W : CategoryTheory.CategoryStruct.comp e_W.hom
            (CategoryTheory.CategoryStruct.comp W_open.ι ν.left) =
          ((AlgebraicGeometry.Scheme.Etale.forget Z₀.left).obj W_diag).hom)
        (e_W' : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget Z'₀.left).obj W'_diag).left W'_open.toScheme)
        (he_W' : CategoryTheory.CategoryStruct.comp e_W'.hom
            (CategoryTheory.CategoryStruct.comp W'_open.ι ν'.left) =
          ((AlgebraicGeometry.Scheme.Etale.forget Z'₀.left).obj W'_diag).hom)
        (τ_Z : Quiver.Hom ((weilEtaleSitePullback ι_Z).obj W_diag) W'_diag)
        (τ_Y : Quiver.Hom
          ((weilEtaleSitePullback ι_Y).obj
            (CategoryTheory.MorphismProperty.Over.mk ⊤ W_open.ι inferInstance))
          (CategoryTheory.MorphismProperty.Over.mk ⊤ W'_open.ι inferInstance))
        (q : ℕ)
        (p_Z : weilEtaleLocalTorsionH Z₀.left ℓ W_diag q →+
          weilEtaleLocalTorsionH Z'₀.left ℓ W'_diag q)
        (p_Y : weilEtaleLocalTorsionH Y₀.left ℓ
            (CategoryTheory.MorphismProperty.Over.mk ⊤ W_open.ι inferInstance) q →+
          weilEtaleLocalTorsionH Y'₀.left ℓ
            (CategoryTheory.MorphismProperty.Over.mk ⊤ W'_open.ι inferInstance) q),
        CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp
              (((AlgebraicGeometry.Scheme.Etale.forget Z'₀.left).map τ_Z).left)
              (CategoryTheory.CategoryStruct.comp e_W'.hom W'_open.ι))
            ι_Y =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.fst
              ((AlgebraicGeometry.Scheme.Etale.forget Z₀.left).obj W_diag).hom ι_Z)
            (CategoryTheory.CategoryStruct.comp e_W.hom W_open.ι) →
        WeilIsLocalTorsionPullback ι_Z W'_diag W_diag τ_Z ℓ q p_Z →
        WeilIsLocalTorsionPullback ι_Y
          (CategoryTheory.MorphismProperty.Over.mk ⊤ W'_open.ι inferInstance)
          (CategoryTheory.MorphismProperty.Over.mk ⊤ W_open.ι inferInstance)
          τ_Y ℓ q p_Y →
        ∀ x : weilEtaleLocalTorsionH Z₀.left ℓ W_diag q,
          trf Y'₀ Z'₀ ν' W'_open W'_diag e_W' he_W' q (p_Z x) =
            p_Y (trf Y₀ Z₀ ν W_open W_diag e_W he_W q x) :=
by
  classical
  let _ := hPBC
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
