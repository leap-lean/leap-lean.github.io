      intro a W' W u γ
      apply Subtype.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hmap_fst :
            CategoryTheory.CategoryStruct.comp ((B a).map u).left
              (CategoryTheory.Limits.pullback.fst W.hom (σ a)) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst W'.hom (σ a)) u.left :=
