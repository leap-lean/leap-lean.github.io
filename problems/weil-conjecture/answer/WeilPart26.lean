        ext z
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        have hz₁_u : π₁.base z ∈ ⋃ τ : Fin δ → Bool, Set.range (u_δ τ).base := by
          rw [hu_cov]; trivial
        rcases Set.mem_iUnion.mp hz₁_u with ⟨τ, hτ⟩
        have hz₂_u : π₂.base z ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base := by
          rw [hTwoChartCov]; trivial
        rcases hz₂_u with hz_P1 | hz_inf
        · let σ : Fin (δ + 1) → Bool := Fin.lastCases false τ
