                CategoryTheory.Category.assoc _ _ _
              _ = (FgtZ.map γ).left ≫ e_W.hom ≫ W_open.ι := by
                rw [hm_snd, htilde_snd]
              _ = (((FgtZ.map γ).left ≫ e_W.hom) ≫ σ_sch) ≫ snd_W := by
                rw [← hσ_snd]
                simp only [CategoryTheory.Category.assoc]
        refine ⟨((FgtZ.map γ).left ≫ e_W.hom).base u, ?_⟩
        exact (AlgebraicGeometry.Scheme.Hom.comp_apply _ σ_sch u).symm.trans
          ((congrArg (fun k : V_sch ⟶ _ => k.base u) h_comp.symm).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply γ_tilde m_γ u))

    obtain ⟨U_aff, hU_aff, hu₀_aff, _⟩ :=
