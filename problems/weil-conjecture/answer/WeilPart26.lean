            Subsingleton ((pf_f.obj (pf_g.obj I_1)).H p)) :=
by
  classical
  have hn_ne : n ≠ 0 := by omega
  have : NeZero n := ⟨hn_ne⟩

  
  have h_nsmul_grp : ∀ (A : AddCommGrpCat.{u}) (k : ℕ) (x : ↑A),
      (k • CategoryTheory.CategoryStruct.id A).hom x = k • x := by
    intro A k x
    induction k with
    | zero =>
      simp only [zero_smul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change (k • CategoryTheory.CategoryStruct.id A).hom x +
          (CategoryTheory.CategoryStruct.id A).hom x = k • x + x
      rw [ih]
      rfl

  have h_nsmul_psh : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
      (k : ℕ) (U : Opposite S.Etale) (x : ↑(P.obj U)),
