        rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul]
        change (k • CategoryTheory.CategoryStruct.id P).app U +
            (CategoryTheory.CategoryStruct.id P).app U = _
        rw [ih]
        rfl
    rw [h_app]
    exact h_nsmul_grp (P.obj U) k x

  have h_nsmul_sh : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (k : ℕ) (U : Opposite S.Etale) (x : ↑(G.obj.obj U)),
      ((((k • CategoryTheory.CategoryStruct.id G).hom).app U).hom) x = k • x := by
    intro S G k U x
    let F_sh := CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have h_map : (k • CategoryTheory.CategoryStruct.id G).hom =
        k • CategoryTheory.CategoryStruct.id G.obj := by
      change F_sh.map (k • CategoryTheory.CategoryStruct.id G) =
        k • CategoryTheory.CategoryStruct.id (F_sh.obj G)
      rw [F_sh.map_nsmul, F_sh.map_id]
    rw [h_map]
    exact h_nsmul_psh G.obj k U x

  
  
  
  have hStep1 : ∀ (E : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      n • CategoryTheory.CategoryStruct.id E = 0 →
      ∃ (I Q : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
        (i : Quiver.Hom E I) (p : Quiver.Hom I Q)
        (h0 : CategoryTheory.CategoryStruct.comp i p = 0),
        (n • CategoryTheory.CategoryStruct.id I = 0 ∧
          n • CategoryTheory.CategoryStruct.id Q = 0 ∧
          (CategoryTheory.ShortComplex.mk i p h0).ShortExact) ∧
        (∀ {A B_sh : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}}
            (ι : Quiver.Hom A B_sh) [CategoryTheory.Mono ι],
          n • CategoryTheory.CategoryStruct.id B_sh = 0 →
          ∀ α : Quiver.Hom A I, ∃ β : Quiver.Hom B_sh I,
            CategoryTheory.CategoryStruct.comp ι β = α) ∧
        (∃ (J : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
           (_ : CategoryTheory.Injective J)
           (α_I : Quiver.Hom I (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J)))
           (ρ_I : Quiver.Hom (CategoryTheory.Limits.kernel (n • CategoryTheory.CategoryStruct.id J)) I),
          CategoryTheory.CategoryStruct.comp α_I ρ_I = CategoryTheory.CategoryStruct.id I) := by
    let J_W := W.smallEtaleTopology
    let R_n := ULift.{u, 0} (ZMod n)
    let Fgt := CategoryTheory.forget₂ (ModuleCat.{u, u} R_n) AddCommGrpCat.{u}

    
    let φ_ring : ℤ →+* R_n := Int.castRingHom R_n
    let R_res := ModuleCat.restrictScalars φ_ring
    let F_Z := CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}
    let e_Z := F_Z.asEquivalence
    let e_fgt : R_res ⋙ F_Z ≅ Fgt :=
      CategoryTheory.NatIso.ofComponents
        (fun M =>
          { hom := AddCommGrpCat.ofHom (RestrictScalars.addEquiv ℤ R_n ↑M).toAddMonoidHom
            inv := AddCommGrpCat.ofHom (RestrictScalars.addEquiv ℤ R_n ↑M).symm.toAddMonoidHom
            hom_inv_id := by ext x; exact (RestrictScalars.addEquiv ℤ R_n ↑M).symm_apply_apply x
            inv_hom_id := by ext x; exact (RestrictScalars.addEquiv ℤ R_n ↑M).apply_symm_apply x })
        (fun {_ _} f => by ext x; rfl)
    let adj_fgt :=
      (e_Z.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj φ_ring)).ofNatIsoRight e_fgt
    have : CategoryTheory.Limits.PreservesLimitsOfSize.{u, u + 1} Fgt :=
      adj_fgt.rightAdjoint_preservesLimits

    
    let U_0 : CategoryTheory.Functor
        (CategoryTheory.Sheaf J_W (ModuleCat.{u, u} R_n))
        (CategoryTheory.Sheaf J_W AddCommGrpCat.{u}) :=
      { obj := fun K =>
          ⟨K.obj.comp Fgt, CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J_W K.obj Fgt K.2⟩
        map := fun φ => CategoryTheory.ObjectProperty.homMk (CategoryTheory.Functor.whiskerRight φ.hom Fgt)
        map_id := fun K => by
          apply CategoryTheory.Sheaf.hom_ext
          ext V x
          rfl
        map_comp := fun φ ψ => by
          apply CategoryTheory.Sheaf.hom_ext
          ext V x
          rfl }

    have hFaithful_U0 : U_0.Faithful :=
      { map_injective := fun {K₁ K₂} {φ₁ φ₂} h => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          exact congrArg (fun ψ => ((ψ.hom.app V).hom) x) h }

    
    have h_ulift_natCast : ∀ k : ℕ, ((k : R_n).down : ZMod n) = (k : ZMod n) := by
      intro k
      induction k with
      | zero => rfl
      | succ k ih =>
        rw [Nat.cast_succ, Nat.cast_succ]
        exact congrArg (· + 1) ih

    have h_Rn_n_zero : ((n : ℕ) : R_n) = 0 := by
      apply ULift.ext
