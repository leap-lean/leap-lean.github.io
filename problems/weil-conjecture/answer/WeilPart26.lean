                          = s₀ (u.left ((O_lvl U₂₀ s' y).ι z')) :=
                            congrArg s₀ (AlgebraicGeometry.Scheme.Hom.comp_apply
                              (O_lvl U₂₀ s' y).ι u.left z')
                        _ = s' ((O_lvl U₂₀ s' y).ι z') := rfl
                        _ = s' z'.1 := congrArg s' hz₁
                        _ = s' y := z'.2) } }
    have h_hom_inv : Φ_hom ≫ Φ_inv = 𝟙 F_sh := by
      apply (adj_Z.homEquiv AM F_sh).injective
      rw [adj_Z.homEquiv_unit, adj_Z.homEquiv_unit]
      change η_Z ≫ (Φ_hom.hom.app (Opposite.op T_Z) ≫ Φ_inv.hom.app (Opposite.op T_Z)) =
        η_Z ≫ 𝟙 (F_sh.obj.obj (Opposite.op T_Z))
      rw [← CategoryTheory.Category.assoc, hUnit_norm]
      apply AddCommGrpCat.ext
      intro a
      change ψ_fun T_Z (LocallyConstant.const ↥T_Z.left a) = η_Z.hom a
      have hc := hψ_const (𝟙 T_Z) (LocallyConstant.const ↥T_Z.left a) a (fun _ => rfl)
      have hT_id : hT_Z.from T_Z = 𝟙 T_Z := hT_Z.hom_ext _ _
      rw [hT_id, op_id, F_sh.obj.map_id] at hc
      exact hc
    have h_inv_hom : Φ_inv ≫ Φ_hom = 𝟙 L_sh := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      let U := Opposite.unop U_op
      apply AddCommGrpCat.ext
      intro s
      let s₀ : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) := s
      let lhs_sec : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) :=
        (Φ_hom.hom.app (Opposite.op U)).hom (ψ_fun U s₀)
      change lhs_sec = s₀
      apply LocallyConstant.ext
      intro x
      let Wx := W_lvl U s₀ x
      let p_x : ↥(O_lvl U s₀ x).toScheme := ⟨x, rfl⟩
      have hp_x : (j_lvl U s₀ x).left p_x = x :=
        AlgebraicGeometry.Scheme.Opens.ι_apply (O_lvl U s₀ x) p_x
      have hnat₁ := Φ_hom.hom.naturality (j_lvl U s₀ x).op
      have hnat₂ := Φ_hom.hom.naturality (hT_Z.from Wx).op
      have hsec₁ : ((L_sh.obj.map (j_lvl U s₀ x).op).hom lhs_sec :
          LocallyConstant ↥Wx.left (ULift.{u} (ZMod n))) =
          ((Φ_hom.hom.app (Opposite.op Wx)).hom
            ((F_sh.obj.map (j_lvl U s₀ x).op).hom (ψ_fun U s₀)) :
            LocallyConstant ↥Wx.left (ULift.{u} (ZMod n))) :=
        congrArg (fun φ => AddCommGrpCat.Hom.hom φ (ψ_fun U s₀)) hnat₁.symm
      have hsec₂ : ((Φ_hom.hom.app (Opposite.op Wx)).hom (σ_lvl U s₀ x) :
          LocallyConstant ↥Wx.left (ULift.{u} (ZMod n))) =
          ((L_sh.obj.map (hT_Z.from Wx).op).hom
            ((Φ_hom.hom.app (Opposite.op T_Z)).hom (η_Z.hom (s₀ x))) :
            LocallyConstant ↥Wx.left (ULift.{u} (ZMod n))) :=
        congrArg (fun φ => AddCommGrpCat.Hom.hom φ (η_Z.hom (s₀ x))) hnat₂
      have hev_unit : (Φ_hom.hom.app (Opposite.op T_Z)).hom (η_Z.hom (s₀ x)) =
          c_Z.hom (s₀ x) :=
        congrArg (fun φ => AddCommGrpCat.Hom.hom φ (s₀ x)) hUnit_norm
      have hsec_all : ((L_sh.obj.map (j_lvl U s₀ x).op).hom lhs_sec :
          LocallyConstant ↥Wx.left (ULift.{u} (ZMod n))) =
          ((L_sh.obj.map (hT_Z.from Wx).op).hom (c_Z.hom (s₀ x)) :
            LocallyConstant ↥Wx.left (ULift.{u} (ZMod n))) := by
        rw [hsec₁, hψ_spec U s₀ x, hsec₂, hev_unit]
      let res_lhs : LocallyConstant ↥Wx.left (ULift.{u} (ZMod n)) :=
        (L_sh.obj.map (j_lvl U s₀ x).op).hom lhs_sec
      let res_rhs : LocallyConstant ↥Wx.left (ULift.{u} (ZMod n)) :=
        (L_sh.obj.map (hT_Z.from Wx).op).hom (c_Z.hom (s₀ x))
      have hres_eq : res_lhs = res_rhs := hsec_all
      calc
        lhs_sec x = lhs_sec ((j_lvl U s₀ x).left p_x) := congrArg lhs_sec hp_x.symm
        _ = res_lhs p_x := rfl
        _ = res_rhs p_x := congrArg (fun g => g p_x) hres_eq
        _ = s₀ x := rfl
    exact ⟨{ hom := Φ_hom, inv := Φ_inv, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom },
      hUnit_norm⟩

  
  have hAffLift : ∀ {A A_Z B_Z : Type u} [CommRing A] [CommRing A_Z] [CommRing B_Z]
      (π : A →+* A_Z) (f_Z : A_Z →+* B_Z),
      Function.Surjective π →
      RingHom.Etale f_Z →
      ∃ (B_A : Type u) (_ : CommRing B_A) (g_A : A →+* B_A) (π_B : B_A →+* B_Z),
        RingHom.Etale g_A ∧
        π_B.comp g_A = f_Z.comp π ∧
        CategoryTheory.IsPushout
          (CommRingCat.ofHom g_A) (CommRingCat.ofHom π)
          (CommRingCat.ofHom π_B) (CommRingCat.ofHom f_Z) := by
    intro A A_Z B_Z _ _ _ π f_Z hπ_surj hf_Z_et
    let _ : Algebra A_Z B_Z := f_Z.toAlgebra
    have hAlg_et : Algebra.Etale A_Z B_Z := RingHom.etale_algebraMap.mp hf_Z_et
    have hStd : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hAlg_et
    obtain ⟨ι₀, σ₀, hFin_σ, hFin_ι, P_Z, hdim_Z⟩ := hStd.out
    have _ : Finite σ₀ := hFin_σ
    have _ : Finite ι₀ := hFin_ι
    let _ : Fintype σ₀ := Fintype.ofFinite σ₀
    have hrel_ex : ∀ c : σ₀, ∃ p : MvPolynomial ι₀ A, MvPolynomial.map π p = P_Z.relation c :=
      fun c => MvPolynomial.map_surjective π hπ_surj (P_Z.relation c)
    let rel_A : σ₀ → MvPolynomial ι₀ A := fun c => (hrel_ex c).choose
    have hrel_A : ∀ c : σ₀, MvPolynomial.map π (rel_A c) = P_Z.relation c :=
      fun c => (hrel_ex c).choose_spec
    let I_A : Ideal (MvPolynomial ι₀ A) := Ideal.span (Set.range rel_A)
    let Q_A : Type u := MvPolynomial ι₀ A ⧸ I_A
    let P_Q : Algebra.PreSubmersivePresentation A Q_A ι₀ σ₀ :=
      Algebra.PreSubmersivePresentation.naive (v := rel_A) P_Z.map P_Z.map_inj
    let j_Q : Q_A := P_Q.jacobian
    let B_A : Type u := Localization.Away j_Q
    let g_A : A →+* B_A := algebraMap A B_A
    let Q_loc : Algebra.PreSubmersivePresentation Q_A B_A Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
    let P_tot : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ ι₀) (Unit ⊕ σ₀) :=
      Q_loc.comp P_Q
    have hUnit_jQ_BA : IsUnit (algebraMap Q_A B_A j_Q) :=
      IsLocalization.Away.algebraMap_isUnit j_Q
    have hUnit_tot : IsUnit P_tot.jacobian := by
      change IsUnit (Q_loc.comp P_Q).jacobian
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact hUnit_jQ_BA.mul hUnit_jQ_BA
    have hdim_tot : P_tot.dimension = 0 := by
      change (Q_loc.comp P_Q).dimension = 0
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension]
      have hdim_PQ : P_Q.dimension = P_Z.dimension := rfl
      have hdim_Qloc : Q_loc.dimension = 0 := by
        change Nat.card Unit - Nat.card Unit = 0
        simp
      rw [hdim_Qloc, hdim_PQ, hdim_Z]
    let S_tot : Algebra.SubmersivePresentation A B_A (Unit ⊕ ι₀) (Unit ⊕ σ₀) :=
      { toPreSubmersivePresentation := P_tot
        jacobian_isUnit := hUnit_tot }
    have hStd_BA : Algebra.IsStandardSmoothOfRelativeDimension 0 A B_A :=
      ⟨⟨Unit ⊕ ι₀, Unit ⊕ σ₀, inferInstance, inferInstance, S_tot, hdim_tot⟩⟩
    have hg_A_et : RingHom.Etale g_A :=
      RingHom.etale_algebraMap.mpr
        (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hStd_BA)
    let ψ₀ : MvPolynomial ι₀ A →+* B_Z :=
      (MvPolynomial.aeval P_Z.val).toRingHom.comp (MvPolynomial.map π)
    have hI_le_ker : I_A ≤ RingHom.ker ψ₀ := by
      rw [Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      change (MvPolynomial.aeval P_Z.val) (MvPolynomial.map π (rel_A c)) = 0
      rw [hrel_A c]
      have hmem : P_Z.relation c ∈ P_Z.ker := by
        rw [← P_Z.span_range_relation_eq_ker]
        exact Ideal.subset_span ⟨c, rfl⟩
      change (algebraMap P_Z.Ring B_Z) (P_Z.relation c) = 0 at hmem
      rwa [P_Z.algebraMap_eq] at hmem
    let q₀ : Q_A →+* B_Z := Ideal.Quotient.lift I_A ψ₀ hI_le_ker
    have hq₀_algMap : ∀ m : MvPolynomial ι₀ A,
        q₀ ((algebraMap P_Q.Ring Q_A) m) = (algebraMap P_Z.Ring B_Z) (MvPolynomial.map π m) := by
      intro m
      rw [P_Q.algebraMap_eq, P_Z.algebraMap_eq]
      have h_eq : q₀.comp (MvPolynomial.aeval P_Q.val).toRingHom = ψ₀ := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          change q₀ ((MvPolynomial.aeval P_Q.val) (MvPolynomial.C a)) = ψ₀ (MvPolynomial.C a)
          rw [MvPolynomial.aeval_C]
          rfl
        · intro i
          change q₀ ((MvPolynomial.aeval P_Q.val) (MvPolynomial.X i)) = ψ₀ (MvPolynomial.X i)
          rw [MvPolynomial.aeval_X]
          rfl
      exact RingHom.congr_fun h_eq m
    have hq₀_jac : q₀ j_Q = P_Z.jacobian := by
      change q₀ P_Q.jacobian = P_Z.jacobian
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hq₀_algMap]
      congr 1
      rw [RingHom.map_det]
      congr 1
      refine Matrix.ext fun i j => ?_
      change MvPolynomial.map π (P_Q.jacobiMatrix i j) = P_Z.jacobiMatrix i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      change MvPolynomial.map π (MvPolynomial.pderiv (P_Z.map i) (rel_A j)) =
        MvPolynomial.pderiv (P_Z.map i) (P_Z.relation j)
      rw [← MvPolynomial.pderiv_map, hrel_A j]
    have hUnit_q₀ : IsUnit (q₀ j_Q) := by
      rw [hq₀_jac]
      exact P_Z.jacobian_isUnit
    let π_B : B_A →+* B_Z := IsLocalization.Away.lift j_Q hUnit_q₀
    have hπ_B_eq : ∀ x : Q_A, π_B (algebraMap Q_A B_A x) = q₀ x :=
      IsLocalization.Away.lift_eq j_Q hUnit_q₀
    have hcomm : π_B.comp g_A = f_Z.comp π := by
      ext a
      calc
        π_B (g_A a) = π_B (algebraMap Q_A B_A (algebraMap A Q_A a)) :=
          congrArg π_B (IsScalarTower.algebraMap_apply A Q_A B_A a)
        _ = q₀ (Ideal.Quotient.mk I_A (MvPolynomial.C a)) := hπ_B_eq _
        _ = (MvPolynomial.aeval P_Z.val) (MvPolynomial.map π (MvPolynomial.C a)) := rfl
        _ = f_Z (π a) := by
          rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
          rfl
    have hπ_B_surj : Function.Surjective π_B := by
      intro b
      obtain ⟨p_A, hp_A⟩ := MvPolynomial.map_surjective π hπ_surj (P_Z.σ' b)
      refine ⟨algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A), ?_⟩
      rw [hπ_B_eq]
      change (MvPolynomial.aeval P_Z.val) (MvPolynomial.map π p_A) = b
      rw [hp_A]
      exact P_Z.aeval_val_σ' b
    have hcomm_cat : CommRingCat.ofHom g_A ≫ CommRingCat.ofHom π_B =
        CommRingCat.ofHom π ≫ CommRingCat.ofHom f_Z := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm]
    have hdesc_ex : ∀ s : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom g_A) (CommRingCat.ofHom π),
        ∃ d : CommRingCat.of B_Z ⟶ s.pt,
          CommRingCat.ofHom π_B ≫ d = s.inl ∧ CommRingCat.ofHom f_Z ≫ d = s.inr := by
      intro s
      let u₁ : B_A →+* ↑s.pt := s.inl.hom
      let u₂ : A_Z →+* ↑s.pt := s.inr.hom
      have hu_comm : u₁.comp g_A = u₂.comp π :=
        congrArg CommRingCat.Hom.hom s.condition
      let v_R : ι₀ → ↑s.pt :=
        fun i => u₁ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.X i)))
      let ψ_R : MvPolynomial ι₀ A_Z →+* ↑s.pt := MvPolynomial.eval₂Hom u₂ v_R
      have hψ_map : ∀ p_A : MvPolynomial ι₀ A,
          ψ_R (MvPolynomial.map π p_A) = u₁ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A)) := by
        have h_hom : ψ_R.comp (MvPolynomial.map π) =
            (u₁.comp (algebraMap Q_A B_A)).comp (Ideal.Quotient.mk I_A) := by
          apply MvPolynomial.ringHom_ext'
          · ext a
            change ψ_R (MvPolynomial.map π (MvPolynomial.C a)) =
              u₁ (algebraMap Q_A B_A (algebraMap A Q_A a))
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C,
              ← IsScalarTower.algebraMap_apply A Q_A B_A]
            exact (RingHom.congr_fun hu_comm a).symm
          · intro i
            change ψ_R (MvPolynomial.map π (MvPolynomial.X i)) = v_R i
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        exact RingHom.congr_fun h_hom
      let aeval_hom : MvPolynomial ι₀ A_Z →+* B_Z := (MvPolynomial.aeval P_Z.val).toRingHom
      have hker_le : RingHom.ker aeval_hom ≤ RingHom.ker ψ_R := by
        have hker_eq : RingHom.ker aeval_hom = Ideal.span (Set.range P_Z.relation) :=
          (congrArg RingHom.ker P_Z.algebraMap_eq.symm).trans
            P_Z.span_range_relation_eq_ker.symm
        rw [hker_eq, Ideal.span_le]
        rintro _ ⟨c, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, ← hrel_A c, hψ_map (rel_A c)]
        have h0 : Ideal.Quotient.mk I_A (rel_A c) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨c, rfl⟩)
        rw [h0, map_zero, map_zero]
      have haeval_surj : Function.Surjective aeval_hom :=
        fun b => ⟨P_Z.σ' b, P_Z.aeval_val_σ' b⟩
      let e_quot := RingHom.quotientKerEquivOfSurjective haeval_surj
      let w_quot : (MvPolynomial ι₀ A_Z ⧸ RingHom.ker aeval_hom) →+* ↑s.pt :=
        Ideal.Quotient.lift (RingHom.ker aeval_hom) ψ_R hker_le
      let w : B_Z →+* ↑s.pt := w_quot.comp e_quot.symm.toRingHom
      have hw_aeval : ∀ p_Z : MvPolynomial ι₀ A_Z, w (aeval_hom p_Z) = ψ_R p_Z := by
        intro p_Z
        have he_symm : e_quot.symm (aeval_hom p_Z) = Ideal.Quotient.mk _ p_Z := by
          apply e_quot.injective
          rw [e_quot.apply_symm_apply]
          rfl
        change w_quot (e_quot.symm (aeval_hom p_Z)) = ψ_R p_Z
        rw [he_symm]
        rfl
      refine ⟨CommRingCat.ofHom w, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        apply @IsLocalization.ringHom_ext Q_A _ (Submonoid.powers j_Q) B_A _ _ _ ↑s.pt _
        refine RingHom.ext fun x => ?_
        obtain ⟨p_A, rfl⟩ := Ideal.Quotient.mk_surjective x
        change w (π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A))) =
          u₁ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A))
        rw [hπ_B_eq]
        change w (aeval_hom (MvPolynomial.map π p_A)) = _
        rw [hw_aeval, hψ_map]
      · apply CommRingCat.hom_ext
        ext a_Z
        have hf_eq : f_Z a_Z = aeval_hom (MvPolynomial.C a_Z) :=
          (MvPolynomial.aeval_C P_Z.val a_Z).symm
        change w (f_Z a_Z) = u₂ a_Z
        rw [hf_eq, hw_aeval, MvPolynomial.eval₂Hom_C]
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk
          (CommRingCat.ofHom π_B) (CommRingCat.ofHom f_Z) hcomm_cat) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_cat
        (fun s => (hdesc_ex s).choose)
        (fun s => (hdesc_ex s).choose_spec.1)
        (fun s => (hdesc_ex s).choose_spec.2)
        (fun s m hm₁ _ => ?_)
      apply CommRingCat.hom_ext
      ext b
      obtain ⟨x, rfl⟩ := hπ_B_surj b
      have h₁ : m.hom (π_B x) = s.inl.hom x :=
        congrArg (fun φ => CommRingCat.Hom.hom φ x) hm₁
      have h₂ : (hdesc_ex s).choose.hom (π_B x) = s.inl.hom x :=
        congrArg (fun φ => CommRingCat.Hom.hom φ x) (hdesc_ex s).choose_spec.1
      exact h₁.trans h₂.symm
    exact ⟨B_A, inferInstance, g_A, π_B, hg_A_et, hcomm,
      CategoryTheory.IsPushout.of_isColimit hColim⟩

