    intro C_bar hIntC hProjC _
    have h4 := weil_etale_affine_curve_mod_prime_duality k ℓ hℓ_ne C_bar hIntC hProjC
    exact ⟨h4.1, h4.2.1⟩

  
  have H_ind :
      ∀ (δ₀ r₀ : ℕ)
        (U₀_d : (weilPolyP1Over k δ₀).left.Etale)
        (u₀_d : Quiver.Hom
          ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U₀_d).left
          (weilAffineSpaceOver k δ₀).left)
        (x₀_d : ↥((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U₀_d).left),
        IsClosed
          ({x₀_d} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U₀_d).left) →
        AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U₀_d).left →
        AlgebraicGeometry.Etale u₀_d →
        CategoryTheory.CategoryStruct.comp u₀_d (ι_aff δ₀) =
          ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U₀_d).hom →
        ∃ (U' : (weilPolyP1Over k δ₀).left.Etale)
          (v₀ : Quiver.Hom U' U₀_d)
          (x'₀ : ↥((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U').left),
          AlgebraicGeometry.IsAffine
            ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U').left ∧
          IsClosed
            ({x'₀} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).obj U').left) ∧
          ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ₀).left).map v₀).left.base x'₀ = x₀_d ∧
