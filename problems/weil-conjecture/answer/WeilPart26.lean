        rw [← hy, AlgebraicGeometry.Scheme.Hom.comp_apply, V.range_ι]
        by_contra hnot
        have hx0 : g.1 ((O_lvl U g a).ι.base y) = 0 := g.2 ((O_lvl U g a).ι.base y) hnot
        have hxa : g.1 ((O_lvl U g a).ι.base y) = a := by
          have hmem : (O_lvl U g a).ι.base y ∈ (O_lvl U g a : Set ↥U.left) := by
            rw [← (O_lvl U g a).range_ι]
            exact ⟨y, rfl⟩
          exact hmem
        exact ha (hxa.symm.trans hx0)
      let lift_lvl : ∀ (U : Z.Etale) (g : ↥(weilAltZeroBdrySubgroup Z V n U))
          (a : ↥AM), a ≠ 0 → (W_of U (O_lvl U g a) ⟶ V_et) :=
        fun U g a ha =>
          let l_left : (O_lvl U g a).toScheme ⟶ V.toScheme :=
            AlgebraicGeometry.IsOpenImmersion.lift V.ι ((O_lvl U g a).ι ≫ U.hom)
              (hRange_lvl U g a ha)
          CategoryTheory.MorphismProperty.Over.homMk l_left
            (AlgebraicGeometry.IsOpenImmersion.lift_fac V.ι ((O_lvl U g a).ι ≫ U.hom)
              (hRange_lvl U g a ha))
            trivial
      let sec_lvl : ∀ (U : Z.Etale) (g : ↥(weilAltZeroBdrySubgroup Z V n U))
          (a : ↥AM), ↥(G.obj.obj (Opposite.op (W_of U (O_lvl U g a)))) :=
        fun U g a =>
          if ha : a = 0 then 0
          else (G.obj.map (lift_lvl U g a ha).op).hom (α.hom a)
      have hGlue_lvl : ∀ (U : Z.Etale) (g : ↥(weilAltZeroBdrySubgroup Z V n U)),
          ∃ s : ↥(G.obj.obj (Opposite.op U)),
            ∀ a : ↥AM,
              (G.obj.map (j_of U (O_lvl U g a)).op).hom s = sec_lvl U g a := by
        intro U g
        let W_a := fun a : ↥AM => W_of U (O_lvl U g a)
        let j_a := fun a : ↥AM => j_of U (O_lvl U g a)
        have hmem : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows W_a j_a) ∈
            Z.smallEtaleTopology U := by
          refine hOfArrows_mem Z U W_a j_a ?_ (fun _ => inferInstance)
          intro x
          have hr : x ∈ Set.range (O_lvl U g (g.1 x)).ι.base := by
            rw [(O_lvl U g (g.1 x)).range_ι]
            rfl
          obtain ⟨y, hy⟩ := hr
          exact ⟨g.1 x, y, hy⟩
        have hSh := (G.property Aℤ).isSheafFor _ hmem
        let fam' : ∀ a : ↥AM,
            (G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)).obj (Opposite.op (W_a a)) :=
          fun a => toHom (sec_lvl U g a)
        have hx : CategoryTheory.Presieve.Arrows.Compatible
            (G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) j_a fam' := by
          intro a₁ a₂ Y p₁ p₂ hp
          change toHom (sec_lvl U g a₁) ≫ G.obj.map p₁.op =
            toHom (sec_lvl U g a₂) ≫ G.obj.map p₂.op
          rw [hto_comp, hto_comp]
          congr 1
          by_cases ha : a₁ = a₂
          · subst ha
            have hp_eq : p₁ = p₂ := by
              apply CategoryTheory.MorphismProperty.Comma.Hom.ext
              · have hleft : p₁.left ≫ (O_lvl U g a₁).ι = p₂.left ≫ (O_lvl U g a₁).ι :=
                  congrArg (fun k : Y ⟶ U => k.left) hp
                exact (CategoryTheory.cancel_mono (O_lvl U g a₁).ι).mp hleft
              · exact Subsingleton.elim _ _
            rw [hp_eq]
          · have hEmp : IsEmpty ↥Y.left := ⟨fun y => by
              have hx_raw : (p₁.left ≫ (O_lvl U g a₁).ι) y =
                  (p₂.left ≫ (O_lvl U g a₂).ι) y :=
                congrArg (fun k : Y ⟶ U => k.left y) hp
              have hx1 : (O_lvl U g a₁).ι (p₁.left y) = (O_lvl U g a₂).ι (p₂.left y) :=
                (AlgebraicGeometry.Scheme.Hom.comp_apply p₁.left (O_lvl U g a₁).ι y).symm.trans
                  (hx_raw.trans
                    (AlgebraicGeometry.Scheme.Hom.comp_apply p₂.left (O_lvl U g a₂).ι y))
              have hm1 : (O_lvl U g a₁).ι (p₁.left y) ∈ (O_lvl U g a₁ : Set ↥U.left) := by
                rw [← (O_lvl U g a₁).range_ι]; exact ⟨_, rfl⟩
              have hm2 : (O_lvl U g a₂).ι (p₂.left y) ∈ (O_lvl U g a₂ : Set ↥U.left) := by
                rw [← (O_lvl U g a₂).range_ι]; exact ⟨_, rfl⟩
              have hv1 : g.1 ((O_lvl U g a₁).ι (p₁.left y)) = a₁ := hm1
              have hv2 : g.1 ((O_lvl U g a₂).ι (p₂.left y)) = a₂ := hm2
              rw [hx1] at hv1
              exact ha (hv1.symm.trans hv2)⟩
            have hSub := hEmpty_subsingleton Z Y hEmp G
            exact @Subsingleton.elim _ hSub _ _
        let m := hSh.amalgamate hx.familyOfElements hx.familyOfElements_compatible
        refine ⟨evHom m, fun a => ?_⟩
        have hvg := hSh.valid_glue hx.familyOfElements_compatible (j_a a)
          (CategoryTheory.Presieve.ofArrows.mk a)
        rw [hx.familyOfElements_ofArrows_mk a] at hvg
        exact (congrArg evHom hvg).trans (hev_to (sec_lvl U g a))
      let σ_fn : ∀ (U : Z.Etale), ↥(weilAltZeroBdrySubgroup Z V n U) →
          ↥(G.obj.obj (Opposite.op U)) :=
        fun U g => Classical.choose (hGlue_lvl U g)
      have hσ_spec : ∀ (U : Z.Etale) (g : ↥(weilAltZeroBdrySubgroup Z V n U))
          (a : ↥AM),
          (G.obj.map (j_of U (O_lvl U g a)).op).hom (σ_fn U g) = sec_lvl U g a :=
        fun U g => Classical.choose_spec (hGlue_lvl U g)
      have hσ_const : ∀ (U : Z.Etale) (g : ↥(weilAltZeroBdrySubgroup Z V n U))
          (O : U.left.Opens) (c : ↥AM),
          O ≤ O_lvl U g c →
          ((c = 0 → (G.obj.map (j_of U O).op).hom (σ_fn U g) = 0) ∧
           (∀ m : W_of U O ⟶ V_et,
             (G.obj.map (j_of U O).op).hom (σ_fn U g) = (G.obj.map m.op).hom (α.hom c))) := by
        intro U g O c hle
        let inc : W_of U O ⟶ W_of U (O_lvl U g c) :=
          CategoryTheory.MorphismProperty.Over.homMk (U.left.homOfLE hle)
            (AlgebraicGeometry.Scheme.homOfLE_ι_assoc U.left hle U.hom) trivial
        have hinc_j : inc ≫ j_of U (O_lvl U g c) = j_of U O := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext
          · exact AlgebraicGeometry.Scheme.homOfLE_ι U.left hle
          · exact Subsingleton.elim _ _
        have h_res : (G.obj.map (j_of U O).op).hom (σ_fn U g) =
            (G.obj.map inc.op).hom (sec_lvl U g c) := by
          rw [← hinc_j, op_comp, G.obj.map_comp]
          change (G.obj.map inc.op).hom
            ((G.obj.map (j_of U (O_lvl U g c)).op).hom (σ_fn U g)) = _
          rw [hσ_spec U g c]
        refine ⟨?_, ?_⟩
        · intro hc0
          rw [h_res]
          have hs0 : sec_lvl U g c = 0 := dite_eq_left_of_eq_true (eq_true hc0)
          rw [hs0, map_zero]
        · intro m
          rw [h_res]
          by_cases hc0 : c = 0
          · have hs0 : sec_lvl U g c = 0 := dite_eq_left_of_eq_true (eq_true hc0)
            have hα0 : α.hom c = 0 := by rw [hc0, map_zero]
            rw [hs0, hα0, map_zero, map_zero]
          · have hsl : sec_lvl U g c = (G.obj.map (lift_lvl U g c hc0).op).hom (α.hom c) :=
              dite_eq_right_of_eq_false (eq_false hc0)
            rw [hsl]
            have hm_eq : inc ≫ lift_lvl U g c hc0 = m := hVet_subterm _ _
            change ((G.obj.map (lift_lvl U g c hc0).op ≫ G.obj.map inc.op).hom) (α.hom c) = _
            rw [← G.obj.map_comp, ← op_comp, hm_eq]
      have hσ_zero : ∀ U : Z.Etale, σ_fn U 0 = 0 := by
        intro U
        apply hSep_opens U (fun _ : ULift.{u} Unit => (⊤ : U.left.Opens))
          (fun _ => ⟨ULift.up (), trivial⟩)
        intro _
        rw [(hσ_const U 0 ⊤ 0 (fun _ _ => rfl)).1 rfl, map_zero]
      have hσ_add : ∀ (U : Z.Etale) (g₁ g₂ : ↥(weilAltZeroBdrySubgroup Z V n U)),
          σ_fn U (g₁ + g₂) = σ_fn U g₁ + σ_fn U g₂ := by
        intro U g₁ g₂
        let O₁₂ : ↥AM × ↥AM → U.left.Opens :=
          fun p => O_lvl U g₁ p.1 ⊓ O_lvl U g₂ p.2
        apply hSep_opens U O₁₂ (fun x => ⟨(g₁.1 x, g₂.1 x), ⟨rfl, rfl⟩⟩)
        rintro ⟨a₁, a₂⟩
        have hle1 : O₁₂ (a₁, a₂) ≤ O_lvl U g₁ a₁ := inf_le_left
        have hle2 : O₁₂ (a₁, a₂) ≤ O_lvl U g₂ a₂ := inf_le_right
        have hle12 : O₁₂ (a₁, a₂) ≤ O_lvl U (g₁ + g₂) (a₁ + a₂) := by
          intro x ⟨hx1, hx2⟩
          change (g₁.1 + g₂.1) x = a₁ + a₂
          exact (LocallyConstant.add_apply g₁.1 g₂.1 x).trans (congrArg₂ (· + ·) hx1 hx2)
        rw [map_add]
        by_cases h00 : a₁ = 0 ∧ a₂ = 0
        · rcases h00 with ⟨rfl, rfl⟩
          rw [(hσ_const U (g₁ + g₂) (O₁₂ (0, 0)) (0 + 0) hle12).1 (add_zero 0),
            (hσ_const U g₁ (O₁₂ (0, 0)) 0 hle1).1 rfl,
            (hσ_const U g₂ (O₁₂ (0, 0)) 0 hle2).1 rfl, add_zero]
        · have hm_ex : Nonempty (W_of U (O₁₂ (a₁, a₂)) ⟶ V_et) := by
            by_cases ha1 : a₁ = 0
            · have ha2 : a₂ ≠ 0 := fun h2 => h00 ⟨ha1, h2⟩
              let inc2 : W_of U (O₁₂ (a₁, a₂)) ⟶ W_of U (O_lvl U g₂ a₂) :=
                CategoryTheory.MorphismProperty.Over.homMk (U.left.homOfLE hle2)
                  (AlgebraicGeometry.Scheme.homOfLE_ι_assoc U.left hle2 U.hom) trivial
              exact ⟨inc2 ≫ lift_lvl U g₂ a₂ ha2⟩
            · let inc1 : W_of U (O₁₂ (a₁, a₂)) ⟶ W_of U (O_lvl U g₁ a₁) :=
                CategoryTheory.MorphismProperty.Over.homMk (U.left.homOfLE hle1)
                  (AlgebraicGeometry.Scheme.homOfLE_ι_assoc U.left hle1 U.hom) trivial
              exact ⟨inc1 ≫ lift_lvl U g₁ a₁ ha1⟩
          obtain ⟨m⟩ := hm_ex
          rw [(hσ_const U (g₁ + g₂) (O₁₂ (a₁, a₂)) (a₁ + a₂) hle12).2 m,
            (hσ_const U g₁ (O₁₂ (a₁, a₂)) a₁ hle1).2 m,
            (hσ_const U g₂ (O₁₂ (a₁, a₂)) a₂ hle2).2 m, map_add, map_add]
      let σ_nat : K_ZV.obj ⟶ G.obj :=
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := σ_fn (Opposite.unop U)
              map_zero' := hσ_zero (Opposite.unop U)
              map_add' := hσ_add (Opposite.unop U) }
          naturality := fun {U₁ U₂} u => by
            apply AddCommGrpCat.ext
            intro g
            let U := Opposite.unop U₁
            let U' := Opposite.unop U₂
            let g₀ : ↥(weilAltZeroBdrySubgroup Z V n U) := g
            let g' : ↥(weilAltZeroBdrySubgroup Z V n U') := (K_ZV.obj.map u).hom g
            change σ_fn U' g' = (G.obj.map u).hom (σ_fn U g₀)
            apply hSep_opens U' (O_lvl U' g') (fun x => ⟨g'.1 x, rfl⟩)
            intro a
            have hRange_u : Set.range ((O_lvl U' g' a).ι ≫ u.unop.left).base ⊆
                Set.range (O_lvl U g₀ a).ι.base := by
              rintro _ ⟨y, rfl⟩
              rw [AlgebraicGeometry.Scheme.Hom.comp_apply, (O_lvl U g₀ a).range_ι]
              have hy : (O_lvl U' g' a).ι.base y ∈ (O_lvl U' g' a : Set ↥U'.left) := by
                rw [← (O_lvl U' g' a).range_ι]; exact ⟨y, rfl⟩
              exact hy
            let u_left := AlgebraicGeometry.IsOpenImmersion.lift (O_lvl U g₀ a).ι
              ((O_lvl U' g' a).ι ≫ u.unop.left) hRange_u
            have hu_fac : u_left ≫ (O_lvl U g₀ a).ι = (O_lvl U' g' a).ι ≫ u.unop.left :=
              AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hRange_u
            let u_a : W_of U' (O_lvl U' g' a) ⟶ W_of U (O_lvl U g₀ a) :=
              CategoryTheory.MorphismProperty.Over.homMk u_left
                ((CategoryTheory.Category.assoc u_left (O_lvl U g₀ a).ι U.hom).symm.trans
                  ((congrArg (· ≫ U.hom) hu_fac).trans
                    ((CategoryTheory.Category.assoc (O_lvl U' g' a).ι u.unop.left U.hom).trans
                      (congrArg ((O_lvl U' g' a).ι ≫ ·) u.unop.w))))
                trivial
            have hu_sq : j_of U' (O_lvl U' g' a) ≫ u.unop = u_a ≫ j_of U (O_lvl U g₀ a) := by
              apply CategoryTheory.MorphismProperty.Comma.Hom.ext
              · exact hu_fac.symm
              · exact Subsingleton.elim _ _
            have hu_op : u ≫ (j_of U' (O_lvl U' g' a)).op =
                (u_a ≫ j_of U (O_lvl U g₀ a)).op := by
              have h1 : u ≫ (j_of U' (O_lvl U' g' a)).op =
                  (j_of U' (O_lvl U' g' a) ≫ u.unop).op := rfl
              exact h1.trans (congrArg Opposite.op hu_sq)
            have h_rhs : (G.obj.map (j_of U' (O_lvl U' g' a)).op).hom
                ((G.obj.map u).hom (σ_fn U g₀)) =
                (G.obj.map u_a.op).hom ((G.obj.map (j_of U (O_lvl U g₀ a)).op).hom (σ_fn U g₀)) := by
              change ((G.obj.map u ≫ G.obj.map (j_of U' (O_lvl U' g' a)).op).hom) (σ_fn U g₀) =
                ((G.obj.map (j_of U (O_lvl U g₀ a)).op ≫ G.obj.map u_a.op).hom) (σ_fn U g₀)
              rw [← G.obj.map_comp, ← G.obj.map_comp, hu_op, op_comp]
            rw [h_rhs]
            by_cases ha0 : a = 0
            · rw [(hσ_const U' g' (O_lvl U' g' a) a le_rfl).1 ha0,
                (hσ_const U g₀ (O_lvl U g₀ a) a le_rfl).1 ha0, map_zero]
            · let m' : W_of U' (O_lvl U' g' a) ⟶ V_et := u_a ≫ lift_lvl U g₀ a ha0
              rw [(hσ_const U' g' (O_lvl U' g' a) a le_rfl).2 m',
                (hσ_const U g₀ (O_lvl U g₀ a) a le_rfl).2 (lift_lvl U g₀ a ha0)]
              change (G.obj.map m'.op).hom (α.hom a) =
                ((G.obj.map (lift_lvl U g₀ a ha0).op ≫ G.obj.map u_a.op).hom) (α.hom a)
              rw [← G.obj.map_comp, ← op_comp] }
      let σ_ZV : K_ZV ⟶ G := { hom := σ_nat }
      have h_ρσ : ρ_ZV ≫ σ_ZV = 𝟙 G := by
        apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        rw [hFY_comp ρ_ZV σ_ZV]
        dsimp only [ρ_ZV]
        rw [CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply]
        apply AddCommGrpCat.ext
        intro a
        change σ_fn V_et (ι_ZV.hom a) = α.hom a
        apply hSep_opens V_et (fun _ : ULift.{u} Unit => (⊤ : V_et.left.Opens))
          (fun _ => ⟨ULift.up (), trivial⟩)
        intro _
        exact (hσ_const V_et (ι_ZV.hom a) ⊤ a (fun _ _ => rfl)).2 (j_of V_et ⊤)
      have h_σρ : σ_ZV ≫ ρ_ZV = 𝟙 K_ZV := by
        let Φ : K_ZV ⟶ K_ZV := σ_ZV ≫ ρ_ZV
        have hΦ_Vet : ι_ZV ≫ Φ.hom.app (Opposite.op V_et) = ι_ZV := by
          change ι_ZV ≫ (σ_ZV.hom.app (Opposite.op V_et) ≫ ρ_ZV.hom.app (Opposite.op V_et)) = ι_ZV
          rw [← CategoryTheory.Category.assoc]
          have h_ι_σ : ι_ZV ≫ σ_ZV.hom.app (Opposite.op V_et) = α := by
            have h1 := congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv h_ρσ
            rw [hFY_comp ρ_ZV σ_ZV] at h1
            dsimp only [ρ_ZV] at h1
            rwa [CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply] at h1
          rw [h_ι_σ, ← hFY_comp (𝟙 G) ρ_ZV, CategoryTheory.Category.id_comp]
          exact CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply ι_ZV
        apply CategoryTheory.Sheaf.hom_ext
        ext U_op g
        apply Subtype.ext
        apply LocallyConstant.ext
        intro x
        let U := Opposite.unop U_op
        let g₀ : ↥(weilAltZeroBdrySubgroup Z V n U) := g
        let a : ↥AM := g₀.1 x
        have hx_range : x ∈ Set.range (O_lvl U g₀ a).ι.base := by
          rw [(O_lvl U g₀ a).range_ι]
          rfl
        obtain ⟨y, hy⟩ := hx_range
        have hnat_j := congrArg (fun m => (m.hom g₀).1 y)
          (Φ.hom.naturality (j_of U (O_lvl U g₀ a)).op).symm
        change ((Φ.hom.app (Opposite.op U)).hom g₀).1 ((j_of U (O_lvl U g₀ a)).left.base y) =
          ((Φ.hom.app (Opposite.op (W_of U (O_lvl U g₀ a)))).hom
            ((K_ZV.obj.map (j_of U (O_lvl U g₀ a)).op).hom g₀)).1 y at hnat_j
        have hj_y : (j_of U (O_lvl U g₀ a)).left.base y = x := hy
        rw [hj_y] at hnat_j
        change ((Φ.hom.app (Opposite.op U)).hom g₀).1 x = g₀.1 x
        rw [hnat_j]
        by_cases ha0 : a = 0
        · have hg0 : (K_ZV.obj.map (j_of U (O_lvl U g₀ a)).op).hom g₀ = 0 := by
            apply Subtype.ext
            apply LocallyConstant.ext
            intro z
            have hz : (O_lvl U g₀ a).ι.base z ∈ (O_lvl U g₀ a : Set ↥U.left) := by
              rw [← (O_lvl U g₀ a).range_ι]; exact ⟨z, rfl⟩
            exact hz.trans ha0
          rw [hg0, map_zero]
          exact ha0.symm
        · have hg_lift : (K_ZV.obj.map (j_of U (O_lvl U g₀ a)).op).hom g₀ =
              (K_ZV.obj.map (lift_lvl U g₀ a ha0).op).hom (ι_ZV.hom a) := by
            apply Subtype.ext
            apply LocallyConstant.ext
            intro z
            have hz : (O_lvl U g₀ a).ι.base z ∈ (O_lvl U g₀ a : Set ↥U.left) := by
              rw [← (O_lvl U g₀ a).range_ι]; exact ⟨z, rfl⟩
            exact hz
          rw [hg_lift]
          have hnat_l := congrArg (fun m => (m.hom (ι_ZV.hom a)).1 y)
            (Φ.hom.naturality (lift_lvl U g₀ a ha0).op)
          change ((Φ.hom.app (Opposite.op (W_of U (O_lvl U g₀ a)))).hom
              ((K_ZV.obj.map (lift_lvl U g₀ a ha0).op).hom (ι_ZV.hom a))).1 y =
            ((K_ZV.obj.map (lift_lvl U g₀ a ha0).op).hom
              ((Φ.hom.app (Opposite.op V_et)).hom (ι_ZV.hom a))).1 y at hnat_l
          rw [hnat_l]
          have hΦ_a : (Φ.hom.app (Opposite.op V_et)).hom (ι_ZV.hom a) = ι_ZV.hom a :=
            congrArg (fun m => m.hom a) hΦ_Vet
          rw [hΦ_a]
          rfl
      exact ⟨⟨σ_ZV, h_ρσ, h_σρ⟩⟩

  refine ⟨hConj1, hConj2, fun Z V hSh_0 => (hZeroBdryRep Z V hSh_0).1, ?_⟩
  intro C W ι V hSh_W hSh_C V_C K_W K_C
  let B_ι := weilEtaleSitePullback ι
  let FgtW := AlgebraicGeometry.Scheme.Etale.forget W
  let FgtC := AlgebraicGeometry.Scheme.Etale.forget C
  let ν_ι : weilAltZeroBdrySubpresheaf W V n ⟶ B_ι.op ⋙ weilAltZeroBdrySubpresheaf C V_C n :=
    { app := fun E_op =>
        let E := Opposite.unop E_op
        let pr₁ : (FgtC.obj (B_ι.obj E)).left ⟶ (FgtW.obj E).left :=
          CategoryTheory.Limits.pullback.fst (FgtW.obj E).hom ι
        let pr₂ : (FgtC.obj (B_ι.obj E)).left ⟶ C :=
          CategoryTheory.Limits.pullback.snd (FgtW.obj E).hom ι
        AddCommGrpCat.ofHom
          { toFun := fun σ =>
              ⟨{ toFun := fun y => σ.1 (pr₁ y)
                 isLocallyConstant := fun t =>
                   pr₁.continuous.isOpen_preimage _ (σ.1.isLocallyConstant t) },
               fun y hy => σ.2 (pr₁ y) (fun hmem => hy (by
                 have hcomm : (FgtW.obj E).hom (pr₁ y) = ι (pr₂ y) :=
                   (AlgebraicGeometry.Scheme.Hom.comp_apply pr₁ (FgtW.obj E).hom y).symm.trans
                     ((congrArg (fun k : (FgtC.obj (B_ι.obj E)).left ⟶ W => k y)
