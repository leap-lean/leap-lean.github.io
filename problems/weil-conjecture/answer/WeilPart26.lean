        Nonempty (CategoryTheory.Limits.IsTerminal (B_Z.obj (weilEtaleIdTerminal.{u} Z))) := by
    have hHasFinLim_et : ∀ S : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Limits.HasFiniteLimits S.Etale := by
      intro S
      have _ : CategoryTheory.Limits.HasTerminal S.Etale :=
        CategoryTheory.Limits.IsTerminal.hasTerminal (weilEtaleIdTerminalIsTerminal.{u} S)
      exact CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
