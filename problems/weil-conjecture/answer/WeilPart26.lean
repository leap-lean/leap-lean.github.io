        have hconst : ((Φ_loc.hom.app (Opposite.op W)).hom (η_hom W a)) =
            LocallyConstant.const ↥(Fgt.obj W).left a :=
          congrArg (fun k : AM ⟶ (weilAltLocConstPresheaf S n).obj (Opposite.op W) => k.hom a)
            (hΦ_loc_pin W)
        change ψ_loc_fun W ((Φ_loc.hom.app (Opposite.op W)).hom (η_hom W a)) = η_hom W a
        rw [hconst]
        apply hOpenSep F_tor W (O_loc W (LocallyConstant.const _ a)) (fun x => ⟨x, rfl⟩)
        intro x
        rw [hψ_loc_spec, hη_nat]; rfl
      have hΨΦ_loc : Ψ_loc ≫ Φ_loc = 𝟙 L_loc := by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext opW
