        (CategoryTheory.Limits.pullback.fst W.hom (σ a))).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp s.1) hmap_fst).trans
          (CategoryTheory.Category.assoc s.1
            (CategoryTheory.Limits.pullback.fst W'.hom (σ a)) u.left).symm)
    have h_bwd_nat : ∀ (a : Fin m) {W' W : X.Etale} (u : W' ⟶ W)
        (γ : weilPunctCurveSectionLift σ a W'),
        (⟨(bwd a W' γ).1 ≫ ((AlgebraicGeometry.Scheme.Etale.forget S_k).map ((B a).map u)).left,
          (CategoryTheory.Category.assoc (bwd a W' γ).1 _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp (bwd a W' γ).1)
              ((AlgebraicGeometry.Scheme.Etale.forget S_k).map ((B a).map u)).w).trans
              (bwd a W' γ).2)⟩ :
