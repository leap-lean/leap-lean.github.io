          change l_hom ≫
            (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom P_1.hom ≫
              (weilPolyP1Over k δ).hom) = _
          rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
