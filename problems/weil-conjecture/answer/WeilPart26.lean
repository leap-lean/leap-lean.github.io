          hSE₂.extClass rfl =
        (x.comp hSE₁.extClass rfl).comp
          (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₁) (Nat.add_zero (q + 1))
      rw [CategoryTheory.Abelian.Ext.comp_assoc x (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₃)
        hSE₂.extClass (Nat.add_zero q) (Nat.zero_add 1) rfl,
        ← CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₁ hSE₂ Φ,
        ← CategoryTheory.Abelian.Ext.comp_assoc x hSE₁.extClass
          (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₁) rfl (Nat.add_zero 1) (Nat.add_zero (q + 1))]

theorem weil_etale_acyclic_pushforward_cohomology_equiv (Y B : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom Y B)
    [hc_π : (weilEtaleSitePullback π).IsContinuous B.smallEtaleTopology Y.smallEtaleTopology]
    [hr_π : ((weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
      B.smallEtaleTopology Y.smallEtaleTopology).IsRightAdjoint]
    [hAdd_pb : ((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
      B.smallEtaleTopology Y.smallEtaleTopology).Additive]
    [hLim_pb : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
        B.smallEtaleTopology Y.smallEtaleTopology)] :
    let pf_π := (weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
      B.smallEtaleTopology Y.smallEtaleTopology
    let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let Fℤ_B := (CategoryTheory.constantSheaf B.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    ∃ (Λ_π : ∀ (K : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (m : ℕ),
        (pf_π.obj K).H m →+ K.H m),
      (∀ {K₁ K₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : Quiver.Hom K₁ K₂) (m : ℕ) (x : (pf_π.obj K₁).H m),
        Λ_π K₂ m ((CategoryTheory.Abelian.Ext.mk₀ (pf_π.map ψ)).postcomp Fℤ_B (Nat.add_zero m) x) =
          (CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp Fℤ_Y (Nat.add_zero m) (Λ_π K₁ m x)) ∧
      (∀ (K : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
        Function.Bijective (Λ_π K 0)) ∧
      (∀ (K : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ k_deg : ℕ, 1 ≤ k_deg →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π k_deg K)) →
        ∀ (m : ℕ), Function.Bijective (Λ_π K m)) :=
by
  classical
  
  
  
  
  have hAbelianEngine :
      ∀ (𝒜_Y 𝒜_B : Type (u + 1))
        [CategoryTheory.Category.{u + 1, u + 1} 𝒜_Y] [CategoryTheory.Abelian 𝒜_Y]
        [CategoryTheory.HasExt.{u} 𝒜_Y] [CategoryTheory.EnoughInjectives 𝒜_Y]
        [CategoryTheory.Category.{u + 1, u + 1} 𝒜_B] [CategoryTheory.Abelian 𝒜_B]
        [CategoryTheory.HasExt.{u} 𝒜_B]
        (pb : 𝒜_B ⥤ 𝒜_Y) (pf : 𝒜_Y ⥤ 𝒜_B) (_adj : pb ⊣ pf)
        [pb.Additive] [CategoryTheory.Limits.PreservesFiniteLimits pb]
        [CategoryTheory.Limits.PreservesFiniteColimits pb]
        [pf.PreservesZeroMorphisms]
        (Z_Y : 𝒜_Y) (Z_B : 𝒜_B)
        (ι_Z : Z_Y ⟶ pb.obj Z_B) (π_Z : pb.obj Z_B ⟶ Z_Y),
        ι_Z ≫ π_Z = 𝟙 Z_Y →
        π_Z ≫ ι_Z = 𝟙 (pb.obj Z_B) →
        ∀ (P : 𝒜_Y → Prop),
          (∀ (I : 𝒜_Y) [CategoryTheory.Injective I], P I) →
          (∀ {SC : CategoryTheory.ShortComplex 𝒜_Y},
            SC.ShortExact → P SC.X₁ → ∀ [CategoryTheory.Injective SC.X₂],
              (SC.map pf).ShortExact ∧ P SC.X₃) →
          ∃ (Λ : ∀ (K : 𝒜_Y) (m : ℕ),
              CategoryTheory.Abelian.Ext Z_B (pf.obj K) m →+
                CategoryTheory.Abelian.Ext Z_Y K m),
            (∀ {K₁ K₂ : 𝒜_Y} (ψ : K₁ ⟶ K₂) (m : ℕ)
                (x : CategoryTheory.Abelian.Ext Z_B (pf.obj K₁) m),
              Λ K₂ m ((CategoryTheory.Abelian.Ext.mk₀ (pf.map ψ)).postcomp Z_B (Nat.add_zero m) x) =
                (CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp Z_Y (Nat.add_zero m) (Λ K₁ m x)) ∧
            (∀ (K : 𝒜_Y), Function.Bijective (Λ K 0)) ∧
            (∀ (K : 𝒜_Y), P K → ∀ (m : ℕ), Function.Bijective (Λ K m)) := by
    clear hLim_pb hAdd_pb hr_π hc_π π B Y
    intro 𝒜_Y 𝒜_B _ _ _ _ _ _ _ pb pf adj _ _ _ _ Z_Y Z_B ι_Z π_Z hιπ_Z hπ_ι_Z
      P hP_inj hP_step
    let Λ : ∀ (K : 𝒜_Y) (m : ℕ),
        CategoryTheory.Abelian.Ext Z_B (pf.obj K) m →+ CategoryTheory.Abelian.Ext Z_Y K m :=
      fun K m =>
        ((CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app K)).postcomp Z_Y (Nat.add_zero m)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ι_Z).precomp (pb.obj (pf.obj K)) (Nat.zero_add m)).comp
            (pb.mapExtAddHom Z_B (pf.obj K) m))
    have hΛ_apply : ∀ (K : 𝒜_Y) (m : ℕ) (x : CategoryTheory.Abelian.Ext Z_B (pf.obj K) m),
        Λ K m x =
          ((CategoryTheory.Abelian.Ext.mk₀ ι_Z).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb x) (Nat.zero_add m)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app K)) (Nat.add_zero m) :=
      fun _ _ _ => rfl
    have hΛ_nat : ∀ {K₁ K₂ : 𝒜_Y} (ψ : K₁ ⟶ K₂) (m : ℕ)
        (x : CategoryTheory.Abelian.Ext Z_B (pf.obj K₁) m),
        Λ K₂ m ((CategoryTheory.Abelian.Ext.mk₀ (pf.map ψ)).postcomp Z_B (Nat.add_zero m) x) =
          (CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp Z_Y (Nat.add_zero m) (Λ K₁ m x) := by
      intro K₁ K₂ ψ m x
      have hcounit_ψ : pb.map (pf.map ψ) ≫ adj.counit.app K₂ = adj.counit.app K₁ ≫ ψ :=
        adj.counit.naturality ψ
      change Λ K₂ m (x.comp (CategoryTheory.Abelian.Ext.mk₀ (pf.map ψ)) (Nat.add_zero m)) =
        (Λ K₁ m x).comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero m)
      rw [hΛ_apply, hΛ_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb x
          (CategoryTheory.Abelian.Ext.mk₀ (pf.map ψ)) (Nat.add_zero m),
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb (pf.map ψ),
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          ((CategoryTheory.Abelian.Ext.mk₀ ι_Z).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb x) (Nat.zero_add m)),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hcounit_ψ,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    have hΛ_bij0 : ∀ (K : 𝒜_Y), Function.Bijective (Λ K 0) := by
      intro K
      let g_inv : CategoryTheory.Abelian.Ext Z_Y K 0 →
          CategoryTheory.Abelian.Ext Z_B (pf.obj K) 0 :=
        fun y => CategoryTheory.Abelian.Ext.addEquiv₀.symm
          (adj.homEquiv Z_B K (π_Z ≫ CategoryTheory.Abelian.Ext.addEquiv₀ y))
      have hΛ0_eq : ∀ (x : CategoryTheory.Abelian.Ext Z_B (pf.obj K) 0),
          CategoryTheory.Abelian.Ext.addEquiv₀ (Λ K 0 x) =
            ι_Z ≫ (adj.homEquiv Z_B K).symm (CategoryTheory.Abelian.Ext.addEquiv₀ x) := by
        intro x
        let u : Z_B ⟶ pf.obj K := CategoryTheory.Abelian.Ext.addEquiv₀ x
        have hx : x = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
        calc
          CategoryTheory.Abelian.Ext.addEquiv₀ (Λ K 0 x)
            = CategoryTheory.Abelian.Ext.addEquiv₀
                (CategoryTheory.Abelian.Ext.mk₀ (ι_Z ≫ (pb.map u ≫ adj.counit.app K))) := by
              conv_lhs => rw [hx]
              rw [hΛ_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
                CategoryTheory.Category.assoc]
          _ = ι_Z ≫ (pb.map u ≫ adj.counit.app K) := by
              rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
          _ = ι_Z ≫ (adj.homEquiv Z_B K).symm u := by
              rw [CategoryTheory.Adjunction.homEquiv_counit]
      refine Function.bijective_iff_has_inverse.mpr ⟨g_inv, ?_, ?_⟩
      · intro x
        dsimp [g_inv]
        rw [hΛ0_eq x, ← CategoryTheory.Category.assoc, hπ_ι_Z, CategoryTheory.Category.id_comp,
          Equiv.apply_symm_apply, AddEquiv.symm_apply_apply]
      · intro y
        apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
        rw [hΛ0_eq (g_inv y)]
        dsimp [g_inv]
        rw [AddEquiv.apply_symm_apply, Equiv.symm_apply_apply,
          ← CategoryTheory.Category.assoc, hιπ_Z, CategoryTheory.Category.id_comp]
    have hΛ_extClass : ∀ {SC : CategoryTheory.ShortComplex 𝒜_Y}
        (hSE_Y : SC.ShortExact) (hSE_B : (SC.map pf).ShortExact)
        (m : ℕ) (x : CategoryTheory.Abelian.Ext Z_B (pf.obj SC.X₃) m),
        Λ SC.X₁ (m + 1) (x.comp hSE_B.extClass rfl) =
          (Λ SC.X₃ m x).comp hSE_Y.extClass rfl := by
      intro SC hSE_Y hSE_B m x
      let counit_SC : (SC.map pf).map pb ⟶ SC :=
        { τ₁ := adj.counit.app SC.X₁
          τ₂ := adj.counit.app SC.X₂
          τ₃ := adj.counit.app SC.X₃
          comm₁₂ := (adj.counit.naturality SC.f).symm
          comm₂₃ := (adj.counit.naturality SC.g).symm }
      have hSE_pb : ((SC.map pf).map pb).ShortExact := hSE_B.map_of_exact pb
      have hmap_ext : CategoryTheory.Abelian.Ext.mapExactFunctor pb hSE_B.extClass =
          hSE_pb.extClass :=
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb hSE_B
      have hnat_ext :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb hSE_Y counit_SC
      rw [hΛ_apply, hΛ_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb x hSE_B.extClass rfl,
        hmap_ext]
      change ((CategoryTheory.Abelian.Ext.mk₀ ι_Z).comp
          ((CategoryTheory.Abelian.Ext.mapExactFunctor pb x).comp hSE_pb.extClass rfl)
          (Nat.zero_add (m + 1))).comp
          (CategoryTheory.Abelian.Ext.mk₀ counit_SC.τ₁) (Nat.add_zero (m + 1)) = _
      rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ι_Z)
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb x) hSE_pb.extClass
          (Nat.zero_add m) rfl (Nat.zero_add (m + 1)),
        CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ ι_Z).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb x) (Nat.zero_add m))
          hSE_pb.extClass (CategoryTheory.Abelian.Ext.mk₀ counit_SC.τ₁)
          rfl (Nat.add_zero 1) (Nat.add_zero (m + 1)),
        hnat_ext,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ ι_Z).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb x) (Nat.zero_add m))
          (CategoryTheory.Abelian.Ext.mk₀ counit_SC.τ₃) hSE_Y.extClass
          (Nat.add_zero m) (Nat.zero_add 1) rfl]
    
    have hΛ_bij_P : ∀ (m : ℕ) (K : 𝒜_Y), P K → Function.Bijective (Λ K m) := by
      intro m
      induction m with
      | zero =>
        intro K _
        exact hΛ_bij0 K
      | succ m ih =>
        intro K hPK
        let I₀ : 𝒜_Y := CategoryTheory.Injective.under K
        let ι₀ : K ⟶ I₀ := CategoryTheory.Injective.ι K
        let Q₁ : 𝒜_Y := CategoryTheory.Limits.cokernel ι₀
        let π₀ : I₀ ⟶ Q₁ := CategoryTheory.Limits.cokernel.π ι₀
        let E₀ : CategoryTheory.ShortComplex 𝒜_Y :=
          CategoryTheory.ShortComplex.mk ι₀ π₀ (CategoryTheory.Limits.cokernel.condition ι₀)
        have hE₀ : E₀.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_cokernel ι₀) inferInstance inferInstance
        have hInj_pfI₀ : CategoryTheory.Injective (pf.obj I₀) :=
          CategoryTheory.Injective.injective_of_adjoint adj I₀
        obtain ⟨hSE_B, hPQ₁⟩ := hP_step hE₀ hPK
        have hBij_Q : Function.Bijective (Λ Q₁ m) := ih Q₁ hPQ₁
        have hBij_I : Function.Bijective (Λ I₀ m) := ih I₀ (hP_inj I₀)
        refine ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro x hx
          have : CategoryTheory.Injective (E₀.map pf).X₂ := hInj_pfI₀
          have hx_pfI : x.comp (CategoryTheory.Abelian.Ext.mk₀ (E₀.map pf).f)
              (Nat.add_zero (m + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨c_B, rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z_B hSE_B x hx_pfI rfl
          have hcY_ext : (Λ Q₁ m c_B).comp hE₀.extClass rfl = 0 := by
            rw [← hΛ_extClass hE₀ hSE_B m c_B]
            exact hx
          obtain ⟨i_Y, hi_Y⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Z_Y hE₀ (Λ Q₁ m c_B) rfl hcY_ext
          obtain ⟨i_B, rfl⟩ := hBij_I.2 i_Y
          have h_map_iB : Λ Q₁ m
              ((CategoryTheory.Abelian.Ext.mk₀ (pf.map π₀)).postcomp Z_B (Nat.add_zero m) i_B) =
              Λ Q₁ m c_B := by
            rw [hΛ_nat π₀ m i_B]
            exact hi_Y
          have hc_eq : i_B.comp (CategoryTheory.Abelian.Ext.mk₀ (E₀.map pf).g)
              (Nat.add_zero m) = c_B :=
            hBij_Q.1 h_map_iB
          rw [← hc_eq, CategoryTheory.Abelian.Ext.comp_assoc i_B
            (CategoryTheory.Abelian.Ext.mk₀ (E₀.map pf).g) hSE_B.extClass
            (Nat.add_zero m) (Nat.zero_add 1) rfl,
            CategoryTheory.ShortComplex.ShortExact.comp_extClass hSE_B,
            CategoryTheory.Abelian.Ext.comp_zero]
        · intro y
          have hy_I : y.comp (CategoryTheory.Abelian.Ext.mk₀ E₀.f) (Nat.add_zero (m + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨c_Y, rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z_Y hE₀ y hy_I rfl
          obtain ⟨c_B, hc_B⟩ := hBij_Q.2 c_Y
          refine ⟨c_B.comp hSE_B.extClass rfl, ?_⟩
          rw [hΛ_extClass hE₀ hSE_B m c_B, hc_B]
    exact ⟨Λ, @hΛ_nat, hΛ_bij0, fun K hPK m => hΛ_bij_P m K hPK⟩

  
  
  
  have hSiteAcyclic :
      ∀ (C_Y C_B : Type (u + 1))
        [CategoryTheory.Category.{u, u + 1} C_Y]
        [CategoryTheory.Category.{u, u + 1} C_B]
        (J_Y : CategoryTheory.GrothendieckTopology C_Y)
        (J_B : CategoryTheory.GrothendieckTopology C_B)
        [CategoryTheory.HasWeakSheafify J_Y AddCommGrpCat.{u}]
        [CategoryTheory.HasSheafify J_Y AddCommGrpCat.{u}]
        [CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})]
        [CategoryTheory.HasWeakSheafify J_B AddCommGrpCat.{u}]
        [CategoryTheory.HasSheafify J_B AddCommGrpCat.{u}]
        (B_f : C_B ⥤ C_Y)
        [hc_f : B_f.IsContinuous J_B J_Y]
        [hr_f : (B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_B J_Y).IsRightAdjoint],
        let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_B J_Y
        let R_f : ℕ → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} →
            CategoryTheory.Sheaf J_B AddCommGrpCat.{u} :=
          fun q F => (CategoryTheory.presheafToSheaf J_B AddCommGrpCat.{u}).obj
            (B_f.op ⋙ F.cohomologyPresheaf q)
        let P : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} → Prop :=
          fun K => ∀ k_deg : ℕ, 1 ≤ k_deg → CategoryTheory.Limits.IsZero (R_f k_deg K)
        (∀ (I : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
            [CategoryTheory.Injective I], P I) ∧
        (∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})},
          SC.ShortExact → P SC.X₁ → ∀ [CategoryTheory.Injective SC.X₂],
            (SC.map pf_f).ShortExact ∧ P SC.X₃) := by
    clear hAbelianEngine hLim_pb hAdd_pb hr_π hc_π π B Y
    intro C_Y C_B _ _ J_Y J_B _ _ _ _ _ B_f _ _
    dsimp only
    let 𝒜_Y := CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_B J_Y
    let Sh_B := CategoryTheory.presheafToSheaf J_B AddCommGrpCat.{u}
    let U_B := CategoryTheory.sheafToPresheaf J_B AddCommGrpCat.{u}
    let adj_ShB := CategoryTheory.sheafificationAdjunction J_B AddCommGrpCat.{u}
    let F_free := (CategoryTheory.Functor.whiskeringRight (Opposite C_Y) (Type u)
      AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Sh_Y := CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
    let U_Y := CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}
    let Z_Y : C_Y ⥤ 𝒜_Y := CategoryTheory.yoneda.comp (F_free.comp Sh_Y)
    let adj_free := AddCommGrpCat.adj.whiskerRight (Opposite C_Y)
    let adj_tot := adj_free.comp (CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u})

    have hP_inj : ∀ (I : 𝒜_Y) [CategoryTheory.Injective I] (k_deg : ℕ), 1 ≤ k_deg →
        CategoryTheory.Limits.IsZero (Sh_B.obj (B_f.op ⋙ I.cohomologyPresheaf k_deg)) := by
      intro I _ k_deg hk
      obtain ⟨n, rfl⟩ : ∃ n : ℕ, k_deg = n + 1 := ⟨k_deg - 1, (Nat.sub_add_cancel hk).symm⟩
      have hid_pre : 𝟙 (B_f.op ⋙ I.cohomologyPresheaf (n + 1)) = 0 := by
        ext W x
        exact @Subsingleton.elim _
          (CategoryTheory.Abelian.Ext.subsingleton_of_injective (Z_Y.obj (B_f.obj W.unop)) I n) _ _
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← Sh_B.map_id, hid_pre,
        CategoryTheory.Functor.map_zero]

    let evHom : ∀ (U : C_Y) (G : 𝒜_Y), (Z_Y.obj U ⟶ G) ≃ ↑(G.obj.obj (Opposite.op U)) :=
      fun U G => (adj_tot.homEquiv (CategoryTheory.yoneda.obj U) G).trans CategoryTheory.yonedaEquiv
    let g₀ : ∀ (U : C_Y), ↑((Z_Y.obj U).obj.obj (Opposite.op U)) :=
      fun U => ((adj_tot.unit.app (CategoryTheory.yoneda.obj U)).app (Opposite.op U)) (𝟙 U)
    have hevHom_apply : ∀ (U : C_Y) (G : 𝒜_Y) (f : Z_Y.obj U ⟶ G),
        evHom U G f = (f.hom.app (Opposite.op U)).hom (g₀ U) := by
      intro U G f
      dsimp [evHom, g₀]
      rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    have hevHom_add : ∀ (U : C_Y) (G : 𝒜_Y) (f₁ f₂ : Z_Y.obj U ⟶ G),
        evHom U G (f₁ + f₂) = evHom U G f₁ + evHom U G f₂ := by
      intro U G f₁ f₂
      rw [hevHom_apply, hevHom_apply, hevHom_apply]
      have hadd : (f₁ + f₂).hom = f₁.hom + f₂.hom := U_Y.map_add
      rw [hadd]
      rfl
    have hevHom_nat_G : ∀ (U : C_Y) {G₁ G₂ : 𝒜_Y} (f : Z_Y.obj U ⟶ G₁) (φ : G₁ ⟶ G₂),
        evHom U G₂ (f ≫ φ) = (φ.hom.app (Opposite.op U)).hom (evHom U G₁ f) := by
      intro U G₁ G₂ f φ
      rw [hevHom_apply, hevHom_apply]
      rfl
    have hevHom_nat_U : ∀ {U₁ U₂ : C_Y} (v : U₁ ⟶ U₂) (G : 𝒜_Y) (f : Z_Y.obj U₂ ⟶ G),
        evHom U₁ G (Z_Y.map v ≫ f) = (G.obj.map v.op).hom (evHom U₂ G f) := by
      intro U₁ U₂ v G f
      dsimp [evHom]
      have hleft : adj_tot.homEquiv (CategoryTheory.yoneda.obj U₁) G
            ((F_free.comp Sh_Y).map (CategoryTheory.yoneda.map v) ≫ f) =
          CategoryTheory.yoneda.map v ≫ adj_tot.homEquiv (CategoryTheory.yoneda.obj U₂) G f :=
        adj_tot.homEquiv_naturality_left (CategoryTheory.yoneda.map v) f
      change CategoryTheory.yonedaEquiv
          (adj_tot.homEquiv (CategoryTheory.yoneda.obj U₁) G
            ((F_free.comp Sh_Y).map (CategoryTheory.yoneda.map v) ≫ f)) = _
      rw [hleft, ← CategoryTheory.yonedaEquiv_naturality]
      rfl

    let e0 : ∀ (U : C_Y) (G : 𝒜_Y),
        CategoryTheory.Abelian.Ext (Z_Y.obj U) G 0 ≃+ ↑(G.obj.obj (Opposite.op U)) :=
      fun U G => CategoryTheory.Abelian.Ext.addEquiv₀.trans
        { toEquiv := evHom U G
          map_add' := hevHom_add U G }
    have he0_symm_nat : ∀ {U₁ U₂ : C_Y} (v : U₁ ⟶ U₂) (G : 𝒜_Y)
        (s : ↑(G.obj.obj (Opposite.op U₂))),
        (e0 U₁ G).symm ((G.obj.map v.op).hom s) =
          (CategoryTheory.Abelian.Ext.mk₀ (Z_Y.map v)).comp ((e0 U₂ G).symm s) (Nat.zero_add 0) := by
      intro U₁ U₂ v G s
      apply (e0 U₁ G).injective
      rw [(e0 U₁ G).apply_symm_apply]
      obtain ⟨x₂, rfl⟩ : ∃ x₂, e0 U₂ G x₂ = s := ⟨(e0 U₂ G).symm s, (e0 U₂ G).apply_symm_apply s⟩
      rw [(e0 U₂ G).symm_apply_apply]
      have hcomp0 : CategoryTheory.Abelian.Ext.addEquiv₀
          ((CategoryTheory.Abelian.Ext.mk₀ (Z_Y.map v)).comp x₂ (Nat.zero_add 0)) =
          Z_Y.map v ≫ CategoryTheory.Abelian.Ext.addEquiv₀ x₂ := by
        have hx₂_mk : x₂ = CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ x₂) :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x₂).symm
        conv_lhs => rw [hx₂_mk]
        rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      change (G.obj.map v.op).hom (evHom U₂ G (CategoryTheory.Abelian.Ext.addEquiv₀ x₂)) =
        evHom U₁ G (CategoryTheory.Abelian.Ext.addEquiv₀
          ((CategoryTheory.Abelian.Ext.mk₀ (Z_Y.map v)).comp x₂ (Nat.zero_add 0)))
      rw [hcomp0, hevHom_nat_U]

    refine ⟨fun I _ k hk => hP_inj I k hk, ?_⟩
    intro SC hSE hP₁ _
    have : CategoryTheory.Limits.PreservesFiniteLimits pf_f := ⟨fun _ _ _ => inferInstance⟩
    have : pf_f.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products pf_f
    refine ⟨?_, ?_⟩
    · obtain ⟨hEx_pf, hMono_pf⟩ :=
        (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_f).mp
          inferInstance SC hSE
      have hEpi_pf : CategoryTheory.Epi ((SC.map pf_f).g) := by
        apply CategoryTheory.Preadditive.epi_of_cancel_zero
        intro N τ hτ
        let d0_Y : SC.X₃.obj ⟶ SC.X₁.cohomologyPresheaf 1 :=
          { app := fun U => AddCommGrpCat.ofHom
              ((hSE.extClass.postcomp (Z_Y.obj U.unop) (Nat.zero_add 1)).comp
                (e0 U.unop SC.X₃).symm.toAddMonoidHom)
            naturality := fun {U₂ U₁} v => by
              rcases U₁ with ⟨U₁⟩
              rcases U₂ with ⟨U₂⟩
              apply AddCommGrpCat.ext
              intro s
              change ((e0 U₁ SC.X₃).symm ((SC.X₃.obj.map v.unop.op).hom s)).comp
                  hSE.extClass (Nat.zero_add 1) =
                (CategoryTheory.Abelian.Ext.mk₀ (Z_Y.map v.unop)).comp
                  (((e0 U₂ SC.X₃).symm s).comp hSE.extClass (Nat.zero_add 1))
                  (Nat.zero_add 1)
              rw [he0_symm_nat v.unop SC.X₃ s]
              exact CategoryTheory.Abelian.Ext.comp_assoc _ _ _
                (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1) }
        let d0_pre : U_B.obj (pf_f.obj SC.X₃) ⟶ (B_f.op ⋙ SC.X₁.cohomologyPresheaf 1) :=
          CategoryTheory.Functor.whiskerLeft B_f.op d0_Y
        have hd0_surj : ∀ (W : C_Bᵒᵖ), Function.Surjective (d0_pre.app W).hom := by
          intro W y
          let U := B_f.obj W.unop
          have hy_zero : (y : CategoryTheory.Abelian.Ext (Z_Y.obj U) SC.X₁ 1).comp
              (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 1) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨c, hc⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            (Z_Y.obj U) hSE y hy_zero (Nat.zero_add 1)
          refine ⟨e0 U SC.X₃ c, ?_⟩
          change ((e0 U SC.X₃).symm (e0 U SC.X₃ c)).comp hSE.extClass (Nat.zero_add 1) = y
          rw [(e0 U SC.X₃).symm_apply_apply]
          exact hc
        have hd0_ker : ∀ (W : C_Bᵒᵖ) (s : ↑((U_B.obj (pf_f.obj SC.X₃)).obj W)),
            (d0_pre.app W).hom s = 0 → (τ.hom.app W).hom s = 0 := by
          intro W s hs
          let U := B_f.obj W.unop
          have hs_ext : ((e0 U SC.X₃).symm s).comp hSE.extClass (Nat.zero_add 1) = 0 := hs
          obtain ⟨b, hb⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            (Z_Y.obj U) hSE ((e0 U SC.X₃).symm s) (Nat.zero_add 1) hs_ext
          have hs_im : s = (SC.g.hom.app (Opposite.op U)).hom (e0 U SC.X₂ b) := by
            have h1 : e0 U SC.X₃ (b.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero 0)) =
                e0 U SC.X₃ ((e0 U SC.X₃).symm s) := congrArg (e0 U SC.X₃) hb
            have h_inv : e0 U SC.X₃ ((e0 U SC.X₃).symm s) = s :=
              (e0 U SC.X₃).apply_symm_apply s
            rw [h_inv] at h1
            rw [← h1]
            have hb_mk : b = CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ b) :=
              (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply b).symm
            change evHom U SC.X₃ (CategoryTheory.Abelian.Ext.addEquiv₀
                (b.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero 0))) =
              (SC.g.hom.app (Opposite.op U)).hom
                (evHom U SC.X₂ (CategoryTheory.Abelian.Ext.addEquiv₀ b))
            have hcomp_g : CategoryTheory.Abelian.Ext.addEquiv₀
                (b.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero 0)) =
                CategoryTheory.Abelian.Ext.addEquiv₀ b ≫ SC.g := by
              conv_lhs => rw [hb_mk]
              rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
                ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
            rw [hcomp_g, hevHom_nat_G]
          rw [hs_im]
          have hτ_comp : (((SC.map pf_f).g ≫ τ).hom.app W).hom (e0 U SC.X₂ b) = 0 := by
            rw [hτ]
            rfl
          exact hτ_comp
        have hk_well : ∀ (W : C_Bᵒᵖ) (s₁ s₂ : ↑((U_B.obj (pf_f.obj SC.X₃)).obj W)),
            (d0_pre.app W).hom s₁ = (d0_pre.app W).hom s₂ →
            (τ.hom.app W).hom s₁ = (τ.hom.app W).hom s₂ := by
          intro W s₁ s₂ h12
          have hsub0 : (d0_pre.app W).hom (s₁ - s₂) = 0 := by
            rw [map_sub, h12, sub_self]
          have hτ_sub := hd0_ker W (s₁ - s₂) hsub0
          rw [map_sub, sub_eq_zero] at hτ_sub
          exact hτ_sub
        let k_bar : (B_f.op ⋙ SC.X₁.cohomologyPresheaf 1) ⟶ U_B.obj N :=
          { app := fun W => AddCommGrpCat.ofHom
              { toFun := fun y => (τ.hom.app W).hom (Classical.choose (hd0_surj W y))
                map_zero' := by
                  have h0 := hk_well W (Classical.choose (hd0_surj W 0)) 0
                    ((Classical.choose_spec (hd0_surj W 0)).trans (map_zero (d0_pre.app W).hom).symm)
                  exact h0.trans (map_zero (τ.hom.app W).hom)
                map_add' := fun y₁ y₂ => by
                  let s₁ := Classical.choose (hd0_surj W y₁)
                  let s₂ := Classical.choose (hd0_surj W y₂)
                  have h12 := hk_well W (Classical.choose (hd0_surj W (y₁ + y₂))) (s₁ + s₂)
                    ((Classical.choose_spec (hd0_surj W (y₁ + y₂))).trans
                      ((congrArg₂ (· + ·) (Classical.choose_spec (hd0_surj W y₁)).symm
                        (Classical.choose_spec (hd0_surj W y₂)).symm).trans
                        (map_add (d0_pre.app W).hom s₁ s₂).symm))
                  exact h12.trans (map_add (τ.hom.app W).hom s₁ s₂) }
            naturality := fun {W₁ W₂} u => by
              apply AddCommGrpCat.ext
              intro y
              let s₁ := Classical.choose (hd0_surj W₁ y)
              have hs₁ : (d0_pre.app W₁).hom s₁ = y := Classical.choose_spec (hd0_surj W₁ y)
              have hnat_d : (d0_pre.app W₂).hom (((U_B.obj (pf_f.obj SC.X₃)).map u).hom s₁) =
                  ((B_f.op ⋙ SC.X₁.cohomologyPresheaf 1).map u).hom y := by
                rw [← hs₁]
                exact congrArg (fun φ => φ.hom s₁) (d0_pre.naturality u)
              have h12 := hk_well W₂
                (Classical.choose (hd0_surj W₂ (((B_f.op ⋙ SC.X₁.cohomologyPresheaf 1).map u).hom y)))
                (((U_B.obj (pf_f.obj SC.X₃)).map u).hom s₁)
                ((Classical.choose_spec (hd0_surj W₂ _)).trans hnat_d.symm)
              change (τ.hom.app W₂).hom (Classical.choose (hd0_surj W₂ _)) =
                ((U_B.obj N).map u).hom ((τ.hom.app W₁).hom s₁)
