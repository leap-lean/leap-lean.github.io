          ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 2) (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hπι,
          CategoryTheory.Abelian.Ext.mk₀_id_comp] at h1
        exact h1
      exact (hΛ₀_bij 2 F_B (hR_zero a)).1 (hΛ_z.trans (map_zero (Λ₀ 2 F_B)).symm)

    let ι_prod : ∀ a : Fin m, pf_a a ⟶ Q_bdry := fun a =>
      CategoryTheory.Limits.Pi.lift (fun b =>
        if h : a = b then eqToHom (congrArg pf_a h) else 0)
    have hPartUnity : (∑ a : Fin m, CategoryTheory.Limits.Pi.π pf_a a ≫ ι_prod a) = 𝟙 Q_bdry := by
      apply CategoryTheory.Limits.Pi.hom_ext; intro b
      rw [CategoryTheory.Preadditive.sum_comp, CategoryTheory.Category.id_comp]
      have h_term : ∀ a : Fin m,
          (CategoryTheory.Limits.Pi.π pf_a a ≫ ι_prod a) ≫ CategoryTheory.Limits.Pi.π pf_a b =
            if h : a = b then CategoryTheory.Limits.Pi.π pf_a a ≫ eqToHom (congrArg pf_a h) else 0 := by
        intro a
        rw [CategoryTheory.Category.assoc, hPiLiftπ]
        split_ifs with h
        · rfl
        · rw [CategoryTheory.Limits.comp_zero]
      simp_rw [h_term]
      rw [Finset.sum_dite_eq' Finset.univ b]
      simp

    have hρ_sum : ρ = ∑ a : Fin m, (ρ_a a ≫ ι_prod a) := by
      calc
        ρ = ρ ≫ 𝟙 Q_bdry := (CategoryTheory.Category.comp_id ρ).symm
        _ = ρ ≫ ∑ a : Fin m, (CategoryTheory.Limits.Pi.π pf_a a ≫ ι_prod a) := by
              rw [hPartUnity]
        _ = ∑ a : Fin m, ρ ≫ (CategoryTheory.Limits.Pi.π pf_a a ≫ ι_prod a) := by
              rw [CategoryTheory.Preadditive.comp_sum]
        _ = ∑ a : Fin m, (ρ_a a ≫ ι_prod a) := by
              refine Finset.sum_congr rfl fun a _ => ?_
              rw [← CategoryTheory.Category.assoc, hPiLiftπ]

    have hρ_zero : α.comp (CategoryTheory.Abelian.Ext.mk₀ ρ) (Nat.add_zero 2) = 0 := by
      rw [hρ_sum]
      have hSumZero : ∀ s_fin : Finset (Fin m),
          α.comp (CategoryTheory.Abelian.Ext.mk₀ (∑ a ∈ s_fin, (ρ_a a ≫ ι_prod a)))
            (Nat.add_zero 2) = 0 := by
        intro s_fin
        induction s_fin using Finset.induction_on with
        | empty =>
          rw [Finset.sum_empty, CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero]
        | @insert a s_rest ha ih =>
          rw [Finset.sum_insert ha, CategoryTheory.Abelian.Ext.mk₀_add,
            CategoryTheory.Abelian.Ext.comp_add, ih, add_zero,
            ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 2) (Nat.zero_add 0)
              (by omega),
            hρ_a_zero a, CategoryTheory.Abelian.Ext.zero_comp]
      exact hSumZero Finset.univ

    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_Y hSE_bdry α hρ_zero

  exact hPart25 Y.left B.left ℓ m τ hτ_cl hτ_disj W_open hW hR_zero α hα_bdry

