theorem weil_two_step_torsion_injective_resolution_and_ext (n : ℕ) (hn : 1 ≤ n)
    (hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
    (hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f)).IsRightAdjoint)
    (hExact_pb : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f) (@hr_all X₁ X₂ f)
      pb.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb)
    (W : AlgebraicGeometry.Scheme.{u})
    (F : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
    (hTor : n • CategoryTheory.CategoryStruct.id F = 0) :
    ∃ (I_0 Q_1 I_1 Q_2 : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
      (i_0 : Quiver.Hom F I_0) (p_0 : Quiver.Hom I_0 Q_1)
      (h0_0 : CategoryTheory.CategoryStruct.comp i_0 p_0 = 0)
      (i_1 : Quiver.Hom Q_1 I_1) (p_1 : Quiver.Hom I_1 Q_2)
      (h0_1 : CategoryTheory.CategoryStruct.comp i_1 p_1 = 0),
      n • CategoryTheory.CategoryStruct.id I_0 = 0 ∧
      n • CategoryTheory.CategoryStruct.id Q_1 = 0 ∧
      n • CategoryTheory.CategoryStruct.id I_1 = 0 ∧
      n • CategoryTheory.CategoryStruct.id Q_2 = 0 ∧
      (CategoryTheory.ShortComplex.mk i_0 p_0 h0_0).ShortExact ∧
      (CategoryTheory.ShortComplex.mk i_1 p_1 h0_1).ShortExact ∧
      (∀ {A B_sh : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}}
          (ι : Quiver.Hom A B_sh) [CategoryTheory.Mono ι],
        n • CategoryTheory.CategoryStruct.id B_sh = 0 →
        (∀ α : Quiver.Hom A I_0, ∃ β : Quiver.Hom B_sh I_0,
          CategoryTheory.CategoryStruct.comp ι β = α) ∧
        (∀ α : Quiver.Hom A I_1, ∃ β : Quiver.Hom B_sh I_1,
          CategoryTheory.CategoryStruct.comp ι β = α)) ∧
      (∀ p : ℕ, 1 ≤ p → Subsingleton (I_0.H p) ∧ Subsingleton (I_1.H p)) ∧
      (∀ {Z : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom W Z),
        let pf_g := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback g) AddCommGrpCat.{u} _
          Z.smallEtaleTopology W.smallEtaleTopology (@hc_all W Z g)
        (∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g p I_0) ∧
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g p I_1) ∧
          Subsingleton ((pf_g.obj I_0).H p) ∧
          Subsingleton ((pf_g.obj I_1).H p)) ∧
        ∀ {B : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z B),
