                    (weilEtaleLocalTorsionMap E.Y_bar.left ℓ w_tilde₁))).postcomp
                  Fℤ_Vbar (Nat.add_zero p) y = 0 := by
          intro p hp y
          change y.comp (CategoryTheory.Abelian.Ext.mk₀
            (weilEtaleHigherDirectImageMap E.π_bar.left 2
              (weilEtaleLocalTorsionMap E.Y_bar.left ℓ w_tilde₁))) (Nat.add_zero p) = 0
          rw [hR2_eq, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
          have hmid :
              (y.comp (CategoryTheory.Abelian.Ext.mk₀ e_R2'.inv) (Nat.add_zero p)).comp
                (CategoryTheory.Abelian.Ext.mk₀
                  (weilEtaleLocalTorsionMap E.V_bar.left ℓ w₁)) (Nat.add_zero p) = 0 :=
            hEff_Vbar p hp (y.comp (CategoryTheory.Abelian.Ext.mk₀ e_R2'.inv) (Nat.add_zero p))
          rw [hmid, CategoryTheory.Abelian.Ext.zero_comp]

        have hWang :=
          weil_etale_curve_fibration_two_step_wang_vanishing E.Y_bar.left E.V_bar.left
            E.π_bar.left δ₀ ℓ
            (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W'₂)
            (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ W₂)
            (weilEtaleLocalTorsionSheaf E.Y_bar.left ℓ E.W₁)
            (weilEtaleLocalTorsionMap E.Y_bar.left ℓ w_tilde₁)
            (weilEtaleLocalTorsionMap E.Y_bar.left ℓ u₁_W)
            (hLocNsmulZero E.Y_bar.left ℓ W'₂)
            (hLocNsmulZero E.Y_bar.left ℓ W₂)
            (hLocNsmulZero E.Y_bar.left ℓ E.W₁)
            hR0_W'₂ hR0_W₂ hR0_W₁ hR3_all hR1_zero hR2_w_van
        have hEff_Ybar_ell :
            ∀ (q : ℕ), q < 2 * (δ₀ + 1) →
              ∀ z : weilEtaleLocalTorsionH E.Y_bar.left ℓ W'₂ q,
                weilEtaleLocalTorsionMapH E.Y_bar.left ℓ (w_tilde₁ ≫ u₁_W) q z = 0 := by
          intro q hq z
          change z.comp (CategoryTheory.Abelian.Ext.mk₀
            (weilEtaleLocalTorsionMap E.Y_bar.left ℓ (w_tilde₁ ≫ u₁_W))) (Nat.add_zero q) = 0
          rw [hLocMap_comp E.Y_bar.left ℓ w_tilde₁ u₁_W]
          exact hWang q hq z
        have hEff_Ybar_pow1 :
            ∀ (q : ℕ), q < 2 * (δ₀ + 1) →
              ∀ z : weilEtaleLocalTorsionH E.Y_bar.left (ℓ ^ 1) W'₂ q,
                weilEtaleLocalTorsionMapH E.Y_bar.left (ℓ ^ 1) (w_tilde₁ ≫ u₁_W) q z = 0 :=
          fun q hq => (hMapH_congr_mod (pow_one ℓ).symm (w_tilde₁ ≫ u₁_W) q).mp (hEff_Ybar_ell q hq)

        
        let Z₁_sch := (Fgt_Ybar.obj E.W₁).left
        let Z'_sch := (Fgt_Ybar.obj W'₂).left
        let g_Z : Z'_sch ⟶ Z₁_sch := (Fgt_Ybar.map (w_tilde₁ ≫ u₁_W)).left
        haveI : AlgebraicGeometry.IsAffine E.W₁_open.toScheme := E.hAff_W₁open
        have hAff_Z₁ : AlgebraicGeometry.IsAffine Z₁_sch :=
          AlgebraicGeometry.IsAffine.of_isIso E.e_W₁.hom
        haveI : AlgebraicGeometry.Etale E.j_W₁ := E.hEt_jW₁
        haveI : AlgebraicGeometry.Etale (Fgt_Pd1.obj U₀_m).hom := U₀_m.prop
        haveI : AlgebraicGeometry.Etale g_Z := hEt_of_etale_hom (w_tilde₁ ≫ u₁_W)
        let U_Z₁ : P_d1.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (E.j_W₁ ≫ (Fgt_Pd1.obj U₀_m).hom) inferInstance
        let j₁_Pd1 : U_Z₁ ⟶ U₀_m :=
          CategoryTheory.MorphismProperty.Over.homMk E.j_W₁ rfl trivial
        let U_Z' : P_d1.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤
            (g_Z ≫ E.j_W₁ ≫ (Fgt_Pd1.obj U₀_m).hom) inferInstance
        let v_Z_Pd1 : U_Z' ⟶ U_Z₁ :=
          CategoryTheory.MorphismProperty.Over.homMk g_Z rfl trivial
        have hU₀m_k : (Fgt_Pd1.obj U₀_m).hom ≫ P_d1.hom =
            u₀_m ≫ (weilAffineSpaceOver k (δ₀ + 1)).hom := by
          rw [← hu₀m_comm, CategoryTheory.Category.assoc, hιd1_hom]
        have hRoof_Z₁ : WeilIsAffineRoofIso k E.Y_bar P_d1 E.W₁ U_Z₁
            (CategoryTheory.Iso.refl Z₁_sch) := by
          refine ⟨E.hProp_Ybar, hProp_Pd1, hAff_Z₁, ?_⟩
          change 𝟙 Z₁_sch ≫ ((E.j_W₁ ≫ (Fgt_Pd1.obj U₀_m).hom) ≫ P_d1.hom) =
            (Fgt_Ybar.obj E.W₁).hom ≫ E.Y_bar.hom
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hU₀m_k, E.hComp_jW₁]
        have hRoof_Z' : WeilIsAffineRoofIso k E.Y_bar P_d1 W'₂ U_Z'
            (CategoryTheory.Iso.refl Z'_sch) := by
          refine ⟨E.hProp_Ybar, hProp_Pd1, hAff_W'₂, ?_⟩
          change 𝟙 Z'_sch ≫ ((g_Z ≫ E.j_W₁ ≫ (Fgt_Pd1.obj U₀_m).hom) ≫ P_d1.hom) =
            (Fgt_Ybar.obj W'₂).hom ≫ E.Y_bar.hom
          have hgZ_w : g_Z ≫ (Fgt_Ybar.obj E.W₁).hom = (Fgt_Ybar.obj W'₂).hom :=
            CategoryTheory.Over.w (Fgt_Ybar.map (w_tilde₁ ≫ u₁_W))
          rw [CategoryTheory.Category.id_comp, ← hgZ_w]
          calc
            (g_Z ≫ E.j_W₁ ≫ (Fgt_Pd1.obj U₀_m).hom) ≫ P_d1.hom
              = g_Z ≫ E.j_W₁ ≫ ((Fgt_Pd1.obj U₀_m).hom ≫ P_d1.hom) := by
                  simp [CategoryTheory.Category.assoc]
            _ = g_Z ≫ (E.j_W₁ ≫ (u₀_m ≫ (weilAffineSpaceOver k (δ₀ + 1)).hom)) := by
                  rw [hU₀m_k]
            _ = g_Z ≫ ((Fgt_Ybar.obj E.W₁).hom ≫ E.Y_bar.hom) := by rw [E.hComp_jW₁]
            _ = (g_Z ≫ (Fgt_Ybar.obj E.W₁).hom) ≫ E.Y_bar.hom := by
                  rw [CategoryTheory.Category.assoc]
        have hEff_Pd1_pow1 :
            ∀ (q : ℕ), q < 2 * (δ₀ + 1) →
              ∀ z : weilEtaleLocalTorsionH P_d1.left (ℓ ^ 1) U_Z' q,
                weilEtaleLocalTorsionMapH P_d1.left (ℓ ^ 1) v_Z_Pd1 q z = 0 := by
          intro q hq z
          let z_Y := (Ψ E.Y_bar P_d1 W'₂ U_Z' (CategoryTheory.Iso.refl Z'_sch) hRoof_Z' 1 q).symm z
          have hz_Y : Ψ E.Y_bar P_d1 W'₂ U_Z' (CategoryTheory.Iso.refl Z'_sch) hRoof_Z' 1 q z_Y = z :=
            AddEquiv.apply_symm_apply _ z
          have hcov := hΨ.2.2.1 E.Y_bar P_d1 W'₂ E.W₁ U_Z' U_Z₁ (w_tilde₁ ≫ u₁_W) v_Z_Pd1
            (CategoryTheory.Iso.refl Z'_sch) (CategoryTheory.Iso.refl Z₁_sch)
            hRoof_Z' hRoof_Z₁
            (by change 𝟙 Z'_sch ≫ g_Z = g_Z ≫ 𝟙 Z₁_sch; simp)
            1 q z_Y
          rw [hz_Y, hEff_Ybar_pow1 q hq z_Y, map_zero] at hcov
          exact hcov.symm
        have hEff_Pd1_ell :
            ∀ (q : ℕ), q < 2 * (δ₀ + 1) →
              ∀ z : weilEtaleLocalTorsionH P_d1.left ℓ U_Z' q,
                weilEtaleLocalTorsionMapH P_d1.left ℓ v_Z_Pd1 q z = 0 :=
          fun q hq => (hMapH_congr_mod (pow_one ℓ) v_Z_Pd1 q).mp (hEff_Pd1_pow1 q hq)
        refine ⟨U_Z', v_Z_Pd1 ≫ j₁_Pd1, x'₂, hAff_W'₂, hx'₂_cl, ?_, ?_⟩
        · change E.j_W₁.base (g_Z.base x'₂) = x₀_m
          have hgZ_pt : g_Z.base x'₂ = E.x₁ := by
            change ((Fgt_Ybar.map w_tilde₁).left ≫ (Fgt_Ybar.map u₁_W).left).base x'₂ = E.x₁
            change (Fgt_Ybar.map u₁_W).left.base ((Fgt_Ybar.map w_tilde₁).left.base x'₂) = E.x₁
            rw [hx'₂_map, hx₂_map]
          rw [hgZ_pt, E.hx₁_map]
        · intro q hq z
          rw [hLocMapH_comp P_d1.left ℓ v_Z_Pd1 j₁_Pd1 q z, hEff_Pd1_ell q hq z, map_zero]

      
      obtain ⟨hSub1, hBock⟩ := weil_etale_local_torsion_bockstein_exact P_d1.left ℓ
      have hModPowEff :
          ∀ (r_cur : ℕ)
            (U₀_m : P_d1.left.Etale)
            (u₀_m : (Fgt_Pd1.obj U₀_m).left ⟶ (weilAffineSpaceOver k (δ₀ + 1)).left)
            (x₀_m : ↥(Fgt_Pd1.obj U₀_m).left),
            IsClosed ({x₀_m} : Set ↥(Fgt_Pd1.obj U₀_m).left) →
            AlgebraicGeometry.IsAffine (Fgt_Pd1.obj U₀_m).left →
            AlgebraicGeometry.Etale u₀_m →
            u₀_m ≫ ι_aff (δ₀ + 1) = (Fgt_Pd1.obj U₀_m).hom →
            ∃ (U_eff : P_d1.left.Etale)
              (v_eff : U_eff ⟶ U₀_m)
              (x_eff : ↥(Fgt_Pd1.obj U_eff).left),
              AlgebraicGeometry.IsAffine (Fgt_Pd1.obj U_eff).left ∧
              IsClosed ({x_eff} : Set ↥(Fgt_Pd1.obj U_eff).left) ∧
              (Fgt_Pd1.map v_eff).left.base x_eff = x₀_m ∧
              ∀ (q : ℕ), q < 2 * (δ₀ + 1) →
                ∀ z : weilEtaleLocalTorsionH P_d1.left (ℓ ^ r_cur) U_eff q,
                  weilEtaleLocalTorsionMapH P_d1.left (ℓ ^ r_cur) v_eff q z = 0 := by
        intro r_cur
        induction r_cur with
        | zero =>
          intro U₀_m _ x₀_m hx₀_m hAff₀_m _ _
          refine ⟨U₀_m, 𝟙 U₀_m, x₀_m, hAff₀_m, hx₀_m, rfl, ?_⟩
          intro q _ z
          exact @Subsingleton.elim (weilEtaleLocalTorsionH P_d1.left 1 U₀_m q) (hSub1 U₀_m q) _ 0
        | succ r_cur ih_r =>
          intro U₀_m u₀_m x₀_m hx₀_m hAff₀_m hEt_u₀m hu₀m_comm
          obtain ⟨U_mid, v_mid, x_mid, hAff_mid, hx_mid_cl, hx_mid_map, hEff_mid⟩ :=
            hModPrimeEff U₀_m u₀_m x₀_m hx₀_m hAff₀_m hEt_u₀m hu₀m_comm
          haveI : AlgebraicGeometry.Etale (Fgt_Pd1.map v_mid).left := hEt_of_etale_hom v_mid
          haveI : AlgebraicGeometry.Etale u₀_m := hEt_u₀m
          let u_mid : (Fgt_Pd1.obj U_mid).left ⟶ (weilAffineSpaceOver k (δ₀ + 1)).left :=
            (Fgt_Pd1.map v_mid).left ≫ u₀_m
          have hEt_umid : AlgebraicGeometry.Etale u_mid := inferInstance
          have humid_comm : u_mid ≫ ι_aff (δ₀ + 1) = (Fgt_Pd1.obj U_mid).hom := by
            dsimp [u_mid]
            rw [CategoryTheory.Category.assoc, hu₀m_comm]
            exact CategoryTheory.MorphismProperty.Over.w v_mid
          obtain ⟨U_eff, v_top, x_eff, hAff_eff, hx_eff_cl, hx_eff_map, hEff_top⟩ :=
            ih_r U_mid u_mid x_mid hx_mid_cl hAff_mid hEt_umid humid_comm
          refine ⟨U_eff, v_top ≫ v_mid, x_eff, hAff_eff, hx_eff_cl, ?_, ?_⟩
          · change (Fgt_Pd1.map v_mid).left.base ((Fgt_Pd1.map v_top).left.base x_eff) = x₀_m
            rw [hx_eff_map, hx_mid_map]
          · intro q hq z
            obtain ⟨hTransNat, ι_bock, hBockNat, hBockEx⟩ := hBock r_cur q
            let y := weilEtaleLocalTorsionMapH P_d1.left (ℓ ^ (r_cur + 1)) v_top q z
            have hy_trans : weilEtaleLocalTorsionTransition P_d1.left ℓ r_cur U_mid q y = 0 := by
              rw [hTransNat v_top z]
              exact hEff_top q hq _
            obtain ⟨x_b, hx_b⟩ := hBockEx U_mid y hy_trans
            rw [hLocMapH_comp P_d1.left (ℓ ^ (r_cur + 1)) v_top v_mid q z]
            change weilEtaleLocalTorsionMapH P_d1.left (ℓ ^ (r_cur + 1)) v_mid q y = 0
            rw [← hx_b, hBockNat v_mid x_b, hEff_mid q hq x_b, map_zero]

      
      intro r₀ U₀_s u₀_s x₀_s hx₀_s hAff₀_s hEt_u₀s hu₀s_comm
      obtain ⟨U_eff, v_eff, x_eff, hAff_eff, hx_eff_cl, hx_eff_map, hEff_sub⟩ :=
        hModPowEff r₀ U₀_s u₀_s x₀_s hx₀_s hAff₀_s hEt_u₀s hu₀s_comm
      let W_eff := (Fgt_Pd1.obj U_eff).left
      haveI : AlgebraicGeometry.IsAffine W_eff := hAff_eff
      haveI : AlgebraicGeometry.Etale (Fgt_Pd1.map v_eff).left := hEt_of_etale_hom v_eff
      haveI : AlgebraicGeometry.Etale u₀_s := hEt_u₀s
      let u_eff : W_eff ⟶ (weilAffineSpaceOver k (δ₀ + 1)).left :=
        (Fgt_Pd1.map v_eff).left ≫ u₀_s
      haveI : AlgebraicGeometry.Etale u_eff := inferInstance
      have hueff_comm : u_eff ≫ ι_aff (δ₀ + 1) = (Fgt_Pd1.obj U_eff).hom := by
        dsimp [u_eff]
        rw [CategoryTheory.Category.assoc, hu₀s_comm]
        exact CategoryTheory.MorphismProperty.Over.w v_eff

      obtain ⟨E_top⟩ :=
        weil_algClosed_pointed_elementary_curve_fibration k ℓ hℓ δ₀ W_eff u_eff x_eff hx_eff_cl
      let Fgt_Vt := AlgebraicGeometry.Scheme.Etale.forget E_top.V_bar.left
      let Fgt_Yt := AlgebraicGeometry.Scheme.Etale.forget E_top.Y_bar.left
      let V_top : AlgebraicGeometry.Scheme.{u} := (Fgt_Vt.obj E_top.V₁).left
      let Z_top : AlgebraicGeometry.Scheme.{u} := (Fgt_Yt.obj E_top.W₁).left
      haveI : AlgebraicGeometry.IsProper E_top.f_bar₁ := E_top.hProp_f₁
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 E_top.f_bar₁ := E_top.hSm_f₁
      let h_sm : E_top.W₁_open.toScheme ⟶ V_top := E_top.W₁_open.ι ≫ E_top.f_bar₁
      have hSm_hsm : AlgebraicGeometry.SmoothOfRelativeDimension 1 h_sm := by
        have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) h_sm := inferInstance
        rwa [Nat.zero_add] at h01
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 h_sm := hSm_hsm
      let y_top : ↥E_top.W₁_open.toScheme := E_top.e_W₁.hom.base E_top.x₁
      have hy_top_fib : h_sm.base y_top = E_top.v₁ := E_top.hx₁_fib

      obtain ⟨V''₀, hAff_V''₀, U''₀, hAff_U''₀, hy_U''₀, he_maps, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 h_sm).mp hSm_hsm y_top
      obtain ⟨ψ_rel, hψ_rel_comp, hψ_rel_et⟩ := hStd.exists_etale_mvPolynomial
      have hv₁_V''₀ : E_top.v₁ ∈ V''₀ := by
        rw [← hy_top_fib]
        exact he_maps hy_U''₀

      let A_cat := V_top.presheaf.obj (Opposite.op V''₀)
      let R_cat := E_top.W₁_open.toScheme.presheaf.obj (Opposite.op U''₀)
      let f₀ : AlgebraicGeometry.Spec R_cat ⟶ AlgebraicGeometry.Spec A_cat :=
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.appLE h_sm V''₀ U''₀ he_maps)
      have hf₀_fromSpec : f₀ ≫ hAff_V''₀.fromSpec = hAff_U''₀.fromSpec ≫ h_sm :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec h_sm hAff_V''₀ hAff_U''₀ he_maps
      have hf₀_fac : f₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_rel) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
        dsimp [f₀]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext a
        exact (DFunLike.congr_fun hψ_rel_comp a).symm
      let g_et : AlgebraicGeometry.Spec R_cat ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) ↑A_cat)) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_rel)
      let p_poly : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) ↑A_cat)) ⟶
          AlgebraicGeometry.Spec A_cat :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
      have hEt_get : AlgebraicGeometry.Etale g_et :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_rel_et
      haveI : AlgebraicGeometry.Etale g_et := hEt_get
      have hFlat_ppoly : AlgebraicGeometry.Flat p_poly :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
          (RingHom.flat_algebraMap_iff.mpr inferInstance)
      haveI : AlgebraicGeometry.Flat p_poly := hFlat_ppoly
      have hLFP_ppoly : AlgebraicGeometry.LocallyOfFinitePresentation p_poly :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr
          (RingHom.finitePresentation_algebraMap.mpr inferInstance)
      haveI : AlgebraicGeometry.LocallyOfFinitePresentation p_poly := hLFP_ppoly
      have hf₀_fac_gp : f₀ = g_et ≫ p_poly := hf₀_fac
      have hFlat_f₀ : AlgebraicGeometry.Flat f₀ := by
        rw [hf₀_fac_gp]
        infer_instance
      haveI : AlgebraicGeometry.Flat f₀ := hFlat_f₀
      have hLFP_f₀ : AlgebraicGeometry.LocallyOfFinitePresentation f₀ := by
        rw [hf₀_fac_gp]
        infer_instance
      haveI : AlgebraicGeometry.LocallyOfFinitePresentation f₀ := hLFP_f₀

      
      let h_U''₀_Vtop : U''₀.toScheme ⟶ V_top := U''₀.ι ≫ h_sm
      have hSm_U''₀_Vtop : AlgebraicGeometry.SmoothOfRelativeDimension 1 h_U''₀_Vtop := by
        have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) h_U''₀_Vtop :=
          inferInstance
        rwa [Nat.zero_add] at h01
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 h_U''₀_Vtop := hSm_U''₀_Vtop
      have hFlat_LFP_U''₀_Vtop :
          AlgebraicGeometry.Flat h_U''₀_Vtop ∧
          AlgebraicGeometry.LocallyOfFinitePresentation h_U''₀_Vtop := by
        have hrange_U''₀ : Set.range U''₀.ι.base ⊆ Set.range hAff_U''₀.fromSpec.base := by
          rw [hAff_U''₀.range_fromSpec]
          rintro _ ⟨z, rfl⟩
          exact z.2
        let e_U_open : U''₀.toScheme ⟶ AlgebraicGeometry.Spec R_cat :=
          AlgebraicGeometry.IsOpenImmersion.lift hAff_U''₀.fromSpec U''₀.ι hrange_U''₀
        have he_U_fac : e_U_open ≫ hAff_U''₀.fromSpec = U''₀.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_U''₀.fromSpec U''₀.ι hrange_U''₀
        have hEt_fromU : AlgebraicGeometry.Etale hAff_U''₀.fromSpec := inferInstance
        have hEt_comp_U : AlgebraicGeometry.Etale (e_U_open ≫ hAff_U''₀.fromSpec) := by
          rw [he_U_fac]
          infer_instance
        haveI : AlgebraicGeometry.Etale e_U_open :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
            e_U_open hAff_U''₀.fromSpec hEt_fromU hEt_comp_U
        have hfac_flat : h_U''₀_Vtop = e_U_open ≫ f₀ ≫ hAff_V''₀.fromSpec :=
          (congrArg (· ≫ h_sm) he_U_fac.symm).trans
            ((CategoryTheory.Category.assoc e_U_open hAff_U''₀.fromSpec h_sm).trans
              (congrArg (e_U_open ≫ ·) hf₀_fromSpec.symm))
        rw [hfac_flat]
        exact ⟨inferInstance, inferInstance⟩
      haveI : AlgebraicGeometry.Flat h_U''₀_Vtop := hFlat_LFP_U''₀_Vtop.1
      haveI : AlgebraicGeometry.LocallyOfFinitePresentation h_U''₀_Vtop := hFlat_LFP_U''₀_Vtop.2
      haveI : AlgebraicGeometry.UniversallyOpen h_U''₀_Vtop :=
        AlgebraicGeometry.UniversallyOpen.of_flat h_U''₀_Vtop
      let O_im : V_top.Opens :=
        ⟨Set.range h_U''₀_Vtop.base, h_U''₀_Vtop.isOpenMap.isOpen_range⟩
      have hv₁_Oim : E_top.v₁ ∈ O_im :=
        ⟨⟨y_top, hy_U''₀⟩, hy_top_fib⟩
      obtain ⟨V'', hAff_V'', hv₁_V'', hV''_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := E_top.v₁) (U := V''₀ ⊓ O_im)
          ⟨hv₁_V''₀, hv₁_Oim⟩
      have hV''_le₀ : V'' ≤ V''₀ := fun z hz => (hV''_sub hz).1
      have hV''_im : (V'' : Set ↥V_top) ⊆ Set.range h_U''₀_Vtop.base :=
        fun z hz => (hV''_sub hz).2

      
      haveI : AlgebraicGeometry.IsAffine V''.toScheme := hAff_V''
