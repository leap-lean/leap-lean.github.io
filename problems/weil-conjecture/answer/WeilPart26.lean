  let W_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_Y.obj W).left
  let p_W : W_sch ⟶ Y_bar.left := (Fgt_Y.obj W).hom
  let fst_YV : Y_V ⟶ V_sch := CategoryTheory.Limits.pullback.fst p_V π_bar.left
  let snd_YV : Y_V ⟶ Y_bar.left := CategoryTheory.Limits.pullback.snd p_V π_bar.left
  let j_W : W_sch ⟶ Y_V := (Fgt_YV.obj W_diag).hom
  have hj_fst : j_W ≫ fst_YV = f_W :=
    CategoryTheory.Limits.pullback.lift_fst f_W p_W hComm_W
  have hj_snd : j_W ≫ snd_YV = p_W :=
    CategoryTheory.Limits.pullback.lift_snd f_W p_W hComm_W
  have hι_fst : ∀ i : Fin r, ι_z_i i ≫ fst_YV = snd_b ≫ s_z i :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hι_snd : ∀ i : Fin r, ι_z_i i ≫ snd_YV = fst_b :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  let U_target : Y_b.Etale := (weilEtaleSitePullback fst_b).obj W
  let U_src : Fin r → Y_b.Etale := fun i => (weilEtaleSitePullback (ι_z_i i)).obj W_diag
  let Ut_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_Yb.obj U_target).left
  let Us_sch : Fin r → AlgebraicGeometry.Scheme.{u} := fun i => (Fgt_Yb.obj (U_src i)).left
  let p₁ : Ut_sch ⟶ W_sch := CategoryTheory.Limits.pullback.fst p_W fst_b
  let p₂ : Ut_sch ⟶ Y_b := CategoryTheory.Limits.pullback.snd p_W fst_b
  have hp_cond : p₁ ≫ p_W = p₂ ≫ fst_b :=
    CategoryTheory.Limits.pullback.condition (f := p_W) (g := fst_b)
  let q₁ : ∀ i : Fin r, Us_sch i ⟶ W_sch :=
    fun i => CategoryTheory.Limits.pullback.fst j_W (ι_z_i i)
  let q₂ : ∀ i : Fin r, Us_sch i ⟶ Y_b :=
    fun i => CategoryTheory.Limits.pullback.snd j_W (ι_z_i i)
  have hq_cond : ∀ i : Fin r, q₁ i ≫ j_W = q₂ i ≫ ι_z_i i :=
    fun i => CategoryTheory.Limits.pullback.condition (f := j_W) (g := ι_z_i i)
  have hcomm_πVb : (p₁ ≫ f_W) ≫ p_V = (p₂ ≫ snd_b) ≫ s_b := by
    calc
      (p₁ ≫ f_W) ≫ p_V
        = p₁ ≫ (f_W ≫ p_V) := CategoryTheory.Category.assoc p₁ f_W p_V
      _ = p₁ ≫ (p_W ≫ π_bar.left) := by rw [hComm_W]
      _ = (p₁ ≫ p_W) ≫ π_bar.left :=
          (CategoryTheory.Category.assoc p₁ p_W π_bar.left).symm
      _ = (p₂ ≫ fst_b) ≫ π_bar.left := by rw [hp_cond]
      _ = p₂ ≫ (fst_b ≫ π_bar.left) := CategoryTheory.Category.assoc p₂ fst_b π_bar.left
      _ = p₂ ≫ (snd_b ≫ s_b) := by
          rw [CategoryTheory.Limits.pullback.condition (f := π_bar.left) (g := s_b)]
      _ = (p₂ ≫ snd_b) ≫ s_b := (CategoryTheory.Category.assoc p₂ snd_b s_b).symm
  let π_Vb : Ut_sch ⟶ V_b :=
    CategoryTheory.Limits.pullback.lift (p₁ ≫ f_W) (p₂ ≫ snd_b) hcomm_πVb
  have hπVb_fst : π_Vb ≫ fst_Vb = p₁ ≫ f_W :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπVb_snd : π_Vb ≫ snd_Vb = p₂ ≫ snd_b :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hcomm_kW : ∀ i : Fin r, q₁ i ≫ p_W = q₂ i ≫ fst_b := by
    intro i
    calc
      q₁ i ≫ p_W
        = q₁ i ≫ (j_W ≫ snd_YV) := by rw [hj_snd]
      _ = (q₁ i ≫ j_W) ≫ snd_YV := (CategoryTheory.Category.assoc (q₁ i) j_W snd_YV).symm
      _ = (q₂ i ≫ ι_z_i i) ≫ snd_YV := by rw [hq_cond i]
      _ = q₂ i ≫ (ι_z_i i ≫ snd_YV) := CategoryTheory.Category.assoc (q₂ i) (ι_z_i i) snd_YV
      _ = q₂ i ≫ fst_b := by rw [hι_snd i]
  let k_W : ∀ i : Fin r, Us_sch i ⟶ Ut_sch :=
    fun i => CategoryTheory.Limits.pullback.lift (q₁ i) (q₂ i) (hcomm_kW i)
  have hkW_fst : ∀ i : Fin r, k_W i ≫ p₁ = q₁ i :=
    fun i => CategoryTheory.Limits.pullback.lift_fst (q₁ i) (q₂ i) (hcomm_kW i)
  have hkW_snd : ∀ i : Fin r, k_W i ≫ p₂ = q₂ i :=
    fun i => CategoryTheory.Limits.pullback.lift_snd (q₁ i) (q₂ i) (hcomm_kW i)
  let κ_W : ∀ i : Fin r, Quiver.Hom (U_src i) U_target :=
    fun i => CategoryTheory.MorphismProperty.Over.homMk (k_W i) (hkW_snd i) trivial

  have hPb_kW : ∀ i : Fin r,
      CategoryTheory.IsPullback (k_W i) (q₂ i ≫ snd_b) π_Vb ((Fgt_k.map (κ_V i)).left) := by
    intro i
    let κ_i : S_k ⟶ V_b := (Fgt_k.map (κ_V i)).left
    have hκ_fst : κ_i ≫ fst_Vb = s_z i := rfl
    have hκ_snd : κ_i ≫ snd_Vb = 𝟙 S_k :=
      CategoryTheory.MorphismProperty.Over.w (κ_V i)
    have hSq : k_W i ≫ π_Vb = (q₂ i ≫ snd_b) ≫ κ_i := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (k_W i ≫ π_Vb) ≫ fst_Vb = ((q₂ i ≫ snd_b) ≫ κ_i) ≫ fst_Vb
        calc
          (k_W i ≫ π_Vb) ≫ fst_Vb
            = k_W i ≫ (π_Vb ≫ fst_Vb) := CategoryTheory.Category.assoc (k_W i) π_Vb fst_Vb
          _ = k_W i ≫ (p₁ ≫ f_W) := by rw [hπVb_fst]
          _ = (k_W i ≫ p₁) ≫ f_W := (CategoryTheory.Category.assoc (k_W i) p₁ f_W).symm
          _ = q₁ i ≫ f_W := by rw [hkW_fst i]
          _ = q₁ i ≫ (j_W ≫ fst_YV) := by rw [hj_fst]
          _ = (q₁ i ≫ j_W) ≫ fst_YV := (CategoryTheory.Category.assoc (q₁ i) j_W fst_YV).symm
          _ = (q₂ i ≫ ι_z_i i) ≫ fst_YV := by rw [hq_cond i]
          _ = q₂ i ≫ (ι_z_i i ≫ fst_YV) := CategoryTheory.Category.assoc (q₂ i) (ι_z_i i) fst_YV
          _ = q₂ i ≫ (snd_b ≫ s_z i) := by rw [hι_fst i]
          _ = (q₂ i ≫ snd_b) ≫ (κ_i ≫ fst_Vb) := by
              rw [hκ_fst, CategoryTheory.Category.assoc]
          _ = ((q₂ i ≫ snd_b) ≫ κ_i) ≫ fst_Vb :=
              (CategoryTheory.Category.assoc (q₂ i ≫ snd_b) κ_i fst_Vb).symm
      · change (k_W i ≫ π_Vb) ≫ snd_Vb = ((q₂ i ≫ snd_b) ≫ κ_i) ≫ snd_Vb
        calc
          (k_W i ≫ π_Vb) ≫ snd_Vb
            = k_W i ≫ (π_Vb ≫ snd_Vb) := CategoryTheory.Category.assoc (k_W i) π_Vb snd_Vb
          _ = k_W i ≫ (p₂ ≫ snd_b) := by rw [hπVb_snd]
          _ = (k_W i ≫ p₂) ≫ snd_b := (CategoryTheory.Category.assoc (k_W i) p₂ snd_b).symm
          _ = q₂ i ≫ snd_b := by rw [hkW_snd i]
          _ = (q₂ i ≫ snd_b) ≫ 𝟙 S_k := (CategoryTheory.Category.comp_id _).symm
          _ = (q₂ i ≫ snd_b) ≫ (κ_i ≫ snd_Vb) := by rw [hκ_snd]
          _ = ((q₂ i ≫ snd_b) ≫ κ_i) ≫ snd_Vb :=
              (CategoryTheory.Category.assoc (q₂ i ≫ snd_b) κ_i snd_Vb).symm
    have hCone_snd :
        ∀ (s : CategoryTheory.Limits.PullbackCone π_Vb κ_i),
          s.fst ≫ (p₂ ≫ snd_b) = s.snd := by
      intro s
      have h1 : (s.fst ≫ π_Vb) ≫ snd_Vb = (s.snd ≫ κ_i) ≫ snd_Vb :=
        congrArg (· ≫ snd_Vb) s.condition
      rw [CategoryTheory.Category.assoc, hπVb_snd,
        CategoryTheory.Category.assoc, hκ_snd, CategoryTheory.Category.comp_id] at h1
      exact h1
    have hConeLiftComm :
        ∀ (s : CategoryTheory.Limits.PullbackCone π_Vb κ_i),
          (s.fst ≫ p₁) ≫ j_W = (s.fst ≫ p₂) ≫ ι_z_i i := by
      intro s
      have hs_snd : s.fst ≫ (p₂ ≫ snd_b) = s.snd := hCone_snd s
      have hs_fst : s.fst ≫ (p₁ ≫ f_W) = s.snd ≫ s_z i := by
        have h1 : (s.fst ≫ π_Vb) ≫ fst_Vb = (s.snd ≫ κ_i) ≫ fst_Vb :=
          congrArg (· ≫ fst_Vb) s.condition
        rw [CategoryTheory.Category.assoc, hπVb_fst,
          CategoryTheory.Category.assoc, hκ_fst] at h1
        exact h1
      apply CategoryTheory.Limits.pullback.hom_ext
      · change ((s.fst ≫ p₁) ≫ j_W) ≫ fst_YV = ((s.fst ≫ p₂) ≫ ι_z_i i) ≫ fst_YV
        calc
          ((s.fst ≫ p₁) ≫ j_W) ≫ fst_YV
            = (s.fst ≫ p₁) ≫ (j_W ≫ fst_YV) := CategoryTheory.Category.assoc _ _ _
          _ = s.fst ≫ (p₁ ≫ f_W) := by rw [hj_fst, CategoryTheory.Category.assoc]
          _ = s.snd ≫ s_z i := hs_fst
          _ = (s.fst ≫ (p₂ ≫ snd_b)) ≫ s_z i := by rw [hs_snd]
          _ = (s.fst ≫ p₂) ≫ (snd_b ≫ s_z i) := by
              simp only [CategoryTheory.Category.assoc]
          _ = (s.fst ≫ p₂) ≫ (ι_z_i i ≫ fst_YV) := by rw [hι_fst i]
          _ = ((s.fst ≫ p₂) ≫ ι_z_i i) ≫ fst_YV :=
              (CategoryTheory.Category.assoc _ _ _).symm
      · change ((s.fst ≫ p₁) ≫ j_W) ≫ snd_YV = ((s.fst ≫ p₂) ≫ ι_z_i i) ≫ snd_YV
        calc
          ((s.fst ≫ p₁) ≫ j_W) ≫ snd_YV
            = (s.fst ≫ p₁) ≫ (j_W ≫ snd_YV) := CategoryTheory.Category.assoc _ _ _
          _ = s.fst ≫ (p₁ ≫ p_W) := by rw [hj_snd, CategoryTheory.Category.assoc]
          _ = s.fst ≫ (p₂ ≫ fst_b) := by rw [hp_cond]
          _ = (s.fst ≫ p₂) ≫ (ι_z_i i ≫ snd_YV) := by
              rw [hι_snd i, CategoryTheory.Category.assoc]
          _ = ((s.fst ≫ p₂) ≫ ι_z_i i) ≫ snd_YV :=
              (CategoryTheory.Category.assoc _ _ _).symm
    let liftCone : ∀ (s : CategoryTheory.Limits.PullbackCone π_Vb κ_i), s.pt ⟶ Us_sch i :=
      fun s => CategoryTheory.Limits.pullback.lift (s.fst ≫ p₁) (s.fst ≫ p₂) (hConeLiftComm s)
    have hLift_q₁ : ∀ s, liftCone s ≫ q₁ i = s.fst ≫ p₁ :=
      fun s => CategoryTheory.Limits.pullback.lift_fst _ _ (hConeLiftComm s)
    have hLift_q₂ : ∀ s, liftCone s ≫ q₂ i = s.fst ≫ p₂ :=
      fun s => CategoryTheory.Limits.pullback.lift_snd _ _ (hConeLiftComm s)
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hSq liftCone
        (fun s => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (liftCone s ≫ k_W i) ≫ p₁ = s.fst ≫ p₁
            rw [CategoryTheory.Category.assoc, hkW_fst i, hLift_q₁ s]
          · change (liftCone s ≫ k_W i) ≫ p₂ = s.fst ≫ p₂
            rw [CategoryTheory.Category.assoc, hkW_snd i, hLift_q₂ s])
        (fun s => by
          calc
            liftCone s ≫ (q₂ i ≫ snd_b)
              = (liftCone s ≫ q₂ i) ≫ snd_b := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (s.fst ≫ p₂) ≫ snd_b := by rw [hLift_q₂ s]
            _ = s.fst ≫ (p₂ ≫ snd_b) := CategoryTheory.Category.assoc _ _ _
            _ = s.snd := hCone_snd s)
        (fun s m hm _ => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · change m ≫ q₁ i = liftCone s ≫ q₁ i
            calc
              m ≫ q₁ i = m ≫ (k_W i ≫ p₁) := by rw [hkW_fst i]
              _ = (m ≫ k_W i) ≫ p₁ := (CategoryTheory.Category.assoc m (k_W i) p₁).symm
              _ = s.fst ≫ p₁ := by rw [hm]
              _ = liftCone s ≫ q₁ i := (hLift_q₁ s).symm
          · change m ≫ q₂ i = liftCone s ≫ q₂ i
            calc
              m ≫ q₂ i = m ≫ (k_W i ≫ p₂) := by rw [hkW_snd i]
              _ = (m ≫ k_W i) ≫ p₂ := (CategoryTheory.Category.assoc m (k_W i) p₂).symm
              _ = s.fst ≫ p₂ := by rw [hm]
              _ = liftCone s ≫ q₂ i := (hLift_q₂ s).symm))

  have hOpen_κW : ∀ i : Fin r, AlgebraicGeometry.IsOpenImmersion (k_W i) :=
    fun i => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb_kW i).flip (hOpen_κV i)

  have hRange_kW : ∀ i : Fin r,
      Set.range (k_W i).base =
        π_Vb.base ⁻¹' Set.range (((Fgt_k.map (κ_V i)).left).base) := by
    intro i
    let κ_i : S_k ⟶ V_b := (Fgt_k.map (κ_V i)).left
    ext w
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨u, rfl⟩
      refine ⟨(q₂ i ≫ snd_b).base u, ?_⟩
      change κ_i.base ((q₂ i ≫ snd_b).base u) = (k_W i ≫ π_Vb).base u
      rw [(hPb_kW i).w]
      rfl
    · rintro ⟨pt, hpt⟩
      obtain ⟨z_pb, hz_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := π_Vb) (g := κ_i) w pt hpt.symm
      refine ⟨(hPb_kW i).isoPullback.inv.base z_pb, ?_⟩
      change ((hPb_kW i).isoPullback.inv ≫ k_W i).base z_pb = w
      rw [(hPb_kW i).isoPullback_inv_fst]
      exact hz_fst

  refine ⟨κ_W, hkW_fst, hOpen_κW, ?_, ?_⟩
  · intro i j hij
    change Disjoint (Set.range (k_W i).base) (Set.range (k_W j).base)
    rw [hRange_kW i, hRange_kW j]
    exact Disjoint.preimage π_Vb.base (hDisj_κV hij)
  · have hEq_iUnion :
        (⋃ i : Fin r,
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget Y_b).map (κ_W i)).left).base) =
        (⋃ i : Fin r, π_Vb.base ⁻¹' Set.range (((Fgt_k.map (κ_V i)).left).base)) :=
      Set.iUnion_congr hRange_kW
    rw [hEq_iUnion, ← Set.preimage_iUnion, hUniv_κV, Set.preimage_univ]

theorem weil_etale_clopen_disjoint_cover_localTorsion_biproduct (X : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
    (U : X.Etale) (r : ℕ)
    (U_part : Fin r → X.Etale)
    (κ : ∀ i : Fin r, Quiver.Hom (U_part i) U)
    (hOpen : ∀ i : Fin r,
      AlgebraicGeometry.IsOpenImmersion
        (((AlgebraicGeometry.Scheme.Etale.forget X).map (κ i)).left))
    (hDisj : _root_.Pairwise fun i j : Fin r =>
      Disjoint
        (Set.range (((AlgebraicGeometry.Scheme.Etale.forget X).map (κ i)).left).base)
        (Set.range (((AlgebraicGeometry.Scheme.Etale.forget X).map (κ j)).left).base))
    (hUniv :
      (⋃ i : Fin r,
        Set.range (((AlgebraicGeometry.Scheme.Etale.forget X).map (κ i)).left).base) =
          Set.univ) :
    ∃ (π_part : ∀ i : Fin r,
        Quiver.Hom
          (weilEtaleLocalTorsionSheaf X m U)
          (weilEtaleLocalTorsionSheaf X m (U_part i))),
      (∀ i : Fin r,
        CategoryTheory.CategoryStruct.comp
          (weilEtaleLocalTorsionMap X m (κ i)) (π_part i) =
        CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf X m (U_part i))) ∧
      (∀ i j : Fin r, i ≠ j →
        CategoryTheory.CategoryStruct.comp
          (weilEtaleLocalTorsionMap X m (κ i)) (π_part j) = 0) ∧
      ((∑ i : Fin r,
        CategoryTheory.CategoryStruct.comp
          (π_part i) (weilEtaleLocalTorsionMap X m (κ i))) =
        CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf X m U)) ∧
      (∀ (V : X.Etale),
        Function.Bijective
          (fun f : (∀ i : Fin r,
              ↥((weilEtaleLocalTorsionSheaf X m (U_part i)).obj.obj (Opposite.op V))) =>
            ∑ i : Fin r,
              (((weilEtaleLocalTorsionMap X m (κ i)).hom.app (Opposite.op V)).hom (f i)))) ∧
      (∀ (q : ℕ),
        let Fℤ := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        Function.Bijective
          (fun z : weilEtaleLocalTorsionH X m U q =>
            fun i : Fin r =>
              (CategoryTheory.Abelian.Ext.mk₀ (π_part i)).postcomp Fℤ (Nat.add_zero q) z)) :=
by
  classical
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
  let J := X.smallEtaleTopology
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let K_et : CategoryTheory.Pretopology X.Etale :=
    AlgebraicGeometry.Scheme.smallPretopology (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) (S := X)
  have hJ_eq : J = K_et.toGrothendieck :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X
      (le_refl (@AlgebraicGeometry.Etale))

  
  have hSecResBij :
      ∀ (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        Function.Bijective
          (fun t : ↥(ℱ.obj.obj (Opposite.op U)) =>
            fun i : Fin r => (ℱ.obj.map (Opposite.op (κ i))).hom t) := by
    intro ℱ
    let P_set : X.Etaleᵒᵖ ⥤ Type u := ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hPresieve : CategoryTheory.Presieve.IsSheaf J P_set :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J P_set).mp
        ((CategoryTheory.sheafCompose J (CategoryTheory.forget AddCommGrpCat.{u})).obj ℱ).property
    have hCoverArrows :
        ∀ {ι : Type u} (W : X.Etale) (Y_cov : ι → X.Etale) (π_cov : ∀ a : ι, Y_cov a ⟶ W),
          (∀ w : ↥(Fgt.obj W).left, ∃ a : ι, w ∈ Set.range ((Fgt.map (π_cov a)).left).base) →
          (∀ a : ι, AlgebraicGeometry.Etale ((Fgt.map (π_cov a)).left)) →
          ∀ (x : ∀ a : ι, P_set.obj (Opposite.op (Y_cov a))),
            CategoryTheory.Presieve.Arrows.Compatible P_set π_cov x →
            ∃! t : P_set.obj (Opposite.op W),
              ∀ a : ι, (CategoryTheory.ConcreteCategory.hom (P_set.map (π_cov a).op)) t = x a := by
      intro ι W Y_cov π_cov hSurj_cov hEt_cov
      have hMemK : CategoryTheory.Presieve.ofArrows Y_cov π_cov ∈ K_et.coverings W := by
        change CategoryTheory.Presieve.map (CategoryTheory.Over.forget X)
            (CategoryTheory.Presieve.map Fgt (CategoryTheory.Presieve.ofArrows Y_cov π_cov)) ∈
          (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)).coverings ((Fgt.obj W).left)
        rw [CategoryTheory.Presieve.map_ofArrows, CategoryTheory.Presieve.map_ofArrows]
        exact (AlgebraicGeometry.Scheme.ofArrows_mem_precoverage_iff (@AlgebraicGeometry.Etale)).mpr
          ⟨hSurj_cov, hEt_cov⟩
      have hMemJ : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y_cov π_cov) ∈ J W := by
        rw [hJ_eq, CategoryTheory.Pretopology.mem_toGrothendieck]
        exact ⟨CategoryTheory.Presieve.ofArrows Y_cov π_cov, hMemK, CategoryTheory.Sieve.le_generate _⟩
      exact (CategoryTheory.Presieve.isSheafFor_arrows_iff P_set π_cov).mp
        ((CategoryTheory.Presieve.isSheafFor_iff_generate
          (CategoryTheory.Presieve.ofArrows Y_cov π_cov)).mpr
          (hPresieve _ hMemJ))
    have hEmptySub :
        ∀ (Z : X.Etale), IsEmpty ↥(Fgt.obj Z).left →
          ∀ (x₁ x₂ : P_set.obj (Opposite.op Z)), x₁ = x₂ := by
      intro Z hEmp x₁ x₂
      have hExU := hCoverArrows Z (fun a : PEmpty.{u + 1} => PEmpty.elim a)
        (fun a : PEmpty.{u + 1} => PEmpty.elim a)
        (fun z => hEmp.elim z)
        (fun a => PEmpty.elim a)
        (fun a => PEmpty.elim a)
        (fun a => PEmpty.elim a)
      exact hExU.unique (fun a => PEmpty.elim a) (fun a => PEmpty.elim a)
    let U_u : ULift.{u} (Fin r) → X.Etale := fun a => U_part a.down
    let κ_u : ∀ a : ULift.{u} (Fin r), U_u a ⟶ U := fun a => κ a.down
    have hSurj_u : ∀ w : ↥(Fgt.obj U).left,
        ∃ a : ULift.{u} (Fin r), w ∈ Set.range ((Fgt.map (κ_u a)).left).base := by
      intro w
      have hw : w ∈ (Set.univ : Set ↥(Fgt.obj U).left) := Set.mem_univ w
      rw [← hUniv, Set.mem_iUnion] at hw
      rcases hw with ⟨i, hi⟩
      exact ⟨ULift.up i, hi⟩
    have hEt_u : ∀ a : ULift.{u} (Fin r),
        AlgebraicGeometry.Etale ((Fgt.map (κ_u a)).left) := by
      intro a
      have : AlgebraicGeometry.IsOpenImmersion ((Fgt.map (κ a.down)).left) := hOpen a.down
      change AlgebraicGeometry.Etale ((Fgt.map (κ a.down)).left)
      infer_instance
    rw [Function.bijective_iff_existsUnique]
    intro s
    have hCompat :
        CategoryTheory.Presieve.Arrows.Compatible P_set κ_u (fun a => s a.down) := by
      intro a b Z g_a g_b hcomm
      by_cases hab : a.down = b.down
      · have hab_u : a = b := ULift.ext _ _ hab
        subst hab_u
        have hleft_comm :
            (Fgt.map g_a).left ≫ (Fgt.map (κ a.down)).left =
              (Fgt.map g_b).left ≫ (Fgt.map (κ a.down)).left := by
          have hmap := congrArg (fun k => (Fgt.map k).left) hcomm
          simpa only [Functor.map_comp, CategoryTheory.Over.comp_left] using hmap
        have : AlgebraicGeometry.IsOpenImmersion ((Fgt.map (κ a.down)).left) := hOpen a.down
        have hleft_eq : (Fgt.map g_a).left = (Fgt.map g_b).left :=
          (cancel_mono ((Fgt.map (κ a.down)).left)).mp hleft_comm
        have hg_eq : g_a = g_b := CategoryTheory.MorphismProperty.Over.Hom.ext hleft_eq
        rw [hg_eq]
      · have hEmpZ : IsEmpty ↥(Fgt.obj Z).left := by
          refine ⟨fun z₀ => ?_⟩
          have hpt :
              (((Fgt.map g_a).left ≫ (Fgt.map (κ a.down)).left).base z₀) =
                (((Fgt.map g_b).left ≫ (Fgt.map (κ b.down)).left).base z₀) := by
            have hmap := congrArg (fun k => ((Fgt.map k).left).base z₀) hcomm
            simpa only [Functor.map_comp, CategoryTheory.Over.comp_left] using hmap
          have hmem_a :
              ((Fgt.map (κ a.down)).left).base (((Fgt.map g_a).left).base z₀) ∈
                Set.range ((Fgt.map (κ a.down)).left).base :=
            ⟨((Fgt.map g_a).left).base z₀, rfl⟩
          have hmem_b :
              ((Fgt.map (κ a.down)).left).base (((Fgt.map g_a).left).base z₀) ∈
                Set.range ((Fgt.map (κ b.down)).left).base := by
            have heq_pt :
                ((Fgt.map (κ a.down)).left).base (((Fgt.map g_a).left).base z₀) =
                  ((Fgt.map (κ b.down)).left).base (((Fgt.map g_b).left).base z₀) := by
              simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using hpt
            rw [heq_pt]
            exact ⟨((Fgt.map g_b).left).base z₀, rfl⟩
          exact Set.disjoint_iff.mp (hDisj hab) ⟨hmem_a, hmem_b⟩
        exact hEmptySub Z hEmpZ _ _
    obtain ⟨t, ht, huniq⟩ := hCoverArrows U U_u κ_u hSurj_u hEt_u (fun a => s a.down) hCompat
    refine ⟨t, ?_, ?_⟩
    · funext i
      exact ht (ULift.up i)
    · intro t' ht'
      apply huniq t'
      intro a
      exact congrFun ht' a.down

  
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let L_U := weilEtaleLocalTorsionSheaf X m U
  let L_part := fun i : Fin r => weilEtaleLocalTorsionSheaf X m (U_part i)
  let ι := fun i : Fin r => weilEtaleLocalTorsionMap X m (κ i)

  have hFreePost :
      ∀ {W : X.Etale} {ℱ 𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (β : Quiver.Hom (weilEtaleLocalTorsionSheaf X m W) ℱ)
        (g : Quiver.Hom ℱ 𝒢),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.comp β g) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Sheaf.freeYonedaHomEquiv β)
            (g.hom.app (Opposite.op W)) := by
    intro W ℱ 𝒢 β g
    change CategoryTheory.Presheaf.freeYonedaHomEquiv
        (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv
          (CategoryTheory.Presheaf.freeYoneda W AM) 𝒢) (β ≫ g)) = _
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right
      (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}) β g]
    exact CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ g.hom

  have hFreeEval :
      ∀ {W : X.Etale} {ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (γ : Quiver.Hom (weilEtaleLocalTorsionSheaf X m W) ℱ),
        CategoryTheory.Sheaf.freeYonedaHomEquiv γ =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf X m W)))
            (γ.hom.app (Opposite.op W)) := by
    intro W ℱ γ
    simpa only [CategoryTheory.Category.id_comp] using
      hFreePost (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf X m W)) γ

  have hPrecomp :
      ∀ {U₁ U₂ : X.Etale} (u : Quiver.Hom U₁ U₂)
        {ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (α : Quiver.Hom (weilEtaleLocalTorsionSheaf X m U₂) ℱ),
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.comp (weilEtaleLocalTorsionMap X m u) α) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv α)
          (ℱ.obj.map (Opposite.op u)) := by
    intro U₁ U₂ u ℱ α
    let η₂ := CategoryTheory.Sheaf.freeYonedaHomEquiv
      (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf X m U₂))
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.comp (weilEtaleLocalTorsionMap X m u) α)
        = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap X m u))
            (α.hom.app (Opposite.op U₁)) := hFreePost (weilEtaleLocalTorsionMap X m u) α
      _ = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp η₂
              ((weilEtaleLocalTorsionSheaf X m U₂).obj.map (Opposite.op u)))
            (α.hom.app (Opposite.op U₁)) := by
            dsimp [weilEtaleLocalTorsionMap, η₂]
            rw [Equiv.apply_symm_apply]
      _ = CategoryTheory.CategoryStruct.comp η₂
            (CategoryTheory.CategoryStruct.comp
              ((weilEtaleLocalTorsionSheaf X m U₂).obj.map (Opposite.op u))
              (α.hom.app (Opposite.op U₁))) :=
            CategoryTheory.Category.assoc _ _ _
      _ = CategoryTheory.CategoryStruct.comp η₂
            (CategoryTheory.CategoryStruct.comp
              (α.hom.app (Opposite.op U₂))
              (ℱ.obj.map (Opposite.op u))) := by
            rw [← α.hom.naturality (Opposite.op u)]
      _ = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp η₂ (α.hom.app (Opposite.op U₂)))
            (ℱ.obj.map (Opposite.op u)) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Sheaf.freeYonedaHomEquiv α)
            (ℱ.obj.map (Opposite.op u)) := by
            rw [← hFreeEval α]

  
  let resHom :
      ∀ (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        ↥(ℱ.obj.obj (Opposite.op U)) →+
          (∀ i : Fin r, ↥(ℱ.obj.obj (Opposite.op (U_part i)))) :=
    fun ℱ => AddMonoidHom.pi fun i => (ℱ.obj.map (Opposite.op (κ i))).hom
  let e_sec :
      ∀ (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        ↥(ℱ.obj.obj (Opposite.op U)) ≃+
          (∀ i : Fin r, ↥(ℱ.obj.obj (Opposite.op (U_part i)))) :=
    fun ℱ => AddEquiv.ofBijective (resHom ℱ) (hSecResBij ℱ)
  let glueRaw :
      ∀ (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        (∀ i : Fin r, Quiver.Hom (L_part i) ℱ) →
          Quiver.Hom AM (ℱ.obj.obj (Opposite.op U)) :=
    fun ℱ β =>
      AddCommGrpCat.ofHom
        ((e_sec ℱ).symm.toAddMonoidHom.comp
          (AddMonoidHom.pi fun i => (CategoryTheory.Sheaf.freeYonedaHomEquiv (β i)).hom))
  let glueHom :
      ∀ (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        (∀ i : Fin r, Quiver.Hom (L_part i) ℱ) → Quiver.Hom L_U ℱ :=
    fun ℱ β => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (glueRaw ℱ β)

  have hGlueComp :
      ∀ (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (β : ∀ i : Fin r, Quiver.Hom (L_part i) ℱ) (i : Fin r),
        CategoryTheory.CategoryStruct.comp (ι i) (glueHom ℱ β) = β i := by
    intro ℱ β i
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hPrecomp (κ i) (glueHom ℱ β)]
    have hsymm : CategoryTheory.Sheaf.freeYonedaHomEquiv (glueHom ℱ β) = glueRaw ℱ β :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (glueRaw ℱ β)
    rw [hsymm]
    ext a
    have hsec := (e_sec ℱ).apply_symm_apply
      (fun k : Fin r => (CategoryTheory.Sheaf.freeYonedaHomEquiv (β k)).hom a)
    exact congrFun hsec i

  have hHomExt :
      ∀ (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (α₁ α₂ : Quiver.Hom L_U ℱ),
        (∀ i : Fin r,
          CategoryTheory.CategoryStruct.comp (ι i) α₁ =
            CategoryTheory.CategoryStruct.comp (ι i) α₂) →
        α₁ = α₂ := by
    intro ℱ α₁ α₂ hEq
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    ext a
    apply (e_sec ℱ).injective
    funext i
    change ((CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Sheaf.freeYonedaHomEquiv α₁)
        (ℱ.obj.map (Opposite.op (κ i)))).hom) a =
      ((CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Sheaf.freeYonedaHomEquiv α₂)
        (ℱ.obj.map (Opposite.op (κ i)))).hom) a
    rw [← hPrecomp (κ i) α₁, ← hPrecomp (κ i) α₂, hEq i]

  let δ : ∀ (j i : Fin r), Quiver.Hom (L_part i) (L_part j) :=
    fun j i => if h : i = j then CategoryTheory.eqToHom (by rw [h]) else 0
  let π_part : ∀ j : Fin r, Quiver.Hom L_U (L_part j) :=
    fun j => glueHom (L_part j) (δ j)

  have hDiag :
      ∀ i : Fin r,
        CategoryTheory.CategoryStruct.comp (ι i) (π_part i) =
          CategoryTheory.CategoryStruct.id (L_part i) := by
    intro i
    dsimp [π_part]
    rw [hGlueComp (L_part i) (δ i) i]
    simp [δ]

  have hOff :
      ∀ i j : Fin r, i ≠ j →
        CategoryTheory.CategoryStruct.comp (ι i) (π_part j) = 0 := by
    intro i j hij
    dsimp [π_part]
    rw [hGlueComp (L_part j) (δ j) i]
    simp [δ, hij]

  have hSum :
      (∑ i : Fin r, CategoryTheory.CategoryStruct.comp (π_part i) (ι i)) =
        CategoryTheory.CategoryStruct.id L_U := by
    apply hHomExt L_U
    intro k
    rw [CategoryTheory.Preadditive.comp_sum, CategoryTheory.Category.comp_id]
    have hcongr :
        (∑ i : Fin r,
          CategoryTheory.CategoryStruct.comp (ι k)
            (CategoryTheory.CategoryStruct.comp (π_part i) (ι i))) =
        ∑ i : Fin r,
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (ι k) (π_part i)) (ι i) :=
      Finset.sum_congr rfl fun i _ => (CategoryTheory.Category.assoc _ _ _).symm
    rw [hcongr, Finset.sum_eq_single k]
    · rw [hDiag k, CategoryTheory.Category.id_comp]
    · intro i _ hik
      rw [hOff k i (Ne.symm hik), CategoryTheory.Limits.zero_comp]
    · intro hk_abs
      exact absurd (Finset.mem_univ k) hk_abs

  
  have hSecBij :
      ∀ (V : X.Etale),
        Function.Bijective
          (fun f : (∀ i : Fin r, ↥((L_part i).obj.obj (Opposite.op V))) =>
            ∑ i : Fin r, (((ι i).hom.app (Opposite.op V)).hom (f i))) := by
    intro V
    let EV_V : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj (Opposite.op V)
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun (s : ↥(L_U.obj.obj (Opposite.op V))) (j : Fin r) =>
      (((π_part j).hom.app (Opposite.op V)).hom s), ?_, ?_⟩
    · intro f
      funext j
      dsimp only
      rw [map_sum]
      have hterm :
          ∀ i : Fin r,
            (((π_part j).hom.app (Opposite.op V)).hom (((ι i).hom.app (Opposite.op V)).hom (f i))) =
              (((CategoryTheory.CategoryStruct.comp (ι i) (π_part j)).hom.app (Opposite.op V)).hom (f i)) :=
        fun _ => rfl
      simp_rw [hterm]
      rw [Finset.sum_eq_single j]
      · rw [hDiag j]
        rfl
      · intro i _ hij
        rw [hOff i j hij]
        change ((EV_V.map (0 : L_part i ⟶ L_part j)).hom) (f i) = 0
        rw [EV_V.map_zero]
        rfl
      · intro hj_abs
        exact absurd (Finset.mem_univ j) hj_abs
    · intro s
      dsimp only
      let evEnd_s : (L_U ⟶ L_U) →+ ↥(L_U.obj.obj (Opposite.op V)) :=
        AddMonoidHom.mk'
          (fun g => ((g.hom.app (Opposite.op V)).hom) s)
          (fun g₁ g₂ => by
            rw [CategoryTheory.Sheaf.Hom.add_app]
            rfl)
      have hterm :
          ∀ i : Fin r,
            (((ι i).hom.app (Opposite.op V)).hom (((π_part i).hom.app (Opposite.op V)).hom s)) =
              evEnd_s (CategoryTheory.CategoryStruct.comp (π_part i) (ι i)) :=
        fun _ => rfl
      simp_rw [hterm]
      rw [← map_sum evEnd_s, hSum]
      rfl

  have hExtBij :
      ∀ (q : ℕ),
        let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        Function.Bijective
          (fun z : weilEtaleLocalTorsionH X m U q =>
            fun i : Fin r =>
              (CategoryTheory.Abelian.Ext.mk₀ (π_part i)).postcomp Fℤ (Nat.add_zero q) z) := by
    intro q Fℤ
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun (g : ∀ i : Fin r, weilEtaleLocalTorsionH X m (U_part i) q) =>
      ∑ i : Fin r, (CategoryTheory.Abelian.Ext.mk₀ (ι i)).postcomp Fℤ (Nat.add_zero q) (g i),
      ?_, ?_⟩
    · intro z
      dsimp only
      let postEnd_z : (L_U ⟶ L_U) →+ weilEtaleLocalTorsionH X m U q :=
        AddMonoidHom.mk'
          (fun g => z.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q))
          (fun g₁ g₂ => by
            rw [CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add])
      have hterm :
          ∀ i : Fin r,
            (CategoryTheory.Abelian.Ext.mk₀ (ι i)).postcomp Fℤ (Nat.add_zero q)
              ((CategoryTheory.Abelian.Ext.mk₀ (π_part i)).postcomp Fℤ (Nat.add_zero q) z) =
              postEnd_z (CategoryTheory.CategoryStruct.comp (π_part i) (ι i)) := by
        intro i
        change (z.comp (CategoryTheory.Abelian.Ext.mk₀ (π_part i)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (ι i)) (Nat.add_zero q) =
          z.comp (CategoryTheory.Abelian.Ext.mk₀ (π_part i ≫ ι i)) (Nat.add_zero q)
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      simp_rw [hterm]
      rw [← map_sum postEnd_z, hSum]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id z
    · intro g
      funext j
      dsimp only
      rw [map_sum]
      have hterm :
          ∀ i : Fin r,
            (CategoryTheory.Abelian.Ext.mk₀ (π_part j)).postcomp Fℤ (Nat.add_zero q)
              ((CategoryTheory.Abelian.Ext.mk₀ (ι i)).postcomp Fℤ (Nat.add_zero q) (g i)) =
              (g i).comp
                (CategoryTheory.Abelian.Ext.mk₀
                  (CategoryTheory.CategoryStruct.comp (ι i) (π_part j)))
                (Nat.add_zero q) := by
        intro i
        change ((g i).comp (CategoryTheory.Abelian.Ext.mk₀ (ι i)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (π_part j)) (Nat.add_zero q) = _
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      simp_rw [hterm]
      rw [Finset.sum_eq_single j]
      · rw [hDiag j]
        exact CategoryTheory.Abelian.Ext.comp_mk₀_id (g j)
      · intro i _ hij
        rw [hOff i j hij, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      · intro hj_abs
        exact absurd (Finset.mem_univ j) hj_abs

  exact ⟨π_part, hDiag, hOff, hSum, hSecBij, hExtBij⟩

theorem weil_etale_localTorsion_pullback_calculus_and_diag_transfer (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ((∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale),
        ℓ • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S ℓ U) = 0 ∧
        ∀ (q : ℕ) (z : weilEtaleLocalTorsionH S ℓ U q), ℓ • z = 0) ∧
      (∀ (H : Type u) [AddCommGroup H] [Finite H],
        Nat.card H = ℓ →
        (∀ x : H, ℓ • x = 0) →
        ∀ (v : H), v ≠ 0 →
          Function.Bijective (fun a : ULift.{u} (ZMod ℓ) => a.down.val • v))) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
        (h : Quiver.Hom X₁ X₂) (U₂ : X₂.Etale),
      let pf_h := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h)
      let pb_h := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
      let adj_h := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
      let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ ((weilEtaleSitePullback h).obj U₂)
      let u_L₂ : Quiver.Hom L₂ (pf_h.obj (pb_h.obj L₂)) := adj_h.unit.app L₂
      let η_0 : Quiver.Hom AM ((pf_h.obj (pb_h.obj L₂)).obj.obj (Opposite.op U₂)) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv u_L₂
      let η_1 : Quiver.Hom AM ((pb_h.obj L₂).obj.obj (Opposite.op ((weilEtaleSitePullback h).obj U₂))) :=
        η_0
      let ι_pull : Quiver.Hom L_BU (pb_h.obj L₂) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.symm η_1
      CategoryTheory.IsIso ι_pull ∧
      WeilIsEtaleSheafPullback h L₂ L_BU) ∧
    ((∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
        (h : Quiver.Hom X₁ X₂)
        (U₁ : X₁.Etale) (U₂ : X₂.Etale)
        (τ_U : Quiver.Hom ((weilEtaleSitePullback h).obj U₂) U₁)
        (q : ℕ),
        ∃! p : weilEtaleLocalTorsionH X₂ ℓ U₂ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁ q,
          WeilIsLocalTorsionPullback h U₁ U₂ τ_U ℓ q p) ∧
      (∀ (S_k : AlgebraicGeometry.Scheme.{u})
          (Y_bar V_bar : CategoryTheory.Over S_k)
          (π_bar : Quiver.Hom Y_bar V_bar)
          (V₂ V' : V_bar.left.Etale)
          (w₁ : Quiver.Hom V' V₂)
          (W₂ W'₂ : Y_bar.left.Etale)
          (w_tilde₁ : Quiver.Hom W'₂ W₂)
          (f_W₂ : Quiver.Hom
            ((AlgebraicGeometry.Scheme.Etale.forget Y_bar.left).obj W₂).left
            ((AlgebraicGeometry.Scheme.Etale.forget V_bar.left).obj V₂).left)
          (hComm_W₂ : CategoryTheory.CategoryStruct.comp f_W₂
              ((AlgebraicGeometry.Scheme.Etale.forget V_bar.left).obj V₂).hom =
            CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget Y_bar.left).obj W₂).hom π_bar.left)
          (f_W'₂ : Quiver.Hom
            ((AlgebraicGeometry.Scheme.Etale.forget Y_bar.left).obj W'₂).left
            ((AlgebraicGeometry.Scheme.Etale.forget V_bar.left).obj V').left)
          (hComm_W'₂ : CategoryTheory.CategoryStruct.comp f_W'₂
              ((AlgebraicGeometry.Scheme.Etale.forget V_bar.left).obj V').hom =
            CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget Y_bar.left).obj W'₂).hom π_bar.left),
        let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget V_bar.left
        let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y_bar.left
        let B_π := weilEtaleSitePullback π_bar.left
        CategoryTheory.IsPullback
          ((Fgt_Y.map w_tilde₁).left) f_W'₂ f_W₂ ((Fgt_V.map w₁).left) →
        let Y_V₂ := (B_π.obj V₂).left
        let j_diag₂ : Quiver.Hom (Fgt_Y.obj W₂).left Y_V₂ :=
          CategoryTheory.Limits.pullback.lift f_W₂ (Fgt_Y.obj W₂).hom hComm_W₂
        let W₂_diag : Y_V₂.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ j_diag₂
            (CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
              j_diag₂ (B_π.obj V₂).hom (B_π.obj V₂).prop
              (Eq.mp
                (congrArg AlgebraicGeometry.Etale
                  (CategoryTheory.Limits.pullback.lift_snd f_W₂ (Fgt_Y.obj W₂).hom hComm_W₂).symm)
                W₂.prop))
        let Y_V' := (B_π.obj V').left
        let j_diag'₂ : Quiver.Hom (Fgt_Y.obj W'₂).left Y_V' :=
          CategoryTheory.Limits.pullback.lift f_W'₂ (Fgt_Y.obj W'₂).hom hComm_W'₂
        let W'₂_diag : Y_V'.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ j_diag'₂
            (CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
              j_diag'₂ (B_π.obj V').hom (B_π.obj V').prop
              (Eq.mp
                (congrArg AlgebraicGeometry.Etale
                  (CategoryTheory.Limits.pullback.lift_snd f_W'₂ (Fgt_Y.obj W'₂).hom hComm_W'₂).symm)
                W'₂.prop))
        let w_YV : Quiver.Hom Y_V' Y_V₂ := (Fgt_Y.map (B_π.map w₁)).left
        ∃ (e_diag : CategoryTheory.Iso ((weilEtaleSitePullback w_YV).obj W₂_diag) W'₂_diag),
          CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget Y_V').map e_diag.hom).left)
            ((Fgt_Y.map w_tilde₁).left) =
            CategoryTheory.Limits.pullback.fst
              ((AlgebraicGeometry.Scheme.Etale.forget Y_V₂).obj W₂_diag).hom w_YV ∧
          ∀ (η₂ : weilEtaleLocalTorsionH Y_V₂ ℓ W₂_diag 2),
            (∀ (s_z : Quiver.Hom S_k (Fgt_V.obj V₂).left),
              CategoryTheory.CategoryStruct.comp s_z
                  (CategoryTheory.CategoryStruct.comp (Fgt_V.obj V₂).hom V_bar.hom) =
                CategoryTheory.CategoryStruct.id S_k →
              let s_b := CategoryTheory.CategoryStruct.comp s_z (Fgt_V.obj V₂).hom
              let Y_b := CategoryTheory.Limits.pullback π_bar.left s_b
              let snd_b := CategoryTheory.Limits.pullback.snd π_bar.left s_b
              let fst_b := CategoryTheory.Limits.pullback.fst π_bar.left s_b
              let ι_z : Quiver.Hom Y_b Y_V₂ :=
                CategoryTheory.Limits.pullback.lift
                  (CategoryTheory.CategoryStruct.comp snd_b s_z)
                  fst_b
                  ((CategoryTheory.Category.assoc snd_b s_z (Fgt_V.obj V₂).hom).trans
                    (CategoryTheory.Limits.pullback.condition (f := π_bar.left) (g := s_b)).symm)
              Finite (weilEtaleLocalTorsionH Y_b ℓ ((weilEtaleSitePullback ι_z).obj W₂_diag) 2) ∧
              Nat.card (weilEtaleLocalTorsionH Y_b ℓ ((weilEtaleSitePullback ι_z).obj W₂_diag) 2) = ℓ ∧
              (∀ p_z : weilEtaleLocalTorsionH Y_V₂ ℓ W₂_diag 2 →+
                  weilEtaleLocalTorsionH Y_b ℓ ((weilEtaleSitePullback ι_z).obj W₂_diag) 2,
                WeilIsLocalTorsionPullback ι_z
                  ((weilEtaleSitePullback ι_z).obj W₂_diag) W₂_diag
                  (CategoryTheory.CategoryStruct.id _) ℓ 2 p_z →
                p_z η₂ ≠ 0)) →
            ∀ (p_wYV : weilEtaleLocalTorsionH Y_V₂ ℓ W₂_diag 2 →+
                weilEtaleLocalTorsionH Y_V' ℓ W'₂_diag 2),
              WeilIsLocalTorsionPullback w_YV W'₂_diag W₂_diag e_diag.hom ℓ 2 p_wYV →
              let η' := p_wYV η₂
              ∀ (s_z' : Quiver.Hom S_k (Fgt_V.obj V').left),
                CategoryTheory.CategoryStruct.comp s_z'
                    (CategoryTheory.CategoryStruct.comp (Fgt_V.obj V').hom V_bar.hom) =
                  CategoryTheory.CategoryStruct.id S_k →
                let s_b' := CategoryTheory.CategoryStruct.comp s_z' (Fgt_V.obj V').hom
                let Y_b' := CategoryTheory.Limits.pullback π_bar.left s_b'
                let snd_b' := CategoryTheory.Limits.pullback.snd π_bar.left s_b'
                let fst_b' := CategoryTheory.Limits.pullback.fst π_bar.left s_b'
                let ι_z' : Quiver.Hom Y_b' Y_V' :=
                  CategoryTheory.Limits.pullback.lift
                    (CategoryTheory.CategoryStruct.comp snd_b' s_z')
                    fst_b'
                    ((CategoryTheory.Category.assoc snd_b' s_z' (Fgt_V.obj V').hom).trans
                      (CategoryTheory.Limits.pullback.condition (f := π_bar.left) (g := s_b')).symm)
                Finite (weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z').obj W'₂_diag) 2) ∧
                Nat.card (weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z').obj W'₂_diag) 2) = ℓ ∧
                (∀ p_z' : weilEtaleLocalTorsionH Y_V' ℓ W'₂_diag 2 →+
                    weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z').obj W'₂_diag) 2,
                  WeilIsLocalTorsionPullback ι_z'
                    ((weilEtaleSitePullback ι_z').obj W'₂_diag) W'₂_diag
                    (CategoryTheory.CategoryStruct.id _) ℓ 2 p_z' →
                  p_z' η' ≠ 0))) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

  
  let freeEquiv :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V : Z.Etale}
        {F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}},
        (weilEtaleLocalTorsionSheaf Z ℓ V ⟶ F) ≃ (AM ⟶ F.obj.obj (Opposite.op V)) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv

  have hFreeComp :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V : Z.Etale}
        {F G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf Z ℓ V ⟶ F) (ψ : F ⟶ G),
        freeEquiv (α ≫ ψ) = freeEquiv α ≫ ψ.hom.app (Opposite.op V) :=
    fun {Z _ _ _} α ψ =>
      (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
        ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology
          AddCommGrpCat.{u}).homEquiv_naturality_right α ψ)).trans
        (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)

  have hFreePrecomp :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Z.Etale} (u : U₁ ⟶ U₂)
        {F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : weilEtaleLocalTorsionSheaf Z ℓ U₂ ⟶ F),
        freeEquiv (weilEtaleLocalTorsionMap Z ℓ u ≫ φ) =
          freeEquiv φ ≫ F.obj.map (Opposite.op u) := by
    intro Z U₁ U₂ u F φ
    rw [hFreeComp]
    have hmap : freeEquiv (weilEtaleLocalTorsionMap Z ℓ u) =
        freeEquiv (𝟙 (weilEtaleLocalTorsionSheaf Z ℓ U₂)) ≫
          (weilEtaleLocalTorsionSheaf Z ℓ U₂).obj.map (Opposite.op u) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    rw [hmap, CategoryTheory.Category.assoc, φ.hom.naturality (Opposite.op u),
      ← CategoryTheory.Category.assoc, ← hFreeComp, CategoryTheory.Category.id_comp]

  have hLocMapId :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale),
        weilEtaleLocalTorsionMap Z ℓ (𝟙 V) = 𝟙 (weilEtaleLocalTorsionSheaf Z ℓ V) := by
    intro Z V
    apply freeEquiv.injective
    have h1 : freeEquiv (weilEtaleLocalTorsionMap Z ℓ (𝟙 V)) =
        freeEquiv (𝟙 (weilEtaleLocalTorsionSheaf Z ℓ V)) ≫
          (weilEtaleLocalTorsionSheaf Z ℓ V).obj.map (𝟙 (Opposite.op V)) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    rw [h1, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]

  have hLocMapComp :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) {U₁ U₂ U₃ : Z.Etale}
        (u : U₁ ⟶ U₂) (v : U₂ ⟶ U₃),
        weilEtaleLocalTorsionMap Z ℓ (u ≫ v) =
          weilEtaleLocalTorsionMap Z ℓ u ≫ weilEtaleLocalTorsionMap Z ℓ v := by
    intro Z U₁ U₂ U₃ u v
    apply freeEquiv.injective
    rw [hFreePrecomp]
    have hv : freeEquiv (weilEtaleLocalTorsionMap Z ℓ v) =
        freeEquiv (𝟙 (weilEtaleLocalTorsionSheaf Z ℓ U₃)) ≫
          (weilEtaleLocalTorsionSheaf Z ℓ U₃).obj.map (Opposite.op v) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have huv : freeEquiv (weilEtaleLocalTorsionMap Z ℓ (u ≫ v)) =
        freeEquiv (𝟙 (weilEtaleLocalTorsionSheaf Z ℓ U₃)) ≫
          (weilEtaleLocalTorsionSheaf Z ℓ U₃).obj.map (Opposite.op v ≫ Opposite.op u) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    rw [hv, huv, (weilEtaleLocalTorsionSheaf Z ℓ U₃).obj.map_comp, CategoryTheory.Category.assoc]

  have hIsoMapH :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : S.Etale}
        (e : CategoryTheory.Iso V₁ V₂) (q : ℕ),
        Function.Bijective (weilEtaleLocalTorsionMapH S ℓ e.hom q) := by
    intro S V₁ V₂ e q
    refine Function.bijective_iff_has_inverse.mpr ⟨weilEtaleLocalTorsionMapH S ℓ e.inv q, ?_, ?_⟩
    · intro z
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S ℓ e.hom))
          (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S ℓ e.inv))
          (Nat.add_zero q) = z
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hLocMapComp, e.hom_inv_id, hLocMapId,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · intro w
      change (w.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S ℓ e.inv))
          (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S ℓ e.hom))
          (Nat.add_zero q) = w
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hLocMapComp, e.inv_hom_id, hLocMapId,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]

  
  have hPillar1 :
      (∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale),
        ℓ • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S ℓ U) = 0 ∧
        ∀ (q : ℕ) (z : weilEtaleLocalTorsionH S ℓ U q), ℓ • z = 0) ∧
      (∀ (H : Type u) [AddCommGroup H] [Finite H],
        Nat.card H = ℓ →
        (∀ x : H, ℓ • x = 0) →
        ∀ (v : H), v ≠ 0 →
          Function.Bijective (fun a : ULift.{u} (ZMod ℓ) => a.down.val • v)) := by
    refine ⟨?_, ?_⟩
    · intro S U
      let L := weilEtaleLocalTorsionSheaf S ℓ U
      let EV := CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj (Opposite.op U)
      have hApp_zero : ((0 : L ⟶ L).hom.app (Opposite.op U)) = 0 := EV.map_zero L L
      have hApp_nsmul : ((ℓ • 𝟙 L).hom.app (Opposite.op U)) = ℓ • 𝟙 (L.obj.obj (Opposite.op U)) := by
        change EV.map (ℓ • 𝟙 L) = _
        rw [CategoryTheory.Functor.map_nsmul, EV.map_id]
        rfl
      have hAM_ann : ℓ • CategoryTheory.CategoryStruct.id AM = 0 := by
        ext x
        apply ULift.ext
        change ℓ • x.down = 0
        rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
      have hId_ann : ℓ • CategoryTheory.CategoryStruct.id L = 0 := by
        apply (@freeEquiv S U L).injective
        have hL1 : freeEquiv (ℓ • 𝟙 L) = freeEquiv (𝟙 L) ≫ (ℓ • 𝟙 L).hom.app (Opposite.op U) := by
          conv_lhs => rw [← CategoryTheory.Category.id_comp (ℓ • 𝟙 L)]
          exact hFreeComp (𝟙 L) (ℓ • 𝟙 L)
        have hR1 : (@freeEquiv S U L) 0 = 0 := by
          conv_lhs => rw [← CategoryTheory.Category.id_comp (0 : L ⟶ L)]
          rw [hFreeComp, hApp_zero, CategoryTheory.Limits.comp_zero]
        rw [hL1, hR1, hApp_nsmul, CategoryTheory.Preadditive.comp_nsmul,
          CategoryTheory.Category.comp_id, ← CategoryTheory.Category.id_comp (freeEquiv (𝟙 L)),
          ← CategoryTheory.Preadditive.nsmul_comp, hAM_ann, CategoryTheory.Limits.zero_comp]
      refine ⟨hId_ann, fun q z => ?_⟩
      let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      have hMk0_nsmul : ∀ n : ℕ,
          CategoryTheory.Abelian.Ext.mk₀ (n • 𝟙 L) =
            n • CategoryTheory.Abelian.Ext.mk₀ (𝟙 L) := by
        intro n
        induction n with
        | zero =>
          rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero]
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih]
      let R_z := (CategoryTheory.Abelian.Ext.bilinearComp Fℤ L L q 0 q (Nat.add_zero q)) z
      have hRz_id : R_z (CategoryTheory.Abelian.Ext.mk₀ (𝟙 L)) = z := by
        change z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 L)) (Nat.add_zero q) = z
        exact CategoryTheory.Abelian.Ext.comp_mk₀_id z
      calc
        ℓ • z = ℓ • R_z (CategoryTheory.Abelian.Ext.mk₀ (𝟙 L)) := by rw [hRz_id]
        _ = R_z (ℓ • CategoryTheory.Abelian.Ext.mk₀ (𝟙 L)) := (map_nsmul R_z ℓ _).symm
        _ = R_z (CategoryTheory.Abelian.Ext.mk₀ (ℓ • 𝟙 L)) := by rw [hMk0_nsmul]
        _ = R_z (CategoryTheory.Abelian.Ext.mk₀ (0 : L ⟶ L)) := by rw [hId_ann]
        _ = R_z 0 := by rw [CategoryTheory.Abelian.Ext.mk₀_zero]
        _ = 0 := map_zero R_z
    · intro H _ _ hCard hAnn v hv
      let g : ULift.{u} (ZMod ℓ) → H := fun a => a.down.val • v
      have h_mod : ∀ n : ℕ, (n % ℓ) • v = n • v := by
        intro n
        conv_rhs => rw [← Nat.div_add_mod n ℓ]
        rw [add_nsmul, mul_nsmul, hAnn v, nsmul_zero, zero_add]
      have hg_inj : Function.Injective g := by
        intro a₁ a₂ h12
        dsimp [g] at h12
        let b : ZMod ℓ := a₁.down - a₂.down
        have hb_add : b + a₂.down = a₁.down := sub_add_cancel a₁.down a₂.down
        have hb_smul : a₁.down.val • v = b.val • v + a₂.down.val • v := by
          rw [← hb_add, ZMod.val_add, h_mod, add_nsmul]
        have hb_zero : b.val • v = 0 := by
          have h0 : b.val • v + a₂.down.val • v = 0 + a₂.down.val • v := by
            rw [← hb_smul, zero_add]
            exact h12
          exact add_right_cancel h0
        have hb_eq0 : b = 0 := by
          by_contra hb_ne
          apply hv
          calc
            v = 1 • v := (one_nsmul v).symm
            _ = (1 : ZMod ℓ).val • v := by rw [ZMod.val_one ℓ]
            _ = (b⁻¹ * b).val • v := by rw [inv_mul_cancel₀ hb_ne]
            _ = (b⁻¹.val * b.val % ℓ) • v := by rw [ZMod.val_mul]
            _ = (b⁻¹.val * b.val) • v := h_mod _
            _ = b⁻¹.val • (b.val • v) := mul_nsmul' v b⁻¹.val b.val
            _ = b⁻¹.val • 0 := by rw [hb_zero]
            _ = 0 := nsmul_zero _
        exact ULift.ext _ _ (sub_eq_zero.mp hb_eq0)
      have hCard_ulift : Nat.card (ULift.{u} (ZMod ℓ)) = ℓ :=
        (Nat.card_ulift (ZMod ℓ)).trans (Nat.card_eq_fintype_card.trans (ZMod.card ℓ))
      have : Finite (ULift.{u} (ZMod ℓ)) := Finite.of_fintype (ULift.{u} (ZMod ℓ))
      obtain ⟨e_HU⟩ := Finite.card_eq.mp (hCard.trans hCard_ulift.symm)
      have hBij_comp : Function.Bijective (e_HU ∘ g) :=
        Finite.injective_iff_bijective.mp (e_HU.injective.comp hg_inj)
      have hg_eq : g = e_HU.symm ∘ (e_HU ∘ g) :=
        funext fun x => (e_HU.symm_apply_apply (g x)).symm
      change Function.Bijective g
      rw [hg_eq]
      exact e_HU.symm.bijective.comp hBij_comp

  
  let π_BU_canon :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂) (U₂ : X₂.Etale),
        (((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology).obj
          (weilEtaleLocalTorsionSheaf X₂ ℓ U₂)) ⟶
        weilEtaleLocalTorsionSheaf X₁ ℓ ((weilEtaleSitePullback h).obj U₂) :=
    fun {X₁ X₂} h U₂ =>
      let B_h := weilEtaleSitePullback h
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
      let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ (B_h.obj U₂)
      let ι_BU : AM ⟶ L_BU.obj.obj (Opposite.op (B_h.obj U₂)) :=
        (@freeEquiv X₁ (B_h.obj U₂) L_BU) (𝟙 L_BU)
      (adj_h.homEquiv L₂ L_BU).symm ((@freeEquiv X₂ U₂ (pf_h.obj L_BU)).symm ι_BU)

  have hPillar2 :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
        (h : Quiver.Hom X₁ X₂) (U₂ : X₂.Etale),
      let pf_h := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h)
      let pb_h := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
      let adj_h := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ h) (@hr_all X₁ X₂ h)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
      let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ ((weilEtaleSitePullback h).obj U₂)
      let u_L₂ : Quiver.Hom L₂ (pf_h.obj (pb_h.obj L₂)) := adj_h.unit.app L₂
      let η_0 : Quiver.Hom AM ((pf_h.obj (pb_h.obj L₂)).obj.obj (Opposite.op U₂)) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv u_L₂
      let η_1 : Quiver.Hom AM ((pb_h.obj L₂).obj.obj (Opposite.op ((weilEtaleSitePullback h).obj U₂))) :=
        η_0
      let ι_pull : Quiver.Hom L_BU (pb_h.obj L₂) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.symm η_1
      CategoryTheory.IsIso ι_pull ∧
      WeilIsEtaleSheafPullback h L₂ L_BU := by
    intro X₁ X₂ h U₂ pf_h pb_h adj_h AM₀ L₂ L_BU u_L₂ η_0 η_1 ι_pull
    let B_h := weilEtaleSitePullback h
    let ι_BU : AM ⟶ L_BU.obj.obj (Opposite.op (B_h.obj U₂)) :=
      (@freeEquiv X₁ (B_h.obj U₂) L_BU) (𝟙 L_BU)
    let π_pull : pb_h.obj L₂ ⟶ L_BU := π_BU_canon h U₂
    have h_inv1 : ι_pull ≫ π_pull = 𝟙 L_BU := by
      apply (@freeEquiv X₁ (B_h.obj U₂) L_BU).injective
      rw [hFreeComp]
      have hη : freeEquiv ι_pull = η_1 :=
        (@freeEquiv X₁ (B_h.obj U₂) (pb_h.obj L₂)).apply_symm_apply η_1
      rw [hη]
      change freeEquiv u_L₂ ≫ (pf_h.map π_pull).hom.app (Opposite.op U₂) = ι_BU
      rw [← hFreeComp]
      have h_adj : u_L₂ ≫ pf_h.map π_pull =
          (@freeEquiv X₂ U₂ (pf_h.obj L_BU)).symm ι_BU := by
        dsimp [u_L₂, π_pull, π_BU_canon]
        rw [← adj_h.homEquiv_unit]
        exact (adj_h.homEquiv L₂ L_BU).apply_symm_apply _
      rw [h_adj]
      exact (@freeEquiv X₂ U₂ (pf_h.obj L_BU)).apply_symm_apply ι_BU
    have h_inv2 : π_pull ≫ ι_pull = 𝟙 (pb_h.obj L₂) := by
      apply (adj_h.homEquiv L₂ (pb_h.obj L₂)).injective
      apply (@freeEquiv X₂ U₂ (pf_h.obj (pb_h.obj L₂))).injective
      rw [adj_h.homEquiv_naturality_right]
      have hπ : adj_h.homEquiv L₂ L_BU π_pull =
          (@freeEquiv X₂ U₂ (pf_h.obj L_BU)).symm ι_BU :=
        (adj_h.homEquiv L₂ L_BU).apply_symm_apply _
      have hid : adj_h.homEquiv L₂ (pb_h.obj L₂) (𝟙 (pb_h.obj L₂)) = u_L₂ :=
        (adj_h.homEquiv_unit L₂ (pb_h.obj L₂) (𝟙 (pb_h.obj L₂))).trans
          ((congrArg (adj_h.unit.app L₂ ≫ ·) (pf_h.map_id (pb_h.obj L₂))).trans
            (CategoryTheory.Category.comp_id _))
      rw [hπ, hid, hFreeComp]
      have hα : freeEquiv ((@freeEquiv X₂ U₂ (pf_h.obj L_BU)).symm ι_BU) = ι_BU :=
        (@freeEquiv X₂ U₂ (pf_h.obj L_BU)).apply_symm_apply ι_BU
      rw [hα]
      change freeEquiv (𝟙 L_BU) ≫ ι_pull.hom.app (Opposite.op (B_h.obj U₂)) =
        freeEquiv u_L₂
      rw [← hFreeComp, CategoryTheory.Category.id_comp]
      exact (@freeEquiv X₁ (B_h.obj U₂) (pb_h.obj L₂)).apply_symm_apply η_1
    have hIso : CategoryTheory.IsIso ι_pull := ⟨⟨π_pull, h_inv1, h_inv2⟩⟩
    exact ⟨hIso, ⟨@hc_all X₁ X₂ h, @hr_all X₁ X₂ h,
      ⟨{ hom := π_pull, inv := ι_pull, hom_inv_id := h_inv2, inv_hom_id := h_inv1 }⟩⟩⟩

  have hπ_BU_nat :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂)
        {U'₂ U₂ : X₂.Etale} (τ₂ : U'₂ ⟶ U₂),
        let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology
        pb_h.map (weilEtaleLocalTorsionMap X₂ ℓ τ₂) ≫ π_BU_canon h U₂ =
          π_BU_canon h U'₂ ≫ weilEtaleLocalTorsionMap X₁ ℓ ((weilEtaleSitePullback h).map τ₂) := by
    intro X₁ X₂ h U'₂ U₂ τ₂ pb_h
    let B_h := weilEtaleSitePullback h
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let L'₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U'₂
    let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
    let L_BU' := weilEtaleLocalTorsionSheaf X₁ ℓ (B_h.obj U'₂)
    let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ (B_h.obj U₂)
    let ι_BU : AM ⟶ L_BU.obj.obj (Opposite.op (B_h.obj U₂)) :=
      (@freeEquiv X₁ (B_h.obj U₂) L_BU) (𝟙 L_BU)
    let ι_BU' : AM ⟶ L_BU'.obj.obj (Opposite.op (B_h.obj U'₂)) :=
      (@freeEquiv X₁ (B_h.obj U'₂) L_BU') (𝟙 L_BU')
    apply (adj_h.homEquiv L'₂ L_BU).injective
    apply (@freeEquiv X₂ U'₂ (pf_h.obj L_BU)).injective
    rw [adj_h.homEquiv_naturality_left, adj_h.homEquiv_naturality_right]
    have h1 : adj_h.homEquiv L₂ L_BU (π_BU_canon h U₂) =
        (@freeEquiv X₂ U₂ (pf_h.obj L_BU)).symm ι_BU :=
      (adj_h.homEquiv L₂ L_BU).apply_symm_apply _
    have h2 : adj_h.homEquiv L'₂ L_BU' (π_BU_canon h U'₂) =
        (@freeEquiv X₂ U'₂ (pf_h.obj L_BU')).symm ι_BU' :=
      (adj_h.homEquiv L'₂ L_BU').apply_symm_apply _
    rw [h1, h2, hFreePrecomp, hFreeComp]
    have hα1 : freeEquiv ((@freeEquiv X₂ U₂ (pf_h.obj L_BU)).symm ι_BU) = ι_BU :=
      (@freeEquiv X₂ U₂ (pf_h.obj L_BU)).apply_symm_apply ι_BU
    have hα2 : freeEquiv ((@freeEquiv X₂ U'₂ (pf_h.obj L_BU')).symm ι_BU') = ι_BU' :=
      (@freeEquiv X₂ U'₂ (pf_h.obj L_BU')).apply_symm_apply ι_BU'
    rw [hα1, hα2]
    change freeEquiv (𝟙 L_BU) ≫ L_BU.obj.map (Opposite.op (B_h.map τ₂)) =
      freeEquiv (𝟙 L_BU') ≫
        (weilEtaleLocalTorsionMap X₁ ℓ (B_h.map τ₂)).hom.app (Opposite.op (B_h.obj U'₂))
    rw [← hFreeComp, CategoryTheory.Category.id_comp]
    exact ((@freeEquiv X₁ (B_h.obj U'₂) L_BU).apply_symm_apply _).symm

  
  
  have hConstUnitEq :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂)
        (T₁ : X₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : X₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        let B := weilEtaleSitePullback h
        let J₁ := X₁.smallEtaleTopology
        let J₂ := X₂.smallEtaleTopology
        let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let Fℤ₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj Aℤ
        let Pℤ₁ := (CategoryTheory.Functor.const (Opposite X₁.Etale)).obj Aℤ
        let Pℤ₂ := (CategoryTheory.Functor.const (Opposite X₂.Etale)).obj Aℤ
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
        let η₁ := CategoryTheory.Functor.whiskerLeft B.op
          ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app Pℤ₁)
        let uℤ := ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
          Pℤ₂ (pf_h.obj Fℤ₁)).symm η₁
        (adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁)).symm
          (adj₁.unit.app Aℤ ≫ Fℤ₁.obj.map (Opposite.op τ)) = uℤ := by
    intro X₁ X₂ h T₁ hT₁ T₂ hT₂ B J₁ J₂ pf_h Fℤ₁ Pℤ₁ Pℤ₂ adj₁ adj₂ τ η₁ uℤ
    let cpAdj₁ := CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₁
    let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let cpAdj₂ := CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₂
    let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    have h_unit₁ : adj₁.unit.app Aℤ = (shAdj₁.unit.app Pℤ₁).app (Opposite.op T₁) := by
      have hu := CategoryTheory.Adjunction.comp_unit_app cpAdj₁ shAdj₁ Aℤ
      have hcp : cpAdj₁.unit.app Aℤ = 𝟙 Aℤ :=
        CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT₁ Aℤ
      exact hu.trans ((congrArg (· ≫ (shAdj₁.unit.app Pℤ₁).app (Opposite.op T₁)) hcp).trans
        (CategoryTheory.Category.id_comp ((shAdj₁.unit.app Pℤ₁).app (Opposite.op T₁))))
    let g : Aℤ ⟶ ((CategoryTheory.evaluation (Opposite X₂.Etale) AddCommGrpCat.{u}).obj
        (Opposite.op T₂)).obj (pf_h.obj Fℤ₁).obj :=
      adj₁.unit.app Aℤ ≫ Fℤ₁.obj.map (Opposite.op τ)
    have h_eqv₂ : adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁) =
        (shAdj₂.homEquiv Pℤ₂ (pf_h.obj Fℤ₁)).trans
          (cpAdj₂.homEquiv Aℤ (pf_h.obj Fℤ₁).obj) :=
      congrFun (congrFun (CategoryTheory.Adjunction.comp_homEquiv cpAdj₂ shAdj₂) Aℤ)
        (pf_h.obj Fℤ₁)
    have h_symm₂ : (adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁)).symm g =
        (shAdj₂.homEquiv Pℤ₂ (pf_h.obj Fℤ₁)).symm
          ((cpAdj₂.homEquiv Aℤ (pf_h.obj Fℤ₁).obj).symm g) := by
      rw [h_eqv₂]
      rfl
    change (adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁)).symm g = uℤ
    rw [h_symm₂]
    congr 1
    refine CategoryTheory.NatTrans.ext (funext fun W => ?_)
    rcases W with ⟨U⟩
    rw [CategoryTheory.Adjunction.homEquiv_counit]
    dsimp only [CategoryTheory.NatTrans.comp_app, CategoryTheory.Functor.const_map_app]
    rw [CategoryTheory.constantPresheafAdj_counit_app_app]
    have hnat := (shAdj₁.unit.app Pℤ₁).naturality (Opposite.op (B.map (hT₂.from U) ≫ τ))
    dsimp [Pℤ₁] at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact (CategoryTheory.Category.assoc _ _ _).trans
      ((congrArg (adj₁.unit.app Aℤ ≫ ·)
        (Fℤ₁.obj.map_comp (Opposite.op τ) (Opposite.op (B.map (hT₂.from U)))).symm).trans
        ((congrArg (· ≫ Fℤ₁.obj.map (Opposite.op (B.map (hT₂.from U) ≫ τ))) h_unit₁).trans hnat.symm))

  have hMapIso :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
        (F₁ F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} ⥤
          CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
        [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
        [CategoryTheory.Limits.PreservesFiniteColimits F₁]
        [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
        [CategoryTheory.Limits.PreservesFiniteColimits F₂]
        (ε : F₁ ≅ F₂)
        (A : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ)
        (Y : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (x : CategoryTheory.Abelian.Ext A Y q),
        (CategoryTheory.Abelian.Ext.mk₀ (ε.inv.app A)).comp
          (((F₁.mapExtAddHom A Y q) x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (ε.hom.app Y)) (Nat.add_zero q))
          (Nat.zero_add q) =
          (F₂.mapExtAddHom A Y q) x := by
    intro X₁ X₂ F₁ F₂ _ _ _ _ _ _ ε A q
    induction q with
    | zero =>
      intro Y x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A Y).2 x
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ε.hom.naturality f, ε.inv_hom_id_app_assoc]
    | succ q ih =>
      intro Y x
      let I := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let Q := CategoryTheory.Limits.cokernel ι
      let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨u, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS x hx0 rfl
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      let φ_S : S.map F₁ ⟶ S.map F₂ :=
        { τ₁ := ε.hom.app S.X₁
          τ₂ := ε.hom.app S.X₂
          τ₃ := ε.hom.app S.X₃
          comm₁₂ := (ε.hom.naturality S.f).symm
          comm₂₃ := (ε.hom.naturality S.g).symm }
      have h_ext_nat :
          (hS.map_of_exact F₁).extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (ε.hom.app Y))
            (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (ε.hom.app Q)).comp (hS.map_of_exact F₂).extClass
            (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality
          (hS.map_of_exact F₁) (hS.map_of_exact F₂) φ_S
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (Nat.add_zero (q + 1)),
        h_ext_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.zero_add 1) rfl,
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (ε.inv.app A)) _ _
          (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]
      rw [← CategoryTheory.Functor.mapExtAddHom_apply, ← CategoryTheory.Functor.mapExtAddHom_apply,
        ih Q u]

  have hMapComp :
      ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
        (F : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u} ⥤
          CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (G : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} ⥤
          CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
        [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
        [CategoryTheory.Limits.PreservesFiniteColimits F]
        [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        (A : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ)
        (Y : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (x : CategoryTheory.Abelian.Ext A Y q),
        ((F ⋙ G).mapExtAddHom A Y q) x =
          (G.mapExtAddHom (F.obj A) (F.obj Y) q) ((F.mapExtAddHom A Y q) x) := by
    intro X₁ X₂ X₃ F G _ _ _ _ _ _ A q
    induction q with
    | zero =>
      intro Y x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A Y).2 x
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ q ih =>
      intro Y x
      let I := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let Q := CategoryTheory.Limits.cokernel ι
      let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨u, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS x hx0 rfl
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      rw [← CategoryTheory.Functor.mapExtAddHom_apply (F ⋙ G),
        ← CategoryTheory.Functor.mapExtAddHom_apply F,
        ← CategoryTheory.Functor.mapExtAddHom_apply G,
        ih Q u]

  let cℤ_canon :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂),
        (((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology).obj
          ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)) ⟶
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ) :=
    fun {X₁ X₂} h =>
      let B_h := weilEtaleSitePullback h
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      let Pℤ₂ := (CategoryTheory.Functor.const (Opposite X₂.Etale)).obj Aℤ
      let Pℤ₁ := (CategoryTheory.Functor.const (Opposite X₁.Etale)).obj Aℤ
      let Fℤ₂ := (CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ₁ := (CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let η₁ := CategoryTheory.Functor.whiskerLeft B_h.op
        ((CategoryTheory.sheafificationAdjunction X₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ₁)
      let uℤ := ((CategoryTheory.sheafificationAdjunction X₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        Pℤ₂ (pf_h.obj Fℤ₁)).symm η₁
      (adj_h.homEquiv Fℤ₂ Fℤ₁).symm uℤ

  let locPullCanon :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂)
        (U₁ : X₁.Etale) (U₂ : X₂.Etale)
        (τ_U : Quiver.Hom ((weilEtaleSitePullback h).obj U₂) U₁) (q : ℕ),
        weilEtaleLocalTorsionH X₂ ℓ U₂ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁ q :=
    fun {X₁ X₂} h U₁ U₂ τ_U q =>
      let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      letI : pb_h.Additive := (hSite.1 h).1
      letI : CategoryTheory.Limits.PreservesFiniteLimits pb_h := (hSite.1 h).2.1
      letI : CategoryTheory.Limits.PreservesFiniteColimits pb_h := (hSite.1 h).2.2.1
      let Fℤ₂ := (CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ₁ := (CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
      let hcℤ : CategoryTheory.IsIso (cℤ_canon h) := (hSite.1 h).2.2.2
      let ιℤ₀ := @CategoryTheory.inv _ _ _ _ (cℤ_canon h) hcℤ
      let π_loc₀ := π_BU_canon h U₂ ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U
      ((CategoryTheory.Abelian.Ext.mk₀ π_loc₀).postcomp Fℤ₁ (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).precomp (pb_h.obj L₂) (Nat.zero_add q)).comp
          (pb_h.mapExtAddHom Fℤ₂ L₂ q))

  have hLocPullExUniq :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
        (h : Quiver.Hom X₁ X₂)
        (U₁ : X₁.Etale) (U₂ : X₂.Etale)
        (τ_U : Quiver.Hom ((weilEtaleSitePullback h).obj U₂) U₁)
        (q : ℕ),
        WeilIsLocalTorsionPullback h U₁ U₂ τ_U ℓ q (locPullCanon h U₁ U₂ τ_U q) ∧
        ∀ p : weilEtaleLocalTorsionH X₂ ℓ U₂ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁ q,
          WeilIsLocalTorsionPullback h U₁ U₂ τ_U ℓ q p →
          p = locPullCanon h U₁ U₂ τ_U q := by
    intro X₁ X₂ h U₁ U₂ τ_U q
    let B := weilEtaleSitePullback h
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let pb_h := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_h := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let _ : pb_h.Additive := (hSite.1 h).1
    let _ : CategoryTheory.Limits.PreservesFiniteLimits pb_h := (hSite.1 h).2.1
    let _ : CategoryTheory.Limits.PreservesFiniteColimits pb_h := (hSite.1 h).2.2.1
    let Fℤ₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj Aℤ
    let Fℤ₂ := (CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}).obj Aℤ
    let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
    let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ (B.obj U₂)
    let hcℤ : CategoryTheory.IsIso (cℤ_canon h) := (hSite.1 h).2.2.2
    let _ : CategoryTheory.IsIso (cℤ_canon h) := hcℤ
    let ιℤ₀ := CategoryTheory.inv (cℤ_canon h)
    refine ⟨?_, ?_⟩
    · let T₁ := weilEtaleIdTerminal.{u} X₁
      let hT₁ := weilEtaleIdTerminalIsTerminal.{u} X₁
      let T₂ := weilEtaleIdTerminal.{u} X₂
      let hT₂ := weilEtaleIdTerminalIsTerminal.{u} X₂
      refine ⟨@hc_all X₁ X₂ h, pb_h, adj_h, (hSite.1 h).1, (hSite.1 h).2.1, (hSite.1 h).2.2.1,
        T₁, hT₁, T₂, hT₂, ιℤ₀, ?_, ?_, ?_⟩
      · have hπ_eq : (adj_h.homEquiv Fℤ₂ Fℤ₁).symm
            (((CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂).homEquiv Aℤ
              (pf_h.obj Fℤ₁)).symm
              ((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁).unit.app Aℤ ≫
                Fℤ₁.obj.map (Opposite.op (hT₁.from (B.obj T₂))))) = cℤ_canon h :=
          congrArg (adj_h.homEquiv Fℤ₂ Fℤ₁).symm (hConstUnitEq h T₁ hT₁ T₂ hT₂)
        rw [hπ_eq]
        exact CategoryTheory.IsIso.inv_hom_id (cℤ_canon h)
      · have hπ_eq : (adj_h.homEquiv Fℤ₂ Fℤ₁).symm
            (((CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂).homEquiv Aℤ
              (pf_h.obj Fℤ₁)).symm
              ((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁).unit.app Aℤ ≫
                Fℤ₁.obj.map (Opposite.op (hT₁.from (B.obj T₂))))) = cℤ_canon h :=
          congrArg (adj_h.homEquiv Fℤ₂ Fℤ₁).symm (hConstUnitEq h T₁ hT₁ T₂ hT₂)
        rw [hπ_eq]
        exact CategoryTheory.IsIso.hom_inv_id (cℤ_canon h)
      · intro x
        rfl
    · intro p hp
      rcases hp with ⟨hc_w, hp_rest⟩
      have h_hc : hc_w = @hc_all X₁ X₂ h := Subsingleton.elim _ _
      subst h_hc
      rcases hp_rest with ⟨P_pull, adj_pull, hAdd_p, hLim_p, hColim_p,
        T₁, hT₁, T₂, hT₂, ιℤ, h_ιπ, h_πι, hp_eq⟩
      let _ : P_pull.Additive := hAdd_p
      let _ : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim_p
      let _ : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim_p
      let ε : pb_h ≅ P_pull := CategoryTheory.Adjunction.leftAdjointUniq adj_h adj_pull
      have hUniqSymm :
          ∀ {X : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}}
            {Y : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}}
            (g : X ⟶ pf_h.obj Y),
            ε.hom.app X ≫ (adj_pull.homEquiv X Y).symm g = (adj_h.homEquiv X Y).symm g :=
        fun {X Y} g =>
          (adj_h.homEquiv X Y).injective
            ((adj_h.homEquiv_unit X Y _).trans
              ((congrArg (adj_h.unit.app X ≫ ·) (pf_h.map_comp _ _)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ pf_h.map ((adj_pull.homEquiv X Y).symm g))
                    (CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj_h adj_pull X)).trans
                    ((adj_pull.homEquiv_unit X Y _).symm.trans
                      (((adj_pull.homEquiv X Y).apply_symm_apply g).trans
                        ((adj_h.homEquiv X Y).apply_symm_apply g).symm))))))
      let πℤ : P_pull.obj Fℤ₂ ⟶ Fℤ₁ :=
        (adj_pull.homEquiv Fℤ₂ Fℤ₁).symm
          (((CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂).homEquiv Aℤ
            (pf_h.obj Fℤ₁)).symm
            ((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁).unit.app Aℤ ≫
              Fℤ₁.obj.map (Opposite.op (hT₁.from (B.obj T₂)))))
      have h_πℤ_eq : ε.hom.app Fℤ₂ ≫ πℤ = cℤ_canon h := by
        dsimp [πℤ, cℤ_canon]
        rw [hConstUnitEq h T₁ hT₁ T₂ hT₂]
        exact hUniqSymm _
      have h_ιℤ_eq : ιℤ = ιℤ₀ ≫ ε.hom.app Fℤ₂ := by
        have h1 : (ιℤ₀ ≫ ε.hom.app Fℤ₂) ≫ πℤ = 𝟙 Fℤ₁ := by
          rw [CategoryTheory.Category.assoc, h_πℤ_eq]
          exact CategoryTheory.IsIso.inv_hom_id (cℤ_canon h)
        calc
          ιℤ = 𝟙 Fℤ₁ ≫ ιℤ := (CategoryTheory.Category.id_comp ιℤ).symm
          _ = ((ιℤ₀ ≫ ε.hom.app Fℤ₂) ≫ πℤ) ≫ ιℤ := by rw [← h1]
          _ = (ιℤ₀ ≫ ε.hom.app Fℤ₂) ≫ (πℤ ≫ ιℤ) := CategoryTheory.Category.assoc _ _ _
          _ = (ιℤ₀ ≫ ε.hom.app Fℤ₂) ≫ 𝟙 _ := by rw [h_πι]
          _ = ιℤ₀ ≫ ε.hom.app Fℤ₂ := CategoryTheory.Category.comp_id _
      let π_BU : P_pull.obj L₂ ⟶ L_BU :=
        (adj_pull.homEquiv L₂ L_BU).symm
          ((@freeEquiv X₂ U₂ (pf_h.obj L_BU)).symm
            ((@freeEquiv X₁ (B.obj U₂) L_BU) (𝟙 L_BU)))
      have h_πBU_eq : π_BU = ε.inv.app L₂ ≫ π_BU_canon h U₂ := by
        have h1 : ε.hom.app L₂ ≫ π_BU = π_BU_canon h U₂ := @hUniqSymm L₂ L_BU _
        rw [← h1, ε.inv_hom_id_app_assoc]
      ext x
      rw [hp_eq x]
      change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom Fℤ₂ L₂ q) x) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_BU ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U))
          (Nat.add_zero q)) = _
      have h_iso :
          (CategoryTheory.Abelian.Ext.mk₀ (ε.hom.app Fℤ₂)).comp
            (((P_pull.mapExtAddHom Fℤ₂ L₂ q) x).comp
              (CategoryTheory.Abelian.Ext.mk₀ (ε.inv.app L₂)) (Nat.add_zero q))
            (Nat.zero_add q) =
            (pb_h.mapExtAddHom Fℤ₂ L₂ q) x :=
        hMapIso P_pull pb_h ε.symm Fℤ₂ q L₂ x
      rw [h_ιℤ_eq, h_πBU_eq, CategoryTheory.Category.assoc,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ιℤ₀ (ε.hom.app Fℤ₂),
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (ε.inv.app L₂)
          (π_BU_canon h U₂ ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U),
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ₀) _ _
          (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q),
        ← CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ (ε.inv.app L₂))
          (CategoryTheory.Abelian.Ext.mk₀ (π_BU_canon h U₂ ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U))
          (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (ε.hom.app Fℤ₂)) _
          (CategoryTheory.Abelian.Ext.mk₀ (ε.inv.app L₂))
          (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q),
        h_iso,
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ₀) _ _
          (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q)]
      rfl

  have hTriComp :
      ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
        (h₁ : Quiver.Hom X₁ X₂) (h₂ : Quiver.Hom X₂ X₃) (h₁₂ : Quiver.Hom X₁ X₃)
        (h_eq : CategoryTheory.CategoryStruct.comp h₁ h₂ = h₁₂)
        (U₁ : X₁.Etale) (U₂ : X₂.Etale) (U₃ : X₃.Etale)
        (τ₁ : Quiver.Hom ((weilEtaleSitePullback h₁).obj U₂) U₁)
        (τ₂ : Quiver.Hom ((weilEtaleSitePullback h₂).obj U₃) U₂)
        (U₁₀ : X₁.Etale)
        (τ₁₂ : Quiver.Hom ((weilEtaleSitePullback h₁₂).obj U₃) U₁₀)
        (ψ : Quiver.Hom U₁₀ U₁)
        (q : ℕ)
        (p₁ : weilEtaleLocalTorsionH X₂ ℓ U₂ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁ q)
        (p₂ : weilEtaleLocalTorsionH X₃ ℓ U₃ q →+ weilEtaleLocalTorsionH X₂ ℓ U₂ q)
        (p₁₂ : weilEtaleLocalTorsionH X₃ ℓ U₃ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁₀ q),
        WeilIsLocalTorsionPullback h₁ U₁ U₂ τ₁ ℓ q p₁ →
        WeilIsLocalTorsionPullback h₂ U₂ U₃ τ₂ ℓ q p₂ →
        WeilIsLocalTorsionPullback h₁₂ U₁₀ U₃ τ₁₂ ℓ q p₁₂ →
        (let e_B : weilEtaleSitePullback h₁₂ ≅
             CategoryTheory.Functor.comp (weilEtaleSitePullback h₂) (weilEtaleSitePullback h₁) :=
           CategoryTheory.Iso.trans
             (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
             (CategoryTheory.MorphismProperty.Over.pullbackComp h₁ h₂)
         τ₁₂ ≫ ψ = e_B.hom.app U₃ ≫ (weilEtaleSitePullback h₁).map τ₂ ≫ τ₁) →
        ∀ x : weilEtaleLocalTorsionH X₃ ℓ U₃ q,
          p₁ (p₂ x) = weilEtaleLocalTorsionMapH X₁ ℓ ψ q (p₁₂ x) := by
    intro X₁ X₂ X₃ h₁ h₂ h₁₂ h_eq U₁ U₂ U₃ τ₁ τ₂ U₁₀ τ₁₂ ψ q p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂ h_τ x
    rw [(hLocPullExUniq h₁ U₁ U₂ τ₁ q).2 p₁ hp₁,
      (hLocPullExUniq h₂ U₂ U₃ τ₂ q).2 p₂ hp₂,
      (hLocPullExUniq h₁₂ U₁₀ U₃ τ₁₂ q).2 p₁₂ hp₁₂]
    let B₁ := weilEtaleSitePullback h₁
    let B₂ := weilEtaleSitePullback h₂
    let B₁₂ := weilEtaleSitePullback h₁₂
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let J₃ := X₃.smallEtaleTopology
    let pf₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let pf₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₃ J₂
    let pf₁₂ := B₁₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₃ J₁
    let pb₁ := B₁.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let pb₂ := B₂.sheafPullback AddCommGrpCat.{u} J₃ J₂
    let pb₁₂ := B₁₂.sheafPullback AddCommGrpCat.{u} J₃ J₁
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} J₃ J₂
    let adj₁₂ := B₁₂.sheafAdjunctionContinuous AddCommGrpCat.{u} J₃ J₁
    let _ : pb₁.Additive := (hSite.1 h₁).1
    let _ : CategoryTheory.Limits.PreservesFiniteLimits pb₁ := (hSite.1 h₁).2.1
    let _ : CategoryTheory.Limits.PreservesFiniteColimits pb₁ := (hSite.1 h₁).2.2.1
    let _ : pb₂.Additive := (hSite.1 h₂).1
    let _ : CategoryTheory.Limits.PreservesFiniteLimits pb₂ := (hSite.1 h₂).2.1
    let _ : CategoryTheory.Limits.PreservesFiniteColimits pb₂ := (hSite.1 h₂).2.2.1
    let _ : pb₁₂.Additive := (hSite.1 h₁₂).1
    let _ : CategoryTheory.Limits.PreservesFiniteLimits pb₁₂ := (hSite.1 h₁₂).2.1
    let _ : CategoryTheory.Limits.PreservesFiniteColimits pb₁₂ := (hSite.1 h₁₂).2.2.1
    let e_B : B₁₂ ≅ B₂ ⋙ B₁ :=
      (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm).trans
        (CategoryTheory.MorphismProperty.Over.pullbackComp h₁ h₂)
    have h_τ' : τ₁₂ ≫ ψ = e_B.hom.app U₃ ≫ B₁.map τ₂ ≫ τ₁ := h_τ
    let _ : (B₂ ⋙ B₁).IsContinuous J₃ J₁ :=
      CategoryTheory.Functor.isContinuous_comp B₂ B₁ J₃ J₂ J₁
    let e_pf : pf₁₂ ≅ pf₁ ⋙ pf₂ :=
      CategoryTheory.Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u} J₃ J₁
    let adj_comp : (pb₂ ⋙ pb₁) ⊣ pf₁₂ := (adj₂.comp adj₁).ofNatIsoRight e_pf.symm
    let η : pb₁₂ ≅ pb₂ ⋙ pb₁ := CategoryTheory.Adjunction.leftAdjointUniq adj₁₂ adj_comp
    have hMaster :
        ∀ {X : CategoryTheory.Sheaf J₃ AddCommGrpCat.{u}}
          {Z : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}}
          {Y : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}}
          (g₂ : pb₂.obj X ⟶ Z) (g₁ : pb₁.obj Z ⟶ Y),
          adj₁₂.homEquiv X Y (η.hom.app X ≫ pb₁.map g₂ ≫ g₁) =
            (adj₂.homEquiv X Z g₂ ≫ pf₂.map (adj₁.homEquiv Z Y g₁)) ≫ e_pf.inv.app Y := by
      intro X Z Y g₂ g₁
      have h1 : adj₁₂.homEquiv X Y (η.hom.app X ≫ pb₁.map g₂ ≫ g₁) =
          adj_comp.homEquiv X Y (pb₁.map g₂ ≫ g₁) :=
        (adj₁₂.homEquiv_unit X Y _).trans
          ((congrArg (adj₁₂.unit.app X ≫ ·) (pf₁₂.map_comp _ _)).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ pf₁₂.map (pb₁.map g₂ ≫ g₁))
                (CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj₁₂ adj_comp X)).trans
                (adj_comp.homEquiv_unit X Y _).symm)))
      have h_ofNat : adj_comp.homEquiv X Y (pb₁.map g₂ ≫ g₁) =
          ((adj₂.comp adj₁).homEquiv X Y (pb₁.map g₂ ≫ g₁)) ≫ e_pf.inv.app Y := by
        let f : (pb₂ ⋙ pb₁).obj X ⟶ Y := pb₁.map g₂ ≫ g₁
        have hu : adj_comp.unit.app X =
            (adj₂.comp adj₁).unit.app X ≫ e_pf.inv.app ((pb₂ ⋙ pb₁).obj X) := rfl
        exact (adj_comp.homEquiv_unit X Y f).trans
          ((congrArg (· ≫ pf₁₂.map f) hu).trans
            ((CategoryTheory.Category.assoc ((adj₂.comp adj₁).unit.app X)
              (e_pf.inv.app ((pb₂ ⋙ pb₁).obj X)) (pf₁₂.map f)).trans
              ((congrArg ((adj₂.comp adj₁).unit.app X ≫ ·) (e_pf.inv.naturality f).symm).trans
                ((CategoryTheory.Category.assoc ((adj₂.comp adj₁).unit.app X)
                  ((pf₁ ⋙ pf₂).map f) (e_pf.inv.app Y)).symm.trans
                  (congrArg (· ≫ e_pf.inv.app Y)
                    ((adj₂.comp adj₁).homEquiv_unit X Y f).symm)))))
      have h2 : ((adj₂.comp adj₁).homEquiv X Y) (pb₁.map g₂ ≫ g₁) =
          adj₂.homEquiv X (pf₁.obj Y) (adj₁.homEquiv (pb₂.obj X) Y (pb₁.map g₂ ≫ g₁)) :=
        congrArg (fun e => e (pb₁.map g₂ ≫ g₁))
          (congrFun (congrFun (CategoryTheory.Adjunction.comp_homEquiv adj₂ adj₁) X) Y)
      have h3 : adj₂.homEquiv X (pf₁.obj Y) (adj₁.homEquiv (pb₂.obj X) Y (pb₁.map g₂ ≫ g₁)) =
          adj₂.homEquiv X Z g₂ ≫ pf₂.map (adj₁.homEquiv Z Y g₁) :=
        (congrArg (adj₂.homEquiv X (pf₁.obj Y)) (adj₁.homEquiv_naturality_left g₂ g₁)).trans
          (adj₂.homEquiv_naturality_right g₂ (adj₁.homEquiv Z Y g₁))
      exact h1.trans (h_ofNat.trans (congrArg (· ≫ e_pf.inv.app Y) (h2.trans h3)))
    let Fℤ₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj Aℤ
    let Fℤ₂ := (CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}).obj Aℤ
    let Fℤ₃ := (CategoryTheory.constantSheaf J₃ AddCommGrpCat.{u}).obj Aℤ
    let _ : CategoryTheory.IsIso (cℤ_canon h₁) := (hSite.1 h₁).2.2.2
    let _ : CategoryTheory.IsIso (cℤ_canon h₂) := (hSite.1 h₂).2.2.2
    let _ : CategoryTheory.IsIso (cℤ_canon h₁₂) := (hSite.1 h₁₂).2.2.2
    
    have hcℤ_comp : η.hom.app Fℤ₃ ≫ pb₁.map (cℤ_canon h₂) ≫ cℤ_canon h₁ = cℤ_canon h₁₂ := by
      apply (adj₁₂.homEquiv Fℤ₃ Fℤ₁).injective
      rw [hMaster]
      let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
      let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
      let shAdj₃ := CategoryTheory.sheafificationAdjunction J₃ AddCommGrpCat.{u}
      let Pℤ₁ := (CategoryTheory.Functor.const (Opposite X₁.Etale)).obj Aℤ
      let Pℤ₂ := (CategoryTheory.Functor.const (Opposite X₂.Etale)).obj Aℤ
      let Pℤ₃ := (CategoryTheory.Functor.const (Opposite X₃.Etale)).obj Aℤ
      let η₁_₁ : Pℤ₂ ⟶ (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).obj (pf₁.obj Fℤ₁) :=
        CategoryTheory.Functor.whiskerLeft B₁.op (shAdj₁.unit.app Pℤ₁)
      let η₁_₂ : Pℤ₃ ⟶ (CategoryTheory.sheafToPresheaf J₃ AddCommGrpCat.{u}).obj (pf₂.obj Fℤ₂) :=
        CategoryTheory.Functor.whiskerLeft B₂.op (shAdj₂.unit.app Pℤ₂)
      let η₁_₁₂ : Pℤ₃ ⟶ (CategoryTheory.sheafToPresheaf J₃ AddCommGrpCat.{u}).obj (pf₁₂.obj Fℤ₁) :=
        CategoryTheory.Functor.whiskerLeft B₁₂.op (shAdj₁.unit.app Pℤ₁)
      let uℤ₁ : Fℤ₂ ⟶ pf₁.obj Fℤ₁ := (shAdj₂.homEquiv Pℤ₂ (pf₁.obj Fℤ₁)).symm η₁_₁
