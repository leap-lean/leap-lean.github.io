        exact h_appLE_congr hl₁_fac U₀ ⊤ _ _
      let f_hom : R₀_cat ⟶ R₀_cat := CommRingCat.ofHom F_A₀.toRingHom
      have hfrZ_eq_FA₀ : frZ.appLE U₀ U₀ (by rw [hfrZ_prop.2.1]; exact le_rfl) = f_hom := by
        ext a
        rw [hfrZ_prop.2.2 U₀ _ a, ← hq_pow, ← hF_A₀ a]
        rfl
      rw [hfrZ_eq_FA₀] at h_eq_appLE
      apply (Iso.cancel_iso_inv_left (Scheme.ΓSpecIso R₀_cat) _ _).mp
      rw [h_eq_appLE]
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality f_hom
      apply (Iso.cancel_iso_hom_right _ _ (Scheme.ΓSpecIso R₀_cat)).mp
      rw [Category.assoc, Iso.inv_hom_id, Category.comp_id, Category.assoc, hnat,
        ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
    have hu₀_fr : u₀ ≫ frZ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom F_A₀.toRingHom) ≫ u₀ := by
      rw [← hl₁_eq, hl₁_fac]
    have hu_fst : u ≫ fst =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫ u₀ := by
      dsimp only [u]
      rw [Category.assoc, hm₀_fst,
        ← Category.assoc (AlgebraicGeometry.pullbackSpecIso K A₀ (AlgebraicClosure K)).inv,
        AlgebraicGeometry.pullbackSpecIso_inv_fst]
    have hu_φrel : u ≫ φ_rel = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B.toRingHom) ≫ u := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (u ≫ φ_rel) ≫ fst =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B.toRingHom) ≫ u) ≫ fst
        rw [Category.assoc, hφ_fst, ← Category.assoc u fst frZ, hu_fst, Category.assoc _ u₀ frZ,
          hu₀_fr, ← Category.assoc,
          Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B.toRingHom)) u fst,
          hu_fst, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        rfl
      · rw [Category.assoc, hφ_over]
        dsimp only [u]
        rw [Category.assoc, hm₀_snd, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          Category.assoc, Category.assoc, hm₀_snd, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext c
        change (1 : A₀) ⊗ₜ[K] c = φ_B ((1 : A₀) ⊗ₜ[K] c)
        change (1 : A₀) ⊗ₜ[K] c = (F_A₀ 1) ⊗ₜ[K] c
        rw [map_one]
    have hV_range : Set.range u.base = Set.range V.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rfl
    have hV'_range : Set.range u.base = Set.range V'.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, hVV']
      rfl
    let iso_V : Spec (CommRingCat.of B) ≅ V.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq u V.ι hV_range
    let iso_V' : Spec (CommRingCat.of B) ≅ V'.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq u V'.ι hV'_range
    let iso_B : P.presheaf.obj (Opposite.op V) ≅ CommRingCat.of B :=
      V.topIso.symm ≪≫ Scheme.Γ.mapIso iso_V.op ≪≫ Scheme.ΓSpecIso (CommRingCat.of B)
    let iso_B' : P.presheaf.obj (Opposite.op V') ≅ CommRingCat.of B :=
      V'.topIso.symm ≪≫ Scheme.Γ.mapIso iso_V'.op ≪≫ Scheme.ΓSpecIso (CommRingCat.of B)
    have h_iso_appLE : ∀ (W : P.Opens) (hW : Set.range u.base = Set.range W.ι.base)
        (h_top_W : (⊤ : (Spec (CommRingCat.of B)).Opens) ≤ (TopologicalSpace.Opens.map u.base).obj W),
        (W.topIso.symm ≪≫
          Scheme.Γ.mapIso (AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq u W.ι hW).op ≪≫
          Scheme.ΓSpecIso (CommRingCat.of B)).hom =
        u.appLE W ⊤ h_top_W ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).hom := by
      intro W hW h_top_W
      let jW := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq u W.ι hW
      have hjW_fac : jW.hom ≫ W.ι = u :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac u W.ι hW
      have hu_eq : u.appLE W ⊤ h_top_W =
          W.ι.appLE W ⊤ (fun z _ => z.2) ≫ jW.hom.appTop := by
        have hcomp : W.ι.appLE W ⊤ (fun z _ => z.2) ≫ jW.hom.appLE ⊤ ⊤ (fun _ _ => trivial) =
            (jW.hom ≫ W.ι).appLE W ⊤ (by rw [hjW_fac]; exact h_top_W) :=
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE jW.hom W.ι W ⊤ ⊤
            (fun z _ => z.2) (fun _ _ => trivial)
        rw [← h_appLE_top jW.hom (fun _ _ => trivial), hcomp]
        exact h_appLE_congr hjW_fac.symm W ⊤ _ _
      have htop_inv : W.topIso.inv = W.ι.appLE W ⊤ (fun z _ => z.2) :=
        (AlgebraicGeometry.Scheme.Opens.topIso_inv W).trans
          ((congrArg P.presheaf.map (Subsingleton.elim _ _)).trans
            (AlgebraicGeometry.Scheme.Opens.ι_appLE W W ⊤ (fun z _ => z.2)).symm)
      change W.topIso.inv ≫ (jW.hom.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).hom) =
        u.appLE W ⊤ h_top_W ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).hom
      rw [← Category.assoc, htop_inv, ← hu_eq]
    have h_top_V : (⊤ : (Spec (CommRingCat.of B)).Opens) ≤ (TopologicalSpace.Opens.map u.base).obj V :=
      fun x _ => ⟨x, rfl⟩
    have h_top_V' : (⊤ : (Spec (CommRingCat.of B)).Opens) ≤ (TopologicalSpace.Opens.map u.base).obj V' :=
      fun x _ => hVV'.symm ▸ (⟨x, rfl⟩ : u.base x ∈ V)
    have hisoB_eq : iso_B.hom = u.appLE V ⊤ h_top_V ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).hom :=
      h_iso_appLE V hV_range h_top_V
    have hisoB'_eq : iso_B'.hom = u.appLE V' ⊤ h_top_V' ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).hom :=
      h_iso_appLE V' hV'_range h_top_V'
    have h_app_comm : φ_rel.app V ≫ iso_B'.hom =
        iso_B.hom ≫ CommRingCat.ofHom φ_B.toRingHom := by
      rw [hisoB'_eq, hisoB_eq, ← Category.assoc, Scheme.Hom.app_eq_appLE φ_rel]
      rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE u φ_rel V V' ⊤ le_rfl h_top_V']
      have hcomp2 : (u ≫ φ_rel).appLE V ⊤ (by intro x _; exact h_top_V' trivial) =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B.toRingHom) ≫ u).appLE V ⊤
            (by rw [← hu_φrel]; intro x _; exact h_top_V' trivial) :=
        h_appLE_congr hu_φrel V ⊤ _ _
      let s_φB := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B.toRingHom)
      have h_top_φB : (⊤ : (Spec (CommRingCat.of B)).Opens) ≤
          (TopologicalSpace.Opens.map s_φB.base).obj ⊤ := le_rfl
      rw [hcomp2,
        ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE s_φB u V ⊤ ⊤ h_top_V h_top_φB,
        h_appLE_top s_φB h_top_φB,
        Category.assoc, Category.assoc]
      congr 1
      exact AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ_B.toRingHom)
    let B_V : Type u := ↑(P.presheaf.obj (Opposite.op V))
    let A_V' : Type u := ↑(P.presheaf.obj (Opposite.op V'))
    let M : Type u := Fin δ → B_V
    let α_V : B_V ≃+* B := iso_B.commRingCatIsoToRingEquiv
    let α_V' : A_V' ≃+* B := iso_B'.commRingCatIsoToRingEquiv
    let e_pi : M ≃+ (Fin δ → B) := AddEquiv.piCongrRight (fun _ => α_V.toAddEquiv)
    let e : M ≃+ A_V' := e_pi.trans (e_B.trans α_V'.symm.toAddEquiv)
    refine ⟨V, hyV, hV_aff, hV'_aff, M, inferInstance, inferInstance, e, ?_,
      ⟨Pi.basisFun B_V (Fin δ)⟩⟩
    intro b m_vec
    have he_pi_smul : e_pi (b • m_vec) = (α_V b) • (e_pi m_vec) := by
      ext j
      change α_V (b * m_vec j) = α_V b * α_V (m_vec j)
      exact map_mul α_V b (m_vec j)
    change α_V'.symm (e_B (e_pi (b • m_vec))) = (φ_rel.app V).hom b * α_V'.symm (e_B (e_pi m_vec))
    rw [he_pi_smul, he_B_smul, map_mul]
    congr 1
    apply α_V'.injective
    rw [α_V'.apply_symm_apply]
    exact congrArg (fun f : P.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of B => f.hom b)
      h_app_comm.symm
  have _ : AlgebraicGeometry.IsProper snd :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsProper)
      (CategoryTheory.IsPullback.of_hasPullback Z.hom f₂) inferInstance
  have hProp_comp : AlgebraicGeometry.IsProper (φ_rel ≫ snd) := by
    rw [hφ_over]
    exact inferInstance
  have hProp_φ : AlgebraicGeometry.IsProper φ_rel :=
    CategoryTheory.MorphismProperty.of_postcomp
      (W := @AlgebraicGeometry.IsProper.{u}) (W' := @AlgebraicGeometry.IsSeparated.{u})
      φ_rel snd inferInstance hProp_comp
  have hAff_φ : AlgebraicGeometry.IsAffineHom φ_rel :=
    AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen φ_rel
      (fun y => let ⟨V, hyV, hV_aff, hV'_aff, _⟩ := hLocalP y; ⟨V, hyV, hV_aff, hV'_aff⟩)
  have hφ_free : WeilTopDegFiniteLocallyFreeOfRank δ φ_rel :=
    ⟨AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_φ, hAff_φ⟩, hLocalP⟩
  exact ⟨p, ν, φ_abs, φ_rel, hp_prime, hφ_abs_prop, hFactor, hφ_over, hφ_free⟩

theorem weil_alt_proper_etale_cohomological_dimension (k : Type u) [Field k] [IsAlgClosed k]
    (m n q : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z.hom]
    (hDim : topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞))
    (hq : 2 * m < q) :
    Subsingleton (weilEtaleTorsionH Z.left n q) :=
by
  have hExtTorsion : ∀ (ℓ : ℕ) {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ Y₀ : C_ab) (r₀ : ℕ),
      ℓ • CategoryTheory.CategoryStruct.id Y₀ = 0 →
      ∀ z : CategoryTheory.Abelian.Ext.{u} X₀ Y₀ r₀, ℓ • z = 0 := by
    intro ℓ C_ab _ _ _ X₀ Y₀ r₀ hY z
    have hnsmul : ∀ c : ℕ,
        c • z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (c • CategoryTheory.CategoryStruct.id Y₀))
          (Nat.add_zero r₀) := by
      intro c
      induction c with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ c ih =>
        rw [succ_nsmul, succ_nsmul, ih, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    rw [hnsmul ℓ, hY, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hRPushTorsion : ∀ (ℓ : ℕ) {X_s S_s : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom X_s S_s) (s : ℕ)
      (G : CategoryTheory.Sheaf X_s.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilAltCdHigherDirectImage f s G) = 0 := by
    intro ℓ X_s S_s f s G hG
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S_s.Etale X_s.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let P : CategoryTheory.Functor (S_s.Etale)ᵒᵖ AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf G s)
    have hP : ℓ • CategoryTheory.CategoryStruct.id P = 0 := by
      ext U z
      simp only [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
        CategoryTheory.NatTrans.app_zero, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
        AddMonoidHom.zero_apply]
      dsimp [P, CategoryTheory.Sheaf.cohomologyPresheaf,
        CategoryTheory.Sheaf.cohomologyPresheafFunctor] at z ⊢
      exact hExtTorsion ℓ _ G s hG z
    let Shf := CategoryTheory.presheafToSheaf S_s.smallEtaleTopology AddCommGrpCat.{u}
    change ℓ • CategoryTheory.CategoryStruct.id (Shf.obj P) = 0
    rw [← Shf.map_id, ← CategoryTheory.Functor.map_nsmul, hP, CategoryTheory.Functor.map_zero]

  have hGenUnique : ∀ (V_s : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral V_s]
      (m₀ : ℕ), 1 ≤ m₀ →
      topologicalKrullDim V_s = (m₀ : WithBot ℕ∞) →
      ∀ x : ↥V_s,
        ((m₀ - 1 : ℕ) : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({x} : Set ↥V_s)) →
        x = genericPoint ↥V_s := by
    intro V_s _ m₀ hm₀ hDimV x hgt
    let C_x : Set ↥V_s := closure ({x} : Set ↥V_s)
    have hEqUniv : C_x = Set.univ := by
      by_contra hne
      have hex : ∃ v₀ : ↥V_s, v₀ ∉ C_x := by
        by_contra! hall
        exact hne (Set.eq_univ_of_forall hall)
      obtain ⟨v₀, hv₀⟩ := hex
      have hClEmb : Topology.IsClosedEmbedding (Subtype.val : ↥C_x → ↥V_s) :=
        IsClosed.isClosedEmbedding_subtypeVal isClosed_closure
      let T_univ : TopologicalSpace.IrreducibleCloseds ↥V_s :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥V_s, isClosed_univ⟩
      let pushIC : TopologicalSpace.IrreducibleCloseds ↥C_x →
          TopologicalSpace.IrreducibleCloseds ↥V_s :=
        fun C =>
          { carrier := Subtype.val '' (C : Set ↥C_x)
            isIrreducible' := C.isIrreducible.image _ continuous_subtype_val.continuousOn
            isClosed' := hClEmb.isClosedMap _ C.isClosed }
      have hStrictPush : StrictMono pushIC := by
        intro C₁ C₂ hlt
        have hle : pushIC C₁ ≤ pushIC C₂ := Set.image_mono (le_of_lt hlt)
        refine lt_of_le_not_ge hle (fun hge => not_le_of_gt hlt ?_)
        intro z hz
        rcases hge ⟨z, hz, rfl⟩ with ⟨z', hz', heq⟩
        rwa [← Subtype.val_injective heq]
      have hLtTop : ∀ C : TopologicalSpace.IrreducibleCloseds ↥C_x, pushIC C < T_univ := by
        intro C
        refine lt_of_le_not_ge (fun _ _ => trivial) (fun hge => ?_)
        have hv_mem : v₀ ∈ (pushIC C : Set ↥V_s) := hge trivial
        rcases hv_mem with ⟨z, _, rfl⟩
        exact hv₀ z.2
      let x_sub : ↥C_x := ⟨x, subset_closure (Set.mem_singleton x)⟩
      have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥C_x) :=
        ⟨⟨closure {x_sub}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      have hle_dim : topologicalKrullDim ↥C_x ≤ ((m₀ - 1 : ℕ) : WithBot ℕ∞) := by
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥C_x) ≤
          (((m₀ - 1 : ℕ) : ℕ∞) : WithBot ℕ∞)
        rw [Order.krullDim_eq_iSup_length]
        refine WithBot.coe_le_coe.mpr (iSup_le fun l => ?_)
        let l_map : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V_s) :=
          RelSeries.map l ⟨pushIC, fun h => hStrictPush h⟩
        let l_ext : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V_s) :=
          l_map.snoc T_univ (hLtTop _)
        have hle := (Order.LTSeries.length_le_krullDim l_ext).trans_eq hDimV
        have hlen : l_ext.length = l.length + 1 :=
          (RelSeries.snoc_length l_map T_univ (hLtTop _)).trans
            (congrArg (· + 1) (RelSeries.map_length l _))
        rw [hlen] at hle
        have hle_enat : ((l.length + 1 : ℕ) : ℕ∞) ≤ (m₀ : ℕ∞) :=
          WithBot.coe_le_coe.mp hle
        have hle_nat : l.length + 1 ≤ m₀ := Nat.cast_le.mp hle_enat
        exact Nat.cast_le.mpr (by omega)
      exact not_lt_of_ge hle_dim hgt
    have hx_gen : IsGenericPoint x Set.univ := isGenericPoint_def.mpr hEqUniv
    exact hx_gen.eq (genericPoint_spec ↥V_s)

  have hPrimeSheaf : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
      ∀ (m₀ : ℕ) (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper W.hom],
        topologicalKrullDim W.left ≤ (m₀ : WithBot ℕ∞) →
        ∀ (ℱ : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id ℱ = 0 →
          ∀ (q₀ : ℕ), 2 * m₀ < q₀ → Subsingleton (ℱ.H q₀) := by
    intro ℓ _ hℓ m₀
    induction m₀ using Nat.strongRecOn with
    | ind m₀ ih =>
      intro W _ hDimW ℱ hℓ_ℱ q₀ hq₀
      refine weil_alt_cd_noetherian_closed_reduction_and_dim_zero k m₀ ℓ q₀ hq₀
        (fun e he_pos he_le V _ _ hDimV 𝒢 hℓ_𝒢 => ?_) W hDimW ℱ hℓ_ℱ
      rcases lt_or_eq_of_le he_le with he_lt | rfl
      · exact ih e he_lt V (le_of_eq hDimV) 𝒢 hℓ_𝒢 q₀ (by omega)
      · have hGenSupport := weil_alt_cd_generic_pushforward_stalk_support k e ℓ hℓ
          (fun κ K _ _ _ _ e' s' hℓ' hTr hs' G₀ hG₀ =>
            weil_alt_cd_tsen_tate_field_vanishing κ K e' ℓ s' hℓ' hTr hs' G₀ hG₀)
          V hDimV
        refine weil_alt_cd_generic_excision_and_leray_syzygy V.left e ℓ q₀ he_pos hq₀ 𝒢 hℓ_𝒢
          (fun ℋ hℓ_ℋ hStalkη r hr => ?_)
          (fun G hℓ_G n₀ hn₀ => (hGenSupport G hℓ_G).1 n₀ hn₀)
          (fun G hℓ_G s hs => ⟨(hGenSupport G hℓ_G).2 s hs |>.1, fun d hds r hr => ?_⟩)
        · refine weil_alt_cd_stalk_support_colimit_vanishing k (e - 1) ℓ r
            (fun Z₀ _ hDimZ₀ 𝒢₀ hℓ_𝒢₀ => ih (e - 1) (by omega) Z₀ hDimZ₀ 𝒢₀ hℓ_𝒢₀ r hr)
            V ℋ hℓ_ℋ (fun x hx => ?_)
          have hx_eq : x = genericPoint ↥V.left :=
            hGenUnique V.left e he_pos hDimV x hx
          rwa [hx_eq]
        · have hd_lt : d < e := by omega
          let g := V.left.fromSpecStalk (genericPoint ↥V.left)
          have hℓ_R : ℓ • CategoryTheory.CategoryStruct.id
              (weilAltCdHigherDirectImage g s G) = 0 :=
            hRPushTorsion ℓ g s G hℓ_G
          exact weil_alt_cd_stalk_support_colimit_vanishing k d ℓ r
            (fun Z₀ _ hDimZ₀ 𝒢₀ hℓ_𝒢₀ => ih d hd_lt Z₀ hDimZ₀ 𝒢₀ hℓ_𝒢₀ r hr)
            V (weilAltCdHigherDirectImage g s G) hℓ_R
            ((hGenSupport G hℓ_G).2 s hs |>.2 d hds)

  have hPrimeVanish : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
      Subsingleton (weilEtaleTorsionH Z.left ℓ q) := by
    intro ℓ _ hℓ
    have hZMod_tors : ℓ • CategoryTheory.CategoryStruct.id (AddCommGrpCat.of (ZMod ℓ)) = 0 := by
      ext x
      simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
        AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply,
        nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    have hUlift_tors : ℓ • CategoryTheory.CategoryStruct.id
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))) = 0 := by
      rw [← AddCommGrpCat.uliftFunctor.{u, 0}.map_id, ← CategoryTheory.Functor.map_nsmul,
        hZMod_tors, CategoryTheory.Functor.map_zero]
    let C_const := CategoryTheory.constantSheaf Z.left.smallEtaleTopology AddCommGrpCat.{u}
    have hSheaf_tors : ℓ • CategoryTheory.CategoryStruct.id
        (weilEtaleTorsionSheaf Z.left ℓ) = 0 := by
      change ℓ • CategoryTheory.CategoryStruct.id (C_const.obj _) = 0
      rw [← C_const.map_id, ← CategoryTheory.Functor.map_nsmul, hUlift_tors,
        CategoryTheory.Functor.map_zero]
    exact hPrimeSheaf ℓ hℓ m Z hDim (weilEtaleTorsionSheaf Z.left ℓ) hSheaf_tors q hq

  revert hn hUnit
  induction n using Nat.strongRecOn with
  | ind n ih_n =>
    intro hn hUnit
    rcases eq_or_lt_of_le hn with rfl | hn_gt1
    · have hZero1 : CategoryTheory.Limits.IsZero (AddCommGrpCat.of (ZMod 1)) := by
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        ext x
        exact Subsingleton.elim _ _
      have hZeroUlift : CategoryTheory.Limits.IsZero
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod 1))) :=
        AddCommGrpCat.uliftFunctor.{u, 0}.map_isZero hZero1
      have hZeroSheaf : CategoryTheory.Limits.IsZero (weilEtaleTorsionSheaf Z.left 1) :=
        (CategoryTheory.constantSheaf Z.left.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
          hZeroUlift
      exact CategoryTheory.Sheaf.subsingleton_H_of_isZero hZeroSheaf q
    · set ℓ := n.minFac
      have hPrime : Nat.Prime ℓ := Nat.minFac_prime (by omega)
      have : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
      have hdvd : ℓ ∣ n := Nat.minFac_dvd n
      set n' := n / ℓ
      have hmul : ℓ * n' = n := Nat.mul_div_cancel' hdvd
      have hℓ_pos : 0 < ℓ := hPrime.pos
      have hn'_ge1 : 1 ≤ n' := Nat.div_pos (Nat.le_of_dvd (by omega) hdvd) hℓ_pos
      have hn'_lt : n' < n := Nat.div_lt_self (by omega) hPrime.one_lt
      have : NeZero n := ⟨by omega⟩
      have : NeZero n' := ⟨by omega⟩
      have : NeZero ℓ := ⟨by omega⟩
      have hn_ne_k : (n : k) ≠ 0 := IsUnit.ne_zero hUnit
      have hcast_mul : (n : k) = (ℓ : k) * (n' : k) := by rw [← hmul, Nat.cast_mul]
      have hℓ_ne_k : (ℓ : k) ≠ 0 := fun h0 => hn_ne_k (by rw [hcast_mul, h0, zero_mul])
      have hn'_ne_k : (n' : k) ≠ 0 := fun h0 => hn_ne_k (by rw [hcast_mul, h0, mul_zero])
      have hUnit' : IsUnit (n' : k) := Ne.isUnit hn'_ne_k
      let ι_hom : ZMod n' →+ ZMod n :=
        { toFun := fun a => ((ℓ * a.val : ℕ) : ZMod n)
          map_zero' := by simp
          map_add' := fun a b => by
            have hdiv := Nat.div_add_mod (a.val + b.val) n'
            have h1 : n * ((a.val + b.val) / n') + ℓ * (a + b).val = ℓ * a.val + ℓ * b.val := by
              rw [ZMod.val_add]
              calc
                n * ((a.val + b.val) / n') + ℓ * ((a.val + b.val) % n')
                  = (ℓ * n') * ((a.val + b.val) / n') + ℓ * ((a.val + b.val) % n') := by
                    rw [hmul]
                _ = ℓ * (n' * ((a.val + b.val) / n') + (a.val + b.val) % n') := by ring
                _ = ℓ * (a.val + b.val) := by rw [hdiv]
                _ = ℓ * a.val + ℓ * b.val := by ring
            have hcast := congrArg (Nat.cast : ℕ → ZMod n) h1
            push_cast at hcast ⊢
            rw [ZMod.natCast_self, zero_mul, zero_add] at hcast
            exact hcast }
      let π_hom : ZMod n →+ ZMod ℓ := (ZMod.castHom hdvd (ZMod ℓ)).toAddMonoidHom
      let ι : Quiver.Hom (AddCommGrpCat.of (ZMod n')) (AddCommGrpCat.of (ZMod n)) :=
        AddCommGrpCat.ofHom ι_hom
      let π : Quiver.Hom (AddCommGrpCat.of (ZMod n)) (AddCommGrpCat.of (ZMod ℓ)) :=
        AddCommGrpCat.ofHom π_hom
      have hcomp : CategoryTheory.CategoryStruct.comp ι π = 0 := by
        ext a
        change ZMod.castHom hdvd (ZMod ℓ) ((ℓ * a.val : ℕ) : ZMod n) = 0
        rw [map_natCast, Nat.cast_mul, ZMod.natCast_self, zero_mul]
      have hMono : CategoryTheory.Mono ι := by
        rw [AddCommGrpCat.mono_iff_injective]
        intro a₁ a₂ h
        have hd : ι_hom (a₁ - a₂) = 0 := by rw [map_sub, sub_eq_zero]; exact h
        have hdvd_val : n ∣ ℓ * (a₁ - a₂).val :=
          (ZMod.natCast_eq_zero_iff (ℓ * (a₁ - a₂).val) n).mp hd
        rw [← hmul] at hdvd_val
        have hdvd_n' : n' ∣ (a₁ - a₂).val := (Nat.mul_dvd_mul_iff_left hℓ_pos).mp hdvd_val
        have hval_zero : (a₁ - a₂).val = 0 :=
          Nat.eq_zero_of_dvd_of_lt hdvd_n' (ZMod.val_lt (a₁ - a₂))
        exact sub_eq_zero.mp (ZMod.val_eq_zero _ |>.mp hval_zero)
      have hEpi : CategoryTheory.Epi π := by
        rw [AddCommGrpCat.epi_iff_surjective]
        intro c
        refine ⟨(c.val : ZMod n), ?_⟩
        change ZMod.castHom hdvd (ZMod ℓ) (c.val : ZMod n) = c
        rw [map_natCast, ZMod.natCast_zmod_val]
      have hExact : (CategoryTheory.ShortComplex.mk ι π hcomp).Exact := by
        rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact]
        intro b
        constructor
        · intro hb
          have hb_cast : ZMod.castHom hdvd (ZMod ℓ) (b.val : ZMod n) = 0 := by
            rwa [ZMod.natCast_zmod_val]
          rw [map_natCast] at hb_cast
          obtain ⟨c₀, hc₀⟩ := (ZMod.natCast_eq_zero_iff b.val ℓ).mp hb_cast
          have hc₀_lt : c₀ < n' := by
            have hlt : ℓ * c₀ < ℓ * n' := by rw [← hc₀, hmul]; exact ZMod.val_lt b
            exact Nat.lt_of_mul_lt_mul_left hlt
          refine ⟨(c₀ : ZMod n'), ?_⟩
          change ((ℓ * (c₀ : ZMod n').val : ℕ) : ZMod n) = b
          rw [ZMod.val_natCast_of_lt hc₀_lt, ← hc₀, ZMod.natCast_zmod_val]
        · rintro ⟨a, rfl⟩
          change ZMod.castHom hdvd (ZMod ℓ) ((ℓ * a.val : ℕ) : ZMod n) = 0
          rw [map_natCast, Nat.cast_mul, ZMod.natCast_self, zero_mul]
      have hSES₀ : (CategoryTheory.ShortComplex.mk ι π hcomp).ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi
      have hSES_ulift :
          ((CategoryTheory.ShortComplex.mk ι π hcomp).map
            AddCommGrpCat.uliftFunctor.{u, 0}).ShortExact :=
        hSES₀.map_of_exact AddCommGrpCat.uliftFunctor.{u, 0}
      let C_const := CategoryTheory.constantSheaf Z.left.smallEtaleTopology AddCommGrpCat.{u}
      have : CategoryTheory.Limits.PreservesFiniteLimits C_const :=
        @CategoryTheory.Limits.comp_preservesFiniteLimits _ _ _ _ _ _
          (CategoryTheory.Functor.const (Z.left.Etale)ᵒᵖ)
          (CategoryTheory.presheafToSheaf Z.left.smallEtaleTopology AddCommGrpCat.{u})
          inferInstance inferInstance
      have hSES_sheaf :
          (((CategoryTheory.ShortComplex.mk ι π hcomp).map
            AddCommGrpCat.uliftFunctor.{u, 0}).map C_const).ShortExact :=
        hSES_ulift.map_of_exact C_const
      let Fℤ := C_const.obj (AddCommGrpCat.of (ULift.{u} ℤ))
      have hSub_ℓ : Subsingleton (weilEtaleTorsionH Z.left ℓ q) := hPrimeVanish ℓ hℓ_ne_k
      have hSub_n' : Subsingleton (weilEtaleTorsionH Z.left n' q) := ih_n n' hn'_lt hn'_ge1 hUnit'
      refine subsingleton_of_forall_eq 0 (fun w => ?_)
      have hw_g : w.comp (CategoryTheory.Abelian.Ext.mk₀
          ((((CategoryTheory.ShortComplex.mk ι π hcomp).map
            AddCommGrpCat.uliftFunctor.{u, 0}).map C_const).g)) (Nat.add_zero q) = 0 :=
        @Subsingleton.elim (weilEtaleTorsionH Z.left ℓ q) hSub_ℓ _ 0
      obtain ⟨w₁, hw₁⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSES_sheaf w hw_g
      have hw₁_zero : w₁ = 0 :=
        @Subsingleton.elim (weilEtaleTorsionH Z.left n' q) hSub_n' w₁ 0
      rw [← hw₁, hw₁_zero]
      exact CategoryTheory.Abelian.Ext.zero_comp Fℤ q _ q (Nat.add_zero q)

theorem weil_top_deg_transBasis_steinitz_chain (k : Type u) [Field k]
    (d : ℕ) (hd : 1 ≤ d) :
    (∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra k B]
      (u : MvPolynomial (Fin d) k →ₐ[k] B),
      RingHom.Etale u.toRingHom →
      IsTranscendenceBasis k (fun i : Fin d => u (MvPolynomial.X i))) ∧
    (∀ (B A : Type u) [CommRing B] [IsDomain B] [Algebra k B]
      [CommRing A] [IsDomain A] [Algebra k A]
      (ρ : B →ₐ[k] A) (w : Fin d → B),
      Function.Injective ρ →
      @Algebra.IsAlgebraic B A _ _ ρ.toRingHom.toAlgebra →
      IsTranscendenceBasis k w →
      IsTranscendenceBasis k (fun i : Fin d => ρ (w i))) ∧
    (∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
      (w : Fin d → A),
      IsTranscendenceBasis k w →
      let ψ : MvPolynomial (Fin d) k →ₐ[k] A := MvPolynomial.aeval w
      ∃ (g : MvPolynomial (Fin d) k) (m_w : ℕ),
        g ≠ 0 ∧
        1 ≤ m_w ∧
        let B_g := Localization.Away g
        let A_g := Localization.Away (ψ g)
        let ψ_g : B_g →+* A_g := Localization.awayMap ψ.toRingHom g
        ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module B_g M)
          (e : M ≃+ A_g),
          (∀ (b : B_g) (m : M), e (b • m) = ψ_g b * e m) ∧
          Nonempty (Module.Basis (Fin m_w) B_g M)) ∧
    (∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A]
      (u v : Fin d → A),
      IsTranscendenceBasis k u →
      IsTranscendenceBasis k v →
      ∃ (N : ℕ) (w : Fin (N + 1) → Fin d → A),
        w 0 = u ∧
        w (Fin.last N) = v ∧
        (∀ s : Fin (N + 1), IsTranscendenceBasis k (w s)) ∧
        (∀ s : Fin N, ∃ i₀ : Fin d, ∀ j : Fin d, j ≠ i₀ → w s.succ j = w s.castSucc j)) :=
by
  classical
  have hAlg_push : ∀ (R₁ R₂ S : Type u) [CommRing R₁] [CommRing R₂] [CommRing S]
      [Algebra R₁ S] [Algebra R₂ S] (e : R₁ →+* R₂),
      Function.Injective e →
      (algebraMap R₂ S).comp e = algebraMap R₁ S →
      Algebra.IsAlgebraic R₁ S →
      Algebra.IsAlgebraic R₂ S := by
    intro R₁ R₂ S _ _ _ _ _ e he_inj hcomp hAlg1
    constructor
    intro s
    obtain ⟨p, hp_ne, hp_ev⟩ := hAlg1.isAlgebraic s
    refine ⟨p.map e, ?_, ?_⟩
    · intro h0
      apply hp_ne
      exact Polynomial.map_injective e he_inj (h0.trans (Polynomial.map_zero e).symm)
    · rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp]
      exact hp_ev
  have hAlg_frac : ∀ (R : Type u) [CommRing R] [IsDomain R],
      Algebra.IsAlgebraic R (FractionRing R) := by
    intro R _ _
    constructor
    intro z
    obtain ⟨a, ⟨s, hs_mem, hdiv⟩⟩ := IsFractionRing.div_surjective (A := R) z
    have hs_ne : s ≠ 0 := nonZeroDivisors.ne_zero hs_mem
    have hs_map_ne : algebraMap R (FractionRing R) s ≠ 0 :=
      fun h0 => hs_ne (IsFractionRing.injective R (FractionRing R) (h0.trans (map_zero _).symm))
    have hrel : algebraMap R (FractionRing R) s * z = algebraMap R (FractionRing R) a := by
      rw [← hdiv, mul_div_cancel₀ _ hs_map_ne]
    refine ⟨Polynomial.C s * Polynomial.X - Polynomial.C a, ?_, ?_⟩
    · intro hp0
      apply hs_ne
      have hc1 := congrArg (fun p => Polynomial.coeff p 1) hp0
      simpa using hc1
    · simp only [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
        Polynomial.eval₂_C, Polynomial.eval₂_X]
      exact sub_eq_zero.mpr hrel
  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro B _ _ _ u hu
    let R₀ := MvPolynomial (Fin d) k
    let w : Fin d → B := fun i => u (MvPolynomial.X i)
    have haeval_eq : MvPolynomial.aeval w = u := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [w]
    letI algRB : Algebra R₀ B := u.toRingHom.toAlgebra
    have hSm : RingHom.Smooth u.toRingHom :=
      ((RingHom.etale_iff_formallyUnramified_and_smooth u.toRingHom).mp hu).2
    letI : Algebra.Smooth R₀ B := RingHom.Smooth.toAlgebra hSm
    letI : Module.Flat R₀ B := Algebra.Smooth.flat R₀ B
    letI : Algebra.HasGoingDown R₀ B := Algebra.HasGoingDown.of_flat
    have hPB : (⊥ : Ideal B).IsPrime := Ideal.isPrime_bot
    let q₀ : Ideal R₀ := Ideal.comap (algebraMap R₀ B) (⊥ : Ideal B)
    have hq₀ : q₀.IsPrime := Ideal.IsPrime.comap (algebraMap R₀ B)
    have hLies₀ : (⊥ : Ideal B).LiesOver q₀ := ⟨rfl⟩
    have hP₀ : (⊥ : Ideal R₀).IsPrime := Ideal.isPrime_bot
    obtain ⟨Q, hQ_le, _, hQ_lies⟩ :=
      @Ideal.exists_ideal_le_liesOver_of_le R₀ B _ _ algRB _ (⊥ : Ideal R₀) q₀
        hP₀ hq₀ (⊥ : Ideal B) hPB hLies₀ bot_le
    have hQ_bot : Q = ⊥ := le_bot_iff.mp hQ_le
    subst hQ_bot
    have hker : RingHom.ker u.toRingHom = ⊥ := by
      have hover : (⊥ : Ideal R₀) = Ideal.comap u.toRingHom ⊥ := hQ_lies.over
      exact hover.symm
    have hu_inj : Function.Injective u :=
      (RingHom.injective_iff_ker_eq_bot u.toRingHom).mpr hker
    have hw_ind : AlgebraicIndependent k w := by
      rw [algebraicIndependent_iff_injective_aeval, haeval_eq]
      exact hu_inj
    let F₀ := FractionRing R₀
    haveI : Algebra.IsAlgebraic R₀ F₀ := hAlg_frac R₀
    letI : Algebra.Etale R₀ B := RingHom.Etale.toAlgebra hu
    let T₁ := TensorProduct R₀ F₀ B
    letI : Algebra.Etale F₀ T₁ := Algebra.Etale.baseChange R₀ B F₀
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod F₀ T₁).mp inferInstance
    letI : Finite I := hFinI
    letI : ∀ i, Field (Ai i) := hFieldAi
    letI : ∀ i, Algebra F₀ (Ai i) := hAlgAi
    haveI : ∀ i, Module.Finite F₀ (Ai i) := fun i => (hFinSep i).1
    haveI : Module.Finite F₀ T₁ := Module.Finite.equiv e_prod.symm.toLinearEquiv
    haveI : Algebra.IsIntegral F₀ T₁ := Algebra.IsIntegral.of_finite F₀ T₁
    haveI : Algebra.IsAlgebraic F₀ T₁ := Algebra.IsIntegral.isAlgebraic
    haveI : Algebra.IsAlgebraic R₀ T₁ := Algebra.IsAlgebraic.trans R₀ F₀ T₁
    let T₂ := TensorProduct R₀ B F₀
    let M_R := nonZeroDivisors R₀
    let M_B := Algebra.algebraMapSubmonoid B M_R
    haveI : IsLocalization M_B T₂ := IsLocalization.tensor F₀ M_R
    have hMB_le : M_B ≤ nonZeroDivisors B := by
      rintro y ⟨x, hx_mem, rfl⟩
      have hx_ne : x ≠ 0 := nonZeroDivisors.ne_zero hx_mem
      have hy_ne : u x ≠ 0 := fun h0 => hx_ne (hu_inj (h0.trans (map_zero u).symm))
      exact mem_nonZeroDivisors_of_ne_zero hy_ne
    have hInj_T₂ : Function.Injective (algebraMap B T₂) :=
      IsLocalization.injective T₂ hMB_le
    have hInj_inc : Function.Injective (Algebra.TensorProduct.includeRight : B →ₐ[R₀] T₁) := by
      intro b₁ b₂ hb
      apply hInj_T₂
      have hcomm : ∀ b : B, (Algebra.TensorProduct.comm R₀ F₀ B)
          ((Algebra.TensorProduct.includeRight : B →ₐ[R₀] T₁) b) = algebraMap B T₂ b := by
        intro b
        rfl
      rw [← hcomm b₁, ← hcomm b₂, hb]
    have hAlg_RB : Algebra.IsAlgebraic R₀ B :=
      Algebra.IsAlgebraic.of_injective (Algebra.TensorProduct.includeRight : B →ₐ[R₀] T₁) hInj_inc
    let S_adj := Algebra.adjoin k (Set.range w)
    have hmem_adj : ∀ p : R₀, u p ∈ S_adj := by
      intro p
      dsimp only [S_adj]
      rw [Algebra.adjoin_range_eq_range_aeval, haeval_eq]
      exact ⟨p, rfl⟩
    let e_adj : R₀ →+* ↥S_adj := (u.codRestrict S_adj hmem_adj).toRingHom
    have he_inj : Function.Injective e_adj :=
      fun x y hxy => hu_inj (congrArg Subtype.val hxy)
    have hw_alg : Algebra.IsAlgebraic ↥S_adj B :=
      @hAlg_push R₀ ↥S_adj B _ _ _ algRB _ e_adj he_inj rfl hAlg_RB
    exact isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mpr ⟨hw_ind, hw_alg⟩
  · 
    intro B A _ _ _ _ _ _ ρ w hρ_inj hρ_alg hw
    obtain ⟨hw_ind, hw_alg⟩ := isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hw
    let w' : Fin d → A := fun i => ρ (w i)
    have haeval : MvPolynomial.aeval w' = ρ.comp (MvPolynomial.aeval w) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [w']
    have hw'_ind : AlgebraicIndependent k w' := by
      rw [algebraicIndependent_iff_injective_aeval] at hw_ind ⊢
      rw [haeval]
      exact hρ_inj.comp hw_ind
    let R_B := Algebra.adjoin k (Set.range w)
    let R_A := Algebra.adjoin k (Set.range w')
    let algBA : Algebra B A := ρ.toRingHom.toAlgebra
    let algRBA : Algebra ↥R_B A := (ρ.toRingHom.comp (algebraMap ↥R_B B)).toAlgebra
    have istRBA : @IsScalarTower ↥R_B B A _ algBA.toSMul algRBA.toSMul :=
      @IsScalarTower.of_algebraMap_eq' ↥R_B B A _ _ _ _ algBA algRBA rfl
    have hAlg_RBA : @Algebra.IsAlgebraic ↥R_B A _ _ algRBA :=
      @Algebra.IsAlgebraic.trans ↥R_B B A _ _ _ _ algRBA algBA istRBA _ hw_alg hρ_alg
    have hRB_le : R_B ≤ R_A.comap ρ := by
      apply Algebra.adjoin_le
      rintro _ ⟨i, rfl⟩
      exact Algebra.subset_adjoin ⟨i, rfl⟩
    let e_BA : ↥R_B →+* ↥R_A :=
      ((ρ.comp R_B.val).codRestrict R_A (fun x => hRB_le x.2)).toRingHom
    have he_BA_inj : Function.Injective e_BA :=
      fun x y hxy => Subtype.ext (hρ_inj (congrArg Subtype.val hxy))
    have hw'_alg : Algebra.IsAlgebraic ↥R_A A :=
      @hAlg_push ↥R_B ↥R_A A _ _ _ algRBA _ e_BA he_BA_inj rfl hAlg_RBA
    exact isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mpr ⟨hw'_ind, hw'_alg⟩
  · 
    intro A _ _ _ hFT w hw ψ
    let R₀ := MvPolynomial (Fin d) k
    obtain ⟨hw_ind, hw_alg⟩ := isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hw
    have hψ_inj : Function.Injective ψ := algebraicIndependent_iff_injective_aeval.mp hw_ind
    letI algRA : Algebra R₀ A := ψ.toRingHom.toAlgebra
    let e_R : R₀ ≃ₐ[k] ↥(Algebra.adjoin k (Set.range w)) :=
      (AlgEquiv.ofInjective ψ hψ_inj).trans
        (Subalgebra.equivOfEq _ _ (Algebra.adjoin_range_eq_range_aeval k w).symm)
    have hcomp_R : (algebraMap R₀ A).comp e_R.symm.toRingHom =
        algebraMap ↥(Algebra.adjoin k (Set.range w)) A := by
      apply RingHom.ext
      intro y
      exact congrArg Subtype.val (e_R.apply_symm_apply y)
