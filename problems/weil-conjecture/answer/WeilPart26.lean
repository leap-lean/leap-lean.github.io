          let m_hom := @CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f
            (hExact_pb f).1 (hExact_pb f).2.1 (hExact_pb f).2.2 _ _ Fℤ_B (pf_f.obj Q_2) (2 * δ)
          let post_hom := (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q_2)).postcomp Fℤ_Y
            (Nat.add_zero (2 * δ))
          change post_hom ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_0 f)).comp
              (m_hom (z₁ + z₂)) (Nat.zero_add (2 * δ))) =
            post_hom ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_0 f)).comp
              (m_hom z₁) (Nat.zero_add (2 * δ))) +
            post_hom ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_0 f)).comp
              (m_hom z₂) (Nat.zero_add (2 * δ)))
          rw [map_add m_hom z₁ z₂, CategoryTheory.Abelian.Ext.comp_add, map_add post_hom]
        have he_add : ∀ x₁ x₂ : CategoryTheory.Abelian.Ext Fℤ_Y F (2 * δ'),
            e_to (x₁ + x₂) = e_to x₁ + e_to x₂ := by
          intro x₁ x₂
          have h_sum_lift : ((leray_0 f Q_2 (2 * δ) (qbase_choose x₁ + qbase_choose x₂)).comp
              hSE_1.extClass rfl).comp hSE_0.extClass hr₂ = x₁ + x₂ := by
            rw [hLeray_add, CategoryTheory.Abelian.Ext.add_comp,
              CategoryTheory.Abelian.Ext.add_comp, hqbase_spec x₁, hqbase_spec x₂]
          rw [hEval_can (x₁ + x₂) (qbase_choose x₁ + qbase_choose x₂) h_sum_lift, map_add]
        have he_inj : Function.Injective e_to := by
          intro x₁ x₂ heq
          have h_eq := (hKer_iff (qbase_choose x₁) (qbase_choose x₂)).mpr heq
          rw [hqbase_spec x₁, hqbase_spec x₂] at h_eq
          exact h_eq
        have he_surj : Function.Surjective e_to := by
          intro y
          obtain ⟨q_base, hq⟩ := hSurj_Δ y
          let x := ((leray_0 f Q_2 (2 * δ) q_base).comp hSE_1.extClass rfl).comp
            hSE_0.extClass hr₂
          refine ⟨x, ?_⟩
          rw [hEval_can x q_base rfl, hq]
        let e : CategoryTheory.Abelian.Ext Fℤ_Y F (2 * δ') ≃+
            CategoryTheory.Abelian.Ext Fℤ_B (weilEtaleHigherDirectImage f 2 F) (2 * δ) :=
          AddEquiv.ofBijective (AddMonoidHom.mk' e_to he_add) ⟨he_inj, he_surj⟩
        refine ⟨e, ?_⟩
        intro M_0 Q'_1 M_1 Q'_2 i'_0 p'_0 h0'_0 hSE'_0 i'_1 p'_1 h0'_1 hSE'_1 Δ₂_M
          hTor_M0 hTor_M1 hΔM_sec x q_2 q_base hx hq_leray
        obtain ⟨q_can2, q_can_base, hq_can_ext, hq_can_leray, hΔ_eq⟩ :=
          hChain_lift_nat f h0'_0 hSE'_0 h0'_1 hSE'_1 h0_0 hSE_0 h0_1 hSE_1
            hTor_M0 hTor_M1 hExt_I Δ₂_M Δ₂_can (CategoryTheory.CategoryStruct.id F)
            hΔM_sec hΔ_sec x q_2 q_base hx hq_leray
        have hx_id : (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F)).postcomp
            Fℤ_Y (Nat.add_zero (2 * δ')) x = x :=
          CategoryTheory.Abelian.Ext.comp_mk₀_id x
        rw [hx_id, ← hq_can_leray] at hq_can_ext
        have he_x : e x = (CategoryTheory.Abelian.Ext.mk₀ Δ₂_can).postcomp Fℤ_B
            (Nat.add_zero (2 * δ)) q_can_base :=
          hEval_can x q_can_base hq_can_ext
        have hR2_id : weilTopDegKummerHigherDirectImageMap f 2
            (CategoryTheory.CategoryStruct.id F) =
            CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f 2 F) :=
          (weil_two_step_double_connecting_sheaf_hom_exact_and_natural f (@hc_all Y B f)).1 F
        rw [he_x, hΔ_eq, hR2_id]
        exact CategoryTheory.Abelian.Ext.comp_mk₀_id _

      let E_edge : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y B)
          (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
          n • CategoryTheory.CategoryStruct.id F = 0 →
          (∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F)) →
          CategoryTheory.Abelian.Ext
            ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
            F (2 * δ') ≃+
          CategoryTheory.Abelian.Ext Fℤ_B (weilEtaleHigherDirectImage f 2 F) (2 * δ) :=
        fun Y f F hTor hz => Classical.choose (hEdge_local Y f F hTor hz)
      have hE_char : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y B)
          (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
          (hTor : n • CategoryTheory.CategoryStruct.id F = 0)
          (hz : ∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F)),
          let pf_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback f) AddCommGrpCat.{u} _
            B.smallEtaleTopology Y.smallEtaleTopology (@hc_all Y B f)
          let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          ∀ (M_0 Q_1 M_1 Q_2 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
            (i_0 : Quiver.Hom F M_0) (p_0 : Quiver.Hom M_0 Q_1)
            (h0_0 : CategoryTheory.CategoryStruct.comp i_0 p_0 = 0)
            (hSE_0 : (CategoryTheory.ShortComplex.mk i_0 p_0 h0_0).ShortExact)
            (i_1 : Quiver.Hom Q_1 M_1) (p_1 : Quiver.Hom M_1 Q_2)
            (h0_1 : CategoryTheory.CategoryStruct.comp i_1 p_1 = 0)
            (hSE_1 : (CategoryTheory.ShortComplex.mk i_1 p_1 h0_1).ShortExact)
            (Δ₂_M : Quiver.Hom (pf_f.obj Q_2) (weilEtaleHigherDirectImage f 2 F)),
            n • CategoryTheory.CategoryStruct.id M_0 = 0 →
            n • CategoryTheory.CategoryStruct.id M_1 = 0 →
            (let Q_F : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
               CategoryTheory.Sheaf.cohomologyPresheaf F 2
             let P_F : CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u} :=
               CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_F
             let η_F := (CategoryTheory.sheafificationAdjunction B.smallEtaleTopology
               AddCommGrpCat.{u}).unit.app P_F
             ∀ (V : B.Etale) (s : ↑((pf_f.obj Q_2).obj.obj (Opposite.op V))),
               let U_V : Y.Etale := (weilEtaleSitePullback f).obj V
               let s_ext : ↑(Q_F.obj (Opposite.op U_V)) :=
                 (((CategoryTheory.Abelian.Ext.mk₀
                     ((weilPolyP1CohomologyRepHomEquiv Y U_V Q_2).symm s)).comp
                   hSE_1.extClass (Nat.zero_add 1)).comp
                   hSE_0.extClass (Nat.one_add 1))
               (Δ₂_M.hom.app (Opposite.op V)) s = (η_F.app (Opposite.op V)) s_ext) →
            ∀ (x : CategoryTheory.Abelian.Ext Fℤ_Y F (2 * δ'))
              (q_2 : CategoryTheory.Abelian.Ext Fℤ_Y Q_2 (2 * δ))
              (q_base : CategoryTheory.Abelian.Ext Fℤ_B (pf_f.obj Q_2) (2 * δ)),
              (q_2.comp hSE_1.extClass rfl).comp hSE_0.extClass hr₂ = x →
              leray_0 f Q_2 (2 * δ) q_base = q_2 →
              E_edge Y f F hTor hz x =
                (CategoryTheory.Abelian.Ext.mk₀ Δ₂_M).postcomp Fℤ_B
                  (Nat.add_zero (2 * δ)) q_base :=
        fun Y f F hTor hz => Classical.choose_spec (hEdge_local Y f F hTor hz)

      refine ⟨E_edge, ?_, ?_⟩
      · 
        intro Y f F₁ F₂ φ h₁ h₂ hz₁ hz₂ x
        obtain ⟨I_0, Q_1, I_1, Q_2, i_0, p_0, h0_0, i_1, p_1, h0_1,
          hTor_I0, hTor_Q1, hTor_I1, hTor_Q2, hSE_0, hSE_1, _, hH_acyc, hPush_acyc⟩ :=
          weil_two_step_torsion_injective_resolution_and_ext n hn (@hc_all) (@hr_all) hExact_pb Y F₁ h₁
        obtain ⟨I'_0, Q'_1, I'_1, Q'_2, i'_0, p'_0, h0'_0, i'_1, p'_1, h0'_1,
          hTor_I'0, _, hTor_I'1, _, hSE'_0, hSE'_1, hExt_I', _, _⟩ :=
          weil_two_step_torsion_injective_resolution_and_ext n hn (@hc_all) (@hr_all) hExact_pb Y F₂ h₂
        have hR_I0 : ∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p I_0) :=
          fun p hp => ((hPush_acyc f).1 p hp).1
        have hR_I1 : ∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p I_1) :=
          fun p hp => ((hPush_acyc f).1 p hp).2.1
        have hR_Q2 : ∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p Q_2) :=
          hQ2_acyc f h0_0 hSE_0 h0_1 hSE_1 hz₁ hR_I0 hR_I1
        obtain ⟨Δ₂_1, hΔ₁_sec, hΔ₁_ex_fn⟩ :=
          (weil_two_step_double_connecting_sheaf_hom_exact_and_natural f (@hc_all Y B f)).2.1
            F₁ I_0 Q_1 I_1 Q_2 i_0 p_0 h0_0 hSE_0 i_1 p_1 h0_1 hSE_1
        obtain ⟨h0_Δ₁, hEpi_Δ₁, hEx_Δ₁⟩ := hΔ₁_ex_fn (fun p hp => ⟨hR_I0 p hp, hR_I1 p hp⟩)
        obtain ⟨Δ₂_2, hΔ₂_sec, _⟩ :=
          (weil_two_step_double_connecting_sheaf_hom_exact_and_natural f (@hc_all Y B f)).2.1
            F₂ I'_0 Q'_1 I'_1 Q'_2 i'_0 p'_0 h0'_0 hSE'_0 i'_1 p'_1 h0'_1 hSE'_1
        obtain ⟨hLift₁, _, _⟩ :=
          (weil_two_step_leray_syzygy_lift_and_well_defined n δ δ' hδ f
            (@hc_all Y B f) (@hr_all Y B f)).2 hCD_B hr₂
            (hExact_pb f).1 (hExact_pb f).2.1 (hExact_pb f).2.2 (ιℤ_0 f)
            F₁ I_0 Q_1 I_1 Q_2 (weilEtaleHigherDirectImage f 2 F₁)
            i_0 p_0 h0_0 hSE_0 i_1 p_1 h0_1 hSE_1 Δ₂_1 h0_Δ₁
            hTor_Q1 hTor_Q2
            ((hH_acyc (2 * δ') (by omega)).1)
            ((hH_acyc (2 * δ + 1) (by omega)).1)
            ((hH_acyc (2 * δ + 1) (by omega)).2)
            hEpi_Δ₁ hEx_Δ₁
            (hLeray_bij f I_1 hR_I1 (2 * δ))
            (hLeray_bij f Q_2 hR_Q2 (2 * δ))
            (fun m_base => hLeray_nat f p_1 (2 * δ) m_base)
        obtain ⟨q_2, q_base, hx, hq_leray⟩ := hLift₁ x
        obtain ⟨q'_2, q'_base, hq'_ext, hq'_leray, hΔ_eq⟩ :=
          hChain_lift_nat f h0_0 hSE_0 h0_1 hSE_1 h0'_0 hSE'_0 h0'_1 hSE'_1
            hTor_I0 hTor_I1 hExt_I' Δ₂_1 Δ₂_2 φ hΔ₁_sec hΔ₂_sec x q_2 q_base hx hq_leray
        have he₁ : E_edge Y f F₁ h₁ hz₁ x =
            (CategoryTheory.Abelian.Ext.mk₀ Δ₂_1).postcomp Fℤ_B (Nat.add_zero (2 * δ)) q_base :=
          hE_char Y f F₁ h₁ hz₁ I_0 Q_1 I_1 Q_2 i_0 p_0 h0_0 hSE_0 i_1 p_1 h0_1 hSE_1 Δ₂_1
            hTor_I0 hTor_I1 hΔ₁_sec x q_2 q_base hx hq_leray
        have he₂ : E_edge Y f F₂ h₂ hz₂
              ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
                ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
                (Nat.add_zero (2 * δ')) x) =
            (CategoryTheory.Abelian.Ext.mk₀ Δ₂_2).postcomp Fℤ_B (Nat.add_zero (2 * δ)) q'_base :=
          hE_char Y f F₂ h₂ hz₂ I'_0 Q'_1 I'_1 Q'_2 i'_0 p'_0 h0'_0 hSE'_0 i'_1 p'_1 h0'_1 hSE'_1 Δ₂_2
            hTor_I'0 hTor_I'1 hΔ₂_sec _ q'_2 q'_base hq'_ext hq'_leray
        rw [he₂, hΔ_eq, ← he₁]

      · 
        intro Y f F M_0 Q_1 M_1 Q_2 i_0 p_0 h0_0 hSE_0 i_1 p_1 h0_1 hSE_1
          hTor hz pf_f pb_f adj_f Fℤ_Y hTor_M0 hTor_Q1 hTor_M1 hTor_Q2 hH_M hR_M
        obtain ⟨Δ₂, hΔ_sec, hΔ_ex_fn⟩ :=
          (weil_two_step_double_connecting_sheaf_hom_exact_and_natural f (@hc_all Y B f)).2.1
            F M_0 Q_1 M_1 Q_2 i_0 p_0 h0_0 hSE_0 i_1 p_1 h0_1 hSE_1
        have hR_M0 : ∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p M_0) :=
          fun p hp => (hR_M p hp).1
        have hR_M1 : ∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p M_1) :=
          fun p hp => (hR_M p hp).2.1
        have hR_Q2 : ∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p Q_2) :=
          hQ2_acyc f h0_0 hSE_0 h0_1 hSE_1 hz hR_M0 hR_M1
        obtain ⟨h0_Δ, hEpi_Δ, hEx_Δ⟩ := hΔ_ex_fn (fun p hp => ⟨hR_M0 p hp, hR_M1 p hp⟩)
        refine ⟨Δ₂, hΔ_sec, ?_⟩
        intro hr₂_c hAdd_f hLim_f hColim_f T_Y hT_Y T_B hT_B ιℤ_f h_ιπ_f _h_πι_f
        obtain ⟨T_Y0, hT_Y0, T_B0, hT_B0, _h_ιπ_0, h_πι_0⟩ := hιℤ_0_spec f
        have h_π_eq : @weilEtaleConstPullbackHom _ _ f (@hc_all Y B f) (@hr_all Y B f)
            T_Y hT_Y T_B hT_B Aℤ =
          @weilEtaleConstPullbackHom _ _ f (@hc_all Y B f) (@hr_all Y B f)
            T_Y0 hT_Y0 T_B0 hT_B0 Aℤ :=
          (weil_two_step_leray_syzygy_lift_and_well_defined n δ δ' hδ f
            (@hc_all Y B f) (@hr_all Y B f)).1 hT_Y hT_B hT_Y0 hT_B0 Aℤ
        have h_ι_eq : ιℤ_f = ιℤ_0 f := by
          calc
            ιℤ_f = CategoryTheory.CategoryStruct.comp ιℤ_f
                (CategoryTheory.CategoryStruct.id (pb_f.obj Fℤ_B)) :=
                (CategoryTheory.Category.comp_id _).symm
            _ = CategoryTheory.CategoryStruct.comp ιℤ_f
                (CategoryTheory.CategoryStruct.comp
                  (@weilEtaleConstPullbackHom _ _ f (@hc_all Y B f) (@hr_all Y B f)
                    T_Y0 hT_Y0 T_B0 hT_B0 Aℤ)
                  (ιℤ_0 f)) := by rw [h_πι_0]
            _ = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp ιℤ_f
                  (@weilEtaleConstPullbackHom _ _ f (@hc_all Y B f) (@hr_all Y B f)
                    T_Y hT_Y T_B hT_B Aℤ))
                (ιℤ_0 f) := by rw [← h_π_eq, CategoryTheory.Category.assoc]
            _ = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.id Fℤ_Y) (ιℤ_0 f) := by rw [h_ιπ_f]
            _ = ιℤ_0 f := CategoryTheory.Category.id_comp _
        have hAdd_eq : hAdd_f = (hExact_pb f).1 := Subsingleton.elim _ _
        have hLim_eq : hLim_f = (hExact_pb f).2.1 := Subsingleton.elim _ _
        have hColim_eq : hColim_f = (hExact_pb f).2.2 := Subsingleton.elim _ _
        subst h_ι_eq
        subst hAdd_eq
        subst hLim_eq
        subst hColim_eq
        rw [Subsingleton.elim hr₂_c hr₂]
        obtain ⟨hLift_M, _, _⟩ :=
          (weil_two_step_leray_syzygy_lift_and_well_defined n δ δ' hδ f
            (@hc_all Y B f) (@hr_all Y B f)).2 hCD_B hr₂
            (hExact_pb f).1 (hExact_pb f).2.1 (hExact_pb f).2.2 (ιℤ_0 f)
            F M_0 Q_1 M_1 Q_2 (weilEtaleHigherDirectImage f 2 F)
            i_0 p_0 h0_0 hSE_0 i_1 p_1 h0_1 hSE_1 Δ₂ h0_Δ
            hTor_Q1 hTor_Q2
            ((hH_M (2 * δ') (by omega)).1)
            ((hH_M (2 * δ + 1) (by omega)).1)
            ((hH_M (2 * δ + 1) (by omega)).2)
            hEpi_Δ hEx_Δ
            (hLeray_bij f M_1 hR_M1 (2 * δ))
            (hLeray_bij f Q_2 hR_Q2 (2 * δ))
            (fun m_base => hLeray_nat f p_1 (2 * δ) m_base)
        refine ⟨hLift_M, ?_⟩
        intro x q_2 q_base hx hq_leray
        exact hE_char Y f F hTor hz M_0 Q_1 M_1 Q_2 i_0 p_0 h0_0 hSE_0 i_1 p_1 h0_1 hSE_1 Δ₂
          hTor_M0 hTor_M1 hΔ_sec x q_2 q_base hx hq_leray

theorem weil_algClosed_spec_sheaf_const_and_kPoint_isZero (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
    (hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f)).IsRightAdjoint)
    (hExact_pb : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f) (@hr_all X₁ X₂ f)
      pb.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb)
    (hUnitIso_k : ∀ P : CategoryTheory.Functor
        (Opposite (AlgebraicGeometry.Spec (CommRingCat.of k)).Etale) AddCommGrpCat.{u},
      CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P).app
          (Opposite.op (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k))))))
    (hCD1_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
       (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : Ω) ≠ 0 →
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper C.hom],
        topologicalKrullDim C.left ≤ (1 : WithBot ℕ∞) →
        ∀ (G : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id G = 0 →
          ∀ (q : ℕ), 2 < q → Subsingleton (G.H q)) :
    let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
    let J_k := S_k.smallEtaleTopology
    let T_0 : S_k.Etale := weilEtaleIdTerminal.{u} S_k
    let hT_0 : CategoryTheory.Limits.IsTerminal T_0 := weilEtaleIdTerminalIsTerminal.{u} S_k
    let pb_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
    let adj_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
        (A : AddCommGrpCat.{u}),
      (∀ {T₁ T'₁ : X₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          (hT'₁ : CategoryTheory.Limits.IsTerminal T'₁)
          {T₂ T'₂ : X₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          (hT'₂ : CategoryTheory.Limits.IsTerminal T'₂),
        @weilEtaleConstPullbackHom _ _ f (@hc_all X₁ X₂ f) (@hr_all X₁ X₂ f) T₁ hT₁ T₂ hT₂ A =
          @weilEtaleConstPullbackHom _ _ f (@hc_all X₁ X₂ f) (@hr_all X₁ X₂ f) T'₁ hT'₁ T'₂ hT'₂ A) ∧
      (∀ {T₁ : X₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          {T₂ : X₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
