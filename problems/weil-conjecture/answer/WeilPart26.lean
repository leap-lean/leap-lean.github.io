        inv_hom_id := by
          apply CategoryTheory.Limits.Pi.hom_ext; intro a
          rw [CategoryTheory.Category.assoc, hPiLiftπ, ← CategoryTheory.Category.assoc, hPiLiftπ,
            CategoryTheory.Category.assoc, ← (pf_fun a).map_comp, e_loc_B.inv_hom_id,
            (pf_fun a).map_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    let e_Q_prod : Q_bdry ≅ Q_prod_sh := e_Q ≪≫ e_prod.symm
    let ρ_prod : L_loc_Y ⟶ Q_prod_sh :=
      CategoryTheory.ObjectProperty.homMk
        { app := fun opW => AddCommGrpCat.ofHom
            { toFun := fun g a => ((weilAltLocConstPullbackNat (τ a) n).app opW).hom g
              map_zero' := funext fun a =>
                map_zero ((weilAltLocConstPullbackNat (τ a) n).app opW).hom
              map_add' := fun g₁ g₂ => funext fun a =>
                map_add ((weilAltLocConstPullbackNat (τ a) n).app opW).hom g₁ g₂ }
          naturality := fun {W₁ W₂} u => by
            apply AddCommGrpCat.ext; intro g; funext a
            exact congrArg (fun k => k.hom g) ((weilAltLocConstPullbackNat (τ a) n).naturality u) }
    have hρ_sq : e_loc_Y.hom ≫ ρ_prod = ρ ≫ e_Q_prod.hom := by
      have h1 : (e_loc_Y.hom ≫ ρ_prod) ≫ e_prod.hom = ρ ≫ e_Q.hom := by
        apply CategoryTheory.Limits.Pi.hom_ext; intro a
        change (e_loc_Y.hom ≫ ρ_prod) ≫ (prodToPi ≫ CategoryTheory.Limits.Pi.π pf_loc_a a) =
          ρ ≫ (e_Q.hom ≫ CategoryTheory.Limits.Pi.π pf_loc_a a)
        dsimp only [e_Q]
        rw [hPiLiftπ, hPiLiftπ, ← CategoryTheory.Category.assoc ρ, hPiLiftπ, hSq_a a,
          CategoryTheory.Category.assoc]
        congr 1
      have h2 := congrArg (· ≫ e_prod.inv) h1
      dsimp only [e_Q_prod, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
      rwa [CategoryTheory.Category.assoc, e_prod.hom_inv_id, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.assoc] at h2

    have h0_prod : ι_zero_Y ≫ ρ_prod = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext; funext opW
      let W := opW.unop
      apply AddCommGrpCat.ext; intro g0; funext a
      apply LocallyConstant.ext; intro p
      have hp_not_W : W.hom.base
          ((CategoryTheory.Limits.pullback.fst W.hom (τ a)).base p) ∉ (W_open : Set ↥Y₀) := by
        rw [hW, Set.mem_compl_iff, not_not, Set.mem_iUnion]
        refine ⟨a, (CategoryTheory.Limits.pullback.snd W.hom (τ a)).base p, ?_⟩
        exact (congrArg (fun k : _ ⟶ Y₀ => k.base p)
          (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := τ a))).symm
      exact g0.2 _ hp_not_W

    haveI : CategoryTheory.Mono ι_zero_Y := by
      refine ⟨fun {E} k₁ k₂ hk => ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext; funext opW
      apply AddCommGrpCat.ext; intro e
      apply Subtype.ext
      exact congrArg (fun k : E ⟶ L_loc_Y => (k.hom.app opW).hom e) hk

    have hKer_prod : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι ι_zero_Y h0_prod) := by
      have hw_lift_ex : ∀ {E : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
          (w : E ⟶ L_loc_Y), w ≫ ρ_prod = 0 →
          ∃ w_lift : E ⟶ K_zero_Y, w_lift ≫ ι_zero_Y = w := by
        intro E w hw
        have hw_bdry : ∀ (W : Y₀.Etale) (e : ↥(E.obj.obj (Opposite.op W))),
            (w.hom.app (Opposite.op W)).hom e ∈ weilAltZeroBdrySubgroup Y₀ W_open n W := by
          intro W e x hx_not
          rw [hW, Set.mem_compl_iff, not_not, Set.mem_iUnion] at hx_not
          obtain ⟨a, b, hab⟩ := hx_not
          obtain ⟨p, hp_fst, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
              (f := W.hom) (g := τ a) x b hab.symm
          have hev := congrArg (fun k : E ⟶ Q_prod_sh =>
            (((k.hom.app (Opposite.op W)).hom e) a) p) hw
          let g_w : LocallyConstant ↥W.left A := (w.hom.app (Opposite.op W)).hom e
          change g_w ((CategoryTheory.Limits.pullback.fst W.hom (τ a)).base p) = 0 at hev
          change g_w x = 0
          rwa [hp_fst] at hev
        refine ⟨CategoryTheory.ObjectProperty.homMk
          { app := fun opW => AddCommGrpCat.ofHom
              { toFun := fun e => ⟨(w.hom.app opW).hom e, hw_bdry opW.unop e⟩
                map_zero' := Subtype.ext (map_zero (w.hom.app opW).hom)
                map_add' := fun e₁ e₂ => Subtype.ext (map_add (w.hom.app opW).hom e₁ e₂) }
            naturality := fun {W₁ W₂} u => by
              apply AddCommGrpCat.ext; intro e; apply Subtype.ext
              exact congrArg (fun k => k.hom e) (w.hom.naturality u) }, ?_⟩
