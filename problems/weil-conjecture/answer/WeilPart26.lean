    | succ δ ih =>
      rcases ih with ⟨hProp_δ, hSm_δ, _hInt_δ, u_δ, s_δ, hu_false, hu_open, hu_over,
        hu_cov, hs_over, hs_mem⟩
      have _ : AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom := hProp_δ
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension δ (weilPolyP1Over k δ).hom := hSm_δ
      let P_succ := CategoryTheory.Limits.pullback (weilPolyP1Over k δ).hom P_1.hom
      let π₁ : P_succ ⟶ (weilPolyP1Over k δ).left :=
        CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom P_1.hom
      let π₂ : P_succ ⟶ P_1.left :=
        CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom P_1.hom
      have hProp_succ : AlgebraicGeometry.IsProper (weilPolyP1Over k (δ + 1)).hom := by
        change AlgebraicGeometry.IsProper (π₁ ≫ (weilPolyP1Over k δ).hom)
        infer_instance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 π₁ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback (weilPolyP1Over k δ).hom P_1.hom).flip hSm1
      have hSm_succ : AlgebraicGeometry.SmoothOfRelativeDimension (δ + 1)
          (weilPolyP1Over k (δ + 1)).hom := by
        change AlgebraicGeometry.SmoothOfRelativeDimension (δ + 1) (π₁ ≫ (weilPolyP1Over k δ).hom)
        have hcomp := AlgebraicGeometry.smoothOfRelativeDimension_comp 1 δ π₁
          (weilPolyP1Over k δ).hom
        rwa [Nat.add_comm 1 δ] at hcomp
      let v_P1 : Bool → (A_1 ⟶ P_1.left) := fun b => cond b ι_inf ι_P1
      have hv_open : ∀ b : Bool, AlgebraicGeometry.IsOpenImmersion (v_P1 b) := by
        intro b; cases b; exact hOpen_P1; exact hOpen_inf
      have hv_over : ∀ b : Bool, v_P1 b ≫ P_1.hom = f_A1 := by
        intro b; cases b
        · exact hOver_P1
        · exact hOver_inf
      let A_succ := (weilAffineSpaceOver k (δ + 1)).left
      let Φ_δ : A_succ ⟶ CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom f_A1 :=
        CategoryTheory.Limits.pullback.lift
          (p_head δ) (p_last δ) ((h_head_over δ).trans (h_last_over δ).symm)
      have _ : CategoryTheory.IsIso Φ_δ := hSplitIso δ
