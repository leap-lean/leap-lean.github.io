        (∀ σ : Fin δ → Bool, Set.range s_δ.base ⊆ Set.range (u_δ σ).base) := by
    intro δ
    induction δ with
    | zero =>
      refine ⟨?_, ?_, ?_, ?_⟩
      · change AlgebraicGeometry.IsProper (𝟙 S_k)
        infer_instance
      · change AlgebraicGeometry.SmoothOfRelativeDimension 0 (𝟙 S_k)
        infer_instance
      · exact @AlgebraicGeometry.instIsIntegralSpecOfIsDomainCarrier
          (CommRingCat.of k) (inferInstance : IsDomain k)
      · refine ⟨fun _ => (weilAffineSpaceOver k 0).hom, 𝟙 S_k, rfl, ?_, ?_, ?_, ?_, ?_⟩
        · intro _
          exact inferInstanceAs (AlgebraicGeometry.IsOpenImmersion (weilAffineSpaceOver k 0).hom)
        · intro _
          exact Category.comp_id _
        · ext z
          simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
          have hsurj : Function.Surjective (weilAffineSpaceOver k 0).hom.base :=
            (AlgebraicGeometry.Scheme.Hom.homeomorph (weilAffineSpaceOver k 0).hom).surjective
