              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
              (Nat.zero_add q) rfl (by omega) }
    refine ⟨fun {SC} hSE q => E_B.map (δ_pre hSE q), ?_, ?_⟩
    · intro SC hSE q
      have hg_app : ∀ (W : Opposite Y.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map SC.g).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.g
      have hf_app : ∀ (W : Opposite Y.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map SC.f).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) SC.f
      have hcomp₁_pre :
          (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map SC.g ≫ δ_pre hSE q = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        have hz : AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) ≫
            AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hg_app W]
        exact congrArg (fun φ => φ x) hz
      have hcomp₂_pre :
          δ_pre hSE q ≫ (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map SC.f = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        have hz : AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W]
        exact congrArg (fun φ => φ x) hz
      let A_pre := CategoryTheory.ShortComplex.mk
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map SC.g) (δ_pre hSE q) hcomp₁_pre
      let B_pre := CategoryTheory.ShortComplex.mk
        (δ_pre hSE q) ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map SC.f) hcomp₂_pre
      have hA_pre_ex : A_pre.Exact := by
        apply hPresheafExact A_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        let eW : A_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [A_pre, evW]; rw [hg_app W]; ext x; rfl)
            (by dsimp [A_pre, evW, δ_pre]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have hB_pre_ex : B_pre.Exact := by
        apply hPresheafExact B_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        let eW : B_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [B_pre, evW, δ_pre]; ext x; rfl)
            (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have h0_left : weilEtaleHigherDirectImageMap π q SC.g ≫ E_B.map (δ_pre hSE q) = 0 := by
        change E_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map SC.g) ≫
          E_B.map (δ_pre hSE q) = 0
        rw [← E_B.map_comp, hcomp₁_pre, E_B.map_zero]
      have h0_right : E_B.map (δ_pre hSE q) ≫ weilEtaleHigherDirectImageMap π (q + 1) SC.f = 0 := by
        change E_B.map (δ_pre hSE q) ≫
          E_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map SC.f) = 0
        rw [← E_B.map_comp, hcomp₂_pre, E_B.map_zero]
      exact ⟨h0_left, h0_right, (hA_pre_ex.map W_B).map Sh_B, (hB_pre_ex.map W_B).map Sh_B⟩
    · intro SC₁ SC₂ hSE₁ hSE₂ Φ q
      change E_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map Φ.τ₃) ≫
          E_B.map (δ_pre hSE₂ q) =
        E_B.map (δ_pre hSE₁ q) ≫
          E_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map Φ.τ₁)
      rw [← E_B.map_comp, ← E_B.map_comp]
      congr 1
      ext W x
      have hτ₃_app :
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map Φ.τ₃).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ Φ.τ₃).postcomp (Z_obj W) (Nat.add_zero q)) :=
        CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q Φ.τ₃
      have hτ₁_app :
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map Φ.τ₁).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ Φ.τ₁).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
        CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) Φ.τ₁
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.comp_app, hτ₃_app, hτ₁_app]
