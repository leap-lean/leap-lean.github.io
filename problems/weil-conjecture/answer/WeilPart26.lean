    letI : CategoryTheory.Mono (pf.map (ι₁ F₂)) := hMono_i₁₂
    letI : CategoryTheory.Mono (pf.map (ι₁ F₁)) := hMono_i₁₁
    have h_ij₂ : pf.map (ι₁ F₂) ≫ pf.map (π₁ F₂) = 0 := by
