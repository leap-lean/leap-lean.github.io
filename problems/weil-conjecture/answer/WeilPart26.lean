by
  classical
  have hSitePkg :
      ∃ (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
          (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
        (_hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
          (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
            AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint),
        True := by
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong P_et f :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et f :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have hPresLimB : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.Limits.PreservesFiniteLimits (weilEtaleSitePullback f) := by
      intro Z₁ Z₂ f
      let B_f : CategoryTheory.Functor Z₂.Etale Z₁.Etale := weilEtaleSitePullback f
      have hCompEq : B_f ⋙ AlgebraicGeometry.Scheme.Etale.forget Z₁ =
          AlgebraicGeometry.Scheme.Etale.forget Z₂ ⋙ CategoryTheory.Over.pullback f := rfl
      have : CategoryTheory.Limits.PreservesFiniteLimits
          (B_f ⋙ AlgebraicGeometry.Scheme.Etale.forget Z₁) := by
        rw [hCompEq]
        infer_instance
      exact CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves
        B_f (AlgebraicGeometry.Scheme.Etale.forget Z₁)
    have hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := by
      intro Z₁ Z₂ f
      let B_f : CategoryTheory.Functor Z₂.Etale Z₁.Etale := weilEtaleSitePullback f
      have : CategoryTheory.Limits.PreservesFiniteLimits B_f := hPresLimB f
      have : CategoryTheory.RepresentablyFlat B_f :=
        CategoryTheory.flat_of_preservesFiniteLimits B_f
      have hCompat : CategoryTheory.CompatiblePreserving Z₁.smallEtaleTopology B_f :=
        CategoryTheory.compatiblePreservingOfFlat Z₁.smallEtaleTopology B_f
      have hCov : CategoryTheory.CoverPreserving Z₂.smallEtaleTopology Z₁.smallEtaleTopology B_f := by
        refine CategoryTheory.CoverPreserving.mk ?_
        intro U S hS
        have hEq₂ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) Z₂ (le_refl P_et)
        have hEq₁ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) Z₁ (le_refl P_et)
        have hS' : S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U :=
          Eq.mp (congrArg (fun T => S ∈ T U) hEq₂) hS
        have hMem₂ := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := Z₂) U S).mp hS'
        have hGoal' : CategoryTheory.Sieve.functorPushforward B_f S ∈
            (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck (B_f.obj U) := by
          refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) (S := Z₁) (B_f.obj U) _).mpr ?_
          intro x₁
          let u_hom : Quiver.Hom U.left Z₂ := U.hom
          let fst_U : Quiver.Hom (B_f.obj U).left U.left := CategoryTheory.Limits.pullback.fst u_hom f
          let snd_U : Quiver.Hom (B_f.obj U).left Z₁ := CategoryTheory.Limits.pullback.snd u_hom f
          obtain ⟨Y_et, g, y, hgS, hgEt, hgy⟩ := hMem₂ (fst_U.base x₁)
          let y_hom : Quiver.Hom Y_et.left Z₂ := Y_et.hom
          let g_left : Quiver.Hom Y_et.left U.left := g.left
          have hgEt' : P_et g_left := hgEt
          let bg_left : Quiver.Hom (B_f.obj Y_et).left (B_f.obj U).left := (B_f.map g).left
          let fst_Y : Quiver.Hom (B_f.obj Y_et).left Y_et.left := CategoryTheory.Limits.pullback.fst y_hom f
          have hPb_U : CategoryTheory.IsPullback fst_U snd_U u_hom f :=
            CategoryTheory.IsPullback.of_hasPullback u_hom f
          have h_top : bg_left ≫ snd_U = CategoryTheory.Limits.pullback.snd y_hom f :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have h_bot : g_left ≫ u_hom = y_hom := CategoryTheory.MorphismProperty.Over.w g
          have hPb_tot : CategoryTheory.IsPullback fst_Y (bg_left ≫ snd_U) (g_left ≫ u_hom) f := by
            rw [h_top, h_bot]
            exact CategoryTheory.IsPullback.of_hasPullback y_hom f
          have h_sq : bg_left ≫ fst_U = fst_Y ≫ g_left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hPb_left : CategoryTheory.IsPullback fst_Y bg_left g_left fst_U :=
            (CategoryTheory.IsPullback.of_right hPb_tot.flip h_sq hPb_U.flip).flip
          have hbg_et : P_et bg_left :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_left hgEt'
          obtain ⟨p, -, hp_x₁⟩ :=
            AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_left y x₁ hgy
          refine ⟨B_f.obj Y_et, B_f.map g, p, ?_, hbg_et, hp_x₁⟩
          exact ⟨Y_et, g, CategoryTheory.CategoryStruct.id (B_f.obj Y_et), hgS,
            (CategoryTheory.Category.id_comp (B_f.map g)).symm⟩
        exact Eq.mpr (congrArg (fun T => CategoryTheory.Sieve.functorPushforward B_f S ∈ T (B_f.obj U)) hEq₁) hGoal'
      exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
    have hSmallAffCoverDense : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        ((CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse ⋙
          AlgebraicGeometry.Scheme.AffineEtale.Spec Z).IsCoverDense Z.smallEtaleTopology := by
      intro Z
