        intro V₂ V₁ u
        let θ_u : P_pre V₂ ⟶ P_pre V₁ :=
          CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free
        have hnat_sh := η_sh.naturality θ_u
        have happ := congrArg (fun (α : P_pre V₂ ⟶ _) =>
          (α.app (Opposite.op V₂)).hom ((η_fr.app (V₂ ⟶ V₂)) (𝟙 V₂))) hnat_sh
        change ((η_sh.app (P_pre V₁)).app (Opposite.op V₂)).hom
            ((θ_u.app (Opposite.op V₂)).hom ((η_fr.app (V₂ ⟶ V₂)) (𝟙 V₂))) =
          ((Z_fun.map u).hom.app (Opposite.op V₂)).hom (gen₀ V₂) at happ
        rw [← happ]
        have hfr₁ := congrArg (fun f => f (𝟙 V₂))
          (η_fr.naturality ((CategoryTheory.yoneda.map u).app (Opposite.op V₂)))
        change (θ_u.app (Opposite.op V₂)).hom ((η_fr.app (V₂ ⟶ V₂)) (𝟙 V₂)) =
          (η_fr.app (V₂ ⟶ V₁)) (𝟙 V₂ ≫ u) at hfr₁
        have hfr₂ := congrArg (fun f => f (𝟙 V₁))
          (η_fr.naturality ((CategoryTheory.yoneda.obj V₁).map (Opposite.op u)))
        change ((P_pre V₁).map (Opposite.op u)).hom ((η_fr.app (V₁ ⟶ V₁)) (𝟙 V₁)) =
          (η_fr.app (V₂ ⟶ V₁)) (u ≫ 𝟙 V₁) at hfr₂
        have hθ_eq : (θ_u.app (Opposite.op V₂)).hom ((η_fr.app (V₂ ⟶ V₂)) (𝟙 V₂)) =
            ((P_pre V₁).map (Opposite.op u)).hom ((η_fr.app (V₁ ⟶ V₁)) (𝟙 V₁)) := by
          rw [hfr₁, CategoryTheory.Category.id_comp, hfr₂, CategoryTheory.Category.comp_id]
        rw [hθ_eq]
        have hnat_V₁ := congrArg (fun (α : (P_pre V₁).obj (Opposite.op V₁) ⟶ _) =>
          α.hom ((η_fr.app (V₁ ⟶ V₁)) (𝟙 V₁)))
          ((η_sh.app (P_pre V₁)).naturality (Opposite.op u))
        exact hnat_V₁
      let evAddEquiv : ∀ (G : CategoryTheory.Sheaf J_B AddCommGrpCat.{u}) (W : (B₀.Etale)ᵒᵖ),
          ↑((G.cohomologyPresheaf 0).obj W) ≃+ ↑(G.obj.obj W) :=
        fun G W =>
          { toEquiv := CategoryTheory.Abelian.Ext.homEquiv₀.trans
              (weilPolyP1CohomologyRepHomEquiv B₀ W.unop G)
            map_add' := fun x₁ x₂ => by
              let φ₁ : weilPolyP1CohomologyRepSheaf B₀ W.unop ⟶ G :=
                CategoryTheory.Abelian.Ext.addEquiv₀ x₁
              let φ₂ : weilPolyP1CohomologyRepSheaf B₀ W.unop ⟶ G :=
                CategoryTheory.Abelian.Ext.addEquiv₀ x₂
              have hx₁₂ : CategoryTheory.Abelian.Ext.homEquiv₀ (x₁ + x₂) = φ₁ + φ₂ :=
                map_add CategoryTheory.Abelian.Ext.addEquiv₀ x₁ x₂
              change weilPolyP1CohomologyRepHomEquiv B₀ W.unop G
                  (CategoryTheory.Abelian.Ext.homEquiv₀ (x₁ + x₂)) =
                weilPolyP1CohomologyRepHomEquiv B₀ W.unop G φ₁ +
                  weilPolyP1CohomologyRepHomEquiv B₀ W.unop G φ₂
              rw [hx₁₂, hRepApply, hRepApply, hRepApply]
              rfl }
      let evNatIso : ∀ (G : CategoryTheory.Sheaf J_B AddCommGrpCat.{u}),
          G.cohomologyPresheaf 0 ≅ G.obj :=
        fun G => CategoryTheory.NatIso.ofComponents
          (fun W => (evAddEquiv G W).toAddCommGrpIso)
          (fun {W₁ W₂} ω => by
            have hω : (G.cohomologyPresheaf 0).map ω =
                ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app G := rfl
            rw [hω, CategoryTheory.Abelian.extFunctor_map_app]
            apply AddCommGrpCat.hom_ext
            ext x
            rw [AddEquiv.toAddCommGrpIso_hom, AddEquiv.toAddCommGrpIso_hom]
            let φ : weilPolyP1CohomologyRepSheaf B₀ W₁.unop ⟶ G :=
              CategoryTheory.Abelian.Ext.homEquiv₀ x
            have hx : x = CategoryTheory.Abelian.Ext.mk₀ φ := by
              rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
              exact (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x).symm
            change (evAddEquiv G W₂)
                ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)).comp x (Nat.zero_add 0)) =
              (G.obj.map ω).hom ((evAddEquiv G W₁) x)
            rw [hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
            change weilPolyP1CohomologyRepHomEquiv B₀ W₂.unop G
                (CategoryTheory.Abelian.Ext.homEquiv₀
                  (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop ≫ φ))) =
              (G.obj.map ω).hom
                (weilPolyP1CohomologyRepHomEquiv B₀ W₁.unop G
                  (CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ φ)))
            rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
              ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
              Equiv.apply_symm_apply, Equiv.apply_symm_apply, hRepApply, hRepApply]
            change (φ.hom.app (Opposite.op W₂.unop)).hom
                (((Z_fun.map ω.unop).hom.app (Opposite.op W₂.unop)).hom (gen₀ W₂.unop)) =
              (G.obj.map ω).hom ((φ.hom.app (Opposite.op W₁.unop)).hom (gen₀ W₁.unop))
            rw [hGenMap ω.unop]
            have hnat_φ := congrArg (fun (α : (weilPolyP1CohomologyRepSheaf B₀ W₁.unop).obj.obj W₁ ⟶
                G.obj.obj W₂) => α.hom (gen₀ W₁.unop)) (φ.hom.naturality ω)
            exact hnat_φ)

      have hP_ses : ∀ (S₀ : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_B AddCommGrpCat.{u})),
          S₀.ShortExact → CategoryTheory.Injective S₀.X₂ → P_acyc S₀.X₁ →
            (S₀.map R).ShortExact ∧ P_acyc S₀.X₃ := by
        intro S₀ hSE₀ hInj₂ hPX₁
        haveI : CategoryTheory.Injective S₀.X₂ := hInj₂
        let δ_nat : ∀ r : ℕ,
            S₀.X₃.cohomologyPresheaf r ⟶ S₀.X₁.cohomologyPresheaf (r + 1) :=
          fun r =>
            { app := fun W => AddCommGrpCat.ofHom
                (hSE₀.extClass.postcomp (weilPolyP1CohomologyRepSheaf B₀ W.unop) rfl)
              naturality := fun {W₁ W₂} ω => by
                have hω₁ : (S₀.X₃.cohomologyPresheaf r).map ω =
                    ((CategoryTheory.Abelian.extFunctor r).map (Z_fun.op.map ω)).app S₀.X₃ := rfl
                have hω₂ : (S₀.X₁.cohomologyPresheaf (r + 1)).map ω =
                    ((CategoryTheory.Abelian.extFunctor (r + 1)).map (Z_fun.op.map ω)).app S₀.X₁ := rfl
                rw [hω₁, hω₂, CategoryTheory.Abelian.extFunctor_map_app,
                  CategoryTheory.Abelian.extFunctor_map_app]
                apply AddCommGrpCat.hom_ext
                ext x
                change ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)).comp x (Nat.zero_add r)).comp
                    hSE₀.extClass rfl =
                  (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)).comp
                    (x.comp hSE₀.extClass rfl) (Nat.zero_add (r + 1))
                exact CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add r) rfl (by omega) }
        refine ⟨?_, ?_⟩
        · have hLimR := (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono R).mp
            inferInstance S₀ hSE₀
          let H₀_pre := CategoryTheory.Sheaf.cohomologyPresheafFunctor J_B 0
          have hComp0 : H₀_pre.map S₀.g ≫ δ_nat 0 = 0 := by
            ext W x
            let x₀ : CategoryTheory.Abelian.Ext
                (weilPolyP1CohomologyRepSheaf B₀ W.unop) S₀.X₂ 0 := x
            change (x₀.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.g) (Nat.add_zero 0)).comp
              hSE₀.extClass (Nat.zero_add 1) = 0
            rw [CategoryTheory.Abelian.Ext.comp_assoc x₀ _ _ (Nat.add_zero 0) (Nat.zero_add 1)
                (by omega),
              CategoryTheory.ShortComplex.ShortExact.comp_extClass hSE₀,
              CategoryTheory.Abelian.Ext.comp_zero]
          let SC₀ : CategoryTheory.ShortComplex ((B₀.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
            CategoryTheory.ShortComplex.mk (H₀_pre.map S₀.g) (δ_nat 0) hComp0
          have hEx₀ : SC₀.Exact := by
            rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
              CategoryTheory.Functor.isZero_iff]
            intro W
            let E_W := (CategoryTheory.evaluation (B₀.Etale)ᵒᵖ AddCommGrpCat.{u}).obj W
            have hEx_W : (SC₀.map E_W).Exact := by
              rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
              intro x₂ hx₂
              exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
                (weilPolyP1CohomologyRepSheaf B₀ W.unop) hSE₀ x₂ (Nat.zero_add 1) hx₂
            rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology] at hEx_W
            exact CategoryTheory.Limits.IsZero.of_iso hEx_W
              (CategoryTheory.ShortComplex.mapLeftHomologyIso SC₀ E_W).symm
          have hEx_sh₀ : ((SC₀.map W_B).map Sh_Y).Exact := (hEx₀.map W_B).map Sh_Y
          have hg₀_zero : ((SC₀.map W_B).map Sh_Y).g = 0 :=
            (hPX₁ 1 le_rfl).eq_of_tgt _ 0
          haveI : CategoryTheory.Epi ((SC₀.map W_B).map Sh_Y).f :=
            (CategoryTheory.ShortComplex.Exact.epi_f_iff hEx_sh₀).mpr hg₀_zero
          have hev_comm : H₀_pre.map S₀.g ≫ (evNatIso S₀.X₃).hom =
              (evNatIso S₀.X₂).hom ≫ S₀.g.hom := by
            ext W x
            rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.comp_app]
            change (evAddEquiv S₀.X₃ W) (x.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.g) (Nat.add_zero 0)) =
              (S₀.g.hom.app W).hom ((evAddEquiv S₀.X₂ W) x)
            let φ : weilPolyP1CohomologyRepSheaf B₀ W.unop ⟶ S₀.X₂ :=
              CategoryTheory.Abelian.Ext.homEquiv₀ x
            have hx : x = CategoryTheory.Abelian.Ext.mk₀ φ := by
              rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
              exact (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x).symm
            rw [hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
            change weilPolyP1CohomologyRepHomEquiv B₀ W.unop S₀.X₃
                (CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (φ ≫ S₀.g))) =
              (S₀.g.hom.app W).hom
                (weilPolyP1CohomologyRepHomEquiv B₀ W.unop S₀.X₂
                  (CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ φ)))
            rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
              ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
              Equiv.apply_symm_apply, Equiv.apply_symm_apply, hRepApply, hRepApply]
            rfl
          let ε_sh₂ := (CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}).counit
          haveI : CategoryTheory.IsIso (ε_sh₂.app (R.obj S₀.X₃)) :=
            CategoryTheory.isIso_sheafificationAdjunction_counit (R.obj S₀.X₃)
          let e₂ : Sh_Y.obj (W_B.obj (S₀.X₂.cohomologyPresheaf 0)) ⟶ Sh_Y.obj (W_B.obj S₀.X₂.obj) :=
            Sh_Y.map (W_B.map (evNatIso S₀.X₂).hom)
          let e₃ : Sh_Y.obj (W_B.obj (S₀.X₃.cohomologyPresheaf 0)) ⟶ Sh_Y.obj (W_B.obj S₀.X₃.obj) :=
            Sh_Y.map (W_B.map (evNatIso S₀.X₃).hom)
          let e₃_inv : Sh_Y.obj (W_B.obj S₀.X₃.obj) ⟶ Sh_Y.obj (W_B.obj (S₀.X₃.cohomologyPresheaf 0)) :=
            Sh_Y.map (W_B.map (evNatIso S₀.X₃).inv)
          have he₃_inv_hom : e₃_inv ≫ e₃ = CategoryTheory.CategoryStruct.id _ := by
            have h1 : W_B.map (evNatIso S₀.X₃).inv ≫ W_B.map (evNatIso S₀.X₃).hom =
                CategoryTheory.CategoryStruct.id _ := by
              rw [← W_B.map_comp, CategoryTheory.Iso.inv_hom_id, W_B.map_id]
            exact (Sh_Y.map_comp _ _).symm.trans
              ((congrArg Sh_Y.map h1).trans (Sh_Y.map_id _))
          have hSh_sq : ((SC₀.map W_B).map Sh_Y).f ≫ e₃ = e₂ ≫ Sh_Y.map (R.map S₀.g).hom := by
            have h1 : W_B.map (H₀_pre.map S₀.g) ≫ W_B.map (evNatIso S₀.X₃).hom =
                W_B.map (evNatIso S₀.X₂).hom ≫ W_B.map S₀.g.hom := by
              rw [← W_B.map_comp, ← W_B.map_comp, hev_comm]
            exact (Sh_Y.map_comp _ _).symm.trans
              ((congrArg Sh_Y.map h1).trans (Sh_Y.map_comp _ _))
          have hε_sq : Sh_Y.map (R.map S₀.g).hom ≫ ε_sh₂.app (R.obj S₀.X₃) =
              ε_sh₂.app (R.obj S₀.X₂) ≫ R.map S₀.g :=
            ε_sh₂.naturality (R.map S₀.g)
          have hEpi_g : CategoryTheory.Epi (S₀.map R).g := by
            change CategoryTheory.Epi (R.map S₀.g)
            refine ⟨fun {Z_sh} k₁ k₂ hk => ?_⟩
            have hL : ∀ k : R.obj S₀.X₃ ⟶ Z_sh,
                ((SC₀.map W_B).map Sh_Y).f ≫ (e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k)) =
                  e₂ ≫ (ε_sh₂.app (R.obj S₀.X₂) ≫ (R.map S₀.g ≫ k)) := fun k =>
              (CategoryTheory.Category.assoc ((SC₀.map W_B).map Sh_Y).f e₃ _).symm.trans
                ((congrArg (· ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k)) hSh_sq).trans
                  ((CategoryTheory.Category.assoc e₂ (Sh_Y.map (R.map S₀.g).hom) _).trans
                    (congrArg (e₂ ≫ ·)
                      ((CategoryTheory.Category.assoc (Sh_Y.map (R.map S₀.g).hom) _ k).symm.trans
                        ((congrArg (· ≫ k) hε_sq).trans
                          (CategoryTheory.Category.assoc _ (R.map S₀.g) k))))))
            have h1 : ((SC₀.map W_B).map Sh_Y).f ≫ (e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₁)) =
                ((SC₀.map W_B).map Sh_Y).f ≫ (e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₂)) :=
              (hL k₁).trans ((congrArg (fun m_k => e₂ ≫ (ε_sh₂.app (R.obj S₀.X₂) ≫ m_k)) hk).trans
                (hL k₂).symm)
            have h2 : e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₁) = e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₂) :=
              (CategoryTheory.cancel_epi ((SC₀.map W_B).map Sh_Y).f).mp h1
            have h3 : ε_sh₂.app (R.obj S₀.X₃) ≫ k₁ = ε_sh₂.app (R.obj S₀.X₃) ≫ k₂ := by
              have hCancel_e₃ : ∀ m_k : Sh_Y.obj (W_B.obj S₀.X₃.obj) ⟶ Z_sh,
                  e₃_inv ≫ (e₃ ≫ m_k) = m_k := fun m_k =>
                (CategoryTheory.Category.assoc e₃_inv e₃ m_k).symm.trans
                  ((congrArg (· ≫ m_k) he₃_inv_hom).trans (CategoryTheory.Category.id_comp m_k))
              exact (hCancel_e₃ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₁)).symm.trans
                ((congrArg (e₃_inv ≫ ·) h2).trans
                  (hCancel_e₃ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₂)))
            have h4 := congrArg (CategoryTheory.inv (ε_sh₂.app (R.obj S₀.X₃)) ≫ ·) h3
            exact (CategoryTheory.IsIso.inv_hom_id_assoc (ε_sh₂.app (R.obj S₀.X₃)) k₁).symm.trans
              (h4.trans (CategoryTheory.IsIso.inv_hom_id_assoc (ε_sh₂.app (R.obj S₀.X₃)) k₂))
          exact CategoryTheory.ShortComplex.ShortExact.mk' hLimR.1 hLimR.2 hEpi_g
        · intro s hs
          obtain ⟨p₀, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s ≠ 0)
          have hIsoApp : ∀ W : (B₀.Etale)ᵒᵖ, CategoryTheory.IsIso ((δ_nat (p₀ + 1)).app W) := by
            intro W
            let ℱ_W := weilPolyP1CohomologyRepSheaf B₀ W.unop
            have hBij : Function.Bijective
                (hSE₀.extClass.postcomp ℱ_W (rfl : (p₀ + 1) + 1 = p₀ + 2)) := by
              refine ⟨?_, ?_⟩
              · intro x₁ x₂ hx_eq
                have hx₀ : (hSE₀.extClass.postcomp ℱ_W (rfl : (p₀ + 1) + 1 = p₀ + 2))
                    (x₁ - x₂) = 0 := by
                  rw [map_sub, hx_eq, sub_self]
                suffices h0 : x₁ - x₂ = 0 from sub_eq_zero.mp h0
                obtain ⟨u, hu⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
                  ℱ_W hSE₀ (x₁ - x₂) rfl hx₀
                have hu0 : u = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective u
                rw [← hu, hu0, CategoryTheory.Abelian.Ext.zero_comp]
              · intro y
                have hy_f : y.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.f)
                    (Nat.add_zero ((p₀ + 1) + 1)) = 0 :=
                  CategoryTheory.Abelian.Ext.eq_zero_of_injective _
                exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℱ_W hSE₀ y hy_f rfl
            let eW := AddEquiv.toAddCommGrpIso
              (X := (S₀.X₃.cohomologyPresheaf (p₀ + 1)).obj W)
              (Y := (S₀.X₁.cohomologyPresheaf (p₀ + 2)).obj W)
              (AddEquiv.ofBijective _ hBij)
            have heW : (δ_nat (p₀ + 1)).app W = eW.hom := rfl
            rw [heW]
            infer_instance
          haveI : CategoryTheory.IsIso (δ_nat (p₀ + 1)) :=
            CategoryTheory.NatIso.isIso_of_isIso_app (δ_nat (p₀ + 1))
          let e_sh : weilEtaleHigherDirectImage (τ a) (p₀ + 1) S₀.X₃ ≅
              weilEtaleHigherDirectImage (τ a) (p₀ + 2) S₀.X₁ :=
            Sh_Y.mapIso (W_B.mapIso (CategoryTheory.asIso (δ_nat (p₀ + 1))))
          exact CategoryTheory.Limits.IsZero.of_iso (hPX₁ (p₀ + 2) (by omega)) e_sh

      let Λ₀ : ∀ (d : ℕ) (H : CategoryTheory.Sheaf J_B AddCommGrpCat.{u}),
          CategoryTheory.Abelian.Ext Fℤ_Y (R.obj H) d →+
            CategoryTheory.Abelian.Ext (L.obj Fℤ_Y) H d :=
        fun d H =>
          ((CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app H)).postcomp
            (L.obj Fℤ_Y) (Nat.add_zero d)).comp
            (L.mapExtAddHom Fℤ_Y (R.obj H) d)

      have hΛ₀_apply : ∀ (d : ℕ) (H : CategoryTheory.Sheaf J_B AddCommGrpCat.{u})
          (w : CategoryTheory.Abelian.Ext Fℤ_Y (R.obj H) d),
          Λ₀ d H w =
            (CategoryTheory.Abelian.Ext.mapExactFunctor L w).comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app H)) (Nat.add_zero d) := by
        intro d H w
        change ((L.mapExtAddHom Fℤ_Y (R.obj H) d) w).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app H)) (Nat.add_zero d) = _
        rw [CategoryTheory.Functor.mapExtAddHom_apply]

      have hΛ₀_bij : ∀ (d : ℕ) (H : CategoryTheory.Sheaf J_B AddCommGrpCat.{u}),
          P_acyc H → Function.Bijective (Λ₀ d H) := by
        intro d
        induction d with
        | zero =>
          intro H _
          let e₀ : CategoryTheory.Abelian.Ext Fℤ_Y (R.obj H) 0 ≃
              CategoryTheory.Abelian.Ext (L.obj Fℤ_Y) H 0 :=
            CategoryTheory.Abelian.Ext.homEquiv₀.trans
              ((adj.homEquiv Fℤ_Y H).symm.trans CategoryTheory.Abelian.Ext.homEquiv₀.symm)
          have he₀ : (⇑(Λ₀ 0 H) : CategoryTheory.Abelian.Ext Fℤ_Y (R.obj H) 0 → _) = ⇑e₀ := by
            ext w
            let u : Fℤ_Y ⟶ R.obj H := CategoryTheory.Abelian.Ext.homEquiv₀ w
            have hw : w = CategoryTheory.Abelian.Ext.mk₀ u := by
              rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
              exact (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply w).symm
            rw [hΛ₀_apply, hw, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
            change CategoryTheory.Abelian.Ext.mk₀ (L.map u ≫ adj.counit.app H) =
              CategoryTheory.Abelian.Ext.homEquiv₀.symm
                ((adj.homEquiv Fℤ_Y H).symm
                  (CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ u)))
            rw [CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
              ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply u, Equiv.apply_symm_apply,
              CategoryTheory.Adjunction.homEquiv_counit]
          rw [he₀]
          exact e₀.bijective
        | succ d ih =>
          intro H hPH
          let I := CategoryTheory.Injective.under H
          let α_i : H ⟶ I := CategoryTheory.Injective.ι H
          let Q := CategoryTheory.Limits.cokernel α_i
          let β_i : I ⟶ Q := CategoryTheory.Limits.cokernel.π α_i
          let S₀ := CategoryTheory.ShortComplex.mk α_i β_i
            (CategoryTheory.Limits.cokernel.condition α_i)
          have hCoker : CategoryTheory.Limits.IsColimit
              (CategoryTheory.Limits.CokernelCofork.ofπ S₀.g S₀.zero) :=
            CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ' β_i
              (CategoryTheory.Limits.cokernel.condition α_i)
              (fun k hk => ⟨CategoryTheory.Limits.cokernel.desc α_i k hk,
                CategoryTheory.Limits.cokernel.π_desc α_i k hk⟩)
          have hSE₀ : S₀.ShortExact :=
            CategoryTheory.ShortComplex.ShortExact.mk'
              (CategoryTheory.ShortComplex.exact_of_g_is_cokernel S₀ hCoker)
              inferInstance inferInstance
          have hPI : P_acyc I := hP_inj I inferInstance
          obtain ⟨hSE₁, hPQ⟩ := hP_ses S₀ hSE₀ inferInstance hPH
          let S₁_sc := S₀.map R
          let S₂_sc := S₁_sc.map L
          have hSE₂ : S₂_sc.ShortExact := hSE₁.map_of_exact L
          haveI : CategoryTheory.Injective S₁_sc.X₂ :=
            CategoryTheory.Adjunction.map_injective adj I inferInstance
          let ε_sc : S₂_sc ⟶ S₀ :=
            { τ₁ := adj.counit.app H
              τ₂ := adj.counit.app I
              τ₃ := adj.counit.app Q
              comm₁₂ := (adj.counit.naturality α_i).symm
              comm₂₃ := (adj.counit.naturality β_i).symm }
          have hSq₁ : ∀ u₁ : CategoryTheory.Abelian.Ext Fℤ_Y (R.obj I) d,
              Λ₀ d Q (u₁.comp (CategoryTheory.Abelian.Ext.mk₀ S₁_sc.g) (Nat.add_zero d)) =
                (Λ₀ d I u₁).comp (CategoryTheory.Abelian.Ext.mk₀ S₀.g) (Nat.add_zero d) := by
            intro u₁
            rw [hΛ₀_apply, hΛ₀_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero d) (Nat.zero_add 0)
                (by omega),
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero d) (Nat.zero_add 0)
                (by omega),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
            congr 2
            exact adj.counit.naturality β_i
          have hSq₂ : ∀ y₁ : CategoryTheory.Abelian.Ext Fℤ_Y (R.obj Q) d,
              Λ₀ (d + 1) H (y₁.comp hSE₁.extClass rfl) =
                (Λ₀ d Q y₁).comp hSE₀.extClass rfl := by
            intro y₁
            rw [hΛ₀_apply, hΛ₀_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_extClass L hSE₁,
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (by omega),
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero d) (Nat.zero_add 1)
                (by omega)]
            congr 1
            exact CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₂ hSE₀ ε_sc
