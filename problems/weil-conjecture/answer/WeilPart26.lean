        have hpair_mem : (γ, γ₀) ∈ c.support ×ˢ c.support := Finset.mem_product.mpr ⟨hγ_mem, hγ₀_mem⟩
        by_cases hu₀_eq : u₀ ∈ S_eq γ γ₀
        · have hO_sub : (O : Set ↥U_sch) ⊆ S_eq γ γ₀ := by
            intro x hx
            have hx' := Set.mem_iInter₂.mp hx (γ, γ₀) hpair_mem
            rwa [ite_eq_left_iff.mpr (fun h => False.elim (h hu₀_eq))] at hx'
          have h_left_eq : O.ι ≫ (FgtZ.map γ).left = O.ι ≫ (FgtZ.map γ₀).left :=
            hEq_on_open O γ γ₀ hO_sub
