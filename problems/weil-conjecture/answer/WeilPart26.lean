    let j₀ : U₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk j_aff rfl trivial
    let V₀ := B_ν.obj U₀
    let V₀_sch := (FgtY.obj V₀).left
    let pr₁_0 : V₀_sch ⟶ AlgebraicGeometry.Spec R₀_cat :=
