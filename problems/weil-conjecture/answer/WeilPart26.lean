theorem weil_top_deg_kummer_mod_prime_pbc_and_curve_cd (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
      ∀ (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        (f : Quiver.Hom X S) [AlgebraicGeometry.IsProper f.left],
        WeilCanonicalModPrimePBC ℓ f.left) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
       (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : Ω) ≠ 0 →
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper C.hom],
        topologicalKrullDim C.left ≤ (1 : WithBot ℕ∞) →
        ∀ (G : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id G = 0 →
          ∀ (q : ℕ), 2 < q → Subsingleton (G.H q)) :=
by
  refine ⟨?_, ?_⟩
  · 
    intro ℓ _ hℓ X S _ f _
    obtain ⟨_, hComp, hCancel, hAffineLoc, hArrowIso⟩ :=
      weil_pbc_canonical_calculus_and_extraction.{u} ℓ
    obtain ⟨hIsoP0, hVieta⟩ := weil_vieta_binary_form_cover_projSpace k
    have hLFT_Proj : ∀ N : ℕ,
        AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      intro N
      dsimp [weilProjectiveSpaceOver]
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      have hSurj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
        intro ⟨p, hp⟩
        dsimp [𝒜] at hp
        rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hp
        rcases hp with ⟨c, rfl⟩
        exact ⟨c, Subtype.ext rfl⟩
      have hFT_map : (algebraMap k ↥(𝒜 0)).FiniteType :=
        RingHom.FiniteType.of_surjective _ hSurj
      haveI : AlgebraicGeometry.LocallyOfFiniteType
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT_map
      haveI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) _ _ _ _ _ _
          (fun _ => rfl)
      haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
      infer_instance
    have hProjSpace : ∀ (N : ℕ)
        (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType B.hom],
        WeilCanonicalModPrimePBC ℓ
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) := by
      intro N
      induction N with
      | zero =>
        intro B _
        haveI : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom := hIsoP0
        haveI : AlgebraicGeometry.IsFinite (weilProjectiveSpaceOver k 0).hom := inferInstance
        haveI : AlgebraicGeometry.IsFinite
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom) :=
          inferInstance
        exact weil_pbc_finite_morphism ℓ _
      | succ m ih =>
        intro B _
        let P_m := weilProjectiveSpaceOver k m
        let P_1 := weilProjectiveSpaceOver k 1
        let P_succ := weilProjectiveSpaceOver k (m + 1)
        haveI : AlgebraicGeometry.LocallyOfFiniteType P_m.hom := hLFT_Proj m
        let p_mB := CategoryTheory.Limits.pullback.fst B.hom P_m.hom
        haveI : AlgebraicGeometry.LocallyOfFiniteType p_mB := inferInstance
        let B_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (p_mB ≫ B.hom)
        haveI : AlgebraicGeometry.LocallyOfFiniteType B_m.hom := by
          change AlgebraicGeometry.LocallyOfFiniteType (p_mB ≫ B.hom)
          infer_instance
        let p_1Bm := CategoryTheory.Limits.pullback.fst B_m.hom P_1.hom
        have hPBC_1Bm : WeilCanonicalModPrimePBC ℓ p_1Bm := by
          apply hAffineLoc
          intro U hU
          let B_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
            CategoryTheory.Over.mk (U.ι ≫ B_m.hom)
          haveI : AlgebraicGeometry.IsAffine B_U.left := hU
          haveI : AlgebraicGeometry.LocallyOfFiniteType B_U.hom := by
            change AlgebraicGeometry.LocallyOfFiniteType (U.ι ≫ B_m.hom)
            infer_instance
          have hPBC_BU : WeilCanonicalModPrimePBC ℓ
              (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom) :=
            weil_pbc_projLine_over_affine_finiteType k ℓ hℓ B_U
          have hpb_res : CategoryTheory.IsPullback (p_1Bm ∣_ U) (p_1Bm ⁻¹ᵁ U).ι U.ι p_1Bm :=
            AlgebraicGeometry.isPullback_morphismRestrict p_1Bm U
          have hpb_U : CategoryTheory.IsPullback (p_1Bm ∣_ U)
              ((p_1Bm ⁻¹ᵁ U).ι ≫ CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
              B_U.hom P_1.hom :=
            hpb_res.paste_vert (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom)
          exact hArrowIso (p_1Bm ∣_ U) (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom)
            hpb_U.isoPullback (CategoryTheory.Iso.refl U.toScheme) (by simp) hPBC_BU
        have hPBC_comp : WeilCanonicalModPrimePBC ℓ (p_1Bm ≫ p_mB) :=
          hComp p_1Bm p_mB hPBC_1Bm (ih B)
        obtain ⟨μ, hFin_μ, hSurj_μ, hw_μ⟩ := hVieta m
        have hcond_1m : (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom) ≫ P_m.hom =
            CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom ≫ P_1.hom := by
          change (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom) ≫ P_m.hom = _
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition]
          exact CategoryTheory.Limits.pullback.condition
        let lift_1m : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
            CategoryTheory.Limits.pullback P_m.hom P_1.hom :=
          CategoryTheory.Limits.pullback.lift
            (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
            (CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom) hcond_1m
        have hpb_A : CategoryTheory.IsPullback lift_1m p_1Bm
            (CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom)
            (CategoryTheory.Limits.pullback.snd B.hom P_m.hom) := by
          refine CategoryTheory.IsPullback.of_right ?_
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.IsPullback.of_hasPullback P_m.hom P_1.hom).flip
          have htop : lift_1m ≫ CategoryTheory.Limits.pullback.snd P_m.hom P_1.hom =
              CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hbot : CategoryTheory.Limits.pullback.snd B.hom P_m.hom ≫ P_m.hom = B_m.hom :=
            CategoryTheory.Limits.pullback.condition.symm
          rw [htop, hbot]
          exact (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom).flip
        have hpb_outer0 : CategoryTheory.IsPullback (p_1Bm ≫ p_mB) lift_1m B.hom
            (CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom ≫ P_m.hom) :=
          hpb_A.flip.paste_horiz (CategoryTheory.IsPullback.of_hasPullback B.hom P_m.hom)
        have hpb_outer : CategoryTheory.IsPullback (p_1Bm ≫ p_mB) lift_1m B.hom
            (μ ≫ P_succ.hom) := by
          rwa [← hw_μ] at hpb_outer0
        let μ_B : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
            CategoryTheory.Limits.pullback B.hom P_succ.hom :=
          CategoryTheory.Limits.pullback.lift (p_1Bm ≫ p_mB) (lift_1m ≫ μ)
            (hpb_outer.w.trans (CategoryTheory.Category.assoc _ _ _).symm)
        have hpb_μ : CategoryTheory.IsPullback μ_B lift_1m
            (CategoryTheory.Limits.pullback.snd B.hom P_succ.hom) μ := by
          refine CategoryTheory.IsPullback.of_right ?_
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            (CategoryTheory.IsPullback.of_hasPullback B.hom P_succ.hom)
          have htop : μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom =
              p_1Bm ≫ p_mB := CategoryTheory.Limits.pullback.lift_fst _ _ _
          rwa [htop]
        haveI : AlgebraicGeometry.IsFinite μ_B :=
