          refine ⟨⇑((Fgt.map u).left) '' (⇑(val_loc (x u hu)) ⁻¹' t), ?_, ?_, ?_⟩
          · rintro _ ⟨z', hz', rfl⟩
            change g₀ ((Fgt.map u).left z') ∈ t
            rw [hg₀_eq u hu z']
            exact hz'
          · exact ((Fgt.map u).left).isOpenMap _ ((val_loc (x u hu)).isLocallyConstant t)
          · refine ⟨z, ?_, hzw⟩
            change val_loc (x u hu) z ∈ t
            rw [← hg₀_eq u hu z, hzw]
