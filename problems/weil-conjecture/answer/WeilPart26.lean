          · have hcast : (fun i : Fin δ => σ (Fin.castSucc i)) = τ := by
              ext i; simp [σ]
            rwa [hcast]
          · have hlast : σ (Fin.last δ) = true := by simp [σ]
            rw [hlast]
            exact hz_inf
      have hs_succ_over : s_succ ≫ (π₁ ≫ (weilPolyP1Over k δ).hom) = 𝟙 S_k := by
        dsimp [s_succ, π₁]
        rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hs_over]
      have hs_succ_mem : ∀ σ : Fin (δ + 1) → Bool,
          Set.range s_succ.base ⊆ Set.range (u_succ σ).base := by
        rintro σ _ ⟨pt, rfl⟩
        apply hu_succ_range σ (s_succ.base pt)
        · have h1 : π₁.base (s_succ.base pt) = s_δ.base pt :=
            congrArg (fun g : S_k ⟶ (weilPolyP1Over k δ).left => g.base pt)
              (CategoryTheory.Limits.pullback.lift_fst s_δ s_one _)
          rw [h1]
          exact hs_mem _ ⟨pt, rfl⟩
        · have h2 : π₂.base (s_succ.base pt) = s_one.base pt :=
            congrArg (fun g : S_k ⟶ P_1.left => g.base pt)
              (CategoryTheory.Limits.pullback.lift_snd s_δ s_one _)
          rw [h2]
          have hmem1 := hs_one_mem ⟨pt, rfl⟩
          cases h_b : σ (Fin.last δ)
          · exact hmem1.1
          · exact hmem1.2
      have hInt_Asucc : AlgebraicGeometry.IsIntegral A_succ :=
        @AlgebraicGeometry.instIsIntegralSpecOfIsDomainCarrier
          (CommRingCat.of (MvPolynomial (Fin (δ + 1)) k))
          (inferInstance : IsDomain (MvPolynomial (Fin (δ + 1)) k))
      have hInt_succ : AlgebraicGeometry.IsIntegral P_succ :=
        hIntegralOfPointedCover hInt_Asucc u_succ hu_succ_open hu_succ_cov
          (s_succ.base pt₀) (fun σ => hs_succ_mem σ ⟨pt₀, rfl⟩)
      exact ⟨hProp_succ, hSm_succ, hInt_succ, u_succ, s_succ,
        hu_succ_false, hu_succ_open, hu_succ_over, hu_succ_cov, hs_succ_over, hs_succ_mem⟩

  
  refine ⟨ι_P1, ι_aff, hProp1, hInt1, hProj1, hSm1, hOpen_P1, hOver_P1,
    ⟨s_inf, hs_inf_over, hDisj_inf, hUniv_inf⟩, rfl, fun δ => ?_⟩
  rcases hInd δ with ⟨hProp_δ, hSm_δ, hInt_δ, u_δ, _, hu_false, hu_open, _, _, _, _⟩
  refine ⟨hProp_δ, hInt_δ, hSm_δ, hu_false ▸ hu_open (fun _ => false), (affPair δ).2, ?_, ?_⟩
  · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  · exact CategoryTheory.Limits.pullback.lift_snd _ _ _

theorem weil_gysin_finite_flat_gm_det_norm_and_kummer_trace (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ) (hn : 2 ≤ n) (hUnit_n : IsUnit (n : Ω))
    (ζ : Ωˣ) (hζ : IsPrimitiveRoot (ζ : Ω) n)
    (hGmSheaf : ∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X)) :
    ∃ ι_kum : ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        Quiver.Hom (weilEtaleTorsionSheaf X.left n) (weilEtaleGmSheaf X.left),
      (∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        AlgebraicGeometry.IsIntegral X.left →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 X.hom →
        ∃ h0 : CategoryTheory.CategoryStruct.comp (ι_kum X)
            (n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left)) = 0,
          (CategoryTheory.ShortComplex.mk (ι_kum X)
            (n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left)) h0).ShortExact) ∧
      (∀ (C P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        AlgebraicGeometry.IsIntegral C.left →
        AlgebraicGeometry.IsProper C.hom →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom →
        AlgebraicGeometry.IsIntegral P.left →
        IsProjectiveOverField Ω P →
        AlgebraicGeometry.IsProper P.hom →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 P.hom →
        ∀ (d : ℕ), 1 ≤ d →
          ∀ (π_tilde : Quiver.Hom C.left P.left),
            CategoryTheory.CategoryStruct.comp π_tilde P.hom = C.hom →
            WeilTopDegFiniteLocallyFreeOfRank d π_tilde →
            ∀ (hCont : (weilAltCdSitePullback π_tilde).IsContinuous
                P.left.smallEtaleTopology C.left.smallEtaleTopology),
              let B_π_tilde := weilAltCdSitePullback π_tilde
              let pf_π_tilde := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
                B_π_tilde AddCommGrpCat.{u} _ P.left.smallEtaleTopology C.left.smallEtaleTopology hCont
              let p_kum_C := n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf C.left)
              let p_kum_P := n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf P.left)
              ∃ (N_gm : Quiver.Hom (pf_π_tilde.obj (weilEtaleGmSheaf C.left)) (weilEtaleGmSheaf P.left))
                (Tr : Quiver.Hom (pf_π_tilde.obj (weilEtaleTorsionSheaf C.left n))
                  (weilEtaleTorsionSheaf P.left n)),
                (CategoryTheory.CategoryStruct.comp Tr (ι_kum P) =
                  CategoryTheory.CategoryStruct.comp (pf_π_tilde.map (ι_kum C)) N_gm ∧
                 CategoryTheory.CategoryStruct.comp N_gm p_kum_P =
                  CategoryTheory.CategoryStruct.comp (pf_π_tilde.map p_kum_C) N_gm) ∧
                (∀ (W₀ : AlgebraicGeometry.Scheme.{u})
                    (j₀ : Quiver.Hom W₀ C.left)
                    (u₀ : Quiver.Hom W₀ P.left)
                    (_hj₀_open : AlgebraicGeometry.IsOpenImmersion j₀)
                    (hj₀_et : AlgebraicGeometry.Etale j₀)
                    (hu₀_et : AlgebraicGeometry.Etale u₀),
                  CategoryTheory.CategoryStruct.comp j₀ π_tilde = u₀ →
                  let U_C0 := weilGysinEtaleObj j₀ hj₀_et
                  let U_P0 := weilGysinEtaleObj u₀ hu₀_et
                  let Fgt_C := AlgebraicGeometry.Scheme.Etale.forget C.left
                  let Fgt_P := AlgebraicGeometry.Scheme.Etale.forget P.left
                  let L_C0 := weilGysinLocalTorsionSheaf C.left n U_C0
                  let L_P0 := weilGysinLocalTorsionSheaf P.left n U_P0
                  let p_fst : Quiver.Hom ((Fgt_C.obj (B_π_tilde.obj U_P0)).left)
                      ((Fgt_P.obj U_P0).left) :=
                    CategoryTheory.Limits.pullback.fst ((Fgt_P.obj U_P0).hom) π_tilde
                  ∀ (σ₀ : Quiver.Hom U_C0 (B_π_tilde.obj U_P0))
                    (α_comp : Quiver.Hom L_P0 (pf_π_tilde.obj L_C0)),
                    let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_comp
                    CategoryTheory.CategoryStruct.comp ((Fgt_C.map σ₀).left) p_fst =
                      CategoryTheory.CategoryStruct.id W₀ →
                    CategoryTheory.CategoryStruct.comp ξ (L_C0.obj.map (Opposite.op σ₀)) =
                      CategoryTheory.Sheaf.freeYonedaHomEquiv
                        (CategoryTheory.CategoryStruct.id L_C0) →
                    (∀ (V : C.left.Etale) (w : Quiver.Hom V (B_π_tilde.obj U_P0)),
                      Disjoint (Set.range ((Fgt_C.map w).left).base)
                        (Set.range ((Fgt_C.map σ₀).left).base) →
                      CategoryTheory.CategoryStruct.comp ξ (L_C0.obj.map (Opposite.op w)) = 0) →
                    CategoryTheory.CategoryStruct.comp α_comp
                      (CategoryTheory.CategoryStruct.comp
                        (pf_π_tilde.map (weilGysinLocalTorsionCounit C.left n U_C0)) Tr) =
                      weilGysinLocalTorsionCounit P.left n U_P0) ∧
                (∀ (x : ↥C.left) (hx : IsClosed ({x} : Set ↥C.left)),
                  let q : ↥P.left := π_tilde.base x
                  ∃ (hq : IsClosed ({q} : Set ↥P.left))
                    (V₁ : P.left.Opens)
                    (_hAff_V₁ : AlgebraicGeometry.IsAffineOpen V₁)
                    (hq_mem : q ∈ V₁),
                    let V₂ : P.left.Opens := ⟨({q} : Set ↥P.left)ᶜ, hq.isOpen_compl⟩
                    let W₁ : C.left.Opens := (TopologicalSpace.Opens.map π_tilde.base).obj V₁
                    let W_x : C.left.Opens := ⟨({x} : Set ↥C.left)ᶜ, hx.isOpen_compl⟩
                    let hx_mem : x ∈ W₁ := hq_mem
                    ∃ (f_sec : ↑(C.left.presheaf.obj (Opposite.op W₁)))
                      (u_f : Units ↑(C.left.presheaf.obj (Opposite.op (W₁ ⊓ W_x))))
                      (g_sec : ↑(P.left.presheaf.obj (Opposite.op V₁)))
                      (u_g : Units ↑(P.left.presheaf.obj (Opposite.op (V₁ ⊓ V₂)))),
                      (C.left.presheaf.map
                        (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W_x ≤ W₁)).op).hom f_sec =
                        (u_f : ↑(C.left.presheaf.obj (Opposite.op (W₁ ⊓ W_x)))) ∧
                      Ideal.span {(C.left.presheaf.germ W₁ x hx_mem).hom f_sec} =
                        IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x) ∧
                      (P.left.presheaf.map
                        (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom g_sec =
                        (u_g : ↑(P.left.presheaf.obj (Opposite.op (V₁ ⊓ V₂)))) ∧
                      Ideal.span {(P.left.presheaf.germ V₁ q hq_mem).hom g_sec} =
                        IsLocalRing.maximalIdeal ↑(P.left.presheaf.stalk q) ∧
                      let U_V12 : P.left.Etale := weilGysinEtaleObj (V₁ ⊓ V₂).ι inferInstance
                      let B_V12 : C.left.Etale := B_π_tilde.obj U_V12
                      let η_C := (CategoryTheory.sheafificationAdjunction
                        C.left.smallEtaleTopology AddCommGrpCat.{u}).unit.app
                        (weilEtaleGmPresheaf C.left)
                      let η_P := (CategoryTheory.sheafificationAdjunction
                        P.left.smallEtaleTopology AddCommGrpCat.{u}).unit.app
                        (weilEtaleGmPresheaf P.left)
                      ∀ h_le : (⊤ : B_V12.left.Opens) ≤
                          (TopologicalSpace.Opens.map B_V12.hom.base).obj (W₁ ⊓ W_x),
                        (N_gm.hom.app (Opposite.op U_V12)).hom
                          ((η_C.app (Opposite.op B_V12)).hom
                            (Additive.ofMul (Units.map
                              (B_V12.hom.appLE (W₁ ⊓ W_x) ⊤ h_le).hom.toMonoidHom u_f))) =
                        (η_P.app (Opposite.op U_V12)).hom
                          (Additive.ofMul (Units.map
                            (V₁ ⊓ V₂).topIso.inv.hom.toMonoidHom u_g)))) :=
by
  classical
  
  have section_of_etale_isOpenImmersion {W V : AlgebraicGeometry.Scheme.{u}}
      (s : W ⟶ V) (p : V ⟶ W) [AlgebraicGeometry.Etale p] (hsp : s ≫ p = 𝟙 W) :
      True ∧ AlgebraicGeometry.IsOpenImmersion s := by
    refine ⟨trivial, ?_⟩
    have hcomm : (p ≫ s) ≫ p = 𝟙 V ≫ p := by
      rw [Category.assoc, hsp, Category.comp_id, Category.id_comp]
    let g : V ⟶ Limits.pullback p p := Limits.pullback.lift (p ≫ s) (𝟙 V) hcomm
    have hpb : IsPullback s s g (Limits.pullback.diagonal p) := by
      refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk
        (by
          dsimp [g]
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, hsp, Category.id_comp,
              Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
          · rw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id,
              Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id])
        (fun c => c.fst ≫ p)
        (fun c => by
          have h2 : c.fst ≫ (g ≫ Limits.pullback.snd p p) =
              c.snd ≫ (Limits.pullback.diagonal p ≫ Limits.pullback.snd p p) := by
            simpa only [Category.assoc] using (c.condition =≫ Limits.pullback.snd p p)
          dsimp [g] at h2
          rw [Limits.pullback.lift_snd, Limits.pullback.diagonal_snd, Category.comp_id,
            Category.comp_id] at h2
          have h1 : c.fst ≫ (g ≫ Limits.pullback.fst p p) =
              c.snd ≫ (Limits.pullback.diagonal p ≫ Limits.pullback.fst p p) := by
            simpa only [Category.assoc] using (c.condition =≫ Limits.pullback.fst p p)
          dsimp [g] at h1
          rw [Limits.pullback.lift_fst, Limits.pullback.diagonal_fst, Category.comp_id,
            ← Category.assoc, ← h2] at h1
          exact h1)
        (fun c => by
          have h2 : c.fst ≫ (g ≫ Limits.pullback.snd p p) =
              c.snd ≫ (Limits.pullback.diagonal p ≫ Limits.pullback.snd p p) := by
            simpa only [Category.assoc] using (c.condition =≫ Limits.pullback.snd p p)
          dsimp [g] at h2
          rw [Limits.pullback.lift_snd, Limits.pullback.diagonal_snd, Category.comp_id,
            Category.comp_id] at h2
          have h1 : c.fst ≫ (g ≫ Limits.pullback.fst p p) =
              c.snd ≫ (Limits.pullback.diagonal p ≫ Limits.pullback.fst p p) := by
            simpa only [Category.assoc] using (c.condition =≫ Limits.pullback.fst p p)
          dsimp [g] at h1
          rw [Limits.pullback.lift_fst, Limits.pullback.diagonal_fst, Category.comp_id,
            ← Category.assoc] at h1
          exact h1)
        (fun c m hm _ => by
          have hm' := hm =≫ p
          rw [Category.assoc, hsp, Category.comp_id] at hm'
          exact hm'))
    exact MorphismProperty.of_isPullback (P := @AlgebraicGeometry.IsOpenImmersion) hpb.flip
      inferInstance
  
  have freeYonedaHomEquiv_comp {C_cat : Type (u + 1)} [Category.{u} C_cat]
      (J : GrothendieckTopology C_cat) [HasWeakSheafify J AddCommGrpCat.{u}]
      [HasSheafify J AddCommGrpCat.{u}]
      (U : C_cat) (A : AddCommGrpCat.{u})
      {F G : Sheaf J AddCommGrpCat.{u}}
      (f : Sheaf.freeYoneda J U A ⟶ F) (g : F ⟶ G) :
      Sheaf.freeYonedaHomEquiv (f ≫ g) =
        Sheaf.freeYonedaHomEquiv f ≫ g.hom.app (Opposite.op U) := by
    let adj := sheafificationAdjunction J AddCommGrpCat.{u}
    have h1 : (adj.homEquiv (Presheaf.freeYoneda U A) G) (f ≫ g) =
        (adj.homEquiv (Presheaf.freeYoneda U A) F) f ≫ g.hom :=
      adj.homEquiv_naturality_right f g
    exact AddCommGrpCat.ext fun x =>
      ConcreteCategory.congr_hom (congrArg Presheaf.freeYonedaHomEquiv h1) x
  
  have constantSheafAdj_unit_eq {C_cat : Type (u + 1)} [Category.{u} C_cat]
      (J : GrothendieckTopology C_cat) [HasWeakSheafify J AddCommGrpCat.{u}]
      [HasSheafify J AddCommGrpCat.{u}]
      {T : C_cat} (hT : Limits.IsTerminal T)
      (A : AddCommGrpCat.{u}) :
      (constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A =
        ((sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
          ((Functor.const C_catᵒᵖ).obj A)).app (Opposite.op T) := by
    dsimp [constantSheafAdj]
    simp
    rfl
  
  have isDomain_of_openImmersion_isIntegral {X Y : Scheme.{u}}
      [IsIntegral Y] [Nonempty ↥X] (f : X ⟶ Y) [IsOpenImmersion f] :
      True ∧ IsDomain ↑(X.presheaf.obj (Opposite.op ⊤)) := by
    refine ⟨trivial, ?_⟩
    have hEmb : Topology.IsOpenEmbedding f.base := f.isOpenEmbedding
    have : IrreducibleSpace ↥Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y
    have hPreY : IsPreirreducible (Set.univ : Set ↥Y) :=
      (IrreducibleSpace.isIrreducible_univ (X := ↥Y)).2
    have hPreX : IsPreirreducible (Set.univ : Set ↥X) := by
      intro U₁ U₂ hU₁ hU₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
      have hO₁ : IsOpen (f.base '' U₁) := hEmb.isOpenMap U₁ hU₁
      have hO₂ : IsOpen (f.base '' U₂) := hEmb.isOpenMap U₂ hU₂
      obtain ⟨y, _, ⟨z₁, hz₁, rfl⟩, ⟨z₂, hz₂, hEq⟩⟩ :=
        hPreY (f.base '' U₁) (f.base '' U₂) hO₁ hO₂
          ⟨f.base x₁, trivial, x₁, hx₁, rfl⟩ ⟨f.base x₂, trivial, x₂, hx₂, rfl⟩
      have hz : z₁ = z₂ := hEmb.injective hEq.symm
      subst hz
      exact ⟨z₁, trivial, hz₁, hz₂⟩
    have hPreInst : PreirreducibleSpace ↥X := ⟨hPreX⟩
    have : IrreducibleSpace ↥X := { toPreirreducibleSpace := hPreInst, toNonempty := inferInstance }
    have : IsReduced X := AlgebraicGeometry.isReduced_of_isOpenImmersion f
    have : IsIntegral X := AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X
    infer_instance
  
  let disjointOpensRingEquiv (Z : Scheme.{u}) (O₁ O₂ : Z.Opens)
      (h_sup : O₁ ⊔ O₂ = ⊤) (h_disj : Disjoint O₁ O₂) :
      ↑(Z.presheaf.obj (Opposite.op ⊤)) ≃+*
        ↑(Z.presheaf.obj (Opposite.op O₁)) × ↑(Z.presheaf.obj (Opposite.op O₂)) :=
    let res₁ : ↑(Z.presheaf.obj (Opposite.op ⊤)) →+* ↑(Z.presheaf.obj (Opposite.op O₁)) :=
      (Z.presheaf.map (homOfLE (le_top : O₁ ≤ ⊤)).op).hom
    let res₂ : ↑(Z.presheaf.obj (Opposite.op ⊤)) →+* ↑(Z.presheaf.obj (Opposite.op O₂)) :=
      (Z.presheaf.map (homOfLE (le_top : O₂ ≤ ⊤)).op).hom
    RingEquiv.ofBijective (RingHom.prod res₁ res₂) (by
      refine ⟨?_, ?_⟩
      · intro x y hxy
        have h₁ : res₁ x = res₁ y := congrArg Prod.fst hxy
        have h₂ : res₂ x = res₂ y := congrArg Prod.snd hxy
        apply TopCat.Presheaf.section_ext Z.sheaf ⊤ x y
        intro z _
        have hz : z ∈ O₁ ⊔ O₂ := h_sup ▸ trivial
        rcases hz with hz₁ | hz₂
        · have hg₁ := Z.presheaf.germ_res_apply (homOfLE (le_top : O₁ ≤ ⊤)) z hz₁ x
          have hg₂ := Z.presheaf.germ_res_apply (homOfLE (le_top : O₁ ≤ ⊤)) z hz₁ y
          exact hg₁.symm.trans ((congrArg _ h₁).trans hg₂)
        · have hg₁ := Z.presheaf.germ_res_apply (homOfLE (le_top : O₂ ≤ ⊤)) z hz₂ x
          have hg₂ := Z.presheaf.germ_res_apply (homOfLE (le_top : O₂ ≤ ⊤)) z hz₂ y
          exact hg₁.symm.trans ((congrArg _ h₂).trans hg₂)
      · rintro ⟨a₁, a₂⟩
        let U_cov : Bool → Z.Opens := fun b => cond b O₁ O₂
        let sf : ∀ b : Bool, ↑(Z.presheaf.obj (Opposite.op (U_cov b))) :=
          fun b => Bool.recOn b a₂ a₁
        have h_cov : (⊤ : Z.Opens) ≤ iSup U_cov := by
          rw [← h_sup, sup_le_iff]
          exact ⟨le_iSup U_cov true, le_iSup U_cov false⟩
        have h_comp : TopCat.Presheaf.IsCompatible Z.presheaf U_cov sf := by
          intro b₁ b₂
          cases b₁ <;> cases b₂
          · rfl
          · apply TopCat.Presheaf.section_ext Z.sheaf (U_cov false ⊓ U_cov true)
            intro z hz
            exact False.elim (h_disj.le_bot ⟨hz.2, hz.1⟩)
          · apply TopCat.Presheaf.section_ext Z.sheaf (U_cov true ⊓ U_cov false)
            intro z hz
            exact False.elim (h_disj.le_bot ⟨hz.1, hz.2⟩)
          · rfl
        obtain ⟨s, hs, -⟩ := Z.sheaf.existsUnique_gluing' U_cov ⊤ (fun b => homOfLE le_top) h_cov sf h_comp
        exact ⟨s, Prod.ext (hs true) (hs false)⟩)
  
  have det_prod_first_coord_over_domain {d : ℕ} (_hd : 1 ≤ d)
      {B₀ A_rest : Type u} [CommRing B₀] [IsDomain B₀] [CommRing A_rest] [Algebra B₀ A_rest]
      {M : Type u} [AddCommGroup M] [Module B₀ M]
      (bM : Module.Basis (Fin d) B₀ M)
      (e : M ≃ₗ[B₀] B₀ × A_rest)
      (z : B₀) (L : M →ₗ[B₀] M)
      (hL : ∀ m : M, e (L m) = (z, (1 : A_rest)) * e m) :
      ((LinearMap.toMatrix bM bM) L).det = z := by
    have : Module.Free B₀ M := Module.Free.of_basis bM
    have : Module.Finite B₀ M := Module.Finite.of_basis bM
    let K₀ := FractionRing B₀
    have hinj : Function.Injective (algebraMap B₀ K₀) := IsFractionRing.injective B₀ K₀
    apply hinj
    let M_K := TensorProduct B₀ K₀ M
    let b_K : Module.Basis (Fin d) K₀ M_K := bM.baseChange K₀
    let L_K : M_K →ₗ[K₀] M_K := L.baseChange K₀
    have hdet_bc : algebraMap B₀ K₀ (((LinearMap.toMatrix bM bM) L).det) =
        ((LinearMap.toMatrix b_K b_K) L_K).det := by
      rw [LinearMap.det_toMatrix bM L, LinearMap.det_toMatrix b_K L_K]
      exact (LinearMap.det_baseChange L).symm
    rw [hdet_bc]
    let A_K := TensorProduct B₀ K₀ A_rest
    let e_prod : TensorProduct B₀ K₀ (B₀ × A_rest) ≃ₗ[K₀] K₀ × A_K :=
      (TensorProduct.prodRight B₀ K₀ K₀ B₀ A_rest).trans
        (LinearEquiv.prodCongr (Algebra.TensorProduct.rid B₀ K₀ K₀).toLinearEquiv
          (LinearEquiv.refl K₀ A_K))
    let e_K : M_K ≃ₗ[K₀] K₀ × A_K := (LinearEquiv.baseChange B₀ K₀ M (B₀ × A_rest) e).trans e_prod
    have : Module.Finite K₀ M_K := Module.Finite.of_basis b_K
    have : Module.Finite K₀ (K₀ × A_K) := Module.Finite.equiv e_K
    have : Module.Finite K₀ A_K :=
      Module.Finite.of_surjective (LinearMap.snd K₀ K₀ A_K) Prod.snd_surjective
    let d₀ := Module.finrank K₀ A_K
    let b_AK : Module.Basis (Fin d₀) K₀ A_K := Module.finBasis K₀ A_K
    have h_finrank : d₀ + 1 = d := by
      have h1 : Module.finrank K₀ M_K = d := by rw [Module.finrank_eq_card_basis b_K, Fintype.card_fin]
      have h2 : Module.finrank K₀ M_K = Module.finrank K₀ (K₀ × A_K) := e_K.finrank_eq
      have h3 : Module.finrank K₀ (K₀ × A_K) = Module.finrank K₀ K₀ + d₀ := Module.finrank_prod
      have h4 : Module.finrank K₀ K₀ = 1 := Module.finrank_self K₀
      omega
    let v_prod : Fin (d₀ + 1) → K₀ × A_K :=
      Fin.cases ((1 : K₀), (0 : A_K)) (fun j => ((0 : K₀), b_AK j))
    have hv_li : LinearIndependent K₀ v_prod := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      have hg1 : (∑ i : Fin (d₀ + 1), g i • v_prod i).1 = 0 := congrArg Prod.fst hg
      have hg2 : (∑ i : Fin (d₀ + 1), g i • v_prod i).2 = 0 := congrArg Prod.snd hg
      rw [Fin.sum_univ_succ] at hg1 hg2
      simp only [v_prod, Fin.cases_zero, Fin.cases_succ, Prod.fst_add, Prod.snd_add,
        Prod.smul_fst, Prod.smul_snd, smul_eq_mul, mul_one, mul_zero, smul_zero,
        Prod.fst_sum, Prod.snd_sum, Finset.sum_const_zero, add_zero, zero_add] at hg1 hg2
      have h_succ : ∀ j : Fin d₀, g j.succ = 0 :=
        Fintype.linearIndependent_iff.mp b_AK.linearIndependent (fun j => g j.succ) hg2
      intro i
      exact Fin.cases hg1 h_succ i
    have hv_span : ⊤ ≤ Submodule.span K₀ (Set.range v_prod) := by
      rintro ⟨k, a⟩ _
      have ha : ∑ j : Fin d₀, (b_AK.repr a j) • b_AK j = a := b_AK.sum_repr a
      have h_eq : (k, a) = k • v_prod 0 + ∑ j : Fin d₀, (b_AK.repr a j) • v_prod j.succ := by
        ext
        · simp [v_prod, Prod.fst_sum]
        · simp [v_prod, Prod.snd_sum, ha]
      rw [h_eq]
      refine Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩)) ?_
      exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j.succ, rfl⟩))
    let b_prod : Module.Basis (Fin (d₀ + 1)) K₀ (K₀ × A_K) := Module.Basis.mk hv_li hv_span
    let b_target : Module.Basis (Fin d) K₀ M_K :=
      (b_prod.reindex (finCongr h_finrank)).map e_K.symm
    rw [LinearMap.det_toMatrix_eq_det_toMatrix b_K b_target L_K]
    let z_K : K₀ := algebraMap B₀ K₀ z
    have hLK_eval : ∀ w : M_K, e_K (L_K w) = (z_K, (1 : A_K)) * e_K w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul k m =>
        have hm := hL m
        change e_prod (k ⊗ₜ[B₀] e (L m)) = (z_K, (1 : A_K)) * e_prod (k ⊗ₜ[B₀] e m)
        rw [hm]
        rcases hx : e m with ⟨b_val, a_val⟩
        have h_mul : (z, (1 : A_rest)) * (b_val, a_val) = (z * b_val, a_val) := by ext <;> simp
        rw [h_mul]
        ext
        · change (Algebra.TensorProduct.rid B₀ K₀ K₀) (k ⊗ₜ[B₀] (z * b_val)) =
            z_K * (Algebra.TensorProduct.rid B₀ K₀ K₀) (k ⊗ₜ[B₀] b_val)
          simp [z_K, Algebra.smul_def, mul_left_comm, mul_comm]
        · simp [e_prod]
      | add x y ihx ihy => simp only [map_add, ihx, ihy, mul_add]
    let diag_fn : Fin d → K₀ := fun i => Fin.cases z_K (fun _ => (1 : K₀)) ((finCongr h_finrank.symm) i)
    have hL_basis : ∀ i : Fin d, L_K (b_target i) = diag_fn i • b_target i := by
      intro i
      apply e_K.injective
      rw [hLK_eval, map_smul]
      let i₀ : Fin (d₀ + 1) := (finCongr h_finrank.symm) i
      have hb_eq : e_K (b_target i) = v_prod i₀ := by
        simp [b_target, b_prod, i₀]
      rw [hb_eq]
      have h_step : ∀ k₀ : Fin (d₀ + 1),
          (z_K, (1 : A_K)) * v_prod k₀ =
            (Fin.cases (motive := fun _ => K₀) z_K (fun _ => (1 : K₀)) k₀) • v_prod k₀ := by
        intro k₀
        refine Fin.cases ?_ (fun j => ?_) k₀
        · ext <;> simp [v_prod]
        · ext <;> simp [v_prod]
      exact h_step i₀
    have h_mat : LinearMap.toMatrix b_target b_target L_K = Matrix.diagonal diag_fn := by
      ext i j
      rw [LinearMap.toMatrix_apply, hL_basis j, map_smul, b_target.repr_self,
        Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.single_apply, Matrix.diagonal_apply]
      by_cases hij : i = j
      · subst hij; simp
      · have hji : j ≠ i := Ne.symm hij
        simp [hij, hji]
    rw [h_mat, Matrix.det_diagonal]
    have h_prod : (∏ i : Fin d, diag_fn i) =
        ∏ i₀ : Fin (d₀ + 1), Fin.cases z_K (fun _ => (1 : K₀)) i₀ :=
      Fintype.prod_equiv (finCongr h_finrank.symm) _ _ (fun _ => rfl)
    rw [h_prod, Fin.prod_univ_succ]
    simp [z_K]
  
  have krullDim_one_prime_isMaximal
      {X : AlgebraicGeometry.Scheme.{u}}
      (hDim : topologicalKrullDim X = (1 : WithBot ℕ∞))
      (U : X.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      [IsDomain ↑(X.presheaf.obj (Opposite.op U))]
      (p : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U)))
      (hp_ne : p.asIdeal ≠ ⊥) :
      True ∧ p.asIdeal.IsMaximal := by
    refine ⟨trivial, ?_⟩
    let A := ↑(X.presheaf.obj (Opposite.op U))
    obtain ⟨m, hm_max, hp_le⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
    by_contra h_not_max
    have hp_ne_m : p.asIdeal ≠ m := fun h => h_not_max (h ▸ hm_max)
    have hm_not_le : ¬ (m ≤ p.asIdeal) := fun hle => hp_ne_m (le_antisymm hp_le hle)
    have hp_not_bot : ¬ (p.asIdeal ≤ ⊥) := fun hle => hp_ne (le_bot_iff.mp hle)
    let q₀ : PrimeSpectrum A := ⟨m, hm_max.isPrime⟩
    let q₁ : PrimeSpectrum A := p
    let q₂ : PrimeSpectrum A := ⟨⊥, Ideal.isPrime_bot⟩
    let f : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U)) ⟶ X := hAff.fromSpec
    have hEmb : Topology.IsOpenEmbedding f.base := f.isOpenEmbedding
    let mkIC : ↥X → TopologicalSpace.IrreducibleCloseds ↥X := fun z =>
      ⟨closure ({z} : Set ↥X), isIrreducible_singleton.closure, isClosed_closure⟩
    have h_spec_cl : ∀ {a b : PrimeSpectrum A},
        a ∈ closure ({b} : Set (PrimeSpectrum A)) ↔ b.asIdeal ≤ a.asIdeal := by
      intro a b
      constructor
      · intro hab
        have hsub : closure ({b} : Set (PrimeSpectrum A)) ⊆
            PrimeSpectrum.zeroLocus (b.asIdeal : Set A) :=
          closure_minimal (Set.singleton_subset_iff.mpr fun _ hx => hx)
            (PrimeSpectrum.isClosed_zeroLocus _)
        exact hsub hab
      · intro hle
        rw [mem_closure_iff]
        intro O hO haO
        by_contra h_empty
        have hb_not : b ∉ O := fun hbO => h_empty ⟨b, hbO, Set.mem_singleton b⟩
        obtain ⟨t, ht⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus Oᶜ).mp hO.isClosed_compl
        have hb_zl : b ∈ PrimeSpectrum.zeroLocus t := ht ▸ hb_not
        have ha_zl : a ∈ PrimeSpectrum.zeroLocus t := Set.Subset.trans hb_zl hle
        have ha_not : a ∈ Oᶜ := ht.symm ▸ ha_zl
        exact ha_not haO
    have h_mem_cl : ∀ {a b : PrimeSpectrum A},
        f.base a ∈ closure ({f.base b} : Set ↥X) ↔ b.asIdeal ≤ a.asIdeal := by
      intro a b
      constructor
      · intro hmem
        have hab : a ∈ closure ({b} : Set (PrimeSpectrum A)) := by
          rw [mem_closure_iff]
          intro O hO haO
          have hOpen_fO : IsOpen (f.base '' O) := hEmb.isOpenMap O hO
          obtain ⟨y, ⟨ha_im, hy_b⟩⟩ := mem_closure_iff.mp hmem (f.base '' O) hOpen_fO ⟨a, haO, rfl⟩
          rcases ha_im with ⟨a', ha'O, rfl⟩
          rw [Set.mem_singleton_iff] at hy_b
          have h_eq : a' = b := hEmb.injective hy_b
          exact ⟨b, h_eq ▸ ha'O, Set.mem_singleton b⟩
        exact h_spec_cl.mp hab
      · intro hle
        have hab : a ∈ closure ({b} : Set (PrimeSpectrum A)) := h_spec_cl.mpr hle
        have h_cont := Continuous.closure_preimage_subset f.continuous ({f.base b} : Set ↥X)
        have hb_pre : ({b} : Set (PrimeSpectrum A)) ⊆ f.base ⁻¹' ({f.base b} : Set ↥X) := by
          intro z hz; rw [Set.mem_singleton_iff.mp hz]; exact Set.mem_singleton _
        exact h_cont (closure_mono hb_pre hab)
    have h01 : mkIC (f.base q₀) < mkIC (f.base q₁) := by
      refine lt_of_le_of_ne ?_ ?_
      · exact closure_minimal (Set.singleton_subset_iff.mpr (h_mem_cl.mpr hp_le)) isClosed_closure
      · intro hEq
        have h_in : f.base q₁ ∈ (mkIC (f.base q₀) : Set ↥X) := by
          rw [hEq]; exact subset_closure (Set.mem_singleton _)
        exact hm_not_le (h_mem_cl.mp h_in)
    have h12 : mkIC (f.base q₁) < mkIC (f.base q₂) := by
      refine lt_of_le_of_ne ?_ ?_
      · exact closure_minimal (Set.singleton_subset_iff.mpr (h_mem_cl.mpr bot_le)) isClosed_closure
      · intro hEq
        have h_in : f.base q₂ ∈ (mkIC (f.base q₁) : Set ↥X) := by
          rw [hEq]; exact subset_closure (Set.mem_singleton _)
        exact hp_not_bot (h_mem_cl.mp h_in)
    let ser : LTSeries (TopologicalSpace.IrreducibleCloseds ↥X) :=
      { length := 2
        toFun := ![mkIC (f.base q₀), mkIC (f.base q₁), mkIC (f.base q₂)]
        step := fun i => by
          fin_cases i
          · exact h01
          · exact h12 }
    have h_len : (2 : WithBot ℕ∞) ≤ topologicalKrullDim X :=
      le_iSup (fun s : LTSeries (TopologicalSpace.IrreducibleCloseds ↥X) =>
        (s.length : WithBot ℕ∞)) ser
    rw [hDim] at h_len
    exact absurd h_len (by decide)
  have away_specComap_injective {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
      (g : A) [IsLocalization.Away g B] :
      Function.Injective (PrimeSpectrum.comap (algebraMap A B)) := by
    intro p₁ p₂ h_eq
    ext x
    have h_le : ∀ {q₁ q₂ : PrimeSpectrum B},
        PrimeSpectrum.comap (algebraMap A B) q₁ = PrimeSpectrum.comap (algebraMap A B) q₂ →
        q₁.asIdeal ≤ q₂.asIdeal := by
      intro q₁ q₂ hq z hz
      obtain ⟨⟨a, ⟨_, ⟨k, rfl⟩⟩⟩, hza⟩ := IsLocalization.surj (Submonoid.powers g) z
      have ha_q1 : a ∈ (PrimeSpectrum.comap (algebraMap A B) q₁).asIdeal := by
        change algebraMap A B a ∈ q₁.asIdeal
        rw [← hza]
        exact Ideal.mul_mem_right _ _ hz
      rw [hq] at ha_q1
      have hza_q2 : z * algebraMap A B (g ^ k) ∈ q₂.asIdeal := hza.symm ▸ ha_q1
      have hu : IsUnit (algebraMap A B (g ^ k)) :=
        IsLocalization.map_units B (⟨g ^ k, pow_mem (Submonoid.mem_powers g) k⟩ : Submonoid.powers g)
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have hz_eq : z = (z * algebraMap A B (g ^ k)) * v := by
        rw [mul_assoc, hv, mul_one]
      rw [hz_eq]
      exact Ideal.mul_mem_right _ _ hza_q2
    exact ⟨fun hx => h_le h_eq hx, fun hx => h_le h_eq.symm hx⟩
  have finite_primes_containing_ne_zero
      {X : AlgebraicGeometry.Scheme.{u}}
      (hDim : topologicalKrullDim X = (1 : WithBot ℕ∞))
      (U : X.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      [IsDomain ↑(X.presheaf.obj (Opposite.op U))]
      [IsNoetherianRing ↑(X.presheaf.obj (Opposite.op U))]
      (g : ↑(X.presheaf.obj (Opposite.op U))) (hg : g ≠ 0) :
      True ∧ ({p : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U)) | g ∈ p.asIdeal}).Finite := by
    refine ⟨trivial, ?_⟩
    let A := ↑(X.presheaf.obj (Opposite.op U))
    let I : Ideal A := Ideal.span {g}
    let Q := A ⧸ I
    let mkQ : A →+* Q := Ideal.Quotient.mk I
    have hSurj : Function.Surjective mkQ := Ideal.Quotient.mk_surjective
    have hMinFin : (minimalPrimes Q).Finite := minimalPrimes.finite_of_isNoetherianRing Q
    let toQ : PrimeSpectrum A → Ideal Q := fun p => Ideal.map mkQ p.asIdeal
    refine hMinFin.of_injOn (f := toQ) (fun p hp => ?_) (fun p₁ hp₁ p₂ hp₂ hEq => ?_)
    · have hI_le : I ≤ p.asIdeal := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hp)
      have hker_le : RingHom.ker mkQ ≤ p.asIdeal := by
        rwa [Ideal.mk_ker]
      have hp_primeQ : (toQ p).IsPrime := Ideal.map_isPrime_of_surjective hSurj hker_le
      refine ⟨⟨hp_primeQ, bot_le⟩, fun Q' ⟨hQ'_prime, _⟩ hQ'_le => ?_⟩
      let q' : PrimeSpectrum A := ⟨Q'.comap mkQ, hQ'_prime.comap mkQ⟩
      have hg_q' : g ∈ q'.asIdeal := by
        change mkQ g ∈ Q'
        have h0 : mkQ g = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [h0]
        exact Q'.zero_mem
      have hq'_ne : q'.asIdeal ≠ ⊥ := fun hbot => hg (Ideal.mem_bot.mp (hbot ▸ hg_q'))
      have hq'_max : q'.asIdeal.IsMaximal :=
        (krullDim_one_prime_isMaximal hDim U hAff q' hq'_ne).2
      have h_comap_toQ : (toQ p).comap mkQ = p.asIdeal :=
        (Ideal.comap_map_of_surjective' mkQ hSurj p.asIdeal).trans (sup_eq_left.mpr hker_le)
      have hq'_le_p : q'.asIdeal ≤ p.asIdeal :=
        h_comap_toQ ▸ Ideal.comap_mono hQ'_le
      have hq'_eq_p : q'.asIdeal = p.asIdeal :=
        hq'_max.eq_of_le p.isPrime.ne_top hq'_le_p
      have h_map_q' : Ideal.map mkQ q'.asIdeal = Q' :=
        Ideal.map_comap_of_surjective mkQ hSurj Q'
      rw [← h_map_q', hq'_eq_p]
    · have hker₁ : RingHom.ker mkQ ≤ p₁.asIdeal := by
        rw [Ideal.mk_ker]; exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hp₁)
      have hker₂ : RingHom.ker mkQ ≤ p₂.asIdeal := by
        rw [Ideal.mk_ker]; exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hp₂)
      have hc₁ : (toQ p₁).comap mkQ = p₁.asIdeal :=
        (Ideal.comap_map_of_surjective' mkQ hSurj p₁.asIdeal).trans (sup_eq_left.mpr hker₁)
      have hc₂ : (toQ p₂).comap mkQ = p₂.asIdeal :=
        (Ideal.comap_map_of_surjective' mkQ hSurj p₂.asIdeal).trans (sup_eq_left.mpr hker₂)
      ext1
      rw [← hc₁, ← hc₂]
      exact congrArg (Ideal.comap mkQ) hEq
  have localized_algebra_basis_and_det
      {d : ℕ} (_hd : 1 ≤ d)
      {R S R' S' : Type u} [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
      [CommRing R'] [CommRing S']
      [Algebra R S] [Algebra R R'] [Algebra S S'] [Algebra R' S']
      (hcomm : ∀ r : R, algebraMap R' S' (algebraMap R R' r) = algebraMap S S' (algebraMap R S r))
      (T : Submonoid R) (hT_zero : (0 : R) ∉ T)
      [IsLocalization T R']
      [IsLocalization (T.map (algebraMap R S)) S']
      (b : Module.Basis (Fin d) R S) :
      IsDomain S' ∧
      ∃ b' : Module.Basis (Fin d) R' S',
        (∀ i : Fin d, b' i = algebraMap S S' (b i)) ∧
        ∀ (s : S) (L : S →ₗ[R] S) (L' : S' →ₗ[R'] S'),
          (∀ x : S, L x = s * x) →
          (∀ x : S', L' x = algebraMap S S' s * x) →
          ((LinearMap.toMatrix b' b') L').det =
            algebraMap R R' (((LinearMap.toMatrix b b) L).det) := by
    have hφ_inj : Function.Injective (algebraMap R S) := by
      refine (injective_iff_map_eq_zero _).mpr fun r hr => ?_
      have h1_ne : (1 : S) ≠ 0 := one_ne_zero
      have hex : ∃ i : Fin d, b.repr 1 i ≠ 0 := by
        by_contra hall
        apply h1_ne
        apply b.repr.injective
        rw [map_zero]
        ext i
        exact not_not.mp fun hni => hall ⟨i, hni⟩
      obtain ⟨i₀, hi₀⟩ := hex
      have h0 : r • (1 : S) = 0 := by rw [Algebra.smul_def, hr, zero_mul]
      have h0' := congrArg (fun x => b.repr x i₀) h0
      simp only [map_smul, map_zero, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul,
        Finsupp.coe_zero, Pi.zero_apply] at h0'
      exact (mul_eq_zero.mp h0').resolve_right hi₀
    have hT_nzd : T.map (algebraMap R S) ≤ nonZeroDivisors S := by
      rintro _ ⟨t, ht, rfl⟩
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro h0
      apply hT_zero
      have ht0 : t = 0 := hφ_inj (h0.trans (map_zero _).symm)
      exact ht0 ▸ ht
    have hDom_loc : IsDomain (Localization (T.map (algebraMap R S))) :=
      IsLocalization.isDomain_localization hT_nzd
    have hDomS' : IsDomain S' :=
      (IsLocalization.algEquiv (T.map (algebraMap R S))
        (Localization (T.map (algebraMap R S))) S').symm.toRingEquiv.toMulEquiv.isDomain
        (Localization (T.map (algebraMap R S)))
    have hψS_inj : Function.Injective (algebraMap S S') :=
      IsLocalization.injective S' hT_nzd
    refine ⟨hDomS', ?_⟩
    let v' : Fin d → S' := fun i => algebraMap S S' (b i)
    have hv'_li : LinearIndependent R' v' := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      obtain ⟨t, hc⟩ := IsLocalization.exist_integer_multiples_of_finite T g
      choose c hc_eq using hc
      have ht_unit : IsUnit (algebraMap R R' (t : R)) := IsLocalization.map_units R' t
      have h_scaled : algebraMap R R' (t : R) • (∑ i : Fin d, g i • v' i) = 0 := by
        rw [hg, smul_zero]
      rw [Finset.smul_sum] at h_scaled
      have h_sum_S : algebraMap S S' (∑ i : Fin d, c i • b i) = 0 := by
        rw [map_sum]
        refine Eq.trans ?_ h_scaled
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Algebra.smul_def, map_mul, ← hcomm (c i), hc_eq i, smul_smul]
        rw [Algebra.smul_def (t : R) (g i), Algebra.smul_def (algebraMap R R' ↑t * g i) (v' i)]
      have h_sum0 : ∑ i : Fin d, c i • b i = 0 :=
        hψS_inj (h_sum_S.trans (map_zero _).symm)
      have hc0 : ∀ i : Fin d, c i = 0 :=
        Fintype.linearIndependent_iff.mp b.linearIndependent c h_sum0
      intro i
      have hgi : algebraMap R R' (t : R) * g i = 0 := by
        have h1 := (hc_eq i).symm
        rw [Algebra.smul_def] at h1
        rw [h1, hc0 i, map_zero]
      exact ht_unit.mul_right_eq_zero.mp hgi
    have hv'_span : ⊤ ≤ Submodule.span R' (Set.range v') := by
      intro s' _
      obtain ⟨⟨s₀, ⟨_, ⟨t, ht, rfl⟩⟩⟩, hs'⟩ := IsLocalization.surj (T.map (algebraMap R S)) s'
      have ht_unit : IsUnit (algebraMap R R' t) := IsLocalization.map_units R' ⟨t, ht⟩
      let u_t : R'ˣ := ht_unit.unit
      have hu_t : (u_t : R') = algebraMap R R' t := rfl
      have hs'_eq : s' = ∑ i : Fin d,
          (algebraMap R R' (b.repr s₀ i) * (↑u_t⁻¹ : R')) • v' i := by
        have h_cancel : algebraMap S S' (algebraMap R S t) * (algebraMap R' S' ↑u_t⁻¹) = 1 := by
          rw [← hcomm t, ← hu_t, ← map_mul, Units.mul_inv, map_one]
        calc
          s' = (s' * algebraMap S S' (algebraMap R S t)) * algebraMap R' S' ↑u_t⁻¹ := by
            rw [mul_assoc, h_cancel, mul_one]
          _ = algebraMap S S' s₀ * algebraMap R' S' ↑u_t⁻¹ := by rw [hs']
          _ = algebraMap S S' (∑ i : Fin d, (b.repr s₀ i) • b i) * algebraMap R' S' ↑u_t⁻¹ := by
            rw [b.sum_repr s₀]
          _ = ∑ i : Fin d, (algebraMap R R' (b.repr s₀ i) * (↑u_t⁻¹ : R')) • v' i := by
            rw [map_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, map_mul, ← hcomm]
            dsimp [v']
            ring
      rw [hs'_eq]
      exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
    let b' : Module.Basis (Fin d) R' S' := Module.Basis.mk hv'_li hv'_span
    have hb'_apply : ∀ i : Fin d, b' i = algebraMap S S' (b i) := by
      intro i; simp [b', v']
    refine ⟨b', hb'_apply, fun s L L' hL hL' => ?_⟩
    have h_mat : LinearMap.toMatrix b' b' L' =
        (RingHom.mapMatrix (algebraMap R R')) ((LinearMap.toMatrix b b) L) := by
      ext i j
      rw [LinearMap.toMatrix_apply, RingHom.mapMatrix_apply, Matrix.map_apply,
        LinearMap.toMatrix_apply]
      have hL'_sum : L' (b' j) = ∑ k : Fin d, (algebraMap R R' (b.repr (L (b j)) k)) • b' k := by
        rw [hL', hb'_apply j, ← map_mul, ← hL (b j)]
        conv_lhs => rw [← b.sum_repr (L (b j))]
        rw [map_sum]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [hb'_apply k, Algebra.smul_def, Algebra.smul_def, map_mul, hcomm]
      rw [hL'_sum, map_sum]
      simp only [map_smul, b'.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
        Finsupp.finsetSum_apply, Finsupp.single_apply, Finset.sum_ite_eq', Finset.mem_univ,
        ↓reduceIte]
    rw [h_mat, ← RingHom.map_det]
  have dvr_triangular_basis_det_span
      {d : ℕ} (hd : 1 ≤ d)
      {R_q S_q : Type u} [CommRing R_q] [IsDomain R_q] [IsLocalRing R_q]
      [CommRing S_q] [IsDomain S_q] [Algebra R_q S_q]
      (b_q : Module.Basis (Fin d) R_q S_q)
      (ϖ_q : R_q) (hϖ_ne : ϖ_q ≠ 0)
      (hmax_R : IsLocalRing.maximalIdeal R_q = Ideal.span {ϖ_q})
      (M_x : Ideal S_q) (hMx_max : M_x.IsMaximal)
      (hRes : ∀ s : S_q, ∃ r : R_q, s - algebraMap R_q S_q r ∈ M_x)
      (f_q : S_q) (hf_span : Ideal.span {f_q} = M_x)
      (L_q : S_q →ₗ[R_q] S_q) (hLq : ∀ s : S_q, L_q s = f_q * s) :
      Ideal.span {((LinearMap.toMatrix b_q b_q) L_q).det} = IsLocalRing.maximalIdeal R_q := by
    have : Module.Finite R_q S_q := Module.Finite.of_basis b_q
    have : Algebra.IsIntegral R_q S_q := Algebra.IsIntegral.of_finite R_q S_q
    have h_comap_max : (M_x.comap (algebraMap R_q S_q)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R_q S_q)
        (fun z => Algebra.IsIntegral.isIntegral (R := R_q) z) M_x
    have h_comap_eq : M_x.comap (algebraMap R_q S_q) = IsLocalRing.maximalIdeal R_q :=
      IsLocalRing.eq_maximalIdeal h_comap_max
    have hex_i₀ : ∃ i₀ : Fin d, b_q i₀ ∉ M_x := by
      by_contra h_all
      apply hMx_max.ne_top
      rw [eq_top_iff]
      intro s _
      rw [← b_q.sum_repr s]
      refine Ideal.sum_mem M_x (fun i _ => ?_)
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_left M_x _ (not_not.mp fun hni => h_all ⟨i, hni⟩)
    obtain ⟨i₀, hi₀⟩ := hex_i₀
    let j₀ : Fin d := ⟨0, by omega⟩
    let b₁ : Module.Basis (Fin d) R_q S_q := b_q.reindex (Equiv.swap i₀ j₀)
    have hb₁_j₀ : b₁ j₀ ∉ M_x := by simpa [b₁] using hi₀
    choose r_lift hr_lift using fun j : Fin d => hRes (b₁ j)
    have hr₀_not_mem : r_lift j₀ ∉ IsLocalRing.maximalIdeal R_q := by
      rw [← h_comap_eq]
      intro hmem
      apply hb₁_j₀
      have h1 : b₁ j₀ = (b₁ j₀ - algebraMap R_q S_q (r_lift j₀)) + algebraMap R_q S_q (r_lift j₀) := by
        ring
      rw [h1]
      exact Ideal.add_mem M_x (hr_lift j₀) hmem
    have hr₀_unit : IsUnit (r_lift j₀) := IsLocalRing.notMem_maximalIdeal.mp hr₀_not_mem
    let u₀ : R_qˣ := hr₀_unit.unit
    have hu₀_val : (u₀ : R_q) = r_lift j₀ := rfl
    let T : S_q →ₗ[R_q] S_q :=
      b₁.constr R_q (fun j => if j = j₀ then (↑u₀⁻¹ : R_q) • b₁ j₀
        else b₁ j - (r_lift j * ↑u₀⁻¹) • b₁ j₀)
    let T_inv : S_q →ₗ[R_q] S_q :=
      b₁.constr R_q (fun j => if j = j₀ then (u₀ : R_q) • b₁ j₀
        else b₁ j + (r_lift j) • b₁ j₀)
    have hT_inv_left : T_inv.comp T = LinearMap.id := by
      apply b₁.ext
      intro j
      simp only [LinearMap.comp_apply, LinearMap.id_apply, T, T_inv, Module.Basis.constr_basis]
      split_ifs with hj
      · subst hj
        simp only [map_smul, Module.Basis.constr_basis, ↓reduceIte, smul_smul,
          Units.inv_mul, one_smul]
      · simp only [map_sub, map_smul, Module.Basis.constr_basis, hj, ↓reduceIte, smul_smul]
        rw [mul_assoc, Units.inv_mul, mul_one]
        abel
    have hT_inv_right : T.comp T_inv = LinearMap.id := by
      apply b₁.ext
      intro j
      simp only [LinearMap.comp_apply, LinearMap.id_apply, T, T_inv, Module.Basis.constr_basis]
      split_ifs with hj
      · subst hj
        simp only [map_smul, Module.Basis.constr_basis, ↓reduceIte, smul_smul,
          Units.mul_inv, one_smul]
      · simp only [map_add, map_smul, Module.Basis.constr_basis, hj, ↓reduceIte, smul_smul]
        abel
    let e_T : S_q ≃ₗ[R_q] S_q :=
      LinearEquiv.ofLinearMap T T_inv hT_inv_right hT_inv_left
    let b' : Module.Basis (Fin d) R_q S_q := b₁.map e_T
    have hb'_j₀_eq : b' j₀ = (↑u₀⁻¹ : R_q) • b₁ j₀ := by
      change T (b₁ j₀) = _
      simp only [T, Module.Basis.constr_basis, ↓reduceIte]
    have hb'_j₀_sub : b' j₀ - 1 ∈ M_x := by
      have h1 : (1 : S_q) = (↑u₀⁻¹ : R_q) • algebraMap R_q S_q (r_lift j₀) := by
        rw [Algebra.smul_def, ← map_mul, ← hu₀_val, Units.inv_mul, map_one]
      rw [hb'_j₀_eq, h1, ← smul_sub, Algebra.smul_def]
      exact Ideal.mul_mem_left M_x _ (hr_lift j₀)
    have hb'_other_mem : ∀ j : Fin d, j ≠ j₀ → b' j ∈ M_x := by
      intro j hj
      have hbj : b' j = b₁ j - (r_lift j) • b' j₀ := by
        change T (b₁ j) = _
        simp only [T, Module.Basis.constr_basis, hj, ↓reduceIte, hb'_j₀_eq, smul_smul]
      have h_decomp : b₁ j - (r_lift j) • b' j₀ =
          (b₁ j - algebraMap R_q S_q (r_lift j)) - (r_lift j) • (b' j₀ - 1) := by
        rw [Algebra.smul_def, Algebra.smul_def]
        ring
      rw [hbj, h_decomp]
      refine Ideal.sub_mem M_x (hr_lift j) ?_
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_left M_x _ hb'_j₀_sub
    have hMx_iff : ∀ s : S_q, s ∈ M_x ↔ b'.repr s j₀ ∈ IsLocalRing.maximalIdeal R_q := by
      intro s
      let tail : S_q := (b'.repr s j₀) • (b' j₀ - 1) +
        ∑ j ∈ Finset.univ.erase j₀, (b'.repr s j) • b' j
      have hs_eq : s = algebraMap R_q S_q (b'.repr s j₀) + tail := by
        have hsum := (b'.sum_repr s).symm
        rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j₀)] at hsum
        conv_lhs => rw [hsum]
        dsimp only [tail]
        simp only [Algebra.smul_def]
        ring
      have h_tail_mem : tail ∈ M_x := by
        refine Ideal.add_mem M_x ?_ ?_
        · rw [Algebra.smul_def]; exact Ideal.mul_mem_left M_x _ hb'_j₀_sub
        · refine Ideal.sum_mem M_x (fun j hj => ?_)
          rw [Algebra.smul_def]
          exact Ideal.mul_mem_left M_x _ (hb'_other_mem j (Finset.ne_of_mem_erase hj))
      rw [← h_comap_eq, Ideal.mem_comap]
      constructor
      · intro hs
        have hdiff : s - tail ∈ M_x := Ideal.sub_mem M_x hs h_tail_mem
        have h_alg : s - tail = algebraMap R_q S_q (b'.repr s j₀) :=
          sub_eq_of_eq_add hs_eq
        rwa [h_alg] at hdiff
      · intro hr
        rw [hs_eq]
        exact Ideal.add_mem M_x hr h_tail_mem
    let diag_fn : Fin d → R_q := fun j => if j = j₀ then ϖ_q else 1
    let D : S_q →ₗ[R_q] S_q := b'.constr R_q (fun j => diag_fn j • b' j)
    have hD_inj : Function.Injective D := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro s hs
      rw [LinearMap.mem_ker] at hs
      apply b'.repr.injective
      rw [map_zero]
      ext j
      have hDs : D s = ∑ i : Fin d, (b'.repr s i * diag_fn i) • b' i := by
        conv_lhs => rw [← b'.sum_repr s]
        simp only [map_sum, map_smul, D, Module.Basis.constr_basis, smul_smul]
      rw [hDs] at hs
      have h_coord := Fintype.linearIndependent_iff.mp b'.linearIndependent
        (fun i => b'.repr s i * diag_fn i) hs j
      dsimp [diag_fn] at h_coord
      split_ifs at h_coord with hj
      · exact (mul_eq_zero.mp h_coord).resolve_right hϖ_ne
      · simpa using h_coord
    have hD_range : LinearMap.range D = M_x.restrictScalars R_q := by
      ext s
      simp only [LinearMap.mem_range, Submodule.restrictScalars_mem, hMx_iff, hmax_R,
        Ideal.mem_span_singleton]
      constructor
      · rintro ⟨w, rfl⟩
        have hw : D w = ∑ i : Fin d, (b'.repr w i * diag_fn i) • b' i := by
          conv_lhs => rw [← b'.sum_repr w]
          simp only [map_sum, map_smul, D, Module.Basis.constr_basis, smul_smul]
        rw [hw, map_sum]
        simp only [map_smul, b'.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
          Finsupp.finsetSum_apply, Finsupp.single_apply, Finset.sum_ite_eq', Finset.mem_univ,
          ↓reduceIte, diag_fn]
        exact ⟨b'.repr w j₀, mul_comm _ _⟩
      · rintro ⟨c₀, hc₀⟩
        refine ⟨c₀ • b' j₀ + ∑ j ∈ Finset.univ.erase j₀, (b'.repr s j) • b' j, ?_⟩
        simp only [map_add, map_sum, map_smul, D, Module.Basis.constr_basis, diag_fn, ↓reduceIte,
          smul_smul]
        have h_er : (∑ x ∈ Finset.univ.erase j₀,
              (b'.repr s x * (if x = j₀ then ϖ_q else 1)) • b' x) =
            ∑ x ∈ Finset.univ.erase j₀, (b'.repr s x) • b' x := by
          refine Finset.sum_congr rfl (fun x hx => ?_)
          rw [ite_eq_right_iff.mpr (fun h => absurd h (Finset.ne_of_mem_erase hx)), mul_one]
        rw [h_er, mul_comm c₀ ϖ_q, ← hc₀,
          Finset.add_sum_erase Finset.univ (fun j => (b'.repr s j) • b' j) (Finset.mem_univ j₀),
          b'.sum_repr]
    have hf_ne : f_q ≠ 0 := by
      intro hf0
      have hϖ_mem : ϖ_q ∈ M_x.comap (algebraMap R_q S_q) := by
        rw [h_comap_eq, hmax_R]
        exact Ideal.subset_span rfl
      rw [Ideal.mem_comap, ← hf_span, hf0, Ideal.span_singleton_zero, Ideal.mem_bot] at hϖ_mem
      have h1_ne : (1 : S_q) ≠ 0 := zero_ne_one.symm
      apply h1_ne
      apply b_q.repr.injective
      rw [map_zero]
      ext i
      have h0 : ϖ_q • (1 : S_q) = 0 := by rw [Algebra.smul_def, hϖ_mem, zero_mul]
      have h0' := congrArg (fun x => b_q.repr x i) h0
      simp only [map_smul, map_zero, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul,
        Finsupp.coe_zero, Pi.zero_apply] at h0'
      exact (mul_eq_zero.mp h0').resolve_left hϖ_ne
    have hLq_inj : Function.Injective L_q := by
      intro x y hxy
      rw [hLq, hLq] at hxy
      exact mul_left_cancel₀ hf_ne hxy
    have hLq_range : LinearMap.range L_q = M_x.restrictScalars R_q := by
      rw [← hf_span]
      ext s
      simp only [LinearMap.mem_range, Submodule.restrictScalars_mem, Ideal.mem_span_singleton,
        dvd_iff_exists_eq_mul_left]
      constructor
      · rintro ⟨w, rfl⟩; exact ⟨w, (hLq w).trans (mul_comm _ _)⟩
      · rintro ⟨w, rfl⟩; exact ⟨w, (hLq w).trans (mul_comm _ _)⟩
    let e_Lq : S_q ≃ₗ[R_q] ↥(LinearMap.range L_q) := LinearEquiv.ofInjective L_q hLq_inj
    let e_D : S_q ≃ₗ[R_q] ↥(LinearMap.range D) := LinearEquiv.ofInjective D hD_inj
    let E : S_q ≃ₗ[R_q] S_q :=
      e_Lq.trans ((LinearEquiv.ofEq _ _ (hLq_range.trans hD_range.symm)).trans e_D.symm)
    have h_comp : D.comp E.toLinearMap = L_q := by
      ext s
      change D (e_D.symm ⟨L_q s, _⟩) = L_q s
      have h_app := e_D.apply_symm_apply ⟨L_q s, by rw [hD_range, ← hLq_range]; exact ⟨s, rfl⟩⟩
      exact congrArg Subtype.val h_app
    have hD_det : LinearMap.det D = ϖ_q := by
      rw [← LinearMap.det_toMatrix b' D]
      have h_mat : LinearMap.toMatrix b' b' D = Matrix.diagonal diag_fn := by
        ext i j
        rw [LinearMap.toMatrix_apply]
        change (b'.repr (D (b' j))) i = Matrix.diagonal diag_fn i j
        simp only [D, Module.Basis.constr_basis, map_smul, b'.repr_self, Finsupp.smul_single,
          smul_eq_mul, mul_one, Finsupp.single_apply, Matrix.diagonal_apply]
        by_cases hij : i = j
        · subst hij; simp
        · have hji : j ≠ i := Ne.symm hij
          simp [hij, hji]
      rw [h_mat, Matrix.det_diagonal]
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ j₀)]
      simp only [diag_fn, ↓reduceIte]
      have h1 : ∏ x ∈ Finset.univ.erase j₀, (if x = j₀ then ϖ_q else (1 : R_q)) = 1 :=
        Finset.prod_eq_one (fun x hx =>
          ite_eq_right_iff.mpr (fun h => absurd h (Finset.ne_of_mem_erase hx)))
      rw [h1, mul_one]
    rw [LinearMap.det_toMatrix b_q L_q, ← h_comp, LinearMap.det_comp, hD_det, hmax_R]
    exact Ideal.span_singleton_mul_right_unit E.isUnit_det' ϖ_q
  
  have h_s4 (S : AlgebraicGeometry.Scheme.{u})
      (p_S : Quiver.Hom S (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (U : S.Etale)
      (u : ↑((weilEtaleGmPresheaf S).obj (Opposite.op U))) :
      ∃ (I : Type u) (V : I → S.Etale) (f : ∀ i : I, Quiver.Hom (V i) U)
        (w : ∀ i : I, ↑((weilEtaleGmPresheaf S).obj (Opposite.op (V i)))),
        CategoryTheory.Sieve.ofArrows V f ∈ S.smallEtaleTopology U ∧
        ∀ i : I, n • w i = ((weilEtaleGmPresheaf S).map (Opposite.op (f i))) u := by
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    let U_sch : AlgebraicGeometry.Scheme.{u} := (Fgt.obj U).left
    let u_hom : Quiver.Hom U_sch S := (Fgt.obj U).hom
    have hu_et : AlgebraicGeometry.Etale u_hom := U.prop
    have hex_pt : ∀ x : ↥U_sch,
        ∃ (Vx : S.Etale) (fx : Quiver.Hom Vx U)
          (wx : ↑((weilEtaleGmPresheaf S).obj (Opposite.op Vx))),
          AlgebraicGeometry.Etale fx.left ∧
          x ∈ Set.range fx.left.base ∧
          n • wx = ((weilEtaleGmPresheaf S).map (Opposite.op fx)) u := by
      intro x
      obtain ⟨W_x, hAff, hx, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : U_sch.Opens))
          (x := x) trivial
      let R_x : Type u := ↑(U_sch.presheaf.obj (Opposite.op W_x))
      let g_spec : AlgebraicGeometry.Spec (CommRingCat.of R_x) ⟶ U_sch := hAff.fromSpec
      let p_x : PrimeSpectrum R_x := hAff.isoSpec.hom.base ⟨x, hx⟩
      have hp_x : g_spec.base p_x = x := by
        change (hAff.isoSpec.inv ≫ W_x.ι).base (hAff.isoSpec.hom.base ⟨x, hx⟩) = x
        have h_inv : hAff.isoSpec.inv.base (hAff.isoSpec.hom.base ⟨x, hx⟩) = ⟨x, hx⟩ := by
          change (hAff.isoSpec.hom ≫ hAff.isoSpec.inv).base ⟨x, hx⟩ = ⟨x, hx⟩
          rw [hAff.isoSpec.hom_inv_id]
          rfl
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, h_inv]
        rfl
      let φ_U : ↑(U_sch.presheaf.obj (Opposite.op ⊤)) →+* R_x :=
        (g_spec.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_x)).hom).hom
      let u_U : Units ↑(U_sch.presheaf.obj (Opposite.op ⊤)) := Additive.toMul u
      let u_x : Units R_x := Units.map φ_U.toMonoidHom u_U
      let φ_Ω : Ω →+* R_x :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          (g_spec ≫ u_hom ≫ p_S).appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_x)).hom).hom
      have hUnit_n_Rx : IsUnit (n : R_x) := by
        rw [← map_natCast φ_Ω n]
        exact φ_Ω.isUnit_map hUnit_n
      let u_n : Units R_x := hUnit_n_Rx.unit
      have hu_n : (u_n : R_x) = (n : R_x) := hUnit_n_Rx.unit_spec
      let P_x : Polynomial R_x := Polynomial.X ^ n - Polynomial.C (u_x : R_x)
      have hMonic : P_x.Monic := Polynomial.monic_X_pow_sub_C (u_x : R_x) (by omega)
      have hn1 : n - 1 + 1 = n := by omega
      let q₁ : Polynomial R_x :=
        Polynomial.C ((↑(u_n⁻¹) : R_x) * (↑(u_x⁻¹) : R_x)) * Polynomial.X
      let q₂ : Polynomial R_x := Polynomial.C (-(↑(u_x⁻¹) : R_x))
      have hBez : Polynomial.derivative P_x * q₁ + P_x * q₂ = (1 : Polynomial R_x) ^ 1 := by
        have hder : Polynomial.derivative P_x = Polynomial.C (n : R_x) * Polynomial.X ^ (n - 1) := by
          dsimp [P_x]
          rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C, sub_zero]
        rw [hder]
        dsimp [P_x, q₁, q₂]
        have hXn : (Polynomial.X : Polynomial R_x) ^ (n - 1) * Polynomial.X = Polynomial.X ^ n := by
          rw [← pow_succ, hn1]
        have h1 : (n : R_x) * ((↑(u_n⁻¹) : R_x) * (↑(u_x⁻¹) : R_x)) = (↑(u_x⁻¹) : R_x) := by
          rw [← hu_n, ← mul_assoc, Units.mul_inv, one_mul]
        have h2 : Polynomial.C (u_x : R_x) * Polynomial.C (-(↑(u_x⁻¹) : R_x)) = -1 := by
          rw [← Polynomial.C_mul, mul_neg, Units.mul_inv, Polynomial.C_neg, Polynomial.C_1]
        calc
          Polynomial.C (n : R_x) * Polynomial.X ^ (n - 1) *
              (Polynomial.C ((↑(u_n⁻¹) : R_x) * (↑(u_x⁻¹) : R_x)) * Polynomial.X) +
            (Polynomial.X ^ n - Polynomial.C (u_x : R_x)) * Polynomial.C (-(↑(u_x⁻¹) : R_x))
          _ = (Polynomial.C (n : R_x) * Polynomial.C ((↑(u_n⁻¹) : R_x) * (↑(u_x⁻¹) : R_x))) *
              (Polynomial.X ^ (n - 1) * Polynomial.X) +
              (Polynomial.X ^ n * Polynomial.C (-(↑(u_x⁻¹) : R_x)) -
                Polynomial.C (u_x : R_x) * Polynomial.C (-(↑(u_x⁻¹) : R_x))) := by ring
          _ = (1 : Polynomial R_x) ^ 1 := by
            rw [hXn, ← Polynomial.C_mul, h1, h2, Polynomial.C_neg]
            ring
      let pair_x : StandardEtalePair R_x := StandardEtalePair.mk P_x hMonic 1 ⟨q₁, q₂, 1, hBez⟩
      let B_x : Type u := pair_x.Ring
      let π_x : AlgebraicGeometry.Spec (CommRingCat.of B_x) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_x) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_x B_x))
      have hEt_π : AlgebraicGeometry.Etale π_x :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          (RingHom.etale_algebraMap.mpr inferInstance)
      have hEt_fx : AlgebraicGeometry.Etale (π_x ≫ g_spec) := inferInstance
      have hEt_comp : AlgebraicGeometry.Etale ((π_x ≫ g_spec) ≫ u_hom) := inferInstance
      let Vx : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ ((π_x ≫ g_spec) ≫ u_hom) hEt_comp
      let fx : Quiver.Hom Vx U :=
        CategoryTheory.MorphismProperty.Over.homMk (π_x ≫ g_spec) rfl trivial
      let J_pair : Ideal (Polynomial (Polynomial R_x)) :=
        Ideal.span {Polynomial.C pair_x.f, Polynomial.X * Polynomial.C pair_x.g - 1}
      let r_x : B_x := Ideal.Quotient.mk J_pair (Polynomial.C Polynomial.X)
      have hrx_pow : r_x ^ n = algebraMap R_x B_x (u_x : R_x) := by
        have hq : ((Ideal.Quotient.mk J_pair) (Polynomial.C Polynomial.X)) ^ n =
            (Ideal.Quotient.mk J_pair) (Polynomial.C (Polynomial.C (u_x : R_x))) := by
          rw [← map_pow, ← Polynomial.C_pow]
