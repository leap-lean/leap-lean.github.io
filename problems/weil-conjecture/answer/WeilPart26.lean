  have hZeroBdryRep : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Opens)
      (hSh_0 : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology
        (weilAltZeroBdrySubpresheaf Z V n)),
      let K_ZV : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
        ⟨weilAltZeroBdrySubpresheaf Z V n, hSh_0⟩
      let V_et : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ V.ι
