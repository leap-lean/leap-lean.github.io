        intro U₀_m u₀_m x₀_m hx₀_m hAff₀_m hEt_u₀m hu₀m_comm
        let W₀_m := (Fgt_Pd1.obj U₀_m).left
        haveI : AlgebraicGeometry.IsAffine W₀_m := hAff₀_m
        haveI : AlgebraicGeometry.Etale u₀_m := hEt_u₀m
        obtain ⟨E⟩ :=
