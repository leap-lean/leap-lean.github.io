                  (E_top.j_W₁ ≫ ((Fgt_Pd1.obj U_eff).hom ≫ P_d1.hom)))) :=
              congrArg
                (fun m => p_U''₀ ≫
                  (hAff_U''₀.fromSpec ≫ (E_top.e_W₁.inv ≫ (E_top.j_W₁ ≫ m))))
                ((CategoryTheory.Category.assoc u_eff (ι_aff (δ₀ + 1)) P_d1.hom).symm.trans
                  (congrArg (· ≫ P_d1.hom) hueff_comm))
          _ = (g_to_Weff ≫ (Fgt_Pd1.obj U_eff).hom) ≫ P_d1.hom :=
              (congrArg (fun m => p_U''₀ ≫ (hAff_U''₀.fromSpec ≫ m))
                (CategoryTheory.Category.assoc E_top.e_W₁.inv E_top.j_W₁
                  ((Fgt_Pd1.obj U_eff).hom ≫ P_d1.hom)).symm).trans
                ((congrArg (p_U''₀ ≫ ·)
                  (CategoryTheory.Category.assoc hAff_U''₀.fromSpec
                    (E_top.e_W₁.inv ≫ E_top.j_W₁)
                    ((Fgt_Pd1.obj U_eff).hom ≫ P_d1.hom)).symm).trans
                  ((CategoryTheory.Category.assoc p_U''₀
                    (hAff_U''₀.fromSpec ≫ E_top.e_W₁.inv ≫ E_top.j_W₁)
                    ((Fgt_Pd1.obj U_eff).hom ≫ P_d1.hom)).symm.trans
                    (CategoryTheory.Category.assoc g_to_Weff
                      (Fgt_Pd1.obj U_eff).hom P_d1.hom).symm))

      have hBij_U' :
          Function.Bijective
            (fun z : weilEtaleLocalTorsionH P_d1.left (ℓ ^ r₀) U' (2 * (δ₀ + 1)) =>
              tr_Pd (δ₀ + 1) r₀
                (weilEtaleLocalTorsionCounitH P_d1.left (ℓ ^ r₀) U' (2 * (δ₀ + 1)) z)) := by
        have hEq_tr :
            (fun z : weilEtaleLocalTorsionH P_d1.left (ℓ ^ r₀) U' (2 * (δ₀ + 1)) =>
              tr_Pd (δ₀ + 1) r₀
                (weilEtaleLocalTorsionCounitH P_d1.left (ℓ ^ r₀) U' (2 * (δ₀ + 1)) z)) =
            (fun w : weilEtaleLocalTorsionH P_d1.left (ℓ ^ r₀) U'_fib (2 * (δ₀ + 1)) =>
              tr_Pd (δ₀ + 1) r₀
                (weilEtaleLocalTorsionCounitH P_d1.left (ℓ ^ r₀) U'_fib (2 * (δ₀ + 1)) w)) ∘
              (Ψ P_d1 P_d1 U' U'_fib (CategoryTheory.Iso.refl W') hRoof_chart r₀ (2 * (δ₀ + 1))) := by
          funext z
          exact hChartIndep (δ₀ + 1) U' U'_fib u'_orig u_fib
            (CategoryTheory.Iso.refl W') hRoof_chart hEt_u'orig hEt_ufib hu'orig_comm rfl r₀ z
        rw [hEq_tr]
        exact hBij_Ufib.comp
          (Ψ P_d1 P_d1 U' U'_fib (CategoryTheory.Iso.refl W') hRoof_chart r₀ (2 * (δ₀ + 1))).bijective

      refine ⟨U', v_W' ≫ v_eff, x'₀, hAff_W', hx'₀_cl, ?_, ?_, hBij_U'⟩
      · change (Fgt_Pd1.map v_eff).left.base (g_to_Weff.base x'₀) = x₀_s
        have hg_x'₀ : g_to_Weff.base x'₀ = x_eff := by
          have hp_x'₀ : p_U''₀.base x'₀ = u_pt₀ := by
            change (s_W' ≫ p_U''₀).base pt_k = u_pt₀
            rw [CategoryTheory.Limits.pullback.lift_fst]
            exact hs_U_pt
          change E_top.j_W₁.base (E_top.e_W₁.inv.base
            (hAff_U''₀.fromSpec.base (p_U''₀.base x'₀))) = x_eff
          rw [hp_x'₀, hu_pt₀]
          have he_x₁ : E_top.e_W₁.inv.base y_top = E_top.x₁ := by
            change (E_top.e_W₁.hom ≫ E_top.e_W₁.inv).base E_top.x₁ = E_top.x₁
            rw [E_top.e_W₁.hom_inv_id]
            rfl
          rw [he_x₁, E_top.hx₁_map]
        rw [hg_x'₀, hx_eff_map]
      · intro q hq z
        rw [hLocMapH_comp P_d1.left (ℓ ^ r₀) v_W' v_eff q z,
          hEff_sub q hq (weilEtaleLocalTorsionMapH P_d1.left (ℓ ^ r₀) v_W' q z)]

  obtain ⟨U', v₀, x'₀, hAff', _, hx'₀_map, hEff', hBij'⟩ :=
    H_ind δ r U₀ u₀ x₀ hx₀ hAff₀ hEt_u₀ hu₀_comm
  exact ⟨U', v₀, x'₀, hAff', hx'₀_map, hEff', hBij'⟩

theorem weil_etale_smooth_proper_trace_and_local_effacement (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (ζ : ℕ → kˣ)
    (hPrim : ∀ r : ℕ, IsPrimitiveRoot ((ζ r : kˣ) : k) (ℓ ^ r))
    (hPow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r) :
    ∃ tr : ∀ r : ℕ, weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+ ZMod (ℓ ^ r),
      (∀ (r : ℕ) (w : weilEtaleTorsionH X.left (ℓ ^ (r + 1)) (2 * d)),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr (r + 1) w) =
          tr r (weilEtaleTorsionTransition X.left ℓ r (2 * d) w)) ∧
      (∀ (r : ℕ)
        (θ_top : weilEtaleModuleH X.left (ℓ ^ r) (2 * d) →+
          weilEtaleTorsionH X.left (ℓ ^ r) (2 * d)),
        WeilIsModuleToTorsionComparison X.left (ℓ ^ r) (2 * d) θ_top →
        WeilHasLocalEffacement X.left d (ℓ ^ r) ((tr r).comp θ_top)) :=
by
  classical
  
  obtain ⟨Ψ, hΨ⟩ := weil_etale_pinned_compact_support_roof_transfer k ℓ hℓ
  obtain ⟨ι_aff, tr_Pd, hModel⟩ :=
    weil_etale_polyP1_pinned_kummer_model_trace k ℓ hℓ ζ hPrim hPow Ψ hΨ
  obtain ⟨hChartIndep, tr, hTrCompat, hTrChart⟩ :=
    weil_etale_pinned_steinitz_chart_invariance_and_gluing k X hInt d ℓ hℓ Ψ hΨ ι_aff tr_Pd hModel
  refine ⟨tr, hTrCompat, ?_⟩
  intro r θ_top hθ_top
  apply weil_etale_local_module_to_torsion_effacement_bridge X.left d (ℓ ^ r) (tr r) θ_top hθ_top
  let FgtX := AlgebraicGeometry.Scheme.Etale.forget X.left
  let Pd := weilPolyP1Over k d
  let FgtPd := AlgebraicGeometry.Scheme.Etale.forget Pd.left
  intro x κ Ω gx U γ hγ

  
  let U_sch : AlgebraicGeometry.Scheme.{u} := (FgtX.obj U).left
  let p_U : U_sch ⟶ X.left := (FgtX.obj U).hom
  have hEt_pU : AlgebraicGeometry.Etale p_U := U.prop
  have hNonempty_Ω : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := Ω)).mpr inferInstance
  let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := Classical.choice hNonempty_Ω
  have hSub_Ω : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    change Subsingleton (PrimeSpectrum Ω)
    infer_instance
  let x_U : ↥U_sch := γ.base pt_Ω
  let f_U : U_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := p_U ≫ X.hom
  have hSm_fU : AlgebraicGeometry.SmoothOfRelativeDimension d f_U := by
    have h0d : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d) (p_U ≫ X.hom) := inferInstance
    simpa [f_U] using h0d
  obtain ⟨U_k, hAff_Uk, V, hAff_V, hx_V, he, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff d f_U).mp hSm_fU x_U
  have hUk_top : U_k = ⊤ := by
    ext y
    have hSub_k : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      change Subsingleton (PrimeSpectrum k)
      infer_instance
    exact iff_of_true (by rw [hSub_k.elim y (f_U.base x_U)]; exact he hx_V) trivial
  subst hUk_top
  obtain ⟨ψ_U, hψ_comp, hψ_et⟩ := hStd.exists_etale_mvPolynomial
  let A_k := (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)
  let R₀ := U_sch.presheaf.obj (Opposite.op V)
  let W₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec R₀
  let ι₀ : W₀ ⟶ U_sch := hAff_V.fromSpec
  have hfrom_eq : hAff_Uk.fromSpec = (AlgebraicGeometry.Spec (CommRingCat.of k)).isoSpec.inv :=
    AlgebraicGeometry.IsAffineOpen.fromSpec_top
  have hIso_from : CategoryTheory.IsIso hAff_Uk.fromSpec := by
    rw [hfrom_eq]
    infer_instance
  let φ_k : CommRingCat.of k ⟶ A_k := AlgebraicGeometry.Spec.preimage hAff_Uk.fromSpec
  let φ_k_inv : A_k ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (CategoryTheory.inv hAff_Uk.fromSpec)
  have hφ1 : φ_k ≫ φ_k_inv = 𝟙 _ := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
      AlgebraicGeometry.Spec.map_id]
  have hφ2 : φ_k_inv ≫ φ_k = 𝟙 _ := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.hom_inv_id,
      AlgebraicGeometry.Spec.map_id]
  let e_mv : CommRingCat.of (MvPolynomial (Fin d) k) ⟶
      CommRingCat.of (MvPolynomial (Fin d) ↑A_k) :=
    CommRingCat.ofHom (MvPolynomial.map φ_k.hom)
  let e_mv_inv : CommRingCat.of (MvPolynomial (Fin d) ↑A_k) ⟶
      CommRingCat.of (MvPolynomial (Fin d) k) :=
    CommRingCat.ofHom (MvPolynomial.map φ_k_inv.hom)
  have he_mv1 : e_mv ≫ e_mv_inv = 𝟙 _ := by
    ext1
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [e_mv, e_mv_inv, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply, MvPolynomial.map_C, CommRingCat.hom_id, RingHom.id_apply]
      exact congrArg MvPolynomial.C
        (congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφ1)
    · intro i
      simp [e_mv, e_mv_inv]
  have he_mv2 : e_mv_inv ≫ e_mv = 𝟙 _ := by
    ext1
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [e_mv, e_mv_inv, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply, MvPolynomial.map_C, CommRingCat.hom_id, RingHom.id_apply]
      exact congrArg MvPolynomial.C (congrArg (fun g : A_k ⟶ A_k => g.hom c) hφ2)
    · intro i
      simp [e_mv, e_mv_inv]
  have hAff_W₀ : AlgebraicGeometry.IsAffine W₀ := by
    dsimp [W₀]
    infer_instance
  have hIso_emv : CategoryTheory.IsIso e_mv := ⟨⟨e_mv_inv, he_mv1, he_mv2⟩⟩
  have hIso_Spec_emv : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map e_mv) := inferInstance
  let u_mid : W₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d) ↑A_k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_U)
  have hEt_umid : AlgebraicGeometry.Etale u_mid :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_et
  let u₀ : W₀ ⟶ (weilAffineSpaceOver k d).left := u_mid ≫ AlgebraicGeometry.Spec.map e_mv
  have hEt_u₀ : AlgebraicGeometry.Etale u₀ := by
    dsimp [W₀, u₀, weilAffineSpaceOver]
    infer_instance
  have hu₀_X : u₀ ≫ (weilAffineSpaceOver k d).hom = ι₀ ≫ f_U := by
    change (u_mid ≫ AlgebraicGeometry.Spec.map e_mv) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = hAff_V.fromSpec ≫ f_U
    dsimp [u_mid]
    rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp]
    have hcomm_ring : (CommRingCat.ofHom MvPolynomial.C ≫ e_mv) ≫ CommRingCat.ofHom ψ_U =
        φ_k ≫ AlgebraicGeometry.Scheme.Hom.appLE f_U ⊤ V he := by
      ext c
      change ψ_U ((MvPolynomial.map φ_k.hom) (MvPolynomial.C c)) =
        (AlgebraicGeometry.Scheme.Hom.appLE f_U ⊤ V he).hom (φ_k.hom c)
      rw [MvPolynomial.map_C]
      exact DFunLike.congr_fun hψ_comp (φ_k.hom c)
    rw [hcomm_ring, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
    exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_U hAff_Uk hAff_V he
  have hx_U_mem : x_U ∈ Set.range ⇑ι₀ := by
    change x_U ∈ Set.range hAff_V.fromSpec.base
    rw [hAff_V.range_fromSpec]
    exact hx_V
  have hrange_γ : Set.range ⇑γ ⊆ Set.range ⇑ι₀ := by
    rintro _ ⟨pt', rfl⟩
    rw [hSub_Ω.elim pt' pt_Ω]
    exact hx_U_mem
  let γ₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀ :=
    AlgebraicGeometry.IsOpenImmersion.lift ι₀ γ hrange_γ
  have hγ₀_fac : γ₀ ≫ ι₀ = γ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac ι₀ γ hrange_γ
  let x_W₀ : ↥W₀ := γ₀.base pt_Ω

  
  let p_W₀_pt : PrimeSpectrum ↑R₀ := x_W₀
  obtain ⟨m₀, hm₀_max, hm₀_le⟩ :=
    Ideal.exists_le_maximal p_W₀_pt.asIdeal p_W₀_pt.isPrime.ne_top
  let x₀ : ↥W₀ := (⟨m₀, hm₀_max.isPrime⟩ : PrimeSpectrum ↑R₀)
  have hx₀_closed : IsClosed ({x₀} : Set ↥W₀) := by
    change IsClosed ({(⟨m₀, hm₀_max.isPrime⟩ : PrimeSpectrum ↑R₀)} : Set (PrimeSpectrum ↑R₀))
    rw [← PrimeSpectrum.zeroLocus_eq_singleton m₀]
    exact PrimeSpectrum.isClosed_zeroLocus _
  have hx₀_cl : x₀ ∈ closure ({x_W₀} : Set ↥W₀) :=
    (PrimeSpectrum.le_iff_mem_closure p_W₀_pt ⟨m₀, hm₀_max.isPrime⟩).mp hm₀_le

  
  obtain ⟨hProp_Pd, hOpen_ιaff, hιaff_hom⟩ := hModel.1 d
  have hEt_ι₀ : AlgebraicGeometry.Etale ι₀ := inferInstance
  have hEt_U₀X : AlgebraicGeometry.Etale (ι₀ ≫ p_U) := inferInstance
  let U₀_X : X.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (ι₀ ≫ p_U) hEt_U₀X
  let j₀ : U₀_X ⟶ U := CategoryTheory.MorphismProperty.Over.homMk ι₀ rfl trivial
  have hEt_ιaff : AlgebraicGeometry.Etale (ι_aff d) := inferInstance
  have hEt_U₀Pd : AlgebraicGeometry.Etale (u₀ ≫ ι_aff d) := inferInstance
  let U₀_Pd : Pd.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (u₀ ≫ ι_aff d) hEt_U₀Pd
  obtain ⟨U'_Pd, v_Pd, x'₀, hAff', hx'₀, hEff_Pd, hBij_Pd⟩ :=
    weil_etale_polyP1_pinned_closed_point_local_effacement k ℓ hℓ Ψ hΨ ι_aff tr_Pd hModel
      hChartIndep d r U₀_Pd u₀ x₀ hx₀_closed hAff_W₀ hEt_u₀ rfl

  
  let W' : AlgebraicGeometry.Scheme.{u} := (FgtPd.obj U'_Pd).left
  let v_sch : W' ⟶ W₀ := (FgtPd.map v_Pd).left
  have hv_Pd_w : v_sch ≫ (FgtPd.obj U₀_Pd).hom = (FgtPd.obj U'_Pd).hom :=
    CategoryTheory.MorphismProperty.Over.w v_Pd
  have hEt_comp_Pd : AlgebraicGeometry.Etale (v_sch ≫ (FgtPd.obj U₀_Pd).hom) := by
    rw [hv_Pd_w]
    exact U'_Pd.prop
  have hEt_vsch : AlgebraicGeometry.Etale v_sch :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      v_sch (FgtPd.obj U₀_Pd).hom U₀_Pd.prop hEt_comp_Pd
  have hEt_U'X : AlgebraicGeometry.Etale (v_sch ≫ ι₀ ≫ p_U) := inferInstance
  let U' : X.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (v_sch ≫ ι₀ ≫ p_U) hEt_U'X
  let v₀_X : U' ⟶ U₀_X := CategoryTheory.MorphismProperty.Over.homMk v_sch rfl trivial
  let v : U' ⟶ U := v₀_X ≫ j₀

  have hOpen_range : IsOpen (Set.range ⇑v_sch.base) := v_sch.isOpenMap.isOpen_range
  have hx₀_in_range : x₀ ∈ Set.range ⇑v_sch.base := ⟨x'₀, hx'₀⟩
  obtain ⟨_, hmem_range, hmem_sing⟩ :=
    mem_closure_iff.mp hx₀_cl (Set.range ⇑v_sch.base) hOpen_range hx₀_in_range
  rw [Set.mem_singleton_iff] at hmem_sing
  have hxW₀_in_range : x_W₀ ∈ Set.range ⇑v_sch.base := hmem_sing ▸ hmem_range
  obtain ⟨y', hy'⟩ := hxW₀_in_range
  obtain ⟨z_P, _, _⟩ :=
    AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := v_sch) (g := γ₀) y' pt_Ω hy'
  let P := CategoryTheory.Limits.pullback v_sch γ₀
  let p₁ : P ⟶ W' := CategoryTheory.Limits.pullback.fst v_sch γ₀
  let p₂ : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    CategoryTheory.Limits.pullback.snd v_sch γ₀
  have hNonempty_P : Nonempty ↥P := ⟨z_P⟩
  let e_P := P.isoSpec
  let B_cat := P.presheaf.obj (Opposite.op ⊤)
  let φ_Ω : CommRingCat.of Ω ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_P.inv ≫ p₂)
  have hmap_φ : AlgebraicGeometry.Spec.map φ_Ω = e_P.inv ≫ p₂ :=
    AlgebraicGeometry.Spec.map_preimage (e_P.inv ≫ p₂)
  have hFT_hom : RingHom.FiniteType φ_Ω.hom := by
    rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType),
      hmap_φ]
    infer_instance
  let _ : Algebra Ω ↑B_cat := φ_Ω.hom.toAlgebra
  have hFT_alg : Algebra.FiniteType Ω ↑B_cat := hFT_hom
  have hNonemptySpec : Nonempty (PrimeSpectrum ↑B_cat) := ⟨e_P.hom.base z_P⟩
  have hNontriv_B : Nontrivial ↑B_cat :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := ↑B_cat)).mp hNonemptySpec
  obtain ⟨m_B, hm_B⟩ := Ideal.exists_maximal (↑B_cat)
  obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
  let q_hom : MvPolynomial (Fin n_mv) Ω →+* ↑B_cat := q_mv.toRingHom
  have hq_hom_surj : Function.Surjective q_hom := hq_surj
  let m_mv : Ideal (MvPolynomial (Fin n_mv) Ω) := Ideal.comap q_hom m_B
  have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
  obtain ⟨a_pt, ha_pt⟩ :=
    (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
  let ev_hom : MvPolynomial (Fin n_mv) Ω →+* Ω := (MvPolynomial.aeval a_pt).toRingHom
  have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
    intro f_p hf_p
    rw [RingHom.mem_ker] at hf_p
    have hmem : f_p ∈ m_mv := by
      change q_hom f_p ∈ m_B
      rw [hf_p]
      exact m_B.zero_mem
    rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    exact hmem
  let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
  let σ_B : ↑B_cat →+* Ω :=
    (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
  have hσ_comp : φ_Ω ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of Ω) := by
    ext c
    change σ_B (algebraMap Ω (↑B_cat) c) = c
    have hq_C : q_hom (MvPolynomial.C c) = algebraMap Ω (↑B_cat) c := q_mv.commutes c
    rw [← hq_C]
    dsimp [σ_B]
    have heq_q : e_quot.symm (q_hom (MvPolynomial.C c)) =
        Ideal.Quotient.mk (RingHom.ker q_hom) (MvPolynomial.C c) := by
      apply e_quot.injective
      simp [e_quot]
    rw [heq_q, Ideal.Quotient.lift_mk]
    exact (MvPolynomial.aeval a_pt).commutes c
  let s_P : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_P.inv
  have hs_P : s_P ≫ p₂ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    dsimp [s_P]
    rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp, hσ_comp,
      AlgebraicGeometry.Spec.map_id]
  let γ' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W' := s_P ≫ p₁
  have hγ'_vsch : γ' ≫ v_sch = γ₀ := by
    dsimp [γ', p₁]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc, hs_P, CategoryTheory.Category.id_comp]
  have hγ'_v : γ' ≫ (FgtX.map v).left = γ := by
    change γ' ≫ (v_sch ≫ ι₀) = γ
    rw [← CategoryTheory.Category.assoc, hγ'_vsch, hγ₀_fac]
  have hγ'_hom : γ' ≫ (FgtX.obj U').hom = gx := by
    change γ' ≫ (v_sch ≫ ι₀ ≫ p_U) = gx
    rw [← CategoryTheory.Category.assoc, hγ'_vsch, ← CategoryTheory.Category.assoc, hγ₀_fac, hγ]

  
  let e₀ : CategoryTheory.Iso (FgtX.obj U₀_X).left (FgtPd.obj U₀_Pd).left :=
    CategoryTheory.Iso.refl W₀
  have hRoof₀_comm :
      CategoryTheory.CategoryStruct.comp e₀.hom
        (CategoryTheory.CategoryStruct.comp (FgtPd.obj U₀_Pd).hom Pd.hom) =
      CategoryTheory.CategoryStruct.comp (FgtX.obj U₀_X).hom X.hom := by
    change 𝟙 W₀ ≫ ((u₀ ≫ ι_aff d) ≫ Pd.hom) = (ι₀ ≫ p_U) ≫ X.hom
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hιaff_hom, hu₀_X,
      CategoryTheory.Category.assoc]
  have hRoof₀ : WeilIsAffineRoofIso k X Pd U₀_X U₀_Pd e₀ :=
    ⟨inferInstance, hProp_Pd, hAff_W₀, hRoof₀_comm⟩
  let e' : CategoryTheory.Iso (FgtX.obj U').left (FgtPd.obj U'_Pd).left :=
    CategoryTheory.Iso.refl W'
  have hRoof'_comm :
      CategoryTheory.CategoryStruct.comp e'.hom
        (CategoryTheory.CategoryStruct.comp (FgtPd.obj U'_Pd).hom Pd.hom) =
      CategoryTheory.CategoryStruct.comp (FgtX.obj U').hom X.hom := by
    have hv_hom : (FgtPd.obj U'_Pd).hom = v_sch ≫ u₀ ≫ ι_aff d := hv_Pd_w.symm
    change 𝟙 W' ≫ ((FgtPd.obj U'_Pd).hom ≫ Pd.hom) = (v_sch ≫ ι₀ ≫ p_U) ≫ X.hom
    calc
      𝟙 W' ≫ ((FgtPd.obj U'_Pd).hom ≫ Pd.hom)
        = (v_sch ≫ u₀ ≫ ι_aff d) ≫ Pd.hom := by
            rw [CategoryTheory.Category.id_comp, hv_hom]
      _ = v_sch ≫ u₀ ≫ (ι_aff d ≫ Pd.hom) := by simp only [CategoryTheory.Category.assoc]
      _ = v_sch ≫ (u₀ ≫ (weilAffineSpaceOver k d).hom) := by
            rw [hιaff_hom]
      _ = (v_sch ≫ ι₀ ≫ p_U) ≫ X.hom := by
            rw [hu₀_X]
            simp only [f_U, CategoryTheory.Category.assoc]
  have hRoof' : WeilIsAffineRoofIso k X Pd U' U'_Pd e' :=
    ⟨inferInstance, hProp_Pd, hAff', hRoof'_comm⟩

  have hLocMap_comp :
      ∀ {V₁ V₂ V₃ : X.left.Etale} (u₁ : V₁ ⟶ V₂) (u₂ : V₂ ⟶ V₃),
        weilEtaleLocalTorsionMap X.left (ℓ ^ r) (u₁ ≫ u₂) =
          weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₁ ≫
            weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂ := by
    intro V₁ V₂ V₃ u₁ u₂
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r)))
    have hEquiv_comp :
        ∀ {W_et : X.left.Etale}
          {F G : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}}
          (α : CategoryTheory.Sheaf.freeYoneda X.left.smallEtaleTopology W_et AM ⟶ F)
          (g : F ⟶ G),
          CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
      intro W_et F G α g
      let α' : (CategoryTheory.presheafToSheaf X.left.smallEtaleTopology AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction X.left.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              (((CategoryTheory.sheafificationAdjunction X.left.smallEtaleTopology
                AddCommGrpCat.{u}).homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf X.left.smallEtaleTopology
                  AddCommGrpCat.{u}).map g) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv
          (weilEtaleLocalTorsionMap X.left (ℓ ^ r) (u₁ ≫ u₂))
        = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃)) ≫
            (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op (u₁ ≫ u₂)) :=
            Equiv.apply_symm_apply _ _
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃)) ≫
            ((weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op u₂) ≫
              (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op u₁)) := by
            have hop : Opposite.op (u₁ ≫ u₂) =
                (Opposite.op u₂ ≫ Opposite.op u₁ : Opposite.op V₃ ⟶ Opposite.op V₁) := rfl
            rw [hop, CategoryTheory.Functor.map_comp]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃)) ≫
            (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op u₂)) ≫
            (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op u₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂)) ≫
            (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂).hom.app (Opposite.op V₂)) ≫
            (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op u₁) := by
            have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂)) ≫
                (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂).hom.app (Opposite.op V₂) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃)) ≫
                (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op u₂) := by
              rw [← hEquiv_comp (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂))
                (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂), CategoryTheory.Category.id_comp]
              exact Equiv.apply_symm_apply _ _
            rw [h2]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂)) ≫
            ((weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂).hom.app (Opposite.op V₂) ≫
              (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₃).obj.map (Opposite.op u₁)) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂)) ≫
            ((weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂).obj.map (Opposite.op u₁) ≫
              (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂).hom.app (Opposite.op V₁)) := by
            rw [← (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂).hom.naturality (Opposite.op u₁)]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂)) ≫
            (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂).obj.map (Opposite.op u₁)) ≫
            (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂).hom.app (Opposite.op V₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₁) ≫
            (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂).hom.app (Opposite.op V₁) := by
            have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₁) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂)) ≫
                (weilEtaleLocalTorsionSheaf X.left (ℓ ^ r) V₂).obj.map (Opposite.op u₁) :=
              Equiv.apply_symm_apply _ _
            rw [h1]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₁ ≫
              weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂) :=
            (hEquiv_comp (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₁)
              (weilEtaleLocalTorsionMap X.left (ℓ ^ r) u₂)).symm

  refine ⟨U', v, γ', hγ'_hom, hγ'_v, ?_, ?_⟩
  · intro q hq z
    have hFactor : weilEtaleLocalTorsionMapH X.left (ℓ ^ r) v q z =
        weilEtaleLocalTorsionMapH X.left (ℓ ^ r) j₀ q
          (weilEtaleLocalTorsionMapH X.left (ℓ ^ r) v₀_X q z) := by
      change z.comp (CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleLocalTorsionMap X.left (ℓ ^ r) (v₀_X ≫ j₀))) (Nat.add_zero q) =
        (z.comp (CategoryTheory.Abelian.Ext.mk₀
            (weilEtaleLocalTorsionMap X.left (ℓ ^ r) v₀_X)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀
            (weilEtaleLocalTorsionMap X.left (ℓ ^ r) j₀)) (Nat.add_zero q)
      rw [hLocMap_comp v₀_X j₀, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc]
      omega
    have hv_comm :
        CategoryTheory.CategoryStruct.comp e'.hom ((FgtPd.map v_Pd).left) =
          CategoryTheory.CategoryStruct.comp ((FgtX.map v₀_X).left) e₀.hom := by
      change 𝟙 W' ≫ v_sch = v_sch ≫ 𝟙 W₀
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have hΨ_cov :=
      hΨ.2.2.1 X Pd U' U₀_X U'_Pd U₀_Pd v₀_X v_Pd e' e₀ hRoof' hRoof₀ hv_comm r q z
    rw [hEff_Pd q hq _] at hΨ_cov
    have hv₀_zero : weilEtaleLocalTorsionMapH X.left (ℓ ^ r) v₀_X q z = 0 :=
      (Ψ X Pd U₀_X U₀_Pd e₀ hRoof₀ r q).injective
        (hΨ_cov.trans (map_zero (Ψ X Pd U₀_X U₀_Pd e₀ hRoof₀ r q)).symm)
    rw [hFactor, hv₀_zero, map_zero]
  · have hEt_vu₀ : AlgebraicGeometry.Etale (v_sch ≫ u₀) := inferInstance
    have hChart_comm :
        CategoryTheory.CategoryStruct.comp e'.hom (FgtPd.obj U'_Pd).hom =
          CategoryTheory.CategoryStruct.comp (v_sch ≫ u₀) (ι_aff d) := by
      change 𝟙 W' ≫ (FgtPd.obj U'_Pd).hom = (v_sch ≫ u₀) ≫ ι_aff d
      rw [CategoryTheory.Category.id_comp, ← hv_Pd_w]
      exact (CategoryTheory.Category.assoc v_sch u₀ (ι_aff d)).symm
    have hEq_fun :
        (fun z : weilEtaleLocalTorsionH X.left (ℓ ^ r) U' (2 * d) =>
          tr r (weilEtaleLocalTorsionCounitH X.left (ℓ ^ r) U' (2 * d) z)) =
        (fun w : weilEtaleLocalTorsionH Pd.left (ℓ ^ r) U'_Pd (2 * d) =>
          tr_Pd d r (weilEtaleLocalTorsionCounitH Pd.left (ℓ ^ r) U'_Pd (2 * d) w)) ∘
          (Ψ X Pd U' U'_Pd e' hRoof' r (2 * d)) := by
      funext z
      exact hTrChart U' U'_Pd (v_sch ≫ u₀) e' hRoof' hEt_vu₀ hChart_comm r z
    rw [hEq_fun]
    exact hBij_Pd.comp (Ψ X Pd U' U'_Pd e' hRoof' r (2 * d)).bijective

theorem weil_etale_colimit_preserving_dual_injective_sheaf (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (hm : 1 ≤ m)
    (hInjR : Module.Injective (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) :
    WeilHasVerdierDualSheafRep S m :=
by
  let _ := hm
  intro C hFinLim hColim
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let R_M : ModuleCat.{u, u} R := ModuleCat.of R R
  have aux : ∀ (𝒞₀ : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} 𝒞₀]
      [CategoryTheory.Abelian 𝒞₀] [CategoryTheory.IsGrothendieckAbelian.{u} 𝒞₀]
      (F : CategoryTheory.Functor 𝒞₀ (ModuleCat.{u, u} R))
      [CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} F], F.IsLeftAdjoint :=
    fun 𝒞₀ _ _ _ F _ =>
      let _ : CategoryTheory.Limits.HasColimitsOfSize.{u, u} 𝒞₀ :=
        CategoryTheory.Limits.hasColimitsOfSizeShrink 𝒞₀
      let _ : CategoryTheory.HasSeparator 𝒞₀ :=
        CategoryTheory.IsGrothendieckAbelian.hasSeparator (C := 𝒞₀)
      CategoryTheory.isLeftAdjoint_of_preservesColimits_of_isSeparating.{u}
        (CategoryTheory.isSeparator_separator 𝒞₀) F
  have auxAdd : ∀ (𝒞₀ : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} 𝒞₀]
      [CategoryTheory.Abelian 𝒞₀]
      (F : CategoryTheory.Functor 𝒞₀ (ModuleCat.{u, u} R))
      [CategoryTheory.Limits.PreservesFiniteLimits F], F.Additive :=
    fun _ _ _ F _ => CategoryTheory.Functor.additive_of_preserves_binary_products F
  have : CategoryTheory.Limits.PreservesFiniteLimits C := hFinLim
  have : CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} C := hColim
  have : Module.Injective R R := hInjR
  have : C.IsLeftAdjoint := aux 𝒞 C
  have : C.Additive := auxAdd 𝒞 C
  let G := C.rightAdjoint
  let adj : CategoryTheory.Adjunction C G := CategoryTheory.Adjunction.ofIsLeftAdjoint C
  let 𝒥 : 𝒞 := G.obj R_M
  have hInj_RM : CategoryTheory.Injective R_M :=
    Module.injective_object_of_injective_module R R
  have hInj_J : CategoryTheory.Injective 𝒥 :=
    adj.map_injective R_M hInj_RM
  let eMod : ∀ M : ModuleCat.{u, u} R, (↑M →ₗ[R] R) ≃ Quiver.Hom M R_M :=
    fun M =>
      { toFun := fun ψ => ModuleCat.ofHom ψ
        invFun := fun φ => φ.hom
        left_inv := fun _ => rfl
        right_inv := fun φ => ModuleCat.ofHom_hom φ }
  let Ψ : ∀ F : 𝒞, (↑(C.obj F) →ₗ[R] R) ≃ Quiver.Hom F 𝒥 :=
    fun F => (eMod (C.obj F)).trans (adj.homEquiv F R_M)
  refine ⟨𝒥, Ψ, hInj_J, ?_, ?_⟩
  · intro F ψ₁ ψ₂
    change (adj.homEquiv F R_M) (ModuleCat.ofHom (ψ₁ + ψ₂)) =
      (adj.homEquiv F R_M) (ModuleCat.ofHom ψ₁) + (adj.homEquiv F R_M) (ModuleCat.ofHom ψ₂)
    rw [ModuleCat.ofHom_add]
    exact CategoryTheory.Adjunction.homAddEquiv_add adj F R_M
      (ModuleCat.ofHom ψ₁) (ModuleCat.ofHom ψ₂)
  · intro F₁ F₂ f ψ
    exact (CategoryTheory.Adjunction.homEquiv_naturality_left adj f (ModuleCat.ofHom ψ)).symm

theorem weil_etale_verdier_dual_injective_resolution_of_effacement (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ) (hm : 1 ≤ m)
    (τ : weilEtaleModuleH S m (2 * d) →+ ZMod m)
    (hGod : WeilHasTruncatedGodementComplex S d m)
    (hEff : WeilHasLocalEffacement S d m τ)
    (hInjR : Module.Injective (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m)))
    (hGeomLift : ∀ (U : S.Etale) (y : ↥(((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left)),
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
      let x : ↥S := ((Fgt.obj U).hom).base y
      let κ := S.residueField x
      let Ω := AlgebraicClosure ↥κ
      let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
          (S.fromSpecResidueField x)
      ∃ (γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U).left)
        (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        CategoryTheory.CategoryStruct.comp γ (Fgt.obj U).hom = gx ∧
        γ.base pt = y)
    (hLocConst : ∀ (U : S.Etale)
      (s : ↑((weilEtaleModuleUnit S m).obj.obj (Opposite.op U)))
      (y : ↥(((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left)),
      let R := ULift.{u, 0} (ZMod m)
      let J := S.smallEtaleTopology
      let oneR := weilEtaleModuleUnit S m
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
      ∃ (U₀ : S.Etale) (u₀ : Quiver.Hom U₀ U) (y₀ : ↥((Fgt.obj U₀).left)) (c : ZMod m),
        ((Fgt.map u₀).left).base y₀ = y ∧
        (oneR.obj.map (Opposite.op u₀)).hom s =
          (((CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).unit.app
            ((CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R))).app
            (Opposite.op U₀)).hom (ULift.up c))
    (hDualRep : WeilHasVerdierDualSheafRep S m) :
    WeilHasVerdierDualExtPackage S d m τ :=
by
  classical
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR := weilEtaleModuleUnit S m
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  
  have hval_cast : ∀ c : ZMod m, (c.val : ZMod m) = c := by
    intro c
    by_cases hm1 : m = 1
    · subst hm1
      exact Subsingleton.elim _ _
    · have _ : NeZero m := ⟨by omega⟩
      exact ZMod.natCast_zmod_val c
  have hnsmul_one_smul : ∀ {M : Type u} [AddCommGroup M] [Module R M] (k : ℕ) (x : M),
      (k • (1 : R)) • x = k • x := by
    intro M _ _ k x
    induction k with
    | zero => rw [zero_nsmul, zero_smul, zero_nsmul]
    | succ k ih => rw [succ_nsmul, add_smul, ih, one_smul, succ_nsmul]
  have hr_eq_nsmul : ∀ r : R, r = r.down.val • (1 : R) := by
    intro r
    apply ULift.ext
    change r.down = r.down.val • (1 : ZMod m)
    rw [nsmul_eq_mul, mul_one, hval_cast]
  let addHomToLinear : ∀ {M : Type u} [AddCommGroup M] [Module R M],
      (M →+ ZMod m) → (M →ₗ[R] R) :=
    fun {M} _ _ φ₀ =>
      { toFun := fun x => ULift.up (φ₀ x)
        map_add' := fun x y => ULift.ext _ _ (φ₀.map_add x y)
        map_smul' := fun r x => by
          apply ULift.ext
          change φ₀ (r • x) = r.down * φ₀ x
          conv_lhs => rw [hr_eq_nsmul r, hnsmul_one_smul]
          rw [map_nsmul, nsmul_eq_mul, hval_cast] }
  have hExtend : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R M₁]
      [AddCommGroup M₂] [Module R M₂]
      (f_d : M₁ →ₗ[R] M₂) (lam : M₁ →ₗ[R] R),
      LinearMap.ker f_d ≤ LinearMap.ker lam →
      ∃ μ : M₂ →ₗ[R] R, μ.comp f_d = lam := by
    intro M₁ M₂ _ _ _ _ f_d lam hker_le
    let g₀ : LinearMap.range f_d →ₗ[R] R :=
      (Submodule.liftQ (LinearMap.ker f_d) lam hker_le).comp
        (LinearMap.quotKerEquivRange f_d).symm.toLinearMap
    obtain ⟨μ, hμ⟩ := hInjR.out (LinearMap.range f_d).subtype Subtype.val_injective g₀
    refine ⟨μ, ?_⟩
    apply LinearMap.ext
    intro x
    have hmem : f_d x ∈ LinearMap.range f_d := ⟨x, rfl⟩
    have h1 : μ (f_d x) = g₀ ⟨f_d x, hmem⟩ := hμ ⟨f_d x, hmem⟩
    have h2 : (LinearMap.quotKerEquivRange f_d) (Submodule.Quotient.mk x) = ⟨f_d x, hmem⟩ :=
      rfl
    have h3 : (LinearMap.quotKerEquivRange f_d).symm ⟨f_d x, hmem⟩ =
        Submodule.Quotient.mk x := by
      rw [← h2, LinearEquiv.symm_apply_apply]
    rw [LinearMap.comp_apply, h1]
    change Submodule.liftQ (LinearMap.ker f_d) lam hker_le
