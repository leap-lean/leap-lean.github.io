      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      have hρ_u : adj_Y.unit.app AM ≫ (ρ_a a).hom.app (Opposite.op T_Y) =
          adj_B.unit.app AM ≫
            F_B.obj.map (Opposite.op (hT_B.from ((weilEtaleSitePullback (τ a)).obj T_Y))) := by
        have h1 := (adj_Y.homEquiv AM (pf_a a)).apply_symm_apply
          (adj_B.unit.app AM ≫
            F_B.obj.map (Opposite.op (hT_B.from ((weilEtaleSitePullback (τ a)).obj T_Y))))
        rwa [CategoryTheory.Adjunction.homEquiv_unit] at h1
      have hPinY' : adj_Y.unit.app AM ≫ e_loc_Y.hom.hom.app (Opposite.op T_Y) =
