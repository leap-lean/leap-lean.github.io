        (((AlgebraicGeometry.Scheme.Etale.forget Y_V₂).obj W₂_diag).hom) w_YV := by
      have h_vert : CategoryTheory.IsPullback ((Fgt_Y.map w_tilde₁).left)
          (j_diag'₂ ≫ fst_V') (j_diag₂ ≫ fst_V₂) ((Fgt_V.map w₁).left) := by
        rw [hj'₂_fst, hj₂_fst]
        exact hPb_W'₂
      exact CategoryTheory.IsPullback.of_bot h_vert hComm_top hPb_bot
    let iso_sch := hPb_top.isoPullback
    let e_diag : ((weilEtaleSitePullback w_YV).obj W₂_diag) ≅ W'₂_diag :=
      { hom := CategoryTheory.MorphismProperty.Over.homMk iso_sch.inv
          hPb_top.isoPullback_inv_snd trivial
        inv := CategoryTheory.MorphismProperty.Over.homMk iso_sch.hom
          hPb_top.isoPullback_hom_snd trivial
        hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          iso_sch.inv_hom_id (Subsingleton.elim _ _)
        inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          iso_sch.hom_inv_id (Subsingleton.elim _ _) }
    refine ⟨e_diag, hPb_top.isoPullback_inv_fst, ?_⟩
    intro η₂ hFib_η₂ p_wYV hp_wYV η' s_z' hs_z' s_b' Y_b' snd_b' fst_b' ι_z'
    have hFib_gen :
        ∀ (s_z₀ : Quiver.Hom S_k (Fgt_V.obj V₂).left)
          (s_b₀ : Quiver.Hom S_k V_bar.left)
          (hs_eq : CategoryTheory.CategoryStruct.comp s_z₀ (Fgt_V.obj V₂).hom = s_b₀),
          CategoryTheory.CategoryStruct.comp s_b₀ V_bar.hom =
            CategoryTheory.CategoryStruct.id S_k →
          let Y_b₀ := CategoryTheory.Limits.pullback π_bar.left s_b₀
          let snd_b₀ := CategoryTheory.Limits.pullback.snd π_bar.left s_b₀
          let fst_b₀ := CategoryTheory.Limits.pullback.fst π_bar.left s_b₀
          let ι_z₀ : Quiver.Hom Y_b₀ Y_V₂ :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.CategoryStruct.comp snd_b₀ s_z₀)
              fst_b₀
              ((CategoryTheory.Category.assoc snd_b₀ s_z₀ (Fgt_V.obj V₂).hom).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp snd_b₀) hs_eq).trans
                  (CategoryTheory.Limits.pullback.condition (f := π_bar.left) (g := s_b₀)).symm))
          Finite (weilEtaleLocalTorsionH Y_b₀ ℓ ((weilEtaleSitePullback ι_z₀).obj W₂_diag) 2) ∧
          Nat.card (weilEtaleLocalTorsionH Y_b₀ ℓ ((weilEtaleSitePullback ι_z₀).obj W₂_diag) 2) = ℓ ∧
          (∀ p_z : weilEtaleLocalTorsionH Y_V₂ ℓ W₂_diag 2 →+
              weilEtaleLocalTorsionH Y_b₀ ℓ ((weilEtaleSitePullback ι_z₀).obj W₂_diag) 2,
            WeilIsLocalTorsionPullback ι_z₀
              ((weilEtaleSitePullback ι_z₀).obj W₂_diag) W₂_diag
              (CategoryTheory.CategoryStruct.id _) ℓ 2 p_z →
            p_z η₂ ≠ 0) := by
      rintro s_z₀ _ rfl hs_b₀
      apply hFib_η₂ s_z₀
      rw [← CategoryTheory.Category.assoc]
      exact hs_b₀
    let s_z : Quiver.Hom S_k (Fgt_V.obj V₂).left := s_z' ≫ (Fgt_V.map w₁).left
    have hs_b_eq : s_z ≫ (Fgt_V.obj V₂).hom = s_b' :=
      (CategoryTheory.Category.assoc s_z' (Fgt_V.map w₁).left (Fgt_V.obj V₂).hom).trans
        (congrArg (s_z' ≫ ·) hw₁_hom)
    have hs_b' : s_b' ≫ V_bar.hom = 𝟙 S_k :=
      (CategoryTheory.Category.assoc s_z' (Fgt_V.obj V').hom V_bar.hom).trans hs_z'
    let ι_z : Quiver.Hom Y_b' Y_V₂ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.CategoryStruct.comp snd_b' s_z)
        fst_b'
        ((CategoryTheory.Category.assoc snd_b' s_z (Fgt_V.obj V₂).hom).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp snd_b') hs_b_eq).trans
            (CategoryTheory.Limits.pullback.condition (f := π_bar.left) (g := s_b')).symm))
    obtain ⟨hFin₂, hCard₂, hNeZero₂⟩ := hFib_gen s_z s_b' hs_b_eq hs_b'
    have hι'_fst : ι_z' ≫ fst_V' = snd_b' ≫ s_z' :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι'_snd : ι_z' ≫ snd_V' = fst_b' :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hι_fst : ι_z ≫ fst_V₂ = snd_b' ≫ s_z :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι_snd : ι_z ≫ snd_V₂ = fst_b' :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have h_tri : ι_z' ≫ w_YV = ι_z := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (ι_z' ≫ w_YV) ≫ fst_V₂
            = ι_z' ≫ (w_YV ≫ fst_V₂) := CategoryTheory.Category.assoc _ _ _
          _ = ι_z' ≫ (fst_V' ≫ (Fgt_V.map w₁).left) := by rw [hw_YV_fst]
          _ = (ι_z' ≫ fst_V') ≫ (Fgt_V.map w₁).left := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (snd_b' ≫ s_z') ≫ (Fgt_V.map w₁).left := by rw [hι'_fst]
          _ = snd_b' ≫ s_z := CategoryTheory.Category.assoc _ _ _
          _ = ι_z ≫ fst_V₂ := hι_fst.symm
      · calc
          (ι_z' ≫ w_YV) ≫ snd_V₂
            = ι_z' ≫ (w_YV ≫ snd_V₂) := CategoryTheory.Category.assoc _ _ _
          _ = ι_z' ≫ snd_V' := by rw [hw_YV_snd]
          _ = fst_b' := hι'_snd
          _ = ι_z ≫ snd_V₂ := hι_snd.symm
    let e_B_z : weilEtaleSitePullback ι_z ≅
        CategoryTheory.Functor.comp (weilEtaleSitePullback w_YV) (weilEtaleSitePullback ι_z') :=
      (CategoryTheory.MorphismProperty.Over.pullbackCongr h_tri.symm).trans
        (CategoryTheory.MorphismProperty.Over.pullbackComp ι_z' w_YV)
    let ψ_z : ((weilEtaleSitePullback ι_z).obj W₂_diag) ≅
        ((weilEtaleSitePullback ι_z').obj W'₂_diag) :=
      (e_B_z.app W₂_diag).trans ((weilEtaleSitePullback ι_z').mapIso e_diag)
    let eqv_ψ :
        weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z).obj W₂_diag) 2 ≃+
          weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z').obj W'₂_diag) 2 :=
      AddEquiv.ofBijective (weilEtaleLocalTorsionMapH Y_b' ℓ ψ_z.hom 2) (hIsoMapH Y_b' ψ_z 2)
    have : Finite (weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z).obj W₂_diag) 2) :=
      hFin₂
    have hFin' : Finite (weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z').obj W'₂_diag) 2) :=
      Finite.of_equiv _ eqv_ψ.toEquiv
    have hCard' :
        Nat.card (weilEtaleLocalTorsionH Y_b' ℓ ((weilEtaleSitePullback ι_z').obj W'₂_diag) 2) = ℓ :=
      (Nat.card_congr eqv_ψ.symm.toEquiv).trans hCard₂
    refine ⟨hFin', hCard', ?_⟩
    intro p_z' hp_z' h_zero'
    let p_z := locPullCanon ι_z ((weilEtaleSitePullback ι_z).obj W₂_diag) W₂_diag (𝟙 _) 2
    have hp_z : WeilIsLocalTorsionPullback ι_z
        ((weilEtaleSitePullback ι_z).obj W₂_diag) W₂_diag (𝟙 _) ℓ 2 p_z :=
      (hLocPullExUniq ι_z ((weilEtaleSitePullback ι_z).obj W₂_diag) W₂_diag (𝟙 _) 2).1
    have hpz_ne : p_z η₂ ≠ 0 := hNeZero₂ p_z hp_z
    have h_eq_pz : p_z' η' = eqv_ψ (p_z η₂) := by
      apply hTriComp ι_z' w_YV ι_z h_tri
        ((weilEtaleSitePullback ι_z').obj W'₂_diag) W'₂_diag W₂_diag
        (𝟙 _) e_diag.hom ((weilEtaleSitePullback ι_z).obj W₂_diag) (𝟙 _) ψ_z.hom
        2 p_z' p_wYV p_z hp_z' hp_wYV hp_z _ η₂
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      rfl
    apply hpz_ne
    apply eqv_ψ.injective
    rw [← h_eq_pz, h_zero', map_zero]

theorem weil_etale_cohomologyPresheaf_slice_equiv_and_naturality (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (hFunc : WeilEtaleBasePullExtFunctorialityHolds.{u} (@hc_all) (@hr_all) hSite)
    (hCore : WeilFreeYonedaPullbackCoreHolds.{u} (@hc_all) (@hr_all))
    (hSliceIso : WeilEtaleSliceCohomologyIsoHolds.{u} (@hc_all) (@hr_all) hSite)
    (hConst : WeilSliceColimConstAndTerminalHolds.{u} (@hc_all) (@hr_all) hSite) :
    ∃ (Θ : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale)
        (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        ↥((F.cohomologyPresheaf q).obj (Opposite.op U)) ≃+
          (((@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).hom)
            AddCommGrpCat.{u} _ Z.smallEtaleTopology
            ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).left.smallEtaleTopology
            (@hc_all _ _ _) (@hr_all _ _ _)).obj F).H q)),
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale)
          {F₁ F₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom F₁ F₂) (q : ℕ)
          (ξ : ↥((F₁.cohomologyPresheaf q).obj (Opposite.op U))),
        let U_sch := ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).left
        let g_U := ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).hom
        let pb_U := @CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback g_U) AddCommGrpCat.{u} _
          Z.smallEtaleTopology U_sch.smallEtaleTopology
          (@hc_all _ _ _) (@hr_all _ _ _)
        let Fℤ_U := (CategoryTheory.constantSheaf U_sch.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        Θ Z U F₂ q
          ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology q).map φ).app
            (Opposite.op U)).hom ξ) =
        (CategoryTheory.Abelian.Ext.mk₀.{u} (pb_U.map φ)).postcomp Fℤ_U (Nat.add_zero q)
          (Θ Z U F₁ q ξ)) ∧
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) {U' U : Z.Etale} (w : Quiver.Hom U' U)
          (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
          (ξ : ↥((F.cohomologyPresheaf q).obj (Opposite.op U))),
        let h := ((AlgebraicGeometry.Scheme.Etale.forget Z).map w).left
        let hw : CategoryTheory.CategoryStruct.comp h
            ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).hom =
          ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U').hom :=
          CategoryTheory.MorphismProperty.Over.w w
        Θ Z U' F q (((F.cohomologyPresheaf q).map (Opposite.op w)).hom ξ) =
          weilSliceColimTrianglePullHom.{u} (@hc_all) (@hr_all) hSite
            ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U').hom
            ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).hom
            h hw F q (Θ Z U F q ξ)) :=
by
  classical
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all

  
  have h_site_bridge :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        (J : CategoryTheory.GrothendieckTopology C)
        [CategoryTheory.HasSheafify J AddCommGrpCat.{u}],
        let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
        let Z_of : C → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
          fun U => CategoryTheory.Sheaf.freeYoneda J U Aℤ
        let zMap : ∀ {U' U : C}, (U' ⟶ U) → (Z_of U' ⟶ Z_of U) :=
          fun {_ U} w => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (Z_of U)))
              ((Z_of U).obj.map (Opposite.op w)))
        let P_rep : C → CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u} :=
          fun U => CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj U) AddCommGrpCat.free
        let R_of : C → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
          fun U => (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj (P_rep U)
        let rMap : ∀ {U' U : C}, (U' ⟶ U) → (R_of U' ⟶ R_of U) :=
          fun {_ _} w => (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map
            (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map w) AddCommGrpCat.free)
        ∃ (freeToRep : ∀ U : C, Z_of U ⟶ R_of U)
          (repToFree : ∀ U : C, R_of U ⟶ Z_of U),
          (∀ U : C,
            CategoryTheory.CategoryStruct.comp (freeToRep U) (repToFree U) =
              CategoryTheory.CategoryStruct.id (Z_of U) ∧
            CategoryTheory.CategoryStruct.comp (repToFree U) (freeToRep U) =
              CategoryTheory.CategoryStruct.id (R_of U)) ∧
          (∀ {U' U : C} (w : U' ⟶ U),
            CategoryTheory.CategoryStruct.comp (freeToRep U') (rMap w) =
              CategoryTheory.CategoryStruct.comp (zMap w) (freeToRep U)) := by
    intro C _ J _ Aℤ Z_of zMap P_rep R_of rMap
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let freeAdj :=
      (AddCommGrpCat.adj : AddCommGrpCat.free.{u} ⊣ CategoryTheory.forget AddCommGrpCat.{u}).whiskerRight
        (Opposite C)
    let repEquiv : ∀ (U : C) (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        (R_of U ⟶ G) ≃ ↥(G.obj.obj (Opposite.op U)) :=
      fun U G =>
        (shAdj.homEquiv (P_rep U) G).trans
          ((freeAdj.homEquiv (CategoryTheory.yoneda.obj U) G.obj).trans CategoryTheory.yonedaEquiv)
    have h_repEquiv_comp :
        ∀ {U : C} {G₁ G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (f : R_of U ⟶ G₁) (g : G₁ ⟶ G₂),
          repEquiv U G₂ (CategoryTheory.CategoryStruct.comp f g) =
            (g.hom.app (Opposite.op U)).hom (repEquiv U G₁ f) := by
      intro U G₁ G₂ f g
      dsimp only [repEquiv, Equiv.trans_apply]
      exact (congrArg
        (fun α => CategoryTheory.yonedaEquiv (freeAdj.homEquiv (CategoryTheory.yoneda.obj U) G₂.obj α))
        (shAdj.homEquiv_naturality_right f g)).trans
        ((congrArg CategoryTheory.yonedaEquiv
          (freeAdj.homEquiv_naturality_right (shAdj.homEquiv (P_rep U) G₁ f) g.hom)).trans
          (CategoryTheory.yonedaEquiv_comp _ _))
    have h_freeEquiv_comp :
        ∀ {U : C} {G₁ G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (f : Z_of U ⟶ G₁) (g : G₁ ⟶ G₂),
          CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.comp f g) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Sheaf.freeYonedaHomEquiv f)
              (g.hom.app (Opposite.op U)) := by
      intro U G₁ G₂ f g
      exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
        (shAdj.homEquiv_naturality_right f g)).trans
        (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ g.hom)
    have h_Aℤ_ext :
        ∀ {M : AddCommGrpCat.{u}} {f₁ f₂ : Aℤ ⟶ M},
          f₁.hom (ULift.up (1 : ℤ)) = f₂.hom (ULift.up (1 : ℤ)) → f₁ = f₂ := by
      intro M f₁ f₂ h1
      apply AddCommGrpCat.ext
      rintro ⟨n⟩
      have hn : (ULift.up n : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) := by
        ext; simp
      rw [hn, map_zsmul, map_zsmul, h1]
    let u_rep : ∀ U : C, ↥((R_of U).obj.obj (Opposite.op U)) :=
      fun U => repEquiv U (R_of U) (CategoryTheory.CategoryStruct.id (R_of U))
    let u_free : ∀ U : C, ↥((Z_of U).obj.obj (Opposite.op U)) :=
      fun U => (CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.CategoryStruct.id (Z_of U))).hom (ULift.up (1 : ℤ))
    let f2r : ∀ U : C, Z_of U ⟶ R_of U :=
      fun U => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (AddCommGrpCat.ofHom
          { toFun := fun n => n.down • u_rep U
            map_zero' := zero_zsmul (u_rep U)
            map_add' := fun a b => add_zsmul (u_rep U) a.down b.down })
    let r2f : ∀ U : C, R_of U ⟶ Z_of U :=
      fun U => (repEquiv U (Z_of U)).symm (u_free U)
    have h_f2r_eval : ∀ U : C,
        ((f2r U).hom.app (Opposite.op U)).hom (u_free U) = u_rep U := by
      intro U
      have h1 := congrArg (fun φ : Aℤ ⟶ (R_of U).obj.obj (Opposite.op U) => φ.hom (ULift.up (1 : ℤ)))
        ((h_freeEquiv_comp (CategoryTheory.CategoryStruct.id (Z_of U)) (f2r U)).symm.trans
          ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.Category.id_comp (f2r U))).trans
            (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _)))
      exact h1.trans (one_zsmul (u_rep U))
    have h_r2f_eval : ∀ U : C,
        ((r2f U).hom.app (Opposite.op U)).hom (u_rep U) = u_free U := by
      intro U
      exact (h_repEquiv_comp (CategoryTheory.CategoryStruct.id (R_of U)) (r2f U)).symm.trans
        ((congrArg (repEquiv U (Z_of U)) (CategoryTheory.Category.id_comp (r2f U))).trans
          ((repEquiv U (Z_of U)).apply_symm_apply (u_free U)))
    refine ⟨f2r, r2f, ?_, ?_⟩
    · intro U
      refine ⟨?_, ?_⟩
      · apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        apply h_Aℤ_ext
        have hL := congrArg (fun φ : Aℤ ⟶ (Z_of U).obj.obj (Opposite.op U) => φ.hom (ULift.up (1 : ℤ)))
          ((h_freeEquiv_comp (f2r U) (r2f U)).trans
            (congrArg (fun m => CategoryTheory.CategoryStruct.comp m _)
              (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _)))
        exact hL.trans ((congrArg ((r2f U).hom.app (Opposite.op U)).hom (one_zsmul (u_rep U))).trans
          (h_r2f_eval U))
      · apply (repEquiv U (R_of U)).injective
        exact (h_repEquiv_comp (r2f U) (f2r U)).trans
          ((congrArg ((f2r U).hom.app (Opposite.op U)).hom
            ((repEquiv U (Z_of U)).apply_symm_apply (u_free U))).trans
            (h_f2r_eval U))
    · intro U' U w
      let w_free : P_rep U' ⟶ P_rep U :=
        CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map w) AddCommGrpCat.free
      have h_rep_rMap : repEquiv U' (R_of U) (rMap w) =
          ((R_of U).obj.map (Opposite.op w)).hom (u_rep U) := by
        dsimp only [repEquiv, Equiv.trans_apply]
        have hs : shAdj.homEquiv (P_rep U') (R_of U) (rMap w) =
