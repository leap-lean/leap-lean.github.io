      {M : AddCommGrpCat.{u}}
      {F G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda Z.smallEtaleTopology U M ⟶ F) (φ : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ φ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ φ.hom.app (Opposite.op U) := by
    intro Z U M F G α φ
    unfold CategoryTheory.Sheaf.freeYoneda at α ⊢
    unfold CategoryTheory.Sheaf.freeYonedaHomEquiv
    dsimp only [Equiv.trans_apply]
    rw [(CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv_naturality_right]
    exact CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ φ.hom

