        ℓ • CategoryTheory.CategoryStruct.id K = 0 ∧
        m' • CategoryTheory.CategoryStruct.id M = 0) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro A₀ A₁ A₂ A₃ A₄ B₀ B₁ B₂ B₃ B₄
