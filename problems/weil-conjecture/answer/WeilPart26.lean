        exact AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
      exact hLHS.trans hRHS.symm

    let FgtB := AlgebraicGeometry.Scheme.Etale.forget B₀
    let Q_prod_pre : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u} :=
      { obj := fun opW => AddCommGrpCat.of
          (∀ a : Fin m, LocallyConstant
            ↥(FgtB.obj ((weilEtaleSitePullback (τ a)).obj opW.unop)).left A)
        map := fun {_ _} u => AddCommGrpCat.ofHom
          { toFun := fun s a =>
              (((pf_loc_a a).obj).map u).hom (s a)
            map_zero' := funext fun a => map_zero (((pf_loc_a a).obj).map u).hom
            map_add' := fun s₁ s₂ => funext fun a =>
              map_add (((pf_loc_a a).obj).map u).hom (s₁ a) (s₂ a) }
        map_id := fun opW => AddCommGrpCat.ext fun s => funext fun a => by
          change (((pf_loc_a a).obj).map (𝟙 opW)).hom (s a) = s a
          rw [((pf_loc_a a).obj).map_id]; rfl
        map_comp := fun {W₁ W₂ W₃} u v => AddCommGrpCat.ext fun s => funext fun a => by
          change (((pf_loc_a a).obj).map (u ≫ v)).hom (s a) = _
          rw [((pf_loc_a a).obj).map_comp]; rfl }
    have hSh_prod : CategoryTheory.Presheaf.IsSheaf J_Y Q_prod_pre := by
      intro E W R hR s hs
      have hComp_a : ∀ a : Fin m,
          ∃! t_a : E ⟶ (pf_loc_a a).obj.obj (Opposite.op W),
            ∀ {V : Y₀.Etale} (u : V ⟶ W) (hu : R.arrows u),
