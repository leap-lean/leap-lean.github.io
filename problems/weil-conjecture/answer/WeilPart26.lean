  let S_de₂ : CategoryTheory.ShortComplex ℬ :=
    CategoryTheory.ShortComplex.mk d₁₂ ε₂₂ h_de₂
  have hEpi_klift_d : CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift ε₂₂ d₁₂ h_de₂) :=
    (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift S_de₂).mp hEx_de₂
  have hk_fac : π₂₂ ≫ CategoryTheory.Limits.kernel.lift ε₂₂ j₂₂ h_je₂ =
      CategoryTheory.Limits.kernel.lift ε₂₂ d₁₂ h_de₂ := by
    apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι ε₂₂)).mp
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι, h_pj₂,
      CategoryTheory.Limits.kernel.lift_ι]
  have hEpi_comp : CategoryTheory.Epi (π₂₂ ≫ CategoryTheory.Limits.kernel.lift ε₂₂ j₂₂ h_je₂) := by
    rw [hk_fac]
    exact hEpi_klift_d
  have hEpi_klift_j : CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift ε₂₂ j₂₂ h_je₂) :=
    @CategoryTheory.epi_of_epi _ _ _ _ _ π₂₂
      (CategoryTheory.Limits.kernel.lift ε₂₂ j₂₂ h_je₂) hEpi_comp
  have hEx₃_2 : SES₃_2.Exact :=
    (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift SES₃_2).mpr hEpi_klift_j
  have hSES₃_2 : SES₃_2.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' hEx₃_2 inferInstance inferInstance
  let s₂ : CategoryTheory.Abelian.Ext Z_B SES₃_2.X₂ p :=
    s'.comp (CategoryTheory.Abelian.Ext.mk₀ w_M₂) (Nat.add_zero p)
  have hs₂_zero : s₂.comp (CategoryTheory.Abelian.Ext.mk₀ SES₃_2.g) (Nat.add_zero p) = 0 := by
    change (s'.comp (CategoryTheory.Abelian.Ext.mk₀ w_M₂) (Nat.add_zero p)).comp
      (CategoryTheory.Abelian.Ext.mk₀ ε₂₂) (Nat.add_zero p) = 0
    have hs'_unfold : (s'.comp (CategoryTheory.Abelian.Ext.mk₀ ε₂') (Nat.add_zero p)).comp
        (CategoryTheory.Abelian.Ext.mk₀ w_R₂) (Nat.add_zero p) = 0 := hs'
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hComm_w2,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    exact hs'_unfold
  obtain ⟨b₂, hb₂⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Z_B hSES₃_2 s₂ hs₂_zero
  let b₁ : CategoryTheory.Abelian.Ext Z_B SES₂_1.X₃ p :=
    b₂.comp (CategoryTheory.Abelian.Ext.mk₀ u_B₂) (Nat.add_zero p)
  have hb₁_ext : b₁.comp hSES₂_1.extClass (rfl : p + 1 = p + 1) = 0 := by
    change (b₂.comp (CategoryTheory.Abelian.Ext.mk₀ Φ₂.τ₃) (Nat.add_zero p)).comp
      hSES₂_1.extClass (rfl : p + 1 = p + 1) = 0
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
      ← CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSES₂_2 hSES₂_1 Φ₂,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    exact hAnnih₁ p (b₂.comp hSES₂_2.extClass (rfl : p + 1 = p + 1))
  obtain ⟨t₁, ht₁⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Z_B hSES₂_1 b₁ (rfl : p + 1 = p + 1) hb₁_ext
  refine ⟨t₁, ?_⟩
  change t₁.comp (CategoryTheory.Abelian.Ext.mk₀ d₁₁) (Nat.add_zero p) =
    s'.comp (CategoryTheory.Abelian.Ext.mk₀ (w_M₂ ≫ u_M₂)) (Nat.add_zero p)
  calc
    t₁.comp (CategoryTheory.Abelian.Ext.mk₀ d₁₁) (Nat.add_zero p)
      = t₁.comp (CategoryTheory.Abelian.Ext.mk₀ (π₂₁ ≫ j₂₁)) (Nat.add_zero p) := by
          rw [h_pj₁]
    _ = (t₁.comp (CategoryTheory.Abelian.Ext.mk₀ π₂₁) (Nat.add_zero p)).comp
          (CategoryTheory.Abelian.Ext.mk₀ j₂₁) (Nat.add_zero p) := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    _ = b₁.comp (CategoryTheory.Abelian.Ext.mk₀ j₂₁) (Nat.add_zero p) := by
          rw [ht₁]
    _ = b₂.comp (CategoryTheory.Abelian.Ext.mk₀ (u_B₂ ≫ j₂₁)) (Nat.add_zero p) := by
          change (b₂.comp (CategoryTheory.Abelian.Ext.mk₀ u_B₂) (Nat.add_zero p)).comp
            (CategoryTheory.Abelian.Ext.mk₀ j₂₁) (Nat.add_zero p) = _
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    _ = b₂.comp (CategoryTheory.Abelian.Ext.mk₀ (j₂₂ ≫ u_M₂)) (Nat.add_zero p) := by
          rw [hu_B₂_j]
    _ = (b₂.comp (CategoryTheory.Abelian.Ext.mk₀ j₂₂) (Nat.add_zero p)).comp
          (CategoryTheory.Abelian.Ext.mk₀ u_M₂) (Nat.add_zero p) := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    _ = s₂.comp (CategoryTheory.Abelian.Ext.mk₀ u_M₂) (Nat.add_zero p) := by
          rw [hb₂]
    _ = s'.comp (CategoryTheory.Abelian.Ext.mk₀ (w_M₂ ≫ u_M₂)) (Nat.add_zero p) := by
          change (s'.comp (CategoryTheory.Abelian.Ext.mk₀ w_M₂) (Nat.add_zero p)).comp
            (CategoryTheory.Abelian.Ext.mk₀ u_M₂) (Nat.add_zero p) = _
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

theorem weil_etale_curve_fibration_two_step_wang_vanishing (Y B : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom Y B)
    (δ ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (F' F₂ F₁ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
    (w_sh : Quiver.Hom F' F₂)
    (u_sh : Quiver.Hom F₂ F₁)
    (hℓ_F' : ℓ • CategoryTheory.CategoryStruct.id F' = 0)
    (hℓ_F₂ : ℓ • CategoryTheory.CategoryStruct.id F₂ = 0)
    (hℓ_F₁ : ℓ • CategoryTheory.CategoryStruct.id F₁ = 0)
    (hR0_F' : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π 0 F'))
    (hR0_F₂ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π 0 F₂))
    (hR0_F₁ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π 0 F₁))
    (hR3 : ∀ k_deg : ℕ, 3 ≤ k_deg →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π k_deg F') ∧
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π k_deg F₂) ∧
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π k_deg F₁))
    (hR1_u : weilEtaleHigherDirectImageMap π 1 u_sh = 0)
    (hR2_w : ∀ (p : ℕ), p < 2 * δ →
      ∀ (y : (weilEtaleHigherDirectImage π 2 F').H p),
        (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleHigherDirectImageMap π 2 w_sh)).postcomp
          ((CategoryTheory.constantSheaf B.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero p) y = 0) :
    ∀ (q : ℕ), q < 2 * (δ + 1) →
      ∀ (z : F'.H q),
        (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp w_sh u_sh)).postcomp
          ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero q) z = 0 :=
by
  
  
  have hGlue :
      ∀ (𝒜_Y 𝒜_B : Type (u + 1))
        [CategoryTheory.Category.{u + 1, u + 1} 𝒜_Y] [CategoryTheory.Abelian 𝒜_Y]
        [CategoryTheory.HasExt.{u} 𝒜_Y] [CategoryTheory.EnoughInjectives 𝒜_Y]
        [CategoryTheory.Category.{u + 1, u + 1} 𝒜_B] [CategoryTheory.Abelian 𝒜_B]
        [CategoryTheory.HasExt.{u} 𝒜_B]
        (pb : 𝒜_B ⥤ 𝒜_Y) (pf : 𝒜_Y ⥤ 𝒜_B) (_adj : pb ⊣ pf)
        [CategoryTheory.Limits.PreservesFiniteLimits pb]
        [pf.Additive] [CategoryTheory.Limits.PreservesFiniteLimits pf]
        (Z_Y : 𝒜_Y) (Z_B : 𝒜_B)
        (R_obj : ℕ → 𝒜_Y → 𝒜_B)
        (R_map : ∀ (q : ℕ) {G₁ G₂ : 𝒜_Y}, (G₁ ⟶ G₂) → (R_obj q G₁ ⟶ R_obj q G₂)),
        (∀ (I : 𝒜_Y) [CategoryTheory.Injective I] (q : ℕ),
          1 ≤ q → CategoryTheory.Limits.IsZero (R_obj q I)) →
        ∀ (e₀ : ∀ G : 𝒜_Y, pf.obj G ≅ R_obj 0 G),
          (∀ {G₁ G₂ : 𝒜_Y} (φ : G₁ ⟶ G₂),
            pf.map φ ≫ (e₀ G₂).hom = (e₀ G₁).hom ≫ R_map 0 φ) →
          ∀ (δ_conn : ∀ {SC : CategoryTheory.ShortComplex 𝒜_Y},
              SC.ShortExact → ∀ (q : ℕ), R_obj q SC.X₃ ⟶ R_obj (q + 1) SC.X₁),
            (∀ {SC : CategoryTheory.ShortComplex 𝒜_Y} (hSE : SC.ShortExact) (q : ℕ),
              ∃ (h0_l : R_map q SC.g ≫ δ_conn hSE q = 0)
                (h0_r : δ_conn hSE q ≫ R_map (q + 1) SC.f = 0),
                (CategoryTheory.ShortComplex.mk (R_map q SC.g) (δ_conn hSE q) h0_l).Exact ∧
                (CategoryTheory.ShortComplex.mk (δ_conn hSE q) (R_map (q + 1) SC.f) h0_r).Exact) →
            (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex 𝒜_Y}
                (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂) (q : ℕ),
              R_map q Ψ.τ₃ ≫ δ_conn hSE₂ q = δ_conn hSE₁ q ≫ R_map (q + 1) Ψ.τ₁) →
            ∀ (Λ : ∀ (K : 𝒜_Y) (m : ℕ),
                CategoryTheory.Abelian.Ext Z_B (pf.obj K) m →+
                  CategoryTheory.Abelian.Ext Z_Y K m),
              (∀ {K₁ K₂ : 𝒜_Y} (ψ : K₁ ⟶ K₂) (m : ℕ)
                  (x : CategoryTheory.Abelian.Ext Z_B (pf.obj K₁) m),
                Λ K₂ m ((CategoryTheory.Abelian.Ext.mk₀ (pf.map ψ)).postcomp
                    Z_B (Nat.add_zero m) x) =
                  (CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp
                    Z_Y (Nat.add_zero m) (Λ K₁ m x)) →
              (∀ K : 𝒜_Y, Function.Bijective (Λ K 0)) →
              (∀ K : 𝒜_Y,
                (∀ k_deg : ℕ, 1 ≤ k_deg → CategoryTheory.Limits.IsZero (R_obj k_deg K)) →
                ∀ m : ℕ, Function.Bijective (Λ K m)) →
              ∀ (δ₀ : ℕ) (G' G₂ G₁ : 𝒜_Y) (w₀ : G' ⟶ G₂) (u₀ : G₂ ⟶ G₁),
                CategoryTheory.Limits.IsZero (R_obj 0 G') →
                CategoryTheory.Limits.IsZero (R_obj 0 G₁) →
                (∀ k_deg : ℕ, 3 ≤ k_deg → CategoryTheory.Limits.IsZero (R_obj k_deg G')) →
                R_map 1 u₀ = 0 →
                (∀ (p : ℕ), p < 2 * δ₀ →
                  ∀ (y : CategoryTheory.Abelian.Ext Z_B (R_obj 2 G') p),
                    (CategoryTheory.Abelian.Ext.mk₀ (R_map 2 w₀)).postcomp
                      Z_B (Nat.add_zero p) y = 0) →
                ∀ (q : ℕ), q < 2 * (δ₀ + 1) →
                  ∀ (z : CategoryTheory.Abelian.Ext Z_Y G' q),
                    (CategoryTheory.Abelian.Ext.mk₀ (w₀ ≫ u₀)).postcomp
                      Z_Y (Nat.add_zero q) z = 0 := by
    clear hR2_w hR1_u hR3 hR0_F₁ hR0_F₂ hR0_F' hℓ_F₁ hℓ_F₂ hℓ_F' u_sh w_sh F₁ F₂ F' π B Y
    intro 𝒜_Y 𝒜_B _ _ _ _ _ _ _ pb pf adj _ _ _ Z_Y Z_B
      R_obj R_map hInj_van e₀ he₀_nat δ_conn hδ_exact hδ_nat
      Λ hΛ_nat hΛ_bij0 hΛ_bij_acyc
      δ₀ F' F₂ F₁ w_sh u_sh hR0_F' hR0_F₁ hR3_F' hR1_u hR2_w
    let I₀ : 𝒜_Y → 𝒜_Y := fun G => CategoryTheory.Injective.under G
    let ι₀ : ∀ G : 𝒜_Y, G ⟶ I₀ G := fun G => CategoryTheory.Injective.ι G
    let Q₁ : 𝒜_Y → 𝒜_Y := fun G => CategoryTheory.Limits.cokernel (ι₀ G)
    let π₀ : ∀ G : 𝒜_Y, I₀ G ⟶ Q₁ G := fun G => CategoryTheory.Limits.cokernel.π (ι₀ G)
    let E₀ : 𝒜_Y → CategoryTheory.ShortComplex 𝒜_Y :=
      fun G => CategoryTheory.ShortComplex.mk (ι₀ G) (π₀ G)
        (CategoryTheory.Limits.cokernel.condition (ι₀ G))
    have hE₀ : ∀ G : 𝒜_Y, (E₀ G).ShortExact :=
      fun G => CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel (ι₀ G)) inferInstance inferInstance
    let liftSyzygy : ∀ {G₁ G₂ : 𝒜_Y} (φ : G₁ ⟶ G₂), E₀ G₁ ⟶ E₀ G₂ :=
      fun {G₁ G₂} φ =>
        let φ_I : I₀ G₁ ⟶ I₀ G₂ := CategoryTheory.Injective.factorThru (φ ≫ ι₀ G₂) (ι₀ G₁)
        have hcomm₁₂ : ι₀ G₁ ≫ φ_I = φ ≫ ι₀ G₂ :=
          CategoryTheory.Injective.comp_factorThru (φ ≫ ι₀ G₂) (ι₀ G₁)
        have hcond : ι₀ G₁ ≫ (φ_I ≫ π₀ G₂) = 0 := by
          rw [← CategoryTheory.Category.assoc, hcomm₁₂, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
        { τ₁ := φ
          τ₂ := φ_I
          τ₃ := CategoryTheory.Limits.cokernel.desc (ι₀ G₁) (φ_I ≫ π₀ G₂) hcond
          comm₁₂ := hcomm₁₂.symm
          comm₂₃ := (CategoryTheory.Limits.cokernel.π_desc (ι₀ G₁) (φ_I ≫ π₀ G₂) hcond).symm }
    let I₁ := fun G => I₀ (Q₁ G)
    let ι₁ := fun G => ι₀ (Q₁ G)
    let Q₂ := fun G => Q₁ (Q₁ G)
    let π₁ := fun G => π₀ (Q₁ G)
    let E₁ := fun G => E₀ (Q₁ G)
    have hE₁ : ∀ G, (E₁ G).ShortExact := fun G => hE₀ (Q₁ G)
    let Φ_w0 : E₀ F' ⟶ E₀ F₂ := liftSyzygy w_sh
    let Φ_u0 : E₀ F₂ ⟶ E₀ F₁ := liftSyzygy u_sh
    let Φ_w1 : E₁ F' ⟶ E₁ F₂ := liftSyzygy Φ_w0.τ₃
    let Φ_u1 : E₁ F₂ ⟶ E₁ F₁ := liftSyzygy Φ_u0.τ₃

    have hAcyc_Q₂F' : ∀ k : ℕ, 1 ≤ k → CategoryTheory.Limits.IsZero (R_obj k (Q₂ F')) := by
      intro k hk
      obtain ⟨_, _, hEx1_l, hEx1_r⟩ := hδ_exact (hE₁ F') k
      have hMono1 : CategoryTheory.Mono (δ_conn (hE₁ F') k) :=
        hEx1_l.mono_g ((hInj_van (I₁ F') k hk).eq_of_src _ 0)
      have hEpi1 : CategoryTheory.Epi (δ_conn (hE₁ F') k) :=
        hEx1_r.epi_f ((hInj_van (I₁ F') (k + 1) (by omega)).eq_of_tgt _ 0)
      have hIso1 : CategoryTheory.IsIso (δ_conn (hE₁ F') k) :=
        CategoryTheory.isIso_of_mono_of_epi (δ_conn (hE₁ F') k)
      obtain ⟨_, _, hEx0_l, hEx0_r⟩ := hδ_exact (hE₀ F') (k + 1)
      have hMono0 : CategoryTheory.Mono (δ_conn (hE₀ F') (k + 1)) :=
        hEx0_l.mono_g ((hInj_van (I₀ F') (k + 1) (by omega)).eq_of_src _ 0)
      have hEpi0 : CategoryTheory.Epi (δ_conn (hE₀ F') (k + 1)) :=
        hEx0_r.epi_f ((hInj_van (I₀ F') (k + 2) (by omega)).eq_of_tgt _ 0)
      have hIso0 : CategoryTheory.IsIso (δ_conn (hE₀ F') (k + 1)) :=
        CategoryTheory.isIso_of_mono_of_epi (δ_conn (hE₀ F') (k + 1))
      have hZ_Q₁ : CategoryTheory.Limits.IsZero (R_obj (k + 1) (Q₁ F')) :=
        (hR3_F' (k + 2) (by omega)).of_iso
          (@CategoryTheory.asIso _ _ _ _ (δ_conn (hE₀ F') (k + 1)) hIso0)
      exact hZ_Q₁.of_iso (@CategoryTheory.asIso _ _ _ _ (δ_conn (hE₁ F') k) hIso1)

    let ε₁ : ∀ G : 𝒜_Y, pf.obj (Q₁ G) ⟶ R_obj 1 G :=
      fun G => (e₀ (Q₁ G)).hom ≫ δ_conn (hE₀ G) 0
    let ε₂ : ∀ G : 𝒜_Y, pf.obj (Q₂ G) ⟶ R_obj 2 G :=
      fun G => (e₀ (Q₂ G)).hom ≫ δ_conn (hE₁ G) 0 ≫ δ_conn (hE₀ G) 1
    have hInj_pfI₀F₁ : CategoryTheory.Injective (pf.obj (I₀ F₁)) :=
      CategoryTheory.Injective.injective_of_adjoint adj (I₀ F₁)
    letI : CategoryTheory.Injective (pf.obj (I₀ F₁)) := hInj_pfI₀F₁
    have hZ_pfF' : CategoryTheory.Limits.IsZero (pf.obj F') := hR0_F'.of_iso (e₀ F')
    have hZ_pfF₁ : CategoryTheory.Limits.IsZero (pf.obj F₁) := hR0_F₁.of_iso (e₀ F₁)

    obtain ⟨hEx_pfE₀F₁, _⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf).mp
        inferInstance (E₀ F₁) (hE₀ F₁)
    have hMono_d₀₁ : CategoryTheory.Mono (pf.map (π₀ F₁)) :=
      hEx_pfE₀F₁.mono_g (hZ_pfF₁.eq_of_src _ 0)
    letI : CategoryTheory.Mono (pf.map (π₀ F₁)) := hMono_d₀₁

    have hEx_d_ε₁ : ∀ G : 𝒜_Y,
        CategoryTheory.Epi (ε₁ G) ∧
        ∃ h0 : pf.map (π₀ G) ≫ ε₁ G = 0,
          (CategoryTheory.ShortComplex.mk (pf.map (π₀ G)) (ε₁ G) h0).Exact := by
      intro G
      obtain ⟨h0_l, _, hEx_l, hEx_r⟩ := hδ_exact (hE₀ G) 0
      have hEpi_δ0 : CategoryTheory.Epi (δ_conn (hE₀ G) 0) :=
        hEx_r.epi_f ((hInj_van (I₀ G) 1 (le_refl 1)).eq_of_tgt _ 0)
      letI : CategoryTheory.Epi (δ_conn (hE₀ G) 0) := hEpi_δ0
      have hEpi_ε₁ : CategoryTheory.Epi (ε₁ G) := CategoryTheory.epi_comp _ _
      have h0 : pf.map (π₀ G) ≫ ε₁ G = 0 := by
        dsimp [ε₁]
        rw [← CategoryTheory.Category.assoc, he₀_nat (π₀ G),
          CategoryTheory.Category.assoc, h0_l, CategoryTheory.Limits.comp_zero]
      let e_SC : CategoryTheory.ShortComplex.mk (R_map 0 (π₀ G)) (δ_conn (hE₀ G) 0) h0_l ≅
          CategoryTheory.ShortComplex.mk (pf.map (π₀ G)) (ε₁ G) h0 :=
        CategoryTheory.ShortComplex.isoMk
          (e₀ (I₀ G)).symm (e₀ (Q₁ G)).symm (CategoryTheory.Iso.refl _)
          (by
            change (e₀ (I₀ G)).inv ≫ pf.map (π₀ G) = R_map 0 (π₀ G) ≫ (e₀ (Q₁ G)).inv
            apply (CategoryTheory.cancel_epi (e₀ (I₀ G)).hom).mp
            rw [← CategoryTheory.Category.assoc, (e₀ (I₀ G)).hom_inv_id,
              CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
              ← he₀_nat (π₀ G), CategoryTheory.Category.assoc, (e₀ (Q₁ G)).hom_inv_id,
              CategoryTheory.Category.comp_id])
          (by
            dsimp [ε₁]
            rw [← CategoryTheory.Category.assoc, (e₀ (Q₁ G)).inv_hom_id,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      exact ⟨hEpi_ε₁, h0, (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC).mp hEx_l⟩

    obtain ⟨hEpi_ε₁F₁, hEx_1_F₁⟩ := hEx_d_ε₁ F₁
    letI : CategoryTheory.Epi (ε₁ F₁) := hEpi_ε₁F₁
    have hComm_u1 : pf.map Φ_u0.τ₃ ≫ ε₁ F₁ = ε₁ F₂ ≫ R_map 1 u_sh := by
      dsimp [ε₁]
      rw [← CategoryTheory.Category.assoc, he₀_nat Φ_u0.τ₃,
        CategoryTheory.Category.assoc, hδ_nat (hE₀ F₂) (hE₀ F₁) Φ_u0 0,
        CategoryTheory.Category.assoc]

    
    obtain ⟨hWang1, hWang2⟩ :=
