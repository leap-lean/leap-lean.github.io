            map_add' := fun a b => add_zsmul s a.down b.down }
      let evHom : ∀ {M : AddCommGrpCat.{u}}, (Aℤ ⟶ M) → ↥M := fun m =>
        m.hom (ULift.up (1 : ℤ))
