        have hx : x ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base := by rw [hTwoChartCov]; trivial
        rcases hx with hx1 | hx0
        · exact ⟨false, hx1⟩
        · exact ⟨true, hx0⟩)
      (s_one.base pt₀)
      (fun b => by
        have hmem := hs_one_mem ⟨pt₀, rfl⟩
        cases b
        · exact hmem.1
        · exact hmem.2)

  
  let e_emp := MvPolynomial.isEmptyAlgEquiv k (Fin 0)
  have hIso_aff0 : CategoryTheory.IsIso (weilAffineSpaceOver k 0).hom := by
    let f0 := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k))
    have hC_eq : CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k) =
        CommRingCat.ofHom e_emp.symm.toRingHom :=
      CommRingCat.hom_ext (RingHom.ext fun c => (e_emp.symm.commutes c).symm)
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom e_emp.symm.toRingHom) :=
      ⟨⟨CommRingCat.ofHom e_emp.toRingHom,
        CommRingCat.hom_ext (RingHom.ext fun x => e_emp.apply_symm_apply x),
        CommRingCat.hom_ext (RingHom.ext fun x => e_emp.symm_apply_apply x)⟩⟩
    have hf0 : CategoryTheory.IsIso f0 := by
      dsimp [f0]
      rw [hC_eq]
      infer_instance
    exact hf0
  have _ : CategoryTheory.IsIso (weilAffineSpaceOver k 0).hom := hIso_aff0

  let p_head : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k (δ + 1)).left (weilAffineSpaceOver k δ).left :=
    fun δ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (MvPolynomial.rename Fin.castSucc :
        MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).toRingHom)
  let p_last : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k (δ + 1)).left A_1 :=
    fun δ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (Polynomial.aeval
        (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) k)).toRingHom)
  have h_head_over : ∀ δ : ℕ,
      p_head δ ≫ (weilAffineSpaceOver k δ).hom = (weilAffineSpaceOver k (δ + 1)).hom := by
    intro δ
    change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ = AlgebraicGeometry.Spec.map _
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext c
    simp
  have h_last_over : ∀ δ : ℕ,
      p_last δ ≫ f_A1 = (weilAffineSpaceOver k (δ + 1)).hom := by
    intro δ
    change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ = AlgebraicGeometry.Spec.map _
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext c
    simp

  have hSplitIso : ∀ δ : ℕ,
      CategoryTheory.IsIso (CategoryTheory.Limits.pullback.lift
        (p_head δ) (p_last δ) ((h_head_over δ).trans (h_last_over δ).symm)) := by
    intro δ
    let R_δ := MvPolynomial (Fin δ) k
    let R_succ := MvPolynomial (Fin (δ + 1)) k
    let T_δ := TensorProduct k R_δ (Polynomial k)
    let α_fwd : T_δ →ₐ[k] R_succ :=
      Algebra.TensorProduct.lift
        (MvPolynomial.rename Fin.castSucc)
        (Polynomial.aeval (MvPolynomial.X (Fin.last δ) : R_succ))
        (fun _ _ => mul_comm _ _)
    let α_inv : R_succ →ₐ[k] T_δ :=
      MvPolynomial.aeval (Fin.lastCases
        (Algebra.TensorProduct.includeRight (R := k) (A := R_δ) (B := Polynomial k) Polynomial.X)
        (fun i : Fin δ =>
          Algebra.TensorProduct.includeLeft (R := k) (S := k) (A := R_δ) (B := Polynomial k)
            (MvPolynomial.X i)))
    have h_fwd_right := Algebra.TensorProduct.lift_comp_includeRight
      (R := k) (S := k)
      (MvPolynomial.rename (R := k) Fin.castSucc)
      (Polynomial.aeval (R := k) (MvPolynomial.X (Fin.last δ) : R_succ))
      (fun _ _ => mul_comm _ _)
    have h_fwd_left := Algebra.TensorProduct.lift_comp_includeLeft
      (R := k) (S := k)
      (MvPolynomial.rename (R := k) Fin.castSucc)
      (Polynomial.aeval (R := k) (MvPolynomial.X (Fin.last δ) : R_succ))
      (fun _ _ => mul_comm _ _)
    have h_fwd_inv : α_fwd.comp α_inv = AlgHom.id k R_succ := by
      apply MvPolynomial.algHom_ext
      intro j
      refine Fin.lastCases ?_ ?_ j
      · change α_fwd (α_inv (MvPolynomial.X (Fin.last δ))) = MvPolynomial.X (Fin.last δ)
        dsimp [α_inv]
        rw [MvPolynomial.aeval_X, Fin.lastCases_last]
        exact (AlgHom.congr_fun h_fwd_right Polynomial.X).trans (Polynomial.aeval_X _)
      · intro i
        change α_fwd (α_inv (MvPolynomial.X i.castSucc)) = MvPolynomial.X i.castSucc
        dsimp [α_inv]
        rw [MvPolynomial.aeval_X, Fin.lastCases_castSucc]
        exact (AlgHom.congr_fun h_fwd_left (MvPolynomial.X i)).trans (MvPolynomial.rename_X _ _)
    have h_inv_fwd : α_inv.comp α_fwd = AlgHom.id k T_δ := by
      apply Algebra.TensorProduct.ext
      · rw [AlgHom.comp_assoc, h_fwd_left]
        apply MvPolynomial.algHom_ext
        intro i
        dsimp [α_inv]
        rw [MvPolynomial.rename_X, MvPolynomial.aeval_X, Fin.lastCases_castSucc]
        rfl
      · apply Polynomial.algHom_ext
        change α_inv (α_fwd (Algebra.TensorProduct.includeRight Polynomial.X)) =
          Algebra.TensorProduct.includeRight Polynomial.X
        have hx : α_fwd (Algebra.TensorProduct.includeRight Polynomial.X) =
            MvPolynomial.X (Fin.last δ) :=
          (AlgHom.congr_fun h_fwd_right Polynomial.X).trans (Polynomial.aeval_X _)
        rw [hx]
        dsimp [α_inv]
        rw [MvPolynomial.aeval_X, Fin.lastCases_last]
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom α_fwd.toRingHom) :=
      ⟨⟨CommRingCat.ofHom α_inv.toRingHom,
        CommRingCat.hom_ext (RingHom.ext fun x => AlgHom.congr_fun h_inv_fwd x),
        CommRingCat.hom_ext (RingHom.ext fun x => AlgHom.congr_fun h_fwd_inv x)⟩⟩
    let iso_pb := AlgebraicGeometry.pullbackSpecIso k R_δ (Polynomial k)
    let f_δ_raw := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_δ))
    let f_1_raw := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))
    let ψ_raw : AlgebraicGeometry.Spec (CommRingCat.of R_succ) ⟶
        CategoryTheory.Limits.pullback f_δ_raw f_1_raw :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_fwd.toRingHom) ≫ iso_pb.inv
    have hIso_ψ : CategoryTheory.IsIso ψ_raw := inferInstance
    let p_head_raw : AlgebraicGeometry.Spec (CommRingCat.of R_succ) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_δ) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename (R := k) Fin.castSucc : R_δ →ₐ[k] R_succ).toRingHom)
    let p_last_raw : AlgebraicGeometry.Spec (CommRingCat.of R_succ) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Polynomial.aeval (R := k) (MvPolynomial.X (Fin.last δ) : R_succ)).toRingHom)
    have h_comm_raw : p_head_raw ≫ f_δ_raw = p_last_raw ≫ f_1_raw :=
      (h_head_over δ).trans (h_last_over δ).symm
    let lift_raw : AlgebraicGeometry.Spec (CommRingCat.of R_succ) ⟶
        CategoryTheory.Limits.pullback f_δ_raw f_1_raw :=
      CategoryTheory.Limits.pullback.lift p_head_raw p_last_raw h_comm_raw
    have h_eq_lift : lift_raw = ψ_raw := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [lift_raw, ψ_raw, iso_pb, f_δ_raw, f_1_raw]
        rw [CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
          AlgebraicGeometry.pullbackSpecIso_inv_fst,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        dsimp [p_head_raw]
        congr 2
        exact RingHom.ext fun p => (AlgHom.congr_fun h_fwd_left p).symm
      · dsimp [lift_raw, ψ_raw, iso_pb, f_δ_raw, f_1_raw]
        rw [CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
          AlgebraicGeometry.pullbackSpecIso_inv_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        dsimp [p_last_raw]
        congr 2
        exact RingHom.ext fun p => (AlgHom.congr_fun h_fwd_right p).symm
    have hIso_lift : CategoryTheory.IsIso lift_raw := h_eq_lift.symm ▸ hIso_ψ
    exact hIso_lift

  
  let affPair : ∀ δ : ℕ,
      { f : Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left //
        CategoryTheory.CategoryStruct.comp f (weilPolyP1Over k δ).hom =
          (weilAffineSpaceOver k δ).hom } :=
    Nat.rec
      ⟨(weilAffineSpaceOver k 0).hom, Category.comp_id _⟩
      (fun δ ih =>
        let g1 := p_head δ ≫ ih.1
        let g2 := p_last δ ≫ ι_P1
        have hcomm : g1 ≫ (weilPolyP1Over k δ).hom = g2 ≫ P_1.hom := by
          dsimp [g1, g2]
