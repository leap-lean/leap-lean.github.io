      change (adj_top.homEquiv Fℤ_Z Fℤ_Y')
          (Φ_hom_app Fℤ_Z ≫ (P_pull_Y.map πℤ_ν ≫ πℤ_Y)) = _
      rw [hΦ_mate (P_pull_Y.map πℤ_ν ≫ πℤ_Y)]
      congr 1
      change (adj_ν.homEquiv Fℤ_Z (P_push_Y.obj Fℤ_Y'))
        ((adj_Y.homEquiv (P_pull_ν.obj Fℤ_Z) Fℤ_Y') (P_pull_Y.map πℤ_ν ≫ πℤ_Y)) = _
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
        CategoryTheory.Adjunction.homEquiv_naturality_right]
    have hR_adj : (adj_top.homEquiv Fℤ_Z Fℤ_Y') (P_pull_ν'.map πℤ_Z ≫ πℤ_ν') =
        (adj_Z.homEquiv Fℤ_Z Fℤ_Z') πℤ_Z ≫
          P_push_Z.map ((adj_ν'.homEquiv Fℤ_Z' Fℤ_Y') πℤ_ν') := by
      change (adj_Z.homEquiv Fℤ_Z (P_push_ν'.obj Fℤ_Y'))
        ((adj_ν'.homEquiv (P_pull_Z.obj Fℤ_Z) Fℤ_Y') (P_pull_ν'.map πℤ_Z ≫ πℤ_ν')) = _
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
        CategoryTheory.Adjunction.homEquiv_naturality_right]
    rw [hL_adj, hR_adj]
    let m_L : (CategoryTheory.presheafToSheaf J_Z AddCommGrpCat.{u}).obj Pℤ_Z ⟶ G_target :=
      ((adj_ν.homEquiv Fℤ_Z Fℤ_Y) πℤ_ν ≫ P_push_ν.map ((adj_Y.homEquiv Fℤ_Y Fℤ_Y') πℤ_Y)) ≫
        e_push.hom.app Fℤ_Y'
    let m_R : (CategoryTheory.presheafToSheaf J_Z AddCommGrpCat.{u}).obj Pℤ_Z ⟶ G_target :=
      (adj_Z.homEquiv Fℤ_Z Fℤ_Z') πℤ_Z ≫
        P_push_Z.map ((adj_ν'.homEquiv Fℤ_Z' Fℤ_Y') πℤ_ν')
    change m_L = m_R
    apply (shAdj_Z.homEquiv Pℤ_Z G_target).injective
    rw [shAdj_Z.homEquiv_unit Pℤ_Z G_target m_L, shAdj_Z.homEquiv_unit Pℤ_Z G_target m_R]
    apply CategoryTheory.NatTrans.ext
    funext opU
    let U := Opposite.unop opU
    have h_ν_app := hConstPullbackSh ν.left P_pull_ν adj_ν T_Y_ν hT_Y_ν T_Z_ν hT_Z_ν U
    have h_Y_app := hConstPullbackSh ι_Y P_pull_Y adj_Y T_Y'_pY hT_Y'_pY T_Y_pY hT_Y_pY (B_ν.obj U)
    have h_Z_app := hConstPullbackSh ι_Z P_pull_Z adj_Z T_Z'_pZ hT_Z'_pZ T_Z_pZ hT_Z_pZ U
    have h_ν'_app :=
      hConstPullbackSh ν'.left P_pull_ν' adj_ν' T_Y'_ν' hT_Y'_ν' T_Z'_ν' hT_Z'_ν' (B_Z.obj U)
    let u₀ : Aℤ ⟶ Fℤ_Z.obj.obj (Opposite.op U) :=
      (shAdj_Z.unit.app Pℤ_Z).app (Opposite.op U)
    let g₁ := ((adj_ν.homEquiv Fℤ_Z Fℤ_Y) πℤ_ν).hom.app (Opposite.op U)
    let g₂ := ((adj_Y.homEquiv Fℤ_Y Fℤ_Y') πℤ_Y).hom.app (Opposite.op (B_ν.obj U))
    let g₃ := Fℤ_Y'.obj.map (e_site.inv.app U).op
    let r₁ := ((adj_Z.homEquiv Fℤ_Z Fℤ_Z') πℤ_Z).hom.app (Opposite.op U)
    let r₂ := ((adj_ν'.homEquiv Fℤ_Z' Fℤ_Y') πℤ_ν').hom.app (Opposite.op (B_Z.obj U))
    have hnat_e := ((shAdj_Y'.unit.app Pℤ_Y').naturality (e_site.inv.app U).op).symm
    have hnat_e' : (shAdj_Y'.unit.app Pℤ_Y').app (Opposite.op ((B_ν ⋙ B_Y).obj U)) ≫ g₃ =
        (shAdj_Y'.unit.app Pℤ_Y').app (Opposite.op ((B_Z ⋙ B_ν').obj U)) := by
      change (shAdj_Y'.unit.app Pℤ_Y').app (Opposite.op ((B_ν ⋙ B_Y).obj U)) ≫
          Fℤ_Y'.obj.map (e_site.inv.app U).op =
        𝟙 Aℤ ≫ (shAdj_Y'.unit.app Pℤ_Y').app (Opposite.op ((B_Z ⋙ B_ν').obj U)) at hnat_e
      exact hnat_e.trans (CategoryTheory.Category.id_comp _)
    have hLHS : u₀ ≫ ((g₁ ≫ g₂) ≫ g₃) =
        (shAdj_Y'.unit.app Pℤ_Y').app (Opposite.op ((B_Z ⋙ B_ν').obj U)) :=
      (CategoryTheory.Category.assoc u₀ (g₁ ≫ g₂) g₃).symm.trans
        ((congrArg (· ≫ g₃)
          ((CategoryTheory.Category.assoc u₀ g₁ g₂).symm.trans
            ((congrArg (· ≫ g₂) h_ν_app).trans h_Y_app))).trans hnat_e')
    have hRHS : u₀ ≫ (r₁ ≫ r₂) =
        (shAdj_Y'.unit.app Pℤ_Y').app (Opposite.op ((B_Z ⋙ B_ν').obj U)) :=
      (CategoryTheory.Category.assoc u₀ r₁ r₂).symm.trans
        ((congrArg (· ≫ r₂) h_Z_app).trans h_ν'_app)
    change u₀ ≫ ((g₁ ≫ g₂) ≫ g₃) = u₀ ≫ (r₁ ≫ r₂)
    exact hLHS.trans hRHS.symm

  have h_src : ιℤ_ν' ≫ P_pull_ν'.map ιℤ_Z ≫ Φ_pb.hom.app Fℤ_Z =
      ιℤ_Y ≫ P_pull_Y.map ιℤ_ν := by
    have hR_inv : (P_pull_Y.map πℤ_ν ≫ πℤ_Y) ≫ (ιℤ_Y ≫ P_pull_Y.map ιℤ_ν) =
        𝟙 ((P_pull_ν ⋙ P_pull_Y).obj Fℤ_Z) := by
      calc
        (P_pull_Y.map πℤ_ν ≫ πℤ_Y) ≫ (ιℤ_Y ≫ P_pull_Y.map ιℤ_ν)
          = P_pull_Y.map πℤ_ν ≫ (πℤ_Y ≫ ιℤ_Y) ≫ P_pull_Y.map ιℤ_ν := by
              simp only [CategoryTheory.Category.assoc]
        _ = P_pull_Y.map πℤ_ν ≫ P_pull_Y.map ιℤ_ν := by
              rw [hπι_Y, CategoryTheory.Category.id_comp]
        _ = P_pull_Y.map (πℤ_ν ≫ ιℤ_ν) := (P_pull_Y.map_comp _ _).symm
        _ = 𝟙 _ := by rw [hπι_ν, P_pull_Y.map_id]
    have hL_inv : ιℤ_ν' ≫ P_pull_ν'.map ιℤ_Z ≫ (P_pull_ν'.map πℤ_Z ≫ πℤ_ν') = 𝟙 Fℤ_Y' := by
      calc
        ιℤ_ν' ≫ P_pull_ν'.map ιℤ_Z ≫ (P_pull_ν'.map πℤ_Z ≫ πℤ_ν')
          = ιℤ_ν' ≫ (P_pull_ν'.map ιℤ_Z ≫ P_pull_ν'.map πℤ_Z) ≫ πℤ_ν' := by
              simp only [CategoryTheory.Category.assoc]
        _ = ιℤ_ν' ≫ P_pull_ν'.map (ιℤ_Z ≫ πℤ_Z) ≫ πℤ_ν' := by
              rw [← P_pull_ν'.map_comp]
        _ = ιℤ_ν' ≫ πℤ_ν' := by
              rw [hιπ_Z, P_pull_ν'.map_id, CategoryTheory.Category.id_comp]
        _ = 𝟙 Fℤ_Y' := hιπ_ν'
    calc
      ιℤ_ν' ≫ P_pull_ν'.map ιℤ_Z ≫ Φ_pb.hom.app Fℤ_Z
        = ιℤ_ν' ≫ P_pull_ν'.map ιℤ_Z ≫ Φ_pb.hom.app Fℤ_Z ≫
            ((P_pull_Y.map πℤ_ν ≫ πℤ_Y) ≫ (ιℤ_Y ≫ P_pull_Y.map ιℤ_ν)) := by
            rw [hR_inv, CategoryTheory.Category.comp_id]
      _ = (ιℤ_ν' ≫ P_pull_ν'.map ιℤ_Z ≫
            (Φ_pb.hom.app Fℤ_Z ≫ P_pull_Y.map πℤ_ν ≫ πℤ_Y)) ≫
            (ιℤ_Y ≫ P_pull_Y.map ιℤ_ν) := by
            simp only [CategoryTheory.Category.assoc]
