        have h3 : (adj_B.unit.app AM ≫ F_B.obj.map u_t.op) ≫ e_app =
            (adj_B.unit.app AM ≫ e_loc_B.hom.hom.app (Opposite.op T_B)) ≫ L_loc_B.obj.map u_t.op :=
          (CategoryTheory.Category.assoc _ _ _).trans
