  obtain ⟨P_kum, τ_int, U₁, U₂, g_sec, u₁₂, hSec₁, hSec₂, hSpecKill⟩ :=
    weil_etale_rel_curve_cover_kummer_annihilation k ℓ hℓ δ W₀ p_W₀ x₀ E hPBC hCurveCoh

  
  obtain ⟨V_mid, h_mid, v_mid, r₁, _, hAff_mid, hv_mid_cl, hv_mid_map, hConst₁⟩ :=
    weil_etale_rel_curve_cover_r1_constancy k ℓ hℓ δ W₀ p_W₀ x₀ E hProjCurveNonDeg
      hPBC hCurveCoh P₀ P_kum.V P_kum.g_V P_kum.v P_kum.hAff_V P_kum.hv_cl P_kum.hv_map
  obtain ⟨V₂, h_top, v₂, r₂, hConn_V₂, hAff_V₂, hv₂_cl, hv₂_map, hConst₂⟩ :=
    weil_etale_rel_curve_cover_r1_constancy k ℓ hℓ δ W₀ p_W₀ x₀ E hProjCurveNonDeg
      hPBC hCurveCoh P_kum V_mid h_mid v_mid hAff_mid hv_mid_cl hv_mid_map

  let h₂ : V₂ ⟶ P_kum.V := h_top ≫ h_mid
  let g_V₂ : V₂ ⟶ E.V₁ := h₂ ≫ P_kum.g_V
  have hv₂_h₂ : (Fgt_V.map h₂).left.base v₂ = P_kum.v := by
    change (Fgt_V.map h_mid).left.base ((Fgt_V.map h_top).left.base v₂) = P_kum.v
    rw [hv₂_map, hv_mid_map]
  have hv₂_gV₂ : (Fgt_V.map g_V₂).left.base v₂ = E.v₁ := by
    change (Fgt_V.map P_kum.g_V).left.base ((Fgt_V.map h₂).left.base v₂) = E.v₁
    rw [hv₂_h₂, P_kum.hv_map]

  have hIso₁ := hConst₁ V₂ h_top (Fgt_V.map g_V₂).left hAff_V₂
    (congrArg (fun k => (Fgt_V.map k).left)
      (CategoryTheory.Category.assoc h_top h_mid P_kum.g_V))
  have hIso₂ := hConst₂ V₂ (𝟙 V₂) (Fgt_V.map h₂).left hAff_V₂ (by
    change (Fgt_V.map (h_top ≫ h_mid)).left = (Fgt_V.map (𝟙 V₂ ≫ h_top ≫ h_mid)).left
    rw [CategoryTheory.Category.id_comp])

  
  let f_W_kum : (Fgt_Y.obj P_kum.W).left ⟶ (Fgt_V.obj P_kum.V).left :=
    CategoryTheory.CategoryStruct.comp P_kum.e_W.hom
      (CategoryTheory.CategoryStruct.comp P_kum.W_open.ι P_kum.f_bar)
  let h₂_sch : (Fgt_V.obj V₂).left ⟶ (Fgt_V.obj P_kum.V).left := (Fgt_V.map h₂).left
  haveI : AlgebraicGeometry.IsAffine P_kum.W_open.toScheme := P_kum.hAff_Wopen
  have hAff_PkumW : AlgebraicGeometry.IsAffine (Fgt_Y.obj P_kum.W).left :=
    AlgebraicGeometry.IsAffine.of_isIso P_kum.e_W.hom
  haveI : AlgebraicGeometry.IsAffine (Fgt_Y.obj P_kum.W).left := hAff_PkumW
  haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj P_kum.V).left := P_kum.hAff_V
  haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj V₂).left := hAff_V₂
  haveI : AlgebraicGeometry.Etale h₂_sch := hEt_of_etale_hom h₂
  haveI : AlgebraicGeometry.Etale (Fgt_Y.obj P_kum.W).hom := P_kum.W.prop
  let W₂_sch := CategoryTheory.Limits.pullback f_W_kum h₂_sch
  let p_W₂ : W₂_sch ⟶ (Fgt_Y.obj P_kum.W).left :=
    CategoryTheory.Limits.pullback.fst f_W_kum h₂_sch
  let f_W₂ : W₂_sch ⟶ (Fgt_V.obj V₂).left :=
    CategoryTheory.Limits.pullback.snd f_W_kum h₂_sch
  have hAff_W₂ : AlgebraicGeometry.IsAffine W₂_sch := inferInstance
  haveI : AlgebraicGeometry.IsAffine W₂_sch := hAff_W₂
  haveI : AlgebraicGeometry.Etale p_W₂ := inferInstance
  let W₂ : E.Y_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (p_W₂ ≫ (Fgt_Y.obj P_kum.W).hom) inferInstance
  let h_W₂ : W₂ ⟶ P_kum.W :=
    CategoryTheory.MorphismProperty.Over.homMk p_W₂ rfl trivial
  let u₁_W : W₂ ⟶ E.W₁ := h_W₂ ≫ P_kum.u_W

  haveI : AlgebraicGeometry.IsProper E.Y_bar.hom := E.hProp_Ybar
  haveI : AlgebraicGeometry.IsProper E.V_bar.hom := E.hProp_Vbar
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj P_kum.V).hom := P_kum.V.prop
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj V₂).hom := V₂.prop
  let p_k_PkumW : (Fgt_Y.obj P_kum.W).left ⟶ S_k := (Fgt_Y.obj P_kum.W).hom ≫ E.Y_bar.hom
  let p_k_PkumV : (Fgt_V.obj P_kum.V).left ⟶ S_k := (Fgt_V.obj P_kum.V).hom ≫ E.V_bar.hom
  let p_k_V₂ : (Fgt_V.obj V₂).left ⟶ S_k := (Fgt_V.obj V₂).hom ≫ E.V_bar.hom
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_k_PkumW := inferInstance
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_k_V₂ := inferInstance

  have hf_W_kum_k : f_W_kum ≫ p_k_PkumV = p_k_PkumW := by
    have hgV_w : (Fgt_V.map P_kum.g_V).left ≫ (Fgt_V.obj E.V₁).hom = (Fgt_V.obj P_kum.V).hom :=
      CategoryTheory.MorphismProperty.Over.w P_kum.g_V
    have hπ_w : E.π_bar.left ≫ E.V_bar.hom = E.Y_bar.hom :=
      CategoryTheory.Over.w E.π_bar
    calc
      (P_kum.e_W.hom ≫ P_kum.W_open.ι ≫ P_kum.f_bar) ≫ ((Fgt_V.obj P_kum.V).hom ≫ E.V_bar.hom)
        = P_kum.e_W.hom ≫ P_kum.W_open.ι ≫
            ((P_kum.f_bar ≫ (Fgt_V.map P_kum.g_V).left) ≫ (Fgt_V.obj E.V₁).hom) ≫ E.V_bar.hom := by
            rw [← hgV_w]
            simp only [CategoryTheory.Category.assoc]
      _ = P_kum.e_W.hom ≫ P_kum.W_open.ι ≫
            ((P_kum.π_Y₁ ≫ E.f_bar₁) ≫ (Fgt_V.obj E.V₁).hom) ≫ E.V_bar.hom := by
            rw [← P_kum.hComm_Y₁]
      _ = P_kum.e_W.hom ≫ P_kum.W_open.ι ≫ P_kum.π_Y₁ ≫
            (E.f_bar₁ ≫ (Fgt_V.obj E.V₁).hom) ≫ E.V_bar.hom := by
            simp only [CategoryTheory.Category.assoc]
      _ = P_kum.e_W.hom ≫ P_kum.W_open.ι ≫ P_kum.π_Y₁ ≫
            (E.g_Y₁ ≫ E.π_bar.left) ≫ E.V_bar.hom := by
            rw [← E.hComm_Y₁]
      _ = (P_kum.e_W.hom ≫ P_kum.W_open.ι ≫ P_kum.π_Y₁ ≫ E.g_Y₁) ≫
            (E.π_bar.left ≫ E.V_bar.hom) := by
            simp only [CategoryTheory.Category.assoc]
      _ = (Fgt_Y.obj P_kum.W).hom ≫ E.Y_bar.hom := by
            rw [P_kum.he_W_hom, hπ_w]

  have hh₂_k : h₂_sch ≫ p_k_PkumV = p_k_V₂ := by
    have hh₂_w : h₂_sch ≫ (Fgt_V.obj P_kum.V).hom = (Fgt_V.obj V₂).hom :=
      CategoryTheory.MorphismProperty.Over.w h₂
    dsimp [p_k_PkumV, p_k_V₂]
    rw [← CategoryTheory.Category.assoc, hh₂_w]

  obtain ⟨s_x, hs_x_sec, hs_x_pt⟩ := hClosedPtSection p_k_PkumW P_kum.x P_kum.hx_cl
  obtain ⟨s_v₂, hs_v₂_sec, hs_v₂_pt⟩ := hClosedPtSection p_k_V₂ v₂ hv₂_cl
  have hs_W₂_eq : s_x ≫ f_W_kum = s_v₂ ≫ h₂_sch :=
    hSectionEq p_k_PkumV (s_x ≫ f_W_kum) (s_v₂ ≫ h₂_sch)
      (by rw [CategoryTheory.Category.assoc, hf_W_kum_k]; exact hs_x_sec)
      (by rw [CategoryTheory.Category.assoc, hh₂_k]; exact hs_v₂_sec)
      (by
        change f_W_kum.base (s_x.base pt_k) = h₂_sch.base (s_v₂.base pt_k)
        rw [hs_x_pt, hs_v₂_pt, hv₂_h₂]
        exact P_kum.hx_fib)
  let s_W₂ : S_k ⟶ W₂_sch := CategoryTheory.Limits.pullback.lift s_x s_v₂ hs_W₂_eq
  let x₂ : ↥W₂_sch := s_W₂.base pt_k
  have hx₂_cl : IsClosed ({x₂} : Set ↥W₂_sch) :=
    hClosedOfSection (f_W₂ ≫ p_k_V₂) s_W₂ (by
      dsimp [s_W₂, f_W₂]
      rw [CategoryTheory.Limits.pullback.lift_snd_assoc]
      exact hs_v₂_sec)
  have hx₂_pW₂ : p_W₂.base x₂ = P_kum.x := by
    change (s_W₂ ≫ p_W₂).base pt_k = P_kum.x
    rw [CategoryTheory.Limits.pullback.lift_fst]
    exact hs_x_pt
  have hx₂_u₁W : (Fgt_Y.map u₁_W).left.base x₂ = E.x₁ := by
    change (Fgt_Y.map P_kum.u_W).left.base (p_W₂.base x₂) = E.x₁
    rw [hx₂_pW₂, P_kum.hx_map]
  have hx₂_fib : f_W₂.base x₂ = v₂ := by
    change (s_W₂ ≫ f_W₂).base pt_k = v₂
    rw [CategoryTheory.Limits.pullback.lift_snd]
    exact hs_v₂_pt
  have hPb_W₂ : CategoryTheory.IsPullback
      (Fgt_Y.map h_W₂).left f_W₂ f_W_kum (Fgt_V.map h₂).left :=
    CategoryTheory.IsPullback.of_hasPullback f_W_kum h₂_sch

  
  have hR1_zero :
      weilEtaleHigherDirectImageMap E.π_bar.left 1
        (weilEtaleLocalTorsionMap E.Y_bar.left ℓ u₁_W) = 0 :=
    weil_etale_rel_curve_cover_global_r1_zero_of_const_and_special_fiber
      k ℓ hℓ δ W₀ p_W₀ x₀ E hDual_U hPBC P_kum V₂ h₂ v₂ W₂ h_W₂ f_W₂ r₁ r₂
      hSpecKill hConn_V₂ hAff_V₂ hv₂_cl hv₂_h₂ hPb_W₂ hIso₁ hIso₂

  refine ⟨V₂, g_V₂, v₂, W₂, u₁_W, x₂, hAff_V₂, hv₂_cl, hv₂_gV₂,
    hAff_W₂, hx₂_cl, hx₂_u₁W, hR1_zero, ?_⟩
  intro V' w₁ v'₂ hAff_V' hv'₂_cl hv'₂_map
  exact weil_etale_rel_curve_cover_baseChange_vanishing_and_clopen_diag_r2
    k ℓ hℓ δ W₀ p_W₀ x₀ E hPBC hCurveCoh P_kum τ_int U₁ U₂ g_sec u₁₂
    V₂ h₂ v₂ W₂ h_W₂ f_W₂ x₂ V' w₁ v'₂
    hSec₁ hSec₂ hAff_V₂ hv₂_cl hv₂_h₂ hAff_W₂ hx₂_cl hx₂_fib hPb_W₂
    hAff_V' hv'₂_cl hv'₂_map

theorem weil_etale_higherDirectImage_connecting_naturality (Y B : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom Y B)
    [hc_π : (weilEtaleSitePullback π).IsContinuous B.smallEtaleTopology Y.smallEtaleTopology] :
    let pf_π := (weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
      B.smallEtaleTopology Y.smallEtaleTopology
    (∀ (I : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective I] (q : ℕ),
      1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π q I)) ∧
    (∃ (e₀ : ∀ G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u},
          CategoryTheory.Iso (pf_π.obj G) (weilEtaleHigherDirectImage π 0 G)),
      ∀ {G₁ G₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : Quiver.Hom G₁ G₂),
        CategoryTheory.CategoryStruct.comp (pf_π.map φ) (e₀ G₂).hom =
          CategoryTheory.CategoryStruct.comp (e₀ G₁).hom (weilEtaleHigherDirectImageMap π 0 φ)) ∧
    (∃ (δ_conn : ∀ {SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})},
          SC.ShortExact → ∀ (q : ℕ),
            Quiver.Hom (weilEtaleHigherDirectImage π q SC.X₃)
              (weilEtaleHigherDirectImage π (q + 1) SC.X₁)),
      (∀ {SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})}
          (hSE : SC.ShortExact) (q : ℕ),
        ∃ (h0_left : CategoryTheory.CategoryStruct.comp
              (weilEtaleHigherDirectImageMap π q SC.g) (δ_conn hSE q) = 0)
          (h0_right : CategoryTheory.CategoryStruct.comp
              (δ_conn hSE q) (weilEtaleHigherDirectImageMap π (q + 1) SC.f) = 0),
          (CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap π q SC.g) (δ_conn hSE q) h0_left).Exact ∧
          (CategoryTheory.ShortComplex.mk
            (δ_conn hSE q) (weilEtaleHigherDirectImageMap π (q + 1) SC.f) h0_right).Exact) ∧
      (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})}
          (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Φ : Quiver.Hom SC₁ SC₂) (q : ℕ),
        CategoryTheory.CategoryStruct.comp
            (weilEtaleHigherDirectImageMap π q Φ.τ₃) (δ_conn hSE₂ q) =
          CategoryTheory.CategoryStruct.comp
            (δ_conn hSE₁ q) (weilEtaleHigherDirectImageMap π (q + 1) Φ.τ₁))) :=
by
  intro pf_π
  let J_Y := Y.smallEtaleTopology
  let J_B := B.smallEtaleTopology
  let B_π := weilEtaleSitePullback π
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite B.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite B.Etale) (Opposite Y.Etale)
      AddCommGrpCat.{u}).obj B_π.op
  let Sh_B := CategoryTheory.presheafToSheaf J_B AddCommGrpCat.{u}
  let U_B := CategoryTheory.sheafToPresheaf J_B AddCommGrpCat.{u}
  let E_B := W_B.comp Sh_B
  let Φ_dir : ℕ → CategoryTheory.Functor
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_B AddCommGrpCat.{u}) :=
    fun q => (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).comp E_B
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let Sh_Y := CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
  let U_Y := CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}
  let L_tot := Free_PSh ⋙ Sh_Y
  let R_tot := U_Y ⋙ Fgt_PSh
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite Y.Etale) AddCommGrpCat.adj
  let adj_shY := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_shY
  let Z_fun : Y.Etale ⥤ CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite Y.Etale → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  refine ⟨?_, ?_, ?_⟩
  · intro I _ q hq
    obtain ⟨n, rfl⟩ : ∃ n, q = n + 1 := ⟨q - 1, (Nat.sub_add_cancel hq).symm⟩
    have hP_zero : CategoryTheory.Limits.IsZero (I.cohomologyPresheaf (n + 1)) := by
      rw [CategoryTheory.Functor.isZero_iff]
      intro W
      have hSub : Subsingleton (CategoryTheory.Abelian.Ext (Z_obj W) I (n + 1)) :=
        CategoryTheory.Abelian.Ext.subsingleton_of_injective (Z_obj W) I n
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro x
      exact @Subsingleton.elim (CategoryTheory.Abelian.Ext (Z_obj W) I (n + 1)) hSub x 0
    exact E_B.map_isZero hP_zero
  · let e_raw : ∀ (W : Opposite Y.Etale) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        CategoryTheory.Abelian.Ext (Z_obj W) G 0 ≃ ↑((U_Y.obj G).obj W) :=
      fun W G =>
        CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) G).trans
            CategoryTheory.yonedaEquiv)
    have he_add : ∀ (W : Opposite Y.Etale) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
        (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) G 0),
        e_raw W G (α₁ + α₂) = e_raw W G α₁ + e_raw W G α₂ := by
      intro W G α₁ α₂
      let V := Opposite.unop W
      let u₁ : Z_obj W ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
      let u₂ : Z_obj W ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
      have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
        map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
      let ψ : (Z_obj W ⟶ G) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_Y.obj G) :=
        fun u => adj_shY.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) G u
      have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
        dsimp [ψ]
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
          CategoryTheory.Adjunction.homEquiv_unit]
        have hmap : U_Y.map (u₁ + u₂) = U_Y.map u₁ + U_Y.map u₂ := rfl
        rw [hmap, CategoryTheory.Preadditive.comp_add]
      let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_Y.obj G) →
          ↑((U_Y.obj G).obj W) :=
        fun φ => CategoryTheory.yonedaEquiv
          (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_Y.obj G) φ)
      let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
      have hyon : ∀ (φ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_Y.obj G),
          eval_hom φ = (φ.app W) g₀ := by
        intro φ
        dsimp [eval_hom]
        rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) G 0),
          e_raw W G α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
        intro α
        dsimp [e_raw, eval_hom, ψ, adj_tot]
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        rfl
      rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
        CategoryTheory.NatTrans.app_add]
      rfl
    let e_add : ∀ (W : Opposite Y.Etale) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).obj G).obj W) ≃+
          ↑((U_Y.obj G).obj W) :=
      fun W G => AddEquiv.mk' (e_raw W G) (he_add W G)
    let θ_comp : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (W : Opposite Y.Etale),
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).obj G).obj W ≅
          (U_Y.obj G).obj W :=
      fun G W =>
        { hom := AddCommGrpCat.ofHom (e_add W G).toAddMonoidHom
          inv := AddCommGrpCat.ofHom (e_add W G).symm.toAddMonoidHom
          hom_inv_id := by ext x; exact (e_add W G).symm_apply_apply x
          inv_hom_id := by ext y; exact (e_add W G).apply_symm_apply y }
    let θ_obj : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).obj G ≅ U_Y.obj G :=
      fun G => CategoryTheory.NatIso.ofComponents (fun W => θ_comp G W) (by
        intro W₁ W₂ ω
        have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).obj G).map ω =
            ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app G := rfl
        rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) G]
        ext α
        let u : Z_obj W₁ ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        change e_raw W₂ G
            ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
          ((U_Y.obj G).map ω) (e_raw W₁ G α)
        rw [hα]
        have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
        rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        dsimp [e_raw]
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
          CategoryTheory.Adjunction.homEquiv_naturality_left,
          ← CategoryTheory.yonedaEquiv_naturality',
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rfl)
    let θ_zero : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0 ≅ U_Y :=
      CategoryTheory.NatIso.ofComponents θ_obj (by
        intro G₁ G₂ φ
        ext W α
        have hmap_φ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).map φ).app W =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map φ := rfl
