            AlgebraicGeometry.IsAffine (Fgt_Pd1.obj U₀_m).left →
            AlgebraicGeometry.Etale u₀_m →
            u₀_m ≫ ι_aff (δ₀ + 1) = (Fgt_Pd1.obj U₀_m).hom →
            ∃ (U₁_m : P_d1.left.Etale)
              (v₁_m : U₁_m ⟶ U₀_m)
              (x₁_m : ↥(Fgt_Pd1.obj U₁_m).left),
              AlgebraicGeometry.IsAffine (Fgt_Pd1.obj U₁_m).left ∧
              IsClosed ({x₁_m} : Set ↥(Fgt_Pd1.obj U₁_m).left) ∧
              (Fgt_Pd1.map v₁_m).left.base x₁_m = x₀_m ∧
              ∀ (q : ℕ), q < 2 * (δ₀ + 1) →
                ∀ z : weilEtaleLocalTorsionH P_d1.left ℓ U₁_m q,
