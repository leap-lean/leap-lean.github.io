    have hPiEvalEtale : ∀ (D : Fin r → Type u) [∀ m, CommRing (D m)] (m : Fin r),
        AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom D m))) := by
      intro D _ m
      letI : Algebra (∀ k : Fin r, D k) (D m) := (Pi.evalRingHom D m).toAlgebra
      let idem : ∀ k : Fin r, D k := Pi.single m 1
      have : IsLocalization.Away idem (D m) := by
        refine IsLocalization.Away.mk idem ?_ ?_ ?_
        · change IsUnit (Pi.single m (1 : D m) m)
          rw [Pi.single_eq_same]
          exact isUnit_one
        · intro d
          refine ⟨0, Pi.single m d, ?_⟩
          rw [pow_zero, mul_one]
          exact (Pi.single_eq_same m d).symm
        · intro x y hxy
          refine ⟨1, ?_⟩
          ext k
          simp only [pow_one, Pi.mul_apply, idem]
          by_cases hk : k = m
          · subst hk
            change (Pi.single k (1 : D k) k) * x k = (Pi.single k (1 : D k) k) * y k
            rw [Pi.single_eq_same]
            have hxy' : x k = y k := hxy
            rw [hxy']
          · rw [Pi.single_eq_of_ne hk, zero_mul, zero_mul]
      have : Algebra.Etale (∀ k : Fin r, D k) (D m) :=
        Algebra.Etale.of_isLocalizationAway idem
      exact hSpecMapEtale

    have hPiPart : ∀ (D : Fin r → Type u) [∀ m, CommRing (D m)]
        {X : AlgebraicGeometry.Scheme.{u}}
        (e_VX : X ≅ AlgebraicGeometry.Spec (CommRingCat.of (∀ m : Fin r, D m)))
        (ι_D : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (D m)) ⟶ X),
        (∀ m, ι_D m = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom D m)) ≫ e_VX.inv) →
        (∀ p : ↥X, ∃ (m₀ : Fin r) (q₀ : PrimeSpectrum (D m₀)), (ι_D m₀).base q₀ = p) ∧
        (∀ (m₁ m₂ : Fin r) (q₁ : PrimeSpectrum (D m₁)) (q₂ : PrimeSpectrum (D m₂)),
          (ι_D m₁).base q₁ = (ι_D m₂).base q₂ → m₁ = m₂) := by
      intro D _ X e_VX ι_D hι_D
      constructor
      · intro p
        let Q : PrimeSpectrum (∀ m : Fin r, D m) := e_VX.hom.base p
        have h1_sum : (∑ m : Fin r, Pi.single m (1 : D m)) = (1 : ∀ m : Fin r, D m) :=
          Finset.univ_sum_single (fun _ => 1)
        have hex_m : ∃ m₀ : Fin r, Pi.single m₀ (1 : D m₀) ∉ Q.asIdeal := by
          by_contra hall
          have h1_mem : (1 : ∀ m : Fin r, D m) ∈ Q.asIdeal := by
            rw [← h1_sum]
            exact Ideal.sum_mem Q.asIdeal
              (fun m _ => Classical.byContradiction (fun hm => hall ⟨m, hm⟩))
          exact Q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem Q.asIdeal h1_mem isUnit_one)
        obtain ⟨m₀, hm₀_not⟩ := hex_m
        have h_other_mem : ∀ k : Fin r, k ≠ m₀ → Pi.single k (1 : D k) ∈ Q.asIdeal := by
          intro k hk
          have hmul0 : Pi.single m₀ (1 : D m₀) * Pi.single k (1 : D k) = 0 := by
            ext j
            simp only [Pi.mul_apply, Pi.zero_apply]
            by_cases hj : j = m₀
            · have hne : j ≠ k := fun hjk => hk (hjk.symm.trans hj)
              rw [Pi.single_eq_of_ne hne, mul_zero]
            · rw [Pi.single_eq_of_ne hj, zero_mul]
          have hmem0 : Pi.single m₀ (1 : D m₀) * Pi.single k (1 : D k) ∈ Q.asIdeal := by
            rw [hmul0]
            exact Q.asIdeal.zero_mem
          exact (Q.isPrime.mem_or_mem hmem0).resolve_left hm₀_not
        have hker_le : RingHom.ker (Pi.evalRingHom D m₀) ≤ Q.asIdeal := by
          intro x hx
          rw [RingHom.mem_ker] at hx
          have hx_sum : x = ∑ k ∈ Finset.univ.erase m₀, x * Pi.single k (1 : D k) := by
            calc
              x = x * 1 := (mul_one x).symm
              _ = x * ∑ k : Fin r, Pi.single k (1 : D k) := by rw [h1_sum]
              _ = ∑ k : Fin r, x * Pi.single k (1 : D k) := Finset.mul_sum _ _ _
              _ = x * Pi.single m₀ (1 : D m₀) +
                    ∑ k ∈ Finset.univ.erase m₀, x * Pi.single k (1 : D k) :=
                  (Finset.add_sum_erase Finset.univ _ (Finset.mem_univ m₀)).symm
              _ = ∑ k ∈ Finset.univ.erase m₀, x * Pi.single k (1 : D k) := by
                  have h0 : x * Pi.single m₀ (1 : D m₀) = 0 := by
                    ext j
                    simp only [Pi.mul_apply, Pi.zero_apply]
                    by_cases hj : j = m₀
                    · subst hj
                      rw [Pi.single_eq_same, mul_one]
                      exact hx
                    · rw [Pi.single_eq_of_ne hj, mul_zero]
                  rw [h0, zero_add]
          rw [hx_sum]
          exact Ideal.sum_mem Q.asIdeal (fun k hk =>
            Ideal.mul_mem_left Q.asIdeal x (h_other_mem k (Finset.ne_of_mem_erase hk)))
        have hsurj_ev : Function.Surjective (Pi.evalRingHom D m₀) :=
          fun b => ⟨Pi.single m₀ b, Pi.single_eq_same m₀ b⟩
        let q₀_ideal := Ideal.map (Pi.evalRingHom D m₀) Q.asIdeal
        have : q₀_ideal.IsPrime := Ideal.map_isPrime_of_surjective hsurj_ev hker_le
        let q₀ : PrimeSpectrum (D m₀) := ⟨q₀_ideal, this⟩
        have hcomap_q₀ : PrimeSpectrum.comap (Pi.evalRingHom D m₀) q₀ = Q := by
          apply PrimeSpectrum.ext
          change Ideal.comap (Pi.evalRingHom D m₀) (Ideal.map (Pi.evalRingHom D m₀) Q.asIdeal) =
            Q.asIdeal
          rw [Ideal.comap_map_of_surjective (Pi.evalRingHom D m₀) hsurj_ev]
          exact sup_eq_left.mpr hker_le
        refine ⟨m₀, q₀, ?_⟩
        have h1 : (ι_D m₀).base q₀ =
            e_VX.inv.base (PrimeSpectrum.comap (Pi.evalRingHom D m₀) q₀) :=
          (congrArg (fun k => k.base q₀) (hι_D m₀)).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom D m₀))) e_VX.inv q₀)
        have h2 : e_VX.inv.base Q = p :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply e_VX.hom e_VX.inv p).symm.trans
            (congrArg (fun k => k.base p) e_VX.hom_inv_id)
        exact h1.trans ((congrArg e_VX.inv.base hcomap_q₀).trans h2)
      · intro m₁ m₂ q₁ q₂ heq
        by_contra hne
        have hQ_eq : PrimeSpectrum.comap (Pi.evalRingHom D m₁) q₁ =
            PrimeSpectrum.comap (Pi.evalRingHom D m₂) q₂ := by
          have h_hom₁ : ι_D m₁ ≫ e_VX.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom D m₁)) :=
            (congrArg (· ≫ e_VX.hom) (hι_D m₁)).trans
              ((CategoryTheory.Category.assoc _ e_VX.inv e_VX.hom).trans
                ((congrArg (_ ≫ ·) e_VX.inv_hom_id).trans (CategoryTheory.Category.comp_id _)))
          have h_hom₂ : ι_D m₂ ≫ e_VX.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom D m₂)) :=
            (congrArg (· ≫ e_VX.hom) (hι_D m₂)).trans
              ((CategoryTheory.Category.assoc _ e_VX.inv e_VX.hom).trans
                ((congrArg (_ ≫ ·) e_VX.inv_hom_id).trans (CategoryTheory.Category.comp_id _)))
          have hl₁ : e_VX.hom.base ((ι_D m₁).base q₁) =
              PrimeSpectrum.comap (Pi.evalRingHom D m₁) q₁ :=
            (AlgebraicGeometry.Scheme.Hom.comp_apply (ι_D m₁) e_VX.hom q₁).symm.trans
              (congrArg (fun k => k.base q₁) h_hom₁)
          have hl₂ : e_VX.hom.base ((ι_D m₂).base q₂) =
              PrimeSpectrum.comap (Pi.evalRingHom D m₂) q₂ :=
            (AlgebraicGeometry.Scheme.Hom.comp_apply (ι_D m₂) e_VX.hom q₂).symm.trans
              (congrArg (fun k => k.base q₂) h_hom₂)
          exact hl₁.symm.trans ((congrArg e_VX.hom.base heq).trans hl₂)
        have h_idem : Pi.single m₁ (1 : D m₁) ∈
            (PrimeSpectrum.comap (Pi.evalRingHom D m₁) q₁).asIdeal ↔
          Pi.single m₁ (1 : D m₁) ∈
            (PrimeSpectrum.comap (Pi.evalRingHom D m₂) q₂).asIdeal := by
          rw [hQ_eq]
        change Pi.single m₁ (1 : D m₁) m₁ ∈ q₁.asIdeal ↔
          Pi.single m₁ (1 : D m₁) m₂ ∈ q₂.asIdeal at h_idem
        rw [Pi.single_eq_same, Pi.single_eq_of_ne (Ne.symm hne)] at h_idem
        exact q₁.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q₁.asIdeal
          (h_idem.mpr q₂.asIdeal.zero_mem) isUnit_one)

    have hProdIso : ∀ (A : Type u) [CommRing A] [Algebra R₀ A] [Algebra.Etale R₀ A]
        (D : Fin r → Type u) [∀ m, CommRing (D m)] [∀ m, Algebra A (D m)]
        (e_AD : TensorProduct R₀ A B₀ ≃ₐ[A] (∀ m : Fin r, D m)),
        let f_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ AlgebraicGeometry.Spec R₀_cat :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ A))
        let U_A : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (f_A ≫ (FgtZ.obj U₀).hom)
            (P_et.comp_mem f_A (FgtZ.obj U₀).hom hSpecMapEtale U₀.prop)
        let j_A : U_A ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk f_A rfl trivial
        ∃ e_VA : (FgtY.obj (B_ν.obj U_A)).left ≅
            AlgebraicGeometry.Spec (CommRingCat.of (∀ m : Fin r, D m)),
          e_VA.inv ≫ CategoryTheory.Limits.pullback.fst U_A.hom ν =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (∀ m : Fin r, D m))) ∧
          e_VA.inv ≫ (FgtY.map (B_ν.map j_A)).left =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (e_AD.toAlgHom.toRingHom.comp
                  (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] TensorProduct R₀ A B₀).toRingHom)) ≫
              e_V₀.inv := by
      intro A _ _ _ D _ _ e_AD f_A U_A j_A
      let fst_A : (FgtY.obj (B_ν.obj U_A)).left ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
        CategoryTheory.Limits.pullback.fst U_A.hom ν
      let snd_A : (FgtY.obj (B_ν.obj U_A)).left ⟶ Y :=
        CategoryTheory.Limits.pullback.snd U_A.hom ν
      let m_A := (FgtY.map (B_ν.map j_A)).left
      have hm_fst : m_A ≫ pr₁_0 = fst_A ≫ f_A := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hm_snd : m_A ≫ pr₂_0 = snd_A := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hPb_outer : CategoryTheory.IsPullback (m_A ≫ pr₂_0) fst_A ν (f_A ≫ U₀.hom) := by
        rw [hm_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback U_A.hom ν).flip
      have hPb_right : CategoryTheory.IsPullback pr₂_0 pr₁_0 ν U₀.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U₀.hom ν).flip
      have hPb_left : CategoryTheory.IsPullback fst_A m_A f_A pr₁_0 :=
        (CategoryTheory.IsPullback.of_right hPb_outer hm_fst hPb_right).flip
      let iso₁ : (FgtY.obj (B_ν.obj U_A)).left ≅ CategoryTheory.Limits.pullback f_A pr₁_0 :=
        hPb_left.isoPullback
      let g_B₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀))
      have hg_B₀_inv : e_V₀.inv ≫ pr₁_0 = g_B₀ := by
        rw [hpr₁_0_eq, CategoryTheory.Iso.inv_hom_id_assoc]
      let iso₂ : CategoryTheory.Limits.pullback f_A pr₁_0 ≅
          CategoryTheory.Limits.pullback f_A g_B₀ :=
        { hom := CategoryTheory.Limits.pullback.map f_A pr₁_0 f_A g_B₀ (𝟙 _) e_V₀.hom (𝟙 _)
            (by simp) (by rw [CategoryTheory.Category.comp_id]; exact hpr₁_0_eq)
          inv := CategoryTheory.Limits.pullback.map f_A g_B₀ f_A pr₁_0 (𝟙 _) e_V₀.inv (𝟙 _)
            (by simp) (by rw [CategoryTheory.Category.comp_id]; exact hg_B₀_inv.symm)
          hom_inv_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((congrArg (_ ≫ ·) (CategoryTheory.Category.comp_id _)).trans
                    ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                      ((CategoryTheory.Category.comp_id _).trans
                        (CategoryTheory.Category.id_comp _).symm))))
            · exact (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.lift_snd_assoc _ _ _ _).trans
                    ((CategoryTheory.Category.assoc _ e_V₀.hom e_V₀.inv).trans
                      ((congrArg (_ ≫ ·) e_V₀.hom_inv_id).trans
                        ((CategoryTheory.Category.comp_id _).trans
                          (CategoryTheory.Category.id_comp _).symm)))))
          inv_hom_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((congrArg (_ ≫ ·) (CategoryTheory.Category.comp_id _)).trans
                    ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                      ((CategoryTheory.Category.comp_id _).trans
                        (CategoryTheory.Category.id_comp _).symm))))
            · exact (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.lift_snd_assoc _ _ _ _).trans
                    ((CategoryTheory.Category.assoc _ e_V₀.inv e_V₀.hom).trans
                      ((congrArg (_ ≫ ·) e_V₀.inv_hom_id).trans
                        ((CategoryTheory.Category.comp_id _).trans
                          (CategoryTheory.Category.id_comp _).symm))))) }
      let iso₃ : CategoryTheory.Limits.pullback f_A g_B₀ ≅
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₀ A B₀)) :=
        AlgebraicGeometry.pullbackSpecIso R₀ A B₀
      let iso_ring : CommRingCat.of (TensorProduct R₀ A B₀) ≅
          CommRingCat.of (∀ m : Fin r, D m) :=
        { hom := CommRingCat.ofHom e_AD.toRingHom
          inv := CommRingCat.ofHom e_AD.symm.toRingHom
          hom_inv_id := CommRingCat.hom_ext (RingHom.ext e_AD.symm_apply_apply)
          inv_hom_id := CommRingCat.hom_ext (RingHom.ext e_AD.apply_symm_apply) }
      let iso₄ : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₀ A B₀)) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (∀ m : Fin r, D m)) :=
        { hom := AlgebraicGeometry.Spec.map iso_ring.inv
          inv := AlgebraicGeometry.Spec.map iso_ring.hom
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, iso_ring.hom_inv_id,
              AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, iso_ring.inv_hom_id,
              AlgebraicGeometry.Spec.map_id] }
      let e_VA := iso₁ ≪≫ iso₂ ≪≫ iso₃ ≪≫ iso₄
      refine ⟨e_VA, ?_, ?_⟩
      · have h3_inv_fst : iso₃.inv ≫ CategoryTheory.Limits.pullback.fst f_A g_B₀ =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
          rw [← AlgebraicGeometry.pullbackSpecIso_hom_fst R₀ A B₀]
          exact CategoryTheory.Iso.inv_hom_id_assoc iso₃ _
        have h2_inv_fst : iso₂.inv ≫ CategoryTheory.Limits.pullback.fst f_A pr₁_0 =
            CategoryTheory.Limits.pullback.fst f_A g_B₀ := by
          dsimp only [iso₂]
          rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
        calc
          e_VA.inv ≫ fst_A
            = iso₄.inv ≫ iso₃.inv ≫ iso₂.inv ≫ (iso₁.inv ≫ fst_A) := by
              simp only [e_VA, CategoryTheory.Iso.trans_inv, CategoryTheory.Category.assoc]
          _ = iso₄.inv ≫ iso₃.inv ≫ (iso₂.inv ≫ CategoryTheory.Limits.pullback.fst f_A pr₁_0) := by
              rw [CategoryTheory.IsPullback.isoPullback_inv_fst]
          _ = iso₄.inv ≫ (iso₃.inv ≫ CategoryTheory.Limits.pullback.fst f_A g_B₀) := by
              rw [h2_inv_fst]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_AD.toRingHom) ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
              rw [h3_inv_fst]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap A (∀ m : Fin r, D m))) := by
              rw [← AlgebraicGeometry.Spec.map_comp]
              congr 1
              exact CommRingCat.hom_ext (RingHom.ext fun a => e_AD.commutes a)
      · have h3_inv_snd : iso₃.inv ≫ CategoryTheory.Limits.pullback.snd f_A g_B₀ =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
                B₀ →ₐ[R₀] TensorProduct R₀ A B₀).toRingHom) := by
          rw [← AlgebraicGeometry.pullbackSpecIso_hom_snd R₀ A B₀]
          exact CategoryTheory.Iso.inv_hom_id_assoc iso₃ _
        have h2_inv_snd : iso₂.inv ≫ CategoryTheory.Limits.pullback.snd f_A pr₁_0 =
            CategoryTheory.Limits.pullback.snd f_A g_B₀ ≫ e_V₀.inv := by
          dsimp only [iso₂]
          exact CategoryTheory.Limits.pullback.lift_snd _ _ _
        calc
          e_VA.inv ≫ m_A
            = iso₄.inv ≫ iso₃.inv ≫ iso₂.inv ≫ (iso₁.inv ≫ m_A) := by
              simp only [e_VA, CategoryTheory.Iso.trans_inv, CategoryTheory.Category.assoc]
          _ = iso₄.inv ≫ iso₃.inv ≫ (iso₂.inv ≫ CategoryTheory.Limits.pullback.snd f_A pr₁_0) := by
              rw [CategoryTheory.IsPullback.isoPullback_inv_snd]
          _ = iso₄.inv ≫ (iso₃.inv ≫ CategoryTheory.Limits.pullback.snd f_A g_B₀) ≫ e_V₀.inv := by
              rw [h2_inv_snd, CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_AD.toRingHom) ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
                    B₀ →ₐ[R₀] TensorProduct R₀ A B₀).toRingHom)) ≫ e_V₀.inv := by
              rw [h3_inv_snd, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (e_AD.toAlgHom.toRingHom.comp
                    (Algebra.TensorProduct.includeRight :
                      B₀ →ₐ[R₀] TensorProduct R₀ A B₀).toRingHom)) ≫ e_V₀.inv := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              rfl

    let f_R₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ AlgebraicGeometry.Spec R₀_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₁))
    let U₁ : Z.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (f_R₁ ≫ (FgtZ.obj U₀).hom)
        (P_et.comp_mem f_R₁ (FgtZ.obj U₀).hom hSpecMapEtale U₀.prop)
    let j₁ : U₁ ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk f_R₁ rfl trivial
    obtain ⟨e_V₁, he_V₁_fst, he_V₁_map⟩ := hProdIso R₁ B₁ e₁
    let ι₁ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₁ m)) ⟶
        (FgtY.obj (B_ν.obj U₁)).left :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom B₁ m)) ≫ e_V₁.inv
    let π₁ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₁ m)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ (B₁ m)))
    have hFin_B₁ : ∀ m : Fin r, Module.Finite R₁ (B₁ m) := by
      intro m
      have : Module.Finite R₁ (TensorProduct R₀ R₁ B₀) := inferInstance
      let proj_lin : TensorProduct R₀ R₁ B₀ →ₗ[R₁] B₁ m :=
        (LinearMap.proj m).comp e₁.toLinearMap
      have hsurj : Function.Surjective proj_lin := fun b =>
        ⟨e₁.symm (Pi.single m b), by simp [proj_lin]⟩
      exact Module.Finite.of_surjective proj_lin hsurj
    have hClosedMap_π₁ : ∀ m : Fin r, IsClosedMap (π₁ m).base := by
      intro m
      have hfin_hom : RingHom.Finite (algebraMap R₁ (B₁ m)) := by
        have := hFin_B₁ m
        rwa [RingHom.finite_algebraMap]
      have : AlgebraicGeometry.IsFinite (π₁ m) :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff _).mpr hfin_hom
      exact (π₁ m).isClosedMap
    let u₁ : PrimeSpectrum R₁ := PrimeSpectrum.comap (algebraMap R₁ Ω) (⊥ : PrimeSpectrum Ω)
    have hu₁_p₀ : f_R₁.base u₁ = p₀ := by
      change PrimeSpectrum.comap (algebraMap R₀ R₁) u₁ = p₀_pt
      rw [← PrimeSpectrum.comap_comp_apply, ← IsScalarTower.algebraMap_eq R₀ R₁ Ω, hp₀_Ω]
    have hLoc_Qm : ∀ m : Fin r, IsLocalRing (TensorProduct R₁ Ω (B₁ m)) :=
      fun m => Classical.choose (hSplit_m m).1
    have hSub_Qm : ∀ m : Fin r, Subsingleton (PrimeSpectrum (TensorProduct R₁ Ω (B₁ m))) := by
      intro m
      let Q_m := TensorProduct R₁ Ω (B₁ m)
      have : Module.Finite R₁ (B₁ m) := hFin_B₁ m
      have : Module.Finite Ω Q_m := inferInstance
      have : IsArtinianRing Q_m := IsArtinianRing.of_finite Ω Q_m
      have : IsLocalRing Q_m := hLoc_Qm m
      infer_instance
    let c_m : ∀ m : Fin r, PrimeSpectrum (TensorProduct R₁ Ω (B₁ m)) := fun m =>
      letI : IsLocalRing (TensorProduct R₁ Ω (B₁ m)) := hLoc_Qm m
      ⟨IsLocalRing.maximalIdeal (TensorProduct R₁ Ω (B₁ m)), inferInstance⟩
    let y₁ : ∀ m : Fin r, PrimeSpectrum (B₁ m) := fun m =>
      PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ Ω (B₁ m)).toRingHom
        (c_m m)
    have hy₁_fib : ∀ (m : Fin r) (y : PrimeSpectrum (B₁ m)), (π₁ m).base y = u₁ ↔ y = y₁ m := by
      intro m y
      have hSub_Ω : Subsingleton (PrimeSpectrum Ω) := inferInstance
      constructor
      · intro hy
        let g_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ Ω))
        have hu₁_eq : g_Ω.base (⊥ : PrimeSpectrum Ω) = (π₁ m).base y := hy.symm
        obtain ⟨z_pb, _, hz_snd⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := g_Ω) (g := π₁ m) (⊥ : PrimeSpectrum Ω) y hu₁_eq
        let iso_Qm := AlgebraicGeometry.pullbackSpecIso R₁ Ω (B₁ m)
        have hz_eq_cm : iso_Qm.hom.base z_pb = c_m m := (hSub_Qm m).elim _ _
        have hsnd_eq : (CategoryTheory.Limits.pullback.snd g_Ω (π₁ m)).base z_pb =
            (iso_Qm.hom ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
                  B₁ m →ₐ[R₁] TensorProduct R₁ Ω (B₁ m)).toRingHom)).base z_pb :=
          congrArg (fun k => k.base z_pb)
            (AlgebraicGeometry.pullbackSpecIso_hom_snd R₁ Ω (B₁ m)).symm
        have hy_cm :
            ((iso_Qm.hom ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
                  B₁ m →ₐ[R₁] TensorProduct R₁ Ω (B₁ m)).toRingHom)).base z_pb :
                PrimeSpectrum (B₁ m)) = y₁ m := by
          change PrimeSpectrum.comap _ (iso_Qm.hom.base z_pb) = y₁ m
          rw [hz_eq_cm]
          rfl
        exact hz_snd.symm.trans (hsnd_eq.trans hy_cm)
      · rintro rfl
        change PrimeSpectrum.comap (algebraMap R₁ (B₁ m)) (y₁ m) = u₁
        dsimp only [y₁, u₁]
        rw [← PrimeSpectrum.comap_comp_apply]
        have hcomm_ring :
            (Algebra.TensorProduct.includeRight :
              B₁ m →ₐ[R₁] TensorProduct R₁ Ω (B₁ m)).toRingHom.comp (algebraMap R₁ (B₁ m)) =
            (algebraMap Ω (TensorProduct R₁ Ω (B₁ m))).comp (algebraMap R₁ Ω) := by
          ext r₁
          exact (Algebra.TensorProduct.includeRight :
            B₁ m →ₐ[R₁] TensorProduct R₁ Ω (B₁ m)).commutes r₁
        rw [hcomm_ring, PrimeSpectrum.comap_comp_apply]
        congr 1
        exact hSub_Ω.elim _ _

    let snd₁ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₁ m)) ⟶ Y :=
      fun m => ι₁ m ≫ (FgtY.obj (B_ν.obj U₁)).hom
    let t₁_val : ↥(FgtY.obj (B_ν.obj U₁)).left → ULift.{u} (ZMod ℓ) :=
      fun p => t.1 (((FgtY.map (B_ν.map (j₁ ≫ j₀))).left).base p)
    have ht₁_open : ∀ a : ULift.{u} (ZMod ℓ), IsOpen (t₁_val ⁻¹' {a}) := fun a =>
      ((FgtY.map (B_ν.map (j₁ ≫ j₀))).left.continuous).isOpen_preimage _
        (t.1.isLocallyConstant {a})
    have ht₁_bdry : ∀ p : ↥(FgtY.obj (B_ν.obj U₁)).left,
        ((FgtY.obj (B_ν.obj U₁)).hom).base p ∉ (W_open : Set ↥Y) → t₁_val p = 0 := by
      intro p hp_not
      refine t.2 _ (fun hmem => hp_not ?_)
      have hw : ((FgtY.obj (B_ν.obj U)).hom).base (((FgtY.map (B_ν.map (j₁ ≫ j₀))).left).base p) =
          ((FgtY.obj (B_ν.obj U₁)).hom).base p :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply
          (FgtY.map (B_ν.map (j₁ ≫ j₀))).left (FgtY.obj (B_ν.obj U)).hom p).symm.trans
          (congrArg (fun k : (FgtY.obj (B_ν.obj U₁)).left ⟶ Y => k.base p)
            (FgtY.map (B_ν.map (j₁ ≫ j₀))).w)
      rwa [← hw]
    let a_m : Fin r → ULift.{u} (ZMod ℓ) := fun m => t₁_val ((ι₁ m).base (y₁ m))
    let K_val : Fin r → Set (PrimeSpectrum R₁) := fun m =>
      (π₁ m).base '' ((ι₁ m).base ⁻¹' ((t₁_val ⁻¹' {a_m m})ᶜ))
    let K_bdry : Fin r → Set (PrimeSpectrum R₁) := fun m =>
      if a_m m = 0 then ∅ else (π₁ m).base '' ((snd₁ m).base ⁻¹' ((W_open : Set ↥Y)ᶜ))
    let K_all : Set (PrimeSpectrum R₁) := (⋃ m : Fin r, K_val m) ∪ (⋃ m : Fin r, K_bdry m)
    have hClosed_Kall : IsClosed K_all := by
      refine IsClosed.union (isClosed_iUnion_of_finite fun m => ?_)
        (isClosed_iUnion_of_finite fun m => ?_)
      · exact hClosedMap_π₁ m _
          (((ht₁_open (a_m m)).isClosed_compl).preimage (ι₁ m).continuous)
      · dsimp only [K_bdry]
        split_ifs
        · exact isClosed_empty
        · exact hClosedMap_π₁ m _ ((W_open.isOpen.isClosed_compl).preimage (snd₁ m).continuous)
    have hu₁_not_K : u₁ ∉ K_all := by
      rintro (hval | hbdry)
      · obtain ⟨m, hm⟩ := Set.mem_iUnion.mp hval
        rcases hm with ⟨y, hy_ne, hy_map⟩
        have hy_eq : y = y₁ m := (hy₁_fib m y).mp hy_map
        subst hy_eq
        exact hy_ne rfl
      · obtain ⟨m, hm⟩ := Set.mem_iUnion.mp hbdry
        dsimp only [K_bdry] at hm
        split_ifs at hm with ha0
        · exact hm
        · rcases hm with ⟨y, hy_not_W, hy_map⟩
          have hy_eq : y = y₁ m := (hy₁_fib m y).mp hy_map
          subst hy_eq
          exact ha0 (ht₁_bdry ((ι₁ m).base (y₁ m)) hy_not_W)
    let O_R₁ : TopologicalSpace.Opens (PrimeSpectrum R₁) := ⟨K_allᶜ, hClosed_Kall.isOpen_compl⟩
    obtain ⟨_, ⟨f₂, rfl⟩, hu₁_f₂, hf₂_sub⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens
        (U := O_R₁) (x := u₁) hu₁_not_K
    have hf₂_ne : algebraMap R₁ Ω f₂ ≠ 0 := by
      rw [PrimeSpectrum.mem_basicOpen] at hu₁_f₂
      exact hu₁_f₂

    let R₂ := Localization.Away f₂
    have : Algebra.Etale R₁ R₂ := Algebra.Etale.of_isLocalizationAway f₂
    have : Algebra.Etale R₀ R₂ := Algebra.Etale.comp R₀ R₁ R₂
    let φ_R₂_Ω : R₂ →+* Ω := IsLocalization.Away.lift f₂ (IsUnit.mk0 (algebraMap R₁ Ω f₂) hf₂_ne)
    letI : Algebra R₂ Ω := φ_R₂_Ω.toAlgebra
    have : IsScalarTower R₁ R₂ Ω :=
      IsScalarTower.of_algebraMap_eq (fun r₁ => (IsLocalization.Away.lift_eq f₂ _ r₁).symm)
    let B₂ : Fin r → Type u := fun m => TensorProduct R₁ R₂ (B₁ m)
    let e₂ : TensorProduct R₀ R₂ B₀ ≃ₐ[R₂] (∀ m : Fin r, B₂ m) :=
      (Algebra.TensorProduct.cancelBaseChange R₀ R₁ R₂ R₂ B₀).symm.trans
        ((Algebra.TensorProduct.congr (AlgEquiv.refl : R₂ ≃ₐ[R₂] R₂) e₁).trans
          (Algebra.TensorProduct.piRight R₁ R₂ R₂ B₁))
    let f_R₂_₀ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶ AlgebraicGeometry.Spec R₀_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₂))
    let f_R₂_₁ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ R₂))
    let U₂ : Z.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (f_R₂_₀ ≫ (FgtZ.obj U₀).hom)
        (P_et.comp_mem f_R₂_₀ (FgtZ.obj U₀).hom hSpecMapEtale U₀.prop)
    let j₂_₀ : U₂ ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk f_R₂_₀ rfl trivial
    have hf_R₂_fac : f_R₂_₀ = f_R₂_₁ ≫ f_R₁ := by
      dsimp only [f_R₂_₀, f_R₂_₁, f_R₁]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    let j₂ : U₂ ⟶ U₁ :=
      CategoryTheory.MorphismProperty.Over.homMk f_R₂_₁
        ((CategoryTheory.Category.assoc f_R₂_₁ f_R₁ (FgtZ.obj U₀).hom).symm.trans
          (congrArg (· ≫ (FgtZ.obj U₀).hom) hf_R₂_fac.symm))
        trivial
    obtain ⟨e_V₂, he_V₂_fst, he_V₂_map⟩ := hProdIso R₂ B₂ e₂
    let ι₂ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₂ m)) ⟶
        (FgtY.obj (B_ν.obj U₂)).left :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom B₂ m)) ≫ e_V₂.inv
    let π₂ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₂ m)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₂) :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₂ (B₂ m)))
    let bc₁₂ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₂ m)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (B₁ m)) :=
      fun m => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] B₂ m).toRingHom)
    have hι₂_fst : ∀ m : Fin r,
        ι₂ m ≫ CategoryTheory.Limits.pullback.fst U₂.hom ν = π₂ m := fun m =>
      (CategoryTheory.Category.assoc _ e_V₂.inv _).trans
        ((congrArg (_ ≫ ·) he_V₂_fst).trans
          ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            (congrArg AlgebraicGeometry.Spec.map
              (CommRingCat.hom_ext (RingHom.ext fun _ => rfl)))))
    have hι₁_fst : ∀ m : Fin r,
        ι₁ m ≫ CategoryTheory.Limits.pullback.fst U₁.hom ν = π₁ m := fun m =>
      (CategoryTheory.Category.assoc _ e_V₁.inv _).trans
        ((congrArg (_ ≫ ·) he_V₁_fst).trans
          ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            (congrArg AlgebraicGeometry.Spec.map
              (CommRingCat.hom_ext (RingHom.ext fun _ => rfl)))))
    have hι₂_j₂ : ∀ m : Fin r,
        ι₂ m ≫ (FgtY.map (B_ν.map j₂)).left = bc₁₂ m ≫ ι₁ m := by
      intro m
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (ι₂ m ≫ (FgtY.map (B_ν.map j₂)).left) ≫
            CategoryTheory.Limits.pullback.fst U₁.hom ν =
          (bc₁₂ m ≫ ι₁ m) ≫ CategoryTheory.Limits.pullback.fst U₁.hom ν
        have h_step1 : (ι₂ m ≫ (FgtY.map (B_ν.map j₂)).left) ≫
            CategoryTheory.Limits.pullback.fst U₁.hom ν = π₂ m ≫ f_R₂_₁ :=
          (CategoryTheory.Category.assoc (ι₂ m) _ _).trans
            ((congrArg (ι₂ m ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Category.assoc (ι₂ m) _ f_R₂_₁).symm.trans
                (congrArg (· ≫ f_R₂_₁) (hι₂_fst m))))
        have h_step2 : π₂ m ≫ f_R₂_₁ = bc₁₂ m ≫ π₁ m := by
          dsimp only [π₂, f_R₂_₁, bc₁₂, π₁]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          congr 1
          exact CommRingCat.hom_ext (RingHom.ext fun r₁ =>
            ((Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] B₂ m).commutes r₁).symm)
        exact h_step1.trans (h_step2.trans
          ((congrArg (bc₁₂ m ≫ ·) (hι₁_fst m).symm).trans
            (CategoryTheory.Category.assoc (bc₁₂ m) (ι₁ m) _).symm))
      · change (ι₂ m ≫ (FgtY.map (B_ν.map j₂)).left) ≫
            CategoryTheory.Limits.pullback.snd U₁.hom ν =
          (bc₁₂ m ≫ ι₁ m) ≫ CategoryTheory.Limits.pullback.snd U₁.hom ν
        have hm_snd₂ : (FgtY.map (B_ν.map j₂)).left ≫
            CategoryTheory.Limits.pullback.snd U₁.hom ν =
            (FgtY.map (B_ν.map j₂_₀)).left ≫ pr₂_0 :=
          (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        have hm_snd₁ : CategoryTheory.Limits.pullback.snd U₁.hom ν =
            (FgtY.map (B_ν.map j₁)).left ≫ pr₂_0 :=
          (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        let f_ev₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom B₂ m))
        let f_e₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((e₂ : TensorProduct R₀ R₂ B₀ →+* ∀ k, B₂ k).comp
            (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] TensorProduct R₀ R₂ B₀).toRingHom))
        let f_ev₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom B₁ m))
        let f_e₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((e₁ : TensorProduct R₀ R₁ B₀ →+* ∀ k, B₁ k).comp
            (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] TensorProduct R₀ R₁ B₀).toRingHom))
        have hLHS : (ι₂ m ≫ (FgtY.map (B_ν.map j₂)).left) ≫
            CategoryTheory.Limits.pullback.snd U₁.hom ν =
            ((f_ev₂ ≫ f_e₂) ≫ e_V₀.inv) ≫ pr₂_0 :=
          (CategoryTheory.Category.assoc (ι₂ m) _ _).trans
            ((congrArg (ι₂ m ≫ ·) hm_snd₂).trans
              ((CategoryTheory.Category.assoc (ι₂ m) _ pr₂_0).symm.trans
                (congrArg (· ≫ pr₂_0)
                  ((CategoryTheory.Category.assoc f_ev₂ e_V₂.inv _).trans
                    ((congrArg (f_ev₂ ≫ ·) he_V₂_map).trans
                      (CategoryTheory.Category.assoc f_ev₂ f_e₂ e_V₀.inv).symm)))))
        have hRHS : (bc₁₂ m ≫ ι₁ m) ≫
            CategoryTheory.Limits.pullback.snd U₁.hom ν =
            ((bc₁₂ m ≫ (f_ev₁ ≫ f_e₁)) ≫ e_V₀.inv) ≫ pr₂_0 :=
          (congrArg ((bc₁₂ m ≫ ι₁ m) ≫ ·) hm_snd₁).trans
            ((CategoryTheory.Category.assoc (bc₁₂ m ≫ ι₁ m) _ pr₂_0).symm.trans
              (congrArg (· ≫ pr₂_0)
                ((CategoryTheory.Category.assoc (bc₁₂ m) (ι₁ m) _).trans
                  ((congrArg (bc₁₂ m ≫ ·)
                    ((CategoryTheory.Category.assoc f_ev₁ e_V₁.inv _).trans
                      ((congrArg (f_ev₁ ≫ ·) he_V₁_map).trans
                        (CategoryTheory.Category.assoc f_ev₁ f_e₁ e_V₀.inv).symm))).trans
                    (CategoryTheory.Category.assoc (bc₁₂ m) (f_ev₁ ≫ f_e₁) e_V₀.inv).symm))))
        have hSpecEq : f_ev₂ ≫ f_e₂ = bc₁₂ m ≫ (f_ev₁ ≫ f_e₁) := by
          dsimp only [f_ev₂, f_e₂, bc₁₂, f_ev₁, f_e₁]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Spec.map_comp]
          congr 1
        exact hLHS.trans ((congrArg (fun k => (k ≫ e_V₀.inv) ≫ pr₂_0) hSpecEq).trans hRHS.symm)

    have hf_R₂_not_K : ∀ q₂ : PrimeSpectrum R₂, f_R₂_₁.base q₂ ∉ K_all := by
      intro q₂
      have hmem_basic : (f_R₂_₁.base q₂ : PrimeSpectrum R₁) ∈ PrimeSpectrum.basicOpen f₂ := by
        change PrimeSpectrum.comap (algebraMap R₁ R₂) q₂ ∈ PrimeSpectrum.basicOpen f₂
        rw [PrimeSpectrum.mem_basicOpen]
        change algebraMap R₁ R₂ f₂ ∉ q₂.asIdeal
        exact fun hmem => q₂.isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem q₂.asIdeal hmem (IsLocalization.Away.algebraMap_isUnit f₂))
      exact hf₂_sub hmem_basic
    have hConst_B₂ : ∀ (m : Fin r) (y₂ : PrimeSpectrum (B₂ m)),
        t₁_val ((ι₁ m).base ((bc₁₂ m).base y₂)) = a_m m := by
      intro m y₂
      by_contra hne
      have h_comm_pt : (π₁ m).base ((bc₁₂ m).base y₂) = f_R₂_₁.base ((π₂ m).base y₂) := by
        have hcomm : bc₁₂ m ≫ π₁ m = π₂ m ≫ f_R₂_₁ := by
          dsimp only [bc₁₂, π₁, π₂, f_R₂_₁]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
          congr 1
          exact CommRingCat.hom_ext (RingHom.ext fun r₁ =>
            (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] B₂ m).commutes r₁)
        exact (AlgebraicGeometry.Scheme.Hom.comp_apply (bc₁₂ m) (π₁ m) y₂).symm.trans
          ((congrArg (fun k => k.base y₂) hcomm).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply (π₂ m) f_R₂_₁ y₂))
      have hin_Kval : f_R₂_₁.base ((π₂ m).base y₂) ∈ K_val m :=
        ⟨(bc₁₂ m).base y₂, hne, h_comm_pt⟩
      exact hf_R₂_not_K ((π₂ m).base y₂) (Or.inl (Set.mem_iUnion.mpr ⟨m, hin_Kval⟩))

    let snd₂ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₂ m)) ⟶ Y :=
      fun m => ι₂ m ≫ (FgtY.obj (B_ν.obj U₂)).hom
    have hsnd₂_range : ∀ m : Fin r, a_m m ≠ 0 →
        Set.range (snd₂ m).base ⊆ Set.range W_open.ι.base := by
      intro m hm_ne
      rw [AlgebraicGeometry.Scheme.Opens.range_ι W_open]
      rintro _ ⟨y₂, rfl⟩
      by_contra hnot_W
      have hsnd_eq : (snd₂ m).base y₂ = (snd₁ m).base ((bc₁₂ m).base y₂) := by
        have hhom_eq : snd₂ m = bc₁₂ m ≫ snd₁ m := by
          dsimp only [snd₂, snd₁]
          have hw : (FgtY.map (B_ν.map j₂)).left ≫ (FgtY.obj (B_ν.obj U₁)).hom =
              (FgtY.obj (B_ν.obj U₂)).hom := (FgtY.map (B_ν.map j₂)).w
          rw [← hw, ← CategoryTheory.Category.assoc, hι₂_j₂, CategoryTheory.Category.assoc]
        exact congrArg (fun k => k.base y₂) hhom_eq
      rw [hsnd_eq] at hnot_W
      have h_comm_pt : (π₁ m).base ((bc₁₂ m).base y₂) = f_R₂_₁.base ((π₂ m).base y₂) := by
        have hcomm : bc₁₂ m ≫ π₁ m = π₂ m ≫ f_R₂_₁ := by
          dsimp only [bc₁₂, π₁, π₂, f_R₂_₁]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
          congr 1
          exact CommRingCat.hom_ext (RingHom.ext fun r₁ =>
            (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] B₂ m).commutes r₁)
        exact (AlgebraicGeometry.Scheme.Hom.comp_apply (bc₁₂ m) (π₁ m) y₂).symm.trans
          ((congrArg (fun k => k.base y₂) hcomm).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply (π₂ m) f_R₂_₁ y₂))
      have hin_Kbdry : f_R₂_₁.base ((π₂ m).base y₂) ∈ K_bdry m := by
        dsimp only [K_bdry]
        rw [ite_eq_right_iff.mpr (fun h => False.elim (hm_ne h))]
        exact ⟨(bc₁₂ m).base y₂, hnot_W, h_comm_pt⟩
      exact hf_R₂_not_K ((π₂ m).base y₂) (Or.inr (Set.mem_iUnion.mpr ⟨m, hin_Kbdry⟩))

    let S_act : Finset (Fin r) := Finset.univ.filter (fun m => a_m m ≠ 0)
    let w_open₂ : ∀ m : ↥S_act,
        AlgebraicGeometry.Spec (CommRingCat.of (B₂ m.1)) ⟶ W_open.toScheme :=
      fun m => AlgebraicGeometry.IsOpenImmersion.lift W_open.ι (snd₂ m.1)
        (hsnd₂_range m.1 (Finset.mem_filter.mp m.2).2)
    let w_hat₂ : ∀ m : ↥S_act,
        AlgebraicGeometry.Spec (CommRingCat.of (B₂ m.1)) ⟶ (FgtZ.obj W_diag).left :=
      fun m => w_open₂ m ≫ e_W.inv
    have hw_hat₂_comm : ∀ m : ↥S_act,
        w_hat₂ m ≫ (FgtZ.obj W_diag).hom = π₂ m.1 ≫ (FgtZ.obj U₂).hom := by
      intro m
      calc
        (w_open₂ m ≫ e_W.inv) ≫ (FgtZ.obj W_diag).hom
          = w_open₂ m ≫ (e_W.inv ≫ (FgtZ.obj W_diag).hom) := CategoryTheory.Category.assoc _ _ _
        _ = w_open₂ m ≫ W_open.ι ≫ ν := by rw [h_comm_σ]
        _ = (w_open₂ m ≫ W_open.ι) ≫ ν := (CategoryTheory.Category.assoc _ _ _).symm
        _ = snd₂ m.1 ≫ ν := by rw [AlgebraicGeometry.IsOpenImmersion.lift_fac]
        _ = ι₂ m.1 ≫ ((FgtY.obj (B_ν.obj U₂)).hom ≫ ν) := CategoryTheory.Category.assoc _ _ _
        _ = ι₂ m.1 ≫ (CategoryTheory.Limits.pullback.fst U₂.hom ν ≫ U₂.hom) := by
            exact congrArg (ι₂ m.1 ≫ ·) (CategoryTheory.Limits.pullback.condition).symm
        _ = π₂ m.1 ≫ (FgtZ.obj U₂).hom :=
            (CategoryTheory.Category.assoc (ι₂ m.1) _ U₂.hom).symm.trans
              (congrArg (· ≫ U₂.hom) (hι₂_fst m.1))
    have hEt_B₂ : ∀ m : ↥S_act, Algebra.Etale R₂ (B₂ m.1) := by
      intro m
      have : AlgebraicGeometry.Etale (ι₂ m.1) := by
        dsimp only [ι₂]
        have := hPiEvalEtale B₂ m.1
        infer_instance
      have : AlgebraicGeometry.Etale (FgtY.obj (B_ν.obj U₂)).hom := (B_ν.obj U₂).prop
      have hEt_snd₂ : AlgebraicGeometry.Etale (snd₂ m.1) := by
        dsimp only [snd₂]
        infer_instance
      have : AlgebraicGeometry.Etale (w_open₂ m) :=
        CategoryTheory.MorphismProperty.of_postcomp P_et
          (w_open₂ m) W_open.ι (inferInstance : AlgebraicGeometry.Etale W_open.ι)
          (by rw [AlgebraicGeometry.IsOpenImmersion.lift_fac]; exact hEt_snd₂)
      have : AlgebraicGeometry.Etale (FgtZ.obj W_diag).hom := W_diag.prop
      have hEt_what_hom : AlgebraicGeometry.Etale (w_hat₂ m ≫ (FgtZ.obj W_diag).hom) := by
        dsimp only [w_hat₂]
        infer_instance
      have hEt_π₂ : P_et (π₂ m.1) :=
        CategoryTheory.MorphismProperty.of_postcomp P_et
          (π₂ m.1) (FgtZ.obj U₂).hom U₂.prop (by rw [← hw_hat₂_comm m]; exact hEt_what_hom)
      exact RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mp hEt_π₂)
    have hLoc_B₂ : ∀ m : Fin r, IsLocalRing (TensorProduct R₂ Ω (B₂ m)) := by
      intro m
      have : IsLocalRing (TensorProduct R₁ Ω (B₁ m)) := hLoc_Qm m
      exact RingEquiv.isLocalRing
        (Algebra.TensorProduct.cancelBaseChange R₁ R₂ Ω Ω (B₁ m)).symm.toRingEquiv
    have hEx_fm : ∀ m : ↥S_act,
        ∃ f : R₂, algebraMap R₂ Ω f ≠ 0 ∧
          ∀ (R' : Type u) [CommRing R'] [Algebra R₂ R'],
            IsUnit (algebraMap R₂ R' f) →
            Function.Bijective (Algebra.TensorProduct.includeLeft :
              R' →ₐ[R₂] TensorProduct R₂ R' (B₂ m.1)) := by
      intro m
      have : Module.Finite R₁ (B₁ m.1) := hFin_B₁ m.1
      have : Module.Finite R₂ (B₂ m.1) := inferInstance
      have : Algebra.Etale R₂ (B₂ m.1) := hEt_B₂ m
      exact hAwayBij R₂ (B₂ m.1) Ω (hLoc_B₂ m.1)

    obtain ⟨f_act, hf_act_spec⟩ := Classical.axiomOfChoice hEx_fm
    have hf_act_ne : ∀ m : ↥S_act, algebraMap R₂ Ω (f_act m) ≠ 0 :=
      fun m => (hf_act_spec m).1
    have hf_act_bij : ∀ (m : ↥S_act) (R' : Type u) [CommRing R'] [Algebra R₂ R'],
        IsUnit (algebraMap R₂ R' (f_act m)) →
        Function.Bijective (Algebra.TensorProduct.includeLeft :
          R' →ₐ[R₂] TensorProduct R₂ R' (B₂ m.1)) :=
      fun m => (hf_act_spec m).2
    have hex_f₃ : ∃ f₃ : R₂, algebraMap R₂ Ω f₃ ≠ 0 ∧ ∀ m : ↥S_act, f_act m ∣ f₃ := by
      refine ⟨∏ m ∈ S_act.attach, f_act m, ?_, ?_⟩
      · rw [map_prod]
        exact Finset.prod_ne_zero_iff.mpr (fun m _ => hf_act_ne m)
      · intro m
        exact Finset.dvd_prod_of_mem f_act (Finset.mem_attach S_act m)
    obtain ⟨f₃, hf₃_ne, hf₃_dvd⟩ := hex_f₃
    have hex_R₃ : ∃ (R₃ : Type u) (_ : CommRing R₃) (_ : Algebra R₀ R₃) (_ : Algebra R₂ R₃)
        (_ : Algebra.Etale R₀ R₃) (_ : IsScalarTower R₀ R₂ R₃)
        (B₃ : Fin r → Type u) (_ : ∀ m, CommRing (B₃ m)) (_ : ∀ m, Algebra R₃ (B₃ m))
        (e₃ : TensorProduct R₀ R₃ B₀ ≃ₐ[R₃] (∀ m : Fin r, B₃ m))
        (φ_bc₂₃ : ∀ m : Fin r, B₂ m →+* B₃ m),
        (∃ u_star_pt : PrimeSpectrum R₃,
          PrimeSpectrum.comap (algebraMap R₀ R₃) u_star_pt = p₀_pt) ∧
        (∀ (m : Fin r) (r₂ : R₂),
          φ_bc₂₃ m (algebraMap R₂ (B₂ m) r₂) = algebraMap R₃ (B₃ m) (algebraMap R₂ R₃ r₂)) ∧
        (∀ (m : Fin r) (b₀ : B₀),
          (e₃ ((1 : R₃) ⊗ₜ[R₀] b₀)) m = φ_bc₂₃ m ((e₂ ((1 : R₂) ⊗ₜ[R₀] b₀)) m)) ∧
        (∀ m : ↥S_act, Function.Bijective (algebraMap R₃ (B₃ m.1))) := by
      let R₃_loc := Localization.Away f₃
      have : Algebra.Etale R₂ R₃_loc := Algebra.Etale.of_isLocalizationAway f₃
      have : Algebra.Etale R₁ R₃_loc := Algebra.Etale.comp R₁ R₂ R₃_loc
      have hEt₀₃ : Algebra.Etale R₀ R₃_loc := Algebra.Etale.comp R₀ R₁ R₃_loc
      let φ_R₃_Ω : R₃_loc →+* Ω :=
        IsLocalization.Away.lift f₃ (IsUnit.mk0 (algebraMap R₂ Ω f₃) hf₃_ne)
      let u_pt : PrimeSpectrum R₃_loc := PrimeSpectrum.comap φ_R₃_Ω (⊥ : PrimeSpectrum Ω)
      have h_alg_eq : φ_R₃_Ω.comp (algebraMap R₀ R₃_loc) = algebraMap R₀ Ω := by
        ext r₀
        change φ_R₃_Ω (algebraMap R₀ R₃_loc r₀) = algebraMap R₀ Ω r₀
        rw [IsScalarTower.algebraMap_apply R₀ R₂ R₃_loc r₀]
        have h_lift₃ : φ_R₃_Ω (algebraMap R₂ R₃_loc (algebraMap R₀ R₂ r₀)) =
            algebraMap R₂ Ω (algebraMap R₀ R₂ r₀) :=
          IsLocalization.Away.lift_eq f₃ _ (algebraMap R₀ R₂ r₀)
        rw [h_lift₃, IsScalarTower.algebraMap_apply R₀ R₁ R₂ r₀,
          ← IsScalarTower.algebraMap_apply R₁ R₂ Ω _,
          ← IsScalarTower.algebraMap_apply R₀ R₁ Ω r₀]
      have hp₀_eq : PrimeSpectrum.comap (algebraMap R₀ R₃_loc) u_pt = p₀_pt := by
        rw [← PrimeSpectrum.comap_comp_apply, h_alg_eq, hp₀_Ω]
      let B₃_loc : Fin r → Type u := fun m => TensorProduct R₁ R₃_loc (B₁ m)
      let e₃_loc : TensorProduct R₀ R₃_loc B₀ ≃ₐ[R₃_loc] (∀ m : Fin r, B₃_loc m) :=
        (Algebra.TensorProduct.cancelBaseChange R₀ R₁ R₃_loc R₃_loc B₀).symm.trans
          ((Algebra.TensorProduct.congr (AlgEquiv.refl : R₃_loc ≃ₐ[R₃_loc] R₃_loc) e₁).trans
            (Algebra.TensorProduct.piRight R₁ R₃_loc R₃_loc B₁))
      let φ_bc₂₃_loc : ∀ m : Fin r, B₂ m →+* B₃_loc m := fun m =>
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ R₃_loc)
          (AlgHom.id R₁ (B₁ m))).toRingHom
      refine ⟨R₃_loc, inferInstance, inferInstance, inferInstance, hEt₀₃, inferInstance,
        B₃_loc, inferInstance, inferInstance, e₃_loc, φ_bc₂₃_loc, ⟨u_pt, hp₀_eq⟩, ?_, ?_, ?_⟩
      · intro m r₂
        rfl
      · intro m b₀
        change (1 : R₃_loc) ⊗ₜ[R₁] ((e₁ ((1 : R₁) ⊗ₜ[R₀] b₀)) m) =
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ R₃_loc) (AlgHom.id R₁ (B₁ m)))
            ((1 : R₂) ⊗ₜ[R₁] ((e₁ ((1 : R₁) ⊗ₜ[R₀] b₀)) m))
        simp
      · intro m
        have hunit_fm : IsUnit (algebraMap R₂ R₃_loc (f_act m)) :=
          isUnit_of_dvd_unit (map_dvd (algebraMap R₂ R₃_loc) (hf₃_dvd m))
            (IsLocalization.Away.algebraMap_isUnit f₃)
        let e_canc_m : TensorProduct R₂ R₃_loc (B₂ m.1) ≃ₐ[R₃_loc] B₃_loc m.1 :=
          Algebra.TensorProduct.cancelBaseChange R₁ R₂ R₃_loc R₃_loc (B₁ m.1)
        have hbij_comp : Function.Bijective
            (fun r₃ : R₃_loc => e_canc_m
              ((Algebra.TensorProduct.includeLeft :
                R₃_loc →ₐ[R₂] TensorProduct R₂ R₃_loc (B₂ m.1)) r₃)) :=
          e_canc_m.bijective.comp (hf_act_bij m R₃_loc hunit_fm)
        have heq_app : ∀ r₃ : R₃_loc, e_canc_m
            ((Algebra.TensorProduct.includeLeft :
              R₃_loc →ₐ[R₂] TensorProduct R₂ R₃_loc (B₂ m.1)) r₃) =
            (r₃ ⊗ₜ[R₁] (1 : B₁ m.1) : B₃_loc m.1) := by
          intro r₃
          change e_canc_m (r₃ ⊗ₜ[R₂] ((1 : R₂) ⊗ₜ[R₁] (1 : B₁ m.1))) =
            r₃ ⊗ₜ[R₁] (1 : B₁ m.1)
          rw [Algebra.TensorProduct.cancelBaseChange_tmul, Algebra.smul_def, map_one, one_mul]
        refine ⟨fun r₁ r₂ hr => hbij_comp.1 ((heq_app r₁).trans (hr.trans (heq_app r₂).symm)),
          fun b => ?_⟩
        obtain ⟨r₃, hr₃⟩ := hbij_comp.2 b
        exact ⟨r₃, (heq_app r₃).symm.trans hr₃⟩
    obtain ⟨R₃, hRingR₃, hAlgR₀R₃, hAlgR₂R₃, hEtR₀R₃, hTow₀₂₃,
      B₃, hRingB₃, hAlgR₃B₃, e₃, φ_bc₂₃, ⟨u_star_pt, hp₀_R₃⟩,
      hφ_bc₂₃_alg, hφ_bc₂₃_e, hBij_B₃⟩ := hex_R₃
    letI : CommRing R₃ := hRingR₃
    letI : Algebra R₀ R₃ := hAlgR₀R₃
    letI : Algebra R₂ R₃ := hAlgR₂R₃
    have : Algebra.Etale R₀ R₃ := hEtR₀R₃
    have : IsScalarTower R₀ R₂ R₃ := hTow₀₂₃
    letI : ∀ m : Fin r, CommRing (B₃ m) := hRingB₃
    letI : ∀ m : Fin r, Algebra R₃ (B₃ m) := hAlgR₃B₃
    let f_R₃_₀ : AlgebraicGeometry.Spec (CommRingCat.of R₃) ⟶ AlgebraicGeometry.Spec R₀_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₃))
    let f_R₃_₂ : AlgebraicGeometry.Spec (CommRingCat.of R₃) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₂) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₂ R₃))
    let U_star : Z.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (f_R₃_₀ ≫ (FgtZ.obj U₀).hom)
        (P_et.comp_mem f_R₃_₀ (FgtZ.obj U₀).hom hSpecMapEtale U₀.prop)
    let j₃_₀ : U_star ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk f_R₃_₀ rfl trivial
    have hf_R₃_fac : f_R₃_₀ = f_R₃_₂ ≫ f_R₂_₀ := by
      dsimp only [f_R₃_₀, f_R₃_₂, f_R₂_₀]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq R₀ R₂ R₃]
    let j₃ : U_star ⟶ U₂ :=
      CategoryTheory.MorphismProperty.Over.homMk f_R₃_₂
        ((CategoryTheory.Category.assoc f_R₃_₂ f_R₂_₀ (FgtZ.obj U₀).hom).symm.trans
          (congrArg (· ≫ (FgtZ.obj U₀).hom) hf_R₃_fac.symm))
        trivial
    let g_star : U_star ⟶ U := j₃_₀ ≫ j₀
    let u_star : ↥(FgtZ.obj U_star).left := u_star_pt
    have hu_star_map : (FgtZ.map g_star).left.base u_star = u₀ := by
      have hp₀_eq : f_R₃_₀.base u_star_pt = p₀ := hp₀_R₃
      change j_aff.base (f_R₃_₀.base u_star_pt) = u₀
      rw [hp₀_eq, hp₀_map]

    obtain ⟨e_V₃, he_V₃_fst, he_V₃_map⟩ := hProdIso R₃ B₃ e₃
    let ι₃ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₃ m)) ⟶
        (FgtY.obj (B_ν.obj U_star)).left :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom B₃ m)) ≫ e_V₃.inv
    let π₃ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₃ m)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₃) :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₃ (B₃ m)))
    let bc₂₃ : ∀ m : Fin r, AlgebraicGeometry.Spec (CommRingCat.of (B₃ m)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (B₂ m)) :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_bc₂₃ m))
    have hι₃_fst : ∀ m : Fin r,
        ι₃ m ≫ CategoryTheory.Limits.pullback.fst U_star.hom ν = π₃ m := fun m =>
      (CategoryTheory.Category.assoc _ e_V₃.inv _).trans
        ((congrArg (_ ≫ ·) he_V₃_fst).trans
          ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            (congrArg AlgebraicGeometry.Spec.map
              (CommRingCat.hom_ext (RingHom.ext fun _ => rfl)))))
    have hbc₂₃_π : ∀ m : Fin r, π₃ m ≫ f_R₃_₂ = bc₂₃ m ≫ π₂ m := by
      intro m
      dsimp only [π₃, f_R₃_₂, bc₂₃, π₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      exact CommRingCat.hom_ext (RingHom.ext fun r₂ => (hφ_bc₂₃_alg m r₂).symm)
    have hι₃_j₃ : ∀ m : Fin r,
        ι₃ m ≫ (FgtY.map (B_ν.map j₃)).left = bc₂₃ m ≫ ι₂ m := by
      intro m
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (ι₃ m ≫ (FgtY.map (B_ν.map j₃)).left) ≫
            CategoryTheory.Limits.pullback.fst U₂.hom ν =
          (bc₂₃ m ≫ ι₂ m) ≫ CategoryTheory.Limits.pullback.fst U₂.hom ν
        have h_step1 : (ι₃ m ≫ (FgtY.map (B_ν.map j₃)).left) ≫
            CategoryTheory.Limits.pullback.fst U₂.hom ν = π₃ m ≫ f_R₃_₂ :=
          (CategoryTheory.Category.assoc (ι₃ m) _ _).trans
            ((congrArg (ι₃ m ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Category.assoc (ι₃ m) _ f_R₃_₂).symm.trans
                (congrArg (· ≫ f_R₃_₂) (hι₃_fst m))))
        exact h_step1.trans ((hbc₂₃_π m).trans
          ((congrArg (bc₂₃ m ≫ ·) (hι₂_fst m).symm).trans
            (CategoryTheory.Category.assoc (bc₂₃ m) (ι₂ m) _).symm))
      · change (ι₃ m ≫ (FgtY.map (B_ν.map j₃)).left) ≫
            CategoryTheory.Limits.pullback.snd U₂.hom ν =
          (bc₂₃ m ≫ ι₂ m) ≫ CategoryTheory.Limits.pullback.snd U₂.hom ν
        have hm_snd₃ : (FgtY.map (B_ν.map j₃)).left ≫
            CategoryTheory.Limits.pullback.snd U₂.hom ν =
            (FgtY.map (B_ν.map j₃_₀)).left ≫ pr₂_0 :=
          (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        have hm_snd₂ : CategoryTheory.Limits.pullback.snd U₂.hom ν =
            (FgtY.map (B_ν.map j₂_₀)).left ≫ pr₂_0 :=
          (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        let f_ev₃ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom B₃ m))
        let f_e₃ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((e₃ : TensorProduct R₀ R₃ B₀ →+* ∀ k, B₃ k).comp
            (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] TensorProduct R₀ R₃ B₀).toRingHom))
        let f_ev₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom B₂ m))
        let f_e₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((e₂ : TensorProduct R₀ R₂ B₀ →+* ∀ k, B₂ k).comp
            (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] TensorProduct R₀ R₂ B₀).toRingHom))
        have hLHS : (ι₃ m ≫ (FgtY.map (B_ν.map j₃)).left) ≫
            CategoryTheory.Limits.pullback.snd U₂.hom ν =
            ((f_ev₃ ≫ f_e₃) ≫ e_V₀.inv) ≫ pr₂_0 :=
          (CategoryTheory.Category.assoc (ι₃ m) _ _).trans
            ((congrArg (ι₃ m ≫ ·) hm_snd₃).trans
              ((CategoryTheory.Category.assoc (ι₃ m) _ pr₂_0).symm.trans
                (congrArg (· ≫ pr₂_0)
                  ((CategoryTheory.Category.assoc f_ev₃ e_V₃.inv _).trans
                    ((congrArg (f_ev₃ ≫ ·) he_V₃_map).trans
                      (CategoryTheory.Category.assoc f_ev₃ f_e₃ e_V₀.inv).symm)))))
        have hRHS : (bc₂₃ m ≫ ι₂ m) ≫
            CategoryTheory.Limits.pullback.snd U₂.hom ν =
            ((bc₂₃ m ≫ (f_ev₂ ≫ f_e₂)) ≫ e_V₀.inv) ≫ pr₂_0 :=
          (congrArg ((bc₂₃ m ≫ ι₂ m) ≫ ·) hm_snd₂).trans
            ((CategoryTheory.Category.assoc (bc₂₃ m ≫ ι₂ m) _ pr₂_0).symm.trans
              (congrArg (· ≫ pr₂_0)
                ((CategoryTheory.Category.assoc (bc₂₃ m) (ι₂ m) _).trans
                  ((congrArg (bc₂₃ m ≫ ·)
                    ((CategoryTheory.Category.assoc f_ev₂ e_V₂.inv _).trans
                      ((congrArg (f_ev₂ ≫ ·) he_V₂_map).trans
                        (CategoryTheory.Category.assoc f_ev₂ f_e₂ e_V₀.inv).symm))).trans
                    (CategoryTheory.Category.assoc (bc₂₃ m) (f_ev₂ ≫ f_e₂) e_V₀.inv).symm))))
        have hSpecEq : f_ev₃ ≫ f_e₃ = bc₂₃ m ≫ (f_ev₂ ≫ f_e₂) := by
          dsimp only [f_ev₃, f_e₃, bc₂₃, f_ev₂, f_e₂]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Spec.map_comp]
          congr 1
          exact CommRingCat.hom_ext (RingHom.ext fun b₀ => hφ_bc₂₃_e m b₀)
        exact hLHS.trans ((congrArg (fun k => (k ≫ e_V₀.inv) ≫ pr₂_0) hSpecEq).trans hRHS.symm)

    have hPart_both := hPiPart B₃ e_V₃ ι₃ (fun _ => rfl)
    have hPart_cover : ∀ p : ↥(FgtY.obj (B_ν.obj U_star)).left,
        ∃ (m₀ : Fin r) (q₀ : PrimeSpectrum (B₃ m₀)), (ι₃ m₀).base q₀ = p := hPart_both.1
    have hPart_disj : ∀ (m₁ m₂ : Fin r) (q₁ : PrimeSpectrum (B₃ m₁)) (q₂ : PrimeSpectrum (B₃ m₂)),
        (ι₃ m₁).base q₁ = (ι₃ m₂).base q₂ → m₁ = m₂ := hPart_both.2

    let e_B₃ : ∀ m : ↥S_act, R₃ ≃+* B₃ m.1 :=
      fun m => RingEquiv.ofBijective (algebraMap R₃ (B₃ m.1)) (hBij_B₃ m)
    let ψ_m : ∀ m : ↥S_act,
        AlgebraicGeometry.Spec (CommRingCat.of R₃) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (B₃ m.1)) :=
      fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_B₃ m).symm.toRingHom)
    have hψ_π₃ : ∀ m : ↥S_act, ψ_m m ≫ π₃ m.1 = 𝟙 _ := by
      intro m
      dsimp only [ψ_m, π₃]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
      congr 1
      exact CommRingCat.hom_ext (RingHom.ext fun r₃ => (e_B₃ m).symm_apply_apply r₃)
    have hπ₃_ψ : ∀ m : ↥S_act, π₃ m.1 ≫ ψ_m m = 𝟙 _ := by
      intro m
      dsimp only [ψ_m, π₃]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
      congr 1
      exact CommRingCat.hom_ext (RingHom.ext fun b₃ => (e_B₃ m).apply_symm_apply b₃)
    have hγ_act_w : ∀ m : ↥S_act,
        (ψ_m m ≫ bc₂₃ m.1 ≫ w_hat₂ m) ≫ (FgtZ.obj W_diag).hom = (FgtZ.obj U_star).hom := fun m =>
      (CategoryTheory.Category.assoc (ψ_m m) _ _).trans
        ((congrArg (ψ_m m ≫ ·)
          ((CategoryTheory.Category.assoc (bc₂₃ m.1) _ _).trans
            ((congrArg (bc₂₃ m.1 ≫ ·) (hw_hat₂_comm m)).trans
              ((CategoryTheory.Category.assoc (bc₂₃ m.1) _ _).symm.trans
                ((congrArg (· ≫ (FgtZ.obj U₂).hom) (hbc₂₃_π m.1).symm).trans
                  (CategoryTheory.Category.assoc (π₃ m.1) _ _)))))).trans
          ((CategoryTheory.Category.assoc (ψ_m m) (π₃ m.1) _).symm.trans
            ((congrArg (· ≫ (f_R₃_₂ ≫ (FgtZ.obj U₂).hom)) (hψ_π₃ m)).trans
              ((CategoryTheory.Category.id_comp _).trans
                (CategoryTheory.MorphismProperty.Over.w j₃)))))
    let γ_act : ↥S_act → (U_star ⟶ W_diag) := fun m =>
      CategoryTheory.MorphismProperty.Over.homMk
        (ψ_m m ≫ bc₂₃ m.1 ≫ w_hat₂ m) (hγ_act_w m) trivial

    have hRange_γ_act : ∀ (m : ↥S_act) (p : ↥(FgtY.obj (B_ν.obj U_star)).left),
        ((FgtY.map (B_ν.map (γ_act m))).left).base p ∈ Set.range σ_sch.base ↔
          p ∈ Set.range (ι₃ m.1).base := by
      intro m p
      let γ_tilde_m : (FgtZ.obj U_star).left ⟶ (FgtY.obj (B_ν.obj U_star)).left :=
        CategoryTheory.Limits.pullback.lift (𝟙 _)
          ((FgtZ.map (γ_act m)).left ≫ e_W.hom ≫ W_open.ι)
          (by
