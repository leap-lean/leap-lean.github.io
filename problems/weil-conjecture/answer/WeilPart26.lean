        (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) :=
      fun a => (weilEtaleSitePullback (τ a)).sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_B
    let pf_a : Fin m → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
      fun a => (pf_fun a).obj F_B
    let pf_loc_a : Fin m → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
      fun a => (pf_fun a).obj L_loc_B
    let ρ_a : ∀ a : Fin m, F_Y ⟶ pf_a a := fun a =>
      (adj_Y.homEquiv AM (pf_a a)).symm
        (adj_B.unit.app AM ≫
          F_B.obj.map (Opposite.op (hT_B.from ((weilEtaleSitePullback (τ a)).obj T_Y))))
    let ρ_loc_a : ∀ a : Fin m, L_loc_Y ⟶ pf_loc_a a := fun a =>
      CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat (τ a) n)
    let Q_bdry : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := CategoryTheory.Limits.piObj pf_a
    let ρ : F_Y ⟶ Q_bdry := CategoryTheory.Limits.Pi.lift ρ_a

    have hSq_a : ∀ a : Fin m,
