  have hConj2 :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂)
        (hSh_L₁ : CategoryTheory.Presheaf.IsSheaf X₁.smallEtaleTopology
          (weilAltLocConstPresheaf X₁ n))
        (hSh_L₂ : CategoryTheory.Presheaf.IsSheaf X₂.smallEtaleTopology
          (weilAltLocConstPresheaf X₂ n))
        {T₁ : X₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : X₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (Φ₁ : CategoryTheory.Iso (weilEtaleTorsionSheaf X₁ n)
          ⟨weilAltLocConstPresheaf X₁ n, hSh_L₁⟩)
        (Φ₂ : CategoryTheory.Iso (weilEtaleTorsionSheaf X₂ n)
          ⟨weilAltLocConstPresheaf X₂ n, hSh_L₂⟩),
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app AM)
        (Φ₁.hom.hom.app (Opposite.op T₁)) = weilAltLocConstConstHom X₁ T₁ n →
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).unit.app AM)
        (Φ₂.hom.hom.app (Opposite.op T₂)) = weilAltLocConstConstHom X₂ T₂ n →
      let ψ_L : Quiver.Hom ((pb_of h).obj ⟨weilAltLocConstPresheaf X₂ n, hSh_L₂⟩)
          ⟨weilAltLocConstPresheaf X₁ n, hSh_L₁⟩ :=
        ((adj_of h).homEquiv ⟨weilAltLocConstPresheaf X₂ n, hSh_L₂⟩
          ⟨weilAltLocConstPresheaf X₁ n, hSh_L₁⟩).symm
