          naturality := fun _ _ _ => rfl }
    let Q_loc : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := CategoryTheory.Limits.piObj pf_loc_a
    let prodToPi : Q_prod_sh ⟶ Q_loc := CategoryTheory.Limits.Pi.lift π_prod
    let piToProd : Q_loc ⟶ Q_prod_sh :=
      CategoryTheory.ObjectProperty.homMk
        { app := fun opW => AddCommGrpCat.ofHom
            { toFun := fun x a =>
                (((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app opW).hom x)
              map_zero' := funext fun a =>
                map_zero ((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app opW).hom
              map_add' := fun x₁ x₂ => funext fun a =>
                map_add ((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app opW).hom x₁ x₂ }
          naturality := fun {W₁ W₂} u => by
            apply AddCommGrpCat.ext; intro x; funext a
