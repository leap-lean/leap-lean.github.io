          have hp₀_in : p₀ ∈ Set.range (γ_tilde γ).base := by
            refine ⟨u₀, ?_⟩
            exact congrArg (fun k : O.toScheme ⟶ _ => k.base u'₀) h_tilde_eq
          rw [ite_eq_left_iff.mpr (fun h => False.elim (h hg_eq)),
            ite_eq_left_iff.mpr (fun h => False.elim (h hp₀_in))]
        · have hnot_in : p₀ ∉ Set.range (γ_tilde γ).base := by
            rintro ⟨u₁, hu₁⟩
            exact hu₀_eq (hGraphDisj γ γ₀ u₁ u₀ hu₁)
          have hg_ne : g ≫ γ ≠ g ≫ γ₀ := by
            intro hg_eq
            have h_left_eq : O.ι ≫ (FgtZ.map γ).left = O.ι ≫ (FgtZ.map γ₀).left :=
              congrArg (fun k => (FgtZ.map k).left) hg_eq
            have h_pair_Δ : O.ι ≫ pair_map γ γ₀ = (O.ι ≫ (FgtZ.map γ).left) ≫ Δ_W := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                  CategoryTheory.Category.comp_id]
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  h_left_eq, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id]
            let lift_O := CategoryTheory.Limits.pullback.lift O.ι (O.ι ≫ (FgtZ.map γ).left) h_pair_Δ
            have hu₀_in : u₀ ∈ S_eq γ γ₀ := by
              refine ⟨lift_O.base u'₀, ?_⟩
              exact (AlgebraicGeometry.Scheme.Hom.comp_apply lift_O (ι_E γ γ₀) u'₀).symm.trans
                (congrArg (fun k : O.toScheme ⟶ U_sch => k.base u'₀)
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _))
            exact hu₀_eq hu₀_in
          rw [ite_eq_right_iff.mpr (fun h => False.elim (hg_ne h)),
            ite_eq_right_iff.mpr (fun h => False.elim (hnot_in h))]
      exact hcongr.trans hsum0
    · refine Finset.sum_eq_zero (fun γ hγ => ?_)
      exact ite_eq_right_iff.mpr (fun h_eq => False.elim (hex ⟨γ, hγ, h_eq⟩))

  
  have hS4 : ∀ (U : Z.Etale)
      (t : ↥(weilAltZeroBdrySubgroup Y W_open ℓ ((weilEtaleSitePullback ν).obj U)))
      (u₀ : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).left),
      let B_ν := weilEtaleSitePullback ν
      let h_comm_σ : CategoryTheory.CategoryStruct.comp e_W.inv
          (((AlgebraicGeometry.Scheme.Etale.forget Z).obj W_diag).hom) =
        CategoryTheory.CategoryStruct.comp W_open.ι ν :=
        (congrArg (CategoryTheory.CategoryStruct.comp e_W.inv) he_W.symm).trans
          ((CategoryTheory.Category.assoc e_W.inv e_W.hom
            (CategoryTheory.CategoryStruct.comp W_open.ι ν)).symm.trans
            ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k
              (CategoryTheory.CategoryStruct.comp W_open.ι ν)) e_W.inv_hom_id).trans
              (CategoryTheory.Category.id_comp _)))
      let σ_sch : Quiver.Hom W_open.toScheme
          ((AlgebraicGeometry.Scheme.Etale.forget Y).obj (B_ν.obj W_diag)).left :=
        CategoryTheory.Limits.pullback.lift e_W.inv W_open.ι h_comm_σ
      ∃ (U_star : Z.Etale) (g_star : Quiver.Hom U_star U)
        (u_star : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj U_star).left)
        (c : (Quiver.Hom U_star W_diag) →₀ ULift.{u} (ZMod ℓ)),
        ((AlgebraicGeometry.Scheme.Etale.forget Z).map g_star).left.base u_star = u₀ ∧
        ∀ p : ↥((AlgebraicGeometry.Scheme.Etale.forget Y).obj (B_ν.obj U_star)).left,
          c.sum (fun γ a =>
            @ite _ (((AlgebraicGeometry.Scheme.Etale.forget Y).map (B_ν.map γ)).left.base p ∈
              Set.range σ_sch.base) (Classical.propDecidable _) a 0) =
            t.1 (((AlgebraicGeometry.Scheme.Etale.forget Y).map (B_ν.map g_star)).left.base p) := by
    clear _hCont hSh hS1 hS2
    intro U t u₀
    classical
    let FgtZ := AlgebraicGeometry.Scheme.Etale.forget Z
    let FgtY := AlgebraicGeometry.Scheme.Etale.forget Y
    let B_ν := weilEtaleSitePullback ν
    let P_W := (FgtY.obj (B_ν.obj W_diag)).left
    let fst_W : P_W ⟶ (FgtZ.obj W_diag).left :=
      CategoryTheory.Limits.pullback.fst W_diag.hom ν
    let snd_W : P_W ⟶ Y :=
      CategoryTheory.Limits.pullback.snd W_diag.hom ν
    let h_comm_σ : e_W.inv ≫ (FgtZ.obj W_diag).hom = W_open.ι ≫ ν :=
      (congrArg (e_W.inv ≫ ·) he_W.symm).trans
        ((CategoryTheory.Category.assoc e_W.inv e_W.hom (W_open.ι ≫ ν)).symm.trans
          ((congrArg (· ≫ (W_open.ι ≫ ν)) e_W.inv_hom_id).trans
            (CategoryTheory.Category.id_comp _)))
    let σ_sch : W_open.toScheme ⟶ P_W :=
      CategoryTheory.Limits.pullback.lift e_W.inv W_open.ι h_comm_σ
    have hσ_fst : σ_sch ≫ fst_W = e_W.inv := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hσ_snd : σ_sch ≫ snd_W = W_open.ι := CategoryTheory.Limits.pullback.lift_snd _ _ _

    have hGraphEq : ∀ (V_et : Z.Etale) (γ : V_et ⟶ W_diag),
        let V_sch := (FgtZ.obj V_et).left
        let h_gr : 𝟙 V_sch ≫ V_et.hom =
            ((FgtZ.map γ).left ≫ e_W.hom ≫ W_open.ι) ≫ ν := by
          change 𝟙 V_sch ≫ (FgtZ.obj V_et).hom = ((FgtZ.map γ).left ≫ e_W.hom ≫ W_open.ι) ≫ ν
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc, he_W]
          exact ((FgtZ.map γ).w).symm
        let γ_tilde : V_sch ⟶ (FgtY.obj (B_ν.obj V_et)).left :=
          CategoryTheory.Limits.pullback.lift (𝟙 V_sch) ((FgtZ.map γ).left ≫ e_W.hom ≫ W_open.ι) h_gr
        ∀ p : ↥(FgtY.obj (B_ν.obj V_et)).left,
          ((FgtY.map (B_ν.map γ)).left).base p ∈ Set.range σ_sch.base ↔
            p ∈ Set.range γ_tilde.base := by
      intro V_et γ V_sch h_gr γ_tilde p
      let fst_V : (FgtY.obj (B_ν.obj V_et)).left ⟶ V_sch :=
        CategoryTheory.Limits.pullback.fst V_et.hom ν
      let snd_V : (FgtY.obj (B_ν.obj V_et)).left ⟶ Y :=
        CategoryTheory.Limits.pullback.snd V_et.hom ν
      let m_γ := (FgtY.map (B_ν.map γ)).left
      have hm_fst : m_γ ≫ fst_W = fst_V ≫ (FgtZ.map γ).left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hm_snd : m_γ ≫ snd_W = snd_V :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have htilde_fst : γ_tilde ≫ fst_V = 𝟙 V_sch :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have htilde_snd : γ_tilde ≫ snd_V = (FgtZ.map γ).left ≫ e_W.hom ≫ W_open.ι :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      constructor
      · rintro ⟨w, hw⟩
        obtain ⟨z, _, hz_snd⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := σ_sch) (g := m_γ) w p hw
        let P_m := CategoryTheory.Limits.pullback σ_sch m_γ
        let π_W : P_m ⟶ W_open.toScheme := CategoryTheory.Limits.pullback.fst σ_sch m_γ
        let ι_P : P_m ⟶ (FgtY.obj (B_ν.obj V_et)).left :=
          CategoryTheory.Limits.pullback.snd σ_sch m_γ
        have h_fac : (ι_P ≫ fst_V) ≫ γ_tilde = ι_P := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · change ((ι_P ≫ fst_V) ≫ γ_tilde) ≫ fst_V = ι_P ≫ fst_V
            rw [CategoryTheory.Category.assoc, htilde_fst, CategoryTheory.Category.comp_id]
          · change ((ι_P ≫ fst_V) ≫ γ_tilde) ≫ snd_V = ι_P ≫ snd_V
            rw [CategoryTheory.Category.assoc, htilde_snd]
            have h1 : (ι_P ≫ fst_V) ≫ (FgtZ.map γ).left = π_W ≫ e_W.inv := by
              calc
                (ι_P ≫ fst_V) ≫ (FgtZ.map γ).left
                  = ι_P ≫ (fst_V ≫ (FgtZ.map γ).left) := CategoryTheory.Category.assoc _ _ _
                _ = ι_P ≫ (m_γ ≫ fst_W) := by rw [← hm_fst]
                _ = (ι_P ≫ m_γ) ≫ fst_W := (CategoryTheory.Category.assoc _ _ _).symm
                _ = (π_W ≫ σ_sch) ≫ fst_W := by rw [CategoryTheory.Limits.pullback.condition]
                _ = π_W ≫ e_W.inv := by rw [CategoryTheory.Category.assoc, hσ_fst]
            calc
              (ι_P ≫ fst_V) ≫ (FgtZ.map γ).left ≫ e_W.hom ≫ W_open.ι
                = ((ι_P ≫ fst_V) ≫ (FgtZ.map γ).left) ≫ e_W.hom ≫ W_open.ι :=
                  (CategoryTheory.Category.assoc _ _ _).symm
              _ = (π_W ≫ e_W.inv) ≫ e_W.hom ≫ W_open.ι := by rw [h1]
              _ = π_W ≫ (e_W.inv ≫ e_W.hom) ≫ W_open.ι := by
                  simp only [CategoryTheory.Category.assoc]
              _ = π_W ≫ W_open.ι := by rw [e_W.inv_hom_id, CategoryTheory.Category.id_comp]
              _ = π_W ≫ (σ_sch ≫ snd_W) := by rw [hσ_snd]
              _ = (π_W ≫ σ_sch) ≫ snd_W := (CategoryTheory.Category.assoc _ _ _).symm
              _ = (ι_P ≫ m_γ) ≫ snd_W := by rw [CategoryTheory.Limits.pullback.condition]
              _ = ι_P ≫ snd_V := by rw [CategoryTheory.Category.assoc, hm_snd]
        refine ⟨(ι_P ≫ fst_V).base z, ?_⟩
        exact (AlgebraicGeometry.Scheme.Hom.comp_apply (ι_P ≫ fst_V) γ_tilde z).symm.trans
          ((congrArg (fun k : P_m ⟶ _ => k.base z) h_fac).trans hz_snd)
      · rintro ⟨u, rfl⟩
        have h_comp : γ_tilde ≫ m_γ = ((FgtZ.map γ).left ≫ e_W.hom) ≫ σ_sch := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (γ_tilde ≫ m_γ) ≫ fst_W = (((FgtZ.map γ).left ≫ e_W.hom) ≫ σ_sch) ≫ fst_W
            calc
