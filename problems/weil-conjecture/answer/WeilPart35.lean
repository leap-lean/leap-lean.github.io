      G₁ G₂ pf_h adj₁ adj₂ τ α_h
    let W := E.left
    rcases hψ₀ with ⟨hc', hr', hAdd', hLim', hColim', TW', hTW', TW, hTW,
      ιℤ', hιπ', hπι', hψ₀_eq⟩
    have := hc'
    have := hr'
    have := hAdd'
    have := hLim'
    have := hColim'
    let B_h' : CategoryTheory.Functor W.Etale W'.Etale := weilEtaleSitePullback h'
    let J_W := W.smallEtaleTopology
    let J_W' := W'.smallEtaleTopology
    let G_W := weilEtaleTorsionSheaf W ℓ
    let G_W' := weilEtaleTorsionSheaf W' ℓ
    let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_W' := (CategoryTheory.constantSheaf J_W' AddCommGrpCat.{u}).obj Aℤ
    let pf_h' := B_h'.sheafPushforwardContinuous AddCommGrpCat.{u} J_W J_W'
    let pb_h' := B_h'.sheafPullback AddCommGrpCat.{u} J_W J_W'
    let adj_pull' := B_h'.sheafAdjunctionContinuous AddCommGrpCat.{u} J_W J_W'
    let adj_TW' := CategoryTheory.constantSheafAdj J_W' AddCommGrpCat.{u} hTW'
    let adj_TW := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hTW
    let τ' := hTW'.from (B_h'.obj TW)
    let πℤ' : pb_h'.obj Fℤ_W ⟶ Fℤ_W' :=
      (adj_pull'.homEquiv Fℤ_W Fℤ_W').symm
        ((adj_TW.homEquiv Aℤ (pf_h'.obj Fℤ_W')).symm
          (CategoryTheory.CategoryStruct.comp (adj_TW'.unit.app Aℤ)
            (Fℤ_W'.obj.map (Opposite.op τ'))))
    let α_h' : G_W ⟶ pf_h'.obj G_W' :=
      (adj_TW.homEquiv AM (pf_h'.obj G_W')).symm
        (CategoryTheory.CategoryStruct.comp (adj_TW'.unit.app AM)
          (G_W'.obj.map (Opposite.op τ')))
    let πM' : pb_h'.obj G_W ⟶ G_W' := (adj_pull'.homEquiv G_W G_W').symm α_h'
    have hExtMk₀Equiv : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
        [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
        {Y₁ Y₂ : C_ab} (g : Y₁ ⟶ Y₂),
        CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
      intro C_ab _ _ _ Y₁ Y₂ g
      have hg := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
        (CategoryTheory.Abelian.Ext.addEquiv₀.symm g)
      rw [AddEquiv.apply_symm_apply] at hg
      rw [hg, AddEquiv.apply_symm_apply]
    let Φ_Hom : (Fℤ_W ⟶ G_W) → (Fℤ_W' ⟶ G_W') :=
      fun f => ιℤ' ≫ pb_h'.map f ≫ πM'
    have hΦ_eq : ∀ f : Fℤ_W ⟶ G_W,
        CategoryTheory.Abelian.Ext.addEquiv₀
          (ψ₀ (CategoryTheory.Abelian.Ext.addEquiv₀.symm f)) = Φ_Hom f := by
      intro f
      have hf_symm : CategoryTheory.Abelian.Ext.addEquiv₀.symm f =
          CategoryTheory.Abelian.Ext.mk₀ f := by
        apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
        rw [AddEquiv.apply_symm_apply, hExtMk₀Equiv]
      rw [hψ₀_eq, hf_symm]
      change CategoryTheory.Abelian.Ext.addEquiv₀
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ').comp
          ((pb_h'.mapExtAddHom Fℤ_W G_W 0) (CategoryTheory.Abelian.Ext.mk₀ f))
          (Nat.zero_add 0)).comp (CategoryTheory.Abelian.Ext.mk₀ πM') (Nat.add_zero 0)) = _
      rw [CategoryTheory.Functor.mapExtAddHom_apply pb_h' Fℤ_W G_W 0,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hExtMk₀Equiv, CategoryTheory.Category.assoc]
    have hBij_ΦHom : Function.Bijective Φ_Hom := by
      have hfun : Φ_Hom =
          ⇑(CategoryTheory.Abelian.Ext.addEquiv₀ : G_W'.H 0 ≃+ (Fℤ_W' ⟶ G_W')) ∘
            ⇑ψ₀ ∘ ⇑(CategoryTheory.Abelian.Ext.addEquiv₀ : G_W.H 0 ≃+ (Fℤ_W ⟶ G_W)).symm :=
        funext fun f => (hΦ_eq f).symm
      rw [hfun]
      exact CategoryTheory.Abelian.Ext.addEquiv₀.bijective.comp
        (hBij₀.comp CategoryTheory.Abelian.Ext.addEquiv₀.symm.bijective)
    let e_ι : (Fℤ_W' ⟶ G_W') ≃ (pb_h'.obj Fℤ_W ⟶ G_W') :=
      { toFun := fun g => πℤ' ≫ g
        invFun := fun k => ιℤ' ≫ k
        left_inv := fun g =>
          (CategoryTheory.Category.assoc ιℤ' πℤ' g).symm.trans
            ((congrArg (· ≫ g) hιπ').trans (CategoryTheory.Category.id_comp g))
        right_inv := fun k =>
          (CategoryTheory.Category.assoc πℤ' ιℤ' k).symm.trans
            ((congrArg (· ≫ k) hπι').trans (CategoryTheory.Category.id_comp k)) }
    have hBij_postα : Function.Bijective (fun f : Fℤ_W ⟶ G_W => f ≫ α_h') := by
      let eqv := adj_pull'.homEquiv Fℤ_W G_W'
      have hfun : (fun f : Fℤ_W ⟶ G_W => f ≫ α_h') = ⇑eqv ∘ ⇑e_ι ∘ Φ_Hom :=
        funext fun f =>
          eqv.symm.injective
            ((adj_pull'.homEquiv_naturality_left_symm f α_h').trans
              ((e_ι.right_inv (pb_h'.map f ≫ πM')).symm.trans
                (eqv.symm_apply_apply (e_ι (Φ_Hom f))).symm))
      exact Eq.mp (congrArg Function.Bijective hfun.symm)
        (eqv.bijective.comp (e_ι.bijective.comp hBij_ΦHom))
    let evZ : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃ ↥M := fun M =>
      { toFun := fun u => u.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
        left_inv := fun u => by
          apply AddCommGrpCat.ext
          rintro ⟨z⟩
          change z • u.hom (ULift.up (1 : ℤ)) = u.hom (ULift.up z)
          have hz : z • (ULift.up (1 : ℤ) : ↥Aℤ) = ULift.up z :=
            ULift.ext _ _ (by change z • (1 : ℤ) = z; simp)
          rw [← map_zsmul u.hom z (ULift.up (1 : ℤ)), hz]
        right_inv := fun m => one_zsmul m }
    let e_tot : ∀ (ℱ : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        (Fℤ_W ⟶ ℱ) ≃ ↥(ℱ.obj.obj (Opposite.op TW)) :=
      fun ℱ => (adj_TW.homEquiv Aℤ ℱ).trans (evZ (ℱ.obj.obj (Opposite.op TW)))
    have hBij_appTW : Function.Bijective (α_h'.hom.app (Opposite.op TW)) := by
      have hfun : (α_h'.hom.app (Opposite.op TW) :
            ↥(G_W.obj.obj (Opposite.op TW)) → ↥((pf_h'.obj G_W').obj.obj (Opposite.op TW))) =
          ⇑(e_tot (pf_h'.obj G_W')) ∘
            (fun f : Fℤ_W ⟶ G_W => f ≫ α_h') ∘ ⇑(e_tot G_W).symm :=
        funext fun m => by
          let u_m := (evZ (G_W.obj.obj (Opposite.op TW))).symm m
          let f_m := (adj_TW.homEquiv Aℤ G_W).symm u_m
          have h1 : (adj_TW.homEquiv Aℤ (pf_h'.obj G_W')) (f_m ≫ α_h') =
              u_m ≫ α_h'.hom.app (Opposite.op TW) :=
            (adj_TW.homEquiv_naturality_right f_m α_h').trans
              (congrArg (· ≫ α_h'.hom.app (Opposite.op TW))
                ((adj_TW.homEquiv Aℤ G_W).apply_symm_apply u_m))
          have h2 : evZ ((pf_h'.obj G_W').obj.obj (Opposite.op TW))
              (u_m ≫ α_h'.hom.app (Opposite.op TW)) =
              (α_h'.hom.app (Opposite.op TW)) (evZ (G_W.obj.obj (Opposite.op TW)) u_m) := rfl
          have h3 : evZ (G_W.obj.obj (Opposite.op TW)) u_m = m :=
            (evZ (G_W.obj.obj (Opposite.op TW))).apply_symm_apply m
          exact (congrArg (α_h'.hom.app (Opposite.op TW)) h3.symm).trans
            (h2.symm.trans (congrArg (evZ ((pf_h'.obj G_W').obj.obj (Opposite.op TW))) h1.symm))
      exact Eq.mp (congrArg Function.Bijective hfun.symm)
        ((e_tot (pf_h'.obj G_W')).bijective.comp
          (hBij_postα.comp (e_tot G_W).symm.bijective))
    have hIso_αh'_TW : CategoryTheory.IsIso (α_h'.hom.app (Opposite.op TW)) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mpr hBij_appTW
    let T_W0 : W.Etale := termEtale W
    let e_TW : TW ≅ T_W0 := hTW.uniqueUpToIso (hTermEtale W)
    have hIso_αh'_T0 : CategoryTheory.IsIso (α_h'.hom.app (Opposite.op T_W0)) :=
      (CategoryTheory.NatTrans.isIso_app_iff_of_iso α_h'.hom e_TW.op).mpr hIso_αh'_TW

    have hw_E : AlgebraicGeometry.Etale (E.hom : W ⟶ S₂) := E.prop
    have hw' : AlgebraicGeometry.Etale w' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip E.prop
    let M_E := @sliceEtale W S₂ E.hom hw_E
    let M_w' := @sliceEtale W' S₁ w' hw'
    have : M_E.IsContinuous J_W S₂.smallEtaleTopology := @hSliceCont W S₂ E.hom hw_E
    have : M_w'.IsContinuous J_W' S₁.smallEtaleTopology := @hSliceCont W' S₁ w' hw'
    let res_E := M_E.sheafPushforwardContinuous AddCommGrpCat.{u} J_W S₂.smallEtaleTopology
    let res_w' := M_w'.sheafPushforwardContinuous AddCommGrpCat.{u} J_W' S₁.smallEtaleTopology
    let const_W := (CategoryTheory.Functor.const (W.Etale)ᵒᵖ).obj AM
    let const_W' := (CategoryTheory.Functor.const (W'.Etale)ᵒᵖ).obj AM
    let const_S₁ := (CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj AM
    let const_S₂ := (CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj AM
    let η_W := CategoryTheory.toSheafify J_W const_W
    let η_W' := CategoryTheory.toSheafify J_W' const_W'
    let η_S₁ := CategoryTheory.toSheafify S₁.smallEtaleTopology const_S₁
    let η_S₂ := CategoryTheory.toSheafify S₂.smallEtaleTopology const_S₂
    let θ_E : G_W ⟶ res_E.obj G₂ :=
      ((CategoryTheory.sheafificationAdjunction J_W AddCommGrpCat.{u}).homEquiv
        const_W (res_E.obj G₂)).symm (CategoryTheory.Functor.whiskerLeft M_E.op η_S₂)
    let θ_w' : G_W' ⟶ res_w'.obj G₁ :=
      ((CategoryTheory.sheafificationAdjunction J_W' AddCommGrpCat.{u}).homEquiv
        const_W' (res_w'.obj G₁)).symm (CategoryTheory.Functor.whiskerLeft M_w'.op η_S₁)
    obtain ⟨hη_θE, hIso_θE⟩ := @hSliceThetaIso W S₂ E.hom hw_E
    obtain ⟨hη_θw', hIso_θw'⟩ := @hSliceThetaIso W' S₁ w' hw'

    let B_h : CategoryTheory.Functor S₂.Etale S₁.Etale := weilEtaleSitePullback h
    have hSqU : ∀ U₀ : W.Etale,
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst U₀.hom h')
          (CategoryTheory.Limits.pullback.snd U₀.hom h' ≫ w')
          (U₀.hom ≫ E.hom) h :=
      fun U₀ => (CategoryTheory.IsPullback.of_hasPullback U₀.hom h').paste_vert hpb.flip
    let δ_U : ∀ U₀ : W.Etale, B_h.obj (M_E.obj U₀) ⟶ M_w'.obj (B_h'.obj U₀) :=
      fun U₀ => CategoryTheory.MorphismProperty.Over.homMk
        (hSqU U₀).isoPullback.inv (hSqU U₀).isoPullback_inv_snd
    let δ_inv_U : ∀ U₀ : W.Etale, M_w'.obj (B_h'.obj U₀) ⟶ B_h.obj (M_E.obj U₀) :=
      fun U₀ => CategoryTheory.MorphismProperty.Over.homMk
        (hSqU U₀).isoPullback.hom (hSqU U₀).isoPullback_hom_snd
    let e_δ : ∀ U₀ : W.Etale, B_h.obj (M_E.obj U₀) ≅ M_w'.obj (B_h'.obj U₀) :=
      fun U₀ =>
        { hom := δ_U U₀
          inv := δ_inv_U U₀
          hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (hSqU U₀).isoPullback.inv_hom_id (Subsingleton.elim _ _)
          inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (hSqU U₀).isoPullback.hom_inv_id (Subsingleton.elim _ _) }
    have hδ_nat : ∀ {U₁ U₂ : W.Etale} (g : U₁ ⟶ U₂),
        B_h.map (M_E.map g) ≫ δ_U U₂ = δ_U U₁ ≫ M_w'.map (B_h'.map g) := by
      intro U₁ U₂ g
      have hinv_nat : δ_inv_U U₁ ≫ B_h.map (M_E.map g) =
          M_w'.map (B_h'.map g) ≫ δ_inv_U U₂ := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        change (hSqU U₁).isoPullback.hom ≫ (B_h.map (M_E.map g)).left =
          (B_h'.map g).left ≫ (hSqU U₂).isoPullback.hom
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hfst₁ : (B_h.map (M_E.map g)).left ≫
              CategoryTheory.Limits.pullback.fst (U₂.hom ≫ E.hom) h =
              CategoryTheory.Limits.pullback.fst (U₁.hom ≫ E.hom) h ≫ g.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hfst₂ : (B_h'.map g).left ≫ CategoryTheory.Limits.pullback.fst U₂.hom h' =
              CategoryTheory.Limits.pullback.fst U₁.hom h' ≫ g.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          exact (CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom
              (B_h.map (M_E.map g)).left _).trans
            ((congrArg ((hSqU U₁).isoPullback.hom ≫ ·) hfst₁).trans
              ((CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom _ g.left).symm.trans
                ((congrArg (· ≫ g.left) (hSqU U₁).isoPullback_hom_fst).trans
                  (hfst₂.symm.trans
                    ((congrArg ((B_h'.map g).left ≫ ·) (hSqU U₂).isoPullback_hom_fst.symm).trans
                      (CategoryTheory.Category.assoc (B_h'.map g).left
                        (hSqU U₂).isoPullback.hom _).symm)))))
        · have hsnd₁ : (B_h.map (M_E.map g)).left ≫
              CategoryTheory.Limits.pullback.snd (U₂.hom ≫ E.hom) h =
              CategoryTheory.Limits.pullback.snd (U₁.hom ≫ E.hom) h :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hsnd₂ : (B_h'.map g).left ≫ CategoryTheory.Limits.pullback.snd U₂.hom h' =
              CategoryTheory.Limits.pullback.snd U₁.hom h' :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          exact (CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom
              (B_h.map (M_E.map g)).left _).trans
            ((congrArg ((hSqU U₁).isoPullback.hom ≫ ·) hsnd₁).trans
              ((hSqU U₁).isoPullback_hom_snd.trans
                ((congrArg (· ≫ w') hsnd₂.symm).trans
                  ((CategoryTheory.Category.assoc (B_h'.map g).left _ w').trans
                    ((congrArg ((B_h'.map g).left ≫ ·) (hSqU U₂).isoPullback_hom_snd.symm).trans
                      (CategoryTheory.Category.assoc (B_h'.map g).left
                        (hSqU U₂).isoPullback.hom _).symm)))))
      exact (CategoryTheory.Category.id_comp (B_h.map (M_E.map g) ≫ δ_U U₂)).symm.trans
        ((congrArg (· ≫ (B_h.map (M_E.map g) ≫ δ_U U₂)) (e_δ U₁).hom_inv_id.symm).trans
          ((CategoryTheory.Category.assoc (e_δ U₁).hom (e_δ U₁).inv _).trans
            ((congrArg ((e_δ U₁).hom ≫ ·)
              ((CategoryTheory.Category.assoc (e_δ U₁).inv _ (δ_U U₂)).symm.trans
                ((congrArg (· ≫ δ_U U₂) hinv_nat).trans
                  ((CategoryTheory.Category.assoc (M_w'.map (B_h'.map g))
                    (e_δ U₂).inv (e_δ U₂).hom).trans
                    ((congrArg (M_w'.map (B_h'.map g) ≫ ·) (e_δ U₂).inv_hom_id).trans
                      (CategoryTheory.Category.comp_id _)))))))))
    let ε_sq_pre : (pf_h'.obj (res_w'.obj G₁)).obj ⟶ (res_E.obj (pf_h.obj G₁)).obj :=
      { app := fun U_op => G₁.obj.map (δ_U U_op.unop).op
        naturality := fun {U₁_op U₂_op} g_op => by
          change G₁.obj.map (M_w'.map (B_h'.map g_op.unop)).op ≫
              G₁.obj.map (δ_U U₂_op.unop).op =
            G₁.obj.map (δ_U U₁_op.unop).op ≫
              G₁.obj.map (B_h.map (M_E.map g_op.unop)).op
          exact (G₁.obj.map_comp _ _).symm.trans
            ((congrArg G₁.obj.map ((hop_comp _ _).symm.trans
                (congrArg Opposite.op (hδ_nat g_op.unop).symm))).trans
              ((congrArg G₁.obj.map (hop_comp _ _)).trans (G₁.obj.map_comp _ _))) }
    let ε_sq : pf_h'.obj (res_w'.obj G₁) ⟶ res_E.obj (pf_h.obj G₁) :=
      CategoryTheory.ObjectProperty.homMk ε_sq_pre
    have hComm_sh : θ_E ≫ res_E.map α_h = α_h' ≫ pf_h'.map θ_w' ≫ ε_sq := by
      let adj_shW := CategoryTheory.sheafificationAdjunction J_W AddCommGrpCat.{u}
      apply (adj_shW.homEquiv const_W (res_E.obj (pf_h.obj G₁))).injective
      refine (CategoryTheory.Adjunction.homEquiv_unit adj_shW const_W
        (res_E.obj (pf_h.obj G₁)) (θ_E ≫ res_E.map α_h)).trans
        (Eq.trans ?_
          (CategoryTheory.Adjunction.homEquiv_unit adj_shW const_W
            (res_E.obj (pf_h.obj G₁)) (α_h' ≫ pf_h'.map θ_w' ≫ ε_sq)).symm)
      have hα_h_sh := hAlphaSheafify h hT₁ hT₂
      have hα_h'_sh := hAlphaSheafify h' hTW' hTW
      ext U_op : 2
      apply AddCommGrpCat.ext
      intro a
      let U₀ := U_op.unop
      have hlhs : ((η_W ≫ (CategoryTheory.sheafToPresheaf J_W AddCommGrpCat.{u}).map
            (θ_E ≫ res_E.map α_h)).app (Opposite.op U₀)) a =
          (η_S₁.app (Opposite.op (B_h.obj (M_E.obj U₀)))) a := by
        have h1 : ((η_W ≫ θ_E.hom).app (Opposite.op U₀)) a =
            (η_S₂.app (Opposite.op (M_E.obj U₀))) a :=
          congrArg (fun ν : const_W ⟶ (res_E.obj G₂).obj => (ν.app (Opposite.op U₀)) a) hη_θE
        have h2 : (α_h.hom.app (Opposite.op (M_E.obj U₀)))
            ((η_S₂.app (Opposite.op (M_E.obj U₀))) a) =
            (η_S₁.app (Opposite.op (B_h.obj (M_E.obj U₀)))) a :=
          congrArg (fun ν : const_S₂ ⟶ (pf_h.obj G₁).obj =>
            (ν.app (Opposite.op (M_E.obj U₀))) a) hα_h_sh
        exact (congrArg (α_h.hom.app (Opposite.op (M_E.obj U₀))) h1).trans h2
      have hrhs : ((η_W ≫ (CategoryTheory.sheafToPresheaf J_W AddCommGrpCat.{u}).map
            (α_h' ≫ pf_h'.map θ_w' ≫ ε_sq)).app (Opposite.op U₀)) a =
          (η_S₁.app (Opposite.op (B_h.obj (M_E.obj U₀)))) a := by
        have h1 : ((η_W ≫ α_h'.hom).app (Opposite.op U₀)) a =
            (η_W'.app (Opposite.op (B_h'.obj U₀))) a :=
          congrArg (fun ν : const_W ⟶ (pf_h'.obj G_W').obj =>
            (ν.app (Opposite.op U₀)) a) hα_h'_sh
        have h2 : (θ_w'.hom.app (Opposite.op (B_h'.obj U₀)))
            ((η_W'.app (Opposite.op (B_h'.obj U₀))) a) =
            (η_S₁.app (Opposite.op (M_w'.obj (B_h'.obj U₀)))) a :=
          congrArg (fun ν : const_W' ⟶ (res_w'.obj G₁).obj =>
            (ν.app (Opposite.op (B_h'.obj U₀))) a) hη_θw'
        have h3 := congrArg (fun k => k a) (η_S₁.naturality (δ_U U₀).op)
        exact (congrArg (G₁.obj.map (δ_U U₀).op)
          ((congrArg (θ_w'.hom.app (Opposite.op (B_h'.obj U₀))) h1).trans h2)).trans h3.symm
      exact hlhs.trans hrhs.symm

    have hComm_T0 : θ_E.hom.app (Opposite.op T_W0) ≫
          α_h.hom.app (Opposite.op (M_E.obj T_W0)) =
        α_h'.hom.app (Opposite.op T_W0) ≫
          (pf_h'.map θ_w').hom.app (Opposite.op T_W0) ≫
          ε_sq_pre.app (Opposite.op T_W0) :=
      congrArg (fun ν : G_W ⟶ res_E.obj (pf_h.obj G₁) => ν.hom.app (Opposite.op T_W0)) hComm_sh
    have hIso_θE_app : CategoryTheory.IsIso (θ_E.hom.app (Opposite.op T_W0)) := by
