          (m₀ : ∀ r : ℕ, H₁ r →+ H₂ r)
          (m_sys : ↥L₁ →+ ↥L₂)
          (hm_val : ∀ (x : ↥L₁) (r : ℕ), (m_sys x).1 r = m₀ r (x.1 r)),
          ∃ (m_Q : TensorProduct ℤ ℚ ↥L₁ →+ TensorProduct ℤ ℚ ↥L₂)
            (F_lin : V₁ →ₗ[Padic ℓ₀] V₂),
            (∀ (q : ℚ) (x : ↥L₁),
              m_Q (TensorProduct.tmul ℤ q x) = TensorProduct.tmul ℤ q (m_sys x)) ∧
            (∀ t : TensorProduct ℤ ℚ ↥L₁, F_lin (equiv₁ t) = equiv₂ (m_Q t)) := by
      intro H₁ H₂ _ _ tr₁ L₁ L₂ hL₁ hTors₁ V₁ V₂ _ _ _ _ equiv₁ equiv₂ hsmul₁ hsmul₂ m₀ m_sys hm_val
      have hZModSmul : ∀ (z : PadicInt ℓ₀) (x : ↥L₁),
          (fun r : ℕ => (PadicInt.toZModPow r z).val • x.1 r) ∈ L₁ := by
        intro z x
        rw [hL₁]
        intro r
        rw [map_nsmul, (hL₁ x.1).mp x.2 r]
        have : NeZero (ℓ₀ ^ r) := ⟨pow_ne_zero r hPrime.ne_zero⟩
        have : NeZero (ℓ₀ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
        set a := PadicInt.toZModPow (r + 1) z
        set b := PadicInt.toZModPow r z
        have hcast : ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r)) a = b :=
          RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (p := ℓ₀) r (r + 1) (Nat.le_succ r)) z
        have hb_eq : (a.val : ZMod (ℓ₀ ^ r)) = b := by
          have ha : (a.val : ZMod (ℓ₀ ^ (r + 1))) = a := ZMod.natCast_zmod_val a
          calc
            (a.val : ZMod (ℓ₀ ^ r)) =
                ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r))
                  (a.val : ZMod (ℓ₀ ^ (r + 1))) := (map_natCast _ a.val).symm
            _ = ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r)) a := by rw [ha]
            _ = b := hcast
        have hb_val : b.val = a.val % (ℓ₀ ^ r) := by
          rw [← hb_eq, ZMod.val_natCast]
        have hdiv : a.val = (a.val / (ℓ₀ ^ r)) * (ℓ₀ ^ r) + b.val := by
          rw [hb_val, mul_comm]
          exact (Nat.div_add_mod a.val (ℓ₀ ^ r)).symm
        rw [hdiv, add_nsmul, mul_smul, hTors₁ r (x.1 r), smul_zero, zero_add]
      let B : ℚ →+ ↥L₁ →+ TensorProduct ℤ ℚ ↥L₂ :=
        { toFun := fun q => (TensorProduct.mk ℤ ℚ ↥L₂ q).toAddMonoidHom.comp m_sys
          map_zero' := by ext x; exact TensorProduct.zero_tmul ℚ (m_sys x)
          map_add' := fun q₁ q₂ => by ext x; exact TensorProduct.add_tmul q₁ q₂ (m_sys x) }
      have hB : ∀ (r : ℤ) (q : ℚ) (x : ↥L₁), B (r • q) x = B q (r • x) := by
        intro r q x
        change TensorProduct.tmul ℤ (r • q) (m_sys x) = TensorProduct.tmul ℤ q (m_sys (r • x))
        rw [map_zsmul m_sys r x, TensorProduct.smul_tmul]
      let m_Q : TensorProduct ℤ ℚ ↥L₁ →+ TensorProduct ℤ ℚ ↥L₂ :=
        TensorProduct.liftAddHom B hB
      have hm_Q_tmul : ∀ (q : ℚ) (x : ↥L₁),
          m_Q (TensorProduct.tmul ℤ q x) = TensorProduct.tmul ℤ q (m_sys x) :=
        fun q x => TensorProduct.liftAddHom_tmul B hB q x
      let f₀_add : V₁ →+ V₂ :=
        (equiv₂.toAddMonoidHom.comp m_Q).comp equiv₁.symm.toAddMonoidHom
      have hf₀_equiv : ∀ t : TensorProduct ℤ ℚ ↥L₁, f₀_add (equiv₁ t) = equiv₂ (m_Q t) := by
        intro t
        change equiv₂ (m_Q (equiv₁.symm (equiv₁ t))) = equiv₂ (m_Q t)
        rw [equiv₁.symm_apply_apply]
      have hf₀_rat : ∀ (q : ℚ) (v : V₁),
          f₀_add ((q : Padic ℓ₀) • v) = (q : Padic ℓ₀) • f₀_add v :=
        fun q v => map_ratCast_smul f₀_add (Padic ℓ₀) (Padic ℓ₀) q v
      have he₁_tmul : ∀ (q : ℚ) (x : ↥L₁),
          equiv₁ (TensorProduct.tmul ℤ q x) =
            (q : Padic ℓ₀) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x) := by
        intro q x
        have hq : TensorProduct.tmul ℤ q x =
            (q : ℚ) • TensorProduct.tmul ℤ (1 : ℚ) x := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hq]
        exact map_ratCast_smul equiv₁ ℚ (Padic ℓ₀) q (TensorProduct.tmul ℤ (1 : ℚ) x)
      have hf₀_padicInt : ∀ (z : PadicInt ℓ₀) (v : V₁),
          f₀_add ((z : Padic ℓ₀) • v) = (z : Padic ℓ₀) • f₀_add v := by
        intro z v
        have ht : ∀ t : TensorProduct ℤ ℚ ↥L₁,
            f₀_add ((z : Padic ℓ₀) • equiv₁ t) = (z : Padic ℓ₀) • f₀_add (equiv₁ t) := by
          intro t
          refine TensorProduct.inductionOn t ?_ ?_
          · intro q x
            let y : ↥L₁ := ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, hZModSmul z x⟩
            have hy₁ : equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y) =
                (z : Padic ℓ₀) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x) :=
              hsmul₁ z x y (fun _ => rfl)
            have hy₂ : equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) (m_sys y)) =
                (z : Padic ℓ₀) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) (m_sys x)) :=
              hsmul₂ z (m_sys x) (m_sys y) (fun r => by
                rw [hm_val y r, hm_val x r]
                exact map_nsmul (m₀ r) _ (x.1 r))
            calc
              f₀_add ((z : Padic ℓ₀) • equiv₁ (TensorProduct.tmul ℤ q x)) =
                  f₀_add ((z : Padic ℓ₀) • ((q : Padic ℓ₀) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
                rw [he₁_tmul q x]
              _ = f₀_add ((q : Padic ℓ₀) • ((z : Padic ℓ₀) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
                rw [smul_comm]
              _ = (q : Padic ℓ₀) • f₀_add (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y)) := by
                rw [hf₀_rat, hy₁]
              _ = (q : Padic ℓ₀) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) (m_sys y)) := by
                rw [hf₀_equiv, hm_Q_tmul]
              _ = (q : Padic ℓ₀) • ((z : Padic ℓ₀) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) (m_sys x))) := by
                rw [hy₂]
              _ = (z : Padic ℓ₀) • ((q : Padic ℓ₀) • f₀_add (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
                rw [← hm_Q_tmul (1 : ℚ) x, ← hf₀_equiv, smul_comm]
              _ = (z : Padic ℓ₀) • f₀_add (equiv₁ (TensorProduct.tmul ℤ q x)) := by
                rw [← hf₀_rat, ← he₁_tmul q x]
          · intro t₁ t₂ ht₁ ht₂
            rw [map_add, smul_add, map_add, ht₁, ht₂, ← smul_add, ← map_add]
        simpa [equiv₁.apply_symm_apply] using ht (equiv₁.symm v)
      have hf₀_smul : ∀ (c : Padic ℓ₀) (v : V₁), f₀_add (c • v) = c • f₀_add v := by
        intro c v
        have h1lt : (1 : ℝ) < (ℓ₀ : ℝ) := Nat.one_lt_cast.mpr hPrime.one_lt
        have h0lt : (0 : ℝ) < (ℓ₀ : ℝ) := lt_trans zero_lt_one h1lt
        obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h1lt
        let w : Padic ℓ₀ := (ℓ₀ : Padic ℓ₀) ^ k * c
        have hw : ‖w‖ ≤ 1 := by
          have hpow_pos : (0 : ℝ) < (ℓ₀ : ℝ) ^ k := pow_pos h0lt k
          calc
            ‖w‖ = ‖(ℓ₀ : Padic ℓ₀) ^ k‖ * ‖c‖ := norm_mul _ _
            _ = ((ℓ₀ : ℝ) ^ k)⁻¹ * ‖c‖ := by rw [norm_pow, Padic.norm_p, inv_pow]
            _ ≤ ((ℓ₀ : ℝ) ^ k)⁻¹ * (ℓ₀ : ℝ) ^ k :=
              mul_le_mul_of_nonneg_left (le_of_lt hk) (inv_nonneg.mpr (le_of_lt hpow_pos))
            _ = 1 := inv_mul_cancel₀ (ne_of_gt hpow_pos)
        let z₀ : PadicInt ℓ₀ := ⟨w, hw⟩
        let q_k : ℚ := (((ℓ₀ ^ k : ℕ) : ℚ))⁻¹
        have hℓ_ne_padic : (ℓ₀ : Padic ℓ₀) ^ k ≠ 0 :=
          pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
        have hc_eq : (q_k : Padic ℓ₀) * (z₀ : Padic ℓ₀) = c := by
          change ((((ℓ₀ ^ k : ℕ) : ℚ)⁻¹ : ℚ) : Padic ℓ₀) * ((ℓ₀ : Padic ℓ₀) ^ k * c) = c
          rw [Rat.cast_inv, Rat.cast_natCast, Nat.cast_pow]
          exact inv_mul_cancel_left₀ hℓ_ne_padic c
        calc
          f₀_add (c • v) = f₀_add (((q_k : Padic ℓ₀) * (z₀ : Padic ℓ₀)) • v) := by rw [hc_eq]
          _ = f₀_add ((q_k : Padic ℓ₀) • ((z₀ : Padic ℓ₀) • v)) := by rw [mul_smul]
          _ = (q_k : Padic ℓ₀) • f₀_add ((z₀ : Padic ℓ₀) • v) := hf₀_rat q_k _
          _ = (q_k : Padic ℓ₀) • ((z₀ : Padic ℓ₀) • f₀_add v) := by rw [hf₀_padicInt z₀ v]
          _ = ((q_k : Padic ℓ₀) * (z₀ : Padic ℓ₀)) • f₀_add v := (mul_smul _ _ _).symm
          _ = c • f₀_add v := by rw [hc_eq]
      refine ⟨m_Q, { toFun := f₀_add, map_add' := f₀_add.map_add, map_smul' := hf₀_smul },
        hm_Q_tmul, hf₀_equiv⟩
    obtain ⟨g_Q, G, hg_Q_tmul, hG_equiv⟩ :=
      hLiftLin hL_low hTors_low equiv_low equiv_mid hsmul_low hsmul_mid g g_sys (fun _ _ => rfl)
    obtain ⟨p_Q, P, hp_Q_tmul, hP_equiv⟩ :=
      hLiftLin hL_mid hTors_mid equiv_mid equiv_high hsmul_mid hsmul_high p p_sys (fun _ _ => rfl)
    have hLin_ext :
        ∀ {A₁ : Type u} [AddCommGroup A₁] {L₁ : AddSubgroup A₁} {W₁ W₂ : Type u}
          [AddCommGroup W₁] [Module (Padic ℓ₀) W₁]
          [AddCommGroup W₂] [Module (Padic ℓ₀) W₂]
          (equiv₁ : TensorProduct ℤ ℚ ↥L₁ ≃+ W₁)
          (f₁ f₂ : W₁ →ₗ[Padic ℓ₀] W₂),
          (∀ x : ↥L₁,
            f₁ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              f₂ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))) →
          f₁ = f₂ := by
      intro A₁ _ L₁ W₁ W₂ _ _ _ _ equiv₁ f₁ f₂ hf
      ext v
      have he₁ : ∀ (q : ℚ) (x : ↥L₁),
          equiv₁ (TensorProduct.tmul ℤ q x) =
            (q : Padic ℓ₀) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x) := by
        intro q x
        have hq : TensorProduct.tmul ℤ q x = (q : ℚ) • TensorProduct.tmul ℤ (1 : ℚ) x := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hq]
        exact map_ratCast_smul equiv₁ ℚ (Padic ℓ₀) q (TensorProduct.tmul ℤ (1 : ℚ) x)
      have hv : ∀ t : TensorProduct ℤ ℚ ↥L₁, f₁ (equiv₁ t) = f₂ (equiv₁ t) := by
        intro t
        refine TensorProduct.inductionOn t ?_ ?_
        · intro q x
          rw [he₁ q x, map_smul, map_smul, hf x]
        · intro t₁ t₂ ht₁ ht₂
          rw [map_add, map_add, map_add, ht₁, ht₂]
      simpa [equiv₁.apply_symm_apply] using hv (equiv₁.symm v)
    have hF_low_mem : ∀ x : ↥L_low, (fun r => frobTors_low r (x.1 r)) ∈ L_low := by
      intro x; rw [hL_low]; intro r
      rw [hfrob_tr_low r (x.1 (r + 1)), (hL_low x.1).mp x.2 r]
    have hF_mid_mem : ∀ y : ↥L_mid, (fun r => frobTors_mid r (y.1 r)) ∈ L_mid := by
      intro y; rw [hL_mid]; intro r
      rw [hfrob_tr_mid r (y.1 (r + 1)), (hL_mid y.1).mp y.2 r]
    have hF_high_mem : ∀ z : ↥L_high, (fun r => frobTors_high r (z.1 r)) ∈ L_high := by
      intro z; rw [hL_high]; intro r
      rw [hfrob_tr_high r (z.1 (r + 1)), (hL_high z.1).mp z.2 r]
    have hG_frob : frob_mid.comp G = c₀ • (G.comp frob_low) := by
      apply hLin_ext equiv_low
      intro x
      let fx : ↥L_low := ⟨fun r => frobTors_low r (x.1 r), hF_low_mem x⟩
      let fgx : ↥L_mid := ⟨fun r => frobTors_mid r ((g_sys x).1 r), hF_mid_mem (g_sys x)⟩
      have hfgx_eq : fgx = c₀ • g_sys fx :=
        Subtype.ext (funext fun r => hg_frob r (x.1 r))
      simp only [LinearMap.comp_apply, LinearMap.smul_apply]
      rw [hG_equiv, hg_Q_tmul, hfrob_mid (g_sys x) fgx (fun _ => rfl), hfgx_eq,
        TensorProduct.tmul_smul, map_nsmul, hfrob_low x fx (fun _ => rfl), hG_equiv, hg_Q_tmul]
    have hP_frob : P.comp frob_mid = frob_high.comp P := by
      apply hLin_ext equiv_mid
      intro y
      let fy : ↥L_mid := ⟨fun r => frobTors_mid r (y.1 r), hF_mid_mem y⟩
      let fpy : ↥L_high := ⟨fun r => frobTors_high r ((p_sys y).1 r), hF_high_mem (p_sys y)⟩
      have hfpy_eq : p_sys fy = fpy :=
        Subtype.ext (funext fun r => hp_frob r (y.1 r))
      simp only [LinearMap.comp_apply]
      rw [hfrob_mid y fy (fun _ => rfl), hP_equiv, hp_Q_tmul, hP_equiv, hp_Q_tmul,
        hfrob_high (p_sys y) fpy (fun _ => rfl), hfpy_eq]
    have hKer_le_Range : ∀ v : V_mid, P v = 0 → v ∈ LinearMap.range G := by
      intro v hv0
      let t := equiv_mid.symm v
      have hpQt : p_Q t = 0 := by
        apply equiv_high.injective
        rw [map_zero, ← hP_equiv t, equiv_mid.apply_symm_apply]
        exact hv0
      let S₀ : Submonoid ℤ := nonZeroDivisors ℤ
      let f_mid : ↥L_mid →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_mid := TensorProduct.mk ℤ ℚ ↥L_mid (1 : ℚ)
      let f_high : ↥L_high →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_high := TensorProduct.mk ℤ ℚ ↥L_high (1 : ℚ)
      have : IsLocalizedModule S₀ f_mid := IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
      have : IsLocalizedModule S₀ f_high := IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
      obtain ⟨⟨y, s⟩, hst⟩ := IsLocalizedModule.surj S₀ f_mid t
      have hst_z : (s : ℤ) • t = TensorProduct.tmul ℤ (1 : ℚ) y := hst
      have hs_ne : (s : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hf_high_zero : f_high (p_sys y) = 0 := by
        change TensorProduct.tmul ℤ (1 : ℚ) (p_sys y) = 0
        rw [← hp_Q_tmul (1 : ℚ) y, ← hst_z, map_zsmul, hpQt, smul_zero]
      have hmk_zero : IsLocalizedModule.mk' f_high (p_sys y) (1 : S₀) = 0 :=
        (IsLocalizedModule.mk'_eq_zero (1 : S₀)).mpr hf_high_zero
      obtain ⟨s', hs'⟩ := (IsLocalizedModule.mk'_eq_zero' f_high (1 : S₀)).mp hmk_zero
      have hs'_z : (s' : ℤ) • p_sys y = 0 := hs'
      have hs'_ne : (s' : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      have hp_s'y : p_sys ((s' : ℤ) • y) = 0 := by rw [map_zsmul, hs'_z]
      obtain ⟨x, hx⟩ := hExact_sys ((s' : ℤ) • y) hp_s'y
      let d_int : ℤ := (s : ℤ) * (s' : ℤ)
      have hd_ne : (d_int : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (mul_ne_zero hs_ne hs'_ne)
      let q₀ : ℚ := (d_int : ℚ)⁻¹
      have hgQ_eq : g_Q (TensorProduct.tmul ℤ q₀ x) = t := by
        have h1 : (d_int : ℚ) • g_Q (TensorProduct.tmul ℤ q₀ x) =
            TensorProduct.tmul ℤ (1 : ℚ) ((s' : ℤ) • y) := by
          rw [hg_Q_tmul, hx, TensorProduct.smul_tmul', smul_eq_mul, mul_inv_cancel₀ hd_ne]
        have h2 : (d_int : ℚ) • t = TensorProduct.tmul ℤ (1 : ℚ) ((s' : ℤ) • y) := by
          rw [Int.cast_smul_eq_zsmul]
          dsimp [d_int]
          rw [mul_comm, mul_smul, hst_z, TensorProduct.tmul_smul]
        calc
          g_Q (TensorProduct.tmul ℤ q₀ x) =
              (q₀ * (d_int : ℚ)) • g_Q (TensorProduct.tmul ℤ q₀ x) := by
            rw [inv_mul_cancel₀ hd_ne, one_smul]
          _ = q₀ • ((d_int : ℚ) • g_Q (TensorProduct.tmul ℤ q₀ x)) := mul_smul _ _ _
          _ = q₀ • ((d_int : ℚ) • t) := by rw [h1, h2]
          _ = (q₀ * (d_int : ℚ)) • t := (mul_smul _ _ _).symm
          _ = t := by rw [inv_mul_cancel₀ hd_ne, one_smul]
      refine ⟨equiv_low (TensorProduct.tmul ℤ q₀ x), ?_⟩
      rw [hG_equiv, hgQ_eq, equiv_mid.apply_symm_apply]
    let K₀ := Padic ℓ₀
    let L := AlgebraicClosure K₀
    obtain ⟨r_high, hr_high⟩ :=
      LinearMap.exists_leftInverse_of_injective (LinearMap.range P).subtype
