  let isoOver : ∀ U : Y.Etale, Fgt.obj (B_id.obj U) ≅ Fgt.obj U :=
    fun U => CategoryTheory.Over.pullbackId.app (Fgt.obj U)
  let e_id : B_id ≅ CategoryTheory.Functor.id Y.Etale :=
    CategoryTheory.NatIso.ofComponents (fun U => ff.preimageIso (isoOver U)) (by
      intro U V u
      apply Fgt.map_injective
      change (CategoryTheory.Over.pullback (CategoryTheory.CategoryStruct.id Y)).map (Fgt.map u) ≫
          Fgt.map (ff.preimage (isoOver V).hom) =
