          heL_hom_inv 𝒢,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    have hmap₂ : CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ u₁ =
        CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ u₂ := by
      rw [← hrec u₁, ← hrec u₂, hv_eq]
    calc
      u₁ = (CategoryTheory.Abelian.Ext.mk₀ (eR_inv Fℤ_Y)).comp
            (((CategoryTheory.Abelian.Ext.mapExactFunctor pb₁
                (CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ u₁)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (eR_hom (pb₁.obj 𝒢))) (Nat.add_zero p)))
