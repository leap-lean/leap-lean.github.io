      @Equiv.subsingleton.symm _ _ e_HK.toEquiv (hSubOfZero _ (hZero_K I q hq))
    obtain ⟨e_EK⟩ := (hS5 f.left g_A f_A g'_A u_A f_K u_Y g'_K hu_fst hpb_u hpb_A hpb_K E).1
    let Fℤ_K := (CategoryTheory.constantSheaf Y_K.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hInj_post : Function.Injective
        ((CategoryTheory.Abelian.Ext.mk₀ e_EK.inv).postcomp Fℤ_K (Nat.add_zero q)) := by
      intro x₁ x₂ heq
      have h2 := congrArg
        ((CategoryTheory.Abelian.Ext.mk₀ e_EK.hom).postcomp Fℤ_K (Nat.add_zero q)) heq
      change (x₁.comp (CategoryTheory.Abelian.Ext.mk₀ e_EK.inv) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_EK.hom) (Nat.add_zero q) =
        (x₂.comp (CategoryTheory.Abelian.Ext.mk₀ e_EK.inv) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_EK.hom) (Nat.add_zero q) at h2
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_EK.inv_hom_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id] at h2
      exact h2
    exact ⟨hSub_EA, @Function.Injective.subsingleton _ _ _ hInj_post hSub_EK_dir⟩

theorem weil_proj_quadric_val_ring_odp_tbar_regular_and_unique_origin (m : ℕ)
    (P : Type u) [CommRing P] (X_P : P)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar]
    (p_R : P →+* R_bar)
    (t_bar : R_bar) (ht_eq : p_R X_P = t_bar) (ht_ne : t_bar ≠ 0)
    (Ω : Type u) [Field Ω]
    (φ_R_Ω : R_bar →+* Ω)
    (hLoc_Ω : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra) :
    let C_Q := AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) P ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C X_P}))
    let p_CQ : C_Q ⟶ AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
    let g_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let C_Q_R := CategoryTheory.Limits.pullback p_CQ g_R
    let C_Q_R_Ω := CategoryTheory.Limits.pullback
      (CategoryTheory.Limits.pullback.snd p_CQ g_R) j_R
    let j_CQ : C_Q_R_Ω ⟶ C_Q_R :=
      CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd p_CQ g_R) j_R
    (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ C_Q_R) [AlgebraicGeometry.Etale w],
      Nonempty ↥W →
      Nonempty ↥(CategoryTheory.Limits.pullback j_CQ w)) ∧
    (∀ [IsLocalRing R_bar] (k : Type u) [Field k]
      (o₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ C_Q),
      (∀ (idx : Fin (m + 1) × Fin 2) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (o₀.base pt).asIdeal) →
      ∀ (z₁ z₂ : ↥C_Q_R),
        (CategoryTheory.Limits.pullback.fst p_CQ g_R).base z₁ ∈ Set.range o₀.base →
        (CategoryTheory.Limits.pullback.fst p_CQ g_R).base z₂ ∈ Set.range o₀.base →
        (CategoryTheory.Limits.pullback.snd p_CQ g_R).base z₁ = IsLocalRing.closedPoint R_bar →
        (CategoryTheory.Limits.pullback.snd p_CQ g_R).base z₂ = IsLocalRing.closedPoint R_bar →
        z₁ = z₂) :=
by
  intro C_Q p_CQ g_R j_R C_Q_R C_Q_R_Ω j_CQ
  let Idx := Fin (m + 1) × Fin 2
  let Q_P : MvPolynomial Idx P :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C X_P
  let I_P : Ideal (MvPolynomial Idx P) := Ideal.span {Q_P}
  let A_P := MvPolynomial Idx P ⧸ I_P
  let Q_R : MvPolynomial Idx R_bar :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C t_bar
  let I_R : Ideal (MvPolynomial Idx R_bar) := Ideal.span {Q_R}
  let A_odp := MvPolynomial Idx R_bar ⧸ I_R
  let f_P_AP : P →+* A_P := (Ideal.Quotient.mk I_P).comp MvPolynomial.C
  let f_R_Aodp : R_bar →+* A_odp := (Ideal.Quotient.mk I_R).comp MvPolynomial.C
  have hQP_ker : ∀ a ∈ I_P, ((Ideal.Quotient.mk I_R).comp (MvPolynomial.map p_R)) a = 0 := by
    intro a ha
    rw [Ideal.mem_span_singleton] at ha
    rcases ha with ⟨c, rfl⟩
    rw [map_mul]
    have hmap : MvPolynomial.map p_R Q_P = Q_R := by
      simp [Q_P, Q_R, ht_eq]
    have h0 : ((Ideal.Quotient.mk I_R).comp (MvPolynomial.map p_R)) Q_P = 0 := by
      rw [RingHom.comp_apply, hmap, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton_self Q_R
    rw [h0, zero_mul]
  let ψ_AP_Aodp : A_P →+* A_odp :=
    Ideal.Quotient.lift I_P ((Ideal.Quotient.mk I_R).comp (MvPolynomial.map p_R)) hQP_ker
  let f_hom : CommRingCat.of P ⟶ CommRingCat.of A_P := CommRingCat.ofHom f_P_AP
  let g_hom : CommRingCat.of P ⟶ CommRingCat.of R_bar := CommRingCat.ofHom p_R
  let inl_hom : CommRingCat.of A_P ⟶ CommRingCat.of A_odp := CommRingCat.ofHom ψ_AP_Aodp
  let inr_hom : CommRingCat.of R_bar ⟶ CommRingCat.of A_odp := CommRingCat.ofHom f_R_Aodp
  have hcomm_odp : f_hom ≫ inl_hom = g_hom ≫ inr_hom := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro p
    change ψ_AP_Aodp (Ideal.Quotient.mk I_P (MvPolynomial.C p)) =
      Ideal.Quotient.mk I_R (MvPolynomial.C (p_R p))
    dsimp only [ψ_AP_Aodp]
    rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
  have hColim_odp : CategoryTheory.Limits.IsColimit
      (CategoryTheory.Limits.PushoutCocone.mk inl_hom inr_hom hcomm_odp) := by
    refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_odp
      (fun s =>
        CommRingCat.ofHom
          (Ideal.Quotient.lift I_R
            (MvPolynomial.eval₂Hom (s.inr.hom : R_bar →+* ↑s.pt)
              (fun idx => s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.X idx))))
            (by
              intro a ha
              rw [Ideal.mem_span_singleton] at ha
              rcases ha with ⟨c, rfl⟩
              rw [map_mul]
              suffices h0 :
                  (MvPolynomial.eval₂Hom (s.inr.hom : R_bar →+* ↑s.pt)
                    (fun idx => s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.X idx)))) Q_R = 0 by
                rw [h0, zero_mul]
              dsimp only [Q_R]
              rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C]
              have hXP : (s.inr.hom : R_bar →+* ↑s.pt) t_bar =
                  s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.C X_P)) := by
                rw [← ht_eq]
                exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) X_P).symm
              have hsum :
                  (∑ j : Fin (m + 1),
                    (MvPolynomial.eval₂Hom (s.inr.hom : R_bar →+* ↑s.pt)
                      (fun idx => s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.X idx))))
                      (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) =
                  s.inl.hom (Ideal.Quotient.mk I_P
                    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) := by
                rw [map_sum, map_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
                  map_mul, map_mul]
              rw [hsum, hXP, ← map_sub, ← map_sub]
              have hQP0 : Ideal.Quotient.mk I_P Q_P = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self Q_P)
              change s.inl.hom (Ideal.Quotient.mk I_P Q_P) = 0
              rw [hQP0, map_zero])))
      ?_ ?_ ?_
    · intro s
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro p
        dsimp only [inl_hom, ψ_AP_Aodp]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Ideal.Quotient.lift_mk, MvPolynomial.map_C]
        erw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
        exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) p).symm
      · intro idx
        dsimp only [inl_hom, ψ_AP_Aodp]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Ideal.Quotient.lift_mk, MvPolynomial.map_X]
        erw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · intro s
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro (r : R_bar)
      dsimp only [inr_hom, f_R_Aodp]
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      erw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s m_hom hm_l hm_r
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_C]
        exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) r
      · intro idx
        simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X']
        have hX := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l)
          (Ideal.Quotient.mk I_P (MvPolynomial.X idx))
        dsimp only [inl_hom, ψ_AP_Aodp] at hX
        simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Ideal.Quotient.lift_mk, MvPolynomial.map_X] using hX
  have hPush_odp : CategoryTheory.IsPushout f_hom g_hom inl_hom inr_hom :=
    CategoryTheory.IsPushout.of_isColimit hColim_odp
  have hPb_odp : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map inl_hom) (AlgebraicGeometry.Spec.map inr_hom) p_CQ g_R :=
    AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_hom g_hom inl_hom inr_hom hPush_odp
  let e_CQR : AlgebraicGeometry.Spec (CommRingCat.of A_odp) ≅ C_Q_R := hPb_odp.isoPullback
  have he_CQR_fst : e_CQR.hom ≫ CategoryTheory.Limits.pullback.fst p_CQ g_R =
      AlgebraicGeometry.Spec.map inl_hom := hPb_odp.isoPullback_hom_fst
  have he_CQR_snd : e_CQR.hom ≫ CategoryTheory.Limits.pullback.snd p_CQ g_R =
      AlgebraicGeometry.Spec.map inr_hom := hPb_odp.isoPullback_hom_snd

  let t_odp : A_odp := f_R_Aodp t_bar
  have ht_odp_nzd : t_odp ∈ nonZeroDivisors A_odp := by
    have h_reg : ∀ x : A_odp, t_odp * x = 0 → x = 0 := by
      intro x hx
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hmem : MvPolynomial.C t_bar * F ∈ I_R := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
        exact hx
      rw [Ideal.mem_span_singleton] at hmem
      rcases hmem with ⟨G, hFG_eq⟩
      have hPolyId : MvPolynomial.C t_bar * (F + G) =
          ∑ j : Fin (m + 1), (G * MvPolynomial.X (j, 1)) * MvPolynomial.X (j, 0) := by
        calc
          MvPolynomial.C t_bar * (F + G) = MvPolynomial.C t_bar * F + MvPolynomial.C t_bar * G :=
            mul_add _ _ _
          _ = Q_R * G + MvPolynomial.C t_bar * G := by rw [hFG_eq]
          _ = (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) * G := by
            dsimp [Q_R]
            ring
          _ = ∑ j : Fin (m + 1), (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) * G :=
            Finset.sum_mul _ _ _
          _ = ∑ j : Fin (m + 1), (G * MvPolynomial.X (j, 1)) * MvPolynomial.X (j, 0) :=
            Finset.sum_congr rfl fun j _ => by ring
      let p00 : Idx := (0, 0)
      let p01 : Idx := (0, 1)
      have hp00_ne_p01 : p00 ≠ p01 := by
        intro h
        have h2 : (0 : Fin 2) = 1 := congrArg Prod.snd h
        nomatch h2
      let e0 : Idx →₀ ℕ := Finsupp.single p00 1
      let e1 : Idx →₀ ℕ := Finsupp.single p01 1
      let B : ℕ := G.support.sup (fun μ => μ p00) + 1
      have h_zero_of_ge : ∀ d : Idx →₀ ℕ, B ≤ d p00 → G.coeff d = 0 := by
        intro d hd
        by_contra hne
        have hmem_supp : d ∈ G.support := MvPolynomial.mem_support_iff.mpr hne
        have hle : d p00 ≤ G.support.sup (fun μ => μ p00) :=
          Finset.le_sup (f := fun μ : Idx →₀ ℕ => μ p00) hmem_supp
        dsimp [B] at hd
        omega
      have h_ind : ∀ (k : ℕ) (d : Idx →₀ ℕ), B - d p00 = k → t_bar ∣ G.coeff d := by
        intro k
        induction k with
        | zero =>
          intro d hk
          have hge : B ≤ d p00 := by omega
          rw [h_zero_of_ge d hge]
          exact dvd_zero t_bar
        | succ k ih =>
          intro d hk
          let m2 : Idx →₀ ℕ := (d + e1) + e0
          have h_lhs : (MvPolynomial.C t_bar * (F + G)).coeff m2 = t_bar * (F + G).coeff m2 :=
            MvPolynomial.coeff_C_mul m2 t_bar (F + G)
          have h_eq := congrArg (MvPolynomial.lcoeff R_bar m2) hPolyId
          rw [MvPolynomial.lcoeff_apply, h_lhs, map_sum] at h_eq
          simp only [MvPolynomial.lcoeff_apply] at h_eq
          rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (0 : Fin (m + 1)))] at h_eq
          have hj0 : ((G * MvPolynomial.X ((0 : Fin (m + 1)), 1)) *
              MvPolynomial.X ((0 : Fin (m + 1)), 0)).coeff m2 = G.coeff d := by
            dsimp [m2, e0, e1, p00, p01]
            rw [MvPolynomial.coeff_mul_X, MvPolynomial.coeff_mul_X]
          rw [hj0] at h_eq
          have h_rest_dvd : t_bar ∣ ∑ j ∈ Finset.univ.erase (0 : Fin (m + 1)),
              ((G * MvPolynomial.X (j, 1)) * MvPolynomial.X (j, 0)).coeff m2 := by
            apply Finset.dvd_sum
            intro j hj
            have hj_ne : j ≠ 0 := (Finset.mem_erase.mp hj).1
            rw [MvPolynomial.coeff_mul_X']
            split_ifs with h1
            · rw [MvPolynomial.coeff_mul_X']
              split_ifs with h2
              · set d' := m2 - Finsupp.single (j, 0) 1 - Finsupp.single (j, 1) 1
                have hd'_p00 : d' p00 = d p00 + 1 := by
                  have hne1 : p00 ≠ (j, (0 : Fin 2)) := fun h => hj_ne (congrArg Prod.fst h).symm
                  have hne2 : p00 ≠ (j, (1 : Fin 2)) := fun h => hj_ne (congrArg Prod.fst h).symm
                  dsimp [d', m2, e0, e1]
                  simp [hp00_ne_p01, hne1, hne2]
                exact ih d' (by omega)
              · exact dvd_zero t_bar
            · exact dvd_zero t_bar
          have hG_eq : G.coeff d = t_bar * (F + G).coeff m2 -
              ∑ j ∈ Finset.univ.erase (0 : Fin (m + 1)),
                ((G * MvPolynomial.X (j, 1)) * MvPolynomial.X (j, 0)).coeff m2 := by
            rw [h_eq]
            ring
          rw [hG_eq]
          exact dvd_sub (dvd_mul_right t_bar _) h_rest_dvd
      have h_dvd : ∀ d : Idx →₀ ℕ, t_bar ∣ G.coeff d := fun d => h_ind (B - d p00) d rfl
      let H : MvPolynomial Idx R_bar :=
        ∑ d ∈ G.support, MvPolynomial.monomial d (Classical.choose (h_dvd d))
      have hGH : MvPolynomial.C t_bar * H = G := by
        dsimp [H]
        rw [Finset.mul_sum]
        conv_rhs => rw [MvPolynomial.as_sum G]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [MvPolynomial.C_mul_monomial, ← Classical.choose_spec (h_dvd d)]
      have hF_eq : F = Q_R * H := by
        have hmul_eq : MvPolynomial.C t_bar * F = MvPolynomial.C t_bar * (Q_R * H) := by
          rw [hFG_eq, ← hGH]
          ring
        ext d
        have hc := congrArg (MvPolynomial.lcoeff R_bar d) hmul_eq
        rw [MvPolynomial.lcoeff_apply, MvPolynomial.lcoeff_apply,
          MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul] at hc
        exact mul_left_cancel₀ ht_ne hc
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
      exact ⟨H, hF_eq⟩
    rw [mem_nonZeroDivisors_iff]
    exact ⟨fun x hx => h_reg x hx, fun x hx => h_reg x (by rwa [mul_comm])⟩

  refine ⟨?_, ?_⟩
  · intro W _ w _ hW_ne
    let R_W : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
    let E : Type u := ↑R_W
    let w_spec : AlgebraicGeometry.Spec R_W ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_odp) :=
      W.isoSpec.inv ≫ w ≫ e_CQR.inv
    have _ : AlgebraicGeometry.Etale w_spec := by
      dsimp [w_spec]
      infer_instance
    let φ_W : CommRingCat.of A_odp ⟶ R_W := AlgebraicGeometry.Spec.preimage w_spec
    have hφ_W_map : AlgebraicGeometry.Spec.map φ_W = w_spec :=
      AlgebraicGeometry.Spec.map_preimage w_spec
    have hφ_W_comp : AlgebraicGeometry.Spec.map φ_W ≫ e_CQR.hom = W.isoSpec.inv ≫ w := by
      rw [hφ_W_map]
      dsimp [w_spec]
      rw [Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have hEt_φW : RingHom.Etale φ_W.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (by rw [hφ_W_map]; infer_instance)
    let _ : Algebra A_odp E := φ_W.hom.toAlgebra
    have _ : Algebra.Etale A_odp E := RingHom.Etale.toAlgebra hEt_φW
    have hReg_E : IsSMulRegular E t_odp :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors ht_odp_nzd
    let t_E : E := φ_W.hom t_odp
    have ht_E_nzd : t_E ∈ nonZeroDivisors E := by
      have h_regE : ∀ y : E, t_E * y = 0 → y = 0 := by
        intro y hy
        apply hReg_E
        change φ_W.hom t_odp * y = φ_W.hom t_odp * 0
        rw [mul_zero]
        exact hy
      rw [mem_nonZeroDivisors_iff]
      exact ⟨fun y hy => h_regE y hy, fun y hy => h_regE y (by rwa [mul_comm])⟩
    let L := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away t_E))
    let locMap : E →+* Localization.Away t_E := algebraMap E (Localization.Away t_E)
    let locMap_hom : R_W ⟶ CommRingCat.of (Localization.Away t_E) := CommRingCat.ofHom locMap
    have hSpecE_ne : Nonempty (PrimeSpectrum E) := hW_ne.map W.isoSpec.hom.base
    have _ : Nontrivial E := PrimeSpectrum.nonempty_iff_nontrivial.mp hSpecE_ne
    have hloc_inj : Function.Injective locMap :=
      IsLocalization.injective (Localization.Away t_E) (Submonoid.powers_le.mpr ht_E_nzd)
    have _ : Nontrivial (Localization.Away t_E) := hloc_inj.nontrivial
    have hL_ne : Nonempty ↥L := PrimeSpectrum.nonempty_iff_nontrivial.mpr inferInstance
    let g_loc : R_bar →+* Localization.Away t_E := locMap.comp (φ_W.hom.comp f_R_Aodp)
    have hg_unit : IsUnit (g_loc t_bar) := by
      change IsUnit (algebraMap E (Localization.Away t_E) t_E)
      exact IsLocalization.Away.algebraMap_isUnit t_E
    let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
    have _ : IsLocalization.Away t_bar Ω := hLoc_Ω
    let ψ_Ω : Ω →+* Localization.Away t_E := IsLocalization.Away.lift t_bar hg_unit
    have hψ_comp : ψ_Ω.comp φ_R_Ω = g_loc := IsLocalization.Away.lift_comp t_bar hg_unit
    let m_W : L ⟶ W := AlgebraicGeometry.Spec.map locMap_hom ≫ W.isoSpec.inv
    let m_Ω : L ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω)
    have hcomm_L : (m_W ≫ w) ≫ CategoryTheory.Limits.pullback.snd p_CQ g_R = m_Ω ≫ j_R := by
      dsimp [m_W, m_Ω, j_R]
      rw [Category.assoc (AlgebraicGeometry.Spec.map locMap_hom),
        ← hφ_W_comp, Category.assoc, Category.assoc, he_CQR_snd,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      exact hψ_comp.symm
    let m_1 : L ⟶ C_Q_R_Ω :=
      CategoryTheory.Limits.pullback.lift (m_W ≫ w) m_Ω hcomm_L
    let Φ : L ⟶ CategoryTheory.Limits.pullback j_CQ w :=
      CategoryTheory.Limits.pullback.lift m_1 m_W
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    exact hL_ne.map Φ.base
  · intro _ k _ o₀ ho₀ z₁ z₂ hz₁_fst hz₂_fst hz₁_snd hz₂_snd
    have h_char : ∀ z : ↥C_Q_R,
        (CategoryTheory.Limits.pullback.fst p_CQ g_R).base z ∈ Set.range o₀.base →
        (CategoryTheory.Limits.pullback.snd p_CQ g_R).base z = IsLocalRing.closedPoint R_bar →
        ∀ f : MvPolynomial Idx R_bar,
          Ideal.Quotient.mk I_R f ∈ (e_CQR.inv.base z).asIdeal ↔
            f.coeff 0 ∈ IsLocalRing.maximalIdeal R_bar := by
      intro z hz_fst hz_snd f
      set q_z : PrimeSpectrum A_odp := e_CQR.inv.base z
      have hqz_hom : e_CQR.hom.base q_z = z := by
        change (e_CQR.inv ≫ e_CQR.hom).base z = z
        rw [Iso.inv_hom_id]
        rfl
      rcases hz_fst with ⟨pt, hpt⟩
      have hcomap_AP : (AlgebraicGeometry.Spec.map inl_hom).base q_z = o₀.base pt := by
        rw [← he_CQR_fst]
        change (CategoryTheory.Limits.pullback.fst p_CQ g_R).base (e_CQR.hom.base q_z) = o₀.base pt
        rw [hqz_hom, hpt]
      have hX_mem : ∀ idx : Idx, Ideal.Quotient.mk I_R (MvPolynomial.X idx) ∈ q_z.asIdeal := by
        intro idx
        have h1 : Ideal.Quotient.mk I_P (MvPolynomial.X idx) ∈
            ((AlgebraicGeometry.Spec.map inl_hom).base q_z).asIdeal := by
          rw [hcomap_AP]
          exact ho₀ idx pt
        change ψ_AP_Aodp (Ideal.Quotient.mk I_P (MvPolynomial.X idx)) ∈ q_z.asIdeal at h1
        dsimp only [ψ_AP_Aodp] at h1
        rwa [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X] at h1
      have hcomap_R : (AlgebraicGeometry.Spec.map inr_hom).base q_z =
          IsLocalRing.closedPoint R_bar := by
        rw [← he_CQR_snd]
        change (CategoryTheory.Limits.pullback.snd p_CQ g_R).base (e_CQR.hom.base q_z) =
          IsLocalRing.closedPoint R_bar
        rw [hqz_hom, hz_snd]
      have hC_mem : ∀ r : R_bar,
          Ideal.Quotient.mk I_R (MvPolynomial.C r) ∈ q_z.asIdeal ↔
            r ∈ IsLocalRing.maximalIdeal R_bar := by
        intro r
        have h2 := congrArg PrimeSpectrum.asIdeal hcomap_R
        change Ideal.comap f_R_Aodp q_z.asIdeal = IsLocalRing.maximalIdeal R_bar at h2
        simpa [Ideal.mem_comap, f_R_Aodp] using SetLike.ext_iff.mp h2 r
      let g : MvPolynomial Idx R_bar := f - MvPolynomial.C (f.coeff 0)
      have hg0 : g.coeff 0 = 0 := by
        have hsub := map_sub (MvPolynomial.lcoeff R_bar 0) f (MvPolynomial.C (f.coeff 0))
        simp only [MvPolynomial.lcoeff_apply, MvPolynomial.coeff_zero_C, sub_self] at hsub
        exact hsub
      have hg_mem : Ideal.Quotient.mk I_R g ∈ q_z.asIdeal := by
        rw [MvPolynomial.as_sum g, map_sum]
        apply Submodule.sum_mem
        intro d hd
        have hd_ne : d ≠ 0 := by
          intro hd0
          rw [hd0] at hd
          exact (MvPolynomial.mem_support_iff.mp hd) hg0
        obtain ⟨idx, hidx_ne⟩ := Finsupp.ne_iff.mp hd_ne
        have hidx_supp : idx ∈ d.support := Finsupp.mem_support_iff.mpr hidx_ne
        have hidx_pos : 0 < d idx := Nat.pos_of_ne_zero hidx_ne
        rw [MvPolynomial.monomial_eq]
        change Ideal.Quotient.mk I_R
          (MvPolynomial.C (g.coeff d) * ∏ i ∈ d.support, MvPolynomial.X i ^ d i) ∈ q_z.asIdeal
        rw [map_mul, map_prod]
        apply Ideal.mul_mem_left
        rw [← Finset.mul_prod_erase _ _ hidx_supp, map_pow]
        exact Ideal.mul_mem_right _ _
          (Ideal.pow_mem_of_mem q_z.asIdeal (hX_mem idx) (d idx) hidx_pos)
      have hf_decomp : Ideal.Quotient.mk I_R f =
          Ideal.Quotient.mk I_R (MvPolynomial.C (f.coeff 0)) + Ideal.Quotient.mk I_R g := by
        rw [← map_add]
        congr 1
        dsimp [g]
        ring
      rw [hf_decomp, Ideal.add_mem_iff_left _ hg_mem, hC_mem]
    have hq_eq : e_CQR.inv.base z₁ = e_CQR.inv.base z₂ := by
      apply PrimeSpectrum.ext
      ext a
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [h_char z₁ hz₁_fst hz₁_snd f, h_char z₂ hz₂_fst hz₂_snd f]
    calc
      z₁ = (e_CQR.inv ≫ e_CQR.hom).base z₁ := by rw [Iso.inv_hom_id]; rfl
      _ = e_CQR.hom.base (e_CQR.inv.base z₁) := rfl
      _ = e_CQR.hom.base (e_CQR.inv.base z₂) := by rw [hq_eq]
      _ = (e_CQR.inv ≫ e_CQR.hom).base z₂ := rfl
      _ = z₂ := by rw [Iso.inv_hom_id]; rfl

theorem weil_proj_quadric_val_ring_skyscraper_and_deg_zero_inj (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (k₁ : Type u) [Field k₁] [IsAlgClosed k₁]
      {X : AlgebraicGeometry.Scheme.{u}}
      (i₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ X)
      [AlgebraicGeometry.IsClosedImmersion i₀]
      (S : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id S = 0 →
      (∀ (K : Type u) [Field K] [IsAlgClosed K]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
        z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range i₀.base →
        ∃ (H_z : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback z_bar S H_z ∧
          CategoryTheory.Limits.IsZero H_z) →
      Subsingleton (S.H 0) →
      CategoryTheory.Limits.IsZero S) ∧
    (∀ {X X_U : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X),
      (∀ x : ↥X, ∃ O : X.Opens, x ∈ O ∧
        ((∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
            (w : W ⟶ O.toScheme) [AlgebraicGeometry.Etale w],
            Nonempty ↥W →
            Nonempty ↥(CategoryTheory.Limits.pullback j (w ≫ O.ι))) ∨
         (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
            (w : W ⟶ O.toScheme) [AlgebraicGeometry.Etale w]
            (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
              weilEtaleTorsionH (CategoryTheory.Limits.pullback j (w ≫ O.ι)) ℓ 0),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.snd j (w ≫ O.ι)) ℓ 0 ψ₀ →
            Function.Injective ψ₀))) →
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ X) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j w) ℓ 0 ψ₀ →
        Function.Injective ψ₀) :=
by
  classical
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hMemEtale : ∀ (W : AlgebraicGeometry.Scheme.{u}) (E : W.Etale)
      (R : CategoryTheory.Sieve E),
      R ∈ W.smallEtaleTopology E ↔
        ∀ (x : ↥E.left), ∃ (Y : W.Etale) (f : Y ⟶ E) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro W E R
    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P) (Q := P) W (le_refl P)
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      P P W
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance E R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology W.Etale => R ∈ J E) heq)).trans hiff

  have hSheafZero : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
      (E : W.Etale) (R : CategoryTheory.Sieve E),
      R ∈ W.smallEtaleTopology E →
      ∀ (s : ↥(ℱ.obj.obj (Opposite.op E))),
        (∀ {Y : W.Etale} (f : Y ⟶ E), R.arrows f → (ℱ.obj.map f.op) s = 0) →
        s = 0 := by
    intro W ℱ E R hR s hs
    exact ℱ.isSeparated E R hR s 0 (fun Y f hf => by
      change (ℱ.obj.map f.op) s = (ℱ.obj.map f.op) 0
      rw [map_zero]
      exact hs f hf)

  let mkTerm : ∀ (S : AlgebraicGeometry.Scheme.{u}), S.Etale :=
    fun S => AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)
  have hIsTerm : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (mkTerm S) :=
    fun S => CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom (Category.comp_id E.hom))
      (fun E m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))

  let fibOf : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.Functor W.Etale (Type u) :=
    fun W Ω _ w =>
      { obj := fun E =>
          { e : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E.left // e ≫ E.hom = w }
        map := fun {E₁ E₂} u =>
          TypeCat.ofHom fun e =>
            ⟨e.1 ≫ u.left,
              (Category.assoc e.1 u.left E₂.hom).trans
                ((congrArg (e.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u)).trans e.2)⟩
        map_id := fun _ => by
          ext ⟨e, he⟩
          exact Category.comp_id e
        map_comp := fun f g => by
          ext ⟨e, he⟩
          exact (Category.assoc e f.left g.left).symm }

  let ptOf : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology :=
    fun W Ω _ _ w =>
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let fib := fibOf W Ω w
      have hJoint : ∀ {E : W.Etale}, ∀ R ∈ W.smallEtaleTopology E, ∀ (e : fib.obj E),
          ∃ (Y : W.Etale) (u : Y ⟶ E) (_ : R.arrows u) (e' : fib.obj Y),
            (fib.map u) e' = e := by
        intro E R hR e
        obtain ⟨Y, u, y₀, huR, huEt, hy₀⟩ :=
          (hMemEtale W E R).mp hR (e.1.base (⊥ : PrimeSpectrum Ω))
        have _ : AlgebraicGeometry.Etale u.left := huEt
        let q := CategoryTheory.Limits.pullback.snd u.left e.1
        have _ : AlgebraicGeometry.Etale q := inferInstance
        have hq_surj : Function.Surjective q.base := by
          intro s_pt
          have hs_eq : s_pt = (⊥ : PrimeSpectrum Ω) := Subsingleton.elim _ _
          rw [hs_eq]
          obtain ⟨z_pb, _, hz_snd⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
              (f := u.left) (g := e.1) y₀ (⊥ : PrimeSpectrum Ω) hy₀
          exact ⟨z_pb, hz_snd⟩
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
          @AlgebraicGeometry.Etale
        have hsing_mem : CategoryTheory.Presieve.singleton q ∈
            AlgebraicGeometry.Scheme.precoverage P_et S_Ω :=
          (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P_et q).mpr
            ⟨hq_surj, inferInstance⟩
        have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q) ∈
            AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
          CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing_mem
        obtain ⟨Z, f_Z, ⟨W_Z, g_Z, q', hsing_q, hfZ_eq⟩, z_Z, hz_Z⟩ :=
          (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective _ hcov (𝟙 S_Ω)
        cases hsing_q
        let σ : S_Ω ⟶ CategoryTheory.Limits.pullback u.left e.1 := z_Z ≫ g_Z
        have hσ_q : σ ≫ q = 𝟙 S_Ω :=
          (Category.assoc z_Z g_Z q).trans ((congrArg (z_Z ≫ ·) hfZ_eq).trans hz_Z)
        let e'_mor : S_Ω ⟶ Y.left := σ ≫ CategoryTheory.Limits.pullback.fst u.left e.1
        have he'_u : e'_mor ≫ u.left = e.1 :=
          (Category.assoc σ (CategoryTheory.Limits.pullback.fst u.left e.1) u.left).trans
            ((congrArg (σ ≫ ·) CategoryTheory.Limits.pullback.condition).trans
              ((Category.assoc σ q e.1).symm.trans
                ((congrArg (· ≫ e.1) hσ_q).trans (Category.id_comp e.1))))
        have he'_w : e'_mor ≫ Y.hom = w :=
          (congrArg (e'_mor ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
            ((Category.assoc e'_mor u.left E.hom).symm.trans
              ((congrArg (· ≫ E.hom) he'_u).trans e.2))
        exact ⟨Y, u, huR, ⟨e'_mor, he'_w⟩, Subtype.ext he'_u⟩
      have hcof : CategoryTheory.IsCofiltered fib.Elements :=
        { toIsCofilteredOrEmpty :=
            { cone_objs := fun A B => by
                have _ : AlgebraicGeometry.Etale A.1.hom := A.1.prop
                have _ : AlgebraicGeometry.Etale B.1.hom := B.1.prop
                let fst := CategoryTheory.Limits.pullback.fst A.1.hom B.1.hom
                let snd := CategoryTheory.Limits.pullback.snd A.1.hom B.1.hom
                let E₁₂ : W.Etale :=
                  CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ A.1.hom) inferInstance
                let l : S_Ω ⟶ E₁₂.left :=
                  CategoryTheory.Limits.pullback.lift A.2.1 B.2.1 (A.2.2.trans B.2.2.symm)
                let C_el : fib.Elements :=
                  CategoryTheory.Functor.elementsMk fib E₁₂
                    ⟨l, (Category.assoc l fst A.1.hom).symm.trans
                      ((congrArg (· ≫ A.1.hom)
                        (CategoryTheory.Limits.pullback.lift_fst A.2.1 B.2.1 _)).trans A.2.2)⟩
                refine ⟨C_el,
                  ⟨CategoryTheory.MorphismProperty.Over.homMk fst rfl,
                    Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)⟩,
                  ⟨CategoryTheory.MorphismProperty.Over.homMk snd
                    CategoryTheory.Limits.pullback.condition.symm,
                    Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩,
                  trivial⟩
              cone_maps := fun A B u v => by
                have _ : AlgebraicGeometry.Etale A.1.hom := A.1.prop
                have _ : AlgebraicGeometry.Etale B.1.hom := B.1.prop
                let Δ := CategoryTheory.Limits.pullback.diagonal B.1.hom
                have _ : AlgebraicGeometry.IsOpenImmersion Δ :=
                  AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal B.1.hom
                let uv : A.1.left ⟶ CategoryTheory.Limits.pullback B.1.hom B.1.hom :=
                  CategoryTheory.Limits.pullback.lift u.1.left v.1.left
                    ((CategoryTheory.MorphismProperty.Over.w u.1).trans
                      (CategoryTheory.MorphismProperty.Over.w v.1).symm)
                let p₁ := CategoryTheory.Limits.pullback.fst Δ uv
                let j₀ := CategoryTheory.Limits.pullback.snd Δ uv
                have _ : AlgebraicGeometry.IsOpenImmersion j₀ := inferInstance
                have _ : AlgebraicGeometry.Etale j₀ := inferInstance
                let E₀ : W.Etale :=
                  CategoryTheory.MorphismProperty.Over.mk ⊤ (j₀ ≫ A.1.hom) inferInstance
                have hu_eq : A.2.1 ≫ u.1.left = B.2.1 := congrArg Subtype.val u.2
                have hv_eq : A.2.1 ≫ v.1.left = B.2.1 := congrArg Subtype.val v.2
                have hΔ_uv : B.2.1 ≫ Δ = A.2.1 ≫ uv := by
                  apply CategoryTheory.Limits.pullback.hom_ext
                  · rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                      Category.comp_id, Category.assoc,
                      CategoryTheory.Limits.pullback.lift_fst, hu_eq]
                  · rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                      Category.comp_id, Category.assoc,
                      CategoryTheory.Limits.pullback.lift_snd, hv_eq]
                let e₀ : S_Ω ⟶ E₀.left :=
                  CategoryTheory.Limits.pullback.lift B.2.1 A.2.1 hΔ_uv
                have he₀_j₀ : e₀ ≫ j₀ = A.2.1 :=
                  CategoryTheory.Limits.pullback.lift_snd _ _ _
                let Z₀ : fib.Elements :=
                  CategoryTheory.Functor.elementsMk fib E₀
                    ⟨e₀, (Category.assoc e₀ j₀ A.1.hom).symm.trans
                      ((congrArg (· ≫ A.1.hom) he₀_j₀).trans A.2.2)⟩
                let h₀ : E₀ ⟶ A.1 := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
                have hj_u : j₀ ≫ u.1.left = p₁ := by
                  have hc := congrArg
                    (· ≫ CategoryTheory.Limits.pullback.fst B.1.hom B.1.hom)
                    (CategoryTheory.Limits.pullback.condition (f := Δ) (g := uv))
                  dsimp [p₁, j₀, Δ, uv] at hc
                  rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                    Category.comp_id, Category.assoc,
                    CategoryTheory.Limits.pullback.lift_fst] at hc
                  exact hc.symm
                have hj_v : j₀ ≫ v.1.left = p₁ := by
                  have hc := congrArg
                    (· ≫ CategoryTheory.Limits.pullback.snd B.1.hom B.1.hom)
                    (CategoryTheory.Limits.pullback.condition (f := Δ) (g := uv))
                  dsimp [p₁, j₀, Δ, uv] at hc
                  rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                    Category.comp_id, Category.assoc,
                    CategoryTheory.Limits.pullback.lift_snd] at hc
                  exact hc.symm
                refine ⟨Z₀, ⟨h₀, Subtype.ext he₀_j₀⟩, ?_⟩
                ext
                change (h₀ ≫ u.1) = (h₀ ≫ v.1)
                exact CategoryTheory.MorphismProperty.Comma.Hom.ext
                  (hj_u.trans hj_v.symm) (Subsingleton.elim _ _) }
          nonempty :=
            ⟨CategoryTheory.Functor.elementsMk fib
              (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W)) ⟨w, Category.comp_id w⟩⟩ }
      have hism : CategoryTheory.InitiallySmall.{u} fib.Elements := by
        let ι_aff := AlgebraicGeometry.Scheme.AffineEtale.Spec W
        let M : Type u := CategoryTheory.SmallModel.{u} W.AffineEtale
        let e_M := CategoryTheory.equivSmallModel.{u} W.AffineEtale
        let Idx : Type u := Σ (m : M), fib.obj (ι_aff.obj (e_M.inverse.obj m))
        let φ_idx : Idx → fib.Elements := fun p =>
          CategoryTheory.Functor.elementsMk fib _ p.2
        have _ : Small.{u} ↑(Set.range φ_idx) := small_range φ_idx
        refine CategoryTheory.initiallySmall_of_small_weakly_initial_set (Set.range φ_idx) ?_
        intro A
        have hcov_aff : CategoryTheory.Sieve.coverByImage ι_aff A.1 ∈
            W.smallEtaleTopology A.1 :=
          CategoryTheory.Functor.is_cover_of_isCoverDense ι_aff W.smallEtaleTopology A.1
        obtain ⟨Y, u, ⟨A₀, g₀, u₀, hu₀_eq⟩, e_Y, he_Y⟩ := hJoint _ hcov_aff A.2
        let iso_m : ι_aff.obj A₀ ≅ ι_aff.obj (e_M.inverse.obj (e_M.functor.obj A₀)) :=
          ι_aff.mapIso (e_M.unitIso.app A₀)
        let mor_tot : ι_aff.obj (e_M.inverse.obj (e_M.functor.obj A₀)) ⟶ A.1 :=
          iso_m.inv ≫ u₀
        let e_m : fib.obj (ι_aff.obj (e_M.inverse.obj (e_M.functor.obj A₀))) :=
          (fib.map (g₀ ≫ iso_m.hom)) e_Y
        have hm_eq : (fib.map mor_tot) e_m = A.2 := by
          dsimp [e_m, mor_tot]
          have hcomp : (g₀ ≫ iso_m.hom) ≫ iso_m.inv ≫ u₀ = u := by
            rw [Category.assoc, ← Category.assoc iso_m.hom, iso_m.hom_inv_id,
              Category.id_comp, hu₀_eq]
          have hmap := congrArg (fun k => (fib.map k) e_Y) hcomp
          rw [fib.map_comp] at hmap
          exact hmap.trans he_Y
        exact ⟨φ_idx ⟨e_M.functor.obj A₀, e_m⟩, ⟨_, rfl⟩, ⟨⟨mor_tot, hm_eq⟩⟩⟩
      CategoryTheory.GrothendieckTopology.Point.mk fib hcof hism hJoint

  have hPi_id : ∀ {I₁ I₂ : Type u} (f : I₁ → I₂) (g : I₂ → I₁)
      (hfg : ∀ x, g (f x) = x) (M : AddCommGrpCat.{u}),
      (CategoryTheory.Limits.Pi.lift fun (y : I₂) =>
          CategoryTheory.Limits.Pi.π (fun (_ : I₁) => M) (g y)) ≫
        (CategoryTheory.Limits.Pi.lift fun (x : I₁) =>
          CategoryTheory.Limits.Pi.π (fun (_ : I₂) => M) (f x)) =
        𝟙 (∏ᶜ fun (_ : I₁) => M) := by
    intro I₁ I₂ f g hfg M
    apply CategoryTheory.Limits.Pi.hom_ext
    intro x
    simp [hfg x]

  have hPi_map' : ∀ {I₁ I₂ J₁ J₂ : Type u}
      (f₁ : J₁ → I₁) (f₂ : J₂ → I₂) (α₁ : I₂ → I₁) (α₂ : J₂ → J₁)
      (hcomm : ∀ s : J₂, f₁ (α₂ s) = α₁ (f₂ s)) (M : AddCommGrpCat.{u}),
      (CategoryTheory.Limits.Pi.map' f₁ fun _ => 𝟙 M) ≫
        (CategoryTheory.Limits.Pi.lift fun (s : J₂) =>
          CategoryTheory.Limits.Pi.π (fun (_ : J₁) => M) (α₂ s)) =
      (CategoryTheory.Limits.Pi.lift fun (t : I₂) =>
          CategoryTheory.Limits.Pi.π (fun (_ : I₁) => M) (α₁ t)) ≫
        (CategoryTheory.Limits.Pi.map' f₂ fun _ => 𝟙 M) := by
    intro I₁ I₂ J₁ J₂ f₁ f₂ α₁ α₂ hcomm M
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp [hcomm s]

  have hPi_map : ∀ {I₁ I₂ : Type u} (α : I₂ → I₁) {M₁ M₂ : AddCommGrpCat.{u}} (φ : M₁ ⟶ M₂),
      (CategoryTheory.Limits.Pi.map fun (_ : I₁) => φ) ≫
        (CategoryTheory.Limits.Pi.lift fun (s : I₂) =>
          CategoryTheory.Limits.Pi.π (fun (_ : I₁) => M₂) (α s)) =
      (CategoryTheory.Limits.Pi.lift fun (s : I₂) =>
          CategoryTheory.Limits.Pi.π (fun (_ : I₁) => M₁) (α s)) ≫
        (CategoryTheory.Limits.Pi.map fun (_ : I₂) => φ) := by
    intro I₁ I₂ α M₁ M₂ φ
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp

  refine ⟨?_, ?_⟩
  · 
    intro k₁ _ _ X i₀ _ S _ hOut hSubH0

    have hStalkZeroOut : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X),
        z_bar.base (⊥ : PrimeSpectrum Ω) ∉ Set.range i₀.base →
        CategoryTheory.Limits.IsZero ((ptOf X Ω z_bar).sheafFiber.obj S) := by
      intro Ω _ _ z_bar hz_not_mem
      obtain ⟨H_z, ⟨hc, hr, ⟨e₀⟩⟩, hZero_Hz⟩ := hOut Ω z_bar hz_not_mem
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let Φ₀ := ptOf S_Ω Ω (𝟙 S_Ω)
      let Φ_z := ptOf X Ω z_bar
      let B := weilEtaleSitePullback z_bar
      let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ X.smallEtaleTopology S_Ω.smallEtaleTopology hc
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        B AddCommGrpCat.{u} _ X.smallEtaleTopology S_Ω.smallEtaleTopology hc hr
      let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        B AddCommGrpCat.{u} _ X.smallEtaleTopology S_Ω.smallEtaleTopology hc hr
      let α : ∀ (E : X.Etale), Φ₀.fiber.obj (B.obj E) ≃ Φ_z.fiber.obj E := fun E =>
        { toFun := fun t =>
            ⟨t.1 ≫ CategoryTheory.Limits.pullback.fst E.hom z_bar,
              (Category.assoc t.1 (CategoryTheory.Limits.pullback.fst E.hom z_bar) E.hom).trans
                ((congrArg (t.1 ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                  ((Category.assoc t.1 (CategoryTheory.Limits.pullback.snd E.hom z_bar) z_bar).symm.trans
                    ((congrArg (· ≫ z_bar) t.2).trans (Category.id_comp z_bar))))⟩
          invFun := fun s =>
            ⟨CategoryTheory.Limits.pullback.lift s.1 (𝟙 S_Ω)
              (s.2.trans (Category.id_comp z_bar).symm),
              CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
          left_inv := fun t => by
            apply Subtype.ext
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
            · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans t.2.symm
          right_inv := fun s => Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _) }
      have hα_symm : ∀ {E₁ E₂ : X.Etale} (u : E₁ ⟶ E₂) (s : Φ_z.fiber.obj E₁),
          (Φ₀.fiber.map (B.map u)) ((α E₁).symm s) =
            (α E₂).symm ((Φ_z.fiber.map u) s) := by
        intro E₁ E₂ u s
        apply Subtype.ext
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hB_fst : (B.map u).left ≫ CategoryTheory.Limits.pullback.fst E₂.hom z_bar =
              CategoryTheory.Limits.pullback.fst E₁.hom z_bar ≫ u.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hlhs : (((α E₁).symm s).1 ≫ (B.map u).left) ≫
              CategoryTheory.Limits.pullback.fst E₂.hom z_bar = s.1 ≫ u.left :=
            (Category.assoc _ _ _).trans
              ((congrArg (((α E₁).symm s).1 ≫ ·) hB_fst).trans
                ((Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ u.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
          have hrhs : ((α E₂).symm ((Φ_z.fiber.map u) s)).1 ≫
              CategoryTheory.Limits.pullback.fst E₂.hom z_bar = s.1 ≫ u.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          exact hlhs.trans hrhs.symm
        · have hB_snd : (B.map u).left ≫ CategoryTheory.Limits.pullback.snd E₂.hom z_bar =
              CategoryTheory.Limits.pullback.snd E₁.hom z_bar :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hlhs : (((α E₁).symm s).1 ≫ (B.map u).left) ≫
              CategoryTheory.Limits.pullback.snd E₂.hom z_bar = 𝟙 S_Ω :=
            (Category.assoc _ _ _).trans
              ((congrArg (((α E₁).symm s).1 ≫ ·) hB_snd).trans
                (CategoryTheory.Limits.pullback.lift_snd _ _ _))
          have hrhs : ((α E₂).symm ((Φ_z.fiber.map u) s)).1 ≫
              CategoryTheory.Limits.pullback.snd E₂.hom z_bar = 𝟙 S_Ω :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          exact hlhs.trans hrhs.symm
      have hα_fwd : ∀ {E₁ E₂ : X.Etale} (u : E₁ ⟶ E₂) (t : Φ₀.fiber.obj (B.obj E₁)),
          (Φ_z.fiber.map u) (α E₁ t) = α E₂ ((Φ₀.fiber.map (B.map u)) t) := by
        intro E₁ E₂ u t
        apply (α E₂).symm.injective
        rw [← hα_symm u (α E₁ t), (α E₁).symm_apply_apply, (α E₂).symm_apply_apply]
      let sky₀ := Φ₀.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let sky_z := Φ_z.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let comp_sky : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
        sky₀ ⋙ pf
      let e_sky : comp_sky ≅ sky_z :=
        CategoryTheory.NatIso.ofComponents
          (fun M =>
            { hom :=
                { hom :=
                    { app := fun j =>
                        CategoryTheory.Limits.Pi.lift fun (s : Φ_z.fiber.obj j.unop) =>
                          CategoryTheory.Limits.Pi.π (fun (_ : Φ₀.fiber.obj (B.obj j.unop)) => M)
                            ((α j.unop).symm s)
                      naturality := fun {j₁ j₂} f => by
                        change ((Φ₀.skyscraperPresheafFunctor.obj M).map (B.map f.unop).op) ≫ _ =
                          _ ≫ ((Φ_z.skyscraperPresheafFunctor.obj M).map f)
                        rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                          CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                        exact hPi_map'
                          (Φ₀.fiber.map (B.map f.unop))
                          (Φ_z.fiber.map f.unop)
                          ((α j₁.unop).symm)
                          ((α j₂.unop).symm)
                          (fun s => hα_symm f.unop s) M } }
              inv :=
                { hom :=
                    { app := fun j =>
                        CategoryTheory.Limits.Pi.lift fun (t : Φ₀.fiber.obj (B.obj j.unop)) =>
                          CategoryTheory.Limits.Pi.π (fun (_ : Φ_z.fiber.obj j.unop) => M)
                            (α j.unop t)
                      naturality := fun {j₁ j₂} f => by
                        change ((Φ_z.skyscraperPresheafFunctor.obj M).map f) ≫ _ =
                          _ ≫ ((Φ₀.skyscraperPresheafFunctor.obj M).map (B.map f.unop).op)
                        rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                          CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                        exact hPi_map'
                          (Φ_z.fiber.map f.unop)
                          (Φ₀.fiber.map (B.map f.unop))
                          (α j₁.unop)
                          (α j₂.unop)
                          (fun t => hα_fwd f.unop t) M } }
              hom_inv_id := by
                apply CategoryTheory.Sheaf.hom_ext
                ext j : 2
                exact hPi_id (fun t => α j.unop t) (fun s => (α j.unop).symm s)
                  (fun t => (α j.unop).symm_apply_apply t) M
              inv_hom_id := by
                apply CategoryTheory.Sheaf.hom_ext
                ext j : 2
                exact hPi_id (fun s => (α j.unop).symm s) (fun t => α j.unop t)
                  (fun s => (α j.unop).apply_symm_apply s) M })
          (fun {M₁ M₂} φ => by
            apply CategoryTheory.Sheaf.hom_ext
            ext j : 2
            change ((Φ₀.skyscraperPresheafFunctor.map φ).app (Opposite.op (B.obj j.unop))) ≫ _ =
              _ ≫ ((Φ_z.skyscraperPresheafFunctor.map φ).app j)
            rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app,
              CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app]
            exact hPi_map (fun s => (α j.unop).symm s) φ)
      let adj_comp := (adj.comp (Φ₀.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))).ofNatIsoRight e_sky
      let e_fib := adj_comp.leftAdjointUniq (Φ_z.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))
      have hZero_pb : CategoryTheory.Limits.IsZero (pb.obj S) :=
        CategoryTheory.Limits.IsZero.of_iso hZero_Hz e₀
      have hZero_fib0 : CategoryTheory.Limits.IsZero
          ((Φ₀.sheafFiber (A := AddCommGrpCat.{u})).obj (pb.obj S)) :=
        (Φ₀.sheafFiber (A := AddCommGrpCat.{u})).map_isZero hZero_pb
      exact CategoryTheory.Limits.IsZero.of_iso hZero_fib0 (e_fib.app S).symm

    have hLocalVanishOut : ∀ (E : X.Etale) (s : ↥(S.obj.obj (Opposite.op E))) (z : ↥E.left),
        E.hom.base z ∉ Set.range i₀.base →
        ∃ (E' : X.Etale) (u : E' ⟶ E),
          AlgebraicGeometry.Etale u.left ∧ z ∈ Set.range u.left.base ∧ (S.obj.map u.op) s = 0 := by
      intro E s z hz_out
      let Ω_z : Type u := AlgebraicClosure ↥(E.left.residueField z)
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω_z)
      let z_E : S_Ω ⟶ E.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(E.left.residueField z) Ω_z)) ≫
          E.left.fromSpecResidueField z
      have hz_E_pt : z_E.base (⊥ : PrimeSpectrum Ω_z) = z := by
        have hmem : z_E.base (⊥ : PrimeSpectrum Ω_z) ∈
            Set.range (E.left.fromSpecResidueField z).base :=
          ⟨(AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥(E.left.residueField z) Ω_z))).base (⊥ : PrimeSpectrum Ω_z),
            rfl⟩
        rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField z, Set.mem_singleton_iff] at hmem
      let z_bar : S_Ω ⟶ X := z_E ≫ E.hom
      have hz_bar_out : z_bar.base (⊥ : PrimeSpectrum Ω_z) ∉ Set.range i₀.base := by
        change E.hom.base (z_E.base (⊥ : PrimeSpectrum Ω_z)) ∉ Set.range i₀.base
        rwa [hz_E_pt]
      have hZ_stalk := hStalkZeroOut Ω_z z_bar hz_bar_out
      let Φ_z := ptOf X Ω_z z_bar
      let pt_E : Φ_z.fiber.obj E := ⟨z_E, rfl⟩
      have hmap_zero : Φ_z.toPresheafFiber E pt_E S.obj = 0 := hZ_stalk.eq_of_tgt _ 0
      have hrep_eq : (Φ_z.toPresheafFiber E pt_E S.obj).hom s =
          (Φ_z.toPresheafFiber E pt_E S.obj).hom (0 : ↥(S.obj.obj (Opposite.op E))) := by
        rw [hmap_zero]
        rfl
      obtain ⟨E', u, pt_E', hu_pt, hu_sec⟩ :=
        (Φ_z.toPresheafFiber_eq_iff' E pt_E s (0 : ↥(S.obj.obj (Opposite.op E)))).mp hrep_eq
      have _ : AlgebraicGeometry.Etale E.hom := E.prop
      have _ : AlgebraicGeometry.Etale E'.hom := E'.prop
      have hu_et : AlgebraicGeometry.Etale u.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) u.left E.hom E.prop
          (by rw [CategoryTheory.MorphismProperty.Over.w u]; exact E'.prop)
      have hz_range : z ∈ Set.range u.left.base := by
        refine ⟨pt_E'.1.base (⊥ : PrimeSpectrum Ω_z), ?_⟩
        have h1 : pt_E'.1 ≫ u.left = z_E := congrArg Subtype.val hu_pt
        change (pt_E'.1 ≫ u.left).base (⊥ : PrimeSpectrum Ω_z) = z
        rw [h1, hz_E_pt]
      rw [map_zero] at hu_sec
      exact ⟨E', u, hu_et, hz_range, hu_sec⟩

    have hGlobalVanishOut : ∀ (E : X.Etale),
        (∀ z : ↥E.left, E.hom.base z ∉ Set.range i₀.base) →
        ∀ s : ↥(S.obj.obj (Opposite.op E)), s = 0 := by
      intro E hE_out s
      let R_s : CategoryTheory.Sieve E :=
        { arrows := fun _ u => (S.obj.map u.op) s = 0
          downward_closed := fun {Y Z} u hu v => by
            rw [op_comp, S.obj.map_comp]
            change (S.obj.map v.op) ((S.obj.map u.op) s) = 0
            rw [hu, map_zero] }
      have hRs : R_s ∈ X.smallEtaleTopology E := by
        refine (hMemEtale X E R_s).mpr fun z => ?_
        obtain ⟨E', u, hu_et, ⟨y, hy⟩, hu_s⟩ := hLocalVanishOut E s z (hE_out z)
        exact ⟨E', u, y, hu_s, hu_et, hy⟩
      exact hSheafZero S E R_s hRs s (fun _ hf => hf)

    let S₁ := AlgebraicGeometry.Spec (CommRingCat.of k₁)
    let x₀ : ↥X := i₀.base (⊥ : PrimeSpectrum k₁)
    have hRange_i₀ : Set.range i₀.base = {x₀} := by
      ext x
      simp only [Set.mem_range, Set.mem_singleton_iff]
      exact ⟨fun ⟨pt, hpt⟩ => hpt ▸ congrArg i₀.base (Subsingleton.elim pt (⊥ : PrimeSpectrum k₁)),
        fun hx => ⟨(⊥ : PrimeSpectrum k₁), hx.symm⟩⟩
    let T_X : X.Etale := mkTerm X
    have hT_X : CategoryTheory.Limits.IsTerminal T_X := hIsTerm X
    have hSub_TX : Subsingleton ↥(S.obj.obj (Opposite.op T_X)) :=
      (CategoryTheory.Sheaf.H.equiv₀ S hT_X).symm.toEquiv.subsingleton

    have hLocalVanishIn : ∀ (E : X.Etale) (s : ↥(S.obj.obj (Opposite.op E))) (y₀ : ↥E.left),
        E.hom.base y₀ = x₀ →
        ∃ (E' : X.Etale) (u : E' ⟶ E),
          AlgebraicGeometry.Etale u.left ∧ y₀ ∈ Set.range u.left.base ∧ (S.obj.map u.op) s = 0 := by
      intro E s y₀ hy₀_eq
      have _ : AlgebraicGeometry.Etale E.hom := E.prop
      obtain ⟨U_X, hAff_UX, hx₀_UX, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x₀) (U := (⊤ : X.Opens)) trivial
      have hy₀_pre : y₀ ∈ (TopologicalSpace.Opens.map E.hom.base).obj U_X := by
        change E.hom.base y₀ ∈ U_X
        rwa [hy₀_eq]
      obtain ⟨V₀, hAff_V₀, hy₀_V₀, hV₀_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := y₀) (U := (TopologicalSpace.Opens.map E.hom.base).obj U_X) hy₀_pre
      let R_cat : CommRingCat.{u} := X.presheaf.obj (Opposite.op U_X)
      let B_cat : CommRingCat.{u} := E.left.presheaf.obj (Opposite.op V₀)
      let R_alg : Type u := ↑R_cat
      let B_alg : Type u := ↑B_cat
      let ι_R : AlgebraicGeometry.Spec R_cat ⟶ X := hAff_UX.fromSpec
      let ι_B : AlgebraicGeometry.Spec B_cat ⟶ E.left := hAff_V₀.fromSpec
      let q₀ : PrimeSpectrum B_alg := hAff_V₀.isoSpec.hom.base ⟨y₀, hy₀_V₀⟩
      have hι_B_q₀ : ι_B.base q₀ = y₀ := by
        change (hAff_V₀.isoSpec.inv ≫ V₀.ι).base (hAff_V₀.isoSpec.hom.base ⟨y₀, hy₀_V₀⟩) = y₀
        have h1 : hAff_V₀.isoSpec.inv.base (hAff_V₀.isoSpec.hom.base ⟨y₀, hy₀_V₀⟩) = ⟨y₀, hy₀_V₀⟩ := by
          change (hAff_V₀.isoSpec.hom ≫ hAff_V₀.isoSpec.inv).base ⟨y₀, hy₀_V₀⟩ = ⟨y₀, hy₀_V₀⟩
          rw [hAff_V₀.isoSpec.hom_inv_id]
          rfl
        change V₀.ι.base (hAff_V₀.isoSpec.inv.base (hAff_V₀.isoSpec.hom.base ⟨y₀, hy₀_V₀⟩)) = y₀
        rw [h1]
        rfl
      have hRange_ιR : Set.range ι_R.base = (U_X : Set ↥X) := by
        ext x
        constructor
        · rintro ⟨q, rfl⟩
          exact (hAff_UX.isoSpec.inv.base q).2
        · intro hx
          refine ⟨hAff_UX.isoSpec.hom.base ⟨x, hx⟩, ?_⟩
          have h1 : hAff_UX.isoSpec.inv.base (hAff_UX.isoSpec.hom.base ⟨x, hx⟩) = ⟨x, hx⟩ := by
            change (hAff_UX.isoSpec.hom ≫ hAff_UX.isoSpec.inv).base ⟨x, hx⟩ = ⟨x, hx⟩
            rw [hAff_UX.isoSpec.hom_inv_id]
            rfl
          change U_X.ι.base (hAff_UX.isoSpec.inv.base (hAff_UX.isoSpec.hom.base ⟨x, hx⟩)) = x
          rw [h1]
          rfl
      have hRange_BR : Set.range (ι_B ≫ E.hom).base ⊆ Set.range ι_R.base := by
        rw [hRange_ιR]
        rintro _ ⟨q, rfl⟩
        have hq_V₀ : ι_B.base q ∈ V₀ := by
          change (hAff_V₀.isoSpec.inv ≫ V₀.ι).base q ∈ V₀
          exact (hAff_V₀.isoSpec.inv.base q).2
        exact hV₀_sub hq_V₀
      let f_BR : AlgebraicGeometry.Spec B_cat ⟶ AlgebraicGeometry.Spec R_cat :=
        AlgebraicGeometry.IsOpenImmersion.lift ι_R (ι_B ≫ E.hom) hRange_BR
      have hf_BR : f_BR ≫ ι_R = ι_B ≫ E.hom :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_R (ι_B ≫ E.hom) hRange_BR
      have _ : AlgebraicGeometry.Etale f_BR :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) f_BR ι_R
          (inferInstance : AlgebraicGeometry.Etale ι_R)
          (by rw [hf_BR]; infer_instance)
      let φ_RB : R_cat ⟶ B_cat := AlgebraicGeometry.Spec.preimage f_BR
      have hSpec_φRB : AlgebraicGeometry.Spec.map φ_RB = f_BR :=
        AlgebraicGeometry.Spec.map_preimage f_BR
      have hEt_φRB : φ_RB.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (by rw [hSpec_φRB]; infer_instance)

      have hRange_iR : Set.range i₀.base ⊆ Set.range ι_R.base := by
        rw [hRange_i₀, hRange_ιR, Set.singleton_subset_iff]
        exact hx₀_UX
      let i_R : S₁ ⟶ AlgebraicGeometry.Spec R_cat :=
        AlgebraicGeometry.IsOpenImmersion.lift ι_R i₀ hRange_iR
      have hi_R : i_R ≫ ι_R = i₀ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_R i₀ hRange_iR
      have _ : AlgebraicGeometry.IsClosedImmersion (i_R ≫ ι_R) := by
        rw [hi_R]; infer_instance
      have _ : AlgebraicGeometry.IsClosedImmersion i_R :=
        AlgebraicGeometry.IsClosedImmersion.of_comp i_R ι_R
      let π_Rk : R_cat ⟶ CommRingCat.of k₁ := AlgebraicGeometry.Spec.preimage i_R
      have hSpec_πRk : AlgebraicGeometry.Spec.map π_Rk = i_R :=
        AlgebraicGeometry.Spec.map_preimage i_R
      have hπ_surj : Function.Surjective π_Rk.hom := by
        obtain ⟨I_id, e_cl, he_cl⟩ := (AlgebraicGeometry.IsClosedImmersion.Spec_iff (f := i_R)).mp inferInstance
        intro c
        obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective ((AlgebraicGeometry.Spec.preimage e_cl.inv).hom c)
        refine ⟨r, ?_⟩
        have hpre : π_Rk = CommRingCat.ofHom (Ideal.Quotient.mk I_id) ≫
            AlgebraicGeometry.Spec.preimage e_cl.hom := by
          dsimp [π_Rk]
          rw [he_cl, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
        rw [hpre]
        change (AlgebraicGeometry.Spec.preimage e_cl.hom).hom ((Ideal.Quotient.mk I_id) r) = c
        rw [hr]
        change (AlgebraicGeometry.Spec.preimage e_cl.inv ≫
          AlgebraicGeometry.Spec.preimage e_cl.hom).hom c = c
        rw [← AlgebraicGeometry.Spec.preimage_comp, e_cl.hom_inv_id, AlgebraicGeometry.Spec.preimage_id]
        rfl

      let p₀ : PrimeSpectrum R_alg := i_R.base (⊥ : PrimeSpectrum k₁)
      have hι_R_p₀ : ι_R.base p₀ = x₀ := by
        change (i_R ≫ ι_R).base (⊥ : PrimeSpectrum k₁) = x₀
        rw [hi_R]
      have hf_q₀_p₀ : f_BR.base q₀ = p₀ := by
        apply ι_R.isOpenEmbedding.injective
        change (f_BR ≫ ι_R).base q₀ = ι_R.base p₀
        rw [hf_BR, hι_R_p₀]
        change E.hom.base (ι_B.base q₀) = x₀
        rw [hι_B_q₀, hy₀_eq]
      have hp₀_ideal : p₀.asIdeal = RingHom.ker π_Rk.hom := by
        have hp₀_eq : p₀ = (AlgebraicGeometry.Spec.map π_Rk).base (⊥ : PrimeSpectrum k₁) := by
          rw [hSpec_πRk]
        rw [hp₀_eq]
        ext r
        change π_Rk.hom r ∈ (⊥ : Ideal k₁) ↔ r ∈ RingHom.ker π_Rk.hom
        rw [Ideal.mem_bot, RingHom.mem_ker]
      have hq₀_comap : Ideal.comap φ_RB.hom q₀.asIdeal = RingHom.ker π_Rk.hom := by
        rw [← hp₀_ideal, ← hf_q₀_p₀, ← hSpec_φRB]
        rfl

      let _ : Algebra R_alg B_alg := φ_RB.hom.toAlgebra
      let _ : Algebra R_alg k₁ := π_Rk.hom.toAlgebra
      have _ : Algebra.Etale R_alg B_alg := RingHom.etale_algebraMap.mp hEt_φRB
      let C_fib : Type u := TensorProduct R_alg k₁ B_alg
      have _ : Algebra.Etale k₁ C_fib := inferInstance
      let ν : B_alg →+* C_fib :=
        (Algebra.TensorProduct.includeRight : B_alg →ₐ[R_alg] C_fib).toRingHom
      have hν_surj : Function.Surjective ν := by
        intro t
        refine TensorProduct.induction_on (motive := fun z => ∃ b, ν b = z) t
          ⟨0, map_zero ν⟩ ?_ ?_
        · intro c b
          obtain ⟨r, rfl⟩ := hπ_surj c
          refine ⟨φ_RB.hom r * b, ?_⟩
          dsimp [ν]
          change (1 : k₁) ⊗ₜ[R_alg] (r • b) = (π_Rk.hom r) ⊗ₜ[R_alg] b
          have hr1 : r • (1 : k₁) = π_Rk.hom r := mul_one (π_Rk.hom r)
          rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul', hr1]
        · rintro x y ⟨b₁, rfl⟩ ⟨b₂, rfl⟩
          exact ⟨b₁ + b₂, map_add ν b₁ b₂⟩
      let m₀ : Ideal R_alg := RingHom.ker π_Rk.hom
      let J_fib : Ideal B_alg := Ideal.map φ_RB.hom m₀
      have hJ_le_q₀ : J_fib ≤ q₀.asIdeal := by
        rw [Ideal.map_le_iff_le_comap, hq₀_comap]
      have hker_ν_le : RingHom.ker ν ≤ J_fib := by
        intro b hb
        rw [RingHom.mem_ker] at hb
        let Q_J := B_alg ⧸ J_fib
        let α_k : k₁ →+* Q_J :=
          (Ideal.Quotient.lift m₀ ((Ideal.Quotient.mk J_fib).comp φ_RB.hom)
            (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem φ_RB.hom hr))).comp
            (RingHom.quotientKerEquivOfSurjective hπ_surj).symm.toRingHom
        have hα_apply : ∀ r : R_alg, α_k (π_Rk.hom r) = Ideal.Quotient.mk J_fib (φ_RB.hom r) := by
          intro r
          dsimp [α_k]
          have h1 : (RingHom.quotientKerEquivOfSurjective hπ_surj).symm (π_Rk.hom r) =
              Ideal.Quotient.mk m₀ r := by
            apply (RingHom.quotientKerEquivOfSurjective hπ_surj).injective
            rw [RingEquiv.apply_symm_apply, RingHom.quotientKerEquivOfSurjective_apply_mk]
          rw [h1, Ideal.Quotient.lift_mk]
          rfl
        let B_bilin : k₁ →ₗ[R_alg] B_alg →ₗ[R_alg] Q_J :=
          { toFun := fun c =>
              { toFun := fun x => α_k c * Ideal.Quotient.mk J_fib x
                map_add' := fun x₁ x₂ => by rw [map_add, mul_add]
                map_smul' := fun r x => by
                  change α_k c * Ideal.Quotient.mk J_fib (φ_RB.hom r * x) =
                    Ideal.Quotient.mk J_fib (φ_RB.hom r) * (α_k c * Ideal.Quotient.mk J_fib x)
                  rw [map_mul, mul_left_comm] }
            map_add' := fun c₁ c₂ => by
              ext x; simp [map_add, add_mul]
            map_smul' := fun r c => by
              ext x
              change α_k (π_Rk.hom r * c) * Ideal.Quotient.mk J_fib x =
                Ideal.Quotient.mk J_fib (φ_RB.hom r) * (α_k c * Ideal.Quotient.mk J_fib x)
              rw [map_mul, hα_apply r, mul_assoc] }
        have hzero_J : Ideal.Quotient.mk J_fib b = 0 := by
          have h1 := congrArg (TensorProduct.lift B_bilin) hb
          rw [map_zero] at h1
          change α_k 1 * Ideal.Quotient.mk J_fib b = 0 at h1
          rwa [map_one, one_mul] at h1
        exact Ideal.Quotient.eq_zero_iff_mem.mp hzero_J

      obtain ⟨I_idx, hFinI, L_fam, hFieldL, hAlgL, Θ, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k₁ C_fib).mp inferInstance
      have _ : Finite I_idx := hFinI
      let _ : Fintype I_idx := Fintype.ofFinite I_idx
      let _ : ∀ i, Field (L_fam i) := hFieldL
      let _ : ∀ i, Algebra k₁ (L_fam i) := hAlgL
      have hSurj_L : ∀ i : I_idx, Function.Surjective (algebraMap k₁ (L_fam i)) := by
        intro i y
        have _ : Module.Finite k₁ (L_fam i) := (hFinSep i).1
        have hy_int : _root_.IsIntegral k₁ y := Algebra.IsIntegral.isIntegral y
        let mp := minpoly k₁ y
        have hm_deg : mp.degree ≠ 0 :=
          ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root mp hm_deg
        obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
        have hq_unit : IsUnit q_pol :=
          ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
            (Polynomial.not_isUnit_X_sub_C c)
        have hq_monic : q_pol.Monic :=
          Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
            (hq_pol ▸ minpoly.monic hy_int)
        have hq1 : q_pol = 1 := by
          have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
          have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
          rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
        have hm_eq : mp = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
        have haeval : Polynomial.aeval y mp = 0 := minpoly.aeval k₁ y
        rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
        exact ⟨c, haeval.symm⟩
      let e_L : ∀ i : I_idx, k₁ ≃+* L_fam i := fun i =>
        RingEquiv.ofBijective (algebraMap k₁ (L_fam i)) ⟨RingHom.injective _, hSurj_L i⟩
      let e_prod : (∀ i : I_idx, L_fam i) ≃+* (I_idx → k₁) :=
        RingEquiv.piCongrRight fun i => (e_L i).symm
      let ψ : B_alg →+* (I_idx → k₁) :=
        e_prod.toRingHom.comp (Θ.toRingHom.comp ν)
      have hψ_surj : Function.Surjective ψ :=
        e_prod.surjective.comp (Θ.surjective.comp hν_surj)
      have hker_ψ : RingHom.ker ψ = RingHom.ker ν := by
        ext b
        simp only [RingHom.mem_ker, ψ, RingHom.comp_apply]
        exact ⟨fun h => Θ.injective (e_prod.injective (h.trans (map_zero e_prod).symm) |>.trans
          (map_zero Θ).symm), fun h => by rw [h, map_zero, map_zero]⟩
      have hψ_R : ∀ (r : R_alg) (i : I_idx), ψ (φ_RB.hom r) i = π_Rk.hom r := by
        intro r i
        have hν_r : ν (φ_RB.hom r) = algebraMap k₁ C_fib (π_Rk.hom r) := by
          dsimp [ν]
          rw [Algebra.TensorProduct.algebraMap_apply]
          have hr_one : φ_RB.hom r = r • (1 : B_alg) := by
            change φ_RB.hom r = φ_RB.hom r * 1
            rw [mul_one]
          have hr_k1 : r • (1 : k₁) = algebraMap k₁ k₁ (π_Rk.hom r) := mul_one (π_Rk.hom r)
          rw [hr_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul', hr_k1]
        change (e_L i).symm (Θ (ν (φ_RB.hom r)) i) = π_Rk.hom r
        rw [hν_r, Θ.commutes]
        change (e_L i).symm (e_L i (π_Rk.hom r)) = π_Rk.hom r
        exact (e_L i).symm_apply_apply _

      let g_fam : I_idx → B_alg := fun i => Classical.choose (hψ_surj (Pi.single i 1))
      have hg_fam : ∀ i : I_idx, ψ (g_fam i) = Pi.single i 1 :=
        fun i => Classical.choose_spec (hψ_surj (Pi.single i 1))
      have hex_i₀ : ∃ idx₀ : I_idx, g_fam idx₀ ∉ q₀.asIdeal := by
        by_contra! hall
        have h1_sub : (1 : B_alg) - ∑ i : I_idx, g_fam i ∈ RingHom.ker ψ := by
          rw [RingHom.mem_ker, map_sub, map_one, map_sum]
          ext j
          simp [hg_fam, Finset.sum_apply]
        have h1_mem_J : (1 : B_alg) - ∑ i : I_idx, g_fam i ∈ q₀.asIdeal :=
          hJ_le_q₀ (hker_ν_le (hker_ψ ▸ h1_sub))
        have hsum_mem : ∑ i : I_idx, g_fam i ∈ q₀.asIdeal :=
          Ideal.sum_mem q₀.asIdeal (fun i _ => hall i)
        have h1_mem : (1 : B_alg) ∈ q₀.asIdeal := by
          have := q₀.asIdeal.add_mem h1_mem_J hsum_mem
          rwa [sub_add_cancel] at this
        exact q₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
      obtain ⟨idx₀, hg_not_mem⟩ := hex_i₀
      let g_el : B_alg := g_fam idx₀

      let B' : Type u := Localization.Away g_el
      let B'_cat : CommRingCat.{u} := CommRingCat.of B'
      let lam : B_alg →+* B' := algebraMap B_alg B'
      have hmem_basic : q₀ ∈ (PrimeSpectrum.basicOpen g_el : Set (PrimeSpectrum B_alg)) :=
        hg_not_mem
      rw [← PrimeSpectrum.localization_away_comap_range B' g_el] at hmem_basic
      obtain ⟨q'₀, hq'₀_eq⟩ := hmem_basic
      let χ₀ : B_alg →+* k₁ := (Pi.evalRingHom (fun _ => k₁) idx₀).comp ψ
      have hχ₀_g : χ₀ g_el = 1 := by
        change ψ g_el idx₀ = 1
        rw [hg_fam idx₀, Pi.single_eq_same]
      have hUnit_χ₀ : IsUnit (χ₀ g_el) := by rw [hχ₀_g]; exact isUnit_one
      let χ' : B' →+* k₁ := IsLocalization.Away.lift g_el hUnit_χ₀
      have hχ'_lam : ∀ b : B_alg, χ' (lam b) = χ₀ b :=
        fun b => IsLocalization.Away.lift_eq g_el hUnit_χ₀ b
      have hχ'_R : χ'.comp (lam.comp φ_RB.hom) = π_Rk.hom := by
        ext r
        change χ' (lam (φ_RB.hom r)) = π_Rk.hom r
        rw [hχ'_lam]
        exact hψ_R r idx₀
      have hχ'_surj : Function.Surjective χ' := fun c => by
        obtain ⟨r, rfl⟩ := hπ_surj c
        exact ⟨lam (φ_RB.hom r), by rw [hχ'_lam]; exact hψ_R r idx₀⟩
      have hker_χ' : RingHom.ker χ' = Ideal.map (lam.comp φ_RB.hom) m₀ := by
        apply le_antisymm
        · intro x hx
          rw [RingHom.mem_ker] at hx
          obtain ⟨n, b, hnb⟩ := IsLocalization.Away.surj g_el x
          have hχ_b : χ₀ b = 0 := by
            have h1 := congrArg χ' hnb
            rw [map_mul, hx, zero_mul, hχ'_lam] at h1
            exact h1.symm
          have hψ_bg : ψ (b * g_el) = 0 := by
            rw [map_mul, hg_fam idx₀]
            ext j
            by_cases hj : j = idx₀
            · subst hj
              simp only [Pi.mul_apply, Pi.single_eq_same, mul_one, Pi.zero_apply]
              exact hχ_b
            · simp [Pi.mul_apply, Pi.single_eq_of_ne hj]
          have hbg_J : b * g_el ∈ J_fib := by
            apply hker_ν_le
            rw [← hker_ψ, RingHom.mem_ker]
            exact hψ_bg
          have hlam_bg : lam (b * g_el) ∈ Ideal.map (lam.comp φ_RB.hom) m₀ := by
            rw [← Ideal.map_map]
            exact Ideal.mem_map_of_mem lam hbg_J
          have hunit_g : IsUnit (lam g_el) := IsLocalization.Away.algebraMap_isUnit g_el
          obtain ⟨u_g, hu_g⟩ := (hunit_g.pow (n + 1))
          have hx_eq : x = (↑(u_g⁻¹) : B') * lam (b * g_el) := by
            apply (Units.mul_left_inj u_g).mp
            calc x * (u_g : B')
                = x * lam g_el ^ (n + 1) := by rw [hu_g]
              _ = (x * lam g_el ^ n) * lam g_el := by rw [pow_succ, ← mul_assoc]
              _ = lam (b * g_el) := by rw [hnb, map_mul]
              _ = (↑(u_g⁻¹) : B') * (u_g : B') * lam (b * g_el) := by rw [Units.inv_mul, one_mul]
              _ = (↑(u_g⁻¹) : B') * lam (b * g_el) * (u_g : B') := by ring
          rw [hx_eq]
          exact Ideal.mul_mem_left _ _ hlam_bg
        · rw [Ideal.map_le_iff_le_comap]
          intro r hr
          change χ' (lam (φ_RB.hom r)) = 0
          have h1 := RingHom.congr_fun hχ'_R r
          exact h1.trans hr

      let U' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B'_cat
      let u_loc : U' ⟶ AlgebraicGeometry.Spec B_cat :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam)
      have _ : AlgebraicGeometry.IsOpenImmersion u_loc :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization g_el
      let u_tilde : U' ⟶ E.left := u_loc ≫ ι_B
      have _ : AlgebraicGeometry.Etale u_tilde := by dsimp [u_tilde]; infer_instance
      have hu_tilde_pt : u_tilde.base q'₀ = y₀ := by
        change ι_B.base (u_loc.base q'₀) = y₀
        have h1 : u_loc.base q'₀ = q₀ := hq'₀_eq
        rw [h1, hι_B_q₀]
      let u' : U' ⟶ X := u_tilde ≫ E.hom
      have _ : AlgebraicGeometry.Etale u' := by dsimp [u']; infer_instance
      let f_B'R : U' ⟶ AlgebraicGeometry.Spec R_cat :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (lam.comp φ_RB.hom))
      have hu'_fac : u' = f_B'R ≫ ι_R := by
        dsimp [u', u_tilde]
        rw [Category.assoc, ← hf_BR, ← Category.assoc]
        congr 1
        dsimp [u_loc, f_B'R]
        rw [← hSpec_φRB, ← AlgebraicGeometry.Spec.map_comp]
      let σ_k : S₁ ⟶ U' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ')
      have hσ_u' : σ_k ≫ u' = i₀ := by
        rw [hu'_fac, ← Category.assoc]
        have h1 : σ_k ≫ f_B'R = i_R := by
          rw [← hSpec_πRk]
          dsimp [σ_k, f_B'R]
          rw [← AlgebraicGeometry.Spec.map_comp]
          congr 1
          apply CommRingCat.hom_ext
          ext r
          exact RingHom.congr_fun hχ'_R r
        rw [h1, hi_R]

      let E_U' : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ u' inferInstance
      let v_E : E_U' ⟶ E := CategoryTheory.MorphismProperty.Over.homMk u_tilde rfl
      let s' : ↥(S.obj.obj (Opposite.op E_U')) := (S.obj.map v_E.op) s

      have hOverlapEq : ∀ (Z : X.Etale) (g₁ g₂ : Z ⟶ E_U'),
          (S.obj.map g₁.op) s' = (S.obj.map g₂.op) s' := by
        intro Z g₁ g₂
        have _ : AlgebraicGeometry.Etale Z.hom := Z.prop
        let d_sec : ↥(S.obj.obj (Opposite.op Z)) := (S.obj.map g₁.op) s' - (S.obj.map g₂.op) s'
        suffices hd0 : d_sec = 0 by exact sub_eq_zero.mp hd0
        let R_d : CategoryTheory.Sieve Z :=
          { arrows := fun _ h => (S.obj.map h.op) d_sec = 0
            downward_closed := fun {Y₁ Y₂} h hh k => by
              rw [op_comp, S.obj.map_comp]
              change (S.obj.map k.op) ((S.obj.map h.op) d_sec) = 0
              rw [hh, map_zero] }
        have hRd : R_d ∈ X.smallEtaleTopology Z := by
          refine (hMemEtale X Z R_d).mpr fun z => ?_
          by_cases hz_in : Z.hom.base z ∈ Set.range i₀.base
          · rw [hRange_i₀, Set.mem_singleton_iff] at hz_in
            let P_u' := CategoryTheory.Limits.pullback u' u'
            let pr₁ := CategoryTheory.Limits.pullback.fst u' u'
            let pr₂ := CategoryTheory.Limits.pullback.snd u' u'
            let Δ_u' := CategoryTheory.Limits.pullback.diagonal u'
            have _ : AlgebraicGeometry.IsOpenImmersion Δ_u' :=
              AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal u'
            have hg_cond : g₁.left ≫ u' = g₂.left ≫ u' :=
              (CategoryTheory.MorphismProperty.Over.w g₁).trans
                (CategoryTheory.MorphismProperty.Over.w g₂).symm
            let l_Z : Z.left ⟶ P_u' :=
              CategoryTheory.Limits.pullback.lift g₁.left g₂.left hg_cond
            let z_P : ↥P_u' := l_Z.base z
            let K_z : Type u := ↥(P_u'.residueField z_P)
            let ξ_z : AlgebraicGeometry.Spec (CommRingCat.of K_z) ⟶ P_u' :=
              P_u'.fromSpecResidueField z_P
            have hξ_pt : ξ_z.base (⊥ : PrimeSpectrum K_z) = z_P := by
              have hmem : ξ_z.base (⊥ : PrimeSpectrum K_z) ∈ Set.range ξ_z.base :=
                ⟨(⊥ : PrimeSpectrum K_z), rfl⟩
              rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField z_P,
                Set.mem_singleton_iff] at hmem
            have hFactor_σ : ∀ (pr : P_u' ⟶ U'),
                pr ≫ u' = pr₁ ≫ u' →
                ∃ w : AlgebraicGeometry.Spec (CommRingCat.of K_z) ⟶ S₁,
                  w ≫ σ_k = ξ_z ≫ pr := by
              intro pr hpr_u'
              have hu'_pr : u'.base (pr.base z_P) = x₀ := by
                change (pr ≫ u').base (l_Z.base z) = x₀
                rw [hpr_u']
                have hl_pr₁ : l_Z ≫ pr₁ ≫ u' = Z.hom :=
                  (Category.assoc l_Z pr₁ u').symm.trans
                    ((congrArg (· ≫ u')
                      (CategoryTheory.Limits.pullback.lift_fst g₁.left g₂.left hg_cond)).trans
                      (CategoryTheory.MorphismProperty.Over.w g₁))
                exact (congrArg (fun (m : Z.left ⟶ X) => m.base z) hl_pr₁).trans hz_in
              have hf_pr : f_B'R.base (pr.base z_P) = p₀ := by
                apply ι_R.isOpenEmbedding.injective
                change (f_B'R ≫ ι_R).base (pr.base z_P) = ι_R.base p₀
                rw [← hu'_fac, hu'_pr, hι_R_p₀]
              have hker_le_pr : RingHom.ker χ' ≤ (pr.base z_P).asIdeal := by
                rw [hker_χ', Ideal.map_le_iff_le_comap]
                have hcomap : Ideal.comap (lam.comp φ_RB.hom) (pr.base z_P).asIdeal = p₀.asIdeal := by
                  rw [← hf_pr]
                  rfl
                rw [hcomap, hp₀_ideal]
              have hMax_χ' : (RingHom.ker χ').IsMaximal :=
                RingHom.ker_isMaximal_of_surjective χ' hχ'_surj
              have hpr_ideal : (pr.base z_P).asIdeal = RingHom.ker χ' :=
                (hMax_χ'.eq_of_le (pr.base z_P).isPrime.ne_top hker_le_pr).symm
              let α_pr : B'_cat ⟶ CommRingCat.of K_z :=
                AlgebraicGeometry.Spec.preimage (ξ_z ≫ pr)
              have hSpec_α : AlgebraicGeometry.Spec.map α_pr = ξ_z ≫ pr :=
                AlgebraicGeometry.Spec.map_preimage (ξ_z ≫ pr)
              have hker_α : RingHom.ker α_pr.hom = RingHom.ker χ' := by
                rw [← hpr_ideal]
                have hpt : (AlgebraicGeometry.Spec.map α_pr).base (⊥ : PrimeSpectrum K_z) =
                    pr.base z_P := by
                  rw [hSpec_α]
                  change pr.base (ξ_z.base (⊥ : PrimeSpectrum K_z)) = pr.base z_P
                  rw [hξ_pt]
                rw [← hpt]
                ext b'
                rw [RingHom.mem_ker]
                exact ⟨fun hb' => by
                    change α_pr.hom b' ∈ (⊥ : Ideal K_z)
                    rwa [Ideal.mem_bot],
                  fun hb' => by
                    change α_pr.hom b' ∈ (⊥ : Ideal K_z) at hb'
                    rwa [Ideal.mem_bot] at hb'⟩
              let β_k : k₁ →+* K_z :=
                (Ideal.Quotient.lift (RingHom.ker χ') α_pr.hom
                  (fun b' hb' => by rw [← RingHom.mem_ker, hker_α]; exact hb')).comp
                  (RingHom.quotientKerEquivOfSurjective hχ'_surj).symm.toRingHom
              have hβ_χ' : β_k.comp χ' = α_pr.hom := by
                ext b'
                dsimp [β_k]
                have h1 : (RingHom.quotientKerEquivOfSurjective hχ'_surj).symm (χ' b') =
                    Ideal.Quotient.mk (RingHom.ker χ') b' := by
                  apply (RingHom.quotientKerEquivOfSurjective hχ'_surj).injective
                  rw [RingEquiv.apply_symm_apply, RingHom.quotientKerEquivOfSurjective_apply_mk]
                rw [h1, Ideal.Quotient.lift_mk]
              refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_k), ?_⟩
              dsimp [σ_k]
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hβ_χ']
              exact hSpec_α
            obtain ⟨w₁, hw₁⟩ := hFactor_σ pr₁ rfl
            obtain ⟨w₂, hw₂⟩ := hFactor_σ pr₂ CategoryTheory.Limits.pullback.condition.symm
            have hw_eq : w₁ = w₂ := by
              apply (cancel_mono i₀).mp
              exact (congrArg (w₁ ≫ ·) hσ_u'.symm).trans
                ((Category.assoc w₁ σ_k u').symm.trans
                  ((congrArg (· ≫ u') hw₁).trans
                    ((Category.assoc ξ_z pr₁ u').trans
                      ((congrArg (ξ_z ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                        ((Category.assoc ξ_z pr₂ u').symm.trans
                          ((congrArg (· ≫ u') hw₂.symm).trans
                            ((Category.assoc w₂ σ_k u').trans
                              (congrArg (w₂ ≫ ·) hσ_u'))))))))
            have hξ_pr : ξ_z ≫ pr₁ = ξ_z ≫ pr₂ := by rw [← hw₁, ← hw₂, hw_eq]
            have hξ_Δ : (ξ_z ≫ pr₁) ≫ Δ_u' = ξ_z := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id]
              · rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id,
                  hξ_pr]
            have hz_P_mem : Δ_u'.base ((ξ_z ≫ pr₁).base (⊥ : PrimeSpectrum K_z)) = l_Z.base z := by
              change ((ξ_z ≫ pr₁) ≫ Δ_u').base (⊥ : PrimeSpectrum K_z) = z_P
              rw [hξ_Δ, hξ_pt]
            let Z_eq := CategoryTheory.Limits.pullback Δ_u' l_Z
            let j_Z := CategoryTheory.Limits.pullback.snd Δ_u' l_Z
            have _ : AlgebraicGeometry.IsOpenImmersion j_Z := inferInstance
            have _ : AlgebraicGeometry.Etale j_Z := inferInstance
            obtain ⟨z_eq, _, hz_eq_snd⟩ :=
              AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
                (f := Δ_u') (g := l_Z) ((ξ_z ≫ pr₁).base (⊥ : PrimeSpectrum K_z)) z hz_P_mem
            let E_Zeq : X.Etale :=
              CategoryTheory.MorphismProperty.Over.mk ⊤ (j_Z ≫ Z.hom) inferInstance
            let k_Z : E_Zeq ⟶ Z := CategoryTheory.MorphismProperty.Over.homMk j_Z rfl
            have hk_eq : k_Z ≫ g₁ = k_Z ≫ g₂ := by
              apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
              let p_Z := CategoryTheory.Limits.pullback.fst Δ_u' l_Z
              have hcond_Z : p_Z ≫ Δ_u' = j_Z ≫ l_Z :=
                CategoryTheory.Limits.pullback.condition
              have hl₁ : l_Z ≫ pr₁ = g₁.left :=
                CategoryTheory.Limits.pullback.lift_fst g₁.left g₂.left hg_cond
              have hl₂ : l_Z ≫ pr₂ = g₂.left :=
                CategoryTheory.Limits.pullback.lift_snd g₁.left g₂.left hg_cond
              have hΔ₁ : Δ_u' ≫ pr₁ = 𝟙 U' := CategoryTheory.Limits.pullback.diagonal_fst u'
              have hΔ₂ : Δ_u' ≫ pr₂ = 𝟙 U' := CategoryTheory.Limits.pullback.diagonal_snd u'
              have hc₁ : p_Z = j_Z ≫ g₁.left :=
                (Category.comp_id p_Z).symm.trans
                  ((congrArg (p_Z ≫ ·) hΔ₁.symm).trans
                    ((Category.assoc p_Z Δ_u' pr₁).symm.trans
                      ((congrArg (· ≫ pr₁) hcond_Z).trans
                        ((Category.assoc j_Z l_Z pr₁).trans (congrArg (j_Z ≫ ·) hl₁)))))
              have hc₂ : p_Z = j_Z ≫ g₂.left :=
                (Category.comp_id p_Z).symm.trans
                  ((congrArg (p_Z ≫ ·) hΔ₂.symm).trans
                    ((Category.assoc p_Z Δ_u' pr₂).symm.trans
                      ((congrArg (· ≫ pr₂) hcond_Z).trans
                        ((Category.assoc j_Z l_Z pr₂).trans (congrArg (j_Z ≫ ·) hl₂)))))
              exact hc₁.symm.trans hc₂
            have hd_zero : (S.obj.map k_Z.op) d_sec = 0 := by
              dsimp [d_sec, s']
              rw [map_sub]
              have hcomp1 : (S.obj.map k_Z.op) ((S.obj.map g₁.op) ((S.obj.map v_E.op) s)) =
