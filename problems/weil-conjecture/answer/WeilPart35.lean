    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    ext E_op s
    let E : X.Etale := E_op.unop
    change (s : ↥(S.obj.obj (Opposite.op E))) = 0
    let R_all : CategoryTheory.Sieve E :=
      { arrows := fun _ u => (S.obj.map u.op) s = 0
