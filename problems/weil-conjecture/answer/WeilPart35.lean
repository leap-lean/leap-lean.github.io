              CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) k := by
            change ℱ.obj.map (w₂.op ≫ ((stalkDiag.map f₂).unop).op) ≫ _ = _
            rw [ℱ.obj.map_comp]
        _ = ℱ.obj.map w₂.op ≫ ((stalkDiag ⋙ ℱ.obj).map f₂ ≫
              CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) k) := by
            rw [CategoryTheory.Category.assoc]; rfl
        _ = ℱ.obj.map w₂.op ≫ CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) i₂ := by
            rw [hc₂]
    let germ₀ : ∀ (ℱ : 𝒞_Z) (U : Z.Etale),
