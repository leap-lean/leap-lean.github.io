      hSyzTower W_bar u_bar hSurj_ubar
    obtain ⟨hModels₁, hCocycleDesc₁⟩ :=
      hCechCocycleDesc E₀ Z₀ z_W hz_W Z_bar p_Z hp_Z hp_Z_W
        E₁ U₁ u₁ U_bar u_bar p_U hu₁_hom hp_U hu_bar_pZ
    have hLow_bar : ∀ (p m : ℕ), 1 ≤ m → m ≤ q →
