        e.hom ≫ CategoryTheory.CategoryStruct.id 𝒢 ≫ e.inv := by
      rw [CategoryTheory.Category.id_comp, e.hom_inv_id]
    rw [hid, ← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp,
      h𝒢, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hTor_2 : ∀ (r : ℕ) (x : (E2_2.ℳ_bar r).H 2), (ℓ ^ (r + 1)) • x = 0 := by
    intro r x
    obtain ⟨e_iso⟩ := h_align_iso E2_2.hCont_pr E2_2.hAdj_pr (E2_2.iso_bar r)
    exact h_tor_H (weilGeomScheme F D₀) (E2_2.ℳ_bar r)
      (h_tor_of_iso e_iso (h_tor_R (2 * m) r)) 2 x

  have hTor_1 : ∀ (r : ℕ) (x : (E2_1.ℳ_bar r).H 1), (ℓ ^ (r + 1)) • x = 0 := by
    intro r x
    obtain ⟨e_iso⟩ := h_align_iso E2_1.hCont_pr E2_1.hAdj_pr (E2_1.iso_bar r)
    exact h_tor_H (weilGeomScheme F D₀) (E2_1.ℳ_bar r)
      (h_tor_of_iso e_iso (h_tor_R (2 * m + 1) r)) 1 x

  have hTor_0 : ∀ (r : ℕ) (x : (E2_0.ℳ_bar r).H 0), (ℓ ^ (r + 1)) • x = 0 := by
    intro r x
    obtain ⟨e_iso⟩ := h_align_iso E2_0.hCont_pr E2_0.hAdj_pr (E2_0.iso_bar r)
    exact h_tor_H (weilGeomScheme F D₀) (E2_0.ℳ_bar r)
      (h_tor_of_iso e_iso (h_tor_R (2 * m + 2) r)) 0 x

  
  obtain ⟨F1, hAdd_F1, t_F1, frob_F1, α, β, γ_map, ε_map,
    hF1_tor, hF1_frob_trans, hα_inj, hEx_I, hEx_II,
    hα_trans, hβ_trans, hγ_trans, hε_trans,
    hα_frob, hβ_frob, hγ_frob, hε_frob⟩ :=
    weil_sing_dev_leray_p1_torsion_filtration F m Z_tilde f₀ ℓ hCd2
      hCont_Z hAdj_Z hCont_D hAdj_D hCont_f₀
      hAcyc_Z hAcyc_D e_H0 (@he_H0_nat) he_H0_frob
      M_Ztilde.frobTorsion M_Ztilde.hfrobTorsion E2_2 E2_1 E2_0

  let _ : ∀ r, AddCommGroup (F1 r) := hAdd_F1
  refine ⟨E2_2, E2_1, E2_0, ?_⟩
  exact weil_sing_dev_leray_ell_adic_eigenvalue_trichotomy F Z_tilde D₀ ℓ (2 * m + 2)
    (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m))
    (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 1))
    (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 2))
    (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m))
    (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m + 1))
    (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m + 2))
    M_Ztilde E2_2 E2_1 E2_0
    hSub_M0 hFin_M hTor_M hM_frob_trans
    hFin_E2_2 hTor_2 hTor_1 hTor_0
    hE2_2_frob_trans hE2_1_frob_trans hE2_0_frob_trans
    F1 t_F1 frob_F1 α β γ_map ε_map
    hF1_tor hF1_frob_trans hα_inj hEx_I hEx_II
    hα_trans hβ_trans hγ_trans hε_trans
    hα_frob hβ_frob hγ_frob hε_frob
    γ' hγ'

theorem weil_sing_dev_outer_locConst_geom_chart_dichotomy (F : Type u) [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.GeometricallyIrreducible (weilProjectiveSpaceOver F 1).hom]
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver F 1).hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (h1d : WeilSingDevIs1dPencilOdpDatum F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀)
    (f_bar : weilBaseChangeOver F (AlgebraicClosure F) Z_tilde ⟶
      weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1))
    [AlgebraicGeometry.IsProper f_bar.left]
    (hPb_fbar : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst Z_tilde.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      f_bar.left f₀.left
      (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (e_P : weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1) ≅
      weilProjectiveSpaceOver (AlgebraicClosure F) 1)
    (y_bar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶
      (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).left)
    (hy_bar : y_bar ≫
      (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)))) :
    let k := AlgebraicClosure F
    let D_bar := weilBaseChangeOver F k (weilProjectiveSpaceOver F 1)
    let Z_bar := weilBaseChangeOver F k Z_tilde
    let U_line := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
    ∃ (ι_y : U_line ⟶ D_bar.left)
      (_ : AlgebraicGeometry.IsOpenImmersion ι_y)
      (X_y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f_y : X_y ⟶ CategoryTheory.Over.mk p_A1)
      (_ : AlgebraicGeometry.IsProper f_y.left)
      (ι_Xy : X_y.left ⟶ Z_bar.left),
      ι_y ≫ D_bar.hom = p_A1 ∧
      s₀ ≫ ι_y = y_bar ∧
      CategoryTheory.IsPullback ι_Xy f_y.left f_bar.left ι_y ∧
      ((∀ z : X_y.left,
          f_y.left.base z ∈ Set.range s₀.base →
          ∃ V : X_y.left.Opens,
            z ∈ V ∧
            AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f_y.left)) ∨
        (∃ x₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X_y.left,
          x₀ ≫ f_y.left = s₀ ∧
          (∀ z : X_y.left,
            f_y.left.base z ∈ Set.range s₀.base →
            z ∉ Set.range x₀.base →
            ∃ V : X_y.left.Opens,
              z ∈ V ∧
              AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f_y.left)) ∧
          ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k),
            IsEtaleSplitOdpPointOver m f_y (x₀.base pt) (s₀.base pt))) :=
by
  classical
  dsimp only
  let k := AlgebraicClosure F
  let D₀ := weilProjectiveSpaceOver F 1
  let D_bar := weilBaseChangeOver F k D₀
  let Z_bar := weilBaseChangeOver F k Z_tilde
  let U_line := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
  let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_line :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
  let g_k : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Spec (CommRingCat.of F) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let pr_D : D_bar.left ⟶ D₀.left := CategoryTheory.Limits.pullback.fst D₀.hom g_k
  let pr_Z : Z_bar.left ⟶ Z_tilde.left := CategoryTheory.Limits.pullback.fst Z_tilde.hom g_k
  let pt_F : AlgebraicGeometry.Spec (CommRingCat.of F) := (⊥ : PrimeSpectrum F)
  let pt_k : AlgebraicGeometry.Spec (CommRingCat.of k) := (⊥ : PrimeSpectrum k)

  
  have hOdpPushout : ∀ (R₁ R₂ : CommRingCat.{u}) (h₁ : R₁) (h₂ : R₂) (α : R₁ →+* R₂),
      α h₁ = h₂ →
      let σ := Fin (m + 1) × Fin 2
      let I₁ : Ideal (MvPolynomial σ R₁) :=
        Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h₁}
      let I₂ : Ideal (MvPolynomial σ R₂) :=
        Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h₂}
      let Q₁ := AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R₁ ⧸ I₁))
      let Q₂ := AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R₂ ⧸ I₂))
      let π₁ : Q₁ ⟶ AlgebraicGeometry.Spec R₁ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I₁).comp MvPolynomial.C))
      let π₂ : Q₂ ⟶ AlgebraicGeometry.Spec R₂ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I₂).comp MvPolynomial.C))
      ∃ (p_Q : Q₂ ⟶ Q₁),
        CategoryTheory.IsPullback p_Q π₂ π₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) ∧
        (∀ (w₂ : Q₂) (idx : σ),
          Ideal.Quotient.mk I₂ (MvPolynomial.X idx) ∈ w₂.asIdeal ↔
            Ideal.Quotient.mk I₁ (MvPolynomial.X idx) ∈ (p_Q.base w₂).asIdeal) ∧
        (∀ (w₂ : Q₂),
          Ideal.Quotient.mk I₂ (MvPolynomial.C h₂) ∈ w₂.asIdeal ↔
            Ideal.Quotient.mk I₁ (MvPolynomial.C h₁) ∈ (p_Q.base w₂).asIdeal) := by
    clear * -
    intro R₁ R₂ h₁ h₂ α hα σ I₁ I₂ Q₁ Q₂ π₁ π₂
    let G₁ : MvPolynomial σ R₁ :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h₁
    let G₂ : MvPolynomial σ R₂ :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h₂
    have hmapG : MvPolynomial.map α G₁ = G₂ := by
      dsimp [G₁, G₂]
      rw [map_sub, map_sum, MvPolynomial.map_C, hα]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
    have hker₁ : ∀ a ∈ I₁, ((Ideal.Quotient.mk I₂).comp (MvPolynomial.map α)) a = 0 := by
      have hle : I₁ ≤ RingHom.ker ((Ideal.Quotient.mk I₂).comp (MvPolynomial.map α)) := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, RingHom.comp_apply, hmapG]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      exact fun a ha => hle ha
    let ι_Q : (MvPolynomial σ R₁ ⧸ I₁) →+* (MvPolynomial σ R₂ ⧸ I₂) :=
      Ideal.Quotient.lift I₁ ((Ideal.Quotient.mk I₂).comp (MvPolynomial.map α)) hker₁
    let c₁ : R₁ →+* (MvPolynomial σ R₁ ⧸ I₁) := (Ideal.Quotient.mk I₁).comp MvPolynomial.C
    let c₂ : R₂ →+* (MvPolynomial σ R₂ ⧸ I₂) := (Ideal.Quotient.mk I₂).comp MvPolynomial.C
    have hcomm_ring : CommRingCat.ofHom c₁ ≫ CommRingCat.ofHom ι_Q =
        CommRingCat.ofHom α ≫ CommRingCat.ofHom c₂ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      change ι_Q (Ideal.Quotient.mk I₁ (MvPolynomial.C r)) =
        Ideal.Quotient.mk I₂ (MvPolynomial.C (α r))
      dsimp [ι_Q]
      rw [MvPolynomial.map_C]
    let Φ_poly (s : CategoryTheory.Limits.PushoutCocone (CommRingCat.ofHom c₁) (CommRingCat.ofHom α)) :
        MvPolynomial σ R₂ →+* s.pt :=
      MvPolynomial.eval₂Hom s.inr.hom
        (fun idx => s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx)))
    have hker₂ (s : CategoryTheory.Limits.PushoutCocone (CommRingCat.ofHom c₁) (CommRingCat.ofHom α)) :
        ∀ a ∈ I₂, Φ_poly s a = 0 := by
      have hΦ_map : (Φ_poly s).comp (MvPolynomial.map α) = s.inl.hom.comp (Ideal.Quotient.mk I₁) := by
        apply MvPolynomial.ringHom_ext'
        · ext r
          change Φ_poly s (MvPolynomial.map α (MvPolynomial.C r)) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C r))
          dsimp [Φ_poly]
          rw [MvPolynomial.map_C, MvPolynomial.eval₂_C]
          exact (congrArg (fun f : R₁ ⟶ s.pt => f.hom r) s.condition).symm
        · intro idx
          change Φ_poly s (MvPolynomial.map α (MvPolynomial.X idx)) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx))
          dsimp [Φ_poly]
          rw [MvPolynomial.map_X, MvPolynomial.eval₂_X]
      have hG₁_zero : Ideal.Quotient.mk I₁ G₁ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      have hle : I₂ ≤ RingHom.ker (Φ_poly s) := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change Φ_poly s G₂ = 0
        rw [← hmapG, ← RingHom.comp_apply, hΦ_map, RingHom.comp_apply, hG₁_zero, map_zero]
      exact fun a ha => hle ha
    let Φ_lift (s : CategoryTheory.Limits.PushoutCocone (CommRingCat.ofHom c₁) (CommRingCat.ofHom α)) :
        (MvPolynomial σ R₂ ⧸ I₂) →+* s.pt :=
      Ideal.Quotient.lift I₂ (Φ_poly s) (hker₂ s)
    have hX_ιQ : ∀ idx : σ,
        ι_Q (Ideal.Quotient.mk I₁ (MvPolynomial.X idx)) =
          Ideal.Quotient.mk I₂ (MvPolynomial.X idx) := by
      intro idx
      dsimp [ι_Q]
      rw [MvPolynomial.map_X]
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk
          (CommRingCat.ofHom ι_Q) (CommRingCat.ofHom c₂) hcomm_ring) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_ring
        (fun s => CommRingCat.ofHom (Φ_lift s)) (fun s => ?_) (fun s => ?_)
        (fun s m hm_inl hm_inr => ?_)
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext r
          change Φ_lift s (ι_Q (Ideal.Quotient.mk I₁ (MvPolynomial.C r))) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C r))
          dsimp [ι_Q]
          rw [MvPolynomial.map_C]
          dsimp [Φ_lift, Φ_poly]
          rw [MvPolynomial.eval₂_C]
          exact (congrArg (fun f : R₁ ⟶ s.pt => f.hom r) s.condition).symm
        · intro idx
          change Φ_lift s (ι_Q (Ideal.Quotient.mk I₁ (MvPolynomial.X idx))) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx))
          rw [hX_ιQ idx]
          dsimp [Φ_lift, Φ_poly]
          rw [MvPolynomial.eval₂_X]
      · apply CommRingCat.hom_ext
        ext r₂
        change Φ_lift s (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂)) = s.inr.hom r₂
        dsimp [Φ_lift, Φ_poly]
        rw [MvPolynomial.eval₂_C]
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext r₂
          have h1 := congrArg (fun f : CommRingCat.of R₂ ⟶ s.pt => f.hom r₂) hm_inr
          change m.hom (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂)) =
            Φ_lift s (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂))
          dsimp [Φ_lift, Φ_poly]
          rw [MvPolynomial.eval₂_C]
          exact h1
        · intro idx
          have h1 := congrArg (fun f : CommRingCat.of (MvPolynomial σ R₁ ⧸ I₁) ⟶ s.pt =>
            f.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx))) hm_inl
          change m.hom (Ideal.Quotient.mk I₂ (MvPolynomial.X idx)) =
            Φ_lift s (Ideal.Quotient.mk I₂ (MvPolynomial.X idx))
          dsimp [Φ_lift, Φ_poly]
          rw [MvPolynomial.eval₂_X]
          rw [← hX_ιQ idx]
          exact h1
    have hPush : CategoryTheory.IsPushout
        (CommRingCat.ofHom c₁) (CommRingCat.ofHom α)
        (CommRingCat.ofHom ι_Q) (CommRingCat.ofHom c₂) :=
      CategoryTheory.IsPushout.of_isColimit hColim
    let p_Q : Q₂ ⟶ Q₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_Q)
    have hPb : CategoryTheory.IsPullback p_Q π₂ π₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    refine ⟨p_Q, hPb, ?_, ?_⟩
    · intro w₂ idx
      change Ideal.Quotient.mk I₂ (MvPolynomial.X idx) ∈ w₂.asIdeal ↔
        ι_Q (Ideal.Quotient.mk I₁ (MvPolynomial.X idx)) ∈ w₂.asIdeal
      rw [hX_ιQ idx]
    · intro w₂
      have hC : ι_Q (Ideal.Quotient.mk I₁ (MvPolynomial.C h₁)) =
          Ideal.Quotient.mk I₂ (MvPolynomial.C h₂) := by
        dsimp [ι_Q]
        rw [MvPolynomial.map_C, hα]
      change Ideal.Quotient.mk I₂ (MvPolynomial.C h₂) ∈ w₂.asIdeal ↔
        ι_Q (Ideal.Quotient.mk I₁ (MvPolynomial.C h₁)) ∈ w₂.asIdeal
      rw [hC]

  
  have hSecAlign : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (w_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W.left)
      (hw_F : w_F ≫ W.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (w_k : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilBaseChangeOver F k W).left)
      (hw_k : w_k ≫ (weilBaseChangeOver F k W).hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))),
      let pr_W : (weilBaseChangeOver F k W).left ⟶ W.left :=
        CategoryTheory.Limits.pullback.fst W.hom g_k
      pr_W.base (w_k.base pt_k) = w_F.base pt_F →
      w_k ≫ pr_W = g_k ≫ w_F ∧
      (∀ z : (weilBaseChangeOver F k W).left,
        pr_W.base z ∈ Set.range w_F.base ↔ z ∈ Set.range w_k.base) := by
    clear * -
    intro W w_F hw_F w_k hw_k pr_W hpt_eq
    let W_bar := weilBaseChangeOver F k W
    let z₀ : W.left := w_F.base pt_F
    obtain ⟨U_aff, hAff, hz₀_mem, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := z₀) (U := (⊤ : W.left.Opens)) trivial
    let A : CommRingCat.{u} := W.left.presheaf.obj (Opposite.op U_aff)
    let j_A : AlgebraicGeometry.Spec A ⟶ W.left := hAff.isoSpec.inv ≫ U_aff.ι
    have : AlgebraicGeometry.IsOpenImmersion j_A := by dsimp [j_A]; infer_instance
    have hj_iso : hAff.isoSpec.hom ≫ j_A = U_aff.ι :=
      hAff.isoSpec.hom_inv_id_assoc U_aff.ι
    have hRange_F : Set.range w_F.base ⊆ Set.range U_aff.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt_F]
      exact hz₀_mem
    have hRange_k : Set.range (w_k ≫ pr_W).base ⊆ Set.range U_aff.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt_k]
      change pr_W.base (w_k.base pt_k) ∈ U_aff
      rw [hpt_eq]
      exact hz₀_mem
    let w_F_U := AlgebraicGeometry.IsOpenImmersion.lift U_aff.ι w_F hRange_F
    have hw_F_U : w_F_U ≫ U_aff.ι = w_F :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_aff.ι w_F hRange_F
    let w_k_U := AlgebraicGeometry.IsOpenImmersion.lift U_aff.ι (w_k ≫ pr_W) hRange_k
    have hw_k_U : w_k_U ≫ U_aff.ι = w_k ≫ pr_W :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_aff.ι (w_k ≫ pr_W) hRange_k
    let ε_s : A ⟶ CommRingCat.of F :=
      AlgebraicGeometry.Spec.preimage (w_F_U ≫ hAff.isoSpec.hom)
    have hε_fac : AlgebraicGeometry.Spec.map ε_s ≫ j_A = w_F := by
      change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage _) ≫ j_A = w_F
      rw [AlgebraicGeometry.Spec.map_preimage, Category.assoc, hj_iso, hw_F_U]
    let φ_y : A ⟶ CommRingCat.of k :=
      AlgebraicGeometry.Spec.preimage (w_k_U ≫ hAff.isoSpec.hom)
    have hφ_fac : AlgebraicGeometry.Spec.map φ_y ≫ j_A = w_k ≫ pr_W := by
      change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage _) ≫ j_A = w_k ≫ pr_W
      rw [AlgebraicGeometry.Spec.map_preimage, Category.assoc, hj_iso, hw_k_U]
    let ρ_A : CommRingCat.of F ⟶ A := AlgebraicGeometry.Spec.preimage (j_A ≫ W.hom)
    have hρ_Spec : AlgebraicGeometry.Spec.map ρ_A = j_A ≫ W.hom :=
      AlgebraicGeometry.Spec.map_preimage (j_A ≫ W.hom)
    have hρ_ε : ρ_A ≫ ε_s = 𝟙 (CommRingCat.of F) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hρ_Spec,
        ← Category.assoc, hε_fac, hw_F]
    have hρ_φ : ρ_A ≫ φ_y = CommRingCat.ofHom (algebraMap F k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hρ_Spec, ← Category.assoc, hφ_fac, Category.assoc]
      have hcond : pr_W ≫ W.hom = W_bar.hom ≫ g_k := CategoryTheory.Limits.pullback.condition
      rw [hcond, ← Category.assoc, hw_k, Category.id_comp]
    have hpt_Spec : (AlgebraicGeometry.Spec.map φ_y).base pt_k =
        (AlgebraicGeometry.Spec.map ε_s).base pt_F := by
      apply j_A.isOpenEmbedding.injective
      change (AlgebraicGeometry.Spec.map φ_y ≫ j_A).base pt_k =
        (AlgebraicGeometry.Spec.map ε_s ≫ j_A).base pt_F
      rw [hφ_fac, hε_fac]
      exact hpt_eq
    have hker_iff : ∀ a : A, φ_y.hom a = 0 ↔ ε_s.hom a = 0 := by
      intro a
      have hmem : a ∈ ((AlgebraicGeometry.Spec.map φ_y).base pt_k).asIdeal ↔
          a ∈ ((AlgebraicGeometry.Spec.map ε_s).base pt_F).asIdeal :=
        iff_of_eq (congrArg (fun p : PrimeSpectrum A => a ∈ p.asIdeal) hpt_Spec)
      rw [AlgebraicGeometry.Spec.map_apply, AlgebraicGeometry.Spec.map_apply] at hmem
      change φ_y.hom a ∈ (⊥ : Ideal k) ↔ ε_s.hom a ∈ (⊥ : Ideal F) at hmem
      simpa only [Ideal.mem_bot] using hmem
    have hφ_eq : φ_y = ε_s ≫ CommRingCat.ofHom (algebraMap F k) := by
      apply CommRingCat.hom_ext
      ext a
      have hsub_ε : ε_s.hom (a - ρ_A.hom (ε_s.hom a)) = 0 := by
        rw [map_sub]
        have h1 : ε_s.hom (ρ_A.hom (ε_s.hom a)) = (ρ_A ≫ ε_s).hom (ε_s.hom a) := rfl
        rw [h1, hρ_ε]
        exact sub_self (ε_s.hom a)
      have hsub_φ : φ_y.hom (a - ρ_A.hom (ε_s.hom a)) = 0 := (hker_iff _).mpr hsub_ε
      rw [map_sub, sub_eq_zero] at hsub_φ
      rw [hsub_φ]
      exact congrArg (fun f : CommRingCat.of F ⟶ CommRingCat.of k => f.hom (ε_s.hom a)) hρ_φ
    have hcomm_sec : w_k ≫ pr_W = g_k ≫ w_F := by
      rw [← hφ_fac, hφ_eq, AlgebraicGeometry.Spec.map_comp, Category.assoc, hε_fac]
    refine ⟨hcomm_sec, fun z => ?_⟩
    constructor
    · rintro ⟨q_F, hq_F⟩
      have hOuter : CategoryTheory.IsPullback (w_k ≫ W_bar.hom) g_k g_k (w_F ≫ W.hom) := by
        have : CategoryTheory.IsIso (w_k ≫ W_bar.hom) := by rw [hw_k]; infer_instance
        have : CategoryTheory.IsIso (w_F ≫ W.hom) := by rw [hw_F]; infer_instance
        refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
        rw [hw_k, hw_F, Category.id_comp, Category.comp_id]
      have hPb_sec : CategoryTheory.IsPullback w_k g_k pr_W w_F :=
        CategoryTheory.IsPullback.of_right hOuter hcomm_sec
          (CategoryTheory.IsPullback.of_hasPullback W.hom g_k).flip
      obtain ⟨q_k, hqk_z, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_sec z q_F hq_F.symm
      exact ⟨q_k, hqk_z⟩
    · rintro ⟨q_k, rfl⟩
      refine ⟨g_k.base q_k, ?_⟩
      change (g_k ≫ w_F).base q_k = (w_k ≫ pr_W).base q_k
      rw [hcomm_sec]

  
  have hRelRoofPb : ∀ {Z₀ D₀_s X₁ U₁ B₀ B₁ Q₀ Q₁ V₀ : AlgebraicGeometry.Scheme.{u}}
      (f₀_m : Z₀ ⟶ D₀_s) (f₁_m : X₁ ⟶ U₁) (q_X : X₁ ⟶ Z₀) (q_U : U₁ ⟶ D₀_s)
      (hPb_fam : CategoryTheory.IsPullback q_X f₁_m f₀_m q_U)
      (e_B₀ : B₀ ⟶ D₀_s) [AlgebraicGeometry.Etale e_B₀]
      (e_B₁ : B₁ ⟶ U₁) [AlgebraicGeometry.Etale e_B₁]
      (p_B : B₁ ⟶ B₀) (hp_B : e_B₁ ≫ q_U = p_B ≫ e_B₀)
      (π_Q₀ : Q₀ ⟶ B₀) (π_Q₁ : Q₁ ⟶ B₁) (p_Q : Q₁ ⟶ Q₀)
      (hPb_Q : CategoryTheory.IsPullback p_Q π_Q₁ π_Q₀ p_B)
      (e_Y₀ : V₀ ⟶ Z₀) [AlgebraicGeometry.Etale e_Y₀]
      (q₀ : V₀ ⟶ Q₀) [AlgebraicGeometry.Etale q₀]
      (hRoof₀ : e_Y₀ ≫ f₀_m = q₀ ≫ π_Q₀ ≫ e_B₀)
      (v₀ : V₀) (u₁ : B₁) (x₁ : X₁)
      (hv₀_u₁ : (q₀ ≫ π_Q₀).base v₀ = p_B.base u₁)
      (hx₁_Z : q_X.base x₁ = e_Y₀.base v₀)
      (hx₁_uniq : ∀ x' : X₁, q_X.base x' = q_X.base x₁ → x' = x₁),
      ∃ (V₁ : AlgebraicGeometry.Scheme.{u}) (v₁ : V₁)
        (e_Y₁ : V₁ ⟶ X₁) (q₁ : V₁ ⟶ Q₁),
        AlgebraicGeometry.Etale e_Y₁ ∧
        AlgebraicGeometry.Etale q₁ ∧
        e_Y₁ ≫ f₁_m = q₁ ≫ π_Q₁ ≫ e_B₁ ∧
        e_Y₁.base v₁ = x₁ ∧
        p_Q.base (q₁.base v₁) = q₀.base v₀ := by
    clear * -
    intro Z₀ D₀_s X₁ U₁ B₀ B₁ Q₀ Q₁ V₀ f₀_m f₁_m q_X q_U hPb_fam
      e_B₀ _ e_B₁ _ p_B hp_B π_Q₀ π_Q₁ p_Q hPb_Q e_Y₀ _ q₀ _ hRoof₀
      v₀ u₁ x₁ hv₀_u₁ hx₁_Z hx₁_uniq
    let V₁ := CategoryTheory.Limits.pullback q₀ p_Q
    let p_V : V₁ ⟶ V₀ := CategoryTheory.Limits.pullback.fst q₀ p_Q
    let q₁ : V₁ ⟶ Q₁ := CategoryTheory.Limits.pullback.snd q₀ p_Q
    have hPb_V : CategoryTheory.IsPullback p_V q₁ q₀ p_Q :=
      CategoryTheory.IsPullback.of_hasPullback q₀ p_Q
    have hEt_q₁ : AlgebraicGeometry.Etale q₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_V inferInstance
    have hPb_V_B : CategoryTheory.IsPullback p_V (q₁ ≫ π_Q₁) (q₀ ≫ π_Q₀) p_B :=
      hPb_V.paste_vert hPb_Q
    let Z_B₀ := CategoryTheory.Limits.pullback f₀_m e_B₀
    let fst₀ : Z_B₀ ⟶ Z₀ := CategoryTheory.Limits.pullback.fst f₀_m e_B₀
    let snd₀ : Z_B₀ ⟶ B₀ := CategoryTheory.Limits.pullback.snd f₀_m e_B₀
    have hPb_ZB₀ : CategoryTheory.IsPullback fst₀ snd₀ f₀_m e_B₀ :=
      CategoryTheory.IsPullback.of_hasPullback f₀_m e_B₀
    have hEt_fst₀ : AlgebraicGeometry.Etale fst₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZB₀.flip inferInstance
    have : AlgebraicGeometry.Etale fst₀ := hEt_fst₀
    let X_B₁ := CategoryTheory.Limits.pullback f₁_m e_B₁
    let fst₁ : X_B₁ ⟶ X₁ := CategoryTheory.Limits.pullback.fst f₁_m e_B₁
    let snd₁ : X_B₁ ⟶ B₁ := CategoryTheory.Limits.pullback.snd f₁_m e_B₁
    have hPb_XB₁ : CategoryTheory.IsPullback fst₁ snd₁ f₁_m e_B₁ :=
      CategoryTheory.IsPullback.of_hasPullback f₁_m e_B₁
    have : AlgebraicGeometry.Etale fst₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_XB₁.flip inferInstance
    have hpZB_comm : (fst₁ ≫ q_X) ≫ f₀_m = (snd₁ ≫ p_B) ≫ e_B₀ := by
      rw [Category.assoc, hPb_fam.w, ← Category.assoc, CategoryTheory.Limits.pullback.condition,
        Category.assoc, hp_B, Category.assoc]
    let p_ZB : X_B₁ ⟶ Z_B₀ :=
      CategoryTheory.Limits.pullback.lift (fst₁ ≫ q_X) (snd₁ ≫ p_B) hpZB_comm
    have hpZB_fst : p_ZB ≫ fst₀ = fst₁ ≫ q_X :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hpZB_snd : p_ZB ≫ snd₀ = snd₁ ≫ p_B :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOuter_XB : CategoryTheory.IsPullback (p_ZB ≫ fst₀) snd₁ f₀_m (p_B ≫ e_B₀) := by
      rw [hpZB_fst, ← hp_B]
      exact hPb_XB₁.paste_horiz hPb_fam
    have hPb_X_ZB : CategoryTheory.IsPullback p_ZB snd₁ snd₀ p_B :=
      CategoryTheory.IsPullback.of_right hOuter_XB hpZB_snd hPb_ZB₀
    let e_rel₀ : V₀ ⟶ Z_B₀ :=
      CategoryTheory.Limits.pullback.lift e_Y₀ (q₀ ≫ π_Q₀) hRoof₀
    have herel₀_fst : e_rel₀ ≫ fst₀ = e_Y₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have herel₀_snd : e_rel₀ ≫ snd₀ = q₀ ≫ π_Q₀ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hEt_erel₀ : AlgebraicGeometry.Etale e_rel₀ :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) e_rel₀ fst₀ hEt_fst₀
        (by rw [herel₀_fst]; infer_instance)
    have herel₁_comm : (p_V ≫ e_rel₀) ≫ snd₀ = (q₁ ≫ π_Q₁) ≫ p_B := by
      rw [Category.assoc, herel₀_snd]
      exact hPb_V_B.w
    let e_rel₁ : V₁ ⟶ X_B₁ := hPb_X_ZB.lift (p_V ≫ e_rel₀) (q₁ ≫ π_Q₁) herel₁_comm
    have herel₁_pZB : e_rel₁ ≫ p_ZB = p_V ≫ e_rel₀ :=
      hPb_X_ZB.lift_fst _ _ _
    have herel₁_snd : e_rel₁ ≫ snd₁ = q₁ ≫ π_Q₁ :=
      hPb_X_ZB.lift_snd _ _ _
    have hOuter_erel : CategoryTheory.IsPullback (e_rel₁ ≫ snd₁) p_V p_B (e_rel₀ ≫ snd₀) := by
      rw [herel₁_snd, herel₀_snd]
      exact hPb_V_B.flip
    have hPb_erel : CategoryTheory.IsPullback p_V e_rel₁ e_rel₀ p_ZB :=
      (CategoryTheory.IsPullback.of_right hOuter_erel herel₁_pZB hPb_X_ZB.flip).flip
    have : AlgebraicGeometry.Etale e_rel₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_erel hEt_erel₀
    let e_Y₁ : V₁ ⟶ X₁ := e_rel₁ ≫ fst₁
    have hEt_eY₁ : AlgebraicGeometry.Etale e_Y₁ := by dsimp [e_Y₁]; infer_instance
    have hRoof₁ : e_Y₁ ≫ f₁_m = q₁ ≫ π_Q₁ ≫ e_B₁ := by
      dsimp [e_Y₁]
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc,
        herel₁_snd, Category.assoc]
    have heY₁_qX : e_Y₁ ≫ q_X = p_V ≫ e_Y₀ := by
      dsimp [e_Y₁]
      rw [Category.assoc, ← hpZB_fst, ← Category.assoc, herel₁_pZB, Category.assoc, herel₀_fst]
    obtain ⟨w₁, hw₁_pQ, hw₁_π⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_Q (q₀.base v₀) u₁ hv₀_u₁
    obtain ⟨v₁, hv₁_pV, hv₁_q₁⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := q₀) (g := p_Q)
        v₀ w₁ hw₁_pQ.symm
    refine ⟨V₁, v₁, e_Y₁, q₁, hEt_eY₁, hEt_q₁, hRoof₁, ?_, ?_⟩
    · apply hx₁_uniq
      change (e_Y₁ ≫ q_X).base v₁ = q_X.base x₁
      rw [heY₁_qX]
      change e_Y₀.base (p_V.base v₁) = q_X.base x₁
      rw [hv₁_pV, hx₁_Z]
    · rw [hv₁_q₁, hw₁_pQ]

  
  
  let e_P_left : D_bar.left ≅ (weilProjectiveSpaceOver k 1).left :=
    (CategoryTheory.Over.forget _).mapIso e_P
  have hP1Chart : ∀ (s_P1 : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        (weilProjectiveSpaceOver k 1).left),
      ∃ (ι'_P1 : U_line ⟶ (weilProjectiveSpaceOver k 1).left)
        (_ : AlgebraicGeometry.IsOpenImmersion ι'_P1)
        (φ'_y : Polynomial k →+* k),
        ι'_P1 ≫ (weilProjectiveSpaceOver k 1).hom = p_A1 ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ'_y) ≫ ι'_P1 = s_P1 := by
    clear * -
    classical
    intro s_P1
    let pt_k : AlgebraicGeometry.Spec (CommRingCat.of k) := (⊥ : PrimeSpectrum k)
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let x_P1 : ↥(AlgebraicGeometry.Proj 𝒜) := s_P1.base pt_k
    have hex_i₀ : ∃ i₀ : Fin 2, MvPolynomial.X i₀ ∉ x_P1.asHomogeneousIdeal := by
      by_contra hAll
      simp only [not_exists, not_not] at hAll
      apply x_P1.not_irrelevant_le
      intro p hp
      have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hp_coeff0 : p.coeff 0 = 0 := by
        have hdecomp : p = ∑ n ∈ (DirectSum.decompose 𝒜 p).support,
            ((DirectSum.decompose 𝒜 p n : ↥(𝒜 n)) : MvPolynomial (Fin 2) k) :=
          (DirectSum.sum_support_decompose 𝒜 p).symm
        rw [hdecomp, MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro n _
        by_cases hn0 : n = 0
        · subst hn0
          have h0 : ((DirectSum.decompose 𝒜 p 0 : ↥(𝒜 0)) : MvPolynomial (Fin 2) k) = 0 := by
            rwa [← GradedRing.proj_apply]
          simp [h0]
        · let q_n := DirectSum.decompose 𝒜 p n
          have hhom : q_n.1.IsHomogeneous n :=
            (MvPolynomial.mem_homogeneousSubmodule n q_n.1).mp q_n.2
          by_contra hne
          have hw := hhom hne
          rw [map_zero] at hw
          exact hn0 hw.symm
      have hmem_span : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro d hd
        have hd_ne : d ≠ 0 := by
          intro hd0
          subst hd0
          exact (MvPolynomial.mem_support_iff.mp hd) hp_coeff0
        by_contra hzero
        apply hd_ne
        ext i
        simp only [Finsupp.coe_zero, Pi.zero_apply]
        by_contra hi
        exact hzero ⟨i, trivial, hi⟩
      have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) ≤
          x_P1.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨i, -, rfl⟩
        exact hAll i
