            (CommRingCat.ofHom (algebraMap F E₀))
            (CommRingCat.ofHom (algebraMap F D₀))
            inl_E₀ inr_E₀ :=
          CommRingCat.isPushout_tensorProduct F E₀ D₀
        have h_alg_comp :
            CommRingCat.ofHom (algebraMap F E₀) ≫ CommRingCat.ofHom (algebraMap E₀ k) =
            CommRingCat.ofHom (algebraMap F k) := by
