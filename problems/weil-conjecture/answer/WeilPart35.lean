          · obtain ⟨E', h_out, hh_et, ⟨y_out, hy_out⟩, hh_zero⟩ :=
              hLocalVanishOut Z d_sec z hz_in
            exact ⟨E', h_out, y_out, hh_zero, hh_et, hy_out⟩
        exact hSheafZero S Z R_d hRd d_sec (fun _ hf => hf)

      let m₁ : E_U' ⟶ T_X :=
        CategoryTheory.MorphismProperty.Over.homMk u' (Category.comp_id u')
      let W_out : X.Opens := ⟨(Set.range i₀.base)ᶜ, i₀.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      let E_out : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W_out.ι inferInstance
      let m₂ : E_out ⟶ T_X :=
        CategoryTheory.MorphismProperty.Over.homMk W_out.ι (Category.comp_id W_out.ι)
      let R_cov : CategoryTheory.Sieve T_X :=
        { arrows := fun Y f => (∃ h₁ : Y ⟶ E_U', h₁ ≫ m₁ = f) ∨ (∃ h₂ : Y ⟶ E_out, h₂ ≫ m₂ = f)
          downward_closed := fun {Y₁ Y₂} f hf g => by
            rcases hf with ⟨h₁, rfl⟩ | ⟨h₂, rfl⟩
            · exact Or.inl ⟨g ≫ h₁, Category.assoc g h₁ m₁⟩
            · exact Or.inr ⟨g ≫ h₂, Category.assoc g h₂ m₂⟩ }
      have hR_cov : R_cov ∈ X.smallEtaleTopology T_X := by
        refine (hMemEtale X T_X R_cov).mpr fun x => ?_
        let x_X : ↥X := x
        by_cases hx_in : x_X ∈ Set.range i₀.base
        · rw [hRange_i₀, Set.mem_singleton_iff] at hx_in
          refine ⟨E_U', m₁, q'₀, Or.inl ⟨𝟙 E_U', Category.id_comp m₁⟩,
            (inferInstance : AlgebraicGeometry.Etale u'),
            (congrArg E.hom.base hu_tilde_pt).trans (hy₀_eq.trans hx_in.symm)⟩
        · refine ⟨E_out, m₂, ⟨x_X, hx_in⟩, Or.inr ⟨𝟙 E_out, Category.id_comp m₂⟩,
