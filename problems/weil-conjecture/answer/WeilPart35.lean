    have hProjLastL : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} {W V : S₀.Etale} (f : W ⟶ V) (p : ℕ),
        (weilEtaleCechProj f (p + 1) (Fin.last (p + 1))).left =
          (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom f p) f).left :=
      fun f p => congrArg (fun m : weilEtaleCechObj f (p + 1) ⟶ _ => m.left) (hProjLast f p)
    have hProjCastSuccL : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} {W V : S₀.Etale}
        (f : W ⟶ V) (p : ℕ) (i : Fin (p + 1)),
        (weilEtaleCechProj f (p + 1) i.castSucc).left =
          (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom f p) f).left ≫
            (weilEtaleCechProj f p i).left :=
      fun f p i => congrArg (fun m : weilEtaleCechObj f (p + 1) ⟶ _ => m.left) (hProjCastSucc f p i)
    have hLiftProj : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} {W V Y : S₀.Etale}
        (f : W ⟶ V) (h : Y ⟶ V) (p : ℕ)
        (g : Fin (p + 1) → (Y ⟶ W)) (hg : ∀ i, g i ≫ f = h) (m : Fin (p + 1)),
        (weilEtaleCechLiftSub f h p g hg).1 ≫ weilEtaleCechProj f p m = g m := by
      intro S₀ W V Y f h p
      induction p with
      | zero =>
        intro g hg m
        have hm := Fin.eq_zero m; subst hm
        exact CategoryTheory.Category.comp_id (g 0)
      | succ p ih =>
        intro g hg m
        refine Fin.lastCases ?_ ?_ m
        · exact (congrArg ((weilEtaleCechLiftSub f h (p + 1) g hg).1 ≫ ·) (hProjLast f p)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        · intro i
          exact (congrArg ((weilEtaleCechLiftSub f h (p + 1) g hg).1 ≫ ·)
            (hProjCastSucc f p i)).trans
            ((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
              (ih (fun j => g j.castSucc) (fun j => hg j.castSucc) i))
    have hFaceProjL : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} {W V : S₀.Etale}
