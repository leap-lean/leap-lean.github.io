            have h1 : j1 ≫ CategoryTheory.Limits.pullback.fst v_i_hom (v_bar ≫ pr_W) =
                fst_bvpr ≫ fst_prW :=
              (congrArg (j1 ≫ ·) h1_hom.symm).trans
                ((CategoryTheory.Category.assoc j1 (i1.hom.app V_i).left _).symm.trans
                  ((congrArg (· ≫ (fst_bvpr ≫ fst_prW)) h1_id).trans
                    (CategoryTheory.Category.id_comp _)))
            have sE1 : ((j1 ≫ (j2 ≫ j3)) ≫ fst₁) ≫ fst₂ =
                j1 ≫ (j2 ≫ (j3 ≫ (fst₁ ≫ fst₂))) :=
              (CategoryTheory.Category.assoc (j1 ≫ (j2 ≫ j3)) fst₁ fst₂).trans
                ((CategoryTheory.Category.assoc j1 (j2 ≫ j3) (fst₁ ≫ fst₂)).trans
                  (congrArg (j1 ≫ ·) (CategoryTheory.Category.assoc j2 j3 (fst₁ ≫ fst₂))))
            have sE2 : j1 ≫ (j2 ≫ (j3 ≫ (fst₁ ≫ fst₂))) =
                j1 ≫ (j2 ≫ CategoryTheory.Limits.pullback.fst v_i_hom (p_inf ≫ g₀)) :=
              congrArg (fun k_hom => j1 ≫ (j2 ≫ k_hom)) h3
            have sE3 : j1 ≫ (j2 ≫ CategoryTheory.Limits.pullback.fst v_i_hom (p_inf ≫ g₀)) =
                j1 ≫ CategoryTheory.Limits.pullback.fst v_i_hom (v_bar ≫ pr_W) :=
              congrArg (j1 ≫ ·) h2
            exact sE1.trans (sE2.trans (sE3.trans h1))
          have hL : (mL ≫ fst₁) ≫ fst₂ = u_i i := by
            let ab := d_vbar_l ≫ b_σi_l
            have hB_σi : b_σi_l ≫ fst_bvpr = fst_vbar ≫ σi_l :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            have hδ_vbar : d_vbar_l ≫ fst_vbar = CategoryTheory.CategoryStruct.id S_inf :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            have hσi_fst : σi_l ≫ fst_prW = u_i i :=
              CategoryTheory.Limits.pullback.lift_fst (u_i i) v_bar hu_comm
            have sL1 : ((ab ≫ e_inv_l) ≫ fst₁) ≫ fst₂ = ab ≫ ((e_inv_l ≫ fst₁) ≫ fst₂) :=
              (congrArg (· ≫ fst₂) (CategoryTheory.Category.assoc ab e_inv_l fst₁)).trans
                (CategoryTheory.Category.assoc ab (e_inv_l ≫ fst₁) fst₂)
            have sL2 : ab ≫ ((e_inv_l ≫ fst₁) ≫ fst₂) =
                (d_vbar_l ≫ b_σi_l) ≫ (fst_bvpr ≫ fst_prW) :=
              congrArg (ab ≫ ·) he_fst
            have sL3 : (d_vbar_l ≫ b_σi_l) ≫ (fst_bvpr ≫ fst_prW) =
                d_vbar_l ≫ ((b_σi_l ≫ fst_bvpr) ≫ fst_prW) :=
              (CategoryTheory.Category.assoc d_vbar_l b_σi_l (fst_bvpr ≫ fst_prW)).trans
                (congrArg (d_vbar_l ≫ ·)
                  (CategoryTheory.Category.assoc b_σi_l fst_bvpr fst_prW).symm)
            have sL4 : d_vbar_l ≫ ((b_σi_l ≫ fst_bvpr) ≫ fst_prW) =
                d_vbar_l ≫ ((fst_vbar ≫ σi_l) ≫ fst_prW) :=
              congrArg (fun k_hom => d_vbar_l ≫ (k_hom ≫ fst_prW)) hB_σi
            have sL5 : d_vbar_l ≫ ((fst_vbar ≫ σi_l) ≫ fst_prW) =
                (d_vbar_l ≫ fst_vbar) ≫ (σi_l ≫ fst_prW) :=
              (congrArg (d_vbar_l ≫ ·)
                (CategoryTheory.Category.assoc fst_vbar σi_l fst_prW)).trans
                (CategoryTheory.Category.assoc d_vbar_l fst_vbar (σi_l ≫ fst_prW)).symm
            have sL6 : (d_vbar_l ≫ fst_vbar) ≫ (σi_l ≫ fst_prW) = u_i i :=
              (congrArg₂ CategoryTheory.CategoryStruct.comp hδ_vbar hσi_fst).trans
                (CategoryTheory.Category.id_comp (u_i i))
            exact sL1.trans (sL2.trans (sL3.trans (sL4.trans (sL5.trans sL6))))
          have hR : (mR ≫ fst₁) ≫ fst₂ = u_i i := by
            let α_u_l : Quiver.Hom S_inf (CategoryTheory.Limits.pullback id_Si (u_i i)) := α_u.left
            let b_κ_l : Quiver.Hom (CategoryTheory.Limits.pullback id_Si (u_i i))
                (CategoryTheory.Limits.pullback (B_pi.obj U₀).hom (u_i i)) := (B_ui.map κ_i).left
            let e_tri_l : Quiver.Hom (CategoryTheory.Limits.pullback (B_pi.obj U₀).hom (u_i i))
                (CategoryTheory.Limits.pullback u₀_hom p_inf) := (e_B_tri.inv.app U₀).left
            let fst_ui := CategoryTheory.Limits.pullback.fst (B_pi.obj U₀).hom (u_i i)
            let fst_pi := CategoryTheory.Limits.pullback.fst u₀_hom (p_i i)
            let fst_id_ui := CategoryTheory.Limits.pullback.fst id_Si (u_i i)
            have he_tri : e_tri_l ≫ fst₁ = fst_ui ≫ fst_pi :=
              he_inv_fst p_inf (p_i i) (u_i i) hu U₀
            have hb_κ : b_κ_l ≫ fst_ui = fst_id_ui ≫ κ_i.left :=
              hB_map_fst (u_i i) κ_i
            have hα_fst : α_u_l ≫ fst_id_ui = u_i i :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            have hκ_fst : κ_i.left ≫ (fst_pi ≫ fst₂) =
                CategoryTheory.CategoryStruct.id (S_i i) := by
              have hc_vi : (c_vi.hom.app V_i).left ≫ (fst_pi ≫ fst₂) =
                  CategoryTheory.Limits.pullback.fst v_i_hom v_i :=
                CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst (p_i i) g₀ V_i
              have hδ_vi : δ_vi.left ≫ CategoryTheory.Limits.pullback.fst v_i_hom v_i =
                  CategoryTheory.CategoryStruct.id (S_i i) :=
                CategoryTheory.Limits.pullback.lift_fst _ _ _
              exact (CategoryTheory.Category.assoc δ_vi.left (c_vi.hom.app V_i).left
                (fst_pi ≫ fst₂)).trans ((congrArg (δ_vi.left ≫ ·) hc_vi).trans hδ_vi)
            let abR := α_u_l ≫ b_κ_l
            have sR1 : ((abR ≫ e_tri_l) ≫ fst₁) ≫ fst₂ =
                abR ≫ ((e_tri_l ≫ fst₁) ≫ fst₂) :=
              (congrArg (· ≫ fst₂) (CategoryTheory.Category.assoc abR e_tri_l fst₁)).trans
                (CategoryTheory.Category.assoc abR (e_tri_l ≫ fst₁) fst₂)
            have sR2 : abR ≫ ((e_tri_l ≫ fst₁) ≫ fst₂) =
                (α_u_l ≫ b_κ_l) ≫ (fst_ui ≫ (fst_pi ≫ fst₂)) :=
              congrArg (abR ≫ ·)
                ((congrArg (· ≫ fst₂) he_tri).trans
                  (CategoryTheory.Category.assoc fst_ui fst_pi fst₂))
            have sR3 : (α_u_l ≫ b_κ_l) ≫ (fst_ui ≫ (fst_pi ≫ fst₂)) =
                α_u_l ≫ ((b_κ_l ≫ fst_ui) ≫ (fst_pi ≫ fst₂)) :=
              (CategoryTheory.Category.assoc α_u_l b_κ_l (fst_ui ≫ (fst_pi ≫ fst₂))).trans
                (congrArg (α_u_l ≫ ·)
                  (CategoryTheory.Category.assoc b_κ_l fst_ui (fst_pi ≫ fst₂)).symm)
            have sR4 : α_u_l ≫ ((b_κ_l ≫ fst_ui) ≫ (fst_pi ≫ fst₂)) =
                (α_u_l ≫ fst_id_ui) ≫ (κ_i.left ≫ (fst_pi ≫ fst₂)) :=
              (congrArg (fun k_hom => α_u_l ≫ (k_hom ≫ (fst_pi ≫ fst₂))) hb_κ).trans
                ((congrArg (α_u_l ≫ ·)
                  (CategoryTheory.Category.assoc fst_id_ui κ_i.left (fst_pi ≫ fst₂))).trans
                  (CategoryTheory.Category.assoc α_u_l fst_id_ui (κ_i.left ≫ (fst_pi ≫ fst₂))).symm)
            have sR5 : (α_u_l ≫ fst_id_ui) ≫ (κ_i.left ≫ (fst_pi ≫ fst₂)) = u_i i :=
              (congrArg₂ CategoryTheory.CategoryStruct.comp hα_fst hκ_fst).trans
                (CategoryTheory.Category.comp_id (u_i i))
            exact sR1.trans (sR2.trans (sR3.trans (sR4.trans sR5)))
          exact hL.trans hR.symm
        · have h_cond : CategoryTheory.Limits.pullback.fst u₀_hom p_inf ≫ u₀_hom =
              CategoryTheory.Limits.pullback.snd u₀_hom p_inf ≫ p_inf :=
            CategoryTheory.Limits.pullback.condition
          exact (CategoryTheory.Category.assoc mL _ _).trans
            ((congrArg (mL ≫ ·) h_cond).trans
              ((CategoryTheory.Category.assoc mL _ p_inf).symm.trans
                ((congrArg (· ≫ p_inf) (hmL_snd.trans hmR_snd.symm)).trans
                  ((CategoryTheory.Category.assoc mR _ p_inf).trans
                    ((congrArg (mR ≫ ·) h_cond.symm).trans
                      (CategoryTheory.Category.assoc mR _ _).symm)))))
      · exact hmL_snd.trans hmR_snd.symm
    exact hLHS_ξ.trans
      ((congrArg (fun m => (ℋ_L.obj.map (Opposite.op m)).hom ξ_i) hm_et_eq).trans hRHS_ξ.symm)

  
  
  
  let ℐ := { L : IntermediateField E₀ k // FiniteDimensional E₀ ↥L }
  have hFieldTower := (hFieldColim E₀).1
  obtain ⟨hFilt_ℐ, hColim_D⟩ := (hFieldColim E₀).2
  letI : CategoryTheory.IsFiltered ℐ := hFilt_ℐ

  have hSup : ∀ (m : ℕ) (i_fam : Fin m → ℐ),
      ∃ i_top : ℐ, ∀ r : Fin m, (i_fam r).1 ≤ i_top.1 := by
    intro m
    induction m with
    | zero =>
      intro _
      exact ⟨⟨⊥, inferInstance⟩, fun r => Fin.elim0 r⟩
    | succ m ih =>
      intro i_fam
      obtain ⟨i_sub, h_sub⟩ := ih (fun r => i_fam r.succ)
      letI : FiniteDimensional E₀ ↥(i_fam 0).1 := (i_fam 0).2
      letI : FiniteDimensional E₀ ↥i_sub.1 := i_sub.2
      refine ⟨⟨(i_fam 0).1 ⊔ i_sub.1,
        IntermediateField.finiteDimensional_sup (i_fam 0).1 i_sub.1⟩, ?_⟩
      intro r
      refine Fin.cases ?_ ?_ r
      · exact le_sup_left
      · intro r'
        exact (h_sub r').trans le_sup_right

  have hAff_each : ∀ x : ↥Z₀.left,
      ∃ W : Z₀.left.Opens, AlgebraicGeometry.IsAffineOpen W ∧ x ∈ W := by
    intro x
    obtain ⟨W, hW, hxW, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Z₀.left) (U := ⊤) (Set.mem_univ x)
    exact ⟨W, hW, hxW⟩
  choose W_pt hW_aff hx_W using hAff_each
  obtain ⟨s_fin, hs_cov⟩ := IsCompact.elim_finite_subcover
    (isCompact_univ : IsCompact (Set.univ : Set ↥Z₀.left))
    (fun x : ↥Z₀.left => (W_pt x : Set ↥Z₀.left))
    (fun x => (W_pt x).isOpen)
    (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_W x⟩)
  let m := s_fin.card
  let eqv_s : Fin m ≃ ↥s_fin := s_fin.equivFin.symm
  let N : Fin m → Z₀.left.Opens := fun r => W_pt (eqv_s r).1
  have hN_aff : ∀ r : Fin m, AlgebraicGeometry.IsAffineOpen (N r) :=
    fun r => hW_aff (eqv_s r).1
  have hCov_N : ∀ x : ↥Z₀.left, ∃ r : Fin m, x ∈ N r := by
    intro x
    have hx := hs_cov (Set.mem_univ x)
    rw [Set.mem_iUnion₂] at hx
    rcases hx with ⟨y, hy_s, hxy⟩
    exact ⟨eqv_s.symm ⟨y, hy_s⟩, by simpa [N] using hxy⟩

  let D_fam : Fin m → Type u := fun r => ↑(Z₀.left.presheaf.obj (Opposite.op (N r)))
  let e_N₀ : ∀ r : Fin m,
      CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of (D_fam r))) (N r).toScheme :=
    fun r => (hN_aff r).isoSpec.symm
  let φ_E₀_D : ∀ r : Fin m, Quiver.Hom (CommRingCat.of E₀) (CommRingCat.of (D_fam r)) :=
    fun r => AlgebraicGeometry.Spec.preimage ((e_N₀ r).hom ≫ ((N r).ι ≫ Z₀.hom))
  letI : ∀ r : Fin m, Algebra E₀ (D_fam r) := fun r => (φ_E₀_D r).hom.toAlgebra
  have hSpec_alg_D : ∀ r : Fin m,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ (D_fam r))) =
        (e_N₀ r).hom ≫ ((N r).ι ≫ Z₀.hom) := by
    intro r
    have hφ_eq : CommRingCat.ofHom (algebraMap E₀ (D_fam r)) = φ_E₀_D r :=
      CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
    rw [hφ_eq]
    exact AlgebraicGeometry.Spec.map_preimage _

  have hChartTP : ∀ (K_ext : Type u) [Field K_ext] [Algebra E₀ K_ext]
      {X_top : AlgebraicGeometry.Scheme.{u}}
      (p_top : X_top ⟶ Z₀.left)
      (q_top : X_top ⟶ AlgebraicGeometry.Spec (CommRingCat.of K_ext)),
      CategoryTheory.IsPullback p_top q_top Z₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ K_ext))) →
      ∀ r : Fin m,
        let O_top : X_top.Opens := (TopologicalSpace.Opens.map p_top.base).obj (N r)
        ∃ e_TP : CategoryTheory.Iso
            (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct E₀ K_ext (D_fam r))))
            O_top.toScheme,
          e_TP.hom ≫ ((p_top ∣_ (N r)) ≫ (e_N₀ r).inv) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight :
                D_fam r →ₐ[E₀] TensorProduct E₀ K_ext (D_fam r)).toRingHom) ∧
          e_TP.hom ≫ (O_top.ι ≫ q_top) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeLeftRingHom :
                K_ext →+* TensorProduct E₀ K_ext (D_fam r))) := by
    intro K_ext _ _ X_top p_top q_top hpb_top r O_top
    let g_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ K_ext))
    have h_tp : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight :
            D_fam r →ₐ[E₀] TensorProduct E₀ K_ext (D_fam r)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom :
            K_ext →+* TensorProduct E₀ K_ext (D_fam r))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ (D_fam r))))
        g_K :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct E₀ K_ext (D_fam r)).flip
    have h_vert : CategoryTheory.IsPullback
        (p_top ∣_ (N r))
        (O_top.ι ≫ q_top)
        ((N r).ι ≫ Z₀.hom)
        g_K :=
      (AlgebraicGeometry.isPullback_morphismRestrict p_top (N r)).paste_vert hpb_top
    have h_geom : CategoryTheory.IsPullback
        ((p_top ∣_ (N r)) ≫ (e_N₀ r).inv)
        (O_top.ι ≫ q_top)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ (D_fam r))))
        g_K := by
      refine h_vert.of_iso
        (CategoryTheory.Iso.refl _) (e_N₀ r).symm
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        ?_ ?_ ?_ ?_
      · exact (CategoryTheory.Category.id_comp _).symm
      · exact (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm
      · exact (CategoryTheory.Category.comp_id ((N r).ι ≫ Z₀.hom)).trans
          ((CategoryTheory.Category.id_comp ((N r).ι ≫ Z₀.hom)).symm.trans
            ((congrArg (· ≫ ((N r).ι ≫ Z₀.hom)) (e_N₀ r).inv_hom_id.symm).trans
              ((CategoryTheory.Category.assoc (e_N₀ r).inv (e_N₀ r).hom _).trans
                (congrArg ((e_N₀ r).inv ≫ ·) (hSpec_alg_D r).symm))))
      · exact (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm
    let e_TP := CategoryTheory.IsPullback.isoIsPullback
      (AlgebraicGeometry.Spec (CommRingCat.of (D_fam r)))
      (AlgebraicGeometry.Spec (CommRingCat.of K_ext))
      h_tp h_geom
    exact ⟨e_TP,
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ h_tp h_geom,
      CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ h_tp h_geom⟩

  have hp_i_et : ∀ (r : Fin m) (i : ℐ),
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight :
          D_fam r →ₐ[E₀] TensorProduct E₀ ↥i.1 (D_fam r)).toRingHom)) := by
    intro r i
    letI : FiniteDimensional E₀ ↥i.1 := i.2
    obtain ⟨hFin_i, _⟩ := hFieldTower i.1
    letI : Finite ↥i.1 := hFin_i
    have h_pb_i : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight :
            D_fam r →ₐ[E₀] TensorProduct E₀ ↥i.1 (D_fam r)).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom :
            ↥i.1 →+* TensorProduct E₀ ↥i.1 (D_fam r))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ (D_fam r))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ ↥i.1))) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct E₀ ↥i.1 (D_fam r)).flip
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      h_pb_i.flip (hFieldEt E₀ ↥i.1)

  let Z_bar_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_W.obj Z_bar).left
  let z_bar : Quiver.Hom Z_bar_sch W_bar := (Fgt_W.obj Z_bar).hom
  have hz_bar_et : AlgebraicGeometry.Etale z_bar := Z_bar.prop
  let O_0 : Fin m → Z_bar_sch.Opens := fun r => (TopologicalSpace.Opens.map p_Z.base).obj (N r)
  choose e_Nbar he_Nbar_fst he_Nbar_snd using
    hChartTP k p_Z (z_bar ≫ snd_W) hp_Z

  let D_fun : ∀ r : Fin m, CategoryTheory.Functor ℐ CommRingCat.{u} := fun r =>
    { obj := fun i => CommRingCat.of (TensorProduct E₀ ↥i.1 (D_fam r))
      map := fun {i j} θ => CommRingCat.ofHom
        (Algebra.TensorProduct.map
          (IntermediateField.inclusion (CategoryTheory.leOfHom θ))
          (AlgHom.id E₀ (D_fam r))).toRingHom
      map_id := fun i => CommRingCat.hom_ext
        (congrArg AlgHom.toRingHom
          (a₁ := Algebra.TensorProduct.map
            (IntermediateField.inclusion
              (CategoryTheory.leOfHom (CategoryTheory.CategoryStruct.id i)))
            (AlgHom.id E₀ (D_fam r)))
          (a₂ := AlgHom.id E₀ (TensorProduct E₀ ↥i.1 (D_fam r)))
          (Algebra.TensorProduct.ext' fun _ _ => rfl))
      map_comp := fun {i j l} θ₁ θ₂ => CommRingCat.hom_ext
        (congrArg AlgHom.toRingHom
          (a₁ := Algebra.TensorProduct.map
            (IntermediateField.inclusion (CategoryTheory.leOfHom (θ₁ ≫ θ₂)))
            (AlgHom.id E₀ (D_fam r)))
          (a₂ := (Algebra.TensorProduct.map
            (IntermediateField.inclusion (CategoryTheory.leOfHom θ₂))
            (AlgHom.id E₀ (D_fam r))).comp
            (Algebra.TensorProduct.map
              (IntermediateField.inclusion (CategoryTheory.leOfHom θ₁))
              (AlgHom.id E₀ (D_fam r))))
          (Algebra.TensorProduct.ext' fun _ _ => rfl)) }
  let α_fun : ∀ r : Fin m,
      Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (D_fam r))) (D_fun r) :=
    fun r =>
      { app := fun i => CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight :
            D_fam r →ₐ[E₀] TensorProduct E₀ ↥i.1 (D_fam r)).toRingHom
        naturality := fun {i j} _ => CommRingCat.hom_ext (RingHom.ext fun _ => rfl) }
  let c_fun : ∀ r : Fin m, CategoryTheory.Limits.Cocone (D_fun r) := fun r =>
    { pt := CommRingCat.of (TensorProduct E₀ k (D_fam r))
      ι :=
        { app := fun i => CommRingCat.ofHom
            (Algebra.TensorProduct.map i.1.val (AlgHom.id E₀ (D_fam r))).toRingHom
          naturality := fun {i j} θ =>
            (CommRingCat.hom_ext
              (congrArg AlgHom.toRingHom
                (a₁ := (Algebra.TensorProduct.map j.1.val (AlgHom.id E₀ (D_fam r))).comp
                  (Algebra.TensorProduct.map
                    (IntermediateField.inclusion (CategoryTheory.leOfHom θ))
                    (AlgHom.id E₀ (D_fam r))))
                (a₂ := Algebra.TensorProduct.map i.1.val (AlgHom.id E₀ (D_fam r)))
                (Algebra.TensorProduct.ext' fun _ _ => rfl))).trans
              (CategoryTheory.Category.comp_id _).symm } }
  let f_inf_fam : ∀ r : Fin m, Quiver.Hom (CommRingCat.of (D_fam r)) (c_fun r).pt :=
    fun r => CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : D_fam r →ₐ[E₀] TensorProduct E₀ k (D_fam r)).toRingHom
  let g₀_fam : ∀ r : Fin m,
      Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (D_fam r))) W₀.left :=
    fun r => (e_N₀ r).hom ≫ ((N r).ι ≫ z_W)
  let v_bar_fam : ∀ r : Fin m,
