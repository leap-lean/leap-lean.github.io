    obtain ⟨s_mid, hs_mid⟩ :=
      LinearMap.exists_rightInverse_of_surjective P.rangeRestrict P.range_rangeRestrict
    let S_high : V_high →ₗ[K₀] V_mid := s_mid.comp r_high
    let e_proj : V_mid →ₗ[K₀] V_mid := LinearMap.id - S_high.comp P
    have he_mem : ∀ w : V_mid, e_proj w ∈ LinearMap.range G := by
      intro w
      apply hKer_le_Range
      simp only [e_proj, S_high, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply,
