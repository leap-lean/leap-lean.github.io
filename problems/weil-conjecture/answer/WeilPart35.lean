        have hlt : (iu_lt k hk).castSucc < u_idx j := by change 2 * k.1 < 2 * j.1; omega
        rw [Fin.succAbove_of_castSucc_lt _ _ hlt]; rfl
      have h_iv_lt : ∀ (k : Fin (m + 1)) (hk : k.1 < j.1),
          (u_idx j).succAbove (iv_lt k hk) = v_idx k := by
        intro k hk
        apply Fin.ext
        have hlt : (iv_lt k hk).castSucc < u_idx j := by change 2 * k.1 + 1 < 2 * j.1; omega
        rw [Fin.succAbove_of_castSucc_lt _ _ hlt]; rfl
      have h_istar : (u_idx j).succAbove i_star = v_idx j := by
        apply Fin.ext
        have hle : u_idx j ≤ i_star.castSucc := by change 2 * j.1 ≤ 2 * j.1; omega
        rw [Fin.succAbove_of_le_castSucc _ _ hle]; rfl
      have h_iu_gt : ∀ (k : Fin (m + 1)) (hk : j.1 < k.1),
          (u_idx j).succAbove (iu_gt k hk) = u_idx k := by
        intro k hk
        apply Fin.ext
        have hle : u_idx j ≤ (iu_gt k hk).castSucc := by change 2 * j.1 ≤ 2 * k.1 - 1; omega
        rw [Fin.succAbove_of_le_castSucc _ _ hle]
        change (2 * k.1 - 1) + 1 = 2 * k.1; omega
      have h_iv_gt : ∀ (k : Fin (m + 1)) (hk : j.1 < k.1),
          (u_idx j).succAbove (iv_gt k hk) = v_idx k := by
        intro k hk
        apply Fin.ext
        have hle : u_idx j ≤ (iv_gt k hk).castSucc := by change 2 * j.1 ≤ 2 * k.1; omega
        rw [Fin.succAbove_of_le_castSucc _ _ hle]; rfl
      have h_iw : (u_idx j).succAbove iw = w_idx := by
        apply Fin.ext
        have hle : u_idx j ≤ iw.castSucc := by change 2 * j.1 ≤ 2 * m + 1; omega
        rw [Fin.succAbove_of_le_castSucc _ _ hle]; rfl
      have h_lin_mem : ∀ (ν : Fin j.1), MvPolynomial.X ⟨2 * ν.1, by omega⟩ ∈ J_j := by
        intro ν
        let k : Fin (m + 1) := ⟨ν.1, by omega⟩
        have hgen : θ.symm (g_quad j.castSucc ν.castSucc) ∈ J_j :=
          Ideal.subset_span ⟨ν.castSucc, rfl⟩
        have heq : θ.symm (g_quad j.castSucc ν.castSucc) = MvPolynomial.X (iu_lt k ν.isLt) := by
          dsimp [g_quad]
          rw [Fin.lastCases_castSucc]
          change θ.symm (τ (u_idx k)) = _
          rw [← h_iu_lt k ν.isLt, hθ_symm_succ]
        rwa [heq] at hgen
      have h_quad_mem : θ.symm q_A ∈ J_j := by
        have hgen : θ.symm (g_quad j.castSucc (Fin.last j.1)) ∈ J_j :=
          Ideal.subset_span ⟨Fin.last j.1, rfl⟩
        dsimp [g_quad] at hgen
        rwa [Fin.lastCases_last] at hgen
      let emb_fn : Fin d_j → Fin N := fun r =>
        if h : r.1 < j.1 then
          ⟨2 * r.1 + 1, by have : j.1 < m + 1 := j.isLt; dsimp only [N]; omega⟩
        else
          ⟨r.1 + j.1 + 1, by have : r.1 < 2 * m + 1 - j.1 := r.isLt; dsimp only [N]; omega⟩
      let rw_idx : Fin d_j := ⟨2 * m - j.1, by omega⟩
      let ru : ∀ (k : Fin (m + 1)), j.1 < k.1 → Fin d_j :=
        fun k hk => ⟨2 * k.1 - j.1 - 2, by omega⟩
      let rv : ∀ (k : Fin (m + 1)), j.1 < k.1 → Fin d_j :=
        fun k hk => ⟨2 * k.1 - j.1 - 1, by omega⟩
      have h_emb_rw : emb_fn rw_idx = iw := by
        dsimp [emb_fn, rw_idx, iw]
        split_ifs with h
        · omega
        · apply Fin.ext; dsimp; omega
      have h_emb_ru : ∀ (k : Fin (m + 1)) (hk : j.1 < k.1), emb_fn (ru k hk) = iu_gt k hk := by
        intro k hk
        dsimp [emb_fn, ru, iu_gt]
        split_ifs with h
        · omega
        · apply Fin.ext; dsimp; omega
      have h_emb_rv : ∀ (k : Fin (m + 1)) (hk : j.1 < k.1), emb_fn (rv k hk) = iv_gt k hk := by
        intro k hk
        dsimp [emb_fn, rv, iv_gt]
        split_ifs with h
        · omega
        · apply Fin.ext; dsimp; omega
      let P₀ : MvPolynomial (Fin d_j) K :=
        MvPolynomial.C t * (MvPolynomial.X rw_idx) ^ 2 -
          ∑ k : Fin (m + 1),
            if hk : j.1 < k.1 then MvPolynomial.X (ru k hk) * MvPolynomial.X (rv k hk) else 0
      let ψ_fn : Fin N → MvPolynomial (Fin d_j) K := fun i =>
        if i.1 < 2 * j.1 then
          if i.1 % 2 = 0 then 0 else MvPolynomial.X ⟨i.1 / 2, by omega⟩
        else if i.1 = 2 * j.1 then
          P₀
        else
          MvPolynomial.X ⟨i.1 - j.1 - 1, by omega⟩
      have h_left : ∀ r : Fin d_j, ψ_fn (emb_fn r) = MvPolynomial.X r := by
        intro r
        have hr_bound := r.isLt
        dsimp [emb_fn, ψ_fn]
        by_cases hr : r.1 < j.1
        · simp only [hr, ↓reduceDIte]
          have hlt : 2 * r.1 + 1 < 2 * j.1 := by omega
          have hmod : ¬ ((2 * r.1 + 1) % 2 = 0) := by omega
          simp only [hlt, hmod, ↓reduceIte]
          congr 1; apply Fin.ext; dsimp; omega
        · simp only [hr, ↓reduceDIte]
          have hnlt : ¬ (r.1 + j.1 + 1 < 2 * j.1) := by omega
          have hneq : ¬ (r.1 + j.1 + 1 = 2 * j.1) := by omega
          simp only [hnlt, hneq, ↓reduceIte]
          congr 1; apply Fin.ext; dsimp; omega
      have h_term_pull : ∀ k : Fin (m + 1),
          θ.symm (τ (u_idx k)) * θ.symm (τ (v_idx k)) =
            (if hk_lt : k.1 < j.1 then
              MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) +
            (if k = j then MvPolynomial.X i_star else 0) +
            (if hk_gt : j.1 < k.1 then
              MvPolynomial.X (iu_gt k hk_gt) * MvPolynomial.X (iv_gt k hk_gt) else 0) := by
        intro k
        rcases lt_trichotomy k.1 j.1 with hk_lt | hk_eq | hk_gt
        · have hkne : k ≠ j := fun h => by subst h; omega
          have hn_gt : ¬ (j.1 < k.1) := by omega
          simp only [hk_lt, hkne, hn_gt, ↓reduceDIte, ↓reduceIte, add_zero]
          rw [← h_iu_lt k hk_lt, ← h_iv_lt k hk_lt, hθ_symm_succ, hθ_symm_succ]
        · have hkeq : k = j := Fin.ext hk_eq
          subst hkeq
          have hn_lt : ¬ (k.1 < k.1) := lt_irrefl _
          simp only [hn_lt, ↓reduceDIte, ↓reduceIte, zero_add, add_zero]
          rw [hτ_uj, map_one, one_mul, ← h_istar, hθ_symm_succ]
        · have hn_lt : ¬ (k.1 < j.1) := by omega
          have hkne : k ≠ j := fun h => by subst h; omega
          simp only [hn_lt, hkne, hk_gt, ↓reduceDIte, ↓reduceIte, zero_add]
          rw [← h_iu_gt k hk_gt, ← h_iv_gt k hk_gt, hθ_symm_succ, hθ_symm_succ]
      have h_qA_pull : θ.symm q_A =
          (∑ k : Fin (m + 1),
            if hk_lt : k.1 < j.1 then
              MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) +
          (MvPolynomial.X i_star - MvPolynomial.rename emb_fn P₀) := by
        dsimp [q_A]
        rw [map_sub, map_sum, map_mul, map_pow, hθ_symm_c, ← h_iw, hθ_symm_succ]
        have hsum_split : (∑ k : Fin (m + 1), θ.symm (τ (u_idx k) * τ (v_idx k))) =
            (∑ k : Fin (m + 1),
              if hk_lt : k.1 < j.1 then
                MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) +
            MvPolynomial.X i_star +
            (∑ k : Fin (m + 1),
              if hk_gt : j.1 < k.1 then
                MvPolynomial.X (iu_gt k hk_gt) * MvPolynomial.X (iv_gt k hk_gt) else 0) := by
          trans ∑ k : Fin (m + 1),
            ((if hk_lt : k.1 < j.1 then
                MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) +
              (if k = j then MvPolynomial.X i_star else 0) +
              (if hk_gt : j.1 < k.1 then
                MvPolynomial.X (iu_gt k hk_gt) * MvPolynomial.X (iv_gt k hk_gt) else 0))
          · refine Finset.sum_congr rfl fun k _ => ?_
            rw [map_mul, h_term_pull k]
          · rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
            simp [Finset.sum_ite_eq']
        have h_ren_P0 : MvPolynomial.rename emb_fn P₀ =
            MvPolynomial.C t * (MvPolynomial.X iw) ^ 2 -
            ∑ k : Fin (m + 1),
              if hk_gt : j.1 < k.1 then
                MvPolynomial.X (iu_gt k hk_gt) * MvPolynomial.X (iv_gt k hk_gt) else 0 := by
          dsimp [P₀]
          rw [map_sub, map_mul, map_pow, MvPolynomial.rename_C, MvPolynomial.rename_X,
            h_emb_rw, map_sum]
          congr 1
          refine Finset.sum_congr rfl fun k _ => ?_
          split_ifs with hk_gt
          · rw [map_mul, MvPolynomial.rename_X, MvPolynomial.rename_X,
              h_emb_ru k hk_gt, h_emb_rv k hk_gt]
          · exact map_zero _
        rw [hsum_split, h_ren_P0]
        ring
      have h_vanish : ∀ x ∈ J_j, MvPolynomial.aeval ψ_fn x = 0 := by
        intro x hx
        have hker : J_j ≤ RingHom.ker (MvPolynomial.aeval ψ_fn).toRingHom := by
          rw [Ideal.span_le]
          rintro _ ⟨ν, rfl⟩
          change MvPolynomial.aeval ψ_fn (θ.symm (g_quad j.castSucc ν)) = 0
          refine Fin.lastCases ?_ (fun μ => ?_) ν
          · dsimp only [g_quad]
            rw [Fin.lastCases_last, h_qA_pull, map_add, map_sum, map_sub, MvPolynomial.aeval_X]
            have h1 : (∑ k : Fin (m + 1),
                (MvPolynomial.aeval (R := K) ψ_fn)
                  (if hk_lt : k.1 < j.1 then
                    MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0)) = 0 := by
              refine Finset.sum_eq_zero fun k _ => ?_
              split_ifs with hk_lt
              · rw [map_mul, MvPolynomial.aeval_X]
                have h0 : ψ_fn (iu_lt k hk_lt) = 0 := by
                  dsimp only [ψ_fn, iu_lt]
                  have hlt2 : 2 * k.1 < 2 * j.1 := by omega
                  have hmod2 : (2 * k.1) % 2 = 0 := by omega
                  simp [hlt2, hmod2]
                rw [h0, zero_mul]
              · exact map_zero _
            have h2 : ψ_fn i_star = P₀ := by dsimp only [ψ_fn, i_star]; simp
            have h3 : MvPolynomial.aeval ψ_fn (MvPolynomial.rename emb_fn P₀) = P₀ := by
              have hcomp : (MvPolynomial.aeval ψ_fn).comp (MvPolynomial.rename emb_fn) =
                  AlgHom.id K _ := by
                apply MvPolynomial.algHom_ext
                intro r
                simp [MvPolynomial.rename_X, h_left r]
              exact AlgHom.congr_fun hcomp P₀
            rw [h1, h2, h3, sub_self, add_zero]
          · have hμ_lt : μ.1 < j.1 := μ.isLt
            have heq : θ.symm (g_quad j.castSucc μ.castSucc) =
                MvPolynomial.X (iu_lt ⟨μ.1, by omega⟩ hμ_lt) := by
              dsimp only [g_quad]
              rw [Fin.lastCases_castSucc]
              rw [← h_iu_lt ⟨μ.1, by omega⟩ hμ_lt, hθ_symm_succ]
            rw [heq, MvPolynomial.aeval_X]
            dsimp only [ψ_fn, iu_lt]
            have hlt2 : 2 * μ.1 < 2 * j.1 := by omega
            have hmod2 : (2 * μ.1) % 2 = 0 := by omega
            simp [hlt2, hmod2]
        exact hker hx
      have h_istar_mem : MvPolynomial.X i_star - MvPolynomial.rename emb_fn P₀ ∈ J_j := by
        have hS_lt_mem : (∑ k : Fin (m + 1),
            if hk_lt : k.1 < j.1 then
              MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) ∈ J_j := by
          refine Ideal.sum_mem J_j fun k _ => ?_
          split_ifs with hk_lt
          · exact J_j.mul_mem_right _ (h_lin_mem ⟨k.1, hk_lt⟩)
          · exact J_j.zero_mem
        have hdiff : MvPolynomial.X i_star - MvPolynomial.rename emb_fn P₀ =
            θ.symm q_A - (∑ k : Fin (m + 1),
              if hk_lt : k.1 < j.1 then
                MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) := by
          rw [h_qA_pull]; ring
        rw [hdiff]
        exact J_j.sub_mem h_quad_mem hS_lt_mem
      have h_right : ∀ i : Fin N, MvPolynomial.X i - MvPolynomial.rename emb_fn (ψ_fn i) ∈ J_j := by
        intro i
        by_cases hi_lt : i.1 < 2 * j.1
        · by_cases hi_even : i.1 % 2 = 0
          · have hψ : ψ_fn i = 0 := by dsimp [ψ_fn]; simp [hi_lt, hi_even]
            rw [hψ, map_zero, sub_zero]
            have h_eq : i = ⟨2 * (i.1 / 2), by omega⟩ := by apply Fin.ext; dsimp; omega
            rw [h_eq]
            exact h_lin_mem ⟨i.1 / 2, by omega⟩
          · have hψ : ψ_fn i = MvPolynomial.X ⟨i.1 / 2, by omega⟩ := by
              dsimp [ψ_fn]; simp [hi_lt, hi_even]
            rw [hψ, MvPolynomial.rename_X]
            have hemb : emb_fn ⟨i.1 / 2, by omega⟩ = i := by
              dsimp [emb_fn]
              have hlt : i.1 / 2 < j.1 := by omega
              simp only [hlt, ↓reduceDIte]
              apply Fin.ext; dsimp; omega
            rw [hemb, sub_self]
            exact J_j.zero_mem
        · by_cases hi_eq : i.1 = 2 * j.1
          · have hi_star : i = i_star := Fin.ext hi_eq
            subst hi_star
            have hψ : ψ_fn i_star = P₀ := by dsimp [ψ_fn, i_star]; simp
            rw [hψ]
            exact h_istar_mem
          · have hψ : ψ_fn i = MvPolynomial.X ⟨i.1 - j.1 - 1, by omega⟩ := by
              dsimp [ψ_fn]; simp [hi_lt, hi_eq]
            rw [hψ, MvPolynomial.rename_X]
            have hemb : emb_fn ⟨i.1 - j.1 - 1, by omega⟩ = i := by
              dsimp [emb_fn]
              have hnlt : ¬ (i.1 - j.1 - 1 < j.1) := by omega
              simp only [hnlt, ↓reduceDIte]
              apply Fin.ext; dsimp; omega
            rw [hemb, sub_self]
            exact J_j.zero_mem
      exact hMvPolyQuotEquiv N d_j J_j emb_fn ψ_fn h_vanish h_left h_right
    · intro θ hτ_w hθ_c hθ_X J_top
      have hθ_symm_c : ∀ x : K, θ.symm (c x) = MvPolynomial.C x := by
        intro x
        apply θ.injective
        rw [θ.apply_symm_apply]
        exact (RingHom.congr_fun hθ_c x).symm
      have hθ_symm_cast : ∀ i : Fin N, θ.symm (τ i.castSucc) = MvPolynomial.X i := by
        intro i
        have hw : w_idx.succAbove i = i.castSucc := congrFun Fin.succAbove_last i
        apply θ.injective
        rw [θ.apply_symm_apply, ← hw, hθ_X i]
      have h_even_mem : ∀ k : Fin (m + 1), MvPolynomial.X ⟨2 * k.1, by omega⟩ ∈ J_top := by
        intro k
        have hgen : θ.symm (g_quad (Fin.last (m + 1)) k.castSucc) ∈ J_top :=
          Ideal.subset_span ⟨k.castSucc, rfl⟩
        have heq : θ.symm (g_quad (Fin.last (m + 1)) k.castSucc) =
            MvPolynomial.X ⟨2 * k.1, by omega⟩ := by
          dsimp [g_quad]
          rw [Fin.lastCases_castSucc]
          exact hθ_symm_cast ⟨2 * k.1, by omega⟩
        rwa [heq] at hgen
      have h_q_pull : θ.symm q_A =
          (∑ k : Fin (m + 1),
            MvPolynomial.X ⟨2 * k.1, by omega⟩ * MvPolynomial.X ⟨2 * k.1 + 1, by omega⟩) -
          MvPolynomial.C t := by
        dsimp [q_A]
        rw [hτ_w, one_pow, mul_one, map_sub, map_sum, hθ_symm_c]
        congr 1
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_mul]
        exact congrArg₂ (· * ·) (hθ_symm_cast ⟨2 * k.1, by omega⟩)
          (hθ_symm_cast ⟨2 * k.1 + 1, by omega⟩)
      have h_q_mem : θ.symm q_A ∈ J_top := by
        have hgen : θ.symm (g_quad (Fin.last (m + 1)) (Fin.last (m + 1))) ∈ J_top :=
          Ideal.subset_span ⟨Fin.last (m + 1), rfl⟩
        dsimp [g_quad] at hgen
        rwa [Fin.lastCases_last] at hgen
      refine ⟨?_, ?_⟩
      · intro ht
        have hsum_mem : (∑ k : Fin (m + 1),
            MvPolynomial.X ⟨2 * k.1, by omega⟩ * MvPolynomial.X ⟨2 * k.1 + 1, by omega⟩) ∈ J_top :=
          Ideal.sum_mem J_top fun k _ => J_top.mul_mem_right _ (h_even_mem k)
        have hCt_mem : (MvPolynomial.C t : MvPolynomial (Fin N) K) ∈ J_top := by
          have hsub := J_top.sub_mem hsum_mem h_q_mem
          rwa [h_q_pull, sub_sub_cancel] at hsub
        have h1 : (MvPolynomial.C t : MvPolynomial (Fin N) K) * MvPolynomial.C t⁻¹ = 1 := by
          rw [← map_mul, mul_inv_cancel₀ ht, map_one]
        rw [← h1]
        exact J_top.mul_mem_right _ hCt_mem
      · intro ht0
        let emb_fn : Fin (m + 1) → Fin N := fun r => ⟨2 * r.1 + 1, by omega⟩
        let ψ_fn : Fin N → MvPolynomial (Fin (m + 1)) K := fun i =>
          if i.1 % 2 = 1 then MvPolynomial.X ⟨i.1 / 2, by omega⟩ else 0
        have h_vanish : ∀ x ∈ J_top, MvPolynomial.aeval ψ_fn x = 0 := by
          intro x hx
          have hker : J_top ≤ RingHom.ker (MvPolynomial.aeval ψ_fn).toRingHom := by
            rw [Ideal.span_le]
            rintro _ ⟨ν, rfl⟩
            change MvPolynomial.aeval ψ_fn (θ.symm (g_quad (Fin.last (m + 1)) ν)) = 0
            refine Fin.lastCases ?_ (fun k => ?_) ν
            · dsimp only [g_quad]
              rw [Fin.lastCases_last, h_q_pull, ht0, map_zero, sub_zero, map_sum]
              refine Finset.sum_eq_zero fun k _ => ?_
              rw [map_mul, MvPolynomial.aeval_X]
              have h0 : ψ_fn ⟨2 * k.1, by omega⟩ = 0 := by
                dsimp only [ψ_fn]
                split_ifs with hmod
                · omega
                · rfl
              rw [h0, zero_mul]
            · dsimp only [g_quad]
              rw [Fin.lastCases_castSucc]
              have hk_lt : k.1 < m + 1 := k.isLt
              have heq : θ.symm (τ (u_idx ⟨k.1, hk_lt⟩)) = MvPolynomial.X ⟨2 * k.1, by omega⟩ :=
                hθ_symm_cast ⟨2 * k.1, by omega⟩
              rw [heq, MvPolynomial.aeval_X]
              dsimp only [ψ_fn]
              split_ifs with hmod
              · omega
              · rfl
          exact hker hx
        have h_left : ∀ r : Fin (m + 1), ψ_fn (emb_fn r) = MvPolynomial.X r := by
          intro r
          dsimp [ψ_fn, emb_fn]
          have hmod : (2 * r.1 + 1) % 2 = 1 := by omega
          simp only [hmod, ↓reduceIte]
          congr 1; apply Fin.ext; dsimp; omega
        have h_right : ∀ i : Fin N, MvPolynomial.X i - MvPolynomial.rename emb_fn (ψ_fn i) ∈ J_top := by
          intro i
          by_cases hi : i.1 % 2 = 1
          · have hψ : ψ_fn i = MvPolynomial.X ⟨i.1 / 2, by omega⟩ := by dsimp [ψ_fn]; simp [hi]
            rw [hψ, MvPolynomial.rename_X]
            have hemb : emb_fn ⟨i.1 / 2, by omega⟩ = i := by
              dsimp [emb_fn]; apply Fin.ext; dsimp; omega
            rw [hemb, sub_self]
            exact J_top.zero_mem
          · have hψ : ψ_fn i = 0 := by dsimp [ψ_fn]; simp [hi]
            rw [hψ, map_zero, sub_zero]
            have hi_eq : i = ⟨2 * (i.1 / 2), by omega⟩ := by apply Fin.ext; dsimp; omega
            rw [hi_eq]
            exact h_even_mem ⟨i.1 / 2, by omega⟩
        exact hMvPolyQuotEquiv N (m + 1) J_top emb_fn ψ_fn h_vanish h_left h_right

  
  
  
  have hLinearSubspaceAlg :
      ∀ (A : Type u) [CommRing A] (c : K →+* A) (τ : Fin (m + 1) → A),
        let g_lin : ∀ s : Fin (m + 1), Fin s.1 → A :=
          fun s ν => τ ⟨ν.1, Nat.lt_trans ν.isLt s.isLt⟩
        (∀ s : Fin m,
          Ideal.span (Set.range (g_lin s.succ)) =
            Ideal.span (Set.range (g_lin s.castSucc)) ⊔ Ideal.span {τ s.castSucc}) ∧
        (∀ (s : Fin m) (θ : MvPolynomial (Fin m) K ≃+* A),
          τ s.castSucc = 1 →
          θ.toRingHom.comp MvPolynomial.C = c →
          (∀ i : Fin m, θ (MvPolynomial.X i) = τ (s.castSucc.succAbove i)) →
          let J_s : Ideal (MvPolynomial (Fin m) K) :=
            Ideal.span (Set.range (fun ν : Fin s.castSucc.1 => θ.symm (g_lin s.castSucc ν)))
          ∃ Φ_s : MvPolynomial (Fin (m - s.1)) K ≃+* (MvPolynomial (Fin m) K ⧸ J_s),
            Φ_s.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk J_s).comp MvPolynomial.C) ∧
        (∀ (a : Fin (m + 1)) (θ : MvPolynomial (Fin m) K ≃+* A),
          a ≠ Fin.last m →
          τ a = 1 →
          (1 : MvPolynomial (Fin m) K) ∈
            Ideal.span (Set.range (fun ν : Fin (Fin.last m).1 =>
              θ.symm (g_lin (Fin.last m) ν)))) ∧
        (∀ (θ : MvPolynomial (Fin m) K ≃+* A),
          τ (Fin.last m) = 1 →
          θ.toRingHom.comp MvPolynomial.C = c →
          (∀ i : Fin m, θ (MvPolynomial.X i) = τ ((Fin.last m).succAbove i)) →
          let J_last : Ideal (MvPolynomial (Fin m) K) :=
            Ideal.span (Set.range (fun ν : Fin (Fin.last m).1 =>
              θ.symm (g_lin (Fin.last m) ν)))
          ∃ Φ_last : K ≃+* (MvPolynomial (Fin m) K ⧸ J_last),
            Φ_last.toRingHom = (Ideal.Quotient.mk J_last).comp MvPolynomial.C) := by
    clear * - hMvPolyQuotEquiv
    intro A _ c τ g_lin
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro s
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨μ, rfl⟩
        refine Fin.lastCases ?_ (fun ν => ?_) μ
        · apply Ideal.mem_sup_right
          apply Ideal.subset_span
          rfl
        · apply Ideal.mem_sup_left
          apply Ideal.subset_span
          exact ⟨ν, rfl⟩
      · apply sup_le
        · rw [Ideal.span_le]
          rintro _ ⟨ν, rfl⟩
          apply Ideal.subset_span
          exact ⟨ν.castSucc, rfl⟩
        · rw [Ideal.span_singleton_le_iff_mem]
          apply Ideal.subset_span
          exact ⟨Fin.last s.1, rfl⟩
    · intro s θ _ _ hθ_X J_s
      have hθ_symm_succ : ∀ i : Fin m, θ.symm (τ (s.castSucc.succAbove i)) = MvPolynomial.X i := by
        intro i
        apply θ.injective
        rw [θ.apply_symm_apply, hθ_X i]
      have h_gen_eq : ∀ ν : Fin s.1,
          θ.symm (g_lin s.castSucc ν) = MvPolynomial.X ⟨ν.1, by omega⟩ := by
        intro ν
        let i_ν : Fin m := ⟨ν.1, by omega⟩
        have hlt : i_ν.castSucc < s.castSucc := by change ν.1 < s.1; exact ν.isLt
        have hsucc : s.castSucc.succAbove i_ν = ⟨ν.1, Nat.lt_trans ν.isLt s.castSucc.isLt⟩ := by
          apply Fin.ext
          rw [Fin.succAbove_of_castSucc_lt _ _ hlt]
          rfl
        dsimp [g_lin]
        rw [← hsucc, hθ_symm_succ]
      let emb_fn : Fin (m - s.1) → Fin m := fun r => ⟨s.1 + r.1, by omega⟩
      let ψ_fn : Fin m → MvPolynomial (Fin (m - s.1)) K := fun i =>
        if s.1 ≤ i.1 then MvPolynomial.X ⟨i.1 - s.1, by omega⟩ else 0
      have h_vanish : ∀ x ∈ J_s, MvPolynomial.aeval ψ_fn x = 0 := by
        intro x hx
        have hker : J_s ≤ RingHom.ker (MvPolynomial.aeval ψ_fn).toRingHom := by
          rw [Ideal.span_le]
          rintro _ ⟨ν, rfl⟩
          change MvPolynomial.aeval ψ_fn (θ.symm (g_lin s.castSucc ν)) = 0
          have hν_lt : ν.1 < s.1 := ν.isLt
          rw [h_gen_eq ⟨ν.1, hν_lt⟩, MvPolynomial.aeval_X]
          dsimp only [ψ_fn]
          have hnle : ¬ (s.1 ≤ ν.1) := by omega
          simp [hnle]
        exact hker hx
      have h_left : ∀ r : Fin (m - s.1), ψ_fn (emb_fn r) = MvPolynomial.X r := by
        intro r
        dsimp [ψ_fn, emb_fn]
        have hle : s.1 ≤ s.1 + r.1 := by omega
        simp only [hle, ↓reduceIte]
        congr 1; apply Fin.ext; dsimp; omega
      have h_right : ∀ i : Fin m, MvPolynomial.X i - MvPolynomial.rename emb_fn (ψ_fn i) ∈ J_s := by
        intro i
        by_cases hi : s.1 ≤ i.1
        · have hψ : ψ_fn i = MvPolynomial.X ⟨i.1 - s.1, by omega⟩ := by dsimp [ψ_fn]; simp [hi]
          rw [hψ, MvPolynomial.rename_X]
          have hemb : emb_fn ⟨i.1 - s.1, by omega⟩ = i := by
            dsimp [emb_fn]; apply Fin.ext; dsimp; omega
          rw [hemb, sub_self]
          exact J_s.zero_mem
        · have hψ : ψ_fn i = 0 := by dsimp [ψ_fn]; simp [hi]
          rw [hψ, map_zero, sub_zero]
          let ν : Fin s.1 := ⟨i.1, by omega⟩
          have hi_eq : i = ⟨ν.1, by omega⟩ := rfl
          rw [hi_eq, ← h_gen_eq ν]
          exact Ideal.subset_span ⟨ν, rfl⟩
      exact hMvPolyQuotEquiv m (m - s.1) J_s emb_fn ψ_fn h_vanish h_left h_right
    · intro a θ ha_ne hτ_a
      have ha_lt : a.1 < (Fin.last m).1 := by
        change a.1 < m
        have hne_val : a.1 ≠ m := fun h => ha_ne (Fin.ext h)
        omega
      let ν : Fin (Fin.last m).1 := ⟨a.1, ha_lt⟩
      have hgen : θ.symm (g_lin (Fin.last m) ν) ∈
          Ideal.span (Set.range (fun μ : Fin (Fin.last m).1 => θ.symm (g_lin (Fin.last m) μ))) :=
        Ideal.subset_span ⟨ν, rfl⟩
      have heq : g_lin (Fin.last m) ν = 1 := by
        dsimp [g_lin, ν]
        exact hτ_a
      rwa [heq, map_one] at hgen
    · intro θ _ _ hθ_X J_last
      have h_gen_X : ∀ i : Fin m, θ.symm (g_lin (Fin.last m) i) = MvPolynomial.X i := by
        intro i
        have hlast : (Fin.last m).succAbove i = i.castSucc := congrFun Fin.succAbove_last i
        apply θ.injective
        rw [θ.apply_symm_apply, hθ_X i, hlast]
        rfl
      let α : K →+* (MvPolynomial (Fin m) K ⧸ J_last) :=
        (Ideal.Quotient.mk J_last).comp MvPolynomial.C
      let β₀ : MvPolynomial (Fin m) K →ₐ[K] K := MvPolynomial.aeval (fun _ : Fin m => (0 : K))
      have hβ₀_vanish : ∀ x ∈ J_last, β₀ x = 0 := by
        intro x hx
        have hker : J_last ≤ RingHom.ker β₀.toRingHom := by
          rw [Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          change β₀ (θ.symm (g_lin (Fin.last m) i)) = 0
          rw [h_gen_X i]
          exact MvPolynomial.aeval_X _ i
        exact hker hx
      let β_alg : (MvPolynomial (Fin m) K ⧸ J_last) →ₐ[K] K :=
        Ideal.Quotient.liftₐ J_last β₀ hβ₀_vanish
      have h_left : ∀ k : K, β_alg (α k) = k := by
        intro k
        change β₀ (MvPolynomial.C k) = k
        exact β₀.commutes k
      have h_right : ∀ q : MvPolynomial (Fin m) K ⧸ J_last, α (β_alg q) = q := by
        have h_alg_eq : (Algebra.ofId K (MvPolynomial (Fin m) K ⧸ J_last)).comp β_alg =
            AlgHom.id K _ := by
          apply Ideal.Quotient.algHom_ext
          apply MvPolynomial.algHom_ext
          intro i
          change α (β₀ (MvPolynomial.X i)) = Ideal.Quotient.mk J_last (MvPolynomial.X i)
          have h0 : β₀ (MvPolynomial.X i) = 0 := MvPolynomial.aeval_X _ i
          rw [h0, map_zero]
          symm
          rw [Ideal.Quotient.eq_zero_iff_mem, ← h_gen_X i]
          exact Ideal.subset_span ⟨i, rfl⟩
        intro q
        exact AlgHom.congr_fun h_alg_eq q
      exact ⟨{ toFun := α
               invFun := β_alg
               left_inv := h_left
               right_inv := h_right
               map_mul' := map_mul α
               map_add' := map_add α }, rfl⟩

  
  
  
  let q_K : ∀ a : Fin (N + 1),
      ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a))) :=
    fun a => (∑ j : Fin (m + 1), t_K a (u_idx j) * t_K a (v_idx j)) - c_K a t * (t_K a w_idx) ^ 2
  let g_quad_K : ∀ (a : Fin (N + 1)) (r : Fin (m + 2)), Fin (r.1 + 1) →
      ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a))) :=
    fun a r => Fin.lastCases (q_K a)
      (fun ν => t_K a (u_idx ⟨ν.1, Nat.lt_of_lt_of_le ν.isLt (Nat.le_of_lt_succ r.isLt)⟩))
  let g_Pi_K : ∀ a : Fin (N + 1), Fin (m + 2) →
      ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a))) :=
    fun a ν => Fin.lastCases (t_K a w_idx) (fun j => t_K a (u_idx j)) ν

  have hProp_PN : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K N).hom := hCoord_K.1
  have ht_diag_K : ∀ a : Fin (N + 1), t_K a a = 1 := hCoord_K.2.2.2.2.1
  have hC_ov_K := hCoord_K.2.2.2.2.2.2.2.2.1
  have hT_ov_K := hCoord_K.2.2.2.2.2.2.2.2.2

  have hQuadOv_K : ∀ (r : Fin (m + 2)) (a a' : Fin (N + 1)) (ν : Fin (r.1 + 1)),
      ((weilProjectiveSpaceOver K N).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_right).op).hom (g_quad_K a' r ν) *
      (((weilProjectiveSpaceOver K N).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (t_K a a')) ^
        (Fin.lastCases 2 (fun _ => 1) ν : ℕ) =
      ((weilProjectiveSpaceOver K N).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (g_quad_K a r ν) := by
    intro r a a' ν
    set resL := ((weilProjectiveSpaceOver K N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom
    set resR := ((weilProjectiveSpaceOver K N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_right).op).hom
    refine Fin.lastCases ?_ (fun μ => ?_) ν
    · dsimp [g_quad_K, q_K]
      rw [Fin.lastCases_last, Fin.lastCases_last, Fin.lastCases_last]
      rw [map_sub, map_sum, map_mul, map_pow, map_sub, map_sum, map_mul, map_pow,
        sub_mul, Finset.sum_mul]
      congr 1
      · refine Finset.sum_congr rfl fun j _ => ?_
        calc
          resR (t_K a' (u_idx j) * t_K a' (v_idx j)) * resL (t_K a a') ^ 2 =
              (resR (t_K a' (u_idx j)) * resL (t_K a a')) *
                (resR (t_K a' (v_idx j)) * resL (t_K a a')) := by rw [map_mul]; ring
          _ = resL (t_K a (u_idx j)) * resL (t_K a (v_idx j)) := by
            rw [hT_ov_K a a' (u_idx j), hT_ov_K a a' (v_idx j)]
          _ = resL (t_K a (u_idx j) * t_K a (v_idx j)) := (map_mul _ _ _).symm
      · calc
          resR (c_K a' t) * resR (t_K a' w_idx) ^ 2 * resL (t_K a a') ^ 2 =
              resR (c_K a' t) * (resR (t_K a' w_idx) * resL (t_K a a')) ^ 2 := by ring
          _ = resL (c_K a t) * resL (t_K a w_idx) ^ 2 := by
            rw [hC_ov_K a a' t, hT_ov_K a a' w_idx]
    · dsimp [g_quad_K]
      rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc, Fin.lastCases_castSucc, pow_one]
      exact hT_ov_K a a' _

  
  have hSubMid : ∀ j : Fin (m + 1),
      ∃ D : PresDatum N,
        D.2.2.1 = j.succ.1 + 1 ∧
        (∀ a : Fin (N + 1),
          chartIdeal N D a = Ideal.span (Set.range (g_quad_K a j.succ)) ∧
          polyIdeal N θ_K D a =
            Ideal.span (Set.range (fun ν : Fin (j.succ.1 + 1) =>
              (θ_K a).symm (g_quad_K a j.succ ν)))) ∧
        IsValidPresDatum N hAff_K D := by
    intro j
    obtain ⟨W_j, ι_j, hCl_j, hPres_j⟩ :=
      hSubEx_K N hAff_K c_K t_K hCoord_K (j.succ.1 + 1)
        (Fin.lastCases 2 (fun _ => 1)) (fun a => g_quad_K a j.succ) (hQuadOv_K j.succ)
    exact ⟨⟨W_j, ι_j, j.succ.1 + 1, fun a => g_quad_K a j.succ⟩, rfl,
      fun _ => ⟨rfl, rfl⟩, ⟨hCl_j, hPres_j⟩⟩

  let D_Qt : PresDatum N := ⟨Q_t, ι_Qt, 1, fun a _ => q_K a⟩
  have hValid_Qt : IsValidPresDatum N hAff_K D_Qt := ⟨inferInstance, hPres_Qt⟩

  let D_Pi : PresDatum N := ⟨(weilProjectiveSpaceOver K m).left, ι_Pi_amb_K, m + 2, g_Pi_K⟩
  have hValid_Pi : IsValidPresDatum N hAff_K D_Pi := ⟨inferInstance, hPres_PiK⟩

  let D_mid : Fin (m + 1) → PresDatum N := fun j => Classical.choose (hSubMid j)
  have hD_mid_spec : ∀ j : Fin (m + 1),
      (∀ a : Fin (N + 1),
        chartIdeal N (D_mid j) a = Ideal.span (Set.range (g_quad_K a j.succ)) ∧
        polyIdeal N θ_K (D_mid j) a =
          Ideal.span (Set.range (fun ν : Fin (j.succ.1 + 1) =>
            (θ_K a).symm (g_quad_K a j.succ ν)))) ∧
      IsValidPresDatum N hAff_K (D_mid j) :=
    fun j => (Classical.choose_spec (hSubMid j)).2

  let D_A : Fin (m + 3) → PresDatum N :=
    Fin.lastCases D_Pi (Fin.cases D_Qt D_mid)

  have hDA_last : D_A (Fin.last (m + 2)) = D_Pi := Fin.lastCases_last
  have hDA_cast : ∀ r : Fin (m + 2), D_A r.castSucc = Fin.cases D_Qt D_mid r :=
    fun r => Fin.lastCases_castSucc r
  have hDA_0 : D_A 0 = D_Qt := by
    have h0 : (0 : Fin (m + 3)) = (0 : Fin (m + 2)).castSucc := rfl
    rw [h0, hDA_cast, Fin.cases_zero]

  have hValid_A : ∀ s : Fin (m + 3), IsValidPresDatum N hAff_K (D_A s) := by
    intro s
    refine Fin.lastCases ?_ (fun r => ?_) s
    · rw [hDA_last]; exact hValid_Pi
    · rw [hDA_cast]
      refine Fin.cases ?_ (fun j => ?_) r
      · rw [Fin.cases_zero]; exact hValid_Qt
      · rw [Fin.cases_succ]; exact (hD_mid_spec j).2

  have hDA_quad_ideals : ∀ (r : Fin (m + 2)) (a : Fin (N + 1)),
      chartIdeal N (D_A r.castSucc) a = Ideal.span (Set.range (g_quad_K a r)) ∧
      polyIdeal N θ_K (D_A r.castSucc) a =
        Ideal.span (Set.range (fun ν : Fin (r.1 + 1) => (θ_K a).symm (g_quad_K a r ν))) := by
    intro r a
    rw [hDA_cast]
    refine Fin.cases ?_ (fun j => ?_) r
    · rw [Fin.cases_zero]
      dsimp only [D_Qt, chartIdeal, polyIdeal]
      have h1 : Set.range (fun _ : Fin 1 => q_K a) = Set.range (g_quad_K a 0) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨_, rfl⟩
          exact ⟨Fin.last (0 : Fin (m + 2)).1, by dsimp only [g_quad_K]; rw [Fin.lastCases_last]⟩
        · rintro ⟨ν, rfl⟩
          refine Fin.lastCases ?_ (fun μ => ?_) ν
          · dsimp only [g_quad_K]; rw [Fin.lastCases_last]; exact ⟨0, rfl⟩
          · exfalso
            have h0 : (0 : Fin (m + 2)).1 = 0 := by simp
            have hμ : μ.1 < (0 : Fin (m + 2)).1 := μ.isLt
            omega
      have h2 : Set.range (fun _ : Fin 1 => (θ_K a).symm (q_K a)) =
          Set.range (fun ν : Fin ((0 : Fin (m + 2)).1 + 1) =>
            (θ_K a).symm (g_quad_K a 0 ν)) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨_, rfl⟩
          exact ⟨Fin.last (0 : Fin (m + 2)).1, by dsimp only [g_quad_K]; rw [Fin.lastCases_last]⟩
        · rintro ⟨ν, rfl⟩
          refine Fin.lastCases ?_ (fun μ => ?_) ν
          · dsimp only [g_quad_K]; rw [Fin.lastCases_last]; exact ⟨0, rfl⟩
          · exfalso
            have h0 : (0 : Fin (m + 2)).1 = 0 := by simp
            have hμ : μ.1 < (0 : Fin (m + 2)).1 := μ.isLt
            omega
      rw [h1, h2]
      exact ⟨rfl, rfl⟩
    · rw [Fin.cases_succ]; exact (hD_mid_spec j).1 a

  let c_A : Fin (m + 2) → Fin (N + 1) := Fin.lastCases w_idx (fun j => u_idx j)

  have hStepIdeal_A : ∀ (s : Fin (m + 2)) (a : Fin (N + 1)),
      chartIdeal N (D_A s.succ) a =
        chartIdeal N (D_A s.castSucc) a ⊔ Ideal.span {t_K a (c_A s)} := by
    intro s a
    obtain ⟨hStep_j, hStep_last, _, _⟩ := hSplitQuadricAlg _ (c_K a) (t_K a)
    refine Fin.lastCases ?_ (fun j => ?_) s
    · have hsucc_last : (Fin.last (m + 1)).succ = Fin.last (m + 2) := Fin.succ_last (m + 1)
      rw [hsucc_last, hDA_last, (hDA_quad_ideals (Fin.last (m + 1)) a).1]
      dsimp [c_A]
      rw [Fin.lastCases_last]
      exact hStep_last
    · have hsucc_cast : (j.castSucc).succ = (j.succ).castSucc := Fin.ext rfl
      rw [hsucc_cast, (hDA_quad_ideals j.succ a).1, (hDA_quad_ideals j.castSucc a).1]
      dsimp [c_A]
      rw [Fin.lastCases_castSucc]
      exact hStep_j j

  have hStepIncl_A : ∀ s : Fin (m + 2),
      ∃ j_s : (D_A s.succ).1 ⟶ (D_A s.castSucc).1,
        AlgebraicGeometry.IsClosedImmersion j_s ∧
        j_s ≫ (D_A s.castSucc).2.1 = (D_A s.succ).2.1 := by
    intro s
    have : AlgebraicGeometry.IsClosedImmersion (D_A s.castSucc).2.1 := (hValid_A s.castSucc).1
    have : AlgebraicGeometry.IsClosedImmersion (D_A s.succ).2.1 := (hValid_A s.succ).1
    exact hSubIncl_K N hAff_K c_K t_K hCoord_K
      (D_A s.castSucc).1 (D_A s.castSucc).2.1 (D_A s.castSucc).2.2.1 (D_A s.castSucc).2.2.2
      (D_A s.succ).1 (D_A s.succ).2.1 (D_A s.succ).2.2.1 (D_A s.succ).2.2.2
      (hValid_A s.castSucc).2 (hValid_A s.succ).2
      (fun a => by change chartIdeal N (D_A s.castSucc) a ≤ chartIdeal N (D_A s.succ) a; rw [hStepIdeal_A s a]; exact le_sup_left)

  let Z : Fin (m + 3) → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    fun s => CategoryTheory.Over.mk ((D_A s).2.1 ≫ (weilProjectiveSpaceOver K N).hom)
  let j_A : ∀ s : Fin (m + 2), (Z s.succ).left ⟶ (Z s.castSucc).left :=
    fun s => Classical.choose (hStepIncl_A s)
  have hj_A_spec : ∀ s : Fin (m + 2),
      AlgebraicGeometry.IsClosedImmersion (j_A s) ∧
      j_A s ≫ (D_A s.castSucc).2.1 = (D_A s.succ).2.1 :=
    fun s => Classical.choose_spec (hStepIncl_A s)
  let ι_step : ∀ s : Fin (m + 2), Z s.succ ⟶ Z s.castSucc :=
    fun s => CategoryTheory.Over.homMk (j_A s) (by
      change j_A s ≫ ((D_A s.castSucc).2.1 ≫ (weilProjectiveSpaceOver K N).hom) =
        (D_A s.succ).2.1 ≫ (weilProjectiveSpaceOver K N).hom
      rw [← CategoryTheory.Category.assoc, (hj_A_spec s).2])
  let U_step : ∀ s : Fin (m + 2), (Z s.castSucc).left.Opens :=
    fun s => (TopologicalSpace.Opens.map (D_A s.castSucc).2.1.base).obj
      (weilProjBasicOpen K N (c_A s))

  have hDatumIso : ∀ {D₁ D₂ : PresDatum N},
      D₁ = D₂ → ∃ e : D₁.1 ≅ D₂.1, e.hom ≫ D₂.2.1 = D₁.2.1 := by
    rintro D _ rfl
    exact ⟨CategoryTheory.Iso.refl D.1, CategoryTheory.Category.id_comp D.2.1⟩

  obtain ⟨e_Z0, he_Z0⟩ := hDatumIso hDA_0
  obtain ⟨e_bot, he_bot⟩ := hDatumIso hDA_last.symm

  let ι_tot : ∀ s : Fin (m + 3), (Z s).left ⟶ Q_t :=
    Fin.induction e_Z0.hom (fun s ih => (ι_step s).left ≫ ih)

  have hι_tot_zero : ι_tot 0 = e_Z0.hom :=
    Fin.induction_zero (motive := fun s => (Z s).left ⟶ Q_t)
      e_Z0.hom (fun s ih => (ι_step s).left ≫ ih)

  have hTot_amb_A : ∀ s : Fin (m + 3), ι_tot s ≫ ι_Qt = (D_A s).2.1 := by
    intro s
    refine Fin.induction ?_ (fun r ih => ?_) s
    · rw [hι_tot_zero]
      exact he_Z0
    · dsimp only [ι_tot] at ih ⊢
      rw [Fin.induction_succ, CategoryTheory.Category.assoc, ih]
      exact (hj_A_spec r).2

  
  let g_lin_Pm : ∀ (a : Fin (m + 1)) (s : Fin (m + 1)), Fin s.1 →
      ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K m a))) :=
    fun a s ν => t_Pm a ⟨ν.1, Nat.lt_trans ν.isLt s.isLt⟩

  have hProp_Pm : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K m).hom := hCoord_Pm.1
  have ht_diag_Pm : ∀ a : Fin (m + 1), t_Pm a a = 1 := hCoord_Pm.2.2.2.2.1
  have hT_ov_Pm := hCoord_Pm.2.2.2.2.2.2.2.2.2

  have hLinOv_Pm : ∀ (r : Fin m) (a a' : Fin (m + 1)) (ν : Fin r.succ.1),
      ((weilProjectiveSpaceOver K m).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_right).op).hom (g_lin_Pm a' r.succ ν) *
      (((weilProjectiveSpaceOver K m).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (t_Pm a a')) ^ 1 =
      ((weilProjectiveSpaceOver K m).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (g_lin_Pm a r.succ ν) := by
    intro r a a' ν
    rw [pow_one]
    exact hT_ov_Pm a a' _

  have hSubLin : ∀ r : Fin m,
      ∃ D : PresDatum m,
        (∀ a : Fin (m + 1),
          chartIdeal m D a = Ideal.span (Set.range (g_lin_Pm a r.succ)) ∧
          polyIdeal m θ_Pm D a =
            Ideal.span (Set.range (fun ν : Fin r.succ.1 =>
              (θ_Pm a).symm (g_lin_Pm a r.succ ν)))) ∧
        IsValidPresDatum m hAff_Pm D := by
    intro r
    obtain ⟨W_r, κ_r, hCl_r, hPres_r⟩ :=
      hSubEx_K m hAff_Pm c_Pm t_Pm hCoord_Pm r.succ.1 (fun _ => 1)
        (fun a => g_lin_Pm a r.succ) (hLinOv_Pm r)
    exact ⟨⟨W_r, κ_r, r.succ.1, fun a => g_lin_Pm a r.succ⟩,
      fun _ => ⟨rfl, rfl⟩, ⟨hCl_r, hPres_r⟩⟩

  let D_B0 : PresDatum m :=
    ⟨(weilProjectiveSpaceOver K m).left, 𝟙 (weilProjectiveSpaceOver K m).left, 0, fun _ => Fin.elim0⟩
  let D_Bpos : Fin m → PresDatum m := fun r => Classical.choose (hSubLin r)
  have hD_Bpos_spec : ∀ r : Fin m,
      (∀ a : Fin (m + 1),
        chartIdeal m (D_Bpos r) a = Ideal.span (Set.range (g_lin_Pm a r.succ)) ∧
        polyIdeal m θ_Pm (D_Bpos r) a =
          Ideal.span (Set.range (fun ν : Fin r.succ.1 =>
            (θ_Pm a).symm (g_lin_Pm a r.succ ν)))) ∧
      IsValidPresDatum m hAff_Pm (D_Bpos r) :=
    fun r => Classical.choose_spec (hSubLin r)

  let D_B : Fin (m + 1) → PresDatum m := Fin.cases D_B0 D_Bpos

  have hValid_B : ∀ s : Fin (m + 1), IsValidPresDatum m hAff_Pm (D_B s) := by
    intro s
    refine Fin.cases ?_ (fun r => ?_) s
    · exact hIdPresDatum m hAff_Pm
    · exact (hD_Bpos_spec r).2

  have hDB_ideals : ∀ (s : Fin (m + 1)) (a : Fin (m + 1)),
      chartIdeal m (D_B s) a = Ideal.span (Set.range (g_lin_Pm a s)) ∧
      polyIdeal m θ_Pm (D_B s) a =
        Ideal.span (Set.range (fun ν : Fin s.1 => (θ_Pm a).symm (g_lin_Pm a s ν))) := by
    intro s a
    refine Fin.cases ?_ (fun r => ?_) s
    · dsimp only [D_B]
      rw [Fin.cases_zero]
      dsimp only [D_B0, chartIdeal, polyIdeal]
      have h1 : Set.range (Fin.elim0 : Fin 0 → _) =
          Set.range (g_lin_Pm a 0) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨ν, _⟩; exact Fin.elim0 ν
        · rintro ⟨ν, _⟩
          exfalso
          have h0 : (0 : Fin (m + 1)).1 = 0 := by simp
          have hν : ν.1 < (0 : Fin (m + 1)).1 := ν.isLt
          omega
      have h2 : Set.range (fun ν : Fin 0 => (θ_Pm a).symm (Fin.elim0 ν)) =
          Set.range (fun ν : Fin (0 : Fin (m + 1)).1 => (θ_Pm a).symm (g_lin_Pm a 0 ν)) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨ν, _⟩; exact Fin.elim0 ν
        · rintro ⟨ν, _⟩
          exfalso
          have h0 : (0 : Fin (m + 1)).1 = 0 := by simp
          have hν : ν.1 < (0 : Fin (m + 1)).1 := ν.isLt
          omega
      rw [h1, h2]
      exact ⟨rfl, rfl⟩
    · exact (hD_Bpos_spec r).1 a

  have hStepIdeal_B : ∀ (s : Fin m) (a : Fin (m + 1)),
      chartIdeal m (D_B s.succ) a =
        chartIdeal m (D_B s.castSucc) a ⊔ Ideal.span {t_Pm a s.castSucc} := by
    intro s a
    rw [(hDB_ideals s.succ a).1, (hDB_ideals s.castSucc a).1]
    exact (hLinearSubspaceAlg _ (c_Pm a) (t_Pm a)).1 s

  have hStepIncl_B : ∀ s : Fin m,
      ∃ j_s : (D_B s.succ).1 ⟶ (D_B s.castSucc).1,
        AlgebraicGeometry.IsClosedImmersion j_s ∧
        j_s ≫ (D_B s.castSucc).2.1 = (D_B s.succ).2.1 := by
    intro s
    have : AlgebraicGeometry.IsClosedImmersion (D_B s.castSucc).2.1 := (hValid_B s.castSucc).1
    have : AlgebraicGeometry.IsClosedImmersion (D_B s.succ).2.1 := (hValid_B s.succ).1
    exact hSubIncl_K m hAff_Pm c_Pm t_Pm hCoord_Pm
      (D_B s.castSucc).1 (D_B s.castSucc).2.1 (D_B s.castSucc).2.2.1 (D_B s.castSucc).2.2.2
      (D_B s.succ).1 (D_B s.succ).2.1 (D_B s.succ).2.2.1 (D_B s.succ).2.2.2
      (hValid_B s.castSucc).2 (hValid_B s.succ).2
      (fun a => by change chartIdeal m (D_B s.castSucc) a ≤ chartIdeal m (D_B s.succ) a; rw [hStepIdeal_B s a]; exact le_sup_left)

  let P_step : Fin (m + 1) → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    fun s => CategoryTheory.Over.mk ((D_B s).2.1 ≫ (weilProjectiveSpaceOver K m).hom)
  let j_B : ∀ s : Fin m, (P_step s.succ).left ⟶ (P_step s.castSucc).left :=
    fun s => Classical.choose (hStepIncl_B s)
  have hj_B_spec : ∀ s : Fin m,
      AlgebraicGeometry.IsClosedImmersion (j_B s) ∧
      j_B s ≫ (D_B s.castSucc).2.1 = (D_B s.succ).2.1 :=
    fun s => Classical.choose_spec (hStepIncl_B s)
  let κ_step : ∀ s : Fin m, P_step s.succ ⟶ P_step s.castSucc :=
    fun s => CategoryTheory.Over.homMk (j_B s) (by
      change j_B s ≫ ((D_B s.castSucc).2.1 ≫ (weilProjectiveSpaceOver K m).hom) =
        (D_B s.succ).2.1 ≫ (weilProjectiveSpaceOver K m).hom
      rw [← CategoryTheory.Category.assoc, (hj_B_spec s).2])
  let V_step : ∀ s : Fin m, (P_step s.castSucc).left.Opens :=
    fun s => (TopologicalSpace.Opens.map (D_B s.castSucc).2.1.base).obj
      (weilProjBasicOpen K m s.castSucc)
  let κ_tot : ∀ s : Fin (m + 1), (P_step s).left ⟶ (weilProjectiveSpaceOver K m).left :=
    fun s => (D_B s).2.1

  
  refine ⟨⟨Z, ι_step, U_step, ι_tot, e_bot, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
          ⟨P_step, κ_step, V_step, κ_tot, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩⟩
  · intro s
    have : AlgebraicGeometry.IsClosedImmersion (D_A s).2.1 := (hValid_A s).1
    change AlgebraicGeometry.IsProper ((D_A s).2.1 ≫ (weilProjectiveSpaceOver K N).hom)
    infer_instance
  · intro s
    exact (hj_A_spec s).1
  · intro s
    exact hComplBridge N hAff_K c_K t_K hCoord_K (D_A s.castSucc) (D_A s.succ)
      (hValid_A s.castSucc) (hValid_A s.succ) (j_A s) (hj_A_spec s).2 (c_A s) (hStepIdeal_A s)
  · intro s
    refine Fin.lastCases ?_ (fun j => ?_) s
    · 
      have hcA : c_A (Fin.last (m + 1)) = w_idx := Fin.lastCases_last
      have hBridge := hChartPolyBridge N hAff_K c_K t_K θ_K hCoord_K hθ_K
        (D_A (Fin.last (m + 1)).castSucc) (hValid_A _) (c_A (Fin.last (m + 1)))
      have hPolyEq : polyIdeal N θ_K (D_A (Fin.last (m + 1)).castSucc) (c_A (Fin.last (m + 1))) =
          Ideal.span (Set.range (fun ν : Fin ((Fin.last (m + 1)).1 + 1) =>
            (θ_K w_idx).symm (g_quad_K w_idx (Fin.last (m + 1)) ν))) := by
        rw [hcA]
        exact (hDA_quad_ideals (Fin.last (m + 1)) w_idx).2
      obtain ⟨_, _, _, hTopAlg⟩ := hSplitQuadricAlg _ (c_K w_idx) (t_K w_idx)
      obtain ⟨hTopNe, hTopZero⟩ :=
        hTopAlg (θ_K w_idx) (ht_diag_K w_idx) (hθ_K w_idx).1 (hθ_K w_idx).2
      by_cases ht : t = 0
      · right
        obtain ⟨Φ_top, hΦ_top⟩ := hTopZero ht
        let Φ' : MvPolynomial (Fin (m + 1)) K ≃+*
            (MvPolynomial (Fin N) K ⧸
              polyIdeal N θ_K (D_A (Fin.last (m + 1)).castSucc) (c_A (Fin.last (m + 1)))) :=
          Φ_top.trans (Ideal.quotEquivOfEq hPolyEq.symm)
        have hΦ'_C : Φ'.toRingHom.comp MvPolynomial.C =
            (Ideal.Quotient.mk _).comp MvPolynomial.C := by
          ext k
          simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
            RingHom.coe_coe, Φ', RingEquiv.trans_apply]
          have h1 := RingHom.congr_fun hΦ_top k
          simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
            RingHom.coe_coe] at h1
          rw [h1, Ideal.quotEquivOfEq_mk]
        obtain ⟨e_U, he_U⟩ := hBridge.2.1 (m + 1) Φ' hΦ'_C
        exact ⟨m + 1, e_U, le_refl _, he_U⟩
      · left
        apply hBridge.1
        rw [hPolyEq]
        exact hTopNe ht
    · 
      have hcA : c_A j.castSucc = u_idx j := Fin.lastCases_castSucc j
      have hBridge := hChartPolyBridge N hAff_K c_K t_K θ_K hCoord_K hθ_K
        (D_A j.castSucc.castSucc) (hValid_A _) (c_A j.castSucc)
      have hPolyEq : polyIdeal N θ_K (D_A j.castSucc.castSucc) (c_A j.castSucc) =
          Ideal.span (Set.range (fun ν : Fin (j.castSucc.1 + 1) =>
            (θ_K (u_idx j)).symm (g_quad_K (u_idx j) j.castSucc ν))) := by
        rw [hcA]
        exact (hDA_quad_ideals j.castSucc (u_idx j)).2
      obtain ⟨_, _, hMidAlg, _⟩ := hSplitQuadricAlg _ (c_K (u_idx j)) (t_K (u_idx j))
      obtain ⟨hm_le, Φ_j, hΦ_j⟩ :=
        hMidAlg j (θ_K (u_idx j)) (ht_diag_K (u_idx j)) (hθ_K (u_idx j)).1 (hθ_K (u_idx j)).2
      right
      let Φ' : MvPolynomial (Fin (2 * m + 1 - j.1)) K ≃+*
          (MvPolynomial (Fin N) K ⧸
            polyIdeal N θ_K (D_A j.castSucc.castSucc) (c_A j.castSucc)) :=
        Φ_j.trans (Ideal.quotEquivOfEq hPolyEq.symm)
      have hΦ'_C : Φ'.toRingHom.comp MvPolynomial.C =
          (Ideal.Quotient.mk _).comp MvPolynomial.C := by
        ext k
        simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, Φ', RingEquiv.trans_apply]
        have h1 := RingHom.congr_fun hΦ_j k
        simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe] at h1
        rw [h1, Ideal.quotEquivOfEq_mk]
      obtain ⟨e_U, he_U⟩ := hBridge.2.1 (2 * m + 1 - j.1) Φ' hΦ'_C
      exact ⟨2 * m + 1 - j.1, e_U, hm_le, he_U⟩
  · rw [hι_tot_zero]
    infer_instance
  · intro s
    dsimp only [ι_tot]
    rw [Fin.induction_succ]
  · rw [CategoryTheory.Category.assoc, hTot_amb_A (Fin.last (m + 2))]
    exact he_bot
  · intro s
    have : AlgebraicGeometry.IsClosedImmersion (D_B s).2.1 := (hValid_B s).1
    change AlgebraicGeometry.IsProper ((D_B s).2.1 ≫ (weilProjectiveSpaceOver K m).hom)
    infer_instance
  · intro s
    exact (hj_B_spec s).1
  · have hBridge := hChartPolyBridge m hAff_Pm c_Pm t_Pm θ_Pm hCoord_Pm hθ_Pm
      (D_B (Fin.last m)) (hValid_B (Fin.last m)) (Fin.last m)
    obtain ⟨Φ_last, hΦ_last⟩ :=
      (hLinearSubspaceAlg _ (c_Pm (Fin.last m)) (t_Pm (Fin.last m))).2.2.2
        (θ_Pm (Fin.last m)) (ht_diag_Pm (Fin.last m))
        (hθ_Pm (Fin.last m)).1 (hθ_Pm (Fin.last m)).2
    have hPolyEq := (hDB_ideals (Fin.last m) (Fin.last m)).2
    let Φ₀ : K ≃+* (MvPolynomial (Fin m) K ⧸ polyIdeal m θ_Pm (D_B (Fin.last m)) (Fin.last m)) :=
      Φ_last.trans (Ideal.quotEquivOfEq hPolyEq.symm)
    have hΦ₀_C : Φ₀.toRingHom = (Ideal.Quotient.mk _).comp MvPolynomial.C := by
      ext k
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe, Φ₀, RingEquiv.trans_apply]
      have h1 := RingHom.congr_fun hΦ_last k
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe] at h1
      rw [h1, Ideal.quotEquivOfEq_mk]
    refine hBridge.2.2 ?_ Φ₀ hΦ₀_C
    intro a ha_ne
    rw [(hDB_ideals (Fin.last m) a).2]
    exact (hLinearSubspaceAlg _ (c_Pm a) (t_Pm a)).2.2.1 a (θ_Pm a) ha_ne (ht_diag_Pm a)
  · intro s
    exact hComplBridge m hAff_Pm c_Pm t_Pm hCoord_Pm (D_B s.castSucc) (D_B s.succ)
      (hValid_B s.castSucc) (hValid_B s.succ) (j_B s) (hj_B_spec s).2 s.castSucc (hStepIdeal_B s)
  · intro s
    have hBridge := hChartPolyBridge m hAff_Pm c_Pm t_Pm θ_Pm hCoord_Pm hθ_Pm
      (D_B s.castSucc) (hValid_B s.castSucc) s.castSucc
    have hPolyEq := (hDB_ideals s.castSucc s.castSucc).2
    obtain ⟨Φ_s, hΦ_s⟩ :=
      (hLinearSubspaceAlg _ (c_Pm s.castSucc) (t_Pm s.castSucc)).2.1 s (θ_Pm s.castSucc)
        (ht_diag_Pm s.castSucc) (hθ_Pm s.castSucc).1 (hθ_Pm s.castSucc).2
    let Φ' : MvPolynomial (Fin (m - s.1)) K ≃+*
        (MvPolynomial (Fin m) K ⧸ polyIdeal m θ_Pm (D_B s.castSucc) s.castSucc) :=
      Φ_s.trans (Ideal.quotEquivOfEq hPolyEq.symm)
    have hΦ'_C : Φ'.toRingHom.comp MvPolynomial.C =
        (Ideal.Quotient.mk _).comp MvPolynomial.C := by
      ext k
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe, Φ', RingEquiv.trans_apply]
      have h1 := RingHom.congr_fun hΦ_s k
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe] at h1
      rw [h1, Ideal.quotEquivOfEq_mk]
    obtain ⟨e_V, he_V⟩ := hBridge.2.1 (m - s.1) Φ' hΦ'_C
    exact ⟨m - s.1, e_V, he_V⟩
  · change CategoryTheory.IsIso (𝟙 (weilProjectiveSpaceOver K m).left)
    infer_instance
  · intro s
    exact ((hj_B_spec s).2).symm

theorem weil_proj_quadric_paving_closed_compl_excision_step (K : Type u) [Field K] [IsAlgClosed K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds K ℓ)
    (Y Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (ι : Z ⟶ Y)
    [AlgebraicGeometry.IsClosedImmersion ι.left]
    (U : Y.left.Opens)
    (hCompl : Set.range ι.left.base = (U : Set ↥Y.left)ᶜ)
    (i : ℕ)
    (p_ι : weilEtaleTorsionH Y.left ℓ i →+ weilEtaleTorsionH Z.left ℓ i)
    (hp : WeilIsTorsionEtalePullback ι.left ℓ i p_ι) :
    let U_et : Y.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι (inferInstance : AlgebraicGeometry.Etale U.ι)
    (IsEmpty ↥U → ∀ r : ℕ, Subsingleton (weilEtaleLocalTorsionH Y.left ℓ U_et r)) ∧
    (Subsingleton (weilEtaleLocalTorsionH Y.left ℓ U_et i) → Function.Injective p_ι) ∧
    (Subsingleton (weilEtaleLocalTorsionH Y.left ℓ U_et i) →
      Subsingleton (weilEtaleLocalTorsionH Y.left ℓ U_et (i + 1)) →
      Finite (weilEtaleTorsionH Z.left ℓ i) →
      Function.Bijective p_ι) :=
by
  let _ := hℓ
  intro U_et
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

  
  have hExtZero :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞]
        [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        (X G : 𝒞) (r : ℕ),
        CategoryTheory.Limits.IsZero G →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X G r) := by
    intro 𝒞 _ _ _ X G r hG
    have hid : 𝟙 G = 0 := (CategoryTheory.Limits.IsZero.iff_id_eq_zero G).mp hG
    have hzero : ∀ x : CategoryTheory.Abelian.Ext.{u} X G r, x = 0 := by
      intro x
      calc
        x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 G)) (Nat.add_zero r) :=
            (x.comp_mk₀_id).symm
        _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : G ⟶ G)) (Nat.add_zero r) := by
            rw [hid]
        _ = 0 := by
            rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    exact ⟨fun a b => (hzero a).trans (hzero b).symm⟩

  have hExtIso :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞]
        [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        (X G₁ G₂ : 𝒞) (_e : G₁ ≅ G₂) (r : ℕ),
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X G₂ r) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X G₁ r) := by
    intro 𝒞 _ _ _ X G₁ G₂ e r hSub
    refine ⟨fun a b => ?_⟩
    have hEq : a.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero r) =
        b.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero r) :=
      hSub.elim _ _
    have hLeft : ∀ x : CategoryTheory.Abelian.Ext.{u} X G₁ r,
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero r)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero r) = x := by
      intro x
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        e.hom_inv_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    calc
      a = (a.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero r)).comp
            (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero r) := (hLeft a).symm
      _ = (b.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero r)).comp
            (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero r) := by rw [hEq]
      _ = b := hLeft b

  
  have hCoyonedaSheafIso :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        {J : CategoryTheory.GrothendieckTopology C}
        (X₁ X₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (V₁ V₂ : C) (e_V : V₁ ≅ V₂)
        (e₁ : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
          (X₁ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op V₁)))
        (e₂ : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
          (X₂ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op V₂))),
        (∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (α : X₁ ⟶ F) (g : F ⟶ G),
          e₁ G (α ≫ g) = e₁ F α ≫ g.hom.app (Opposite.op V₁)) →
        (∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (β : X₂ ⟶ F) (g : F ⟶ G),
          e₂ G (β ≫ g) = e₂ F β ≫ g.hom.app (Opposite.op V₂)) →
