          rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc, ← F.obj.map_comp,
            ← CategoryTheory.op_comp, e_V.hom_inv_id, CategoryTheory.op_id,
            F.obj.map_id, CategoryTheory.Category.comp_id, Equiv.symm_apply_apply])
        (fun {F} β => by
          rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc, ← F.obj.map_comp,
            ← CategoryTheory.op_comp, e_V.inv_hom_id, CategoryTheory.op_id,
            F.obj.map_id, CategoryTheory.Category.comp_id, Equiv.symm_apply_apply])
        (fun {F G} β g => by
          apply (e₁ G).injective
          rw [Equiv.apply_symm_apply, he₁_nat, Equiv.apply_symm_apply,
            he₂_nat β g, CategoryTheory.Category.assoc,
            ← g.hom.naturality e_V.hom.op, ← CategoryTheory.Category.assoc])⟩

  have hShriekConstNat :
      ∀ {C₁ : Type (u + 1)} [CategoryTheory.Category.{u} C₁]
        {C₂ : Type (u + 1)} [CategoryTheory.Category.{u} C₂]
        (J₁ : CategoryTheory.GrothendieckTopology C₁)
