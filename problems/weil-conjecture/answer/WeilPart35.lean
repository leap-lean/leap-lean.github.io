                        change ((Φ₂.skyscraperPresheafFunctor.obj M).map f) ≫ _ =
                          _ ≫ ((Φ₁.skyscraperPresheafFunctor.obj M).map (B.map f.unop).op)
                        rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                          CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                        exact hPi_map'
                          (Φ₂.fiber.map f.unop)
                          (Φ₁.fiber.map (B.map f.unop))
                          (α j₁.unop)
                          (α j₂.unop)
                          (fun t => hα_fwd f.unop t) M } }
              hom_inv_id := by
                apply CategoryTheory.Sheaf.hom_ext
                ext j : 2
                exact hPi_id (fun t => α j.unop t) (fun s => (α j.unop).symm s)
                  (fun t => (α j.unop).symm_apply_apply t) M
              inv_hom_id := by
                apply CategoryTheory.Sheaf.hom_ext
                ext j : 2
                exact hPi_id (fun s => (α j.unop).symm s) (fun t => α j.unop t)
                  (fun s => (α j.unop).apply_symm_apply s) M })
          (fun {M₁ M₂} φ => by
            apply CategoryTheory.Sheaf.hom_ext
            ext j : 2
            change ((Φ₁.skyscraperPresheafFunctor.map φ).app (Opposite.op (B.obj j.unop))) ≫ _ =
              _ ≫ ((Φ₂.skyscraperPresheafFunctor.map φ).app j)
            rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app,
              CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app]
            exact hPi_map (fun s => (α j.unop).symm s) φ)
      let adj_comp := (adj.comp (Φ₁.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))).ofNatIsoRight e_sky
      exact ⟨adj_comp.leftAdjointUniq (Φ₂.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))⟩

    have hConserv : ∀ (W : AlgebraicGeometry.Scheme.{u})
        (H : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (x : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
          CategoryTheory.Limits.IsZero ((ptOf W Ω x).sheafFiber.obj H)) →
        CategoryTheory.Limits.IsZero H := by
      intro W H hAllZero
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.Sheaf.hom_ext
      ext E_op s
      let E : W.Etale := E_op.unop
      change (s : ↥(H.obj.obj (Opposite.op E))) = 0
      let R_s : CategoryTheory.Sieve E :=
        { arrows := fun _ u => (H.obj.map u.op) s = 0
          downward_closed := fun {Y Z} u hu v => by
            rw [op_comp, H.obj.map_comp]
            change (H.obj.map v.op) ((H.obj.map u.op) s) = 0
            rw [hu, map_zero] }
      have hRs : R_s ∈ W.smallEtaleTopology E := by
        refine (hMemEtale W E R_s).mpr fun z => ?_
        let Ω_z : Type u := AlgebraicClosure ↥(E.left.residueField z)
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω_z)
        let z_E : S_Ω ⟶ E.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(E.left.residueField z) Ω_z)) ≫
            E.left.fromSpecResidueField z
        have hz_E_pt : z_E.base (⊥ : PrimeSpectrum Ω_z) = z := by
          have hmem : z_E.base (⊥ : PrimeSpectrum Ω_z) ∈
              Set.range (E.left.fromSpecResidueField z).base :=
            ⟨(AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥(E.left.residueField z) Ω_z))).base (⊥ : PrimeSpectrum Ω_z),
              rfl⟩
          rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField z, Set.mem_singleton_iff] at hmem
        let z_bar : S_Ω ⟶ W := z_E ≫ E.hom
        have hZ_stalk := hAllZero Ω_z z_bar
        let Φ_z := ptOf W Ω_z z_bar
        let pt_E : Φ_z.fiber.obj E := ⟨z_E, rfl⟩
        have hmap_zero : Φ_z.toPresheafFiber E pt_E H.obj = 0 := hZ_stalk.eq_of_tgt _ 0
        have hrep_eq : (Φ_z.toPresheafFiber E pt_E H.obj).hom s =
            (Φ_z.toPresheafFiber E pt_E H.obj).hom (0 : ↥(H.obj.obj (Opposite.op E))) := by
          rw [hmap_zero]
          rfl
        obtain ⟨E', u, pt_E', hu_pt, hu_sec⟩ :=
          (Φ_z.toPresheafFiber_eq_iff' E pt_E s (0 : ↥(H.obj.obj (Opposite.op E)))).mp hrep_eq
        have _ : AlgebraicGeometry.Etale E.hom := E.prop
        have _ : AlgebraicGeometry.Etale E'.hom := E'.prop
        have hu_et : AlgebraicGeometry.Etale u.left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) u.left E.hom E.prop
            (by rw [CategoryTheory.MorphismProperty.Over.w u]; exact E'.prop)
        have hz_pt : u.left.base (pt_E'.1.base (⊥ : PrimeSpectrum Ω_z)) = z := by
          have h1 : pt_E'.1 ≫ u.left = z_E := congrArg Subtype.val hu_pt
          change (pt_E'.1 ≫ u.left).base (⊥ : PrimeSpectrum Ω_z) = z
          rw [h1, hz_E_pt]
        rw [map_zero] at hu_sec
        exact ⟨E', u, pt_E'.1.base (⊥ : PrimeSpectrum Ω_z), hu_sec, hu_et, hz_pt⟩
      exact hSheafZero H E R_s hRs s (fun _ hf => hf)

    have hSiteCont : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂),
        (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology := by
      intro S₁ S₂ h
      let B := weilEtaleSitePullback h
      have _ : CategoryTheory.Limits.PreservesFiniteLimits B :=
        CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
          (@AlgebraicGeometry.Etale) h
      have _ : CategoryTheory.RepresentablyFlat B :=
        CategoryTheory.flat_of_preservesFiniteLimits B
      have hCompat : CategoryTheory.CompatiblePreserving S₁.smallEtaleTopology B :=
        CategoryTheory.compatiblePreservingOfFlat S₁.smallEtaleTopology B
      have hCov : CategoryTheory.CoverPreserving S₂.smallEtaleTopology S₁.smallEtaleTopology B := by
        refine ⟨fun {U} R hR =>
          (hMemEtale S₁ (B.obj U) (CategoryTheory.Sieve.functorPushforward B R)).mpr fun x => ?_⟩
        have _ : AlgebraicGeometry.Etale U.hom := U.prop
        let u_x : ↥U.left := (CategoryTheory.Limits.pullback.fst U.hom h).base x
        obtain ⟨Y, f, y, hfR, hf_et, hfy⟩ := (hMemEtale S₂ U R).mp hR u_x
        have _ : AlgebraicGeometry.Etale Y.hom := Y.prop
        have _ : AlgebraicGeometry.Etale (B.obj U).hom := (B.obj U).prop
        have _ : AlgebraicGeometry.Etale (B.obj Y).hom := (B.obj Y).prop
        have hBf_et : AlgebraicGeometry.Etale (B.map f).left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
            (B.map f).left (B.obj U).hom (B.obj U).prop
            (by rw [CategoryTheory.MorphismProperty.Over.w (B.map f)]; exact (B.obj Y).prop)
        let u_hom : U.left ⟶ S₂ := U.hom
        let y_hom : Y.left ⟶ S₂ := Y.hom
        let f_mor : Y.left ⟶ U.left := f.left
        have hf_hom : f_mor ≫ u_hom = y_hom := CategoryTheory.MorphismProperty.Over.w f
        let bf_mor : CategoryTheory.Limits.pullback y_hom h ⟶
            CategoryTheory.Limits.pullback u_hom h := (B.map f).left
        have hsnd : bf_mor ≫ CategoryTheory.Limits.pullback.snd u_hom h =
            CategoryTheory.Limits.pullback.snd y_hom h :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hfst_sq : bf_mor ≫ CategoryTheory.Limits.pullback.fst u_hom h =
            CategoryTheory.Limits.pullback.fst y_hom h ≫ f_mor :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hpb_right : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.snd u_hom h)
            (CategoryTheory.Limits.pullback.fst u_hom h) h u_hom :=
          (CategoryTheory.IsPullback.of_hasPullback u_hom h).flip
        have hpb_outer : CategoryTheory.IsPullback
            (bf_mor ≫ CategoryTheory.Limits.pullback.snd u_hom h)
            (CategoryTheory.Limits.pullback.fst y_hom h) h (f_mor ≫ u_hom) := by
          rw [hsnd, hf_hom]
          exact (CategoryTheory.IsPullback.of_hasPullback y_hom h).flip
        have hpb_left : CategoryTheory.IsPullback
            bf_mor (CategoryTheory.Limits.pullback.fst y_hom h)
            (CategoryTheory.Limits.pullback.fst u_hom h) f_mor :=
          CategoryTheory.IsPullback.of_right hpb_outer hfst_sq hpb_right
        obtain ⟨y', hy'_eq, -⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_left x y hfy.symm
        exact ⟨B.obj Y, B.map f, y',
          CategoryTheory.Sieve.image_mem_functorPushforward B R hfR, hBf_et, hy'_eq⟩
      exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

    have hSiteAdj : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂),
        letI := hSiteCont h
        ∃ (hr : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
            S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint),
          letI := hr
          let pb := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
            S₂.smallEtaleTopology S₁.smallEtaleTopology
          pb.Additive ∧
          CategoryTheory.Limits.PreservesFiniteLimits pb ∧
          CategoryTheory.Limits.PreservesFiniteColimits pb := by
      intro S₁ S₂ h
      letI := hSiteCont h
      let B := weilEtaleSitePullback h
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      have _ : pf.Additive :=
        { map_add := by
            intro G₁ G₂ α β
            ext W
            rfl }
      let e_sm := CategoryTheory.equivSmallModel.{u} S₂.AffineEtale
      let ι_spec := AlgebraicGeometry.Scheme.AffineEtale.Spec S₂
      let G₂ : CategoryTheory.SmallModel.{u} S₂.AffineEtale ⥤ S₂.Etale :=
        e_sm.inverse ⋙ ι_spec
      have _ : G₂.Full := CategoryTheory.Functor.Full.comp e_sm.inverse ι_spec
      have _ : G₂.Faithful := CategoryTheory.Functor.Faithful.comp e_sm.inverse ι_spec
      have _ : G₂.IsCoverDense J₂ := by
        refine ⟨fun U => J₂.superset_covering ?_
          (CategoryTheory.Functor.is_cover_of_isCoverDense ι_spec J₂ U)⟩
        intro Y f ⟨A, g, u, hgu⟩
        exact ⟨e_sm.functor.obj A, g ≫ ι_spec.map (e_sm.unitIso.app A).hom,
          ι_spec.map (e_sm.unitIso.app A).inv ≫ u, by
            rw [Category.assoc, ← Category.assoc (ι_spec.map (e_sm.unitIso.app A).hom),
              ← ι_spec.map_comp, (e_sm.unitIso.app A).hom_inv_id, ι_spec.map_id,
              Category.id_comp, hgu]⟩
      let K₂ := G₂.inducedTopology J₂
      let eqv₂ := G₂.sheafInducedTopologyEquivOfIsCoverDense J₂ AddCommGrpCat.{u}
      have _ : (G₂ ⋙ B).IsContinuous K₂ J₁ :=
        CategoryTheory.Functor.isContinuous_comp G₂ B K₂ J₂ J₁
      let pf_sm := (G₂ ⋙ B).sheafPushforwardContinuous AddCommGrpCat.{u} K₂ J₁
      have _ : pf_sm.IsRightAdjoint := inferInstance
      let iso_comp : pf_sm ≅ pf ⋙ eqv₂.inverse :=
        CategoryTheory.Functor.sheafPushforwardContinuousComp G₂ B AddCommGrpCat.{u} K₂ J₂ J₁
      let iso_pf : pf ≅ pf_sm ⋙ eqv₂.functor :=
        (CategoryTheory.Functor.rightUnitor pf).symm ≪≫
          CategoryTheory.Functor.isoWhiskerLeft pf eqv₂.counitIso.symm ≪≫
          (CategoryTheory.Functor.associator pf eqv₂.inverse eqv₂.functor).symm ≪≫
          CategoryTheory.Functor.isoWhiskerRight iso_comp.symm eqv₂.functor
      have _ : eqv₂.functor.IsRightAdjoint := eqv₂.symm.toAdjunction.isRightAdjoint
      have _ : (pf_sm ⋙ eqv₂.functor).IsRightAdjoint :=
        CategoryTheory.Functor.isRightAdjoint_comp
      have hr : pf.IsRightAdjoint :=
        CategoryTheory.Functor.isRightAdjoint_of_iso iso_pf.symm
      letI := hr
      let pb := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      have hAdd : pb.Additive := adj.left_adjoint_additive
      have hColim : CategoryTheory.Limits.PreservesFiniteColimits pb :=
        (adj.leftAdjoint_preservesColimits :
          CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} pb).preservesFiniteColimits
      have hIsoOfStalk : ∀ {F₁ F₂ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}} (φ : F₁ ⟶ F₂),
          (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
            (x : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S₁),
            CategoryTheory.IsIso (((ptOf S₁ Ω x).sheafFiber (A := AddCommGrpCat.{u})).map φ)) →
          CategoryTheory.IsIso φ := by
        intro F₁ F₂ φ hφ
        have hZeroKer : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel φ) := by
          apply hConserv S₁ (CategoryTheory.Limits.kernel φ)
          intro Ω _ _ x
          let sf := (ptOf S₁ Ω x).sheafFiber (A := AddCommGrpCat.{u})
          have _ : CategoryTheory.IsIso (sf.map φ) := hφ Ω x
          exact CategoryTheory.Limits.IsZero.of_iso
            (CategoryTheory.Limits.isZero_kernel_of_mono (sf.map φ))
            (CategoryTheory.Limits.PreservesKernel.iso sf φ)
        have hZeroCok : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel φ) := by
          apply hConserv S₁ (CategoryTheory.Limits.cokernel φ)
          intro Ω _ _ x
          let sf := (ptOf S₁ Ω x).sheafFiber (A := AddCommGrpCat.{u})
          have _ : CategoryTheory.IsIso (sf.map φ) := hφ Ω x
          exact CategoryTheory.Limits.IsZero.of_iso
            (CategoryTheory.Limits.isZero_cokernel_of_epi (sf.map φ))
            (CategoryTheory.Limits.PreservesCokernel.iso sf φ)
        have _ : CategoryTheory.Mono φ :=
          (CategoryTheory.Preadditive.mono_iff_isZero_kernel φ).mpr hZeroKer
        have _ : CategoryTheory.Epi φ :=
          (CategoryTheory.Preadditive.epi_iff_isZero_cokernel φ).mpr hZeroCok
        exact CategoryTheory.isIso_of_mono_of_epi φ
      have hLim : CategoryTheory.Limits.PreservesFiniteLimits pb := by
        refine ⟨fun J_fin _ _ => ⟨fun {K_diag} => ⟨fun {c_lim} hc_lim => ⟨?_⟩⟩⟩⟩
        let lim_cone := CategoryTheory.Limits.limit.cone (K_diag ⋙ pb)
        let hlim_is := CategoryTheory.Limits.limit.isLimit (K_diag ⋙ pb)
        let m_cone : pb.mapCone c_lim ⟶ lim_cone := hlim_is.liftConeMorphism (pb.mapCone c_lim)
        have _ : CategoryTheory.IsIso m_cone.hom := by
          apply hIsoOfStalk m_cone.hom
          intro Ω _ _ x
          let sf₁ := (ptOf S₁ Ω x).sheafFiber (A := AddCommGrpCat.{u})
          obtain ⟨e_sf⟩ := hStalkIsoPull h Ω x
          have _ : CategoryTheory.Limits.PreservesLimitsOfShape J_fin (pb ⋙ sf₁) :=
            CategoryTheory.Limits.preservesLimitsOfShape_of_natIso e_sf.symm
          let hc₁ : CategoryTheory.Limits.IsLimit ((pb ⋙ sf₁).mapCone c_lim) :=
            CategoryTheory.Limits.isLimitOfPreserves (pb ⋙ sf₁) hc_lim
          let hc₂ : CategoryTheory.Limits.IsLimit (sf₁.mapCone lim_cone) :=
            CategoryTheory.Limits.isLimitOfPreserves sf₁ hlim_is
          let lift_sf := hc₂.liftConeMorphism (sf₁.mapCone (pb.mapCone c_lim))
          have hm_eq : sf₁.map m_cone.hom = lift_sf.hom := by
            apply hc₂.hom_ext
            intro j
            rw [lift_sf.w j]
            change sf₁.map m_cone.hom ≫ sf₁.map (lim_cone.π.app j) =
              sf₁.map ((pb.mapCone c_lim).π.app j)
            rw [← sf₁.map_comp, m_cone.w j]
          rw [hm_eq]
          have _ : CategoryTheory.IsIso lift_sf :=
            CategoryTheory.Limits.IsLimit.hom_isIso hc₁ hc₂ lift_sf
          exact (CategoryTheory.Limits.Cones.forget _).map_isIso lift_sf
        exact CategoryTheory.Limits.IsLimit.ofIsoLimit hlim_is
          (CategoryTheory.Limits.Cones.ext (CategoryTheory.asIso m_cone.hom).symm
            (fun j => by
              dsimp
              exact (IsIso.eq_inv_comp m_cone.hom).mpr (m_cone.w j)))
      exact ⟨hr, hAdd, hLim, hColim⟩

    let pullConst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
        [hc : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
        (A : AddCommGrpCat.{u}),
        (CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶
          ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
            S₂.smallEtaleTopology S₁.smallEtaleTopology).obj
            ((CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
      fun {S₁ S₂} h _ A =>
        let B := weilEtaleSitePullback h
        let J₁ := S₁.smallEtaleTopology
        let J₂ := S₂.smallEtaleTopology
        let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
        let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let constA₁ := (CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A
        let constA₂ := (CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj A
        let η₁ := CategoryTheory.toSheafify J₁ constA₁
        let η_pb : constA₂ ⟶
            (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).obj (pf.obj (C₁.obj A)) :=
          { app := fun U_op => η₁.app (Opposite.op (B.obj U_op.unop))
            naturality := fun {X Y} f => by
              change 𝟙 A ≫ η₁.app (Opposite.op (B.obj Y.unop)) =
                η₁.app (Opposite.op (B.obj X.unop)) ≫ (C₁.obj A).obj.map (B.map f.unop).op
              refine (Category.id_comp _).trans ?_
              exact (Category.id_comp _).symm.trans (η₁.naturality (B.map f.unop).op) }
        ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
          constA₂ (pf.obj (C₁.obj A))).symm η_pb

    have hPullConstSpec : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
        [hc : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
        (A : AddCommGrpCat.{u}) (U_op : (S₂.Etale)ᵒᵖ),
        (CategoryTheory.toSheafify S₂.smallEtaleTopology
          ((CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj A)).app U_op ≫
          (pullConst h A).hom.app U_op =
        (CategoryTheory.toSheafify S₁.smallEtaleTopology
          ((CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A)).app
            (Opposite.op ((weilEtaleSitePullback h).obj U_op.unop)) := by
      intro S₁ S₂ h _ A U_op
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let pf := (weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let constA₂ := (CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj A
      have h1 : ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
          constA₂ (pf.obj (C₁.obj A))) (pullConst h A) =
          CategoryTheory.toSheafify J₂ constA₂ ≫ (pullConst h A).hom := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      have h2 := ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
        constA₂ (pf.obj (C₁.obj A))).apply_symm_apply
        { app := fun V_op =>
            (CategoryTheory.toSheafify J₁ ((CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A)).app
              (Opposite.op ((weilEtaleSitePullback h).obj V_op.unop))
          naturality := fun {X Y} f => by
            let η₁ := CategoryTheory.toSheafify J₁ ((CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A)
            change 𝟙 A ≫ η₁.app (Opposite.op ((weilEtaleSitePullback h).obj Y.unop)) =
              η₁.app (Opposite.op ((weilEtaleSitePullback h).obj X.unop)) ≫
                (C₁.obj A).obj.map ((weilEtaleSitePullback h).map f.unop).op
            refine (Category.id_comp _).trans ?_
            exact (Category.id_comp _).symm.trans
              (η₁.naturality ((weilEtaleSitePullback h).map f.unop).op) }
      exact congrArg (fun ν => ν.app U_op) (h1.symm.trans h2)

    have hPullConstEqAdj : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
        [hc : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
        {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (A : AddCommGrpCat.{u}),
        let B := weilEtaleSitePullback h
        let J₁ := S₁.smallEtaleTopology
        let J₂ := S₂.smallEtaleTopology
        let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
        let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
        ((adj₂.homEquiv A (pf.obj (C₁.obj A))).symm
          (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op)) = pullConst h A := by
      intro S₁ S₂ h hc T₁ hT₁ T₂ hT₂ A B J₁ J₂ C₁ pf adj₁ adj₂ τ
      apply (adj₂.homEquiv A (pf.obj (C₁.obj A))).injective
      rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit]
      have hspec := hPullConstSpec h A (Opposite.op T₂)
      let η₁ := CategoryTheory.toSheafify J₁ ((CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A)
      have hnat_τ : η₁.app (Opposite.op T₁) ≫ (C₁.obj A).obj.map τ.op =
          η₁.app (Opposite.op (B.obj T₂)) :=
        (η₁.naturality τ.op).symm
      exact hnat_τ.trans hspec.symm

    have hPullEx0 : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂),
        ∃ p : weilEtaleTorsionH S₂ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0,
          WeilIsTorsionEtalePullback h ℓ 0 p := by
      intro S₁ S₂ h
      letI := hSiteCont h
      obtain ⟨hr, hAdd, hLim, hColim⟩ := hSiteAdj h
      letI := hr
      let B := weilEtaleSitePullback h
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let pb := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let T₁ := mkTerm S₁
      let hT₁ := hIsTerm S₁
      let T₂ := mkTerm S₂
      let hT₂ := hIsTerm S₂
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      have _ : CategoryTheory.Limits.PreservesFiniteLimits B :=
        CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
          (@AlgebraicGeometry.Etale) h
      have hBT₂ : CategoryTheory.Limits.IsTerminal (B.obj T₂) :=
        CategoryTheory.Limits.IsTerminal.isTerminalObj B T₂ hT₂
      let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
      let τ_inv : T₁ ⟶ B.obj T₂ := hBT₂.from T₁
      let adj_comp := adj₂.comp adj_pull
      let πℤ : pb.obj (C₂.obj Aℤ) ⟶ C₁.obj Aℤ :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₂.homEquiv Aℤ (pf.obj (C₁.obj Aℤ))).symm
            (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op))
      let u_comp : Aℤ ⟶ (pb.obj (C₂.obj Aℤ)).obj.obj (Opposite.op (B.obj T₂)) :=
        adj_comp.unit.app Aℤ
      let ιℤ : C₁.obj Aℤ ⟶ pb.obj (C₂.obj Aℤ) :=
        (adj₁.homEquiv Aℤ (pb.obj (C₂.obj Aℤ))).symm
          (u_comp ≫ (pb.obj (C₂.obj Aℤ)).obj.map τ_inv.op)
      have hadj_πℤ : adj_comp.homEquiv Aℤ (C₁.obj Aℤ) πℤ =
          adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op := by
        change (adj₂.homEquiv Aℤ (pf.obj (C₁.obj Aℤ)))
          ((adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)) πℤ) = _
        dsimp [πℤ]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      have hιπ : ιℤ ≫ πℤ = 𝟙 (C₁.obj Aℤ) := by
        apply (adj₁.homEquiv Aℤ (C₁.obj Aℤ)).injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        dsimp [ιℤ]
        rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit]
        change (u_comp ≫ (pb.obj (C₂.obj Aℤ)).obj.map τ_inv.op) ≫
            πℤ.hom.app (Opposite.op T₁) = adj₁.unit.app Aℤ
        have hnat_π : (pb.obj (C₂.obj Aℤ)).obj.map τ_inv.op ≫ πℤ.hom.app (Opposite.op T₁) =
            πℤ.hom.app (Opposite.op (B.obj T₂)) ≫ (C₁.obj Aℤ).obj.map τ_inv.op :=
          πℤ.hom.naturality τ_inv.op
        have h1 : u_comp ≫ πℤ.hom.app (Opposite.op (B.obj T₂)) =
            adj_comp.homEquiv Aℤ (C₁.obj Aℤ) πℤ := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        calc (u_comp ≫ (pb.obj (C₂.obj Aℤ)).obj.map τ_inv.op) ≫ πℤ.hom.app (Opposite.op T₁)
            = u_comp ≫ ((pb.obj (C₂.obj Aℤ)).obj.map τ_inv.op ≫ πℤ.hom.app (Opposite.op T₁)) :=
                Category.assoc _ _ _
          _ = (u_comp ≫ πℤ.hom.app (Opposite.op (B.obj T₂))) ≫ (C₁.obj Aℤ).obj.map τ_inv.op := by
                rw [hnat_π, ← Category.assoc]
          _ = adj₁.unit.app Aℤ := by
                rw [h1, hadj_πℤ, Category.assoc, ← (C₁.obj Aℤ).obj.map_comp, ← op_comp,
                  hT₁.hom_ext (τ_inv ≫ τ) (𝟙 T₁), op_id, (C₁.obj Aℤ).obj.map_id]
                exact Category.comp_id _
      have hπι : πℤ ≫ ιℤ = 𝟙 (pb.obj (C₂.obj Aℤ)) := by
        apply (adj_comp.homEquiv Aℤ (pb.obj (C₂.obj Aℤ))).injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right, hadj_πℤ,
          CategoryTheory.Adjunction.homEquiv_unit]
        change (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op) ≫
            ιℤ.hom.app (Opposite.op (B.obj T₂)) = u_comp
        have hnat_ι : (C₁.obj Aℤ).obj.map τ.op ≫ ιℤ.hom.app (Opposite.op (B.obj T₂)) =
            ιℤ.hom.app (Opposite.op T₁) ≫ (pb.obj (C₂.obj Aℤ)).obj.map τ.op :=
          ιℤ.hom.naturality τ.op
        have h1 : adj₁.unit.app Aℤ ≫ ιℤ.hom.app (Opposite.op T₁) =
            adj₁.homEquiv Aℤ (pb.obj (C₂.obj Aℤ)) ιℤ := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        calc (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op) ≫ ιℤ.hom.app (Opposite.op (B.obj T₂))
            = adj₁.unit.app Aℤ ≫ ((C₁.obj Aℤ).obj.map τ.op ≫ ιℤ.hom.app (Opposite.op (B.obj T₂))) :=
                Category.assoc _ _ _
          _ = (adj₁.unit.app Aℤ ≫ ιℤ.hom.app (Opposite.op T₁)) ≫ (pb.obj (C₂.obj Aℤ)).obj.map τ.op := by
                rw [hnat_ι, ← Category.assoc]
          _ = u_comp := by
                rw [h1]
                dsimp [ιℤ]
                rw [Equiv.apply_symm_apply, Category.assoc, ← (pb.obj (C₂.obj Aℤ)).obj.map_comp,
                  ← op_comp, hBT₂.hom_ext (τ ≫ τ_inv) (𝟙 (B.obj T₂)), op_id,
                  (pb.obj (C₂.obj Aℤ)).obj.map_id, Category.comp_id]
      let πM : pb.obj (C₂.obj AM) ⟶ C₁.obj AM :=
        (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
          ((adj₂.homEquiv AM (pf.obj (C₁.obj AM))).symm
            (adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op))
      have _ : pb.Additive := hAdd
      have _ : CategoryTheory.Limits.PreservesFiniteLimits pb := hLim
      have _ : CategoryTheory.Limits.PreservesFiniteColimits pb := hColim
      let p_hom : weilEtaleTorsionH S₂ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0 :=
        ((CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C₁.obj Aℤ) (Nat.add_zero 0)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb.obj (C₂.obj AM))
            (Nat.zero_add 0)).comp
            (pb.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 0))
      exact ⟨p_hom, ⟨hSiteCont h, hr, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι,
        fun x => rfl⟩⟩

    have hPullComp0 : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
        (h₁ : S₁ ⟶ S₂) (h₂ : S₂ ⟶ S₃)
        (p₁ : weilEtaleTorsionH S₂ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0)
        (p₂ : weilEtaleTorsionH S₃ ℓ 0 →+ weilEtaleTorsionH S₂ ℓ 0)
        (p₁₂ : weilEtaleTorsionH S₃ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0),
        WeilIsTorsionEtalePullback h₁ ℓ 0 p₁ →
        WeilIsTorsionEtalePullback h₂ ℓ 0 p₂ →
        WeilIsTorsionEtalePullback (h₁ ≫ h₂) ℓ 0 p₁₂ →
        p₁₂ = p₁.comp p₂ := by
      intro S₁ S₂ S₃ h₁ h₂ p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
      have hStepEq : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
          (p : weilEtaleTorsionH Y₂ ℓ 0 →+ weilEtaleTorsionH Y₁ ℓ 0),
          WeilIsTorsionEtalePullback h ℓ 0 p →
          ∀ [hc : (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology]
            (δ : (CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶
              (CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj AM),
            pullConst h Aℤ ≫ ((weilEtaleSitePullback h).sheafPushforwardContinuous
              AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology).map
                (CategoryTheory.Abelian.Ext.addEquiv₀ (p (CategoryTheory.Abelian.Ext.mk₀ δ))) =
              δ ≫ pullConst h AM := by
        intro Y₁ Y₂ h p hp hc_in δ
        let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
          CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
            (@AlgebraicGeometry.Etale) h :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
        rcases hp with ⟨hc, hr, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, _, hπι, hp_eq⟩
        have hhc : hc_in = hc := Subsingleton.elim _ _
        subst hhc
        let B := weilEtaleSitePullback h
        let J₁ := Y₁.smallEtaleTopology
        let J₂ := Y₂.smallEtaleTopology
        let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
        let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
        let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B AddCommGrpCat.{u} _ J₂ J₁ hc_in
        let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _ B AddCommGrpCat.{u} _ J₂ J₁ hc_in hr
        let adj_pull := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B AddCommGrpCat.{u} _ J₂ J₁ hc_in hr
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
        let πℤ : pb.obj (C₂.obj Aℤ) ⟶ C₁.obj Aℤ :=
          (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
            ((adj₂.homEquiv Aℤ (pf.obj (C₁.obj Aℤ))).symm
              (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op))
        let πM : pb.obj (C₂.obj AM) ⟶ C₁.obj AM :=
          (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
            ((adj₂.homEquiv AM (pf.obj (C₁.obj AM))).symm
              (adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op))
        have _ : pb.Additive := hAdd
        have _ : CategoryTheory.Limits.PreservesFiniteLimits pb := hLim
        have _ : CategoryTheory.Limits.PreservesFiniteColimits pb := hColim
        have _ : pb.PreservesHomology := inferInstance
        have hp_δ : p (CategoryTheory.Abelian.Ext.mk₀ δ) =
            CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ pb.map δ ≫ πM) := by
          rw [hp_eq (CategoryTheory.Abelian.Ext.mk₀ δ)]
          change (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C₁.obj Aℤ) (Nat.add_zero 0)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
              ((pb.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 0) (CategoryTheory.Abelian.Ext.mk₀ δ))
              (Nat.zero_add 0)) = _
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          change ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ pb.map δ)).comp
            (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 0)) = _
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
        have hadd_p : CategoryTheory.Abelian.Ext.addEquiv₀ (p (CategoryTheory.Abelian.Ext.mk₀ δ)) =
            ιℤ ≫ pb.map δ ≫ πM := by
          rw [hp_δ, ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rw [hadd_p]
        have hπℤ_pull : adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ) πℤ = pullConst h Aℤ := by
          dsimp [πℤ]
          rw [Equiv.apply_symm_apply]
          exact hPullConstEqAdj h hT₁ hT₂ Aℤ
        have hπM_pull : adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM) πM = pullConst h AM := by
          dsimp [πM]
          rw [Equiv.apply_symm_apply]
          exact hPullConstEqAdj h hT₁ hT₂ AM
        rw [← hπℤ_pull, ← hπM_pull, ← CategoryTheory.Adjunction.homEquiv_naturality_right,
          ← CategoryTheory.Adjunction.homEquiv_naturality_left,
          ← Category.assoc πℤ, hπι, Category.id_comp]

      let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂),
          CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
        fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂),
          CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
            (@AlgebraicGeometry.Etale) f :=
        fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
      letI := hSiteCont h₁
      letI := hSiteCont h₂
      letI := hSiteCont (h₁ ≫ h₂)
      let B₁ := weilEtaleSitePullback h₁
      let B₂ := weilEtaleSitePullback h₂
      let B₁₂ := weilEtaleSitePullback (h₁ ≫ h₂)
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let J₃ := S₃.smallEtaleTopology
      let pf₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let pf₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₃ J₂
      let pf₁₂ := B₁₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₃ J₁
      have _ : (B₂ ⋙ B₁).IsContinuous J₃ J₁ :=
        CategoryTheory.Functor.isContinuous_comp B₂ B₁ J₃ J₂ J₁
      let e_B : B₂ ⋙ B₁ ≅ B₁₂ :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp h₁ h₂).symm
      let e_pf : pf₁ ⋙ pf₂ ≅ pf₁₂ :=
        (CategoryTheory.Functor.sheafPushforwardContinuousComp B₂ B₁ AddCommGrpCat.{u} J₃ J₂ J₁).symm ≪≫
          CategoryTheory.Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u} J₃ J₁
      have hPullConstComp : ∀ A : AddCommGrpCat.{u},
          pullConst (h₁ ≫ h₂) A =
            pullConst h₂ A ≫ pf₂.map (pullConst h₁ A) ≫ e_pf.hom.app _ := by
        intro A
        let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
        let constA₁ := (CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A
        let constA₃ := (CategoryTheory.Functor.const (S₃.Etale)ᵒᵖ).obj A
        let η₁ := CategoryTheory.toSheafify J₁ constA₁
        let η₃ := CategoryTheory.toSheafify J₃ constA₃
        have hlhs : ((CategoryTheory.sheafificationAdjunction J₃ AddCommGrpCat.{u}).homEquiv
            constA₃ (pf₁₂.obj (C₁.obj A))) (pullConst (h₁ ≫ h₂) A) =
            η₃ ≫ (pullConst (h₁ ≫ h₂) A).hom := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        have hrhs : ((CategoryTheory.sheafificationAdjunction J₃ AddCommGrpCat.{u}).homEquiv
            constA₃ (pf₁₂.obj (C₁.obj A)))
              (pullConst h₂ A ≫ pf₂.map (pullConst h₁ A) ≫ e_pf.hom.app _) =
            η₃ ≫ (pullConst h₂ A ≫ pf₂.map (pullConst h₁ A) ≫ e_pf.hom.app _).hom := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        apply ((CategoryTheory.sheafificationAdjunction J₃ AddCommGrpCat.{u}).homEquiv
          constA₃ (pf₁₂.obj (C₁.obj A))).injective
        refine (hlhs.trans ?_).trans hrhs.symm
        ext U_op : 2
        have hspec₁₂ : η₃.app U_op ≫ (pullConst (h₁ ≫ h₂) A).hom.app U_op =
            η₁.app (Opposite.op (B₁₂.obj U_op.unop)) :=
          hPullConstSpec (h₁ ≫ h₂) A U_op
        have hspec₂ : η₃.app U_op ≫ (pullConst h₂ A).hom.app U_op =
            (CategoryTheory.toSheafify J₂ ((CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj A)).app
              (Opposite.op (B₂.obj U_op.unop)) :=
          hPullConstSpec h₂ A U_op
        have hspec₁ :
            (CategoryTheory.toSheafify J₂ ((CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj A)).app
                (Opposite.op (B₂.obj U_op.unop)) ≫
              (pullConst h₁ A).hom.app (Opposite.op (B₂.obj U_op.unop)) =
            η₁.app (Opposite.op (B₁.obj (B₂.obj U_op.unop))) :=
          hPullConstSpec h₁ A (Opposite.op (B₂.obj U_op.unop))
        let g_op := (e_B.inv.app U_op.unop).op
        let f₁ := (pullConst h₁ A).hom.app (Opposite.op (B₂.obj U_op.unop))
        let m := (C₁.obj A).obj.map g_op
        change η₃.app U_op ≫ (pullConst (h₁ ≫ h₂) A).hom.app U_op =
          (η₃.app U_op ≫ (pullConst h₂ A).hom.app U_op) ≫ (f₁ ≫ m)
        have hnat_g : η₁.app (Opposite.op (B₁₂.obj U_op.unop)) =
            η₁.app (Opposite.op (B₁.obj (B₂.obj U_op.unop))) ≫ m :=
          (Category.id_comp _).symm.trans (η₁.naturality g_op)
        exact hspec₁₂.trans (hnat_g.trans
          (((congrArg (· ≫ m) hspec₁.symm).trans (Category.assoc _ f₁ m)).trans
            (congrArg (· ≫ (f₁ ≫ m)) hspec₂.symm)))

      ext ξ
      let δ₃ := CategoryTheory.Abelian.Ext.addEquiv₀ ξ
      have hξ : CategoryTheory.Abelian.Ext.mk₀ δ₃ = ξ :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply ξ
      rw [← hξ, AddMonoidHom.comp_apply]
      let f₂ := CategoryTheory.Abelian.Ext.addEquiv₀ (p₂ (CategoryTheory.Abelian.Ext.mk₀ δ₃))
      have hf₂ : CategoryTheory.Abelian.Ext.mk₀ f₂ = p₂ (CategoryTheory.Abelian.Ext.mk₀ δ₃) :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply _
      rw [← hf₂]
      let f₁ := CategoryTheory.Abelian.Ext.addEquiv₀ (p₁ (CategoryTheory.Abelian.Ext.mk₀ f₂))
      let f₁₂ := CategoryTheory.Abelian.Ext.addEquiv₀ (p₁₂ (CategoryTheory.Abelian.Ext.mk₀ δ₃))
      apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
      change f₁₂ = f₁
      have heq₁₂ : pullConst (h₁ ≫ h₂) Aℤ ≫ pf₁₂.map f₁₂ = δ₃ ≫ pullConst (h₁ ≫ h₂) AM :=
        hStepEq (h₁ ≫ h₂) p₁₂ hp₁₂ δ₃
      have heq₂ : pullConst h₂ Aℤ ≫ pf₂.map f₂ = δ₃ ≫ pullConst h₂ AM :=
        hStepEq h₂ p₂ hp₂ δ₃
      have heq₁ : pullConst h₁ Aℤ ≫ pf₁.map f₁ = f₂ ≫ pullConst h₁ AM :=
        hStepEq h₁ p₁ hp₁ f₂
      have heq_comp : pullConst (h₁ ≫ h₂) Aℤ ≫ pf₁₂.map f₁ =
          δ₃ ≫ pullConst (h₁ ≫ h₂) AM := by
        have hnat_epf : pf₂.map (pf₁.map f₁) ≫ e_pf.hom.app _ =
            e_pf.hom.app _ ≫ pf₁₂.map f₁ :=
          e_pf.hom.naturality f₁
        calc pullConst (h₁ ≫ h₂) Aℤ ≫ pf₁₂.map f₁
            = (pullConst h₂ Aℤ ≫ pf₂.map (pullConst h₁ Aℤ) ≫ e_pf.hom.app _) ≫ pf₁₂.map f₁ := by
                rw [hPullConstComp Aℤ]
          _ = pullConst h₂ Aℤ ≫ pf₂.map (pullConst h₁ Aℤ) ≫ (e_pf.hom.app _ ≫ pf₁₂.map f₁) := by
                simp only [Category.assoc]
          _ = pullConst h₂ Aℤ ≫ (pf₂.map (pullConst h₁ Aℤ) ≫ pf₂.map (pf₁.map f₁)) ≫
                e_pf.hom.app _ := by
                rw [← hnat_epf, Category.assoc]
          _ = pullConst h₂ Aℤ ≫ pf₂.map (f₂ ≫ pullConst h₁ AM) ≫ e_pf.hom.app _ := by
                rw [← pf₂.map_comp, heq₁]
          _ = (pullConst h₂ Aℤ ≫ pf₂.map f₂) ≫ pf₂.map (pullConst h₁ AM) ≫ e_pf.hom.app _ := by
                rw [pf₂.map_comp]; simp only [Category.assoc]
          _ = δ₃ ≫ (pullConst h₂ AM ≫ pf₂.map (pullConst h₁ AM) ≫ e_pf.hom.app _) := by
                rw [heq₂]; simp only [Category.assoc]
          _ = δ₃ ≫ pullConst (h₁ ≫ h₂) AM := by
                rw [← hPullConstComp AM]
      have hboth : pullConst (h₁ ≫ h₂) Aℤ ≫ pf₁₂.map f₁₂ =
          pullConst (h₁ ≫ h₂) Aℤ ≫ pf₁₂.map f₁ :=
        heq₁₂.trans heq_comp.symm
      rcases hp₁₂ with ⟨hc₁₂, hr₁₂, _, _, _, T₁, hT₁, T₃, hT₃, ιℤ₁₂, hιπ₁₂, _, _⟩
      have hhc₁₂ : hSiteCont (h₁ ≫ h₂) = hc₁₂ := Subsingleton.elim _ _
      letI := hr₁₂
      let pb₁₂ := @CategoryTheory.Functor.sheafPullback _ _ _ _ B₁₂ AddCommGrpCat.{u} _ J₃ J₁
        (hSiteCont (h₁ ≫ h₂)) (by subst hhc₁₂; exact hr₁₂)
      let adj₁₂ := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B₁₂ AddCommGrpCat.{u} _ J₃ J₁
        (hSiteCont (h₁ ≫ h₂)) (by subst hhc₁₂; exact hr₁₂)
      let adj₁_T := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₃_T := CategoryTheory.constantSheafAdj J₃ AddCommGrpCat.{u} hT₃
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₃ := CategoryTheory.constantSheaf J₃ AddCommGrpCat.{u}
      let τ₁₂ : B₁₂.obj T₃ ⟶ T₁ := hT₁.from (B₁₂.obj T₃)
      let πℤ₁₂ : pb₁₂.obj (C₃.obj Aℤ) ⟶ C₁.obj Aℤ :=
        (adj₁₂.homEquiv (C₃.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₃_T.homEquiv Aℤ (pf₁₂.obj (C₁.obj Aℤ))).symm
            (adj₁_T.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ₁₂.op))
      have hπ₁₂_pull : adj₁₂.homEquiv (C₃.obj Aℤ) (C₁.obj Aℤ) πℤ₁₂ =
          pullConst (h₁ ≫ h₂) Aℤ := by
        dsimp [πℤ₁₂]
        rw [Equiv.apply_symm_apply]
        exact hPullConstEqAdj (h₁ ≫ h₂) hT₁ hT₃ Aℤ
      rw [← hπ₁₂_pull, ← CategoryTheory.Adjunction.homEquiv_naturality_right,
        ← CategoryTheory.Adjunction.homEquiv_naturality_right] at hboth
      have hπ_eq : πℤ₁₂ ≫ f₁₂ = πℤ₁₂ ≫ f₁ :=
        (adj₁₂.homEquiv (C₃.obj Aℤ) (C₁.obj AM)).injective hboth
      have hι_eq : ιℤ₁₂ ≫ πℤ₁₂ = 𝟙 (C₁.obj Aℤ) := by
        subst hhc₁₂
        exact hιπ₁₂
      calc f₁₂ = (ιℤ₁₂ ≫ πℤ₁₂) ≫ f₁₂ := by rw [hι_eq, Category.id_comp]
        _ = ιℤ₁₂ ≫ (πℤ₁₂ ≫ f₁₂) := Category.assoc _ _ _
        _ = ιℤ₁₂ ≫ (πℤ₁₂ ≫ f₁) := by rw [hπ_eq]
        _ = (ιℤ₁₂ ≫ πℤ₁₂) ≫ f₁ := (Category.assoc _ _ _).symm
        _ = f₁ := by rw [hι_eq, Category.id_comp]
    let c_hom : ZMod ℓ →+ (Aℤ ⟶ AM) :=
      { toFun := fun c =>
          AddCommGrpCat.ofHom
            { toFun := fun z => ULift.up (z.down • c)
              map_zero' := by
                change ULift.up ((0 : ℤ) • c) = 0
                rw [zero_zsmul]
                rfl
              map_add' := fun z₁ z₂ => by
                change ULift.up ((z₁.down + z₂.down) • c) =
                  ULift.up (z₁.down • c) + ULift.up (z₂.down • c)
                rw [add_zsmul]
                rfl }
        map_zero' := by
          apply AddCommGrpCat.ext
          rintro ⟨z⟩
          change ULift.up (z • (0 : ZMod ℓ)) = 0
          rw [smul_zero]
          rfl
        map_add' := fun c₁ c₂ => by
          apply AddCommGrpCat.ext
          rintro ⟨z⟩
          change ULift.up (z • (c₁ + c₂)) = ULift.up (z • c₁) + ULift.up (z • c₂)
          rw [smul_add]
          rfl }

    have hConstAdd : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
        (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).Additive := by
      intro Y
      unfold CategoryTheory.constantSheaf
      infer_instance

    let γ : ∀ (Y : AlgebraicGeometry.Scheme.{u}), ZMod ℓ →+ weilEtaleTorsionH Y ℓ 0 :=
      fun Y =>
        let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
        have _ : C_Y.Additive := hConstAdd Y
        { toFun := fun c => CategoryTheory.Abelian.Ext.mk₀ (C_Y.map (c_hom c))
          map_zero' := by
            rw [map_zero, C_Y.map_zero, CategoryTheory.Abelian.Ext.mk₀_zero]
          map_add' := fun c₁ c₂ => by
            rw [map_add, C_Y.map_add, CategoryTheory.Abelian.Ext.mk₀_add] }

    have hγ_pull : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
        (p_h : weilEtaleTorsionH Y₂ ℓ 0 →+ weilEtaleTorsionH Y₁ ℓ 0),
        WeilIsTorsionEtalePullback h ℓ 0 p_h →
        ∀ c : ZMod ℓ, p_h (γ Y₂ c) = γ Y₁ c := by
      intro Y₁ Y₂ h p_h hp c
      let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
      rcases hp with ⟨hc, hr, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, _, hp_eq⟩
      let B : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      let J₁ := Y₁.smallEtaleTopology
      let J₂ := Y₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B AddCommGrpCat.{u} _ J₂ J₁ hc
      let P_pull := @CategoryTheory.Functor.sheafPullback _ _ _ _ B AddCommGrpCat.{u} _ J₂ J₁ hc hr
      let adj_pull := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B AddCommGrpCat.{u} _ J₂ J₁ hc hr
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
      let πℤ : P_pull.obj (C₂.obj Aℤ) ⟶ C₁.obj Aℤ :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
            (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op))
      let πM : P_pull.obj (C₂.obj AM) ⟶ C₁.obj AM :=
        (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
          ((adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
            (adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op))
      have _ : P_pull.Additive := hAdd
      have _ : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
      have _ : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
      have _ : P_pull.PreservesHomology := inferInstance
      change p_h (CategoryTheory.Abelian.Ext.mk₀ (C₂.map (c_hom c))) =
        CategoryTheory.Abelian.Ext.mk₀ (C₁.map (c_hom c))
      rw [hp_eq (CategoryTheory.Abelian.Ext.mk₀ (C₂.map (c_hom c)))]
      change (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C₁.obj Aℤ) (Nat.add_zero 0)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 0)
            (CategoryTheory.Abelian.Ext.mk₀ (C₂.map (c_hom c))))
          (Nat.zero_add 0)) = _
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      change ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ P_pull.map (C₂.map (c_hom c)))).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 0)) = _
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
      congr 1
      have hcomm_π : P_pull.map (C₂.map (c_hom c)) ≫ πM = πℤ ≫ C₁.map (c_hom c) := by
        apply (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj AM)).injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
          CategoryTheory.Adjunction.homEquiv_naturality_right]
        dsimp [πM, πℤ]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        apply (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj AM))).injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
          CategoryTheory.Adjunction.homEquiv_naturality_right,
          Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        have hunit_nat : c_hom c ≫ adj₁.unit.app AM =
            adj₁.unit.app Aℤ ≫ (C₁.map (c_hom c)).hom.app (Opposite.op T₁) :=
          adj₁.unit.naturality (c_hom c)
        change c_hom c ≫ adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op =
          (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op) ≫
            (C₁.map (c_hom c)).hom.app (Opposite.op (B.obj T₂))
        rw [← Category.assoc, hunit_nat, Category.assoc, Category.assoc]
        congr 1
        exact ((C₁.map (c_hom c)).hom.naturality τ.op).symm
      rw [hcomm_π, ← Category.assoc, hιπ, Category.id_comp]

    have hCoverByTK : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (U : (AlgebraicGeometry.Spec (CommRingCat.of K)).Etale) (x : ↥U.left),
        ∃ (f_x : mkTerm (AlgebraicGeometry.Spec (CommRingCat.of K)) ⟶ U),
          AlgebraicGeometry.Etale f_x.left ∧
          f_x.left.base (⊥ : PrimeSpectrum K) = x := by
      intro K _ _ U x
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := mkTerm S_K
      have _ : AlgebraicGeometry.Etale U.hom := U.prop
      obtain ⟨V_x, hAffV, hxV, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x) (U := (⊤ : U.left.Opens)) trivial
      let R_V : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V_x)
      let B_alg : Type u := ↑R_V
      let p_x : PrimeSpectrum B_alg := hAffV.isoSpec.hom.base ⟨x, hxV⟩
      let j_V : AlgebraicGeometry.Spec R_V ⟶ U.left := hAffV.fromSpec
      have hj_V_pt : j_V.base p_x = x := by
        have h1 : hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩) = ⟨x, hxV⟩ := by
          change (hAffV.isoSpec.hom ≫ hAffV.isoSpec.inv).base ⟨x, hxV⟩ = ⟨x, hxV⟩
          rw [hAffV.isoSpec.hom_inv_id]
          rfl
        change V_x.ι.base (hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩)) = x
        rw [h1]
        rfl
      have _ : AlgebraicGeometry.Etale j_V := inferInstance
      let φ_KB : CommRingCat.of K ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_V ≫ U.hom)
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_KB = j_V ≫ U.hom :=
        AlgebraicGeometry.Spec.map_preimage (j_V ≫ U.hom)
      have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_KB) := by
        rw [hSpec_φ]; infer_instance
      have hEt_hom : φ_KB.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec
      let _ : Algebra K B_alg := φ_KB.hom.toAlgebra
      have _ : Algebra.Etale K B_alg := RingHom.etale_algebraMap.mp hEt_hom
      obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K B_alg).mp inferInstance
      have _ : Finite I := hFinI
      let _ : Fintype I := Fintype.ofFinite I
      let _ : ∀ i, Field (L i) := hFieldL
      let _ : ∀ i, Algebra K (L i) := hAlgL
      have hex_i₀ : ∃ i₀ : I, Θ.symm (Pi.single i₀ 1) ∉ p_x.asIdeal := by
        by_contra! hall
        have hsum1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
          ext j; simp [Finset.sum_apply]
        have hB1 : (1 : B_alg) = ∑ i : I, Θ.symm (Pi.single i 1) := by
          calc (1 : B_alg) = Θ.symm 1 := (map_one Θ.symm).symm
            _ = ∑ i : I, Θ.symm (Pi.single i 1) := by rw [hsum1, map_sum]
        have hmem1 : (1 : B_alg) ∈ p_x.asIdeal := by
          rw [hB1]
          exact Ideal.sum_mem p_x.asIdeal (fun i _ => hall i)
        exact p_x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hmem1)
      obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
      have hSurj_i₀ : Function.Surjective (algebraMap K (L i₀)) := by
        intro y
        have _ : Module.Finite K (L i₀) := (hFinSep i₀).1
        have hy_int : _root_.IsIntegral K y := Algebra.IsIntegral.isIntegral y
        let mp := minpoly K y
        have hm_deg : mp.degree ≠ 0 :=
          ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root mp hm_deg
        obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
        have hq_unit : IsUnit q_pol :=
          ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
            (Polynomial.not_isUnit_X_sub_C c)
        have hq_monic : q_pol.Monic :=
          Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
            (hq_pol ▸ minpoly.monic hy_int)
        have hq1 : q_pol = 1 := by
          have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
          have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
          rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
        have hm_eq : mp = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
        have haeval : Polynomial.aeval y mp = 0 := minpoly.aeval K y
        rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
        exact ⟨c, haeval.symm⟩
      let e_L : K ≃+* L i₀ :=
        RingEquiv.ofBijective (algebraMap K (L i₀)) ⟨RingHom.injective _, hSurj_i₀⟩
      let χ : B_alg →+* K :=
        e_L.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom)
      have hχ_comp : φ_KB ≫ CommRingCat.ofHom χ = 𝟙 (CommRingCat.of K) := by
        apply CommRingCat.hom_ext
        ext c
        change e_L.symm (Θ (algebraMap K B_alg c) i₀) = c
        rw [Θ.commutes]
        change e_L.symm (e_L c) = c
        exact e_L.symm_apply_apply c
      have hker_χ : RingHom.ker χ = p_x.asIdeal := by
        have hle : RingHom.ker χ ≤ p_x.asIdeal := by
          intro b hb
          rw [RingHom.mem_ker] at hb
          have hΘb : Θ b i₀ = 0 := by
            apply e_L.symm.injective
            rw [map_zero]
            exact hb
          have hmul0 : b * Θ.symm (Pi.single i₀ 1) = 0 := by
            apply Θ.injective
            rw [map_mul, Θ.apply_symm_apply, map_zero]
            ext j
            by_cases hj : j = i₀
            · subst hj; simp [hΘb]
            · simp [Pi.single_eq_of_ne hj]
          have hmem_mul : b * Θ.symm (Pi.single i₀ 1) ∈ p_x.asIdeal := by
            rw [hmul0]; exact p_x.asIdeal.zero_mem
          exact (p_x.isPrime.mem_or_mem hmem_mul).resolve_right hi₀_not_mem
        have hMax : (RingHom.ker χ).IsMaximal := by
          apply RingHom.ker_isMaximal_of_surjective χ
          intro c
          refine ⟨φ_KB.hom c, ?_⟩
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hχ_comp) c
        exact hMax.eq_of_le p_x.isPrime.ne_top hle
      let σ_x : S_K ⟶ U.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫ j_V
      have hσ_hom : σ_x ≫ U.hom = 𝟙 S_K := by
        dsimp [σ_x]
        rw [Category.assoc, ← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp, hχ_comp,
          AlgebraicGeometry.Spec.map_id]
      have hEt_σ : AlgebraicGeometry.Etale σ_x :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) σ_x U.hom U.prop
          (by rw [hσ_hom]; infer_instance)
      let f_x : T_K ⟶ U := CategoryTheory.MorphismProperty.Over.homMk σ_x hσ_hom
      have hf_pt : f_x.left.base (⊥ : PrimeSpectrum K) = x := by
        change j_V.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base
          (⊥ : PrimeSpectrum K)) = x
        have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base
            (⊥ : PrimeSpectrum K) = p_x := by
          apply PrimeSpectrum.ext
          rw [← hker_χ]
          ext b
          change χ b ∈ (⊥ : Ideal K) ↔ b ∈ RingHom.ker χ
          rw [Ideal.mem_bot, RingHom.mem_ker]
        rw [hpt_eq, hj_V_pt]
      exact ⟨f_x, hEt_σ, hf_pt⟩

    have hγ_inj : ∀ (K : Type u) [Field K] [IsAlgClosed K] (c : ZMod ℓ),
        γ (AlgebraicGeometry.Spec (CommRingCat.of K)) c = 0 → c = 0 := by
      intro K _ _ c hc0
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := mkTerm S_K
      let hT_K := hIsTerm S_K
      have hTopSieveTK : ∀ (R : CategoryTheory.Sieve T_K),
          R ∈ S_K.smallEtaleTopology T_K → R.arrows (𝟙 T_K) := by
        intro R hR
        obtain ⟨Y, f, y, hfR, _, _⟩ := (hMemEtale S_K T_K R).mp hR (⊥ : PrimeSpectrum K)
        obtain ⟨g, _, _⟩ := hCoverByTK K Y y
        have hgf : g ≫ f = 𝟙 T_K := hT_K.hom_ext _ _
        rw [← hgf]
        exact R.downward_closed hfR g
      let constAM : (S_K.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj AM
      let η_K := CategoryTheory.toSheafify S_K.smallEtaleTopology constAM
      let C_K := CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}
      have hInj_η : Function.Injective (η_K.app (Opposite.op T_K)) := by
        let Idx : S_K.Etale → Type u := fun V =>
          { σ : S_K ⟶ V.left // σ ≫ V.hom = 𝟙 S_K }
        let RK₀ : (S_K.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
          { obj := fun V_op => AddCommGrpCat.of (Idx V_op.unop → ↥AM)
            map := fun {V₁_op V₂_op} g_op =>
              AddCommGrpCat.ofHom
                { toFun := fun φ_idx τ =>
                    φ_idx ⟨τ.1 ≫ g_op.unop.left, by
                      erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w g_op.unop, τ.2]⟩
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
            map_id := fun _ => by
              apply AddCommGrpCat.ext; intro φ_idx; funext τ
              exact congrArg φ_idx (Subtype.ext (Category.comp_id τ.1))
            map_comp := fun f_op g_op => by
              apply AddCommGrpCat.ext; intro φ_idx; funext τ
              exact congrArg φ_idx
                (Subtype.ext (Category.assoc τ.1 g_op.unop.left f_op.unop.left).symm) }
        let id_idx : Idx T_K := ⟨𝟙 S_K, Category.id_comp _⟩
        have hIdxTK : ∀ τ : Idx T_K, τ = id_idx := fun ⟨τ, hτ⟩ =>
          Subtype.ext ((Category.comp_id τ).symm.trans hτ)
        have hRK_sheaf : CategoryTheory.Presheaf.IsSheaf S_K.smallEtaleTopology RK₀ := by
          intro E V R hR x hx
          let m_idx : ∀ {W : S_K.Etale}, Idx W → (T_K ⟶ W) :=
            fun τ => CategoryTheory.MorphismProperty.Over.homMk τ.1 τ.2
          have hm_mem : ∀ τ : Idx V, R.arrows (m_idx τ) := by
            intro τ
            have hpbR : R.pullback (m_idx τ) ∈ S_K.smallEtaleTopology T_K :=
              S_K.smallEtaleTopology.pullback_stable (m_idx τ) hR
            simpa [CategoryTheory.Sieve.pullback_apply] using hTopSieveTK _ hpbR
          let x_hom : ∀ τ : Idx V, E ⟶ AddCommGrpCat.of (Idx T_K → ↥AM) :=
            fun τ => x (m_idx τ) (hm_mem τ)
          let amalg : E ⟶ RK₀.obj (Opposite.op V) :=
            AddCommGrpCat.ofHom
              { toFun := fun e τ => ((x_hom τ).hom e) id_idx
                map_zero' := by ext τ; exact congrFun ((x_hom τ).hom.map_zero) id_idx
                map_add' := fun e₁ e₂ => by
                  ext τ; exact congrFun ((x_hom τ).hom.map_add e₁ e₂) id_idx }
          refine ⟨amalg, ?_, ?_⟩
          · intro W f_w hf
            apply AddCommGrpCat.ext; intro e; funext σ
            let fσ : Idx V := ⟨σ.1 ≫ f_w.left, by
              erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w f_w, σ.2]⟩
            have hcomp_eq : 𝟙 T_K ≫ m_idx fσ = m_idx σ ≫ f_w := by
              rw [Category.id_comp]
              exact CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
            have hx_raw := hx (𝟙 T_K) (m_idx σ) (hm_mem fσ) hf hcomp_eq
            have hx_val := congrFun (congrArg (fun (m : E ⟶ RK₀.obj (Opposite.op T_K)) =>
              m.hom e) hx_raw) id_idx
            dsimp [RK₀, amalg, x_hom, fσ] at hx_val ⊢
            have h1 : (⟨𝟙 S_K ≫ 𝟙 S_K,
                (congrArg (· ≫ T_K.hom) (Category.id_comp _)).trans id_idx.2⟩ : Idx T_K) = id_idx :=
              hIdxTK _
            have h2 : (⟨𝟙 S_K ≫ σ.1, (by erw [Category.assoc, σ.2])⟩ : Idx W) = σ :=
              Subtype.ext (Category.id_comp σ.1)
            erw [h1, h2] at hx_val
            exact hx_val
          · intro y hy
            apply AddCommGrpCat.ext; intro e; funext τ
            have hy_raw := hy (m_idx τ) (hm_mem τ)
            have hy_val := congrFun (congrArg (fun (m : E ⟶ RK₀.obj (Opposite.op T_K)) =>
              m.hom e) hy_raw) id_idx
            dsimp [RK₀, amalg, x_hom] at hy_val ⊢
            have h2 : (⟨𝟙 S_K ≫ τ.1, (by erw [Category.assoc, τ.2])⟩ : Idx V) = τ :=
              Subtype.ext (Category.id_comp τ.1)
            erw [h2] at hy_val
            exact hy_val
        let RK : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u} := ⟨RK₀, hRK_sheaf⟩
        let u_pre : constAM ⟶ RK.obj :=
          { app := fun _ => AddCommGrpCat.ofHom
              { toFun := fun a _ => a, map_zero' := rfl, map_add' := fun _ _ => rfl }
            naturality := fun _ _ _ => rfl }
        let adj_sh := CategoryTheory.sheafificationAdjunction S_K.smallEtaleTopology AddCommGrpCat.{u}
        let u_sh : C_K.obj AM ⟶ RK := (adj_sh.homEquiv constAM RK).symm u_pre
        have hηu : η_K ≫ u_sh.hom = u_pre :=
          (adj_sh.homEquiv constAM RK).apply_symm_apply u_pre
        intro a₁ a₂ ha_eq
        have h1 := congrArg (fun m => (u_sh.hom.app (Opposite.op T_K) m) id_idx) ha_eq
        have h_eval : ∀ a : ↥AM,
            (u_sh.hom.app (Opposite.op T_K) (η_K.app (Opposite.op T_K) a)) id_idx = a :=
          fun a => congrArg (fun ν : constAM ⟶ RK.obj => (ν.app (Opposite.op T_K) a) id_idx) hηu
        rwa [h_eval a₁, h_eval a₂] at h1
      have hmap_c0 : C_K.map (c_hom c) = 0 := by
        have h1 := congrArg CategoryTheory.Abelian.Ext.addEquiv₀ hc0
        rw [map_zero] at h1
        change CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (C_K.map (c_hom c))) = 0 at h1
        rwa [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply] at h1
      let adj_CK := CategoryTheory.constantSheafAdj S_K.smallEtaleTopology AddCommGrpCat.{u} hT_K
      have hnat_c : c_hom c ≫ adj_CK.unit.app AM =
          adj_CK.unit.app Aℤ ≫ (C_K.map (c_hom c)).hom.app (Opposite.op T_K) :=
        adj_CK.unit.naturality (c_hom c)
      rw [hmap_c0] at hnat_c
      have hval := congrArg (fun (φ : Aℤ ⟶ (C_K.obj AM).obj.obj (Opposite.op T_K)) =>
        φ (ULift.up (1 : ℤ))) hnat_c
      have hval0 : (η_K.app (Opposite.op T_K)) (ULift.up c) = 0 := by
        have hc1 : (c_hom c) (ULift.up (1 : ℤ)) = ULift.up c := by
          change ULift.up ((1 : ℤ) • c) = ULift.up c
          rw [one_zsmul]
        have hlhs : (c_hom c ≫ adj_CK.unit.app AM) (ULift.up (1 : ℤ)) =
            (η_K.app (Opposite.op T_K)) (ULift.up c) := by
          change (adj_CK.unit.app AM) ((c_hom c) (ULift.up (1 : ℤ))) = _
          rw [hc1]
          rfl
        rw [hlhs] at hval
        exact hval.trans rfl
      have hup0 : (ULift.up c : ↥AM) = 0 :=
        hInj_η (hval0.trans (η_K.app (Opposite.op T_K)).hom.map_zero.symm)
      exact congrArg ULift.down hup0

    let secOf : ∀ {W : AlgebraicGeometry.Scheme.{u}},
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶
          (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj AM) →
        ↥(((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj AM).obj.obj
          (Opposite.op (mkTerm W))) :=
      fun {W} δ =>
        (((CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u}
          (hIsTerm W)).homEquiv Aℤ _) δ) (ULift.up (1 : ℤ))

    have hSecZeroIff : ∀ {W : AlgebraicGeometry.Scheme.{u}}
        (δ : (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶
          (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj AM),
        secOf δ = 0 ↔ δ = 0 := by
      intro W δ
      let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
      let adj_W := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} (hIsTerm W)
      constructor
      · intro hs0
        apply (adj_W.homEquiv Aℤ (C_W.obj AM)).injective
        have hzero_rhs : (adj_W.homEquiv Aℤ (C_W.obj AM)) 0 = 0 := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        rw [hzero_rhs]
        apply AddCommGrpCat.ext
        rintro ⟨z⟩
        have hz_eq : (⟨z⟩ : ULift.{u} ℤ) = z • ULift.up (1 : ℤ) := by
          ext; change z = z * 1; ring
        change ((adj_W.homEquiv Aℤ (C_W.obj AM)) δ) ⟨z⟩ = 0
        rw [hz_eq, map_zsmul]
        change z • secOf δ = 0
        rw [hs0, zsmul_zero]
      · rintro rfl
        dsimp [secOf]
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        rfl

    have hSecSub : ∀ {W : AlgebraicGeometry.Scheme.{u}}
        (α β : (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶
          (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj AM),
        secOf (α - β) = secOf α - secOf β := by
      intro W α β
      dsimp [secOf]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit]
      rfl

    have hSecConst : ∀ (W : AlgebraicGeometry.Scheme.{u}) (c : ZMod ℓ),
        secOf ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).map
          (c_hom c)) =
        ((CategoryTheory.toSheafify W.smallEtaleTopology
          ((CategoryTheory.Functor.const _).obj AM)).app (Opposite.op (mkTerm W)))
          (ULift.up c) := by
      intro W c
      let adj_W := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} (hIsTerm W)
      dsimp [secOf]
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      have hnat := adj_W.unit.naturality (c_hom c)
      have hval := congrArg (fun φ => φ (ULift.up (1 : ℤ))) hnat.symm
      refine hval.trans ?_
      change (adj_W.unit.app AM) (ULift.up ((1 : ℤ) • c)) = _
      rw [one_zsmul]
      rfl

    have hDiagZero : ∀ {W : AlgebraicGeometry.Scheme.{u}}
        (δ : (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶
          (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj AM)
        (E : W.Etale)
        (p_u : weilEtaleTorsionH W ℓ 0 →+ weilEtaleTorsionH E.left ℓ 0),
        WeilIsTorsionEtalePullback E.hom ℓ 0 p_u →
        (((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj AM).obj.map
          ((hIsTerm W).from E).op) (secOf δ) = 0 →
        p_u (CategoryTheory.Abelian.Ext.mk₀ δ) = 0 := by
      intro W δ E p_u hp_u hs_E0
      let Y := E.left
      let u := E.hom
      have _ : AlgebraicGeometry.Etale u := E.prop
      let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) u :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
      rcases hp_u with ⟨hc, hr, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, _, _, hp_eq⟩
      let B_u : CategoryTheory.Functor W.Etale Y.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ u
      let J_Y := Y.smallEtaleTopology
      let J_W := W.smallEtaleTopology
      let C_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
      let C_W := CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}
      let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B_u AddCommGrpCat.{u} _ J_W J_Y hc
      let P_pull := @CategoryTheory.Functor.sheafPullback _ _ _ _ B_u AddCommGrpCat.{u} _ J_W J_Y hc hr
      let adj_pull := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B_u AddCommGrpCat.{u} _ J_W J_Y hc hr
      let adj₁ := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT₂
      let τ : B_u.obj T₂ ⟶ T₁ := hT₁.from (B_u.obj T₂)
      let ρM : C_W.obj AM ⟶ P_push.obj (C_Y.obj AM) :=
        (adj₂.homEquiv AM (P_push.obj (C_Y.obj AM))).symm
          (adj₁.unit.app AM ≫ (C_Y.obj AM).obj.map τ.op)
      let πM : P_pull.obj (C_W.obj AM) ⟶ C_Y.obj AM :=
        (adj_pull.homEquiv (C_W.obj AM) (C_Y.obj AM)).symm ρM
      have _ : P_pull.Additive := hAdd
      have _ : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
      have _ : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
      have _ : P_pull.PreservesHomology := inferInstance
      rw [hp_eq (CategoryTheory.Abelian.Ext.mk₀ δ)]
      change (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C_Y.obj Aℤ) (Nat.add_zero 0)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C_W.obj Aℤ) (C_W.obj AM) 0) (CategoryTheory.Abelian.Ext.mk₀ δ))
          (Nat.zero_add 0)) = 0
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      change ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ P_pull.map δ)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 0)) = 0
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
      suffices h0 : P_pull.map δ ≫ πM = 0 by
        rw [h0, CategoryTheory.Limits.comp_zero, CategoryTheory.Abelian.Ext.mk₀_zero]
      apply (adj_pull.homEquiv (C_W.obj Aℤ) (C_Y.obj AM)).injective
      have hzero_pull : (adj_pull.homEquiv (C_W.obj Aℤ) (C_Y.obj AM)) 0 = 0 := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        apply CategoryTheory.Sheaf.hom_ext
        rfl
      rw [hzero_pull, CategoryTheory.Adjunction.homEquiv_naturality_left]
      dsimp [πM]
      rw [Equiv.apply_symm_apply]
      apply (adj₂.homEquiv Aℤ (P_push.obj (C_Y.obj AM))).injective
      have hzero_adj₂ : (adj₂.homEquiv Aℤ (P_push.obj (C_Y.obj AM))) 0 = 0 := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      rw [hzero_adj₂, CategoryTheory.Adjunction.homEquiv_unit]
      apply AddCommGrpCat.ext
      rintro ⟨z⟩
      have hz_eq : (⟨z⟩ : ULift.{u} ℤ) = z • ULift.up (1 : ℤ) := by
        ext; change z = z * 1; ring
      change (adj₂.unit.app Aℤ ≫ (δ ≫ ρM).hom.app (Opposite.op T₂)) ⟨z⟩ = 0
      rw [hz_eq, map_zsmul]
      suffices ht0 : (ρM.hom.app (Opposite.op T₂))
          ((δ.hom.app (Opposite.op T₂)) ((adj₂.unit.app Aℤ) (ULift.up (1 : ℤ)))) = 0 by
        change z • (ρM.hom.app (Opposite.op T₂))
          ((δ.hom.app (Opposite.op T₂)) ((adj₂.unit.app Aℤ) (ULift.up (1 : ℤ)))) = 0
        rw [ht0, zsmul_zero]
      set s_T₂ := (δ.hom.app (Opposite.op T₂)) ((adj₂.unit.app Aℤ) (ULift.up (1 : ℤ)))
      set t_sec : ↥((C_Y.obj AM).obj.obj (Opposite.op (B_u.obj T₂))) :=
        (ρM.hom.app (Opposite.op T₂)) s_T₂
      let e_T : T₂ ⟶ mkTerm W := (hIsTerm W).from T₂
      have hs_T₂_eq : s_T₂ = ((C_W.obj AM).obj.map e_T.op) (secOf δ) := by
        let η_Z := CategoryTheory.toSheafify J_W ((CategoryTheory.Functor.const _).obj Aℤ)
        have hη_nat := congrArg (fun φ => φ (ULift.up (1 : ℤ))) (η_Z.naturality e_T.op)
        dsimp [η_Z] at hη_nat
        have hδ_nat := congrArg (fun φ => φ (((CategoryTheory.constantSheafAdj J_W
          AddCommGrpCat.{u} (hIsTerm W)).unit.app Aℤ) (ULift.up (1 : ℤ)))) (δ.hom.naturality e_T.op)
        dsimp [s_T₂, secOf]
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        exact (congrArg (δ.hom.app (Opposite.op T₂)) hη_nat).trans hδ_nat
      let g_ET₂ : E ⟶ T₂ := hT₂.from E
      have hs_E_T₂ : ((C_W.obj AM).obj.map g_ET₂.op) s_T₂ = 0 := by
        rw [hs_T₂_eq]
        have hcomp_T : g_ET₂ ≫ e_T = (hIsTerm W).from E := (hIsTerm W).hom_ext _ _
        have h1 : ((C_W.obj AM).obj.map g_ET₂.op) (((C_W.obj AM).obj.map e_T.op) (secOf δ)) =
            ((C_W.obj AM).obj.map (g_ET₂ ≫ e_T).op) (secOf δ) := by
          rw [op_comp, (C_W.obj AM).obj.map_comp]
          rfl
        rw [h1, hcomp_T]
        exact hs_E0
      have ht_BE : ((C_Y.obj AM).obj.map (B_u.map g_ET₂).op) t_sec = 0 := by
        have hρ_nat := congrArg (fun φ => φ s_T₂) (ρM.hom.naturality g_ET₂.op).symm
        change ((C_Y.obj AM).obj.map (B_u.map g_ET₂).op) t_sec =
          (ρM.hom.app (Opposite.op E)) (((C_W.obj AM).obj.map g_ET₂.op) s_T₂) at hρ_nat
        rw [hs_E_T₂, map_zero] at hρ_nat
        exact hρ_nat
      let T_Y := mkTerm Y
      let hT_Y := hIsTerm Y
      let Δ_mor : Y ⟶ (B_u.obj E).left :=
        CategoryTheory.Limits.pullback.lift (𝟙 Y) (𝟙 Y) rfl
      let Δ_tilde : T_Y ⟶ B_u.obj E :=
        CategoryTheory.MorphismProperty.Over.homMk Δ_mor
          (CategoryTheory.Limits.pullback.lift_snd (𝟙 Y) (𝟙 Y) rfl)
      have _ : CategoryTheory.Limits.PreservesFiniteLimits B_u :=
        CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
          (@AlgebraicGeometry.Etale) u
      have hBT₂ : CategoryTheory.Limits.IsTerminal (B_u.obj T₂) :=
        CategoryTheory.Limits.IsTerminal.isTerminalObj B_u T₂ hT₂
      let ψ_inv : B_u.obj T₂ ⟶ T_Y := hT_Y.from (B_u.obj T₂)
      have hret : (ψ_inv ≫ Δ_tilde) ≫ B_u.map g_ET₂ = 𝟙 (B_u.obj T₂) :=
        hBT₂.hom_ext _ _
      have ht_id : ((C_Y.obj AM).obj.map ((ψ_inv ≫ Δ_tilde) ≫ B_u.map g_ET₂).op) t_sec = t_sec := by
        rw [hret, op_id, (C_Y.obj AM).obj.map_id]
        rfl
      rw [← ht_id, op_comp, (C_Y.obj AM).obj.map_comp]
      change ((C_Y.obj AM).obj.map (ψ_inv ≫ Δ_tilde).op)
        (((C_Y.obj AM).obj.map (B_u.map g_ET₂).op) t_sec) = 0
      rw [ht_BE, map_zero]

    have hLocConst : ∀ (V : AlgebraicGeometry.Scheme.{u}) (ξ : weilEtaleTorsionH V ℓ 0) (y : ↥V),
        ∃ (W' : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W')
          (u : W' ⟶ V) (_ : AlgebraicGeometry.Etale u) (c : ZMod ℓ),
          y ∈ Set.range u.base ∧
          ∀ (p_u : weilEtaleTorsionH V ℓ 0 →+ weilEtaleTorsionH W' ℓ 0),
            WeilIsTorsionEtalePullback u ℓ 0 p_u → p_u ξ = γ W' c := by
      intro V ξ y
      let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
      let T_V := mkTerm V
      let hT_V := hIsTerm V
      let f := CategoryTheory.Abelian.Ext.addEquiv₀ ξ
      have hf_mk : CategoryTheory.Abelian.Ext.mk₀ f = ξ :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply ξ
      let constAM_V : (V.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj AM
      let η_V := CategoryTheory.toSheafify V.smallEtaleTopology constAM_V
      have _ : CategoryTheory.Presheaf.IsLocallySurjective V.smallEtaleTopology η_V := inferInstance
      have hImgMem : CategoryTheory.Presheaf.imageSieve η_V (secOf f) ∈
          V.smallEtaleTopology T_V :=
        CategoryTheory.Presheaf.imageSieve_mem V.smallEtaleTopology η_V (secOf f)
      obtain ⟨E, g, z, ⟨c_up, hc_eq⟩, hEt_g, hgz⟩ :=
        (hMemEtale V T_V (CategoryTheory.Presheaf.imageSieve η_V (secOf f))).mp hImgMem y
      have _ : AlgebraicGeometry.Etale E.hom := E.prop
      obtain ⟨W₀, hAff_W₀, hz_W₀, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := z) (U := (⊤ : E.left.Opens)) trivial
      let W' := W₀.toScheme
      have hAff_W' : AlgebraicGeometry.IsAffine W' := hAff_W₀
      let u : W' ⟶ V := W₀.ι ≫ E.hom
      have hEt_u : AlgebraicGeometry.Etale u := inferInstance
      let c : ZMod ℓ := c_up.down
      have hc_up : ULift.up c = c_up := rfl
      have hy_range : y ∈ Set.range u.base := by
        refine ⟨⟨z, hz_W₀⟩, ?_⟩
        have hg_hom : g.left = E.hom :=
          (Category.comp_id g.left).symm.trans (CategoryTheory.MorphismProperty.Over.w g)
        change E.hom.base z = y
        exact (congrArg (fun (m : E.left ⟶ V) => m.base z) hg_hom.symm).trans hgz
      refine ⟨W', hAff_W', u, hEt_u, c, hy_range, fun p_u hp_u => ?_⟩
      let E' : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ u hEt_u
      let h_E : E' ⟶ E := CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl
      let δ := f - C_V.map (c_hom c)
      have hs_E'_zero : ((C_V.obj AM).obj.map (hT_V.from E').op) (secOf δ) = 0 := by
        have hfrom_eq : hT_V.from E' = h_E ≫ g := hT_V.hom_ext _ _
        rw [hfrom_eq, op_comp, (C_V.obj AM).obj.map_comp]
        change ((C_V.obj AM).obj.map h_E.op) (((C_V.obj AM).obj.map g.op) (secOf δ)) = 0
        have hs_E_zero : ((C_V.obj AM).obj.map g.op) (secOf δ) = 0 := by
          rw [hSecSub f (C_V.map (c_hom c)), map_sub, hSecConst V c, hc_up]
          have hη_nat : ((C_V.obj AM).obj.map g.op) ((η_V.app (Opposite.op T_V)) c_up) =
              (η_V.app (Opposite.op E)) c_up :=
            (congrArg (fun φ => φ c_up) (η_V.naturality g.op)).symm
          exact sub_eq_zero.mpr (hc_eq.symm.trans hη_nat.symm)
        rw [hs_E_zero, map_zero]
      have hp_δ0 := hDiagZero δ E' p_u hp_u hs_E'_zero
      have hmk_sub : CategoryTheory.Abelian.Ext.mk₀ δ = ξ - γ V c := by
        dsimp [δ, γ]
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, map_sub,
          CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
          CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, hf_mk]
      have hp_sub : p_u ξ - p_u (γ V c) = 0 :=
        (p_u.map_sub ξ (γ V c)).symm.trans ((congrArg p_u hmk_sub).symm.trans hp_δ0)
      exact (sub_eq_zero.mp hp_sub).trans (hγ_pull u p_u hp_u c)

    have hSep : ∀ (W : AlgebraicGeometry.Scheme.{u}) (ξ : weilEtaleTorsionH W ℓ 0),
        (∀ y : ↥W, ∃ (V : AlgebraicGeometry.Scheme.{u}) (u : V ⟶ W),
          AlgebraicGeometry.Etale u ∧ y ∈ Set.range u.base ∧
          ∃ (p_u : weilEtaleTorsionH W ℓ 0 →+ weilEtaleTorsionH V ℓ 0),
            WeilIsTorsionEtalePullback u ℓ 0 p_u ∧ p_u ξ = 0) →
        ξ = 0 := by
      intro W ξ hLocZero
      let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
      let T_W := mkTerm W
      let hT_W := hIsTerm W
      let f := CategoryTheory.Abelian.Ext.addEquiv₀ ξ
      have hf_mk : CategoryTheory.Abelian.Ext.mk₀ f = ξ :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply ξ
      suffices hsf0 : secOf f = 0 by
        have hf0 : f = 0 := (hSecZeroIff f).mp hsf0
        rw [← hf_mk, hf0, CategoryTheory.Abelian.Ext.mk₀_zero]
      let R₀ : CategoryTheory.Sieve T_W :=
        { arrows := fun E _ =>
            ∃ (p_E : weilEtaleTorsionH W ℓ 0 →+ weilEtaleTorsionH E.left ℓ 0),
              WeilIsTorsionEtalePullback E.hom ℓ 0 p_E ∧ p_E ξ = 0
          downward_closed := fun {E E'} _ ⟨p_E, hp_E, hp_E0⟩ h_mor => by
            obtain ⟨p_h, hp_h⟩ := hPullEx0 h_mor.left
            obtain ⟨p_E', hp_E'⟩ := hPullEx0 E'.hom
            have hcomp_hom : h_mor.left ≫ E.hom = E'.hom :=
              CategoryTheory.MorphismProperty.Over.w h_mor
            have hp_eq := hPullComp0 h_mor.left E.hom p_h p_E p_E' hp_h hp_E
              (by rwa [hcomp_hom])
            refine ⟨p_E', hp_E', ?_⟩
            rw [hp_eq, AddMonoidHom.comp_apply, hp_E0, map_zero] }
      have hR₀_mem : R₀ ∈ W.smallEtaleTopology T_W := by
        refine (hMemEtale W T_W R₀).mpr fun y => ?_
        obtain ⟨V_y, u_y, hu_et, ⟨v_pt, hv_pt⟩, p_y, hp_y, hp_y0⟩ := hLocZero y
        let E_y : W.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ u_y hu_et
        let g_y : E_y ⟶ T_W :=
          CategoryTheory.MorphismProperty.Over.homMk u_y (Category.comp_id u_y)
        exact ⟨E_y, g_y, v_pt, ⟨p_y, hp_y, hp_y0⟩, hu_et, hv_pt⟩
      apply hSheafZero (C_W.obj AM) T_W R₀ hR₀_mem (secOf f)
      intro E g hg_R₀
      let s_E := ((C_W.obj AM).obj.map g.op) (secOf f)
      let constAM_W : (W.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj AM
      let η_W := CategoryTheory.toSheafify W.smallEtaleTopology constAM_W
      have _ : CategoryTheory.Presheaf.IsLocallySurjective W.smallEtaleTopology η_W := inferInstance
      have hImg_E : CategoryTheory.Presheaf.imageSieve η_W s_E ∈ W.smallEtaleTopology E :=
        CategoryTheory.Presheaf.imageSieve_mem W.smallEtaleTopology η_W s_E
      apply hSheafZero (C_W.obj AM) E (CategoryTheory.Presheaf.imageSieve η_W s_E) hImg_E s_E
      intro E' h_mor ⟨c_up, hc_eq⟩
      by_cases hne_E' : Nonempty ↥E'.left
      · obtain ⟨z'⟩ := hne_E'
        let c : ZMod ℓ := c_up.down
        have hc_up : ULift.up c = c_up := rfl
        let Y' : AlgebraicGeometry.Scheme.{u} := E'.left
        let u' : Y' ⟶ W := E'.hom
        obtain ⟨p_E', hp_E', hp_E'0⟩ :
            ∃ (p_E' : weilEtaleTorsionH W ℓ 0 →+ weilEtaleTorsionH Y' ℓ 0),
              WeilIsTorsionEtalePullback u' ℓ 0 p_E' ∧ p_E' ξ = 0 :=
          R₀.downward_closed hg_R₀ h_mor
        let δ := f - C_W.map (c_hom c)
        let g' : E' ⟶ T_W := hT_W.from E'
        have hs_E'_zero : ((C_W.obj AM).obj.map g'.op) (secOf δ) = 0 := by
          rw [hSecSub f (C_W.map (c_hom c)), map_sub, hSecConst W c, hc_up]
          have hg'_eq : h_mor ≫ g = g' := hT_W.hom_ext _ _
          have hmap_comp : ((C_W.obj AM).obj.map g'.op) (secOf f) =
              ((C_W.obj AM).obj.map h_mor.op) s_E := by
            rw [← hg'_eq, op_comp, (C_W.obj AM).obj.map_comp]
            rfl
          have hη_nat : ((C_W.obj AM).obj.map g'.op) ((η_W.app (Opposite.op T_W)) c_up) =
              (η_W.app (Opposite.op E')) c_up :=
            (congrArg (fun φ => φ c_up) (η_W.naturality g'.op)).symm
          exact sub_eq_zero.mpr (hmap_comp.trans (hc_eq.symm.trans hη_nat.symm))
        have hp_δ0 := hDiagZero δ E' p_E' hp_E' hs_E'_zero
        have hmk_sub : CategoryTheory.Abelian.Ext.mk₀ δ = ξ - γ W c := by
          dsimp [δ, γ]
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, map_sub,
            CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
            CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, hf_mk]
        rw [hmk_sub, map_sub, hp_E'0, zero_sub, neg_eq_zero,
          hγ_pull u' p_E' hp_E' c] at hp_δ0
        let K_z : Type u := AlgebraicClosure ↥(E'.left.residueField z')
        let z_bar : AlgebraicGeometry.Spec (CommRingCat.of K_z) ⟶ E'.left :=
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥(E'.left.residueField z') K_z)) ≫
            E'.left.fromSpecResidueField z'
        obtain ⟨p_z, hp_z⟩ := hPullEx0 z_bar
        have hγ_Kz : γ (AlgebraicGeometry.Spec (CommRingCat.of K_z)) c = 0 := by
          rw [← hγ_pull z_bar p_z hp_z c, hp_δ0, map_zero]
        have hc0 : c = 0 := hγ_inj K_z c hγ_Kz
        have hcup0 : c_up = 0 := by
          rw [← hc_up, hc0]
          rfl
        exact hc_eq.symm.trans
          ((congrArg (η_W.app (Opposite.op E')) hcup0).trans
            (η_W.app (Opposite.op E')).hom.map_zero)
      · rw [not_nonempty_iff] at hne_E'
        have hBot : (⊥ : CategoryTheory.Sieve E') ∈ W.smallEtaleTopology E' :=
          (hMemEtale W E' ⊥).mpr (fun x => IsEmpty.elim hne_E' x)
        exact hSheafZero (C_W.obj AM) E' ⊥ hBot (((C_W.obj AM).obj.map h_mor.op) s_E)
          (fun _ hbot => False.elim hbot)

    intro X X_U j hCov W _ w _ ψ₀ hψ₀
    let W_U := CategoryTheory.Limits.pullback j w
    let j_W := CategoryTheory.Limits.pullback.snd j w
    rw [injective_iff_map_eq_zero]
    intro ξ hξ0
    apply hSep W ξ
    intro y
    obtain ⟨O, hy_O, hO_cases⟩ := hCov (w.base y)
    have hy_pre : y ∈ (TopologicalSpace.Opens.map w.base).obj O := hy_O
    obtain ⟨V_a, hAff_Va, hy_Va, hVa_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := y) (U := (TopologicalSpace.Opens.map w.base).obj O) hy_pre
    have hRange_Va : Set.range (V_a.ι ≫ w).base ⊆ Set.range O.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨pt, rfl⟩
      exact hVa_sub pt.2
    let v_a : V_a.toScheme ⟶ O.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O.ι (V_a.ι ≫ w) hRange_Va
    have hv_a : v_a ≫ O.ι = V_a.ι ≫ w :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι (V_a.ι ≫ w) hRange_Va
    have _ : AlgebraicGeometry.IsAffine V_a.toScheme := hAff_Va
    have _ : AlgebraicGeometry.Etale v_a :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) v_a O.ι
        (inferInstance : AlgebraicGeometry.Etale O.ι)
        (by rw [hv_a]; infer_instance)
    obtain ⟨p_Va, hp_Va⟩ := hPullEx0 V_a.ι
    rcases hO_cases with hO_ne | hO_inj
    · obtain ⟨W', hAff_W', u, hEt_u, c, ⟨y', hy'⟩, hu_const⟩ :=
        hLocConst V_a.toScheme (p_Va ξ) ⟨y, hy_Va⟩
      have _ : AlgebraicGeometry.IsAffine W' := hAff_W'
      have _ : AlgebraicGeometry.Etale u := hEt_u
      let u_W : W' ⟶ W := u ≫ V_a.ι
      have _ : AlgebraicGeometry.Etale u_W := by dsimp [u_W]; infer_instance
      have hy_uW : y ∈ Set.range u_W.base := by
        refine ⟨y', ?_⟩
        change V_a.ι.base (u.base y') = y
        rw [hy']
        rfl
      obtain ⟨p_u, hp_u⟩ := hPullEx0 u
      obtain ⟨p_uW, hp_uW⟩ := hPullEx0 u_W
      have hp_uW_eq : p_uW = p_u.comp p_Va :=
        hPullComp0 u V_a.ι p_u p_Va p_uW hp_u hp_Va hp_uW
      have hp_uW_ξ : p_uW ξ = γ W' c := by
        rw [hp_uW_eq, AddMonoidHom.comp_apply, hu_const p_u hp_u]
      obtain ⟨q₀⟩ := hO_ne W' (u ≫ v_a) ⟨y'⟩
      let P' := CategoryTheory.Limits.pullback j ((u ≫ v_a) ≫ O.ι)
      let K' : Type u := AlgebraicClosure ↥(P'.residueField q₀)
      let S_K' := AlgebraicGeometry.Spec (CommRingCat.of K')
      let q_bar : S_K' ⟶ P' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(P'.residueField q₀) K')) ≫
          P'.fromSpecResidueField q₀
      let fst_P' := CategoryTheory.Limits.pullback.fst j ((u ≫ v_a) ≫ O.ι)
      let snd_P' := CategoryTheory.Limits.pullback.snd j ((u ≫ v_a) ≫ O.ι)
      have hP'_cond : (q_bar ≫ fst_P') ≫ j = ((q_bar ≫ snd_P') ≫ u_W) ≫ w := by
        rw [Category.assoc q_bar fst_P' j, CategoryTheory.Limits.pullback.condition,
          Category.assoc (q_bar ≫ snd_P') u_W w]
        dsimp [u_W]
        rw [Category.assoc u V_a.ι w, ← hv_a, ← Category.assoc u v_a O.ι, Category.assoc q_bar]
      let Φ' : S_K' ⟶ W_U :=
        CategoryTheory.Limits.pullback.lift (q_bar ≫ fst_P') ((q_bar ≫ snd_P') ≫ u_W) hP'_cond
      have hΦ'_snd : Φ' ≫ j_W = (q_bar ≫ snd_P') ≫ u_W :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      obtain ⟨p_qW', hp_qW'⟩ := hPullEx0 (q_bar ≫ snd_P')
      obtain ⟨p_Φ', hp_Φ'⟩ := hPullEx0 Φ'
      obtain ⟨p_tot, hp_tot⟩ := hPullEx0 ((q_bar ≫ snd_P') ≫ u_W)
      have htot1 : p_tot = p_qW'.comp p_uW :=
        hPullComp0 (q_bar ≫ snd_P') u_W p_qW' p_uW p_tot hp_qW' hp_uW hp_tot
      have htot2 : p_tot = p_Φ'.comp ψ₀ :=
        hPullComp0 Φ' j_W p_Φ' ψ₀ p_tot hp_Φ' hψ₀ (by rwa [hΦ'_snd])
      have hγ_K'0 : γ S_K' c = 0 := by
        calc γ S_K' c
            = p_qW' (γ W' c) := (hγ_pull (q_bar ≫ snd_P') p_qW' hp_qW' c).symm
          _ = p_qW' (p_uW ξ) := by rw [← hp_uW_ξ]
          _ = p_tot ξ := by rw [htot1]; rfl
          _ = p_Φ' (ψ₀ ξ) := by rw [htot2]; rfl
          _ = 0 := by rw [hξ0, map_zero]
      have hc0 : c = 0 := hγ_inj K' c hγ_K'0
      refine ⟨W', u_W, inferInstance, hy_uW, p_uW, hp_uW, ?_⟩
      rw [hp_uW_ξ, hc0, map_zero]
    · let P₁ := CategoryTheory.Limits.pullback j (v_a ≫ O.ι)
      let fst₁ := CategoryTheory.Limits.pullback.fst j (v_a ≫ O.ι)
      let snd₁ := CategoryTheory.Limits.pullback.snd j (v_a ≫ O.ι)
      have hP₁_cond : fst₁ ≫ j = (snd₁ ≫ V_a.ι) ≫ w := by
        rw [Category.assoc, ← hv_a]
        exact CategoryTheory.Limits.pullback.condition
      let Φ_a : P₁ ⟶ W_U :=
        CategoryTheory.Limits.pullback.lift fst₁ (snd₁ ≫ V_a.ι) hP₁_cond
      have hΦ_a_snd : Φ_a ≫ j_W = snd₁ ≫ V_a.ι :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      obtain ⟨q₁, hq₁⟩ := hPullEx0 snd₁
      obtain ⟨q_Φ, hq_Φ⟩ := hPullEx0 Φ_a
      obtain ⟨q_tot, hq_tot⟩ := hPullEx0 (snd₁ ≫ V_a.ι)
      have htot1 : q_tot = q₁.comp p_Va :=
        hPullComp0 snd₁ V_a.ι q₁ p_Va q_tot hq₁ hp_Va hq_tot
      have htot2 : q_tot = q_Φ.comp ψ₀ :=
        hPullComp0 Φ_a j_W q_Φ ψ₀ q_tot hq_Φ hψ₀ (by rwa [hΦ_a_snd])
      have hq₁_zero : q₁ (p_Va ξ) = 0 := by
        calc q₁ (p_Va ξ)
            = q_tot ξ := by rw [htot1]; rfl
          _ = q_Φ (ψ₀ ξ) := by rw [htot2]; rfl
          _ = 0 := by rw [hξ0, map_zero]
      have hp_Va0 : p_Va ξ = 0 :=
        (hO_inj V_a.toScheme v_a q₁ hq₁) (hq₁_zero.trans (map_zero q₁).symm)
      refine ⟨V_a.toScheme, V_a.ι, inferInstance, ⟨⟨y, hy_Va⟩, rfl⟩, p_Va, hp_Va, hp_Va0⟩

