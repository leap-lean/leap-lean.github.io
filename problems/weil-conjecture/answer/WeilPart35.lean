            fun _ => inferInstance, (AlgEquiv.funUnique K₁ PUnit.{u + 1} K₂).symm,
            fun _ => ⟨inferInstance, hSep⟩⟩
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)

    have hCubeStep : ∀ {C_t1 C_t C_b1 C_b U_t Z_t U_b Z_b : AlgebraicGeometry.Scheme.{u}}
        (fst_t : C_t1 ⟶ C_t) (snd_t : C_t1 ⟶ U_t) (hom_t : C_t ⟶ Z_t) (wt : U_t ⟶ Z_t)
        (fst_b : C_b1 ⟶ C_b) (snd_b : C_b1 ⟶ U_b) (hom_b : C_b ⟶ Z_b) (wb : U_b ⟶ Z_b)
        (pC : C_t ⟶ C_b) (pU : U_t ⟶ U_b) (pZ : Z_t ⟶ Z_b) (pC1 : C_t1 ⟶ C_b1),
        CategoryTheory.IsPullback fst_t snd_t hom_t wt →
        CategoryTheory.IsPullback fst_b snd_b hom_b wb →
        CategoryTheory.IsPullback pC hom_t hom_b pZ →
        CategoryTheory.IsPullback pU wt wb pZ →
        pC1 ≫ fst_b = fst_t ≫ pC →
        pC1 ≫ snd_b = snd_t ≫ pU →
        CategoryTheory.IsPullback pC1 (fst_t ≫ hom_t) (fst_b ≫ hom_b) pZ := by
      intro C_t1 C_t C_b1 C_b U_t Z_t U_b Z_b
        fst_t snd_t hom_t wt fst_b snd_b hom_b wb pC pU pZ pC1
        hpb_t hpb_b hpb_C hpb_0 h_fst h_snd
      have h1 : CategoryTheory.IsPullback (fst_t ≫ pC) snd_t hom_b (wt ≫ pZ) :=
        hpb_t.paste_horiz hpb_C
      have h1' : CategoryTheory.IsPullback (pC1 ≫ fst_b) snd_t hom_b (pU ≫ wb) := by
        rwa [← h_fst, ← hpb_0.w] at h1
      have h2 : CategoryTheory.IsPullback pC1 snd_t snd_b pU :=
        CategoryTheory.IsPullback.of_right h1' h_snd hpb_b
      have h3 : CategoryTheory.IsPullback pC1 (snd_t ≫ wt) (snd_b ≫ wb) pZ :=
        h2.paste_vert hpb_0
      rwa [← hpb_t.w, ← hpb_b.w] at h3

    have hProjLast : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} {W V : S₀.Etale} (f : W ⟶ V) (p : ℕ),
