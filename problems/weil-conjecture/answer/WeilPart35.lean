        let E_et : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (j_E ≫ (Fgt.obj (U_aff.obj A₁.1)).hom) hEt_E
        let p_E : E_et ⟶ U_aff.obj A₁.1 :=
          CategoryTheory.MorphismProperty.Over.homMk j_E rfl
        have hA₁_u₁ : A₁.2.1 ≫ ubar₁ = A₂.2.1 := congrArg Subtype.val u₁.2
        have hA₁_u₂ : A₁.2.1 ≫ ubar₂ = A₂.2.1 := congrArg Subtype.val u₂.2
        have hlift_Δ : A₂.2.1 ≫ Δ = A₁.2.1 ≫ pair_u := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · simp only [Δ, pair_u, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.diagonal_fst,
              CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.comp_id, hA₁_u₁]
          · simp only [Δ, pair_u, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.diagonal_snd,
              CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, hA₁_u₂]
        let η_E : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ (Fgt.obj E_et).left :=
          CategoryTheory.Limits.pullback.lift A₂.2.1 A₁.2.1 hlift_Δ
        have hη_over : η_E ≫ (Fgt.obj E_et).hom = y₀ := by
