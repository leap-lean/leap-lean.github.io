                have hw₀ : geomLiftMap Z Ω₀ y₀ w₀ i₀.unop.2 = γ :=
                  Classical.choose_spec (Classical.choose_spec (hShrink opU.unop γ))
                change ((ℱ.obj.map w₀.op ≫
                  CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) i₀) ≫ _).hom s = _
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.colimit.ι_desc]
                have hnat := congrArg (fun k => k.hom s i₀.unop.2) (θ.hom.naturality w₀.op)
                dsimp at hnat ⊢
                exact hnat.trans (congrArg ((θ.hom.app opU).hom s) hw₀) }
          homEquiv_naturality_left_symm := fun {ℱ₁ ℱ₂ N} h θ => by
            apply CategoryTheory.Limits.colimit.hom_ext
            intro i
            dsimp [Stalk₀, F₁, F₂, F₃]
            rw [CategoryTheory.Limits.ι_colimMap_assoc,
              CategoryTheory.Limits.colimit.ι_desc,
              CategoryTheory.Limits.colimit.ι_desc]
            rfl
          homEquiv_naturality_right := fun {ℱ N₁ N₂} ψ g => by
            apply CategoryTheory.Sheaf.hom_ext
            ext opU s γ
            rfl }
    have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} Stalk₀ :=
      adj₀.leftAdjoint_preservesColimits
    have : CategoryTheory.Limits.PreservesFiniteColimits Stalk₀ := ⟨fun _ _ _ => inferInstance⟩
    have : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} F₁ :=
      (CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).rightAdjoint_preservesLimits
    have : CategoryTheory.Limits.PreservesFiniteLimits F₁ := ⟨fun _ _ _ => inferInstance⟩
    have : CategoryTheory.Limits.PreservesFiniteLimits F₂ := inferInstance
    have : CategoryTheory.Limits.PreservesFiniteLimits F₃ :=
      ⟨fun _ _ _ => CategoryTheory.Limits.filtered_colim_preservesFiniteLimits⟩
    have : CategoryTheory.Limits.PreservesFiniteLimits (F₂ ⋙ F₃) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits F₂ F₃
    have : CategoryTheory.Limits.PreservesFiniteLimits Stalk₀ :=
      CategoryTheory.Limits.comp_preservesFiniteLimits F₁ (F₂ ⋙ F₃)
    have : (singlePush Z Ω₀ y₀).Additive :=
      { map_add := fun {_ _} _ _ =>
          CategoryTheory.Sheaf.hom_ext <| NatTrans.ext <| funext fun _ =>
            AddCommGrpCat.ext fun _ => funext fun _ => rfl }
    have hAdd_S : Stalk₀.Additive := adj₀.left_adjoint_additive
    refine ⟨Stalk₀, adj₀, germ₀, hAdd_S, ‹_›, ‹_›, hgerm_nat, hgerm_map, ?_⟩
    intro ℱ U γ s hs0
    let i₀ := Classical.choose (hShrink U γ)
    let w₀ := Classical.choose (Classical.choose_spec (hShrink U γ))
    have hw₀ : geomLiftMap Z Ω₀ y₀ w₀ i₀.unop.2 = γ :=
      Classical.choose_spec (Classical.choose_spec (hShrink U γ))
    let D_ℱ : PtNhdᵒᵖ ⥤ AddCommGrpCat.{u} := stalkDiag ⋙ ℱ.obj
    have hrep : (CategoryTheory.Limits.colimit.ι D_ℱ i₀).hom ((ℱ.obj.map w₀.op).hom s) =
        (CategoryTheory.Limits.colimit.ι D_ℱ i₀).hom 0 := by
      rw [map_zero]
      exact hs0
    obtain ⟨j₀, u₁, u₂, hu_eq⟩ :=
      (CategoryTheory.Limits.Concrete.isColimit_rep_eq_iff_exists D_ℱ
        (CategoryTheory.Limits.colimit.isColimit D_ℱ)
        ((ℱ.obj.map w₀.op).hom s) (0 : ↑(D_ℱ.obj i₀))).mp hrep
    refine ⟨(stalkDiag.obj j₀).unop, (stalkDiag.map u₁).unop ≫ w₀, j₀.unop.2, ?_, ?_⟩
    · apply Subtype.ext
      have hu₁_val : j₀.unop.2.1 ≫ (Fgt.map (U_aff.map u₁.unop.1)).left = i₀.unop.2.1 :=
        congrArg Subtype.val u₁.unop.2
      change j₀.unop.2.1 ≫ (Fgt.map ((U_aff.map u₁.unop.1) ≫ w₀)).left = γ.1
      rw [Fgt.map_comp]
      change j₀.unop.2.1 ≫ ((Fgt.map (U_aff.map u₁.unop.1)).left ≫ (Fgt.map w₀).left) = γ.1
      rw [← CategoryTheory.Category.assoc, hu₁_val]
      exact congrArg Subtype.val hw₀
    · have h0_u₂ : (D_ℱ.map u₂).hom (0 : ↑(D_ℱ.obj i₀)) = 0 := map_zero _
      rw [h0_u₂] at hu_eq
      change (ℱ.obj.map (w₀.op ≫ ((stalkDiag.map u₁).unop).op)).hom s = 0
      rw [ℱ.obj.map_comp]
      exact hu_eq

  
  have hProdShortExact :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι : Type u)
        (Ω : ι → Type u) [∀ i, Field (Ω i)] [∀ i, IsAlgClosed (Ω i)]
        (y : ∀ i, AlgebraicGeometry.Spec (CommRingCat.of (Ω i)) ⟶ Z)
        (M₁ M₂ M₃ : ι → AddCommGrpCat.{u})
        (α : ∀ i : ι, M₁ i ⟶ M₂ i) (β : ∀ i : ι, M₂ i ⟶ M₃ i)
        (h0_i : ∀ i : ι, α i ≫ β i = 0),
        (∀ i : ι, (CategoryTheory.ShortComplex.mk (α i) (β i) (h0_i i)).ShortExact) →
        ∃ (h0_sh : prodSheafMap Z ι Ω y α ≫ prodSheafMap Z ι Ω y β = 0),
          (CategoryTheory.ShortComplex.mk
            (prodSheafMap Z ι Ω y α) (prodSheafMap Z ι Ω y β) h0_sh).ShortExact ∧
          ∀ (opU : (Z.Etale)ᵒᵖ),
            Function.Surjective (((prodSheafMap Z ι Ω y β).hom.app opU).hom) := by
    intro Z ι Ω _ _ y M₁ M₂ M₃ α β h0_i hSE_i
    let 𝒞_Z := CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    let _ : CategoryTheory.Abelian 𝒞_Z := inferInstance
    have hinj : ∀ i : ι, Function.Injective (α i).hom :=
      fun i => (AddCommGrpCat.mono_iff_injective (α i)).mp (hSE_i i).mono_f
    have hsurj : ∀ i : ι, Function.Surjective (β i).hom :=
      fun i => (AddCommGrpCat.epi_iff_surjective (β i)).mp (hSE_i i).epi_g
    have hker : ∀ (i : ι) (m₂ : ↑(M₂ i)), (β i).hom m₂ = 0 → ∃ m₁ : ↑(M₁ i), (α i).hom m₁ = m₂ := by
      intro i m₂ hm₂
      let φ_m₂ : AddCommGrpCat.of (ULift.{u} ℤ) ⟶ M₂ i := AddCommGrpCat.ofHom
        { toFun := fun z => z.down • m₂
          map_zero' := zero_zsmul m₂
          map_add' := fun z₁ z₂ => add_zsmul m₂ z₁.down z₂.down }
      have hφ_comp : φ_m₂ ≫ β i = φ_m₂ ≫ 0 := by
        rw [CategoryTheory.Limits.comp_zero]
        apply AddCommGrpCat.ext
        intro z
        change (β i).hom (z.down • m₂) = 0
        rw [map_zsmul, hm₂, zsmul_zero]
      let ψ := CategoryTheory.Limits.Fork.IsLimit.lift (hSE_i i).fIsKernel φ_m₂ hφ_comp
      have hψ := CategoryTheory.Limits.Fork.IsLimit.lift_ι' (hSE_i i).fIsKernel φ_m₂ hφ_comp
      refine ⟨ψ.hom (ULift.up 1), ?_⟩
      have hval := congrArg (fun k => k.hom (ULift.up 1)) hψ
      exact hval.trans (one_zsmul m₂)
    let f_mor := prodSheafMap Z ι Ω y α
    let g_mor := prodSheafMap Z ι Ω y β
    have h0_sh : f_mor ≫ g_mor = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      ext opU s i γ
      exact congrArg (fun k => k.hom (s i γ)) (h0_i i)
    have hmono_f : CategoryTheory.Mono f_mor := ⟨fun {K_sh} t₁ t₂ ht => by
      apply CategoryTheory.Sheaf.hom_ext
      ext opU k₀ i γ
      exact hinj i (congrFun (congrFun (congrArg (fun m => (m.hom.app opU).hom k₀) ht) i) γ)⟩
    have hsurj_g : ∀ opU : (Z.Etale)ᵒᵖ, Function.Surjective ((g_mor.hom.app opU).hom) := by
      intro opU s₃
      refine ⟨fun i γ => Classical.choose (hsurj i (s₃ i γ)), funext fun i => funext fun γ => ?_⟩
      exact Classical.choose_spec (hsurj i (s₃ i γ))
    refine ⟨h0_sh, hAbShortExactOfDesc f_mor g_mor h0_sh hmono_f ?_, hsurj_g⟩
    intro D u_mor hfu
    let liftSec : ∀ (opU : (Z.Etale)ᵒᵖ),
        ↑((prodSheaf Z ι Ω y M₃).obj.obj opU) → ↑((prodSheaf Z ι Ω y M₂).obj.obj opU) :=
      fun opU s₃ => Classical.choose (hsurj_g opU s₃)
    have hliftSec : ∀ (opU : (Z.Etale)ᵒᵖ) (s₃ : ↑((prodSheaf Z ι Ω y M₃).obj.obj opU)),
        (g_mor.hom.app opU).hom (liftSec opU s₃) = s₃ :=
      fun opU s₃ => Classical.choose_spec (hsurj_g opU s₃)
    have hu_indep : ∀ (opU : (Z.Etale)ᵒᵖ)
        (s₂ : ↑((prodSheaf Z ι Ω y M₂).obj.obj opU))
        (s₃ : ↑((prodSheaf Z ι Ω y M₃).obj.obj opU)),
        (g_mor.hom.app opU).hom s₂ = s₃ →
        (u_mor.hom.app opU).hom s₂ = (u_mor.hom.app opU).hom (liftSec opU s₃) := by
      intro opU s₂ s₃ hs₂
      let d := s₂ - liftSec opU s₃
      have hd_ker : ∀ (i : ι) (γ : GeomLifts Z (Ω i) (y i) opU.unop),
          (β i).hom (d i γ) = 0 := by
        intro i γ
        have hg_d : (g_mor.hom.app opU).hom d = 0 := by
          dsimp [d]
          rw [map_sub, hs₂, hliftSec opU s₃, sub_self]
        exact congrFun (congrFun hg_d i) γ
      let s₁ : ↑((prodSheaf Z ι Ω y M₁).obj.obj opU) :=
        fun i γ => Classical.choose (hker i (d i γ) (hd_ker i γ))
      have hfs₁ : (f_mor.hom.app opU).hom s₁ = d :=
        funext fun i => funext fun γ => Classical.choose_spec (hker i (d i γ) (hd_ker i γ))
      have hud : (u_mor.hom.app opU).hom d = 0 := by
        rw [← hfs₁]
        exact congrArg (fun m => (m.hom.app opU).hom s₁) hfu
      dsimp [d] at hud
      rw [map_sub] at hud
      exact sub_eq_zero.mp hud
    let v_mor : prodSheaf Z ι Ω y M₃ ⟶ D :=
      { hom :=
          { app := fun opU => AddCommGrpCat.ofHom
              { toFun := fun s₃ => (u_mor.hom.app opU).hom (liftSec opU s₃)
                map_zero' := by
                  rw [← hu_indep opU 0 0 (map_zero _), map_zero]
                map_add' := fun s₃ s₃' => by
                  have hsum : (g_mor.hom.app opU).hom (liftSec opU s₃ + liftSec opU s₃') =
                      s₃ + s₃' := by
                    rw [map_add, hliftSec, hliftSec]
                  rw [← hu_indep opU _ _ hsum, map_add] }
            naturality := fun opU₁ opU₂ f_op => AddCommGrpCat.ext fun s₃ => by
              dsimp
              have hnat_u := congrArg (fun k => k.hom (liftSec opU₁ s₃))
                (u_mor.hom.naturality f_op)
              dsimp at hnat_u
              rw [← hnat_u]
              apply (hu_indep opU₂ _ _ _).symm
              have hnat_g := congrArg (fun k => k.hom (liftSec opU₁ s₃))
                (g_mor.hom.naturality f_op)
              dsimp at hnat_g
              rw [hnat_g, hliftSec] } }
    refine ⟨v_mor, ?_, fun w_mor hw => ?_⟩
    · apply CategoryTheory.Sheaf.hom_ext
      ext opU s₂
      exact (hu_indep opU s₂ ((g_mor.hom.app opU).hom s₂) rfl).symm
    · apply CategoryTheory.Sheaf.hom_ext
      ext opU s₃
      dsimp [v_mor]
      rw [← hw]
      change (w_mor.hom.app opU).hom s₃ =
        (w_mor.hom.app opU).hom ((g_mor.hom.app opU).hom (liftSec opU s₃))
      rw [hliftSec]

  have hInjProd :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι : Type u)
        (Ω : ι → Type u) [∀ i, Field (Ω i)] [∀ i, IsAlgClosed (Ω i)]
        (y : ∀ i, AlgebraicGeometry.Spec (CommRingCat.of (Ω i)) ⟶ Z)
        (I : ι → AddCommGrpCat.{u}),
        (∀ i : ι, CategoryTheory.Injective (I i)) →
        CategoryTheory.Injective (prodSheaf Z ι Ω y I) := by
    intro Z ι Ω _ _ y I hI
    let 𝒞_Z := CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    have hInjSingle : ∀ i : ι, CategoryTheory.Injective ((singlePush Z (Ω i) (y i)).obj (I i)) := by
      intro i
      obtain ⟨Stalk_i, adj_i, _, _, hLim_i, _, _, _, _⟩ := hStalkAdjPkg Z (Ω i) (y i)
      have : CategoryTheory.Limits.PreservesFiniteLimits Stalk_i := hLim_i
      exact CategoryTheory.Adjunction.map_injective adj_i (I i) (hI i)
    let pr : ∀ i : ι, prodSheaf Z ι Ω y I ⟶ (singlePush Z (Ω i) (y i)).obj (I i) :=
      fun i =>
        { hom :=
            { app := fun _ => AddCommGrpCat.ofHom
                { toFun := fun s => s i
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
              naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl } }
    refine ⟨fun {K₁ K₂} g_hom m_hom hm => ?_⟩
    have : ∀ i : ι, CategoryTheory.Injective ((singlePush Z (Ω i) (y i)).obj (I i)) := hInjSingle
    let ψ : ∀ i : ι, K₂ ⟶ (singlePush Z (Ω i) (y i)).obj (I i) :=
      fun i => CategoryTheory.Injective.factorThru (g_hom ≫ pr i) m_hom
    have hψ : ∀ i : ι, m_hom ≫ ψ i = g_hom ≫ pr i :=
      fun i => CategoryTheory.Injective.comp_factorThru (g_hom ≫ pr i) m_hom
    refine ⟨{ hom :=
                { app := fun opU => AddCommGrpCat.ofHom
                    { toFun := fun k₂ i γ => ((ψ i).hom.app opU).hom k₂ γ
                      map_zero' := funext fun i => funext fun γ =>
                        congrFun (((ψ i).hom.app opU).hom.map_zero) γ
                      map_add' := fun a b => funext fun i => funext fun γ =>
                        congrFun (((ψ i).hom.app opU).hom.map_add a b) γ }
                  naturality := fun opU₁ opU₂ f_op => AddCommGrpCat.ext fun k₂ =>
                    funext fun i => funext fun γ =>
                      congrFun (congrArg (fun q => q.hom k₂) ((ψ i).hom.naturality f_op)) γ } },
      ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    ext opU k₁ i γ
    exact congrFun (congrArg (fun q => (q.hom.app opU).hom k₁) (hψ i)) γ

  have hRepEquivNat :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
         {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
         (ψ : 𝒢₁ ⟶ 𝒢₂) (u_hom : weilPolyP1CohomologyRepSheaf Z V ⟶ 𝒢₁),
         weilPolyP1CohomologyRepHomEquiv Z V 𝒢₂ (u_hom ≫ ψ) =
           (ψ.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V 𝒢₁ u_hom) := by
    intro Z V 𝒢₁ 𝒢₂ ψ u_hom
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let adj_ab := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let F_pre := CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
    have h1 : adj_sh.homEquiv F_pre 𝒢₂ (u_hom ≫ ψ) =
        adj_sh.homEquiv F_pre 𝒢₁ u_hom ≫ ψ.hom :=
      adj_sh.homEquiv_naturality_right u_hom ψ
    have h2 := adj_ab.homEquiv_naturality_right (adj_sh.homEquiv F_pre 𝒢₁ u_hom) ψ.hom
    exact (congrArg (fun x => CategoryTheory.yonedaEquiv
      (adj_ab.homEquiv (CategoryTheory.yoneda.obj V) 𝒢₂.obj x)) h1).trans
      (congrArg CategoryTheory.yonedaEquiv h2)

  have hProdLocalAcyclic :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι : Type u)
        (Ω : ι → Type u) [∀ i, Field (Ω i)] [∀ i, IsAlgClosed (Ω i)]
        (y : ∀ i, AlgebraicGeometry.Spec (CommRingCat.of (Ω i)) ⟶ Z)
        (M : ι → AddCommGrpCat.{u}) (U : Z.Etale) (k : ℕ),
        1 ≤ k →
        Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf (prodSheaf Z ι Ω y M) k).obj
          (Opposite.op U)) := by
    intro Z ι Ω _ _ y M₀ U k hk
    let 𝒞_Z := CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    let _ : CategoryTheory.Abelian 𝒞_Z := inferInstance
    let _ : CategoryTheory.HasExt.{u} 𝒞_Z := inferInstance
    let F_U : 𝒞_Z := weilPolyP1CohomologyRepSheaf Z U
    have hExtZero : ∀ (n : ℕ) (M : ι → AddCommGrpCat.{u})
        (e : CategoryTheory.Abelian.Ext.{u} F_U (prodSheaf Z ι Ω y M) (n + 1)),
        e = 0 := by
      intro n
      induction n with
      | zero =>
        intro M e
        let I : ι → AddCommGrpCat.{u} := fun i => CategoryTheory.Injective.under (M i)
        let α : ∀ i : ι, M i ⟶ I i := fun i => CategoryTheory.Injective.ι (M i)
        let N : ι → AddCommGrpCat.{u} := fun i => CategoryTheory.Limits.cokernel (α i)
        let β : ∀ i : ι, I i ⟶ N i := fun i => CategoryTheory.Limits.cokernel.π (α i)
        have hSE_i : ∀ i : ι,
            (CategoryTheory.ShortComplex.mk (α i) (β i)
              (CategoryTheory.Limits.cokernel.condition (α i))).ShortExact :=
          fun i =>
            { exact := CategoryTheory.ShortComplex.exact_cokernel (α i)
              mono_f := inferInstance
              epi_g := inferInstance }
        obtain ⟨h0_sh, hSE_sh, hsurj_sh⟩ :=
          hProdShortExact Z ι Ω y M I N α β
            (fun i => CategoryTheory.Limits.cokernel.condition (α i)) hSE_i
        have : CategoryTheory.Injective (prodSheaf Z ι Ω y I) :=
          hInjProd Z ι Ω y I (fun _ => inferInstance)
        have he_comp :
            e.comp (CategoryTheory.Abelian.Ext.mk₀ (prodSheafMap Z ι Ω y α))
              (Nat.add_zero 1) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ F_U hSE_sh e he_comp
            (Nat.zero_add 1)
        let u₃ : F_U ⟶ prodSheaf Z ι Ω y N := CategoryTheory.Abelian.Ext.addEquiv₀ x₃
        let s₃ : ↑((prodSheaf Z ι Ω y N).obj.obj (Opposite.op U)) :=
          weilPolyP1CohomologyRepHomEquiv Z U _ u₃
        obtain ⟨s₂, hs₂⟩ := hsurj_sh (Opposite.op U) s₃
        let u₂ : F_U ⟶ prodSheaf Z ι Ω y I :=
          (weilPolyP1CohomologyRepHomEquiv Z U _).symm s₂
        have hu₂_β : u₂ ≫ prodSheafMap Z ι Ω y β = u₃ :=
          (weilPolyP1CohomologyRepHomEquiv Z U _).injective
            (by rw [hRepEquivNat, Equiv.apply_symm_apply, hs₂])
        have hx₃_eq :
            x₃ = (CategoryTheory.Abelian.Ext.mk₀ u₂).comp
              (CategoryTheory.Abelian.Ext.mk₀ (prodSheafMap Z ι Ω y β)) (Nat.add_zero 0) := by
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hu₂_β]
          exact (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x₃).symm
        rw [← hx₃, hx₃_eq,
          CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
            (CategoryTheory.Abelian.Ext.mk₀ u₂)
            (CategoryTheory.Abelian.Ext.mk₀ (prodSheafMap Z ι Ω y β))
            hSE_sh.extClass (Nat.zero_add 1),
          hSE_sh.comp_extClass]
        exact CategoryTheory.Abelian.Ext.comp_zero _ _ _ _ _
      | succ m ih =>
        intro M e
        let I : ι → AddCommGrpCat.{u} := fun i => CategoryTheory.Injective.under (M i)
        let α : ∀ i : ι, M i ⟶ I i := fun i => CategoryTheory.Injective.ι (M i)
        let N : ι → AddCommGrpCat.{u} := fun i => CategoryTheory.Limits.cokernel (α i)
        let β : ∀ i : ι, I i ⟶ N i := fun i => CategoryTheory.Limits.cokernel.π (α i)
        have hSE_i : ∀ i : ι,
            (CategoryTheory.ShortComplex.mk (α i) (β i)
              (CategoryTheory.Limits.cokernel.condition (α i))).ShortExact :=
          fun i =>
            { exact := CategoryTheory.ShortComplex.exact_cokernel (α i)
              mono_f := inferInstance
              epi_g := inferInstance }
        obtain ⟨_, hSE_sh, _⟩ :=
          hProdShortExact Z ι Ω y M I N α β
            (fun i => CategoryTheory.Limits.cokernel.condition (α i)) hSE_i
        have : CategoryTheory.Injective (prodSheaf Z ι Ω y I) :=
          hInjProd Z ι Ω y I (fun _ => inferInstance)
        have he_comp :
            e.comp (CategoryTheory.Abelian.Ext.mk₀ (prodSheafMap Z ι Ω y α))
              (Nat.add_zero (m + 2)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ F_U hSE_sh e he_comp
            (rfl : (m + 1) + 1 = m + 2)
        rw [← hx₃, ih N x₃]
        exact CategoryTheory.Abelian.Ext.zero_comp _ _ _ _ _
    obtain ⟨n, rfl⟩ : ∃ n, k = n + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
    refine ⟨fun a b => ?_⟩
    exact (hExtZero n M₀ a).trans (hExtZero n M₀ b).symm

  
  let Ω_x : ↥X → Type u := fun x => weilOrdGodGeomField X x
  let y_X : ∀ x : ↥X, AlgebraicGeometry.Spec (CommRingCat.of (Ω_x x)) ⟶ X :=
    fun x => weilOrdGodGeomHom X x
  let Stalk : ↥X → (𝒞_X ⥤ AddCommGrpCat.{u}) :=
    fun x => Classical.choose (hStalkAdjPkg X (Ω_x x) (y_X x))
  have hStalk_spec : ∀ x : ↥X,
      ∃ (adj₀ : Stalk x ⊣ singlePush X (Ω_x x) (y_X x))
        (germ₀ : ∀ (ℱ : 𝒞_X) (U : X.Etale),
          GeomLifts X (Ω_x x) (y_X x) U → (ℱ.obj.obj (Opposite.op U) ⟶ (Stalk x).obj ℱ)),
        (Stalk x).Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits (Stalk x) ∧
        CategoryTheory.Limits.PreservesFiniteColimits (Stalk x) ∧
        (∀ {ℱ₁ ℱ₂ : 𝒞_X} (φ : ℱ₁ ⟶ ℱ₂) (U : X.Etale) (γ : GeomLifts X (Ω_x x) (y_X x) U),
          germ₀ ℱ₁ U γ ≫ (Stalk x).map φ =
            φ.hom.app (Opposite.op U) ≫ germ₀ ℱ₂ U γ) ∧
        (∀ (ℱ : 𝒞_X) {U₁ U₂ : X.Etale} (u : U₁ ⟶ U₂) (γ : GeomLifts X (Ω_x x) (y_X x) U₁),
          ℱ.obj.map u.op ≫ germ₀ ℱ U₁ γ =
            germ₀ ℱ U₂ (geomLiftMap X (Ω_x x) (y_X x) u γ)) ∧
        (∀ (ℱ : 𝒞_X) (U : X.Etale) (γ : GeomLifts X (Ω_x x) (y_X x) U)
          (s : ↑(ℱ.obj.obj (Opposite.op U))),
          (germ₀ ℱ U γ).hom s = 0 →
          ∃ (V : X.Etale) (h : V ⟶ U) (δ : GeomLifts X (Ω_x x) (y_X x) V),
            geomLiftMap X (Ω_x x) (y_X x) h δ = γ ∧ (ℱ.obj.map h.op).hom s = 0) :=
    fun x => Classical.choose_spec (hStalkAdjPkg X (Ω_x x) (y_X x))

  let germ : ∀ (x : ↥X) (ℱ : 𝒞_X) (U : X.Etale),
      GeomLifts X (Ω_x x) (y_X x) U → (ℱ.obj.obj (Opposite.op U) ⟶ (Stalk x).obj ℱ) :=
    fun x => Classical.choose (Classical.choose_spec (hStalk_spec x))

  have hStalk_props : ∀ x : ↥X,
      (Stalk x).Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits (Stalk x) ∧
      CategoryTheory.Limits.PreservesFiniteColimits (Stalk x) ∧
      (∀ {ℱ₁ ℱ₂ : 𝒞_X} (φ : ℱ₁ ⟶ ℱ₂) (U : X.Etale) (γ : GeomLifts X (Ω_x x) (y_X x) U),
        germ x ℱ₁ U γ ≫ (Stalk x).map φ =
          φ.hom.app (Opposite.op U) ≫ germ x ℱ₂ U γ) ∧
      (∀ (ℱ : 𝒞_X) {U₁ U₂ : X.Etale} (u : U₁ ⟶ U₂) (γ : GeomLifts X (Ω_x x) (y_X x) U₁),
        ℱ.obj.map u.op ≫ germ x ℱ U₁ γ =
          germ x ℱ U₂ (geomLiftMap X (Ω_x x) (y_X x) u γ)) ∧
      (∀ (ℱ : 𝒞_X) (U : X.Etale) (γ : GeomLifts X (Ω_x x) (y_X x) U)
        (s : ↑(ℱ.obj.obj (Opposite.op U))),
        (germ x ℱ U γ).hom s = 0 →
        ∃ (V : X.Etale) (h : V ⟶ U) (δ : GeomLifts X (Ω_x x) (y_X x) V),
          geomLiftMap X (Ω_x x) (y_X x) h δ = γ ∧ (ℱ.obj.map h.op).hom s = 0) :=
    fun x => Classical.choose_spec (Classical.choose_spec (hStalk_spec x))

  let G₀ : 𝒞_X ⥤ 𝒞_X :=
    { obj := fun ℱ => prodSheaf X ↥X Ω_x y_X (fun x => (Stalk x).obj ℱ)
      map := fun φ => prodSheafMap X ↥X Ω_x y_X (fun x => (Stalk x).map φ)
      map_id := fun ℱ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext opW s x γ
        change ((Stalk x).map (𝟙 ℱ)).hom (s x γ) = s x γ
        rw [(Stalk x).map_id]
        rfl
      map_comp := fun φ₁ φ₂ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext opW s x γ
        change ((Stalk x).map (φ₁ ≫ φ₂)).hom (s x γ) = _
        rw [(Stalk x).map_comp]
        rfl }

  let η₀ : CategoryTheory.Functor.id 𝒞_X ⟶ G₀ :=
    { app := fun ℱ =>
        { hom :=
            { app := fun opW => AddCommGrpCat.ofHom
                { toFun := fun s x γ => (germ x ℱ opW.unop γ).hom s
                  map_zero' := funext fun x => funext fun γ => (germ x ℱ opW.unop γ).hom.map_zero
                  map_add' := fun s₁ s₂ => funext fun x => funext fun γ =>
                    (germ x ℱ opW.unop γ).hom.map_add s₁ s₂ }
              naturality := fun opW₁ opW₂ f_op => AddCommGrpCat.ext fun s =>
                funext fun x => funext fun γ => by
                  change (germ x ℱ opW₂.unop γ).hom ((ℱ.obj.map f_op).hom s) =
                    (germ x ℱ opW₁.unop (geomLiftMap X (Ω_x x) (y_X x) f_op.unop γ)).hom s
                  exact congrArg (fun k => k.hom s)
                    ((hStalk_props x).2.2.2.2.1 ℱ f_op.unop γ) } }
      naturality := fun ℱ₁ ℱ₂ φ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext opW s x γ
        change (germ x ℱ₂ opW.unop γ).hom ((φ.hom.app opW).hom s) =
          ((Stalk x).map φ).hom ((germ x ℱ₁ opW.unop γ).hom s)
        exact congrArg (fun k => k.hom s) ((hStalk_props x).2.2.2.1 φ opW.unop γ).symm }

  let _ : CategoryTheory.Abelian 𝒞_X := inferInstance
  have hG₀_add : G₀.Additive :=
    { map_add := fun {ℱ₁ ℱ₂} φ₁ φ₂ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext opW s x γ
        have : (Stalk x).Additive := (hStalk_props x).1
        change ((Stalk x).map (φ₁ + φ₂)).hom (s x γ) = _
        rw [(Stalk x).map_add]
        rfl }
  let _ : G₀.Additive := hG₀_add

  have hG₀_shortExact :
      ∀ {S_cx : CategoryTheory.ShortComplex 𝒞_X},
        S_cx.ShortExact → (S_cx.map G₀).ShortExact := by
    intro S_cx hSE
    have h0_x : ∀ x : ↥X, (Stalk x).map S_cx.f ≫ (Stalk x).map S_cx.g = 0 := by
      intro x
      have : (Stalk x).Additive := (hStalk_props x).1
      rw [← (Stalk x).map_comp, S_cx.zero, (Stalk x).map_zero]
    have hSE_x : ∀ x : ↥X,
        (CategoryTheory.ShortComplex.mk
          ((Stalk x).map S_cx.f) ((Stalk x).map S_cx.g) (h0_x x)).ShortExact := by
      intro x
      have : (Stalk x).Additive := (hStalk_props x).1
      have : CategoryTheory.Limits.PreservesFiniteLimits (Stalk x) := (hStalk_props x).2.1
      have : CategoryTheory.Limits.PreservesFiniteColimits (Stalk x) := (hStalk_props x).2.2.1
      exact hSE.map_of_exact (Stalk x)
    obtain ⟨h0_sh, hSE_sh, _⟩ :=
      hProdShortExact X ↥X Ω_x y_X
        (fun x => (Stalk x).obj S_cx.X₁)
        (fun x => (Stalk x).obj S_cx.X₂)
        (fun x => (Stalk x).obj S_cx.X₃)
        (fun x => (Stalk x).map S_cx.f)
        (fun x => (Stalk x).map S_cx.g)
        h0_x hSE_x
    exact hSE_sh

  have hG₀_lim : CategoryTheory.Limits.PreservesFiniteLimits G₀ :=
    (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono G₀).mpr
      fun S_cx hSE => ⟨(hG₀_shortExact hSE).exact, (hG₀_shortExact hSE).mono_f⟩

  have hG₀_colim : CategoryTheory.Limits.PreservesFiniteColimits G₀ :=
    (CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi G₀).mpr
      fun S_cx hSE => ⟨(hG₀_shortExact hSE).exact, (hG₀_shortExact hSE).epi_g⟩

  have hMono_η₀ : ∀ ℱ : 𝒞_X, CategoryTheory.Mono (η₀.app ℱ) := by
    intro ℱ
    rw [CategoryTheory.Preadditive.mono_iff_cancel_zero]
    intro K_sh t_mor ht0
    apply CategoryTheory.Sheaf.hom_ext
    ext opW k₀
    let W := opW.unop
    let s : ↑(ℱ.obj.obj (Opposite.op W)) := (t_mor.hom.app (Opposite.op W)).hom k₀
    change s = 0
    have hs_germ : ∀ (x : ↥X) (γ : GeomLifts X (Ω_x x) (y_X x) W),
        (germ x ℱ W γ).hom s = 0 := by
      intro x γ
      exact congrFun (congrFun (congrArg (fun m => (m.hom.app (Opposite.op W)).hom k₀) ht0) x) γ
    let R_s : CategoryTheory.Sieve W :=
      { arrows := fun {V} h => (ℱ.obj.map h.op).hom s = 0
        downward_closed := fun {V₁ V₂} {h} hh g => by
          change (ℱ.obj.map (h.op ≫ g.op)).hom s = 0
          rw [ℱ.obj.map_comp]
          change (ℱ.obj.map g.op).hom ((ℱ.obj.map h.op).hom s) = 0
          rw [hh, map_zero] }
    have hRs_mem : R_s ∈ X.smallEtaleTopology W := by
      apply hCoverSieveX W R_s
      intro x γ
      exact (hStalk_props x).2.2.2.2.2 ℱ W γ s (hs_germ x γ)
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let φ_s : Aℤ ⟶ ℱ.obj.obj (Opposite.op W) := AddCommGrpCat.ofHom
      { toFun := fun z => z.down • s
        map_zero' := zero_zsmul s
        map_add' := fun z₁ z₂ => add_zsmul s z₁.down z₂.down }
    have hsep := (ℱ.property Aℤ R_s hRs_mem).isSeparatedFor
    let zero_s : Aℤ ⟶ ℱ.obj.obj (Opposite.op W) := 0
    have hφ_eq : φ_s = zero_s := by
      refine hsep (fun {V} _ _ => (0 : Aℤ ⟶ ℱ.obj.obj (Opposite.op V))) φ_s zero_s ?_ ?_
      · intro V h hh
        change φ_s ≫ ℱ.obj.map h.op = 0
        apply AddCommGrpCat.ext
        intro z
        change (ℱ.obj.map h.op).hom (z.down • s) = 0
        rw [map_zsmul, hh, zsmul_zero]
      · intro V h _
        change zero_s ≫ ℱ.obj.map h.op = 0
        exact CategoryTheory.Limits.zero_comp
    have hs1 := congrArg (fun m => m.hom (ULift.up 1)) hφ_eq
    exact (one_zsmul s).symm.trans hs1

  refine ⟨G₀, η₀, ⟨hG₀_add, hG₀_lim, hG₀_colim⟩, hMono_η₀, ?_, ?_⟩
  · intro ℱ W k hk
    exact hProdLocalAcyclic X ↥X Ω_x y_X (fun x => (Stalk x).obj ℱ) W k hk
  · intro ℱ U k hk
    let 𝒞_S := CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}
    let B_f := weilEtaleSitePullback f
    let Fgt_X := AlgebraicGeometry.Scheme.Etale.forget X
    let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S
    let y_S : ∀ x : ↥X, AlgebraicGeometry.Spec (CommRingCat.of (Ω_x x)) ⟶ S :=
      fun x => y_X x ≫ f
    let fst_V : ∀ (V : S.Etale), (Fgt_X.obj (B_f.obj V)).left ⟶ (Fgt_S.obj V).left :=
      fun V => CategoryTheory.Limits.pullback.fst ((Fgt_S.obj V).hom) f
    let snd_V : ∀ (V : S.Etale), (Fgt_X.obj (B_f.obj V)).left ⟶ X :=
      fun V => (Fgt_X.obj (B_f.obj V)).hom
    let lift_V : ∀ (V : S.Etale) {W_sch : AlgebraicGeometry.Scheme.{u}}
        (a : W_sch ⟶ (Fgt_S.obj V).left) (b : W_sch ⟶ X),
        a ≫ (Fgt_S.obj V).hom = b ≫ f → (W_sch ⟶ (Fgt_X.obj (B_f.obj V)).left) :=
      fun V {_} a b hab => CategoryTheory.Limits.pullback.lift a b hab
    have h_cond_V : ∀ (V : S.Etale), fst_V V ≫ (Fgt_S.obj V).hom = snd_V V ≫ f :=
      fun V => CategoryTheory.Limits.pullback.condition
    have h_lift_fst_V : ∀ (V : S.Etale) {W_sch : AlgebraicGeometry.Scheme.{u}}
        (a : W_sch ⟶ (Fgt_S.obj V).left) (b : W_sch ⟶ X)
        (hab : a ≫ (Fgt_S.obj V).hom = b ≫ f),
        lift_V V a b hab ≫ fst_V V = a :=
      fun V {_} a b hab => CategoryTheory.Limits.pullback.lift_fst a b hab
    have h_lift_snd_V : ∀ (V : S.Etale) {W_sch : AlgebraicGeometry.Scheme.{u}}
        (a : W_sch ⟶ (Fgt_S.obj V).left) (b : W_sch ⟶ X)
        (hab : a ≫ (Fgt_S.obj V).hom = b ≫ f),
        lift_V V a b hab ≫ snd_V V = b :=
      fun V {_} a b hab => CategoryTheory.Limits.pullback.lift_snd a b hab
    have h_ext_V : ∀ (V : S.Etale) {W_sch : AlgebraicGeometry.Scheme.{u}}
        {m₁ m₂ : W_sch ⟶ (Fgt_X.obj (B_f.obj V)).left},
        m₁ ≫ fst_V V = m₂ ≫ fst_V V → m₁ ≫ snd_V V = m₂ ≫ snd_V V → m₁ = m₂ :=
      fun V {_} {m₁ m₂} h1 h2 => CategoryTheory.Limits.pullback.hom_ext h1 h2
    let liftToS : ∀ (x : ↥X) (V : S.Etale),
        GeomLifts X (Ω_x x) (y_X x) (B_f.obj V) → GeomLifts S (Ω_x x) (y_S x) V :=
      fun x V γ_tilde =>
        ⟨γ_tilde.1 ≫ fst_V V, by
          rw [CategoryTheory.Category.assoc, h_cond_V V, ← CategoryTheory.Category.assoc]
          exact congrArg (· ≫ f) γ_tilde.2⟩
    let liftFromS : ∀ (x : ↥X) (V : S.Etale),
        GeomLifts S (Ω_x x) (y_S x) V → GeomLifts X (Ω_x x) (y_X x) (B_f.obj V) :=
      fun x V γ_S =>
        ⟨lift_V V γ_S.1 (y_X x) γ_S.2, h_lift_snd_V V γ_S.1 (y_X x) γ_S.2⟩
    have hLeftInv : ∀ (x : ↥X) (V : S.Etale) (γ_tilde : GeomLifts X (Ω_x x) (y_X x) (B_f.obj V)),
        liftFromS x V (liftToS x V γ_tilde) = γ_tilde := by
      intro x V γ_tilde
      apply Subtype.ext
      apply h_ext_V V
      · exact h_lift_fst_V V _ _ _
      · exact (h_lift_snd_V V _ _ _).trans γ_tilde.2.symm
    have hRightInv : ∀ (x : ↥X) (V : S.Etale) (γ_S : GeomLifts S (Ω_x x) (y_S x) V),
        liftToS x V (liftFromS x V γ_S) = γ_S := by
      intro x V γ_S
      exact Subtype.ext (h_lift_fst_V V _ _ _)
    have hPbFst : ∀ {V₁ V₂ : S.Etale} (u : V₁ ⟶ V₂),
        (Fgt_X.map (B_f.map u)).left ≫ fst_V V₂ = fst_V V₁ ≫ (Fgt_S.map u).left := by
      intro V₁ V₂ u
      let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) f :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      have hm := CategoryTheory.MorphismProperty.Over.pullback_map_left
        (@AlgebraicGeometry.Etale) ⊤ f u
      exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst V₂.hom f) hm).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have hFromSNat : ∀ (x : ↥X) {V₁ V₂ : S.Etale} (u : V₁ ⟶ V₂)
        (γ_S : GeomLifts S (Ω_x x) (y_S x) V₁),
        geomLiftMap X (Ω_x x) (y_X x) (B_f.map u) (liftFromS x V₁ γ_S) =
          liftFromS x V₂ (geomLiftMap S (Ω_x x) (y_S x) u γ_S) := by
      intro x V₁ V₂ u γ_S
      apply Subtype.ext
      apply h_ext_V V₂
      · change (lift_V V₁ γ_S.1 (y_X x) γ_S.2 ≫ (Fgt_X.map (B_f.map u)).left) ≫ fst_V V₂ =
          lift_V V₂ _ _ _ ≫ fst_V V₂
        rw [CategoryTheory.Category.assoc, hPbFst u, ← CategoryTheory.Category.assoc,
          h_lift_fst_V, h_lift_fst_V]
      · change (lift_V V₁ γ_S.1 (y_X x) γ_S.2 ≫ (Fgt_X.map (B_f.map u)).left) ≫ snd_V V₂ =
          lift_V V₂ _ _ _ ≫ snd_V V₂
        rw [CategoryTheory.Category.assoc, (Fgt_X.map (B_f.map u)).w]
        change lift_V V₁ γ_S.1 (y_X x) γ_S.2 ≫ snd_V V₁ = _
        rw [h_lift_snd_V, h_lift_snd_V]
    let M_ℱ : ↥X → AddCommGrpCat.{u} := fun x => (Stalk x).obj ℱ
    let iso_Pf : P_f.obj (G₀.obj ℱ) ≅ prodSheaf S ↥X Ω_x y_S M_ℱ :=
      { hom :=
          { hom :=
              { app := fun opV => AddCommGrpCat.ofHom
                  { toFun := fun s x γ_S => s x (liftFromS x opV.unop γ_S)
                    map_zero' := rfl
                    map_add' := fun _ _ => rfl }
                naturality := fun opV₁ opV₂ u_op => AddCommGrpCat.ext fun s =>
                  funext fun x => funext fun γ_S =>
                    congrArg (s x) (hFromSNat x u_op.unop γ_S) } }
        inv :=
          { hom :=
              { app := fun opV => AddCommGrpCat.ofHom
                  { toFun := fun s x γ_tilde => s x (liftToS x opV.unop γ_tilde)
                    map_zero' := rfl
                    map_add' := fun _ _ => rfl }
                naturality := fun opV₁ opV₂ u_op => AddCommGrpCat.ext fun s =>
                  funext fun x => funext fun γ_tilde => by
                    apply congrArg (s x)
                    apply Subtype.ext
                    change (γ_tilde.1 ≫ fst_V opV₂.unop) ≫ (Fgt_S.map u_op.unop).left =
                      (γ_tilde.1 ≫ (Fgt_X.map (B_f.map u_op.unop)).left) ≫ fst_V opV₁.unop
                    rw [CategoryTheory.Category.assoc, ← hPbFst u_op.unop,
                      ← CategoryTheory.Category.assoc] } }
        hom_inv_id := by
          apply CategoryTheory.Sheaf.hom_ext
          ext opV s
          funext x γ_tilde
          exact congrArg (s x) (hLeftInv x opV.unop γ_tilde)
        inv_hom_id := by
          apply CategoryTheory.Sheaf.hom_ext
          ext opV s x γ_S
          exact congrArg (s x) (hRightInv x opV.unop γ_S) }
    have hSub_S : Subsingleton
        ↑((CategoryTheory.Sheaf.cohomologyPresheaf (prodSheaf S ↥X Ω_x y_S M_ℱ) k).obj
          (Opposite.op U)) :=
      hProdLocalAcyclic S ↥X Ω_x y_S M_ℱ U k hk
    let iso_coh :=
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor S.smallEtaleTopology k).mapIso iso_Pf).app
        (Opposite.op U)
    refine ⟨fun a b => ?_⟩
    have hab : iso_coh.hom.hom a = iso_coh.hom.hom b := @Subsingleton.elim _ hSub_S _ _
    have ha : iso_coh.inv.hom (iso_coh.hom.hom a) = a :=
      congrArg (fun m => m.hom a) iso_coh.hom_inv_id
    have hb : iso_coh.inv.hom (iso_coh.hom.hom b) = b :=
      congrArg (fun m => m.hom b) iso_coh.hom_inv_id
    exact ha.symm.trans ((congrArg iso_coh.inv.hom hab).trans hb)

theorem weil_leray_p1_filt_pushforward_cycle_boundary_system (X S : AlgebraicGeometry.Scheme.{u})
    (f : X ⟶ S)
    (hCont_f : (weilEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology)
    (G₀ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} ⥤
      CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
    (η₀ : CategoryTheory.Functor.id
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) ⟶ G₀)
    (hAdd_P : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback f) AddCommGrpCat.{u} _
      S.smallEtaleTopology X.smallEtaleTopology hCont_f).Additive)
    (hLim_P : CategoryTheory.Limits.PreservesFiniteLimits
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        S.smallEtaleTopology X.smallEtaleTopology hCont_f))
    (hAdd_G₀ : G₀.Additive)
    (hLim_G₀ : CategoryTheory.Limits.PreservesFiniteLimits G₀)
    (hColim_G₀ : CategoryTheory.Limits.PreservesFiniteColimits G₀)
    (hMono_η₀ : ∀ ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u},
      CategoryTheory.Mono (η₀.app ℱ))
    (hLoc_G₀ : ∀ (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (W : X.Etale) (k : ℕ), 1 ≤ k →
      Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf (G₀.obj ℱ) k).obj
        (Opposite.op W))) :
    let 𝒞_X := CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}
