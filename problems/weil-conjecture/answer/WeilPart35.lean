        (fun V₀ g₀ hg₀ => ?_)
      change (G'.obj.map g₀.op) s = (G'.obj.map g₀.op) 0
      rw [map_zero]
      obtain ⟨a, ha⟩ := hg₀
      have hηZ_zero : (ηZ.app (Opposite.op (M_w.obj V₀))) a =
          (ηZ.app (Opposite.op (M_w.obj V₀))) 0 := by
