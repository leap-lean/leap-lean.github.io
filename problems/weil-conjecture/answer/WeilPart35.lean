        fun {Y} f =>
          if hex : ∃ h₁ : Y ⟶ E_U', h₁ ≫ m₁ = f then
            (S.obj.map (Classical.choose hex).op) s'
          else 0
      have hsec_m₁ : ∀ {Y : X.Etale} (f : Y ⟶ T_X) (h₁ : Y ⟶ E_U'),
