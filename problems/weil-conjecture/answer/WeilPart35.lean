        | succ k ih =>
          intro F
          let I := CategoryTheory.Injective.under F
          let u : F ⟶ I := CategoryTheory.Injective.ι F
          let Q := CategoryTheory.Limits.cokernel u
          let v : I ⟶ Q := CategoryTheory.Limits.cokernel.π u
          let SC := CategoryTheory.ShortComplex.mk u v (CategoryTheory.Limits.cokernel.condition u)
          have hSE : SC.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel u }
          have hI_acyc : ∀ p : ℕ, 1 ≤ p →
              CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage id_XU p I) :=
