      (η : CategoryTheory.Functor.id (CategoryTheory.Sheaf J_D AddCommGrpCat.{u}) ⟶ G)
      (_ : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ J_C J_D hCont).Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          B AddCommGrpCat.{u} _ J_C J_D hCont))
      (_ : G.Additive)
      (_ : ∀ ℱ : CategoryTheory.Sheaf J_D AddCommGrpCat.{u}, CategoryTheory.Mono (η.app ℱ))
      (_ : ∀ (ℱ : CategoryTheory.Sheaf J_D AddCommGrpCat.{u}) (W : D) (k : ℕ), 1 ≤ k →
        Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf (G.obj ℱ) k).obj
          (Opposite.op W))),
      let 𝒞_D := CategoryTheory.Sheaf J_D AddCommGrpCat.{u}
      let 𝒞_C := CategoryTheory.Sheaf J_C AddCommGrpCat.{u}
      let P_B := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ J_C J_D hCont
      let R_f : ℕ → 𝒞_D → 𝒞_C := fun q ℱ =>
        (CategoryTheory.presheafToSheaf J_C AddCommGrpCat.{u}).obj
          (B.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℱ q)
      let R_map : ∀ (q : ℕ) {ℱ₁ ℱ₂ : 𝒞_D}, (ℱ₁ ⟶ ℱ₂) → (R_f q ℱ₁ ⟶ R_f q ℱ₂) :=
        fun q {_ _} φ =>
          (CategoryTheory.presheafToSheaf J_C AddCommGrpCat.{u}).map
            (CategoryTheory.Functor.whiskerLeft B.op
              ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_D q).map φ))
      ∃ (Q : ℕ → (𝒞_D ⥤ 𝒞_D))
        (iso_Q0 : Q 0 ≅ CategoryTheory.Functor.id 𝒞_D)
        (B_sh : ℕ → (𝒞_D ⥤ 𝒞_C)),
        let I_res : ℕ → (𝒞_D ⥤ 𝒞_D) := fun q => Q q ⋙ G
        let Z_sh : ℕ → (𝒞_D ⥤ 𝒞_C) := fun q => Q q ⋙ P_B
        ∃ (ι_Q : ∀ q : ℕ, Q q ⟶ I_res q)
          (π_Q : ∀ q : ℕ, I_res q ⟶ Q (q + 1))
          (ι_Z : ∀ q : ℕ, Z_sh q ⟶ I_res q ⋙ P_B)
          (d_tilde : ∀ q : ℕ, I_res q ⋙ P_B ⟶ B_sh (q + 1))
          (j_B : ∀ q : ℕ, B_sh q ⟶ Z_sh q)
          (π_H : ∀ (q : ℕ) (ℱ : 𝒞_D), (Z_sh q).obj ℱ ⟶ R_f q ℱ),
          (∀ ℱ : 𝒞_D, CategoryTheory.Limits.IsZero ((B_sh 0).obj ℱ)) ∧
          (∀ (q : ℕ) (ℱ : 𝒞_D),
            ∃ h0 : (ι_Q q).app ℱ ≫ (π_Q q).app ℱ = 0,
              (CategoryTheory.ShortComplex.mk ((ι_Q q).app ℱ) ((π_Q q).app ℱ) h0).ShortExact) ∧
          (∀ (q : ℕ) (ℱ : 𝒞_D),
            (∃ h0 : (ι_Z q).app ℱ ≫ (d_tilde q).app ℱ = 0,
              (CategoryTheory.ShortComplex.mk ((ι_Z q).app ℱ) ((d_tilde q).app ℱ) h0).ShortExact) ∧
            (d_tilde q).app ℱ ≫ (j_B (q + 1)).app ℱ = P_B.map ((π_Q q).app ℱ)) ∧
          (∀ (q : ℕ) (ℱ : 𝒞_D),
            ∃ h0 : (j_B q).app ℱ ≫ π_H q ℱ = 0,
              (CategoryTheory.ShortComplex.mk ((j_B q).app ℱ) (π_H q ℱ) h0).ShortExact) ∧
          (∀ (q : ℕ) {ℱ₁ ℱ₂ : 𝒞_D} (φ : ℱ₁ ⟶ ℱ₂),
            (Z_sh q).map φ ≫ π_H q ℱ₂ = π_H q ℱ₁ ≫ R_map q φ) ∧
          (∀ (n q : ℕ) (ℱ : 𝒞_D),
            n • CategoryTheory.CategoryStruct.id ℱ = 0 →
            n • CategoryTheory.CategoryStruct.id ((Z_sh q).obj ℱ) = 0) := by
    intro C D _ _ J_C J_D _ _ _ B hCont G η hAddP hLimP hAddG hMonoη hLocG
    let 𝒞_D := CategoryTheory.Sheaf J_D AddCommGrpCat.{u}
    let 𝒞_C := CategoryTheory.Sheaf J_C AddCommGrpCat.{u}
    let P_B := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B AddCommGrpCat.{u} _ J_C J_D hCont

    obtain ⟨Q, iso_Q0, B_sh, ι_Q, π_Q, ι_Z, d_tilde, j_B,
        hB0, hSE_Q, hSE_im, hUp0, hUpSucc, hTor_Z⟩ :=
      hLayer1 P_B G η hAddP hLimP hAddG hMonoη
    let I_res : ℕ → (𝒞_D ⥤ 𝒞_D) := fun q => Q q ⋙ G
    let Z_sh : ℕ → (𝒞_D ⥤ 𝒞_C) := fun q => Q q ⋙ P_B

    obtain ⟨α₀⟩ := hLayer2 J_D
    obtain ⟨δ, hδ_nat, hδ_acyc⟩ := hLayer3 J_D

    let H_psh : ℕ → (𝒞_D ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u})) :=
      fun k => CategoryTheory.Sheaf.cohomologyPresheafFunctor J_D k
    let sh_C := CategoryTheory.presheafToSheaf J_C AddCommGrpCat.{u}
    let adj_C := CategoryTheory.sheafificationAdjunction J_C AddCommGrpCat.{u}
    haveI : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} sh_C :=
      adj_C.leftAdjoint_preservesColimits

    have hShColim : ∀ {P₁ P₂ P₃ : Cᵒᵖ ⥤ AddCommGrpCat.{u}}
        (α_p : P₁ ⟶ P₂) (β_p : P₂ ⟶ P₃) (hw_p : α_p ≫ β_p = 0),
        CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.CokernelCofork.ofπ β_p hw_p) →
        ∃ hw_sh : sh_C.map α_p ≫ sh_C.map β_p = 0,
          Nonempty (CategoryTheory.Limits.IsColimit
            (CategoryTheory.Limits.CokernelCofork.ofπ (sh_C.map β_p) hw_sh)) := by
      intro P₁ P₂ P₃ α_p β_p hw_p hc_p
      have hw_sh : sh_C.map α_p ≫ sh_C.map β_p = 0 := by
        rw [← sh_C.map_comp, hw_p, sh_C.map_zero]
      have hEquivZero : ∀ {P₀ : Cᵒᵖ ⥤ AddCommGrpCat.{u}} {𝒢 : 𝒞_C},
          adj_C.homEquiv P₀ 𝒢 0 = 0 := by
        intro P₀ 𝒢
        rw [adj_C.homEquiv_unit]
        change adj_C.unit.app P₀ ≫ (0 : sh_C.obj P₀ ⟶ 𝒢).hom = 0
        exact CategoryTheory.Limits.comp_zero
      refine ⟨hw_sh, ⟨CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ (sh_C.map β_p) hw_sh
        (fun {Z'} g' hg' =>
          (adj_C.homEquiv P₃ Z').symm
            (hc_p.desc (CategoryTheory.Limits.CokernelCofork.ofπ
              (adj_C.homEquiv P₂ Z' g')
              (by rw [← adj_C.homEquiv_naturality_left, hg', hEquivZero]))))
        (fun {Z'} g' hg' => ?_)
        (fun {Z'} g' hg' m hm => ?_)⟩⟩
      · apply (adj_C.homEquiv P₂ Z').injective
        rw [adj_C.homEquiv_naturality_left, Equiv.apply_symm_apply]
        exact hc_p.fac (CategoryTheory.Limits.CokernelCofork.ofπ
          (adj_C.homEquiv P₂ Z' g') _) CategoryTheory.Limits.WalkingParallelPair.one
      · apply (adj_C.homEquiv P₃ Z').injective
        rw [Equiv.apply_symm_apply]
        refine hc_p.uniq (CategoryTheory.Limits.CokernelCofork.ofπ
          (adj_C.homEquiv P₂ Z' g') _) (adj_C.homEquiv P₃ Z' m) (fun j => ?_)
        cases j with
        | zero =>
          simp only [CategoryTheory.Limits.Cofork.app_zero_eq_comp_π_left]
          change (α_p ≫ β_p) ≫ adj_C.homEquiv P₃ Z' m = α_p ≫ adj_C.homEquiv P₂ Z' g'
          rw [hw_p, CategoryTheory.Limits.zero_comp,
            ← adj_C.homEquiv_naturality_left, hg', hEquivZero]
        | one =>
          change β_p ≫ adj_C.homEquiv P₃ Z' m = adj_C.homEquiv P₂ Z' g'
          rw [← adj_C.homEquiv_naturality_left, hm]

    let R_f : ℕ → 𝒞_D → 𝒞_C := fun k 𝒜 =>
      sh_C.obj (B.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf 𝒜 k)
    let R_map : ∀ (k : ℕ) {𝒜₁ 𝒜₂ : 𝒞_D}, (𝒜₁ ⟶ 𝒜₂) → (R_f k 𝒜₁ ⟶ R_f k 𝒜₂) :=
      fun k {_ _} ψ => sh_C.map (CategoryTheory.Functor.whiskerLeft B.op ((H_psh k).map ψ))

    have hR_map_id : ∀ (k : ℕ) (𝒜 : 𝒞_D), R_map k (CategoryTheory.CategoryStruct.id 𝒜) =
        CategoryTheory.CategoryStruct.id (R_f k 𝒜) := by
      intro k 𝒜
      dsimp [R_f, R_map]
      rw [(H_psh k).map_id]
      have hid : CategoryTheory.Functor.whiskerLeft B.op
          (CategoryTheory.CategoryStruct.id ((H_psh k).obj 𝒜)) =
          CategoryTheory.CategoryStruct.id (B.op ⋙ (H_psh k).obj 𝒜) := by
        ext
        rfl
      rw [hid, sh_C.map_id]
    have hR_map_comp : ∀ (k : ℕ) {𝒜₁ 𝒜₂ 𝒜₃ : 𝒞_D} (ψ₁ : 𝒜₁ ⟶ 𝒜₂) (ψ₂ : 𝒜₂ ⟶ 𝒜₃),
        R_map k (ψ₁ ≫ ψ₂) = R_map k ψ₁ ≫ R_map k ψ₂ := by
      intro k 𝒜₁ 𝒜₂ 𝒜₃ ψ₁ ψ₂
      dsimp [R_map]
      rw [(H_psh k).map_comp, CategoryTheory.Functor.whiskerLeft_comp, sh_C.map_comp]

    let cIso : ∀ 𝒢 : 𝒞_C, sh_C.obj 𝒢.obj ≅ 𝒢 :=
      fun 𝒢 => CategoryTheory.asIso (adj_C.counit.app 𝒢)
    let e₀ : ∀ 𝒜 : 𝒞_D, P_B.obj 𝒜 ≅ R_f 0 𝒜 := fun 𝒜 =>
      (cIso (P_B.obj 𝒜)).symm.trans
        (sh_C.mapIso (CategoryTheory.Functor.isoWhiskerLeft B.op (α₀.app 𝒜)))
    have he₀_nat : ∀ {𝒜₁ 𝒜₂ : 𝒞_D} (ψ : 𝒜₁ ⟶ 𝒜₂),
        P_B.map ψ ≫ (e₀ 𝒜₂).hom = (e₀ 𝒜₁).hom ≫ R_map 0 ψ := by
      intro 𝒜₁ 𝒜₂ ψ
      have hcounit := adj_C.counit.naturality (P_B.map ψ)
      have h1 : P_B.map ψ ≫ (cIso (P_B.obj 𝒜₂)).inv =
          (cIso (P_B.obj 𝒜₁)).inv ≫
            sh_C.map ((CategoryTheory.sheafToPresheaf J_C AddCommGrpCat.{u}).map
              (P_B.map ψ)) := by
        rw [← CategoryTheory.cancel_mono (cIso (P_B.obj 𝒜₂)).hom,
          CategoryTheory.Category.assoc, (cIso (P_B.obj 𝒜₂)).inv_hom_id,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc]
        change P_B.map ψ = (cIso (P_B.obj 𝒜₁)).inv ≫
          ((CategoryTheory.sheafToPresheaf J_C AddCommGrpCat.{u} ⋙ sh_C).map
            (P_B.map ψ) ≫ adj_C.counit.app (P_B.obj 𝒜₂))
        rw [hcounit, CategoryTheory.Functor.id_map, ← CategoryTheory.Category.assoc]
        exact ((cIso (P_B.obj 𝒜₁)).inv_hom_id_assoc (P_B.map ψ)).symm
      have h2 : sh_C.map (CategoryTheory.Functor.whiskerLeft B.op ψ.hom) ≫
          sh_C.map (CategoryTheory.Functor.whiskerLeft B.op (α₀.hom.app 𝒜₂)) =
          sh_C.map (CategoryTheory.Functor.whiskerLeft B.op (α₀.hom.app 𝒜₁)) ≫
            sh_C.map (CategoryTheory.Functor.whiskerLeft B.op ((H_psh 0).map ψ)) := by
        rw [← sh_C.map_comp, ← sh_C.map_comp, ← CategoryTheory.Functor.whiskerLeft_comp,
          ← CategoryTheory.Functor.whiskerLeft_comp]
        congr 2
        exact α₀.hom.naturality ψ
      have hL : P_B.map ψ ≫ (e₀ 𝒜₂).hom =
          (cIso (P_B.obj 𝒜₁)).inv ≫
            (sh_C.map (CategoryTheory.Functor.whiskerLeft B.op ψ.hom) ≫
              sh_C.map (CategoryTheory.Functor.whiskerLeft B.op (α₀.hom.app 𝒜₂))) := by
        have h1_assoc := congrArg
          (· ≫ sh_C.map (CategoryTheory.Functor.whiskerLeft B.op (α₀.hom.app 𝒜₂))) h1
        exact (CategoryTheory.Category.assoc _ _ _).symm.trans
          (h1_assoc.trans (CategoryTheory.Category.assoc _ _ _))
      exact hL.trans
        ((congrArg ((cIso (P_B.obj 𝒜₁)).inv ≫ ·) h2).trans
          (CategoryTheory.Category.assoc _ _ _).symm)

    let hSE_Q_spec : ∀ (a : ℕ) (ℱ : 𝒞_D),
        (CategoryTheory.ShortComplex.mk ((ι_Q a).app ℱ) ((π_Q a).app ℱ)
          (Classical.choose (hSE_Q a ℱ))).ShortExact :=
      fun a ℱ => Classical.choose_spec (hSE_Q a ℱ)

    let δ₀_S : ∀ (a : ℕ) (ℱ : 𝒞_D), R_f 0 ((Q (a + 1)).obj ℱ) ⟶ R_f 1 ((Q a).obj ℱ) :=
      fun a ℱ => sh_C.map (CategoryTheory.Functor.whiskerLeft B.op (δ (hSE_Q_spec a ℱ) 0))

    have hδ₀_S_nat : ∀ (a : ℕ) {ℱ₁ ℱ₂ : 𝒞_D} (φ : ℱ₁ ⟶ ℱ₂),
        R_map 0 ((Q (a + 1)).map φ) ≫ δ₀_S a ℱ₂ = δ₀_S a ℱ₁ ≫ R_map 1 ((Q a).map φ) := by
      intro a ℱ₁ ℱ₂ φ
      dsimp [R_map, δ₀_S]
      rw [← sh_C.map_comp, ← sh_C.map_comp, ← CategoryTheory.Functor.whiskerLeft_comp,
        ← CategoryTheory.Functor.whiskerLeft_comp]
      congr 2
      exact hδ_nat (hSE_Q_spec a ℱ₁) (hSE_Q_spec a ℱ₂)
        ((Q a).map φ) ((I_res a).map φ) ((Q (a + 1)).map φ)
        ((ι_Q a).naturality φ).symm ((π_Q a).naturality φ).symm 0

    have hδ₀_S_colim : ∀ (a : ℕ) (ℱ : 𝒞_D),
        ∃ hw_S : R_map 0 ((π_Q a).app ℱ) ≫ δ₀_S a ℱ = 0,
          Nonempty (CategoryTheory.Limits.IsColimit
            (CategoryTheory.Limits.CokernelCofork.ofπ (δ₀_S a ℱ) hw_S)) := by
      intro a ℱ
      obtain ⟨hw_psh, ⟨hc_psh⟩⟩ :=
        ((hδ_acyc (hSE_Q_spec a ℱ) (hLocG ((Q a).obj ℱ))).1 B)
      exact hShColim
        (CategoryTheory.Functor.whiskerLeft B.op ((H_psh 0).map ((π_Q a).app ℱ)))
        (CategoryTheory.Functor.whiskerLeft B.op (δ (hSE_Q_spec a ℱ) 0))
        hw_psh hc_psh

    let Δ : ∀ (a k : ℕ), 1 ≤ k → ∀ (ℱ : 𝒞_D),
        R_f k ((Q (a + 1)).obj ℱ) ≅ R_f (k + 1) ((Q a).obj ℱ) :=
      fun a k hk ℱ =>
        letI : CategoryTheory.IsIso (δ (hSE_Q_spec a ℱ) k) :=
          (hδ_acyc (hSE_Q_spec a ℱ) (hLocG ((Q a).obj ℱ))).2 k hk
        sh_C.mapIso (CategoryTheory.Functor.isoWhiskerLeft B.op
          (CategoryTheory.asIso (δ (hSE_Q_spec a ℱ) k)))

    have hΔ_nat : ∀ (a k : ℕ) (hk : 1 ≤ k) {ℱ₁ ℱ₂ : 𝒞_D} (φ : ℱ₁ ⟶ ℱ₂),
        R_map k ((Q (a + 1)).map φ) ≫ (Δ a k hk ℱ₂).hom =
          (Δ a k hk ℱ₁).hom ≫ R_map (k + 1) ((Q a).map φ) := by
      intro a k hk ℱ₁ ℱ₂ φ
      dsimp [R_map, Δ]
      rw [← sh_C.map_comp, ← sh_C.map_comp, ← CategoryTheory.Functor.whiskerLeft_comp,
        ← CategoryTheory.Functor.whiskerLeft_comp]
      congr 2
      exact hδ_nat (hSE_Q_spec a ℱ₁) (hSE_Q_spec a ℱ₂)
        ((Q a).map φ) ((I_res a).map φ) ((Q (a + 1)).map φ)
        ((ι_Q a).naturality φ).symm ((π_Q a).naturality φ).symm k

    let shiftIso : ∀ (a k d : ℕ), 1 ≤ k → k + a = d → ∀ (ℱ : 𝒞_D),
        R_f k ((Q a).obj ℱ) ≅ R_f d ℱ :=
      fun a => Nat.rec
        (motive := fun a => ∀ (k d : ℕ), 1 ≤ k → k + a = d → ∀ (ℱ : 𝒞_D),
          R_f k ((Q a).obj ℱ) ≅ R_f d ℱ)
        (fun k d _ hd ℱ =>
          hd.recOn
            { hom := R_map k (iso_Q0.hom.app ℱ)
              inv := R_map k (iso_Q0.inv.app ℱ)
              hom_inv_id := by
                rw [← hR_map_comp, iso_Q0.hom_inv_id_app, hR_map_id]
              inv_hom_id := by
                rw [← hR_map_comp, iso_Q0.inv_hom_id_app]
                exact hR_map_id k ((CategoryTheory.Functor.id 𝒞_D).obj ℱ) })
        (fun a ih k d hk hd ℱ =>
          (Δ a k hk ℱ).trans (ih (k + 1) d (Nat.le_add_left 1 k) (by omega) ℱ))
        a

    have hshiftIso_nat : ∀ (a k d : ℕ) (hk : 1 ≤ k) (hd : k + a = d)
        {ℱ₁ ℱ₂ : 𝒞_D} (φ : ℱ₁ ⟶ ℱ₂),
        R_map k ((Q a).map φ) ≫ (shiftIso a k d hk hd ℱ₂).hom =
          (shiftIso a k d hk hd ℱ₁).hom ≫ R_map d φ := by
      intro a
      induction a with
      | zero =>
        intro k d hk hd ℱ₁ ℱ₂ φ
        cases hd
        change R_map k ((Q 0).map φ) ≫ R_map k (iso_Q0.hom.app ℱ₂) =
          R_map k (iso_Q0.hom.app ℱ₁) ≫ R_map k ((CategoryTheory.Functor.id 𝒞_D).map φ)
        rw [← hR_map_comp, ← hR_map_comp, iso_Q0.hom.naturality φ]
      | succ a ih =>
        intro k d hk hd ℱ₁ ℱ₂ φ
        have hstep : ∀ ℱ : 𝒞_D, (shiftIso (a + 1) k d hk hd ℱ).hom =
            (Δ a k hk ℱ).hom ≫
              (shiftIso a (k + 1) d (Nat.le_add_left 1 k) (by omega) ℱ).hom :=
          fun _ => rfl
        rw [hstep ℱ₁, hstep ℱ₂, ← CategoryTheory.Category.assoc, hΔ_nat a k hk φ,
          CategoryTheory.Category.assoc,
          ih (k + 1) d (Nat.le_add_left 1 k) (by omega) φ, ← CategoryTheory.Category.assoc]

    let π_H : ∀ (q : ℕ) (ℱ : 𝒞_D), (Z_sh q).obj ℱ ⟶ R_f q ℱ := fun q ℱ =>
      match q with
      | 0 => P_B.map (iso_Q0.hom.app ℱ) ≫ (e₀ ℱ).hom
      | q' + 1 =>
        (e₀ ((Q (q' + 1)).obj ℱ)).hom ≫ δ₀_S q' ℱ ≫
          (shiftIso q' 1 (q' + 1) (le_refl 1) (Nat.add_comm 1 q') ℱ).hom

    refine ⟨Q, iso_Q0, B_sh, ι_Q, π_Q, ι_Z, d_tilde, j_B, π_H,
      hB0, hSE_Q, hSE_im, ?_, ?_, hTor_Z⟩
    · intro q ℱ
      cases q with
      | zero =>
        dsimp [π_H]
        haveI : CategoryTheory.IsIso (P_B.map (iso_Q0.hom.app ℱ)) :=
          (P_B.mapIso (iso_Q0.app ℱ)).isIso_hom
        haveI : CategoryTheory.IsIso (P_B.map (iso_Q0.hom.app ℱ) ≫ (e₀ ℱ).hom) :=
          inferInstance
        exact hUp0 ℱ (P_B.map (iso_Q0.hom.app ℱ) ≫ (e₀ ℱ).hom) inferInstance
      | succ q' =>
        dsimp [π_H]
        obtain ⟨hw_S, ⟨hc_S⟩⟩ := hδ₀_S_colim q' ℱ
        let e_I := e₀ ((I_res q').obj ℱ)
        let e_Q := e₀ ((Q (q' + 1)).obj ℱ)
        let e_sh := shiftIso q' 1 (q' + 1) (le_refl 1) (Nat.add_comm 1 q') ℱ
        have hw : P_B.map ((π_Q q').app ℱ) ≫ (e_Q.hom ≫ δ₀_S q' ℱ ≫ e_sh.hom) = 0 := by
          rw [← CategoryTheory.Category.assoc, he₀_nat ((π_Q q').app ℱ),
            CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (R_map 0 _), hw_S,
            CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
        haveI : CategoryTheory.Epi (δ₀_S q' ℱ) :=
          CategoryTheory.Limits.epi_of_isColimit_cofork hc_S
        have hc : CategoryTheory.Limits.IsColimit
            (CategoryTheory.Limits.CokernelCofork.ofπ
              (e_Q.hom ≫ δ₀_S q' ℱ ≫ e_sh.hom) hw) :=
          CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ
