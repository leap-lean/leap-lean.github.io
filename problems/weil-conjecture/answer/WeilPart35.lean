                  CategoryTheory.IsPullback p_C₁
                    ((Fgt_W.obj (weilEtaleCechObj u_bar p)).hom ≫ snd_W) C₁.hom
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k))) ∧
                  p_C₁ ≫ c₁_W = (Fgt_W.obj (weilEtaleCechObj u_bar p)).hom ≫ pr_W) ∧
