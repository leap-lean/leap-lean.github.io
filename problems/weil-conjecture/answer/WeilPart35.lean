      (hSup_N : (⨆ a : Fin (N + 1), D_N a) = ⊤)
      (hc_hom_N : ∀ a : Fin (N + 1),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_NS a)) = (hAff_NS a).fromSpec ≫ p_NS)
      (ht_diag_N : ∀ a : Fin (N + 1), t_NS a a = 1)
      (hCl_N : ∀ a : Fin (N + 1), Subring.closure (Set.range (c_NS a) ∪ Set.range (t_NS a)) = ⊤)
