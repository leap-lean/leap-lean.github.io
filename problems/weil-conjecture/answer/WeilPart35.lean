            ((hab (Fin.last (p + 1))).trans (congrArg (b ≫ ·) (hProjLastL f p)))

    have hUnitPullNat : ∀ {X₁ X₂ : W₀.left.Etale} {Y₁ Y₂ : W_bar.Etale}
        (g₀ : Quiver.Hom X₁ X₂) (g_bar : Quiver.Hom Y₁ Y₂)
        (p₁ : (Fgt_W.obj Y₁).left ⟶ (Fgt_0.obj X₁).left)
        (p₂ : (Fgt_W.obj Y₂).left ⟶ (Fgt_0.obj X₂).left)
        (hp₁ : p₁ ≫ (Fgt_0.obj X₁).hom = (Fgt_W.obj Y₁).hom ≫ pr_W)
        (hp₂ : p₂ ≫ (Fgt_0.obj X₂).hom = (Fgt_W.obj Y₂).hom ≫ pr_W),
        (Fgt_W.map g_bar).left ≫ p₂ = p₁ ≫ (Fgt_0.map g₀).left →
        ∀ (𝒜 : CategoryTheory.Sheaf W₀.left.smallEtaleTopology AddCommGrpCat.{u})
          (x : ↑(𝒜.obj.obj (Opposite.op X₂))),
          let σ₁ : Quiver.Hom Y₁ (B_prW.obj X₁) :=
            CategoryTheory.MorphismProperty.Over.homMk
              (CategoryTheory.Limits.pullback.lift p₁ (Fgt_W.obj Y₁).hom hp₁)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          let σ₂ : Quiver.Hom Y₂ (B_prW.obj X₂) :=
            CategoryTheory.MorphismProperty.Over.homMk
              (CategoryTheory.Limits.pullback.lift p₂ (Fgt_W.obj Y₂).hom hp₂)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          ((L_prW.obj 𝒜).obj.map (Opposite.op σ₁)).hom
            (((adj_prW.unit.app 𝒜).hom.app (Opposite.op X₁)).hom
              ((𝒜.obj.map (Opposite.op g₀)).hom x)) =
          ((L_prW.obj 𝒜).obj.map (Opposite.op g_bar)).hom
            (((L_prW.obj 𝒜).obj.map (Opposite.op σ₂)).hom
              (((adj_prW.unit.app 𝒜).hom.app (Opposite.op X₂)).hom x)) := by
      intro X₁ X₂ Y₁ Y₂ g₀ g_bar p₁ p₂ hp₁ hp₂ hcomm_p 𝒜 x σ₁ σ₂
      have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) pr_W :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) pr_W :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      have hB_map : (B_prW.map g₀).left =
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (Fgt_0.obj X₁).hom pr_W ≫ (Fgt_0.map g₀).left)
            (CategoryTheory.Limits.pullback.snd (Fgt_0.obj X₁).hom pr_W)
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg _ (CategoryTheory.MorphismProperty.Over.w g₀)).trans
                CategoryTheory.Limits.pullback.condition)) :=
        CategoryTheory.MorphismProperty.Over.pullback_map_left
          (@AlgebraicGeometry.Etale) ⊤ pr_W g₀
      have hσ_comm : g_bar ≫ σ₂ = σ₁ ≫ B_prW.map g₀ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        change (Fgt_W.map g_bar).left ≫ σ₂.left = σ₁.left ≫ (B_prW.map g₀).left
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg _ (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (hcomm_p.trans
                (((CategoryTheory.Category.assoc σ₁.left _ _).trans
                  ((congrArg (σ₁.left ≫ ·)
                    ((congrArg (· ≫ _) hB_map).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      (congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))).symm)))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg _ (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              ((CategoryTheory.MorphismProperty.Over.w g_bar).trans
                (((CategoryTheory.Category.assoc σ₁.left _ _).trans
                  ((congrArg (σ₁.left ≫ ·)
                    ((congrArg (· ≫ _) hB_map).trans
                      (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _))).symm)))
      have hnat := congrArg (fun α => α.hom x)
        ((adj_prW.unit.app 𝒜).hom.naturality (Opposite.op g₀))
      change (((adj_prW.unit.app 𝒜).hom.app (Opposite.op X₁)).hom
          ((𝒜.obj.map (Opposite.op g₀)).hom x)) =
        ((L_prW.obj 𝒜).obj.map (Opposite.op (B_prW.map g₀))).hom
          (((adj_prW.unit.app 𝒜).hom.app (Opposite.op X₂)).hom x) at hnat
      rw [hnat]
      let y₂ := ((adj_prW.unit.app 𝒜).hom.app (Opposite.op X₂)).hom x
      have hm1 : ((L_prW.obj 𝒜).obj.map (Opposite.op (g_bar ≫ σ₂))).hom y₂ =
          ((L_prW.obj 𝒜).obj.map (Opposite.op g_bar)).hom
            (((L_prW.obj 𝒜).obj.map (Opposite.op σ₂)).hom y₂) :=
        congrArg (fun φ => φ.hom y₂)
          ((L_prW.obj 𝒜).obj.map_comp (Opposite.op σ₂) (Opposite.op g_bar))
      have hm2 : ((L_prW.obj 𝒜).obj.map (Opposite.op (σ₁ ≫ B_prW.map g₀))).hom y₂ =
          ((L_prW.obj 𝒜).obj.map (Opposite.op σ₁)).hom
            (((L_prW.obj 𝒜).obj.map (Opposite.op (B_prW.map g₀))).hom y₂) :=
        congrArg (fun φ => φ.hom y₂)
          ((L_prW.obj 𝒜).obj.map_comp (Opposite.op (B_prW.map g₀)) (Opposite.op σ₁))
      exact hm2.symm.trans
        ((congrArg (fun g => ((L_prW.obj 𝒜).obj.map (Opposite.op g)).hom y₂) hσ_comm.symm).trans hm1)

    have hBuildCechCube : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
        {U_t Z_t : S₁.Etale} (w_t : U_t ⟶ Z_t)
        {U_b Z_b : S₂.Etale} (w_b : U_b ⟶ Z_b)
        (p_Z : Z_t.left ⟶ Z_b.left) (p_U : U_t.left ⟶ U_b.left),
        CategoryTheory.IsPullback p_U w_t.left w_b.left p_Z →
        ∃ (p_C : ∀ p : ℕ, (weilEtaleCechObj w_t p).left ⟶ (weilEtaleCechObj w_b p).left),
          (∀ p : ℕ, CategoryTheory.IsPullback (p_C p) (weilEtaleCechHom w_t p).left
            (weilEtaleCechHom w_b p).left p_Z) ∧
          (∀ (p : ℕ) (m : Fin (p + 1)),
            (weilEtaleCechProj w_t p m).left ≫ p_U =
              p_C p ≫ (weilEtaleCechProj w_b p m).left) := by
      intro S₁ S₂ U_t Z_t w_t U_b Z_b w_b p_Z p_U hpb_0
      let U_sch₁ := (AlgebraicGeometry.Scheme.Etale.forget S₁).comp (CategoryTheory.Over.forget S₁)
      let U_sch₂ := (AlgebraicGeometry.Scheme.Etale.forget S₂).comp (CategoryTheory.Over.forget S₂)
      let pkg : ∀ p : ℕ,
          { p_C : (weilEtaleCechObj w_t p).left ⟶ (weilEtaleCechObj w_b p).left //
            CategoryTheory.IsPullback p_C (weilEtaleCechHom w_t p).left
              (weilEtaleCechHom w_b p).left p_Z ∧
            ∀ m : Fin (p + 1),
              (weilEtaleCechProj w_t p m).left ≫ p_U =
                p_C ≫ (weilEtaleCechProj w_b p m).left } :=
        Nat.rec
          ⟨p_U, hpb_0, fun m => by
            have hm := Fin.eq_zero m; subst hm
            exact (CategoryTheory.Category.id_comp p_U).trans (CategoryTheory.Category.comp_id p_U).symm⟩
          (fun p prev =>
            let p_C := prev.1
            let hpb_C := prev.2.1
            let hproj_C := prev.2.2
            let c_t := weilEtaleCechHom w_t p
            let c_b := weilEtaleCechHom w_b p
            let fst_t := CategoryTheory.Limits.pullback.fst c_t w_t
            let snd_t := CategoryTheory.Limits.pullback.snd c_t w_t
            let fst_b := CategoryTheory.Limits.pullback.fst c_b w_b
            let snd_b := CategoryTheory.Limits.pullback.snd c_b w_b
            let hpb_t : CategoryTheory.IsPullback fst_t.left snd_t.left c_t.left w_t.left :=
              (CategoryTheory.IsPullback.of_hasPullback c_t w_t).map U_sch₁
            let hpb_b : CategoryTheory.IsPullback fst_b.left snd_b.left c_b.left w_b.left :=
              (CategoryTheory.IsPullback.of_hasPullback c_b w_b).map U_sch₂
            let hcomm : (fst_t.left ≫ p_C) ≫ c_b.left = (snd_t.left ≫ p_U) ≫ w_b.left :=
              (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (fst_t.left ≫ ·) hpb_C.w).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ p_Z) hpb_t.w).trans
                      ((CategoryTheory.Category.assoc _ _ _).trans
                        ((congrArg (snd_t.left ≫ ·) hpb_0.w.symm).trans
                          (CategoryTheory.Category.assoc _ _ _).symm)))))
            let p_C1 := hpb_b.lift (fst_t.left ≫ p_C) (snd_t.left ≫ p_U) hcomm
            ⟨p_C1,
              hCubeStep fst_t.left snd_t.left c_t.left w_t.left
                fst_b.left snd_b.left c_b.left w_b.left p_C p_U p_Z p_C1
                hpb_t hpb_b hpb_C hpb_0 (hpb_b.lift_fst _ _ _) (hpb_b.lift_snd _ _ _),
              fun m => by
                refine Fin.lastCases ?_ ?_ m
                · exact (congrArg (· ≫ p_U) (hProjLastL w_t p)).trans
                    ((hpb_b.lift_snd _ _ _).symm.trans
                      (congrArg (p_C1 ≫ ·) (hProjLastL w_b p).symm))
                · intro i
                  exact (congrArg (· ≫ p_U) (hProjCastSuccL w_t p i)).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      ((congrArg (fst_t.left ≫ ·) (hproj_C i)).trans
                        ((CategoryTheory.Category.assoc _ _ _).symm.trans
                          ((congrArg (· ≫ _) (hpb_b.lift_fst _ _ _).symm).trans
                            ((CategoryTheory.Category.assoc _ _ _).trans
                              (congrArg (p_C1 ≫ ·) (hProjCastSuccL w_b p i).symm))))))⟩)
      exact ⟨fun p => (pkg p).1, fun p => (pkg p).2.1, fun p m => (pkg p).2.2 m⟩

    intro E₀ _ _ _ _ _ Z₀ _ z_W _ hz_W Z_bar p_Z hp_Z hp_Z_W
      E₁ _ _ _ _ _ _ _ _ U₁ _ u₁ _ _ U_bar u_bar p_U hu₁_hom hp_U hu_bar_pZ

    let g_F0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₀))
    let g_F1 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₁))
    let g_01 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))
    let g_0k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ k))
    let g_1k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k))
    have hg_10k : g_1k ≫ g_01 = g_0k := hSpecTower E₀ E₁ k
    have hg_01F : g_01 ≫ g_F0 = g_F1 := hSpecTower F E₀ E₁
    have : AlgebraicGeometry.Etale g_01 := hEtSpecFin E₀ E₁

    let Z₁_left := CategoryTheory.Limits.pullback Z₀.hom g_01
    let fst_Z₁ : Z₁_left ⟶ Z₀.left := CategoryTheory.Limits.pullback.fst Z₀.hom g_01
    let Z₁_hom : Z₁_left ⟶ AlgebraicGeometry.Spec (CommRingCat.of E₁) :=
      CategoryTheory.Limits.pullback.snd Z₀.hom g_01
    let hpb_Z01 : CategoryTheory.IsPullback fst_Z₁ Z₁_hom Z₀.hom g_01 :=
      CategoryTheory.IsPullback.of_hasPullback Z₀.hom g_01
    have : AlgebraicGeometry.Etale fst_Z₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z01.flip inferInstance
    have : AlgebraicGeometry.IsSeparated Z₁_hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z01 inferInstance
    let z₁_W : Z₁_left ⟶ W₀.left := fst_Z₁ ≫ z_W
    have hz₁_et : AlgebraicGeometry.Etale z₁_W := inferInstance
    have hz₁_W : z₁_W ≫ W₀.hom = Z₁_hom ≫ g_F1 := by
      change (fst_Z₁ ≫ z_W) ≫ W₀.hom = Z₁_hom ≫ g_F1
      rw [CategoryTheory.Category.assoc, hz_W, ← CategoryTheory.Category.assoc,
        hpb_Z01.w, CategoryTheory.Category.assoc, hg_01F]

    have : AlgebraicGeometry.IsAffineHom U₁.hom :=
      AlgebraicGeometry.isAffineHom_of_isAffine U₁.hom
    have : AlgebraicGeometry.IsAffineHom (u₁ ≫ Z₁_hom) := by
      rwa [hu₁_hom]
    have hAff_u₁ : AlgebraicGeometry.IsAffineHom u₁ :=
      AlgebraicGeometry.IsAffineHom.of_comp u₁ Z₁_hom

    have hcomm_pZ₁ : p_Z ≫ Z₀.hom = (((Fgt_W.obj Z_bar).hom ≫ snd_W) ≫ g_1k) ≫ g_01 := by
      rw [CategoryTheory.Category.assoc, hg_10k]
      exact hp_Z.w
    let p_Z₁ : (Fgt_W.obj Z_bar).left ⟶ Z₁_left :=
      CategoryTheory.Limits.pullback.lift p_Z (((Fgt_W.obj Z_bar).hom ≫ snd_W) ≫ g_1k) hcomm_pZ₁
    have hp_Z₁_fst : p_Z₁ ≫ fst_Z₁ = p_Z := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hp_Z₁_snd : p_Z₁ ≫ Z₁_hom = ((Fgt_W.obj Z_bar).hom ≫ snd_W) ≫ g_1k :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hp_Z₁_W : p_Z₁ ≫ z₁_W = (Fgt_W.obj Z_bar).hom ≫ pr_W := by
      dsimp only [z₁_W]
      rw [← CategoryTheory.Category.assoc, hp_Z₁_fst, hp_Z_W]
    have hp_Z₁ : CategoryTheory.IsPullback p_Z₁ ((Fgt_W.obj Z_bar).hom ≫ snd_W) Z₁_hom g_1k := by
      refine CategoryTheory.IsPullback.of_right ?_ hp_Z₁_snd hpb_Z01
      rwa [hp_Z₁_fst, hg_10k]
    have hu₁_Z₁ : u₁ ≫ Z₁_hom = U₁.hom := hu₁_hom
    have hu_pZ₁ : (Fgt_W.map u_bar).left ≫ p_Z₁ = p_U ≫ u₁ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change ((Fgt_W.map u_bar).left ≫ p_Z₁) ≫ fst_Z₁ = (p_U ≫ u₁) ≫ fst_Z₁
        rw [CategoryTheory.Category.assoc, hp_Z₁_fst, hu_bar_pZ, CategoryTheory.Category.assoc]
      · change ((Fgt_W.map u_bar).left ≫ p_Z₁) ≫ Z₁_hom = (p_U ≫ u₁) ≫ Z₁_hom
        rw [CategoryTheory.Category.assoc, hp_Z₁_snd, CategoryTheory.Category.assoc p_U u₁ Z₁_hom,
          hu₁_Z₁, hp_U.w]
        simp only [← CategoryTheory.Category.assoc]
        exact congrArg (fun m => (m ≫ snd_W) ≫ g_1k) (Fgt_W.map u_bar).w
    have hpb_u : CategoryTheory.IsPullback p_U (Fgt_W.map u_bar).left u₁ p_Z₁ := by
      refine CategoryTheory.IsPullback.of_bot ?_ hu_pZ₁.symm hp_Z₁
      have hw_ubar : (Fgt_W.map u_bar).left ≫ ((Fgt_W.obj Z_bar).hom ≫ snd_W) =
          (Fgt_W.obj U_bar).hom ≫ snd_W :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ snd_W) (Fgt_W.map u_bar).w)
      rwa [hw_ubar, hu₁_Z₁]

    let Z₁_et : W₀.left.Etale := @AlgebraicGeometry.Scheme.Etale.mk W₀.left Z₁_left z₁_W hz₁_et
    let u₁_W : U₁.left ⟶ W₀.left := u₁ ≫ z₁_W
    let U₁_et : W₀.left.Etale := @AlgebraicGeometry.Scheme.Etale.mk W₀.left U₁.left u₁_W inferInstance
    let w₁ : Quiver.Hom U₁_et Z₁_et := CategoryTheory.MorphismProperty.Over.homMk u₁ rfl

    have hAff_C₁ : ∀ p : ℕ, AlgebraicGeometry.IsAffine (weilEtaleCechObj w₁ p).left := by
      let U_sch₀ := Fgt_0.comp (CategoryTheory.Over.forget W₀.left)
      intro p
      induction p with
      | zero => exact ‹AlgebraicGeometry.IsAffine U₁.left›
      | succ p ih =>
        have : AlgebraicGeometry.IsAffine (weilEtaleCechObj w₁ p).left := ih
        have hpb_step : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w₁ p) w₁).left
            (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w₁ p) w₁).left
            (weilEtaleCechHom w₁ p).left u₁ :=
          (CategoryTheory.IsPullback.of_hasPullback (weilEtaleCechHom w₁ p) w₁).map U_sch₀
        have : AlgebraicGeometry.IsAffineHom
            (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w₁ p) w₁).left :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_step.flip hAff_u₁
        exact @AlgebraicGeometry.isAffine_of_isAffineHom _ _
          (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w₁ p) w₁).left this ih

    obtain ⟨p_C₁, hpb_C₁_cube, hproj_C₁_cube⟩ := hBuildCechCube u_bar w₁ p_Z₁ p_U hpb_u
    let C₁_ov : ℕ → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₁)) :=
      fun p => CategoryTheory.Over.mk ((weilEtaleCechHom w₁ p).left ≫ Z₁_hom)
    let c₁_W : ∀ p : ℕ, (C₁_ov p).left ⟶ W₀.left :=
      fun p => (weilEtaleCechObj w₁ p).hom
    have hc₁_et : ∀ p : ℕ, AlgebraicGeometry.Etale (c₁_W p) :=
      fun p => (weilEtaleCechObj w₁ p).prop
    have hc₁_W_hom : ∀ p : ℕ, c₁_W p ≫ W₀.hom = (C₁_ov p).hom ≫ g_F1 := by
      intro p
      have hw_p : (weilEtaleCechHom w₁ p).left ≫ z₁_W = c₁_W p :=
        CategoryTheory.MorphismProperty.Over.w (weilEtaleCechHom w₁ p)
      exact (congrArg (· ≫ W₀.hom) hw_p.symm).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg ((weilEtaleCechHom w₁ p).left ≫ ·) hz₁_W).trans
            (CategoryTheory.Category.assoc _ _ _).symm))
    have hp_C₁_pb : ∀ p : ℕ,
        CategoryTheory.IsPullback (p_C₁ p)
          ((Fgt_W.obj (weilEtaleCechObj u_bar p)).hom ≫ snd_W) (C₁_ov p).hom g_1k := by
      intro p
      have h_vert := (hpb_C₁_cube p).paste_vert hp_Z₁
      have hw_bar : (weilEtaleCechHom u_bar p).left ≫ ((Fgt_W.obj Z_bar).hom ≫ snd_W) =
          (Fgt_W.obj (weilEtaleCechObj u_bar p)).hom ≫ snd_W :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ snd_W) (Fgt_W.map (weilEtaleCechHom u_bar p)).w)
      exact Eq.mp (congrArg (fun m => CategoryTheory.IsPullback (p_C₁ p) m (C₁_ov p).hom g_1k)
        hw_bar) h_vert
    have hp_C₁_W : ∀ p : ℕ,
        p_C₁ p ≫ c₁_W p = (Fgt_W.obj (weilEtaleCechObj u_bar p)).hom ≫ pr_W := by
      intro p
      have hw_p : (weilEtaleCechHom w₁ p).left ≫ z₁_W = c₁_W p :=
        CategoryTheory.MorphismProperty.Over.w (weilEtaleCechHom w₁ p)
      have hw_bar : (weilEtaleCechHom u_bar p).left ≫ (Fgt_W.obj Z_bar).hom =
          (Fgt_W.obj (weilEtaleCechObj u_bar p)).hom :=
        (Fgt_W.map (weilEtaleCechHom u_bar p)).w
      exact (congrArg (p_C₁ p ≫ ·) hw_p.symm).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ z₁_W) (hpb_C₁_cube p).w).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg ((weilEtaleCechHom u_bar p).left ≫ ·) hp_Z₁_W).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ pr_W) hw_bar))))))

    refine ⟨?_, ?_⟩
    · intro p
      have : AlgebraicGeometry.IsAffine (C₁_ov p).left := hAff_C₁ p
      exact ⟨C₁_ov p, inferInstance, inferInstance, c₁_W p, hc₁_et p, p_C₁ p,
        hc₁_W_hom p, hp_C₁_pb p, hp_C₁_W p⟩
    · intro 𝒜 d s_bar hs_bar
      have : AlgebraicGeometry.IsAffine (C₁_ov d).left := hAff_C₁ d
      have : CompactSpace ↥(C₁_ov d).left := inferInstance
      have : AlgebraicGeometry.Etale (c₁_W d) := hc₁_et d
      obtain ⟨E₂, hFin₂, hFld₂, hAlgF₂, hAlg12, hAlg2k, hST_F12, hST_12k, hST_F2k,
        hz₂_tilde_et, p_tilde, hp_tilde_W, hp_tilde_fst, hp_tilde_snd, s₁, hs₁⟩ :=
        hSecSurj E₁ (C₁_ov d) (c₁_W d) (hc₁_W_hom d)
          (weilEtaleCechObj u_bar d) (p_C₁ d) (hp_C₁_pb d) (hp_C₁_W d) 𝒜 s_bar
      have : Finite E₂ := hFin₂
      let : Field E₂ := hFld₂
      let : Algebra F E₂ := hAlgF₂
      let : Algebra E₁ E₂ := hAlg12
      let : Algebra E₂ k := hAlg2k
      have : IsScalarTower F E₁ E₂ := hST_F12
      have : IsScalarTower E₁ E₂ k := hST_12k
      have : IsScalarTower F E₂ k := hST_F2k

      let g_F2 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₂))
      let g_12 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ E₂))
      let g_2k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₂ k))
      have hg_21k : g_2k ≫ g_12 = g_1k := hSpecTower E₁ E₂ k
      have hg_12F : g_12 ≫ g_F1 = g_F2 := hSpecTower F E₁ E₂
      have : AlgebraicGeometry.Etale g_12 := hEtSpecFin E₁ E₂

      let Z₂_left := CategoryTheory.Limits.pullback Z₁_hom g_12
      let q_Z21 : Z₂_left ⟶ Z₁_left := CategoryTheory.Limits.pullback.fst Z₁_hom g_12
      let Z₂_hom : Z₂_left ⟶ AlgebraicGeometry.Spec (CommRingCat.of E₂) :=
        CategoryTheory.Limits.pullback.snd Z₁_hom g_12
      let hpb_Z21 : CategoryTheory.IsPullback q_Z21 Z₂_hom Z₁_hom g_12 :=
        CategoryTheory.IsPullback.of_hasPullback Z₁_hom g_12
      have : AlgebraicGeometry.Etale q_Z21 :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z21.flip inferInstance
      let z₂_W : Z₂_left ⟶ W₀.left := q_Z21 ≫ z₁_W
      have hz₂_et : AlgebraicGeometry.Etale z₂_W := inferInstance
      have hz₂_W : z₂_W ≫ W₀.hom = Z₂_hom ≫ g_F2 := by
        change (q_Z21 ≫ z₁_W) ≫ W₀.hom = Z₂_hom ≫ g_F2
        rw [CategoryTheory.Category.assoc, hz₁_W, ← CategoryTheory.Category.assoc,
          hpb_Z21.w, CategoryTheory.Category.assoc, hg_12F]

      let U₂_left := CategoryTheory.Limits.pullback U₁.hom g_12
      let q_U21 : U₂_left ⟶ U₁.left := CategoryTheory.Limits.pullback.fst U₁.hom g_12
      let U₂_hom : U₂_left ⟶ AlgebraicGeometry.Spec (CommRingCat.of E₂) :=
        CategoryTheory.Limits.pullback.snd U₁.hom g_12
      let hpb_U21 : CategoryTheory.IsPullback q_U21 U₂_hom U₁.hom g_12 :=
        CategoryTheory.IsPullback.of_hasPullback U₁.hom g_12
      have hcomm_u₂ : (q_U21 ≫ u₁) ≫ Z₁_hom = U₂_hom ≫ g_12 := by
        rw [CategoryTheory.Category.assoc, hu₁_hom, hpb_U21.w]
      let u₂ : U₂_left ⟶ Z₂_left := CategoryTheory.Limits.pullback.lift (q_U21 ≫ u₁) U₂_hom hcomm_u₂
      have hu₂_fst : u₂ ≫ q_Z21 = q_U21 ≫ u₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu₂_snd : u₂ ≫ Z₂_hom = U₂_hom := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_u21 : CategoryTheory.IsPullback q_U21 u₂ u₁ q_Z21 := by
        refine CategoryTheory.IsPullback.of_bot ?_ hu₂_fst.symm hpb_Z21
        rwa [hu₁_Z₁, hu₂_snd]
      have : AlgebraicGeometry.Etale u₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_u21 inferInstance
      have hu₂_surj : AlgebraicGeometry.Surjective u₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_u21 inferInstance

      let Z₂_et : W₀.left.Etale := @AlgebraicGeometry.Scheme.Etale.mk W₀.left Z₂_left z₂_W hz₂_et
      let u₂_W : U₂_left ⟶ W₀.left := u₂ ≫ z₂_W
      let U₂_et : W₀.left.Etale := @AlgebraicGeometry.Scheme.Etale.mk W₀.left U₂_left u₂_W inferInstance
      let w₂ : Quiver.Hom U₂_et Z₂_et := CategoryTheory.MorphismProperty.Over.homMk u₂ rfl

      have hcomm_pZ₂ : p_Z₁ ≫ Z₁_hom = (((Fgt_W.obj Z_bar).hom ≫ snd_W) ≫ g_2k) ≫ g_12 := by
        rw [CategoryTheory.Category.assoc, hg_21k]; exact hp_Z₁.w
      let p_Z₂ : (Fgt_W.obj Z_bar).left ⟶ Z₂_left :=
        CategoryTheory.Limits.pullback.lift p_Z₁ (((Fgt_W.obj Z_bar).hom ≫ snd_W) ≫ g_2k) hcomm_pZ₂
      have hp_Z₂_fst : p_Z₂ ≫ q_Z21 = p_Z₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hp_Z₂_snd : p_Z₂ ≫ Z₂_hom = ((Fgt_W.obj Z_bar).hom ≫ snd_W) ≫ g_2k :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hp_Z₂_W : p_Z₂ ≫ z₂_W = (Fgt_W.obj Z_bar).hom ≫ pr_W := by
        dsimp only [z₂_W]; rw [← CategoryTheory.Category.assoc, hp_Z₂_fst, hp_Z₁_W]
      have hp_Z₂ : CategoryTheory.IsPullback p_Z₂ ((Fgt_W.obj Z_bar).hom ≫ snd_W) Z₂_hom g_2k := by
        refine CategoryTheory.IsPullback.of_right ?_ hp_Z₂_snd hpb_Z21
        rwa [hp_Z₂_fst, hg_21k]

      have hcomm_pU₂ : p_U ≫ U₁.hom = (((Fgt_W.obj U_bar).hom ≫ snd_W) ≫ g_2k) ≫ g_12 := by
        rw [CategoryTheory.Category.assoc, hg_21k]; exact hp_U.w
      let p_U₂ : (Fgt_W.obj U_bar).left ⟶ U₂_left :=
        CategoryTheory.Limits.pullback.lift p_U (((Fgt_W.obj U_bar).hom ≫ snd_W) ≫ g_2k) hcomm_pU₂
      have hp_U₂_fst : p_U₂ ≫ q_U21 = p_U := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hp_U₂_snd : p_U₂ ≫ U₂_hom = ((Fgt_W.obj U_bar).hom ≫ snd_W) ≫ g_2k :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
