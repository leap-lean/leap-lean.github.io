        rw [hu₂_map]
        apply Subtype.ext
        change k.unop.2.1 ≫ (Fgt.map (w_k ≫ p₂)).left = i₂.unop.2.1
        rw [Fgt.map_comp]
        change k.unop.2.1 ≫ ((Fgt.map w_k).left ≫ snd_w') = i₂.unop.2.1
        rw [← CategoryTheory.Category.assoc, hwk_val]
        exact CategoryTheory.Limits.pullback.lift_snd i₁.unop.2.1 i₂.unop.2.1 hδ_comm
      refine ⟨k, Opposite.op ⟨u₁_hom, hu₁_compat⟩, Opposite.op ⟨u₂_hom, hu₂_compat⟩, ?_⟩
      change U_aff.map u₁_hom ≫ w₁ = U_aff.map u₂_hom ≫ w₂
      rw [hu₁_map, hu₂_map, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      congr 1
      exact CategoryTheory.MorphismProperty.Comma.Hom.ext
        CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
    have hFilt : CategoryTheory.IsFiltered PtNhdᵒᵖ := by
      let T_Z : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Z) inferInstance
      let γ_T : GeomLifts Z Ω₀ y₀ T_Z := ⟨y₀, CategoryTheory.Category.comp_id y₀⟩
      have : Nonempty PtNhdᵒᵖ := by
        obtain ⟨i₀, _, _⟩ := hShrink T_Z γ_T
        exact ⟨i₀⟩
      refine { cocone_objs := ?_, cocone_maps := ?_ }
      · intro i₁ i₂
        let w₁ : (stalkDiag.obj i₁).unop ⟶ T_Z :=
          CategoryTheory.MorphismProperty.Over.homMk (Fgt.obj (U_aff.obj i₁.unop.1)).hom
