      ext W x
      have hex :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj X_bar W) hSC_bar q (q + 1) rfl
      have hz : AddCommGrpCat.ofHom (hSC_bar.extClass.postcomp (Z_obj X_bar W) rfl) ≫
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC_bar.f).postcomp (Z_obj X_bar W)
              (Nat.add_zero (q + 1))) = 0 :=
        (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
      have hzx := congrArg (fun φ => φ x) hz
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hfbar_app W]
      exact hzx
    let A₀_pre := CategoryTheory.ShortComplex.mk
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).map SC.g)
      δ₀_pre hcomp₀₁_pre
    let B₀_pre := CategoryTheory.ShortComplex.mk
      δ₀_pre
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology (q + 1)).map SC.f)
      hcomp₀₂_pre
    let Abar_pre := CategoryTheory.ShortComplex.mk
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X_bar.smallEtaleTopology q).map SC_bar.g)
      δbar_pre hcomp_b₁_pre
    let Bbar_pre := CategoryTheory.ShortComplex.mk
      δbar_pre
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X_bar.smallEtaleTopology (q + 1)).map
        SC_bar.f)
      hcomp_b₂_pre
    have hA₀_ex : A₀_pre.Exact := by
      apply hPresheafExact X₀ A₀_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X₀.Etale) AddCommGrpCat.{u}).obj W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj X₀ W) hSC q (q + 1) rfl
      let eW : A₀_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [A₀_pre, evW]; rw [hg₀_app W]; ext x; rfl)
          (by dsimp [A₀_pre, evW, δ₀_pre]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    have hB₀_ex : B₀_pre.Exact := by
      apply hPresheafExact X₀ B₀_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X₀.Etale) AddCommGrpCat.{u}).obj W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj X₀ W) hSC q (q + 1) rfl
      let eW : B₀_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [B₀_pre, evW, δ₀_pre]; ext x; rfl)
          (by dsimp [B₀_pre, evW]; rw [hf₀_app W]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    have hAbar_ex : Abar_pre.Exact := by
      apply hPresheafExact X_bar Abar_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X_bar.Etale) AddCommGrpCat.{u}).obj W
      have hex :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj X_bar W) hSC_bar q (q + 1) rfl
      let eW : Abar_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [Abar_pre, evW]; rw [hgbar_app W]; ext x; rfl)
          (by dsimp [Abar_pre, evW, δbar_pre]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    have hBbar_ex : Bbar_pre.Exact := by
      apply hPresheafExact X_bar Bbar_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X_bar.Etale) AddCommGrpCat.{u}).obj W
      have hex :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj X_bar W) hSC_bar q (q + 1) rfl
      let eW : Bbar_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [Bbar_pre, evW, δbar_pre]; ext x; rfl)
          (by dsimp [Bbar_pre, evW]; rw [hfbar_app W]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    let Δ₀ : (Φ_f₀ q).obj SC.X₃ ⟶ (Φ_f₀ (q + 1)).obj SC.X₁ := E_f₀.map δ₀_pre
    let Δ_bar : (Φ_fbar q).obj (L_prX.obj SC.X₃) ⟶ (Φ_fbar (q + 1)).obj (L_prX.obj SC.X₁) :=
      E_fbar.map δbar_pre
    have hcomp₀₁ : (Φ_f₀ q).map SC.g ≫ Δ₀ = 0 := by
      change E_f₀.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).map
          SC.g) ≫ E_f₀.map δ₀_pre = 0
      rw [← E_f₀.map_comp, hcomp₀₁_pre, E_f₀.map_zero]
    have hcomp₀₂ : Δ₀ ≫ (Φ_f₀ (q + 1)).map SC.f = 0 := by
      change E_f₀.map δ₀_pre ≫
          E_f₀.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor
            X₀.smallEtaleTopology (q + 1)).map SC.f) = 0
      rw [← E_f₀.map_comp, hcomp₀₂_pre, E_f₀.map_zero]
    have hcomp_b₁ : (Φ_fbar q).map (L_prX.map SC.g) ≫ Δ_bar = 0 := by
      change E_fbar.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor
          X_bar.smallEtaleTopology q).map SC_bar.g) ≫ E_fbar.map δbar_pre = 0
      rw [← E_fbar.map_comp, hcomp_b₁_pre, E_fbar.map_zero]
    have hcomp_b₂ : Δ_bar ≫ (Φ_fbar (q + 1)).map (L_prX.map SC.f) = 0 := by
      change E_fbar.map δbar_pre ≫
          E_fbar.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor
            X_bar.smallEtaleTopology (q + 1)).map SC_bar.f) = 0
      rw [← E_fbar.map_comp, hcomp_b₂_pre, E_fbar.map_zero]
    have hEx₀₁ : (CategoryTheory.ShortComplex.mk ((Φ_f₀ q).map SC.g) Δ₀ hcomp₀₁).Exact :=
      (hA₀_ex.map W_f₀).map (Sh_of Y₀)
    have hEx₀₂ : (CategoryTheory.ShortComplex.mk Δ₀ ((Φ_f₀ (q + 1)).map SC.f) hcomp₀₂).Exact :=
      (hB₀_ex.map W_f₀).map (Sh_of Y₀)
    have hEx_b₁ :
        (CategoryTheory.ShortComplex.mk ((Φ_fbar q).map (L_prX.map SC.g)) Δ_bar hcomp_b₁).Exact :=
      (hAbar_ex.map W_fbar).map (Sh_of Y_bar)
    have hEx_b₂ :
        (CategoryTheory.ShortComplex.mk Δ_bar ((Φ_fbar (q + 1)).map (L_prX.map SC.f))
          hcomp_b₂).Exact :=
      (hBbar_ex.map W_fbar).map (Sh_of Y_bar)
    have hLadder : L_prY.map Δ₀ ≫ θ (q + 1) SC.X₁ = θ q SC.X₃ ≫ Δ_bar := by
      let w_δ₀ : P₀_pre q SC.X₃ ⟶ P₀_pre (q + 1) SC.X₁ := W_f₀.map δ₀_pre
      let w_δbar : Pbar_pre q (L_prX.obj SC.X₃) ⟶ Pbar_pre (q + 1) (L_prX.obj SC.X₁) :=
        W_fbar.map δbar_pre
      have hβ_δ : w_δ₀ ≫ β_pre (q + 1) SC.X₁ =
          β_pre q SC.X₃ ≫ CategoryTheory.Functor.whiskerLeft B_prY.op w_δbar := by
        ext W α
        let V := Opposite.unop W
        let α₀ : CategoryTheory.Abelian.Ext ((Z_fun X₀).obj (B_f₀.obj V)) SC.X₃ q := α
        change (CategoryTheory.Abelian.Ext.mk₀ (ψ_yon V)).comp
            (L_prX.mapExtAddHom _ SC.X₁ (q + 1) (α₀.comp hSC.extClass rfl))
            (Nat.zero_add (q + 1)) =
          ((CategoryTheory.Abelian.Ext.mk₀ (ψ_yon V)).comp
            (L_prX.mapExtAddHom _ SC.X₃ q α₀) (Nat.zero_add q)).comp hSC_bar.extClass rfl
        rw [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass L_prX hSC,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.zero_add q) rfl (by omega)]
      have h_unit_raw :
          CategoryTheory.Functor.whiskerLeft B_prY.op w_δbar ≫
            CategoryTheory.Functor.whiskerLeft B_prY.op
              ((adj_sh_of Y_bar).unit.app (Pbar_pre (q + 1) (L_prX.obj SC.X₁))) =
          CategoryTheory.Functor.whiskerLeft B_prY.op
              ((adj_sh_of Y_bar).unit.app (Pbar_pre q (L_prX.obj SC.X₃))) ≫
            CategoryTheory.Functor.whiskerLeft B_prY.op
              ((U_of Y_bar).map ((Sh_of Y_bar).map w_δbar)) := by
        rw [← CategoryTheory.Functor.whiskerLeft_comp,
          ← CategoryTheory.Functor.whiskerLeft_comp]
        exact congrArg (CategoryTheory.Functor.whiskerLeft B_prY.op)
          ((adj_sh_of Y_bar).unit.naturality w_δbar)
      have h_unit : CategoryTheory.Functor.whiskerLeft B_prY.op w_δbar ≫ η_unit (q + 1) SC.X₁ =
          η_unit q SC.X₃ ≫ (P_prY ⋙ U_of Y₀).map Δ_bar := h_unit_raw
      have hγ_δ : w_δ₀ ≫ γ_pre (q + 1) SC.X₁ =
          γ_pre q SC.X₃ ≫ (P_prY ⋙ U_of Y₀).map Δ_bar := by
        dsimp only [γ_pre]
        rw [← CategoryTheory.Category.assoc, hβ_δ, CategoryTheory.Category.assoc, h_unit,
          ← CategoryTheory.Category.assoc]
      change (Sh_of Y₀ ⋙ L_prY).map w_δ₀ ≫
          (adj_Y_tot.homEquiv (P₀_pre (q + 1) SC.X₁)
            ((Φ_fbar (q + 1)).obj (L_prX.obj SC.X₁))).symm (γ_pre (q + 1) SC.X₁) =
        (adj_Y_tot.homEquiv (P₀_pre q SC.X₃)
            ((Φ_fbar q).obj (L_prX.obj SC.X₃))).symm (γ_pre q SC.X₃) ≫ Δ_bar
      rw [← adj_Y_tot.homEquiv_naturality_left_symm w_δ₀ (γ_pre (q + 1) SC.X₁),
        hγ_δ,
        adj_Y_tot.homEquiv_naturality_right_symm (γ_pre q SC.X₃) Δ_bar]
    exact ⟨Δ₀, Δ_bar, hcomp₀₁, hcomp₀₂, hcomp_b₁, hcomp_b₂,
      hEx₀₁, hEx₀₂, hEx_b₁, hEx_b₂, hLadder⟩

  
  have hAcyc_X₀ : ∀ (ℐ₀ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective ℐ₀] (q : ℕ),
      CategoryTheory.Limits.IsZero ((Φ_f₀ (q + 1)).obj ℐ₀) := by
    intro ℐ₀ _ q
    have hZ_pre : CategoryTheory.Limits.IsZero (P₀_pre (q + 1) ℐ₀) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext W ξ
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective ξ
    exact (Sh_of Y₀).map_isZero hZ_pre

  have hCokernelIso : ∀ {A₁ B₁ C₁ A₂ B₂ C₂ :
        CategoryTheory.Sheaf Y_bar.smallEtaleTopology AddCommGrpCat.{u}}
      (f₁ : A₁ ⟶ B₁) (g₁ : B₁ ⟶ C₁) (h₁ : f₁ ≫ g₁ = 0)
      (f₂ : A₂ ⟶ B₂) (g₂ : B₂ ⟶ C₂) (h₂ : f₂ ≫ g₂ = 0)
      (_hEx₁ : (CategoryTheory.ShortComplex.mk f₁ g₁ h₁).Exact) [CategoryTheory.Epi g₁]
      (hEx₂ : (CategoryTheory.ShortComplex.mk f₂ g₂ h₂).Exact) [CategoryTheory.Epi g₂]
      (α : A₁ ⟶ A₂) (β : B₁ ⟶ B₂) (γ : C₁ ⟶ C₂)
      [CategoryTheory.IsIso α] [CategoryTheory.IsIso β],
      f₁ ≫ β = α ≫ f₂ →
      g₁ ≫ γ = β ≫ g₂ →
      CategoryTheory.IsIso γ := by
    intro A₁ B₁ C₁ A₂ B₂ C₂ f₁ g₁ h₁ f₂ g₂ h₂ _hEx₁ _ hEx₂ _ α β γ _ _ hsq₁ hsq₂
    let hc₂ := hEx₂.gIsCokernel
    let e_α := CategoryTheory.asIso α
    let e_β := CategoryTheory.asIso β
    have hk : f₂ ≫ (e_β.inv ≫ g₁) = 0 := by
      have hf₂ : f₂ ≫ e_β.inv = e_α.inv ≫ f₁ := by
        calc f₂ ≫ e_β.inv
            = 𝟙 A₂ ≫ (f₂ ≫ e_β.inv) := (CategoryTheory.Category.id_comp _).symm
          _ = (e_α.inv ≫ α) ≫ (f₂ ≫ e_β.inv) := by rw [← e_α.inv_hom_id]; rfl
          _ = e_α.inv ≫ (α ≫ f₂) ≫ e_β.inv := by simp only [CategoryTheory.Category.assoc]
          _ = e_α.inv ≫ (f₁ ≫ β) ≫ e_β.inv := by rw [hsq₁]
          _ = e_α.inv ≫ f₁ ≫ (e_β.hom ≫ e_β.inv) := by simp only [CategoryTheory.Category.assoc]; rfl
          _ = e_α.inv ≫ f₁ := by rw [e_β.hom_inv_id, CategoryTheory.Category.comp_id]
      rw [← CategoryTheory.Category.assoc, hf₂, CategoryTheory.Category.assoc, h₁,
        CategoryTheory.Limits.comp_zero]
    let cf := CategoryTheory.Limits.CokernelCofork.ofπ (e_β.inv ≫ g₁) hk
    let ψ : C₂ ⟶ C₁ := hc₂.desc cf
    have hg₂ψ : g₂ ≫ ψ = e_β.inv ≫ g₁ :=
      CategoryTheory.Limits.Cofork.IsColimit.π_desc hc₂
    have hγψ : γ ≫ ψ = 𝟙 C₁ := by
      apply (CategoryTheory.cancel_epi g₁).mp
      rw [← CategoryTheory.Category.assoc, hsq₂, CategoryTheory.Category.assoc, hg₂ψ,
        ← CategoryTheory.Category.assoc]
      change (e_β.hom ≫ e_β.inv) ≫ g₁ = _
      rw [e_β.hom_inv_id, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have hψγ : ψ ≫ γ = 𝟙 C₂ := by
      apply (CategoryTheory.cancel_epi g₂).mp
      rw [← CategoryTheory.Category.assoc, hg₂ψ, CategoryTheory.Category.assoc, hsq₂,
        ← CategoryTheory.Category.assoc]
      change (e_β.inv ≫ e_β.hom) ≫ g₂ = _
      rw [e_β.inv_hom_id, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    exact ⟨⟨ψ, hγψ, hψγ⟩⟩

  have hθ_iso : ∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.IsIso (θ q ℱ) := by
    intro q
    induction q with
    | zero => exact hθ_zero
    | succ q ih =>
      intro ℱ
      let ℐ₀ := CategoryTheory.Injective.under ℱ
      let u : ℱ ⟶ ℐ₀ := CategoryTheory.Injective.ι ℱ
      let 𝒬₀ := CategoryTheory.Limits.cokernel u
      let v : ℐ₀ ⟶ 𝒬₀ := CategoryTheory.Limits.cokernel.π u
      let SC := CategoryTheory.ShortComplex.mk u v (CategoryTheory.Limits.cokernel.condition u)
      have hSC : SC.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel u) inferInstance inferInstance
      obtain ⟨Δ₀, Δ_bar, hcomp₀₁, _, hcomp_b₁, _, hEx₀₁, hEx₀₂, hEx_b₁, hEx_b₂, hLadder⟩ :=
        h_conn_ladder SC hSC q
      have hZ₀ : CategoryTheory.Limits.IsZero ((Φ_f₀ (q + 1)).obj ℐ₀) := hAcyc_X₀ ℐ₀ q
      have hu₀_zero : (Φ_f₀ (q + 1)).map u = 0 := hZ₀.eq_of_tgt _ 0
      have : CategoryTheory.Epi Δ₀ := hEx₀₂.epi_f hu₀_zero
      have : CategoryTheory.Epi (L_prY.map Δ₀) := L_prY.map_epi Δ₀
      have hcomp_L₀₁ : L_prY.map ((Φ_f₀ q).map v) ≫ L_prY.map Δ₀ = 0 := by
        rw [← L_prY.map_comp, hcomp₀₁, L_prY.map_zero]
      have hEx_L₀₁ :
          (CategoryTheory.ShortComplex.mk (L_prY.map ((Φ_f₀ q).map v)) (L_prY.map Δ₀)
            hcomp_L₀₁).Exact :=
        hEx₀₁.map L_prY
      have hZbar : CategoryTheory.Limits.IsZero ((Φ_fbar (q + 1)).obj (L_prX.obj ℐ₀)) :=
        hAcyc_inj ℐ₀ (q + 1) (Nat.succ_pos q)
      have hubar_zero : (Φ_fbar (q + 1)).map (L_prX.map u) = 0 := hZbar.eq_of_tgt _ 0
      have : CategoryTheory.Epi Δ_bar := hEx_b₂.epi_f hubar_zero
      have : CategoryTheory.IsIso (θ q ℐ₀) := ih ℐ₀
      have : CategoryTheory.IsIso (θ q 𝒬₀) := ih 𝒬₀
      exact hCokernelIso
        (L_prY.map ((Φ_f₀ q).map v)) (L_prY.map Δ₀) hcomp_L₀₁
        ((Φ_fbar q).map (L_prX.map v)) Δ_bar hcomp_b₁
        hEx_L₀₁ hEx_b₁
        (θ q ℐ₀) (θ q 𝒬₀) (θ (q + 1) ℱ)
        (hθ_nat q v) hLadder

  
  let A_grp : ℕ → AddCommGrpCat.{u} := fun r =>
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
  let iso_bc : ∀ (q r : ℕ),
      CategoryTheory.Iso
        (L_prY.obj (weilEtaleHigherDirectImage f₀ q (weilEtaleTorsionSheaf X₀ (ℓ ^ (r + 1)))))
        (weilEtaleHigherDirectImage f_bar q (weilEtaleTorsionSheaf X_bar (ℓ ^ (r + 1)))) :=
    fun q r =>
      (@CategoryTheory.asIso _ _ _ _ (θ q (C₀.obj (A_grp r)))
        (hθ_iso q (C₀.obj (A_grp r)))).trans
        ((Φ_fbar q).mapIso (κ (A_grp r)))
  refine ⟨iso_bc, fun q r => ?_⟩
  let c_r : A_grp (r + 1) ⟶ A_grp r :=
    AddCommGrpCat.uliftFunctor.{u, 0}.map
      (AddCommGrpCat.ofHom
        (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom)
  change L_prY.map ((Φ_f₀ q).map (C₀.map c_r)) ≫
      (θ q (C₀.obj (A_grp r)) ≫ (Φ_fbar q).map (κ (A_grp r)).hom) =
    (θ q (C₀.obj (A_grp (r + 1))) ≫ (Φ_fbar q).map (κ (A_grp (r + 1))).hom) ≫
      (Φ_fbar q).map (C_bar.map c_r)
  rw [← CategoryTheory.Category.assoc, hθ_nat q (C₀.map c_r),
    CategoryTheory.Category.assoc, ← (Φ_fbar q).map_comp,
    hκ_nat c_r, (Φ_fbar q).map_comp, CategoryTheory.Category.assoc]

theorem weil_sing_dev_leray_algClosure_baseChange (F : Type u) [Finite F] [Field F]
    (X₀ Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper X₀.hom]
    [AlgebraicGeometry.IsProper Y₀.hom]
    (f₀ : X₀ ⟶ Y₀) [AlgebraicGeometry.IsProper f₀.left]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (f_bar : weilGeomScheme F X₀ ⟶ weilGeomScheme F Y₀)
    (hf_bar_fst :
      f_bar ≫ CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      CategoryTheory.Limits.pullback.fst X₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        f₀.left)
    (hf_bar_snd :
      f_bar ≫ CategoryTheory.Limits.pullback.snd Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      CategoryTheory.Limits.pullback.snd X₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :
    let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
    let pr_X := CategoryTheory.Limits.pullback.fst X₀.hom f_ext
    let pr_Y := CategoryTheory.Limits.pullback.fst Y₀.hom f_ext
    ∃ (hCont_X : (weilEtaleSitePullback pr_X).IsContinuous
        X₀.left.smallEtaleTopology (weilGeomScheme F X₀).smallEtaleTopology)
      (hAdj_X : (@CategoryTheory.Functor.sheafPushforwardContinuous
        X₀.left.Etale _ (weilGeomScheme F X₀).Etale _
        (weilEtaleSitePullback pr_X) AddCommGrpCat.{u} _
        X₀.left.smallEtaleTopology (weilGeomScheme F X₀).smallEtaleTopology hCont_X).IsRightAdjoint)
      (hCont_Y : (weilEtaleSitePullback pr_Y).IsContinuous
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
      (hAdj_Y : (@CategoryTheory.Functor.sheafPushforwardContinuous
        Y₀.left.Etale _ (weilGeomScheme F Y₀).Etale _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology hCont_Y).IsRightAdjoint)
      (hCont_f₀ : (weilEtaleSitePullback f₀.left).IsContinuous
        Y₀.left.smallEtaleTopology X₀.left.smallEtaleTopology),
      let L_prX := @CategoryTheory.Functor.sheafPullback
        X₀.left.Etale _ (weilGeomScheme F X₀).Etale _
        (weilEtaleSitePullback pr_X) AddCommGrpCat.{u} _
        X₀.left.smallEtaleTopology (weilGeomScheme F X₀).smallEtaleTopology hCont_X hAdj_X
      let L_prY := @CategoryTheory.Functor.sheafPullback
        Y₀.left.Etale _ (weilGeomScheme F Y₀).Etale _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology hCont_Y hAdj_Y
      let P_f₀ := @CategoryTheory.Functor.sheafPushforwardContinuous
        Y₀.left.Etale _ X₀.left.Etale _
        (weilEtaleSitePullback f₀.left) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology X₀.left.smallEtaleTopology hCont_f₀
      (∃ iso_bc : ∀ (q r : ℕ),
          CategoryTheory.Iso
            (L_prY.obj
              (weilEtaleHigherDirectImage f₀.left q
                (weilEtaleTorsionSheaf X₀.left (ℓ ^ (r + 1)))))
            (weilEtaleHigherDirectImage f_bar q
              (weilEtaleTorsionSheaf (weilGeomScheme F X₀) (ℓ ^ (r + 1)))),
        ∀ (q r : ℕ),
          CategoryTheory.CategoryStruct.comp
            (L_prY.map
              (weilEtaleHigherDirectImageMap f₀.left q
                ((CategoryTheory.constantSheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u}).map
                  (AddCommGrpCat.uliftFunctor.{u, 0}.map
                    (AddCommGrpCat.ofHom
                      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1)))
                        (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom)))))
            (iso_bc q r).hom =
          CategoryTheory.CategoryStruct.comp
            (iso_bc q (r + 1)).hom
            (weilEtaleHigherDirectImageMap f_bar q
              ((CategoryTheory.constantSheaf
                  (weilGeomScheme F X₀).smallEtaleTopology AddCommGrpCat.{u}).map
                (AddCommGrpCat.uliftFunctor.{u, 0}.map
                  (AddCommGrpCat.ofHom
                    (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1)))
                      (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom))))) ∧
      ((∀ (𝒥 : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u}),
          (∀ (U : X₀.left.Etale) (k : ℕ), 1 ≤ k →
            Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf 𝒥 k).obj (Opposite.op U))) →
          ∀ (k : ℕ), 1 ≤ k → Subsingleton ((L_prX.obj 𝒥).H k)) ∧
       (∀ (𝒦 : CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u}),
          (∀ (U : Y₀.left.Etale) (k : ℕ), 1 ≤ k →
            Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf 𝒦 k).obj (Opposite.op U))) →
          ∀ (k : ℕ), 1 ≤ k → Subsingleton ((L_prY.obj 𝒦).H k))) ∧
      (∃ e_H0 : ∀ (𝒥 : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u}),
          (L_prY.obj (P_f₀.obj 𝒥)).H 0 ≃+ (L_prX.obj 𝒥).H 0,
        (∀ {𝒥₁ 𝒥₂ : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u}}
            (φ : 𝒥₁ ⟶ 𝒥₂) (x : (L_prY.obj (P_f₀.obj 𝒥₁)).H 0),
          e_H0 𝒥₂
            ((CategoryTheory.Abelian.Ext.mk₀ (L_prY.map (P_f₀.map φ))).postcomp
              ((CategoryTheory.constantSheaf
                  (weilGeomScheme F Y₀).smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              (Nat.add_zero 0) x) =
          (CategoryTheory.Abelian.Ext.mk₀ (L_prX.map φ)).postcomp
            ((CategoryTheory.constantSheaf
                (weilGeomScheme F X₀).smallEtaleTopology AddCommGrpCat.{u}).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))
            (Nat.add_zero 0) (e_H0 𝒥₁ x)) ∧
        (∀ (𝒥 : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u})
            (f_Y : (L_prY.obj (P_f₀.obj 𝒥)).H 0 →+ (L_prY.obj (P_f₀.obj 𝒥)).H 0)
            (f_X : (L_prX.obj 𝒥).H 0 →+ (L_prX.obj 𝒥).H 0),
          WeilTransvTriIsGeomBaseSheafAction F Y₀ (P_f₀.obj 𝒥) (L_prY.obj (P_f₀.obj 𝒥))
            hCont_Y hAdj_Y (CategoryTheory.Iso.refl _) 0 f_Y →
          WeilTransvTriIsGeomBaseSheafAction F X₀ 𝒥 (L_prX.obj 𝒥)
            hCont_X hAdj_X (CategoryTheory.Iso.refl _) 0 f_X →
          ∀ x, e_H0 𝒥 (f_Y x) = f_X (e_H0 𝒥 x))) :=
by
  let k := AlgebraicClosure F
  let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let X_bar := weilGeomScheme F X₀
  let Y_bar := weilGeomScheme F Y₀
  let pr_X : Quiver.Hom X_bar X₀.left := CategoryTheory.Limits.pullback.fst X₀.hom f_ext
  let snd_X : Quiver.Hom X_bar (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Limits.pullback.snd X₀.hom f_ext
  let pr_Y : Quiver.Hom Y_bar Y₀.left := CategoryTheory.Limits.pullback.fst Y₀.hom f_ext
  let snd_Y : Quiver.Hom Y_bar (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Limits.pullback.snd Y₀.hom f_ext

  
  obtain ⟨hSite, _, _, _, _, _⟩ :=
    weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  obtain ⟨hCont_X, hAdj_X, hLim_X, hAdd_X, _⟩ := hSite pr_X
  obtain ⟨hCont_Y, hAdj_Y, hLim_Y, hAdd_Y, _⟩ := hSite pr_Y
  obtain ⟨hCont_f₀, hAdj_f₀, _, _, _⟩ := hSite f₀.left
  obtain ⟨hCont_fbar, hAdj_fbar, _, _, _⟩ := hSite f_bar

  let L_prX := @CategoryTheory.Functor.sheafPullback
    X₀.left.Etale _ X_bar.Etale _
    (weilEtaleSitePullback pr_X) AddCommGrpCat.{u} _
    X₀.left.smallEtaleTopology X_bar.smallEtaleTopology hCont_X hAdj_X
  let L_prY := @CategoryTheory.Functor.sheafPullback
    Y₀.left.Etale _ Y_bar.Etale _
    (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
    Y₀.left.smallEtaleTopology Y_bar.smallEtaleTopology hCont_Y hAdj_Y
  let adj_prX := @CategoryTheory.Functor.sheafAdjunctionContinuous
    X₀.left.Etale _ X_bar.Etale _
    (weilEtaleSitePullback pr_X) AddCommGrpCat.{u} _
    X₀.left.smallEtaleTopology X_bar.smallEtaleTopology hCont_X hAdj_X
  let adj_prY := @CategoryTheory.Functor.sheafAdjunctionContinuous
    Y₀.left.Etale _ Y_bar.Etale _
    (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
    Y₀.left.smallEtaleTopology Y_bar.smallEtaleTopology hCont_Y hAdj_Y

  have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} L_prX :=
    adj_prX.leftAdjoint_preservesColimits
  have hColim_X : CategoryTheory.Limits.PreservesFiniteColimits L_prX :=
    ⟨fun _ _ _ => inferInstance⟩

  have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} L_prY :=
    adj_prY.leftAdjoint_preservesColimits
  have hColim_Y : CategoryTheory.Limits.PreservesFiniteColimits L_prY :=
    ⟨fun _ _ _ => inferInstance⟩

  
  have hpb_X : CategoryTheory.IsPullback pr_X snd_X X₀.hom f_ext :=
    CategoryTheory.IsPullback.of_hasPullback X₀.hom f_ext
  have hpb_Y : CategoryTheory.IsPullback pr_Y snd_Y Y₀.hom f_ext :=
    CategoryTheory.IsPullback.of_hasPullback Y₀.hom f_ext
  have hpb_outer : CategoryTheory.IsPullback (f_bar ≫ snd_Y) pr_X f_ext (f₀.left ≫ Y₀.hom) :=
    hf_bar_snd.symm ▸ f₀.w.symm ▸ hpb_X.flip
  have hpb_fbar : CategoryTheory.IsPullback f_bar pr_X pr_Y f₀.left :=
    CategoryTheory.IsPullback.of_right hpb_outer hf_bar_fst hpb_Y.flip

  have hComp_X₀ : CompactSpace ↥X₀.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X₀.hom
  have hComp_Y₀ : CompactSpace ↥Y₀.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace Y₀.hom
  have hSep_X₀ : AlgebraicGeometry.IsSeparated X₀.hom := inferInstance
  have hSep_Y₀ : AlgebraicGeometry.IsSeparated Y₀.hom := inferInstance

  
  obtain ⟨hProEt, hBC0_pkg⟩ := weil_algClosure_bc_proetale_sections_and_bc0_iso F
  obtain ⟨hCover_X, ⟨hInj_X, hSurj_X⟩, _⟩ := hProEt X₀ hCont_X hAdj_X
  obtain ⟨hCover_Y, ⟨hInj_Y, hSurj_Y⟩, hAffBasis_Y⟩ := hProEt Y₀ hCont_Y hAdj_Y
  have hIso_bc0 := hBC0_pkg X₀ Y₀ f₀ f_bar hf_bar_fst hpb_fbar
    hCont_X hAdj_X hCont_Y hAdj_Y hCont_f₀ hCont_fbar

  
  have hAcyc_X : ∀ (𝒥 : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (U : X₀.left.Etale) (d : ℕ), 1 ≤ d →
        Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf 𝒥 d).obj (Opposite.op U))) →
      ∀ (d : ℕ), 1 ≤ d → Subsingleton ((L_prX.obj 𝒥).H d) :=
    fun 𝒥 hAcyc₀ =>
      (weil_algClosure_bc_cech_cartan_acyclicity F X₀ hCont_X hAdj_X
        hAdd_X hLim_X hColim_X hCover_X hInj_X hSurj_X 𝒥 hAcyc₀).2 hComp_X₀ hSep_X₀

  have hAcyc_Y : ∀ (𝒦 : CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (U : Y₀.left.Etale) (d : ℕ), 1 ≤ d →
        Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf 𝒦 d).obj (Opposite.op U))) →
      ∀ (d : ℕ), 1 ≤ d → Subsingleton ((L_prY.obj 𝒦).H d) :=
    fun 𝒦 hAcyc₀ =>
      (weil_algClosure_bc_cech_cartan_acyclicity F Y₀ hCont_Y hAdj_Y
        hAdd_Y hLim_Y hColim_Y hCover_Y hInj_Y hSurj_Y 𝒦 hAcyc₀).2 hComp_Y₀ hSep_Y₀

  
  have hAcyc_inj :
      ∀ (ℐ₀ : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective ℐ₀] (p : ℕ),
        1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f_bar p (L_prX.obj ℐ₀)) := by
    intro ℐ₀ _ p hp
    have hAcyc_ℐ₀ : ∀ (U : X₀.left.Etale) (d : ℕ), 1 ≤ d →
        Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf ℐ₀ d).obj (Opposite.op U)) := by
      intro U d hd
      obtain ⟨m, rfl⟩ : ∃ m : ℕ, d = m + 1 := ⟨d - 1, (Nat.sub_add_cancel hd).symm⟩
      refine ⟨fun a b => ?_⟩
      have ha : a = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective a
      have hb : b = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective b
      exact ha.trans hb.symm
    have hLocal_X := (weil_algClosure_bc_cech_cartan_acyclicity F X₀ hCont_X hAdj_X
      hAdd_X hLim_X hColim_X hCover_X hInj_X hSurj_X ℐ₀ hAcyc_ℐ₀).1
    let Fgt_X := AlgebraicGeometry.Scheme.Etale.forget X_bar
    let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y_bar
    let P_pre : CategoryTheory.Functor (Opposite Y_bar.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback f_bar).op
        (CategoryTheory.Sheaf.cohomologyPresheaf (L_prX.obj ℐ₀) p)
    let 𝒢_bar :=
      (CategoryTheory.presheafToSheaf Y_bar.smallEtaleTopology AddCommGrpCat.{u}).obj P_pre
    let adj_sh := CategoryTheory.sheafificationAdjunction Y_bar.smallEtaleTopology AddCommGrpCat.{u}
    have hSub_desc : ∀ (U_bar : Y_bar.Etale),
        (∃ (E₀ : Type u) (_ : Finite E₀) (_ : Field E₀)
           (_ : Algebra F E₀) (_ : Algebra E₀ k) (_ : IsScalarTower F E₀ k)
           (U₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₀)))
           (_ : AlgebraicGeometry.IsAffine U₀.left)
           (u_Y : U₀.left ⟶ Y₀.left) (_ : AlgebraicGeometry.Etale u_Y)
           (p_U : (Fgt_Y.obj U_bar).left ⟶ U₀.left),
           u_Y ≫ Y₀.hom =
             U₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₀)) ∧
           CategoryTheory.IsPullback p_U ((Fgt_Y.obj U_bar).hom ≫ snd_Y) U₀.hom
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ k))) ∧
           p_U ≫ u_Y = (Fgt_Y.obj U_bar).hom ≫ pr_Y) →
        Subsingleton ↑(P_pre.obj (Opposite.op U_bar)) := by
      rintro U_bar ⟨E₀, hFinE₀, hFldE₀, hAlgFE₀, hAlgE₀k, hTowerFE₀k,
        U₀, hAffU₀, u_Y, hEtuY, p_U, hu_Y, hp_U, hp_U_Y⟩
      letI : Finite E₀ := hFinE₀
      letI : Field E₀ := hFldE₀
      letI : Algebra F E₀ := hAlgFE₀
      letI : Algebra E₀ k := hAlgE₀k
      letI : IsScalarTower F E₀ k := hTowerFE₀k
      letI : AlgebraicGeometry.IsAffine U₀.left := hAffU₀
      letI : AlgebraicGeometry.Etale u_Y := hEtuY
      let Z_bar : X_bar.Etale := (weilEtaleSitePullback f_bar).obj U_bar
      let q_U : (Fgt_X.obj Z_bar).left ⟶ (Fgt_Y.obj U_bar).left :=
        CategoryTheory.Limits.pullback.fst (Fgt_Y.obj U_bar).hom f_bar
      have hpb_Zbar : CategoryTheory.IsPullback q_U (Fgt_X.obj Z_bar).hom
          (Fgt_Y.obj U_bar).hom f_bar :=
        CategoryTheory.IsPullback.of_hasPullback (Fgt_Y.obj U_bar).hom f_bar
      let fst_Z₀ := CategoryTheory.Limits.pullback.fst u_Y f₀.left
      let z_X := CategoryTheory.Limits.pullback.snd u_Y f₀.left
      let Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₀)) :=
        CategoryTheory.Over.mk (fst_Z₀ ≫ U₀.hom)
      have hpb_Z₀ : CategoryTheory.IsPullback fst_Z₀ z_X u_Y f₀.left :=
        CategoryTheory.IsPullback.of_hasPullback u_Y f₀.left
      have : AlgebraicGeometry.Etale z_X :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z₀ hEtuY
      have hQC_fst : AlgebraicGeometry.QuasiCompact fst_Z₀ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z₀.flip
          inferInstance
      have : AlgebraicGeometry.QuasiCompact fst_Z₀ := hQC_fst
      have : CompactSpace ↥Z₀.left :=
        AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace fst_Z₀
      have hSep_fst : AlgebraicGeometry.IsSeparated fst_Z₀ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z₀.flip
          inferInstance
      have hSep_U₀ : AlgebraicGeometry.IsSeparated U₀.hom := inferInstance
      have : AlgebraicGeometry.IsSeparated Z₀.hom :=
        (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
          (@AlgebraicGeometry.IsSeparated)).comp_mem fst_Z₀ U₀.hom hSep_fst hSep_U₀
      have hz_X : z_X ≫ X₀.hom =
          Z₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₀)) := by
        change z_X ≫ X₀.hom = (fst_Z₀ ≫ U₀.hom) ≫ _
        rw [← f₀.w, ← CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, hu_Y, CategoryTheory.Category.assoc]
      have hcomm_pZ : (q_U ≫ p_U) ≫ u_Y = ((Fgt_X.obj Z_bar).hom ≫ pr_X) ≫ f₀.left := by
        rw [CategoryTheory.Category.assoc, hp_U_Y, ← CategoryTheory.Category.assoc,
          hpb_Zbar.w, CategoryTheory.Category.assoc, hf_bar_fst]
        exact (CategoryTheory.Category.assoc (Fgt_X.obj Z_bar).hom pr_X f₀.left).symm
      let p_Z : (Fgt_X.obj Z_bar).left ⟶ Z₀.left :=
        CategoryTheory.Limits.pullback.lift (q_U ≫ p_U) ((Fgt_X.obj Z_bar).hom ≫ pr_X) hcomm_pZ
      have hp_Z_fst : p_Z ≫ fst_Z₀ = q_U ≫ p_U :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hp_Z_X : p_Z ≫ z_X = (Fgt_X.obj Z_bar).hom ≫ pr_X :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_paste1 : CategoryTheory.IsPullback ((Fgt_X.obj Z_bar).hom ≫ pr_X) q_U
          f₀.left ((Fgt_Y.obj U_bar).hom ≫ pr_Y) :=
        hpb_Zbar.flip.paste_horiz hpb_fbar.flip
      have hpb_paste1' : CategoryTheory.IsPullback (p_Z ≫ z_X) q_U
          f₀.left (p_U ≫ u_Y) := by
        rwa [hp_Z_X, hp_U_Y]
      have hpb_pZ_qU : CategoryTheory.IsPullback p_Z q_U fst_Z₀ p_U :=
        CategoryTheory.IsPullback.of_right hpb_paste1' hp_Z_fst hpb_Z₀.flip
      have hpb_pZ_outer : CategoryTheory.IsPullback p_Z
          (q_U ≫ ((Fgt_Y.obj U_bar).hom ≫ snd_Y))
          (fst_Z₀ ≫ U₀.hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ k))) :=
        hpb_pZ_qU.paste_vert hp_U
      have hqU_snd : q_U ≫ ((Fgt_Y.obj U_bar).hom ≫ snd_Y) = (Fgt_X.obj Z_bar).hom ≫ snd_X := by
        rw [← CategoryTheory.Category.assoc, hpb_Zbar.w, CategoryTheory.Category.assoc, hf_bar_snd]
      have hp_Z : CategoryTheory.IsPullback p_Z ((Fgt_X.obj Z_bar).hom ≫ snd_X) Z₀.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ k))) := by
        rwa [hqU_snd] at hpb_pZ_outer
      exact hLocal_X E₀ Z₀ z_X hz_X Z_bar p_Z hp_Z hp_Z_X p hp
    change CategoryTheory.Limits.IsZero 𝒢_bar
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply (adj_sh.homEquiv P_pre 𝒢_bar).injective
    have h_id : adj_sh.homEquiv P_pre 𝒢_bar (CategoryTheory.CategoryStruct.id 𝒢_bar) =
        adj_sh.unit.app P_pre := by
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
      exact CategoryTheory.Category.comp_id (adj_sh.unit.app P_pre)
    have h_zero : adj_sh.homEquiv P_pre 𝒢_bar 0 = 0 := by
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      change CategoryTheory.CategoryStruct.comp (adj_sh.unit.app P_pre)
        ((CategoryTheory.sheafToPresheaf Y_bar.smallEtaleTopology AddCommGrpCat.{u}).map
          (0 : 𝒢_bar ⟶ 𝒢_bar)) = 0
      rw [CategoryTheory.Functor.map_zero, CategoryTheory.Limits.comp_zero]
    rw [h_id, h_zero]
    ext ⟨V_bar⟩ : 2
    apply AddCommGrpCat.ext
    intro x
    obtain ⟨ι, U_fam, u_fam, hS_cov, hDesc_fam⟩ := hAffBasis_Y V_bar
    let S := CategoryTheory.Sieve.ofArrows U_fam u_fam
    let s : ↑(𝒢_bar.obj.obj (Opposite.op V_bar)) :=
      ((adj_sh.unit.app P_pre).app (Opposite.op V_bar)).hom x
    have hs_sieve : ∀ {W_bar : Y_bar.Etale} (g : Quiver.Hom W_bar V_bar),
        S.arrows g → (𝒢_bar.obj.map (Opposite.op g)).hom s = 0 := by
      intro W_bar g hg
      rcases hg with ⟨W', w, u', ⟨i⟩, rfl⟩
      have : Subsingleton ↑(P_pre.obj (Opposite.op (U_fam i))) := hSub_desc (U_fam i) (hDesc_fam i)
      have h_nat : (𝒢_bar.obj.map (Opposite.op (u_fam i))).hom s =
          ((adj_sh.unit.app P_pre).app (Opposite.op (U_fam i))).hom
            ((P_pre.map (Opposite.op (u_fam i))).hom x) :=
        congrArg (fun φ => φ.hom x)
          ((adj_sh.unit.app P_pre).naturality (Opposite.op (u_fam i))).symm
      have h_sub : (P_pre.map (Opposite.op (u_fam i))).hom x = 0 := Subsingleton.elim _ _
      have h_ui : (𝒢_bar.obj.map (Opposite.op (u_fam i))).hom s = 0 := by
        rw [h_nat, h_sub, map_zero]
      have h_comp : 𝒢_bar.obj.map (Opposite.op (w ≫ u_fam i)) =
          𝒢_bar.obj.map (Opposite.op (u_fam i)) ≫ 𝒢_bar.obj.map (Opposite.op w) :=
        𝒢_bar.obj.map_comp (Opposite.op (u_fam i)) (Opposite.op w)
      calc
        (𝒢_bar.obj.map (Opposite.op (w ≫ u_fam i))).hom s
          = (𝒢_bar.obj.map (Opposite.op w)).hom
              ((𝒢_bar.obj.map (Opposite.op (u_fam i))).hom s) :=
            congrArg (fun φ => φ.hom s) h_comp
        _ = (𝒢_bar.obj.map (Opposite.op w)).hom 0 := by rw [h_ui]
        _ = 0 := map_zero _
    obtain ⟨hLim⟩ :=
      (CategoryTheory.Presheaf.isSheaf_iff_isLimit Y_bar.smallEtaleTopology 𝒢_bar.obj).mp
        𝒢_bar.property S hS_cov
    let m_s : AddCommGrpCat.of (ULift.{u} ℤ) ⟶ (𝒢_bar.obj.mapCone S.arrows.cocone.op).pt :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • s
          map_zero' := zero_zsmul s
          map_add' := fun a b => add_zsmul s a.down b.down }
    have hm_zero : m_s = 0 := by
      apply hLim.hom_ext
      intro j
      apply AddCommGrpCat.ext
      intro z
      let g_j := (CategoryTheory.Over.forgetCocone V_bar).ι.app j.unop.1
      exact (map_zsmul (𝒢_bar.obj.map g_j.op).hom z.down s).trans
        ((congrArg (z.down • ·) (hs_sieve g_j j.unop.2)).trans
          ((zsmul_zero z.down).trans (map_zero (𝒢_bar.obj.map g_j.op).hom).symm))
    have hs_one : m_s.hom (ULift.up 1) = 0 :=
      congrArg (fun (φ : AddCommGrpCat.of (ULift.{u} ℤ) ⟶ _) => φ.hom (ULift.up 1)) hm_zero
    change s = 0
    exact (one_zsmul s).symm.trans hs_one

  
  obtain ⟨iso_bc, h_iso_bc_trans⟩ :=
    weil_algClosure_bc_higherDirectImage_iso_and_nat f₀.left pr_X pr_Y f_bar hf_bar_fst ℓ
      hCont_X hAdj_X hCont_Y hAdj_Y hCont_f₀ hAdj_f₀ hCont_fbar hAdj_fbar
      hAdd_X hLim_X hColim_X hAdd_Y hLim_Y hColim_Y
      hIso_bc0 hAcyc_inj
  obtain ⟨e_H0, he_H0_nat, he_H0_frob⟩ :=
    weil_algClosure_bc_beckChevalley_h0_and_frob F X₀ Y₀ f₀ f_bar hf_bar_fst hf_bar_snd
      hCont_X hAdj_X hCont_Y hAdj_Y hCont_f₀ hCont_fbar hIso_bc0

  exact ⟨hCont_X, hAdj_X, hCont_Y, hAdj_Y, hCont_f₀,
    ⟨iso_bc, h_iso_bc_trans⟩, ⟨hAcyc_X, hAcyc_Y⟩, ⟨e_H0, he_H0_nat, he_H0_frob⟩⟩

theorem weil_sing_dev_ar_torsion_pushforward_system {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    let ℳ : ℕ → ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      fun q n => weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X (ℓ ^ n))
    let τ_map : ∀ (q m n : ℕ), m ≤ n → Quiver.Hom (ℳ q n) (ℳ q m) :=
      fun q m _n h => weilEtaleHigherDirectImageMap f q
        ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).map
          (AddCommGrpCat.uliftFunctor.{u, 0}.map
            (AddCommGrpCat.ofHom
              (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom)))
    ∃ (j_map : ∀ (q m n : ℕ), m ≤ n → Quiver.Hom (ℳ q m) (ℳ q n))
      (δ_map : ∀ (q a b c : ℕ), a + c = b → Quiver.Hom (ℳ q c) (ℳ (q + 1) a)),
      ((∀ q : ℕ, CategoryTheory.Limits.IsZero (ℳ q 0)) ∧
        (∀ (q n : ℕ), (ℓ ^ n) • CategoryTheory.CategoryStruct.id (ℳ q n) = 0)) ∧
      ((∀ (q n : ℕ) (h : n ≤ n),
          j_map q n n h = CategoryTheory.CategoryStruct.id (ℳ q n) ∧
          τ_map q n n h = CategoryTheory.CategoryStruct.id (ℳ q n)) ∧
        (∀ (q k m n : ℕ) (h₁ : k ≤ m) (h₂ : m ≤ n),
          CategoryTheory.CategoryStruct.comp (j_map q k m h₁) (j_map q m n h₂) =
            j_map q k n (le_trans h₁ h₂) ∧
          CategoryTheory.CategoryStruct.comp (τ_map q m n h₂) (τ_map q k m h₁) =
            τ_map q k n (le_trans h₁ h₂)) ∧
        (∀ (q m₁ n₁ m₂ n₂ d : ℕ) (h₁ : m₁ ≤ n₁) (h₂ : m₂ ≤ n₂)
            (hm : m₂ ≤ m₁) (hn : n₂ ≤ n₁),
          m₁ + d = n₁ → m₂ + d = n₂ →
          CategoryTheory.CategoryStruct.comp (j_map q m₁ n₁ h₁) (τ_map q n₂ n₁ hn) =
            CategoryTheory.CategoryStruct.comp (τ_map q m₂ m₁ hm) (j_map q m₂ n₂ h₂)) ∧
        (∀ (q m n d : ℕ) (h : m ≤ n),
          m + d = n →
          CategoryTheory.CategoryStruct.comp (j_map q m n h) (τ_map q m n h) =
            (ℓ ^ d) • CategoryTheory.CategoryStruct.id (ℳ q m) ∧
          CategoryTheory.CategoryStruct.comp (τ_map q m n h) (j_map q m n h) =
            (ℓ ^ d) • CategoryTheory.CategoryStruct.id (ℳ q n))) ∧
      (∀ (a b c : ℕ) (habc : a + c = b),
        CategoryTheory.Mono (j_map 0 a b (Nat.le.intro habc)) ∧
        ∀ q : ℕ,
          (∃ h₁ : CategoryTheory.CategoryStruct.comp
              (j_map q a b (Nat.le.intro habc))
              (τ_map q c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) = 0,
            (CategoryTheory.ShortComplex.mk
              (j_map q a b (Nat.le.intro habc))
              (τ_map q c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) h₁).Exact) ∧
          (∃ h₂ : CategoryTheory.CategoryStruct.comp
              (τ_map q c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
              (δ_map q a b c habc) = 0,
            (CategoryTheory.ShortComplex.mk
              (τ_map q c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
              (δ_map q a b c habc) h₂).Exact) ∧
          (∃ h₃ : CategoryTheory.CategoryStruct.comp
              (δ_map q a b c habc)
              (j_map (q + 1) a b (Nat.le.intro habc)) = 0,
            (CategoryTheory.ShortComplex.mk
              (δ_map q a b c habc)
              (j_map (q + 1) a b (Nat.le.intro habc)) h₃).Exact)) ∧
      (∀ (q a c₁ c₂ : ℕ) (hc : c₁ ≤ c₂),
        CategoryTheory.CategoryStruct.comp (j_map q c₁ c₂ hc) (δ_map q a (a + c₂) c₂ rfl) =
          δ_map q a (a + c₁) c₁ rfl) :=
by
  intro ℳ τ_map
  have hPrime : Nat.Prime ℓ := Fact.out
  let _ : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hPrime.ne_zero⟩

  
  let A : ℕ → AddCommGrpCat.{u} := fun n =>
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ n)))
  let red : ∀ (m n : ℕ), m ≤ n → (A n ⟶ A m) := fun m _n h =>
    AddCommGrpCat.uliftFunctor.{u, 0}.map
      (AddCommGrpCat.ofHom (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom)
  let inc0 : ∀ (m n : ℕ), m ≤ n → (ZMod (ℓ ^ m) →+ ZMod (ℓ ^ n)) := fun m n h =>
    { toFun := fun x => ((x.val * ℓ ^ (n - m) : ℕ) : ZMod (ℓ ^ n))
      map_zero' := by simp
      map_add' := fun x y => by
        have hxy : (x + y).val + ℓ ^ m * ((x.val + y.val) / ℓ ^ m) = x.val + y.val := by
          rw [ZMod.val_add]
          have h1 := Nat.mod_add_div (x.val + y.val) (ℓ ^ m)
          omega
        have hmul := congrArg (· * ℓ ^ (n - m)) hxy
        rw [Nat.add_mul, Nat.add_mul] at hmul
        have hpow : ℓ ^ m * ((x.val + y.val) / ℓ ^ m) * ℓ ^ (n - m) =
            ℓ ^ n * ((x.val + y.val) / ℓ ^ m) := by
          calc ℓ ^ m * ((x.val + y.val) / ℓ ^ m) * ℓ ^ (n - m)
              = (ℓ ^ m * ℓ ^ (n - m)) * ((x.val + y.val) / ℓ ^ m) := by ring
            _ = ℓ ^ n * ((x.val + y.val) / ℓ ^ m) := by rw [← pow_add, Nat.add_sub_of_le h]
        rw [hpow] at hmul
        have hcast := congrArg (Nat.cast : ℕ → ZMod (ℓ ^ n)) hmul
        rw [Nat.cast_add, Nat.cast_add, Nat.cast_mul (ℓ ^ n), ZMod.natCast_self,
          zero_mul, add_zero] at hcast
        exact hcast }
  let inc : ∀ (m n : ℕ), m ≤ n → (A m ⟶ A n) := fun m n h =>
    AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (inc0 m n h))

  have h_eval : ∀ (n t : ℕ) (x : ↑(A n)),
      ((t • CategoryTheory.CategoryStruct.id (A n)).hom x).down = t • x.down := by
    intro n t x
    induction t with
    | zero => rfl
    | succ t ih =>
      rw [succ_nsmul, succ_nsmul]
      change ((t • CategoryTheory.CategoryStruct.id (A n)).hom x).down + x.down =
        t • x.down + x.down
      rw [ih]

  have hZero_A0 : CategoryTheory.Limits.IsZero (A 0) := by
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    have hSub : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
    exact @Subsingleton.elim _ hSub _ _

  have hTor_A : ∀ n : ℕ, (ℓ ^ n) • CategoryTheory.CategoryStruct.id (A n) = 0 := by
    intro n
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    rw [h_eval n (ℓ ^ n) x, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    rfl

  have hId_A : ∀ (n : ℕ) (h : n ≤ n),
      inc n n h = CategoryTheory.CategoryStruct.id (A n) ∧
      red n n h = CategoryTheory.CategoryStruct.id (A n) := by
    intro n h
    refine ⟨?_, ?_⟩
    · apply AddCommGrpCat.ext; intro x; apply ULift.ext
      change ((x.down.val * ℓ ^ (n - n) : ℕ) : ZMod (ℓ ^ n)) = x.down
      rw [Nat.sub_self, pow_zero, mul_one, ZMod.natCast_zmod_val]
    · apply AddCommGrpCat.ext; intro x; apply ULift.ext
      change ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ n)) x.down = x.down
      rw [ZMod.castHom_self, RingHom.id_apply]

  have hComp_A : ∀ (k m n : ℕ) (h₁ : k ≤ m) (h₂ : m ≤ n),
      CategoryTheory.CategoryStruct.comp (inc k m h₁) (inc m n h₂) = inc k n (le_trans h₁ h₂) ∧
      CategoryTheory.CategoryStruct.comp (red m n h₂) (red k m h₁) = red k n (le_trans h₁ h₂) := by
    intro k m n h₁ h₂
    refine ⟨?_, ?_⟩
    · apply AddCommGrpCat.ext; intro x; apply ULift.ext
      change ((((x.down.val * ℓ ^ (m - k) : ℕ) : ZMod (ℓ ^ m)).val * ℓ ^ (n - m) : ℕ) :
        ZMod (ℓ ^ n)) = ((x.down.val * ℓ ^ (n - k) : ℕ) : ZMod (ℓ ^ n))
      have hlt : x.down.val * ℓ ^ (m - k) < ℓ ^ m := by
        calc x.down.val * ℓ ^ (m - k)
            < ℓ ^ k * ℓ ^ (m - k) :=
              Nat.mul_lt_mul_of_pos_right x.down.val_lt (pow_pos hPrime.pos _)
          _ = ℓ ^ m := by rw [← pow_add, Nat.add_sub_of_le h₁]
      rw [ZMod.val_natCast_of_lt hlt, mul_assoc, ← pow_add]
      have hsub : m - k + (n - m) = n - k := by omega
      rw [hsub]
    · apply AddCommGrpCat.ext; intro x; apply ULift.ext
      exact RingHom.congr_fun (Subsingleton.elim
        ((ZMod.castHom (pow_dvd_pow ℓ h₁) (ZMod (ℓ ^ k))).comp
          (ZMod.castHom (pow_dvd_pow ℓ h₂) (ZMod (ℓ ^ m))))
        (ZMod.castHom (pow_dvd_pow ℓ (le_trans h₁ h₂)) (ZMod (ℓ ^ k)))) x.down

  have hMixed_A : ∀ (m₁ n₁ m₂ n₂ d : ℕ) (h₁ : m₁ ≤ n₁) (h₂ : m₂ ≤ n₂)
      (hm : m₂ ≤ m₁) (hn : n₂ ≤ n₁),
      m₁ + d = n₁ → m₂ + d = n₂ →
      CategoryTheory.CategoryStruct.comp (inc m₁ n₁ h₁) (red n₂ n₁ hn) =
        CategoryTheory.CategoryStruct.comp (red m₂ m₁ hm) (inc m₂ n₂ h₂) := by
    intro m₁ n₁ m₂ n₂ d h₁ h₂ hm hn hd₁ hd₂
    apply AddCommGrpCat.ext; intro x; apply ULift.ext
    have hsub₁ : n₁ - m₁ = d := by omega
    have hsub₂ : n₂ - m₂ = d := by omega
    change ZMod.castHom (pow_dvd_pow ℓ hn) (ZMod (ℓ ^ n₂))
      ((x.down.val * ℓ ^ (n₁ - m₁) : ℕ) : ZMod (ℓ ^ n₁)) =
      (((ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ m₂)) x.down).val *
        ℓ ^ (n₂ - m₂) : ℕ) : ZMod (ℓ ^ n₂))
    rw [hsub₁, hsub₂, map_natCast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
    have hdiv : x.down.val = ℓ ^ m₂ * (x.down.val / ℓ ^ m₂) + x.down.val % ℓ ^ m₂ :=
      (Nat.div_add_mod x.down.val (ℓ ^ m₂)).symm
    conv_lhs => rw [hdiv]
    have hmul : (ℓ ^ m₂ * (x.down.val / ℓ ^ m₂) + x.down.val % ℓ ^ m₂) * ℓ ^ d =
        ℓ ^ n₂ * (x.down.val / ℓ ^ m₂) + (x.down.val % ℓ ^ m₂) * ℓ ^ d := by
      rw [Nat.add_mul, mul_right_comm, ← pow_add, hd₂]
    rw [hmul, Nat.cast_add, Nat.cast_mul (ℓ ^ n₂), ZMod.natCast_self, zero_mul, zero_add]

  have hMul_A : ∀ (m n d : ℕ) (h : m ≤ n), m + d = n →
      CategoryTheory.CategoryStruct.comp (inc m n h) (red m n h) =
        (ℓ ^ d) • CategoryTheory.CategoryStruct.id (A m) ∧
      CategoryTheory.CategoryStruct.comp (red m n h) (inc m n h) =
        (ℓ ^ d) • CategoryTheory.CategoryStruct.id (A n) := by
    intro m n d h hd
    have hsub : n - m = d := by omega
    refine ⟨?_, ?_⟩
    · apply AddCommGrpCat.ext; intro x; apply ULift.ext
      rw [h_eval m (ℓ ^ d) x]
      change ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))
        ((x.down.val * ℓ ^ (n - m) : ℕ) : ZMod (ℓ ^ n)) = (ℓ ^ d) • x.down
      rw [hsub, map_natCast, Nat.cast_mul, ZMod.natCast_zmod_val, nsmul_eq_mul,
        mul_comm, Nat.cast_pow]
    · apply AddCommGrpCat.ext; intro x; apply ULift.ext
      rw [h_eval n (ℓ ^ d) x]
      let xd : ZMod (ℓ ^ n) := ULift.down x
      change (((ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m)) xd).val *
        ℓ ^ (n - m) : ℕ) : ZMod (ℓ ^ n)) = (ℓ ^ d) • xd
      rw [hsub, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
      have hdiv : xd.val = ℓ ^ m * (xd.val / ℓ ^ m) + xd.val % ℓ ^ m :=
        (Nat.div_add_mod xd.val (ℓ ^ m)).symm
      have hmul : xd.val * ℓ ^ d = ℓ ^ n * (xd.val / ℓ ^ m) + (xd.val % ℓ ^ m) * ℓ ^ d := by
        calc xd.val * ℓ ^ d
            = (ℓ ^ m * (xd.val / ℓ ^ m) + xd.val % ℓ ^ m) * ℓ ^ d := by
                conv_lhs => rw [hdiv]
          _ = ℓ ^ n * (xd.val / ℓ ^ m) + (xd.val % ℓ ^ m) * ℓ ^ d := by
                rw [Nat.add_mul, mul_right_comm, ← pow_add, hd]
      have hcast := congrArg (Nat.cast : ℕ → ZMod (ℓ ^ n)) hmul
      rw [Nat.cast_add, Nat.cast_mul (ℓ ^ n), ZMod.natCast_self, zero_mul, zero_add] at hcast
      rw [← hcast, Nat.cast_mul, ZMod.natCast_zmod_val, nsmul_eq_mul, mul_comm, Nat.cast_pow]

  have h0_A : ∀ (a b c : ℕ) (habc : a + c = b),
      CategoryTheory.CategoryStruct.comp
        (inc a b (Nat.le.intro habc))
        (red c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) = 0 := by
    intro a b c habc
    have hsub : b - a = c := by omega
    let hc_le_b : c ≤ b := Nat.le.intro ((Nat.add_comm c a).trans habc)
    apply AddCommGrpCat.ext; intro x; apply ULift.ext
    change ZMod.castHom (pow_dvd_pow ℓ hc_le_b) (ZMod (ℓ ^ c))
      ((x.down.val * ℓ ^ (b - a) : ℕ) : ZMod (ℓ ^ b)) = 0
    rw [hsub, map_natCast, Nat.cast_mul, ZMod.natCast_self, mul_zero]

  let SC_A : ∀ (a b c : ℕ) (habc : a + c = b), CategoryTheory.ShortComplex AddCommGrpCat.{u} :=
    fun a b c habc => CategoryTheory.ShortComplex.mk
      (inc a b (Nat.le.intro habc))
      (red c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
      (h0_A a b c habc)

  have hSE_A : ∀ (a b c : ℕ) (habc : a + c = b), (SC_A a b c habc).ShortExact := by
    intro a b c habc
    have hsub : b - a = c := by omega
    let hc_le_b : c ≤ b := Nat.le.intro ((Nat.add_comm c a).trans habc)
    let f_ab := inc a b (Nat.le.intro habc)
    let g_bc := red c b hc_le_b
    have hInj : Function.Injective f_ab.hom := by
      intro x y hxy
      have hxy' : ((x.down.val * ℓ ^ c : ℕ) : ZMod (ℓ ^ b)) =
          ((y.down.val * ℓ ^ c : ℕ) : ZMod (ℓ ^ b)) := by
        have h1 : (f_ab.hom x).down = (f_ab.hom y).down := congrArg ULift.down hxy
        change ((x.down.val * ℓ ^ (b - a) : ℕ) : ZMod (ℓ ^ b)) =
          ((y.down.val * ℓ ^ (b - a) : ℕ) : ZMod (ℓ ^ b)) at h1
        rwa [hsub] at h1
      have hlt_x : x.down.val * ℓ ^ c < ℓ ^ b := by
        rw [← habc, pow_add]
        exact Nat.mul_lt_mul_of_pos_right x.down.val_lt (pow_pos hPrime.pos c)
      have hlt_y : y.down.val * ℓ ^ c < ℓ ^ b := by
        rw [← habc, pow_add]
        exact Nat.mul_lt_mul_of_pos_right y.down.val_lt (pow_pos hPrime.pos c)
      have hval := congrArg ZMod.val hxy'
      rw [ZMod.val_natCast_of_lt hlt_x, ZMod.val_natCast_of_lt hlt_y] at hval
      have heq_val := Nat.eq_of_mul_eq_mul_right (pow_pos hPrime.pos c) hval
      exact ULift.ext _ _ (ZMod.val_injective (ℓ ^ a) heq_val)
    have hSurj : Function.Surjective g_bc.hom := by
      intro z
      obtain ⟨w, hw⟩ := ZMod.castHom_surjective (pow_dvd_pow ℓ hc_le_b) z.down
      exact ⟨ULift.up w, ULift.ext _ _ hw⟩
    have hMono : CategoryTheory.Mono f_ab := (AddCommGrpCat.mono_iff_injective f_ab).mpr hInj
    have hEpi : CategoryTheory.Epi g_bc := (AddCommGrpCat.epi_iff_surjective g_bc).mpr hSurj
    have hKer : ∀ y : ↑(A b), g_bc.hom y = 0 → ∃ x : ↑(A a), f_ab.hom x = y := by
      intro y hy
      let yd : ZMod (ℓ ^ b) := ULift.down y
      have hy' : ((yd.val : ℕ) : ZMod (ℓ ^ c)) = 0 := by
        have h1 : ZMod.castHom (pow_dvd_pow ℓ hc_le_b) (ZMod (ℓ ^ c)) yd = 0 :=
          congrArg ULift.down hy
        rwa [ZMod.castHom_apply, ZMod.cast_eq_val] at h1
      have hdvd : ℓ ^ c ∣ yd.val := (ZMod.natCast_eq_zero_iff yd.val (ℓ ^ c)).mp hy'
      obtain ⟨t, ht⟩ := hdvd
      have ht_lt : t < ℓ ^ a := by
        have hy_lt : yd.val < ℓ ^ a * ℓ ^ c := by rw [← pow_add, habc]; exact yd.val_lt
        rw [ht, mul_comm (ℓ ^ c) t] at hy_lt
        exact lt_of_mul_lt_mul_right hy_lt (Nat.zero_le _)
      refine ⟨ULift.up (t : ZMod (ℓ ^ a)), ULift.ext _ _ ?_⟩
      change (((t : ZMod (ℓ ^ a)).val * ℓ ^ (b - a) : ℕ) : ZMod (ℓ ^ b)) = yd
      rw [hsub, ZMod.val_natCast_of_lt ht_lt, mul_comm t (ℓ ^ c), ← ht, ZMod.natCast_zmod_val]
    let liftHom : ∀ {W : AddCommGrpCat.{u}} (k_hom : W ⟶ A b),
        CategoryTheory.CategoryStruct.comp k_hom g_bc = 0 → (W ⟶ A a) :=
      fun {W} k_hom hk =>
        have hk_pt : ∀ w : ↑W, g_bc.hom (k_hom.hom w) = 0 := fun w =>
          congrArg (fun m : W ⟶ A c => m.hom w) hk
        let l_fun : ↑W → ↑(A a) := fun w => Classical.choose (hKer (k_hom.hom w) (hk_pt w))
        have hl_spec : ∀ w : ↑W, f_ab.hom (l_fun w) = k_hom.hom w := fun w =>
          Classical.choose_spec (hKer (k_hom.hom w) (hk_pt w))
        AddCommGrpCat.ofHom
          { toFun := l_fun
            map_zero' := hInj ((hl_spec 0).trans (k_hom.hom.map_zero.trans f_ab.hom.map_zero.symm))
            map_add' := fun w₁ w₂ => hInj ((hl_spec (w₁ + w₂)).trans
              ((k_hom.hom.map_add w₁ w₂).trans
                ((congrArg₂ (· + ·) (hl_spec w₁).symm (hl_spec w₂).symm).trans
                  (f_ab.hom.map_add (l_fun w₁) (l_fun w₂)).symm))) }
    have hlift_fac : ∀ {W : AddCommGrpCat.{u}} (k_hom : W ⟶ A b)
        (hk : CategoryTheory.CategoryStruct.comp k_hom g_bc = 0),
        CategoryTheory.CategoryStruct.comp (liftHom k_hom hk) f_ab = k_hom :=
      fun {W} k_hom hk => AddCommGrpCat.ext fun w =>
        Classical.choose_spec (hKer (k_hom.hom w) (congrArg (fun m : W ⟶ A c => m.hom w) hk))
    let _ : CategoryTheory.Mono f_ab := hMono
    let cf := CategoryTheory.Limits.KernelFork.ofι f_ab (h0_A a b c habc)
    let hLimit : CategoryTheory.Limits.IsLimit cf :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun {W} k_hom hk => liftHom k_hom hk)
        (fun {W} k_hom hk => hlift_fac k_hom hk)
        (fun {W} k_hom hk _m hm =>
          (CategoryTheory.cancel_mono f_ab).mp (hm.trans (hlift_fac k_hom hk).symm))
    have hEx : (SC_A a b c habc).Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hLimit
    exact CategoryTheory.ShortComplex.ShortExact.mk' hEx hMono hEpi

  let Φ_A : ∀ (a c₁ c₂ : ℕ) (hc : c₁ ≤ c₂),
      SC_A a (a + c₁) c₁ rfl ⟶ SC_A a (a + c₂) c₂ rfl :=
    fun a c₁ c₂ hc =>
      { τ₁ := CategoryTheory.CategoryStruct.id (A a)
        τ₂ := inc (a + c₁) (a + c₂) (Nat.add_le_add_left hc a)
        τ₃ := inc c₁ c₂ hc
        comm₁₂ := by
          dsimp only [SC_A]
          rw [CategoryTheory.Category.id_comp]
          exact ((hComp_A a (a + c₁) (a + c₂)
            (Nat.le.intro (rfl : a + c₁ = a + c₁))
            (Nat.add_le_add_left hc a)).1).symm
        comm₂₃ := by
          dsimp only [SC_A]
          exact hMixed_A (a + c₁) (a + c₂) c₁ c₂ (c₂ - c₁)
            (Nat.add_le_add_left hc a) hc (Nat.le_add_left c₁ a) (Nat.le_add_left c₂ a)
            (by omega) (by omega) }

  
  let J_X := X.smallEtaleTopology
  let J_S := S.smallEtaleTopology
  let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
  let _ : CategoryTheory.Limits.PreservesFiniteLimits C_X :=
    CategoryTheory.Limits.comp_preservesFiniteLimits
      (CategoryTheory.Functor.const (Opposite X.Etale))
      (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u})
  let _ : CategoryTheory.Limits.PreservesFiniteColimits C_X :=
    CategoryTheory.Limits.comp_preservesFiniteColimits
      (CategoryTheory.Functor.const (Opposite X.Etale))
      (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u})
  have _ : C_X.Additive := by
    dsimp only [C_X, CategoryTheory.constantSheaf]
    infer_instance
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor S.Etale X.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  let P₀ : X.Etale → CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
    fun U => CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj U) AddCommGrpCat.free
  let L : X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun U => (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).obj (P₀ U)
  let F_coh : ∀ q : ℕ, CategoryTheory.Functor
      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}) :=
    fun q => CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft
      (Opposite S.Etale) (Opposite X.Etale) AddCommGrpCat.{u}).obj B.op
  let FWB : ∀ q : ℕ, CategoryTheory.Functor
      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
    fun q => CategoryTheory.Functor.comp (F_coh q) W_B
  let a_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  let T_fun : ∀ q : ℕ, CategoryTheory.Functor
      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
    fun q => CategoryTheory.Functor.comp (FWB q) a_S

  have hAdd_coh : ∀ q : ℕ, (F_coh q).Additive := fun q =>
    { map_add := fun {_ _} f₁ f₂ => by
        ext opU : 2
        change (CategoryTheory.Abelian.extFunctorObj (L opU.unop) q).map (f₁ + f₂) =
          (CategoryTheory.Abelian.extFunctorObj (L opU.unop) q).map f₁ +
            (CategoryTheory.Abelian.extFunctorObj (L opU.unop) q).map f₂
        exact (CategoryTheory.Abelian.extFunctorObj (L opU.unop) q).map_add }
  have hAdd_WB : W_B.Additive :=
    { map_add := fun {_ _} _ _ => by ext E : 2; rfl }
  have _ : ∀ q : ℕ, (T_fun q).Additive := by
    intro q
    have : (F_coh q).Additive := hAdd_coh q
    have : W_B.Additive := hAdd_WB
    have : (FWB q).Additive := by dsimp only [FWB]; infer_instance
    dsimp only [T_fun]
    infer_instance

  let G_q : ∀ q : ℕ, CategoryTheory.Functor AddCommGrpCat.{u}
      (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
    fun q => CategoryTheory.Functor.comp C_X (T_fun q)
  have _ : ∀ q : ℕ, (G_q q).Additive := by
    intro q
    dsimp only [G_q]
    infer_instance

  let ℳ' : ℕ → ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun q n => (G_q q).obj (A n)
  let τ_map' : ∀ (q m n : ℕ), m ≤ n → Quiver.Hom (ℳ' q n) (ℳ' q m) :=
    fun q m n h => (G_q q).map (red m n h)
  let j_map' : ∀ (q m n : ℕ), m ≤ n → Quiver.Hom (ℳ' q m) (ℳ' q n) :=
    fun q m n h => (G_q q).map (inc m n h)
  let SC_X : ∀ (a b c : ℕ) (habc : a + c = b),
      CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    fun a b c habc => (SC_A a b c habc).map C_X
  have hSE_X : ∀ (a b c : ℕ) (habc : a + c = b), (SC_X a b c habc).ShortExact :=
    fun a b c habc => (hSE_A a b c habc).map_of_exact C_X
  let Φ_X : ∀ (a c₁ c₂ : ℕ) (hc : c₁ ≤ c₂),
      SC_X a (a + c₁) c₁ rfl ⟶ SC_X a (a + c₂) c₂ rfl :=
    fun a c₁ c₂ hc => (C_X.mapShortComplex).map (Φ_A a c₁ c₂ hc)

  
  let δ_tilde : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})},
      SC.ShortExact → ∀ q : ℕ, ((F_coh q).obj SC.X₃) ⟶ ((F_coh (q + 1)).obj SC.X₁) :=
    fun {SC} hSE q =>
      { app := fun opU =>
          AddCommGrpCat.ofHom (hSE.extClass.postcomp (L opU.unop) (rfl : q + 1 = q + 1))
        naturality := fun opU opV f_op => by
          ext ξ
          let w_u : P₀ opV.unop ⟶ P₀ opU.unop := CategoryTheory.Functor.whiskerRight
            (CategoryTheory.yoneda.map f_op.unop) AddCommGrpCat.free
          let l_u : L opV.unop ⟶ L opU.unop :=
            (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).map w_u
          have hm1 : (((F_coh q).obj SC.X₃).map f_op) ξ =
              (CategoryTheory.Abelian.Ext.mk₀ l_u).comp ξ (Nat.zero_add q) := by
            change (((CategoryTheory.Abelian.extFunctor q).map l_u.op).app SC.X₃) ξ =
              (CategoryTheory.Abelian.Ext.mk₀ l_u).comp ξ (Nat.zero_add q)
            rw [CategoryTheory.Abelian.extFunctor_map_app]
            rfl
          have hm2 : ∀ η : CategoryTheory.Abelian.Ext (L opU.unop) SC.X₁ (q + 1),
              (((F_coh (q + 1)).obj SC.X₁).map f_op) η =
              (CategoryTheory.Abelian.Ext.mk₀ l_u).comp η (Nat.zero_add (q + 1)) := by
            intro η
            change (((CategoryTheory.Abelian.extFunctor (q + 1)).map l_u.op).app SC.X₁) η =
              (CategoryTheory.Abelian.Ext.mk₀ l_u).comp η (Nat.zero_add (q + 1))
            rw [CategoryTheory.Abelian.extFunctor_map_app]
            rfl
          change (hSE.extClass.postcomp (L opV.unop) rfl) ((((F_coh q).obj SC.X₃).map f_op) ξ) =
            (((F_coh (q + 1)).obj SC.X₁).map f_op) ((hSE.extClass.postcomp (L opU.unop) rfl) ξ)
          rw [hm1, hm2]
          change ((CategoryTheory.Abelian.Ext.mk₀ l_u).comp ξ (Nat.zero_add q)).comp hSE.extClass rfl =
            (CategoryTheory.Abelian.Ext.mk₀ l_u).comp (ξ.comp hSE.extClass rfl) (Nat.zero_add (q + 1))
          exact @CategoryTheory.Abelian.Ext.comp_assoc _ _ _ _ _ _ _ _ 0 q 1 q (q + 1) (q + 1)
            (CategoryTheory.Abelian.Ext.mk₀ l_u) ξ hSE.extClass (Nat.zero_add q) rfl (by omega) }

  let δ_fun : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})},
      SC.ShortExact → ∀ q : ℕ, ((T_fun q).obj SC.X₃) ⟶ ((T_fun (q + 1)).obj SC.X₁) :=
    fun {_} hSE q => a_S.map (W_B.map (δ_tilde hSE q))

  let δ_map' : ∀ (q a b c : ℕ), a + c = b → Quiver.Hom (ℳ' q c) (ℳ' (q + 1) a) :=
    fun q a b c habc => δ_fun (hSE_X a b c habc) q

  have sc_zero_ab : ∀ {SC₀ : CategoryTheory.ShortComplex AddCommGrpCat.{u}},
      SC₀.Exact → SC₀.f ≫ SC₀.g = 0 :=
    fun {SC₀} _ => SC₀.zero

  have hPresheafExact : ∀ (S_pre : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})),
      (∀ E : Opposite S.Etale,
        (S_pre.map ((CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj E)).Exact) →
      S_pre.Exact := by
    intro S_pre hEv
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_homology,
      CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    ext E : 2
    let evE := (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj E
    have hZeroE : CategoryTheory.Limits.IsZero (S_pre.map evE).homology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_homology (S_pre.map evE)).mp (hEv E)
    have hZeroObj : CategoryTheory.Limits.IsZero (S_pre.homology.obj E) :=
      hZeroE.of_iso (S_pre.mapHomologyIso evE).symm
    exact hZeroObj.eq_of_src _ _

  have hLES_gen : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})}
      (hSE : SC.ShortExact),
      CategoryTheory.Mono ((T_fun 0).map SC.f) ∧
      ∀ q : ℕ,
        (∃ h₁ : CategoryTheory.CategoryStruct.comp ((T_fun q).map SC.f) ((T_fun q).map SC.g) = 0,
          (CategoryTheory.ShortComplex.mk ((T_fun q).map SC.f) ((T_fun q).map SC.g) h₁).Exact) ∧
        (∃ h₂ : CategoryTheory.CategoryStruct.comp ((T_fun q).map SC.g) (δ_fun hSE q) = 0,
          (CategoryTheory.ShortComplex.mk ((T_fun q).map SC.g) (δ_fun hSE q) h₂).Exact) ∧
        (∃ h₃ : CategoryTheory.CategoryStruct.comp (δ_fun hSE q) ((T_fun (q + 1)).map SC.f) = 0,
          (CategoryTheory.ShortComplex.mk (δ_fun hSE q) ((T_fun (q + 1)).map SC.f) h₃).Exact) := by
    intro SC hSE
    let α_hat : ∀ q : ℕ, (FWB q).obj SC.X₁ ⟶ (FWB q).obj SC.X₂ := fun q => (FWB q).map SC.f
    let β_hat : ∀ q : ℕ, (FWB q).obj SC.X₂ ⟶ (FWB q).obj SC.X₃ := fun q => (FWB q).map SC.g
    let δ_hat : ∀ q : ℕ, (FWB q).obj SC.X₃ ⟶ (FWB (q + 1)).obj SC.X₁ := fun q => W_B.map (δ_tilde hSE q)
    have hα_app : ∀ (q : ℕ) (E : Opposite S.Etale),
        (α_hat q).app E = AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (L (B.obj E.unop)) (Nat.add_zero q)) := by
      intro q E
      change (CategoryTheory.Abelian.extFunctorObj (L (B.obj E.unop)) q).map SC.f = _
      exact CategoryTheory.Abelian.extFunctorObj_map _ _ _
    have hβ_app : ∀ (q : ℕ) (E : Opposite S.Etale),
        (β_hat q).app E = AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (L (B.obj E.unop)) (Nat.add_zero q)) := by
      intro q E
      change (CategoryTheory.Abelian.extFunctorObj (L (B.obj E.unop)) q).map SC.g = _
      exact CategoryTheory.Abelian.extFunctorObj_map _ _ _
    have hMono_hat0 : CategoryTheory.Mono (α_hat 0) := by
      have : ∀ E : Opposite S.Etale, CategoryTheory.Mono ((α_hat 0).app E) := by
        intro E
        rw [AddCommGrpCat.mono_iff_injective]
        intro ξ₁ ξ₂ hξ
        have hcomp_eq : CategoryTheory.Abelian.Ext.homEquiv₀ (((α_hat 0).app E) ξ₁) =
            CategoryTheory.Abelian.Ext.homEquiv₀ (((α_hat 0).app E) ξ₂) :=
          congrArg CategoryTheory.Abelian.Ext.homEquiv₀ hξ
        have hpost : ∀ ξ : CategoryTheory.Abelian.Ext (L (B.obj E.unop)) SC.X₁ 0,
            CategoryTheory.Abelian.Ext.homEquiv₀ (((α_hat 0).app E) ξ) =
            CategoryTheory.Abelian.Ext.homEquiv₀ ξ ≫ SC.f := by
          intro ξ
          rw [hα_app 0 E]
          change CategoryTheory.Abelian.Ext.homEquiv₀
              (ξ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 0)) =
            CategoryTheory.Abelian.Ext.homEquiv₀ ξ ≫ SC.f
          conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply ξ]
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply]
        rw [hpost ξ₁, hpost ξ₂] at hcomp_eq
        have : CategoryTheory.Mono SC.f := hSE.mono_f
        exact CategoryTheory.Abelian.Ext.homEquiv₀.injective ((cancel_mono SC.f).mp hcomp_eq)
      exact CategoryTheory.NatTrans.mono_of_mono_app (α_hat 0)
    refine ⟨a_S.map_mono (α_hat 0), fun q => ?_⟩
    have hαβ_hat : α_hat q ≫ β_hat q = 0 := by
      ext E : 2
      change (α_hat q).app E ≫ (β_hat q).app E = 0
      rw [hα_app q E, hβ_app q E]
      exact sc_zero_ab (CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (L (B.obj E.unop)) hSE q)
    have hβδ_hat : β_hat q ≫ δ_hat q = 0 := by
      ext E : 2
      change (β_hat q).app E ≫ (δ_hat q).app E = 0
      rw [hβ_app q E]
      exact sc_zero_ab (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (L (B.obj E.unop)) hSE q (q + 1) rfl)
    have hδα_hat : δ_hat q ≫ α_hat (q + 1) = 0 := by
      ext E : 2
      change (δ_hat q).app E ≫ (α_hat (q + 1)).app E = 0
      rw [hα_app (q + 1) E]
      exact sc_zero_ab (CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (L (B.obj E.unop)) hSE q (q + 1) rfl)
    have hEx1_hat : (CategoryTheory.ShortComplex.mk (α_hat q) (β_hat q) hαβ_hat).Exact := by
      apply hPresheafExact
      intro E
      have hExE := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (L (B.obj E.unop)) hSE q
      exact CategoryTheory.ShortComplex.exact_of_iso
        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          ((CategoryTheory.Category.id_comp _).trans
            ((hα_app q E).trans (CategoryTheory.Category.comp_id _).symm))
          ((CategoryTheory.Category.id_comp _).trans
            ((hβ_app q E).trans (CategoryTheory.Category.comp_id _).symm))) hExE
    have hEx2_hat : (CategoryTheory.ShortComplex.mk (β_hat q) (δ_hat q) hβδ_hat).Exact := by
      apply hPresheafExact
      intro E
      have hExE := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (L (B.obj E.unop)) hSE q (q + 1) rfl
      exact CategoryTheory.ShortComplex.exact_of_iso
        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          ((CategoryTheory.Category.id_comp _).trans
            ((hβ_app q E).trans (CategoryTheory.Category.comp_id _).symm))
          ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm)) hExE
    have hEx3_hat : (CategoryTheory.ShortComplex.mk (δ_hat q) (α_hat (q + 1)) hδα_hat).Exact := by
      apply hPresheafExact
      intro E
      have hExE := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (L (B.obj E.unop)) hSE q (q + 1) rfl
      exact CategoryTheory.ShortComplex.exact_of_iso
        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm)
          ((CategoryTheory.Category.id_comp _).trans
            ((hα_app (q + 1) E).trans (CategoryTheory.Category.comp_id _).symm))) hExE
    have h₁ : CategoryTheory.CategoryStruct.comp ((T_fun q).map SC.f) ((T_fun q).map SC.g) = 0 := by
      change a_S.map (α_hat q) ≫ a_S.map (β_hat q) = 0
      rw [← a_S.map_comp, hαβ_hat, a_S.map_zero]
    have h₂ : CategoryTheory.CategoryStruct.comp ((T_fun q).map SC.g) (δ_fun hSE q) = 0 := by
      change a_S.map (β_hat q) ≫ a_S.map (δ_hat q) = 0
      rw [← a_S.map_comp, hβδ_hat, a_S.map_zero]
    have h₃ : CategoryTheory.CategoryStruct.comp (δ_fun hSE q) ((T_fun (q + 1)).map SC.f) = 0 := by
      change a_S.map (δ_hat q) ≫ a_S.map (α_hat (q + 1)) = 0
      rw [← a_S.map_comp, hδα_hat, a_S.map_zero]
    exact ⟨⟨h₁, hEx1_hat.map a_S⟩, ⟨h₂, hEx2_hat.map a_S⟩, ⟨h₃, hEx3_hat.map a_S⟩⟩

  let GoalPred :
      ∀ (M₀ : ℕ → ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (q m n : ℕ), m ≤ n → Quiver.Hom (M₀ q n) (M₀ q m)) → Prop :=
    fun M₀ T₀ =>
      ∃ (j_map : ∀ (q m n : ℕ), m ≤ n → Quiver.Hom (M₀ q m) (M₀ q n))
        (δ_map : ∀ (q a b c : ℕ), a + c = b → Quiver.Hom (M₀ q c) (M₀ (q + 1) a)),
        ((∀ q : ℕ, CategoryTheory.Limits.IsZero (M₀ q 0)) ∧
          (∀ (q n : ℕ), (ℓ ^ n) • CategoryTheory.CategoryStruct.id (M₀ q n) = 0)) ∧
        ((∀ (q n : ℕ) (h : n ≤ n),
            j_map q n n h = CategoryTheory.CategoryStruct.id (M₀ q n) ∧
            T₀ q n n h = CategoryTheory.CategoryStruct.id (M₀ q n)) ∧
          (∀ (q k m n : ℕ) (h₁ : k ≤ m) (h₂ : m ≤ n),
            CategoryTheory.CategoryStruct.comp (j_map q k m h₁) (j_map q m n h₂) =
              j_map q k n (le_trans h₁ h₂) ∧
            CategoryTheory.CategoryStruct.comp (T₀ q m n h₂) (T₀ q k m h₁) =
              T₀ q k n (le_trans h₁ h₂)) ∧
          (∀ (q m₁ n₁ m₂ n₂ d : ℕ) (h₁ : m₁ ≤ n₁) (h₂ : m₂ ≤ n₂)
              (hm : m₂ ≤ m₁) (hn : n₂ ≤ n₁),
            m₁ + d = n₁ → m₂ + d = n₂ →
            CategoryTheory.CategoryStruct.comp (j_map q m₁ n₁ h₁) (T₀ q n₂ n₁ hn) =
              CategoryTheory.CategoryStruct.comp (T₀ q m₂ m₁ hm) (j_map q m₂ n₂ h₂)) ∧
          (∀ (q m n d : ℕ) (h : m ≤ n),
            m + d = n →
            CategoryTheory.CategoryStruct.comp (j_map q m n h) (T₀ q m n h) =
              (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M₀ q m) ∧
            CategoryTheory.CategoryStruct.comp (T₀ q m n h) (j_map q m n h) =
              (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M₀ q n))) ∧
        (∀ (a b c : ℕ) (habc : a + c = b),
          CategoryTheory.Mono (j_map 0 a b (Nat.le.intro habc)) ∧
          ∀ q : ℕ,
            (∃ h₁ : CategoryTheory.CategoryStruct.comp
                (j_map q a b (Nat.le.intro habc))
                (T₀ q c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) = 0,
              (CategoryTheory.ShortComplex.mk
                (j_map q a b (Nat.le.intro habc))
                (T₀ q c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) h₁).Exact) ∧
            (∃ h₂ : CategoryTheory.CategoryStruct.comp
                (T₀ q c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
                (δ_map q a b c habc) = 0,
              (CategoryTheory.ShortComplex.mk
                (T₀ q c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
                (δ_map q a b c habc) h₂).Exact) ∧
            (∃ h₃ : CategoryTheory.CategoryStruct.comp
                (δ_map q a b c habc)
                (j_map (q + 1) a b (Nat.le.intro habc)) = 0,
              (CategoryTheory.ShortComplex.mk
                (δ_map q a b c habc)
                (j_map (q + 1) a b (Nat.le.intro habc)) h₃).Exact)) ∧
        (∀ (q a c₁ c₂ : ℕ) (hc : c₁ ≤ c₂),
          CategoryTheory.CategoryStruct.comp (j_map q c₁ c₂ hc) (δ_map q a (a + c₂) c₂ rfl) =
            δ_map q a (a + c₁) c₁ rfl)

  have hGoal' : GoalPred ℳ' τ_map' := by
    refine ⟨j_map', δ_map', ?_, ?_, ?_, ?_⟩
    · refine ⟨fun q => (G_q q).map_isZero hZero_A0, fun q n => ?_⟩
      dsimp only [ℳ']
      rw [← (G_q q).map_id, ← (G_q q).map_nsmul, hTor_A n, (G_q q).map_zero]
    · refine ⟨?_, ?_, ?_, ?_⟩
      · intro q n h
        dsimp only [j_map', τ_map', ℳ']
        rw [(hId_A n h).1, (hId_A n h).2, (G_q q).map_id]
        exact ⟨rfl, rfl⟩
      · intro q k m n h₁ h₂
        dsimp only [j_map', τ_map']
        exact ⟨by rw [← (G_q q).map_comp, (hComp_A k m n h₁ h₂).1],
          by rw [← (G_q q).map_comp, (hComp_A k m n h₁ h₂).2]⟩
      · intro q m₁ n₁ m₂ n₂ d h₁ h₂ hm hn hd₁ hd₂
        dsimp only [j_map', τ_map']
        rw [← (G_q q).map_comp, ← (G_q q).map_comp,
          hMixed_A m₁ n₁ m₂ n₂ d h₁ h₂ hm hn hd₁ hd₂]
      · intro q m n d h hd
        dsimp only [j_map', τ_map', ℳ']
        exact ⟨by rw [← (G_q q).map_comp, (hMul_A m n d h hd).1, (G_q q).map_nsmul, (G_q q).map_id],
          by rw [← (G_q q).map_comp, (hMul_A m n d h hd).2, (G_q q).map_nsmul, (G_q q).map_id]⟩
    · intro a b c habc
      have hLES := hLES_gen (hSE_X a b c habc)
      dsimp only [SC_X, SC_A, CategoryTheory.ShortComplex.map] at hLES
      dsimp only [j_map', τ_map', δ_map', G_q, SC_X, SC_A,
        CategoryTheory.ShortComplex.map, CategoryTheory.Functor.comp_map]
      exact hLES
    · intro q a c₁ c₂ hc
      let hSE₁ := hSE_X a (a + c₁) c₁ rfl
      let hSE₂ := hSE_X a (a + c₂) c₂ rfl
      let Φ := Φ_X a c₁ c₂ hc
      have hτ₁_id : Φ.τ₁ = CategoryTheory.CategoryStruct.id _ := C_X.map_id (A a)
      have h_ext : hSE₁.extClass =
          (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₃).comp hSE₂.extClass (Nat.zero_add 1) := by
        calc hSE₁.extClass
            = hSE₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id _))
                (Nat.add_zero 1) :=
              (CategoryTheory.Abelian.Ext.comp_mk₀_id hSE₁.extClass).symm
          _ = hSE₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₁) (Nat.add_zero 1) := by
              rw [hτ₁_id]
          _ = (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₃).comp hSE₂.extClass (Nat.zero_add 1) :=
              CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₁ hSE₂ Φ
      have h_tilde : CategoryTheory.CategoryStruct.comp
          ((F_coh q).map Φ.τ₃) (δ_tilde hSE₂ q) = δ_tilde hSE₁ q := by
        ext opU ξ
        have hmap : (((F_coh q).map Φ.τ₃).app opU) ξ =
            ξ.comp (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₃) (Nat.add_zero q) := by
          change ((CategoryTheory.Abelian.extFunctorObj (L opU.unop) q).map Φ.τ₃) ξ = _
          rw [CategoryTheory.Abelian.extFunctorObj_map]
          rfl
        change (hSE₂.extClass.postcomp (L opU.unop) (rfl : q + 1 = q + 1))
            ((((F_coh q).map Φ.τ₃).app opU) ξ) =
          (hSE₁.extClass.postcomp (L opU.unop) (rfl : q + 1 = q + 1)) ξ
        rw [hmap]
        change (ξ.comp (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₃) (Nat.add_zero q)).comp
            hSE₂.extClass (rfl : q + 1 = q + 1) =
          ξ.comp hSE₁.extClass (rfl : q + 1 = q + 1)
        rw [CategoryTheory.Abelian.Ext.comp_assoc ξ (CategoryTheory.Abelian.Ext.mk₀ Φ.τ₃)
          hSE₂.extClass (Nat.add_zero q) (Nat.zero_add 1) (rfl : q + 1 = q + 1), ← h_ext]
      change CategoryTheory.CategoryStruct.comp
          (a_S.map (W_B.map ((F_coh q).map Φ.τ₃)))
          (a_S.map (W_B.map (δ_tilde hSE₂ q))) =
        a_S.map (W_B.map (δ_tilde hSE₁ q))
      rw [← a_S.map_comp, ← W_B.map_comp, h_tilde]

  have hTransfer : ∀ (M₀ : ℕ → ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (T₀ : ∀ (q m n : ℕ), m ≤ n → Quiver.Hom (M₀ q n) (M₀ q m)),
      M₀ = ℳ' → HEq T₀ τ_map' → GoalPred M₀ T₀ := by
    intro M₀ T₀ hM hT
    subst hM
    cases hT
    exact hGoal'

  refine hTransfer ℳ τ_map ?_ ?_
  · funext q n
    dsimp only [ℳ, ℳ', weilEtaleHigherDirectImage, weilEtaleTorsionSheaf,
      G_q, T_fun, FWB, F_coh, W_B, a_S, C_X, A, B, J_X, J_S,
      CategoryTheory.Functor.comp_obj, CategoryTheory.Functor.whiskeringLeft_obj_obj,
      CategoryTheory.Sheaf.cohomologyPresheaf]
  · refine Function.hfunext rfl fun q _ hq => ?_
    cases hq
    refine Function.hfunext rfl fun m _ hm => ?_
    cases hm
    refine Function.hfunext rfl fun n _ hn => ?_
    cases hn
    refine Function.hfunext rfl fun h _ hh => ?_
    cases hh
    exact HEq.rfl

theorem weil_sing_dev_ar_constructible_mod_prime_noetherian (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
    [AlgebraicGeometry.QuasiCompact Y.hom]
    [AlgebraicGeometry.IsSeparated Y.hom]
    (𝒢 : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}) :
    WeilIsConstructibleModPrimeSheaf ℓ Y.left 𝒢 →
    CategoryTheory.IsNoetherianObject 𝒢 :=
by
  classical
  intro h𝒢
  let S : AlgebraicGeometry.Scheme.{u} := Y.left
  let R := ULift.{u, 0} (ZMod ℓ)
  have hm_ℓ : 1 ≤ ℓ := (Fact.out : Nat.Prime ℓ).one_le
  haveI : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  haveI : P_et.IsStableUnderComposition :=
    { comp_mem := fun _ _ hf hg => by
        haveI : AlgebraicGeometry.Etale _ := hf
        haveI : AlgebraicGeometry.Etale _ := hg
        exact inferInstance }

  
  have weil_sing_dev_ar_mod_prime_sheaf_module_bridge :
      ∃ (P_𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)),
        (CategoryTheory.IsNoetherianObject P_𝒢 → CategoryTheory.IsNoetherianObject 𝒢) ∧
        ∀ (V : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom V S) (A : AddCommGrpCat.{u}),
          Finite A →
          ℓ • CategoryTheory.CategoryStruct.id A = 0 →
          WeilIsEtaleSheafPullback h 𝒢
            ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A) →
          ∃ (M_A : ModuleCat.{u, u} R) (_ : Finite M_A),
            let B_h : CategoryTheory.Functor S.Etale V.Etale :=
              CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
            ∀ [_hc : B_h.IsContinuous S.smallEtaleTopology V.smallEtaleTopology]
              [_hr : (B_h.sheafPushforwardContinuous (ModuleCat.{u, u} R)
                S.smallEtaleTopology V.smallEtaleTopology).IsRightAdjoint],
              Nonempty (CategoryTheory.Iso
                ((B_h.sheafPullback (ModuleCat.{u, u} R)
                  S.smallEtaleTopology V.smallEtaleTopology).obj P_𝒢)
                ((CategoryTheory.constantSheaf V.smallEtaleTopology (ModuleCat.{u, u} R)).obj M_A)) := by
    let uliftZModMod : ∀ {G : Type u} [AddCommGroup G], (∀ x : G, ℓ • x = 0) → Module R G :=
      fun {G} _ hG =>
        letI : Module (ZMod ℓ) G := AddCommGroup.zmodModule hG
        { smul := fun r x => r.down • x
          one_smul := fun x => one_smul (ZMod ℓ) x
          mul_smul := fun r s x => mul_smul r.down s.down x
          smul_zero := fun r => smul_zero r.down
          smul_add := fun r x y => smul_add r.down x y
          add_smul := fun r s x => add_smul r.down s.down x
          zero_smul := fun x => zero_smul (ZMod ℓ) x }
    let Fgt := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    have hFgt_faith : Fgt.Faithful :=
      { map_injective := fun {_ _} {_ _} hg => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          exact CategoryTheory.ConcreteCategory.congr_hom hg x }
    have hFgt_full : Fgt.Full :=
      { map_surjective := fun {M₁ M₂} f =>
          ⟨ModuleCat.ofHom
            { toFun := f.hom
              map_add' := map_add f.hom
              map_smul' := fun r x => by
                dsimp
                let fx : ↑M₂ := f.hom x
                have hr_nat : ((r.down.val : ℕ) : R) = r := by
                  ext
                  exact ZMod.natCast_zmod_val r.down
                calc
                  f.hom (r • x)
                    = f.hom (((r.down.val : ℕ) : R) • x) := by rw [hr_nat]
                  _ = f.hom (r.down.val • x) := by rw [Nat.cast_smul_eq_nsmul R]
                  _ = r.down.val • fx := map_nsmul f.hom r.down.val x
                  _ = ((r.down.val : ℕ) : R) • fx := by rw [Nat.cast_smul_eq_nsmul R]
                  _ = r • fx := by rw [hr_nat] },
           by ext x; rfl⟩ }
    let φ_Z : ℤ →+* R := Int.castRingHom R
    let Fgtℤ := CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}
    let E_ℤ := Fgtℤ.asEquivalence
    let e_fgt : (ModuleCat.restrictScalars.{u, 0, u} φ_Z).comp E_ℤ.functor ≅ Fgt :=
      CategoryTheory.NatIso.ofComponents
        (fun X => (RestrictScalars.addEquiv ℤ R ↥X).toAddCommGrpIso)
        (fun _ => by ext x; rfl)
    let adj_L :=
      (E_ℤ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj.{u, 0, u} φ_Z)).ofNatIsoRight
        e_fgt
    let adj_R :=
      ((ModuleCat.restrictCoextendScalarsAdj.{u, 0, u} φ_Z).comp E_ℤ.toAdjunction).ofNatIsoLeft
        e_fgt
    let rightAdjOf : ∀ {D₁ D₂ : Type (u + 1)}
        [CategoryTheory.Category.{u, u + 1} D₁] [CategoryTheory.Category.{u, u + 1} D₂]
        {L_f : D₁ ⥤ D₂} {R_f : D₂ ⥤ D₁}, (L_f ⊣ R_f) → (D₂ ⥤ D₁) :=
      fun {_ _ _ _ _ R_f} _ => R_f
    let C_0 := rightAdjOf adj_R
    have hSheafCompOfAdj : ∀ {D₁ D₂ : Type (u + 1)}
        [CategoryTheory.Category.{u, u + 1} D₁] [CategoryTheory.Category.{u, u + 1} D₂]
        {L_f : CategoryTheory.Functor D₁ D₂} {R_f : CategoryTheory.Functor D₂ D₁}
        (adj : L_f ⊣ R_f) {E_cat : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E_cat]
        (J : CategoryTheory.GrothendieckTopology E_cat),
        J.HasSheafCompose R_f := by
      intro D₁ D₂ _ _ L_f R_f adj E_cat _ J
      refine ⟨fun P₀ hP₀ A₀ => ?_⟩
      let e_iso : (P₀.comp R_f).comp (CategoryTheory.coyoneda.obj (Opposite.op A₀)) ≅
          P₀.comp (CategoryTheory.coyoneda.obj (Opposite.op (L_f.obj A₀))) :=
        CategoryTheory.NatIso.ofComponents
          (fun X => (adj.homEquiv A₀ (P₀.obj X)).symm.toIso)
          (fun {X Y} g => by
            ext u
            dsimp
            exact adj.homEquiv_naturality_right_symm u (P₀.map g))
      exact CategoryTheory.Presieve.isSheaf_iso J e_iso.symm (hP₀ (L_f.obj A₀))
    let hHSC_Fgt : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        Z.smallEtaleTopology.HasSheafCompose Fgt :=
      fun Z => hSheafCompOfAdj adj_L Z.smallEtaleTopology
    let hHSC_C0 : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        Z.smallEtaleTopology.HasSheafCompose C_0 :=
      fun Z => hSheafCompOfAdj adj_R Z.smallEtaleTopology
    let U_dir : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.Functor
          (CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R))
          (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
      fun Z => @CategoryTheory.sheafCompose _ _ _ _ _ _ Z.smallEtaleTopology Fgt (hHSC_Fgt Z)
    let C_dir : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.Functor
          (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)) :=
      fun Z => @CategoryTheory.sheafCompose _ _ _ _ _ _ Z.smallEtaleTopology C_0 (hHSC_C0 Z)
    let adj_UC : ∀ (Z : AlgebraicGeometry.Scheme.{u}), U_dir Z ⊣ C_dir Z :=
      fun Z =>
        CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun M₀ G₀ =>
              { toFun := fun η =>
                  CategoryTheory.InducedCategory.homMk
                    { app := fun X => (adj_R.homEquiv (M₀.obj.obj X) (G₀.obj.obj X)) (η.hom.app X)
                      naturality := fun {X Y} g => by
                        let ηX : Fgt.obj (M₀.obj.obj X) ⟶ G₀.obj.obj X := η.hom.app X
                        let ηY : Fgt.obj (M₀.obj.obj Y) ⟶ G₀.obj.obj Y := η.hom.app Y
                        have hnat : Fgt.map (M₀.obj.map g) ≫ ηY = ηX ≫ G₀.obj.map g :=
                          η.hom.naturality g
                        change M₀.obj.map g ≫ (adj_R.homEquiv (M₀.obj.obj Y) (G₀.obj.obj Y)) ηY =
                          (adj_R.homEquiv (M₀.obj.obj X) (G₀.obj.obj X)) ηX ≫ C_0.map (G₀.obj.map g)
                        rw [← adj_R.homEquiv_naturality_left, hnat,
                          adj_R.homEquiv_naturality_right] }
                invFun := fun θ =>
                  CategoryTheory.InducedCategory.homMk
                    { app := fun X =>
                        (adj_R.homEquiv (M₀.obj.obj X) (G₀.obj.obj X)).symm (θ.hom.app X)
                      naturality := fun {X Y} g => by
                        let θX : M₀.obj.obj X ⟶ C_0.obj (G₀.obj.obj X) := θ.hom.app X
                        let θY : M₀.obj.obj Y ⟶ C_0.obj (G₀.obj.obj Y) := θ.hom.app Y
                        have hnat : M₀.obj.map g ≫ θY = θX ≫ C_0.map (G₀.obj.map g) :=
                          θ.hom.naturality g
                        change Fgt.map (M₀.obj.map g) ≫
                            (adj_R.homEquiv (M₀.obj.obj Y) (G₀.obj.obj Y)).symm θY =
                          (adj_R.homEquiv (M₀.obj.obj X) (G₀.obj.obj X)).symm θX ≫ G₀.obj.map g
                        rw [← adj_R.homEquiv_naturality_right_symm, ← hnat,
                          adj_R.homEquiv_naturality_left_symm] }
                left_inv := fun η => by
                  apply CategoryTheory.InducedCategory.hom_ext
                  apply CategoryTheory.NatTrans.ext
                  funext X
                  exact Equiv.symm_apply_apply
                    (adj_R.homEquiv (M₀.obj.obj X) (G₀.obj.obj X)) (η.hom.app X)
                right_inv := fun θ => by
                  apply CategoryTheory.InducedCategory.hom_ext
                  apply CategoryTheory.NatTrans.ext
                  funext X
                  exact Equiv.apply_symm_apply
                    (adj_R.homEquiv (M₀.obj.obj X) (G₀.obj.obj X)) (θ.hom.app X) }
            homEquiv_naturality_left_symm := fun {M₁ M₂ G₀} g θ => by
              apply CategoryTheory.InducedCategory.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext X
              exact adj_R.homEquiv_naturality_left_symm (g.hom.app X) (θ.hom.app X)
            homEquiv_naturality_right := fun {M₀ G₁ G₂} η g => by
              apply CategoryTheory.InducedCategory.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext X
              exact adj_R.homEquiv_naturality_right (η.hom.app X) (g.hom.app X) }
    have hU_faith : ∀ (Z : AlgebraicGeometry.Scheme.{u}), (U_dir Z).Faithful :=
      fun Z =>
        { map_injective := fun {_ _} {u₁ u₂} hu => by
            apply CategoryTheory.InducedCategory.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext W
            apply Fgt.map_injective
            exact congrArg (fun θ => θ.hom.app W) hu }
    have hU_full : ∀ (Z : AlgebraicGeometry.Scheme.{u}), (U_dir Z).Full :=
      fun Z =>
        { map_surjective := fun {P₁ P₂} θ =>
            let θ_app : ∀ W : (Z.Etale)ᵒᵖ, Fgt.obj (P₁.obj.obj W) ⟶ Fgt.obj (P₂.obj.obj W) :=
              fun W => θ.hom.app W
            ⟨CategoryTheory.InducedCategory.homMk
              { app := fun W => Fgt.preimage (θ_app W)
                naturality := fun {W₁ W₂} g => by
                  apply Fgt.map_injective
                  rw [Fgt.map_comp, Fgt.map_comp, Fgt.map_preimage, Fgt.map_preimage]
                  exact θ.hom.naturality g },
             by
               apply CategoryTheory.InducedCategory.hom_ext
               apply CategoryTheory.NatTrans.ext
               funext W
               exact Fgt.map_preimage (θ_app W)⟩ }
    let e_of : ∀ (G : AddCommGrpCat.{u}), AddCommGrpCat.of ↑G ≅ G :=
      fun G =>
        { hom := AddCommGrpCat.ofHom (AddMonoidHom.id ↑G)
          inv := AddCommGrpCat.ofHom (AddMonoidHom.id ↑G)
          hom_inv_id := by ext x; rfl
          inv_hom_id := by ext x; rfl }
    have h_nsmul_sec : ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (t : ℕ) (W : (S.Etale)ᵒᵖ) (x : ↑(ℱ.obj.obj W)),
        ((t • CategoryTheory.CategoryStruct.id ℱ).hom.app W).hom x = t • x := by
      intro ℱ t W x
      induction t with
      | zero =>
        rw [zero_smul, zero_smul]
        rfl
      | succ t ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((t • CategoryTheory.CategoryStruct.id ℱ).hom.app W).hom x +
          ((CategoryTheory.CategoryStruct.id ℱ).hom.app W).hom x = t • x + x
        rw [ih]
        rfl
    have hPromote : ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id ℱ = 0 →
        ∃ (P_ℱ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)),
          Nonempty ((U_dir S).obj P_ℱ ≅ ℱ) := by
      intro ℱ hℱ
      have hW_tor : ∀ (W : (S.Etale)ᵒᵖ) (x : ↑(ℱ.obj.obj W)), ℓ • x = 0 := by
        intro W x
        rw [← h_nsmul_sec ℱ ℓ W x, hℱ]
        rfl
      let M_obj : (S.Etale)ᵒᵖ → ModuleCat.{u, u} R :=
        fun W => @ModuleCat.of R _ ↑(ℱ.obj.obj W) _ (uliftZModMod (hW_tor W))
      let e_W : ∀ (W : (S.Etale)ᵒᵖ), Fgt.obj (M_obj W) ≅ ℱ.obj.obj W :=
        fun W => e_of (ℱ.obj.obj W)
      let M_map : ∀ {W₁ W₂ : (S.Etale)ᵒᵖ}, (W₁ ⟶ W₂) → (M_obj W₁ ⟶ M_obj W₂) :=
        fun {W₁ W₂} g => Fgt.preimage ((e_W W₁).hom ≫ ℱ.obj.map g ≫ (e_W W₂).inv)
      let P_pre : CategoryTheory.Functor (S.Etale)ᵒᵖ (ModuleCat.{u, u} R) :=
        { obj := M_obj
          map := fun g => M_map g
          map_id := fun W => by
            apply Fgt.map_injective
            rw [Fgt.map_id, Fgt.map_preimage, ℱ.obj.map_id,
              CategoryTheory.Category.id_comp, (e_W W).hom_inv_id]
          map_comp := fun {W₁ W₂ W₃} g₁ g₂ => by
            apply Fgt.map_injective
            rw [Fgt.map_comp, Fgt.map_preimage, Fgt.map_preimage, Fgt.map_preimage,
              ℱ.obj.map_comp]
            simp only [CategoryTheory.Category.assoc, (e_W W₂).inv_hom_id_assoc] }
      let e_pre : P_pre.comp Fgt ≅ ℱ.obj :=
        CategoryTheory.NatIso.ofComponents e_W (fun {W₁ W₂} g => by
          change Fgt.map (M_map g) ≫ (e_W W₂).hom = (e_W W₁).hom ≫ ℱ.obj.map g
          rw [Fgt.map_preimage, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            (e_W W₂).inv_hom_id, CategoryTheory.Category.comp_id])
      have hSheaf_comp : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (P_pre.comp Fgt) :=
        fun E => CategoryTheory.Presieve.isSheaf_iso S.smallEtaleTopology
          (CategoryTheory.Functor.isoWhiskerRight e_pre.symm
            (CategoryTheory.coyoneda.obj (Opposite.op E)))
          (ℱ.property E)
      have hSheaf_P : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology P_pre :=
        CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp S.smallEtaleTopology P_pre Fgt hSheaf_comp
      let P_ℱ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) := ⟨P_pre, hSheaf_P⟩
      refine ⟨P_ℱ, ⟨{
        hom := CategoryTheory.InducedCategory.homMk e_pre.hom
        inv := CategoryTheory.InducedCategory.homMk e_pre.inv
        hom_inv_id := by
          apply CategoryTheory.InducedCategory.hom_ext
          exact e_pre.hom_inv_id
        inv_hom_id := by
          apply CategoryTheory.InducedCategory.hom_ext
          exact e_pre.inv_hom_id }⟩⟩
    obtain ⟨P_𝒢, ⟨e_𝒢⟩⟩ := hPromote 𝒢 h𝒢.1
    refine ⟨P_𝒢, ?_, ?_⟩
    · intro hNoethP
      haveI : CategoryTheory.IsNoetherianObject P_𝒢 := hNoethP
      haveI := hU_faith S
      haveI := hU_full S
      rw [CategoryTheory.isNoetherianObject_iff_monotone_chain_condition]
      intro f
      let S_n : ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
        fun n => (f n : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      have hTor_Sn : ∀ n : ℕ, ℓ • CategoryTheory.CategoryStruct.id (S_n n) = 0 := by
        intro n
        apply (CategoryTheory.cancel_mono (f n).arrow).mp
        rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
          CategoryTheory.Limits.zero_comp, ← CategoryTheory.Category.comp_id (f n).arrow,
          ← CategoryTheory.Preadditive.comp_nsmul, h𝒢.1, CategoryTheory.Limits.comp_zero]
      let Q_n : ℕ → CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) :=
        fun n => (hPromote (S_n n) (hTor_Sn n)).choose
      let e_n : ∀ n : ℕ, (U_dir S).obj (Q_n n) ≅ S_n n :=
        fun n => (hPromote (S_n n) (hTor_Sn n)).choose_spec.some
      let j_n : ∀ n : ℕ, Q_n n ⟶ P_𝒢 :=
        fun n => (U_dir S).preimage ((e_n n).hom ≫ (f n).arrow ≫ e_𝒢.inv)
      have hMono_jn : ∀ n : ℕ, CategoryTheory.Mono (j_n n) := by
        intro n
        refine ⟨fun {Z_t} a₁ a₂ ha => ?_⟩
        have hmap := congrArg (U_dir S).map ha
        rw [(U_dir S).map_comp, (U_dir S).map_comp, (U_dir S).map_preimage] at hmap
        have hpost₁ := congrArg (· ≫ e_𝒢.hom) hmap
        simp only [CategoryTheory.Category.assoc, e_𝒢.inv_hom_id,
          CategoryTheory.Category.comp_id] at hpost₁
        have hcan : (U_dir S).map a₁ ≫ (e_n n).hom = (U_dir S).map a₂ ≫ (e_n n).hom := by
          apply (CategoryTheory.cancel_mono (f n).arrow).mp
          simpa only [CategoryTheory.Category.assoc] using hpost₁
        have hpost₂ := congrArg (· ≫ (e_n n).inv) hcan
        simp only [CategoryTheory.Category.assoc, (e_n n).hom_inv_id,
          CategoryTheory.Category.comp_id] at hpost₂
        exact (U_dir S).map_injective hpost₂
      let P_fn : ℕ → CategoryTheory.Subobject P_𝒢 :=
        fun n => @CategoryTheory.Subobject.mk _ _ _ _ (j_n n) (hMono_jn n)
      have hP_mono : Monotone P_fn := by
        intro a b hab
        haveI := hMono_jn a
        haveI := hMono_jn b
        let u_ab : S_n a ⟶ S_n b := CategoryTheory.Subobject.ofLE (f a) (f b) (f.monotone hab)
        let v_ab : Q_n a ⟶ Q_n b := (U_dir S).preimage ((e_n a).hom ≫ u_ab ≫ (e_n b).inv)
        refine CategoryTheory.Subobject.mk_le_mk_of_comm v_ab ?_
        apply (U_dir S).map_injective
        rw [(U_dir S).map_comp, (U_dir S).map_preimage, (U_dir S).map_preimage,
          (U_dir S).map_preimage]
        simp only [CategoryTheory.Category.assoc]
        rw [(e_n b).inv_hom_id_assoc]
        have hu_arr : u_ab ≫ (f b).arrow = (f a).arrow :=
          CategoryTheory.Subobject.ofLE_arrow (f.monotone hab)
        rw [← CategoryTheory.Category.assoc u_ab (f b).arrow e_𝒢.inv, hu_arr]
      let P_chain : ℕ →o CategoryTheory.Subobject P_𝒢 := ⟨P_fn, hP_mono⟩
      obtain ⟨N, hN⟩ := CategoryTheory.monotone_chain_condition_of_isNoetherianObject P_chain
      refine ⟨N, fun n hn => ?_⟩
      have hEq_P : P_fn N = P_fn n := hN n hn
      have hle_nN : P_fn n ≤ P_fn N := hEq_P ▸ le_rfl
      haveI := hMono_jn n
      haveI := hMono_jn N
      let iso_n := CategoryTheory.Subobject.underlyingIso (j_n n)
      let iso_N := CategoryTheory.Subobject.underlyingIso (j_n N)
      let w : Q_n n ⟶ Q_n N :=
        iso_n.inv ≫ CategoryTheory.Subobject.ofLE (P_fn n) (P_fn N) hle_nN ≫ iso_N.hom
      have hw_comm : w ≫ j_n N = j_n n := by
        dsimp [w]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk (j_n N)]
        change iso_n.inv ≫
          (CategoryTheory.Subobject.ofLE (P_fn n) (P_fn N) hle_nN ≫ (P_fn N).arrow) = j_n n
        rw [CategoryTheory.Subobject.ofLE_arrow hle_nN]
        change iso_n.inv ≫ (CategoryTheory.Subobject.mk (j_n n)).arrow = j_n n
        rw [← CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk (j_n n), iso_n.inv_hom_id_assoc]
      have hw_map := congrArg (U_dir S).map hw_comm
      rw [(U_dir S).map_comp, (U_dir S).map_preimage, (U_dir S).map_preimage] at hw_map
      have hw_arr : ((e_n n).inv ≫ (U_dir S).map w ≫ (e_n N).hom) ≫ (f N).arrow = (f n).arrow := by
        have h1 := congrArg (fun u => (e_n n).inv ≫ u ≫ e_𝒢.hom) hw_map
        simp only [CategoryTheory.Category.assoc, e_𝒢.inv_hom_id, CategoryTheory.Category.comp_id,
          (e_n n).inv_hom_id_assoc] at h1
        exact h1
      have hfn_le_fN : f n ≤ f N :=
        CategoryTheory.Subobject.le_of_comm ((e_n n).inv ≫ (U_dir S).map w ≫ (e_n N).hom) hw_arr
      exact le_antisymm (f.monotone hn) hfn_le_fN
    · intro V h A hFinA hTorA hPb
      have hA_tor : ∀ x : ↑A, ℓ • x = 0 := by
        intro x
        have h_nsmul_A : ∀ t : ℕ, (t • CategoryTheory.CategoryStruct.id A).hom x = t • x := by
          intro t
          induction t with
          | zero =>
            rw [zero_smul, zero_smul]
            rfl
          | succ t ih =>
            rw [succ_nsmul, succ_nsmul]
            change (t • CategoryTheory.CategoryStruct.id A).hom x +
              (CategoryTheory.CategoryStruct.id A).hom x = t • x + x
            rw [ih]
            rfl
        rw [← h_nsmul_A ℓ, hTorA]
        rfl
      let M_A : ModuleCat.{u, u} R := @ModuleCat.of R _ ↑A _ (uliftZModMod hA_tor)
      have hFin_MA : Finite M_A := hFinA
      let e_A : Fgt.obj M_A ≅ A := e_of A
      refine ⟨M_A, hFin_MA, ?_⟩
      intro B_h _hc _hr
      obtain ⟨hc_ab, hr_ab, ⟨e_pb_G⟩⟩ := hPb
      have hSub_c : hc_ab = _hc := Subsingleton.elim _ _
      subst hSub_c
      letI := hc_ab
      letI := hr_ab
      let pf_ab := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology V.smallEtaleTopology
      let pb_ab := B_h.sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology V.smallEtaleTopology
      let adj_ab := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology V.smallEtaleTopology
      let pf_mod := B_h.sheafPushforwardContinuous (ModuleCat.{u, u} R)
        S.smallEtaleTopology V.smallEtaleTopology
      let pb_mod := B_h.sheafPullback (ModuleCat.{u, u} R)
        S.smallEtaleTopology V.smallEtaleTopology
      let adj_mod := B_h.sheafAdjunctionContinuous (ModuleCat.{u, u} R)
        S.smallEtaleTopology V.smallEtaleTopology
      let e_pf_C : (C_dir V).comp pf_mod ≅ pf_ab.comp (C_dir S) :=
        CategoryTheory.NatIso.ofComponents
          (fun _ =>
            { hom := CategoryTheory.InducedCategory.homMk (𝟙 _)
              inv := CategoryTheory.InducedCategory.homMk (𝟙 _)
              hom_inv_id := by
                apply CategoryTheory.InducedCategory.hom_ext
                apply CategoryTheory.NatTrans.ext
                funext W
                exact CategoryTheory.Category.comp_id _
              inv_hom_id := by
                apply CategoryTheory.InducedCategory.hom_ext
                apply CategoryTheory.NatTrans.ext
                funext W
                exact CategoryTheory.Category.comp_id _ })
          (fun {_ _} _ => by
            apply CategoryTheory.InducedCategory.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext W
            exact (CategoryTheory.Category.comp_id _).trans
              (CategoryTheory.Category.id_comp _).symm)
      let e_pb : pb_mod.comp (U_dir V) ≅ (U_dir S).comp pb_ab :=
        ((adj_mod.comp (adj_UC V)).ofNatIsoRight e_pf_C).leftAdjointUniq ((adj_UC S).comp adj_ab)
      let termV : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 V)
        (CategoryTheory.MorphismProperty.id_mem P_et V)
      have hTermV : CategoryTheory.Limits.IsTerminal termV :=
        CategoryTheory.Limits.IsTerminal.ofUniqueHom
          (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
            (CategoryTheory.Category.comp_id U.hom))
          (fun U g => by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact (CategoryTheory.Category.comp_id g.left).symm.trans g.w)
      let adj_cV_mod := CategoryTheory.constantSheafAdj V.smallEtaleTopology (ModuleCat.{u, u} R) hTermV
      let adj_cV_ab := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hTermV
      let secV_mod := (CategoryTheory.sheafSections V.smallEtaleTopology (ModuleCat.{u, u} R)).obj
        (Opposite.op termV)
      let secV_ab := (CategoryTheory.sheafSections V.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op termV)
      let e_sec_C : (C_dir V).comp secV_mod ≅ secV_ab.comp C_0 :=
        CategoryTheory.NatIso.ofComponents
          (fun _ => CategoryTheory.Iso.refl _)
          (fun {_ _} _ => (CategoryTheory.Category.comp_id _).trans
            (CategoryTheory.Category.id_comp _).symm)
      let e_const_V : (CategoryTheory.constantSheaf V.smallEtaleTopology (ModuleCat.{u, u} R)).comp
          (U_dir V) ≅
          Fgt.comp (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}) :=
        ((adj_cV_mod.comp (adj_UC V)).ofNatIsoRight e_sec_C).leftAdjointUniq
          (adj_R.comp adj_cV_ab)
      let e_ab : (U_dir V).obj (pb_mod.obj P_𝒢) ≅
          (U_dir V).obj ((CategoryTheory.constantSheaf V.smallEtaleTopology (ModuleCat.{u, u} R)).obj M_A) :=
        e_pb.app P_𝒢 ≪≫ pb_ab.mapIso e_𝒢 ≪≫ e_pb_G ≪≫
          (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_A.symm ≪≫
          (e_const_V.app M_A).symm
      haveI := hU_faith V
      haveI := hU_full V
      exact ⟨(U_dir V).preimageIso e_ab⟩

  
  have weil_sing_dev_ar_integral_etale_cover_and_open_descent :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
        (U : Z.Opens) (_hU_ne : Nonempty U)
        (V : AlgebraicGeometry.Scheme.{u}) (p_V : Quiver.Hom V (U : AlgebraicGeometry.Scheme.{u}))
        [AlgebraicGeometry.Etale p_V] [AlgebraicGeometry.Surjective p_V],
        ∃ (U₁ : Z.Opens) (_ : Nonempty U₁)
          (V' : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral V')
          (q_V : Quiver.Hom V' V) (p' : Quiver.Hom V' (U₁ : AlgebraicGeometry.Scheme.{u})),
          AlgebraicGeometry.IsFinite p' ∧
          AlgebraicGeometry.Etale p' ∧
          AlgebraicGeometry.Surjective p' ∧
          CategoryTheory.CategoryStruct.comp p' U₁.ι =
            CategoryTheory.CategoryStruct.comp q_V (CategoryTheory.CategoryStruct.comp p_V U.ι) ∧
          (∀ (O : V'.Opens), Nonempty O →
            ∃ (W_open : Z.Opens) (_ : Nonempty W_open)
              (V'' : AlgebraicGeometry.Scheme.{u})
              (j_O : Quiver.Hom V'' (O : AlgebraicGeometry.Scheme.{u}))
              (p'' : Quiver.Hom V'' (W_open : AlgebraicGeometry.Scheme.{u})),
              AlgebraicGeometry.IsFinite p'' ∧
              AlgebraicGeometry.Etale p'' ∧
              AlgebraicGeometry.Surjective p'' ∧
              CategoryTheory.CategoryStruct.comp p'' W_open.ι =
                CategoryTheory.CategoryStruct.comp j_O
                  (CategoryTheory.CategoryStruct.comp O.ι
                    (CategoryTheory.CategoryStruct.comp p' U₁.ι))) := by
    intro Z _ U hU_ne V p_V _ _
    obtain ⟨z₀, hz₀⟩ := hU_ne
    obtain ⟨U₀, hAff_U₀, hz₀_U₀, hU₀_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hz₀
    have hU₀_le : U₀ ≤ U := hU₀_sub
    let u₀_pt : ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := ⟨z₀, hz₀_U₀⟩
    have : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := ⟨u₀_pt⟩
    have : AlgebraicGeometry.IsAffine (U₀ : AlgebraicGeometry.Scheme.{u}) := hAff_U₀
    have : AlgebraicGeometry.IsIntegral (U₀ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion U₀.ι
    let ι₀ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ (U : AlgebraicGeometry.Scheme.{u}) :=
      Z.homOfLE hU₀_le
    let W := CategoryTheory.Limits.pullback p_V ι₀
    let fst_W := CategoryTheory.Limits.pullback.fst p_V ι₀
    let w := CategoryTheory.Limits.pullback.snd p_V ι₀
    have : AlgebraicGeometry.Etale w := inferInstance
    obtain ⟨v₀, hv₀⟩ := (AlgebraicGeometry.surjective_iff p_V).mp inferInstance (ι₀.base u₀_pt)
    obtain ⟨w₀, _, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v₀ u₀_pt hv₀
    obtain ⟨U'_sp, hU'_ne, V', j, p₀', hAff_U', hInt_V', _, hFin_p₀', hEt_p₀', hSurj_p₀', h_comm₁⟩ :=
      weil_etale_integral_affine_shrinking_to_finite_etale
        (U₀ : AlgebraicGeometry.Scheme.{u}) W w ⟨w₀⟩
    let u₁ : (U'_sp : AlgebraicGeometry.Scheme.{u}) ⟶ Z := U'_sp.ι ≫ U₀.ι
    haveI : AlgebraicGeometry.IsOpenImmersion u₁ := inferInstance
    let U₁ : Z.Opens := u₁.opensRange
    obtain ⟨x'⟩ := hU'_ne
    have hU₁_ne : Nonempty U₁ := ⟨⟨u₁.base x', ⟨x', rfl⟩⟩⟩
    let e₁ : (U'_sp : AlgebraicGeometry.Scheme.{u}) ≅ (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      u₁.isoOpensRange
    haveI : AlgebraicGeometry.IsAffine (U'_sp : AlgebraicGeometry.Scheme.{u}) := hAff_U'
    haveI : AlgebraicGeometry.IsAffine (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsAffine.of_isIso e₁.inv
    haveI : AlgebraicGeometry.IsIntegral (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion U₁.ι
    let q_V : V' ⟶ V := j ≫ fst_W
    let p' : V' ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}) := p₀' ≫ e₁.hom
    haveI : AlgebraicGeometry.IsFinite p₀' := hFin_p₀'
    haveI : AlgebraicGeometry.Etale p₀' := hEt_p₀'
    haveI : AlgebraicGeometry.Surjective p₀' := hSurj_p₀'
    have hFin_p' : AlgebraicGeometry.IsFinite p' := by dsimp [p']; infer_instance
    have hEt_p' : AlgebraicGeometry.Etale p' := by dsimp [p']; infer_instance
    have hSurj_p' : AlgebraicGeometry.Surjective p' := by dsimp [p']; infer_instance
    have h_p'_eq : p' ≫ U₁.ι = q_V ≫ (p_V ≫ U.ι) := by
      calc
        p' ≫ U₁.ι = p₀' ≫ (e₁.hom ≫ U₁.ι) := by simp only [p', CategoryTheory.Category.assoc]
        _ = (p₀' ≫ U'_sp.ι) ≫ U₀.ι := by
            rw [AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι u₁]
            simp only [u₁, CategoryTheory.Category.assoc]
        _ = (j ≫ w) ≫ (ι₀ ≫ U.ι) := by
            dsimp [ι₀]
            rw [h_comm₁, AlgebraicGeometry.Scheme.homOfLE_ι]
        _ = j ≫ (w ≫ ι₀) ≫ U.ι := by simp only [CategoryTheory.Category.assoc]
        _ = j ≫ (fst_W ≫ p_V) ≫ U.ι := by
            rw [← CategoryTheory.Limits.pullback.condition]
        _ = q_V ≫ (p_V ≫ U.ι) := by simp only [q_V, CategoryTheory.Category.assoc]
    refine ⟨U₁, hU₁_ne, V', hInt_V', q_V, p', hFin_p', hEt_p', hSurj_p', h_p'_eq, ?_⟩
    intro O hO_ne
    haveI := hEt_p'
    haveI : AlgebraicGeometry.Etale (O.ι ≫ p') := inferInstance
    obtain ⟨U''_sp, hU''_ne, V'', j_O, p₀'', _, _, _, hFin_p₀'', hEt_p₀'', hSurj_p₀'', h_comm₂⟩ :=
      weil_etale_integral_affine_shrinking_to_finite_etale
        (U₁ : AlgebraicGeometry.Scheme.{u}) (O : AlgebraicGeometry.Scheme.{u}) (O.ι ≫ p') hO_ne
    let u₂ : (U''_sp : AlgebraicGeometry.Scheme.{u}) ⟶ Z := U''_sp.ι ≫ U₁.ι
    haveI : AlgebraicGeometry.IsOpenImmersion u₂ := inferInstance
    let W_open : Z.Opens := u₂.opensRange
    obtain ⟨x''⟩ := hU''_ne
    have hW_ne : Nonempty W_open := ⟨⟨u₂.base x'', ⟨x'', rfl⟩⟩⟩
    let e₂ : (U''_sp : AlgebraicGeometry.Scheme.{u}) ≅ (W_open : AlgebraicGeometry.Scheme.{u}) :=
      u₂.isoOpensRange
    let p'' : V'' ⟶ (W_open : AlgebraicGeometry.Scheme.{u}) := p₀'' ≫ e₂.hom
    haveI : AlgebraicGeometry.IsFinite p₀'' := hFin_p₀''
    haveI : AlgebraicGeometry.Etale p₀'' := hEt_p₀''
    haveI : AlgebraicGeometry.Surjective p₀'' := hSurj_p₀''
    have hFin_p'' : AlgebraicGeometry.IsFinite p'' := by dsimp [p'']; infer_instance
    have hEt_p'' : AlgebraicGeometry.Etale p'' := by dsimp [p'']; infer_instance
    have hSurj_p'' : AlgebraicGeometry.Surjective p'' := by dsimp [p'']; infer_instance
    have h_p''_eq : p'' ≫ W_open.ι = j_O ≫ (O.ι ≫ (p' ≫ U₁.ι)) := by
      calc
        p'' ≫ W_open.ι = p₀'' ≫ (e₂.hom ≫ W_open.ι) := by
            simp only [p'', CategoryTheory.Category.assoc]
        _ = (p₀'' ≫ U''_sp.ι) ≫ U₁.ι := by
            rw [AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι u₂]
            simp only [u₂, CategoryTheory.Category.assoc]
        _ = (j_O ≫ (O.ι ≫ p')) ≫ U₁.ι := by rw [h_comm₂]
        _ = j_O ≫ (O.ι ≫ (p' ≫ U₁.ι)) := by simp only [CategoryTheory.Category.assoc]
    exact ⟨W_open, hW_ne, V'', j_O, p'', hFin_p'', hEt_p'', hSurj_p'', h_p''_eq⟩

  
  have weil_sing_dev_ar_noetherian_closed_excision_descent :
      TopologicalSpace.NoetherianSpace ↥S ∧
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z S)
        [AlgebraicGeometry.IsClosedImmersion i] (K : TopologicalSpace.Closeds ↥S),
        Set.range i.base ⊆ (K : Set ↥S) →
        ((∀ (W_open : Z.Opens), Nonempty W_open →
          ∃ (Z_compl : AlgebraicGeometry.Scheme.{u}) (i_compl : Quiver.Hom Z_compl Z)
            (K_compl : TopologicalSpace.Closeds ↥S),
            AlgebraicGeometry.IsClosedImmersion i_compl ∧
            Set.range W_open.ι.base ∪ Set.range i_compl.base = Set.univ ∧
            Set.range (CategoryTheory.CategoryStruct.comp i_compl i).base ⊆ (K_compl : Set ↥S) ∧
            K_compl < K) ∧
         (∀ (O₁ : Z.Opens) (W₁ W₂ : AlgebraicGeometry.Scheme.{u})
