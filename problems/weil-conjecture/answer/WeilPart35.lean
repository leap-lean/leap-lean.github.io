        (weilEtaleSitePullback pr_W) AddCommGrpCat.{u} _
        W₀.left.smallEtaleTopology W_bar.smallEtaleTopology hCont_W hAdj_W
      ∀ (E₀ : Type u) [Finite E₀] [Field E₀] [Algebra F E₀] [Algebra E₀ k]
          [IsScalarTower F E₀ k]
          (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₀)))
          [CompactSpace ↥Z₀.left]
          (z_W : Z₀.left ⟶ W₀.left) [AlgebraicGeometry.Etale z_W],
        z_W ≫ W₀.hom =
          Z₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₀)) →
        ∀ (Z_bar : W_bar.Etale)
          (p_Z : (Fgt_W.obj Z_bar).left ⟶ Z₀.left),
          CategoryTheory.IsPullback p_Z ((Fgt_W.obj Z_bar).hom ≫ snd_W) Z₀.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ k))) →
          p_Z ≫ z_W = (Fgt_W.obj Z_bar).hom ≫ pr_W →
          ∀ (𝒜 : CategoryTheory.Sheaf W₀.left.smallEtaleTopology AddCommGrpCat.{u})
            (t_bar : ↑((L_prW.obj 𝒜).obj.obj (Opposite.op Z_bar))),
            ∃ (E₁ : Type u) (_ : Finite E₁) (_ : Field E₁)
              (_ : Algebra F E₁) (_ : Algebra E₀ E₁) (_ : Algebra E₁ k)
              (_ : IsScalarTower F E₀ E₁) (_ : IsScalarTower E₀ E₁ k)
              (_ : IsScalarTower F E₁ k),
              let g_01 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))
              let Z₁_left := CategoryTheory.Limits.pullback Z₀.hom g_01
              let z₁_W : Z₁_left ⟶ W₀.left :=
                CategoryTheory.Limits.pullback.fst Z₀.hom g_01 ≫ z_W
              ∃ (hz₁_et : AlgebraicGeometry.Etale z₁_W)
                (p_Z₁ : (Fgt_W.obj Z_bar).left ⟶ Z₁_left)
                (hp_Z₁_W : p_Z₁ ≫ z₁_W = (Fgt_W.obj Z_bar).hom ≫ pr_W),
                let Z₁_et : W₀.left.Etale :=
                  @AlgebraicGeometry.Scheme.Etale.mk W₀.left Z₁_left z₁_W hz₁_et
                let σ₁ : Quiver.Hom Z_bar ((weilEtaleSitePullback pr_W).obj Z₁_et) :=
                  CategoryTheory.MorphismProperty.Over.homMk
                    (CategoryTheory.Limits.pullback.lift p_Z₁ (Fgt_W.obj Z_bar).hom hp_Z₁_W)
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _)
                p_Z₁ ≫ CategoryTheory.Limits.pullback.fst Z₀.hom g_01 = p_Z ∧
                p_Z₁ ≫ CategoryTheory.Limits.pullback.snd Z₀.hom g_01 =
                  ((Fgt_W.obj Z_bar).hom ≫ snd_W) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k)) ∧
                ∃ (s₁ : ↑(𝒜.obj.obj (Opposite.op Z₁_et))),
                  ((L_prW.obj 𝒜).obj.map (Opposite.op σ₁)).hom
                    (((adj_prW.unit.app 𝒜).hom.app (Opposite.op Z₁_et)).hom s₁) = t_bar)
    (𝒥 : CategoryTheory.Sheaf W₀.left.smallEtaleTopology AddCommGrpCat.{u})
    (hAcyc₀ : ∀ (U : W₀.left.Etale) (d : ℕ), 1 ≤ d →
      Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf 𝒥 d).obj (Opposite.op U))) :
    let k := AlgebraicClosure F
    let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let W_bar := weilGeomScheme F W₀
    let pr_W : Quiver.Hom W_bar W₀.left := CategoryTheory.Limits.pullback.fst W₀.hom f_ext
    let snd_W : Quiver.Hom W_bar (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Limits.pullback.snd W₀.hom f_ext
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar
    let L_prW := @CategoryTheory.Functor.sheafPullback
      W₀.left.Etale _ W_bar.Etale _
      (weilEtaleSitePullback pr_W) AddCommGrpCat.{u} _
      W₀.left.smallEtaleTopology W_bar.smallEtaleTopology hCont_W hAdj_W
    (∀ (E₀ : Type u) [Finite E₀] [Field E₀] [Algebra F E₀] [Algebra E₀ k]
        [IsScalarTower F E₀ k]
        (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₀)))
        [CompactSpace ↥Z₀.left] [AlgebraicGeometry.IsSeparated Z₀.hom]
        (z_W : Z₀.left ⟶ W₀.left) [AlgebraicGeometry.Etale z_W],
      z_W ≫ W₀.hom =
        Z₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₀)) →
      ∀ (Z_bar : W_bar.Etale)
        (p_Z : (Fgt_W.obj Z_bar).left ⟶ Z₀.left),
        CategoryTheory.IsPullback p_Z ((Fgt_W.obj Z_bar).hom ≫ snd_W) Z₀.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ k))) →
        p_Z ≫ z_W = (Fgt_W.obj Z_bar).hom ≫ pr_W →
        ∀ (d : ℕ), 1 ≤ d →
          Subsingleton ↑(((L_prW.obj 𝒥).cohomologyPresheaf d).obj (Opposite.op Z_bar))) ∧
    (CompactSpace ↥W₀.left →
      AlgebraicGeometry.IsSeparated W₀.hom →
      ∀ (d : ℕ), 1 ≤ d → Subsingleton ((L_prW.obj 𝒥).H d)) :=
by
  classical
  intro k f_ext W_bar pr_W snd_W Fgt_W L_prW

  
  
  
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let fyEquiv : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (X : Z.Etale)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      (weilFreeYonedaZ.{u} Z X ⟶ G) ≃ (Aℤ ⟶ G.obj.obj (Opposite.op X)) :=
    fun _ _ _ => CategoryTheory.Sheaf.freeYonedaHomEquiv
  have hFY_comp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {X : Z.Etale}
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (α : weilFreeYonedaZ.{u} Z X ⟶ G₁) (ψ : G₁ ⟶ G₂),
      fyEquiv Z X G₂ (α ≫ ψ) = fyEquiv Z X G₁ α ≫ ψ.hom.app (Opposite.op X) := by
    intro Z X G₁ G₂ α ψ
    let adj := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    change CategoryTheory.Presheaf.freeYonedaHomEquiv
        ((adj.homEquiv (CategoryTheory.Presheaf.freeYoneda X Aℤ) G₂) (α ≫ ψ)) =
      CategoryTheory.Presheaf.freeYonedaHomEquiv
        ((adj.homEquiv (CategoryTheory.Presheaf.freeYoneda X Aℤ) G₁) α) ≫
        ψ.hom.app (Opposite.op X)
    rw [adj.homEquiv_naturality_right α ψ]
    exact CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ ψ.hom
  have hFY_id_comp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {X : Z.Etale}
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ : weilFreeYonedaZ.{u} Z X ⟶ G),
      fyEquiv Z X (weilFreeYonedaZ.{u} Z X) (𝟙 (weilFreeYonedaZ.{u} Z X)) ≫
        ψ.hom.app (Opposite.op X) = fyEquiv Z X G ψ := by
    intro Z X G ψ
    have h := hFY_comp (𝟙 (weilFreeYonedaZ.{u} Z X)) ψ
    rw [CategoryTheory.Category.id_comp] at h
    exact h.symm
  have hFY_map_eq : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W V : Z.Etale} (u : W ⟶ V),
      fyEquiv Z W (weilFreeYonedaZ.{u} Z V) (weilFreeYonedaMap.{u} u) =
        fyEquiv Z V (weilFreeYonedaZ.{u} Z V) (𝟙 (weilFreeYonedaZ.{u} Z V)) ≫
          (weilFreeYonedaZ.{u} Z V).obj.map (Opposite.op u) := by
    intro Z W V u
    dsimp [fyEquiv, weilFreeYonedaMap]
    exact Equiv.apply_symm_apply _ _
  have hFY_map_comp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W V : Z.Etale} (u : W ⟶ V)
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : weilFreeYonedaZ.{u} Z V ⟶ G),
      fyEquiv Z W G (weilFreeYonedaMap.{u} u ≫ φ) =
        fyEquiv Z V G φ ≫ G.obj.map (Opposite.op u) := by
    intro Z W V u G φ
    rw [hFY_comp, hFY_map_eq, CategoryTheory.Category.assoc, φ.hom.naturality (Opposite.op u),
      ← CategoryTheory.Category.assoc, hFY_id_comp]
  have hFY_map_comp_map : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ V₃ : Z.Etale}
      (u : V₁ ⟶ V₂) (v : V₂ ⟶ V₃),
      weilFreeYonedaMap.{u} u ≫ weilFreeYonedaMap.{u} v = weilFreeYonedaMap.{u} (u ≫ v) := by
    intro Z V₁ V₂ V₃ u v
    apply (fyEquiv Z V₁ (weilFreeYonedaZ.{u} Z V₃)).injective
    rw [hFY_map_comp, hFY_map_eq, hFY_map_eq, CategoryTheory.Category.assoc,
      ← (weilFreeYonedaZ.{u} Z V₃).obj.map_comp]
    rfl

  let evHom : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      (weilFreeYonedaZ.{u} Z V ⟶ G) →+ ↥(G.obj.obj (Opposite.op V)) :=
    fun Z V G =>
      { toFun := fun φ => (fyEquiv Z V G φ).hom (ULift.up (1 : ℤ))
        map_zero' := by
          have h0 : fyEquiv Z V G 0 = 0 := by
            rw [← hFY_id_comp]
            change _ ≫ (0 : weilFreeYonedaZ.{u} Z V ⟶ G).hom.app (Opposite.op V) = 0
            have happ : (0 : weilFreeYonedaZ.{u} Z V ⟶ G).hom.app (Opposite.op V) = 0 := rfl
            rw [happ, CategoryTheory.Limits.comp_zero]
          rw [h0]
          rfl
        map_add' := fun φ₁ φ₂ => by
          have hadd : fyEquiv Z V G (φ₁ + φ₂) = fyEquiv Z V G φ₁ + fyEquiv Z V G φ₂ := by
            rw [← hFY_id_comp (φ₁ + φ₂), ← hFY_id_comp φ₁, ← hFY_id_comp φ₂]
            have happ : (φ₁ + φ₂).hom.app (Opposite.op V) =
                φ₁.hom.app (Opposite.op V) + φ₂.hom.app (Opposite.op V) := by
              let F_fgt := CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}
              let ev_V := (CategoryTheory.evaluation (Z.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op V)
              change ev_V.map (F_fgt.map (φ₁ + φ₂)) =
                ev_V.map (F_fgt.map φ₁) + ev_V.map (F_fgt.map φ₂)
              rw [F_fgt.map_add, ev_V.map_add]
            rw [happ, CategoryTheory.Preadditive.comp_add]
          rw [hadd]
          rfl }
  let evInv : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      ↥(G.obj.obj (Opposite.op V)) → (weilFreeYonedaZ.{u} Z V ⟶ G) :=
    fun Z V G s =>
      (fyEquiv Z V G).symm
        (AddCommGrpCat.ofHom
          { toFun := fun z => z.down • s
            map_zero' := zero_zsmul s
            map_add' := fun a b => add_zsmul s a.down b.down })
  have hev_left_inv : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V : Z.Etale}
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : weilFreeYonedaZ.{u} Z V ⟶ G),
      evInv Z V G (evHom Z V G φ) = φ := by
    intro Z V G φ
    apply (fyEquiv Z V G).injective
    dsimp only [evInv, evHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [Equiv.apply_symm_apply]
    ext ⟨m⟩
    have hm : (⟨m⟩ : ULift.{u} ℤ) = m • ULift.up (1 : ℤ) := by
      ext; change m = m • (1 : ℤ); simp
    change m • ((fyEquiv Z V G φ).hom (ULift.up 1)) = (fyEquiv Z V G φ).hom ⟨m⟩
    rw [hm, map_zsmul]
  have hev_right_inv : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V : Z.Etale}
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (s : ↥(G.obj.obj (Opposite.op V))),
      evHom Z V G (evInv Z V G s) = s := by
    intro Z V G s
    dsimp only [evInv, evHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [Equiv.apply_symm_apply]
    exact one_zsmul s
  have hev_comp : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V : Z.Etale}
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : weilFreeYonedaZ.{u} Z V ⟶ G₁) (η : G₁ ⟶ G₂),
      evHom Z V G₂ (φ ≫ η) = (η.hom.app (Opposite.op V)).hom (evHom Z V G₁ φ) := by
    intro Z V G₁ G₂ φ η
    dsimp only [evHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [hFY_comp]
    rfl
  have hev_map : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W V : Z.Etale} (u : W ⟶ V)
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : weilFreeYonedaZ.{u} Z V ⟶ G),
      evHom Z W G (weilFreeYonedaMap.{u} u ≫ φ) =
        (G.obj.map (Opposite.op u)).hom (evHom Z V G φ) := by
    intro Z W V u G φ
    dsimp only [evHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [hFY_map_comp]
    rfl

  have hRepEquiv_nat : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V : Z.Etale}
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : weilPolyP1CohomologyRepSheaf Z V ⟶ G₁) (η : G₁ ⟶ G₂),
      weilPolyP1CohomologyRepHomEquiv Z V G₂ (φ ≫ η) =
        (η.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V G₁ φ) := by
    intro Z V G₁ G₂ φ η
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
    rw [adj_sh.homEquiv_naturality_right φ η]
    have hfr := adj_fr.homEquiv_naturality_right
      ((adj_sh.homEquiv (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) G₁) φ)
      η.hom
    erw [hfr]
    rfl
  have hCohomSubIff : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (V : Z.Etale) (d : ℕ),
      Subsingleton ↑((𝒢.cohomologyPresheaf d).obj (Opposite.op V)) ↔
        Subsingleton (CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} Z V) 𝒢 d) := by
    intro Z 𝒢 V d
    let F_yon := weilPolyP1CohomologyRepSheaf Z V
    let F_fy := weilFreeYonedaZ.{u} Z V
    let α_V : F_fy ⟶ F_yon := evInv Z V F_yon (weilPolyP1CohomologyRepHomEquiv Z V F_yon (𝟙 F_yon))
    let β_V : F_yon ⟶ F_fy := (weilPolyP1CohomologyRepHomEquiv Z V F_fy).symm (evHom Z V F_fy (𝟙 F_fy))
    have hαβ : α_V ≫ β_V = 𝟙 F_fy := by
      apply (Function.LeftInverse.injective (g := evInv Z V F_fy) hev_left_inv)
      rw [hev_comp]
      dsimp only [α_V, β_V]
      rw [hev_right_inv, ← hRepEquiv_nat, CategoryTheory.Category.id_comp, Equiv.apply_symm_apply]
    have hβα : β_V ≫ α_V = 𝟙 F_yon := by
      apply (weilPolyP1CohomologyRepHomEquiv Z V F_yon).injective
      rw [hRepEquiv_nat]
      dsimp only [α_V, β_V]
      rw [Equiv.apply_symm_apply, ← hev_comp, CategoryTheory.Category.id_comp, hev_right_inv]
    constructor
    · intro hSub
      refine ⟨fun x y => ?_⟩
      have hxy : (CategoryTheory.Abelian.Ext.mk₀ β_V).comp x (Nat.zero_add d) =
          (CategoryTheory.Abelian.Ext.mk₀ β_V).comp y (Nat.zero_add d) :=
        @Subsingleton.elim ↑((𝒢.cohomologyPresheaf d).obj (Opposite.op V)) hSub _ _
      have h1 := congrArg
        (fun z => (CategoryTheory.Abelian.Ext.mk₀ α_V).comp z (Nat.zero_add d)) hxy
      rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add 0) (Nat.zero_add d) (Nat.zero_add d),
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add 0) (Nat.zero_add d) (Nat.zero_add d),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαβ,
        CategoryTheory.Abelian.Ext.mk₀_id_comp,
        CategoryTheory.Abelian.Ext.mk₀_id_comp] at h1
      exact h1
    · intro hSub
      refine ⟨fun x y => ?_⟩
      let x' : CategoryTheory.Abelian.Ext F_yon 𝒢 d := x
      let y' : CategoryTheory.Abelian.Ext F_yon 𝒢 d := y
      change x' = y'
      have hxy : (CategoryTheory.Abelian.Ext.mk₀ α_V).comp x' (Nat.zero_add d) =
          (CategoryTheory.Abelian.Ext.mk₀ α_V).comp y' (Nat.zero_add d) :=
        Subsingleton.elim _ _
      have h1 := congrArg
        (fun z => (CategoryTheory.Abelian.Ext.mk₀ β_V).comp z (Nat.zero_add d)) hxy
      rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add 0) (Nat.zero_add d) (Nat.zero_add d),
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add 0) (Nat.zero_add d) (Nat.zero_add d),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hβα,
        CategoryTheory.Abelian.Ext.mk₀_id_comp,
        CategoryTheory.Abelian.Ext.mk₀_id_comp] at h1
      exact h1

  let idEtaleObj : ∀ (Z : AlgebraicGeometry.Scheme.{u}), Z.Etale :=
    fun Z => CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id Z)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id Z))
  have hIdIsTerminal : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (idEtaleObj Z) := by
    intro Z
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun V => CategoryTheory.MorphismProperty.Over.homMk V.hom (CategoryTheory.Category.comp_id V.hom))
      (fun V g => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).symm.trans (CategoryTheory.MorphismProperty.Over.w g)))
  have hGlobalHSub : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (d : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} Z (idEtaleObj Z)) 𝒢 d) →
      Subsingleton (𝒢.H d) := by
    intro Z 𝒢 d hSub
    let T := idEtaleObj Z
    let adj_c := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} (hIdIsTerminal Z)
    let Fℤ := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let F_fy := weilFreeYonedaZ.{u} Z T
    let α_T : Fℤ ⟶ F_fy := (adj_c.homEquiv Aℤ F_fy).symm (fyEquiv Z T F_fy (𝟙 F_fy))
    let β_T : F_fy ⟶ Fℤ := (fyEquiv Z T Fℤ).symm (adj_c.homEquiv Aℤ Fℤ (𝟙 Fℤ))
    have hαβ : α_T ≫ β_T = 𝟙 Fℤ := by
      apply (adj_c.homEquiv Aℤ Fℤ).injective
      rw [adj_c.homEquiv_naturality_right α_T β_T]
      exact ((congrArg (· ≫ β_T.hom.app (Opposite.op T))
        ((adj_c.homEquiv Aℤ F_fy).apply_symm_apply _)).trans
        (hFY_id_comp β_T)).trans ((fyEquiv Z T Fℤ).apply_symm_apply _)
    refine ⟨fun x y => ?_⟩
    let x' : CategoryTheory.Abelian.Ext Fℤ 𝒢 d := x
    let y' : CategoryTheory.Abelian.Ext Fℤ 𝒢 d := y
    have hxy : (CategoryTheory.Abelian.Ext.mk₀ β_T).comp x' (Nat.zero_add d) =
        (CategoryTheory.Abelian.Ext.mk₀ β_T).comp y' (Nat.zero_add d) :=
      Subsingleton.elim _ _
    have h1 := congrArg
      (fun z => (CategoryTheory.Abelian.Ext.mk₀ α_T).comp z (Nat.zero_add d)) hxy
    simpa only [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.zero_add 0) (Nat.zero_add d) (Nat.zero_add d),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαβ,
      CategoryTheory.Abelian.Ext.mk₀_id_comp] using h1

  have hEfface : ∀ (Z_sch : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u})
      (Z : Z_sch.Etale) (d : ℕ), 1 ≤ d →
      ∀ (ξ : CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} Z_sch Z) 𝒢 d),
      ∃ (R : CategoryTheory.Sieve Z),
        R ∈ Z_sch.smallEtaleTopology Z ∧
        ∀ {V : Z_sch.Etale} (v : Quiver.Hom V Z),
          R.arrows v →
          (CategoryTheory.Abelian.Ext.mk₀ (weilFreeYonedaMap.{u} v)).comp ξ (Nat.zero_add d) = 0 := by
    intro Z_sch 𝒢₀ Z d hd ξ₀
    have hSucc : ∀ (n : ℕ) (F_sh : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u})
        (ζ : CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} Z_sch Z) F_sh (n + 1)),
        ∃ (R : CategoryTheory.Sieve Z),
          R ∈ Z_sch.smallEtaleTopology Z ∧
          ∀ {V : Z_sch.Etale} (u : Quiver.Hom V Z),
            R.arrows u →
            (CategoryTheory.Abelian.Ext.mk₀ (weilFreeYonedaMap.{u} u)).comp ζ
              (Nat.zero_add (n + 1)) = 0 := by
      intro n
      induction n with
      | zero =>
        intro F_sh ζ
        let J_sh := CategoryTheory.Injective.under F_sh
        let α : F_sh ⟶ J_sh := CategoryTheory.Injective.ι F_sh
        let Q_sh := CategoryTheory.Limits.cokernel α
        let β : J_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π α
        let SC := CategoryTheory.ShortComplex.mk α β (CategoryTheory.Limits.cokernel.condition α)
        have hSE : SC.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel α }
        have hζα : ζ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 1) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨ξ, hξ⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            (weilFreeYonedaZ.{u} Z_sch Z) hSE ζ hζα (rfl : 0 + 1 = 1)
        let φ : weilFreeYonedaZ.{u} Z_sch Z ⟶ Q_sh := CategoryTheory.Abelian.Ext.addEquiv₀ ξ
        have hφ : CategoryTheory.Abelian.Ext.mk₀ φ = ξ :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply ξ
        have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective Z_sch.smallEtaleTopology β.hom :=
          (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} β).mpr inferInstance
        let s₀ : ↑(Q_sh.obj.obj (Opposite.op Z)) := evHom Z_sch Z Q_sh φ
        let R : CategoryTheory.Sieve Z := CategoryTheory.Presheaf.imageSieve β.hom s₀
        have hR_mem : R ∈ Z_sch.smallEtaleTopology Z :=
          @CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem _ _
            Z_sch.smallEtaleTopology AddCommGrpCat.{u} _ _ _ _ _ _ _ β.hom hLocSurj Z s₀
        refine ⟨R, hR_mem, ?_⟩
        intro V u hu
        have hu' : (CategoryTheory.Presheaf.imageSieve β.hom s₀).arrows u := hu
        rw [CategoryTheory.Presheaf.imageSieve_apply] at hu'
        obtain ⟨t, ht⟩ := hu'
        let φ_tilde : weilFreeYonedaZ.{u} Z_sch V ⟶ J_sh := evInv Z_sch V J_sh t
        have h_lift : φ_tilde ≫ β = weilFreeYonedaMap.{u} u ≫ φ := by
          apply (Function.LeftInverse.injective (g := evInv Z_sch V Q_sh) hev_left_inv)
          rw [hev_comp, hev_map]
          dsimp only [φ_tilde]
          rw [hev_right_inv]
          exact ht
        rw [← hξ, ← hφ,
          ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← h_lift,
          ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ φ_tilde β,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
          hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      | succ m ih =>
        intro F_sh ζ
        let J_sh := CategoryTheory.Injective.under F_sh
        let α : F_sh ⟶ J_sh := CategoryTheory.Injective.ι F_sh
        let Q_sh := CategoryTheory.Limits.cokernel α
        let β : J_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π α
        let SC := CategoryTheory.ShortComplex.mk α β (CategoryTheory.Limits.cokernel.condition α)
        have hSE : SC.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel α }
        have hζα : ζ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (m + 1 + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨ξ, hξ⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            (weilFreeYonedaZ.{u} Z_sch Z) hSE ζ hζα (rfl : (m + 1) + 1 = m + 1 + 1)
        obtain ⟨R, hR_mem, hR_kill⟩ := ih Q_sh ξ
        refine ⟨R, hR_mem, ?_⟩
        intro V u hu
        rw [← hξ,
          ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.zero_add (m + 1)) (rfl : (m + 1) + 1 = m + 2) (Nat.zero_add (m + 2)),
          hR_kill u hu, CategoryTheory.Abelian.Ext.zero_comp]
    obtain ⟨n₀, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.one_le_iff_ne_zero.mp hd)
    exact hSucc n₀ 𝒢₀ ξ₀

  have hClopenKill : ∀ (Z_sch : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u})
      {Z U : Z_sch.Etale} (u : Quiver.Hom U Z) (d : ℕ)
      (ξ : CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} Z_sch Z) 𝒢 d)
      (n : ℕ) (V_fam : Fin n → Z_sch.Etale) (v_hom : ∀ i : Fin n, Quiver.Hom (V_fam i) Z)
      (ι_fam : ∀ i : Fin n, Quiver.Hom (V_fam i) U),
      (∀ i : Fin n,
        (CategoryTheory.Abelian.Ext.mk₀ (weilFreeYonedaMap.{u} (v_hom i))).comp ξ (Nat.zero_add d) = 0) →
      (∀ i : Fin n, CategoryTheory.CategoryStruct.comp (ι_fam i) u = v_hom i) →
      CategoryTheory.Sieve.ofArrows V_fam ι_fam ∈ Z_sch.smallEtaleTopology U →
      (∀ i : Fin n, CategoryTheory.Mono (ι_fam i)) →
      (∀ (i j : Fin n), i ≠ j →
        ∀ (W : Z_sch.Etale) (f : Quiver.Hom W (V_fam i)) (g : Quiver.Hom W (V_fam j)),
          CategoryTheory.CategoryStruct.comp f (ι_fam i) =
            CategoryTheory.CategoryStruct.comp g (ι_fam j) →
          IsEmpty ↥((AlgebraicGeometry.Scheme.Etale.forget Z_sch).obj W).left) →
      (CategoryTheory.Abelian.Ext.mk₀ (weilFreeYonedaMap.{u} u)).comp ξ (Nat.zero_add d) = 0 := by
    intro Z_sch 𝒢 Z U u d ξ n V_fam v_hom ι_fam hKill hFac hCov_U hMono hDisj
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hTopEq : Z_sch.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology Z_sch le_rfl
    have hDisjTerm : ∀ {W : Z_sch.Etale} {i j : Fin n} (a : W ⟶ V_fam i) (b : W ⟶ V_fam j),
        i ≠ j → a ≫ ι_fam i = b ≫ ι_fam j →
        ∀ (M : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Limits.IsTerminal (M.obj.obj (Opposite.op W)) := by
      intro W i j a b hij hab M
      have hEmptyW : IsEmpty ↥W.left := hDisj i j hij W a b hab
      have hBot : (⊥ : CategoryTheory.Sieve W) ∈ Z_sch.smallEtaleTopology W := by
        let botW : CategoryTheory.Sieve W := ⊥
        change botW ∈ Z_sch.smallEtaleTopology W
        rw [hTopEq]
        refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) W botW).mpr ?_
        intro w
        exact hEmptyW.elim w
      exact CategoryTheory.Sheaf.isTerminalOfBotCover M W hBot
    let x_fam : ∀ (s t : Fin n),
        Aℤ ⟶ (weilFreeYonedaZ.{u} Z_sch (V_fam s)).obj.obj (Opposite.op (V_fam t)) :=
      fun s t =>
        if h : t = s then
          fyEquiv Z_sch (V_fam s) (weilFreeYonedaZ.{u} Z_sch (V_fam s))
            (𝟙 (weilFreeYonedaZ.{u} Z_sch (V_fam s))) ≫
            (weilFreeYonedaZ.{u} Z_sch (V_fam s)).obj.map (Opposite.op (eqToHom (congrArg V_fam h)))
        else 0
    have hx_compat : ∀ (s : Fin n) ⦃W : Z_sch.Etale⦄ ⦃i j : Fin n⦄
        (a : W ⟶ V_fam i) (b : W ⟶ V_fam j),
        a ≫ ι_fam i = b ≫ ι_fam j →
        x_fam s i ≫ (weilFreeYonedaZ.{u} Z_sch (V_fam s)).obj.map a.op =
          x_fam s j ≫ (weilFreeYonedaZ.{u} Z_sch (V_fam s)).obj.map b.op := by
      intro s W i j a b hab
      by_cases hij : i = j
      · subst hij
        have : CategoryTheory.Mono (ι_fam i) := hMono i
        have hab' : a = b := (cancel_mono (ι_fam i)).mp hab
        subst hab'
        rfl
      · exact (hDisjTerm a b hij hab (weilFreeYonedaZ.{u} Z_sch (V_fam s))).hom_ext _ _
    let σ : ∀ s : Fin n, Aℤ ⟶ (weilFreeYonedaZ.{u} Z_sch (V_fam s)).obj.obj (Opposite.op U) :=
      fun s => ((weilFreeYonedaZ.{u} Z_sch (V_fam s)).property).amalgamateOfArrows
        ι_fam hCov_U (x_fam s) (hx_compat s)
    have hσ_map : ∀ (s t : Fin n),
        σ s ≫ (weilFreeYonedaZ.{u} Z_sch (V_fam s)).obj.map (ι_fam t).op = x_fam s t :=
      fun s t => ((weilFreeYonedaZ.{u} Z_sch (V_fam s)).property).amalgamateOfArrows_map
        ι_fam hCov_U (x_fam s) (hx_compat s) t
    let ψ : ∀ s : Fin n, weilFreeYonedaZ.{u} Z_sch U ⟶ weilFreeYonedaZ.{u} Z_sch (V_fam s) :=
      fun s => (fyEquiv Z_sch U (weilFreeYonedaZ.{u} Z_sch (V_fam s))).symm (σ s)
    have hPartUnity : (∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (ι_fam s))) =
        𝟙 (weilFreeYonedaZ.{u} Z_sch U) := by
      apply (fyEquiv Z_sch U (weilFreeYonedaZ.{u} Z_sch U)).injective
      apply ((weilFreeYonedaZ.{u} Z_sch U).property).hom_ext_ofArrows ι_fam hCov_U
      intro t
      have hsum_equiv :
          fyEquiv Z_sch U (weilFreeYonedaZ.{u} Z_sch U)
            (∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (ι_fam s))) =
          ∑ s : Fin n, (σ s ≫ (weilFreeYonedaMap.{u} (ι_fam s)).hom.app (Opposite.op U)) := by
        rw [← hFY_id_comp]
        have h_app_sum :
            (∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (ι_fam s))).hom.app (Opposite.op U) =
            ∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (ι_fam s)).hom.app (Opposite.op U) := by
          let F_forget := CategoryTheory.sheafToPresheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u}
          let ev_U := (CategoryTheory.evaluation (Z_sch.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op U)
          change ev_U.map (F_forget.map (∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (ι_fam s)))) = _
          rw [CategoryTheory.Functor.map_sum, CategoryTheory.Functor.map_sum]
          rfl
        rw [h_app_sum, CategoryTheory.Preadditive.comp_sum]
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [hFY_id_comp, hFY_comp]
        have hψ_s : fyEquiv Z_sch U (weilFreeYonedaZ.{u} Z_sch (V_fam s)) (ψ s) = σ s :=
          Equiv.apply_symm_apply _ _
        rw [hψ_s]
      rw [hsum_equiv, CategoryTheory.Preadditive.sum_comp]
      have hterm : ∀ s : Fin n,
          (σ s ≫ (weilFreeYonedaMap.{u} (ι_fam s)).hom.app (Opposite.op U)) ≫
            (weilFreeYonedaZ.{u} Z_sch U).obj.map (ι_fam t).op =
          x_fam s t ≫ (weilFreeYonedaMap.{u} (ι_fam s)).hom.app (Opposite.op (V_fam t)) := by
        intro s
        rw [CategoryTheory.Category.assoc,
          ← (weilFreeYonedaMap.{u} (ι_fam s)).hom.naturality (ι_fam t).op,
          ← CategoryTheory.Category.assoc, hσ_map s t]
      simp_rw [hterm]
      rw [Finset.sum_eq_single t]
      · have hx_diag : x_fam t t =
            fyEquiv Z_sch (V_fam t) (weilFreeYonedaZ.{u} Z_sch (V_fam t))
              (𝟙 (weilFreeYonedaZ.{u} Z_sch (V_fam t))) := by
          dsimp only [x_fam]
          split_ifs with htt
          · rw [Subsingleton.elim htt rfl, eqToHom_refl]
            change _ ≫ (weilFreeYonedaZ.{u} Z_sch (V_fam t)).obj.map (𝟙 (Opposite.op (V_fam t))) = _
            rw [CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
          · exact False.elim (htt rfl)
        rw [hx_diag, hFY_id_comp, hFY_map_eq]
        rfl
      · intro s _ hst
        have hts : t ≠ s := Ne.symm hst
        have hx_off : x_fam s t = 0 := by
          dsimp only [x_fam]
          split_ifs with h_eq
          · exact False.elim (hts h_eq)
          · rfl
        rw [hx_off, CategoryTheory.Limits.zero_comp]
      · intro ht_abs
        exact False.elim (ht_abs (Finset.mem_univ t))
    have hMapDecomp : weilFreeYonedaMap.{u} u =
        ∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (v_hom s)) := by
      calc
        weilFreeYonedaMap.{u} u
            = 𝟙 (weilFreeYonedaZ.{u} Z_sch U) ≫ weilFreeYonedaMap.{u} u :=
              (CategoryTheory.Category.id_comp _).symm
        _ = (∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (ι_fam s))) ≫
              weilFreeYonedaMap.{u} u := by rw [hPartUnity]
        _ = ∑ s : Fin n, ((ψ s ≫ weilFreeYonedaMap.{u} (ι_fam s)) ≫
              weilFreeYonedaMap.{u} u) := CategoryTheory.Preadditive.sum_comp _ _ _
        _ = ∑ s : Fin n, (ψ s ≫ weilFreeYonedaMap.{u} (v_hom s)) := by
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [CategoryTheory.Category.assoc, hFY_map_comp_map, hFac s]
    rw [hMapDecomp, CategoryTheory.Abelian.Ext.mk₀_sum, CategoryTheory.Abelian.Ext.sum_comp]
    apply Finset.sum_eq_zero
    intro s _
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.zero_add 0) (Nat.zero_add d) (Nat.zero_add d),
      hKill s, CategoryTheory.Abelian.Ext.comp_zero]

  let cechRepDiff : ∀ {X : AlgebraicGeometry.Scheme.{u}} {W V : X.Etale}
      (w : Quiver.Hom W V) (p : ℕ),
      Quiver.Hom (weilFreeYonedaZ.{u} X (weilEtaleCechObj w (p + 1)))
        (weilFreeYonedaZ.{u} X (weilEtaleCechObj w p)) :=
    fun {_ _ _} w p =>
      Finset.univ.sum fun j : Fin (p + 2) =>
        (-1 : ℤ) ^ (j : ℕ) • weilFreeYonedaMap.{u} (weilEtaleCechFace w p j)
  have hev_cechDiff : ∀ {X : AlgebraicGeometry.Scheme.{u}} {W V : X.Etale}
      (w : Quiver.Hom W V) (p : ℕ)
      (𝒢 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (φ : weilFreeYonedaZ.{u} X (weilEtaleCechObj w p) ⟶ 𝒢),
      evHom X (weilEtaleCechObj w (p + 1)) 𝒢 (cechRepDiff w p ≫ φ) =
        weilEtaleCechDiff 𝒢.obj w p (evHom X (weilEtaleCechObj w p) 𝒢 φ) := by
    intro X W V w p 𝒢 φ
    dsimp only [cechRepDiff, weilEtaleCechDiff]
    rw [CategoryTheory.Preadditive.sum_comp, map_sum, AddMonoidHom.finsetSum_apply]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [CategoryTheory.Preadditive.zsmul_comp, map_zsmul, AddMonoidHom.zsmul_apply, hev_map]
    rfl

  
  
  
  have hSyzTower : ∀ (S : AlgebraicGeometry.Scheme.{u}) {U Z : S.Etale} (w : Quiver.Hom U Z),
      AlgebraicGeometry.Surjective ((AlgebraicGeometry.Scheme.Etale.forget S).map w).left →
      ∃ (K : ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (ι : ∀ p : ℕ, Quiver.Hom (K p) (weilFreeYonedaZ.{u} S (weilEtaleCechObj w p)))
        (π : ∀ p : ℕ, Quiver.Hom (weilFreeYonedaZ.{u} S (weilEtaleCechObj w (p + 1))) (K p))
        (h₀ : CategoryTheory.CategoryStruct.comp (ι 0) (weilFreeYonedaMap.{u} w) = 0)
        (h_step : ∀ p : ℕ, CategoryTheory.CategoryStruct.comp (ι (p + 1)) (π p) = 0),
        (CategoryTheory.ShortComplex.mk (ι 0) (weilFreeYonedaMap.{u} w) h₀).ShortExact ∧
        (∀ p : ℕ, (CategoryTheory.ShortComplex.mk (ι (p + 1)) (π p) (h_step p)).ShortExact) ∧
        (∀ p : ℕ, CategoryTheory.CategoryStruct.comp (π p) (ι p) = cechRepDiff w p) := by
    intro S U Z w hSurj
    have hYonMap_comp : ∀ {V₁ V₂ V₃ : S.Etale} (u : V₁ ⟶ V₂) (v : V₂ ⟶ V₃),
        weilFreeYonedaMap.{u} (u ≫ v) =
          weilFreeYonedaMap.{u} u ≫ weilFreeYonedaMap.{u} v :=
      fun u v => (hFY_map_comp_map u v).symm
    have hPiMap'_π : ∀ {I₁ I₂ : Type u} (g : I₁ → I₂) (M : AddCommGrpCat.{u}) (x : I₁),
        CategoryTheory.Limits.Pi.map' g (fun _ => 𝟙 M) ≫
          CategoryTheory.Limits.Pi.π (fun _ => M) x =
          CategoryTheory.Limits.Pi.π (fun _ => M) (g x) := by
      intro I₁ I₂ g M x
      simp [CategoryTheory.Limits.Pi.map']
    have hEpiOfRetractGrp : ∀ {A B : AddCommGrpCat.{u}}
        (s : B ⟶ A) (r : A ⟶ B), s ≫ r = 𝟙 B → CategoryTheory.Epi r := by
      intro A B s r hsr
      refine ⟨fun {Z₀} u v huv => ?_⟩
      calc
        u = 𝟙 B ≫ u := (CategoryTheory.Category.id_comp u).symm
        _ = (s ≫ r) ≫ u := by rw [hsr]
        _ = s ≫ (r ≫ u) := CategoryTheory.Category.assoc s r u
        _ = s ≫ (r ≫ v) := by rw [huv]
        _ = (s ≫ r) ≫ v := (CategoryTheory.Category.assoc s r v).symm
        _ = 𝟙 B ≫ v := by rw [hsr]
        _ = v := CategoryTheory.Category.id_comp v
    have hEpiOfRetractSh : ∀ {A B : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (s : B ⟶ A) (r : A ⟶ B), s ≫ r = 𝟙 B → CategoryTheory.Epi r := by
      intro A B s r hsr
      refine ⟨fun {Z₀} u v huv => ?_⟩
      calc
        u = 𝟙 B ≫ u := (CategoryTheory.Category.id_comp u).symm
        _ = (s ≫ r) ≫ u := by rw [hsr]
        _ = s ≫ (r ≫ u) := CategoryTheory.Category.assoc s r u
        _ = s ≫ (r ≫ v) := by rw [huv]
        _ = (s ≫ r) ≫ v := (CategoryTheory.Category.assoc s r v).symm
        _ = 𝟙 B ≫ v := by rw [hsr]
        _ = v := CategoryTheory.Category.id_comp v
    have hEpiCompSh : ∀ {A B D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (f : A ⟶ B) (g : B ⟶ D), CategoryTheory.Epi f → CategoryTheory.Epi g →
        CategoryTheory.Epi (f ≫ g) := by
      intro A B D f g hf hg
      refine ⟨fun {Z₀} u v huv => ?_⟩
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc] at huv
      exact hg.left_cancellation u v (hf.left_cancellation (g ≫ u) (g ≫ v) huv)

    
    have hProjLast : ∀ {W V : S.Etale} (f : W ⟶ V) (p : ℕ),
        weilEtaleCechProj f (p + 1) (Fin.last (p + 1)) =
          CategoryTheory.Limits.pullback.snd (weilEtaleCechHom f p) f := by
      intro W V f p
      dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
      rw [Fin.lastCases_last]
    have hProjCastSucc : ∀ {W V : S.Etale} (f : W ⟶ V) (p : ℕ) (i : Fin (p + 1)),
        weilEtaleCechProj f (p + 1) i.castSucc =
          CategoryTheory.Limits.pullback.fst (weilEtaleCechHom f p) f ≫ weilEtaleCechProj f p i := by
      intro W V f p i
      dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
      rw [Fin.lastCases_castSucc]
      rfl
    have hLiftProj : ∀ {W V Y : S.Etale} (f : W ⟶ V) (h : Y ⟶ V) (p : ℕ)
        (g : Fin (p + 1) → (Y ⟶ W)) (hg : ∀ i, g i ≫ f = h) (k : Fin (p + 1)),
        (weilEtaleCechLiftSub f h p g hg).1 ≫ weilEtaleCechProj f p k = g k := by
      intro W V Y f h p
      induction p with
      | zero =>
        intro g hg k
        have hk : k = 0 := Fin.eq_zero k
        subst hk
        exact CategoryTheory.Category.comp_id (g 0)
      | succ p ih =>
        intro g hg k
        refine Fin.lastCases ?_ ?_ k
        · exact (congrArg ((weilEtaleCechLiftSub f h (p + 1) g hg).1 ≫ ·) (hProjLast f p)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        · intro i
          exact (congrArg ((weilEtaleCechLiftSub f h (p + 1) g hg).1 ≫ ·) (hProjCastSucc f p i)).trans
            ((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
              (ih (fun j => g j.castSucc) (fun j => hg j.castSucc) i))
    have hProjExt : ∀ {W V Y : S.Etale} (f : W ⟶ V) (p : ℕ) (a b : Y ⟶ weilEtaleCechObj f p),
        (∀ k : Fin (p + 1), a ≫ weilEtaleCechProj f p k = b ≫ weilEtaleCechProj f p k) → a = b := by
      intro W V Y f p
      induction p with
      | zero =>
        intro a b hab
        exact (CategoryTheory.Category.comp_id a).symm.trans
          ((hab 0).trans (CategoryTheory.Category.comp_id b))
      | succ p ih =>
        intro a b hab
        apply CategoryTheory.Limits.pullback.hom_ext
        · apply ih
          intro i
          have hi := hab i.castSucc
          exact (CategoryTheory.Category.assoc a _ _).trans
            (((congrArg (a ≫ ·) (hProjCastSucc f p i)).symm.trans hi).trans
              ((congrArg (b ≫ ·) (hProjCastSucc f p i)).trans
                (CategoryTheory.Category.assoc b _ _).symm))
        · exact (congrArg (a ≫ ·) (hProjLast f p)).symm.trans
            ((hab (Fin.last (p + 1))).trans (congrArg (b ≫ ·) (hProjLast f p)))
    have hFaceProj : ∀ (p : ℕ) (j : Fin (p + 2)) (k : Fin (p + 1)),
        weilEtaleCechFace w p j ≫ weilEtaleCechProj w p k =
          weilEtaleCechProj w (p + 1) (j.succAbove k) :=
      fun p j k => hLiftProj w (weilEtaleCechHom w (p + 1)) p
        (fun i => weilEtaleCechProj w (p + 1) (j.succAbove i))
        (fun i => (weilEtaleCechProjSub w (p + 1) (j.succAbove i)).2) k
    have hFaceHom : ∀ (p : ℕ) (j : Fin (p + 2)),
        weilEtaleCechFace w p j ≫ weilEtaleCechHom w p = weilEtaleCechHom w (p + 1) :=
      fun p j => (weilEtaleCechLiftSub w (weilEtaleCechHom w (p + 1)) p
        (fun i => weilEtaleCechProj w (p + 1) (j.succAbove i))
        (fun i => (weilEtaleCechProjSub w (p + 1) (j.succAbove i)).2)).2
    have hSuccAboveComm : ∀ (p : ℕ) (i j : Fin (p + 2)) (k : Fin (p + 1)),
        i ≤ j → j.succ.succAbove (i.succAbove k) = i.castSucc.succAbove (j.succAbove k) := by
      intro p i j k hij
      have hij_val : (i : ℕ) ≤ (j : ℕ) := hij
      ext
      simp only [Fin.succAbove, Fin.lt_def, Fin.val_castSucc, Fin.val_succ]
      split_ifs <;> simp only [Fin.val_castSucc, Fin.val_succ] at * <;> omega
    have hFaceComm : ∀ (p : ℕ) (i j : Fin (p + 2)),
        i ≤ j →
        weilEtaleCechFace w (p + 1) j.succ ≫ weilEtaleCechFace w p i =
          weilEtaleCechFace w (p + 1) i.castSucc ≫ weilEtaleCechFace w p j := by
      intro p i j hij
      apply hProjExt w p
      intro k
      rw [CategoryTheory.Category.assoc, hFaceProj, hFaceProj, CategoryTheory.Category.assoc,
        hFaceProj, hFaceProj, hSuccAboveComm p i j k hij]
    have hDiffZero₀ : cechRepDiff w 0 ≫ weilFreeYonedaMap.{u} w = 0 := by
      change cechRepDiff w 0 ≫ weilFreeYonedaMap.{u} (weilEtaleCechHom w 0) = 0
      dsimp only [cechRepDiff]
      rw [Fin.sum_univ_two]
      simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul, neg_one_smul,
        CategoryTheory.Preadditive.add_comp, CategoryTheory.Preadditive.neg_comp, ← hYonMap_comp,
        hFaceHom, add_neg_cancel]
    have hDiffZero : ∀ p : ℕ, cechRepDiff w (p + 1) ≫ cechRepDiff w p = 0 := by
      intro p
      let term : Fin (p + 3) × Fin (p + 2) →
          (weilFreeYonedaZ.{u} S (weilEtaleCechObj w (p + 2)) ⟶
            weilFreeYonedaZ.{u} S (weilEtaleCechObj w p)) :=
        fun x => ((-1 : ℤ) ^ ((x.1 : ℕ) + (x.2 : ℕ))) •
          weilFreeYonedaMap.{u} (weilEtaleCechFace w (p + 1) x.1 ≫ weilEtaleCechFace w p x.2)
      have hexp : cechRepDiff w (p + 1) ≫ cechRepDiff w p = Finset.univ.sum term := by
        dsimp only [cechRepDiff, term]
        rw [CategoryTheory.Preadditive.sum_comp, ← Finset.univ_product_univ, Finset.sum_product]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [CategoryTheory.Preadditive.comp_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [CategoryTheory.Preadditive.zsmul_comp, CategoryTheory.Preadditive.comp_zsmul,
          smul_smul, ← pow_add, ← hYonMap_comp]
      rw [hexp]
      let T : Finset (Fin (p + 2) × Fin (p + 2)) := Finset.univ.filter (fun x => x.1 ≤ x.2)
      let α₁ : Fin (p + 2) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) := fun x => (x.2.succ, x.1)
      let α₂ : Fin (p + 2) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) := fun x => (x.1.castSucc, x.2)
      have hInj₁ : Function.Injective α₁ := by
        rintro ⟨i₁, j₁⟩ ⟨i₂, j₂⟩ h
        exact Prod.ext (Prod.mk.inj h).2 (Fin.succ_injective _ (Prod.mk.inj h).1)
      have hInj₂ : Function.Injective α₂ := by
        rintro ⟨i₁, j₁⟩ ⟨i₂, j₂⟩ h
        exact Prod.ext (Fin.castSucc_injective _ (Prod.mk.inj h).1) (Prod.mk.inj h).2
      have hDisj : Disjoint (T.image α₁) (T.image α₂) := by
        rw [Finset.disjoint_left]
        intro z hz₁ hz₂
        rcases Finset.mem_image.mp hz₁ with ⟨⟨i₁, j₁⟩, hmem₁, rfl⟩
        rcases Finset.mem_image.mp hz₂ with ⟨⟨i₂, j₂⟩, hmem₂, heq⟩
        have hle₁ : (i₁ : ℕ) ≤ (j₁ : ℕ) := (Finset.mem_filter.mp hmem₁).2
        have hle₂ : (i₂ : ℕ) ≤ (j₂ : ℕ) := (Finset.mem_filter.mp hmem₂).2
        have hr : (i₂ : ℕ) = (j₁ : ℕ) + 1 :=
          congrArg (fun q : Fin (p + 3) × Fin (p + 2) => (q.1 : ℕ)) heq
        have hk : (j₂ : ℕ) = (i₁ : ℕ) :=
          congrArg (fun q : Fin (p + 3) × Fin (p + 2) => (q.2 : ℕ)) heq
        omega
      have hUnion : T.image α₁ ∪ T.image α₂ = Finset.univ := by
        ext ⟨r, m⟩
        simp only [Finset.mem_union, Finset.mem_univ, iff_true, Finset.mem_image]
        by_cases hmr : (m : ℕ) < (r : ℕ)
        · left
          revert hmr
          refine Fin.cases ?_ ?_ r
          · intro hmr; exfalso; exact Nat.not_lt_zero (m : ℕ) hmr
          · intro j hmr
            refine ⟨(m, j), ?_, rfl⟩
            dsimp only [T]; rw [Finset.mem_filter]
            exact ⟨Finset.mem_univ _,
              by change (m : ℕ) ≤ (j : ℕ); have : (m : ℕ) < (j : ℕ) + 1 := hmr; omega⟩
        · right
          revert hmr
          refine Fin.lastCases ?_ ?_ r
          · intro hmr; exfalso
            have hm_lt : (m : ℕ) < p + 2 := m.isLt
            rw [Fin.val_last (p + 2)] at hmr; omega
          · intro i hmr
            refine ⟨(i, m), ?_, rfl⟩
            dsimp only [T]; rw [Finset.mem_filter]
            exact ⟨Finset.mem_univ _,
              by change (i : ℕ) ≤ (m : ℕ); rw [Fin.val_castSucc i] at hmr; omega⟩
      rw [← hUnion, Finset.sum_union hDisj,
        Finset.sum_image (fun _ _ _ _ h => hInj₁ h),
        Finset.sum_image (fun _ _ _ _ h => hInj₂ h),
        ← Finset.sum_add_distrib]
      apply Finset.sum_eq_zero
      rintro ⟨i, j⟩ hij
      have hij' : i ≤ j := (Finset.mem_filter.mp hij).2
      dsimp only [term, α₁, α₂]
      rw [hFaceComm p i j hij', ← add_smul]
      have hsign : (-1 : ℤ) ^ ((j.succ : ℕ) + (i : ℕ)) +
          (-1 : ℤ) ^ ((i.castSucc : ℕ) + (j : ℕ)) = 0 := by
        simp only [Fin.val_succ, Fin.val_castSucc]
        have hexp' : (j : ℕ) + 1 + (i : ℕ) = ((i : ℕ) + (j : ℕ)) + 1 := by omega
        rw [hexp', pow_succ]; ring
      rw [hsign, zero_smul]

    
    let fibOf : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (_y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
        CategoryTheory.Functor S.Etale (Type u) :=
      fun Ω _ _ y =>
        { obj := fun E =>
            { e : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E.left // e ≫ E.hom = y }
          map := fun {_ _} u =>
            TypeCat.ofHom fun e =>
              ⟨e.1 ≫ u.left,
                ((CategoryTheory.Category.assoc e.1 u.left _).trans
                  (congrArg (e.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans e.2⟩
          map_id := fun _ => by ext ⟨e, _⟩; exact CategoryTheory.Category.comp_id e
          map_comp := fun u v => by
            ext ⟨e, _⟩; exact (CategoryTheory.Category.assoc e u.left v.left).symm }
    let pt : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (_y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
        CategoryTheory.GrothendieckTopology.Point.{u} S.smallEtaleTopology :=
      fun Ω _ _ y => by
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        letI : Unique ↥S_Ω := PrimeSpectrum.instUnique
        have : IsSepClosed Ω := inferInstance
        let fib_w := fibOf Ω y
        have hJoint : ∀ {E : S.Etale}, ∀ R ∈ S.smallEtaleTopology E,
            ∀ (e : fib_w.obj E),
              ∃ (Y : S.Etale) (u : Y ⟶ E) (_ : R.arrows u) (e' : fib_w.obj Y),
                fib_w.map u e' = e := by
          intro E R hR e
          let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme := @AlgebraicGeometry.Etale
          have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck E := by
            rwa [← AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
              (P := P) (Q := P) S (le_refl P)]
          obtain ⟨Y, u, y₀, huR, huP, hy₀⟩ :=
            (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
              (P := P) (Q := P) (S := S) E R).mp hR' (e.1 default)
          have : AlgebraicGeometry.Etale u.left := huP
          let Z₀ := CategoryTheory.Limits.pullback u.left e.1
          let p : Z₀ ⟶ Y.left := CategoryTheory.Limits.pullback.fst u.left e.1
          let q : Z₀ ⟶ S_Ω := CategoryTheory.Limits.pullback.snd u.left e.1
          have hq_surj : Function.Surjective ⇑q := by
            intro s
            have hs : e.1 s = e.1 default := congrArg (⇑e.1) (Subsingleton.elim s default)
            obtain ⟨z, -, hz⟩ :=
              AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ s (hy₀.trans hs.symm)
            exact ⟨z, hz⟩
          have hsing_mem : CategoryTheory.Presieve.singleton q ∈
              (AlgebraicGeometry.Scheme.precoverage P).coverings S_Ω :=
            (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P q).mpr ⟨hq_surj, inferInstance⟩
          have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q) ∈
              AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
            CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing_mem
          obtain ⟨Z_pt, f_Z, hf_Z, z_Z, hz_Z⟩ :=
            (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective _ hcov (𝟙 S_Ω)
          obtain ⟨Z', g_Z, q', hq'_sing, hfac⟩ := hf_Z
          cases hq'_sing
          change z_Z ≫ f_Z = 𝟙 S_Ω at hz_Z
          let σ : S_Ω ⟶ Z₀ := z_Z ≫ g_Z
          have hσ_q : σ ≫ q = 𝟙 S_Ω :=
            (CategoryTheory.Category.assoc z_Z g_Z q).trans ((congrArg (z_Z ≫ ·) hfac).trans hz_Z)
          let e'_mor : S_Ω ⟶ Y.left := σ ≫ p
          have he'_u : e'_mor ≫ u.left = e.1 :=
            (CategoryTheory.Category.assoc σ p u.left).trans
              ((congrArg (σ ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc σ q e.1).symm.trans
                  ((congrArg (· ≫ e.1) hσ_q).trans (CategoryTheory.Category.id_comp e.1))))
          have he'_w : e'_mor ≫ Y.hom = y :=
            ((congrArg (e'_mor ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
              ((CategoryTheory.Category.assoc e'_mor u.left E.hom).symm.trans
                (congrArg (· ≫ E.hom) he'_u))).trans e.2
          exact ⟨Y, u, huR, ⟨e'_mor, he'_w⟩, Subtype.ext he'_u⟩
        have hcof_or_empty : CategoryTheory.IsCofilteredOrEmpty fib_w.Elements := by
          refine CategoryTheory.IsCofilteredOrEmpty.mk ?_ ?_
          · intro X Y
            have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
            have : AlgebraicGeometry.Etale Y.1.hom := Y.1.prop
            let fst := CategoryTheory.Limits.pullback.fst X.1.hom Y.1.hom
            let snd := CategoryTheory.Limits.pullback.snd X.1.hom Y.1.hom
            let E₁₂ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ X.1.hom) inferInstance
            let l : S_Ω ⟶ E₁₂.left :=
              CategoryTheory.Limits.pullback.lift X.2.1 Y.2.1 (X.2.2.trans Y.2.2.symm)
            have hl : l ≫ E₁₂.hom = y :=
              ((CategoryTheory.Category.assoc l fst X.1.hom).symm.trans
                (congrArg (· ≫ X.1.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans X.2.2
            let Z_el : fib_w.Elements := CategoryTheory.Functor.elementsMk fib_w E₁₂ ⟨l, hl⟩
            let pX : E₁₂ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk fst rfl
            let pY : E₁₂ ⟶ Y.1 :=
              CategoryTheory.MorphismProperty.Over.homMk snd CategoryTheory.Limits.pullback.condition.symm
            exact ⟨Z_el, ⟨pX, Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)⟩,
              ⟨pY, Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩, trivial⟩
          · intro X Y u v
            have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
            have : AlgebraicGeometry.Etale Y.1.hom := Y.1.prop
            let Δ := CategoryTheory.Limits.pullback.diagonal Y.1.hom
            have : AlgebraicGeometry.IsOpenImmersion Δ :=
              AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal Y.1.hom
            have huv_w : u.1.left ≫ Y.1.hom = v.1.left ≫ Y.1.hom :=
              (CategoryTheory.MorphismProperty.Over.w u.1).trans
                (CategoryTheory.MorphismProperty.Over.w v.1).symm
            let uv := CategoryTheory.Limits.pullback.lift u.1.left v.1.left huv_w
            let p₁ := CategoryTheory.Limits.pullback.fst Δ uv
            let j₀ : CategoryTheory.Limits.pullback Δ uv ⟶ X.1.left :=
              CategoryTheory.Limits.pullback.snd Δ uv
            let E₀ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (j₀ ≫ X.1.hom) inferInstance
            have hu_pt : X.2.1 ≫ u.1.left = Y.2.1 := congrArg Subtype.val u.2
            have hv_pt : X.2.1 ≫ v.1.left = Y.2.1 := congrArg Subtype.val v.2
            have hpt_eq : Y.2.1 ≫ Δ = X.2.1 ≫ uv := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · exact ((CategoryTheory.Category.assoc Y.2.1 Δ _).trans
                  ((congrArg (Y.2.1 ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y.1.hom)).trans
                    (CategoryTheory.Category.comp_id Y.2.1))).trans
                  (((CategoryTheory.Category.assoc X.2.1 uv _).trans
                    (congrArg (X.2.1 ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans hu_pt).symm
              · exact ((CategoryTheory.Category.assoc Y.2.1 Δ _).trans
                  ((congrArg (Y.2.1 ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y.1.hom)).trans
                    (CategoryTheory.Category.comp_id Y.2.1))).trans
                  (((CategoryTheory.Category.assoc X.2.1 uv _).trans
                    (congrArg (X.2.1 ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans hv_pt).symm
            let l₀ : S_Ω ⟶ E₀.left := CategoryTheory.Limits.pullback.lift Y.2.1 X.2.1 hpt_eq
            have hl₀ : l₀ ≫ E₀.hom = y :=
              ((CategoryTheory.Category.assoc l₀ j₀ X.1.hom).symm.trans
                (congrArg (· ≫ X.1.hom) (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans X.2.2
            let Z₀ : fib_w.Elements := CategoryTheory.Functor.elementsMk fib_w E₀ ⟨l₀, hl₀⟩
            let h_mor : E₀ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
            let h_el : Z₀ ⟶ X := ⟨h_mor, Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩
            refine ⟨Z₀, h_el, ?_⟩
            apply CategoryTheory.Functor.Elements.hom_ext
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            change j₀ ≫ u.1.left = j₀ ≫ v.1.left
            have hcond := CategoryTheory.Limits.pullback.condition (f := Δ) (g := uv)
            have h1 : p₁ = j₀ ≫ u.1.left :=
              ((CategoryTheory.Category.comp_id p₁).symm.trans
                (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y.1.hom).symm)).trans
                (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans (congrArg (· ≫ _) hcond)).trans
                  ((CategoryTheory.Category.assoc j₀ uv _).trans
                    (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
            have h2 : p₁ = j₀ ≫ v.1.left :=
              ((CategoryTheory.Category.comp_id p₁).symm.trans
                (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y.1.hom).symm)).trans
                (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans (congrArg (· ≫ _) hcond)).trans
                  ((CategoryTheory.Category.assoc j₀ uv _).trans
                    (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
            exact h1.symm.trans h2
        have hne : Nonempty fib_w.Elements :=
          ⟨CategoryTheory.Functor.elementsMk fib_w
            (AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)) ⟨y, CategoryTheory.Category.comp_id y⟩⟩
        have hcof : CategoryTheory.IsCofiltered fib_w.Elements :=
          @CategoryTheory.IsCofiltered.mk _ _ hcof_or_empty hne
        have hism : CategoryTheory.InitiallySmall.{u} fib_w.Elements := by
          let ι_aff : CategoryTheory.Functor S.AffineEtale S.Etale :=
            AlgebraicGeometry.Scheme.AffineEtale.Spec S
          let M : Type u := CategoryTheory.SmallModel.{u} S.AffineEtale
          let e_M := CategoryTheory.equivSmallModel.{u} S.AffineEtale
          let Idx : Type u := Sigma fun (m : M) => fib_w.obj (ι_aff.obj (e_M.inverse.obj m))
          let φ : Idx → fib_w.Elements := fun p =>
            CategoryTheory.Functor.elementsMk fib_w (ι_aff.obj (e_M.inverse.obj p.1)) p.2
          have : Small.{u} ↑(Set.range φ) := small_range φ
          refine @CategoryTheory.initiallySmall_of_small_weakly_initial_set _ _ hcof_or_empty
            (Set.range φ) _ ?_
          intro X
          have hcov_aff : CategoryTheory.Sieve.coverByImage ι_aff X.1 ∈ S.smallEtaleTopology X.1 :=
            CategoryTheory.Functor.is_cover_of_isCoverDense ι_aff S.smallEtaleTopology X.1
          obtain ⟨Y, u, hu_cov, e_Y, he_Y⟩ := hJoint _ hcov_aff X.2
          obtain ⟨A, f₁, f₂, hf₁₂⟩ := hu_cov
          let e_A : fib_w.obj (ι_aff.obj A) := fib_w.map f₁ e_Y
          have he_A : fib_w.map f₂ e_A = X.2 := by
            dsimp [e_A]
            have hmap_comp := congrArg (fun fn => fn e_Y) (fib_w.map_comp f₁ f₂)
            dsimp at hmap_comp
            rw [← hmap_comp, hf₁₂, he_Y]
          let m : M := e_M.functor.obj A
          let θ : ι_aff.obj (e_M.inverse.obj m) ≅ ι_aff.obj A :=
            ι_aff.mapIso (e_M.unitIso.app A).symm
          let e_m : fib_w.obj (ι_aff.obj (e_M.inverse.obj m)) := fib_w.map θ.inv e_A
          have he_m : fib_w.map (θ.hom ≫ f₂) e_m = X.2 := by
            dsimp [e_m]
            have h1 := congrArg (fun fn => fn e_A) (fib_w.map_comp θ.inv (θ.hom ≫ f₂))
            dsimp at h1
            rw [← h1, ← CategoryTheory.Category.assoc, θ.inv_hom_id,
              CategoryTheory.Category.id_comp, he_A]
          exact ⟨φ ⟨m, e_m⟩, ⟨⟨m, e_m⟩, rfl⟩, ⟨⟨θ.hom ≫ f₂, he_m⟩⟩⟩
        exact CategoryTheory.GrothendieckTopology.Point.mk fib_w hcof hism hJoint

    have hIsZeroOfPts : ∀ (H : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
          CategoryTheory.Limits.IsZero ((pt Ω y).sheafFiber.obj H)) →
        CategoryTheory.Limits.IsZero H := by
      intro H hStalkZero
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.Sheaf.hom_ext
      ext E_op s
      let E : S.Etale := E_op.unop
      change s = (0 : H.obj.obj (Opposite.op E))
      let R_s : CategoryTheory.Sieve E :=
        { arrows := fun _ u => H.obj.map u.op s = 0
          downward_closed := fun {_ _ u} hu g => by
            change (H.obj.map (u.op ≫ g.op)) s = 0
            rw [H.obj.map_comp]
            change (H.obj.map g.op) ((H.obj.map u.op) s) = 0
            rw [hu, map_zero] }
      have hRs : R_s ∈ S.smallEtaleTopology E := by
        let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme := @AlgebraicGeometry.Etale
        have hEqTop : S.smallEtaleTopology =
            (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck :=
          AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            (P := P) (Q := P) S (le_refl P)
        rw [hEqTop]
        refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P) (Q := P) (S := S) E R_s).mpr ?_
        intro z
        let Ω_z : Type u := AlgebraicClosure (E.left.residueField z)
        let S_Ωz := AlgebraicGeometry.Spec (CommRingCat.of Ω_z)
        let : Unique ↥S_Ωz := PrimeSpectrum.instUnique
        let z_bar : S_Ωz ⟶ E.left :=
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (E.left.residueField z) Ω_z)) ≫
            E.left.fromSpecResidueField z
        let x_z : S_Ωz ⟶ S := z_bar ≫ E.hom
        let Φ_z := pt Ω_z x_z
        have hZero_z : CategoryTheory.Limits.IsZero (Φ_z.sheafFiber.obj H) := hStalkZero Ω_z x_z
        let pt_E : Φ_z.fiber.obj E := ⟨z_bar, rfl⟩
        have hto0 : Φ_z.toPresheafFiber E pt_E H.obj = 0 := hZero_z.eq_of_tgt _ 0
        have hrep_eq : (Φ_z.toPresheafFiber E pt_E H.obj) s =
            (Φ_z.toPresheafFiber E pt_E H.obj) 0 := by rw [hto0]; rfl
        obtain ⟨E', u_z, pt_E', hu_pt, hu_sec⟩ :=
          (Φ_z.toPresheafFiber_eq_iff' E pt_E s (0 : H.obj.obj (Opposite.op E))).mp hrep_eq
        have hu_Rs : R_s.arrows u_z := hu_sec.trans (map_zero _)
        have : AlgebraicGeometry.Etale E'.hom := E'.prop
        have : AlgebraicGeometry.Etale E.hom := E.prop
        have hu_P : P u_z.left := by
          refine CategoryTheory.MorphismProperty.of_postcomp P u_z.left E.hom E.prop ?_
          rw [CategoryTheory.MorphismProperty.Over.w u_z]
          exact E'.prop
        have hu_mor : pt_E'.1 ≫ u_z.left = z_bar := congrArg Subtype.val hu_pt
        let y₀ : ↥E'.left := pt_E'.1 default
        have hy₀ : u_z.left y₀ = z := by
          have h1 : u_z.left y₀ = z_bar default :=
            (AlgebraicGeometry.Scheme.Hom.comp_apply pt_E'.1 u_z.left default).symm.trans
              (congrArg (fun fn : S_Ωz ⟶ E.left => fn default) hu_mor)
          have h2 : z_bar default ∈ Set.range ⇑(E.left.fromSpecResidueField z) :=
            ⟨_, (AlgebraicGeometry.Scheme.Hom.comp_apply _ (E.left.fromSpecResidueField z) default).symm⟩
          rw [AlgebraicGeometry.Scheme.range_fromSpecResidueField z, Set.mem_singleton_iff] at h2
          exact h1.trans h2
        exact ⟨E', u_z, y₀, hu_Rs, hu_P, hy₀⟩
      refine H.isSeparated E R_s hRs s 0 ?_
      intro Y u hu
      change H.obj.map u.op s = H.obj.map u.op 0
      rw [map_zero]
      exact hu

    
    have hHomotopyExactGrp : ∀ (SC : CategoryTheory.ShortComplex AddCommGrpCat.{u})
        (k₁ : SC.X₂ ⟶ SC.X₁) (k₂ : SC.X₃ ⟶ SC.X₂),
        k₁ ≫ SC.f + SC.g ≫ k₂ = 𝟙 SC.X₂ → SC.Exact := by
      intro SC k₁ k₂ hk
      have hfac : (SC.iCycles ≫ k₁) ≫ SC.toCycles = 𝟙 SC.cycles := by
        apply (CategoryTheory.cancel_mono SC.iCycles).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, SC.toCycles_i,
          CategoryTheory.Category.id_comp]
        have hcomp := congrArg (fun m => SC.iCycles ≫ m) hk
        change SC.iCycles ≫ (k₁ ≫ SC.f + SC.g ≫ k₂) = SC.iCycles ≫ 𝟙 SC.X₂ at hcomp
        rw [CategoryTheory.Preadditive.comp_add, ← CategoryTheory.Category.assoc SC.iCycles SC.g k₂,
          SC.iCycles_g, CategoryTheory.Limits.zero_comp, add_zero,
          CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc] at hcomp
        exact hcomp
      have : CategoryTheory.Epi SC.toCycles := hEpiOfRetractGrp (SC.iCycles ≫ k₁) SC.toCycles hfac
      exact (CategoryTheory.ShortComplex.exact_iff_epi_toCycles SC).mpr inferInstance

    have hEt_w_left : AlgebraicGeometry.Etale w.left := by
      have : AlgebraicGeometry.Etale U.hom := U.prop
      have : AlgebraicGeometry.Etale Z.hom := Z.prop
      refine CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) w.left Z.hom Z.prop ?_
      rw [CategoryTheory.MorphismProperty.Over.w w]
      exact U.prop
    have hSurj_w_left : AlgebraicGeometry.Surjective w.left := hSurj
    let U_sch : CategoryTheory.Functor S.Etale AlgebraicGeometry.Scheme.{u} :=
      (AlgebraicGeometry.Scheme.Etale.forget S).comp (CategoryTheory.Over.forget S)

    let S₀_sc := CategoryTheory.ShortComplex.mk (cechRepDiff w 0) (weilFreeYonedaMap.{u} w) hDiffZero₀
    let Sp_sc : ∀ q : ℕ, CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      fun q => CategoryTheory.ShortComplex.mk (cechRepDiff w (q + 1)) (cechRepDiff w q) (hDiffZero q)

    have hStalkExactAll : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
        CategoryTheory.Limits.IsZero
          ((pt Ω y).sheafFiber.obj (CategoryTheory.Limits.cokernel (weilFreeYonedaMap.{u} w))) ∧
        CategoryTheory.Limits.IsZero ((pt Ω y).sheafFiber.obj S₀_sc.homology) ∧
        ∀ q : ℕ, CategoryTheory.Limits.IsZero ((pt Ω y).sheafFiber.obj (Sp_sc q).homology) := by
      intro Ω _ _ y
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let : Unique ↥S_Ω := PrimeSpectrum.instUnique
      have : IsSepClosed Ω := inferInstance
      let Φ := pt Ω y
      let F_Φ := Φ.sheafFiber (A := AddCommGrpCat.{u})
      let Sky_Φ := Φ.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let adj_Φ := Φ.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
      have : CategoryTheory.Limits.PreservesFiniteLimits F_Φ := inferInstance
      have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} F_Φ := adj_Φ.leftAdjoint_preservesColimits
      have : F_Φ.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products F_Φ
      have : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} Sky_Φ := adj_Φ.rightAdjoint_preservesLimits
      have : Sky_Φ.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products Sky_Φ

      have hSecEx : ∀ t : Φ.fiber.obj Z, ∃ u_pt : Φ.fiber.obj U, Φ.fiber.map w u_pt = t := by
        intro t
        let P_pb := CategoryTheory.Limits.pullback w.left t.1
        let p_fst : P_pb ⟶ U.left := CategoryTheory.Limits.pullback.fst w.left t.1
        let q_snd : P_pb ⟶ S_Ω := CategoryTheory.Limits.pullback.snd w.left t.1
        have hpb := CategoryTheory.IsPullback.of_hasPullback w.left t.1
        have : AlgebraicGeometry.Etale q_snd :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb hEt_w_left
        have hq_surj_inst : AlgebraicGeometry.Surjective q_snd :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb hSurj_w_left
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme := @AlgebraicGeometry.Etale
        have hsing : CategoryTheory.Presieve.singleton q_snd ∈
            (AlgebraicGeometry.Scheme.precoverage P_et).coverings S_Ω :=
          (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P_et q_snd).mpr
            ⟨hq_surj_inst.surj, inferInstance⟩
        have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q_snd) ∈
            AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
          CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing
        obtain ⟨Z_pt, f_Z, hf_Z, z_Z, hz_Z⟩ :=
          (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective _ hcov (𝟙 S_Ω)
        obtain ⟨Z', g_Z, q', hq'_sing, hfac⟩ := hf_Z
        cases hq'_sing
        change z_Z ≫ f_Z = 𝟙 S_Ω at hz_Z
        let σ : S_Ω ⟶ P_pb := z_Z ≫ g_Z
        have hσ_q : σ ≫ q_snd = 𝟙 S_Ω :=
          (CategoryTheory.Category.assoc z_Z g_Z q_snd).trans ((congrArg (z_Z ≫ ·) hfac).trans hz_Z)
        let e_U : S_Ω ⟶ U.left := σ ≫ p_fst
        have he_w : e_U ≫ w.left = t.1 :=
          (CategoryTheory.Category.assoc σ p_fst w.left).trans
            ((congrArg (σ ≫ ·) CategoryTheory.Limits.pullback.condition).trans
              ((CategoryTheory.Category.assoc σ q_snd t.1).symm.trans
                ((congrArg (· ≫ t.1) hσ_q).trans (CategoryTheory.Category.id_comp t.1))))
        have he_U_hom : e_U ≫ U.hom = y :=
          ((congrArg (e_U ≫ ·) (CategoryTheory.MorphismProperty.Over.w w).symm).trans
            ((CategoryTheory.Category.assoc e_U w.left Z.hom).symm.trans
              (congrArg (· ≫ Z.hom) he_w))).trans t.2
        exact ⟨⟨e_U, he_U_hom⟩, Subtype.ext he_w⟩
      let g_sec : Φ.fiber.obj Z → Φ.fiber.obj U := fun t => (hSecEx t).choose
      have hg_sec : ∀ t : Φ.fiber.obj Z, Φ.fiber.map w (g_sec t) = t :=
        fun t => (hSecEx t).choose_spec

      let cechFiberLift : ∀ (p : ℕ) (t : Φ.fiber.obj Z) (tup : Fin (p + 1) → Φ.fiber.obj U),
          (∀ i : Fin (p + 1), Φ.fiber.map w (tup i) = t) →
          { x : Φ.fiber.obj (weilEtaleCechObj w p) //
            Φ.fiber.map (weilEtaleCechHom w p) x = t ∧
            ∀ i : Fin (p + 1), Φ.fiber.map (weilEtaleCechProj w p i) x = tup i } :=
        Nat.rec
          (fun t tup htup =>
            ⟨tup 0, htup 0, fun i => by
              have hi : i = 0 := Fin.eq_zero i
              subst hi
              exact congrArg (fun fn => fn (tup 0)) (Φ.fiber.map_id U)⟩)
          (fun p prev t tup htup =>
            let pr := prev t (fun i => tup i.castSucc) (fun i => htup i.castSucc)
            let c_p := weilEtaleCechHom w p
            let fst_p := CategoryTheory.Limits.pullback.fst c_p w
            let snd_p := CategoryTheory.Limits.pullback.snd c_p w
            let hpb_p : CategoryTheory.IsPullback fst_p.left snd_p.left c_p.left w.left :=
              (CategoryTheory.IsPullback.of_hasPullback c_p w).map U_sch
            let hcomm : pr.1.1 ≫ c_p.left = (tup (Fin.last (p + 1))).1 ≫ w.left :=
              (congrArg Subtype.val pr.2.1).trans (congrArg Subtype.val (htup (Fin.last (p + 1)))).symm
            let l_mor : S_Ω ⟶ (weilEtaleCechObj w (p + 1)).left :=
              hpb_p.lift pr.1.1 (tup (Fin.last (p + 1))).1 hcomm
            have hl_hom : l_mor ≫ (weilEtaleCechObj w (p + 1)).hom = y :=
              ((congrArg (l_mor ≫ ·) (CategoryTheory.MorphismProperty.Over.w fst_p).symm).trans
                ((CategoryTheory.Category.assoc l_mor fst_p.left _).symm.trans
                  (congrArg (· ≫ (weilEtaleCechObj w p).hom) (hpb_p.lift_fst _ _ _)))).trans pr.1.2
            let x_new : Φ.fiber.obj (weilEtaleCechObj w (p + 1)) := ⟨l_mor, hl_hom⟩
            have hx_fst : Φ.fiber.map fst_p x_new = pr.1 := Subtype.ext (hpb_p.lift_fst _ _ _)
            have hx_snd : Φ.fiber.map snd_p x_new = tup (Fin.last (p + 1)) :=
              Subtype.ext (hpb_p.lift_snd _ _ _)
            ⟨x_new,
              (congrArg (fun fn => fn x_new) (Φ.fiber.map_comp fst_p c_p)).trans
                ((congrArg (Φ.fiber.map c_p) hx_fst).trans pr.2.1),
              fun m => by
                refine Fin.lastCases ?_ ?_ m
                · exact (congrArg (fun mor => Φ.fiber.map mor x_new) (hProjLast w p)).trans hx_snd
                · intro i
                  exact (congrArg (fun mor => Φ.fiber.map mor x_new) (hProjCastSucc w p i)).trans
                    ((congrArg (fun fn => fn x_new) (Φ.fiber.map_comp fst_p (weilEtaleCechProj w p i))).trans
                      ((congrArg (Φ.fiber.map (weilEtaleCechProj w p i)) hx_fst).trans (pr.2.2 i)))⟩)
      have cechFiberExt : ∀ (p : ℕ) (x₁ x₂ : Φ.fiber.obj (weilEtaleCechObj w p)),
          (∀ m : Fin (p + 1),
            Φ.fiber.map (weilEtaleCechProj w p m) x₁ = Φ.fiber.map (weilEtaleCechProj w p m) x₂) →
          x₁ = x₂ := by
        intro p
        induction p with
        | zero =>
          intro x₁ x₂ hproj
          have h0 := hproj 0
          exact (congrArg (fun fn => fn x₁) (Φ.fiber.map_id U)).symm.trans
            (h0.trans (congrArg (fun fn => fn x₂) (Φ.fiber.map_id U)))
        | succ p ih =>
          intro x₁ x₂ hproj
          let c_p := weilEtaleCechHom w p
          let fst_p := CategoryTheory.Limits.pullback.fst c_p w
          let snd_p := CategoryTheory.Limits.pullback.snd c_p w
          let hpb_p : CategoryTheory.IsPullback fst_p.left snd_p.left c_p.left w.left :=
            (CategoryTheory.IsPullback.of_hasPullback c_p w).map U_sch
          have hfst_eq : Φ.fiber.map fst_p x₁ = Φ.fiber.map fst_p x₂ := by
            apply ih
            intro i
            have hi := hproj i.castSucc
            have hm1 := (congrArg (fun mor => Φ.fiber.map mor x₁) (hProjCastSucc w p i)).trans
              (congrArg (fun fn => fn x₁) (Φ.fiber.map_comp fst_p (weilEtaleCechProj w p i)))
            have hm2 := (congrArg (fun mor => Φ.fiber.map mor x₂) (hProjCastSucc w p i)).trans
              (congrArg (fun fn => fn x₂) (Φ.fiber.map_comp fst_p (weilEtaleCechProj w p i)))
            exact hm1.symm.trans (hi.trans hm2)
          have hsnd_eq : Φ.fiber.map snd_p x₁ = Φ.fiber.map snd_p x₂ := by
            have hl := hproj (Fin.last (p + 1))
            exact (congrArg (fun mor => Φ.fiber.map mor x₁) (hProjLast w p)).symm.trans
              (hl.trans (congrArg (fun mor => Φ.fiber.map mor x₂) (hProjLast w p)))
          apply Subtype.ext
          exact hpb_p.hom_ext (congrArg Subtype.val hfst_eq) (congrArg Subtype.val hsnd_eq)

      let tup_set : ∀ (p : ℕ) (x : Φ.fiber.obj (weilEtaleCechObj w p)), Fin (p + 2) → Φ.fiber.obj U :=
        fun p x => Fin.cases (g_sec (Φ.fiber.map (weilEtaleCechHom w p) x))
          (fun i => Φ.fiber.map (weilEtaleCechProj w p i) x)
      have htup_set : ∀ (p : ℕ) (x : Φ.fiber.obj (weilEtaleCechObj w p)) (m : Fin (p + 2)),
          Φ.fiber.map w (tup_set p x m) = Φ.fiber.map (weilEtaleCechHom w p) x := by
        intro p x m
        refine Fin.cases ?_ ?_ m
        · dsimp only [tup_set, Fin.cases_zero]
          exact hg_sec _
        · intro i
          dsimp only [tup_set, Fin.cases_succ]
          exact (congrArg (fun fn => fn x) (Φ.fiber.map_comp (weilEtaleCechProj w p i) w)).symm.trans
            (congrArg (fun mor => Φ.fiber.map mor x) (weilEtaleCechProjSub w p i).2)
      let s_set : ∀ p : ℕ, Φ.fiber.obj (weilEtaleCechObj w p) →
          Φ.fiber.obj (weilEtaleCechObj w (p + 1)) :=
        fun p x => (cechFiberLift (p + 1) (Φ.fiber.map (weilEtaleCechHom w p) x)
          (tup_set p x) (htup_set p x)).1
      have hs_proj : ∀ (p : ℕ) (x : Φ.fiber.obj (weilEtaleCechObj w p)) (m : Fin (p + 2)),
          Φ.fiber.map (weilEtaleCechProj w (p + 1) m) (s_set p x) = tup_set p x m :=
        fun p x m => (cechFiberLift (p + 1) (Φ.fiber.map (weilEtaleCechHom w p) x)
          (tup_set p x) (htup_set p x)).2.2 m
      have hs_face₀ : ∀ (p : ℕ) (x : Φ.fiber.obj (weilEtaleCechObj w p)),
          Φ.fiber.map (weilEtaleCechFace w p 0) (s_set p x) = x := by
        intro p x
        apply cechFiberExt p
        intro m
        exact (congrArg (fun fn => fn (s_set p x))
          (Φ.fiber.map_comp (weilEtaleCechFace w p 0) (weilEtaleCechProj w p m))).symm.trans
          ((congrArg (fun mor => Φ.fiber.map mor (s_set p x)) (hFaceProj p 0 m)).trans
            (hs_proj p x ((0 : Fin (p + 2)).succAbove m)))
      let g_sec0 : Φ.fiber.obj Z → Φ.fiber.obj (weilEtaleCechObj w 0) := g_sec
      have hs_face₀₁ : ∀ x : Φ.fiber.obj (weilEtaleCechObj w 0),
          Φ.fiber.map (weilEtaleCechFace w 0 1) (s_set 0 x) =
            g_sec0 (Φ.fiber.map (weilEtaleCechHom w 0) x) := by
        intro x
        apply cechFiberExt 0
        intro m
        have hm : m = 0 := Fin.eq_zero m
        subst hm
        exact (congrArg (fun fn => fn (s_set 0 x))
          (Φ.fiber.map_comp (weilEtaleCechFace w 0 1) (weilEtaleCechProj w 0 0))).symm.trans
          ((congrArg (fun mor => Φ.fiber.map mor (s_set 0 x)) (hFaceProj 0 1 0)).trans
            ((hs_proj 0 x 0).trans
              (congrArg (fun fn => fn (g_sec0 (Φ.fiber.map (weilEtaleCechHom w 0) x)))
                (Φ.fiber.map_id (weilEtaleCechObj w 0))).symm))
      have hs_face_succ : ∀ (q : ℕ) (r : Fin (q + 2))
          (x : Φ.fiber.obj (weilEtaleCechObj w (q + 1))),
          Φ.fiber.map (weilEtaleCechFace w (q + 1) r.succ) (s_set (q + 1) x) =
            s_set q (Φ.fiber.map (weilEtaleCechFace w q r) x) := by
        intro q r x
        apply cechFiberExt (q + 1)
        intro m
        have hLHS := (congrArg (fun fn => fn (s_set (q + 1) x))
          (Φ.fiber.map_comp (weilEtaleCechFace w (q + 1) r.succ)
            (weilEtaleCechProj w (q + 1) m))).symm.trans
          ((congrArg (fun mor => Φ.fiber.map mor (s_set (q + 1) x)) (hFaceProj (q + 1) r.succ m)).trans
            (hs_proj (q + 1) x (r.succ.succAbove m)))
        have hRHS := hs_proj q (Φ.fiber.map (weilEtaleCechFace w q r) x) m
        refine hLHS.trans (Eq.trans ?_ hRHS.symm)
        refine Fin.cases ?_ ?_ m
        · have hsa0 : r.succ.succAbove (0 : Fin (q + 2)) = 0 := by ext; simp [Fin.succAbove]
          rw [hsa0]
          dsimp only [tup_set, Fin.cases_zero]
          exact congrArg g_sec
            ((congrArg (fun mor => Φ.fiber.map mor x) (hFaceHom q r)).symm.trans
              (congrArg (fun fn => fn x) (Φ.fiber.map_comp (weilEtaleCechFace w q r)
                (weilEtaleCechHom w q))))
        · intro i
          have hsai : r.succ.succAbove i.succ = (r.succAbove i).succ := by
            ext
            simp only [Fin.succAbove, Fin.lt_def, Fin.val_castSucc, Fin.val_succ]
            split_ifs <;> simp only [Fin.val_castSucc, Fin.val_succ] at * <;> omega
          rw [hsai]
          dsimp only [tup_set, Fin.cases_succ]
          exact (congrArg (fun mor => Φ.fiber.map mor x) (hFaceProj q r i)).symm.trans
            (congrArg (fun fn => fn x)
              (Φ.fiber.map_comp (weilEtaleCechFace w q r) (weilEtaleCechProj w q i)))

      let adjEquivHom : ∀ (E : S.Etale) (M : AddCommGrpCat.{u}),
          (F_Φ.obj (weilFreeYonedaZ.{u} S E) ⟶ M) →+
            (weilFreeYonedaZ.{u} S E ⟶ Sky_Φ.obj M) :=
        fun E M =>
          { toFun := adj_Φ.homEquiv (weilFreeYonedaZ.{u} S E) M
            map_zero' := by
              rw [CategoryTheory.Adjunction.homEquiv_unit, Sky_Φ.map_zero,
                CategoryTheory.Limits.comp_zero]
            map_add' := fun a b => by
              rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
                CategoryTheory.Adjunction.homEquiv_unit, Sky_Φ.map_add,
                CategoryTheory.Preadditive.comp_add] }
      let piEvHom : ∀ (E : S.Etale) (M : AddCommGrpCat.{u}),
          ↥((Sky_Φ.obj M).obj.obj (Opposite.op E)) →+ (Φ.fiber.obj E → ↑M) :=
        fun E M =>
          { toFun := fun v x => (CategoryTheory.Limits.Pi.π (fun _ : Φ.fiber.obj E => M) x).hom v
            map_zero' := funext fun x => map_zero _
            map_add' := fun a b => funext fun x => map_add _ a b }
      let toMapAddHom : ∀ (E : S.Etale) (M : AddCommGrpCat.{u}),
          (F_Φ.obj (weilFreeYonedaZ.{u} S E) ⟶ M) →+ (Φ.fiber.obj E → ↑M) :=
        fun E M => (piEvHom E M).comp ((evHom S E (Sky_Φ.obj M)).comp (adjEquivHom E M))
      let ofMapΦ : ∀ (E : S.Etale) (M : AddCommGrpCat.{u}),
          (Φ.fiber.obj E → ↑M) → (F_Φ.obj (weilFreeYonedaZ.{u} S E) ⟶ M) :=
        fun E M f =>
          let ψ : Aℤ ⟶ (∏ᶜ fun _ : Φ.fiber.obj E => M) :=
            CategoryTheory.Limits.Pi.lift fun x =>
              AddCommGrpCat.ofHom
                { toFun := fun z => z.down • f x
                  map_zero' := zero_zsmul (f x)
                  map_add' := fun a b => add_zsmul (f x) a.down b.down }
          (adj_Φ.homEquiv (weilFreeYonedaZ.{u} S E) M).symm
            ((fyEquiv S E (Sky_Φ.obj M)).symm ψ)
      have hto_of : ∀ {E : S.Etale} {M : AddCommGrpCat.{u}} (f : Φ.fiber.obj E → ↑M),
          toMapAddHom E M (ofMapΦ E M f) = f := by
        intro E M f
        funext x
        dsimp only [toMapAddHom, piEvHom, evHom, adjEquivHom, ofMapΦ, AddMonoidHom.comp_apply,
          AddMonoidHom.coe_mk, ZeroHom.coe_mk]
        let ψ_f : Aℤ ⟶ (∏ᶜ fun _ : Φ.fiber.obj E => M) :=
          CategoryTheory.Limits.Pi.lift fun x' =>
            AddCommGrpCat.ofHom
              { toFun := fun z : ULift.{u} ℤ => z.down • f x'
                map_zero' := zero_zsmul (f x')
                map_add' := fun a b => add_zsmul (f x') a.down b.down }
        have h1 := (adj_Φ.homEquiv (weilFreeYonedaZ.{u} S E) M).apply_symm_apply
          ((fyEquiv S E (Sky_Φ.obj M)).symm ψ_f)
        have h2 := (fyEquiv S E (Sky_Φ.obj M)).apply_symm_apply ψ_f
        have hpi_mor : ψ_f ≫ CategoryTheory.Limits.Pi.π (fun _ : Φ.fiber.obj E => M) x =
            AddCommGrpCat.ofHom
              { toFun := fun z : ULift.{u} ℤ => z.down • f x
                map_zero' := zero_zsmul (f x)
                map_add' := fun a b => add_zsmul (f x) a.down b.down } := by
          dsimp only [ψ_f]
          simp
        have hpi := congrArg (fun g : Aℤ ⟶ M => g.hom (ULift.up 1)) hpi_mor
        exact (congrArg
          (fun fn : Aℤ ⟶ (Sky_Φ.obj M).obj.obj (Opposite.op E) =>
            (CategoryTheory.Limits.Pi.π (fun _ => M) x).hom (fn.hom (ULift.up 1)))
          ((congrArg (fyEquiv S E (Sky_Φ.obj M)) h1).trans h2)).trans
          (hpi.trans (one_zsmul (f x)))
      have hto_inj : ∀ {E : S.Etale} {M : AddCommGrpCat.{u}},
          Function.Injective (toMapAddHom E M) := by
        intro E M α₁ α₂ h12
        apply (adj_Φ.homEquiv (weilFreeYonedaZ.{u} S E) M).injective
        apply (fyEquiv S E (Sky_Φ.obj M)).injective
        let ψ₁ : Aℤ ⟶ (∏ᶜ fun _ : Φ.fiber.obj E => M) :=
          fyEquiv S E (Sky_Φ.obj M) (adj_Φ.homEquiv _ M α₁)
        let ψ₂ : Aℤ ⟶ (∏ᶜ fun _ : Φ.fiber.obj E => M) :=
          fyEquiv S E (Sky_Φ.obj M) (adj_Φ.homEquiv _ M α₂)
        change ψ₁ = ψ₂
        apply CategoryTheory.Limits.Pi.hom_ext
        intro x
        ext ⟨m⟩
        have hm : (⟨m⟩ : ULift.{u} ℤ) = m • ULift.up (1 : ℤ) := by ext; change m = m • (1 : ℤ); simp
        have hx := congrFun h12 x
        change (CategoryTheory.Limits.Pi.π (fun _ => M) x).hom (ψ₁.hom (ULift.up 1)) =
          (CategoryTheory.Limits.Pi.π (fun _ => M) x).hom (ψ₂.hom (ULift.up 1)) at hx
        change (CategoryTheory.Limits.Pi.π (fun _ => M) x).hom (ψ₁.hom ⟨m⟩) =
          (CategoryTheory.Limits.Pi.π (fun _ => M) x).hom (ψ₂.hom ⟨m⟩)
        rw [hm, map_zsmul, map_zsmul, map_zsmul, map_zsmul, hx]
      have hto_comp : ∀ {E : S.Etale} {M₁ M₂ : AddCommGrpCat.{u}}
          (α : F_Φ.obj (weilFreeYonedaZ.{u} S E) ⟶ M₁) (θ : M₁ ⟶ M₂) (x : Φ.fiber.obj E),
          toMapAddHom E M₂ (α ≫ θ) x = θ.hom (toMapAddHom E M₁ α x) := by
        intro E M₁ M₂ α θ x
        dsimp only [toMapAddHom, piEvHom, evHom, adjEquivHom, AddMonoidHom.comp_apply,
          AddMonoidHom.coe_mk, ZeroHom.coe_mk]
        rw [adj_Φ.homEquiv_naturality_right α θ, hFY_comp]
        let v₁ : ↑(∏ᶜ fun _ : Φ.fiber.obj E => M₁) :=
          (fyEquiv S E (Sky_Φ.obj M₁) ((adj_Φ.homEquiv (weilFreeYonedaZ.{u} S E) M₁) α)).hom
            (ULift.up 1)
        have hmap : ((Sky_Φ.map θ).hom.app (Opposite.op E)) ≫
            CategoryTheory.Limits.Pi.π (fun _ : Φ.fiber.obj E => M₂) x =
            CategoryTheory.Limits.Pi.π (fun _ : Φ.fiber.obj E => M₁) x ≫ θ := by
          change ((Φ.skyscraperPresheafFunctor.map θ).app (Opposite.op E)) ≫ _ = _
          rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app]
          exact CategoryTheory.Limits.Pi.map_π (fun _ => θ) x
        exact congrArg (fun g : (∏ᶜ fun _ : Φ.fiber.obj E => M₁) ⟶ M₂ => g.hom v₁) hmap
      have hto_yonMap : ∀ {E₁ E₂ : S.Etale} (u : E₁ ⟶ E₂) {M : AddCommGrpCat.{u}}
          (α : F_Φ.obj (weilFreeYonedaZ.{u} S E₂) ⟶ M) (x : Φ.fiber.obj E₁),
          toMapAddHom E₁ M (F_Φ.map (weilFreeYonedaMap.{u} u) ≫ α) x =
            toMapAddHom E₂ M α (Φ.fiber.map u x) := by
        intro E₁ E₂ u M α x
        dsimp only [toMapAddHom, piEvHom, evHom, adjEquivHom, AddMonoidHom.comp_apply,
          AddMonoidHom.coe_mk, ZeroHom.coe_mk]
        rw [adj_Φ.homEquiv_naturality_left (weilFreeYonedaMap.{u} u) α, hFY_map_comp]
        let v₂ : ↑(∏ᶜ fun _ : Φ.fiber.obj E₂ => M) :=
          (fyEquiv S E₂ (Sky_Φ.obj M) ((adj_Φ.homEquiv (weilFreeYonedaZ.{u} S E₂) M) α)).hom
            (ULift.up 1)
        have hmap : ((Sky_Φ.obj M).obj.map (Opposite.op u)) ≫
            CategoryTheory.Limits.Pi.π (fun _ : Φ.fiber.obj E₁ => M) x =
            CategoryTheory.Limits.Pi.π (fun _ : Φ.fiber.obj E₂ => M) (Φ.fiber.map u x) := by
          change ((Φ.skyscraperPresheafFunctor.obj M).map (Opposite.op u)) ≫ _ = _
          rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
          exact hPiMap'_π (Φ.fiber.map u) M x
        exact congrArg (fun g : (∏ᶜ fun _ : Φ.fiber.obj E₂ => M) ⟶ M => g.hom v₂) hmap
      let mapOfSet : ∀ {E₁ E₂ : S.Etale}, (Φ.fiber.obj E₁ → Φ.fiber.obj E₂) →
          (F_Φ.obj (weilFreeYonedaZ.{u} S E₁) ⟶ F_Φ.obj (weilFreeYonedaZ.{u} S E₂)) :=
        fun {E₁ E₂} f => ofMapΦ E₁ _ (fun x => toMapAddHom E₂ _ (𝟙 _) (f x))
      have hto_mapOfSet : ∀ {E₁ E₂ : S.Etale} (f : Φ.fiber.obj E₁ → Φ.fiber.obj E₂)
          {M : AddCommGrpCat.{u}} (α : F_Φ.obj (weilFreeYonedaZ.{u} S E₂) ⟶ M)
          (x : Φ.fiber.obj E₁),
          toMapAddHom E₁ M (mapOfSet f ≫ α) x = toMapAddHom E₂ M α (f x) := by
        intro E₁ E₂ f M α x
        rw [hto_comp]
        have h1 : toMapAddHom E₁ _ (mapOfSet f) x = toMapAddHom E₂ _ (𝟙 _) (f x) :=
          congrFun (hto_of _) x
        rw [h1, ← hto_comp, CategoryTheory.Category.id_comp]

      have hRetract_w : mapOfSet g_sec ≫ F_Φ.map (weilFreeYonedaMap.{u} w) = 𝟙 _ := by
        apply hto_inj
        funext t
        rw [hto_mapOfSet, ← CategoryTheory.Category.comp_id (F_Φ.map (weilFreeYonedaMap.{u} w)),
          hto_yonMap, hg_sec t]
      have hZeroCok : CategoryTheory.Limits.IsZero
          (F_Φ.obj (CategoryTheory.Limits.cokernel (weilFreeYonedaMap.{u} w))) := by
        let r_w := F_Φ.map (weilFreeYonedaMap.{u} w)
        have hEpi_rw : CategoryTheory.Epi r_w := hEpiOfRetractGrp (mapOfSet g_sec) r_w hRetract_w
        have hId0 : 𝟙 (CategoryTheory.Limits.cokernel r_w) = 0 := by
          apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π r_w)).mp
          apply hEpi_rw.left_cancellation
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero,
            CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
        have hZ_cok : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel r_w) :=
          (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mpr hId0
        exact CategoryTheory.Limits.IsZero.of_iso hZ_cok
          (CategoryTheory.Limits.PreservesCokernel.iso F_Φ (weilFreeYonedaMap.{u} w))

      have hHomotopy0 : mapOfSet (s_set 0) ≫ F_Φ.map (cechRepDiff w 0) +
          F_Φ.map (weilFreeYonedaMap.{u} (weilEtaleCechHom w 0)) ≫ mapOfSet g_sec0 = 𝟙 _ := by
        apply hto_inj
        funext x
        dsimp only [cechRepDiff]
        rw [Fin.sum_univ_two, F_Φ.map_add, CategoryTheory.Preadditive.comp_add,
          map_add, map_add, Pi.add_apply, Pi.add_apply]
        simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul, neg_one_smul,
          F_Φ.map_neg, CategoryTheory.Preadditive.comp_neg, map_neg, Pi.neg_apply]
        rw [hto_mapOfSet, ← CategoryTheory.Category.comp_id
              (F_Φ.map (weilFreeYonedaMap.{u} (weilEtaleCechFace w 0 0))),
            hto_yonMap, hs_face₀ 0 x,
            hto_mapOfSet, ← CategoryTheory.Category.comp_id
              (F_Φ.map (weilFreeYonedaMap.{u} (weilEtaleCechFace w 0 1))),
            hto_yonMap, hs_face₀₁ x,
            hto_yonMap, ← CategoryTheory.Category.comp_id (mapOfSet g_sec0), hto_mapOfSet]
        abel
      have hExact0 : (S₀_sc.map F_Φ).Exact :=
        hHomotopyExactGrp (S₀_sc.map F_Φ) (mapOfSet (s_set 0)) (mapOfSet g_sec0) hHomotopy0
      have hZeroH0 : CategoryTheory.Limits.IsZero (F_Φ.obj S₀_sc.homology) :=
        CategoryTheory.Limits.IsZero.of_iso
          ((CategoryTheory.ShortComplex.exact_iff_isZero_homology (S₀_sc.map F_Φ)).mp hExact0)
          (CategoryTheory.ShortComplex.mapHomologyIso S₀_sc F_Φ).symm

      have hZeroHq : ∀ q : ℕ, CategoryTheory.Limits.IsZero (F_Φ.obj (Sp_sc q).homology) := by
        intro q
        have hHomotopy_q : mapOfSet (s_set (q + 1)) ≫ F_Φ.map (cechRepDiff w (q + 1)) +
            F_Φ.map (cechRepDiff w q) ≫ mapOfSet (s_set q) = 𝟙 _ := by
          apply hto_inj
          funext x
          dsimp only [cechRepDiff]
          rw [Fin.sum_univ_succ, F_Φ.map_add, F_Φ.map_sum, F_Φ.map_sum,
            CategoryTheory.Preadditive.comp_add, CategoryTheory.Preadditive.comp_sum,
            CategoryTheory.Preadditive.sum_comp]
          rw [map_add, map_add, map_sum, map_sum,
            Pi.add_apply, Pi.add_apply, Finset.sum_apply, Finset.sum_apply]
          simp only [Fin.val_zero, pow_zero, one_smul, F_Φ.map_zsmul,
            CategoryTheory.Preadditive.comp_zsmul, CategoryTheory.Preadditive.zsmul_comp,
            map_zsmul, Pi.smul_apply]
          rw [hto_mapOfSet, ← CategoryTheory.Category.comp_id
                (F_Φ.map (weilFreeYonedaMap.{u} (weilEtaleCechFace w (q + 1) 0))),
              hto_yonMap, hs_face₀ (q + 1) x, add_assoc]
          suffices hcancel : (∑ r : Fin (q + 2),
              (-1 : ℤ) ^ (r.succ : ℕ) •
                toMapAddHom _ _ (mapOfSet (s_set (q + 1)) ≫
                  F_Φ.map (weilFreeYonedaMap.{u} (weilEtaleCechFace w (q + 1) r.succ))) x) +
              (∑ r : Fin (q + 2),
                (-1 : ℤ) ^ (r : ℕ) •
                  toMapAddHom _ _ (F_Φ.map (weilFreeYonedaMap.{u} (weilEtaleCechFace w q r)) ≫
                    mapOfSet (s_set q)) x) = 0 by
            rw [hcancel, add_zero]
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_eq_zero
          intro r _
          rw [hto_mapOfSet, ← CategoryTheory.Category.comp_id
                (F_Φ.map (weilFreeYonedaMap.{u} (weilEtaleCechFace w (q + 1) r.succ))),
              hto_yonMap, hs_face_succ q r x,
              hto_yonMap, ← CategoryTheory.Category.comp_id (mapOfSet (s_set q)),
              hto_mapOfSet, ← add_smul]
          have hsign : (-1 : ℤ) ^ (r.succ : ℕ) + (-1 : ℤ) ^ (r : ℕ) = 0 := by
            rw [Fin.val_succ, pow_succ]; ring
          rw [hsign, zero_smul]
        have hExact_q : ((Sp_sc q).map F_Φ).Exact :=
          hHomotopyExactGrp ((Sp_sc q).map F_Φ) (mapOfSet (s_set (q + 1))) (mapOfSet (s_set q))
            hHomotopy_q
        exact CategoryTheory.Limits.IsZero.of_iso
          ((CategoryTheory.ShortComplex.exact_iff_isZero_homology ((Sp_sc q).map F_Φ)).mp hExact_q)
          (CategoryTheory.ShortComplex.mapHomologyIso (Sp_sc q) F_Φ).symm

      exact ⟨hZeroCok, hZeroH0, hZeroHq⟩

    
    have hZeroCokGlobal : CategoryTheory.Limits.IsZero
        (CategoryTheory.Limits.cokernel (weilFreeYonedaMap.{u} w)) :=
      hIsZeroOfPts _ (fun Ω _ _ y => (hStalkExactAll Ω y).1)
    have hEpi_w : CategoryTheory.Epi (weilFreeYonedaMap.{u} w) := by
      refine ⟨fun {Q} u v huv => ?_⟩
      have hsub : weilFreeYonedaMap.{u} w ≫ (u - v) = 0 := by
        rw [CategoryTheory.Preadditive.comp_sub, sub_eq_zero]; exact huv
      have hπ0 : CategoryTheory.Limits.cokernel.π (weilFreeYonedaMap.{u} w) = 0 :=
        hZeroCokGlobal.eq_of_tgt _ 0
      have hd : u - v = CategoryTheory.Limits.cokernel.π (weilFreeYonedaMap.{u} w) ≫
          CategoryTheory.Limits.cokernel.desc (weilFreeYonedaMap.{u} w) (u - v) hsub :=
        (CategoryTheory.Limits.cokernel.π_desc _ _ _).symm
      rw [hπ0, CategoryTheory.Limits.zero_comp] at hd
      exact sub_eq_zero.mp hd
    have hExact0Global : S₀_sc.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_homology S₀_sc).mpr
        (hIsZeroOfPts _ (fun Ω _ _ y => (hStalkExactAll Ω y).2.1))
    have hExactqGlobal : ∀ q : ℕ, (Sp_sc q).Exact :=
      fun q => (CategoryTheory.ShortComplex.exact_iff_isZero_homology (Sp_sc q)).mpr
        (hIsZeroOfPts _ (fun Ω _ _ y => (hStalkExactAll Ω y).2.2 q))

    have hEpiKernelLiftOfExact : ∀ {A B C : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (f : A ⟶ B) (g : B ⟶ C) (hfg : f ≫ g = 0),
        (CategoryTheory.ShortComplex.mk f g hfg).Exact →
        CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift g f hfg) := by
      intro A B C f g hfg hEx
      let SC := CategoryTheory.ShortComplex.mk f g hfg
      have hEpi_to : CategoryTheory.Epi SC.toCycles := hEx.epi_toCycles
      let e : SC.cycles ⟶ CategoryTheory.Limits.kernel g :=
        CategoryTheory.Limits.kernel.lift g SC.iCycles SC.iCycles_g
      let e_inv : CategoryTheory.Limits.kernel g ⟶ SC.cycles :=
        SC.liftCycles (CategoryTheory.Limits.kernel.ι g) (CategoryTheory.Limits.kernel.condition g)
      have h_retract : e_inv ≫ e = 𝟙 _ := by
        apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι g)).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
          SC.liftCycles_i, CategoryTheory.Category.id_comp]
      have h_fac_kl : SC.toCycles ≫ e = CategoryTheory.Limits.kernel.lift g f hfg := by
        apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι g)).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
          SC.toCycles_i, CategoryTheory.Limits.kernel.lift_ι]
      rw [← h_fac_kl]
      exact hEpiCompSh SC.toCycles e hEpi_to (hEpiOfRetractSh e_inv e h_retract)

    have hMonoKernelIota : ∀ {A B : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (f : A ⟶ B), CategoryTheory.Mono (CategoryTheory.Limits.kernel.ι f) :=
      fun f => inferInstance
    let SyzPkg : ∀ p : ℕ,
        Σ' (K_p : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
           (ι_p : K_p ⟶ weilFreeYonedaZ.{u} S (weilEtaleCechObj w p))
           (π_p : weilFreeYonedaZ.{u} S (weilEtaleCechObj w (p + 1)) ⟶ K_p),
           CategoryTheory.Mono ι_p ∧ CategoryTheory.Epi π_p ∧ (π_p ≫ ι_p = cechRepDiff w p) :=
      Nat.rec
        (let K₀ := CategoryTheory.Limits.kernel (weilFreeYonedaMap.{u} (weilEtaleCechHom w 0))
         let ι₀ := CategoryTheory.Limits.kernel.ι (weilFreeYonedaMap.{u} (weilEtaleCechHom w 0))
         let π₀ := CategoryTheory.Limits.kernel.lift (weilFreeYonedaMap.{u} (weilEtaleCechHom w 0))
           (cechRepDiff w 0) hDiffZero₀
         ⟨K₀, ι₀, π₀,
           hMonoKernelIota (weilFreeYonedaMap.{u} (weilEtaleCechHom w 0)),
           hEpiKernelLiftOfExact (cechRepDiff w 0) (weilFreeYonedaMap.{u} (weilEtaleCechHom w 0))
             hDiffZero₀ hExact0Global,
           CategoryTheory.Limits.kernel.lift_ι _ _ _⟩)
        (fun p prev =>
          let K_prev := prev.1
          let ι_prev := prev.2.1
          let π_prev := prev.2.2.1
          let hMono_prev : CategoryTheory.Mono ι_prev := prev.2.2.2.1
          let hfac_prev : π_prev ≫ ι_prev = cechRepDiff w p := prev.2.2.2.2.2
          let h_cond : cechRepDiff w (p + 1) ≫ π_prev = 0 :=
            (CategoryTheory.cancel_mono ι_prev).mp
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (cechRepDiff w (p + 1) ≫ ·) hfac_prev).trans
                  ((hDiffZero p).trans (CategoryTheory.Limits.zero_comp).symm)))
          let K_next := CategoryTheory.Limits.kernel π_prev
          let ι_next := CategoryTheory.Limits.kernel.ι π_prev
          let π_next := CategoryTheory.Limits.kernel.lift π_prev (cechRepDiff w (p + 1)) h_cond
          have hEpi_next : CategoryTheory.Epi π_next := by
            let kl_diff := CategoryTheory.Limits.kernel.lift (cechRepDiff w p)
              (cechRepDiff w (p + 1)) (hDiffZero p)
            have hEpi_kl : CategoryTheory.Epi kl_diff :=
              hEpiKernelLiftOfExact (cechRepDiff w (p + 1)) (cechRepDiff w p) (hDiffZero p)
                (hExactqGlobal p)
            have h_ker_to : CategoryTheory.Limits.kernel.ι (cechRepDiff w p) ≫ π_prev = 0 :=
              (CategoryTheory.cancel_mono ι_prev).mp
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (CategoryTheory.Limits.kernel.ι (cechRepDiff w p) ≫ ·) hfac_prev).trans
                    ((CategoryTheory.Limits.kernel.condition (cechRepDiff w p)).trans
                      (CategoryTheory.Limits.zero_comp).symm)))
            let f_to : CategoryTheory.Limits.kernel (cechRepDiff w p) ⟶ K_next :=
              CategoryTheory.Limits.kernel.lift π_prev
                (CategoryTheory.Limits.kernel.ι (cechRepDiff w p)) h_ker_to
            have h_ker_inv : ι_next ≫ cechRepDiff w p = 0 :=
              (congrArg (ι_next ≫ ·) hfac_prev.symm).trans
                ((CategoryTheory.Category.assoc ι_next π_prev ι_prev).symm.trans
                  ((congrArg (· ≫ ι_prev) (CategoryTheory.Limits.kernel.condition π_prev)).trans
                    CategoryTheory.Limits.zero_comp))
            let f_inv : K_next ⟶ CategoryTheory.Limits.kernel (cechRepDiff w p) :=
              CategoryTheory.Limits.kernel.lift (cechRepDiff w p) ι_next h_ker_inv
            have h_ret : f_inv ≫ f_to = 𝟙 K_next := by
              apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι π_prev)).mp
              exact (CategoryTheory.Category.assoc f_inv f_to _).trans
                ((congrArg (f_inv ≫ ·) (CategoryTheory.Limits.kernel.lift_ι _ _ _)).trans
                  ((CategoryTheory.Limits.kernel.lift_ι _ _ _).trans
                    (CategoryTheory.Category.id_comp _).symm))
            have h_comp_eq : kl_diff ≫ f_to = π_next := by
              apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι π_prev)).mp
              exact (CategoryTheory.Category.assoc kl_diff f_to _).trans
                ((congrArg (kl_diff ≫ ·) (CategoryTheory.Limits.kernel.lift_ι _ _ _)).trans
                  ((CategoryTheory.Limits.kernel.lift_ι _ _ _).trans
                    (CategoryTheory.Limits.kernel.lift_ι _ _ _).symm))
