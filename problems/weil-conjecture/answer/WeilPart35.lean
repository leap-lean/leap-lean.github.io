              CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) k) := by rw [← hc₁]
        _ = (ℱ.obj.map w₁.op ≫ ℱ.obj.map ((stalkDiag.map f₁).unop).op) ≫
              CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) k := by
            rw [← CategoryTheory.Category.assoc]; rfl
        _ = ℱ.obj.map (((stalkDiag.map f₁).unop ≫ w₁).op) ≫
              CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) k := by
            rw [← ℱ.obj.map_comp]; rfl
        _ = ℱ.obj.map (((stalkDiag.map f₂).unop ≫ w₂).op) ≫
              CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) k := by rw [hfk]
