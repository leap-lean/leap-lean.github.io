      (φ : Quiver.Hom 𝒢₁ 𝒢₂),
      (∀ V : S.Etale,
        ∃ (ι : Type u) (U_fam : ι → S.Etale) (u_fam : ∀ i : ι, Quiver.Hom (U_fam i) V),
          CategoryTheory.Sieve.ofArrows U_fam u_fam ∈ S.smallEtaleTopology V ∧
          ∀ i : ι, Function.Bijective ⇑((φ.hom.app (Opposite.op (U_fam i))).hom)) →
      CategoryTheory.IsIso φ := by
    intro S 𝒢₁ 𝒢₂ φ hBasis
    let J := S.smallEtaleTopology
    let P₁ : CategoryTheory.Functor (Opposite S.Etale) (Type u) :=
      ((CategoryTheory.sheafForget J (D := AddCommGrpCat.{u})).obj 𝒢₁).obj
    let P₂ : CategoryTheory.Functor (Opposite S.Etale) (Type u) :=
      ((CategoryTheory.sheafForget J (D := AddCommGrpCat.{u})).obj 𝒢₂).obj
    have hCompat_res : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        {W : S.Etale} {ι : Type u} {U_fam : ι → S.Etale}
        (u_fam : ∀ i : ι, Quiver.Hom (U_fam i) W)
        (t : ↑(𝒢.obj.obj (Opposite.op W))),
        CategoryTheory.Presieve.Arrows.Compatible
          (((CategoryTheory.sheafForget J (D := AddCommGrpCat.{u})).obj 𝒢).obj) u_fam
          (fun i => ((𝒢.obj.map (Opposite.op (u_fam i))).hom) t) := by
      intro 𝒢 W ι U_fam u_fam t i j Z g₁ g₂ hg
      change ((𝒢.obj.map (Opposite.op (u_fam i)) ≫ 𝒢.obj.map (Opposite.op g₁)).hom) t =
        ((𝒢.obj.map (Opposite.op (u_fam j)) ≫ 𝒢.obj.map (Opposite.op g₂)).hom) t
      have h₁ := 𝒢.obj.map_comp (Opposite.op (u_fam i)) (Opposite.op g₁)
      have h₂ := 𝒢.obj.map_comp (Opposite.op (u_fam j)) (Opposite.op g₂)
      have hg_op : Opposite.op (g₁ ≫ u_fam i) = Opposite.op (g₂ ≫ u_fam j) :=
        congrArg Opposite.op hg
      exact (congrArg (fun m => m.hom t) h₁.symm).trans
        ((congrArg (fun k => (𝒢.obj.map k).hom t) hg_op).trans
          (congrArg (fun m => m.hom t) h₂))
    have hInj : ∀ W : S.Etale, Function.Injective ⇑((φ.hom.app (Opposite.op W)).hom) := by
      intro W x₁ x₂ hx
      obtain ⟨ι, U_fam, u_fam, hCov, hBij⟩ := hBasis W
      have hSh₁ : CategoryTheory.Presieve.IsSheafFor P₁
          (CategoryTheory.Presieve.ofArrows U_fam u_fam) :=
        (CategoryTheory.Presieve.isSheafFor_iff_generate
          (CategoryTheory.Presieve.ofArrows U_fam u_fam)).mpr
          (((CategoryTheory.sheafForget J (D := AddCommGrpCat.{u})).obj 𝒢₁).property.isSheafFor
            (CategoryTheory.Sieve.ofArrows U_fam u_fam) hCov)
      have h_res_eq : ∀ i : ι,
          ((𝒢₁.obj.map (Opposite.op (u_fam i))).hom) x₁ =
            ((𝒢₁.obj.map (Opposite.op (u_fam i))).hom) x₂ := by
        intro i
        apply (hBij i).1
        have hnat₁ := congrArg
          (fun m : 𝒢₁.obj.obj (Opposite.op W) ⟶ 𝒢₂.obj.obj (Opposite.op (U_fam i)) => m.hom x₁)
          (φ.hom.naturality (Opposite.op (u_fam i)))
        have hnat₂ := congrArg
          (fun m : 𝒢₁.obj.obj (Opposite.op W) ⟶ 𝒢₂.obj.obj (Opposite.op (U_fam i)) => m.hom x₂)
          (φ.hom.naturality (Opposite.op (u_fam i)))
        exact hnat₁.trans
          ((congrArg ((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) hx).trans hnat₂.symm)
      exact ((CategoryTheory.Presieve.isSheafFor_arrows_iff P₁ u_fam).mp hSh₁
        (fun i => ((𝒢₁.obj.map (Opposite.op (u_fam i))).hom) x₁)
        (hCompat_res 𝒢₁ u_fam x₁)).unique
        (fun _ => rfl) (fun i => (h_res_eq i).symm)
    have hSurj : ∀ V : S.Etale, Function.Surjective ⇑((φ.hom.app (Opposite.op V)).hom) := by
      intro V y
      obtain ⟨ι, U_fam, u_fam, hCov, hBij⟩ := hBasis V
      have hSh₁ : CategoryTheory.Presieve.IsSheafFor P₁
          (CategoryTheory.Presieve.ofArrows U_fam u_fam) :=
        (CategoryTheory.Presieve.isSheafFor_iff_generate
          (CategoryTheory.Presieve.ofArrows U_fam u_fam)).mpr
          (((CategoryTheory.sheafForget J (D := AddCommGrpCat.{u})).obj 𝒢₁).property.isSheafFor
            (CategoryTheory.Sieve.ofArrows U_fam u_fam) hCov)
      have hSh₂ : CategoryTheory.Presieve.IsSheafFor P₂
          (CategoryTheory.Presieve.ofArrows U_fam u_fam) :=
        (CategoryTheory.Presieve.isSheafFor_iff_generate
          (CategoryTheory.Presieve.ofArrows U_fam u_fam)).mpr
          (((CategoryTheory.sheafForget J (D := AddCommGrpCat.{u})).obj 𝒢₂).property.isSheafFor
            (CategoryTheory.Sieve.ofArrows U_fam u_fam) hCov)
      let loc_x : ∀ i : ι, P₁.obj (Opposite.op (U_fam i)) :=
        fun i => Classical.choose ((hBij i).2 (((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y))
      have hloc_x : ∀ i : ι,
          ((φ.hom.app (Opposite.op (U_fam i))).hom) (loc_x i) =
            ((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y :=
        fun i => Classical.choose_spec
          ((hBij i).2 (((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y))
      have hCompat_loc : CategoryTheory.Presieve.Arrows.Compatible P₁ u_fam loc_x := by
        intro i j Z g₁ g₂ hg
        apply hInj Z
        have hnat₁ := congrArg
          (fun m : 𝒢₁.obj.obj (Opposite.op (U_fam i)) ⟶ 𝒢₂.obj.obj (Opposite.op Z) =>
            m.hom (loc_x i))
          (φ.hom.naturality (Opposite.op g₁))
        have hnat₂ := congrArg
          (fun m : 𝒢₁.obj.obj (Opposite.op (U_fam j)) ⟶ 𝒢₂.obj.obj (Opposite.op Z) =>
            m.hom (loc_x j))
          (φ.hom.naturality (Opposite.op g₂))
        have h_res :
            ((𝒢₂.obj.map (Opposite.op g₁)).hom)
              (((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y) =
            ((𝒢₂.obj.map (Opposite.op g₂)).hom)
              (((𝒢₂.obj.map (Opposite.op (u_fam j))).hom) y) :=
          hCompat_res 𝒢₂ u_fam y i j Z g₁ g₂ hg
        exact hnat₁.trans
          ((congrArg ((𝒢₂.obj.map (Opposite.op g₁)).hom) (hloc_x i)).trans
            (h_res.trans
              ((congrArg ((𝒢₂.obj.map (Opposite.op g₂)).hom) (hloc_x j).symm).trans
                hnat₂.symm)))
      obtain ⟨t, ht, _⟩ :=
        (CategoryTheory.Presieve.isSheafFor_arrows_iff P₁ u_fam).mp hSh₁ loc_x hCompat_loc
      refine ⟨t, ?_⟩
      have h_phi_t : ∀ i : ι,
          ((𝒢₂.obj.map (Opposite.op (u_fam i))).hom)
            (((φ.hom.app (Opposite.op V)).hom) t) =
          ((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y := by
        intro i
        have hnat := congrArg
          (fun m : 𝒢₁.obj.obj (Opposite.op V) ⟶ 𝒢₂.obj.obj (Opposite.op (U_fam i)) => m.hom t)
          (φ.hom.naturality (Opposite.op (u_fam i))).symm
        exact hnat.trans
          ((congrArg ((φ.hom.app (Opposite.op (U_fam i))).hom) (ht i)).trans (hloc_x i))
      exact ((CategoryTheory.Presieve.isSheafFor_arrows_iff P₂ u_fam).mp hSh₂
        (fun i => ((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y)
        (hCompat_res 𝒢₂ u_fam y)).unique
        h_phi_t (fun _ => rfl)
    have : ∀ X : Opposite S.Etale, CategoryTheory.IsIso (φ.hom.app X) :=
      fun X => (CategoryTheory.ConcreteCategory.isIso_iff_bijective (φ.hom.app X)).mpr
        ⟨hInj (Opposite.unop X), hSurj (Opposite.unop X)⟩
    have : CategoryTheory.IsIso ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map φ) :=
      CategoryTheory.NatIso.isIso_of_isIso_app φ.hom
    exact CategoryTheory.isIso_of_reflects_iso φ
      (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u})

  
  have hCongr_inv_fst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      {f₁ f₂ : Quiver.Hom S₁ S₂} (heq : f₁ = f₂) (A : S₂.Etale),
      let e : @CategoryTheory.Iso (CategoryTheory.Functor S₂.Etale S₁.Etale) _
          (weilEtaleSitePullback f₁) (weilEtaleSitePullback f₂) :=
        CategoryTheory.MorphismProperty.Over.pullbackCongr heq
      (e.inv.app A).left ≫ CategoryTheory.Limits.pullback.fst A.hom f₁ =
        CategoryTheory.Limits.pullback.fst A.hom f₂ := by
    intro S₁ S₂ f₁ f₂ heq A e
    have h_hom := CategoryTheory.MorphismProperty.Over.pullbackCongr_hom_app_left_fst
      (P := @AlgebraicGeometry.Etale) (Q := ⊤) heq A
    have h_inv_hom : (e.inv.app A).left ≫ (e.hom.app A).left =
        CategoryTheory.CategoryStruct.id _ :=
      congrArg (fun m => m.left) (e.inv_hom_id_app A)
    exact (congrArg ((e.inv.app A).left ≫ ·) h_hom.symm).trans
      ((CategoryTheory.Category.assoc (e.inv.app A).left (e.hom.app A).left _).symm.trans
        ((congrArg (· ≫ _) h_inv_hom).trans (CategoryTheory.Category.id_comp _)))

  have hComp_inv_fst : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (f₁ : Quiver.Hom S₁ S₂) (f₂ : Quiver.Hom S₂ S₃) (A : S₃.Etale),
      let e : @CategoryTheory.Iso (CategoryTheory.Functor S₃.Etale S₁.Etale) _
          (weilEtaleSitePullback (f₁ ≫ f₂))
          (CategoryTheory.Functor.comp (weilEtaleSitePullback f₂) (weilEtaleSitePullback f₁)) :=
        CategoryTheory.MorphismProperty.Over.pullbackComp f₁ f₂
      (e.inv.app A).left ≫ CategoryTheory.Limits.pullback.fst A.hom (f₁ ≫ f₂) =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₂).obj A).hom f₁ ≫
          CategoryTheory.Limits.pullback.fst A.hom f₂ := by
    intro S₁ S₂ S₃ f₁ f₂ A e
    have h_hom := CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
      (P := @AlgebraicGeometry.Etale) (Q := ⊤) f₁ f₂ A
    have h_inv_hom : (e.inv.app A).left ≫ (e.hom.app A).left =
        CategoryTheory.CategoryStruct.id _ :=
      congrArg (fun m => m.left) (e.inv_hom_id_app A)
    exact (congrArg ((e.inv.app A).left ≫ ·) h_hom.symm).trans
      ((CategoryTheory.Category.assoc (e.inv.app A).left (e.hom.app A).left _).symm.trans
        ((congrArg (· ≫ _) h_inv_hom).trans (CategoryTheory.Category.id_comp _)))

  have hPull_map_fst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom S₁ S₂) {A B : S₂.Etale} (u : A ⟶ B),
      ((weilEtaleSitePullback f).map u).left ≫ CategoryTheory.Limits.pullback.fst B.hom f =
        CategoryTheory.Limits.pullback.fst A.hom f ≫ u.left := by
    intro S₁ S₂ f A B u
    have h_map := CategoryTheory.MorphismProperty.Over.pullback_map_left
      (@AlgebraicGeometry.Etale) ⊤ f u
    exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst B.hom f) h_map).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)

  have hSquare_inv_fst : ∀ {W₁ W₂ S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (g₂ : Quiver.Hom W₂ W₁) (f₁ : Quiver.Hom W₁ S₁)
      (f₂ : Quiver.Hom W₂ S₂) (g₁ : Quiver.Hom S₂ S₁)
      (hw : g₂ ≫ f₁ = f₂ ≫ g₁) (A : S₁.Etale),
      let e_sq : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
          (CategoryTheory.Functor.comp (weilEtaleSitePullback f₁) (weilEtaleSitePullback g₂))
          (CategoryTheory.Functor.comp (weilEtaleSitePullback g₁) (weilEtaleSitePullback f₂)) :=
        CategoryTheory.Iso.trans
          (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g₂ f₁))
          (CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr hw)
            (CategoryTheory.MorphismProperty.Over.pullbackComp f₂ g₁))
      ((e_sq.inv.app A).left ≫
          CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₁).obj A).hom g₂) ≫
        CategoryTheory.Limits.pullback.fst A.hom f₁ =
      CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback g₁).obj A).hom f₂ ≫
        CategoryTheory.Limits.pullback.fst A.hom g₁ := by
    intro W₁ W₂ S₁ S₂ g₂ f₁ f₂ g₁ hw A e_sq
    have h_hom₁ := CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
      (P := @AlgebraicGeometry.Etale) (Q := ⊤) g₂ f₁ A
    let i₁ : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
        (weilEtaleSitePullback (g₂ ≫ f₁))
        (CategoryTheory.Functor.comp (weilEtaleSitePullback f₁) (weilEtaleSitePullback g₂)) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp g₂ f₁
    let i₂ : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
        (weilEtaleSitePullback (g₂ ≫ f₁)) (weilEtaleSitePullback (f₂ ≫ g₁)) :=
      CategoryTheory.MorphismProperty.Over.pullbackCongr hw
    let i₃ : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
        (weilEtaleSitePullback (f₂ ≫ g₁))
        (CategoryTheory.Functor.comp (weilEtaleSitePullback g₁) (weilEtaleSitePullback f₂)) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp f₂ g₁
    have s₁ : ((e_sq.inv.app A).left ≫
          CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₁).obj A).hom g₂) ≫
        CategoryTheory.Limits.pullback.fst A.hom f₁ =
        (i₃.inv.app A).left ≫ (i₂.inv.app A).left ≫ ((i₁.hom.app A).left ≫
          CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₁).obj A).hom g₂ ≫
          CategoryTheory.Limits.pullback.fst A.hom f₁) :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((CategoryTheory.Category.assoc (i₃.inv.app A).left _ _).trans
          (congrArg ((i₃.inv.app A).left ≫ ·)
            (CategoryTheory.Category.assoc (i₂.inv.app A).left (i₁.hom.app A).left _)))
    have s₂ : (i₃.inv.app A).left ≫ (i₂.inv.app A).left ≫
          CategoryTheory.Limits.pullback.fst A.hom (g₂ ≫ f₁) =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback g₁).obj A).hom f₂ ≫
          CategoryTheory.Limits.pullback.fst A.hom g₁ :=
      (congrArg ((i₃.inv.app A).left ≫ ·) (hCongr_inv_fst hw A)).trans (hComp_inv_fst f₂ g₁ A)
    exact s₁.trans ((congrArg ((i₃.inv.app A).left ≫ (i₂.inv.app A).left ≫ ·) h_hom₁).trans s₂)

  let idPullIso : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      @CategoryTheory.Iso (CategoryTheory.Functor S.Etale S.Etale) _
        (weilEtaleSitePullback (CategoryTheory.CategoryStruct.id S))
        (CategoryTheory.Functor.id S.Etale) := fun S =>
    CategoryTheory.NatIso.ofComponents
      (fun U =>
        let l_inv := CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.id U.left) U.hom
          ((CategoryTheory.Category.id_comp U.hom).trans
            (CategoryTheory.Category.comp_id U.hom).symm)
        { hom := CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.fst U.hom (CategoryTheory.CategoryStruct.id S))
            ((CategoryTheory.Limits.pullback.condition
              (f := U.hom) (g := CategoryTheory.CategoryStruct.id S)).trans
              (CategoryTheory.Category.comp_id _))
          inv := CategoryTheory.MorphismProperty.Over.homMk l_inv
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          hom_inv_id := by
            refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
            let p_fst := CategoryTheory.Limits.pullback.fst U.hom
              (CategoryTheory.CategoryStruct.id S)
            let p_snd := CategoryTheory.Limits.pullback.snd U.hom
              (CategoryTheory.CategoryStruct.id S)
            change p_fst ≫ l_inv = CategoryTheory.CategoryStruct.id _
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact (CategoryTheory.Category.assoc p_fst l_inv p_fst).trans
                ((congrArg (p_fst ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((CategoryTheory.Category.comp_id p_fst).trans
                    (CategoryTheory.Category.id_comp p_fst).symm))
            · exact (CategoryTheory.Category.assoc p_fst l_inv p_snd).trans
                ((congrArg (p_fst ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.condition
                    (f := U.hom) (g := CategoryTheory.CategoryStruct.id S)).trans
                    ((CategoryTheory.Category.comp_id p_snd).trans
                      (CategoryTheory.Category.id_comp p_snd).symm)))
          inv_hom_id := by
            refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
            exact CategoryTheory.Limits.pullback.lift_fst _ _ _ })
      (fun {U₁ U₂} u => by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        exact hPull_map_fst (CategoryTheory.CategoryStruct.id S) u)

  
  have hTwistIso : ∀ {X₀ Y₀ X_bar Y_bar : AlgebraicGeometry.Scheme.{u}}
      (f₀ : Quiver.Hom X₀ Y₀) (pr_X : Quiver.Hom X_bar X₀) (pr_Y : Quiver.Hom Y_bar Y₀)
      (f_bar f_std : Quiver.Hom X_bar Y_bar)
      (e_X : CategoryTheory.Iso X_bar X_bar)
      (_he_f : e_X.hom ≫ f_std = f_bar)
      (_he_pr : e_X.hom ≫ pr_X = pr_X)
      (hf_comm : f_bar ≫ pr_Y = pr_X ≫ f₀)
      (hf_std_comm : f_std ≫ pr_Y = pr_X ≫ f₀)
      (hCont_X : (weilEtaleSitePullback pr_X).IsContinuous
        X₀.smallEtaleTopology X_bar.smallEtaleTopology)
      (hAdj_X : (@CategoryTheory.Functor.sheafPushforwardContinuous
        X₀.Etale _ X_bar.Etale _
        (weilEtaleSitePullback pr_X) AddCommGrpCat.{u} _
        X₀.smallEtaleTopology X_bar.smallEtaleTopology hCont_X).IsRightAdjoint)
      (hCont_Y : (weilEtaleSitePullback pr_Y).IsContinuous
        Y₀.smallEtaleTopology Y_bar.smallEtaleTopology)
      (hAdj_Y : (@CategoryTheory.Functor.sheafPushforwardContinuous
        Y₀.Etale _ Y_bar.Etale _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.smallEtaleTopology Y_bar.smallEtaleTopology hCont_Y).IsRightAdjoint)
      (hCont_f₀ : (weilEtaleSitePullback f₀).IsContinuous
        Y₀.smallEtaleTopology X₀.smallEtaleTopology)
      (hCont_fbar : (weilEtaleSitePullback f_bar).IsContinuous
        Y_bar.smallEtaleTopology X_bar.smallEtaleTopology)
      (hCont_std : (weilEtaleSitePullback f_std).IsContinuous
        Y_bar.smallEtaleTopology X_bar.smallEtaleTopology)
      (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      let L_prX := @CategoryTheory.Functor.sheafPullback
        X₀.Etale _ X_bar.Etale _
        (weilEtaleSitePullback pr_X) AddCommGrpCat.{u} _
        X₀.smallEtaleTopology X_bar.smallEtaleTopology hCont_X hAdj_X
      let adj_prX := @CategoryTheory.Functor.sheafAdjunctionContinuous
        X₀.Etale _ X_bar.Etale _
        (weilEtaleSitePullback pr_X) AddCommGrpCat.{u} _
        X₀.smallEtaleTopology X_bar.smallEtaleTopology hCont_X hAdj_X
      let adj_prY := @CategoryTheory.Functor.sheafAdjunctionContinuous
        Y₀.Etale _ Y_bar.Etale _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.smallEtaleTopology Y_bar.smallEtaleTopology hCont_Y hAdj_Y
      let P_f₀ := @CategoryTheory.Functor.sheafPushforwardContinuous
        Y₀.Etale _ X₀.Etale _
        (weilEtaleSitePullback f₀) AddCommGrpCat.{u} _
        Y₀.smallEtaleTopology X₀.smallEtaleTopology hCont_f₀
      let P_fbar := @CategoryTheory.Functor.sheafPushforwardContinuous
        Y_bar.Etale _ X_bar.Etale _
        (weilEtaleSitePullback f_bar) AddCommGrpCat.{u} _
        Y_bar.smallEtaleTopology X_bar.smallEtaleTopology hCont_fbar
      let P_std := @CategoryTheory.Functor.sheafPushforwardContinuous
        Y_bar.Etale _ X_bar.Etale _
        (weilEtaleSitePullback f_std) AddCommGrpCat.{u} _
        Y_bar.smallEtaleTopology X_bar.smallEtaleTopology hCont_std
      let e_fun : @CategoryTheory.Iso (CategoryTheory.Functor Y₀.Etale X_bar.Etale) _
          (CategoryTheory.Functor.comp (weilEtaleSitePullback f₀) (weilEtaleSitePullback pr_X))
