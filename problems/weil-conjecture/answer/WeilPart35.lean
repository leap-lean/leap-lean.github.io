  have hJoints : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q : ℕ),
      let v_q := weilEtaleHigherDirectImageMap f q SC.g
