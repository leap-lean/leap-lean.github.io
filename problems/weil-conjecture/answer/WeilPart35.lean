          rw [U_aff.map_comp, U_aff.map_comp, hg_map]
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          change (Fgt.map (w_k ≫ p_E)).left ≫ ubar₁ = (Fgt.map (w_k ≫ p_E)).left ≫ ubar₂
          rw [Fgt.map_comp]
          change ((Fgt.map w_k).left ≫ j_E') ≫ ubar₁ = ((Fgt.map w_k).left ≫ j_E') ≫ ubar₂
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hjE_eq]
        exact congrArg Opposite.op (Subtype.ext (hFF_Uaff.map_injective hU_eq))
    let F₁ : 𝒞_Z ⥤ ((Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    let F₂ : ((Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (PtNhdᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      (CategoryTheory.Functor.whiskeringLeft PtNhdᵒᵖ (Z.Etale)ᵒᵖ AddCommGrpCat.{u}).obj stalkDiag
    let F₃ : (PtNhdᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.Limits.colim
    let Stalk₀ : 𝒞_Z ⥤ AddCommGrpCat.{u} := F₁ ⋙ (F₂ ⋙ F₃)
    have hgerm_indep : ∀ (ℱ : 𝒞_Z) (U : Z.Etale) (γ : GeomLifts Z Ω₀ y₀ U)
        (i₁ i₂ : PtNhdᵒᵖ) (w₁ : (stalkDiag.obj i₁).unop ⟶ U) (w₂ : (stalkDiag.obj i₂).unop ⟶ U),
        geomLiftMap Z Ω₀ y₀ w₁ i₁.unop.2 = γ →
        geomLiftMap Z Ω₀ y₀ w₂ i₂.unop.2 = γ →
        ℱ.obj.map w₁.op ≫ CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) i₁ =
          ℱ.obj.map w₂.op ≫ CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) i₂ := by
      intro ℱ U γ i₁ i₂ w₁ w₂ hw₁ hw₂
      obtain ⟨k, f₁, f₂, hfk⟩ := hRefine U γ i₁ i₂ w₁ w₂ hw₁ hw₂
      have hc₁ := CategoryTheory.Limits.colimit.w (stalkDiag ⋙ ℱ.obj) f₁
      have hc₂ := CategoryTheory.Limits.colimit.w (stalkDiag ⋙ ℱ.obj) f₂
      calc
        ℱ.obj.map w₁.op ≫ CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) i₁
