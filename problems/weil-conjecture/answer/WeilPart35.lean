          change (S.obj.map v.op) ((S.obj.map u.op) s) = 0
          rw [hu, map_zero] }
    have hR_all : R_all ∈ X.smallEtaleTopology E := by
      refine (hMemEtale X E R_all).mpr fun z => ?_
      by_cases hz : E.hom.base z ∈ Set.range i₀.base
      · rw [hRange_i₀, Set.mem_singleton_iff] at hz
        obtain ⟨E', u, hu_et, ⟨y, hy⟩, hu_s⟩ := hLocalVanishIn E s z hz
        exact ⟨E', u, y, hu_s, hu_et, hy⟩
      · obtain ⟨E', u, hu_et, ⟨y, hy⟩, hu_s⟩ := hLocalVanishOut E s z hz
        exact ⟨E', u, y, hu_s, hu_et, hy⟩
    exact hSheafZero S E R_all hR_all s (fun _ hf => hf)

  · 
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

    have hStalkIsoPull : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
        [hc : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
        [hr : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
        (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (x : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S₁),
        Nonempty (((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology ⋙
          (ptOf S₁ Ω x).sheafFiber (A := AddCommGrpCat.{u})) ≅
          (ptOf S₂ Ω (x ≫ h)).sheafFiber (A := AddCommGrpCat.{u})) := by
      intro S₁ S₂ h hc hr Ω _ _ x
      let Φ₁ := ptOf S₁ Ω x
      let Φ₂ := ptOf S₂ Ω (x ≫ h)
      let B := weilEtaleSitePullback h
      let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ S₂.smallEtaleTopology S₁.smallEtaleTopology hc
      let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        B AddCommGrpCat.{u} _ S₂.smallEtaleTopology S₁.smallEtaleTopology hc hr
      let α : ∀ (E : S₂.Etale), Φ₁.fiber.obj (B.obj E) ≃ Φ₂.fiber.obj E := fun E =>
        { toFun := fun t =>
            ⟨t.1 ≫ CategoryTheory.Limits.pullback.fst E.hom h,
              (Category.assoc t.1 (CategoryTheory.Limits.pullback.fst E.hom h) E.hom).trans
                ((congrArg (t.1 ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                  ((Category.assoc t.1 (CategoryTheory.Limits.pullback.snd E.hom h) h).symm.trans
                    (congrArg (· ≫ h) t.2)))⟩
          invFun := fun s =>
            ⟨CategoryTheory.Limits.pullback.lift s.1 x s.2,
              CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
          left_inv := fun t => by
            apply Subtype.ext
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
            · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans t.2.symm
          right_inv := fun s => Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _) }
      have hα_symm : ∀ {E₁ E₂ : S₂.Etale} (u : E₁ ⟶ E₂) (s : Φ₂.fiber.obj E₁),
          (Φ₁.fiber.map (B.map u)) ((α E₁).symm s) =
            (α E₂).symm ((Φ₂.fiber.map u) s) := by
        intro E₁ E₂ u s
        apply Subtype.ext
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hB_fst : (B.map u).left ≫ CategoryTheory.Limits.pullback.fst E₂.hom h =
