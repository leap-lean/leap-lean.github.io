    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
    have hProp : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))))
      infer_instance
    have hIrrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) := by
      intro p hp
      have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hp_sum : (∑ i ∈ (DirectSum.decompose 𝒜 p).support,
          (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R)) = p :=
        DirectSum.sum_support_decompose 𝒜 p
      have hcoeff0 : p.coeff 0 = 0 := by
        rw [← hp_sum, MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro i _
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin (N + 1)) R) = 0 := hp0_proj
          rw [h0]; simp
        · have hhom_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜 p i).2
          by_contra hne0
          have hdeg0 := hhom_i hne0
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg0
          exact hi hdeg0.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro hm0
        subst hm0
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      have hex : ∃ a : Fin (N + 1), m a ≠ 0 := by
        by_contra hall
        exact hm_ne (Finsupp.ext fun a => Classical.not_not.mp fun h => hall ⟨a, h⟩)
      rcases hex with ⟨a, ha⟩
      exact ⟨a, Set.mem_univ a, ha⟩
    have hCov : (⨆ a : Fin (N + 1), weilProjBasicOpen R N a) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrel

    
    have hChartIso : ∀ a : Fin (N + 1),
        ∃ θ_a : MvPolynomial (Fin N) R ≃+*
            ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen R N a))),
          θ_a.toRingHom.comp MvPolynomial.C = c_R a ∧
          ∀ i : Fin N, θ_a (MvPolynomial.X i) = t_R a (a.succAbove i) := by
      intro a
      let X_a : MvPolynomial (Fin (N + 1)) R := MvPolynomial.X a
      let S_a : Submonoid (MvPolynomial (Fin (N + 1)) R) := Submonoid.powers X_a
      let ι_a : R →+* HomogeneousLocalization.Away 𝒜 X_a :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a).comp (algebraMap R ↥(𝒜 0))
      let t_tilde : Fin (N + 1) → HomogeneousLocalization.Away 𝒜 X_a :=
        fun b => HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) 1 (MvPolynomial.X b) (hX_mem b)
      let α_loc : MvPolynomial (Fin N) R →+* HomogeneousLocalization.Away 𝒜 X_a :=
        MvPolynomial.eval₂Hom ι_a (fun i : Fin N => t_tilde (a.succAbove i))
      let dehom : MvPolynomial (Fin (N + 1)) R →+* MvPolynomial (Fin N) R :=
        MvPolynomial.eval₂Hom MvPolynomial.C (a.insertNth (1 : MvPolynomial (Fin N) R) MvPolynomial.X)
      have hdehom_Xa : dehom X_a = 1 := by
        simp [dehom, X_a, Fin.insertNth_apply_same]
      have hdehom_S : ∀ y : S_a, dehom y.1 = 1 := by
        rintro ⟨_, n, rfl⟩
        simp [map_pow, hdehom_Xa]
      have hy_unit : ∀ y : S_a, IsUnit (dehom y.1) := fun y => by
        rw [hdehom_S y]; exact isUnit_one
      let β_loc : Localization S_a →+* MvPolynomial (Fin N) R := IsLocalization.lift hy_unit
      have hβ_loc_mk : ∀ (p : MvPolynomial (Fin (N + 1)) R) (y : S_a),
          β_loc (Localization.mk p y) = dehom p := by
        intro p y
        rw [Localization.mk_eq_mk']
        dsimp only [β_loc]
        rw [IsLocalization.lift_mk'_spec, hdehom_S y, one_mul]
      let valHom : HomogeneousLocalization.Away 𝒜 X_a →+* Localization S_a :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := fun u v => HomogeneousLocalization.val_mul u v
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := fun u v => HomogeneousLocalization.val_add u v }
      let β : HomogeneousLocalization.Away 𝒜 X_a →+* MvPolynomial (Fin N) R :=
        β_loc.comp valHom
      have hval_ι : ∀ r : R, (ι_a r).val = Localization.mk (MvPolynomial.C r) 1 := by
        intro r
        change (HomogeneousLocalization.mk
          ⟨0, algebraMap R ↥(𝒜 0) r, 1, Submonoid.one_mem S_a⟩).val =
          Localization.mk (MvPolynomial.C r) 1
        rw [HomogeneousLocalization.val_mk, halg0 r]
        rfl
      have hleft_loc : Function.LeftInverse β α_loc := by
        have hcomp : β.comp α_loc = RingHom.id (MvPolynomial (Fin N) R) := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            simp only [RingHom.comp_apply, RingHom.id_apply, α_loc, MvPolynomial.eval₂Hom_C,
              β, valHom, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, hval_ι, hβ_loc_mk,
              dehom]
          · intro i
            simp only [RingHom.comp_apply, RingHom.id_apply, α_loc, MvPolynomial.eval₂Hom_X',
              β, valHom, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, t_tilde,
              HomogeneousLocalization.Away.val_mk, hβ_loc_mk, dehom, Fin.insertNth_apply_succAbove]
        exact fun q => RingHom.congr_fun hcomp q
      have hright_loc : Function.RightInverse β α_loc := by
        intro z
        rcases subsingleton_or_nontrivial R with hSub | hNontriv
        · have _ : Subsingleton R := hSub
          apply HomogeneousLocalization.val_injective S_a
          exact Subsingleton.elim _ _
        · have _ : Nontrivial R := hNontriv
          let s_pow : ℕ → S_a := fun d => ⟨X_a ^ d, ⟨d, rfl⟩⟩
          let φ : MvPolynomial (Fin (N + 1)) R →+* Localization S_a :=
            valHom.comp (α_loc.comp dehom)
          have hφ_C : ∀ r : R, φ (MvPolynomial.C r) = Localization.mk (MvPolynomial.C r) 1 := by
            intro r
            simp [φ, dehom, α_loc, valHom, hval_ι]
          have hφ_X : ∀ b : Fin (N + 1),
              φ (MvPolynomial.X b) = Localization.mk (MvPolynomial.X b) (s_pow 1) := by
            intro b
            refine Fin.succAboveCases a ?_ ?_ b
            · simp only [φ, RingHom.comp_apply, dehom, MvPolynomial.eval₂Hom_X',
                Fin.insertNth_apply_same, map_one, X_a]
              have hs1 : s_pow 1 = ⟨X_a, Submonoid.mem_powers X_a⟩ := Subtype.ext (pow_one X_a)
              rw [hs1]
              exact (Localization.mk_self ⟨X_a, Submonoid.mem_powers X_a⟩).symm
            · intro i
              simp only [φ, RingHom.comp_apply, dehom, MvPolynomial.eval₂Hom_X',
                Fin.insertNth_apply_succAbove, α_loc, valHom, RingHom.coe_mk, MonoidHom.coe_mk,
                OneHom.coe_mk, t_tilde, HomogeneousLocalization.Away.val_mk]
              rfl
          have hφ_homog : ∀ (d : ℕ) (p : MvPolynomial (Fin (N + 1)) R),
