          (F := P_Y) (X := Opposite.op W_Y) z_Y 0
        have hRY_mem : R_Y ∈ J_Y W_Y :=
          CategoryTheory.Presheaf.equalizerSieve_mem J_Y η_Y z_Y 0 hηY_eq
        obtain ⟨W'_Y, u_Y, p', huY_arr, huY_et, huY_pt⟩ :=
          (hMemEtale Y W_Y R_Y).mp hRY_mem p₀
        have hzY_zero : (P_Y.map u_Y.op).hom z_Y = 0 :=
          huY_arr.trans (map_zero (P_Y.map u_Y.op).hom)

        let u : W'_Y.left ⟶ P := u_Y.left
        have hEt_E' : AlgebraicGeometry.Etale (u ≫ E_tilde.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            u E_tilde.hom huY_et hEt_Etilde
        let E' : X.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (u ≫ E_tilde.hom) hEt_E'
        let u_X : E' ⟶ E_tilde := CategoryTheory.MorphismProperty.Over.homMk u rfl
        let f_E' : E' ⟶ E := u_X ≫ g_P
        have hfE'_et : AlgebraicGeometry.Etale f_E'.left :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            u p_E huY_et hEt_pE
        have hfE'_pt : f_E'.left.base p' = e :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply u p_E p').trans
            ((congrArg p_E.base huY_pt).trans hp₀_E)
        refine ⟨E', f_E', p', ?_, hfE'_et, hfE'_pt⟩
        change (P_X.map f_E'.op).hom z = 0

        have hupV_X : (u ≫ p_V) ≫ e_X = E'.hom :=
          (CategoryTheory.Category.assoc u p_V e_X).trans (congrArg (u ≫ ·) hpV_X)
        have hupV_Y : (u ≫ p_V) ≫ e_Y = W'_Y.hom :=
          (CategoryTheory.Category.assoc u p_V e_Y).trans (CategoryTheory.MorphismProperty.Over.w u_Y)
        have hPb_X1 : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst (u ≫ p_V) j_V)
            (CategoryTheory.Limits.pullback.snd (u ≫ p_V) j_V ≫ e_XU)
            E'.hom j_X :=
          Eq.ndrec
            (motive := fun k => CategoryTheory.IsPullback
              (CategoryTheory.Limits.pullback.fst (u ≫ p_V) j_V)
              (CategoryTheory.Limits.pullback.snd (u ≫ p_V) j_V ≫ e_XU) k j_X)
            ((CategoryTheory.IsPullback.of_hasPullback (u ≫ p_V) j_V).paste_vert hSq1.flip)
            hupV_X
        have hPb_Y1 : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst (u ≫ p_V) j_V)
            (CategoryTheory.Limits.pullback.snd (u ≫ p_V) j_V ≫ e_YU)
            W'_Y.hom j_Y :=
          Eq.ndrec
            (motive := fun k => CategoryTheory.IsPullback
              (CategoryTheory.Limits.pullback.fst (u ≫ p_V) j_V)
              (CategoryTheory.Limits.pullback.snd (u ≫ p_V) j_V ≫ e_YU) k j_Y)
            ((CategoryTheory.IsPullback.of_hasPullback (u ≫ p_V) j_V).paste_vert hSq2.flip)
            hupV_Y
        let e_X1 := hPb_X1.isoPullback
        let e_Y1 := hPb_Y1.isoPullback
        let σ₁ : (B_jY.obj W'_Y).left ⟶ (B_jX.obj E').left := e_Y1.inv ≫ e_X1.hom
        let τ₁ : (B_jX.obj E').left ⟶ (B_jY.obj W'_Y).left := e_X1.inv ≫ e_Y1.hom
        have hτσ₁ : τ₁ ≫ σ₁ = CategoryTheory.CategoryStruct.id (B_jX.obj E').left :=
          (CategoryTheory.Category.assoc e_X1.inv e_Y1.hom (e_Y1.inv ≫ e_X1.hom)).trans
            ((congrArg (e_X1.inv ≫ ·)
              ((CategoryTheory.Category.assoc e_Y1.hom e_Y1.inv e_X1.hom).symm.trans
                ((congrArg (· ≫ e_X1.hom) e_Y1.hom_inv_id).trans
                  (CategoryTheory.Category.id_comp e_X1.hom)))).trans
              e_X1.inv_hom_id)
        let m_u : CategoryTheory.Limits.pullback (u ≫ p_V) j_V ⟶
            CategoryTheory.Limits.pullback p_V j_V :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (u ≫ p_V) j_V ≫ u)
            (CategoryTheory.Limits.pullback.snd (u ≫ p_V) j_V)
            ((CategoryTheory.Category.assoc _ u p_V).trans
              CategoryTheory.Limits.pullback.condition)
        have hm_X : e_X1.hom ≫ (B_jX.map u_X).left = m_u ≫ e_X0.hom := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hfst : (B_jX.map u_X).left ≫
                CategoryTheory.Limits.pullback.fst E_tilde.hom j_X =
                CategoryTheory.Limits.pullback.fst E'.hom j_X ≫ u :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            exact (CategoryTheory.Category.assoc e_X1.hom (B_jX.map u_X).left _).trans
              ((congrArg (e_X1.hom ≫ ·) hfst).trans
                ((CategoryTheory.Category.assoc e_X1.hom _ u).symm.trans
                  ((congrArg (· ≫ u) hPb_X1.isoPullback_hom_fst).trans
                    ((CategoryTheory.Limits.pullback.lift_fst _ _ _).symm.trans
                      ((congrArg (m_u ≫ ·) hPb_X0.isoPullback_hom_fst.symm).trans
                        (CategoryTheory.Category.assoc m_u e_X0.hom _).symm)))))
          · have hsnd : (B_jX.map u_X).left ≫
                CategoryTheory.Limits.pullback.snd E_tilde.hom j_X =
                CategoryTheory.Limits.pullback.snd E'.hom j_X :=
              CategoryTheory.Limits.pullback.lift_snd _ _ _
            exact (CategoryTheory.Category.assoc e_X1.hom (B_jX.map u_X).left _).trans
              ((congrArg (e_X1.hom ≫ ·) hsnd).trans
                (hPb_X1.isoPullback_hom_snd.trans
                  ((congrArg (· ≫ e_XU) (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm).trans
                    ((CategoryTheory.Category.assoc m_u _ e_XU).trans
                      ((congrArg (m_u ≫ ·) hPb_X0.isoPullback_hom_snd.symm).trans
                        (CategoryTheory.Category.assoc m_u e_X0.hom _).symm)))))
        have hm_Y : e_Y1.hom ≫ (B_jY.map u_Y).left = m_u ≫ e_Y0.hom := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hfst : (B_jY.map u_Y).left ≫
                CategoryTheory.Limits.pullback.fst W_Y.hom j_Y =
                CategoryTheory.Limits.pullback.fst W'_Y.hom j_Y ≫ u :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            exact (CategoryTheory.Category.assoc e_Y1.hom (B_jY.map u_Y).left _).trans
              ((congrArg (e_Y1.hom ≫ ·) hfst).trans
                ((CategoryTheory.Category.assoc e_Y1.hom _ u).symm.trans
                  ((congrArg (· ≫ u) hPb_Y1.isoPullback_hom_fst).trans
                    ((CategoryTheory.Limits.pullback.lift_fst _ _ _).symm.trans
                      ((congrArg (m_u ≫ ·) hPb_Y0.isoPullback_hom_fst.symm).trans
                        (CategoryTheory.Category.assoc m_u e_Y0.hom _).symm)))))
          · have hsnd : (B_jY.map u_Y).left ≫
                CategoryTheory.Limits.pullback.snd W_Y.hom j_Y =
                CategoryTheory.Limits.pullback.snd W'_Y.hom j_Y :=
              CategoryTheory.Limits.pullback.lift_snd _ _ _
            exact (CategoryTheory.Category.assoc e_Y1.hom (B_jY.map u_Y).left _).trans
              ((congrArg (e_Y1.hom ≫ ·) hsnd).trans
                (hPb_Y1.isoPullback_hom_snd.trans
                  ((congrArg (· ≫ e_YU) (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm).trans
                    ((CategoryTheory.Category.assoc m_u _ e_YU).trans
                      ((congrArg (m_u ≫ ·) hPb_Y0.isoPullback_hom_snd.symm).trans
                        (CategoryTheory.Category.assoc m_u e_Y0.hom _).symm)))))
        have hm_Y_inv : e_Y1.inv ≫ m_u = (B_jY.map u_Y).left ≫ e_Y0.inv :=
          (CategoryTheory.Category.comp_id (e_Y1.inv ≫ m_u)).symm.trans
            ((congrArg ((e_Y1.inv ≫ m_u) ≫ ·) e_Y0.hom_inv_id.symm).trans
              ((CategoryTheory.Category.assoc (e_Y1.inv ≫ m_u) e_Y0.hom e_Y0.inv).symm.trans
                ((congrArg (· ≫ e_Y0.inv)
                  ((CategoryTheory.Category.assoc e_Y1.inv m_u e_Y0.hom).trans
                    ((congrArg (e_Y1.inv ≫ ·) hm_Y.symm).trans
                      ((CategoryTheory.Category.assoc e_Y1.inv e_Y1.hom _).symm.trans
                        ((congrArg (· ≫ (B_jY.map u_Y).left) e_Y1.inv_hom_id).trans
                          (CategoryTheory.Category.id_comp _)))))))))
        have hsq_σ : σ₁ ≫ (B_jX.map u_X).left = (B_jY.map u_Y).left ≫ σ₀ :=
          (CategoryTheory.Category.assoc e_Y1.inv e_X1.hom (B_jX.map u_X).left).trans
            ((congrArg (e_Y1.inv ≫ ·) hm_X).trans
              ((CategoryTheory.Category.assoc e_Y1.inv m_u e_X0.hom).symm.trans
                ((congrArg (· ≫ e_X0.hom) hm_Y_inv).trans
                  (CategoryTheory.Category.assoc (B_jY.map u_Y).left e_Y0.inv e_X0.hom))))

        obtain ⟨p_σ₁, hp_σ₁⟩ := hPullEx σ₁ ℓ b
        obtain ⟨p_τ₁, hp_τ₁⟩ := hPullEx τ₁ ℓ b
        obtain ⟨p_uX, hp_uX⟩ := hPullEx (B_jX.map u_X).left ℓ b
        obtain ⟨p_uY, hp_uY⟩ := hPullEx (B_jY.map u_Y).left ℓ b
        obtain ⟨p_comp, hp_comp⟩ := hPullEx (σ₁ ≫ (B_jX.map u_X).left) ℓ b
        have hp_comp_lhs : p_comp = p_σ₁.comp p_uX :=
          hPullComp σ₁ (B_jX.map u_X).left ℓ b p_σ₁ p_uX p_comp hp_σ₁ hp_uX hp_comp
        have hp_comp_rhs_wt : WeilIsTorsionEtalePullback ((B_jY.map u_Y).left ≫ σ₀) ℓ b p_comp :=
          Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ b p_comp) hsq_σ) hp_comp
        have hp_comp_rhs : p_comp = p_uY.comp p_σ₀ :=
          hPullComp (B_jY.map u_Y).left σ₀ ℓ b p_uY p_σ₀ p_comp hp_uY hp_σ₀ hp_comp_rhs_wt
        obtain ⟨p_id, hp_id⟩ := hPullEx (τ₁ ≫ σ₁) ℓ b
        have hp_id_comp : p_id = p_τ₁.comp p_σ₁ :=
          hPullComp τ₁ σ₁ ℓ b p_τ₁ p_σ₁ p_id hp_τ₁ hp_σ₁ hp_id
        have hp_id_wt : WeilIsTorsionEtalePullback
            (CategoryTheory.CategoryStruct.id (B_jX.obj E').left) ℓ b p_id :=
          Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ b p_id) hτσ₁) hp_id
        have hp_id_eq : p_id = AddMonoidHom.id _ :=
          hPullId ℓ b p_id hp_id_wt

        have hpuY_ξ : p_uY ξ_Y = 0 :=
          (congrArg p_uY ((Θ_U (B_jY.obj W_Y)).apply_symm_apply ξ_Y).symm).trans
            ((hΘ_U (B_jY.map u_Y) p_uY hp_uY z_Y).symm.trans
              ((congrArg (Θ_U (B_jY.obj W'_Y)) hzY_zero).trans
                (map_zero (Θ_U (B_jY.obj W'_Y)))))
        let w_E' := Θ_XU (B_jX.obj E') ((P_X.map u_X.op).hom z₁)
        have hpσ₁_w : p_σ₁ w_E' = 0 :=
          (congrArg p_σ₁ (hΘ_XU (B_jX.map u_X) p_uX hp_uX z₁)).trans
            ((congrFun (congrArg DFunLike.coe hp_comp_lhs.symm)
                (Θ_XU (B_jX.obj E_tilde) z₁)).trans
              ((congrFun (congrArg DFunLike.coe hp_comp_rhs)
                  (Θ_XU (B_jX.obj E_tilde) z₁)).trans hpuY_ξ))
        have hw_E'_zero : w_E' = 0 :=
          (congrFun (congrArg DFunLike.coe hp_id_eq.symm) w_E').trans
            ((congrFun (congrArg DFunLike.coe hp_id_comp) w_E').trans
              ((congrArg p_τ₁ hpσ₁_w).trans (map_zero p_τ₁)))
        have huX_z₁_zero : (P_X.map u_X.op).hom z₁ = 0 :=
          (Θ_XU (B_jX.obj E')).injective
            (hw_E'_zero.trans (map_zero (Θ_XU (B_jX.obj E'))).symm)
        have hmap_fE' : P_X.map f_E'.op = P_X.map g_P.op ≫ P_X.map u_X.op :=
          (congrArg P_X.map (hop_comp u_X g_P)).trans (P_X.map_comp g_P.op u_X.op)
        exact (congrArg (fun φ => φ.hom z) hmap_fE').trans huX_z₁_zero

      exact F_X.isSeparated E R_zero hR_mem (η_X.app (Opposite.op E) z) 0 (fun E' g hg => by
        change (F_X.obj.map g.op) (η_X.app (Opposite.op E) z) = (F_X.obj.map g.op) 0
        rw [map_zero]
        have hnat := congrArg (fun k => k z) (η_X.naturality g.op)
        have hlhs : (P_X.map g.op ≫ η_X.app (Opposite.op E')) z = 0 := by
          change (η_X.app (Opposite.op E')).hom ((P_X.map g.op).hom z) = 0
          rw [hg, map_zero]
        exact hnat.symm.trans hlhs)

    have hid_zero : 𝟙 F_X = 0 := by
      have htri : (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).map η_X ≫
          adj_shX.counit.app F_X = 𝟙 F_X :=
        adj_shX.left_triangle_components P_X
      rw [← htri, hη_X_zero, CategoryTheory.Functor.map_zero, CategoryTheory.Limits.zero_comp]
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    exact hid_zero

  
  
  
  have hTruncLeray : ∀ {Z_U Z : AlgebraicGeometry.Scheme.{u}} (π : Z_U ⟶ Z)
      [_hc : (weilEtaleSitePullback π).IsContinuous
        Z.smallEtaleTopology Z_U.smallEtaleTopology]
      [_hr : ((weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology Z_U.smallEtaleTopology).IsRightAdjoint],
      let B_π := weilEtaleSitePullback π
      let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology Z_U.smallEtaleTopology
      let pb_π := B_π.sheafPullback AddCommGrpCat.{u}
        Z.smallEtaleTopology Z_U.smallEtaleTopology
      let adj_π := B_π.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology Z_U.smallEtaleTopology
      let Fℤ_U := (CategoryTheory.constantSheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      ∀ [_hAdd : pb_π.Additive]
        [_hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_π]
        [_hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_π]
        (ιℤ : Fℤ_U ⟶ pb_π.obj Fℤ_Z)
        (πℤ : pb_π.obj Fℤ_Z ⟶ Fℤ_U),
        ιℤ ≫ πℤ = CategoryTheory.CategoryStruct.id Fℤ_U →
        πℤ ≫ ιℤ = CategoryTheory.CategoryStruct.id (pb_π.obj Fℤ_Z) →
        ∀ (G_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          (G_U : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u})
          (α : G_Z ⟶ pf_π.obj G_U),
          CategoryTheory.IsIso α →
          ∀ (n_cut : ℕ),
            (∀ (b : ℕ), 1 ≤ b → b ≤ n_cut →
              CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π b G_U)) →
            let Λ_π := fun (r : ℕ) (z : G_Z.H r) =>
              (CategoryTheory.Abelian.Ext.mk₀ ((adj_π.homEquiv G_Z G_U).symm α)).postcomp
                Fℤ_U (Nat.add_zero r)
                ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_π _ _ _ _ _
                    Fℤ_Z G_Z r) z)
                  (Nat.zero_add r))
            (∀ (r : ℕ), r ≤ n_cut → Function.Bijective (Λ_π r)) ∧
            (∀ (r : ℕ), r ≤ n_cut + 1 → Function.Injective (Λ_π r)) := by
    intro Z_U Z π _hc _hr B_π pf_π pb_π adj_π Fℤ_U Fℤ_Z _hAdd _hLim _hColim
      ιℤ πℤ hιπ hπι G_Z G_U α hIso_α n_cut hZero_GU Λ_π
    let Φ_map : ∀ {A : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        {B : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}}
        (_τ : pb_π.obj A ⟶ B) (r : ℕ), A.H r →+ B.H r :=
      fun {A B} τ r =>
        ((CategoryTheory.Abelian.Ext.mk₀ τ).postcomp Fℤ_U (Nat.add_zero r)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_π.obj A) (Nat.zero_add r)).comp
            (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_π _ _ _ _ _ Fℤ_Z A r))
    have hΦ_nat : ∀ {A₁ A₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        {B₁ B₂ : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}}
        (f_Z : A₁ ⟶ A₂) (f_U : B₁ ⟶ B₂)
        (τ₁ : pb_π.obj A₁ ⟶ B₁) (τ₂ : pb_π.obj A₂ ⟶ B₂),
        τ₁ ≫ f_U = pb_π.map f_Z ≫ τ₂ →
        ∀ (r : ℕ) (z : A₁.H r),
          (Φ_map τ₁ r z).comp (CategoryTheory.Abelian.Ext.mk₀ f_U) (Nat.add_zero r) =
            Φ_map τ₂ r (z.comp (CategoryTheory.Abelian.Ext.mk₀ f_Z) (Nat.add_zero r)) := by
      intro A₁ A₂ B₁ B₂ f_Z f_U τ₁ τ₂ hcomm r z
      change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π z) (Nat.zero_add r)).comp
          (CategoryTheory.Abelian.Ext.mk₀ τ₁) (Nat.add_zero r)).comp
          (CategoryTheory.Abelian.Ext.mk₀ f_U) (Nat.add_zero r) =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π
            (z.comp (CategoryTheory.Abelian.Ext.mk₀ f_Z) (Nat.add_zero r)))
          (Nat.zero_add r)).comp
          (CategoryTheory.Abelian.Ext.mk₀ τ₂) (Nat.add_zero r)
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hcomm,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π z)
          (CategoryTheory.Abelian.Ext.mk₀ (pb_π.map f_Z)) (Nat.zero_add r),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]

    let leray_π : ∀ (G : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}) (r : ℕ),
        (pf_π.obj G).H r →+ G.H r :=
      fun G r => Φ_map (adj_π.counit.app G) r

    
    have hLeray0 : ∀ (G : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}),
        Function.Bijective (leray_π G 0) := by
      intro G
      let inv₀ : G.H 0 → (pf_π.obj G).H 0 := fun u =>
        CategoryTheory.Abelian.Ext.mk₀
          ((adj_π.homEquiv Fℤ_Z G) (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u))
      have h_eval : ∀ w : (pf_π.obj G).H 0,
          leray_π G 0 w =
            CategoryTheory.Abelian.Ext.mk₀
              (ιℤ ≫ (adj_π.homEquiv Fℤ_Z G).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w)) := by
        intro w
        let f : Fℤ_Z ⟶ pf_π.obj G := CategoryTheory.Abelian.Ext.addEquiv₀ w
        have hw : CategoryTheory.Abelian.Ext.mk₀ f = w :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply w
        change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π w) (Nat.zero_add 0)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj_π.counit.app G)) (Nat.add_zero 0) =
          CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ (adj_π.homEquiv Fℤ_Z G).symm f)
        rw [← hw, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Category.assoc,
          CategoryTheory.Adjunction.homEquiv_counit]
      refine Function.bijective_iff_has_inverse.mpr ⟨inv₀, ?_, ?_⟩
      · intro w
        rw [h_eval w]
        dsimp [inv₀]
        have h_mk : CategoryTheory.Abelian.Ext.addEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀
              (ιℤ ≫ (adj_π.homEquiv Fℤ_Z G).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w))) =
            ιℤ ≫ (adj_π.homEquiv Fℤ_Z G).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w) := by
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rw [h_mk, ← CategoryTheory.Category.assoc, hπι, CategoryTheory.Category.id_comp,
          Equiv.apply_symm_apply, CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
      · intro u
        rw [h_eval (inv₀ u)]
        dsimp [inv₀]
        have h_mk : CategoryTheory.Abelian.Ext.addEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀
              ((adj_π.homEquiv Fℤ_Z G) (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u))) =
            (adj_π.homEquiv Fℤ_Z G) (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u) := by
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rw [h_mk, Equiv.symm_apply_apply, ← CategoryTheory.Category.assoc, hιπ,
          CategoryTheory.Category.id_comp, CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]

    
    have hSurj_inj : ∀ (I : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective I] (k : ℕ),
        Function.Surjective (leray_π I k) := by
      intro I _ k
      cases k with
      | zero => exact (hLeray0 I).2
      | succ m =>
        intro x
        exact ⟨0, (map_zero (leray_π I (m + 1))).trans
          (CategoryTheory.Abelian.Ext.eq_zero_of_injective x).symm⟩

    
    have hMonoPostInj0 : ∀ {W P : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (i_W : W ⟶ P) [CategoryTheory.Mono i_W],
        Function.Injective
          ((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_Z (Nat.add_zero 0)) := by
      intro W P i_W _ w₁ w₂ hw
      let f₁ : Fℤ_Z ⟶ W := CategoryTheory.Abelian.Ext.addEquiv₀ w₁
      let f₂ : Fℤ_Z ⟶ W := CategoryTheory.Abelian.Ext.addEquiv₀ w₂
      have hw₁ : CategoryTheory.Abelian.Ext.mk₀ f₁ = w₁ :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply w₁
      have hw₂ : CategoryTheory.Abelian.Ext.mk₀ f₂ = w₂ :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply w₂
      change w₁.comp (CategoryTheory.Abelian.Ext.mk₀ i_W) (Nat.add_zero 0) =
        w₂.comp (CategoryTheory.Abelian.Ext.mk₀ i_W) (Nat.add_zero 0) at hw
      rw [← hw₁, ← hw₂, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hw
      have hf_comp : f₁ ≫ i_W = f₂ ≫ i_W := by
        have h1 := congrArg CategoryTheory.Abelian.Ext.addEquiv₀ hw
        rwa [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply] at h1
      have hf_eq : f₁ = f₂ := (CategoryTheory.cancel_mono i_W).mp hf_comp
      rw [← hw₁, ← hw₂, hf_eq]

    
    have hLadder : ∀ (SC_top : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE_top : SC_top.ShortExact) [CategoryTheory.Injective SC_top.X₂]
        (SC_bot : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE_bot : SC_bot.ShortExact) [CategoryTheory.Injective SC_bot.X₂]
        (τ : SC_top.map pb_π ⟶ SC_bot) (k : ℕ),
        (Function.Surjective (Φ_map τ.τ₂ k) →
          Function.Injective (Φ_map τ.τ₃ k) →
          Function.Injective (Φ_map τ.τ₁ (k + 1))) ∧
        (Function.Surjective (Φ_map τ.τ₃ k) →
          Function.Surjective (Φ_map τ.τ₁ (k + 1))) := by
      intro SC_top hSE_top _ SC_bot hSE_bot _ τ k
      let hSE_pb : (SC_top.map pb_π).ShortExact := hSE_top.map_of_exact pb_π
      have h_ext_nat :
          hSE_pb.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ τ.τ₁) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ τ.τ₃).comp hSE_bot.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb hSE_bot τ
      have hΦ_δ : ∀ w : SC_top.X₃.H k,
          Φ_map τ.τ₁ (k + 1) (w.comp hSE_top.extClass rfl) =
            (Φ_map τ.τ₃ k w).comp hSE_bot.extClass rfl := by
        intro w
        change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π (w.comp hSE_top.extClass rfl))
            (Nat.zero_add (k + 1))).comp
            (CategoryTheory.Abelian.Ext.mk₀ τ.τ₁) (Nat.add_zero (k + 1)) =
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π w) (Nat.zero_add k)).comp
            (CategoryTheory.Abelian.Ext.mk₀ τ.τ₃) (Nat.add_zero k)).comp
            hSE_bot.extClass rfl
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          ← CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π w)
            hSE_pb.extClass (Nat.zero_add k) rfl (Nat.zero_add (k + 1)),
          CategoryTheory.Abelian.Ext.comp_assoc _
            hSE_pb.extClass
            (CategoryTheory.Abelian.Ext.mk₀ τ.τ₁)
            rfl (Nat.add_zero 1) (Nat.add_zero (k + 1)),
          h_ext_nat,
          ← CategoryTheory.Abelian.Ext.comp_assoc _
            (CategoryTheory.Abelian.Ext.mk₀ τ.τ₃)
            hSE_bot.extClass (Nat.add_zero k) (Nat.zero_add 1) rfl]
      refine ⟨?_, ?_⟩
      · intro hSurj₂ hInj₃
        rw [injective_iff_map_eq_zero]
        intro y hy
        have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ SC_top.f)
            (Nat.add_zero (k + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨w, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Z hSE_top y hy0 rfl
        have hw0 : (Φ_map τ.τ₃ k w).comp hSE_bot.extClass rfl = 0 := by
          rw [← hΦ_δ w, hy]
        obtain ⟨v₂, hv₂⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_U hSE_bot
            (Φ_map τ.τ₃ k w) rfl hw0
        obtain ⟨z₂, rfl⟩ := hSurj₂ v₂
        have hcomm₂₃ : τ.τ₂ ≫ SC_bot.g = pb_π.map SC_top.g ≫ τ.τ₃ := τ.comm₂₃
        have hw_eq : w = z₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC_top.g) (Nat.add_zero k) :=
          hInj₃ ((hΦ_nat SC_top.g SC_bot.g τ.τ₂ τ.τ₃ hcomm₂₃ k z₂).symm.trans hv₂).symm
        rw [hw_eq, CategoryTheory.Abelian.Ext.comp_assoc z₂
          (CategoryTheory.Abelian.Ext.mk₀ SC_top.g) hSE_top.extClass
          (Nat.add_zero k) (Nat.zero_add 1) rfl,
          hSE_top.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro hSurj₃ x
        have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC_bot.f)
            (Nat.add_zero (k + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨u, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_U hSE_bot x hx0 rfl
        obtain ⟨w, rfl⟩ := hSurj₃ u
        exact ⟨w.comp hSE_top.extClass rfl, hΦ_δ w⟩

    
    have hLeray_trunc : ∀ (m_cut : ℕ)
        (G : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (b : ℕ), 1 ≤ b → b ≤ m_cut →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π b G)) →
        (∀ (r : ℕ), r ≤ m_cut → Function.Bijective (leray_π G r)) ∧
        (∀ (r : ℕ), r ≤ m_cut + 1 → Function.Injective (leray_π G r)) := by
      intro m_cut
      induction m_cut with
      | zero =>
        intro G _
        refine ⟨?_, ?_⟩
        · intro r hr
          have hr0 : r = 0 := Nat.eq_zero_of_le_zero hr
          subst hr0
          exact hLeray0 G
        · intro r hr
          rcases r with _ | r
          · exact (hLeray0 G).1
          · have hr0 : r = 0 := by omega
            subst hr0
            let I := CategoryTheory.Injective.under G
            let ι_G : G ⟶ I := CategoryTheory.Injective.ι G
            let Q := CategoryTheory.Limits.cokernel ι_G
            let p_Q : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι_G
            let SC := CategoryTheory.ShortComplex.mk ι_G p_Q
              (CategoryTheory.Limits.cokernel.condition ι_G)
            have hSE : SC.ShortExact :=
              { exact := CategoryTheory.ShortComplex.exact_cokernel ι_G }
            letI : pf_π.Additive :=
              CategoryTheory.Functor.additive_of_preserves_binary_products pf_π
            letI : CategoryTheory.Limits.PreservesFiniteLimits pf_π :=
              ⟨fun _ _ _ => inferInstance⟩
            obtain ⟨hEx_pf, hMono_f'⟩ :=
              (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_π).mp
                inferInstance SC hSE
            let f' : pf_π.obj G ⟶ pf_π.obj I := (SC.map pf_π).f
            let g' : pf_π.obj I ⟶ pf_π.obj Q := (SC.map pf_π).g
            haveI : CategoryTheory.Mono f' := hMono_f'
            let W := CategoryTheory.Limits.cokernel f'
            let p_W : pf_π.obj I ⟶ W := CategoryTheory.Limits.cokernel.π f'
            let SC_W := CategoryTheory.ShortComplex.mk f' p_W
              (CategoryTheory.Limits.cokernel.condition f')
            have hSE_W : SC_W.ShortExact :=
              { exact := CategoryTheory.ShortComplex.exact_cokernel f' }
            let i_W : W ⟶ pf_π.obj Q :=
              CategoryTheory.Limits.cokernel.desc f' g' (SC.map pf_π).zero
            have hi_W : p_W ≫ i_W = g' :=
              CategoryTheory.Limits.cokernel.π_desc f' g' (SC.map pf_π).zero
            haveI : CategoryTheory.Mono i_W :=
              CategoryTheory.ShortComplex.Exact.mono_cokernelDesc hEx_pf
            haveI : CategoryTheory.Injective SC_W.X₂ :=
              CategoryTheory.Injective.injective_of_adjoint adj_π I
            let τ_W : SC_W.map pb_π ⟶ SC :=
              { τ₁ := adj_π.counit.app G
                τ₂ := adj_π.counit.app I
                τ₃ := pb_π.map i_W ≫ adj_π.counit.app Q
                comm₁₂ := (adj_π.counit.naturality ι_G).symm
                comm₂₃ := by
                  change adj_π.counit.app I ≫ p_Q =
                    pb_π.map p_W ≫ (pb_π.map i_W ≫ adj_π.counit.app Q)
                  rw [← CategoryTheory.Category.assoc (pb_π.map p_W), ← pb_π.map_comp, hi_W]
                  exact (adj_π.counit.naturality p_Q).symm }
            have hInj_τ3 : Function.Injective (Φ_map τ_W.τ₃ 0) := by
              have hfun : ⇑(Φ_map τ_W.τ₃ 0) =
                  ⇑(leray_π Q 0) ∘
                    ⇑((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_Z (Nat.add_zero 0)) := by
                funext w
                have h1 := hΦ_nat i_W (𝟙 Q) (pb_π.map i_W ≫ adj_π.counit.app Q)
                  (adj_π.counit.app Q) (CategoryTheory.Category.comp_id _) 0 w
                exact (CategoryTheory.Abelian.Ext.comp_mk₀_id (Φ_map τ_W.τ₃ 0 w)).symm.trans h1
              rw [hfun]
              exact (hLeray0 Q).1.comp (hMonoPostInj0 i_W)
            exact (hLadder SC_W hSE_W SC hSE τ_W 0).1 (hSurj_inj I 0) hInj_τ3
      | succ m_cut ih =>
        intro G hZero_G
        let I := CategoryTheory.Injective.under G
        let ι_G : G ⟶ I := CategoryTheory.Injective.ι G
        let Q := CategoryTheory.Limits.cokernel ι_G
        let p_Q : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι_G
        let SC := CategoryTheory.ShortComplex.mk ι_G p_Q
          (CategoryTheory.Limits.cokernel.condition ι_G)
        have hSE : SC.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_cokernel ι_G }
        have hI_acyc : ∀ p : ℕ, 1 ≤ p →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π p I) :=
          fun p hp => hInjHDIZero π I p hp
        have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong
            (@AlgebraicGeometry.Etale) π :=
          CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
            (@AlgebraicGeometry.Etale) π :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg =>
              CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
        let B_raw : CategoryTheory.Functor Z.Etale Z_U.Etale :=
          CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ π
        have _ : B_raw.IsContinuous Z.smallEtaleTopology Z_U.smallEtaleTopology := _hc
        have _ : (B_raw.sheafPushforwardContinuous AddCommGrpCat.{u}
          Z.smallEtaleTopology Z_U.smallEtaleTopology).IsRightAdjoint := _hr
        have hCalc := (weil_etale_higherDirectImage_shortExact_calculus π).2.2 SC hSE hI_acyc
        have hSE_pf : (SC.map pf_π).ShortExact :=
          hCalc.1.2 (hZero_G 1 (le_refl 1) (Nat.le_add_left 1 m_cut))
        have hZero_Q : ∀ (b : ℕ), 1 ≤ b → b ≤ m_cut →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π b Q) :=
          fun b hb1 hbm =>
            hCalc.2.2 b hb1
              (hZero_G (b + 1) (Nat.le_add_left 1 b) (Nat.add_le_add_right hbm 1))
        obtain ⟨ih_bij, ih_inj⟩ := ih Q hZero_Q
        haveI : CategoryTheory.Injective (SC.map pf_π).X₂ :=
          CategoryTheory.Injective.injective_of_adjoint adj_π I
        let τ_c : (SC.map pf_π).map pb_π ⟶ SC :=
          { τ₁ := adj_π.counit.app G
            τ₂ := adj_π.counit.app I
            τ₃ := adj_π.counit.app Q
            comm₁₂ := (adj_π.counit.naturality SC.f).symm
            comm₂₃ := (adj_π.counit.naturality SC.g).symm }
        refine ⟨?_, ?_⟩
        · intro r hr
          cases r with
          | zero => exact hLeray0 G
          | succ k =>
            have hk : k ≤ m_cut := Nat.le_of_succ_le_succ hr
            exact ⟨(hLadder (SC.map pf_π) hSE_pf SC hSE τ_c k).1 (hSurj_inj I k) (ih_bij k hk).1,
              (hLadder (SC.map pf_π) hSE_pf SC hSE τ_c k).2 (ih_bij k hk).2⟩
        · intro r hr
          cases r with
          | zero => exact (hLeray0 G).1
          | succ k =>
            have hk : k ≤ m_cut + 1 := Nat.le_of_succ_le_succ hr
            exact (hLadder (SC.map pf_π) hSE_pf SC hSE τ_c k).1 (hSurj_inj I k) (ih_inj k hk)

    
    have hΛ_fac : ∀ r : ℕ,
        Λ_π r =
          ⇑(leray_π G_U r) ∘
            ⇑((CategoryTheory.Abelian.Ext.mk₀ α).postcomp Fℤ_Z (Nat.add_zero r)) := by
      intro r
      funext z
      have hcomm : (adj_π.homEquiv G_Z G_U).symm α ≫ 𝟙 G_U =
          pb_π.map α ≫ adj_π.counit.app G_U :=
        (CategoryTheory.Category.comp_id _).trans
          (CategoryTheory.Adjunction.homEquiv_counit adj_π G_Z G_U α)
      have h1 := hΦ_nat α (𝟙 G_U) ((adj_π.homEquiv G_Z G_U).symm α)
        (adj_π.counit.app G_U) hcomm r z
      exact (CategoryTheory.Abelian.Ext.comp_mk₀_id (Λ_π r z)).symm.trans h1
    have hPost_bij : ∀ r : ℕ,
        Function.Bijective
          ((CategoryTheory.Abelian.Ext.mk₀ α).postcomp Fℤ_Z (Nat.add_zero r)) := by
      intro r
      let α_inv := @CategoryTheory.inv _ _ _ _ α hIso_α
      refine Function.bijective_iff_has_inverse.mpr
        ⟨(CategoryTheory.Abelian.Ext.mk₀ α_inv).postcomp Fℤ_Z (Nat.add_zero r), ?_, ?_⟩
      · intro z
        change (z.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero r)).comp
          (CategoryTheory.Abelian.Ext.mk₀ α_inv) (Nat.add_zero r) = z
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      · intro w
        change (w.comp (CategoryTheory.Abelian.Ext.mk₀ α_inv) (Nat.add_zero r)).comp
          (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero r) = w
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    obtain ⟨hBij_leray, hInj_leray⟩ := hLeray_trunc n_cut G_U hZero_GU
    refine ⟨?_, ?_⟩
    · intro r hr
      rw [hΛ_fac r]
      exact (hBij_leray r hr).comp (hPost_bij r)
    · intro r hr
      rw [hΛ_fac r]
      exact (hInj_leray r hr).comp (hPost_bij r).1

  
  
  
  have hPointRoof : ∀ x : ↥X,
      ∃ (Y U V V_U : AlgebraicGeometry.Scheme.{u})
        (j_Y : U ⟶ Y)
        (e_X : V ⟶ X) (_ : AlgebraicGeometry.Etale e_X)
        (e_Y : V ⟶ Y) (_ : AlgebraicGeometry.Etale e_Y)
        (e_XU : V_U ⟶ X_U) (j_V : V_U ⟶ V) (e_YU : V_U ⟶ U),
        x ∈ Set.range e_X.base ∧
        CategoryTheory.IsPullback e_XU j_V j_X e_X ∧
        CategoryTheory.IsPullback e_YU j_V j_Y e_Y ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
          (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Y w) ℓ 0),
          WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Y w) ℓ 0 ψ₀ →
          Function.Bijective ψ₀) ∧
        (∀ (b : ℕ), 1 ≤ b → b ≤ N →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage j_Y b (weilEtaleTorsionSheaf U ℓ))) := by
    intro x
    by_cases hx : x ∈ Set.range j_X.base
    · obtain ⟨V, _, e_X, hEt_eX, e_XU, hEt_eXU, hx_V, hSq_X, hSq_Y, hBij0_id, hZero_id⟩ :=
        hOpenRoof x hx
      exact ⟨X_U, X_U, V, V, CategoryTheory.CategoryStruct.id X_U, e_X, hEt_eX, e_XU, hEt_eXU,
        e_XU, CategoryTheory.CategoryStruct.id V, e_XU, hx_V, hSq_X, hSq_Y,
        hBij0_id, fun b hb1 _ => hZero_id b hb1⟩
    · let K_x : Type u := AlgebraicClosure ↑(X.residueField x)
      let z_bar : AlgebraicGeometry.Spec (CommRingCat.of K_x) ⟶ X :=
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (↑(X.residueField x)) K_x)) ≫
        X.fromSpecResidueField x
      have hz_eq : z_bar.base (⊥ : PrimeSpectrum K_x) = x := by
        have hmem : z_bar.base (⊥ : PrimeSpectrum K_x) ∈
            Set.range (X.fromSpecResidueField x).base :=
          ⟨(AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑(X.residueField x)) K_x))).base
            (⊥ : PrimeSpectrum K_x), rfl⟩
        rw [AlgebraicGeometry.Scheme.range_fromSpecResidueField x] at hmem
        exact Set.mem_singleton_iff.mp hmem
      have hz_not : z_bar.base (⊥ : PrimeSpectrum K_x) ∉ Set.range j_X.base :=
        hz_eq.symm ▸ hx
      obtain ⟨Y, U, V, V_U, _, j_Y, e_X, hEt_eX, e_Y, hEt_eY, e_XU, j_V, e_YU,
        hz_mem, hSq_X, hSq_Y, hBij0_Y, hZero_Y⟩ := hRoofAtlas K_x z_bar hz_not
      rw [hz_eq] at hz_mem
      exact ⟨Y, U, V, V_U, j_Y, e_X, hEt_eX, e_Y, hEt_eY, e_XU, j_V, e_YU,
        hz_mem, hSq_X, hSq_Y, hBij0_Y, hZero_Y⟩

  have hAtlas0 : ∀ x : ↥X,
      ∃ (Y U V V_U : AlgebraicGeometry.Scheme.{u})
        (j_Y : U ⟶ Y)
        (e_X : V ⟶ X) (_ : AlgebraicGeometry.Etale e_X)
        (e_Y : V ⟶ Y) (_ : AlgebraicGeometry.Etale e_Y)
        (e_XU : V_U ⟶ X_U) (j_V : V_U ⟶ V) (e_YU : V_U ⟶ U),
        x ∈ Set.range e_X.base ∧
        CategoryTheory.IsPullback e_XU j_V j_X e_X ∧
        CategoryTheory.IsPullback e_YU j_V j_Y e_Y ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
          (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Y w) ℓ 0),
          WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Y w) ℓ 0 ψ₀ →
          Function.Bijective ψ₀) := by
    intro x
    obtain ⟨Y, U, V, V_U, j_Y, e_X, hEt_eX, e_Y, hEt_eY, e_XU, j_V, e_YU,
      hx_V, hSq_X, hSq_Y, hBij0_Y, _⟩ := hPointRoof x
    exact ⟨Y, U, V, V_U, j_Y, e_X, hEt_eX, e_Y, hEt_eY, e_XU, j_V, e_YU,
      hx_V, hSq_X, hSq_Y, hBij0_Y⟩

  have hZero_jX : ∀ (b : ℕ), 1 ≤ b → b ≤ N →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j_X b (weilEtaleTorsionSheaf X_U ℓ)) := by
    intro b hb1 hbN
    refine hRoofHDIZero b (fun x => ?_)
    obtain ⟨Y, U, V, V_U, j_Y, e_X, hEt_eX, e_Y, hEt_eY, e_XU, j_V, e_YU,
      hx_V, hSq_X, hSq_Y, _, hZero_Y⟩ := hPointRoof x
    exact ⟨Y, U, V, V_U, j_Y, e_X, hEt_eX, e_Y, hEt_eY, e_XU, j_V, e_YU,
      hx_V, hSq_X, hSq_Y, hZero_Y b hb1 hbN⟩

  have hBoth : ∀ (r : ℕ)
      (ψ_r : weilEtaleTorsionH X ℓ r →+ weilEtaleTorsionH X_U ℓ r),
      WeilIsTorsionEtalePullback j_X ℓ r ψ_r →
      (r ≤ N → Function.Bijective ψ_r) ∧ (r ≤ N + 1 → Function.Injective ψ_r) := by
    intro r ψ_r hψ_r
    rcases hψ_r with ⟨hc, hr_adj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hψ_eq⟩
    letI := hc
    letI := hr_adj
    letI := hAdd
    letI := hLim
    letI := hColim
    let B_jX := weilEtaleSitePullback j_X
    let pf_jX := B_jX.sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X_U.smallEtaleTopology
    let pb_jX := B_jX.sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology X_U.smallEtaleTopology
    let adj_jX := B_jX.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X_U.smallEtaleTopology
    let Fℤ_XU := (CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let G_X := weilEtaleTorsionSheaf X ℓ
    let G_XU := weilEtaleTorsionSheaf X_U ℓ
    let adj₁ := CategoryTheory.constantSheafAdj X_U.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT₂
    let τ := hT₁.from (B_jX.obj T₂)
    let πℤ : pb_jX.obj Fℤ_X ⟶ Fℤ_XU :=
      (adj_jX.homEquiv Fℤ_X Fℤ_XU).symm
        ((adj₂.homEquiv Aℤ (pf_jX.obj Fℤ_XU)).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
            (Fℤ_XU.obj.map (Opposite.op τ))))
    let α_X : G_X ⟶ pf_jX.obj G_XU :=
      (adj₂.homEquiv AM (pf_jX.obj G_XU)).symm
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
          (G_XU.obj.map (Opposite.op τ)))
    have hIso_α : CategoryTheory.IsIso α_X := hRoofConstIso hT₁ hT₂ hAtlas0
    obtain ⟨hBij_le, hInj_le⟩ :=
      hTruncLeray j_X ιℤ πℤ hιπ hπι G_X G_XU α_X hIso_α N hZero_jX
    have hψ_fun : ⇑ψ_r = _ := funext hψ_eq
    refine ⟨fun hr => ?_, fun hr => ?_⟩
    · rw [hψ_fun]
      exact hBij_le r hr
    · rw [hψ_fun]
      exact hInj_le r hr

  exact ⟨fun r hr ψ_r hψ_r => (hBoth r ψ_r hψ_r).1 hr,
    fun r hr ψ_r hψ_r => (hBoth r ψ_r hψ_r).2 hr⟩

theorem weil_proj_quadric_val_ring_pbc_henselian_pullback_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (Y S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    (f : Y ⟶ S) [AlgebraicGeometry.IsProper f.left]
    (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsAlgClosed (IsLocalRing.ResidueField A)]
    (g_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ S.left)
    (K : Type u) [Field K] [IsAlgClosed K]
    (u_A : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A))
    (hu_A : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)),
      u_A.base pt = IsLocalRing.closedPoint A)
    (u_Y : CategoryTheory.Limits.pullback f.left (u_A ≫ g_A) ⟶
      CategoryTheory.Limits.pullback f.left g_A)
    (hu_fst : u_Y ≫ CategoryTheory.Limits.pullback.fst f.left g_A =
      CategoryTheory.Limits.pullback.fst f.left (u_A ≫ g_A))
    (hu_snd : u_Y ≫ CategoryTheory.Limits.pullback.snd f.left g_A =
      CategoryTheory.Limits.pullback.snd f.left (u_A ≫ g_A) ≫ u_A)
    (i : ℕ)
    (ψ_i : weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left g_A) ℓ i →+
      weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left (u_A ≫ g_A)) ℓ i) :
    WeilIsTorsionEtalePullback u_Y ℓ i ψ_i →
    Function.Bijective ψ_i :=
by
  
  have hS4 : WeilCanonicalModPrimePBC ℓ f.left := by
    clear * - hℓ
    obtain ⟨_, hComp, hCancel, hAffineLoc, hArrowIso⟩ :=
      weil_pbc_canonical_calculus_and_extraction.{u} ℓ
    obtain ⟨hIsoP0, hVieta⟩ := weil_vieta_binary_form_cover_projSpace.{u} k
    have hLFT_Proj : ∀ N : ℕ,
        AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      intro N
      dsimp [weilProjectiveSpaceOver]
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
        intro p
        have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero]
          exact p.2
        obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
        exact ⟨c, Subtype.ext hc⟩
      have _ : Nontrivial ↥(𝒜 0) :=
        ⟨⟨0, Submodule.zero_mem _⟩, ⟨1, SetLike.GradedOne.one_mem⟩,
          fun h => zero_ne_one (congrArg Subtype.val h)⟩
      have hInj₀ : Function.Injective (algebraMap k ↥(𝒜 0)) := RingHom.injective _
      have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
        (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mpr ⟨hInj₀, hSurj₀⟩
      have _ : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
        inferInstance
      have _ : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) _ _ _ _ _ _
          (fun _ => rfl)
      have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
      exact inferInstance
    have hProj_PBC : ∀ (N : ℕ)
        (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType B.hom],
        WeilCanonicalModPrimePBC ℓ
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) := by
      intro N
      induction N with
      | zero =>
        intro B _
        have _ : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom := hIsoP0
        have _ : AlgebraicGeometry.IsFinite (weilProjectiveSpaceOver k 0).hom := inferInstance
        have _ : AlgebraicGeometry.IsFinite
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom) :=
          inferInstance
        exact weil_pbc_finite_morphism ℓ _
      | succ m ih =>
        intro B _
        let P_m := weilProjectiveSpaceOver k m
        let P_1 := weilProjectiveSpaceOver k 1
        let P_succ := weilProjectiveSpaceOver k (m + 1)
        have _ : AlgebraicGeometry.LocallyOfFiniteType P_m.hom := hLFT_Proj m
        let p_mB := CategoryTheory.Limits.pullback.fst B.hom P_m.hom
        have _ : AlgebraicGeometry.LocallyOfFiniteType p_mB := inferInstance
        let B_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (p_mB ≫ B.hom)
        have _ : AlgebraicGeometry.LocallyOfFiniteType B_m.hom := by
          change AlgebraicGeometry.LocallyOfFiniteType (p_mB ≫ B.hom)
          infer_instance
        let p_1Bm := CategoryTheory.Limits.pullback.fst B_m.hom P_1.hom
        have hp1 : WeilCanonicalModPrimePBC ℓ p_1Bm := by
          apply hAffineLoc p_1Bm
          intro U hU
          let U_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
            CategoryTheory.Over.mk (U.ι ≫ B_m.hom)
          have _ : AlgebraicGeometry.IsAffine U_ov.left := hU
          have _ : AlgebraicGeometry.LocallyOfFiniteType U_ov.hom := by
            change AlgebraicGeometry.LocallyOfFiniteType (U.ι ≫ B_m.hom)
            infer_instance
          have hU_pbc := weil_pbc_projLine_over_affine_finiteType k ℓ hℓ U_ov
          let V_U : (CategoryTheory.Limits.pullback B_m.hom P_1.hom).Opens :=
            (TopologicalSpace.Opens.map p_1Bm.base).obj U
          have hpb_res : CategoryTheory.IsPullback (p_1Bm ∣_ U) V_U.ι U.ι p_1Bm :=
            AlgebraicGeometry.isPullback_morphismRestrict p_1Bm U
          have hpb_tot : CategoryTheory.IsPullback
              (p_1Bm ∣_ U)
              (V_U.ι ≫ CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
              U_ov.hom P_1.hom :=
            hpb_res.paste_vert (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom)
          refine hArrowIso (p_1Bm ∣_ U)
            (CategoryTheory.Limits.pullback.fst U_ov.hom P_1.hom)
            hpb_tot.isoPullback (CategoryTheory.Iso.refl U.toScheme) ?_ hU_pbc
          rw [hpb_tot.isoPullback_hom_fst, CategoryTheory.Iso.refl_hom,
            CategoryTheory.Category.comp_id]
        have hComp_m1 : WeilCanonicalModPrimePBC ℓ (p_1Bm ≫ p_mB) :=
          hComp p_1Bm p_mB hp1 (ih B)
        obtain ⟨μ, hFin_μ, hSurj_μ, hComm_μ⟩ := hVieta m
        have _ : AlgebraicGeometry.IsFinite μ := hFin_μ
        have _ : AlgebraicGeometry.Surjective μ := hSurj_μ
        let q_m1 := CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom ≫ P_m.hom
        let μ_B : CategoryTheory.Limits.pullback B.hom q_m1 ⟶
            CategoryTheory.Limits.pullback B.hom P_succ.hom :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst B.hom q_m1)
            (CategoryTheory.Limits.pullback.snd B.hom q_m1 ≫ μ)
            (by rw [CategoryTheory.Category.assoc, hComm_μ];
                exact CategoryTheory.Limits.pullback.condition)
        have hpb_μB_out : CategoryTheory.IsPullback
            (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
            (CategoryTheory.Limits.pullback.snd B.hom q_m1)
            B.hom (μ ≫ P_succ.hom) := by
          have hfst : μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom =
              CategoryTheory.Limits.pullback.fst B.hom q_m1 :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [hfst, hComm_μ]
          exact CategoryTheory.IsPullback.of_hasPullback B.hom q_m1
        have hpb_μB : CategoryTheory.IsPullback
            μ_B (CategoryTheory.Limits.pullback.snd B.hom q_m1)
            (CategoryTheory.Limits.pullback.snd B.hom P_succ.hom) μ :=
          CategoryTheory.IsPullback.of_right hpb_μB_out
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            (CategoryTheory.IsPullback.of_hasPullback B.hom P_succ.hom)
        have _ : AlgebraicGeometry.IsFinite μ_B :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            hpb_μB.flip inferInstance
        have hSurj_μB : AlgebraicGeometry.Surjective μ_B :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            hpb_μB.flip inferInstance
        have hPBC_μB : WeilCanonicalModPrimePBC ℓ μ_B := weil_pbc_finite_morphism ℓ μ_B
        have h_lift_fst_comp : ∀ {W X Y Z V : AlgebraicGeometry.Scheme.{u}}
            {f₁ : X ⟶ Z} {f₂ : Y ⟶ Z} (a : W ⟶ X) (b : W ⟶ Y) (h : a ≫ f₁ = b ≫ f₂)
            (c : X ⟶ V),
            CategoryTheory.Limits.pullback.lift a b h ≫
              (CategoryTheory.Limits.pullback.fst f₁ f₂ ≫ c) = a ≫ c :=
          fun a b h c =>
            (CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ c) (CategoryTheory.Limits.pullback.lift_fst a b h))
        have h_lift_snd_comp : ∀ {W X Y Z V : AlgebraicGeometry.Scheme.{u}}
            {f₁ : X ⟶ Z} {f₂ : Y ⟶ Z} (a : W ⟶ X) (b : W ⟶ Y) (h : a ≫ f₁ = b ≫ f₂)
            (d : Y ⟶ V),
            CategoryTheory.Limits.pullback.lift a b h ≫
              (CategoryTheory.Limits.pullback.snd f₁ f₂ ≫ d) = b ≫ d :=
          fun a b h d =>
            (CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ d) (CategoryTheory.Limits.pullback.lift_snd a b h))
        let l_hom1 : CategoryTheory.Limits.pullback B.hom q_m1 ⟶ B_m.left :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst B.hom q_m1)
            (CategoryTheory.Limits.pullback.snd B.hom q_m1 ≫
              CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom)
            (by rw [CategoryTheory.Category.assoc];
                exact CategoryTheory.Limits.pullback.condition)
        let e_hom : CategoryTheory.Limits.pullback B.hom q_m1 ⟶
            CategoryTheory.Limits.pullback B_m.hom P_1.hom :=
          CategoryTheory.Limits.pullback.lift l_hom1
            (CategoryTheory.Limits.pullback.snd B.hom q_m1 ≫
              CategoryTheory.Limits.pullback.snd P_m.hom P_1.hom)
            (by
              dsimp [B_m, p_mB, l_hom1]
              rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
              exact (CategoryTheory.Limits.pullback.condition (f := B.hom) (g := q_m1)).trans
                ((congrArg (CategoryTheory.Limits.pullback.snd B.hom q_m1 ≫ ·)
                    (CategoryTheory.Limits.pullback.condition (f := P_m.hom) (g := P_1.hom))).trans
                  (CategoryTheory.Category.assoc _ _ _).symm))
        let l_inv2 : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
            CategoryTheory.Limits.pullback P_m.hom P_1.hom :=
          CategoryTheory.Limits.pullback.lift
            (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
            (CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
            (by
              rw [CategoryTheory.Category.assoc,
                ← CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom)]
              exact CategoryTheory.Limits.pullback.condition (f := B_m.hom) (g := P_1.hom))
        let e_inv : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
            CategoryTheory.Limits.pullback B.hom q_m1 :=
          CategoryTheory.Limits.pullback.lift (p_1Bm ≫ p_mB) l_inv2
            (by
              dsimp [q_m1, p_mB, l_inv2]
              rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.lift _ _ _),
                CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc p_1Bm,
                CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom),
                CategoryTheory.Category.assoc])
        let e_assoc : CategoryTheory.Limits.pullback B.hom q_m1 ≅
            CategoryTheory.Limits.pullback B_m.hom P_1.hom :=
          { hom := e_hom
            inv := e_inv
            hom_inv_id := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · exact (CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (e_hom ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    ((h_lift_fst_comp _ _ _ _).trans
                      ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                        (CategoryTheory.Category.id_comp _).symm)))
              · have h_snd : (e_hom ≫ e_inv) ≫ CategoryTheory.Limits.pullback.snd B.hom q_m1 =
                    e_hom ≫ l_inv2 :=
                  (CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg (e_hom ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))
                refine h_snd.trans ((?_ : e_hom ≫ l_inv2 = _).trans
                  (CategoryTheory.Category.id_comp _).symm)
                apply CategoryTheory.Limits.pullback.hom_ext
                · exact (CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (e_hom ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                      ((h_lift_fst_comp _ _ _ _).trans
                        (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
                · exact (CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (e_hom ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                      (CategoryTheory.Limits.pullback.lift_snd _ _ _))
            inv_hom_id := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · have h_fst : (e_inv ≫ e_hom) ≫ CategoryTheory.Limits.pullback.fst B_m.hom P_1.hom =
                    e_inv ≫ l_hom1 :=
                  (CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg (e_inv ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))
                refine h_fst.trans ((?_ : e_inv ≫ l_hom1 = _).trans
                  (CategoryTheory.Category.id_comp _).symm)
                apply CategoryTheory.Limits.pullback.hom_ext
                · exact (CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (e_inv ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _))
                · exact (CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (e_inv ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                      ((h_lift_snd_comp _ _ _ _).trans
                        (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
              · exact (CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (e_inv ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                    ((h_lift_snd_comp _ _ _ _).trans
                      ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                        (CategoryTheory.Category.id_comp _).symm))) }
        have hPBC_comp : WeilCanonicalModPrimePBC ℓ
            (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom) := by
          refine hArrowIso
            (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
            (p_1Bm ≫ p_mB) e_assoc (CategoryTheory.Iso.refl B.left) ?_ hComp_m1
          exact (h_lift_fst_comp _ _ _ _).trans
            ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
              ((CategoryTheory.Limits.pullback.lift_fst _ _ _).symm.trans
                (CategoryTheory.Category.comp_id _).symm))
        exact hCancel μ_B (CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
          hSurj_μB hPBC_μB hPBC_comp
    apply hAffineLoc f.left
    intro U hU
    let S_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (U.ι ≫ S.hom)
    have _ : AlgebraicGeometry.IsAffine S_U.left := hU
    have _ : AlgebraicGeometry.LocallyOfFiniteType S_U.hom := by
      change AlgebraicGeometry.LocallyOfFiniteType (U.ι ≫ S.hom)
      infer_instance
    let V_fU : Y.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj U
    let Y_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (V_fU.ι ≫ Y.hom)
    let f_U : Y_U ⟶ S_U :=
      CategoryTheory.Over.homMk (f.left ∣_ U)
        (by
          dsimp [S_U, Y_U]
          rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            CategoryTheory.Category.assoc, CategoryTheory.Over.w f])
    have _ : AlgebraicGeometry.IsProper f_U.left :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict f.left U).flip inferInstance
    have _ : AlgebraicGeometry.LocallyOfFiniteType f_U.left := inferInstance
    have _ : AlgebraicGeometry.LocallyOfFiniteType Y_U.hom := by
      have hw : f_U.left ≫ S_U.hom = Y_U.hom := CategoryTheory.Over.w f_U
      rw [← hw]
