import WeilPart34
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_sm_pencil_algClosed_spec_sheafify_unit_and_repToConst_bij (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (P : CategoryTheory.Functor
        (Opposite (AlgebraicGeometry.Spec (CommRingCat.of k)).Etale) AddCommGrpCat.{u}),
      let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
      let T_k := weilEtaleIdTerminal.{u} S_k
      Function.Bijective
        ((((CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology
            AddCommGrpCat.{u}).unit.app P).app (Opposite.op T_k)).hom)) ∧
    (∀ (Y : AlgebraicGeometry.Scheme.{u})
        (T : Y.Etale) (hT : CategoryTheory.Limits.IsTerminal T)
        (𝒢 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Function.Bijective (weilPolyP1CohomologyTermToPresheaf Y T hT 𝒢 q)) :=
by
  refine ⟨?_, ?_⟩
  · have hBijHelper : ∀ (C : Type u) [Field C] (θ : k →+* C),
        θ.FiniteType → Function.Bijective θ := by
      intro C _ θ hθ
      letI : Algebra k C := θ.toAlgebra
      have hFT : Algebra.FiniteType k C := hθ
      obtain ⟨m, q_mv, hq_surj⟩ :=
        (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := C)).mp hFT
      let I : Ideal (MvPolynomial (Fin m) k) := RingHom.ker q_mv.toRingHom
      have hIsField : IsField (MvPolynomial (Fin m) k ⧸ I) :=
        (RingHom.quotientKerEquivOfSurjective hq_surj).toMulEquiv.isField (Field.toIsField C)
      have hIMax : I.IsMaximal :=
        (Ideal.Quotient.maximal_ideal_iff_isField_quotient I).mpr hIsField
      obtain ⟨pt, hI_eq⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := I)).mp hIMax
      refine ⟨θ.injective, fun y => ?_⟩
      obtain ⟨Q, rfl⟩ := hq_surj y
      let c : k := MvPolynomial.aeval pt Q
      have hmem_van : Q - algebraMap k (MvPolynomial (Fin m) k) c ∈
          MvPolynomial.vanishingIdeal k {pt} := by
        rw [MvPolynomial.mem_vanishingIdeal_singleton_iff, map_sub, AlgHom.commutes]
        exact sub_self c
      have hmem_ker : Q - algebraMap k (MvPolynomial (Fin m) k) c ∈ RingHom.ker q_mv.toRingHom := by
        rwa [← hI_eq] at hmem_van
      rw [RingHom.mem_ker] at hmem_ker
      change q_mv (Q - algebraMap k (MvPolynomial (Fin m) k) c) = 0 at hmem_ker
      rw [map_sub, AlgHom.commutes] at hmem_ker
      exact ⟨c, (sub_eq_zero.mp hmem_ker).symm⟩
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k := weilEtaleIdTerminal.{u} S_k
    have hSec : ∀ (W : AlgebraicGeometry.Scheme.{u}), Nonempty ↥W →
        ∀ (f : W ⟶ S_k), AlgebraicGeometry.Etale f →
          ∃ g : S_k ⟶ W, g ≫ f = 𝟙 S_k := by
      intro W hNE_W f hf
      have : AlgebraicGeometry.Etale f := hf
      let A_cat : CommRingCat.{u} := S_k.presheaf.obj (Opposite.op ⊤)
      let e_k : A_cat ≅ CommRingCat.of k := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
      have hSurj_ek : Function.Surjective e_k.inv.hom := by
        intro a
        refine ⟨e_k.hom.hom a, ?_⟩
        change (e_k.hom ≫ e_k.inv).hom a = a
        rw [e_k.hom_inv_id]
        rfl
      have hIsoFT : e_k.inv.hom.FiniteType :=
        RingHom.FiniteType.of_surjective _ hSurj_ek
      obtain ⟨y₀⟩ := hNE_W
      obtain ⟨V, hAffV, hy₀, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show y₀ ∈ (⊤ : W.Opens) from trivial)
      let B_cat : CommRingCat.{u} := W.presheaf.obj (Opposite.op V)
      let B := ↑B_cat
      have hSpecB : Nonempty (PrimeSpectrum B) := ⟨hAffV.isoSpec.hom.base ⟨y₀, hy₀⟩⟩
      have : Nontrivial B := by
        by_contra hSub
        rw [not_nontrivial_iff_subsingleton] at hSub
        exact isEmpty_iff.mp (inferInstance : IsEmpty (PrimeSpectrum B)) hSpecB.some
      obtain ⟨𝔫, h𝔫_max⟩ := Ideal.exists_maximal B
      have : 𝔫.IsMaximal := h𝔫_max
      letI : Field (B ⧸ 𝔫) := Ideal.Quotient.field 𝔫
      let ψ_cat : A_cat ⟶ B_cat := f.appLE ⊤ V le_top
      have hψ_FT : ψ_cat.hom.FiniteType :=
        AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE f
          (AlgebraicGeometry.isAffineOpen_top S_k) hAffV le_top
      let θ_B : k →+* (B ⧸ 𝔫) := (Ideal.Quotient.mk 𝔫).comp (ψ_cat.hom.comp e_k.inv.hom)
      have hθ_B_FT : θ_B.FiniteType :=
        RingHom.FiniteType.comp
          (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
          (RingHom.FiniteType.comp hψ_FT hIsoFT)
      let e_B : k ≃+* (B ⧸ 𝔫) := RingEquiv.ofBijective θ_B (hBijHelper (B ⧸ 𝔫) θ_B hθ_B_FT)
      let g0_cat : B_cat ⟶ CommRingCat.of k :=
        CommRingCat.ofHom (e_B.symm.toRingHom.comp (Ideal.Quotient.mk 𝔫))
      let g_cat : B_cat ⟶ A_cat := g0_cat ≫ e_k.inv
      have h_k_id : e_k.inv ≫ ψ_cat ≫ g0_cat = 𝟙 (CommRingCat.of k) := by
        ext c
        exact e_B.symm_apply_apply c
      have h_id_cat : ψ_cat ≫ g_cat = 𝟙 A_cat := by
        dsimp [g_cat]
        calc
          ψ_cat ≫ g0_cat ≫ e_k.inv
            = (e_k.hom ≫ e_k.inv) ≫ ψ_cat ≫ g0_cat ≫ e_k.inv := by
                rw [e_k.hom_inv_id, CategoryTheory.Category.id_comp]
          _ = e_k.hom ≫ (e_k.inv ≫ ψ_cat ≫ g0_cat) ≫ e_k.inv := by
                simp only [CategoryTheory.Category.assoc]
          _ = e_k.hom ≫ 𝟙 (CommRingCat.of k) ≫ e_k.inv := by rw [h_k_id]
          _ = 𝟙 A_cat := by rw [CategoryTheory.Category.id_comp, e_k.hom_inv_id]
      let g : S_k ⟶ W := S_k.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ hAffV.fromSpec
      refine ⟨g, ?_⟩
      calc
        g ≫ f = S_k.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_cat ≫ (hAffV.fromSpec ≫ f) := by
          simp [g, CategoryTheory.Category.assoc]
        _ = S_k.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map g_cat ≫ AlgebraicGeometry.Spec.map ψ_cat) ≫
              S_k.isoSpec.inv := by
          rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f
              (AlgebraicGeometry.isAffineOpen_top S_k) hAffV le_top,
            AlgebraicGeometry.IsAffineOpen.fromSpec_top]
          simp [ψ_cat, CategoryTheory.Category.assoc]
        _ = S_k.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (ψ_cat ≫ g_cat) ≫ S_k.isoSpec.inv := by
          rw [← AlgebraicGeometry.Spec.map_comp]
        _ = 𝟙 S_k := by
          rw [h_id_cat, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp,
            CategoryTheory.Iso.hom_inv_id]
    have : AlgebraicGeometry.Scheme.IsJointlySurjectivePreserving @AlgebraicGeometry.Etale.{u} :=
      AlgebraicGeometry.Scheme.isJointlySurjectivePreserving @AlgebraicGeometry.Etale.{u}
    have : AlgebraicGeometry.Scheme.JointlySurjective
        (AlgebraicGeometry.Scheme.precoverage @AlgebraicGeometry.Etale.{u}) :=
      AlgebraicGeometry.Scheme.instJointlySurjectivePrecoverage (P := @AlgebraicGeometry.Etale.{u})
    letI : CategoryTheory.Category.{u, u + 1}
        (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale.{u}) ⊤ S_k) :=
      (inferInstance : CategoryTheory.Category S_k.Etale)
    have hMemId : ∀ (R : CategoryTheory.Sieve T_k),
        R ∈ S_k.smallEtaleTopology T_k → R.arrows (𝟙 T_k) := by
      intro R hR
      rcases (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology
        (P := @AlgebraicGeometry.Etale.{u}) T_k R).mp hR with ⟨𝒰, hOver, hP, hle⟩
      obtain ⟨x₀⟩ := (inferInstance : Nonempty ↥S_k)
      let j := 𝒰.idx x₀
      obtain ⟨y₀, -⟩ := 𝒰.covers x₀
      obtain ⟨g, hg⟩ := hSec (𝒰.X j) ⟨y₀⟩ (𝒰.f j) (𝒰.map_prop j)
      letI : T_k.left.Over S_k := CategoryTheory.OverClass.fromOver T_k.toComma
      letI : AlgebraicGeometry.Scheme.Cover.Over S_k 𝒰 := hOver
      letI : (𝒰.X j).Over S_k := hOver.«over» j
      letI : (𝒰.f j).IsOver S_k := hOver.isOver_map j
      let W_j : S_k.Etale := (𝒰.X j).asOverProp S_k (hP j)
      let w_j : W_j ⟶ T_k := AlgebraicGeometry.Scheme.Hom.asOverProp (𝒰.f j) S_k
      have hw_mem : R.arrows w_j := @hle W_j w_j (CategoryTheory.Presieve.ofArrows.mk j)
      let σ : T_k ⟶ W_j := CategoryTheory.MorphismProperty.Over.homMk (A := T_k) (B := W_j) g
        (((CategoryTheory.Category.assoc g (𝒰.f j) T_k.hom).trans
          (congrArg (g ≫ ·) (CategoryTheory.MorphismProperty.Over.w w_j))).symm.trans
          ((congrArg (· ≫ T_k.hom) hg).trans (CategoryTheory.Category.id_comp T_k.hom)))
        trivial
      have h_id : σ ≫ w_j = 𝟙 T_k := CategoryTheory.MorphismProperty.Over.Hom.ext hg
      simpa [h_id] using R.downward_closed hw_mem σ
    intro P
    dsimp only []
    let J_k := S_k.smallEtaleTopology
    let adj_sh := CategoryTheory.sheafificationAdjunction J_k AddCommGrpCat.{u}
    let η := adj_sh.unit.app P
    have hW : J_k.W η := CategoryTheory.GrothendieckTopology.W_adj_unit_app J_k adj_sh P
    obtain ⟨hLocInj, hLocSurj⟩ :=
      (CategoryTheory.GrothendieckTopology.W_iff_isLocallyBijective J_k η).mp hW
    have : CategoryTheory.Presheaf.IsLocallyInjective J_k η := hLocInj
    have : CategoryTheory.Presheaf.IsLocallySurjective J_k η := hLocSurj
    refine ⟨fun x y hxy => ?_, fun z => ?_⟩
    · have hEqMem : CategoryTheory.Presheaf.equalizerSieve (F := P) (X := Opposite.op T_k) x y ∈
          J_k T_k :=
        CategoryTheory.Presheaf.IsLocallyInjective.equalizerSieve_mem
          (J := J_k) (φ := η) (X := Opposite.op T_k) x y hxy
      have hId := hMemId _ hEqMem
      change (CategoryTheory.ConcreteCategory.hom (P.map (𝟙 T_k).op)) x =
        (CategoryTheory.ConcreteCategory.hom (P.map (𝟙 T_k).op)) y at hId
      simpa using hId
    · have hImgMem : CategoryTheory.Presheaf.imageSieve η z ∈ J_k T_k :=
        CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem z
      have hId := hMemId _ hImgMem
      rw [CategoryTheory.Presheaf.imageSieve_apply] at hId
      obtain ⟨x, hx⟩ := hId
      refine ⟨x, ?_⟩
      simpa using hx
  · intro Y T hT 𝒢 q
    let J := Y.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_Y := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let R_T := weilPolyP1CohomologyRepSheaf Y T
    have hRepNat : ∀ (G₁ G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (α : R_T ⟶ G₁) (β : G₁ ⟶ G₂),
        weilPolyP1CohomologyRepHomEquiv Y T G₂ (α ≫ β) =
          (β.hom.app (Opposite.op T)).hom (weilPolyP1CohomologyRepHomEquiv Y T G₁ α) := by
      intro G₁ G₂ α β
      dsimp [weilPolyP1CohomologyRepHomEquiv]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.yonedaEquiv_comp]
      rfl
    let u₁ : Aℤ := ULift.up (1 : ℤ)
    let e₀ : ↑(Fℤ_Y.obj.obj (Opposite.op T)) := (adj_c.unit.app Aℤ) u₁
    let φ : R_T ⟶ Fℤ_Y := weilPolyP1CohomologyRepToConst Y T hT
    let ι_T : ↑(R_T.obj.obj (Opposite.op T)) :=
      weilPolyP1CohomologyRepHomEquiv Y T R_T (𝟙 R_T)
    let z_hom : Aℤ ⟶ R_T.obj.obj (Opposite.op T) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • ι_T
          map_zero' := zero_zsmul ι_T
          map_add' := fun a b => add_zsmul ι_T a.down b.down }
    let ψ : Fℤ_Y ⟶ R_T := (adj_c.homEquiv Aℤ R_T).symm z_hom
    have hψ_e₀ : (ψ.hom.app (Opposite.op T)).hom e₀ = ι_T := by
      have h1 : (adj_c.homEquiv Aℤ R_T) ψ = z_hom := Equiv.apply_symm_apply _ _
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      have h2 := DFunLike.congr_fun (congrArg AddCommGrpCat.Hom.hom h1) u₁
      simpa [z_hom, u₁, e₀, one_zsmul] using h2
    have hφ_eval : weilPolyP1CohomologyRepHomEquiv Y T Fℤ_Y φ = e₀ :=
      Equiv.apply_symm_apply (weilPolyP1CohomologyRepHomEquiv Y T Fℤ_Y) e₀
    have hφ_ι : (φ.hom.app (Opposite.op T)).hom ι_T = e₀ := by
      have h1 := hRepNat R_T Fℤ_Y (𝟙 R_T) φ
      rw [CategoryTheory.Category.id_comp, hφ_eval] at h1
      exact h1.symm
    have h_right : φ ≫ ψ = 𝟙 R_T := by
      apply (weilPolyP1CohomologyRepHomEquiv Y T R_T).injective
      rw [hRepNat Fℤ_Y R_T φ ψ, hφ_eval, hψ_e₀]
    have h_left : ψ ≫ φ = 𝟙 Fℤ_Y := by
      apply (adj_c.homEquiv Aℤ Fℤ_Y).injective
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      have h1 : (adj_c.homEquiv Aℤ R_T) ψ = z_hom := Equiv.apply_symm_apply _ _
      rw [h1, CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
      ext z
      have hz : z = z.down • u₁ := by
        ext
        change z.down = z.down • (1 : ℤ)
        simp
      change (φ.hom.app (Opposite.op T)).hom (z.down • ι_T) = (adj_c.unit.app Aℤ).hom z
      rw [map_zsmul, hφ_ι]
      conv_rhs => rw [hz]
      exact (map_zsmul (adj_c.unit.app Aℤ).hom z.down u₁).symm
    let inv_map := (CategoryTheory.Abelian.Ext.mk₀ ψ).precomp 𝒢 (Nat.zero_add q)
    have h_linv : Function.LeftInverse inv_map
        (weilPolyP1CohomologyTermToPresheaf Y T hT 𝒢 q) := by
      intro α
      change (CategoryTheory.Abelian.Ext.mk₀ ψ).comp
        ((CategoryTheory.Abelian.Ext.mk₀ φ).comp α (Nat.zero_add q)) (Nat.zero_add q) = α
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, h_left,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
    have h_rinv : Function.RightInverse inv_map
        (weilPolyP1CohomologyTermToPresheaf Y T hT 𝒢 q) := by
      intro β
      change (CategoryTheory.Abelian.Ext.mk₀ φ).comp
        ((CategoryTheory.Abelian.Ext.mk₀ ψ).comp β (Nat.zero_add q)) (Nat.zero_add q) = β
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, h_right,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
    exact ⟨h_linv.injective, h_rinv.surjective⟩

theorem weil_sm_pencil_preconnected_constantSheaf_subquotient_and_shortFive (P : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥P] [PreconnectedSpace ↥P] :
    let T_P := weilEtaleIdTerminal.{u} P
    let hT_P := weilEtaleIdTerminalIsTerminal.{u} P
    let C_P := CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}
    let adj_P := CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u} hT_P
    (∀ (m : ℕ)
        (𝒢₁ 𝒢₂ : CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u})
        (δ : Quiver.Hom 𝒢₁ 𝒢₂),
      (Finite ↥(𝒢₁.obj.obj (Opposite.op T_P)) →
        m • CategoryTheory.CategoryStruct.id (𝒢₁.obj.obj (Opposite.op T_P)) = 0 →
        CategoryTheory.IsIso (adj_P.counit.app 𝒢₁) →
        CategoryTheory.IsIso (adj_P.counit.app 𝒢₂) →
        let 𝒦 := CategoryTheory.Limits.kernel δ
        Finite ↥(𝒦.obj.obj (Opposite.op T_P)) ∧
        m • CategoryTheory.CategoryStruct.id (𝒦.obj.obj (Opposite.op T_P)) = 0 ∧
        CategoryTheory.IsIso (adj_P.counit.app 𝒦)) ∧
      (CategoryTheory.IsIso (adj_P.counit.app 𝒢₁) →
        Finite ↥(𝒢₂.obj.obj (Opposite.op T_P)) →
        m • CategoryTheory.CategoryStruct.id (𝒢₂.obj.obj (Opposite.op T_P)) = 0 →
        CategoryTheory.IsIso (adj_P.counit.app 𝒢₂) →
        let 𝒬 := CategoryTheory.Limits.cokernel δ
        Finite ↥(𝒬.obj.obj (Opposite.op T_P)) ∧
        m • CategoryTheory.CategoryStruct.id (𝒬.obj.obj (Opposite.op T_P)) = 0 ∧
        CategoryTheory.IsIso (adj_P.counit.app 𝒬))) ∧
    (∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u})),
      SC.ShortExact →
      Finite ↥(SC.X₁.obj.obj (Opposite.op T_P)) →
      CategoryTheory.IsIso (adj_P.counit.app SC.X₁) →
      Subsingleton ((C_P.obj (SC.X₁.obj.obj (Opposite.op T_P))).H 1) →
      Finite ↥(SC.X₃.obj.obj (Opposite.op T_P)) →
      CategoryTheory.IsIso (adj_P.counit.app SC.X₃) →
      Finite ↥(SC.X₂.obj.obj (Opposite.op T_P)) ∧
      CategoryTheory.IsIso (adj_P.counit.app SC.X₂)) ∧
    ((∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u}}
          (u : Quiver.Hom 𝒢₁ 𝒢₂) [CategoryTheory.Mono u],
        Function.Injective ((u.hom.app (Opposite.op T_P)).hom)) ∧
      (∀ (m : ℕ)
          (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u})),
        SC.Exact →
        Finite ↥(SC.X₁.obj.obj (Opposite.op T_P)) →
        m • CategoryTheory.CategoryStruct.id (SC.X₁.obj.obj (Opposite.op T_P)) = 0 →
        CategoryTheory.IsIso (adj_P.counit.app SC.X₁) →
        CategoryTheory.IsIso (adj_P.counit.app SC.X₂) →
        (∀ A : AddCommGrpCat.{u},
          Finite ↥A → m • CategoryTheory.CategoryStruct.id A = 0 →
          Subsingleton ((C_P.obj A).H 1)) →
        Function.Exact ((SC.f.hom.app (Opposite.op T_P)).hom)
          ((SC.g.hom.app (Opposite.op T_P)).hom))) :=
by
  classical
  let T_P := weilEtaleIdTerminal.{u} P
  let hT_P := weilEtaleIdTerminalIsTerminal.{u} P
  let J_P := P.smallEtaleTopology
  let C_P := CategoryTheory.constantSheaf J_P AddCommGrpCat.{u}
  let Γ_P := (CategoryTheory.sheafSections J_P AddCommGrpCat.{u}).obj (Opposite.op T_P)
  let adj_P := CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P

  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  let T_id : P.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id P)
  have hT_id : CategoryTheory.Limits.IsTerminal T_id := by
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget P).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  let e_T : T_P ≅ T_id := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_P hT_id
  let e_sch : T_P.left ≅ P :=
    (CategoryTheory.Over.forget P).mapIso ((AlgebraicGeometry.Scheme.Etale.forget P).mapIso e_T)
  let homeo_T : ↥P ≃ₜ ↥T_P.left := AlgebraicGeometry.Scheme.homeoOfIso e_sch.symm
  have hNe_TP : Nonempty ↥T_P.left := Nonempty.map homeo_T inferInstance
  have hPre_TP : PreconnectedSpace ↥T_P.left :=
    ⟨by
      rw [← Set.image_univ_of_surjective homeo_T.surjective]
      exact isPreconnected_univ.image homeo_T homeo_T.continuous.continuousOn⟩

  
  have h_mem_etale : ∀ (W : P.Etale) (R : CategoryTheory.Sieve W),
      R ∈ J_P W ↔
        ∀ (x : ↥W.left), ∃ (Y : P.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      P (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) P
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology P.Etale => R ∈ J W) heq)).trans hiff

  
  have h_mor_etale : ∀ {Y₁ Y₂ : P.Etale} (u : Y₁ ⟶ Y₂), AlgebraicGeometry.Etale u.left := by
    intro Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
    have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      u.left Y₂.hom Y₂.prop hcomp

  
  have hUnitIso : ∀ A : AddCommGrpCat.{u}, CategoryTheory.IsIso (adj_P.unit.app A) := by
    intro A
    let P_A : CategoryTheory.Functor (Opposite P.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun {E₁ E₂} f =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A) f.unop.left.base.hom)
        map_id := fun _ => by
          apply AddCommGrpCat.ext
          intro g
          ext x
          rfl
        map_comp := fun _ _ => by
          apply AddCommGrpCat.ext
          intro h
          ext x
          rfl }
    let θ_A : (CategoryTheory.Functor.const (Opposite P.Etale)).obj A ⟶ P_A :=
      { app := fun E =>
          AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun _ _ _ => by
          apply AddCommGrpCat.ext
          intro a
          ext x
          rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf J_P P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (h_mem_etale E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
        fun c w m => (c.π.app (Opposite.op w)).hom m
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m y₁ = eval_c c w₂ m y₂ := by
        intro c w₁ w₂ m y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := h_mor_etale u₂
        let Z_sch := CategoryTheory.Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : P.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget P).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m (p₂.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥A := fun m x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            eval_c c w_x m y_x
          have hg_eq : ∀ (m : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
              g_fn m (w.obj.hom.left.base y) = eval_c c w m y := by
            intro m w y
            let x := w.obj.hom.left.base y
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            exact h_ov c w_x w m y_x y hy_x
          have hg_lc : ∀ m : ↥c.pt, IsLocallyConstant (g_fn m) := by
            intro m
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥A := eval_c c w_x m
            let O : Set ↥Y_x.left := f_x ⁻¹' {a}
            have hO_open : IsOpen O := f_x.isLocallyConstant {a}
            have : AlgebraicGeometry.Etale u_x.left := hEt_x
            have hu_open : IsOpen (u_x.left.base '' O) := u_x.left.isOpenMap O hO_open
            refine ⟨u_x.left.base '' O, ?_, hu_open, ⟨y_x, ?_, hy_x⟩⟩
            · rintro _ ⟨y', hy', rfl⟩
              change g_fn m (w_x.obj.hom.left.base y') = a
              rw [hg_eq m w_x y']
              exact hy'
            · change f_x y_x = a
              have hfx : f_x y_x = g_fn m x := rfl
              rw [hfx]
              exact hx
          AddCommGrpCat.ofHom
            { toFun := fun m => ⟨g_fn m, hg_lc m⟩
              map_zero' := by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have h0 : eval_c c w_x 0 = 0 := map_zero (c.π.app (Opposite.op w_x)).hom
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) h0
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have hadd : eval_c c w_x (m₁ + m₂) = eval_c c w_x m₁ + eval_c c w_x m₂ :=
                  map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) hadd }
        fac := fun c j => by
          apply AddCommGrpCat.ext
          intro m
          change _ = eval_c c j.unop m
          ext y
          let x := j.unop.obj.hom.left.base y
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          exact h_ov c w_x j.unop m y_x y hy_x
        uniq := fun c k hk => by
          apply AddCommGrpCat.ext
          intro m
          let km : LocallyConstant ↥E.left ↥A := k.hom m
          change km = _
          apply LocallyConstant.ext
          intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg
            (fun φ => (φ.hom m : LocallyConstant ↥w_x.obj.left.left ↥A) y_x)
            (hk (Opposite.op w_x))
          change km (u_x.left.base y_x) = eval_c c w_x m y_x at hkx
          rw [hy_x] at hkx
          exact hkx
      }⟩
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective J_P θ_A := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · have hbot : ⊥ ∈ J_P E.unop := by
          let PropEt : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
            @AlgebraicGeometry.Etale
          let E' : PropEt.Over ⊤ P := E.unop
          change (⊥ : CategoryTheory.Sieve E') ∈
            ((CategoryTheory.MorphismProperty.Over.forget PropEt ⊤ P).restrictedTopology
              (AlgebraicGeometry.Scheme.overGrothendieckTopology PropEt P)) E'
          rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
          exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
            (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
              (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
        exact J_P.superset_covering bot_le hbot
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun f : LocallyConstant ↥E.unop.left ↥A => f x₀) ha
        subst ha_eq
        have htop : CategoryTheory.Presheaf.equalizerSieve
            (F := (CategoryTheory.Functor.const (Opposite P.Etale)).obj A)
            (X := E) a₁ a₁ = ⊤ := by
          apply CategoryTheory.Sieve.id_mem_iff_eq_top.mp
          rfl
        rw [htop]
        exact J_P.top_mem E.unop
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective J_P θ_A := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E f
      refine (h_mem_etale E (CategoryTheory.Presheaf.imageSieve θ_A f)).mpr ?_
      intro x
      let f_lc : LocallyConstant ↥E.left ↥A := f
      let a : ↥A := f_lc x
      let O_a : E.left.Opens := ⟨f_lc ⁻¹' {a}, f_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_a.ι E.hom inferInstance E.prop
      let Y_a : P.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ?_, inferInstance, rfl⟩
      refine ⟨a, ?_⟩
      ext y
      exact y.2.symm
    have hW_θ : J_P.W θ_A :=
      (J_P.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf J_P AddCommGrpCat.{u}).map θ_A) :=
      (J_P.W_iff θ_A).mp hW_θ
    let ℒ_A : CategoryTheory.Sheaf J_P AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction J_P AddCommGrpCat.{u}
    let P_const := (CategoryTheory.Functor.const (Opposite P.Etale)).obj A
    let Υ_A : C_P.obj A ⟶ ℒ_A := (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_A =
        (CategoryTheory.presheafToSheaf J_P AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A := by
      dsimp [Υ_A]
      exact CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app ℒ_A) := inferInstance
    have : CategoryTheory.IsIso Υ_A := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    have : CategoryTheory.IsIso (Γ_P.map Υ_A) := inferInstance
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ_A.hom = θ_A := by
      have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    have h_adjP_comp : adj_P.unit.app A ≫ Γ_P.map Υ_A = θ_A.app (Opposite.op T_P) := by
      have heval := congrArg (fun η => η.app (Opposite.op T_P)) h_unit_Υ
      dsimp [adj_P, CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app]
      have hpresheaf_unit :
          (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_P).unit.app A = 𝟙 A := rfl
      rw [hpresheaf_unit, CategoryTheory.Category.id_comp]
      exact heval
    have h_bij : Function.Bijective ⇑(θ_A.app (Opposite.op T_P)).hom := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        let v₀ : ↥T_P.left := Classical.choice hNe_TP
        exact congrArg (fun f : LocallyConstant ↥T_P.left ↥A => f v₀) ha
      · intro f
        have : PreconnectedSpace ↥T_P.left := hPre_TP
        have : Nonempty ↥A := ⟨0⟩
        obtain ⟨a, rfl⟩ := LocallyConstant.exists_eq_const f
        exact ⟨a, rfl⟩
    have hIso_θ : CategoryTheory.IsIso (θ_A.app (Opposite.op T_P)) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (θ_A.app (Opposite.op T_P))).mpr h_bij
    rw [← h_adjP_comp] at hIso_θ
    exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
      (adj_P.unit.app A) (Γ_P.map Υ_A) _ hIso_θ

  
  have hCounitConst : ∀ B : AddCommGrpCat.{u},
      CategoryTheory.IsIso (adj_P.counit.app (C_P.obj B)) := by
    intro B
    have : CategoryTheory.IsIso (adj_P.unit.app B) := hUnitIso B
    have htri : C_P.map (adj_P.unit.app B) ≫ adj_P.counit.app (C_P.obj B) = 𝟙 (C_P.obj B) :=
      adj_P.left_triangle_components B
    have hIso_id : CategoryTheory.IsIso
        (C_P.map (adj_P.unit.app B) ≫ adj_P.counit.app (C_P.obj B)) := by
      rw [htri]
      exact CategoryTheory.IsIso.id _
    exact @CategoryTheory.IsIso.of_isIso_comp_left _ _ _ _ _
      (C_P.map (adj_P.unit.app B)) (adj_P.counit.app (C_P.obj B)) inferInstance hIso_id

  have hNsmulId : ∀ (k : ℕ) (M : AddCommGrpCat.{u}) (x : ↥M),
      (k • CategoryTheory.CategoryStruct.id M).hom x = k • x := by
    intro k M x
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change (k • CategoryTheory.CategoryStruct.id M).hom x + x = k • x + x
      rw [ih]

  have hTorIff : ∀ (m : ℕ) (M : AddCommGrpCat.{u}),
      m • CategoryTheory.CategoryStruct.id M = 0 ↔ ∀ x : ↥M, m • x = 0 := by
    intro m M
    refine ⟨fun h x => ?_, fun h => ?_⟩
    · rw [← hNsmulId m M x, h]
      rfl
    · apply AddCommGrpCat.ext
      intro x
      rw [hNsmulId m M x, h x]
      rfl

  have hTransfer : ∀ (m : ℕ) (B : AddCommGrpCat.{u})
      (ℋ : CategoryTheory.Sheaf J_P AddCommGrpCat.{u}) (e : C_P.obj B ≅ ℋ),
      Finite ↥B →
      m • CategoryTheory.CategoryStruct.id B = 0 →
      Finite ↥(ℋ.obj.obj (Opposite.op T_P)) ∧
      m • CategoryTheory.CategoryStruct.id (ℋ.obj.obj (Opposite.op T_P)) = 0 ∧
      CategoryTheory.IsIso (adj_P.counit.app ℋ) := by
    intro m B ℋ e hFinB hTorB
    have : CategoryTheory.IsIso (adj_P.unit.app B) := hUnitIso B
    have : CategoryTheory.IsIso (adj_P.counit.app (C_P.obj B)) := hCounitConst B
    let φ : B ≅ Γ_P.obj ℋ := (CategoryTheory.asIso (adj_P.unit.app B)).trans (Γ_P.mapIso e)
    have hInj_inv : Function.Injective φ.inv.hom := by
      intro y₁ y₂ hy
      have h1 := congrArg φ.hom.hom hy
      change (φ.inv ≫ φ.hom).hom y₁ = (φ.inv ≫ φ.hom).hom y₂ at h1
      simpa [φ.inv_hom_id] using h1
    have hFinH : Finite ↥(ℋ.obj.obj (Opposite.op T_P)) :=
      @Finite.of_injective _ _ hFinB φ.inv.hom hInj_inv
    have hTorH : m • CategoryTheory.CategoryStruct.id (ℋ.obj.obj (Opposite.op T_P)) = 0 := by
      rw [hTorIff] at hTorB ⊢
      intro y
      have hy : φ.hom.hom (φ.inv.hom y) = y := by
        change (φ.inv ≫ φ.hom).hom y = y
        simp [φ.inv_hom_id]
      rw [← hy, ← map_nsmul φ.hom.hom m (φ.inv.hom y), hTorB (φ.inv.hom y), map_zero]
    have hIsoH : CategoryTheory.IsIso (adj_P.counit.app ℋ) := by
      have hnat : C_P.map (Γ_P.map e.hom) ≫ adj_P.counit.app ℋ =
          adj_P.counit.app (C_P.obj B) ≫ e.hom :=
        adj_P.counit.naturality e.hom
      have hIso_rhs : CategoryTheory.IsIso (C_P.map (Γ_P.map e.hom) ≫ adj_P.counit.app ℋ) := by
        rw [hnat]
        infer_instance
      exact @CategoryTheory.IsIso.of_isIso_comp_left _ _ _ _ _
        (C_P.map (Γ_P.map e.hom)) (adj_P.counit.app ℋ) inferInstance hIso_rhs
    exact ⟨hFinH, hTorH, hIsoH⟩

  have : C_P.Additive := by
    dsimp [C_P]
    unfold CategoryTheory.constantSheaf
    infer_instance
  have : CategoryTheory.Limits.PreservesFiniteLimits C_P :=
    CategoryTheory.Limits.comp_preservesFiniteLimits
      (CategoryTheory.Functor.const (Opposite P.Etale))
      (CategoryTheory.presheafToSheaf J_P AddCommGrpCat.{u})
  have : C_P.IsLeftAdjoint := adj_P.isLeftAdjoint
  have : Γ_P.IsRightAdjoint := adj_P.isRightAdjoint

  have hSubQuot : ∀ (m : ℕ)
      (𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_P AddCommGrpCat.{u})
      (δ : Quiver.Hom 𝒢₁ 𝒢₂),
      (Finite ↥(𝒢₁.obj.obj (Opposite.op T_P)) →
        m • CategoryTheory.CategoryStruct.id (𝒢₁.obj.obj (Opposite.op T_P)) = 0 →
        CategoryTheory.IsIso (adj_P.counit.app 𝒢₁) →
        CategoryTheory.IsIso (adj_P.counit.app 𝒢₂) →
        let 𝒦 := CategoryTheory.Limits.kernel δ
        Finite ↥(𝒦.obj.obj (Opposite.op T_P)) ∧
        m • CategoryTheory.CategoryStruct.id (𝒦.obj.obj (Opposite.op T_P)) = 0 ∧
        CategoryTheory.IsIso (adj_P.counit.app 𝒦)) ∧
      (CategoryTheory.IsIso (adj_P.counit.app 𝒢₁) →
        Finite ↥(𝒢₂.obj.obj (Opposite.op T_P)) →
        m • CategoryTheory.CategoryStruct.id (𝒢₂.obj.obj (Opposite.op T_P)) = 0 →
        CategoryTheory.IsIso (adj_P.counit.app 𝒢₂) →
        let 𝒬 := CategoryTheory.Limits.cokernel δ
        Finite ↥(𝒬.obj.obj (Opposite.op T_P)) ∧
        m • CategoryTheory.CategoryStruct.id (𝒬.obj.obj (Opposite.op T_P)) = 0 ∧
        CategoryTheory.IsIso (adj_P.counit.app 𝒬)) := by
    intro m 𝒢₁ 𝒢₂ δ
    refine ⟨?_, ?_⟩
    · intro hFin₁ hTor₁ hIso₁ hIso₂
      have : CategoryTheory.IsIso (adj_P.counit.app 𝒢₁) := hIso₁
      have : CategoryTheory.IsIso (adj_P.counit.app 𝒢₂) := hIso₂
      let A₁ := Γ_P.obj 𝒢₁
      let A₂ := Γ_P.obj 𝒢₂
      let α : A₁ ⟶ A₂ := Γ_P.map δ
      let e₁ : C_P.obj A₁ ≅ 𝒢₁ := CategoryTheory.asIso (adj_P.counit.app 𝒢₁)
      let e₂ : C_P.obj A₂ ≅ 𝒢₂ := CategoryTheory.asIso (adj_P.counit.app 𝒢₂)
      have hw : C_P.map α ≫ e₂.hom = e₁.hom ≫ δ := adj_P.counit.naturality δ
      let e_ker : C_P.obj (CategoryTheory.Limits.kernel α) ≅ CategoryTheory.Limits.kernel δ :=
        (CategoryTheory.Limits.PreservesKernel.iso C_P α).trans
          (CategoryTheory.Limits.kernel.mapIso (C_P.map α) δ e₁ e₂ hw)
      let ι := CategoryTheory.Limits.kernel.ι α
      have hInj_ι : Function.Injective ι.hom :=
        (AddCommGrpCat.mono_iff_injective ι).mp inferInstance
      have hFin_k : Finite ↥(CategoryTheory.Limits.kernel α) :=
        @Finite.of_injective _ _ hFin₁ ι.hom hInj_ι
      have hTor_k : m • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel α) = 0 := by
        rw [hTorIff] at hTor₁ ⊢
        intro x
        apply hInj_ι
        rw [map_nsmul ι.hom m x, hTor₁ (ι.hom x), map_zero]
      exact hTransfer m (CategoryTheory.Limits.kernel α) (CategoryTheory.Limits.kernel δ)
        e_ker hFin_k hTor_k
    · intro hIso₁ hFin₂ hTor₂ hIso₂
      have : CategoryTheory.IsIso (adj_P.counit.app 𝒢₁) := hIso₁
      have : CategoryTheory.IsIso (adj_P.counit.app 𝒢₂) := hIso₂
      let A₁ := Γ_P.obj 𝒢₁
      let A₂ := Γ_P.obj 𝒢₂
      let α : A₁ ⟶ A₂ := Γ_P.map δ
      let e₁ : C_P.obj A₁ ≅ 𝒢₁ := CategoryTheory.asIso (adj_P.counit.app 𝒢₁)
      let e₂ : C_P.obj A₂ ≅ 𝒢₂ := CategoryTheory.asIso (adj_P.counit.app 𝒢₂)
      have hw : C_P.map α ≫ e₂.hom = e₁.hom ≫ δ := adj_P.counit.naturality δ
      let e_coker : C_P.obj (CategoryTheory.Limits.cokernel α) ≅ CategoryTheory.Limits.cokernel δ :=
        (CategoryTheory.Limits.PreservesCokernel.iso C_P α).trans
          (CategoryTheory.Limits.cokernel.mapIso (C_P.map α) δ e₁ e₂ hw)
      let π := CategoryTheory.Limits.cokernel.π α
      have hSurj_π : Function.Surjective π.hom :=
        (AddCommGrpCat.epi_iff_surjective π).mp inferInstance
      have hFin_c : Finite ↥(CategoryTheory.Limits.cokernel α) :=
        @Finite.of_surjective _ _ hFin₂ π.hom hSurj_π
      have hTor_c : m • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel α) = 0 := by
        rw [hTorIff] at hTor₂ ⊢
        intro q
        obtain ⟨a₂, rfl⟩ := hSurj_π q
        rw [← map_nsmul π.hom m a₂, hTor₂ a₂, map_zero]
      exact hTransfer m (CategoryTheory.Limits.cokernel α) (CategoryTheory.Limits.cokernel δ)
        e_coker hFin_c hTor_c

  
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_P := C_P.obj Aℤ

  have hSubH1Transport : ∀ (ℱ : CategoryTheory.Sheaf J_P AddCommGrpCat.{u}),
      CategoryTheory.IsIso (adj_P.counit.app ℱ) →
      Subsingleton ((C_P.obj (ℱ.obj.obj (Opposite.op T_P))).H 1) →
      Subsingleton (ℱ.H 1) := by
    intro ℱ hIso hSub
    let ε : C_P.obj (ℱ.obj.obj (Opposite.op T_P)) ⟶ ℱ := adj_P.counit.app ℱ
    let ε_inv : ℱ ⟶ C_P.obj (ℱ.obj.obj (Opposite.op T_P)) := @CategoryTheory.inv _ _ _ _ ε hIso
    refine ⟨fun u₁ u₂ => ?_⟩
    have hu : u₁.comp (CategoryTheory.Abelian.Ext.mk₀ ε_inv) (Nat.add_zero 1) =
        u₂.comp (CategoryTheory.Abelian.Ext.mk₀ ε_inv) (Nat.add_zero 1) :=
      hSub.elim _ _
    calc u₁ = u₁.comp (CategoryTheory.Abelian.Ext.mk₀ (ε_inv ≫ ε)) (Nat.add_zero 1) := by
          rw [@CategoryTheory.IsIso.inv_hom_id _ _ _ _ ε hIso,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
      _ = (u₁.comp (CategoryTheory.Abelian.Ext.mk₀ ε_inv) (Nat.add_zero 1)).comp
            (CategoryTheory.Abelian.Ext.mk₀ ε) (Nat.add_zero 1) := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
      _ = (u₂.comp (CategoryTheory.Abelian.Ext.mk₀ ε_inv) (Nat.add_zero 1)).comp
            (CategoryTheory.Abelian.Ext.mk₀ ε) (Nat.add_zero 1) := by rw [hu]
      _ = u₂.comp (CategoryTheory.Abelian.Ext.mk₀ (ε_inv ≫ ε)) (Nat.add_zero 1) := by
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = u₂ := by
          rw [@CategoryTheory.IsIso.inv_hom_id _ _ _ _ ε hIso,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]

  let zEquiv : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃ ↥M := fun M =>
    { toFun := fun θ => θ.hom (ULift.up (1 : ℤ))
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun z => z.down • m
          map_zero' := zero_zsmul m
          map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
      left_inv := fun θ => by
        apply AddCommGrpCat.ext
        intro z
        have hz : z = z.down • ULift.up (1 : ℤ) :=
          ULift.ext _ _ (zsmul_one z.down).symm
        calc z.down • θ.hom (ULift.up (1 : ℤ))
            = θ.hom (z.down • ULift.up (1 : ℤ)) := (map_zsmul θ.hom z.down _).symm
          _ = θ.hom z := congrArg θ.hom hz.symm
      right_inv := fun m => one_zsmul m }

  let eH0 : ∀ (ℱ : CategoryTheory.Sheaf J_P AddCommGrpCat.{u}),
      ℱ.H 0 ≃ ↥(Γ_P.obj ℱ) := fun ℱ =>
    (CategoryTheory.Abelian.Ext.homEquiv₀ (X := Fℤ_P) (Y := ℱ)).trans
      ((adj_P.homEquiv Aℤ ℱ).trans (zEquiv (Γ_P.obj ℱ)))

  have heH0_nat : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf J_P AddCommGrpCat.{u}}
      (φ : ℱ ⟶ 𝒢) (α : ℱ.H 0),
      eH0 𝒢 (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_P (Nat.add_zero 0)) α) =
        (Γ_P.map φ).hom (eH0 ℱ α) := by
    intro ℱ 𝒢 φ α
    let f_α : Fℤ_P ⟶ ℱ := CategoryTheory.Abelian.Ext.homEquiv₀ α
    have hα_eq : α = CategoryTheory.Abelian.Ext.mk₀ f_α := by
      rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
      exact (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply α).symm
    have hcomp_eq : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_P (Nat.add_zero 0)) α =
        CategoryTheory.Abelian.Ext.mk₀ (f_α ≫ φ) := by
      change α.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) = _
      rw [hα_eq, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hhom_eq : CategoryTheory.Abelian.Ext.homEquiv₀
        (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_P (Nat.add_zero 0)) α) = f_α ≫ φ := by
      rw [hcomp_eq, ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
      exact CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply (f_α ≫ φ)
    dsimp only [eH0, Equiv.trans_apply]
    rw [hhom_eq, CategoryTheory.Adjunction.homEquiv_naturality_right]
    rfl

  have hMonoInj : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_P AddCommGrpCat.{u}}
      (u : Quiver.Hom 𝒢₁ 𝒢₂) [CategoryTheory.Mono u],
      Function.Injective ((u.hom.app (Opposite.op T_P)).hom) := by
    intro 𝒢₁ 𝒢₂ u _ x₁ x₂ hx
    have hx' : (Γ_P.map u).hom x₁ = (Γ_P.map u).hom x₂ := hx
    let ψ₁ : Aℤ ⟶ Γ_P.obj 𝒢₁ := (zEquiv (Γ_P.obj 𝒢₁)).symm x₁
    let ψ₂ : Aℤ ⟶ Γ_P.obj 𝒢₁ := (zEquiv (Γ_P.obj 𝒢₁)).symm x₂
    have hψ_comp : ψ₁ ≫ Γ_P.map u = ψ₂ ≫ Γ_P.map u := by
      apply AddCommGrpCat.ext
      intro z
      change (Γ_P.map u).hom (z.down • x₁) = (Γ_P.map u).hom (z.down • x₂)
      rw [map_zsmul, map_zsmul, hx']
    have htilde_comp : (adj_P.homEquiv Aℤ 𝒢₁).symm ψ₁ ≫ u =
        (adj_P.homEquiv Aℤ 𝒢₁).symm ψ₂ ≫ u := by
      rw [← CategoryTheory.Adjunction.homEquiv_naturality_right_symm,
        ← CategoryTheory.Adjunction.homEquiv_naturality_right_symm, hψ_comp]
    have htilde_eq : (adj_P.homEquiv Aℤ 𝒢₁).symm ψ₁ = (adj_P.homEquiv Aℤ 𝒢₁).symm ψ₂ :=
      (cancel_mono u).mp htilde_comp
    have hψ_eq : ψ₁ = ψ₂ := (adj_P.homEquiv Aℤ 𝒢₁).symm.injective htilde_eq
    exact (zEquiv (Γ_P.obj 𝒢₁)).symm.injective hψ_eq

  have hSurjOfSES : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_P AddCommGrpCat.{u})),
      SC.ShortExact →
      Subsingleton (SC.X₁.H 1) →
      Function.Surjective ((Γ_P.map SC.g).hom) := by
    intro SC hSE hSub z
    have hEx₃ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' Fℤ_P hSE 0 1 (Nat.zero_add 1)
    rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact] at hEx₃
    let γ : SC.X₃.H 0 := (eH0 SC.X₃).symm z
    have hγ_zero : hSE.extClass.postcomp Fℤ_P (Nat.zero_add 1) γ = 0 := hSub.elim _ 0
    obtain ⟨β, hβ⟩ := (hEx₃ γ).mp hγ_zero
    refine ⟨eH0 SC.X₂ β, ?_⟩
    have hnat := heH0_nat SC.g β
    change eH0 SC.X₃ (((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp Fℤ_P (Nat.add_zero 0)) β) =
      (Γ_P.map SC.g).hom (eH0 SC.X₂ β) at hnat
    have hβ' : ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp Fℤ_P (Nat.add_zero 0)) β = γ := hβ
    rw [← hnat, hβ', (eH0 SC.X₃).apply_symm_apply]

  refine ⟨hSubQuot, ?_, ⟨@hMonoInj, ?_⟩⟩
  · 
    intro SC hSE hFin₁ hIso₁ hSub_C₁ hFin₃ hIso₃
    have : CategoryTheory.IsIso (adj_P.counit.app SC.X₁) := hIso₁
    have : CategoryTheory.IsIso (adj_P.counit.app SC.X₃) := hIso₃
    have hSub₁ : Subsingleton (SC.X₁.H 1) := hSubH1Transport SC.X₁ hIso₁ hSub_C₁
    have : CategoryTheory.Mono SC.f := hSE.mono_f
    have hInj_f : Function.Injective ((Γ_P.map SC.f).hom) := hMonoInj SC.f
    have hMono_f : CategoryTheory.Mono (Γ_P.map SC.f) :=
      (AddCommGrpCat.mono_iff_injective (Γ_P.map SC.f)).mpr hInj_f
    have hSurj_g : Function.Surjective ((Γ_P.map SC.g).hom) := hSurjOfSES SC hSE hSub₁
    have hEpi_g : CategoryTheory.Epi (Γ_P.map SC.g) :=
      (AddCommGrpCat.epi_iff_surjective (Γ_P.map SC.g)).mpr hSurj_g
    have hEx₂ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' Fℤ_P hSE 0
    rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact] at hEx₂
    have hEx_fn : Function.Exact ((Γ_P.map SC.f).hom) ((Γ_P.map SC.g).hom) := by
      intro y
      let β : SC.X₂.H 0 := (eH0 SC.X₂).symm y
      have hy_eq : eH0 SC.X₂ β = y := (eH0 SC.X₂).apply_symm_apply y
      refine ⟨fun hy0 => ?_, fun ⟨x, hx⟩ => ?_⟩
      · have hβ0 : ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp Fℤ_P (Nat.add_zero 0)) β = 0 := by
          apply (eH0 SC.X₃).injective
          have h0 : eH0 SC.X₃ 0 = 0 := by
            have hhom0 : CategoryTheory.Abelian.Ext.homEquiv₀ (0 : SC.X₃.H 0) = 0 := by
              rw [← CategoryTheory.Abelian.Ext.mk₀_zero,
                ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
              exact CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply 0
            have hadj0 : (adj_P.homEquiv Aℤ SC.X₃) 0 = 0 := by
              rw [CategoryTheory.Adjunction.homEquiv_unit, Γ_P.map_zero,
                CategoryTheory.Limits.comp_zero]
            dsimp only [eH0, Equiv.trans_apply]
            rw [hhom0, hadj0]
            rfl
          rw [h0, heH0_nat SC.g β, hy_eq, hy0]
        obtain ⟨α, hα⟩ := (hEx₂ β).mp hβ0
        refine ⟨eH0 SC.X₁ α, ?_⟩
        have hα' : ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp Fℤ_P (Nat.add_zero 0)) α = β := hα
        rw [← heH0_nat SC.f α, hα', hy_eq]
      · rw [← hx]
        change ((Γ_P.map SC.f ≫ Γ_P.map SC.g).hom) x = 0
        rw [← Γ_P.map_comp, SC.zero, Γ_P.map_zero]
        rfl
    have hEx_Γ : (SC.map Γ_P).Exact :=
      (CategoryTheory.ShortComplex.ab_exact_iff_function_exact (SC.map Γ_P)).mpr hEx_fn
    have hSE_Γ : (SC.map Γ_P).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hEx_Γ hMono_f hEpi_g
    have hFin₂ : Finite ↥(SC.X₂.obj.obj (Opposite.op T_P)) := by
      let A₁ := Γ_P.obj SC.X₁
      let A₂ := Γ_P.obj SC.X₂
      let A₃ := Γ_P.obj SC.X₃
      let f_A := (Γ_P.map SC.f).hom
      let g_A := (Γ_P.map SC.g).hom
      let σ : ↥A₃ → ↥A₂ := Function.surjInv hSurj_g
      have hσ : ∀ z : ↥A₃, g_A (σ z) = z := Function.surjInv_eq hSurj_g
      have h_ker : ∀ y : ↥A₂, ∃ x : ↥A₁, f_A x = y - σ (g_A y) := by
        intro y
        apply (hEx_fn (y - σ (g_A y))).mp
        rw [map_sub, hσ (g_A y), sub_self]
      let Φ : ↥A₂ → ↥A₁ × ↥A₃ := fun y => (Classical.choose (h_ker y), g_A y)
      have hΦ_inj : Function.Injective Φ := by
        intro y₁ y₂ hEq
        set x₁ := Classical.choose (h_ker y₁)
        set x₂ := Classical.choose (h_ker y₂)
        have hx_eq : x₁ = x₂ := congrArg Prod.fst hEq
        have hg_eq : g_A y₁ = g_A y₂ := congrArg Prod.snd hEq
        have hy₁ : f_A x₁ = y₁ - σ (g_A y₁) := Classical.choose_spec (h_ker y₁)
        have hy₂ : f_A x₂ = y₂ - σ (g_A y₂) := Classical.choose_spec (h_ker y₂)
        calc y₁ = (y₁ - σ (g_A y₁)) + σ (g_A y₁) := (sub_add_cancel _ _).symm
          _ = f_A x₁ + σ (g_A y₁) := by rw [← hy₁]
          _ = f_A x₂ + σ (g_A y₂) := by rw [hx_eq, hg_eq]
          _ = (y₂ - σ (g_A y₂)) + σ (g_A y₂) := by rw [hy₂]
          _ = y₂ := sub_add_cancel _ _
      have : Finite ↥A₁ := hFin₁
      have : Finite ↥A₃ := hFin₃
      exact Finite.of_injective Φ hΦ_inj
    have hSE_CΓ : ((SC.map Γ_P).map C_P).ShortExact := hSE_Γ.map_of_exact C_P
    let φ_sc : (SC.map Γ_P).map C_P ⟶ SC :=
      { τ₁ := adj_P.counit.app SC.X₁
        τ₂ := adj_P.counit.app SC.X₂
        τ₃ := adj_P.counit.app SC.X₃
        comm₁₂ := (adj_P.counit.naturality SC.f).symm
        comm₂₃ := (adj_P.counit.naturality SC.g).symm }
    have : CategoryTheory.IsIso φ_sc.τ₁ := hIso₁
    have : CategoryTheory.IsIso φ_sc.τ₃ := hIso₃
    have : CategoryTheory.Mono φ_sc.τ₂ :=
      CategoryTheory.ShortComplex.mono_of_mono_of_mono_of_mono φ_sc
        hSE_CΓ.exact hSE.mono_f inferInstance inferInstance
    have : CategoryTheory.Epi φ_sc.τ₂ :=
      CategoryTheory.ShortComplex.epi_of_epi_of_epi_of_epi φ_sc
        hSE.exact hSE_CΓ.epi_g inferInstance inferInstance
    have hIso₂ : CategoryTheory.IsIso (adj_P.counit.app SC.X₂) :=
      CategoryTheory.isIso_of_mono_of_epi φ_sc.τ₂
    exact ⟨hFin₂, hIso₂⟩
  · 
    intro m SC hEx hFin₁ hTor₁ hIso₁ hIso₂ hH1_const
    let 𝒦₀ := CategoryTheory.Limits.kernel SC.f
    let ι₀ := CategoryTheory.Limits.kernel.ι SC.f
    let 𝒦₁ := CategoryTheory.Limits.kernel SC.g
    let ι₁ := CategoryTheory.Limits.kernel.ι SC.g
    let p₀ : SC.X₁ ⟶ 𝒦₁ := CategoryTheory.Limits.kernel.lift SC.g SC.f SC.zero
    obtain ⟨hFin_K0, hTor_K0, hIso_K0⟩ :=
      (hSubQuot m SC.X₁ SC.X₂ SC.f).1 hFin₁ hTor₁ hIso₁ hIso₂
    have hSub_K0 : Subsingleton (𝒦₀.H 1) :=
      hSubH1Transport 𝒦₀ hIso_K0 (hH1_const _ hFin_K0 hTor_K0)
    have h0_ker : ι₀ ≫ p₀ = 0 := by
      apply (cancel_mono ι₁).mp
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
        CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    let SC_ker := CategoryTheory.ShortComplex.mk ι₀ p₀ h0_ker
    have hEpi_p0 : CategoryTheory.Epi p₀ := CategoryTheory.ShortComplex.Exact.epi_kernelLift hEx
    have hIsLim : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι ι₀ h0_ker) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι ι₀ h0_ker
        (fun {W'} g' hg' => CategoryTheory.Limits.kernel.lift SC.f g' (by
          rw [← CategoryTheory.Limits.kernel.lift_ι SC.g SC.f SC.zero,
            ← CategoryTheory.Category.assoc, hg', CategoryTheory.Limits.zero_comp]))
        (fun {W'} g' _ => CategoryTheory.Limits.kernel.lift_ι _ _ _)
        (fun {W'} g' _ m₀ hm₀ => by
          apply (cancel_mono ι₀).mp
          rw [hm₀, CategoryTheory.Limits.kernel.lift_ι])
    have hEx_ker : SC_ker.Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel SC_ker hIsLim
    have hSE_ker : SC_ker.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hEx_ker inferInstance hEpi_p0
    have hSurj_p0 : Function.Surjective ((Γ_P.map p₀).hom) :=
      hSurjOfSES SC_ker hSE_ker hSub_K0
    intro y
    refine ⟨fun hy0 => ?_, fun ⟨x, hx⟩ => ?_⟩
    · have hy0' : (Γ_P.map SC.g).hom y = 0 := hy0
      let ψ_y : Aℤ ⟶ Γ_P.obj SC.X₂ := (zEquiv (Γ_P.obj SC.X₂)).symm y
      have hψ_g : ψ_y ≫ Γ_P.map SC.g = 0 := by
        apply AddCommGrpCat.ext
        intro w
        change (Γ_P.map SC.g).hom (w.down • y) = 0
        rw [map_zsmul, hy0', smul_zero]
      let ψ_tilde : Fℤ_P ⟶ SC.X₂ := (adj_P.homEquiv Aℤ SC.X₂).symm ψ_y
      have hψ_tilde_g : ψ_tilde ≫ SC.g = 0 := by
        apply (adj_P.homEquiv Aℤ SC.X₃).injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
          (adj_P.homEquiv Aℤ SC.X₂).apply_symm_apply, hψ_g,
          CategoryTheory.Adjunction.homEquiv_unit, Γ_P.map_zero,
          CategoryTheory.Limits.comp_zero]
      let ξ_tilde : Fℤ_P ⟶ 𝒦₁ :=
        CategoryTheory.Limits.kernel.lift SC.g ψ_tilde hψ_tilde_g
      let z : ↥(Γ_P.obj 𝒦₁) := zEquiv (Γ_P.obj 𝒦₁) ((adj_P.homEquiv Aℤ 𝒦₁) ξ_tilde)
      have hz_ι₁ : (Γ_P.map ι₁).hom z = y := by
        have hcomp_ι₁ : ((adj_P.homEquiv Aℤ 𝒦₁) ξ_tilde) ≫ Γ_P.map ι₁ = ψ_y := by
          rw [← CategoryTheory.Adjunction.homEquiv_naturality_right,
            CategoryTheory.Limits.kernel.lift_ι,
            (adj_P.homEquiv Aℤ SC.X₂).apply_symm_apply]
        change zEquiv (Γ_P.obj SC.X₂) (((adj_P.homEquiv Aℤ 𝒦₁) ξ_tilde) ≫ Γ_P.map ι₁) = y
        rw [hcomp_ι₁]
        exact (zEquiv (Γ_P.obj SC.X₂)).apply_symm_apply y
      obtain ⟨x, hx⟩ := hSurj_p0 z
      refine ⟨x, ?_⟩
      calc ((SC.f.hom.app (Opposite.op T_P)).hom) x
          = ((Γ_P.map (p₀ ≫ ι₁)).hom) x := by
              rw [CategoryTheory.Limits.kernel.lift_ι]
              rfl
        _ = (Γ_P.map ι₁).hom ((Γ_P.map p₀).hom x) := by
              rw [Γ_P.map_comp]
              rfl
        _ = (Γ_P.map ι₁).hom z := by rw [hx]
        _ = y := hz_ι₁
    · rw [← hx]
      change ((Γ_P.map SC.f ≫ Γ_P.map SC.g).hom) x = 0
      rw [← Γ_P.map_comp, SC.zero, Γ_P.map_zero]
      rfl

theorem weil_sm_pencil_leray_connHom_long_exact_and_torsion_ann {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) :
    (∀ (n q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      n • CategoryTheory.CategoryStruct.id F = 0 →
      n • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q F) = 0) ∧
    (∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact),
      CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 SC.f) ∧
      (∀ q : ℕ,
        let u_q := weilEtaleHigherDirectImageMap f q SC.f
        let v_q := weilEtaleHigherDirectImageMap f q SC.g
        let δ_q := weilSmPencilLerayConnHom f SC hSE q
        let u_succ := weilEtaleHigherDirectImageMap f (q + 1) SC.f
        ∃ (h_uv : CategoryTheory.CategoryStruct.comp u_q v_q = 0)
          (h_vδ : CategoryTheory.CategoryStruct.comp v_q δ_q = 0)
          (h_δu : CategoryTheory.CategoryStruct.comp δ_q u_succ = 0),
          (CategoryTheory.ShortComplex.mk u_q v_q h_uv).Exact ∧
          (CategoryTheory.ShortComplex.mk v_q δ_q h_vδ).Exact ∧
          (CategoryTheory.ShortComplex.mk δ_q u_succ h_δu).Exact) ∧
      (∀ (h_vδ0 : CategoryTheory.CategoryStruct.comp
            (weilEtaleHigherDirectImageMap f 0 SC.g)
            (weilSmPencilLerayConnHom f SC hSE 0) = 0),
        let u_0 := weilEtaleHigherDirectImageMap f 0 SC.f
        let p_0 := CategoryTheory.Limits.kernel.lift
          (weilSmPencilLerayConnHom f SC hSE 0)
          (weilEtaleHigherDirectImageMap f 0 SC.g) h_vδ0
        ∃ h0 : CategoryTheory.CategoryStruct.comp u_0 p_0 = 0,
          (CategoryTheory.ShortComplex.mk u_0 p_0 h0).ShortExact) ∧
      (∀ (k : ℕ)
          (h_δu : CategoryTheory.CategoryStruct.comp
            (weilSmPencilLerayConnHom f SC hSE k)
            (weilEtaleHigherDirectImageMap f (k + 1) SC.f) = 0)
          (h_vδ : CategoryTheory.CategoryStruct.comp
            (weilEtaleHigherDirectImageMap f (k + 1) SC.g)
            (weilSmPencilLerayConnHom f SC hSE (k + 1)) = 0),
        let j_1 := CategoryTheory.Limits.cokernel.desc
          (weilSmPencilLerayConnHom f SC hSE k)
          (weilEtaleHigherDirectImageMap f (k + 1) SC.f) h_δu
        let p_2 := CategoryTheory.Limits.kernel.lift
          (weilSmPencilLerayConnHom f SC hSE (k + 1))
          (weilEtaleHigherDirectImageMap f (k + 1) SC.g) h_vδ
        ∃ h_mid : CategoryTheory.CategoryStruct.comp j_1 p_2 = 0,
          (CategoryTheory.ShortComplex.mk j_1 p_2 h_mid).ShortExact)) :=
by
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let J_X := X.smallEtaleTopology
  let J_S := S.smallEtaleTopology
  let B_f : CategoryTheory.Functor S.Etale X.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj B_f.op
  let Sh_S : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
    CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let L_tot := Free_PSh ⋙ CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let Z_fun : CategoryTheory.Functor X.Etale (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  refine ⟨?_, ?_⟩
  · intro n q F hn
    have hx_ann : ∀ (W : Opposite X.Etale)
        (x : CategoryTheory.Abelian.Ext (Z_obj W) F q), n • x = 0 := by
      intro W x
      have h_ind : ∀ k : ℕ,
          x.comp (CategoryTheory.Abelian.Ext.mk₀ (k • CategoryTheory.CategoryStruct.id F))
            (Nat.add_zero q) =
          k • (x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
            (Nat.add_zero q)) := by
        intro k
        induction k with
        | zero =>
          rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero]
        | succ k ih =>
          rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
            CategoryTheory.Abelian.Ext.comp_add, ih]
      have hn_eq := h_ind n
      rw [hn, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero,
        CategoryTheory.Abelian.Ext.comp_mk₀_id] at hn_eq
      exact hn_eq.symm
    let P := CategoryTheory.Sheaf.cohomologyPresheaf F q
    have hP_app : ∀ (k : ℕ) (W : Opposite X.Etale) (x : P.obj W),
        ((k • CategoryTheory.CategoryStruct.id P).app W).hom x = k • x := by
      intro k W x
      induction k with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul]
        change (((k • CategoryTheory.CategoryStruct.id P).app W).hom x) +
          ((CategoryTheory.CategoryStruct.id P).app W).hom x = k • x + x
        rw [ih]
        rfl
    have hP : n • CategoryTheory.CategoryStruct.id P = 0 := by
      ext W x
      exact (hP_app n W x).trans (hx_ann W x)
    change n • CategoryTheory.CategoryStruct.id (Sh_S.obj (W_B.obj P)) = 0
    rw [← Sh_S.map_id, ← W_B.map_id, ← CategoryTheory.Functor.map_nsmul Sh_S,
      ← CategoryTheory.Functor.map_nsmul W_B, hP, W_B.map_zero, Sh_S.map_zero]
  · intro SC hSE
    have : CategoryTheory.Mono SC.f := hSE.mono_f
    have hMono_u0 : CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 SC.f) := by
      let u_pre₀ := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.f
      have hMono_W : ∀ W : Opposite X.Etale, CategoryTheory.Mono (u_pre₀.app W) := by
        intro W
        rw [AddCommGrpCat.mono_iff_injective]
        intro α₁ α₂ hα
        have hmap : u_pre₀.app W =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map SC.f := rfl
        rw [hmap, CategoryTheory.Abelian.extFunctorObj_map] at hα
        change ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 0)) α₁ =
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 0)) α₂ at hα
        let g₁ : Z_obj W ⟶ SC.X₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
        let g₂ : Z_obj W ⟶ SC.X₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
        have hα₁ : α₁ = CategoryTheory.Abelian.Ext.mk₀ g₁ :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₁).symm
        have hα₂ : α₂ = CategoryTheory.Abelian.Ext.mk₀ g₂ :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₂).symm
        have hmk : CategoryTheory.Abelian.Ext.mk₀ (g₁ ≫ SC.f) =
            CategoryTheory.Abelian.Ext.mk₀ (g₂ ≫ SC.f) := by
          calc
            CategoryTheory.Abelian.Ext.mk₀ (g₁ ≫ SC.f)
              = (CategoryTheory.Abelian.Ext.mk₀ g₁).comp
                  (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 0) :=
                (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ g₁ SC.f).symm
            _ = ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 0)) α₁ := by
                rw [← hα₁]; rfl
            _ = ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 0)) α₂ := hα
            _ = (CategoryTheory.Abelian.Ext.mk₀ g₂).comp
                  (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 0) := by
                rw [← hα₂]; rfl
            _ = CategoryTheory.Abelian.Ext.mk₀ (g₂ ≫ SC.f) :=
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ g₂ SC.f
        have hgf : g₁ ≫ SC.f = g₂ ≫ SC.f := by
          have heq := congrArg CategoryTheory.Abelian.Ext.addEquiv₀ hmk
          rwa [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
            ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
            AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply] at heq
        have hg : g₁ = g₂ := (cancel_mono SC.f).mp hgf
        rw [hα₁, hα₂, hg]
      have hMono_WB : CategoryTheory.Mono (W_B.map u_pre₀) := by
        have : ∀ V : Opposite S.Etale, CategoryTheory.Mono ((W_B.map u_pre₀).app V) :=
          fun V => hMono_W (B_f.op.obj V)
        exact CategoryTheory.NatTrans.mono_of_mono_app (W_B.map u_pre₀)
      change CategoryTheory.Mono (Sh_S.map (W_B.map u_pre₀))
      exact Sh_S.map_mono (W_B.map u_pre₀)
    have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
        (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})),
        (∀ W : Opposite X.Etale,
          (K.map ((CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
        K.Exact := by
      intro K hW
      rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
        CategoryTheory.Functor.isZero_iff]
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
      have h0 : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
        (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
      exact h0.of_iso (K.mapLeftHomologyIso evW).symm
    have hJoints : ∀ q : ℕ,
        let u_q := weilEtaleHigherDirectImageMap f q SC.f
        let v_q := weilEtaleHigherDirectImageMap f q SC.g
        let δ_q := weilSmPencilLerayConnHom f SC hSE q
        let u_succ := weilEtaleHigherDirectImageMap f (q + 1) SC.f
        ∃ (h_uv : CategoryTheory.CategoryStruct.comp u_q v_q = 0)
          (h_vδ : CategoryTheory.CategoryStruct.comp v_q δ_q = 0)
          (h_δu : CategoryTheory.CategoryStruct.comp δ_q u_succ = 0),
          (CategoryTheory.ShortComplex.mk u_q v_q h_uv).Exact ∧
          (CategoryTheory.ShortComplex.mk v_q δ_q h_vδ).Exact ∧
          (CategoryTheory.ShortComplex.mk δ_q u_succ h_δu).Exact := by
      intro q
      dsimp only []
      let u_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.f
      let v_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g
      let u_succ_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f
      let δ_pre : SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1) :=
        { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
          naturality := fun {W₁ W₂} ω => by
            have hL : (SC.X₃.cohomologyPresheaf q).map ω =
                ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
            have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
                ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
            rw [hL, hR,
              CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
              CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
            ext α
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
              (Nat.zero_add q) rfl (by omega) }
      have hu_app : ∀ W : Opposite X.Etale,
          u_pre.app W = AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero q)) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.f
      have hv_app : ∀ W : Opposite X.Etale,
          v_pre.app W = AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.g
      have husucc_app : ∀ W : Opposite X.Etale,
          u_succ_pre.app W = AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) SC.f
      have h_uv_pre : u_pre ≫ v_pre = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE q
        have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        change ((u_pre.app W ≫ v_pre.app W).hom) x = 0
        rw [hu_app W, hv_app W]
        exact congrArg (fun φ : AddCommGrpCat.of (CategoryTheory.Abelian.Ext (Z_obj W) SC.X₁ q) ⟶
          AddCommGrpCat.of (CategoryTheory.Abelian.Ext (Z_obj W) SC.X₃ q) => φ.hom x) hz
      have h_vδ_pre : v_pre ≫ δ_pre = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        change ((v_pre.app W ≫ δ_pre.app W).hom) x = 0
        rw [hv_app W]
        exact congrArg (fun φ : AddCommGrpCat.of (CategoryTheory.Abelian.Ext (Z_obj W) SC.X₂ q) ⟶
          AddCommGrpCat.of (CategoryTheory.Abelian.Ext (Z_obj W) SC.X₁ (q + 1)) => φ.hom x) hz
      have h_δu_pre : δ_pre ≫ u_succ_pre = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        change ((δ_pre.app W ≫ u_succ_pre.app W).hom) x = 0
        rw [husucc_app W]
        exact congrArg (fun φ : AddCommGrpCat.of (CategoryTheory.Abelian.Ext (Z_obj W) SC.X₃ q) ⟶
          AddCommGrpCat.of (CategoryTheory.Abelian.Ext (Z_obj W) SC.X₂ (q + 1)) => φ.hom x) hz
      let K_uv := CategoryTheory.ShortComplex.mk u_pre v_pre h_uv_pre
      let K_vδ := CategoryTheory.ShortComplex.mk v_pre δ_pre h_vδ_pre
      let K_δu := CategoryTheory.ShortComplex.mk δ_pre u_succ_pre h_δu_pre
      have hK_uv : K_uv.Exact := by
        apply hPresheafExact
        intro W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE q
        refine (CategoryTheory.ShortComplex.exact_iff_of_iso
          (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
        · simp [K_uv, hu_app W]
          exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
        · simp [K_uv, hv_app W]
          exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
      have hK_vδ : K_vδ.Exact := by
        apply hPresheafExact
        intro W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        refine (CategoryTheory.ShortComplex.exact_iff_of_iso
          (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
        · simp [K_vδ, hv_app W]
          exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
        · simp [K_vδ, δ_pre]
          exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
      have hK_δu : K_δu.Exact := by
        apply hPresheafExact
        intro W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        refine (CategoryTheory.ShortComplex.exact_iff_of_iso
          (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
        · simp [K_δu, δ_pre]
          exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
        · simp [K_δu, husucc_app W]
          exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
      have h_uv : CategoryTheory.CategoryStruct.comp
          (weilEtaleHigherDirectImageMap f q SC.f)
          (weilEtaleHigherDirectImageMap f q SC.g) = 0 := by
        change Sh_S.map (W_B.map u_pre) ≫ Sh_S.map (W_B.map v_pre) = 0
        rw [← Sh_S.map_comp, ← W_B.map_comp, h_uv_pre, W_B.map_zero, Sh_S.map_zero]
      have h_vδ : CategoryTheory.CategoryStruct.comp
          (weilEtaleHigherDirectImageMap f q SC.g)
          (weilSmPencilLerayConnHom f SC hSE q) = 0 := by
        change Sh_S.map (W_B.map v_pre) ≫ Sh_S.map (W_B.map δ_pre) = 0
        rw [← Sh_S.map_comp, ← W_B.map_comp, h_vδ_pre, W_B.map_zero, Sh_S.map_zero]
      have h_δu : CategoryTheory.CategoryStruct.comp
          (weilSmPencilLerayConnHom f SC hSE q)
          (weilEtaleHigherDirectImageMap f (q + 1) SC.f) = 0 := by
        change Sh_S.map (W_B.map δ_pre) ≫ Sh_S.map (W_B.map u_succ_pre) = 0
        rw [← Sh_S.map_comp, ← W_B.map_comp, h_δu_pre, W_B.map_zero, Sh_S.map_zero]
      refine ⟨h_uv, h_vδ, h_δu, ?_, ?_, ?_⟩
      · exact (hK_uv.map W_B).map Sh_S
      · exact (hK_vδ.map W_B).map Sh_S
      · exact (hK_δu.map W_B).map Sh_S
    refine ⟨hMono_u0, hJoints, ?_, ?_⟩
    · intro h_vδ0
      dsimp only []
      let u_0 := weilEtaleHigherDirectImageMap f 0 SC.f
      let v_0 := weilEtaleHigherDirectImageMap f 0 SC.g
      let δ_0 := weilSmPencilLerayConnHom f SC hSE 0
      obtain ⟨h_uv0, h_vδ0', _, hEx_uv0, hEx_vδ0', _⟩ := hJoints 0
      have hEx_vδ0 : (CategoryTheory.ShortComplex.mk v_0 δ_0 h_vδ0).Exact := by
        convert hEx_vδ0'
      let p_0 := CategoryTheory.Limits.kernel.lift δ_0 v_0 h_vδ0
      have : CategoryTheory.Epi p_0 := hEx_vδ0.epi_kernelLift
      have h0 : CategoryTheory.CategoryStruct.comp u_0 p_0 = 0 := by
        apply (cancel_mono (CategoryTheory.Limits.kernel.ι δ_0)).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι, h_uv0,
          CategoryTheory.Limits.zero_comp]
      let φ₀ : CategoryTheory.ShortComplex.mk u_0 p_0 h0 ⟶
          CategoryTheory.ShortComplex.mk u_0 v_0 h_uv0 :=
        CategoryTheory.ShortComplex.homMk (CategoryTheory.CategoryStruct.id _)
          (CategoryTheory.CategoryStruct.id _) (CategoryTheory.Limits.kernel.ι δ_0)
          (by simp) (by dsimp [p_0]; simp)
      have hEx_0 : (CategoryTheory.ShortComplex.mk u_0 p_0 h0).Exact :=
        (@CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ φ₀
          (by change CategoryTheory.Epi (CategoryTheory.CategoryStruct.id _); infer_instance)
          (by change CategoryTheory.IsIso (CategoryTheory.CategoryStruct.id _); infer_instance)
          (by change CategoryTheory.Mono (CategoryTheory.Limits.kernel.ι δ_0); infer_instance)).mpr hEx_uv0
      exact ⟨h0, CategoryTheory.ShortComplex.ShortExact.mk' hEx_0 hMono_u0 inferInstance⟩
    · intro k h_δu h_vδ
      dsimp only []
      let δ_k := weilSmPencilLerayConnHom f SC hSE k
      let u_1 := weilEtaleHigherDirectImageMap f (k + 1) SC.f
      let v_1 := weilEtaleHigherDirectImageMap f (k + 1) SC.g
      let δ_1 := weilSmPencilLerayConnHom f SC hSE (k + 1)
      obtain ⟨_, _, h_δu', _, _, hEx_δu'⟩ := hJoints k
      obtain ⟨h_uv1, h_vδ', _, hEx_uv1, hEx_vδ', _⟩ := hJoints (k + 1)
      have hEx_δu : (CategoryTheory.ShortComplex.mk δ_k u_1 h_δu).Exact := by
        convert hEx_δu'
      have hEx_vδ : (CategoryTheory.ShortComplex.mk v_1 δ_1 h_vδ).Exact := by
        convert hEx_vδ'
      let j_1 := CategoryTheory.Limits.cokernel.desc δ_k u_1 h_δu
      let p_2 := CategoryTheory.Limits.kernel.lift δ_1 v_1 h_vδ
      have : CategoryTheory.Mono j_1 := hEx_δu.mono_cokernelDesc
      have : CategoryTheory.Epi p_2 := hEx_vδ.epi_kernelLift
      have h_up2 : CategoryTheory.CategoryStruct.comp u_1 p_2 = 0 := by
        apply (cancel_mono (CategoryTheory.Limits.kernel.ι δ_1)).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι, h_uv1,
          CategoryTheory.Limits.zero_comp]
      have h_mid : CategoryTheory.CategoryStruct.comp j_1 p_2 = 0 := by
        apply (cancel_epi (CategoryTheory.Limits.cokernel.π δ_k)).mp
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc, h_up2,
          CategoryTheory.Limits.comp_zero]
      let S_up := CategoryTheory.ShortComplex.mk u_1 p_2 h_up2
      let ψ_R : S_up ⟶ CategoryTheory.ShortComplex.mk u_1 v_1 h_uv1 :=
        CategoryTheory.ShortComplex.homMk (CategoryTheory.CategoryStruct.id _)
          (CategoryTheory.CategoryStruct.id _) (CategoryTheory.Limits.kernel.ι δ_1)
          (by simp [S_up]) (by dsimp [S_up, p_2]; simp)
      have hEx_up : S_up.Exact :=
        (@CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ ψ_R
          (by change CategoryTheory.Epi (CategoryTheory.CategoryStruct.id _); infer_instance)
          (by change CategoryTheory.IsIso (CategoryTheory.CategoryStruct.id _); infer_instance)
          (by change CategoryTheory.Mono (CategoryTheory.Limits.kernel.ι δ_1); infer_instance)).mpr hEx_uv1
      let ψ_L : S_up ⟶ CategoryTheory.ShortComplex.mk j_1 p_2 h_mid :=
        CategoryTheory.ShortComplex.homMk (CategoryTheory.Limits.cokernel.π δ_k)
          (CategoryTheory.CategoryStruct.id _) (CategoryTheory.CategoryStruct.id _)
          (by dsimp [S_up, j_1]; simp) (by simp [S_up])
      have hEx_mid : (CategoryTheory.ShortComplex.mk j_1 p_2 h_mid).Exact :=
        (@CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ ψ_L
          (by change CategoryTheory.Epi (CategoryTheory.Limits.cokernel.π δ_k); infer_instance)
          (by change CategoryTheory.IsIso (CategoryTheory.CategoryStruct.id _); infer_instance)
          (by change CategoryTheory.Mono (CategoryTheory.CategoryStruct.id _); infer_instance)).mp hEx_up
      exact ⟨h_mid, CategoryTheory.ShortComplex.ShortExact.mk' hEx_mid inferInstance inferInstance⟩

theorem weil_sm_pencil_zmod_bockstein_and_torsionH_exact_row (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleTorsionSheaf W (ℓ ^ 0)) ∧
      Subsingleton (weilEtaleTorsionH W (ℓ ^ 0) q)) ∧
    (∀ (r : ℕ),
      ∃ (φ₁₂ : ZMod (ℓ ^ r) →+ ZMod (ℓ ^ (r + 1)))
        (φ₂₃ : ZMod (ℓ ^ (r + 1)) →+ ZMod (ℓ ^ 1)),
        ∀ (W : AlgebraicGeometry.Scheme.{u}),
          let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
          let Fℤ_W := C_W.obj (AddCommGrpCat.of (ULift.{u} ℤ))
          ∃ (h0_W : CategoryTheory.CategoryStruct.comp
              (C_W.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₁₂)))
              (C_W.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₂₃))) = 0)
            (hSE_W : (CategoryTheory.ShortComplex.mk _ _ h0_W).ShortExact),
            let u_W := fun deg : ℕ =>
              (CategoryTheory.Abelian.Ext.mk₀
                (C_W.map (AddCommGrpCat.uliftFunctor.{u, 0}.map
                  (AddCommGrpCat.ofHom φ₁₂)))).postcomp Fℤ_W (Nat.add_zero deg)
            let v_W := fun deg : ℕ =>
              (CategoryTheory.Abelian.Ext.mk₀
                (C_W.map (AddCommGrpCat.uliftFunctor.{u, 0}.map
                  (AddCommGrpCat.ofHom φ₂₃)))).postcomp Fℤ_W (Nat.add_zero deg)
            let δ_W := fun deg : ℕ =>
              hSE_W.extClass.postcomp Fℤ_W (rfl : deg + 1 = deg + 1)
            Function.Injective (u_W 0) ∧
            ∀ (q : ℕ),
              Function.Exact (u_W q) (v_W q) ∧
              Function.Exact (v_W q) (δ_W q) ∧
              Function.Exact (δ_W q) (u_W (q + 1))) :=
by
  refine ⟨?_, ?_⟩
  · intro W q
    let U := AddCommGrpCat.uliftFunctor.{u, 0}
    let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
    have : C_W.PreservesZeroMorphisms := by
      dsimp [C_W]
      unfold CategoryTheory.constantSheaf
      infer_instance
    have hSub₀ : Subsingleton ↥(AddCommGrpCat.of (ZMod (ℓ ^ 0))) := by
      change Subsingleton (ZMod (ℓ ^ 0))
      rw [pow_zero]
      infer_instance
    have hZ₀ : CategoryTheory.Limits.IsZero (AddCommGrpCat.of (ZMod (ℓ ^ 0))) :=
      AddCommGrpCat.isZero_iff_subsingleton.mpr hSub₀
    have hZ_U : CategoryTheory.Limits.IsZero (U.obj (AddCommGrpCat.of (ZMod (ℓ ^ 0)))) :=
      CategoryTheory.Functor.map_isZero U hZ₀
    have hZero_W : CategoryTheory.Limits.IsZero (weilEtaleTorsionSheaf W (ℓ ^ 0)) :=
      CategoryTheory.Functor.map_isZero C_W hZ_U
    exact ⟨hZero_W, CategoryTheory.Sheaf.subsingleton_H_of_isZero hZero_W q⟩
  · intro r
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_pos : 0 < ℓ := hPrime.pos
    have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
    have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_ne⟩
    have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
    have : NeZero (ℓ ^ 1) := ⟨pow_ne_zero 1 hℓ_ne⟩
    let φ₁₂ : ZMod (ℓ ^ r) →+ ZMod (ℓ ^ (r + 1)) :=
      { toFun := fun x => ((ℓ * x.val : ℕ) : ZMod (ℓ ^ (r + 1)))
        map_zero' := by
          rw [ZMod.val_zero, mul_zero, Nat.cast_zero]
        map_add' := by
          intro x₁ x₂
          have hval : (x₁ + x₂).val = (x₁.val + x₂.val) % (ℓ ^ r) := ZMod.val_add x₁ x₂
          let q_div : ℕ := (x₁.val + x₂.val) / (ℓ ^ r)
          have hdiv : ℓ ^ r * q_div + (x₁ + x₂).val = x₁.val + x₂.val := by
            dsimp [q_div]
            rw [hval]
            exact Nat.div_add_mod (x₁.val + x₂.val) (ℓ ^ r)
          have hmul : ℓ ^ (r + 1) * q_div + ℓ * (x₁ + x₂).val = ℓ * x₁.val + ℓ * x₂.val := by
            calc
              ℓ ^ (r + 1) * q_div + ℓ * (x₁ + x₂).val
                  = (ℓ * ℓ ^ r) * q_div + ℓ * (x₁ + x₂).val := by rw [pow_succ' ℓ r]
              _ = ℓ * (ℓ ^ r * q_div + (x₁ + x₂).val) := by ring
              _ = ℓ * (x₁.val + x₂.val) := by rw [hdiv]
              _ = ℓ * x₁.val + ℓ * x₂.val := by ring
          have hzero_term : ((ℓ ^ (r + 1) * q_div : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 := by
            rw [Nat.cast_mul, ZMod.natCast_self, zero_mul]
          have hcast := congrArg (Nat.cast : ℕ → ZMod (ℓ ^ (r + 1))) hmul
          rw [Nat.cast_add, Nat.cast_add, hzero_term, zero_add] at hcast
          exact hcast }
    have hdvd : ℓ ^ 1 ∣ ℓ ^ (r + 1) :=
      Nat.pow_dvd_pow ℓ (Nat.succ_le_succ (Nat.zero_le r))
    let φ₂₃ : ZMod (ℓ ^ (r + 1)) →+ ZMod (ℓ ^ 1) :=
      (ZMod.castHom hdvd (ZMod (ℓ ^ 1))).toAddMonoidHom
    have hφ₂₃_val : ∀ y : ZMod (ℓ ^ (r + 1)), φ₂₃ y = ((y.val : ℕ) : ZMod (ℓ ^ 1)) := by
      intro y
      change ZMod.castHom hdvd (ZMod (ℓ ^ 1)) y = ((y.val : ℕ) : ZMod (ℓ ^ 1))
      conv_lhs => rw [← ZMod.natCast_zmod_val y]
      exact map_natCast (ZMod.castHom hdvd (ZMod (ℓ ^ 1))) y.val
    have hInj₁₂ : Function.Injective φ₁₂ := by
      refine (injective_iff_map_eq_zero φ₁₂).mpr ?_
      intro x hx
      change ((ℓ * x.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 at hx
      have hdvd_x : ℓ ^ (r + 1) ∣ ℓ * x.val :=
        (ZMod.natCast_eq_zero_iff (ℓ * x.val) (ℓ ^ (r + 1))).mp hx
      have hlt_x : ℓ * x.val < ℓ ^ (r + 1) := by
        rw [pow_succ' ℓ r]
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt x) hℓ_pos
      have hmul_zero : ℓ * x.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_x hlt_x
      have hval_zero : x.val = 0 := (Nat.mul_eq_zero.mp hmul_zero).resolve_left hℓ_ne
      apply ZMod.val_injective
      rw [hval_zero, ZMod.val_zero]
    have hSurj₂₃ : Function.Surjective φ₂₃ := by
      intro z
      refine ⟨((z.val : ℕ) : ZMod (ℓ ^ (r + 1))), ?_⟩
      change ZMod.castHom hdvd (ZMod (ℓ ^ 1)) ((z.val : ℕ) : ZMod (ℓ ^ (r + 1))) = z
      rw [map_natCast, ZMod.natCast_zmod_val]
    have hComp₀ : ∀ x : ZMod (ℓ ^ r), φ₂₃ (φ₁₂ x) = 0 := by
      intro x
      change ZMod.castHom hdvd (ZMod (ℓ ^ 1)) ((ℓ * x.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0
      rw [map_natCast]
      exact (ZMod.natCast_eq_zero_iff (ℓ * x.val) (ℓ ^ 1)).mpr ⟨x.val, by rw [pow_one]⟩
    have hKer₂₃ : ∀ y : ZMod (ℓ ^ (r + 1)), φ₂₃ y = 0 → ∃ x : ZMod (ℓ ^ r), φ₁₂ x = y := by
      intro y hy
      rw [hφ₂₃_val y] at hy
      have hdvd_y : ℓ ^ 1 ∣ y.val := (ZMod.natCast_eq_zero_iff y.val (ℓ ^ 1)).mp hy
      rw [pow_one] at hdvd_y
      rcases hdvd_y with ⟨d, hd⟩
      have hd_lt : d < ℓ ^ r := by
        have hy_lt : y.val < ℓ * ℓ ^ r := by
          rw [← pow_succ' ℓ r]
          exact ZMod.val_lt y
        rw [hd] at hy_lt
        exact (Nat.mul_lt_mul_left hℓ_pos).mp hy_lt
      refine ⟨((d : ℕ) : ZMod (ℓ ^ r)), ?_⟩
      change ((ℓ * (((d : ℕ) : ZMod (ℓ ^ r)).val) : ℕ) : ZMod (ℓ ^ (r + 1))) = y
      rw [ZMod.val_natCast_of_lt hd_lt, ← hd, ZMod.natCast_zmod_val]
    let f₀ : AddCommGrpCat.of (ZMod (ℓ ^ r)) ⟶ AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))) :=
      AddCommGrpCat.ofHom φ₁₂
    let g₀ : AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))) ⟶ AddCommGrpCat.of (ZMod (ℓ ^ 1)) :=
      AddCommGrpCat.ofHom φ₂₃
    have h0₀ : CategoryTheory.CategoryStruct.comp f₀ g₀ = 0 := by
      ext x
      exact hComp₀ x
    let SC₀ := CategoryTheory.ShortComplex.mk f₀ g₀ h0₀
    have hMono₀ : CategoryTheory.Mono SC₀.f :=
      (AddCommGrpCat.mono_iff_injective f₀).mpr hInj₁₂
    have hEpi₀ : CategoryTheory.Epi SC₀.g :=
      (AddCommGrpCat.epi_iff_surjective g₀).mpr hSurj₂₃
    have hEx₀ : SC₀.Exact :=
      (CategoryTheory.ShortComplex.ab_exact_iff SC₀).mpr hKer₂₃
    have hSE₀ : SC₀.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hEx₀ hMono₀ hEpi₀
    let U := AddCommGrpCat.uliftFunctor.{u, 0}
    have hSE_U : (SC₀.map U).ShortExact := hSE₀.map_of_exact U
    refine ⟨φ₁₂, φ₂₃, ?_⟩
    intro W
    let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
    let Fℤ_W := C_W.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    have : CategoryTheory.Limits.PreservesFiniteLimits C_W :=
      CategoryTheory.Limits.comp_preservesFiniteLimits
        (CategoryTheory.Functor.const (Opposite W.Etale))
        (CategoryTheory.presheafToSheaf W.smallEtaleTopology AddCommGrpCat.{u})
    have : C_W.PreservesZeroMorphisms := by
      dsimp [C_W]
      unfold CategoryTheory.constantSheaf
      infer_instance
    let SC_W := (SC₀.map U).map C_W
    let h0_W : CategoryTheory.CategoryStruct.comp
        (C_W.map (U.map f₀)) (C_W.map (U.map g₀)) = 0 := SC_W.zero
    have hSE_W : (CategoryTheory.ShortComplex.mk _ _ h0_W).ShortExact :=
      hSE_U.map_of_exact C_W
    refine ⟨h0_W, hSE_W, ?_, ?_⟩
    · have : CategoryTheory.Mono SC_W.f := hSE_W.mono_f
      intro x₁ x₂ hu
      let g₁ : Fℤ_W ⟶ SC_W.X₁ := CategoryTheory.Abelian.Ext.homEquiv₀ x₁
      let g₂ : Fℤ_W ⟶ SC_W.X₁ := CategoryTheory.Abelian.Ext.homEquiv₀ x₂
      have hx₁ : CategoryTheory.Abelian.Ext.mk₀ g₁ = x₁ := by
        rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
        exact CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x₁
      have hx₂ : CategoryTheory.Abelian.Ext.mk₀ g₂ = x₂ := by
        rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
        exact CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x₂
      change x₁.comp (CategoryTheory.Abelian.Ext.mk₀ SC_W.f) (Nat.add_zero 0) =
        x₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC_W.f) (Nat.add_zero 0) at hu
      rw [← hx₁, ← hx₂, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hu
      have hhom : CategoryTheory.Abelian.Ext.homEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp g₁ SC_W.f) :
              CategoryTheory.Abelian.Ext Fℤ_W SC_W.X₂ 0) =
          CategoryTheory.Abelian.Ext.homEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp g₂ SC_W.f) :
              CategoryTheory.Abelian.Ext Fℤ_W SC_W.X₂ 0) :=
        congrArg CategoryTheory.Abelian.Ext.homEquiv₀ hu
      rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
        ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
        CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply,
        CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply] at hhom
      have hg : g₁ = g₂ := (cancel_mono SC_W.f).mp hhom
      exact hx₁.symm.trans ((congrArg CategoryTheory.Abelian.Ext.mk₀ hg).trans hx₂)
    · intro q
      refine ⟨?_, ?_, ?_⟩
      · exact (CategoryTheory.ShortComplex.ab_exact_iff_function_exact _).mp
          (CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' Fℤ_W hSE_W q)
      · exact (CategoryTheory.ShortComplex.ab_exact_iff_function_exact _).mp
          (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' Fℤ_W hSE_W q (q + 1) rfl)
      · exact (CategoryTheory.ShortComplex.ab_exact_iff_function_exact _).mp
          (CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' Fℤ_W hSE_W q (q + 1) rfl)

theorem weil_sm_pencil_bockstein_global_const_and_fiber_eval (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (Y : AlgebraicGeometry.Scheme.{u})
        (π_Y : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (hT_Y : CategoryTheory.Limits.IsTerminal
          ((weilEtaleSitePullback π_Y).obj
            (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k)))))
        (𝒢 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Function.Bijective
        (weilOuterTrFibEdgeHom π_Y
          (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k)))
          hT_Y 𝒢 q)) ∧
    ((ℓ : k) ≠ 0 →
      ∀ (Z_over P_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          [AlgebraicGeometry.LocallyOfFiniteType P_over.hom]
          (f_over : Z_over ⟶ P_over) [AlgebraicGeometry.IsProper f_over.left],
        WeilCanonicalModPrimePBC ℓ f_over.left) ∧
    (∀ (sys : WeilEtaleSitePullbackSys.{u})
        (P : AlgebraicGeometry.Scheme.{u})
        (u : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) P)
        (hT_pull : CategoryTheory.Limits.IsTerminal
          ((weilEtaleSitePullback u).obj (weilEtaleIdTerminal.{u} P))),
      let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
      let T_P := weilEtaleIdTerminal.{u} P
      let hT_P := weilEtaleIdTerminalIsTerminal.{u} P
      let T_k := weilEtaleIdTerminal.{u} S_k
      letI := (sys u).hCont
      letI := (sys u).hAdj
      let pf_u := (weilEtaleSitePullback u).sheafPushforwardContinuous
        AddCommGrpCat.{u} P.smallEtaleTopology S_k.smallEtaleTopology
      let adj_u := (weilEtaleSitePullback u).sheafAdjunctionContinuous
        AddCommGrpCat.{u} P.smallEtaleTopology S_k.smallEtaleTopology
      ∀ (𝒢 : CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u})
        (ℱ' : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u})
        (β : Quiver.Hom 𝒢 (pf_u.obj ℱ')),
        CategoryTheory.IsIso
          ((CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u} hT_P).counit.app 𝒢) →
        CategoryTheory.IsIso ((adj_u.homEquiv 𝒢 ℱ').symm β) →
        Function.Bijective
          (((ℱ'.obj.map (Opposite.op (hT_pull.from T_k))).hom).comp
            ((β.hom.app (Opposite.op T_P)).hom))) ∧
    (∀ (Z P Z_u : AlgebraicGeometry.Scheme.{u})
        [Nonempty ↥P] [PreconnectedSpace ↥P]
        (f : Quiver.Hom Z P),
      let T_P := weilEtaleIdTerminal.{u} P
      let hT_P := weilEtaleIdTerminalIsTerminal.{u} P
      let C_Z := CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
      let C_Zu := CategoryTheory.constantSheaf Z_u.smallEtaleTopology AddCommGrpCat.{u}
      let Fℤ_Zu := C_Zu.obj (AddCommGrpCat.of (ULift.{u} ℤ))
      (∀ (r : ℕ) (A : AddCommGrpCat.{u}),
        Finite ↥A →
        (ℓ ^ r) • CategoryTheory.CategoryStruct.id A = 0 →
        Subsingleton
          (((CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}).obj A).H 1)) →
      (∀ q : ℕ,
        Finite ↥((weilEtaleHigherDirectImage f q
            (weilEtaleTorsionSheaf Z (ℓ ^ 1))).obj.obj (Opposite.op T_P)) ∧
          CategoryTheory.IsIso
            ((CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u} hT_P).counit.app
              (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z (ℓ ^ 1))))) →
      ∀ (ev : ∀ (q r : ℕ),
