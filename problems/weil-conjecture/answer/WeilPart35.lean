            (j_E ≫ (Fgt.obj (U_aff.obj A₁.1)).hom) = y₀
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, A₁.2.2]
        obtain ⟨k, w_k, hwk⟩ := hShrink E_et ⟨η_E, hη_over⟩
        let j_E' : (Fgt.obj E_et).left ⟶ (Fgt.obj (U_aff.obj A₁.1)).left := j_E
