      intro a b
      refine Fin.succAboveCases a ?_ ?_ b
      · rw [hCoord_R.2.2.2.2.1 a, hCoord_S.2.2.2.2.1 a, map_one]
      · intro i
        rw [← (hθ_R a).2 i]
        dsimp only [ψ_chart, RingHom.comp_apply]
        change θ_S a (MvPolynomial.map φ_RS ((θ_R a).symm (θ_R a (MvPolynomial.X i)))) = _
        rw [(θ_R a).symm_apply_apply, MvPolynomial.map_X, (hθ_S a).2 i]

    let f_loc : ∀ a : Fin (N + 1), (D_S a).toScheme ⟶ P_R :=
      fun a => (hAff_S a).isoSpec.hom ≫
        AlgebraicGeometry.Spec.map (ψ_cat a) ≫
        (hAff_R a).fromSpec

    
    have hfromSpec_pre : ∀ (K₀ : Type u) [CommRing K₀]
        (hAff₀ : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K₀ N a))
        (c₀ : ∀ a : Fin (N + 1),
          K₀ →+* ↑((weilProjectiveSpaceOver K₀ N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K₀ N a))))
        (t₀ : ∀ a : Fin (N + 1), Fin (N + 1) →
          ↑((weilProjectiveSpaceOver K₀ N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K₀ N a)))),
        IsCommRingProjCoordSystem K₀ N hAff₀ c₀ t₀ →
        ∀ a a' : Fin (N + 1),
          (TopologicalSpace.Opens.map (hAff₀ a).fromSpec.base).obj (weilProjBasicOpen K₀ N a') =
            PrimeSpectrum.basicOpen (t₀ a a') := by
      intro K₀ _ hAff₀ c₀ t₀ hCoord₀ a a'
      have hsub : (TopologicalSpace.Opens.map (hAff₀ a).fromSpec.base).obj
          (weilProjBasicOpen K₀ N a') =
          (TopologicalSpace.Opens.map (hAff₀ a).fromSpec.base).obj
            (weilProjBasicOpen K₀ N a ⊓ weilProjBasicOpen K₀ N a') := by
        ext p
        have hp_mem : (hAff₀ a).fromSpec.base p ∈ weilProjBasicOpen K₀ N a := by
          have hp_top : p ∈ (⊤ : (AlgebraicGeometry.Spec _).Opens) := trivial
          rw [← (hAff₀ a).fromSpec_preimage_self] at hp_top
          exact hp_top
        exact ⟨fun h => ⟨hp_mem, h⟩, fun h => h.2⟩
      rw [hsub, ← hCoord₀.2.2.2.2.2.2.2.1 a a', (hAff₀ a).fromSpec_preimage_basicOpen]

    have hf_pre : ∀ a a' : Fin (N + 1),
        (TopologicalSpace.Opens.map (f_loc a).base).obj (D_R a') =
          (TopologicalSpace.Opens.map (D_S a).ι.base).obj (D_S a') := by
      intro a a'
      dsimp only [f_loc, D_R, D_S]
      change (TopologicalSpace.Opens.map (hAff_S a).isoSpec.hom.base).obj
          ((TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (ψ_cat a)).base).obj
            ((TopologicalSpace.Opens.map (hAff_R a).fromSpec.base).obj
              (weilProjBasicOpen R N a'))) = _
      rw [hfromSpec_pre R hAff_R c_R t_R hCoord_R a a']
      have hcomap : (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map (ψ_cat a)).base).obj
            (PrimeSpectrum.basicOpen (t_R a a')) =
          PrimeSpectrum.basicOpen (t_S a a') := by
        rw [← hψ_t a a']
        exact PrimeSpectrum.comap_basicOpen (ψ_cat a).hom (t_R a a')
      rw [hcomap, ← hfromSpec_pre S hAff_S c_S t_S hCoord_S a a']
      rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι (hAff_S a)]
      change (TopologicalSpace.Opens.map
          ((hAff_S a).isoSpec.hom ≫ (hAff_S a).isoSpec.inv ≫ (weilProjBasicOpen S N a).ι).base).obj
            (weilProjBasicOpen S N a') = _
      rw [CategoryTheory.Iso.hom_inv_id_assoc]

    
    let 𝒰_S : P_S.OpenCover := P_S.openCoverOfIsOpenCover D_S hCoord_S.2.1
    have hGlueCond : ∀ a a' : 𝒰_S.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰_S.f a) (𝒰_S.f a') ≫ f_loc a =
          CategoryTheory.Limits.pullback.snd (𝒰_S.f a) (𝒰_S.f a') ≫ f_loc a' := by
      change ∀ a a' : Fin (N + 1),
        CategoryTheory.Limits.pullback.fst (D_S a).ι (D_S a').ι ≫ f_loc a =
          CategoryTheory.Limits.pullback.snd (D_S a).ι (D_S a').ι ≫ f_loc a'
      intro a a'
      let V_S : (D_S a).toScheme.Opens := (TopologicalSpace.Opens.map (D_S a).ι.base).obj (D_S a')
      let e_pb : V_S.toScheme ≅ CategoryTheory.Limits.pullback (D_S a).ι (D_S a').ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict (D_S a).ι (D_S a')).flip.isoPullback
      rw [← cancel_epi e_pb.hom]
      have he_fst : e_pb.hom ≫ CategoryTheory.Limits.pullback.fst (D_S a).ι (D_S a').ι = V_S.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict (D_S a).ι (D_S a')).flip.isoPullback_hom_fst
      have he_snd : e_pb.hom ≫ CategoryTheory.Limits.pullback.snd (D_S a).ι (D_S a').ι =
          (D_S a).ι ∣_ (D_S a') :=
        (AlgebraicGeometry.isPullback_morphismRestrict (D_S a).ι (D_S a')).flip.isoPullback_hom_snd
      rw [← CategoryTheory.Category.assoc, he_fst, ← CategoryTheory.Category.assoc e_pb.hom, he_snd]
      let U_S_inter : P_S.Opens := D_S a ⊓ D_S a'
      have hUS_aff : AlgebraicGeometry.IsAffineOpen U_S_inter := by
        dsimp only [U_S_inter, D_S]
        rw [← hCoord_S.2.2.2.2.2.2.2.1 a a']
        exact (hAff_S a).basicOpen (t_S a a')
      have hRange_VS : Set.range U_S_inter.ι.base = Set.range (V_S.ι ≫ (D_S a).ι).base := by
        ext y
        constructor
        · rintro ⟨⟨y, hyL, hyR⟩, rfl⟩
          exact ⟨⟨⟨y, hyL⟩, hyR⟩, rfl⟩
        · rintro ⟨z, rfl⟩
          exact ⟨⟨z.1.1, z.1.2, z.2⟩, rfl⟩
      let e_US : U_S_inter.toScheme ≅ V_S.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq U_S_inter.ι (V_S.ι ≫ (D_S a).ι) hRange_VS
      have he_US_fac : e_US.hom ≫ V_S.ι ≫ (D_S a).ι = U_S_inter.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
          U_S_inter.ι (V_S.ι ≫ (D_S a).ι) hRange_VS
      rw [← cancel_epi e_US.hom]
      have hlhs_hom : e_US.hom ≫ V_S.ι = P_S.homOfLE (inf_le_left : U_S_inter ≤ D_S a) := by
        rw [← cancel_mono (D_S a).ι, CategoryTheory.Category.assoc, he_US_fac,
          AlgebraicGeometry.Scheme.homOfLE_ι]
      have hrhs_hom : e_US.hom ≫ ((D_S a).ι ∣_ (D_S a')) =
          P_S.homOfLE (inf_le_right : U_S_inter ≤ D_S a') := by
        rw [← cancel_mono (D_S a').ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc e_US.hom, he_US_fac,
          AlgebraicGeometry.Scheme.homOfLE_ι]
      rw [← CategoryTheory.Category.assoc, hlhs_hom, ← CategoryTheory.Category.assoc e_US.hom, hrhs_hom]
      let U_R_inter : P_R.Opens := D_R a ⊓ D_R a'
      have hUR_eq_basic : U_R_inter = P_R.basicOpen (t_R a a') :=
        (hCoord_R.2.2.2.2.2.2.2.1 a a').symm
      have hUR_aff : AlgebraicGeometry.IsAffineOpen U_R_inter := by
        rw [hUR_eq_basic]
        exact (hAff_R a).basicOpen (t_R a a')
      let res_RL : P_R.presheaf.obj (Opposite.op (D_R a)) ⟶ P_R.presheaf.obj (Opposite.op U_R_inter) :=
        P_R.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_R_inter ≤ D_R a)).op
      let res_RR : P_R.presheaf.obj (Opposite.op (D_R a')) ⟶ P_R.presheaf.obj (Opposite.op U_R_inter) :=
        P_R.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_R_inter ≤ D_R a')).op
      let res_SL : P_S.presheaf.obj (Opposite.op (D_S a)) ⟶ P_S.presheaf.obj (Opposite.op U_S_inter) :=
        P_S.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_S_inter ≤ D_S a)).op
      let res_SR : P_S.presheaf.obj (Opposite.op (D_S a')) ⟶ P_S.presheaf.obj (Opposite.op U_S_inter) :=
        P_S.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_S_inter ≤ D_S a')).op

      have hResFromSpec : ∀ {X₀ : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : X₀.Opens}
          (hU₁ : AlgebraicGeometry.IsAffineOpen U₁) (hU₂ : AlgebraicGeometry.IsAffineOpen U₂)
          (hle : U₂ ≤ U₁),
          AlgebraicGeometry.Spec.map (X₀.presheaf.map (CategoryTheory.homOfLE hle).op) ≫
            hU₁.fromSpec = hU₂.fromSpec := by
        intro X₀ U₁ U₂ hU₁ hU₂ hle
        have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
          (𝟙 X₀) hU₁ hU₂ hle
        rw [CategoryTheory.Category.comp_id] at h1
        have happ : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X₀) U₁ U₂ hle =
            X₀.presheaf.map (CategoryTheory.homOfLE hle).op := by
          dsimp only [AlgebraicGeometry.Scheme.Hom.appLE]
          erw [CategoryTheory.Category.id_comp]
          rfl
        rwa [happ] at h1

      have hIsoHomOfLE : ∀ {X₀ : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : X₀.Opens}
          (hU₁ : AlgebraicGeometry.IsAffineOpen U₁) (hU₂ : AlgebraicGeometry.IsAffineOpen U₂)
          (hle : U₂ ≤ U₁),
          hU₂.isoSpec.inv ≫ X₀.homOfLE hle ≫ hU₁.isoSpec.hom =
            AlgebraicGeometry.Spec.map (X₀.presheaf.map (CategoryTheory.homOfLE hle).op) := by
        intro X₀ U₁ U₂ hU₁ hU₂ hle
        have _ : AlgebraicGeometry.IsOpenImmersion hU₁.fromSpec := by
          rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]; infer_instance
        rw [← cancel_mono hU₁.fromSpec]
        simp only [CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec,
          AlgebraicGeometry.Scheme.homOfLE_ι,
          AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
        exact (hResFromSpec hU₁ hU₂ hle).symm

      have hInv_S : res_SR.hom (t_S a' a) * res_SL.hom (t_S a a') = 1 := by
        have h10 := hCoord_S.2.2.2.2.2.2.2.2.2 a a' a
        rw [hCoord_S.2.2.2.2.1 a, map_one] at h10
        exact h10

      have hUnit_SL : ∀ y : Submonoid.powers (t_R a a'),
          IsUnit ((res_SL.hom.comp (ψ_chart a)) y.1) := by
        rintro ⟨_, k, rfl⟩
        simp only [RingHom.comp_apply, map_pow, hψ_t a a']
        exact IsUnit.pow k ⟨⟨res_SL.hom (t_S a a'), res_SR.hom (t_S a' a),
          (mul_comm _ _).trans hInv_S, hInv_S⟩, rfl⟩

      have _ : IsLocalization.Away (t_R a a')
          ↑(P_R.presheaf.obj (Opposite.op (P_R.basicOpen (t_R a a')))) :=
        (hAff_R a).isLocalization_basicOpen (t_R a a')
      let e_eq : P_R.presheaf.obj (Opposite.op (P_R.basicOpen (t_R a a'))) ≅
          P_R.presheaf.obj (Opposite.op U_R_inter) :=
        P_R.presheaf.mapIso (CategoryTheory.eqToIso hUR_eq_basic).op
      let ρ_basic : ↑(P_R.presheaf.obj (Opposite.op (P_R.basicOpen (t_R a a')))) →+*
          ↑(P_S.presheaf.obj (Opposite.op U_S_inter)) :=
        IsLocalization.lift (M := Submonoid.powers (t_R a a'))
          (g := res_SL.hom.comp (ψ_chart a)) hUnit_SL
      let ρ_inter : ↑(P_R.presheaf.obj (Opposite.op U_R_inter)) →+*
          ↑(P_S.presheaf.obj (Opposite.op U_S_inter)) :=
        ρ_basic.comp e_eq.inv.hom
      let ρ_inter_cat : P_R.presheaf.obj (Opposite.op U_R_inter) ⟶
          P_S.presheaf.obj (Opposite.op U_S_inter) :=
        @CommRingCat.ofHom _ _
          (inferInstance : CommRing ↑(P_R.presheaf.obj (Opposite.op U_R_inter)))
          (inferInstance : CommRing ↑(P_S.presheaf.obj (Opposite.op U_S_inter)))
          ρ_inter

      have hρ_L : ρ_inter.comp res_RL.hom = res_SL.hom.comp (ψ_chart a) := by
        apply RingHom.ext
        intro x
        have heq_alg : e_eq.inv.hom (res_RL.hom x) =
            algebraMap ↑(P_R.presheaf.obj (Opposite.op (D_R a)))
              ↑(P_R.presheaf.obj (Opposite.op (P_R.basicOpen (t_R a a')))) x := by
          change (res_RL ≫ e_eq.inv).hom x = (P_R.presheaf.map _).hom x
          congr 2
        dsimp only [ρ_inter, RingHom.comp_apply]
        rw [heq_alg]
        exact IsLocalization.lift_eq (M := Submonoid.powers (t_R a a')) hUnit_SL x

      have hρ_R : ρ_inter.comp res_RR.hom = res_SR.hom.comp (ψ_chart a') := by
        apply hExt_coord a'
        · apply RingHom.ext
          intro r
          simp only [RingHom.comp_apply]
          have hcR : res_RR.hom (c_R a' r) = res_RL.hom (c_R a r) :=
            hCoord_R.2.2.2.2.2.2.2.2.1 a a' r
          have hcS : res_SR.hom (c_S a' (φ_RS r)) = res_SL.hom (c_S a (φ_RS r)) :=
            hCoord_S.2.2.2.2.2.2.2.2.1 a a' (φ_RS r)
          rw [hcR]
          have hL_ap := RingHom.congr_fun hρ_L (c_R a r)
          simp only [RingHom.comp_apply] at hL_ap
          rw [hL_ap, hψ_c a r, hψ_c a' r, hcS]
        · intro b
          simp only [RingHom.comp_apply]
          rw [hψ_t a' b]
          have hmul_eq : ρ_inter (res_RR.hom (t_R a' b)) * res_SL.hom (t_S a a') =
              res_SL.hom (t_S a b) := by
            have hL_aa' := RingHom.congr_fun hρ_L (t_R a a')
            have hL_ab := RingHom.congr_fun hρ_L (t_R a b)
            simp only [RingHom.comp_apply, hψ_t] at hL_aa' hL_ab
            rw [← hL_aa', ← map_mul, hCoord_R.2.2.2.2.2.2.2.2.2 a a' b, hL_ab]
          calc
            ρ_inter (res_RR.hom (t_R a' b))
                = ρ_inter (res_RR.hom (t_R a' b)) * (res_SL.hom (t_S a a') * res_SR.hom (t_S a' a)) := by
                  rw [mul_comm (res_SL.hom _), hInv_S, mul_one]
            _ = (ρ_inter (res_RR.hom (t_R a' b)) * res_SL.hom (t_S a a')) * res_SR.hom (t_S a' a) := by
                  ring
            _ = res_SL.hom (t_S a b) * res_SR.hom (t_S a' a) := by
                  rw [hmul_eq]
            _ = (res_SR.hom (t_S a' b) * res_SL.hom (t_S a a')) * res_SR.hom (t_S a' a) := by
                  rw [hCoord_S.2.2.2.2.2.2.2.2.2 a a' b]
            _ = res_SR.hom (t_S a' b) * (res_SR.hom (t_S a' a) * res_SL.hom (t_S a a')) := by
                  ring
            _ = res_SR.hom (t_S a' b) := by
                  rw [hInv_S, mul_one]

      rw [← cancel_epi hUS_aff.isoSpec.inv]
      dsimp only [f_loc]
      calc
        hUS_aff.isoSpec.inv ≫ (P_S.homOfLE (inf_le_left : U_S_inter ≤ D_S a) ≫
            ((hAff_S a).isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (ψ_cat a) ≫
              (hAff_R a).fromSpec))
            = (hUS_aff.isoSpec.inv ≫ P_S.homOfLE (inf_le_left : U_S_inter ≤ D_S a) ≫
                (hAff_S a).isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map (ψ_cat a) ≫
              (hAff_R a).fromSpec := by simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (ψ_cat a ≫ res_SL) ≫
              (hAff_R a).fromSpec := by
              rw [hIsoHomOfLE (hAff_S a) hUS_aff inf_le_left,
                ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (res_RL ≫ ρ_inter_cat) ≫
              (hAff_R a).fromSpec := by
              have hcatL : ψ_cat a ≫ res_SL = res_RL ≫ ρ_inter_cat :=
                CommRingCat.hom_ext hρ_L.symm
              rw [hcatL]
        _ = AlgebraicGeometry.Spec.map ρ_inter_cat ≫ hUR_aff.fromSpec := by
              rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
                hResFromSpec (hAff_R a) hUR_aff inf_le_left]
        _ = AlgebraicGeometry.Spec.map (res_RR ≫ ρ_inter_cat) ≫
              (hAff_R a').fromSpec := by
              rw [← hResFromSpec (hAff_R a') hUR_aff inf_le_right,
                ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (ψ_cat a' ≫ res_SR) ≫
              (hAff_R a').fromSpec := by
              have hcatR : res_RR ≫ ρ_inter_cat = ψ_cat a' ≫ res_SR :=
                CommRingCat.hom_ext hρ_R
              rw [hcatR]
        _ = (hUS_aff.isoSpec.inv ≫ P_S.homOfLE (inf_le_right : U_S_inter ≤ D_S a') ≫
              (hAff_S a').isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map (ψ_cat a') ≫
              (hAff_R a').fromSpec := by
              rw [hIsoHomOfLE (hAff_S a') hUS_aff inf_le_right,
                AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = hUS_aff.isoSpec.inv ≫ (P_S.homOfLE (inf_le_right : U_S_inter ≤ D_S a') ≫
            ((hAff_S a').isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (ψ_cat a') ≫
              (hAff_R a').fromSpec)) := by simp only [CategoryTheory.Category.assoc]

    let Φ : P_S ⟶ P_R := 𝒰_S.glueMorphisms f_loc hGlueCond
    have hΦ_ι : ∀ a : Fin (N + 1), (D_S a).ι ≫ Φ = f_loc a :=
      fun a => 𝒰_S.ι_glueMorphisms f_loc hGlueCond a

    
    have hΦ_base_comm : Φ ≫ (weilProjectiveSpaceOver R N).hom =
        (weilProjectiveSpaceOver S N).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS) := by
      apply 𝒰_S.hom_ext
      change ∀ a : Fin (N + 1),
        (D_S a).ι ≫ (Φ ≫ (weilProjectiveSpaceOver R N).hom) =
          (D_S a).ι ≫ ((weilProjectiveSpaceOver S N).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS))
      intro a
      rw [← CategoryTheory.Category.assoc, hΦ_ι a]
      dsimp only [f_loc]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← hCoord_R.2.2.1 a]
      have hψ_base : CommRingCat.ofHom (c_R a) ≫ ψ_cat a =
          CommRingCat.ofHom φ_RS ≫ CommRingCat.ofHom (c_S a) :=
        CommRingCat.hom_ext (RingHom.ext (hψ_c a))
      rw [← CategoryTheory.Category.assoc ((hAff_S a).isoSpec.hom),
        CategoryTheory.Category.assoc ((hAff_S a).isoSpec.hom),
        ← AlgebraicGeometry.Spec.map_comp, hψ_base, AlgebraicGeometry.Spec.map_comp,
        hCoord_S.2.2.1 a, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec, CategoryTheory.Category.assoc]

    have hΦ_pre : ∀ a : Fin (N + 1),
        (TopologicalSpace.Opens.map Φ.base).obj (D_R a) = D_S a := by
      intro a
      ext x
      change x ∈ (TopologicalSpace.Opens.map Φ.base).obj (D_R a) ↔ x ∈ D_S a
      have hx_top : x ∈ (⊤ : P_S.Opens) := trivial
      rw [← hCoord_S.2.1, TopologicalSpace.Opens.mem_iSup] at hx_top
      rcases hx_top with ⟨a', hxa'⟩
      have h1 : x ∈ (TopologicalSpace.Opens.map Φ.base).obj (D_R a) ↔
          (⟨x, hxa'⟩ : (D_S a').toScheme) ∈
            (TopologicalSpace.Opens.map ((D_S a').ι ≫ Φ).base).obj (D_R a) := Iff.rfl
      rw [h1, hΦ_ι a', hf_pre a' a]
      rfl

    have hΦ_appLE : ∀ a : Fin (N + 1),
        (Φ.appLE (D_R a) (D_S a) (le_of_eq (hΦ_pre a).symm)).hom = ψ_chart a := by
      intro a
      have _ : AlgebraicGeometry.IsOpenImmersion (hAff_R a).fromSpec := by
        rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]; infer_instance
      have hspec := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
        Φ (hAff_R a) (hAff_S a) (le_of_eq (hΦ_pre a).symm)
      have hspec2 : (hAff_S a).fromSpec ≫ Φ =
          AlgebraicGeometry.Spec.map (ψ_cat a) ≫ (hAff_R a).fromSpec := by
        rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι (hAff_S a),
          CategoryTheory.Category.assoc, hΦ_ι a]
        dsimp only [f_loc]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp]
      rw [hspec2, cancel_mono (hAff_R a).fromSpec] at hspec
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hspec)

    
    let g_RS := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)
    let Q_P := CategoryTheory.Limits.pullback (weilProjectiveSpaceOver R N).hom g_RS
