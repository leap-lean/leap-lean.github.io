  let hT₀ : CategoryTheory.Limits.IsTerminal T₀ := weilEtaleIdTerminalIsTerminal.{u} X₀
  let lift_W : ∀ (W : X_bar.Etale),
      W.left ⟶ CategoryTheory.Limits.pullback T₀.hom pr_X := fun W =>
    CategoryTheory.Limits.pullback.lift (W.hom ≫ pr_X) W.hom
      (CategoryTheory.Category.comp_id (W.hom ≫ pr_X))
  have hBT₀ : CategoryTheory.Limits.IsTerminal (B_prX.obj T₀) := by
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk (lift_W W)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial)
      (fun W m => ?_)
    let W_sch : AlgebraicGeometry.Scheme.{u} := W.left
    let w_hom : W_sch ⟶ X_bar := W.hom
    let mL : W_sch ⟶ CategoryTheory.Limits.pullback T₀.hom pr_X := m.left
    have hm_snd : mL ≫ CategoryTheory.Limits.pullback.snd T₀.hom pr_X = w_hom :=
      CategoryTheory.MorphismProperty.Over.w m
    have hcond : CategoryTheory.Limits.pullback.fst T₀.hom pr_X =
        CategoryTheory.Limits.pullback.snd T₀.hom pr_X ≫ pr_X :=
      (CategoryTheory.Category.comp_id
        (CategoryTheory.Limits.pullback.fst T₀.hom pr_X)).symm.trans
        CategoryTheory.Limits.pullback.condition
    have hm_fst : mL ≫ CategoryTheory.Limits.pullback.fst T₀.hom pr_X = w_hom ≫ pr_X :=
      (congrArg (mL ≫ ·) hcond).trans
        ((CategoryTheory.Category.assoc mL _ pr_X).symm.trans (congrArg (· ≫ pr_X) hm_snd))
    have hm_left : mL = lift_W W :=
      CategoryTheory.Limits.pullback.hom_ext
        (hm_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
        (hm_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    exact CategoryTheory.MorphismProperty.Comma.Hom.ext hm_left (Subsingleton.elim _ _)
  let C₀ := CategoryTheory.constantSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}
  let C_bar := CategoryTheory.constantSheaf X_bar.smallEtaleTopology AddCommGrpCat.{u}
  let Γ₀ := (CategoryTheory.sheafSections X₀.smallEtaleTopology AddCommGrpCat.{u}).obj
    (Opposite.op T₀)
  let Γ_bar := (CategoryTheory.sheafSections X_bar.smallEtaleTopology AddCommGrpCat.{u}).obj
    (Opposite.op (B_prX.obj T₀))
  let adj_c₀ := CategoryTheory.constantSheafAdj X₀.smallEtaleTopology AddCommGrpCat.{u} hT₀
  let adj_cbar := CategoryTheory.constantSheafAdj X_bar.smallEtaleTopology AddCommGrpCat.{u} hBT₀
  let adj₁_const : (C₀ ⋙ L_prX) ⊣ (P_prX ⋙ Γ₀) := adj_c₀.comp adj_prX
  let e_sec : Γ_bar ≅ (P_prX ⋙ Γ₀) :=
    CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _) (fun _ => by
      ext x
      rfl)
  let adj₂_const : C_bar ⊣ (P_prX ⋙ Γ₀) := adj_cbar.ofNatIsoRight e_sec
  let K_iso : (C₀ ⋙ L_prX) ≅ C_bar := adj₁_const.leftAdjointUniq adj₂_const
  let κ : ∀ (A : AddCommGrpCat.{u}), CategoryTheory.Iso (L_prX.obj (C₀.obj A)) (C_bar.obj A) :=
    fun A => K_iso.app A
  have hκ_nat : ∀ {A₁ A₂ : AddCommGrpCat.{u}} (c : A₁ ⟶ A₂),
      L_prX.map (C₀.map c) ≫ (κ A₂).hom = (κ A₁).hom ≫ C_bar.map c :=
    fun c => K_iso.hom.naturality c

  
  let Free_of := fun (S : AlgebraicGeometry.Scheme.{u}) =>
    (CategoryTheory.Functor.whiskeringRight (Opposite S.Etale) (Type u) AddCommGrpCat.{u}).obj
      AddCommGrpCat.free
  let Fgt_of := fun (S : AlgebraicGeometry.Scheme.{u}) =>
    (CategoryTheory.Functor.whiskeringRight (Opposite S.Etale) AddCommGrpCat.{u} (Type u)).obj
      (CategoryTheory.forget AddCommGrpCat.{u})
  let L_tot_of := fun (S : AlgebraicGeometry.Scheme.{u}) => Free_of S ⋙ Sh_of S
  let adj_free_of := fun (S : AlgebraicGeometry.Scheme.{u}) =>
    CategoryTheory.Adjunction.whiskerRight (Opposite S.Etale) AddCommGrpCat.adj
  let adj_sh_of := fun (S : AlgebraicGeometry.Scheme.{u}) =>
    CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
  let adj_tot_of : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      L_tot_of S ⊣ (U_of S ⋙ Fgt_of S) :=
    fun S => (adj_free_of S).comp (adj_sh_of S)
  let Z_fun : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      S.Etale ⥤ CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun S => CategoryTheory.yoneda ⋙ L_tot_of S
  let Z_obj : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      Opposite S.Etale → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun S W => Opposite.unop ((Z_fun S).op.obj W)
  let homSec : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      ((Z_fun S).obj W ⟶ 𝒢) ≃ ↑(((U_of S).obj 𝒢).obj (Opposite.op W)) :=
    fun S W 𝒢 =>
      ((adj_tot_of S).homEquiv (CategoryTheory.yoneda.obj W) 𝒢).trans
        CategoryTheory.yonedaEquiv
  have h_homSec_right : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (u : (Z_fun S).obj W ⟶ 𝒢₁) (φ : 𝒢₁ ⟶ 𝒢₂),
      homSec S W 𝒢₂ (u ≫ φ) = (φ.hom.app (Opposite.op W)) (homSec S W 𝒢₁ u) := by
    intro S W 𝒢₁ 𝒢₂ u φ
    dsimp only [homSec, Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
      CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply]
    rfl
  have h_homSec_left : ∀ (S : AlgebraicGeometry.Scheme.{u}) {W₁ W₂ : S.Etale}
      (w : W₁ ⟶ W₂) (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (u : (Z_fun S).obj W₂ ⟶ 𝒢),
      homSec S W₁ 𝒢 ((Z_fun S).map w ≫ u) =
        (𝒢.obj.map w.op) (homSec S W₂ 𝒢 u) := by
    intro S W₁ W₂ w 𝒢 u
    have hZw : (Z_fun S).map w = (L_tot_of S).map (CategoryTheory.yoneda.map w.op.unop) :=
      rfl
    dsimp only [homSec, Equiv.trans_apply]
    rw [hZw, CategoryTheory.Adjunction.homEquiv_naturality_left,
      ← CategoryTheory.yonedaEquiv_naturality']
    rfl
  let unitSec : ∀ (W : X₀.Etale),
      ↑(((U_of X_bar).obj (L_prX.obj ((Z_fun X₀).obj W))).obj
        (Opposite.op (B_prX.obj W))) :=
    fun W =>
      homSec X₀ W (P_prX.obj (L_prX.obj ((Z_fun X₀).obj W)))
        (adj_prX.unit.app ((Z_fun X₀).obj W))
  let η_yon : ∀ (W : X₀.Etale),
      (Z_fun X_bar).obj (B_prX.obj W) ⟶ L_prX.obj ((Z_fun X₀).obj W) :=
    fun W =>
      (homSec X_bar (B_prX.obj W) (L_prX.obj ((Z_fun X₀).obj W))).symm (unitSec W)
  have h_η_sec : ∀ (W : X₀.Etale),
      homSec X_bar (B_prX.obj W) (L_prX.obj ((Z_fun X₀).obj W)) (η_yon W) = unitSec W :=
    fun W =>
      (homSec X_bar (B_prX.obj W) (L_prX.obj ((Z_fun X₀).obj W))).apply_symm_apply (unitSec W)
  have h_η_eval : ∀ (W : X₀.Etale)
      (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
      (u : (Z_fun X₀).obj W ⟶ ℱ),
      homSec X_bar (B_prX.obj W) (L_prX.obj ℱ) (η_yon W ≫ L_prX.map u) =
        ((adj_prX.unit.app ℱ).hom.app (Opposite.op W)) (homSec X₀ W ℱ u) := by
    intro W ℱ u
    rw [h_homSec_right, h_η_sec]
    change ((P_prX.map (L_prX.map u)).hom.app (Opposite.op W))
        (homSec X₀ W (P_prX.obj (L_prX.obj ((Z_fun X₀).obj W)))
          (adj_prX.unit.app ((Z_fun X₀).obj W))) = _
    have hu_nat : adj_prX.unit.app ((Z_fun X₀).obj W) ≫ P_prX.map (L_prX.map u) =
        u ≫ adj_prX.unit.app ℱ :=
      (adj_prX.unit.naturality u).symm
    rw [← h_homSec_right, hu_nat, h_homSec_right]
  have h_η_nat : ∀ {W₁ W₂ : X₀.Etale} (w : W₁ ⟶ W₂),
      (Z_fun X_bar).map (B_prX.map w) ≫ η_yon W₂ =
        η_yon W₁ ≫ L_prX.map ((Z_fun X₀).map w) := by
    intro W₁ W₂ w
    apply (homSec X_bar (B_prX.obj W₁) (L_prX.obj ((Z_fun X₀).obj W₂))).injective
    rw [h_homSec_left, h_η_eval, h_η_sec]
    change ((P_prX.obj (L_prX.obj ((Z_fun X₀).obj W₂))).obj.map w.op)
        (homSec X₀ W₂ (P_prX.obj (L_prX.obj ((Z_fun X₀).obj W₂)))
          (adj_prX.unit.app ((Z_fun X₀).obj W₂))) = _
    rw [← h_homSec_left, h_homSec_right]
  let ψ_yon : ∀ (V : Y₀.Etale),
      (Z_fun X_bar).obj (B_fbar.obj (B_prY.obj V)) ⟶
        L_prX.obj ((Z_fun X₀).obj (B_f₀.obj V)) :=
    fun V => (Z_fun X_bar).map (e_fun.inv.app V) ≫ η_yon (B_f₀.obj V)
  have h_ψ_nat : ∀ {V₁ V₂ : Y₀.Etale} (v : V₁ ⟶ V₂),
      (Z_fun X_bar).map (B_fbar.map (B_prY.map v)) ≫ ψ_yon V₂ =
        ψ_yon V₁ ≫ L_prX.map ((Z_fun X₀).map (B_f₀.map v)) := by
    intro V₁ V₂ v
    dsimp only [ψ_yon]
    rw [← CategoryTheory.Category.assoc, ← (Z_fun X_bar).map_comp]
    have h_inv_nat : B_fbar.map (B_prY.map v) ≫ e_fun.inv.app V₂ =
        e_fun.inv.app V₁ ≫ B_prX.map (B_f₀.map v) :=
      e_fun.inv.naturality v
    rw [h_inv_nat, (Z_fun X_bar).map_comp, CategoryTheory.Category.assoc,
      h_η_nat (B_f₀.map v), CategoryTheory.Category.assoc]

  
  let P₀_pre := fun (q : ℕ) (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}) =>
    W_f₀.obj (ℱ.cohomologyPresheaf q)
  let Pbar_pre := fun (q : ℕ) (𝒢 : CategoryTheory.Sheaf X_bar.smallEtaleTopology AddCommGrpCat.{u}) =>
    W_fbar.obj (𝒢.cohomologyPresheaf q)
  let β_pre : ∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      P₀_pre q ℱ ⟶ B_prY.op ⋙ Pbar_pre q (L_prX.obj ℱ) :=
    fun q ℱ =>
      { app := fun W =>
          AddCommGrpCat.ofHom
            (((CategoryTheory.Abelian.Ext.mk₀ (ψ_yon (Opposite.unop W))).precomp
                (L_prX.obj ℱ) (Nat.zero_add q)).comp
              (L_prX.mapExtAddHom ((Z_fun X₀).obj (B_f₀.obj (Opposite.unop W))) ℱ q))
        naturality := by
          intro W₁ W₂ ω
          let v : Opposite.unop W₂ ⟶ Opposite.unop W₁ := ω.unop
          have hL : (P₀_pre q ℱ).map ω =
              ((CategoryTheory.Abelian.extFunctor q).map
                ((Z_fun X₀).op.map (B_f₀.op.map ω))).app ℱ := rfl
          have hR : (B_prY.op ⋙ Pbar_pre q (L_prX.obj ℱ)).map ω =
              ((CategoryTheory.Abelian.extFunctor q).map
                ((Z_fun X_bar).op.map (B_fbar.op.map (B_prY.op.map ω)))).app (L_prX.obj ℱ) := rfl
          rw [hL, hR,
            CategoryTheory.Abelian.extFunctor_map_app q
              ((Z_fun X₀).op.map (B_f₀.op.map ω)) ℱ,
            CategoryTheory.Abelian.extFunctor_map_app q
              ((Z_fun X_bar).op.map (B_fbar.op.map (B_prY.op.map ω))) (L_prX.obj ℱ)]
          ext α
          let α₀ : CategoryTheory.Abelian.Ext
              ((Z_fun X₀).obj (B_f₀.obj (Opposite.unop W₁))) ℱ q := α
          change (CategoryTheory.Abelian.Ext.mk₀ (ψ_yon (Opposite.unop W₂))).comp
              (L_prX.mapExtAddHom _ ℱ q
                ((CategoryTheory.Abelian.Ext.mk₀
                  ((Z_fun X₀).map (B_f₀.map v))).comp α₀ (Nat.zero_add q)))
              (Nat.zero_add q) =
            (CategoryTheory.Abelian.Ext.mk₀
              ((Z_fun X_bar).map (B_fbar.map (B_prY.map v)))).comp
              ((CategoryTheory.Abelian.Ext.mk₀ (ψ_yon (Opposite.unop W₁))).comp
                (L_prX.mapExtAddHom _ ℱ q α₀) (Nat.zero_add q))
              (Nat.zero_add q)
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← h_ψ_nat v,
            ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q)] }
  let adj_Y_tot : (Sh_of Y₀ ⋙ L_prY) ⊣ (P_prY ⋙ U_of Y₀) :=
    (adj_sh_of Y₀).comp adj_prY
  let η_unit : ∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      (B_prY.op ⋙ Pbar_pre q (L_prX.obj ℱ)) ⟶
        (P_prY ⋙ U_of Y₀).obj ((Φ_fbar q).obj (L_prX.obj ℱ)) :=
    fun q ℱ =>
      CategoryTheory.Functor.whiskerLeft B_prY.op
        ((adj_sh_of Y_bar).unit.app (Pbar_pre q (L_prX.obj ℱ)))
  let γ_pre : ∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      P₀_pre q ℱ ⟶ (P_prY ⋙ U_of Y₀).obj ((Φ_fbar q).obj (L_prX.obj ℱ)) :=
    fun q ℱ => β_pre q ℱ ≫ η_unit q ℱ
  let θ : ∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
      L_prY.obj ((Φ_f₀ q).obj ℱ) ⟶ (Φ_fbar q).obj (L_prX.obj ℱ) :=
    fun q ℱ =>
      (adj_Y_tot.homEquiv (P₀_pre q ℱ) ((Φ_fbar q).obj (L_prX.obj ℱ))).symm (γ_pre q ℱ)

  
  have hθ_nat : ∀ (q : ℕ)
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : ℱ₁ ⟶ ℱ₂),
      L_prY.map ((Φ_f₀ q).map φ) ≫ θ q ℱ₂ =
        θ q ℱ₁ ≫ (Φ_fbar q).map (L_prX.map φ) := by
    intro q ℱ₁ ℱ₂ φ
    let φ₀_pre : P₀_pre q ℱ₁ ⟶ P₀_pre q ℱ₂ :=
      W_f₀.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).map φ)
    let φbar_pre : Pbar_pre q (L_prX.obj ℱ₁) ⟶ Pbar_pre q (L_prX.obj ℱ₂) :=
      W_fbar.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X_bar.smallEtaleTopology q).map
        (L_prX.map φ))
    have hβ_nat : φ₀_pre ≫ β_pre q ℱ₂ =
        β_pre q ℱ₁ ≫ CategoryTheory.Functor.whiskerLeft B_prY.op φbar_pre := by
      ext W α
      let V := Opposite.unop W
      let α₀ : CategoryTheory.Abelian.Ext ((Z_fun X₀).obj (B_f₀.obj V)) ℱ₁ q := α
      have hφ₀_app : φ₀_pre.app W =
          (CategoryTheory.Abelian.extFunctorObj (Z_obj X₀ (Opposite.op (B_f₀.obj V))) q).map φ :=
        rfl
      have hφbar_app : (CategoryTheory.Functor.whiskerLeft B_prY.op φbar_pre).app W =
          (CategoryTheory.Abelian.extFunctorObj
            (Z_obj X_bar (Opposite.op (B_fbar.obj (B_prY.obj V)))) q).map (L_prX.map φ) :=
        rfl
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.comp_app,
        hφ₀_app, hφbar_app,
        CategoryTheory.Abelian.extFunctorObj_map,
        CategoryTheory.Abelian.extFunctorObj_map]
      change (CategoryTheory.Abelian.Ext.mk₀ (ψ_yon V)).comp
          (L_prX.mapExtAddHom _ ℱ₂ q
            (α₀.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q)))
          (Nat.zero_add q) =
        ((CategoryTheory.Abelian.Ext.mk₀ (ψ_yon V)).comp
          (L_prX.mapExtAddHom _ ℱ₁ q α₀) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (L_prX.map φ)) (Nat.add_zero q)
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add q) (Nat.add_zero q) (by omega)]
    have h_unit_raw :
        CategoryTheory.Functor.whiskerLeft B_prY.op φbar_pre ≫
          CategoryTheory.Functor.whiskerLeft B_prY.op
            ((adj_sh_of Y_bar).unit.app (Pbar_pre q (L_prX.obj ℱ₂))) =
        CategoryTheory.Functor.whiskerLeft B_prY.op
            ((adj_sh_of Y_bar).unit.app (Pbar_pre q (L_prX.obj ℱ₁))) ≫
          CategoryTheory.Functor.whiskerLeft B_prY.op
            ((U_of Y_bar).map ((Sh_of Y_bar).map φbar_pre)) := by
      rw [← CategoryTheory.Functor.whiskerLeft_comp,
        ← CategoryTheory.Functor.whiskerLeft_comp]
      exact congrArg (CategoryTheory.Functor.whiskerLeft B_prY.op)
        ((adj_sh_of Y_bar).unit.naturality φbar_pre)
    have h_unit : CategoryTheory.Functor.whiskerLeft B_prY.op φbar_pre ≫ η_unit q ℱ₂ =
        η_unit q ℱ₁ ≫ (P_prY ⋙ U_of Y₀).map ((Φ_fbar q).map (L_prX.map φ)) := h_unit_raw
    have hγ_nat : φ₀_pre ≫ γ_pre q ℱ₂ =
        γ_pre q ℱ₁ ≫ (P_prY ⋙ U_of Y₀).map ((Φ_fbar q).map (L_prX.map φ)) := by
      dsimp only [γ_pre]
      rw [← CategoryTheory.Category.assoc, hβ_nat, CategoryTheory.Category.assoc, h_unit,
        ← CategoryTheory.Category.assoc]
    change (Sh_of Y₀ ⋙ L_prY).map φ₀_pre ≫
        (adj_Y_tot.homEquiv (P₀_pre q ℱ₂) ((Φ_fbar q).obj (L_prX.obj ℱ₂))).symm (γ_pre q ℱ₂) =
      (adj_Y_tot.homEquiv (P₀_pre q ℱ₁) ((Φ_fbar q).obj (L_prX.obj ℱ₁))).symm (γ_pre q ℱ₁) ≫
        (Φ_fbar q).map (L_prX.map φ)
    rw [← adj_Y_tot.homEquiv_naturality_left_symm φ₀_pre (γ_pre q ℱ₂),
      hγ_nat,
      adj_Y_tot.homEquiv_naturality_right_symm (γ_pre q ℱ₁) ((Φ_fbar q).map (L_prX.map φ))]

  
  let e_raw : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : Opposite S.Etale)
      (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext (Z_obj S W) 𝒢 0 ≃ ↑(((U_of S).obj 𝒢).obj W) :=
    fun S W 𝒢 =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans (homSec S (Opposite.unop W) 𝒢)
  have he_add : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : Opposite S.Etale)
      (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj S W) 𝒢 0),
      e_raw S W 𝒢 (α₁ + α₂) = e_raw S W 𝒢 α₁ + e_raw S W 𝒢 α₂ := by
    intro S W 𝒢 α₁ α₂
    let V := Opposite.unop W
    let u₁ : Z_obj S W ⟶ 𝒢 := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
    let u₂ : Z_obj S W ⟶ 𝒢 := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
    have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
      map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
    let ψ_sh : (Z_obj S W ⟶ 𝒢) →
        ((Free_of S).obj (CategoryTheory.yoneda.obj V) ⟶ (U_of S).obj 𝒢) :=
