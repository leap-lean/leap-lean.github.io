          have hδ₀_zero : δ₀ = 0 :=
            (CategoryTheory.cancel_epi (pf_id.map SC.g)).mp
              (hcomp.trans CategoryTheory.Limits.comp_zero.symm)
          have hid_zero : 𝟙 (weilEtaleHigherDirectImage id_XU 1 F) = 0 :=
            (CategoryTheory.cancel_epi δ₀).mp
              ((CategoryTheory.Category.comp_id δ₀).trans
                (hδ₀_zero.trans CategoryTheory.Limits.comp_zero.symm))
          rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
