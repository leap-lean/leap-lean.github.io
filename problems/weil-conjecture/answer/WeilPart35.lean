        [AlgebraicGeometry.IsSeparated Z₀.hom]
        (z_W : Z₀.left ⟶ W₀.left) [AlgebraicGeometry.Etale z_W],
        z_W ≫ W₀.hom =
          Z₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₀)) →
        ∀ (Z_bar : W_bar.Etale) (p_Z : (Fgt_W.obj Z_bar).left ⟶ Z₀.left),
          CategoryTheory.IsPullback p_Z ((Fgt_W.obj Z_bar).hom ≫ snd_W) Z₀.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ k))) →
          p_Z ≫ z_W = (Fgt_W.obj Z_bar).hom ≫ pr_W →
          ∀ (E₁ : Type u) [Finite E₁] [Field E₁]
            [Algebra F E₁] [Algebra E₀ E₁] [Algebra E₁ k]
            [IsScalarTower F E₀ E₁] [IsScalarTower E₀ E₁ k] [IsScalarTower F E₁ k]
            (U₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₁)))
            [AlgebraicGeometry.IsAffine U₁.left]
            (u₁ : U₁.left ⟶ CategoryTheory.Limits.pullback Z₀.hom
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))))
            [AlgebraicGeometry.Etale u₁] [AlgebraicGeometry.Surjective u₁]
            (U_bar : W_bar.Etale) (u_bar : Quiver.Hom U_bar Z_bar)
            (p_U : (Fgt_W.obj U_bar).left ⟶ U₁.left),
            u₁ ≫ CategoryTheory.Limits.pullback.snd Z₀.hom
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))) = U₁.hom →
