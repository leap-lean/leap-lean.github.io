theorem weil_sm_pencil_leray_syzygy_truncation_exact (sys : WeilEtaleSitePullbackSys.{u})
    {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S)
    (hT_top : CategoryTheory.Limits.IsTerminal
      ((weilEtaleSitePullback f).obj (weilEtaleIdTerminal.{u} S))) :
    let T_S := weilEtaleIdTerminal.{u} S
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    ∃ Ψ : ∀ (n : ℕ)
        (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q ℱ).H p)) →
        (weilEtaleHigherDirectImage f n ℱ).H 2 →+ ℱ.H (n + 2),
      (∀ (n : ℕ) (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
          (hℱ : ∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q ℱ).H p)),
        Subsingleton ((weilEtaleHigherDirectImage f (n + 1) ℱ).H 1) →
        ∀ y : ℱ.H (n + 2),
          weilOuterTrFibEdgeHom f T_S hT_top ℱ (n + 2) y = 0 ↔
            ∃ z : (weilEtaleHigherDirectImage f n ℱ).H 2, Ψ n ℱ hℱ z = y) ∧
      (∀ (n : ℕ)
          {ℱ₁ ℱ₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (h₁ : ∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q ℱ₁).H p))
          (h₂ : ∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q ℱ₂).H p))
          (φ : Quiver.Hom ℱ₁ ℱ₂)
          (z : (weilEtaleHigherDirectImage f n ℱ₁).H 2),
        ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_X (Nat.add_zero (n + 2)))
          (Ψ n ℱ₁ h₁ z) =
        Ψ n ℱ₂ h₂
