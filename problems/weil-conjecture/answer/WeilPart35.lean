  let T_of : ∀ (S : AlgebraicGeometry.Scheme.{u}), S.Etale :=
    fun S => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))

  have hT_of : ∀ (S : AlgebraicGeometry.Scheme.{u}), CategoryTheory.Limits.IsTerminal (T_of S) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => (CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom) : W ⟶ T_of S)) ?_
    intro W m
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun S => (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ

  have : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun _ => inferInstance

  let evalUp1 : ∀ (G : AddCommGrpCat.{u}), (Aℤ ⟶ G) ≃+ ↥G :=
    fun G =>
      { toFun := fun g => g (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun n => n.down • m
            map_zero' := zero_zsmul m
            map_add' := fun a b => add_zsmul m a.down b.down }
        left_inv := fun g => by
          ext ⟨n⟩
          have hn : (ULift.up n : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) :=
            ULift.ext _ _ (mul_one n).symm
          change n • g (ULift.up (1 : ℤ)) = g (ULift.up n)
          rw [hn, map_zsmul]
        right_inv := fun m => one_zsmul m
        map_add' := fun _ _ => rfl }

  let constHomEquiv : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (ℳ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (Fℤ S ⟶ ℳ) ≃+ (Aℤ ⟶ ℳ.obj.obj (Opposite.op (T_of S))) :=
    fun S ℳ =>
      let adj_TS := CategoryTheory.constantSheafAdj
        S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)
      { toEquiv := adj_TS.homEquiv Aℤ ℳ
        map_add' := fun φ₁ φ₂ => by
          change adj_TS.homEquiv Aℤ ℳ (φ₁ + φ₂) =
            adj_TS.homEquiv Aℤ ℳ φ₁ + adj_TS.homEquiv Aℤ ℳ φ₂
          rw [adj_TS.homEquiv_unit, adj_TS.homEquiv_unit, adj_TS.homEquiv_unit]
          change adj_TS.unit.app Aℤ ≫ (φ₁ + φ₂).hom.app (Opposite.op (T_of S)) =
            adj_TS.unit.app Aℤ ≫ φ₁.hom.app (Opposite.op (T_of S)) +
              adj_TS.unit.app Aℤ ≫ φ₂.hom.app (Opposite.op (T_of S))
          rw [← CategoryTheory.Preadditive.comp_add]
          rfl }

  let eH₀ : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (ℳ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      ℳ.H 0 ≃+ ↥(ℳ.obj.obj (Opposite.op (T_of S))) :=
    fun S ℳ =>
      CategoryTheory.Abelian.Ext.addEquiv₀.trans
        ((constHomEquiv S ℳ).trans (evalUp1 (ℳ.obj.obj (Opposite.op (T_of S)))))

  have heH₀_postcomp : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {ℳ₁ ℳ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ : ℳ₁ ⟶ ℳ₂) (x : ℳ₁.H 0),
      eH₀ S ℳ₂ ((CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp (Fℤ S) (Nat.add_zero 0) x) =
        (ψ.hom.app (Opposite.op (T_of S))) (eH₀ S ℳ₁ x) := by
    intro S ℳ₁ ℳ₂ ψ x
    let adj_TS := CategoryTheory.constantSheafAdj
      S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)
    have h_hom : adj_TS.homEquiv Aℤ ℳ₂
        (CategoryTheory.Abelian.Ext.addEquiv₀
          ((CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp (Fℤ S) (Nat.add_zero 0) x)) =
        adj_TS.homEquiv Aℤ ℳ₁ (CategoryTheory.Abelian.Ext.addEquiv₀ x) ≫
          ψ.hom.app (Opposite.op (T_of S)) := by
      rw [hExt_postcomp₀ ψ x]
      exact adj_TS.homEquiv_naturality_right
        (CategoryTheory.Abelian.Ext.addEquiv₀ x) ψ
    exact congrArg (fun g : Aℤ ⟶ ℳ₂.obj.obj (Opposite.op (T_of S)) =>
      g (ULift.up (1 : ℤ))) h_hom

  have heH₀_frob : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (ℳ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (G : CategoryTheory.Functor S.Etale S.Etale)
      (hCont_G : G.IsContinuous S.smallEtaleTopology S.smallEtaleTopology),
      let P := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        G AddCommGrpCat.{u} _
        S.smallEtaleTopology S.smallEtaleTopology hCont_G
      ∀ (hAdd_P : P.Additive)
        (hLim_P : CategoryTheory.Limits.PreservesFiniteLimits P)
        (hColim_P : CategoryTheory.Limits.PreservesFiniteColimits P)
        (μ : G.obj (T_of S) ⟶ T_of S)
        (β_bar : P.obj ℳ ⟶ ℳ)
        (f_act : ℳ.H 0 →+ ℳ.H 0),
        let adj_TS := CategoryTheory.constantSheafAdj
          S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)
        let αℤ : Fℤ S ⟶ P.obj (Fℤ S) :=
          (adj_TS.homEquiv Aℤ (P.obj (Fℤ S))).symm
            (adj_TS.unit.app Aℤ ≫ (Fℤ S).obj.map (Opposite.op μ))
        (∀ z : ℳ.H 0,
          f_act z = (CategoryTheory.Abelian.Ext.mk₀ β_bar).postcomp (Fℤ S) (Nat.add_zero 0)
            ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P
                hAdd_P hLim_P hColim_P _ _ (Fℤ S) ℳ 0) z)
              (Nat.zero_add 0))) →
        ∀ x : ℳ.H 0,
          eH₀ S ℳ (f_act x) =
            (β_bar.hom.app (Opposite.op (T_of S)))
              ((ℳ.obj.map (Opposite.op μ)) (eH₀ S ℳ x)) := by
    intro S ℳ G hCont_G P hAdd_P hLim_P hColim_P μ β_bar f_act adj_TS αℤ hf_eq x
    let u : Fℤ S ⟶ ℳ := CategoryTheory.Abelian.Ext.addEquiv₀ x
    have hu_frob : CategoryTheory.Abelian.Ext.addEquiv₀ (f_act x) =
        αℤ ≫ P.map u ≫ β_bar := by
      rw [hf_eq x]
      exact hExt_frob₀ P hAdd_P hLim_P hColim_P αℤ β_bar x
    have h_step1 : adj_TS.homEquiv Aℤ ℳ (CategoryTheory.Abelian.Ext.addEquiv₀ (f_act x)) =
        (adj_TS.unit.app Aℤ ≫ (Fℤ S).obj.map (Opposite.op μ)) ≫
          (P.map u ≫ β_bar).hom.app (Opposite.op (T_of S)) := by
      rw [hu_frob, adj_TS.homEquiv_naturality_right αℤ (P.map u ≫ β_bar)]
      dsimp only [αℤ]
      rw [Equiv.apply_symm_apply]
      rfl
    have h_ev1 := congrArg (fun g : Aℤ ⟶ ℳ.obj.obj (Opposite.op (T_of S)) =>
      g (ULift.up (1 : ℤ))) h_step1
    have h_ev_u : eH₀ S ℳ x =
        (u.hom.app (Opposite.op (T_of S))) ((adj_TS.unit.app Aℤ) (ULift.up (1 : ℤ))) :=
      congrArg (fun g : Aℤ ⟶ ℳ.obj.obj (Opposite.op (T_of S)) =>
        g (ULift.up (1 : ℤ))) (adj_TS.homEquiv_unit Aℤ ℳ u)
    have h_nat_u := congrArg
      (fun g : (Fℤ S).obj.obj (Opposite.op (T_of S)) ⟶
        ℳ.obj.obj (Opposite.op (G.obj (T_of S))) =>
        g ((adj_TS.unit.app Aℤ) (ULift.up (1 : ℤ))))
      (u.hom.naturality (Opposite.op μ))
    exact h_ev1.trans
      ((congrArg (β_bar.hom.app (Opposite.op (T_of S))) h_nat_u).trans
        (congrArg (fun s => (β_bar.hom.app (Opposite.op (T_of S)))
          ((ℳ.obj.map (Opposite.op μ)) s)) h_ev_u.symm))

  
  have hCongr_inv_fst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      {f₁ f₂ : Quiver.Hom S₁ S₂} (heq : f₁ = f₂) (A : S₂.Etale),
      let e : @CategoryTheory.Iso (CategoryTheory.Functor S₂.Etale S₁.Etale) _
          (weilEtaleSitePullback f₁) (weilEtaleSitePullback f₂) :=
