                (CategoryTheory.Limits.pullback.lift_snd _ _ _))
          have hrhs : ((α E₂).symm ((Φ₂.fiber.map u) s)).1 ≫
              CategoryTheory.Limits.pullback.snd E₂.hom h = x :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
