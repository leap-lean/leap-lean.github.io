      (ht_diag_m : ∀ a : Fin (m + 1), t_PmS a a = 1)
      (hBasic_m : ∀ a a' : Fin (m + 1), P_mS.basicOpen (t_PmS a a') = D_m a ⊓ D_m a')
      (hCov_cm : ∀ (a a' : Fin (m + 1)) (s : S),
        (P_mS.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_m a ⊓ D_m a' ≤ D_m a')).op).hom
          (c_PmS a' s) =
        (P_mS.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_m a ⊓ D_m a' ≤ D_m a)).op).hom
          (c_PmS a s))
      (hCov_tm : ∀ (a a' b : Fin (m + 1)),
        (P_mS.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_m a ⊓ D_m a' ≤ D_m a')).op).hom
          (t_PmS a' b) *
        (P_mS.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_m a ⊓ D_m a' ≤ D_m a)).op).hom
          (t_PmS a a') =
        (P_mS.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_m a ⊓ D_m a' ≤ D_m a)).op).hom
          (t_PmS a b))
      (hθ_PmS : ∀ a : Fin (m + 1),
        (θ_PmS a).toRingHom.comp MvPolynomial.C = c_PmS a ∧
        ∀ i : Fin m, θ_PmS a (MvPolynomial.X i) = t_PmS a (a.succAbove i)),
      ∃ (ι_odd : P_mS ⟶ P_NS)
        (ψ_S : ∀ r : Fin (m + 1),
          ↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r)))) →+*
          ↑(P_mS.presheaf.obj (Opposite.op (D_m r)))),
        (∀ r : Fin (m + 1),
          (ψ_S r).comp (c_NS (v_idx r)) = c_PmS r ∧
          (∀ b : Fin (N + 1),
            ψ_S r (t_NS (v_idx r) b) =
              if h_odd : b.1 % 2 = 1 then t_PmS r ⟨b.1 / 2, by have := b.2; omega⟩ else 0) ∧
          (D_m r).ι ≫ ι_odd =
            (D_m r).toSpecΓ ≫
