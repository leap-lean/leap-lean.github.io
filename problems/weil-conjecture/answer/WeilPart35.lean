          (weilEtaleCechProj f (p + 1) (j.succAbove m)).left :=
      fun f p j m => congrArg (fun mor : weilEtaleCechObj f (p + 1) ⟶ _ => mor.left)
        (hLiftProj f (weilEtaleCechHom f (p + 1)) p
          (fun i => weilEtaleCechProj f (p + 1) (j.succAbove i))
          (fun i => (weilEtaleCechProjSub f (p + 1) (j.succAbove i)).2) m)
    have hProjExtLeft : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} {W V : S₀.Etale}
        (f : W ⟶ V) (p : ℕ) {Y : AlgebraicGeometry.Scheme.{u}}
        (a b : Y ⟶ (weilEtaleCechObj f p).left),
        (∀ m : Fin (p + 1),
          a ≫ (weilEtaleCechProj f p m).left = b ≫ (weilEtaleCechProj f p m).left) →
        a = b := by
      intro S₀ W V f p
      let U_sch₀ := (AlgebraicGeometry.Scheme.Etale.forget S₀).comp (CategoryTheory.Over.forget S₀)
      induction p with
      | zero =>
        intro Y a b hab
        exact (CategoryTheory.Category.comp_id a).symm.trans
          ((hab 0).trans (CategoryTheory.Category.comp_id b))
      | succ p ih =>
        intro Y a b hab
        have hpb := (CategoryTheory.IsPullback.of_hasPullback (weilEtaleCechHom f p) f).map U_sch₀
        apply hpb.hom_ext
        · apply ih
          intro i
          have hi := hab i.castSucc
