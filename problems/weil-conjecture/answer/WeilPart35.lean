          · dsimp [g_quad]
            rw [Fin.lastCases_last]
            apply Ideal.subset_span
            exact ⟨Fin.last j.succ.1, by dsimp [g_quad]; rw [Fin.lastCases_last]⟩
          · dsimp [g_quad]
            rw [Fin.lastCases_castSucc]
