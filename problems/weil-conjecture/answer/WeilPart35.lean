                ((hN_b x).isoSpec).inv ≫ (N_b x).ι := by
              rw [← hSpec_inr]
          _ = AlgebraicGeometry.Spec.map f_x ≫
                (AlgebraicGeometry.Spec.map inr_k ≫ ((hN_b x).isoSpec).inv ≫ (N_b x).ι) := by
              simp only [CategoryTheory.Category.assoc]
          _ = (lift_x ≫ e_NW.inv) ≫ (e_NW.hom ≫ N_Wbar.ι ≫ pr_W) := by
              rw [hf_x_spec, ← he_NW_pr]
          _ = (lift_x ≫ N_Wbar.ι) ≫ pr_W := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
          _ = (j_b x ≫ v_Wbar) ≫ pr_W := by rw [hlift_x_fac]
      exact ⟨E₀, hFinE₀, hFldE₀, hAlgFE₀, hAlgE₀k, hSTFE₀k,
        Z₀, (inferInstance : AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (Q₁ 0))),
        z_W, hz_W_et, p_Z, hz_W_comm, hp_Z_pb, hp_Z_pr⟩

