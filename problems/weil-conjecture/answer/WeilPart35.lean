          rw [CategoryTheory.Abelian.Ext.comp_assoc w
            (CategoryTheory.Abelian.Ext.mk₀ S₂.g) hS₂.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
