  have : (B₂ ⋙ B₁).IsContinuous J J :=
    CategoryTheory.Functor.isContinuous_comp B₂ B₁ J J J
  have : (B₁ ⋙ B₂).IsContinuous J J :=
    CategoryTheory.Functor.isContinuous_comp B₁ B₂ J J J
  let e_B_21 : B₂ ⋙ B₁ ≅ CategoryTheory.Functor.id Y.Etale :=
    (CategoryTheory.MorphismProperty.Over.pullbackComp e_Y.hom e_Y.inv).symm ≪≫
      CategoryTheory.MorphismProperty.Over.pullbackCongr e_Y.hom_inv_id ≪≫ e_id
  let e_B_12 : B₁ ⋙ B₂ ≅ CategoryTheory.Functor.id Y.Etale :=
    (CategoryTheory.MorphismProperty.Over.pullbackComp e_Y.inv e_Y.hom).symm ≪≫
      CategoryTheory.MorphismProperty.Over.pullbackCongr e_Y.inv_hom_id ≪≫ e_id
  let pf₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u} J J
  let pf₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u} J J
  let pb₁ : CategoryTheory.Functor 𝒜_Y 𝒜_Y := pb_Y
  let pb₂ : CategoryTheory.Functor 𝒜_Y 𝒜_Y := B₂.sheafPullback AddCommGrpCat.{u} J J
  let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} J J
  let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} J J
  let e_pf_12 : pf₁ ⋙ pf₂ ≅ CategoryTheory.Functor.id 𝒜_Y :=
    CategoryTheory.Functor.sheafPushforwardContinuousComp B₂ B₁ AddCommGrpCat.{u} J J J ≪≫
      CategoryTheory.Functor.sheafPushforwardContinuousId' e_B_21 AddCommGrpCat.{u} J
  let e_pf_21 : pf₂ ⋙ pf₁ ≅ CategoryTheory.Functor.id 𝒜_Y :=
    CategoryTheory.Functor.sheafPushforwardContinuousComp B₁ B₂ AddCommGrpCat.{u} J J J ≪≫
      CategoryTheory.Functor.sheafPushforwardContinuousId' e_B_12 AddCommGrpCat.{u} J
  let e_R : pb₂ ⋙ pb₁ ≅ CategoryTheory.Functor.id 𝒜_Y :=
    (adj₂.comp adj₁).leftAdjointUniq ((CategoryTheory.Adjunction.id).ofNatIsoRight e_pf_12.symm)
  let e_L : pb₁ ⋙ pb₂ ≅ CategoryTheory.Functor.id 𝒜_Y :=
    (adj₁.comp adj₂).leftAdjointUniq ((CategoryTheory.Adjunction.id).ofNatIsoRight e_pf_21.symm)
  let eR_hom : ∀ M : 𝒜_Y, pb₁.obj (pb₂.obj M) ⟶ M := fun M => e_R.hom.app M
  let eR_inv : ∀ M : 𝒜_Y, M ⟶ pb₁.obj (pb₂.obj M) := fun M => e_R.inv.app M
  let eL_hom : ∀ M : 𝒜_Y, pb₂.obj (pb₁.obj M) ⟶ M := fun M => e_L.hom.app M
  let eL_inv : ∀ M : 𝒜_Y, M ⟶ pb₂.obj (pb₁.obj M) := fun M => e_L.inv.app M
  have heR_inv_hom : ∀ M : 𝒜_Y, eR_inv M ≫ eR_hom M = 𝟙 M :=
    fun M => e_R.inv_hom_id_app M
  have heR_inv_nat : ∀ {M₁ M₂ : 𝒜_Y} (k : M₁ ⟶ M₂),
      k ≫ eR_inv M₂ = eR_inv M₁ ≫ pb₁.map (pb₂.map k) :=
    fun k => e_R.inv.naturality k
  have heR_hom_nat : ∀ {M₁ M₂ : 𝒜_Y} (k : M₁ ⟶ M₂),
      pb₁.map (pb₂.map k) ≫ eR_hom M₂ = eR_hom M₁ ≫ k :=
    fun k => e_R.hom.naturality k
  have heL_hom_inv : ∀ M : 𝒜_Y, eL_hom M ≫ eL_inv M = 𝟙 (pb₂.obj (pb₁.obj M)) :=
    fun M => e_L.hom_inv_id_app M
  refine ⟨?_, ?_⟩
  · intro ℐ _
    refine CategoryTheory.Injective.mk (fun {Y₁ Y₂} g u _ => ?_)
    have : CategoryTheory.Mono (pb₂.map u) := pb₂.map_mono u
    obtain ⟨h', hh'⟩ := CategoryTheory.Injective.factors (pb₂.map g ≫ eL_hom ℐ) (pb₂.map u)
    refine ⟨eR_inv Y₂ ≫ pb₁.map (h' ≫ eL_inv ℐ) ≫ eR_hom (pb₁.obj ℐ), ?_⟩
    calc
      u ≫ eR_inv Y₂ ≫ pb₁.map (h' ≫ eL_inv ℐ) ≫ eR_hom (pb₁.obj ℐ)
        = (u ≫ eR_inv Y₂) ≫ pb₁.map (h' ≫ eL_inv ℐ) ≫ eR_hom (pb₁.obj ℐ) := by
            rw [← CategoryTheory.Category.assoc]
      _ = eR_inv Y₁ ≫ pb₁.map (pb₂.map u) ≫ pb₁.map (h' ≫ eL_inv ℐ) ≫ eR_hom (pb₁.obj ℐ) := by
            rw [heR_inv_nat u, CategoryTheory.Category.assoc]
      _ = eR_inv Y₁ ≫ pb₁.map ((pb₂.map u ≫ h') ≫ eL_inv ℐ) ≫ eR_hom (pb₁.obj ℐ) := by
            rw [← CategoryTheory.Category.assoc (pb₁.map (pb₂.map u)), ← pb₁.map_comp,
              ← CategoryTheory.Category.assoc (pb₂.map u)]
      _ = (eR_inv Y₁ ≫ pb₁.map (pb₂.map g)) ≫ eR_hom (pb₁.obj ℐ) := by
            rw [hh', CategoryTheory.Category.assoc (pb₂.map g), heL_hom_inv ℐ,
