        intro Y f h₁ hh₁
        have hex : ∃ h₁' : Y ⟶ E_U', h₁' ≫ m₁ = f := ⟨h₁, hh₁⟩
        dsimp [sec_val]
        rw [dif_pos hex]
        exact hOverlapEq Y (Classical.choose hex) h₁
      have hsec_m₂ : ∀ {Y : X.Etale} (f : Y ⟶ T_X) (h₂ : Y ⟶ E_out),
          h₂ ≫ m₂ = f → sec_val f = 0 := by
        intro Y f h₂ _
        have hY_out : ∀ z : ↥Y.left, Y.hom.base z ∉ Set.range i₀.base := by
          intro z
          have hz_eq : Y.hom = h₂.left ≫ W_out.ι :=
            (CategoryTheory.MorphismProperty.Over.w h₂).symm
          rw [hz_eq]
          exact (h₂.left.base z).2
        exact hGlobalVanishOut Y hY_out (sec_val f)
      have hsec_pull : ∀ {Y₁ Y₂ : X.Etale} (g : Y₂ ⟶ Y₁) (f₁ : Y₁ ⟶ T_X)
          (hf₁ : R_cov.arrows f₁),
          (S.obj.map g.op) (sec_val f₁) = sec_val (g ≫ f₁) := by
        intro Y₁ Y₂ g f₁ hf₁
        rcases hf₁ with ⟨h₁, hh₁⟩ | ⟨h₂, hh₂⟩
        · rw [hsec_m₁ f₁ h₁ hh₁,
            hsec_m₁ (g ≫ f₁) (g ≫ h₁) (by rw [Category.assoc, hh₁]),
