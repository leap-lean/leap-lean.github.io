    let e_to_G : V_mid →ₗ[K₀] ↥(LinearMap.range G) :=
      LinearMap.codRestrict (LinearMap.range G) e_proj he_mem
    obtain ⟨s_low, hs_low⟩ :=
      LinearMap.exists_rightInverse_of_surjective G.rangeRestrict G.range_rangeRestrict
    let H_split : V_mid →ₗ[K₀] V_low := s_low.comp e_to_G
    have hSplit : G.comp H_split + S_high.comp P = LinearMap.id := by
      ext w
      simp only [H_split, LinearMap.add_apply, LinearMap.comp_apply, LinearMap.id_apply]
      have hGs : G (s_low (e_to_G w)) = e_proj w :=
        congrArg (LinearMap.range G).subtype (LinearMap.congr_fun hs_low (e_to_G w))
      rw [hGs]
      simp only [e_proj, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply,
