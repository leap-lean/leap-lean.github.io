        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
      · simp [K_vδ, hv_app W]
        exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
      · simp [K_vδ, δ_pre]
        exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
    have hK_δu : K_δu.Exact := by
      apply hPresheafExact
      intro W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
      refine (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
      · simp [K_δu, δ_pre]
        exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
      · simp [K_δu, husucc_app W]
        exact (CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm
    have h_vδ : weilEtaleHigherDirectImageMap f q SC.g ≫ weilSmPencilLerayConnHom f SC hSE q = 0 := by
      change Sh_S.map (W_B.map v_pre) ≫ Sh_S.map (W_B.map δ_pre) = 0
      rw [← Sh_S.map_comp, ← W_B.map_comp, h_vδ_pre, W_B.map_zero, Sh_S.map_zero]
    have h_δu : weilSmPencilLerayConnHom f SC hSE q ≫
        weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0 := by
      change Sh_S.map (W_B.map δ_pre) ≫ Sh_S.map (W_B.map u_succ_pre) = 0
      rw [← Sh_S.map_comp, ← W_B.map_comp, h_δu_pre, W_B.map_zero, Sh_S.map_zero]
    exact ⟨h_vδ, h_δu, (hK_vδ.map W_B).map Sh_S, (hK_δu.map W_B).map Sh_S⟩

  have hInjHDI : ∀ (I : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) [CategoryTheory.Injective I]
