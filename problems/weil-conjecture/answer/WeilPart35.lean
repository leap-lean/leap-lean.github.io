        have hg_compat : geomLiftMap Z Ω₀ y₀ (U_aff.map g_hom) k.unop.2 = A₁.2 := by
          rw [hg_map]
          apply Subtype.ext
          change k.unop.2.1 ≫ (Fgt.map (w_k ≫ p_E)).left = A₁.2.1
          rw [Fgt.map_comp]
          change k.unop.2.1 ≫ ((Fgt.map w_k).left ≫ j_E') = A₁.2.1
          rw [← CategoryTheory.Category.assoc, hwk_val]
