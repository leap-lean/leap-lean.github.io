        ⟨⟨hT_BT₂.from T₁, hT_BT₂.hom_ext _ _, hT₁.hom_ext _ _⟩⟩
      let J₁ := Z₁.smallEtaleTopology
      let J₂ := Z₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let pb := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_p := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let π_D := weilEtaleConstPullbackHom h hT₁ hT₂ D
      let Ψ_eqv : ∀ G : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u},
          (C₁.obj D ⟶ G) ≃ (pb.obj (C₂.obj D) ⟶ G) :=
        fun G =>
          (adj₁.homEquiv D G).trans
            ((Iso.homCongr (Iso.refl D) (G.obj.mapIso (CategoryTheory.asIso τ).op)).trans
              ((adj₂.homEquiv D (pf.obj G)).symm.trans
                (adj_p.homEquiv (C₂.obj D) G).symm))
      have hΨ_eq : ∀ (G : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
          (β : C₁.obj D ⟶ G),
          Ψ_eqv G β = π_D ≫ β := by
        intro G β
        dsimp only [Ψ_eqv, Equiv.trans_apply, Iso.homCongr_apply, Iso.refl_inv,
          CategoryTheory.Category.id_comp, CategoryTheory.Functor.mapIso_hom,
          CategoryTheory.Iso.op_hom, CategoryTheory.asIso_hom]
        rw [adj₁.homEquiv_unit]
        have hnat : β.hom.app (Opposite.op T₁) ≫ G.obj.map τ.op =
            (C₁.obj D).obj.map τ.op ≫ β.hom.app (Opposite.op (B.obj T₂)) :=
          (β.hom.naturality τ.op).symm
        let f_τ : D ⟶
            ((CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj
              (Opposite.op T₂)).obj (pf.obj (C₁.obj D)) :=
          adj₁.unit.app D ≫ (C₁.obj D).obj.map τ.op
        have h_inner : (adj₁.unit.app D ≫ β.hom.app (Opposite.op T₁)) ≫ G.obj.map τ.op =
            f_τ ≫
              ((CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj
                (Opposite.op T₂)).map (pf.map β) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (adj₁.unit.app D ≫ ·) hnat).trans
              (CategoryTheory.Category.assoc _ _ _).symm)
        refine (congrArg (fun m => (adj_p.homEquiv (C₂.obj D) G).symm
            ((adj₂.homEquiv D (pf.obj G)).symm m)) h_inner).trans ?_
        rw [adj₂.homEquiv_naturality_right_symm]
        dsimp only [pf]
        rw [adj_p.homEquiv_naturality_right_symm]
        rfl
      let ι_D : C₁.obj D ⟶ pb.obj (C₂.obj D) := (Ψ_eqv (pb.obj (C₂.obj D))).symm (𝟙 _)
      have h_pi : π_D ≫ ι_D = 𝟙 _ := by
        rw [← hΨ_eq]; exact (Ψ_eqv _).apply_symm_apply _
      have h_ip : ι_D ≫ π_D = 𝟙 _ := by
        apply (Ψ_eqv _).injective
        rw [hΨ_eq, hΨ_eq, ← CategoryTheory.Category.assoc, h_pi,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      exact ⟨⟨ι_D, h_pi, h_ip⟩⟩
    
    let hT_Y₀ := weilEtaleIdTerminalIsTerminal.{u} Y₀
    let hT_YA := weilEtaleIdTerminalIsTerminal.{u} Y_A
    let hT_YK := weilEtaleIdTerminalIsTerminal.{u} Y_K
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let Fℤ_A := (CategoryTheory.constantSheaf Y_A.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_K := (CategoryTheory.constantSheaf Y_K.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let πℤ_u := weilEtaleConstPullbackHom u_Y₀ hT_YK hT_YA Aℤ
    haveI : CategoryTheory.IsIso πℤ_u := hConstIso u_Y₀ hT_YK hT_YA Aℤ
    let ιℤ_u : Fℤ_K ⟶ pb_u.obj Fℤ_A := CategoryTheory.inv πℤ_u
    let μ : ∀ (q : ℕ) (M : CategoryTheory.Sheaf Y_A.smallEtaleTopology AddCommGrpCat.{u}),
        M.H q →+ (pb_u.obj M).H q :=
      fun q M =>
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_u).precomp (pb_u.obj M) (Nat.zero_add q)).comp
          (pb_u.mapExtAddHom Fℤ_A M q)
    have hμ_apply : ∀ (q : ℕ) (M : CategoryTheory.Sheaf Y_A.smallEtaleTopology AddCommGrpCat.{u})
        (x : M.H q),
        μ q M x = (CategoryTheory.Abelian.Ext.mk₀ ιℤ_u).comp
          ((pb_u.mapExtAddHom Fℤ_A M q) x) (Nat.zero_add q) :=
      fun _ _ _ => rfl
    have hμ_nat : ∀ (q : ℕ)
        {M₁ M₂ : CategoryTheory.Sheaf Y_A.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : M₁ ⟶ M₂) (x : M₁.H q),
        μ q M₂ (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q)) =
          (μ q M₁ x).comp (CategoryTheory.Abelian.Ext.mk₀ (pb_u.map φ)) (Nat.add_zero q) := by
      intro q M₁ M₂ φ x
      rw [hμ_apply, hμ_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q)]
    have hμ_conn : ∀ (q : ℕ)
        {SC_A : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Y_A.smallEtaleTopology AddCommGrpCat.{u})}
        (hSE_A : SC_A.ShortExact) (y : SC_A.X₃.H q),
        let hSE_K : (SC_A.map pb_u).ShortExact := hSE_A.map_of_exact pb_u
        μ (q + 1) SC_A.X₁ (y.comp hSE_A.extClass (rfl : q + 1 = q + 1)) =
          (μ q SC_A.X₃ y).comp hSE_K.extClass (rfl : q + 1 = q + 1) := by
      intro q SC_A hSE_A y hSE_K
      rw [hμ_apply, hμ_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb_u hSE_A,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add q) (rfl : q + 1 = q + 1) (Nat.zero_add (q + 1))]
    have hμ_deg0 : ∀ (M : CategoryTheory.Sheaf Y_A.smallEtaleTopology AddCommGrpCat.{u}),
        Function.Bijective (((adj_u.unit.app M).hom.app (Opposite.op T_YA)).hom) →
        Function.Bijective (μ 0 M) := by
      intro M hBij_unit
      let B_u := weilEtaleSitePullback u_Y₀
      let _ : CategoryTheory.Limits.PreservesFiniteLimits B_u :=
        CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
          (@AlgebraicGeometry.Etale) u_Y₀
      let hT_BuTA : CategoryTheory.Limits.IsTerminal (B_u.obj T_YA) :=
        hT_YA.isTerminalObj B_u
      let τ_u : B_u.obj T_YA ⟶ weilEtaleIdTerminal.{u} Y_K := hT_YK.from (B_u.obj T_YA)
      haveI : CategoryTheory.IsIso τ_u :=
        ⟨⟨hT_BuTA.from _, hT_BuTA.hom_ext _ _, hT_YK.hom_ext _ _⟩⟩
      let adj_A := CategoryTheory.constantSheafAdj Y_A.smallEtaleTopology AddCommGrpCat.{u} hT_YA
      let adj_K := CategoryTheory.constantSheafAdj Y_K.smallEtaleTopology AddCommGrpCat.{u} hT_YK
      haveI : CategoryTheory.IsIso ((adj_u.unit.app M).hom.app (Opposite.op T_YA)) :=
        (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mpr hBij_unit
      have h_hom_comm : ∀ x_tilde : Fℤ_A ⟶ M,
          (adj_K.homEquiv Aℤ (pb_u.obj M)) (ιℤ_u ≫ pb_u.map x_tilde) ≫
            (pb_u.obj M).obj.map τ_u.op =
          (adj_A.homEquiv Aℤ M) x_tilde ≫ ((adj_u.unit.app M).hom.app (Opposite.op T_YA)) := by
        intro x_tilde
        let β : Fℤ_K ⟶ pb_u.obj M := ιℤ_u ≫ pb_u.map x_tilde
        have hπβ : πℤ_u ≫ β = pb_u.map x_tilde := by
          dsimp [β, ιℤ_u]
          rw [← CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
            CategoryTheory.Category.id_comp]
        let pf_u := (weilEtaleSitePullback u_Y₀).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y_A.smallEtaleTopology Y_K.smallEtaleTopology
        let sec_YA := (CategoryTheory.sheafSections Y_A.smallEtaleTopology AddCommGrpCat.{u}).obj
          (Opposite.op T_YA)
        let u₀ : Aℤ ⟶ sec_YA.obj (pf_u.obj Fℤ_K) :=
          adj_K.unit.app Aℤ ≫ Fℤ_K.obj.map τ_u.op
        let m₀ : Fℤ_A ⟶ pf_u.obj Fℤ_K := (adj_A.homEquiv Aℤ (pf_u.obj Fℤ_K)).symm u₀
        have h1 : (adj_K.homEquiv Aℤ (pb_u.obj M)) β ≫ (pb_u.obj M).obj.map τ_u.op =
            (adj_A.homEquiv Aℤ (pf_u.obj (pb_u.obj M)))
              ((adj_u.homEquiv Fℤ_A (pb_u.obj M)) (πℤ_u ≫ β)) := by
          have e_u : (adj_u.homEquiv Fℤ_A (pb_u.obj M)) (πℤ_u ≫ β) = m₀ ≫ pf_u.map β := by
            rw [adj_u.homEquiv_naturality_right]
            exact congrArg (· ≫ pf_u.map β)
              ((adj_u.homEquiv Fℤ_A Fℤ_K).apply_symm_apply m₀)
          have e_A : (adj_A.homEquiv Aℤ (pf_u.obj (pb_u.obj M))) (m₀ ≫ pf_u.map β) =
              u₀ ≫ sec_YA.map (pf_u.map β) := by
            rw [adj_A.homEquiv_naturality_right]
            exact congrArg (· ≫ sec_YA.map (pf_u.map β))
              ((adj_A.homEquiv Aℤ (pf_u.obj Fℤ_K)).apply_symm_apply u₀)
          have e_K : (adj_K.homEquiv Aℤ (pb_u.obj M)) β =
              adj_K.unit.app Aℤ ≫ β.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Y_K)) := by
            rw [adj_K.homEquiv_unit]; rfl
          have hnat : β.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Y_K)) ≫
              (pb_u.obj M).obj.map τ_u.op =
              Fℤ_K.obj.map τ_u.op ≫ β.hom.app (Opposite.op (B_u.obj T_YA)) :=
            (β.hom.naturality τ_u.op).symm
          exact (congrArg (· ≫ (pb_u.obj M).obj.map τ_u.op) e_K).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (adj_K.unit.app Aℤ ≫ ·) hnat).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (e_A.symm.trans
                    (congrArg (adj_A.homEquiv Aℤ (pf_u.obj (pb_u.obj M))) e_u.symm)))))
        rw [h1, hπβ, adj_u.homEquiv_unit]
        have h_unit_nat : adj_u.unit.app Fℤ_A ≫
            ((weilEtaleSitePullback u_Y₀).sheafPushforwardContinuous AddCommGrpCat.{u}
              Y_A.smallEtaleTopology Y_K.smallEtaleTopology).map (pb_u.map x_tilde) =
            x_tilde ≫ adj_u.unit.app M :=
          (adj_u.unit.naturality x_tilde).symm
        rw [h_unit_nat, adj_A.homEquiv_naturality_right]
        rfl
      have hBij_hom : Function.Bijective (fun x_tilde : Fℤ_A ⟶ M => ιℤ_u ≫ pb_u.map x_tilde) := by
        let u_M_app : M.obj.obj (Opposite.op T_YA) ⟶
            (pb_u.obj M).obj.obj (Opposite.op (B_u.obj T_YA)) :=
          (adj_u.unit.app M).hom.app (Opposite.op T_YA)
        have hIso_uM : CategoryTheory.IsIso u_M_app :=
          (CategoryTheory.ConcreteCategory.isIso_iff_bijective u_M_app).mpr hBij_unit
        let e_rhs : (Fℤ_A ⟶ M) ≃ (Aℤ ⟶ (pb_u.obj M).obj.obj (Opposite.op (B_u.obj T_YA))) :=
          (adj_A.homEquiv Aℤ M).trans
            (Iso.homCongr (Iso.refl Aℤ) (@CategoryTheory.asIso _ _ _ _ u_M_app hIso_uM))
        let e_lhs : (Fℤ_K ⟶ pb_u.obj M) ≃
            (Aℤ ⟶ (pb_u.obj M).obj.obj (Opposite.op (B_u.obj T_YA))) :=
          (adj_K.homEquiv Aℤ (pb_u.obj M)).trans
            (Iso.homCongr (Iso.refl Aℤ)
              ((pb_u.obj M).obj.mapIso (CategoryTheory.asIso τ_u).op))
        have h_eq_fn : (fun x_tilde : Fℤ_A ⟶ M => ιℤ_u ≫ pb_u.map x_tilde) =
            e_lhs.symm ∘ e_rhs := by
          funext x_tilde
          apply e_lhs.injective
          dsimp only [Function.comp_apply]
          rw [e_lhs.apply_symm_apply]
          change 𝟙 Aℤ ≫ (adj_K.homEquiv Aℤ (pb_u.obj M)) (ιℤ_u ≫ pb_u.map x_tilde) ≫
              (pb_u.obj M).obj.map τ_u.op =
            𝟙 Aℤ ≫ (adj_A.homEquiv Aℤ M) x_tilde ≫ u_M_app
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]
          exact h_hom_comm x_tilde
        rw [h_eq_fn]
        exact e_lhs.symm.bijective.comp e_rhs.bijective
      have hμ0_mk : ∀ x_tilde : Fℤ_A ⟶ M,
          μ 0 M (CategoryTheory.Abelian.Ext.mk₀ x_tilde) =
            CategoryTheory.Abelian.Ext.mk₀ (ιℤ_u ≫ pb_u.map x_tilde) := by
        intro x_tilde
        rw [hμ_apply, CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      let e_mkA := Equiv.ofBijective CategoryTheory.Abelian.Ext.mk₀
        (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ_A M)
      let e_mkK := Equiv.ofBijective CategoryTheory.Abelian.Ext.mk₀
        (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ_K (pb_u.obj M))
      have h_fn : (μ 0 M : M.H 0 → (pb_u.obj M).H 0) =
          e_mkK ∘ (fun x_tilde : Fℤ_A ⟶ M => ιℤ_u ≫ pb_u.map x_tilde) ∘ e_mkA.symm := by
        funext x
        obtain ⟨x_tilde, rfl⟩ := e_mkA.surjective x
        change μ 0 M (e_mkA x_tilde) =
          e_mkK (ιℤ_u ≫ pb_u.map (e_mkA.symm (e_mkA x_tilde)))
        rw [e_mkA.symm_apply_apply]
        exact hμ0_mk x_tilde
      rw [h_fn]
      exact e_mkK.bijective.comp (hBij_hom.comp e_mkA.symm.bijective)
    
    have hBij_all : ∀ (n : ℕ) (F : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        Function.Bijective (μ n (pb_g.obj F)) := by
      intro n
      induction n with
      | zero =>
        intro F hF
        exact hμ_deg0 (pb_g.obj F) (hDeg0 F hF)
      | succ m ih =>
        cases m with
        | zero =>
          intro F hF
          obtain ⟨I, hInj, Q, u, v, huv, hQ_tor, hSE₀⟩ := hRes Y₀ F hF
          let _ : CategoryTheory.Injective I := hInj
          let E := U_sh.obj I
          have hE_tor : ℓ • CategoryTheory.CategoryStruct.id E = 0 := hTorU Y₀ I
          let SC₀ := CategoryTheory.ShortComplex.mk u v huv
          let SC_A := SC₀.map pb_g
          have hSE_A : SC_A.ShortExact := hSE₀.map_of_exact pb_g
          let SC_K := SC_A.map pb_u
          have hSE_K : SC_K.ShortExact := hSE_A.map_of_exact pb_u
          have hBij_E0 : Function.Bijective (μ 0 (pb_g.obj E)) := ih E hE_tor
          have hBij_Q0 : Function.Bijective (μ 0 (pb_g.obj Q)) := ih Q hQ_tor
          obtain ⟨hSub_EA1, hSub_EK1⟩ := hAcyc I 1 (le_refl 1)
          constructor
          · rw [injective_iff_map_eq_zero]
            intro z hz
            have hz_f : z.comp (CategoryTheory.Abelian.Ext.mk₀ SC_A.f) (Nat.add_zero 1) = 0 :=
              @Subsingleton.elim _ hSub_EA1 _ _
            obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
              Fℤ_A hSE_A z hz_f (Nat.zero_add 1)
            have hy_K : (μ 0 SC_A.X₃ y).comp hSE_K.extClass (Nat.zero_add 1) = 0 := by
              have hcomm := hμ_conn 0 hSE_A y
              change μ 1 SC_A.X₁ (y.comp hSE_A.extClass (Nat.zero_add 1)) = _ at hcomm
              rw [← hcomm, hy]
              exact hz
            obtain ⟨x', hx'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
              Fℤ_K hSE_K (μ 0 SC_A.X₃ y) (Nat.zero_add 1) hy_K
            obtain ⟨x, rfl⟩ := hBij_E0.2 x'
            have hx_nat : μ 0 SC_A.X₃
                (x.comp (CategoryTheory.Abelian.Ext.mk₀ SC_A.g) (Nat.add_zero 0)) =
                μ 0 SC_A.X₃ y :=
              (hμ_nat 0 SC_A.g x).trans hx'
            have hxy : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC_A.g) (Nat.add_zero 0) = y :=
              hBij_Q0.1 hx_nat
            rw [← hy, ← hxy,
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _
                (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
              hSE_A.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
          · intro z'
            have hz'_f : z'.comp (CategoryTheory.Abelian.Ext.mk₀ SC_K.f) (Nat.add_zero 1) = 0 :=
              @Subsingleton.elim _ hSub_EK1 _ _
            obtain ⟨y', hy'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
              Fℤ_K hSE_K z' hz'_f (Nat.zero_add 1)
            obtain ⟨y, rfl⟩ := hBij_Q0.2 y'
            refine ⟨y.comp hSE_A.extClass (Nat.zero_add 1), ?_⟩
            exact (hμ_conn 0 hSE_A y).trans hy'
        | succ p =>
          intro F hF
          obtain ⟨I, hInj, Q, u, v, huv, hQ_tor, hSE₀⟩ := hRes Y₀ F hF
          let _ : CategoryTheory.Injective I := hInj
          let SC₀ := CategoryTheory.ShortComplex.mk u v huv
          let SC_A := SC₀.map pb_g
          have hSE_A : SC_A.ShortExact := hSE₀.map_of_exact pb_g
          let SC_K := SC_A.map pb_u
          have hSE_K : SC_K.ShortExact := hSE_A.map_of_exact pb_u
          obtain ⟨hSub_EA1, hSub_EK1⟩ := hAcyc I (p + 1) (by omega)
          obtain ⟨hSub_EA2, hSub_EK2⟩ := hAcyc I (p + 2) (by omega)
          have hConnBij : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
              {SC : CategoryTheory.ShortComplex
                (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})}
              (hSE : SC.ShortExact),
              Subsingleton (SC.X₂.H (p + 1)) →
              Subsingleton (SC.X₂.H (p + 2)) →
              Function.Bijective
                (hSE.extClass.postcomp
                  ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
                  (rfl : (p + 1) + 1 = p + 2)) := by
            intro Z SC hSE hS1 hS2
            let Fℤ_Z :=
              (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
            constructor
            · rw [injective_iff_map_eq_zero]
              intro y hy
              obtain ⟨w, hw⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
                Fℤ_Z hSE y (rfl : (p + 1) + 1 = p + 2) hy
              have hw0 : w = 0 := @Subsingleton.elim _ hS1 _ _
              rw [← hw, hw0]
              exact CategoryTheory.Abelian.Ext.zero_comp Fℤ_Z (p + 1)
                (CategoryTheory.Abelian.Ext.mk₀ SC.g) (p + 1) (Nat.add_zero (p + 1))
            · intro z
              have hzf : z.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f)
                  (Nat.add_zero (p + 2)) = 0 :=
                @Subsingleton.elim _ hS2 _ _
              exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
                Fℤ_Z hSE z hzf (rfl : (p + 1) + 1 = p + 2)
          have hBij_δA := hConnBij hSE_A hSub_EA1 hSub_EA2
          have hBij_δK := hConnBij hSE_K hSub_EK1 hSub_EK2
          have hBij_Q := ih Q hQ_tor
          have h_sq : (μ (p + 2) SC_A.X₁) ∘
              (hSE_A.extClass.postcomp Fℤ_A (rfl : (p + 1) + 1 = p + 2)) =
              (hSE_K.extClass.postcomp Fℤ_K (rfl : (p + 1) + 1 = p + 2)) ∘
                (μ (p + 1) SC_A.X₃) := by
            funext y
            exact hμ_conn (p + 1) hSE_A y
