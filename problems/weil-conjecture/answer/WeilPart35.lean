      let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
      let mkZHom : ∀ {M : AddCommGrpCat.{u}}, ↥M → (Aℤ ⟶ M) := fun m =>
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
      let sec_val : ∀ {Y : X.Etale} (_ : Y ⟶ T_X),
