        have hjE_eq : j_E' ≫ ubar₁ = j_E' ≫ ubar₂ := by
          have hcond := CategoryTheory.Limits.pullback.condition (f := Δ) (g := pair_u)
          have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₂ h₂) hcond
          have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd h₂ h₂) hcond
          simp only [Δ, pair_u, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.comp_id] at h1 h2
