theorem weil_sm_pencil_leray_connHom_and_inj_step (sys : WeilEtaleSitePullbackSys.{u})
    {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) :
    let T_S := weilEtaleIdTerminal.{u} S
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    (∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      weilEtaleHigherDirectImageMap f q (CategoryTheory.CategoryStruct.id ℱ) =
        CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q ℱ)) ∧
    (∀ (hT_top : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_S))
        (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact) (q : ℕ) (x : SC.X₃.H q),
      ((weilSmPencilLerayConnHom f SC hSE q).hom.app (Opposite.op T_S))
        (weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ q x) =
      weilOuterTrFibEdgeHom f T_S hT_top SC.X₁ (q + 1)
        (x.comp hSE.extClass (rfl : q + 1 = q + 1))) ∧
    (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
        (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact)
        (Φ_sc : SC₁ ⟶ SC₂) (q : ℕ),
      CategoryTheory.CategoryStruct.comp
        (weilEtaleHigherDirectImageMap f q Φ_sc.τ₃)
        (weilSmPencilLerayConnHom f SC₂ hSE₂ q) =
      CategoryTheory.CategoryStruct.comp
        (weilSmPencilLerayConnHom f SC₁ hSE₁ q)
        (weilEtaleHigherDirectImageMap f (q + 1) Φ_sc.τ₁)) ∧
    (∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂],
      (∀ q : ℕ, 1 ≤ q → CategoryTheory.IsIso (weilSmPencilLerayConnHom f SC hSE q)) ∧
      ((∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q SC.X₁).H p)) →
        (∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q SC.X₃).H p)) ∧
        (∀ n : ℕ, Function.Bijective
          ((CategoryTheory.Abelian.Ext.mk₀ (weilSmPencilLerayConnHom f SC hSE n)).postcomp
            Fℤ_S (Nat.add_zero 2))))) :=
by
  intro T_S Aℤ Fℤ_S
  let J_X := X.smallEtaleTopology
  let J_S := S.smallEtaleTopology
  have : (weilEtaleSitePullback f).IsContinuous J_S J_X := (sys f).hCont
  let B_f : CategoryTheory.Functor S.Etale X.Etale := weilEtaleSitePullback f
  let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X
  have : pf_f.IsRightAdjoint := (sys f).hAdj
  have : pf_f.Additive := (sys f).hAdd_pf
  have : CategoryTheory.Limits.PreservesFiniteLimits pf_f := ⟨fun _ _ _ => inferInstance⟩
  let pb_f := B_f.sheafPullback AddCommGrpCat.{u} J_S J_X
  let adj_f := B_f.sheafAdjunctionContinuous AddCommGrpCat.{u} J_S J_X
  have : pb_f.Additive := (sys f).hAdd_pb
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_f := (sys f).hLim_pb
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_f := (sys f).hColim_pb
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj B_f.op
  let Sh_S : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
    CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  let adj_sh_S := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let L_tot := Free_PSh ⋙ Sh_X
  let R_tot := U_X ⋙ Fgt_PSh
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite X.Etale) AddCommGrpCat.adj
  let adj_sh_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh_X
  let Z_fun : X.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  let δ_pre_of : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
      (_hSE : SC.ShortExact) (q : ℕ),
      SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1) :=
    fun SC hSE q =>
      { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
        naturality := fun {W₁ W₂} ω => by
          have hL : (SC.X₃.cohomologyPresheaf q).map ω =
              ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
          have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
              ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
          rw [hL, hR,
            CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
            CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
          ext α
          exact CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
            (Nat.zero_add q) rfl (by omega) }

  have hBlockA : ∃ (ε₀_app : ∀ G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        weilEtaleHigherDirectImage f 0 G ≅ pf_f.obj G),
      ∀ {G₁ G₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : G₁ ⟶ G₂),
        weilEtaleHigherDirectImageMap f 0 φ ≫ (ε₀_app G₂).hom =
          (ε₀_app G₁).hom ≫ pf_f.map φ := by
    let e_raw : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        CategoryTheory.Abelian.Ext (Z_obj W) F 0 ≃ ↑((U_X.obj F).obj W) :=
      fun W F =>
        CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) F).trans
            CategoryTheory.yonedaEquiv)
    have he_add : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
        e_raw W F (α₁ + α₂) = e_raw W F α₁ + e_raw W F α₂ := by
      intro W F α₁ α₂
      let V := Opposite.unop W
      let u₁ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
      let u₂ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
      have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
        map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
      let ψ : (Z_obj W ⟶ F) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F) :=
        fun u => adj_sh_X.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) F u
      have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
        dsimp [ψ]
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
          CategoryTheory.Adjunction.homEquiv_unit]
        have hmap : U_X.map (u₁ + u₂) = U_X.map u₁ + U_X.map u₂ := rfl
        rw [hmap, CategoryTheory.Preadditive.comp_add]
      let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F) →
          ↑((U_X.obj F).obj W) :=
        fun φ => CategoryTheory.yonedaEquiv
          (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_X.obj F) φ)
      let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
      have hyon : ∀ (φ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F),
          eval_hom φ = (φ.app W) g₀ := by
        intro φ
        dsimp [eval_hom]
        rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
          e_raw W F α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
        intro α
        dsimp [e_raw, eval_hom, ψ, adj_tot]
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        rfl
      rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
        CategoryTheory.NatTrans.app_add]
      rfl
    let e_add : ∀ (W : Opposite X.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W) ≃+
          ↑((U_X.obj F).obj W) :=
      fun W F => AddEquiv.mk' (e_raw W F) (he_add W F)
    let θ_comp : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (W : Opposite X.Etale),
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W ≅
          (U_X.obj F).obj W :=
      fun F W =>
        { hom := AddCommGrpCat.ofHom (e_add W F).toAddMonoidHom
          inv := AddCommGrpCat.ofHom (e_add W F).symm.toAddMonoidHom
          hom_inv_id := by ext x; exact (e_add W F).symm_apply_apply x
          inv_hom_id := by ext y; exact (e_add W F).apply_symm_apply y }
    let θ_obj : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F ≅ U_X.obj F :=
      fun F => CategoryTheory.NatIso.ofComponents (fun W => θ_comp F W) (by
        intro W₁ W₂ ω
        have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).map ω =
            ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F := rfl
        rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F]
        ext α
        let u : Z_obj W₁ ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        change e_raw W₂ F
            ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
          ((U_X.obj F).map ω) (e_raw W₁ F α)
        rw [hα]
        have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
        rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        dsimp [e_raw]
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
          CategoryTheory.Adjunction.homEquiv_naturality_left,
          ← CategoryTheory.yonedaEquiv_naturality',
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rfl)
    let θ : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ U_X :=
      CategoryTheory.NatIso.ofComponents θ_obj (by
        intro F₁ F₂ φ
        ext W α
        have hmap_φ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map φ := rfl
        let u : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        change e_raw W F₂ ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W) α) =
          ((U_X.map φ).app W) (e_raw W F₁ α)
        rw [hmap_φ_mor, CategoryTheory.Abelian.extFunctorObj_map, hα]
        have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
            (CategoryTheory.Abelian.Ext.mk₀ u) =
            CategoryTheory.Abelian.Ext.mk₀ (u ≫ φ) :=
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u φ
        change e_raw W F₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
            (CategoryTheory.Abelian.Ext.mk₀ u)) = _
        rw [hpost]
        dsimp [e_raw]
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
          CategoryTheory.Adjunction.homEquiv_naturality_right,
          CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rfl)
    let U_S := CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}
    let α_iso : ∀ G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        CategoryTheory.Functor.comp B_f.op (CategoryTheory.Sheaf.cohomologyPresheaf G 0) ≅
          U_S.obj (pf_f.obj G) :=
      fun G =>
        { hom := CategoryTheory.Functor.whiskerLeft B_f.op (θ.hom.app G)
          inv := CategoryTheory.Functor.whiskerLeft B_f.op (θ.inv.app G)
          hom_inv_id := by
            ext W x
            exact congrArg (fun τ => (τ.app (B_f.op.obj W)) x) (θ.hom_inv_id_app G)
          inv_hom_id := by
            ext W x
            exact congrArg (fun τ => (τ.app (B_f.op.obj W)) x) (θ.inv_hom_id_app G) }
    have hα_nat : ∀ {G₁ G₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : G₁ ⟶ G₂),
        (CategoryTheory.Functor.whiskerLeft B_f.op
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ) :
          CategoryTheory.Functor.comp B_f.op (CategoryTheory.Sheaf.cohomologyPresheaf G₁ 0) ⟶
            CategoryTheory.Functor.comp B_f.op (CategoryTheory.Sheaf.cohomologyPresheaf G₂ 0)) ≫
          (α_iso G₂).hom =
        (α_iso G₁).hom ≫ U_S.map (pf_f.map φ) := by
      intro G₁ G₂ φ
      ext W x
      exact congrArg (fun τ => (τ.app (B_f.op.obj W)) x) (θ.hom.naturality φ)
    have hGen : ∀ (Sh : CategoryTheory.Functor
          (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}))
        (adj_sh : Sh ⊣ U_S) [CategoryTheory.IsIso adj_sh.counit],
        ∃ (ε₀_app : ∀ G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
            Sh.obj (CategoryTheory.Functor.comp B_f.op
              (CategoryTheory.Sheaf.cohomologyPresheaf G 0)) ≅ pf_f.obj G),
          ∀ {G₁ G₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : G₁ ⟶ G₂),
            Sh.map
              (CategoryTheory.Functor.whiskerLeft B_f.op
                ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ) :
                CategoryTheory.Functor.comp B_f.op (CategoryTheory.Sheaf.cohomologyPresheaf G₁ 0) ⟶
                  CategoryTheory.Functor.comp B_f.op (CategoryTheory.Sheaf.cohomologyPresheaf G₂ 0)) ≫
                (ε₀_app G₂).hom =
              (ε₀_app G₁).hom ≫ pf_f.map φ := by
      intro Sh adj_sh _
      let e_counit := CategoryTheory.asIso adj_sh.counit
      let counit_iso : ∀ H : CategoryTheory.Sheaf J_S AddCommGrpCat.{u},
          Sh.obj (U_S.obj H) ≅ H :=
        fun H =>
          { hom := adj_sh.counit.app H
            inv := e_counit.inv.app H
            hom_inv_id := e_counit.hom_inv_id_app H
            inv_hom_id := e_counit.inv_hom_id_app H }
      let ε₀_fn : ∀ G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
          Sh.obj (CategoryTheory.Functor.comp B_f.op
            (CategoryTheory.Sheaf.cohomologyPresheaf G 0)) ≅ pf_f.obj G :=
        fun G => Sh.mapIso (α_iso G) ≪≫ counit_iso (pf_f.obj G)
      refine ⟨ε₀_fn, fun {G₁ G₂} φ => ?_⟩
      change Sh.map _ ≫ (Sh.map (α_iso G₂).hom ≫ adj_sh.counit.app (pf_f.obj G₂)) =
        (Sh.map (α_iso G₁).hom ≫ adj_sh.counit.app (pf_f.obj G₁)) ≫ pf_f.map φ
      rw [← CategoryTheory.Category.assoc, ← Sh.map_comp, hα_nat φ, Sh.map_comp,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      exact congrArg (Sh.map (α_iso G₁).hom ≫ ·) (adj_sh.counit.naturality (pf_f.map φ))
    dsimp only [weilEtaleHigherDirectImage, weilEtaleHigherDirectImageMap]
    exact hGen (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u})
  obtain ⟨ε₀_app, hε₀_nat⟩ := hBlockA
  have hε₀_inv_nat : ∀ {G₁ G₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : G₁ ⟶ G₂),
      pf_f.map φ ≫ (ε₀_app G₂).inv =
        (ε₀_app G₁).inv ≫ weilEtaleHigherDirectImageMap f 0 φ := by
    intro G₁ G₂ φ
    rw [← CategoryTheory.Category.id_comp (pf_f.map φ ≫ (ε₀_app G₂).inv),
      ← (ε₀_app G₁).inv_hom_id]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc (ε₀_app G₁).hom, ← hε₀_nat φ,
      CategoryTheory.Category.assoc, (ε₀_app G₂).hom_inv_id, CategoryTheory.Category.comp_id]

  have hMapId : ∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      weilEtaleHigherDirectImageMap f q (CategoryTheory.CategoryStruct.id ℱ) =
        CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q ℱ) := by
    intro q ℱ
    dsimp only [weilEtaleHigherDirectImageMap, weilEtaleHigherDirectImage]
    rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.whiskerLeft_id',
      CategoryTheory.Functor.map_id]

  have hEdgeConn : ∀ (hT_top : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_S))
      (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q : ℕ) (x : SC.X₃.H q),
      ((weilSmPencilLerayConnHom f SC hSE q).hom.app (Opposite.op T_S))
        (weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ q x) =
      weilOuterTrFibEdgeHom f T_S hT_top SC.X₁ (q + 1)
        (x.comp hSE.extClass (rfl : q + 1 = q + 1)) := by
    intro hT_top SC hSE q x
    let w_δ := CategoryTheory.Functor.whiskerLeft B_f.op (δ_pre_of SC hSE q)
    let s₀ := weilPolyP1CohomologyTermToPresheaf X (B_f.obj T_S) hT_top SC.X₃ q x
    have hnat_mor := CategoryTheory.NatTrans.congr_app (adj_sh_S.unit.naturality w_δ).symm
      (Opposite.op T_S)
    have hnat_app := congrArg (fun φ => φ s₀) hnat_mor
    dsimp only [weilSmPencilLerayConnHom, weilOuterTrFibEdgeHom, AddMonoidHom.comp_apply]
    dsimp only [CategoryTheory.Functor.comp_map, CategoryTheory.NatTrans.comp_app,
      AddCommGrpCat.coe_comp, Function.comp_apply] at hnat_app
    refine Eq.trans hnat_app ?_
    have hw_s₀ : (w_δ.app (Opposite.op T_S)) s₀ =
        weilPolyP1CohomologyTermToPresheaf X (B_f.obj T_S) hT_top SC.X₁ (q + 1)
          (x.comp hSE.extClass (rfl : q + 1 = q + 1)) :=
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1CohomologyRepToConst X (B_f.obj T_S) hT_top))
        x hSE.extClass (Nat.zero_add q) rfl (Nat.zero_add (q + 1))
    exact congrArg (fun z => ((adj_sh_S.unit.app _).app (Opposite.op T_S)) z) hw_s₀

  have hConnNat : ∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
      (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact)
      (Φ_sc : SC₁ ⟶ SC₂) (q : ℕ),
      CategoryTheory.CategoryStruct.comp
        (weilEtaleHigherDirectImageMap f q Φ_sc.τ₃)
        (weilSmPencilLerayConnHom f SC₂ hSE₂ q) =
      CategoryTheory.CategoryStruct.comp
        (weilSmPencilLerayConnHom f SC₁ hSE₁ q)
        (weilEtaleHigherDirectImageMap f (q + 1) Φ_sc.τ₁) := by
    intro SC₁ SC₂ hSE₁ hSE₂ Φ_sc q
    let δ_pre₁ := δ_pre_of SC₁ hSE₁ q
    let δ_pre₂ := δ_pre_of SC₂ hSE₂ q
    have hpre : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map Φ_sc.τ₃) ≫ δ_pre₂ =
        δ_pre₁ ≫ ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map Φ_sc.τ₁) := by
      apply CategoryTheory.NatTrans.ext
      funext W
      have hτ₃_app :
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map Φ_sc.τ₃).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₃).postcomp (Z_obj W) (Nat.add_zero q)) :=
        CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q Φ_sc.τ₃
      have hτ₁_app :
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map Φ_sc.τ₁).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₁).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
        CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) Φ_sc.τ₁
      have hLHS : (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map Φ_sc.τ₃) ≫
            δ_pre₂).app W =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₃).postcomp (Z_obj W) (Nat.add_zero q)) ≫
            δ_pre₂.app W :=
        congrArg (· ≫ δ_pre₂.app W) hτ₃_app
      have hRHS : (δ_pre₁ ≫
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map Φ_sc.τ₁)).app W =
          δ_pre₁.app W ≫
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₁).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
        congrArg (δ_pre₁.app W ≫ ·) hτ₁_app
      refine hLHS.trans (Eq.trans ?_ hRHS.symm)
      ext α
      exact (CategoryTheory.Abelian.Ext.comp_assoc α
          (CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₃) hSE₂.extClass
          (Nat.add_zero q) (Nat.zero_add 1) rfl).trans
        ((congrArg (fun β => α.comp β rfl)
            (CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₁ hSE₂ Φ_sc).symm).trans
          (CategoryTheory.Abelian.Ext.comp_assoc α
            hSE₁.extClass (CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₁)
            rfl (Nat.add_zero 1) (Nat.add_zero (q + 1))).symm)
    have h1 := (Sh_S.map_comp
      (CategoryTheory.Functor.whiskerLeft B_f.op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map Φ_sc.τ₃))
      (CategoryTheory.Functor.whiskerLeft B_f.op δ_pre₂)).symm
    have h2 := (Sh_S.map_comp
      (CategoryTheory.Functor.whiskerLeft B_f.op δ_pre₁)
      (CategoryTheory.Functor.whiskerLeft B_f.op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map Φ_sc.τ₁))).symm
    refine h1.trans (Eq.trans ?_ h2.symm)
    apply congrArg Sh_S.map
    rw [← CategoryTheory.Functor.whiskerLeft_comp, ← CategoryTheory.Functor.whiskerLeft_comp, hpre]

  have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})),
      (∀ (W : Opposite X.Etale),
        (K.map ((CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
      K.Exact := by
    intro K hW
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
    have hZW : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
    exact hZW.of_iso (K.mapLeftHomologyIso evW).symm

  have hInjAcyc : ∀ (I : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      [CategoryTheory.Injective I] (p : ℕ),
      1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p I) := by
    intro I _ p hp
    obtain ⟨k, rfl⟩ : ∃ k : ℕ, p = k + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← hMapId (k + 1) I]
    have hw_id : CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology (k + 1)).map
          (CategoryTheory.CategoryStruct.id I)) = 0 := by
      rw [CategoryTheory.Functor.map_id]
      ext W x
      let x' : CategoryTheory.Abelian.Ext (Z_obj (B_f.op.obj W)) I (k + 1) := x
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x'
    exact (congrArg
      (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map hw_id).trans
      (CategoryTheory.Functor.map_zero _ _ _)

  have hConnExact : ∀ (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂] (q : ℕ),
      ∃ (hcomp₁ : weilEtaleHigherDirectImageMap f q SC.g ≫
          weilSmPencilLerayConnHom f SC hSE q = 0),
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f q SC.g)
          (weilSmPencilLerayConnHom f SC hSE q) hcomp₁).Exact ∧
        CategoryTheory.Epi (weilSmPencilLerayConnHom f SC hSE q) ∧
        (1 ≤ q → CategoryTheory.IsIso (weilSmPencilLerayConnHom f SC hSE q)) := by
    intro SC hSE _ q
    let δ_pre := δ_pre_of SC hSE q
    have hg_app : ∀ (W : Opposite X.Etale),
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g).app W) =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) :=
      fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.g
    have hf_app : ∀ (W : Opposite X.Etale),
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f).app W) =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
      fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) SC.f
    have hcomp₁_pre : (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g ≫
        δ_pre = 0 := by
      ext W x
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
      have hz : AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) ≫
          AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) = 0 :=
        (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
      have hzx : (AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) ≫
          AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)) x = 0 :=
        congrArg (fun φ => φ x) hz
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hg_app W]
      exact hzx
    have hcomp₂_pre : δ_pre ≫
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f = 0 := by
      ext W x
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
      have hz : AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) = 0 :=
        (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
      have hzx : (AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1)))) x = 0 :=
        congrArg (fun φ => φ x) hz
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W]
      exact hzx
    let A_pre := CategoryTheory.ShortComplex.mk
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g) δ_pre hcomp₁_pre
    let B_pre := CategoryTheory.ShortComplex.mk
      δ_pre ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f) hcomp₂_pre
    have hA_pre_ex : A_pre.Exact := by
      apply hPresheafExact A_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
      let eW : A_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [A_pre, evW]; rw [hg_app W]; ext x; rfl)
          (by dsimp [A_pre, evW, δ_pre, δ_pre_of]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    have hB_pre_ex : B_pre.Exact := by
      apply hPresheafExact B_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
      let eW : B_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [B_pre, evW, δ_pre, δ_pre_of]; ext x; rfl)
          (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    let wg := CategoryTheory.Functor.whiskerLeft B_f.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g)
    let wδ := CategoryTheory.Functor.whiskerLeft B_f.op δ_pre
    let wf := CategoryTheory.Functor.whiskerLeft B_f.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f)
    have hcomp₁_S_pre : wg ≫ wδ = 0 := by
      rw [← CategoryTheory.Functor.whiskerLeft_comp, hcomp₁_pre]
      ext W x
      rfl
    have hcomp₂_S_pre : wδ ≫ wf = 0 := by
      rw [← CategoryTheory.Functor.whiskerLeft_comp, hcomp₂_pre]
      ext W x
      rfl
    let A_S_pre := CategoryTheory.ShortComplex.mk wg wδ hcomp₁_S_pre
    let B_S_pre := CategoryTheory.ShortComplex.mk wδ wf hcomp₂_S_pre
    have hA_S_pre_ex : A_S_pre.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by ext W x; rfl) (by ext W x; rfl))).mp (hA_pre_ex.map W_B)
    have hB_S_pre_ex : B_S_pre.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by ext W x; rfl) (by ext W x; rfl))).mp (hB_pre_ex.map W_B)
    have hcomp₁ : weilEtaleHigherDirectImageMap f q SC.g ≫
        weilSmPencilLerayConnHom f SC hSE q = 0 :=
      (Sh_S.map_comp wg wδ).symm.trans ((congrArg Sh_S.map hcomp₁_S_pre).trans (Sh_S.map_zero _ _))
    have hcomp₂ : weilSmPencilLerayConnHom f SC hSE q ≫
        weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0 :=
      (Sh_S.map_comp wδ wf).symm.trans ((congrArg Sh_S.map hcomp₂_S_pre).trans (Sh_S.map_zero _ _))
    have hEx₁ : (CategoryTheory.ShortComplex.mk
        (weilEtaleHigherDirectImageMap f q SC.g)
        (weilSmPencilLerayConnHom f SC hSE q) hcomp₁).Exact :=
      hA_S_pre_ex.map Sh_S
    have hEx₂ : (CategoryTheory.ShortComplex.mk
        (weilSmPencilLerayConnHom f SC hSE q)
        (weilEtaleHigherDirectImageMap f (q + 1) SC.f) hcomp₂).Exact :=
      hB_S_pre_ex.map Sh_S
    have hZ_succ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f (q + 1) SC.X₂) :=
      hInjAcyc SC.X₂ (q + 1) (Nat.le_add_left 1 q)
    have hf_zero : weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0 :=
      hZ_succ.eq_of_tgt (weilEtaleHigherDirectImageMap f (q + 1) SC.f) 0
    have hEpi_Δ : CategoryTheory.Epi (weilSmPencilLerayConnHom f SC hSE q) :=
      hEx₂.epi_f hf_zero
    refine ⟨hcomp₁, hEx₁, hEpi_Δ, ?_⟩
    intro hq
    have hZ_q : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q SC.X₂) :=
      hInjAcyc SC.X₂ q hq
    have hg_zero : weilEtaleHigherDirectImageMap f q SC.g = 0 :=
      hZ_q.eq_of_src (weilEtaleHigherDirectImageMap f q SC.g) 0
    have : CategoryTheory.Mono (weilSmPencilLerayConnHom f SC hSE q) :=
      hEx₁.mono_g hg_zero
    exact CategoryTheory.isIso_of_mono_of_epi (weilSmPencilLerayConnHom f SC hSE q)

  have hPostIsoBij : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}}
      (α : 𝒢₁ ⟶ 𝒢₂) [CategoryTheory.IsIso α] (p : ℕ),
      Function.Bijective ((CategoryTheory.Abelian.Ext.mk₀ α).postcomp Fℤ_S (Nat.add_zero p)) := by
    intro 𝒢₁ 𝒢₂ α _ p
    let α_inv := CategoryTheory.inv α
    refine Function.bijective_iff_has_inverse.mpr
      ⟨(CategoryTheory.Abelian.Ext.mk₀ α_inv).postcomp Fℤ_S (Nat.add_zero p), ?_, ?_⟩
    · intro z
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero p)).comp
        (CategoryTheory.Abelian.Ext.mk₀ α_inv) (Nat.add_zero p) = z
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · intro w
      change (w.comp (CategoryTheory.Abelian.Ext.mk₀ α_inv) (Nat.add_zero p)).comp
        (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero p) = w
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]

  have hSubIso : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}}
      (α : 𝒢₁ ⟶ 𝒢₂) [CategoryTheory.IsIso α] (p : ℕ),
      Subsingleton (𝒢₂.H p) → Subsingleton (𝒢₁.H p) := by
    intro 𝒢₁ 𝒢₂ α _ p _
    exact (hPostIsoBij α p).1.subsingleton

  have hInjStep : ∀ (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂],
      (∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q SC.X₁).H p)) →
      (∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q SC.X₃).H p)) ∧
      (∀ n : ℕ, Function.Bijective
        ((CategoryTheory.Abelian.Ext.mk₀ (weilSmPencilLerayConnHom f SC hSE n)).postcomp
          Fℤ_S (Nat.add_zero 2))) := by
    intro SC hSE _ hX₁
    have : CategoryTheory.Injective (pf_f.obj SC.X₂) :=
      CategoryTheory.Injective.injective_of_adjoint adj_f SC.X₂
    obtain ⟨hSC_ex, hSC_mono⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_f).mp
        inferInstance SC hSE
    have : CategoryTheory.Mono (pf_f.map SC.f) := hSC_mono
    let ℳ := CategoryTheory.Limits.cokernel (pf_f.map SC.f)
    let q₁ : pf_f.obj SC.X₂ ⟶ ℳ := CategoryTheory.Limits.cokernel.π (pf_f.map SC.f)
    let SC_S1 := CategoryTheory.ShortComplex.mk (pf_f.map SC.f) q₁
      (CategoryTheory.Limits.cokernel.condition (pf_f.map SC.f))
    have hSE_S1 : SC_S1.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel (pf_f.map SC.f)) inferInstance inferInstance
    let j₂ : ℳ ⟶ pf_f.obj SC.X₃ :=
      CategoryTheory.Limits.cokernel.desc (pf_f.map SC.f) (pf_f.map SC.g) (SC.map pf_f).zero
    have : CategoryTheory.Mono j₂ := hSC_ex.mono_cokernelDesc
    obtain ⟨hcomp₁_0, hEx₁_0, hEpi_Δ₀, _⟩ := hConnExact SC hSE 0
    have : CategoryTheory.Epi (weilSmPencilLerayConnHom f SC hSE 0) := hEpi_Δ₀
    let δ₀ : pf_f.obj SC.X₃ ⟶ weilEtaleHigherDirectImage f 1 SC.X₁ :=
      (ε₀_app SC.X₃).inv ≫ weilSmPencilLerayConnHom f SC hSE 0
    have : CategoryTheory.Epi δ₀ := CategoryTheory.epi_comp _ _
    have hcomp₀ : pf_f.map SC.g ≫ δ₀ = 0 := by
      dsimp [δ₀]
      rw [← CategoryTheory.Category.assoc, hε₀_inv_nat SC.g,
        CategoryTheory.Category.assoc, hcomp₁_0, CategoryTheory.Limits.comp_zero]
    have hEx_pf : (CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp₀).Exact := by
      let e_SC : CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f 0 SC.g)
            (weilSmPencilLerayConnHom f SC hSE 0) hcomp₁_0 ≅
          CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp₀ :=
        CategoryTheory.ShortComplex.isoMk
          (ε₀_app SC.X₂) (ε₀_app SC.X₃) (CategoryTheory.Iso.refl _)
          (hε₀_nat SC.g).symm
          (by
            dsimp [δ₀]
            rw [← CategoryTheory.Category.assoc, (ε₀_app SC.X₃).hom_inv_id,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC).mp hEx₁_0
    have hj₂δ₀ : j₂ ≫ δ₀ = 0 := by
      apply (CategoryTheory.cancel_epi q₁).mp
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.cokernel.π_desc]
      exact hcomp₀
    let SC_S2 := CategoryTheory.ShortComplex.mk j₂ δ₀ hj₂δ₀
    let φ_sp : CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp₀ ⟶ SC_S2 :=
      { τ₁ := q₁
        τ₂ := CategoryTheory.CategoryStruct.id (pf_f.obj SC.X₃)
        τ₃ := CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f 1 SC.X₁)
        comm₁₂ := (CategoryTheory.Limits.cokernel.π_desc _ _ _).trans
          (CategoryTheory.Category.comp_id _).symm
        comm₂₃ := (CategoryTheory.Category.id_comp δ₀).trans
          (CategoryTheory.Category.comp_id δ₀).symm }
    have hEx_S2 : SC_S2.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ_sp).mp hEx_pf
    have hSE_S2 : SC_S2.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hEx_S2 inferInstance inferInstance
    have hℳ_sub : ∀ k : ℕ, 2 ≤ k → Subsingleton (ℳ.H k) := by
      intro k hk
      obtain ⟨m, rfl⟩ : ∃ m : ℕ, k = m + 1 := ⟨k - 1, (Nat.sub_add_cancel (by omega)).symm⟩
      have hSub_pfX₁ : Subsingleton ((pf_f.obj SC.X₁).H (m + 2)) :=
        hSubIso (ε₀_app SC.X₁).inv (m + 2) (hX₁ (m + 2) 0 (by omega))
      refine ⟨fun a b => ?_⟩
      let d : ℳ.H (m + 1) := a - b
      have hd_ext : d.comp hSE_S1.extClass (rfl : (m + 1) + 1 = m + 2) = 0 :=
        hSub_pfX₁.elim _ 0
      obtain ⟨v, hv⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_S hSE_S1 d rfl hd_ext
      have hv0 : v = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective v
      rw [hv0, CategoryTheory.Abelian.Ext.zero_comp] at hv
      exact sub_eq_zero.mp hv.symm
    refine ⟨?_, ?_⟩
    · intro p q hp
      cases q with
      | zero =>
        have hSub_ℳp : Subsingleton (ℳ.H p) := hℳ_sub p (by omega)
        have hSub_R1p : Subsingleton ((weilEtaleHigherDirectImage f 1 SC.X₁).H p) :=
          hX₁ p 1 hp
        have hSub_pfX₃ : Subsingleton ((pf_f.obj SC.X₃).H p) := by
          refine ⟨fun a b => ?_⟩
          let d : (pf_f.obj SC.X₃).H p := a - b
          have hd0 : d.comp (CategoryTheory.Abelian.Ext.mk₀ δ₀) (Nat.add_zero p) = 0 :=
            hSub_R1p.elim _ 0
          obtain ⟨m_el, hm_el⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_S hSE_S2 d hd0
          have hm0 : m_el = 0 := hSub_ℳp.elim m_el 0
          rw [hm0, CategoryTheory.Abelian.Ext.zero_comp] at hm_el
          exact sub_eq_zero.mp hm_el.symm
        exact hSubIso (ε₀_app SC.X₃).hom p hSub_pfX₃
      | succ q =>
        have : CategoryTheory.IsIso (weilSmPencilLerayConnHom f SC hSE (q + 1)) :=
          (hConnExact SC hSE (q + 1)).choose_spec.2.2 (Nat.le_add_left 1 q)
        exact hSubIso (weilSmPencilLerayConnHom f SC hSE (q + 1)) p (hX₁ p (q + 2) hp)
    · intro n
      cases n with
      | zero =>
        have hSub_ℳ2 : Subsingleton (ℳ.H 2) := hℳ_sub 2 le_rfl
        have hSub_ℳ3 : Subsingleton (ℳ.H 3) := hℳ_sub 3 (by omega)
        let φ_δ₀ := (CategoryTheory.Abelian.Ext.mk₀ δ₀).postcomp Fℤ_S (Nat.add_zero 2)
        have hφ_bij : Function.Bijective φ_δ₀ := by
          refine ⟨(injective_iff_map_eq_zero φ_δ₀).mpr ?_, ?_⟩
          · intro u hu
            obtain ⟨m_el, hm_el⟩ :=
              CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_S hSE_S2 u hu
            have hm0 : m_el = 0 := hSub_ℳ2.elim m_el 0
            rw [hm0, CategoryTheory.Abelian.Ext.zero_comp] at hm_el
            exact hm_el.symm
          · intro v
            have hv0 : v.comp hSE_S2.extClass (rfl : 2 + 1 = 3) = 0 :=
              hSub_ℳ3.elim _ 0
            exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_S hSE_S2 v rfl hv0
        have hε_δ₀ : (ε₀_app SC.X₃).hom ≫ δ₀ = weilSmPencilLerayConnHom f SC hSE 0 := by
          dsimp [δ₀]
          rw [← CategoryTheory.Category.assoc, (ε₀_app SC.X₃).hom_inv_id,
            CategoryTheory.Category.id_comp]
        have hcomp_fn : ⇑((CategoryTheory.Abelian.Ext.mk₀
              (weilSmPencilLerayConnHom f SC hSE 0)).postcomp Fℤ_S (Nat.add_zero 2)) =
            ⇑φ_δ₀ ∘ ⇑((CategoryTheory.Abelian.Ext.mk₀ (ε₀_app SC.X₃).hom).postcomp
              Fℤ_S (Nat.add_zero 2)) := by
          ext z
          rw [← hε_δ₀, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero z
            (CategoryTheory.Abelian.Ext.mk₀ (ε₀_app SC.X₃).hom)
            (CategoryTheory.Abelian.Ext.mk₀ δ₀) (Nat.add_zero 2)).symm
        rw [hcomp_fn]
        exact hφ_bij.comp (hPostIsoBij (ε₀_app SC.X₃).hom 2)
      | succ n =>
        have : CategoryTheory.IsIso (weilSmPencilLerayConnHom f SC hSE (n + 1)) :=
          (hConnExact SC hSE (n + 1)).choose_spec.2.2 (Nat.le_add_left 1 n)
        exact hPostIsoBij (weilSmPencilLerayConnHom f SC hSE (n + 1)) 2

  exact ⟨hMapId, hEdgeConn, @hConnNat,
    fun SC hSE _ => ⟨fun q hq => (hConnExact SC hSE q).choose_spec.2.2 hq, hInjStep SC hSE⟩⟩

theorem weil_sm_pencil_leray_base_deg2_exact (sys : WeilEtaleSitePullbackSys.{u})
    {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S)
    (hT_top : CategoryTheory.Limits.IsTerminal
      ((weilEtaleSitePullback f).obj (weilEtaleIdTerminal.{u} S))) :
    letI := (sys f).hCont
    letI := (sys f).hAdj
    letI := (sys f).hAdd_pb
    letI := (sys f).hLim_pb
    letI := (sys f).hColim_pb
    let T_S := weilEtaleIdTerminal.{u} S
    let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
    let hT_X := weilEtaleIdTerminalIsTerminal.{u} X
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    let pb_f := (weilEtaleSitePullback f).sheafPullback
      AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    let adj_f := (weilEtaleSitePullback f).sheafAdjunctionContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    ∀ (ιℤ_f : Quiver.Hom Fℤ_X (pb_f.obj Fℤ_S)),
      CategoryTheory.CategoryStruct.comp ιℤ_f (weilEtaleConstPullbackHom f hT_X hT_S Aℤ) =
        CategoryTheory.CategoryStruct.id Fℤ_X →
      CategoryTheory.CategoryStruct.comp (weilEtaleConstPullbackHom f hT_X hT_S Aℤ) ιℤ_f =
        CategoryTheory.CategoryStruct.id (pb_f.obj Fℤ_S) →
      ∀ (𝒜 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton ((weilEtaleHigherDirectImage f 1 𝒜).H 1) →
        ∀ y : 𝒜.H 2,
          weilOuterTrFibEdgeHom f T_S hT_top 𝒜 2 y = 0 ↔
            ∃ w : (pf_f.obj 𝒜).H 2,
              (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app 𝒜)).postcomp Fℤ_X (Nat.add_zero 2)
                ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
                    Fℤ_S (pf_f.obj 𝒜) 2) w)
                  (Nat.zero_add 2)) = y :=
by
  intro T_S hT_S hT_X Aℤ Fℤ_X Fℤ_S pf_f pb_f adj_f ιℤ_f hιf1 hιf2
  have := (sys f).hCont
  have := (sys f).hAdj
  have := (sys f).hAdd_pb
  have := (sys f).hLim_pb
  have := (sys f).hColim_pb
  have : pf_f.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products pf_f
  have : CategoryTheory.Limits.PreservesFiniteLimits pf_f := ⟨fun _ _ _ => inferInstance⟩

  let J_X := X.smallEtaleTopology
  let J_S := S.smallEtaleTopology
  let B_f : CategoryTheory.Functor S.Etale X.Etale := weilEtaleSitePullback f
  let T_X := weilEtaleIdTerminal.{u} X
  let T_top : X.Etale := B_f.obj T_S
  let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  let U_S := CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}
  let adj_sh_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
  let adj_sh_S := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
  let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
    AddCommGrpCat.{u}).obj B_f.op
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let L_tot := Free_PSh ⋙ Sh_X
  let Z_fun : CategoryTheory.Functor X.Etale (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)

  have hmk₀_eqX : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (g : 𝒢₁ ⟶ 𝒢₂),
      CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
    intro 𝒢₁ 𝒢₂ g
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply g

  have hmk₀_eqS : ∀ {ℋ₁ ℋ₂ : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}} (g : ℋ₁ ⟶ ℋ₂),
      CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
    intro ℋ₁ ℋ₂ g
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply g

  have hRepPost : ∀ (V : X.Etale) {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      (r : weilPolyP1CohomologyRepSheaf X V ⟶ 𝒢₁) (ψ : 𝒢₁ ⟶ 𝒢₂),
      weilPolyP1CohomologyRepHomEquiv X V 𝒢₂ (r ≫ ψ) =
        (ψ.hom.app (Opposite.op V)) (weilPolyP1CohomologyRepHomEquiv X V 𝒢₁ r) := by
    intro V 𝒢₁ 𝒢₂ r ψ
    dsimp [weilPolyP1CohomologyRepHomEquiv]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
      CategoryTheory.Adjunction.homEquiv_naturality_right,
      CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply]
    rfl

  
  have hBlockA : ∃ ε₀ : ∀ 𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      weilEtaleHigherDirectImage f 0 𝒢 ≅ pf_f.obj 𝒢,
      (∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : 𝒢₁ ⟶ 𝒢₂),
        weilEtaleHigherDirectImageMap f 0 φ ≫ (ε₀ 𝒢₂).hom = (ε₀ 𝒢₁).hom ≫ pf_f.map φ) ∧
      (∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (W : S.Etale)
          (α : CategoryTheory.Abelian.Ext (weilPolyP1CohomologyRepSheaf X (B_f.obj W)) 𝒢 0),
        ((ε₀ 𝒢).hom.hom.app (Opposite.op W))
          (((adj_sh_S.unit.app (B_f.op ⋙ 𝒢.cohomologyPresheaf 0)).app (Opposite.op W)) α) =
        weilPolyP1CohomologyRepHomEquiv X (B_f.obj W) 𝒢
          (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
    have hRepAdd : ∀ (V : X.Etale) (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        (r₁ r₂ : weilPolyP1CohomologyRepSheaf X V ⟶ 𝒢),
        weilPolyP1CohomologyRepHomEquiv X V 𝒢 (r₁ + r₂) =
          weilPolyP1CohomologyRepHomEquiv X V 𝒢 r₁ +
            weilPolyP1CohomologyRepHomEquiv X V 𝒢 r₂ := by
      intro V 𝒢 r₁ r₂
      have h1 := hRepPost V (𝟙 _) r₁
      have h2 := hRepPost V (𝟙 _) r₂
      have h12 := hRepPost V (𝟙 _) (r₁ + r₂)
      rw [CategoryTheory.Category.id_comp] at h1 h2 h12
      rw [h12, h1, h2]
      have happ : (r₁ + r₂).hom.app (Opposite.op V) =
          r₁.hom.app (Opposite.op V) + r₂.hom.app (Opposite.op V) := by
        rw [← CategoryTheory.NatTrans.app_add]
        exact congrArg (fun t => t.app (Opposite.op V)) (U_X.map_add (f := r₁) (g := r₂))
      rw [happ]
      simp
    let e_raw : ∀ (W : Opposite X.Etale) (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        CategoryTheory.Abelian.Ext (Z_obj W) 𝒢 0 ≃+ ↑((U_X.obj 𝒢).obj W) :=
      fun W 𝒢 =>
        { toFun := fun α =>
            weilPolyP1CohomologyRepHomEquiv X W.unop 𝒢
              (CategoryTheory.Abelian.Ext.addEquiv₀ α)
          invFun := fun s =>
            CategoryTheory.Abelian.Ext.mk₀
              ((weilPolyP1CohomologyRepHomEquiv X W.unop 𝒢).symm s)
          left_inv := fun α => by
            dsimp only []
            rw [Equiv.symm_apply_apply]
            exact CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α
          right_inv := fun s => by
            dsimp only []
            rw [hmk₀_eqX]
            exact Equiv.apply_symm_apply _ s
          map_add' := fun α₁ α₂ => by
            rw [map_add]
            exact hRepAdd W.unop 𝒢 _ _ }
    let θ_comp : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (W : Opposite X.Etale),
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢).obj W ≅
          (U_X.obj 𝒢).obj W :=
      fun 𝒢 W =>
        { hom := AddCommGrpCat.ofHom (e_raw W 𝒢).toAddMonoidHom
          inv := AddCommGrpCat.ofHom (e_raw W 𝒢).symm.toAddMonoidHom
          hom_inv_id := by ext x; exact (e_raw W 𝒢).symm_apply_apply x
          inv_hom_id := by ext x; exact (e_raw W 𝒢).apply_symm_apply x }
    let θ_obj : ∀ 𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢 ≅ U_X.obj 𝒢 :=
      fun 𝒢 => CategoryTheory.NatIso.ofComponents (θ_comp 𝒢) (fun {W₁ W₂} ω => by
        have hmap : (𝒢.cohomologyPresheaf 0).map ω =
            ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app 𝒢 := rfl
        rw [hmap, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) 𝒢]
        ext α
        change weilPolyP1CohomologyRepHomEquiv X W₂.unop 𝒢
            (CategoryTheory.Abelian.Ext.addEquiv₀
              ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0))) =
          ((U_X.obj 𝒢).map ω)
            (weilPolyP1CohomologyRepHomEquiv X W₁.unop 𝒢
              (CategoryTheory.Abelian.Ext.addEquiv₀ α))
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ α) :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        have hcomp : CategoryTheory.Abelian.Ext.addEquiv₀
            ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
            Sh_X.map (Free_PSh.map (CategoryTheory.yoneda.map ω.unop)) ≫
              CategoryTheory.Abelian.Ext.addEquiv₀ α := by
          conv_lhs => rw [hα]
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hmk₀_eqX]
          rfl
        rw [hcomp]
        dsimp [weilPolyP1CohomologyRepHomEquiv]
        rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
          CategoryTheory.Adjunction.homEquiv_naturality_left,
          ← CategoryTheory.yonedaEquiv_naturality']
        rfl)
    let θ : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ U_X :=
      CategoryTheory.NatIso.ofComponents θ_obj (fun {𝒢₁ 𝒢₂} φ => by
        ext W α
        have hmap : (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0)) :=
          CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) 0 φ
        change (θ_comp 𝒢₂ W).hom
            ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W) α) =
          ((U_X.map φ).app W) ((θ_comp 𝒢₁ W).hom α)
        rw [hmap]
        change weilPolyP1CohomologyRepHomEquiv X W.unop 𝒢₂
            (CategoryTheory.Abelian.Ext.addEquiv₀
              (α.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0))) =
          ((U_X.map φ).app W)
            (weilPolyP1CohomologyRepHomEquiv X W.unop 𝒢₁
              (CategoryTheory.Abelian.Ext.addEquiv₀ α))
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ α) :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        have hcomp : CategoryTheory.Abelian.Ext.addEquiv₀
            (α.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
            CategoryTheory.Abelian.Ext.addEquiv₀ α ≫ φ := by
          conv_lhs => rw [hα]
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hmk₀_eqX]
        rw [hcomp]
        exact hRepPost W.unop (CategoryTheory.Abelian.Ext.addEquiv₀ α) φ)
    let θ_WB : ∀ 𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        W_B.obj ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢) ≅
          U_S.obj (pf_f.obj 𝒢) :=
      fun 𝒢 => W_B.mapIso (θ.app 𝒢)
    have hθ_WB_nat : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : 𝒢₁ ⟶ 𝒢₂),
        W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ) ≫
          (θ_WB 𝒢₂).hom =
        (θ_WB 𝒢₁).hom ≫ U_S.map (pf_f.map φ) := by
      intro 𝒢₁ 𝒢₂ φ
      change W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ) ≫
          W_B.map (θ.hom.app 𝒢₂) =
        W_B.map (θ.hom.app 𝒢₁) ≫ W_B.map (U_X.map φ)
      rw [← W_B.map_comp, ← W_B.map_comp, θ.hom.naturality φ]
    let ε₀ : ∀ 𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        weilEtaleHigherDirectImage f 0 𝒢 ≅ pf_f.obj 𝒢 :=
      fun 𝒢 => (Sh_S.mapIso (θ_WB 𝒢)).trans
        (CategoryTheory.asIso (adj_sh_S.counit.app (pf_f.obj 𝒢)))
    refine ⟨ε₀, ?_, ?_⟩
    · intro 𝒢₁ 𝒢₂ φ
      change Sh_S.map (W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ)) ≫
          (Sh_S.map (θ_WB 𝒢₂).hom ≫ adj_sh_S.counit.app (pf_f.obj 𝒢₂)) =
        (Sh_S.map (θ_WB 𝒢₁).hom ≫ adj_sh_S.counit.app (pf_f.obj 𝒢₁)) ≫ pf_f.map φ
      rw [← CategoryTheory.Category.assoc, ← Sh_S.map_comp, hθ_WB_nat φ,
        Sh_S.map_comp, CategoryTheory.Category.assoc]
      have hcounit : Sh_S.map (U_S.map (pf_f.map φ)) ≫ adj_sh_S.counit.app (pf_f.obj 𝒢₂) =
          adj_sh_S.counit.app (pf_f.obj 𝒢₁) ≫ pf_f.map φ :=
        adj_sh_S.counit.naturality (pf_f.map φ)
      rw [hcounit, ← CategoryTheory.Category.assoc]
    · intro 𝒢 W α
      let P₀ := W_B.obj ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢)
      have hunit_comp : adj_sh_S.unit.app P₀ ≫ U_S.map (ε₀ 𝒢).hom = (θ_WB 𝒢).hom := by
        change adj_sh_S.unit.app P₀ ≫
            U_S.map (Sh_S.map (θ_WB 𝒢).hom ≫ adj_sh_S.counit.app (pf_f.obj 𝒢)) =
          (θ_WB 𝒢).hom
        have hnat_u : adj_sh_S.unit.app P₀ ≫ U_S.map (Sh_S.map (θ_WB 𝒢).hom) =
            (θ_WB 𝒢).hom ≫ adj_sh_S.unit.app (U_S.obj (pf_f.obj 𝒢)) :=
          (adj_sh_S.unit.naturality (θ_WB 𝒢).hom).symm
        rw [U_S.map_comp, ← CategoryTheory.Category.assoc, hnat_u,
          CategoryTheory.Category.assoc,
          adj_sh_S.right_triangle_components (pf_f.obj 𝒢),
          CategoryTheory.Category.comp_id]
      exact congrArg (fun t : P₀ ⟶ U_S.obj (pf_f.obj 𝒢) => (t.app (Opposite.op W)) α) hunit_comp

  obtain ⟨ε₀, hε₀_nat, hε₀_unit⟩ := hBlockA

  
  have hUnitNatApp : ∀ {Q₁ Q₂ : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}}
      (w : Q₁ ⟶ Q₂) (a : ↑(Q₁.obj (Opposite.op T_S))),
      (((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map w).hom.app
        (Opposite.op T_S))
        ((((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app Q₁).app (Opposite.op T_S)) a) =
      (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
        AddCommGrpCat.{u}).unit.app Q₂).app (Opposite.op T_S))
        ((w.app (Opposite.op T_S)) a) := by
    intro Q₁ Q₂ w a
    exact congrArg (fun k : Q₁ ⟶ U_S.obj (Sh_S.obj Q₂) => (k.app (Opposite.op T_S)) a)
      (adj_sh_S.unit.naturality w).symm

  have hEdgeConn : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q : ℕ) (x : SC.X₃.H q),
      ((weilSmPencilLerayConnHom f SC hSE q).hom.app (Opposite.op T_S))
        (weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ q x) =
      weilOuterTrFibEdgeHom f T_S hT_top SC.X₁ (q + 1)
        (x.comp hSE.extClass (rfl : q + 1 = q + 1)) := by
    intro SC hSE q x
    let δ_pre : CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ q ⟶
        CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1) :=
      { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
        naturality := fun {W₁ W₂} ω => by
          have hL : (SC.X₃.cohomologyPresheaf q).map ω =
              ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
          have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
              ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
          rw [hL, hR,
            CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
            CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
          ext α
          exact CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
            (Nat.zero_add q) rfl (by omega) }
    let P₃ := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
      (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ q)
    let P₁ := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
      (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1))
    let w_δ : P₃ ⟶ P₁ := CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op δ_pre
    let t_x := weilPolyP1CohomologyTermToPresheaf X ((weilEtaleSitePullback f).obj T_S)
      hT_top SC.X₃ q x
    have hw_eq : weilSmPencilLerayConnHom f SC hSE q =
        (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map w_δ :=
      congrArg ((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
        (X := P₃) (Y := P₁)) (by ext W α; rfl)
    have hw_app : ((weilSmPencilLerayConnHom f SC hSE q).hom.app (Opposite.op T_S))
        (weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ q x) =
      (((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map w_δ).hom.app
        (Opposite.op T_S))
        (weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ q x) :=
      congrArg (fun k : weilEtaleHigherDirectImage f q SC.X₃ ⟶
        weilEtaleHigherDirectImage f (q + 1) SC.X₁ =>
          (k.hom.app (Opposite.op T_S)) (weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ q x)) hw_eq
    have hnat0 := hUnitNatApp w_δ t_x
    have hassoc : (w_δ.app (Opposite.op T_S)) t_x =
        weilPolyP1CohomologyTermToPresheaf X ((weilEtaleSitePullback f).obj T_S) hT_top SC.X₁ (q + 1)
          (x.comp hSE.extClass (rfl : q + 1 = q + 1)) :=
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀
