      exact DFunLike.congr_fun (h1.symm.trans h2) y

    have hSheafTor : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (n : ℕ),
        n • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf S₀ n) = 0 := by
      intro S₀ n
      let C₀ := CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}
      have : C₀.Additive := by
        dsimp [C₀]
        unfold CategoryTheory.constantSheaf
        infer_instance
      let U₀ := AddCommGrpCat.uliftFunctor.{u, 0}
      let A_n := AddCommGrpCat.of (ZMod n)
      have hAn : n • CategoryTheory.CategoryStruct.id A_n = 0 := by
        ext a
        change n • a = 0
        rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
      have hUn : n • CategoryTheory.CategoryStruct.id (U₀.obj A_n) = 0 := by
        rw [← U₀.map_id, ← CategoryTheory.Functor.map_nsmul, hAn, U₀.map_zero]
      change n • CategoryTheory.CategoryStruct.id (C₀.obj (U₀.obj A_n)) = 0
      rw [← C₀.map_id, ← CategoryTheory.Functor.map_nsmul, hUn, C₀.map_zero]

    have := (sys u_bar).hCont; have := (sys u_bar).hAdj
    have := (sys ι_bar).hCont; have := (sys ι_bar).hAdj
    have := (sys ι_bar).hAdd_pb; have := (sys ι_bar).hLim_pb; have := (sys ι_bar).hColim_pb
    let hT_ubar := hTerm u_bar hT_P
    let hT_Zu_over_k := hTerm π_u hT_k
    let hT_Z_over_P := hTerm f_bar hT_P

    have hex_β_fib : ∃ β_fib : ∀ (q n_mod : ℕ),
        Quiver.Hom (weilEtaleHigherDirectImage f_bar q (weilEtaleTorsionSheaf Z_bar n_mod))
          (((weilEtaleSitePullback u_bar).sheafPushforwardContinuous
            AddCommGrpCat.{u} P_bar.smallEtaleTopology S_k.smallEtaleTopology).obj
            (weilEtaleHigherDirectImage π_u q
              (((weilEtaleSitePullback ι_bar).sheafPullback
                AddCommGrpCat.{u} Z_bar.smallEtaleTopology Zu_bar.smallEtaleTopology).obj
                (weilEtaleTorsionSheaf Z_bar n_mod)))),
        ∀ q n_mod, WeilIsSmPencilLerayBCPush f_bar u_bar π_u ι_bar hw_ubar
          (weilEtaleTorsionSheaf Z_bar n_mod) q (β_fib q n_mod) :=
      ⟨fun q n_mod => Classical.choose
        (((hBCPush_gen sys f_bar u_bar π_u ι_bar hw_ubar).1
          (weilEtaleTorsionSheaf Z_bar n_mod) q).1),
       fun q n_mod => Classical.choose_spec
        (((hBCPush_gen sys f_bar u_bar π_u ι_bar hw_ubar).1
          (weilEtaleTorsionSheaf Z_bar n_mod) q).1)⟩
    obtain ⟨β_fib, hβ_fib⟩ := hex_β_fib

    have hex_edge_Zu : ∃ edge_Zu : ∀ (q n_mod : ℕ),
        weilEtaleTorsionH Zu_bar n_mod q ≃+
          ↑((weilEtaleHigherDirectImage π_u q (weilEtaleTorsionSheaf Zu_bar n_mod)).obj.obj
            (Opposite.op T_k)),
        ∀ q n_mod y,
          edge_Zu q n_mod y =
            weilOuterTrFibEdgeHom π_u T_k hT_Zu_over_k (weilEtaleTorsionSheaf Zu_bar n_mod) q y :=
      ⟨fun q n_mod => AddEquiv.ofBijective
        (weilOuterTrFibEdgeHom π_u T_k hT_Zu_over_k (weilEtaleTorsionSheaf Zu_bar n_mod) q)
        (hEdgeSpec Zu_bar π_u hT_Zu_over_k (weilEtaleTorsionSheaf Zu_bar n_mod) q),
       fun _ _ _ => rfl⟩
    obtain ⟨edge_Zu, hedge_Zu⟩ := hex_edge_Zu

    let ev : ∀ (q r : ℕ),
        ↑((weilEtaleHigherDirectImage f_bar q (weilEtaleTorsionSheaf Z_bar (ℓ ^ r))).obj.obj
          (Opposite.op T_P)) →+
          weilEtaleTorsionH Zu_bar (ℓ ^ r) q :=
      fun q r =>
        (edge_Zu q (ℓ ^ r)).symm.toAddMonoidHom.comp
          (weilSmPencilLeraySecPush f_bar u_bar π_u ι_bar hT_ubar (ℓ ^ r) q (β_fib q (ℓ ^ r)))

    have hev1 : ∀ q : ℕ, Function.Bijective (ev q 1) := by
      intro q
      dsimp only [ev, AddMonoidHom.coe_comp]
      refine Function.Bijective.comp (edge_Zu q (ℓ ^ 1)).symm.bijective ?_
      dsimp only [weilSmPencilLeraySecPush, AddMonoidHom.coe_comp]
      let π_M1 := weilEtaleConstPullbackHom ι_bar hT_Zu hT_Z (AM 1)
      have hIso_πM1 : CategoryTheory.IsIso π_M1 := (sys ι_bar).hConstIso hT_Zu hT_Z (AM 1)
      let inv_πM1 := @CategoryTheory.inv _ _ _ _ π_M1 hIso_πM1
      let map_hom := (weilEtaleHigherDirectImageMap π_u q π_M1).hom.app (Opposite.op T_k)
      let map_inv := (weilEtaleHigherDirectImageMap π_u q inv_πM1).hom.app (Opposite.op T_k)
      have hmap_bij : Function.Bijective map_hom.hom := by
        have h_lr : map_hom ≫ map_inv = 𝟙 _ := by
          change ((weilEtaleHigherDirectImageMap π_u q π_M1 ≫
              weilEtaleHigherDirectImageMap π_u q inv_πM1).hom.app (Opposite.op T_k)) = 𝟙 _
          rw [← (hMapEdge π_u q).2.1, CategoryTheory.IsIso.hom_inv_id, (hMapEdge π_u q).1]
          rfl
        have h_rl : map_inv ≫ map_hom = 𝟙 _ := by
          change ((weilEtaleHigherDirectImageMap π_u q inv_πM1 ≫
              weilEtaleHigherDirectImageMap π_u q π_M1).hom.app (Opposite.op T_k)) = 𝟙 _
          rw [← (hMapEdge π_u q).2.1, CategoryTheory.IsIso.inv_hom_id, (hMapEdge π_u q).1]
          rfl
        exact ⟨fun x₁ x₂ hx => by
            have h1 := congrArg map_inv.hom hx
            change (map_hom ≫ map_inv).hom x₁ = (map_hom ≫ map_inv).hom x₂ at h1
            simpa [h_lr] using h1,
          fun y => ⟨map_inv.hom y, by
            change (map_inv ≫ map_hom).hom y = y
            simp [h_rl]⟩⟩
      have hTor1 : ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z_bar (ℓ ^ 1)) = 0 :=
        (congrArg
          (fun k_n => k_n • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z_bar (ℓ ^ 1)))
          (pow_one ℓ).symm).trans (hSheafTor Z_bar (ℓ ^ 1))
      have hIso_bc1 :=
        ((hBCPush_gen sys f_bar u_bar π_u ι_bar hw_ubar).2.2.2
          (weilEtaleTorsionSheaf Z_bar (ℓ ^ 1)) q (β_fib q (ℓ ^ 1))
          (hβ_fib q (ℓ ^ 1))).2 ℓ hPBC_fbar hPb_ubar hTor1
      have hEval_bij := hEvalConst_gen sys P_bar u_bar hT_ubar
        (weilEtaleHigherDirectImage f_bar q (weilEtaleTorsionSheaf Z_bar (ℓ ^ 1)))
        _ (β_fib q (ℓ ^ 1)) (hConst1_pow q).2 hIso_bc1
      exact hmap_bij.comp hEval_bij

    have hev_coeff : ∀ (r₁ r₂ q : ℕ) (φ : ZMod (ℓ ^ r₁) →+ ZMod (ℓ ^ r₂))
        (a : ↑((weilEtaleHigherDirectImage f_bar q
            (weilEtaleTorsionSheaf Z_bar (ℓ ^ r₁))).obj.obj (Opposite.op T_P))),
        let c_φ := AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ)
        let C_Z := CategoryTheory.constantSheaf Z_bar.smallEtaleTopology AddCommGrpCat.{u}
        let C_Zu := CategoryTheory.constantSheaf Zu_bar.smallEtaleTopology AddCommGrpCat.{u}
        ev q r₂
          (((weilEtaleHigherDirectImageMap f_bar q (C_Z.map c_φ)).hom.app
              (Opposite.op T_P)).hom a) =
        ((CategoryTheory.Abelian.Ext.mk₀ (C_Zu.map c_φ)).postcomp
          (C_Zu.obj Aℤ) (Nat.add_zero q)) (ev q r₁ a) := by
      intro r₁ r₂ q φ a c_φ C_Z C_Zu
      apply (edge_Zu q (ℓ ^ r₂)).injective
      have hLHS : edge_Zu q (ℓ ^ r₂)
          (ev q r₂ (((weilEtaleHigherDirectImageMap f_bar q (C_Z.map c_φ)).hom.app
            (Opposite.op T_P)).hom a)) =
          weilSmPencilLeraySecPush f_bar u_bar π_u ι_bar hT_ubar (ℓ ^ r₂) q (β_fib q (ℓ ^ r₂))
            (((weilEtaleHigherDirectImageMap f_bar q (C_Z.map c_φ)).hom.app
              (Opposite.op T_P)).hom a) :=
        (edge_Zu q (ℓ ^ r₂)).apply_symm_apply _
      have hsec₁ : weilSmPencilLeraySecPush f_bar u_bar π_u ι_bar hT_ubar (ℓ ^ r₁) q
          (β_fib q (ℓ ^ r₁)) a =
          weilOuterTrFibEdgeHom π_u T_k hT_Zu_over_k
            (weilEtaleTorsionSheaf Zu_bar (ℓ ^ r₁)) q (ev q r₁ a) := by
        rw [← hedge_Zu]
        exact ((edge_Zu q (ℓ ^ r₁)).apply_symm_apply _).symm
      rw [hLHS,
        (hSecPush f_bar u_bar π_u ι_bar hw_ubar).1 φ q
          (β_fib q (ℓ ^ r₁)) (β_fib q (ℓ ^ r₂)) a (hβ_fib q (ℓ ^ r₁)) (hβ_fib q (ℓ ^ r₂)),
        hsec₁, ((hMapEdge π_u q).2.2.2 T_k hT_Zu_over_k).1 (C_Zu.map c_φ), ← hedge_Zu]

    have hev_conn : ∀ (r₁ r₂ r₃ q : ℕ)
        (φ₁₂ : ZMod (ℓ ^ r₁) →+ ZMod (ℓ ^ r₂))
        (φ₂₃ : ZMod (ℓ ^ r₂) →+ ZMod (ℓ ^ r₃))
        (h0_Z : CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheaf Z_bar.smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₁₂)))
          ((CategoryTheory.constantSheaf Z_bar.smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₂₃))) = 0)
        (h0_Zu : CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheaf Zu_bar.smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₁₂)))
          ((CategoryTheory.constantSheaf Zu_bar.smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₂₃))) = 0)
        (hSE_Z : (CategoryTheory.ShortComplex.mk _ _ h0_Z).ShortExact)
        (hSE_Zu : (CategoryTheory.ShortComplex.mk _ _ h0_Zu).ShortExact)
        (a : ↑((weilEtaleHigherDirectImage f_bar q
            (weilEtaleTorsionSheaf Z_bar (ℓ ^ r₃))).obj.obj (Opposite.op T_P))),
        ev (q + 1) r₁
          (((weilSmPencilLerayConnHom f_bar _ hSE_Z q).hom.app (Opposite.op T_P)).hom a) =
        ((hSE_Zu.extClass.postcomp
          ((CategoryTheory.constantSheaf Zu_bar.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
          (rfl : q + 1 = q + 1)) (ev q r₃ a)) := by
      intro r₁ r₂ r₃ q φ₁₂ φ₂₃ h0_Z h0_Zu hSE_Z hSE_Zu a
      apply (edge_Zu (q + 1) (ℓ ^ r₁)).injective
      have hLHS : edge_Zu (q + 1) (ℓ ^ r₁)
          (ev (q + 1) r₁ (((weilSmPencilLerayConnHom f_bar _ hSE_Z q).hom.app
            (Opposite.op T_P)).hom a)) =
          weilSmPencilLeraySecPush f_bar u_bar π_u ι_bar hT_ubar (ℓ ^ r₁) (q + 1)
            (β_fib (q + 1) (ℓ ^ r₁))
            (((weilSmPencilLerayConnHom f_bar _ hSE_Z q).hom.app (Opposite.op T_P)).hom a) :=
        (edge_Zu (q + 1) (ℓ ^ r₁)).apply_symm_apply _
      have hsec₃ : weilSmPencilLeraySecPush f_bar u_bar π_u ι_bar hT_ubar (ℓ ^ r₃) q
          (β_fib q (ℓ ^ r₃)) a =
          weilOuterTrFibEdgeHom π_u T_k hT_Zu_over_k
            (weilEtaleTorsionSheaf Zu_bar (ℓ ^ r₃)) q (ev q r₃ a) := by
        rw [← hedge_Zu]
        exact ((edge_Zu q (ℓ ^ r₃)).apply_symm_apply _).symm
      rw [hLHS,
        (hSecPush f_bar u_bar π_u ι_bar hw_ubar).2.1 φ₁₂ φ₂₃ q h0_Z h0_Zu hSE_Z hSE_Zu
          (β_fib q (ℓ ^ r₃)) (β_fib (q + 1) (ℓ ^ r₁)) a (hβ_fib q (ℓ ^ r₃)) (hβ_fib (q + 1) (ℓ ^ r₁)),
        hsec₃, ((hMapEdge π_u q).2.2.2 T_k hT_Zu_over_k).2 _ hSE_Zu, ← hedge_Zu]

    have hAllConst :=
      hBockstein_const Z_bar P_bar Zu_bar f_bar
        hH1_const hConst1_pow ev hev1 hev_coeff hev_conn
    have hex_ev_equiv : ∃ ev_equiv : ∀ (q r : ℕ),
        ↑((weilEtaleHigherDirectImage f_bar q (weilEtaleTorsionSheaf Z_bar (ℓ ^ r))).obj.obj
          (Opposite.op T_P)) ≃+
          weilEtaleTorsionH Zu_bar (ℓ ^ r) q,
        ∀ q r a, ev_equiv q r a = ev q r a :=
      ⟨fun q r => AddEquiv.ofBijective (ev q r) (hAllConst q r).2.2.2, fun _ _ _ => rfl⟩
    obtain ⟨ev_equiv, hev_equiv⟩ := hex_ev_equiv

    have hev_edge : ∀ (r : ℕ) (y : weilEtaleTorsionH Z_bar (ℓ ^ r) (2 * m + 2)),
        ev_equiv (2 * m + 2) r
          (weilOuterTrFibEdgeHom f_bar T_P hT_Z_over_P
            (weilEtaleTorsionSheaf Z_bar (ℓ ^ r)) (2 * m + 2) y) = p r y := by
      intro r y
      rw [hev_equiv]
      dsimp only [ev, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [(hSecPush f_bar u_bar π_u ι_bar hw_ubar).2.2 (ℓ ^ r) (2 * m + 2)
          (β_fib (2 * m + 2) (ℓ ^ r)) (p r) y (hβ_fib _ _) (hp_spec r),
        ← hedge_Zu, (edge_Zu (2 * m + 2) (ℓ ^ r)).symm_apply_apply]

    have := (sys e_frob_P.hom).hCont; have := (sys e_frob_P.hom).hAdj
    have := (sys e_frob_P.hom).hAdd_pb; have := (sys e_frob_P.hom).hLim_pb; have := (sys e_frob_P.hom).hColim_pb
    have := (sys e_frob_Z.hom).hCont; have := (sys e_frob_Z.hom).hAdj
    have := (sys e_frob_Z.hom).hAdd_pb; have := (sys e_frob_Z.hom).hLim_pb; have := (sys e_frob_Z.hom).hColim_pb
    have := (sys e_frob_k.hom).hCont; have := (sys e_frob_k.hom).hAdj
    have := (sys e_frob_Zu.hom).hCont; have := (sys e_frob_Zu.hom).hAdj
    have := (sys e_frob_Zu.hom).hAdd_pb; have := (sys e_frob_Zu.hom).hLim_pb; have := (sys e_frob_Zu.hom).hColim_pb

    have hex_β_frob_Z : ∃ β_frob_Z : ∀ (q : ℕ)
        (𝒢 : CategoryTheory.Sheaf Z_bar.smallEtaleTopology AddCommGrpCat.{u}),
        Quiver.Hom (weilEtaleHigherDirectImage f_bar q 𝒢)
          (((weilEtaleSitePullback e_frob_P.hom).sheafPushforwardContinuous
            AddCommGrpCat.{u} P_bar.smallEtaleTopology P_bar.smallEtaleTopology).obj
            (weilEtaleHigherDirectImage f_bar q
              (((weilEtaleSitePullback e_frob_Z.hom).sheafPullback
                AddCommGrpCat.{u} Z_bar.smallEtaleTopology Z_bar.smallEtaleTopology).obj 𝒢))),
        ∀ q 𝒢, WeilIsSmPencilLerayBCPush f_bar e_frob_P.hom f_bar e_frob_Z.hom h_sq_frob 𝒢 q
          (β_frob_Z q 𝒢) :=
      ⟨fun q 𝒢 => Classical.choose
        (((hBCPush_gen sys f_bar e_frob_P.hom f_bar e_frob_Z.hom h_sq_frob).1 𝒢 q).1),
       fun q 𝒢 => Classical.choose_spec
        (((hBCPush_gen sys f_bar e_frob_P.hom f_bar e_frob_Z.hom h_sq_frob).1 𝒢 q).1)⟩
    obtain ⟨β_frob_Z, hβ_frob_Z⟩ := hex_β_frob_Z

    have hex_β_frob_Zu : ∃ β_frob_Zu : ∀ (q n_mod : ℕ),
        Quiver.Hom (weilEtaleHigherDirectImage π_u q (weilEtaleTorsionSheaf Zu_bar n_mod))
          (((weilEtaleSitePullback e_frob_k.hom).sheafPushforwardContinuous
            AddCommGrpCat.{u} S_k.smallEtaleTopology S_k.smallEtaleTopology).obj
            (weilEtaleHigherDirectImage π_u q
              (((weilEtaleSitePullback e_frob_Zu.hom).sheafPullback
                AddCommGrpCat.{u} Zu_bar.smallEtaleTopology Zu_bar.smallEtaleTopology).obj
                (weilEtaleTorsionSheaf Zu_bar n_mod)))),
        ∀ q n_mod, WeilIsSmPencilLerayBCPush π_u e_frob_k.hom π_u e_frob_Zu.hom h_sq_Zu
          (weilEtaleTorsionSheaf Zu_bar n_mod) q (β_frob_Zu q n_mod) :=
      ⟨fun q n_mod => Classical.choose
        (((hBCPush_gen sys π_u e_frob_k.hom π_u e_frob_Zu.hom h_sq_Zu).1
          (weilEtaleTorsionSheaf Zu_bar n_mod) q).1),
       fun q n_mod => Classical.choose_spec
        (((hBCPush_gen sys π_u e_frob_k.hom π_u e_frob_Zu.hom h_sq_Zu).1
          (weilEtaleTorsionSheaf Zu_bar n_mod) q).1)⟩
    obtain ⟨β_frob_Zu, hβ_frob_Zu⟩ := hex_β_frob_Zu

    let hT_frobP := hTerm e_frob_P.hom hT_P
    let frob_A : ∀ r : ℕ,
        ↑((weilEtaleHigherDirectImage f_bar (2 * m)
            (weilEtaleTorsionSheaf Z_bar (ℓ ^ r))).obj.obj (Opposite.op T_P)) →+
        ↑((weilEtaleHigherDirectImage f_bar (2 * m)
            (weilEtaleTorsionSheaf Z_bar (ℓ ^ r))).obj.obj (Opposite.op T_P)) :=
      fun r => weilSmPencilLeraySecPush f_bar e_frob_P.hom f_bar e_frob_Z.hom hT_frobP
        (ℓ ^ r) (2 * m) (β_frob_Z (2 * m) (weilEtaleTorsionSheaf Z_bar (ℓ ^ r)))

    have hev_frob : ∀ (r : ℕ)
        (a : ↑((weilEtaleHigherDirectImage f_bar (2 * m)
            (weilEtaleTorsionSheaf Z_bar (ℓ ^ r))).obj.obj (Opposite.op T_P))),
        ev_equiv (2 * m) r (frob_A r a) = frob_low r (ev_equiv (2 * m) r a) := by
      intro r a
      apply (edge_Zu (2 * m) (ℓ ^ r)).injective
      have hpaste := hPasteSec
        f_bar π_u u_bar π_u ι_bar e_frob_k.hom e_frob_Zu.hom
        e_frob_P.hom f_bar e_frob_Z.hom u_bar ι_bar
        hw_ubar h_sq_Zu h_sq_frob hw_ubar h_sq_u h_sq_ι.symm
        (ℓ ^ r) (2 * m)
        (β_fib (2 * m) (ℓ ^ r)) (β_frob_Zu (2 * m) (ℓ ^ r))
        (β_frob_Z (2 * m) (weilEtaleTorsionSheaf Z_bar (ℓ ^ r))) (β_fib (2 * m) (ℓ ^ r)) a
        (hβ_fib _ _) (hβ_frob_Zu _ _) (hβ_frob_Z _ _) (hβ_fib _ _)
      have hRHS : edge_Zu (2 * m) (ℓ ^ r) (ev_equiv (2 * m) r (frob_A r a)) =
          weilSmPencilLeraySecPush f_bar u_bar π_u ι_bar hT_ubar (ℓ ^ r) (2 * m)
            (β_fib (2 * m) (ℓ ^ r)) (frob_A r a) := by
        rw [hev_equiv]
        exact (edge_Zu (2 * m) (ℓ ^ r)).apply_symm_apply _
      have hsec_a : weilSmPencilLeraySecPush f_bar u_bar π_u ι_bar hT_ubar (ℓ ^ r) (2 * m)
          (β_fib (2 * m) (ℓ ^ r)) a =
          weilOuterTrFibEdgeHom π_u T_k hT_Zu_over_k (weilEtaleTorsionSheaf Zu_bar (ℓ ^ r)) (2 * m)
            (ev_equiv (2 * m) r a) := by
        rw [← hedge_Zu, hev_equiv]
        exact ((edge_Zu (2 * m) (ℓ ^ r)).apply_symm_apply _).symm
      rw [hRHS, ← hpaste, hsec_a,
        (hSecPush π_u e_frob_k.hom π_u e_frob_Zu.hom h_sq_Zu).2.2
          (ℓ ^ r) (2 * m) (β_frob_Zu (2 * m) (ℓ ^ r)) (frob_low r)
          (ev_equiv (2 * m) r a) (hβ_frob_Zu _ _) (hfrob_low_pb r),
        ← hedge_Zu]

    have hω_frob : ∀ r : ℕ, pullH_can e_frob_P.hom (ℓ ^ r) 2 (ω r) = q_card • ω r :=
      fun r => hω_frob_pb r _ (hpullH_spec e_frob_P.hom (ℓ ^ r) 2)

    let J_P := P_bar.smallEtaleTopology
    let C_P := CategoryTheory.constantSheaf J_P AddCommGrpCat.{u}
    have : C_P.Additive := by
      dsimp [C_P]
      unfold CategoryTheory.constantSheaf
      infer_instance
    let adj_P := CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P
    let Fℤ_P := C_P.obj Aℤ
    let R_2m : ℕ → CategoryTheory.Sheaf J_P AddCommGrpCat.{u} :=
      fun r => weilEtaleHigherDirectImage f_bar (2 * m) (weilEtaleTorsionSheaf Z_bar (ℓ ^ r))

    have hModSmul : ∀ {n : ℕ} {M : Type u} [AddCommGroup M] (hn : ∀ x : M, n • x = 0)
        (k_val : ℕ) (x : M), (k_val % n) • x = k_val • x := by
      intro n M _ hn k_val x
      conv_rhs => rw [← Nat.div_add_mod k_val n]
      rw [add_nsmul, mul_comm, mul_smul, hn x, smul_zero, zero_add]
    have hTorElem : ∀ {n : ℕ} {A : AddCommGrpCat.{u}},
        n • CategoryTheory.CategoryStruct.id A = 0 → ∀ x : ↥A, n • x = 0 := by
      intro n A hA x
      have h1 := congrArg (fun φ : A ⟶ A => φ.hom x) hA
      simpa using h1

    let μ_hom : ∀ (r : ℕ) (A : AddCommGrpCat.{u}),
        (ℓ ^ r) • CategoryTheory.CategoryStruct.id A = 0 → ↥A →+ (AM r ⟶ A) :=
      fun r A hA =>
        letI : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hPrime.ne_zero⟩
        { toFun := fun a => AddCommGrpCat.ofHom
            { toFun := fun z => z.down.val • a
              map_zero' := by
                change (0 : ZMod (ℓ ^ r)).val • a = 0
                rw [ZMod.val_zero, zero_nsmul]
              map_add' := fun z₁ z₂ => by
                change (z₁.down + z₂.down).val • a = z₁.down.val • a + z₂.down.val • a
                rw [ZMod.val_add, hModSmul (hTorElem hA) (z₁.down.val + z₂.down.val) a, add_nsmul] }
          map_zero' := by
            ext z
            change z.down.val • (0 : ↥A) = 0
            exact smul_zero _
          map_add' := fun a₁ a₂ => by
            ext z
