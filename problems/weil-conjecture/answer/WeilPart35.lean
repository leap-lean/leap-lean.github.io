    (f_act : ∀ r : ℕ, H r →+ H r)
    (sys : AddSubgroup (∀ r : ℕ, H r))
    (hTors : ∀ (r : ℕ) (w : H r), (ℓ ^ (r + 1)) • w = 0)
    (hExact : ∀ (r : ℕ) (x : H (r + 1)), ρ r x = 0 → ∃ y : H r, ι r y = x)
    (hτ_ι : ∀ (r : ℕ) (y : H r), τ r (ι r y) = ℓ • y)
    (hι_τ_comm : ∀ (r : ℕ) (x : H (r + 1)), ι r (τ r x) = τ (r + 1) (ι (r + 1) x))
    (hρ0 : ρ 0 = τ 0)
    (hρsucc : ∀ (r : ℕ) (x : H (r + 2)), ρ (r + 1) x = ρ r (τ (r + 1) x))
    (hf_comm : ∀ (r : ℕ) (x : H (r + 1)), τ r (f_act (r + 1) x) = f_act r (τ r x))
    (hsys : ∀ x : (∀ r : ℕ, H r), x ∈ sys ↔ ∀ r : ℕ, τ r (x (r + 1)) = x r)
    (hFin0 : Finite (H 0)) :
    (∀ r : ℕ, Finite (H r)) ∧
    ∃ (V : Type u) (_ : AddCommGroup V) (_ : Module (Padic ℓ) V) (_ : Module.Finite (Padic ℓ) V)
      (frob : V →ₗ[Padic ℓ] V)
      (equiv : TensorProduct ℤ ℚ ↥sys ≃+ V),
      (Subsingleton (H 0) → Subsingleton V) ∧
      (∀ (z : PadicInt ℓ) (x y : ↥sys),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
          equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) ∧
      (∀ (x y : ↥sys),
        (∀ r : ℕ, y.1 r = f_act r (x.1 r)) →
          frob (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv (TensorProduct.tmul ℤ (1 : ℚ) y)) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hFin : ∀ r : ℕ, Finite (H r) := by
    intro r
    induction r with
    | zero => exact hFin0
    | succ r ih =>
      have := hFin0
      have := ih
      let I_r : Set (H 0) := Set.range (ρ r)
      have : Finite ↥I_r := Set.Finite.to_subtype (Set.toFinite I_r)
      let b : ↥I_r → H (r + 1) := fun z => Classical.choose z.2
      have hb : ∀ z : ↥I_r, ρ r (b z) = z.1 := fun z => Classical.choose_spec z.2
      refine Finite.of_surjective (fun p : H r × ↥I_r => ι r p.1 + b p.2) ?_
      intro x
      let z : ↥I_r := ⟨ρ r x, ⟨x, rfl⟩⟩
      have h0 : ρ r (x - b z) = 0 := by rw [map_sub, hb z, sub_self]
      obtain ⟨y, hy⟩ := hExact r (x - b z) h0
      exact ⟨(y, z), by dsimp; rw [hy, sub_add_cancel]⟩

  have hSubAll : Subsingleton (H 0) → ∀ r : ℕ, Subsingleton (H r) := by
    intro hSub0 r
    induction r with
    | zero => exact hSub0
    | succ r ih =>
      refine ⟨fun x₁ x₂ => ?_⟩
      have h0 : ∀ x : H (r + 1), x = 0 := fun x => by
        have hρx : ρ r x = 0 := @Subsingleton.elim (H 0) hSub0 _ _
        obtain ⟨y, hy⟩ := hExact r x hρx
        have hy0 : y = 0 := @Subsingleton.elim (H r) ih _ _
        rw [← hy, hy0, map_zero]
      exact (h0 x₁).trans (h0 x₂).symm

  refine ⟨hFin, ?_⟩

  have hMulℓ : ∀ (r : ℕ) (x : H (r + 1)), ι r (τ r x) = ℓ • x :=
    fun r x => (hι_τ_comm r x).trans (hτ_ι (r + 1) x)

  have hMod_nsmul : ∀ {A : Type u} [AddCommGroup A] {N : ℕ} (w : A),
      N • w = 0 → ∀ k : ℕ, (k % N) • w = k • w := by
    intro A _ N w hNw k
    conv_rhs => rw [← Nat.div_add_mod k N]
    rw [add_nsmul, mul_comm N (k / N), mul_nsmul', hNw, smul_zero, zero_add]

  have hz_mem : ∀ (z : PadicInt ℓ) (x : ↥sys),
      (fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r) ∈ sys := by
    intro z x
    rw [hsys]
    intro r
    rw [map_nsmul, (hsys x.1).mp x.2 r]
    have hcast : PadicInt.toZModPow (r + 1) z =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          (PadicInt.toZModPow (r + 2) z) :=
      (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2)
        (Nat.le_succ (r + 1))) z).symm
    have hcast_val : (PadicInt.toZModPow (r + 1) z).val =
        (PadicInt.toZModPow (r + 2) z).val % (ℓ ^ (r + 1)) := by
      rw [hcast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
    rw [hcast_val, hMod_nsmul (x.1 r) (hTors r (x.1 r))]

  let psmul : PadicInt ℓ → ↥sys → ↥sys :=
    fun z x => ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, hz_mem z x⟩

  let instModSys : Module (PadicInt ℓ) ↥sys :=
    { smul := psmul
      one_smul := fun x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) 1).val • x.1 r = x.1 r
        rw [map_one]
        have h1 : ((1 : ZMod (ℓ ^ (r + 1)))).val = 1 % (ℓ ^ (r + 1)) := by
          simpa using ZMod.val_natCast (ℓ ^ (r + 1)) 1
        rw [h1, hMod_nsmul (x.1 r) (hTors r (x.1 r)), one_nsmul])
      mul_smul := fun z₁ z₂ x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) (z₁ * z₂)).val • x.1 r =
          (PadicInt.toZModPow (r + 1) z₁).val • ((PadicInt.toZModPow (r + 1) z₂).val • x.1 r)
        rw [map_mul, ZMod.val_mul, hMod_nsmul (x.1 r) (hTors r (x.1 r)), mul_nsmul'])
      smul_zero := fun z => Subtype.ext (funext fun r => nsmul_zero _)
      smul_add := fun z x₁ x₂ => Subtype.ext (funext fun r => nsmul_add _ _ _)
      add_smul := fun z₁ z₂ x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) (z₁ + z₂)).val • x.1 r =
          (PadicInt.toZModPow (r + 1) z₁).val • x.1 r + (PadicInt.toZModPow (r + 1) z₂).val • x.1 r
        rw [map_add, ZMod.val_add, hMod_nsmul (x.1 r) (hTors r (x.1 r)), add_nsmul])
      zero_smul := fun x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) 0).val • x.1 r = 0
        rw [map_zero, ZMod.val_zero, zero_nsmul]) }
  let _ : Module (PadicInt ℓ) ↥sys := instModSys

  have hsmul_coord : ∀ (z : PadicInt ℓ) (x : ↥sys) (r : ℕ),
      (z • x).1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r := fun _ _ _ => rfl

  have hnsmul_coord : ∀ (k : ℕ) (x : ↥sys) (r : ℕ), (k • x).1 r = k • x.1 r := by
    intro k x r
    induction k with
    | zero => simp
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change (k • x).1 r + x.1 r = _
      rw [ih]

  have hKonig : ∀ x : ↥sys, x.1 0 = 0 → ∃ y : ↥sys, x = (ℓ : PadicInt ℓ) • y := by
    intro x hx0
    have hρ_zero : ∀ r : ℕ, ρ r (x.1 (r + 1)) = 0 := by
      intro r
      induction r with
      | zero =>
        rw [hρ0, (hsys x.1).mp x.2 0, hx0]
      | succ r ih =>
        rw [hρsucc r (x.1 (r + 2)), (hsys x.1).mp x.2 (r + 1), ih]
    let K_fib : ℕ → Type u := fun r => { y : H r // ι r y = x.1 (r + 1) }
    let step : ∀ r : ℕ, K_fib (r + 1) → K_fib r := fun r y_succ =>
      ⟨τ r y_succ.1, by rw [hι_τ_comm r y_succ.1, y_succ.2, (hsys x.1).mp x.2 (r + 1)]⟩
    let iter : ∀ (b a : ℕ), a ≤ b → K_fib b → K_fib a :=
      Nat.rec
        (fun a h y => Eq.mp (congrArg K_fib (Nat.eq_zero_of_le_zero h).symm) y)
        (fun b' rec_b' a h y =>
          if h' : a ≤ b' then rec_b' a h' (step b' y)
          else Eq.mp (congrArg K_fib (by omega : b' + 1 = a)) y)
    have h_iter_id : ∀ (a : ℕ) (ha : a ≤ a) (y : K_fib a), iter a a ha y = y := by
      intro a ha y
      cases a with
      | zero => rfl
      | succ a' =>
        change (if h' : a' + 1 ≤ a' then iter a' (a' + 1) h' (step a' y) else y) = y
        have hnot : ¬ (a' + 1 ≤ a') := Nat.not_succ_le_self a'
        simp only [hnot, ↓reduceDIte]
    have h_iter_comp : ∀ (c a b : ℕ) (hab : a ≤ b) (hbc : b ≤ c) (y : K_fib c),
        iter c a (le_trans hab hbc) y = iter b a hab (iter c b hbc y) := by
      intro c
      induction c with
      | zero =>
        intro a b hab hbc y
        have hb : b = 0 := Nat.eq_zero_of_le_zero hbc
        subst hb
        have ha : a = 0 := Nat.eq_zero_of_le_zero hab
        subst ha
        rfl
      | succ c' ih =>
        intro a b hab hbc y
        by_cases hbc' : b ≤ c'
        · have hac' : a ≤ c' := le_trans hab hbc'
          change (if h' : a ≤ c' then iter c' a h' (step c' y) else _) =
            iter b a hab (if h' : b ≤ c' then iter c' b h' (step c' y) else _)
          simp only [hac', hbc', ↓reduceDIte]
          exact ih a b hab hbc' (step c' y)
        · have hb_eq : b = c' + 1 := by omega
          subst hb_eq
          rw [h_iter_id (c' + 1) hbc y]
    let F_inv : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun n => K_fib (Opposite.unop n)
        map := fun {n₁ n₂} f => TypeCat.ofHom (iter (Opposite.unop n₁) (Opposite.unop n₂) (CategoryTheory.leOfHom f.unop))
        map_id := fun n =>
          congrArg TypeCat.ofHom (funext fun y => h_iter_id (Opposite.unop n) _ y)
        map_comp := fun {n₁ n₂ n₃} f g =>
          congrArg TypeCat.ofHom (funext fun y =>
            h_iter_comp (Opposite.unop n₁) (Opposite.unop n₃) (Opposite.unop n₂)
              (CategoryTheory.leOfHom g.unop) (CategoryTheory.leOfHom f.unop) y) }
    have : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := fun j => by
      have := hFin (Opposite.unop j)
      exact Subtype.finite
    have : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := fun j => by
      obtain ⟨y_j, hy_j⟩ := hExact (Opposite.unop j) (x.1 (Opposite.unop j + 1)) (hρ_zero (Opposite.unop j))
      exact ⟨⟨y_j, hy_j⟩⟩
    obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system F_inv
    have hsec_step : ∀ r : ℕ, τ r (sec (Opposite.op (r + 1))).1 = (sec (Opposite.op r)).1 := by
      intro r
      have hst := hsec (CategoryTheory.homOfLE (Nat.le_succ r)).op
      have h1 : (F_inv.map (CategoryTheory.homOfLE (Nat.le_succ r)).op) (sec (Opposite.op (r + 1))) =
          step r (sec (Opposite.op (r + 1))) := by
        change (if h' : r ≤ r then iter r r h' (step r (sec (Opposite.op (r + 1)))) else _) = _
        have hrr : r ≤ r := le_refl r
        simp only [hrr, ↓reduceDIte]
        exact h_iter_id r hrr _
      rw [h1] at hst
      exact congrArg Subtype.val hst
    let y : ↥sys := ⟨fun r => (sec (Opposite.op r)).1, (hsys _).mpr hsec_step⟩
    refine ⟨y, ?_⟩
    rw [Nat.cast_smul_eq_nsmul (PadicInt ℓ) ℓ y]
    apply Subtype.ext
    ext r
    rw [hnsmul_coord]
    cases r with
    | zero =>
      have h0 := hTors 0 (y.1 0)
      rw [pow_one] at h0
      rw [hx0, h0]
    | succ r =>
      have hy_r : ι r (sec (Opposite.op r)).1 = x.1 (r + 1) := (sec (Opposite.op r)).2
      change x.1 (r + 1) = ℓ • (sec (Opposite.op (r + 1))).1
      rw [← hy_r, ← hsec_step r, hMulℓ r]

  have hModFinSys : Module.Finite (PadicInt ℓ) ↥sys := by
    have := hFin0
    let ev₀ : ↥sys → H 0 := fun x => x.1 0
    let J_im := ↥(Set.range ev₀)
    have : Finite J_im := Set.Finite.to_subtype (Set.toFinite _)
    let _ : Fintype J_im := Fintype.ofFinite J_im
    let g : J_im → ↥sys := fun j => Classical.choose j.2
    have hg : ∀ j : J_im, (g j).1 0 = j.1 := fun j => Classical.choose_spec j.2
    refine ⟨⟨Finset.univ.image g, ?_⟩⟩
    rw [eq_top_iff]
    intro x _
    let step_peel : ↥sys → J_im × ↥sys := fun u =>
      let j : J_im := ⟨u.1 0, ⟨u, rfl⟩⟩
      have h0 : (u - g j).1 0 = 0 := by
        change u.1 0 - (g j).1 0 = 0
        rw [hg j, sub_self]
      (j, Classical.choose (hKonig (u - g j) h0))
    have hpeel_eq : ∀ u : ↥sys,
        u = g (step_peel u).1 + (ℓ : PadicInt ℓ) • (step_peel u).2 := by
      intro u
      let j : J_im := ⟨u.1 0, ⟨u, rfl⟩⟩
      have h0 : (u - g j).1 0 = 0 := by
        change u.1 0 - (g j).1 0 = 0
        rw [hg j, sub_self]
      have hspec : u - g j = (ℓ : PadicInt ℓ) • (step_peel u).2 :=
        Classical.choose_spec (hKonig (u - g j) h0)
      exact eq_add_of_sub_eq' hspec
    let u_seq : ℕ → ↥sys := Nat.rec x (fun _ u => (step_peel u).2)
    let j_seq : ℕ → J_im := fun k => (step_peel (u_seq k)).1
    have hu_expand : ∀ m : ℕ,
        x = (∑ k ∈ Finset.range m, ((ℓ : PadicInt ℓ) ^ k) • g (j_seq k)) +
          ((ℓ : PadicInt ℓ) ^ m) • u_seq m := by
      intro m
      induction m with
      | zero =>
        simp [u_seq]
      | succ m ih =>
        rw [Finset.sum_range_succ, ih, add_assoc]
        congr 1
        conv_lhs => rw [hpeel_eq (u_seq m)]
        rw [smul_add, ← mul_smul, ← pow_succ]
    let s : J_im → ∀ m : ℕ, ZMod (ℓ ^ m) := fun j m =>
      ∑ k ∈ Finset.range m, if j_seq k = j then (ℓ : ZMod (ℓ ^ m)) ^ k else 0
    have hs_compat : ∀ (j : J_im) (m₁ m₂ : ℕ) (hm : m₁ ≤ m₂),
        ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ m₁)) (s j m₂) = s j m₁ := by
      intro j m₁ m₂ hm
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hm
      let cast_m := ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ m₁))
      change cast_m (s j (m₁ + d)) = s j m₁
      dsimp [s]
      rw [Finset.sum_range_add, map_add]
      have hfirst : cast_m
          (∑ k ∈ Finset.range m₁, if j_seq k = j then (ℓ : ZMod (ℓ ^ (m₁ + d))) ^ k else 0) =
          ∑ k ∈ Finset.range m₁, if j_seq k = j then (ℓ : ZMod (ℓ ^ m₁)) ^ k else 0 := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        split_ifs
        · rw [map_pow, map_natCast]
        · rw [map_zero]
      have hsecond : cast_m
          (∑ t ∈ Finset.range d, if j_seq (m₁ + t) = j then (ℓ : ZMod (ℓ ^ (m₁ + d))) ^ (m₁ + t) else 0) = 0 := by
        rw [map_sum]
        refine Finset.sum_eq_zero fun t _ => ?_
        split_ifs
        · rw [map_pow, map_natCast, pow_add, ← Nat.cast_pow, ZMod.natCast_self, zero_mul]
        · rw [map_zero]
      rw [hfirst, hsecond, add_zero]
    let f_hom : J_im → ∀ m : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ m) :=
      fun j m => Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ m))) (s j m)
    have hf_compat : ∀ (j : J_im) (m₁ m₂ : ℕ) (hm : m₁ ≤ m₂),
        (ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ m₁))).comp (f_hom j m₂) = f_hom j m₁ := by
      intro j m₁ m₂ hm
      apply Polynomial.ringHom_ext'
      · ext z
        simp [f_hom]
      · simp [f_hom, hs_compat j m₁ m₂ hm]
    let α : J_im → PadicInt ℓ := fun j => PadicInt.lift (hf_compat j) Polynomial.X
    have hα_spec : ∀ (j : J_im) (m : ℕ), PadicInt.toZModPow m (α j) = s j m := by
      intro j m
      have h := RingHom.congr_fun (PadicInt.lift_spec (hf_compat j) m) Polynomial.X
      simpa [α, f_hom] using h
    have hx_eq_sum : x = ∑ j : J_im, α j • g j := by
      apply Subtype.ext
      ext r
      let α_trunc : J_im → PadicInt ℓ := fun j =>
        ∑ k ∈ Finset.range (r + 1), if j_seq k = j then (ℓ : PadicInt ℓ) ^ k else 0
      have htrunc_zmod : ∀ j : J_im,
          PadicInt.toZModPow (r + 1) (α_trunc j) = PadicInt.toZModPow (r + 1) (α j) := by
        intro j
        rw [hα_spec j (r + 1)]
        dsimp [α_trunc, s]
        rw [map_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        split_ifs
        · rw [map_pow, map_natCast]
        · rw [map_zero]
      have hsum_L : ∑ j : J_im, α_trunc j • g j =
          ∑ k ∈ Finset.range (r + 1), ((ℓ : PadicInt ℓ) ^ k) • g (j_seq k) := by
        calc ∑ j : J_im, α_trunc j • g j
            = ∑ j : J_im, ∑ k ∈ Finset.range (r + 1),
                (if j_seq k = j then (ℓ : PadicInt ℓ) ^ k else 0) • g j := by
                  refine Finset.sum_congr rfl fun j _ => ?_
                  dsimp [α_trunc]
                  rw [Finset.sum_smul]
          _ = ∑ k ∈ Finset.range (r + 1), ∑ j : J_im,
                (if j_seq k = j then ((ℓ : PadicInt ℓ) ^ k) • g j else 0) := by
                  rw [Finset.sum_comm]
                  refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => ?_
                  split_ifs <;> simp
          _ = ∑ k ∈ Finset.range (r + 1), ((ℓ : PadicInt ℓ) ^ k) • g (j_seq k) := by
                  refine Finset.sum_congr rfl fun k _ => ?_
                  rw [Finset.sum_ite_eq Finset.univ (j_seq k) (fun j => ((ℓ : PadicInt ℓ) ^ k) • g j)]
                  simp only [Finset.mem_univ, ↓reduceIte]
      have hrem_r : ((((ℓ : PadicInt ℓ) ^ (r + 1)) • u_seq (r + 1))).1 r = 0 := by
        rw [← Nat.cast_pow, Nat.cast_smul_eq_nsmul, hnsmul_coord]
        exact hTors r _
      have hx_r : x.1 r = (∑ j : J_im, α_trunc j • g j).1 r := by
        have hex := congrArg (fun w : ↥sys => w.1 r) (hu_expand (r + 1))
        change x.1 r = (∑ k ∈ Finset.range (r + 1), ((ℓ : PadicInt ℓ) ^ k) • g (j_seq k)).1 r +
          (((ℓ : PadicInt ℓ) ^ (r + 1)) • u_seq (r + 1)).1 r at hex
        rw [hrem_r, add_zero, ← hsum_L] at hex
        exact hex
      rw [hx_r]
      have hval_sum : ∀ f : J_im → ↥sys, (∑ j : J_im, f j).1 r = ∑ j : J_im, (f j).1 r := by
        intro f
        let pr_r : ↥sys →+ H r :=
          { toFun := fun w => w.1 r
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        exact map_sum pr_r f Finset.univ
      rw [hval_sum, hval_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hsmul_coord, hsmul_coord, htrunc_zmod j]
    rw [hx_eq_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    exact Submodule.smul_mem _ (α j) (Submodule.subset_span (by simp))

  let V : Type u := TensorProduct (PadicInt ℓ) (Padic ℓ) ↥sys
  let _ : Module.Finite (PadicInt ℓ) ↥sys := hModFinSys
  have hFinV : Module.Finite (Padic ℓ) V :=
    Module.Finite.base_change (PadicInt ℓ) (Padic ℓ) ↥sys
  let frob_L : ↥sys →ₗ[PadicInt ℓ] ↥sys :=
    { toFun := fun x => ⟨fun r => f_act r (x.1 r), (hsys _).mpr fun r => by
        rw [hf_comm r (x.1 (r + 1)), (hsys x.1).mp x.2 r]⟩
      map_add' := fun x₁ x₂ => Subtype.ext (funext fun r => map_add (f_act r) _ _)
      map_smul' := fun z x => Subtype.ext (funext fun r => map_nsmul (f_act r) _ _) }
  let frob : V →ₗ[Padic ℓ] V := LinearMap.baseChange (Padic ℓ) frob_L

  let Φ_bilin : ℚ →ₗ[ℤ] ↥sys →ₗ[ℤ] V :=
    { toFun := fun q =>
        { toFun := fun x => TensorProduct.tmul (PadicInt ℓ) (q : Padic ℓ) x
          map_add' := fun x₁ x₂ => TensorProduct.tmul_add _ _ _
          map_smul' := fun m x => by
            dsimp
            rw [← Int.cast_smul_eq_zsmul (PadicInt ℓ) m x,
              ← TensorProduct.smul_tmul (m : PadicInt ℓ) (q : Padic ℓ) x]
            have hm_smul : (m : PadicInt ℓ) • (q : Padic ℓ) = m • (q : Padic ℓ) := by
              change ((m : PadicInt ℓ) : Padic ℓ) * (q : Padic ℓ) = m • (q : Padic ℓ)
              rw [PadicInt.coe_intCast, zsmul_eq_mul]
            rw [hm_smul, ← TensorProduct.smul_tmul'] }
      map_add' := fun q₁ q₂ => LinearMap.ext fun x => by
        dsimp
        rw [Rat.cast_add, TensorProduct.add_tmul]
      map_smul' := fun m q => LinearMap.ext fun x => by
        dsimp
        simp only [zsmul_eq_mul, Rat.cast_mul, Rat.cast_intCast]
        have hm_eq : (m : Padic ℓ) * (q : Padic ℓ) = m • (q : Padic ℓ) :=
          (zsmul_eq_mul (q : Padic ℓ) m).symm
        rw [hm_eq, TensorProduct.smul_tmul'] }
  let Φ_lin : TensorProduct ℤ ℚ ↥sys →ₗ[ℤ] V := TensorProduct.lift Φ_bilin

  let z_lin : PadicInt ℓ → (↥sys →ₗ[ℤ] ↥sys) := fun z =>
    { toFun := fun x => z • x
      map_add' := smul_add z
      map_smul' := fun m x => by
        dsimp
        rw [← Int.cast_smul_eq_zsmul (PadicInt ℓ) m, ← Int.cast_smul_eq_zsmul (PadicInt ℓ) m,
          smul_comm] }
  let z_act_Q : PadicInt ℓ →+* (TensorProduct ℤ ℚ ↥sys →ₗ[ℤ] TensorProduct ℤ ℚ ↥sys) :=
    { toFun := fun z => LinearMap.lTensor ℚ (z_lin z)
      map_one' := LinearMap.ext fun t =>
        @TensorProduct.inductionOn ℤ _ ℚ ↥sys _ _ _ _
          (fun w => (LinearMap.lTensor ℚ (z_lin 1)) w = w) t
          (fun q x => (LinearMap.lTensor_tmul ℚ (z_lin 1) q x).trans
            (congrArg (TensorProduct.tmul ℤ q) (one_smul (PadicInt ℓ) x)))
          (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, ih₁, ih₂])
      map_mul' := fun z₁ z₂ => LinearMap.ext fun t =>
        @TensorProduct.inductionOn ℤ _ ℚ ↥sys _ _ _ _
          (fun w => (LinearMap.lTensor ℚ (z_lin (z₁ * z₂))) w =
            (LinearMap.lTensor ℚ (z_lin z₁)) ((LinearMap.lTensor ℚ (z_lin z₂)) w)) t
          (fun q x =>
            (LinearMap.lTensor_tmul ℚ (z_lin (z₁ * z₂)) q x).trans
              ((congrArg (TensorProduct.tmul ℤ q) (mul_smul z₁ z₂ x)).trans
                ((LinearMap.lTensor_tmul ℚ (z_lin z₁) q (z₂ • x)).symm.trans
                  (congrArg (LinearMap.lTensor ℚ (z_lin z₁))
                    (LinearMap.lTensor_tmul ℚ (z_lin z₂) q x).symm))))
          (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, ih₁, map_add, map_add, ih₂])
      map_zero' := LinearMap.ext fun t =>
        @TensorProduct.inductionOn ℤ _ ℚ ↥sys _ _ _ _
          (fun w => (LinearMap.lTensor ℚ (z_lin 0)) w = 0) t
          (fun q x => (LinearMap.lTensor_tmul ℚ (z_lin 0) q x).trans
            ((congrArg (TensorProduct.tmul ℤ q) (zero_smul (PadicInt ℓ) x)).trans
              (TensorProduct.tmul_zero ↥sys q)))
          (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, ih₁, ih₂, add_zero])
      map_add' := fun z₁ z₂ => LinearMap.ext fun t =>
        @TensorProduct.inductionOn ℤ _ ℚ ↥sys _ _ _ _
          (fun w => (LinearMap.lTensor ℚ (z_lin (z₁ + z₂))) w =
            (LinearMap.lTensor ℚ (z_lin z₁)) w + (LinearMap.lTensor ℚ (z_lin z₂)) w) t
          (fun q x =>
            (LinearMap.lTensor_tmul ℚ (z_lin (z₁ + z₂)) q x).trans
              ((congrArg (TensorProduct.tmul ℤ q) (add_smul z₁ z₂ x)).trans
                ((TensorProduct.tmul_add q (z₁ • x) (z₂ • x)).trans
                  (congrArg₂ (· + ·)
                    (LinearMap.lTensor_tmul ℚ (z_lin z₁) q x).symm
                    (LinearMap.lTensor_tmul ℚ (z_lin z₂) q x).symm))))
          (fun w₁ w₂ ih₁ ih₂ => by
            rw [map_add, ih₁, ih₂, map_add, map_add]
            abel) }
  let instModTens : Module (PadicInt ℓ) (TensorProduct ℤ ℚ ↥sys) := Module.compHom _ z_act_Q
  let _ : Module (PadicInt ℓ) (TensorProduct ℤ ℚ ↥sys) := instModTens
  have h_tens_zsmul : ∀ (z : PadicInt ℓ) (q : ℚ) (x : ↥sys),
      z • (TensorProduct.tmul ℤ q x) = TensorProduct.tmul ℤ q (z • x) :=
    fun z q x => LinearMap.lTensor_tmul ℚ (z_lin z) q x

  have hex_clear : ∀ c : Padic ℓ, ∃ (k : ℕ) (z : PadicInt ℓ), (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * c := by
    intro c
    have h_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h_gt1
    refine ⟨k, ⟨(ℓ : Padic ℓ) ^ k * c, ?_⟩, rfl⟩
    rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by positivity) k
    rw [inv_mul_le_iff₀ hpos, mul_one]
    exact le_of_lt hk

  have hclear_indep : ∀ (c : Padic ℓ) (x : ↥sys) (k₁ k₂ : ℕ) (z₁ z₂ : PadicInt ℓ),
      (z₁ : Padic ℓ) = (ℓ : Padic ℓ) ^ k₁ * c →
      (z₂ : Padic ℓ) = (ℓ : Padic ℓ) ^ k₂ * c →
      TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₁)⁻¹) (z₁ • x) =
        TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₂)⁻¹) (z₂ • x) := by
    intro c x k₁ k₂ z₁ z₂ hz₁ hz₂
    have hz_eq : ((ℓ : PadicInt ℓ) ^ k₂) * z₁ = ((ℓ : PadicInt ℓ) ^ k₁) * z₂ := by
      apply Subtype.ext
      change ((ℓ : Padic ℓ) ^ k₂) * (z₁ : Padic ℓ) = ((ℓ : Padic ℓ) ^ k₁) * (z₂ : Padic ℓ)
      rw [hz₁, hz₂]
      ring
    have h_step : ∀ (a b : ℕ) (z : PadicInt ℓ),
        TensorProduct.tmul ℤ (((ℓ : ℚ) ^ a)⁻¹) (z • x) =
          TensorProduct.tmul ℤ (((ℓ : ℚ) ^ (a + b))⁻¹) ((((ℓ : PadicInt ℓ) ^ b) * z) • x) := by
      intro a b z
      have hℓb_ne : ((ℓ : ℚ) ^ b) ≠ 0 := pow_ne_zero b (Nat.cast_ne_zero.mpr hPrime.ne_zero)
      have hq_eq : (((ℓ : ℚ) ^ a)⁻¹) = ((ℓ ^ b : ℕ) : ℤ) • (((ℓ : ℚ) ^ (a + b))⁻¹) := by
        rw [zsmul_eq_mul, Int.cast_natCast, Nat.cast_pow, pow_add, mul_inv_rev, ← mul_assoc,
          mul_inv_cancel₀ hℓb_ne, one_mul]
      rw [hq_eq, TensorProduct.smul_tmul, natCast_zsmul,
        ← Nat.cast_smul_eq_nsmul (PadicInt ℓ), Nat.cast_pow, mul_smul]
    calc TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₁)⁻¹) (z₁ • x)
        = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ (k₁ + k₂))⁻¹) ((((ℓ : PadicInt ℓ) ^ k₂) * z₁) • x) :=
            h_step k₁ k₂ z₁
      _ = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ (k₂ + k₁))⁻¹) ((((ℓ : PadicInt ℓ) ^ k₁) * z₂) • x) := by
            rw [Nat.add_comm k₁ k₂, hz_eq]
      _ = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₂)⁻¹) (z₂ • x) :=
            (h_step k₂ k₁ z₂).symm

  let ψ_fun : Padic ℓ → ↥sys → TensorProduct ℤ ℚ ↥sys := fun c x =>
    let k := Classical.choose (hex_clear c)
    let z := Classical.choose (Classical.choose_spec (hex_clear c))
    TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k)⁻¹) (z • x)

  have hψ_spec : ∀ (c : Padic ℓ) (x : ↥sys) (k : ℕ) (z : PadicInt ℓ),
      (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * c →
      ψ_fun c x = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k)⁻¹) (z • x) := by
    intro c x k z hz
    exact hclear_indep c x _ k _ z
      (Classical.choose_spec (Classical.choose_spec (hex_clear c))) hz

  let Ψ_bilin : Padic ℓ →ₗ[PadicInt ℓ] ↥sys →ₗ[PadicInt ℓ] TensorProduct ℤ ℚ ↥sys :=
    { toFun := fun c =>
        { toFun := fun x => ψ_fun c x
          map_add' := fun x₁ x₂ => by
            obtain ⟨k, z, hz⟩ := hex_clear c
            rw [hψ_spec c (x₁ + x₂) k z hz, hψ_spec c x₁ k z hz, hψ_spec c x₂ k z hz,
              smul_add, TensorProduct.tmul_add]
          map_smul' := fun w x => by
            dsimp
            obtain ⟨k, z, hz⟩ := hex_clear c
            rw [hψ_spec c (w • x) k z hz, hψ_spec c x k z hz, h_tens_zsmul,
              ← mul_smul, mul_comm z w, mul_smul] }
      map_add' := fun c₁ c₂ => LinearMap.ext fun x => by
        dsimp
        obtain ⟨k₁, z₁, hz₁⟩ := hex_clear c₁
        obtain ⟨k₂, z₂, hz₂⟩ := hex_clear c₂
        let z₁' : PadicInt ℓ := ((ℓ : PadicInt ℓ) ^ k₂) * z₁
        let z₂' : PadicInt ℓ := ((ℓ : PadicInt ℓ) ^ k₁) * z₂
        have hz₁' : (z₁' : Padic ℓ) = (ℓ : Padic ℓ) ^ (k₁ + k₂) * c₁ := by
          change ((ℓ : Padic ℓ) ^ k₂) * (z₁ : Padic ℓ) = _
          rw [hz₁, pow_add]; ring
        have hz₂' : (z₂' : Padic ℓ) = (ℓ : Padic ℓ) ^ (k₁ + k₂) * c₂ := by
          change ((ℓ : Padic ℓ) ^ k₁) * (z₂ : Padic ℓ) = _
          rw [hz₂, pow_add]; ring
        have hz_sum : ((z₁' + z₂' : PadicInt ℓ) : Padic ℓ) = (ℓ : Padic ℓ) ^ (k₁ + k₂) * (c₁ + c₂) := by
          rw [PadicInt.coe_add, hz₁', hz₂', mul_add]
        rw [hψ_spec (c₁ + c₂) x (k₁ + k₂) (z₁' + z₂') hz_sum,
          hψ_spec c₁ x (k₁ + k₂) z₁' hz₁', hψ_spec c₂ x (k₁ + k₂) z₂' hz₂',
          add_smul, TensorProduct.tmul_add]
      map_smul' := fun w c => LinearMap.ext fun x => by
        dsimp
        obtain ⟨k, z, hz⟩ := hex_clear c
        have hwc : ((w * z : PadicInt ℓ) : Padic ℓ) = (ℓ : Padic ℓ) ^ k * (w • c) := by
          change (w : Padic ℓ) * (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * ((w : Padic ℓ) * c)
          rw [hz]; ring
        rw [hψ_spec (w • c) x k (w * z) hwc, hψ_spec c x k z hz, h_tens_zsmul, mul_smul] }
  let Ψ_lin : V →ₗ[PadicInt ℓ] TensorProduct ℤ ℚ ↥sys := TensorProduct.lift Ψ_bilin

  have hΦΨ : ∀ v : V, Φ_lin (Ψ_lin v) = v := by
    intro v
    refine @TensorProduct.inductionOn (PadicInt ℓ) _ (Padic ℓ) ↥sys _ _ _ _
      (fun w => Φ_lin (Ψ_lin w) = w) v ?_ ?_
    · intro c x
      obtain ⟨k, z, hz⟩ := hex_clear c
      have hℓk_ne : ((ℓ : Padic ℓ) ^ k) ≠ 0 := pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
      change Φ_lin (ψ_fun c x) = TensorProduct.tmul (PadicInt ℓ) c x
      rw [hψ_spec c x k z hz]
      change TensorProduct.tmul (PadicInt ℓ) (((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ)) (z • x) =
        TensorProduct.tmul (PadicInt ℓ) c x
      rw [← TensorProduct.smul_tmul]
      congr 1
      change (z : Padic ℓ) * ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) = c
      push_cast
      rw [hz, mul_comm, ← mul_assoc, inv_mul_cancel₀ hℓk_ne, one_mul]
    · intro w₁ w₂ ih₁ ih₂
      rw [map_add, map_add, ih₁, ih₂]

  have hΨΦ : ∀ t : TensorProduct ℤ ℚ ↥sys, Ψ_lin (Φ_lin t) = t := by
    intro t
    refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys _ _ _ _
      (fun w => Ψ_lin (Φ_lin w) = w) t ?_ ?_
    · intro q x
      let m : ℤ := q.num
      let b : ℕ := q.den
      have hb_pos : 0 < b := q.pos
      obtain ⟨k, d, hd_ndvd, hb_eq⟩ :=
        Nat.exists_eq_pow_mul_and_not_dvd hb_pos.ne' ℓ hPrime.ne_one
      have hd_ne : d ≠ 0 := by
        intro hd0
        rw [hd0, mul_zero] at hb_eq
        exact hb_pos.ne' hb_eq
      have hd_cop : ℓ.Coprime d := (hPrime.coprime_iff_not_dvd).mpr hd_ndvd
      have hd_unit : IsUnit (d : PadicInt ℓ) :=
        PadicInt.isUnit_iff.mpr (PadicInt.norm_natCast_eq_one_iff.mpr hd_cop)
      obtain ⟨u_d, hu_d⟩ := hd_unit
      let z : PadicInt ℓ := (m : PadicInt ℓ) * ↑(u_d⁻¹)
      have hdz : (d : PadicInt ℓ) * z = (m : PadicInt ℓ) := by
        dsimp [z]
        rw [← hu_d, ← mul_assoc, mul_comm (u_d : PadicInt ℓ) (m : PadicInt ℓ), mul_assoc,
          Units.mul_inv, mul_one]
      have hz_coe : (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * (q : Padic ℓ) := by
        have hd_K_ne : (d : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
        have hbq : (b : ℚ) * q = (m : ℚ) := by
          dsimp [b, m]
          rw [mul_comm]
          exact Rat.mul_den_eq_num q
        have hbq_K : ((ℓ : Padic ℓ) ^ k * (d : Padic ℓ)) * (q : Padic ℓ) = (m : Padic ℓ) := by
          have h1 := congrArg (Rat.cast : ℚ → Padic ℓ) hbq
          rw [hb_eq] at h1
          push_cast at h1
          exact h1
        have hdz_K : (d : Padic ℓ) * (z : Padic ℓ) = (m : Padic ℓ) := by
          have h1 := congrArg (Subtype.val : PadicInt ℓ → Padic ℓ) hdz
          simpa only [PadicInt.coe_mul, PadicInt.coe_natCast, PadicInt.coe_intCast] using h1
        apply mul_left_cancel₀ hd_K_ne
        rw [hdz_K, ← hbq_K]
        ring
      change ψ_fun (q : Padic ℓ) x = TensorProduct.tmul ℤ q x
      rw [hψ_spec (q : Padic ℓ) x k z hz_coe]
      have hd_Q_ne : (d : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
      have hℓ_inv_eq : (((ℓ : ℚ) ^ k)⁻¹) = (d : ℤ) • ((b : ℚ)⁻¹) := by
        rw [zsmul_eq_mul, Int.cast_natCast, hb_eq, Nat.cast_mul, Nat.cast_pow, mul_inv_rev,
          ← mul_assoc, mul_inv_cancel₀ hd_Q_ne, one_mul]
      have hqb : ((b : ℚ)⁻¹) * (m : ℚ) = q := by
        have hb_Q_ne : (b : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hb_pos.ne'
        have hbq : q * (b : ℚ) = (m : ℚ) := Rat.mul_den_eq_num q
        rw [← hbq, mul_comm q (b : ℚ), ← mul_assoc, inv_mul_cancel₀ hb_Q_ne, one_mul]
      rw [hℓ_inv_eq, TensorProduct.smul_tmul, natCast_zsmul,
        ← Nat.cast_smul_eq_nsmul (PadicInt ℓ) d, ← mul_smul, hdz,
        Int.cast_smul_eq_zsmul (PadicInt ℓ) m x, ← TensorProduct.smul_tmul, zsmul_eq_mul,
        mul_comm (m : ℚ), hqb]
    · intro w₁ w₂ ih₁ ih₂
      rw [map_add, map_add, ih₁, ih₂]

  let equiv : TensorProduct ℤ ℚ ↥sys ≃+ V :=
    { toFun := Φ_lin
      invFun := Ψ_lin
      left_inv := hΨΦ
      right_inv := hΦΨ
      map_add' := Φ_lin.map_add }

  refine ⟨V, inferInstance, inferInstance, hFinV, frob, equiv, ?_, ?_, ?_⟩
  · intro hSub0
    have hSubH := hSubAll hSub0
    have hSubSys : Subsingleton ↥sys := ⟨fun x₁ x₂ => Subtype.ext (funext fun r =>
      @Subsingleton.elim (H r) (hSubH r) _ _)⟩
    have hSubTens : Subsingleton (TensorProduct ℤ ℚ ↥sys) := by
      refine ⟨fun t₁ t₂ => ?_⟩
      have h0 : ∀ t : TensorProduct ℤ ℚ ↥sys, t = 0 := fun t =>
        @TensorProduct.inductionOn ℤ _ ℚ ↥sys _ _ _ _ (fun w => w = 0) t
          (fun q x => by
            have hx0 : x = 0 := @Subsingleton.elim ↥sys hSubSys x 0
            rw [hx0, TensorProduct.tmul_zero])
          (fun w₁ w₂ hw₁ hw₂ => by rw [hw₁, hw₂, add_zero])
      exact (h0 t₁).trans (h0 t₂).symm
    exact equiv.symm.injective.subsingleton
  · intro z x y hxy
    have hy_eq : y = z • x := Subtype.ext (funext hxy)
    rw [hy_eq]
    change TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) (z • x) =
      (z : Padic ℓ) • TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) x
    rw [Rat.cast_one, ← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
    rfl
  · intro x y hxy
    have hy_eq : y = frob_L x := Subtype.ext (funext hxy)
    rw [hy_eq]
    change (LinearMap.baseChange (Padic ℓ) frob_L)
        (TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) x) =
      TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) (frob_L x)
    exact LinearMap.baseChange_tmul frob_L _ x

theorem weil_sing_dev_ar_padic_rationalization_sandwich (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (n₀ c : ℕ)
    (H_M H_I H_N : ℕ → Type u)
    [∀ r, AddCommGroup (H_M r)] [∀ r, AddCommGroup (H_I r)] [∀ r, AddCommGroup (H_N r)]
    (t_M : ∀ r : ℕ, H_M (r + 1) →+ H_M r)
    (t_I : ∀ r : ℕ, H_I (r + 1) →+ H_I r)
    (t_N : ∀ r : ℕ, H_N (r + 1) →+ H_N r)
    (f_M : ∀ r : ℕ, H_M r →+ H_M r)
    (p_IM : ∀ r : ℕ, H_I r →+ H_M r)
    (s_MI : ∀ r : ℕ, H_M (n₀ + r) →+ H_I r)
    (q_IN : ∀ r : ℕ, H_I r →+ H_N r)
    (sys_M : AddSubgroup (∀ r : ℕ, H_M r))
    (sys_N : AddSubgroup (∀ r : ℕ, H_N r))
    (V_N : Type u) [AddCommGroup V_N] [Module (Padic ℓ) V_N] [Module.Finite (Padic ℓ) V_N]
    (equiv_N : TensorProduct ℤ ℚ ↥sys_N ≃+ V_N)
    (hTor_M : ∀ (r : ℕ) (w : H_M r), (ℓ ^ (r + 1)) • w = 0)
    (hTor_I : ∀ (r : ℕ) (w : H_I r), (ℓ ^ (r + 1)) • w = 0)
    (hTor_N : ∀ (r : ℕ) (w : H_N r), (ℓ ^ (r + 1)) • w = 0)
    (hf_comm : ∀ (r : ℕ) (x : H_M (r + 1)), t_M r (f_M (r + 1) x) = f_M r (t_M r x))
    (hp_comm : ∀ (r : ℕ) (y : H_I (r + 1)), t_M r (p_IM (r + 1) y) = p_IM r (t_I r y))
    (hs_comm : ∀ (r : ℕ) (z : H_M (n₀ + r + 1)), t_I r (s_MI (r + 1) z) = s_MI r (t_M (n₀ + r) z))
    (hs_sec : ∀ (x : ∀ r : ℕ, H_M r),
      (∀ r : ℕ, t_M r (x (r + 1)) = x r) → ∀ r : ℕ, p_IM r (s_MI r (x (n₀ + r))) = x r)
    (hq_comm : ∀ (r : ℕ) (y : H_I (r + 1)), t_N r (q_IN (r + 1) y) = q_IN r (t_I r y))
    (hq_ker_tor : ∀ (r : ℕ) (y : H_I r), q_IN r y = 0 → (ℓ ^ c) • y = 0)
    (hsys_M : ∀ x : (∀ r : ℕ, H_M r), x ∈ sys_M ↔ ∀ r : ℕ, t_M r (x (r + 1)) = x r)
    (hsys_N : ∀ x : (∀ r : ℕ, H_N r), x ∈ sys_N ↔ ∀ r : ℕ, t_N r (x (r + 1)) = x r)
    (hsmul_N : ∀ (z : PadicInt ℓ) (x y : ↥sys_N),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
        equiv_N (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv_N (TensorProduct.tmul ℤ (1 : ℚ) x)) :
    ∃ (V_M : Type u) (_ : AddCommGroup V_M) (_ : Module (Padic ℓ) V_M) (_ : Module.Finite (Padic ℓ) V_M)
      (frob_M : V_M →ₗ[Padic ℓ] V_M)
      (equiv_M : TensorProduct ℤ ℚ ↥sys_M ≃+ V_M),
      (∀ (z : PadicInt ℓ) (x y : ↥sys_M),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
          equiv_M (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv_M (TensorProduct.tmul ℤ (1 : ℚ) x)) ∧
      (∀ (x y : ↥sys_M),
        (∀ r : ℕ, y.1 r = f_M r (x.1 r)) →
          frob_M (equiv_M (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv_M (TensorProduct.tmul ℤ (1 : ℚ) y)) :=
by
  classical
  have _ := And.intro hTor_I hp_comm
  have hPrime : Nat.Prime ℓ := Fact.out

  
  have hMod_nsmul : ∀ {A : Type u} [AddCommGroup A] {N : ℕ} (w : A),
      N • w = 0 → ∀ k : ℕ, (k % N) • w = k • w := by
    intro A _ N w hNw k
    conv_rhs => rw [← Nat.div_add_mod k N]
    rw [add_nsmul, mul_comm N (k / N), mul_nsmul', hNw, smul_zero, zero_add]

  have hzmod_mod : ∀ (m₁ m₂ : ℕ) (hm : m₁ ≤ m₂) (z : PadicInt ℓ),
      (PadicInt.toZModPow m₁ z).val = (PadicInt.toZModPow m₂ z).val % (ℓ ^ m₁) := by
    intro m₁ m₂ hm z
    have : NeZero (ℓ ^ m₁) := ⟨pow_ne_zero m₁ hPrime.ne_zero⟩
    have hcast : PadicInt.toZModPow m₁ z =
        ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ m₁)) (PadicInt.toZModPow m₂ z) :=
      (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow m₁ m₂ hm) z).symm
    rw [hcast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]

  have hz_mem_M : ∀ (z : PadicInt ℓ) (x : ↥sys_M),
      (fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r) ∈ sys_M := by
    intro z x
    rw [hsys_M]
    intro r
    rw [map_nsmul, (hsys_M x.1).mp x.2 r,
      hzmod_mod (r + 1) (r + 2) (Nat.le_succ (r + 1)) z,
      hMod_nsmul (x.1 r) (hTor_M r (x.1 r))]

  let instModM : Module (PadicInt ℓ) ↥sys_M :=
    { smul := fun z x => ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, hz_mem_M z x⟩
      one_smul := fun x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) 1).val • x.1 r = x.1 r
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
        rw [map_one]
        have h1 : ((1 : ZMod (ℓ ^ (r + 1)))).val = 1 % (ℓ ^ (r + 1)) := by
          simpa using ZMod.val_natCast (ℓ ^ (r + 1)) 1
        rw [h1, hMod_nsmul (x.1 r) (hTor_M r (x.1 r)), one_nsmul])
      mul_smul := fun z₁ z₂ x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) (z₁ * z₂)).val • x.1 r =
          (PadicInt.toZModPow (r + 1) z₁).val • ((PadicInt.toZModPow (r + 1) z₂).val • x.1 r)
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
        rw [map_mul, ZMod.val_mul, hMod_nsmul (x.1 r) (hTor_M r (x.1 r)), mul_nsmul'])
      smul_zero := fun _ => Subtype.ext (funext fun _ => nsmul_zero _)
      smul_add := fun _ _ _ => Subtype.ext (funext fun _ => nsmul_add _ _ _)
      add_smul := fun z₁ z₂ x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) (z₁ + z₂)).val • x.1 r =
          (PadicInt.toZModPow (r + 1) z₁).val • x.1 r + (PadicInt.toZModPow (r + 1) z₂).val • x.1 r
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
        rw [map_add, ZMod.val_add, hMod_nsmul (x.1 r) (hTor_M r (x.1 r)), add_nsmul])
      zero_smul := fun x => Subtype.ext (funext fun r => by
        change (PadicInt.toZModPow (r + 1) 0).val • x.1 r = 0
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
        rw [map_zero, ZMod.val_zero, zero_nsmul]) }
  let _ : Module (PadicInt ℓ) ↥sys_M := instModM

  let frob_sys_M : ↥sys_M →ₗ[PadicInt ℓ] ↥sys_M :=
    { toFun := fun x => ⟨fun r => f_M r (x.1 r), (hsys_M _).mpr fun r => by
        rw [hf_comm r (x.1 (r + 1)), (hsys_M x.1).mp x.2 r]⟩
      map_add' := fun x₁ x₂ => Subtype.ext (funext fun r => map_add (f_M r) _ _)
      map_smul' := fun z x => Subtype.ext (funext fun r => map_nsmul (f_M r) _ _) }

  
  let θ_MN : ↥sys_M →+ ↥sys_N :=
    { toFun := fun x => ⟨fun r => q_IN r (s_MI r (x.1 (n₀ + r))), (hsys_N _).mpr fun r => by
        change t_N r (q_IN (r + 1) (s_MI (r + 1) (x.1 (n₀ + r + 1)))) =
          q_IN r (s_MI r (x.1 (n₀ + r)))
        rw [hq_comm r, hs_comm r, (hsys_M x.1).mp x.2 (n₀ + r)]⟩
      map_zero' := Subtype.ext (funext fun r => by
        change q_IN r (s_MI r 0) = 0
        rw [map_zero, map_zero])
      map_add' := fun x₁ x₂ => Subtype.ext (funext fun r => by
        change q_IN r (s_MI r (x₁.1 (n₀ + r) + x₂.1 (n₀ + r))) =
          q_IN r (s_MI r (x₁.1 (n₀ + r))) + q_IN r (s_MI r (x₂.1 (n₀ + r)))
        rw [map_add, map_add]) }

  have hθ_zmod : ∀ (z : PadicInt ℓ) (x : ↥sys_M) (r : ℕ),
      (θ_MN (z • x)).1 r = (PadicInt.toZModPow (r + 1) z).val • (θ_MN x).1 r := by
    intro z x r
    change q_IN r (s_MI r ((PadicInt.toZModPow (n₀ + r + 1) z).val • x.1 (n₀ + r))) =
      (PadicInt.toZModPow (r + 1) z).val • (θ_MN x).1 r
    rw [map_nsmul, map_nsmul]
    change (PadicInt.toZModPow (n₀ + r + 1) z).val • (θ_MN x).1 r =
      (PadicInt.toZModPow (r + 1) z).val • (θ_MN x).1 r
    rw [hzmod_mod (r + 1) (n₀ + r + 1) (by omega) z,
      hMod_nsmul ((θ_MN x).1 r) (hTor_N r ((θ_MN x).1 r))]

  have hnsmul_M_coord : ∀ (k : ℕ) (x : ↥sys_M) (r : ℕ), (k • x).1 r = k • x.1 r := by
    intro k x r
    induction k with
    | zero => simp
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change (k • x).1 r + x.1 r = _
      rw [ih]

  have hθ_ker : ∀ x : ↥sys_M, θ_MN x = 0 → (ℓ ^ c) • x = 0 := by
    intro x hx0
    have hx_compat : ∀ r : ℕ, t_M r (x.1 (r + 1)) = x.1 r := (hsys_M x.1).mp x.2
    apply Subtype.ext
    funext r
    rw [hnsmul_M_coord]
    change (ℓ ^ c) • x.1 r = 0
    have hq_r : q_IN r (s_MI r (x.1 (n₀ + r))) = 0 :=
      congrArg (fun w : ↥sys_N => w.1 r) hx0
    have hI_tor : (ℓ ^ c) • s_MI r (x.1 (n₀ + r)) = 0 :=
      hq_ker_tor r (s_MI r (x.1 (n₀ + r))) hq_r
    rw [← hs_sec x.1 hx_compat r, ← map_nsmul (p_IM r), hI_tor, map_zero]

  
  let W_M : Type u := TensorProduct (PadicInt ℓ) (Padic ℓ) ↥sys_M

  have hex_clear : ∀ a : Padic ℓ,
      ∃ (k : ℕ) (z : PadicInt ℓ), (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * a := by
    intro a
    have h_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖a‖ h_gt1
    refine ⟨k, ⟨(ℓ : Padic ℓ) ^ k * a, ?_⟩, rfl⟩
    rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by positivity) k
    rw [inv_mul_le_iff₀ hpos, mul_one]
    exact le_of_lt hk

  have hTensEquiv : ∃ e : TensorProduct ℤ ℚ ↥sys_M ≃+ W_M,
      ∀ (q : ℚ) (x : ↥sys_M),
        e (TensorProduct.tmul ℤ q x) = TensorProduct.tmul (PadicInt ℓ) (q : Padic ℓ) x := by
    let Φ_bilin : ℚ →ₗ[ℤ] ↥sys_M →ₗ[ℤ] W_M :=
      { toFun := fun q =>
          { toFun := fun x => TensorProduct.tmul (PadicInt ℓ) (q : Padic ℓ) x
            map_add' := fun x₁ x₂ => TensorProduct.tmul_add _ _ _
            map_smul' := fun m x => by
              dsimp
              rw [← Int.cast_smul_eq_zsmul (PadicInt ℓ) m x,
                ← TensorProduct.smul_tmul (m : PadicInt ℓ) (q : Padic ℓ) x]
              have hm_smul : (m : PadicInt ℓ) • (q : Padic ℓ) = m • (q : Padic ℓ) := by
                change ((m : PadicInt ℓ) : Padic ℓ) * (q : Padic ℓ) = m • (q : Padic ℓ)
                rw [PadicInt.coe_intCast, zsmul_eq_mul]
              rw [hm_smul, ← TensorProduct.smul_tmul'] }
        map_add' := fun q₁ q₂ => LinearMap.ext fun x => by
          dsimp
          rw [Rat.cast_add, TensorProduct.add_tmul]
        map_smul' := fun m q => LinearMap.ext fun x => by
          dsimp
          simp only [zsmul_eq_mul, Rat.cast_mul, Rat.cast_intCast]
          have hm_eq : (m : Padic ℓ) * (q : Padic ℓ) = m • (q : Padic ℓ) :=
            (zsmul_eq_mul (q : Padic ℓ) m).symm
          rw [hm_eq, TensorProduct.smul_tmul'] }
    let Φ_lin : TensorProduct ℤ ℚ ↥sys_M →ₗ[ℤ] W_M := TensorProduct.lift Φ_bilin
    let z_lin : PadicInt ℓ → (↥sys_M →ₗ[ℤ] ↥sys_M) := fun z =>
      { toFun := fun x => z • x
        map_add' := smul_add z
        map_smul' := fun m x => by
          dsimp
          rw [← Int.cast_smul_eq_zsmul (PadicInt ℓ) m, ← Int.cast_smul_eq_zsmul (PadicInt ℓ) m,
            smul_comm] }
    let z_act_Q : PadicInt ℓ →+* (TensorProduct ℤ ℚ ↥sys_M →ₗ[ℤ] TensorProduct ℤ ℚ ↥sys_M) :=
      { toFun := fun z => LinearMap.lTensor ℚ (z_lin z)
        map_one' := LinearMap.ext fun t =>
          @TensorProduct.inductionOn ℤ _ ℚ ↥sys_M _ _ _ _
            (fun w => (LinearMap.lTensor ℚ (z_lin 1)) w = w) t
            (fun q x => (LinearMap.lTensor_tmul ℚ (z_lin 1) q x).trans
              (congrArg (TensorProduct.tmul ℤ q) (one_smul (PadicInt ℓ) x)))
            (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, ih₁, ih₂])
        map_mul' := fun z₁ z₂ => LinearMap.ext fun t =>
          @TensorProduct.inductionOn ℤ _ ℚ ↥sys_M _ _ _ _
            (fun w => (LinearMap.lTensor ℚ (z_lin (z₁ * z₂))) w =
              (LinearMap.lTensor ℚ (z_lin z₁)) ((LinearMap.lTensor ℚ (z_lin z₂)) w)) t
            (fun q x =>
              (LinearMap.lTensor_tmul ℚ (z_lin (z₁ * z₂)) q x).trans
                ((congrArg (TensorProduct.tmul ℤ q) (mul_smul z₁ z₂ x)).trans
                  ((LinearMap.lTensor_tmul ℚ (z_lin z₁) q (z₂ • x)).symm.trans
                    (congrArg (LinearMap.lTensor ℚ (z_lin z₁))
                      (LinearMap.lTensor_tmul ℚ (z_lin z₂) q x).symm))))
            (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, ih₁, map_add, map_add, ih₂])
        map_zero' := LinearMap.ext fun t =>
          @TensorProduct.inductionOn ℤ _ ℚ ↥sys_M _ _ _ _
            (fun w => (LinearMap.lTensor ℚ (z_lin 0)) w = 0) t
            (fun q x => (LinearMap.lTensor_tmul ℚ (z_lin 0) q x).trans
              ((congrArg (TensorProduct.tmul ℤ q) (zero_smul (PadicInt ℓ) x)).trans
                (TensorProduct.tmul_zero ↥sys_M q)))
            (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, ih₁, ih₂, add_zero])
        map_add' := fun z₁ z₂ => LinearMap.ext fun t =>
          @TensorProduct.inductionOn ℤ _ ℚ ↥sys_M _ _ _ _
            (fun w => (LinearMap.lTensor ℚ (z_lin (z₁ + z₂))) w =
              (LinearMap.lTensor ℚ (z_lin z₁)) w + (LinearMap.lTensor ℚ (z_lin z₂)) w) t
            (fun q x =>
              (LinearMap.lTensor_tmul ℚ (z_lin (z₁ + z₂)) q x).trans
                ((congrArg (TensorProduct.tmul ℤ q) (add_smul z₁ z₂ x)).trans
                  ((TensorProduct.tmul_add q (z₁ • x) (z₂ • x)).trans
                    (congrArg₂ (· + ·)
                      (LinearMap.lTensor_tmul ℚ (z_lin z₁) q x).symm
                      (LinearMap.lTensor_tmul ℚ (z_lin z₂) q x).symm))))
            (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, ih₁, ih₂, map_add, map_add]; abel) }
    let _ : Module (PadicInt ℓ) (TensorProduct ℤ ℚ ↥sys_M) := Module.compHom _ z_act_Q
    have h_tens_zsmul : ∀ (z : PadicInt ℓ) (q : ℚ) (x : ↥sys_M),
        z • (TensorProduct.tmul ℤ q x) = TensorProduct.tmul ℤ q (z • x) :=
      fun z q x => LinearMap.lTensor_tmul ℚ (z_lin z) q x
    have hclear_indep : ∀ (a : Padic ℓ) (x : ↥sys_M) (k₁ k₂ : ℕ) (z₁ z₂ : PadicInt ℓ),
        (z₁ : Padic ℓ) = (ℓ : Padic ℓ) ^ k₁ * a →
        (z₂ : Padic ℓ) = (ℓ : Padic ℓ) ^ k₂ * a →
        TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₁)⁻¹) (z₁ • x) =
          TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₂)⁻¹) (z₂ • x) := by
      intro a x k₁ k₂ z₁ z₂ hz₁ hz₂
      have hz_eq : ((ℓ : PadicInt ℓ) ^ k₂) * z₁ = ((ℓ : PadicInt ℓ) ^ k₁) * z₂ := by
        apply Subtype.ext
        change ((ℓ : Padic ℓ) ^ k₂) * (z₁ : Padic ℓ) = ((ℓ : Padic ℓ) ^ k₁) * (z₂ : Padic ℓ)
        rw [hz₁, hz₂]; ring
      have h_step : ∀ (u v : ℕ) (z : PadicInt ℓ),
          TensorProduct.tmul ℤ (((ℓ : ℚ) ^ u)⁻¹) (z • x) =
            TensorProduct.tmul ℤ (((ℓ : ℚ) ^ (u + v))⁻¹) ((((ℓ : PadicInt ℓ) ^ v) * z) • x) := by
        intro u v z
        have hℓv_ne : ((ℓ : ℚ) ^ v) ≠ 0 := pow_ne_zero v (Nat.cast_ne_zero.mpr hPrime.ne_zero)
        have hq_eq : (((ℓ : ℚ) ^ u)⁻¹) = ((ℓ ^ v : ℕ) : ℤ) • (((ℓ : ℚ) ^ (u + v))⁻¹) := by
          rw [zsmul_eq_mul, Int.cast_natCast, Nat.cast_pow, pow_add, mul_inv_rev, ← mul_assoc,
            mul_inv_cancel₀ hℓv_ne, one_mul]
        rw [hq_eq, TensorProduct.smul_tmul, natCast_zsmul,
          ← Nat.cast_smul_eq_nsmul (PadicInt ℓ), Nat.cast_pow, mul_smul]
      calc TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₁)⁻¹) (z₁ • x)
          = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ (k₁ + k₂))⁻¹) ((((ℓ : PadicInt ℓ) ^ k₂) * z₁) • x) :=
              h_step k₁ k₂ z₁
        _ = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ (k₂ + k₁))⁻¹) ((((ℓ : PadicInt ℓ) ^ k₁) * z₂) • x) := by
              rw [Nat.add_comm k₁ k₂, hz_eq]
        _ = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₂)⁻¹) (z₂ • x) :=
              (h_step k₂ k₁ z₂).symm
    let ψ_fun : Padic ℓ → ↥sys_M → TensorProduct ℤ ℚ ↥sys_M := fun a x =>
      let k := Classical.choose (hex_clear a)
      let z := Classical.choose (Classical.choose_spec (hex_clear a))
      TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k)⁻¹) (z • x)
    have hψ_spec : ∀ (a : Padic ℓ) (x : ↥sys_M) (k : ℕ) (z : PadicInt ℓ),
        (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * a →
        ψ_fun a x = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k)⁻¹) (z • x) :=
      fun a x k z hz => hclear_indep a x _ k _ z
        (Classical.choose_spec (Classical.choose_spec (hex_clear a))) hz
    let Ψ_bilin : Padic ℓ →ₗ[PadicInt ℓ] ↥sys_M →ₗ[PadicInt ℓ] TensorProduct ℤ ℚ ↥sys_M :=
      { toFun := fun a =>
          { toFun := fun x => ψ_fun a x
            map_add' := fun x₁ x₂ => by
              obtain ⟨k, z, hz⟩ := hex_clear a
              rw [hψ_spec a (x₁ + x₂) k z hz, hψ_spec a x₁ k z hz, hψ_spec a x₂ k z hz,
                smul_add, TensorProduct.tmul_add]
            map_smul' := fun w x => by
              dsimp
              obtain ⟨k, z, hz⟩ := hex_clear a
              rw [hψ_spec a (w • x) k z hz, hψ_spec a x k z hz, h_tens_zsmul,
                ← mul_smul, mul_comm z w, mul_smul] }
        map_add' := fun a₁ a₂ => LinearMap.ext fun x => by
          dsimp
          obtain ⟨k₁, z₁, hz₁⟩ := hex_clear a₁
          obtain ⟨k₂, z₂, hz₂⟩ := hex_clear a₂
          let z₁' : PadicInt ℓ := ((ℓ : PadicInt ℓ) ^ k₂) * z₁
          let z₂' : PadicInt ℓ := ((ℓ : PadicInt ℓ) ^ k₁) * z₂
          have hz₁' : (z₁' : Padic ℓ) = (ℓ : Padic ℓ) ^ (k₁ + k₂) * a₁ := by
            change ((ℓ : Padic ℓ) ^ k₂) * (z₁ : Padic ℓ) = _
            rw [hz₁, pow_add]; ring
          have hz₂' : (z₂' : Padic ℓ) = (ℓ : Padic ℓ) ^ (k₁ + k₂) * a₂ := by
            change ((ℓ : Padic ℓ) ^ k₁) * (z₂ : Padic ℓ) = _
            rw [hz₂, pow_add]; ring
          have hz_sum : ((z₁' + z₂' : PadicInt ℓ) : Padic ℓ) =
              (ℓ : Padic ℓ) ^ (k₁ + k₂) * (a₁ + a₂) := by
            rw [PadicInt.coe_add, hz₁', hz₂', mul_add]
          rw [hψ_spec (a₁ + a₂) x (k₁ + k₂) (z₁' + z₂') hz_sum,
            hψ_spec a₁ x (k₁ + k₂) z₁' hz₁', hψ_spec a₂ x (k₁ + k₂) z₂' hz₂',
            add_smul, TensorProduct.tmul_add]
        map_smul' := fun w a => LinearMap.ext fun x => by
          dsimp
          obtain ⟨k, z, hz⟩ := hex_clear a
          have hwa : ((w * z : PadicInt ℓ) : Padic ℓ) = (ℓ : Padic ℓ) ^ k * (w • a) := by
            change (w : Padic ℓ) * (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * ((w : Padic ℓ) * a)
            rw [hz]; ring
          rw [hψ_spec (w • a) x k (w * z) hwa, hψ_spec a x k z hz, h_tens_zsmul, mul_smul] }
    let Ψ_lin : W_M →ₗ[PadicInt ℓ] TensorProduct ℤ ℚ ↥sys_M := TensorProduct.lift Ψ_bilin
    have hΦΨ : ∀ v, Φ_lin (Ψ_lin v) = v := fun v =>
      @TensorProduct.inductionOn (PadicInt ℓ) _ (Padic ℓ) ↥sys_M _ _ _ _
        (fun w => Φ_lin (Ψ_lin w) = w) v
        (fun a x => by
          obtain ⟨k, z, hz⟩ := hex_clear a
          have hℓk_ne : ((ℓ : Padic ℓ) ^ k) ≠ 0 :=
            pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
          change Φ_lin (ψ_fun a x) = TensorProduct.tmul (PadicInt ℓ) a x
          rw [hψ_spec a x k z hz]
          change TensorProduct.tmul (PadicInt ℓ) (((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ)) (z • x) =
            TensorProduct.tmul (PadicInt ℓ) a x
          rw [← TensorProduct.smul_tmul]
          congr 1
          change (z : Padic ℓ) * ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) = a
          push_cast
          rw [hz, mul_comm, ← mul_assoc, inv_mul_cancel₀ hℓk_ne, one_mul])
        (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, map_add, ih₁, ih₂])
    have hΨΦ : ∀ t, Ψ_lin (Φ_lin t) = t := fun t =>
      @TensorProduct.inductionOn ℤ _ ℚ ↥sys_M _ _ _ _
        (fun w => Ψ_lin (Φ_lin w) = w) t
        (fun q x => by
          let m : ℤ := q.num
          let b : ℕ := q.den
          have hb_pos : 0 < b := q.pos
          obtain ⟨k, d, hd_ndvd, hb_eq⟩ :=
            Nat.exists_eq_pow_mul_and_not_dvd hb_pos.ne' ℓ hPrime.ne_one
          have hd_ne : d ≠ 0 := fun hd0 => hb_pos.ne' (by rw [hd0, mul_zero] at hb_eq; exact hb_eq)
          have hd_cop : ℓ.Coprime d := (hPrime.coprime_iff_not_dvd).mpr hd_ndvd
          have hd_unit : IsUnit (d : PadicInt ℓ) :=
            PadicInt.isUnit_iff.mpr (PadicInt.norm_natCast_eq_one_iff.mpr hd_cop)
          obtain ⟨u_d, hu_d⟩ := hd_unit
          let z : PadicInt ℓ := (m : PadicInt ℓ) * ↑(u_d⁻¹)
          have hdz : (d : PadicInt ℓ) * z = (m : PadicInt ℓ) := by
            dsimp [z]
            rw [← hu_d, ← mul_assoc, mul_comm (u_d : PadicInt ℓ) (m : PadicInt ℓ), mul_assoc,
              Units.mul_inv, mul_one]
          have hz_coe : (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * (q : Padic ℓ) := by
            have hd_K_ne : (d : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
            have hbq : (b : ℚ) * q = (m : ℚ) := by
              dsimp [b, m]; rw [mul_comm]; exact Rat.mul_den_eq_num q
            have hbq_K : ((ℓ : Padic ℓ) ^ k * (d : Padic ℓ)) * (q : Padic ℓ) = (m : Padic ℓ) := by
              have h1 := congrArg (Rat.cast : ℚ → Padic ℓ) hbq
              rw [hb_eq] at h1; push_cast at h1; exact h1
            have hdz_K : (d : Padic ℓ) * (z : Padic ℓ) = (m : Padic ℓ) := by
              have h1 := congrArg (Subtype.val : PadicInt ℓ → Padic ℓ) hdz
              simpa only [PadicInt.coe_mul, PadicInt.coe_natCast, PadicInt.coe_intCast] using h1
            apply mul_left_cancel₀ hd_K_ne
            rw [hdz_K, ← hbq_K]; ring
          change ψ_fun (q : Padic ℓ) x = TensorProduct.tmul ℤ q x
          rw [hψ_spec (q : Padic ℓ) x k z hz_coe]
          have hd_Q_ne : (d : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
          have hℓ_inv_eq : (((ℓ : ℚ) ^ k)⁻¹) = (d : ℤ) • ((b : ℚ)⁻¹) := by
            rw [zsmul_eq_mul, Int.cast_natCast, hb_eq, Nat.cast_mul, Nat.cast_pow, mul_inv_rev,
              ← mul_assoc, mul_inv_cancel₀ hd_Q_ne, one_mul]
          have hqb : ((b : ℚ)⁻¹) * (m : ℚ) = q := by
            have hb_Q_ne : (b : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hb_pos.ne'
            have hbq : q * (b : ℚ) = (m : ℚ) := Rat.mul_den_eq_num q
            rw [← hbq, mul_comm q (b : ℚ), ← mul_assoc, inv_mul_cancel₀ hb_Q_ne, one_mul]
          rw [hℓ_inv_eq, TensorProduct.smul_tmul, natCast_zsmul,
            ← Nat.cast_smul_eq_nsmul (PadicInt ℓ) d, ← mul_smul, hdz,
            Int.cast_smul_eq_zsmul (PadicInt ℓ) m x, ← TensorProduct.smul_tmul, zsmul_eq_mul,
            mul_comm (m : ℚ), hqb])
        (fun w₁ w₂ ih₁ ih₂ => by rw [map_add, map_add, ih₁, ih₂])
    exact ⟨{ toFun := Φ_lin
             invFun := Ψ_lin
             left_inv := hΨΦ
             right_inv := hΦΨ
             map_add' := Φ_lin.map_add }, fun _ _ => rfl⟩

  obtain ⟨e_M, he_M⟩ := hTensEquiv

  
  have hFin_WM : Module.Finite (Padic ℓ) W_M := by
    let _ : Module (PadicInt ℓ) V_N := Module.compHom V_N (algebraMap (PadicInt ℓ) (Padic ℓ))
    have : IsScalarTower (PadicInt ℓ) (Padic ℓ) V_N :=
      IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
    let lam0 : ↥sys_M →ₗ[PadicInt ℓ] V_N :=
      { toFun := fun x => equiv_N (TensorProduct.tmul ℤ (1 : ℚ) (θ_MN x))
        map_add' := fun x₁ x₂ => by rw [map_add, TensorProduct.tmul_add, map_add]
        map_smul' := fun z x => hsmul_N z (θ_MN x) (θ_MN (z • x)) (hθ_zmod z x) }
    let Λ : W_M →ₗ[Padic ℓ] V_N := LinearMap.liftBaseChange (Padic ℓ) lam0
    have hΛ_inj : Function.Injective Λ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro v hv
      rw [LinearMap.mem_ker] at hv
      obtain ⟨⟨u₀, z₀⟩, hz₀⟩ :=
        IsLocalizedModule.surj (nonZeroDivisors (PadicInt ℓ))
          (TensorProduct.mk (PadicInt ℓ) (Padic ℓ) ↥sys_M (1 : Padic ℓ)) v
      set c₀ : Padic ℓ := algebraMap (PadicInt ℓ) (Padic ℓ) z₀.1
      have hz₀_ne : z₀.1 ≠ 0 := nonZeroDivisors.ne_zero z₀.2
      have hc₀_ne : c₀ ≠ 0 := fun hc0 =>
        hz₀_ne (IsFractionRing.injective (PadicInt ℓ) (Padic ℓ)
          (hc0.trans (map_zero (algebraMap (PadicInt ℓ) (Padic ℓ))).symm))
      have hc₀_v : c₀ • v = TensorProduct.tmul (PadicInt ℓ) (1 : Padic ℓ) u₀ := by
        rw [← algebra_compatible_smul (Padic ℓ) z₀.1 v, ← Submonoid.smul_def]
        exact hz₀
      have h1_N : TensorProduct.tmul ℤ (1 : ℚ) (θ_MN u₀) = TensorProduct.tmul ℤ (1 : ℚ) 0 := by
        apply equiv_N.injective
        have hΛ_u₀ : Λ (TensorProduct.tmul (PadicInt ℓ) (1 : Padic ℓ) u₀) =
            equiv_N (TensorProduct.tmul ℤ (1 : ℚ) (θ_MN u₀)) := by
          change LinearMap.liftBaseChange (Padic ℓ) lam0
              (TensorProduct.tmul (PadicInt ℓ) (1 : Padic ℓ) u₀) = _
          rw [LinearMap.liftBaseChange_tmul, one_smul]
          rfl
        rw [← hΛ_u₀, ← hc₀_v, map_smul, hv, smul_zero, TensorProduct.tmul_zero, map_zero]
      obtain ⟨⟨k_int, hk_mem⟩, hk_eq⟩ :=
        (IsLocalizedModule.eq_iff_exists (nonZeroDivisors ℤ)
          (TensorProduct.mk ℤ ℚ ↥sys_N (1 : ℚ))).mp h1_N
      have hk_eq' : k_int • θ_MN u₀ = 0 := by
        simpa only [Submonoid.mk_smul, smul_zero] using hk_eq
      have hk_ne : k_int ≠ 0 := nonZeroDivisors.ne_zero hk_mem
      let N_pos : ℕ := k_int.natAbs
      have hN_pos : 1 ≤ N_pos := Int.natAbs_pos.mpr hk_ne
      have hN_ann : N_pos • θ_MN u₀ = 0 := by
        rcases Int.natAbs_eq k_int with h_pos | h_neg
        · have h1 : (N_pos : ℤ) • θ_MN u₀ = 0 := by
            dsimp [N_pos]; rw [← h_pos]; exact hk_eq'
          rwa [natCast_zsmul] at h1
        · have h1 : (-(N_pos : ℤ)) • θ_MN u₀ = 0 := by
            dsimp [N_pos]; rw [← h_neg]; exact hk_eq'
          rw [neg_zsmul, neg_eq_zero, natCast_zsmul] at h1
          exact h1
      have hK_ann : ((ℓ ^ c) * N_pos) • u₀ = 0 := by
        rw [mul_nsmul']
        apply hθ_ker (N_pos • u₀)
        rw [map_nsmul, hN_ann]
      set K_pos : ℕ := (ℓ ^ c) * N_pos
      have hK_pos : 1 ≤ K_pos := Nat.mul_pos (pow_pos hPrime.pos c) hN_pos
      have hK_ne : (K_pos : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hu₀_tmul : TensorProduct.tmul (PadicInt ℓ) (1 : Padic ℓ) u₀ = 0 := by
        have hK_smul : (K_pos : Padic ℓ) • TensorProduct.tmul (PadicInt ℓ) (1 : Padic ℓ) u₀ = 0 := by
          have hcoe : (K_pos : Padic ℓ) • (1 : Padic ℓ) = (K_pos : PadicInt ℓ) • (1 : Padic ℓ) := by
            change (K_pos : Padic ℓ) * 1 = ((K_pos : PadicInt ℓ) : Padic ℓ) * 1
            rw [PadicInt.coe_natCast]
          rw [TensorProduct.smul_tmul', hcoe, TensorProduct.smul_tmul,
            Nat.cast_smul_eq_nsmul, hK_ann, TensorProduct.tmul_zero]
        exact (smul_eq_zero.mp hK_smul).resolve_left hK_ne
      rw [hu₀_tmul] at hc₀_v
      exact (smul_eq_zero.mp hc₀_v).resolve_left hc₀_ne
    exact Module.Finite.of_injective Λ hΛ_inj

  
  let frob_M : W_M →ₗ[Padic ℓ] W_M := LinearMap.baseChange (Padic ℓ) frob_sys_M

  refine ⟨W_M, inferInstance, inferInstance, hFin_WM, frob_M, e_M, ?_, ?_⟩
  · intro z x y hxy
    have hy_eq : y = z • x := Subtype.ext (funext hxy)
    rw [hy_eq, he_M, he_M, Rat.cast_one, ← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
    rfl
  · intro x y hxy
    have hy_eq : y = frob_sys_M x := Subtype.ext (funext hxy)
    rw [hy_eq, he_M, he_M]
    exact LinearMap.baseChange_tmul frob_sys_M _ x

theorem weil_sing_dev_leray_artin_rees_sheaf_model (F : Type u) [Finite F] [Field F]
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (f_bar : weilGeomScheme F Z_tilde ⟶ weilGeomScheme F (weilProjectiveSpaceOver F 1))
    (hf_bar_prop : AlgebraicGeometry.IsProper f_bar)
    (hCont_D :
      (weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).IsContinuous
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology)
    (hAdj_D :
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology hCont_D).IsRightAdjoint)
    (iso_bc : ∀ (q r : ℕ),
      CategoryTheory.Iso
        ((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          AddCommGrpCat.{u} _
          (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          hCont_D hAdj_D).obj (weilSingDevPencilHigherDirectImage F f₀ ℓ q r))
        (weilEtaleHigherDirectImage f_bar q
          (weilEtaleTorsionSheaf (weilGeomScheme F Z_tilde) (ℓ ^ (r + 1)))))
    (h_iso_bc_trans : ∀ (q r : ℕ),
      CategoryTheory.CategoryStruct.comp
        ((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          AddCommGrpCat.{u} _
          (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          hCont_D hAdj_D).map (weilSingDevPencilHigherDirectImageMap F f₀ ℓ q r))
        (iso_bc q r).hom =
      CategoryTheory.CategoryStruct.comp
        (iso_bc q (r + 1)).hom
        (weilEtaleHigherDirectImageMap f_bar q
          ((CategoryTheory.constantSheaf
              (weilGeomScheme F Z_tilde).smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map
              (AddCommGrpCat.ofHom
                (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1)))
                  (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom)))))
    (hConst_R0 : ∀ q : ℕ,
      WeilIsConstructibleModPrimeSheaf ℓ
        (weilGeomScheme F (weilProjectiveSpaceOver F 1))
        (weilEtaleHigherDirectImage f_bar q
          (weilEtaleTorsionSheaf (weilGeomScheme F Z_tilde) ℓ)))
    (hFin_C : ∀ (𝒢 : CategoryTheory.Sheaf
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)) 𝒢 →
      ∀ i : ℕ, Finite (𝒢.H i))
    (p q : ℕ) :
    ∃ (M : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ p
        (weilSingDevPencilHigherDirectImage F f₀ ℓ q)
        (weilSingDevPencilHigherDirectImageMap F f₀ ℓ q)),
      (∀ r : ℕ, Finite ((M.ℳ_bar r).H p)) ∧
      (∀ (r : ℕ) (u : (M.ℳ_bar (r + 1)).H p),
        (CategoryTheory.Abelian.Ext.mk₀ (M.τ_bar r)).postcomp
          ((CategoryTheory.constantSheaf
              (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
              AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Nat.add_zero p) (M.frobTorsion (r + 1) u) =
        M.frobTorsion r
          ((CategoryTheory.Abelian.Ext.mk₀ (M.τ_bar r)).postcomp
            ((CategoryTheory.constantSheaf
                (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
                AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
            (Nat.add_zero p) u)) :=
by
  classical
  let D₀ := weilProjectiveSpaceOver F 1
  let k := AlgebraicClosure F
  let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let D_bar_ov := weilBaseChangeOver F k D₀
  let D_bar : AlgebraicGeometry.Scheme.{u} := weilGeomScheme F D₀
  let Z_bar : AlgebraicGeometry.Scheme.{u} := weilGeomScheme F Z_tilde
  let Fℤ_D := (CategoryTheory.constantSheaf D_bar.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))

  have hpb_D : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst D₀.hom f_ext) D_bar_ov.hom D₀.hom f_ext :=
    CategoryTheory.IsPullback.of_hasPullback D₀.hom f_ext
  have hProp_Dbar : AlgebraicGeometry.IsProper D_bar_ov.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_D inferInstance
  let _ : AlgebraicGeometry.IsProper D_bar_ov.hom := hProp_Dbar

  
  have hSerre : WeilConstructibleModPrimeSerreHolds k ℓ :=
    weil_etale_constructible_mod_prime_serre_and_local k ℓ
  obtain ⟨hP_zero, hP_mod, hP_iso, _, hP_five⟩ :=
    weil_ellPrimary_serre_closure_and_mod_prime_extraction k ℓ hSerre D_bar_ov

  
  let ℳ : ℕ → ℕ → CategoryTheory.Sheaf D_bar.smallEtaleTopology AddCommGrpCat.{u} :=
    fun q' n => weilEtaleHigherDirectImage f_bar q' (weilEtaleTorsionSheaf Z_bar (ℓ ^ n))
  let τ_map : ∀ (q' m n : ℕ), m ≤ n → Quiver.Hom (ℳ q' n) (ℳ q' m) :=
    fun q' m _n h => weilEtaleHigherDirectImageMap f_bar q'
      ((CategoryTheory.constantSheaf Z_bar.smallEtaleTopology AddCommGrpCat.{u}).map
        (AddCommGrpCat.uliftFunctor.{u, 0}.map
          (AddCommGrpCat.ofHom
            (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom)))
  obtain ⟨j_map, δ_map, ⟨hZero_M0, hTor_Mn⟩, ⟨hId_M, hComp_M, hMixed_M, hMul_M⟩, hLES, hNat_δ⟩ :=
    weil_sing_dev_ar_torsion_pushforward_system f_bar ℓ

  
  have hConst_M1 : ∀ q' : ℕ, WeilIsConstructibleModPrimeSheaf ℓ D_bar (ℳ q' 1) := by
    intro q'
    dsimp [ℳ]
    rw [pow_one]
    exact hConst_R0 q'

  have hP_all : ∀ (n q' : ℕ), WeilEllPrimaryConstructible ℓ D_bar (ℳ q' n) := by
    intro n
    induction n with
    | zero =>
      intro q'
      exact hP_zero (ℳ q' 0) (hZero_M0 q')
    | succ k_idx ih =>
      cases k_idx with
      | zero =>
        intro q'
        exact hP_mod (ℳ q' 1) (hConst_M1 q')
      | succ m =>
        intro q'
        have habc : 1 + (m + 1) = m + 2 := Nat.add_comm 1 (m + 1)
        cases q' with
        | zero =>
          have hMono0 : CategoryTheory.Mono (j_map 0 1 (m + 2) (Nat.le.intro habc)) :=
            (hLES 1 (m + 2) (m + 1) habc).1
          obtain ⟨⟨h₁, hEx₁⟩, ⟨h₂, hEx₂⟩, _⟩ := (hLES 1 (m + 2) (m + 1) habc).2 0
          let f₀_z : ℳ 0 0 ⟶ ℳ 0 1 := 0
          have hz_j : CategoryTheory.CategoryStruct.comp f₀_z
              (j_map 0 1 (m + 2) (Nat.le.intro habc)) = 0 :=
            CategoryTheory.Limits.zero_comp
          have hEx₀ : (CategoryTheory.ShortComplex.mk f₀_z
              (j_map 0 1 (m + 2) (Nat.le.intro habc)) hz_j).Exact :=
            ((CategoryTheory.ShortComplex.mk f₀_z
              (j_map 0 1 (m + 2) (Nat.le.intro habc)) hz_j).exact_iff_mono rfl).mpr hMono0
          exact hP_five f₀_z
            (j_map 0 1 (m + 2) (Nat.le.intro habc))
            (τ_map 0 (m + 1) (m + 2) (Nat.le.intro ((Nat.add_comm (m + 1) 1).trans habc)))
            (δ_map 0 1 (m + 2) (m + 1) habc)
            hz_j h₁ h₂ hEx₀ hEx₁ hEx₂
            (hP_zero (ℳ 0 0) (hZero_M0 0))
            (hP_mod (ℳ 0 1) (hConst_M1 0))
            (ih 0)
            (hP_mod (ℳ 1 1) (hConst_M1 1))
        | succ q₀ =>
          obtain ⟨_, _, ⟨h₀, hEx₀⟩⟩ := (hLES 1 (m + 2) (m + 1) habc).2 q₀
          obtain ⟨⟨h₁, hEx₁⟩, ⟨h₂, hEx₂⟩, _⟩ := (hLES 1 (m + 2) (m + 1) habc).2 (q₀ + 1)
          exact hP_five
            (δ_map q₀ 1 (m + 2) (m + 1) habc)
            (j_map (q₀ + 1) 1 (m + 2) (Nat.le.intro habc))
            (τ_map (q₀ + 1) (m + 1) (m + 2) (Nat.le.intro ((Nat.add_comm (m + 1) 1).trans habc)))
            (δ_map (q₀ + 1) 1 (m + 2) (m + 1) habc)
            h₀ h₁ h₂ hEx₀ hEx₁ hEx₂
            (ih q₀)
            (hP_mod (ℳ (q₀ + 1) 1) (hConst_M1 (q₀ + 1)))
            (ih (q₀ + 1))
            (hP_mod (ℳ (q₀ + 2) 1) (hConst_M1 (q₀ + 2)))

  
  have h_post_comp : ∀ {A B C : CategoryTheory.Sheaf D_bar.smallEtaleTopology AddCommGrpCat.{u}}
      (u : A ⟶ B) (v : B ⟶ C) (d : ℕ) (x : A.H d),
      ((CategoryTheory.Abelian.Ext.mk₀ v).postcomp Fℤ_D (Nat.add_zero d))
        (((CategoryTheory.Abelian.Ext.mk₀ u).postcomp Fℤ_D (Nat.add_zero d)) x) =
      ((CategoryTheory.Abelian.Ext.mk₀ (u ≫ v)).postcomp Fℤ_D (Nat.add_zero d)) x := by
    intro A B C u v d x
    change ((x : CategoryTheory.Abelian.Ext Fℤ_D A d).comp (CategoryTheory.Abelian.Ext.mk₀ u)
        (Nat.add_zero d)).comp (CategoryTheory.Abelian.Ext.mk₀ v) (Nat.add_zero d) =
      (x : CategoryTheory.Abelian.Ext Fℤ_D A d).comp (CategoryTheory.Abelian.Ext.mk₀ (u ≫ v))
        (Nat.add_zero d)
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero d) (Nat.add_zero 0)
        (Nat.add_zero d),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

