        CommRingCat.hom_ext (RingHom.ext fun d => by
          change (Algebra.TensorProduct.map (IsScalarTower.toAlgHom F E₀ k)
            (AlgHom.id F D₀)) ((1 : E₀) ⊗ₜ[F] d) = (1 : k) ⊗ₜ[F] d
