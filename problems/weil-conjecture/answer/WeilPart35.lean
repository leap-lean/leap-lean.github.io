    refine ⟨fun u₁ u₂ => ?_⟩
    have hv_eq : v u₁ = v u₂ := hSub.elim (v u₁) (v u₂)
    have hrec : ∀ u : (pb₁.obj 𝒢).H p,
        ((CategoryTheory.Abelian.Ext.mk₀ πℤ₂).comp (v u) (Nat.zero_add p)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (eL_inv 𝒢)) (Nat.add_zero p) =
        CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ u := by
      intro u
      dsimp only [v]
      rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
            (CategoryTheory.Abelian.Ext.mk₀ πℤ₂) _
            (CategoryTheory.Abelian.Ext.mk₀ (eL_hom 𝒢)) (Nat.zero_add p),
          ← CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ πℤ₂)
            (CategoryTheory.Abelian.Ext.mk₀ σ)
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ u)
            (Nat.zero_add 0) (Nat.zero_add p) (Nat.zero_add p),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          hπσ,
          CategoryTheory.Abelian.Ext.mk₀_id_comp,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ u)
            (CategoryTheory.Abelian.Ext.mk₀ (eL_hom 𝒢))
            (CategoryTheory.Abelian.Ext.mk₀ (eL_inv 𝒢)) (Nat.add_zero p),
