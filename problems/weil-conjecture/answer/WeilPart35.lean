        apply (α E₂).symm.injective
        rw [← hα_symm u (α E₁ t), (α E₁).symm_apply_apply, (α E₂).symm_apply_apply]
      let sky₁ := Φ₁.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let sky₂ := Φ₂.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let comp_sky : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u} :=
        sky₁ ⋙ pf
      let e_sky : comp_sky ≅ sky₂ :=
        CategoryTheory.NatIso.ofComponents
          (fun M =>
            { hom :=
                { hom :=
                    { app := fun j =>
                        CategoryTheory.Limits.Pi.lift fun (s : Φ₂.fiber.obj j.unop) =>
                          CategoryTheory.Limits.Pi.π (fun (_ : Φ₁.fiber.obj (B.obj j.unop)) => M)
                            ((α j.unop).symm s)
                      naturality := fun {j₁ j₂} f => by
                        change ((Φ₁.skyscraperPresheafFunctor.obj M).map (B.map f.unop).op) ≫ _ =
                          _ ≫ ((Φ₂.skyscraperPresheafFunctor.obj M).map f)
                        rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                          CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                        exact hPi_map'
                          (Φ₁.fiber.map (B.map f.unop))
                          (Φ₂.fiber.map f.unop)
