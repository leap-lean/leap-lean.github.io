    clear * - hMvPolyQuotEquiv
    intro A _ c τ q_A g_quad g_Pi
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro j
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨μ, rfl⟩
        refine Fin.lastCases ?_ (fun ν => ?_) μ
        · dsimp [g_quad]
