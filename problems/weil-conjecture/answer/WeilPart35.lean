        obtain ⟨z, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS_Y x hx0 rfl
        let hS2 : (S_Y.map pb₂).ShortExact := hS_Y.map_of_exact pb₂
        let hS12 : ((S_Y.map pb₂).map pb₁).ShortExact := hS2.map_of_exact pb₁
        let φ_S : (S_Y.map pb₂).map pb₁ ⟶ S_Y :=
          { τ₁ := eR_hom Y₀
            τ₂ := eR_hom S_Y.X₂
            τ₃ := eR_hom S_Y.X₃
            comm₁₂ := (heR_hom_nat S_Y.f).symm
            comm₂₃ := (heR_hom_nat S_Y.g).symm }
        have h_nat : hS12.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (eR_hom Y₀)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (eR_hom S_Y.X₃)).comp hS_Y.extClass (Nat.zero_add 1) :=
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS12 hS_Y φ_S
        conv_lhs => rw [ih z]
        rw [CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (eR_inv X₀)) _ hS_Y.extClass
              (Nat.zero_add n) rfl (Nat.zero_add (n + 1)),
            CategoryTheory.Abelian.Ext.comp_assoc
              _ (CategoryTheory.Abelian.Ext.mk₀ (eR_hom S_Y.X₃)) hS_Y.extClass
              (Nat.add_zero n) (Nat.zero_add 1) rfl,
            ← h_nat,
            ← CategoryTheory.Abelian.Ext.comp_assoc
              _ hS12.extClass (CategoryTheory.Abelian.Ext.mk₀ (eR_hom Y₀))
              rfl (Nat.add_zero 1) (Nat.add_zero (n + 1)),
            ← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb₁ hS2,
            ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            ← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb₂ hS_Y,
            ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]
    intro 𝒢 p hSub
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_Y : 𝒜_Y := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let πℤ₂ : pb₂.obj Fℤ_Y ⟶ Fℤ_Y := weilEtaleConstPullbackHom e_Y.inv hT_Y hT_Y Aℤ
    have : CategoryTheory.IsIso πℤ₂ := (sys e_Y.inv).hConstIso hT_Y hT_Y Aℤ
    let σ : Fℤ_Y ⟶ pb₂.obj Fℤ_Y := CategoryTheory.inv πℤ₂
    have hπσ : πℤ₂ ≫ σ = 𝟙 (pb₂.obj Fℤ_Y) := CategoryTheory.IsIso.hom_inv_id πℤ₂
    let v : (pb₁.obj 𝒢).H p → 𝒢.H p := fun u =>
      ((CategoryTheory.Abelian.Ext.mk₀ σ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ u) (Nat.zero_add p)).comp
