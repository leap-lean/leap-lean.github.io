      rw [one_zsmul, hsec_m₁ m₁ (𝟙 E_U') (Category.id_comp m₁), op_id, S.obj.map_id] at hy_m₁
      have hy0 : y_hom.hom (ULift.up (1 : ℤ)) = 0 := hSub_TX.elim _ _
      rw [hy0, map_zero] at hy_m₁
      exact ⟨E_U', v_E, (inferInstance : AlgebraicGeometry.Etale u_tilde),
