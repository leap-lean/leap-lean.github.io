      (∀ (𝒥 : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u})
          (f_Y : (L_prY.obj (P_f₀.obj 𝒥)).H 0 →+ (L_prY.obj (P_f₀.obj 𝒥)).H 0)
          (f_X : (L_prX.obj 𝒥).H 0 →+ (L_prX.obj 𝒥).H 0),
        WeilTransvTriIsGeomBaseSheafAction F Y₀ (P_f₀.obj 𝒥) (L_prY.obj (P_f₀.obj 𝒥))
          hCont_Y hAdj_Y (CategoryTheory.Iso.refl _) 0 f_Y →
        WeilTransvTriIsGeomBaseSheafAction F X₀ 𝒥 (L_prX.obj 𝒥)
          hCont_X hAdj_X (CategoryTheory.Iso.refl _) 0 f_X →
        ∀ x, e_H0 𝒥 (f_Y x) = f_X (e_H0 𝒥 x)) :=
by
  
  have hExt_postcomp₀ :
      ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒜]
        [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
        {U M₁ M₂ : 𝒜} (ψ : M₁ ⟶ M₂) (x : CategoryTheory.Abelian.Ext.{u} U M₁ 0),
        CategoryTheory.Abelian.Ext.addEquiv₀
          ((CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp U (Nat.add_zero 0) x) =
        CategoryTheory.Abelian.Ext.addEquiv₀ x ≫ ψ := by
    intro 𝒜 _ _ _ U M₁ M₂ ψ x
    apply (CategoryTheory.Abelian.Ext.mk₀_bijective U M₂).1
    rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero 0) =
      CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ x ≫ ψ)
    conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x]
    exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀
      (CategoryTheory.Abelian.Ext.addEquiv₀ x) ψ

  have hExt_frob₀ :
      ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒜]
        [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
        (P : 𝒜 ⥤ 𝒜) (hAdd : P.Additive)
        (hLim : CategoryTheory.Limits.PreservesFiniteLimits P)
        (hColim : CategoryTheory.Limits.PreservesFiniteColimits P)
        {U M : 𝒜} (α_U : U ⟶ P.obj U) (β_M : P.obj M ⟶ M)
        (x : CategoryTheory.Abelian.Ext.{u} U M 0),
        CategoryTheory.Abelian.Ext.addEquiv₀
          ((CategoryTheory.Abelian.Ext.mk₀ β_M).postcomp U (Nat.add_zero 0)
            ((CategoryTheory.Abelian.Ext.mk₀ α_U).comp
              ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ P
                hAdd hLim hColim _ _ U M 0) x)
              (Nat.zero_add 0))) =
        α_U ≫ P.map (CategoryTheory.Abelian.Ext.addEquiv₀ x) ≫ β_M := by
    intro 𝒜 _ _ _ P hAdd hLim hColim U M α_U β_M x
    let _ := hAdd; let _ := hLim; let _ := hColim
    apply (CategoryTheory.Abelian.Ext.mk₀_bijective U M).1
    rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
    change ((CategoryTheory.Abelian.Ext.mk₀ α_U).comp
        ((P.mapExtAddHom U M 0) x) (Nat.zero_add 0)).comp
      (CategoryTheory.Abelian.Ext.mk₀ β_M) (Nat.add_zero 0) =
      CategoryTheory.Abelian.Ext.mk₀
        (α_U ≫ P.map (CategoryTheory.Abelian.Ext.addEquiv₀ x) ≫ β_M)
    rw [CategoryTheory.Functor.mapExtAddHom_apply]
    conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x]
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ P
        (CategoryTheory.Abelian.Ext.addEquiv₀ x),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Category.assoc]

  have hMate_bc_nat :
      ∀ {𝒳₀ 𝒴₀ 𝒳_bar 𝒴_bar : Type (u + 1)}
        [CategoryTheory.Category.{u + 1} 𝒳₀] [CategoryTheory.Category.{u + 1} 𝒴₀]
        [CategoryTheory.Category.{u + 1} 𝒳_bar] [CategoryTheory.Category.{u + 1} 𝒴_bar]
        {L_X : 𝒳₀ ⥤ 𝒳_bar} {R_X : 𝒳_bar ⥤ 𝒳₀} (adj_X : L_X ⊣ R_X)
        {L_Y : 𝒴₀ ⥤ 𝒴_bar} {R_Y : 𝒴_bar ⥤ 𝒴₀} (adj_Y : L_Y ⊣ R_Y)
        (P_f₀ : 𝒳₀ ⥤ 𝒴₀) (P_fbar : 𝒳_bar ⥤ 𝒴_bar)
        (e_pf : R_X ⋙ P_f₀ ⟶ P_fbar ⋙ R_Y)
        {𝒥₁ 𝒥₂ : 𝒳₀} (φ : 𝒥₁ ⟶ 𝒥₂),
        let bc := fun ℱ : 𝒳₀ =>
          (adj_Y.homEquiv (P_f₀.obj ℱ) (P_fbar.obj (L_X.obj ℱ))).symm
            (P_f₀.map (adj_X.unit.app ℱ) ≫ e_pf.app (L_X.obj ℱ))
        L_Y.map (P_f₀.map φ) ≫ bc 𝒥₂ = bc 𝒥₁ ≫ P_fbar.map (L_X.map φ) := by
    intro 𝒳₀ 𝒴₀ 𝒳_bar 𝒴_bar _ _ _ _ L_X R_X adj_X L_Y R_Y adj_Y P_f₀ P_fbar e_pf 𝒥₁ 𝒥₂ φ bc
    apply (adj_Y.homEquiv (P_f₀.obj 𝒥₁) (P_fbar.obj (L_X.obj 𝒥₂))).injective
    rw [adj_Y.homEquiv_naturality_left, adj_Y.homEquiv_naturality_right]
    dsimp only [bc]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, CategoryTheory.Category.assoc]
    have hnat := e_pf.naturality (L_X.map φ)
    dsimp only [CategoryTheory.Functor.comp_map] at hnat
    have hunit := adj_X.unit.naturality φ
    dsimp only [CategoryTheory.Functor.id_map, CategoryTheory.Functor.comp_map] at hunit
    rw [← hnat, ← CategoryTheory.Category.assoc (P_f₀.map (adj_X.unit.app 𝒥₁)),
      ← P_f₀.map_comp (adj_X.unit.app 𝒥₁), ← hunit, P_f₀.map_comp,
      CategoryTheory.Category.assoc]

  have hMate_bc_frob :
      ∀ {𝒳₀ 𝒴₀ 𝒳_bar 𝒴_bar : Type (u + 1)}
        [CategoryTheory.Category.{u + 1} 𝒳₀] [CategoryTheory.Category.{u + 1} 𝒴₀]
        [CategoryTheory.Category.{u + 1} 𝒳_bar] [CategoryTheory.Category.{u + 1} 𝒴_bar]
        {L_X : 𝒳₀ ⥤ 𝒳_bar} {R_X : 𝒳_bar ⥤ 𝒳₀} (adj_X : L_X ⊣ R_X)
        {L_Y : 𝒴₀ ⥤ 𝒴_bar} {R_Y : 𝒴_bar ⥤ 𝒴₀} (adj_Y : L_Y ⊣ R_Y)
        (P_f₀ : 𝒳₀ ⥤ 𝒴₀) (P_fbar : 𝒳_bar ⥤ 𝒴_bar)
        (e_pf : R_X ⋙ P_f₀ ⟶ P_fbar ⋙ R_Y)
        (P_X : 𝒳_bar ⥤ 𝒳_bar) (P_Y : 𝒴_bar ⥤ 𝒴_bar)
        (e_PG : P_X ⋙ P_fbar ≅ P_fbar ⋙ P_Y)
        (𝒥 : 𝒳₀)
        (α_Y : L_Y.obj (P_f₀.obj 𝒥) ⟶ P_Y.obj (L_Y.obj (P_f₀.obj 𝒥)))
        (β_Y : P_Y.obj (L_Y.obj (P_f₀.obj 𝒥)) ⟶ L_Y.obj (P_f₀.obj 𝒥))
        (_hβα_Y : β_Y ≫ α_Y = CategoryTheory.CategoryStruct.id _)
        (α_X : L_X.obj 𝒥 ⟶ P_X.obj (L_X.obj 𝒥))
        (β_X : P_X.obj (L_X.obj 𝒥) ⟶ L_X.obj 𝒥)
        (_hαβ_X : α_X ≫ β_X = CategoryTheory.CategoryStruct.id _),
        let bc := (adj_Y.homEquiv (P_f₀.obj 𝒥) (P_fbar.obj (L_X.obj 𝒥))).symm
          (P_f₀.map (adj_X.unit.app 𝒥) ≫ e_pf.app (L_X.obj 𝒥))
        P_f₀.map (adj_X.homEquiv 𝒥 (P_X.obj (L_X.obj 𝒥)) α_X) ≫
            e_pf.app (P_X.obj (L_X.obj 𝒥)) ≫
            R_Y.map (e_PG.hom.app (L_X.obj 𝒥)) =
          adj_Y.homEquiv (P_f₀.obj 𝒥) (P_Y.obj (L_Y.obj (P_f₀.obj 𝒥))) α_Y ≫
            R_Y.map (P_Y.map bc) →
        β_Y ≫ bc =
          P_Y.map bc ≫ e_PG.inv.app (L_X.obj 𝒥) ≫ P_fbar.map β_X := by
    intro 𝒳₀ 𝒴₀ 𝒳_bar 𝒴_bar _ _ _ _ L_X R_X adj_X L_Y R_Y adj_Y
      P_f₀ P_fbar e_pf P_X P_Y e_PG 𝒥 α_Y β_Y hβα_Y α_X β_X hαβ_X bc h_eq
    have h_α : bc ≫ P_fbar.map α_X ≫ e_PG.hom.app (L_X.obj 𝒥) = α_Y ≫ P_Y.map bc := by
      apply (adj_Y.homEquiv (P_f₀.obj 𝒥) (P_Y.obj (P_fbar.obj (L_X.obj 𝒥)))).injective
      rw [adj_Y.homEquiv_naturality_right, adj_Y.homEquiv_naturality_right]
      dsimp only [bc]
      rw [Equiv.apply_symm_apply, R_Y.map_comp]
      have hnat := e_pf.naturality α_X
      dsimp only [CategoryTheory.Functor.comp_map] at hnat
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (e_pf.app _),
        ← hnat]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (P_f₀.map (adj_X.unit.app 𝒥)),
        ← P_f₀.map_comp, ← adj_X.homEquiv_unit 𝒥 (P_X.obj (L_X.obj 𝒥)) α_X]
      simpa only [CategoryTheory.Category.assoc] using h_eq
    have he_cancel : e_PG.hom.app (L_X.obj 𝒥) ≫
        (e_PG.inv.app (L_X.obj 𝒥) ≫ P_fbar.map β_X) = P_fbar.map β_X :=
      (CategoryTheory.Category.assoc (e_PG.hom.app (L_X.obj 𝒥))
        (e_PG.inv.app (L_X.obj 𝒥)) (P_fbar.map β_X)).symm.trans
        ((congrArg (· ≫ P_fbar.map β_X) (e_PG.hom_inv_id_app (L_X.obj 𝒥))).trans
          (CategoryTheory.Category.id_comp _))
    have h1 := congrArg
      (fun m => β_Y ≫ m ≫ e_PG.inv.app (L_X.obj 𝒥) ≫ P_fbar.map β_X) h_α
    have hL : β_Y ≫ (bc ≫ P_fbar.map α_X ≫ e_PG.hom.app (L_X.obj 𝒥)) ≫
        e_PG.inv.app (L_X.obj 𝒥) ≫ P_fbar.map β_X = β_Y ≫ bc := by
      simp only [CategoryTheory.Category.assoc]
      rw [he_cancel, ← P_fbar.map_comp, hαβ_X, P_fbar.map_id,
        CategoryTheory.Category.comp_id]
    have hR : β_Y ≫ (α_Y ≫ P_Y.map bc) ≫ e_PG.inv.app (L_X.obj 𝒥) ≫ P_fbar.map β_X =
        P_Y.map bc ≫ e_PG.inv.app (L_X.obj 𝒥) ≫ P_fbar.map β_X := by
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc β_Y α_Y, hβα_Y, CategoryTheory.Category.id_comp]
    exact hL.symm.trans (h1.trans hR)

  
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
