    let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    let pb_f := (weilEtaleSitePullback f).sheafPullback
      AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    let adj_f := (weilEtaleSitePullback f).sheafAdjunctionContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    ∀ (ιℤ_f : Quiver.Hom Fℤ_X (pb_f.obj Fℤ_S)),
      CategoryTheory.CategoryStruct.comp ιℤ_f (weilEtaleConstPullbackHom f hT_X hT_S Aℤ) =
        CategoryTheory.CategoryStruct.id Fℤ_X →
      CategoryTheory.CategoryStruct.comp (weilEtaleConstPullbackHom f hT_X hT_S Aℤ) ιℤ_f =
        CategoryTheory.CategoryStruct.id (pb_f.obj Fℤ_S) →
      ∃ ε₀ : ∀ ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u},
          weilEtaleHigherDirectImage f 0 ℱ ≅ pf_f.obj ℱ,
        (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
            (φ : Quiver.Hom ℱ₁ ℱ₂),
          CategoryTheory.CategoryStruct.comp (weilEtaleHigherDirectImageMap f 0 φ) (ε₀ ℱ₂).hom =
            CategoryTheory.CategoryStruct.comp (ε₀ ℱ₁).hom (pf_f.map φ)) ∧
        (∀ (g_X : Quiver.Hom X X) (g_S : Quiver.Hom S S)
            (h_sq : CategoryTheory.CategoryStruct.comp g_X f =
              CategoryTheory.CategoryStruct.comp f g_S),
          letI := (sys g_S).hCont
          letI := (sys g_S).hAdj
          letI := (sys g_S).hAdd_pb
          letI := (sys g_S).hLim_pb
          letI := (sys g_S).hColim_pb
          letI := (sys g_X).hCont
