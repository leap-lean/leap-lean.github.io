        CategoryTheory.MorphismProperty.Over.homMk snd_w hp₂_w
      have hδ_comm : i₁.unop.2.1 ≫ (Fgt.map w₁).left = i₂.unop.2.1 ≫ (Fgt.map w₂).left :=
        (congrArg Subtype.val hw₁).trans (congrArg Subtype.val hw₂).symm
