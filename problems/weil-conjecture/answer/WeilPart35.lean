        refine ⟨(a, y), ?_⟩
        change u_map a + sec y = b
        have ha' : u_map a = b - sec y := ha
        rw [ha', sub_add_cancel]
      have hFin2 : Finite (SC.X₂.H i) := Finite.of_surjective Φ_surj hΦ_surj
      let _ : Finite (SC.X₂.H i) := hFin2
