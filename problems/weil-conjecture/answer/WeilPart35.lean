    have hx_bar_comm : (g_k ≫ x_s) ≫ Z_tilde.hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ≫ g_k := by
      rw [Category.assoc, hx_s_sec, Category.comp_id, Category.id_comp]
    let x_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_bar.left :=
      CategoryTheory.Limits.pullback.lift (g_k ≫ x_s)
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) hx_bar_comm
    have hx_bar_pr : x_bar ≫ pr_Z = g_k ≫ x_s :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hx_bar_hom : x_bar ≫ Z_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hx_bar_pt : pr_Z.base (x_bar.base pt_k) = x_s.base pt_F := by
      change (x_bar ≫ pr_Z).base pt_k = x_s.base pt_F
      rw [hx_bar_pr]
      change x_s.base (g_k.base pt_k) = x_s.base pt_F
      rw [Subsingleton.elim (g_k.base pt_k) pt_F]
    obtain ⟨_, hx_range⟩ := hSecAlign Z_tilde x_s hx_s_sec x_bar hx_bar_hom hx_bar_pt
    have hx_bar_fbar : x_bar ≫ f_bar.left = y_bar := by
      have hfbar_w : pr_Z ≫ f₀.left = f_bar.left ≫ pr_D := hPb_fbar.w
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (x_bar ≫ f_bar.left) ≫ pr_D = y_bar ≫ pr_D
        rw [Category.assoc, ← hfbar_w, ← Category.assoc, hx_bar_pr,
          Category.assoc, hx_s_eq, hy_bar_s]
      · change (x_bar ≫ f_bar.left) ≫ D_bar.hom = y_bar ≫ D_bar.hom
        rw [Category.assoc, f_bar.w, hx_bar_hom, hy_bar]
    let x₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X_y.left :=
      hPb_y.lift x_bar s₀ (hx_bar_fbar.trans hs₀_y.symm)
    have hx₀_Xy : x₀ ≫ ι_Xy = x_bar := hPb_y.lift_fst _ _ _
    have hx₀_fy : x₀ ≫ f_y.left = s₀ := hPb_y.lift_snd _ _ _
    have hx₀_uniq : ∀ x' : X_y.left,
        (ι_Xy ≫ pr_Z).base x' = (ι_Xy ≫ pr_Z).base (x₀.base pt_k) → x' = x₀.base pt_k := by
      intro x' hx'_eq
      have hx₀_Z : (ι_Xy ≫ pr_Z).base (x₀.base pt_k) = x_s.base pt_F := by
        change pr_Z.base ((x₀ ≫ ι_Xy).base pt_k) = x_s.base pt_F
        rw [hx₀_Xy, hx_bar_pt]
      have hmem_s : pr_Z.base (ι_Xy.base x') ∈ Set.range x_s.base := by
        refine ⟨pt_F, ?_⟩
        exact hx₀_Z.symm.trans hx'_eq.symm
      obtain ⟨q_k, hq_k⟩ := (hx_range (ι_Xy.base x')).mp hmem_s
      rw [Subsingleton.elim q_k pt_k, ← hx₀_Xy] at hq_k
      exact ι_Xy.isOpenEmbedding.injective hq_k.symm
    refine ⟨x₀, hx₀_fy, ?_, ?_⟩
    · intro z hz_s₀ hz_ne
      rcases hz_s₀ with ⟨q_pt, hq_pt⟩
      rw [Subsingleton.elim q_pt pt_k] at hq_pt
      have hz_f₀ : f₀.left.base ((ι_Xy ≫ pr_Z).base z) ∈ Set.range s.base := by
        refine ⟨pt_F, ?_⟩
        rw [← hy₀_s]
        change y₀ = ((ι_Xy ≫ pr_Z) ≫ f₀.left).base z
        rw [hPb_tot.w]
        change y₀ = pr_D.base (ι_y.base (f_y.left.base z))
        rw [← hq_pt]
        change y₀ = pr_D.base ((s₀ ≫ ι_y).base pt_k)
        rw [hs₀_y]
      have hz_not_xs : (ι_Xy ≫ pr_Z).base z ∉ Set.range x_s.base := by
        rintro ⟨q_F, hq_F⟩
        rw [Subsingleton.elim q_F pt_F] at hq_F
        apply hz_ne
        refine ⟨pt_k, (hx₀_uniq z ?_).symm⟩
        rw [← hq_F]
        change x_s.base pt_F = pr_Z.base ((x₀ ≫ ι_Xy).base pt_k)
        rw [hx₀_Xy, hx_bar_pt]
      obtain ⟨V₀, hz_V₀, hSmV₀⟩ := hSm_away ((ι_Xy ≫ pr_Z).base z) hz_f₀ hz_not_xs
      exact ⟨(ι_Xy ≫ pr_Z) ⁻¹ᵁ V₀, hz_V₀, hPullSmOpen V₀ hSmV₀⟩
    · 
      obtain ⟨_h_fib₀, R', _u₀, e_B, h, V', v₀, e_Y, q,
        hEt_eB, hEt_eY, hEt_q, _heB_u₀, heY_v₀,
        ⟨ψ_B, hψB_X, hEt_ψB, heB_hom⟩, _hh_u₀, hX_v₀, hC_v₀, hRoof₀⟩ := hOdp_s pt_F
      have : AlgebraicGeometry.Etale e_B := hEt_eB
      have : AlgebraicGeometry.Etale e_Y := hEt_eY
      have : AlgebraicGeometry.Etale q := hEt_q
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) :=
        hEt_ψB
      let σ := Fin (m + 1) × Fin 2
      let I_Q₀ : Ideal (MvPolynomial σ R') :=
        Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h}
      let π_Q₀ : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R' ⧸ I_Q₀)) ⟶
          AlgebraicGeometry.Spec R' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I_Q₀).comp MvPolynomial.C))
      let u'₀ : AlgebraicGeometry.Spec R' := (q ≫ π_Q₀).base v₀
      have heB_u'₀ : e_B.base u'₀ = y₀ := by
        change (q ≫ π_Q₀ ≫ e_B).base v₀ = y₀
        rw [← hRoof₀]
        change f₀.left.base (e_Y.base v₀) = y₀
        rw [heY_v₀]
        change (x_s ≫ f₀.left).base pt_F = y₀
        rw [hx_s_eq, hy₀_s]
      have hh_u'₀ : h ∈ u'₀.asIdeal := hC_v₀

      
      letI : Algebra F ↥R' := (ψ_B.comp Polynomial.C).toAlgebra
      have halg_R' : algebraMap F ↥R' = ψ_B.comp Polynomial.C := rfl
      have heB_alg : e_B ≫ D₀.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥R')) := by
        rw [heB_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, halg_R']
      let R'_k : Type u := TensorProduct F k ↥R'
      let ι_L : k →+* R'_k := Algebra.TensorProduct.includeLeftRingHom
      let ι_R : ↥R' →+* R'_k :=
        (Algebra.TensorProduct.includeRight (R := F) (A := k) (B := ↥R')).toRingHom
      let h_k : R'_k := ι_R h
      let p_R : AlgebraicGeometry.Spec (CommRingCat.of R'_k) ⟶ AlgebraicGeometry.Spec R' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)
      have hPush_T : CategoryTheory.IsPushout
          (CommRingCat.ofHom (algebraMap F k))
          (CommRingCat.ofHom (algebraMap F ↥R'))
          (CommRingCat.ofHom ι_L)
          (CommRingCat.ofHom ι_R) :=
        CommRingCat.isPushout_tensorProduct F k ↥R'
      have hp_Rk : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L)) p_R
          g_k (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥R'))) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_T
      have heBk_comm : (p_R ≫ e_B) ≫ D₀.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫ g_k := by
        rw [Category.assoc, heB_alg]
        exact hp_Rk.w.symm
      let e_Bk : AlgebraicGeometry.Spec (CommRingCat.of R'_k) ⟶ D_bar.left :=
        CategoryTheory.Limits.pullback.lift (p_R ≫ e_B)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L)) heBk_comm
      have heBk_pr : e_Bk ≫ pr_D = p_R ≫ e_B :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have heBk_hom : e_Bk ≫ D_bar.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hOuter_eBk : CategoryTheory.IsPullback (e_Bk ≫ D_bar.hom) p_R g_k (e_B ≫ D₀.hom) := by
        rw [heBk_hom, heB_alg]
        exact hp_Rk
      have hPb_eBk : CategoryTheory.IsPullback p_R e_Bk e_B pr_D :=
        (CategoryTheory.IsPullback.of_right hOuter_eBk heBk_pr
          (CategoryTheory.IsPullback.of_hasPullback D₀.hom g_k).flip).flip
      have : AlgebraicGeometry.Etale e_Bk :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_eBk inferInstance
      let ψ_Bk : Polynomial k →+* R'_k := Polynomial.eval₂RingHom ι_L h_k
      have hψBk_C_app : ∀ c : k, ψ_Bk (Polynomial.C c) = ι_L c := fun c => by simp [ψ_Bk]
      have hψBk_X : ψ_Bk Polynomial.X = h_k := by simp [ψ_Bk]
      have hcomm_ψBk : CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap F k)) ≫
            CommRingCat.ofHom ψ_Bk =
          CommRingCat.ofHom ψ_B ≫ CommRingCat.ofHom ι_R := by
        apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext'
        · ext a
          change ψ_Bk (Polynomial.map (algebraMap F k) (Polynomial.C a)) =
            ι_R (ψ_B (Polynomial.C a))
          rw [Polynomial.map_C, hψBk_C_app]
          exact congrArg (fun f : CommRingCat.of F ⟶ CommRingCat.of R'_k => f.hom a) hPush_T.w
        · change ψ_Bk (Polynomial.map (algebraMap F k) Polynomial.X) =
            ι_R (ψ_B Polynomial.X)
          rw [Polynomial.map_X, hψBk_X, hψB_X]
      have hsc_F (sc : CategoryTheory.Limits.PushoutCocone
          (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap F k)))
          (CommRingCat.ofHom ψ_B)) :
          CommRingCat.ofHom (algebraMap F k) ≫
              (CommRingCat.ofHom Polynomial.C ≫ sc.inl) =
            CommRingCat.ofHom (algebraMap F ↥R') ≫ sc.inr := by
        apply CommRingCat.hom_ext
        ext a
        have h1 := congrArg (fun f : CommRingCat.of (Polynomial F) ⟶ sc.pt =>
          f.hom (Polynomial.C a)) sc.condition
        simpa [halg_R'] using h1
      have hColim_ψBk : CategoryTheory.Limits.IsColimit
          (CategoryTheory.Limits.PushoutCocone.mk
            (CommRingCat.ofHom ψ_Bk) (CommRingCat.ofHom ι_R) hcomm_ψBk) := by
        refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_ψBk
          (fun sc => hPush_T.desc (CommRingCat.ofHom Polynomial.C ≫ sc.inl) sc.inr (hsc_F sc))
          (fun sc => ?_) (fun sc => ?_) (fun sc m hm_inl hm_inr => ?_)
        · apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · ext c
            have h1 := hPush_T.inl_desc (CommRingCat.ofHom Polynomial.C ≫ sc.inl) sc.inr (hsc_F sc)
            change (hPush_T.desc _ _ _).hom (ψ_Bk (Polynomial.C c)) = sc.inl.hom (Polynomial.C c)
            rw [hψBk_C_app c]
            exact congrArg (fun f : CommRingCat.of k ⟶ sc.pt => f.hom c) h1
          · have h1 := hPush_T.inr_desc (CommRingCat.ofHom Polynomial.C ≫ sc.inl) sc.inr (hsc_F sc)
            have h2 := congrArg (fun f : CommRingCat.of ↥R' ⟶ sc.pt => f.hom h) h1
            have h3 := congrArg (fun f : CommRingCat.of (Polynomial F) ⟶ sc.pt =>
              f.hom Polynomial.X) sc.condition
            change (hPush_T.desc _ _ _).hom (ψ_Bk Polynomial.X) = sc.inl.hom Polynomial.X
            rw [hψBk_X]
            exact h2.trans (by simpa [hψB_X] using h3.symm)
        · exact hPush_T.inr_desc (CommRingCat.ofHom Polynomial.C ≫ sc.inl) sc.inr (hsc_F sc)
        · apply hPush_T.hom_ext
          · rw [hPush_T.inl_desc]
            have hC_ψBk : CommRingCat.ofHom Polynomial.C ≫ CommRingCat.ofHom ψ_Bk =
                CommRingCat.ofHom ι_L := by
              apply CommRingCat.hom_ext; ext c; simp [ψ_Bk]
            rw [← hC_ψBk, Category.assoc, hm_inl]
          · rw [hPush_T.inr_desc, hm_inr]
      have hPb_ψBk : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk)) p_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap F k))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
          (CategoryTheory.IsPushout.of_isColimit hColim_ψBk)
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk)) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ψBk.flip inferInstance
      obtain ⟨u_k, hu_k_pR, hu_k_eBk⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_eBk u'₀ (y_bar.base pt_k) heB_u'₀
      let O_k : TopologicalSpace.Opens (PrimeSpectrum R'_k) :=
        ⟨e_Bk.base ⁻¹' Set.range ι_y.base,
          ι_y.isOpenEmbedding.isOpen_range.preimage e_Bk.continuous⟩
      have hu_k_mem : u_k ∈ O_k := by
        change e_Bk.base u_k ∈ Set.range ι_y.base
        rw [hu_k_eBk, ← hs₀_y]
        exact ⟨s₀.base pt_k, rfl⟩
      obtain ⟨_, ⟨g₀, rfl⟩, hu_k_g₀, hg₀_sub⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hu_k_mem
      let R'_loc : CommRingCat.{u} := CommRingCat.of (Localization.Away g₀)
      let loc_map : R'_k →+* Localization.Away g₀ := algebraMap R'_k (Localization.Away g₀)
      let j_loc : AlgebraicGeometry.Spec R'_loc ⟶ AlgebraicGeometry.Spec (CommRingCat.of R'_k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_map)
      have : AlgebraicGeometry.IsOpenImmersion j_loc :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization g₀
      have hRange_jloc : Set.range j_loc.base = (PrimeSpectrum.basicOpen g₀ : Set (PrimeSpectrum R'_k)) :=
        PrimeSpectrum.localization_away_comap_range (Localization.Away g₀) g₀
      have hu_k_jloc : u_k ∈ Set.range j_loc.base := by
        rw [hRange_jloc]
        exact hu_k_g₀
      obtain ⟨u_loc, hu_loc_j⟩ := hu_k_jloc
      have hRange_loc_y : Set.range (j_loc ≫ e_Bk).base ⊆ Set.range ι_y.base := by
        rintro _ ⟨q_loc, rfl⟩
        have hmem_range : (j_loc.base q_loc : PrimeSpectrum R'_k) ∈ Set.range j_loc.base :=
          ⟨q_loc, rfl⟩
        have hmem_b : (j_loc.base q_loc : PrimeSpectrum R'_k) ∈
            (PrimeSpectrum.basicOpen g₀ : Set (PrimeSpectrum R'_k)) :=
          hRange_jloc ▸ hmem_range
        exact hg₀_sub hmem_b
      let e_B_y : AlgebraicGeometry.Spec R'_loc ⟶ U_line :=
        AlgebraicGeometry.IsOpenImmersion.lift ι_y (j_loc ≫ e_Bk) hRange_loc_y
      have heBy_fac : e_B_y ≫ ι_y = j_loc ≫ e_Bk :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_y (j_loc ≫ e_Bk) hRange_loc_y
      have hEt_ιy : AlgebraicGeometry.Etale ι_y := inferInstance
      have hEt_eBy : AlgebraicGeometry.Etale e_B_y :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) e_B_y ι_y hEt_ιy
          (by rw [heBy_fac]; infer_instance)
      have : AlgebraicGeometry.Etale e_B_y := hEt_eBy
      have heBy_uloc : e_B_y.base u_loc = s₀.base pt_k := by
        apply ι_y.isOpenEmbedding.injective
        change (e_B_y ≫ ι_y).base u_loc = (s₀ ≫ ι_y).base pt_k
        rw [heBy_fac, hs₀_y]
        change e_Bk.base (j_loc.base u_loc) = y_bar.base pt_k
        rw [hu_loc_j, hu_k_eBk]
      let α_tot : R' →+* R'_loc := loc_map.comp ι_R
      let p_B : AlgebraicGeometry.Spec R'_loc ⟶ AlgebraicGeometry.Spec R' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_tot)
      have hp_B_eq : p_B = j_loc ≫ p_R := by
        dsimp [p_B, α_tot, j_loc, p_R]
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      have hp_B_uloc : p_B.base u_loc = u'₀ := by
        rw [hp_B_eq]
        change p_R.base (j_loc.base u_loc) = u'₀
        rw [hu_loc_j, hu_k_pR]
      have hp_B_comm : e_B_y ≫ (ι_y ≫ pr_D) = p_B ≫ e_B := by
        rw [← Category.assoc, heBy_fac, Category.assoc, heBk_pr, ← Category.assoc, ← hp_B_eq]
      let h_loc : R'_loc := α_tot h
      have hh_uloc : h_loc ∈ u_loc.asIdeal := by
        change h ∈ (p_B.base u_loc).asIdeal
        rw [hp_B_uloc]
        exact hh_u'₀
      let ψ_B_y : Polynomial k →+* R'_loc := loc_map.comp ψ_Bk
      have hψBy_X : ψ_B_y Polynomial.X = h_loc := by
        change loc_map (ψ_Bk Polynomial.X) = loc_map (ι_R h)
        rw [hψBk_X]
      have hSpec_ψBy : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_y) =
          j_loc ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk) := by
        dsimp [ψ_B_y, j_loc]
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      have hEt_ψBy : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_y)) := by
        rw [hSpec_ψBy]; infer_instance
      have heBy_hom : e_B_y ≫ p_A1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_y) ≫ p_A1 := by
        have hψBk_C : ψ_Bk.comp Polynomial.C = ι_L := by
          ext c; simp [ψ_Bk]
        calc e_B_y ≫ p_A1
            = e_B_y ≫ (ι_y ≫ D_bar.hom) := by rw [hι_y_hom]
          _ = (e_B_y ≫ ι_y) ≫ D_bar.hom := (Category.assoc _ _ _).symm
          _ = j_loc ≫ (e_Bk ≫ D_bar.hom) := by rw [heBy_fac, Category.assoc]
          _ = j_loc ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Bk.comp Polynomial.C)) := by
                rw [heBk_hom, hψBk_C]
          _ = (j_loc ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk)) ≫ p_A1 := by
                rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_y) ≫ p_A1 := by
                rw [hSpec_ψBy]

      
      obtain ⟨p_Q, hPb_Q, hIdealX, hIdealH⟩ := hOdpPushout R' R'_loc h h_loc α_tot rfl
      let I_Q₁ : Ideal (MvPolynomial σ R'_loc) :=
        Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C h_loc}
      let π_Q₁ : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R'_loc ⧸ I_Q₁)) ⟶
          AlgebraicGeometry.Spec R'_loc :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I_Q₁).comp MvPolynomial.C))
      have hx₀_Z_eq : (ι_Xy ≫ pr_Z).base (x₀.base pt_k) = e_Y.base v₀ := by
        rw [heY_v₀]
        change pr_Z.base ((x₀ ≫ ι_Xy).base pt_k) = x_s.base pt_F
        rw [hx₀_Xy, hx_bar_pt]
      obtain ⟨V₁, v₁, e_Y₁, q₁, hEt_eY₁, hEt_q₁, hRoof₁, heY₁_v₁, hpQ_v₁⟩ :=
        hRelRoofPb f₀.left f_y.left (ι_Xy ≫ pr_Z) (ι_y ≫ pr_D) hPb_tot
          e_B e_B_y p_B hp_B_comm π_Q₀ π_Q₁ p_Q hPb_Q e_Y q hRoof₀
          v₀ u_loc (x₀.base pt_k) hp_B_uloc.symm hx₀_Z_eq hx₀_uniq
      intro pt
      rw [Subsingleton.elim pt pt_k]
      refine ⟨?_, R'_loc, u_loc, e_B_y, h_loc, V₁, v₁, e_Y₁, q₁,
        hEt_eBy, hEt_eY₁, hEt_q₁, heBy_uloc, heY₁_v₁,
        ⟨ψ_B_y, hψBy_X, hEt_ψBy, heBy_hom⟩, hh_uloc, ?_, ?_, hRoof₁⟩
      · change (x₀ ≫ f_y.left).base pt_k = s₀.base pt_k
        rw [hx₀_fy]
      · intro idx
        rw [hIdealX (q₁.base v₁) idx, hpQ_v₁]
        exact hX_v₀ idx
      · rw [hIdealH (q₁.base v₁), hpQ_v₁]
        exact hC_v₀

theorem weil_proj_quadric_paving_commRing_proj_atlas : (∀ (R : Type u) [CommRing R] (N : ℕ),
