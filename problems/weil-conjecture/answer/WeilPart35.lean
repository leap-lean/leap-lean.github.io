              CategoryTheory.CategoryStruct.comp
                (weilEtaleConstPullbackHom g_S hT_S hT_S Aℤ) ιℤ_S =
                CategoryTheory.CategoryStruct.id (pb_S.obj Fℤ_S) →
              ∀ z : (weilEtaleHigherDirectImage f 0 ℱ).H 2,
                (CategoryTheory.Abelian.Ext.mk₀ ιℤ_X).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_X _ _ _ _ _ Fℤ_X ℱ 2)
                    (ψ₀ ℱ z))
                  (Nat.zero_add 2) =
                ψ₀ (pb_X.obj ℱ)
                  (((CategoryTheory.Abelian.Ext.mk₀
                      ((adj_S.homEquiv (weilEtaleHigherDirectImage f 0 ℱ)
                        (weilEtaleHigherDirectImage f 0 (pb_X.obj ℱ))).symm β₀)).postcomp
                    Fℤ_S (Nat.add_zero 2))
                    ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_S).comp
                      ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_S _ _ _ _ _
                        Fℤ_S (weilEtaleHigherDirectImage f 0 ℱ) 2) z)
