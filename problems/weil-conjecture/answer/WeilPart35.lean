  have hAlphaSheafify : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂)
      [_hc_f : (weilEtaleSitePullback f).IsContinuous
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology]
      {TZ₁ : Z₁.Etale} (hTZ₁ : CategoryTheory.Limits.IsTerminal TZ₁)
      {TZ₂ : Z₂.Etale} (hTZ₂ : CategoryTheory.Limits.IsTerminal TZ₂),
      let B_f := weilEtaleSitePullback f
      let J₁ := Z₁.smallEtaleTopology
      let J₂ := Z₂.smallEtaleTopology
      let G₁ := weilEtaleTorsionSheaf Z₁ ℓ
      let G₂ := weilEtaleTorsionSheaf Z₂ ℓ
