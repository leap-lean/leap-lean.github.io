          ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
            (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f)
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f u)
            (CategoryTheory.Abelian.Ext.mk₀ (pb_f.map (ε₀_app 𝒢).hom)) (Nat.zero_add 2),
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
            (CategoryTheory.Abelian.Ext.mk₀ (pb_f.map (ε₀_app 𝒢).hom))
            (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app 𝒢)) (Nat.add_zero 2),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      change ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_X (Nat.add_zero 2)) (Ψ₀ ℱ₁ z) =
        Ψ₀ ℱ₂ (((CategoryTheory.Abelian.Ext.mk₀ (weilEtaleHigherDirectImageMap f 0 φ)).postcomp
          Fℤ_S (Nat.add_zero 2)) z)
      rw [hΨ0_eq ℱ₁ z, hΨ0_eq ℱ₂ _]
      exact hNatSq f ιℤ_f (weilEtaleHigherDirectImageMap f 0 φ) φ
        (ε₀_app ℱ₁).hom (ε₀_app ℱ₂).hom (hε₀_nat φ) 2 z
    | succ n ih =>
      intro ℱ₁ ℱ₂ h₁ h₂ φ z
      exact @hStepNat n (Ψ n) ih (SC_can ℱ₁) (SC_can ℱ₂) (hSE_can ℱ₁) (hSE_can ℱ₂)
        inferInstance inferInstance h₁ h₂ φ z

  refine ⟨Ψ, ?_, hΨ_nat, ?_⟩
  · intro n
    induction n with
    | zero =>
      intro ℱ hℱ hSubR1 y
      let e_ε := AddEquiv.ofBijective
        ((CategoryTheory.Abelian.Ext.mk₀ (ε₀_app ℱ).hom).postcomp Fℤ_S (Nat.add_zero 2))
        (hPostIsoBij (ε₀_app ℱ).hom 2)
      refine ⟨?_, ?_⟩
      · intro hy
        obtain ⟨w, hw⟩ := (hDeg2Exact ℱ hSubR1 y).mp hy
        refine ⟨e_ε.symm w, ?_⟩
        change leray_f ℱ 2 (e_ε (e_ε.symm w)) = y
        rw [e_ε.apply_symm_apply]
        exact hw
      · rintro ⟨z, hz⟩
        exact (hDeg2Exact ℱ hSubR1 y).mpr ⟨e_ε z, hz⟩
    | succ n ih =>
      intro ℱ hℱ hSubR y
      let SC := SC_can ℱ
      let hSE := hSE_can ℱ
      let hStep := (hInjAll SC hSE).2 hℱ
      let e_conn := AddEquiv.ofBijective
        ((CategoryTheory.Abelian.Ext.mk₀ (weilSmPencilLerayConnHom f SC hSE n)).postcomp
          Fℤ_S (Nat.add_zero 2))
        (hStep.2 n)
      have hIso_n1 : CategoryTheory.IsIso (weilSmPencilLerayConnHom f SC hSE (n + 1)) :=
        (hInjAll SC hSE).1 (n + 1) (Nat.le_add_left 1 n)
      have hSub_Q : Subsingleton ((weilEtaleHigherDirectImage f (n + 1) SC.X₃).H 1) :=
        hSubIso (weilSmPencilLerayConnHom f SC hSE (n + 1)) 1 hSubR
      have hIso_n2 : CategoryTheory.IsIso (weilSmPencilLerayConnHom f SC hSE (n + 2)) :=
        (hInjAll SC hSE).1 (n + 2) (by omega)
      refine ⟨?_, ?_⟩
      · intro hy
        have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (n + 3)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨u, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X hSE y hy0 rfl
        have hedge_u : weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ (n + 2) u = 0 := by
          have hc := (hEdgeConn hT_top SC hSE (n + 2) u).trans hy
          let c_inv := (@CategoryTheory.inv _ _ _ _
            (weilSmPencilLerayConnHom f SC hSE (n + 2)) hIso_n2).hom.app (Opposite.op T_S)
          have hcan : (weilSmPencilLerayConnHom f SC hSE (n + 2)).hom.app (Opposite.op T_S) ≫
              c_inv = 𝟙 _ :=
            congrArg (fun k => k.hom.app (Opposite.op T_S))
              (@CategoryTheory.IsIso.hom_inv_id _ _ _ _
                (weilSmPencilLerayConnHom f SC hSE (n + 2)) hIso_n2)
          have hc2 := congrArg (fun s => c_inv s) hc
          rw [map_zero] at hc2
          change ((weilSmPencilLerayConnHom f SC hSE (n + 2)).hom.app (Opposite.op T_S) ≫ c_inv)
            (weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ (n + 2) u) = 0 at hc2
          rw [hcan] at hc2
          exact hc2
        obtain ⟨w, rfl⟩ := (ih SC.X₃ hStep.1 hSub_Q u).mp hedge_u
        refine ⟨e_conn w, ?_⟩
        change (Ψ n SC.X₃ hStep.1 (e_conn.symm (e_conn w))).comp hSE.extClass rfl = _
        rw [e_conn.symm_apply_apply]
      · rintro ⟨z, rfl⟩
        change weilOuterTrFibEdgeHom f T_S hT_top SC.X₁ (n + 3)
          ((Ψ n SC.X₃ hStep.1 (e_conn.symm z)).comp hSE.extClass rfl) = 0
        rw [← hEdgeConn hT_top SC hSE (n + 2)]
        have hedge_Q : weilOuterTrFibEdgeHom f T_S hT_top SC.X₃ (n + 2)
            (Ψ n SC.X₃ hStep.1 (e_conn.symm z)) = 0 :=
          (ih SC.X₃ hStep.1 hSub_Q _).mpr ⟨e_conn.symm z, rfl⟩
        rw [hedge_Q, map_zero]

  · intro e_X e_S h_sq pf_S pb_S adj_S pb_X β_sys hβ_push hβ_iso _ hβ_conn
      ιℤ_X ιℤ_S hιX1 hιX2 hιS1 hιS2
    have := (sys e_S.hom).hCont
    have := (sys e_S.hom).hAdj
    have := (sys e_S.hom).hAdd_pb
    have := (sys e_S.hom).hLim_pb
    have := (sys e_S.hom).hColim_pb
    have := (sys e_X.hom).hCont
    have := (sys e_X.hom).hAdj
    have := (sys e_X.hom).hAdd_pb
    have := (sys e_X.hom).hLim_pb
    have := (sys e_X.hom).hColim_pb
    have hPcd2_pb : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        (∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q 𝒢).H p)) →
        (∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q (pb_X.obj 𝒢)).H p)) := by
      intro 𝒢 h𝒢 p q hp
      have hSub_pbS : Subsingleton ((pb_S.obj (weilEtaleHigherDirectImage f q 𝒢)).H p) :=
        (weil_sm_pencil_scheme_iso_pullback_injective_and_subsingleton_H sys e_S).2
          (weilEtaleHigherDirectImage f q 𝒢) p (h𝒢 p q hp)
      let bc_q := (adj_S.homEquiv (weilEtaleHigherDirectImage f q 𝒢)
        (weilEtaleHigherDirectImage f q (pb_X.obj 𝒢))).symm (β_sys q 𝒢)
      have hIso_bc : CategoryTheory.IsIso bc_q := hβ_iso q 𝒢
      let bc_inv := @CategoryTheory.inv _ _ _ _ bc_q hIso_bc
      exact @hSubIso _ _ bc_inv
        ⟨⟨bc_q, @CategoryTheory.IsIso.inv_hom_id _ _ _ _ bc_q hIso_bc,
          @CategoryTheory.IsIso.hom_inv_id _ _ _ _ bc_q hIso_bc⟩⟩
        p hSub_pbS
    have hEq_ind : ∀ (n : ℕ) (ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        (hℱ : ∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q ℱ).H p))
        (hℱ' : ∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q (pb_X.obj ℱ)).H p))
        (z : (weilEtaleHigherDirectImage f n ℱ).H 2),
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_X).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_X _ _ _ _ _
            Fℤ_X ℱ (n + 2)) (Ψ n ℱ hℱ z))
          (Nat.zero_add (n + 2)) =
        Ψ n (pb_X.obj ℱ) hℱ'
          (((CategoryTheory.Abelian.Ext.mk₀
              ((adj_S.homEquiv (weilEtaleHigherDirectImage f n ℱ)
                (weilEtaleHigherDirectImage f n (pb_X.obj ℱ))).symm
                (β_sys n ℱ))).postcomp
            Fℤ_S (Nat.add_zero 2))
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_S).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_S _ _ _ _ _
                Fℤ_S (weilEtaleHigherDirectImage f n ℱ) 2) z)
              (Nat.zero_add 2))) := by
      intro n
      induction n with
      | zero =>
        intro ℱ _ _ z
        exact hDeg0BCSq e_X.hom e_S.hom h_sq ℱ (β_sys 0 ℱ) (hβ_push 0 ℱ)
          ιℤ_X ιℤ_S hιX1 hιX2 hιS1 hιS2 z
      | succ n ih =>
        intro ℱ hℱ hℱ' z
        let SC := SC_can ℱ
        let hSE := hSE_can ℱ
        let SC' := SC.map pb_X
        let hSE' : SC'.ShortExact := hSE.map_of_exact pb_X
        have hInj_pbX : CategoryTheory.Injective SC'.X₂ :=
          (weil_sm_pencil_scheme_iso_pullback_injective_and_subsingleton_H sys e_X).1 SC.X₂
        let hStep := (hInjAll SC hSE).2 hℱ
        let hStep' := (@hInjAll SC' hSE' hInj_pbX).2 hℱ'
        let e_SC := AddEquiv.ofBijective
          ((CategoryTheory.Abelian.Ext.mk₀ (weilSmPencilLerayConnHom f SC hSE n)).postcomp
            Fℤ_S (Nat.add_zero 2))
          (hStep.2 n)
        let e_SC' := AddEquiv.ofBijective
          ((CategoryTheory.Abelian.Ext.mk₀ (weilSmPencilLerayConnHom f SC' hSE' n)).postcomp
            Fℤ_S (Nat.add_zero 2))
          (hStep'.2 n)
        let bc_pull : ∀ (q : ℕ) (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
            (weilEtaleHigherDirectImage f q 𝒢).H 2 →
            (weilEtaleHigherDirectImage f q (pb_X.obj 𝒢)).H 2 :=
          fun q 𝒢 u =>
            ((CategoryTheory.Abelian.Ext.mk₀
                ((adj_S.homEquiv (weilEtaleHigherDirectImage f q 𝒢)
                  (weilEtaleHigherDirectImage f q (pb_X.obj 𝒢))).symm
                  (β_sys q 𝒢))).postcomp Fℤ_S (Nat.add_zero 2))
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_S).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_S _ _ _ _ _
                  Fℤ_S (weilEtaleHigherDirectImage f q 𝒢) 2) u)
                (Nat.zero_add 2))
        have hΨ_pb_eq : ∀ z' : (weilEtaleHigherDirectImage f (n + 1) (pb_X.obj ℱ)).H 2,
            Ψ (n + 1) (pb_X.obj ℱ) hℱ' z' = @step_op SC' hSE' hInj_pbX n (Ψ n) hℱ' z' := by
          intro z'
          have hsn := @hStepNat n (Ψ n) (hΨ_nat n) SC' (SC_can (pb_X.obj ℱ)) hSE'
            (hSE_can (pb_X.obj ℱ)) hInj_pbX inferInstance hℱ' hℱ' (𝟙 (pb_X.obj ℱ)) z'
          have hid_L : ((CategoryTheory.Abelian.Ext.mk₀ (𝟙 (pb_X.obj ℱ))).postcomp Fℤ_X
              (Nat.add_zero (n + 3))) (@step_op SC' hSE' hInj_pbX n (Ψ n) hℱ' z') =
              @step_op SC' hSE' hInj_pbX n (Ψ n) hℱ' z' :=
            CategoryTheory.Abelian.Ext.comp_mk₀_id _
          have hid_R : (((CategoryTheory.Abelian.Ext.mk₀
                (weilEtaleHigherDirectImageMap f (n + 1) (𝟙 (pb_X.obj ℱ)))).postcomp
              Fℤ_S (Nat.add_zero 2)) z') = z' := by
            rw [hMapId (n + 1) (pb_X.obj ℱ)]
            exact CategoryTheory.Abelian.Ext.comp_mk₀_id z'
          exact (hsn.trans (congrArg (Ψ (n + 1) (pb_X.obj ℱ) hℱ') hid_R)).symm.trans hid_L
        let w := e_SC.symm z
        have hbc_conn : e_SC'.symm (bc_pull (n + 1) ℱ z) = bc_pull n SC.X₃ w := by
          apply e_SC'.injective
          rw [e_SC'.apply_symm_apply]
          have hz_eq : z = e_SC w := (e_SC.apply_symm_apply z).symm
          rw [hz_eq]
          exact (hNatSq e_S.hom ιℤ_S
            (weilSmPencilLerayConnHom f SC hSE n)
            (weilSmPencilLerayConnHom f SC' hSE' n)
            (β_sys n SC.X₃) (β_sys (n + 1) SC.X₁)
            (hβ_conn n SC hSE) 2 w).symm
        rw [hΨ_pb_eq (bc_pull (n + 1) ℱ z)]
        change (CategoryTheory.Abelian.Ext.mk₀ ιℤ_X).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_X
              ((Ψ n SC.X₃ hStep.1 w).comp hSE.extClass rfl))
            (Nat.zero_add (n + 3)) =
          (Ψ n (pb_X.obj SC.X₃) hStep'.1 (e_SC'.symm (bc_pull (n + 1) ℱ z))).comp
            hSE'.extClass rfl
        rw [hbc_conn,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          ← CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ ιℤ_X)
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_X (Ψ n SC.X₃ hStep.1 w))
            hSE'.extClass (Nat.zero_add (n + 2)) rfl (Nat.zero_add (n + 3))]
        congr 1
        exact ih SC.X₃ hStep.1 hStep'.1 w
    intro n ℱ hℱ
    exact ⟨hPcd2_pb ℱ hℱ, hEq_ind n ℱ hℱ (hPcd2_pb ℱ hℱ)⟩

theorem weil_smooth_pencil_p1_leray_frob_torsion_exact (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀ : u₀ ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom]
    [AlgebraicGeometry.IsProper Z_u₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom]
    (ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left)
    (hPb : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (e_P : weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1) ≅
      weilProjectiveSpaceOver (AlgebraicClosure F) 1)
    (f_bar : weilGeomScheme F Z_tilde ⟶ weilGeomScheme F (weilProjectiveSpaceOver F 1))
    (hf_bar_fst :
      f_bar ≫ CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        CategoryTheory.Limits.pullback.fst Z_tilde.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          f₀.left)
    (hf_bar_snd :
      f_bar ≫ CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        CategoryTheory.Limits.pullback.snd Z_tilde.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    (hPBC : WeilProperModPrimeBaseChangeHolds (AlgebraicClosure F) ℓ)
    (hConstGlobal : ∀ (q : ℕ)
      (T : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Etale)
