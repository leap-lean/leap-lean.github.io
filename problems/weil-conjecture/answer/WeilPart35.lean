    have hBij_jPi : Function.Bijective p_jPi := by
      rw [hjPi_eq]
      exact hBij_ebot.comp hBij_Zlast

    have hComm_fib : j_Pi_K ≫ e_QK.hom = e_PiK.hom ≫ h_Pi_K := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · apply (cancel_mono ι_Q).mp
        have hPi_amb_eq :
            ι_Pi_amb_K ≫ Φ_N = Φ_m ≫ e_PmR0.hom ≫ ι_Pi ≫ ι_Q :=
          hPiK_compat e_PmR0.hom hPb_PmR0.isoPullback_hom_fst hPb_PmR0.isoPullback_hom_snd
        calc
          (j_Pi_K ≫ e_QK.hom) ≫ CategoryTheory.Limits.pullback.fst g_Q.left s_K ≫ ι_Q =
              j_Pi_K ≫ (e_QK.hom ≫ CategoryTheory.Limits.pullback.fst g_Q.left s_K) ≫ ι_Q := by
            simp only [CategoryTheory.Category.assoc]
          _ = j_Pi_K ≫ ψ_Qt ≫ ι_Q := by
            rw [hPb_Qt_fib.isoPullback_hom_fst]
          _ = (j_Pi_K ≫ ι_Qt) ≫ Φ_N := by
            simp only [hPb_Qt.w, CategoryTheory.Category.assoc]
          _ = ι_Pi_amb_K ≫ Φ_N := by
            rw [hBot_jPi]
          _ = (Φ_m ≫ e_PmR0.hom) ≫ ι_Pi ≫ ι_Q := by
            simp only [hPi_amb_eq, CategoryTheory.Category.assoc]
          _ = (e_PiK.hom ≫
                CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
                  s_K) ≫ ι_Pi ≫ ι_Q := by
            rw [hPb_PiK.isoPullback_hom_fst]
          _ = e_PiK.hom ≫
                (CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
                  s_K ≫ ι_Pi) ≫ ι_Q := by
            simp only [CategoryTheory.Category.assoc]
          _ = (e_PiK.hom ≫ h_Pi_K) ≫
                CategoryTheory.Limits.pullback.fst g_Q.left s_K ≫ ι_Q := by
            rw [← hh_fst]
            simp only [CategoryTheory.Category.assoc]
      · calc
          (j_Pi_K ≫ e_QK.hom) ≫ CategoryTheory.Limits.pullback.snd g_Q.left s_K =
              j_Pi_K ≫ (e_QK.hom ≫ CategoryTheory.Limits.pullback.snd g_Q.left s_K) :=
            CategoryTheory.Category.assoc _ _ _
          _ = (j_Pi_K ≫ ι_Qt) ≫ (weilProjectiveSpaceOver K N).hom := by
            dsimp only [e_QK]
            simp only [hPb_Qt_fib.isoPullback_hom_snd, CategoryTheory.Category.assoc]
          _ = ι_Pi_amb_K ≫ (weilProjectiveSpaceOver K N).hom := by
            rw [hBot_jPi]
          _ = (weilProjectiveSpaceOver K m).hom := hPiK_hom
          _ = e_PiK.hom ≫
                CategoryTheory.Limits.pullback.snd
                  (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
                  s_K :=
            hPb_PiK.isoPullback_hom_snd.symm
          _ = (e_PiK.hom ≫ h_Pi_K) ≫ CategoryTheory.Limits.pullback.snd g_Q.left s_K := by
            rw [CategoryTheory.Category.assoc, hh_snd]

    obtain ⟨p_eQK, hp_eQK⟩ := hPullEx e_QK.hom ℓ i
    have hBij_eQK : Function.Bijective p_eQK := hIsoPullBij e_QK i p_eQK hp_eQK
    obtain ⟨p_ePiK_inv, hp_ePiK_inv⟩ := hPullEx e_PiK.inv ℓ i
    have hBij_ePiK_inv : Function.Bijective p_ePiK_inv :=
      hIsoPullBij e_PiK.symm i p_ePiK_inv hp_ePiK_inv
    obtain ⟨p_comp, hp_comp⟩ := hPullEx (j_Pi_K ≫ e_QK.hom) ℓ i
    have hp_comp_lhs : p_comp = p_jPi.comp p_eQK :=
      hPullComp j_Pi_K e_QK.hom ℓ i p_jPi p_eQK p_comp hp_jPi hp_eQK hp_comp
    have hBij_comp : Function.Bijective p_comp := by
      rw [hp_comp_lhs]
      exact hBij_jPi.comp hBij_eQK
    obtain ⟨p_ePiK, hp_ePiK⟩ := hPullEx e_PiK.hom ℓ i
    have hp_comp_rhs_pb : WeilIsTorsionEtalePullback (e_PiK.hom ≫ h_Pi_K) ℓ i p_comp := by
      rwa [← hComm_fib]
    have hp_comp_rhs : p_comp = p_ePiK.comp p_i :=
      hPullComp e_PiK.hom h_Pi_K ℓ i p_ePiK p_i p_comp hp_ePiK hp_i hp_comp_rhs_pb
    obtain ⟨p_id_Pi, hp_id_Pi⟩ := hPullEx
      (𝟙 (CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) s_K)) ℓ i
    have hid_Pi : p_id_Pi = AddMonoidHom.id _ := hPullId ℓ i p_id_Pi hp_id_Pi
    have hp_inv_hom_pb : WeilIsTorsionEtalePullback (e_PiK.inv ≫ e_PiK.hom) ℓ i p_id_Pi := by
      rwa [e_PiK.inv_hom_id]
    have hp_inv_hom : p_ePiK_inv.comp p_ePiK = AddMonoidHom.id _ :=
      (hPullComp e_PiK.inv e_PiK.hom ℓ i p_ePiK_inv p_ePiK p_id_Pi
        hp_ePiK_inv hp_ePiK hp_inv_hom_pb).symm.trans hid_Pi
    have hp_i_eq : p_i = p_ePiK_inv.comp p_comp := by
      rw [hp_comp_rhs, ← AddMonoidHom.comp_assoc, hp_inv_hom, AddMonoidHom.id_comp]
    rw [hp_i_eq]
    exact hBij_ePiK_inv.comp hBij_comp

theorem weil_sing_origin_cosp_etale_roof_trunc_acyclic_dim_shift (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R_bar Ω : Type u) [CommRing R_bar] [HenselianLocalRing R_bar]
    [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    [Field Ω] [IsAlgClosed Ω]
    {X X_U : AlgebraicGeometry.Scheme.{u}}
    (f_R : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
    (f_Ω : X_U ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (j_X : X_U ⟶ X) [AlgebraicGeometry.IsOpenImmersion j_X]
    (N : ℕ)
    (hRoofAtlas : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
      z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range j_X.base →
      ∃ (Y U V V_U : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsAffine V)
        (j_Y : U ⟶ Y)
        (e_X : V ⟶ X) (_ : AlgebraicGeometry.Etale e_X)
        (e_Y : V ⟶ Y) (_ : AlgebraicGeometry.Etale e_Y)
        (e_XU : V_U ⟶ X_U) (j_V : V_U ⟶ V) (e_YU : V_U ⟶ U),
        z_bar.base (⊥ : PrimeSpectrum K) ∈ Set.range e_X.base ∧
        CategoryTheory.IsPullback e_XU j_V j_X e_X ∧
        CategoryTheory.IsPullback e_YU j_V j_Y e_Y ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
          (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Y w) ℓ 0),
          WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Y w) ℓ 0 ψ₀ →
          Function.Bijective ψ₀) ∧
        (∀ (b : ℕ), 1 ≤ b → b ≤ N →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage j_Y b (weilEtaleTorsionSheaf U ℓ)))) :
    (∀ (r : ℕ), r ≤ N →
      ∀ (ψ_r : weilEtaleTorsionH X ℓ r →+ weilEtaleTorsionH X_U ℓ r),
        WeilIsTorsionEtalePullback j_X ℓ r ψ_r →
        Function.Bijective ψ_r) ∧
    (∀ (r : ℕ), r ≤ N + 1 →
      ∀ (ψ_r : weilEtaleTorsionH X ℓ r →+ weilEtaleTorsionH X_U ℓ r),
        WeilIsTorsionEtalePullback j_X ℓ r ψ_r →
        Function.Injective ψ_r) :=
by
  classical
  let _ := (f_R, f_Ω)
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hop_comp : ∀ {C : Type _} [CategoryTheory.Category C] {A B D : C}
      (g₁ : A ⟶ B) (g₂ : B ⟶ D),
      (g₁ ≫ g₂).op = g₂.op ≫ g₁.op := fun _ _ => rfl

  
  have hMemEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale)
      (R : CategoryTheory.Sieve U),
      R ∈ Z.smallEtaleTopology U ↔
        ∀ (x : ↥U.left), ∃ (Y₀ : Z.Etale) (g : Y₀ ⟶ U) (y : ↥Y₀.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro Z U R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      Z (le_refl P_et)
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      P_et P_et Z
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance U R
    exact (iff_of_eq
      (congrArg (fun K : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ K U) heq)).trans hiff

  let termEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}), Z.Etale :=
    fun Z => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id Z) inferInstance
  have hTermEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (termEtale Z) := by
    intro Z
    exact CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U₀ => CategoryTheory.MorphismProperty.Over.homMk U₀.hom
        (CategoryTheory.Category.comp_id U₀.hom))
      (fun U₀ m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))

  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)

  
  have hInjHDIZero : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂)
      (I : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective I] (p : ℕ),
      1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p I) := by
    intro Z₁ Z₂ f I _ p hp
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, p = m + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
    have hPZero : CategoryTheory.Limits.IsZero
        (CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
          (I.cohomologyPresheaf (m + 1))) := by
      rw [CategoryTheory.Functor.isZero_iff]
      intro W
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext x
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x
    exact
      (CategoryTheory.presheafToSheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}).map_isZero hPZero

  
  
  
  have hOpenRoof : ∀ (x : ↥X), x ∈ Set.range j_X.base →
      ∃ (V : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsAffine V)
        (e_X : V ⟶ X) (_ : AlgebraicGeometry.Etale e_X)
        (e_XU : V ⟶ X_U) (_ : AlgebraicGeometry.Etale e_XU),
        x ∈ Set.range e_X.base ∧
        CategoryTheory.IsPullback e_XU (CategoryTheory.CategoryStruct.id V) j_X e_X ∧
        CategoryTheory.IsPullback e_XU (CategoryTheory.CategoryStruct.id V)
          (CategoryTheory.CategoryStruct.id X_U) e_XU ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ X_U) [AlgebraicGeometry.Etale w]
          (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
            weilEtaleTorsionH
              (CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id X_U) w) ℓ 0),
          WeilIsTorsionEtalePullback
            (CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id X_U) w) ℓ 0 ψ₀ →
          Function.Bijective ψ₀) ∧
        (∀ (b : ℕ), 1 ≤ b →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id X_U) b
              (weilEtaleTorsionSheaf X_U ℓ))) := by
    intro x hx
    rcases hx with ⟨x_U, rfl⟩
    obtain ⟨U_aff, hAff, hx_aff, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := x_U) (U := (⊤ : X_U.Opens)) trivial
    let V : AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Spec (X_U.presheaf.obj (Opposite.op U_aff))
    have hIsAff_V : AlgebraicGeometry.IsAffine V := inferInstance
    let e_XU : V ⟶ X_U := hAff.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion e_XU := hAff.isOpenImmersion_fromSpec
    have hEt_eXU : AlgebraicGeometry.Etale e_XU := inferInstance
    let e_X : V ⟶ X := e_XU ≫ j_X
    have hEt_eX : AlgebraicGeometry.Etale e_X :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        e_XU j_X hEt_eXU inferInstance
    have hx_mem_U : x_U ∈ Set.range e_XU.base := by
      rw [hAff.range_fromSpec]
      exact hx_aff
    rcases hx_mem_U with ⟨v₀, hv₀⟩
    have hx_range : j_X.base x_U ∈ Set.range e_X.base :=
      ⟨v₀, (AlgebraicGeometry.Scheme.Hom.comp_apply e_XU j_X v₀).trans (congrArg j_X.base hv₀)⟩
    haveI : CategoryTheory.Mono j_X := AlgebraicGeometry.IsOpenImmersion.mono j_X
    have hSq_X : CategoryTheory.IsPullback e_XU (CategoryTheory.CategoryStruct.id V) j_X e_X := by
      refine CategoryTheory.IsPullback.of_isLimit
        (c := CategoryTheory.Limits.PullbackCone.mk e_XU (CategoryTheory.CategoryStruct.id V)
          (CategoryTheory.Category.id_comp _).symm) ?_
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
        (fun s => s.snd)
        (fun s => (CategoryTheory.cancel_mono j_X).mp
          ((CategoryTheory.Category.assoc s.snd e_XU j_X).trans s.condition.symm))
        (fun s => CategoryTheory.Category.comp_id s.snd)
        (fun s m _ hm₂ => (CategoryTheory.Category.comp_id m).symm.trans hm₂)
    have hSq_Y : CategoryTheory.IsPullback e_XU (CategoryTheory.CategoryStruct.id V)
        (CategoryTheory.CategoryStruct.id X_U) e_XU := by
      refine CategoryTheory.IsPullback.of_isLimit
        (c := CategoryTheory.Limits.PullbackCone.mk e_XU (CategoryTheory.CategoryStruct.id V)
          ((CategoryTheory.Category.comp_id e_XU).trans
            (CategoryTheory.Category.id_comp e_XU).symm)) ?_
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
        (fun s => s.snd)
        (fun s => s.condition.symm.trans (CategoryTheory.Category.comp_id s.fst))
        (fun s => CategoryTheory.Category.comp_id s.snd)
        (fun s m _ hm₂ => (CategoryTheory.Category.comp_id m).symm.trans hm₂)
    have hBij0_id : ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ X_U) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH
            (CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id X_U) w) ℓ 0),
        WeilIsTorsionEtalePullback
          (CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id X_U) w) ℓ 0 ψ₀ →
        Function.Bijective ψ₀ := by
      intro W _ w _ ψ₀ hψ₀
      let j_id := CategoryTheory.CategoryStruct.id X_U
      let P_id := CategoryTheory.Limits.pullback j_id w
      let π : P_id ⟶ W := CategoryTheory.Limits.pullback.snd j_id w
      have hIso_π : CategoryTheory.IsIso π :=
        CategoryTheory.Limits.pullback_snd_iso_of_left_iso j_id w
      let π_inv : W ⟶ P_id := @CategoryTheory.inv _ _ _ _ π hIso_π
      obtain ⟨ψ_inv, hψ_inv⟩ := hPullEx π_inv ℓ 0
      obtain ⟨p_idW, hp_idW⟩ := hPullEx (π_inv ≫ π) ℓ 0
      have hp_idW_comp : p_idW = ψ_inv.comp ψ₀ :=
        hPullComp π_inv π ℓ 0 ψ_inv ψ₀ p_idW hψ_inv hψ₀ hp_idW
      have hp_idW_wt : WeilIsTorsionEtalePullback (CategoryTheory.CategoryStruct.id W) ℓ 0 p_idW :=
        Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ 0 p_idW)
          (@CategoryTheory.IsIso.inv_hom_id _ _ _ _ π hIso_π)) hp_idW
      have hp_idW_eq : p_idW = AddMonoidHom.id _ := hPullId ℓ 0 p_idW hp_idW_wt
      obtain ⟨p_idP, hp_idP⟩ := hPullEx (π ≫ π_inv) ℓ 0
      have hp_idP_comp : p_idP = ψ₀.comp ψ_inv :=
        hPullComp π π_inv ℓ 0 ψ₀ ψ_inv p_idP hψ₀ hψ_inv hp_idP
      have hp_idP_wt :
          WeilIsTorsionEtalePullback (CategoryTheory.CategoryStruct.id P_id) ℓ 0 p_idP :=
        Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ 0 p_idP)
          (@CategoryTheory.IsIso.hom_inv_id _ _ _ _ π hIso_π)) hp_idP
      have hp_idP_eq : p_idP = AddMonoidHom.id _ := hPullId ℓ 0 p_idP hp_idP_wt
      refine Function.bijective_iff_has_inverse.mpr ⟨⇑ψ_inv, ?_, ?_⟩
      · intro a
        exact congrFun (congrArg DFunLike.coe (hp_idW_comp.symm.trans hp_idW_eq)) a
      · intro y
        exact congrFun (congrArg DFunLike.coe (hp_idP_comp.symm.trans hp_idP_eq)) y
    have hZero_id : ∀ (b : ℕ), 1 ≤ b →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id X_U) b
            (weilEtaleTorsionSheaf X_U ℓ)) := by
      let J_XU := X_U.smallEtaleTopology
      let id_XU := CategoryTheory.CategoryStruct.id X_U
      have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) id_XU :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) id_XU :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_id : CategoryTheory.Functor X_U.Etale X_U.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ id_XU
      let hom_D : ∀ D : X_U.Etale, B_id.obj D ⟶ D := fun D =>
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst D.hom id_XU)
          ((CategoryTheory.Limits.pullback.condition (f := D.hom) (g := id_XU)).trans
            (CategoryTheory.Category.comp_id _))
      let lift_D : ∀ D : X_U.Etale,
          D.left ⟶ CategoryTheory.Limits.pullback D.hom id_XU := fun D =>
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.id D.left) D.hom
          ((CategoryTheory.Category.id_comp D.hom).trans
            (CategoryTheory.Category.comp_id D.hom).symm)
      let inv_D : ∀ D : X_U.Etale, D ⟶ B_id.obj D := fun D =>
        CategoryTheory.MorphismProperty.Over.homMk (lift_D D)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      let e_id : B_id ≅ CategoryTheory.Functor.id X_U.Etale :=
        CategoryTheory.NatIso.ofComponents
          (fun D =>
            { hom := hom_D D
              inv := inv_D D
              hom_inv_id := by
                refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
                change CategoryTheory.Limits.pullback.fst D.hom id_XU ≫ lift_D D =
                  CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.pullback D.hom id_XU)
                apply CategoryTheory.Limits.pullback.hom_ext
                · exact (CategoryTheory.Category.assoc
                      (CategoryTheory.Limits.pullback.fst D.hom id_XU) (lift_D D) _).trans
                    ((congrArg (CategoryTheory.Limits.pullback.fst D.hom id_XU ≫ ·)
                        (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                      ((CategoryTheory.Category.comp_id _).trans
                        (CategoryTheory.Category.id_comp _).symm))
                · exact (CategoryTheory.Category.assoc
                      (CategoryTheory.Limits.pullback.fst D.hom id_XU) (lift_D D) _).trans
                    ((congrArg (CategoryTheory.Limits.pullback.fst D.hom id_XU ≫ ·)
                        (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                      ((CategoryTheory.Limits.pullback.condition (f := D.hom) (g := id_XU)).trans
                        ((CategoryTheory.Category.comp_id _).trans
                          (CategoryTheory.Category.id_comp _).symm)))
              inv_hom_id := by
                refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
                exact CategoryTheory.Limits.pullback.lift_fst _ _ _ })
          (fun {D₁ D₂} g => by
            refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
            exact CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hc_id : B_id.IsContinuous J_XU J_XU :=
        CategoryTheory.Functor.isContinuous_of_iso e_id.symm J_XU J_XU
      letI := hc_id
      let pf_id := B_id.sheafPushforwardContinuous AddCommGrpCat.{u} J_XU J_XU
      let e_pf : pf_id ≅ CategoryTheory.Functor.id (CategoryTheory.Sheaf J_XU AddCommGrpCat.{u}) :=
        CategoryTheory.Functor.sheafPushforwardContinuousId' e_id AddCommGrpCat.{u} J_XU
