        { toFun := (CategoryTheory.Abelian.Ext.mk₀ e_iso.hom).postcomp Fℤ_D (Nat.add_zero i)
          invFun := (CategoryTheory.Abelian.Ext.mk₀ e_iso.inv).postcomp Fℤ_D (Nat.add_zero i)
          left_inv := fun x => by
