    fun ℱ => { exact := CategoryTheory.ShortComplex.exact_cokernel (CategoryTheory.Injective.ι ℱ) }

  have hConn1_iso : ∀ ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      CategoryTheory.IsIso (weilSmPencilLerayConnHom f (SC_can ℱ) (hSE_can ℱ) 1) := by
    intro ℱ
    obtain ⟨h_vδ1, h_δu1, hEx_vδ1, hEx_δu1⟩ := hJoints (SC_can ℱ) (hSE_can ℱ) 1
