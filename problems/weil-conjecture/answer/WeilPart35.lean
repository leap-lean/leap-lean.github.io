        AlgebraicGeometry.IsClosedImmersion ι_odd ∧
        ι_odd ≫ p_NS = p_mS ∧
        ∀ a : Fin (N + 1),
          let g_Pi_S : Fin (m + 2) → ↑(P_NS.presheaf.obj (Opposite.op (D_N a))) :=
            fun ν => Fin.lastCases (t_NS a w_idx) (fun j => t_NS a (u_idx j)) ν
          let O_Pi : P_mS.Opens := (TopologicalSpace.Opens.map ι_odd.base).obj (D_N a)
