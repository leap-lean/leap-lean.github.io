              inv :=
                { hom :=
                    { app := fun j =>
                        CategoryTheory.Limits.Pi.lift fun (t : Φ₁.fiber.obj (B.obj j.unop)) =>
                          CategoryTheory.Limits.Pi.π (fun (_ : Φ₂.fiber.obj j.unop) => M)
