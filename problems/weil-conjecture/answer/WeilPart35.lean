      fun ℱ U γ =>
        let i₀ := Classical.choose (hShrink U γ)
        let w₀ := Classical.choose (Classical.choose_spec (hShrink U γ))
        ℱ.obj.map w₀.op ≫ CategoryTheory.Limits.colimit.ι (stalkDiag ⋙ ℱ.obj) i₀
