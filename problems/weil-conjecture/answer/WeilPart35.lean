by
  classical
  
  have hThetaOfCoord : ∀ (R : Type u) [CommRing R] (N : ℕ)
      (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
      (c_R : ∀ a : Fin (N + 1),
        R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a))))
      (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a)))),
      IsCommRingProjCoordSystem R N hAff c_R t_R →
      ∃ (θ_R : ∀ a : Fin (N + 1),
          MvPolynomial (Fin N) R ≃+*
            ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen R N a)))),
        ∀ a : Fin (N + 1),
          (θ_R a).toRingHom.comp MvPolynomial.C = c_R a ∧
          ∀ i : Fin N, θ_R a (MvPolynomial.X i) = t_R a (a.succAbove i) := by
    intro R _ N hAff c_R t_R hCoord
    have ht_diag := hCoord.2.2.2.2.1
    have hClosure := hCoord.2.2.2.2.2.1
    have hUniv := hCoord.2.2.2.2.2.2.1
    have hPerChart : ∀ a : Fin (N + 1),
        ∃ θ_a : MvPolynomial (Fin N) R ≃+*
            ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen R N a))),
          θ_a.toRingHom.comp MvPolynomial.C = c_R a ∧
          ∀ i : Fin N, θ_a (MvPolynomial.X i) = t_R a (a.succAbove i) := by
      intro a
      let A_a := ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a)))
      let α_a : MvPolynomial (Fin N) R →+* A_a :=
        MvPolynomial.eval₂Hom (c_R a) (fun i : Fin N => t_R a (a.succAbove i))
      let v_a : Fin (N + 1) → MvPolynomial (Fin N) R :=
        a.insertNth (1 : MvPolynomial (Fin N) R) MvPolynomial.X
      have hva : v_a a = 1 := by
        simp only [v_a, Fin.insertNth_apply_same]
      rcases hUniv a (MvPolynomial (Fin N) R) MvPolynomial.C v_a hva with ⟨β_a, hβC, hβt⟩
      have hleft : Function.LeftInverse β_a α_a := by
        have hcomp : β_a.comp α_a = RingHom.id (MvPolynomial (Fin N) R) := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            simp only [RingHom.comp_apply, RingHom.id_apply, α_a, MvPolynomial.eval₂Hom_C]
            exact RingHom.congr_fun hβC r
          · intro i
            simp only [RingHom.comp_apply, RingHom.id_apply, α_a, MvPolynomial.eval₂Hom_X',
              hβt, v_a, Fin.insertNth_apply_succAbove]
        exact fun p => RingHom.congr_fun hcomp p
      have hright : Function.RightInverse β_a α_a := by
        have hcomp : α_a.comp β_a = RingHom.id A_a := by
          have hle : Subring.closure (Set.range (c_R a) ∪ Set.range (t_R a)) ≤
              RingHom.eqLocus (α_a.comp β_a) (RingHom.id A_a) := by
            rw [Subring.closure_le]
            rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
            · change α_a (β_a (c_R a r)) = c_R a r
              have hr : β_a (c_R a r) = MvPolynomial.C r := RingHom.congr_fun hβC r
              rw [hr]
              exact MvPolynomial.eval₂Hom_C _ _ r
            · change α_a (β_a (t_R a b)) = t_R a b
              rw [hβt b]
              refine Fin.succAboveCases a ?_ ?_ b
              · dsimp only [v_a]
                rw [Fin.insertNth_apply_same, map_one, ht_diag a]
              · intro i
                dsimp only [v_a]
                rw [Fin.insertNth_apply_succAbove]
                exact MvPolynomial.eval₂Hom_X' _ _ i
          rw [hClosure a, top_le_iff] at hle
          apply RingHom.ext
          intro x
          exact (SetLike.ext_iff.mp hle x).mpr trivial
        exact fun x => RingHom.congr_fun hcomp x
      let θ_a : MvPolynomial (Fin N) R ≃+* A_a :=
        { α_a with
          invFun := β_a
          left_inv := hleft
          right_inv := hright }
      refine ⟨θ_a, ?_, ?_⟩
      · apply RingHom.ext
        intro r
        exact MvPolynomial.eval₂Hom_C _ _ r
      · intro i
        exact MvPolynomial.eval₂Hom_X' _ _ i
    exact ⟨fun a => (hPerChart a).choose, fun a => (hPerChart a).choose_spec⟩

  
  have hKerCompIso : ∀ {A B C : CommRingCat.{u}} (f : A ⟶ B) (g : B ⟶ C) [CategoryTheory.IsIso g],
      RingHom.ker (f ≫ g).hom = RingHom.ker f.hom := by
    intro A B C f g _
    ext x
    simp only [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply]
    constructor
    · intro hx
      have h0 : (CategoryTheory.inv g).hom (g.hom (f.hom x)) = 0 := by rw [hx, map_zero]
      have hid : (g ≫ CategoryTheory.inv g).hom (f.hom x) = f.hom x := by
        rw [CategoryTheory.IsIso.hom_inv_id]; rfl
      exact hid.symm.trans h0
    · intro hx
      rw [hx, map_zero]

  
  have hKerOfChartPres : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (ι : Z ⟶ X)
      [AlgebraicGeometry.IsClosedImmersion ι] {D : X.Opens}
      (hAff : AlgebraicGeometry.IsAffineOpen D)
      (I : Ideal ↑(X.presheaf.obj (Opposite.op D))),
      let O : Z.Opens := (TopologicalSpace.Opens.map ι.base).obj D
      ∀ (e : O.toScheme ≅
        AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op D)) ⧸ I))),
      O.ι ≫ ι =
        e.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫
          hAff.fromSpec →
      RingHom.ker (ι.app D).hom = I ∧ ι.ker.ideal ⟨D, hAff⟩ = I := by
    intro X Z ι _ D hAff I O e h_eq
    set q : X.presheaf.obj (Opposite.op D) ⟶
        CommRingCat.of (↑(X.presheaf.obj (Opposite.op D)) ⧸ I) :=
      CommRingCat.ofHom (Ideal.Quotient.mk I)
    have h_ker_eq := congrArg (fun m : O.toScheme ⟶ X => RingHom.ker (m.app D).hom) h_eq
    have hO_img : O.ι ''ᵁ ((TopologicalSpace.Opens.map O.ι.base).obj O) = O := by
      apply le_antisymm
      · intro z hz
        rcases hz with ⟨w, _, rfl⟩
        exact w.2
      · intro z hz
        exact ⟨⟨z, hz⟩, hz, rfl⟩
    have hO_iso : CategoryTheory.IsIso (O.ι.app O) := by
      rw [AlgebraicGeometry.Scheme.Opens.ι_app]
      have hhom : CategoryTheory.homOfLE (O.ι.image_preimage_le O) = CategoryTheory.eqToHom hO_img :=
        Subsingleton.elim _ _
      rw [hhom]
      exact (Z.presheaf.mapIso (CategoryTheory.eqToIso hO_img).op).isIso_hom
    have hLHS_ker : RingHom.ker ((O.ι ≫ ι).app D).hom = RingHom.ker (ι.app D).hom := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_app]
      exact @hKerCompIso _ _ _ (ι.app D) (O.ι.app O) hO_iso
    let g_R_rhs : AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op D)) ⧸ I)) ⟶ X :=
      AlgebraicGeometry.Spec.map q ≫ hAff.fromSpec
    have hRHS_ker1 : RingHom.ker ((e.hom ≫ g_R_rhs).app D).hom = RingHom.ker (g_R_rhs.app D).hom := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_app]
      have he_iso : CategoryTheory.IsIso (e.hom.app ((TopologicalSpace.Opens.map g_R_rhs.base).obj D)) :=
        inferInstance
      exact @hKerCompIso _ _ _ (g_R_rhs.app D) _ he_iso
    have hRHS_ker2 : RingHom.ker (g_R_rhs.app D).hom = I := by
      dsimp only [g_R_rhs]
      rw [AlgebraicGeometry.Scheme.Hom.comp_app, hAff.fromSpec_app_self,
        CategoryTheory.Category.assoc]
      have hnat := (AlgebraicGeometry.Spec.map q).naturality
        (CategoryTheory.eqToHom hAff.fromSpec_preimage_self).op
      rw [hnat, ← CategoryTheory.Category.assoc]
      have hmap_iso : CategoryTheory.IsIso
          ((AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op D)) ⧸ I))).presheaf.map
            (((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map q).base).map
              (CategoryTheory.eqToHom hAff.fromSpec_preimage_self).op.unop).op)) := by
        have h_eq_top : ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map q).base).map
            (CategoryTheory.eqToHom hAff.fromSpec_preimage_self).op.unop) =
            CategoryTheory.eqToHom
              (congrArg (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map q).base).obj
                hAff.fromSpec_preimage_self) := Subsingleton.elim _ _
        rw [h_eq_top]
        exact ((AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op D)) ⧸ I))).presheaf.mapIso
          (CategoryTheory.eqToIso
            (congrArg (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map q).base).obj
              hAff.fromSpec_preimage_self)).op).isIso_hom
      have hker_step : RingHom.ker
          ((((AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op D))).inv ≫
              (AlgebraicGeometry.Spec.map q).app ⊤) ≫
            (AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op D)) ⧸ I))).presheaf.map
              (((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map q).base).map
                (CategoryTheory.eqToHom hAff.fromSpec_preimage_self).op.unop).op)).hom) =
          RingHom.ker
            (((AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op D))).inv ≫
              (AlgebraicGeometry.Spec.map q).appTop).hom) :=
        @hKerCompIso _ _ _ _ _ hmap_iso
      refine hker_step.trans ?_
      have hΓ := AlgebraicGeometry.Scheme.ΓSpecIso_naturality q
      have hΓ' : (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op D))).inv ≫
          (AlgebraicGeometry.Spec.map q).appTop =
          q ≫ (AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (↑(X.presheaf.obj (Opposite.op D)) ⧸ I))).inv := by
        rw [CategoryTheory.Iso.inv_comp_eq, ← CategoryTheory.Category.assoc, ← hΓ,
          CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      rw [hΓ', hKerCompIso]
      exact Ideal.mk_ker
    have hRHS_ker : RingHom.ker ((e.hom ≫ AlgebraicGeometry.Spec.map q ≫ hAff.fromSpec).app D).hom = I :=
      hRHS_ker1.trans hRHS_ker2
    have hker1 : RingHom.ker (ι.app D).hom = I := by
      rw [← hLHS_ker, h_ker_eq, hRHS_ker]
    exact ⟨hker1, (AlgebraicGeometry.Scheme.Hom.ker_apply ι ⟨D, hAff⟩).trans hker1⟩

  
  have hChartPresOfKer : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (ι : Z ⟶ X)
      [AlgebraicGeometry.IsClosedImmersion ι] {D : X.Opens}
      (hAff : AlgebraicGeometry.IsAffineOpen D)
      (I : Ideal ↑(X.presheaf.obj (Opposite.op D))),
      ι.ker.ideal ⟨D, hAff⟩ = I →
      let O : Z.Opens := (TopologicalSpace.Opens.map ι.base).obj D
      ∃ e : O.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
          (↑(X.presheaf.obj (Opposite.op D)) ⧸ I)),
        O.ι ≫ ι =
          e.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫
            hAff.fromSpec := by
    intro X Z ι _ D hAff I hker_eq O
    have _ : AlgebraicGeometry.IsClosedImmersion (ι ∣_ D) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict ι D).flip inferInstance
    have hf_closed : AlgebraicGeometry.IsClosedImmersion ((ι ∣_ D) ≫ hAff.isoSpec.hom) :=
      inferInstance
    rcases AlgebraicGeometry.IsClosedImmersion.Spec_iff.mp hf_closed with ⟨J, e', he'⟩
    have h_eqJ : O.ι ≫ ι =
        e'.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫
          hAff.fromSpec := by
      calc
        O.ι ≫ ι = (ι ∣_ D) ≫ D.ι := (AlgebraicGeometry.morphismRestrict_ι ι D).symm
        _ = ((ι ∣_ D) ≫ hAff.isoSpec.hom) ≫ hAff.fromSpec := by
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec]
        _ = e'.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫
              hAff.fromSpec := by
          rw [he', CategoryTheory.Category.assoc]
    have hJI : J = I := ((hKerOfChartPres ι hAff J e' h_eqJ).2).symm.trans hker_eq
    subst hJI
    exact ⟨e', h_eqJ⟩

  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · 
    
    
    intro R _ N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hX_mem : ∀ b : Fin (N + 1), MvPolynomial.X b ∈ 𝒜 1 :=
      fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R b)
    let hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a) :=
      fun a => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one
    let c_R : ∀ a : Fin (N + 1),
        R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
