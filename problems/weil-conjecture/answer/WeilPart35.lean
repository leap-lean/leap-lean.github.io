    let G_L := LinearMap.baseChange L G
    let P_L := LinearMap.baseChange L P
    let H_L := LinearMap.baseChange L H_split
    let S_L := LinearMap.baseChange L S_high
    let Φ_low : Module.End L (TensorProduct K₀ L V_low) := LinearMap.baseChange L frob_low
    let Φ_mid : Module.End L (TensorProduct K₀ L V_mid) := LinearMap.baseChange L frob_mid
    let Φ_high : Module.End L (TensorProduct K₀ L V_high) := LinearMap.baseChange L frob_high
    have hSplit_L : G_L.comp H_L + S_L.comp P_L = LinearMap.id := by
      dsimp [G_L, P_L, H_L, S_L]
