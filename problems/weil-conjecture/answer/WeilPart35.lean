              e_Pi.hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
                (hAff_NS a).fromSpec := by
    intro S _ P_NS P_mS p_NS p_mS D_N D_m hAff_NS c_NS t_NS hAff_PmS c_PmS t_PmS θ_PmS
      hSup_N hc_hom_N ht_diag_N hCl_N hUniv_N hBasic_N hCov_cN hCov_tN
      hSup_m hc_hom_m ht_diag_m hBasic_m hCov_cm hCov_tm hθ_PmS
    let val_odd : ∀ r : Fin (m + 1), Fin (N + 1) → ↑(P_mS.presheaf.obj (Opposite.op (D_m r))) :=
      fun r b => if h_odd : b.1 % 2 = 1 then t_PmS r ⟨b.1 / 2, by have := b.2; omega⟩ else 0
    have hval_v : ∀ (r j : Fin (m + 1)), val_odd r (v_idx j) = t_PmS r j := by
      intro r j
      dsimp only [val_odd, v_idx]
      have h1 : (2 * j.1 + 1) % 2 = 1 := by omega
      rw [dif_pos h1]
      congr 1; ext; dsimp; omega
    have hψ_ex : ∀ r : Fin (m + 1),
        ∃ ψ : ↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r)))) →+*
            ↑(P_mS.presheaf.obj (Opposite.op (D_m r))),
          ψ.comp (c_NS (v_idx r)) = c_PmS r ∧
          ∀ b : Fin (N + 1), ψ (t_NS (v_idx r) b) = val_odd r b := by
      intro r
      apply hUniv_N (v_idx r) _ (c_PmS r) (val_odd r)
      rw [hval_v, ht_diag_m]
    choose ψ_S hψ_c hψ_t using hψ_ex
    let f_S : ∀ r : Fin (m + 1), (D_m r).toScheme ⟶ P_NS := fun r =>
      (D_m r).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_S r)) ≫
        (hAff_NS (v_idx r)).fromSpec
    have hOverlap_inf : ∀ r r' : Fin (m + 1),
        P_mS.homOfLE (inf_le_left : D_m r ⊓ D_m r' ≤ D_m r) ≫ f_S r =
          P_mS.homOfLE (inf_le_right : D_m r ⊓ D_m r' ≤ D_m r') ≫ f_S r' := by
      intro r r'
      let U_rr := D_m r ⊓ D_m r'
      have hU_eq : P_mS.basicOpen (t_PmS r r') = U_rr := hBasic_m r r'
      have hAff_U : AlgebraicGeometry.IsAffineOpen U_rr := by
        rw [← hU_eq]; exact (hAff_PmS r).basicOpen (t_PmS r r')
      let t_rr := t_NS (v_idx r) (v_idx r')
      let W_rr := P_NS.basicOpen t_rr
      have hW_eq : W_rr = D_N (v_idx r) ⊓ D_N (v_idx r') := hBasic_N (v_idx r) (v_idx r')
      have hAff_W : AlgebraicGeometry.IsAffineOpen W_rr := (hAff_NS (v_idx r)).basicOpen t_rr
      have hW_le_L : W_rr ≤ D_N (v_idx r) := P_NS.basicOpen_le t_rr
      have hW_le_R : W_rr ≤ D_N (v_idx r') := hW_eq.trans_le inf_le_right
      let res_mL := P_mS.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_rr ≤ D_m r)).op
      let res_mR := P_mS.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_rr ≤ D_m r')).op
      let res_NL := P_NS.presheaf.map (CategoryTheory.homOfLE hW_le_L).op
      let res_NR := P_NS.presheaf.map (CategoryTheory.homOfLE hW_le_R).op
      let _ : Algebra ↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r))))
          ↑(P_NS.presheaf.obj (Opposite.op W_rr)) := res_NL.hom.toAlgebra
      have _ : IsLocalization.Away t_rr ↑(P_NS.presheaf.obj (Opposite.op W_rr)) :=
        (hAff_NS (v_idx r)).isLocalization_basicOpen t_rr
      let g_L : ↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r)))) →+*
          ↑(P_mS.presheaf.obj (Opposite.op U_rr)) := res_mL.hom.comp (ψ_S r)
      have hinv_m : res_mR.hom (t_PmS r' r) * res_mL.hom (t_PmS r r') = 1 := by
        have h10 := hCov_tm r r' r
        rw [ht_diag_m r, map_one] at h10; exact h10
      have hUnit_gL : IsUnit (g_L t_rr) := by
        change IsUnit (res_mL.hom (ψ_S r t_rr))
        rw [hψ_t, hval_v]
        refine ⟨⟨res_mL.hom (t_PmS r r'), res_mR.hom (t_PmS r' r), ?_, hinv_m⟩, rfl⟩
        rw [mul_comm, hinv_m]
      let ψ_tilde : ↑(P_NS.presheaf.obj (Opposite.op W_rr)) →+*
          ↑(P_mS.presheaf.obj (Opposite.op U_rr)) :=
        IsLocalization.Away.lift t_rr (g := g_L) hUnit_gL
      have htilde_L : ψ_tilde.comp res_NL.hom = g_L := by
        ext x; exact IsLocalization.Away.lift_eq t_rr hUnit_gL x
      have hNL_eq : ∀ x,
          (P_NS.presheaf.map (CategoryTheory.homOfLE
            (inf_le_left : D_N (v_idx r) ⊓ D_N (v_idx r') ≤ D_N (v_idx r))).op ≫
            P_NS.presheaf.map (CategoryTheory.eqToHom hW_eq).op).hom x = res_NL.hom x := by
        intro x; rw [← P_NS.presheaf.map_comp]; rfl
      have hNR_eq : ∀ x,
          (P_NS.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : D_N (v_idx r) ⊓ D_N (v_idx r') ≤ D_N (v_idx r'))).op ≫
            P_NS.presheaf.map (CategoryTheory.eqToHom hW_eq).op).hom x = res_NR.hom x := by
        intro x; rw [← P_NS.presheaf.map_comp]; rfl
      have htilde_R : ψ_tilde.comp res_NR.hom = res_mR.hom.comp (ψ_S r') := by
        apply hRingExtCoord (c_NS (v_idx r')) (t_NS (v_idx r')) (hCl_N (v_idx r'))
        · intro s
          simp only [RingHom.comp_apply]
          have hc_step : res_NR.hom (c_NS (v_idx r') s) = res_NL.hom (c_NS (v_idx r) s) := by
            rw [← hNR_eq, ← hNL_eq, CommRingCat.hom_comp, CommRingCat.hom_comp,
              RingHom.comp_apply, RingHom.comp_apply, hCov_cN (v_idx r) (v_idx r') s]
          rw [hc_step]
          have hL_s := RingHom.congr_fun htilde_L (c_NS (v_idx r) s)
          have hψc_r : ψ_S r (c_NS (v_idx r) s) = c_PmS r s := RingHom.congr_fun (hψ_c r) s
          have hψc_r' : ψ_S r' (c_NS (v_idx r') s) = c_PmS r' s := RingHom.congr_fun (hψ_c r') s
          simp only [RingHom.comp_apply, g_L] at hL_s
          rw [hL_s, hψc_r, hψc_r', hCov_cm r r' s]
        · intro b
          simp only [RingHom.comp_apply]
          have hN10 := congrArg
            (P_NS.presheaf.map (CategoryTheory.eqToHom hW_eq).op).hom
            (hCov_tN (v_idx r) (v_idx r') b)
          rw [map_mul] at hN10
          have hN10' : res_NR.hom (t_NS (v_idx r') b) * res_NL.hom t_rr =
              res_NL.hom (t_NS (v_idx r) b) := by
            rw [← hNR_eq, ← hNL_eq, ← hNL_eq]; exact hN10
          have hmul_lhs : ψ_tilde (res_NR.hom (t_NS (v_idx r') b)) *
              res_mL.hom (t_PmS r r') = res_mL.hom (val_odd r b) := by
            have h1 := congrArg ψ_tilde hN10'
            rw [map_mul] at h1
            have h2 := RingHom.congr_fun htilde_L t_rr
            have h3 := RingHom.congr_fun htilde_L (t_NS (v_idx r) b)
            simp only [RingHom.comp_apply, g_L, t_rr, hψ_t, hval_v] at h2 h3
            rwa [h2, h3] at h1
          have hmul_rhs : res_mR.hom (ψ_S r' (t_NS (v_idx r') b)) *
              res_mL.hom (t_PmS r r') = res_mL.hom (val_odd r b) := by
            rw [hψ_t]
            dsimp only [val_odd]
            by_cases hodd : b.1 % 2 = 1
            · rw [dif_pos hodd, dif_pos hodd]
              exact hCov_tm r r' ⟨b.1 / 2, by have := b.2; omega⟩
            · rw [dif_neg hodd, dif_neg hodd, map_zero, map_zero, zero_mul]
          calc
            ψ_tilde (res_NR.hom (t_NS (v_idx r') b))
                = ψ_tilde (res_NR.hom (t_NS (v_idx r') b)) *
                    (res_mL.hom (t_PmS r r') * res_mR.hom (t_PmS r' r)) := by
                  rw [mul_comm (res_mL.hom _), hinv_m, mul_one]
            _ = (ψ_tilde (res_NR.hom (t_NS (v_idx r') b)) * res_mL.hom (t_PmS r r')) *
                  res_mR.hom (t_PmS r' r) := by ring
            _ = (res_mR.hom (ψ_S r' (t_NS (v_idx r') b)) * res_mL.hom (t_PmS r r')) *
                  res_mR.hom (t_PmS r' r) := by rw [hmul_lhs, hmul_rhs]
            _ = res_mR.hom (ψ_S r' (t_NS (v_idx r') b)) *
                  (res_mL.hom (t_PmS r r') * res_mR.hom (t_PmS r' r)) := by ring
            _ = res_mR.hom (ψ_S r' (t_NS (v_idx r') b)) := by
                  rw [mul_comm (res_mL.hom _), hinv_m, mul_one]
      have hL_eq : P_mS.homOfLE (inf_le_left : U_rr ≤ D_m r) ≫ f_S r =
          U_rr.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde) ≫
            hAff_W.fromSpec := by
        dsimp only [f_S]
        rw [← CategoryTheory.Category.assoc,
          hHomOfLE_toSpecΓ hAff_U (hAff_PmS r) inf_le_left,
          CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map res_mL),
          ← AlgebraicGeometry.Spec.map_comp]
        have hcomp_L : CommRingCat.ofHom (ψ_S r) ≫ res_mL =
            res_NL ≫ CommRingCat.ofHom ψ_tilde := by
          ext x; exact (RingHom.congr_fun htilde_L x).symm
        rw [hcomp_L, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
          (hAff_NS (v_idx r)).map_fromSpec hAff_W (CategoryTheory.homOfLE hW_le_L).op]
      have hR_eq : P_mS.homOfLE (inf_le_right : U_rr ≤ D_m r') ≫ f_S r' =
          U_rr.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_tilde) ≫
            hAff_W.fromSpec := by
        dsimp only [f_S]
        rw [← CategoryTheory.Category.assoc,
          hHomOfLE_toSpecΓ hAff_U (hAff_PmS r') inf_le_right,
          CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map res_mR),
          ← AlgebraicGeometry.Spec.map_comp]
        have hcomp_R : CommRingCat.ofHom (ψ_S r') ≫ res_mR =
            res_NR ≫ CommRingCat.ofHom ψ_tilde := by
          ext x; exact (RingHom.congr_fun htilde_R x).symm
        rw [hcomp_R, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
          (hAff_NS (v_idx r')).map_fromSpec hAff_W (CategoryTheory.homOfLE hW_le_R).op]
      exact hL_eq.trans hR_eq.symm
    let cov_m : P_mS.OpenCover :=
      P_mS.openCoverOfIsOpenCover D_m (TopologicalSpace.IsOpenCover.mk hSup_m)
    have hGlue : ∀ r r' : cov_m.I₀,
        CategoryTheory.Limits.pullback.fst (cov_m.f r) (cov_m.f r') ≫ f_S r =
          CategoryTheory.Limits.pullback.snd (cov_m.f r) (cov_m.f r') ≫ f_S r' := by
      intro (r : Fin (m + 1)) (r' : Fin (m + 1))
      change CategoryTheory.Limits.pullback.fst (D_m r).ι (D_m r').ι ≫ f_S r =
        CategoryTheory.Limits.pullback.snd (D_m r).ι (D_m r').ι ≫ f_S r'
      let U_rr := D_m r ⊓ D_m r'
      let p_pb := CategoryTheory.Limits.pullback.fst (D_m r).ι (D_m r').ι ≫ (D_m r).ι
      have hrange : Set.range p_pb.base ⊆ Set.range U_rr.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨z, rfl⟩
        refine ⟨?_, ?_⟩
        · have : p_pb.base z ∈ Set.range (D_m r).ι.base :=
            ⟨(CategoryTheory.Limits.pullback.fst (D_m r).ι (D_m r').ι).base z, rfl⟩
          rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
        · have hcond : p_pb =
              CategoryTheory.Limits.pullback.snd (D_m r).ι (D_m r').ι ≫ (D_m r').ι :=
            CategoryTheory.Limits.pullback.condition
          have : p_pb.base z ∈ Set.range (D_m r').ι.base := by
            rw [hcond]
            exact ⟨(CategoryTheory.Limits.pullback.snd (D_m r).ι (D_m r').ι).base z, rfl⟩
          rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
      let l_pb := AlgebraicGeometry.IsOpenImmersion.lift U_rr.ι p_pb hrange
      have hl_fac : l_pb ≫ U_rr.ι = p_pb :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_rr.ι p_pb hrange
      have hl_fst : CategoryTheory.Limits.pullback.fst (D_m r).ι (D_m r').ι =
          l_pb ≫ P_mS.homOfLE inf_le_left := by
        apply (cancel_mono (D_m r).ι).mp
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι, hl_fac]
      have hl_snd : CategoryTheory.Limits.pullback.snd (D_m r).ι (D_m r').ι =
          l_pb ≫ P_mS.homOfLE inf_le_right := by
        apply (cancel_mono (D_m r').ι).mp
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι, hl_fac]
        exact CategoryTheory.Limits.pullback.condition.symm
      rw [hl_fst, hl_snd, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hOverlap_inf r r']
    let ι_odd : P_mS ⟶ P_NS := cov_m.glueMorphisms f_S hGlue
    have hι_chart : ∀ r : Fin (m + 1), (D_m r).ι ≫ ι_odd = f_S r :=
      fun r => cov_m.ι_glueMorphisms f_S hGlue (r : cov_m.I₀)
    have hι_hom : ι_odd ≫ p_NS = p_mS := by
      apply cov_m.hom_ext
      intro (r : Fin (m + 1))
      change (D_m r).ι ≫ ι_odd ≫ p_NS = (D_m r).ι ≫ p_mS
      rw [← CategoryTheory.Category.assoc, hι_chart r]
      dsimp only [f_S]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← hc_hom_N (v_idx r), ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hψ_c r, hc_hom_m r,
        ← CategoryTheory.Category.assoc, (hAff_PmS r).toSpecΓ_fromSpec]
    have hMem_OPi : ∀ (r : Fin (m + 1)) (a : Fin (N + 1)) (y : P_mS),
        y ∈ D_m r →
        (y ∈ (TopologicalSpace.Opens.map ι_odd.base).obj (D_N a) ↔
          y ∈ P_mS.basicOpen (val_odd r a)) := by
      intro r a y hy
      have hy_range : y ∈ Set.range (D_m r).ι.base := by
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
      obtain ⟨y_r, rfl⟩ := hy_range
      let p_y := (D_m r).toSpecΓ.base y_r
      have hy_from : (hAff_PmS r).fromSpec.base p_y = (D_m r).ι.base y_r := by
        change ((D_m r).toSpecΓ ≫ (hAff_PmS r).fromSpec).base y_r = _
        rw [(hAff_PmS r).toSpecΓ_fromSpec]
      have hfr_in : (f_S r).base y_r ∈ D_N (v_idx r) := by
        dsimp only [f_S]
        have hopen := (hAff_NS (v_idx r)).opensRange_fromSpec
        have hmem_range : (f_S r).base y_r ∈ Set.range (hAff_NS (v_idx r)).fromSpec.base :=
          ⟨((D_m r).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_S r))).base y_r, rfl⟩
        change (f_S r).base y_r ∈ ((hAff_NS (v_idx r)).fromSpec.opensRange : Set P_NS) at hmem_range
        rwa [hopen] at hmem_range
      have hι_yr : ι_odd.base ((D_m r).ι.base y_r) = (f_S r).base y_r := by
        change ((D_m r).ι ≫ ι_odd).base y_r = _
        rw [hι_chart r]
      change ι_odd.base ((D_m r).ι.base y_r) ∈ D_N a ↔ _
      rw [hι_yr]
      have hiff1 : (f_S r).base y_r ∈ D_N a ↔
          (f_S r).base y_r ∈ P_NS.basicOpen (t_NS (v_idx r) a) := by
        rw [hBasic_N (v_idx r) a]
        exact ⟨fun ha => ⟨hfr_in, ha⟩, fun h => h.2⟩
      rw [hiff1]
      let q_y := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_S r))).base p_y
      have hfq : (f_S r).base y_r = (hAff_NS (v_idx r)).fromSpec.base q_y := rfl
      rw [hfq, ← hy_from]
      change q_y ∈ ((TopologicalSpace.Opens.map (hAff_NS (v_idx r)).fromSpec.base).obj
          (P_NS.basicOpen (t_NS (v_idx r) a))) ↔
        p_y ∈ ((TopologicalSpace.Opens.map (hAff_PmS r).fromSpec.base).obj
          (P_mS.basicOpen (val_odd r a)))
      rw [(hAff_NS (v_idx r)).fromSpec_preimage_basicOpen,
        (hAff_PmS r).fromSpec_preimage_basicOpen]
      exact (PrimeSpectrum.mem_basicOpen (t_NS (v_idx r) a) q_y).trans
        (by
          change ψ_S r (t_NS (v_idx r) a) ∉ p_y.asIdeal ↔ _
          rw [hψ_t]
          exact (PrimeSpectrum.mem_basicOpen (val_odd r a) p_y).symm)
    have hPres_odd : ∀ a : Fin (N + 1),
        let g_Pi_S : Fin (m + 2) → ↑(P_NS.presheaf.obj (Opposite.op (D_N a))) :=
          fun ν => Fin.lastCases (t_NS a w_idx) (fun j => t_NS a (u_idx j)) ν
        let O_Pi : P_mS.Opens := (TopologicalSpace.Opens.map ι_odd.base).obj (D_N a)
        ∃ e_Pi : O_Pi.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NS.presheaf.obj (Opposite.op (D_N a))) ⧸ Ideal.span (Set.range g_Pi_S))),
          O_Pi.ι ≫ ι_odd =
            e_Pi.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
              (hAff_NS a).fromSpec := by
      intro a
      by_cases hodd : a.1 % 2 = 1
      · let r_a : Fin (m + 1) := ⟨a.1 / 2, by have := a.2; omega⟩
        have ha_eq : a = v_idx r_a := by ext; dsimp [v_idx, r_a]; omega
        rw [ha_eq]
        dsimp only
        let g_Pi_S : Fin (m + 2) → ↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r_a)))) :=
          fun ν => Fin.lastCases (t_NS (v_idx r_a) w_idx) (fun j => t_NS (v_idx r_a) (u_idx j)) ν
        let O_Pi : P_mS.Opens := (TopologicalSpace.Opens.map ι_odd.base).obj (D_N (v_idx r_a))
        let I_Pi : Ideal ↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r_a)))) :=
          Ideal.span (Set.range g_Pi_S)
        have heq_O : O_Pi = D_m r_a := by
          ext y
          have htop : y ∈ (⊤ : P_mS.Opens) := trivial
          rw [← hSup_m, TopologicalSpace.Opens.mem_iSup] at htop
          obtain ⟨r, hr⟩ := htop
          change y ∈ (TopologicalSpace.Opens.map ι_odd.base).obj (D_N (v_idx r_a)) ↔ y ∈ D_m r_a
          rw [hMem_OPi r (v_idx r_a) y hr, hval_v r r_a, hBasic_m r r_a]
          exact ⟨fun h => h.2, fun hra => ⟨hr, hra⟩⟩
        have hker_Pi : ∀ x ∈ I_Pi, ψ_S r_a x = 0 := by
          intro x hx
          have hle : I_Pi ≤ RingHom.ker (ψ_S r_a) := by
            rw [Ideal.span_le]
            rintro _ ⟨ν, rfl⟩
            rw [SetLike.mem_coe, RingHom.mem_ker]
            refine Fin.lastCases ?_ (fun j => ?_) ν
            · dsimp only [g_Pi_S]
              rw [Fin.lastCases_last, hψ_t]
              dsimp only [val_odd]
              have : ¬ w_idx.1 % 2 = 1 := by change ¬ (2 * m + 2) % 2 = 1; omega
              rw [dif_neg this]
            · dsimp only [g_Pi_S]
              rw [Fin.lastCases_castSucc, hψ_t]
              dsimp only [val_odd, u_idx]
              have : ¬ (2 * j.1) % 2 = 1 := by omega
              rw [dif_neg this]
          exact hle hx
        let α_r : (↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r_a)))) ⧸ I_Pi) →+*
            ↑(P_mS.presheaf.obj (Opposite.op (D_m r_a))) :=
          Ideal.Quotient.lift I_Pi (ψ_S r_a) hker_Pi
        let ξ0_r : MvPolynomial (Fin m) S →+*
            (↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r_a)))) ⧸ I_Pi) :=
          MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_Pi).comp (c_NS (v_idx r_a)))
            (fun μ : Fin m => Ideal.Quotient.mk I_Pi (t_NS (v_idx r_a) (v_idx (r_a.succAbove μ))))
        let ξ_r : ↑(P_mS.presheaf.obj (Opposite.op (D_m r_a))) →+*
            (↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r_a)))) ⧸ I_Pi) :=
          ξ0_r.comp (θ_PmS r_a).symm.toRingHom
        have hαξ0 : α_r.comp ξ0_r = (θ_PmS r_a).toRingHom := by
          apply MvPolynomial.ringHom_ext
          · intro s
            simp only [RingHom.comp_apply, ξ0_r, MvPolynomial.eval₂Hom_C]
            change ψ_S r_a (c_NS (v_idx r_a) s) = θ_PmS r_a (MvPolynomial.C s)
            have h1 : ψ_S r_a (c_NS (v_idx r_a) s) = c_PmS r_a s :=
              RingHom.congr_fun (hψ_c r_a) s
            have h2 : θ_PmS r_a (MvPolynomial.C s) = c_PmS r_a s :=
              RingHom.congr_fun (hθ_PmS r_a).1 s
            rw [h1, h2]
          · intro μ
            simp only [RingHom.comp_apply, ξ0_r, MvPolynomial.eval₂Hom_X']
            change ψ_S r_a (t_NS (v_idx r_a) (v_idx (r_a.succAbove μ))) =
              θ_PmS r_a (MvPolynomial.X μ)
            rw [hψ_t, hval_v, (hθ_PmS r_a).2 μ]
        have hαξ : α_r.comp ξ_r = RingHom.id _ := by
          ext x
          change α_r (ξ0_r ((θ_PmS r_a).symm x)) = x
          have hx : α_r (ξ0_r ((θ_PmS r_a).symm x)) = θ_PmS r_a ((θ_PmS r_a).symm x) :=
            RingHom.congr_fun hαξ0 ((θ_PmS r_a).symm x)
          rw [hx, (θ_PmS r_a).apply_symm_apply]
        have hξα : ξ_r.comp α_r = RingHom.id _ := by
          apply Ideal.Quotient.ringHom_ext
          apply hRingExtCoord (c_NS (v_idx r_a)) (t_NS (v_idx r_a)) (hCl_N (v_idx r_a))
          · intro s
            simp only [RingHom.comp_apply, RingHom.id_apply]
            change ξ_r (ψ_S r_a (c_NS (v_idx r_a) s)) = _
            have h1 : ψ_S r_a (c_NS (v_idx r_a) s) = c_PmS r_a s :=
              RingHom.congr_fun (hψ_c r_a) s
            have h2 : θ_PmS r_a (MvPolynomial.C s) = c_PmS r_a s :=
              RingHom.congr_fun (hθ_PmS r_a).1 s
            rw [h1, ← h2]
            change ξ0_r ((θ_PmS r_a).symm (θ_PmS r_a (MvPolynomial.C s))) = _
            rw [(θ_PmS r_a).symm_apply_apply]; simp [ξ0_r]
          · intro b
            simp only [RingHom.comp_apply, RingHom.id_apply]
            change ξ_r (ψ_S r_a (t_NS (v_idx r_a) b)) = Ideal.Quotient.mk I_Pi (t_NS (v_idx r_a) b)
            rw [hψ_t]
            dsimp only [val_odd]
            by_cases hb_odd : b.1 % 2 = 1
            · rw [dif_pos hb_odd]
              let j : Fin (m + 1) := ⟨b.1 / 2, by have := b.2; omega⟩
              have hb_eq : b = v_idx j := by ext; dsimp [v_idx, j]; omega
              change ξ_r (t_PmS r_a j) = Ideal.Quotient.mk I_Pi (t_NS (v_idx r_a) b)
              rw [hb_eq]
              by_cases hjr : j = r_a
              · rw [hjr, ht_diag_m, map_one, ht_diag_N, map_one]
              · obtain ⟨μ, hμ⟩ := Fin.exists_succAbove_eq hjr
                rw [← hμ, ← (hθ_PmS r_a).2 μ]
                change ξ0_r ((θ_PmS r_a).symm (θ_PmS r_a (MvPolynomial.X μ))) = _
                rw [(θ_PmS r_a).symm_apply_apply]; simp [ξ0_r]
            · rw [dif_neg hb_odd, map_zero]
              symm
              rw [Ideal.Quotient.eq_zero_iff_mem]
              apply Ideal.subset_span
              by_cases hb_last : b.1 = N
              · refine ⟨Fin.last (m + 1), ?_⟩
                dsimp only [g_Pi_S]; rw [Fin.lastCases_last]; congr 1
                exact Fin.ext hb_last.symm
              · have hb_lt : b.1 < N := by have := b.2; omega
                let j : Fin (m + 1) := ⟨b.1 / 2, by omega⟩
                refine ⟨j.castSucc, ?_⟩
                dsimp only [g_Pi_S]; rw [Fin.lastCases_castSucc]; congr 1
                ext; dsimp [u_idx, j]; omega
        let specIso : AlgebraicGeometry.Spec (P_mS.presheaf.obj (Opposite.op (D_m r_a))) ≅
            AlgebraicGeometry.Spec (CommRingCat.of
              (↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r_a)))) ⧸ I_Pi)) :=
          { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_r)
            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ξ_r)
            hom_inv_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hαξ]
              exact AlgebraicGeometry.Spec.map_id _
            inv_hom_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hξα]
              exact AlgebraicGeometry.Spec.map_id _ }
        let e_Pi : O_Pi.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NS.presheaf.obj (Opposite.op (D_N (v_idx r_a)))) ⧸ I_Pi)) :=
          (P_mS.isoOfEq heq_O).trans ((hAff_PmS r_a).isoSpec.trans specIso)
        exact ⟨e_Pi, by
          dsimp only [e_Pi, Iso.trans_hom, specIso]
          rw [(hAff_PmS r_a).isoSpec_hom, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_r)),
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hlift : α_r.comp (Ideal.Quotient.mk I_Pi) = ψ_S r_a := rfl
          rw [hlift]
          change O_Pi.ι ≫ ι_odd = (P_mS.isoOfEq heq_O).hom ≫ f_S r_a
          rw [← hι_chart r_a, ← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.isoOfEq_hom_ι]⟩
      · dsimp only
        let g_Pi_S : Fin (m + 2) → ↑(P_NS.presheaf.obj (Opposite.op (D_N a))) :=
          fun ν => Fin.lastCases (t_NS a w_idx) (fun j => t_NS a (u_idx j)) ν
        let O_Pi : P_mS.Opens := (TopologicalSpace.Opens.map ι_odd.base).obj (D_N a)
        let I_Pi : Ideal ↑(P_NS.presheaf.obj (Opposite.op (D_N a))) :=
          Ideal.span (Set.range g_Pi_S)
        have hEmpty_OPi : IsEmpty ↥O_Pi.toScheme := by
          refine ⟨fun z_o => ?_⟩
          let y := O_Pi.ι.base z_o
          have hy_OPi : y ∈ O_Pi := by
            have : y ∈ Set.range O_Pi.ι.base := ⟨z_o, rfl⟩
            rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
          have htop : y ∈ (⊤ : P_mS.Opens) := trivial
          rw [← hSup_m, TopologicalSpace.Opens.mem_iSup] at htop
          obtain ⟨r, hr⟩ := htop
          have hy_basic := (hMem_OPi r a y hr).mp hy_OPi
          have hval0 : val_odd r a = 0 := by dsimp only [val_odd]; exact dif_neg hodd
          rw [hval0] at hy_basic
          have hy_range : y ∈ Set.range (D_m r).ι.base := by
            rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
          obtain ⟨y_r, hyr⟩ := hy_range
          let p_y := (D_m r).toSpecΓ.base y_r
          have hfrom : (hAff_PmS r).fromSpec.base p_y = y := by
            rw [← hyr]
            change ((D_m r).toSpecΓ ≫ (hAff_PmS r).fromSpec).base y_r = _
            rw [(hAff_PmS r).toSpecΓ_fromSpec]
          rw [← hfrom] at hy_basic
          have hp_basic : p_y ∈ PrimeSpectrum.basicOpen (0 : ↑(P_mS.presheaf.obj (Opposite.op (D_m r)))) := by
            rw [← (hAff_PmS r).fromSpec_preimage_basicOpen 0]; exact hy_basic
          exact (PrimeSpectrum.mem_basicOpen 0 p_y).mp hp_basic p_y.asIdeal.zero_mem
        have hone_mem : (1 : ↑(P_NS.presheaf.obj (Opposite.op (D_N a)))) ∈ I_Pi := by
          rw [← ht_diag_N a]
          apply Ideal.subset_span
          by_cases ha_last : a.1 = N
          · refine ⟨Fin.last (m + 1), ?_⟩
            dsimp only [g_Pi_S]; rw [Fin.lastCases_last]; congr 1
            exact Fin.ext ha_last.symm
          · have ha_lt : a.1 < N := by have := a.2; omega
            let j : Fin (m + 1) := ⟨a.1 / 2, by omega⟩
            refine ⟨j.castSucc, ?_⟩
            dsimp only [g_Pi_S]; rw [Fin.lastCases_castSucc]; congr 1
            ext; dsimp [u_idx, j]; omega
        have _ : Subsingleton (↑(P_NS.presheaf.obj (Opposite.op (D_N a))) ⧸ I_Pi) :=
          Ideal.Quotient.subsingleton_iff.mpr ((Ideal.eq_top_iff_one I_Pi).mpr hone_mem)
        have hEmpty_Spec : IsEmpty ↥(AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NS.presheaf.obj (Opposite.op (D_N a))) ⧸ I_Pi))) := by
          change IsEmpty (PrimeSpectrum (↑(P_NS.presheaf.obj (Opposite.op (D_N a))) ⧸ I_Pi))
          exact PrimeSpectrum.isEmpty_iff_subsingleton.mpr inferInstance
        let hInit1 := @AlgebraicGeometry.isInitialOfIsEmpty O_Pi.toScheme hEmpty_OPi
        let hInit2 := @AlgebraicGeometry.isInitialOfIsEmpty _ hEmpty_Spec
        exact ⟨hInit1.uniqueUpToIso hInit2, hInit1.hom_ext _ _⟩
    have hCl_odd : AlgebraicGeometry.IsClosedImmersion ι_odd := by
      apply (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) D_N hSup_N).mpr
      intro a
      obtain ⟨e_Pi, he_Pi⟩ := hPres_odd a
      have hpb := AlgebraicGeometry.isPullback_morphismRestrict ι_odd (D_N a)
      let I_a : Ideal ↑(P_NS.presheaf.obj (Opposite.op (D_N a))) :=
        Ideal.span (Set.range (fun ν : Fin (m + 2) =>
          Fin.lastCases (t_NS a w_idx) (fun j => t_NS a (u_idx j)) ν))
      have hres_eq : (ι_odd ∣_ D_N a) =
          e_Pi.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_a)) ≫
            (hAff_NS a).isoSpec.inv := by
        apply (cancel_mono (D_N a).ι).mp
        rw [hpb.w, he_Pi, ← hFromSpecEq (hAff_NS a)]
        simp only [CategoryTheory.Category.assoc]
      rw [hres_eq]
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_a))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_quotient_mk I_a
      infer_instance
    exact ⟨ι_odd, ψ_S, fun r => ⟨hψ_c r, hψ_t r, hι_chart r⟩, hCl_odd, hι_hom, hPres_odd⟩

  have hSubFacAbs : ∀ {P_NR P_mR Z : AlgebraicGeometry.Scheme.{u}}
      {D_NR : Fin (N + 1) → P_NR.Opens}
      (hSup_NR : (⨆ a : Fin (N + 1), D_NR a) = ⊤)
      (hAff_NR : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_NR a))
      (ι_odd_R : P_mR ⟶ P_NR)
      [AlgebraicGeometry.IsClosedImmersion ι_odd_R]
      (ι_Z : Z ⟶ P_NR)
      [AlgebraicGeometry.IsClosedImmersion ι_Z]
      {I_Pi I_Z : ∀ a : Fin (N + 1), Ideal ↑(P_NR.presheaf.obj (Opposite.op (D_NR a)))}
      (hPres_R : ∀ a : Fin (N + 1),
        let O_Pi : P_mR.Opens := (TopologicalSpace.Opens.map ι_odd_R.base).obj (D_NR a)
        ∃ e_Pi : O_Pi.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NR.presheaf.obj (Opposite.op (D_NR a))) ⧸ I_Pi a)),
          O_Pi.ι ≫ ι_odd_R =
            e_Pi.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Pi a))) ≫
              (hAff_NR a).fromSpec)
      (hPres_Z : ∀ a : Fin (N + 1),
        let O_a : Z.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (D_NR a)
        ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NR.presheaf.obj (Opposite.op (D_NR a))) ⧸ I_Z a)),
          O_a.ι ≫ ι_Z =
            e_a.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Z a))) ≫
              (hAff_NR a).fromSpec)
      (hle_I : ∀ a : Fin (N + 1), I_Z a ≤ I_Pi a),
      ∃ j_sub : P_mR ⟶ Z,
        AlgebraicGeometry.IsClosedImmersion j_sub ∧ j_sub ≫ ι_Z = ι_odd_R := by
    intro P_NR P_mR Z D_NR hSup_NR hAff_NR ι_odd_R _ ι_Z _ I_Pi I_Z hPres_R hPres_Z hle_I
    let O_Pi : Fin (N + 1) → P_mR.Opens :=
      fun a => (TopologicalSpace.Opens.map ι_odd_R.base).obj (D_NR a)
    have hSup_OPi : (⨆ a : Fin (N + 1), O_Pi a) = ⊤ := by
      ext y; constructor
      · intro _; exact trivial
      · intro _
        have htop : ι_odd_R.base y ∈ (⊤ : P_NR.Opens) := trivial
        rw [← hSup_NR, TopologicalSpace.Opens.mem_iSup] at htop
        exact TopologicalSpace.Opens.mem_iSup.mpr htop
    choose e_Pi he_Pi using hPres_R
    choose e_Z he_Z using hPres_Z
    let O_Z : Fin (N + 1) → Z.Opens :=
      fun a => (TopologicalSpace.Opens.map ι_Z.base).obj (D_NR a)
    let j_loc : ∀ a : Fin (N + 1), (O_Pi a).toScheme ⟶ Z := fun a =>
      (e_Pi a).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (hle_I a))) ≫
        (e_Z a).inv ≫
        (O_Z a).ι
    have hj_loc_fac : ∀ a : Fin (N + 1), j_loc a ≫ ι_Z = (O_Pi a).ι ≫ ι_odd_R := by
      intro a
      dsimp only [j_loc, O_Z]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, he_Z a, CategoryTheory.Iso.inv_hom_id_assoc,
        ← CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor (hle_I a)))),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hfac_mk : (Ideal.Quotient.factor (hle_I a)).comp (Ideal.Quotient.mk (I_Z a)) =
          Ideal.Quotient.mk (I_Pi a) := by
        ext x; exact Ideal.Quotient.factor_mk (hle_I a) x
      rw [hfac_mk, ← he_Pi a]
    let cov_Pi : P_mR.OpenCover :=
      P_mR.openCoverOfIsOpenCover O_Pi (TopologicalSpace.IsOpenCover.mk hSup_OPi)
    have hGlue_j : ∀ a a' : cov_Pi.I₀,
        CategoryTheory.Limits.pullback.fst (cov_Pi.f a) (cov_Pi.f a') ≫ j_loc a =
          CategoryTheory.Limits.pullback.snd (cov_Pi.f a) (cov_Pi.f a') ≫ j_loc a' := by
      intro (a : Fin (N + 1)) (a' : Fin (N + 1))
      apply (cancel_mono ι_Z).mp
      change (CategoryTheory.Limits.pullback.fst (O_Pi a).ι (O_Pi a').ι ≫ j_loc a) ≫ ι_Z =
        (CategoryTheory.Limits.pullback.snd (O_Pi a).ι (O_Pi a').ι ≫ j_loc a') ≫ ι_Z
      rw [CategoryTheory.Category.assoc, hj_loc_fac a, CategoryTheory.Category.assoc,
        hj_loc_fac a', ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition]
    let j_sub : P_mR ⟶ Z := cov_Pi.glueMorphisms j_loc hGlue_j
    have hj_sub_fac : j_sub ≫ ι_Z = ι_odd_R := by
      apply cov_Pi.hom_ext
      intro (a : Fin (N + 1))
      have hι_j : (O_Pi a).ι ≫ j_sub = j_loc a :=
        cov_Pi.ι_glueMorphisms j_loc hGlue_j (a : cov_Pi.I₀)
      change (O_Pi a).ι ≫ j_sub ≫ ι_Z = (O_Pi a).ι ≫ ι_odd_R
      rw [← CategoryTheory.Category.assoc, hι_j, hj_loc_fac a]
    have hCl_jsub : AlgebraicGeometry.IsClosedImmersion j_sub := by
      rw [← AlgebraicGeometry.IsClosedImmersion.comp_iff (g := ι_Z), hj_sub_fac]
      infer_instance
    exact ⟨j_sub, hCl_jsub, hj_sub_fac⟩

  have hBCCompAbs : ∀ {R K : Type u} [CommRing R] [CommRing K] (φ_RK : R →+* K)
      {P_NR P_mR P_NK P_mK : AlgebraicGeometry.Scheme.{u}}
      {D_NR : Fin (N + 1) → P_NR.Opens} {D_mR : Fin (m + 1) → P_mR.Opens}
      {D_NK : Fin (N + 1) → P_NK.Opens} {D_mK : Fin (m + 1) → P_mK.Opens}
      (hSup_mK : (⨆ r : Fin (m + 1), D_mK r) = ⊤)
      (hAff_NR : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_NR a))
      (hAff_PmR : ∀ r : Fin (m + 1), AlgebraicGeometry.IsAffineOpen (D_mR r))
      (hAff_NK : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_NK a))
      (c_NR : ∀ a : Fin (N + 1), R →+* ↑(P_NR.presheaf.obj (Opposite.op (D_NR a))))
      (t_NR : ∀ a : Fin (N + 1), Fin (N + 1) → ↑(P_NR.presheaf.obj (Opposite.op (D_NR a))))
      (c_PmR : ∀ r : Fin (m + 1), R →+* ↑(P_mR.presheaf.obj (Opposite.op (D_mR r))))
      (t_PmR : ∀ r : Fin (m + 1), Fin (m + 1) → ↑(P_mR.presheaf.obj (Opposite.op (D_mR r))))
      (c_NK : ∀ a : Fin (N + 1), K →+* ↑(P_NK.presheaf.obj (Opposite.op (D_NK a))))
      (t_NK : ∀ a : Fin (N + 1), Fin (N + 1) → ↑(P_NK.presheaf.obj (Opposite.op (D_NK a))))
      (c_PmK : ∀ r : Fin (m + 1), K →+* ↑(P_mK.presheaf.obj (Opposite.op (D_mK r))))
      (t_PmK : ∀ r : Fin (m + 1), Fin (m + 1) → ↑(P_mK.presheaf.obj (Opposite.op (D_mK r))))
      (hCl_NR : ∀ a : Fin (N + 1), Subring.closure (Set.range (c_NR a) ∪ Set.range (t_NR a)) = ⊤)
      (ι_odd_R : P_mR ⟶ P_NR) (ι_odd_K : P_mK ⟶ P_NK)
      (ψ_R : ∀ r : Fin (m + 1),
        ↑(P_NR.presheaf.obj (Opposite.op (D_NR (v_idx r)))) →+*
        ↑(P_mR.presheaf.obj (Opposite.op (D_mR r))))
      (ψ_K : ∀ r : Fin (m + 1),
        ↑(P_NK.presheaf.obj (Opposite.op (D_NK (v_idx r)))) →+*
        ↑(P_mK.presheaf.obj (Opposite.op (D_mK r))))
      (hψ_R : ∀ r : Fin (m + 1),
        (ψ_R r).comp (c_NR (v_idx r)) = c_PmR r ∧
        (∀ b : Fin (N + 1),
          ψ_R r (t_NR (v_idx r) b) =
            if h_odd : b.1 % 2 = 1 then t_PmR r ⟨b.1 / 2, by have := b.2; omega⟩ else 0) ∧
        (D_mR r).ι ≫ ι_odd_R =
          (D_mR r).toSpecΓ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_R r)) ≫
            (hAff_NR (v_idx r)).fromSpec)
      (hψ_K : ∀ r : Fin (m + 1),
        (ψ_K r).comp (c_NK (v_idx r)) = c_PmK r ∧
        (∀ b : Fin (N + 1),
          ψ_K r (t_NK (v_idx r) b) =
            if h_odd : b.1 % 2 = 1 then t_PmK r ⟨b.1 / 2, by have := b.2; omega⟩ else 0) ∧
        (D_mK r).ι ≫ ι_odd_K =
          (D_mK r).toSpecΓ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_K r)) ≫
            (hAff_NK (v_idx r)).fromSpec)
      (Φ_N : P_NK ⟶ P_NR) (Φ_m : P_mK ⟶ P_mR)
      (hBC_N_charts : ∀ a : Fin (N + 1),
        ∃ heq : (TopologicalSpace.Opens.map Φ_N.base).obj (D_NR a) = D_NK a,
          (∀ x : R,
            (Φ_N.app (D_NR a) ≫ P_NK.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
              (c_NR a x) = c_NK a (φ_RK x)) ∧
          (∀ b : Fin (N + 1),
            (Φ_N.app (D_NR a) ≫ P_NK.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
              (t_NR a b) = t_NK a b))
      (hBC_m_charts : ∀ r : Fin (m + 1),
        ∃ heq : (TopologicalSpace.Opens.map Φ_m.base).obj (D_mR r) = D_mK r,
          (∀ x : R,
            (Φ_m.app (D_mR r) ≫ P_mK.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
              (c_PmR r x) = c_PmK r (φ_RK x)) ∧
          (∀ j : Fin (m + 1),
            (Φ_m.app (D_mR r) ≫ P_mK.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
              (t_PmR r j) = t_PmK r j)),
      ι_odd_K ≫ Φ_N = Φ_m ≫ ι_odd_R := by
    intro R K _ _ φ_RK P_NR P_mR P_NK P_mK D_NR D_mR D_NK D_mK hSup_mK
      hAff_NR hAff_PmR hAff_NK c_NR t_NR c_PmR t_PmR c_NK t_NK c_PmK t_PmK hCl_NR
      ι_odd_R ι_odd_K ψ_R ψ_K hψ_R hψ_K Φ_N Φ_m hBC_N_charts hBC_m_charts
    let cov_mK : P_mK.OpenCover :=
      P_mK.openCoverOfIsOpenCover D_mK (TopologicalSpace.IsOpenCover.mk hSup_mK)
    apply cov_mK.hom_ext
    intro (r : Fin (m + 1))
    change (D_mK r).ι ≫ ι_odd_K ≫ Φ_N = (D_mK r).ι ≫ Φ_m ≫ ι_odd_R
    obtain ⟨heq_N, hBC_Nc, hBC_Nt⟩ := hBC_N_charts (v_idx r)
    obtain ⟨heq_m, hBC_mc, hBC_mt⟩ := hBC_m_charts r
    have hle_N : D_NK (v_idx r) ≤ (TopologicalSpace.Opens.map Φ_N.base).obj (D_NR (v_idx r)) :=
      le_of_eq heq_N.symm
    have hle_m : D_mK r ≤ (TopologicalSpace.Opens.map Φ_m.base).obj (D_mR r) :=
      le_of_eq heq_m.symm
    have hfrom_ΦN : (hAff_NK (v_idx r)).fromSpec ≫ Φ_N =
        AlgebraicGeometry.Spec.map (Φ_N.appLE (D_NR (v_idx r)) (D_NK (v_idx r)) hle_N) ≫
          (hAff_NR (v_idx r)).fromSpec := by
      have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE Φ_N
        (D_NR (v_idx r)) (D_NK (v_idx r)) hle_N
      calc
        (hAff_NK (v_idx r)).fromSpec ≫ Φ_N
            = (hAff_NK (v_idx r)).isoSpec.inv ≫ ((D_NK (v_idx r)).ι ≫ Φ_N) := by
              rw [← hFromSpecEq (hAff_NK (v_idx r)), CategoryTheory.Category.assoc]
        _ = (hAff_NK (v_idx r)).isoSpec.inv ≫
              (Φ_N.resLE (D_NR (v_idx r)) (D_NK (v_idx r)) hle_N ≫ (D_NR (v_idx r)).ι) :=
              congrArg ((hAff_NK (v_idx r)).isoSpec.inv ≫ ·)
                (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι Φ_N hle_N).symm
        _ = (hAff_NK (v_idx r)).isoSpec.inv ≫
              (Φ_N.resLE (D_NR (v_idx r)) (D_NK (v_idx r)) hle_N ≫ (D_NR (v_idx r)).toSpecΓ) ≫
              (hAff_NR (v_idx r)).fromSpec := by
              rw [CategoryTheory.Category.assoc (Φ_N.resLE _ _ _),
                (hAff_NR (v_idx r)).toSpecΓ_fromSpec]
        _ = (hAff_NK (v_idx r)).isoSpec.inv ≫
              ((D_NK (v_idx r)).toSpecΓ ≫
                AlgebraicGeometry.Spec.map (Φ_N.appLE (D_NR (v_idx r)) (D_NK (v_idx r)) hle_N)) ≫
              (hAff_NR (v_idx r)).fromSpec :=
              congrArg (fun u => (hAff_NK (v_idx r)).isoSpec.inv ≫ u ≫
                (hAff_NR (v_idx r)).fromSpec) h1.symm
        _ = AlgebraicGeometry.Spec.map (Φ_N.appLE (D_NR (v_idx r)) (D_NK (v_idx r)) hle_N) ≫
              (hAff_NR (v_idx r)).fromSpec := by
              rw [← CategoryTheory.Category.assoc (hAff_NK (v_idx r)).isoSpec.inv,
                ← CategoryTheory.Category.assoc (hAff_NK (v_idx r)).isoSpec.inv,
                ← (hAff_NK (v_idx r)).isoSpec_hom, CategoryTheory.Iso.inv_hom_id,
                CategoryTheory.Category.id_comp]
    have hι_Φm : (D_mK r).ι ≫ Φ_m =
        (D_mK r).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (Φ_m.appLE (D_mR r) (D_mK r) hle_m) ≫
          (hAff_PmR r).fromSpec := by
      calc
        (D_mK r).ι ≫ Φ_m
            = Φ_m.resLE (D_mR r) (D_mK r) hle_m ≫ (D_mR r).ι :=
              (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι Φ_m hle_m).symm
        _ = (Φ_m.resLE (D_mR r) (D_mK r) hle_m ≫ (D_mR r).toSpecΓ) ≫
              (hAff_PmR r).fromSpec := by
              rw [CategoryTheory.Category.assoc, (hAff_PmR r).toSpecΓ_fromSpec]
        _ = ((D_mK r).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (Φ_m.appLE (D_mR r) (D_mK r) hle_m)) ≫
              (hAff_PmR r).fromSpec :=
              congrArg (· ≫ (hAff_PmR r).fromSpec)
                (AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE Φ_m (D_mR r) (D_mK r) hle_m).symm
        _ = (D_mK r).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (Φ_m.appLE (D_mR r) (D_mK r) hle_m) ≫
              (hAff_PmR r).fromSpec := by
              rw [CategoryTheory.Category.assoc]
    have hfrom_ιR : (hAff_PmR r).fromSpec ≫ ι_odd_R =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_R r)) ≫
          (hAff_NR (v_idx r)).fromSpec := by
      rw [← hFromSpecEq (hAff_PmR r), CategoryTheory.Category.assoc, (hψ_R r).2.2,
        ← (hAff_PmR r).isoSpec_hom, CategoryTheory.Iso.inv_hom_id_assoc]
    have hLHS : (D_mK r).ι ≫ ι_odd_K ≫ Φ_N =
        (D_mK r).toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            (Φ_N.appLE (D_NR (v_idx r)) (D_NK (v_idx r)) hle_N ≫
              CommRingCat.ofHom (ψ_K r)) ≫
          (hAff_NR (v_idx r)).fromSpec := by
      rw [← CategoryTheory.Category.assoc, (hψ_K r).2.2, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hfrom_ΦN, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc]
    have hRHS : (D_mK r).ι ≫ Φ_m ≫ ι_odd_R =
        (D_mK r).toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ_R r) ≫ Φ_m.appLE (D_mR r) (D_mK r) hle_m) ≫
          (hAff_NR (v_idx r)).fromSpec := by
      rw [← CategoryTheory.Category.assoc, hι_Φm, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hfrom_ιR, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc]
    rw [hLHS, hRHS]
    congr 2; congr 1
    apply CommRingCat.hom_ext
    apply hRingExtCoord (c_NR (v_idx r)) (t_NR (v_idx r)) (hCl_NR (v_idx r))
    · intro x
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply]
      change ψ_K r ((Φ_N.app (D_NR (v_idx r)) ≫
          P_NK.presheaf.map (CategoryTheory.eqToHom heq_N.symm).op).hom (c_NR (v_idx r) x)) =
        (Φ_m.app (D_mR r) ≫ P_mK.presheaf.map (CategoryTheory.eqToHom heq_m.symm).op).hom
          (ψ_R r (c_NR (v_idx r) x))
      have hK_x : ψ_K r (c_NK (v_idx r) (φ_RK x)) = c_PmK r (φ_RK x) :=
        RingHom.congr_fun (hψ_K r).1 (φ_RK x)
      have hR_x : ψ_R r (c_NR (v_idx r) x) = c_PmR r x :=
        RingHom.congr_fun (hψ_R r).1 x
      rw [hBC_Nc x, hK_x, hR_x, hBC_mc x]
    · intro b
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply]
      change ψ_K r ((Φ_N.app (D_NR (v_idx r)) ≫
          P_NK.presheaf.map (CategoryTheory.eqToHom heq_N.symm).op).hom (t_NR (v_idx r) b)) =
        (Φ_m.app (D_mR r) ≫ P_mK.presheaf.map (CategoryTheory.eqToHom heq_m.symm).op).hom
          (ψ_R r (t_NR (v_idx r) b))
      rw [hBC_Nt b, (hψ_K r).2.1 b, (hψ_R r).2.1 b]
      by_cases hb_odd : b.1 % 2 = 1
      · rw [dif_pos hb_odd, dif_pos hb_odd, hBC_mt ⟨b.1 / 2, by have := b.2; omega⟩]
      · rw [dif_neg hb_odd, dif_neg hb_odd, map_zero]

  
  have hProp_PN : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R₀ N).hom := hCoord_R0.1
  have hProp_gQ : AlgebraicGeometry.IsProper g_Q.left := by
    change AlgebraicGeometry.IsProper (ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom)
    infer_instance

  obtain ⟨hS3_sm, hS3_aff⟩ :=
    @hS3_abs (weilProjectiveSpaceOver R₀ N).left (weilProjectiveSpaceOver R₀ N).hom
      (weilProjBasicOpen R₀ N) hAff_R0 c_R0 t_R0
      hCoord_R0.2.1 hCoord_R0.2.2.1 hCoord_R0.2.2.2.2.2.2.2.1 ι_Q
      (fun a => Ideal.span (Set.range (g_Q0 a))) hPres_Q

  obtain ⟨Θ_w, hΘ_w_C, hΘ_w_X0, hΘ_w_X1⟩ := hS2_vertex
  obtain ⟨ι_affQ, hOpen_affQ, hι_affQ_hom, hAvoid⟩ :=
    hS3_aff w_idx (MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ I_cone0)
      ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C) Θ_w hΘ_w_C
  obtain ⟨ε₀, hε₀_C, hε₀_X, hε₀_uniq⟩ := hS2_origin
  let o₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ C_Q :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀)

  obtain ⟨ι_odd_R0, ψ_R0, hψ_R0, hCl_R0, hHom_R0, hPres_R0⟩ :=
    hMkOddAbs R₀ (weilProjectiveSpaceOver R₀ N).left (weilProjectiveSpaceOver R₀ m).left
      (weilProjectiveSpaceOver R₀ N).hom (weilProjectiveSpaceOver R₀ m).hom
      (weilProjBasicOpen R₀ N) (weilProjBasicOpen R₀ m)
      hAff_R0 c_R0 t_R0 hAff_PmR0 c_PmR0 t_PmR0 θ_PmR0
      hCoord_R0.2.1 hCoord_R0.2.2.1 hCoord_R0.2.2.2.2.1 hCoord_R0.2.2.2.2.2.1
      hCoord_R0.2.2.2.2.2.2.1 hCoord_R0.2.2.2.2.2.2.2.1 hCoord_R0.2.2.2.2.2.2.2.2.1
      hCoord_R0.2.2.2.2.2.2.2.2.2
      hCoord_PmR0.2.1 hCoord_PmR0.2.2.1 hCoord_PmR0.2.2.2.2.1 hCoord_PmR0.2.2.2.2.2.2.2.1
      hCoord_PmR0.2.2.2.2.2.2.2.2.1 hCoord_PmR0.2.2.2.2.2.2.2.2.2
      hθ_PmR0

  have hle_Q : ∀ a : Fin (N + 1),
      Ideal.span (Set.range (g_Q0 a)) ≤
        Ideal.span (Set.range (fun ν : Fin (m + 2) =>
          Fin.lastCases (t_R0 a w_idx) (fun j => t_R0 a (u_idx j)) ν)) := by
    intro a
    let g_Pi_a : Fin (m + 2) →
        ↑((weilProjectiveSpaceOver R₀ N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R₀ N a))) :=
      fun ν => Fin.lastCases (t_R0 a w_idx) (fun j => t_R0 a (u_idx j)) ν
    let I_Pi_a := Ideal.span (Set.range g_Pi_a)
    rw [Ideal.span_le]
    rintro _ ⟨_, rfl⟩
    rw [SetLike.mem_coe]
    dsimp only [g_Q0]
    refine I_Pi_a.sub_mem ?_ ?_
    · refine Ideal.sum_mem I_Pi_a fun j _ => ?_
      refine I_Pi_a.mul_mem_right _ (Ideal.subset_span ⟨j.castSucc, ?_⟩)
      dsimp only [g_Pi_a]; rw [Fin.lastCases_castSucc]
    · have hsq : c_R0 a Polynomial.X * (t_R0 a w_idx) ^ 2 =
          (c_R0 a Polynomial.X * t_R0 a w_idx) * t_R0 a w_idx := by ring
      rw [hsq]
      refine I_Pi_a.mul_mem_left _ (Ideal.subset_span ⟨Fin.last (m + 1), ?_⟩)
      dsimp only [g_Pi_a]; rw [Fin.lastCases_last]

  obtain ⟨j_Pi_R0, hCl_jPi, hjPi_fac⟩ :=
    @hSubFacAbs (weilProjectiveSpaceOver R₀ N).left (weilProjectiveSpaceOver R₀ m).left Z_Q
      (weilProjBasicOpen R₀ N) hCoord_R0.2.1 hAff_R0 ι_odd_R0 hCl_R0 ι_Q _
      _ _ hPres_R0 hPres_Q hle_Q

  have hPb_PmR0 : CategoryTheory.IsPullback
      (weilProjectiveSpaceOver R₀ m).hom Φ_Pm_R0 p_A1 (weilProjectiveSpaceOver k m).hom :=
    hBC_Pm_R0.2.1.flip
  let e_PmR0 := hPb_PmR0.isoPullback
  let ι_Pi : CategoryTheory.Limits.pullback p_A1 (weilProjectiveSpaceOver k m).hom ⟶ Q_fam.left :=
    e_PmR0.inv ≫ j_Pi_R0
  have hCl_Pi : AlgebraicGeometry.IsClosedImmersion ι_Pi := by
    dsimp only [ι_Pi]; infer_instance
  have hPi_hom : ι_Pi ≫ g_Q.left =
      CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom := by
    change (e_PmR0.inv ≫ j_Pi_R0) ≫ (ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom) = _
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j_Pi_R0,
      hjPi_fac, hHom_R0]
    exact hPb_PmR0.isoPullback_inv_fst

  refine ⟨hProp_gQ, ι_affQ, hOpen_affQ, o₀, ι_Pi, ?_, ?_, hCl_Pi, hPi_hom, ?_⟩
  · 
    refine ⟨hι_affQ_hom, ?_, ?_⟩
    · dsimp only [o₀, p_CQ, s₀, I_cone0]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hε₀_C]
    · intro idx pt
      change ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx)) ∈ pt.asIdeal
      rw [hε₀_X idx]
      exact pt.asIdeal.zero_mem
  · 
    intro z hz_not_o0
    have hex_a₀ : ∃ a₀ : Fin (N + 1),
        a₀ ≠ w_idx ∧
        z ∈ (TopologicalSpace.Opens.map ι_Q.base).obj (weilProjBasicOpen R₀ N a₀) := by
      by_contra hnone
      have hAll : ∀ a : Fin (N + 1), a ≠ w_idx →
          z ∉ (TopologicalSpace.Opens.map ι_Q.base).obj (weilProjBasicOpen R₀ N a) :=
        fun a ha hmem => hnone ⟨a, ha, hmem⟩
      obtain ⟨q, hq_z, hq_mem⟩ := hAvoid z hAll
      have hq_X : ∀ idx : Fin (m + 1) × Fin 2,
          Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx) ∈ q.asIdeal := by
        rintro ⟨j, b⟩
        rcases (by have := b.2; omega : b.1 = 0 ∨ b.1 = 1) with hb0 | hb1
        · have hb : b = 0 := Fin.ext hb0
          subst hb
          have hne_u : u_idx j ≠ w_idx := by
            intro h; have := congrArg Fin.val h; dsimp [u_idx, w_idx, N] at this; omega
          have hm_u := hq_mem (u_idx j) hne_u
          rw [← hΘ_w_X0 j, Θ_w.symm_apply_apply] at hm_u
          exact hm_u
        · have hb : b = 1 := Fin.ext hb1
          subst hb
          have hne_v : v_idx j ≠ w_idx := by
            intro h; have := congrArg Fin.val h; dsimp [v_idx, w_idx, N] at this; omega
          have hm_v := hq_mem (v_idx j) hne_v
          rw [← hΘ_w_X1 j, Θ_w.symm_apply_apply] at hm_v
          exact hm_v
      have hq_ker : q.asIdeal = RingHom.ker ε₀ := hε₀_uniq q hq_X
      let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of k) := (⊥ : PrimeSpectrum k)
      have hq_eq : q = o₀.base pt₀ := by
        apply PrimeSpectrum.ext
        rw [hq_ker]
        rfl
      apply hz_not_o0
      refine ⟨pt₀, ?_⟩
      change ι_affQ.base (o₀.base pt₀) = z
      rw [← hq_eq, hq_z]
    obtain ⟨a₀, ha₀_ne, hz_Oa₀⟩ := hex_a₀
    obtain ⟨Φ_a₀, hΦ_a₀⟩ := hS2_smooth a₀ ha₀_ne
    refine ⟨(TopologicalSpace.Opens.map ι_Q.base).obj (weilProjBasicOpen R₀ N a₀), hz_Oa₀, ?_⟩
    exact hS3_sm a₀ (2 * m + 1) Φ_a₀ hΦ_a₀
  · 
    intro K _ φ_s hAff_NK c_NK t_NK θ_NK hAff_PmK c_PmK t_PmK θ_PmK Φ_N Φ_m
      hCoord_NK hθ_NK hCoord_PmK hθ_PmK hBC_N hBC_m
    obtain ⟨ι_Pi_amb_K, ψ_K, hψ_K, hCl_K, hHom_K, hPres_K⟩ :=
      hMkOddAbs K (weilProjectiveSpaceOver K N).left (weilProjectiveSpaceOver K m).left
        (weilProjectiveSpaceOver K N).hom (weilProjectiveSpaceOver K m).hom
        (weilProjBasicOpen K N) (weilProjBasicOpen K m)
        hAff_NK c_NK t_NK hAff_PmK c_PmK t_PmK θ_PmK
        hCoord_NK.2.1 hCoord_NK.2.2.1 hCoord_NK.2.2.2.2.1 hCoord_NK.2.2.2.2.2.1
        hCoord_NK.2.2.2.2.2.2.1 hCoord_NK.2.2.2.2.2.2.2.1 hCoord_NK.2.2.2.2.2.2.2.2.1
        hCoord_NK.2.2.2.2.2.2.2.2.2
        hCoord_PmK.2.1 hCoord_PmK.2.2.1 hCoord_PmK.2.2.2.2.1 hCoord_PmK.2.2.2.2.2.2.2.1
        hCoord_PmK.2.2.2.2.2.2.2.2.1 hCoord_PmK.2.2.2.2.2.2.2.2.2
        hθ_PmK
    have hNat_K : ι_Pi_amb_K ≫ Φ_N = Φ_m ≫ ι_odd_R0 :=
      hBCCompAbs φ_s hCoord_PmK.2.1 hAff_R0 hAff_PmR0 hAff_NK
        c_R0 t_R0 c_PmR0 t_PmR0 c_NK t_NK c_PmK t_PmK hCoord_R0.2.2.2.2.2.1
        ι_odd_R0 ι_Pi_amb_K ψ_R0 ψ_K hψ_R0 hψ_K Φ_N Φ_m hBC_N.2.2 hBC_m.2.2
    refine ⟨ι_Pi_amb_K, hCl_K, hHom_K, hPres_K, ?_⟩
    intro q_Pm hq_fst hq_snd
    have hq_eq : q_Pm = e_PmR0.hom := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [hq_fst, hPb_PmR0.isoPullback_hom_fst]
      · rw [hq_snd, hPb_PmR0.isoPullback_hom_snd]
    rw [hq_eq]
    dsimp only [ι_Pi]
    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
      hjPi_fac, hNat_K]

theorem weil_proj_quadric_paving_fiber_cellular_filtration (K : Type u) [Field K] (m : ℕ) (t : K)
    (hAff_K : ∀ a : Fin (2 * m + 2 + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K (2 * m + 2) a))
    (c_K : ∀ a : Fin (2 * m + 2 + 1),
      K →+* ↑((weilProjectiveSpaceOver K (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K (2 * m + 2) a))))
    (t_K : ∀ a : Fin (2 * m + 2 + 1), Fin (2 * m + 2 + 1) →
      ↑((weilProjectiveSpaceOver K (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K (2 * m + 2) a))))
    (θ_K : ∀ a : Fin (2 * m + 2 + 1),
      MvPolynomial (Fin (2 * m + 2)) K ≃+*
        ↑((weilProjectiveSpaceOver K (2 * m + 2)).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K (2 * m + 2) a))))
    (hCoord_K : IsCommRingProjCoordSystem K (2 * m + 2) hAff_K c_K t_K)
    (hθ_K : ∀ a : Fin (2 * m + 2 + 1),
      (θ_K a).toRingHom.comp MvPolynomial.C = c_K a ∧
      ∀ i : Fin (2 * m + 2), θ_K a (MvPolynomial.X i) = t_K a (a.succAbove i))
    (hAff_Pm : ∀ a : Fin (m + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K m a))
    (c_Pm : ∀ a : Fin (m + 1),
      K →+* ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K m a))))
    (t_Pm : ∀ a : Fin (m + 1), Fin (m + 1) →
      ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K m a))))
    (θ_Pm : ∀ a : Fin (m + 1),
      MvPolynomial (Fin m) K ≃+*
        ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K m a))))
    (hCoord_Pm : IsCommRingProjCoordSystem K m hAff_Pm c_Pm t_Pm)
    (hθ_Pm : ∀ a : Fin (m + 1),
      (θ_Pm a).toRingHom.comp MvPolynomial.C = c_Pm a ∧
      ∀ i : Fin m, θ_Pm a (MvPolynomial.X i) = t_Pm a (a.succAbove i))
    (hSubEx_K : ∀ (M : ℕ)
        (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
        (c_M : ∀ a : Fin (M + 1),
          K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a))))
        (t_M : ∀ a : Fin (M + 1), Fin (M + 1) →
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a)))),
      IsCommRingProjCoordSystem K M hAff_M c_M t_M →
      ∀ (L : ℕ) (d_gen : Fin L → ℕ)
        (g_M : ∀ a : Fin (M + 1), Fin L →
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a)))),
        (∀ (a a' : Fin (M + 1)) (ν : Fin L),
          ((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_right).op).hom (g_M a' ν) *
          (((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (t_M a a')) ^ (d_gen ν) =
          ((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (g_M a ν)) →
        ∃ (Z_M : AlgebraicGeometry.Scheme.{u})
          (ι_Z : Z_M ⟶ (weilProjectiveSpaceOver K M).left),
          AlgebraicGeometry.IsClosedImmersion ι_Z ∧
          ∀ a : Fin (M + 1),
            let O_a : Z_M.Opens :=
              (TopologicalSpace.Opens.map ι_Z.base).obj (weilProjBasicOpen K M a)
            ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
                (↑((weilProjectiveSpaceOver K M).left.presheaf.obj
                  (Opposite.op (weilProjBasicOpen K M a))) ⧸
                  Ideal.span (Set.range (g_M a)))),
              O_a.ι ≫ ι_Z =
                e_a.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
                  (hAff_M a).fromSpec)
    (hSubIncl_K : ∀ (M : ℕ)
        (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
        (c_M : ∀ a : Fin (M + 1),
          K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a))))
        (t_M : ∀ a : Fin (M + 1), Fin (M + 1) →
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a)))),
      IsCommRingProjCoordSystem K M hAff_M c_M t_M →
      ∀ (Z_M : AlgebraicGeometry.Scheme.{u})
        (ι_Z : Z_M ⟶ (weilProjectiveSpaceOver K M).left)
        [AlgebraicGeometry.IsClosedImmersion ι_Z]
        (L : ℕ)
        (g_M : ∀ a : Fin (M + 1), Fin L →
