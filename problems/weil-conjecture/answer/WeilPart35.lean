      let u_map : SC.X₁.H i →+ SC.X₂.H i :=
        (CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp Fℤ_D (Nat.add_zero i)
      let v_map : SC.X₂.H i →+ SC.X₃.H i :=
        (CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp Fℤ_D (Nat.add_zero i)
      let Im := v_map.range
      let sec : ↥Im → SC.X₂.H i := fun y => Classical.choose y.2
      have hsec : ∀ y : ↥Im, v_map (sec y) = y.1 := fun y => Classical.choose_spec y.2
      let Φ_surj : (SC.X₁.H i × ↥Im) → SC.X₂.H i := fun pair => u_map pair.1 + sec pair.2
      have hΦ_surj : Function.Surjective Φ_surj := by
        intro b
        let y : ↥Im := ⟨v_map b, ⟨b, rfl⟩⟩
