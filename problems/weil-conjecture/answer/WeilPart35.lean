        obtain ⟨O, hO_ne, _, _, _, N₀, hO_stab⟩ :=
          @weil_etale_integral_constantSheaf_subobject_generic_open.{u} V' hInt_V' ℓ hm_ℓ M_A _ Q_V'
        let B_O : CategoryTheory.Functor V'.Etale (O : AlgebraicGeometry.Scheme.{u}).Etale :=
          CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ O.ι
        obtain ⟨hc_O, hr_O, _⟩ := hMod1 O.ι
        letI := hc_O; letI := hr_O
        have hO_iso := (@hO_stab hc_O hr_O).1
        obtain ⟨W_open, hW_ne, V'', j_O, p'', _, _, hSurj_p'', h_p''_eq⟩ := hShrinkO O hO_ne
        have h_path : (j_O ≫ O.ι) ≫ g_V' = p'' ≫ (W_open.ι ≫ i_Zred) := by
          calc
            (j_O ≫ O.ι) ≫ g_V' = j_O ≫ (O.ι ≫ ((q_V ≫ (p_V ≫ U.ι)) ≫ i_Zred)) := by
                simp only [g_V', g_V, CategoryTheory.Category.assoc]
            _ = (j_O ≫ (O.ι ≫ (p' ≫ U₁.ι))) ≫ i_Zred := by
                rw [← h_p'_eq]
                simp only [CategoryTheory.Category.assoc]
            _ = p'' ≫ (W_open.ι ≫ i_Zred) := by
                rw [← h_p''_eq]
                simp only [CategoryTheory.Category.assoc]
        have hStab_V'' : StabAlong (p'' ≫ (W_open.ι ≫ i_Zred)) := by
          let B_jO : CategoryTheory.Functor (O : AlgebraicGeometry.Scheme.{u}).Etale V''.Etale :=
            CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j_O
          obtain ⟨hc_jO, hr_jO, _⟩ := hMod1 j_O
          obtain ⟨hc_jOO, hr_jOO, _⟩ := hMod1 (j_O ≫ O.ι)
          obtain ⟨hc_lhs, hr_lhs, h_unused_lhs⟩ := hMod1 ((j_O ≫ O.ι) ≫ g_V')
          clear h_unused_lhs
          obtain ⟨hc_rhs, hr_rhs, _⟩ := hMod1 (p'' ≫ (W_open.ι ≫ i_Zred))
          letI := hc_jO; letI := hr_jO
          obtain ⟨e_c1⟩ := @hMod2 V'' (O : AlgebraicGeometry.Scheme.{u}) V' j_O O.ι
            hc_jO hr_jO hc_O hr_O hc_jOO hr_jOO
          obtain ⟨e_c2⟩ := @hMod2 V'' V' S (j_O ≫ O.ι) g_V'
            hc_jOO hr_jOO hc_gV' hr_gV' hc_lhs hr_lhs
          let pb_O := B_O.sheafPullback (ModuleCat.{u, u} R)
            V'.smallEtaleTopology (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology
          let pb_jO := B_jO.sheafPullback (ModuleCat.{u, u} R)
            (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology V''.smallEtaleTopology
          refine ⟨N₀, fun n hn => ⟨hc_rhs, hr_rhs, ?_⟩⟩
          obtain ⟨_, _, h_rel, _⟩ := (hQ_V' N₀ n hn).2
          have hIso_O : CategoryTheory.IsIso
              (pb_O.map (pb_gV'.map (CategoryTheory.Subobject.ofLE (P N₀) (P n) (P.monotone hn)))) := by
            haveI := hO_iso n hn
            rw [h_rel, pb_O.map_comp, pb_O.map_comp]
            infer_instance
          have hIso_jO : CategoryTheory.IsIso
              (pb_jO.map (pb_O.map (pb_gV'.map
                (CategoryTheory.Subobject.ofLE (P N₀) (P n) (P.monotone hn))))) := by
            haveI := hIso_O
            infer_instance
          have hIso_m1 := hIsIsoMapOfNatIso e_c1
            (pb_gV'.map (CategoryTheory.Subobject.ofLE (P N₀) (P n) (P.monotone hn))) hIso_jO
          have hIso_lhs := hIsIsoMapOfNatIso e_c2
            (CategoryTheory.Subobject.ofLE (P N₀) (P n) (P.monotone hn)) hIso_m1
          clear e_c2 hIso_m1 hIso_jO
          revert hc_lhs hr_lhs hIso_lhs
          rw [h_path]
          intro hc_l hr_l hIso_l
          have hSubC : hc_l = hc_rhs := Subsingleton.elim _ _
          subst hSubC
          have hSubR : hr_l = hr_rhs := Subsingleton.elim _ _
          subst hSubR
          exact hIso_l
        have hUniv_p'' : (⋃ _ : Fin 1, Set.range p''.base) = Set.univ := by
          ext w_pt
          simp only [Set.mem_iUnion, Set.mem_univ, iff_true, exists_const]
          exact (AlgebraicGeometry.surjective_iff p'').mp hSurj_p'' w_pt
        have hStab_Wopen : StabAlong (W_open.ι ≫ i_Zred) :=
          hCoverDescend (W_open : AlgebraicGeometry.Scheme.{u}) (W_open.ι ≫ i_Zred)
            1 (fun _ => V'') (fun _ => p'') hUniv_p'' (fun _ => hStab_V'')
        obtain ⟨Z_compl, i_compl, K_compl, hCl_compl, hUniv_W, hRange_compl, hK_lt⟩ :=
          (hExcDesc i_Zred K hRange_red).1 W_open hW_ne
        haveI := hCl_compl
        haveI : AlgebraicGeometry.IsClosedImmersion (i_compl ≫ i_Zred) := inferInstance
        have hStab_compl : StabAlong (i_compl ≫ i_Zred) :=
          ih K_compl hK_lt Z_compl (i_compl ≫ i_Zred) hRange_compl
        let W_cov : Fin 2 → AlgebraicGeometry.Scheme.{u} :=
          Fin.cases (W_open : AlgebraicGeometry.Scheme.{u}) (fun _ => Z_compl)
        let f_cov : ∀ a : Fin 2, W_cov a ⟶ Z_red :=
          Fin.cases W_open.ι (fun _ => i_compl)
        have hUniv_cov : (⋃ a : Fin 2, Set.range (f_cov a).base) = Set.univ := by
          ext z
          simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
          have hz_u : z ∈ Set.range W_open.ι.base ∪ Set.range i_compl.base := by
            rw [hUniv_W]; trivial
          rcases hz_u with hz₀ | hz₁
          · exact ⟨0, hz₀⟩
          · exact ⟨1, hz₁⟩
        exact hCoverDescend Z_red i_Zred 2 W_cov f_cov hUniv_cov
          (Fin.cases hStab_Wopen (fun _ => hStab_compl))
      · 
        obtain ⟨K₁, K₂, hUniv_12, hRange_1, hRange_2, hK₁_lt, hK₂_lt⟩ :=
          (hExcDesc i_Zred K hRange_red).2 O₁ W₁ W₂ i₁ i₂ hO₁_ne hCompl₂_ne hCl₁ hCl₂ hRange₁ hIso₂
        haveI := hCl₁
        haveI := hCl₂
        haveI : AlgebraicGeometry.IsClosedImmersion (i₁ ≫ i_Zred) := inferInstance
        haveI : AlgebraicGeometry.IsClosedImmersion (i₂ ≫ i_Zred) := inferInstance
        have hStab_1 : StabAlong (i₁ ≫ i_Zred) := ih K₁ hK₁_lt W₁ (i₁ ≫ i_Zred) hRange_1
        have hStab_2 : StabAlong (i₂ ≫ i_Zred) := ih K₂ hK₂_lt W₂ (i₂ ≫ i_Zred) hRange_2
        let W_cov : Fin 2 → AlgebraicGeometry.Scheme.{u} := Fin.cases W₁ (fun _ => W₂)
        let f_cov : ∀ a : Fin 2, W_cov a ⟶ Z_red := Fin.cases i₁ (fun _ => i₂)
        have hUniv_cov : (⋃ a : Fin 2, Set.range (f_cov a).base) = Set.univ := by
          ext z
          simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
          have hz_u : z ∈ Set.range i₁.base ∪ Set.range i₂.base := by
            rw [hUniv_12]; trivial
          rcases hz_u with hz₀ | hz₁
          · exact ⟨0, hz₀⟩
          · exact ⟨1, hz₁⟩
        exact hCoverDescend Z_red i_Zred 2 W_cov f_cov hUniv_cov
          (Fin.cases hStab_1 (fun _ => hStab_2))

  let id_S : S ⟶ S := 𝟙 S
  obtain ⟨N₀, hN₀⟩ := hInd ⊤ S id_S (Set.subset_univ _)
  let B_id : CategoryTheory.Functor S.Etale S.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ id_S
  let hc_id : B_id.IsContinuous S.smallEtaleTopology S.smallEtaleTopology := (hMod1 id_S).choose
  let hr_id : (B_id.sheafPushforwardContinuous (ModuleCat.{u, u} R)
      S.smallEtaleTopology S.smallEtaleTopology).IsRightAdjoint :=
    (hMod1 id_S).choose_spec.choose
  have hUniv_id : (⋃ _ : Fin 1, Set.range id_S.base) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true, exists_const]
    exact ⟨x, rfl⟩
  obtain ⟨N, hN⟩ := @hMod4 S 1 (fun _ => S) (fun _ => id_S) hUniv_id
    (fun _ => hc_id) (fun _ => hr_id) P_𝒢 P (fun _ => ⟨N₀, fun n hn => by
      obtain ⟨hc', hr', hIso'⟩ := hN₀ n hn
      have hSubC : hc' = hc_id := Subsingleton.elim _ _
      subst hSubC
      have hSubR : hr' = hr_id := Subsingleton.elim _ _
      subst hSubR
      exact hIso'⟩)
  exact ⟨N, fun n hn => (hN n hn).symm⟩

theorem weil_sing_dev_ar_abelian_artin_rees_stabilization {𝒞 : Type u₁} [CategoryTheory.Category.{v₁, u₁} 𝒞] [CategoryTheory.Abelian 𝒞]
    (ℓ : ℕ)
    (M M' : ℕ → 𝒞)
    (j_M : ∀ m n : ℕ, m ≤ n → Quiver.Hom (M m) (M n))
    (τ_M : ∀ m n : ℕ, m ≤ n → Quiver.Hom (M n) (M m))
    (δ_M : ∀ a b c : ℕ, a + c = b → Quiver.Hom (M c) (M' a))
    (hNoeth_M1 : CategoryTheory.IsNoetherianObject (M 1))
    (hNoeth_M'1 : CategoryTheory.IsNoetherianObject (M' 1))
    (hTor_M : ∀ n : ℕ, (ℓ ^ n) • CategoryTheory.CategoryStruct.id (M n) = 0)
    (hId_M : ∀ (n : ℕ) (h : n ≤ n),
      j_M n n h = CategoryTheory.CategoryStruct.id (M n) ∧
      τ_M n n h = CategoryTheory.CategoryStruct.id (M n))
    (hComp_M : ∀ (k m n : ℕ) (h₁ : k ≤ m) (h₂ : m ≤ n),
      CategoryTheory.CategoryStruct.comp (j_M k m h₁) (j_M m n h₂) = j_M k n (le_trans h₁ h₂) ∧
      CategoryTheory.CategoryStruct.comp (τ_M m n h₂) (τ_M k m h₁) = τ_M k n (le_trans h₁ h₂))
    (hMixed_M : ∀ (m₁ n₁ m₂ n₂ d : ℕ) (h₁ : m₁ ≤ n₁) (h₂ : m₂ ≤ n₂)
        (hm : m₂ ≤ m₁) (hn : n₂ ≤ n₁),
      m₁ + d = n₁ → m₂ + d = n₂ →
      CategoryTheory.CategoryStruct.comp (j_M m₁ n₁ h₁) (τ_M n₂ n₁ hn) =
        CategoryTheory.CategoryStruct.comp (τ_M m₂ m₁ hm) (j_M m₂ n₂ h₂))
    (hMul_M : ∀ (m n d : ℕ) (h : m ≤ n),
      m + d = n →
      CategoryTheory.CategoryStruct.comp (j_M m n h) (τ_M m n h) =
        (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M m) ∧
      CategoryTheory.CategoryStruct.comp (τ_M m n h) (j_M m n h) =
        (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M n))
    (hEx1 : ∀ (a b c : ℕ) (habc : a + c = b),
      ∃ h₁ : CategoryTheory.CategoryStruct.comp
          (j_M a b (Nat.le.intro habc))
          (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) = 0,
        (CategoryTheory.ShortComplex.mk
          (j_M a b (Nat.le.intro habc))
          (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) h₁).Exact)
    (hEx2 : ∀ (a b c : ℕ) (habc : a + c = b),
      ∃ h₂ : CategoryTheory.CategoryStruct.comp
          (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
          (δ_M a b c habc) = 0,
        (CategoryTheory.ShortComplex.mk
          (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
          (δ_M a b c habc) h₂).Exact)
    (hNat_δ : ∀ (c₁ c₂ : ℕ) (hc : c₁ ≤ c₂),
      CategoryTheory.CategoryStruct.comp (j_M c₁ c₂ hc) (δ_M 1 (1 + c₂) c₂ rfl) =
        δ_M 1 (1 + c₁) c₁ rfl) :
    ∃ (n₀ c : ℕ), 1 ≤ n₀ ∧ n₀ ≤ c ∧
      ∃ (ℐ 𝒩 𝒦 : ℕ → 𝒞)
        (π_ℐ : ∀ r : ℕ, Quiver.Hom (M (n₀ + r + 1)) (ℐ r))
        (ι_ℐ : ∀ r : ℕ, Quiver.Hom (ℐ r) (M (r + 1)))
        (τ_ℐ : ∀ r : ℕ, Quiver.Hom (ℐ (r + 1)) (ℐ r))
        (e_𝒩 : ∀ r : ℕ, Quiver.Hom (M (n₀ + r + 1)) (𝒩 r))
        (ι_𝒩 : ∀ r : ℕ, Quiver.Hom (𝒩 r) (M (c + r + 1)))
        (q_𝒩 : ∀ r : ℕ, Quiver.Hom (ℐ r) (𝒩 r))
        (ι_𝒦 : ∀ r : ℕ, Quiver.Hom (𝒦 r) (ℐ r))
        (τ_𝒩 : ∀ r : ℕ, Quiver.Hom (𝒩 (r + 1)) (𝒩 r))
        (ι_bock : ∀ r : ℕ, Quiver.Hom (𝒩 r) (𝒩 (r + 1)))
        (ρ_bock : ∀ r : ℕ, Quiver.Hom (𝒩 (r + 1)) (𝒩 0)),
        ∀ r : ℕ,
          (CategoryTheory.Epi (π_ℐ r) ∧ CategoryTheory.Mono (ι_ℐ r) ∧
            CategoryTheory.Epi (τ_ℐ r) ∧ CategoryTheory.Epi (e_𝒩 r) ∧
            CategoryTheory.Mono (ι_𝒩 r) ∧ CategoryTheory.Epi (q_𝒩 r) ∧
            CategoryTheory.Mono (ι_𝒦 r)) ∧
          (CategoryTheory.CategoryStruct.comp (π_ℐ r) (ι_ℐ r) =
              τ_M (r + 1) (n₀ + r + 1) (Nat.le_add_left (r + 1) n₀) ∧
            CategoryTheory.CategoryStruct.comp (ι_ℐ (r + 1))
                (τ_M (r + 1) (r + 2) (Nat.le_succ (r + 1))) =
              CategoryTheory.CategoryStruct.comp (τ_ℐ r) (ι_ℐ r) ∧
            CategoryTheory.CategoryStruct.comp (π_ℐ (r + 1)) (τ_ℐ r) =
              CategoryTheory.CategoryStruct.comp
                (τ_M (n₀ + r + 1) (n₀ + (r + 1) + 1) (Nat.le_succ (n₀ + r + 1))) (π_ℐ r)) ∧
          ((ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (ℐ r) = 0 ∧
            (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (𝒩 r) = 0 ∧
            (ℓ ^ c) • CategoryTheory.CategoryStruct.id (𝒦 r) = 0) ∧
          ((∃ hK : CategoryTheory.CategoryStruct.comp (ι_𝒦 r) (q_𝒩 r) = 0,
              (CategoryTheory.ShortComplex.mk (ι_𝒦 r) (q_𝒩 r) hK).ShortExact) ∧
            CategoryTheory.CategoryStruct.comp (q_𝒩 (r + 1)) (τ_𝒩 r) =
              CategoryTheory.CategoryStruct.comp (τ_ℐ r) (q_𝒩 r)) ∧
          ((∃ hB : CategoryTheory.CategoryStruct.comp (ι_bock r) (ρ_bock r) = 0,
              (CategoryTheory.ShortComplex.mk (ι_bock r) (ρ_bock r) hB).ShortExact) ∧
            CategoryTheory.CategoryStruct.comp (ι_bock r) (τ_𝒩 r) =
              ℓ • CategoryTheory.CategoryStruct.id (𝒩 r) ∧
            CategoryTheory.CategoryStruct.comp (τ_𝒩 r) (ι_bock r) =
              CategoryTheory.CategoryStruct.comp (ι_bock (r + 1)) (τ_𝒩 (r + 1)) ∧
            ρ_bock 0 = τ_𝒩 0 ∧
            ρ_bock (r + 1) = CategoryTheory.CategoryStruct.comp (τ_𝒩 (r + 1)) (ρ_bock r)) :=
by
  open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian.Pseudoelement in
  let _ : IsNoetherianObject (M 1) := hNoeth_M1
  let _ : IsNoetherianObject (M' 1) := hNoeth_M'1

  have hSubFactor : ∀ {B A₁ A₂ : 𝒞} (f₁ : A₁ ⟶ B) (f₂ : A₂ ⟶ B) [Mono f₁] [Mono f₂],
      Subobject.mk f₂ ≤ Subobject.mk f₁ →
      ∃ α : A₂ ⟶ A₁, α ≫ f₁ = f₂ := by
    intro B A₁ A₂ f₁ f₂ _ _ hle
    refine ⟨(Subobject.underlyingIso f₂).inv ≫
      (Subobject.mk f₂).ofLE (Subobject.mk f₁) hle ≫
      (Subobject.underlyingIso f₁).hom, ?_⟩
    rw [Category.assoc, Category.assoc, Subobject.underlyingIso_hom_comp_eq_mk,
      Subobject.ofLE_arrow, ← Subobject.underlyingIso_hom_comp_eq_mk f₂,
      Iso.inv_hom_id_assoc]

  have hLiftEpiMono : ∀ {A B X Y : 𝒞} (e : A ⟶ B) [Epi e] (m : X ⟶ Y) [Mono m]
      (t : A ⟶ X) (b : B ⟶ Y),
      e ≫ b = t ≫ m →
      ∃ l : B ⟶ X, l ≫ m = b ∧ e ≫ l = t := by
    intro A B X Y e _ m _ t b hsq
    have hb0 : b ≫ cokernel.π m = 0 := by
      rw [← cancel_epi e, comp_zero, ← Category.assoc, hsq, Category.assoc,
        cokernel.condition, comp_zero]
    let hlk := Abelian.monoIsKernelOfCokernel _ (cokernelIsCokernel m)
    let fk := KernelFork.ofι b hb0
    let l : B ⟶ X := hlk.lift fk
    have hlm : l ≫ m = b := hlk.fac fk WalkingParallelPair.zero
    have hel : e ≫ l = t := by
      rw [← cancel_mono m, Category.assoc, hlm, hsq]
    exact ⟨l, hlm, hel⟩

  have hImageMap : ∀ {X₁ Y₁ X₂ Y₂ : 𝒞} (f₁ : X₁ ⟶ Y₁) (f₂ : X₂ ⟶ Y₂)
      (u : X₁ ⟶ X₂) (v : Y₁ ⟶ Y₂),
      u ≫ f₂ = f₁ ≫ v →
      ∃ w : image f₁ ⟶ image f₂,
        w ≫ image.ι f₂ = image.ι f₁ ≫ v ∧
        factorThruImage f₁ ≫ w = u ≫ factorThruImage f₂ := by
    intro X₁ Y₁ X₂ Y₂ f₁ f₂ u v hcomm
    refine hLiftEpiMono (factorThruImage f₁) (image.ι f₂)
      (u ≫ factorThruImage f₂) (image.ι f₁ ≫ v) ?_
    rw [← Category.assoc, image.fac, Category.assoc, image.fac, hcomm]

  let δ₁ : ∀ k : ℕ, M k ⟶ M' 1 := fun k => δ_M 1 (1 + k) k rfl
  let D_fn : ℕ → Subobject (M' 1) := fun m => Subobject.mk (image.ι (δ₁ (m + 1)))
  have hD_step : ∀ m : ℕ, D_fn m ≤ D_fn (m + 1) := by
    intro m
    let F_m : MonoFactorisation (δ₁ (m + 1)) :=
      { I := image (δ₁ (m + 2))
        m := image.ι (δ₁ (m + 2))
        e := j_M (m + 1) (m + 2) (Nat.le_succ _) ≫ factorThruImage (δ₁ (m + 2))
        fac := by rw [Category.assoc, image.fac, hNat_δ] }
    exact Subobject.mk_le_mk_of_comm (image.lift F_m) (image.lift_fac F_m)
  let D_chain : ℕ →o Subobject (M' 1) := ⟨D_fn, monotone_nat_of_le_succ hD_step⟩
  obtain ⟨m_δ, hm_δ⟩ := monotone_chain_condition_of_isNoetherianObject D_chain
  let n₀ : ℕ := m_δ + 1
  have hn₀_pos : 1 ≤ n₀ := Nat.succ_pos m_δ

  have hδ_stab : ∀ (k : ℕ) (_hk : n₀ ≤ k),
      ∃ α : image (δ₁ k) ⟶ image (δ₁ n₀), α ≫ image.ι (δ₁ n₀) = image.ι (δ₁ k) := by
    intro k hk
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, k = m + 1 := ⟨k - 1, (Nat.sub_add_cancel (le_trans hn₀_pos hk)).symm⟩
    have hm : m_δ ≤ m := Nat.le_of_succ_le_succ hk
    have heq : D_fn m_δ = D_fn m := hm_δ m hm
    exact hSubFactor (image.ι (δ₁ n₀)) (image.ι (δ₁ (m + 1))) (le_of_eq heq.symm)

  let j₁ : ∀ k : ℕ, M 1 ⟶ M (1 + k) := fun k => j_M 1 (1 + k) (by omega)
  let K_fn : ℕ → Subobject (M 1) := fun m => Subobject.mk (kernel.ι (j₁ (m + 1)))
  have hK_step : ∀ m : ℕ, K_fn m ≤ K_fn (m + 1) := by
    intro m
    have hcomp : kernel.ι (j₁ (m + 1)) ≫ j₁ (m + 2) = 0 := by
      have hj : j₁ (m + 2) = j₁ (m + 1) ≫ j_M (1 + (m + 1)) (1 + (m + 2)) (by omega) :=
        ((hComp_M 1 (1 + (m + 1)) (1 + (m + 2)) (by omega) (by omega)).1).symm
      rw [hj, ← Category.assoc, kernel.condition, zero_comp]
    exact Subobject.mk_le_mk_of_comm (kernel.lift (j₁ (m + 2)) (kernel.ι (j₁ (m + 1))) hcomp)
      (kernel.lift_ι _ _ _)
  let K_chain : ℕ →o Subobject (M 1) := ⟨K_fn, monotone_nat_of_le_succ hK_step⟩
  obtain ⟨m_j, hm_j⟩ := monotone_chain_condition_of_isNoetherianObject K_chain
  let c : ℕ := max (m_j + 1) n₀
  have hn₀_le_c : n₀ ≤ c := le_max_right _ _
  have hc_pos : 1 ≤ c := le_trans hn₀_pos hn₀_le_c

  have hj_stab_zero : ∀ (k : ℕ), c ≤ k →
      ∀ (w : Abelian.Pseudoelement (M 1)),
        pseudoApply (j_M 1 (1 + k) (by omega)) w = 0 →
        pseudoApply (j_M 1 (1 + c) (by omega)) w = 0 := by
    intro k hk w hw
    obtain ⟨m_k, rfl⟩ : ∃ m_k : ℕ, k = m_k + 1 :=
      ⟨k - 1, (Nat.sub_add_cancel (le_trans hc_pos hk)).symm⟩
    obtain ⟨m_c, hmc_eq⟩ : ∃ m_c : ℕ, c = m_c + 1 :=
      ⟨c - 1, (Nat.sub_add_cancel hc_pos).symm⟩
    have hm_jc : m_j ≤ m_c := by
      have : m_j + 1 ≤ c := le_max_left _ _
      omega
    have hm_jk : m_j ≤ m_k := by omega
    have hK_eq : K_fn m_c = K_fn m_k := (hm_j m_c hm_jc).symm.trans (hm_j m_k hm_jk)
    obtain ⟨β, hβ⟩ := hSubFactor (kernel.ι (j₁ (m_c + 1))) (kernel.ι (j₁ (m_k + 1)))
      (le_of_eq hK_eq.symm)
    have hker_zero : kernel.ι (j₁ (m_k + 1)) ≫ j₁ (m_c + 1) = 0 := by
      rw [← hβ, Category.assoc, kernel.condition, comp_zero]
    let SC_ker := ShortComplex.mk (kernel.ι (j₁ (m_k + 1))) (j₁ (m_k + 1))
      (kernel.condition (j₁ (m_k + 1)))
    have hEx_ker : SC_ker.Exact := ShortComplex.exact_of_f_is_kernel SC_ker (kernelIsKernel _)
    obtain ⟨w₀, hw₀⟩ := pseudo_exact_of_exact hEx_ker w hw
    change pseudoApply (kernel.ι (j₁ (m_k + 1))) w₀ = w at hw₀
    have h1 : pseudoApply (j₁ (m_c + 1)) w = 0 := by
      rw [← hw₀, ← Abelian.Pseudoelement.comp_apply, hker_zero, Abelian.Pseudoelement.zero_apply]
    have h_eq_c : j_M 1 (1 + c) (by omega) =
        j₁ (m_c + 1) ≫ j_M (1 + (m_c + 1)) (1 + c) (by omega) :=
      ((hComp_M 1 (1 + (m_c + 1)) (1 + c) _ _).1).symm
    rw [h_eq_c, Abelian.Pseudoelement.comp_apply, h1, apply_zero]

  have hId_M0 : 𝟙 (M 0) = 0 := by
    have h0 := hTor_M 0
    rwa [pow_zero, one_nsmul] at h0

  let f_ℐ : ∀ r : ℕ, M (n₀ + r + 1) ⟶ M (r + 1) :=
    fun r => τ_M (r + 1) (n₀ + r + 1) (Nat.le_add_left (r + 1) n₀)
  let ℐ : ℕ → 𝒞 := fun r => image (f_ℐ r)
  let π_ℐ : ∀ r : ℕ, M (n₀ + r + 1) ⟶ ℐ r := fun r => factorThruImage (f_ℐ r)
  let ι_ℐ : ∀ r : ℕ, ℐ r ⟶ M (r + 1) := fun r => image.ι (f_ℐ r)

  have hτ_ℐ_ex : ∀ r : ℕ,
      ∃ w : ℐ (r + 1) ⟶ ℐ r,
        w ≫ ι_ℐ r = ι_ℐ (r + 1) ≫ τ_M (r + 1) (r + 2) (Nat.le_succ (r + 1)) ∧
        π_ℐ (r + 1) ≫ w =
          τ_M (n₀ + r + 1) (n₀ + (r + 1) + 1) (Nat.le_succ (n₀ + r + 1)) ≫ π_ℐ r := by
    intro r
    apply hImageMap (f_ℐ (r + 1)) (f_ℐ r)
      (τ_M (n₀ + r + 1) (n₀ + (r + 1) + 1) (Nat.le_succ _))
      (τ_M (r + 1) (r + 2) (Nat.le_succ _))
    dsimp [f_ℐ]
    rw [(hComp_M (r + 1) (n₀ + r + 1) (n₀ + (r + 1) + 1) _ _).2,
      (hComp_M (r + 1) (r + 2) (n₀ + (r + 1) + 1) _ _).2]

  let τ_ℐ : ∀ r : ℕ, ℐ (r + 1) ⟶ ℐ r := fun r => Classical.choose (hτ_ℐ_ex r)
  have hτ_ℐ_ι : ∀ r : ℕ,
      τ_ℐ r ≫ ι_ℐ r = ι_ℐ (r + 1) ≫ τ_M (r + 1) (r + 2) (Nat.le_succ (r + 1)) :=
    fun r => (Classical.choose_spec (hτ_ℐ_ex r)).1
  have hπ_ℐ_τ : ∀ r : ℕ,
      π_ℐ (r + 1) ≫ τ_ℐ r =
        τ_M (n₀ + r + 1) (n₀ + (r + 1) + 1) (Nat.le_succ (n₀ + r + 1)) ≫ π_ℐ r :=
    fun r => (Classical.choose_spec (hτ_ℐ_ex r)).2

  have hEpi_τ_ℐ : ∀ r : ℕ, Epi (τ_ℐ r) := by
    intro r
    apply epi_of_pseudo_surjective
    intro u
    obtain ⟨x, rfl⟩ := pseudo_surjective_of_epi (π_ℐ r) u
    let k := n₀ + r + 1
    have hk_ge : n₀ ≤ k := by omega
    obtain ⟨α, hα⟩ := hδ_stab k hk_ge
    let y_im := pseudoApply (factorThruImage (δ₁ k) ≫ α) x
    obtain ⟨w, hw⟩ := pseudo_surjective_of_epi (factorThruImage (δ₁ n₀)) y_im
    have hδ_eq : pseudoApply (δ₁ k) x =
        pseudoApply (δ₁ k) (pseudoApply (j_M n₀ k hk_ge) w) := by
      have h1 : pseudoApply (δ₁ n₀) w = pseudoApply (δ₁ k) x := by
        calc pseudoApply (δ₁ n₀) w
            = pseudoApply (factorThruImage (δ₁ n₀) ≫ image.ι (δ₁ n₀)) w := by
                rw [image.fac]
          _ = pseudoApply (image.ι (δ₁ n₀)) y_im := by
                rw [Abelian.Pseudoelement.comp_apply, hw]
          _ = pseudoApply ((factorThruImage (δ₁ k) ≫ α) ≫ image.ι (δ₁ n₀)) x := by
                rw [← Abelian.Pseudoelement.comp_apply]
          _ = pseudoApply (δ₁ k) x := by
                rw [Category.assoc, hα, image.fac]
      rw [← h1, ← Abelian.Pseudoelement.comp_apply, hNat_δ n₀ k hk_ge]
    obtain ⟨z, hz_ker, hz_sub⟩ :=
      sub_of_eq_image (δ₁ k) x (pseudoApply (j_M n₀ k hk_ge) w) hδ_eq
    have hj_π_zero : j_M n₀ k hk_ge ≫ π_ℐ r = 0 := by
      rw [← cancel_mono (ι_ℐ r), zero_comp, Category.assoc, image.fac (f_ℐ r)]
      obtain ⟨h0_ex1, _⟩ := hEx1 n₀ k (r + 1) rfl
      exact h0_ex1
    have hπ_w_zero : pseudoApply (π_ℐ r) (pseudoApply (j_M n₀ k hk_ge) w) = 0 := by
      rw [← Abelian.Pseudoelement.comp_apply, hj_π_zero, Abelian.Pseudoelement.zero_apply]
    have hπ_zx : pseudoApply (π_ℐ r) z = pseudoApply (π_ℐ r) x :=
      hz_sub (ℐ r) (π_ℐ r) hπ_w_zero
    obtain ⟨h₂_k, hEx2_k⟩ := hEx2 1 (1 + k) k rfl
    obtain ⟨z₁, hz₁⟩ := pseudo_exact_of_exact hEx2_k z hz_ker
    change pseudoApply (τ_M k (1 + k) _) z₁ = z at hz₁
    let z₂ := pseudoApply (τ_M (n₀ + (r + 1) + 1) (1 + k) (by omega)) z₁
    refine ⟨pseudoApply (π_ℐ (r + 1)) z₂, ?_⟩
    rw [← Abelian.Pseudoelement.comp_apply, hπ_ℐ_τ r, Abelian.Pseudoelement.comp_apply]
    have hz₂_map : pseudoApply (τ_M (n₀ + r + 1) (n₀ + (r + 1) + 1) (Nat.le_succ _)) z₂ = z := by
      dsimp [z₂]
      rw [← Abelian.Pseudoelement.comp_apply,
        (hComp_M k (n₀ + (r + 1) + 1) (1 + k) (by omega) (by omega)).2]
      exact hz₁
    rw [hz₂_map, hπ_zx]

  let φ_𝒩 : ∀ r : ℕ, ℐ r ⟶ M (c + r + 1) :=
    fun r => ι_ℐ r ≫ j_M (r + 1) (c + r + 1) (Nat.le_add_left (r + 1) c)
  let 𝒩 : ℕ → 𝒞 := fun r => image (φ_𝒩 r)
  let q_𝒩 : ∀ r : ℕ, ℐ r ⟶ 𝒩 r := fun r => factorThruImage (φ_𝒩 r)
  let ι_𝒩 : ∀ r : ℕ, 𝒩 r ⟶ M (c + r + 1) := fun r => image.ι (φ_𝒩 r)
  let e_𝒩 : ∀ r : ℕ, M (n₀ + r + 1) ⟶ 𝒩 r := fun r => π_ℐ r ≫ q_𝒩 r
  let 𝒦 : ℕ → 𝒞 := fun r => kernel (q_𝒩 r)
  let ι_𝒦 : ∀ r : ℕ, 𝒦 r ⟶ ℐ r := fun r => kernel.ι (q_𝒩 r)

  have hEpi_e_𝒩 : ∀ r : ℕ, Epi (e_𝒩 r) := fun r => epi_comp (π_ℐ r) (q_𝒩 r)

  have he_𝒩_ι : ∀ r : ℕ,
      e_𝒩 r ≫ ι_𝒩 r =
        τ_M (r + 1) (n₀ + r + 1) (Nat.le_add_left _ _) ≫
          j_M (r + 1) (c + r + 1) (Nat.le_add_left _ _) := by
    intro r
    dsimp [e_𝒩, q_𝒩, ι_𝒩, φ_𝒩, π_ℐ, ι_ℐ, f_ℐ]
    rw [Category.assoc, image.fac, ← Category.assoc, image.fac]

  have hTor_ℐ : ∀ r : ℕ, (ℓ ^ (r + 1)) • 𝟙 (ℐ r) = 0 := by
    intro r
    rw [← cancel_mono (ι_ℐ r), zero_comp, Preadditive.nsmul_comp, Category.id_comp,
      ← Category.comp_id (ι_ℐ r), ← Preadditive.comp_nsmul, hTor_M (r + 1), comp_zero]

  have hTor_𝒩 : ∀ r : ℕ, (ℓ ^ (r + 1)) • 𝟙 (𝒩 r) = 0 := by
    intro r
    rw [← cancel_epi (q_𝒩 r), comp_zero, Preadditive.comp_nsmul, Category.comp_id,
      ← Category.id_comp (q_𝒩 r), ← Preadditive.nsmul_comp, hTor_ℐ r, zero_comp]

  have hTor_𝒦 : ∀ r : ℕ, (ℓ ^ c) • 𝟙 (𝒦 r) = 0 := by
    intro r
    have h_zero : (ι_𝒦 r ≫ ι_ℐ r) ≫ j_M (r + 1) (c + r + 1) (Nat.le_add_left _ _) = 0 := by
      rw [Category.assoc]
      change ι_𝒦 r ≫ φ_𝒩 r = 0
      rw [← image.fac (φ_𝒩 r), ← Category.assoc]
      change (kernel.ι (q_𝒩 r) ≫ q_𝒩 r) ≫ ι_𝒩 r = 0
      rw [kernel.condition, zero_comp]
    have h_post := congrArg (· ≫ τ_M (r + 1) (c + r + 1) (Nat.le_add_left _ _)) h_zero
    rw [zero_comp, Category.assoc,
      (hMul_M (r + 1) (c + r + 1) c (Nat.le_add_left _ _) (Nat.add_comm (r + 1) c)).1,
      Preadditive.comp_nsmul, Category.comp_id, ← Category.id_comp (ι_𝒦 r ≫ ι_ℐ r),
      ← Preadditive.nsmul_comp] at h_post
    have _ : Mono (ι_𝒦 r ≫ ι_ℐ r) := mono_comp (ι_𝒦 r) (ι_ℐ r)
    exact (cancel_mono (ι_𝒦 r ≫ ι_ℐ r)).mp (h_post.trans zero_comp.symm)

  have hSE_𝒦 : ∀ r : ℕ,
      ∃ hK : ι_𝒦 r ≫ q_𝒩 r = 0, (ShortComplex.mk (ι_𝒦 r) (q_𝒩 r) hK).ShortExact := by
    intro r
    refine ⟨kernel.condition (q_𝒩 r), ?_⟩
    exact ShortComplex.ShortExact.mk'
      (ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel (q_𝒩 r)))
      inferInstance inferInstance

  have hτ_𝒩_ex : ∀ r : ℕ,
      ∃ w : 𝒩 (r + 1) ⟶ 𝒩 r,
        w ≫ ι_𝒩 r = ι_𝒩 (r + 1) ≫ τ_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _) ∧
        q_𝒩 (r + 1) ≫ w = τ_ℐ r ≫ q_𝒩 r := by
    intro r
    apply hImageMap (φ_𝒩 (r + 1)) (φ_𝒩 r) (τ_ℐ r)
      (τ_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _))
    dsimp [φ_𝒩]
    rw [Category.assoc,
      hMixed_M (r + 2) (c + (r + 1) + 1) (r + 1) (c + r + 1) c _ _
        (Nat.le_succ _) (Nat.le_succ _) (by omega) (by omega),
      ← Category.assoc, hτ_ℐ_ι r, Category.assoc]

  let τ_𝒩 : ∀ r : ℕ, 𝒩 (r + 1) ⟶ 𝒩 r := fun r => Classical.choose (hτ_𝒩_ex r)
  have hτ_𝒩_ι : ∀ r : ℕ,
      τ_𝒩 r ≫ ι_𝒩 r = ι_𝒩 (r + 1) ≫ τ_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _) :=
    fun r => (Classical.choose_spec (hτ_𝒩_ex r)).1
  have hq_𝒩_τ : ∀ r : ℕ, q_𝒩 (r + 1) ≫ τ_𝒩 r = τ_ℐ r ≫ q_𝒩 r :=
    fun r => (Classical.choose_spec (hτ_𝒩_ex r)).2

  have hEpi_τ_𝒩 : ∀ r : ℕ, Epi (τ_𝒩 r) := by
    intro r
    have _ : Epi (τ_ℐ r) := hEpi_τ_ℐ r
    have _ : Epi (τ_ℐ r ≫ q_𝒩 r) := epi_comp (τ_ℐ r) (q_𝒩 r)
    have _ : Epi (q_𝒩 (r + 1) ≫ τ_𝒩 r) := by rwa [hq_𝒩_τ r]
    exact epi_of_epi (q_𝒩 (r + 1)) (τ_𝒩 r)

  have hι_bock_ex : ∀ r : ℕ,
      ∃ w : 𝒩 r ⟶ 𝒩 (r + 1),
        w ≫ ι_𝒩 (r + 1) = ι_𝒩 r ≫ j_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _) := by
    intro r
    let p_up : M (n₀ + (r + 1) + 1) ⟶ 𝒩 r := (π_ℐ (r + 1) ≫ τ_ℐ r) ≫ q_𝒩 r
    have _ : Epi (τ_ℐ r) := hEpi_τ_ℐ r
    have _ : Epi (π_ℐ (r + 1) ≫ τ_ℐ r) := epi_comp _ _
    have _ : Epi p_up := epi_comp _ _
    let top_map : M (n₀ + (r + 1) + 1) ⟶ 𝒩 (r + 1) :=
      (ℓ • 𝟙 (M (n₀ + (r + 1) + 1))) ≫ e_𝒩 (r + 1)
    have hsq : p_up ≫ (ι_𝒩 r ≫ j_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _)) =
        top_map ≫ ι_𝒩 (r + 1) := by
      dsimp [p_up, top_map]
      rw [Category.assoc, ← Category.assoc (q_𝒩 r), image.fac (φ_𝒩 r)]
      dsimp [φ_𝒩]
      rw [Category.assoc (ι_ℐ r), (hComp_M (r + 1) (c + r + 1) (c + (r + 1) + 1) _ _).1,
        Category.assoc (π_ℐ (r + 1)), ← Category.assoc (τ_ℐ r), hτ_ℐ_ι r,
        Category.assoc (ι_ℐ (r + 1)), ← Category.assoc (π_ℐ (r + 1)), image.fac (f_ℐ (r + 1))]
      have hj_split : j_M (r + 1) (c + (r + 1) + 1) (by omega) =
          j_M (r + 1) (r + 2) (Nat.le_succ _) ≫ j_M (r + 2) (c + (r + 1) + 1) (by omega) :=
        ((hComp_M (r + 1) (r + 2) (c + (r + 1) + 1) _ _).1).symm
      rw [hj_split, ← Category.assoc (τ_M (r + 1) (r + 2) _),
        (hMul_M (r + 1) (r + 2) 1 (Nat.le_succ _) rfl).2, pow_one,
        Category.assoc (ℓ • 𝟙 _), he_𝒩_ι (r + 1)]
      dsimp [f_ℐ]
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Preadditive.nsmul_comp,
        Category.id_comp, Category.id_comp]
    obtain ⟨w, hw, _⟩ := hLiftEpiMono p_up (ι_𝒩 (r + 1)) top_map
      (ι_𝒩 r ≫ j_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _)) hsq
    exact ⟨w, hw⟩

  let ι_bock : ∀ r : ℕ, 𝒩 r ⟶ 𝒩 (r + 1) := fun r => Classical.choose (hι_bock_ex r)
  have hι_bock_ι : ∀ r : ℕ,
      ι_bock r ≫ ι_𝒩 (r + 1) = ι_𝒩 r ≫ j_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _) :=
    fun r => Classical.choose_spec (hι_bock_ex r)

  let ρ_bock : ∀ r : ℕ, 𝒩 (r + 1) ⟶ 𝒩 0 :=
    Nat.rec (τ_𝒩 0) (fun r prev => τ_𝒩 (r + 1) ≫ prev)
  have hρ0 : ρ_bock 0 = τ_𝒩 0 := rfl
  have hρsucc : ∀ r : ℕ, ρ_bock (r + 1) = τ_𝒩 (r + 1) ≫ ρ_bock r := fun _ => rfl

  have hEpi_ρ_bock : ∀ r : ℕ, Epi (ρ_bock r) := by
    intro r
    induction r with
    | zero => exact hEpi_τ_𝒩 0
    | succ r ih =>
      rw [hρsucc r]
      exact @epi_comp _ _ _ _ _ (τ_𝒩 (r + 1)) (hEpi_τ_𝒩 (r + 1)) (ρ_bock r) ih

  have hρ_bock_ι : ∀ r : ℕ,
      ρ_bock r ≫ ι_𝒩 0 = ι_𝒩 (r + 1) ≫ τ_M (c + 1) (c + (r + 1) + 1) (by omega) := by
    intro r
    induction r with
    | zero => exact hτ_𝒩_ι 0
    | succ r ih =>
      rw [hρsucc r, Category.assoc, ih, ← Category.assoc, hτ_𝒩_ι (r + 1), Category.assoc,
        (hComp_M (c + 1) (c + (r + 1) + 1) (c + (r + 2) + 1) _ _).2]

  have hι_τ_𝒩 : ∀ r : ℕ, ι_bock r ≫ τ_𝒩 r = ℓ • 𝟙 (𝒩 r) := by
    intro r
    rw [← cancel_mono (ι_𝒩 r), Category.assoc, hτ_𝒩_ι r, ← Category.assoc, hι_bock_ι r,
      Category.assoc, (hMul_M (c + r + 1) (c + (r + 1) + 1) 1 (Nat.le_succ _) rfl).1, pow_one,
      Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp]

  have hτ_ι_𝒩 : ∀ r : ℕ, τ_𝒩 r ≫ ι_bock r = ι_bock (r + 1) ≫ τ_𝒩 (r + 1) := by
    intro r
    rw [← cancel_mono (ι_𝒩 (r + 1)), Category.assoc, hι_bock_ι r, ← Category.assoc, hτ_𝒩_ι r,
      Category.assoc, (hMul_M (c + r + 1) (c + (r + 1) + 1) 1 (Nat.le_succ _) rfl).2,
      Category.assoc, hτ_𝒩_ι (r + 1), ← Category.assoc, hι_bock_ι (r + 1), Category.assoc,
      (hMul_M (c + (r + 1) + 1) (c + (r + 2) + 1) 1 (Nat.le_succ _) rfl).1]

  have hι_ρ_zero : ∀ r : ℕ, ι_bock r ≫ ρ_bock r = 0 := by
    intro r
    rw [← cancel_mono (ι_𝒩 0), zero_comp, ← cancel_epi (q_𝒩 r), comp_zero,
      Category.assoc, hρ_bock_ι r, ← Category.assoc (ι_bock r), hι_bock_ι r,
      Category.assoc (ι_𝒩 r), ← Category.assoc (q_𝒩 r), image.fac (φ_𝒩 r)]
    dsimp [φ_𝒩]
    rw [Category.assoc, ← Category.assoc (j_M (r + 1) (c + r + 1) _),
      (hComp_M (r + 1) (c + r + 1) (c + (r + 1) + 1) _ _).1,
      hMixed_M (r + 1) (c + (r + 1) + 1) 0 (c + 1) (c + 1) (by omega) (by omega)
        (Nat.zero_le _) (by omega) (by omega) (by omega),
      ← Category.id_comp (j_M 0 (c + 1) _), hId_M0, zero_comp, comp_zero, comp_zero]

  have hMono_ι_bock : ∀ r : ℕ, Mono (ι_bock r) := by
    intro r
    induction r with
    | zero =>
      apply mono_of_zero_of_map_zero
      intro u hu
      obtain ⟨x, rfl⟩ := pseudo_surjective_of_epi (q_𝒩 0) u
      have hj_x_2 : pseudoApply (j_M 1 (1 + (c + 1)) (by omega))
          (pseudoApply (ι_ℐ 0) x) = 0 := by
        have h_eq : ι_ℐ 0 ≫ j_M 1 (1 + (c + 1)) (by omega) =
            ((q_𝒩 0 ≫ ι_bock 0) ≫ ι_𝒩 (0 + 1)) ≫ j_M (c + 1 + 1) (1 + (c + 1)) (by omega) := by
          rw [Category.assoc (q_𝒩 0), hι_bock_ι 0, ← Category.assoc (q_𝒩 0), image.fac (φ_𝒩 0)]
          dsimp [φ_𝒩]
          rw [Category.assoc (ι_ℐ 0), (hComp_M 1 (c + 0 + 1) (c + 1 + 1) _ _).1,
            Category.assoc (ι_ℐ 0), (hComp_M 1 (c + 1 + 1) (1 + (c + 1)) _ _).1]
        rw [← Abelian.Pseudoelement.comp_apply, h_eq,
          Abelian.Pseudoelement.comp_apply, Abelian.Pseudoelement.comp_apply,
          Abelian.Pseudoelement.comp_apply, hu, apply_zero, apply_zero]
      have hj_x_1 : pseudoApply (j_M 1 (1 + c) (by omega)) (pseudoApply (ι_ℐ 0) x) = 0 :=
        hj_stab_zero (c + 1) (Nat.le_succ c) _ hj_x_2
      have hι_u_0 : pseudoApply (ι_𝒩 0) (pseudoApply (q_𝒩 0) x) = 0 := by
        have h_eq1 : q_𝒩 0 ≫ ι_𝒩 0 =
            (ι_ℐ 0 ≫ j_M 1 (1 + c) (by omega)) ≫ j_M (1 + c) (c + 0 + 1) (by omega) := by
          rw [image.fac (φ_𝒩 0)]
          dsimp [φ_𝒩]
          rw [Category.assoc, (hComp_M 1 (1 + c) (c + 0 + 1) _ _).1]
        rw [← Abelian.Pseudoelement.comp_apply, h_eq1,
          Abelian.Pseudoelement.comp_apply, Abelian.Pseudoelement.comp_apply, hj_x_1, apply_zero]
      exact pseudo_injective_of_mono (ι_𝒩 0) (hι_u_0.trans (apply_zero (ι_𝒩 0)).symm)
    | succ r ih =>
      apply mono_of_zero_of_map_zero
      intro v hv
      have h_prev_bock : pseudoApply (ι_bock r) (pseudoApply (τ_𝒩 r) v) = 0 := by
        rw [← Abelian.Pseudoelement.comp_apply, hτ_ι_𝒩 r,
          Abelian.Pseudoelement.comp_apply, hv, apply_zero]
      have h_prev_0 : pseudoApply (τ_𝒩 r) v = 0 :=
        @pseudo_injective_of_mono _ _ _ _ _ (ι_bock r) ih _ _
          (h_prev_bock.trans (apply_zero (ι_bock r)).symm)
      have h_tau_v_0 : pseudoApply (τ_M (c + r + 1) (c + (r + 1) + 1) (Nat.le_succ _))
          (pseudoApply (ι_𝒩 (r + 1)) v) = 0 := by
        rw [← Abelian.Pseudoelement.comp_apply, ← hτ_𝒩_ι r,
          Abelian.Pseudoelement.comp_apply, h_prev_0, apply_zero]
      obtain ⟨_, hEx1_step⟩ := hEx1 1 (c + (r + 1) + 1) (c + r + 1) (by omega)
      obtain ⟨w, hw⟩ := pseudo_exact_of_exact hEx1_step _ h_tau_v_0
      change pseudoApply (j_M 1 (c + (r + 1) + 1) _) w = pseudoApply (ι_𝒩 (r + 1)) v at hw
      have hw_up_0 : pseudoApply (j_M 1 (1 + (c + r + 2)) (by omega)) w = 0 := by
        have h_step_v : pseudoApply (j_M (c + (r + 1) + 1) (c + (r + 1 + 1) + 1) (Nat.le_succ _))
            (pseudoApply (ι_𝒩 (r + 1)) v) = 0 := by
          rw [← Abelian.Pseudoelement.comp_apply, ← hι_bock_ι (r + 1),
            Abelian.Pseudoelement.comp_apply, hv, apply_zero]
        have h_eq : j_M 1 (1 + (c + r + 2)) (by omega) =
            (j_M 1 (c + (r + 1) + 1) (by omega) ≫
              j_M (c + (r + 1) + 1) (c + (r + 1 + 1) + 1) (Nat.le_succ _)) ≫
              j_M (c + (r + 1 + 1) + 1) (1 + (c + r + 2)) (by omega) := by
          rw [(hComp_M 1 (c + (r + 1) + 1) (c + (r + 1 + 1) + 1) _ _).1,
            (hComp_M 1 (c + (r + 1 + 1) + 1) (1 + (c + r + 2)) _ _).1]
        rw [h_eq, Abelian.Pseudoelement.comp_apply, Abelian.Pseudoelement.comp_apply,
          hw, h_step_v, apply_zero]
      have hw_c_0 : pseudoApply (j_M 1 (1 + c) (by omega)) w = 0 :=
        hj_stab_zero (c + r + 2) (by omega) w hw_up_0
      have hι_v_0 : pseudoApply (ι_𝒩 (r + 1)) v = 0 := by
        rw [← hw]
        have h_eq1 : j_M 1 (c + (r + 1) + 1) (by omega) =
            j_M 1 (1 + c) (by omega) ≫ j_M (1 + c) (c + (r + 1) + 1) (by omega) :=
          ((hComp_M 1 (1 + c) (c + (r + 1) + 1) _ _).1).symm
        rw [h_eq1, Abelian.Pseudoelement.comp_apply, hw_c_0, apply_zero]
      exact pseudo_injective_of_mono (ι_𝒩 (r + 1)) (hι_v_0.trans (apply_zero (ι_𝒩 (r + 1))).symm)

  have hSE_bock : ∀ r : ℕ,
      ∃ hB : ι_bock r ≫ ρ_bock r = 0, (ShortComplex.mk (ι_bock r) (ρ_bock r) hB).ShortExact := by
    intro r
    refine ⟨hι_ρ_zero r, ?_⟩
    refine ShortComplex.ShortExact.mk' ?_ (hMono_ι_bock r) (hEpi_ρ_bock r)
    apply exact_of_pseudo_exact
    intro v hv
    change pseudoApply (ρ_bock r) v = 0 at hv
    have _ : Epi (e_𝒩 (r + 1)) := hEpi_e_𝒩 (r + 1)
    obtain ⟨y, rfl⟩ := pseudo_surjective_of_epi (e_𝒩 (r + 1)) v
    set B := c + n₀ + r + 2
    let w₀ := pseudoApply (j_M (n₀ + (r + 1) + 1) B (by omega)) y
    have hw₀_proj : pseudoApply (τ_M (c + (r + 1) + 1) B (by omega)) w₀ =
        pseudoApply (ι_𝒩 (r + 1)) (pseudoApply (e_𝒩 (r + 1)) y) := by
      dsimp [w₀]
      rw [← Abelian.Pseudoelement.comp_apply,
        hMixed_M (n₀ + (r + 1) + 1) B (r + 2) (c + (r + 1) + 1) c (by omega) (by omega)
          (by omega) (by omega) (by omega) (by omega),
        ← he_𝒩_ι (r + 1), Abelian.Pseudoelement.comp_apply]
    have hw₀_base : pseudoApply (τ_M (c + 1) B (by omega)) w₀ = 0 := by
      have h_eq : τ_M (c + 1) B (by omega) =
          τ_M (c + (r + 1) + 1) B (by omega) ≫ τ_M (c + 1) (c + (r + 1) + 1) (by omega) :=
        ((hComp_M (c + 1) (c + (r + 1) + 1) B _ _).2).symm
      rw [h_eq, Abelian.Pseudoelement.comp_apply, hw₀_proj,
        ← Abelian.Pseudoelement.comp_apply, ← hρ_bock_ι r,
        Abelian.Pseudoelement.comp_apply, hv, apply_zero]
    obtain ⟨_, hEx1_B⟩ := hEx1 (n₀ + r + 1) B (c + 1) (by omega)
    obtain ⟨z₀, hz₀⟩ := pseudo_exact_of_exact hEx1_B w₀ hw₀_base
    change pseudoApply (j_M (n₀ + r + 1) B _) z₀ = w₀ at hz₀
    refine ⟨pseudoApply (e_𝒩 r) z₀, ?_⟩
    change pseudoApply (ι_bock r) (pseudoApply (e_𝒩 r) z₀) = pseudoApply (e_𝒩 (r + 1)) y
    apply pseudo_injective_of_mono (ι_𝒩 (r + 1))
    calc pseudoApply (ι_𝒩 (r + 1)) (pseudoApply (ι_bock r) (pseudoApply (e_𝒩 r) z₀))
        = pseudoApply (e_𝒩 r ≫ ι_bock r ≫ ι_𝒩 (r + 1)) z₀ := by
            rw [← Abelian.Pseudoelement.comp_apply, ← Abelian.Pseudoelement.comp_apply]
      _ = pseudoApply (j_M (n₀ + r + 1) B (by omega) ≫ τ_M (c + (r + 1) + 1) B (by omega)) z₀ := by
            congr 1
            rw [hι_bock_ι r, ← Category.assoc, he_𝒩_ι r, Category.assoc,
              (hComp_M (r + 1) (c + r + 1) (c + (r + 1) + 1) _ _).1,
              ← hMixed_M (n₀ + r + 1) B (r + 1) (c + (r + 1) + 1) (c + 1) (by omega) (by omega)
                (by omega) (by omega) (by omega) (by omega)]
      _ = pseudoApply (τ_M (c + (r + 1) + 1) B (by omega)) w₀ := by
            rw [Abelian.Pseudoelement.comp_apply, hz₀]
      _ = pseudoApply (ι_𝒩 (r + 1)) (pseudoApply (e_𝒩 (r + 1)) y) := hw₀_proj

  refine ⟨n₀, c, hn₀_pos, hn₀_le_c, ℐ, 𝒩, 𝒦, π_ℐ, ι_ℐ, τ_ℐ, e_𝒩, ι_𝒩, q_𝒩, ι_𝒦,
    τ_𝒩, ι_bock, ρ_bock, fun r => ?_⟩
  refine ⟨⟨inferInstance, inferInstance, hEpi_τ_ℐ r, hEpi_e_𝒩 r, inferInstance,
      inferInstance, inferInstance⟩,
    ⟨image.fac (f_ℐ r), (hτ_ℐ_ι r).symm, hπ_ℐ_τ r⟩,
    ⟨hTor_ℐ r, hTor_𝒩 r, hTor_𝒦 r⟩,
    ⟨hSE_𝒦 r, hq_𝒩_τ r⟩,
    ⟨hSE_bock r, hι_τ_𝒩 r, hτ_ι_𝒩 r, hρ0, hρsucc r⟩⟩

theorem weil_transv_geom_base_sheaf_frob_action_existence_and_naturality (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (i : ℕ) :
    let S := weilGeomScheme F Y₀
    let pr_Y : Quiver.Hom S Y₀.left :=
      CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    ∀ (hCont_pr : (weilEtaleSitePullback pr_Y).IsContinuous
          Y₀.left.smallEtaleTopology S.smallEtaleTopology)
      (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr).IsRightAdjoint),
      let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
      (∀ (ℱ₀ : CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u})
          (ℱ_bar : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (iso_bar : CategoryTheory.Iso (L_pr.obj ℱ₀) ℱ_bar),
        ∃ (f_act : ℱ_bar.H i →+ ℱ_bar.H i),
          WeilTransvTriIsGeomBaseSheafAction F Y₀ ℱ₀ ℱ_bar hCont_pr hAdj_pr iso_bar i f_act) ∧
      (∀ (ℱ₁ ℱ₂ : CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u})
          (ℱ_bar₁ ℱ_bar₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (iso₁ : CategoryTheory.Iso (L_pr.obj ℱ₁) ℱ_bar₁)
          (iso₂ : CategoryTheory.Iso (L_pr.obj ℱ₂) ℱ_bar₂)
          (f₁ : ℱ_bar₁.H i →+ ℱ_bar₁.H i)
          (f₂ : ℱ_bar₂.H i →+ ℱ_bar₂.H i)
          (ψ₀ : Quiver.Hom ℱ₁ ℱ₂)
          (ψ_bar : Quiver.Hom ℱ_bar₁ ℱ_bar₂),
        WeilTransvTriIsGeomBaseSheafAction F Y₀ ℱ₁ ℱ_bar₁ hCont_pr hAdj_pr iso₁ i f₁ →
        WeilTransvTriIsGeomBaseSheafAction F Y₀ ℱ₂ ℱ_bar₂ hCont_pr hAdj_pr iso₂ i f₂ →
        CategoryTheory.CategoryStruct.comp (L_pr.map ψ₀) iso₂.hom =
          CategoryTheory.CategoryStruct.comp iso₁.hom ψ_bar →
        ∀ (x : ℱ_bar₁.H i),
          ((CategoryTheory.Abelian.Ext.mk₀ ψ_bar).postcomp Fℤ (Nat.add_zero i)) (f₁ x) =
            f₂ (((CategoryTheory.Abelian.Ext.mk₀ ψ_bar).postcomp Fℤ (Nat.add_zero i)) x)) :=
by
  
  have hPillar2 :
      ∀ (C D : Type (u + 1))
        [CategoryTheory.Category.{u + 1, u + 1} C]
        [CategoryTheory.Category.{u + 1, u + 1} D]
        (L : CategoryTheory.Functor C D)
        (R : CategoryTheory.Functor D C)
        (adj : L ⊣ R)
        (P : CategoryTheory.Functor D D)
        [P.IsEquivalence]
        (Θ : CategoryTheory.Iso R (CategoryTheory.Functor.comp P R)),
        (∀ (X : C) (Y : D) (iso_Y : CategoryTheory.Iso (L.obj X) Y),
          ∃ (α_bar : Quiver.Hom Y (P.obj Y)) (β_bar : Quiver.Hom (P.obj Y) Y),
            CategoryTheory.CategoryStruct.comp α_bar β_bar = CategoryTheory.CategoryStruct.id Y ∧
            CategoryTheory.CategoryStruct.comp β_bar α_bar = CategoryTheory.CategoryStruct.id (P.obj Y) ∧
            adj.homEquiv X (P.obj Y) (CategoryTheory.CategoryStruct.comp iso_Y.hom α_bar) =
              CategoryTheory.CategoryStruct.comp (adj.homEquiv X Y iso_Y.hom) (Θ.hom.app Y) ∧
            ∀ (α' : Quiver.Hom Y (P.obj Y)) (β' : Quiver.Hom (P.obj Y) Y),
              CategoryTheory.CategoryStruct.comp β' α' = CategoryTheory.CategoryStruct.id (P.obj Y) →
              adj.homEquiv X (P.obj Y) (CategoryTheory.CategoryStruct.comp iso_Y.hom α') =
                CategoryTheory.CategoryStruct.comp (adj.homEquiv X Y iso_Y.hom) (Θ.hom.app Y) →
              α' = α_bar ∧ β' = β_bar) ∧
        (∀ (X₁ X₂ : C) (Y₁ Y₂ : D)
            (iso₁ : CategoryTheory.Iso (L.obj X₁) Y₁)
            (iso₂ : CategoryTheory.Iso (L.obj X₂) Y₂)
            (ψ₀ : Quiver.Hom X₁ X₂) (ψ_bar : Quiver.Hom Y₁ Y₂)
            (α₁ : Quiver.Hom Y₁ (P.obj Y₁)) (β₁ : Quiver.Hom (P.obj Y₁) Y₁)
            (α₂ : Quiver.Hom Y₂ (P.obj Y₂)) (β₂ : Quiver.Hom (P.obj Y₂) Y₂),
          CategoryTheory.CategoryStruct.comp β₁ α₁ = CategoryTheory.CategoryStruct.id (P.obj Y₁) →
          CategoryTheory.CategoryStruct.comp β₂ α₂ = CategoryTheory.CategoryStruct.id (P.obj Y₂) →
          adj.homEquiv X₁ (P.obj Y₁) (CategoryTheory.CategoryStruct.comp iso₁.hom α₁) =
            CategoryTheory.CategoryStruct.comp (adj.homEquiv X₁ Y₁ iso₁.hom) (Θ.hom.app Y₁) →
          adj.homEquiv X₂ (P.obj Y₂) (CategoryTheory.CategoryStruct.comp iso₂.hom α₂) =
            CategoryTheory.CategoryStruct.comp (adj.homEquiv X₂ Y₂ iso₂.hom) (Θ.hom.app Y₂) →
          CategoryTheory.CategoryStruct.comp (L.map ψ₀) iso₂.hom =
            CategoryTheory.CategoryStruct.comp iso₁.hom ψ_bar →
          CategoryTheory.CategoryStruct.comp (P.map ψ_bar) β₂ =
            CategoryTheory.CategoryStruct.comp β₁ ψ_bar) := by
    intro C D _ _ L R adj P _ Θ
    let e_P : D ≌ D := P.asEquivalence.symm
    let adj_P : e_P.functor ⊣ P := e_P.toAdjunction
    let adj₂ : CategoryTheory.Functor.comp L e_P.functor ⊣ CategoryTheory.Functor.comp P R :=
      adj.comp adj_P
    let γ_iso : CategoryTheory.Iso (CategoryTheory.Functor.comp L e_P.functor) L :=
      (CategoryTheory.conjugateIsoEquiv adj adj₂).symm Θ
    let iso₀ : ∀ X : C, CategoryTheory.Iso (L.obj X) (P.obj (L.obj X)) :=
      fun X => (e_P.unitIso.app (L.obj X)).trans (P.mapIso (γ_iso.app X))
    have hadj₀ : ∀ X : C,
        adj.homEquiv X (P.obj (L.obj X)) (iso₀ X).hom =
          CategoryTheory.CategoryStruct.comp (adj.unit.app X) (Θ.hom.app (L.obj X)) := by
      intro X
      have h1 : (iso₀ X).hom =
          adj_P.homEquiv (L.obj X) (L.obj X) (γ_iso.hom.app X) := by
        dsimp [iso₀]
        rw [adj_P.homEquiv_unit]
        rfl
      have h2 : γ_iso.hom.app X =
          (adj₂.homEquiv X (L.obj X)).symm
            (CategoryTheory.CategoryStruct.comp (adj.unit.app X) (Θ.hom.app (L.obj X))) := by
        dsimp [γ_iso]
        rw [CategoryTheory.conjugateIsoEquiv_symm_apply_hom,
          CategoryTheory.conjugateEquiv_symm_apply_app,
          ← CategoryTheory.Category.assoc,
          ← (CategoryTheory.Functor.comp L e_P.functor).map_comp,
          adj₂.homEquiv_counit]
      have hcomp : adj₂.homEquiv X (L.obj X) =
          (adj_P.homEquiv (L.obj X) (L.obj X)).trans (adj.homEquiv X (P.obj (L.obj X))) :=
        congrFun (congrFun (CategoryTheory.Adjunction.comp_homEquiv adj adj_P) X) (L.obj X)
      rw [h1]
      exact (congrArg (fun e => e (γ_iso.hom.app X)) hcomp.symm).trans
        (by rw [h2, Equiv.apply_symm_apply])
    have hα₀_nat : ∀ {X₁ X₂ : C} (ψ₀ : Quiver.Hom X₁ X₂),
        CategoryTheory.CategoryStruct.comp (L.map ψ₀) (iso₀ X₂).hom =
          CategoryTheory.CategoryStruct.comp (iso₀ X₁).hom (P.map (L.map ψ₀)) := by
      intro X₁ X₂ ψ₀
      apply (adj.homEquiv_naturality_left_square_iff ψ₀ (iso₀ X₂).hom (iso₀ X₁).hom
        (P.map (L.map ψ₀))).mp
      have hunit : CategoryTheory.CategoryStruct.comp ψ₀ (adj.unit.app X₂) =
          CategoryTheory.CategoryStruct.comp (adj.unit.app X₁) (R.map (L.map ψ₀)) :=
        adj.unit.naturality ψ₀
      rw [hadj₀ X₁, hadj₀ X₂, ← CategoryTheory.Category.assoc, hunit,
        CategoryTheory.Category.assoc]
      have hθ := Θ.hom.naturality (L.map ψ₀)
      change CategoryTheory.CategoryStruct.comp (adj.unit.app X₁)
          (CategoryTheory.CategoryStruct.comp (R.map (L.map ψ₀)) (Θ.hom.app (L.obj X₂))) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (adj.unit.app X₁) (Θ.hom.app (L.obj X₁)))
          ((CategoryTheory.Functor.comp P R).map (L.map ψ₀))
      rw [hθ, CategoryTheory.Category.assoc]
    have hβ₀_nat : ∀ {X₁ X₂ : C} (ψ₀ : Quiver.Hom X₁ X₂),
        CategoryTheory.CategoryStruct.comp (P.map (L.map ψ₀)) (iso₀ X₂).inv =
          CategoryTheory.CategoryStruct.comp (iso₀ X₁).inv (L.map ψ₀) := by
      intro X₁ X₂ ψ₀
      calc CategoryTheory.CategoryStruct.comp (P.map (L.map ψ₀)) (iso₀ X₂).inv
          = CategoryTheory.CategoryStruct.comp (iso₀ X₁).inv
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (iso₀ X₁).hom (P.map (L.map ψ₀)))
                (iso₀ X₂).inv) := by
            rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              (iso₀ X₁).inv_hom_id, CategoryTheory.Category.id_comp]
        _ = CategoryTheory.CategoryStruct.comp (iso₀ X₁).inv
              (CategoryTheory.CategoryStruct.comp (L.map ψ₀)
                (CategoryTheory.CategoryStruct.comp (iso₀ X₂).hom (iso₀ X₂).inv)) := by
            rw [← hα₀_nat ψ₀, CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp (iso₀ X₁).inv (L.map ψ₀) := by
            rw [(iso₀ X₂).hom_inv_id, CategoryTheory.Category.comp_id]
    let iso_can : ∀ (X : C) (Y : D) (iso_Y : CategoryTheory.Iso (L.obj X) Y),
        CategoryTheory.Iso Y (P.obj Y) :=
      fun X Y iso_Y => iso_Y.symm.trans ((iso₀ X).trans (P.mapIso iso_Y))
    have hadj_can : ∀ (X : C) (Y : D) (iso_Y : CategoryTheory.Iso (L.obj X) Y),
        adj.homEquiv X (P.obj Y)
          (CategoryTheory.CategoryStruct.comp iso_Y.hom (iso_can X Y iso_Y).hom) =
        CategoryTheory.CategoryStruct.comp (adj.homEquiv X Y iso_Y.hom) (Θ.hom.app Y) := by
      intro X Y iso_Y
      have hhom : CategoryTheory.CategoryStruct.comp iso_Y.hom (iso_can X Y iso_Y).hom =
          CategoryTheory.CategoryStruct.comp (iso₀ X).hom (P.map iso_Y.hom) := by
        dsimp [iso_can]
        rw [← CategoryTheory.Category.assoc, iso_Y.hom_inv_id, CategoryTheory.Category.id_comp]
      rw [hhom, adj.homEquiv_unit, adj.homEquiv_unit, R.map_comp,
        ← CategoryTheory.Category.assoc, ← adj.homEquiv_unit, hadj₀ X,
        CategoryTheory.Category.assoc]
      have hθ := (Θ.hom.naturality iso_Y.hom).symm
      change CategoryTheory.CategoryStruct.comp (adj.unit.app X)
          (CategoryTheory.CategoryStruct.comp (Θ.hom.app (L.obj X))
            ((CategoryTheory.Functor.comp P R).map iso_Y.hom)) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (adj.unit.app X) (R.map iso_Y.hom))
          (Θ.hom.app Y)
      rw [hθ, CategoryTheory.Category.assoc]
    have hUniq : ∀ (X : C) (Y : D) (iso_Y : CategoryTheory.Iso (L.obj X) Y)
        (α' : Quiver.Hom Y (P.obj Y)) (β' : Quiver.Hom (P.obj Y) Y),
        CategoryTheory.CategoryStruct.comp β' α' = CategoryTheory.CategoryStruct.id (P.obj Y) →
        adj.homEquiv X (P.obj Y) (CategoryTheory.CategoryStruct.comp iso_Y.hom α') =
          CategoryTheory.CategoryStruct.comp (adj.homEquiv X Y iso_Y.hom) (Θ.hom.app Y) →
        α' = (iso_can X Y iso_Y).hom ∧ β' = (iso_can X Y iso_Y).inv := by
      intro X Y iso_Y α' β' hβα' hadj'
      have hcomp := (adj.homEquiv X (P.obj Y)).injective
        (hadj'.trans (hadj_can X Y iso_Y).symm)
      have hα : α' = (iso_can X Y iso_Y).hom :=
        (CategoryTheory.Iso.cancel_iso_hom_left iso_Y α' (iso_can X Y iso_Y).hom).mp hcomp
      refine ⟨hα, ?_⟩
      calc β' = CategoryTheory.CategoryStruct.comp β'
            (CategoryTheory.CategoryStruct.comp
              (iso_can X Y iso_Y).hom (iso_can X Y iso_Y).inv) := by
              rw [(iso_can X Y iso_Y).hom_inv_id, CategoryTheory.Category.comp_id]
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp β' α')
              (iso_can X Y iso_Y).inv := by
              rw [← hα, CategoryTheory.Category.assoc]
        _ = (iso_can X Y iso_Y).inv := by
              rw [hβα', CategoryTheory.Category.id_comp]
    refine ⟨fun X Y iso_Y =>
      ⟨(iso_can X Y iso_Y).hom, (iso_can X Y iso_Y).inv,
        (iso_can X Y iso_Y).hom_inv_id, (iso_can X Y iso_Y).inv_hom_id,
        hadj_can X Y iso_Y, hUniq X Y iso_Y⟩, ?_⟩
    intro X₁ X₂ Y₁ Y₂ iso₁ iso₂ ψ₀ ψ_bar α₁ β₁ α₂ β₂ hβα₁ hβα₂ hadj₁ hadj₂ hψ_comm
    have hβ₁ := (hUniq X₁ Y₁ iso₁ α₁ β₁ hβα₁ hadj₁).2
    have hβ₂ := (hUniq X₂ Y₂ iso₂ α₂ β₂ hβα₂ hadj₂).2
    have hψ_eq : ψ_bar = CategoryTheory.CategoryStruct.comp iso₁.inv
        (CategoryTheory.CategoryStruct.comp (L.map ψ₀) iso₂.hom) := by
