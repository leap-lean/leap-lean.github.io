            X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a' ≤ D a')).op ≫
              θ_res := by
          dsimp only [φ_top, AlgebraicGeometry.Scheme.Hom.appLE, θ_res]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
          have hnat := ((D a').ι.naturality
            (CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a' ≤ D a')).op) =≫
            (D a').toScheme.presheaf.map (CategoryTheory.eqToHom hPre_eq.symm).op
          simp only [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp] at hnat
          have hmor : (CategoryTheory.homOfLE (fun z (_ : z ∈ (⊤ : (D a').toScheme.Opens)) => z.2)).op ≫
              (CategoryTheory.homOfLE (le_top : V_aa' ≤ ⊤)).op =
              (((TopologicalSpace.Opens.map (D a').ι.base).map
                (CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a' ≤ D a')).op.unop).op ≫
                (CategoryTheory.eqToHom hPre_eq.symm).op) := by
            rw [← op_comp, ← op_comp]
            exact congrArg Opposite.op (Subsingleton.elim _ _)
          rw [hmor]
          exact hnat.symm
        exact congrArg CommRingCat.Hom.hom hcat_R
      have hbij_res : Function.Bijective iso_res.hom.hom :=
        iso_res.commRingCatIsoToRingEquiv.bijective
      rw [h_app_L, h_app_R, ← Ideal.comap_comap, ← Ideal.map_map,
        Ideal.comap_map_of_bijective _ hbij_res]

    have hℐ_chart : ∀ a : Fin (N + 1), ℐ.ideal ⟨D a, hAff_R a⟩ = I_chart a := by
      intro a
      dsimp only [ℐ]
      rw [hInf_ideal]
      apply le_antisymm
      · apply le_trans (Finset.inf_le (Finset.mem_univ a))
        rw [hK_chart a a]
        have hhom_eq : CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a ≤ D a) =
            CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a ≤ D a) :=
          Subsingleton.elim _ _
        rw [hhom_eq]
        have hiso_diag : CategoryTheory.IsIso
            (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a ≤ D a)).op) := by
          have heq_diag : CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a ≤ D a) =
              CategoryTheory.eqToHom (inf_idem (D a)) := Subsingleton.elim _ _
          rw [heq_diag]
          exact (X.presheaf.mapIso (CategoryTheory.eqToIso (inf_idem (D a))).op).isIso_hom
        let e_diag := CategoryTheory.asIso
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a ≤ D a)).op)
        have hbij_diag : Function.Bijective e_diag.hom.hom :=
          e_diag.commRingCatIsoToRingEquiv.bijective
        exact le_of_eq (Ideal.comap_map_of_bijective _ hbij_diag)
      · apply Finset.le_inf
        intro a' _
        rw [hK_chart a a']
        dsimp only [I_chart]
        rw [Ideal.span_le, Set.range_subset_iff]
        intro ν
        change g_R a ν ∈ Ideal.comap _ _
        rw [Ideal.mem_comap, ← hg_trans a a' ν]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨ν, rfl⟩))

    have hSubEx : ∃ (Z_R : AlgebraicGeometry.Scheme.{u}) (ι_Z : Z_R ⟶ X),
        AlgebraicGeometry.IsClosedImmersion ι_Z ∧ ι_Z.ker = ℐ :=
      ⟨ℐ.subscheme, ℐ.subschemeι, inferInstance,
        AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι ℐ⟩
    rcases hSubEx with ⟨Z_R, ι_Z, hClosed_Z, hKer_Z⟩
    refine ⟨Z_R, ι_Z, hClosed_Z, fun a => ?_⟩
    exact @hChartPresOfKer X Z_R ι_Z hClosed_Z (D a) (hAff_R a) (I_chart a)
      ((congrArg (fun J : X.IdealSheafData => J.ideal ⟨D a, hAff_R a⟩) hKer_Z).trans (hℐ_chart a))

  · 
    
    
    intro R _ N hAff_R c_R t_R hCoord_R Z_R ι_Z _ L g_R Z'_R ι_Z' _ L' g'_R hPres hPres' hLe
    let X := (weilProjectiveSpaceOver R N).left
    let U_cov : Fin (N + 1) → X.affineOpens := fun a => ⟨weilProjBasicOpen R N a, hAff_R a⟩
    have hU_top : (⨆ a : Fin (N + 1), (U_cov a : X.Opens)) = ⊤ := hCoord_R.2.1
    have hKer_le : ι_Z.ker ≤ ι_Z'.ker := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top U_cov hU_top
      intro a
      rcases hPres a with ⟨e_a, he_a⟩
      rcases hPres' a with ⟨e'_a, he'_a⟩
      rw [(hKerOfChartPres ι_Z (hAff_R a) _ e_a he_a).2,
        (hKerOfChartPres ι_Z' (hAff_R a) _ e'_a he'_a).2]
      exact hLe a
    let j_sub : Z'_R ⟶ Z_R := AlgebraicGeometry.IsClosedImmersion.lift ι_Z ι_Z' hKer_le
    have hj_fac : j_sub ≫ ι_Z = ι_Z' :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac ι_Z ι_Z' hKer_le
    have _ : AlgebraicGeometry.IsClosedImmersion (j_sub ≫ ι_Z) := by
      rw [hj_fac]; infer_instance
    exact ⟨j_sub, AlgebraicGeometry.IsClosedImmersion.of_comp_isClosedImmersion j_sub ι_Z, hj_fac⟩

  · 
    
    
    intro R S _ _ φ_RS N hAff_R c_R t_R hAff_S c_S t_S Φ hCoord_R hCoord_S hBC
      L Z_R ι_Z _ g_R Z_S ι_ZS _ g_S hPres_R hPres_S hMap_g
    let P_R := (weilProjectiveSpaceOver R N).left
    let P_S := (weilProjectiveSpaceOver S N).left
    let D_R : Fin (N + 1) → P_R.Opens := weilProjBasicOpen R N
    let D_S : Fin (N + 1) → P_S.Opens := weilProjBasicOpen S N

    have _ : AlgebraicGeometry.IsAffineHom Φ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hBC.2.1.flip inferInstance
    have _ : AlgebraicGeometry.QuasiCompact (ι_ZS ≫ Φ) := inferInstance
    let U_covR : Fin (N + 1) → P_R.affineOpens := fun a => ⟨D_R a, hAff_R a⟩
    have hKer_BC : ι_Z.ker ≤ (ι_ZS ≫ Φ).ker := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top U_covR hCoord_R.2.1
      intro a
      rcases hPres_R a with ⟨e_a, he_a⟩
      rcases hPres_S a with ⟨e_Sa, he_Sa⟩
      rcases hMap_g a with ⟨heq_a, hg_a⟩
      rw [(hKerOfChartPres ι_Z (hAff_R a) _ e_a he_a).2,
        AlgebraicGeometry.Scheme.Hom.ker_apply (ι_ZS ≫ Φ) (U_covR a)]
      have hker_S : RingHom.ker (ι_ZS.app (D_S a)).hom = Ideal.span (Set.range (g_S a)) :=
        (hKerOfChartPres ι_ZS (hAff_S a) _ e_Sa he_Sa).1
      rw [Ideal.span_le, Set.range_subset_iff]
      intro ν
      change ((ι_ZS ≫ Φ).app (D_R a)).hom (g_R a ν) = 0
      let iso_Z_open : Z_S.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map ι_ZS.base).obj
            ((TopologicalSpace.Opens.map Φ.base).obj (D_R a)))) ≅
          Z_S.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map ι_ZS.base).obj (D_S a))) :=
        Z_S.presheaf.mapIso
          (CategoryTheory.eqToIso
            (congrArg (TopologicalSpace.Opens.map ι_ZS.base).obj heq_a.symm)).op
      have hcomp_nat : ((ι_ZS ≫ Φ).app (D_R a)) ≫ iso_Z_open.hom =
          (Φ.app (D_R a) ≫ P_S.presheaf.map (CategoryTheory.eqToHom heq_a.symm).op) ≫
            ι_ZS.app (D_S a) := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_app]
        change (Φ.app (D_R a) ≫ ι_ZS.app ((TopologicalSpace.Opens.map Φ.base).obj (D_R a))) ≫
            iso_Z_open.hom =
          Φ.app (D_R a) ≫ P_S.presheaf.map (CategoryTheory.eqToHom heq_a.symm).op ≫
            ι_ZS.app (D_S a)
        rw [CategoryTheory.Category.assoc]
        congr 1
        exact (ι_ZS.naturality (CategoryTheory.eqToHom heq_a.symm).op).symm
      have h_eval0 : (((ι_ZS ≫ Φ).app (D_R a)) ≫ iso_Z_open.hom).hom (g_R a ν) = 0 := by
        rw [hcomp_nat]
        change (ι_ZS.app (D_S a)).hom
          ((Φ.app (D_R a) ≫ P_S.presheaf.map (CategoryTheory.eqToHom heq_a.symm).op).hom
            (g_R a ν)) = 0
        rw [hg_a ν, ← RingHom.mem_ker, hker_S]
        exact Ideal.subset_span ⟨ν, rfl⟩
      have hker_iso := @hKerCompIso _ _ _ ((ι_ZS ≫ Φ).app (D_R a)) iso_Z_open.hom iso_Z_open.isIso_hom
      exact RingHom.mem_ker.mp (hker_iso ▸ RingHom.mem_ker.mpr h_eval0)

    let ψ_Z : Z_S ⟶ Z_R := AlgebraicGeometry.IsClosedImmersion.lift ι_Z (ι_ZS ≫ Φ) hKer_BC
    have hComm : ψ_Z ≫ ι_Z = ι_ZS ≫ Φ :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac ι_Z (ι_ZS ≫ Φ) hKer_BC

    have hQuotSpecPB : ∀ {A B : CommRingCat.{u}} (ρ : A ⟶ B) (I : Ideal ↑A) (J : Ideal ↑B)
        (hIJ : Ideal.map ρ.hom I = J)
        (hzero : ∀ x ∈ I, ((Ideal.Quotient.mk J).comp ρ.hom) x = 0),
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp ρ.hom) hzero)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
          (AlgebraicGeometry.Spec.map ρ) := by
      intro A B ρ I J hIJ hzero
      let ρ_bar : ↑A ⧸ I →+* ↑B ⧸ J :=
        Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp ρ.hom) hzero
      apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
      have hcomm_ring : CommRingCat.ofHom (Ideal.Quotient.mk I) ≫ CommRingCat.ofHom ρ_bar =
          ρ ≫ CommRingCat.ofHom (Ideal.Quotient.mk J) := by
        ext x
        rfl
      refine CategoryTheory.IsPushout.of_isColimit
        (c := CategoryTheory.Limits.PushoutCocone.mk
          (CommRingCat.ofHom ρ_bar) (CommRingCat.ofHom (Ideal.Quotient.mk J)) hcomm_ring) ?_
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_ring
        (fun s => CommRingCat.ofHom (Ideal.Quotient.lift J s.inr.hom (by
          change J ≤ RingHom.ker s.inr.hom
          rw [← hIJ, Ideal.map_le_iff_le_comap]
          intro x hx
          rw [Ideal.mem_comap, RingHom.mem_ker]
          have hcond : (ρ ≫ s.inr).hom x =
              (CommRingCat.ofHom (Ideal.Quotient.mk I) ≫ s.inl).hom x :=
            congrArg (fun m => m.hom x) s.condition.symm
          change (ρ ≫ s.inr).hom x = 0
          rw [hcond]
          change s.inl.hom (Ideal.Quotient.mk I x) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero])))
        (fun s => by
          apply CommRingCat.hom_ext
          apply Ideal.Quotient.ringHom_ext
          ext x
          exact congrArg (fun m => m.hom x) s.condition.symm)
        (fun s => by
          apply CommRingCat.hom_ext
          ext b
          rfl)
        (fun s m hm_inl hm_inr => by
          apply CommRingCat.hom_ext
          apply Ideal.Quotient.ringHom_ext
          ext b
          exact congrArg (fun f => f.hom b) hm_inr)

    let Q_Z := CategoryTheory.Limits.pullback ι_Z Φ
    let π_lift : Z_S ⟶ Q_Z := CategoryTheory.Limits.pullback.lift ψ_Z ι_ZS hComm
    let O_R : Fin (N + 1) → Z_R.Opens :=
      fun a => (TopologicalSpace.Opens.map ι_Z.base).obj (D_R a)
    let W : Fin (N + 1) → Q_Z.Opens :=
      fun a => (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst ι_Z Φ).base).obj
        (O_R a)
    have hW_top : (⨆ a : Fin (N + 1), W a) = ⊤ := by
      rw [eq_top_iff]
      intro q _
      have htop : (CategoryTheory.Limits.pullback.fst ι_Z Φ ≫ ι_Z).base q ∈ (⊤ : P_R.Opens) :=
        trivial
      rw [← hCoord_R.2.1, TopologicalSpace.Opens.mem_iSup] at htop
      rcases htop with ⟨a, ha⟩
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩

    have hIso_π : CategoryTheory.IsIso π_lift := by
      refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) W hW_top).mpr ?_
      intro a
      change CategoryTheory.IsIso (π_lift ∣_ W a)
      rcases hPres_R a with ⟨e_a, he_a⟩
      rcases hPres_S a with ⟨e_Sa, he_Sa⟩
      rcases hMap_g a with ⟨heq_a, hg_a⟩
      let I_a : Ideal ↑(P_R.presheaf.obj (Opposite.op (D_R a))) := Ideal.span (Set.range (g_R a))
      let J_a : Ideal ↑(P_S.presheaf.obj (Opposite.op (D_S a))) := Ideal.span (Set.range (g_S a))
      let O_Sa : Z_S.Opens := (TopologicalSpace.Opens.map ι_ZS.base).obj (D_S a)
      let V_Sa : P_S.Opens := (TopologicalSpace.Opens.map Φ.base).obj (D_R a)
      let O'_Sa : Z_S.Opens := (TopologicalSpace.Opens.map π_lift.base).obj (W a)

      have hPB_topQ : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a)
          (W a).ι (O_R a).ι (CategoryTheory.Limits.pullback.fst ι_Z Φ) :=
        AlgebraicGeometry.isPullback_morphismRestrict
          (CategoryTheory.Limits.pullback.fst ι_Z Φ) (O_R a)
      have hPB_pasteQ : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a)
          ((W a).ι ≫ CategoryTheory.Limits.pullback.snd ι_Z Φ)
          ((O_R a).ι ≫ ι_Z) Φ :=
        hPB_topQ.paste_vert (CategoryTheory.IsPullback.of_hasPullback ι_Z Φ)
      have hWa_le_snd : W a ≤
          (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.snd ι_Z Φ).base).obj V_Sa := by
        intro q hq
        change ((CategoryTheory.Limits.pullback.snd ι_Z Φ ≫ Φ).base q) ∈ D_R a
        rw [← CategoryTheory.Limits.pullback.condition]
        exact hq
      let q_snd : (W a).toScheme ⟶ V_Sa.toScheme :=
        Q_Z.homOfLE hWa_le_snd ≫ (CategoryTheory.Limits.pullback.snd ι_Z Φ ∣_ V_Sa)
      have hq_snd_ι : q_snd ≫ V_Sa.ι = (W a).ι ≫ CategoryTheory.Limits.pullback.snd ι_Z Φ := by
        dsimp only [q_snd]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      have hWa_sq_comm : (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a) ≫ (ι_Z ∣_ D_R a) =
          q_snd ≫ (Φ ∣_ D_R a) := by
        rw [← cancel_mono (D_R a).ι]
        simp only [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι]
        rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a),
          AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
        change ((W a).ι ≫ CategoryTheory.Limits.pullback.snd ι_Z Φ) ≫ Φ =
          (q_snd ≫ V_Sa.ι) ≫ Φ
        rw [hq_snd_ι]
      have hPB_Wa : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a)
          q_snd (ι_Z ∣_ D_R a) (Φ ∣_ D_R a) := by
        apply CategoryTheory.IsPullback.of_bot _ hWa_sq_comm
          (AlgebraicGeometry.isPullback_morphismRestrict Φ (D_R a))
        rwa [hq_snd_ι, AlgebraicGeometry.morphismRestrict_ι]

      let ρ_a : P_R.presheaf.obj (Opposite.op (D_R a)) ⟶ P_S.presheaf.obj (Opposite.op (D_S a)) :=
        Φ.appLE (D_R a) (D_S a) (le_of_eq heq_a.symm)
      have hρ_eq : ρ_a =
          Φ.app (D_R a) ≫ P_S.presheaf.map (CategoryTheory.eqToHom heq_a.symm).op := by
        dsimp only [ρ_a, AlgebraicGeometry.Scheme.Hom.appLE]
        congr 2
      have hIJ_a : Ideal.map ρ_a.hom I_a = J_a := by
        dsimp only [I_a, J_a]
        rw [Ideal.map_span, ← Set.range_comp]
        congr 1
        congr 1
        funext ν
        exact (congrArg (fun m => m.hom (g_R a ν)) hρ_eq).trans (hg_a ν)
      have hzero_bar_a : ∀ x ∈ I_a, ((Ideal.Quotient.mk J_a).comp ρ_a.hom) x = 0 := by
        have hle_bar : I_a ≤ RingHom.ker ((Ideal.Quotient.mk J_a).comp ρ_a.hom) := by
          rw [← RingHom.comap_ker, Ideal.mk_ker, ← Ideal.map_le_iff_le_comap, hIJ_a]
        exact fun x hx => hle_bar hx
      have hSpecPB_a := hQuotSpecPB ρ_a I_a J_a hIJ_a hzero_bar_a
      let ρ_bar_a : ↑(P_R.presheaf.obj (Opposite.op (D_R a))) ⧸ I_a →+*
          ↑(P_S.presheaf.obj (Opposite.op (D_S a))) ⧸ J_a :=
        Ideal.Quotient.lift I_a ((Ideal.Quotient.mk J_a).comp ρ_a.hom) hzero_bar_a

      have hRange_V : Set.range V_Sa.ι.base = Set.range (D_S a).ι.base := by
        simp only [Scheme.Opens.range_ι]
        exact congrArg SetLike.coe heq_a
      let e_V : V_Sa.toScheme ≅ (D_S a).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq V_Sa.ι (D_S a).ι hRange_V
      have he_V_fac : e_V.hom ≫ (D_S a).ι = V_Sa.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac V_Sa.ι (D_S a).ι hRange_V

      have hO'_eq : O'_Sa = O_Sa := by
        ext z
        change (π_lift ≫ CategoryTheory.Limits.pullback.fst ι_Z Φ ≫ ι_Z).base z ∈ D_R a ↔
          ι_ZS.base z ∈ D_S a
        have hcomp_z : π_lift ≫ CategoryTheory.Limits.pullback.fst ι_Z Φ ≫ ι_Z = ι_ZS ≫ Φ := by
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hComm]
        rw [hcomp_z]
        change z ∈ (TopologicalSpace.Opens.map ι_ZS.base).obj
          ((TopologicalSpace.Opens.map Φ.base).obj (weilProjBasicOpen R N a)) ↔
          z ∈ (TopologicalSpace.Opens.map ι_ZS.base).obj (weilProjBasicOpen S N a)
        rw [heq_a]
      have hRange_O' : Set.range O'_Sa.ι.base = Set.range O_Sa.ι.base := by
        simp only [Scheme.Opens.range_ι]
        exact congrArg SetLike.coe hO'_eq
      let e_O' : O'_Sa.toScheme ≅ O_Sa.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq O'_Sa.ι O_Sa.ι hRange_O'
      have he_O'_fac : e_O'.hom ≫ O_Sa.ι = O'_Sa.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac O'_Sa.ι O_Sa.ι hRange_O'

      have _ : AlgebraicGeometry.IsOpenImmersion (hAff_R a).fromSpec := by
        rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
        infer_instance
      have _ : AlgebraicGeometry.IsOpenImmersion (hAff_S a).fromSpec := by
        rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
        infer_instance
      have _ : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_a))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_quotient_mk I_a

      have hSq_right : (ι_Z ∣_ D_R a) ≫ (hAff_R a).isoSpec.hom =
          e_a.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_a)) := by
        rw [← cancel_mono (hAff_R a).fromSpec]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec,
          AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        exact he_a

      have hSq_bot : (Φ ∣_ D_R a) ≫ (hAff_R a).isoSpec.hom =
          (e_V ≪≫ (hAff_S a).isoSpec).hom ≫ AlgebraicGeometry.Spec.map ρ_a := by
        rw [← cancel_mono (hAff_R a).fromSpec]
        rw [CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec,
          AlgebraicGeometry.morphismRestrict_ι,
          AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ (hAff_R a) (hAff_S a)
            (le_of_eq heq_a.symm)]
        simp only [CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc ((hAff_S a).isoSpec.hom),
          AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec,
          ← CategoryTheory.Category.assoc, he_V_fac]

      have hSq_left : ((π_lift ∣_ W a) ≫ q_snd) ≫ (e_V ≪≫ (hAff_S a).isoSpec).hom =
          (e_O' ≪≫ e_Sa).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_a)) := by
        rw [← cancel_mono (hAff_S a).fromSpec]
        simp only [CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec]
        rw [he_V_fac, hq_snd_ι,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        change O'_Sa.ι ≫ ι_ZS = e_O'.hom ≫ (e_Sa.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
          (hAff_S a).fromSpec)
        rw [← he_Sa, ← CategoryTheory.Category.assoc, he_O'_fac]

      have hSq_top : ((π_lift ∣_ W a) ≫ (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a)) ≫
            e_a.hom =
          (e_O' ≪≫ e_Sa).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar_a) := by
        rw [← cancel_mono (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_a))),
          ← cancel_mono (hAff_R a).fromSpec]
        simp only [CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc]
        change (π_lift ∣_ W a) ≫ (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a) ≫
            (e_a.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
              (hAff_R a).fromSpec) = _
        rw [← he_a, ← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a),
          AlgebraicGeometry.morphismRestrict_ι]
        change ((π_lift ∣_ W a) ≫ (W a).ι) ≫ CategoryTheory.Limits.pullback.fst ι_Z Φ ≫ ι_Z = _
        rw [AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc O'_Sa.ι,
          ← CategoryTheory.Category.assoc π_lift,
          CategoryTheory.Limits.pullback.lift_fst, hComm]
        have hSpec_comm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar_a) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_a)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_a)) ≫
              AlgebraicGeometry.Spec.map ρ_a := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
          rfl
        rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar_a)),
          hSpec_comm, CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ (hAff_R a) (hAff_S a)
            (le_of_eq heq_a.symm),
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
          ← CategoryTheory.Category.assoc e_Sa.hom]
        change O'_Sa.ι ≫ (ι_ZS ≫ Φ) =
          e_O'.hom ≫ ((e_Sa.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
            (hAff_S a).fromSpec) ≫ Φ)
        rw [← he_Sa]
        change O'_Sa.ι ≫ (ι_ZS ≫ Φ) = (e_O'.hom ≫ (O_Sa.ι ≫ ι_ZS)) ≫ Φ
        rw [← CategoryTheory.Category.assoc e_O'.hom, he_O'_fac, CategoryTheory.Category.assoc]

      have hPB_O' : CategoryTheory.IsPullback
          ((π_lift ∣_ W a) ≫ (CategoryTheory.Limits.pullback.fst ι_Z Φ ∣_ O_R a))
          ((π_lift ∣_ W a) ≫ q_snd)
          (ι_Z ∣_ D_R a) (Φ ∣_ D_R a) :=
        CategoryTheory.IsPullback.of_iso hSpecPB_a
          (e_O' ≪≫ e_Sa).symm e_a.symm (e_V ≪≫ (hAff_S a).isoSpec).symm (hAff_R a).isoSpec.symm
          (by
            rw [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.symm_hom,
              CategoryTheory.Iso.comp_inv_eq, CategoryTheory.Category.assoc,
              CategoryTheory.Iso.eq_inv_comp]
            exact hSq_top.symm)
          (by
            rw [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.symm_hom,
              CategoryTheory.Iso.comp_inv_eq, CategoryTheory.Category.assoc,
              CategoryTheory.Iso.eq_inv_comp]
            exact hSq_left.symm)
          (by
            rw [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.symm_hom,
              CategoryTheory.Iso.comp_inv_eq, CategoryTheory.Category.assoc,
              CategoryTheory.Iso.eq_inv_comp]
            exact hSq_right.symm)
          (by
            rw [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.symm_hom,
              CategoryTheory.Iso.comp_inv_eq, CategoryTheory.Category.assoc,
              CategoryTheory.Iso.eq_inv_comp]
            exact hSq_bot.symm)

      let iso_local := CategoryTheory.IsPullback.isoIsPullback _ _ hPB_O' hPB_Wa
      have h_eq_iso : π_lift ∣_ W a = iso_local.hom := by
        apply hPB_Wa.hom_ext
        · exact (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_O' hPB_Wa).symm
        · exact (CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_O' hPB_Wa).symm
      rw [h_eq_iso]
      exact iso_local.isIso_hom

    exact ⟨ψ_Z, CategoryTheory.IsPullback.of_iso_pullback ⟨hComm⟩ (CategoryTheory.asIso π_lift)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩

theorem weil_proj_quadric_paving_relative_quadric_smooth_away_origin (k : Type u) [Field k] (m : ℕ)
    (hAff_R0 : ∀ a : Fin (2 * m + 2 + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))
    (c_R0 : ∀ a : Fin (2 * m + 2 + 1),
      Polynomial k →+* ↑((weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))))
    (t_R0 : ∀ a : Fin (2 * m + 2 + 1), Fin (2 * m + 2 + 1) →
      ↑((weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))))
    (θ_R0 : ∀ a : Fin (2 * m + 2 + 1),
      MvPolynomial (Fin (2 * m + 2)) (Polynomial k) ≃+*
        ↑((weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))))
    (hCoord_R0 : IsCommRingProjCoordSystem (Polynomial k) (2 * m + 2) hAff_R0 c_R0 t_R0)
    (hθ_R0 : ∀ a : Fin (2 * m + 2 + 1),
      (θ_R0 a).toRingHom.comp MvPolynomial.C = c_R0 a ∧
      ∀ i : Fin (2 * m + 2), θ_R0 a (MvPolynomial.X i) = t_R0 a (a.succAbove i))
    (hAff_Pmk : ∀ a : Fin (m + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen k m a))
    (c_Pmk : ∀ a : Fin (m + 1),
      k →+* ↑((weilProjectiveSpaceOver k m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k m a))))
    (t_Pmk : ∀ a : Fin (m + 1), Fin (m + 1) →
      ↑((weilProjectiveSpaceOver k m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k m a))))
    (hCoord_Pmk : IsCommRingProjCoordSystem k m hAff_Pmk c_Pmk t_Pmk)
    (hAff_PmR0 : ∀ a : Fin (m + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen (Polynomial k) m a))
    (c_PmR0 : ∀ a : Fin (m + 1),
      Polynomial k →+* ↑((weilProjectiveSpaceOver (Polynomial k) m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) m a))))
    (t_PmR0 : ∀ a : Fin (m + 1), Fin (m + 1) →
      ↑((weilProjectiveSpaceOver (Polynomial k) m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) m a))))
    (θ_PmR0 : ∀ a : Fin (m + 1),
      MvPolynomial (Fin m) (Polynomial k) ≃+*
        ↑((weilProjectiveSpaceOver (Polynomial k) m).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen (Polynomial k) m a))))
    (hCoord_PmR0 : IsCommRingProjCoordSystem (Polynomial k) m hAff_PmR0 c_PmR0 t_PmR0)
    (hθ_PmR0 : ∀ a : Fin (m + 1),
      (θ_PmR0 a).toRingHom.comp MvPolynomial.C = c_PmR0 a ∧
      ∀ i : Fin m, θ_PmR0 a (MvPolynomial.X i) = t_PmR0 a (a.succAbove i))
    (Φ_Pm_R0 : (weilProjectiveSpaceOver (Polynomial k) m).left ⟶
      (weilProjectiveSpaceOver k m).left)
    (hBC_Pm_R0 : IsCommRingProjBaseChange k (Polynomial k) Polynomial.C m
      c_Pmk t_Pmk c_PmR0 t_PmR0 Φ_Pm_R0)
    (Z_Q : AlgebraicGeometry.Scheme.{u})
    (ι_Q : Z_Q ⟶ (weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left)
    [AlgebraicGeometry.IsClosedImmersion ι_Q]
    (hPres_Q :
      let N := 2 * m + 2
      let u_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let v_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1 + 1, Nat.succ_lt_succ (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let w_idx : Fin (N + 1) := Fin.last N
      let g_Q0 : ∀ a : Fin (N + 1), Fin 1 →
          ↑((weilProjectiveSpaceOver (Polynomial k) N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen (Polynomial k) N a))) :=
        fun a _ =>
          (∑ j : Fin (m + 1), t_R0 a (u_idx j) * t_R0 a (v_idx j)) -
            c_R0 a Polynomial.X * (t_R0 a w_idx) ^ 2
      ∀ a : Fin (N + 1),
        let O_a : Z_Q.Opens :=
          (TopologicalSpace.Opens.map ι_Q.base).obj (weilProjBasicOpen (Polynomial k) N a)
        ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑((weilProjectiveSpaceOver (Polynomial k) N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen (Polynomial k) N a))) ⧸
              Ideal.span (Set.range (g_Q0 a)))),
          O_a.ι ≫ ι_Q =
            e_a.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
              (hAff_R0 a).fromSpec) :
    let R₀ := Polynomial k
    let N := 2 * m + 2
    let U_line := AlgebraicGeometry.Spec (CommRingCat.of R₀)
    let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* R₀))
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
    let C_Q := AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C (Polynomial.X : R₀)}))
    let p_CQ : C_Q ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
    let Q_fam : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk ((ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom) ≫ p_A1)
    let g_Q : Q_fam ⟶ CategoryTheory.Over.mk p_A1 :=
      CategoryTheory.Over.homMk (ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom) rfl
    let u_idx : Fin (m + 1) → Fin (N + 1) :=
      fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
    let w_idx : Fin (N + 1) := Fin.last N
    ∃ (_ : AlgebraicGeometry.IsProper g_Q.left)
      (ι_affQ : C_Q ⟶ Q_fam.left)
      (_ : AlgebraicGeometry.IsOpenImmersion ι_affQ)
      (o₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ C_Q)
      (ι_Pi : CategoryTheory.Limits.pullback p_A1 (weilProjectiveSpaceOver k m).hom ⟶ Q_fam.left),
      (ι_affQ ≫ g_Q.left = p_CQ ∧
        o₀ ≫ p_CQ = s₀ ∧
        ∀ (idx : Fin (m + 1) × Fin 2) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
          Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (o₀.base pt).asIdeal) ∧
      (∀ z : Q_fam.left,
        z ∉ Set.range (o₀ ≫ ι_affQ).base →
        ∃ V : Q_fam.left.Opens,
          z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g_Q.left)) ∧
      AlgebraicGeometry.IsClosedImmersion ι_Pi ∧
      ι_Pi ≫ g_Q.left =
        CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom ∧
      ∀ (K : Type u) [CommRing K] (φ_s : R₀ →+* K)
        (hAff_NK : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K N a))
        (c_NK : ∀ a : Fin (N + 1),
          K →+* ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K N a))))
        (t_NK : ∀ a : Fin (N + 1), Fin (N + 1) →
          ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K N a))))
        (θ_NK : ∀ a : Fin (N + 1),
          MvPolynomial (Fin N) K ≃+*
            ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K N a))))
        (hAff_PmK : ∀ a : Fin (m + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K m a))
        (c_PmK : ∀ a : Fin (m + 1),
          K →+* ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K m a))))
        (t_PmK : ∀ a : Fin (m + 1), Fin (m + 1) →
          ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K m a))))
        (θ_PmK : ∀ a : Fin (m + 1),
          MvPolynomial (Fin m) K ≃+*
            ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K m a))))
        (Φ_N : (weilProjectiveSpaceOver K N).left ⟶ (weilProjectiveSpaceOver R₀ N).left)
        (Φ_m : (weilProjectiveSpaceOver K m).left ⟶ (weilProjectiveSpaceOver R₀ m).left),
        IsCommRingProjCoordSystem K N hAff_NK c_NK t_NK →
        (∀ a : Fin (N + 1),
          (θ_NK a).toRingHom.comp MvPolynomial.C = c_NK a ∧
          ∀ i : Fin N, θ_NK a (MvPolynomial.X i) = t_NK a (a.succAbove i)) →
        IsCommRingProjCoordSystem K m hAff_PmK c_PmK t_PmK →
        (∀ a : Fin (m + 1),
          (θ_PmK a).toRingHom.comp MvPolynomial.C = c_PmK a ∧
          ∀ i : Fin m, θ_PmK a (MvPolynomial.X i) = t_PmK a (a.succAbove i)) →
        IsCommRingProjBaseChange R₀ K φ_s N c_R0 t_R0 c_NK t_NK Φ_N →
        IsCommRingProjBaseChange R₀ K φ_s m c_PmR0 t_PmR0 c_PmK t_PmK Φ_m →
        ∃ ι_Pi_amb_K : (weilProjectiveSpaceOver K m).left ⟶ (weilProjectiveSpaceOver K N).left,
          AlgebraicGeometry.IsClosedImmersion ι_Pi_amb_K ∧
          ι_Pi_amb_K ≫ (weilProjectiveSpaceOver K N).hom = (weilProjectiveSpaceOver K m).hom ∧
          (∀ a : Fin (N + 1),
            let g_Pi_K : Fin (m + 2) →
                ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
                  (Opposite.op (weilProjBasicOpen K N a))) :=
              fun ν => Fin.lastCases (t_NK a w_idx) (fun j => t_NK a (u_idx j)) ν
            let O_Pi : (weilProjectiveSpaceOver K m).left.Opens :=
              (TopologicalSpace.Opens.map ι_Pi_amb_K.base).obj (weilProjBasicOpen K N a)
            ∃ e_Pi : O_Pi.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
                (↑((weilProjectiveSpaceOver K N).left.presheaf.obj
                  (Opposite.op (weilProjBasicOpen K N a))) ⧸
                  Ideal.span (Set.range g_Pi_K))),
              O_Pi.ι ≫ ι_Pi_amb_K =
                e_Pi.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
                  (hAff_NK a).fromSpec) ∧
          (∀ q_Pm : (weilProjectiveSpaceOver R₀ m).left ⟶
              CategoryTheory.Limits.pullback p_A1 (weilProjectiveSpaceOver k m).hom,
            q_Pm ≫ CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom =
              (weilProjectiveSpaceOver R₀ m).hom →
            q_Pm ≫ CategoryTheory.Limits.pullback.snd p_A1 (weilProjectiveSpaceOver k m).hom =
              Φ_Pm_R0 →
            ι_Pi_amb_K ≫ Φ_N = Φ_m ≫ q_Pm ≫ ι_Pi ≫ ι_Q) :=
by
  intro R₀ N U_line p_A1 s₀ C_Q p_CQ Q_fam g_Q u_idx w_idx
  let v_idx : Fin (m + 1) → Fin (N + 1) :=
    fun j => ⟨2 * j.1 + 1, Nat.succ_lt_succ (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
  let g_Q0 : ∀ a : Fin (N + 1), Fin 1 →
      ↑((weilProjectiveSpaceOver R₀ N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R₀ N a))) :=
    fun a _ =>
      (∑ j : Fin (m + 1), t_R0 a (u_idx j) * t_R0 a (v_idx j)) -
        c_R0 a Polynomial.X * (t_R0 a w_idx) ^ 2
  let I_cone0 : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R₀) :=
    Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
      MvPolynomial.C (Polynomial.X : R₀)}

  
  have hval_succAbove : ∀ {n : ℕ} (p : Fin (n + 1)) (x : Fin n),
      (p.succAbove x).1 = if x.1 < p.1 then x.1 else x.1 + 1 := by
    intro n p x
    by_cases hlt : x.1 < p.1
    · have hlt' : x.castSucc < p := hlt
      rw [Fin.succAbove_of_castSucc_lt p x hlt', if_pos hlt]
      rfl
    · have hle' : p ≤ x.castSucc := Nat.le_of_not_lt hlt
      rw [Fin.succAbove_of_le_castSucc p x hle', if_neg hlt]
      rfl
  have hrange_fin1 : ∀ {α : Type u} (x : α), Set.range (fun _ : Fin 1 => x) = {x} := by
    intro α x
    ext y
    simp

  have hS2_vertex :
      let A_w := ↑((weilProjectiveSpaceOver R₀ N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R₀ N w_idx)))
      let I_w : Ideal A_w := Ideal.span (Set.range (g_Q0 w_idx))
      ∃ Θ_w : (MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ I_cone0) ≃+* (A_w ⧸ I_w),
        Θ_w.toRingHom.comp ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C) =
          (Ideal.Quotient.mk I_w).comp (c_R0 w_idx) ∧
        (∀ j : Fin (m + 1),
          Θ_w (Ideal.Quotient.mk I_cone0 (MvPolynomial.X (j, 0))) =
            Ideal.Quotient.mk I_w (t_R0 w_idx (u_idx j))) ∧
        (∀ j : Fin (m + 1),
          Θ_w (Ideal.Quotient.mk I_cone0 (MvPolynomial.X (j, 1))) =
            Ideal.Quotient.mk I_w (t_R0 w_idx (v_idx j))) := by
    intro A_w I_w
    have hτw : t_R0 w_idx w_idx = 1 := hCoord_R0.2.2.2.2.1 w_idx
    obtain ⟨hθC, hθX⟩ := hθ_R0 w_idx
    let e_idx : Fin (m + 1) × Fin 2 ≃ Fin N :=
      { toFun := fun jb => ⟨2 * jb.1.1 + jb.2.1, by have := jb.1.2; have := jb.2.2; omega⟩
        invFun := fun i => (⟨i.1 / 2, by have := i.2; omega⟩, ⟨i.1 % 2, by omega⟩)
        left_inv := fun ⟨j, b⟩ => by
          ext <;> dsimp <;> have := j.2 <;> have := b.2 <;> omega
        right_inv := fun i => by
          ext; dsimp; have := i.2; omega }
    let Θ_tilde : MvPolynomial (Fin (m + 1) × Fin 2) R₀ ≃+* A_w :=
      (MvPolynomial.renameEquiv R₀ e_idx).toRingEquiv.trans (θ_R0 w_idx)
    have hΘ_C : ∀ r : R₀, Θ_tilde (MvPolynomial.C r) = c_R0 w_idx r := by
      intro r
      change θ_R0 w_idx ((MvPolynomial.rename e_idx) (MvPolynomial.C r)) = c_R0 w_idx r
      rw [MvPolynomial.rename_C]
      exact RingHom.congr_fun hθC r
    have hΘ_X0 : ∀ j : Fin (m + 1), Θ_tilde (MvPolynomial.X (j, 0)) = t_R0 w_idx (u_idx j) := by
      intro j
      change θ_R0 w_idx ((MvPolynomial.rename e_idx) (MvPolynomial.X (j, 0))) =
        t_R0 w_idx (u_idx j)
      rw [MvPolynomial.rename_X, hθX]
      congr 1; ext; rw [hval_succAbove]
      have : (e_idx (j, 0)).1 < w_idx.1 := by change 2 * j.1 + 0 < 2 * m + 2; omega
      rw [if_pos this]; change 2 * j.1 + 0 = 2 * j.1; omega
    have hΘ_X1 : ∀ j : Fin (m + 1), Θ_tilde (MvPolynomial.X (j, 1)) = t_R0 w_idx (v_idx j) := by
      intro j
      change θ_R0 w_idx ((MvPolynomial.rename e_idx) (MvPolynomial.X (j, 1))) =
        t_R0 w_idx (v_idx j)
      rw [MvPolynomial.rename_X, hθX]
      congr 1; ext; rw [hval_succAbove]
      have : (e_idx (j, 1)).1 < w_idx.1 := by change 2 * j.1 + 1 < 2 * m + 2; omega
      rw [if_pos this]; rfl
    have hMap : Ideal.map Θ_tilde.toRingHom I_cone0 = I_w := by
      dsimp only [I_cone0, I_w, g_Q0]
      rw [hrange_fin1, Ideal.map_span, Set.image_singleton]
      congr 2
      change Θ_tilde ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C Polynomial.X) = _
      rw [map_sub, map_sum, hΘ_C, hτw, one_pow, mul_one]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, hΘ_X0, hΘ_X1]
    let Θ_w : (MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ I_cone0) ≃+* (A_w ⧸ I_w) :=
      Ideal.quotientEquiv I_cone0 I_w Θ_tilde (by ext x; simp [← hMap])
    refine ⟨Θ_w, ?_, ?_, ?_⟩
    · apply RingHom.ext; intro r; simp [Θ_w, hΘ_C]
    · intro j; simp [Θ_w, hΘ_X0]
    · intro j; simp [Θ_w, hΘ_X1]

  have hS2_smooth : ∀ (a₀ : Fin (N + 1)), a₀ ≠ w_idx →
      let A_a₀ := ↑((weilProjectiveSpaceOver R₀ N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R₀ N a₀)))
      let I_a₀ : Ideal A_a₀ := Ideal.span (Set.range (g_Q0 a₀))
      ∃ Φ_a₀ : MvPolynomial (Fin (2 * m + 1)) R₀ ≃+* (A_a₀ ⧸ I_a₀),
        Φ_a₀.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk I_a₀).comp (c_R0 a₀) := by
    intro a₀ ha₀ A_a₀ I_a₀
    have hτa₀ : t_R0 a₀ a₀ = 1 := hCoord_R0.2.2.2.2.1 a₀
    obtain ⟨hθC, hθX⟩ := hθ_R0 a₀
    have ha₀_lt : a₀.1 < N := by
      have := a₀.2
      have hne : a₀.1 ≠ N := fun h => ha₀ (Fin.ext h)
      omega
    let r : Fin (m + 1) := ⟨a₀.1 / 2, by omega⟩
    have hr_val : r.1 = a₀.1 / 2 := rfl
    let i_star : Fin N := ⟨2 * r.1, by omega⟩
    let emb : MvPolynomial (Fin (2 * m + 1)) R₀ →ₐ[R₀] MvPolynomial (Fin N) R₀ :=
      MvPolynomial.rename i_star.succAbove
    let term_r : Fin (m + 1) → MvPolynomial (Fin (2 * m + 1)) R₀ := fun j =>
      if hj_lt : j.1 < r.1 then
        MvPolynomial.X ⟨2 * j.1, by omega⟩ * MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩
      else if hj_gt : r.1 < j.1 then
        MvPolynomial.X ⟨2 * j.1 - 2, by omega⟩ * MvPolynomial.X ⟨2 * j.1 - 1, by omega⟩
      else 0
    let μ_w : Fin (2 * m + 1) := ⟨2 * m, by omega⟩
    let P_r : MvPolynomial (Fin (2 * m + 1)) R₀ :=
      MvPolynomial.C (Polynomial.X : R₀) * (MvPolynomial.X μ_w) ^ 2 -
        ∑ j : Fin (m + 1), term_r j
    have h_θC : ∀ x : R₀, θ_R0 a₀ (MvPolynomial.C x) = c_R0 a₀ x := RingHom.congr_fun hθC
    have h_partner : t_R0 a₀ (u_idx r) * t_R0 a₀ (v_idx r) = θ_R0 a₀ (MvPolynomial.X i_star) := by
      rcases (by omega : a₀.1 = 2 * r.1 ∨ a₀.1 = 2 * r.1 + 1) with heven | hodd
      · have ha₀_eq : a₀ = u_idx r := Fin.ext heven
        have hsucc : a₀.succAbove i_star = v_idx r := by
          ext; rw [hval_succAbove]; dsimp [i_star, v_idx]; split_ifs <;> omega
        rw [← ha₀_eq, hτa₀, one_mul, ← hsucc, hθX]
      · have ha₀_eq : a₀ = v_idx r := Fin.ext hodd
        have hsucc : a₀.succAbove i_star = u_idx r := by
          ext; rw [hval_succAbove]; dsimp [i_star, u_idx]; split_ifs <;> omega
        rw [← ha₀_eq, hτa₀, mul_one, ← hsucc, hθX]
    have h_term : ∀ j : Fin (m + 1), j ≠ r →
        θ_R0 a₀ (emb (term_r j)) = t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j) := by
      intro j hj_ne
      have hj_val_ne : j.1 ≠ r.1 := fun h => hj_ne (Fin.ext h)
      rcases lt_or_gt_of_ne hj_val_ne with hj_lt | hj_gt
      · dsimp only [term_r]
        rw [dif_pos hj_lt, map_mul, map_mul]
        dsimp only [emb]
        rw [MvPolynomial.rename_X, MvPolynomial.rename_X, hθX, hθX]
        congr 1
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, u_idx]; split_ifs <;> omega
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, v_idx]; split_ifs <;> omega
      · dsimp only [term_r]
        have hnot_lt : ¬ j.1 < r.1 := by omega
        rw [dif_neg hnot_lt, dif_pos hj_gt, map_mul, map_mul]
        dsimp only [emb]
        rw [MvPolynomial.rename_X, MvPolynomial.rename_X, hθX, hθX]
        congr 1
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, u_idx]; split_ifs <;> omega
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, v_idx]; split_ifs <;> omega
    have h_w : θ_R0 a₀ (emb (MvPolynomial.X μ_w)) = t_R0 a₀ w_idx := by
      dsimp only [emb]
      rw [MvPolynomial.rename_X, hθX]
      congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, μ_w, w_idx, N]
      split_ifs <;> omega
    have h_embC : emb (MvPolynomial.C (Polynomial.X : R₀)) = MvPolynomial.C Polynomial.X :=
      MvPolynomial.rename_C _ _
    have h_gen : θ_R0 a₀ (MvPolynomial.X i_star - emb P_r) =
        (∑ j : Fin (m + 1), t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j)) -
          c_R0 a₀ Polynomial.X * (t_R0 a₀ w_idx) ^ 2 := by
      dsimp only [P_r]
      rw [map_sub, map_sub, map_sub, map_mul, h_embC, map_mul, h_θC,
        map_pow, map_pow, h_w, map_sum, map_sum]
      have hterm_r0 : term_r r = 0 := by dsimp [term_r]; simp
      have hsum1 : (∑ j : Fin (m + 1), t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j)) =
          t_R0 a₀ (u_idx r) * t_R0 a₀ (v_idx r) +
            ∑ j ∈ Finset.univ.erase r, t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j) :=
        (Finset.add_sum_erase Finset.univ _ (Finset.mem_univ r)).symm
      have hsum2 : (∑ j : Fin (m + 1), θ_R0 a₀ (emb (term_r j))) =
          θ_R0 a₀ (emb (term_r r)) +
            ∑ j ∈ Finset.univ.erase r, θ_R0 a₀ (emb (term_r j)) :=
        (Finset.add_sum_erase Finset.univ _ (Finset.mem_univ r)).symm
      rw [hterm_r0, map_zero, map_zero, zero_add] at hsum2
      have hsum_eq : (∑ j ∈ Finset.univ.erase r, θ_R0 a₀ (emb (term_r j))) =
          ∑ j ∈ Finset.univ.erase r, t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j) := by
        refine Finset.sum_congr rfl fun j hj => ?_
        exact h_term j (Finset.ne_of_mem_erase hj)
      rw [hsum1, hsum2, hsum_eq, h_partner]
      ring
    let J_r : Ideal (MvPolynomial (Fin N) R₀) := Ideal.span {MvPolynomial.X i_star - emb P_r}
    have hMap_J : Ideal.map (θ_R0 a₀).toRingHom J_r = I_a₀ := by
      dsimp only [J_r, I_a₀, g_Q0]
      rw [hrange_fin1, Ideal.map_span, Set.image_singleton]
      congr 2
    let φ_r : MvPolynomial (Fin (2 * m + 1)) R₀ →ₐ[R₀] (MvPolynomial (Fin N) R₀ ⧸ J_r) :=
      (Ideal.Quotient.mkₐ R₀ J_r).comp emb
    let ψ0_r : MvPolynomial (Fin N) R₀ →ₐ[R₀] MvPolynomial (Fin (2 * m + 1)) R₀ :=
      MvPolynomial.aeval fun i : Fin N =>
        if h : i = i_star then P_r
        else MvPolynomial.X (Classical.choose (Fin.exists_succAbove_eq h))
    have hψ0_emb : ψ0_r.comp emb = AlgHom.id R₀ (MvPolynomial (Fin (2 * m + 1)) R₀) := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply, emb,
        MvPolynomial.rename_X, ψ0_r, MvPolynomial.aeval_X]
      have hne : i_star.succAbove μ ≠ i_star := Fin.succAbove_ne i_star μ
      rw [dif_neg hne]
      congr 1
      exact Fin.succAbove_right_injective (Classical.choose_spec (Fin.exists_succAbove_eq hne))
    have hψ0_ker : ∀ p ∈ J_r, ψ0_r p = 0 := by
      intro p hp
      have hle : J_r ≤ RingHom.ker ψ0_r.toRingHom := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change ψ0_r (MvPolynomial.X i_star - emb P_r) = 0
        rw [map_sub]
        have h1 : ψ0_r (MvPolynomial.X i_star) = P_r := by simp [ψ0_r]
        have h2 : ψ0_r (emb P_r) = P_r := AlgHom.congr_fun hψ0_emb P_r
        rw [h1, h2, sub_self]
      exact hle hp
    let ψ_r : (MvPolynomial (Fin N) R₀ ⧸ J_r) →ₐ[R₀] MvPolynomial (Fin (2 * m + 1)) R₀ :=
      Ideal.Quotient.liftₐ J_r ψ0_r hψ0_ker
    have hψφ : ψ_r.comp φ_r = AlgHom.id R₀ (MvPolynomial (Fin (2 * m + 1)) R₀) := by
      apply MvPolynomial.algHom_ext
      intro μ
      change ψ0_r (emb (MvPolynomial.X μ)) = MvPolynomial.X μ
      exact AlgHom.congr_fun hψ0_emb (MvPolynomial.X μ)
    have hφψ : φ_r.comp ψ_r = AlgHom.id R₀ (MvPolynomial (Fin N) R₀ ⧸ J_r) := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
      change φ_r (ψ0_r (MvPolynomial.X i)) = Ideal.Quotient.mk J_r (MvPolynomial.X i)
      dsimp only [ψ0_r]
      rw [MvPolynomial.aeval_X]
      by_cases hi : i = i_star
      · rw [hi, dif_pos rfl]
        change Ideal.Quotient.mk J_r (emb P_r) = Ideal.Quotient.mk J_r (MvPolynomial.X i_star)
        symm
        rw [Ideal.Quotient.eq]
        exact Ideal.subset_span rfl
      · rw [dif_neg hi]
        change Ideal.Quotient.mk J_r (emb (MvPolynomial.X _)) = _
        dsimp only [emb]
        rw [MvPolynomial.rename_X, Classical.choose_spec (Fin.exists_succAbove_eq hi)]
    let E_r : MvPolynomial (Fin (2 * m + 1)) R₀ ≃ₐ[R₀] (MvPolynomial (Fin N) R₀ ⧸ J_r) :=
      AlgEquiv.ofAlgHom φ_r ψ_r hφψ hψφ
    let Q_r : (MvPolynomial (Fin N) R₀ ⧸ J_r) ≃+* (A_a₀ ⧸ I_a₀) :=
      Ideal.quotientEquiv J_r I_a₀ (θ_R0 a₀) (by ext x; simp [← hMap_J])
    refine ⟨E_r.toRingEquiv.trans Q_r, ?_⟩
    apply RingHom.ext
    intro x
    change Q_r (φ_r (MvPolynomial.C x)) = Ideal.Quotient.mk I_a₀ (c_R0 a₀ x)
    have hφC : φ_r (MvPolynomial.C x) = Ideal.Quotient.mk J_r (MvPolynomial.C x) := by
      dsimp [φ_r, emb]; rw [MvPolynomial.rename_C]
    rw [hφC]
    simp [Q_r, h_θC]

  have hS2_origin :
      ∃ ε₀ : (MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ I_cone0) →+* k,
        ε₀.comp ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C) =
          Polynomial.evalRingHom 0 ∧
        (∀ idx : Fin (m + 1) × Fin 2,
          ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx)) = 0) ∧
        (∀ P : PrimeSpectrum (MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ I_cone0),
          (∀ idx : Fin (m + 1) × Fin 2,
            Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx) ∈ P.asIdeal) →
          P.asIdeal = RingHom.ker ε₀) := by
    have heval0_X : (Polynomial.evalRingHom (0 : k)) Polynomial.X = 0 := Polynomial.eval_X
    have heval0_C : ∀ a : k, (Polynomial.evalRingHom (0 : k)) (Polynomial.C a) = a :=
      fun _ => Polynomial.eval_C
    let ε_tilde : MvPolynomial (Fin (m + 1) × Fin 2) R₀ →+* k :=
      MvPolynomial.eval₂Hom (Polynomial.evalRingHom (0 : k)) (fun _ => (0 : k))
    have hε_ker : ∀ p ∈ I_cone0, ε_tilde p = 0 := by
      intro p hp
      have hle : I_cone0 ≤ RingHom.ker ε_tilde := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        simp [ε_tilde, heval0_X]
      exact hle hp
    let ε₀ : (MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ I_cone0) →+* k :=
      Ideal.Quotient.lift I_cone0 ε_tilde hε_ker
    refine ⟨ε₀, ?_, ?_, ?_⟩
    · apply RingHom.ext; intro f; simp [ε₀, ε_tilde]
    · intro idx; simp [ε₀, ε_tilde]
    · intro P hPX
      let Q_cone0 := MvPolynomial (Fin (m + 1) × Fin 2) R₀ ⧸ I_cone0
      let ι_k : k →+* Q_cone0 :=
        ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C).comp Polynomial.C
      have hε_ι : ∀ a : k, ε₀ (ι_k a) = a := by
        intro a; simp [ε₀, ε_tilde, ι_k, heval0_C]
      have hCX_mem : Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R₀)) ∈ P.asIdeal := by
        have hrel : Ideal.Quotient.mk I_cone0
            ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
              MvPolynomial.C (Polynomial.X : R₀)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [map_sub, sub_eq_zero] at hrel
        rw [← hrel, map_sum]
        refine Ideal.sum_mem P.asIdeal fun j _ => ?_
        rw [map_mul]
        exact Ideal.mul_mem_right _ P.asIdeal (hPX (j, 0))
      let S : Subring Q_cone0 :=
        { carrier := {u : Q_cone0 | u - ι_k (ε₀ u) ∈ P.asIdeal}
          zero_mem' := by simp
          one_mem' := by simp
          add_mem' := by
            intro u v hu hv
            change (u + v) - ι_k (ε₀ (u + v)) ∈ P.asIdeal
            rw [map_add, map_add]
            have : (u + v) - (ι_k (ε₀ u) + ι_k (ε₀ v)) =
                (u - ι_k (ε₀ u)) + (v - ι_k (ε₀ v)) := by ring
            rw [this]
            exact P.asIdeal.add_mem hu hv
          neg_mem' := by
            intro u hu
            change -u - ι_k (ε₀ (-u)) ∈ P.asIdeal
            rw [map_neg, map_neg]
            have : -u - -ι_k (ε₀ u) = -(u - ι_k (ε₀ u)) := by ring
            rw [this]
            exact P.asIdeal.neg_mem hu
          mul_mem' := by
            intro u v hu hv
            change u * v - ι_k (ε₀ (u * v)) ∈ P.asIdeal
            rw [map_mul, map_mul]
            have : u * v - ι_k (ε₀ u) * ι_k (ε₀ v) =
                (u - ι_k (ε₀ u)) * v + ι_k (ε₀ u) * (v - ι_k (ε₀ v)) := by ring
            rw [this]
            exact P.asIdeal.add_mem (P.asIdeal.mul_mem_right v hu)
              (P.asIdeal.mul_mem_left _ hv) }
      have hC_a_S : ∀ a : k, Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a)) ∈ S := by
        intro a
        change Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a)) -
          ι_k (ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a)))) ∈ P.asIdeal
        have : ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a))) = a := hε_ι a
        rw [this]; change ι_k a - ι_k a ∈ P.asIdeal; rw [sub_self]; exact P.asIdeal.zero_mem
      have hX_S : Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R₀)) ∈ S := by
        change Ideal.Quotient.mk I_cone0 (MvPolynomial.C Polynomial.X) -
          ι_k (ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C Polynomial.X))) ∈ P.asIdeal
        have : ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C Polynomial.X)) = 0 := by
          simp [ε₀, ε_tilde, heval0_X]
        rw [this, map_zero, sub_zero]; exact hCX_mem
      have hPoly_S : ∀ f : R₀, Ideal.Quotient.mk I_cone0 (MvPolynomial.C f) ∈ S := by
        intro f
        refine Polynomial.induction_on f (fun a => hC_a_S a) ?_ ?_
        · intro p q hp hq; rw [map_add, map_add]; exact S.add_mem hp hq
        · intro n a _; rw [map_mul, map_mul, map_pow, map_pow]
          exact S.mul_mem (hC_a_S a) (S.pow_mem hX_S (n + 1))
      have hAll_S : ∀ u : Q_cone0, u - ι_k (ε₀ u) ∈ P.asIdeal := by
        intro u
        refine Quotient.inductionOn' u fun F => ?_
        exact MvPolynomial.induction_on
          (motive := fun P_mv => Ideal.Quotient.mk I_cone0 P_mv ∈ S) F
          (fun f => hPoly_S f)
          (fun p q hp hq => by rw [map_add]; exact S.add_mem hp hq)
          (fun p idx hp => by
            rw [map_mul]
            refine S.mul_mem hp ?_
            change Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx) -
              ι_k (ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx))) ∈ P.asIdeal
            have : ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx)) = 0 := by
              simp [ε₀, ε_tilde]
            rw [this, map_zero, sub_zero]; exact hPX idx)
      ext u
      rw [RingHom.mem_ker]
      constructor
      · intro huP
        by_contra hne
        have hdiff := hAll_S u
        have hι_mem : ι_k (ε₀ u) ∈ P.asIdeal := by
          have : ι_k (ε₀ u) = u - (u - ι_k (ε₀ u)) := by ring
          rw [this]; exact P.asIdeal.sub_mem huP hdiff
        have hone_mem : (1 : Q_cone0) ∈ P.asIdeal := by
          have h1 : ι_k ((ε₀ u)⁻¹) * ι_k (ε₀ u) = 1 := by
            rw [← map_mul, inv_mul_cancel₀ hne, map_one]
          rw [← h1]; exact P.asIdeal.mul_mem_left _ hι_mem
        exact P.isPrime.ne_top ((Ideal.eq_top_iff_one P.asIdeal).mpr hone_mem)
      · intro hu0
        have hdiff := hAll_S u
        rwa [hu0, map_zero, sub_zero] at hdiff

  
  
  have hS3_abs : ∀ {P_NR : AlgebraicGeometry.Scheme.{u}}
      (p_NR : P_NR ⟶ U_line)
      (D_N : Fin (N + 1) → P_NR.Opens)
      (hAff_NR : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_N a))
      (c_NR : ∀ a : Fin (N + 1), R₀ →+* ↑(P_NR.presheaf.obj (Opposite.op (D_N a))))
      (t_NR : ∀ a : Fin (N + 1), Fin (N + 1) → ↑(P_NR.presheaf.obj (Opposite.op (D_N a))))
      (hSup_NR : (⨆ a : Fin (N + 1), D_N a) = ⊤)
      (hc_hom_NR : ∀ a : Fin (N + 1),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_NR a)) = (hAff_NR a).fromSpec ≫ p_NR)
      (hBasic_NR : ∀ a a' : Fin (N + 1), P_NR.basicOpen (t_NR a a') = D_N a ⊓ D_N a')
      (ι_Z : Z_Q ⟶ P_NR)
      {I_Z : ∀ a : Fin (N + 1), Ideal ↑(P_NR.presheaf.obj (Opposite.op (D_N a)))}
      (hPres_Z : ∀ a : Fin (N + 1),
        let O_a : Z_Q.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a)
        ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NR.presheaf.obj (Opposite.op (D_N a))) ⧸ I_Z a)),
          O_a.ι ≫ ι_Z =
            e_a.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Z a))) ≫
              (hAff_NR a).fromSpec),
      (∀ (a₀ : Fin (N + 1)) (d : ℕ)
         (Φ : MvPolynomial (Fin d) R₀ ≃+*
           (↑(P_NR.presheaf.obj (Opposite.op (D_N a₀))) ⧸ I_Z a₀)),
        Φ.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk (I_Z a₀)).comp (c_NR a₀) →
        let O_a₀ : Z_Q.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a₀)
        AlgebraicGeometry.SmoothOfRelativeDimension d (O_a₀.ι ≫ (ι_Z ≫ p_NR))) ∧
      (∀ (a_w : Fin (N + 1)) (B : Type u) [CommRing B] (ρ_B : R₀ →+* B)
         (Θ : B ≃+* (↑(P_NR.presheaf.obj (Opposite.op (D_N a_w))) ⧸ I_Z a_w)),
        Θ.toRingHom.comp ρ_B = (Ideal.Quotient.mk (I_Z a_w)).comp (c_NR a_w) →
        ∃ (ι_aff : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Z_Q)
          (_ : AlgebraicGeometry.IsOpenImmersion ι_aff),
          ι_aff ≫ (ι_Z ≫ p_NR) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ∧
          ∀ z : Z_Q,
            (∀ a : Fin (N + 1), a ≠ a_w →
              z ∉ (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a)) →
            ∃ q : AlgebraicGeometry.Spec (CommRingCat.of B),
              ι_aff.base q = z ∧
              ∀ a : Fin (N + 1), a ≠ a_w →
                Θ.symm (Ideal.Quotient.mk (I_Z a_w) (t_NR a_w a)) ∈ q.asIdeal) := by
    intro P_NR p_NR D_N hAff_NR c_NR t_NR hSup_NR hc_hom_NR hBasic_NR ι_Z I_Z hPres_Z
    refine ⟨?_, ?_⟩
    · intro a₀ d Φ hΦ O_a₀
      obtain ⟨e_a₀, he_a₀⟩ := hPres_Z a₀
      let p_Ad : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d) R₀)) ⟶ U_line :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d) R₀))
      have : CategoryTheory.IsIso (CommRingCat.ofHom Φ.toRingHom) :=
        ⟨⟨CommRingCat.ofHom Φ.symm.toRingHom,
          CommRingCat.hom_ext (RingHom.ext fun x => Φ.symm_apply_apply x),
          CommRingCat.hom_ext (RingHom.ext fun x => Φ.apply_symm_apply x)⟩⟩
      have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom)) :=
        inferInstance
      let ψ_iso : O_a₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d) R₀)) :=
        e_a₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom)
      have : CategoryTheory.IsIso ψ_iso := by dsimp only [ψ_iso]; infer_instance
      have hSmooth_ψ : AlgebraicGeometry.SmoothOfRelativeDimension 0 ψ_iso := inferInstance
      have hSmBij : ∀ {A₁ A₂ : Type u} [CommRing A₁] [CommRing A₂] (e : A₁ ≃+* A₂),
          RingHom.IsStandardSmoothOfRelativeDimension 0 e.toRingHom := by
        intro A₁ A₂ _ _ e
        let _ : Algebra A₁ A₂ := e.toRingHom.toAlgebra
        change RingHom.IsStandardSmoothOfRelativeDimension 0 (algebraMap A₁ A₂)
        rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
        exact Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective e.bijective
      have hSmooth_Ad : AlgebraicGeometry.SmoothOfRelativeDimension d p_Ad := by
        rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
        intro x
        refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top _, ⊤, AlgebraicGeometry.isAffineOpen_top _,
          trivial, le_top, ?_⟩
        have happ : p_Ad.appLE ⊤ ⊤ le_top = p_Ad.appTop := by
          change p_Ad.appLE ⊤ ⊤ le_top = p_Ad.app ⊤
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]; rfl
        rw [happ]
        have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
          (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d) R₀))
        have happ2 : p_Ad.appTop =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom ≫
              CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d) R₀) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin d) R₀))).inv := by
          dsimp only [p_Ad]
          rw [← CategoryTheory.Category.assoc, ← hnat, CategoryTheory.Category.assoc,
            CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id]
        rw [happ2, CommRingCat.hom_comp, CommRingCat.hom_comp]
        have h1 : RingHom.IsStandardSmoothOfRelativeDimension 0
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom.hom) :=
          hSmBij (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).commRingCatIsoToRingEquiv
        have h2 : RingHom.IsStandardSmoothOfRelativeDimension d
            (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d) R₀)).hom := by
          change RingHom.IsStandardSmoothOfRelativeDimension d (algebraMap R₀ (MvPolynomial (Fin d) R₀))
          rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
          have hm := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial R₀ (Fin d)
          rwa [Nat.card_fin d] at hm
        have h3 : RingHom.IsStandardSmoothOfRelativeDimension 0
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin d) R₀))).inv.hom) :=
          hSmBij (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin d) R₀))).symm.commRingCatIsoToRingEquiv
        simpa using (h3.comp h2).comp h1
      have hcomp_eq : O_a₀.ι ≫ (ι_Z ≫ p_NR) = ψ_iso ≫ p_Ad := by
        rw [← CategoryTheory.Category.assoc, he_a₀, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, ← hc_hom_NR a₀,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← hΦ,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
      rw [hcomp_eq]
      have h0d : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d) (ψ_iso ≫ p_Ad) := inferInstance
      simpa only [Nat.zero_add] using h0d
    · intro a_w B _ ρ_B Θ hΘ
      obtain ⟨e_w, he_w⟩ := hPres_Z a_w
      let O_w : Z_Q.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a_w)
      have : CategoryTheory.IsIso (CommRingCat.ofHom Θ.symm.toRingHom) :=
        ⟨⟨CommRingCat.ofHom Θ.toRingHom,
          CommRingCat.hom_ext (RingHom.ext fun x => Θ.apply_symm_apply x),
          CommRingCat.hom_ext (RingHom.ext fun x => Θ.symm_apply_apply x)⟩⟩
      have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom)) :=
        inferInstance
      let e_B_hom : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ O_w.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom) ≫ e_w.inv
      have : CategoryTheory.IsIso e_B_hom := by dsimp only [e_B_hom]; infer_instance
      let ι_aff : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Z_Q := e_B_hom ≫ O_w.ι
      have hOpen_aff : AlgebraicGeometry.IsOpenImmersion ι_aff := by dsimp only [ι_aff]; infer_instance
      refine ⟨ι_aff, hOpen_aff, ?_, ?_⟩
      · have hιZ_w : e_B_hom ≫ O_w.ι ≫ ι_Z =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Z a_w))) ≫
              (hAff_NR a_w).fromSpec := by
          dsimp only [e_B_hom, O_w]
          rw [he_w, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
        calc
          ι_aff ≫ (ι_Z ≫ p_NR)
              = (e_B_hom ≫ O_w.ι ≫ ι_Z) ≫ p_NR := by
                dsimp only [ι_aff]; simp only [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Z a_w))) ≫
                ((hAff_NR a_w).fromSpec ≫ p_NR) := by
                rw [hιZ_w]; simp only [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Θ.symm.toRingHom.comp ((Ideal.Quotient.mk (I_Z a_w)).comp (c_NR a_w)))) := by
                rw [← hc_hom_NR a_w, ← AlgebraicGeometry.Spec.map_comp,
                  ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
                  ← CommRingCat.ofHom_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) := by
                congr 2; apply RingHom.ext; intro r
                change Θ.symm (Ideal.Quotient.mk (I_Z a_w) (c_NR a_w r)) = ρ_B r
                have hr := RingHom.congr_fun hΘ r
                change Θ (ρ_B r) = Ideal.Quotient.mk (I_Z a_w) (c_NR a_w r) at hr
                rw [← hr, Θ.symm_apply_apply]
      · intro z hz_avoid
        have hz_Ow : z ∈ O_w := by
          have htop : ι_Z.base z ∈ (⊤ : P_NR.Opens) := trivial
          rw [← hSup_NR, TopologicalSpace.Opens.mem_iSup] at htop
          obtain ⟨a, ha⟩ := htop
          by_cases haw : a = a_w
          · subst haw; exact ha
          · exact False.elim (hz_avoid a haw ha)
        have hz_range : z ∈ Set.range O_w.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]; exact hz_Ow
        obtain ⟨z_w, hzw⟩ := hz_range
        let e_B_inv : O_w.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
          e_w.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)
        have h_inv_hom : e_B_inv ≫ e_B_hom = 𝟙 O_w.toScheme := by
          dsimp only [e_B_inv, e_B_hom]
          rw [CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : Θ.toRingHom.comp Θ.symm.toRingHom = RingHom.id _ := by
            ext x; exact Θ.apply_symm_apply x
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
            CategoryTheory.Category.id_comp, e_w.hom_inv_id]
        let q : AlgebraicGeometry.Spec (CommRingCat.of B) := e_B_inv.base z_w
        have hq_z : ι_aff.base q = z := by
          change (e_B_inv ≫ e_B_hom ≫ O_w.ι).base z_w = z
          rw [← CategoryTheory.Category.assoc, h_inv_hom, CategoryTheory.Category.id_comp]
          exact hzw
        refine ⟨q, hq_z, fun a ha_ne => ?_⟩
        let α : ↑(P_NR.presheaf.obj (Opposite.op (D_N a_w))) →+* B :=
          Θ.symm.toRingHom.comp (Ideal.Quotient.mk (I_Z a_w))
        let P_spec : AlgebraicGeometry.Spec (CommRingCat.of
            ↑(P_NR.presheaf.obj (Opposite.op (D_N a_w)))) :=
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base q
        have hιZ_eq : ι_aff ≫ ι_Z =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ (hAff_NR a_w).fromSpec := by
          dsimp only [ι_aff, e_B_hom, α, O_w]
          rw [CategoryTheory.Category.assoc, he_w, CategoryTheory.Category.assoc,
            CategoryTheory.Iso.inv_hom_id_assoc, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hfrom_P : (hAff_NR a_w).fromSpec.base P_spec = ι_Z.base z := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ (hAff_NR a_w).fromSpec).base q = _
          rw [← hιZ_eq]; change ι_Z.base (ι_aff.base q) = ι_Z.base z; rw [hq_z]
        have hnot_basic : (hAff_NR a_w).fromSpec.base P_spec ∉ P_NR.basicOpen (t_NR a_w a) := by
          rw [hfrom_P, hBasic_NR a_w a]
          intro hmem; exact hz_avoid a ha_ne hmem.2
        have hnot_pbasic : P_spec ∉ PrimeSpectrum.basicOpen (t_NR a_w a) := by
          rw [← (hAff_NR a_w).fromSpec_preimage_basicOpen (t_NR a_w a)]
          exact hnot_basic
        exact not_not.mp (mt (PrimeSpectrum.mem_basicOpen (t_NR a_w a) P_spec).mpr hnot_pbasic)

  
  have hRingExtCoord : ∀ {S₀ A₀ B₀ : Type u} [CommRing S₀] [CommRing A₀] [CommRing B₀]
      {ι₀ : Type} (c₀ : S₀ →+* A₀) (t₀ : ι₀ → A₀)
      (hCl₀ : Subring.closure (Set.range c₀ ∪ Set.range t₀) = ⊤)
      (f₁ f₂ : A₀ →+* B₀),
      (∀ s : S₀, f₁ (c₀ s) = f₂ (c₀ s)) →
      (∀ b : ι₀, f₁ (t₀ b) = f₂ (t₀ b)) →
      f₁ = f₂ := by
    intro S₀ A₀ B₀ _ _ _ ι₀ c₀ t₀ hCl₀ f₁ f₂ hc ht
    have hle : (⊤ : Subring A₀) ≤ RingHom.eqLocus f₁ f₂ := by
      rw [← hCl₀, Subring.closure_le]
      rintro x (⟨s, rfl⟩ | ⟨b, rfl⟩)
      · exact hc s
      · exact ht b
    ext x
    exact hle trivial
  have hFromSpecEq : ∀ {X : AlgebraicGeometry.Scheme.{u}} {V : X.Opens}
      (hV : AlgebraicGeometry.IsAffineOpen V),
      hV.isoSpec.inv ≫ V.ι = hV.fromSpec := by
    intro X V hV
    rw [← hV.toSpecΓ_fromSpec, ← hV.isoSpec_hom, CategoryTheory.Iso.inv_hom_id_assoc]
  have hHomOfLE_toSpecΓ : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U V : X.Opens}
      (hU : AlgebraicGeometry.IsAffineOpen U) (hV : AlgebraicGeometry.IsAffineOpen V)
      (hle : U ≤ V),
      X.homOfLE hle ≫ V.toSpecΓ =
        U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (X.presheaf.map (CategoryTheory.homOfLE hle).op) := by
    intro X U V hU hV hle
    have h1 : (X.homOfLE hle ≫ V.toSpecΓ) ≫ hV.fromSpec =
        (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (X.presheaf.map (CategoryTheory.homOfLE hle).op)) ≫
          hV.fromSpec := by
      rw [CategoryTheory.Category.assoc, hV.toSpecΓ_fromSpec, AlgebraicGeometry.Scheme.homOfLE_ι,
        CategoryTheory.Category.assoc, hV.map_fromSpec hU (CategoryTheory.homOfLE hle).op,
        hU.toSpecΓ_fromSpec]
    rw [← hFromSpecEq hV] at h1
    simp only [← CategoryTheory.Category.assoc] at h1
    exact (cancel_mono hV.isoSpec.inv).mp ((cancel_mono V.ι).mp h1)

  have hMkOddAbs : ∀ (S : Type u) [CommRing S]
      (P_NS P_mS : AlgebraicGeometry.Scheme.{u})
      (p_NS : P_NS ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
      (p_mS : P_mS ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
      (D_N : Fin (N + 1) → P_NS.Opens)
      (D_m : Fin (m + 1) → P_mS.Opens)
      (hAff_NS : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_N a))
      (c_NS : ∀ a : Fin (N + 1), S →+* ↑(P_NS.presheaf.obj (Opposite.op (D_N a))))
      (t_NS : ∀ a : Fin (N + 1), Fin (N + 1) → ↑(P_NS.presheaf.obj (Opposite.op (D_N a))))
      (hAff_PmS : ∀ a : Fin (m + 1), AlgebraicGeometry.IsAffineOpen (D_m a))
      (c_PmS : ∀ a : Fin (m + 1), S →+* ↑(P_mS.presheaf.obj (Opposite.op (D_m a))))
      (t_PmS : ∀ a : Fin (m + 1), Fin (m + 1) → ↑(P_mS.presheaf.obj (Opposite.op (D_m a))))
      (θ_PmS : ∀ a : Fin (m + 1),
