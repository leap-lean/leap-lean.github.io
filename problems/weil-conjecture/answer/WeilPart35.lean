        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, i₁.unop.2.2]
      obtain ⟨k, w_k, hwk⟩ := hShrink W_et ⟨η_mor, hη_over⟩
      let fst_w' : (Fgt.obj W_et).left ⟶ (Fgt.obj (U_aff.obj i₁.unop.1)).left := fst_w
      let snd_w' : (Fgt.obj W_et).left ⟶ (Fgt.obj (U_aff.obj i₂.unop.1)).left := snd_w
      have hwk_val : k.unop.2.1 ≫ (Fgt.map w_k).left = η_mor := congrArg Subtype.val hwk
