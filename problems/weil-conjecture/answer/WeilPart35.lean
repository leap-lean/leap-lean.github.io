        let A₂ := i₂.unop
        let u₁ := f₁.unop
        let u₂ := f₂.unop
        let h₂ := (Fgt.obj (U_aff.obj A₂.1)).hom
        have : AlgebraicGeometry.Etale h₂ := (U_aff.obj A₂.1).prop
        let Δ := CategoryTheory.Limits.pullback.diagonal h₂
        have : AlgebraicGeometry.IsOpenImmersion Δ :=
          AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal h₂
        let ubar₁ := (Fgt.map (U_aff.map u₁.1)).left
        let ubar₂ := (Fgt.map (U_aff.map u₂.1)).left
        have hubar_comm : ubar₁ ≫ h₂ = ubar₂ ≫ h₂ :=
          (Fgt.map (U_aff.map u₁.1)).w.trans (Fgt.map (U_aff.map u₂.1)).w.symm
        let pair_u := CategoryTheory.Limits.pullback.lift ubar₁ ubar₂ hubar_comm
        let j_E := CategoryTheory.Limits.pullback.snd Δ pair_u
        have : AlgebraicGeometry.Etale (Fgt.obj (U_aff.obj A₁.1)).hom := (U_aff.obj A₁.1).prop
        have hEt_E : AlgebraicGeometry.Etale (j_E ≫ (Fgt.obj (U_aff.obj A₁.1)).hom) :=
