      intro n
      induction n with
      | zero =>
        intro X₀ Y₀ x
        conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x]
        conv_rhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x]
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        congr 1
        rw [← CategoryTheory.Category.assoc, ← heR_inv_nat,
