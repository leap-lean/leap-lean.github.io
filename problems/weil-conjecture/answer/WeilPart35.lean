theorem weil_sm_pencil_leray_deg0_bc_square_coherence (sys : WeilEtaleSitePullbackSys.{u})
    {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) :
    letI := (sys f).hCont
    letI := (sys f).hAdj
    letI := (sys f).hAdd_pb
    letI := (sys f).hLim_pb
    letI := (sys f).hColim_pb
    let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
