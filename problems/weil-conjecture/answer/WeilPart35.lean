  have hSubobjTransport : ∀ {C₁ C₂ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C₁]
      [CategoryTheory.Category.{u + 1, u + 1} C₂] (F : C₂ ⥤ C₁)
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      {E₂ : C₂} {E₁ : C₁} (e : F.obj E₂ ≅ E₁) (P : ℕ →o CategoryTheory.Subobject E₂),
      ∃ Q : ℕ →o CategoryTheory.Subobject E₁,
        ∀ (a b : ℕ) (hab : a ≤ b),
          (CategoryTheory.IsIso
              (F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab))) ↔
            Q a = Q b) ∧
          (∃ (u_a : (Q a : C₁) ≅ F.obj (P a : C₂)) (u_b : (Q b : C₁) ≅ F.obj (P b : C₂)),
            F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) =
              u_a.inv ≫ CategoryTheory.Subobject.ofLE (Q a) (Q b) (Q.monotone hab) ≫ u_b.hom ∧
            CategoryTheory.Subobject.ofLE (Q a) (Q b) (Q.monotone hab) =
              u_a.hom ≫ F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) ≫
                u_b.inv) := by
    intro C₁ C₂ _ _ F _ E₂ E₁ e P
    have hMono : ∀ n : ℕ, CategoryTheory.Mono (F.map (P n).arrow ≫ e.hom) :=
      fun n => CategoryTheory.mono_comp (F.map (P n).arrow) e.hom
    let Q_fun : ℕ → CategoryTheory.Subobject E₁ := fun n =>
      @CategoryTheory.Subobject.mk _ _ _ _ (F.map (P n).arrow ≫ e.hom) (hMono n)
    have hQ_mono : Monotone Q_fun := by
      intro a b hab
      haveI := hMono a
      haveI := hMono b
      refine CategoryTheory.Subobject.mk_le_mk_of_comm
        (F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab))) ?_
      rw [← CategoryTheory.Category.assoc, ← F.map_comp, CategoryTheory.Subobject.ofLE_arrow]
    let Q : ℕ →o CategoryTheory.Subobject E₁ := ⟨Q_fun, hQ_mono⟩
    refine ⟨Q, fun a b hab => ?_⟩
    haveI := hMono a
    haveI := hMono b
    have hQab : Q a ≤ Q b := hQ_mono hab
    let u_a := CategoryTheory.Subobject.underlyingIso (F.map (P a).arrow ≫ e.hom)
    let u_b := CategoryTheory.Subobject.underlyingIso (F.map (P b).arrow ≫ e.hom)
    have hsq : CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab ≫ u_b.hom =
        u_a.hom ≫ F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) := by
      apply (CategoryTheory.cancel_mono (F.map (P b).arrow ≫ e.hom)).mp
      calc
        (CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab ≫ u_b.hom) ≫
            (F.map (P b).arrow ≫ e.hom)
          = CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab ≫ (Q b).arrow := by
            rw [CategoryTheory.Category.assoc]
            congr 1
            exact CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk _
        _ = (Q a).arrow := CategoryTheory.Subobject.ofLE_arrow _
        _ = u_a.hom ≫ (F.map (P a).arrow ≫ e.hom) :=
            (CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk _).symm
        _ = u_a.hom ≫ (F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab) ≫
              (P b).arrow) ≫ e.hom) := by
            rw [CategoryTheory.Subobject.ofLE_arrow]
        _ = (u_a.hom ≫ F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab))) ≫
            (F.map (P b).arrow ≫ e.hom) := by
            rw [F.map_comp, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    have hOfLE_eq : CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab =
        u_a.hom ≫ F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) ≫
          u_b.inv := by
      have h := congrArg (· ≫ u_b.inv) hsq
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.comp_id] at h
      exact h
    have hMap_eq : F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) =
        u_a.inv ≫ CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab ≫ u_b.hom := by
      have h := congrArg (u_a.inv ≫ ·) hsq
      simp only [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp] at h
      exact h.symm.trans (CategoryTheory.Category.assoc _ _ _)
    refine ⟨?_, ⟨u_a, u_b, hMap_eq, hOfLE_eq⟩⟩
    constructor
    · intro _
      haveI : CategoryTheory.IsIso (CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab) := by
        rw [hOfLE_eq]
        infer_instance
      exact CategoryTheory.Subobject.eq_of_comm
        (CategoryTheory.asIso (CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab))
        (CategoryTheory.Subobject.ofLE_arrow _)
    · intro hEq
      have hba : Q b ≤ Q a := hEq ▸ le_rfl
      haveI : CategoryTheory.IsIso (CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab) :=
        ⟨⟨CategoryTheory.Subobject.ofLE (Q b) (Q a) hba, by simp, by simp⟩⟩
      rw [hMap_eq]
      infer_instance

