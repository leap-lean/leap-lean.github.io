        (CategoryTheory.ShortComplex.mk δ_q u_succ h_δu).Exact := by
    intro SC hSE q
    dsimp only []
    let v_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g
    let u_succ_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f
    let δ_pre : SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1) :=
