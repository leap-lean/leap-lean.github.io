    let w₁ := e₁.symm z₁
    have hw₁_eq : e₂.symm (((CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleHigherDirectImageMap f (n + 1) φ)).postcomp Fℤ_S (Nat.add_zero 2)) z₁) =
        ((CategoryTheory.Abelian.Ext.mk₀ (weilEtaleHigherDirectImageMap f n γ)).postcomp
          Fℤ_S (Nat.add_zero 2)) w₁ := by
      apply e₂.injective
      rw [e₂.apply_symm_apply]
      have hz₁_eq : z₁ = e₁ w₁ := (e₁.apply_symm_apply z₁).symm
      rw [hz₁_eq]
      change (((w₁.comp (CategoryTheory.Abelian.Ext.mk₀
            (weilSmPencilLerayConnHom f SC₁ hSE₁ n)) (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleHigherDirectImageMap f (n + 1) Φ_sc.τ₁))
          (Nat.add_zero 2))) =
        ((w₁.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleHigherDirectImageMap f n Φ_sc.τ₃))
            (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilSmPencilLerayConnHom f SC₂ hSE₂ n))
          (Nat.add_zero 2))
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hConnNat hSE₁ hSE₂ Φ_sc n]
    change ((ψ_prev SC₁.X₃ hStep₁.1 w₁).comp hSE₁.extClass rfl).comp
        (CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₁) (Nat.add_zero (n + 3)) =
      (ψ_prev SC₂.X₃ hStep₂.1
        (e₂.symm (((CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleHigherDirectImageMap f (n + 1) φ)).postcomp Fℤ_S (Nat.add_zero 2)) z₁))).comp
        hSE₂.extClass rfl
    rw [CategoryTheory.Abelian.Ext.comp_assoc
          (ψ_prev SC₁.X₃ hStep₁.1 w₁) hSE₁.extClass
          (CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₁)
          rfl (Nat.add_zero 1) (Nat.add_zero (n + 3)),
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₁ hSE₂ Φ_sc,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (ψ_prev SC₁.X₃ hStep₁.1 w₁)
          (CategoryTheory.Abelian.Ext.mk₀ Φ_sc.τ₃) hSE₂.extClass
          (Nat.add_zero (n + 2)) (Nat.zero_add 1) rfl,
        hw₁_eq]
    congr 1
    exact hψ_nat hStep₁.1 hStep₂.1 γ w₁

  have hΨ_nat : ∀ (n : ℕ)
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      (h₁ : ∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q ℱ₁).H p))
      (h₂ : ∀ p q : ℕ, 3 ≤ p → Subsingleton ((weilEtaleHigherDirectImage f q ℱ₂).H p))
      (φ : Quiver.Hom ℱ₁ ℱ₂)
      (z : (weilEtaleHigherDirectImage f n ℱ₁).H 2),
      ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_X (Nat.add_zero (n + 2)))
        (Ψ n ℱ₁ h₁ z) =
      Ψ n ℱ₂ h₂
        (((CategoryTheory.Abelian.Ext.mk₀ (weilEtaleHigherDirectImageMap f n φ)).postcomp
          Fℤ_S (Nat.add_zero 2)) z) := by
    intro n
    induction n with
    | zero =>
      intro ℱ₁ ℱ₂ _ _ φ z
      have hΨ0_eq : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
          (u : (weilEtaleHigherDirectImage f 0 𝒢).H 2),
          Ψ₀ 𝒢 u =
            (CategoryTheory.Abelian.Ext.mk₀
              ((adj_f.homEquiv (weilEtaleHigherDirectImage f 0 𝒢) 𝒢).symm
                (ε₀_app 𝒢).hom)).postcomp Fℤ_X (Nat.add_zero 2)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
                  Fℤ_S (weilEtaleHigherDirectImage f 0 𝒢) 2) u)
                (Nat.zero_add 2)) := by
        intro 𝒢 u
        have hm : (adj_f.homEquiv (weilEtaleHigherDirectImage f 0 𝒢) 𝒢).symm (ε₀_app 𝒢).hom =
            pb_f.map (ε₀_app 𝒢).hom ≫ adj_f.counit.app 𝒢 :=
          CategoryTheory.Adjunction.homEquiv_counit adj_f _ _ _
        change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f
              (u.comp (CategoryTheory.Abelian.Ext.mk₀ (ε₀_app 𝒢).hom) (Nat.add_zero 2)))
            (Nat.zero_add 2)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app 𝒢)) (Nat.add_zero 2) =
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f u) (Nat.zero_add 2)).comp
            (CategoryTheory.Abelian.Ext.mk₀
              ((adj_f.homEquiv (weilEtaleHigherDirectImage f 0 𝒢) 𝒢).symm (ε₀_app 𝒢).hom))
            (Nat.add_zero 2)
        rw [hm, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
