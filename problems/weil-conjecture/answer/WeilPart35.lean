    obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
    let i₁ : Fin 2 := 1 - i₀
    have hi₁_ne : i₁ ≠ i₀ := by
      dsimp [i₁]
      fin_cases i₀ <;> decide
    let X₀ : MvPolynomial (Fin 2) k := MvPolynomial.X i₀
    let X₁ : MvPolynomial (Fin 2) k := MvPolynomial.X i₁
    have hX₀ : X₀ ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 X₀).mpr (MvPolynomial.isHomogeneous_X k i₀)
    have hX₁ : X₁ ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 X₁).mpr (MvPolynomial.isHomogeneous_X k i₁)
    let H₀ := HomogeneousLocalization.Away 𝒜 X₀
    let ι_k : k →+* H₀ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers X₀)).comp
        (algebraMap k ↥(𝒜 0))
    let u₁ : H₀ := HomogeneousLocalization.mk
      { deg := 1
        num := ⟨X₁, hX₁⟩
        den := ⟨X₀, hX₀⟩
        den_mem := Submonoid.mem_powers X₀ }
    let α_hom : Polynomial k →+* H₀ := Polynomial.eval₂RingHom ι_k u₁
    let w : Fin 2 → Polynomial k := fun j => if j = i₀ then 1 else Polynomial.X
    let dehom : MvPolynomial (Fin 2) k →+* Polynomial k :=
      MvPolynomial.eval₂Hom Polynomial.C w
    have hdehom_X₀ : dehom X₀ = 1 := by
      simp [dehom, X₀, w]
    have hdehom_X₁ : dehom X₁ = Polynomial.X := by
      simp [dehom, X₁, w, hi₁_ne]
    have hdehom_pow : ∀ y : Submonoid.powers X₀, dehom y.1 = 1 := by
      rintro ⟨_, ⟨n, rfl⟩⟩
      rw [map_pow, hdehom_X₀, one_pow]
    have hUnit : ∀ y : Submonoid.powers X₀, IsUnit (dehom y.1) := by
      intro y
      rw [hdehom_pow y]
      exact isUnit_one
    let β_loc : Localization (Submonoid.powers X₀) →+* Polynomial k :=
      IsLocalization.lift hUnit
    have hβ_mk : ∀ (p : MvPolynomial (Fin 2) k) (y : Submonoid.powers X₀),
        β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hUnit p (dehom p) y).mpr
        (by rw [hdehom_pow y, one_mul])
    let valHom : H₀ →+* Localization (Submonoid.powers X₀) :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
    let β_hom : H₀ →+* Polynomial k := β_loc.comp valHom
    have hι_k_val : ∀ c : k, (ι_k c).val = Localization.mk (MvPolynomial.C c) 1 :=
      fun _ => rfl
    have hβ_α : β_hom.comp α_hom = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change β_loc (α_hom (Polynomial.C c)).val = Polynomial.C c
        have hαC : α_hom (Polynomial.C c) = ι_k c := by simp [α_hom]
        rw [hαC, hι_k_val c, hβ_mk]
        dsimp [dehom]
        rw [MvPolynomial.eval₂_C]
      · change β_loc (α_hom Polynomial.X).val = Polynomial.X
        have hαX : α_hom Polynomial.X = u₁ := by simp [α_hom]
        rw [hαX]
        dsimp [u₁]
        rw [hβ_mk, hdehom_X₁]
    have hα_β : α_hom.comp β_hom = RingHom.id H₀ := by
      apply RingHom.ext
      intro z
      apply HomogeneousLocalization.val_injective (Submonoid.powers X₀)
      let φ : MvPolynomial (Fin 2) k →+* Localization (Submonoid.powers X₀) :=
        valHom.comp (α_hom.comp dehom)
      have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        change (α_hom (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) 1
        dsimp [dehom]
        rw [MvPolynomial.eval₂_C]
        have hαC : α_hom (Polynomial.C c) = ι_k c := by simp [α_hom]
        rw [hαC, hι_k_val c]
      have hφ_X : ∀ j : Fin 2,
          φ (MvPolynomial.X j) =
            Localization.mk (MvPolynomial.X j) ⟨X₀, Submonoid.mem_powers X₀⟩ := by
        intro j
        by_cases hj : j = i₀
        · subst hj
