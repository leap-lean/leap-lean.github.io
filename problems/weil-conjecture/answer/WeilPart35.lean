          let pb_S := (weilEtaleSitePullback g_S).sheafPullback
            AddCommGrpCat.{u} S.smallEtaleTopology S.smallEtaleTopology
          let adj_S := (weilEtaleSitePullback g_S).sheafAdjunctionContinuous
            AddCommGrpCat.{u} S.smallEtaleTopology S.smallEtaleTopology
          let pb_X := (weilEtaleSitePullback g_X).sheafPullback
            AddCommGrpCat.{u} X.smallEtaleTopology X.smallEtaleTopology
          let ψ₀ := fun (𝒢 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
              (u : (weilEtaleHigherDirectImage f 0 𝒢).H 2) =>
            (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app 𝒢)).postcomp Fℤ_X (Nat.add_zero 2)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
                  Fℤ_S (pf_f.obj 𝒢) 2)
                  (((CategoryTheory.Abelian.Ext.mk₀ (ε₀ 𝒢).hom).postcomp Fℤ_S
                    (Nat.add_zero 2)) u))
                (Nat.zero_add 2))
          ∀ (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
            (β₀ : Quiver.Hom (weilEtaleHigherDirectImage f 0 ℱ)
              (pf_S.obj (weilEtaleHigherDirectImage f 0 (pb_X.obj ℱ)))),
            WeilIsSmPencilLerayBCPush f g_S f g_X h_sq ℱ 0 β₀ →
            ∀ (ιℤ_X : Quiver.Hom Fℤ_X (pb_X.obj Fℤ_X))
              (ιℤ_S : Quiver.Hom Fℤ_S (pb_S.obj Fℤ_S)),
              CategoryTheory.CategoryStruct.comp ιℤ_X
                (weilEtaleConstPullbackHom g_X hT_X hT_X Aℤ) =
                CategoryTheory.CategoryStruct.id Fℤ_X →
              CategoryTheory.CategoryStruct.comp
                (weilEtaleConstPullbackHom g_X hT_X hT_X Aℤ) ιℤ_X =
                CategoryTheory.CategoryStruct.id (pb_X.obj Fℤ_X) →
