    have hu2 : weilEtaleHigherDirectImageMap f 2 (SC_can ℱ).f = 0 :=
      (hInjHDI (SC_can ℱ).X₂ 1).eq_of_tgt _ _
    have : CategoryTheory.Mono (weilSmPencilLerayConnHom f (SC_can ℱ) (hSE_can ℱ) 1) :=
      hEx_vδ1.mono_g hv1
    have : CategoryTheory.Epi (weilSmPencilLerayConnHom f (SC_can ℱ) (hSE_can ℱ) 1) :=
      (hEx_δu1.epi_f_iff).mpr hu2
    exact CategoryTheory.isIso_of_mono_of_epi _

  let q₁_can : ∀ ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      pf_f.obj (SC_can ℱ).X₂ ⟶ CategoryTheory.Limits.cokernel (pf_f.map (SC_can ℱ).f) :=
    fun ℱ => CategoryTheory.Limits.cokernel.π (pf_f.map (SC_can ℱ).f)
  let j₂_can : ∀ ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      CategoryTheory.Limits.cokernel (pf_f.map (SC_can ℱ).f) ⟶ pf_f.obj (SC_can ℱ).X₃ :=
    fun ℱ => CategoryTheory.Limits.cokernel.desc (pf_f.map (SC_can ℱ).f)
      (pf_f.map (SC_can ℱ).g) ((SC_can ℱ).map pf_f).zero
  let δ₀_can : ∀ ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      pf_f.obj (SC_can ℱ).X₃ ⟶ weilEtaleHigherDirectImage f 1 ℱ :=
    fun ℱ => (ε₀ (SC_can ℱ).X₃).inv ≫ weilSmPencilLerayConnHom f (SC_can ℱ) (hSE_can ℱ) 0

  let SC_S1_can : ∀ ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
    fun ℱ => CategoryTheory.ShortComplex.mk (pf_f.map (SC_can ℱ).f) (q₁_can ℱ)
      (CategoryTheory.Limits.cokernel.condition (pf_f.map (SC_can ℱ).f))

  have hSplitPush : ∀ ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
      CategoryTheory.Injective (pf_f.obj (SC_can ℱ).X₂) ∧
      (SC_S1_can ℱ).ShortExact ∧
      ∃ hj₂δ₀ : j₂_can ℱ ≫ δ₀_can ℱ = 0,
        (CategoryTheory.ShortComplex.mk (j₂_can ℱ) (δ₀_can ℱ) hj₂δ₀).ShortExact := by
    intro ℱ
    have hInj_pf : CategoryTheory.Injective (pf_f.obj (SC_can ℱ).X₂) :=
      CategoryTheory.Injective.injective_of_adjoint adj_f (SC_can ℱ).X₂
    obtain ⟨hEx_pf, hMono_pf⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_f).mp
        inferInstance (SC_can ℱ) (hSE_can ℱ)
    have hSE_S1 : (SC_S1_can ℱ).ShortExact :=
      @CategoryTheory.ShortComplex.ShortExact.mk' _ _ _ (SC_S1_can ℱ)
        (CategoryTheory.ShortComplex.exact_cokernel (pf_f.map (SC_can ℱ).f)) hMono_pf inferInstance
    have : CategoryTheory.Mono (j₂_can ℱ) := hEx_pf.mono_cokernelDesc
    obtain ⟨h_vδ0, h_δu0, hEx_vδ0, hEx_δu0⟩ := hJoints (SC_can ℱ) (hSE_can ℱ) 0
    have hu1 : weilEtaleHigherDirectImageMap f 1 (SC_can ℱ).f = 0 :=
      (hInjHDI (SC_can ℱ).X₂ 0).eq_of_tgt _ _
    have : CategoryTheory.Epi (weilSmPencilLerayConnHom f (SC_can ℱ) (hSE_can ℱ) 0) :=
      (hEx_δu0.epi_f_iff).mpr hu1
    have : CategoryTheory.Epi (δ₀_can ℱ) :=
      CategoryTheory.epi_comp (ε₀ (SC_can ℱ).X₃).inv
        (weilSmPencilLerayConnHom f (SC_can ℱ) (hSE_can ℱ) 0)
    have h_gδ0 : pf_f.map (SC_can ℱ).g ≫ δ₀_can ℱ = 0 := by
      dsimp [δ₀_can]
      have hcomm : pf_f.map (SC_can ℱ).g ≫ (ε₀ (SC_can ℱ).X₃).inv =
          (ε₀ (SC_can ℱ).X₂).inv ≫ weilEtaleHigherDirectImageMap f 0 (SC_can ℱ).g := by
        rw [CategoryTheory.Iso.comp_inv_eq, CategoryTheory.Category.assoc,
          hε₀_nat (SC_can ℱ).g, CategoryTheory.Iso.inv_hom_id_assoc]
      rw [← CategoryTheory.Category.assoc, hcomm, CategoryTheory.Category.assoc,
        h_vδ0, CategoryTheory.Limits.comp_zero]
    have hEx_gδ0 : (CategoryTheory.ShortComplex.mk (pf_f.map (SC_can ℱ).g) (δ₀_can ℱ) h_gδ0).Exact := by
      let e_iso : CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f 0 (SC_can ℱ).g)
            (weilSmPencilLerayConnHom f (SC_can ℱ) (hSE_can ℱ) 0) h_vδ0 ≅
          CategoryTheory.ShortComplex.mk (pf_f.map (SC_can ℱ).g) (δ₀_can ℱ) h_gδ0 :=
        CategoryTheory.ShortComplex.isoMk (ε₀ (SC_can ℱ).X₂) (ε₀ (SC_can ℱ).X₃)
          (CategoryTheory.Iso.refl (weilEtaleHigherDirectImage f 1 ℱ))
          (hε₀_nat (SC_can ℱ).g).symm
          (by
            dsimp [δ₀_can]
            rw [CategoryTheory.Category.comp_id, CategoryTheory.Iso.hom_inv_id_assoc])
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso e_iso).mp hEx_vδ0
    have hj₂δ₀ : j₂_can ℱ ≫ δ₀_can ℱ = 0 := by
      apply (CategoryTheory.cancel_epi (q₁_can ℱ)).mp
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
        h_gδ0, CategoryTheory.Limits.comp_zero]
    let ψ_q : CategoryTheory.ShortComplex.mk (pf_f.map (SC_can ℱ).g) (δ₀_can ℱ) h_gδ0 ⟶
        CategoryTheory.ShortComplex.mk (j₂_can ℱ) (δ₀_can ℱ) hj₂δ₀ :=
      CategoryTheory.ShortComplex.homMk (q₁_can ℱ) (𝟙 _) (𝟙 _)
        (by dsimp [q₁_can, j₂_can]; simp)
        (by simp)
    have hEx_S2 : (CategoryTheory.ShortComplex.mk (j₂_can ℱ) (δ₀_can ℱ) hj₂δ₀).Exact :=
      (@CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ ψ_q
        (by change CategoryTheory.Epi (q₁_can ℱ); infer_instance)
        (by change CategoryTheory.IsIso (𝟙 _); infer_instance)
        (by change CategoryTheory.Mono (𝟙 _); infer_instance)).mp hEx_gδ0
    exact ⟨hInj_pf, hSE_S1, hj₂δ₀, CategoryTheory.ShortComplex.ShortExact.mk' hEx_S2
      inferInstance inferInstance⟩

  have hPentagon : ∀ (ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (hSE_S1 : (SC_S1_can ℱ).ShortExact) (k : ℕ)
      (m : (SC_S1_can ℱ).X₃.H k),
      leray_f ℱ (k + 1) (m.comp hSE_S1.extClass (rfl : k + 1 = k + 1)) =
        (leray_f (SC_can ℱ).X₃ k
          (m.comp (CategoryTheory.Abelian.Ext.mk₀ (j₂_can ℱ)) (Nat.add_zero k))).comp
          (hSE_can ℱ).extClass (rfl : k + 1 = k + 1) := by
    intro ℱ hSE_S1 k m
    let hSE_pb : ((SC_S1_can ℱ).map pb_f).ShortExact := hSE_S1.map_of_exact pb_f
    let Φ_pent : (SC_S1_can ℱ).map pb_f ⟶ SC_can ℱ :=
      { τ₁ := adj_f.counit.app ℱ
        τ₂ := adj_f.counit.app (SC_can ℱ).X₂
        τ₃ := pb_f.map (j₂_can ℱ) ≫ adj_f.counit.app (SC_can ℱ).X₃
        comm₁₂ := (adj_f.counit.naturality (SC_can ℱ).f).symm
        comm₂₃ := by
          dsimp [SC_S1_can, q₁_can, j₂_can]
          rw [← CategoryTheory.Category.assoc, ← pb_f.map_comp,
            CategoryTheory.Limits.cokernel.π_desc]
          exact (adj_f.counit.naturality (SC_can ℱ).g).symm }
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f (m.comp hSE_S1.extClass rfl))
        (Nat.zero_add (k + 1))).comp (CategoryTheory.Abelian.Ext.mk₀ Φ_pent.τ₁)
        (Nat.add_zero (k + 1)) =
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f
          (m.comp (CategoryTheory.Abelian.Ext.mk₀ (j₂_can ℱ)) (Nat.add_zero k)))
        (Nat.zero_add k)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app (SC_can ℱ).X₃))
        (Nat.add_zero k)).comp (hSE_can ℱ).extClass rfl
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f m)
        hSE_pb.extClass (Nat.zero_add k) rfl (Nat.zero_add (k + 1)),
      CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f m) (Nat.zero_add k))
        hSE_pb.extClass (CategoryTheory.Abelian.Ext.mk₀ Φ_pent.τ₁)
        rfl (Nat.add_zero 1) (Nat.add_zero (k + 1)),
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb (hSE_can ℱ) Φ_pent,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f m) (Nat.zero_add k))
        (CategoryTheory.Abelian.Ext.mk₀ Φ_pent.τ₃) (hSE_can ℱ).extClass
        (Nat.add_zero k) (Nat.zero_add 1) rfl]
    congr 1
    dsimp [Φ_pent]
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f m)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_f.map (j₂_can ℱ))) (Nat.zero_add k),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (pb_f.map (j₂_can ℱ)))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app (SC_can ℱ).X₃)) (Nat.add_zero k),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  
  have hDeg1Exact : ∀ (𝒬 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (y₁ : 𝒬.H 1),
      weilOuterTrFibEdgeHom f T_S hT_top 𝒬 1 y₁ = 0 ↔
        ∃ z₁ : (pf_f.obj 𝒬).H 1, leray_f 𝒬 1 z₁ = y₁ := by
    intro 𝒬 y₁
    obtain ⟨hInj_pf', hSE_S1', hj₂δ₀', hSE_S2'⟩ := hSplitPush 𝒬
    have : CategoryTheory.Injective (pf_f.obj (SC_can 𝒬).X₂) := hInj_pf'
    have hBridge : ∀ w₀ : (pf_f.obj (SC_can 𝒬).X₃).H 0,
        Γ_H0 (weilEtaleHigherDirectImage f 1 𝒬)
          (w₀.comp (CategoryTheory.Abelian.Ext.mk₀ (δ₀_can 𝒬)) (Nat.add_zero 0)) =
        weilOuterTrFibEdgeHom f T_S hT_top 𝒬 1
          ((leray_f (SC_can 𝒬).X₃ 0 w₀).comp (hSE_can 𝒬).extClass (rfl : 0 + 1 = 1)) := by
      intro w₀
      rw [hΓ_nat (δ₀_can 𝒬) w₀, ← hMasterDeg0 (SC_can 𝒬).X₃ w₀]
      have hcan : (ε₀ (SC_can 𝒬).X₃).hom ≫ δ₀_can 𝒬 =
          weilSmPencilLerayConnHom f (SC_can 𝒬) (hSE_can 𝒬) 0 := by
        dsimp [δ₀_can]
        exact (ε₀ (SC_can 𝒬).X₃).hom_inv_id_assoc _
      have happ : ((δ₀_can 𝒬).hom.app (Opposite.op T_S))
          (((ε₀ (SC_can 𝒬).X₃).hom.hom.app (Opposite.op T_S))
            (weilOuterTrFibEdgeHom f T_S hT_top (SC_can 𝒬).X₃ 0 (leray_f (SC_can 𝒬).X₃ 0 w₀))) =
          (((ε₀ (SC_can 𝒬).X₃).hom ≫ δ₀_can 𝒬).hom.app (Opposite.op T_S))
            (weilOuterTrFibEdgeHom f T_S hT_top (SC_can 𝒬).X₃ 0
              (leray_f (SC_can 𝒬).X₃ 0 w₀)) := rfl
      rw [happ, hcan]
      exact hEdgeConn (SC_can 𝒬) (hSE_can 𝒬) 0 (leray_f (SC_can 𝒬).X₃ 0 w₀)
    refine ⟨?_, ?_⟩
    · intro hy₁
      have hy₁_zero : y₁.comp (CategoryTheory.Abelian.Ext.mk₀ (SC_can 𝒬).f) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨k₀, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X
        (hSE_can 𝒬) y₁ hy₁_zero (Nat.zero_add 1)
      obtain ⟨w₀, hw₀⟩ := hLeray0_surj (SC_can 𝒬).X₃ k₀
      have hδw₀ : w₀.comp (CategoryTheory.Abelian.Ext.mk₀ (δ₀_can 𝒬)) (Nat.add_zero 0) = 0 := by
        apply hΓ_inj (weilEtaleHigherDirectImage f 1 𝒬)
        rw [hBridge w₀, hw₀, hy₁, hΓ_zero]
      obtain ⟨m₀, hm₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_S
        hSE_S2' w₀ hδw₀
      refine ⟨m₀.comp hSE_S1'.extClass (rfl : 0 + 1 = 1), ?_⟩
      rw [hPentagon 𝒬 hSE_S1' 0 m₀]
      change (leray_f (SC_can 𝒬).X₃ 0
          (m₀.comp (CategoryTheory.Abelian.Ext.mk₀ (j₂_can 𝒬)) (Nat.add_zero 0))).comp
          (hSE_can 𝒬).extClass (Nat.zero_add 1) = _
      rw [hm₀, hw₀]
    · rintro ⟨z₁, rfl⟩
      have hz₁_zero : z₁.comp (CategoryTheory.Abelian.Ext.mk₀ (SC_S1_can 𝒬).f)
          (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨m₀, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_S
        hSE_S1' z₁ hz₁_zero (rfl : 0 + 1 = 1)
      rw [hPentagon 𝒬 hSE_S1' 0 m₀, ← hBridge]
      have harg0 : (m₀.comp (CategoryTheory.Abelian.Ext.mk₀ (j₂_can 𝒬)) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (δ₀_can 𝒬)) (Nat.add_zero 0) = 0 := by
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hj₂δ₀',
          CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      rw [harg0, hΓ_zero]

  
  intro 𝒜 hSubR1 y
  obtain ⟨hInj_pf, hSE_S1, _, hSE_S2⟩ := hSplitPush 𝒜
  have : CategoryTheory.Injective (pf_f.obj (SC_can 𝒜).X₂) := hInj_pf
  have hIso1 : CategoryTheory.IsIso (weilSmPencilLerayConnHom f (SC_can 𝒜) (hSE_can 𝒜) 1) :=
    hConn1_iso 𝒜
  refine ⟨?_, ?_⟩
  · intro hy
    have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ (SC_can 𝒜).f) (Nat.add_zero 2) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨y₁, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X
      (hSE_can 𝒜) y hy0 (rfl : 1 + 1 = 2)
    have hedge1 : weilOuterTrFibEdgeHom f T_S hT_top (SC_can 𝒜).X₃ 1 y₁ = 0 := by
      have hc := (hEdgeConn (SC_can 𝒜) (hSE_can 𝒜) 1 y₁).trans hy
      let c_inv := (@CategoryTheory.inv _ _ _ _
        (weilSmPencilLerayConnHom f (SC_can 𝒜) (hSE_can 𝒜) 1) hIso1).hom.app (Opposite.op T_S)
      have hcan : (weilSmPencilLerayConnHom f (SC_can 𝒜) (hSE_can 𝒜) 1).hom.app
          (Opposite.op T_S) ≫ c_inv = 𝟙 _ :=
        congrArg (fun k => k.hom.app (Opposite.op T_S))
          (@CategoryTheory.IsIso.hom_inv_id _ _ _ _
            (weilSmPencilLerayConnHom f (SC_can 𝒜) (hSE_can 𝒜) 1) hIso1)
      have hc2 := congrArg (fun s => c_inv s) hc
      rw [map_zero] at hc2
      change ((weilSmPencilLerayConnHom f (SC_can 𝒜) (hSE_can 𝒜) 1).hom.app
          (Opposite.op T_S) ≫ c_inv)
        (weilOuterTrFibEdgeHom f T_S hT_top (SC_can 𝒜).X₃ 1 y₁) = 0 at hc2
      rw [hcan] at hc2
      exact hc2
    obtain ⟨z₁, hz₁⟩ := (hDeg1Exact (SC_can 𝒜).X₃ y₁).mp hedge1
    have hδz₁ : z₁.comp (CategoryTheory.Abelian.Ext.mk₀ (δ₀_can 𝒜)) (Nat.add_zero 1) = 0 :=
      Subsingleton.elim _ 0
    obtain ⟨m₁, hm₁⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_S
      hSE_S2 z₁ hδz₁
    refine ⟨m₁.comp hSE_S1.extClass (rfl : 1 + 1 = 2), ?_⟩
    change leray_f 𝒜 2 (m₁.comp hSE_S1.extClass (rfl : 1 + 1 = 2)) = _
    rw [hPentagon 𝒜 hSE_S1 1 m₁]
    change (leray_f (SC_can 𝒜).X₃ 1
        (m₁.comp (CategoryTheory.Abelian.Ext.mk₀ (j₂_can 𝒜)) (Nat.add_zero 1))).comp
        (hSE_can 𝒜).extClass (rfl : 1 + 1 = 2) = _
    rw [hm₁, hz₁]
  · rintro ⟨w, hw⟩
    rw [← hw]
    change weilOuterTrFibEdgeHom f T_S hT_top 𝒜 2 (leray_f 𝒜 2 w) = 0
    have hw0 : w.comp (CategoryTheory.Abelian.Ext.mk₀ (SC_S1_can 𝒜).f) (Nat.add_zero 2) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨m₁, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_S
      hSE_S1 w hw0 (rfl : 1 + 1 = 2)
    rw [hPentagon 𝒜 hSE_S1 1 m₁, ← hEdgeConn (SC_can 𝒜) (hSE_can 𝒜) 1]
    have hedge_zero : weilOuterTrFibEdgeHom f T_S hT_top (SC_can 𝒜).X₃ 1
        (leray_f (SC_can 𝒜).X₃ 1
          (m₁.comp (CategoryTheory.Abelian.Ext.mk₀ (j₂_can 𝒜)) (Nat.add_zero 1))) = 0 :=
      (hDeg1Exact (SC_can 𝒜).X₃ _).mpr ⟨_, rfl⟩
    rw [hedge_zero, map_zero]

theorem weil_sm_pencil_scheme_iso_pullback_injective_and_subsingleton_H (sys : WeilEtaleSitePullbackSys.{u})
    {Y : AlgebraicGeometry.Scheme.{u}} (e_Y : Y ≅ Y) :
    letI := (sys e_Y.hom).hCont
    letI := (sys e_Y.hom).hAdj
    let pb_Y := (weilEtaleSitePullback e_Y.hom).sheafPullback
      AddCommGrpCat.{u} Y.smallEtaleTopology Y.smallEtaleTopology
    (∀ (ℐ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective ℐ], CategoryTheory.Injective (pb_Y.obj ℐ)) ∧
    (∀ (𝒢 : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (p : ℕ),
      Subsingleton (𝒢.H p) → Subsingleton ((pb_Y.obj 𝒢).H p)) :=
by
  intro pb_Y
  have := (sys e_Y.hom).hCont
  have := (sys e_Y.hom).hAdj
  have := (sys e_Y.hom).hAdd_pb
  have := (sys e_Y.hom).hLim_pb
  have := (sys e_Y.hom).hColim_pb
  have := (sys e_Y.inv).hCont
  have := (sys e_Y.inv).hAdj
  have := (sys e_Y.inv).hAdd_pb
  have := (sys e_Y.inv).hLim_pb
  have := (sys e_Y.inv).hColim_pb
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let J := Y.smallEtaleTopology
  let 𝒜_Y := CategoryTheory.Sheaf J AddCommGrpCat.{u}
  let B₁ : CategoryTheory.Functor Y.Etale Y.Etale := weilEtaleSitePullback e_Y.hom
  let B₂ : CategoryTheory.Functor Y.Etale Y.Etale := weilEtaleSitePullback e_Y.inv
  let B_id : CategoryTheory.Functor Y.Etale Y.Etale :=
