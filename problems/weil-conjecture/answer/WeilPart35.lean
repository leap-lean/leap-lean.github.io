    (hFin_M : ∀ r : ℕ, Finite (weilEtaleTorsionH (weilGeomScheme F Z_tilde) (ℓ ^ (r + 1)) i_tot))
    (hTor_M : ∀ (s : ℕ) (y : weilEtaleTorsionH (weilGeomScheme F Z_tilde) (ℓ ^ s) i_tot),
      (ℓ ^ s) • y = 0)
    (hM_frob_trans : ∀ (s : ℕ)
        (u : weilEtaleTorsionH (weilGeomScheme F Z_tilde) (ℓ ^ (s + 1)) i_tot),
      weilEtaleTorsionTransition (weilGeomScheme F Z_tilde) ℓ s i_tot
        (M_Z.frobTorsion (s + 1) u) =
      M_Z.frobTorsion s (weilEtaleTorsionTransition (weilGeomScheme F Z_tilde) ℓ s i_tot u))
    (hFin_E2_2 : ∀ r : ℕ, Finite ((E2_2.ℳ_bar r).H 2))
