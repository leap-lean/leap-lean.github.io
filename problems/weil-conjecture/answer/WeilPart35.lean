          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) := by
      intro A B C _ _ _ _ _ _ _
      exact (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp _ _).symm.trans
            (congrArg CommRingCat.ofHom (IsScalarTower.algebraMap_eq A B C).symm)))

    have hEtSpecFin : ∀ (K₁ K₂ : Type u) [Finite K₁] [Field K₁] [Finite K₂] [Field K₂] [Algebra K₁ K₂],
        AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ K₂))) := by
      intro K₁ K₂ _ _ _ _ _
      let : PerfectField K₁ := PerfectField.ofFinite
      have : Algebra.IsAlgebraic K₁ K₂ := Algebra.IsAlgebraic.of_finite K₁ K₂
      have hSep : Algebra.IsSeparable K₁ K₂ := Algebra.IsAlgebraic.isSeparable_of_perfectField
