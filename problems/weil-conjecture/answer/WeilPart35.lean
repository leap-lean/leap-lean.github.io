      _ = g ≫ eR_inv (pb₁.obj ℐ) ≫ eR_hom (pb₁.obj ℐ) := by
            rw [← heR_inv_nat g, CategoryTheory.Category.assoc]
      _ = g := by
            rw [heR_inv_hom (pb₁.obj ℐ), CategoryTheory.Category.comp_id]
  · have hExtRec : ∀ (n : ℕ) {X₀ Y₀ : 𝒜_Y} (x : CategoryTheory.Abelian.Ext X₀ Y₀ n),
        x = (CategoryTheory.Abelian.Ext.mk₀ (eR_inv X₀)).comp
          (((CategoryTheory.Abelian.Ext.mapExactFunctor pb₁
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ x)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (eR_hom Y₀)) (Nat.add_zero n)))
