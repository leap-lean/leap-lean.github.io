theorem weil_sing_dev_leray_ell_adic_eigenvalue_trichotomy (F : Type u) [Finite F] [Field F]
    (Z_tilde D₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i_tot : ℕ)
    (ℳ₂ ℳ₁ ℳ₀ : ℕ → CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u})
