        · rw [hsec_m₂ f₁ h₂ hh₂, map_zero,
            hsec_m₂ (g ≫ f₁) (g ≫ h₂) (by rw [Category.assoc, hh₂])]
      let fam : CategoryTheory.Presieve.FamilyOfElements
          (S.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) R_cov.arrows :=
        fun _ f _ => mkZHom (sec_val f)
      have hfam_compat : CategoryTheory.Presieve.FamilyOfElements.Compatible fam := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hgf
        change mkZHom (sec_val f₁) ≫ S.obj.map g₁.op =
          mkZHom (sec_val f₂) ≫ S.obj.map g₂.op
        apply AddCommGrpCat.ext
        rintro ⟨z⟩
        change (S.obj.map g₁.op) (z • sec_val f₁) =
          (S.obj.map g₂.op) (z • sec_val f₂)
        rw [map_zsmul, map_zsmul, hsec_pull g₁ f₁ hf₁, hsec_pull g₂ f₂ hf₂, hgf]
      obtain ⟨y_glob, hy_glob, -⟩ := S.cond Aℤ R_cov hR_cov fam hfam_compat
      let y_hom : Aℤ ⟶ S.obj.obj (Opposite.op T_X) := y_glob
      have hm₁_mem : R_cov.arrows m₁ := Or.inl ⟨𝟙 E_U', Category.id_comp m₁⟩
      have hy_m₁ := congrArg (fun (φ : Aℤ ⟶ S.obj.obj (Opposite.op E_U')) =>
