    (Δ : Set (Fin M → Padic ℓ))
    (hΔ_ne : Δ.Nonempty)
    (hΔ_span : Submodule.span (Padic ℓ) Δ = ⊤)
    (hΔ_orb : ∀ v₁ ∈ Δ, ∀ v₂ ∈ Δ, ∃ h ∈ G_geom,
      ((h.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v₁ = v₂)
    (hDense : ∀ (k : ℕ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ), g ∈ G_geom →
      ∃ h ∈ Subgroup.closure
        { u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ |
          u ∈ G_geom ∧ ∃ v ∈ Δ, ∃ c : Padic ℓ,
            ∀ x : Fin M → Padic ℓ,
              ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                x + (c * dotProduct x (J.mulVec v)) • v },
        (h.val).map (PadicInt.toZModPow k) = (g.val).map (PadicInt.toZModPow k))
    (U_sub : Submodule (Padic ℓ) (Fin M → Padic ℓ))
    (hU : ∀ v ∈ Δ, ∀ u ∈ U_sub, (dotProduct u (J.mulVec v)) • v ∈ U_sub) :
    U_sub = ⊥ ∨ U_sub = ⊤ :=
by
  have _ := hM
  have _ := hΔ_ne
  let R := PadicInt ℓ
  let K := Padic ℓ
  let ι : R →+* K := algebraMap R K
  let S_gen : Set ((Matrix (Fin M) (Fin M) R)ˣ) :=
    { u : (Matrix (Fin M) (Fin M) R)ˣ |
      u ∈ G_geom ∧ ∃ v ∈ Δ, ∃ c : K,
        ∀ x : Fin M → K,
          ((u.val).map ι).mulVec x =
            x + (c * dotProduct x (J.mulVec v)) • v }
  have hmap_one : (1 : Matrix (Fin M) (Fin M) R).map ι = 1 :=
    (RingHom.mapMatrix ι).map_one
  have hmap_mul : ∀ A B : Matrix (Fin M) (Fin M) R, (A * B).map ι = A.map ι * B.map ι :=
    (RingHom.mapMatrix ι).map_mul
  have h_iso : ∀ v : Fin M → K, dotProduct v (J.mulVec v) = 0 := by
    intro v
    have h_eq : dotProduct v (J.mulVec v) = -dotProduct v (J.mulVec v) := by
      conv_lhs =>
        rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hJ_skew,
          Matrix.neg_mulVec, neg_dotProduct, dotProduct_comm]
    exact CharZero.neg_eq_self_iff.mp h_eq.symm
  have h_cl_two : ∀ h ∈ Subgroup.closure S_gen,
      (∀ x ∈ U_sub, ((h.val).map ι).mulVec x ∈ U_sub) ∧
      (∀ x ∈ U_sub, (((h⁻¹).val).map ι).mulVec x ∈ U_sub) := by
    intro h hh
    induction hh using Subgroup.closure_induction with
    | mem u hu =>
      rcases hu with ⟨_, v, hv, c, hu_act⟩
      refine ⟨?_, ?_⟩
      · intro x hx
        rw [hu_act x, mul_smul]
        exact U_sub.add_mem hx (U_sub.smul_mem c (hU v hv x hx))
      · intro x hx
        let z : Fin M → K := x - (c * dotProduct x (J.mulVec v)) • v
        have hz_mem : z ∈ U_sub := by
          dsimp [z]
          rw [mul_smul]
          exact U_sub.sub_mem hx (U_sub.smul_mem c (hU v hv x hx))
        have hz_dot : dotProduct z (J.mulVec v) = dotProduct x (J.mulVec v) := by
          dsimp [z]
          rw [sub_dotProduct, smul_dotProduct, h_iso v, smul_zero, sub_zero]
        have hu_z : ((u.val).map ι).mulVec z = x := by
          rw [hu_act z, hz_dot]
          dsimp [z]
          exact sub_add_cancel x _
        have h_inv_x : (((u⁻¹).val).map ι).mulVec x = z := by
          rw [← hu_z, Matrix.mulVec_mulVec, ← hmap_mul, ← Units.val_mul,
            inv_mul_cancel, Units.val_one, hmap_one, Matrix.one_mulVec]
        rw [h_inv_x]
        exact hz_mem
    | one =>
      refine ⟨fun x hx => ?_, fun x hx => ?_⟩
      · rw [Units.val_one, hmap_one, Matrix.one_mulVec]
        exact hx
      · rw [inv_one, Units.val_one, hmap_one, Matrix.one_mulVec]
        exact hx
    | mul g₁ g₂ _ _ ih₁ ih₂ =>
      refine ⟨fun x hx => ?_, fun x hx => ?_⟩
      · rw [Units.val_mul, hmap_mul, ← Matrix.mulVec_mulVec]
        exact ih₁.1 _ (ih₂.1 x hx)
      · rw [mul_inv_rev, Units.val_mul, hmap_mul, ← Matrix.mulVec_mulVec]
        exact ih₂.2 _ (ih₁.2 x hx)
    | inv g _ ih =>
      exact ⟨ih.2, by simpa only [inv_inv] using ih.1⟩
  have h_vec_sum : ∀ y : Fin M → K, y = ∑ i : Fin M, y i • Pi.single i (1 : K) := by
    intro y
    ext m
    simp [Pi.single_apply]
  have hG_inv : ∀ g ∈ G_geom, ∀ x ∈ U_sub, ((g.val).map ι).mulVec x ∈ U_sub := by
    intro g hg x hx
    set w : Fin M → K := ((g.val).map ι).mulVec x
    by_contra hw
    obtain ⟨f, hfw, hfU⟩ :=
      Submodule.exists_dual_map_eq_bot_of_notMem hw
        (inferInstance : Module.Projective K ((Fin M → K) ⧸ U_sub))
    let lam : (Fin M → K) →ₗ[K] K := (f w)⁻¹ • f
    have hlam_w : lam w = 1 := by
      simp only [lam, LinearMap.smul_apply, smul_eq_mul, inv_mul_cancel₀ hfw]
    have hlam_U : ∀ z ∈ U_sub, lam z = 0 := by
      intro z hz
      have hfz_mem : f z ∈ Submodule.map f U_sub := Submodule.mem_map_of_mem hz
      rw [hfU, Submodule.mem_bot] at hfz_mem
      simp only [lam, LinearMap.smul_apply, hfz_mem, smul_zero]
    let C : ℝ := ∑ i : Fin M, ∑ j : Fin M, ‖x j‖ * ‖lam (Pi.single i (1 : K))‖
    have h_bound : ∀ k : ℕ, (ℓ : ℝ) ^ k ≤ C := by
      intro k
      obtain ⟨h, hh_cl, hh_mod⟩ := hDense k g hg
      have hwh_mem : ((h.val).map ι).mulVec x ∈ U_sub := (h_cl_two h hh_cl).1 x hx
      let A : Matrix (Fin M) (Fin M) K := (g.val).map ι - (h.val).map ι
      have hlam_A : lam (A.mulVec x) = 1 := by
        dsimp [A]
        rw [Matrix.sub_mulVec, map_sub, hlam_w, hlam_U _ hwh_mem, sub_zero]
      have h_expand : (1 : K) =
          ∑ i : Fin M, ∑ j : Fin M, A i j * x j * lam (Pi.single i (1 : K)) := by
        conv_lhs => rw [← hlam_A, h_vec_sum (A.mulVec x)]
        rw [map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_smul, smul_eq_mul, Matrix.mulVec, dotProduct, Finset.sum_mul]
      have hA_norm : ∀ i j : Fin M, ‖A i j‖ ≤ ((ℓ : ℝ) ^ k)⁻¹ := by
        intro i j
        have h_entry_mod : PadicInt.toZModPow k (g.val i j) = PadicInt.toZModPow k (h.val i j) := by
          have h1 := congr_fun (congr_fun hh_mod.symm i) j
          simpa only [Matrix.map_apply] using h1
        have h_ker : g.val i j - h.val i j ∈ RingHom.ker (PadicInt.toZModPow k) := by
          rw [RingHom.mem_ker, map_sub, h_entry_mod, sub_self]
        rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton] at h_ker
        obtain ⟨d, hd⟩ := h_ker
        have hA_ij : A i j = (ℓ : K) ^ k * (d : K) := by
          change ι (g.val i j) - ι (h.val i j) = (ℓ : K) ^ k * (d : K)
          rw [← map_sub, hd, map_mul, map_pow, map_natCast, PadicInt.algebraMap_apply]
        rw [hA_ij, norm_mul, norm_pow, Padic.norm_p, ← PadicInt.norm_def, inv_pow]
        exact mul_le_of_le_one_right (by positivity) (PadicInt.norm_le_one d)
      have h1_le : (1 : ℝ) ≤ ((ℓ : ℝ) ^ k)⁻¹ * C := by
        calc
          (1 : ℝ) = ‖(1 : K)‖ := norm_one.symm
          _ = ‖∑ i : Fin M, ∑ j : Fin M, A i j * x j * lam (Pi.single i (1 : K))‖ := by
              rw [← h_expand]
          _ ≤ ∑ i : Fin M, ‖∑ j : Fin M, A i j * x j * lam (Pi.single i (1 : K))‖ :=
              norm_sum_le _ _
          _ ≤ ∑ i : Fin M, ∑ j : Fin M, ‖A i j * x j * lam (Pi.single i (1 : K))‖ :=
              Finset.sum_le_sum fun i _ => norm_sum_le _ _
          _ = ∑ i : Fin M, ∑ j : Fin M, ‖A i j‖ * (‖x j‖ * ‖lam (Pi.single i (1 : K))‖) := by
              refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
              rw [norm_mul, norm_mul, mul_assoc]
          _ ≤ ∑ i : Fin M, ∑ j : Fin M, ((ℓ : ℝ) ^ k)⁻¹ * (‖x j‖ * ‖lam (Pi.single i (1 : K))‖) := by
              refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => ?_
              exact mul_le_mul_of_nonneg_right (hA_norm i j) (by positivity)
          _ = ((ℓ : ℝ) ^ k)⁻¹ * C := by
              dsimp [C]
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [Finset.mul_sum]
      have hℓ_pos : (0 : ℝ) < (ℓ : ℝ) := by
        exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
      have hpow_pos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos hℓ_pos k
      calc
        (ℓ : ℝ) ^ k = (ℓ : ℝ) ^ k * 1 := (mul_one _).symm
        _ ≤ (ℓ : ℝ) ^ k * (((ℓ : ℝ) ^ k)⁻¹ * C) :=
            mul_le_mul_of_nonneg_left h1_le hpow_pos.le
        _ = C := mul_inv_cancel_left₀ hpow_pos.ne' C
    have hℓ_gt_one : (1 : ℝ) < (ℓ : ℝ) := by
      exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨k₀, hk₀⟩ := pow_unbounded_of_one_lt C hℓ_gt_one
    exact (not_lt_of_ge (h_bound k₀)) hk₀
  by_cases h_bot : U_sub = ⊥
  · exact Or.inl h_bot
  · right
    obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := (Submodule.ne_bot_iff U_sub).mp h_bot
    have h_exists_v : ∃ v₀ ∈ Δ, dotProduct u₀ (J.mulVec v₀) ≠ 0 := by
      by_contra h_all_zero
      have h_all_zero' : ∀ v ∈ Δ, dotProduct u₀ (J.mulVec v) = 0 :=
        fun v hv => by_contra fun hne => h_all_zero ⟨v, hv, hne⟩
      let φ : (Fin M → K) →ₗ[K] K :=
        { toFun := fun y => dotProduct u₀ (J.mulVec y)
          map_add' := fun y₁ y₂ => by rw [Matrix.mulVec_add, dotProduct_add]
          map_smul' := fun c y => by
            rw [Matrix.mulVec_smul, dotProduct_smul, RingHom.id_apply, smul_eq_mul] }
      have hΔ_ker : Δ ⊆ (LinearMap.ker φ : Set (Fin M → K)) := by
        intro v hv
        exact LinearMap.mem_ker.mpr (h_all_zero' v hv)
      have h_top_ker : (⊤ : Submodule K (Fin M → K)) ≤ LinearMap.ker φ := by
        rw [← hΔ_span]
        exact Submodule.span_le.mpr hΔ_ker
      have hJ_unit : IsUnit J.det := isUnit_iff_ne_zero.mpr hJ_det
      have hu₀_zero : u₀ = 0 := by
        ext i
        have h_mem_ker : J⁻¹.mulVec (Pi.single i (1 : K)) ∈ LinearMap.ker φ :=
          h_top_ker Submodule.mem_top
        have h_eval : dotProduct u₀ (J.mulVec (J⁻¹.mulVec (Pi.single i (1 : K)))) = 0 :=
          LinearMap.mem_ker.mp h_mem_ker
        rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv J hJ_unit, Matrix.one_mulVec,
          dotProduct_single_one] at h_eval
        exact h_eval
      exact hu₀_ne hu₀_zero
    obtain ⟨v₀, hv₀_Δ, hc₀_ne⟩ := h_exists_v
    have hc₀v₀_mem : (dotProduct u₀ (J.mulVec v₀)) • v₀ ∈ U_sub :=
      hU v₀ hv₀_Δ u₀ hu₀_mem
    have hv₀_mem : v₀ ∈ U_sub := by
      have h1 := U_sub.smul_mem (dotProduct u₀ (J.mulVec v₀))⁻¹ hc₀v₀_mem
      rwa [inv_smul_smul₀ hc₀_ne] at h1
    have hΔ_sub : Δ ⊆ (U_sub : Set (Fin M → K)) := by
      intro v hv
      obtain ⟨h, hh_G, hhv₀⟩ := hΔ_orb v₀ hv₀_Δ v hv
      rw [← hhv₀]
      exact hG_inv h hh_G v₀ hv₀_mem
    have h_top_le : (⊤ : Submodule K (Fin M → K)) ≤ U_sub := by
      rw [← hΔ_span]
      exact Submodule.span_le.mpr hΔ_sub
    exact top_le_iff.mp h_top_le

theorem weil_transv_powerSeries_rational_charpolyRev_descent (L : Type) [Field L] [CharZero L] [IsAlgClosed L] [Algebra ℚ L]
    (M : ℕ)
    (N : ℕ → ℕ)
    (Z : PowerSeries ℤ)
    (hZ0 : PowerSeries.constantCoeff Z = 1)
    (hZ_ode : PowerSeries.X * PowerSeries.derivative Z =
      Z * PowerSeries.mk (fun k => if k = 0 then 0 else (N k : ℤ)))
    (u_list v_list : List L)
    (C : Matrix (Fin M) (Fin M) L)
    (hN_tr : ∀ k : ℕ, 1 ≤ k →
      (N k : L) = (v_list.map (· ^ k)).sum - (u_list.map (· ^ k)).sum - Matrix.trace (C ^ k)) :
    ∃ A_Q B_Q : Polynomial ℚ,
      A_Q.coeff 0 = 1 ∧ B_Q.coeff 0 = 1 ∧
      (A_Q.map (algebraMap ℚ L)) *
        (v_list.map (fun v => 1 - Polynomial.C v * Polynomial.X)).prod =
      (B_Q.map (algebraMap ℚ L)) *
        (u_list.map (fun u => 1 - Polynomial.C u * Polynomial.X)).prod *
        C.charpolyRev :=
by
  classical
  
  let w_list : List L := (C.charpoly.roots).toList
  have hw_coe : (↑w_list : Multiset L) = C.charpoly.roots := Multiset.coe_toList _
  have h_lin_rev : ∀ w : L,
      (Polynomial.X - Polynomial.C w).reverse = 1 - Polynomial.C w * Polynomial.X := by
    intro w
    ext n
    rw [Polynomial.coeff_reverse, Polynomial.natDegree_X_sub_C]
    rcases n with _ | _ | m
    · rw [Polynomial.revAt_le (by omega)]
      simp [Polynomial.coeff_one, Polynomial.coeff_X]
    · rw [Polynomial.revAt_le (by omega)]
      simp [Polynomial.coeff_one, Polynomial.coeff_X]
    · rw [Polynomial.revAt_eq_self_of_lt (by omega)]
      simp [Polynomial.coeff_one, Polynomial.coeff_X]
  have h_prod_rev : ∀ ps : List (Polynomial L),
      ps.prod.reverse = (ps.map Polynomial.reverse).prod := by
    intro ps
    induction ps with
    | nil =>
      rw [List.prod_nil, List.map_nil, List.prod_nil, ← Polynomial.C_1, Polynomial.reverse_C]
    | cons p ps' ih =>
      rw [List.prod_cons, Polynomial.reverse_mul_of_domain, ih, List.map_cons, List.prod_cons]
  have h_char_split :
      C.charpoly = (w_list.map (fun w => Polynomial.X - Polynomial.C w)).prod := by
    have hsp := Polynomial.Splits.eq_prod_roots_of_monic
      (IsAlgClosed.splits C.charpoly) (Matrix.charpoly_monic C)
    rw [← hw_coe, Multiset.map_coe, Multiset.prod_coe] at hsp
    exact hsp
  have hRev : C.charpolyRev = (w_list.map (fun w => 1 - Polynomial.C w * Polynomial.X)).prod := by
    rw [← Matrix.reverse_charpoly, h_char_split, h_prod_rev, List.map_map]
    congr 1
    apply List.map_congr_left
    intro w _
    exact h_lin_rev w
  have hTr : ∀ s : ℕ, Matrix.trace (C ^ s) = (w_list.map (· ^ s)).sum := by
    intro s
    have h_mat_trace : Matrix.trace (C ^ s) = ((C.charpoly.roots).map (· ^ s)).sum := by
      let T : Module.End L (Fin M → L) := Matrix.toLin' C
      have htr_eq : Matrix.trace (C ^ s) = LinearMap.trace L (Fin M → L) (T ^ s) := by
        rw [LinearMap.trace_eq_matrix_trace L (Pi.basisFun L (Fin M)) (T ^ s)]
        have hmat : LinearMap.toMatrix (Pi.basisFun L (Fin M)) (Pi.basisFun L (Fin M)) (T ^ s) =
            C ^ s := by
          change Matrix.toLin'.symm (T ^ s) = C ^ s
          rw [← Matrix.toLin'_pow]
          exact Matrix.toLin'.symm_apply_apply (C ^ s)
        rw [hmat]
      have hchar_T : T.charpoly = C.charpoly := Matrix.charpoly_toLin' C
      rw [htr_eq, ← hchar_T]
      have hInt : DirectSum.IsInternal T.maxGenEigenspace :=
        DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
          (Module.End.independent_maxGenEigenspace T)
          (Module.End.iSup_maxGenEigenspace_eq_top T)
      have hrk : ∀ μ : L, Module.finrank L ↥(T.maxGenEigenspace μ) =
          Multiset.count μ (T.charpoly.roots) := by
        intro μ
        rw [LinearMap.finrank_maxGenEigenspace_eq T μ, Polynomial.count_roots]
      have hmem_supp : ∀ μ : L, T.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ (T.charpoly.roots).toFinset := by
        intro μ
        rw [ne_eq, ← Submodule.finrank_eq_zero, ← ne_eq, ← Nat.pos_iff_ne_zero, hrk μ,
          Multiset.count_pos, Multiset.mem_toFinset]
      have hSupp : {μ : L | T.maxGenEigenspace μ ≠ ⊥} = ↑((T.charpoly.roots).toFinset) := by
        ext μ
        exact (hmem_supp μ).trans Finset.mem_coe.symm
      have hFin_supp : {μ : L | T.maxGenEigenspace μ ≠ ⊥}.Finite := by
        rw [hSupp]
        exact Finset.finite_toSet _
      have hFin_eq : hFin_supp.toFinset = (T.charpoly.roots).toFinset := by
        ext μ
        exact hFin_supp.mem_toFinset.trans (hmem_supp μ)
      have hf1 : ∀ μ : L, Set.MapsTo T (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
        fun μ => Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl T) μ
      have hfs : ∀ μ : L, Set.MapsTo (T ^ s) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
        fun μ => Module.End.mapsTo_maxGenEigenspace_of_comm ((Commute.refl T).pow_right s) μ
      rw [LinearMap.trace_eq_sum_trace_restrict' hInt hFin_supp hfs, hFin_eq,
        Finset.sum_multiset_map_count (T.charpoly.roots) (· ^ s)]
      refine Finset.sum_congr rfl fun μ _ => ?_
      let T_μ : Module.End L ↥(T.maxGenEigenspace μ) := T.restrict (fun x hx => hf1 μ hx)
      have hrestrict_pow : (T ^ s).restrict (hfs μ) = T_μ ^ s := by
        have haux : ∀ (k : ℕ)
            (hk : Set.MapsTo (T ^ k) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ)),
            (T ^ k).restrict hk = T_μ ^ k := by
          intro k
          induction k with
          | zero =>
            intro hk
            apply LinearMap.ext; intro x; apply Subtype.ext; rfl
          | succ k ih =>
            intro hk
            have hk' : Set.MapsTo (T ^ k) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
              Module.End.mapsTo_maxGenEigenspace_of_comm ((Commute.refl T).pow_right k) μ
            apply LinearMap.ext; intro x; apply Subtype.ext
            have hx : (T ^ k) x.1 = ((T_μ ^ k) x).1 :=
              congrArg Subtype.val (LinearMap.congr_fun (ih hk') x)
            change (T ^ (k + 1)) x.1 = ((T_μ ^ (k + 1)) x).1
            rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
              LinearMap.comp_apply, LinearMap.comp_apply]
            change T ((T ^ k) x.1) = T ((T_μ ^ k) x).1
            rw [hx]
        exact haux s (hfs μ)
      rw [hrestrict_pow]
      let id_μ : Module.End L ↥(T.maxGenEigenspace μ) := 1
      let id_M : Module.End L (Fin M → L) := 1
      let ν : Module.End L ↥(T.maxGenEigenspace μ) := T_μ - μ • id_μ
      have hν_pow : ∀ (k : ℕ) (x : ↥(T.maxGenEigenspace μ)),
          ((ν ^ k) x).1 = (((T - μ • id_M) ^ k) x.1) := by
        intro k
        induction k with
        | zero => intro x; rfl
        | succ k ih =>
          intro x
          rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
            LinearMap.comp_apply, LinearMap.comp_apply]
          change T ((ν ^ k) x).1 - μ • ((ν ^ k) x).1 =
            T (((T - μ • id_M) ^ k) x.1) - μ • (((T - μ • id_M) ^ k) x.1)
          rw [ih x]
      have hNil : IsNilpotent ν := by
        refine ⟨Module.finrank L (Fin M → L), ?_⟩
        apply LinearMap.ext; intro x; apply Subtype.ext
        have hx_mem : x.1 ∈ (T.genEigenspace μ) ↑(Module.finrank L (Fin M → L)) := by
          rw [← Module.End.maxGenEigenspace_eq_genEigenspace_finrank T μ]
          exact x.2
        have hx_ker : ((T - μ • id_M) ^ Module.finrank L (Fin M → L)) x.1 = 0 :=
          LinearMap.mem_ker.mp (Module.End.mem_genEigenspace_nat.mp hx_mem)
        simp only [LinearMap.zero_apply, Submodule.coe_zero]
        exact (hν_pow (Module.finrank L (Fin M → L)) x).trans hx_ker
      have hT_eq : T_μ = ν + μ • id_μ := (sub_add_cancel T_μ (μ • id_μ)).symm
      have hComm : Commute ν (μ • id_μ) := (Commute.one_right ν).smul_right μ
      rw [hT_eq, hComm.add_pow s, Finset.sum_range_succ', map_add, map_sum]
      have hsum_zero : ∑ k ∈ Finset.range s,
          LinearMap.trace L ↥(T.maxGenEigenspace μ)
            (ν ^ (k + 1) * (μ • id_μ) ^ (s - (k + 1)) * ↑(s.choose (k + 1))) = 0 := by
        refine Finset.sum_eq_zero fun k _ => ?_
        set g_k : Module.End L ↥(T.maxGenEigenspace μ) :=
          (μ • id_μ) ^ (s - (k + 1)) * ↑(s.choose (k + 1))
        have hcomm_gk : Commute (ν ^ (k + 1)) g_k :=
          ((hComm.pow_left (k + 1)).pow_right (s - (k + 1))).mul_right
            (Nat.commute_cast (ν ^ (k + 1)) (s.choose (k + 1)))
        have hnil_prod : IsNilpotent (ν ^ (k + 1) * g_k) :=
          hcomm_gk.isNilpotent_mul_right (IsNilpotent.pow_succ k hNil)
        rw [mul_assoc]
        exact isNilpotent_iff_eq_zero.mp (LinearMap.isNilpotent_trace_of_isNilpotent hnil_prod)
      rw [hsum_zero, zero_add, pow_zero, one_mul, Nat.choose_zero_right, Nat.cast_one, mul_one]
      change LinearMap.trace L ↥(T.maxGenEigenspace μ)
        ((μ • (1 : Module.End L ↥(T.maxGenEigenspace μ))) ^ s) = _
      rw [smul_pow, one_pow, map_smul, LinearMap.trace_one, hrk μ, smul_eq_mul, nsmul_eq_mul,
        mul_comm]
    rw [h_mat_trace, ← hw_coe, Multiset.map_coe, Multiset.sum_coe]

  
  let Z_Q : PowerSeries ℚ := PowerSeries.map (Int.castRingHom ℚ) Z
  let Z_L : PowerSeries L := PowerSeries.map (algebraMap ℚ L) Z_Q
  let φ_ZL : ℤ →+* L := (algebraMap ℚ L).comp (Int.castRingHom ℚ)
  have hφ_ZL : ∀ z : ℤ, φ_ZL z = (z : L) := fun z => map_intCast (algebraMap ℚ L) z
  have hZL_map : Z_L = PowerSeries.map φ_ZL Z := by
    ext n
    simp [Z_L, Z_Q, φ_ZL]
  have hZL0 : (PowerSeries.coeff 0) Z_L = 1 := by
    rw [hZL_map, PowerSeries.coeff_map, PowerSeries.coeff_zero_eq_constantCoeff, hZ0, map_one]
  have hZL_deriv : PowerSeries.map φ_ZL (PowerSeries.derivative Z) = PowerSeries.derivative Z_L := by
    ext n
    rw [hZL_map, PowerSeries.coeff_map, PowerSeries.coeff_derivative, PowerSeries.coeff_derivative,
      map_mul, map_add, map_natCast, map_one, PowerSeries.coeff_map]
  let N_ser : PowerSeries L := PowerSeries.mk (fun k => if k = 0 then 0 else (N k : L))
  have hN_ser_map :
      PowerSeries.map φ_ZL (PowerSeries.mk (fun k => if k = 0 then 0 else (N k : ℤ))) = N_ser := by
    ext k
    rw [PowerSeries.coeff_map, PowerSeries.coeff_mk, PowerSeries.coeff_mk]
    split_ifs with hk
    · exact map_zero φ_ZL
    · rw [hφ_ZL, Int.cast_natCast]
  have hZL_ode : PowerSeries.X * PowerSeries.derivative Z_L = Z_L * N_ser := by
    have h1 := congrArg (PowerSeries.map φ_ZL) hZ_ode
    rwa [map_mul, PowerSeries.map_X, hZL_deriv, map_mul, ← hZL_map, hN_ser_map] at h1

  let D : PowerSeries L → PowerSeries L := fun f => PowerSeries.X * PowerSeries.derivative f
  have hD_mul : ∀ f g : PowerSeries L, D (f * g) = D f * g + f * D g := by
    intro f g
    dsimp [D]
    have hleib := Derivation.leibniz (PowerSeries.derivative (R := L)) f g
    simp only [smul_eq_mul] at hleib
    rw [hleib]
    ring
  have hD_lin : ∀ α : L,
      D (↑(1 - Polynomial.C α * Polynomial.X : Polynomial L) : PowerSeries L) =
        (↑(1 - Polynomial.C α * Polynomial.X : Polynomial L) : PowerSeries L) *
          PowerSeries.mk (fun k => if k = 0 then 0 else -α ^ k) := by
    intro α
    let s_α : PowerSeries L := PowerSeries.mk (fun k => if k = 0 then 0 else -α ^ k)
    have hcoe : (↑(1 - Polynomial.C α * Polynomial.X : Polynomial L) : PowerSeries L) =
        1 - PowerSeries.C α * PowerSeries.X := by
      rw [Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_mul, Polynomial.coe_C,
        Polynomial.coe_X]
    have hrhs_expand :
        (↑(1 - Polynomial.C α * Polynomial.X : Polynomial L) : PowerSeries L) * s_α =
          s_α - PowerSeries.C α * (PowerSeries.X * s_α) := by
      rw [hcoe]
      ring
    rw [hrhs_expand]
    ext n
    rcases n with _ | _ | m
    · dsimp [D, s_α]
      rw [PowerSeries.coeff_zero_X_mul, map_sub, PowerSeries.coeff_mk,
        PowerSeries.coeff_C_mul, PowerSeries.coeff_zero_X_mul]
      simp
    · dsimp [D, s_α]
      rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative, map_sub,
        PowerSeries.coeff_mk, PowerSeries.coeff_C_mul,
        PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_mk]
      simp
    · dsimp [D, s_α]
      rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative, map_sub,
        PowerSeries.coeff_mk, PowerSeries.coeff_C_mul,
        PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_mk]
      have h1 : m + 2 ≠ 0 := by omega
      have h2 : m + 1 ≠ 0 := by omega
      have h3 : (1 : ℕ) ≠ m + 2 := by omega
      simp only [Polynomial.coeff_coe, Polynomial.coeff_sub, Polynomial.coeff_one,
        Polynomial.coeff_C_mul, Polynomial.coeff_X, h1, h2, h3, ↓reduceIte,
        mul_zero, sub_zero, zero_mul]
      ring

  let F_poly : List L → Polynomial L :=
    fun l => (l.map (fun α => 1 - Polynomial.C α * Polynomial.X)).prod
  let S_ser : List L → PowerSeries L :=
    fun l => PowerSeries.mk (fun k => if k = 0 then 0 else -(l.map (· ^ k)).sum)
  have hF_coeff0 : ∀ l : List L, (F_poly l).coeff 0 = 1 := by
    intro l
    induction l with
    | nil => simp [F_poly]
    | cons α l' ih => simp [F_poly, Polynomial.mul_coeff_zero, ih]
  have hF_ode : ∀ l : List L,
      D (↑(F_poly l) : PowerSeries L) = (↑(F_poly l) : PowerSeries L) * S_ser l := by
    intro l
    induction l with
    | nil =>
      have hS0 : S_ser [] = 0 := by
        ext k
        simp [S_ser]
      simp [F_poly, D, hS0]
    | cons α l' ih =>
      have hmul : (↑(F_poly (α :: l')) : PowerSeries L) =
          (↑(1 - Polynomial.C α * Polynomial.X : Polynomial L) : PowerSeries L) *
            (↑(F_poly l') : PowerSeries L) := by
        simp [F_poly, Polynomial.coe_mul]
      have hS_cons :
          PowerSeries.mk (fun k => if k = 0 then 0 else -α ^ k) + S_ser l' = S_ser (α :: l') := by
        ext k
        simp only [S_ser, map_add, PowerSeries.coeff_mk, List.map_cons, List.sum_cons]
        split_ifs <;> ring
      rw [hmul, hD_mul, hD_lin α, ih, ← hS_cons]
      ring

  let U_all : List L := u_list ++ w_list
  let Q_L : Polynomial L := F_poly v_list
  let P_L : Polynomial L := F_poly U_all
  have hN_ser_add : N_ser + S_ser v_list = S_ser U_all := by
    ext k
    simp only [N_ser, S_ser, map_add, PowerSeries.coeff_mk]
    split_ifs with hk
    · ring
    · have hk1 : 1 ≤ k := Nat.pos_of_ne_zero hk
      rw [hN_tr k hk1, hTr k]
      simp only [U_all, List.map_append, List.sum_append]
      ring

  let W₁ : PowerSeries L := Z_L * (↑Q_L : PowerSeries L)
  let W₂ : PowerSeries L := (↑P_L : PowerSeries L)
  have hW₁_ode : D W₁ = W₁ * S_ser U_all := by
    dsimp [W₁]
    rw [hD_mul, (show D Z_L = Z_L * N_ser from hZL_ode), hF_ode v_list, ← hN_ser_add]
    ring
  have hW₂_ode : D W₂ = W₂ * S_ser U_all := hF_ode U_all
  let Δ_W : PowerSeries L := W₁ - W₂
  have hΔ_ode : D Δ_W = Δ_W * S_ser U_all := by
    dsimp [Δ_W, D] at *
    rw [map_sub, mul_sub, hW₁_ode, hW₂_ode, sub_mul]
  have hΔ0 : (PowerSeries.coeff 0) Δ_W = 0 := by
    dsimp [Δ_W, W₁, W₂]
    rw [map_sub, PowerSeries.coeff_zero_eq_constantCoeff, map_mul,
      ← PowerSeries.coeff_zero_eq_constantCoeff, hZL0,
      Polynomial.coeff_coe, hF_coeff0 v_list,
      Polynomial.coeff_coe, hF_coeff0 U_all, mul_one, sub_self]
  have hΔ_coeff : ∀ m : ℕ, (PowerSeries.coeff m) Δ_W = 0 := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      rcases m with _ | n
      · exact hΔ0
      · have h_eq := congrArg (PowerSeries.coeff (n + 1)) hΔ_ode
        dsimp [D] at h_eq
        rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative,
          PowerSeries.coeff_mul] at h_eq
        have hrhs : ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (n + 1),
            (PowerSeries.coeff p.1) Δ_W * (PowerSeries.coeff p.2) (S_ser U_all) = 0 := by
          refine Finset.sum_eq_zero fun p hp => ?_
          have hp_sum : p.1 + p.2 = n + 1 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          by_cases hlt : p.1 < n + 1
          · rw [ih p.1 hlt, zero_mul]
          · have hp2 : p.2 = 0 := by omega
            rw [hp2, PowerSeries.coeff_mk]
            simp
        rw [hrhs] at h_eq
        have hnz : ((n : L) + 1) ≠ 0 := by
          exact_mod_cast Nat.succ_ne_zero n
        exact (mul_eq_zero.mp h_eq).resolve_right hnz
  have hEq_PS : Z_L * (↑Q_L : PowerSeries L) = (↑P_L : PowerSeries L) :=
    sub_eq_zero.mp (PowerSeries.ext hΔ_coeff)

  
  let ι : ℚ →ₗ[ℚ] L := Algebra.linearMap ℚ L
  have hι_ker : LinearMap.ker ι = ⊥ := LinearMap.ker_eq_bot.mpr (algebraMap ℚ L).injective
  obtain ⟨π, hπ⟩ := LinearMap.exists_leftInverse_of_injective ι hι_ker
  have hπ1 : π 1 = 1 := by
    have h1 : (π.comp ι) 1 = LinearMap.id 1 := LinearMap.congr_fun hπ 1
    simpa [ι] using h1
  let retractPoly : Polynomial L → Polynomial ℚ :=
    fun R => ∑ i ∈ Finset.range (R.natDegree + 1), Polynomial.monomial i (π (R.coeff i))
  have h_retract_coeff : ∀ (R : Polynomial L) (n : ℕ),
      (retractPoly R).coeff n = π (R.coeff n) := by
    intro R n
    dsimp [retractPoly]
    rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq', Finset.mem_range]
    split_ifs with hn
    · rfl
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), map_zero]
  let A_Q : Polynomial ℚ := retractPoly P_L
  let B_Q : Polynomial ℚ := retractPoly Q_L
  have hAQ0 : A_Q.coeff 0 = 1 := by
    rw [h_retract_coeff, hF_coeff0 U_all, hπ1]
  have hBQ0 : B_Q.coeff 0 = 1 := by
    rw [h_retract_coeff, hF_coeff0 v_list, hπ1]
  have hZQ_eq : Z_Q * (↑B_Q : PowerSeries ℚ) = (↑A_Q : PowerSeries ℚ) := by
    ext n
    have hn := congrArg (PowerSeries.coeff n) hEq_PS
    rw [PowerSeries.coeff_mul, Polynomial.coeff_coe] at hn
    have hn' : ∑ p ∈ Finset.HasAntidiagonal.antidiagonal n,
        ((PowerSeries.coeff p.1) Z_Q) • (Q_L.coeff p.2) = P_L.coeff n := by
      rw [← hn]
      refine Finset.sum_congr rfl fun p _ => ?_
      dsimp [Z_L]
      rw [PowerSeries.coeff_map, Algebra.smul_def, Polynomial.coeff_coe]
    have hπn := congrArg π hn'
    rw [map_sum] at hπn
    rw [PowerSeries.coeff_mul, Polynomial.coeff_coe, h_retract_coeff, ← hπn]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [Polynomial.coeff_coe, h_retract_coeff, LinearMap.map_smul, smul_eq_mul]
  have h_coe_map : ∀ R_Q : Polynomial ℚ,
      PowerSeries.map (algebraMap ℚ L) (↑R_Q : PowerSeries ℚ) =
        (↑(R_Q.map (algebraMap ℚ L)) : PowerSeries L) := by
    intro R_Q
    ext n
    simp [PowerSeries.coeff_map, Polynomial.coeff_coe]
  have hZL_AQ :
      Z_L * (↑(B_Q.map (algebraMap ℚ L)) : PowerSeries L) =
        (↑(A_Q.map (algebraMap ℚ L)) : PowerSeries L) := by
    have hm := congrArg (PowerSeries.map (algebraMap ℚ L)) hZQ_eq
    rwa [map_mul, h_coe_map, h_coe_map] at hm
  have hPoly_eq :
      (A_Q.map (algebraMap ℚ L)) * Q_L = (B_Q.map (algebraMap ℚ L)) * P_L := by
    apply Polynomial.coe_inj.mp
    rw [Polynomial.coe_mul, Polynomial.coe_mul, ← hZL_AQ]
    calc
      (Z_L * (↑(B_Q.map (algebraMap ℚ L)) : PowerSeries L)) * (↑Q_L : PowerSeries L)
          = (↑(B_Q.map (algebraMap ℚ L)) : PowerSeries L) * (Z_L * (↑Q_L : PowerSeries L)) := by
              ring
      _ = (↑(B_Q.map (algebraMap ℚ L)) : PowerSeries L) * (↑P_L : PowerSeries L) := by
            rw [hEq_PS]
  have hPL_fac :
      P_L = (u_list.map (fun u => 1 - Polynomial.C u * Polynomial.X)).prod * C.charpolyRev := by
    dsimp [P_L, U_all, F_poly]
    rw [List.map_append, List.prod_append, ← hRev]
  refine ⟨A_Q, B_Q, hAQ0, hBQ0, ?_⟩
  rw [hPoly_eq, hPL_fac, ← mul_assoc]

theorem weil_sing_dev_leray_p1_geom_cd_le_two (F : Type u) [Field F]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) :
    AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom ∧
    ∀ (r p : ℕ), 3 ≤ p →
      ∀ (𝒜 : CategoryTheory.Sheaf
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          AddCommGrpCat.{u}),
        (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id 𝒜 = 0 →
        Subsingleton (𝒜.H p) :=
by
  classical
  
  have hAddEquivOfSurjKer : ∀ {A₁ B₁ A₂ B₂ : Type u}
      [AddCommGroup A₁] [AddCommGroup B₁] [AddCommGroup A₂] [AddCommGroup B₂]
      (δ₁ : A₁ →+ B₁) (δ₂ : A₂ →+ B₂)
      (_ : Function.Surjective δ₁) (_ : Function.Surjective δ₂)
      (e : A₁ ≃+ A₂),
      (∀ a : A₁, δ₁ a = 0 ↔ δ₂ (e a) = 0) →
      Nonempty (B₁ ≃+ B₂) := by
    intro A₁ B₁ A₂ B₂ _ _ _ _ δ₁ δ₂ hδ₁ hδ₂ e hker
    let liftFn : B₁ → B₂ := fun b => δ₂ (e (Function.surjInv hδ₁ b))
    have hlift : ∀ a : A₁, liftFn (δ₁ a) = δ₂ (e a) := by
      intro a
      dsimp [liftFn]
      set a' := Function.surjInv hδ₁ (δ₁ a)
      have hsub0 : δ₁ (a - a') = 0 := by
        rw [map_sub, Function.surjInv_eq hδ₁ (δ₁ a), sub_self]
      have hsub2 : δ₂ (e (a - a')) = 0 := (hker (a - a')).mp hsub0
      rw [map_sub, map_sub, sub_eq_zero] at hsub2
      exact hsub2.symm
    have h_add : ∀ x y : B₁, liftFn (x + y) = liftFn x + liftFn y := by
      intro x y
      rcases hδ₁ x with ⟨ax, rfl⟩
      rcases hδ₁ y with ⟨ay, rfl⟩
      rw [← map_add, hlift, hlift, hlift, map_add, map_add]
    have h_inj : Function.Injective liftFn := by
      intro x y hxy
      rcases hδ₁ x with ⟨ax, rfl⟩
      rcases hδ₁ y with ⟨ay, rfl⟩
      rw [hlift, hlift] at hxy
      have h0 : δ₂ (e (ax - ay)) = 0 := by
        rw [map_sub, map_sub, sub_eq_zero]
        exact hxy
      have h1 : δ₁ (ax - ay) = 0 := (hker (ax - ay)).mpr h0
      rw [map_sub, sub_eq_zero] at h1
      rw [h1]
    have h_surj : Function.Surjective liftFn := by
      intro c
      rcases hδ₂ c with ⟨a₂, rfl⟩
      refine ⟨δ₁ (e.symm a₂), ?_⟩
      rw [hlift, e.apply_symm_apply]
    let homFn : B₁ →+ B₂ := AddMonoidHom.mk' liftFn h_add
    exact ⟨AddEquiv.ofBijective homFn ⟨h_inj, h_surj⟩⟩

  
  have hAbEquivExtIso : ∀ {𝒞₁ 𝒞₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞₁]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞₂]
      [CategoryTheory.Abelian 𝒞₁]
      [CategoryTheory.Abelian 𝒞₂]
      [CategoryTheory.EnoughInjectives 𝒞₁]
      [CategoryTheory.HasExt.{u} 𝒞₁]
      [CategoryTheory.HasExt.{u} 𝒞₂]
      (F : 𝒞₁ ⥤ 𝒞₂)
      [F.Additive]
      [CategoryTheory.Functor.Full F]
      [CategoryTheory.Functor.Faithful F]
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [F.PreservesInjectiveObjects]
      (X₁ : 𝒞₁) (X₂ : 𝒞₂) (_ : F.obj X₁ ≅ X₂)
      (p : ℕ) (Y₁ : 𝒞₁),
      Nonempty (CategoryTheory.Abelian.Ext.{u} X₁ Y₁ p ≃+
        CategoryTheory.Abelian.Ext.{u} X₂ (F.obj Y₁) p) := by
    intro 𝒞₁ 𝒞₂ _ _ _ _ _ _ _ F _ _ _ _ _ _ X₁ X₂ φ_X p Y₁
    have hθ₀_pkg : ∃ θ₀ : ∀ W : 𝒞₁,
          CategoryTheory.Abelian.Ext.{u} X₁ W 0 ≃+ CategoryTheory.Abelian.Ext.{u} X₂ (F.obj W) 0,
        ∀ {W Z : 𝒞₁} (π : W ⟶ Z) (x : CategoryTheory.Abelian.Ext.{u} X₁ W 0),
          θ₀ Z (x.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero 0)) =
            (θ₀ W x).comp (CategoryTheory.Abelian.Ext.mk₀ (F.map π)) (Nat.add_zero 0) := by
      let θ₀ : ∀ W : 𝒞₁,
          CategoryTheory.Abelian.Ext.{u} X₁ W 0 ≃+ CategoryTheory.Abelian.Ext.{u} X₂ (F.obj W) 0 :=
        fun W =>
          let e_hom : (X₁ ⟶ W) ≃+ (X₂ ⟶ F.obj W) :=
            { toFun := fun g => φ_X.inv ≫ F.map g
              invFun := fun h => F.preimage (φ_X.hom ≫ h)
              left_inv := fun g => by
                dsimp only
                rw [← CategoryTheory.Category.assoc, φ_X.hom_inv_id,
                  CategoryTheory.Category.id_comp, F.preimage_map]
              right_inv := fun h => by
                dsimp only
                rw [F.map_preimage, ← CategoryTheory.Category.assoc, φ_X.inv_hom_id,
                  CategoryTheory.Category.id_comp]
              map_add' := fun g₁ g₂ => by
                rw [F.map_add, CategoryTheory.Preadditive.comp_add] }
          CategoryTheory.Abelian.Ext.addEquiv₀.trans
            (e_hom.trans CategoryTheory.Abelian.Ext.addEquiv₀.symm)
      refine ⟨θ₀, ?_⟩
      intro W Z π x
      set g : X₁ ⟶ W := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : x = CategoryTheory.Abelian.Ext.mk₀ g := by
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact (CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x).symm
      have hθ_mk : ∀ {U : 𝒞₁} (u : X₁ ⟶ U),
          θ₀ U (CategoryTheory.Abelian.Ext.mk₀ u) =
            CategoryTheory.Abelian.Ext.mk₀ (φ_X.inv ≫ F.map u) := by
        intro U u
        dsimp [θ₀]
        have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ u) = u := by
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
          exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply u
        rw [hu, CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
      rw [hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hθ_mk, hθ_mk,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, F.map_comp, CategoryTheory.Category.assoc]
    obtain ⟨θ₀, hθ₀_nat⟩ := hθ₀_pkg
    have hθ₁ : ∀ W : 𝒞₁,
        Nonempty (CategoryTheory.Abelian.Ext.{u} X₁ W 1 ≃+
          CategoryTheory.Abelian.Ext.{u} X₂ (F.obj W) 1) := by
      intro W
      let I₁ := CategoryTheory.Injective.under W
      let ι : W ⟶ I₁ := CategoryTheory.Injective.ι W
      let Q₁ := CategoryTheory.Limits.cokernel ι
      let π : I₁ ⟶ Q₁ := CategoryTheory.Limits.cokernel.π ι
      let S₁ := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS₁ : S₁.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      let S₂ := S₁.map F
      have hS₂ : S₂.ShortExact := hS₁.map_of_exact F
      have : CategoryTheory.Injective S₂.X₂ := F.injective_obj I₁
      let δ₁ := hS₁.extClass.postcomp X₁ (Nat.zero_add 1)
      let δ₂ := hS₂.extClass.postcomp X₂ (Nat.zero_add 1)
      have hδ₁_surj : Function.Surjective δ₁ := by
        intro y
        have hy₀ : y.comp (CategoryTheory.Abelian.Ext.mk₀ S₁.f) (Nat.add_zero 1) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₁ hS₁ y hy₀ (Nat.zero_add 1)
