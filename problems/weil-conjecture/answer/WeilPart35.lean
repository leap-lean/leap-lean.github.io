            (z : K) • equiv_U1 (TensorProduct.tmul ℤ (1 : ℚ) w₁) := by
      intro z w₁ w₂ hw
      apply Subtype.ext
      change (equiv_U1 (TensorProduct.tmul ℤ (1 : ℚ) w₂)).1 =
        (z : K) • (equiv_U1 (TensorProduct.tmul ℤ (1 : ℚ) w₁)).1
      rw [hequiv_U1_val, hequiv_U1_val, hα_Q_tmul, hα_Q_tmul]
      refine hsmul_M z (α_sys w₁) (α_sys w₂) (fun s => ?_)
      cases s with
      | zero =>
        change (0 : H_M 0) = (PadicInt.toZModPow 0 z).val • (0 : H_M 0)
        rw [smul_zero]
      | succ r =>
        change α r (w₂.1 r) = (PadicInt.toZModPow (r + 1) z).val • α r (w₁.1 r)
        rw [hw r, map_nsmul]
    have hfrob_U1 : ∀ (w₁ w₂ : ↥L_F1),
        (∀ r : ℕ, w₂.1 r = frob_F1 r (w₁.1 r)) →
          frob_U1 (equiv_U1 (TensorProduct.tmul ℤ (1 : ℚ) w₁)) =
            equiv_U1 (TensorProduct.tmul ℤ (1 : ℚ) w₂) := by
      intro w₁ w₂ hw
      apply Subtype.ext
      change frob_M (equiv_U1 (TensorProduct.tmul ℤ (1 : ℚ) w₁)).1 =
        (equiv_U1 (TensorProduct.tmul ℤ (1 : ℚ) w₂)).1
      rw [hequiv_U1_val, hequiv_U1_val, hα_Q_tmul, hα_Q_tmul]
      refine hfrob_M (α_sys w₁) (α_sys w₂) (fun s => ?_)
      cases s with
      | zero =>
        change (0 : H_M 0) = frobTors_M 0 0
        exact (map_zero (frobTors_M 0)).symm
      | succ r =>
        change α r (w₂.1 r) = frobTors_M (r + 1) (α r (w₁.1 r))
        rw [hw r, hα_frob r (w₁.1 r)]
    have hγ_mem : ∀ x : ↥L_2, (fun r : ℕ => γ_map r (x.1 r)) ∈ L_F1 := by
      intro x
      rw [hL_F1]
      intro r
      have htr := DFunLike.congr_fun (hγ_trans r) (x.1 (r + 1))
      change t_F1 r (γ_map (r + 1) (x.1 (r + 1))) = γ_map r (tr_2 r (x.1 (r + 1))) at htr
      rw [htr, (hL_2 x.1).mp x.2 r]
    have hε_mem : ∀ w : ↥L_F1, (fun r : ℕ => ε_map r (w.1 r)) ∈ L_1 := by
      intro w
      rw [hL_1]
      intro r
      have htr := DFunLike.congr_fun (hε_trans r) (w.1 (r + 1))
      change tr_1 r (ε_map (r + 1) (w.1 (r + 1))) = ε_map r (t_F1 r (w.1 (r + 1))) at htr
      rw [htr, (hL_F1 w.1).mp w.2 r]
    let γ_sys : ↥L_2 →+ ↥L_F1 :=
      { toFun := fun x => ⟨fun r => γ_map r (x.1 r), hγ_mem x⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (γ_map r))
        map_add' := fun x₁ x₂ =>
          Subtype.ext (funext fun r => map_add (γ_map r) (x₁.1 r) (x₂.1 r)) }
    let ε_sys : ↥L_F1 →+ ↥L_1 :=
      { toFun := fun w => ⟨fun r => ε_map r (w.1 r), hε_mem w⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (ε_map r))
        map_add' := fun w₁ w₂ =>
          Subtype.ext (funext fun r => map_add (ε_map r) (w₁.1 r) (w₂.1 r)) }
    have hExact_sys_II : ∀ w : ↥L_F1, ε_sys w = 0 → ∃ x : ↥L_2, γ_sys x = w := by
      intro w hw0
      let _ : ∀ r : ℕ, TopologicalSpace (H_2 r) := fun _ => ⊥
      have _ : ∀ r : ℕ, DiscreteTopology (H_2 r) := fun _ => ⟨rfl⟩
      have _ : ∀ r : ℕ, Finite (H_2 r) := hFin_2
      have _ : ∀ r : ℕ, CompactSpace (H_2 r) := fun _ => Finite.compactSpace
      have _ : ∀ r : ℕ, T2Space (H_2 r) := fun _ => DiscreteTopology.toT2Space
      have _ : CompactSpace (∀ r : ℕ, H_2 r) := Pi.compactSpace
      let T_cyl : ℕ → Set (∀ r : ℕ, H_2 r) := fun N =>
        (⋂ r : ℕ, ⋂ (_ : r ≤ N), {x | γ_map r (x r) = w.1 r}) ∩
        (⋂ r : ℕ, ⋂ (_ : r < N), {x | tr_2 r (x (r + 1)) = x r})
      have hClosed : ∀ N : ℕ, IsClosed (T_cyl N) := by
        intro N
        refine IsClosed.inter ?_ ?_
        · refine isClosed_iInter fun r => isClosed_iInter fun _ => ?_
          exact (isClosed_discrete {u : H_2 r | γ_map r u = w.1 r}).preimage (continuous_apply r)
        · refine isClosed_iInter fun r => isClosed_iInter fun _ => ?_
          exact isClosed_eq (continuous_of_discreteTopology.comp (continuous_apply (r + 1)))
            (continuous_apply r)
      have hAnti : ∀ N : ℕ, T_cyl (N + 1) ⊆ T_cyl N := by
        intro N x hx
        rcases hx with ⟨hx₁, hx₂⟩
        refine ⟨Set.mem_iInter.mpr fun r => Set.mem_iInter.mpr fun hr => ?_,
          Set.mem_iInter.mpr fun r => Set.mem_iInter.mpr fun hr => ?_⟩
        · exact Set.mem_iInter.mp (Set.mem_iInter.mp hx₁ r) (Nat.le_succ_of_le hr)
        · exact Set.mem_iInter.mp (Set.mem_iInter.mp hx₂ r) (Nat.lt_succ_of_lt hr)
      have hBuild : ∀ (k : ℕ) (xk : H_2 k), γ_map k xk = w.1 k →
          ∃ x : (∀ r : ℕ, H_2 r),
            x k = xk ∧
            (∀ r ≤ k, γ_map r (x r) = w.1 r) ∧
            (∀ r < k, tr_2 r (x (r + 1)) = x r) := by
        intro k
        induction k with
        | zero =>
          intro xk hxk
          refine ⟨Function.update (fun _ => 0) 0 xk, Function.update_self 0 xk _, ?_, ?_⟩
          · intro r hr
            have hr0 : r = 0 := Nat.eq_zero_of_le_zero hr
            subst hr0
            rw [Function.update_self]
            exact hxk
          · intro r hr
            exact absurd hr (Nat.not_lt_zero r)
        | succ k ih =>
          intro xk hxk
          let xk' : H_2 k := tr_2 k xk
          have hxk' : γ_map k xk' = w.1 k := by
            have htr := DFunLike.congr_fun (hγ_trans k) xk
            change t_F1 k (γ_map (k + 1) xk) = γ_map k (tr_2 k xk) at htr
            rw [← htr, hxk, (hL_F1 w.1).mp w.2 k]
          obtain ⟨x₀, hx₀_k, hx₀_g, hx₀_tr⟩ := ih xk' hxk'
          refine ⟨Function.update x₀ (k + 1) xk, Function.update_self (k + 1) xk x₀, ?_, ?_⟩
          · intro r hr
            rcases Nat.of_le_succ hr with hle | rfl
            · rw [Function.update_of_ne (by omega : r ≠ k + 1)]
              exact hx₀_g r hle
            · rw [Function.update_self]
              exact hxk
          · intro r hr
            rcases Nat.lt_succ_iff_lt_or_eq.mp hr with hlt | hr_eq
            · rw [Function.update_of_ne (by omega : r + 1 ≠ k + 1),
                Function.update_of_ne (by omega : r ≠ k + 1)]
              exact hx₀_tr r hlt
            · subst hr_eq
              rw [Function.update_self, Function.update_of_ne (by omega : r ≠ r + 1), hx₀_k]
      have hNonempty : ∀ N : ℕ, (T_cyl N).Nonempty := by
        intro N
        have hwN : ε_map N (w.1 N) = 0 := congrFun (congrArg Subtype.val hw0) N
        obtain ⟨xN, hxN⟩ := (hEx_II N (w.1 N)).mp hwN
        obtain ⟨x, _, hxg, hxtr⟩ := hBuild N xN hxN
        refine ⟨x, Set.mem_iInter.mpr fun r => Set.mem_iInter.mpr fun hr => hxg r hr,
          Set.mem_iInter.mpr fun r => Set.mem_iInter.mpr fun hr => hxtr r hr⟩
      have hComp0 : IsCompact (T_cyl 0) :=
        IsCompact.of_isClosed_subset isCompact_univ (hClosed 0) (Set.subset_univ _)
      obtain ⟨x_lim, hx_lim⟩ :=
        IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
          T_cyl hAnti hNonempty hComp0 hClosed
      have hx_mem : x_lim ∈ L_2 := by
        rw [hL_2]
        intro r
        have hmem := Set.mem_iInter.mp hx_lim (r + 1)
        exact Set.mem_iInter.mp (Set.mem_iInter.mp hmem.2 r) (Nat.lt_succ_self r)
      refine ⟨⟨x_lim, hx_mem⟩, Subtype.ext (funext fun r => ?_)⟩
      have hmem := Set.mem_iInter.mp hx_lim r
      exact Set.mem_iInter.mp (Set.mem_iInter.mp hmem.1 r) (le_refl r)
    obtain ⟨γ_Q, G_lin, hγ_Q_tmul, hG_equiv⟩ :=
      hLiftLinShift (fun r => r + 1) (fun r => r + 1) (fun r => Nat.le_succ (r + 1))
        hL_2 hTor_2 equiv_2 equiv_U1 hsmul_2 hsmul_U1 γ_sys
        (fun z x y hxy r => by
          change γ_map r (y.1 r) = (PadicInt.toZModPow (r + 1) z).val • γ_map r (x.1 r)
          rw [hxy r, map_nsmul])
    obtain ⟨ε_Q, E_lin, hε_Q_tmul, hE_equiv⟩ :=
      hLiftLinShift (fun r => r + 1) (fun r => r + 1) (fun r => Nat.le_succ (r + 1))
        hL_F1 hF1_tor equiv_U1 equiv_1 hsmul_U1 hsmul_1 ε_sys
        (fun z x y hxy r => by
          change ε_map r (y.1 r) = (PadicInt.toZModPow (r + 1) z).val • ε_map r (x.1 r)
          rw [hxy r, map_nsmul])
    have hF_2_mem : ∀ x : ↥L_2, (fun r => frobTors_2 r (x.1 r)) ∈ L_2 := by
      intro x; rw [hL_2]; intro r
      rw [hfrob_tr_2 r (x.1 (r + 1)), (hL_2 x.1).mp x.2 r]
    have hF_F1_mem : ∀ w : ↥L_F1, (fun r => frob_F1 r (w.1 r)) ∈ L_F1 := by
      intro w; rw [hL_F1]; intro r
      rw [hF1_frob_trans r (w.1 (r + 1)), (hL_F1 w.1).mp w.2 r]
    have hF_1_mem : ∀ z : ↥L_1, (fun r => frobTors_1 r (z.1 r)) ∈ L_1 := by
      intro z; rw [hL_1]; intro r
      rw [hfrob_tr_1 r (z.1 (r + 1)), (hL_1 z.1).mp z.2 r]
    have hG_frob : frob_U1.comp G_lin = G_lin.comp frob_2 := by
      apply hLin_ext equiv_2
      intro x
      let fx : ↥L_2 := ⟨fun r => frobTors_2 r (x.1 r), hF_2_mem x⟩
      let fgx : ↥L_F1 := ⟨fun r => frob_F1 r ((γ_sys x).1 r), hF_F1_mem (γ_sys x)⟩
      have hfgx_eq : fgx = γ_sys fx :=
        Subtype.ext (funext fun r => hγ_frob r (x.1 r))
      simp only [LinearMap.comp_apply]
      rw [hG_equiv, hγ_Q_tmul, hfrob_U1 (γ_sys x) fgx (fun _ => rfl), hfgx_eq,
        hfrob_2 x fx (fun _ => rfl), hG_equiv, hγ_Q_tmul]
    have hE_frob : E_lin.comp frob_U1 = frob_1.comp E_lin := by
      apply hLin_ext equiv_U1
      intro w
      let fw : ↥L_F1 := ⟨fun r => frob_F1 r (w.1 r), hF_F1_mem w⟩
      let few : ↥L_1 := ⟨fun r => frobTors_1 r ((ε_sys w).1 r), hF_1_mem (ε_sys w)⟩
      have hfew_eq : ε_sys fw = few :=
        Subtype.ext (funext fun r => (hε_frob r (w.1 r)).symm)
      simp only [LinearMap.comp_apply]
      rw [hfrob_U1 w fw (fun _ => rfl), hE_equiv, hε_Q_tmul, hE_equiv, hε_Q_tmul,
        hfrob_1 (ε_sys w) few (fun _ => rfl), hfew_eq]
    have hKer_E_le_Range_G : ∀ u : ↥U₁, E_lin u = 0 → u ∈ LinearMap.range G_lin := by
      intro u hu0
      let t := equiv_U1.symm u
      have hεQt : ε_Q t = 0 := by
        apply equiv_1.injective
        rw [map_zero, ← hE_equiv t, equiv_U1.apply_symm_apply]
        exact hu0
      obtain ⟨⟨w, s⟩, hst⟩ := IsLocalizedModule.surj S₀ f_F1 t
      have hst_z : (s : ℤ) • t = TensorProduct.tmul ℤ (1 : ℚ) w := hst
      have hs_ne : (s : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hf_1_zero : f_1 (ε_sys w) = 0 := by
        change TensorProduct.tmul ℤ (1 : ℚ) (ε_sys w) = 0
        rw [← hε_Q_tmul (1 : ℚ) w, ← hst_z, map_zsmul, hεQt, smul_zero]
      have hmk_zero : IsLocalizedModule.mk' f_1 (ε_sys w) (1 : S₀) = 0 :=
        (IsLocalizedModule.mk'_eq_zero (1 : S₀)).mpr hf_1_zero
      obtain ⟨s', hs'⟩ := (IsLocalizedModule.mk'_eq_zero' f_1 (1 : S₀)).mp hmk_zero
      have hs'_z : (s' : ℤ) • ε_sys w = 0 := hs'
      have hs'_ne : (s' : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      have hε_s'w : ε_sys ((s' : ℤ) • w) = 0 := by rw [map_zsmul, hs'_z]
      obtain ⟨x, hx⟩ := hExact_sys_II ((s' : ℤ) • w) hε_s'w
      let d_int : ℤ := (s : ℤ) * (s' : ℤ)
      have hd_ne : (d_int : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (mul_ne_zero hs_ne hs'_ne)
      let q₀ : ℚ := (d_int : ℚ)⁻¹
      have hγQ_eq : γ_Q (TensorProduct.tmul ℤ q₀ x) = t := by
        have h1 : (d_int : ℚ) • γ_Q (TensorProduct.tmul ℤ q₀ x) =
            TensorProduct.tmul ℤ (1 : ℚ) ((s' : ℤ) • w) := by
          rw [hγ_Q_tmul, hx, TensorProduct.smul_tmul', smul_eq_mul, mul_inv_cancel₀ hd_ne]
        have h2 : (d_int : ℚ) • t = TensorProduct.tmul ℤ (1 : ℚ) ((s' : ℤ) • w) := by
          rw [Int.cast_smul_eq_zsmul]
          dsimp [d_int]
          rw [mul_comm, mul_smul, hst_z, TensorProduct.tmul_smul]
        calc
          γ_Q (TensorProduct.tmul ℤ q₀ x) =
              (q₀ * (d_int : ℚ)) • γ_Q (TensorProduct.tmul ℤ q₀ x) := by
            rw [inv_mul_cancel₀ hd_ne, one_smul]
          _ = q₀ • ((d_int : ℚ) • γ_Q (TensorProduct.tmul ℤ q₀ x)) := mul_smul _ _ _
          _ = q₀ • ((d_int : ℚ) • t) := by rw [h1, h2]
          _ = (q₀ * (d_int : ℚ)) • t := (mul_smul _ _ _).symm
          _ = t := by rw [inv_mul_cancel₀ hd_ne, one_smul]
      refine ⟨equiv_2 (TensorProduct.tmul ℤ q₀ x), ?_⟩
      rw [hG_equiv, hγQ_eq, equiv_U1.apply_symm_apply]
    rcases hEigenExact3 frob_U1 frob_M frob_0 U₁.subtype B_lin hSub_U1_frob hB_frob
        (fun v hv => ⟨⟨v, hv⟩, rfl⟩) γ' hγ' with hU1 | hE0
    · rcases hEigenExact3 frob_2 frob_U1 frob_1 G_lin E_lin hG_frob hE_frob
          hKer_E_le_Range_G γ' hU1 with hE2 | hE1
      · exact Or.inl hE2
      · exact Or.inr (Or.inl hE1)
    · exact Or.inr (Or.inr hE0)
  let Z_bar := weilGeomScheme F Z_tilde
  let D_bar := weilGeomScheme F D₀
  let Fℤ_D := (CategoryTheory.constantSheaf D_bar.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  exact hCore ℓ
    (fun s => weilEtaleTorsionH Z_bar (ℓ ^ s) i_tot)
    F1
    (fun r => (E2_2.ℳ_bar r).H 2)
    (fun r => (E2_1.ℳ_bar r).H 1)
    (fun r => (E2_0.ℳ_bar r).H 0)
    hSub_M0 hFin_E2_2
    (fun s => weilEtaleTorsionTransition Z_bar ℓ s i_tot)
    t_F1
    (fun r => (CategoryTheory.Abelian.Ext.mk₀ (E2_2.τ_bar r)).postcomp Fℤ_D (Nat.add_zero 2))
    (fun r => (CategoryTheory.Abelian.Ext.mk₀ (E2_1.τ_bar r)).postcomp Fℤ_D (Nat.add_zero 1))
    (fun r => (CategoryTheory.Abelian.Ext.mk₀ (E2_0.τ_bar r)).postcomp Fℤ_D (Nat.add_zero 0))
    (weilEtaleIntegralSystem Z_bar ℓ i_tot)
    E2_2.sysSubgroup E2_1.sysSubgroup E2_0.sysSubgroup
    (hL_M_gen Z_bar ℓ i_tot) E2_2.hsys E2_1.hsys E2_0.hsys
    hTor_M hF1_tor hTor_2
    M_Z.V E2_2.V E2_1.V E2_0.V
    M_Z.frob E2_2.frob E2_1.frob E2_0.frob
    M_Z.frobTorsion frob_F1 E2_2.frobTorsion E2_1.frobTorsion E2_0.frobTorsion
    hM_frob_trans hF1_frob_trans hE2_2_frob_trans hE2_1_frob_trans hE2_0_frob_trans
    M_Z.equiv E2_2.equiv E2_1.equiv E2_0.equiv
    M_Z.hsmul E2_2.hsmul E2_1.hsmul E2_0.hsmul
    M_Z.hfrob E2_2.hfrob E2_1.hfrob E2_0.hfrob
    α β γ_map ε_map
    hα_inj hEx_I hEx_II
    hα_trans hβ_trans hγ_trans hε_trans
    hα_frob hβ_frob hγ_frob hε_frob
    γ' hγ'

theorem weil_sing_dev_p1_leray_eigenvalue_trichotomy (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Ztilde : WeilEllAdicCohomologyModel F Z_tilde ℓ (2 * m + 2))
    (γ' : AlgebraicClosure (Padic ℓ))
    (hγ' : γ' ∈ ((M_Ztilde.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    ∃ (E2_2 : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 2
        (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m))
        (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m)))
      (E2_1 : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
        (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 1))
        (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m + 1)))
      (E2_0 : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 0
        (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 2))
        (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m + 2))),
      γ' ∈ ((E2_2.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∨
      γ' ∈ ((E2_1.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∨
      γ' ∈ ((E2_0.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) :=
by
  let D₀ := weilProjectiveSpaceOver F 1
  let k := AlgebraicClosure F
  let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
  let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  obtain ⟨hProp_D₀, hCd2⟩ := weil_sing_dev_leray_p1_geom_cd_le_two F ℓ hℓ
  have : AlgebraicGeometry.IsProper D₀.hom := hProp_D₀

  
  let Z_bar_ov := weilBaseChangeOver F k Z_tilde
  let D_bar_ov := weilBaseChangeOver F k D₀
  let pr_Z := CategoryTheory.Limits.pullback.fst Z_tilde.hom f_ext
  let snd_Z := CategoryTheory.Limits.pullback.snd Z_tilde.hom f_ext
  let pr_D := CategoryTheory.Limits.pullback.fst D₀.hom f_ext
  let snd_D := CategoryTheory.Limits.pullback.snd D₀.hom f_ext
  have hpb_Z : CategoryTheory.IsPullback pr_Z Z_bar_ov.hom Z_tilde.hom f_ext :=
    CategoryTheory.IsPullback.of_hasPullback Z_tilde.hom f_ext
  have hpb_D : CategoryTheory.IsPullback pr_D D_bar_ov.hom D₀.hom f_ext :=
    CategoryTheory.IsPullback.of_hasPullback D₀.hom f_ext
  have : AlgebraicGeometry.IsProper Z_bar_ov.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z inferInstance
  have hProp_Dbar : AlgebraicGeometry.IsProper D_bar_ov.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_D inferInstance
  have : AlgebraicGeometry.IsProper D_bar_ov.hom := hProp_Dbar
  let f_bar : weilGeomScheme F Z_tilde ⟶ weilGeomScheme F D₀ :=
    CategoryTheory.Limits.pullback.map Z_tilde.hom f_ext D₀.hom f_ext
      f₀.left (𝟙 S₀) (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
      ((CategoryTheory.Category.comp_id Z_tilde.hom).trans f₀.w.symm)
      ((CategoryTheory.Category.id_comp f_ext).trans (CategoryTheory.Category.comp_id f_ext).symm)
  have hf_bar_fst : f_bar ≫ pr_D = pr_Z ≫ f₀.left :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hf_bar_snd : f_bar ≫ snd_D = snd_Z :=
    (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id _)
  have hpb_outer : CategoryTheory.IsPullback (f_bar ≫ snd_D) pr_Z f_ext (f₀.left ≫ D₀.hom) :=
    hf_bar_snd.symm ▸ f₀.w.symm ▸ hpb_Z.flip
  have hpb_fbar : CategoryTheory.IsPullback f_bar pr_Z pr_D f₀.left :=
    CategoryTheory.IsPullback.of_right hpb_outer hf_bar_fst hpb_D.flip
  have hf_bar_prop : AlgebraicGeometry.IsProper f_bar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_fbar.flip inferInstance

  
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_k : ((ℓ : ℕ) : k) ≠ 0 := by
    intro hzero
    have hzero_F : ((ℓ : ℕ) : F) = 0 := by
      apply (algebraMap F k).injective
      rw [map_natCast, map_zero]
      exact hzero
    have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp hzero_F
    rcases CharP.char_is_prime_or_zero F (ringChar F) with hchar_p | hchar_0
    · exact hℓ ((hℓ_prime.dvd_iff_eq hchar_p.ne_one).mp hdvd)
    · rw [hchar_0, zero_dvd_iff] at hdvd
      exact hℓ_prime.ne_zero hdvd

  
  have h_tor_H : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (ℱ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
      {n : ℕ} (_ : n • CategoryTheory.CategoryStruct.id ℱ = 0)
      (d : ℕ) (α : ℱ.H d), n • α = 0 := by
    intro W ℱ n hℱ d α
    let Fℤ := (CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hmk : ∀ t : ℕ, CategoryTheory.Abelian.Ext.mk₀ (t • CategoryTheory.CategoryStruct.id ℱ) =
        t • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id ℱ) := by
      intro t
      induction t with
      | zero => simp
      | succ t ih => rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih, succ_nsmul]
    let f_pre : CategoryTheory.Abelian.Ext ℱ ℱ 0 →+ CategoryTheory.Abelian.Ext Fℤ ℱ d :=
      CategoryTheory.Abelian.Ext.precomp (α : CategoryTheory.Abelian.Ext Fℤ ℱ d) ℱ
        (Nat.add_zero d)
    have h1 : f_pre (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id ℱ)) = α :=
      CategoryTheory.Abelian.Ext.comp_mk₀_id (α : CategoryTheory.Abelian.Ext Fℤ ℱ d)
    change n • (α : CategoryTheory.Abelian.Ext Fℤ ℱ d) = 0
    rw [← h1, ← map_nsmul f_pre, ← hmk n, hℱ, CategoryTheory.Abelian.Ext.mk₀_zero, map_zero]

  have h_tor_const : ∀ (S : AlgebraicGeometry.Scheme.{u}) (n : ℕ),
      n • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf S n) = 0 := by
    intro S n
    let A_n := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    have hAn : n • CategoryTheory.CategoryStruct.id A_n = 0 := by
      have h_eval : ∀ (t : ℕ) (x : ↑A_n),
          ((t • CategoryTheory.CategoryStruct.id A_n).hom x).down = t • x.down := by
        intro t x
        induction t with
        | zero => rfl
        | succ t ih =>
          rw [succ_nsmul, succ_nsmul]
          change ((t • CategoryTheory.CategoryStruct.id A_n).hom x).down + x.down =
            t • x.down + x.down
          rw [ih]
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      rw [h_eval n x, nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
      rfl
    let P_n : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj A_n
    have hPn : n • CategoryTheory.CategoryStruct.id P_n = 0 := by
      have h_app : ∀ (t : ℕ) (W : (S.Etale)ᵒᵖ),
          (t • CategoryTheory.CategoryStruct.id P_n).app W =
          t • CategoryTheory.CategoryStruct.id A_n := by
        intro t W
        induction t with
        | zero => rfl
        | succ t ih =>
          rw [succ_nsmul, CategoryTheory.NatTrans.app_add, ih]
          change t • CategoryTheory.CategoryStruct.id A_n +
            CategoryTheory.CategoryStruct.id A_n = (t + 1) • CategoryTheory.CategoryStruct.id A_n
          rw [← succ_nsmul]
      ext W : 2
      rw [h_app n W, hAn]
      rfl
    let sh := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    change n • CategoryTheory.CategoryStruct.id (sh.obj P_n) = 0
    rw [← sh.map_id, ← sh.map_nsmul, hPn, sh.map_zero]

  have hSub_M0 : Subsingleton
      (weilEtaleTorsionH (weilGeomScheme F Z_tilde) (ℓ ^ 0) (2 * m + 2)) := by
    let A₀ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ 0)))
    have hSubZ : Subsingleton (ZMod (ℓ ^ 0)) := by
      rw [pow_zero]
      infer_instance
    have hId_A₀ : CategoryTheory.CategoryStruct.id A₀ = 0 := by
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      exact @Subsingleton.elim _ hSubZ _ _
    let P₀ : ((weilGeomScheme F Z_tilde).Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const _).obj A₀
    have hZero_P₀ : CategoryTheory.Limits.IsZero P₀ := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext W : 2
      exact hId_A₀
    have hZero_sh : CategoryTheory.Limits.IsZero
        (weilEtaleTorsionSheaf (weilGeomScheme F Z_tilde) (ℓ ^ 0)) :=
      (CategoryTheory.presheafToSheaf
        (weilGeomScheme F Z_tilde).smallEtaleTopology AddCommGrpCat.{u}).map_isZero hZero_P₀
    exact CategoryTheory.Sheaf.subsingleton_H_of_isZero hZero_sh (2 * m + 2)

  have hFin_M : ∀ r : ℕ,
      Finite (weilEtaleTorsionH (weilGeomScheme F Z_tilde) (ℓ ^ (r + 1)) (2 * m + 2)) :=
    fun r => weil_etale_proper_torsion_finiteness F Z_tilde (2 * m + 2) ℓ hℓ (2 * m + 2) (r + 1)

  have hTor_M : ∀ (s : ℕ)
      (y : weilEtaleTorsionH (weilGeomScheme F Z_tilde) (ℓ ^ s) (2 * m + 2)),
      (ℓ ^ s) • y = 0 :=
    fun s y => h_tor_H (weilGeomScheme F Z_tilde)
      (weilEtaleTorsionSheaf (weilGeomScheme F Z_tilde) (ℓ ^ s))
      (h_tor_const (weilGeomScheme F Z_tilde) (ℓ ^ s)) (2 * m + 2) y

  have hM_frob_trans : ∀ (s : ℕ)
      (u : weilEtaleTorsionH (weilGeomScheme F Z_tilde) (ℓ ^ (s + 1)) (2 * m + 2)),
      weilEtaleTorsionTransition (weilGeomScheme F Z_tilde) ℓ s (2 * m + 2)
        (M_Ztilde.frobTorsion (s + 1) u) =
      M_Ztilde.frobTorsion s
        (weilEtaleTorsionTransition (weilGeomScheme F Z_tilde) ℓ s (2 * m + 2) u) :=
    fun s u => (weil_etale_module_ext_comparison.2.2 F Z_tilde).2.1 ℓ s (2 * m + 2)
      (M_Ztilde.frobTorsion (s + 1)) (M_Ztilde.frobTorsion s)
      (M_Ztilde.hfrobTorsion (s + 1)) (M_Ztilde.hfrobTorsion s) u

  
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ_k
  have hP1 : WeilP1ConstructiblePushforwardHolds k ℓ :=
    weil_etale_p1_constructible_pushforward k ℓ hℓ_k
      (fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
        weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀)
      hPBC
  have hConst_Z : WeilIsConstructibleModPrimeSheaf ℓ Z_bar_ov.left
      (weilEtaleTorsionSheaf Z_bar_ov.left ℓ) :=
    (weil_etale_constructible_mod_prime_extraction_over_algClosed k Z_bar_ov ℓ 0).1
  let f_bar_ov : Z_bar_ov ⟶ D_bar_ov := CategoryTheory.Over.homMk f_bar hf_bar_snd
  have hConst_R0 : ∀ q : ℕ,
      WeilIsConstructibleModPrimeSheaf ℓ (weilGeomScheme F D₀)
        (weilEtaleHigherDirectImage f_bar q
          (weilEtaleTorsionSheaf (weilGeomScheme F Z_tilde) ℓ)) :=
    fun q => weil_etale_proper_constructible_pushforward k ℓ hℓ_k hPBC hP1
      Z_bar_ov D_bar_ov f_bar_ov hf_bar_prop (weilEtaleTorsionSheaf Z_bar_ov.left ℓ) hConst_Z q

  have h_etale_of_sec : ∀ {V : AlgebraicGeometry.Scheme.{u}}
      (σ : S₀ ⟶ V) (q : V ⟶ S₀) [AlgebraicGeometry.Etale q],
      σ ≫ q = 𝟙 S₀ → AlgebraicGeometry.Etale σ := by
    intro V σ q _ h
    have hcomp : (@AlgebraicGeometry.Etale) (σ ≫ q) := by
      rw [h]
      infer_instance
    exact @CategoryTheory.MorphismProperty.of_postcomp _ _
      (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) _ _ _ _
      σ q ‹AlgebraicGeometry.Etale q› hcomp

  have h_spec_sec : ∀ (V : AlgebraicGeometry.Scheme.{u}) (q : V ⟶ S₀)
      [AlgebraicGeometry.Etale q] [AlgebraicGeometry.Surjective q],
      ∃ σ : S₀ ⟶ V, σ ≫ q = 𝟙 S₀ := by
    intro V q _ _
    let P_pt := AlgebraicGeometry.Scheme.geometricFiber k
    have hmem_pre : CategoryTheory.Presieve.singleton q ∈
        AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale) S₀ :=
      (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff (@AlgebraicGeometry.Etale) q).mpr
        ⟨q.surjective, inferInstance⟩
    have hmem : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q) ∈
        AlgebraicGeometry.Scheme.etaleTopology S₀ :=
      CategoryTheory.Precoverage.generate_mem_toGrothendieck hmem_pre
    obtain ⟨Y, f, hf, y, hy⟩ := P_pt.jointly_surjective
      (CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)) hmem (𝟙 S₀)
    let y₀ : S₀ ⟶ Y := y
    change y₀ ≫ f = 𝟙 S₀ at hy
    rcases hf with ⟨W, g, f₀, ⟨⟩, rfl⟩
    exact ⟨y₀ ≫ g, (CategoryTheory.Category.assoc y₀ g q).trans hy⟩

  have h_top_sieve : ∀ (X : AlgebraicGeometry.Scheme.{u}) (W : X.Etale),
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj W).left = S₀ →
      ∀ R ∈ X.smallEtaleTopology W, R = ⊤ := by
    intro X W hW R hR
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hmem_iff : R ∈ X.smallEtaleTopology W ↔
        ∀ (x : ↥(Fgt.obj W).left), ∃ (Y : X.Etale) (f : Y ⟶ W) (y : ↥(Fgt.obj Y).left),
          R.arrows f ∧ AlgebraicGeometry.Etale (Fgt.map f).left ∧
          (Fgt.map f).left.base y = x := by
      have htop := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X (le_refl _)
      exact (iff_of_eq (congrFun (congrArg (fun J => J W) htop) R)).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) W R)
    have x₀ : ↥(Fgt.obj W).left :=
      Equiv.cast (congrArg (fun Z : AlgebraicGeometry.Scheme.{u} => ↥Z) hW.symm) default
    obtain ⟨Y, u, y₀, hu_mem, hu_et, _⟩ := (hmem_iff.mp hR) x₀
    let uL : (Fgt.obj Y).left ⟶ (Fgt.obj W).left := (Fgt.map u).left
    let u₀ : (Fgt.obj Y).left ⟶ S₀ := uL ≫ CategoryTheory.eqToHom hW
    have : AlgebraicGeometry.Etale uL := hu_et
    have : AlgebraicGeometry.Etale u₀ := inferInstance
    have : AlgebraicGeometry.Surjective u₀ := ⟨fun _ => ⟨y₀, Subsingleton.elim _ _⟩⟩
    obtain ⟨s, hs⟩ := h_spec_sec (Fgt.obj Y).left u₀
    let s_W : (Fgt.obj W).left ⟶ (Fgt.obj Y).left := CategoryTheory.eqToHom hW ≫ s
    have hs_u : s_W ≫ uL = 𝟙 (Fgt.obj W).left := by
      apply (CategoryTheory.cancel_mono (CategoryTheory.eqToHom hW)).mp
      have h1 : (s_W ≫ uL) ≫ CategoryTheory.eqToHom hW =
          CategoryTheory.eqToHom hW ≫ (s ≫ u₀) := by
        dsimp [s_W, u₀]
        simp only [CategoryTheory.Category.assoc]
        rfl
      rw [h1, hs, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    have hs_over : s_W ≫ (Fgt.obj Y).hom = (Fgt.obj W).hom := by
      have hw : uL ≫ (Fgt.obj W).hom = (Fgt.obj Y).hom := (Fgt.map u).w
      rw [← hw, ← CategoryTheory.Category.assoc, hs_u, CategoryTheory.Category.id_comp]
    let s_et : W ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk s_W hs_over
    have h_id : s_et ≫ u = 𝟙 W := CategoryTheory.MorphismProperty.Over.Hom.ext hs_u
    have hid_mem : R.arrows (𝟙 W) := h_id ▸ R.downward_closed hu_mem s_et
    exact (CategoryTheory.Sieve.id_mem_iff_eq_top).mp hid_mem

  let skyPresheaf : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (X₀ : C) (M : AddCommGrpCat.{u}), Cᵒᵖ ⥤ AddCommGrpCat.{u} :=
    fun {C} _ X₀ M =>
      { obj := fun U => AddCommGrpCat.of ((X₀ ⟶ Opposite.unop U) → ↑M)
        map := fun {_ _} f => AddCommGrpCat.ofHom
          { toFun := fun s τ => s (τ ≫ f.unop)
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ => AddCommGrpCat.ext fun s => funext fun τ =>
          congrArg s (CategoryTheory.Category.comp_id τ)
        map_comp := fun _ _ => AddCommGrpCat.ext fun s => funext fun τ =>
          congrArg s (CategoryTheory.Category.assoc τ _ _).symm }

  have h_sky_isSheaf : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C) (X₀ : C),
      (∀ R ∈ J X₀, R = ⊤) →
      ∀ (M : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf J (skyPresheaf X₀ M) := by
    intro C _ J X₀ hTop M
    rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
    intro U S hS
    have hmem : ∀ τ : (X₀ ⟶ U), S.arrows (CategoryTheory.Over.mk τ).hom := by
      intro τ
      have hpb : S.pullback τ = ⊤ := hTop _ (J.pullback_stable τ hS)
      have h1 : (S.pullback τ).arrows (𝟙 X₀) := by rw [hpb]; trivial
      simpa [CategoryTheory.Sieve.pullback_apply] using h1
    refine ⟨{
      lift := fun c => AddCommGrpCat.ofHom
        { toFun := fun w τ =>
            (c.π.app (Opposite.op (⟨CategoryTheory.Over.mk τ, hmem τ⟩ : S.arrows.category))).hom
              w (𝟙 X₀)
          map_zero' := funext fun _ => by rw [map_zero]; rfl
          map_add' := fun _ _ => funext fun _ => by rw [map_add]; rfl }
      fac := fun c j => by
        apply AddCommGrpCat.ext
        intro w
        funext ρ
        let o_src : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (ρ ≫ j.unop.1.hom), S.downward_closed j.unop.2 ρ⟩
        let mor : o_src ⟶ j.unop := CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk ρ)
        have hw : (c.π.app (Opposite.op o_src)).hom w (𝟙 X₀) =
            (c.π.app j).hom w (𝟙 X₀ ≫ ρ) :=
          congrArg (fun φ => φ.hom w (𝟙 X₀)) (c.π.naturality mor.op)
        change (c.π.app (Opposite.op o_src)).hom w (𝟙 X₀) = (c.π.app j).hom w ρ
        exact hw.trans (congrArg ((c.π.app j).hom w) (CategoryTheory.Category.id_comp ρ))
      uniq := fun c m hm => by
        apply AddCommGrpCat.ext
        intro w
        funext τ
        let j_τ : S.arrows.category := ⟨CategoryTheory.Over.mk τ, hmem τ⟩
        have hm_τ : (m.hom w) (𝟙 X₀ ≫ τ) = (c.π.app (Opposite.op j_τ)).hom w (𝟙 X₀) :=
          congrArg (fun φ => φ.hom w (𝟙 X₀)) (hm (Opposite.op j_τ))
        exact (congrArg (m.hom w) (CategoryTheory.Category.id_comp τ)).symm.trans hm_τ }⟩

  have h_sheafify_stalk_iso : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      (X₀ : C),
      (∀ R ∈ J X₀, R = ⊤) →
      ∀ (P : Cᵒᵖ ⥤ AddCommGrpCat.{u}),
        Nonempty (P.obj (Opposite.op X₀) ≅
          ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P).obj.obj
            (Opposite.op X₀)) := by
    intro C _ J _ X₀ hTop P
    let adj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let P_sh := (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P
    let η : P.obj (Opposite.op X₀) ⟶ P_sh.obj.obj (Opposite.op X₀) :=
      (adj.unit.app P).app (Opposite.op X₀)
    let evLift : ∀ (Q : Cᵒᵖ ⥤ AddCommGrpCat.{u}) {M : AddCommGrpCat.{u}}
        (φ : Q.obj (Opposite.op X₀) ⟶ M), Q ⟶ skyPresheaf X₀ M :=
      fun Q {_} φ =>
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := fun q τ => φ.hom ((Q.map τ.op).hom q)
              map_zero' := funext fun _ => by simp
              map_add' := fun _ _ => funext fun _ => by simp }
          naturality := fun {_ _} f => AddCommGrpCat.ext fun q => funext fun τ => by
            have hmap : Q.map (τ ≫ f.unop).op = Q.map f ≫ Q.map τ.op := by
              rw [CategoryTheory.op_comp, Q.map_comp]
              rfl
            exact (congrArg φ.hom (congrArg (fun α => α.hom q) hmap)).symm }
    let R₁ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      ⟨skyPresheaf X₀ (P.obj (Opposite.op X₀)), h_sky_isSheaf J X₀ hTop _⟩
    let r_sh : P_sh ⟶ R₁ := (adj.homEquiv P R₁).symm (evLift P (𝟙 _))
    have hr_unit : adj.unit.app P ≫ r_sh.hom = evLift P (𝟙 _) := by
      have h1 : adj.homEquiv P R₁ r_sh = evLift P (𝟙 _) :=
        (adj.homEquiv P R₁).apply_symm_apply _
      rwa [CategoryTheory.Adjunction.homEquiv_unit] at h1
    let r : P_sh.obj.obj (Opposite.op X₀) ⟶ P.obj (Opposite.op X₀) :=
      AddCommGrpCat.ofHom
        { toFun := fun x => (r_sh.hom.app (Opposite.op X₀)).hom x (𝟙 X₀)
          map_zero' := by rw [map_zero]; rfl
          map_add' := fun _ _ => by rw [map_add]; rfl }
    have hηr : η ≫ r = 𝟙 _ := by
      apply AddCommGrpCat.ext
      intro x
      have h1 : (r_sh.hom.app (Opposite.op X₀)).hom (η.hom x) (𝟙 X₀) =
          (P.map (𝟙 X₀).op).hom x :=
        congrArg (fun α => (α.app (Opposite.op X₀)).hom x (𝟙 X₀)) hr_unit
      have h2 : (P.map (𝟙 X₀).op).hom x = x :=
        congrArg (fun α => α.hom x) ((congrArg P.map CategoryTheory.op_id).trans (P.map_id _))
      exact h1.trans h2
    let R₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      ⟨skyPresheaf X₀ (P_sh.obj.obj (Opposite.op X₀)), h_sky_isSheaf J X₀ hTop _⟩
    let g₁ : P_sh ⟶ R₂ := CategoryTheory.ObjectProperty.homMk (evLift P_sh.obj (r ≫ η))
    let g₂ : P_sh ⟶ R₂ := CategoryTheory.ObjectProperty.homMk (evLift P_sh.obj (𝟙 _))
    have hg_eq : g₁ = g₂ := by
      apply (adj.homEquiv P R₂).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      ext U : 2
      apply AddCommGrpCat.ext
      intro x
      funext τ
      have hnat : η.hom ((P.map τ.op).hom x) =
          (P_sh.obj.map τ.op).hom (((adj.unit.app P).app U).hom x) :=
        congrArg (fun φ => φ.hom x) ((adj.unit.app P).naturality τ.op)
      have hηr_y : ∀ y, r.hom (η.hom y) = y :=
        fun y => congrArg (fun (φ : P.obj _ ⟶ P.obj _) => φ.hom y) hηr
      change η.hom (r.hom ((P_sh.obj.map τ.op).hom (((adj.unit.app P).app U).hom x))) =
        (P_sh.obj.map τ.op).hom (((adj.unit.app P).app U).hom x)
      rw [← hnat, hηr_y]
    have hrη : r ≫ η = 𝟙 _ := by
      apply AddCommGrpCat.ext
      intro x
      have h1 : η.hom (r.hom ((P_sh.obj.map (𝟙 X₀).op).hom x)) =
          (P_sh.obj.map (𝟙 X₀).op).hom x :=
        congrArg (fun (g : P_sh ⟶ R₂) => (g.hom.app (Opposite.op X₀)).hom x (𝟙 X₀)) hg_eq
      have h2 : (P_sh.obj.map (𝟙 X₀).op).hom x = x :=
        congrArg (fun α => α.hom x)
          ((congrArg P_sh.obj.map CategoryTheory.op_id).trans (P_sh.obj.map_id _))
      rw [h2] at h1
      exact h1
    exact ⟨{ hom := η, inv := r, hom_inv_id := hηr, inv_hom_id := hrη }⟩

  have hFin_C : ∀ (𝒢 : CategoryTheory.Sheaf
      (weilGeomScheme F D₀).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ (weilGeomScheme F D₀) 𝒢 →
      ∀ i : ℕ, Finite (𝒢.H i) := by
    intro 𝒢 h𝒢 i
    let B₀_ov : CategoryTheory.Over S₀ := CategoryTheory.Over.mk (𝟙 S₀)
    have : AlgebraicGeometry.LocallyOfFiniteType B₀_ov.hom :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.LocallyOfFiniteType)).id_mem S₀
    have : AlgebraicGeometry.QuasiCompact B₀_ov.hom :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.QuasiCompact)).id_mem S₀
    have : AlgebraicGeometry.IsSeparated B₀_ov.hom :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.IsSeparated)).id_mem S₀
    let g_ov : D_bar_ov ⟶ B₀_ov :=
      CategoryTheory.Over.homMk D_bar_ov.hom (CategoryTheory.Category.comp_id _)
    have hG_Spec : WeilIsConstructibleModPrimeSheaf ℓ S₀
        (weilEtaleHigherDirectImage D_bar_ov.hom i 𝒢) :=
      weil_etale_proper_constructible_pushforward k ℓ hℓ_k hPBC hP1
        D_bar_ov B₀_ov g_ov hProp_Dbar 𝒢 h𝒢 i
    set G_Spec := weilEtaleHigherDirectImage D_bar_ov.hom i 𝒢
    have hInt_S₀ : AlgebraicGeometry.IsIntegral S₀ := by
      have e_ring := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv
      have : IsDomain ↑(S₀.presheaf.obj (Opposite.op ⊤)) := e_ring.toMulEquiv.isDomain k
      exact AlgebraicGeometry.isIntegral_of_isAffine_of_isDomain S₀
    have hCl_id : AlgebraicGeometry.IsClosedImmersion (𝟙 S₀) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.IsClosedImmersion)).id_mem S₀
    obtain ⟨U_sp, hU_ne, V, p_V, A_fin, _, hEt_p, hSurj_p, hFin_A, _, hq_pb⟩ :=
      hG_Spec.2 S₀ (𝟙 S₀) hCl_id hInt_S₀
    set q : V ⟶ S₀ := p_V ≫ (U_sp.ι ≫ 𝟙 S₀)
    have hEt_id : AlgebraicGeometry.Etale (𝟙 S₀) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.Etale)).id_mem S₀
    have hEt_U : AlgebraicGeometry.Etale U_sp.ι := inferInstance
    have : AlgebraicGeometry.Etale q :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.Etale)).comp_mem p_V (U_sp.ι ≫ 𝟙 S₀) hEt_p
        ((inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
          (@AlgebraicGeometry.Etale)).comp_mem U_sp.ι (𝟙 S₀) hEt_U hEt_id)
    have : AlgebraicGeometry.Surjective q := by
      refine ⟨fun _ => ?_⟩
      obtain ⟨v₀, _⟩ := hSurj_p.surj hU_ne.some
      exact ⟨v₀, Subsingleton.elim _ _⟩
    obtain ⟨σ, hσq⟩ := h_spec_sec V q
    have hEt_σ : AlgebraicGeometry.Etale σ := h_etale_of_sec σ q hσq
    let T₀ : S₀.Etale := @AlgebraicGeometry.Scheme.Etale.mk S₀ S₀ (𝟙 S₀) hEt_id
    let W_σ : V.Etale := @AlgebraicGeometry.Scheme.Etale.mk V S₀ σ hEt_σ
    have hTop_T₀ : ∀ R ∈ S₀.smallEtaleTopology T₀, R = ⊤ := h_top_sieve S₀ T₀ rfl
    have hTop_W : ∀ R ∈ V.smallEtaleTopology W_σ, R = ⊤ := h_top_sieve V W_σ rfl
    rcases hq_pb with ⟨hCont_q, hAdj_q, ⟨e_q⟩⟩
    let hp_q : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) q :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let hs_q : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) q :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_q : S₀.Etale ⥤ V.Etale :=
      @CategoryTheory.MorphismProperty.Over.pullback _ _ (@AlgebraicGeometry.Etale) ⊤ _ _ _
        q hp_q hs_q _
    let P_q := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_q AddCommGrpCat.{u} _ S₀.smallEtaleTopology V.smallEtaleTopology hCont_q
    let L_q := @CategoryTheory.Functor.sheafPullback _ _ _ _
      B_q AddCommGrpCat.{u} _ S₀.smallEtaleTopology V.smallEtaleTopology hCont_q hAdj_q
    let adj_q := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      B_q AddCommGrpCat.{u} _ S₀.smallEtaleTopology V.smallEtaleTopology hCont_q hAdj_q
    
    have hInj_T₀ : ∃ f_inj : ↑(G_Spec.obj.obj (Opposite.op T₀)) →
        ↑((L_q.obj G_Spec).obj.obj (Opposite.op W_σ)), Function.Injective f_inj := by
      let M_G := G_Spec.obj.obj (Opposite.op T₀)
      let R_W : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} :=
        ⟨skyPresheaf W_σ M_G, h_sky_isSheaf V.smallEtaleTopology W_σ hTop_W M_G⟩
      let Fgt₀ := AlgebraicGeometry.Scheme.Etale.forget S₀
      let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget V
      let proj_Z : ∀ (Z : S₀.Etale), (W_σ ⟶ B_q.obj Z) → (T₀ ⟶ Z) := fun Z τ =>
        let τL : S₀ ⟶ CategoryTheory.Limits.pullback (Fgt₀.obj Z).hom q := (Fgt_V.map τ).left
        have hτ_snd : τL ≫ CategoryTheory.Limits.pullback.snd (Fgt₀.obj Z).hom q = σ :=
          (Fgt_V.map τ).w
        have hw_Z : (τL ≫ CategoryTheory.Limits.pullback.fst (Fgt₀.obj Z).hom q) ≫
            (Fgt₀.obj Z).hom = 𝟙 S₀ :=
          (CategoryTheory.Category.assoc τL _ _).trans
            ((congrArg (τL ≫ ·) CategoryTheory.Limits.pullback.condition).trans
              ((CategoryTheory.Category.assoc τL _ _).symm.trans
                ((congrArg (· ≫ q) hτ_snd).trans hσq)))
        CategoryTheory.MorphismProperty.Over.homMk
          (τL ≫ CategoryTheory.Limits.pullback.fst (Fgt₀.obj Z).hom q) hw_Z
      let Φ_G : G_Spec ⟶ P_q.obj R_W := CategoryTheory.ObjectProperty.homMk
        { app := fun opZ => AddCommGrpCat.ofHom
            { toFun := fun g τ => (G_Spec.obj.map (proj_Z opZ.unop τ).op).hom g
              map_zero' := funext fun _ => by rw [map_zero]; rfl
              map_add' := fun _ _ => funext fun _ => by rw [map_add]; rfl }
          naturality := fun {opZ₁ opZ₂} f => AddCommGrpCat.ext fun g => funext fun τ => by
            have hproj : proj_Z opZ₁.unop (τ ≫ B_q.map f.unop) = proj_Z opZ₂.unop τ ≫ f.unop := by
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              have hmap_fst : (Fgt_V.map (B_q.map f.unop)).left ≫
                  CategoryTheory.Limits.pullback.fst (Fgt₀.obj opZ₁.unop).hom q =
                  CategoryTheory.Limits.pullback.fst (Fgt₀.obj opZ₂.unop).hom q ≫
                    (Fgt₀.map f.unop).left :=
                (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (Fgt₀.obj opZ₁.unop).hom q)
                  (CategoryTheory.MorphismProperty.Over.pullback_map_left
                    (@AlgebraicGeometry.Etale) ⊤ q f.unop)).trans
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              exact (CategoryTheory.Category.assoc (Fgt_V.map τ).left _ _).trans
