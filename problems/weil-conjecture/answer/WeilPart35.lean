      have hu₂_map : U_aff.map u₂_hom = w_k ≫ p₂ := hFF_Uaff.map_preimage (w_k ≫ p₂)
      have hu₁_compat : geomLiftMap Z Ω₀ y₀ (U_aff.map u₁_hom) k.unop.2 = i₁.unop.2 := by
        rw [hu₁_map]
        apply Subtype.ext
        change k.unop.2.1 ≫ (Fgt.map (w_k ≫ p₁)).left = i₁.unop.2.1
        rw [Fgt.map_comp]
        change k.unop.2.1 ≫ ((Fgt.map w_k).left ≫ fst_w') = i₁.unop.2.1
        rw [← CategoryTheory.Category.assoc, hwk_val]
        exact CategoryTheory.Limits.pullback.lift_fst i₁.unop.2.1 i₂.unop.2.1 hδ_comm
