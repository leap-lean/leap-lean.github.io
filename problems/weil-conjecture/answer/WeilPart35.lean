      change tr_0 r (β (r + 1) (y.1 (r + 2))) = β r (tr_M (r + 1) (y.1 (r + 2))) at htr
      rw [htr, (hL_M y.1).mp y.2 (r + 1)]
    let β_sys : ↥L_M →+ ↥L_0 :=
      { toFun := fun y => ⟨fun r => β r (y.1 (r + 1)), hβ_mem y⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (β r))
        map_add' := fun y₁ y₂ =>
          Subtype.ext (funext fun r => map_add (β r) (y₁.1 (r + 1)) (y₂.1 (r + 1))) }
    have hβα_zero : ∀ w : ↥L_F1, β_sys (α_sys w) = 0 := by
      intro w
      apply Subtype.ext; funext r
      exact (hEx_I r (α r (w.1 r))).mpr ⟨w.1 r, rfl⟩
    have hExact_sys_I : ∀ y : ↥L_M, β_sys y = 0 → ∃ w : ↥L_F1, α_sys w = y := by
      intro y hy0
      have hEx_r : ∀ r : ℕ, ∃ wr : F1 r, α r wr = y.1 (r + 1) := by
        intro r
        have hβr : β r (y.1 (r + 1)) = 0 := congrFun (congrArg Subtype.val hy0) r
        exact (hEx_I r (y.1 (r + 1))).mp hβr
      let w_fn : ∀ r : ℕ, F1 r := fun r => Classical.choose (hEx_r r)
      have hw_spec : ∀ r : ℕ, α r (w_fn r) = y.1 (r + 1) :=
        fun r => Classical.choose_spec (hEx_r r)
      have hw_mem : w_fn ∈ L_F1 := by
        rw [hL_F1]
        intro r
        apply hα_inj r
        have htr := DFunLike.congr_fun (hα_trans r) (w_fn (r + 1))
        change tr_M (r + 1) (α (r + 1) (w_fn (r + 1))) = α r (t_F1 r (w_fn (r + 1))) at htr
        rw [← htr, hw_spec (r + 1), (hL_M y.1).mp y.2 (r + 1), hw_spec r]
      refine ⟨⟨w_fn, hw_mem⟩, ?_⟩
      apply Subtype.ext; funext s
      cases s with
      | zero => exact hSub_M0.elim _ _
      | succ r => exact hw_spec r
    obtain ⟨β_Q, B_lin, hβ_Q_tmul, hB_equiv⟩ :=
      hLiftLinShift (fun s => s) (fun r => r + 1) (fun s => Nat.le_succ s)
        hL_M hTor_M equiv_M equiv_0 hsmul_M hsmul_0 β_sys
        (fun z x y hxy r => by
          change β r (y.1 (r + 1)) = (PadicInt.toZModPow (r + 1) z).val • β r (x.1 (r + 1))
          rw [hxy (r + 1), map_nsmul])
    have hF_M_mem : ∀ y : ↥L_M, (fun s => frobTors_M s (y.1 s)) ∈ L_M := by
      intro y; rw [hL_M]; intro s
      rw [hfrob_tr_M s (y.1 (s + 1)), (hL_M y.1).mp y.2 s]
    have hF_0_mem : ∀ z : ↥L_0, (fun r => frobTors_0 r (z.1 r)) ∈ L_0 := by
      intro z; rw [hL_0]; intro r
      rw [hfrob_tr_0 r (z.1 (r + 1)), (hL_0 z.1).mp z.2 r]
    have hB_frob : B_lin.comp frob_M = frob_0.comp B_lin := by
      apply hLin_ext equiv_M
      intro y
      let fy : ↥L_M := ⟨fun s => frobTors_M s (y.1 s), hF_M_mem y⟩
      let fby : ↥L_0 := ⟨fun r => frobTors_0 r ((β_sys y).1 r), hF_0_mem (β_sys y)⟩
      have hfby_eq : β_sys fy = fby :=
        Subtype.ext (funext fun r => hβ_frob r (y.1 (r + 1)))
      simp only [LinearMap.comp_apply]
      rw [hfrob_M y fy (fun _ => rfl), hB_equiv, hβ_Q_tmul, hB_equiv, hβ_Q_tmul,
        hfrob_0 (β_sys y) fby (fun _ => rfl), hfby_eq]
    let U₁ : Submodule K V_M := LinearMap.ker B_lin
    have hU₁_inv : ∀ v ∈ U₁, frob_M v ∈ U₁ := by
      intro v hv
      rw [LinearMap.mem_ker] at hv ⊢
      have h1 := LinearMap.congr_fun hB_frob v
      simp only [LinearMap.comp_apply] at h1
      rw [h1, hv, map_zero]
    let frob_U1 : ↥U₁ →ₗ[K] ↥U₁ := frob_M.restrict hU₁_inv
    have hSub_U1_frob : frob_M.comp U₁.subtype = U₁.subtype.comp frob_U1 := by
      ext u
      rfl
    let B_α : ℚ →+ ↥L_F1 →+ TensorProduct ℤ ℚ ↥L_M :=
      { toFun := fun q => (TensorProduct.mk ℤ ℚ ↥L_M q).toAddMonoidHom.comp α_sys
        map_zero' := by ext w; exact TensorProduct.zero_tmul ℚ (α_sys w)
        map_add' := fun q₁ q₂ => by ext w; exact TensorProduct.add_tmul q₁ q₂ (α_sys w) }
    have hB_α : ∀ (r : ℤ) (q : ℚ) (w : ↥L_F1), B_α (r • q) w = B_α q (r • w) := by
      intro r q w
      change TensorProduct.tmul ℤ (r • q) (α_sys w) = TensorProduct.tmul ℤ q (α_sys (r • w))
      rw [map_zsmul α_sys r w, TensorProduct.smul_tmul]
    let α_Q : TensorProduct ℤ ℚ ↥L_F1 →+ TensorProduct ℤ ℚ ↥L_M :=
      TensorProduct.liftAddHom B_α hB_α
    have hα_Q_tmul : ∀ (q : ℚ) (w : ↥L_F1),
        α_Q (TensorProduct.tmul ℤ q w) = TensorProduct.tmul ℤ q (α_sys w) :=
      fun q w => TensorProduct.liftAddHom_tmul B_α hB_α q w
    have hα_U1_mem : ∀ t : TensorProduct ℤ ℚ ↥L_F1, equiv_M (α_Q t) ∈ U₁ := by
      intro t
      rw [LinearMap.mem_ker]
      refine TensorProduct.inductionOn t ?_ ?_
      · intro q w
        rw [hB_equiv, hα_Q_tmul, hβ_Q_tmul, hβα_zero w, TensorProduct.tmul_zero, map_zero]
      · intro t₁ t₂ h₁ h₂
        rw [map_add, map_add, map_add, h₁, h₂, add_zero]
    let φ_U1 : TensorProduct ℤ ℚ ↥L_F1 →+ ↥U₁ :=
      { toFun := fun t => ⟨equiv_M (α_Q t), hα_U1_mem t⟩
        map_zero' := by
          apply Subtype.ext
          change equiv_M (α_Q 0) = 0
          rw [map_zero, map_zero]
        map_add' := fun t₁ t₂ => by
          apply Subtype.ext
          change equiv_M (α_Q (t₁ + t₂)) = equiv_M (α_Q t₁) + equiv_M (α_Q t₂)
          rw [map_add, map_add] }
    let S₀ : Submonoid ℤ := nonZeroDivisors ℤ
    let f_F1 : ↥L_F1 →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_F1 := TensorProduct.mk ℤ ℚ ↥L_F1 (1 : ℚ)
    let f_M : ↥L_M →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_M := TensorProduct.mk ℤ ℚ ↥L_M (1 : ℚ)
    let f_0 : ↥L_0 →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_0 := TensorProduct.mk ℤ ℚ ↥L_0 (1 : ℚ)
    let f_1 : ↥L_1 →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_1 := TensorProduct.mk ℤ ℚ ↥L_1 (1 : ℚ)
    have : IsLocalizedModule S₀ f_F1 := IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
    have : IsLocalizedModule S₀ f_M := IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
    have : IsLocalizedModule S₀ f_0 := IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
    have : IsLocalizedModule S₀ f_1 := IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
    have hφ_U1_inj : Function.Injective φ_U1 := by
      rw [injective_iff_map_eq_zero]
      intro t ht0
      have hαQt : α_Q t = 0 := by
        apply equiv_M.injective
        rw [map_zero]
        exact congrArg Subtype.val ht0
      obtain ⟨⟨w, s⟩, hst⟩ := IsLocalizedModule.surj S₀ f_F1 t
      have hst_z : (s : ℤ) • t = TensorProduct.tmul ℤ (1 : ℚ) w := hst
      have hs_ne : (s : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hf_M_zero : f_M (α_sys w) = 0 := by
        change TensorProduct.tmul ℤ (1 : ℚ) (α_sys w) = 0
        rw [← hα_Q_tmul (1 : ℚ) w, ← hst_z, map_zsmul, hαQt, smul_zero]
      have hmk_zero : IsLocalizedModule.mk' f_M (α_sys w) (1 : S₀) = 0 :=
        (IsLocalizedModule.mk'_eq_zero (1 : S₀)).mpr hf_M_zero
      obtain ⟨s', hs'⟩ := (IsLocalizedModule.mk'_eq_zero' f_M (1 : S₀)).mp hmk_zero
      have hs'_z : (s' : ℤ) • α_sys w = 0 := hs'
      have hs'_ne : (s' : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      have hw_s' : (s' : ℤ) • w = 0 := by
        apply hα_sys_inj
        rw [map_zsmul, hs'_z, map_zero]
      let d_int : ℤ := (s : ℤ) * (s' : ℤ)
      have hd_ne : (d_int : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (mul_ne_zero hs_ne hs'_ne)
      have hdt : (d_int : ℚ) • t = 0 := by
        rw [Int.cast_smul_eq_zsmul]
        dsimp [d_int]
        rw [mul_comm, mul_smul, hst_z, ← TensorProduct.tmul_smul, hw_s',
          TensorProduct.tmul_zero]
      calc
        t = ((d_int : ℚ)⁻¹ * (d_int : ℚ)) • t := by rw [inv_mul_cancel₀ hd_ne, one_smul]
        _ = (d_int : ℚ)⁻¹ • ((d_int : ℚ) • t) := mul_smul _ _ _
        _ = 0 := by rw [hdt, smul_zero]
    have hφ_U1_surj : Function.Surjective φ_U1 := by
      intro u
      have hu0 : B_lin u.1 = 0 := LinearMap.mem_ker.mp u.2
      let t := equiv_M.symm u.1
      have hβQt : β_Q t = 0 := by
        apply equiv_0.injective
        rw [map_zero, ← hB_equiv t, equiv_M.apply_symm_apply]
        exact hu0
      obtain ⟨⟨y, s⟩, hst⟩ := IsLocalizedModule.surj S₀ f_M t
      have hst_z : (s : ℤ) • t = TensorProduct.tmul ℤ (1 : ℚ) y := hst
      have hs_ne : (s : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hf_0_zero : f_0 (β_sys y) = 0 := by
        change TensorProduct.tmul ℤ (1 : ℚ) (β_sys y) = 0
        rw [← hβ_Q_tmul (1 : ℚ) y, ← hst_z, map_zsmul, hβQt, smul_zero]
      have hmk_zero : IsLocalizedModule.mk' f_0 (β_sys y) (1 : S₀) = 0 :=
        (IsLocalizedModule.mk'_eq_zero (1 : S₀)).mpr hf_0_zero
      obtain ⟨s', hs'⟩ := (IsLocalizedModule.mk'_eq_zero' f_0 (1 : S₀)).mp hmk_zero
      have hs'_z : (s' : ℤ) • β_sys y = 0 := hs'
      have hs'_ne : (s' : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      have hβ_s'y : β_sys ((s' : ℤ) • y) = 0 := by rw [map_zsmul, hs'_z]
      obtain ⟨w, hw⟩ := hExact_sys_I ((s' : ℤ) • y) hβ_s'y
      let d_int : ℤ := (s : ℤ) * (s' : ℤ)
      have hd_ne : (d_int : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (mul_ne_zero hs_ne hs'_ne)
      let q₀ : ℚ := (d_int : ℚ)⁻¹
      have hαQ_eq : α_Q (TensorProduct.tmul ℤ q₀ w) = t := by
        have h1 : (d_int : ℚ) • α_Q (TensorProduct.tmul ℤ q₀ w) =
            TensorProduct.tmul ℤ (1 : ℚ) ((s' : ℤ) • y) := by
          rw [hα_Q_tmul, hw, TensorProduct.smul_tmul', smul_eq_mul, mul_inv_cancel₀ hd_ne]
        have h2 : (d_int : ℚ) • t = TensorProduct.tmul ℤ (1 : ℚ) ((s' : ℤ) • y) := by
          rw [Int.cast_smul_eq_zsmul]
          dsimp [d_int]
          rw [mul_comm, mul_smul, hst_z, TensorProduct.tmul_smul]
        calc
          α_Q (TensorProduct.tmul ℤ q₀ w) =
              (q₀ * (d_int : ℚ)) • α_Q (TensorProduct.tmul ℤ q₀ w) := by
            rw [inv_mul_cancel₀ hd_ne, one_smul]
          _ = q₀ • ((d_int : ℚ) • α_Q (TensorProduct.tmul ℤ q₀ w)) := mul_smul _ _ _
          _ = q₀ • ((d_int : ℚ) • t) := by rw [h1, h2]
          _ = (q₀ * (d_int : ℚ)) • t := (mul_smul _ _ _).symm
          _ = t := by rw [inv_mul_cancel₀ hd_ne, one_smul]
      refine ⟨TensorProduct.tmul ℤ q₀ w, ?_⟩
      apply Subtype.ext
      change equiv_M (α_Q (TensorProduct.tmul ℤ q₀ w)) = u.1
      rw [hαQ_eq, equiv_M.apply_symm_apply]
    let equiv_U1 : TensorProduct ℤ ℚ ↥L_F1 ≃+ ↥U₁ :=
      AddEquiv.ofBijective φ_U1 ⟨hφ_U1_inj, hφ_U1_surj⟩
    have hequiv_U1_val : ∀ t : TensorProduct ℤ ℚ ↥L_F1, (equiv_U1 t).1 = equiv_M (α_Q t) :=
      fun _ => rfl
    have hsmul_U1 : ∀ (z : PadicInt ℓ₀) (w₁ w₂ : ↥L_F1),
