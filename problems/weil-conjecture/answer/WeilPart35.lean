            intro d p hp
            rw [p.as_sum, map_sum]
            have hmon : ∀ m ∈ p.support,
                φ (MvPolynomial.monomial m (p.coeff m)) =
                  Localization.mk (MvPolynomial.monomial m (p.coeff m)) (s_pow d) := by
              intro m hm
              have hdeg_m : (m.sum fun _ e => e) = d := by
                have h1 := hp (MvPolynomial.mem_support_iff.mp hm)
                simpa [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul] using h1
              rw [MvPolynomial.monomial_eq, map_mul, hφ_C, Finsupp.prod, map_prod]
              have hprod : (∏ b ∈ m.support, φ (MvPolynomial.X b ^ m b)) =
                  Localization.mk (∏ b ∈ m.support, MvPolynomial.X b ^ m b)
                    (s_pow (∑ b ∈ m.support, m b)) := by
                have hgen : ∀ s : Finset (Fin (N + 1)),
                    (∏ b ∈ s, φ (MvPolynomial.X b ^ m b)) =
                      Localization.mk (∏ b ∈ s, MvPolynomial.X b ^ m b)
                        (s_pow (∑ b ∈ s, m b)) := by
                  intro s
                  induction s using Finset.induction_on with
                  | empty =>
                    simp only [Finset.prod_empty, Finset.sum_empty]
                    have hs0 : s_pow 0 = 1 := Subtype.ext (pow_zero X_a)
                    rw [hs0, Localization.mk_one]
                  | @insert b s hbs ih =>
                    rw [Finset.prod_insert hbs, Finset.prod_insert hbs, Finset.sum_insert hbs,
                      map_pow, hφ_X b, ih, Localization.mk_pow, Localization.mk_mul]
                    congr 1
                    apply Subtype.ext
                    simp [s_pow, pow_add]
                exact hgen m.support
              rw [hprod]
              have hsum_d : (∑ b ∈ m.support, m b) = d := hdeg_m
              have hsub_eq : s_pow (∑ b ∈ m.support, m b) = s_pow d := by
                apply Subtype.ext
                simp [s_pow, hsum_d]
              rw [hsub_eq, Localization.mk_mul, one_mul]
            have hsum_mk : ∀ (s : Finset (Fin (N + 1) →₀ ℕ))
                (f : (Fin (N + 1) →₀ ℕ) → MvPolynomial (Fin (N + 1)) R)
                (y : S_a),
                (∑ m ∈ s, Localization.mk (f m) y) = Localization.mk (∑ m ∈ s, f m) y := by
              intro s f y
              induction s using Finset.induction_on with
              | empty =>
                simp [Localization.mk_zero]
              | @insert m s hms ih =>
                rw [Finset.sum_insert hms, Finset.sum_insert hms, ih, Localization.add_mk_self]
            rw [Finset.sum_congr rfl hmon, hsum_mk, ← p.as_sum]
          rcases Quotient.exists_rep z with ⟨nd, rfl⟩
          rcases nd with ⟨deg, ⟨num, hnum⟩, ⟨den, hden⟩, hden_mem⟩
          have hden_pow : ∃ k : ℕ, X_a ^ k = den := hden_mem
          rcases hden_pow with ⟨k, hk⟩
          have hXa_pow_ne : X_a ^ k ≠ 0 := by
            intro hzero
            have heval := congrArg (MvPolynomial.eval (fun _ => (1 : R))) hzero
            simp [X_a] at heval
          have hdeg_eq : deg = k := by
            have h1 : (X_a ^ k).IsHomogeneous deg := by
              rw [hk]
              exact (MvPolynomial.mem_homogeneousSubmodule deg den).mp hden
            have h2 : (X_a ^ k).IsHomogeneous k := by
              simpa only [one_mul] using (MvPolynomial.isHomogeneous_X R a).pow k
            exact MvPolynomial.IsHomogeneous.inj_right h1 h2 hXa_pow_ne
          subst hdeg_eq
          have hnum_hom : num.IsHomogeneous deg :=
            (MvPolynomial.mem_homogeneousSubmodule deg num).mp hnum
          apply HomogeneousLocalization.val_injective S_a
          let y_den : S_a := ⟨den, hden_mem⟩
          have hz_val : (HomogeneousLocalization.mk ⟨deg, ⟨num, hnum⟩, ⟨den, hden⟩, hden_mem⟩).val =
              Localization.mk num y_den := HomogeneousLocalization.val_mk _
          change valHom (α_loc (β_loc (HomogeneousLocalization.mk _).val)) = _
          rw [hz_val, hβ_loc_mk]
          change φ num = Localization.mk num y_den
          rw [hφ_homog deg num hnum_hom]
          congr 1
          exact Subtype.ext hk
      let e_loc : MvPolynomial (Fin N) R ≃+* HomogeneousLocalization.Away 𝒜 X_a :=
        { α_loc with
          invFun := β
          left_inv := hleft_loc
          right_inv := hright_loc }
      let σ_a : HomogeneousLocalization.Away 𝒜 X_a ≃+*
          ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen R N a))) :=
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 X_a (hX_mem a) zero_lt_one).commRingCatIsoToRingEquiv
      have hσ_hom : σ_a.toRingHom = (AlgebraicGeometry.Proj.awayToSection 𝒜 X_a).hom := rfl
      let θ_a := e_loc.trans σ_a
      refine ⟨θ_a, ?_, ?_⟩
      · apply RingHom.ext
        intro r
        change σ_a.toRingHom (α_loc (MvPolynomial.C r)) = c_R a r
        rw [MvPolynomial.eval₂Hom_C, hσ_hom]
        rfl
      · intro i
        change σ_a.toRingHom (α_loc (MvPolynomial.X i)) = t_R a (a.succAbove i)
        rw [MvPolynomial.eval₂Hom_X', hσ_hom]
        rfl

    let θ_R : ∀ a : Fin (N + 1),
        MvPolynomial (Fin N) R ≃+*
          ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen R N a))) :=
      fun a => (hChartIso a).choose
    have hθ_R : ∀ a : Fin (N + 1),
        (θ_R a).toRingHom.comp MvPolynomial.C = c_R a ∧
        ∀ i : Fin N, θ_R a (MvPolynomial.X i) = t_R a (a.succAbove i) :=
      fun a => (hChartIso a).choose_spec

    
    have hBridge : ∀ (f : MvPolynomial (Fin (N + 1)) R) (hf : f ∈ 𝒜 1),
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 f hf zero_lt_one =
        (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 f hf zero_lt_one).fromSpec := by
      intro f hf
      let U : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 f
      let hU : AlgebraicGeometry.IsAffineOpen U :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 f hf zero_lt_one
      let B_f : CommRingCat.{u} := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)
      have hg_eq : U.toSpecΓ ≫ AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom := by
        rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom]
        let g₁ : U.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
          U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)
        let g₂ : U.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 f
        change g₁ = g₂
        have happ : g₁.appTop = g₂.appTop := by
          dsimp only [g₁, g₂]
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop]
          change (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)).appTop ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom ≫ U.topIso.inv) =
            (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 f).app ⊤
          rw [AlgebraicGeometry.Proj.basicOpenToSpec_app_top]
          have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
            (AlgebraicGeometry.Proj.awayToSection 𝒜 f)
