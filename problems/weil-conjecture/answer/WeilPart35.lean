theorem weil_transv_bockstein_konig_padic_tower_module (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H : ℕ → Type u) [∀ r, AddCommGroup (H r)]
    (τ : ∀ r : ℕ, H (r + 1) →+ H r)
