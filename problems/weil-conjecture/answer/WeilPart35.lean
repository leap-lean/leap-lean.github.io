            (Nat.add_zero p)) (x (b₀ + 1))) hcomp_τ).trans
          ((h_post_comp (τ_map q (b₀ + 1) (b₀ + 2) (Nat.le_succ (b₀ + 1)))
              (τ_map q (a + 1) (b₀ + 1) (Nat.succ_le_succ hb₀)) p (x (b₀ + 1))).symm.trans
            ((congrArg (((CategoryTheory.Abelian.Ext.mk₀
                (τ_map q (a + 1) (b₀ + 1) (Nat.succ_le_succ hb₀))).postcomp Fℤ_D
              (Nat.add_zero p))) (hx b₀)).trans ih))
    exact (h_post_comp (π_ℐ r) (ι_ℐ r) p (x (n₀ + r))).trans
      ((congrArg (fun φ => ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_D
          (Nat.add_zero p)) (x (n₀ + r))) (hAR r).2.1.1).trans
        (h_iter r (n₀ + r) (Nat.le_add_left r n₀)))

  have hq_comm : ∀ (r : ℕ) (y : H_I (r + 1)), t_N r (q_IN (r + 1) y) = q_IN r (t_I r y) := by
    intro r y
    exact (h_post_comp (q_𝒩 (r + 1)) (τ_𝒩 r) p y).trans
      ((congrArg (fun φ => ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_D
          (Nat.add_zero p)) y) (hAR r).2.2.2.1.2).trans
        (h_post_comp (τ_ℐ r) (q_𝒩 r) p y).symm)

  have hq_ker_tor : ∀ (r : ℕ) (y : H_I r), q_IN r y = 0 → (ℓ ^ c) • y = 0 := by
    intro r y hy
    obtain ⟨_, hSE_K⟩ := (hAR r).2.2.2.1.1
    obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_D hSE_K
      (y : CategoryTheory.Abelian.Ext Fℤ_D (ℐ r) p) hy
    let ι_K_H : (𝒦 r).H p →+ H_I r :=
      (CategoryTheory.Abelian.Ext.mk₀ (ι_𝒦 r)).postcomp Fℤ_D (Nat.add_zero p)
    have hz' : ι_K_H z = y := hz
    rw [← hz', ← map_nsmul ι_K_H, h_tor_H (𝒦 r) (hAR r).2.2.1.2.2 p z, map_zero]

  obtain ⟨V_M, hAdd_VM, hMod_VM, hFin_VM, frob_M, equiv_M, hsmul_M, hfrob_M⟩ :=
    weil_sing_dev_ar_padic_rationalization_sandwich ℓ n₀ c H_M H_I H_N
      t_M t_I t_N frobTorsion p_IM s_MI q_IN sys_M sys_N V_N equiv_N
      hTor_HM hTor_HI hTor_HN hfrob_trans hp_comm hs_comm hs_sec hq_comm hq_ker_tor
      hsys_M hsys_N hsmul_N

  let _ : AddCommGroup V_M := hAdd_VM
  let _ : Module (Padic ℓ) V_M := hMod_VM
  let _ : Module.Finite (Padic ℓ) V_M := hFin_VM

  let M_model : WeilTransvTriSheafCohomologyModel F D₀ ℓ p ℳ₀ τ₀ :=
    { hCont_pr := hCont_D
      hAdj_pr := hAdj_D
      ℳ_bar := ℳ_bar
      τ_bar := τ_bar
      iso_bar := fun r => iso_bc q r
      hτ_bar := fun r => h_iso_bc_trans q r
      frobTorsion := frobTorsion
      hfrobTorsion := hfrobTorsion
      V := V_M
      frob := frob_M
      sysSubgroup := sys_M
      hsys := hsys_M
      equiv := equiv_M
      hsmul := hsmul_M
      hfrob := hfrob_M }

  exact ⟨M_model, fun r => hFin_P (ℳ q (r + 1)) (hP_all (r + 1) q) p, hfrob_trans⟩

theorem weil_leray_p1_filt_functorial_godement_step (X S : AlgebraicGeometry.Scheme.{u})
    (f : X ⟶ S)
    (hCont_f : (weilEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology) :
    let 𝒞_X := CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}
    let P_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback f) AddCommGrpCat.{u} _
      S.smallEtaleTopology X.smallEtaleTopology hCont_f
    ∃ (G₀ : 𝒞_X ⥤ 𝒞_X) (η₀ : CategoryTheory.Functor.id 𝒞_X ⟶ G₀),
      (G₀.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits G₀ ∧
        CategoryTheory.Limits.PreservesFiniteColimits G₀) ∧
      (∀ ℱ : 𝒞_X, CategoryTheory.Mono (η₀.app ℱ)) ∧
      (∀ (ℱ : 𝒞_X) (W : X.Etale) (k : ℕ), 1 ≤ k →
        Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf (G₀.obj ℱ) k).obj
          (Opposite.op W))) ∧
      (∀ (ℱ : 𝒞_X) (U : S.Etale) (k : ℕ), 1 ≤ k →
        Subsingleton ↑((CategoryTheory.Sheaf.cohomologyPresheaf (P_f.obj (G₀.obj ℱ)) k).obj
          (Opposite.op U))) :=
by
  intro 𝒞_X P_f

  
  have hAbShortExactOfDesc :
      ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
        [CategoryTheory.Abelian 𝒜]
        {X₁ X₂ X₃ : 𝒜} (f_m : X₁ ⟶ X₂) (g_m : X₂ ⟶ X₃) (h0 : f_m ≫ g_m = 0),
        CategoryTheory.Mono f_m →
        (∀ {D : 𝒜} (u : X₂ ⟶ D), f_m ≫ u = 0 → ∃! v : X₃ ⟶ D, g_m ≫ v = u) →
        (CategoryTheory.ShortComplex.mk f_m g_m h0).ShortExact := by
    intro 𝒜 _ _ X₁ X₂ X₃ f_m g_m h0 hmono hdesc
    have hcok : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ g_m h0) :=
      CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ g_m h0
        (fun {Z'} g' hg' => Classical.choose (hdesc g' hg'))
        (fun {Z'} g' hg' => (Classical.choose_spec (hdesc g' hg')).1)
        (fun {Z'} g' hg' m hm => (Classical.choose_spec (hdesc g' hg')).2 m hm)
    have hex : (CategoryTheory.ShortComplex.mk f_m g_m h0).Exact :=
      CategoryTheory.ShortComplex.exact_of_g_is_cokernel
        (CategoryTheory.ShortComplex.mk f_m g_m h0) hcok
    have hepi : CategoryTheory.Epi g_m := ⟨fun {Z'} v₁ v₂ hv => by
      have hu0 : f_m ≫ (g_m ≫ v₁) = 0 := by
        rw [← CategoryTheory.Category.assoc, h0, CategoryTheory.Limits.zero_comp]
      obtain ⟨v, _, hv_uniq⟩ := hdesc (g_m ≫ v₁) hu0
      exact (hv_uniq v₁ rfl).trans (hv_uniq v₂ hv.symm).symm⟩
    exact { exact := hex, mono_f := hmono, epi_g := hepi }

  
  let ptOf : ∀ (Ω : Type u) [Field Ω], ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
    fun Ω _ => (⟨⊥, inferInstance⟩ : PrimeSpectrum Ω)
  have hPtEq : ∀ (Ω : Type u) [Field Ω] (q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
      q = ptOf Ω := by
    intro Ω _ q
    apply PrimeSpectrum.ext
    ext a
    simp only [ptOf, Ideal.mem_bot]
    refine ⟨fun ha => ?_, fun ha => ha.symm ▸ q.asIdeal.zero_mem⟩
    by_contra hne
    exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal ha (isUnit_iff_ne_zero.mpr hne))

  have hLiftEtale :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (g : Y₁ ⟶ Y₂) [AlgebraicGeometry.Etale g]
        (α : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y₂) (w : ↥Y₁),
        g.base w = α.base (ptOf Ω) →
        ∃ α' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y₁,
          α' ≫ g = α ∧ α'.base (ptOf Ω) = w := by
    intro Ω _ _ Y₁ Y₂ g _ α w hw
    obtain ⟨q₀, hq₀_w, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w (ptOf Ω) hw
    let F_pb := CategoryTheory.Limits.pullback g α
    obtain ⟨V, hV, hq₀_V, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q₀) (U := (⊤ : F_pb.Opens)) trivial
    let B_ring : CommRingCat.{u} := F_pb.presheaf.obj (Opposite.op V)
    have hj_mem : q₀ ∈ Set.range hV.fromSpec.base := by
      rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
      exact hq₀_V
    obtain ⟨𝔭, h𝔭⟩ := hj_mem
    let g_B : AlgebraicGeometry.Spec B_ring ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      hV.fromSpec ≫ CategoryTheory.Limits.pullback.snd g α
    have hEt_gB : AlgebraicGeometry.Etale g_B := inferInstance
    let φ_mor : CommRingCat.of Ω ⟶ B_ring := AlgebraicGeometry.Spec.preimage g_B
    have hφ_map : AlgebraicGeometry.Spec.map φ_mor = g_B := AlgebraicGeometry.Spec.map_preimage g_B
    have hφ_et : RingHom.Etale φ_mor.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hφ_map.symm ▸ hEt_gB)
    let _ : Algebra Ω ↑B_ring := φ_mor.hom.toAlgebra
    have : Algebra.Etale Ω ↑B_ring := (RingHom.etale_algebraMap).mp hφ_et
    let p_spec : PrimeSpectrum ↑B_ring := 𝔭
    have : p_spec.asIdeal.IsPrime := p_spec.isPrime
    let B_loc := Localization.AtPrime p_spec.asIdeal
    let κ_p := p_spec.asIdeal.ResidueField
    have : Algebra.FormallyUnramified ↑B_ring B_loc :=
      Algebra.FormallyUnramified.of_isLocalization p_spec.asIdeal.primeCompl
    have : Algebra.FormallyUnramified Ω B_loc :=
      Algebra.FormallyUnramified.comp Ω ↑B_ring B_loc
    have : Algebra.FormallyUnramified B_loc κ_p :=
      Algebra.FormallyUnramified.of_surjective (Algebra.ofId B_loc κ_p)
        Ideal.Quotient.mk_surjective
    have : Algebra.FormallyUnramified Ω κ_p :=
      Algebra.FormallyUnramified.comp Ω B_loc κ_p
    have : Algebra.EssFiniteType Ω ↑B_ring :=
      Algebra.EssFiniteType.of_finiteType Ω ↑B_ring
    have : Algebra.EssFiniteType ↑B_ring B_loc :=
      Algebra.EssFiniteType.of_isLocalization B_loc p_spec.asIdeal.primeCompl
    have : Algebra.EssFiniteType Ω B_loc :=
      Algebra.EssFiniteType.comp Ω ↑B_ring B_loc
    have : Algebra.EssFiniteType B_loc κ_p :=
      Algebra.EssFiniteType.of_surjective (Algebra.ofId B_loc κ_p) Ideal.Quotient.mk_surjective
    have : Algebra.EssFiniteType Ω κ_p :=
      Algebra.EssFiniteType.comp Ω B_loc κ_p
    have : Algebra.IsSeparable Ω κ_p :=
      Algebra.FormallyUnramified.isSeparable Ω κ_p
    let ψ_res : κ_p →ₐ[Ω] Ω := IsSepClosed.lift
    let ψ_B : ↑B_ring →ₐ[Ω] Ω := ψ_res.comp (IsScalarTower.toAlgHom Ω ↑B_ring κ_p)
    let σ_B : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec B_ring :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B.toRingHom)
    have hcomp_ring : φ_mor ≫ CommRingCat.ofHom ψ_B.toRingHom = 𝟙 (CommRingCat.of Ω) :=
      CommRingCat.hom_ext (RingHom.ext fun c => ψ_B.commutes c)
    have hσ_gB : σ_B ≫ g_B = 𝟙 _ := by
      rw [← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hcomp_ring, AlgebraicGeometry.Spec.map_id]
    have hσ_pt : σ_B.base (ptOf Ω) = 𝔭 := by
      apply PrimeSpectrum.ext
      ext b
      change ψ_B b ∈ (⊥ : Ideal Ω) ↔ b ∈ p_spec.asIdeal
      rw [Ideal.mem_bot]
      change ψ_res (algebraMap ↑B_ring κ_p b) = 0 ↔ b ∈ p_spec.asIdeal
      rw [map_eq_zero_iff ψ_res ψ_res.injective, Ideal.algebraMap_residueField_eq_zero]
    refine ⟨σ_B ≫ hV.fromSpec ≫ CategoryTheory.Limits.pullback.fst g α, ?_, ?_⟩
    · calc
        (σ_B ≫ hV.fromSpec ≫ CategoryTheory.Limits.pullback.fst g α) ≫ g
          = σ_B ≫ hV.fromSpec ≫ (CategoryTheory.Limits.pullback.fst g α ≫ g) := by
            simp only [CategoryTheory.Category.assoc]
        _ = σ_B ≫ hV.fromSpec ≫ (CategoryTheory.Limits.pullback.snd g α ≫ α) := by
            rw [CategoryTheory.Limits.pullback.condition]
        _ = (σ_B ≫ g_B) ≫ α := by simp only [g_B, CategoryTheory.Category.assoc]
        _ = α := by rw [hσ_gB, CategoryTheory.Category.id_comp]
    · change (CategoryTheory.Limits.pullback.fst g α).base (hV.fromSpec.base (σ_B.base (ptOf Ω))) = w
      rw [hσ_pt, h𝔭, hq₀_w]

  have hSieveBridge :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale) (R_sieve : CategoryTheory.Sieve U),
        R_sieve ∈ Z.smallEtaleTopology U ↔
          ∀ z : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).left,
            ∃ (V : Z.Etale) (h : V ⟶ U)
              (w : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj V).left),
              R_sieve.arrows h ∧
              AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget Z).map h).left ∧
              ((AlgebraicGeometry.Scheme.Etale.forget Z).map h).left.base w = z := by
    intro Z U R_sieve
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      ⟨fun f_m g_m hf hg => by
        have : AlgebraicGeometry.Etale f_m := hf
        have : AlgebraicGeometry.Etale g_m := hg
        exact inferInstance⟩
    change R_sieve ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Z U ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) Z le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R_sieve

  have hEtaleOfHom :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Z.Etale} (u : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget Z).map u).left := by
    intro Z U₁ U₂ u
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
    have hw : (Fgt.map u).left ≫ (Fgt.obj U₂).hom = (Fgt.obj U₁).hom := (Fgt.map u).w
    have hU₁ : AlgebraicGeometry.Etale (Fgt.obj U₁).hom := U₁.prop
    have hU₂ : AlgebraicGeometry.Etale (Fgt.obj U₂).hom := U₂.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      (Fgt.map u).left (Fgt.obj U₂).hom hU₂ (hw.symm ▸ hU₁)

  
  let GeomLifts : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω]
      (y_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z) (U : Z.Etale), Type u :=
    fun Z Ω _ y_bar U =>
      { γ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).left //
        CategoryTheory.CategoryStruct.comp γ
          ((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).hom = y_bar }

  let geomLiftMap : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω]
      (y_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z)
      {U₁ U₂ : Z.Etale} (u : U₁ ⟶ U₂),
      GeomLifts Z Ω y_bar U₁ → GeomLifts Z Ω y_bar U₂ :=
    fun Z Ω _ y_bar {_ _} u γ =>
      ⟨CategoryTheory.CategoryStruct.comp γ.1
        ((AlgebraicGeometry.Scheme.Etale.forget Z).map u).left,
       ((CategoryTheory.Category.assoc _ _ _).trans
         (congrArg (CategoryTheory.CategoryStruct.comp γ.1)
           ((AlgebraicGeometry.Scheme.Etale.forget Z).map u).w)).trans γ.2⟩

  have hCoverSieveX :
      ∀ (U : X.Etale) (R_sieve : CategoryTheory.Sieve U),
        (∀ (x : ↥X) (γ : GeomLifts X (weilOrdGodGeomField X x) (weilOrdGodGeomHom X x) U),
          ∃ (V : X.Etale) (h : V ⟶ U)
            (δ : GeomLifts X (weilOrdGodGeomField X x) (weilOrdGodGeomHom X x) V),
            geomLiftMap X (weilOrdGodGeomField X x) (weilOrdGodGeomHom X x) h δ = γ ∧
            R_sieve.arrows h) →
        R_sieve ∈ X.smallEtaleTopology U := by
    intro U R_sieve hcov
    rw [hSieveBridge]
    intro z
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
    let x : ↥X := (Fgt.obj U).hom.base z
    let Ω_x := weilOrdGodGeomField X x
    have hx_pt : (weilOrdGodGeomHom X x).base (ptOf Ω_x) = x :=
      AlgebraicGeometry.Scheme.fromSpecResidueField_apply x _
    have hz_eq : (Fgt.obj U).hom.base z = (weilOrdGodGeomHom X x).base (ptOf Ω_x) := hx_pt.symm
    have : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
    obtain ⟨γ_mor, hγ_fac, hγ_pt⟩ := hLiftEtale Ω_x (Fgt.obj U).hom (weilOrdGodGeomHom X x) z hz_eq
    obtain ⟨V, h, δ, hδ_eq, hhR⟩ := hcov x ⟨γ_mor, hγ_fac⟩
    refine ⟨V, h, δ.1.base (ptOf Ω_x), hhR, hEtaleOfHom h, ?_⟩
    have hcomp : (δ.1 ≫ (Fgt.map h).left).base (ptOf Ω_x) = γ_mor.base (ptOf Ω_x) :=
      congrArg (fun m => m.base (ptOf Ω_x)) (congrArg Subtype.val hδ_eq)
    exact hcomp.trans hγ_pt

  let typeSkyscraper : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω]
      (y_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z) (X_set : Type u),
      CategoryTheory.Functor (Z.Etale)ᵒᵖ (Type u) :=
    fun Z Ω _ y_bar X_set =>
      { obj := fun opU => GeomLifts Z Ω y_bar opU.unop → X_set
        map := fun f_op => TypeCat.ofHom (fun s γ => s (geomLiftMap Z Ω y_bar f_op.unop γ))
        map_id := fun _ => congrArg TypeCat.ofHom (funext fun s => funext fun γ =>
          congrArg s (Subtype.ext (CategoryTheory.Category.comp_id γ.1)))
        map_comp := fun _ _ => congrArg TypeCat.ofHom (funext fun s => funext fun γ =>
          congrArg s (Subtype.ext (CategoryTheory.Category.assoc γ.1 _ _).symm)) }

  have hTypeIsSheaf :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (y_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z) (X_set : Type u),
        CategoryTheory.Presieve.IsSheaf Z.smallEtaleTopology
          (typeSkyscraper Z Ω y_bar X_set) := by
    intro Z Ω _ _ y_bar X_set U R hR x_fam hx_compat
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
    have hLiftR : ∀ γ : GeomLifts Z Ω y_bar U,
        ∃ (V : Z.Etale) (h : V ⟶ U) (_ : R.arrows h) (δ : GeomLifts Z Ω y_bar V),
          geomLiftMap Z Ω y_bar h δ = γ := by
      intro γ
      obtain ⟨V, h, w, hhR, hEt_h, hw_eq⟩ := (hSieveBridge Z U R).mp hR (γ.1.base (ptOf Ω))
      have : AlgebraicGeometry.Etale (Fgt.map h).left := hEt_h
      obtain ⟨δ_V, hδV_fac, _⟩ := hLiftEtale Ω (Fgt.map h).left γ.1 w hw_eq
      have hδV_over : δ_V ≫ (Fgt.obj V).hom = y_bar := by
        rw [← (Fgt.map h).w, ← CategoryTheory.Category.assoc, hδV_fac, γ.2]
      refine ⟨V, h, hhR, ⟨δ_V, hδV_over⟩, Subtype.ext hδV_fac⟩
    have hIndep : ∀ (γ : GeomLifts Z Ω y_bar U)
        {Y₁ Y₂ : Z.Etale} (f₁ : Y₁ ⟶ U) (hf₁ : R.arrows f₁) (δ₁ : GeomLifts Z Ω y_bar Y₁)
        (f₂ : Y₂ ⟶ U) (hf₂ : R.arrows f₂) (δ₂ : GeomLifts Z Ω y_bar Y₂),
        geomLiftMap Z Ω y_bar f₁ δ₁ = γ →
        geomLiftMap Z Ω y_bar f₂ δ₂ = γ →
        x_fam f₁ hf₁ δ₁ = x_fam f₂ hf₂ δ₂ := by
      intro γ Y₁ Y₂ f₁ hf₁ δ₁ f₂ hf₂ δ₂ h₁ h₂
      have : AlgebraicGeometry.Etale (Fgt.map f₂).left := hEtaleOfHom f₂
      have : AlgebraicGeometry.Etale (Fgt.obj Y₁).hom := Y₁.prop
      let fst_pb := CategoryTheory.Limits.pullback.fst (Fgt.map f₁).left (Fgt.map f₂).left
      let snd_pb := CategoryTheory.Limits.pullback.snd (Fgt.map f₁).left (Fgt.map f₂).left
      have hEt_W : AlgebraicGeometry.Etale (fst_pb ≫ (Fgt.obj Y₁).hom) := inferInstance
      let W_et : Z.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_pb ≫ (Fgt.obj Y₁).hom) hEt_W
      let p₁ : W_et ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk fst_pb rfl
      have hp₂_w : snd_pb ≫ (Fgt.obj Y₂).hom = (Fgt.obj W_et).hom := by
        change snd_pb ≫ (Fgt.obj Y₂).hom = fst_pb ≫ (Fgt.obj Y₁).hom
        rw [← (Fgt.map f₂).w, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, (Fgt.map f₁).w]
      let p₂ : W_et ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk snd_pb hp₂_w
      have hp_comm : p₁ ≫ f₁ = p₂ ≫ f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext CategoryTheory.Limits.pullback.condition
          (Subsingleton.elim _ _)
      have hδ_comm : δ₁.1 ≫ (Fgt.map f₁).left = δ₂.1 ≫ (Fgt.map f₂).left :=
        (congrArg Subtype.val h₁).trans (congrArg Subtype.val h₂).symm
      let η_mor := CategoryTheory.Limits.pullback.lift δ₁.1 δ₂.1 hδ_comm
      have hη_over : η_mor ≫ (Fgt.obj W_et).hom = y_bar := by
        change η_mor ≫ (fst_pb ≫ (Fgt.obj Y₁).hom) = y_bar
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, δ₁.2]
      let η : GeomLifts Z Ω y_bar W_et := ⟨η_mor, hη_over⟩
      have hcomp_eq := congrFun (hx_compat p₁ p₂ hf₁ hf₂ hp_comm) η
      have hη₁ : geomLiftMap Z Ω y_bar p₁ η = δ₁ :=
        Subtype.ext (CategoryTheory.Limits.pullback.lift_fst δ₁.1 δ₂.1 hδ_comm)
      have hη₂ : geomLiftMap Z Ω y_bar p₂ η = δ₂ :=
        Subtype.ext (CategoryTheory.Limits.pullback.lift_snd δ₁.1 δ₂.1 hδ_comm)
      change x_fam f₁ hf₁ (geomLiftMap Z Ω y_bar p₁ η) =
        x_fam f₂ hf₂ (geomLiftMap Z Ω y_bar p₂ η) at hcomp_eq
      rwa [hη₁, hη₂] at hcomp_eq
    let s₀ : GeomLifts Z Ω y_bar U → X_set := fun γ =>
      let c₂ := Classical.choose (Classical.choose_spec (hLiftR γ))
      let c₃ := Classical.choose (Classical.choose_spec (Classical.choose_spec (hLiftR γ)))
      let c₄ := Classical.choose
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftR γ))))
      x_fam c₂ c₃ c₄
    refine ⟨s₀, fun Y f_y hf_y => funext fun δ => ?_, fun t ht => funext fun γ => ?_⟩
    · let γ := geomLiftMap Z Ω y_bar f_y δ
      have hc := Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftR γ))))
      change s₀ γ = x_fam f_y hf_y δ
      exact hIndep γ _ _ _ f_y hf_y δ hc rfl
    · obtain ⟨Y, f_y, hf_y, δ, hδ⟩ := hLiftR γ
      have ht_app := congrFun (ht f_y hf_y) δ
      change t (geomLiftMap Z Ω y_bar f_y δ) = x_fam f_y hf_y δ at ht_app
      rw [hδ] at ht_app
      have hc := Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftR γ))))
      exact ht_app.trans (hIndep γ f_y hf_y δ _ _ _ hδ hc)

  
  let singlePre : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω₀ : Type u) [Field Ω₀]
      (y₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z) (N : AddCommGrpCat.{u}),
      CategoryTheory.Functor (Z.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    fun Z Ω₀ _ y₀ N =>
      { obj := fun opU => AddCommGrpCat.of (GeomLifts Z Ω₀ y₀ opU.unop → ↑N)
        map := fun f_op => AddCommGrpCat.ofHom
          { toFun := fun s γ => s (geomLiftMap Z Ω₀ y₀ f_op.unop γ)
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ => AddCommGrpCat.ext fun s => funext fun γ =>
          congrArg s (Subtype.ext (CategoryTheory.Category.comp_id γ.1))
        map_comp := fun _ _ => AddCommGrpCat.ext fun s => funext fun γ =>
          congrArg s (Subtype.ext (CategoryTheory.Category.assoc γ.1 _ _).symm) }

  have hSingleIsSheaf :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
        (y₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z) (N : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (singlePre Z Ω₀ y₀ N) := by
    intro Z Ω₀ _ _ y₀ N E
    let isoE : singlePre Z Ω₀ y₀ N ⋙ CategoryTheory.coyoneda.obj (Opposite.op E) ≅
        typeSkyscraper Z Ω₀ y₀ (E ⟶ N) :=
      CategoryTheory.NatIso.ofComponents
        (fun opU =>
          { hom := TypeCat.ofHom (fun φ γ => AddCommGrpCat.ofHom
              { toFun := fun e => φ.hom e γ
                map_zero' := congrFun (φ.hom.map_zero) γ
                map_add' := fun e₁ e₂ => congrFun (φ.hom.map_add e₁ e₂) γ })
            inv := TypeCat.ofHom (fun ψ => AddCommGrpCat.ofHom
              { toFun := fun e γ => (ψ γ).hom e
                map_zero' := funext fun γ => (ψ γ).hom.map_zero
                map_add' := fun e₁ e₂ => funext fun γ => (ψ γ).hom.map_add e₁ e₂ })
            hom_inv_id := rfl
            inv_hom_id := rfl })
        (fun _ => rfl)
    exact CategoryTheory.Presieve.isSheaf_iso Z.smallEtaleTopology isoE.symm
      (hTypeIsSheaf Z Ω₀ y₀ (E ⟶ N))

  let singlePush : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
      (y₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z),
      AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z Ω₀ _ _ y₀ =>
      { obj := fun N => ⟨singlePre Z Ω₀ y₀ N, hSingleIsSheaf Z Ω₀ y₀ N⟩
        map := fun α =>
          { hom :=
              { app := fun _ => AddCommGrpCat.ofHom
                  { toFun := fun s γ => α.hom (s γ)
                    map_zero' := funext fun _ => α.hom.map_zero
                    map_add' := fun s₁ s₂ => funext fun γ => α.hom.map_add (s₁ γ) (s₂ γ) }
                naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl } }
        map_id := fun _ => CategoryTheory.Sheaf.hom_ext <| NatTrans.ext <| funext fun _ =>
          AddCommGrpCat.ext fun _ => rfl
        map_comp := fun _ _ => CategoryTheory.Sheaf.hom_ext <| NatTrans.ext <| funext fun _ =>
          AddCommGrpCat.ext fun _ => rfl }

  let prodPre : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι : Type u)
      (Ω : ι → Type u) [∀ i, Field (Ω i)]
      (y : ∀ i, AlgebraicGeometry.Spec (CommRingCat.of (Ω i)) ⟶ Z)
      (M : ι → AddCommGrpCat.{u}),
      CategoryTheory.Functor (Z.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    fun Z ι Ω _ y M =>
      { obj := fun opU =>
          AddCommGrpCat.of (∀ i : ι, GeomLifts Z (Ω i) (y i) opU.unop → ↑(M i))
        map := fun f_op => AddCommGrpCat.ofHom
          { toFun := fun s i γ => s i (geomLiftMap Z (Ω i) (y i) f_op.unop γ)
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ => AddCommGrpCat.ext fun s => funext fun i => funext fun γ =>
          congrArg (s i) (Subtype.ext (CategoryTheory.Category.comp_id γ.1))
        map_comp := fun _ _ => AddCommGrpCat.ext fun s => funext fun i => funext fun γ =>
          congrArg (s i) (Subtype.ext (CategoryTheory.Category.assoc γ.1 _ _).symm) }

  have hProdIsSheaf :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι : Type u)
        (Ω : ι → Type u) [∀ i, Field (Ω i)] [∀ i, IsAlgClosed (Ω i)]
        (y : ∀ i, AlgebraicGeometry.Spec (CommRingCat.of (Ω i)) ⟶ Z)
        (M : ι → AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (prodPre Z ι Ω y M) := by
    intro Z ι Ω _ _ y M E
    let piTypePre : (Z.Etale)ᵒᵖ ⥤ Type u :=
      { obj := fun opU => ∀ i : ι, GeomLifts Z (Ω i) (y i) opU.unop → (E ⟶ M i)
        map := fun f_op => TypeCat.ofHom
          (fun s i γ => s i (geomLiftMap Z (Ω i) (y i) f_op.unop γ))
        map_id := fun _ => congrArg TypeCat.ofHom (funext fun s => funext fun i => funext fun γ =>
          congrArg (s i) (Subtype.ext (CategoryTheory.Category.comp_id γ.1)))
        map_comp := fun _ _ => congrArg TypeCat.ofHom (funext fun s => funext fun i => funext fun γ =>
          congrArg (s i) (Subtype.ext (CategoryTheory.Category.assoc γ.1 _ _).symm)) }
    have hPiSheaf : CategoryTheory.Presieve.IsSheaf Z.smallEtaleTopology piTypePre := by
      intro U R hR x_fam hx_compat
      let x_i : ∀ i : ι, R.arrows.FamilyOfElements (typeSkyscraper Z (Ω i) (y i) (E ⟶ M i)) :=
        fun i _ f_y hf_y => x_fam f_y hf_y i
      have hx_i : ∀ i : ι, (x_i i).Compatible := fun i Y₁ Y₂ W_z g₁ g₂ f₁ f₂ hf₁ hf₂ hg =>
        congrFun (hx_compat g₁ g₂ hf₁ hf₂ hg) i
      have hEx_i : ∀ i : ι, ∃! t_i, (x_i i).IsAmalgamation t_i :=
        fun i => hTypeIsSheaf Z (Ω i) (y i) (E ⟶ M i) R hR (x_i i) (hx_i i)
      refine ⟨fun i => Classical.choose (hEx_i i),
        fun Y f_y hf_y => funext fun i => (Classical.choose_spec (hEx_i i)).1 f_y hf_y,
        fun t' ht' => funext fun i =>
          (Classical.choose_spec (hEx_i i)).2 (t' i)
            (fun Y f_y hf_y => congrFun (ht' f_y hf_y) i)⟩
    let isoE : prodPre Z ι Ω y M ⋙ CategoryTheory.coyoneda.obj (Opposite.op E) ≅ piTypePre :=
      CategoryTheory.NatIso.ofComponents
        (fun opU =>
          { hom := TypeCat.ofHom (fun φ i γ => AddCommGrpCat.ofHom
              { toFun := fun e => φ.hom e i γ
                map_zero' := congrFun (congrFun φ.hom.map_zero i) γ
                map_add' := fun e₁ e₂ => congrFun (congrFun (φ.hom.map_add e₁ e₂) i) γ })
            inv := TypeCat.ofHom (fun ψ => AddCommGrpCat.ofHom
              { toFun := fun e i γ => (ψ i γ).hom e
                map_zero' := funext fun i => funext fun γ => (ψ i γ).hom.map_zero
                map_add' := fun e₁ e₂ => funext fun i => funext fun γ =>
                  (ψ i γ).hom.map_add e₁ e₂ })
            hom_inv_id := rfl
            inv_hom_id := rfl })
        (fun _ => rfl)
    exact CategoryTheory.Presieve.isSheaf_iso Z.smallEtaleTopology isoE.symm hPiSheaf

  let prodSheaf : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι : Type u)
      (Ω : ι → Type u) [∀ i, Field (Ω i)] [∀ i, IsAlgClosed (Ω i)]
      (y : ∀ i, AlgebraicGeometry.Spec (CommRingCat.of (Ω i)) ⟶ Z)
      (M : ι → AddCommGrpCat.{u}),
      CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Z ι Ω _ _ y M => ⟨prodPre Z ι Ω y M, hProdIsSheaf Z ι Ω y M⟩

  let prodSheafMap : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (ι : Type u)
      (Ω : ι → Type u) [∀ i, Field (Ω i)] [∀ i, IsAlgClosed (Ω i)]
      (y : ∀ i, AlgebraicGeometry.Spec (CommRingCat.of (Ω i)) ⟶ Z)
      {M₁ M₂ : ι → AddCommGrpCat.{u}} (α : ∀ i : ι, M₁ i ⟶ M₂ i),
      prodSheaf Z ι Ω y M₁ ⟶ prodSheaf Z ι Ω y M₂ :=
    fun Z ι Ω _ _ y {M₁ M₂} α =>
      { hom :=
          { app := fun _ => AddCommGrpCat.ofHom
              { toFun := fun s i γ => (α i).hom (s i γ)
                map_zero' := funext fun i => funext fun _ => (α i).hom.map_zero
                map_add' := fun s₁ s₂ => funext fun i => funext fun γ =>
                  (α i).hom.map_add (s₁ i γ) (s₂ i γ) }
            naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl } }

  
  have hStalkAdjPkg :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
        (y₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z),
        let 𝒞_Z := CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}
        ∃ (Stalk₀ : 𝒞_Z ⥤ AddCommGrpCat.{u})
          (adj₀ : Stalk₀ ⊣ singlePush Z Ω₀ y₀)
          (germ₀ : ∀ (ℱ : 𝒞_Z) (U : Z.Etale),
            GeomLifts Z Ω₀ y₀ U → (ℱ.obj.obj (Opposite.op U) ⟶ Stalk₀.obj ℱ)),
          Stalk₀.Additive ∧
          CategoryTheory.Limits.PreservesFiniteLimits Stalk₀ ∧
          CategoryTheory.Limits.PreservesFiniteColimits Stalk₀ ∧
          (∀ {ℱ₁ ℱ₂ : 𝒞_Z} (φ : ℱ₁ ⟶ ℱ₂) (U : Z.Etale) (γ : GeomLifts Z Ω₀ y₀ U),
            germ₀ ℱ₁ U γ ≫ Stalk₀.map φ =
              φ.hom.app (Opposite.op U) ≫ germ₀ ℱ₂ U γ) ∧
          (∀ (ℱ : 𝒞_Z) {U₁ U₂ : Z.Etale} (u : U₁ ⟶ U₂) (γ : GeomLifts Z Ω₀ y₀ U₁),
            ℱ.obj.map u.op ≫ germ₀ ℱ U₁ γ =
              germ₀ ℱ U₂ (geomLiftMap Z Ω₀ y₀ u γ)) ∧
          (∀ (ℱ : 𝒞_Z) (U : Z.Etale) (γ : GeomLifts Z Ω₀ y₀ U)
            (s : ↑(ℱ.obj.obj (Opposite.op U))),
            (germ₀ ℱ U γ).hom s = 0 →
            ∃ (V : Z.Etale) (h : V ⟶ U) (δ : GeomLifts Z Ω₀ y₀ V),
              geomLiftMap Z Ω₀ y₀ h δ = γ ∧ (ℱ.obj.map h.op).hom s = 0) := by
    intro Z Ω₀ _ _ y₀ 𝒞_Z
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
    let U_aff := weilOrdGodSmallAffSpec Z
    let e_sm := CategoryTheory.equivSmallModel.{u} Z.AffineEtale
    let hFF_Uaff : U_aff.FullyFaithful :=
      e_sm.fullyFaithfulInverse.comp
        (CategoryTheory.Functor.FullyFaithful.ofFullyFaithful
          (AlgebraicGeometry.Scheme.AffineEtale.Spec Z))
    let PtNhd : Type u :=
      Σ (obj : CategoryTheory.SmallModel.{u} Z.AffineEtale),
        GeomLifts Z Ω₀ y₀ (U_aff.obj obj)
    let _ : CategoryTheory.SmallCategory PtNhd :=
      { Hom := fun A B =>
          { hom : A.1 ⟶ B.1 // geomLiftMap Z Ω₀ y₀ (U_aff.map hom) A.2 = B.2 }
        id := fun A =>
          ⟨𝟙 A.1, Subtype.ext (by
            change A.2.1 ≫ (Fgt.map (U_aff.map (𝟙 A.1))).left = A.2.1
            rw [U_aff.map_id, Fgt.map_id]
            exact CategoryTheory.Category.comp_id A.2.1)⟩
        comp := fun {A B C} f₁ f₂ =>
          ⟨f₁.1 ≫ f₂.1, Subtype.ext (by
            change A.2.1 ≫ (Fgt.map (U_aff.map (f₁.1 ≫ f₂.1))).left = C.2.1
            rw [U_aff.map_comp, Fgt.map_comp]
            change A.2.1 ≫ ((Fgt.map (U_aff.map f₁.1)).left ≫
              (Fgt.map (U_aff.map f₂.1)).left) = C.2.1
            rw [← CategoryTheory.Category.assoc]
            have hf₁ : A.2.1 ≫ (Fgt.map (U_aff.map f₁.1)).left = B.2.1 :=
              congrArg Subtype.val f₁.2
            rw [hf₁]
            exact congrArg Subtype.val f₂.2)⟩
        id_comp := fun f => Subtype.ext (CategoryTheory.Category.id_comp f.1)
        comp_id := fun f => Subtype.ext (CategoryTheory.Category.comp_id f.1)
        assoc := fun f g h => Subtype.ext (CategoryTheory.Category.assoc f.1 g.1 h.1) }
    let stalkDiag : PtNhdᵒᵖ ⥤ (Z.Etale)ᵒᵖ :=
      { obj := fun opA => Opposite.op (U_aff.obj opA.unop.1)
        map := fun f => Opposite.op (U_aff.map f.unop.1)
        map_id := fun opA => congrArg Opposite.op (U_aff.map_id opA.unop.1)
        map_comp := fun f g => congrArg Opposite.op (U_aff.map_comp g.unop.1 f.unop.1) }
    have hShrink : ∀ (U : Z.Etale) (γ : GeomLifts Z Ω₀ y₀ U),
        ∃ (i : PtNhdᵒᵖ) (w : (stalkDiag.obj i).unop ⟶ U),
          geomLiftMap Z Ω₀ y₀ w i.unop.2 = γ := by
      intro U γ
      let U_sch := (Fgt.obj U).left
      obtain ⟨V, hV, hpV, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := γ.1.base (ptOf Ω₀)) (U := (⊤ : U_sch.Opens)) trivial
      let R_V : CommRingCat.{u} := U_sch.presheaf.obj (Opposite.op V)
      have hrange : Set.range γ.1.base ⊆ Set.range hV.fromSpec.base := by
        rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
        rintro _ ⟨q, rfl⟩
        rw [hPtEq Ω₀ q]
        exact hpV
      let γ_spec : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ AlgebraicGeometry.Spec R_V :=
        AlgebraicGeometry.IsOpenImmersion.lift hV.fromSpec γ.1 hrange
      have hγ_fac : γ_spec ≫ hV.fromSpec = γ.1 :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hV.fromSpec γ.1 hrange
      have : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
      have hEt_jU : AlgebraicGeometry.Etale (hV.fromSpec ≫ (Fgt.obj U).hom) := inferInstance
      let A_raw : Z.AffineEtale :=
        { toComma :=
            { left := Opposite.op R_V, right := ⟨PUnit.unit⟩, hom := hV.fromSpec ≫ (Fgt.obj U).hom }
          prop := hEt_jU }
      let a₀ : CategoryTheory.SmallModel.{u} Z.AffineEtale := e_sm.functor.obj A_raw
      let iso_a : U_aff.obj a₀ ≅ (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_raw :=
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).mapIso (e_sm.unitIso.symm.app A_raw)
      let w_raw : (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_raw ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk hV.fromSpec rfl
      have hγ_raw : γ_spec ≫
          (Fgt.obj ((AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_raw)).hom = y₀ := by
        change γ_spec ≫ (hV.fromSpec ≫ (Fgt.obj U).hom) = y₀
        rw [← CategoryTheory.Category.assoc, hγ_fac, γ.2]
      let lift_raw :
          GeomLifts Z Ω₀ y₀ ((AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_raw) :=
        ⟨γ_spec, hγ_raw⟩
      let lift_a₀ : GeomLifts Z Ω₀ y₀ (U_aff.obj a₀) :=
        geomLiftMap Z Ω₀ y₀ iso_a.inv lift_raw
      refine ⟨Opposite.op ⟨a₀, lift_a₀⟩, iso_a.hom ≫ w_raw, Subtype.ext ?_⟩
      let j_raw :
          (Fgt.obj ((AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_raw)).left ⟶
            (Fgt.obj U).left := hV.fromSpec
      let γ_raw :
          AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
            (Fgt.obj ((AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_raw)).left := γ_spec
      change (γ_raw ≫ (Fgt.map iso_a.inv).left) ≫ (Fgt.map (iso_a.hom ≫ w_raw)).left = γ.1
      have hiso_left :
          (Fgt.map iso_a.inv).left ≫ (Fgt.map (iso_a.hom ≫ w_raw)).left = j_raw := by
        rw [Fgt.map_comp]
        change (Fgt.map iso_a.inv).left ≫ ((Fgt.map iso_a.hom).left ≫ j_raw) = j_raw
        rw [← CategoryTheory.Category.assoc]
        have hid_iso : (Fgt.map iso_a.inv).left ≫ (Fgt.map iso_a.hom).left = 𝟙 _ := by
          change (Fgt.map iso_a.inv ≫ Fgt.map iso_a.hom).left = 𝟙 _
          rw [← Fgt.map_comp, iso_a.inv_hom_id, Fgt.map_id]
          rfl
        rw [hid_iso, CategoryTheory.Category.id_comp]
      rw [CategoryTheory.Category.assoc, hiso_left]
      exact hγ_fac
    have hRefine : ∀ (U : Z.Etale) (γ : GeomLifts Z Ω₀ y₀ U)
        (i₁ i₂ : PtNhdᵒᵖ)
        (w₁ : (stalkDiag.obj i₁).unop ⟶ U)
        (w₂ : (stalkDiag.obj i₂).unop ⟶ U),
        geomLiftMap Z Ω₀ y₀ w₁ i₁.unop.2 = γ →
        geomLiftMap Z Ω₀ y₀ w₂ i₂.unop.2 = γ →
        ∃ (k : PtNhdᵒᵖ) (f₁ : i₁ ⟶ k) (f₂ : i₂ ⟶ k),
          (stalkDiag.map f₁).unop ≫ w₁ = (stalkDiag.map f₂).unop ≫ w₂ := by
      intro U γ i₁ i₂ w₁ w₂ hw₁ hw₂
      have : AlgebraicGeometry.Etale (Fgt.map w₂).left := hEtaleOfHom w₂
      have : AlgebraicGeometry.Etale (Fgt.obj (U_aff.obj i₁.unop.1)).hom :=
        (U_aff.obj i₁.unop.1).prop
      let fst_w := CategoryTheory.Limits.pullback.fst (Fgt.map w₁).left (Fgt.map w₂).left
      let snd_w := CategoryTheory.Limits.pullback.snd (Fgt.map w₁).left (Fgt.map w₂).left
      have hEt_W : AlgebraicGeometry.Etale (fst_w ≫ (Fgt.obj (U_aff.obj i₁.unop.1)).hom) :=
        inferInstance
      let W_et : Z.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (fst_w ≫ (Fgt.obj (U_aff.obj i₁.unop.1)).hom) hEt_W
      let p₁ : W_et ⟶ U_aff.obj i₁.unop.1 :=
        CategoryTheory.MorphismProperty.Over.homMk fst_w rfl
      have hp₂_w : snd_w ≫ (Fgt.obj (U_aff.obj i₂.unop.1)).hom = (Fgt.obj W_et).hom := by
        change snd_w ≫ (Fgt.obj (U_aff.obj i₂.unop.1)).hom =
          fst_w ≫ (Fgt.obj (U_aff.obj i₁.unop.1)).hom
        rw [← (Fgt.map w₂).w, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, (Fgt.map w₁).w]
