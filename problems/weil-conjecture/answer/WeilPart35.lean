    have hExtSubsingletonOfIsZero : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U X : 𝒜), Limits.IsZero X →
        ∀ (d : ℕ), Subsingleton (Abelian.Ext U X d) := by
      intro 𝒜 _ _ _ U X hX d
      refine Subsingleton.intro fun a b => ?_
      have hid : (1 : ℕ) • CategoryStruct.id X = 0 := by
        rw [one_nsmul]
        exact (Limits.IsZero.iff_id_eq_zero X).mp hX
      have ha := hExtNsmulZero U X hid d a
      have hb := hExtNsmulZero U X hid d b
      rw [one_nsmul] at ha hb
      exact ha.trans hb.symm

    let extIsoEquiv : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U : 𝒜) {X Y : 𝒜} (_ : X ≅ Y) (d : ℕ),
        Abelian.Ext U X d ≃+ Abelian.Ext U Y d :=
      fun {_} _ _ _ U {_ _} e d =>
        { toFun := (Abelian.Ext.mk₀ e.hom).postcomp U (Nat.add_zero d)
          invFun := (Abelian.Ext.mk₀ e.inv).postcomp U (Nat.add_zero d)
          left_inv := fun x => by
            change (x.comp (Abelian.Ext.mk₀ e.hom) (Nat.add_zero d)).comp
              (Abelian.Ext.mk₀ e.inv) (Nat.add_zero d) = x
            rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ e.hom)
              (Abelian.Ext.mk₀ e.inv) (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d),
              Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id, Abelian.Ext.comp_mk₀_id]
          right_inv := fun y => by
            change (y.comp (Abelian.Ext.mk₀ e.inv) (Nat.add_zero d)).comp
              (Abelian.Ext.mk₀ e.hom) (Nat.add_zero d) = y
            rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ e.inv)
              (Abelian.Ext.mk₀ e.hom) (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d),
              Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id, Abelian.Ext.comp_mk₀_id]
          map_add' := map_add _ }

    have hExtPostcompMono : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U : 𝒜) {X Y : 𝒜} (f : X ⟶ Y) [Mono f],
        Function.Injective ((Abelian.Ext.mk₀ f).postcomp U (Nat.add_zero 0)) := by
      intro 𝒜 _ _ _ U X Y f _ x₁ x₂ h
      apply Abelian.Ext.homEquiv₀.injective
      apply (cancel_mono f).mp
      have h1 : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₁ ≫ f) =
          x₁.comp (Abelian.Ext.mk₀ f) (Nat.add_zero 0) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
      have h2 : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₂ ≫ f) =
          x₂.comp (Abelian.Ext.mk₀ f) (Nat.add_zero 0) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
      exact Abelian.Ext.homEquiv₀.symm.injective (h1.trans (h.trans h2.symm))

    have hExtDeltaBijective : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U : 𝒜) {X₁ X₂ X₃ : 𝒜} (u : X₁ ⟶ X₂) (v : X₂ ⟶ X₃)
        (h0 : u ≫ v = 0) (hSE : (ShortComplex.mk u v h0).ShortExact) (k : ℕ),
        Subsingleton (Abelian.Ext U X₂ k) →
        Subsingleton (Abelian.Ext U X₂ (k + 1)) →
        Function.Bijective (hSE.extClass.postcomp U (rfl : k + 1 = k + 1)) := by
      intro 𝒜 _ _ _ U X₁ X₂ X₃ u v h0 hSE k hSub1 hSub2
      refine ⟨fun x₁ x₂ h => ?_, fun y => ?_⟩
      · have hdiff : (hSE.extClass.postcomp U (rfl : k + 1 = k + 1)) (x₁ - x₂) = 0 := by
          rw [map_sub, h, sub_self]
        obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ U hSE (x₁ - x₂)
          (rfl : k + 1 = k + 1) hdiff
        have hw0 : w = 0 := @Subsingleton.elim _ hSub1 w 0
        rw [hw0, Abelian.Ext.zero_comp] at hw
        exact sub_eq_zero.mp hw.symm
      · have hy0 : y.comp (Abelian.Ext.mk₀ u) (Nat.add_zero (k + 1)) = 0 :=
          @Subsingleton.elim _ hSub2 _ 0
        exact Abelian.Ext.covariant_sequence_exact₁ U hSE y hy0 (rfl : k + 1 = k + 1)

    have hExtDeltaZeroExact : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U : 𝒜) {X₁ X₂ X₃ : 𝒜} (u : X₁ ⟶ X₂) (v : X₂ ⟶ X₃)
        (h0 : u ≫ v = 0) (hSE : (ShortComplex.mk u v h0).ShortExact),
        Subsingleton (Abelian.Ext U X₂ 1) →
        Function.Surjective (hSE.extClass.postcomp U (rfl : 0 + 1 = 1)) ∧
        ∀ x : Abelian.Ext U X₃ 0,
          (hSE.extClass.postcomp U (rfl : 0 + 1 = 1)) x = 0 ↔
          ∃ w : Abelian.Ext U X₂ 0,
            ((Abelian.Ext.mk₀ v).postcomp U (Nat.add_zero 0)) w = x := by
      intro 𝒜 _ _ _ U X₁ X₂ X₃ u v h0 hSE hSub1
      refine ⟨fun y => ?_, fun x => ⟨fun hx => ?_, fun ⟨w, hw⟩ => ?_⟩⟩
      · have hy0 : y.comp (Abelian.Ext.mk₀ u) (Nat.add_zero 1) = 0 :=
          @Subsingleton.elim _ hSub1 _ 0
        exact Abelian.Ext.covariant_sequence_exact₁ U hSE y hy0 (rfl : 0 + 1 = 1)
      · exact Abelian.Ext.covariant_sequence_exact₃ U hSE x (rfl : 0 + 1 = 1) hx
      · subst hw
        change (w.comp (Abelian.Ext.mk₀ v) (Nat.add_zero 0)).comp hSE.extClass
          (rfl : 0 + 1 = 1) = 0
        rw [Abelian.Ext.comp_assoc w (Abelian.Ext.mk₀ v) hSE.extClass
          (Nat.add_zero 0) (Nat.zero_add 1) (rfl : 0 + 1 = 1),
          hSE.comp_extClass, Abelian.Ext.comp_zero]

    have hExtPostcompBijective : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U : 𝒜) {X₁ X₂ X₃ : 𝒜} (u : X₁ ⟶ X₂) (v : X₂ ⟶ X₃)
        (h0 : u ≫ v = 0) (hSE : (ShortComplex.mk u v h0).ShortExact) (k : ℕ),
        Subsingleton (Abelian.Ext U X₁ k) →
        Subsingleton (Abelian.Ext U X₁ (k + 1)) →
        Function.Bijective ((Abelian.Ext.mk₀ v).postcomp U (Nat.add_zero k)) := by
      intro 𝒜 _ _ _ U X₁ X₂ X₃ u v h0 hSE k hSub1 hSub2
      refine ⟨fun x₁ x₂ h => ?_, fun y => ?_⟩
      · have hdiff : ((Abelian.Ext.mk₀ v).postcomp U (Nat.add_zero k)) (x₁ - x₂) = 0 := by
          rw [map_sub, h, sub_self]
        obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₂ U hSE (x₁ - x₂) hdiff
        have hw0 : w = 0 := @Subsingleton.elim _ hSub1 w 0
        rw [hw0, Abelian.Ext.zero_comp] at hw
        exact sub_eq_zero.mp hw.symm
      · have hy0 : y.comp hSE.extClass (rfl : k + 1 = k + 1) = 0 :=
          @Subsingleton.elim _ hSub2 _ 0
        exact Abelian.Ext.covariant_sequence_exact₃ U hSE y (rfl : k + 1 = k + 1) hy0

    have hExtPostcompExact₂ : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U : 𝒜) {X₁ X₂ X₃ : 𝒜} (u : X₁ ⟶ X₂) (v : X₂ ⟶ X₃)
        (h0 : u ≫ v = 0) (hSE : (ShortComplex.mk u v h0).ShortExact)
        (k : ℕ) (x : Abelian.Ext U X₂ k),
        ((Abelian.Ext.mk₀ v).postcomp U (Nat.add_zero k)) x = 0 ↔
        ∃ w : Abelian.Ext U X₁ k,
          ((Abelian.Ext.mk₀ u).postcomp U (Nat.add_zero k)) w = x := by
      intro 𝒜 _ _ _ U X₁ X₂ X₃ u v h0 hSE k x
      refine ⟨fun hx => Abelian.Ext.covariant_sequence_exact₂ U hSE x hx,
        fun ⟨w, hw⟩ => ?_⟩
      subst hw
      change (w.comp (Abelian.Ext.mk₀ u) (Nat.add_zero k)).comp
        (Abelian.Ext.mk₀ v) (Nat.add_zero k) = 0
      rw [Abelian.Ext.comp_assoc w (Abelian.Ext.mk₀ u)
        (Abelian.Ext.mk₀ v) (Nat.add_zero k) (Nat.zero_add 0) (Nat.add_zero k),
        Abelian.Ext.mk₀_comp_mk₀, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

    have hExtDeltaNat : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
        [Abelian 𝒜] [HasExt.{u} 𝒜] (U : 𝒜) {X₁ X₂ X₃ Y₁ Y₂ Y₃ : 𝒜}
        (u₁ : X₁ ⟶ X₂) (v₁ : X₂ ⟶ X₃) (h0₁ : u₁ ≫ v₁ = 0)
        (hSE₁ : (ShortComplex.mk u₁ v₁ h0₁).ShortExact)
        (u₂ : Y₁ ⟶ Y₂) (v₂ : Y₂ ⟶ Y₃) (h0₂ : u₂ ≫ v₂ = 0)
        (hSE₂ : (ShortComplex.mk u₂ v₂ h0₂).ShortExact)
        (τ₁ : X₁ ⟶ Y₁) (τ₂ : X₂ ⟶ Y₂) (τ₃ : X₃ ⟶ Y₃),
        u₁ ≫ τ₂ = τ₁ ≫ u₂ → v₁ ≫ τ₃ = τ₂ ≫ v₂ →
        ∀ (k : ℕ) (x : Abelian.Ext U X₃ k),
          ((Abelian.Ext.mk₀ τ₁).postcomp U (Nat.add_zero (k + 1)))
            ((hSE₁.extClass.postcomp U (rfl : k + 1 = k + 1)) x) =
          (hSE₂.extClass.postcomp U (rfl : k + 1 = k + 1))
            (((Abelian.Ext.mk₀ τ₃).postcomp U (Nat.add_zero k)) x) := by
      intro 𝒜 _ _ _ U X₁ X₂ X₃ Y₁ Y₂ Y₃ u₁ v₁ h0₁ hSE₁ u₂ v₂ h0₂ hSE₂ τ₁ τ₂ τ₃ hc₁ hc₂ k x
      let φ : ShortComplex.mk u₁ v₁ h0₁ ⟶ ShortComplex.mk u₂ v₂ h0₂ :=
        { τ₁ := τ₁, τ₂ := τ₂, τ₃ := τ₃, comm₁₂ := hc₁.symm, comm₂₃ := hc₂.symm }
      have hnat := ShortComplex.ShortExact.extClass_naturality hSE₁ hSE₂ φ
      change (x.comp hSE₁.extClass (rfl : k + 1 = k + 1)).comp (Abelian.Ext.mk₀ φ.τ₁)
          (Nat.add_zero (k + 1)) =
        (x.comp (Abelian.Ext.mk₀ φ.τ₃) (Nat.add_zero k)).comp hSE₂.extClass
          (rfl : k + 1 = k + 1)
      rw [Abelian.Ext.comp_assoc x hSE₁.extClass (Abelian.Ext.mk₀ φ.τ₁)
          (rfl : k + 1 = k + 1) (Nat.add_zero 1) (Nat.add_zero (k + 1)),
        hnat,
        ← Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ φ.τ₃) hSE₂.extClass
          (Nat.add_zero k) (Nat.zero_add 1) (rfl : k + 1 = k + 1)]

    let syzygyExt : ∀ (r a : ℕ), Abelian.Ext (Q_Z r a) (Q_Z r 0) a :=
      fun r =>
        Nat.rec (motive := fun a => Abelian.Ext (Q_Z r a) (Q_Z r 0) a)
          (Abelian.Ext.mk₀ (CategoryStruct.id (Q_Z r 0)))
          (fun a prev => (hSE_QZ r a).extClass.comp prev (Nat.one_add a))

    have hSyzygyBijective : ∀ (r a k d : ℕ), 1 ≤ k → (hd : k + a = d) →
        Function.Bijective ((syzygyExt r a).postcomp U_Z hd) := by
      intro r a
      induction a with
      | zero =>
        intro k d _ hd
        have hkd : k = d := by omega
        subst hkd
        have hid : ∀ x : Abelian.Ext U_Z (Q_Z r 0) k,
            ((syzygyExt r 0).postcomp U_Z hd) x = x := fun x => Abelian.Ext.comp_mk₀_id x
        exact ⟨fun x₁ x₂ h => (hid x₁).symm.trans (h.trans (hid x₂)), fun y => ⟨y, hid y⟩⟩
      | succ a ih =>
        intro k d hk hd
        have hd' : (k + 1) + a = d := by omega
        have hcomp : ∀ x : Abelian.Ext U_Z (Q_Z r (a + 1)) k,
            ((syzygyExt r (a + 1)).postcomp U_Z hd) x =
            ((syzygyExt r a).postcomp U_Z hd')
              (((hSE_QZ r a).extClass.postcomp U_Z (rfl : k + 1 = k + 1)) x) := fun x =>
          (Abelian.Ext.comp_assoc x (hSE_QZ r a).extClass
            (syzygyExt r a) (rfl : k + 1 = k + 1) (Nat.one_add a) hd').symm
        have hbij1 := hExtDeltaBijective U_Z (ι_QZ r a) (π_QZ r a) (h0_QZ r a) (hSE_QZ r a) k
          (hAcyc_IZ r a k hk) (hAcyc_IZ r a (k + 1) (by omega))
        have hbij2 := ih (k + 1) d (by omega) hd'
        have hfn_eq : (⇑((syzygyExt r (a + 1)).postcomp U_Z hd)) =
            (⇑((syzygyExt r a).postcomp U_Z hd')) ∘
              (⇑((hSE_QZ r a).extClass.postcomp U_Z (rfl : k + 1 = k + 1))) := funext hcomp
        rw [hfn_eq]
        exact hbij2.comp hbij1

    have hSyzygyTransNat : ∀ (r a : ℕ),
        (syzygyExt (r + 1) a).comp (Abelian.Ext.mk₀ (t_QZ r 0)) (Nat.add_zero a) =
        (Abelian.Ext.mk₀ (t_QZ r a)).comp (syzygyExt r a) (Nat.zero_add a) := by
      intro r a
      induction a with
      | zero =>
        change (Abelian.Ext.mk₀ (CategoryStruct.id (Q_Z (r + 1) 0))).comp
            (Abelian.Ext.mk₀ (t_QZ r 0)) (Nat.add_zero 0) =
          (Abelian.Ext.mk₀ (t_QZ r 0)).comp
            (Abelian.Ext.mk₀ (CategoryStruct.id (Q_Z r 0))) (Nat.zero_add 0)
        rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
          Category.id_comp, Category.comp_id]
      | succ a ih =>
        let φ : ShortComplex.mk (ι_QZ (r + 1) a) (π_QZ (r + 1) a) (h0_QZ (r + 1) a) ⟶
            ShortComplex.mk (ι_QZ r a) (π_QZ r a) (h0_QZ r a) :=
          { τ₁ := t_QZ r a, τ₂ := t_IZ r a, τ₃ := t_QZ r (a + 1),
            comm₁₂ := (hNat_ιQZ r a).symm, comm₂₃ := (hNat_πQZ r a).symm }
        have hnat := ShortComplex.ShortExact.extClass_naturality (hSE_QZ (r + 1) a) (hSE_QZ r a) φ
        change ((hSE_QZ (r + 1) a).extClass.comp (syzygyExt (r + 1) a) (Nat.one_add a)).comp
            (Abelian.Ext.mk₀ (t_QZ r 0)) (Nat.add_zero (a + 1)) =
          (Abelian.Ext.mk₀ (t_QZ r (a + 1))).comp
            ((hSE_QZ r a).extClass.comp (syzygyExt r a) (Nat.one_add a))
            (Nat.zero_add (a + 1))
        rw [Abelian.Ext.comp_assoc (hSE_QZ (r + 1) a).extClass
            (syzygyExt (r + 1) a) (Abelian.Ext.mk₀ (t_QZ r 0))
            (Nat.one_add a) (Nat.add_zero a) (by omega),
          ih,
          ← Abelian.Ext.comp_assoc (hSE_QZ (r + 1) a).extClass
            (Abelian.Ext.mk₀ (t_QZ r a)) (syzygyExt r a)
            (Nat.add_zero 1) (Nat.zero_add a) (by omega),
          hnat,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (t_QZ r (a + 1)))
            (hSE_QZ r a).extClass (syzygyExt r a)
            (Nat.zero_add 1) (Nat.one_add a) (by omega)]

    have hSyzygyFrobNat : ∀ (r a k d : ℕ) (hd : k + a = d) (x : Abelian.Ext U_Z (Q_Z r a) k),
        ((syzygyExt r a).postcomp U_Z hd) (frob_QZ r a k x) =
        frob_QZ r 0 d (((syzygyExt r a).postcomp U_Z hd) x) := by
      intro r a
      induction a with
      | zero =>
        intro k d hd x
        have hkd : k = d := by omega
        subst hkd
        change (frob_QZ r 0 k x).comp (Abelian.Ext.mk₀ (CategoryStruct.id (Q_Z r 0))) hd =
          frob_QZ r 0 k (x.comp (Abelian.Ext.mk₀ (CategoryStruct.id (Q_Z r 0))) hd)
        rw [Abelian.Ext.comp_mk₀_id, Abelian.Ext.comp_mk₀_id]
      | succ a ih =>
        intro k d hd x
        have hd' : (k + 1) + a = d := by omega
        have hstep : ∀ y : Abelian.Ext U_Z (Q_Z r (a + 1)) k,
            ((syzygyExt r (a + 1)).postcomp U_Z hd) y =
              ((syzygyExt r a).postcomp U_Z hd')
                (((hSE_QZ r a).extClass.postcomp U_Z (rfl : k + 1 = k + 1)) y) := fun y =>
          (Abelian.Ext.comp_assoc y (hSE_QZ r a).extClass
            (syzygyExt r a) (rfl : k + 1 = k + 1) (Nat.one_add a) hd').symm
        rw [hstep, hf_QZ_δ r a k x, ih (k + 1) d hd', ← hstep]

    let addHomDescend : ∀ {A B C : Type u}
        [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
        (q : A →+ B), Function.Surjective q → ∀ (f : A →+ C),
        (∀ a : A, q a = 0 → f a = 0) →
        { g : B →+ C // ∀ a : A, g (q a) = f a } :=
      fun {_ _ _} _ _ _ q hq f hker =>
        have h_eq : ∀ a₁ a₂, q a₁ = q a₂ → f a₁ = f a₂ := fun a₁ a₂ h => by
          have h0 : q (a₁ - a₂) = 0 := by rw [map_sub, h, sub_self]
          exact sub_eq_zero.mp (by rw [← map_sub]; exact hker (a₁ - a₂) h0)
        ⟨{ toFun := fun b => f (Classical.choose (hq b))
           map_zero' := (h_eq _ 0 ((Classical.choose_spec (hq 0)).trans (map_zero q).symm)).trans
             (map_zero f)
           map_add' := fun b₁ b₂ => by
             have h1 := Classical.choose_spec (hq b₁)
             have h2 := Classical.choose_spec (hq b₂)
             have h12 := Classical.choose_spec (hq (b₁ + b₂))
             rw [← map_add f]
             exact h_eq _ _ (h12.trans (by rw [map_add, h1, h2])) },
         fun a => h_eq _ a (Classical.choose_spec (hq (q a)))⟩

    have hSub_BD : ∀ (r q : ℕ),
        Subsingleton (Abelian.Ext U_D (B_D r q) 2) ∧
        Subsingleton (Abelian.Ext U_D (B_D r q) 3) := by
      intro r q
      cases q with
      | zero =>
        exact ⟨hExtSubsingletonOfIsZero U_D (B_D r 0) (hB0_zero r) 2,
          hExtSubsingletonOfIsZero U_D (B_D r 0) (hB0_zero r) 3⟩
      | succ q' =>
        refine ⟨Subsingleton.intro fun x₁ x₂ => ?_, Subsingleton.intro fun x₁ x₂ => ?_⟩
        · have hzero : ∀ x : Abelian.Ext U_D (B_D r (q' + 1)) 2, x = 0 := by
            intro x
            have hδ0 : x.comp (hSE_im r q').extClass (rfl : 2 + 1 = 3) = 0 :=
              @Subsingleton.elim _ (hCd_ZD r q').1 _ 0
            obtain ⟨u, hu⟩ := Abelian.Ext.covariant_sequence_exact₃ U_D
              (hSE_im r q') x (rfl : 2 + 1 = 3) hδ0
            have hu0 : u = 0 := @Subsingleton.elim _ (hAcyc_KD r q' 2 (by decide)) u 0
            rw [hu0, Abelian.Ext.zero_comp] at hu
            exact hu.symm
          exact (hzero x₁).trans (hzero x₂).symm
        · have hzero : ∀ x : Abelian.Ext U_D (B_D r (q' + 1)) 3, x = 0 := by
            intro x
            have hδ0 : x.comp (hSE_im r q').extClass (rfl : 3 + 1 = 4) = 0 :=
              @Subsingleton.elim _ (hCd_ZD r q').2 _ 0
            obtain ⟨u, hu⟩ := Abelian.Ext.covariant_sequence_exact₃ U_D
              (hSE_im r q') x (rfl : 3 + 1 = 4) hδ0
            have hu0 : u = 0 := @Subsingleton.elim _ (hAcyc_KD r q' 3 (by decide)) u 0
            rw [hu0, Abelian.Ext.zero_comp] at hu
            exact hu.symm
          exact (hzero x₁).trans (hzero x₂).symm

    let F1 := fun r => Abelian.Ext U_D (Z_D r (2 * m + 1)) 1
    let t_F1 := fun r => (Abelian.Ext.mk₀ (t_ZD r (2 * m + 1))).postcomp U_D (Nat.add_zero 1)
    let frob_F1 := fun r => frob_ZD r (2 * m + 1) 1

    let e_M : ∀ r : ℕ, Abelian.Ext U_Z (Q_Z r 0) (2 * m + 2) ≃+
        Abelian.Ext U_Z (M_sh r) (2 * m + 2) :=
      fun r => extIsoEquiv U_Z (iso_M r) (2 * m + 2)
    have h1_add_2m1 : 1 + (2 * m + 1) = 2 * m + 2 := Nat.one_add (2 * m + 1)
    let shift_Z_hom : ∀ r : ℕ, Abelian.Ext U_Z (Q_Z r (2 * m + 1)) 1 →+
        Abelian.Ext U_Z (Q_Z r 0) (2 * m + 2) :=
      fun r => (syzygyExt r (2 * m + 1)).postcomp U_Z h1_add_2m1
    have hShift_bij : ∀ r : ℕ, Function.Bijective (shift_Z_hom r) :=
      fun r => hSyzygyBijective r (2 * m + 1) 1 (2 * m + 2) (le_refl 1) h1_add_2m1
    let Θ_Z : ∀ r : ℕ, Abelian.Ext U_Z (Q_Z r (2 * m + 1)) 1 ≃+
        Abelian.Ext U_Z (M_sh r) (2 * m + 2) :=
      fun r => (AddEquiv.ofBijective (shift_Z_hom r) (hShift_bij r)).trans (e_M r)

    let δ_Z0 : ∀ r : ℕ, Abelian.Ext U_Z (Q_Z r (2 * m + 2)) 0 →+
        Abelian.Ext U_Z (Q_Z r (2 * m + 1)) 1 :=
      fun r => (hSE_QZ r (2 * m + 1)).extClass.postcomp U_Z (rfl : 0 + 1 = 1)
    have hδ_Z0_ex : ∀ r : ℕ,
        Function.Surjective (δ_Z0 r) ∧
        ∀ x : Abelian.Ext U_Z (Q_Z r (2 * m + 2)) 0,
          δ_Z0 r x = 0 ↔
          ∃ w : Abelian.Ext U_Z (I_Z r (2 * m + 1)) 0,
            ((Abelian.Ext.mk₀ (π_QZ r (2 * m + 1))).postcomp U_Z (Nat.add_zero 0)) w = x :=
      fun r => hExtDeltaZeroExact U_Z (ι_QZ r (2 * m + 1)) (π_QZ r (2 * m + 1))
        (h0_QZ r (2 * m + 1)) (hSE_QZ r (2 * m + 1)) (hAcyc_IZ r (2 * m + 1) 1 (le_refl 1))

    let q_tot : ∀ r : ℕ, Abelian.Ext U_D (Z_D r (2 * m + 2)) 0 →+
        Abelian.Ext U_Z (M_sh r) (2 * m + 2) :=
      fun r => (Θ_Z r).toAddMonoidHom.comp ((δ_Z0 r).comp (e_Q0 r).toAddMonoidHom)
    have hq_tot_surj : ∀ r : ℕ, Function.Surjective (q_tot r) :=
      fun r => (Θ_Z r).surjective.comp ((hδ_Z0_ex r).1.comp (e_Q0 r).surjective)

    let j_BD0_hom := fun r : ℕ =>
      (Abelian.Ext.mk₀ (j_BD r (2 * m + 2))).postcomp U_D (Nat.add_zero 0)
    let d_KD0_hom := fun r : ℕ =>
      (Abelian.Ext.mk₀ (d_KD r (2 * m + 1))).postcomp U_D (Nat.add_zero 0)
    let π_HD0_hom := fun r : ℕ =>
      (Abelian.Ext.mk₀ (π_HD r (2 * m + 2))).postcomp U_D (Nat.add_zero 0)

    have hj_BD0_inj : ∀ r : ℕ, Function.Injective (j_BD0_hom r) := by
      intro r
      have : Mono (j_BD r (2 * m + 2)) := (hSE_coh r (2 * m + 2)).mono_f
      exact hExtPostcompMono U_D (j_BD r (2 * m + 2))

    have hq_tot_ker : ∀ (r : ℕ) (z : Abelian.Ext U_D (Z_D r (2 * m + 2)) 0),
        q_tot r z = 0 ↔ ∃ x : Abelian.Ext U_D (K_D r (2 * m + 1)) 0,
          j_BD0_hom r (d_KD0_hom r x) = z := by
      intro r z
      have h1 : q_tot r z = 0 ↔ δ_Z0 r (e_Q0 r z) = 0 :=
        ⟨fun h => (Θ_Z r).injective (h.trans (map_zero (Θ_Z r)).symm),
         fun h => (congrArg (Θ_Z r) h).trans (map_zero (Θ_Z r))⟩
      refine (h1.trans ((hδ_Z0_ex r).2 (e_Q0 r z))).trans ⟨fun ⟨w, hw⟩ => ?_, fun ⟨x, hx⟩ => ?_⟩
      · refine ⟨(e_K0 r).symm w, (e_Q0 r).injective ?_⟩
        have hcomp := hExtPostcompComp U_D (d_KD r (2 * m + 1)) (j_BD r (2 * m + 2)) 0
          ((e_K0 r).symm w)
        exact (congrArg (e_Q0 r) hcomp).trans
          ((he_dj_π r ((e_K0 r).symm w)).trans
            ((congrArg ((Abelian.Ext.mk₀ (π_QZ r (2 * m + 1))).postcomp U_Z (Nat.add_zero 0))
              ((e_K0 r).apply_symm_apply w)).trans hw))
      · refine ⟨e_K0 r x, ?_⟩
        have hcomp := hExtPostcompComp U_D (d_KD r (2 * m + 1)) (j_BD r (2 * m + 2)) 0 x
        exact (he_dj_π r x).symm.trans (congrArg (e_Q0 r) (hcomp.symm.trans hx))

    let e_E0 : ∀ r : ℕ, Abelian.Ext U_D (H_D r (2 * m + 2)) 0 ≃+ Abelian.Ext U_D (E0_sh r) 0 :=
      fun r => extIsoEquiv U_D (iso_E0 r) 0
    let ψ₀_hom : ∀ r : ℕ, Abelian.Ext U_D (Z_D r (2 * m + 2)) 0 →+ Abelian.Ext U_D (E0_sh r) 0 :=
      fun r => (e_E0 r).toAddMonoidHom.comp (π_HD0_hom r)

    have hψ₀_ker : ∀ (r : ℕ) (z : Abelian.Ext U_D (Z_D r (2 * m + 2)) 0),
        q_tot r z = 0 → ψ₀_hom r z = 0 := by
      intro r z hz
      obtain ⟨x, hx⟩ := (hq_tot_ker r z).mp hz
      have hπ0 : π_HD0_hom r z = 0 :=
        (hExtPostcompExact₂ U_D (j_BD r (2 * m + 2)) (π_HD r (2 * m + 2))
          (h0_coh r (2 * m + 2)) (hSE_coh r (2 * m + 2)) 0 z).mpr ⟨d_KD0_hom r x, hx⟩
      exact (congrArg (e_E0 r) hπ0).trans (map_zero (e_E0 r))

    let β_pack := fun r : ℕ => addHomDescend (q_tot r) (hq_tot_surj r) (ψ₀_hom r) (hψ₀_ker r)
    let β : ∀ r : ℕ, Abelian.Ext U_Z (M_sh r) (2 * m + 2) →+ Abelian.Ext U_D (E0_sh r) 0 :=
      fun r => (β_pack r).1
    have hβ_spec : ∀ (r : ℕ) (z : Abelian.Ext U_D (Z_D r (2 * m + 2)) 0),
        β r (q_tot r z) = ψ₀_hom r z := fun r => (β_pack r).2

    let δ_D0 : ∀ r : ℕ, Abelian.Ext U_D (B_D r (2 * m + 2)) 0 →+ F1 r :=
      fun r => (hSE_im r (2 * m + 1)).extClass.postcomp U_D (rfl : 0 + 1 = 1)
    have hδ_D0_ex : ∀ r : ℕ,
        Function.Surjective (δ_D0 r) ∧
        ∀ b : Abelian.Ext U_D (B_D r (2 * m + 2)) 0,
          δ_D0 r b = 0 ↔ ∃ x : Abelian.Ext U_D (K_D r (2 * m + 1)) 0, d_KD0_hom r x = b :=
      fun r => hExtDeltaZeroExact U_D (ι_ZD r (2 * m + 1)) (d_KD r (2 * m + 1))
        (h0_im r (2 * m + 1)) (hSE_im r (2 * m + 1)) (hAcyc_KD r (2 * m + 1) 1 (le_refl 1))

    let α_tilde : ∀ r : ℕ, Abelian.Ext U_D (B_D r (2 * m + 2)) 0 →+
        Abelian.Ext U_Z (M_sh r) (2 * m + 2) :=
      fun r => (q_tot r).comp (j_BD0_hom r)

    have hα_tilde_iff : ∀ (r : ℕ) (b : Abelian.Ext U_D (B_D r (2 * m + 2)) 0),
        α_tilde r b = 0 ↔ δ_D0 r b = 0 := by
      intro r b
      exact ((hq_tot_ker r (j_BD0_hom r b)).trans
        ⟨fun ⟨x, hx⟩ => ⟨x, hj_BD0_inj r hx⟩,
         fun ⟨x, hx⟩ => ⟨x, congrArg (j_BD0_hom r) hx⟩⟩).trans ((hδ_D0_ex r).2 b).symm

    let α_pack := fun r : ℕ => addHomDescend (δ_D0 r) (hδ_D0_ex r).1 (α_tilde r)
      (fun b hb => (hα_tilde_iff r b).mpr hb)
    let α : ∀ r : ℕ, F1 r →+ Abelian.Ext U_Z (M_sh r) (2 * m + 2) := fun r => (α_pack r).1
    have hα_spec : ∀ (r : ℕ) (b : Abelian.Ext U_D (B_D r (2 * m + 2)) 0),
        α r (δ_D0 r b) = q_tot r (j_BD0_hom r b) := fun r => (α_pack r).2

    let e_E2 : ∀ r : ℕ, Abelian.Ext U_D (H_D r (2 * m)) 2 ≃+ Abelian.Ext U_D (E2_sh r) 2 :=
      fun r => extIsoEquiv U_D (iso_E2 r) 2
    let e_E1 : ∀ r : ℕ, Abelian.Ext U_D (H_D r (2 * m + 1)) 1 ≃+ Abelian.Ext U_D (E1_sh r) 1 :=
      fun r => extIsoEquiv U_D (iso_E1 r) 1

    let π_HD2_hom := fun r : ℕ =>
      (Abelian.Ext.mk₀ (π_HD r (2 * m))).postcomp U_D (Nat.add_zero 2)
    have hπ_HD2_bij : ∀ r : ℕ, Function.Bijective (π_HD2_hom r) :=
      fun r => hExtPostcompBijective U_D (j_BD r (2 * m)) (π_HD r (2 * m))
        (h0_coh r (2 * m)) (hSE_coh r (2 * m)) 2 (hSub_BD r (2 * m)).1 (hSub_BD r (2 * m)).2
    let e_π2 : ∀ r : ℕ, Abelian.Ext U_D (Z_D r (2 * m)) 2 ≃+ Abelian.Ext U_D (H_D r (2 * m)) 2 :=
      fun r => AddEquiv.ofBijective (π_HD2_hom r) (hπ_HD2_bij r)

    let δ_D1 : ∀ r : ℕ, Abelian.Ext U_D (B_D r (2 * m + 1)) 1 →+
        Abelian.Ext U_D (Z_D r (2 * m)) 2 :=
      fun r => (hSE_im r (2 * m)).extClass.postcomp U_D (rfl : 1 + 1 = 2)
    have hδ_D1_bij : ∀ r : ℕ, Function.Bijective (δ_D1 r) :=
      fun r => hExtDeltaBijective U_D (ι_ZD r (2 * m)) (d_KD r (2 * m))
        (h0_im r (2 * m)) (hSE_im r (2 * m)) 1
        (hAcyc_KD r (2 * m) 1 (le_refl 1)) (hAcyc_KD r (2 * m) 2 (by decide))
    let e_δ1 : ∀ r : ℕ, Abelian.Ext U_D (B_D r (2 * m + 1)) 1 ≃+
        Abelian.Ext U_D (Z_D r (2 * m)) 2 :=
      fun r => AddEquiv.ofBijective (δ_D1 r) (hδ_D1_bij r)

    let e_II : ∀ r : ℕ, Abelian.Ext U_D (E2_sh r) 2 ≃+
        Abelian.Ext U_D (B_D r (2 * m + 1)) 1 :=
      fun r => ((e_E2 r).symm.trans (e_π2 r).symm).trans (e_δ1 r).symm
    let j_BD1_hom := fun r : ℕ =>
      (Abelian.Ext.mk₀ (j_BD r (2 * m + 1))).postcomp U_D (Nat.add_zero 1)
    let π_HD1_hom := fun r : ℕ =>
      (Abelian.Ext.mk₀ (π_HD r (2 * m + 1))).postcomp U_D (Nat.add_zero 1)

    let γ_map : ∀ r : ℕ, Abelian.Ext U_D (E2_sh r) 2 →+ F1 r :=
      fun r => (j_BD1_hom r).comp (e_II r).toAddMonoidHom
    let ε_map : ∀ r : ℕ, F1 r →+ Abelian.Ext U_D (E1_sh r) 1 :=
      fun r => (e_E1 r).toAddMonoidHom.comp (π_HD1_hom r)

    have hChaseIntertwine : ∀ (r₁ r₂ : ℕ)
        (T_M : Abelian.Ext U_Z (M_sh r₁) (2 * m + 2) →+ Abelian.Ext U_Z (M_sh r₂) (2 * m + 2))
        (T_E2 : Abelian.Ext U_D (E2_sh r₁) 2 →+ Abelian.Ext U_D (E2_sh r₂) 2)
        (T_E1 : Abelian.Ext U_D (E1_sh r₁) 1 →+ Abelian.Ext U_D (E1_sh r₂) 1)
        (T_E0 : Abelian.Ext U_D (E0_sh r₁) 0 →+ Abelian.Ext U_D (E0_sh r₂) 0)
        (T_F1 : F1 r₁ →+ F1 r₂)
        (T_QZ0 : Abelian.Ext U_Z (Q_Z r₁ (2 * m + 2)) 0 →+
          Abelian.Ext U_Z (Q_Z r₂ (2 * m + 2)) 0)
        (T_QZ1 : Abelian.Ext U_Z (Q_Z r₁ (2 * m + 1)) 1 →+
          Abelian.Ext U_Z (Q_Z r₂ (2 * m + 1)) 1)
        (T_ZD2m : Abelian.Ext U_D (Z_D r₁ (2 * m)) 2 →+ Abelian.Ext U_D (Z_D r₂ (2 * m)) 2)
        (T_BD2m1 : Abelian.Ext U_D (B_D r₁ (2 * m + 1)) 1 →+
          Abelian.Ext U_D (B_D r₂ (2 * m + 1)) 1)
        (T_HD2m : Abelian.Ext U_D (H_D r₁ (2 * m)) 2 →+ Abelian.Ext U_D (H_D r₂ (2 * m)) 2)
        (T_HD2m1 : Abelian.Ext U_D (H_D r₁ (2 * m + 1)) 1 →+
          Abelian.Ext U_D (H_D r₂ (2 * m + 1)) 1)
        (T_BD2m2 : Abelian.Ext U_D (B_D r₁ (2 * m + 2)) 0 →+
          Abelian.Ext U_D (B_D r₂ (2 * m + 2)) 0)
        (T_ZD2m2 : Abelian.Ext U_D (Z_D r₁ (2 * m + 2)) 0 →+
          Abelian.Ext U_D (Z_D r₂ (2 * m + 2)) 0)
        (T_HD2m2 : Abelian.Ext U_D (H_D r₁ (2 * m + 2)) 0 →+
          Abelian.Ext U_D (H_D r₂ (2 * m + 2)) 0),
        (∀ x, T_M (Θ_Z r₁ x) = Θ_Z r₂ (T_QZ1 x)) →
        (∀ x, T_QZ1 (δ_Z0 r₁ x) = δ_Z0 r₂ (T_QZ0 x)) →
        (∀ z, T_QZ0 (e_Q0 r₁ z) = e_Q0 r₂ (T_ZD2m2 z)) →
        (∀ b, T_ZD2m2 (j_BD0_hom r₁ b) = j_BD0_hom r₂ (T_BD2m2 b)) →
        (∀ b, T_F1 (δ_D0 r₁ b) = δ_D0 r₂ (T_BD2m2 b)) →
        (∀ z, T_HD2m2 (π_HD0_hom r₁ z) = π_HD0_hom r₂ (T_ZD2m2 z)) →
        (∀ x, T_E0 (e_E0 r₁ x) = e_E0 r₂ (T_HD2m2 x)) →
        (∀ x, T_E2 (e_E2 r₁ x) = e_E2 r₂ (T_HD2m x)) →
        (∀ x, T_HD2m (π_HD2_hom r₁ x) = π_HD2_hom r₂ (T_ZD2m x)) →
        (∀ x, T_ZD2m (δ_D1 r₁ x) = δ_D1 r₂ (T_BD2m1 x)) →
        (∀ x, T_F1 (j_BD1_hom r₁ x) = j_BD1_hom r₂ (T_BD2m1 x)) →
        (∀ w, T_HD2m1 (π_HD1_hom r₁ w) = π_HD1_hom r₂ (T_F1 w)) →
        (∀ x, T_E1 (e_E1 r₁ x) = e_E1 r₂ (T_HD2m1 x)) →
        (∀ w, T_M (α r₁ w) = α r₂ (T_F1 w)) ∧
        (∀ y, T_E0 (β r₁ y) = β r₂ (T_M y)) ∧
        (∀ x, T_F1 (γ_map r₁ x) = γ_map r₂ (T_E2 x)) ∧
        (∀ w, T_E1 (ε_map r₁ w) = ε_map r₂ (T_F1 w)) := by
      intro r₁ r₂ T_M T_E2 T_E1 T_E0 T_F1 T_QZ0 T_QZ1 T_ZD2m T_BD2m1 T_HD2m T_HD2m1
        T_BD2m2 T_ZD2m2 T_HD2m2
        hΘ hδZ0 heQ0 hjBD0 hδD0 hπHD0 heE0 heE2 hπHD2 hδD1 hjBD1 hπHD1 heE1
      have hq_comm : ∀ z, T_M (q_tot r₁ z) = q_tot r₂ (T_ZD2m2 z) := fun z =>
        (hΘ (δ_Z0 r₁ (e_Q0 r₁ z))).trans
          (congrArg (Θ_Z r₂) ((hδZ0 (e_Q0 r₁ z)).trans (congrArg (δ_Z0 r₂) (heQ0 z))))
      refine ⟨fun w => ?_, fun y => ?_, fun x => ?_, fun w => ?_⟩
      · obtain ⟨b, rfl⟩ := (hδ_D0_ex r₁).1 w
        exact (congrArg T_M (hα_spec r₁ b)).trans
          ((hq_comm (j_BD0_hom r₁ b)).trans
            ((congrArg (q_tot r₂) (hjBD0 b)).trans
              ((hα_spec r₂ (T_BD2m2 b)).symm.trans (congrArg (α r₂) (hδD0 b)).symm)))
      · obtain ⟨z, rfl⟩ := hq_tot_surj r₁ y
        exact (congrArg T_E0 (hβ_spec r₁ z)).trans
          ((heE0 (π_HD0_hom r₁ z)).trans
            ((congrArg (e_E0 r₂) (hπHD0 z)).trans
              ((hβ_spec r₂ (T_ZD2m2 z)).symm.trans (congrArg (β r₂) (hq_comm z).symm))))
      · have heE2_symm : ∀ u, (e_E2 r₂).symm (T_E2 u) = T_HD2m ((e_E2 r₁).symm u) := fun u =>
          (e_E2 r₂).injective
            (((e_E2 r₂).apply_symm_apply _).trans
              ((congrArg T_E2 ((e_E2 r₁).apply_symm_apply u).symm).trans
                (heE2 ((e_E2 r₁).symm u))))
        have heπ2_symm : ∀ u, (e_π2 r₂).symm (T_HD2m u) = T_ZD2m ((e_π2 r₁).symm u) := fun u =>
          (e_π2 r₂).injective
            (((e_π2 r₂).apply_symm_apply _).trans
              ((congrArg T_HD2m ((e_π2 r₁).apply_symm_apply u).symm).trans
                (hπHD2 ((e_π2 r₁).symm u))))
        have heδ1_symm : ∀ u, (e_δ1 r₂).symm (T_ZD2m u) = T_BD2m1 ((e_δ1 r₁).symm u) := fun u =>
          (e_δ1 r₂).injective
            (((e_δ1 r₂).apply_symm_apply _).trans
              ((congrArg T_ZD2m ((e_δ1 r₁).apply_symm_apply u).symm).trans
                (hδD1 ((e_δ1 r₁).symm u))))
        exact (hjBD1 ((e_II r₁) x)).trans
          (congrArg (j_BD1_hom r₂)
            ((heδ1_symm _).symm.trans
              ((congrArg (e_δ1 r₂).symm (heπ2_symm _).symm).trans
                (congrArg (fun v => (e_δ1 r₂).symm ((e_π2 r₂).symm v)) (heE2_symm x).symm))))
      · exact (heE1 (π_HD1_hom r₁ w)).trans (congrArg (e_E1 r₂) (hπHD1 w))

    have hTransAll : ∀ r : ℕ,
        (∀ w, t_M r (α (r + 1) w) = α r (t_F1 r w)) ∧
        (∀ y, ((Abelian.Ext.mk₀ (τ_E0 r)).postcomp U_D (Nat.add_zero 0)) (β (r + 1) y) =
          β r (t_M r y)) ∧
        (∀ x, t_F1 r (γ_map (r + 1) x) =
          γ_map r (((Abelian.Ext.mk₀ (τ_E2 r)).postcomp U_D (Nat.add_zero 2)) x)) ∧
        (∀ w, ((Abelian.Ext.mk₀ (τ_E1 r)).postcomp U_D (Nat.add_zero 1)) (ε_map (r + 1) w) =
          ε_map r (t_F1 r w)) := by
      intro r
      apply hChaseIntertwine (r + 1) r
        (t_M r)
        ((Abelian.Ext.mk₀ (τ_E2 r)).postcomp U_D (Nat.add_zero 2))
        ((Abelian.Ext.mk₀ (τ_E1 r)).postcomp U_D (Nat.add_zero 1))
        ((Abelian.Ext.mk₀ (τ_E0 r)).postcomp U_D (Nat.add_zero 0))
        (t_F1 r)
        ((Abelian.Ext.mk₀ (t_QZ r (2 * m + 2))).postcomp U_Z (Nat.add_zero 0))
        ((Abelian.Ext.mk₀ (t_QZ r (2 * m + 1))).postcomp U_Z (Nat.add_zero 1))
        ((Abelian.Ext.mk₀ (t_ZD r (2 * m))).postcomp U_D (Nat.add_zero 2))
        ((Abelian.Ext.mk₀ (t_BD r (2 * m + 1))).postcomp U_D (Nat.add_zero 1))
        ((Abelian.Ext.mk₀ (t_HD r (2 * m))).postcomp U_D (Nat.add_zero 2))
        ((Abelian.Ext.mk₀ (t_HD r (2 * m + 1))).postcomp U_D (Nat.add_zero 1))
        ((Abelian.Ext.mk₀ (t_BD r (2 * m + 2))).postcomp U_D (Nat.add_zero 0))
        ((Abelian.Ext.mk₀ (t_ZD r (2 * m + 2))).postcomp U_D (Nat.add_zero 0))
        ((Abelian.Ext.mk₀ (t_HD r (2 * m + 2))).postcomp U_D (Nat.add_zero 0))
      · intro x
        have hsyz_nat := hSyzygyTransNat r (2 * m + 1)
        have hshift_comm :
            ((Abelian.Ext.mk₀ (t_QZ r 0)).postcomp U_Z (Nat.add_zero (2 * m + 2)))
              (shift_Z_hom (r + 1) x) =
            shift_Z_hom r
              (((Abelian.Ext.mk₀ (t_QZ r (2 * m + 1))).postcomp U_Z (Nat.add_zero 1)) x) := by
          change (x.comp (syzygyExt (r + 1) (2 * m + 1)) h1_add_2m1).comp
              (Abelian.Ext.mk₀ (t_QZ r 0)) (Nat.add_zero (2 * m + 2)) =
            (x.comp (Abelian.Ext.mk₀ (t_QZ r (2 * m + 1))) (Nat.add_zero 1)).comp
              (syzygyExt r (2 * m + 1)) h1_add_2m1
          rw [Abelian.Ext.comp_assoc x _ (Abelian.Ext.mk₀ (t_QZ r 0))
              h1_add_2m1 (Nat.add_zero (2 * m + 1)) (by omega),
            hsyz_nat,
            ← Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ (t_QZ r (2 * m + 1))) _
              (Nat.add_zero 1) (Nat.zero_add (2 * m + 1)) (by omega)]
        exact (ht_M r (shift_Z_hom (r + 1) x)).trans (congrArg (e_M r) hshift_comm)
      · exact hExtDeltaNat U_Z (ι_QZ (r + 1) (2 * m + 1)) (π_QZ (r + 1) (2 * m + 1))
          (h0_QZ (r + 1) (2 * m + 1)) (hSE_QZ (r + 1) (2 * m + 1))
          (ι_QZ r (2 * m + 1)) (π_QZ r (2 * m + 1)) (h0_QZ r (2 * m + 1)) (hSE_QZ r (2 * m + 1))
          (t_QZ r (2 * m + 1)) (t_IZ r (2 * m + 1)) (t_QZ r (2 * m + 2))
          (hNat_ιQZ r (2 * m + 1)) (hNat_πQZ r (2 * m + 1)) 0
      · exact fun z => (he_Q0_trans r z).symm
      · exact fun b => (hExtPostcompComp U_D _ _ 0 b).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 0)) b)
            (hNat_jBD r (2 * m + 2))).trans (hExtPostcompComp U_D _ _ 0 b).symm)
      · exact hExtDeltaNat U_D (ι_ZD (r + 1) (2 * m + 1)) (d_KD (r + 1) (2 * m + 1))
          (h0_im (r + 1) (2 * m + 1)) (hSE_im (r + 1) (2 * m + 1))
          (ι_ZD r (2 * m + 1)) (d_KD r (2 * m + 1)) (h0_im r (2 * m + 1)) (hSE_im r (2 * m + 1))
          (t_ZD r (2 * m + 1)) (t_KD r (2 * m + 1)) (t_BD r (2 * m + 2))
          (hNat_ιZD r (2 * m + 1)) (hNat_dKD r (2 * m + 1)) 0
      · exact fun z => (hExtPostcompComp U_D _ _ 0 z).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 0)) z)
            (hNat_πHD r (2 * m + 2))).trans (hExtPostcompComp U_D _ _ 0 z).symm)
      · exact fun x => (hExtPostcompComp U_D _ _ 0 x).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 0)) x)
            (hτ_E0 r).symm).trans (hExtPostcompComp U_D _ _ 0 x).symm)
      · exact fun x => (hExtPostcompComp U_D _ _ 2 x).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 2)) x)
            (hτ_E2 r).symm).trans (hExtPostcompComp U_D _ _ 2 x).symm)
      · exact fun x => (hExtPostcompComp U_D _ _ 2 x).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 2)) x)
            (hNat_πHD r (2 * m))).trans (hExtPostcompComp U_D _ _ 2 x).symm)
      · exact hExtDeltaNat U_D (ι_ZD (r + 1) (2 * m)) (d_KD (r + 1) (2 * m))
          (h0_im (r + 1) (2 * m)) (hSE_im (r + 1) (2 * m))
          (ι_ZD r (2 * m)) (d_KD r (2 * m)) (h0_im r (2 * m)) (hSE_im r (2 * m))
          (t_ZD r (2 * m)) (t_KD r (2 * m)) (t_BD r (2 * m + 1))
          (hNat_ιZD r (2 * m)) (hNat_dKD r (2 * m)) 1
      · exact fun x => (hExtPostcompComp U_D _ _ 1 x).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 1)) x)
            (hNat_jBD r (2 * m + 1))).trans (hExtPostcompComp U_D _ _ 1 x).symm)
      · exact fun w => (hExtPostcompComp U_D _ _ 1 w).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 1)) w)
            (hNat_πHD r (2 * m + 1))).trans (hExtPostcompComp U_D _ _ 1 w).symm)
      · exact fun x => (hExtPostcompComp U_D _ _ 1 x).trans
          ((congrArg (fun g => ((Abelian.Ext.mk₀ g).postcomp U_D (Nat.add_zero 1)) x)
            (hτ_E1 r).symm).trans (hExtPostcompComp U_D _ _ 1 x).symm)

    have hFrobAll : ∀ r : ℕ,
        (∀ w, f_M r (α r w) = α r (frob_F1 r w)) ∧
        (∀ y, f_E0 r (β r y) = β r (f_M r y)) ∧
        (∀ x, frob_F1 r (γ_map r x) = γ_map r (f_E2 r x)) ∧
        (∀ w, f_E1 r (ε_map r w) = ε_map r (frob_F1 r w)) := by
      intro r
      apply hChaseIntertwine r r
        (f_M r) (f_E2 r) (f_E1 r) (f_E0 r) (frob_F1 r)
        (frob_QZ r (2 * m + 2) 0) (frob_QZ r (2 * m + 1) 1)
        (frob_ZD r (2 * m) 2) (frob_BD r (2 * m + 1) 1)
        (frob_HD r (2 * m) 2) (frob_HD r (2 * m + 1) 1)
        (frob_BD r (2 * m + 2) 0) (frob_ZD r (2 * m + 2) 0) (frob_HD r (2 * m + 2) 0)
      · intro x
        have hshift_frob := hSyzygyFrobNat r (2 * m + 1) 1 (2 * m + 2) h1_add_2m1 x
        exact (hf_M r (shift_Z_hom r x)).symm.trans (congrArg (e_M r) hshift_frob.symm)
      · exact fun x => (hf_QZ_δ r (2 * m + 1) 0 x).symm
      · exact fun z => (he_Q0_frob r z).symm
      · exact fun b => (hf_jBD0 r b).symm
      · exact fun b => (hf_δD0 r b).symm
      · exact fun z => (hf_πHD0 r z).symm
      · exact fun x => (hf_E0 r x).symm
      · exact fun x => (hf_E2 r x).symm
      · exact fun x => (hf_πHD2 r x).symm
      · exact fun x => (hf_δD1 r x).symm
      · exact fun x => (hf_jBD1 r x).symm
      · exact fun w => (hf_πHD1 r w).symm
      · exact fun x => (hf_E1 r x).symm

    refine ⟨α, β, γ_map, ε_map, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro r w₁ w₂ h
      obtain ⟨b₁, rfl⟩ := (hδ_D0_ex r).1 w₁
      obtain ⟨b₂, rfl⟩ := (hδ_D0_ex r).1 w₂
      have hdiff : α_tilde r (b₁ - b₂) = 0 := by
        have h1 : α_tilde r (b₁ - b₂) = α_tilde r b₁ - α_tilde r b₂ := map_sub (α_tilde r) b₁ b₂
        exact h1.trans (((congrArg₂ Sub.sub (hα_spec r b₁).symm (hα_spec r b₂).symm)).trans
          ((congrArg (· - α r (δ_D0 r b₂)) h).trans (sub_self _)))
      have hδ_diff : δ_D0 r (b₁ - b₂) = 0 := (hα_tilde_iff r (b₁ - b₂)).mp hdiff
      exact sub_eq_zero.mp ((map_sub (δ_D0 r) b₁ b₂).symm.trans hδ_diff)
