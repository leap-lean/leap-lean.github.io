        hSE_map.extClass (CategoryTheory.Abelian.Ext.mk₀ (βJ m))
        (Nat.zero_add 1) (Nat.add_zero 1) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ αX)
        (CategoryTheory.Abelian.Ext.mapExactFunctor P z₀)
        hSE_map.extClass
        (Nat.zero_add 0) (Nat.zero_add 1) (by omega)]

  
  have hSub₀ : ∀ m : ℕ, Subsingleton (KH m 0) := fun m =>
    @Equiv.subsingleton _ _ (e_K m 0).toEquiv (hSub_J0 m)

  let ρ_H : ∀ m : ℕ, CategoryTheory.Abelian.Ext X (L m) 0 →+ CategoryTheory.Abelian.Ext X (S m) 0 :=
    fun m => (CategoryTheory.Abelian.Ext.mk₀ (ρ m)).postcomp X (Nat.add_zero 0)
  let δ_ext : ∀ m : ℕ, CategoryTheory.Abelian.Ext X (S m) 0 →+ CategoryTheory.Abelian.Ext X (J m) 1 :=
    fun m => (hSE m).extClass.postcomp X (Nat.zero_add 1)
  let ι_H : ∀ m q : ℕ, CategoryTheory.Abelian.Ext X (J m) q →+ CategoryTheory.Abelian.Ext X (L m) q :=
    fun m q => (CategoryTheory.Abelian.Ext.mk₀ (ι m)).postcomp X (Nat.add_zero q)

  let f₀_m : ∀ m : ℕ, (∀ j : Fin m_c, CompH m 0 j) →+ (Fin M_bdry → ZMod (ℓ ^ (m + 1))) :=
    fun m => (e_S0 m).toAddMonoidHom.comp ((ρ_H m).comp (r_comp m 0).symm.toAddMonoidHom)
  let δ_m : ∀ m : ℕ, (Fin M_bdry → ZMod (ℓ ^ (m + 1))) →+ KH m 1 :=
    fun m => (e_K m 1).symm.toAddMonoidHom.comp ((δ_ext m).comp (e_S0 m).symm.toAddMonoidHom)
  let g_all : ∀ m q : ℕ, KH m q →+ (∀ j : Fin m_c, CompH m q j) :=
    fun m q => (r_comp m q).toAddMonoidHom.comp ((ι_H m q).comp (e_K m q).toAddMonoidHom)
  let g₁_m : ∀ m : ℕ, KH m 1 →+ (∀ j : Fin m_c, CompH m 1 j) :=
    fun m => g_all m 1

  have hg_ge2_bij : ∀ m r : ℕ, Function.Bijective (g_all m (r + 2)) := by
    intro m r
    have hbij_ι : Function.Bijective (ι_H m (r + 2)) :=
      (hExtLES (ι m) (ρ m) (h0 m) (hSE m)).2.2.2.2 r
        (hSub_Sq m (r + 1) (by omega)) (hSub_Sq m (r + 2) (by omega))
    exact (r_comp m (r + 2)).bijective.comp (hbij_ι.comp (e_K m (r + 2)).bijective)

  let g₂_m : ∀ m : ℕ, KH m 2 ≃+ (∀ j : Fin m_c, CompH m 2 j) :=
    fun m => AddEquiv.ofBijective (g_all m 2) (hg_ge2_bij m 0)

  have hg_all_α : ∀ (m q : ℕ) (x : KH m q),
      g_all m q (α_H m q x) = act_comp m q (g_all m q x) := by
    intro m q x
    change r_comp m q (ι_H m q (e_K m q (α_H m q x))) =
      act_comp m q (r_comp m q (ι_H m q (e_K m q x)))
    rw [he_K_α m q x]
    change r_comp m q
      (((CategoryTheory.Abelian.Ext.mk₀ (ι m)).postcomp X (Nat.add_zero q))
        (((CategoryTheory.Abelian.Ext.mk₀ (βJ m)).postcomp X (Nat.add_zero q))
          ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
            ((P.mapExtAddHom X (J m) q) (e_K m q x)) (Nat.zero_add q)))) = _
    rw [hExtSliceNat (ι m) (βJ m) (βL m) (hβ_ι m) q (e_K m q x)]
    exact hr_comp_act m q (ι_H m q (e_K m q x))

