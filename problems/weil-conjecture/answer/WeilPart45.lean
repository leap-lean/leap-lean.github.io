    fun {X Y} _ _ _ _ f =>
      { toFun := f
        map_add' := f.map_add
        map_smul' := fun c x => by
          dsimp
          conv_lhs => rw [← ZMod.natCast_zmod_val c, Nat.cast_smul_eq_nsmul, map_nsmul]
          conv_rhs => rw [← ZMod.natCast_zmod_val c, Nat.cast_smul_eq_nsmul] }

