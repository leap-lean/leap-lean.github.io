                  congrArg (ℓ ^ (b + 1) * ·) hdiv.symm
              _ = ℓ ^ (b + 1) * (z₁ + z₂).val +
                    (ℓ ^ (b + 1) * ℓ ^ (a + 1)) * ((z₁.val + z₂.val) / ℓ ^ (a + 1)) := by ring
              _ = _ := by rw [hpow]
          have hcast := congrArg (Nat.cast : ℕ → ZMod (ℓ ^ (b + a + 1 + 1))) hmul
          rw [Nat.cast_add, Nat.cast_add,
            Nat.cast_mul (ℓ ^ (b + a + 1 + 1)) ((z₁.val + z₂.val) / ℓ ^ (a + 1)),
            ZMod.natCast_self, zero_mul, add_zero] at hcast
