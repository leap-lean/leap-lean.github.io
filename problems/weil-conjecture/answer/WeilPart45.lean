  have hj_V_range : Set.range j_V.base = p_bar.base ⁻¹' (U_bar : Set ↥D_bar) := by
    let iso_jV := hpb_jV.isoPullback
    have heq : j_V = iso_jV.hom ≫ CategoryTheory.Limits.pullback.fst fst_Y j_V₀' :=
