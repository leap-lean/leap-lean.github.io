theorem weil_abelian_ext_excision_tower_and_finiteness (C : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} C]
    [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
    (ℓ M_bdry m_c : ℕ) [Fact (Nat.Prime ℓ)]
    (P : CategoryTheory.Functor C C)
    (hAdd : P.Additive) (hLim : CategoryTheory.Limits.PreservesFiniteLimits P)
    (hColim : CategoryTheory.Limits.PreservesFiniteColimits P)
    (X : C) (αX : X ⟶ P.obj X)
    (J L S : ℕ → C)
    (ι : ∀ m : ℕ, J m ⟶ L m) (ρ : ∀ m : ℕ, L m ⟶ S m)
