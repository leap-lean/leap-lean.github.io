      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_map (hSE m) mor_β
    change (((CategoryTheory.Abelian.Ext.mk₀ αX).comp
        ((P.mapExtAddHom X (S m) 0) z₀) (Nat.zero_add 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (βS m)) (Nat.add_zero 0)).comp
        (hSE m).extClass (Nat.zero_add 1) =
      ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
        ((P.mapExtAddHom X (J m) 1) (z₀.comp (hSE m).extClass (Nat.zero_add 1)))
        (Nat.zero_add 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (βJ m)) (Nat.add_zero 1)
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P (hSE m)]
    rw [CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor P z₀) (Nat.zero_add 0))
        (CategoryTheory.Abelian.Ext.mk₀ (βS m)) (hSE m).extClass
        (Nat.add_zero 0) (Nat.zero_add 1) (by omega),
      ← hnat,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
