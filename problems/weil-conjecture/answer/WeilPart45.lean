  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
  let pr_D : D_bar ⟶ D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
  let snd_D := CategoryTheory.Limits.pullback.snd D_ov.hom f₂
  let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
  let Fgt₀ := AlgebraicGeometry.Scheme.Etale.forget D_ov.left
  let B_pr := weilEtaleSitePullback pr_D
  let V_ov := fun m : ℕ => weilCurveTrGeomCoverOver F (B m)
  let V_bar := fun m : ℕ => weilGeomScheme F (V_ov m)
  let ι_m := fun m : ℕ =>
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) ≫ e_U.hom) ≫ U₀.ι

  let ψ_inv := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
    (AlgebraicClosure F) _ _ _
  let ψ := ψ_inv.symm
  let i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
  let i₂_inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inv.toRingHom)
  have hi₂_hom_inv : i₂ ≫ i₂_inv = 𝟙 _ := by
    change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ = _
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
    congr 1
    ext x
    exact ψ_inv.symm_apply_apply x
  have hi₂_inv_hom : i₂_inv ≫ i₂ = 𝟙 _ := by
    change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ = _
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
    congr 1
    ext x
    exact ψ_inv.apply_symm_apply x
  have hcomp_inv : CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)) ≫
      CommRingCat.ofHom ψ_inv.toRingHom =
      CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)) :=
    (CommRingCat.ofHom_comp _ _).symm.trans
      (congrArg CommRingCat.ofHom (RingHom.ext ψ_inv.commutes))
  let g_Z_inv : ∀ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)),
      weilGeomScheme F Z ⟶ weilGeomScheme F Z := fun Z =>
    CategoryTheory.Limits.pullback.map Z.hom f₂ Z.hom f₂
      (𝟙 Z.left) i₂_inv (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
      ((CategoryTheory.Category.comp_id Z.hom).trans (CategoryTheory.Category.id_comp Z.hom).symm)
      ((CategoryTheory.Category.comp_id f₂).trans
        ((congrArg AlgebraicGeometry.Spec.map hcomp_inv.symm).trans
          (AlgebraicGeometry.Spec.map_comp _ _)))
  have hgZ_fst : ∀ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)),
      weilGeomFrobHom F Z ≫ CategoryTheory.Limits.pullback.fst Z.hom f₂ =
        CategoryTheory.Limits.pullback.fst Z.hom f₂ := by
    intro Z
    dsimp only [weilGeomScheme, weilBaseChangeOver, weilGeomFrobHom, f₂,
      CategoryTheory.Limits.pullback.map]
    exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
      (CategoryTheory.Category.comp_id _)
  have hgZ_snd : ∀ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)),
      weilGeomFrobHom F Z ≫ CategoryTheory.Limits.pullback.snd Z.hom f₂ =
        CategoryTheory.Limits.pullback.snd Z.hom f₂ ≫ i₂ := by
    intro Z
    dsimp only [weilGeomScheme, weilBaseChangeOver, weilGeomFrobHom, f₂, i₂, ψ, ψ_inv,
      CategoryTheory.Limits.pullback.map]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hgZ_inv_fst : ∀ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)),
      g_Z_inv Z ≫ CategoryTheory.Limits.pullback.fst Z.hom f₂ =
        CategoryTheory.Limits.pullback.fst Z.hom f₂ := by
    intro Z
    dsimp only [g_Z_inv, CategoryTheory.Limits.pullback.map]
    exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
      (CategoryTheory.Category.comp_id _)
  have hgZ_inv_snd : ∀ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)),
      g_Z_inv Z ≫ CategoryTheory.Limits.pullback.snd Z.hom f₂ =
        CategoryTheory.Limits.pullback.snd Z.hom f₂ ≫ i₂_inv := by
    intro Z
    dsimp only [g_Z_inv, CategoryTheory.Limits.pullback.map]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hgZ_hom_inv : ∀ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)),
      weilGeomFrobHom F Z ≫ g_Z_inv Z = 𝟙 (weilGeomScheme F Z) := by
    intro Z
    let s := CategoryTheory.Limits.pullback.snd Z.hom f₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg _ (hgZ_inv_fst Z)).trans
          ((hgZ_fst Z).trans (CategoryTheory.Category.id_comp _).symm))
    · exact (CategoryTheory.Category.assoc (weilGeomFrobHom F Z) (g_Z_inv Z) s).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (weilGeomFrobHom F Z))
          (hgZ_inv_snd Z)).trans
          ((CategoryTheory.Category.assoc (weilGeomFrobHom F Z) s i₂_inv).symm.trans
            ((congrArg (fun k => k ≫ i₂_inv) (hgZ_snd Z)).trans
              ((CategoryTheory.Category.assoc s i₂ i₂_inv).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp s) hi₂_hom_inv).trans
                  ((CategoryTheory.Category.comp_id s).trans
                    (CategoryTheory.Category.id_comp _).symm))))))
  have hgZ_inv_hom : ∀ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)),
      g_Z_inv Z ≫ weilGeomFrobHom F Z = 𝟙 (weilGeomScheme F Z) := by
    intro Z
    let s := CategoryTheory.Limits.pullback.snd Z.hom f₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg _ (hgZ_fst Z)).trans
          ((hgZ_inv_fst Z).trans (CategoryTheory.Category.id_comp _).symm))
    · exact (CategoryTheory.Category.assoc (g_Z_inv Z) (weilGeomFrobHom F Z) s).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_Z_inv Z))
          (hgZ_snd Z)).trans
          ((CategoryTheory.Category.assoc (g_Z_inv Z) s i₂).symm.trans
            ((congrArg (fun k => k ≫ i₂) (hgZ_inv_snd Z)).trans
              ((CategoryTheory.Category.assoc s i₂_inv i₂).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp s) hi₂_inv_hom).trans
                  ((CategoryTheory.Category.comp_id s).trans
                    (CategoryTheory.Category.id_comp _).symm))))))

  let g_D := weilGeomFrobHom F D_ov
  let g_D_inv := g_Z_inv D_ov
  let g_V := fun m : ℕ => weilGeomFrobHom F (V_ov m)
  let g_V_inv := fun m : ℕ => g_Z_inv (V_ov m)
  let d_V := fun (m : ℕ) (σ : B m ≃ₐ[R₀] B m) => weilCurveTrGeomDeckHom F R₀ (B m) σ

  have hgD_U : (TopologicalSpace.Opens.map g_D.base).obj U_bar = U_bar := by
    dsimp only [U_bar]
    rw [← TopologicalSpace.Opens.map_comp_obj, ← AlgebraicGeometry.Scheme.Hom.comp_base,
      hgZ_fst D_ov]
  have hgV_ι : ∀ m : ℕ, g_V m ≫ ι_bar_J m = ι_bar_J m ≫ g_D := by
    intro m
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (g_V m) (ι_bar_J m) pr_D).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V m)) (hJ_spec m).1).trans
          ((CategoryTheory.Category.assoc (g_V m) _ (ι_m m)).symm.trans
            ((congrArg (fun k => k ≫ ι_m m) (hgZ_fst (V_ov m))).trans
              (((hJ_spec m).1).symm.trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (ι_bar_J m))
                  (hgZ_fst D_ov).symm).trans
                  (CategoryTheory.Category.assoc (ι_bar_J m) g_D pr_D).symm)))))
    · exact (CategoryTheory.Category.assoc (g_V m) (ι_bar_J m) snd_D).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V m)) (hJ_spec m).2.1).trans
          ((hgZ_snd (V_ov m)).trans
            ((congrArg (fun k => k ≫ i₂) ((hJ_spec m).2.1).symm).trans
              ((CategoryTheory.Category.assoc (ι_bar_J m) snd_D i₂).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (ι_bar_J m))
                  (hgZ_snd D_ov).symm).trans
                  (CategoryTheory.Category.assoc (ι_bar_J m) g_D snd_D).symm)))))
  have hgV_inv_ι : ∀ m : ℕ, g_V_inv m ≫ ι_bar_J m = ι_bar_J m ≫ g_D_inv := by
    intro m
    calc
      g_V_inv m ≫ ι_bar_J m = (g_V_inv m ≫ ι_bar_J m) ≫ (g_D ≫ g_D_inv) := by
        rw [hgZ_hom_inv D_ov, CategoryTheory.Category.comp_id]
      _ = g_V_inv m ≫ (ι_bar_J m ≫ g_D) ≫ g_D_inv := by
        simp only [CategoryTheory.Category.assoc]
      _ = (g_V_inv m ≫ g_V m) ≫ ι_bar_J m ≫ g_D_inv := by
        rw [← hgV_ι m]
        simp only [CategoryTheory.Category.assoc]
      _ = ι_bar_J m ≫ g_D_inv := by
        rw [hgZ_inv_hom (V_ov m), CategoryTheory.Category.id_comp]

  have hd_fst : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m),
      d_V m σ ≫ CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂ =
        CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) := by
    intro m σ
    dsimp only [d_V, V_ov, weilCurveTrGeomDeckHom, f₂, CategoryTheory.Limits.pullback.map]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hd_snd : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m),
      d_V m σ ≫ CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂ =
        CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂ := by
    intro m σ
    dsimp only [d_V, V_ov, weilCurveTrGeomDeckHom, f₂, CategoryTheory.Limits.pullback.map]
    exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
      (CategoryTheory.Category.comp_id _)
  have hd_ι : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m), d_V m σ ≫ ι_bar_J m = ι_bar_J m := by
    intro m σ
    let f_σ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
    have hσ_ι : f_σ ≫ ι_m m = ι_m m := by
      dsimp only [f_σ, ι_m]
      have hspec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext r
        exact σ.symm.commutes r
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hspec]
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (d_V m σ) (ι_bar_J m) pr_D).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (d_V m σ)) (hJ_spec m).1).trans
          ((CategoryTheory.Category.assoc (d_V m σ) _ (ι_m m)).symm.trans
            ((congrArg (fun k => k ≫ ι_m m) (hd_fst m σ)).trans
              ((CategoryTheory.Category.assoc _ f_σ (ι_m m)).trans
                ((congrArg _ hσ_ι).trans ((hJ_spec m).1).symm)))))
    · exact (CategoryTheory.Category.assoc (d_V m σ) (ι_bar_J m) snd_D).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (d_V m σ)) (hJ_spec m).2.1).trans
          ((hd_snd m σ).trans ((hJ_spec m).2.1).symm))
  have hgV_d : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m),
      g_V m ≫ d_V m σ = d_V m σ ≫ g_V m := by
    intro m σ
    let f_σ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
    let fst_V := CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂
    let snd_V := CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (g_V m) (d_V m σ) fst_V).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V m)) (hd_fst m σ)).trans
          ((CategoryTheory.Category.assoc (g_V m) fst_V f_σ).symm.trans
            ((congrArg (fun k => k ≫ f_σ) (hgZ_fst (V_ov m))).trans
              ((hd_fst m σ).symm.trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (d_V m σ))
                  (hgZ_fst (V_ov m)).symm).trans
                  (CategoryTheory.Category.assoc (d_V m σ) (g_V m) fst_V).symm)))))
    · exact (CategoryTheory.Category.assoc (g_V m) (d_V m σ) snd_V).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V m)) (hd_snd m σ)).trans
          ((hgZ_snd (V_ov m)).trans
            ((congrArg (fun k => k ≫ i₂) (hd_snd m σ).symm).trans
              ((CategoryTheory.Category.assoc (d_V m σ) snd_V i₂).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (d_V m σ))
                  (hgZ_snd (V_ov m)).symm).trans
                  (CategoryTheory.Category.assoc (d_V m σ) (g_V m) snd_V).symm)))))
  have hgV_inv_d : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m),
      g_V_inv m ≫ d_V m σ = d_V m σ ≫ g_V_inv m := by
    intro m σ
    let f_σ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
    let fst_V := CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂
    let snd_V := CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (g_V_inv m) (d_V m σ) fst_V).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V_inv m)) (hd_fst m σ)).trans
          ((CategoryTheory.Category.assoc (g_V_inv m) fst_V f_σ).symm.trans
            ((congrArg (fun k => k ≫ f_σ) (hgZ_inv_fst (V_ov m))).trans
              ((hd_fst m σ).symm.trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (d_V m σ))
                  (hgZ_inv_fst (V_ov m)).symm).trans
                  (CategoryTheory.Category.assoc (d_V m σ) (g_V_inv m) fst_V).symm)))))
    · exact (CategoryTheory.Category.assoc (g_V_inv m) (d_V m σ) snd_V).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V_inv m)) (hd_snd m σ)).trans
          ((hgZ_inv_snd (V_ov m)).trans
            ((congrArg (fun k => k ≫ i₂_inv) (hd_snd m σ).symm).trans
              ((CategoryTheory.Category.assoc (d_V m σ) snd_V i₂_inv).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (d_V m σ))
                  (hgZ_inv_snd (V_ov m)).symm).trans
                  (CategoryTheory.Category.assoc (d_V m σ) (g_V_inv m) snd_V).symm)))))

  let φ_m := fun m : ℕ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom)
  have hφ_hom : ∀ m : ℕ, φ_m m ≫ (V_ov m).hom = (V_ov (m + 1)).hom := by
    intro m
    dsimp only [φ_m, V_ov, weilCurveTrGeomCoverOver]
    change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ =
      AlgebraicGeometry.Spec.map _
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1
    ext c
    have h1 : algebraMap F (B m) c =
        algebraMap R₀ (B m) (algebraMap (Polynomial F) R₀ (algebraMap F (Polynomial F) c)) :=
      (IsScalarTower.algebraMap_apply F (Polynomial F) (B m) c).trans
        (IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B m) _)
    have h2 : algebraMap F (B (m + 1)) c =
        algebraMap R₀ (B (m + 1))
          (algebraMap (Polynomial F) R₀ (algebraMap F (Polynomial F) c)) :=
      (IsScalarTower.algebraMap_apply F (Polynomial F) (B (m + 1)) c).trans
        (IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B (m + 1)) _)
    change ι_B m (algebraMap F (B m) c) = algebraMap F (B (m + 1)) c
    rw [h1, h2]
    exact (ι_B m).commutes _
  have hφ_ι : ∀ m : ℕ, φ_m m ≫ ι_m m = ι_m (m + 1) := by
    intro m
    dsimp only [φ_m, ι_m]
    have hspec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (m + 1)))) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext r
      exact (ι_B m).commutes r
    rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hspec]
  let ψ_bar : ∀ m : ℕ, V_bar (m + 1) ⟶ V_bar m := fun m =>
    CategoryTheory.Limits.pullback.map (V_ov (m + 1)).hom f₂ (V_ov m).hom f₂
      (φ_m m) (𝟙 _) (𝟙 _)
      ((CategoryTheory.Category.comp_id _).trans (hφ_hom m).symm)
      ((CategoryTheory.Category.id_comp f₂).trans (CategoryTheory.Category.comp_id f₂).symm)
  have hψ_fst : ∀ m : ℕ,
      ψ_bar m ≫ CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂ =
        CategoryTheory.Limits.pullback.fst (V_ov (m + 1)).hom f₂ ≫ φ_m m := by
    intro m
    dsimp only [ψ_bar, CategoryTheory.Limits.pullback.map]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hψ_snd : ∀ m : ℕ,
      ψ_bar m ≫ CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂ =
        CategoryTheory.Limits.pullback.snd (V_ov (m + 1)).hom f₂ := by
    intro m
    dsimp only [ψ_bar, CategoryTheory.Limits.pullback.map]
    exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
      (CategoryTheory.Category.comp_id _)
  have hψ_ι : ∀ m : ℕ, ψ_bar m ≫ ι_bar_J m = ι_bar_J (m + 1) := by
    intro m
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (ψ_bar m) (ι_bar_J m) pr_D).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (ψ_bar m)) (hJ_spec m).1).trans
          ((CategoryTheory.Category.assoc (ψ_bar m) _ (ι_m m)).symm.trans
            ((congrArg (fun k => k ≫ ι_m m) (hψ_fst m)).trans
              ((CategoryTheory.Category.assoc _ (φ_m m) (ι_m m)).trans
                ((congrArg _ (hφ_ι m)).trans ((hJ_spec (m + 1)).1).symm)))))
    · exact (CategoryTheory.Category.assoc (ψ_bar m) (ι_bar_J m) snd_D).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (ψ_bar m)) (hJ_spec m).2.1).trans
          ((hψ_snd m).trans ((hJ_spec (m + 1)).2.1).symm))
  have hgV_ψ : ∀ m : ℕ, g_V (m + 1) ≫ ψ_bar m = ψ_bar m ≫ g_V m := by
    intro m
    let fst_m := CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂
    let snd_m := CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂
    let fst_m1 := CategoryTheory.Limits.pullback.fst (V_ov (m + 1)).hom f₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (g_V (m + 1)) (ψ_bar m) fst_m).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V (m + 1))) (hψ_fst m)).trans
          ((CategoryTheory.Category.assoc (g_V (m + 1)) fst_m1 (φ_m m)).symm.trans
            ((congrArg (fun k => k ≫ φ_m m) (hgZ_fst (V_ov (m + 1)))).trans
              ((hψ_fst m).symm.trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (ψ_bar m))
                  (hgZ_fst (V_ov m)).symm).trans
                  (CategoryTheory.Category.assoc (ψ_bar m) (g_V m) fst_m).symm)))))
    · exact (CategoryTheory.Category.assoc (g_V (m + 1)) (ψ_bar m) snd_m).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (g_V (m + 1))) (hψ_snd m)).trans
          ((hgZ_snd (V_ov (m + 1))).trans
            ((congrArg (fun k => k ≫ i₂) (hψ_snd m).symm).trans
              ((CategoryTheory.Category.assoc (ψ_bar m) snd_m i₂).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (ψ_bar m))
                  (hgZ_snd (V_ov m)).symm).trans
                  (CategoryTheory.Category.assoc (ψ_bar m) (g_V m) snd_m).symm)))))
  let m_ι_can : ∀ (m : ℕ) (W : D_bar.Etale),
      CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J (m + 1)) ⟶
        CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m) := fun m W =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J (m + 1)))
      (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J (m + 1)) ≫ ψ_bar m)
      (by rw [CategoryTheory.Category.assoc, hψ_ι m, CategoryTheory.Limits.pullback.condition])
  have hm_ι_bar_eq : ∀ (m : ℕ) (W : D_bar.Etale)
      (m_ι_bar : CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J (m + 1)) ⟶
        CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m)),
      m_ι_bar ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m) =
        CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J (m + 1)) →
      m_ι_bar ≫ (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J m) ≫
          CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂) =
        (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J (m + 1)) ≫
          CategoryTheory.Limits.pullback.fst (V_ov (m + 1)).hom f₂) ≫ φ_m m →
      m_ι_bar = m_ι_can m W := by
    intro m W m_ι_bar hm_fst hm_snd
    let fst_W_m := CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m)
    let snd_W_m := CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J m)
    let fst_W_m1 := CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J (m + 1))
    let snd_W_m1 := CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J (m + 1))
    let fst_Vm := CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂
    let snd_Vm := CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂
    let fst_Vm1 := CategoryTheory.Limits.pullback.fst (V_ov (m + 1)).hom f₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact hm_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    · refine Eq.trans ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc m_ι_bar snd_W_m fst_Vm).trans
          (hm_snd.trans
            ((CategoryTheory.Category.assoc snd_W_m1 fst_Vm1 (φ_m m)).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp snd_W_m1) (hψ_fst m).symm).trans
                (CategoryTheory.Category.assoc snd_W_m1 (ψ_bar m) fst_Vm).symm)))
      · have h1 : (m_ι_bar ≫ snd_W_m) ≫ snd_Vm =
            m_ι_bar ≫ ((snd_W_m ≫ ι_bar_J m) ≫ snd_D) :=
          (CategoryTheory.Category.assoc m_ι_bar snd_W_m snd_Vm).trans
            ((congrArg (fun k => m_ι_bar ≫ (snd_W_m ≫ k)) ((hJ_spec m).2.1).symm).trans
              (congrArg (CategoryTheory.CategoryStruct.comp m_ι_bar)
                (CategoryTheory.Category.assoc snd_W_m (ι_bar_J m) snd_D).symm))
        have h2 : m_ι_bar ≫ ((snd_W_m ≫ ι_bar_J m) ≫ snd_D) =
            (m_ι_bar ≫ fst_W_m) ≫ ((Fgt.obj W).hom ≫ snd_D) :=
          (congrArg (fun k => m_ι_bar ≫ (k ≫ snd_D))
            CategoryTheory.Limits.pullback.condition.symm).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp m_ι_bar)
              (CategoryTheory.Category.assoc fst_W_m (Fgt.obj W).hom snd_D)).trans
              (CategoryTheory.Category.assoc m_ι_bar fst_W_m
                ((Fgt.obj W).hom ≫ snd_D)).symm)
        have h3 : (m_ι_bar ≫ fst_W_m) ≫ ((Fgt.obj W).hom ≫ snd_D) =
            (snd_W_m1 ≫ ι_bar_J (m + 1)) ≫ snd_D :=
          (congrArg (fun k => k ≫ ((Fgt.obj W).hom ≫ snd_D)) hm_fst).trans
            ((CategoryTheory.Category.assoc fst_W_m1 (Fgt.obj W).hom snd_D).symm.trans
              (congrArg (fun k => k ≫ snd_D) CategoryTheory.Limits.pullback.condition))
        have h4 : (snd_W_m1 ≫ ι_bar_J (m + 1)) ≫ snd_D =
            (snd_W_m1 ≫ ψ_bar m) ≫ snd_Vm :=
          (CategoryTheory.Category.assoc snd_W_m1 (ι_bar_J (m + 1)) snd_D).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp snd_W_m1)
              (hJ_spec (m + 1)).2.1).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp snd_W_m1)
                (hψ_snd m).symm).trans
                (CategoryTheory.Category.assoc snd_W_m1 (ψ_bar m) snd_Vm).symm))
        exact h1.trans (h2.trans (h3.trans h4))

  
  let n_W : ∀ W : D_ov.left.Etale,
      CategoryTheory.Limits.pullback (Fgt₀.obj W).hom pr_D ⟶
        CategoryTheory.Limits.pullback (Fgt₀.obj W).hom pr_D := fun W =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (Fgt₀.obj W).hom pr_D)
      (CategoryTheory.Limits.pullback.snd (Fgt₀.obj W).hom pr_D ≫ g_D)
      (by rw [CategoryTheory.Category.assoc, hgZ_fst D_ov,
            CategoryTheory.Limits.pullback.condition])
  have hG1_obj : ∀ U : D_bar.Etale,
      (Fgt.obj ((G_pow 1).obj U)).left = (Fgt.obj U).left ∧
      HEq (Fgt.obj ((G_pow 1).obj U)).hom ((Fgt.obj U).hom ≫ g_D) := by
    intro U
    obtain ⟨hl, hh⟩ := (hg_pow_spec 1).2.1 U
    rw [hpow1] at hh
    exact ⟨hl, hh⟩
  have hB_map_fst : ∀ {W₁ W₂ : D_ov.left.Etale} (u : W₁ ⟶ W₂),
      (Fgt.map (B_pr.map u)).left ≫ CategoryTheory.Limits.pullback.fst (Fgt₀.obj W₂).hom pr_D =
        CategoryTheory.Limits.pullback.fst (Fgt₀.obj W₁).hom pr_D ≫ (Fgt₀.map u).left :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hB_map_snd : ∀ {W₁ W₂ : D_ov.left.Etale} (u : W₁ ⟶ W₂),
      (Fgt.map (B_pr.map u)).left ≫ CategoryTheory.Limits.pullback.snd (Fgt₀.obj W₂).hom pr_D =
        CategoryTheory.Limits.pullback.snd (Fgt₀.obj W₁).hom pr_D :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  let ν_app : ∀ W : D_ov.left.Etale,
      ((B_pr ⋙ G_pow 1).obj W) ⟶ B_pr.obj W := fun W =>
    let hl := (hG1_obj (B_pr.obj W)).1
    let hh := (hG1_obj (B_pr.obj W)).2
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.eqToHom hl ≫ n_W W)
      ((CategoryTheory.Category.assoc (CategoryTheory.eqToHom hl) (n_W W)
        (CategoryTheory.Limits.pullback.snd (Fgt₀.obj W).hom pr_D)).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom hl))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
          (heq_hom_of_eq hl hh)))
  let ν : B_pr ⋙ G_pow 1 ⟶ B_pr :=
    { app := ν_app
      naturality := fun {W₁ W₂} u => by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        let hl₁ := (hG1_obj (B_pr.obj W₁)).1
        let hl₂ := (hG1_obj (B_pr.obj W₂)).1
        let fst₁ := CategoryTheory.Limits.pullback.fst (Fgt₀.obj W₁).hom pr_D
        let fst₂ := CategoryTheory.Limits.pullback.fst (Fgt₀.obj W₂).hom pr_D
        let snd₁ := CategoryTheory.Limits.pullback.snd (Fgt₀.obj W₁).hom pr_D
        let snd₂ := CategoryTheory.Limits.pullback.snd (Fgt₀.obj W₂).hom pr_D
        have hmap_u : (Fgt.map ((G_pow 1).map (B_pr.map u))).left ≫
            CategoryTheory.eqToHom hl₂ =
            CategoryTheory.eqToHom hl₁ ≫ (Fgt.map (B_pr.map u)).left :=
          heq_hom_of_eq₂ hl₁ hl₂ ((hg_pow_spec 1).2.2 (B_pr.map u))
        have hn_nat : (Fgt.map (B_pr.map u)).left ≫ n_W W₂ =
            n_W W₁ ≫ (Fgt.map (B_pr.map u)).left := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Category.assoc ((Fgt.map (B_pr.map u)).left) (n_W W₂) fst₂).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp ((Fgt.map (B_pr.map u)).left))
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((hB_map_fst u).trans
                  ((congrArg (fun k => k ≫ (Fgt₀.map u).left)
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
                    ((CategoryTheory.Category.assoc (n_W W₁) fst₁ ((Fgt₀.map u).left)).trans
                      ((congrArg (CategoryTheory.CategoryStruct.comp (n_W W₁))
                        (hB_map_fst u).symm).trans
                        (CategoryTheory.Category.assoc (n_W W₁)
                          ((Fgt.map (B_pr.map u)).left) fst₂).symm)))))
          · exact (CategoryTheory.Category.assoc ((Fgt.map (B_pr.map u)).left) (n_W W₂) snd₂).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp ((Fgt.map (B_pr.map u)).left))
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Category.assoc ((Fgt.map (B_pr.map u)).left) snd₂ g_D).symm.trans
                  ((congrArg (fun k => k ≫ g_D) (hB_map_snd u)).trans
                    ((CategoryTheory.Limits.pullback.lift_snd _ _ _).symm.trans
                      ((congrArg (CategoryTheory.CategoryStruct.comp (n_W W₁))
                        (hB_map_snd u).symm).trans
                        (CategoryTheory.Category.assoc (n_W W₁)
                          ((Fgt.map (B_pr.map u)).left) snd₂).symm)))))
        change (Fgt.map ((G_pow 1).map (B_pr.map u))).left ≫
            (CategoryTheory.eqToHom hl₂ ≫ n_W W₂) =
          (CategoryTheory.eqToHom hl₁ ≫ n_W W₁) ≫ (Fgt.map (B_pr.map u)).left
        exact (CategoryTheory.Category.assoc _ (CategoryTheory.eqToHom hl₂) (n_W W₂)).symm.trans
          ((congrArg (fun k => k ≫ n_W W₂) hmap_u).trans
            ((CategoryTheory.Category.assoc (CategoryTheory.eqToHom hl₁) _ (n_W W₂)).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom hl₁))
                hn_nat).trans
                (CategoryTheory.Category.assoc (CategoryTheory.eqToHom hl₁)
                  (n_W W₁) _).symm))) }
  have hν_proj : ∀ W : D_ov.left.Etale,
      HEq ((Fgt.map (ν.app W)).left ≫
          CategoryTheory.Limits.pullback.fst (Fgt₀.obj W).hom pr_D)
        (CategoryTheory.Limits.pullback.fst (Fgt₀.obj W).hom pr_D) ∧
      HEq ((Fgt.map (ν.app W)).left ≫
          CategoryTheory.Limits.pullback.snd (Fgt₀.obj W).hom pr_D)
        (CategoryTheory.Limits.pullback.snd (Fgt₀.obj W).hom pr_D ≫ g_D) := by
    intro W
    let hl := (hG1_obj (B_pr.obj W)).1
    refine ⟨?_, ?_⟩
    · have h1 : (Fgt.map (ν.app W)).left ≫
          CategoryTheory.Limits.pullback.fst (Fgt₀.obj W).hom pr_D =
          CategoryTheory.eqToHom hl ≫
            CategoryTheory.Limits.pullback.fst (Fgt₀.obj W).hom pr_D :=
        (CategoryTheory.Category.assoc (CategoryTheory.eqToHom hl) (n_W W) _).trans
          (congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom hl))
            (CategoryTheory.Limits.pullback.lift_fst _ _ _))
      exact (heq_of_eq h1).trans (CategoryTheory.eqToHom_comp_heq _ hl)
    · have h2 : (Fgt.map (ν.app W)).left ≫
          CategoryTheory.Limits.pullback.snd (Fgt₀.obj W).hom pr_D =
          CategoryTheory.eqToHom hl ≫
            (CategoryTheory.Limits.pullback.snd (Fgt₀.obj W).hom pr_D ≫ g_D) :=
        (CategoryTheory.Category.assoc (CategoryTheory.eqToHom hl) (n_W W) _).trans
          (congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom hl))
            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      exact (heq_of_eq h2).trans (CategoryTheory.eqToHom_comp_heq _ hl)

  
  have hgD_pow_U : ∀ k : ℕ,
      (TopologicalSpace.Opens.map (weilSchemeEndPow g_D k).base).obj U_bar = U_bar := by
    intro k
    induction k with
    | zero =>
      dsimp only [weilSchemeEndPow]
      rw [AlgebraicGeometry.Scheme.Hom.id_base, TopologicalSpace.Opens.map_id_obj]
    | succ k ih =>
      dsimp only [weilSchemeEndPow]
      rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopologicalSpace.Opens.map_comp_obj, ih, hgD_U]
  have hgV_pow_ι : ∀ (k m : ℕ),
      weilSchemeEndPow (g_V m) k ≫ ι_bar_J m = ι_bar_J m ≫ weilSchemeEndPow g_D k := by
    intro k m
    induction k with
    | zero =>
      dsimp only [weilSchemeEndPow]
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    | succ k ih =>
      dsimp only [weilSchemeEndPow]
      rw [CategoryTheory.Category.assoc, ih, ← CategoryTheory.Category.assoc, hgV_ι m,
        CategoryTheory.Category.assoc]
  have hgV_pow_d : ∀ (k m : ℕ) (σ : B m ≃ₐ[R₀] B m),
      weilSchemeEndPow (g_V m) k ≫ d_V m σ = d_V m σ ≫ weilSchemeEndPow (g_V m) k := by
    intro k m σ
    induction k with
    | zero =>
      dsimp only [weilSchemeEndPow]
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    | succ k ih =>
      dsimp only [weilSchemeEndPow]
      rw [CategoryTheory.Category.assoc, ih, ← CategoryTheory.Category.assoc, hgV_d m σ,
        CategoryTheory.Category.assoc]
  have hgV_pow_ψ : ∀ (k m : ℕ),
      weilSchemeEndPow (g_V (m + 1)) k ≫ ψ_bar m = ψ_bar m ≫ weilSchemeEndPow (g_V m) k := by
    intro k m
    induction k with
    | zero =>
      dsimp only [weilSchemeEndPow]
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    | succ k ih =>
      dsimp only [weilSchemeEndPow]
      rw [CategoryTheory.Category.assoc, ih, ← CategoryTheory.Category.assoc, hgV_ψ m,
        CategoryTheory.Category.assoc]

  have hGpow_hom_eq : ∀ (k : ℕ) (W : D_bar.Etale),
      (Fgt.obj W).hom ≫ weilSchemeEndPow g_D k =
        CategoryTheory.eqToHom ((hg_pow_spec k).2.1 W).1.symm ≫
          (Fgt.obj ((G_pow k).obj W)).hom := by
    intro k W
    let hl := ((hg_pow_spec k).2.1 W).1
    have h1 : CategoryTheory.eqToHom hl ≫ ((Fgt.obj W).hom ≫ weilSchemeEndPow g_D k) =
        (Fgt.obj ((G_pow k).obj W)).hom :=
      heq_hom_of_eq hl ((hg_pow_spec k).2.1 W).2
    exact ((congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom hl.symm))
      h1.symm).trans
      ((CategoryTheory.Category.assoc (CategoryTheory.eqToHom hl.symm)
        (CategoryTheory.eqToHom hl) _).symm.trans
        ((congrArg (fun e => e ≫ _) (CategoryTheory.eqToHom_trans hl.symm hl)).trans
          ((congrArg (fun e => e ≫ _) (CategoryTheory.eqToHom_refl _ rfl)).trans
            (CategoryTheory.Category.id_comp _))))).symm
  let w_V_can : ∀ (k m : ℕ) (W : D_bar.Etale),
      CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m) ⟶
        CategoryTheory.Limits.pullback (Fgt.obj ((G_pow k).obj W)).hom (ι_bar_J m) :=
    fun k m W =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m) ≫
          CategoryTheory.eqToHom ((hg_pow_spec k).2.1 W).1.symm)
        (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J m) ≫
          weilSchemeEndPow (g_V m) k)
        (by
          rw [CategoryTheory.Category.assoc, ← hGpow_hom_eq k W,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc, ← hgV_pow_ι k m,
            ← CategoryTheory.Category.assoc])
  have hw_V_unique : ∀ (k m : ℕ) (W : D_bar.Etale)
      (w_V : CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m) ⟶
        CategoryTheory.Limits.pullback (Fgt.obj ((G_pow k).obj W)).hom (ι_bar_J m)),
      HEq (w_V ≫ CategoryTheory.Limits.pullback.fst
          (Fgt.obj ((G_pow k).obj W)).hom (ι_bar_J m))
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m)) →
      w_V ≫ CategoryTheory.Limits.pullback.snd
          (Fgt.obj ((G_pow k).obj W)).hom (ι_bar_J m) =
        CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J m) ≫
          weilSchemeEndPow (g_V m) k →
      w_V = w_V_can k m W := by
    intro k m W w_V hw_fst hw_snd
    let hl := ((hg_pow_spec k).2.1 W).1
    have h1 : (w_V ≫ CategoryTheory.Limits.pullback.fst
          (Fgt.obj ((G_pow k).obj W)).hom (ι_bar_J m)) ≫
        CategoryTheory.eqToHom hl =
        CategoryTheory.eqToHom rfl ≫
          CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m) :=
      heq_hom_of_eq₂ rfl hl hw_fst
    rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp] at h1
    have hfst : w_V ≫ CategoryTheory.Limits.pullback.fst
        (Fgt.obj ((G_pow k).obj W)).hom (ι_bar_J m) =
        CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m) ≫
          CategoryTheory.eqToHom hl.symm := by
      rw [← h1, CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans,
        CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact hfst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    · exact hw_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm

  have hβ_mem : ∀ (k m : ℕ) (W : D_bar.Etale)
      (sec : ↑((𝒥_bar m).obj.obj (Opposite.op ((G_pow k).obj W)))),
      (triv_J m ((G_pow k).obj W) sec).comap (w_V_can k m W).base.hom ∈
        Set.range (triv_J m W) := by
    intro k m W sec
    let W' := (G_pow k).obj W
    let hl := ((hg_pow_spec k).2.1 W).1
    have hmem' : triv_J m W' sec ∈ Set.range (triv_J m W') := ⟨sec, rfl⟩
    rw [((hJ_spec m).2.2.2 W').2] at hmem'
    obtain ⟨⟨W'₀, hW'₀_top, hW'₀_zero⟩, hdeck'⟩ := hmem'
    rw [((hJ_spec m).2.2.2 W).2]
    refine ⟨?_, ?_⟩
    · let W₀ : (Fgt.obj W).left.Opens :=
        (TopologicalSpace.Opens.map (CategoryTheory.eqToHom hl.symm).base).obj W'₀
      refine ⟨W₀, ?_, ?_⟩
      · have hU_eq : (TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U_bar =
            (TopologicalSpace.Opens.map (CategoryTheory.eqToHom hl.symm).base).obj
              ((TopologicalSpace.Opens.map (Fgt.obj W').hom.base).obj U_bar) := by
          conv_lhs => rw [← hgD_pow_U k]
          rw [← TopologicalSpace.Opens.map_comp_obj,
            ← AlgebraicGeometry.Scheme.Hom.comp_base, hGpow_hom_eq k W,
            AlgebraicGeometry.Scheme.Hom.comp_base, TopologicalSpace.Opens.map_comp_obj]
        exact Eq.trans (congrArg (· ⊔ W₀) hU_eq)
          (hopens_sup_top (CategoryTheory.eqToHom hl.symm) _ W'₀ hW'₀_top)
      · intro y hy
        change triv_J m W' sec ((w_V_can k m W).base y) = 0
        apply hW'₀_zero ((w_V_can k m W).base y)
        have hbase : (CategoryTheory.Limits.pullback.fst (Fgt.obj W').hom (ι_bar_J m)).base
            ((w_V_can k m W).base y) =
            (CategoryTheory.eqToHom hl.symm).base
              ((CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m)).base y) := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
            CategoryTheory.Limits.pullback.lift_fst,
            AlgebraicGeometry.Scheme.Hom.comp_apply]
        rw [hbase]
        exact hy
    · intro σ m_σ hm_fst hm_snd y
      let m'_σ : CategoryTheory.Limits.pullback (Fgt.obj W').hom (ι_bar_J m) ⟶
          CategoryTheory.Limits.pullback (Fgt.obj W').hom (ι_bar_J m) :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst (Fgt.obj W').hom (ι_bar_J m))
          (CategoryTheory.Limits.pullback.snd (Fgt.obj W').hom (ι_bar_J m) ≫ d_V m σ)
          (by rw [CategoryTheory.Category.assoc, hd_ι m σ,
                CategoryTheory.Limits.pullback.condition])
      have hcomm_σ : m_σ ≫ w_V_can k m W = w_V_can k m W ≫ m'_σ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, hm_fst, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, hm_snd, CategoryTheory.Category.assoc,
            ← hgV_pow_d k m σ, CategoryTheory.Category.assoc (w_V_can k m W),
            CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc (w_V_can k m W),
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
      change triv_J m W' sec ((w_V_can k m W).base (m_σ.base y)) =
        ((τ_rep m σ).val).mulVec (triv_J m W' sec ((w_V_can k m W).base y))
      have hpt : (w_V_can k m W).base (m_σ.base y) = m'_σ.base ((w_V_can k m W).base y) := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hcomm_σ,
          AlgebraicGeometry.Scheme.Hom.comp_apply]
      rw [hpt]
      exact hdeck' σ m'_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((w_V_can k m W).base y)

