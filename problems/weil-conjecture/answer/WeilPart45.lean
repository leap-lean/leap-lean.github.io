        φ (triv_K m₁ W sec y) :=
    fun m₁ m₂ φ W sec y => DFunLike.congr_fun (hmkMap_mem m₁ m₂ φ W sec).choose_spec y
  let τ_𝒦s : ∀ m : ℕ, Quiver.Hom (𝒦_s (m + 1)) (𝒦_s m) :=
    fun m => mkMap (m + 1) m
      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))).toAddMonoidHom
