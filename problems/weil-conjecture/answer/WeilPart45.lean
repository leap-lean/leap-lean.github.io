    (M_lat_V : ∀ (σ : Γ) (i : Fin 3), Matrix (Fin (b_V σ i)) (Fin (b_V σ i)) (PadicInt ℓ))
    (K₀ K₁ K₂ : Type u) [AddCommGroup K₀] [AddCommGroup K₁] [AddCommGroup K₂]
    (ρK₀ : Γ → (K₀ →+ K₀)) (ρK₁ : Γ → (K₁ →+ K₁)) (ρK₂ : Γ → (K₂ →+ K₂))
