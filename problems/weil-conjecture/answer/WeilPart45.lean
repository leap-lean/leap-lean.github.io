    let m_σ_hom : V_ov.left ⟶ V_ov.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)
    have hm_jV₀' : j_V₀' ≫ m_Y₀.hom = m_σ_hom ≫ j_V₀' := hm_jV₀
    have hdeck_fst : weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹ ≫ fst_V = fst_V ≫ m_σ_hom := by
      dsimp only [weilCurveTrGeomDeckHom, CategoryTheory.Limits.pullback.map,
        V_bar, weilGeomScheme, weilBaseChangeOver, fst_V, f₂, k]
      rw [CategoryTheory.Limits.pullback.lift_fst]
      rfl
    have hdeck_snd : weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹ ≫ snd_V = snd_V := by
      dsimp only [weilCurveTrGeomDeckHom, CategoryTheory.Limits.pullback.map,
        V_bar, weilGeomScheme, weilBaseChangeOver, CategoryTheory.Over.mk_hom, snd_V, S₀, f₂, k]
      rw [CategoryTheory.Limits.pullback.lift_snd, Category.comp_id]
    dsimp [Y_bar, weilBaseChangeOver]
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (j_V ≫ m_Y_hom) ≫ fst_Y = (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹ ≫ j_V) ≫ fst_Y
      rw [Category.assoc, hm_Y_bar_fst, ← Category.assoc, hj_V_fst, Category.assoc, hm_jV₀',
        Category.assoc, hj_V_fst, ← Category.assoc, ← hdeck_fst, Category.assoc]
    · change (j_V ≫ m_Y_hom) ≫ snd_Y = (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹ ≫ j_V) ≫ snd_Y
      rw [Category.assoc, hm_Y_bar_snd, hj_V_snd, Category.assoc, hj_V_snd, hdeck_snd]

  
  
  
  let _ : Fintype F := Fintype.ofFinite F
  let p := ringChar F
  obtain ⟨ν, hp_prime, hcard_F⟩ := FiniteField.card F p
  let hFactP : Fact (Nat.Prime p) := ⟨hp_prime⟩
  let μ : ℕ := (ν : ℕ) * r
  have hμ : 1 ≤ μ := Nat.mul_pos ν.pos hr
  have hpμ_eq : p ^ μ = (Fintype.card F) ^ r := by
    dsimp [μ]
    rw [pow_mul, ← hcard_F]
  have hpμ_ne : p ^ μ ≠ 0 := pow_ne_zero μ hp_prime.ne_zero

  have hfrobAlg_pow : ∀ (R : Type u) [CommRing R] [Algebra F R] (m : ℕ) (s : R),
      (((FiniteField.frobeniusAlgHom F R) ^ m) s) = s ^ ((Fintype.card F) ^ m) := by
    intro R _ _ m
    induction m with
    | zero =>
      intro s
      simp
    | succ m ih =>
      intro s
      rw [pow_succ, AlgHom.mul_apply, FiniteField.frobeniusAlgHom_apply, ih, ← pow_mul,
        ← pow_succ']

  let φ_F : ∀ (W : AlgebraicGeometry.Scheme.{u}),
      Quiver.Hom W (AlgebraicGeometry.Spec (CommRingCat.of F)) → Quiver.Hom W W :=
    fun W hW =>
      let f_alg : ∀ U : W.Opens, F →+* ↑(W.presheaf.obj (Opposite.op U)) := fun U =>
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
          hW.appLE ⊤ U le_top).hom
      let σ_U : ∀ U : W.Opens,
          W.presheaf.obj (Opposite.op U) ⟶ W.presheaf.obj (Opposite.op U) := fun U =>
        letI : Algebra F ↑(W.presheaf.obj (Opposite.op U)) := (f_alg U).toAlgebra
        CommRingCat.ofHom (((FiniteField.frobeniusAlgHom F ↑(W.presheaf.obj (Opposite.op U))) ^ r).toRingHom)
      let c_W : W.presheaf ⟶
          (TopologicalSpace.Opens.map (𝟙 W.toTopCat)).op ⋙ W.presheaf :=
        { app := fun opU => σ_U opU.unop
          naturality := fun {opU opV} ρ => by
            have hρ : ((TopologicalSpace.Opens.map (𝟙 W.toTopCat)).map ρ.unop).op = ρ :=
              congrArg Opposite.op (Subsingleton.elim _ _)
            ext s
            dsimp [σ_U]
            rw [hρ]
            let _ : Algebra F ↑(W.presheaf.obj opU) := (f_alg opU.unop).toAlgebra
            let _ : Algebra F ↑(W.presheaf.obj opV) := (f_alg opV.unop).toAlgebra
            change (((FiniteField.frobeniusAlgHom F ↑(W.presheaf.obj opV)) ^ r)
                ((W.presheaf.map ρ).hom s)) =
              (W.presheaf.map ρ).hom (((FiniteField.frobeniusAlgHom F ↑(W.presheaf.obj opU)) ^ r) s)
            rw [hfrobAlg_pow, hfrobAlg_pow, map_pow] }
      let pHom : W.toPresheafedSpace ⟶ W.toPresheafedSpace :=
        AlgebraicGeometry.PresheafedSpace.Hom.mk (𝟙 W.toTopCat) c_W
      have hLoc : ∀ w : ↥W, IsLocalHom (pHom.stalkMap w).hom := by
        intro w
        refine ⟨fun g hg => ?_⟩
        obtain ⟨U, hwU, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq W.presheaf g
        have hstalk : (pHom.stalkMap w).hom (W.presheaf.germ U (pHom.base w) hwU s) =
            (W.presheaf.germ U (pHom.base w) hwU s) ^ (p ^ μ) := by
          change (pHom.stalkMap w) (W.presheaf.germ U (pHom.base w) hwU s) = _
          rw [AlgebraicGeometry.PresheafedSpace.stalkMap_germ_apply pHom U w hwU s]
          dsimp [pHom, c_W, σ_U]
          let _ : Algebra F ↑(W.presheaf.obj (Opposite.op U)) := (f_alg U).toAlgebra
          change W.presheaf.germ U w hwU (((FiniteField.frobeniusAlgHom F _) ^ r) s) =
            (W.presheaf.germ U w hwU s) ^ (p ^ μ)
          rw [hfrobAlg_pow, ← hpμ_eq, map_pow]
        rw [hstalk] at hg
        exact (isUnit_pow_iff hpμ_ne).mp hg
      AlgebraicGeometry.Scheme.Hom.mk (AlgebraicGeometry.LocallyRingedSpace.Hom.mk pHom hLoc)

  have hφ_F_app : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (hW : Quiver.Hom W (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (U : W.Opens) (s : ↑(W.presheaf.obj (Opposite.op U))),
      ((φ_F W hW).app U).hom s = s ^ (p ^ μ) := by
    intro W hW U s
    let f_alg : F →+* ↑(W.presheaf.obj (Opposite.op U)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        hW.appLE ⊤ U le_top).hom
    let _ : Algebra F ↑(W.presheaf.obj (Opposite.op U)) := f_alg.toAlgebra
    change (((FiniteField.frobeniusAlgHom F ↑(W.presheaf.obj (Opposite.op U))) ^ r) s) = s ^ (p ^ μ)
    rw [hfrobAlg_pow, hpμ_eq]

  have hφ_F_abs : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (hW : Quiver.Hom W (AlgebraicGeometry.Spec (CommRingCat.of F))),
      WeilTopDegIsIteratedAbsFrob p μ W (φ_F W hW) := by
    intro W hW
    refine ⟨?_, rfl, ?_⟩
    · intro U
      let f_alg : F →+* ↑(W.presheaf.obj (Opposite.op U)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
          hW.appLE ⊤ U le_top).hom
      have hpF : ((p : ℕ) : F) = 0 := CharP.cast_eq_zero F p
      calc ((p : ℕ) : ↑(W.presheaf.obj (Opposite.op U)))
          = f_alg ((p : ℕ) : F) := (map_natCast f_alg p).symm
        _ = f_alg 0 := by rw [hpF]
        _ = 0 := map_zero f_alg
    · intro U e s
      have happ_eq : (φ_F W hW).appLE U U e = (φ_F W hW).app U := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        congr 1
      rw [happ_eq]
      exact hφ_F_app W hW U s

  have hφ_F_nat : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Quiver.Hom W₁ (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (h₂ : Quiver.Hom W₂ (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (f : W₁ ⟶ W₂),
      φ_F W₁ h₁ ≫ f = f ≫ φ_F W₂ h₂ := by
    intro W₁ W₂ h₁ h₂ f
    have hbase : (φ_F W₁ h₁ ≫ f).base = (f ≫ φ_F W₂ h₂).base := rfl
    refine AlgebraicGeometry.Scheme.Hom.ext hbase (fun U => ?_)
    have hmap_id : W₁.presheaf.map (CategoryTheory.eqToHom (by rw [hbase]) :
        (TopologicalSpace.Opens.map (f ≫ φ_F W₂ h₂).base).obj U ⟶
          (TopologicalSpace.Opens.map (φ_F W₁ h₁ ≫ f).base).obj U).op = 𝟙 _ :=
      W₁.presheaf.map_id _
    ext s
    refine (congrArg (fun g => g.hom (((φ_F W₁ h₁ ≫ f).app U).hom s)) hmap_id).trans ?_
    change (((φ_F W₁ h₁ ≫ f).app U).hom s :
        ↑(W₁.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U)))) =
      (((f ≫ φ_F W₂ h₂).app U).hom s :
        ↑(W₁.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U))))
    rw [AlgebraicGeometry.Scheme.Hom.comp_app, AlgebraicGeometry.Scheme.Hom.comp_app]
    let V : W₁.Opens := (TopologicalSpace.Opens.map f.base).obj U
    change ((φ_F W₁ h₁).app V).hom ((f.app U).hom s) =
      (f.app U).hom (((φ_F W₂ h₂).app U).hom s)
    rw [hφ_F_app, hφ_F_app, map_pow]

  let φ_arith := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
    (AlgebraicClosure F) _ _ _
  let ψ := φ_arith.symm

  have hφ_arith_pow : ∀ (m : ℕ) (c : k), (φ_arith ^ m) c = c ^ ((Fintype.card F) ^ m) := by
    intro m
    induction m with
    | zero => intro c; simp
    | succ m ih =>
      intro c
      rw [pow_succ, AlgEquiv.mul_apply, FiniteField.frobeniusAlgEquivOfAlgebraic_apply, ih,
        ← pow_mul, ← pow_succ']

  have hψ_cancel : ∀ c : k, ((ψ ^ r) c) ^ (p ^ μ) = c := by
    have hpow_inv : ∀ (m : ℕ) (c : k), (φ_arith ^ m) ((ψ ^ m) c) = c := by
      intro m
      induction m with
      | zero => intro c; simp
      | succ m ih =>
        intro c
        rw [pow_succ, pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply,
          φ_arith.apply_symm_apply, ih]
    intro c
    rw [hpμ_eq, ← hφ_arith_pow r ((ψ ^ r) c), hpow_inv r c]

  have hGeomFrob_props : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))),
      let fst_Z : weilGeomScheme F Z ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom f₂
      let snd_Z : weilGeomScheme F Z ⟶ S₀ := (weilBaseChangeOver F k Z).hom
      (∀ m : ℕ,
        weilSchemeEndPow (weilGeomFrobHom F Z) m ≫ fst_Z = fst_Z ∧
        weilSchemeEndPow (weilGeomFrobHom F Z) m ≫ snd_Z =
          snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ ^ m).toRingHom)) ∧
      ∃ g_Z_iso : CategoryTheory.Iso (weilGeomScheme F Z) (weilGeomScheme F Z),
        g_Z_iso.hom = weilSchemeEndPow (weilGeomFrobHom F Z) r ∧
        (φ_F (weilGeomScheme F Z) (snd_Z ≫ f₂) ≫ g_Z_iso.hom) ≫ snd_Z = snd_Z := by
    intro Z fst_Z snd_Z
    have h1_fst : weilGeomFrobHom F Z ≫ fst_Z = fst_Z := by
      dsimp only [weilGeomFrobHom, weilGeomScheme, weilBaseChangeOver, fst_Z, f₂, k]
      rw [CategoryTheory.Limits.pullback.lift_fst, Category.comp_id]
    have h1_snd : weilGeomFrobHom F Z ≫ snd_Z =
        snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) := by
      dsimp only [weilGeomFrobHom, weilGeomScheme, weilBaseChangeOver, snd_Z, S₀, f₂, k, ψ, φ_arith]
      exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hm_all : ∀ m : ℕ,
        weilSchemeEndPow (weilGeomFrobHom F Z) m ≫ fst_Z = fst_Z ∧
        weilSchemeEndPow (weilGeomFrobHom F Z) m ≫ snd_Z =
          snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ ^ m).toRingHom) := by
      intro m
      induction m with
      | zero =>
        refine ⟨Category.id_comp fst_Z, ?_⟩
        change 𝟙 (weilGeomScheme F Z) ≫ snd_Z = _
        rw [Category.id_comp]
        have h0 : (ψ ^ 0).toRingHom = RingHom.id k := rfl
        rw [h0, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id, Category.comp_id]
      | succ m ih =>
        refine ⟨?_, ?_⟩
        · change (weilGeomFrobHom F Z ≫ weilSchemeEndPow (weilGeomFrobHom F Z) m) ≫ fst_Z = fst_Z
          rw [Category.assoc, ih.1, h1_fst]
        · change (weilGeomFrobHom F Z ≫ weilSchemeEndPow (weilGeomFrobHom F Z) m) ≫ snd_Z = _
          rw [Category.assoc, ih.2, ← Category.assoc, h1_snd, Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          congr 3
          ext c
          exact (congrArg (fun e : k ≃ₐ[F] k => e c) (pow_succ' ψ m)).symm
    have hcomp_φ : CommRingCat.ofHom (algebraMap F k) ≫ CommRingCat.ofHom φ_arith.toRingHom =
        CommRingCat.ofHom (algebraMap F k) :=
      (CommRingCat.ofHom_comp _ _).symm.trans
        (congrArg CommRingCat.ofHom (RingHom.ext φ_arith.commutes))
    let g_Z_inv₁ : weilGeomScheme F Z ⟶ weilGeomScheme F Z :=
      CategoryTheory.Limits.pullback.lift fst_Z
        (snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_arith.toRingHom))
        (by
          change fst_Z ≫ Z.hom =
            (snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_arith.toRingHom)) ≫ f₂
          rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hcomp_φ]
          exact CategoryTheory.Limits.pullback.condition)
    have hinv_fst : g_Z_inv₁ ≫ fst_Z = fst_Z :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hinv_snd : g_Z_inv₁ ≫ snd_Z =
        snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_arith.toRingHom) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hψφ : ψ.toRingHom.comp φ_arith.toRingHom = RingHom.id k := by
      ext c; exact ψ.apply_symm_apply c
    have hφψ : φ_arith.toRingHom.comp ψ.toRingHom = RingHom.id k := by
      ext c; exact φ_arith.apply_symm_apply c
    let g_Z_iso₁ : CategoryTheory.Iso (weilGeomScheme F Z) (weilGeomScheme F Z) :=
      { hom := weilGeomFrobHom F Z
        inv := g_Z_inv₁
        hom_inv_id := by
          dsimp [weilGeomScheme, weilBaseChangeOver]
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (weilGeomFrobHom F Z ≫ g_Z_inv₁) ≫ fst_Z = 𝟙 (weilGeomScheme F Z) ≫ fst_Z
            rw [Category.assoc, hinv_fst, h1_fst, Category.id_comp]
          · change (weilGeomFrobHom F Z ≫ g_Z_inv₁) ≫ snd_Z = 𝟙 (weilGeomScheme F Z) ≫ snd_Z
            rw [Category.assoc, hinv_snd, ← Category.assoc, h1_snd, Category.assoc,
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
              hψφ, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id, Category.comp_id,
              Category.id_comp]
        inv_hom_id := by
          dsimp [weilGeomScheme, weilBaseChangeOver]
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (g_Z_inv₁ ≫ weilGeomFrobHom F Z) ≫ fst_Z = 𝟙 (weilGeomScheme F Z) ≫ fst_Z
            rw [Category.assoc, h1_fst, hinv_fst, Category.id_comp]
          · change (g_Z_inv₁ ≫ weilGeomFrobHom F Z) ≫ snd_Z = 𝟙 (weilGeomScheme F Z) ≫ snd_Z
            rw [Category.assoc, h1_snd, ← Category.assoc, hinv_snd, Category.assoc,
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
              hφψ, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id, Category.comp_id,
              Category.id_comp] }
    have hIso_pow : ∀ m : ℕ, ∃ iso_m : CategoryTheory.Iso (weilGeomScheme F Z) (weilGeomScheme F Z),
        iso_m.hom = weilSchemeEndPow (weilGeomFrobHom F Z) m := by
      intro m
      induction m with
      | zero => exact ⟨CategoryTheory.Iso.refl _, rfl⟩
      | succ m ih =>
        obtain ⟨iso_m, hiso_m⟩ := ih
        exact ⟨g_Z_iso₁ ≪≫ iso_m, by dsimp [weilSchemeEndPow]; rw [hiso_m]⟩
    obtain ⟨g_Z_iso, hg_Z_hom⟩ := hIso_pow r
    refine ⟨hm_all, g_Z_iso, hg_Z_hom, ?_⟩
    let φ_Z : weilGeomScheme F Z ⟶ weilGeomScheme F Z := φ_F (weilGeomScheme F Z) (snd_Z ≫ f₂)
    let lhs : weilGeomScheme F Z ⟶ S₀ := (φ_Z ≫ g_Z_iso.hom) ≫ snd_Z
    let ψ_hom : CommRingCat.of k ⟶ CommRingCat.of k := CommRingCat.ofHom (ψ ^ r).toRingHom
    have hlhs_eq : lhs = φ_Z ≫ snd_Z ≫ AlgebraicGeometry.Spec.map ψ_hom := by
      change (φ_Z ≫ g_Z_iso.hom) ≫ snd_Z = _
      rw [Category.assoc, hg_Z_hom, (hm_all r).2]
    have happTop : lhs.appTop = snd_Z.appTop := by
      apply (cancel_epi (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).mp
      rw [hlhs_eq]
      simp only [AlgebraicGeometry.Scheme.Hom.comp_appTop]
      have hnat_ψ := AlgebraicGeometry.Scheme.ΓSpecIso_naturality ψ_hom
      have hinv_ψ : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          (AlgebraicGeometry.Spec.map ψ_hom).appTop =
          ψ_hom ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
        rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
        exact hnat_ψ
      rw [← Category.assoc, ← Category.assoc, hinv_ψ, Category.assoc, Category.assoc]
      ext c
      set ι_top := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ snd_Z.appTop
      change (φ_Z.app ⊤).hom (ι_top.hom ((ψ ^ r) c)) = ι_top.hom c
      rw [hφ_F_app _ _ ⊤ _, ← map_pow, hψ_cancel c]
    have htoSpec : S₀.toSpecΓ = S₀.isoSpec.hom := rfl
    have _ : CategoryTheory.IsIso S₀.toSpecΓ := by rw [htoSpec]; infer_instance
    apply (cancel_mono S₀.toSpecΓ).mp
    change lhs ≫ S₀.toSpecΓ = snd_Z ≫ S₀.toSpecΓ
    rw [AlgebraicGeometry.Scheme.toSpecΓ_naturality lhs,
      AlgebraicGeometry.Scheme.toSpecΓ_naturality snd_Z, happTop]

  have hGeom_nat : ∀ {Z₁ Z₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))}
      (u : Z₁.left ⟶ Z₂.left)
      (u_bar : weilGeomScheme F Z₁ ⟶ weilGeomScheme F Z₂),
      u_bar ≫ (CategoryTheory.Limits.pullback.fst Z₂.hom f₂ : weilGeomScheme F Z₂ ⟶ Z₂.left) =
        (CategoryTheory.Limits.pullback.fst Z₁.hom f₂ : weilGeomScheme F Z₁ ⟶ Z₁.left) ≫ u →
      u_bar ≫ (weilBaseChangeOver F k Z₂).hom = (weilBaseChangeOver F k Z₁).hom →
      u_bar ≫ weilSchemeEndPow (weilGeomFrobHom F Z₂) r =
        weilSchemeEndPow (weilGeomFrobHom F Z₁) r ≫ u_bar := by
    intro Z₁ Z₂ u u_bar hu_fst hu_snd
    let fst₁ : weilGeomScheme F Z₁ ⟶ Z₁.left := CategoryTheory.Limits.pullback.fst Z₁.hom f₂
    let fst₂ : weilGeomScheme F Z₂ ⟶ Z₂.left := CategoryTheory.Limits.pullback.fst Z₂.hom f₂
    let snd₁ : weilGeomScheme F Z₁ ⟶ S₀ := (weilBaseChangeOver F k Z₁).hom
    let snd₂ : weilGeomScheme F Z₂ ⟶ S₀ := (weilBaseChangeOver F k Z₂).hom
    have hu_fst' : u_bar ≫ fst₂ = fst₁ ≫ u := hu_fst
    have hu_snd' : u_bar ≫ snd₂ = snd₁ := hu_snd
    have h1 : u_bar ≫ weilGeomFrobHom F Z₂ = weilGeomFrobHom F Z₁ ≫ u_bar := by
      have hg₂_fst : weilGeomFrobHom F Z₂ ≫ fst₂ = fst₂ := by
        simpa only [weilSchemeEndPow, Category.comp_id] using (hGeomFrob_props Z₂).1 1 |>.1
      have hg₁_fst : weilGeomFrobHom F Z₁ ≫ fst₁ = fst₁ := by
        simpa only [weilSchemeEndPow, Category.comp_id] using (hGeomFrob_props Z₁).1 1 |>.1
      have hg₂_snd : weilGeomFrobHom F Z₂ ≫ snd₂ =
          snd₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ ^ 1).toRingHom) := by
        simpa only [weilSchemeEndPow, Category.comp_id] using (hGeomFrob_props Z₂).1 1 |>.2
      have hg₁_snd : weilGeomFrobHom F Z₁ ≫ snd₁ =
          snd₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ ^ 1).toRingHom) := by
        simpa only [weilSchemeEndPow, Category.comp_id] using (hGeomFrob_props Z₁).1 1 |>.2
      dsimp [weilGeomScheme, weilBaseChangeOver]
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (u_bar ≫ weilGeomFrobHom F Z₂) ≫ fst₂ = (weilGeomFrobHom F Z₁ ≫ u_bar) ≫ fst₂
        rw [Category.assoc, hg₂_fst, hu_fst', Category.assoc, hu_fst', ← Category.assoc, hg₁_fst]
      · change (u_bar ≫ weilGeomFrobHom F Z₂) ≫ snd₂ = (weilGeomFrobHom F Z₁ ≫ u_bar) ≫ snd₂
        rw [Category.assoc, hg₂_snd, ← Category.assoc, hu_snd', ← hg₁_snd, Category.assoc, hu_snd']
    have hm : ∀ m : ℕ, u_bar ≫ weilSchemeEndPow (weilGeomFrobHom F Z₂) m =
        weilSchemeEndPow (weilGeomFrobHom F Z₁) m ≫ u_bar := by
      intro m
      induction m with
      | zero =>
        change u_bar ≫ 𝟙 _ = 𝟙 _ ≫ u_bar
        rw [Category.comp_id, Category.id_comp]
      | succ m ih =>
        change u_bar ≫ (weilGeomFrobHom F Z₂ ≫ weilSchemeEndPow (weilGeomFrobHom F Z₂) m) =
          (weilGeomFrobHom F Z₁ ≫ weilSchemeEndPow (weilGeomFrobHom F Z₁) m) ≫ u_bar
        rw [← Category.assoc, h1, Category.assoc, ih, Category.assoc]
    exact hm r

  
  
  
  let pt₀ : ↥S₀ := default
  have hrange_S₀ : ∀ {W : AlgebraicGeometry.Scheme.{u}} (s : S₀ ⟶ W),
      Set.range s.base = {s.base pt₀} := by
    intro W s
    ext x
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨u, hu⟩ => by rw [Subsingleton.elim u pt₀] at hu; exact hu.symm,
      fun hx => ⟨pt₀, hx.symm⟩⟩

  have hZariski : ∀ (W : AlgebraicGeometry.Scheme.{u}) (g : W ⟶ S₀)
      [AlgebraicGeometry.LocallyOfFiniteType g] (x : ↥W),
      IsClosed ({x} : Set ↥W) →
      let ι_x : CommRingCat.of k ⟶ W.residueField x :=
        (AlgebraicGeometry.Scheme.Spec.preimage (W.fromSpecResidueField x ≫ g)).unop
      Function.Bijective ι_x.hom ∧
      ∃ s_x : S₀ ⟶ W, s_x ≫ g = 𝟙 S₀ ∧ s_x.base pt₀ = x := by
    intro W g _ x hx ι_x
    have _ : AlgebraicGeometry.IsClosedImmersion (W.fromSpecResidueField x) :=
      AlgebraicGeometry.isClosed_singleton_iff_isClosedImmersion.mp hx
    have hmap_ι : AlgebraicGeometry.Spec.map ι_x = W.fromSpecResidueField x ≫ g :=
      AlgebraicGeometry.Scheme.Spec.map_preimage _
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map ι_x) := by
      rw [hmap_ι]; infer_instance
    have hFT : ι_x.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
    have hFin : ι_x.hom.Finite :=
      (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hFT
    let _ : Algebra k ↥(W.residueField x) := ι_x.hom.toAlgebra
    have _ : Module.Finite k ↥(W.residueField x) := hFin
    have _ : Algebra.IsIntegral k ↥(W.residueField x) :=
      Algebra.IsIntegral.of_finite k ↥(W.residueField x)
    have hbij : Function.Bijective ι_x.hom :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_x : k ≃+* ↥(W.residueField x) := RingEquiv.ofBijective ι_x.hom hbij
    let α_x : W.residueField x ⟶ CommRingCat.of k := CommRingCat.ofHom e_x.symm.toRingHom
    have hια : ι_x ≫ α_x = 𝟙 (CommRingCat.of k) := by
      ext c
      exact e_x.symm_apply_apply c
    let s_x : S₀ ⟶ W := AlgebraicGeometry.Spec.map α_x ≫ W.fromSpecResidueField x
    have hs_g : s_x ≫ g = 𝟙 S₀ := by
      change (AlgebraicGeometry.Spec.map α_x ≫ W.fromSpecResidueField x) ≫ g = 𝟙 S₀
      rw [Category.assoc, ← hmap_ι, ← AlgebraicGeometry.Spec.map_comp, hια,
        AlgebraicGeometry.Spec.map_id]
    have hs_pt : s_x.base pt₀ = x := by
      change (AlgebraicGeometry.Spec.map α_x ≫ W.fromSpecResidueField x).base pt₀ = x
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Scheme.fromSpecResidueField_apply]
    exact ⟨hbij, s_x, hs_g, hs_pt⟩

  have hj_closed : ∀ y : ↥V_bar,
      IsClosed ({y} : Set ↥V_bar) ↔ IsClosed ({j_V.base y} : Set ↥Y_bar.left) := by
    intro y
    refine ⟨fun hy => ?_, fun hy => ?_⟩
    · obtain ⟨_, s_y, hsy_hom, hsy_pt⟩ := hZariski V_bar (j_V ≫ Y_bar.hom) y hy
      have hcomp_id : (s_y ≫ j_V) ≫ Y_bar.hom = 𝟙 S₀ := by
        rw [Category.assoc]; exact hsy_hom
      have _ : AlgebraicGeometry.IsClosedImmersion ((s_y ≫ j_V) ≫ Y_bar.hom) := by
        rw [hcomp_id]; infer_instance
      have hcl : AlgebraicGeometry.IsClosedImmersion (s_y ≫ j_V) :=
        AlgebraicGeometry.IsClosedImmersion.of_comp (s_y ≫ j_V) Y_bar.hom
      have hr : Set.range (s_y ≫ j_V).base = {j_V.base y} := by
        rw [hrange_S₀, AlgebraicGeometry.Scheme.Hom.comp_apply, hsy_pt]
      rw [← hr]
      exact hcl.isClosedEmbedding.isClosed_range
    · have hpre : j_V.base ⁻¹' ({j_V.base y} : Set ↥Y_bar.left) = {y} := by
        ext y'
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact ⟨fun h => j_V.isOpenEmbedding.injective h, fun h => congrArg j_V.base h⟩
      rw [← hpre]
      exact hy.preimage j_V.continuous

  have hsec_uniq : ∀ (s₁ s₂ : S₀ ⟶ Y_bar.left),
      s₁ ≫ Y_bar.hom = 𝟙 S₀ →
      s₂ ≫ Y_bar.hom = 𝟙 S₀ →
      Set.range s₁.base = Set.range s₂.base →
      s₁ = s₂ := by
    intro s₁ s₂ hs₁ hs₂ hr_eq
    have _ : AlgebraicGeometry.IsClosedImmersion (s₁ ≫ Y_bar.hom) := by
      rw [hs₁]; infer_instance
    have hcl₁ : AlgebraicGeometry.IsClosedImmersion s₁ :=
      AlgebraicGeometry.IsClosedImmersion.of_comp s₁ Y_bar.hom
    set x := s₁.base pt₀
    have hx_cl : IsClosed ({x} : Set ↥Y_bar.left) := by
      rw [← hrange_S₀ s₁]
      exact hcl₁.isClosedEmbedding.isClosed_range
    have hx₂ : s₂.base pt₀ = x := by
      rw [hrange_S₀, hrange_S₀, Set.singleton_eq_singleton_iff] at hr_eq
      exact hr_eq.symm
    let eY := AlgebraicGeometry.Scheme.SpecToEquivOfField k Y_bar.left
    have hs₁_symm := eY.symm_apply_apply s₁
    have hs₂_symm := eY.symm_apply_apply s₂
    rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply] at hs₁_symm hs₂_symm
    have he₁_fst : (eY s₁).1 = x := by
      have h := congrArg (fun f : S₀ ⟶ Y_bar.left => f.base pt₀) hs₁_symm.symm
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Scheme.fromSpecResidueField_apply] using h.symm
    have he₂_fst : (eY s₂).1 = x := by
      have h := congrArg (fun f : S₀ ⟶ Y_bar.left => f.base pt₀) hs₂_symm.symm
      rw [hx₂] at h
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Scheme.fromSpecResidueField_apply] using h.symm
    apply eY.injective
    rcases hp₁ : eY s₁ with ⟨x₁, α₁⟩
    rcases hp₂ : eY s₂ with ⟨x₂, α₂⟩
    have hx₁_eq : x₁ = x := by rw [← he₁_fst, hp₁]
    have hx₂_eq : x₂ = x := by rw [← he₂_fst, hp₂]
    subst hx₁_eq; subst hx₂_eq
    congr 1
    rw [hp₁] at hs₁_symm
    rw [hp₂] at hs₂_symm
    let ι_x : CommRingCat.of k ⟶ Y_bar.left.residueField x :=
      (AlgebraicGeometry.Scheme.Spec.preimage (Y_bar.left.fromSpecResidueField x ≫ Y_bar.hom)).unop
    have hmap_ι : AlgebraicGeometry.Spec.map ι_x =
        Y_bar.left.fromSpecResidueField x ≫ Y_bar.hom :=
      AlgebraicGeometry.Scheme.Spec.map_preimage _
    have hbij_ι : Function.Bijective ι_x.hom := (hZariski Y_bar.left Y_bar.hom x hx_cl).1
    have hα₁ : ι_x ≫ α₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hmap_ι,
        ← Category.assoc, hs₁_symm, hs₁]
    have hα₂ : ι_x ≫ α₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hmap_ι,
        ← Category.assoc, hs₂_symm, hs₂]
    ext u
    obtain ⟨c, rfl⟩ := hbij_ι.2 u
    have hc₁ : α₁.hom (ι_x.hom c) = c := congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom c) hα₁
    have hc₂ : α₂.hom (ι_x.hom c) = c := congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom c) hα₂
    exact hc₁.trans hc₂.symm

  let BdrySet : Set ↥Y_bar.left := (Set.range j_V.base)ᶜ
  let s_bdry' : Fin m_bdry → (S₀ ⟶ D_bar) := fun i => s_bdry i
  have hBdry_eq_iUnion : BdrySet =
      ⋃ i : Fin m_bdry,
        Set.range (CategoryTheory.Limits.pullback.fst p_bar' (s_bdry' i)).base := by
    dsimp [BdrySet]
    rw [hj_V_range, ← Set.preimage_compl, hU_compl, Set.preimage_iUnion]
    refine Set.iUnion_congr (fun i => ?_)
    exact (AlgebraicGeometry.Scheme.Pullback.range_fst p_bar' (s_bdry' i)).symm

  have hFib_fin_cl : ∀ i : Fin m_bdry,
      let F_i := CategoryTheory.Limits.pullback p_bar' (s_bdry' i)
      let fst_i := CategoryTheory.Limits.pullback.fst p_bar' (s_bdry' i)
      Finite ↥F_i ∧ ∀ w : ↥F_i, IsClosed ({fst_i.base w} : Set ↥Y_bar.left) := by
    intro i F_i fst_i
    let snd_i := CategoryTheory.Limits.pullback.snd p_bar' (s_bdry' i)
    have hpb_i : CategoryTheory.IsPullback fst_i snd_i p_bar' (s_bdry' i) :=
      CategoryTheory.IsPullback.of_hasPullback p_bar' (s_bdry' i)
    have _ : AlgebraicGeometry.IsClosedImmersion (s_bdry' i) := (hs_bdry i).2
    have hcl_fst : AlgebraicGeometry.IsClosedImmersion fst_i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_i.flip inferInstance
    have _ : AlgebraicGeometry.IsFinite p_bar' := inferInstance
    have _ : AlgebraicGeometry.IsFinite snd_i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_i inferInstance
    have _ : AlgebraicGeometry.IsAffine F_i := AlgebraicGeometry.isAffine_of_isAffineHom snd_i
    let A_i := F_i.presheaf.obj (Opposite.op ⊤)
    let g_aff : AlgebraicGeometry.Spec A_i ⟶ S₀ := F_i.isoSpec.inv ≫ snd_i
    let f_i : CommRingCat.of k ⟶ A_i := (AlgebraicGeometry.Scheme.Spec.preimage g_aff).unop
    have hmap_fi : AlgebraicGeometry.Spec.map f_i = g_aff :=
      AlgebraicGeometry.Scheme.Spec.map_preimage g_aff
    have hFin_g : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map f_i) := by
      rw [hmap_fi]; infer_instance
    have hFin_fi : f_i.hom.Finite :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff f_i).mp hFin_g
    let _ : Algebra k ↑A_i := f_i.hom.toAlgebra
    have _ : Module.Finite k ↑A_i := hFin_fi
    have _ : IsArtinianRing ↑A_i := IsArtinianRing.of_finite k ↑A_i
    have _ : Finite ↥(AlgebraicGeometry.Spec A_i) :=
      show Finite (PrimeSpectrum ↑A_i) from inferInstance
    have _ : AlgebraicGeometry.IsArtinianScheme (AlgebraicGeometry.Spec A_i) :=
      AlgebraicGeometry.Scheme.isArtinianScheme_Spec.mpr inferInstance
    have _ : DiscreteTopology ↥(AlgebraicGeometry.Spec A_i) :=
      (AlgebraicGeometry.IsArtinianScheme.iff_isNoetherian_and_discreteTopology.mp inferInstance).2
    have hinj_iso : Function.Injective F_i.isoSpec.hom.base := fun x y hxy => by
      have h := congrArg F_i.isoSpec.inv.base hxy
      simp only [← AlgebraicGeometry.Scheme.Hom.comp_apply, F_i.isoSpec.hom_inv_id] at h
      exact h
    refine ⟨Finite.of_injective F_i.isoSpec.hom.base hinj_iso, fun w => ?_⟩
    have hw_cl : IsClosed ({w} : Set ↥F_i) := by
      have hpre : F_i.isoSpec.hom.base ⁻¹' ({F_i.isoSpec.hom.base w} : Set ↥(AlgebraicGeometry.Spec A_i)) = {w} := by
        ext w'
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact ⟨fun h => hinj_iso h, fun h => congrArg F_i.isoSpec.hom.base h⟩
      rw [← hpre]
      exact (isClosed_discrete _).preimage F_i.isoSpec.hom.continuous
    have himg : fst_i.base '' ({w} : Set ↥F_i) = {fst_i.base w} := Set.image_singleton
    rw [← himg]
    exact hcl_fst.isClosedEmbedding.isClosedMap _ hw_cl

  have hBdry_finite : BdrySet.Finite := by
    rw [hBdry_eq_iUnion]
    refine Set.finite_iUnion (fun i => ?_)
    have _ : Finite ↥(CategoryTheory.Limits.pullback p_bar' (s_bdry' i)) := (hFib_fin_cl i).1
    exact Set.finite_range _
  have _ : Finite ↥BdrySet := hBdry_finite.to_subtype

  have hBdry_cl : ∀ z : ↥BdrySet, IsClosed ({z.1} : Set ↥Y_bar.left) := by
    rintro ⟨z, hz⟩
    rw [hBdry_eq_iUnion, Set.mem_iUnion] at hz
    obtain ⟨i, w, rfl⟩ := hz
    exact (hFib_fin_cl i).2 w

  let M_bdry : ℕ := Nat.card ↥BdrySet
  let e_bdry : Fin M_bdry ≃ ↥BdrySet := (Finite.equivFin ↥BdrySet).symm
  let z_bdry : Fin M_bdry → (S₀ ⟶ Y_bar.left) :=
    fun t => Classical.choose (hZariski Y_bar.left Y_bar.hom (e_bdry t).1 (hBdry_cl (e_bdry t))).2

  have hz_spec : ∀ t : Fin M_bdry,
      z_bdry t ≫ Y_bar.hom = 𝟙 S₀ ∧
      AlgebraicGeometry.IsClosedImmersion (z_bdry t) ∧
      (z_bdry t).base pt₀ = (e_bdry t).1 ∧
      Set.range (z_bdry t).base = {(e_bdry t).1} := by
    intro t
    obtain ⟨hsec, hpt⟩ :=
      Classical.choose_spec (hZariski Y_bar.left Y_bar.hom (e_bdry t).1 (hBdry_cl (e_bdry t))).2
    have _ : AlgebraicGeometry.IsClosedImmersion (z_bdry t ≫ Y_bar.hom) := by
      rw [hsec]; infer_instance
    have hcl : AlgebraicGeometry.IsClosedImmersion (z_bdry t) :=
      AlgebraicGeometry.IsClosedImmersion.of_comp (z_bdry t) Y_bar.hom
    refine ⟨hsec, hcl, hpt, ?_⟩
    rw [hrange_S₀, hpt]

  have hz_disj : ∀ t₁ t₂ : Fin M_bdry, t₁ ≠ t₂ →
      Disjoint (Set.range (z_bdry t₁).base) (Set.range (z_bdry t₂).base) := by
    intro t₁ t₂ hne
    rw [(hz_spec t₁).2.2.2, (hz_spec t₂).2.2.2, Set.disjoint_singleton]
    intro heq
    exact hne (e_bdry.injective (Subtype.ext heq))

  have hz_compl : (Set.range j_V.base)ᶜ = ⋃ t : Fin M_bdry, Set.range (z_bdry t).base := by
    ext z
    simp only [Set.mem_iUnion]
    refine ⟨fun hz => ?_, ?_⟩
    · refine ⟨e_bdry.symm ⟨z, hz⟩, ?_⟩
      rw [(hz_spec _).2.2.2, e_bdry.apply_symm_apply]
      exact Set.mem_singleton z
    · rintro ⟨t, ht⟩
      rw [(hz_spec t).2.2.2, Set.mem_singleton_iff] at ht
      rw [ht]
      exact (e_bdry t).2

  have hcomp_z : ∀ ι : Fin m_c,
      ∃ t : Fin M_bdry, Set.range (z_bdry t).base ⊆ Set.range (inc_comp ι).base := by
    intro ι
    obtain ⟨y, hy_inc, hy_not_U⟩ := (hcomp ι).2.2.2.2
    have hy_Bdry : y ∈ BdrySet := by
      dsimp [BdrySet]
      rw [hj_V_range]
      exact hy_not_U
    refine ⟨e_bdry.symm ⟨y, hy_Bdry⟩, ?_⟩
    rw [(hz_spec _).2.2.2, e_bdry.apply_symm_apply, Set.singleton_subset_iff]
    exact hy_inc

  
  
  
  obtain ⟨_, g_Y_iso, hg_Y_hom, hg_Y_lin⟩ := hGeomFrob_props Y_ov
  obtain ⟨hD_pow, _, _, _⟩ := hGeomFrob_props D_ov
  let φ_abs : Y_bar.left ⟶ Y_bar.left := φ_F Y_bar.left (Y_bar.hom ≫ f₂)
  let α_geom : CategoryTheory.Iso Y_bar.left Y_bar.left := g_Y_iso ≪≫ m_Y_bar
  let α_tot : Y_bar.left ⟶ Y_bar.left := φ_abs ≫ α_geom.hom

  have hα_p : α_geom.hom ≫ p_bar' = p_bar' ≫ g_D_r := by
    dsimp [α_geom, g_D_r]
    rw [Category.assoc, hm_Y_bar_p, hg_Y_hom]
    exact (hGeom_nat p₀' p_bar' hp_bar'_fst hp_bar'_snd).symm

  have hα_j : j_V ≫ α_geom.hom = α_σ ≫ j_V := by
    dsimp [α_geom, α_σ]
    rw [← Category.assoc, hg_Y_hom, hGeom_nat j_V₀' j_V hj_V_fst hj_V_snd,
      Category.assoc, hm_Y_bar_j, Category.assoc]

  have hα_tot_hom : α_tot ≫ Y_bar.hom = Y_bar.hom := by
    change (φ_abs ≫ g_Y_iso.hom ≫ m_Y_bar.hom) ≫ snd_Y = snd_Y
    rw [Category.assoc, Category.assoc, hm_Y_bar_snd, ← Category.assoc]
    exact hg_Y_lin

  have hα_tot_base : ∀ z : ↥Y_bar.left, α_tot.base z = α_geom.hom.base z := by
    intro z
    change (φ_abs ≫ α_geom.hom).base z = α_geom.hom.base z
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    have hbase := (hφ_F_abs Y_bar.left (Y_bar.hom ≫ f₂)).2.1
    have hpt : φ_abs.base z = z := by
      change (TopCat.Hom.hom φ_abs.base) z = z
      rw [hbase]
      rfl
    rw [hpt]

  have hα_mem_range : ∀ z : ↥Y_bar.left,
      α_geom.hom.base z ∈ Set.range j_V.base ↔ z ∈ Set.range j_V.base := by
    intro z
    rw [hj_V_range]
    change pr_D.base (p_bar'.base (α_geom.hom.base z)) ∈ U₀ ↔ pr_D.base (p_bar'.base z) ∈ U₀
    have hpt : pr_D.base (p_bar'.base (α_geom.hom.base z)) = pr_D.base (p_bar'.base z) := by
      have hcomm : (α_geom.hom ≫ p_bar') ≫ pr_D = p_bar' ≫ pr_D := by
        rw [hα_p, Category.assoc]
        exact congrArg (p_bar' ≫ ·) ((hD_pow r).1)
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using
        congrArg (fun f : Y_bar.left ⟶ D_ov.left => f.base z) hcomm
    rw [hpt]

  have hα_mem_Bdry : ∀ z : ↥Y_bar.left, α_geom.hom.base z ∈ BdrySet ↔ z ∈ BdrySet :=
    fun z => not_congr (hα_mem_range z)

  have hα_inv_hom_pt : ∀ z : ↥Y_bar.left, α_geom.hom.base (α_geom.inv.base z) = z := by
    intro z
    have h1 := congrArg (fun f : Y_bar.left ⟶ Y_bar.left => f.base z) α_geom.inv_hom_id
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at h1
    exact h1
  have hα_hom_inv_pt : ∀ z : ↥Y_bar.left, α_geom.inv.base (α_geom.hom.base z) = z := by
    intro z
    have h1 := congrArg (fun f : Y_bar.left ⟶ Y_bar.left => f.base z) α_geom.hom_inv_id
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at h1
    exact h1

  let perm_bdry : Equiv.Perm ↥BdrySet :=
    { toFun := fun z => ⟨α_geom.hom.base z.1, (hα_mem_Bdry z.1).mpr z.2⟩
      invFun := fun z => ⟨α_geom.inv.base z.1, (hα_mem_Bdry _).mp (by rw [hα_inv_hom_pt]; exact z.2)⟩
      left_inv := fun z => Subtype.ext (hα_hom_inv_pt z.1)
      right_inv := fun z => Subtype.ext (hα_inv_hom_pt z.1) }

  let π_bdry : Equiv.Perm (Fin M_bdry) := e_bdry.trans (perm_bdry.trans e_bdry.symm)

  have hπ_bdry_pt : ∀ t : Fin M_bdry, (e_bdry (π_bdry t)).1 = α_geom.hom.base (e_bdry t).1 := by
    intro t
    dsimp [π_bdry, perm_bdry]
    rw [e_bdry.apply_symm_apply]

  have hπ_bdry_sec : ∀ t : Fin M_bdry, z_bdry t ≫ α_tot = z_bdry (π_bdry t) := by
    intro t
    apply hsec_uniq
    · rw [Category.assoc, hα_tot_hom, (hz_spec t).1]
    · exact (hz_spec (π_bdry t)).1
    · rw [hrange_S₀, (hz_spec (π_bdry t)).2.2.2, AlgebraicGeometry.Scheme.Hom.comp_apply,
        (hz_spec t).2.2.1, hα_tot_base, hπ_bdry_pt]

  let inc_comp' : ∀ ι : Fin m_c, (Y_comp ι).left ⟶ Y_bar.left := fun ι => inc_comp ι
  let C_set : Fin m_c → Set ↥Y_bar.left := fun ι => Set.range (inc_comp' ι).base
  have hClopen_C : ∀ ι : Fin m_c, IsClopen (C_set ι) := by
    intro ι
    have _ : AlgebraicGeometry.IsOpenImmersion (inc_comp' ι) := (hcomp ι).2.1
    have hcl : AlgebraicGeometry.IsClosedImmersion (inc_comp' ι) := (hcomp ι).2.2.1
    exact ⟨hcl.isClosedEmbedding.isClosed_range, (inc_comp' ι).isOpenEmbedding.isOpen_range⟩

  have hComp_dest : ∀ (f : Y_bar.left ⟶ Y_bar.left) (ι : Fin m_c),
      ∃ ι' : Fin m_c, Set.range (inc_comp' ι ≫ f).base ⊆ C_set ι' := by
    intro f ι
    have _ : AlgebraicGeometry.IsIntegral (Y_comp ι).left := (hcomp ι).2.2.2.1
    have _ : IrreducibleSpace ↥(Y_comp ι).left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (Y_comp ι).left
    obtain ⟨x₀⟩ : Nonempty ↥(Y_comp ι).left := inferInstance
    have hmem_univ : (inc_comp' ι ≫ f).base x₀ ∈ (Set.univ : Set ↥Y_bar.left) := Set.mem_univ _
    rw [← hcomp_univ, Set.mem_iUnion] at hmem_univ
    obtain ⟨ι', hι'⟩ := hmem_univ
    have hclop_pre : IsClopen ((inc_comp' ι ≫ f).base ⁻¹' C_set ι') :=
      (hClopen_C ι').preimage (inc_comp' ι ≫ f).continuous
    rcases isClopen_iff.mp hclop_pre with hempty | huniv
    · exfalso
      have hx₀ : x₀ ∈ (inc_comp' ι ≫ f).base ⁻¹' C_set ι' := hι'
      rw [hempty] at hx₀
      exact hx₀
    · refine ⟨ι', ?_⟩
      rintro _ ⟨x, rfl⟩
      have hx : x ∈ (Set.univ : Set ↥(Y_comp ι).left) := Set.mem_univ x
      rw [← huniv] at hx
      exact hx

  let toFun_α : Fin m_c → Fin m_c := fun ι => Classical.choose (hComp_dest α_geom.hom ι)
  let invFun_α : Fin m_c → Fin m_c := fun ι => Classical.choose (hComp_dest α_geom.inv ι)
  have h_toFun_α : ∀ ι : Fin m_c, Set.range (inc_comp' ι ≫ α_geom.hom).base ⊆ C_set (toFun_α ι) :=
    fun ι => Classical.choose_spec (hComp_dest α_geom.hom ι)
  have h_invFun_α : ∀ ι : Fin m_c, Set.range (inc_comp' ι ≫ α_geom.inv).base ⊆ C_set (invFun_α ι) :=
    fun ι => Classical.choose_spec (hComp_dest α_geom.inv ι)

  have hC_eq_of_mem : ∀ {ι₁ ι₂ : Fin m_c} {z : ↥Y_bar.left},
      z ∈ C_set ι₁ → z ∈ C_set ι₂ → ι₁ = ι₂ := by
    intro ι₁ ι₂ z hz₁ hz₂
    by_contra hne
    exact Set.disjoint_left.mp (hcomp_disj ι₁ ι₂ hne) hz₁ hz₂

  let π_α : Equiv.Perm (Fin m_c) :=
    { toFun := toFun_α
      invFun := invFun_α
      left_inv := fun ι => by
        have _ : AlgebraicGeometry.IsIntegral (Y_comp ι).left := (hcomp ι).2.2.2.1
        have _ : IrreducibleSpace ↥(Y_comp ι).left :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral (Y_comp ι).left
        obtain ⟨x₀⟩ : Nonempty ↥(Y_comp ι).left := inferInstance
        obtain ⟨x₁, hx₁⟩ := h_toFun_α ι ⟨x₀, rfl⟩
        have hz_back : (inc_comp' ι).base x₀ ∈ C_set (invFun_α (toFun_α ι)) := by
          have h1 : (inc_comp' (toFun_α ι) ≫ α_geom.inv).base x₁ = (inc_comp' ι).base x₀ := by
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hx₁, AlgebraicGeometry.Scheme.Hom.comp_apply,
              hα_hom_inv_pt]
          rw [← h1]
          exact h_invFun_α (toFun_α ι) ⟨x₁, rfl⟩
        exact hC_eq_of_mem hz_back ⟨x₀, rfl⟩
      right_inv := fun ι => by
        have _ : AlgebraicGeometry.IsIntegral (Y_comp ι).left := (hcomp ι).2.2.2.1
        have _ : IrreducibleSpace ↥(Y_comp ι).left :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral (Y_comp ι).left
        obtain ⟨x₀⟩ : Nonempty ↥(Y_comp ι).left := inferInstance
        obtain ⟨x₁, hx₁⟩ := h_invFun_α ι ⟨x₀, rfl⟩
        have hz_back : (inc_comp' ι).base x₀ ∈ C_set (toFun_α (invFun_α ι)) := by
          have h1 : (inc_comp' (invFun_α ι) ≫ α_geom.hom).base x₁ = (inc_comp' ι).base x₀ := by
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hx₁, AlgebraicGeometry.Scheme.Hom.comp_apply,
              hα_inv_hom_pt]
          rw [← h1]
          exact h_toFun_α (invFun_α ι) ⟨x₁, rfl⟩
        exact hC_eq_of_mem hz_back ⟨x₀, rfl⟩ }

  have hπ_α_range : ∀ ι : Fin m_c,
      Set.range (inc_comp' ι ≫ α_tot).base ⊆ C_set (π_α ι) := by
    rintro ι _ ⟨x, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hα_tot_base,
      ← AlgebraicGeometry.Scheme.Hom.comp_apply]
    exact h_toFun_α ι ⟨x, rfl⟩

  let α_fix : ∀ (ι : Fin m_c), π_α ι = ι → ((Y_comp ι).left ⟶ (Y_comp ι).left) :=
    fun ι h =>
      letI : AlgebraicGeometry.IsOpenImmersion (inc_comp' ι) := (hcomp ι).2.1
      AlgebraicGeometry.IsOpenImmersion.lift (inc_comp' ι) (inc_comp' ι ≫ α_tot)
        (by
          change Set.range (inc_comp' ι ≫ α_tot).base ⊆ C_set ι
          conv_rhs => rw [← h]
          exact hπ_α_range ι)

  have hα_fix_fac : ∀ (ι : Fin m_c) (h : π_α ι = ι),
      α_fix ι h ≫ inc_comp' ι = inc_comp' ι ≫ α_tot := by
    intro ι h
    have _ : AlgebraicGeometry.IsOpenImmersion (inc_comp' ι) := (hcomp ι).2.1
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac (inc_comp' ι) (inc_comp' ι ≫ α_tot) _

  have hα_fix_hom : ∀ (ι : Fin m_c) (h : π_α ι = ι),
      α_fix ι h ≫ (Y_comp ι).hom = (Y_comp ι).hom := by
    intro ι h
    have hcomp_hom : inc_comp' ι ≫ Y_bar.hom = (Y_comp ι).hom := (hcomp ι).1
    rw [← hcomp_hom, ← Category.assoc, hα_fix_fac ι h, Category.assoc, hα_tot_hom]

  have hα_fix_fact : ∀ (ι : Fin m_c) (h : π_α ι = ι),
      α_fix ι h ≫ inc_comp' ι = inc_comp' ι ≫ α_tot ∧
      ∃ (φ_comp β_comp : (Y_comp ι).left ⟶ (Y_comp ι).left),
        WeilTopDegIsIteratedAbsFrob p μ (Y_comp ι).left φ_comp ∧
        α_fix ι h = φ_comp ≫ β_comp := by
    intro ι h
    have _ : AlgebraicGeometry.IsOpenImmersion (inc_comp' ι) := (hcomp ι).2.1
    let φ_comp : (Y_comp ι).left ⟶ (Y_comp ι).left :=
      φ_F (Y_comp ι).left ((Y_comp ι).hom ≫ f₂)
    let β_comp : (Y_comp ι).left ⟶ (Y_comp ι).left :=
      AlgebraicGeometry.IsOpenImmersion.lift (inc_comp' ι)
        (inc_comp' ι ≫ α_geom.hom) (by
          change Set.range (inc_comp' ι ≫ α_geom.hom).base ⊆ C_set ι
          conv_rhs => rw [← h]
          exact h_toFun_α ι)
    have hβ_fac : β_comp ≫ inc_comp' ι = inc_comp' ι ≫ α_geom.hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (inc_comp' ι) (inc_comp' ι ≫ α_geom.hom) _
    refine ⟨hα_fix_fac ι h, φ_comp, β_comp, hφ_F_abs _ _, ?_⟩
    apply (cancel_mono (inc_comp' ι)).mp
    rw [hα_fix_fac ι h, Category.assoc, hβ_fac, ← Category.assoc]
    have hnat : φ_comp ≫ inc_comp' ι = inc_comp' ι ≫ φ_abs :=
      hφ_F_nat ((Y_comp ι).hom ≫ f₂) (Y_bar.hom ≫ f₂) (inc_comp' ι)
    rw [← Category.assoc, hnat]

  
  let Fix_Y := { z : ↥Y_bar.left // IsClosed ({z} : Set ↥Y_bar.left) ∧ α_geom.hom.base z = z }
  let LHS := { y : ↥V_bar // IsClosed ({y} : Set ↥V_bar) ∧ α_σ.base y = y } ⊕
    { t : Fin M_bdry // π_bdry t = t }
  let RHS := Σ ι : Fin m_c,
    { x : ↥(Y_comp ι).left //
      ∃ h : π_α ι = ι, IsClosed ({x} : Set ↥(Y_comp ι).left) ∧ (α_fix ι h).base x = x }

  let f_left : LHS → Fix_Y := fun s =>
    match s with
    | Sum.inl y =>
      ⟨j_V.base y.1, (hj_closed y.1).mp y.2.1, by
        have h1 := congrArg (fun f : V_bar ⟶ Y_bar.left => f.base y.1) hα_j
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply, y.2.2] using h1⟩
    | Sum.inr t =>
      ⟨(e_bdry t.1).1, hBdry_cl (e_bdry t.1), by
        rw [← hπ_bdry_pt t.1, t.2]⟩

  have hf_left_bij : Function.Bijective f_left := by
    refine ⟨?_, ?_⟩
    · rintro (y₁ | t₁) (y₂ | t₂) heq
      · have h : j_V.base y₁.1 = j_V.base y₂.1 := congrArg Subtype.val heq
        exact congrArg Sum.inl (Subtype.ext (j_V.isOpenEmbedding.injective h))
      · exfalso
        have h : j_V.base y₁.1 = (e_bdry t₂.1).1 := congrArg Subtype.val heq
        exact (e_bdry t₂.1).2 ⟨y₁.1, h⟩
      · exfalso
        have h : (e_bdry t₁.1).1 = j_V.base y₂.1 := congrArg Subtype.val heq
        exact (e_bdry t₁.1).2 ⟨y₂.1, h.symm⟩
      · have h : (e_bdry t₁.1).1 = (e_bdry t₂.1).1 :=
          congrArg (Subtype.val : Fix_Y → ↥Y_bar.left) heq
        exact congrArg Sum.inr (Subtype.ext (e_bdry.injective (Subtype.ext h)))
    · rintro ⟨z, hz_cl, hz_fix⟩
      by_cases hz : z ∈ Set.range j_V.base
      · obtain ⟨y, rfl⟩ := hz
        have hy_cl : IsClosed ({y} : Set ↥V_bar) := (hj_closed y).mpr hz_cl
        have hy_fix : α_σ.base y = y := by
          apply j_V.isOpenEmbedding.injective
          have h1 := congrArg (fun f : V_bar ⟶ Y_bar.left => f.base y) hα_j.symm
          simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply, hz_fix] using h1
        exact ⟨Sum.inl ⟨y, hy_cl, hy_fix⟩, rfl⟩
      · have hz_Bdry : z ∈ BdrySet := hz
        let t := e_bdry.symm ⟨z, hz_Bdry⟩
        have ht_val : (e_bdry t).1 = z := by
          dsimp [t]; rw [e_bdry.apply_symm_apply]
        have ht_fix : π_bdry t = t := by
          apply e_bdry.injective
          apply Subtype.ext
          rw [hπ_bdry_pt t, ht_val, hz_fix]
        refine ⟨Sum.inr ⟨t, ht_fix⟩, Subtype.ext ht_val⟩

  let f_right : RHS → Fix_Y := fun p =>
    ⟨(inc_comp' p.1).base p.2.1, by
      rcases p.2.2 with ⟨_, hx_cl, _⟩
      have hcl : AlgebraicGeometry.IsClosedImmersion (inc_comp' p.1) := (hcomp p.1).2.2.1
      have himg : (inc_comp' p.1).base '' ({p.2.1} : Set ↥(Y_comp p.1).left) =
          {(inc_comp' p.1).base p.2.1} := Set.image_singleton
      rw [← himg]
      exact hcl.isClosedEmbedding.isClosedMap _ hx_cl, by
      rcases p.2.2 with ⟨h, _, hx_fix⟩
      rw [← hα_tot_base]
      have h1 := congrArg (fun f : (Y_comp p.1).left ⟶ Y_bar.left => f.base p.2.1)
        (hα_fix_fac p.1 h).symm
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply, hx_fix] using h1⟩

  have hf_right_bij : Function.Bijective f_right := by
    refine ⟨?_, ?_⟩
    · rintro ⟨ι₁, ⟨x₁, hprop₁⟩⟩ ⟨ι₂, ⟨x₂, hprop₂⟩⟩ heq
      have hz_eq : (inc_comp' ι₁).base x₁ = (inc_comp' ι₂).base x₂ := congrArg Subtype.val heq
      have hι_eq : ι₁ = ι₂ := hC_eq_of_mem ⟨x₁, rfl⟩ ⟨x₂, hz_eq.symm⟩
      subst hι_eq
      have _ : AlgebraicGeometry.IsOpenImmersion (inc_comp' ι₁) := (hcomp ι₁).2.1
      have hx_eq : x₁ = x₂ := (inc_comp' ι₁).isOpenEmbedding.injective hz_eq
      subst hx_eq
      rfl
    · rintro ⟨z, hz_cl, hz_fix⟩
      have hz_univ : z ∈ (Set.univ : Set ↥Y_bar.left) := Set.mem_univ z
      rw [← hcomp_univ, Set.mem_iUnion] at hz_univ
      obtain ⟨ι, x, rfl⟩ := hz_univ
      change IsClosed ({(inc_comp' ι).base x} : Set ↥Y_bar.left) at hz_cl
      change α_geom.hom.base ((inc_comp' ι).base x) = (inc_comp' ι).base x at hz_fix
      have _ : AlgebraicGeometry.IsOpenImmersion (inc_comp' ι) := (hcomp ι).2.1
      have h_fix_ι : π_α ι = ι := by
        have hz_in_πα : (inc_comp' ι).base x ∈ C_set (π_α ι) := by
          rw [← hz_fix, ← AlgebraicGeometry.Scheme.Hom.comp_apply]
          exact h_toFun_α ι ⟨x, rfl⟩
        exact hC_eq_of_mem hz_in_πα ⟨x, rfl⟩
      have hx_cl : IsClosed ({x} : Set ↥(Y_comp ι).left) := by
        have hpre : (inc_comp' ι).base ⁻¹' ({(inc_comp' ι).base x} : Set ↥Y_bar.left) = {x} := by
          ext x'
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact ⟨fun h => (inc_comp' ι).isOpenEmbedding.injective h,
            fun h => congrArg (inc_comp' ι).base h⟩
        rw [← hpre]
        exact hz_cl.preimage (inc_comp' ι).continuous
      have hx_fix : (α_fix ι h_fix_ι).base x = x := by
        apply (inc_comp' ι).isOpenEmbedding.injective
        have h1 := congrArg (fun f : (Y_comp ι).left ⟶ Y_bar.left => f.base x)
          (hα_fix_fac ι h_fix_ι)
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply, hα_tot_base, hz_fix] using h1
      exact ⟨⟨ι, ⟨x, h_fix_ι, hx_cl, hx_fix⟩⟩, Subtype.ext rfl⟩

  let e_tot : LHS ≃ RHS :=
    (Equiv.ofBijective f_left hf_left_bij).trans (Equiv.ofBijective f_right hf_right_bij).symm

  exact ⟨hFactP, μ, M_bdry, j_V, z_bdry, α_geom, φ_abs, π_bdry, π_α, α_fix, hα_fix_hom,
    hμ, hj_V_open, hj_V_p, hj_V_range,
    fun t => ⟨(hz_spec t).1, (hz_spec t).2.1⟩,
    hz_disj, hz_compl, hcomp_z, hα_p, hα_j, hφ_F_abs _ _,
    hπ_bdry_sec, hπ_α_range, hα_fix_fact, ⟨e_tot⟩⟩

theorem weil_curve_tr_geom_completion_and_twisted_relFrob (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (B₀ L₀ : Type u)
    [CommRing B₀] [IsDomain B₀] [Field L₀]
    [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra F L₀] [Algebra (Polynomial F) L₀] [Algebra (RatFunc F) L₀]
    [Algebra B₀ L₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsScalarTower F (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) B₀ L₀]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀ L₀]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsFractionRing B₀ L₀]
    [IsIntegralClosure B₀
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [FiniteDimensional (RatFunc F) L₀]
    [IsGalois (RatFunc F) L₀]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (r : ℕ) (hr : 1 ≤ r)
    (σ : B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀)
    (ι_bar : Quiver.Hom (weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)))
    (hι_fst : CategoryTheory.CategoryStruct.comp ι_bar
        (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst (weilCurveTrGeomCoverOver F B₀).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap
                (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
                B₀)))
            e_U.hom)
          U₀.ι))
    (hι_snd : CategoryTheory.CategoryStruct.comp ι_bar
        (CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) =
      CategoryTheory.Limits.pullback.snd (weilCurveTrGeomCoverOver F B₀).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let k := AlgebraicClosure F
    let D_ov := weilProjectiveSpaceOver F 1
    let D_bar_ov := weilBaseChangeOver F k D_ov
    let D_bar := weilGeomScheme F D_ov
    let V_ov := weilCurveTrGeomCoverOver F B₀
    let V_bar := weilGeomScheme F V_ov
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let pr_D : Quiver.Hom D_bar D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
    let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
    let α_σ : Quiver.Hom V_bar V_bar :=
      CategoryTheory.CategoryStruct.comp
        (weilSchemeEndPow (weilGeomFrobHom F V_ov) r)
        (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)
    let g_D_r : Quiver.Hom D_bar D_bar := weilSchemeEndPow (weilGeomFrobHom F D_ov) r
    ∃ (_ : Fact (Nat.Prime (ringChar F)))
      (μ d_cov m_bdry M_bdry m_c m_sheet : ℕ)
      (g_Dr_iso : CategoryTheory.Iso D_bar D_bar)
      (π_bar : Quiver.Hom V_bar U_bar.toScheme)
      (s_bdry : Fin m_bdry → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) D_bar)
      (Y_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p_bar : Quiver.Hom Y_bar.left D_bar)
      (j_V : Quiver.Hom V_bar Y_bar.left)
