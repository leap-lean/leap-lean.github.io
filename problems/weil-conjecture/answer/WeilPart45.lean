      (φ_abs : Quiver.Hom Y_bar.left Y_bar.left)
      (π_bdry : Equiv.Perm (Fin M_bdry))
      (π_α : Equiv.Perm (Fin m_c))
      (α_fix : ∀ (ι : Fin m_c), π_α ι = ι → Quiver.Hom (Y_comp ι).left (Y_comp ι).left)
