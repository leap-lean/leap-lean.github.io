    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, map_smul, hfg j]

  have hMatExt : ∀ {R : Type} [CommRing R] {m n : ℕ} {A B : Matrix (Fin m) (Fin n) R},
      A.mulVecLin = B.mulVecLin → A = B := by
    intro R _ m n A B hAB
    ext i j
    have h1 := congrFun (LinearMap.congr_fun hAB (Pi.single j (1 : R))) i
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using h1

  have hBlockD : ∃ (P_K : WeilCurveTrFreeComplex (ℓ ^ K)),
      let d₀_P := ((P_K.D₀).map cast_s).mulVecLin
      let d₁_P := ((P_K.D₁).map cast_s).mulVecLin
      let φ₀_P := ((P_K.Φ₀).map cast_s).mulVecLin
      let φ₁_P := ((P_K.Φ₁).map cast_s).mulVecLin
      let φ₂_P := ((P_K.Φ₂).map cast_s).mulVecLin
      WeilCurveTrHasBoundedLatticeModel ℓ K B₁ P_K b_J M_lat_J ∧
      ∃ (γJ₀ : (Fin P_K.n₀ → Λ_s) →+ IG₀)
        (γJ₁ : (Fin P_K.n₁ → Λ_s) →+ IG₁)
        (γJ₂ : (Fin P_K.n₂ → Λ_s) →+ IG₂)
        (hJ₁ : (Fin P_K.n₁ → Λ_s) →+ IG₀)
        (hJ₂ : (Fin P_K.n₂ → Λ_s) →+ IG₁),
        (∀ x, dIG₀ (γJ₀ x) = γJ₁ (d₀_P x)) ∧
        (∀ x, dIG₁ (γJ₁ x) = γJ₂ (d₁_P x)) ∧
        (∀ x, ψG₀ (γJ₀ x) - γJ₀ (φ₀_P x) = hJ₁ (d₀_P x)) ∧
        (∀ x, ψG₁ (γJ₁ x) - γJ₁ (φ₁_P x) = dIG₀ (hJ₁ x) + hJ₂ (d₁_P x)) ∧
        (∀ x, ψG₂ (γJ₂ x) - γJ₂ (φ₂_P x) = dIG₁ (hJ₂ x)) ∧
        (∀ x, d₀_P x = 0 → γJ₀ x = 0 → x = 0) ∧
        (∀ y : IG₀, dIG₀ y = 0 → ∃ x, d₀_P x = 0 ∧ γJ₀ x = y) ∧
        (∀ x, d₁_P x = 0 → (∃ z, γJ₁ x = dIG₀ z) → x ∈ LinearMap.range d₀_P) ∧
        (∀ y : IG₁, dIG₁ y = 0 → ∃ x, d₁_P x = 0 ∧ ∃ z, y - γJ₁ x = dIG₀ z) ∧
        (∀ x, (∃ z, γJ₂ x = dIG₁ z) → x ∈ LinearMap.range d₁_P) ∧
        (∀ y : IG₂, ∃ x, ∃ z, y - γJ₂ x = dIG₁ z) := by
    obtain ⟨modJ₀, hsmulJ₀_raw⟩ := hZModMod_u (ℓ ^ K) h1_lt_K J₀ hTorJ.1
    obtain ⟨modJ₁, hsmulJ₁_raw⟩ := hZModMod_u (ℓ ^ K) h1_lt_K J₁ hTorJ.2.1
    obtain ⟨modJ₂, hsmulJ₂_raw⟩ := hZModMod_u (ℓ ^ K) h1_lt_K J₂ hTorJ.2.2
    let _ : Module Λ_K J₀ := modJ₀
    let _ : Module Λ_K J₁ := modJ₁
    let _ : Module Λ_K J₂ := modJ₂
    have hsmulJ₀ : ∀ (c : Λ_K) (x : J₀), c • x = c.val • x := hsmulJ₀_raw
    have hsmulJ₁ : ∀ (c : Λ_K) (x : J₁), c • x = c.val • x := hsmulJ₁_raw
    have hsmulJ₂ : ∀ (c : Λ_K) (x : J₂), c • x = c.val • x := hsmulJ₂_raw

    let mkJLin : ∀ {X Y : Type u} [AddCommGroup X] [AddCommGroup Y] [Module Λ_K X] [Module Λ_K Y]
        (_hX : ∀ (c : Λ_K) (x : X), c • x = c.val • x)
        (_hY : ∀ (c : Λ_K) (y : Y), c • y = c.val • y)
        (f : X →+ Y), X →ₗ[Λ_K] Y :=
      fun {X Y} _ _ _ _ hX hY f =>
        { toFun := f
          map_add' := f.map_add
          map_smul' := fun c x => by
            dsimp
            rw [hX c x, hY c (f x), map_nsmul] }

    let dJ₀_L : J₀ →ₗ[Λ_K] J₁ := mkJLin hsmulJ₀ hsmulJ₁ dJ₀
    let dJ₁_L : J₁ →ₗ[Λ_K] J₂ := mkJLin hsmulJ₁ hsmulJ₂ dJ₁
    let ΦJ₀_L : J₀ →ₗ[Λ_K] J₀ := mkJLin hsmulJ₀ hsmulJ₀ ΦJ₀
    let ΦJ₁_L : J₁ →ₗ[Λ_K] J₁ := mkJLin hsmulJ₁ hsmulJ₁ ΦJ₁
    let ΦJ₂_L : J₂ →ₗ[Λ_K] J₂ := mkJLin hsmulJ₂ hsmulJ₂ ΦJ₂

    have hdJ_apply : ∀ x : J₀, dJ₁ (dJ₀ x) = 0 := fun x => DFunLike.congr_fun hdJ.1 x
    have hdΦJ₀_apply : ∀ x : J₀, dJ₀ (ΦJ₀ x) = ΦJ₁ (dJ₀ x) := fun x => DFunLike.congr_fun hdJ.2.1 x
    have hdΦJ₁_apply : ∀ x : J₁, dJ₁ (ΦJ₁ x) = ΦJ₂ (dJ₁ x) := fun x => DFunLike.congr_fun hdJ.2.2 x

    
    have _ : Finite ↥dJ₀.ker := hFinHJ.1
    have _ : Finite (↥dJ₁.ker ⧸ AddSubgroup.comap dJ₁.ker.subtype dJ₀.range) := hFinHJ.2.1
    have _ : Finite (J₂ ⧸ dJ₁.range) := hFinHJ.2.2
    let e₂ := (Finite.equivFin (J₂ ⧸ dJ₁.range)).symm
    let n₂ := Nat.card (J₂ ⧸ dJ₁.range)
    have hy₂_ex : ∀ j : Fin n₂, ∃ y : J₂, QuotientAddGroup.mk' dJ₁.range y = e₂ j :=
      fun j => QuotientAddGroup.mk'_surjective _ (e₂ j)
    let y₂_rep : Fin n₂ → J₂ := fun j => Classical.choose (hy₂_ex j)
    have hy₂_spec : ∀ j : Fin n₂, QuotientAddGroup.mk' dJ₁.range (y₂_rep j) = e₂ j :=
      fun j => Classical.choose_spec (hy₂_ex j)
    let γ₂_J : (Fin n₂ → Λ_K) →ₗ[Λ_K] J₂ := freeHom_0u y₂_rep
    have hConeJ₂ : ∀ y₂ : J₂, ∃ (y₁ : J₁) (p₂ : Fin n₂ → Λ_K), dJ₁ y₁ + γ₂_J p₂ = y₂ := by
      intro y₂
      let j : Fin n₂ := e₂.symm (QuotientAddGroup.mk' dJ₁.range y₂)
      have hq : QuotientAddGroup.mk' dJ₁.range (y₂ - y₂_rep j) = 0 := by
        rw [map_sub, hy₂_spec j, e₂.apply_symm_apply, sub_self]
      rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk'] at hq
      obtain ⟨y₁, hy₁⟩ := hq
      refine ⟨y₁, Pi.single j (1 : Λ_K), ?_⟩
      change dJ₁ y₁ + freeHom_0u y₂_rep (Pi.single j (1 : Λ_K)) = y₂
      rw [hy₁, hFreeHom_0u_single, sub_add_cancel]

    
    let S₂ : Set (Fin n₂ → Λ_K) := { p₂ | ∃ w₁ : J₁, dJ₁ w₁ = γ₂_J p₂ }
    let e₁a := (Finite.equivFin ↥S₂).symm
    let n₁a := Nat.card ↥S₂
    let w₁a : Fin n₁a → J₁ := fun i => Classical.choose (e₁a i).2
    have hw₁a : ∀ i : Fin n₁a, dJ₁ (w₁a i) = γ₂_J (e₁a i).1 :=
      fun i => Classical.choose_spec (e₁a i).2
    let B_J₁ := AddSubgroup.comap dJ₁.ker.subtype dJ₀.range
    let e₁b := (Finite.equivFin (↥dJ₁.ker ⧸ B_J₁)).symm
    let n₁b := Nat.card (↥dJ₁.ker ⧸ B_J₁)
    have hz₁b_ex : ∀ l : Fin n₁b, ∃ z : ↥dJ₁.ker, QuotientAddGroup.mk' B_J₁ z = e₁b l :=
      fun l => QuotientAddGroup.mk'_surjective _ (e₁b l)
    let z₁b : Fin n₁b → ↥dJ₁.ker := fun l => Classical.choose (hz₁b_ex l)
    have hz₁b_spec : ∀ l : Fin n₁b, QuotientAddGroup.mk' B_J₁ (z₁b l) = e₁b l :=
      fun l => Classical.choose_spec (hz₁b_ex l)
    let n₁ := n₁a + n₁b
    let d₁_vec : Fin n₁ → (Fin n₂ → Λ_K) := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => (e₁a i).1
      | Sum.inr _ => 0
    let γ₁_vec : Fin n₁ → J₁ := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => w₁a i
      | Sum.inr l => (z₁b l).1
    let δ₁_J : (Fin n₁ → Λ_K) →ₗ[Λ_K] (Fin n₂ → Λ_K) := freeHom_00 d₁_vec
    let γ₁_J : (Fin n₁ → Λ_K) →ₗ[Λ_K] J₁ := freeHom_0u γ₁_vec
    have hChainJ₁ : dJ₁_L.comp γ₁_J = γ₂_J.comp δ₁_J := by
      apply hFreeExt_0u
      intro k
      simp only [LinearMap.comp_apply, δ₁_J, γ₁_J, hFreeHom_00_single, hFreeHom_0u_single,
        d₁_vec, γ₁_vec]
      rcases finSumFinEquiv.symm k with i | l
      · exact hw₁a i
      · rw [map_zero]
        exact (z₁b l).2
    have hChainJ₁_apply : ∀ x, dJ₁ (γ₁_J x) = γ₂_J (δ₁_J x) := fun x =>
      LinearMap.congr_fun hChainJ₁ x
    have hConeJ₁ : ∀ (y₁ : J₁) (p₂ : Fin n₂ → Λ_K), dJ₁ y₁ + γ₂_J p₂ = 0 →
        ∃ (y₀ : J₀) (p₁ : Fin n₁ → Λ_K), dJ₀ y₀ + γ₁_J p₁ = y₁ ∧ - δ₁_J p₁ = p₂ := by
      intro y₁ p₂ h0
      have hp₂_mem : -p₂ ∈ S₂ := ⟨y₁, by rw [map_neg]; exact eq_neg_of_add_eq_zero_left h0⟩
      let i : Fin n₁a := e₁a.symm ⟨-p₂, hp₂_mem⟩
      have hi_val : (e₁a i).1 = -p₂ := congrArg Subtype.val (e₁a.apply_symm_apply ⟨-p₂, hp₂_mem⟩)
      let p₁a : Fin n₁ → Λ_K := Pi.single (finSumFinEquiv (Sum.inl i)) (1 : Λ_K)
      have hδ₁_a : δ₁_J p₁a = -p₂ := by
        change freeHom_00 d₁_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : Λ_K)) = -p₂
        rw [hFreeHom_00_single]
        dsimp only [d₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
        exact hi_val
      have hγ₁_a : γ₁_J p₁a = w₁a i := by
        change freeHom_0u γ₁_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : Λ_K)) = w₁a i
        rw [hFreeHom_0u_single]
        dsimp only [γ₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hy₁'_ker : y₁ - w₁a i ∈ dJ₁.ker := by
        change dJ₁ (y₁ - w₁a i) = 0
        rw [map_sub, hw₁a i, hi_val, map_neg, sub_neg_eq_add, h0]
      let l : Fin n₁b := e₁b.symm (QuotientAddGroup.mk' B_J₁ ⟨y₁ - w₁a i, hy₁'_ker⟩)
      have hq : QuotientAddGroup.mk' B_J₁ (⟨y₁ - w₁a i, hy₁'_ker⟩ - z₁b l) = 0 := by
        rw [map_sub, hz₁b_spec l, e₁b.apply_symm_apply, sub_self]
      rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk'] at hq
      obtain ⟨y₀, hy₀⟩ := hq
      let p₁b : Fin n₁ → Λ_K := Pi.single (finSumFinEquiv (Sum.inr l)) (1 : Λ_K)
      have hδ₁_b : δ₁_J p₁b = 0 := by
        change freeHom_00 d₁_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : Λ_K)) = 0
        rw [hFreeHom_00_single]
        dsimp only [d₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hγ₁_b : γ₁_J p₁b = (z₁b l).1 := by
        change freeHom_0u γ₁_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : Λ_K)) = (z₁b l).1
        rw [hFreeHom_0u_single]
        dsimp only [γ₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      refine ⟨y₀, p₁a + p₁b, ?_, ?_⟩
      · rw [map_add, hγ₁_a, hγ₁_b]
        have hy₀' : dJ₀ y₀ = y₁ - w₁a i - (z₁b l).1 := hy₀
        rw [hy₀']
        abel
      · rw [map_add, hδ₁_a, hδ₁_b, add_zero, neg_neg]

    
    let S₁ : Set (Fin n₁ → Λ_K) := { p₁ | δ₁_J p₁ = 0 ∧ ∃ w₀ : J₀, dJ₀ w₀ = γ₁_J p₁ }
    let e₀a := (Finite.equivFin ↥S₁).symm
    let m₀a := Nat.card ↥S₁
    let w₀a : Fin m₀a → J₀ := fun i => Classical.choose (e₀a i).2.2
    have hw₀a : ∀ i : Fin m₀a, dJ₀ (w₀a i) = γ₁_J (e₀a i).1 :=
      fun i => Classical.choose_spec (e₀a i).2.2
    let e₀b := (Finite.equivFin ↥dJ₀.ker).symm
    let m₀b := Nat.card ↥dJ₀.ker
    let m₀_J := m₀a + m₀b
    let d₀_vec : Fin m₀_J → (Fin n₁ → Λ_K) := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => (e₀a i).1
      | Sum.inr _ => 0
    let γ₀_vec : Fin m₀_J → J₀ := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => w₀a i
      | Sum.inr l => (e₀b l).1
    let d₀_QJ : (Fin m₀_J → Λ_K) →ₗ[Λ_K] (Fin n₁ → Λ_K) := freeHom_00 d₀_vec
    let γ₀_QJ : (Fin m₀_J → Λ_K) →ₗ[Λ_K] J₀ := freeHom_0u γ₀_vec
    have hd_QJ : δ₁_J.comp d₀_QJ = 0 := by
      apply hFreeExt_00
      intro k
      simp only [LinearMap.comp_apply, LinearMap.zero_apply, d₀_QJ, hFreeHom_00_single, d₀_vec]
      rcases finSumFinEquiv.symm k with i | l
      · exact (e₀a i).2.1
      · exact map_zero δ₁_J
    have hChain₀_QJ : dJ₀_L.comp γ₀_QJ = γ₁_J.comp d₀_QJ := by
      apply hFreeExt_0u
      intro k
      simp only [LinearMap.comp_apply, d₀_QJ, γ₀_QJ, hFreeHom_00_single, hFreeHom_0u_single,
        d₀_vec, γ₀_vec]
      rcases finSumFinEquiv.symm k with i | l
      · exact hw₀a i
      · rw [map_zero]
        exact (e₀b l).2
    let B₀_J : Submodule Λ_K (Fin m₀_J → Λ_K) := LinearMap.ker γ₀_QJ ⊓ LinearMap.ker d₀_QJ
    let P₀_J := (Fin m₀_J → Λ_K) ⧸ B₀_J
    have _ : Finite P₀_J := Quotient.finite _
    let π₀_J : (Fin m₀_J → Λ_K) →ₗ[Λ_K] P₀_J := Submodule.mkQ B₀_J
    let δ₀_PJ : P₀_J →ₗ[Λ_K] (Fin n₁ → Λ_K) := Submodule.liftQ B₀_J d₀_QJ inf_le_right
    let γ₀_PJ : P₀_J →ₗ[Λ_K] J₀ := Submodule.liftQ B₀_J γ₀_QJ inf_le_left
    have hδ_PJ : δ₁_J.comp δ₀_PJ = 0 := by
      apply LinearMap.ext
      intro x
      obtain ⟨q, rfl⟩ := Submodule.Quotient.mk_surjective B₀_J x
      exact LinearMap.congr_fun hd_QJ q
    have hChainJ₀_P : ∀ x : P₀_J, dJ₀ (γ₀_PJ x) = γ₁_J (δ₀_PJ x) := by
      intro x
      obtain ⟨q, rfl⟩ := Submodule.Quotient.mk_surjective B₀_J x
      exact LinearMap.congr_fun hChain₀_QJ q
    have hConeJ₀_P : ∀ (y₀ : J₀) (p₁ : Fin n₁ → Λ_K), dJ₀ y₀ + γ₁_J p₁ = 0 → δ₁_J p₁ = 0 →
        ∃ p₀ : P₀_J, γ₀_PJ p₀ = y₀ ∧ - δ₀_PJ p₀ = p₁ := by
      intro y₀ p₁ h0 hp₁
      have hp₁_mem : -p₁ ∈ S₁ :=
        ⟨by rw [map_neg, hp₁, neg_zero], y₀, by rw [map_neg]; exact eq_neg_of_add_eq_zero_left h0⟩
      let i : Fin m₀a := e₀a.symm ⟨-p₁, hp₁_mem⟩
      have hi_val : (e₀a i).1 = -p₁ := congrArg Subtype.val (e₀a.apply_symm_apply ⟨-p₁, hp₁_mem⟩)
      let q₀a : Fin m₀_J → Λ_K := Pi.single (finSumFinEquiv (Sum.inl i)) (1 : Λ_K)
      have hd₀_a : d₀_QJ q₀a = -p₁ := by
        change freeHom_00 d₀_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : Λ_K)) = -p₁
        rw [hFreeHom_00_single]
        dsimp only [d₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
        exact hi_val
      have hγ₀_a : γ₀_QJ q₀a = w₀a i := by
        change freeHom_0u γ₀_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : Λ_K)) = w₀a i
        rw [hFreeHom_0u_single]
        dsimp only [γ₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hy₀'_ker : y₀ - w₀a i ∈ dJ₀.ker := by
        change dJ₀ (y₀ - w₀a i) = 0
        rw [map_sub, hw₀a i, hi_val, map_neg, sub_neg_eq_add, h0]
      let l : Fin m₀b := e₀b.symm ⟨y₀ - w₀a i, hy₀'_ker⟩
      have hl_val : (e₀b l).1 = y₀ - w₀a i :=
        congrArg Subtype.val (e₀b.apply_symm_apply ⟨y₀ - w₀a i, hy₀'_ker⟩)
      let q₀b : Fin m₀_J → Λ_K := Pi.single (finSumFinEquiv (Sum.inr l)) (1 : Λ_K)
      have hd₀_b : d₀_QJ q₀b = 0 := by
        change freeHom_00 d₀_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : Λ_K)) = 0
        rw [hFreeHom_00_single]
        dsimp only [d₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hγ₀_b : γ₀_QJ q₀b = y₀ - w₀a i := by
        change freeHom_0u γ₀_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : Λ_K)) = y₀ - w₀a i
        rw [hFreeHom_0u_single]
        dsimp only [γ₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
        exact hl_val
      refine ⟨π₀_J (q₀a + q₀b), ?_, ?_⟩
      · change γ₀_QJ (q₀a + q₀b) = y₀
        rw [map_add, hγ₀_a, hγ₀_b, add_sub_cancel]
      · change - d₀_QJ (q₀a + q₀b) = p₁
        rw [map_add, hd₀_a, hd₀_b, add_zero, neg_neg]
    have hConeJ₀_P_inj : ∀ p₀ : P₀_J, γ₀_PJ p₀ = 0 → δ₀_PJ p₀ = 0 → p₀ = 0 := by
      intro p₀ hγ hδ₀
      obtain ⟨q, rfl⟩ := Submodule.Quotient.mk_surjective B₀_J p₀
      exact (Submodule.Quotient.mk_eq_zero B₀_J).mpr ⟨hγ, hδ₀⟩

    
    have hTor_free : ∀ {n : ℕ} (u : Fin n → Λ_K), (ℓ ^ K : ℕ) • u = 0 := by
      intro n u
      ext i
      change (ℓ ^ K : ℕ) • u i = 0
      rw [← Nat.cast_smul_eq_nsmul Λ_K, ZMod.natCast_self, zero_smul]
    have hPer_free : ∀ {n : ℕ} (a : ℕ), a ≤ K →
        ∀ u : Fin n → Λ_K, (ℓ ^ a : ℕ) • u = 0 → ∃ v : Fin n → Λ_K, u = (ℓ ^ (K - a) : ℕ) • v := by
      intro n a ha u hu
      have hcoord : ∀ i : Fin n, ∃ y : Λ_K, u i = (ℓ ^ (K - a) : ℕ) • y := by
        intro i
        have hi : (ℓ ^ a : ℕ) • u i = 0 := congrFun hu i
        have hi' : (((ℓ ^ a * (u i).val : ℕ) : Λ_K)) = 0 := by
          rw [Nat.cast_mul, ZMod.natCast_zmod_val, ← smul_eq_mul, Nat.cast_smul_eq_nsmul]
          exact hi
        have hdvd : ℓ ^ K ∣ ℓ ^ a * (u i).val :=
          (ZMod.natCast_eq_zero_iff _ (ℓ ^ K)).mp hi'
        have hpow_eq : ℓ ^ K = ℓ ^ a * ℓ ^ (K - a) := by
          rw [← pow_add, Nat.add_sub_of_le ha]
        have hdvd2 : ℓ ^ a * ℓ ^ (K - a) ∣ ℓ ^ a * (u i).val :=
          Nat.dvd_trans (dvd_of_eq hpow_eq.symm) hdvd
        have hdvd' : ℓ ^ (K - a) ∣ (u i).val :=
          (Nat.mul_dvd_mul_iff_left (pow_pos hPrime.pos a)).mp hdvd2
        obtain ⟨q, hq⟩ := hdvd'
        refine ⟨(q : Λ_K), ?_⟩
        rw [← Nat.cast_smul_eq_nsmul Λ_K, smul_eq_mul, ← Nat.cast_mul, ← hq, ZMod.natCast_zmod_val]
      refine ⟨fun i => Classical.choose (hcoord i), ?_⟩
      ext i
      exact Classical.choose_spec (hcoord i)

    let Z₁_J : AddSubgroup (J₁ × (Fin n₂ → Λ_K)) :=
      { carrier := { p | dJ₁ p.1 + γ₂_J p.2 = 0 }
        zero_mem' := by simp
        add_mem' := fun {p q} hp hq => by
          change dJ₁ (p.1 + q.1) + γ₂_J (p.2 + q.2) = 0
          rw [map_add, map_add]
          calc dJ₁ p.1 + dJ₁ q.1 + (γ₂_J p.2 + γ₂_J q.2)
              = (dJ₁ p.1 + γ₂_J p.2) + (dJ₁ q.1 + γ₂_J q.2) := by abel
            _ = 0 := by rw [hp, hq, add_zero]
        neg_mem' := fun {p} hp => by
          change dJ₁ (-p.1) + γ₂_J (-p.2) = 0
          rw [map_neg, map_neg, ← neg_add, hp, neg_zero] }
    have hPer_Z₁J : ∀ a : ℕ, a ≤ K →
        ∀ z : ↥Z₁_J, (ℓ ^ a : ℕ) • z = 0 → ∃ w : ↥Z₁_J, z = (ℓ ^ (K - a) : ℕ) • w := by
      intro a ha z hz
      obtain ⟨b₁, hb₁⟩ := (hPerJ a ha).2.1 z.1.1 (congrArg (fun w : ↥Z₁_J => w.1.1) hz)
      obtain ⟨b₂, hb₂⟩ := hPer_free a ha z.1.2 (congrArg (fun w : ↥Z₁_J => w.1.2) hz)
      have hπb : (ℓ ^ (K - a) : ℕ) • (dJ₁ b₁ + γ₂_J b₂) = 0 := by
        rw [nsmul_add, ← map_nsmul, ← map_nsmul, ← hb₁, ← hb₂]
        exact z.2
      have hKa : K - a ≤ K := Nat.sub_le K a
      have hKsub : K - (K - a) = a := Nat.sub_sub_self ha
      obtain ⟨c₂, hc₂⟩ := (hPerJ (K - a) hKa).2.2 _ hπb
      rw [hKsub] at hc₂
      obtain ⟨b₁', b₂', hb'⟩ := hConeJ₂ c₂
      let w_raw : J₁ × (Fin n₂ → Λ_K) := (b₁ - (ℓ ^ a : ℕ) • b₁', b₂ - (ℓ ^ a : ℕ) • b₂')
      have hw_mem : w_raw ∈ Z₁_J := by
        change dJ₁ (b₁ - (ℓ ^ a : ℕ) • b₁') + γ₂_J (b₂ - (ℓ ^ a : ℕ) • b₂') = 0
        rw [map_sub, map_sub, map_nsmul, map_nsmul]
        calc (dJ₁ b₁ - (ℓ ^ a : ℕ) • dJ₁ b₁') + (γ₂_J b₂ - (ℓ ^ a : ℕ) • γ₂_J b₂')
            = (dJ₁ b₁ + γ₂_J b₂) - (ℓ ^ a : ℕ) • (dJ₁ b₁' + γ₂_J b₂') := by rw [nsmul_add]; abel
          _ = 0 := by rw [hb', ← hc₂, sub_self]
      refine ⟨⟨w_raw, hw_mem⟩, Subtype.ext (Prod.ext ?_ ?_)⟩
      · change z.1.1 = (ℓ ^ (K - a) : ℕ) • (b₁ - (ℓ ^ a : ℕ) • b₁')
        rw [nsmul_sub, ← mul_nsmul', ← pow_add, Nat.sub_add_cancel ha, hTorJ.2.1 b₁', sub_zero, hb₁]
      · change z.1.2 = (ℓ ^ (K - a) : ℕ) • (b₂ - (ℓ ^ a : ℕ) • b₂')
        rw [nsmul_sub, ← mul_nsmul', ← pow_add, Nat.sub_add_cancel ha, hTor_free b₂', sub_zero, hb₂]

    have hTor_P₀J : ∀ x : P₀_J, (ℓ ^ K : ℕ) • x = 0 := by
      intro x
      obtain ⟨q, rfl⟩ := Submodule.Quotient.mk_surjective B₀_J x
      change π₀_J ((ℓ ^ K : ℕ) • q) = 0
      rw [hTor_free q, map_zero]
    have hPer_P₀J : ∀ a : ℕ, a ≤ K →
        ∀ x : P₀_J, (ℓ ^ a : ℕ) • x = 0 → ∃ y : P₀_J, x = (ℓ ^ (K - a) : ℕ) • y := by
      intro a ha x hx
      obtain ⟨b₀, hb₀⟩ := (hPerJ a ha).1 (γ₀_PJ x)
        (by rw [← map_nsmul, hx, map_zero])
      obtain ⟨b₁, hb₁⟩ := hPer_free a ha (- δ₀_PJ x)
        (by rw [smul_neg, ← map_nsmul, hx, map_zero, neg_zero])
      have hβb_mem : (dJ₀ b₀ + γ₁_J b₁, - δ₁_J b₁) ∈ Z₁_J := by
        change dJ₁ (dJ₀ b₀ + γ₁_J b₁) + γ₂_J (- δ₁_J b₁) = 0
        rw [map_add, hdJ_apply, zero_add, hChainJ₁_apply, map_neg, add_neg_cancel]
      let z_b : ↥Z₁_J := ⟨(dJ₀ b₀ + γ₁_J b₁, - δ₁_J b₁), hβb_mem⟩
      have hz_b0 : (ℓ ^ (K - a) : ℕ) • z_b = 0 := by
        apply Subtype.ext
        apply Prod.ext
        · change (ℓ ^ (K - a) : ℕ) • (dJ₀ b₀ + γ₁_J b₁) = 0
          rw [nsmul_add, ← map_nsmul, ← map_nsmul, ← hb₀, ← hb₁, map_neg, hChainJ₀_P, add_neg_cancel]
        · change (ℓ ^ (K - a) : ℕ) • (- δ₁_J b₁) = 0
          rw [smul_neg, ← map_nsmul, ← hb₁, map_neg, neg_neg]
          exact LinearMap.congr_fun hδ_PJ x
      have hKa : K - a ≤ K := Nat.sub_le K a
      have hKsub : K - (K - a) = a := Nat.sub_sub_self ha
      obtain ⟨w_z, hw_z⟩ := hPer_Z₁J (K - a) hKa z_b hz_b0
      rw [hKsub] at hw_z
      obtain ⟨b₀', b₁', hb'₁, hb'₂⟩ := hConeJ₁ w_z.1.1 w_z.1.2 w_z.2
      have h0_diff : dJ₀ (b₀ - (ℓ ^ a : ℕ) • b₀') + γ₁_J (b₁ - (ℓ ^ a : ℕ) • b₁') = 0 := by
        have h1 : dJ₀ b₀ + γ₁_J b₁ = (ℓ ^ a : ℕ) • w_z.1.1 := congrArg (fun u : ↥Z₁_J => u.1.1) hw_z
        rw [map_sub, map_sub, map_nsmul, map_nsmul]
        calc (dJ₀ b₀ - (ℓ ^ a : ℕ) • dJ₀ b₀') + (γ₁_J b₁ - (ℓ ^ a : ℕ) • γ₁_J b₁')
            = (dJ₀ b₀ + γ₁_J b₁) - (ℓ ^ a : ℕ) • (dJ₀ b₀' + γ₁_J b₁') := by rw [nsmul_add]; abel
          _ = 0 := by rw [hb'₁, h1, sub_self]
      have h1_diff : δ₁_J (b₁ - (ℓ ^ a : ℕ) • b₁') = 0 := by
        have h2 : - δ₁_J b₁ = (ℓ ^ a : ℕ) • w_z.1.2 := congrArg (fun u : ↥Z₁_J => u.1.2) hw_z
        rw [map_sub, map_nsmul, ← neg_eq_zero, neg_sub]
        calc (ℓ ^ a : ℕ) • δ₁_J b₁' - δ₁_J b₁
            = (- δ₁_J b₁) - (ℓ ^ a : ℕ) • (- δ₁_J b₁') := by rw [smul_neg]; abel
          _ = 0 := by rw [hb'₂, h2, sub_self]
      obtain ⟨y, hy_γ, hy_δ⟩ := hConeJ₀_P _ _ h0_diff h1_diff
      refine ⟨y, ?_⟩
      apply sub_eq_zero.mp
      apply hConeJ₀_P_inj (x - (ℓ ^ (K - a) : ℕ) • y)
      · rw [map_sub, map_nsmul, hy_γ, nsmul_sub, ← mul_nsmul', ← pow_add,
          Nat.sub_add_cancel ha, hTorJ.1 b₀', sub_zero, hb₀, sub_self]
      · rw [map_sub, map_nsmul]
        have hy_δ' : δ₀_PJ y = - (b₁ - (ℓ ^ a : ℕ) • b₁') := neg_eq_iff_eq_neg.mp hy_δ
        have hb₁' : δ₀_PJ x = - ((ℓ ^ (K - a) : ℕ) • b₁) :=
          neg_eq_iff_eq_neg.mp hb₁
        rw [hy_δ', hb₁', smul_neg, nsmul_sub, ← mul_nsmul', ← pow_add,
          Nat.sub_add_cancel ha, hTor_free b₁', sub_zero, sub_neg_eq_add, neg_add_cancel]

    
    let N_ℓ : AddSubgroup P₀_J := AddMonoidHom.range (ℓ • AddMonoidHom.id P₀_J)
    let P_bar := P₀_J ⧸ N_ℓ
    let mk_ℓ : P₀_J →+ P_bar := QuotientAddGroup.mk' N_ℓ
    have _ : Finite P_bar := Quotient.finite _
    have hTor_Pbar : ∀ z : P_bar, ℓ • z = 0 := by
      intro z
      obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective N_ℓ z
      rw [← map_nsmul]
      rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
      exact ⟨x, rfl⟩
    have hmod_ℓ_eq : ∀ (n : ℕ) (z : P_bar), (n % ℓ) • z = n • z := by
      intro n z
      conv_rhs => rw [← Nat.mod_add_div n ℓ]
      rw [add_nsmul, mul_comm ℓ (n / ℓ), mul_nsmul', hTor_Pbar z, nsmul_zero, add_zero]
    let f_end_ℓ : ZMod ℓ →+* AddMonoid.End P_bar :=
      { toFun := fun c => c.val • AddMonoidHom.id P_bar
        map_zero' := AddMonoidHom.ext fun z => by
          change (0 : ZMod ℓ).val • z = 0
          simp
        map_one' := AddMonoidHom.ext fun z => by
          change (1 : ZMod ℓ).val • z = z
          rw [hValOne h1_lt_ℓ, one_nsmul]
        map_add' := fun a b => AddMonoidHom.ext fun z => by
          change (a + b).val • z = a.val • z + b.val • z
          rw [ZMod.val_add, hmod_ℓ_eq, add_nsmul]
        map_mul' := fun a b => AddMonoidHom.ext fun z => by
          change (a * b).val • z = a.val • (b.val • z)
          rw [ZMod.val_mul, hmod_ℓ_eq, mul_nsmul'] }
    let modPbar : Module (ZMod ℓ) P_bar := Module.compHom P_bar f_end_ℓ
    let _ : Module (ZMod ℓ) P_bar := modPbar
    have hsmulPbar : ∀ (c : ZMod ℓ) (z : P_bar), c • z = c.val • z := fun _ _ => rfl
    let b_raw := Module.Free.chooseBasis (ZMod ℓ) P_bar
    have _ : Finite (Module.Free.ChooseBasisIndex (ZMod ℓ) P_bar) :=
      Finite.of_injective b_raw b_raw.injective
    let n₀ := Nat.card (Module.Free.ChooseBasisIndex (ZMod ℓ) P_bar)
    let b_bar : Module.Basis (Fin n₀) (ZMod ℓ) P_bar := b_raw.reindex (Finite.equivFin _)
    have hb_lift : ∀ i : Fin n₀, ∃ v : P₀_J, mk_ℓ v = b_bar i :=
      fun i => QuotientAddGroup.mk'_surjective N_ℓ (b_bar i)
    let b_vec : Fin n₀ → P₀_J := fun i => Classical.choose (hb_lift i)
    have hb_spec : ∀ i : Fin n₀, mk_ℓ (b_vec i) = b_bar i :=
      fun i => Classical.choose_spec (hb_lift i)
    let F_nak : (Fin n₀ → Λ_K) →ₗ[Λ_K] P₀_J := freeHom_00 b_vec
    have hF_nak_val : ∀ u : Fin n₀ → Λ_K, F_nak u = ∑ i : Fin n₀, (u i).val • b_vec i := by
      intro u
      change ∑ i : Fin n₀, u i • b_vec i = ∑ i : Fin n₀, (u i).val • b_vec i
      refine Finset.sum_congr rfl fun i _ => ?_
      conv_lhs => rw [← ZMod.natCast_zmod_val (u i), Nat.cast_smul_eq_nsmul]
    have hF_surj_step : ∀ (t : ℕ) (x : P₀_J),
        ∃ (u : Fin n₀ → Λ_K) (w : P₀_J), x = F_nak u + (ℓ ^ t : ℕ) • w := by
      intro t
      induction t with
      | zero =>
        intro x
        exact ⟨0, x, by simp⟩
      | succ t ih =>
        intro x
        obtain ⟨u, w, hx⟩ := ih x
        let c : Fin n₀ → ZMod ℓ := fun i => b_bar.repr (mk_ℓ w) i
        have hw_bar : mk_ℓ (w - ∑ i : Fin n₀, (c i).val • b_vec i) = 0 := by
          rw [map_sub, map_sum]
          have h1 : ∑ i : Fin n₀, mk_ℓ ((c i).val • b_vec i) = ∑ i : Fin n₀, c i • b_bar i := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_nsmul, hb_spec i, hsmulPbar]
          rw [h1]
          have h2 : ∑ i : Fin n₀, c i • b_bar i = mk_ℓ w := b_bar.sum_repr (mk_ℓ w)
          rw [h2, sub_self]
        rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk'] at hw_bar
        obtain ⟨w', hw'⟩ := hw_bar
        change ℓ • w' = w - ∑ i : Fin n₀, (c i).val • b_vec i at hw'
        let u_add : Fin n₀ → Λ_K := fun i => ((ℓ ^ t * (c i).val : ℕ) : Λ_K)
        refine ⟨u + u_add, w', ?_⟩
        have hFu_add : F_nak u_add = (ℓ ^ t : ℕ) • ∑ i : Fin n₀, (c i).val • b_vec i := by
          change ∑ i : Fin n₀, ((ℓ ^ t * (c i).val : ℕ) : Λ_K) • b_vec i = _
          rw [Finset.smul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Nat.cast_smul_eq_nsmul, mul_nsmul']
        rw [map_add, hFu_add, hx, add_assoc]
        refine congrArg (F_nak u + ·) ?_
        have hw_eq : w = (∑ i : Fin n₀, (c i).val • b_vec i) + ℓ • w' := by
          rw [hw']
          abel
        rw [hw_eq, nsmul_add, ← mul_nsmul', ← pow_succ]
    have hF_surj : Function.Surjective F_nak := by
      intro x
      obtain ⟨u, w, hx⟩ := hF_surj_step K x
      exact ⟨u, by rw [hx, hTor_P₀J w, add_zero]⟩
    have hF_inj : Function.Injective F_nak := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro u hu
      have h_dvd : ∀ t : ℕ, t ≤ K → ∀ i : Fin n₀, ℓ ^ t ∣ (u i).val := by
        intro t
        induction t with
        | zero =>
          intro _ i
          simp
        | succ t ih =>
          intro ht1
          have ht : t ≤ K := Nat.le_of_succ_le ht1
          have ih_t := ih ht
          let v : Fin n₀ → ℕ := fun i => Classical.choose (ih_t i)
          have hv : ∀ i : Fin n₀, (u i).val = ℓ ^ t * v i :=
            fun i => Classical.choose_spec (ih_t i)
          let z : P₀_J := ∑ i : Fin n₀, v i • b_vec i
          have hz_tor : (ℓ ^ t : ℕ) • z = 0 := by
            dsimp [z]
            rw [Finset.smul_sum]
            have h1 : ∑ i : Fin n₀, (ℓ ^ t : ℕ) • (v i • b_vec i) = F_nak u := by
              rw [hF_nak_val u]
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [← mul_nsmul', ← hv i]
            rw [h1]
            exact hu
          obtain ⟨y, hy⟩ := hPer_P₀J t ht z hz_tor
          have hsub_pos : K - t = 1 + (K - (t + 1)) := by omega
          have hz_mem : mk_ℓ z = 0 := by
            rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
            refine ⟨(ℓ ^ (K - (t + 1)) : ℕ) • y, ?_⟩
            change ℓ • ((ℓ ^ (K - (t + 1)) : ℕ) • y) = z
            have hpow : ℓ * ℓ ^ (K - (t + 1)) = ℓ ^ (K - t) := by
              rw [hsub_pos, pow_add, pow_one]
            rw [← mul_nsmul', hpow, ← hy]
          have hbar_sum : ∑ i : Fin n₀, (v i : ZMod ℓ) • b_bar i = 0 := by
            rw [← hz_mem]
            dsimp [z]
            rw [map_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_nsmul, hb_spec i, ← Nat.cast_smul_eq_nsmul (ZMod ℓ)]
          intro i₀
          have hcoeff0 : (v i₀ : ZMod ℓ) = 0 := by
            have h1 := congrArg (fun w => b_bar.repr w i₀) hbar_sum
            simpa [map_sum, map_smul, Finsupp.single_apply] using h1
          have hdvd_v : ℓ ∣ v i₀ := (ZMod.natCast_eq_zero_iff (v i₀) ℓ).mp hcoeff0
          rw [hv i₀, pow_succ]
          exact Nat.mul_dvd_mul_left (ℓ ^ t) hdvd_v
      ext i
      have hdvdK := h_dvd K (le_refl K) i
      have hlt : (u i).val < ℓ ^ K := ZMod.val_lt (u i)
      have hval0 : (u i).val = 0 := Nat.eq_zero_of_dvd_of_lt hdvdK hlt
      exact ZMod.val_injective (ℓ ^ K) (hval0.trans ZMod.val_zero.symm)
    let e_nak : (Fin n₀ → Λ_K) ≃ₗ[Λ_K] P₀_J :=
      LinearEquiv.ofBijective F_nak ⟨hF_inj, hF_surj⟩

    
    let δ₀_J : (Fin n₀ → Λ_K) →ₗ[Λ_K] (Fin n₁ → Λ_K) := δ₀_PJ.comp e_nak.toLinearMap
    let γ₀_J : (Fin n₀ → Λ_K) →ₗ[Λ_K] J₀ := γ₀_PJ.comp e_nak.toLinearMap
    have hδ_J : δ₁_J.comp δ₀_J = 0 := by
      apply LinearMap.ext
      intro u
      exact LinearMap.congr_fun hδ_PJ (e_nak u)
    have hChainJ₀ : ∀ u : Fin n₀ → Λ_K, dJ₀ (γ₀_J u) = γ₁_J (δ₀_J u) :=
      fun u => hChainJ₀_P (e_nak u)
    have hConeJ₀ : ∀ (y₀ : J₀) (p₁ : Fin n₁ → Λ_K), dJ₀ y₀ + γ₁_J p₁ = 0 → δ₁_J p₁ = 0 →
        ∃ u₀ : Fin n₀ → Λ_K, γ₀_J u₀ = y₀ ∧ - δ₀_J u₀ = p₁ := by
      intro y₀ p₁ h0 hp₁
      obtain ⟨p₀, hγ, hδ⟩ := hConeJ₀_P y₀ p₁ h0 hp₁
      refine ⟨e_nak.symm p₀, ?_, ?_⟩
      · change γ₀_PJ (e_nak (e_nak.symm p₀)) = y₀
        rw [e_nak.apply_symm_apply, hγ]
      · change - δ₀_PJ (e_nak (e_nak.symm p₀)) = p₁
        rw [e_nak.apply_symm_apply, hδ]
    have hConeJ₀_inj : ∀ u₀ : Fin n₀ → Λ_K, γ₀_J u₀ = 0 → δ₀_J u₀ = 0 → u₀ = 0 := by
      intro u₀ hγ hδ
      exact e_nak.injective ((hConeJ₀_P_inj (e_nak u₀) hγ hδ).trans (map_zero e_nak).symm)

    have hLiftJ₂ : ∀ j : Fin n₂, ∃ hp : J₁ × (Fin n₂ → Λ_K),
        dJ₁ hp.1 + γ₂_J hp.2 = ΦJ₂ (γ₂_J (Pi.single j (1 : Λ_K))) := by
      intro j
      obtain ⟨y₁, p₂, h⟩ := hConeJ₂ (ΦJ₂ (γ₂_J (Pi.single j (1 : Λ_K))))
      exact ⟨(y₁, p₂), h⟩
    let h₂J_vec : Fin n₂ → J₁ := fun j => (Classical.choose (hLiftJ₂ j)).1
    let φ₂J_vec : Fin n₂ → (Fin n₂ → Λ_K) := fun j => (Classical.choose (hLiftJ₂ j)).2
    have hLiftJ₂_spec : ∀ j : Fin n₂,
        dJ₁ (h₂J_vec j) + γ₂_J (φ₂J_vec j) = ΦJ₂ (γ₂_J (Pi.single j (1 : Λ_K))) :=
      fun j => Classical.choose_spec (hLiftJ₂ j)
    let Φ₂_J : (Fin n₂ → Λ_K) →ₗ[Λ_K] (Fin n₂ → Λ_K) := freeHom_00 φ₂J_vec
    let h₂_J : (Fin n₂ → Λ_K) →ₗ[Λ_K] J₁ := freeHom_0u h₂J_vec
    have hHomJ₂_map : ΦJ₂_L.comp γ₂_J - γ₂_J.comp Φ₂_J = dJ₁_L.comp h₂_J := by
      apply hFreeExt_0u
      intro j
      simp only [LinearMap.sub_apply, LinearMap.comp_apply, Φ₂_J, h₂_J,
        hFreeHom_00_single, hFreeHom_0u_single]
      change ΦJ₂ (γ₂_J (Pi.single j 1)) - γ₂_J (φ₂J_vec j) = dJ₁ (h₂J_vec j)
      rw [← hLiftJ₂_spec j, add_sub_cancel_right]
    have hHomJ₂ : ∀ x, ΦJ₂ (γ₂_J x) - γ₂_J (Φ₂_J x) = dJ₁ (h₂_J x) := fun x =>
      LinearMap.congr_fun hHomJ₂_map x

    have hLiftJ₁ : ∀ k : Fin n₁,
        ∃ hp : J₀ × (Fin n₁ → Λ_K),
          dJ₀ hp.1 + γ₁_J hp.2 =
            ΦJ₁ (γ₁_J (Pi.single k (1 : Λ_K))) - h₂_J (δ₁_J (Pi.single k (1 : Λ_K))) ∧
          - δ₁_J hp.2 = - Φ₂_J (δ₁_J (Pi.single k (1 : Λ_K))) := by
      intro k
      set ek : Fin n₁ → Λ_K := Pi.single k (1 : Λ_K)
      have h0 : dJ₁ (ΦJ₁ (γ₁_J ek) - h₂_J (δ₁_J ek)) + γ₂_J (- Φ₂_J (δ₁_J ek)) = 0 := by
        rw [map_sub, hdΦJ₁_apply, hChainJ₁_apply, ← hHomJ₂ (δ₁_J ek), map_neg]
        abel
      obtain ⟨y₀, p₁, h1, h2⟩ := hConeJ₁ _ _ h0
      exact ⟨(y₀, p₁), h1, h2⟩
    let h₁J_vec : Fin n₁ → J₀ := fun k => (Classical.choose (hLiftJ₁ k)).1
    let φ₁J_vec : Fin n₁ → (Fin n₁ → Λ_K) := fun k => (Classical.choose (hLiftJ₁ k)).2
    have hLiftJ₁_spec : ∀ k : Fin n₁,
        dJ₀ (h₁J_vec k) + γ₁_J (φ₁J_vec k) =
          ΦJ₁ (γ₁_J (Pi.single k (1 : Λ_K))) - h₂_J (δ₁_J (Pi.single k (1 : Λ_K))) ∧
        - δ₁_J (φ₁J_vec k) = - Φ₂_J (δ₁_J (Pi.single k (1 : Λ_K))) :=
      fun k => Classical.choose_spec (hLiftJ₁ k)
    let Φ₁_J : (Fin n₁ → Λ_K) →ₗ[Λ_K] (Fin n₁ → Λ_K) := freeHom_00 φ₁J_vec
    let h₁_J : (Fin n₁ → Λ_K) →ₗ[Λ_K] J₀ := freeHom_0u h₁J_vec
    have hΦ₁J_comm : δ₁_J.comp Φ₁_J = Φ₂_J.comp δ₁_J := by
      apply hFreeExt_00
      intro k
      simp only [LinearMap.comp_apply, Φ₁_J, hFreeHom_00_single]
      exact neg_inj.mp (hLiftJ₁_spec k).2
    have hHomJ₁_map : ΦJ₁_L.comp γ₁_J - γ₁_J.comp Φ₁_J = dJ₀_L.comp h₁_J + h₂_J.comp δ₁_J := by
      apply hFreeExt_0u
      intro k
      simp only [LinearMap.sub_apply, LinearMap.add_apply, LinearMap.comp_apply, Φ₁_J, h₁_J,
        hFreeHom_00_single, hFreeHom_0u_single]
      have h1 := (hLiftJ₁_spec k).1
      change ΦJ₁ (γ₁_J (Pi.single k 1)) - γ₁_J (φ₁J_vec k) =
        dJ₀ (h₁J_vec k) + h₂_J (δ₁_J (Pi.single k 1))
      calc ΦJ₁ (γ₁_J (Pi.single k 1)) - γ₁_J (φ₁J_vec k)
          = (dJ₀ (h₁J_vec k) + γ₁_J (φ₁J_vec k) + h₂_J (δ₁_J (Pi.single k 1))) - γ₁_J (φ₁J_vec k) := by
            rw [h1, sub_add_cancel]
        _ = dJ₀ (h₁J_vec k) + h₂_J (δ₁_J (Pi.single k 1)) := by abel
    have hHomJ₁ : ∀ x, ΦJ₁ (γ₁_J x) - γ₁_J (Φ₁_J x) = dJ₀ (h₁_J x) + h₂_J (δ₁_J x) := fun x =>
      LinearMap.congr_fun hHomJ₁_map x

    have hLiftJ₀ : ∀ k : Fin n₀,
        ∃ u₀ : Fin n₀ → Λ_K,
          γ₀_J u₀ = ΦJ₀ (γ₀_J (Pi.single k (1 : Λ_K))) - h₁_J (δ₀_J (Pi.single k (1 : Λ_K))) ∧
          - δ₀_J u₀ = - Φ₁_J (δ₀_J (Pi.single k (1 : Λ_K))) := by
      intro k
      set ek : Fin n₀ → Λ_K := Pi.single k (1 : Λ_K)
      have hδek : δ₁_J (δ₀_J ek) = 0 := LinearMap.congr_fun hδ_J ek
      have h0 : dJ₀ (ΦJ₀ (γ₀_J ek) - h₁_J (δ₀_J ek)) + γ₁_J (- Φ₁_J (δ₀_J ek)) = 0 := by
        rw [map_sub, hdΦJ₀_apply, hChainJ₀, map_neg]
        have hh := hHomJ₁ (δ₀_J ek)
        rw [hδek, map_zero, add_zero] at hh
        rw [← hh]
        abel
      have h1 : δ₁_J (- Φ₁_J (δ₀_J ek)) = 0 := by
        rw [map_neg, neg_eq_zero]
        have hc := LinearMap.congr_fun hΦ₁J_comm (δ₀_J ek)
        change δ₁_J (Φ₁_J (δ₀_J ek)) = Φ₂_J (δ₁_J (δ₀_J ek)) at hc
        rw [hc, hδek, map_zero]
      exact hConeJ₀ _ _ h0 h1
    let φ₀J_vec : Fin n₀ → (Fin n₀ → Λ_K) := fun k => Classical.choose (hLiftJ₀ k)
    have hLiftJ₀_spec : ∀ k : Fin n₀,
        γ₀_J (φ₀J_vec k) =
          ΦJ₀ (γ₀_J (Pi.single k (1 : Λ_K))) - h₁_J (δ₀_J (Pi.single k (1 : Λ_K))) ∧
        - δ₀_J (φ₀J_vec k) = - Φ₁_J (δ₀_J (Pi.single k (1 : Λ_K))) :=
      fun k => Classical.choose_spec (hLiftJ₀ k)
    let Φ₀_J : (Fin n₀ → Λ_K) →ₗ[Λ_K] (Fin n₀ → Λ_K) := freeHom_00 φ₀J_vec
    have hΦ₀J_comm : δ₀_J.comp Φ₀_J = Φ₁_J.comp δ₀_J := by
      apply hFreeExt_00
      intro k
      simp only [LinearMap.comp_apply, Φ₀_J, hFreeHom_00_single]
      exact neg_inj.mp (hLiftJ₀_spec k).2
    have hHomJ₀_map : ΦJ₀_L.comp γ₀_J - γ₀_J.comp Φ₀_J = h₁_J.comp δ₀_J := by
      apply hFreeExt_0u
      intro k
      simp only [LinearMap.sub_apply, LinearMap.comp_apply, Φ₀_J, hFreeHom_00_single]
      have h1 := (hLiftJ₀_spec k).1
      change ΦJ₀ (γ₀_J (Pi.single k 1)) - γ₀_J (φ₀J_vec k) = h₁_J (δ₀_J (Pi.single k 1))
      rw [h1]
      abel
    have hHomJ₀ : ∀ x, ΦJ₀ (γ₀_J x) - γ₀_J (Φ₀_J x) = h₁_J (δ₀_J x) := fun x =>
      LinearMap.congr_fun hHomJ₀_map x

    
    let D₀_mat := LinearMap.toMatrix' δ₀_J
    let D₁_mat := LinearMap.toMatrix' δ₁_J
    let Φ₀_mat := LinearMap.toMatrix' Φ₀_J
    let Φ₁_mat := LinearMap.toMatrix' Φ₁_J
    let Φ₂_mat := LinearMap.toMatrix' Φ₂_J
    have hD₀_lin : D₀_mat.mulVecLin = δ₀_J := LinearMap.ext (LinearMap.toMatrix'_mulVec δ₀_J)
    have hD₁_lin : D₁_mat.mulVecLin = δ₁_J := LinearMap.ext (LinearMap.toMatrix'_mulVec δ₁_J)
    have hΦ₀_lin : Φ₀_mat.mulVecLin = Φ₀_J := LinearMap.ext (LinearMap.toMatrix'_mulVec Φ₀_J)
    have hΦ₁_lin : Φ₁_mat.mulVecLin = Φ₁_J := LinearMap.ext (LinearMap.toMatrix'_mulVec Φ₁_J)
    have hΦ₂_lin : Φ₂_mat.mulVecLin = Φ₂_J := LinearMap.ext (LinearMap.toMatrix'_mulVec Φ₂_J)
    let P_K : WeilCurveTrFreeComplex (ℓ ^ K) :=
      { n₀ := n₀
        n₁ := n₁
        n₂ := n₂
        D₀ := D₀_mat
        D₁ := D₁_mat
        hD := hMatExt (by rw [Matrix.mulVecLin_mul, hD₁_lin, hD₀_lin, hδ_J, Matrix.mulVecLin_zero])
        Φ₀ := Φ₀_mat
        Φ₁ := Φ₁_mat
        Φ₂ := Φ₂_mat
        hΦ₀ := hMatExt (by rw [Matrix.mulVecLin_mul, Matrix.mulVecLin_mul, hD₀_lin, hΦ₀_lin,
          hΦ₁_lin, hΦ₀J_comm])
        hΦ₁ := hMatExt (by rw [Matrix.mulVecLin_mul, Matrix.mulVecLin_mul, hD₁_lin, hΦ₁_lin,
          hΦ₂_lin, hΦ₁J_comm]) }

    
    have hLatP : WeilCurveTrHasBoundedLatticeModel ℓ K B₁ P_K b_J M_lat_J := by
      let MJ₀ := ((M_lat_J 0).map (PadicInt.toZModPow K)).mulVecLin
      let MJ₁ := ((M_lat_J 1).map (PadicInt.toZModPow K)).mulVecLin
      let MJ₂ := ((M_lat_J 2).map (PadicInt.toZModPow K)).mulVecLin
      obtain ⟨⟨q₀_J, hq₀_int, hq₀_ker, hq₀_cok⟩,
              ⟨q₁_J, hq₁_int, hq₁_ker, hq₁_cok⟩,
              ⟨q₂_J, hq₂_int, hq₂_ker, hq₂_cok⟩⟩ := hLatJ
      refine ⟨?_, ?_, ?_⟩
      · 
        have hLift₀ : ∀ y : ↥dJ₀.ker, ∃ u₀ : Fin n₀ → Λ_K, γ₀_J u₀ = y.1 ∧ δ₀_J u₀ = 0 := by
          intro y
          have h0 : dJ₀ y.1 + γ₁_J 0 = 0 := by
            rw [map_zero, add_zero]
            exact y.2
          obtain ⟨u₀, hγ, hδ⟩ := hConeJ₀ y.1 0 h0 (map_zero δ₁_J)
          exact ⟨u₀, hγ, neg_eq_zero.mp hδ⟩
        let inv₀_fun : ↥dJ₀.ker → (Fin n₀ → Λ_K) := fun y => Classical.choose (hLift₀ y)
        have hinv₀_spec : ∀ y : ↥dJ₀.ker, γ₀_J (inv₀_fun y) = y.1 ∧ δ₀_J (inv₀_fun y) = 0 :=
          fun y => Classical.choose_spec (hLift₀ y)
        let inv₀ : ↥dJ₀.ker →+ (Fin n₀ → Λ_K) :=
          { toFun := inv₀_fun
            map_zero' := hConeJ₀_inj _ (hinv₀_spec 0).1 (hinv₀_spec 0).2
            map_add' := fun a b => by
              apply sub_eq_zero.mp
              apply hConeJ₀_inj (inv₀_fun (a + b) - (inv₀_fun a + inv₀_fun b))
              · rw [map_sub, map_add, (hinv₀_spec (a + b)).1, (hinv₀_spec a).1, (hinv₀_spec b).1]
                exact sub_self (a.1 + b.1)
              · rw [map_sub, map_add, (hinv₀_spec (a + b)).2, (hinv₀_spec a).2, (hinv₀_spec b).2]
                simp }
        let q₀ : (Fin (b_J 0) → Λ_K) →ₗ[Λ_K] (Fin n₀ → Λ_K) :=
          { toFun := inv₀.comp q₀_J
            map_add' := (inv₀.comp q₀_J).map_add
            map_smul' := fun c x => by
              dsimp
              conv_lhs => rw [← ZMod.natCast_zmod_val c, Nat.cast_smul_eq_nsmul, map_nsmul, map_nsmul]
              conv_rhs => rw [← ZMod.natCast_zmod_val c, Nat.cast_smul_eq_nsmul] }
        have hq₀_γ : ∀ u, γ₀_J (q₀ u) = (q₀_J u).1 := fun u => (hinv₀_spec (q₀_J u)).1
        have hq₀_δ : ∀ u, δ₀_J (q₀ u) = 0 := fun u => (hinv₀_spec (q₀_J u)).2
        refine ⟨q₀, ?_, ?_, ?_, ?_⟩
        · intro x
          change D₀_mat.mulVecLin (q₀ x) = 0
          rw [hD₀_lin]
          exact hq₀_δ x
        · intro x
          change q₀ (MJ₀ x) = Φ₀_mat.mulVecLin (q₀ x)
          rw [hΦ₀_lin]
          apply sub_eq_zero.mp
          apply hConeJ₀_inj (q₀ (MJ₀ x) - Φ₀_J (q₀ x))
          · rw [map_sub]
            have hh := hHomJ₀ (q₀ x)
            rw [hq₀_δ x, map_zero] at hh
            have hh' : γ₀_J (Φ₀_J (q₀ x)) = ΦJ₀ (γ₀_J (q₀ x)) := (sub_eq_zero.mp hh).symm
            rw [hq₀_γ (MJ₀ x), hq₀_int x, hh', hq₀_γ x, sub_self]
          · rw [map_sub, hq₀_δ (MJ₀ x)]
            have hc := LinearMap.congr_fun hΦ₀J_comm (q₀ x)
            change δ₀_J (Φ₀_J (q₀ x)) = Φ₁_J (δ₀_J (q₀ x)) at hc
            rw [hc, hq₀_δ x, map_zero, sub_zero]
        · intro x hx
          apply hq₀_ker x
          apply Subtype.ext
          have h1 := congrArg γ₀_J hx
          rw [map_zero] at h1
          exact (hq₀_γ x).symm.trans h1
        · intro y hy
          have hy' : δ₀_J y = 0 := by rwa [← hD₀_lin]
          have hy_ker : γ₀_J y ∈ dJ₀.ker := by
            change dJ₀ (γ₀_J y) = 0
            rw [hChainJ₀ y, hy', map_zero]
          obtain ⟨x, hx⟩ := hq₀_cok ⟨γ₀_J y, hy_ker⟩
          refine ⟨x, ?_⟩
          apply sub_eq_zero.mp
          apply hConeJ₀_inj (q₀ x - (ℓ ^ B₁ : ℕ) • y)
          · rw [map_sub, map_nsmul, hq₀_γ x, hx]
            exact sub_self _
          · rw [map_sub, hq₀_δ x, map_nsmul, hy', nsmul_zero, sub_zero]
      · 
        let mk₁ := QuotientAddGroup.mk' B_J₁
        have hγJ₁_ker : ∀ p₁ : Fin n₁ → Λ_K, δ₁_J p₁ = 0 → γ₁_J p₁ ∈ dJ₁.ker := by
          intro p₁ hp₁
          change dJ₁ (γ₁_J p₁) = 0
          rw [hChainJ₁_apply p₁, hp₁, map_zero]
        have hLift₁ : ∀ r : Fin (b_J 1),
            ∃ u : Fin n₁ → Λ_K, ∃ hu : δ₁_J u = 0,
              mk₁ ⟨γ₁_J u, hγJ₁_ker u hu⟩ = q₁_J (Pi.single r (1 : Λ_K)) := by
          intro r
          obtain ⟨z, hz⟩ := QuotientAddGroup.mk'_surjective B_J₁ (q₁_J (Pi.single r (1 : Λ_K)))
          have hz0 : dJ₁ z.1 + γ₂_J 0 = 0 := by
            rw [map_zero, add_zero]
            exact z.2
          obtain ⟨y₀, u, hyu, hδu⟩ := hConeJ₁ z.1 0 hz0
          have hu0 : δ₁_J u = 0 := neg_eq_zero.mp hδu
          refine ⟨u, hu0, ?_⟩
          rw [← hz]
          apply Eq.symm
          rw [← sub_eq_zero, ← map_sub, ← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
          exact ⟨y₀, by change dJ₀ y₀ = z.1 - γ₁_J u; rw [← hyu]; abel⟩
        let u₁ : Fin (b_J 1) → (Fin n₁ → Λ_K) := fun r => Classical.choose (hLift₁ r)
        have hu₁_δ : ∀ r, δ₁_J (u₁ r) = 0 := fun r => (Classical.choose_spec (hLift₁ r)).1
        have hu₁_mk : ∀ r, mk₁ ⟨γ₁_J (u₁ r), hγJ₁_ker (u₁ r) (hu₁_δ r)⟩ =
            q₁_J (Pi.single r (1 : Λ_K)) :=
          fun r => (Classical.choose_spec (hLift₁ r)).2
        let q₁ : (Fin (b_J 1) → Λ_K) →ₗ[Λ_K] (Fin n₁ → Λ_K) := freeHom_00 u₁
        have hq₁_δ : ∀ x, δ₁_J (q₁ x) = 0 := by
          intro x
          change δ₁_J (∑ r : Fin (b_J 1), x r • u₁ r) = 0
          rw [map_sum]
          refine Finset.sum_eq_zero fun r _ => ?_
          rw [map_smul, hu₁_δ r, smul_zero]
        let q₁_coh : (Fin (b_J 1) → Λ_K) →+ (↥dJ₁.ker ⧸ B_J₁) :=
          mk₁.comp
            { toFun := fun x => ⟨γ₁_J (q₁ x), hγJ₁_ker (q₁ x) (hq₁_δ x)⟩
              map_zero' := by apply Subtype.ext; simp
              map_add' := fun x y => by apply Subtype.ext; simp }
        have hq₁_coh_eq : ∀ x, q₁_coh x = q₁_J x := by
          intro x
          have hx : x = ∑ r : Fin (b_J 1), (x r).val • (Pi.single r (1 : Λ_K) : Fin (b_J 1) → Λ_K) := by
            ext k
            simp only [Finset.sum_apply, Pi.smul_apply, Pi.single_apply]
            rw [Finset.sum_eq_single k]
            · simp only [↓reduceIte, ← Nat.cast_smul_eq_nsmul Λ_K, smul_eq_mul, mul_one]
              exact (ZMod.natCast_zmod_val (x k)).symm
            · intro r _ hr
              rw [ite_eq_right_iff.mpr (fun h => False.elim (hr.symm h)), nsmul_zero]
            · intro hk
              exact False.elim (hk (Finset.mem_univ k))
          conv_lhs => rw [hx]
          conv_rhs => rw [hx]
          rw [map_sum, map_sum]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [map_nsmul, map_nsmul]
          refine congrArg ((x r).val • ·) ?_
          have hsingle_q₁ : q₁ (Pi.single r (1 : Λ_K)) = u₁ r := hFreeHom_00_single u₁ r
          change mk₁ ⟨γ₁_J (q₁ (Pi.single r 1)), hγJ₁_ker _ (hq₁_δ _)⟩ = q₁_J (Pi.single r 1)
          have hsub : (⟨γ₁_J (q₁ (Pi.single r 1)), hγJ₁_ker _ (hq₁_δ _)⟩ : ↥dJ₁.ker) =
              ⟨γ₁_J (u₁ r), hγJ₁_ker (u₁ r) (hu₁_δ r)⟩ :=
            Subtype.ext (congrArg γ₁_J hsingle_q₁)
          rw [hsub]
          exact hu₁_mk r
        have hH₁_inj : ∀ p₁ : Fin n₁ → Λ_K, δ₁_J p₁ = 0 →
            γ₁_J p₁ ∈ dJ₀.range → p₁ ∈ LinearMap.range δ₀_J := by
          intro p₁ hp₁ hmem
          rcases hmem with ⟨y₀, hy₀⟩
          have h0 : dJ₀ (-y₀) + γ₁_J p₁ = 0 := by
            rw [map_neg, hy₀, neg_add_cancel]
          obtain ⟨p₀, _, hδp⟩ := hConeJ₀ (-y₀) p₁ h0 hp₁
          exact ⟨-p₀, by rw [map_neg, hδp]⟩
        refine ⟨q₁, ?_, ?_, ?_, ?_⟩
        · intro x
          change D₁_mat.mulVecLin (q₁ x) = 0
          rw [hD₁_lin]
          exact hq₁_δ x
        · intro x
          change q₁ (MJ₁ x) - Φ₁_mat.mulVecLin (q₁ x) ∈ LinearMap.range D₀_mat.mulVecLin
          rw [hΦ₁_lin, hD₀_lin]
          set w := q₁ (MJ₁ x) - Φ₁_J (q₁ x)
          have hw_δ : δ₁_J w = 0 := by
            dsimp [w]
            rw [map_sub, hq₁_δ]
            have hc := LinearMap.congr_fun hΦ₁J_comm (q₁ x)
            change δ₁_J (Φ₁_J (q₁ x)) = Φ₂_J (δ₁_J (q₁ x)) at hc
            rw [hc, hq₁_δ, map_zero, sub_zero]
          apply hH₁_inj w hw_δ
          change (⟨γ₁_J w, hγJ₁_ker w hw_δ⟩ : ↥dJ₁.ker) ∈ B_J₁
          rw [← QuotientAddGroup.ker_mk' B_J₁, AddMonoidHom.mem_ker]
          let z_x : ↥dJ₁.ker := ⟨γ₁_J (q₁ x), hγJ₁_ker (q₁ x) (hq₁_δ x)⟩
          have hz_x' : ΦJ₁ z_x.1 ∈ dJ₁.ker := by
            change dJ₁ (ΦJ₁ z_x.1) = 0
            have hz0 : dJ₁ z_x.1 = 0 := z_x.2
            rw [hdΦJ₁_apply z_x.1, hz0, map_zero]
          have h1 : q₁_coh (MJ₁ x) = mk₁ ⟨ΦJ₁ z_x.1, hz_x'⟩ := by
            rw [hq₁_coh_eq]
            exact hq₁_int x z_x hz_x' (hq₁_coh_eq x)
          have h2 : γ₁_J (Φ₁_J (q₁ x)) = ΦJ₁ z_x.1 - dJ₀ (h₁_J (q₁ x)) := by
            have hh := hHomJ₁ (q₁ x)
            rw [hq₁_δ x, map_zero, add_zero] at hh
            change ΦJ₁ z_x.1 - γ₁_J (Φ₁_J (q₁ x)) = dJ₀ (h₁_J (q₁ x)) at hh
            rw [← hh]
            abel
          have hsplit : (⟨γ₁_J w, hγJ₁_ker w hw_δ⟩ : ↥dJ₁.ker) =
              ⟨γ₁_J (q₁ (MJ₁ x)), hγJ₁_ker _ (hq₁_δ _)⟩ -
              ⟨γ₁_J (Φ₁_J (q₁ x)), by
                have h : dJ₁ (γ₁_J (q₁ (MJ₁ x) - Φ₁_J (q₁ x))) = 0 := hγJ₁_ker w hw_δ
                have h0 : dJ₁ (γ₁_J (q₁ (MJ₁ x))) = 0 := hγJ₁_ker _ (hq₁_δ _)
                rw [map_sub, map_sub, h0, zero_sub, neg_eq_zero] at h
                exact h⟩ := by
            apply Subtype.ext
            exact map_sub γ₁_J _ _
          rw [hsplit, map_sub]
          change q₁_coh (MJ₁ x) - _ = 0
          rw [h1, sub_eq_zero]
          apply Eq.symm
          rw [← sub_eq_zero, ← map_sub, ← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
          exact ⟨- h₁_J (q₁ x), by
            change dJ₀ (- h₁_J (q₁ x)) = γ₁_J (Φ₁_J (q₁ x)) - ΦJ₁ z_x.1
            rw [h2, map_neg]
            abel⟩
        · intro x hx
          change q₁ x ∈ LinearMap.range D₀_mat.mulVecLin at hx
          rw [hD₀_lin] at hx
          rcases hx with ⟨z, hz⟩
          apply hq₁_ker x
          rw [← hq₁_coh_eq x]
          change mk₁ ⟨γ₁_J (q₁ x), hγJ₁_ker (q₁ x) (hq₁_δ x)⟩ = 0
          rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
          exact ⟨γ₀_J z, by change dJ₀ (γ₀_J z) = γ₁_J (q₁ x); rw [← hz]; exact hChainJ₀ z⟩
        · intro y hy
          have hy' : δ₁_J y = 0 := by rwa [← hD₁_lin]
          obtain ⟨x, hx⟩ := hq₁_cok (mk₁ ⟨γ₁_J y, hγJ₁_ker y hy'⟩)
          refine ⟨x, ?_⟩
          change (ℓ ^ B₁ : ℕ) • y - q₁ x ∈ LinearMap.range D₀_mat.mulVecLin
          rw [hD₀_lin]
          set w := (ℓ ^ B₁ : ℕ) • y - q₁ x
          have hw_δ : δ₁_J w = 0 := by
            dsimp [w]
            rw [map_sub, map_nsmul, hy', nsmul_zero, hq₁_δ, sub_zero]
          apply hH₁_inj w hw_δ
          change (⟨γ₁_J w, hγJ₁_ker w hw_δ⟩ : ↥dJ₁.ker) ∈ B_J₁
          rw [← QuotientAddGroup.ker_mk' B_J₁, AddMonoidHom.mem_ker]
          have hsplit : (⟨γ₁_J w, hγJ₁_ker w hw_δ⟩ : ↥dJ₁.ker) =
              (ℓ ^ B₁ : ℕ) • ⟨γ₁_J y, hγJ₁_ker y hy'⟩ -
              ⟨γ₁_J (q₁ x), hγJ₁_ker (q₁ x) (hq₁_δ x)⟩ := by
            apply Subtype.ext
            change γ₁_J ((ℓ ^ B₁ : ℕ) • y - q₁ x) = (ℓ ^ B₁ : ℕ) • γ₁_J y - γ₁_J (q₁ x)
            rw [map_sub, map_nsmul]
          rw [hsplit, map_sub, map_nsmul]
          change (ℓ ^ B₁ : ℕ) • mk₁ ⟨γ₁_J y, hγJ₁_ker y hy'⟩ - q₁_coh x = 0
          rw [hq₁_coh_eq x, hx, sub_self]
      · 
        let mk₂ := QuotientAddGroup.mk' dJ₁.range
        have hLift₂ : ∀ r : Fin (b_J 2),
            ∃ u : Fin n₂ → Λ_K, mk₂ (γ₂_J u) = q₂_J (Pi.single r (1 : Λ_K)) := by
          intro r
          obtain ⟨z, hz⟩ := QuotientAddGroup.mk'_surjective dJ₁.range (q₂_J (Pi.single r (1 : Λ_K)))
          obtain ⟨y₁, u, hyu⟩ := hConeJ₂ z
          refine ⟨u, ?_⟩
          rw [← hz]
          apply Eq.symm
          rw [← sub_eq_zero, ← map_sub, ← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
          exact ⟨y₁, by rw [← hyu]; abel⟩
        let u₂ : Fin (b_J 2) → (Fin n₂ → Λ_K) := fun r => Classical.choose (hLift₂ r)
        have hu₂_mk : ∀ r, mk₂ (γ₂_J (u₂ r)) = q₂_J (Pi.single r (1 : Λ_K)) :=
          fun r => Classical.choose_spec (hLift₂ r)
        let q₂ : (Fin (b_J 2) → Λ_K) →ₗ[Λ_K] (Fin n₂ → Λ_K) := freeHom_00 u₂
        let q₂_coh : (Fin (b_J 2) → Λ_K) →+ (J₂ ⧸ dJ₁.range) :=
          mk₂.comp (γ₂_J.toAddMonoidHom.comp q₂.toAddMonoidHom)
        have hq₂_coh_eq : ∀ x, q₂_coh x = q₂_J x := by
          intro x
          have hx : x = ∑ r : Fin (b_J 2), (x r).val • (Pi.single r (1 : Λ_K) : Fin (b_J 2) → Λ_K) := by
            ext k
            simp only [Finset.sum_apply, Pi.smul_apply, Pi.single_apply]
            rw [Finset.sum_eq_single k]
            · simp only [↓reduceIte, ← Nat.cast_smul_eq_nsmul Λ_K, smul_eq_mul, mul_one]
              exact (ZMod.natCast_zmod_val (x k)).symm
            · intro r _ hr
              rw [ite_eq_right_iff.mpr (fun h => False.elim (hr.symm h)), nsmul_zero]
            · intro hk
              exact False.elim (hk (Finset.mem_univ k))
          conv_lhs => rw [hx]
          conv_rhs => rw [hx]
          rw [map_sum, map_sum]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [map_nsmul, map_nsmul]
          refine congrArg ((x r).val • ·) ?_
          have hsingle_q₂ : q₂ (Pi.single r (1 : Λ_K)) = u₂ r := hFreeHom_00_single u₂ r
          change mk₂ (γ₂_J (q₂ (Pi.single r 1))) = _
          rw [hsingle_q₂, hu₂_mk r]
        have hH₂_inj : ∀ p₂ : Fin n₂ → Λ_K, γ₂_J p₂ ∈ dJ₁.range → p₂ ∈ LinearMap.range δ₁_J := by
          intro p₂ hmem
          rcases hmem with ⟨y₁, hy₁⟩
          have h0 : dJ₁ (-y₁) + γ₂_J p₂ = 0 := by
            rw [map_neg, hy₁, neg_add_cancel]
          obtain ⟨_, p₁, _, hδp⟩ := hConeJ₁ (-y₁) p₂ h0
          exact ⟨-p₁, by rw [map_neg, hδp]⟩
        refine ⟨q₂, ?_, ?_, ?_⟩
        · intro x
          change q₂ (MJ₂ x) - Φ₂_mat.mulVecLin (q₂ x) ∈ LinearMap.range D₁_mat.mulVecLin
          rw [hΦ₂_lin, hD₁_lin]
          apply hH₂_inj
          rw [← QuotientAddGroup.ker_mk' dJ₁.range, AddMonoidHom.mem_ker, map_sub, map_sub]
          change q₂_coh (MJ₂ x) - mk₂ (γ₂_J (Φ₂_J (q₂ x))) = 0
          rw [hq₂_coh_eq, hq₂_int x (γ₂_J (q₂ x)) (hq₂_coh_eq x), sub_eq_zero]
          apply Eq.symm
          rw [← sub_eq_zero, ← map_sub, ← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
          refine ⟨- h₂_J (q₂ x), ?_⟩
          have hh := hHomJ₂ (q₂ x)
          change ΦJ₂ (γ₂_J (q₂ x)) - γ₂_J (Φ₂_J (q₂ x)) = dJ₁ (h₂_J (q₂ x)) at hh
          rw [map_neg, ← hh]
          abel
        · intro x hx
          change q₂ x ∈ LinearMap.range D₁_mat.mulVecLin at hx
          rw [hD₁_lin] at hx
          rcases hx with ⟨z, hz⟩
          apply hq₂_ker x
          rw [← hq₂_coh_eq x]
          change mk₂ (γ₂_J (q₂ x)) = 0
          rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
          exact ⟨γ₁_J z, by rw [← hz]; exact hChainJ₁_apply z⟩
        · intro y
          obtain ⟨x, hx⟩ := hq₂_cok (mk₂ (γ₂_J y))
          refine ⟨x, ?_⟩
          change (ℓ ^ B₁ : ℕ) • y - q₂ x ∈ LinearMap.range D₁_mat.mulVecLin
          rw [hD₁_lin]
          apply hH₂_inj
          rw [← QuotientAddGroup.ker_mk' dJ₁.range, AddMonoidHom.mem_ker,
            map_sub, map_sub, map_nsmul, map_nsmul]
          change (ℓ ^ B₁ : ℕ) • mk₂ (γ₂_J y) - q₂_coh x = 0
          rw [hq₂_coh_eq x, hx, sub_self]

    
    obtain ⟨modIG₀, _⟩ := hZModMod_u (ℓ ^ (s + 1)) h1_lt_s1 IG₀ hTorIG.1
    obtain ⟨modIG₁, _⟩ := hZModMod_u (ℓ ^ (s + 1)) h1_lt_s1 IG₁ hTorIG.2.1
    obtain ⟨modIG₂, _⟩ := hZModMod_u (ℓ ^ (s + 1)) h1_lt_s1 IG₂ hTorIG.2.2
    let _ : Module Λ_s IG₀ := modIG₀
    let _ : Module Λ_s IG₁ := modIG₁
    let _ : Module Λ_s IG₂ := modIG₂

    let p_vec : ∀ {n : ℕ}, (Fin n → Λ_K) →+ (Fin n → Λ_s) := fun {n} =>
      { toFun := fun u i => cast_s (u i)
        map_zero' := by ext i; simp
        map_add' := fun u v => by ext i; simp }
    have hp_vec_surj : ∀ {n : ℕ}, Function.Surjective (@p_vec n) := by
      intro n x
      refine ⟨fun i => ((x i).val : Λ_K), ?_⟩
      ext i
      change cast_s ((x i).val : Λ_K) = x i
      rw [map_natCast, ZMod.natCast_zmod_val]
    have hp_vec_ker : ∀ {n : ℕ} (u : Fin n → Λ_K),
        p_vec u = 0 ↔ ∃ v : Fin n → Λ_K, u = (ℓ ^ (s + 1) : ℕ) • v := by
      intro n u
      constructor
      · intro hu
        have hcoord : ∀ i : Fin n, ∃ y : Λ_K, u i = (ℓ ^ (s + 1) : ℕ) • y := by
          intro i
          have hi : cast_s (u i) = 0 := congrFun hu i
          have hi' : (((u i).val : Λ_s)) = 0 := by
            rw [← map_natCast cast_s (u i).val, ZMod.natCast_zmod_val]
            exact hi
          obtain ⟨q, hq⟩ := (ZMod.natCast_eq_zero_iff (u i).val (ℓ ^ (s + 1))).mp hi'
          refine ⟨(q : Λ_K), ?_⟩
          rw [← Nat.cast_smul_eq_nsmul Λ_K, smul_eq_mul, ← Nat.cast_mul, ← hq,
            ZMod.natCast_zmod_val]
        refine ⟨fun i => Classical.choose (hcoord i), ?_⟩
        ext i
        exact Classical.choose_spec (hcoord i)
      · rintro ⟨v, rfl⟩
        ext i
        change cast_s ((ℓ ^ (s + 1) : ℕ) • v i) = 0
        rw [map_nsmul, ← Nat.cast_smul_eq_nsmul Λ_s, ZMod.natCast_self, zero_smul]
    have hp_vec_mat : ∀ {r c : ℕ} (M : Matrix (Fin r) (Fin c) Λ_K) (u : Fin c → Λ_K),
        (M.map cast_s).mulVecLin (p_vec u) = p_vec (M.mulVecLin u) := by
      intro r c M u
      ext i
      simp [p_vec, Matrix.mulVec, dotProduct, map_sum, map_mul]

    let γJ₀_L : (Fin n₀ → Λ_s) →ₗ[Λ_s] IG₀ :=
      freeHom_0u (fun j => πG₀ (γ₀_J (Pi.single j (1 : Λ_K))))
    let γJ₁_L : (Fin n₁ → Λ_s) →ₗ[Λ_s] IG₁ :=
      freeHom_0u (fun j => πG₁ (γ₁_J (Pi.single j (1 : Λ_K))))
    let γJ₂_L : (Fin n₂ → Λ_s) →ₗ[Λ_s] IG₂ :=
      freeHom_0u (fun j => πG₂ (γ₂_J (Pi.single j (1 : Λ_K))))
    let hJ₁_L : (Fin n₁ → Λ_s) →ₗ[Λ_s] IG₀ :=
      freeHom_0u (fun j => πG₀ (h₁_J (Pi.single j (1 : Λ_K))))
    let hJ₂_L : (Fin n₂ → Λ_s) →ₗ[Λ_s] IG₁ :=
      freeHom_0u (fun j => πG₁ (h₂_J (Pi.single j (1 : Λ_K))))

    have hDescend : ∀ {n : ℕ} {J_t IG_t : Type u} [AddCommGroup J_t] [Module Λ_K J_t]
        [AddCommGroup IG_t] [Module Λ_s IG_t]
        (π_t : J_t →+ IG_t) (g_K : (Fin n → Λ_K) →ₗ[Λ_K] J_t) (u : Fin n → Λ_K),
        freeHom_0u (fun j => π_t (g_K (Pi.single j (1 : Λ_K)))) (p_vec u) = π_t (g_K u) := by
      intro n J_t IG_t _ _ _ _ π_t g_K u
      have hu : u = ∑ j : Fin n, (u j).val • (Pi.single j (1 : Λ_K) : Fin n → Λ_K) := by
        ext k
        simp only [Finset.sum_apply, Pi.smul_apply, Pi.single_apply]
        rw [Finset.sum_eq_single k]
        · simp only [↓reduceIte, ← Nat.cast_smul_eq_nsmul Λ_K, smul_eq_mul, mul_one]
          exact (ZMod.natCast_zmod_val (u k)).symm
        · intro j _ hj
          rw [ite_eq_right_iff.mpr (fun h => False.elim (hj.symm h)), nsmul_zero]
        · intro hk
          exact False.elim (hk (Finset.mem_univ k))
      conv_lhs => rw [hu]
      conv_rhs => rw [hu]
      rw [map_sum p_vec, map_sum, map_sum g_K, map_sum π_t]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_nsmul p_vec, map_nsmul, map_nsmul g_K, map_nsmul π_t]
      refine congrArg ((u j).val • ·) ?_
      have hp_single : p_vec (Pi.single j (1 : Λ_K) : Fin n → Λ_K) =
          (Pi.single j (1 : Λ_s) : Fin n → Λ_s) := by
        ext k
        simp only [p_vec, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.single_apply]
        split_ifs <;> simp
      rw [hp_single, hFreeHom_0u_single]

    have hγJ₀_p : ∀ u, γJ₀_L (p_vec u) = πG₀ (γ₀_J u) := hDescend πG₀ γ₀_J
    have hγJ₁_p : ∀ u, γJ₁_L (p_vec u) = πG₁ (γ₁_J u) := hDescend πG₁ γ₁_J
    have hγJ₂_p : ∀ u, γJ₂_L (p_vec u) = πG₂ (γ₂_J u) := hDescend πG₂ γ₂_J
    have hhJ₁_p : ∀ u, hJ₁_L (p_vec u) = πG₀ (h₁_J u) := hDescend πG₀ h₁_J
    have hhJ₂_p : ∀ u, hJ₂_L (p_vec u) = πG₁ (h₂_J u) := hDescend πG₁ h₂_J

    let d₀_P := ((P_K.D₀).map cast_s).mulVecLin
    let d₁_P := ((P_K.D₁).map cast_s).mulVecLin
    let φ₀_P := ((P_K.Φ₀).map cast_s).mulVecLin
    let φ₁_P := ((P_K.Φ₁).map cast_s).mulVecLin
    let φ₂_P := ((P_K.Φ₂).map cast_s).mulVecLin
    have hd₀P_p : ∀ u, d₀_P (p_vec u) = p_vec (δ₀_J u) := fun u => by
      change (D₀_mat.map cast_s).mulVecLin (p_vec u) = p_vec (δ₀_J u)
      rw [hp_vec_mat, hD₀_lin]
    have hd₁P_p : ∀ u, d₁_P (p_vec u) = p_vec (δ₁_J u) := fun u => by
      change (D₁_mat.map cast_s).mulVecLin (p_vec u) = p_vec (δ₁_J u)
      rw [hp_vec_mat, hD₁_lin]
    have hφ₀P_p : ∀ u, φ₀_P (p_vec u) = p_vec (Φ₀_J u) := fun u => by
      change (Φ₀_mat.map cast_s).mulVecLin (p_vec u) = p_vec (Φ₀_J u)
      rw [hp_vec_mat, hΦ₀_lin]
    have hφ₁P_p : ∀ u, φ₁_P (p_vec u) = p_vec (Φ₁_J u) := fun u => by
      change (Φ₁_mat.map cast_s).mulVecLin (p_vec u) = p_vec (Φ₁_J u)
      rw [hp_vec_mat, hΦ₁_lin]
    have hφ₂P_p : ∀ u, φ₂_P (p_vec u) = p_vec (Φ₂_J u) := fun u => by
      change (Φ₂_mat.map cast_s).mulVecLin (p_vec u) = p_vec (Φ₂_J u)
      rw [hp_vec_mat, hΦ₂_lin]

    refine ⟨P_K, hLatP, γJ₀_L.toAddMonoidHom, γJ₁_L.toAddMonoidHom, γJ₂_L.toAddMonoidHom,
      hJ₁_L.toAddMonoidHom, hJ₂_L.toAddMonoidHom,
      ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro x
      obtain ⟨u, rfl⟩ := hp_vec_surj x
      change dIG₀ (γJ₀_L (p_vec u)) = γJ₁_L (d₀_P (p_vec u))
      rw [hγJ₀_p, hd₀P_p, hγJ₁_p, hπG.2.2.2.2.2.2.1, hChainJ₀]
    · intro x
      obtain ⟨u, rfl⟩ := hp_vec_surj x
      change dIG₁ (γJ₁_L (p_vec u)) = γJ₂_L (d₁_P (p_vec u))
      rw [hγJ₁_p, hd₁P_p, hγJ₂_p, hπG.2.2.2.2.2.2.2.1, hChainJ₁_apply]
    · intro x
      obtain ⟨u, rfl⟩ := hp_vec_surj x
      change ψG₀ (γJ₀_L (p_vec u)) - γJ₀_L (φ₀_P (p_vec u)) = hJ₁_L (d₀_P (p_vec u))
      rw [hγJ₀_p, hφ₀P_p, hγJ₀_p, hd₀P_p, hhJ₁_p, hπG.2.2.2.2.2.2.2.2.1, ← map_sub, hHomJ₀]
    · intro x
      obtain ⟨u, rfl⟩ := hp_vec_surj x
      change ψG₁ (γJ₁_L (p_vec u)) - γJ₁_L (φ₁_P (p_vec u)) =
        dIG₀ (hJ₁_L (p_vec u)) + hJ₂_L (d₁_P (p_vec u))
      rw [hγJ₁_p, hφ₁P_p, hγJ₁_p, hhJ₁_p, hd₁P_p, hhJ₂_p, hπG.2.2.2.2.2.2.2.2.2.1,
        hπG.2.2.2.2.2.2.1, ← map_sub, ← map_add, hHomJ₁]
    · intro x
      obtain ⟨u, rfl⟩ := hp_vec_surj x
      change ψG₂ (γJ₂_L (p_vec u)) - γJ₂_L (φ₂_P (p_vec u)) = dIG₁ (hJ₂_L (p_vec u))
      rw [hγJ₂_p, hφ₂P_p, hγJ₂_p, hhJ₂_p, hπG.2.2.2.2.2.2.2.2.2.2,
        hπG.2.2.2.2.2.2.2.1, ← map_sub, hHomJ₂]
    · 
      intro x hx_d hx_γ
      obtain ⟨u₀, rfl⟩ := hp_vec_surj x
      have hd_p : p_vec (δ₀_J u₀) = 0 := (hd₀P_p u₀).symm.trans hx_d
      obtain ⟨t₁, ht₁⟩ := (hp_vec_ker (δ₀_J u₀)).mp hd_p
      have hγ_p : πG₀ (γ₀_J u₀) = 0 := (hγJ₀_p u₀).symm.trans hx_γ
      obtain ⟨t₀, ht₀⟩ := (hπG.2.2.2.1 (γ₀_J u₀)).mp hγ_p
      have hz_mem : (dJ₀ t₀ - γ₁_J t₁, δ₁_J t₁) ∈ Z₁_J := by
        change dJ₁ (dJ₀ t₀ - γ₁_J t₁) + γ₂_J (δ₁_J t₁) = 0
        rw [map_sub, hdJ_apply, zero_sub, hChainJ₁_apply, neg_add_cancel]
      let z_t : ↥Z₁_J := ⟨(dJ₀ t₀ - γ₁_J t₁, δ₁_J t₁), hz_mem⟩
      have hzt_tor : (ℓ ^ (s + 1) : ℕ) • z_t = 0 := by
        apply Subtype.ext
        apply Prod.ext
        · change (ℓ ^ (s + 1) : ℕ) • (dJ₀ t₀ - γ₁_J t₁) = 0
          rw [nsmul_sub, ← map_nsmul, ← map_nsmul, ← ht₀, ← ht₁, hChainJ₀, sub_self]
        · change (ℓ ^ (s + 1) : ℕ) • δ₁_J t₁ = 0
          rw [← map_nsmul, ← ht₁]
          exact LinearMap.congr_fun hδ_J u₀
      obtain ⟨w_z, hw_z⟩ := hPer_Z₁J (s + 1) hsK z_t hzt_tor
      obtain ⟨t₀', t₁', ht'₁, ht'₂⟩ := hConeJ₁ w_z.1.1 w_z.1.2 w_z.2
      let q₀_mod := t₀ - (ℓ ^ (K - (s + 1)) : ℕ) • t₀'
      let q₁_mod := -t₁ - (ℓ ^ (K - (s + 1)) : ℕ) • t₁'
      have h0_mod : dJ₀ q₀_mod + γ₁_J q₁_mod = 0 := by
        have h1 : dJ₀ t₀ - γ₁_J t₁ = (ℓ ^ (K - (s + 1)) : ℕ) • w_z.1.1 :=
          congrArg (fun u : ↥Z₁_J => u.1.1) hw_z
        dsimp [q₀_mod, q₁_mod]
        rw [map_sub, map_sub, map_neg, map_nsmul, map_nsmul]
        calc (dJ₀ t₀ - (ℓ ^ (K - (s + 1)) : ℕ) • dJ₀ t₀') +
              (-γ₁_J t₁ - (ℓ ^ (K - (s + 1)) : ℕ) • γ₁_J t₁')
            = (dJ₀ t₀ - γ₁_J t₁) - (ℓ ^ (K - (s + 1)) : ℕ) • (dJ₀ t₀' + γ₁_J t₁') := by
              rw [nsmul_add]; abel
          _ = 0 := by rw [ht'₁, h1, sub_self]
      have h1_mod : δ₁_J q₁_mod = 0 := by
        have h2 : δ₁_J t₁ = (ℓ ^ (K - (s + 1)) : ℕ) • w_z.1.2 :=
          congrArg (fun u : ↥Z₁_J => u.1.2) hw_z
        dsimp [q₁_mod]
        rw [map_sub, map_neg, map_nsmul]
        calc -δ₁_J t₁ - (ℓ ^ (K - (s + 1)) : ℕ) • δ₁_J t₁'
            = (ℓ ^ (K - (s + 1)) : ℕ) • (-δ₁_J t₁') - δ₁_J t₁ := by rw [smul_neg]; abel
          _ = 0 := by rw [ht'₂, h2, sub_self]
      obtain ⟨u₀', hu₀'_γ, hu₀'_δ⟩ := hConeJ₀ q₀_mod q₁_mod h0_mod h1_mod
      have hu₀_eq : u₀ = (ℓ ^ (s + 1) : ℕ) • u₀' := by
        apply sub_eq_zero.mp
        apply hConeJ₀_inj (u₀ - (ℓ ^ (s + 1) : ℕ) • u₀')
        · rw [map_sub, map_nsmul, hu₀'_γ]
          dsimp [q₀_mod]
          rw [nsmul_sub, ← mul_nsmul', ← pow_add, Nat.add_sub_of_le hsK,
            hTorJ.1 t₀', sub_zero, ht₀, sub_self]
        · rw [map_sub, map_nsmul]
          have hu₀'_δ' : δ₀_J u₀' = -q₁_mod := neg_eq_iff_eq_neg.mp hu₀'_δ
          have hneg_q₁ : -q₁_mod = t₁ + (ℓ ^ (K - (s + 1)) : ℕ) • t₁' := by
            dsimp [q₁_mod]
            abel
          rw [hu₀'_δ', hneg_q₁, nsmul_add, ← mul_nsmul', ← pow_add, Nat.add_sub_of_le hsK,
            hTor_free t₁', add_zero, ht₁, sub_self]
      exact (hp_vec_ker u₀).mpr ⟨u₀', hu₀_eq⟩
    · 
      intro y hy
      obtain ⟨y₀, rfl⟩ := hπG.1 y
      have hdy₀ : πG₁ (dJ₀ y₀) = 0 := (hπG.2.2.2.2.2.2.1 y₀).symm.trans hy
      obtain ⟨w₁, hw₁⟩ := (hπG.2.2.2.2.1 (dJ₀ y₀)).mp hdy₀
      have hdw₁_tor : (ℓ ^ (s + 1) : ℕ) • dJ₁ w₁ = 0 := by
        rw [← map_nsmul, ← hw₁, hdJ_apply]
      obtain ⟨q₂, hq₂⟩ := (hPerJ (s + 1) hsK).2.2 (dJ₁ w₁) hdw₁_tor
      obtain ⟨q₁, r₂, hqr⟩ := hConeJ₂ q₂
      let w₁' := w₁ - (ℓ ^ (K - (s + 1)) : ℕ) • q₁
      let v₂' := - ((ℓ ^ (K - (s + 1)) : ℕ) • r₂)
      have h0_wv : dJ₁ w₁' + γ₂_J v₂' = 0 := by
        dsimp [w₁', v₂']
        rw [map_sub, map_neg, map_nsmul, map_nsmul]
        calc (dJ₁ w₁ - (ℓ ^ (K - (s + 1)) : ℕ) • dJ₁ q₁) + - ((ℓ ^ (K - (s + 1)) : ℕ) • γ₂_J r₂)
            = dJ₁ w₁ - (ℓ ^ (K - (s + 1)) : ℕ) • (dJ₁ q₁ + γ₂_J r₂) := by rw [nsmul_add]; abel
          _ = 0 := by rw [hqr, ← hq₂, sub_self]
      obtain ⟨t₀, t₁, ht₁_eq, ht₂_eq⟩ := hConeJ₁ w₁' v₂' h0_wv
      have h0_y₀ : dJ₀ (y₀ - (ℓ ^ (s + 1) : ℕ) • t₀) + γ₁_J (- ((ℓ ^ (s + 1) : ℕ) • t₁)) = 0 := by
        rw [map_sub, map_neg, map_nsmul, map_nsmul]
        have hw₁'_mul : (ℓ ^ (s + 1) : ℕ) • w₁' = dJ₀ y₀ := by
          dsimp [w₁']
          rw [nsmul_sub, ← mul_nsmul', ← pow_add, Nat.add_sub_of_le hsK,
            hTorJ.2.1 q₁, sub_zero, hw₁]
        calc (dJ₀ y₀ - (ℓ ^ (s + 1) : ℕ) • dJ₀ t₀) + - ((ℓ ^ (s + 1) : ℕ) • γ₁_J t₁)
            = dJ₀ y₀ - (ℓ ^ (s + 1) : ℕ) • (dJ₀ t₀ + γ₁_J t₁) := by rw [nsmul_add]; abel
          _ = 0 := by rw [ht₁_eq, hw₁'_mul, sub_self]
      have h1_y₀ : δ₁_J (- ((ℓ ^ (s + 1) : ℕ) • t₁)) = 0 := by
        rw [map_neg, map_nsmul, ← smul_neg, ht₂_eq]
        dsimp [v₂']
        rw [smul_neg, ← mul_nsmul', ← pow_add, Nat.add_sub_of_le hsK, hTor_free r₂, neg_zero]
      obtain ⟨u₀, hu₀_γ, hu₀_δ⟩ := hConeJ₀ _ _ h0_y₀ h1_y₀
      refine ⟨p_vec u₀, ?_, ?_⟩
      · rw [hd₀P_p]
        have hu₀_δ' : δ₀_J u₀ = (ℓ ^ (s + 1) : ℕ) • t₁ := neg_inj.mp hu₀_δ
        exact (hp_vec_ker (δ₀_J u₀)).mpr ⟨t₁, hu₀_δ'⟩
      · change γJ₀_L (p_vec u₀) = πG₀ y₀
        rw [hγJ₀_p, hu₀_γ, map_sub]
        have hker : πG₀ ((ℓ ^ (s + 1) : ℕ) • t₀) = 0 :=
          (hπG.2.2.2.1 _).mpr ⟨t₀, rfl⟩
        rw [hker, sub_zero]
    · 
      intro x hx_d hmem
      rcases hmem with ⟨z, hz⟩
      obtain ⟨u₁, rfl⟩ := hp_vec_surj x
      obtain ⟨y₀, rfl⟩ := hπG.1 z
      have hd_p : p_vec (δ₁_J u₁) = 0 := (hd₁P_p u₁).symm.trans hx_d
      obtain ⟨v₂, hv₂⟩ := (hp_vec_ker (δ₁_J u₁)).mp hd_p
      have hγ_p : πG₁ (γ₁_J u₁ - dJ₀ y₀) = 0 := by
        rw [map_sub, ← hγJ₁_p, ← hπG.2.2.2.2.2.2.1, sub_eq_zero]
        exact hz
      obtain ⟨w₁, hw₁⟩ := (hπG.2.2.2.2.1 _).mp hγ_p
      have htor_J₂ : (ℓ ^ (s + 1) : ℕ) • (dJ₁ w₁ - γ₂_J v₂) = 0 := by
        rw [nsmul_sub, ← map_nsmul, ← map_nsmul, ← hw₁, ← hv₂, map_sub,
          hdJ_apply, sub_zero, hChainJ₁_apply, sub_self]
      obtain ⟨q₂, hq₂⟩ := (hPerJ (s + 1) hsK).2.2 _ htor_J₂
      obtain ⟨q₁, r₂, hqr⟩ := hConeJ₂ q₂
      let w₁' := w₁ - (ℓ ^ (K - (s + 1)) : ℕ) • q₁
      let v₂' := v₂ + (ℓ ^ (K - (s + 1)) : ℕ) • r₂
      have h0_wv : dJ₁ w₁' + γ₂_J (-v₂') = 0 := by
        dsimp [w₁', v₂']
        rw [map_sub, map_neg, map_add, map_nsmul, map_nsmul]
        calc (dJ₁ w₁ - (ℓ ^ (K - (s + 1)) : ℕ) • dJ₁ q₁) +
              -(γ₂_J v₂ + (ℓ ^ (K - (s + 1)) : ℕ) • γ₂_J r₂)
            = (dJ₁ w₁ - γ₂_J v₂) - (ℓ ^ (K - (s + 1)) : ℕ) • (dJ₁ q₁ + γ₂_J r₂) := by
              rw [nsmul_add]; abel
          _ = 0 := by rw [hqr, ← hq₂, sub_self]
      obtain ⟨t₀, t₁, ht₁_eq, ht₂_eq⟩ := hConeJ₁ w₁' (-v₂') h0_wv
      have ht₂_eq' : δ₁_J t₁ = v₂' := neg_inj.mp ht₂_eq
      let u₁' := u₁ - (ℓ ^ (s + 1) : ℕ) • t₁
      have hu₁'_δ : δ₁_J u₁' = 0 := by
        dsimp [u₁']
        rw [map_sub, map_nsmul, ht₂_eq']
        dsimp [v₂']
        rw [nsmul_add, ← mul_nsmul', ← pow_add, Nat.add_sub_of_le hsK,
          hTor_free r₂, add_zero, hv₂, sub_self]
      have hu₁'_0 : dJ₀ (-(y₀ + (ℓ ^ (s + 1) : ℕ) • t₀)) + γ₁_J u₁' = 0 := by
        dsimp [u₁']
        rw [map_neg, map_add, map_nsmul, map_sub, map_nsmul]
        have hw₁'_mul : (ℓ ^ (s + 1) : ℕ) • w₁' = γ₁_J u₁ - dJ₀ y₀ := by
          dsimp [w₁']
          rw [nsmul_sub, ← mul_nsmul', ← pow_add, Nat.add_sub_of_le hsK,
            hTorJ.2.1 q₁, sub_zero, hw₁]
        calc -(dJ₀ y₀ + (ℓ ^ (s + 1) : ℕ) • dJ₀ t₀) + (γ₁_J u₁ - (ℓ ^ (s + 1) : ℕ) • γ₁_J t₁)
            = (γ₁_J u₁ - dJ₀ y₀) - (ℓ ^ (s + 1) : ℕ) • (dJ₀ t₀ + γ₁_J t₁) := by
              rw [nsmul_add]; abel
          _ = 0 := by rw [ht₁_eq, hw₁'_mul, sub_self]
      obtain ⟨u₀, _, hu₀_δ⟩ := hConeJ₀ _ _ hu₁'_0 hu₁'_δ
      refine ⟨p_vec (-u₀), ?_⟩
      rw [hd₀P_p, map_neg δ₀_J, hu₀_δ]
      dsimp [u₁']
      rw [map_sub, (hp_vec_ker _).mpr ⟨t₁, rfl⟩, sub_zero]
    · 
      intro y hy
      obtain ⟨y₁, rfl⟩ := hπG.2.1 y
      have hdy₁ : πG₂ (dJ₁ y₁) = 0 := (hπG.2.2.2.2.2.2.2.1 y₁).symm.trans hy
      obtain ⟨w₂, hw₂⟩ := (hπG.2.2.2.2.2.1 (dJ₁ y₁)).mp hdy₁
      obtain ⟨w₁, v₂, hwv⟩ := hConeJ₂ (-w₂)
      have h0 : dJ₁ (y₁ + (ℓ ^ (s + 1) : ℕ) • w₁) + γ₂_J ((ℓ ^ (s + 1) : ℕ) • v₂) = 0 := by
        rw [map_add, map_nsmul, map_nsmul, add_assoc, ← nsmul_add, hwv, smul_neg, hw₂,
          add_neg_cancel]
      obtain ⟨y₀, u₁, hyu, hδu⟩ := hConeJ₁ _ _ h0
      refine ⟨p_vec u₁, ?_, πG₀ y₀, ?_⟩
      · rw [hd₁P_p]
        have hδu' : δ₁_J u₁ = (ℓ ^ (s + 1) : ℕ) • (-v₂) := by
          rw [smul_neg]
          exact neg_eq_iff_eq_neg.mp hδu
        exact (hp_vec_ker _).mpr ⟨-v₂, hδu'⟩
      · change πG₁ y₁ - γJ₁_L (p_vec u₁) = dIG₀ (πG₀ y₀)
        rw [hγJ₁_p, hπG.2.2.2.2.2.2.1, ← map_sub]
        have hsub_eq : y₁ - γ₁_J u₁ = dJ₀ y₀ - (ℓ ^ (s + 1) : ℕ) • w₁ := by
          calc y₁ - γ₁_J u₁
              = (y₁ + (ℓ ^ (s + 1) : ℕ) • w₁) - (ℓ ^ (s + 1) : ℕ) • w₁ - γ₁_J u₁ := by abel
            _ = (dJ₀ y₀ + γ₁_J u₁) - (ℓ ^ (s + 1) : ℕ) • w₁ - γ₁_J u₁ := by rw [← hyu]
            _ = dJ₀ y₀ - (ℓ ^ (s + 1) : ℕ) • w₁ := by abel
        rw [hsub_eq, map_sub]
        have hker : πG₁ ((ℓ ^ (s + 1) : ℕ) • w₁) = 0 :=
          (hπG.2.2.2.2.1 _).mpr ⟨w₁, rfl⟩
        rw [hker, sub_zero]
    · 
      intro x hmem
      rcases hmem with ⟨z, hz⟩
      obtain ⟨u₂, rfl⟩ := hp_vec_surj x
      obtain ⟨y₁, rfl⟩ := hπG.2.1 z
      have hγ_p : πG₂ (γ₂_J u₂ - dJ₁ y₁) = 0 := by
        rw [map_sub, ← hγJ₂_p, ← hπG.2.2.2.2.2.2.2.1, sub_eq_zero]
        exact hz
      obtain ⟨w₂, hw₂⟩ := (hπG.2.2.2.2.2.1 _).mp hγ_p
      obtain ⟨w₁, v₂, hwv⟩ := hConeJ₂ w₂
      have h0 : dJ₁ (-(y₁ + (ℓ ^ (s + 1) : ℕ) • w₁)) +
          γ₂_J (u₂ - (ℓ ^ (s + 1) : ℕ) • v₂) = 0 := by
        rw [map_neg, map_add, map_nsmul, map_sub, map_nsmul]
        calc -(dJ₁ y₁ + (ℓ ^ (s + 1) : ℕ) • dJ₁ w₁) + (γ₂_J u₂ - (ℓ ^ (s + 1) : ℕ) • γ₂_J v₂)
            = (γ₂_J u₂ - dJ₁ y₁) - (ℓ ^ (s + 1) : ℕ) • (dJ₁ w₁ + γ₂_J v₂) := by
              rw [nsmul_add]; abel
          _ = 0 := by rw [hwv, hw₂, sub_self]
      obtain ⟨_, u₁, _, hδu⟩ := hConeJ₁ _ _ h0
      refine ⟨p_vec (-u₁), ?_⟩
      rw [hd₁P_p, map_neg δ₁_J, hδu, map_sub, (hp_vec_ker _).mpr ⟨v₂, rfl⟩, sub_zero]
    · 
      intro y
      obtain ⟨y₂, rfl⟩ := hπG.2.2.1 y
      obtain ⟨y₁, u₂, hyu⟩ := hConeJ₂ y₂
      refine ⟨p_vec u₂, πG₁ y₁, ?_⟩
      change πG₂ y₂ - γJ₂_L (p_vec u₂) = dIG₁ (πG₁ y₁)
      rw [hγJ₂_p, hπG.2.2.2.2.2.2.2.1, ← map_sub, ← hyu, add_sub_cancel_right]

  obtain ⟨P_K, hLatP, γJ₀, γJ₁, γJ₂, hJ₁, hJ₂,
    hChainJ₀_bar, hChainJ₁_bar, hHomJ₀_bar, hHomJ₁_bar, hHomJ₂_bar,
    hQJ0_inj, hQJ0_surj, hQJ1_inj, hQJ1_surj, hQJ2_inj, hQJ2_surj⟩ := hBlockD

  
  
  
  let Rel_sub : ∀ (X : Type u) [AddCommGroup X] [Module R_K X], AddSubgroup (Fin N → X) :=
    fun X _ _ =>
      AddSubgroup.closure (
        { u | ∃ w : Fin N → X, u = (ℓ ^ (s + 1) : ℕ) • w } ∪
        { u | ∃ (g : Γ) (w : Fin N → X),
          u = (fun i => (MonoidAlgebra.single g (1 : ZMod (ℓ ^ K)) : R_K) • w i) -
            (fun i => ∑ j : Fin N,
              s_scalar (((τ_rep g⁻¹).val i j).val : ZMod (ℓ ^ K)) • w j) })

  let F_inv : ∀ (X : Type u) [AddCommGroup X] [Module R_K X], Type u :=
    fun X _ _ => (Fin N → X) ⧸ Rel_sub X

  let q_inv : ∀ (X : Type u) [AddCommGroup X] [Module R_K X], (Fin N → X) →+ F_inv X :=
    fun X _ _ => QuotientAddGroup.mk' (Rel_sub X)

  have hTor_Finv : ∀ (X : Type u) [AddCommGroup X] [Module R_K X] (x : F_inv X),
      (ℓ ^ (s + 1) : ℕ) • x = 0 := by
    intro X _ _ x
    obtain ⟨w, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub X) x
    rw [← map_nsmul, ← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
    exact AddSubgroup.subset_closure (Or.inl ⟨w, rfl⟩)

  let map_Finv : ∀ {X Y : Type u} [AddCommGroup X] [AddCommGroup Y]
      [Module R_K X] [Module R_K Y] (f : X →ₗ[R_K] Y), F_inv X →+ F_inv Y :=
    fun {X Y} _ _ _ _ f =>
      let φ : (Fin N → X) →+ (Fin N → Y) :=
        { toFun := fun v i => f (v i)
          map_zero' := by funext i; exact map_zero f
          map_add' := fun u v => by funext i; exact map_add f (u i) (v i) }
      QuotientAddGroup.lift (Rel_sub X) ((q_inv Y).comp φ) (by
        have hsub_rel : Rel_sub X ≤ AddSubgroup.comap φ (Rel_sub Y) := by
          rw [AddSubgroup.closure_le]
          rintro v (⟨w, rfl⟩ | ⟨g, w, rfl⟩)
          · change φ ((ℓ ^ (s + 1) : ℕ) • w) ∈ Rel_sub Y
            refine AddSubgroup.subset_closure (Or.inl ⟨φ w, ?_⟩)
            exact map_nsmul φ (ℓ ^ (s + 1)) w
          · change φ _ ∈ Rel_sub Y
            refine AddSubgroup.subset_closure (Or.inr ⟨g, φ w, ?_⟩)
            funext i
            change f (((MonoidAlgebra.single g (1 : Λ_K) : R_K) • w i) -
                ∑ j : Fin N, s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • w j) =
              (MonoidAlgebra.single g (1 : Λ_K) : R_K) • f (w i) -
                ∑ j : Fin N, s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • f (w j)
            rw [map_sub, map_smul, map_sum]
            refine congrArg ((MonoidAlgebra.single g (1 : Λ_K) : R_K) • f (w i) - ·) ?_
            exact Finset.sum_congr rfl fun j _ => map_smul f _ (w j)
        intro u hu
        rw [AddMonoidHom.mem_ker, AddMonoidHom.comp_apply, ← AddMonoidHom.mem_ker,
          QuotientAddGroup.ker_mk']
        exact hsub_rel hu)

  have hmap_Finv_mk : ∀ {X Y : Type u} [AddCommGroup X] [AddCommGroup Y]
      [Module R_K X] [Module R_K Y] (f : X →ₗ[R_K] Y) (v : Fin N → X),
      map_Finv f (q_inv X v) = q_inv Y (fun i => f (v i)) :=
    fun _ _ => rfl

  
  let c_rel := Fintype.card (Option Γ × Fin N)
  let e_rel : Fin c_rel ≃ Option Γ × Fin N := (Fintype.equivFin (Option Γ × Fin N)).symm
  let M_rel : Option Γ × Fin N → Fin N → R_K := fun p i =>
    match p with
    | (none, j₀) => if i = j₀ then s_scalar ((ℓ ^ (s + 1) : ℕ) : Λ_K) else 0
    | (some g, j₀) =>
      (if i = j₀ then MonoidAlgebra.single g (1 : Λ_K) else 0) -
        s_scalar (((τ_rep g⁻¹).val i j₀).val : Λ_K)
  let B_rel : Fin c_rel → Fin N → R_K := fun k i => M_rel (e_rel k) i

  have hCol_none : ∀ {X : Type u} [AddCommGroup X] [Module R_K X] (j₀ : Fin N) (x₀ : X),
      (fun i : Fin N => M_rel (none, j₀) i • x₀) =
        (ℓ ^ (s + 1) : ℕ) • (Pi.single j₀ x₀ : Fin N → X) := by
    intro X _ _ j₀ x₀
    funext i
    change (if i = j₀ then s_scalar ((ℓ ^ (s + 1) : ℕ) : Λ_K) else 0) • x₀ =
      (ℓ ^ (s + 1) : ℕ) • (Pi.single j₀ x₀ : Fin N → X) i
    by_cases h : i = j₀
    · subst h
      simp only [↓reduceIte, hs_scalar_nat, Pi.single_eq_same]
    · simp only [h, ↓reduceIte, zero_smul, Pi.single_eq_of_ne h, nsmul_zero]

  have hCol_some : ∀ {X : Type u} [AddCommGroup X] [Module R_K X] (g : Γ) (j₀ : Fin N) (x₀ : X),
      (fun i : Fin N => M_rel (some g, j₀) i • x₀) =
        (fun i => (MonoidAlgebra.single g (1 : Λ_K) : R_K) • (Pi.single j₀ x₀ : Fin N → X) i) -
        (fun i => ∑ j : Fin N,
          s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • (Pi.single j₀ x₀ : Fin N → X) j) := by
    intro X _ _ g j₀ x₀
    funext i
    change ((if i = j₀ then MonoidAlgebra.single g (1 : Λ_K) else 0) -
        s_scalar (((τ_rep g⁻¹).val i j₀).val : Λ_K)) • x₀ =
      (MonoidAlgebra.single g (1 : Λ_K) : R_K) • (Pi.single j₀ x₀ : Fin N → X) i -
        ∑ j : Fin N, s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • (Pi.single j₀ x₀ : Fin N → X) j
    rw [sub_smul]
    have h1 : (if i = j₀ then MonoidAlgebra.single g (1 : Λ_K) else 0) • x₀ =
        (MonoidAlgebra.single g (1 : Λ_K) : R_K) • (Pi.single j₀ x₀ : Fin N → X) i := by
      by_cases h : i = j₀
      · subst h
        simp only [↓reduceIte, Pi.single_eq_same]
      · simp only [h, ↓reduceIte, zero_smul, Pi.single_eq_of_ne h, smul_zero]
    have h2 : s_scalar (((τ_rep g⁻¹).val i j₀).val : Λ_K) • x₀ =
        ∑ j : Fin N,
          s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • (Pi.single j₀ x₀ : Fin N → X) j := by
      symm
      rw [Finset.sum_eq_single j₀]
      · simp only [Pi.single_eq_same]
      · intro j _ hj
        rw [Pi.single_eq_of_ne hj, smul_zero]
      · intro hj₀
        exact False.elim (hj₀ (Finset.mem_univ j₀))
    rw [h1, h2]

  have hRel_mat : ∀ (X : Type u) [AddCommGroup X] [Module R_K X] (u : Fin N → X),
      u ∈ Rel_sub X ↔ ∃ z : Fin c_rel → X, ∀ i : Fin N, u i = ∑ k : Fin c_rel, B_rel k i • z k := by
    intro X _ _ u
    let S_B : AddSubgroup (Fin N → X) :=
      { carrier := { v | ∃ z : Fin c_rel → X, ∀ i : Fin N, v i = ∑ k : Fin c_rel, B_rel k i • z k }
        zero_mem' := ⟨0, fun i => by simp⟩
        add_mem' := by
          rintro v₁ v₂ ⟨z₁, hz₁⟩ ⟨z₂, hz₂⟩
          refine ⟨z₁ + z₂, fun i => ?_⟩
          rw [Pi.add_apply, hz₁ i, hz₂ i, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl fun k _ => (smul_add (B_rel k i) (z₁ k) (z₂ k)).symm
        neg_mem' := by
          rintro v ⟨z, hz⟩
          refine ⟨-z, fun i => ?_⟩
          rw [Pi.neg_apply, hz i, ← Finset.sum_neg_distrib]
          exact Finset.sum_congr rfl fun k _ => (smul_neg (B_rel k i) (z k)).symm }
    have hM_mem_SB : ∀ (p : Option Γ × Fin N) (x₀ : X),
        (fun i : Fin N => M_rel p i • x₀) ∈ S_B := by
      intro p x₀
      let k₀ := e_rel.symm p
      refine ⟨Pi.single k₀ x₀, fun i => ?_⟩
      symm
      rw [Finset.sum_eq_single k₀]
      · dsimp [B_rel]
        rw [Equiv.apply_symm_apply, Pi.single_eq_same]
      · intro k _ hk
        rw [Pi.single_eq_of_ne hk, smul_zero]
      · intro hk₀
        exact False.elim (hk₀ (Finset.mem_univ k₀))
    constructor
    · have hsub_SB : Rel_sub X ≤ S_B := by
        rw [AddSubgroup.closure_le]
        rintro v (⟨w, rfl⟩ | ⟨g, w, rfl⟩)
        · rw [SetLike.mem_coe]
          have hw_eq : (ℓ ^ (s + 1) : ℕ) • w =
              ∑ j₀ : Fin N, (fun i : Fin N => M_rel (none, j₀) i • w j₀) := by
            funext i
            rw [Finset.sum_apply, Pi.smul_apply]
            symm
            rw [Finset.sum_eq_single i]
            · change (if i = i then s_scalar ((ℓ ^ (s + 1) : ℕ) : Λ_K) else 0) • w i =
                (ℓ ^ (s + 1) : ℕ) • w i
              simp only [↓reduceIte, hs_scalar_nat]
            · intro j₀ _ hj₀
              change (if i = j₀ then s_scalar ((ℓ ^ (s + 1) : ℕ) : Λ_K) else 0) • w j₀ = 0
              simp only [Ne.symm hj₀, ↓reduceIte, zero_smul]
            · intro hi
              exact False.elim (hi (Finset.mem_univ i))
          rw [hw_eq]
          exact AddSubgroup.sum_mem S_B fun j₀ _ => hM_mem_SB (none, j₀) (w j₀)
        · rw [SetLike.mem_coe]
          have hw_eq : ((fun i => (MonoidAlgebra.single g (1 : Λ_K) : R_K) • w i) -
              (fun i => ∑ j : Fin N, s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • w j)) =
              ∑ j₀ : Fin N, (fun i : Fin N => M_rel (some g, j₀) i • w j₀) := by
            funext i
            rw [Finset.sum_apply, Pi.sub_apply]
            have hsum_sub : ∑ j₀ : Fin N, M_rel (some g, j₀) i • w j₀ =
                (∑ j₀ : Fin N, (if i = j₀ then MonoidAlgebra.single g (1 : Λ_K) else 0) • w j₀) -
                (∑ j₀ : Fin N, s_scalar (((τ_rep g⁻¹).val i j₀).val : Λ_K) • w j₀) := by
              rw [← Finset.sum_sub_distrib]
              exact Finset.sum_congr rfl fun j₀ _ => sub_smul _ _ (w j₀)
            rw [hsum_sub]
            refine congrArg (· - ∑ j₀ : Fin N, s_scalar (((τ_rep g⁻¹).val i j₀).val : Λ_K) • w j₀) ?_
            symm
            rw [Finset.sum_eq_single i]
            · simp only [↓reduceIte]
            · intro j₀ _ hj₀
              simp only [Ne.symm hj₀, ↓reduceIte, zero_smul]
            · intro hi
              exact False.elim (hi (Finset.mem_univ i))
          rw [hw_eq]
          exact AddSubgroup.sum_mem S_B fun j₀ _ => hM_mem_SB (some g, j₀) (w j₀)
      exact fun hu => hsub_SB hu
    · rintro ⟨z, hz⟩
      have hu_eq : u = ∑ k : Fin c_rel, (fun i : Fin N => B_rel k i • z k) := by
        funext i
        rw [Finset.sum_apply]
        exact hz i
      rw [hu_eq]
      refine AddSubgroup.sum_mem (Rel_sub X) fun k _ => ?_
      dsimp [B_rel]
      rcases e_rel k with ⟨_ | g, j₀⟩
      · rw [hCol_none j₀ (z k)]
        exact AddSubgroup.subset_closure (Or.inl ⟨Pi.single j₀ (z k), rfl⟩)
      · rw [hCol_some g j₀ (z k)]
        exact AddSubgroup.subset_closure (Or.inr ⟨g, Pi.single j₀ (z k), rfl⟩)

  
  let S_ker_rel : Set (Fin c_rel → R_K) :=
    { u | ∀ i : Fin N, ∑ k : Fin c_rel, B_rel k i * u k = 0 }
  let d_rel := Nat.card S_ker_rel
  let e_ker_rel : Fin d_rel ≃ S_ker_rel := (Finite.equivFin S_ker_rel).symm
  let D_rel : Fin d_rel → Fin c_rel → R_K := fun r k => (e_ker_rel r).1 k
  have hRel_exact_RK : ∀ u : Fin c_rel → R_K,
      (∀ i : Fin N, ∑ k : Fin c_rel, B_rel k i * u k = 0) ↔
      ∃ w : Fin d_rel → R_K, ∀ k : Fin c_rel, u k = ∑ r : Fin d_rel, D_rel r k * w r := by
    intro u
    constructor
    · intro hu
      let r₀ : Fin d_rel := e_ker_rel.symm ⟨u, hu⟩
      refine ⟨Pi.single r₀ (1 : R_K), fun k => ?_⟩
      symm
      rw [Finset.sum_eq_single r₀]
      · rw [Pi.single_eq_same, mul_one]
        dsimp [D_rel]
        rw [Equiv.apply_symm_apply]
      · intro r _ hr
        rw [Pi.single_eq_of_ne hr, mul_zero]
      · intro hr₀
        exact False.elim (hr₀ (Finset.mem_univ r₀))
    · rintro ⟨w, hw⟩ i
      have h1 : ∑ k : Fin c_rel, B_rel k i * u k =
          ∑ r : Fin d_rel, (∑ k : Fin c_rel, B_rel k i * D_rel r k) * w r := by
        calc ∑ k : Fin c_rel, B_rel k i * u k
            = ∑ k : Fin c_rel, ∑ r : Fin d_rel, B_rel k i * (D_rel r k * w r) := by
              refine Finset.sum_congr rfl fun k _ => ?_
              rw [hw k, Finset.mul_sum]
          _ = ∑ r : Fin d_rel, ∑ k : Fin c_rel, (B_rel k i * D_rel r k) * w r := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun r _ =>
                Finset.sum_congr rfl fun k _ => (mul_assoc _ _ _).symm
          _ = ∑ r : Fin d_rel, (∑ k : Fin c_rel, B_rel k i * D_rel r k) * w r := by
              refine Finset.sum_congr rfl fun r _ => (Finset.sum_mul _ _ _).symm
      rw [h1]
      refine Finset.sum_eq_zero fun r _ => ?_
      have hr0 : ∑ k : Fin c_rel, B_rel k i * D_rel r k = 0 := (e_ker_rel r).2 i
      rw [hr0, zero_mul]

  
  have hFinv_ses : ∀ {A_m E_m C_m : Type u} [AddCommGroup A_m] [AddCommGroup E_m] [AddCommGroup C_m]
      [Module R_K A_m] [Module R_K E_m] [Module R_K C_m]
      (ι : A_m →ₗ[R_K] E_m) (π : E_m →ₗ[R_K] C_m),
      Function.Injective ι →
      ι.range = π.ker →
      Function.Surjective π →
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) C_m →
      Function.Injective (map_Finv ι) ∧
      (map_Finv ι).range = (map_Finv π).ker ∧
      Function.Surjective (map_Finv π) := by
    intro A_m E_m C_m _ _ _ _ _ _ ι π hι_inj hEx hπ_surj hFlatC
    have hπ_ι : ∀ a : A_m, π (ι a) = 0 := by
      intro a
      rw [← LinearMap.mem_ker, ← hEx]
      exact ⟨a, rfl⟩
    refine ⟨?_, ?_, ?_⟩
    · 
      rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro x hx
      obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub A_m) x
      rw [AddMonoidHom.mem_ker, hmap_Finv_mk, ← AddMonoidHom.mem_ker,
        QuotientAddGroup.ker_mk'] at hx
      obtain ⟨z_E, hz_E⟩ := (hRel_mat E_m _).mp hx
      have hπz0 : ∀ i : Fin N, ∑ k : Fin c_rel, B_rel k i • π (z_E k) = 0 := by
        intro i
        have hi := congrArg π (hz_E i)
        rw [hπ_ι (a i), map_sum] at hi
        exact (Finset.sum_congr rfl fun k _ => (map_smul π (B_rel k i) (z_E k)).symm).trans hi.symm
      obtain ⟨w_C, hw_C⟩ :=
        (hFlatC N c_rel d_rel D_rel B_rel hRel_exact_RK (fun k => π (z_E k))).mp hπz0
      let w_E : Fin d_rel → E_m := fun r => Classical.choose (hπ_surj (w_C r))
      have hw_E : ∀ r : Fin d_rel, π (w_E r) = w_C r :=
        fun r => Classical.choose_spec (hπ_surj (w_C r))
      let z'_E : Fin c_rel → E_m := fun k => z_E k - ∑ r : Fin d_rel, D_rel r k • w_E r
      have hz'_ker : ∀ k : Fin c_rel, z'_E k ∈ ι.range := by
        intro k
        rw [hEx, LinearMap.mem_ker]
        dsimp [z'_E]
        rw [map_sub, map_sum]
        have h1 : ∑ r : Fin d_rel, π (D_rel r k • w_E r) = ∑ r : Fin d_rel, D_rel r k • w_C r := by
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [map_smul, hw_E r]
        rw [h1, ← hw_C k, sub_self]
      let z_A : Fin c_rel → A_m := fun k => Classical.choose (hz'_ker k)
      have hz_A : ∀ k : Fin c_rel, ι (z_A k) = z'_E k :=
        fun k => Classical.choose_spec (hz'_ker k)
      have ha_rel : a ∈ Rel_sub A_m := by
        rw [hRel_mat A_m]
        refine ⟨z_A, fun i => hι_inj ?_⟩
        rw [hz_E i, map_sum]
        have h1 : ∑ k : Fin c_rel, ι (B_rel k i • z_A k) =
            ∑ k : Fin c_rel, B_rel k i • z'_E k := by
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [map_smul, hz_A k]
        rw [h1]
        dsimp [z'_E]
        simp_rw [smul_sub, Finset.sum_sub_distrib]
        have hkill : ∑ k : Fin c_rel, B_rel k i • ∑ r : Fin d_rel, D_rel r k • w_E r = 0 := by
          have hswap : ∑ k : Fin c_rel, B_rel k i • ∑ r : Fin d_rel, D_rel r k • w_E r =
              ∑ r : Fin d_rel, (∑ k : Fin c_rel, B_rel k i * D_rel r k) • w_E r := by
            calc ∑ k : Fin c_rel, B_rel k i • ∑ r : Fin d_rel, D_rel r k • w_E r
                = ∑ k : Fin c_rel, ∑ r : Fin d_rel, (B_rel k i * D_rel r k) • w_E r := by
                  refine Finset.sum_congr rfl fun k _ => ?_
                  rw [Finset.smul_sum]
                  exact Finset.sum_congr rfl fun r _ => (mul_smul _ _ _).symm
              _ = ∑ r : Fin d_rel, ∑ k : Fin c_rel, (B_rel k i * D_rel r k) • w_E r :=
                  Finset.sum_comm
              _ = ∑ r : Fin d_rel, (∑ k : Fin c_rel, B_rel k i * D_rel r k) • w_E r := by
                  refine Finset.sum_congr rfl fun r _ => Finset.sum_smul.symm
          rw [hswap]
          refine Finset.sum_eq_zero fun r _ => ?_
          rw [(e_ker_rel r).2 i, zero_smul]
        rw [hkill, sub_zero]
      change q_inv A_m a = 0
      rwa [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
    · 
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub A_m) y
        rw [AddMonoidHom.mem_ker, hmap_Finv_mk, hmap_Finv_mk]
        have h0 : (fun i : Fin N => π (ι (a i))) = 0 := funext fun i => hπ_ι (a i)
        rw [h0, map_zero]
      · intro hx
        obtain ⟨e, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub E_m) x
        rw [AddMonoidHom.mem_ker, hmap_Finv_mk, ← AddMonoidHom.mem_ker,
          QuotientAddGroup.ker_mk'] at hx
        obtain ⟨z_C, hz_C⟩ := (hRel_mat C_m _).mp hx
        let z_E : Fin c_rel → E_m := fun k => Classical.choose (hπ_surj (z_C k))
        have hz_E : ∀ k : Fin c_rel, π (z_E k) = z_C k :=
          fun k => Classical.choose_spec (hπ_surj (z_C k))
        let e' : Fin N → E_m := fun i => e i - ∑ k : Fin c_rel, B_rel k i • z_E k
        have he'_ker : ∀ i : Fin N, e' i ∈ ι.range := by
          intro i
          rw [hEx, LinearMap.mem_ker]
          dsimp [e']
          rw [map_sub, map_sum]
          have h1 : ∑ k : Fin c_rel, π (B_rel k i • z_E k) =
              ∑ k : Fin c_rel, B_rel k i • z_C k := by
            refine Finset.sum_congr rfl fun k _ => ?_
            rw [map_smul, hz_E k]
          rw [h1, ← hz_C i, sub_self]
        let a : Fin N → A_m := fun i => Classical.choose (he'_ker i)
        have ha : ∀ i : Fin N, ι (a i) = e' i := fun i => Classical.choose_spec (he'_ker i)
        refine ⟨q_inv A_m a, ?_⟩
        rw [hmap_Finv_mk]
        have ha_eq : (fun i : Fin N => ι (a i)) = e' := funext ha
        rw [ha_eq, ← sub_eq_zero, ← map_sub, ← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
        rw [hRel_mat E_m]
        refine ⟨-z_E, fun i => ?_⟩
        dsimp [e']
        have hsub : e i - (∑ k : Fin c_rel, B_rel k i • z_E k) - e i =
            - ∑ k : Fin c_rel, B_rel k i • z_E k := by abel
        rw [hsub, ← Finset.sum_neg_distrib]
        exact Finset.sum_congr rfl fun k _ => (smul_neg (B_rel k i) (z_E k)).symm
    · 
      intro y
      obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub C_m) y
      let e : Fin N → E_m := fun i => Classical.choose (hπ_surj (v i))
      have he : (fun i : Fin N => π (e i)) = v :=
        funext fun i => Classical.choose_spec (hπ_surj (v i))
      exact ⟨q_inv E_m e, by rw [hmap_Finv_mk, he]⟩

  
  have hFinv_prod_zero : ∀ {X Y : Type u} [AddCommGroup X] [AddCommGroup Y]
      [Module R_K X] [Module R_K Y] (u : Fin N → X) (v : Fin N → Y),
      q_inv X u = 0 → q_inv Y v = 0 → q_inv (X × Y) (fun i => (u i, v i)) = 0 := by
    intro X Y _ _ _ _ u v hu hv
    have hdecomp : (fun i : Fin N => (u i, v i)) =
        (fun i => LinearMap.inl R_K X Y (u i)) + (fun i => LinearMap.inr R_K X Y (v i)) := by
      funext i
      exact Prod.ext (add_zero (u i)).symm (zero_add (v i)).symm
    rw [hdecomp, map_add, ← hmap_Finv_mk, ← hmap_Finv_mk, hu, hv, map_zero, map_zero, add_zero]

  
  let I₀ : Type u := F_inv M_K.M₀
  let I₁ : Type u := F_inv M_K.M₁
