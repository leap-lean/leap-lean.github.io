    fun a b =>
      { toFun := fun z => ((ℓ ^ (b + 1) * z.val : ℕ) : ZMod (ℓ ^ (b + a + 1 + 1)))
        map_zero' := by simp
        map_add' := fun z₁ z₂ => by
          have hdiv := Nat.mod_add_div (z₁.val + z₂.val) (ℓ ^ (a + 1))
          rw [← ZMod.val_add z₁ z₂] at hdiv
          have hmul : ℓ ^ (b + 1) * z₁.val + ℓ ^ (b + 1) * z₂.val =
              ℓ ^ (b + 1) * (z₁ + z₂).val +
                ℓ ^ (b + a + 1 + 1) * ((z₁.val + z₂.val) / ℓ ^ (a + 1)) := by
            have hpow : ℓ ^ (b + 1) * ℓ ^ (a + 1) = ℓ ^ (b + a + 1 + 1) := by
