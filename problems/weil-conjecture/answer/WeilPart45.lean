      let H (m q : ℕ) := CategoryTheory.Abelian.Ext X₀ (K_obj m) q
      ∃ (τ_coh : ∀ q m : ℕ, H (m + 1) q →+ H m q)
        (τ_le : ∀ (q a b : ℕ), a ≤ b → H b q →+ H a q)
        (ι_coh : ∀ q a b : ℕ, H a q →+ H (b + a + 1) q)
        (δ_coh : ∀ q a b : ℕ, H b q →+ H a (q + 1)),
        (∀ q m : ℕ,
          τ_coh q m = (CategoryTheory.Abelian.Ext.mk₀ (τ_s m)).postcomp X₀ (Nat.add_zero q)) ∧
        (∀ q a : ℕ, τ_le q a a (le_refl a) = AddMonoidHom.id (H a q)) ∧
        (∀ (q a b : ℕ) (h : a ≤ b),
          τ_le q a (b + 1) (Nat.le_succ_of_le h) = (τ_le q a b h).comp (τ_coh q b)) ∧
        (∀ (q m : ℕ) (x : H m q), (ℓ ^ (m + 1) : ℕ) • x = 0) ∧
        (∀ (q a b : ℕ) (x : H (b + a + 1) q),
          τ_le q b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)) x = 0 ↔
            ∃ y : H a q, ι_coh q a b y = x) ∧
        (∀ (q a b : ℕ) (x : H b q),
          δ_coh q a b x = 0 ↔
            ∃ y : H (b + a + 1) q,
              τ_le q b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)) y = x) ∧
        (∀ (q a b : ℕ) (y : H a q),
          τ_le q a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b))
            (ι_coh q a b y) = (ℓ ^ (b + 1) : ℕ) • y) ∧
        (∀ (q a b : ℕ) (y : H (a + 1) q),
          ι_coh q a b (τ_coh q a y) = τ_coh q (b + a + 1) (ι_coh q (a + 1) b y)) ∧
        (∀ (q a b : ℕ) (y : H b q),
          τ_coh (q + 1) a (δ_coh q (a + 1) b y) = δ_coh q a b y) := by
    intro 𝒞 _ _ _ X₀ K_obj τ_s τ_sh_le ι_s hTor_s hrefl_s hstep_s h0_s hSE_s hComp_s hComm_s H
    have hpost : ∀ {Y Z : 𝒞} {a n b : ℕ} (β : CategoryTheory.Abelian.Ext Y Z n) (h : a + n = b)
        (x : CategoryTheory.Abelian.Ext X₀ Y a), (β.postcomp X₀ h) x = x.comp β h :=
      fun _ _ _ => rfl
    have hmk₀_nsmul : ∀ {X Y : 𝒞} (n : ℕ) (f : X ⟶ Y),
        CategoryTheory.Abelian.Ext.mk₀ (n • f) = n • CategoryTheory.Abelian.Ext.mk₀ f := by
      intro X Y n f
      induction n with
      | zero => rw [zero_smul, zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero]
      | succ n ih => rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih]
    have hcomp_nsmul_id : ∀ {X : 𝒞} {q : ℕ} (y : CategoryTheory.Abelian.Ext X₀ X q) (n : ℕ),
        y.comp (n • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id X))
          (Nat.add_zero q) = n • y := by
      intro X q y n
      induction n with
      | zero =>
        rw [zero_smul, zero_smul]
        exact CategoryTheory.Abelian.Ext.comp_zero y X 0 q (Nat.add_zero q)
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.comp_add, ih, y.comp_mk₀_id]
    let τ_coh : ∀ q m : ℕ, H (m + 1) q →+ H m q :=
      fun q m => (CategoryTheory.Abelian.Ext.mk₀ (τ_s m)).postcomp X₀ (Nat.add_zero q)
    let τ_le : ∀ (q a b : ℕ), a ≤ b → H b q →+ H a q :=
      fun q a b h => (CategoryTheory.Abelian.Ext.mk₀ (τ_sh_le a b h)).postcomp X₀ (Nat.add_zero q)
    let ι_coh : ∀ q a b : ℕ, H a q →+ H (b + a + 1) q :=
      fun q a b => (CategoryTheory.Abelian.Ext.mk₀ (ι_s a b)).postcomp X₀ (Nat.add_zero q)
    let δ_coh : ∀ q a b : ℕ, H b q →+ H a (q + 1) :=
      fun q a b => (hSE_s a b).extClass.postcomp X₀ (rfl : q + 1 = q + 1)
    refine ⟨τ_coh, τ_le, ι_coh, δ_coh,
      fun _ _ => rfl, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro q a
      ext x
      change (τ_le q a a (le_refl a)) x = x
      rw [hpost, hrefl_s]
      exact x.comp_mk₀_id
    · intro q a b h
      ext x
      change (τ_le q a (b + 1) (Nat.le_succ_of_le h)) x = (τ_le q a b h) ((τ_coh q b) x)
      rw [hpost, hpost, hpost, hstep_s, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact (CategoryTheory.Abelian.Ext.comp_assoc x (CategoryTheory.Abelian.Ext.mk₀ (τ_s b))
        (CategoryTheory.Abelian.Ext.mk₀ (τ_sh_le a b h))
        (Nat.add_zero q) (Nat.add_zero 0) (by omega)).symm
    · intro q m x
      rw [← hcomp_nsmul_id x (ℓ ^ (m + 1)), ← hmk₀_nsmul, hTor_s m,
        CategoryTheory.Abelian.Ext.mk₀_zero]
      exact CategoryTheory.Abelian.Ext.comp_zero x (K_obj m) 0 q (Nat.add_zero q)
    · intro q a b x
      constructor
      · intro hx
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀ (hSE_s a b) x hx
      · rintro ⟨y, rfl⟩
        rw [hpost, hpost,
          CategoryTheory.Abelian.Ext.comp_assoc y (CategoryTheory.Abelian.Ext.mk₀ (ι_s a b))
            (CategoryTheory.Abelian.Ext.mk₀
              (τ_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))))
            (Nat.add_zero q) (Nat.add_zero 0) (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h0_s a b,
          CategoryTheory.Abelian.Ext.mk₀_zero]
        exact CategoryTheory.Abelian.Ext.comp_zero y (K_obj b) 0 q (Nat.add_zero q)
    · intro q a b x
      constructor
      · intro hx
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀ (hSE_s a b) x rfl hx
      · rintro ⟨y, rfl⟩
        rw [hpost, hpost,
          CategoryTheory.Abelian.Ext.comp_assoc y
            (CategoryTheory.Abelian.Ext.mk₀
              (τ_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))))
            (hSE_s a b).extClass (Nat.add_zero q) (Nat.zero_add 1) (by omega),
          CategoryTheory.ShortComplex.ShortExact.comp_extClass (hSE_s a b)]
        exact CategoryTheory.Abelian.Ext.comp_zero y (K_obj a) 1 (q + 1) rfl
    · intro q a b y
      rw [hpost, hpost,
        CategoryTheory.Abelian.Ext.comp_assoc y (CategoryTheory.Abelian.Ext.mk₀ (ι_s a b))
          (CategoryTheory.Abelian.Ext.mk₀
            (τ_sh_le a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b))))
          (Nat.add_zero q) (Nat.add_zero 0) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hComp_s a b, hmk₀_nsmul]
      exact hcomp_nsmul_id y (ℓ ^ (b + 1))
    · intro q a b y
      have hL : ι_coh q a b (τ_coh q a y) =
          (y.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_s a)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (ι_s a b)) (Nat.add_zero q) := rfl
      have hR : τ_coh q (b + a + 1) (ι_coh q (a + 1) b y) =
          (y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_s (a + 1) b)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (τ_s (b + a + 1))) (Nat.add_zero q) := rfl
      rw [hL, hR,
        CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hComm_s a b]
    · intro q a b y
      let S₁ := CategoryTheory.ShortComplex.mk (ι_s (a + 1) b)
        (τ_sh_le b (b + (a + 1) + 1) (Nat.le_succ_of_le (Nat.le_add_right b (a + 1))))
        (h0_s (a + 1) b)
      let S₂ := CategoryTheory.ShortComplex.mk (ι_s a b)
        (τ_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)))
        (h0_s a b)
      have hcomm₂₃ : CategoryTheory.CategoryStruct.comp (τ_s (b + a + 1)) S₂.g =
          CategoryTheory.CategoryStruct.comp S₁.g (CategoryTheory.CategoryStruct.id (K_obj b)) := by
        rw [CategoryTheory.Category.comp_id]
        have hprf : (Nat.le_succ_of_le (Nat.le_add_right b (a + 1)) : b ≤ b + (a + 1) + 1) =
            Nat.le_succ_of_le (Nat.le_succ_of_le (Nat.le_add_right b a)) :=
          Subsingleton.elim _ _
        change CategoryTheory.CategoryStruct.comp (τ_s (b + a + 1))
            (τ_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))) =
          τ_sh_le b (b + (a + 1) + 1) (Nat.le_succ_of_le (Nat.le_add_right b (a + 1)))
        rw [hprf]
        exact (hstep_s b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))).symm
      let φ_SC : S₁ ⟶ S₂ := CategoryTheory.ShortComplex.homMk
        (τ_s a) (τ_s (b + a + 1)) (CategoryTheory.CategoryStruct.id (K_obj b))
        (hComm_s a b) hcomm₂₃
      have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality
        (hSE_s (a + 1) b) (hSE_s a b) φ_SC
      have hL : τ_coh (q + 1) a (δ_coh q (a + 1) b y) =
          (y.comp (hSE_s (a + 1) b).extClass rfl).comp
            (CategoryTheory.Abelian.Ext.mk₀ (τ_s a)) (Nat.add_zero (q + 1)) := rfl
      have hR : δ_coh q a b y = y.comp (hSE_s a b).extClass rfl := rfl
      rw [hL, hR,
        CategoryTheory.Abelian.Ext.comp_assoc y (hSE_s (a + 1) b).extClass
          (CategoryTheory.Abelian.Ext.mk₀ (τ_s a)) rfl (Nat.add_zero 1) (by omega)]
      have hnat' : (hSE_s (a + 1) b).extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_s a)) (Nat.add_zero 1) =
          (hSE_s a b).extClass :=
        hnat.trans ((hSE_s a b).extClass.mk₀_id_comp)
      rw [hnat']
  obtain ⟨τ_K_coh, τ_K_le, ι_K_coh, δ_K_coh,
    hτK_coh_def, hτK_id, hτK_step, hTor_KH,
    hEx_ιK, hEx_δK, hComp_ιK, hComm_ιK, hComm_δK⟩ :=
    hExt_pkg Fℤ_D 𝒦_s τ_𝒦s τ_K_sh_le ι_sh hTor_sh
      (fun a => hsh_refl a (le_refl a))
      (fun a b h => hsh_step a b h (Nat.le_succ_of_le h))
      h0_ab hSE_sh hComp_sh hComm_sh
  exact ⟨m_Γ, equiv_Γ, π_bar, 𝒦_s, triv_K, τ_𝒦s, τ_K_coh, τ_K_le, ι_K_coh, δ_K_coh,
    ⟨hEt_ι, hπ_eq, hFin_π, hEt_π, hSurj_π⟩,
    ⟨hd_one, hd_mul, hd_ι⟩,
    hFibTrans, hSheets,
    fun m => ⟨fun u u_V h₁ h₂ sec y₁ => htriv_nat m u u_V h₁ h₂ sec y₁,
      fun W => ⟨htriv_inj m W, htriv_range m W, fun sec_up y => hτ_triv m W sec_up y⟩⟩,
    hτK_coh_def, hTor_sh, hτK_id, hτK_step, hTor_KH,
    hEx_ιK, hEx_δK, hComp_ιK, hComm_ιK, hComm_δK⟩

theorem weil_geom_cover_zero_ext_mod_prime_constructible_finite_coh (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    (U_bar : X.left.Opens)
    (V_bar : AlgebraicGeometry.Scheme.{u})
    (π_bar : Quiver.Hom V_bar U_bar.toScheme)
    (hFin_π : AlgebraicGeometry.IsFinite π_bar)
    (hEt_π : AlgebraicGeometry.Etale π_bar)
    (hSurj_π : AlgebraicGeometry.Surjective π_bar)
    (ι_bar : Quiver.Hom V_bar X.left)
    (hι_eq : CategoryTheory.CategoryStruct.comp π_bar U_bar.ι = ι_bar)
    (Γ : Type u) [Group Γ] (m_Γ : ℕ) (equiv_Γ : Fin m_Γ ≃ Γ)
    (d : Γ → Quiver.Hom V_bar V_bar)
    (hd_one : d 1 = CategoryTheory.CategoryStruct.id V_bar)
    (hd_mul : ∀ g₁ g₂ : Γ, d (g₁ * g₂) = CategoryTheory.CategoryStruct.comp (d g₂) (d g₁))
    (hd_ι : ∀ σ : Γ, CategoryTheory.CategoryStruct.comp (d σ) ι_bar = ι_bar)
    (hFibTrans : ∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : Quiver.Hom W X.left)
      (y₁ y₂ : ↥(CategoryTheory.Limits.pullback h_W ι_bar)),
      (CategoryTheory.Limits.pullback.fst h_W ι_bar).base y₁ =
        (CategoryTheory.Limits.pullback.fst h_W ι_bar).base y₂ →
      ∃ (σ : Γ)
        (m_σ : Quiver.Hom (CategoryTheory.Limits.pullback h_W ι_bar)
          (CategoryTheory.Limits.pullback h_W ι_bar)),
        CategoryTheory.CategoryStruct.comp m_σ
          (CategoryTheory.Limits.pullback.fst h_W ι_bar) =
          CategoryTheory.Limits.pullback.fst h_W ι_bar ∧
        CategoryTheory.CategoryStruct.comp m_σ
          (CategoryTheory.Limits.pullback.snd h_W ι_bar) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.snd h_W ι_bar) (d σ) ∧
        m_σ.base y₁ = y₂)
    (hSheets : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Quiver.Hom Y V_bar),
      ∃ δ : Γ →
          Quiver.Hom Y
            (CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.comp g_Y ι_bar) ι_bar),
        (∀ σ : Γ,
          CategoryTheory.CategoryStruct.comp (δ σ)
            (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.CategoryStruct.comp g_Y ι_bar) ι_bar) =
            CategoryTheory.CategoryStruct.id Y ∧
          CategoryTheory.CategoryStruct.comp (δ σ)
            (CategoryTheory.Limits.pullback.snd
              (CategoryTheory.CategoryStruct.comp g_Y ι_bar) ι_bar) =
            CategoryTheory.CategoryStruct.comp g_Y (d σ) ∧
          AlgebraicGeometry.Etale (δ σ) ∧
          IsOpen (Set.range (δ σ).base)) ∧
        (∀ σ₁ σ₂ : Γ, σ₁ ≠ σ₂ → Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
        (⋃ σ : Γ, Set.range (δ σ).base) = Set.univ)
    (𝒦₀ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
    (triv₀ : ∀ W : X.left.Etale,
      ↑(𝒦₀.obj.obj (Opposite.op W)) →+
        LocallyConstant
          ↥(CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W).hom ι_bar)
          (ZMod (ℓ ^ (0 + 1))))
    (htriv₀_nat : ∀ {W₁ W₂ : X.left.Etale} (u : Quiver.Hom W₁ W₂)
      (u_V : Quiver.Hom
        (CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W₁).hom ι_bar)
        (CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W₂).hom ι_bar)),
      CategoryTheory.CategoryStruct.comp u_V
        (CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W₂).hom ι_bar) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst
            ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W₁).hom ι_bar)
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).map u).left →
      CategoryTheory.CategoryStruct.comp u_V
        (CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W₂).hom ι_bar) =
        CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W₁).hom ι_bar →
      ∀ (sec : ↑(𝒦₀.obj.obj (Opposite.op W₂))) (y₁),
        triv₀ W₁ ((𝒦₀.obj.map (Opposite.op u)) sec) y₁ = triv₀ W₂ sec (u_V.base y₁))
    (htriv₀_spec : ∀ W : X.left.Etale,
      Function.Injective (triv₀ W) ∧
      Set.range (triv₀ W) =
        { f | ∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W).left.Opens,
          ((TopologicalSpace.Opens.map
            ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W).hom.base).obj U_bar) ⊔ W₀ = ⊤ ∧
          ∀ y,
            (CategoryTheory.Limits.pullback.fst
              ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W).hom ι_bar).base y ∈ W₀ →
              f y = 0 }) :
    ∀ q : ℕ, Finite (𝒦₀.H q) :=
by
  have _ : _ ∧ _ ∧ _ ∧ _ := ⟨hd_one, hd_mul, hd_ι, hFibTrans⟩
  have hSitePkg := weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj.{u}
  rcases hSitePkg with ⟨hMemTop, hPullAdj, hConstEquiv⟩

  
  let isoOfSheafHomEquiv : ∀ {Z_sch : AlgebraicGeometry.Scheme.{u}}
      (A₁ A₂ : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u})
      (E : ∀ 𝒢 : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u},
        (A₁ ⟶ 𝒢) ≃ (A₂ ⟶ 𝒢)),
      (∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u}}
        (f : A₁ ⟶ 𝒢₁) (g : 𝒢₁ ⟶ 𝒢₂), E 𝒢₂ (f ≫ g) = E 𝒢₁ f ≫ g) →
      (A₁ ≅ A₂) :=
    fun A₁ A₂ E hnat =>
      let h_hom_inv : (E A₂).symm (𝟙 A₂) ≫ E A₁ (𝟙 A₁) = 𝟙 A₁ := by
        apply (E A₁).injective
        rw [hnat, (E A₂).apply_symm_apply, CategoryTheory.Category.id_comp]
      { hom := (E A₂).symm (𝟙 A₂)
        inv := E A₁ (𝟙 A₁)
        hom_inv_id := h_hom_inv
        inv_hom_id := by
          calc
            E A₁ (𝟙 A₁) ≫ (E A₂).symm (𝟙 A₂)
                = 𝟙 A₂ ≫ (E A₁ (𝟙 A₁) ≫ (E A₂).symm (𝟙 A₂)) :=
                  (CategoryTheory.Category.id_comp _).symm
            _ = E A₂ ((E A₂).symm (𝟙 A₂)) ≫ (E A₁ (𝟙 A₁) ≫ (E A₂).symm (𝟙 A₂)) := by
                  rw [(E A₂).apply_symm_apply]
            _ = E A₂ ((E A₂).symm (𝟙 A₂) ≫ (E A₁ (𝟙 A₁) ≫ (E A₂).symm (𝟙 A₂))) :=
                  (hnat _ _).symm
            _ = E A₂ (((E A₂).symm (𝟙 A₂) ≫ E A₁ (𝟙 A₁)) ≫ (E A₂).symm (𝟙 A₂)) := by
                  rw [CategoryTheory.Category.assoc]
            _ = E A₂ (𝟙 A₁ ≫ (E A₂).symm (𝟙 A₂)) := by rw [h_hom_inv]
            _ = 𝟙 A₂ := by rw [CategoryTheory.Category.id_comp, (E A₂).apply_symm_apply] }

  let S := X.left
  let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget V_bar
  have _hCompEt : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let _hPbEt : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _hStabEt : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  have sitePullMap_fst : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
      {W₁ W₂ : Z₂.Etale} (v : W₁ ⟶ W₂),
      ((AlgebraicGeometry.Scheme.Etale.forget Z₁).map ((weilEtaleSitePullback h).map v)).left ≫
        CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget Z₂).obj W₂).hom h =
      CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget Z₂).obj W₁).hom h ≫
        ((AlgebraicGeometry.Scheme.Etale.forget Z₂).map v).left :=
    fun {_ _} _ {_ _} _ => CategoryTheory.Limits.pullback.lift_fst _ _ _

  have sitePullMap_snd : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
      {W₁ W₂ : Z₂.Etale} (v : W₁ ⟶ W₂),
      ((AlgebraicGeometry.Scheme.Etale.forget Z₁).map ((weilEtaleSitePullback h).map v)).left ≫
        CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget Z₂).obj W₂).hom h =
      CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget Z₂).obj W₁).hom h :=
    fun {_ _} _ {_ _} _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  let terminalPullbackIso : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
      (hT₁ : CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 Z₁))),
      AlgebraicGeometry.Scheme.Etale.mk (𝟙 Z₁) ≅
        (weilEtaleSitePullback h).obj (AlgebraicGeometry.Scheme.Etale.mk (𝟙 Z₂)) :=
    fun {Z₁ Z₂} h hT₁ =>
      let T₁ : Z₁.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 Z₁)
      let T₂ : Z₂.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 Z₂)
      let B := weilEtaleSitePullback h
      let to_T₁ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
      let u : CategoryTheory.Limits.pullback (𝟙 Z₂) h ⟶ Z₁ :=
        ((AlgebraicGeometry.Scheme.Etale.forget Z₁).map to_T₁).left
      let hu_snd : u = CategoryTheory.Limits.pullback.snd (𝟙 Z₂) h :=
        (CategoryTheory.Category.comp_id u).symm.trans
          (((AlgebraicGeometry.Scheme.Etale.forget Z₁).map to_T₁).w)
      let lft : Z₁ ⟶ CategoryTheory.Limits.pullback (𝟙 Z₂) h :=
        CategoryTheory.Limits.pullback.lift h (𝟙 Z₁)
          ((CategoryTheory.Category.comp_id h).trans (CategoryTheory.Category.id_comp h).symm)
      let from_T₁ : T₁ ⟶ B.obj T₂ :=
        CategoryTheory.MorphismProperty.Over.homMk lft
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      { hom := from_T₁
        inv := to_T₁
        hom_inv_id := hT₁.hom_ext _ _
        inv_hom_id := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (u ≫ lft) ≫ CategoryTheory.Limits.pullback.fst (𝟙 Z₂) h =
              𝟙 _ ≫ CategoryTheory.Limits.pullback.fst (𝟙 Z₂) h
            have hL : (u ≫ lft) ≫ CategoryTheory.Limits.pullback.fst (𝟙 Z₂) h =
                CategoryTheory.Limits.pullback.fst (𝟙 Z₂) h :=
              (CategoryTheory.Category.assoc u lft _).trans
                ((congrArg (u ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((congrArg (· ≫ h) hu_snd).trans
                    (CategoryTheory.Limits.pullback.condition.symm.trans
                      (CategoryTheory.Category.comp_id _))))
            exact hL.trans (CategoryTheory.Category.id_comp _).symm
          · change (u ≫ lft) ≫ CategoryTheory.Limits.pullback.snd (𝟙 Z₂) h =
              𝟙 _ ≫ CategoryTheory.Limits.pullback.snd (𝟙 Z₂) h
            have hL : (u ≫ lft) ≫ CategoryTheory.Limits.pullback.snd (𝟙 Z₂) h =
                CategoryTheory.Limits.pullback.snd (𝟙 Z₂) h :=
              (CategoryTheory.Category.assoc u lft _).trans
                ((congrArg (u ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  ((CategoryTheory.Category.comp_id u).trans hu_snd))
            exact hL.trans (CategoryTheory.Category.id_comp _).symm }

  have hEt_ι : AlgebraicGeometry.Etale ι_bar := by
    rw [← hι_eq]
    exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) π_bar U_bar.ι
      hEt_π inferInstance

  have hRange_sub : Set.range ι_bar.base ⊆ (U_bar : Set S) := by
    rintro x ⟨v, rfl⟩
    rw [← hι_eq, AlgebraicGeometry.Scheme.Hom.comp_apply,
      ← AlgebraicGeometry.Scheme.Opens.range_ι U_bar]
    exact ⟨π_bar.base v, rfl⟩

  
  let e_zmod : ZMod (ℓ ^ (0 + 1)) ≃+* ZMod ℓ := ZMod.ringEquivCongr (Nat.pow_one ℓ)
  have hTor_K0 : ℓ • CategoryTheory.CategoryStruct.id 𝒦₀ = 0 := by
    have h_nsmul_app : ∀ (n : ℕ) (W : S.Etale) (sec : ↑(𝒦₀.obj.obj (Opposite.op W))),
        ((n • CategoryTheory.CategoryStruct.id 𝒦₀).hom.app (Opposite.op W)) sec = n • sec := by
      intro n W sec
      induction n with
      | zero => simp
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((n • CategoryTheory.CategoryStruct.id 𝒦₀).hom.app (Opposite.op W)) sec + sec =
          n • sec + sec
        rw [ih]
    apply CategoryTheory.Sheaf.hom_ext
    ext W sec
    change ((ℓ • CategoryTheory.CategoryStruct.id 𝒦₀).hom.app (Opposite.op W.unop)) sec = 0
    rw [h_nsmul_app]
    apply (htriv₀_spec W.unop).1
    rw [map_zero, map_nsmul]
    ext y
    change ℓ • triv₀ W.unop sec y = 0
    apply e_zmod.injective
    rw [map_zero, map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]

  
  
  let A_rank : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin m_Γ → ZMod ℓ))
  have hPull_in : ∀ (V : AlgebraicGeometry.Scheme.{u}) (q_V : Quiver.Hom V V_bar),
      WeilIsEtaleSheafPullback (CategoryTheory.CategoryStruct.comp q_V ι_bar) 𝒦₀
        ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A_rank) := by
    let B_ι : CategoryTheory.Functor S.Etale V_bar.Etale := weilEtaleSitePullback ι_bar
    let J_ι : CategoryTheory.Functor V_bar.Etale S.Etale :=
      { obj := fun Y =>
          CategoryTheory.MorphismProperty.Over.mk ⊤ ((Fgt_V.obj Y).hom ≫ ι_bar)
            (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
              (Fgt_V.obj Y).hom ι_bar Y.prop hEt_ι)
        map := fun {Y₁ Y₂} u =>
          CategoryTheory.MorphismProperty.Over.homMk (Fgt_V.map u).left
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ ι_bar) ((Fgt_V.map u).w)))
        map_id := fun _ => CategoryTheory.MorphismProperty.Over.Hom.ext rfl
        map_comp := fun _ _ => CategoryTheory.MorphismProperty.Over.Hom.ext rfl }

    let adj_site : J_ι ⊣ B_ι :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun Y W =>
            { toFun := fun α =>
                CategoryTheory.MorphismProperty.Over.homMk
                  (CategoryTheory.Limits.pullback.lift (Fgt_S.map α).left (Fgt_V.obj Y).hom
                    (Fgt_S.map α).w)
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _)
              invFun := fun β =>
                CategoryTheory.MorphismProperty.Over.homMk
                  ((Fgt_V.map β).left ≫
                    CategoryTheory.Limits.pullback.fst (Fgt_S.obj W).hom ι_bar)
                  (((CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg ((Fgt_V.map β).left ≫ ·)
                      CategoryTheory.Limits.pullback.condition)).trans
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      (congrArg (· ≫ ι_bar) (Fgt_V.map β).w)))
              left_inv := fun α => by
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                exact CategoryTheory.Limits.pullback.lift_fst _ _ _
              right_inv := fun β => by
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                apply CategoryTheory.Limits.pullback.hom_ext
                · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
                · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                    ((Fgt_V.map β).w).symm }
          homEquiv_naturality_left_symm := fun {Y' Y W} u β => by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact CategoryTheory.Category.assoc _ _ _
          homEquiv_naturality_right := fun {Y W W'} α v => by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            apply CategoryTheory.Limits.pullback.hom_ext
            · let lft_α := CategoryTheory.Limits.pullback.lift (Fgt_S.map α).left
                (Fgt_V.obj Y).hom (Fgt_S.map α).w
              let lft_αv := CategoryTheory.Limits.pullback.lift (Fgt_S.map (α ≫ v)).left
                (Fgt_V.obj Y).hom (Fgt_S.map (α ≫ v)).w
              let m_v := (Fgt_V.map (B_ι.map v)).left
              change lft_αv ≫ CategoryTheory.Limits.pullback.fst (Fgt_S.obj W').hom ι_bar =
                (lft_α ≫ m_v) ≫ CategoryTheory.Limits.pullback.fst (Fgt_S.obj W').hom ι_bar
              have hL : lft_αv ≫ CategoryTheory.Limits.pullback.fst (Fgt_S.obj W').hom ι_bar =
                  (Fgt_S.map α).left ≫ (Fgt_S.map v).left :=
                CategoryTheory.Limits.pullback.lift_fst _ _ _
              have hR : (lft_α ≫ m_v) ≫
                  CategoryTheory.Limits.pullback.fst (Fgt_S.obj W').hom ι_bar =
                  (Fgt_S.map α).left ≫ (Fgt_S.map v).left :=
                (CategoryTheory.Category.assoc lft_α m_v _).trans
                  ((congrArg (lft_α ≫ ·) (sitePullMap_fst ι_bar v)).trans
                    ((CategoryTheory.Category.assoc lft_α _ _).symm.trans
                      (congrArg (· ≫ (Fgt_S.map v).left)
                        (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
              exact hL.trans hR.symm
            · let lft_α := CategoryTheory.Limits.pullback.lift (Fgt_S.map α).left
                (Fgt_V.obj Y).hom (Fgt_S.map α).w
              let lft_αv := CategoryTheory.Limits.pullback.lift (Fgt_S.map (α ≫ v)).left
                (Fgt_V.obj Y).hom (Fgt_S.map (α ≫ v)).w
              let m_v := (Fgt_V.map (B_ι.map v)).left
              change lft_αv ≫ CategoryTheory.Limits.pullback.snd (Fgt_S.obj W').hom ι_bar =
                (lft_α ≫ m_v) ≫ CategoryTheory.Limits.pullback.snd (Fgt_S.obj W').hom ι_bar
              have hL : lft_αv ≫ CategoryTheory.Limits.pullback.snd (Fgt_S.obj W').hom ι_bar =
                  (Fgt_V.obj Y).hom :=
                CategoryTheory.Limits.pullback.lift_snd _ _ _
              have hR : (lft_α ≫ m_v) ≫
                  CategoryTheory.Limits.pullback.snd (Fgt_S.obj W').hom ι_bar =
                  (Fgt_V.obj Y).hom :=
                (CategoryTheory.Category.assoc lft_α m_v _).trans
                  ((congrArg (lft_α ≫ ·) (sitePullMap_snd ι_bar v)).trans
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _))
              exact hL.trans hR.symm }

    let adj_psh := adj_site.op.whiskerLeft AddCommGrpCat.{u}
    let C_Vbar :=
      (CategoryTheory.constantSheaf V_bar.smallEtaleTopology AddCommGrpCat.{u}).obj A_rank
    rcases hConstEquiv V_bar A_rank with ⟨hT_Vbar, θ_Vbar, hθ_bij, hθ_nat, _⟩

    have hTriv_bij : ∀ Y : V_bar.Etale, Function.Bijective (triv₀ (J_ι.obj Y)) := by
      intro Y
      refine ⟨(htriv₀_spec (J_ι.obj Y)).1, fun f => ?_⟩
      rw [← Set.mem_range, (htriv₀_spec (J_ι.obj Y)).2]
      refine ⟨⊥, ?_, fun z hz => False.elim hz⟩
      rw [sup_bot_eq, eq_top_iff]
      intro y _
      exact hRange_sub ⟨((Fgt_V.obj Y).hom).base y, rfl⟩

    let δ_sel : ∀ Y : V_bar.Etale, Γ →
        Quiver.Hom (Fgt_V.obj Y).left
          (CategoryTheory.Limits.pullback ((Fgt_V.obj Y).hom ≫ ι_bar) ι_bar) :=
      fun Y => (hSheets (Fgt_V.obj Y).left (Fgt_V.obj Y).hom).choose
    have hδ_sel : ∀ Y : V_bar.Etale,
        (∀ σ : Γ,
          (δ_sel Y σ) ≫ CategoryTheory.Limits.pullback.fst ((Fgt_V.obj Y).hom ≫ ι_bar) ι_bar =
            𝟙 (Fgt_V.obj Y).left ∧
          (δ_sel Y σ) ≫ CategoryTheory.Limits.pullback.snd ((Fgt_V.obj Y).hom ≫ ι_bar) ι_bar =
            (Fgt_V.obj Y).hom ≫ d σ ∧
          AlgebraicGeometry.Etale (δ_sel Y σ) ∧
          IsOpen (Set.range (δ_sel Y σ).base)) ∧
        (∀ σ₁ σ₂ : Γ, σ₁ ≠ σ₂ →
          Disjoint (Set.range (δ_sel Y σ₁).base) (Set.range (δ_sel Y σ₂).base)) ∧
        (⋃ σ : Γ, Set.range (δ_sel Y σ).base) = Set.univ :=
      fun Y => (hSheets (Fgt_V.obj Y).left (Fgt_V.obj Y).hom).choose_spec

    have hClopen_sheet : ∀ (Y : V_bar.Etale) (idx : Fin m_Γ),
        IsClopen (Set.range (δ_sel Y (equiv_Γ idx)).base) := by
      intro Y idx
      refine ⟨?_, ((hδ_sel Y).1 (equiv_Γ idx)).2.2.2⟩
      rw [← isOpen_compl_iff]
      have hcompl : (Set.range (δ_sel Y (equiv_Γ idx)).base)ᶜ =
          ⋃ (j : Fin m_Γ) (_ : j ≠ idx), Set.range (δ_sel Y (equiv_Γ j)).base := by
        ext z
        simp only [Set.mem_compl_iff, Set.mem_iUnion]
        constructor
        · intro hz
          have hz_univ : z ∈ (⋃ σ : Γ, Set.range (δ_sel Y σ).base) := by
            rw [(hδ_sel Y).2.2]
            trivial
          rcases Set.mem_iUnion.mp hz_univ with ⟨σ, hσ⟩
          refine ⟨equiv_Γ.symm σ, ?_, ?_⟩
          · rintro h_eq
            rw [← h_eq, equiv_Γ.apply_symm_apply] at hz
            exact hz hσ
          · rwa [equiv_Γ.apply_symm_apply]
        · rintro ⟨j, hj, hj_mem⟩ hz_mem
          have hne : equiv_Γ j ≠ equiv_Γ idx := fun h => hj (equiv_Γ.injective h)
          exact Set.disjoint_left.mp ((hδ_sel Y).2.1 _ _ hne) hj_mem hz_mem
      rw [hcompl]
      exact isOpen_iUnion fun j => isOpen_iUnion fun _ => ((hδ_sel Y).1 (equiv_Γ j)).2.2.2

    let Φ_loc : ∀ Y : V_bar.Etale,
        LocallyConstant ↥(CategoryTheory.Limits.pullback ((Fgt_V.obj Y).hom ≫ ι_bar) ι_bar)
          (ZMod (ℓ ^ (0 + 1))) →+
        LocallyConstant ↥(Fgt_V.obj Y).left ↥A_rank := fun Y =>
      { toFun := fun f =>
          { toFun := fun y =>
              ULift.up (fun idx => e_zmod (f ((δ_sel Y (equiv_Γ idx)).base y)))
            isLocallyConstant := by
              refine IsLocallyConstant.iff_isOpen_fiber.mpr fun v => ?_
              have hOpen : IsOpen (⋂ idx : Fin m_Γ,
                  ((δ_sel Y (equiv_Γ idx)).base) ⁻¹'
                    (f ⁻¹' {e_zmod.symm (v.down idx)})) :=
                isOpen_iInter_of_finite fun idx =>
                  ((δ_sel Y (equiv_Γ idx)).base.hom.continuous).isOpen_preimage _
                    (f.isLocallyConstant _)
              convert hOpen using 1
              ext y
              simp only [Set.mem_iInter, Set.mem_preimage, Set.mem_singleton_iff]
              constructor
              · intro hy idx
                have h1 : e_zmod (f ((δ_sel Y (equiv_Γ idx)).base y)) = v.down idx :=
                  congrFun (congrArg ULift.down hy) idx
                rw [← h1, e_zmod.symm_apply_apply]
              · intro hy
                apply ULift.ext
                funext idx
                change e_zmod (f ((δ_sel Y (equiv_Γ idx)).base y)) = v.down idx
                rw [hy idx, e_zmod.apply_symm_apply] }
        map_zero' := by
          ext y
          apply ULift.ext
          funext idx
          exact map_zero e_zmod
        map_add' := fun f₁ f₂ => by
          ext y
          apply ULift.ext
          funext idx
          exact map_add e_zmod _ _ }

    have hΦ_bij : ∀ Y : V_bar.Etale, Function.Bijective (Φ_loc Y) := by
      intro Y
      classical
      let fst_Y := CategoryTheory.Limits.pullback.fst ((Fgt_V.obj Y).hom ≫ ι_bar) ι_bar
      let Ψ_Y : LocallyConstant ↥(Fgt_V.obj Y).left ↥A_rank →
          LocallyConstant ↥(CategoryTheory.Limits.pullback ((Fgt_V.obj Y).hom ≫ ι_bar) ι_bar)
            (ZMod (ℓ ^ (0 + 1))) := fun F =>
        ∑ idx : Fin m_Γ,
          LocallyConstant.charFn (ZMod (ℓ ^ (0 + 1))) (hClopen_sheet Y idx) *
            (F.comap fst_Y.base.hom).map (fun v => e_zmod.symm (v.down idx))
      have hΨ_eval : ∀ (F : LocallyConstant ↥(Fgt_V.obj Y).left ↥A_rank)
          (idx : Fin m_Γ) (y : ↥(Fgt_V.obj Y).left),
          Ψ_Y F ((δ_sel Y (equiv_Γ idx)).base y) = e_zmod.symm ((F y).down idx) := by
        intro F idx y
        set z := (δ_sel Y (equiv_Γ idx)).base y
        have hz_fst : fst_Y.base z = y := by
          change (δ_sel Y (equiv_Γ idx) ≫ fst_Y).base y = y
          rw [((hδ_sel Y).1 (equiv_Γ idx)).1]
          rfl
        change LocallyConstant.evalAddMonoidHom z (Ψ_Y F) = e_zmod.symm ((F y).down idx)
        dsimp [Ψ_Y]
        rw [map_sum, Finset.sum_eq_single idx]
        · change (LocallyConstant.charFn (ZMod (ℓ ^ (0 + 1))) (hClopen_sheet Y idx) z) *
              e_zmod.symm ((F (fst_Y.base z)).down idx) = _
          have hz_mem : z ∈ Set.range (δ_sel Y (equiv_Γ idx)).base := ⟨y, rfl⟩
          rw [LocallyConstant.coe_charFn]
          simp only [Set.indicator_apply, hz_mem, ↓reduceIte, Pi.one_apply, one_mul, hz_fst]
        · intro j _ hj
          change (LocallyConstant.charFn (ZMod (ℓ ^ (0 + 1))) (hClopen_sheet Y j) z) *
              e_zmod.symm ((F (fst_Y.base z)).down j) = 0
          have hne : equiv_Γ j ≠ equiv_Γ idx := fun h => hj (equiv_Γ.injective h)
          have hnot : z ∉ Set.range (δ_sel Y (equiv_Γ j)).base :=
            fun hz_j => Set.disjoint_left.mp ((hδ_sel Y).2.1 _ _ hne) hz_j ⟨y, rfl⟩
          rw [LocallyConstant.coe_charFn]
          simp only [Set.indicator_apply, hnot, ↓reduceIte, zero_mul]
        · intro h_abs
          exact False.elim (h_abs (Finset.mem_univ idx))
      refine Function.bijective_iff_has_inverse.mpr ⟨Ψ_Y, ?_, ?_⟩
      · intro f
        ext z
        have hz_univ : z ∈ (⋃ σ : Γ, Set.range (δ_sel Y σ).base) := by
          rw [(hδ_sel Y).2.2]
          trivial
        rcases Set.mem_iUnion.mp hz_univ with ⟨σ, y, rfl⟩
        let idx := equiv_Γ.symm σ
        have hσ_eq : equiv_Γ idx = σ := equiv_Γ.apply_symm_apply σ
        rw [← hσ_eq, hΨ_eval (Φ_loc Y f) idx y]
        change e_zmod.symm (e_zmod (f ((δ_sel Y (equiv_Γ idx)).base y))) = _
        exact e_zmod.symm_apply_apply _
      · intro F
        ext y
        apply ULift.ext
        funext idx
        change e_zmod (Ψ_Y F ((δ_sel Y (equiv_Γ idx)).base y)) = (F y).down idx
        rw [hΨ_eval F idx y, e_zmod.apply_symm_apply]

    let e_comp_Y : ∀ Y : V_bar.Etale,
        (J_ι.op ⋙ 𝒦₀.obj).obj (Opposite.op Y) ≅ C_Vbar.obj.obj (Opposite.op Y) := fun Y =>
      let eqv := ((AddEquiv.ofBijective (triv₀ (J_ι.obj Y)) (hTriv_bij Y)).trans
        (AddEquiv.ofBijective (Φ_loc Y) (hΦ_bij Y))).trans
        (AddEquiv.ofBijective (θ_Vbar Y) (hθ_bij Y))
      { hom := AddCommGrpCat.ofHom eqv.toAddMonoidHom
        inv := AddCommGrpCat.ofHom eqv.symm.toAddMonoidHom
        hom_inv_id := AddCommGrpCat.ext fun x => eqv.symm_apply_apply x
        inv_hom_id := AddCommGrpCat.ext fun x => eqv.apply_symm_apply x }

    let e_psh : J_ι.op ⋙ 𝒦₀.obj ≅ C_Vbar.obj :=
      CategoryTheory.NatIso.ofComponents (fun Y => e_comp_Y Y.unop) (by
        intro Y₂ Y₁ u_op
        let u : Y₁.unop ⟶ Y₂.unop := u_op.unop
        apply AddCommGrpCat.ext
        intro sec
        have h_rhs := hθ_nat u (Φ_loc Y₂.unop (triv₀ (J_ι.obj Y₂.unop) sec))
        refine Eq.trans ?_ h_rhs.symm
        apply congrArg (θ_Vbar Y₁.unop)
        ext y₁
        apply ULift.ext
        funext idx
        let g₁ := (Fgt_V.obj Y₁.unop).hom
        let g₂ := (Fgt_V.obj Y₂.unop).hom
        let fst₁ := CategoryTheory.Limits.pullback.fst (g₁ ≫ ι_bar) ι_bar
        let snd₁ := CategoryTheory.Limits.pullback.snd (g₁ ≫ ι_bar) ι_bar
        let fst₂ := CategoryTheory.Limits.pullback.fst (g₂ ≫ ι_bar) ι_bar
        let snd₂ := CategoryTheory.Limits.pullback.snd (g₂ ≫ ι_bar) ι_bar
        let u_V : CategoryTheory.Limits.pullback (g₁ ≫ ι_bar) ι_bar ⟶
            CategoryTheory.Limits.pullback (g₂ ≫ ι_bar) ι_bar :=
          CategoryTheory.Limits.pullback.lift (fst₁ ≫ (Fgt_V.map u).left) snd₁ (by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (Fgt_V.map u).left,
              (Fgt_V.map u).w]
            exact CategoryTheory.Limits.pullback.condition)
        have hδ_nat : δ_sel Y₁.unop (equiv_Γ idx) ≫ u_V =
            (Fgt_V.map u).left ≫ δ_sel Y₂.unop (equiv_Γ idx) := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, ((hδ_sel Y₁.unop).1 (equiv_Γ idx)).1,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
              ((hδ_sel Y₂.unop).1 (equiv_Γ idx)).1, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ((hδ_sel Y₁.unop).1 (equiv_Γ idx)).2.1, CategoryTheory.Category.assoc,
              ((hδ_sel Y₂.unop).1 (equiv_Γ idx)).2.1, ← CategoryTheory.Category.assoc,
              (Fgt_V.map u).w]
        change e_zmod (triv₀ (J_ι.obj Y₁.unop) ((𝒦₀.obj.map (Opposite.op (J_ι.map u))) sec)
            ((δ_sel Y₁.unop (equiv_Γ idx)).base y₁)) =
          e_zmod (triv₀ (J_ι.obj Y₂.unop) sec
            ((δ_sel Y₂.unop (equiv_Γ idx)).base ((Fgt_V.map u).left.base y₁)))
        have hpt : u_V.base ((δ_sel Y₁.unop (equiv_Γ idx)).base y₁) =
            (δ_sel Y₂.unop (equiv_Γ idx)).base ((Fgt_V.map u).left.base y₁) :=
          congrArg (fun k => k.base y₁) hδ_nat
        exact (congrArg e_zmod
          (htriv₀_nat (J_ι.map u) u_V (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) sec
            ((δ_sel Y₁.unop (equiv_Γ idx)).base y₁))).trans
          (congrArg (fun p => e_zmod (triv₀ (J_ι.obj Y₂.unop) sec p)) hpt))

    rcases hPullAdj V_bar S ι_bar with ⟨hCont_ι, hAdj_ι⟩
    let R_ι := B_ι.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology V_bar.smallEtaleTopology
    let L_ι := B_ι.sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology V_bar.smallEtaleTopology
    let adj_ι := B_ι.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology V_bar.smallEtaleTopology

    have iso_ι : L_ι.obj 𝒦₀ ≅ C_Vbar := by
      refine isoOfSheafHomEquiv (L_ι.obj 𝒦₀) C_Vbar (fun 𝒢 =>
        { toFun := fun f =>
            { hom := e_psh.inv ≫
                (adj_psh.homEquiv 𝒦₀.obj 𝒢.obj).symm ((adj_ι.homEquiv 𝒦₀ 𝒢 f).hom) }
          invFun := fun g =>
            (adj_ι.homEquiv 𝒦₀ 𝒢).symm
              { hom := adj_psh.homEquiv 𝒦₀.obj 𝒢.obj (e_psh.hom ≫ g.hom) }
          left_inv := fun f => by
            let φ : 𝒦₀.obj ⟶ B_ι.op ⋙ 𝒢.obj := ((adj_ι.homEquiv 𝒦₀ 𝒢) f).hom
            have h1 : adj_psh.homEquiv 𝒦₀.obj 𝒢.obj
                (e_psh.hom ≫ (e_psh.inv ≫ (adj_psh.homEquiv 𝒦₀.obj 𝒢.obj).symm φ)) = φ :=
              (congrArg (adj_psh.homEquiv 𝒦₀.obj 𝒢.obj)
                (Iso.hom_inv_id_assoc e_psh ((adj_psh.homEquiv 𝒦₀.obj 𝒢.obj).symm φ))).trans
                ((adj_psh.homEquiv 𝒦₀.obj 𝒢.obj).apply_symm_apply φ)
            exact (congrArg (fun ψ => (adj_ι.homEquiv 𝒦₀ 𝒢).symm { hom := ψ }) h1).trans
              ((adj_ι.homEquiv 𝒦₀ 𝒢).symm_apply_apply f)
          right_inv := fun g => by
            apply CategoryTheory.Sheaf.hom_ext
            dsimp
            rw [(adj_ι.homEquiv 𝒦₀ 𝒢).apply_symm_apply,
              (adj_psh.homEquiv 𝒦₀.obj 𝒢.obj).symm_apply_apply, Iso.inv_hom_id_assoc] }) ?_
      intro 𝒢₁ 𝒢₂ f g
      apply CategoryTheory.Sheaf.hom_ext
      let φ₁ : 𝒦₀.obj ⟶ B_ι.op ⋙ 𝒢₁.obj := ((adj_ι.homEquiv 𝒦₀ 𝒢₁) f).hom
      have h1 : ((adj_ι.homEquiv 𝒦₀ 𝒢₂) (f ≫ g)).hom =
          φ₁ ≫ CategoryTheory.Functor.whiskerLeft B_ι.op g.hom :=
        congrArg (fun k => k.hom) (adj_ι.homEquiv_naturality_right f g)
      have h2 : (adj_psh.homEquiv 𝒦₀.obj 𝒢₂.obj).symm
          (((adj_ι.homEquiv 𝒦₀ 𝒢₂) (f ≫ g)).hom) =
          (adj_psh.homEquiv 𝒦₀.obj 𝒢₁.obj).symm φ₁ ≫ g.hom :=
        (congrArg (adj_psh.homEquiv 𝒦₀.obj 𝒢₂.obj).symm h1).trans
          (adj_psh.homEquiv_naturality_right_symm φ₁ g.hom)
      exact (congrArg (e_psh.inv ≫ ·) h2).trans (CategoryTheory.Category.assoc _ _ _).symm

    intro V q_V
    rcases hPullAdj V S (q_V ≫ ι_bar) with ⟨hCont_comp, hAdj_comp⟩
    rcases hPullAdj V V_bar q_V with ⟨hCont_q, hAdj_q⟩
    rcases hConstEquiv V A_rank with ⟨hT_V, _, _, _, _⟩
    refine ⟨hCont_comp, hAdj_comp, ⟨?_⟩⟩
    let B_comp := weilEtaleSitePullback (q_V ≫ ι_bar)
    let B_q := weilEtaleSitePullback q_V
    let R_comp := B_comp.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology V.smallEtaleTopology
    let L_comp := B_comp.sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology V.smallEtaleTopology
    let adj_comp := B_comp.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology V.smallEtaleTopology
    let R_q := B_q.sheafPushforwardContinuous AddCommGrpCat.{u}
      V_bar.smallEtaleTopology V.smallEtaleTopology
    let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A_rank
    let T_Vbar : V_bar.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V_bar)
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
    let adj_c_Vbar := CategoryTheory.constantSheafAdj V_bar.smallEtaleTopology
      AddCommGrpCat.{u} hT_Vbar
    let adj_c_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology
      AddCommGrpCat.{u} hT_V
    let e_B : B_comp ≅ B_ι ⋙ B_q := CategoryTheory.MorphismProperty.Over.pullbackComp q_V ι_bar

    let iso_TV := terminalPullbackIso q_V hT_V
    let from_TV : T_V ⟶ B_q.obj T_Vbar := iso_TV.hom
    let to_TV : B_q.obj T_Vbar ⟶ T_V := iso_TV.inv
    have h_from_to_TV : from_TV ≫ to_TV = 𝟙 T_V := iso_TV.hom_inv_id
    have h_to_from_TV : to_TV ≫ from_TV = 𝟙 (B_q.obj T_Vbar) := iso_TV.inv_hom_id

    let pfEquiv : ∀ ℋ : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u},
        (𝒦₀ ⟶ R_comp.obj ℋ) ≃ (𝒦₀ ⟶ R_ι.obj (R_q.obj ℋ)) := fun ℋ =>
      let u₁ := CategoryTheory.Functor.whiskerRight (CategoryTheory.NatIso.op e_B).inv ℋ.obj
      let u₂ := CategoryTheory.Functor.whiskerRight (CategoryTheory.NatIso.op e_B).hom ℋ.obj
      { toFun := fun φ => { hom := φ.hom ≫ u₁ }
        invFun := fun ψ => { hom := ψ.hom ≫ u₂ }
        left_inv := fun φ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext W
          have h_app : u₁.app W ≫ u₂.app W = 𝟙 (ℋ.obj.obj (B_comp.op.obj W)) :=
            (ℋ.obj.map_comp _ _).symm.trans
              ((congrArg ℋ.obj.map ((CategoryTheory.NatIso.op e_B).inv_hom_id_app W)).trans
                (ℋ.obj.map_id _))
          exact (CategoryTheory.Category.assoc (φ.hom.app W) (u₁.app W) (u₂.app W)).trans
            ((congrArg (φ.hom.app W ≫ ·) h_app).trans (CategoryTheory.Category.comp_id _))
        right_inv := fun ψ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext W
          have h_app : u₂.app W ≫ u₁.app W = 𝟙 (ℋ.obj.obj ((B_ι ⋙ B_q).op.obj W)) :=
            (ℋ.obj.map_comp _ _).symm.trans
              ((congrArg ℋ.obj.map ((CategoryTheory.NatIso.op e_B).hom_inv_id_app W)).trans
                (ℋ.obj.map_id _))
          exact (CategoryTheory.Category.assoc (ψ.hom.app W) (u₂.app W) (u₁.app W)).trans
            ((congrArg (ψ.hom.app W ≫ ·) h_app).trans (CategoryTheory.Category.comp_id _)) }

    refine isoOfSheafHomEquiv (L_comp.obj 𝒦₀) C_V (fun ℋ =>
      ((adj_comp.homEquiv 𝒦₀ ℋ).trans (pfEquiv ℋ)).trans
        (((adj_ι.homEquiv 𝒦₀ (R_q.obj ℋ)).symm.trans
          { toFun := fun u => iso_ι.inv ≫ u
            invFun := fun v => iso_ι.hom ≫ v
            left_inv := fun u => Iso.hom_inv_id_assoc iso_ι u
            right_inv := fun v => Iso.inv_hom_id_assoc iso_ι v }).trans
          (((adj_c_Vbar.homEquiv A_rank (R_q.obj ℋ)).trans
            { toFun := fun α => α ≫ ℋ.obj.map (Opposite.op from_TV)
              invFun := fun β => β ≫ ℋ.obj.map (Opposite.op to_TV)
              left_inv := fun α => by
                dsimp
                have h_map : ℋ.obj.map (Opposite.op from_TV) ≫ ℋ.obj.map (Opposite.op to_TV) =
                    𝟙 (ℋ.obj.obj (Opposite.op (B_q.obj T_Vbar))) :=
                  (ℋ.obj.map_comp _ _).symm.trans
                    ((congrArg ℋ.obj.map (congrArg Opposite.op h_to_from_TV)).trans
                      (ℋ.obj.map_id _))
                exact (CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (α ≫ ·) h_map).trans (CategoryTheory.Category.comp_id _))
              right_inv := fun β => by
                dsimp
                have h_map : ℋ.obj.map (Opposite.op to_TV) ≫ ℋ.obj.map (Opposite.op from_TV) =
                    𝟙 (ℋ.obj.obj (Opposite.op T_V)) :=
                  (ℋ.obj.map_comp _ _).symm.trans
                    ((congrArg ℋ.obj.map (congrArg Opposite.op h_from_to_TV)).trans
                      (ℋ.obj.map_id _))
                exact (CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (β ≫ ·) h_map).trans (CategoryTheory.Category.comp_id _)) }).trans
            (adj_c_V.homEquiv A_rank ℋ).symm))) ?_
    intro ℋ₁ ℋ₂ f g
    let step₁ : ∀ {ℋ} (h : L_comp.obj 𝒦₀ ⟶ ℋ), C_Vbar ⟶ R_q.obj ℋ :=
      fun {ℋ} h => iso_ι.inv ≫
        (adj_ι.homEquiv 𝒦₀ (R_q.obj ℋ)).symm (pfEquiv ℋ (adj_comp.homEquiv 𝒦₀ ℋ h))
    let step₂ : ∀ {ℋ} (h : L_comp.obj 𝒦₀ ⟶ ℋ), A_rank ⟶ ℋ.obj.obj (Opposite.op T_V) :=
      fun {ℋ} h => adj_c_Vbar.homEquiv A_rank (R_q.obj ℋ) (step₁ h) ≫
        ℋ.obj.map (Opposite.op from_TV)
    have h_pf : pfEquiv ℋ₂ (adj_comp.homEquiv 𝒦₀ ℋ₂ (f ≫ g)) =
        pfEquiv ℋ₁ (adj_comp.homEquiv 𝒦₀ ℋ₁ f) ≫ R_ι.map (R_q.map g) := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      have h_nat_comp :=
        congrArg (fun φ => φ.hom.app W) (adj_comp.homEquiv_naturality_right f g)
      exact (congrArg (· ≫ ℋ₂.obj.map ((CategoryTheory.NatIso.op e_B).inv.app W))
        h_nat_comp).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg ((adj_comp.homEquiv 𝒦₀ ℋ₁ f).hom.app W ≫ ·)
            (g.hom.naturality ((CategoryTheory.NatIso.op e_B).inv.app W)).symm).trans
            (CategoryTheory.Category.assoc _ _ _).symm))
    have h_step₁ : step₁ (f ≫ g) = step₁ f ≫ R_q.map g := by
      have h_symm : (adj_ι.homEquiv 𝒦₀ (R_q.obj ℋ₂)).symm
          (pfEquiv ℋ₂ (adj_comp.homEquiv 𝒦₀ ℋ₂ (f ≫ g))) =
          (adj_ι.homEquiv 𝒦₀ (R_q.obj ℋ₁)).symm
            (pfEquiv ℋ₁ (adj_comp.homEquiv 𝒦₀ ℋ₁ f)) ≫ R_q.map g :=
        (congrArg (adj_ι.homEquiv 𝒦₀ (R_q.obj ℋ₂)).symm h_pf).trans
          (adj_ι.homEquiv_naturality_right_symm _ (R_q.map g))
      exact (congrArg (iso_ι.inv ≫ ·) h_symm).trans (CategoryTheory.Category.assoc _ _ _).symm
    have h_c_Vbar : adj_c_Vbar.homEquiv A_rank (R_q.obj ℋ₂) (step₁ (f ≫ g)) =
        adj_c_Vbar.homEquiv A_rank (R_q.obj ℋ₁) (step₁ f) ≫
          g.hom.app (Opposite.op (B_q.obj T_Vbar)) :=
      (congrArg (adj_c_Vbar.homEquiv A_rank (R_q.obj ℋ₂)) h_step₁).trans
        (adj_c_Vbar.homEquiv_naturality_right (step₁ f) (R_q.map g))
    have h_step₂ : step₂ (f ≫ g) = step₂ f ≫ g.hom.app (Opposite.op T_V) :=
      (congrArg (· ≫ ℋ₂.obj.map (Opposite.op from_TV)) h_c_Vbar).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (adj_c_Vbar.homEquiv A_rank (R_q.obj ℋ₁) (step₁ f) ≫ ·)
            (g.hom.naturality (Opposite.op from_TV)).symm).trans
            (CategoryTheory.Category.assoc _ _ _).symm))
    apply (adj_c_V.homEquiv A_rank ℋ₂).injective
    refine ((adj_c_V.homEquiv A_rank ℋ₂).apply_symm_apply (step₂ (f ≫ g))).trans ?_
    refine h_step₂.trans ?_
    exact ((adj_c_V.homEquiv_naturality_right _ g).trans
      (congrArg (· ≫ g.hom.app (Opposite.op T_V))
        ((adj_c_V.homEquiv A_rank ℋ₁).apply_symm_apply (step₂ f)))).symm

  
  let A_zero : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of PUnit)
  have hPull_out : ∀ (V : AlgebraicGeometry.Scheme.{u}) (h_out : Quiver.Hom V S),
      Disjoint (Set.range h_out.base) (U_bar : Set S) →
      WeilIsEtaleSheafPullback h_out 𝒦₀
        ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A_zero) := by
    intro V h_out hDisj
    rcases hPullAdj V S h_out with ⟨hCont_out, hAdj_out⟩
    rcases hConstEquiv V A_zero with ⟨hT_V, _, _, _, _⟩
    refine ⟨hCont_out, hAdj_out, ⟨?_⟩⟩
    let B_out := weilEtaleSitePullback h_out
    let R_out := B_out.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology V.smallEtaleTopology
    let L_out := B_out.sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology V.smallEtaleTopology
    let adj_out := B_out.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology V.smallEtaleTopology
    let C_zero := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A_zero
    let adj_c_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT_V

    have hZero_C : CategoryTheory.Limits.IsZero C_zero := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply (adj_c_V.homEquiv A_zero C_zero).injective
      apply AddCommGrpCat.ext
      rintro ⟨⟨⟩⟩
      exact (map_zero _).trans (map_zero _).symm

    have hZero_L : CategoryTheory.Limits.IsZero (L_out.obj 𝒦₀) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      let 𝒢 := L_out.obj 𝒦₀
      apply (adj_out.homEquiv 𝒦₀ 𝒢).injective
      have h0_rhs : adj_out.homEquiv 𝒦₀ 𝒢 0 = 0 := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_zero,
          CategoryTheory.Limits.comp_zero]
      rw [h0_rhs]
      let φ := adj_out.homEquiv 𝒦₀ 𝒢 (𝟙 𝒢)
      change φ = 0
      apply CategoryTheory.Sheaf.hom_ext
      ext W_op sec
      let W : S.Etale := W_op.unop
      change (φ.hom.app (Opposite.op W)) sec = 0
      let h_W := (Fgt_S.obj W).hom
      have hmem : triv₀ W sec ∈ Set.range (triv₀ W) := ⟨sec, rfl⟩
      rw [(htriv₀_spec W).2] at hmem
      rcases hmem with ⟨W₀, hW₀_cov, hW₀_zero⟩
      let W₀_et : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (W₀.ι ≫ h_W)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) W₀.ι h_W
            inferInstance W.prop)
      let j₀ : W₀_et ⟶ W := CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl
      have hsec_j₀ : (𝒦₀.obj.map (Opposite.op j₀)) sec = 0 := by
        apply (htriv₀_spec W₀_et).1
        refine Eq.trans ?_ (map_zero (triv₀ W₀_et)).symm
        ext y₁
        let u_V : CategoryTheory.Limits.pullback (W₀.ι ≫ h_W) ι_bar ⟶
            CategoryTheory.Limits.pullback h_W ι_bar :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (W₀.ι ≫ h_W) ι_bar ≫ W₀.ι)
            (CategoryTheory.Limits.pullback.snd (W₀.ι ≫ h_W) ι_bar)
            (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
        refine (htriv₀_nat j₀ u_V (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) sec y₁).trans ?_
        apply hW₀_zero
        have h_fst_eq : u_V ≫ CategoryTheory.Limits.pullback.fst h_W ι_bar =
            CategoryTheory.Limits.pullback.fst (W₀.ι ≫ h_W) ι_bar ≫ W₀.ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h_pt_eq : (CategoryTheory.Limits.pullback.fst h_W ι_bar).base (u_V.base y₁) =
            W₀.ι.base ((CategoryTheory.Limits.pullback.fst (W₀.ι ≫ h_W) ι_bar).base y₁) :=
          congrArg (fun k => k.base y₁) h_fst_eq
        have h_in : (CategoryTheory.Limits.pullback.fst h_W ι_bar).base (u_V.base y₁) ∈
            Set.range W₀.ι.base := ⟨_, h_pt_eq.symm⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι W₀] at h_in
      have h𝒢_j₀ : (𝒢.obj.map (Opposite.op (B_out.map j₀))) ((φ.hom.app (Opposite.op W)) sec) = 0 := by
        have hnat : ((𝒦₀.obj.map (Opposite.op j₀)) ≫ φ.hom.app (Opposite.op W₀_et)) sec =
            (φ.hom.app (Opposite.op W) ≫ 𝒢.obj.map (Opposite.op (B_out.map j₀))) sec :=
          congrArg (fun k => k sec) (φ.hom.naturality (Opposite.op j₀))
        exact hnat.symm.trans
          ((congrArg (φ.hom.app (Opposite.op W₀_et)) hsec_j₀).trans (map_zero _))
      let Fgt_Vout := AlgebraicGeometry.Scheme.Etale.forget V
      let m_j : (Fgt_Vout.obj (B_out.obj W₀_et)).left ⟶ (Fgt_Vout.obj (B_out.obj W)).left :=
        (Fgt_Vout.map (B_out.map j₀)).left
      let fst₁ := CategoryTheory.Limits.pullback.fst (W₀.ι ≫ h_W) h_out
      let fst_W := CategoryTheory.Limits.pullback.fst h_W h_out
      have h_sq_j : m_j ≫ fst_W = fst₁ ≫ W₀.ι := sitePullMap_fst h_out j₀
      have h_snd_j : m_j ≫ CategoryTheory.Limits.pullback.snd h_W h_out =
          CategoryTheory.Limits.pullback.snd (W₀.ι ≫ h_W) h_out := sitePullMap_snd h_out j₀
      have h_pb_j : CategoryTheory.IsPullback m_j fst₁ fst_W W₀.ι := by
        refine CategoryTheory.IsPullback.of_right ?_ h_sq_j
          (CategoryTheory.IsPullback.of_hasPullback h_W h_out).flip
        exact h_snd_j.symm ▸ (CategoryTheory.IsPullback.of_hasPullback (W₀.ι ≫ h_W) h_out).flip
      have hEt_mj : AlgebraicGeometry.Etale m_j :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          h_pb_j.flip inferInstance
      let R_j : CategoryTheory.Sieve (B_out.obj W) :=
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton (B_out.map j₀))
      have hRj_cov : R_j ∈ V.smallEtaleTopology (B_out.obj W) := by
        rw [hMemTop V (B_out.obj W) R_j]
        intro z
        let w := fst_W.base z
        let v := (CategoryTheory.Limits.pullback.snd h_W h_out).base z
        have hw_eq : h_W.base w = h_out.base v := by
          change (fst_W ≫ h_W).base z = (CategoryTheory.Limits.pullback.snd h_W h_out ≫ h_out).base z
          rw [CategoryTheory.Limits.pullback.condition]
        have hw_not_U : w ∉ ((TopologicalSpace.Opens.map h_W.base).obj U_bar) := by
          intro hw_U
          exact Set.disjoint_left.mp hDisj ⟨v, hw_eq.symm⟩ hw_U
        have hw_top : w ∈ (((TopologicalSpace.Opens.map h_W.base).obj U_bar) ⊔ W₀ :
            (Fgt_S.obj W).left.Opens) := by
          rw [hW₀_cov]
          trivial
        have hw_W₀ : w ∈ (W₀ : Set (Fgt_S.obj W).left) := by
          rcases hw_top with hw_U | hw_0
          · exact False.elim (hw_not_U hw_U)
          · exact hw_0
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι W₀] at hw_W₀
        rcases hw_W₀ with ⟨w₀, hw₀⟩
        rcases AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z w₀ hw₀.symm with
          ⟨p_pt, hp_fst, _⟩
        refine ⟨B_out.obj W₀_et, B_out.map j₀, h_pb_j.isoPullback.inv.base p_pt,
          ⟨B_out.obj W₀_et, 𝟙 _, B_out.map j₀, CategoryTheory.Presieve.singleton.mk,
            CategoryTheory.Category.id_comp _⟩,
          hEt_mj, ?_⟩
        change (h_pb_j.isoPullback.inv ≫ m_j).base p_pt = z
        have h_inv_mj : h_pb_j.isoPullback.inv ≫ m_j =
            CategoryTheory.Limits.pullback.fst fst_W W₀.ι :=
          (Iso.inv_comp_eq h_pb_j.isoPullback).mpr h_pb_j.isoPullback_hom_fst.symm
        exact (congrArg (fun k => k.base p_pt) h_inv_mj).trans hp_fst
      have hsep := CategoryTheory.Sheaf.isSeparated 𝒢 (B_out.obj W) R_j hRj_cov
      apply hsep
      intro Y g hg
      rcases hg with ⟨Z, h, f_arr, ⟨⟩, rfl⟩
      let s₁ := (φ.hom.app (Opposite.op W)) sec
      have hL : (𝒢.obj.map (Opposite.op (h ≫ B_out.map j₀))) s₁ = 0 :=
        (congrArg (fun k => k s₁)
          (𝒢.obj.map_comp (Opposite.op (B_out.map j₀)) (Opposite.op h))).trans
          ((congrArg (𝒢.obj.map (Opposite.op h)) h𝒢_j₀).trans
            (map_zero (𝒢.obj.map (Opposite.op h)).hom))
      exact hL.trans (map_zero (𝒢.obj.map (Opposite.op (h ≫ B_out.map j₀))).hom).symm

    exact hZero_L.iso hZero_C

  
  have hSpecExtract : ∀ (ℱ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
      (q : ℕ),
      WeilIsConstructibleModPrimeSheaf ℓ (AlgebraicGeometry.Spec (CommRingCat.of k))
        (weilEtaleHigherDirectImage X.hom q ℱ) →
      Finite (ℱ.H q) := by
    intro ℱ q hConst
    let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
    let J₀ := S₀.smallEtaleTopology
    let Fgt₀ := AlgebraicGeometry.Scheme.Etale.forget S₀
    let T₀ : S₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S₀)
    rcases hConstEquiv S₀ (AddCommGrpCat.of (ULift.{u} ℤ)) with ⟨hT₀, _, _, _, _⟩

    have hSplitEt : ∀ {V : AlgebraicGeometry.Scheme.{u}} (p_et : V ⟶ S₀)
        [AlgebraicGeometry.Etale p_et] [AlgebraicGeometry.Surjective p_et],
        ∃ σ : S₀ ⟶ V, σ ≫ p_et = 𝟙 S₀ := by
      intro V p_et _ _
      have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton p_et) ∈
          AlgebraicGeometry.Scheme.etaleTopology S₀ := by
        apply CategoryTheory.Precoverage.generate_mem_toGrothendieck
        refine (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff
          (P := @AlgebraicGeometry.Etale) p_et).mpr ?_
        constructor <;>
          first
          | exact inferInstance
          | exact (AlgebraicGeometry.surjective_iff p_et).mp inferInstance
      rcases (AlgebraicGeometry.Scheme.geometricFiber k).jointly_surjective
        (CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton p_et)) hcov (𝟙 S₀) with
        ⟨Y, f, ⟨Z, g, h, ⟨⟩, rfl⟩, y, hy⟩
      exact ⟨y ≫ g, hy⟩

    have hTopJ₀ : ∀ R : CategoryTheory.Sieve T₀, R ∈ J₀ T₀ → R = ⊤ := by
      intro R hR
      rcases (hMemTop S₀ T₀ R).mp hR (Classical.arbitrary ↥S₀) with ⟨W, u, y, hu_R, hEt_u, _⟩
      let p_u : (Fgt₀.obj W).left ⟶ S₀ := (Fgt₀.map u).left
      have _ : AlgebraicGeometry.Etale p_u := hEt_u
      have _ : AlgebraicGeometry.Surjective p_u :=
        (AlgebraicGeometry.surjective_iff p_u).mpr fun x => ⟨y, Subsingleton.elim _ _⟩
      rcases hSplitEt p_u with ⟨σ, hσ⟩
      have hp_hom : (Fgt₀.obj W).hom = p_u :=
        ((Fgt₀.map u).w).symm.trans (CategoryTheory.Category.comp_id p_u)
      let s_et : T₀ ⟶ W :=
        CategoryTheory.MorphismProperty.Over.homMk σ ((congrArg (σ ≫ ·) hp_hom).trans hσ)
      have h_id : s_et ≫ u = 𝟙 T₀ := hT₀.hom_ext _ _
      have h_id_mem : R.arrows (𝟙 T₀) := h_id ▸ R.downward_closed hu_R s_et
      ext Y g
      simp only [CategoryTheory.Sieve.top_apply, iff_true]
      have hg := R.downward_closed h_id_mem g
      rwa [CategoryTheory.Category.comp_id] at hg

    let R_pre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
      fun M =>
        { obj := fun W => AddCommGrpCat.of ((T₀ ⟶ W.unop) → ↥M)
          map := fun {W₁ W₂} f =>
            AddCommGrpCat.ofHom
              { toFun := fun g τ => g (τ ≫ f.unop)
                map_zero' := rfl
                map_add' := fun _ _ => rfl }
          map_id := fun _ => AddCommGrpCat.ext fun g => funext fun τ =>
            congrArg g (CategoryTheory.Category.comp_id τ)
          map_comp := fun _ _ => AddCommGrpCat.ext fun g => funext fun τ =>
            congrArg g (CategoryTheory.Category.assoc τ _ _).symm }

    have hSheaf_Rpre : ∀ M : AddCommGrpCat.{u},
        CategoryTheory.Presheaf.IsSheaf J₀ (R_pre M) := by
      intro M E W S_cov hS_cov
      have hτ_mem : ∀ τ : T₀ ⟶ W, S_cov.arrows τ := by
        intro τ
        have hp : S_cov.pullback τ = ⊤ := hTopJ₀ _ (J₀.pullback_stable τ hS_cov)
        have hid : (S_cov.pullback τ).arrows (𝟙 T₀) := by rw [hp]; trivial
        simpa [CategoryTheory.Sieve.pullback_apply] using hid
      refine fun x hx => ?_
      let x_hom : (τ : T₀ ⟶ W) → (E ⟶ (R_pre M).obj (Opposite.op T₀)) :=
        fun τ => x τ (hτ_mem τ)
      refine ⟨AddCommGrpCat.ofHom
        { toFun := fun e τ => (x_hom τ) e (𝟙 T₀)
          map_zero' := by
            funext τ
            rw [map_zero]
            rfl
          map_add' := fun e₁ e₂ => by
            funext τ
            rw [map_add]
            rfl }, ?_, ?_⟩
      · intro Y f hf
        let x_f : E ⟶ (R_pre M).obj (Opposite.op Y) := x f hf
        apply AddCommGrpCat.ext
        intro e
        funext σ
        have hcomp : x_f ≫ (R_pre M).map (Opposite.op σ) =
            x_hom (σ ≫ f) ≫ (R_pre M).map (Opposite.op (𝟙 T₀)) :=
          hx σ (𝟙 T₀) hf (hτ_mem (σ ≫ f)) (CategoryTheory.Category.id_comp (σ ≫ f)).symm
        have hcomp_e := congrArg (fun k : E ⟶ (R_pre M).obj (Opposite.op T₀) => k e (𝟙 T₀)) hcomp
        change (x_hom (σ ≫ f)) e (𝟙 T₀) = x_f e σ
        have hL : (x_f ≫ (R_pre M).map (Opposite.op σ)) e (𝟙 T₀) = x_f e σ :=
          congrArg (x_f e) (CategoryTheory.Category.id_comp σ)
        have hR : (x_hom (σ ≫ f) ≫ (R_pre M).map (Opposite.op (𝟙 T₀))) e (𝟙 T₀) =
            (x_hom (σ ≫ f)) e (𝟙 T₀) :=
          congrArg ((x_hom (σ ≫ f)) e) (CategoryTheory.Category.id_comp (𝟙 T₀))
        exact (hR.symm.trans hcomp_e.symm).trans hL
      · intro g hg
        let g_hom : E ⟶ (R_pre M).obj (Opposite.op W) := g
        apply AddCommGrpCat.ext
        intro e
        funext τ
        have hg_τ : g_hom ≫ (R_pre M).map (Opposite.op τ) = x_hom τ := hg τ (hτ_mem τ)
        have hg_e := congrArg (fun k : E ⟶ (R_pre M).obj (Opposite.op T₀) => k e (𝟙 T₀)) hg_τ
        have hL : (g_hom ≫ (R_pre M).map (Opposite.op τ)) e (𝟙 T₀) = g_hom e τ :=
          congrArg (g_hom e) (CategoryTheory.Category.id_comp τ)
        exact hL.symm.trans hg_e

    have hShEvalIso : ∀ P : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u},
        P.obj (Opposite.op T₀) ≅
          ((CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).obj P).obj.obj (Opposite.op T₀) := by
      intro P
      let P_sh := (CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).obj P
      let shAdj := CategoryTheory.sheafificationAdjunction J₀ AddCommGrpCat.{u}
      let η_P : P ⟶ P_sh.obj := shAdj.unit.app P
      let η₀ : P.obj (Opposite.op T₀) ⟶ P_sh.obj.obj (Opposite.op T₀) := η_P.app (Opposite.op T₀)
      let M₀ := P.obj (Opposite.op T₀)
      let α_pre : P ⟶ R_pre M₀ :=
        { app := fun W =>
            AddCommGrpCat.ofHom
              { toFun := fun s τ => (P.map (Opposite.op τ)) s
                map_zero' := by funext τ; exact map_zero _
                map_add' := fun s₁ s₂ => by funext τ; exact map_add _ s₁ s₂ }
          naturality := fun {W₁ W₂} f => by
            apply AddCommGrpCat.ext
            intro s
            funext τ
            exact congrArg (fun k : P.obj W₁ ⟶ M₀ => k s) (P.map_comp f (Opposite.op τ)).symm }
      let α_sh : P_sh ⟶ ⟨R_pre M₀, hSheaf_Rpre M₀⟩ :=
        (shAdj.homEquiv P ⟨R_pre M₀, hSheaf_Rpre M₀⟩).symm α_pre
      have hα_comm : η_P ≫ α_sh.hom = α_pre :=
        (shAdj.homEquiv P ⟨R_pre M₀, hSheaf_Rpre M₀⟩).apply_symm_apply α_pre
      let inv₀ : P_sh.obj.obj (Opposite.op T₀) ⟶ M₀ :=
        AddCommGrpCat.ofHom
          { toFun := fun x => (α_sh.hom.app (Opposite.op T₀) x) (𝟙 T₀)
            map_zero' := by rw [map_zero]; rfl
            map_add' := fun x₁ x₂ => by rw [map_add]; rfl }
      have h_hom_inv : η₀ ≫ inv₀ = 𝟙 M₀ := by
        apply AddCommGrpCat.ext
        intro s
        have h1 := congrArg (fun k => (k.app (Opposite.op T₀) s) (𝟙 T₀)) hα_comm
        have h_id_P : P.map (Opposite.op (𝟙 T₀)) = 𝟙 M₀ := P.map_id (Opposite.op T₀)
        exact h1.trans (congrArg (fun k : M₀ ⟶ M₀ => k s) h_id_P)
      let M₁ := P_sh.obj.obj (Opposite.op T₀)
      let β₁ : P_sh ⟶ ⟨R_pre M₁, hSheaf_Rpre M₁⟩ :=
        { hom :=
            { app := fun W =>
                AddCommGrpCat.ofHom
                  { toFun := fun x τ => (P_sh.obj.map (Opposite.op τ)) x
                    map_zero' := by funext τ; exact map_zero _
                    map_add' := fun x₁ x₂ => by funext τ; exact map_add _ x₁ x₂ }
              naturality := fun {W₁ W₂} f => by
                apply AddCommGrpCat.ext
                intro x
                funext τ
                exact congrArg (fun k : P_sh.obj.obj W₁ ⟶ M₁ => k x)
                  (P_sh.obj.map_comp f (Opposite.op τ)).symm } }
      let β₂ : P_sh ⟶ ⟨R_pre M₁, hSheaf_Rpre M₁⟩ :=
        { hom :=
            { app := fun W =>
                AddCommGrpCat.ofHom
                  { toFun := fun x τ => η₀ (inv₀ ((P_sh.obj.map (Opposite.op τ)) x))
                    map_zero' := by
                      funext τ
                      exact (congrArg (fun z => η₀ (inv₀ z))
                        (map_zero (P_sh.obj.map (Opposite.op τ)).hom)).trans
                        ((congrArg η₀ (map_zero inv₀.hom)).trans (map_zero η₀.hom))
                    map_add' := fun x₁ x₂ => by
                      funext τ
                      exact (congrArg (fun z => η₀ (inv₀ z))
                        (map_add (P_sh.obj.map (Opposite.op τ)).hom x₁ x₂)).trans
                        ((congrArg η₀ (map_add inv₀.hom _ _)).trans (map_add η₀.hom _ _)) }
              naturality := fun {W₁ W₂} f => by
                apply AddCommGrpCat.ext
                intro x
                funext τ
                exact congrArg (fun z => η₀ (inv₀ z))
                  (congrArg (fun k : P_sh.obj.obj W₁ ⟶ M₁ => k x)
                    (P_sh.obj.map_comp f (Opposite.op τ)).symm) } }
      have hβ_eq : β₁ = β₂ := by
        apply (shAdj.homEquiv P ⟨R_pre M₁, hSheaf_Rpre M₁⟩).injective
        ext W s
        funext τ
        change (P_sh.obj.map (Opposite.op τ)) (η_P.app W s) =
          η₀ (inv₀ ((P_sh.obj.map (Opposite.op τ)) (η_P.app W s)))
        have hnat := congrArg (fun k => k s) (η_P.naturality (Opposite.op τ))
        dsimp [η₀] at hnat ⊢
        rw [← hnat]
        have h_hi := congrArg (fun k => k ((P.map (Opposite.op τ)) s)) h_hom_inv
        dsimp [η₀] at h_hi
        exact (congrArg η₀ h_hi).symm
      refine
        { hom := η₀
          inv := inv₀
          hom_inv_id := h_hom_inv
          inv_hom_id := ?_ }
      apply AddCommGrpCat.ext
      intro x
      have h2 := congrArg (fun b : P_sh ⟶ ⟨R_pre M₁, hSheaf_Rpre M₁⟩ =>
        (b.hom.app (Opposite.op T₀) x) (𝟙 T₀)) hβ_eq.symm
      have h_id_sh : P_sh.obj.map (Opposite.op (𝟙 T₀)) = 𝟙 M₁ := P_sh.obj.map_id (Opposite.op T₀)
      have h_id_x : (P_sh.obj.map (Opposite.op (𝟙 T₀))) x = x :=
        congrArg (fun k : M₁ ⟶ M₁ => k x) h_id_sh
      change η₀ (inv₀ x) = x
      exact (congrArg (fun z => η₀ (inv₀ z)) h_id_x.symm).trans (h2.trans h_id_x)

    let G := weilEtaleHigherDirectImage X.hom q ℱ
    rcases hConst.2 S₀ (𝟙 S₀) inferInstance inferInstance with
      ⟨U, hU_ne, V, p, A, _, hEt_p, hSurj_p, hFin_A, _, hPull_G⟩
    let q_map : V ⟶ S₀ := p ≫ (U.ι ≫ 𝟙 S₀)
    have hEt_q : AlgebraicGeometry.Etale q_map :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) p (U.ι ≫ 𝟙 S₀) hEt_p
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) U.ι (𝟙 S₀)
          inferInstance inferInstance)
    have hSurj_q : AlgebraicGeometry.Surjective q_map := by
      rcases hU_ne with ⟨u₀⟩
      rcases (AlgebraicGeometry.surjective_iff p).mp hSurj_p u₀ with ⟨v₀, _⟩
      exact (AlgebraicGeometry.surjective_iff q_map).mpr fun x => ⟨v₀, Subsingleton.elim _ _⟩
    have _ : AlgebraicGeometry.Etale q_map := hEt_q
    have _ : AlgebraicGeometry.Surjective q_map := hSurj_q
    rcases hSplitEt q_map with ⟨σ, hσ_q⟩

    rcases hPull_G with ⟨hCont_q, hAdj_q, ⟨iso_q⟩⟩
    rcases hPullAdj S₀ V σ with ⟨hCont_σ, hAdj_σ⟩
    rcases hConstEquiv V A with ⟨hT_V, _, _, _, _⟩
    let B_q := weilEtaleSitePullback q_map
    let B_σ := weilEtaleSitePullback σ
    let B_id := weilEtaleSitePullback (𝟙 S₀)
    let R_q := B_q.sheafPushforwardContinuous AddCommGrpCat.{u} J₀ V.smallEtaleTopology
    let adj_q := B_q.sheafAdjunctionContinuous AddCommGrpCat.{u} J₀ V.smallEtaleTopology
    let R_σ := B_σ.sheafPushforwardContinuous AddCommGrpCat.{u} V.smallEtaleTopology J₀
    let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A
    let C_S₀ := (CategoryTheory.constantSheaf J₀ AddCommGrpCat.{u}).obj A
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
    let adj_c_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT_V
    let adj_c_S₀ := CategoryTheory.constantSheafAdj J₀ AddCommGrpCat.{u} hT₀

    let e_Bid : 𝟭 S₀.Etale ≅ B_id :=
      CategoryTheory.NatIso.ofComponents
        (fun W =>
          let w_hom := (Fgt₀.obj W).hom
          let lft_W := CategoryTheory.Limits.pullback.lift (𝟙 (Fgt₀.obj W).left) w_hom
            ((CategoryTheory.Category.id_comp w_hom).trans
              (CategoryTheory.Category.comp_id w_hom).symm)
          let fst_W := CategoryTheory.Limits.pullback.fst w_hom (𝟙 S₀)
          let snd_W := CategoryTheory.Limits.pullback.snd w_hom (𝟙 S₀)
          { hom :=
              CategoryTheory.MorphismProperty.Over.homMk lft_W
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            inv :=
              CategoryTheory.MorphismProperty.Over.homMk fst_W
                ((CategoryTheory.Limits.pullback.condition (f := w_hom) (g := 𝟙 S₀)).trans
                  (CategoryTheory.Category.comp_id _))
            hom_inv_id := by
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              exact CategoryTheory.Limits.pullback.lift_fst _ _ _
            inv_hom_id := by
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              apply CategoryTheory.Limits.pullback.hom_ext
              · change (fst_W ≫ lft_W) ≫ fst_W = 𝟙 _ ≫ fst_W
                exact ((CategoryTheory.Category.assoc fst_W lft_W fst_W).trans
                  ((congrArg (fst_W ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    (CategoryTheory.Category.comp_id fst_W))).trans
                  (CategoryTheory.Category.id_comp fst_W).symm
              · change (fst_W ≫ lft_W) ≫ snd_W = 𝟙 _ ≫ snd_W
                exact ((CategoryTheory.Category.assoc fst_W lft_W snd_W).trans
                  ((congrArg (fst_W ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                    ((CategoryTheory.Limits.pullback.condition (f := w_hom) (g := 𝟙 S₀)).trans
                      (CategoryTheory.Category.comp_id snd_W)))).trans
                  (CategoryTheory.Category.id_comp snd_W).symm })
        (fun {W₁ W₂} u => by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          apply CategoryTheory.Limits.pullback.hom_ext
          · let w₁ := (Fgt₀.obj W₁).hom
            let w₂ := (Fgt₀.obj W₂).hom
            let u_l := (Fgt₀.map u).left
            let lft₁ := CategoryTheory.Limits.pullback.lift (𝟙 (Fgt₀.obj W₁).left) w₁
              ((CategoryTheory.Category.id_comp w₁).trans (CategoryTheory.Category.comp_id w₁).symm)
            let lft₂ := CategoryTheory.Limits.pullback.lift (𝟙 (Fgt₀.obj W₂).left) w₂
              ((CategoryTheory.Category.id_comp w₂).trans (CategoryTheory.Category.comp_id w₂).symm)
            let m_u := (Fgt₀.map (B_id.map u)).left
            change (u_l ≫ lft₂) ≫ CategoryTheory.Limits.pullback.fst w₂ (𝟙 S₀) =
              (lft₁ ≫ m_u) ≫ CategoryTheory.Limits.pullback.fst w₂ (𝟙 S₀)
            have hL : (u_l ≫ lft₂) ≫ CategoryTheory.Limits.pullback.fst w₂ (𝟙 S₀) = u_l :=
              (CategoryTheory.Category.assoc u_l lft₂ _).trans
                ((congrArg (u_l ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  (CategoryTheory.Category.comp_id u_l))
            have hR : (lft₁ ≫ m_u) ≫ CategoryTheory.Limits.pullback.fst w₂ (𝟙 S₀) = u_l :=
              (CategoryTheory.Category.assoc lft₁ m_u _).trans
                ((congrArg (lft₁ ≫ ·) (sitePullMap_fst (𝟙 S₀) u)).trans
                  ((CategoryTheory.Category.assoc lft₁ _ u_l).symm.trans
                    ((congrArg (· ≫ u_l) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                      (CategoryTheory.Category.id_comp u_l))))
            exact hL.trans hR.symm
          · let w₁ := (Fgt₀.obj W₁).hom
            let w₂ := (Fgt₀.obj W₂).hom
            let u_l := (Fgt₀.map u).left
            let lft₁ := CategoryTheory.Limits.pullback.lift (𝟙 (Fgt₀.obj W₁).left) w₁
              ((CategoryTheory.Category.id_comp w₁).trans (CategoryTheory.Category.comp_id w₁).symm)
            let lft₂ := CategoryTheory.Limits.pullback.lift (𝟙 (Fgt₀.obj W₂).left) w₂
              ((CategoryTheory.Category.id_comp w₂).trans (CategoryTheory.Category.comp_id w₂).symm)
            let m_u := (Fgt₀.map (B_id.map u)).left
            change (u_l ≫ lft₂) ≫ CategoryTheory.Limits.pullback.snd w₂ (𝟙 S₀) =
              (lft₁ ≫ m_u) ≫ CategoryTheory.Limits.pullback.snd w₂ (𝟙 S₀)
            have hL : (u_l ≫ lft₂) ≫ CategoryTheory.Limits.pullback.snd w₂ (𝟙 S₀) = w₁ :=
              (CategoryTheory.Category.assoc u_l lft₂ _).trans
                ((congrArg (u_l ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  (Fgt₀.map u).w)
            have hR : (lft₁ ≫ m_u) ≫ CategoryTheory.Limits.pullback.snd w₂ (𝟙 S₀) = w₁ :=
              (CategoryTheory.Category.assoc lft₁ m_u _).trans
                ((congrArg (lft₁ ≫ ·) (sitePullMap_snd (𝟙 S₀) u)).trans
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _))
            exact hL.trans hR.symm)

    let e_B_split : 𝟭 S₀.Etale ≅ B_q ⋙ B_σ :=
      e_Bid.trans ((CategoryTheory.MorphismProperty.Over.pullbackCongr hσ_q.symm).trans
        (CategoryTheory.MorphismProperty.Over.pullbackComp σ q_map))

    let iso_T₀ := terminalPullbackIso σ hT₀
    let from_T₀ : T₀ ⟶ B_σ.obj T_V := iso_T₀.hom
    let to_T₀ : B_σ.obj T_V ⟶ T₀ := iso_T₀.inv
    have h_from_to_T₀ : from_T₀ ≫ to_T₀ = 𝟙 T₀ := iso_T₀.hom_inv_id
    have h_to_from_T₀ : to_T₀ ≫ from_T₀ = 𝟙 (B_σ.obj T_V) := iso_T₀.inv_hom_id

    have iso_G_const : G ≅ C_S₀ := by
      let splitEquiv : ∀ ℋ : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u},
          (G ⟶ ℋ) ≃ (G ⟶ R_q.obj (R_σ.obj ℋ)) := fun ℋ =>
        let u₁ := CategoryTheory.Functor.whiskerRight (CategoryTheory.NatIso.op e_B_split).inv ℋ.obj
        let u₂ := CategoryTheory.Functor.whiskerRight (CategoryTheory.NatIso.op e_B_split).hom ℋ.obj
        { toFun := fun φ => { hom := φ.hom ≫ u₁ }
          invFun := fun ψ => { hom := ψ.hom ≫ u₂ }
          left_inv := fun φ => by
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext W
            have h_app : u₁.app W ≫ u₂.app W = 𝟙 (ℋ.obj.obj W) :=
              (ℋ.obj.map_comp _ _).symm.trans
                ((congrArg ℋ.obj.map ((CategoryTheory.NatIso.op e_B_split).inv_hom_id_app W)).trans
                  (ℋ.obj.map_id _))
            exact (CategoryTheory.Category.assoc (φ.hom.app W) (u₁.app W) (u₂.app W)).trans
              ((congrArg (φ.hom.app W ≫ ·) h_app).trans (CategoryTheory.Category.comp_id _))
          right_inv := fun ψ => by
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext W
            have h_app : u₂.app W ≫ u₁.app W = 𝟙 (ℋ.obj.obj ((B_q ⋙ B_σ).op.obj W)) :=
              (ℋ.obj.map_comp _ _).symm.trans
                ((congrArg ℋ.obj.map ((CategoryTheory.NatIso.op e_B_split).hom_inv_id_app W)).trans
                  (ℋ.obj.map_id _))
            exact (CategoryTheory.Category.assoc (ψ.hom.app W) (u₂.app W) (u₁.app W)).trans
              ((congrArg (ψ.hom.app W ≫ ·) h_app).trans (CategoryTheory.Category.comp_id _)) }
      refine isoOfSheafHomEquiv G C_S₀ (fun ℋ =>
        (splitEquiv ℋ).trans
          (((adj_q.homEquiv G (R_σ.obj ℋ)).symm.trans
            { toFun := fun u => iso_q.inv ≫ u
              invFun := fun v => iso_q.hom ≫ v
              left_inv := fun u => Iso.hom_inv_id_assoc iso_q u
              right_inv := fun v => Iso.inv_hom_id_assoc iso_q v }).trans
            (((adj_c_V.homEquiv A (R_σ.obj ℋ)).trans
              { toFun := fun α => α ≫ ℋ.obj.map (Opposite.op from_T₀)
                invFun := fun β => β ≫ ℋ.obj.map (Opposite.op to_T₀)
                left_inv := fun α => by
                  dsimp
                  have h_map : ℋ.obj.map (Opposite.op from_T₀) ≫ ℋ.obj.map (Opposite.op to_T₀) =
                      𝟙 (ℋ.obj.obj (Opposite.op (B_σ.obj T_V))) :=
                    (ℋ.obj.map_comp _ _).symm.trans
                      ((congrArg ℋ.obj.map (congrArg Opposite.op h_to_from_T₀)).trans
                        (ℋ.obj.map_id _))
                  exact (CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (α ≫ ·) h_map).trans (CategoryTheory.Category.comp_id _))
                right_inv := fun β => by
                  dsimp
                  have h_map : ℋ.obj.map (Opposite.op to_T₀) ≫ ℋ.obj.map (Opposite.op from_T₀) =
                      𝟙 (ℋ.obj.obj (Opposite.op T₀)) :=
                    (ℋ.obj.map_comp _ _).symm.trans
                      ((congrArg ℋ.obj.map (congrArg Opposite.op h_from_to_T₀)).trans
                        (ℋ.obj.map_id _))
                  exact (CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (β ≫ ·) h_map).trans (CategoryTheory.Category.comp_id _)) }).trans
              (adj_c_S₀.homEquiv A ℋ).symm))) ?_
      intro ℋ₁ ℋ₂ f g
      let step₁ : ∀ {ℋ} (h : G ⟶ ℋ), C_V ⟶ R_σ.obj ℋ :=
        fun {ℋ} h => iso_q.inv ≫
          (adj_q.homEquiv G (R_σ.obj ℋ)).symm (splitEquiv ℋ h)
      let step₂ : ∀ {ℋ} (h : G ⟶ ℋ), A ⟶ ℋ.obj.obj (Opposite.op T₀) :=
        fun {ℋ} h => adj_c_V.homEquiv A (R_σ.obj ℋ) (step₁ h) ≫
          ℋ.obj.map (Opposite.op from_T₀)
      have h_sp : splitEquiv ℋ₂ (f ≫ g) =
          splitEquiv ℋ₁ f ≫ R_q.map (R_σ.map g) := by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W
        exact (CategoryTheory.Category.assoc (f.hom.app W) (g.hom.app W) _).trans
          ((congrArg (f.hom.app W ≫ ·)
            (g.hom.naturality ((CategoryTheory.NatIso.op e_B_split).inv.app W)).symm).trans
            (CategoryTheory.Category.assoc _ _ _).symm)
      have h_step₁ : step₁ (f ≫ g) = step₁ f ≫ R_σ.map g := by
        have h_symm : (adj_q.homEquiv G (R_σ.obj ℋ₂)).symm (splitEquiv ℋ₂ (f ≫ g)) =
            (adj_q.homEquiv G (R_σ.obj ℋ₁)).symm (splitEquiv ℋ₁ f) ≫ R_σ.map g :=
          (congrArg (adj_q.homEquiv G (R_σ.obj ℋ₂)).symm h_sp).trans
            (adj_q.homEquiv_naturality_right_symm _ (R_σ.map g))
        exact (congrArg (iso_q.inv ≫ ·) h_symm).trans (CategoryTheory.Category.assoc _ _ _).symm
      have h_c_V : adj_c_V.homEquiv A (R_σ.obj ℋ₂) (step₁ (f ≫ g)) =
          adj_c_V.homEquiv A (R_σ.obj ℋ₁) (step₁ f) ≫
            g.hom.app (Opposite.op (B_σ.obj T_V)) :=
        (congrArg (adj_c_V.homEquiv A (R_σ.obj ℋ₂)) h_step₁).trans
          (adj_c_V.homEquiv_naturality_right (step₁ f) (R_σ.map g))
      have h_step₂ : step₂ (f ≫ g) = step₂ f ≫ g.hom.app (Opposite.op T₀) :=
        (congrArg (· ≫ ℋ₂.obj.map (Opposite.op from_T₀)) h_c_V).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (adj_c_V.homEquiv A (R_σ.obj ℋ₁) (step₁ f) ≫ ·)
              (g.hom.naturality (Opposite.op from_T₀)).symm).trans
              (CategoryTheory.Category.assoc _ _ _).symm))
      apply (adj_c_S₀.homEquiv A ℋ₂).injective
      refine ((adj_c_S₀.homEquiv A ℋ₂).apply_symm_apply (step₂ (f ≫ g))).trans ?_
      refine h_step₂.trans ?_
      exact ((adj_c_S₀.homEquiv_naturality_right _ g).trans
        (congrArg (· ≫ g.hom.app (Opposite.op T₀))
          ((adj_c_S₀.homEquiv A ℋ₁).apply_symm_apply (step₂ f)))).symm

    let B_X := weilEtaleSitePullback X.hom
    let P_X := B_X.op ⋙ ℱ.cohomologyPresheaf q
    let iso_PX_A : P_X.obj (Opposite.op T₀) ≅ A :=
      ((hShEvalIso P_X).trans
        { hom := iso_G_const.hom.hom.app (Opposite.op T₀)
          inv := iso_G_const.inv.hom.app (Opposite.op T₀)
          hom_inv_id := by
            change (iso_G_const.hom ≫ iso_G_const.inv).hom.app (Opposite.op T₀) = _
            rw [iso_G_const.hom_inv_id]
            rfl
          inv_hom_id := by
            change (iso_G_const.inv ≫ iso_G_const.hom).hom.app (Opposite.op T₀) = _
            rw [iso_G_const.inv_hom_id]
            rfl }).trans
        (hShEvalIso ((CategoryTheory.Functor.const (Opposite S₀.Etale)).obj A)).symm

    have hFin_PX : Finite ↥(P_X.obj (Opposite.op T₀)) := by
      let eqv_A : ↥(P_X.obj (Opposite.op T₀)) ≃ ↥A :=
        { toFun := iso_PX_A.hom
          invFun := iso_PX_A.inv
          left_inv := fun x => congrArg (fun k => k x) iso_PX_A.hom_inv_id
          right_inv := fun y => congrArg (fun k => k y) iso_PX_A.inv_hom_id }
      exact Finite.of_equiv ↥A eqv_A.symm

    
    rcases hConstEquiv X.left (AddCommGrpCat.of (ULift.{u} ℤ)) with ⟨hT_X, _, _, _, _⟩
    have hT_BX : CategoryTheory.Limits.IsTerminal (B_X.obj T₀) :=
      CategoryTheory.Limits.IsTerminal.ofIso hT_X (terminalPullbackIso X.hom hT_X)

    let J_X := X.left.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Cℤ_X := (CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}).obj Aℤ
    let Rep_BX := weilPolyP1CohomologyRepSheaf X.left (B_X.obj T₀)
    let adj_c_BX := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_BX

    let zHomEquiv : ∀ M : AddCommGrpCat.{u}, (Aℤ ⟶ M) ≃ ↥M := fun M =>
      { toFun := fun φ => φ (ULift.up (1 : ℤ))
        invFun := fun m =>
          AddCommGrpCat.ofHom
            { toFun := fun n => n.down • m
              map_zero' := zero_zsmul m
              map_add' := fun a b => add_zsmul m a.down b.down }
        left_inv := fun φ => by
          apply AddCommGrpCat.ext
          rintro ⟨n⟩
          change n • φ (ULift.up 1) = φ (ULift.up n)
          have hn : (ULift.up n : ULift.{u} ℤ) = n • (ULift.up (1 : ℤ) : ULift.{u} ℤ) := by
            ext
            simp
          rw [hn, map_zsmul]
        right_inv := fun m => one_zsmul m }

    have iso_Rep_Cℤ : Rep_BX ≅ Cℤ_X := by
      refine isoOfSheafHomEquiv Rep_BX Cℤ_X (fun 𝒢 =>
        (weilPolyP1CohomologyRepHomEquiv X.left (B_X.obj T₀) 𝒢).trans
          ((zHomEquiv (𝒢.obj.obj (Opposite.op (B_X.obj T₀)))).symm.trans
            (adj_c_BX.homEquiv Aℤ 𝒢).symm)) ?_
      intro 𝒢₁ 𝒢₂ f g
      let ev₁ := weilPolyP1CohomologyRepHomEquiv X.left (B_X.obj T₀) 𝒢₁ f
      let ev₂ := weilPolyP1CohomologyRepHomEquiv X.left (B_X.obj T₀) 𝒢₂ (f ≫ g)
      have hev : ev₂ = (g.hom.app (Opposite.op (B_X.obj T₀))) ev₁ := by
        let shAdj_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
        let freeAdj_X := AddCommGrpCat.adj.whiskerRight (Opposite X.left.Etale)
        let F_rep := CategoryTheory.Functor.comp
          (CategoryTheory.yoneda.obj (B_X.obj T₀)) AddCommGrpCat.free
        have h1 : shAdj_X.homEquiv F_rep 𝒢₂ (f ≫ g) =
            shAdj_X.homEquiv F_rep 𝒢₁ f ≫ g.hom :=
          shAdj_X.homEquiv_naturality_right f g
        have h2 :=
          (congrArg (freeAdj_X.homEquiv (CategoryTheory.yoneda.obj (B_X.obj T₀)) 𝒢₂.obj) h1).trans
            (freeAdj_X.homEquiv_naturality_right (shAdj_X.homEquiv F_rep 𝒢₁ f) g.hom)
        exact congrArg (fun k => k.app (Opposite.op (B_X.obj T₀)) (𝟙 (B_X.obj T₀))) h2
      have hz : (zHomEquiv (𝒢₂.obj.obj (Opposite.op (B_X.obj T₀)))).symm ev₂ =
          (zHomEquiv (𝒢₁.obj.obj (Opposite.op (B_X.obj T₀)))).symm ev₁ ≫
            g.hom.app (Opposite.op (B_X.obj T₀)) := by
        apply (zHomEquiv (𝒢₂.obj.obj (Opposite.op (B_X.obj T₀)))).injective
        refine ((zHomEquiv _).apply_symm_apply ev₂).trans ?_
        have h_rhs : zHomEquiv _
            ((zHomEquiv _).symm ev₁ ≫ g.hom.app (Opposite.op (B_X.obj T₀))) =
            (g.hom.app (Opposite.op (B_X.obj T₀))) (zHomEquiv _ ((zHomEquiv _).symm ev₁)) := rfl
        exact (hev.trans (congrArg (g.hom.app (Opposite.op (B_X.obj T₀)))
          ((zHomEquiv _).apply_symm_apply ev₁).symm)).trans h_rhs.symm
      apply (adj_c_BX.homEquiv Aℤ 𝒢₂).injective
      refine ((adj_c_BX.homEquiv Aℤ 𝒢₂).apply_symm_apply _).trans ?_
      refine hz.trans ?_
      exact ((adj_c_BX.homEquiv_naturality_right _ g).trans
        (congrArg (· ≫ g.hom.app (Opposite.op (B_X.obj T₀)))
          ((adj_c_BX.homEquiv Aℤ 𝒢₁).apply_symm_apply _))).symm

    let to_PX : ℱ.H q → ↥(P_X.obj (Opposite.op T₀)) :=
      (CategoryTheory.Abelian.Ext.mk₀ iso_Rep_Cℤ.hom).precomp ℱ (Nat.zero_add q)
    have h_inj_to_PX : Function.Injective to_PX := by
      intro x₁ x₂ hx
      have h_retract : ∀ x : ℱ.H q,
          ((CategoryTheory.Abelian.Ext.mk₀ iso_Rep_Cℤ.inv).precomp ℱ (Nat.zero_add q))
            (to_PX x) = x := by
        intro x
        dsimp [to_PX]
        change (CategoryTheory.Abelian.Ext.mk₀ iso_Rep_Cℤ.inv).comp
            ((CategoryTheory.Abelian.Ext.mk₀ iso_Rep_Cℤ.hom).comp x (Nat.zero_add q))
            (Nat.zero_add q) = x
        rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, iso_Rep_Cℤ.inv_hom_id,
          CategoryTheory.Abelian.Ext.mk₀_id_comp]
      rw [← h_retract x₁, ← h_retract x₂, hx]
    exact @Finite.of_injective _ _ hFin_PX to_PX h_inj_to_PX

  
  have hConst_X : WeilIsConstructibleModPrimeSheaf ℓ X.left 𝒦₀ := by
    refine ⟨hTor_K0, ?_⟩
    intro Z iZ hCl_iZ hInt_Z
    let _ := hCl_iZ
    have _ : AlgebraicGeometry.IsIntegral Z := hInt_Z
    let U_Z : Z.Opens := (TopologicalSpace.Opens.map iZ.base).obj U_bar
    by_cases hUZ : Nonempty ↥U_Z
    · have h_sub_U : Set.range (U_Z.ι ≫ iZ).base ⊆ Set.range U_bar.ι.base := by
        rintro x ⟨u, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι U_bar]
        exact u.2
      let g_U : U_Z.toScheme ⟶ U_bar.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_bar.ι (U_Z.ι ≫ iZ) h_sub_U
      have hg_U : g_U ≫ U_bar.ι = U_Z.ι ≫ iZ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_bar.ι (U_Z.ι ≫ iZ) h_sub_U
      let V := CategoryTheory.Limits.pullback g_U π_bar
      let p : V ⟶ U_Z.toScheme := CategoryTheory.Limits.pullback.fst g_U π_bar
      let q_V : V ⟶ V_bar := CategoryTheory.Limits.pullback.snd g_U π_bar
      have _ : AlgebraicGeometry.IsFinite π_bar := hFin_π
      have _ : AlgebraicGeometry.Etale π_bar := hEt_π
      have _ : AlgebraicGeometry.Surjective π_bar := hSurj_π
      have _ : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩
      have hFin_Arank : Finite ↥A_rank := by
        change Finite (ULift.{u, 0} (Fin m_Γ → ZMod ℓ))
        infer_instance
      have hTor_A : ℓ • CategoryTheory.CategoryStruct.id A_rank = 0 := by
        apply AddCommGrpCat.ext
        rintro ⟨v⟩
        apply ULift.ext
        funext idx
        change ℓ • v idx = 0
        rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
      have hp_eq : p ≫ (U_Z.ι ≫ iZ) = q_V ≫ ι_bar := by
        rw [← hg_U, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, hι_eq]
      refine ⟨U_Z, hUZ, V, p, A_rank, inferInstance, inferInstance, inferInstance,
        hFin_Arank, hTor_A, ?_⟩
      rw [hp_eq]
      exact hPull_in V q_V
    · let U_top : Z.Opens := ⊤
      have hNe_top : Nonempty ↥U_top :=
        ⟨⟨Classical.arbitrary ↥Z, trivial⟩⟩
      let V := (U_top : AlgebraicGeometry.Scheme.{u})
      let p : V ⟶ U_top.toScheme := 𝟙 V
      have hFin_Azero : Finite ↥A_zero := by
        change Finite (ULift.{u, 0} PUnit)
        infer_instance
      have hTor_A0 : ℓ • CategoryTheory.CategoryStruct.id A_zero = 0 := by
        apply AddCommGrpCat.ext
        rintro ⟨⟨⟩⟩
        rfl
      have hDisj_Z : Disjoint (Set.range (p ≫ (U_top.ι ≫ iZ)).base) (U_bar : Set X.left) := by
        rw [Set.disjoint_left]
        rintro x ⟨u, rfl⟩ hx_U
        apply hUZ
        exact ⟨⟨(U_top.ι).base u, hx_U⟩⟩
      exact ⟨U_top, hNe_top, V, p, A_zero, inferInstance, inferInstance, inferInstance,
        hFin_Azero, hTor_A0, hPull_out V (p ≫ (U_top.ι ≫ iZ)) hDisj_Z⟩

  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ
  have hP1 : WeilP1ConstructiblePushforwardHolds k ℓ :=
    weil_etale_p1_constructible_pushforward k ℓ hℓ
      (fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
        weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀)
      hPBC
  let B_pt : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
  have _ : AlgebraicGeometry.LocallyOfFiniteType B_pt.hom := by dsimp [B_pt]; infer_instance
  have _ : AlgebraicGeometry.QuasiCompact B_pt.hom := by dsimp [B_pt]; infer_instance
  have _ : AlgebraicGeometry.IsSeparated B_pt.hom := by dsimp [B_pt]; infer_instance
  let f₀ : X ⟶ B_pt :=
    CategoryTheory.Over.homMk X.hom (by dsimp [B_pt]; rw [CategoryTheory.Category.comp_id])
  have hf₀_prop : AlgebraicGeometry.IsProper f₀.left := by
    change AlgebraicGeometry.IsProper X.hom
    infer_instance
  intro q
  have hPush := weil_etale_proper_constructible_pushforward k ℓ hℓ hPBC hP1
    X B_pt f₀ hf₀_prop 𝒦₀ hConst_X q
  exact hSpecExtract 𝒦₀ q hPush

theorem weil_curve_tr_geom_cover_deck_frob_and_zero_ext (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (ℓ r : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ : Type u) [CommRing B₀] [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) B₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) B₀]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F)))))
      U₀.toScheme)
    (G_Dr : CategoryTheory.Functor
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Etale
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Etale)
    [G_Dr.IsContinuous
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology]
    (hG_Dr_obj : ∀ U : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Etale,
      ((AlgebraicGeometry.Scheme.Etale.forget
        (weilGeomScheme F (weilProjectiveSpaceOver F 1))).obj (G_Dr.obj U)).left =
        ((AlgebraicGeometry.Scheme.Etale.forget
          (weilGeomScheme F (weilProjectiveSpaceOver F 1))).obj U).left ∧
      HEq ((AlgebraicGeometry.Scheme.Etale.forget
          (weilGeomScheme F (weilProjectiveSpaceOver F 1))).obj (G_Dr.obj U)).hom
        (CategoryTheory.CategoryStruct.comp
          ((AlgebraicGeometry.Scheme.Etale.forget
            (weilGeomScheme F (weilProjectiveSpaceOver F 1))).obj U).hom
          (weilSchemeEndPow (weilGeomFrobHom F (weilProjectiveSpaceOver F 1)) r)))
    (hG_Dr_map : ∀ {U₁ U₂ : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Etale}
      (u : Quiver.Hom U₁ U₂),
      HEq ((AlgebraicGeometry.Scheme.Etale.forget
          (weilGeomScheme F (weilProjectiveSpaceOver F 1))).map (G_Dr.map u)).left
        ((AlgebraicGeometry.Scheme.Etale.forget
