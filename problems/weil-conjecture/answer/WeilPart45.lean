      (L.map (fun γ => 1 - Polynomial.C (γ ^ e) * Polynomial.X)).prod =
        recProd ((Multiset.ofList L).map (· ^ e)) := by
    intro L e
    simp [recProd, List.map_map, Function.comp_def]
  have hNorm : ∀ (d' : ℕ) (hd' : 1 ≤ d') (x' : GoodPoly d'),
