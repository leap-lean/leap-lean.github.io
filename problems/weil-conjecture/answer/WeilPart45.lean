  let q_M₁ : (Fin N → M_K.M₁) →+ I₁ := q_inv M_K.M₁
  let q_M₂ : (Fin N → M_K.M₂) →+ I₂ := q_inv M_K.M₂
  have _ : Finite I₀ := Quotient.finite _
  have _ : Finite I₁ := Quotient.finite _

  obtain ⟨modI₀, _⟩ := hZModMod_u (ℓ ^ (s + 1)) h1_lt_s1 I₀ (hTor_Finv M_K.M₀)
  obtain ⟨modI₁, _⟩ := hZModMod_u (ℓ ^ (s + 1)) h1_lt_s1 I₁ (hTor_Finv M_K.M₁)
