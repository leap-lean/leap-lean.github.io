        CategoryTheory.Abelian.Ext.{u} X (K b) q →+ CategoryTheory.Abelian.Ext.{u} X (K a) q :=
      fun q a b h => (CategoryTheory.Abelian.Ext.mk₀ (τ_le a b h)).postcomp X (Nat.add_zero q)
    let ι_ext : ∀ q a b : ℕ,
        CategoryTheory.Abelian.Ext.{u} X (K a) q →+ CategoryTheory.Abelian.Ext.{u} X (K (a + b + 1)) q :=
      fun q a b => (CategoryTheory.Abelian.Ext.mk₀ (ι_b a b)).postcomp X (Nat.add_zero q)
    let δ_ext : ∀ q a b : ℕ,
        CategoryTheory.Abelian.Ext.{u} X (K b) q →+ CategoryTheory.Abelian.Ext.{u} X (K a) (q + 1) :=
      fun q a b => ((hSE a b).extClass).postcomp X rfl
    refine ⟨?_, τ_le_ext, ι_ext, δ_ext, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro q m x
      have hx : x = (x.precomp (K m) (Nat.add_zero q))
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (K m))) :=
        (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
      calc
        (ℓ ^ (m + 1) : ℕ) • x =
            (ℓ ^ (m + 1) : ℕ) • (x.precomp (K m) (Nat.add_zero q))
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (K m))) := by
          rw [← hx]
        _ = (x.precomp (K m) (Nat.add_zero q))
              ((ℓ ^ (m + 1) : ℕ) •
                CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (K m))) :=
          (map_nsmul (x.precomp (K m) (Nat.add_zero q)) _ _).symm
        _ = (x.precomp (K m) (Nat.add_zero q))
              (CategoryTheory.Abelian.Ext.mk₀
                ((ℓ ^ (m + 1) : ℕ) • CategoryTheory.CategoryStruct.id (K m))) := by
          rw [mk₀_nsmul]
        _ = 0 := by
          rw [hTor m, CategoryTheory.Abelian.Ext.mk₀_zero, map_zero]
    · intro q a
      ext x
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le a a (le_refl a))) (Nat.add_zero q) = x
      rw [hrefl a, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · intro q a b h
      ext x
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le a (b + 1) (Nat.le_succ_of_le h)))
          (Nat.add_zero q) =
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ b)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_le a b h)) (Nat.add_zero q)
      rw [hstep a b h, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) (Nat.zero_add 0)
          (Nat.add_zero q)]
    · intro q a b x
      constructor
      · intro hx
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X (hSE a b) x hx
      · rintro ⟨y, rfl⟩
        change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_b a b)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (τ_le b (a + b + 1) (by omega))) (Nat.add_zero q) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.zero_add 0)
            (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h0 a b, CategoryTheory.Abelian.Ext.mk₀_zero]
        exact (y.precomp (K b) (Nat.add_zero q)).map_zero
    · intro q a b x
      constructor
      · intro hx
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X (hSE a b) x rfl hx
      · rintro ⟨y, rfl⟩
        change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le b (a + b + 1) (by omega)))
            (Nat.add_zero q)).comp (hSE a b).extClass rfl = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.zero_add 1) rfl,
          CategoryTheory.ShortComplex.ShortExact.comp_extClass (hSE a b)]
        exact (y.precomp (K a) rfl).map_zero
    · intro q a b y
      change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_b a b)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_le a (a + b + 1) (by omega))) (Nat.add_zero q) =
        (ℓ ^ (b + 1) : ℕ) • y
      rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.zero_add 0)
          (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hComp a b, mk₀_nsmul]
      calc
        (y.precomp (K a) (Nat.add_zero q))
            ((ℓ ^ (b + 1) : ℕ) •
              CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (K a))) =
          (ℓ ^ (b + 1) : ℕ) • (y.precomp (K a) (Nat.add_zero q))
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (K a))) :=
          map_nsmul (y.precomp (K a) (Nat.add_zero q)) _ _
        _ = (ℓ ^ (b + 1) : ℕ) • y := by
          rw [show (y.precomp (K a) (Nat.add_zero q))
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (K a))) = y from
            CategoryTheory.Abelian.Ext.comp_mk₀_id y]
    · intro q a b y
      change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (τ a)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (ι_b a b)) (Nat.add_zero q) =
        (y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_b (a + 1) b)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_le (a + b + 1) (a + 1 + b + 1) (by omega)))
          (Nat.add_zero q)
      rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.zero_add 0)
          (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.zero_add 0)
          (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hComm a b]
    · intro q a b y
      let φ_SC : CategoryTheory.ShortComplex.mk (ι_b (a + 1) b)
            (τ_le b (a + 1 + b + 1) (by omega)) (h0 (a + 1) b) ⟶
          CategoryTheory.ShortComplex.mk (ι_b a b)
            (τ_le b (a + b + 1) (by omega)) (h0 a b) :=
        CategoryTheory.ShortComplex.homMk (τ a)
          (τ_le (a + b + 1) (a + 1 + b + 1) (by omega))
          (CategoryTheory.CategoryStruct.id (K b))
          (hComm a b)
          ((htrans b (a + b + 1) (a + 1 + b + 1) (by omega) (by omega) (by omega)).trans
            (CategoryTheory.Category.comp_id _).symm)
      have hNat : ((hSE (a + 1) b).extClass).comp
            (CategoryTheory.Abelian.Ext.mk₀ (τ a)) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (K b))).comp
            (hSE a b).extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality
          (hSE (a + 1) b) (hSE a b) φ_SC
      rw [CategoryTheory.Abelian.Ext.mk₀_id_comp] at hNat
      change (y.comp (hSE (a + 1) b).extClass rfl).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ a)) (Nat.add_zero (q + 1)) =
        y.comp (hSE a b).extClass rfl
      rw [CategoryTheory.Abelian.Ext.comp_assoc y (hSE (a + 1) b).extClass
          (CategoryTheory.Abelian.Ext.mk₀ (τ a)) rfl (Nat.add_zero 1) (by omega),
        hNat]

  
  let J_D := D_bar.smallEtaleTopology
  let 𝒜 := CategoryTheory.Sheaf J_D AddCommGrpCat.{u}
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget D_bar
  let Fℤ_D := (CategoryTheory.constantSheaf J_D AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let τ_H : ∀ q m : ℕ, (𝒦 (m + 1)).H q →+ (𝒦 m).H q :=
    fun q m => (CategoryTheory.Abelian.Ext.mk₀ (τ_𝒦 m)).postcomp Fℤ_D (Nat.add_zero q)

  have sheaf_hom_ext_triv : ∀ {ℱ : 𝒜} {m : ℕ} {f g : ℱ ⟶ 𝒦 m},
      (∀ (W : D_bar.Etale) (sec : ↑(ℱ.obj.obj (Opposite.op W)))
        (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)),
        triv_K m W ((f.hom.app (Opposite.op W)) sec) y =
          triv_K m W ((g.hom.app (Opposite.op W)) sec) y) →
      f = g := by
    intro ℱ m f g hfg
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op sec
    apply ((htriv_K m).2 W_op.unop).1
    ext y
    exact hfg W_op.unop sec y

  have hLaw8 : ∀ (q m : ℕ) (x : (𝒦 (m + 1)).H q),
      τ_H q m (α_H (m + 1) q x) = α_H m q (τ_H q m x) := by
    have heq_hom : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (h : X = Y) (f : X ⟶ Z) (g : Y ⟶ Z),
        HEq f g → CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom h.symm) f = g := by
      rintro _ _ _ rfl f g hfg
      rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp]
      exact eq_of_heq hfg
    have heq_post_self : ∀ {P X Y : AlgebraicGeometry.Scheme.{u}} (h : X = Y) (p : P ⟶ Y),
        HEq (CategoryTheory.CategoryStruct.comp p (CategoryTheory.eqToHom h.symm)) p := by
      rintro _ _ _ rfl p
      rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
    rcases hα_H with ⟨G_Dr, hCont_Dr, hG_obj, _hG_map, hAdd_P, hLim_P, hColim_P,
      T_D, hT_D, μ_D, _hTD_l, _hTD_h, _hμD_l, hβ_all⟩
    let _ := hCont_Dr
    let P_Dr := G_Dr.sheafPushforwardContinuous AddCommGrpCat.{u} J_D J_D
    let adj_D := CategoryTheory.constantSheafAdj J_D AddCommGrpCat.{u} hT_D
    let αℤ : Quiver.Hom Fℤ_D (P_Dr.obj Fℤ_D) :=
      (adj_D.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P_Dr.obj Fℤ_D)).symm
        (CategoryTheory.CategoryStruct.comp
          (adj_D.unit.app (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Fℤ_D.obj.map (Opposite.op μ_D)))
    intro q m x
    obtain ⟨β_m, hβ_m_triv, hα_m⟩ := hβ_all m
    obtain ⟨β_m1, hβ_m1_triv, hα_m1⟩ := hβ_all (m + 1)
    have hβ_comm : CategoryTheory.CategoryStruct.comp (P_Dr.map (τ_𝒦 m)) β_m =
        CategoryTheory.CategoryStruct.comp β_m1 (τ_𝒦 m) := by
      apply sheaf_hom_ext_triv
      intro W sec y
      let h_W := (Fgt.obj W).hom
      let h_GW := (Fgt.obj (G_Dr.obj W)).hom
      have hL : (Fgt.obj (G_Dr.obj W)).left = (Fgt.obj W).left := (hG_obj W).1
      let e_L : (Fgt.obj W).left ⟶ (Fgt.obj (G_Dr.obj W)).left :=
        CategoryTheory.eqToHom hL.symm
      have he_hom : CategoryTheory.CategoryStruct.comp e_L h_GW =
          CategoryTheory.CategoryStruct.comp h_W g_D_r :=
        heq_hom hL h_GW (CategoryTheory.CategoryStruct.comp h_W g_D_r) (hG_obj W).2
      have hw_comm : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h_W ι_bar) e_L)
            h_GW =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_bar) α_σ)
            ι_bar := by
        rw [CategoryTheory.Category.assoc, he_hom, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, ← hα_ι,
          ← CategoryTheory.Category.assoc]
      let w_V : CategoryTheory.Limits.pullback h_W ι_bar ⟶
          CategoryTheory.Limits.pullback h_GW ι_bar :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h_W ι_bar) e_L)
          (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_bar) α_σ)
          hw_comm
      have hw_fst : HEq (CategoryTheory.CategoryStruct.comp w_V
          (CategoryTheory.Limits.pullback.fst h_GW ι_bar))
          (CategoryTheory.Limits.pullback.fst h_W ι_bar) := by
        rw [CategoryTheory.Limits.pullback.lift_fst]
        exact heq_post_self hL (CategoryTheory.Limits.pullback.fst h_W ι_bar)
      have hw_snd : CategoryTheory.CategoryStruct.comp w_V
          (CategoryTheory.Limits.pullback.snd h_GW ι_bar) =
          CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_bar) α_σ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hLHS : triv_K m W
          (((CategoryTheory.CategoryStruct.comp (P_Dr.map (τ_𝒦 m)) β_m).hom.app
            (Opposite.op W)) sec) y =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
            (triv_K (m + 1) (G_Dr.obj W) sec (w_V.base y)) := by
        change triv_K m W
            ((β_m.hom.app (Opposite.op W))
              (((τ_𝒦 m).hom.app (Opposite.op (G_Dr.obj W))) sec)) y = _
        rw [hβ_m_triv W (((τ_𝒦 m).hom.app (Opposite.op (G_Dr.obj W))) sec) w_V hw_fst hw_snd,
          ((htriv_K m).2 (G_Dr.obj W)).2.2 sec (w_V.base y)]
      have hRHS : triv_K m W
          (((CategoryTheory.CategoryStruct.comp β_m1 (τ_𝒦 m)).hom.app
            (Opposite.op W)) sec) y =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
            (triv_K (m + 1) (G_Dr.obj W) sec (w_V.base y)) := by
        change triv_K m W
            (((τ_𝒦 m).hom.app (Opposite.op W))
              ((β_m1.hom.app (Opposite.op W)) sec)) y = _
        rw [((htriv_K m).2 W).2.2 ((β_m1.hom.app (Opposite.op W)) sec) y,
          hβ_m1_triv W sec w_V hw_fst hw_snd]
      exact hLHS.trans hRHS.symm
    let _ := hAdd_P
    let _ := hLim_P
    let _ := hColim_P
    rw [hα_m1 q x, hα_m q (τ_H q m x)]
    exact hExtActNat P_Dr Fℤ_D αℤ (τ_𝒦 m) β_m1 β_m hβ_comm q x

  
  have hPrime : Nat.Prime ℓ := Fact.out
  have hNe : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hPrime.ne_zero⟩

  have htriv_res : ∀ (m : ℕ) {W₁ W₂ : D_bar.Etale} (u : W₁ ⟶ W₂)
      (sec : ↑((𝒦 m).obj.obj (Opposite.op W₂)))
      (y₁ : ↥(CategoryTheory.Limits.pullback (Fgt.obj W₁).hom ι_bar)),
      let h₁ := (Fgt.obj W₁).hom
      let h₂ := (Fgt.obj W₂).hom
      let u_V := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h₁ ι_bar)
          (Fgt.map u).left)
        (CategoryTheory.Limits.pullback.snd h₁ ι_bar)
        (by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w (Fgt.map u)]
          exact CategoryTheory.Limits.pullback.condition)
      triv_K m W₁ (((𝒦 m).obj.map (Opposite.op u)) sec) y₁ =
        triv_K m W₂ sec (u_V.base y₁) := by
    intro m W₁ W₂ u sec y₁
    exact (htriv_K m).1 u _ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) sec y₁

  have htriv_nsmul : ∀ {ℱ : 𝒜} {m : ℕ} (n : ℕ) (f : ℱ ⟶ 𝒦 m) (W : D_bar.Etale)
      (sec : ↑(ℱ.obj.obj (Opposite.op W)))
      (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)),
      triv_K m W (((n • f).hom.app (Opposite.op W)) sec) y =
        n • triv_K m W ((f.hom.app (Opposite.op W)) sec) y := by
    intro ℱ m n f W sec y
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      change triv_K m W 0 y = 0
      rw [map_zero]
      rfl
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul]
      change triv_K m W (((n • f).hom.app (Opposite.op W)) sec +
          (f.hom.app (Opposite.op W)) sec) y = _
      rw [map_add, LocallyConstant.coe_add, Pi.add_apply, ih]

  have mem_range_of_map_zero : ∀ (m₁ m₂ : ℕ) (W : D_bar.Etale)
      (sec : ↑((𝒦 m₁).obj.obj (Opposite.op W)))
      (φ : ZMod (ℓ ^ (m₁ + 1)) → ZMod (ℓ ^ (m₂ + 1))),
      φ 0 = 0 →
      LocallyConstant.map φ (triv_K m₁ W sec) ∈ Set.range (triv_K m₂ W) := by
    intro m₁ m₂ W sec φ hφ0
    have hmem₁ : triv_K m₁ W sec ∈ Set.range (triv_K m₁ W) := ⟨sec, rfl⟩
    rw [((htriv_K m₁).2 W).2.1] at hmem₁
    rcases hmem₁ with ⟨W₀, hcov, hvan⟩
    rw [((htriv_K m₂).2 W).2.1]
    refine ⟨W₀, hcov, fun y hy => ?_⟩
    change φ (triv_K m₁ W sec y) = 0
    rw [hvan y hy, hφ0]

  let mkMap : ∀ (m₁ m₂ : ℕ),
      (ZMod (ℓ ^ (m₁ + 1)) →+ ZMod (ℓ ^ (m₂ + 1))) → (𝒦 m₁ ⟶ 𝒦 m₂) :=
    fun m₁ m₂ φ =>
      let mkFun : ∀ (W : D_bar.Etale),
          ↑((𝒦 m₁).obj.obj (Opposite.op W)) → ↑((𝒦 m₂).obj.obj (Opposite.op W)) :=
        fun W sec => Classical.choose (mem_range_of_map_zero m₁ m₂ W sec φ φ.map_zero)
      have hmkFun : ∀ (W : D_bar.Etale) (sec : ↑((𝒦 m₁).obj.obj (Opposite.op W)))
          (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)),
          triv_K m₂ W (mkFun W sec) y = φ (triv_K m₁ W sec y) := by
        intro W sec y
        have hspec := Classical.choose_spec (mem_range_of_map_zero m₁ m₂ W sec φ φ.map_zero)
        exact DFunLike.congr_fun hspec y
      let mkApp : ∀ (W : D_bar.Etale),
          (𝒦 m₁).obj.obj (Opposite.op W) ⟶ (𝒦 m₂).obj.obj (Opposite.op W) :=
        fun W => AddCommGrpCat.ofHom
          { toFun := mkFun W
            map_zero' := by
              apply ((htriv_K m₂).2 W).1
              ext y
              rw [hmkFun W 0 y, map_zero, map_zero]
              change φ 0 = 0
              exact φ.map_zero
            map_add' := by
              intro s₁ s₂
              apply ((htriv_K m₂).2 W).1
              ext y
              rw [hmkFun W (s₁ + s₂) y, map_add, map_add, LocallyConstant.coe_add,
                LocallyConstant.coe_add, Pi.add_apply, Pi.add_apply, map_add,
                hmkFun W s₁ y, hmkFun W s₂ y] }
      CategoryTheory.ObjectProperty.homMk
        { app := fun W_op => mkApp W_op.unop
          naturality := by
            intro W₂_op W₁_op u_op
            ext sec
            apply ((htriv_K m₂).2 W₁_op.unop).1
            ext y₁
            change triv_K m₂ W₁_op.unop
                (mkFun W₁_op.unop (((𝒦 m₁).obj.map (Opposite.op u_op.unop)) sec)) y₁ =
              triv_K m₂ W₁_op.unop
                (((𝒦 m₂).obj.map (Opposite.op u_op.unop)) (mkFun W₂_op.unop sec)) y₁
            rw [hmkFun W₁_op.unop _ y₁,
              htriv_res m₁ u_op.unop sec y₁,
              htriv_res m₂ u_op.unop (mkFun W₂_op.unop sec) y₁,
              hmkFun W₂_op.unop sec _] }

  have hmkMap_triv : ∀ (m₁ m₂ : ℕ) (φ : ZMod (ℓ ^ (m₁ + 1)) →+ ZMod (ℓ ^ (m₂ + 1)))
      (W : D_bar.Etale) (sec : ↑((𝒦 m₁).obj.obj (Opposite.op W)))
      (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)),
      triv_K m₂ W (((mkMap m₁ m₂ φ).hom.app (Opposite.op W)) sec) y =
        φ (triv_K m₁ W sec y) := by
    intro m₁ m₂ φ W sec y
    have hspec := Classical.choose_spec (mem_range_of_map_zero m₁ m₂ W sec φ φ.map_zero)
    exact DFunLike.congr_fun hspec y

  have shortExact_of_objectwise : ∀ {ℱ₁ ℱ₂ ℱ₃ : 𝒜} (f : ℱ₁ ⟶ ℱ₂) (g : ℱ₂ ⟶ ℱ₃)
      (h0 : CategoryTheory.CategoryStruct.comp f g = 0),
      (∀ W : D_bar.Etale, Function.Injective (f.hom.app (Opposite.op W))) →
      (∀ (W : D_bar.Etale) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))),
        (g.hom.app (Opposite.op W)) s₂ = 0 →
        ∃ s₁ : ↑(ℱ₁.obj.obj (Opposite.op W)), (f.hom.app (Opposite.op W)) s₁ = s₂) →
      (∀ (W : D_bar.Etale) (s₃ : ↑(ℱ₃.obj.obj (Opposite.op W))),
        ∃ s₂ : ↑(ℱ₂.obj.obj (Opposite.op W)), (g.hom.app (Opposite.op W)) s₂ = s₃) →
      (CategoryTheory.ShortComplex.mk f g h0).ShortExact := by
    intro ℱ₁ ℱ₂ ℱ₃ f g h0 hinj hker hsurj
    have hEpi : CategoryTheory.Epi g := ⟨by
      intro Z m₁ m₂ hm
      apply CategoryTheory.Sheaf.hom_ext
      ext W_op s₃
      obtain ⟨s₂, rfl⟩ := hsurj W_op.unop s₃
      exact DFunLike.congr_fun (congrArg (fun h : ℱ₂ ⟶ Z => (h.hom.app W_op).hom) hm) s₂⟩
    have hIsLim : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι f h0) := by
      refine CategoryTheory.Limits.KernelFork.IsLimit.ofι f h0
        (fun {Z} k hk => ?_) (fun {Z} k hk => ?_) (fun {Z} k hk m hm => ?_)
      · have hkg : ∀ (W : D_bar.Etale) (z : ↑(Z.obj.obj (Opposite.op W))),
            ∃ s₁ : ↑(ℱ₁.obj.obj (Opposite.op W)),
              (f.hom.app (Opposite.op W)) s₁ = (k.hom.app (Opposite.op W)) z := by
          intro W z
          apply hker W ((k.hom.app (Opposite.op W)) z)
          have hcomp0 : ((CategoryTheory.CategoryStruct.comp k g).hom.app (Opposite.op W)) z = 0 := by
            rw [hk]
            rfl
          exact hcomp0
        refine CategoryTheory.ObjectProperty.homMk
          { app := fun W_op => AddCommGrpCat.ofHom
              { toFun := fun z => Classical.choose (hkg W_op.unop z)
                map_zero' := by
                  apply hinj W_op.unop
                  rw [Classical.choose_spec (hkg W_op.unop 0), map_zero, map_zero]
                map_add' := by
                  intro z₁ z₂
                  apply hinj W_op.unop
                  rw [Classical.choose_spec (hkg W_op.unop (z₁ + z₂)), map_add, map_add,
                    Classical.choose_spec (hkg W_op.unop z₁),
                    Classical.choose_spec (hkg W_op.unop z₂)] }
            naturality := by
              intro W₂_op W₁_op u_op
              ext z
              apply hinj W₁_op.unop
              have hnat_f := congrArg (fun h => h (Classical.choose (hkg W₂_op.unop z)))
                (f.hom.naturality u_op)
              have hnat_k := congrArg (fun h => h z) (k.hom.naturality u_op)
              dsimp at hnat_f hnat_k ⊢
              rw [Classical.choose_spec (hkg W₁_op.unop ((Z.obj.map u_op) z))]
              exact hnat_k.trans
                ((congrArg (ℱ₂.obj.map u_op)
                  (Classical.choose_spec (hkg W₂_op.unop z))).symm.trans hnat_f.symm) }
      · apply CategoryTheory.Sheaf.hom_ext
        ext W_op z
        exact Classical.choose_spec
          (hker W_op.unop ((k.hom.app W_op) z) (by
            have hcomp0 : ((CategoryTheory.CategoryStruct.comp k g).hom.app W_op) z = 0 := by
              rw [hk]
              rfl
            exact hcomp0))
      · apply CategoryTheory.Sheaf.hom_ext
        ext W_op z
        apply hinj W_op.unop
        have hm_z : (f.hom.app W_op) ((m.hom.app W_op) z) = (k.hom.app W_op) z := by
          rw [← hm]
          rfl
        exact hm_z.trans (Classical.choose_spec
          (hker W_op.unop ((k.hom.app W_op) z) (by
            have hcomp0 : ((CategoryTheory.CategoryStruct.comp k g).hom.app W_op) z = 0 := by
              rw [hk]
              rfl
            exact hcomp0))).symm
    obtain ⟨hExact, hMono⟩ :=
      (CategoryTheory.ShortComplex.exact_and_mono_f_iff_f_is_kernel
        (CategoryTheory.ShortComplex.mk f g h0)).mpr ⟨hIsLim⟩
    exact CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi

  
  have hTor_sh : ∀ m : ℕ, (ℓ ^ (m + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒦 m) = 0 := by
    intro m
    apply sheaf_hom_ext_triv
    intro W sec y
    rw [htriv_nsmul (ℓ ^ (m + 1)) (CategoryTheory.CategoryStruct.id (𝒦 m)) W sec y]
    change (ℓ ^ (m + 1) : ℕ) • triv_K m W sec y = triv_K m W 0 y
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul, map_zero]
    rfl

  let τ_le_K : ∀ (a b : ℕ), a ≤ b → (𝒦 b ⟶ 𝒦 a) :=
    fun a _ h =>
      Nat.leRec (CategoryTheory.CategoryStruct.id (𝒦 a))
        (fun ⦃k⦄ _ ih => CategoryTheory.CategoryStruct.comp (τ_𝒦 k) ih) h

  have hsh_refl : ∀ a : ℕ, τ_le_K a a (le_refl a) = CategoryTheory.CategoryStruct.id (𝒦 a) := by
    intro a
    exact Nat.leRec_self _ _

  have hsh_step : ∀ (a b : ℕ) (h₁ : a ≤ b) (h₂ : a ≤ b + 1),
      τ_le_K a (b + 1) h₂ = CategoryTheory.CategoryStruct.comp (τ_𝒦 b) (τ_le_K a b h₁) := by
    intro a b h₁ h₂
    exact Nat.leRec_succ _ _ h₁

  have hτ_le_triv : ∀ (a b : ℕ) (h : a ≤ b) (W : D_bar.Etale)
      (sec : ↑((𝒦 b).obj.obj (Opposite.op W)))
      (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)),
      triv_K a W (((τ_le_K a b h).hom.app (Opposite.op W)) sec) y =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right h 1)) (ZMod (ℓ ^ (a + 1)))
          (triv_K b W sec y) := by
    intro a b h
    induction h with
    | refl =>
      intro W sec y
      rw [hsh_refl a, ZMod.castHom_self]
      rfl
    | @step k hk ih =>
      intro W sec y
      change triv_K a W (((τ_le_K a (k + 1) (Nat.le.step hk)).hom.app (Opposite.op W)) sec) y =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right (Nat.le.step hk) 1))
          (ZMod (ℓ ^ (a + 1))) (triv_K (k + 1) W sec y)
      rw [hsh_step a k hk (Nat.le.step hk)]
      change triv_K a W
          (((τ_le_K a k hk).hom.app (Opposite.op W))
            (((τ_𝒦 k).hom.app (Opposite.op W)) sec)) y = _
      rw [ih W _ y, ((htriv_K k).2 W).2.2 sec y]
      exact (RingHom.comp_apply _ _ _).symm.trans
        (RingHom.congr_fun (ZMod.castHom_comp _ _) _)

  have hτ_le_trans : ∀ (a b c : ℕ) (h₁ : a ≤ b) (h₂ : b ≤ c) (h₃ : a ≤ c),
      CategoryTheory.CategoryStruct.comp (τ_le_K b c h₂) (τ_le_K a b h₁) = τ_le_K a c h₃ := by
    intro a b c h₁ h₂ h₃
    apply sheaf_hom_ext_triv
    intro W sec y
    change triv_K a W
        (((τ_le_K a b h₁).hom.app (Opposite.op W))
          (((τ_le_K b c h₂).hom.app (Opposite.op W)) sec)) y = _
    rw [hτ_le_triv a b h₁ W _ y, hτ_le_triv b c h₂ W sec y, hτ_le_triv a c h₃ W sec y]
    exact (RingHom.comp_apply _ _ _).symm.trans
      (RingHom.congr_fun (ZMod.castHom_comp _ _) _)

  have h_pow : ∀ a b : ℕ, ℓ ^ (b + 1) * ℓ ^ (a + 1) = ℓ ^ (a + b + 1 + 1) := by
    intro a b
    rw [← pow_add]
    exact congrArg (ℓ ^ ·) (by omega)

  let emb : ∀ a b : ℕ, ZMod (ℓ ^ (a + 1)) →+ ZMod (ℓ ^ (a + b + 1 + 1)) :=
    fun a b =>
      { toFun := fun z => ((ℓ ^ (b + 1) * z.val : ℕ) : ZMod (ℓ ^ (a + b + 1 + 1)))
        map_zero' := by rw [ZMod.val_zero, mul_zero, Nat.cast_zero]
        map_add' := by
          intro z₁ z₂
          let _ := hNe (a + 1)
          have hdiv := Nat.mod_add_div (z₁.val + z₂.val) (ℓ ^ (a + 1))
          rw [← ZMod.val_add z₁ z₂] at hdiv
          have hmul : ℓ ^ (b + 1) * (z₁.val + z₂.val) =
              ℓ ^ (b + 1) * (z₁ + z₂).val +
                ℓ ^ (a + b + 1 + 1) * ((z₁.val + z₂.val) / ℓ ^ (a + 1)) := by
            calc
              ℓ ^ (b + 1) * (z₁.val + z₂.val) =
                  ℓ ^ (b + 1) * ((z₁ + z₂).val +
                    ℓ ^ (a + 1) * ((z₁.val + z₂.val) / ℓ ^ (a + 1))) := by
                rw [hdiv]
              _ = ℓ ^ (b + 1) * (z₁ + z₂).val +
                    (ℓ ^ (b + 1) * ℓ ^ (a + 1)) * ((z₁.val + z₂.val) / ℓ ^ (a + 1)) := by
                ring
              _ = _ := by rw [h_pow a b]
          have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (a + b + 1 + 1)))) hmul
          rw [mul_add, Nat.cast_add, Nat.cast_add, Nat.cast_mul (ℓ ^ (a + b + 1 + 1)),
            ZMod.natCast_self, zero_mul, add_zero] at hcast
          exact hcast.symm }

  have hemb_inj : ∀ a b : ℕ, Function.Injective (emb a b) := by
    intro a b z₁ z₂ hz
    let _ := hNe (a + 1)
    have hd : emb a b (z₁ - z₂) = 0 := by rw [map_sub, hz, sub_self]
    change ((ℓ ^ (b + 1) * (z₁ - z₂).val : ℕ) : ZMod (ℓ ^ (a + b + 1 + 1))) = 0 at hd
    rw [ZMod.natCast_eq_zero_iff, ← h_pow a b] at hd
    have hdvd : ℓ ^ (a + 1) ∣ (z₁ - z₂).val :=
      (Nat.mul_dvd_mul_iff_left (pow_pos hPrime.pos (b + 1))).mp hd
    have hval0 : (z₁ - z₂).val = 0 :=
      Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt (z₁ - z₂))
    exact sub_eq_zero.mp (ZMod.val_injective _ (hval0.trans ZMod.val_zero.symm))

  let ι_bock_K : ∀ a b : ℕ, 𝒦 a ⟶ 𝒦 (a + b + 1) :=
    fun a b => mkMap a (a + b + 1) (emb a b)

  have h0_sh : ∀ a b : ℕ,
      CategoryTheory.CategoryStruct.comp (ι_bock_K a b)
        (τ_le_K b (a + b + 1) (by omega)) = 0 := by
    intro a b
    apply sheaf_hom_ext_triv
    intro W sec y
    change triv_K b W
        (((τ_le_K b (a + b + 1) (by omega)).hom.app (Opposite.op W))
          (((ι_bock_K a b).hom.app (Opposite.op W)) sec)) y = triv_K b W 0 y
    rw [hτ_le_triv b (a + b + 1) (by omega) W _ y,
      hmkMap_triv a (a + b + 1) (emb a b) W sec y, map_zero]
    change ZMod.castHom _ (ZMod (ℓ ^ (b + 1)))
        ((ℓ ^ (b + 1) * (triv_K a W sec y).val : ℕ) : ZMod (ℓ ^ (a + b + 1 + 1))) = 0
    rw [map_natCast, Nat.cast_mul, ZMod.natCast_self, zero_mul]

  have hComp_sh : ∀ a b : ℕ,
      CategoryTheory.CategoryStruct.comp (ι_bock_K a b)
        (τ_le_K a (a + b + 1) (by omega)) =
        (ℓ ^ (b + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒦 a) := by
    intro a b
    let _ := hNe (a + 1)
    apply sheaf_hom_ext_triv
    intro W sec y
    rw [htriv_nsmul (ℓ ^ (b + 1)) (CategoryTheory.CategoryStruct.id (𝒦 a)) W sec y]
    change triv_K a W
        (((τ_le_K a (a + b + 1) (by omega)).hom.app (Opposite.op W))
          (((ι_bock_K a b).hom.app (Opposite.op W)) sec)) y =
      (ℓ ^ (b + 1) : ℕ) • triv_K a W sec y
    rw [hτ_le_triv a (a + b + 1) (by omega) W _ y,
      hmkMap_triv a (a + b + 1) (emb a b) W sec y]
    change ZMod.castHom _ (ZMod (ℓ ^ (a + 1)))
        ((ℓ ^ (b + 1) * (triv_K a W sec y).val : ℕ) : ZMod (ℓ ^ (a + b + 1 + 1))) = _
    rw [map_natCast, Nat.cast_mul, nsmul_eq_mul, ZMod.natCast_zmod_val]

  have hComm_sh : ∀ a b : ℕ,
      CategoryTheory.CategoryStruct.comp (τ_𝒦 a) (ι_bock_K a b) =
        CategoryTheory.CategoryStruct.comp (ι_bock_K (a + 1) b)
          (τ_le_K (a + b + 1) (a + 1 + b + 1) (by omega)) := by
    intro a b
    let _ := hNe (a + 1)
    let _ := hNe (a + 1 + 1)
    apply sheaf_hom_ext_triv
    intro W sec y
    change triv_K (a + b + 1) W
        (((ι_bock_K a b).hom.app (Opposite.op W))
          (((τ_𝒦 a).hom.app (Opposite.op W)) sec)) y =
      triv_K (a + b + 1) W
        (((τ_le_K (a + b + 1) (a + 1 + b + 1) (by omega)).hom.app (Opposite.op W))
          (((ι_bock_K (a + 1) b).hom.app (Opposite.op W)) sec)) y
    rw [hmkMap_triv a (a + b + 1) (emb a b) W _ y,
      ((htriv_K a).2 W).2.2 sec y,
      hτ_le_triv (a + b + 1) (a + 1 + b + 1) (by omega) W _ y,
      hmkMap_triv (a + 1) (a + 1 + b + 1) (emb (a + 1) b) W sec y]
    set w := triv_K (a + 1) W sec y
    set c := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (a + 1))) (ZMod (ℓ ^ (a + 1))) w
    have hc_eq : c = (w.val : ZMod (ℓ ^ (a + 1))) := by
      change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (a + 1))) (ZMod (ℓ ^ (a + 1))) w = _
      conv_lhs => rw [← ZMod.natCast_zmod_val w]
      rw [map_natCast]
    have hc_val : c.val = w.val % ℓ ^ (a + 1) := by
      rw [hc_eq, ZMod.val_natCast]
    have hdiv := Nat.mod_add_div w.val (ℓ ^ (a + 1))
    rw [← hc_val] at hdiv
    have hmul : ℓ ^ (b + 1) * w.val =
        ℓ ^ (b + 1) * c.val + ℓ ^ (a + b + 1 + 1) * (w.val / ℓ ^ (a + 1)) := by
      calc
        ℓ ^ (b + 1) * w.val = ℓ ^ (b + 1) * (c.val + ℓ ^ (a + 1) * (w.val / ℓ ^ (a + 1))) := by
          rw [hdiv]
        _ = ℓ ^ (b + 1) * c.val + (ℓ ^ (b + 1) * ℓ ^ (a + 1)) * (w.val / ℓ ^ (a + 1)) := by
          ring
        _ = _ := by rw [h_pow a b]
    change ((ℓ ^ (b + 1) * c.val : ℕ) : ZMod (ℓ ^ (a + b + 1 + 1))) =
      ZMod.castHom _ (ZMod (ℓ ^ (a + b + 1 + 1)))
        ((ℓ ^ (b + 1) * w.val : ℕ) : ZMod (ℓ ^ (a + 1 + b + 1 + 1)))
    rw [map_natCast, hmul, Nat.cast_add, Nat.cast_mul (ℓ ^ (a + b + 1 + 1)),
      ZMod.natCast_self, zero_mul, add_zero]

  have hSE_sh : ∀ a b : ℕ,
      (CategoryTheory.ShortComplex.mk (ι_bock_K a b)
        (τ_le_K b (a + b + 1) (by omega)) (h0_sh a b)).ShortExact := by
    intro a b
    let _ := hNe (a + 1)
    let _ := hNe (b + 1)
    let _ := hNe (a + b + 1 + 1)
    apply shortExact_of_objectwise (ι_bock_K a b) (τ_le_K b (a + b + 1) (by omega)) (h0_sh a b)
    · intro W s₁ s₂ hs
      apply ((htriv_K a).2 W).1
      ext y
      apply hemb_inj a b
      have hy := DFunLike.congr_fun (congrArg (triv_K (a + b + 1) W) hs) y
      rwa [hmkMap_triv a (a + b + 1) (emb a b) W s₁ y,
        hmkMap_triv a (a + b + 1) (emb a b) W s₂ y] at hy
    · intro W s₂ hs₂
      let divFun : ZMod (ℓ ^ (a + b + 1 + 1)) → ZMod (ℓ ^ (a + 1)) :=
        fun w => ((w.val / ℓ ^ (b + 1) : ℕ) : ZMod (ℓ ^ (a + 1)))
      have hdiv0 : divFun 0 = 0 := by
        dsimp [divFun]
        rw [ZMod.val_zero, Nat.zero_div, Nat.cast_zero]
      have hmem := mem_range_of_map_zero (a + b + 1) a W s₂ divFun hdiv0
      refine ⟨Classical.choose hmem, ?_⟩
      apply ((htriv_K (a + b + 1)).2 W).1
      ext y
      rw [hmkMap_triv a (a + b + 1) (emb a b) W _ y,
        DFunLike.congr_fun (Classical.choose_spec hmem) y]
      set w := triv_K (a + b + 1) W s₂ y
      have hw_cast : ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right (by omega : b ≤ a + b + 1) 1))
          (ZMod (ℓ ^ (b + 1))) w = 0 := by
        rw [← hτ_le_triv b (a + b + 1) (by omega) W s₂ y, hs₂, map_zero]
        rfl
      have hw_nat : ((w.val : ℕ) : ZMod (ℓ ^ (b + 1))) = 0 := by
        rw [← map_natCast (ZMod.castHom
          (pow_dvd_pow ℓ (Nat.add_le_add_right (by omega : b ≤ a + b + 1) 1)) (ZMod (ℓ ^ (b + 1))))
          w.val, ZMod.natCast_zmod_val w]
        exact hw_cast
      have hdvd : ℓ ^ (b + 1) ∣ w.val := (ZMod.natCast_eq_zero_iff w.val (ℓ ^ (b + 1))).mp hw_nat
      have hmul_q : ℓ ^ (b + 1) * (w.val / ℓ ^ (b + 1)) = w.val := Nat.mul_div_cancel' hdvd
      have hlt_q : w.val / ℓ ^ (b + 1) < ℓ ^ (a + 1) := by
        have hw_lt : w.val < ℓ ^ (b + 1) * ℓ ^ (a + 1) := by
          rw [h_pow a b]
          exact ZMod.val_lt w
        rw [← hmul_q] at hw_lt
        exact Nat.lt_of_mul_lt_mul_left hw_lt
      change ((ℓ ^ (b + 1) * ((w.val / ℓ ^ (b + 1) : ℕ) : ZMod (ℓ ^ (a + 1))).val : ℕ) :
          ZMod (ℓ ^ (a + b + 1 + 1))) = w
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt hlt_q, hmul_q, ZMod.natCast_zmod_val]
    · intro W s₃
      let liftFun : ZMod (ℓ ^ (b + 1)) → ZMod (ℓ ^ (a + b + 1 + 1)) :=
        fun z => ((z.val : ℕ) : ZMod (ℓ ^ (a + b + 1 + 1)))
      have hlift0 : liftFun 0 = 0 := by
        dsimp [liftFun]
        rw [ZMod.val_zero, Nat.cast_zero]
      have hmem := mem_range_of_map_zero b (a + b + 1) W s₃ liftFun hlift0
      refine ⟨Classical.choose hmem, ?_⟩
      apply ((htriv_K b).2 W).1
      ext y
      rw [hτ_le_triv b (a + b + 1) (by omega) W _ y,
        DFunLike.congr_fun (Classical.choose_spec hmem) y]
      set z := triv_K b W s₃ y
      change ZMod.castHom _ (ZMod (ℓ ^ (b + 1)))
          ((z.val : ℕ) : ZMod (ℓ ^ (a + b + 1 + 1))) = z
      rw [map_natCast, ZMod.natCast_zmod_val]

  
  obtain ⟨hAnn_K, τ_le_H, ι_bock_H, δ_bock_H,
      hLaw1, hLaw2, hLaw3, hLaw4, hLaw5, hLaw6, hLaw7⟩ :=
    hExtBock Fℤ_D 𝒦 τ_𝒦 τ_le_K ι_bock_K h0_sh hSE_sh hTor_sh hsh_refl
      (fun a b h => hsh_step a b h (Nat.le_succ_of_le h))
      hτ_le_trans hComp_sh hComm_sh
  exact ⟨hAnn_K, τ_H, τ_le_H, ι_bock_H, δ_bock_H,
    fun _ _ => rfl, hLaw1, hLaw2, hLaw3, hLaw4, hLaw5, hLaw6, hLaw7, hLaw8⟩

theorem weil_etale_epi_pushforward_ext_equiv_and_gauge : (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (ℓ r q : ℕ)
      (p_up : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) q →+ weilEtaleTorsionH W₁ (ℓ ^ (r + 1)) q)
      (p_dn : weilEtaleTorsionH W₂ (ℓ ^ r) q →+ weilEtaleTorsionH W₁ (ℓ ^ r) q),
      WeilLefschetzTorsionPullback h (ℓ ^ (r + 1)) q p_up →
      WeilLefschetzTorsionPullback h (ℓ ^ r) q p_dn →
      ∀ x : weilEtaleTorsionH W₂ (ℓ ^ (r + 1)) q,
        weilEtaleTorsionTransition W₁ ℓ r q (p_up x) =
          p_dn (weilEtaleTorsionTransition W₂ ℓ r q x)) ∧
    (∀ {X : AlgebraicGeometry.Scheme.{u}} (α_X : CategoryTheory.Iso X X),
      let G_X := weilAffGeomPbcSliceMap (inferInstance : AlgebraicGeometry.Etale α_X.hom)
      ∃ (hCont_X : G_X.IsContinuous X.smallEtaleTopology X.smallEtaleTopology),
        letI := hCont_X
        let P_X := G_X.sheafPushforwardContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology X.smallEtaleTopology
        ∃ (hAdd_X : P_X.Additive)
          (hLim_X : CategoryTheory.Limits.PreservesFiniteLimits P_X)
          (hColim_X : CategoryTheory.Limits.PreservesFiniteColimits P_X),
          let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
          let Fℤ_X := C_X.obj (AddCommGrpCat.of (ULift.{u} ℤ))
          let T_X := weilEtaleIdTerminal.{u} X
          let hT_X := weilEtaleIdTerminalIsTerminal.{u} X
          let adj_X := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X
          let μ_X : Quiver.Hom (G_X.obj T_X) T_X := hT_X.from (G_X.obj T_X)
          let αℤ_X : Quiver.Hom Fℤ_X (P_X.obj Fℤ_X) :=
            (adj_X.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P_X.obj Fℤ_X)).symm
              (CategoryTheory.CategoryStruct.comp
                (adj_X.unit.app (AddCommGrpCat.of (ULift.{u} ℤ)))
                (Fℤ_X.obj.map (Opposite.op μ_X)))
          ∀ (n : ℕ),
            let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
            let L_X := weilEtaleTorsionSheaf X n
