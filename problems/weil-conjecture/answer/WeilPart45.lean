      have hsum_zero : ∑ k ∈ Finset.range s,
          LinearMap.trace L ↥(T.maxGenEigenspace μ)
            (ν ^ (k + 1) * (μ • id_μ) ^ (s - (k + 1)) * ↑(s.choose (k + 1))) = 0 := by
        refine Finset.sum_eq_zero fun k _ => ?_
        set g_k : Module.End L ↥(T.maxGenEigenspace μ) :=
          (μ • id_μ) ^ (s - (k + 1)) * ↑(s.choose (k + 1))
        have hcomm_gk : Commute (ν ^ (k + 1)) g_k :=
          ((hComm.pow_left (k + 1)).pow_right (s - (k + 1))).mul_right
            (Nat.commute_cast (ν ^ (k + 1)) (s.choose (k + 1)))
        have hnil_prod : IsNilpotent (ν ^ (k + 1) * g_k) :=
          hcomm_gk.isNilpotent_mul_right (IsNilpotent.pow_succ k hNil)
        rw [mul_assoc]
        exact isNilpotent_iff_eq_zero.mp (LinearMap.isNilpotent_trace_of_isNilpotent hnil_prod)
      rw [hsum_zero, zero_add, pow_zero, one_mul, Nat.choose_zero_right, Nat.cast_one, mul_one]
      change LinearMap.trace L ↥(T.maxGenEigenspace μ)
        ((μ • (1 : Module.End L ↥(T.maxGenEigenspace μ))) ^ s) = _
      rw [smul_pow, one_pow, map_smul, LinearMap.trace_one, hrk μ, smul_eq_mul, nsmul_eq_mul,
        mul_comm]
    have hCompMat : ∀ (d : ℕ) (j : Fin (c d)),
        ∃ A_dj : Matrix (Fin M) (Fin M) ℚ,
          (∀ z : ℂ, z ∈ (A_dj.charpoly).aroots ℂ →
            z ≠ 0 ∧ ((Nat.card K₁ : ℂ) ^ ((2 * m + 1) * d)) / z ∈ (A_dj.charpoly).aroots ℂ) ∧
          ∀ s : ℕ,
            ((Matrix.trace (A_dj ^ s) : ℚ) : Padic ℓ) =
              Matrix.trace (((F_mat d (e_Good d j).1 (e_Good d j).2).map
                (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ s) := by
      intro d j
      obtain ⟨Q, hMon, hDeg, hChar, hRecip⟩ := hCheb d j
      let pb_Q : PowerBasis ℚ (AdjoinRoot Q) := AdjoinRoot.powerBasis hMon.ne_zero
      have hdim_Q : pb_Q.dim = M := (AdjoinRoot.powerBasis_dim hMon.ne_zero).trans hDeg
      let A_dj : Matrix (Fin M) (Fin M) ℚ :=
        Matrix.reindex (finCongr hdim_Q) (finCongr hdim_Q)
          (Algebra.leftMulMatrix pb_Q.basis pb_Q.gen)
      have hA_char : A_dj.charpoly = Q := by
        change ((Matrix.reindex (finCongr hdim_Q) (finCongr hdim_Q))
          (Algebra.leftMulMatrix pb_Q.basis pb_Q.gen)).charpoly = Q
        rw [Matrix.charpoly_reindex, charpoly_leftMulMatrix,
          AdjoinRoot.minpoly_powerBasis_gen hMon.ne_zero, hMon.leadingCoeff, inv_one, map_one,
          mul_one]
      refine ⟨A_dj, ?_, ?_⟩
      · rw [hA_char]
        exact hRecip
      · intro s
        let B_Q : Matrix (Fin M) (Fin M) (Padic ℓ) := A_dj.map (algebraMap ℚ (Padic ℓ))
        let B_F : Matrix (Fin M) (Fin M) (Padic ℓ) :=
          (F_mat d (e_Good d j).1 (e_Good d j).2).map (algebraMap (PadicInt ℓ) (Padic ℓ))
        have hcast_lhs : ((Matrix.trace (A_dj ^ s) : ℚ) : Padic ℓ) = Matrix.trace (B_Q ^ s) := by
          have h1 : ((Matrix.trace (A_dj ^ s) : ℚ) : Padic ℓ) =
              Matrix.trace ((A_dj ^ s).map (algebraMap ℚ (Padic ℓ))) := by
            simp only [Matrix.trace, Matrix.diag, Matrix.map_apply, Rat.cast_sum]
            rfl
          have h2 : (A_dj ^ s).map (algebraMap ℚ (Padic ℓ)) = B_Q ^ s :=
            (RingHom.mapMatrix (algebraMap ℚ (Padic ℓ))).map_pow A_dj s
          rw [h1, h2]
        rw [hcast_lhs]
        apply (algebraMap (Padic ℓ) L).injective
        have hL_tr : ∀ D : Matrix (Fin M) (Fin M) (Padic ℓ),
            algebraMap (Padic ℓ) L (Matrix.trace (D ^ s)) =
              ((D.map (algebraMap (Padic ℓ) L)).charpoly.roots.map (· ^ s)).sum := by
          intro D
          have htr1 : algebraMap (Padic ℓ) L (Matrix.trace (D ^ s)) =
              Matrix.trace ((D ^ s).map (algebraMap (Padic ℓ) L)) := by
            simp only [Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
          have htr2 : (D ^ s).map (algebraMap (Padic ℓ) L) =
              (D.map (algebraMap (Padic ℓ) L)) ^ s :=
            (RingHom.mapMatrix (algebraMap (Padic ℓ) L)).map_pow D s
          rw [htr1, htr2, h_mat_trace_algClosed]
        rw [hL_tr B_Q, hL_tr B_F, Matrix.charpoly_map, Matrix.charpoly_map, hA_char, hChar,
          ← Matrix.charpoly_map]
    let A : ∀ d : ℕ, Fin (c d) → Matrix (Fin M) (Fin M) ℚ :=
      fun d j => Classical.choose (hCompMat d j)
    have hA_recip : ∀ (d : ℕ) (j : Fin (c d)) (z : ℂ),
        z ∈ ((A d j).charpoly).aroots ℂ →
          z ≠ 0 ∧ ((Nat.card K₁ : ℂ) ^ ((2 * m + 1) * d)) / z ∈ ((A d j).charpoly).aroots ℂ :=
      fun d j => (Classical.choose_spec (hCompMat d j)).1
    have hA_trace : ∀ (d : ℕ) (j : Fin (c d)) (s : ℕ),
        ((Matrix.trace (A d j ^ s) : ℚ) : Padic ℓ) =
          Matrix.trace (((F_mat d (e_Good d j).1 (e_Good d j).2).map
            (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ s) :=
      fun d j => (Classical.choose_spec (hCompMat d j)).2
    refine ⟨hγ'_ne, M, c, A, hc0, hcd_le, hA_recip, ?_, ?_⟩
    · obtain ⟨V₁, hAdd₁, hMod₁, hFin₁_V, Φ₁, hγ_V₁, hγdual_V₁, hTr₁⟩ := hSys_V₁
      refine ⟨V₁, hAdd₁, hMod₁, hFin₁_V, Φ₁, hγ_V₁, hγdual_V₁, fun r_pow hr_pow => ?_⟩
      rw [← hTr₁ r_pow e_Good hr_pow hLinInv]
      push_cast
      refine Finset.sum_congr rfl fun d _ => ?_
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hA_trace d j (r_pow / d)]
    · intro k hk
      obtain ⟨V₂ₖ, hAdd₂ₖ, hMod₂ₖ, hFin₂ₖ_V, Φ₂ₖ, hTr₂ₖ⟩ := hSys_V₂ₖ k hk
      refine ⟨Module.finrank (Padic ℓ) ↥(WeilSymplecticTensorInvDual ℓ M k G_geom),
        V₂ₖ, hAdd₂ₖ, hMod₂ₖ, hFin₂ₖ_V, Φ₂ₖ, fun r_pow hr_pow => ?_⟩
      have hInv_k : ∀ φ ∈ WeilSymplecticTensorInvDual ℓ M k G_geom,
          φ.comp (PiTensorProduct.map (fun _ : Fin (2 * k) =>
            ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin)) =
            ((Nat.card K₁ : Padic ℓ) ^ (k * (2 * m + 1))) • φ := by
        intro φ hφ
        rw [hTensInv k hk φ hφ, ← pow_mul, mul_comm (2 * m + 1) k]
      rw [← hTr₂ₖ r_pow e_Good hr_pow hInv_k]
      push_cast
      refine Finset.sum_congr rfl fun d _ => ?_
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hA_trace d j (r_pow / d)]

theorem weil_projective_frob_eigenvalue_purity (K : Type u) [Finite K] [Field K]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Y.hom]
    [AlgebraicGeometry.IsProper Y.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom]
    (hProj : ∃ (N : ℕ) (ι : Y ⟶ weilProjectiveSpaceOver K N),
      AlgebraicGeometry.IsClosedImmersion ι.left)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (i : ℕ) (hi : i ≤ 2 * d)
    (M_Y : WeilEllAdicCohomologyModel K Y ℓ i)
    (γ : AlgebraicClosure (Padic ℓ))
    (hγ : γ ∈ ((M_Y.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    IsAlgebraic ℚ γ ∧
    ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ γ) = 0 → ‖β‖ = √(Nat.card K ^ i) :=
by
  let L := AlgebraicClosure (Padic ℓ)
  have hScaleCompNeZero : ∀ (p : Polynomial ℚ) (c : ℚ),
      p ≠ 0 → c ≠ 0 → p.comp (Polynomial.C c * Polynomial.X) ≠ 0 := by
    intro p c hp hc hzero
    have h1 : (p.comp (Polynomial.C c * Polynomial.X)).comp (Polynomial.C c⁻¹ * Polynomial.X) = p := by
      rw [Polynomial.comp_assoc]
      have h2 : (Polynomial.C c * Polynomial.X).comp (Polynomial.C c⁻¹ * Polynomial.X) = Polynomial.X := by
        rw [Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp, ← mul_assoc,
          ← Polynomial.C_mul, mul_inv_cancel₀ hc, Polynomial.C_1, one_mul]
      rw [h2, Polynomial.comp_X]
    rw [hzero, Polynomial.zero_comp] at h1
    exact hp h1.symm
  have hPowCompNeZero : ∀ (p : Polynomial ℚ) (n : ℕ),
      p ≠ 0 → 1 ≤ n → p.comp (Polynomial.X ^ n) ≠ 0 := by
    intro p n hp hn hzero
    have hdeg : (Polynomial.X ^ n : Polynomial ℚ).natDegree ≠ 0 := by
      rw [Polynomial.natDegree_X_pow]
      omega
    have hlc := Polynomial.leadingCoeff_comp (p := p) (q := (Polynomial.X ^ n : Polynomial ℚ)) hdeg
    rw [hzero, Polynomial.leadingCoeff_zero,
      (Polynomial.monic_X_pow (R := ℚ) n).leadingCoeff, one_pow, mul_one] at hlc
    exact hp (Polynomial.leadingCoeff_eq_zero.mp hlc.symm)
  
  have hDescent : ∀ (q r m : ℕ), 2 ≤ q → 1 ≤ r → ∀ (γ₀ : L),
      (γ₀ ^ r = ((q ^ r : ℕ) : L) ^ (m + 1) ∨
        (∃ α_H : L,
          (IsAlgebraic ℚ α_H ∧
            ∀ β_H : ℂ, Polynomial.aeval β_H (minpoly ℚ α_H) = 0 →
              ((q ^ r : ℕ) : ℝ) ^ (2 * m) ≤ ((q ^ r : ℕ) : ℝ) * ‖β_H‖ ^ 2 ∧
              ‖β_H‖ ^ 2 ≤ ((q ^ r : ℕ) : ℝ) ^ (2 * m + 1)) ∧
          γ₀ ^ r = ((q ^ r : ℕ) : L) * α_H) ∨
        (IsAlgebraic ℚ (γ₀ ^ r) ∧
          ∀ β' : ℂ, Polynomial.aeval β' (minpoly ℚ (γ₀ ^ r)) = 0 →
            ((q ^ r : ℕ) : ℝ) ^ (2 * m + 1) ≤ ‖β'‖ ^ 2 ∧
            ‖β'‖ ^ 2 ≤ ((q ^ r : ℕ) : ℝ) ^ (2 * m + 3))) →
      IsAlgebraic ℚ γ₀ ∧
      ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ γ₀) = 0 →
        (q : ℝ) ^ (2 * (m + 1)) ≤ (q : ℝ) * ‖β‖ ^ 2 ∧
        ‖β‖ ^ 2 ≤ (q : ℝ) ^ (2 * (m + 1) + 1) := by
    intro q r m hq hr γ₀ hDisj
    have hQ_ge_one : 1 ≤ q ^ r := Nat.one_le_pow r q (by omega)
    have hBranch3 : IsAlgebraic ℚ (γ₀ ^ r) ∧
        ∀ β' : ℂ, Polynomial.aeval β' (minpoly ℚ (γ₀ ^ r)) = 0 →
          ((q ^ r : ℕ) : ℝ) ^ (2 * m + 1) ≤ ‖β'‖ ^ 2 ∧
          ‖β'‖ ^ 2 ≤ ((q ^ r : ℕ) : ℝ) ^ (2 * m + 3) := by
      rcases hDisj with h1 | ⟨α_H, ⟨hAlgH, hNormH⟩, hEqH⟩ | h3
      · let N_val : ℕ := (q ^ r) ^ (m + 1)
        let P₁ : Polynomial ℚ := Polynomial.X - Polynomial.C (N_val : ℚ)
        have hP₁_ne : P₁ ≠ 0 := (Polynomial.monic_X_sub_C (N_val : ℚ)).ne_zero
        have hP₁_eval : Polynomial.aeval (γ₀ ^ r) P₁ = 0 := by
          dsimp [P₁, N_val]
          rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C, map_natCast, Nat.cast_pow, h1, sub_self]
        refine ⟨⟨P₁, hP₁_ne, hP₁_eval⟩, fun β' hβ' => ?_⟩
        rcases minpoly.dvd ℚ (γ₀ ^ r) hP₁_eval with ⟨S, hS⟩
        have hβ'_P₁ : Polynomial.aeval β' P₁ = 0 := by
          rw [hS, map_mul, hβ', zero_mul]
        have hβ'_eq : β' = (N_val : ℂ) := by
          dsimp [P₁] at hβ'_P₁
          rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C, map_natCast] at hβ'_P₁
          exact sub_eq_zero.mp hβ'_P₁
        have hnorm : ‖β'‖ ^ 2 = ((q ^ r : ℕ) : ℝ) ^ (2 * m + 2) := by
          rw [hβ'_eq, Complex.norm_natCast]
          dsimp [N_val]
          push_cast
          ring
        have hQ1 : (1 : ℝ) ≤ ((q ^ r : ℕ) : ℝ) := by exact_mod_cast hQ_ge_one
        rw [hnorm]
        exact ⟨pow_le_pow_right₀ hQ1 (by omega), pow_le_pow_right₀ hQ1 (by omega)⟩
      · let p_H : Polynomial ℚ := minpoly ℚ α_H
        have hpH_ne : p_H ≠ 0 := (minpoly.monic hAlgH.isIntegral).ne_zero
        have hQ_rat_ne : ((q ^ r : ℕ) : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
        let R : Polynomial ℚ := p_H.comp (Polynomial.C (((q ^ r : ℕ) : ℚ)⁻¹) * Polynomial.X)
        have hR_ne : R ≠ 0 :=
          hScaleCompNeZero p_H (((q ^ r : ℕ) : ℚ)⁻¹) hpH_ne (inv_ne_zero hQ_rat_ne)
        have hQ_L_ne : ((q ^ r : ℕ) : L) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
        have hR_eval : Polynomial.aeval (γ₀ ^ r) R = 0 := by
          dsimp [R]
          rw [Polynomial.aeval_comp, map_mul, Polynomial.aeval_C, Polynomial.aeval_X,
            map_inv₀, map_natCast, hEqH, inv_mul_cancel_left₀ hQ_L_ne]
          exact minpoly.aeval ℚ α_H
        refine ⟨⟨R, hR_ne, hR_eval⟩, fun β' hβ' => ?_⟩
        rcases minpoly.dvd ℚ (γ₀ ^ r) hR_eval with ⟨S, hS⟩
        have hβ'_R : Polynomial.aeval β' R = 0 := by
          rw [hS, map_mul, hβ', zero_mul]
        have hβH_eval : Polynomial.aeval ((((q ^ r : ℕ) : ℂ)⁻¹) * β') p_H = 0 := by
          dsimp [R] at hβ'_R
          rwa [Polynomial.aeval_comp, map_mul, Polynomial.aeval_C, Polynomial.aeval_X,
            map_inv₀, map_natCast] at hβ'_R
        obtain ⟨hL, hU⟩ := hNormH _ hβH_eval
        have hQ_real_pos : (0 : ℝ) < ((q ^ r : ℕ) : ℝ) := by exact_mod_cast hQ_ge_one
        have hQ_real_ne : ((q ^ r : ℕ) : ℝ) ≠ 0 := hQ_real_pos.ne'
        have hnorm_div : ‖(((q ^ r : ℕ) : ℂ)⁻¹) * β'‖ ^ 2 =
            (((q ^ r : ℕ) : ℝ)⁻¹) ^ 2 * ‖β'‖ ^ 2 := by
          rw [norm_mul, norm_inv, Complex.norm_natCast, mul_pow]
        rw [hnorm_div] at hL hU
        refine ⟨?_, ?_⟩
        · calc
            ((q ^ r : ℕ) : ℝ) ^ (2 * m + 1) =
                ((q ^ r : ℕ) : ℝ) * ((q ^ r : ℕ) : ℝ) ^ (2 * m) := by ring
            _ ≤ ((q ^ r : ℕ) : ℝ) *
                  (((q ^ r : ℕ) : ℝ) * ((((q ^ r : ℕ) : ℝ)⁻¹) ^ 2 * ‖β'‖ ^ 2)) :=
                mul_le_mul_of_nonneg_left hL hQ_real_pos.le
            _ = (((q ^ r : ℕ) : ℝ) * (((q ^ r : ℕ) : ℝ)⁻¹)) ^ 2 * ‖β'‖ ^ 2 := by ring
            _ = ‖β'‖ ^ 2 := by rw [mul_inv_cancel₀ hQ_real_ne, one_pow, one_mul]
        · calc
            ‖β'‖ ^ 2 = (((q ^ r : ℕ) : ℝ) * (((q ^ r : ℕ) : ℝ)⁻¹)) ^ 2 * ‖β'‖ ^ 2 := by
                rw [mul_inv_cancel₀ hQ_real_ne, one_pow, one_mul]
            _ = ((q ^ r : ℕ) : ℝ) ^ 2 * ((((q ^ r : ℕ) : ℝ)⁻¹) ^ 2 * ‖β'‖ ^ 2) := by ring
            _ ≤ ((q ^ r : ℕ) : ℝ) ^ 2 * ((q ^ r : ℕ) : ℝ) ^ (2 * m + 1) :=
                mul_le_mul_of_nonneg_left hU (by positivity)
            _ = ((q ^ r : ℕ) : ℝ) ^ (2 * m + 3) := by ring
      · exact h3
    obtain ⟨hAlg3, hNorm3⟩ := hBranch3
    let p : Polynomial ℚ := minpoly ℚ (γ₀ ^ r)
    have hp_ne : p ≠ 0 := (minpoly.monic hAlg3.isIntegral).ne_zero
    let P : Polynomial ℚ := p.comp (Polynomial.X ^ r)
    have hP_ne : P ≠ 0 := hPowCompNeZero p r hp_ne hr
    have hP_eval : Polynomial.aeval γ₀ P = 0 := by
      dsimp [P]
      rw [Polynomial.aeval_comp, map_pow, Polynomial.aeval_X]
      exact minpoly.aeval ℚ (γ₀ ^ r)
    refine ⟨⟨P, hP_ne, hP_eval⟩, fun β hβ => ?_⟩
    rcases minpoly.dvd ℚ γ₀ hP_eval with ⟨S, hS⟩
    have hβ_P : Polynomial.aeval (β ^ r) p = 0 := by
      have h0 : Polynomial.aeval β P = 0 := by rw [hS, map_mul, hβ, zero_mul]
      dsimp [P] at h0
      rwa [Polynomial.aeval_comp, map_pow, Polynomial.aeval_X] at h0
    obtain ⟨hL, hU⟩ := hNorm3 (β ^ r) hβ_P
    rw [norm_pow] at hL hU
    push_cast at hL hU
    have hL_pow : ((q : ℝ) ^ (2 * (m + 1))) ^ r ≤ ((q : ℝ) * ‖β‖ ^ 2) ^ r := by
      calc
        ((q : ℝ) ^ (2 * (m + 1))) ^ r = (q : ℝ) ^ r * ((q : ℝ) ^ r) ^ (2 * m + 1) := by ring
        _ ≤ (q : ℝ) ^ r * (‖β‖ ^ r) ^ 2 := mul_le_mul_of_nonneg_left hL (by positivity)
        _ = ((q : ℝ) * ‖β‖ ^ 2) ^ r := by ring
    have hU_pow : (‖β‖ ^ 2) ^ r ≤ ((q : ℝ) ^ (2 * (m + 1) + 1)) ^ r := by
      calc
        (‖β‖ ^ 2) ^ r = (‖β‖ ^ r) ^ 2 := by ring
        _ ≤ ((q : ℝ) ^ r) ^ (2 * m + 3) := hU
        _ = ((q : ℝ) ^ (2 * (m + 1) + 1)) ^ r := by ring
    exact ⟨(pow_le_pow_iff_left₀ (by positivity) (by positivity) (by omega)).mp hL_pow,
      (pow_le_pow_iff_left₀ (by positivity) (by positivity) (by omega)).mp hU_pow⟩
  
  have hEven : ∀ (m : ℕ) (K₀ : Type u) [Finite K₀] [Field K₀]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
      [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
      [AlgebraicGeometry.IsProper Z.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) Z.hom]
      (hProjZ : ∃ (N : ℕ) (ι : Z ⟶ weilProjectiveSpaceOver K₀ N),
        AlgebraicGeometry.IsClosedImmersion ι.left)
      (hℓ₀ : ℓ ≠ ringChar K₀)
      (M_Z : WeilEllAdicCohomologyModel K₀ Z ℓ (2 * m))
      (γ₀ : L),
      γ₀ ∈ ((M_Z.frob).charpoly).aroots L →
      IsAlgebraic ℚ γ₀ ∧
      ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ γ₀) = 0 →
        (Nat.card K₀ : ℝ) ^ (2 * m) ≤ (Nat.card K₀ : ℝ) * ‖β‖ ^ 2 ∧
        ‖β‖ ^ 2 ≤ (Nat.card K₀ : ℝ) ^ (2 * m + 1) := by
    intro m
    induction m with
    | zero =>
      intro K₀ _ _ Z _ _ _ _ hℓ₀ M_Z γ₀ hγ₀
      have hq₀ : 2 ≤ Nat.card K₀ := Finite.one_lt_card
      obtain ⟨M_pkg, hM0, _, _⟩ :=
        weil_etale_cohomology_grothendieck_package K₀ Z 0 ℓ hℓ₀
      have hchar_eq := weil_ellAdicModel_charpoly_eq K₀ Z ℓ 0 M_Z (M_pkg 0)
      rw [hchar_eq, hM0, Multiset.mem_singleton] at hγ₀
      let P₀ : Polynomial ℚ := Polynomial.X - 1
      have hP₀_ne : P₀ ≠ 0 := (Polynomial.monic_X_sub_C (1 : ℚ)).ne_zero
      have hP₀_eval : Polynomial.aeval γ₀ P₀ = 0 := by
        dsimp [P₀]
        rw [map_sub, Polynomial.aeval_X, map_one, hγ₀, sub_self]
      refine ⟨⟨P₀, hP₀_ne, hP₀_eval⟩, fun β hβ => ?_⟩
      rcases minpoly.dvd ℚ γ₀ hP₀_eval with ⟨S, hS⟩
      have hβ_P₀ : Polynomial.aeval β P₀ = 0 := by
        rw [hS, map_mul, hβ, zero_mul]
      have hβ_eq : β = 1 := by
        dsimp [P₀] at hβ_P₀
        rw [map_sub, Polynomial.aeval_X, map_one] at hβ_P₀
        exact sub_eq_zero.mp hβ_P₀
      have hcard_ge : (2 : ℝ) ≤ (Nat.card K₀ : ℝ) := by exact_mod_cast hq₀
      rw [hβ_eq, norm_one]
      constructor <;> norm_num <;> linarith
    | succ m ih =>
      intro K₀ _ _ Z _ _ _ hProjZ hℓ₀ M_Z γ₀ hγ₀
      have hq₀ : 2 ≤ Nat.card K₀ := Finite.one_lt_card
      obtain ⟨K', hFinK', hFieldK', hAlgK', hFinDimK', hStep⟩ :=
