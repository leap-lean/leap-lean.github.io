      (_ : CategoryTheory.Limits.PreservesFiniteLimits C₀)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits C₁)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits C₂)
      (d₀ : CategoryTheory.NatTrans C₀ C₁)
      (d₁ : CategoryTheory.NatTrans C₁ C₂)
      (Φ₀ : ∀ {ℱ : 𝒜}, Quiver.Hom (P_S.obj ℱ) ℱ → Quiver.Hom (C₀.obj ℱ) (C₀.obj ℱ))
      (Φ₁ : ∀ {ℱ : 𝒜}, Quiver.Hom (P_S.obj ℱ) ℱ → Quiver.Hom (C₁.obj ℱ) (C₁.obj ℱ))
      (Φ₂ : ∀ {ℱ : 𝒜}, Quiver.Hom (P_S.obj ℱ) ℱ → Quiver.Hom (C₂.obj ℱ) (C₂.obj ℱ)),
