          ((congrArg (to_PV ≫ ·)
            ((Category.assoc m_τ to_Pid _).trans
              ((congrArg (m_τ ≫ ·) hto_Pid_fst).trans hm1))).trans
            hto_PV_fst)
      have hm'2 : m'_τ ≫ Limits.pullback.snd (𝟙 V_X ≫ ι_X) ι_X =
          Limits.pullback.snd (𝟙 V_X ≫ ι_X) ι_X ≫ v_X τ :=
        (Category.assoc to_PV (m_τ ≫ to_Pid) _).trans
          ((congrArg (to_PV ≫ ·)
            ((Category.assoc m_τ to_Pid _).trans
              ((congrArg (m_τ ≫ ·) hto_Pid_snd).trans hm2))).trans
            ((Category.assoc to_PV _ (v_X τ)).symm.trans
              (congrArg (· ≫ v_X τ) hto_PV_snd)))
      calc
        (δ_id σ ≫ to_PV) ≫ m_τ
          = ((δ_id σ ≫ to_PV) ≫ m_τ) ≫ 𝟙 P_V := (Category.comp_id _).symm
        _ = ((δ_id σ ≫ to_PV) ≫ m_τ) ≫ (to_Pid ≫ to_PV) :=
              congrArg (((δ_id σ ≫ to_PV) ≫ m_τ) ≫ ·) hPV_id.symm
        _ = (((δ_id σ ≫ to_PV) ≫ m_τ) ≫ to_Pid) ≫ to_PV :=
              (Category.assoc ((δ_id σ ≫ to_PV) ≫ m_τ) to_Pid to_PV).symm
        _ = (δ_id σ ≫ (to_PV ≫ (m_τ ≫ to_Pid))) ≫ to_PV :=
              congrArg (· ≫ to_PV)
                ((Category.assoc (δ_id σ ≫ to_PV) m_τ to_Pid).trans
                  (Category.assoc (δ_id σ) to_PV (m_τ ≫ to_Pid)))
        _ = δ_id (τ * σ) ≫ to_PV :=
              congrArg (· ≫ to_PV) (hDeck_id σ τ m'_τ hm'1 hm'2)

    
    have hEx_sheet : ∀ y : ↥P_V, ∃ τ : Γ, y ∈ Set.range (γ_X τ).base := by
      intro y
      have hy : y ∈ (Set.univ : Set ↥P_V) := trivial
      rw [← hγ_univ, Set.mem_iUnion] at hy
      exact hy
    let σ_of : ↥P_V → Γ := fun y => Classical.choose (hEx_sheet y)
    have hσ_of_eq : ∀ (y : ↥P_V) (τ : Γ), y ∈ Set.range (γ_X τ).base → σ_of y = τ := by
      intro y τ hy
      by_contra hne
      exact Set.disjoint_left.mp (hγ_disj (σ_of y) τ hne)
        (Classical.choose_spec (hEx_sheet y)) hy

    
    let f_lc : A → LocallyConstant ↥P_V A := fun c =>
      { toFun := fun y => M_act (σ_of y) c
        isLocallyConstant := by
          rw [IsLocallyConstant.iff_isOpen_fiber]
          intro a
          have hpre : (fun y : ↥P_V => M_act (σ_of y) c) ⁻¹' {a} =
              ⋃ (τ : Γ) (_ : M_act τ c = a), Set.range (γ_X τ).base := by
            ext y
            simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, exists_prop]
            constructor
            · intro hya
              exact ⟨σ_of y, hya, Classical.choose_spec (hEx_sheet y)⟩
            · rintro ⟨τ, hτa, hyτ⟩
              rw [hσ_of_eq y τ hyτ]
              exact hτa
          rw [hpre]
          exact isOpen_iUnion fun τ => isOpen_iUnion fun _ => hγ_open τ }

    have hf_lc_eval : ∀ (c : A) (τ : Γ) (v : ↥V_X),
        f_lc c ((γ_X τ).base v) = M_act τ c := by
      intro c τ v
      change M_act (σ_of ((γ_X τ).base v)) c = M_act τ c
      rw [hσ_of_eq ((γ_X τ).base v) τ ⟨v, rfl⟩]

    have hf_lc_mem : ∀ c : A, f_lc c ∈ Set.range (triv_X V_et) := by
      intro c
      rw [(htriv_X_spec V_et).2]
      refine ⟨⟨⊥, ?_, ?_⟩, ?_⟩
      · ext v
        simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_bot,
          Set.union_empty, TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        change ι_X.base v ∈ (U_X : Set ↥X)
        rw [← hRange_X]
        exact ⟨v, rfl⟩
      · intro y hy
        exact False.elim hy
      · intro σ m_σ hm1 hm2 y
        rcases hEx_sheet y with ⟨τ, v, rfl⟩
        have hm_y : m_σ.base ((γ_X τ).base v) = (γ_X (σ * τ)).base v :=
          congrArg (fun k : V_X ⟶ P_V => k.base v) (hγ_deck τ σ m_σ hm1 hm2)
        rw [hm_y, hf_lc_eval c (σ * τ) v, hf_lc_eval c τ v, hM_mul σ τ, AddMonoidHom.comp_apply]

    let s_X_fun : A → ↑(𝒥_X.obj.obj (Opposite.op V_et)) :=
      fun c => Classical.choose (hf_lc_mem c)
    have hs_X_spec : ∀ c : A, triv_X V_et (s_X_fun c) = f_lc c :=
      fun c => Classical.choose_spec (hf_lc_mem c)

    let s_X : A →+ ↑(𝒥_X.obj.obj (Opposite.op V_et)) :=
      { toFun := s_X_fun
        map_zero' := by
          apply (htriv_X_spec V_et).1
          ext y
          rcases hEx_sheet y with ⟨τ, v, rfl⟩
          rw [hs_X_spec 0, map_zero, hf_lc_eval 0 τ v, map_zero, LocallyConstant.zero_apply]
        map_add' := fun c₁ c₂ => by
          apply (htriv_X_spec V_et).1
          ext y
          rcases hEx_sheet y with ⟨τ, v, rfl⟩
          rw [hs_X_spec (c₁ + c₂), map_add, LocallyConstant.add_apply,
            hs_X_spec c₁, hs_X_spec c₂, hf_lc_eval (c₁ + c₂) τ v,
            hf_lc_eval c₁ τ v, hf_lc_eval c₂ τ v, map_add] }

    have hs_X_eval : ∀ (c : A) (τ : Γ) (v : ↥V_X),
        triv_X V_et (s_X c) ((γ_X τ).base v) = M_act τ c := by
      intro c τ v
      change triv_X V_et (s_X_fun c) ((γ_X τ).base v) = M_act τ c
      rw [hs_X_spec c, hf_lc_eval c τ v]

    
    have hvX_isIso : ∀ μ : Γ, IsIso (v_X μ) := by
      intro μ
      refine ⟨⟨v_X μ⁻¹, ?_, ?_⟩⟩
      · rw [← hvX_mul, inv_mul_cancel, hvX_one]
      · rw [← hvX_mul, mul_inv_cancel, hvX_one]
    let u_X : Γ → (V_et ⟶ V_et) := fun μ =>
      letI : IsIso (v_X μ) := hvX_isIso μ
      MorphismProperty.Over.homMk (v_X μ) (hvX_ι μ)
    have hu_X_left : ∀ μ : Γ, (Fgt_X.map (u_X μ)).left = v_X μ := fun _ => rfl

    have hs_X_deck : ∀ (μ : Γ) (c : A),
        (𝒥_X.obj.map (Opposite.op (u_X μ))) (s_X c) = s_X (M_act μ⁻¹ c) := by
      intro μ c
      let u_V : P_V ⟶ P_V :=
        Limits.pullback.lift
          (Limits.pullback.fst (Fgt_X.obj V_et).hom ι_X ≫ (Fgt_X.map (u_X μ)).left)
          (Limits.pullback.snd (Fgt_X.obj V_et).hom ι_X)
          (by rw [Category.assoc, Over.w (Fgt_X.map (u_X μ))]; exact Limits.pullback.condition)
      have hu_V_fst : u_V ≫ Limits.pullback.fst (Fgt_X.obj V_et).hom ι_X =
          Limits.pullback.fst (Fgt_X.obj V_et).hom ι_X ≫ v_X μ :=
        Limits.pullback.lift_fst _ _ _
      have hu_V_snd : u_V ≫ Limits.pullback.snd (Fgt_X.obj V_et).hom ι_X =
          Limits.pullback.snd (Fgt_X.obj V_et).hom ι_X :=
        Limits.pullback.lift_snd _ _ _
      have hγ_u : ∀ τ : Γ, γ_X τ ≫ u_V = v_X μ ≫ γ_X (τ * μ⁻¹) := by
        intro τ
        have h_grp : (τ * μ⁻¹) * μ = τ := by rw [mul_assoc, inv_mul_cancel, mul_one]
        apply Limits.pullback.hom_ext
        · exact (Category.assoc (γ_X τ) u_V _).trans
            ((congrArg (γ_X τ ≫ ·) hu_V_fst).trans
              ((Category.assoc (γ_X τ) _ (v_X μ)).symm.trans
                ((congrArg (· ≫ v_X μ) (hγ_fst τ)).trans
                  ((Category.id_comp (v_X μ)).trans
                    ((Category.comp_id (v_X μ)).symm.trans
                      ((congrArg (v_X μ ≫ ·) (hγ_fst (τ * μ⁻¹)).symm).trans
                        (Category.assoc (v_X μ) (γ_X (τ * μ⁻¹)) _).symm))))))
        · exact (Category.assoc (γ_X τ) u_V _).trans
            ((congrArg (γ_X τ ≫ ·) hu_V_snd).trans
              ((hγ_snd τ).trans
                ((congrArg v_X h_grp.symm).trans
                  ((hvX_mul (τ * μ⁻¹) μ).trans
                    ((congrArg (v_X μ ≫ ·) (hγ_snd (τ * μ⁻¹)).symm).trans
                      (Category.assoc (v_X μ) (γ_X (τ * μ⁻¹)) _).symm)))))
      apply (htriv_X_spec V_et).1
      ext y
      rcases hEx_sheet y with ⟨τ, v, rfl⟩
      have h_nat := htriv_X_nat (u_X μ) u_V (Limits.pullback.lift_fst _ _ _)
        (Limits.pullback.lift_snd _ _ _) (s_X c) ((γ_X τ).base v)
      have hu_base : u_V.base ((γ_X τ).base v) = (γ_X (τ * μ⁻¹)).base ((v_X μ).base v) :=
        congrArg (fun k : V_X ⟶ P_V => k.base v) (hγ_u τ)
      have h_rhs : triv_X V_et (s_X c) (u_V.base ((γ_X τ).base v)) =
          triv_X V_et (s_X (M_act μ⁻¹ c)) ((γ_X τ).base v) :=
        (congrArg (triv_X V_et (s_X c)) hu_base).trans
          ((hs_X_eval c (τ * μ⁻¹) ((v_X μ).base v)).trans
            ((congrArg (fun fn => fn c) (hM_mul τ μ⁻¹)).trans
              (hs_X_eval (M_act μ⁻¹ c) τ v).symm))
      exact h_nat.trans h_rhs

    
    have hLevelRestr : ∀ (W E : X.Etale) (s : ↑(𝒥_X.obj.obj (Opposite.op W)))
        (u_E : E ⟶ W) (c : A)
        (l : (Fgt_X.obj E).left ⟶ Limits.pullback (Fgt_X.obj W).hom ι_X)
        (q_E : E ⟶ V_et),
        l ≫ Limits.pullback.fst (Fgt_X.obj W).hom ι_X = (Fgt_X.map u_E).left →
        (Fgt_X.map q_E).left = l ≫ Limits.pullback.snd (Fgt_X.obj W).hom ι_X →
        (∀ e : ↥(Fgt_X.obj E).left, triv_X W s (l.base e) = c) →
        (𝒥_X.obj.map (Opposite.op u_E)) s = (𝒥_X.obj.map (Opposite.op q_E)) (s_X c) := by
      intro W E s u_E c l q_E hl_fst hq_left hl_val
      let W_V := Limits.pullback (Fgt_X.obj W).hom ι_X
      let E_V := Limits.pullback (Fgt_X.obj E).hom ι_X
      let g_E : (Fgt_X.obj E).left ⟶ V_X := l ≫ Limits.pullback.snd (Fgt_X.obj W).hom ι_X
      have hg_E_ι : g_E ≫ ι_X = (Fgt_X.obj E).hom := by
        dsimp [g_E]
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hl_fst]
        exact Over.w (Fgt_X.map u_E)
      let P_gE := Limits.pullback (g_E ≫ ι_X) ι_X
      let to_EV : P_gE ⟶ E_V :=
        Limits.pullback.lift
          (Limits.pullback.fst (g_E ≫ ι_X) ι_X)
          (Limits.pullback.snd (g_E ≫ ι_X) ι_X)
          (by rw [← hg_E_ι]; exact Limits.pullback.condition)
      let to_PgE : E_V ⟶ P_gE :=
        Limits.pullback.lift
          (Limits.pullback.fst (Fgt_X.obj E).hom ι_X)
          (Limits.pullback.snd (Fgt_X.obj E).hom ι_X)
          (by rw [hg_E_ι]; exact Limits.pullback.condition)
      have hEV_id : to_PgE ≫ to_EV = 𝟙 E_V := by
        apply Limits.pullback.hom_ext
        · dsimp [to_EV, to_PgE, E_V, P_gE]
          rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst, Category.id_comp]
        · dsimp [to_EV, to_PgE, E_V, P_gE]
          rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]
      obtain ⟨δ_gE, hδ_gE, _, hUniv_gE, _⟩ := hSheets_X (Fgt_X.obj E).left g_E
      let δ_E : Γ → ((Fgt_X.obj E).left ⟶ E_V) := fun τ => δ_gE τ ≫ to_EV
      let u_u : E_V ⟶ W_V :=
        Limits.pullback.lift
          (Limits.pullback.fst (Fgt_X.obj E).hom ι_X ≫ (Fgt_X.map u_E).left)
          (Limits.pullback.snd (Fgt_X.obj E).hom ι_X)
          (by rw [Category.assoc, Over.w (Fgt_X.map u_E)]; exact Limits.pullback.condition)
      let u_q : E_V ⟶ P_V :=
        Limits.pullback.lift
          (Limits.pullback.fst (Fgt_X.obj E).hom ι_X ≫ (Fgt_X.map q_E).left)
          (Limits.pullback.snd (Fgt_X.obj E).hom ι_X)
          (by rw [Category.assoc, Over.w (Fgt_X.map q_E)]; exact Limits.pullback.condition)
      have hs_mem : triv_X W s ∈ Set.range (triv_X W) := ⟨s, rfl⟩
      rw [(htriv_X_spec W).2] at hs_mem
      have hs_equiv := hs_mem.2
      apply (htriv_X_spec E).1
      ext y
      have hy : to_PgE.base y ∈ (Set.univ : Set ↥P_gE) := trivial
      rw [← hUniv_gE, Set.mem_iUnion] at hy
      rcases hy with ⟨τ, e, he⟩
      have hy_eq : (δ_E τ).base e = y := by
        change to_EV.base ((δ_gE τ).base e) = y
        rw [he]
        exact congrArg (fun k : E_V ⟶ E_V => k.base y) hEV_id
      rw [← hy_eq]
      have hto_EV_fst : to_EV ≫ Limits.pullback.fst (Fgt_X.obj E).hom ι_X =
          Limits.pullback.fst (g_E ≫ ι_X) ι_X := Limits.pullback.lift_fst _ _ _
      have hto_EV_snd : to_EV ≫ Limits.pullback.snd (Fgt_X.obj E).hom ι_X =
          Limits.pullback.snd (g_E ≫ ι_X) ι_X := Limits.pullback.lift_snd _ _ _
      have hu_u_fst : u_u ≫ Limits.pullback.fst (Fgt_X.obj W).hom ι_X =
          Limits.pullback.fst (Fgt_X.obj E).hom ι_X ≫ (Fgt_X.map u_E).left :=
        Limits.pullback.lift_fst _ _ _
      have hu_u_snd : u_u ≫ Limits.pullback.snd (Fgt_X.obj W).hom ι_X =
          Limits.pullback.snd (Fgt_X.obj E).hom ι_X :=
        Limits.pullback.lift_snd _ _ _
      have hu_q_fst : u_q ≫ Limits.pullback.fst (Fgt_X.obj V_et).hom ι_X =
          Limits.pullback.fst (Fgt_X.obj E).hom ι_X ≫ (Fgt_X.map q_E).left :=
        Limits.pullback.lift_fst _ _ _
      have hu_q_snd : u_q ≫ Limits.pullback.snd (Fgt_X.obj V_et).hom ι_X =
          Limits.pullback.snd (Fgt_X.obj E).hom ι_X :=
        Limits.pullback.lift_snd _ _ _
      have hδ_E_fst : δ_E τ ≫ Limits.pullback.fst (Fgt_X.obj E).hom ι_X =
          𝟙 (Fgt_X.obj E).left :=
        (Category.assoc (δ_gE τ) to_EV _).trans
          ((congrArg (δ_gE τ ≫ ·) hto_EV_fst).trans (hδ_gE τ).1)
      have hδ_E_snd : δ_E τ ≫ Limits.pullback.snd (Fgt_X.obj E).hom ι_X = g_E ≫ v_X τ :=
        (Category.assoc (δ_gE τ) to_EV _).trans
          ((congrArg (δ_gE τ ≫ ·) hto_EV_snd).trans (hδ_gE τ).2.1)
      let m_τ : W_V ⟶ W_V :=
        Limits.pullback.lift
          (Limits.pullback.fst (Fgt_X.obj W).hom ι_X)
          (Limits.pullback.snd (Fgt_X.obj W).hom ι_X ≫ v_X τ)
          (by rw [Category.assoc, hvX_ι τ]; exact Limits.pullback.condition)
      have hm_τ_fst : m_τ ≫ Limits.pullback.fst (Fgt_X.obj W).hom ι_X =
          Limits.pullback.fst (Fgt_X.obj W).hom ι_X := Limits.pullback.lift_fst _ _ _
      have hm_τ_snd : m_τ ≫ Limits.pullback.snd (Fgt_X.obj W).hom ι_X =
          Limits.pullback.snd (Fgt_X.obj W).hom ι_X ≫ v_X τ := Limits.pullback.lift_snd _ _ _
      have h_du : δ_E τ ≫ u_u = l ≫ m_τ := by
        apply Limits.pullback.hom_ext
        · exact (Category.assoc (δ_E τ) u_u _).trans
            ((congrArg (δ_E τ ≫ ·) hu_u_fst).trans
              ((Category.assoc (δ_E τ) _ _).symm.trans
                ((congrArg (· ≫ (Fgt_X.map u_E).left) hδ_E_fst).trans
                  ((Category.id_comp _).trans
                    (hl_fst.symm.trans
                      ((congrArg (l ≫ ·) hm_τ_fst.symm).trans
                        (Category.assoc l m_τ _).symm))))))
        · exact (Category.assoc (δ_E τ) u_u _).trans
            ((congrArg (δ_E τ ≫ ·) hu_u_snd).trans
              (hδ_E_snd.trans
                ((Category.assoc l _ (v_X τ)).trans
                  ((congrArg (l ≫ ·) hm_τ_snd.symm).trans
                    (Category.assoc l m_τ _).symm))))
      have h_dq : δ_E τ ≫ u_q = g_E ≫ γ_X τ := by
        apply Limits.pullback.hom_ext
        · exact (Category.assoc (δ_E τ) u_q _).trans
            ((congrArg (δ_E τ ≫ ·) hu_q_fst).trans
              ((Category.assoc (δ_E τ) _ _).symm.trans
                ((congrArg (· ≫ (Fgt_X.map q_E).left) hδ_E_fst).trans
                  ((Category.id_comp _).trans
                    (hq_left.trans
                      ((Category.comp_id g_E).symm.trans
                        ((congrArg (g_E ≫ ·) (hγ_fst τ).symm).trans
                          (Category.assoc g_E (γ_X τ) _).symm)))))))
        · exact (Category.assoc (δ_E τ) u_q _).trans
            ((congrArg (δ_E τ ≫ ·) hu_q_snd).trans
              (hδ_E_snd.trans
                ((congrArg (g_E ≫ ·) (hγ_snd τ).symm).trans
                  (Category.assoc g_E (γ_X τ) _).symm)))
      have h_lhs := htriv_X_nat u_E u_u hu_u_fst hu_u_snd s ((δ_E τ).base e)
      have h_rhs := htriv_X_nat q_E u_q hu_q_fst hu_q_snd (s_X c) ((δ_E τ).base e)
      have h_du_b : u_u.base ((δ_E τ).base e) = m_τ.base (l.base e) :=
        congrArg (fun k : (Fgt_X.obj E).left ⟶ W_V => k.base e) h_du
      have h_dq_b : u_q.base ((δ_E τ).base e) = (γ_X τ).base (g_E.base e) :=
        congrArg (fun k : (Fgt_X.obj E).left ⟶ P_V => k.base e) h_dq
      have h_mid : triv_X W s (u_u.base ((δ_E τ).base e)) =
          triv_X V_et (s_X c) (u_q.base ((δ_E τ).base e)) :=
        (congrArg (triv_X W s) h_du_b).trans
          ((hs_equiv τ m_τ hm_τ_fst hm_τ_snd (l.base e)).trans
            ((congrArg (M_act τ) (hl_val e)).trans
              ((hs_X_eval c τ (g_E.base e)).symm.trans
                (congrArg (triv_X V_et (s_X c)) h_dq_b.symm))))
      exact h_lhs.trans (h_mid.trans h_rhs.symm)

    
    refine ⟨s_X, u_X, γ_X, hu_X_left, fun τ => ⟨hγ_fst τ, hγ_snd τ⟩, hγ_univ, hs_X_eval,
      hs_X_deck, ?_⟩
    intro W s
    let h_W := (Fgt_X.obj W).hom
    have : Etale h_W := W.prop
    let W_V := Limits.pullback h_W ι_X
    let fst_W := Limits.pullback.fst h_W ι_X
    let snd_W := Limits.pullback.snd h_W ι_X
    let f_W := triv_X W s
    have hfW_mem : f_W ∈ Set.range (triv_X W) := ⟨s, rfl⟩
    rw [(htriv_X_spec W).2] at hfW_mem
    rcases hfW_mem.1 with ⟨W₀, hW₀_top, hW₀_zero⟩
    let O_lvl : A → W_V.Opens := fun c => ⟨f_W ⁻¹' {c}, f_W.isLocallyConstant {c}⟩
    let obj_W : Unit ⊕ A → X.Etale := fun idx =>
      match idx with
      | Sum.inl () => Scheme.Etale.mk (W₀.ι ≫ h_W)
      | Sum.inr c => Scheme.Etale.mk (((O_lvl c).ι ≫ fst_W) ≫ h_W)
    let mor_W : ∀ idx : Unit ⊕ A, obj_W idx ⟶ W := fun idx =>
      match idx with
      | Sum.inl () => MorphismProperty.Over.homMk W₀.ι rfl
      | Sum.inr c => MorphismProperty.Over.homMk ((O_lvl c).ι ≫ fst_W) rfl
    refine ⟨obj_W, mor_W, ?_, ?_, ?_, ?_, ?_⟩
    · intro idx
      cases idx with
      | inl u =>
        cases u
        change Etale W₀.ι
        infer_instance
      | inr c =>
        change Etale ((O_lvl c).ι ≫ fst_W)
        infer_instance
    · intro x
      have hx_top : x ∈ (⊤ : (Fgt_X.obj W).left.Opens) := trivial
      rw [← hW₀_top] at hx_top
      rcases hx_top with hxU | hxW₀
      · change h_W.base x ∈ (U_X : Set ↥X) at hxU
        rw [← hRange_X] at hxU
        rcases hxU with ⟨v₀, hv₀⟩
        obtain ⟨y₀, hy₀_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback x v₀ hv₀.symm
        let c := f_W y₀
        refine ⟨Sum.inr c, ⟨y₀, rfl⟩, ?_⟩
        exact hy₀_fst
      · exact ⟨Sum.inl (), ⟨x, hxW₀⟩, rfl⟩
    · intro y hy
      rcases hy with ⟨x₀, hx₀⟩
      apply hW₀_zero y
      rw [← hx₀]
      change W₀.ι.base x₀ ∈ W₀
      have hmem : W₀.ι.base x₀ ∈ Set.range W₀.ι.base := ⟨x₀, rfl⟩
      rwa [W₀.range_ι] at hmem
    · let W_inl := obj_W (Sum.inl ())
      let u_inl := mor_W (Sum.inl ())
      let u_V0 : Limits.pullback (Fgt_X.obj W_inl).hom ι_X ⟶ W_V :=
        Limits.pullback.lift
          (Limits.pullback.fst (Fgt_X.obj W_inl).hom ι_X ≫ (Fgt_X.map u_inl).left)
          (Limits.pullback.snd (Fgt_X.obj W_inl).hom ι_X)
          (by
            dsimp [h_W]
            rw [Category.assoc, Over.w (Fgt_X.map u_inl)]
            exact Limits.pullback.condition)
      apply (htriv_X_spec W_inl).1
      ext y₁
      rw [htriv_X_nat u_inl u_V0 (Limits.pullback.lift_fst _ _ _)
            (Limits.pullback.lift_snd _ _ _) s y₁,
          map_zero, LocallyConstant.zero_apply]
      apply hW₀_zero (u_V0.base y₁)
      have h_fst_y₁ : fst_W.base (u_V0.base y₁) =
          W₀.ι.base ((Limits.pullback.fst (Fgt_X.obj W_inl).hom ι_X).base y₁) :=
        congrArg (fun k : Limits.pullback (Fgt_X.obj W_inl).hom ι_X ⟶ (Fgt_X.obj W).left => k.base y₁)
          (Limits.pullback.lift_fst _ _ _)
      rw [h_fst_y₁]
      have hmem : W₀.ι.base ((Limits.pullback.fst (Fgt_X.obj W_inl).hom ι_X).base y₁) ∈
          Set.range W₀.ι.base := ⟨_, rfl⟩
      rwa [W₀.range_ι] at hmem
    · intro c
      let l_c : (O_lvl c).toScheme ⟶ W_V := (O_lvl c).ι
      let q_c : obj_W (Sum.inr c) ⟶ V_et :=
        MorphismProperty.Over.homMk ((O_lvl c).ι ≫ snd_W)
          (by
            change ((O_lvl c).ι ≫ snd_W) ≫ ι_X = ((O_lvl c).ι ≫ fst_W) ≫ h_W
            rw [Category.assoc, Category.assoc, Limits.pullback.condition])
      have hval_c : ∀ p : ↥(O_lvl c).toScheme, f_W (l_c.base p) = c := by
        intro p
        have hp : l_c.base p ∈ Set.range (O_lvl c).ι.base := ⟨p, rfl⟩
        rw [(O_lvl c).range_ι] at hp
        exact hp
      exact ⟨l_c, q_c, rfl, rfl, hval_c,
        hLevelRestr W (obj_W (Sum.inr c)) s (mor_W (Sum.inr c)) c l_c q_c rfl rfl hval_c⟩

  
  let V₀_et : D₀.Etale := Scheme.Etale.mk ι₀
  obtain ⟨s_can, u_aut, γ₀, hu_aut, hγ₀, _, hs_can, hs_can_deck, hBaseLevel⟩ :=
    hSingleScheme D₀ U₀ V₀ ι₀ hι₀_et hRange_ι₀ v_aut₀ hv₀_one hv₀_mul hv₀_ι hSheets_ι₀
      𝒥₀ triv₀ (@htriv₀.1) htriv₀.2

  let V_bar_et : S.Etale := Scheme.Etale.mk ι_bar
  obtain ⟨s_bar, u_bar, γ_bar, hu_bar, hγ_bar, hγ_bar_univ, hs_bar, _, hBarLevel⟩ :=
    hSingleScheme S U_bar V_bar ι_bar hι_bar_et hRange_bar v_aut_bar hv_bar_one hv_bar_mul
      (fun σ => (hv_bar σ).1) hSheets_bar 𝒥_bar triv_bar (@htriv_bar.1) htriv_bar.2

  
  
  
  let cmp_W : ∀ W : D₀.Etale,
      Limits.pullback (Fgt_S.obj (B_pr.obj W)).hom ι_bar ⟶
        Limits.pullback (Fgt₀.obj W).hom ι₀ := fun W =>
    Limits.pullback.lift
      (Limits.pullback.fst (Fgt_S.obj (B_pr.obj W)).hom ι_bar ≫
        Limits.pullback.fst (Fgt₀.obj W).hom pr_D)
      (Limits.pullback.snd (Fgt_S.obj (B_pr.obj W)).hom ι_bar ≫ fst_V)
      (by
        let f₁ : Limits.pullback (Fgt_S.obj (B_pr.obj W)).hom ι_bar ⟶
            Limits.pullback (Fgt₀.obj W).hom pr_D :=
          Limits.pullback.fst (Fgt_S.obj (B_pr.obj W)).hom ι_bar
        let s₁ := Limits.pullback.snd (Fgt_S.obj (B_pr.obj W)).hom ι_bar
        have hp_cond : Limits.pullback.fst (Fgt₀.obj W).hom pr_D ≫ (Fgt₀.obj W).hom =
            (Fgt_S.obj (B_pr.obj W)).hom ≫ pr_D := Limits.pullback.condition
        have hs_cond : f₁ ≫ (Fgt_S.obj (B_pr.obj W)).hom = s₁ ≫ ι_bar :=
          Limits.pullback.condition
        exact (Category.assoc f₁ (Limits.pullback.fst (Fgt₀.obj W).hom pr_D) (Fgt₀.obj W).hom).trans
          ((congrArg (f₁ ≫ ·) hp_cond).trans
            ((Category.assoc f₁ (Fgt_S.obj (B_pr.obj W)).hom pr_D).symm.trans
              ((congrArg (· ≫ pr_D) hs_cond).trans
                ((Category.assoc s₁ ι_bar pr_D).trans
                  ((congrArg (s₁ ≫ ·) hPb_V.w).trans
                    (Category.assoc s₁ fst_V ι₀).symm))))))
  have hcmp_W_fst : ∀ W : D₀.Etale,
      cmp_W W ≫ Limits.pullback.fst (Fgt₀.obj W).hom ι₀ =
        Limits.pullback.fst (Fgt_S.obj (B_pr.obj W)).hom ι_bar ≫
          Limits.pullback.fst (Fgt₀.obj W).hom pr_D :=
    fun _ => Limits.pullback.lift_fst _ _ _
  have hcmp_W_snd : ∀ W : D₀.Etale,
      cmp_W W ≫ Limits.pullback.snd (Fgt₀.obj W).hom ι₀ =
        Limits.pullback.snd (Fgt_S.obj (B_pr.obj W)).hom ι_bar ≫ fst_V :=
    fun _ => Limits.pullback.lift_snd _ _ _

  have hη_mem : ∀ (W : D₀.Etale) (s₀ : ↑(𝒥₀.obj.obj (Opposite.op W))),
      ({ toFun := fun y => triv₀ W s₀ ((cmp_W W).base y)
         isLocallyConstant := by
           rw [IsLocallyConstant.iff_isOpen_fiber]
           intro a
           exact ((triv₀ W s₀).isLocallyConstant {a}).preimage
             (cmp_W W).base.hom.continuous } :
        LocallyConstant ↥(Limits.pullback (Fgt_S.obj (B_pr.obj W)).hom ι_bar) A) ∈
      Set.range (triv_bar (B_pr.obj W)) := by
    intro W s₀
    let h_W := (Fgt₀.obj W).hom
    let E := B_pr.obj W
    let h_E := (Fgt_S.obj E).hom
    let p_W := Limits.pullback.fst h_W pr_D
    have hp_cond : p_W ≫ h_W = h_E ≫ pr_D := Limits.pullback.condition
    have hs₀_mem : triv₀ W s₀ ∈ Set.range (triv₀ W) := ⟨s₀, rfl⟩
    rw [(htriv₀.2 W).2] at hs₀_mem
    rcases hs₀_mem with ⟨⟨W₀, hW₀_top, hW₀_zero⟩, hs₀_equiv⟩
    rw [(htriv_bar.2 E).2]
    refine ⟨⟨(TopologicalSpace.Opens.map p_W.base).obj W₀, ?_, ?_⟩, ?_⟩
    · ext e
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have he_top : p_W.base e ∈ (⊤ : (Fgt₀.obj W).left.Opens) := trivial
      rw [← hW₀_top] at he_top
      rcases he_top with heU | heW₀
      · left
        change pr_D.base (h_E.base e) ∈ (U₀ : Set ↥D₀)
        have h_eq : h_W.base (p_W.base e) = pr_D.base (h_E.base e) :=
          congrArg (fun k : (Fgt_S.obj E).left ⟶ D₀ => k.base e) hp_cond
        rwa [← h_eq]
      · right
        exact heW₀
    · intro y hy
      change triv₀ W s₀ ((cmp_W W).base y) = 0
      apply hW₀_zero ((cmp_W W).base y)
      have h_fst : (Limits.pullback.fst h_W ι₀).base ((cmp_W W).base y) =
          p_W.base ((Limits.pullback.fst h_E ι_bar).base y) :=
        congrArg (fun k : Limits.pullback h_E ι_bar ⟶ (Fgt₀.obj W).left => k.base y)
          (Limits.pullback.lift_fst _ _ _)
      rw [h_fst]
      exact hy
    · intro σ m_σ hm1 hm2 y
      change triv₀ W s₀ ((cmp_W W).base (m_σ.base y)) =
        M_act σ (triv₀ W s₀ ((cmp_W W).base y))
      let m_W : Limits.pullback h_W ι₀ ⟶ Limits.pullback h_W ι₀ :=
        Limits.pullback.lift
          (Limits.pullback.fst h_W ι₀)
          (Limits.pullback.snd h_W ι₀ ≫ v_aut₀ σ)
          (by rw [Category.assoc, hv₀_ι σ]; exact Limits.pullback.condition)
      have hm_W_fst : m_W ≫ Limits.pullback.fst h_W ι₀ = Limits.pullback.fst h_W ι₀ :=
        Limits.pullback.lift_fst _ _ _
      have hm_W_snd : m_W ≫ Limits.pullback.snd h_W ι₀ = Limits.pullback.snd h_W ι₀ ≫ v_aut₀ σ :=
        Limits.pullback.lift_snd _ _ _
      have h_sq : m_σ ≫ cmp_W W = cmp_W W ≫ m_W := by
        apply Limits.pullback.hom_ext
        · exact (Category.assoc m_σ (cmp_W W) _).trans
            ((congrArg (m_σ ≫ ·) (hcmp_W_fst W)).trans
              ((Category.assoc m_σ _ _).symm.trans
                ((congrArg (· ≫ p_W) hm1).trans
                  ((hcmp_W_fst W).symm.trans
                    ((congrArg (cmp_W W ≫ ·) hm_W_fst.symm).trans
                      (Category.assoc (cmp_W W) m_W _).symm)))))
        · exact (Category.assoc m_σ (cmp_W W) _).trans
            ((congrArg (m_σ ≫ ·) (hcmp_W_snd W)).trans
              ((Category.assoc m_σ _ fst_V).symm.trans
                ((congrArg (· ≫ fst_V) hm2).trans
                  ((Category.assoc (Limits.pullback.snd h_E ι_bar) (v_aut_bar σ) fst_V).trans
                    ((congrArg (Limits.pullback.snd h_E ι_bar ≫ ·) (hv_bar σ).2).trans
                      ((Category.assoc (Limits.pullback.snd h_E ι_bar) fst_V (v_aut₀ σ)).symm.trans
                        ((congrArg (· ≫ v_aut₀ σ) (hcmp_W_snd W).symm).trans
                          ((Category.assoc (cmp_W W) _ (v_aut₀ σ)).trans
                            ((congrArg (cmp_W W ≫ ·) hm_W_snd.symm).trans
                              (Category.assoc (cmp_W W) m_W _).symm)))))))))
      have h_sq_b : (cmp_W W).base (m_σ.base y) = m_W.base ((cmp_W W).base y) :=
        congrArg (fun k : Limits.pullback h_E ι_bar ⟶ Limits.pullback h_W ι₀ => k.base y) h_sq
      rw [h_sq_b]
      exact hs₀_equiv σ m_W (Limits.pullback.lift_fst _ _ _)
        (Limits.pullback.lift_snd _ _ _) ((cmp_W W).base y)

  let η_fun : ∀ W : D₀.Etale,
      ↑(𝒥₀.obj.obj (Opposite.op W)) → ↑(𝒥_bar.obj.obj (Opposite.op (B_pr.obj W))) :=
    fun W s₀ => Classical.choose (hη_mem W s₀)
  have hη_fun_spec : ∀ (W : D₀.Etale) (s₀ : ↑(𝒥₀.obj.obj (Opposite.op W))) (y),
      triv_bar (B_pr.obj W) (η_fun W s₀) y = triv₀ W s₀ ((cmp_W W).base y) :=
    fun W s₀ y => congrArg (fun f => f y) (Classical.choose_spec (hη_mem W s₀))

  let η_app : ∀ W_op : (D₀.Etale)ᵒᵖ,
      𝒥₀.obj.obj W_op ⟶ (R_pr.obj 𝒥_bar).obj.obj W_op := fun W_op =>
    AddCommGrpCat.ofHom
      { toFun := η_fun W_op.unop
        map_zero' := by
          apply (htriv_bar.2 (B_pr.obj W_op.unop)).1
          ext y
          rw [hη_fun_spec, map_zero, map_zero, LocallyConstant.zero_apply,
            LocallyConstant.zero_apply]
        map_add' := fun a b => by
          apply (htriv_bar.2 (B_pr.obj W_op.unop)).1
          ext y
          rw [hη_fun_spec, map_add, map_add, LocallyConstant.add_apply,
            LocallyConstant.add_apply, hη_fun_spec, hη_fun_spec] }

  let η : 𝒥₀ ⟶ R_pr.obj 𝒥_bar :=
    { hom :=
        { app := η_app
          naturality := by
            intro W₂_op W₁_op u_op
            rcases W₂_op with ⟨W₂⟩
            rcases W₁_op with ⟨W₁⟩
            let u : W₁ ⟶ W₂ := u_op.unop
            have hu_op : u_op = Opposite.op u := rfl
            rw [hu_op]
            apply AddCommGrpCat.ext
            intro s₀
            change η_fun W₁ ((𝒥₀.obj.map (Opposite.op u)) s₀) =
              (𝒥_bar.obj.map (Opposite.op (B_pr.map u))) (η_fun W₂ s₀)
            apply (htriv_bar.2 (B_pr.obj W₁)).1
            ext y₁
            let h₁ := (Fgt₀.obj W₁).hom
            let h₂ := (Fgt₀.obj W₂).hom
            let hE₁ := (Fgt_S.obj (B_pr.obj W₁)).hom
            let hE₂ := (Fgt_S.obj (B_pr.obj W₂)).hom
            let u_0 : Limits.pullback h₁ ι₀ ⟶ Limits.pullback h₂ ι₀ :=
              Limits.pullback.lift
                (Limits.pullback.fst h₁ ι₀ ≫ (Fgt₀.map u).left)
                (Limits.pullback.snd h₁ ι₀)
                (by
                  dsimp [h₁, h₂]
                  rw [Category.assoc, Over.w (Fgt₀.map u)]
                  exact Limits.pullback.condition)
            let u_E : Limits.pullback hE₁ ι_bar ⟶ Limits.pullback hE₂ ι_bar :=
              Limits.pullback.lift
                (Limits.pullback.fst hE₁ ι_bar ≫ (Fgt_S.map (B_pr.map u)).left)
                (Limits.pullback.snd hE₁ ι_bar)
                (by
                  dsimp [hE₁, hE₂]
                  rw [Category.assoc, Over.w (Fgt_S.map (B_pr.map u))]
                  exact Limits.pullback.condition)
            have hu_0_fst : u_0 ≫ Limits.pullback.fst h₂ ι₀ =
                Limits.pullback.fst h₁ ι₀ ≫ (Fgt₀.map u).left :=
              Limits.pullback.lift_fst _ _ _
            have hu_0_snd : u_0 ≫ Limits.pullback.snd h₂ ι₀ = Limits.pullback.snd h₁ ι₀ :=
              Limits.pullback.lift_snd _ _ _
            have hu_E_fst : u_E ≫ Limits.pullback.fst hE₂ ι_bar =
                Limits.pullback.fst hE₁ ι_bar ≫ (Fgt_S.map (B_pr.map u)).left :=
              Limits.pullback.lift_fst _ _ _
            have hu_E_snd : u_E ≫ Limits.pullback.snd hE₂ ι_bar = Limits.pullback.snd hE₁ ι_bar :=
              Limits.pullback.lift_snd _ _ _
            have hB_fst : (Fgt_S.map (B_pr.map u)).left ≫
                Limits.pullback.fst (Fgt₀.obj W₂).hom pr_D =
                Limits.pullback.fst (Fgt₀.obj W₁).hom pr_D ≫ (Fgt₀.map u).left :=
              Limits.pullback.lift_fst _ _ _
            have h_u_cmp : u_E ≫ cmp_W W₂ = cmp_W W₁ ≫ u_0 := by
              apply Limits.pullback.hom_ext
              · exact (Category.assoc u_E (cmp_W W₂) _).trans
                  ((congrArg (u_E ≫ ·) (hcmp_W_fst W₂)).trans
                    ((Category.assoc u_E _ _).symm.trans
                      ((congrArg (· ≫ Limits.pullback.fst (Fgt₀.obj W₂).hom pr_D) hu_E_fst).trans
                        ((Category.assoc (Limits.pullback.fst hE₁ ι_bar)
                            (Fgt_S.map (B_pr.map u)).left _).trans
                          ((congrArg (Limits.pullback.fst hE₁ ι_bar ≫ ·) hB_fst).trans
                            ((Category.assoc (Limits.pullback.fst hE₁ ι_bar) _ _).symm.trans
                              ((congrArg (· ≫ (Fgt₀.map u).left) (hcmp_W_fst W₁).symm).trans
                                ((Category.assoc (cmp_W W₁) _ _).trans
                                  ((congrArg (cmp_W W₁ ≫ ·) hu_0_fst.symm).trans
                                    (Category.assoc (cmp_W W₁) u_0 _).symm)))))))))
              · exact (Category.assoc u_E (cmp_W W₂) _).trans
                  ((congrArg (u_E ≫ ·) (hcmp_W_snd W₂)).trans
                    ((Category.assoc u_E _ fst_V).symm.trans
                      ((congrArg (· ≫ fst_V) hu_E_snd).trans
                        ((hcmp_W_snd W₁).symm.trans
                          ((congrArg (cmp_W W₁ ≫ ·) hu_0_snd.symm).trans
                            (Category.assoc (cmp_W W₁) u_0 _).symm)))))
            rw [hη_fun_spec W₁ _ y₁,
                htriv₀.1 u u_0 (Limits.pullback.lift_fst _ _ _)
                  (Limits.pullback.lift_snd _ _ _) s₀ ((cmp_W W₁).base y₁),
                htriv_bar.1 (B_pr.map u) u_E (Limits.pullback.lift_fst _ _ _)
                  (Limits.pullback.lift_snd _ _ _) (η_fun W₂ s₀) y₁,
                hη_fun_spec W₂ s₀ (u_E.base y₁)]
            exact congrArg (triv₀ W₂ s₀)
              (congrArg (fun k : Limits.pullback hE₁ ι_bar ⟶ Limits.pullback h₂ ι₀ => k.base y₁)
                h_u_cmp.symm) } }

  have hη_cmp : ∀ (W : D₀.Etale) (s₀ : ↑(𝒥₀.obj.obj (Opposite.op W)))
      (y : ↥(Limits.pullback (Fgt_S.obj (B_pr.obj W)).hom ι_bar))
      (cmp : Limits.pullback (Fgt_S.obj (B_pr.obj W)).hom ι_bar ⟶
        Limits.pullback (Fgt₀.obj W).hom ι₀),
      cmp ≫ Limits.pullback.fst (Fgt₀.obj W).hom ι₀ =
        Limits.pullback.fst (Fgt_S.obj (B_pr.obj W)).hom ι_bar ≫
          Limits.pullback.fst (Fgt₀.obj W).hom pr_D →
      cmp ≫ Limits.pullback.snd (Fgt₀.obj W).hom ι₀ =
        Limits.pullback.snd (Fgt_S.obj (B_pr.obj W)).hom ι_bar ≫ fst_V →
      triv_bar (B_pr.obj W) ((η.hom.app (Opposite.op W)) s₀) y =
        triv₀ W s₀ (cmp.base y) := by
    intro W s₀ y cmp hcmp1 hcmp2
    have hcmp_eq : cmp = cmp_W W := by
      apply Limits.pullback.hom_ext
      · exact hcmp1.trans (Limits.pullback.lift_fst _ _ _).symm
      · exact hcmp2.trans (Limits.pullback.lift_snd _ _ _).symm
    rw [hcmp_eq]
    exact hη_fun_spec W s₀ y

  
  let e_sch : V_bar ≅ Limits.pullback ι₀ pr_D := hPb_V.flip.isoPullback
  let e_Vet : V_bar_et ≅ B_pr.obj V₀_et :=
    { hom := MorphismProperty.Over.homMk e_sch.hom hPb_V.flip.isoPullback_hom_snd
      inv := MorphismProperty.Over.homMk e_sch.inv hPb_V.flip.isoPullback_inv_snd
      hom_inv_id := MorphismProperty.Over.Hom.ext e_sch.hom_inv_id
      inv_hom_id := MorphismProperty.Over.Hom.ext e_sch.inv_hom_id }
  have he_Vet_fst : (Fgt_S.map e_Vet.hom).left ≫ Limits.pullback.fst (Fgt₀.obj V₀_et).hom pr_D =
      fst_V :=
    hPb_V.flip.isoPullback_hom_fst

  have hu_bar_inter : ∀ μ : Γ, u_bar μ ≫ e_Vet.hom = e_Vet.hom ≫ B_pr.map (u_aut μ) := by
    intro μ
    apply MorphismProperty.Over.Hom.ext
    let b_μ : Limits.pullback ι₀ pr_D ⟶ Limits.pullback ι₀ pr_D :=
      (Fgt_S.map (B_pr.map (u_aut μ))).left
    have hb_fst_raw : b_μ ≫ Limits.pullback.fst (Fgt₀.obj V₀_et).hom pr_D =
        Limits.pullback.fst (Fgt₀.obj V₀_et).hom pr_D ≫ (Fgt₀.map (u_aut μ)).left :=
      Limits.pullback.lift_fst _ _ _
    have hb_fst : b_μ ≫ Limits.pullback.fst ι₀ pr_D =
        Limits.pullback.fst ι₀ pr_D ≫ v_aut₀ μ :=
      hb_fst_raw.trans (congrArg (fun f : V₀ ⟶ V₀ => Limits.pullback.fst ι₀ pr_D ≫ f) (hu_aut μ))
    have hb_snd : b_μ ≫ Limits.pullback.snd ι₀ pr_D = Limits.pullback.snd ι₀ pr_D :=
      Limits.pullback.lift_snd _ _ _
    have h_sch : v_aut_bar μ ≫ e_sch.hom = e_sch.hom ≫ b_μ := by
      apply Limits.pullback.hom_ext
      · calc
          (v_aut_bar μ ≫ e_sch.hom) ≫ Limits.pullback.fst ι₀ pr_D
            = v_aut_bar μ ≫ (e_sch.hom ≫ Limits.pullback.fst ι₀ pr_D) := Category.assoc _ _ _
          _ = v_aut_bar μ ≫ fst_V := congrArg (v_aut_bar μ ≫ ·) hPb_V.flip.isoPullback_hom_fst
          _ = fst_V ≫ v_aut₀ μ := (hv_bar μ).2
          _ = (e_sch.hom ≫ Limits.pullback.fst ι₀ pr_D) ≫ v_aut₀ μ :=
                congrArg (· ≫ v_aut₀ μ) hPb_V.flip.isoPullback_hom_fst.symm
          _ = e_sch.hom ≫ (Limits.pullback.fst ι₀ pr_D ≫ v_aut₀ μ) := Category.assoc _ _ _
          _ = e_sch.hom ≫ (b_μ ≫ Limits.pullback.fst ι₀ pr_D) := congrArg (e_sch.hom ≫ ·) hb_fst.symm
          _ = (e_sch.hom ≫ b_μ) ≫ Limits.pullback.fst ι₀ pr_D := (Category.assoc _ _ _).symm
      · calc
          (v_aut_bar μ ≫ e_sch.hom) ≫ Limits.pullback.snd ι₀ pr_D
            = v_aut_bar μ ≫ (e_sch.hom ≫ Limits.pullback.snd ι₀ pr_D) := Category.assoc _ _ _
          _ = v_aut_bar μ ≫ ι_bar := congrArg (v_aut_bar μ ≫ ·) hPb_V.flip.isoPullback_hom_snd
          _ = ι_bar := (hv_bar μ).1
          _ = e_sch.hom ≫ Limits.pullback.snd ι₀ pr_D := hPb_V.flip.isoPullback_hom_snd.symm
          _ = e_sch.hom ≫ (b_μ ≫ Limits.pullback.snd ι₀ pr_D) := congrArg (e_sch.hom ≫ ·) hb_snd.symm
          _ = (e_sch.hom ≫ b_μ) ≫ Limits.pullback.snd ι₀ pr_D := (Category.assoc _ _ _).symm
    exact (congrArg (fun f : V_bar ⟶ V_bar => f ≫ e_sch.hom) (hu_bar μ)).trans h_sch

  
  have hs_bar_eq_η : ∀ c : A,
      s_bar c = (𝒥_bar.obj.map (Opposite.op e_Vet.hom))
        ((η.hom.app (Opposite.op V₀_et)) (s_can c)) := by
    intro c
    let u_e : Limits.pullback (Fgt_S.obj V_bar_et).hom ι_bar ⟶
        Limits.pullback (Fgt_S.obj (B_pr.obj V₀_et)).hom ι_bar :=
      Limits.pullback.lift
        (Limits.pullback.fst (Fgt_S.obj V_bar_et).hom ι_bar ≫ (Fgt_S.map e_Vet.hom).left)
        (Limits.pullback.snd (Fgt_S.obj V_bar_et).hom ι_bar)
        (by rw [Category.assoc, Over.w (Fgt_S.map e_Vet.hom)]; exact Limits.pullback.condition)
    have hu_e_fst : u_e ≫ Limits.pullback.fst (Fgt_S.obj (B_pr.obj V₀_et)).hom ι_bar =
        Limits.pullback.fst (Fgt_S.obj V_bar_et).hom ι_bar ≫ (Fgt_S.map e_Vet.hom).left :=
      Limits.pullback.lift_fst _ _ _
    have hu_e_snd : u_e ≫ Limits.pullback.snd (Fgt_S.obj (B_pr.obj V₀_et)).hom ι_bar =
        Limits.pullback.snd (Fgt_S.obj V_bar_et).hom ι_bar :=
      Limits.pullback.lift_snd _ _ _
    apply (htriv_bar.2 V_bar_et).1
    ext y
    have hy : y ∈ (Set.univ : Set ↥(Limits.pullback (Fgt_S.obj V_bar_et).hom ι_bar)) := trivial
    rw [← hγ_bar_univ, Set.mem_iUnion] at hy
    rcases hy with ⟨τ, w, rfl⟩
    have h_chain : γ_bar τ ≫ u_e ≫ cmp_W V₀_et = fst_V ≫ γ₀ τ := by
      apply Limits.pullback.hom_ext
      · have h_ue_cmp_fst : (u_e ≫ cmp_W V₀_et) ≫ Limits.pullback.fst (Fgt₀.obj V₀_et).hom ι₀ =
            Limits.pullback.fst (Fgt_S.obj V_bar_et).hom ι_bar ≫ fst_V :=
          (Category.assoc u_e (cmp_W V₀_et) _).trans
            ((congrArg (u_e ≫ ·) (hcmp_W_fst V₀_et)).trans
              ((Category.assoc u_e _ _).symm.trans
                ((congrArg (· ≫ Limits.pullback.fst (Fgt₀.obj V₀_et).hom pr_D) hu_e_fst).trans
                  ((Category.assoc (Limits.pullback.fst (Fgt_S.obj V_bar_et).hom ι_bar)
                      (Fgt_S.map e_Vet.hom).left _).trans
                    (congrArg (Limits.pullback.fst (Fgt_S.obj V_bar_et).hom ι_bar ≫ ·)
                      he_Vet_fst)))))
        exact (Category.assoc (γ_bar τ) (u_e ≫ cmp_W V₀_et) _).trans
          ((congrArg (γ_bar τ ≫ ·) h_ue_cmp_fst).trans
            ((Category.assoc (γ_bar τ) _ fst_V).symm.trans
              ((congrArg (· ≫ fst_V) (hγ_bar τ).1).trans
                ((Category.id_comp fst_V).trans
                  ((Category.comp_id fst_V).symm.trans
                    ((congrArg (fst_V ≫ ·) (hγ₀ τ).1.symm).trans
                      (Category.assoc fst_V (γ₀ τ) _).symm))))))
      · have h_ue_cmp_snd : (u_e ≫ cmp_W V₀_et) ≫ Limits.pullback.snd (Fgt₀.obj V₀_et).hom ι₀ =
            Limits.pullback.snd (Fgt_S.obj V_bar_et).hom ι_bar ≫ fst_V :=
          (Category.assoc u_e (cmp_W V₀_et) _).trans
            ((congrArg (u_e ≫ ·) (hcmp_W_snd V₀_et)).trans
              ((Category.assoc u_e _ fst_V).symm.trans
                (congrArg (· ≫ fst_V) hu_e_snd)))
        exact (Category.assoc (γ_bar τ) (u_e ≫ cmp_W V₀_et) _).trans
          ((congrArg (γ_bar τ ≫ ·) h_ue_cmp_snd).trans
            ((Category.assoc (γ_bar τ) _ fst_V).symm.trans
              ((congrArg (· ≫ fst_V) (hγ_bar τ).2).trans
                (((hv_bar τ).2).trans
                  ((congrArg (fst_V ≫ ·) (hγ₀ τ).2.symm).trans
                    (Category.assoc fst_V (γ₀ τ) _).symm)))))
    have h_chain_b : (cmp_W V₀_et).base (u_e.base ((γ_bar τ).base w)) =
        (γ₀ τ).base (fst_V.base w) :=
      congrArg (fun k : V_bar ⟶ Limits.pullback (Fgt₀.obj V₀_et).hom ι₀ => k.base w) h_chain
    let s_η : ↑(𝒥_bar.obj.obj (Opposite.op (B_pr.obj V₀_et))) :=
      η_fun V₀_et (s_can c)
    have h_nat_e : triv_bar V_bar_et ((𝒥_bar.obj.map (Opposite.op e_Vet.hom)) s_η)
        ((γ_bar τ).base w) = triv_bar (B_pr.obj V₀_et) s_η (u_e.base ((γ_bar τ).base w)) :=
      htriv_bar.1 e_Vet.hom u_e (Limits.pullback.lift_fst _ _ _)
        (Limits.pullback.lift_snd _ _ _) s_η ((γ_bar τ).base w)
    have h_rhs_val : triv_bar V_bar_et ((𝒥_bar.obj.map (Opposite.op e_Vet.hom)) s_η)
        ((γ_bar τ).base w) = M_act τ c :=
      h_nat_e.trans
        ((hη_fun_spec V₀_et (s_can c) (u_e.base ((γ_bar τ).base w))).trans
          ((congrArg (triv₀ V₀_et (s_can c)) h_chain_b).trans
            (hs_can c τ (fst_V.base w))))
    exact (hs_bar c τ w).trans h_rhs_val.symm

  
  have hLiftCov : ∀ (W : D₀.Etale) (obj_W : Unit ⊕ A → D₀.Etale)
      (mor_W : ∀ idx : Unit ⊕ A, obj_W idx ⟶ W),
      (∀ idx : Unit ⊕ A, Etale (Fgt₀.map (mor_W idx)).left) →
      (∀ x : ↥(Fgt₀.obj W).left,
        ∃ (idx : Unit ⊕ A) (x_i : ↥(Fgt₀.obj (obj_W idx)).left),
          (Fgt₀.map (mor_W idx)).left.base x_i = x) →
      Sieve.generate
        (Presieve.ofArrows
          (fun idx => B_pr.obj (obj_W idx)) (fun idx => B_pr.map (mor_W idx))) ∈
        S.smallEtaleTopology (B_pr.obj W) := by
    intro W obj_W mor_W hEt_W hSurj_W
    rw [hMem_S (B_pr.obj W) _]
    intro e
    let h_W := (Fgt₀.obj W).hom
    let p_W := Limits.pullback.fst h_W pr_D
    let h_E := (Fgt_S.obj (B_pr.obj W)).hom
    obtain ⟨idx, x_i, hx_i⟩ := hSurj_W (p_W.base e)
    let W_i := obj_W idx
    let f_i := mor_W idx
    let h_Wi := (Fgt₀.obj W_i).hom
    let p_Wi := Limits.pullback.fst h_Wi pr_D
    let h_Ei := (Fgt_S.obj (B_pr.obj W_i)).hom
    let g_B := (Fgt_S.map (B_pr.map f_i)).left
    have hf_w : (Fgt₀.map f_i).left ≫ h_W = h_Wi := Over.w (Fgt₀.map f_i)
    have hg_snd : g_B ≫ h_E = h_Ei := Limits.pullback.lift_snd _ _ _
    have hg_fst : g_B ≫ p_W = p_Wi ≫ (Fgt₀.map f_i).left := Limits.pullback.lift_fst _ _ _
    have h_right : IsPullback h_E p_W pr_D h_W := (IsPullback.of_hasPullback h_W pr_D).flip
    have h_outer : IsPullback (g_B ≫ h_E) p_Wi pr_D ((Fgt₀.map f_i).left ≫ h_W) := by
      rw [hg_snd, hf_w]
      exact (IsPullback.of_hasPullback h_Wi pr_D).flip
    have h_left : IsPullback g_B p_Wi p_W (Fgt₀.map f_i).left :=
      IsPullback.of_right h_outer hg_fst h_right
    have hg_et : Etale g_B :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback h_left.flip (hEt_W idx)
    obtain ⟨z, hz_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback e x_i hx_i.symm
    refine ⟨B_pr.obj W_i, B_pr.map f_i, h_left.isoPullback.inv.base z,
      ⟨B_pr.obj W_i, 𝟙 _, B_pr.map f_i, Presieve.ofArrows.mk idx, Category.id_comp _⟩,
      hg_et, ?_⟩
    have h_inv : (h_left.isoPullback.inv ≫ g_B).base z =
        (Limits.pullback.fst p_W (Fgt₀.map f_i).left).base z :=
      congrArg (fun k : Limits.pullback p_W (Fgt₀.map f_i).left ⟶ (Fgt_S.obj (B_pr.obj W)).left =>
        k.base z) h_left.isoPullback_inv_fst
    exact h_inv.trans hz_fst

  
  
  
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let mkHom : ∀ {M : AddCommGrpCat.{u}}, ↑M → (Aℤ ⟶ M) := fun m =>
    AddCommGrpCat.ofHom
      { toFun := fun n => n.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }
  have hmk_comp : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (f : M₁ ⟶ M₂) (m : ↑M₁),
      mkHom m ≫ f = mkHom (f m) := by
    intro M₁ M₂ f m
    ext ⟨n⟩
    exact map_zsmul f.hom n m
  have hmk_one : ∀ {M : AddCommGrpCat.{u}} (m : ↑M),
      (mkHom m) (ULift.up (1 : ℤ)) = m :=
    fun m => one_zsmul m

  have hSheafExt : ∀ (𝒢 : Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      {E : S.Etale} (R : Sieve E),
      R ∈ S.smallEtaleTopology E →
      ∀ (x₁ x₂ : ↑(𝒢.obj.obj (Opposite.op E))),
        (∀ ⦃E' : S.Etale⦄ (v : E' ⟶ E),
          R.arrows v → (𝒢.obj.map (Opposite.op v)) x₁ = (𝒢.obj.map (Opposite.op v)) x₂) →
        x₁ = x₂ := by
    intro 𝒢 E R hR x₁ x₂ h_eq
    have ht : mkHom x₁ = mkHom x₂ := by
      refine (𝒢.property Aℤ R hR).isSeparatedFor.ext fun E' v hv => ?_
      change mkHom x₁ ≫ 𝒢.obj.map (Opposite.op v) = mkHom x₂ ≫ 𝒢.obj.map (Opposite.op v)
      rw [hmk_comp, hmk_comp]
      exact congrArg mkHom (h_eq v hv)
    rw [← hmk_one x₁, ← hmk_one x₂, ht]

  have hSubOfEmpty : ∀ (𝒢 : Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (Z : S.Etale),
      IsEmpty ↥(Fgt_S.obj Z).left →
      ∀ x₁ x₂ : ↑(𝒢.obj.obj (Opposite.op Z)), x₁ = x₂ := by
    intro 𝒢 Z hEmp x₁ x₂
    have hBot : (⊥ : Sieve Z) ∈ S.smallEtaleTopology Z :=
      (hMem_S Z ⊥).mpr fun x => hEmp.elim x
    exact hSheafExt 𝒢 ⊥ hBot x₁ x₂ fun _ _ hv => False.elim hv

  have hCovMem_S : ∀ {U : S.Etale} {ι_idx : Type} (obj_U : ι_idx → S.Etale)
      (mor_U : ∀ idx : ι_idx, obj_U idx ⟶ U),
      (∀ idx : ι_idx, Etale (Fgt_S.map (mor_U idx)).left) →
      (∀ x : ↥(Fgt_S.obj U).left,
        ∃ (idx : ι_idx) (x_i : ↥(Fgt_S.obj (obj_U idx)).left),
          (Fgt_S.map (mor_U idx)).left.base x_i = x) →
      Sieve.generate (Presieve.ofArrows obj_U mor_U) ∈ S.smallEtaleTopology U := by
    intro U ι_idx obj_U mor_U hEt hSurj
    rw [hMem_S U _]
    intro x
    obtain ⟨idx, x_i, hx_i⟩ := hSurj x
    exact ⟨obj_U idx, mor_U idx, x_i,
      ⟨obj_U idx, 𝟙 _, mor_U idx, Presieve.ofArrows.mk idx, Category.id_comp _⟩,
      hEt idx, hx_i⟩

  
  have hΨ_uniq : ∀ (𝒢 : Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (ψ₁ ψ₂ : 𝒥_bar ⟶ 𝒢),
      (∀ c : A,
        (ψ₁.hom.app (Opposite.op V_bar_et)) (s_bar c) =
          (ψ₂.hom.app (Opposite.op V_bar_et)) (s_bar c)) →
      ψ₁ = ψ₂ := by
    intro 𝒢 ψ₁ ψ₂ h_on_s
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U_op
    rcases U_op with ⟨U⟩
    apply AddCommGrpCat.ext
    intro t
    obtain ⟨obj_U, mor_U, hEt_U, hSurj_U, _, hj0_U, huc_U⟩ := hBarLevel U t
    let S_U := Sieve.generate (Presieve.ofArrows obj_U mor_U)
    have hSU_mem : S_U ∈ S.smallEtaleTopology U := hCovMem_S obj_U mor_U hEt_U hSurj_U
    refine hSheafExt 𝒢 S_U hSU_mem _ _ fun E' v hv => ?_
    rcases hv with ⟨W', k, f₀, hf₀, rfl⟩
    cases hf₀ with
    | mk idx =>
      rw [hPshComp 𝒢.obj k (mor_U idx), hPshComp 𝒢.obj k (mor_U idx)]
      congr 1
      have hnat₁ := congrArg (fun fn => fn t) (ψ₁.hom.naturality (Opposite.op (mor_U idx)))
      have hnat₂ := congrArg (fun fn => fn t) (ψ₂.hom.naturality (Opposite.op (mor_U idx)))
      change (ψ₁.hom.app (Opposite.op (obj_U idx)))
          ((𝒥_bar.obj.map (Opposite.op (mor_U idx))) t) =
        (𝒢.obj.map (Opposite.op (mor_U idx))) ((ψ₁.hom.app (Opposite.op U)) t) at hnat₁
      change (ψ₂.hom.app (Opposite.op (obj_U idx)))
          ((𝒥_bar.obj.map (Opposite.op (mor_U idx))) t) =
        (𝒢.obj.map (Opposite.op (mor_U idx))) ((ψ₂.hom.app (Opposite.op U)) t) at hnat₂
      rw [← hnat₁, ← hnat₂]
      cases idx with
      | inl u_unit =>
        cases u_unit
        rw [hj0_U, hHomZero, hHomZero]
      | inr c =>
        obtain ⟨_, q_c, _, _, _, hq_c_eq⟩ := huc_U c
        rw [hq_c_eq]
        have hq₁ := congrArg (fun fn => fn (s_bar c)) (ψ₁.hom.naturality (Opposite.op q_c))
        have hq₂ := congrArg (fun fn => fn (s_bar c)) (ψ₂.hom.naturality (Opposite.op q_c))
        change (ψ₁.hom.app (Opposite.op (obj_U (Sum.inr c))))
            ((𝒥_bar.obj.map (Opposite.op q_c)) (s_bar c)) =
          (𝒢.obj.map (Opposite.op q_c)) ((ψ₁.hom.app (Opposite.op V_bar_et)) (s_bar c)) at hq₁
        change (ψ₂.hom.app (Opposite.op (obj_U (Sum.inr c))))
            ((𝒥_bar.obj.map (Opposite.op q_c)) (s_bar c)) =
          (𝒢.obj.map (Opposite.op q_c)) ((ψ₂.hom.app (Opposite.op V_bar_et)) (s_bar c)) at hq₂
        rw [hq₁, hq₂, h_on_s c]

  
  have hΨ_ex : ∀ (𝒢 : Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (g : A →+ ↑(𝒢.obj.obj (Opposite.op V_bar_et))),
      (∀ (μ : Γ) (c : A),
        (𝒢.obj.map (Opposite.op (u_bar μ))) (g c) = g (M_act μ⁻¹ c)) →
      ∃ ψ : 𝒥_bar ⟶ 𝒢,
        ∀ c : A, (ψ.hom.app (Opposite.op V_bar_et)) (s_bar c) = g c := by
    intro 𝒢 g hg_eqv
    let IsLevelArrow : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U)))
        (Z : S.Etale) (w : Z ⟶ U) (val : ↑(𝒢.obj.obj (Opposite.op Z))), Prop :=
      fun U t Z w val =>
        let h_U := (Fgt_S.obj U).hom
        let U_V := Limits.pullback h_U ι_bar
        ((∀ y : ↥U_V,
            (Limits.pullback.fst h_U ι_bar).base y ∈ Set.range (Fgt_S.map w).left.base →
            triv_bar U t y = 0) ∧
          val = 0) ∨
        (∃ (c : A) (l : (Fgt_S.obj Z).left ⟶ U_V) (q_Z : Z ⟶ V_bar_et),
          l ≫ Limits.pullback.fst h_U ι_bar = (Fgt_S.map w).left ∧
          (Fgt_S.map q_Z).left = l ≫ Limits.pullback.snd h_U ι_bar ∧
          (∀ z : ↥(Fgt_S.obj Z).left, triv_bar U t (l.base z) = c) ∧
          val = (𝒢.obj.map (Opposite.op q_Z)) (g c))

    have hLevel_precomp : ∀ {U Z Z' : S.Etale} {t : ↑(𝒥_bar.obj.obj (Opposite.op U))}
        {w : Z ⟶ U} {val : ↑(𝒢.obj.obj (Opposite.op Z))} (k : Z' ⟶ Z),
        IsLevelArrow U t Z w val →
        IsLevelArrow U t Z' (k ≫ w) ((𝒢.obj.map (Opposite.op k)) val) := by
      intro U Z Z' t w val k hL
      rcases hL with ⟨hzero, rfl⟩ | ⟨c, l, q_Z, hl_fst, hq_left, hl_val, rfl⟩
      · left
        refine ⟨?_, hHomZero _⟩
        intro y hy
        rcases hy with ⟨z', hz'⟩
        exact hzero y ⟨(Fgt_S.map k).left.base z', hz'⟩
      · right
        refine ⟨c, (Fgt_S.map k).left ≫ l, k ≫ q_Z, ?_, ?_, ?_, ?_⟩
        · rw [Category.assoc, hl_fst]
          rfl
        · rw [Category.assoc, ← hq_left]
          rfl
        · intro z'
          exact hl_val ((Fgt_S.map k).left.base z')
        · exact (hPshComp 𝒢.obj k q_Z (g c)).symm

    have hRoofUniq : ∀ {U Z : S.Etale} {t : ↑(𝒥_bar.obj.obj (Opposite.op U))}
        {w : Z ⟶ U} {val₁ val₂ : ↑(𝒢.obj.obj (Opposite.op Z))},
        IsLevelArrow U t Z w val₁ →
        IsLevelArrow U t Z w val₂ →
        val₁ = val₂ := by
      intro U Z t w val₁ val₂ hL₁ hL₂
      let h_U := (Fgt_S.obj U).hom
      let U_V := Limits.pullback h_U ι_bar
      let f := triv_bar U t
      have hCollarVsLevel : ∀ {c : A} {l : (Fgt_S.obj Z).left ⟶ U_V} {q_Z : Z ⟶ V_bar_et},
          (∀ y : ↥U_V,
            (Limits.pullback.fst h_U ι_bar).base y ∈ Set.range (Fgt_S.map w).left.base →
            f y = 0) →
          l ≫ Limits.pullback.fst h_U ι_bar = (Fgt_S.map w).left →
          (∀ z : ↥(Fgt_S.obj Z).left, f (l.base z) = c) →
          (0 : ↑(𝒢.obj.obj (Opposite.op Z))) = (𝒢.obj.map (Opposite.op q_Z)) (g c) := by
        intro c l q_Z hzero hl_fst hl_val
        by_cases hc0 : c = 0
        · subst hc0
          exact ((congrArg (𝒢.obj.map (Opposite.op q_Z)) g.map_zero).trans
            (hHomZero (𝒢.obj.map (Opposite.op q_Z)))).symm
        · refine hSubOfEmpty 𝒢 Z ⟨fun z => hc0 ?_⟩ _ _
          have hy_rng : (Limits.pullback.fst h_U ι_bar).base (l.base z) ∈
              Set.range (Fgt_S.map w).left.base := by
            refine ⟨z, ?_⟩
            exact congrArg (fun m : (Fgt_S.obj Z).left ⟶ (Fgt_S.obj U).left => m.base z)
              hl_fst.symm
          exact (hl_val z).symm.trans (hzero (l.base z) hy_rng)
      rcases hL₁ with ⟨hzero₁, rfl⟩ | ⟨c₁, l₁, q₁, hl₁_fst, hq₁_left, hl₁_val, rfl⟩
      · rcases hL₂ with ⟨_, rfl⟩ | ⟨c₂, l₂, q₂, hl₂_fst, _, hl₂_val, rfl⟩
        · rfl
        · exact hCollarVsLevel hzero₁ hl₂_fst hl₂_val
      · rcases hL₂ with ⟨hzero₂, rfl⟩ | ⟨c₂, l₂, q₂, hl₂_fst, hq₂_left, hl₂_val, rfl⟩
        · exact (hCollarVsLevel hzero₂ hl₁_fst hl₁_val).symm
        · 
          let h_Z := (Fgt_S.obj Z).hom
          have : Etale h_Z := Z.prop
          let g₁ : (Fgt_S.obj Z).left ⟶ V_bar := l₁ ≫ Limits.pullback.snd h_U ι_bar
          let g₂ : (Fgt_S.obj Z).left ⟶ V_bar := l₂ ≫ Limits.pullback.snd h_U ι_bar
          have hg₁_ι : g₁ ≫ ι_bar = h_Z := by
            dsimp [g₁, h_U, h_Z]
            rw [← hq₁_left]
            exact Over.w (Fgt_S.map q₁)
          have hg₂_ι : g₂ ≫ ι_bar = h_Z := by
            dsimp [g₂, h_U, h_Z]
            rw [← hq₂_left]
            exact Over.w (Fgt_S.map q₂)
          let Z_V := Limits.pullback (g₁ ≫ ι_bar) ι_bar
          obtain ⟨δ_Z, hδ_Z, _, hUniv_Z, _⟩ := hSheets_bar (Fgt_S.obj Z).left g₁
          let diag₁₂ : (Fgt_S.obj Z).left ⟶ Z_V :=
            Limits.pullback.lift (𝟙 _) g₂
              (by rw [Category.id_comp, hg₁_ι, hg₂_ι])
          let P_μ : Γ → Scheme.{u} := fun μ => Limits.pullback diag₁₂ (δ_Z μ)
          let p_μ : ∀ μ : Γ, P_μ μ ⟶ (Fgt_S.obj Z).left :=
            fun μ => Limits.pullback.fst diag₁₂ (δ_Z μ)
          let r_μ : ∀ μ : Γ, P_μ μ ⟶ (Fgt_S.obj Z).left :=
            fun μ => Limits.pullback.snd diag₁₂ (δ_Z μ)
          have hp_et : ∀ μ : Γ, Etale (p_μ μ) := by
            intro μ
            have : Etale (δ_Z μ) := (hδ_Z μ).2.2.1
            infer_instance
          let P_et : Γ → S.Etale := fun μ =>
            letI : Etale (p_μ μ) := hp_et μ
            Scheme.Etale.mk (p_μ μ ≫ h_Z)
          let u_μ_Z : ∀ μ : Γ, P_et μ ⟶ Z := fun μ =>
            MorphismProperty.Over.homMk (p_μ μ) rfl
          have hSZ_surj : ∀ z : ↥(Fgt_S.obj Z).left,
              ∃ (μ : Γ) (x : ↥(P_μ μ)), (p_μ μ).base x = z := by
            intro z
            have hz : diag₁₂.base z ∈ (Set.univ : Set ↥Z_V) := trivial
            rw [← hUniv_Z, Set.mem_iUnion] at hz
            rcases hz with ⟨μ, z', hz'⟩
            obtain ⟨x, hx_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback z z' hz'.symm
            exact ⟨μ, x, hx_fst⟩
          let S_Z := Sieve.generate (Presieve.ofArrows P_et u_μ_Z)
          have hSZ_mem : S_Z ∈ S.smallEtaleTopology Z := by
            rw [hMem_S Z _]
            intro z
            obtain ⟨μ, x, hx⟩ := hSZ_surj z
            exact ⟨P_et μ, u_μ_Z μ, x,
              ⟨P_et μ, 𝟙 _, u_μ_Z μ, Presieve.ofArrows.mk μ, Category.id_comp _⟩,
              hp_et μ, hx⟩
          have hf_mem : f ∈ Set.range (triv_bar U) := ⟨t, rfl⟩
          rw [(htriv_bar.2 U).2] at hf_mem
          have hf_eqv := hf_mem.2
          have h_on_μ : ∀ μ : Γ,
              (𝒢.obj.map (Opposite.op (u_μ_Z μ))) ((𝒢.obj.map (Opposite.op q₁)) (g c₁)) =
                (𝒢.obj.map (Opposite.op (u_μ_Z μ))) ((𝒢.obj.map (Opposite.op q₂)) (g c₂)) := by
            intro μ
            have hpr_eq : p_μ μ = r_μ μ := by
              have hcond := congrArg (· ≫ Limits.pullback.fst (g₁ ≫ ι_bar) ι_bar)
                (Limits.pullback.condition (f := diag₁₂) (g := δ_Z μ))
              change (p_μ μ ≫ diag₁₂) ≫ Limits.pullback.fst (g₁ ≫ ι_bar) ι_bar =
                (r_μ μ ≫ δ_Z μ) ≫ Limits.pullback.fst (g₁ ≫ ι_bar) ι_bar at hcond
              rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id,
                Category.assoc, (hδ_Z μ).1, Category.comp_id] at hcond
              exact hcond
            have hg₂_eq : p_μ μ ≫ g₂ = p_μ μ ≫ g₁ ≫ v_aut_bar μ := by
              have hcond := congrArg (· ≫ Limits.pullback.snd (g₁ ≫ ι_bar) ι_bar)
                (Limits.pullback.condition (f := diag₁₂) (g := δ_Z μ))
              change (p_μ μ ≫ diag₁₂) ≫ Limits.pullback.snd (g₁ ≫ ι_bar) ι_bar =
                (r_μ μ ≫ δ_Z μ) ≫ Limits.pullback.snd (g₁ ≫ ι_bar) ι_bar at hcond
              rw [Category.assoc, Limits.pullback.lift_snd, Category.assoc,
                (hδ_Z μ).2.1, ← hpr_eq] at hcond
              exact hcond
            by_cases hc_eq : c₁ = M_act μ⁻¹ c₂
            · have hq_rel : u_μ_Z μ ≫ q₂ = (u_μ_Z μ ≫ q₁) ≫ u_bar μ := by
                apply MorphismProperty.Over.Hom.ext
                change p_μ μ ≫ (Fgt_S.map q₂).left =
                  (p_μ μ ≫ (Fgt_S.map q₁).left) ≫ (Fgt_S.map (u_bar μ)).left
                rw [hq₂_left, hq₁_left, hu_bar μ]
                change p_μ μ ≫ g₂ = (p_μ μ ≫ g₁) ≫ v_aut_bar μ
                rw [Category.assoc]
                exact hg₂_eq
              have h1 : g c₁ = (𝒢.obj.map (Opposite.op (u_bar μ))) (g c₂) :=
                (congrArg g hc_eq).trans (hg_eqv μ c₂).symm
              have h2 : (𝒢.obj.map (Opposite.op (u_μ_Z μ)))
                  ((𝒢.obj.map (Opposite.op q₁)) (g c₁)) =
                  (𝒢.obj.map (Opposite.op ((u_μ_Z μ ≫ q₁) ≫ u_bar μ))) (g c₂) :=
                (congrArg (𝒢.obj.map (Opposite.op (u_μ_Z μ)))
                  (congrArg (𝒢.obj.map (Opposite.op q₁)) h1)).trans
                  ((hPshComp 𝒢.obj (u_μ_Z μ) q₁ _).symm.trans
                    (hPshComp 𝒢.obj (u_μ_Z μ ≫ q₁) (u_bar μ) (g c₂)).symm)
              exact h2.trans
                ((congrArg (fun m => (𝒢.obj.map (Opposite.op m)) (g c₂)) hq_rel.symm).trans
                  (hPshComp 𝒢.obj (u_μ_Z μ) q₂ (g c₂)))
            · refine hSubOfEmpty 𝒢 (P_et μ) ⟨fun x => hc_eq ?_⟩ _ _
              let m_μ : U_V ⟶ U_V :=
                Limits.pullback.lift
                  (Limits.pullback.fst h_U ι_bar)
                  (Limits.pullback.snd h_U ι_bar ≫ v_aut_bar μ)
                  (by rw [Category.assoc, (hv_bar μ).1]; exact Limits.pullback.condition)
              have hl_rel : p_μ μ ≫ l₂ = p_μ μ ≫ l₁ ≫ m_μ := by
                apply Limits.pullback.hom_ext
                · dsimp [m_μ, h_U]
                  rw [Category.assoc, hl₂_fst, Category.assoc, Category.assoc,
                    Limits.pullback.lift_fst, hl₁_fst]
                · dsimp [m_μ, h_U]
                  rw [Category.assoc, Category.assoc, Category.assoc,
                    Limits.pullback.lift_snd, ← Category.assoc l₁]
                  exact hg₂_eq
              let z := (p_μ μ).base x
              have hl_b : l₂.base z = m_μ.base (l₁.base z) :=
                congrArg (fun k : P_μ μ ⟶ U_V => k.base x) hl_rel
              have hc₂_val : c₂ = M_act μ c₁ := by
                calc
                  c₂ = f (l₂.base z) := (hl₂_val z).symm
                  _ = f (m_μ.base (l₁.base z)) := congrArg f hl_b
                  _ = M_act μ (f (l₁.base z)) :=
                      hf_eqv μ m_μ (Limits.pullback.lift_fst _ _ _)
                        (Limits.pullback.lift_snd _ _ _) (l₁.base z)
                  _ = M_act μ c₁ := congrArg (M_act μ) (hl₁_val z)
              calc
                c₁ = (AddMonoidHom.id A) c₁ := rfl
                _ = (M_act 1) c₁ := by rw [hM_one]
                _ = (M_act (μ⁻¹ * μ)) c₁ := by rw [inv_mul_cancel]
                _ = M_act μ⁻¹ (M_act μ c₁) := by rw [hM_mul, AddMonoidHom.comp_apply]
                _ = M_act μ⁻¹ c₂ := by rw [← hc₂_val]
          refine hSheafExt 𝒢 S_Z hSZ_mem _ _ fun E' v hv => ?_
          rcases hv with ⟨W', k, f₀, hf₀, rfl⟩
          cases hf₀ with
          | mk μ =>
            exact (hPshComp 𝒢.obj k (u_μ_Z μ) _).trans
              ((congrArg (𝒢.obj.map (Opposite.op k)) (h_on_μ μ)).trans
                (hPshComp 𝒢.obj k (u_μ_Z μ) _).symm)

    
    let P_𝒢 := 𝒢.obj ⋙ coyoneda.obj (Opposite.op Aℤ)
    let cov_Sieve : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U))), Sieve U :=
      fun U t =>
        Sieve.generate
          (Presieve.ofArrows
            (Classical.choose (hBarLevel U t))
            (Classical.choose (Classical.choose_spec (hBarLevel U t))))

    have hCov_mem : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U))),
        cov_Sieve U t ∈ S.smallEtaleTopology U := by
      intro U t
      let spec := Classical.choose_spec (Classical.choose_spec (hBarLevel U t))
      exact hCovMem_S _ _ spec.1 spec.2.1

    have hCov_hasLevel : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U)))
        {Y : S.Etale} (v : Y ⟶ U),
        (cov_Sieve U t).arrows v →
        ∃ val : ↑(𝒢.obj.obj (Opposite.op Y)), IsLevelArrow U t Y v val := by
      intro U t Y v hv
      let spec := Classical.choose_spec (Classical.choose_spec (hBarLevel U t))
      rcases hv with ⟨W', k, f₀, hf₀, rfl⟩
      cases hf₀ with
      | mk idx =>
        cases idx with
        | inl u_unit =>
          cases u_unit
          refine ⟨0, ?_⟩
          have h0 : IsLevelArrow U t _ _ 0 := Or.inl ⟨spec.2.2.1, rfl⟩
          have hk := hLevel_precomp k h0
          rwa [hHomZero] at hk
        | inr c =>
          obtain ⟨l_c, q_c, hl_fst, hq_left, hl_val, _⟩ := spec.2.2.2.2 c
          have hc : IsLevelArrow U t _ _ ((𝒢.obj.map (Opposite.op q_c)) (g c)) :=
            Or.inr ⟨c, l_c, q_c, hl_fst, hq_left, hl_val, rfl⟩
          exact ⟨_, hLevel_precomp k hc⟩

    let fam_of : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U))),
        Presieve.FamilyOfElements P_𝒢 (cov_Sieve U t).arrows :=
      fun U t _ v hv => mkHom (Classical.choose (hCov_hasLevel U t v hv))

    have hfam_compat : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U))),
        (fam_of U t).Compatible := by
      intro U t Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      change fam_of U t f₁ hf₁ ≫ 𝒢.obj.map (Opposite.op g₁) =
        fam_of U t f₂ hf₂ ≫ 𝒢.obj.map (Opposite.op g₂)
      dsimp only [fam_of]
      rw [hmk_comp, hmk_comp]
      congr 1
      have h₁ := hLevel_precomp g₁ (Classical.choose_spec (hCov_hasLevel U t f₁ hf₁))
      have h₂ := hLevel_precomp g₂ (Classical.choose_spec (hCov_hasLevel U t f₂ hf₂))
      rw [← hcomm] at h₂
      exact hRoofUniq h₁ h₂

    let psi_hom : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U))),
        Aℤ ⟶ 𝒢.obj.obj (Opposite.op U) :=
      fun U t =>
        (𝒢.property Aℤ (cov_Sieve U t) (hCov_mem U t)).amalgamate
          (fam_of U t) (hfam_compat U t)

    let psi_fun : ∀ (U : S.Etale),
        ↑(𝒥_bar.obj.obj (Opposite.op U)) → ↑(𝒢.obj.obj (Opposite.op U)) :=
      fun U t => (psi_hom U t) (ULift.up (1 : ℤ))

    have hPsi_on_cov : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U)))
        {Y : S.Etale} (v : Y ⟶ U) (hv : (cov_Sieve U t).arrows v),
        (𝒢.obj.map (Opposite.op v)) (psi_fun U t) =
          Classical.choose (hCov_hasLevel U t v hv) := by
      intro U t Y v hv
      have hglue : psi_hom U t ≫ 𝒢.obj.map (Opposite.op v) = fam_of U t v hv :=
        (𝒢.property Aℤ (cov_Sieve U t) (hCov_mem U t)).valid_glue
          (hfam_compat U t) v hv
      have h1 := congrArg (fun k : Aℤ ⟶ 𝒢.obj.obj (Opposite.op Y) => k (ULift.up (1 : ℤ))) hglue
      change (𝒢.obj.map (Opposite.op v)) (psi_fun U t) =
        (mkHom (Classical.choose (hCov_hasLevel U t v hv))) (ULift.up (1 : ℤ)) at h1
      rwa [hmk_one] at h1

    have hPsiChar : ∀ (U : S.Etale) (t : ↑(𝒥_bar.obj.obj (Opposite.op U)))
        (Z : S.Etale) (w : Z ⟶ U) (val : ↑(𝒢.obj.obj (Opposite.op Z))),
        IsLevelArrow U t Z w val →
        (𝒢.obj.map (Opposite.op w)) (psi_fun U t) = val := by
      intro U t Z w val hL
      let S_pb := (cov_Sieve U t).pullback w
      have hSpb_mem : S_pb ∈ S.smallEtaleTopology Z :=
        S.smallEtaleTopology.pullback_stable w (hCov_mem U t)
      refine hSheafExt 𝒢 S_pb hSpb_mem _ _ fun Z' k hk => ?_
      have hkw : (cov_Sieve U t).arrows (k ≫ w) := hk
      have h_lhs : (𝒢.obj.map (Opposite.op k)) ((𝒢.obj.map (Opposite.op w)) (psi_fun U t)) =
          Classical.choose (hCov_hasLevel U t (k ≫ w) hkw) := by
        rw [← hPshComp 𝒢.obj k w]
        exact hPsi_on_cov U t (k ≫ w) hkw
      rw [h_lhs]
      exact hRoofUniq (Classical.choose_spec (hCov_hasLevel U t (k ≫ w) hkw))
        (hLevel_precomp k hL)

    have hPsi_zero : ∀ U : S.Etale, psi_fun U 0 = 0 := by
      intro U
      have h0 : IsLevelArrow U 0 U (𝟙 U) 0 := by
        left
        refine ⟨fun y _ => ?_, rfl⟩
        rw [map_zero, LocallyConstant.zero_apply]
      have h := hPsiChar U 0 U (𝟙 U) 0 h0
      rwa [hPshId 𝒢.obj U] at h

    have hPsi_add : ∀ (U : S.Etale) (t₁ t₂ : ↑(𝒥_bar.obj.obj (Opposite.op U))),
        psi_fun U (t₁ + t₂) = psi_fun U t₁ + psi_fun U t₂ := by
      intro U t₁ t₂
      let h_U := (Fgt_S.obj U).hom
      have : Etale h_U := U.prop
      let U_V := Limits.pullback h_U ι_bar
      let fst_U := Limits.pullback.fst h_U ι_bar
      let snd_U := Limits.pullback.snd h_U ι_bar
      let f₁ := triv_bar U t₁
      let f₂ := triv_bar U t₂
      have hf₁_mem : f₁ ∈ Set.range (triv_bar U) := ⟨t₁, rfl⟩
      have hf₂_mem : f₂ ∈ Set.range (triv_bar U) := ⟨t₂, rfl⟩
      rw [(htriv_bar.2 U).2] at hf₁_mem hf₂_mem
      rcases hf₁_mem.1 with ⟨W₀₁, hW₀₁_top, hW₀₁_zero⟩
      rcases hf₂_mem.1 with ⟨W₀₂, hW₀₂_top, hW₀₂_zero⟩
      let W₀ := W₀₁ ⊓ W₀₂
      have hW₀_top : ((TopologicalSpace.Opens.map h_U.base).obj U_bar) ⊔ W₀ = ⊤ := by
        ext x
        simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top,
          Set.mem_union, Set.mem_univ, iff_true]
        have hx₁ : x ∈ (⊤ : (Fgt_S.obj U).left.Opens) := trivial
        have hx₂ : x ∈ (⊤ : (Fgt_S.obj U).left.Opens) := trivial
        rw [← hW₀₁_top] at hx₁
        rw [← hW₀₂_top] at hx₂
        rcases hx₁ with hU₁ | hw₁
        · exact Or.inl hU₁
        · rcases hx₂ with hU₂ | hw₂
          · exact Or.inl hU₂
          · exact Or.inr ⟨hw₁, hw₂⟩
      let O_pair : A × A → U_V.Opens := fun p =>
        ⟨f₁ ⁻¹' {p.1} ∩ f₂ ⁻¹' {p.2},
          (f₁.isLocallyConstant {p.1}).inter (f₂.isLocallyConstant {p.2})⟩
      let obj_J : Unit ⊕ (A × A) → S.Etale := fun idx =>
        match idx with
        | Sum.inl () => Scheme.Etale.mk (W₀.ι ≫ h_U)
        | Sum.inr p => Scheme.Etale.mk (((O_pair p).ι ≫ fst_U) ≫ h_U)
      let mor_J : ∀ idx : Unit ⊕ (A × A), obj_J idx ⟶ U := fun idx =>
        match idx with
        | Sum.inl () => MorphismProperty.Over.homMk W₀.ι rfl
        | Sum.inr p => MorphismProperty.Over.homMk ((O_pair p).ι ≫ fst_U) rfl
      have hEt_J : ∀ idx : Unit ⊕ (A × A), Etale (Fgt_S.map (mor_J idx)).left := by
        intro idx
        cases idx with
        | inl u_unit =>
          cases u_unit
          change Etale W₀.ι
          infer_instance
        | inr p =>
          change Etale ((O_pair p).ι ≫ fst_U)
          infer_instance
      have hSurj_J : ∀ x : ↥(Fgt_S.obj U).left,
          ∃ (idx : Unit ⊕ (A × A)) (x_i : ↥(Fgt_S.obj (obj_J idx)).left),
            (Fgt_S.map (mor_J idx)).left.base x_i = x := by
        intro x
        have hx_top : x ∈ (⊤ : (Fgt_S.obj U).left.Opens) := trivial
        rw [← hW₀_top] at hx_top
        rcases hx_top with hxU | hxW₀
        · change h_U.base x ∈ (U_bar : Set ↥S) at hxU
          rw [← hRange_bar] at hxU
          rcases hxU with ⟨v₀, hv₀⟩
          obtain ⟨y₀, hy₀_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback x v₀ hv₀.symm
          refine ⟨Sum.inr (f₁ y₀, f₂ y₀), ⟨y₀, ⟨rfl, rfl⟩⟩, hy₀_fst⟩
        · exact ⟨Sum.inl (), ⟨x, hxW₀⟩, rfl⟩
      let S_J := Sieve.generate (Presieve.ofArrows obj_J mor_J)
      have hSJ_mem : S_J ∈ S.smallEtaleTopology U := hCovMem_S obj_J mor_J hEt_J hSurj_J
      refine hSheafExt 𝒢 S_J hSJ_mem _ _ fun E' v hv => ?_
      rcases hv with ⟨W', k, f₀, hf₀, rfl⟩
      cases hf₀ with
      | mk idx =>
        rw [hPshComp 𝒢.obj k (mor_J idx), hPshComp 𝒢.obj k (mor_J idx)]
        congr 1
        rw [hHomAdd]
        cases idx with
        | inl u_unit =>
          cases u_unit
          have hw_mem : ∀ y : ↥U_V,
              fst_U.base y ∈ Set.range (Fgt_S.map (mor_J (Sum.inl ()))).left.base →
              fst_U.base y ∈ W₀₁ ∧ fst_U.base y ∈ W₀₂ := by
            intro y hy
            rcases hy with ⟨x₀, hx₀⟩
            have hmem : W₀.ι.base x₀ ∈ Set.range W₀.ι.base := ⟨x₀, rfl⟩
            rw [W₀.range_ι] at hmem
            rw [← hx₀]
            exact hmem
          have hL₁ : IsLevelArrow U t₁ _ (mor_J (Sum.inl ())) 0 :=
            Or.inl ⟨fun y hy => hW₀₁_zero y (hw_mem y hy).1, rfl⟩
          have hL₂ : IsLevelArrow U t₂ _ (mor_J (Sum.inl ())) 0 :=
            Or.inl ⟨fun y hy => hW₀₂_zero y (hw_mem y hy).2, rfl⟩
          have hL₁₂ : IsLevelArrow U (t₁ + t₂) _ (mor_J (Sum.inl ())) 0 := by
            refine Or.inl ⟨fun y hy => ?_, rfl⟩
            rw [map_add, LocallyConstant.add_apply,
              hW₀₁_zero y (hw_mem y hy).1, hW₀₂_zero y (hw_mem y hy).2, add_zero]
          rw [hPsiChar _ _ _ _ _ hL₁₂, hPsiChar _ _ _ _ _ hL₁, hPsiChar _ _ _ _ _ hL₂, add_zero]
        | inr p =>
          let l_p : (O_pair p).toScheme ⟶ U_V := (O_pair p).ι
          let q_p : obj_J (Sum.inr p) ⟶ V_bar_et :=
            MorphismProperty.Over.homMk ((O_pair p).ι ≫ snd_U)
              (by
                change ((O_pair p).ι ≫ snd_U) ≫ ι_bar = ((O_pair p).ι ≫ fst_U) ≫ h_U
                rw [Category.assoc, Category.assoc, Limits.pullback.condition])
          have hp_vals : ∀ z : ↥(O_pair p).toScheme,
              f₁ (l_p.base z) = p.1 ∧ f₂ (l_p.base z) = p.2 := by
            intro z
            have hz : l_p.base z ∈ Set.range (O_pair p).ι.base := ⟨z, rfl⟩
            rwa [(O_pair p).range_ι] at hz
          have hL₁ : IsLevelArrow U t₁ _ (mor_J (Sum.inr p))
              ((𝒢.obj.map (Opposite.op q_p)) (g p.1)) :=
            Or.inr ⟨p.1, l_p, q_p, rfl, rfl, fun z => (hp_vals z).1, rfl⟩
          have hL₂ : IsLevelArrow U t₂ _ (mor_J (Sum.inr p))
              ((𝒢.obj.map (Opposite.op q_p)) (g p.2)) :=
            Or.inr ⟨p.2, l_p, q_p, rfl, rfl, fun z => (hp_vals z).2, rfl⟩
          have hL₁₂ : IsLevelArrow U (t₁ + t₂) _ (mor_J (Sum.inr p))
              ((𝒢.obj.map (Opposite.op q_p)) (g (p.1 + p.2))) := by
            refine Or.inr ⟨p.1 + p.2, l_p, q_p, rfl, rfl, fun z => ?_, rfl⟩
            have h_add : triv_bar U (t₁ + t₂) (l_p.base z) =
                f₁ (l_p.base z) + f₂ (l_p.base z) :=
              (congrArg (fun fn => fn (l_p.base z)) ((triv_bar U).map_add t₁ t₂)).trans
                (LocallyConstant.add_apply f₁ f₂ (l_p.base z))
            exact h_add.trans (congrArg₂ (· + ·) (hp_vals z).1 (hp_vals z).2)
          exact (hPsiChar _ _ _ _ _ hL₁₂).trans
            ((congrArg (𝒢.obj.map (Opposite.op q_p)) (g.map_add p.1 p.2)).trans
              ((hHomAdd (𝒢.obj.map (Opposite.op q_p)) (g p.1) (g p.2)).trans
                (congrArg₂ (· + ·)
                  (hPsiChar _ _ _ _ _ hL₁).symm
                  (hPsiChar _ _ _ _ _ hL₂).symm)))

    have hPsi_nat : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂)
        (t : ↑(𝒥_bar.obj.obj (Opposite.op U₂))),
        psi_fun U₁ ((𝒥_bar.obj.map (Opposite.op u)) t) =
          (𝒢.obj.map (Opposite.op u)) (psi_fun U₂ t) := by
      intro U₁ U₂ u t
      let S_pb := (cov_Sieve U₂ t).pullback u
      have hSpb_mem : S_pb ∈ S.smallEtaleTopology U₁ :=
        S.smallEtaleTopology.pullback_stable u (hCov_mem U₂ t)
      let h₁ := (Fgt_S.obj U₁).hom
      let h₂ := (Fgt_S.obj U₂).hom
      let u_V : Limits.pullback h₁ ι_bar ⟶ Limits.pullback h₂ ι_bar :=
        Limits.pullback.lift
          (Limits.pullback.fst h₁ ι_bar ≫ (Fgt_S.map u).left)
          (Limits.pullback.snd h₁ ι_bar)
          (by
            dsimp [h₁, h₂]
            rw [Category.assoc, Over.w (Fgt_S.map u)]
            exact Limits.pullback.condition)
      refine hSheafExt 𝒢 S_pb hSpb_mem _ _ fun Z k hk => ?_
      have hku : (cov_Sieve U₂ t).arrows (k ≫ u) := hk
      obtain ⟨val, hL₂⟩ := hCov_hasLevel U₂ t (k ≫ u) hku
      have hL₁ : IsLevelArrow U₁ ((𝒥_bar.obj.map (Opposite.op u)) t) Z k val := by
        rcases hL₂ with ⟨hzero₂, rfl⟩ | ⟨c, l₂, q_Z, hl₂_fst, hq_left, hl₂_val, rfl⟩
        · left
          refine ⟨fun y₁ hy₁ => ?_, rfl⟩
          rw [htriv_bar.1 u u_V (Limits.pullback.lift_fst _ _ _)
            (Limits.pullback.lift_snd _ _ _) t y₁]
          rcases hy₁ with ⟨z, hz⟩
          apply hzero₂ (u_V.base y₁)
          refine ⟨z, ?_⟩
          have h_fst_b : (Limits.pullback.fst h₂ ι_bar).base (u_V.base y₁) =
              (Fgt_S.map u).left.base ((Limits.pullback.fst h₁ ι_bar).base y₁) :=
            congrArg (fun m : Limits.pullback h₁ ι_bar ⟶ (Fgt_S.obj U₂).left => m.base y₁)
              (Limits.pullback.lift_fst _ _ _)
          rw [h_fst_b, ← hz]
          rfl
        · right
          let l₁ : (Fgt_S.obj Z).left ⟶ Limits.pullback h₁ ι_bar :=
            Limits.pullback.lift
              (Fgt_S.map k).left
              (l₂ ≫ Limits.pullback.snd (Fgt_S.obj U₂).hom ι_bar)
              (by
                dsimp [h₁]
                rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hl₂_fst]
                change (Fgt_S.map k).left ≫ (Fgt_S.obj U₁).hom =
                  ((Fgt_S.map k).left ≫ (Fgt_S.map u).left) ≫ (Fgt_S.obj U₂).hom
                rw [Category.assoc, Over.w (Fgt_S.map u)])
          have hl₁_uV : l₁ ≫ u_V = l₂ := by
            apply Limits.pullback.hom_ext
            · dsimp [l₁, u_V, h₁, h₂]
              rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
                Limits.pullback.lift_fst, hl₂_fst]
              rfl
            · dsimp [l₁, u_V, h₁, h₂]
              rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
          refine ⟨c, l₁, q_Z, Limits.pullback.lift_fst _ _ _, ?_, ?_, rfl⟩
          · rw [hq_left]
            exact (Limits.pullback.lift_snd _ _ _).symm
          · intro z
            rw [htriv_bar.1 u u_V (Limits.pullback.lift_fst _ _ _)
              (Limits.pullback.lift_snd _ _ _) t (l₁.base z)]
            have hb : u_V.base (l₁.base z) = l₂.base z :=
              congrArg (fun m : (Fgt_S.obj Z).left ⟶ Limits.pullback h₂ ι_bar => m.base z) hl₁_uV
            rw [hb, hl₂_val z]
      have h_rhs : (𝒢.obj.map (Opposite.op k)) ((𝒢.obj.map (Opposite.op u)) (psi_fun U₂ t)) = val := by
        rw [← hPshComp 𝒢.obj k u]
        exact hPsiChar U₂ t Z (k ≫ u) val hL₂
      rw [hPsiChar U₁ _ Z k val hL₁, h_rhs]

    let ψ : 𝒥_bar ⟶ 𝒢 :=
      { hom :=
          { app := fun U_op =>
              AddCommGrpCat.ofHom
                { toFun := psi_fun U_op.unop
                  map_zero' := hPsi_zero U_op.unop
                  map_add' := hPsi_add U_op.unop }
            naturality := by
              intro U₂_op U₁_op u_op
              rcases U₂_op with ⟨U₂⟩
              rcases U₁_op with ⟨U₁⟩
              apply AddCommGrpCat.ext
              intro t
              exact hPsi_nat u_op.unop t } }

    refine ⟨ψ, fun c => ?_⟩
    change psi_fun V_bar_et (s_bar c) = g c
    have hL_can : IsLevelArrow V_bar_et (s_bar c) V_bar_et (𝟙 V_bar_et) (g c) := by
      right
      refine ⟨c, γ_bar 1, 𝟙 V_bar_et, (hγ_bar 1).1, ?_, ?_, ?_⟩
      · change 𝟙 V_bar = γ_bar 1 ≫ Limits.pullback.snd ((Scheme.Etale.forget S).obj (Scheme.Etale.mk ι_bar)).hom ι_bar
        rw [(hγ_bar 1).2, hv_bar_one]
      · intro w
        change triv_bar (Scheme.Etale.mk ι_bar) (s_bar c) ((γ_bar 1).base w) = c
        rw [hs_bar c 1 w, hM_one, AddMonoidHom.id_apply]
      · exact (hPshId 𝒢.obj V_bar_et (g c)).symm
    have h := hPsiChar V_bar_et (s_bar c) V_bar_et (𝟙 V_bar_et) (g c) hL_can
    rwa [hPshId 𝒢.obj V_bar_et] at h

  
  
  
  have hThetaBij : ∀ 𝒢 : Sheaf S.smallEtaleTopology AddCommGrpCat.{u},
      Function.Bijective (fun ψ : 𝒥_bar ⟶ 𝒢 => η ≫ R_pr.map ψ) := by
    intro 𝒢
    constructor
    · 
      intro ψ₁ ψ₂ h_eq
      refine hΨ_uniq 𝒢 ψ₁ ψ₂ fun c => ?_
      have h_at_V₀ := congrArg
        (fun φ : 𝒥₀ ⟶ R_pr.obj 𝒢 =>
          (𝒢.obj.map (Opposite.op e_Vet.hom))
            ((φ.hom.app (Opposite.op V₀_et)) (s_can c)))
        h_eq
      change (𝒢.obj.map (Opposite.op e_Vet.hom))
          ((ψ₁.hom.app (Opposite.op (B_pr.obj V₀_et)))
            ((η.hom.app (Opposite.op V₀_et)) (s_can c))) =
        (𝒢.obj.map (Opposite.op e_Vet.hom))
          ((ψ₂.hom.app (Opposite.op (B_pr.obj V₀_et)))
            ((η.hom.app (Opposite.op V₀_et)) (s_can c))) at h_at_V₀
      have hnat₁ := congrArg
        (fun fn => fn ((η.hom.app (Opposite.op V₀_et)) (s_can c)))
        (ψ₁.hom.naturality (Opposite.op e_Vet.hom))
      have hnat₂ := congrArg
        (fun fn => fn ((η.hom.app (Opposite.op V₀_et)) (s_can c)))
        (ψ₂.hom.naturality (Opposite.op e_Vet.hom))
      change (ψ₁.hom.app (Opposite.op V_bar_et))
          ((𝒥_bar.obj.map (Opposite.op e_Vet.hom))
            ((η.hom.app (Opposite.op V₀_et)) (s_can c))) =
        (𝒢.obj.map (Opposite.op e_Vet.hom))
          ((ψ₁.hom.app (Opposite.op (B_pr.obj V₀_et)))
            ((η.hom.app (Opposite.op V₀_et)) (s_can c))) at hnat₁
      change (ψ₂.hom.app (Opposite.op V_bar_et))
          ((𝒥_bar.obj.map (Opposite.op e_Vet.hom))
            ((η.hom.app (Opposite.op V₀_et)) (s_can c))) =
        (𝒢.obj.map (Opposite.op e_Vet.hom))
          ((ψ₂.hom.app (Opposite.op (B_pr.obj V₀_et)))
            ((η.hom.app (Opposite.op V₀_et)) (s_can c))) at hnat₂
      rw [← hs_bar_eq_η c] at hnat₁ hnat₂
      exact hnat₁.trans (h_at_V₀.trans hnat₂.symm)
    · 
      intro φ
      let g : A →+ ↑(𝒢.obj.obj (Opposite.op V_bar_et)) :=
        ((𝒢.obj.map (Opposite.op e_Vet.hom)).hom.comp
          (φ.hom.app (Opposite.op V₀_et)).hom).comp s_can
      have hg_eqv : ∀ (μ : Γ) (c : A),
          (𝒢.obj.map (Opposite.op (u_bar μ))) (g c) = g (M_act μ⁻¹ c) := by
        intro μ c
        let x₀ : ↑(𝒢.obj.obj (Opposite.op (B_pr.obj V₀_et))) :=
          (φ.hom.app (Opposite.op V₀_et)) (s_can c)
        have hφ_nat : (φ.hom.app (Opposite.op V₀_et))
            ((𝒥₀.obj.map (Opposite.op (u_aut μ))) (s_can c)) =
          (𝒢.obj.map (Opposite.op (B_pr.map (u_aut μ)))) x₀ :=
          congrArg (fun fn => fn (s_can c))
            (φ.hom.naturality (Opposite.op (u_aut μ)))
        have hφ_eq : (𝒢.obj.map (Opposite.op (B_pr.map (u_aut μ)))) x₀ =
            (φ.hom.app (Opposite.op V₀_et)) (s_can (M_act μ⁻¹ c)) :=
          hφ_nat.symm.trans (congrArg (φ.hom.app (Opposite.op V₀_et)) (hs_can_deck μ c))
        exact (hPshComp 𝒢.obj (u_bar μ) e_Vet.hom x₀).symm.trans
          ((congrArg (fun m => (𝒢.obj.map (Opposite.op m)) x₀) (hu_bar_inter μ)).trans
            ((hPshComp 𝒢.obj e_Vet.hom (B_pr.map (u_aut μ)) x₀).trans
              (congrArg (𝒢.obj.map (Opposite.op e_Vet.hom)) hφ_eq)))
      obtain ⟨ψ, hψ⟩ := hΨ_ex 𝒢 g hg_eqv
      refine ⟨ψ, ?_⟩
      have h_on_V₀ : ∀ c : A,
          ((η ≫ R_pr.map ψ).hom.app (Opposite.op V₀_et)) (s_can c) =
            (φ.hom.app (Opposite.op V₀_et)) (s_can c) := by
        intro c
        have h_inv := congrArg (𝒢.obj.map (Opposite.op e_Vet.inv)) (hψ c)
        let x₀ : ↑(𝒢.obj.obj (Opposite.op (B_pr.obj V₀_et))) :=
          (φ.hom.app (Opposite.op V₀_et)) (s_can c)
        have h_rhs : (𝒢.obj.map (Opposite.op e_Vet.inv)) (g c) = x₀ :=
          (hPshComp 𝒢.obj e_Vet.inv e_Vet.hom x₀).symm.trans
            ((congrArg (fun m => (𝒢.obj.map (Opposite.op m)) x₀) e_Vet.inv_hom_id).trans
              (hPshId 𝒢.obj (B_pr.obj V₀_et) x₀))
        have hψ_nat : (ψ.hom.app (Opposite.op (B_pr.obj V₀_et)))
            ((𝒥_bar.obj.map (Opposite.op e_Vet.inv)) (s_bar c)) =
          (𝒢.obj.map (Opposite.op e_Vet.inv))
            ((ψ.hom.app (Opposite.op V_bar_et)) (s_bar c)) :=
          congrArg (fun fn => fn (s_bar c))
            (ψ.hom.naturality (Opposite.op e_Vet.inv))
        let y₀ : ↑(𝒥_bar.obj.obj (Opposite.op (B_pr.obj V₀_et))) :=
          (η.hom.app (Opposite.op V₀_et)) (s_can c)
        have hs_inv : (𝒥_bar.obj.map (Opposite.op e_Vet.inv)) (s_bar c) = y₀ :=
          (congrArg (𝒥_bar.obj.map (Opposite.op e_Vet.inv)) (hs_bar_eq_η c)).trans
            ((hPshComp 𝒥_bar.obj e_Vet.inv e_Vet.hom y₀).symm.trans
              ((congrArg (fun m => (𝒥_bar.obj.map (Opposite.op m)) y₀) e_Vet.inv_hom_id).trans
                (hPshId 𝒥_bar.obj (B_pr.obj V₀_et) y₀)))
        exact (congrArg (ψ.hom.app (Opposite.op (B_pr.obj V₀_et))) hs_inv.symm).trans
          (hψ_nat.trans (h_inv.trans h_rhs))
      dsimp only
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext W_op
      rcases W_op with ⟨W⟩
      apply AddCommGrpCat.ext
      intro s
      obtain ⟨obj_W, mor_W, hEt_W, hSurj_W, _, hj0_W, huc_W⟩ := hBaseLevel W s
      let S_BW := Sieve.generate
        (Presieve.ofArrows (fun idx => B_pr.obj (obj_W idx)) (fun idx => B_pr.map (mor_W idx)))
      have hSBW_mem : S_BW ∈ S.smallEtaleTopology (B_pr.obj W) :=
        hLiftCov W obj_W mor_W hEt_W hSurj_W
      let lhs_W : ↑(𝒢.obj.obj (Opposite.op (B_pr.obj W))) :=
        ((η ≫ R_pr.map ψ).hom.app (Opposite.op W)) s
      let rhs_W : ↑(𝒢.obj.obj (Opposite.op (B_pr.obj W))) :=
        (φ.hom.app (Opposite.op W)) s
      refine hSheafExt 𝒢 S_BW hSBW_mem lhs_W rhs_W fun E' v hv => ?_
      rcases hv with ⟨W', k, f₀, hf₀, rfl⟩
      cases hf₀ with
      | mk idx =>
        have h_idx : (𝒢.obj.map (Opposite.op (B_pr.map (mor_W idx)))) lhs_W =
            (𝒢.obj.map (Opposite.op (B_pr.map (mor_W idx)))) rhs_W := by
          have hnat₁ : ((η ≫ R_pr.map ψ).hom.app (Opposite.op (obj_W idx)))
              ((𝒥₀.obj.map (Opposite.op (mor_W idx))) s) =
            (𝒢.obj.map (Opposite.op (B_pr.map (mor_W idx)))) lhs_W :=
            congrArg (fun fn => fn s)
              ((η ≫ R_pr.map ψ).hom.naturality (Opposite.op (mor_W idx)))
          have hnat₂ : (φ.hom.app (Opposite.op (obj_W idx)))
              ((𝒥₀.obj.map (Opposite.op (mor_W idx))) s) =
            (𝒢.obj.map (Opposite.op (B_pr.map (mor_W idx)))) rhs_W :=
            congrArg (fun fn => fn s)
              (φ.hom.naturality (Opposite.op (mor_W idx)))
          refine hnat₁.symm.trans (Eq.trans ?_ hnat₂)
          cases idx with
          | inl u_unit =>
            cases u_unit
            exact (congrArg ((η ≫ R_pr.map ψ).hom.app (Opposite.op (obj_W (Sum.inl ())))) hj0_W).trans
              ((hHomZero _).trans
                ((hHomZero _).symm.trans
                  (congrArg (φ.hom.app (Opposite.op (obj_W (Sum.inl ())))) hj0_W.symm)))
          | inr c =>
            obtain ⟨_, q_c, _, _, _, hq_c_eq⟩ := huc_W c
            have hq₁ : ((η ≫ R_pr.map ψ).hom.app (Opposite.op (obj_W (Sum.inr c))))
                ((𝒥₀.obj.map (Opposite.op q_c)) (s_can c)) =
              ((R_pr.obj 𝒢).obj.map (Opposite.op q_c))
                (((η ≫ R_pr.map ψ).hom.app (Opposite.op V₀_et)) (s_can c)) :=
              congrArg (fun fn => fn (s_can c))
                ((η ≫ R_pr.map ψ).hom.naturality (Opposite.op q_c))
            have hq₂ : (φ.hom.app (Opposite.op (obj_W (Sum.inr c))))
                ((𝒥₀.obj.map (Opposite.op q_c)) (s_can c)) =
              ((R_pr.obj 𝒢).obj.map (Opposite.op q_c))
                ((φ.hom.app (Opposite.op V₀_et)) (s_can c)) :=
              congrArg (fun fn => fn (s_can c))
                (φ.hom.naturality (Opposite.op q_c))
            exact (congrArg ((η ≫ R_pr.map ψ).hom.app _) hq_c_eq).trans
              (hq₁.trans
                ((congrArg ((R_pr.obj 𝒢).obj.map (Opposite.op q_c)) (h_on_V₀ c)).trans
                  (hq₂.symm.trans
                    (congrArg (φ.hom.app _) hq_c_eq.symm))))
        exact (hPshComp 𝒢.obj k (B_pr.map (mor_W idx)) lhs_W).trans
          ((congrArg (𝒢.obj.map (Opposite.op k)) h_idx).trans
            (hPshComp 𝒢.obj k (B_pr.map (mor_W idx)) rhs_W).symm)

  
  let fwd : L_pr.obj 𝒥₀ ⟶ 𝒥_bar := (adj_pr.homEquiv 𝒥₀ 𝒥_bar).symm η
  obtain ⟨bwd, hbwd⟩ := (hThetaBij (L_pr.obj 𝒥₀)).2 (adj_pr.unit.app 𝒥₀)
  dsimp only at hbwd
  have h_fwd_bwd : fwd ≫ bwd = 𝟙 (L_pr.obj 𝒥₀) := by
    apply (adj_pr.homEquiv 𝒥₀ (L_pr.obj 𝒥₀)).injective
    have h_lhs : adj_pr.homEquiv 𝒥₀ (L_pr.obj 𝒥₀) (fwd ≫ bwd) = η ≫ R_pr.map bwd := by
      rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply]
    have h_rhs : adj_pr.homEquiv 𝒥₀ (L_pr.obj 𝒥₀) (𝟙 (L_pr.obj 𝒥₀)) = adj_pr.unit.app 𝒥₀ :=
      (Adjunction.homEquiv_unit adj_pr 𝒥₀ (L_pr.obj 𝒥₀) (𝟙 (L_pr.obj 𝒥₀))).trans
        ((congrArg (adj_pr.unit.app 𝒥₀ ≫ ·) (R_pr.map_id (L_pr.obj 𝒥₀))).trans
          (Category.comp_id _))
    exact h_lhs.trans (hbwd.trans h_rhs.symm)
  have h_bwd_fwd : bwd ≫ fwd = 𝟙 𝒥_bar := by
    apply (hThetaBij 𝒥_bar).1
    dsimp only
    calc
      η ≫ R_pr.map (bwd ≫ fwd)
        = (η ≫ R_pr.map bwd) ≫ R_pr.map fwd := by rw [R_pr.map_comp, Category.assoc]
      _ = adj_pr.unit.app 𝒥₀ ≫ R_pr.map fwd := congrArg (· ≫ R_pr.map fwd) hbwd
      _ = adj_pr.homEquiv 𝒥₀ 𝒥_bar fwd :=
            (Adjunction.homEquiv_unit adj_pr 𝒥₀ 𝒥_bar fwd).symm
      _ = η := Equiv.apply_symm_apply (adj_pr.homEquiv 𝒥₀ 𝒥_bar) η
      _ = η ≫ 𝟙 (R_pr.obj 𝒥_bar) := (Category.comp_id η).symm
      _ = η ≫ R_pr.map (𝟙 𝒥_bar) := congrArg (η ≫ ·) (R_pr.map_id 𝒥_bar).symm
  let iso : Iso (L_pr.obj 𝒥₀) 𝒥_bar :=
    { hom := fwd, inv := bwd, hom_inv_id := h_fwd_bwd, inv_hom_id := h_bwd_fwd }
  refine ⟨iso, fun W s₀ y cmp hcmp1 hcmp2 => ?_⟩
  have hiso_η : adj_pr.homEquiv 𝒥₀ 𝒥_bar iso.hom = η :=
    Equiv.apply_symm_apply (adj_pr.homEquiv 𝒥₀ 𝒥_bar) η
  rw [hiso_η]
  exact hη_cmp W s₀ y cmp hcmp1 hcmp2

theorem weil_curve_tr_geom_frob_pow_intertwining_and_base_action (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)]
    (B : ℕ → Type u)
    [∀ m, CommRing (B m)]
    [∀ m, Algebra F (B m)] [∀ m, Algebra (Polynomial F) (B m)]
    [∀ m, Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B m)]
    [∀ m, IsScalarTower F (Polynomial F) (B m)]
    [∀ m, IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B m)]
    (τ_rep : ∀ m : ℕ,
      (B m ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B m) →*
        (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (m + 1))))ˣ)
    (ι_B : ∀ m : ℕ,
      B m →ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B (m + 1))
