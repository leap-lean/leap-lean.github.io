            (d_map Q q u).comp hSE'.extClass rfl := by
        intro u
        rw [hd_apply, hd_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]
      refine ⟨?_, ?_⟩
      · intro w₁ w₂ hw_eq
        have hw : d_map Y (q + 1) (w₁ - w₂) = 0 := by
          rw [map_sub, hw_eq, sub_self]
        suffices h0 : w₁ - w₂ = 0 from sub_eq_zero.mp h0
        have hw_ι : (w₁ - w₂).comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨u, hu⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₁ hSE (w₁ - w₂) hw_ι rfl
        rw [← hu, hd_ext] at hw
        obtain ⟨v', hv'⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₂ hSE' (d_map Q q u) rfl hw
        obtain ⟨v, hv⟩ := (ih I).2 v'
        rw [← hv] at hv'
        have hu_eq : u = v.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero q) :=
          (ih Q).1 ((hd_post π q v).trans hv').symm
        rw [← hu, hu_eq,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.zero_add 1) rfl,
          hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro w'
        have hw'_ι : w'.comp (CategoryTheory.Abelian.Ext.mk₀ (S.map F).f) (Nat.add_zero (q + 1)) = 0 :=
          hVan I inferInstance q _
        obtain ⟨u', rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₂ hSE' w' hw'_ι rfl
        obtain ⟨u, hu⟩ := (ih Q).2 u'
        exact ⟨u.comp hSE.extClass rfl, (hd_ext u).trans (congrArg (fun z => z.comp hSE'.extClass rfl) hu)⟩

  have hExtComp : ∀ {𝒞₁ 𝒞₂ 𝒞₃ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞₁] [CategoryTheory.Abelian 𝒞₁]
      [CategoryTheory.HasExt.{u} 𝒞₁] [CategoryTheory.EnoughInjectives 𝒞₁]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞₂] [CategoryTheory.Abelian 𝒞₂]
