    (ΦK₀ : K₀ →+ K₀) (ΦK₁ : K₁ →+ K₁) (ΦK₂ : K₂ →+ K₂)
    (J₀ J₁ J₂ : Type u) [AddCommGroup J₀] [AddCommGroup J₁] [AddCommGroup J₂]
    (dJ₀ : J₀ →+ J₁) (dJ₁ : J₁ →+ J₂)
    (ΦJ₀ : J₀ →+ J₀) (ΦJ₁ : J₁ →+ J₁) (ΦJ₂ : J₂ →+ J₂)
    (IG₀ IG₁ IG₂ : Type u) [AddCommGroup IG₀] [AddCommGroup IG₁] [AddCommGroup IG₂]
    (dIG₀ : IG₀ →+ IG₁) (dIG₁ : IG₁ →+ IG₂)
    (ψG₀ : IG₀ →+ IG₀) (ψG₁ : IG₁ →+ IG₁) (ψG₂ : IG₂ →+ IG₂)
    (qG₀ : (Fin N → K₀) →+ IG₀) (qG₁ : (Fin N → K₁) →+ IG₁) (qG₂ : (Fin N → K₂) →+ IG₂)
    (πG₀ : J₀ →+ IG₀) (πG₁ : J₁ →+ IG₁) (πG₂ : J₂ →+ IG₂)
    (hTorK : (∀ x : K₀, (ℓ ^ K : ℕ) • x = 0) ∧
      (∀ x : K₁, (ℓ ^ K : ℕ) • x = 0) ∧
      (∀ x : K₂, (ℓ ^ K : ℕ) • x = 0))
    (hActK₁ : ρK₀ 1 = AddMonoidHom.id K₀ ∧
      ρK₁ 1 = AddMonoidHom.id K₁ ∧
      ρK₂ 1 = AddMonoidHom.id K₂)
    (hActK_mul : ∀ g₁ g₂ : Γ,
      ρK₀ (g₁ * g₂) = (ρK₀ g₁).comp (ρK₀ g₂) ∧
      ρK₁ (g₁ * g₂) = (ρK₁ g₁).comp (ρK₁ g₂) ∧
      ρK₂ (g₁ * g₂) = (ρK₂ g₁).comp (ρK₂ g₂))
    (hdK : dK₁.comp dK₀ = 0 ∧
      (∀ g : Γ, dK₀.comp (ρK₀ g) = (ρK₁ g).comp dK₀ ∧ dK₁.comp (ρK₁ g) = (ρK₂ g).comp dK₁) ∧
      dK₀.comp ΦK₀ = ΦK₁.comp dK₀ ∧
      dK₁.comp ΦK₁ = ΦK₂.comp dK₁ ∧
      (∀ g : Γ, ΦK₀.comp (ρK₀ g) = (ρK₀ g).comp ΦK₀ ∧
        ΦK₁.comp (ρK₁ g) = (ρK₁ g).comp ΦK₁ ∧
        ΦK₂.comp (ρK₂ g) = (ρK₂ g).comp ΦK₂))
    (hFinHK : Finite ↥dK₀.ker ∧
      Finite (↥dK₁.ker ⧸ AddSubgroup.comap dK₁.ker.subtype dK₀.range) ∧
      Finite (K₂ ⧸ dK₁.range))
    (hFlatK :
      ∀ (a b c : ℕ)
        (B_eq : Fin c → Fin b → MonoidAlgebra (ZMod (ℓ ^ K)) Γ)
        (A_eq : Fin b → Fin a → MonoidAlgebra (ZMod (ℓ ^ K)) Γ),
        (∀ u : Fin b → MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
          (∀ i : Fin a, ∑ j : Fin b, A_eq j i * u j = 0) ↔
          ∃ w : Fin c → MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
            ∀ j : Fin b, u j = ∑ k : Fin c, B_eq k j * w k) →
        ((∀ x : Fin b → K₀,
            (∀ i : Fin a,
              ∑ j : Fin b, (A_eq j i).coeff.sum (fun g c_g => c_g.val • ρK₀ g (x j)) = 0) ↔
