              (Polynomial.C c₀⁻¹ * EuclideanDomain.gcdB A_Q B_Q) * B'_Q)
          = Polynomial.C c₀⁻¹ *
              ((G₀ * A'_Q) * EuclideanDomain.gcdA A_Q B_Q +
                (G₀ * B'_Q) * EuclideanDomain.gcdB A_Q B_Q) := by ring
        _ = Polynomial.C c₀⁻¹ *
              (A_Q * EuclideanDomain.gcdA A_Q B_Q + B_Q * EuclideanDomain.gcdB A_Q B_Q) := by
              rw [← hAQ_fac, ← hBQ_fac]
        _ = Polynomial.C c₀⁻¹ * G := by rw [← hbez]
        _ = G₀ * 1 := (mul_one G₀).symm
    have hG₀K_ne : G₀.map (algebraMap ℚ K) ≠ 0 := by
      apply hNe_of_coeff0_eq_one
      rw [Polynomial.coeff_map, hG₀_coeff0, map_one]
    have hEq2 : (A'_Q.map (algebraMap ℚ K)) * recProd (B'.map (· ^ d')) =
        (B'_Q.map (algebraMap ℚ K)) * recProd (A'.map (· ^ d')) * R_poly d' x' := by
      apply mul_left_cancel₀ hG₀K_ne
      have hA_map : A_Q.map (algebraMap ℚ K) =
          (G₀.map (algebraMap ℚ K)) * (A'_Q.map (algebraMap ℚ K)) := by
        rw [hAQ_fac, Polynomial.map_mul]
      have hB_map : B_Q.map (algebraMap ℚ K) =
          (G₀.map (algebraMap ℚ K)) * (B'_Q.map (algebraMap ℚ K)) := by
        rw [hBQ_fac, Polynomial.map_mul]
      calc (G₀.map (algebraMap ℚ K)) *
            ((A'_Q.map (algebraMap ℚ K)) * recProd (B'.map (· ^ d')))
          = ((G₀.map (algebraMap ℚ K)) * (A'_Q.map (algebraMap ℚ K))) *
              recProd (B'.map (· ^ d')) := by ring
        _ = (A_Q.map (algebraMap ℚ K)) * recProd (B'.map (· ^ d')) := by rw [← hA_map]
        _ = (B_Q.map (algebraMap ℚ K)) * recProd (A'.map (· ^ d')) * R_poly d' x' := hEq1
        _ = ((G₀.map (algebraMap ℚ K)) * (B'_Q.map (algebraMap ℚ K))) *
              recProd (A'.map (· ^ d')) * R_poly d' x' := by rw [hB_map]
        _ = (G₀.map (algebraMap ℚ K)) *
              ((B'_Q.map (algebraMap ℚ K)) * recProd (A'.map (· ^ d')) * R_poly d' x') := by ring
    exact ⟨A'_Q, B'_Q, hA'Q0, hB'Q0, hCop, hEq2⟩
  let S_cross : List K :=
    A'.toList.flatMap (fun α => B'.toList.map (fun β => α / β))
  let L_cross : ℕ := (S_cross.map badOrder).prod
  have hL_cross_pos : 1 ≤ L_cross := hBadOrder_pos S_cross
  have hB'_list_ne : ∀ β ∈ B'.toList, β ≠ 0 :=
    fun β hβ => hB'_ne β (Multiset.mem_toList.mp hβ)
  obtain ⟨P_per₁, D₀₁, hP_per₁, hAvoid_B'⟩ := hAvoid_per B'.toList hB'_list_ne
  have hDenom_prog : ∀ k : ℕ, D₀₁ ≤ k * L_cross →
      let d' := 1 + (k * L_cross) * P_per₁
      ∃ B'_Q : Polynomial ℚ,
        B'_Q.coeff 0 = 1 ∧
        recProd (B'.map (· ^ d')) = B'_Q.map (algebraMap ℚ K) := by
    intro k hk d'
    have hd' : 1 ≤ d' := by dsimp [d']; omega
    obtain ⟨x', hx'_avoid⟩ := hAvoid_B' (k * L_cross) hk
    obtain ⟨A'_Q, B'_Q, _, hB'Q0, hCop, hEq_norm⟩ := hNorm d' hd' x'
    have hCross_d' : ∀ α ∈ A', ∀ β ∈ B', α ^ d' ≠ β ^ d' := by
      intro α hα β hβ hpow_eq
      have hβ_nz : β ≠ 0 := hB'_ne β hβ
      have hdiv_ne1 : α / β ≠ 1 := by
        intro h1
        exact hDisj α hα β hβ ((div_eq_one_iff_eq hβ_nz).mp h1)
      have hdiv_mem : α / β ∈ S_cross := by
        refine List.mem_flatMap.mpr ⟨α, Multiset.mem_toList.mpr hα, ?_⟩
        exact List.mem_map.mpr ⟨β, Multiset.mem_toList.mpr hβ, rfl⟩
      have hdiv_pow : (α / β) ^ (1 + (k * P_per₁) * L_cross) = 1 := by
        have hd'_eq : 1 + (k * P_per₁) * L_cross = d' := by
          dsimp [d']
          ring
        rw [hd'_eq, div_pow, hpow_eq, div_self (pow_ne_zero d' hβ_nz)]
      exact hBadOrder_avoid S_cross hdiv_mem hdiv_ne1 (k * P_per₁) hdiv_pow
    have hCop_B' : IsCoprime (recProd (B'.map (· ^ d')))
        (recProd (A'.map (· ^ d')) * R_poly d' x') := by
      apply hRecProd_isCoprime
      intro u hu
      obtain ⟨β, hβ, rfl⟩ := Multiset.mem_map.mp hu
      have hβ_nz : β ≠ 0 := hB'_ne β hβ
      have hβd_nz : β ^ d' ≠ 0 := pow_ne_zero d' hβ_nz
      refine ⟨hβd_nz, ?_⟩
      rw [hLin_dvd_iff hβd_nz, Polynomial.eval_mul, hRecProd_eval]
      have hA_eval_ne :
          (((A'.map (· ^ d')).map (fun v => 1 - v * (β ^ d')⁻¹)).prod) ≠ 0 := by
        intro h0
        have hzero_mem := Multiset.prod_eq_zero_iff.mp h0
        obtain ⟨v, hv_mem, hv_eq⟩ := Multiset.mem_map.mp hzero_mem
        obtain ⟨α, hα, rfl⟩ := Multiset.mem_map.mp hv_mem
        have h1 : α ^ d' * (β ^ d')⁻¹ = 1 := (sub_eq_zero.mp hv_eq).symm
        have heq_pow : α ^ d' = β ^ d' := by
          calc α ^ d' = α ^ d' * ((β ^ d')⁻¹ * β ^ d') := by
                rw [inv_mul_cancel₀ hβd_nz, mul_one]
            _ = (α ^ d' * (β ^ d')⁻¹) * β ^ d' := (mul_assoc _ _ _).symm
            _ = β ^ d' := by rw [h1, one_mul]
        exact hCross_d' α hα β hβ heq_pow
      have hR_eval_ne : (R_poly d' x').eval ((β ^ d')⁻¹) ≠ 0 :=
        mt (hLin_dvd_iff hβd_nz (R_poly d' x')).mpr
          (hx'_avoid β (Multiset.mem_toList.mpr hβ))
      exact mul_ne_zero hA_eval_ne hR_eval_ne
    have hdvd1 : recProd (B'.map (· ^ d')) ∣ B'_Q.map (algebraMap ℚ K) := by
      apply hCop_B'.dvd_of_dvd_mul_right
      refine ⟨A'_Q.map (algebraMap ℚ K), ?_⟩
      calc (B'_Q.map (algebraMap ℚ K)) * (recProd (A'.map (· ^ d')) * R_poly d' x')
          = (B'_Q.map (algebraMap ℚ K)) * recProd (A'.map (· ^ d')) * R_poly d' x' := by ring
        _ = (A'_Q.map (algebraMap ℚ K)) * recProd (B'.map (· ^ d')) := hEq_norm.symm
        _ = recProd (B'.map (· ^ d')) * (A'_Q.map (algebraMap ℚ K)) := by ring
    have hCop_QA : IsCoprime (B'_Q.map (algebraMap ℚ K)) (A'_Q.map (algebraMap ℚ K)) :=
      hCop.symm.map (Polynomial.mapRingHom (algebraMap ℚ K))
    have hdvd2 : B'_Q.map (algebraMap ℚ K) ∣ recProd (B'.map (· ^ d')) := by
      apply hCop_QA.dvd_of_dvd_mul_left
      refine ⟨recProd (A'.map (· ^ d')) * R_poly d' x', ?_⟩
      calc (A'_Q.map (algebraMap ℚ K)) * recProd (B'.map (· ^ d'))
          = (B'_Q.map (algebraMap ℚ K)) * recProd (A'.map (· ^ d')) * R_poly d' x' := hEq_norm
        _ = (B'_Q.map (algebraMap ℚ K)) * (recProd (A'.map (· ^ d')) * R_poly d' x') := by ring
    have hBQK0 : (B'_Q.map (algebraMap ℚ K)).coeff 0 = 1 := by
      rw [Polynomial.coeff_map, hB'Q0, map_one]
    exact ⟨B'_Q, hB'Q0, hEq_of_dvd_of_coeff0 (hRecProd_coeff0 _) hBQK0 hdvd1 hdvd2⟩
  have hB'_alg : ∀ β ∈ B', IsAlgebraic ℚ β := by
    let k₁ : ℕ := max 1 D₀₁
    have hk₁ : D₀₁ ≤ k₁ * L_cross := by
      calc D₀₁ ≤ k₁ := le_max_right 1 D₀₁
        _ ≤ k₁ * L_cross := Nat.le_mul_of_pos_right k₁ hL_cross_pos
    obtain ⟨B'_Q₁, hBQ₁0, hBQ₁_eq⟩ := hDenom_prog k₁ hk₁
    set d₁ := 1 + (k₁ * L_cross) * P_per₁
    have hd₁ : 1 ≤ d₁ := by dsimp [d₁]; omega
    exact hAlg_of_recProd_dvd hd₁ hB'_ne (hNe_of_coeff0_eq_one hBQ₁0)
      ⟨1, by rw [mul_one, hBQ₁_eq]⟩
  have hB'_descent : ∀ e : ℕ, ∃ P_B : Polynomial ℚ,
      P_B.coeff 0 = 1 ∧ P_B.map (algebraMap ℚ K) = recProd (B'.map (· ^ e)) := by
    apply hGaloisDescent B' hB'_ne hB'_alg
    intro δ_list hδ_ne
    refine ⟨L_cross * P_per₁, D₀₁, Nat.mul_pos hL_cross_pos hP_per₁, fun m hm => ?_⟩
    have hm_cross : D₀₁ ≤ m * L_cross :=
      le_trans hm (Nat.le_mul_of_pos_right m hL_cross_pos)
    obtain ⟨B'_Qm, _, hBQm_eq⟩ := hDenom_prog m hm_cross
    have hexp_eq : 1 + m * (L_cross * P_per₁) = 1 + (m * L_cross) * P_per₁ := by ring
    refine ⟨1, B'_Qm, ?_, ?_⟩
    · rw [mul_one, hexp_eq, hBQm_eq]
    · intro δ hδ hdvd_one
      have hδp_ne : δ ^ (1 + m * (L_cross * P_per₁)) ≠ 0 :=
        pow_ne_zero _ (hδ_ne δ hδ)
      have heval := (hLin_dvd_iff hδp_ne 1).mp hdvd_one
      rw [Polynomial.eval_one] at heval
      exact one_ne_zero heval
  have hClear_denom : ∀ (d' : ℕ), 1 ≤ d' → ∀ (x' : GoodPoly d'),
      ∃ C_Q : Polynomial ℚ,
        C_Q.coeff 0 = 1 ∧
        recProd (A'.map (· ^ d')) * R_poly d' x' = C_Q.map (algebraMap ℚ K) := by
    intro d' hd' x'
    obtain ⟨A'_Q, B'_Q, hA'Q0, hB'Q0, hCop, hEq_norm⟩ := hNorm d' hd' x'
    obtain ⟨P_B, hPB0, hPB_eq⟩ := hB'_descent d'
    rw [← hPB_eq] at hEq_norm
    have hdvd_K : B'_Q.map (algebraMap ℚ K) ∣ (A'_Q * P_B).map (algebraMap ℚ K) := by
      rw [Polynomial.map_mul]
      refine ⟨recProd (A'.map (· ^ d')) * R_poly d' x', ?_⟩
      calc (A'_Q.map (algebraMap ℚ K)) * (P_B.map (algebraMap ℚ K))
          = (B'_Q.map (algebraMap ℚ K)) * recProd (A'.map (· ^ d')) * R_poly d' x' := hEq_norm
        _ = (B'_Q.map (algebraMap ℚ K)) * (recProd (A'.map (· ^ d')) * R_poly d' x') := by ring
    have hdvd_Q : B'_Q ∣ A'_Q * P_B :=
      (Polynomial.map_dvd_map' (algebraMap ℚ K)).mp hdvd_K
    obtain ⟨Q_div, hQ_div⟩ := hCop.symm.dvd_of_dvd_mul_left hdvd_Q
    have hQdiv0 : Q_div.coeff 0 = 1 := by
      have hc : P_B.coeff 0 = B'_Q.coeff 0 * Q_div.coeff 0 := by
        rw [hQ_div, Polynomial.mul_coeff_zero]
      rw [hPB0, hB'Q0, one_mul] at hc
      exact hc.symm
    let C_Q : Polynomial ℚ := A'_Q * Q_div
    have hCQ0 : C_Q.coeff 0 = 1 := by
      dsimp [C_Q]
      rw [Polynomial.mul_coeff_zero, hA'Q0, hQdiv0, mul_one]
    have hBQK_ne : B'_Q.map (algebraMap ℚ K) ≠ 0 := by
      apply hNe_of_coeff0_eq_one
      rw [Polynomial.coeff_map, hB'Q0, map_one]
    have hcomm_Q : A'_Q * (B'_Q * Q_div) = B'_Q * C_Q := by
      dsimp [C_Q]
      ring
    have hCQ_eq : recProd (A'.map (· ^ d')) * R_poly d' x' = C_Q.map (algebraMap ℚ K) := by
      apply mul_left_cancel₀ hBQK_ne
      calc (B'_Q.map (algebraMap ℚ K)) * (recProd (A'.map (· ^ d')) * R_poly d' x')
          = (B'_Q.map (algebraMap ℚ K)) * recProd (A'.map (· ^ d')) * R_poly d' x' := by ring
        _ = (A'_Q.map (algebraMap ℚ K)) * (P_B.map (algebraMap ℚ K)) := hEq_norm.symm
        _ = (A'_Q * (B'_Q * Q_div)).map (algebraMap ℚ K) := by
              rw [hQ_div, ← Polynomial.map_mul]
        _ = (B'_Q * C_Q).map (algebraMap ℚ K) := by rw [hcomm_Q]
        _ = (B'_Q.map (algebraMap ℚ K)) * (C_Q.map (algebraMap ℚ K)) :=
              Polynomial.map_mul (algebraMap ℚ K)
    exact ⟨C_Q, hCQ0, hCQ_eq⟩
  obtain ⟨C_Qd, hCQd0, hCQd_eq⟩ := hClear_denom d hd x
  have hA'_alg : ∀ α ∈ A', IsAlgebraic ℚ α :=
    hAlg_of_recProd_dvd hd hA'_ne (hNe_of_coeff0_eq_one hCQd0) ⟨R_poly d x, hCQd_eq.symm⟩
  have hA'_descent : ∀ e : ℕ, ∃ P_A : Polynomial ℚ,
      P_A.coeff 0 = 1 ∧ P_A.map (algebraMap ℚ K) = recProd (A'.map (· ^ e)) := by
    apply hGaloisDescent A' hA'_ne hA'_alg
    intro δ_list hδ_ne
    obtain ⟨P_per, D₀, hP_per, hAvoid_m⟩ := hAvoid_per δ_list hδ_ne
    refine ⟨P_per, D₀, hP_per, fun m hm => ?_⟩
    obtain ⟨x_m, hx_m⟩ := hAvoid_m m hm
    obtain ⟨C_Qm, _, hCQm_eq⟩ := hClear_denom (1 + m * P_per) (by omega) x_m
    exact ⟨R_poly (1 + m * P_per) x_m, C_Qm, hCQm_eq, hx_m⟩
  obtain ⟨P_Ad, hPAd0, hPAd_eq⟩ := hA'_descent d
  have hdvd_RQ_K : P_Ad.map (algebraMap ℚ K) ∣ C_Qd.map (algebraMap ℚ K) :=
    ⟨R_poly d x, by rw [hPAd_eq, hCQd_eq]⟩
  obtain ⟨R_Q, hRQ⟩ := (Polynomial.map_dvd_map' (algebraMap ℚ K)).mp hdvd_RQ_K
  refine ⟨R_Q, ?_⟩
  have hPAdK_ne : P_Ad.map (algebraMap ℚ K) ≠ 0 := by
    apply hNe_of_coeff0_eq_one
    rw [Polynomial.coeff_map, hPAd0, map_one]
  apply mul_left_cancel₀ hPAdK_ne
  calc (P_Ad.map (algebraMap ℚ K)) * (R_Q.map (algebraMap ℚ K))
      = (P_Ad * R_Q).map (algebraMap ℚ K) := (Polynomial.map_mul (algebraMap ℚ K)).symm
    _ = C_Qd.map (algebraMap ℚ K) := by rw [← hRQ]
    _ = recProd (A'.map (· ^ d)) * R_poly d x := hCQd_eq.symm
    _ = (P_Ad.map (algebraMap ℚ K)) * R_poly d x := by rw [← hPAd_eq]

theorem weil_symplectic_curve_chebotarev_rationality (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (ℓ M n r₀ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (hM : 1 ≤ M) (hr₀ : 1 ≤ r₀)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (hJ_skew : J.transpose = -J)
    (hJ_det : J.det ≠ 0)
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (hCong : ∀ B : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ,
      (B.val).map (PadicInt.toZModPow r₀) = 1 →
      ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J →
      B ∈ G_geom)
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (hF_sim : ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
          ((Nat.card F : Padic ℓ) ^ (n * d)) • J)
    (hCov : ∀ k : ℕ, 1 ≤ k → WeilGaloisModEllPowCover.{u} F S_aff ℓ M k G_geom F_mat)
    (hRat : ∃ (α_num β_den : List (AlgebraicClosure (Padic ℓ))),
      (∀ α ∈ α_num, α ≠ 0) ∧ (∀ β ∈ β_den, β ≠ 0) ∧
      ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
        1 ≤ d →
          ∃ A_Q B_Q : Polynomial ℚ,
            A_Q.coeff 0 = 1 ∧ B_Q.coeff 0 = 1 ∧
            (A_Q.map (algebraMap ℚ (AlgebraicClosure (Padic ℓ)))) *
              (β_den.map (fun β => 1 - Polynomial.C (β ^ d) * Polynomial.X)).prod =
            (B_Q.map (algebraMap ℚ (AlgebraicClosure (Padic ℓ)))) *
              (α_num.map (fun α => 1 - Polynomial.C (α ^ d) * Polynomial.X)).prod *
              (((F_mat d P hP).map
                (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))).charpolyRev))
    (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P) :
    ∃ Q_P : Polynomial ℚ,
      Q_P.Monic ∧
      Q_P.natDegree = M ∧
      Q_P.map (algebraMap ℚ (Padic ℓ)) =
        ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))).charpoly ∧
      (∀ z : ℂ, z ∈ Q_P.aroots ℂ →
        z ≠ 0 ∧ ((Nat.card F : ℂ) ^ (n * d)) / z ∈ Q_P.aroots ℂ) :=
by
  classical
  let K := Padic ℓ
  let L := AlgebraicClosure (Padic ℓ)
  set q := Nat.card F
  have hUnits_inv_val : ∀ {R_u : Type} [CommRing R_u]
      (v : (Matrix (Fin M) (Fin M) R_u)ˣ), (v⁻¹).val = (v.val)⁻¹ := by
    intro R_u _ v
    have hv_det : IsUnit v.val.det := (Matrix.isUnit_iff_isUnit_det v.val).mp v.isUnit
    calc (v⁻¹).val = (v⁻¹).val * 1 := (Matrix.mul_one _).symm
      _ = (v⁻¹).val * (v.val * (v.val)⁻¹) := by rw [Matrix.mul_nonsing_inv v.val hv_det]
      _ = ((v⁻¹).val * v.val) * (v.val)⁻¹ := (Matrix.mul_assoc _ _ _).symm
      _ = 1 * (v.val)⁻¹ := by rw [v.inv_mul]
      _ = (v.val)⁻¹ := Matrix.one_mul _
  have hq : 2 ≤ q := Finite.one_lt_card
  have hd : 1 ≤ d := by
    have hpos : 0 < P.natDegree := Irreducible.natDegree_pos hP.2.1
    rw [hP.2.2.1] at hpos
    exact hpos
  let _ : Fintype F := Fintype.ofFinite F
  set p := ringChar F
  have hp_prime : Nat.Prime p := CharP.char_is_prime F p
  have _ : Fact (Nat.Prime p) := ⟨hp_prime⟩
  have hnot_dvd_q : ¬ (ℓ ∣ q) := by
    obtain ⟨a, _, ha⟩ := FiniteField.card F p
    have hq_eq : q = p ^ (a : ℕ) := by
      dsimp [q]
      rw [Nat.card_eq_fintype_card, ha]
    intro hdvd
    rw [hq_eq] at hdvd
    have hℓ_dvd_p : ℓ ∣ p := Nat.Prime.dvd_of_dvd_pow (Fact.out : Nat.Prime ℓ) hdvd
    have h_eq : ℓ = p := (Nat.prime_dvd_prime_iff_eq (Fact.out : Nat.Prime ℓ) hp_prime).mp hℓ_dvd_p
    exact hℓ h_eq
  have hq_unit : IsUnit (q : PadicInt ℓ) := by
    rw [PadicInt.isUnit_iff]
    have hle : ‖(q : PadicInt ℓ)‖ ≤ 1 := PadicInt.norm_le_one (q : PadicInt ℓ)
    have hnot_lt : ¬ ‖(q : PadicInt ℓ)‖ < 1 := by
      change ¬ ‖((q : ℤ) : PadicInt ℓ)‖ < 1
      rw [PadicInt.norm_int_lt_one_iff_dvd]
      intro hdvd_z
      exact hnot_dvd_q (Int.natCast_dvd_natCast.mp hdvd_z)
    exact le_antisymm hle (le_of_not_gt hnot_lt)
  have hF_unit : ∀ (d' : ℕ) (P' : Polynomial F) (hP' : IsGoodAffineCurveClosedPointPoly S_aff d' P'),
      IsUnit (F_mat d' P' hP') := by
    intro d' P' hP'
    let C := F_mat d' P' hP'
    let C_K := C.map (algebraMap (PadicInt ℓ) K)
    have hsim := congrArg Matrix.det (hF_sim d' P' hP')
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, Matrix.det_smul, Fintype.card_fin] at hsim
    have hsim' : (C_K.det * C_K.det) * J.det = ((q : K) ^ (n * d')) ^ M * J.det := by
      calc (C_K.det * C_K.det) * J.det = C_K.det * J.det * C_K.det := by ring
        _ = ((q : K) ^ (n * d')) ^ M * J.det := hsim
    have hdet_K : C_K.det * C_K.det = ((q : K) ^ (n * d')) ^ M := mul_right_cancel₀ hJ_det hsim'
    have hdet_C : algebraMap (PadicInt ℓ) K C.det = C_K.det :=
      RingHom.map_det (algebraMap (PadicInt ℓ) K) C
    have hdet_map : algebraMap (PadicInt ℓ) K (C.det * C.det) =
        algebraMap (PadicInt ℓ) K (((q : PadicInt ℓ) ^ (n * d')) ^ M) := by
