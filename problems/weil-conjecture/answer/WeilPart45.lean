        (δ₁ : SpecΩ ⟶ (Fgt.obj V₁).left)
        (δ₂ : SpecΩ ⟶ (Fgt.obj V₂).left),
        δ₁ ≫ (Fgt.obj V₁).hom = x_Ω →
        δ₂ ≫ (Fgt.obj V₂).hom = x_Ω →
        δ₁ ≫ (Fgt.map f₁).left = δ₂ ≫ (Fgt.map f₂).left →
