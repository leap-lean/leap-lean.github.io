        (∀ y : ↥dJ₁.ker ⧸ B_J₁, ∃ u, q₁ u = (ℓ ^ B₁ : ℕ) • y)) ∧
      (∃ q₂ : (Fin (b_J 2) → ZMod (ℓ ^ K)) →+ (J₂ ⧸ dJ₁.range),
        (∀ (u : Fin (b_J 2) → ZMod (ℓ ^ K)) (z : J₂),
          QuotientAddGroup.mk' dJ₁.range z = q₂ u →
          q₂ (MJ₂ u) = QuotientAddGroup.mk' dJ₁.range (ΦJ₂ z)) ∧
        (∀ u, q₂ u = 0 → (ℓ ^ B₁ : ℕ) • u = 0) ∧
        (∀ y : J₂ ⧸ dJ₁.range, ∃ u, q₂ u = (ℓ ^ B₁ : ℕ) • y)))
    (hTorIG : (∀ x : IG₀, (ℓ ^ (s + 1) : ℕ) • x = 0) ∧
      (∀ x : IG₁, (ℓ ^ (s + 1) : ℕ) • x = 0) ∧
      (∀ x : IG₂, (ℓ ^ (s + 1) : ℕ) • x = 0))
    (hdIG : dIG₁.comp dIG₀ = 0 ∧
      dIG₀.comp ψG₀ = ψG₁.comp dIG₀ ∧
      dIG₁.comp ψG₁ = ψG₂.comp dIG₁)
    (hqG : Function.Surjective qG₀ ∧ Function.Surjective qG₁ ∧ Function.Surjective qG₂ ∧
      (∀ v : Fin N → K₀, dIG₀ (qG₀ v) = qG₁ (fun i => dK₀ (v i))) ∧
      (∀ v : Fin N → K₁, dIG₁ (qG₁ v) = qG₂ (fun i => dK₁ (v i))) ∧
      (∀ v : Fin N → K₀, ψG₀ (qG₀ v) = qG₀ (fun i => ΦK₀ (v i))) ∧
      (∀ v : Fin N → K₁, ψG₁ (qG₁ v) = qG₁ (fun i => ΦK₁ (v i))) ∧
      (∀ v : Fin N → K₂, ψG₂ (qG₂ v) = qG₂ (fun i => ΦK₂ (v i))) ∧
      qG₀.ker = AddSubgroup.closure (
        { u | ∃ w : Fin N → K₀, u = (ℓ ^ (s + 1) : ℕ) • w } ∪
        { u | ∃ (g : Γ) (w : Fin N → K₀),
          u = (fun i => ρK₀ g (w i)) -
            (fun i => ∑ j : Fin N, (((τ_rep g⁻¹).val i j).val : ℕ) • w j) }) ∧
      qG₁.ker = AddSubgroup.closure (
        { u | ∃ w : Fin N → K₁, u = (ℓ ^ (s + 1) : ℕ) • w } ∪
        { u | ∃ (g : Γ) (w : Fin N → K₁),
          u = (fun i => ρK₁ g (w i)) -
            (fun i => ∑ j : Fin N, (((τ_rep g⁻¹).val i j).val : ℕ) • w j) }) ∧
      qG₂.ker = AddSubgroup.closure (
        { u | ∃ w : Fin N → K₂, u = (ℓ ^ (s + 1) : ℕ) • w } ∪
        { u | ∃ (g : Γ) (w : Fin N → K₂),
          u = (fun i => ρK₂ g (w i)) -
            (fun i => ∑ j : Fin N, (((τ_rep g⁻¹).val i j).val : ℕ) • w j) }))
    (hπG : Function.Surjective πG₀ ∧ Function.Surjective πG₁ ∧ Function.Surjective πG₂ ∧
      (∀ x : J₀, πG₀ x = 0 ↔ ∃ y : J₀, x = (ℓ ^ (s + 1) : ℕ) • y) ∧
      (∀ x : J₁, πG₁ x = 0 ↔ ∃ y : J₁, x = (ℓ ^ (s + 1) : ℕ) • y) ∧
      (∀ x : J₂, πG₂ x = 0 ↔ ∃ y : J₂, x = (ℓ ^ (s + 1) : ℕ) • y) ∧
      (∀ x : J₀, dIG₀ (πG₀ x) = πG₁ (dJ₀ x)) ∧
      (∀ x : J₁, dIG₁ (πG₁ x) = πG₂ (dJ₁ x)) ∧
      (∀ x : J₀, ψG₀ (πG₀ x) = πG₀ (ΦJ₀ x)) ∧
      (∀ x : J₁, ψG₁ (πG₁ x) = πG₁ (ΦJ₁ x)) ∧
      (∀ x : J₂, ψG₂ (πG₂ x) = πG₂ (ΦJ₂ x))) :
    ∃ (F_K : WeilCurveTrFreeComplex (ℓ ^ K))
      (M_K : WeilCurveTrGroupComplex Γ (ℓ ^ K)),
      WeilCurveTrHasBoundedLatticeModel ℓ K B₁ F_K b_J M_lat_J ∧
      (Finite ↥(LinearMap.ker M_K.δ₀) ∧
        Finite (↥(LinearMap.ker M_K.δ₁) ⧸
          (Submodule.comap (LinearMap.ker M_K.δ₁).subtype
            (LinearMap.range M_K.δ₀)).toAddSubgroup) ∧
        Finite (M_K.M₂ ⧸ (LinearMap.range M_K.δ₁).toAddSubgroup)) ∧
      (WeilCurveTrIsEqFlat Γ (ℓ ^ K) M_K.M₀ ∧
        WeilCurveTrIsEqFlat Γ (ℓ ^ K) M_K.M₁ ∧
        WeilCurveTrIsEqFlat Γ (ℓ ^ K) M_K.M₂) ∧
      WeilCurveTrHasRepInvBridge ℓ N s K hsK τ_rep F_K M_K ∧
      ∀ σ : Γ,
        WeilCurveTrHasGroupCohomLatticeModel ℓ K B₂ M_K σ (b_V σ) (M_lat_V σ) :=
by
  classical
  have _ := hN
  
  
  
  have hPrime : Nat.Prime ℓ := Fact.out
  have hK_pos : 1 ≤ K := by omega
  have h1_lt_ℓ : 1 < ℓ := hPrime.one_lt
  have h1_lt_s1 : 1 < ℓ ^ (s + 1) := one_lt_pow₀ h1_lt_ℓ (Nat.succ_ne_zero s)
  have h1_lt_K : 1 < ℓ ^ K := one_lt_pow₀ h1_lt_ℓ (by omega)
  have hNeZero_s1 : NeZero (ℓ ^ (s + 1)) := ⟨by omega⟩
  have hNeZero_K : NeZero (ℓ ^ K) := ⟨by omega⟩

  let Λ_K := ZMod (ℓ ^ K)
  let Λ_s := ZMod (ℓ ^ (s + 1))
  let cast_s : Λ_K →+* Λ_s := ZMod.castHom (pow_dvd_pow ℓ hsK) Λ_s
  let R_K := MonoidAlgebra Λ_K Γ
  let s_scalar : Λ_K → R_K := fun c => MonoidAlgebra.single (1 : Γ) c

  let _ : Fintype Γ := Fintype.ofFinite Γ
  have hFin_RK : Finite R_K := by
    refine Finite.of_injective (fun (r : R_K) (g : Γ) => r.coeff g) ?_
    intro r₁ r₂ h
    exact MonoidAlgebra.coeff_injective (Finsupp.ext (congrFun h))
  let _ : Fintype R_K := Fintype.ofFinite R_K

  have hs_scalar_nat : ∀ {Y : Type u} [AddCommGroup Y] [Module R_K Y] (n : ℕ) (y : Y),
      s_scalar (n : Λ_K) • y = n • y := by
    intro Y _ _ n y
    have h1 : s_scalar (n : Λ_K) = (n : R_K) :=
      map_natCast MonoidAlgebra.singleOneRingHom n
    rw [h1, Nat.cast_smul_eq_nsmul]

  have hs_scalar_val : ∀ {Y : Type u} [AddCommGroup Y] [Module R_K Y] (c : Λ_K) (y : Y),
      s_scalar c • y = c.val • y := by
    intro Y _ _ c y
    conv_lhs => rw [← ZMod.natCast_zmod_val c]
    exact hs_scalar_nat c.val y

  have hValOne : ∀ {m : ℕ} (hm : 1 < m), @ZMod.val m (1 : ZMod m) = 1 := by
    intro m hm
    have : NeZero m := ⟨by omega⟩
    rw [← Nat.cast_one, ZMod.val_natCast, Nat.mod_eq_of_lt hm]

  have hZModMod_u : ∀ (m : ℕ) (hm : 1 < m) (X : Type u) [AddCommGroup X],
      (∀ x : X, m • x = 0) →
      ∃ (mod : Module (ZMod m) X),
        ∀ (c : ZMod m) (x : X), @SMul.smul (ZMod m) X mod.toSMul c x = c.val • x := by
    intro m hm X _ hTor
    have : NeZero m := ⟨by omega⟩
    have hmod_eq : ∀ (n : ℕ) (x : X), (n % m) • x = n • x := by
      intro n x
      conv_rhs => rw [← Nat.mod_add_div n m]
      rw [add_nsmul, mul_comm m (n / m), mul_nsmul', hTor x, nsmul_zero, add_zero]
    let f_end : ZMod m →+* AddMonoid.End X :=
      { toFun := fun c => c.val • AddMonoidHom.id X
        map_zero' := AddMonoidHom.ext fun x => by
          change (0 : ZMod m).val • x = 0
          simp
        map_one' := AddMonoidHom.ext fun x => by
          change (1 : ZMod m).val • x = x
          rw [hValOne hm, one_nsmul]
        map_add' := fun a b => AddMonoidHom.ext fun x => by
          change (a + b).val • x = a.val • x + b.val • x
          rw [ZMod.val_add, hmod_eq, add_nsmul]
        map_mul' := fun a b => AddMonoidHom.ext fun x => by
          change (a * b).val • x = a.val • (b.val • x)
          rw [ZMod.val_mul, hmod_eq, mul_nsmul'] }
    exact ⟨Module.compHom X f_end, fun _ _ => rfl⟩

  have hGroupMod : ∀ (X : Type u) [AddCommGroup X],
      (∀ x : X, (ℓ ^ K : ℕ) • x = 0) →
      ∀ (ρ : Γ → (X →+ X)),
        ρ 1 = AddMonoidHom.id X →
        (∀ g₁ g₂ : Γ, ρ (g₁ * g₂) = (ρ g₁).comp (ρ g₂)) →
        ∃ (mod : Module R_K X),
          ∀ (r : R_K) (x : X),
            @SMul.smul R_K X mod.toSMul r x =
              r.coeff.sum (fun g c_g => c_g.val • ρ g x) := by
    intro X _ hTor ρ h1 hmul
    have hmod_eq : ∀ (n : ℕ) (x : X), (n % (ℓ ^ K)) • x = n • x := by
      intro n x
      conv_rhs => rw [← Nat.mod_add_div n (ℓ ^ K)]
      rw [add_nsmul, mul_comm (ℓ ^ K) (n / (ℓ ^ K)), mul_nsmul', hTor x, nsmul_zero, add_zero]
    let f_sc : Λ_K →+* AddMonoid.End X :=
      { toFun := fun c => c.val • AddMonoidHom.id X
        map_zero' := AddMonoidHom.ext fun x => by
          change (0 : Λ_K).val • x = 0
          simp
        map_one' := AddMonoidHom.ext fun x => by
          change (1 : Λ_K).val • x = x
          rw [hValOne h1_lt_K, one_nsmul]
        map_add' := fun a b => AddMonoidHom.ext fun x => by
          change (a + b).val • x = a.val • x + b.val • x
          rw [ZMod.val_add, hmod_eq, add_nsmul]
        map_mul' := fun a b => AddMonoidHom.ext fun x => by
          change (a * b).val • x = a.val • (b.val • x)
          rw [ZMod.val_mul, hmod_eq, mul_nsmul'] }
    let g_act : Γ →* AddMonoid.End X :=
      { toFun := ρ, map_one' := h1, map_mul' := hmul }
    have hcomm : ∀ (c : Λ_K) (g : Γ), Commute (f_sc c) (g_act g) := by
      intro c g
      apply AddMonoidHom.ext
      intro x
      exact (map_nsmul (ρ g) c.val x).symm
    let φ : R_K →+* AddMonoid.End X := MonoidAlgebra.liftNCRingHom f_sc g_act hcomm
    refine ⟨Module.compHom X φ, fun r x => ?_⟩
    change φ r x = r.coeff.sum (fun g c_g => c_g.val • ρ g x)
    have hr_eq : r = ∑ g : Γ, MonoidAlgebra.single g (r.coeff g) := by
      apply MonoidAlgebra.coeff_injective
      ext g₀
      simp [MonoidAlgebra.coeff_single]
    have hsum_rhs : r.coeff.sum (fun g c_g => c_g.val • ρ g x) =
        ∑ g : Γ, (r.coeff g).val • ρ g x := by
      rw [Finsupp.sum_fintype]
      intro g
      simp
    rw [hsum_rhs]
    conv_lhs => rw [hr_eq]
    let ev_x : AddMonoid.End X →+ X :=
      { toFun := fun f => f x
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    change ev_x (φ (∑ g : Γ, MonoidAlgebra.single g (r.coeff g))) = _
    rw [map_sum φ, map_sum ev_x]
    refine Finset.sum_congr rfl fun g _ => ?_
    have hsingle : φ (MonoidAlgebra.single g (r.coeff g)) = f_sc (r.coeff g) * g_act g :=
      MonoidAlgebra.liftNC_single f_sc.toAddMonoidHom g_act.toOneHom g (r.coeff g)
    change φ (MonoidAlgebra.single g (r.coeff g)) x = _
    rw [hsingle]
    rfl

  
  
  
  let freeHom_u : ∀ {R : Type u} [Ring R] {X : Type u} [AddCommGroup X] [Module R X]
      {m : ℕ} (vec : Fin m → X), (Fin m → R) →ₗ[R] X :=
    fun {R} _ {X} _ _ {m} vec =>
      { toFun := fun u => ∑ j : Fin m, u j • vec j
        map_add' := fun u v => by
          simp_rw [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun r u => by
          simp_rw [Pi.smul_apply, smul_eq_mul, mul_smul, ← Finset.smul_sum]
          rfl }

  have hFreeHom_u_single : ∀ {R : Type u} [Ring R] {X : Type u} [AddCommGroup X] [Module R X]
      {m : ℕ} (vec : Fin m → X) (j : Fin m),
      freeHom_u vec (Pi.single j (1 : R)) = vec j := by
    intro R _ X _ _ m vec j
    change ∑ k : Fin m, ((Pi.single j (1 : R) : Fin m → R) k) • vec k = vec j
    rw [Finset.sum_eq_single j]
    · simp
    · intro k _ hk
      rw [Pi.single_eq_of_ne hk, zero_smul]
    · intro hj
      exact False.elim (hj (Finset.mem_univ j))

  have hFreeExt_u : ∀ {R : Type u} [Ring R] {X : Type u} [AddCommGroup X] [Module R X]
      {m : ℕ} {f g : (Fin m → R) →ₗ[R] X},
      (∀ j : Fin m, f (Pi.single j (1 : R)) = g (Pi.single j (1 : R))) → f = g := by
    intro R _ X _ _ m f g hfg
    apply LinearMap.ext
    intro u
    have hu : u = ∑ j : Fin m, u j • (Pi.single j (1 : R) : Fin m → R) := by
      ext k
      simp [Finset.sum_apply, Pi.single_apply]
    rw [hu, map_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, map_smul, hfg j]

  have hGenRes : ∀ (R : Type u) [Ring R] [Fintype R]
      (C₀ C₁ C₂ : Type u) [AddCommGroup C₀] [AddCommGroup C₁] [AddCommGroup C₂]
      [Module R C₀] [Module R C₁] [Module R C₂]
      (d₀ : C₀ →ₗ[R] C₁) (d₁ : C₁ →ₗ[R] C₂)
      (_hd : d₁.comp d₀ = 0)
      (ΦC₀ : C₀ →ₗ[R] C₀) (ΦC₁ : C₁ →ₗ[R] C₁) (ΦC₂ : C₂ →ₗ[R] C₂)
      (_hdΦ₀ : d₀.comp ΦC₀ = ΦC₁.comp d₀)
      (_hdΦ₁ : d₁.comp ΦC₁ = ΦC₂.comp d₁)
      (_hFin₀ : Finite ↥d₀.toAddMonoidHom.ker)
      (_hFin₁ : Finite (↥d₁.toAddMonoidHom.ker ⧸
        AddSubgroup.comap d₁.toAddMonoidHom.ker.subtype d₀.toAddMonoidHom.range))
      (_hFin₂ : Finite (C₂ ⧸ d₁.toAddMonoidHom.range)),
      ∃ (m₁ m₂ : ℕ)
        (P₀ : Type u) (addP₀ : AddCommGroup P₀) (modP₀ : Module R P₀)
        (Z₁ : Type u) (addZ₁ : AddCommGroup Z₁) (modZ₁ : Module R Z₁),
        letI := addP₀; letI := modP₀; letI := addZ₁; letI := modZ₁
        Finite P₀ ∧
        ∃ (δ₀ : P₀ →ₗ[R] (Fin m₁ → R))
          (δ₁ : (Fin m₁ → R) →ₗ[R] (Fin m₂ → R))
          (Φ₀ : P₀ →ₗ[R] P₀)
          (Φ₁ : (Fin m₁ → R) →ₗ[R] (Fin m₁ → R))
          (Φ₂ : (Fin m₂ → R) →ₗ[R] (Fin m₂ → R))
          (γ₀ : P₀ →ₗ[R] C₀)
          (γ₁ : (Fin m₁ → R) →ₗ[R] C₁)
          (γ₂ : (Fin m₂ → R) →ₗ[R] C₂)
          (h₁ : (Fin m₁ → R) →ₗ[R] C₀)
          (h₂ : (Fin m₂ → R) →ₗ[R] C₁)
          (ι₁ : Z₁ →ₗ[R] C₁ × (Fin m₂ → R))
          (β₂ : C₁ × (Fin m₂ → R) →ₗ[R] C₂)
          (ι₀ : P₀ →ₗ[R] C₀ × (Fin m₁ → R))
          (β₁ : C₀ × (Fin m₁ → R) →ₗ[R] Z₁),
          δ₁.comp δ₀ = 0 ∧
          δ₀.comp Φ₀ = Φ₁.comp δ₀ ∧
          δ₁.comp Φ₁ = Φ₂.comp δ₁ ∧
          (∀ x, d₀ (γ₀ x) = γ₁ (δ₀ x)) ∧
          (∀ x, d₁ (γ₁ x) = γ₂ (δ₁ x)) ∧
          (∀ x, ΦC₀ (γ₀ x) - γ₀ (Φ₀ x) = h₁ (δ₀ x)) ∧
          (∀ x, ΦC₁ (γ₁ x) - γ₁ (Φ₁ x) = d₀ (h₁ x) + h₂ (δ₁ x)) ∧
          (∀ x, ΦC₂ (γ₂ x) - γ₂ (Φ₂ x) = d₁ (h₂ x)) ∧
          (∀ y₂ : C₂, ∃ (y₁ : C₁) (p₂ : Fin m₂ → R), d₁ y₁ + γ₂ p₂ = y₂) ∧
          (∀ (y₁ : C₁) (p₂ : Fin m₂ → R), d₁ y₁ + γ₂ p₂ = 0 →
            ∃ (y₀ : C₀) (p₁ : Fin m₁ → R), d₀ y₀ + γ₁ p₁ = y₁ ∧ - δ₁ p₁ = p₂) ∧
          (∀ (y₀ : C₀) (p₁ : Fin m₁ → R), d₀ y₀ + γ₁ p₁ = 0 → δ₁ p₁ = 0 →
            ∃ p₀ : P₀, γ₀ p₀ = y₀ ∧ - δ₀ p₀ = p₁) ∧
          (∀ p₀ : P₀, γ₀ p₀ = 0 → δ₀ p₀ = 0 → p₀ = 0) ∧
          Function.Injective ι₁ ∧ LinearMap.range ι₁ = LinearMap.ker β₂ ∧ Function.Surjective β₂ ∧
          (∀ p : C₁ × (Fin m₂ → R), β₂ p = d₁ p.1 + γ₂ p.2) ∧
          Function.Injective ι₀ ∧ LinearMap.range ι₀ = LinearMap.ker β₁ ∧ Function.Surjective β₁ ∧
          (∀ p₀ : P₀, ι₀ p₀ = (γ₀ p₀, - δ₀ p₀)) ∧
          (∀ q : C₀ × (Fin m₁ → R), ι₁ (β₁ q) = (d₀ q.1 + γ₁ q.2, - δ₁ q.2)) := by
    intro R _ _ C₀ C₁ C₂ _ _ _ _ _ _ d₀ d₁ hd ΦC₀ ΦC₁ ΦC₂ hdΦ₀ hdΦ₁ hFin₀ hFin₁ hFin₂
    have hd_apply : ∀ x : C₀, d₁ (d₀ x) = 0 := fun x =>
      LinearMap.congr_fun hd x
    have hdΦ₀_apply : ∀ x : C₀, d₀ (ΦC₀ x) = ΦC₁ (d₀ x) := fun x =>
      LinearMap.congr_fun hdΦ₀ x
    have hdΦ₁_apply : ∀ x : C₁, d₁ (ΦC₁ x) = ΦC₂ (d₁ x) := fun x =>
      LinearMap.congr_fun hdΦ₁ x
    let e₂ := (Finite.equivFin (C₂ ⧸ d₁.toAddMonoidHom.range)).symm
    let m₂ := Nat.card (C₂ ⧸ d₁.toAddMonoidHom.range)
    have hy₂_ex : ∀ j : Fin m₂, ∃ y : C₂, QuotientAddGroup.mk' d₁.toAddMonoidHom.range y = e₂ j :=
      fun j => QuotientAddGroup.mk'_surjective _ (e₂ j)
    let y₂_rep : Fin m₂ → C₂ := fun j => Classical.choose (hy₂_ex j)
    have hy₂_spec : ∀ j : Fin m₂,
        QuotientAddGroup.mk' d₁.toAddMonoidHom.range (y₂_rep j) = e₂ j :=
      fun j => Classical.choose_spec (hy₂_ex j)
    let γ₂ : (Fin m₂ → R) →ₗ[R] C₂ := freeHom_u y₂_rep
    have hCone₂ : ∀ y₂ : C₂, ∃ (y₁ : C₁) (p₂ : Fin m₂ → R), d₁ y₁ + γ₂ p₂ = y₂ := by
      intro y₂
      let j : Fin m₂ := e₂.symm (QuotientAddGroup.mk' d₁.toAddMonoidHom.range y₂)
      have hq : QuotientAddGroup.mk' d₁.toAddMonoidHom.range (y₂ - y₂_rep j) = 0 := by
        rw [map_sub, hy₂_spec j, e₂.apply_symm_apply, sub_self]
      rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk'] at hq
      obtain ⟨y₁, hy₁⟩ := hq
      change d₁ y₁ = y₂ - y₂_rep j at hy₁
      refine ⟨y₁, Pi.single j (1 : R), ?_⟩
      rw [hy₁, hFreeHom_u_single, sub_add_cancel]
    let S₂ : Set (Fin m₂ → R) := { p₂ | ∃ w₁ : C₁, d₁ w₁ = γ₂ p₂ }
    let e₁a := (Finite.equivFin ↥S₂).symm
    let m₁a := Nat.card ↥S₂
    let w₁a : Fin m₁a → C₁ := fun i => Classical.choose (e₁a i).2
    have hw₁a : ∀ i : Fin m₁a, d₁ (w₁a i) = γ₂ (e₁a i).1 :=
      fun i => Classical.choose_spec (e₁a i).2
    let B_C₁ := AddSubgroup.comap d₁.toAddMonoidHom.ker.subtype d₀.toAddMonoidHom.range
    let e₁b := (Finite.equivFin (↥d₁.toAddMonoidHom.ker ⧸ B_C₁)).symm
    let m₁b := Nat.card (↥d₁.toAddMonoidHom.ker ⧸ B_C₁)
    have hz₁b_ex : ∀ l : Fin m₁b, ∃ z : ↥d₁.toAddMonoidHom.ker,
        QuotientAddGroup.mk' B_C₁ z = e₁b l :=
      fun l => QuotientAddGroup.mk'_surjective _ (e₁b l)
    let z₁b : Fin m₁b → ↥d₁.toAddMonoidHom.ker := fun l => Classical.choose (hz₁b_ex l)
    have hz₁b_spec : ∀ l : Fin m₁b, QuotientAddGroup.mk' B_C₁ (z₁b l) = e₁b l :=
      fun l => Classical.choose_spec (hz₁b_ex l)
    let m₁ := m₁a + m₁b
    let d₁_vec : Fin m₁ → (Fin m₂ → R) := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => (e₁a i).1
      | Sum.inr _ => 0
    let γ₁_vec : Fin m₁ → C₁ := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => w₁a i
      | Sum.inr l => (z₁b l).1
    let δ₁ : (Fin m₁ → R) →ₗ[R] (Fin m₂ → R) := freeHom_u d₁_vec
    let γ₁ : (Fin m₁ → R) →ₗ[R] C₁ := freeHom_u γ₁_vec
    have hChain₁ : d₁.comp γ₁ = γ₂.comp δ₁ := by
      apply hFreeExt_u
      intro k
      simp only [LinearMap.comp_apply, δ₁, γ₁, hFreeHom_u_single, d₁_vec, γ₁_vec]
      rcases finSumFinEquiv.symm k with i | l
      · exact hw₁a i
      · rw [map_zero]
        exact (z₁b l).2
    have hChain₁_apply : ∀ x, d₁ (γ₁ x) = γ₂ (δ₁ x) := fun x =>
      LinearMap.congr_fun hChain₁ x
    have hCone₁ : ∀ (y₁ : C₁) (p₂ : Fin m₂ → R), d₁ y₁ + γ₂ p₂ = 0 →
        ∃ (y₀ : C₀) (p₁ : Fin m₁ → R), d₀ y₀ + γ₁ p₁ = y₁ ∧ - δ₁ p₁ = p₂ := by
      intro y₁ p₂ h0
      have hp₂_mem : -p₂ ∈ S₂ := ⟨y₁, by rw [map_neg]; exact eq_neg_of_add_eq_zero_left h0⟩
      let i : Fin m₁a := e₁a.symm ⟨-p₂, hp₂_mem⟩
      have hi_val : (e₁a i).1 = -p₂ := congrArg Subtype.val (e₁a.apply_symm_apply ⟨-p₂, hp₂_mem⟩)
      let p₁a : Fin m₁ → R := Pi.single (finSumFinEquiv (Sum.inl i)) (1 : R)
      have hδ₁_a : δ₁ p₁a = -p₂ := by
        change freeHom_u d₁_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : R)) = -p₂
        rw [hFreeHom_u_single]
        dsimp only [d₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
        exact hi_val
      have hγ₁_a : γ₁ p₁a = w₁a i := by
        change freeHom_u γ₁_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : R)) = w₁a i
        rw [hFreeHom_u_single]
        dsimp only [γ₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hy₁'_ker : y₁ - w₁a i ∈ d₁.toAddMonoidHom.ker := by
        change d₁ (y₁ - w₁a i) = 0
        rw [map_sub, hw₁a i, hi_val, map_neg, sub_neg_eq_add, h0]
      let l : Fin m₁b := e₁b.symm (QuotientAddGroup.mk' B_C₁ ⟨y₁ - w₁a i, hy₁'_ker⟩)
      have hq : QuotientAddGroup.mk' B_C₁ (⟨y₁ - w₁a i, hy₁'_ker⟩ - z₁b l) = 0 := by
        rw [map_sub, hz₁b_spec l, e₁b.apply_symm_apply, sub_self]
      rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk'] at hq
      obtain ⟨y₀, hy₀⟩ := hq
      let p₁b : Fin m₁ → R := Pi.single (finSumFinEquiv (Sum.inr l)) (1 : R)
      have hδ₁_b : δ₁ p₁b = 0 := by
        change freeHom_u d₁_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : R)) = 0
        rw [hFreeHom_u_single]
        dsimp only [d₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hγ₁_b : γ₁ p₁b = (z₁b l).1 := by
        change freeHom_u γ₁_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : R)) = (z₁b l).1
        rw [hFreeHom_u_single]
        dsimp only [γ₁_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      refine ⟨y₀, p₁a + p₁b, ?_, ?_⟩
      · rw [map_add, hγ₁_a, hγ₁_b]
        have hy₀' : d₀ y₀ = y₁ - w₁a i - (z₁b l).1 := hy₀
        rw [hy₀']
        abel
      · rw [map_add, hδ₁_a, hδ₁_b, add_zero, neg_neg]
    let S₁ : Set (Fin m₁ → R) := { p₁ | δ₁ p₁ = 0 ∧ ∃ w₀ : C₀, d₀ w₀ = γ₁ p₁ }
    let e₀a := (Finite.equivFin ↥S₁).symm
    let m₀a := Nat.card ↥S₁
    let w₀a : Fin m₀a → C₀ := fun i => Classical.choose (e₀a i).2.2
    have hw₀a : ∀ i : Fin m₀a, d₀ (w₀a i) = γ₁ (e₀a i).1 :=
      fun i => Classical.choose_spec (e₀a i).2.2
    let e₀b := (Finite.equivFin ↥d₀.toAddMonoidHom.ker).symm
    let m₀b := Nat.card ↥d₀.toAddMonoidHom.ker
    let m₀ := m₀a + m₀b
    let d₀_vec : Fin m₀ → (Fin m₁ → R) := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => (e₀a i).1
      | Sum.inr _ => 0
    let γ₀_vec : Fin m₀ → C₀ := fun k =>
      match finSumFinEquiv.symm k with
      | Sum.inl i => w₀a i
      | Sum.inr l => (e₀b l).1
    let d₀_Q : (Fin m₀ → R) →ₗ[R] (Fin m₁ → R) := freeHom_u d₀_vec
    let γ₀_Q : (Fin m₀ → R) →ₗ[R] C₀ := freeHom_u γ₀_vec
    have hd_Q : δ₁.comp d₀_Q = 0 := by
      apply hFreeExt_u
      intro k
      simp only [LinearMap.comp_apply, LinearMap.zero_apply, d₀_Q, hFreeHom_u_single, d₀_vec]
      rcases finSumFinEquiv.symm k with i | l
      · exact (e₀a i).2.1
      · exact map_zero δ₁
    have hChain₀_Q : d₀.comp γ₀_Q = γ₁.comp d₀_Q := by
      apply hFreeExt_u
      intro k
      simp only [LinearMap.comp_apply, d₀_Q, γ₀_Q, hFreeHom_u_single, d₀_vec, γ₀_vec]
      rcases finSumFinEquiv.symm k with i | l
      · exact hw₀a i
      · rw [map_zero]
        exact (e₀b l).2
    let B₀ : Submodule R (Fin m₀ → R) := LinearMap.ker γ₀_Q ⊓ LinearMap.ker d₀_Q
    let P₀ := (Fin m₀ → R) ⧸ B₀
    let π₀ : (Fin m₀ → R) →ₗ[R] P₀ := Submodule.mkQ B₀
    let δ₀ : P₀ →ₗ[R] (Fin m₁ → R) := Submodule.liftQ B₀ d₀_Q inf_le_right
    let γ₀ : P₀ →ₗ[R] C₀ := Submodule.liftQ B₀ γ₀_Q inf_le_left
    have hδ : δ₁.comp δ₀ = 0 := by
      apply LinearMap.ext
      intro x
      obtain ⟨q, rfl⟩ := Submodule.Quotient.mk_surjective B₀ x
      change δ₁ (d₀_Q q) = 0
      exact LinearMap.congr_fun hd_Q q
    have hChain₀_apply : ∀ x : P₀, d₀ (γ₀ x) = γ₁ (δ₀ x) := by
      intro x
      obtain ⟨q, rfl⟩ := Submodule.Quotient.mk_surjective B₀ x
      exact LinearMap.congr_fun hChain₀_Q q
    have hCone₀ : ∀ (y₀ : C₀) (p₁ : Fin m₁ → R), d₀ y₀ + γ₁ p₁ = 0 → δ₁ p₁ = 0 →
        ∃ p₀ : P₀, γ₀ p₀ = y₀ ∧ - δ₀ p₀ = p₁ := by
      intro y₀ p₁ h0 hp₁
      have hp₁_mem : -p₁ ∈ S₁ :=
        ⟨by rw [map_neg, hp₁, neg_zero], y₀, by rw [map_neg]; exact eq_neg_of_add_eq_zero_left h0⟩
      let i : Fin m₀a := e₀a.symm ⟨-p₁, hp₁_mem⟩
      have hi_val : (e₀a i).1 = -p₁ := congrArg Subtype.val (e₀a.apply_symm_apply ⟨-p₁, hp₁_mem⟩)
      let q₀a : Fin m₀ → R := Pi.single (finSumFinEquiv (Sum.inl i)) (1 : R)
      have hd₀_a : d₀_Q q₀a = -p₁ := by
        change freeHom_u d₀_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : R)) = -p₁
        rw [hFreeHom_u_single]
        dsimp only [d₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
        exact hi_val
      have hγ₀_a : γ₀_Q q₀a = w₀a i := by
        change freeHom_u γ₀_vec (Pi.single (finSumFinEquiv (Sum.inl i)) (1 : R)) = w₀a i
        rw [hFreeHom_u_single]
        dsimp only [γ₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hy₀'_ker : y₀ - w₀a i ∈ d₀.toAddMonoidHom.ker := by
        change d₀ (y₀ - w₀a i) = 0
        rw [map_sub, hw₀a i, hi_val, map_neg, sub_neg_eq_add, h0]
      let l : Fin m₀b := e₀b.symm ⟨y₀ - w₀a i, hy₀'_ker⟩
      have hl_val : (e₀b l).1 = y₀ - w₀a i :=
        congrArg Subtype.val (e₀b.apply_symm_apply ⟨y₀ - w₀a i, hy₀'_ker⟩)
      let q₀b : Fin m₀ → R := Pi.single (finSumFinEquiv (Sum.inr l)) (1 : R)
      have hd₀_b : d₀_Q q₀b = 0 := by
        change freeHom_u d₀_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : R)) = 0
        rw [hFreeHom_u_single]
        dsimp only [d₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
      have hγ₀_b : γ₀_Q q₀b = y₀ - w₀a i := by
        change freeHom_u γ₀_vec (Pi.single (finSumFinEquiv (Sum.inr l)) (1 : R)) = y₀ - w₀a i
        rw [hFreeHom_u_single]
        dsimp only [γ₀_vec]
        rw [finSumFinEquiv.symm_apply_apply]
        exact hl_val
      refine ⟨π₀ (q₀a + q₀b), ?_, ?_⟩
      · change γ₀_Q (q₀a + q₀b) = y₀
        rw [map_add, hγ₀_a, hγ₀_b, add_sub_cancel]
      · change - d₀_Q (q₀a + q₀b) = p₁
        rw [map_add, hd₀_a, hd₀_b, add_zero, neg_neg]
    have hCone₀_inj : ∀ p₀ : P₀, γ₀ p₀ = 0 → δ₀ p₀ = 0 → p₀ = 0 := by
      intro p₀ hγ hδ₀
      obtain ⟨q, rfl⟩ := Submodule.Quotient.mk_surjective B₀ p₀
      exact (Submodule.Quotient.mk_eq_zero B₀).mpr ⟨hγ, hδ₀⟩
    let β₂ : C₁ × (Fin m₂ → R) →ₗ[R] C₂ :=
      d₁.comp (LinearMap.fst R C₁ (Fin m₂ → R)) + γ₂.comp (LinearMap.snd R C₁ (Fin m₂ → R))
    let Z₁_sub : Submodule R (C₁ × (Fin m₂ → R)) := LinearMap.ker β₂
    let Z₁ := ↥Z₁_sub
    let ι₁ : Z₁ →ₗ[R] C₁ × (Fin m₂ → R) := Z₁_sub.subtype
    let β₁_raw : C₀ × (Fin m₁ → R) →ₗ[R] C₁ × (Fin m₂ → R) :=
      LinearMap.prod
        (d₀.comp (LinearMap.fst R C₀ (Fin m₁ → R)) + γ₁.comp (LinearMap.snd R C₀ (Fin m₁ → R)))
        (- δ₁.comp (LinearMap.snd R C₀ (Fin m₁ → R)))
    have hβ₁_mem : ∀ q : C₀ × (Fin m₁ → R), β₁_raw q ∈ Z₁_sub := by
      intro ⟨y₀, p₁⟩
      change d₁ (d₀ y₀ + γ₁ p₁) + γ₂ (- δ₁ p₁) = 0
      rw [map_add, hd_apply, zero_add, hChain₁_apply, map_neg, add_neg_cancel]
    let β₁ : C₀ × (Fin m₁ → R) →ₗ[R] Z₁ := LinearMap.codRestrict Z₁_sub β₁_raw hβ₁_mem
    let ι₀ : P₀ →ₗ[R] C₀ × (Fin m₁ → R) := LinearMap.prod γ₀ (-δ₀)
    have hι₀_inj : Function.Injective ι₀ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro p₀ hp₀
      have h1 : γ₀ p₀ = 0 := congrArg Prod.fst hp₀
      have h2 : - δ₀ p₀ = 0 := congrArg Prod.snd hp₀
      exact hCone₀_inj p₀ h1 (neg_eq_zero.mp h2)
    have hExact₀ : LinearMap.range ι₀ = LinearMap.ker β₁ := by
      ext ⟨y₀, p₁⟩
      constructor
      · rintro ⟨p₀, hp₀⟩
        have h1 : γ₀ p₀ = y₀ := congrArg Prod.fst hp₀
        have h2 : - δ₀ p₀ = p₁ := congrArg Prod.snd hp₀
        apply Subtype.ext
        change (d₀ y₀ + γ₁ p₁, - δ₁ p₁) = (0, 0)
        rw [← h1, ← h2, map_neg, hChain₀_apply, add_neg_cancel, map_neg, neg_neg]
        have h3 : δ₁ (δ₀ p₀) = 0 := LinearMap.congr_fun hδ p₀
        rw [h3]
      · intro hker
        have h1 : d₀ y₀ + γ₁ p₁ = 0 := congrArg (fun z : Z₁ => z.1.1) hker
        have h2 : - δ₁ p₁ = 0 := congrArg (fun z : Z₁ => z.1.2) hker
        obtain ⟨p₀, hγ, hδp⟩ := hCone₀ y₀ p₁ h1 (neg_eq_zero.mp h2)
        exact ⟨p₀, Prod.ext hγ hδp⟩
    have hβ₁_surj : Function.Surjective β₁ := by
      rintro ⟨⟨y₁, p₂⟩, hz⟩
      obtain ⟨y₀, p₁, h1, h2⟩ := hCone₁ y₁ p₂ hz
      exact ⟨(y₀, p₁), Subtype.ext (Prod.ext h1 h2)⟩
    have hβ₂_surj : Function.Surjective β₂ := by
      intro y₂
      obtain ⟨y₁, p₂, h⟩ := hCone₂ y₂
      exact ⟨(y₁, p₂), h⟩
    have hLift₂ : ∀ j : Fin m₂, ∃ hp : C₁ × (Fin m₂ → R),
        d₁ hp.1 + γ₂ hp.2 = ΦC₂ (γ₂ (Pi.single j (1 : R))) := by
      intro j
      obtain ⟨y₁, p₂, h⟩ := hCone₂ (ΦC₂ (γ₂ (Pi.single j (1 : R))))
      exact ⟨(y₁, p₂), h⟩
    let h₂_vec : Fin m₂ → C₁ := fun j => (Classical.choose (hLift₂ j)).1
    let φ₂_vec : Fin m₂ → (Fin m₂ → R) := fun j => (Classical.choose (hLift₂ j)).2
    have hLift₂_spec : ∀ j : Fin m₂,
        d₁ (h₂_vec j) + γ₂ (φ₂_vec j) = ΦC₂ (γ₂ (Pi.single j (1 : R))) :=
      fun j => Classical.choose_spec (hLift₂ j)
    let Φ₂ : (Fin m₂ → R) →ₗ[R] (Fin m₂ → R) := freeHom_u φ₂_vec
    let h₂ : (Fin m₂ → R) →ₗ[R] C₁ := freeHom_u h₂_vec
    have hHom₂_map : ΦC₂.comp γ₂ - γ₂.comp Φ₂ = d₁.comp h₂ := by
      apply hFreeExt_u
      intro j
      simp only [LinearMap.sub_apply, LinearMap.comp_apply, Φ₂, h₂, hFreeHom_u_single]
      rw [← hLift₂_spec j, add_sub_cancel_right]
    have hHom₂ : ∀ x, ΦC₂ (γ₂ x) - γ₂ (Φ₂ x) = d₁ (h₂ x) := fun x =>
      LinearMap.congr_fun hHom₂_map x
    have hLift₁ : ∀ k : Fin m₁,
        ∃ hp : C₀ × (Fin m₁ → R),
          d₀ hp.1 + γ₁ hp.2 = ΦC₁ (γ₁ (Pi.single k (1 : R))) - h₂ (δ₁ (Pi.single k (1 : R))) ∧
          - δ₁ hp.2 = - Φ₂ (δ₁ (Pi.single k (1 : R))) := by
      intro k
      set ek : Fin m₁ → R := Pi.single k (1 : R)
      have h0 : d₁ (ΦC₁ (γ₁ ek) - h₂ (δ₁ ek)) + γ₂ (- Φ₂ (δ₁ ek)) = 0 := by
        rw [map_sub, hdΦ₁_apply, hChain₁_apply, ← hHom₂ (δ₁ ek), map_neg]
        abel
      obtain ⟨y₀, p₁, h1, h2⟩ := hCone₁ _ _ h0
      exact ⟨(y₀, p₁), h1, h2⟩
    let h₁_vec : Fin m₁ → C₀ := fun k => (Classical.choose (hLift₁ k)).1
    let φ₁_vec : Fin m₁ → (Fin m₁ → R) := fun k => (Classical.choose (hLift₁ k)).2
    have hLift₁_spec : ∀ k : Fin m₁,
        d₀ (h₁_vec k) + γ₁ (φ₁_vec k) =
          ΦC₁ (γ₁ (Pi.single k (1 : R))) - h₂ (δ₁ (Pi.single k (1 : R))) ∧
        - δ₁ (φ₁_vec k) = - Φ₂ (δ₁ (Pi.single k (1 : R))) :=
      fun k => Classical.choose_spec (hLift₁ k)
    let Φ₁ : (Fin m₁ → R) →ₗ[R] (Fin m₁ → R) := freeHom_u φ₁_vec
    let h₁ : (Fin m₁ → R) →ₗ[R] C₀ := freeHom_u h₁_vec
    have hΦ₁_comm : δ₁.comp Φ₁ = Φ₂.comp δ₁ := by
      apply hFreeExt_u
      intro k
      simp only [LinearMap.comp_apply, Φ₁, hFreeHom_u_single]
      exact neg_inj.mp (hLift₁_spec k).2
    have hHom₁_map : ΦC₁.comp γ₁ - γ₁.comp Φ₁ = d₀.comp h₁ + h₂.comp δ₁ := by
      apply hFreeExt_u
      intro k
      simp only [LinearMap.sub_apply, LinearMap.add_apply, LinearMap.comp_apply, Φ₁, h₁,
        hFreeHom_u_single]
      have h1 := (hLift₁_spec k).1
      calc ΦC₁ (γ₁ (Pi.single k 1)) - γ₁ (φ₁_vec k)
          = (d₀ (h₁_vec k) + γ₁ (φ₁_vec k) + h₂ (δ₁ (Pi.single k 1))) - γ₁ (φ₁_vec k) := by
            rw [h1, sub_add_cancel]
        _ = d₀ (h₁_vec k) + h₂ (δ₁ (Pi.single k 1)) := by abel
    have hHom₁ : ∀ x, ΦC₁ (γ₁ x) - γ₁ (Φ₁ x) = d₀ (h₁ x) + h₂ (δ₁ x) := fun x =>
      LinearMap.congr_fun hHom₁_map x
    let α₀ : P₀ →ₗ[R] C₀ × (Fin m₁ → R) :=
      LinearMap.prod (ΦC₀.comp γ₀ - h₁.comp δ₀) (- Φ₁.comp δ₀)
    have hα₀_range : ∀ p₀ : P₀, α₀ p₀ ∈ LinearMap.range ι₀ := by
      intro p₀
      rw [hExact₀, LinearMap.mem_ker]
      apply Subtype.ext
      change (d₀ (ΦC₀ (γ₀ p₀) - h₁ (δ₀ p₀)) + γ₁ (- Φ₁ (δ₀ p₀)), - δ₁ (- Φ₁ (δ₀ p₀))) = (0, 0)
      apply Prod.ext
      · rw [map_sub, hdΦ₀_apply, hChain₀_apply, map_neg]
        have h1 := hHom₁ (δ₀ p₀)
        have h2 : δ₁ (δ₀ p₀) = 0 := LinearMap.congr_fun hδ p₀
        rw [h2, map_zero, add_zero] at h1
        rw [← h1]
        abel
      · change - δ₁ (- Φ₁ (δ₀ p₀)) = 0
        rw [map_neg, neg_neg]
        have h1 := LinearMap.congr_fun hΦ₁_comm (δ₀ p₀)
        change δ₁ (Φ₁ (δ₀ p₀)) = Φ₂ (δ₁ (δ₀ p₀)) at h1
        have h2 : δ₁ (δ₀ p₀) = 0 := LinearMap.congr_fun hδ p₀
        rw [h1, h2, map_zero]
    let φ₀_fun : P₀ → P₀ := fun p₀ => Classical.choose (hα₀_range p₀)
    have hφ₀_spec : ∀ p₀ : P₀, ι₀ (φ₀_fun p₀) = α₀ p₀ :=
      fun p₀ => Classical.choose_spec (hα₀_range p₀)
    let Φ₀ : P₀ →ₗ[R] P₀ :=
      { toFun := φ₀_fun
        map_add' := fun x y => hι₀_inj (by rw [hφ₀_spec, map_add, map_add, hφ₀_spec, hφ₀_spec])
        map_smul' := fun r x => hι₀_inj (by rw [hφ₀_spec, map_smul, map_smul, hφ₀_spec]; rfl) }
    have hΦ₀_comm : δ₀.comp Φ₀ = Φ₁.comp δ₀ := by
      apply LinearMap.ext
      intro p₀
      have h2 := congrArg Prod.snd (hφ₀_spec p₀)
      exact neg_inj.mp h2
    have hHom₀ : ∀ p₀ : P₀, ΦC₀ (γ₀ p₀) - γ₀ (Φ₀ p₀) = h₁ (δ₀ p₀) := by
      intro p₀
      have h1 := congrArg Prod.fst (hφ₀_spec p₀)
      change γ₀ (Φ₀ p₀) = ΦC₀ (γ₀ p₀) - h₁ (δ₀ p₀) at h1
      rw [h1]
      abel
    exact ⟨m₁, m₂, P₀, inferInstance, inferInstance, Z₁, inferInstance, inferInstance,
      Quotient.finite _, δ₀, δ₁, Φ₀, Φ₁, Φ₂, γ₀, γ₁, γ₂, h₁, h₂, ι₁, β₂, ι₀, β₁,
      hδ, hΦ₀_comm, hΦ₁_comm, hChain₀_apply, hChain₁_apply, hHom₀, hHom₁, hHom₂,
      hCone₂, hCone₁, hCone₀, hCone₀_inj,
      Z₁_sub.injective_subtype, Submodule.range_subtype Z₁_sub, hβ₂_surj, fun _ => rfl,
      hι₀_inj, hExact₀, hβ₁_surj, fun _ => rfl, fun _ => rfl⟩

  
  
  
  have hEqFlat_rev : ∀ {X : Type u} [AddCommGroup X] [Module R_K X]
      {a b c : ℕ} {B : Fin c → Fin b → R_K} {A : Fin b → Fin a → R_K},
      (∀ u : Fin b → R_K,
        (∀ i : Fin a, ∑ j : Fin b, A j i * u j = 0) ↔
        ∃ w : Fin c → R_K, ∀ j : Fin b, u j = ∑ k : Fin c, B k j * w k) →
      ∀ (x : Fin b → X),
        (∃ z : Fin c → X, ∀ j : Fin b, x j = ∑ k : Fin c, B k j • z k) →
        (∀ i : Fin a, ∑ j : Fin b, A j i • x j = 0) := by
    intro X _ _ a b c B A hAB x ⟨z, hz⟩ i
    have hAB0 : ∀ k : Fin c, ∑ j : Fin b, A j i * B k j = 0 := by
      intro k
      refine (hAB (fun j => B k j)).mpr ⟨Pi.single k (1 : R_K), fun j => ?_⟩ i
      rw [Finset.sum_eq_single k]
      · simp
      · intro k' _ hk'
        rw [Pi.single_eq_of_ne hk', mul_zero]
      · intro hk
        exact False.elim (hk (Finset.mem_univ k))
    simp_rw [hz, Finset.smul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero fun k _ => ?_
    simp_rw [← mul_smul, ← Finset.sum_smul, hAB0 k, zero_smul]

  have hEqFlat_free : ∀ m : ℕ, WeilCurveTrIsEqFlat Γ (ℓ ^ K) (Fin m → R_K) := by
    intro m a b c B A hAB x
    refine ⟨fun hx => ?_, hEqFlat_rev hAB x⟩
    have hcoord : ∀ p : Fin m, ∃ w : Fin c → R_K,
        ∀ j : Fin b, x j p = ∑ k : Fin c, B k j * w k := by
      intro p
      refine (hAB (fun j => x j p)).mp fun i => ?_
      simpa [Finset.sum_apply] using congrFun (hx i) p
    refine ⟨fun k p => Classical.choose (hcoord p) k, fun j => ?_⟩
    funext p
    simpa [Finset.sum_apply] using Classical.choose_spec (hcoord p) j

  have hEqFlat_prod : ∀ {X Y : Type u} [AddCommGroup X] [AddCommGroup Y]
      [Module R_K X] [Module R_K Y],
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) X →
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) Y →
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) (X × Y) := by
    intro X Y _ _ _ _ hX hY a b c B A hAB x
    refine ⟨fun hx => ?_, hEqFlat_rev hAB x⟩
    obtain ⟨zX, hzX⟩ := (hX a b c B A hAB (fun j => (x j).1)).mp fun i => by
      simpa [Prod.fst_sum] using congrArg Prod.fst (hx i)
    obtain ⟨zY, hzY⟩ := (hY a b c B A hAB (fun j => (x j).2)).mp fun i => by
      simpa [Prod.snd_sum] using congrArg Prod.snd (hx i)
    refine ⟨fun k => (zX k, zY k), fun j => Prod.ext ?_ ?_⟩
    · simpa [Prod.fst_sum] using hzX j
    · simpa [Prod.snd_sum] using hzY j

  have hEqFlat_ses : ∀ {A_m E_m C_m : Type u}
      [AddCommGroup A_m] [AddCommGroup E_m] [AddCommGroup C_m]
      [Module R_K A_m] [Module R_K E_m] [Module R_K C_m]
      (ι : A_m →ₗ[R_K] E_m) (π : E_m →ₗ[R_K] C_m),
      Function.Injective ι →
      LinearMap.range ι = LinearMap.ker π →
      Function.Surjective π →
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) E_m →
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) C_m →
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) A_m := by
    intro A_m E_m C_m _ _ _ _ _ _ ι π hι_inj hEx hπ_surj hFlatE hFlatC a b c B A hAB x
    refine ⟨fun hx => ?_, hEqFlat_rev hAB x⟩
    obtain ⟨e, he⟩ := (hFlatE a b c B A hAB (fun j => ι (x j))).mp fun i => by
      have hsum : ∑ j : Fin b, A j i • ι (x j) = ι (∑ j : Fin b, A j i • x j) := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => (map_smul ι (A j i) (x j)).symm
      rw [hsum, hx i, map_zero]
    let S_ann : Set (Fin c → R_K) := { v | ∀ j : Fin b, ∑ k : Fin c, B k j * v k = 0 }
    let enumS := (Fintype.equivFin ↥S_ann).symm
    let d := Fintype.card ↥S_ann
    let D : Fin d → Fin c → R_K := fun r k => (enumS r).1 k
    have hBD_exact : ∀ v : Fin c → R_K,
        (∀ j : Fin b, ∑ k : Fin c, B k j * v k = 0) ↔
        ∃ w : Fin d → R_K, ∀ k : Fin c, v k = ∑ r : Fin d, D r k * w r := by
      intro v
      constructor
      · intro hv
        let r₀ : Fin d := enumS.symm ⟨v, hv⟩
        have hr₀ : (enumS r₀).1 = v := congrArg Subtype.val (enumS.apply_symm_apply ⟨v, hv⟩)
        refine ⟨Pi.single r₀ (1 : R_K), fun k => ?_⟩
        rw [Finset.sum_eq_single r₀]
        · dsimp [D]
          rw [hr₀, Pi.single_eq_same, mul_one]
        · intro r _ hr
          rw [Pi.single_eq_of_ne hr, mul_zero]
        · intro hmem
          exact False.elim (hmem (Finset.mem_univ r₀))
      · rintro ⟨w, hw⟩ j
        simp_rw [hw, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero fun r _ => ?_
        simp_rw [← mul_assoc, ← Finset.sum_mul]
        have h0 : ∑ k : Fin c, B k j * D r k = 0 := (enumS r).2 j
        rw [h0, zero_mul]
    have hπe : ∀ j : Fin b, ∑ k : Fin c, B k j • π (e k) = 0 := by
      intro j
      have h1 : π (ι (x j)) = 0 := by
        rw [← LinearMap.mem_ker, ← hEx]
        exact ⟨x j, rfl⟩
      rw [← h1, he j, map_sum]
      refine Finset.sum_congr rfl fun k _ => (map_smul π (B k j) (e k)).symm
    obtain ⟨c_vec, hc_vec⟩ := (hFlatC b c d D B hBD_exact (fun k => π (e k))).mp hπe
    have ht_ex : ∀ r : Fin d, ∃ t : E_m, π t = c_vec r := fun r => hπ_surj (c_vec r)
    let t_vec : Fin d → E_m := fun r => Classical.choose (ht_ex r)
    have ht_spec : ∀ r : Fin d, π (t_vec r) = c_vec r := fun r => Classical.choose_spec (ht_ex r)
    let e' : Fin c → E_m := fun k => e k - ∑ r : Fin d, D r k • t_vec r
    have he'_mem : ∀ k : Fin c, e' k ∈ LinearMap.range ι := by
      intro k
      rw [hEx, LinearMap.mem_ker]
      dsimp [e']
      rw [map_sub, map_sum]
      simp_rw [map_smul, ht_spec]
      rw [hc_vec k, sub_self]
    let z : Fin c → A_m := fun k => Classical.choose (he'_mem k)
    have hz_spec : ∀ k : Fin c, ι (z k) = e' k := fun k => Classical.choose_spec (he'_mem k)
    refine ⟨z, fun j => hι_inj ?_⟩
    rw [map_sum]
    simp_rw [map_smul, hz_spec, e', smul_sub, Finset.sum_sub_distrib, ← he j]
    have hvan : ∑ x_1 : Fin c, B x_1 j • ∑ r : Fin d, D r x_1 • t_vec r = 0 := by
      simp_rw [Finset.smul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero fun r _ => ?_
      simp_rw [← mul_smul, ← Finset.sum_smul]
      have h0 : ∑ k : Fin c, B k j * D r k = 0 := (enumS r).2 j
      rw [h0, zero_smul]
    rw [hvan, sub_zero]

  
  obtain ⟨modK₀, hsmulK₀_raw⟩ := hGroupMod K₀ hTorK.1 ρK₀ hActK₁.1 (fun g₁ g₂ => (hActK_mul g₁ g₂).1)
  obtain ⟨modK₁, hsmulK₁_raw⟩ := hGroupMod K₁ hTorK.2.1 ρK₁ hActK₁.2.1 (fun g₁ g₂ => (hActK_mul g₁ g₂).2.1)
  obtain ⟨modK₂, hsmulK₂_raw⟩ := hGroupMod K₂ hTorK.2.2 ρK₂ hActK₁.2.2 (fun g₁ g₂ => (hActK_mul g₁ g₂).2.2)
  let _ : Module R_K K₀ := modK₀
  let _ : Module R_K K₁ := modK₁
  let _ : Module R_K K₂ := modK₂
  have hsmulK₀ : ∀ (r : R_K) (x : K₀), r • x = r.coeff.sum (fun g c_g => c_g.val • ρK₀ g x) := hsmulK₀_raw
  have hsmulK₁ : ∀ (r : R_K) (x : K₁), r • x = r.coeff.sum (fun g c_g => c_g.val • ρK₁ g x) := hsmulK₁_raw
  have hsmulK₂ : ∀ (r : R_K) (x : K₂), r • x = r.coeff.sum (fun g c_g => c_g.val • ρK₂ g x) := hsmulK₂_raw

  have hSingleSmulK₀ : ∀ (g : Γ) (x : K₀), (MonoidAlgebra.single g (1 : Λ_K) : R_K) • x = ρK₀ g x := by
    intro g x
    rw [hsmulK₀, Finsupp.sum_fintype _ _ (fun _ => by simp)]
    rw [Finset.sum_eq_single g]
    · simp [MonoidAlgebra.coeff_single, hValOne h1_lt_K]
    · intro g' _ hg'
      simp [MonoidAlgebra.coeff_single, hg'.symm]
    · intro hg
      exact False.elim (hg (Finset.mem_univ g))

  have hSingleSmulK₁ : ∀ (g : Γ) (x : K₁), (MonoidAlgebra.single g (1 : Λ_K) : R_K) • x = ρK₁ g x := by
    intro g x
    rw [hsmulK₁, Finsupp.sum_fintype _ _ (fun _ => by simp)]
    rw [Finset.sum_eq_single g]
    · simp [MonoidAlgebra.coeff_single, hValOne h1_lt_K]
    · intro g' _ hg'
      simp [MonoidAlgebra.coeff_single, hg'.symm]
    · intro hg
      exact False.elim (hg (Finset.mem_univ g))

  have hSingleSmulK₂ : ∀ (g : Γ) (x : K₂), (MonoidAlgebra.single g (1 : Λ_K) : R_K) • x = ρK₂ g x := by
    intro g x
    rw [hsmulK₂, Finsupp.sum_fintype _ _ (fun _ => by simp)]
    rw [Finset.sum_eq_single g]
    · simp [MonoidAlgebra.coeff_single, hValOne h1_lt_K]
    · intro g' _ hg'
      simp [MonoidAlgebra.coeff_single, hg'.symm]
    · intro hg
      exact False.elim (hg (Finset.mem_univ g))

  let mkRKLin : ∀ {X Y : Type u} [AddCommGroup X] [AddCommGroup Y] [Module R_K X] [Module R_K Y]
      (ρX : Γ → (X →+ X)) (ρY : Γ → (Y →+ Y))
      (_hX : ∀ (r : R_K) (x : X), r • x = r.coeff.sum (fun g c_g => c_g.val • ρX g x))
      (_hY : ∀ (r : R_K) (y : Y), r • y = r.coeff.sum (fun g c_g => c_g.val • ρY g y))
      (f : X →+ Y)
      (_hf : ∀ g : Γ, f.comp (ρX g) = (ρY g).comp f),
      X →ₗ[R_K] Y :=
    fun {X Y} _ _ _ _ ρX ρY hX hY f hf =>
      { toFun := f
        map_add' := f.map_add
        map_smul' := fun r x => by
          dsimp
          rw [hX r x, hY r (f x)]
          unfold Finsupp.sum
          rw [map_sum f]
          refine Finset.sum_congr rfl fun g _ => ?_
          rw [map_nsmul f]
          have hg := DFunLike.congr_fun (hf g) x
          simpa only [AddMonoidHom.comp_apply] using congrArg (fun z => (r.coeff g).val • z) hg }

  let dK₀_L : K₀ →ₗ[R_K] K₁ := mkRKLin ρK₀ ρK₁ hsmulK₀ hsmulK₁ dK₀ (fun g => (hdK.2.1 g).1)
  let dK₁_L : K₁ →ₗ[R_K] K₂ := mkRKLin ρK₁ ρK₂ hsmulK₁ hsmulK₂ dK₁ (fun g => (hdK.2.1 g).2)
  let ΦK₀_L : K₀ →ₗ[R_K] K₀ := mkRKLin ρK₀ ρK₀ hsmulK₀ hsmulK₀ ΦK₀ (fun g => (hdK.2.2.2.2 g).1)
  let ΦK₁_L : K₁ →ₗ[R_K] K₁ := mkRKLin ρK₁ ρK₁ hsmulK₁ hsmulK₁ ΦK₁ (fun g => (hdK.2.2.2.2 g).2.1)
  let ΦK₂_L : K₂ →ₗ[R_K] K₂ := mkRKLin ρK₂ ρK₂ hsmulK₂ hsmulK₂ ΦK₂ (fun g => (hdK.2.2.2.2 g).2.2)

  have hdK_L : dK₁_L.comp dK₀_L = 0 := by
    ext x
    exact DFunLike.congr_fun hdK.1 x
  have hdΦK₀_L : dK₀_L.comp ΦK₀_L = ΦK₁_L.comp dK₀_L := by
    ext x
    exact DFunLike.congr_fun hdK.2.2.1 x
  have hdΦK₁_L : dK₁_L.comp ΦK₁_L = ΦK₂_L.comp dK₁_L := by
    ext x
    exact DFunLike.congr_fun hdK.2.2.2.1 x

  have hFlatK₀ : WeilCurveTrIsEqFlat Γ (ℓ ^ K) K₀ := by
    intro a b c B A hAB x
    simp_rw [hsmulK₀]
    exact (hFlatK a b c B A hAB).1 x
  have hFlatK₁ : WeilCurveTrIsEqFlat Γ (ℓ ^ K) K₁ := by
    intro a b c B A hAB x
    simp_rw [hsmulK₁]
    exact (hFlatK a b c B A hAB).2.1 x
  have hFlatK₂ : WeilCurveTrIsEqFlat Γ (ℓ ^ K) K₂ := by
    intro a b c B A hAB x
    simp_rw [hsmulK₂]
    exact (hFlatK a b c B A hAB).2.2 x

  obtain ⟨m₁_K, m₂_K, P₀_K, addP₀_K, modP₀_K, Z₁_K, addZ₁_K, modZ₁_K,
    hFinP₀_K, δ₀_K, δ₁_K, Φ₀_K, Φ₁_K, Φ₂_K, γM₀, γM₁, γM₂, hM₁, hM₂,
    ι₁_K, β₂_K, ι₀_K, β₁_K,
    hδ_K, hΦ₀_K_comm, hΦ₁_K_comm, hChainM₀, hChainM₁, hHomM₀, hHomM₁, hHomM₂,
    hConeM₂, hConeM₁, hConeM₀, hConeM₀_inj,
    hι₁K_inj, hEx₁K, hβ₂K_surj, hβ₂K_def,
    hι₀K_inj, hEx₀K, hβ₁K_surj, hι₀K_def, hβ₁K_def⟩ :=
    hGenRes R_K K₀ K₁ K₂ dK₀_L dK₁_L hdK_L ΦK₀_L ΦK₁_L ΦK₂_L hdΦK₀_L hdΦK₁_L
      hFinHK.1 hFinHK.2.1 hFinHK.2.2

  let _ : AddCommGroup P₀_K := addP₀_K
  let _ : Module R_K P₀_K := modP₀_K
  let _ : AddCommGroup Z₁_K := addZ₁_K
  let _ : Module R_K Z₁_K := modZ₁_K
  have _ : Finite P₀_K := hFinP₀_K

  let M_K : WeilCurveTrGroupComplex Γ (ℓ ^ K) :=
    { M₀ := P₀_K
      M₁ := Fin m₁_K → R_K
      M₂ := Fin m₂_K → R_K
      δ₀ := δ₀_K
      δ₁ := δ₁_K
      hδ := hδ_K
      Φ₀ := Φ₀_K
      Φ₁ := Φ₁_K
      Φ₂ := Φ₂_K
      hΦ₀ := hΦ₀_K_comm
      hΦ₁ := hΦ₁_K_comm }

  have hFlatZ₁_K : WeilCurveTrIsEqFlat Γ (ℓ ^ K) Z₁_K :=
    hEqFlat_ses ι₁_K β₂_K hι₁K_inj hEx₁K hβ₂K_surj
      (hEqFlat_prod hFlatK₁ (hEqFlat_free m₂_K)) hFlatK₂

  have hFlatM₀ : WeilCurveTrIsEqFlat Γ (ℓ ^ K) M_K.M₀ :=
    hEqFlat_ses ι₀_K β₁_K hι₀K_inj hEx₀K hβ₁K_surj
      (hEqFlat_prod hFlatK₀ (hEqFlat_free m₁_K)) hFlatZ₁_K

  have hFlatM : WeilCurveTrIsEqFlat Γ (ℓ ^ K) M_K.M₀ ∧
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) M_K.M₁ ∧
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) M_K.M₂ :=
    ⟨hFlatM₀, hEqFlat_free m₁_K, hEqFlat_free m₂_K⟩

  have hFinHM : Finite ↥(LinearMap.ker M_K.δ₀) ∧
      Finite (↥(LinearMap.ker M_K.δ₁) ⧸
        (Submodule.comap (LinearMap.ker M_K.δ₁).subtype
          (LinearMap.range M_K.δ₀)).toAddSubgroup) ∧
      Finite (M_K.M₂ ⧸ (LinearMap.range M_K.δ₁).toAddSubgroup) := by
    have _ : Finite M_K.M₀ := hFinP₀_K
    have _ : Finite M_K.M₁ := inferInstanceAs (Finite (Fin m₁_K → R_K))
    have _ : Finite M_K.M₂ := inferInstanceAs (Finite (Fin m₂_K → R_K))
    exact ⟨Subtype.finite, Quotient.finite _, Quotient.finite _⟩

  have hLatM : ∀ σ : Γ,
      WeilCurveTrHasGroupCohomLatticeModel ℓ K B₂ M_K σ (b_V σ) (M_lat_V σ) := by
    intro σ
    let g_σ : R_K := MonoidAlgebra.single σ (1 : Λ_K)
    let MV₀ := ((M_lat_V σ 0).map (PadicInt.toZModPow K)).mulVecLin
    let MV₁ := ((M_lat_V σ 1).map (PadicInt.toZModPow K)).mulVecLin
    let MV₂ := ((M_lat_V σ 2).map (PadicInt.toZModPow K)).mulVecLin
    let B_K₁ := AddSubgroup.comap dK₁.ker.subtype dK₀.range
    obtain ⟨⟨q₀_K, hq₀_int, hq₀_ker, hq₀_cok⟩,
            ⟨q₁_K, hq₁_int, hq₁_ker, hq₁_cok⟩,
            ⟨q₂_K, hq₂_int, hq₂_ker, hq₂_cok⟩⟩ := hLatK σ
    have hsmul_compat : ∀ {A_t : Type} [AddCommGroup A_t] [Module Λ_K A_t]
        {Y_t : Type u} [AddCommGroup Y_t] [Module R_K Y_t]
        (q_hom : A_t →+ Y_t) (c : Λ_K) (x : A_t),
        q_hom (c • x) = s_scalar c • q_hom x := by
      intro A_t _ _ Y_t _ _ q_hom c x
      rw [← ZMod.natCast_zmod_val c, Nat.cast_smul_eq_nsmul, map_nsmul,
        ZMod.natCast_zmod_val c, hs_scalar_val]
    refine ⟨?_, ?_, ?_⟩
    · 
      have hLift₀ : ∀ y : ↥dK₀.ker, ∃ p₀ : M_K.M₀, γM₀ p₀ = y.1 ∧ M_K.δ₀ p₀ = 0 := by
        intro y
        have h0 : dK₀_L y.1 + γM₁ 0 = 0 := by
          rw [map_zero, add_zero]
          exact y.2
        obtain ⟨p₀, hγ, hδp⟩ := hConeM₀ y.1 0 h0 (map_zero M_K.δ₁)
        exact ⟨p₀, hγ, neg_eq_zero.mp hδp⟩
      let inv₀_fun : ↥dK₀.ker → M_K.M₀ := fun y => Classical.choose (hLift₀ y)
      have hinv₀_spec : ∀ y : ↥dK₀.ker,
          γM₀ (inv₀_fun y) = y.1 ∧ M_K.δ₀ (inv₀_fun y) = 0 :=
        fun y => Classical.choose_spec (hLift₀ y)
      let inv₀ : ↥dK₀.ker →+ M_K.M₀ :=
        { toFun := inv₀_fun
          map_zero' := hConeM₀_inj _ (hinv₀_spec 0).1 (hinv₀_spec 0).2
          map_add' := fun a b => by
            apply sub_eq_zero.mp
            apply hConeM₀_inj (inv₀_fun (a + b) - (inv₀_fun a + inv₀_fun b))
            · rw [map_sub, map_add, (hinv₀_spec (a + b)).1, (hinv₀_spec a).1, (hinv₀_spec b).1]
              exact sub_self (a.1 + b.1)
            · rw [map_sub, map_add, (hinv₀_spec (a + b)).2, (hinv₀_spec a).2, (hinv₀_spec b).2]
              simp }
      let q₀ : (Fin (b_V σ 0) → Λ_K) →+ M_K.M₀ := inv₀.comp q₀_K
      have hq₀_γ : ∀ u, γM₀ (q₀ u) = (q₀_K u).1 := fun u => (hinv₀_spec (q₀_K u)).1
      have hq₀_δ : ∀ u, δ₀_K (q₀ u) = 0 := fun u => (hinv₀_spec (q₀_K u)).2
      refine ⟨q₀, fun c x => hsmul_compat q₀ c x, hq₀_δ, ?_, ?_, ?_⟩
      · intro x
        apply sub_eq_zero.mp
        apply hConeM₀_inj (q₀ (MV₀ x) - g_σ • M_K.Φ₀ (q₀ x))
        · rw [map_sub, map_smul, hSingleSmulK₀]
          have h3 := hHomM₀ (q₀ x)
          rw [hq₀_δ x, map_zero] at h3
          have h3' : γM₀ (M_K.Φ₀ (q₀ x)) = ΦK₀ (γM₀ (q₀ x)) :=
            (sub_eq_zero.mp h3).symm
          rw [hq₀_γ (MV₀ x), hq₀_int x, h3', hq₀_γ x, sub_self]
        · rw [map_sub, hq₀_δ (MV₀ x), map_smul]
          have hc := LinearMap.congr_fun M_K.hΦ₀ (q₀ x)
          change δ₀_K (M_K.Φ₀ (q₀ x)) = M_K.Φ₁ (δ₀_K (q₀ x)) at hc
          rw [hc, hq₀_δ x, map_zero, smul_zero, sub_zero]
      · intro x hx
        apply hq₀_ker x
        apply Subtype.ext
        have h1 := congrArg γM₀ hx
        rw [map_zero] at h1
        exact (hq₀_γ x).symm.trans h1
      · intro y hy
        have hy_ker : γM₀ y ∈ dK₀.ker := by
          change dK₀ (γM₀ y) = 0
          have hc := hChainM₀ y
          change dK₀ (γM₀ y) = γM₁ (M_K.δ₀ y) at hc
          rw [hc, hy, map_zero]
        obtain ⟨x, hx⟩ := hq₀_cok ⟨γM₀ y, hy_ker⟩
        refine ⟨x, ?_⟩
        apply sub_eq_zero.mp
        apply hConeM₀_inj (q₀ x - (ℓ ^ B₂ : ℕ) • y)
        · rw [map_sub, map_nsmul, hq₀_γ x, hx]
          exact sub_self _
        · have hy' : δ₀_K y = 0 := hy
