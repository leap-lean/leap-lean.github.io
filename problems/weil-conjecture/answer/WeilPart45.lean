  have hqM_scalar : ∀ {X : Type u} [AddCommGroup X] [Module R_K X] (I_X : Type u)
      [AddCommGroup I_X] [Module Λ_s I_X] (q_X : (Fin N → X) →+ I_X)
      (c : Λ_K) (v : Fin N → X),
      q_X (fun i => s_scalar c • v i) = cast_s c • q_X v := by
    intro X _ _ I_X _ _ q_X c v
    have hfun : (fun i : Fin N => s_scalar c • v i) = c.val • v :=
      funext fun i => hs_scalar_val c (v i)
    have hcast : cast_s c = (c.val : Λ_s) := by
      conv_lhs => rw [← ZMod.natCast_zmod_val c]
      exact map_natCast cast_s c.val
    rw [hfun, map_nsmul, hcast, Nat.cast_smul_eq_nsmul]

  
  have hRel_eq_kerK : ∀ {K_t : Type u} [AddCommGroup K_t] [Module R_K K_t]
      (ρ_t : Γ → (K_t →+ K_t))
      (_hSingle : ∀ (g : Γ) (x : K_t), (MonoidAlgebra.single g (1 : Λ_K) : R_K) • x = ρ_t g x)
      {IG_t : Type u} [AddCommGroup IG_t] (qG_t : (Fin N → K_t) →+ IG_t),
      qG_t.ker = AddSubgroup.closure (
        { u | ∃ w : Fin N → K_t, u = (ℓ ^ (s + 1) : ℕ) • w } ∪
        { u | ∃ (g : Γ) (w : Fin N → K_t),
          u = (fun i => ρ_t g (w i)) -
            (fun i => ∑ j : Fin N, (((τ_rep g⁻¹).val i j).val : ℕ) • w j) }) →
      Rel_sub K_t = qG_t.ker := by
    intro K_t _ _ ρ_t hSingle IG_t _ qG_t hker
    rw [hker]
    refine congrArg AddSubgroup.closure (congrArg _ ?_)
    ext u
    refine exists_congr fun g => exists_congr fun w => ?_
    have h1 : (fun i : Fin N => (MonoidAlgebra.single g (1 : Λ_K) : R_K) • w i) =
        (fun i : Fin N => ρ_t g (w i)) := funext fun i => hSingle g (w i)
    have h2 : (fun i : Fin N => ∑ j : Fin N,
          s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • w j) =
        (fun i : Fin N => ∑ j : Fin N, (((τ_rep g⁻¹).val i j).val : ℕ) • w j) := by
      funext i
      exact Finset.sum_congr rfl fun j _ => hs_scalar_nat _ (w j)
    rw [h1, h2]

  have hRelK₀ : Rel_sub K₀ = qG₀.ker :=
    hRel_eq_kerK ρK₀ hSingleSmulK₀ qG₀ hqG.2.2.2.2.2.2.2.2.1
  have hRelK₁ : Rel_sub K₁ = qG₁.ker :=
    hRel_eq_kerK ρK₁ hSingleSmulK₁ qG₁ hqG.2.2.2.2.2.2.2.2.2.1
  have hRelK₂ : Rel_sub K₂ = qG₂.ker :=
    hRel_eq_kerK ρK₂ hSingleSmulK₂ qG₂ hqG.2.2.2.2.2.2.2.2.2.2

  let pG₀ : F_inv K₀ →+ IG₀ := QuotientAddGroup.lift (Rel_sub K₀) qG₀ (le_of_eq hRelK₀)
  let pG₁ : F_inv K₁ →+ IG₁ := QuotientAddGroup.lift (Rel_sub K₁) qG₁ (le_of_eq hRelK₁)
  let pG₂ : F_inv K₂ →+ IG₂ := QuotientAddGroup.lift (Rel_sub K₂) qG₂ (le_of_eq hRelK₂)

  have hpG_inj : ∀ {K_t IG_t : Type u} [AddCommGroup K_t] [Module R_K K_t] [AddCommGroup IG_t]
      (qG_t : (Fin N → K_t) →+ IG_t) (hRel : Rel_sub K_t = qG_t.ker),
      Function.Injective (QuotientAddGroup.lift (Rel_sub K_t) qG_t (le_of_eq hRel)) := by
    intro K_t IG_t _ _ _ qG_t hRel
    rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro z hz
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub K_t) z
    change qG_t v = 0 at hz
    rw [← AddMonoidHom.mem_ker, ← hRel, ← QuotientAddGroup.ker_mk' (Rel_sub K_t)] at hz
    exact hz

  have hpG₀_inj : Function.Injective pG₀ := hpG_inj qG₀ hRelK₀
  have hpG₁_inj : Function.Injective pG₁ := hpG_inj qG₁ hRelK₁
  have hpG₂_inj : Function.Injective pG₂ := hpG_inj qG₂ hRelK₂
  have hpG₂_surj : Function.Surjective pG₂ := by
    intro y
    obtain ⟨v, rfl⟩ := hqG.2.2.1 y
    exact ⟨q_inv K₂ v, rfl⟩

  let αI₀ : I₀ →ₗ[Λ_s] IG₀ := toLsLin_uu (pG₀.comp (map_Finv γM₀))
  let αI₁ : I₁ →ₗ[Λ_s] IG₁ := toLsLin_uu (pG₁.comp (map_Finv γM₁))
  let αI₂ : I₂ →ₗ[Λ_s] IG₂ := toLsLin_uu (pG₂.comp (map_Finv γM₂))
  let hI₁ : I₁ →ₗ[Λ_s] IG₀ := toLsLin_uu (pG₀.comp (map_Finv hM₁))
  let hI₂ : I₂ →ₗ[Λ_s] IG₁ := toLsLin_uu (pG₁.comp (map_Finv hM₂))

  have hαI₀_mk : ∀ v, αI₀ (q_M₀ v) = qG₀ (fun i => γM₀ (v i)) := fun _ => rfl
  have hαI₁_mk : ∀ v, αI₁ (q_M₁ v) = qG₁ (fun i => γM₁ (v i)) := fun _ => rfl
  have hαI₂_mk : ∀ v, αI₂ (q_M₂ v) = qG₂ (fun i => γM₂ (v i)) := fun _ => rfl
  have hhI₁_mk : ∀ v, hI₁ (q_M₁ v) = qG₀ (fun i => hM₁ (v i)) := fun _ => rfl
  have hhI₂_mk : ∀ v, hI₂ (q_M₂ v) = qG₁ (fun i => hM₂ (v i)) := fun _ => rfl

  have hChainαI₀ : ∀ x : I₀, dIG₀ (αI₀ x) = αI₁ (δI₀ x) := by
    intro x
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₀) x
    change dIG₀ (qG₀ (fun i => γM₀ (v i))) = qG₁ (fun i => γM₁ (M_K.δ₀ (v i)))
    rw [hqG.2.2.2.1]
    exact congrArg qG₁ (funext fun i => hChainM₀ (v i))

  have hChainαI₁ : ∀ x : I₁, dIG₁ (αI₁ x) = αI₂ (δI₁ x) := by
    intro x
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₁) x
    change dIG₁ (qG₁ (fun i => γM₁ (v i))) = qG₂ (fun i => γM₂ (M_K.δ₁ (v i)))
    rw [hqG.2.2.2.2.1]
    exact congrArg qG₂ (funext fun i => hChainM₁ (v i))

  have hHomαI₀ : ∀ x : I₀, ψG₀ (αI₀ x) - αI₀ (ψ₀ x) = hI₁ (δI₀ x) := by
    intro x
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₀) x
    change ψG₀ (qG₀ (fun i => γM₀ (v i))) - qG₀ (fun i => γM₀ (M_K.Φ₀ (v i))) =
      qG₀ (fun i => hM₁ (M_K.δ₀ (v i)))
    rw [hqG.2.2.2.2.2.1, ← map_sub]
    exact congrArg qG₀ (funext fun i => hHomM₀ (v i))

  have hHomαI₁ : ∀ x : I₁, ψG₁ (αI₁ x) - αI₁ (ψ₁ x) = dIG₀ (hI₁ x) + hI₂ (δI₁ x) := by
    intro x
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₁) x
    change ψG₁ (qG₁ (fun i => γM₁ (v i))) - qG₁ (fun i => γM₁ (M_K.Φ₁ (v i))) =
      dIG₀ (qG₀ (fun i => hM₁ (v i))) + qG₁ (fun i => hM₂ (M_K.δ₁ (v i)))
    rw [hqG.2.2.2.2.2.2.1, hqG.2.2.2.1, ← map_sub, ← map_add]
    exact congrArg qG₁ (funext fun i => hHomM₁ (v i))

  have hHomαI₂ : ∀ x : I₂, ψG₂ (αI₂ x) - αI₂ (ψ₂ x) = dIG₁ (hI₂ x) := by
    intro x
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₂) x
    change ψG₂ (qG₂ (fun i => γM₂ (v i))) - qG₂ (fun i => γM₂ (M_K.Φ₂ (v i))) =
      dIG₁ (qG₁ (fun i => hM₂ (v i)))
    rw [hqG.2.2.2.2.2.2.2.1, hqG.2.2.2.2.1, ← map_sub]
    exact congrArg qG₂ (funext fun i => hHomM₂ (v i))

  
  obtain ⟨hι₁_Finv_inj, hEx₁_Finv, hβ₂_Finv_surj⟩ :=
    hFinv_ses ι₁_K β₂_K hι₁K_inj hEx₁K hβ₂K_surj hFlatK₂
  obtain ⟨hι₀_Finv_inj, hEx₀_Finv, hβ₁_Finv_surj⟩ :=
    hFinv_ses ι₀_K β₁_K hι₀K_inj hEx₀K hβ₁K_surj hFlatZ₁_K

  have hConeI₂ : ∀ y₂ : IG₂, ∃ (y₁ : IG₁) (x₂ : I₂), dIG₁ y₁ + αI₂ x₂ = y₂ := by
    intro y₂
    obtain ⟨z₂, rfl⟩ := hpG₂_surj y₂
    obtain ⟨w, rfl⟩ := hβ₂_Finv_surj z₂
    obtain ⟨f, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub (K₁ × (Fin m₂_K → R_K))) w
    refine ⟨qG₁ (fun i => (f i).1), q_M₂ (fun i => (f i).2), ?_⟩
    rw [hqG.2.2.2.2.1, hαI₂_mk, ← map_add]
    change qG₂ (fun i => dK₁ (f i).1 + γM₂ (f i).2) = qG₂ (fun i => β₂_K (f i))
    exact congrArg qG₂ (funext fun i => (hβ₂K_def (f i)).symm)

  have hConeI₁ : ∀ (y₁ : IG₁) (x₂ : I₂),
      dIG₁ y₁ + αI₂ x₂ = 0 →
      ∃ (y₀ : IG₀) (x₁ : I₁), dIG₀ y₀ + αI₁ x₁ = y₁ ∧ -δI₁ x₁ = x₂ := by
    intro y₁ x₂ h0
    obtain ⟨u₁, rfl⟩ := hqG.2.1 y₁
    obtain ⟨v₂, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₂) x₂
    let w := q_inv (K₁ × (Fin m₂_K → R_K)) (fun i => (u₁ i, v₂ i))
    have hw_ker : w ∈ (map_Finv β₂_K).ker := by
      rw [AddMonoidHom.mem_ker]
      apply hpG₂_inj
      rw [map_zero]
      change qG₂ (fun i => β₂_K (u₁ i, v₂ i)) = 0
      have hβ_eq : (fun i : Fin N => β₂_K (u₁ i, v₂ i)) =
          (fun i => dK₁ (u₁ i)) + (fun i => γM₂ (v₂ i)) :=
        funext fun i => hβ₂K_def (u₁ i, v₂ i)
      rw [hβ_eq, map_add, ← hqG.2.2.2.2.1, ← hαI₂_mk]
      exact h0
    rw [← hEx₁_Finv] at hw_ker
    rcases hw_ker with ⟨z₁, hz₁⟩
    obtain ⟨q_finv, rfl⟩ := hβ₁_Finv_surj z₁
    obtain ⟨q_pair, rfl⟩ :=
      QuotientAddGroup.mk'_surjective (Rel_sub (K₀ × (Fin m₁_K → R_K))) q_finv
    have hw_eq : q_inv (K₁ × (Fin m₂_K → R_K))
        (fun i => (dK₀ (q_pair i).1 + γM₁ (q_pair i).2, -δ₁_K (q_pair i).2)) = w := by
      have hcomp : (fun i : Fin N => (dK₀ (q_pair i).1 + γM₁ (q_pair i).2, -δ₁_K (q_pair i).2)) =
          (fun i => ι₁_K (β₁_K (q_pair i))) :=
        funext fun i => (hβ₁K_def (q_pair i)).symm
      rw [hcomp, ← hmap_Finv_mk, ← hmap_Finv_mk]
      exact hz₁
    refine ⟨qG₀ (fun i => (q_pair i).1), q_M₁ (fun i => (q_pair i).2), ?_, ?_⟩
    · have hfst := congrArg (fun z => pG₁ (map_Finv (LinearMap.fst R_K K₁ (Fin m₂_K → R_K)) z)) hw_eq
      change qG₁ (fun i => dK₀ (q_pair i).1 + γM₁ (q_pair i).2) = qG₁ u₁ at hfst
      rw [hqG.2.2.2.1, hαI₁_mk, ← map_add]
      exact hfst
    · have hsnd := congrArg (map_Finv (LinearMap.snd R_K K₁ (Fin m₂_K → R_K))) hw_eq
      change q_M₂ (fun i => -δ₁_K (q_pair i).2) = q_M₂ v₂ at hsnd
      rw [← hsnd]
      change - (q_M₂ (fun i => M_K.δ₁ (q_pair i).2)) = q_M₂ (fun i => -δ₁_K (q_pair i).2)
      rw [← map_neg]
      rfl

  have hConeI₀ : ∀ (y₀ : IG₀) (x₁ : I₁),
      dIG₀ y₀ + αI₁ x₁ = 0 → δI₁ x₁ = 0 →
      ∃ x₀ : I₀, αI₀ x₀ = y₀ ∧ -δI₀ x₀ = x₁ := by
    intro y₀ x₁ h0 hδ1
    obtain ⟨u₀, rfl⟩ := hqG.1 y₀
    obtain ⟨v₁, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₁) x₁
    let q := q_inv (K₀ × (Fin m₁_K → R_K)) (fun i => (u₀ i, v₁ i))
    have hq_ker : q ∈ (map_Finv β₁_K).ker := by
      rw [AddMonoidHom.mem_ker]
      apply hι₁_Finv_inj
      rw [map_zero, hmap_Finv_mk, hmap_Finv_mk]
      have hcomp : (fun i : Fin N => ι₁_K (β₁_K (u₀ i, v₁ i))) =
          (fun i => (dK₀ (u₀ i) + γM₁ (v₁ i), -δ₁_K (v₁ i))) :=
        funext fun i => hβ₁K_def (u₀ i, v₁ i)
      rw [hcomp]
      apply hFinv_prod_zero
      · apply hpG₁_inj
        rw [map_zero]
        change qG₁ (fun i => dK₀ (u₀ i) + γM₁ (v₁ i)) = 0
        have hadd : (fun i : Fin N => dK₀ (u₀ i) + γM₁ (v₁ i)) =
            (fun i => dK₀ (u₀ i)) + (fun i => γM₁ (v₁ i)) := rfl
        rw [hadd, map_add, ← hqG.2.2.2.1, ← hαI₁_mk]
        exact h0
      · change q_M₂ (fun i => -δ₁_K (v₁ i)) = 0
        have hneg : (fun i : Fin N => -δ₁_K (v₁ i)) = - (fun i => M_K.δ₁ (v₁ i)) := rfl
        rw [hneg, map_neg, neg_eq_zero]
        exact hδ1
    rw [← hEx₀_Finv] at hq_ker
    rcases hq_ker with ⟨x₀, hx₀⟩
    refine ⟨x₀, ?_, ?_⟩
    · obtain ⟨v₀, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₀) x₀
      have hfst := congrArg (fun z => pG₀ (map_Finv (LinearMap.fst R_K K₀ (Fin m₁_K → R_K)) z)) hx₀
      change qG₀ (fun i => (ι₀_K (v₀ i)).1) = qG₀ u₀ at hfst
      have h1 : (fun i : Fin N => (ι₀_K (v₀ i)).1) = (fun i => γM₀ (v₀ i)) :=
        funext fun i => congrArg Prod.fst (hι₀K_def (v₀ i))
      rw [h1] at hfst
      exact hfst
    · obtain ⟨v₀, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₀) x₀
      have hsnd := congrArg (map_Finv (LinearMap.snd R_K K₀ (Fin m₁_K → R_K))) hx₀
      change q_M₁ (fun i => (ι₀_K (v₀ i)).2) = q_M₁ v₁ at hsnd
      have h2 : (fun i : Fin N => (ι₀_K (v₀ i)).2) = - (fun i => M_K.δ₀ (v₀ i)) :=
        funext fun i => congrArg Prod.snd (hι₀K_def (v₀ i))
      rw [h2, map_neg] at hsnd
      exact hsnd

  have hConeI₀_inj : ∀ x₀ : I₀, αI₀ x₀ = 0 → δI₀ x₀ = 0 → x₀ = 0 := by
    intro x₀ hα hδ
    apply hι₀_Finv_inj
    rw [map_zero]
    obtain ⟨v₀, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₀) x₀
    rw [hmap_Finv_mk]
    have hcomp : (fun i : Fin N => ι₀_K (v₀ i)) = (fun i => (γM₀ (v₀ i), -δ₀_K (v₀ i))) :=
      funext fun i => hι₀K_def (v₀ i)
    rw [hcomp]
    apply hFinv_prod_zero
    · apply hpG₀_inj
      rw [map_zero]
      exact hα
    · change q_M₁ (fun i => -δ₀_K (v₀ i)) = 0
      have hneg : (fun i : Fin N => -δ₀_K (v₀ i)) = - (fun i => M_K.δ₀ (v₀ i)) := rfl
      rw [hneg, map_neg, neg_eq_zero]
      exact hδ

  
  
  
  let p_vec : ∀ {n : ℕ}, (Fin n → Λ_K) →+ (Fin n → Λ_s) := fun {n} =>
    { toFun := fun u i => cast_s (u i)
      map_zero' := by ext i; simp
      map_add' := fun u v => by ext i; simp }
  have hp_vec_surj : ∀ {n : ℕ}, Function.Surjective (@p_vec n) := by
    intro n x
    refine ⟨fun i => ((x i).val : Λ_K), ?_⟩
    ext i
    change cast_s ((x i).val : Λ_K) = x i
    rw [map_natCast, ZMod.natCast_zmod_val]
  have hp_vec_mat : ∀ {r c : ℕ} (M : Matrix (Fin r) (Fin c) Λ_K) (u : Fin c → Λ_K),
      (M.map cast_s).mulVecLin (p_vec u) = p_vec (M.mulVecLin u) := by
    intro r c M u
    ext i
    simp [p_vec, Matrix.mulVec, dotProduct, map_sum, map_mul]

  let d₀_P : (Fin P_K.n₀ → Λ_s) →ₗ[Λ_s] (Fin P_K.n₁ → Λ_s) := ((P_K.D₀).map cast_s).mulVecLin
  let d₁_P : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] (Fin P_K.n₂ → Λ_s) := ((P_K.D₁).map cast_s).mulVecLin
  let φ₀_P : (Fin P_K.n₀ → Λ_s) →ₗ[Λ_s] (Fin P_K.n₀ → Λ_s) := ((P_K.Φ₀).map cast_s).mulVecLin
  let φ₁_P : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] (Fin P_K.n₁ → Λ_s) := ((P_K.Φ₁).map cast_s).mulVecLin
  let φ₂_P : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] (Fin P_K.n₂ → Λ_s) := ((P_K.Φ₂).map cast_s).mulVecLin

  have hdP_comp_apply : ∀ x : Fin P_K.n₀ → Λ_s, d₁_P (d₀_P x) = 0 := by
    intro x
    obtain ⟨u, rfl⟩ := hp_vec_surj x
    change ((P_K.D₁).map cast_s).mulVecLin (((P_K.D₀).map cast_s).mulVecLin (p_vec u)) = 0
    rw [hp_vec_mat, hp_vec_mat, ← LinearMap.comp_apply, ← Matrix.mulVecLin_mul,
      P_K.hD, Matrix.mulVecLin_zero, LinearMap.zero_apply, map_zero]

  have hφP₀_comm_apply : ∀ x : Fin P_K.n₀ → Λ_s, d₀_P (φ₀_P x) = φ₁_P (d₀_P x) := by
    intro x
    obtain ⟨u, rfl⟩ := hp_vec_surj x
    change ((P_K.D₀).map cast_s).mulVecLin (((P_K.Φ₀).map cast_s).mulVecLin (p_vec u)) =
      ((P_K.Φ₁).map cast_s).mulVecLin (((P_K.D₀).map cast_s).mulVecLin (p_vec u))
    rw [hp_vec_mat, hp_vec_mat, hp_vec_mat, hp_vec_mat,
      ← LinearMap.comp_apply, ← Matrix.mulVecLin_mul,
      ← LinearMap.comp_apply, ← Matrix.mulVecLin_mul, P_K.hΦ₀]

  have hφP₁_comm_apply : ∀ x : Fin P_K.n₁ → Λ_s, d₁_P (φ₁_P x) = φ₂_P (d₁_P x) := by
    intro x
    obtain ⟨u, rfl⟩ := hp_vec_surj x
    change ((P_K.D₁).map cast_s).mulVecLin (((P_K.Φ₁).map cast_s).mulVecLin (p_vec u)) =
      ((P_K.Φ₂).map cast_s).mulVecLin (((P_K.D₁).map cast_s).mulVecLin (p_vec u))
    rw [hp_vec_mat, hp_vec_mat, hp_vec_mat, hp_vec_mat,
      ← LinearMap.comp_apply, ← Matrix.mulVecLin_mul,
      ← LinearMap.comp_apply, ← Matrix.mulVecLin_mul, P_K.hΦ₁]

  let γJ₀_L : (Fin P_K.n₀ → Λ_s) →ₗ[Λ_s] IG₀ := toLsLin_0u γJ₀
  let γJ₁_L : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] IG₁ := toLsLin_0u γJ₁
  let γJ₂_L : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] IG₂ := toLsLin_0u γJ₂
  let hJ₁_L : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] IG₀ := toLsLin_0u hJ₁
  let hJ₂_L : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] IG₁ := toLsLin_0u hJ₂

  
  have hLift_γ₂ : ∀ j : Fin P_K.n₂,
      ∃ sx : IG₁ × I₂, dIG₁ sx.1 + αI₂ sx.2 = γJ₂ (Pi.single j (1 : Λ_s)) := by
    intro j
    obtain ⟨y₁, x₂, h⟩ := hConeI₂ (γJ₂ (Pi.single j (1 : Λ_s)))
    exact ⟨(y₁, x₂), h⟩
  let s₂_vec : Fin P_K.n₂ → IG₁ := fun j => (Classical.choose (hLift_γ₂ j)).1
  let γ₂_vec : Fin P_K.n₂ → I₂ := fun j => (Classical.choose (hLift_γ₂ j)).2
  have hLift_γ₂_spec : ∀ j : Fin P_K.n₂,
      dIG₁ (s₂_vec j) + αI₂ (γ₂_vec j) = γJ₂ (Pi.single j (1 : Λ_s)) :=
    fun j => Classical.choose_spec (hLift_γ₂ j)
  let s₂ : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] IG₁ := freeHom_0u s₂_vec
  let γ₂ : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] I₂ := freeHom_0u γ₂_vec
  have hs₂_map : dIG₁_L ∘ₗ s₂ + αI₂ ∘ₗ γ₂ = γJ₂_L := by
    apply hFreeExt_0u
    intro j
    change dIG₁ (s₂ (Pi.single j 1)) + αI₂ (γ₂ (Pi.single j 1)) = γJ₂ (Pi.single j 1)
    rw [hFreeHom_0u_single, hFreeHom_0u_single]
    exact hLift_γ₂_spec j
  have hs₂_eq : ∀ x : Fin P_K.n₂ → Λ_s, dIG₁ (s₂ x) + αI₂ (γ₂ x) = γJ₂ x :=
    fun x => LinearMap.congr_fun hs₂_map x

  have hLift_γ₁ : ∀ k : Fin P_K.n₁,
      ∃ sx : IG₀ × I₁,
        dIG₀ sx.1 + αI₁ sx.2 =
          γJ₁ (Pi.single k (1 : Λ_s)) - s₂ (d₁_P (Pi.single k (1 : Λ_s))) ∧
        -δI₁ sx.2 = -γ₂ (d₁_P (Pi.single k (1 : Λ_s))) := by
    intro k
    let ek : Fin P_K.n₁ → Λ_s := Pi.single k 1
    have h0 : dIG₁ (γJ₁ ek - s₂ (d₁_P ek)) + αI₂ (-γ₂ (d₁_P ek)) = 0 := by
      rw [map_sub, map_neg, hChainJ₁_bar ek]
      have h2 := hs₂_eq (d₁_P ek)
      rw [← h2]
      abel
    obtain ⟨y₀, x₁, h1, h2⟩ := hConeI₁ _ _ h0
    exact ⟨(y₀, x₁), h1, h2⟩
  let s₁_vec : Fin P_K.n₁ → IG₀ := fun k => (Classical.choose (hLift_γ₁ k)).1
  let γ₁_vec : Fin P_K.n₁ → I₁ := fun k => (Classical.choose (hLift_γ₁ k)).2
  have hLift_γ₁_spec : ∀ k : Fin P_K.n₁,
      dIG₀ (s₁_vec k) + αI₁ (γ₁_vec k) =
        γJ₁ (Pi.single k (1 : Λ_s)) - s₂ (d₁_P (Pi.single k (1 : Λ_s))) ∧
      -δI₁ (γ₁_vec k) = -γ₂ (d₁_P (Pi.single k (1 : Λ_s))) :=
    fun k => Classical.choose_spec (hLift_γ₁ k)
  let s₁ : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] IG₀ := freeHom_0u s₁_vec
  let γ₁ : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] I₁ := freeHom_0u γ₁_vec
  have hChain_γ₁_map : δI₁ ∘ₗ γ₁ = γ₂ ∘ₗ d₁_P := by
    apply hFreeExt_0u
    intro k
    change δI₁ (γ₁ (Pi.single k 1)) = γ₂ (d₁_P (Pi.single k 1))
    rw [hFreeHom_0u_single]
    exact neg_inj.mp (hLift_γ₁_spec k).2
  have hChain_γ₁ : ∀ x : Fin P_K.n₁ → Λ_s, δI₁ (γ₁ x) = γ₂ (d₁_P x) :=
    fun x => LinearMap.congr_fun hChain_γ₁_map x
  have hs₁_map : dIG₀_L ∘ₗ s₁ + s₂ ∘ₗ d₁_P + αI₁ ∘ₗ γ₁ = γJ₁_L := by
    apply hFreeExt_0u
    intro k
    change dIG₀ (s₁ (Pi.single k 1)) + s₂ (d₁_P (Pi.single k 1)) + αI₁ (γ₁ (Pi.single k 1)) =
      γJ₁ (Pi.single k 1)
    rw [hFreeHom_0u_single, hFreeHom_0u_single]
    have h1 := (hLift_γ₁_spec k).1
    calc dIG₀ (s₁_vec k) + s₂ (d₁_P (Pi.single k 1)) + αI₁ (γ₁_vec k)
        = (dIG₀ (s₁_vec k) + αI₁ (γ₁_vec k)) + s₂ (d₁_P (Pi.single k 1)) := by abel
      _ = γJ₁ (Pi.single k 1) := by rw [h1, sub_add_cancel]
  have hs₁_eq : ∀ x : Fin P_K.n₁ → Λ_s, dIG₀ (s₁ x) + s₂ (d₁_P x) + αI₁ (γ₁ x) = γJ₁ x :=
    fun x => LinearMap.congr_fun hs₁_map x

  have hLift_γ₀ : ∀ m : Fin P_K.n₀,
      ∃ x₀ : I₀,
        αI₀ x₀ = γJ₀ (Pi.single m (1 : Λ_s)) - s₁ (d₀_P (Pi.single m (1 : Λ_s))) ∧
        -δI₀ x₀ = -γ₁ (d₀_P (Pi.single m (1 : Λ_s))) := by
    intro m
    let em : Fin P_K.n₀ → Λ_s := Pi.single m 1
    have h0 : dIG₀ (γJ₀ em - s₁ (d₀_P em)) + αI₁ (-γ₁ (d₀_P em)) = 0 := by
      rw [map_sub, map_neg, hChainJ₀_bar em]
      have h1 := hs₁_eq (d₀_P em)
      rw [hdP_comp_apply em, map_zero, add_zero] at h1
      rw [← h1]
      abel
    have h1 : δI₁ (-γ₁ (d₀_P em)) = 0 := by
      rw [map_neg, hChain_γ₁ (d₀_P em), hdP_comp_apply em, map_zero, neg_zero]
    exact hConeI₀ _ _ h0 h1
  let γ₀_vec : Fin P_K.n₀ → I₀ := fun m => Classical.choose (hLift_γ₀ m)
  have hLift_γ₀_spec : ∀ m : Fin P_K.n₀,
      αI₀ (γ₀_vec m) = γJ₀ (Pi.single m (1 : Λ_s)) - s₁ (d₀_P (Pi.single m (1 : Λ_s))) ∧
      -δI₀ (γ₀_vec m) = -γ₁ (d₀_P (Pi.single m (1 : Λ_s))) :=
    fun m => Classical.choose_spec (hLift_γ₀ m)
  let γ₀ : (Fin P_K.n₀ → Λ_s) →ₗ[Λ_s] I₀ := freeHom_0u γ₀_vec
  have hChain_γ₀_map : δI₀ ∘ₗ γ₀ = γ₁ ∘ₗ d₀_P := by
    apply hFreeExt_0u
    intro m
    change δI₀ (γ₀ (Pi.single m 1)) = γ₁ (d₀_P (Pi.single m 1))
    rw [hFreeHom_0u_single]
    exact neg_inj.mp (hLift_γ₀_spec m).2
  have hChain_γ₀ : ∀ x : Fin P_K.n₀ → Λ_s, δI₀ (γ₀ x) = γ₁ (d₀_P x) :=
    fun x => LinearMap.congr_fun hChain_γ₀_map x
  have hs₀_map : s₁ ∘ₗ d₀_P + αI₀ ∘ₗ γ₀ = γJ₀_L := by
    apply hFreeExt_0u
    intro m
    change s₁ (d₀_P (Pi.single m 1)) + αI₀ (γ₀ (Pi.single m 1)) = γJ₀ (Pi.single m 1)
    rw [hFreeHom_0u_single, (hLift_γ₀_spec m).1, add_sub_cancel]
  have hs₀_eq : ∀ x : Fin P_K.n₀ → Λ_s, s₁ (d₀_P x) + αI₀ (γ₀ x) = γJ₀ x :=
    fun x => LinearMap.congr_fun hs₀_map x

  
  have hQI_γ0_inj : ∀ x, d₀_P x = 0 → γ₀ x = 0 → x = 0 := by
    intro x hdx hγx
    apply hQJ0_inj x hdx
    have h0 := hs₀_eq x
    rw [hdx, hγx, map_zero, map_zero, add_zero] at h0
    exact h0.symm

  have hQI_γ0_surj : ∀ y : I₀, δI₀ y = 0 → ∃ x, d₀_P x = 0 ∧ γ₀ x = y := by
    intro y hy
    have hdy : dIG₀ (αI₀ y) = 0 := by rw [hChainαI₀ y, hy, map_zero]
    obtain ⟨x, hdx, hγJx⟩ := hQJ0_surj (αI₀ y) hdy
    refine ⟨x, hdx, ?_⟩
    apply sub_eq_zero.mp
    apply hConeI₀_inj (γ₀ x - y)
    · rw [map_sub]
      have h0 := hs₀_eq x
      rw [hdx, map_zero, zero_add, hγJx] at h0
      rw [h0, sub_self]
    · rw [map_sub, hChain_γ₀ x, hdx, map_zero, hy, sub_zero]

  have hQI_γ1_inj : ∀ x, d₁_P x = 0 → (∃ z, γ₁ x = δI₀ z) → x ∈ LinearMap.range d₀_P := by
    intro x hdx hmem
    rcases hmem with ⟨z, hz⟩
    apply hQJ1_inj x hdx
    refine ⟨s₁ x + αI₀ z, ?_⟩
    have h1 := hs₁_eq x
    rw [hdx, map_zero, add_zero, hz, ← hChainαI₀ z, ← map_add] at h1
    exact h1.symm

  have hQI_γ1_surj : ∀ y : I₁, δI₁ y = 0 → ∃ x, d₁_P x = 0 ∧ ∃ z, y - γ₁ x = δI₀ z := by
    intro y hy
    have hdy : dIG₁ (αI₁ y) = 0 := by rw [hChainαI₁ y, hy, map_zero]
    obtain ⟨x, hdx, w₀, hw₀⟩ := hQJ1_surj (αI₁ y) hdy
    have h1 : dIG₀ (-(w₀ + s₁ x)) + αI₁ (y - γ₁ x) = 0 := by
      rw [map_neg, map_add, map_sub]
      have hs := hs₁_eq x
      rw [hdx, map_zero, add_zero] at hs
      have hαx : αI₁ (γ₁ x) = γJ₁ x - dIG₀ (s₁ x) := eq_sub_of_add_eq' hs
      rw [hαx]
      calc -(dIG₀ w₀ + dIG₀ (s₁ x)) + (αI₁ y - (γJ₁ x - dIG₀ (s₁ x)))
          = (αI₁ y - γJ₁ x) - dIG₀ w₀ := by abel
        _ = 0 := sub_eq_zero.mpr hw₀
    have h2 : δI₁ (y - γ₁ x) = 0 := by
      rw [map_sub, hy, hChain_γ₁ x, hdx, map_zero, sub_zero]
    obtain ⟨z₀, _, hz₀⟩ := hConeI₀ _ _ h1 h2
    exact ⟨x, hdx, -z₀, by rw [map_neg, hz₀]⟩

  have hQI_γ2_inj : ∀ x, (∃ z, γ₂ x = δI₁ z) → x ∈ LinearMap.range d₁_P := by
    intro x hmem
    rcases hmem with ⟨z, hz⟩
    apply hQJ2_inj x
    refine ⟨s₂ x + αI₁ z, ?_⟩
    have h2 := hs₂_eq x
    rw [hz, ← hChainαI₁ z, ← map_add] at h2
    exact h2.symm

  have hQI_γ2_surj : ∀ y : I₂, ∃ x, ∃ z, y - γ₂ x = δI₁ z := by
    intro y
    obtain ⟨x, w₁, hw₁⟩ := hQJ2_surj (αI₂ y)
    have h2 : dIG₁ (-(w₁ + s₂ x)) + αI₂ (y - γ₂ x) = 0 := by
      rw [map_neg, map_add, map_sub]
      have hαx : αI₂ (γ₂ x) = γJ₂ x - dIG₁ (s₂ x) := eq_sub_of_add_eq' (hs₂_eq x)
      rw [hαx]
      calc -(dIG₁ w₁ + dIG₁ (s₂ x)) + (αI₂ y - (γJ₂ x - dIG₁ (s₂ x)))
          = (αI₂ y - γJ₂ x) - dIG₁ w₁ := by abel
        _ = 0 := sub_eq_zero.mpr hw₁
    obtain ⟨_, z₁, _, hz₁⟩ := hConeI₁ _ _ h2
    exact ⟨x, -z₁, by rw [map_neg, hz₁]⟩

  
  let Δ₀ : (Fin P_K.n₀ → Λ_s) →ₗ[Λ_s] I₀ := ψ₀ ∘ₗ γ₀ - γ₀ ∘ₗ φ₀_P
  let Δ₁ : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] I₁ := ψ₁ ∘ₗ γ₁ - γ₁ ∘ₗ φ₁_P
  let Δ₂ : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] I₂ := ψ₂ ∘ₗ γ₂ - γ₂ ∘ₗ φ₂_P

  have hΔ_chain₀ : ∀ x, δI₀ (Δ₀ x) = Δ₁ (d₀_P x) := by
    intro x
    change δI₀ (ψ₀ (γ₀ x) - γ₀ (φ₀_P x)) = ψ₁ (γ₁ (d₀_P x)) - γ₁ (φ₁_P (d₀_P x))
    have hc : δI₀ (ψ₀ (γ₀ x)) = ψ₁ (δI₀ (γ₀ x)) := LinearMap.congr_fun hψI₀_comm (γ₀ x)
    rw [map_sub, hc, hChain_γ₀ x, hChain_γ₀ (φ₀_P x), hφP₀_comm_apply x]

  have hΔ_chain₁ : ∀ x, δI₁ (Δ₁ x) = Δ₂ (d₁_P x) := by
    intro x
    change δI₁ (ψ₁ (γ₁ x) - γ₁ (φ₁_P x)) = ψ₂ (γ₂ (d₁_P x)) - γ₂ (φ₂_P (d₁_P x))
    have hc : δI₁ (ψ₁ (γ₁ x)) = ψ₂ (δI₁ (γ₁ x)) := LinearMap.congr_fun hψI₁_comm (γ₁ x)
    rw [map_sub, hc, hChain_γ₁ x, hChain_γ₁ (φ₁_P x), hφP₁_comm_apply x]

  let T₂ : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] IG₁ :=
    hJ₂_L - ψG₁_L ∘ₗ s₂ + s₂ ∘ₗ φ₂_P - hI₂ ∘ₗ γ₂
  let T₁ : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] IG₀ :=
    hJ₁_L - ψG₀_L ∘ₗ s₁ + s₁ ∘ₗ φ₁_P - hI₁ ∘ₗ γ₁

  have hαΔ₂ : ∀ x, αI₂ (Δ₂ x) = dIG₁ (T₂ x) := by
    intro x
    change αI₂ (ψ₂ (γ₂ x) - γ₂ (φ₂_P x)) =
      dIG₁ (hJ₂ x - ψG₁ (s₂ x) + s₂ (φ₂_P x) - hI₂ (γ₂ x))
    have hψα : αI₂ (ψ₂ (γ₂ x)) = ψG₂ (αI₂ (γ₂ x)) - dIG₁ (hI₂ (γ₂ x)) :=
      sub_eq_iff_eq_add.mp (hHomαI₂ (γ₂ x)) |>.symm |> eq_sub_of_add_eq'
    have hα₂ : αI₂ (γ₂ x) = γJ₂ x - dIG₁ (s₂ x) := eq_sub_of_add_eq' (hs₂_eq x)
    have hα₂_φ : αI₂ (γ₂ (φ₂_P x)) = γJ₂ (φ₂_P x) - dIG₁ (s₂ (φ₂_P x)) :=
      eq_sub_of_add_eq' (hs₂_eq (φ₂_P x))
    have hdψ₁ : dIG₁ (ψG₁ (s₂ x)) = ψG₂ (dIG₁ (s₂ x)) :=
      DFunLike.congr_fun hdIG.2.2 (s₂ x)
    have hhJ := hHomJ₂_bar x
    rw [map_sub, hψα, hα₂, map_sub ψG₂, hα₂_φ]
    rw [map_sub dIG₁, map_add dIG₁, map_sub dIG₁, hdψ₁, ← hhJ]
    abel

  have hαΔ₁ : ∀ x, αI₁ (Δ₁ x) = dIG₀ (T₁ x) + T₂ (d₁_P x) := by
    intro x
    change αI₁ (ψ₁ (γ₁ x) - γ₁ (φ₁_P x)) =
      dIG₀ (hJ₁ x - ψG₀ (s₁ x) + s₁ (φ₁_P x) - hI₁ (γ₁ x)) +
      (hJ₂ (d₁_P x) - ψG₁ (s₂ (d₁_P x)) + s₂ (φ₂_P (d₁_P x)) - hI₂ (γ₂ (d₁_P x)))
    have hψα : αI₁ (ψ₁ (γ₁ x)) =
        ψG₁ (αI₁ (γ₁ x)) - (dIG₀ (hI₁ (γ₁ x)) + hI₂ (δI₁ (γ₁ x))) := by
      have h := hHomαI₁ (γ₁ x)
      calc αI₁ (ψ₁ (γ₁ x))
          = ψG₁ (αI₁ (γ₁ x)) - (ψG₁ (αI₁ (γ₁ x)) - αI₁ (ψ₁ (γ₁ x))) := by abel
        _ = ψG₁ (αI₁ (γ₁ x)) - (dIG₀ (hI₁ (γ₁ x)) + hI₂ (δI₁ (γ₁ x))) := by rw [h]
    have hα₁ : αI₁ (γ₁ x) = γJ₁ x - (dIG₀ (s₁ x) + s₂ (d₁_P x)) :=
      eq_sub_of_add_eq' (hs₁_eq x)
    have hα₁_φ : αI₁ (γ₁ (φ₁_P x)) =
        γJ₁ (φ₁_P x) - (dIG₀ (s₁ (φ₁_P x)) + s₂ (d₁_P (φ₁_P x))) :=
      eq_sub_of_add_eq' (hs₁_eq (φ₁_P x))
    have hdψ₀ : dIG₀ (ψG₀ (s₁ x)) = ψG₁ (dIG₀ (s₁ x)) :=
      DFunLike.congr_fun hdIG.2.1 (s₁ x)
    have hhJ := hHomJ₁_bar x
    rw [map_sub, hψα, hChain_γ₁ x, hα₁, map_sub ψG₁, map_add ψG₁,
      hα₁_φ, hφP₁_comm_apply x]
    rw [map_sub dIG₀, map_add dIG₀, map_sub dIG₀, hdψ₀]
    calc ψG₁ (γJ₁ x) - (ψG₁ (dIG₀ (s₁ x)) + ψG₁ (s₂ (d₁_P x))) -
          (dIG₀ (hI₁ (γ₁ x)) + hI₂ (γ₂ (d₁_P x))) -
          (γJ₁ (φ₁_P x) - (dIG₀ (s₁ (φ₁_P x)) + s₂ (φ₂_P (d₁_P x))))
        = (ψG₁ (γJ₁ x) - γJ₁ (φ₁_P x)) - ψG₁ (dIG₀ (s₁ x)) + dIG₀ (s₁ (φ₁_P x)) -
          dIG₀ (hI₁ (γ₁ x)) - ψG₁ (s₂ (d₁_P x)) + s₂ (φ₂_P (d₁_P x)) - hI₂ (γ₂ (d₁_P x)) := by
            abel
      _ = (dIG₀ (hJ₁ x) + hJ₂ (d₁_P x)) - ψG₁ (dIG₀ (s₁ x)) + dIG₀ (s₁ (φ₁_P x)) -
          dIG₀ (hI₁ (γ₁ x)) - ψG₁ (s₂ (d₁_P x)) + s₂ (φ₂_P (d₁_P x)) - hI₂ (γ₂ (d₁_P x)) := by
            rw [hhJ]
      _ = dIG₀ (hJ₁ x) - ψG₁ (dIG₀ (s₁ x)) + dIG₀ (s₁ (φ₁_P x)) - dIG₀ (hI₁ (γ₁ x)) +
          (hJ₂ (d₁_P x) - ψG₁ (s₂ (d₁_P x)) + s₂ (φ₂_P (d₁_P x)) - hI₂ (γ₂ (d₁_P x))) := by
            abel

  have hαΔ₀ : ∀ x, αI₀ (Δ₀ x) = T₁ (d₀_P x) := by
    intro x
    change αI₀ (ψ₀ (γ₀ x) - γ₀ (φ₀_P x)) =
      hJ₁ (d₀_P x) - ψG₀ (s₁ (d₀_P x)) + s₁ (φ₁_P (d₀_P x)) - hI₁ (γ₁ (d₀_P x))
    have hψα : αI₀ (ψ₀ (γ₀ x)) = ψG₀ (αI₀ (γ₀ x)) - hI₁ (δI₀ (γ₀ x)) := by
      have h := hHomαI₀ (γ₀ x)
      calc αI₀ (ψ₀ (γ₀ x))
          = ψG₀ (αI₀ (γ₀ x)) - (ψG₀ (αI₀ (γ₀ x)) - αI₀ (ψ₀ (γ₀ x))) := by abel
        _ = ψG₀ (αI₀ (γ₀ x)) - hI₁ (δI₀ (γ₀ x)) := by rw [h]
    have hα₀ : αI₀ (γ₀ x) = γJ₀ x - s₁ (d₀_P x) := eq_sub_of_add_eq' (hs₀_eq x)
    have hα₀_φ : αI₀ (γ₀ (φ₀_P x)) = γJ₀ (φ₀_P x) - s₁ (d₀_P (φ₀_P x)) :=
      eq_sub_of_add_eq' (hs₀_eq (φ₀_P x))
    have hhJ := hHomJ₀_bar x
    rw [map_sub, hψα, hChain_γ₀ x, hα₀, map_sub ψG₀, hα₀_φ, hφP₀_comm_apply x]
    calc ψG₀ (γJ₀ x) - ψG₀ (s₁ (d₀_P x)) - hI₁ (γ₁ (d₀_P x)) -
          (γJ₀ (φ₀_P x) - s₁ (φ₁_P (d₀_P x)))
        = (ψG₀ (γJ₀ x) - γJ₀ (φ₀_P x)) - ψG₀ (s₁ (d₀_P x)) +
          s₁ (φ₁_P (d₀_P x)) - hI₁ (γ₁ (d₀_P x)) := by abel
      _ = hJ₁ (d₀_P x) - ψG₀ (s₁ (d₀_P x)) + s₁ (φ₁_P (d₀_P x)) - hI₁ (γ₁ (d₀_P x)) := by
          rw [hhJ]

  have hLift_hbar₂ : ∀ j : Fin P_K.n₂,
      ∃ ux : IG₀ × I₁,
        dIG₀ ux.1 + αI₁ ux.2 = T₂ (Pi.single j (1 : Λ_s)) ∧
        -δI₁ ux.2 = -Δ₂ (Pi.single j (1 : Λ_s)) := by
    intro j
    let ej : Fin P_K.n₂ → Λ_s := Pi.single j 1
    have h0 : dIG₁ (T₂ ej) + αI₂ (-Δ₂ ej) = 0 := by
      rw [map_neg, hαΔ₂ ej, add_neg_cancel]
    obtain ⟨u₀, x₁, h1, h2⟩ := hConeI₁ _ _ h0
    exact ⟨(u₀, x₁), h1, h2⟩
  let u₂_vec : Fin P_K.n₂ → IG₀ := fun j => (Classical.choose (hLift_hbar₂ j)).1
  let hbar₂_vec : Fin P_K.n₂ → I₁ := fun j => (Classical.choose (hLift_hbar₂ j)).2
  have hLift_hbar₂_spec : ∀ j : Fin P_K.n₂,
      dIG₀ (u₂_vec j) + αI₁ (hbar₂_vec j) = T₂ (Pi.single j (1 : Λ_s)) ∧
      -δI₁ (hbar₂_vec j) = -Δ₂ (Pi.single j (1 : Λ_s)) :=
    fun j => Classical.choose_spec (hLift_hbar₂ j)
  let u₂ : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] IG₀ := freeHom_0u u₂_vec
  let hbar₂ : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] I₁ := freeHom_0u hbar₂_vec
  have hhbar₂_map : δI₁ ∘ₗ hbar₂ = Δ₂ := by
    apply hFreeExt_0u
    intro j
    change δI₁ (hbar₂ (Pi.single j 1)) = Δ₂ (Pi.single j 1)
    rw [hFreeHom_0u_single]
    exact neg_inj.mp (hLift_hbar₂_spec j).2
  have hhbar₂_eq : ∀ x : Fin P_K.n₂ → Λ_s, δI₁ (hbar₂ x) = Δ₂ x :=
    fun x => LinearMap.congr_fun hhbar₂_map x
  have hu₂_map : dIG₀_L ∘ₗ u₂ + αI₁ ∘ₗ hbar₂ = T₂ := by
    apply hFreeExt_0u
    intro j
    change dIG₀ (u₂ (Pi.single j 1)) + αI₁ (hbar₂ (Pi.single j 1)) = T₂ (Pi.single j 1)
    rw [hFreeHom_0u_single, hFreeHom_0u_single]
    exact (hLift_hbar₂_spec j).1
  have hu₂_eq : ∀ x : Fin P_K.n₂ → Λ_s, dIG₀ (u₂ x) + αI₁ (hbar₂ x) = T₂ x :=
    fun x => LinearMap.congr_fun hu₂_map x

  have hLift_hbar₁ : ∀ k : Fin P_K.n₁,
      ∃ x₀ : I₀,
        αI₀ x₀ = T₁ (Pi.single k (1 : Λ_s)) + u₂ (d₁_P (Pi.single k (1 : Λ_s))) ∧
        -δI₀ x₀ = hbar₂ (d₁_P (Pi.single k (1 : Λ_s))) - Δ₁ (Pi.single k (1 : Λ_s)) := by
    intro k
    let ek : Fin P_K.n₁ → Λ_s := Pi.single k 1
    have h0 : dIG₀ (T₁ ek + u₂ (d₁_P ek)) + αI₁ (hbar₂ (d₁_P ek) - Δ₁ ek) = 0 := by
      rw [map_add, map_sub, hαΔ₁ ek]
      have hu := hu₂_eq (d₁_P ek)
      calc dIG₀ (T₁ ek) + dIG₀ (u₂ (d₁_P ek)) +
            (αI₁ (hbar₂ (d₁_P ek)) - (dIG₀ (T₁ ek) + T₂ (d₁_P ek)))
          = (dIG₀ (u₂ (d₁_P ek)) + αI₁ (hbar₂ (d₁_P ek))) - T₂ (d₁_P ek) := by abel
        _ = 0 := by rw [hu, sub_self]
    have h1 : δI₁ (hbar₂ (d₁_P ek) - Δ₁ ek) = 0 := by
      rw [map_sub, hhbar₂_eq (d₁_P ek), hΔ_chain₁ ek, sub_self]
    exact hConeI₀ _ _ h0 h1
  let hbar₁_vec : Fin P_K.n₁ → I₀ := fun k => Classical.choose (hLift_hbar₁ k)
  have hLift_hbar₁_spec : ∀ k : Fin P_K.n₁,
      αI₀ (hbar₁_vec k) = T₁ (Pi.single k (1 : Λ_s)) + u₂ (d₁_P (Pi.single k (1 : Λ_s))) ∧
      -δI₀ (hbar₁_vec k) = hbar₂ (d₁_P (Pi.single k (1 : Λ_s))) - Δ₁ (Pi.single k (1 : Λ_s)) :=
    fun k => Classical.choose_spec (hLift_hbar₁ k)
  let hbar₁ : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] I₀ := freeHom_0u hbar₁_vec
  have hhbar₁_map : δI₀ ∘ₗ hbar₁ + hbar₂ ∘ₗ d₁_P = Δ₁ := by
    apply hFreeExt_0u
    intro k
    change δI₀ (hbar₁ (Pi.single k 1)) + hbar₂ (d₁_P (Pi.single k 1)) = Δ₁ (Pi.single k 1)
    rw [hFreeHom_0u_single]
    have h := (hLift_hbar₁_spec k).2
    calc δI₀ (hbar₁_vec k) + hbar₂ (d₁_P (Pi.single k 1))
        = hbar₂ (d₁_P (Pi.single k 1)) - (-δI₀ (hbar₁_vec k)) := by abel
      _ = Δ₁ (Pi.single k 1) := by rw [h, sub_sub_cancel]
  have hhbar₁_eq : ∀ x : Fin P_K.n₁ → Λ_s, δI₀ (hbar₁ x) + hbar₂ (d₁_P x) = Δ₁ x :=
    fun x => LinearMap.congr_fun hhbar₁_map x
  have hαhbar₁_map : αI₀ ∘ₗ hbar₁ = T₁ + u₂ ∘ₗ d₁_P := by
    apply hFreeExt_0u
    intro k
    change αI₀ (hbar₁ (Pi.single k 1)) = T₁ (Pi.single k 1) + u₂ (d₁_P (Pi.single k 1))
    rw [hFreeHom_0u_single]
    exact (hLift_hbar₁_spec k).1
  have hαhbar₁_eq : ∀ x : Fin P_K.n₁ → Λ_s, αI₀ (hbar₁ x) = T₁ x + u₂ (d₁_P x) :=
    fun x => LinearMap.congr_fun hαhbar₁_map x

  have hhbar₀_eq : ∀ x : Fin P_K.n₀ → Λ_s, hbar₁ (d₀_P x) = Δ₀ x := by
    intro x
    apply Eq.symm
    apply sub_eq_zero.mp
    apply hConeI₀_inj (Δ₀ x - hbar₁ (d₀_P x))
    · rw [map_sub, hαΔ₀ x, hαhbar₁_eq (d₀_P x), hdP_comp_apply x, map_zero, add_zero, sub_self]
    · rw [map_sub, hΔ_chain₀ x]
      have h1 := hhbar₁_eq (d₀_P x)
      rw [hdP_comp_apply x, map_zero, add_zero] at h1
      rw [h1, sub_self]

  
  let c₀ := Nat.card I₀
  let ev₀ : Fin c₀ ≃ I₀ := (Finite.equivFin I₀).symm
  let e₀ : (Fin c₀ → Λ_s) →ₗ[Λ_s] I₀ := freeHom_0u ev₀
  have he₀_surj : Function.Surjective e₀ := by
    intro y
    refine ⟨Pi.single (ev₀.symm y) (1 : Λ_s), ?_⟩
    rw [hFreeHom_0u_single, Equiv.apply_symm_apply]

  let c₁ := Nat.card I₁
  let ev₁ : Fin c₁ ≃ I₁ := (Finite.equivFin I₁).symm
  let e₁ : (Fin c₁ → Λ_s) →ₗ[Λ_s] I₁ := freeHom_0u ev₁
  have he₁_surj : Function.Surjective e₁ := by
    intro y
    refine ⟨Pi.single (ev₁.symm y) (1 : Λ_s), ?_⟩
    rw [hFreeHom_0u_single, Equiv.apply_symm_apply]

  let ψ₀_bar_vec : Fin c₀ → (Fin c₀ → Λ_s) :=
    fun j => Classical.choose (he₀_surj (ψ₀ (e₀ (Pi.single j (1 : Λ_s)))))
  have hψ₀_bar_spec : ∀ j : Fin c₀, e₀ (ψ₀_bar_vec j) = ψ₀ (e₀ (Pi.single j (1 : Λ_s))) :=
    fun j => Classical.choose_spec (he₀_surj (ψ₀ (e₀ (Pi.single j (1 : Λ_s)))))
  let Ψ₀_bar : (Fin c₀ → Λ_s) →ₗ[Λ_s] (Fin c₀ → Λ_s) := freeHom_00 ψ₀_bar_vec
  have hΨ₀_bar_comm : ∀ u : Fin c₀ → Λ_s, e₀ (Ψ₀_bar u) = ψ₀ (e₀ u) := by
    have hmap : e₀ ∘ₗ Ψ₀_bar = ψ₀ ∘ₗ e₀ := by
      apply hFreeExt_0u
      intro j
      change e₀ (Ψ₀_bar (Pi.single j 1)) = ψ₀ (e₀ (Pi.single j 1))
      rw [hFreeHom_00_single]
      exact hψ₀_bar_spec j
    exact fun u => LinearMap.congr_fun hmap u

  let ψ₁_bar_vec : Fin c₁ → (Fin c₁ → Λ_s) :=
    fun j => Classical.choose (he₁_surj (ψ₁ (e₁ (Pi.single j (1 : Λ_s)))))
  have hψ₁_bar_spec : ∀ j : Fin c₁, e₁ (ψ₁_bar_vec j) = ψ₁ (e₁ (Pi.single j (1 : Λ_s))) :=
    fun j => Classical.choose_spec (he₁_surj (ψ₁ (e₁ (Pi.single j (1 : Λ_s)))))
  let Ψ₁_bar : (Fin c₁ → Λ_s) →ₗ[Λ_s] (Fin c₁ → Λ_s) := freeHom_00 ψ₁_bar_vec
  have hΨ₁_bar_comm : ∀ u : Fin c₁ → Λ_s, e₁ (Ψ₁_bar u) = ψ₁ (e₁ u) := by
    have hmap : e₁ ∘ₗ Ψ₁_bar = ψ₁ ∘ₗ e₁ := by
      apply hFreeExt_0u
      intro j
      change e₁ (Ψ₁_bar (Pi.single j 1)) = ψ₁ (e₁ (Pi.single j 1))
      rw [hFreeHom_00_single]
      exact hψ₁_bar_spec j
    exact fun u => LinearMap.congr_fun hmap u

  let h₁_bar_vec : Fin P_K.n₁ → (Fin c₀ → Λ_s) :=
    fun j => Classical.choose (he₀_surj (hbar₁ (Pi.single j (1 : Λ_s))))
  have hh₁_bar_spec : ∀ j : Fin P_K.n₁, e₀ (h₁_bar_vec j) = hbar₁ (Pi.single j (1 : Λ_s)) :=
    fun j => Classical.choose_spec (he₀_surj (hbar₁ (Pi.single j (1 : Λ_s))))
  let H₁_bar : (Fin P_K.n₁ → Λ_s) →ₗ[Λ_s] (Fin c₀ → Λ_s) := freeHom_00 h₁_bar_vec
  have hH₁_bar_eq : ∀ x : Fin P_K.n₁ → Λ_s, e₀ (H₁_bar x) = hbar₁ x := by
    have hmap : e₀ ∘ₗ H₁_bar = hbar₁ := by
      apply hFreeExt_0u
      intro j
      change e₀ (H₁_bar (Pi.single j 1)) = hbar₁ (Pi.single j 1)
      rw [hFreeHom_00_single]
      exact hh₁_bar_spec j
    exact fun x => LinearMap.congr_fun hmap x

  let h₂_bar_vec : Fin P_K.n₂ → (Fin c₁ → Λ_s) :=
    fun j => Classical.choose (he₁_surj (hbar₂ (Pi.single j (1 : Λ_s))))
  have hh₂_bar_spec : ∀ j : Fin P_K.n₂, e₁ (h₂_bar_vec j) = hbar₂ (Pi.single j (1 : Λ_s)) :=
    fun j => Classical.choose_spec (he₁_surj (hbar₂ (Pi.single j (1 : Λ_s))))
  let H₂_bar : (Fin P_K.n₂ → Λ_s) →ₗ[Λ_s] (Fin c₁ → Λ_s) := freeHom_00 h₂_bar_vec
  have hH₂_bar_eq : ∀ x : Fin P_K.n₂ → Λ_s, e₁ (H₂_bar x) = hbar₂ x := by
    have hmap : e₁ ∘ₗ H₂_bar = hbar₂ := by
      apply hFreeExt_0u
      intro j
      change e₁ (H₂_bar (Pi.single j 1)) = hbar₂ (Pi.single j 1)
      rw [hFreeHom_00_single]
      exact hh₂_bar_spec j
    exact fun x => LinearMap.congr_fun hmap x

  
  let liftLsToLK : ∀ {r c : ℕ},
      ((Fin c → Λ_s) →ₗ[Λ_s] (Fin r → Λ_s)) → ((Fin c → Λ_K) →ₗ[Λ_K] (Fin r → Λ_K)) :=
    fun A_s => ((LinearMap.toMatrix' A_s).map (fun a => (a.val : Λ_K))).mulVecLin

  have hliftLsToLK_p : ∀ {r c : ℕ} (A_s : (Fin c → Λ_s) →ₗ[Λ_s] (Fin r → Λ_s))
      (u : Fin c → Λ_K), p_vec (liftLsToLK A_s u) = A_s (p_vec u) := by
    intro r c A_s u
    change p_vec (((LinearMap.toMatrix' A_s).map (fun a => (a.val : Λ_K))).mulVecLin u) =
      A_s (p_vec u)
    rw [← hp_vec_mat]
    have hmap_eq : ((LinearMap.toMatrix' A_s).map (fun a => (a.val : Λ_K))).map cast_s =
        LinearMap.toMatrix' A_s := by
      ext i j
      simp only [Matrix.map_apply]
      rw [map_natCast, ZMod.natCast_zmod_val]
    rw [hmap_eq]
    exact LinearMap.toMatrix'_mulVec A_s (p_vec u)

  let Ψ₀_K := liftLsToLK Ψ₀_bar
  let Ψ₁_K := liftLsToLK Ψ₁_bar
  let H₁_K := liftLsToLK H₁_bar
  let H₂_K := liftLsToLK H₂_bar
  let D₀_K := P_K.D₀.mulVecLin
  let D₁_K := P_K.D₁.mulVecLin
  let Φ₀_K_P := P_K.Φ₀.mulVecLin
  let Φ₁_K_P := P_K.Φ₁.mulVecLin
  let Φ₂_K_P := P_K.Φ₂.mulVecLin

  have hDK_comp : ∀ x, D₁_K (D₀_K x) = 0 := by
    intro x
    change (P_K.D₁.mulVecLin ∘ₗ P_K.D₀.mulVecLin) x = 0
    rw [← Matrix.mulVecLin_mul, P_K.hD, Matrix.mulVecLin_zero, LinearMap.zero_apply]
  have hΦK₀_P_comm : ∀ x, D₀_K (Φ₀_K_P x) = Φ₁_K_P (D₀_K x) := by
    intro x
    change (P_K.D₀.mulVecLin ∘ₗ P_K.Φ₀.mulVecLin) x = (P_K.Φ₁.mulVecLin ∘ₗ P_K.D₀.mulVecLin) x
    rw [← Matrix.mulVecLin_mul, ← Matrix.mulVecLin_mul, P_K.hΦ₀]
  have hΦK₁_P_comm : ∀ x, D₁_K (Φ₁_K_P x) = Φ₂_K_P (D₁_K x) := by
    intro x
    change (P_K.D₁.mulVecLin ∘ₗ P_K.Φ₁.mulVecLin) x = (P_K.Φ₂.mulVecLin ∘ₗ P_K.D₁.mulVecLin) x
    rw [← Matrix.mulVecLin_mul, ← Matrix.mulVecLin_mul, P_K.hΦ₁]

  
  let split2 : ∀ {R : Type} [CommRing R] {a b : ℕ},
      (Fin (a + b) → R) →ₗ[R] (Fin a → R) × (Fin b → R) :=
    fun {R} _ {a b} =>
      { toFun := fun w =>
          (fun i => w (finSumFinEquiv (Sum.inl i)), fun j => w (finSumFinEquiv (Sum.inr j)))
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }

  let join2 : ∀ {R : Type} [CommRing R] {a b : ℕ},
      (Fin a → R) × (Fin b → R) →ₗ[R] (Fin (a + b) → R) :=
    fun {R} _ {a b} =>
      { toFun := fun p k =>
          match finSumFinEquiv.symm k with
          | Sum.inl i => p.1 i
          | Sum.inr j => p.2 j
        map_add' := fun p q => by
          ext k
          dsimp
          cases finSumFinEquiv.symm k <;> rfl
        map_smul' := fun c p => by
          ext k
          dsimp
          cases finSumFinEquiv.symm k <;> rfl }

  have hsplit_join : ∀ {R : Type} [CommRing R] {a b : ℕ} (p : (Fin a → R) × (Fin b → R)),
      split2 (join2 p) = p := by
    intro R _ a b p
    ext i <;> simp [split2, join2]

  have hjoin_split : ∀ {R : Type} [CommRing R] {a b : ℕ} (w : Fin (a + b) → R),
      join2 (split2 w) = w := by
    intro R _ a b w
    ext k
    change (match finSumFinEquiv.symm k with
      | Sum.inl i => w (finSumFinEquiv (Sum.inl i))
      | Sum.inr j => w (finSumFinEquiv (Sum.inr j))) = w k
    generalize hs : finSumFinEquiv.symm k = s
    cases s with
    | inl i => exact congrArg w ((Equiv.eq_symm_apply finSumFinEquiv).mp hs.symm)
    | inr j => exact congrArg w ((Equiv.eq_symm_apply finSumFinEquiv).mp hs.symm)

  have hsplit_p : ∀ {a b : ℕ} (w : Fin (a + b) → Λ_K),
      split2 (p_vec w) = (p_vec (split2 w).1, p_vec (split2 w).2) :=
    fun _ => rfl

  have hjoin_p : ∀ {a b : ℕ} (u : Fin a → Λ_K) (v : Fin b → Λ_K),
      p_vec (join2 (u, v)) = join2 (p_vec u, p_vec v) := by
    intro a b u v
    ext k
    dsimp [p_vec, join2]
    cases finSumFinEquiv.symm k <;> rfl

  let fn₀ := P_K.n₀ + c₀
  let fn₁ := (P_K.n₁ + c₀) + c₁
  let fn₂ := P_K.n₂ + c₁

  let dF₀_K : (Fin fn₀ → Λ_K) →ₗ[Λ_K] (Fin fn₁ → Λ_K) :=
    { toFun := fun w₀ =>
        let p := split2 w₀
        join2 (join2 (D₀_K p.1, p.2), 0)
      map_add' := fun a b => by
        dsimp only
        rw [← map_add join2, Prod.mk_add_mk, add_zero,
          ← map_add join2, Prod.mk_add_mk, ← map_add D₀_K]
        rfl
      map_smul' := fun c a => by
        dsimp only
        rw [RingHom.id_apply, ← map_smul join2, Prod.smul_mk, smul_zero,
          ← map_smul join2, Prod.smul_mk, ← map_smul D₀_K]
        rfl }

  let dF₁_K : (Fin fn₁ → Λ_K) →ₗ[Λ_K] (Fin fn₂ → Λ_K) :=
    { toFun := fun w₁ =>
        let q := split2 w₁
        let p := split2 q.1
        join2 (D₁_K p.1, q.2)
      map_add' := fun a b => by
        simp only [map_add, Prod.fst_add, Prod.snd_add, ← Prod.mk_add_mk]
      map_smul' := fun c a => by
        simp only [map_smul, Prod.smul_fst, Prod.smul_snd, ← Prod.smul_mk, RingHom.id_apply] }

  let φF₀_K : (Fin fn₀ → Λ_K) →ₗ[Λ_K] (Fin fn₀ → Λ_K) :=
    { toFun := fun w₀ =>
        let p := split2 w₀
        join2 (Φ₀_K_P p.1, H₁_K (D₀_K p.1) + Ψ₀_K p.2)
      map_add' := fun a b => by
        simp only [map_add, Prod.fst_add, Prod.snd_add]
        rw [show H₁_K (D₀_K (split2 a).1) + H₁_K (D₀_K (split2 b).1) +
              (Ψ₀_K (split2 a).2 + Ψ₀_K (split2 b).2) =
            (H₁_K (D₀_K (split2 a).1) + Ψ₀_K (split2 a).2) +
              (H₁_K (D₀_K (split2 b).1) + Ψ₀_K (split2 b).2) by abel]
        rw [← Prod.mk_add_mk, map_add]
      map_smul' := fun c a => by
        simp only [map_smul, Prod.smul_fst, Prod.smul_snd, ← smul_add, ← Prod.smul_mk,
          RingHom.id_apply] }

  let φF₁_K : (Fin fn₁ → Λ_K) →ₗ[Λ_K] (Fin fn₁ → Λ_K) :=
    { toFun := fun w₁ =>
        let q := split2 w₁
        let p := split2 q.1
        join2 (join2 (Φ₁_K_P p.1, H₁_K p.1 + Ψ₀_K p.2), H₂_K (D₁_K p.1) + Ψ₁_K q.2)
      map_add' := fun a b => by
        simp only [map_add, Prod.fst_add, Prod.snd_add]
        have h1 : H₁_K (split2 (split2 a).1).1 + H₁_K (split2 (split2 b).1).1 +
              (Ψ₀_K (split2 (split2 a).1).2 + Ψ₀_K (split2 (split2 b).1).2) =
            (H₁_K (split2 (split2 a).1).1 + Ψ₀_K (split2 (split2 a).1).2) +
              (H₁_K (split2 (split2 b).1).1 + Ψ₀_K (split2 (split2 b).1).2) := by abel
        have h2 : H₂_K (D₁_K (split2 (split2 a).1).1) + H₂_K (D₁_K (split2 (split2 b).1).1) +
              (Ψ₁_K (split2 a).2 + Ψ₁_K (split2 b).2) =
            (H₂_K (D₁_K (split2 (split2 a).1).1) + Ψ₁_K (split2 a).2) +
              (H₂_K (D₁_K (split2 (split2 b).1).1) + Ψ₁_K (split2 b).2) := by abel
        rw [h1, h2, ← Prod.mk_add_mk, map_add, ← Prod.mk_add_mk, map_add]
      map_smul' := fun c a => by
        simp only [map_smul, Prod.smul_fst, Prod.smul_snd, ← smul_add, ← Prod.smul_mk,
          RingHom.id_apply] }

  let φF₂_K : (Fin fn₂ → Λ_K) →ₗ[Λ_K] (Fin fn₂ → Λ_K) :=
    { toFun := fun w₂ =>
        let q := split2 w₂
        join2 (Φ₂_K_P q.1, H₂_K q.1 + Ψ₁_K q.2)
      map_add' := fun a b => by
        simp only [map_add, Prod.fst_add, Prod.snd_add]
        rw [show H₂_K (split2 a).1 + H₂_K (split2 b).1 +
              (Ψ₁_K (split2 a).2 + Ψ₁_K (split2 b).2) =
            (H₂_K (split2 a).1 + Ψ₁_K (split2 a).2) +
              (H₂_K (split2 b).1 + Ψ₁_K (split2 b).2) by abel]
        rw [← Prod.mk_add_mk, map_add]
      map_smul' := fun c a => by
        simp only [map_smul, Prod.smul_fst, Prod.smul_snd, ← smul_add, ← Prod.smul_mk,
          RingHom.id_apply] }

  have hdF_comp : dF₁_K ∘ₗ dF₀_K = 0 := by
    apply LinearMap.ext
    intro w₀
    change dF₁_K (dF₀_K w₀) = 0
    dsimp [dF₀_K, dF₁_K]
    rw [hsplit_join, hsplit_join, hDK_comp]
    exact map_zero join2

  have hφF₀_comm : dF₀_K ∘ₗ φF₀_K = φF₁_K ∘ₗ dF₀_K := by
    apply LinearMap.ext
    intro w₀
    change dF₀_K (φF₀_K w₀) = φF₁_K (dF₀_K w₀)
    dsimp [dF₀_K, φF₀_K, φF₁_K]
    rw [hsplit_join, hsplit_join, hsplit_join, hΦK₀_P_comm, hDK_comp, map_zero, map_zero, add_zero]

  have hφF₁_comm : dF₁_K ∘ₗ φF₁_K = φF₂_K ∘ₗ dF₁_K := by
    apply LinearMap.ext
    intro w₁
    change dF₁_K (φF₁_K w₁) = φF₂_K (dF₁_K w₁)
    dsimp [dF₁_K, φF₁_K, φF₂_K]
    rw [hsplit_join, hsplit_join, hsplit_join, hΦK₁_P_comm]

  let DF₀_mat := LinearMap.toMatrix' dF₀_K
  let DF₁_mat := LinearMap.toMatrix' dF₁_K
  let ΦF₀_mat := LinearMap.toMatrix' φF₀_K
  let ΦF₁_mat := LinearMap.toMatrix' φF₁_K
  let ΦF₂_mat := LinearMap.toMatrix' φF₂_K
  have hDF₀_lin : DF₀_mat.mulVecLin = dF₀_K := LinearMap.ext (LinearMap.toMatrix'_mulVec dF₀_K)
  have hDF₁_lin : DF₁_mat.mulVecLin = dF₁_K := LinearMap.ext (LinearMap.toMatrix'_mulVec dF₁_K)
  have hΦF₀_lin : ΦF₀_mat.mulVecLin = φF₀_K := LinearMap.ext (LinearMap.toMatrix'_mulVec φF₀_K)
  have hΦF₁_lin : ΦF₁_mat.mulVecLin = φF₁_K := LinearMap.ext (LinearMap.toMatrix'_mulVec φF₁_K)
  have hΦF₂_lin : ΦF₂_mat.mulVecLin = φF₂_K := LinearMap.ext (LinearMap.toMatrix'_mulVec φF₂_K)

  let F_K : WeilCurveTrFreeComplex (ℓ ^ K) :=
    { n₀ := fn₀
      n₁ := fn₁
      n₂ := fn₂
      D₀ := DF₀_mat
      D₁ := DF₁_mat
      hD := hMatExt (by rw [Matrix.mulVecLin_mul, hDF₁_lin, hDF₀_lin, hdF_comp,
        Matrix.mulVecLin_zero])
      Φ₀ := ΦF₀_mat
      Φ₁ := ΦF₁_mat
      Φ₂ := ΦF₂_mat
      hΦ₀ := hMatExt (by rw [Matrix.mulVecLin_mul, Matrix.mulVecLin_mul, hDF₀_lin, hΦF₀_lin,
        hΦF₁_lin, hφF₀_comm])
      hΦ₁ := hMatExt (by rw [Matrix.mulVecLin_mul, Matrix.mulVecLin_mul, hDF₁_lin, hΦF₁_lin,
        hΦF₂_lin, hφF₁_comm]) }

  
  have hLatF : WeilCurveTrHasBoundedLatticeModel ℓ K B₁ F_K b_J M_lat_J := by
    let MJ₀ := ((M_lat_J 0).map (PadicInt.toZModPow K)).mulVecLin
    let MJ₁ := ((M_lat_J 1).map (PadicInt.toZModPow K)).mulVecLin
    let MJ₂ := ((M_lat_J 2).map (PadicInt.toZModPow K)).mulVecLin
    rcases hLatP with ⟨⟨q₀_P, hq₀_d, hq₀_φ, hq₀_ker, hq₀_cok⟩,
      ⟨q₁_P, hq₁_d, hq₁_φ, hq₁_ker, hq₁_cok⟩,
      ⟨q₂_P, hq₂_φ, hq₂_ker, hq₂_cok⟩⟩
    refine ⟨?_, ?_, ?_⟩
    · 
      let q₀_F : (Fin (b_J 0) → Λ_K) →ₗ[Λ_K] (Fin F_K.n₀ → Λ_K) :=
        join2 ∘ₗ (LinearMap.inl Λ_K (Fin P_K.n₀ → Λ_K) (Fin c₀ → Λ_K)) ∘ₗ q₀_P
      refine ⟨q₀_F, ?_, ?_, ?_, ?_⟩
      · intro x
        change DF₀_mat.mulVecLin (q₀_F x) = 0
        rw [hDF₀_lin]
        dsimp [q₀_F, dF₀_K]
        rw [hsplit_join]
        change join2 (join2 (D₀_K (q₀_P x), 0), 0) = 0
        rw [hq₀_d x]
        change join2 (join2 (0 : (Fin P_K.n₁ → Λ_K) × (Fin c₀ → Λ_K)), 0) = 0
        rw [map_zero]
        exact map_zero join2
      · intro x
        change q₀_F (MJ₀ x) = ΦF₀_mat.mulVecLin (q₀_F x)
        rw [hΦF₀_lin]
        dsimp [q₀_F, φF₀_K]
        rw [hsplit_join]
        change join2 (q₀_P (MJ₀ x), 0) =
          join2 (Φ₀_K_P (q₀_P x), H₁_K (D₀_K (q₀_P x)) + Ψ₀_K 0)
        rw [hq₀_d x, map_zero, map_zero, add_zero, hq₀_φ x]
      · intro x hx
        apply hq₀_ker x
        have h1 := congrArg (fun w => (split2 w).1) hx
        rw [map_zero] at h1
        dsimp [q₀_F] at h1
        rwa [hsplit_join] at h1
      · intro y hy
        change DF₀_mat.mulVecLin y = 0 at hy
        rw [hDF₀_lin] at hy
        have h1 := congrArg split2 hy
        rw [map_zero] at h1
        dsimp [dF₀_K] at h1
        rw [hsplit_join] at h1
        have h1_fst : join2 (D₀_K (split2 y).1, (split2 y).2) = 0 := congrArg Prod.fst h1
        have h2 := congrArg split2 h1_fst
        rw [hsplit_join, map_zero] at h2
        have hy_d : D₀_K (split2 y).1 = 0 := congrArg Prod.fst h2
        have hy_u0 : (split2 y).2 = 0 := congrArg Prod.snd h2
        obtain ⟨x, hx⟩ := hq₀_cok (split2 y).1 hy_d
        refine ⟨x, ?_⟩
        calc q₀_F x
            = join2 ((ℓ ^ B₁ : ℕ) • (split2 y).1, (ℓ ^ B₁ : ℕ) • (split2 y).2) := by
              dsimp [q₀_F]
              rw [hx, hy_u0, nsmul_zero]
          _ = (ℓ ^ B₁ : ℕ) • join2 (split2 y) := by
              rw [← Prod.smul_mk, map_nsmul]
          _ = (ℓ ^ B₁ : ℕ) • y := by rw [hjoin_split]
    · 
      let q₁_F : (Fin (b_J 1) → Λ_K) →ₗ[Λ_K] (Fin F_K.n₁ → Λ_K) :=
        join2 ∘ₗ (LinearMap.inl Λ_K (Fin (P_K.n₁ + c₀) → Λ_K) (Fin c₁ → Λ_K)) ∘ₗ
          join2 ∘ₗ (LinearMap.inl Λ_K (Fin P_K.n₁ → Λ_K) (Fin c₀ → Λ_K)) ∘ₗ q₁_P
      refine ⟨q₁_F, ?_, ?_, ?_, ?_⟩
      · intro x
        change DF₁_mat.mulVecLin (q₁_F x) = 0
        rw [hDF₁_lin]
        dsimp [q₁_F, dF₁_K]
        rw [hsplit_join, hsplit_join]
        change join2 (D₁_K (q₁_P x), 0) = 0
        rw [hq₁_d x]
        exact map_zero join2
      · intro x
        change q₁_F (MJ₁ x) - ΦF₁_mat.mulVecLin (q₁_F x) ∈ LinearMap.range DF₀_mat.mulVecLin
        rw [hΦF₁_lin, hDF₀_lin]
        obtain ⟨z₀, hz₀⟩ := hq₁_φ x
        refine ⟨join2 (z₀, -H₁_K (q₁_P x)), ?_⟩
        dsimp [q₁_F, φF₁_K, dF₀_K]
        rw [hsplit_join, hsplit_join, hsplit_join]
        change join2 (join2 (D₀_K z₀, -H₁_K (q₁_P x)), 0) =
          join2 (join2 (q₁_P (MJ₁ x), 0), 0) -
            join2 (join2 (Φ₁_K_P (q₁_P x), H₁_K (q₁_P x) + Ψ₀_K 0),
              H₂_K (D₁_K (q₁_P x)) + Ψ₁_K 0)
        rw [hq₁_d x, map_zero, map_zero, map_zero, add_zero, add_zero, hz₀]
        rw [← map_sub join2, Prod.mk_sub_mk, sub_zero, ← map_sub join2, Prod.mk_sub_mk, zero_sub]
      · intro x hx
        change q₁_F x ∈ LinearMap.range DF₀_mat.mulVecLin at hx
        rw [hDF₀_lin] at hx
        rcases hx with ⟨w₀, hw₀⟩
        apply hq₁_ker x
        refine ⟨(split2 w₀).1, ?_⟩
        have h1 := congrArg (fun w => (split2 (split2 w).1).1) hw₀
        dsimp [dF₀_K, q₁_F] at h1
        rwa [hsplit_join, hsplit_join, hsplit_join, hsplit_join] at h1
      · intro y hy
        change DF₁_mat.mulVecLin y = 0 at hy
        rw [hDF₁_lin] at hy
        have h1 := congrArg split2 hy
        rw [map_zero] at h1
        dsimp [dF₁_K] at h1
        rw [hsplit_join] at h1
        have hy_d : D₁_K (split2 (split2 y).1).1 = 0 := congrArg Prod.fst h1
        have hy_u1 : (split2 y).2 = 0 := congrArg Prod.snd h1
        obtain ⟨x, z₀, hxz⟩ := hq₁_cok (split2 (split2 y).1).1 hy_d
        refine ⟨x, ?_⟩
        change (ℓ ^ B₁ : ℕ) • y - q₁_F x ∈ LinearMap.range DF₀_mat.mulVecLin
        rw [hDF₀_lin]
        refine ⟨join2 (z₀, (ℓ ^ B₁ : ℕ) • (split2 (split2 y).1).2), ?_⟩
        have hy_eq : y = join2 (join2 ((split2 (split2 y).1).1, (split2 (split2 y).1).2), 0) := by
          calc y
              = join2 (split2 y) := (hjoin_split y).symm
            _ = join2 ((split2 y).1, (split2 y).2) := rfl
            _ = join2 (join2 (split2 (split2 y).1), 0) := by
                rw [hjoin_split (split2 y).1, hy_u1]
            _ = join2 (join2 ((split2 (split2 y).1).1, (split2 (split2 y).1).2), 0) := rfl
        calc dF₀_K (join2 (z₀, (ℓ ^ B₁ : ℕ) • (split2 (split2 y).1).2))
            = join2 (join2 ((ℓ ^ B₁ : ℕ) • (split2 (split2 y).1).1 - q₁_P x,
                (ℓ ^ B₁ : ℕ) • (split2 (split2 y).1).2), 0) := by
              dsimp [dF₀_K]
              rw [hsplit_join, hxz]
          _ = join2 (join2 ((ℓ ^ B₁ : ℕ) • (split2 (split2 y).1).1,
                (ℓ ^ B₁ : ℕ) • (split2 (split2 y).1).2), 0) -
              join2 (join2 (q₁_P x, 0), 0) := by
              rw [← map_sub join2, Prod.mk_sub_mk, sub_zero,
                ← map_sub join2, Prod.mk_sub_mk, sub_zero]
          _ = (ℓ ^ B₁ : ℕ) • join2 (join2 ((split2 (split2 y).1).1,
                (split2 (split2 y).1).2), 0) - q₁_F x := by
              dsimp only [q₁_F, LinearMap.comp_apply, LinearMap.inl_apply]
              rw [← map_nsmul join2, Prod.smul_mk, nsmul_zero,
                ← map_nsmul join2, Prod.smul_mk]
          _ = (ℓ ^ B₁ : ℕ) • y - q₁_F x := by rw [← hy_eq]
    · 
      let q₂_F : (Fin (b_J 2) → Λ_K) →ₗ[Λ_K] (Fin F_K.n₂ → Λ_K) :=
        join2 ∘ₗ (LinearMap.inl Λ_K (Fin P_K.n₂ → Λ_K) (Fin c₁ → Λ_K)) ∘ₗ q₂_P
      refine ⟨q₂_F, ?_, ?_, ?_⟩
      · intro x
        change q₂_F (MJ₂ x) - ΦF₂_mat.mulVecLin (q₂_F x) ∈ LinearMap.range DF₁_mat.mulVecLin
        rw [hΦF₂_lin, hDF₁_lin]
        obtain ⟨z₁, hz₁⟩ := hq₂_φ x
        refine ⟨join2 (join2 (z₁, 0), -H₂_K (q₂_P x)), ?_⟩
        dsimp [q₂_F, φF₂_K, dF₁_K]
        rw [hsplit_join, hsplit_join, hsplit_join, hz₁]
        change join2 (q₂_P (MJ₂ x) - Φ₂_K_P (q₂_P x), -H₂_K (q₂_P x)) =
          join2 (q₂_P (MJ₂ x), 0) - join2 (Φ₂_K_P (q₂_P x), H₂_K (q₂_P x) + Ψ₁_K 0)
        rw [map_zero, add_zero, ← map_sub join2, Prod.mk_sub_mk, zero_sub]
      · intro x hx
        change q₂_F x ∈ LinearMap.range DF₁_mat.mulVecLin at hx
        rw [hDF₁_lin] at hx
        rcases hx with ⟨w₁, hw₁⟩
        apply hq₂_ker x
        refine ⟨(split2 (split2 w₁).1).1, ?_⟩
        have h1 := congrArg (fun w => (split2 w).1) hw₁
        dsimp [dF₁_K, q₂_F] at h1
        rwa [hsplit_join, hsplit_join] at h1
      · intro y
        obtain ⟨x, z₁, hxz⟩ := hq₂_cok (split2 y).1
        refine ⟨x, ?_⟩
        change (ℓ ^ B₁ : ℕ) • y - q₂_F x ∈ LinearMap.range DF₁_mat.mulVecLin
        rw [hDF₁_lin]
        refine ⟨join2 (join2 (z₁, 0), (ℓ ^ B₁ : ℕ) • (split2 y).2), ?_⟩
        calc dF₁_K (join2 (join2 (z₁, 0), (ℓ ^ B₁ : ℕ) • (split2 y).2))
            = join2 ((ℓ ^ B₁ : ℕ) • (split2 y).1 - q₂_P x, (ℓ ^ B₁ : ℕ) • (split2 y).2) := by
              dsimp [dF₁_K]
              rw [hsplit_join, hsplit_join, hxz]
          _ = join2 ((ℓ ^ B₁ : ℕ) • (split2 y).1, (ℓ ^ B₁ : ℕ) • (split2 y).2) -
              join2 (q₂_P x, 0) := by
              rw [← map_sub join2, Prod.mk_sub_mk, sub_zero]
          _ = (ℓ ^ B₁ : ℕ) • join2 ((split2 y).1, (split2 y).2) - q₂_F x := by
              dsimp only [q₂_F, LinearMap.comp_apply, LinearMap.inl_apply]
              rw [← map_nsmul join2, Prod.smul_mk]
          _ = (ℓ ^ B₁ : ℕ) • y - q₂_F x := by
              have hy_eq : join2 ((split2 y).1, (split2 y).2) = y := hjoin_split y
              rw [hy_eq]

  
  let d₀_bar : (Fin F_K.n₀ → Λ_s) →ₗ[Λ_s] (Fin F_K.n₁ → Λ_s) := ((F_K.D₀).map cast_s).mulVecLin
  let d₁_bar : (Fin F_K.n₁ → Λ_s) →ₗ[Λ_s] (Fin F_K.n₂ → Λ_s) := ((F_K.D₁).map cast_s).mulVecLin
  let φ₀_bar : (Fin F_K.n₀ → Λ_s) →ₗ[Λ_s] (Fin F_K.n₀ → Λ_s) := ((F_K.Φ₀).map cast_s).mulVecLin
  let φ₁_bar : (Fin F_K.n₁ → Λ_s) →ₗ[Λ_s] (Fin F_K.n₁ → Λ_s) := ((F_K.Φ₁).map cast_s).mulVecLin
  let φ₂_bar : (Fin F_K.n₂ → Λ_s) →ₗ[Λ_s] (Fin F_K.n₂ → Λ_s) := ((F_K.Φ₂).map cast_s).mulVecLin

  have hd₀_bar_eq : ∀ w₀ : Fin F_K.n₀ → Λ_s,
      d₀_bar w₀ = join2 (join2 (d₀_P (split2 w₀).1, (split2 w₀).2), 0) := by
    intro w₀
    obtain ⟨u, rfl⟩ := hp_vec_surj w₀
    change (DF₀_mat.map cast_s).mulVecLin (p_vec u) = _
    rw [hp_vec_mat, hDF₀_lin]
    dsimp [dF₀_K]
    rw [hjoin_p, hjoin_p, map_zero p_vec, ← hp_vec_mat]
    rfl

  have hd₁_bar_eq : ∀ w₁ : Fin F_K.n₁ → Λ_s,
      d₁_bar w₁ = join2 (d₁_P (split2 (split2 w₁).1).1, (split2 w₁).2) := by
    intro w₁
    obtain ⟨u, rfl⟩ := hp_vec_surj w₁
    change (DF₁_mat.map cast_s).mulVecLin (p_vec u) = _
    rw [hp_vec_mat, hDF₁_lin]
    dsimp [dF₁_K]
    rw [hjoin_p, ← hp_vec_mat]
    rfl

  have hφ₀_bar_eq : ∀ w₀ : Fin F_K.n₀ → Λ_s,
      φ₀_bar w₀ = join2 (φ₀_P (split2 w₀).1,
        H₁_bar (d₀_P (split2 w₀).1) + Ψ₀_bar (split2 w₀).2) := by
    intro w₀
    obtain ⟨u, rfl⟩ := hp_vec_surj w₀
    change (ΦF₀_mat.map cast_s).mulVecLin (p_vec u) = _
    rw [hp_vec_mat, hΦF₀_lin]
    dsimp [φF₀_K]
    rw [hjoin_p, map_add p_vec, hliftLsToLK_p H₁_bar, hliftLsToLK_p Ψ₀_bar,
      ← hp_vec_mat P_K.Φ₀, ← hp_vec_mat P_K.D₀]
    rfl

  have hφ₁_bar_eq : ∀ w₁ : Fin F_K.n₁ → Λ_s,
      φ₁_bar w₁ = join2 (join2 (φ₁_P (split2 (split2 w₁).1).1,
        H₁_bar (split2 (split2 w₁).1).1 + Ψ₀_bar (split2 (split2 w₁).1).2),
        H₂_bar (d₁_P (split2 (split2 w₁).1).1) + Ψ₁_bar (split2 w₁).2) := by
    intro w₁
    obtain ⟨u, rfl⟩ := hp_vec_surj w₁
    change (ΦF₁_mat.map cast_s).mulVecLin (p_vec u) = _
    rw [hp_vec_mat, hΦF₁_lin]
    dsimp [φF₁_K]
    rw [hjoin_p, hjoin_p, map_add p_vec, map_add p_vec,
      hliftLsToLK_p H₁_bar, hliftLsToLK_p Ψ₀_bar, hliftLsToLK_p H₂_bar, hliftLsToLK_p Ψ₁_bar,
      ← hp_vec_mat P_K.Φ₁, ← hp_vec_mat P_K.D₁]
    rfl

  have hφ₂_bar_eq : ∀ w₂ : Fin F_K.n₂ → Λ_s,
      φ₂_bar w₂ = join2 (φ₂_P (split2 w₂).1, H₂_bar (split2 w₂).1 + Ψ₁_bar (split2 w₂).2) := by
    intro w₂
    obtain ⟨u, rfl⟩ := hp_vec_surj w₂
    change (ΦF₂_mat.map cast_s).mulVecLin (p_vec u) = _
    rw [hp_vec_mat, hΦF₂_lin]
    dsimp [φF₂_K]
    rw [hjoin_p, map_add p_vec, hliftLsToLK_p H₂_bar, hliftLsToLK_p Ψ₁_bar,
      ← hp_vec_mat P_K.Φ₂]
    rfl

  let γ_F₀ : (Fin F_K.n₀ → Λ_s) →ₗ[Λ_s] I₀ :=
    { toFun := fun w₀ => γ₀ (split2 w₀).1 + e₀ (split2 w₀).2
      map_add' := fun a b => by
        simp only [map_add, Prod.fst_add, Prod.snd_add]
        abel
      map_smul' := fun c a => by
        simp only [map_smul, Prod.smul_fst, Prod.smul_snd, smul_add, RingHom.id_apply] }

  let γ_F₁ : (Fin F_K.n₁ → Λ_s) →ₗ[Λ_s] I₁ :=
    { toFun := fun w₁ =>
        γ₁ (split2 (split2 w₁).1).1 + δI₀ (e₀ (split2 (split2 w₁).1).2) + e₁ (split2 w₁).2
      map_add' := fun a b => by
        simp only [map_add, Prod.fst_add, Prod.snd_add]
        abel
      map_smul' := fun c a => by
        simp only [map_smul, Prod.smul_fst, Prod.smul_snd, smul_add, RingHom.id_apply] }

  let γ_F₂ : (Fin F_K.n₂ → Λ_s) →ₗ[Λ_s] I₂ :=
    { toFun := fun w₂ => γ₂ (split2 w₂).1 + δI₁ (e₁ (split2 w₂).2)
      map_add' := fun a b => by
        simp only [map_add, Prod.fst_add, Prod.snd_add]
        abel
      map_smul' := fun c a => by
        simp only [map_smul, Prod.smul_fst, Prod.smul_snd, smul_add, RingHom.id_apply] }

  have hBridge : WeilCurveTrHasRepInvBridge ℓ N s K hsK τ_rep F_K M_K := by
    refine ⟨I₀, I₁, I₂, inferInstance, inferInstance, inferInstance,
      modI₀, modI₁, modI₂, δI₀, δI₁, ψ₀, ψ₁, ψ₂, q_M₀, q_M₁, q_M₂, γ_F₀, γ_F₁, γ_F₂,
      hδI, hψI₀_comm, hψI₁_comm,
      QuotientAddGroup.mk'_surjective _, QuotientAddGroup.mk'_surjective _,
      QuotientAddGroup.mk'_surjective _,
      fun _ => rfl, fun _ => rfl, fun _ => rfl, fun _ => rfl, fun _ => rfl,
      hqM_scalar I₀ q_M₀, hqM_scalar I₁ q_M₁, hqM_scalar I₂ q_M₂,
      ⟨QuotientAddGroup.ker_mk' _, QuotientAddGroup.ker_mk' _, QuotientAddGroup.ker_mk' _⟩,
      ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · 
      apply LinearMap.ext
      intro w₀
      change δI₀ (γ_F₀ w₀) = γ_F₁ (d₀_bar w₀)
      rw [hd₀_bar_eq w₀]
      dsimp [γ_F₀, γ_F₁]
      rw [hsplit_join, hsplit_join, map_add δI₀, hChain_γ₀, map_zero e₁, add_zero]
    · 
      apply LinearMap.ext
      intro w₁
      change δI₁ (γ_F₁ w₁) = γ_F₂ (d₁_bar w₁)
      rw [hd₁_bar_eq w₁]
      dsimp [γ_F₁, γ_F₂]
      rw [hsplit_join, map_add δI₁, map_add δI₁, hChain_γ₁]
      have h0 : δI₁ (δI₀ (e₀ (split2 (split2 w₁).1).2)) = 0 :=
        LinearMap.congr_fun hδI _
      rw [h0, add_zero]
    · 
      apply LinearMap.ext
      intro w₀
      change ψ₀ (γ_F₀ w₀) = γ_F₀ (φ₀_bar w₀)
      rw [hφ₀_bar_eq w₀]
      dsimp [γ_F₀]
      rw [hsplit_join, map_add ψ₀, map_add e₀, hH₁_bar_eq, hΨ₀_bar_comm]
      have hh0 : hbar₁ (d₀_P (split2 w₀).1) = ψ₀ (γ₀ (split2 w₀).1) - γ₀ (φ₀_P (split2 w₀).1) :=
        hhbar₀_eq (split2 w₀).1
      rw [hh0]
      abel
    · 
      apply LinearMap.ext
      intro w₁
      change ψ₁ (γ_F₁ w₁) = γ_F₁ (φ₁_bar w₁)
      rw [hφ₁_bar_eq w₁]
      dsimp [γ_F₁]
      rw [hsplit_join, hsplit_join, map_add ψ₁, map_add ψ₁,
        map_add e₀, map_add δI₀, map_add e₁,
        hH₁_bar_eq, hΨ₀_bar_comm, hH₂_bar_eq, hΨ₁_bar_comm]
      have hcomm0 : ψ₁ (δI₀ (e₀ (split2 (split2 w₁).1).2)) =
          δI₀ (ψ₀ (e₀ (split2 (split2 w₁).1).2)) :=
        (LinearMap.congr_fun hψI₀_comm _).symm
      have hh1 : δI₀ (hbar₁ (split2 (split2 w₁).1).1) + hbar₂ (d₁_P (split2 (split2 w₁).1).1) =
          ψ₁ (γ₁ (split2 (split2 w₁).1).1) - γ₁ (φ₁_P (split2 (split2 w₁).1).1) :=
        hhbar₁_eq (split2 (split2 w₁).1).1
      rw [hcomm0]
      calc ψ₁ (γ₁ (split2 (split2 w₁).1).1) + δI₀ (ψ₀ (e₀ (split2 (split2 w₁).1).2)) +
            ψ₁ (e₁ (split2 w₁).2)
          = γ₁ (φ₁_P (split2 (split2 w₁).1).1) +
              (ψ₁ (γ₁ (split2 (split2 w₁).1).1) - γ₁ (φ₁_P (split2 (split2 w₁).1).1)) +
              δI₀ (ψ₀ (e₀ (split2 (split2 w₁).1).2)) + ψ₁ (e₁ (split2 w₁).2) := by abel
        _ = γ₁ (φ₁_P (split2 (split2 w₁).1).1) +
              (δI₀ (hbar₁ (split2 (split2 w₁).1).1) + hbar₂ (d₁_P (split2 (split2 w₁).1).1)) +
              δI₀ (ψ₀ (e₀ (split2 (split2 w₁).1).2)) + ψ₁ (e₁ (split2 w₁).2) := by rw [← hh1]
        _ = γ₁ (φ₁_P (split2 (split2 w₁).1).1) +
              (δI₀ (hbar₁ (split2 (split2 w₁).1).1) + δI₀ (ψ₀ (e₀ (split2 (split2 w₁).1).2))) +
              (hbar₂ (d₁_P (split2 (split2 w₁).1).1) + ψ₁ (e₁ (split2 w₁).2)) := by abel
    · 
      apply LinearMap.ext
      intro w₂
      change ψ₂ (γ_F₂ w₂) = γ_F₂ (φ₂_bar w₂)
      rw [hφ₂_bar_eq w₂]
      dsimp [γ_F₂]
      rw [hsplit_join, map_add ψ₂, map_add e₁, map_add δI₁, hH₂_bar_eq, hΨ₁_bar_comm]
      have hcomm1 : ψ₂ (δI₁ (e₁ (split2 w₂).2)) = δI₁ (ψ₁ (e₁ (split2 w₂).2)) :=
        (LinearMap.congr_fun hψI₁_comm _).symm
      have hh2 : δI₁ (hbar₂ (split2 w₂).1) = ψ₂ (γ₂ (split2 w₂).1) - γ₂ (φ₂_P (split2 w₂).1) :=
        hhbar₂_eq (split2 w₂).1
      rw [hcomm1, hh2]
      abel
    · 
      intro w₀ hw_d hw_γ
      have h1 := congrArg split2 ((hd₀_bar_eq w₀).symm.trans hw_d)
      rw [hsplit_join, map_zero] at h1
      have h1_fst : join2 (d₀_P (split2 w₀).1, (split2 w₀).2) = 0 := congrArg Prod.fst h1
      have h2 := congrArg split2 h1_fst
      rw [hsplit_join, map_zero] at h2
      have hx_d : d₀_P (split2 w₀).1 = 0 := congrArg Prod.fst h2
      have hu0 : (split2 w₀).2 = 0 := congrArg Prod.snd h2
      dsimp [γ_F₀] at hw_γ
      rw [hu0, map_zero, add_zero] at hw_γ
      have hx0 : (split2 w₀).1 = 0 := hQI_γ0_inj (split2 w₀).1 hx_d hw_γ
      have hsplit0 : split2 w₀ = 0 := Prod.ext hx0 hu0
      rw [← hjoin_split w₀, hsplit0]
      exact map_zero join2
    · 
      intro y hy
      obtain ⟨x₀, hx_d, hx_γ⟩ := hQI_γ0_surj y hy
      refine ⟨join2 (x₀, 0), ?_, ?_⟩
      · rw [hd₀_bar_eq, hsplit_join, hx_d]
        change join2 (join2 (0 : (Fin P_K.n₁ → Λ_s) × (Fin c₀ → Λ_s)), 0) = 0
        rw [map_zero]
        exact map_zero join2
      · dsimp [γ_F₀]
        rw [hsplit_join, map_zero, add_zero, hx_γ]
    · 
      intro w₁ hw_d hmem
      rcases hmem with ⟨z, hz⟩
      have h1 := congrArg split2 ((hd₁_bar_eq w₁).symm.trans hw_d)
      rw [map_zero, hsplit_join] at h1
      have hx_d : d₁_P (split2 (split2 w₁).1).1 = 0 := congrArg Prod.fst h1
      have hu1 : (split2 w₁).2 = 0 := congrArg Prod.snd h1
      dsimp [γ_F₁] at hz
      rw [hu1, map_zero, add_zero] at hz
      have hγ1_mem : γ₁ (split2 (split2 w₁).1).1 = δI₀ (z - e₀ (split2 (split2 w₁).1).2) := by
        rw [map_sub, ← hz, add_sub_cancel_right]
      obtain ⟨x₀, hx₀⟩ := hQI_γ1_inj _ hx_d ⟨_, hγ1_mem⟩
      refine ⟨join2 (x₀, (split2 (split2 w₁).1).2), ?_⟩
      have hw₁_eq : w₁ = join2 (join2 ((split2 (split2 w₁).1).1, (split2 (split2 w₁).1).2), 0) := by
        calc w₁
            = join2 (split2 w₁) := (hjoin_split w₁).symm
          _ = join2 ((split2 w₁).1, (split2 w₁).2) := rfl
          _ = join2 (join2 (split2 (split2 w₁).1), 0) := by
              rw [hjoin_split (split2 w₁).1, hu1]
          _ = join2 (join2 ((split2 (split2 w₁).1).1, (split2 (split2 w₁).1).2), 0) := rfl
      rw [hd₀_bar_eq, hsplit_join, hx₀]
      exact hw₁_eq.symm
    · 
      intro y hy
      obtain ⟨x₁, hx_d, z, hxz⟩ := hQI_γ1_surj y hy
      refine ⟨join2 (join2 (x₁, 0), 0), ?_, z, ?_⟩
      · rw [hd₁_bar_eq, hsplit_join, hsplit_join, hx_d]
        exact map_zero join2
      · dsimp [γ_F₁]
        rw [hsplit_join, hsplit_join, map_zero, map_zero, map_zero, add_zero, add_zero]
        exact hxz
    · 
      intro w₂ hmem
      rcases hmem with ⟨z, hz⟩
      dsimp [γ_F₂] at hz
      have hγ2_mem : γ₂ (split2 w₂).1 = δI₁ (z - e₁ (split2 w₂).2) := by
        rw [map_sub, ← hz, add_sub_cancel_right]
      obtain ⟨x₁, hx₁⟩ := hQI_γ2_inj _ ⟨_, hγ2_mem⟩
      refine ⟨join2 (join2 (x₁, 0), (split2 w₂).2), ?_⟩
      rw [hd₁_bar_eq, hsplit_join, hsplit_join, hx₁]
      conv_rhs => rw [← hjoin_split w₂]
    · 
      intro y
      obtain ⟨x₂, z, hxz⟩ := hQI_γ2_surj y
      refine ⟨join2 (x₂, 0), z, ?_⟩
      dsimp [γ_F₂]
      rw [hsplit_join, map_zero, map_zero, add_zero]
      exact hxz

  exact ⟨F_K, M_K, hLatF, hFinHM, hFlatM, hBridge, hLatM⟩

theorem weil_curve_tr_godement_and_bockstein_models (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) (hN : 1 ≤ N)
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (𝒥₀ : ℕ → CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
      AddCommGrpCat.{u})
    (τ_𝒥 : ∀ m : ℕ, Quiver.Hom (𝒥₀ (m + 1)) (𝒥₀ m))
    (hZExt : WeilCurveZeroExtSystem.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat 𝒥₀ τ_𝒥)
    (M_c : ∀ i : ℕ, WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ i 𝒥₀ τ_𝒥)
    (r : ℕ) (hr : 1 ≤ r) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∃ (B L_fld : ℕ → Type u)
      (_ : ∀ m, CommRing (B m)) (_ : ∀ m, IsDomain (B m)) (_ : ∀ m, Field (L_fld m))
      (_ : ∀ m, Algebra F (B m)) (_ : ∀ m, Algebra (Polynomial F) (B m))
      (_ : ∀ m, Algebra R₀ (B m))
      (_ : ∀ m, Algebra F (L_fld m)) (_ : ∀ m, Algebra (Polynomial F) (L_fld m))
      (_ : ∀ m, Algebra (RatFunc F) (L_fld m))
      (_ : ∀ m, Algebra (B m) (L_fld m)) (_ : ∀ m, Algebra R₀ (L_fld m))
      (_ : ∀ m, IsScalarTower F (Polynomial F) (B m))
      (_ : ∀ m, IsScalarTower (Polynomial F) R₀ (B m))
      (_ : ∀ m, IsScalarTower F (RatFunc F) (L_fld m))
      (_ : ∀ m, IsScalarTower (Polynomial F) (RatFunc F) (L_fld m))
      (_ : ∀ m, IsScalarTower (Polynomial F) (B m) (L_fld m))
      (_ : ∀ m, IsScalarTower R₀ (B m) (L_fld m))
      (_ : ∀ m, Module.Finite R₀ (B m)) (_ : ∀ m, Algebra.Etale R₀ (B m))
      (_ : ∀ m, IsFractionRing (B m) (L_fld m)) (_ : ∀ m, IsIntegralClosure (B m) R₀ (L_fld m))
      (_ : ∀ m, FiniteDimensional (RatFunc F) (L_fld m)) (_ : ∀ m, IsGalois (RatFunc F) (L_fld m))
      (τ_rep : ∀ m : ℕ, (B m ≃ₐ[R₀] B m) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (m + 1))))ˣ)
      (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
      CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff ∧
      (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P) (m : ℕ),
        ∃ Q : Ideal (B m), Q.IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B m)) Q = Ideal.span {P} ∧
          ∃ σ_P : B m ≃ₐ[R₀] B m,
            (∀ b : B m, σ_P.symm b - b ^ (Nat.card F ^ d) ∈ Q) ∧
            (τ_rep m σ_P).val = (A_mat d P hP).map (PadicInt.toZModPow (m + 1))) ∧
      ∃ (B₁ : ℕ) (b_J : Fin 3 → ℕ)
        (M_lat_J : ∀ i : Fin 3, Matrix (Fin (b_J i)) (Fin (b_J i)) (PadicInt ℓ)),
        (∀ i : Fin 3,
          LinearMap.trace (Padic ℓ) (M_c i.1).V ((M_c i.1).frob ^ r) =
            algebraMap (PadicInt ℓ) (Padic ℓ) (Matrix.trace (M_lat_J i))) ∧
        ∀ s : ℕ,
          ∃ (𝒦_s : ℕ → CategoryTheory.Sheaf
              (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology AddCommGrpCat.{u})
            (τ_𝒦s : ∀ m : ℕ, Quiver.Hom (𝒦_s (m + 1)) (𝒦_s m))
            (B₂ : ℕ)
            (b_V : (B s ≃ₐ[R₀] B s) → Fin 3 → ℕ)
            (M_lat_V : ∀ (σ : B s ≃ₐ[R₀] B s) (i : Fin 3),
              Matrix (Fin (b_V σ i)) (Fin (b_V σ i)) (PadicInt ℓ)),
            WeilCurveTrGeomCoverZeroExt.{u} F S_aff U₀ ℓ (B s) e_U r 𝒦_s τ_𝒦s B₂ b_V M_lat_V ∧
            ∀ (K : ℕ) (hsK : s + 1 ≤ K),
              ∃ (F_K : WeilCurveTrFreeComplex (ℓ ^ K))
                (M_K : WeilCurveTrGroupComplex (B s ≃ₐ[R₀] B s) (ℓ ^ K)),
                WeilCurveTrHasBoundedLatticeModel ℓ K B₁ F_K b_J M_lat_J ∧
                (Finite ↥(LinearMap.ker M_K.δ₀) ∧
                  Finite (↥(LinearMap.ker M_K.δ₁) ⧸
                    (Submodule.comap (LinearMap.ker M_K.δ₁).subtype
                      (LinearMap.range M_K.δ₀)).toAddSubgroup) ∧
                  Finite (M_K.M₂ ⧸ (LinearMap.range M_K.δ₁).toAddSubgroup)) ∧
                (WeilCurveTrIsEqFlat (B s ≃ₐ[R₀] B s) (ℓ ^ K) M_K.M₀ ∧
                  WeilCurveTrIsEqFlat (B s ≃ₐ[R₀] B s) (ℓ ^ K) M_K.M₁ ∧
                  WeilCurveTrIsEqFlat (B s ≃ₐ[R₀] B s) (ℓ ^ K) M_K.M₂) ∧
                WeilCurveTrHasRepInvBridge ℓ N s K hsK (τ_rep s) F_K M_K ∧
                ∀ σ : B s ≃ₐ[R₀] B s,
                  WeilCurveTrHasGroupCohomLatticeModel ℓ K B₂ M_K σ (b_V σ) (M_lat_V σ) :=
by
  classical
  intro R₀
  have hB_up : ∀ {K_p b B₀ B : ℕ} {A : Type u} [AddCommGroup A]
      (M_mod : (Fin b → ZMod (ℓ ^ K_p)) → (Fin b → ZMod (ℓ ^ K_p)))
      (α_end : A →+ A)
      (q : (Fin b → ZMod (ℓ ^ K_p)) →+ A),
      B₀ ≤ B →
      ((∀ u, q (M_mod u) = α_end (q u)) ∧
       (∀ u, q u = 0 → (ℓ ^ B₀ : ℕ) • u = 0) ∧
       (∀ y : A, ∃ u, q u = (ℓ ^ B₀ : ℕ) • y)) →
      (∀ u, q (M_mod u) = α_end (q u)) ∧
      (∀ u, q u = 0 → (ℓ ^ B : ℕ) • u = 0) ∧
      (∀ y : A, ∃ u, q u = (ℓ ^ B : ℕ) • y) := by
    intro K_p b B₀ B A _ M_mod α_end q hle ⟨h1, h2, h3⟩
    have hB_eq : B₀ + (B - B₀) = B := Nat.add_sub_cancel' hle
    refine ⟨h1, fun u hu => ?_, fun y => ?_⟩
    · rw [← hB_eq, pow_add, mul_nsmul, h2 u hu, nsmul_zero]
    · obtain ⟨u₀, hu₀⟩ := h3 y
      refine ⟨(ℓ ^ (B - B₀) : ℕ) • u₀, ?_⟩
      rw [map_nsmul, hu₀, ← mul_nsmul, ← pow_add, hB_eq]
  have hLat_trans : ∀ {K_p B_p : ℕ}
      {C₀_g C₁_g C₂_g H₀_g H₁_g H₂_g : Type u}
      [AddCommGroup C₀_g] [AddCommGroup C₁_g] [AddCommGroup C₂_g]
      [AddCommGroup H₀_g] [AddCommGroup H₁_g] [AddCommGroup H₂_g]
      (d₀_g : C₀_g →+ C₁_g) (d₁_g : C₁_g →+ C₂_g)
      (ψ₀_g : C₀_g →+ C₀_g) (ψ₁_g : C₁_g →+ C₁_g) (ψ₂_g : C₂_g →+ C₂_g)
      (hd₀_ψ : d₀_g.comp ψ₀_g = ψ₁_g.comp d₀_g)
      (α₀_g : H₀_g →+ H₀_g) (α₁_g : H₁_g →+ H₁_g) (α₂_g : H₂_g →+ H₂_g)
      (e₀ : ↥d₀_g.ker ≃+ H₀_g)
      (e₁ : (↥d₁_g.ker ⧸ AddSubgroup.comap d₁_g.ker.subtype d₀_g.range) ≃+ H₁_g)
      (e₂ : (C₂_g ⧸ d₁_g.range) ≃+ H₂_g)
      (he₀ : ∀ (z : ↥d₀_g.ker) (hz' : ψ₀_g z.1 ∈ d₀_g.ker),
        e₀ ⟨ψ₀_g z.1, hz'⟩ = α₀_g (e₀ z))
      (he₁ : ∀ (z : ↥d₁_g.ker) (hz' : ψ₁_g z.1 ∈ d₁_g.ker),
        e₁ (QuotientAddGroup.mk' _ ⟨ψ₁_g z.1, hz'⟩) = α₁_g (e₁ (QuotientAddGroup.mk' _ z)))
      (he₂ : ∀ (z : C₂_g),
        e₂ (QuotientAddGroup.mk' _ (ψ₂_g z)) = α₂_g (e₂ (QuotientAddGroup.mk' _ z)))
      (b_g : Fin 3 → ℕ)
      (M_lat_g : ∀ i : Fin 3, Matrix (Fin (b_g i)) (Fin (b_g i)) (PadicInt ℓ))
      (qH₀ : (Fin (b_g 0) → ZMod (ℓ ^ K_p)) →+ H₀_g)
      (qH₁ : (Fin (b_g 1) → ZMod (ℓ ^ K_p)) →+ H₁_g)
      (qH₂ : (Fin (b_g 2) → ZMod (ℓ ^ K_p)) →+ H₂_g),
      ((∀ u, qH₀ (((M_lat_g 0).map (PadicInt.toZModPow K_p)).mulVecLin u) = α₀_g (qH₀ u)) ∧
       (∀ u, qH₀ u = 0 → (ℓ ^ B_p : ℕ) • u = 0) ∧
       (∀ y : H₀_g, ∃ u, qH₀ u = (ℓ ^ B_p : ℕ) • y)) →
      ((∀ u, qH₁ (((M_lat_g 1).map (PadicInt.toZModPow K_p)).mulVecLin u) = α₁_g (qH₁ u)) ∧
       (∀ u, qH₁ u = 0 → (ℓ ^ B_p : ℕ) • u = 0) ∧
       (∀ y : H₁_g, ∃ u, qH₁ u = (ℓ ^ B_p : ℕ) • y)) →
      ((∀ u, qH₂ (((M_lat_g 2).map (PadicInt.toZModPow K_p)).mulVecLin u) = α₂_g (qH₂ u)) ∧
       (∀ u, qH₂ u = 0 → (ℓ ^ B_p : ℕ) • u = 0) ∧
       (∀ y : H₂_g, ∃ u, qH₂ u = (ℓ ^ B_p : ℕ) • y)) →
      let M₀ := ((M_lat_g 0).map (PadicInt.toZModPow K_p)).mulVecLin
      let M₁ := ((M_lat_g 1).map (PadicInt.toZModPow K_p)).mulVecLin
      let M₂ := ((M_lat_g 2).map (PadicInt.toZModPow K_p)).mulVecLin
      let B_C₁ := AddSubgroup.comap d₁_g.ker.subtype d₀_g.range
      (∃ q₀ : (Fin (b_g 0) → ZMod (ℓ ^ K_p)) →+ ↥d₀_g.ker,
        (∀ u, (q₀ (M₀ u)).1 = ψ₀_g (q₀ u).1) ∧
        (∀ u, q₀ u = 0 → (ℓ ^ B_p : ℕ) • u = 0) ∧
        (∀ y : ↥d₀_g.ker, ∃ u, q₀ u = (ℓ ^ B_p : ℕ) • y)) ∧
      (∃ q₁ : (Fin (b_g 1) → ZMod (ℓ ^ K_p)) →+ (↥d₁_g.ker ⧸ B_C₁),
        (∀ (u : Fin (b_g 1) → ZMod (ℓ ^ K_p)) (z : ↥d₁_g.ker) (hz' : ψ₁_g z.1 ∈ d₁_g.ker),
          QuotientAddGroup.mk' B_C₁ z = q₁ u →
          q₁ (M₁ u) = QuotientAddGroup.mk' B_C₁ ⟨ψ₁_g z.1, hz'⟩) ∧
        (∀ u, q₁ u = 0 → (ℓ ^ B_p : ℕ) • u = 0) ∧
        (∀ y : ↥d₁_g.ker ⧸ B_C₁, ∃ u, q₁ u = (ℓ ^ B_p : ℕ) • y)) ∧
      (∃ q₂ : (Fin (b_g 2) → ZMod (ℓ ^ K_p)) →+ (C₂_g ⧸ d₁_g.range),
        (∀ (u : Fin (b_g 2) → ZMod (ℓ ^ K_p)) (z : C₂_g),
          QuotientAddGroup.mk' d₁_g.range z = q₂ u →
          q₂ (M₂ u) = QuotientAddGroup.mk' d₁_g.range (ψ₂_g z)) ∧
        (∀ u, q₂ u = 0 → (ℓ ^ B_p : ℕ) • u = 0) ∧
        (∀ y : C₂_g ⧸ d₁_g.range, ∃ u, q₂ u = (ℓ ^ B_p : ℕ) • y)) := by
    intro K_p B_p C₀_g C₁_g C₂_g H₀_g H₁_g H₂_g _ _ _ _ _ _
      d₀_g d₁_g ψ₀_g ψ₁_g ψ₂_g hd₀_ψ α₀_g α₁_g α₂_g e₀ e₁ e₂ he₀ he₁ he₂
      b_g M_lat_g qH₀ qH₁ qH₂
      ⟨hqH₀_int, hqH₀_ker, hqH₀_cok⟩ ⟨hqH₁_int, hqH₁_ker, hqH₁_cok⟩ ⟨hqH₂_int, hqH₂_ker, hqH₂_cok⟩
