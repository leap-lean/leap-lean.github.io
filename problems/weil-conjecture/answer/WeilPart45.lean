        apply CategoryTheory.Limits.pullback.hom_ext
        · change (m_Y_inv ≫ m_Y_hom) ≫ fst_Y = 𝟙 Y_bar.left ≫ fst_Y
          rw [Category.assoc, hm_Y_bar_fst, ← Category.assoc, hm_Y_inv_fst, Category.assoc,
