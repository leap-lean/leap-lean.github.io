        obtain ⟨Q_P, hQ_P⟩ := hGoodFrob d P_poly hP
        obtain ⟨hMax, hComap, _, σ, hσ_frob, hσ_mat⟩ := hQ_P r
        exact ⟨Q_P r, hMax, hComap, σ, hσ_frob, hσ_mat⟩
      have hα_ne : ∀ α ∈ α_num, α ≠ 0 := by
        intro α hα
