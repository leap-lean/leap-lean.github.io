import WeilPart44
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_ab_sheaf_tower_bockstein_and_torsion_epi_exact (S : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (𝒥_bar : ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (τ_𝒥bar : ∀ m : ℕ, Quiver.Hom (𝒥_bar (m + 1)) (𝒥_bar m))
    (τ_J_sh_le : ∀ (a b : ℕ), a ≤ b → Quiver.Hom (𝒥_bar b) (𝒥_bar a))
    (ι_sh : ∀ a b : ℕ, Quiver.Hom (𝒥_bar a) (𝒥_bar (b + a + 1)))
    (hTor_sh : ∀ m : ℕ, (ℓ ^ (m + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar m) = 0)
    (hsh_refl : ∀ a : ℕ, τ_J_sh_le a a (le_refl a) = CategoryTheory.CategoryStruct.id (𝒥_bar a))
    (hsh_step : ∀ (a b : ℕ) (h : a ≤ b),
      τ_J_sh_le a (b + 1) (Nat.le_succ_of_le h) =
        CategoryTheory.CategoryStruct.comp (τ_𝒥bar b) (τ_J_sh_le a b h))
    (hSE_sh : ∀ a b : ℕ,
      ∃ h0 : CategoryTheory.CategoryStruct.comp (ι_sh a b)
          (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))) = 0,
        (CategoryTheory.ShortComplex.mk (ι_sh a b)
          (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))) h0).ShortExact)
    (hComp_sh : ∀ a b : ℕ,
      CategoryTheory.CategoryStruct.comp (ι_sh a b)
        (τ_J_sh_le a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b))) =
        (ℓ ^ (b + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar a))
    (hComm_sh : ∀ a b : ℕ,
      CategoryTheory.CategoryStruct.comp (τ_𝒥bar a) (ι_sh a b) =
        CategoryTheory.CategoryStruct.comp (ι_sh (a + 1) b) (τ_𝒥bar (b + a + 1))) :
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    ∃ (τ_J : ∀ q m : ℕ, (𝒥_bar (m + 1)).H q →+ (𝒥_bar m).H q)
      (τ_J_le : ∀ (q a b : ℕ), a ≤ b → (𝒥_bar b).H q →+ (𝒥_bar a).H q)
      (ι_J : ∀ q a b : ℕ, (𝒥_bar a).H q →+ (𝒥_bar (b + a + 1)).H q)
      (δ_J : ∀ q a b : ℕ, (𝒥_bar b).H q →+ (𝒥_bar a).H (q + 1)),
      (∀ m : ℕ, τ_J_sh_le m (m + 1) (Nat.le_succ m) = τ_𝒥bar m) ∧
      (∀ q m : ℕ, τ_J q m = (CategoryTheory.Abelian.Ext.mk₀ (τ_𝒥bar m)).postcomp Fℤ (Nat.add_zero q)) ∧
      (∀ q a : ℕ, τ_J_le q a a (le_refl a) = AddMonoidHom.id ((𝒥_bar a).H q)) ∧
      (∀ (q a b : ℕ) (h : a ≤ b),
        τ_J_le q a (b + 1) (Nat.le_succ_of_le h) = (τ_J_le q a b h).comp (τ_J q b)) ∧
      (∀ (q m : ℕ) (x : (𝒥_bar m).H q), (ℓ ^ (m + 1) : ℕ) • x = 0) ∧
      (∀ (q a b : ℕ) (x : (𝒥_bar (b + a + 1)).H q),
        τ_J_le q b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)) x = 0 ↔
          ∃ y : (𝒥_bar a).H q, ι_J q a b y = x) ∧
      (∀ (q a b : ℕ) (x : (𝒥_bar b).H q),
        δ_J q a b x = 0 ↔
          ∃ y : (𝒥_bar (b + a + 1)).H q,
            τ_J_le q b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)) y = x) ∧
      (∀ (q a b : ℕ) (y : (𝒥_bar a).H q),
        τ_J_le q a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b)) (ι_J q a b y) =
          (ℓ ^ (b + 1) : ℕ) • y) ∧
      (∀ (q a b : ℕ) (y : (𝒥_bar (a + 1)).H q),
        ι_J q a b (τ_J q a y) = τ_J q (b + a + 1) (ι_J q (a + 1) b y)) ∧
      (∀ (q a b : ℕ) (y : (𝒥_bar b).H q),
        τ_J (q + 1) a (δ_J q (a + 1) b y) = δ_J q a b y) ∧
      (∀ (K : ℕ), 1 ≤ K →
        ∀ (F_ex : CategoryTheory.Functor
            (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
            AddCommGrpCat.{u})
          [F_ex.Additive]
          [CategoryTheory.Limits.PreservesFiniteLimits F_ex],
          (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
            (π : Quiver.Hom ℱ₁ ℱ₂),
            (ℓ ^ K : ℕ) • CategoryTheory.CategoryStruct.id ℱ₁ = 0 →
            CategoryTheory.Epi π →
            Function.Surjective (F_ex.map π).hom) →
          (∀ (a : ℕ), a ≤ K →
            ∀ x : ↑(F_ex.obj (𝒥_bar (K - 1))),
              (ℓ ^ a : ℕ) • x = 0 →
              ∃ y : ↑(F_ex.obj (𝒥_bar (K - 1))), x = (ℓ ^ (K - a) : ℕ) • y) ∧
          (∀ (s : ℕ) (hsK : s + 1 ≤ K),
            let hs_le : s ≤ K - 1 := Nat.le_sub_one_of_lt hsK
            Function.Surjective (F_ex.map (τ_J_sh_le s (K - 1) hs_le)).hom ∧
            ∀ x : ↑(F_ex.obj (𝒥_bar (K - 1))),
              (F_ex.map (τ_J_sh_le s (K - 1) hs_le)).hom x = 0 ↔
                ∃ y : ↑(F_ex.obj (𝒥_bar (K - 1))), x = (ℓ ^ (s + 1) : ℕ) • y)) :=
by
  intro Fℤ
  let 𝒜 := CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let h0_sh : ∀ a b : ℕ,
      CategoryTheory.CategoryStruct.comp (ι_sh a b)
        (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))) = 0 :=
    fun a b => Classical.choose (hSE_sh a b)
  have hSE : ∀ a b : ℕ,
      (CategoryTheory.ShortComplex.mk (ι_sh a b)
        (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)))
        (h0_sh a b)).ShortExact :=
    fun a b => Classical.choose_spec (hSE_sh a b)

  have hτ_succ : ∀ m : ℕ, τ_J_sh_le m (m + 1) (Nat.le_succ m) = τ_𝒥bar m := by
    intro m
    have hstep := hsh_step m m (le_refl m)
    rw [hsh_refl m, CategoryTheory.Category.comp_id] at hstep
    exact hstep

  have hsh_trans : ∀ (a b c : ℕ) (hab : a ≤ b) (hbc : b ≤ c),
      τ_J_sh_le a c (hab.trans hbc) =
        CategoryTheory.CategoryStruct.comp (τ_J_sh_le b c hbc) (τ_J_sh_le a b hab) := by
    intro a b c hab hbc
    refine @Nat.leRec b
      (fun k hk => τ_J_sh_le a k (hab.trans hk) =
        CategoryTheory.CategoryStruct.comp (τ_J_sh_le b k hk) (τ_J_sh_le a b hab))
      ?_ ?_ c hbc
    · rw [hsh_refl b]
      exact (CategoryTheory.Category.id_comp _).symm
    · intro k hk ih
      have h1 := hsh_step a k (hab.trans hk)
      have h2 := hsh_step b k hk
      exact h1.trans ((congrArg (CategoryTheory.CategoryStruct.comp (τ_𝒥bar k)) ih).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (fun f => CategoryTheory.CategoryStruct.comp f (τ_J_sh_le a b hab)) h2.symm)))

  have hEpi_step : ∀ m : ℕ, CategoryTheory.Epi (τ_𝒥bar m) := by
    intro m
    have hepi : CategoryTheory.Epi
        (τ_J_sh_le m (m + 0 + 1) (Nat.le_succ_of_le (Nat.le_add_right m 0))) :=
      (hSE 0 m).epi_g
    have heq : τ_J_sh_le m (m + 0 + 1) (Nat.le_succ_of_le (Nat.le_add_right m 0)) = τ_𝒥bar m :=
      hτ_succ m
    rwa [heq] at hepi

  have hEpi_le : ∀ (a b : ℕ) (hab : a ≤ b), CategoryTheory.Epi (τ_J_sh_le a b hab) := by
    intro a b hab
    refine @Nat.leRec a (fun k hk => CategoryTheory.Epi (τ_J_sh_le a k hk)) ?_ ?_ b hab
    · rw [hsh_refl a]
      infer_instance
    · intro k hk ih
      rw [hsh_step a k hk]
      have : CategoryTheory.Epi (τ_𝒥bar k) := hEpi_step k
      exact CategoryTheory.epi_comp (τ_𝒥bar k) (τ_J_sh_le a k hk)

  have hShift_comm : ∀ (c a b : ℕ),
      CategoryTheory.CategoryStruct.comp
        (τ_J_sh_le a (a + c) (Nat.le_add_right a c)) (ι_sh a b) =
      CategoryTheory.CategoryStruct.comp
        (ι_sh (a + c) b)
        (τ_J_sh_le (b + a + 1) (b + (a + c) + 1)
          (Nat.add_le_add_right (Nat.add_le_add_left (Nat.le_add_right a c) b) 1)) := by
    intro c
    induction c with
    | zero =>
      intro a b
      change CategoryTheory.CategoryStruct.comp (τ_J_sh_le a a (le_refl a)) (ι_sh a b) =
        CategoryTheory.CategoryStruct.comp (ι_sh a b)
          (τ_J_sh_le (b + a + 1) (b + a + 1) (le_refl (b + a + 1)))
      rw [hsh_refl a, hsh_refl (b + a + 1), CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
    | succ c ih =>
      intro a b
      have hL : τ_J_sh_le a (a + (c + 1)) (Nat.le_add_right a (c + 1)) =
          CategoryTheory.CategoryStruct.comp (τ_𝒥bar (a + c))
            (τ_J_sh_le a (a + c) (Nat.le_add_right a c)) :=
        hsh_step a (a + c) (Nat.le_add_right a c)
      have hR : τ_J_sh_le (b + a + 1) (b + (a + (c + 1)) + 1)
            (Nat.add_le_add_right (Nat.add_le_add_left (Nat.le_add_right a (c + 1)) b) 1) =
          CategoryTheory.CategoryStruct.comp (τ_𝒥bar (b + (a + c) + 1))
            (τ_J_sh_le (b + a + 1) (b + (a + c) + 1)
              (Nat.add_le_add_right (Nat.add_le_add_left (Nat.le_add_right a c) b) 1)) :=
        hsh_step (b + a + 1) (b + (a + c) + 1)
          (Nat.add_le_add_right (Nat.add_le_add_left (Nat.le_add_right a c) b) 1)
      rw [hL, hR, CategoryTheory.Category.assoc, ih a b, ← CategoryTheory.Category.assoc,
        hComm_sh (a + c) b, CategoryTheory.Category.assoc]
      rfl

  have hComp_eq : ∀ (u v b : ℕ) (huv : u = v) (hle : v ≤ b + u + 1),
      CategoryTheory.CategoryStruct.comp (ι_sh u b) (τ_J_sh_le v (b + u + 1) hle) =
        (ℓ ^ (b + 1) : ℕ) • τ_J_sh_le v u huv.symm.le := by
    intro u v b huv hle
    subst huv
    have h1 : τ_J_sh_le u (b + u + 1) hle =
        τ_J_sh_le u (b + u + 1) (Nat.le_succ_of_le (Nat.le_add_left u b)) := rfl
    have h2 : τ_J_sh_le u u (le_refl u) = CategoryTheory.CategoryStruct.id (𝒥_bar u) := hsh_refl u
    rw [h1, hComp_sh u b]
    congr 1
    exact h2.symm

  have hRevComp : ∀ a b : ℕ,
      CategoryTheory.CategoryStruct.comp
        (τ_J_sh_le a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b)))
        (ι_sh a b) =
      (ℓ ^ (b + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar (b + a + 1)) := by
    intro a b
    let u := a + (b + 1)
    let v := b + a + 1
    have huv : u = v := by omega
    have h_au : a ≤ u := Nat.le_add_right a (b + 1)
    have h_uv : u ≤ v := huv.le
    have h_vu : v ≤ u := huv.symm.le
    have htr1 : τ_J_sh_le a v (Nat.le_succ_of_le (Nat.le_add_left a b)) =
        CategoryTheory.CategoryStruct.comp (τ_J_sh_le u v h_uv) (τ_J_sh_le a u h_au) :=
      hsh_trans a u v h_au h_uv
    have htr2 : CategoryTheory.CategoryStruct.comp (τ_J_sh_le u v h_uv) (τ_J_sh_le v u h_vu) =
        CategoryTheory.CategoryStruct.id (𝒥_bar v) :=
      (hsh_trans v u v h_vu h_uv).symm.trans (hsh_refl v)
    rw [htr1, CategoryTheory.Category.assoc, hShift_comm (b + 1) a b,
      hComp_eq u v b huv _, CategoryTheory.Preadditive.comp_nsmul, htr2]

  let τ_J : ∀ q m : ℕ, (𝒥_bar (m + 1)).H q →+ (𝒥_bar m).H q :=
    fun q m => (CategoryTheory.Abelian.Ext.mk₀ (τ_𝒥bar m)).postcomp Fℤ (Nat.add_zero q)
  let τ_J_le : ∀ (q a b : ℕ), a ≤ b → (𝒥_bar b).H q →+ (𝒥_bar a).H q :=
    fun q a b h => (CategoryTheory.Abelian.Ext.mk₀ (τ_J_sh_le a b h)).postcomp Fℤ (Nat.add_zero q)
  let ι_J : ∀ q a b : ℕ, (𝒥_bar a).H q →+ (𝒥_bar (b + a + 1)).H q :=
    fun q a b => (CategoryTheory.Abelian.Ext.mk₀ (ι_sh a b)).postcomp Fℤ (Nat.add_zero q)
  let δ_J : ∀ q a b : ℕ, (𝒥_bar b).H q →+ (𝒥_bar a).H (q + 1) :=
    fun q a b => ((hSE a b).extClass).postcomp Fℤ (rfl : q + 1 = q + 1)

  have hPost_id : ∀ {X : 𝒜} {q : ℕ} (z : X.H q),
      ((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id X)).postcomp
        Fℤ (Nat.add_zero q)) z = z := by
    intro X q z
    exact CategoryTheory.Abelian.Ext.comp_mk₀_id z

  have hPost_zero : ∀ {X Y : 𝒜} {q : ℕ} (z : X.H q),
      ((CategoryTheory.Abelian.Ext.mk₀ (0 : Quiver.Hom X Y)).postcomp
        Fℤ (Nat.add_zero q)) z = 0 := by
    intro X Y q z
    change z.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : Quiver.Hom X Y)) (Nat.add_zero q) = 0
    rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hPost_comp : ∀ {X₁ X₂ X₃ : 𝒜} (f : Quiver.Hom X₁ X₂) (g : Quiver.Hom X₂ X₃)
      (q : ℕ) (z : X₁.H q),
      ((CategoryTheory.Abelian.Ext.mk₀ g).postcomp Fℤ (Nat.add_zero q))
        (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ (Nat.add_zero q)) z) =
      ((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp f g)).postcomp
        Fℤ (Nat.add_zero q)) z := by
    intro X₁ X₂ X₃ f g q z
    change (z.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q) =
      z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp f g))
        (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc z
          (CategoryTheory.Abelian.Ext.mk₀ f)
          (CategoryTheory.Abelian.Ext.mk₀ g)
          (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  have hPost_nsmul : ∀ (n : ℕ) {X Y : 𝒜} (f : Quiver.Hom X Y) (q : ℕ) (z : X.H q),
      ((CategoryTheory.Abelian.Ext.mk₀ (n • f)).postcomp Fℤ (Nat.add_zero q)) z =
        n • (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ (Nat.add_zero q)) z) := by
    intro n
    induction n with
    | zero =>
      intro X Y f q z
      rw [zero_smul, zero_smul]
      exact hPost_zero z
    | succ n ih =>
      intro X Y f q z
      change z.comp (CategoryTheory.Abelian.Ext.mk₀ ((n + 1) • f)) (Nat.add_zero q) =
        (n + 1) • (z.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q))
      rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add]
      congr 1
      exact ih f q z

  refine ⟨τ_J, τ_J_le, ι_J, δ_J, hτ_succ, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro q m
    rfl
  · intro q a
    apply AddMonoidHom.ext
    intro x
    dsimp [τ_J_le]
    rw [hsh_refl a]
    exact hPost_id x
  · intro q a b h
    apply AddMonoidHom.ext
    intro x
    simp only [AddMonoidHom.comp_apply, τ_J_le, τ_J]
    rw [hPost_comp, hsh_step a b h]
  · intro q m x
    calc (ℓ ^ (m + 1) : ℕ) • x
        = (ℓ ^ (m + 1) : ℕ) • (((CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.id (𝒥_bar m))).postcomp Fℤ (Nat.add_zero q)) x) := by
            rw [hPost_id x]
      _ = ((CategoryTheory.Abelian.Ext.mk₀
            ((ℓ ^ (m + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar m))).postcomp
            Fℤ (Nat.add_zero q)) x := (hPost_nsmul _ _ q x).symm
      _ = 0 := by rw [hTor_sh m]; exact hPost_zero x
  · intro q a b x
    constructor
    · intro hx
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ (hSE a b) x hx
    · rintro ⟨y, rfl⟩
      dsimp only [τ_J_le, ι_J]
      rw [hPost_comp, h0_sh a b]
      exact hPost_zero y
  · intro q a b x
    constructor
    · intro hx
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ (hSE a b) x rfl hx
    · rintro ⟨y, rfl⟩
      change (y.comp (CategoryTheory.Abelian.Ext.mk₀
          (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))))
          (Nat.add_zero q)).comp ((hSE a b).extClass) (rfl : q + 1 = q + 1) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc y
            (CategoryTheory.Abelian.Ext.mk₀
              (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))))
            ((hSE a b).extClass)
            (Nat.add_zero q) (Nat.zero_add 1) (rfl : q + 1 = q + 1),
          CategoryTheory.ShortComplex.ShortExact.comp_extClass (hSE a b),
          CategoryTheory.Abelian.Ext.comp_zero]
  · intro q a b y
    dsimp only [τ_J_le, ι_J]
    rw [hPost_comp, hComp_sh a b, hPost_nsmul, hPost_id]
  · intro q a b y
    dsimp only [τ_J, ι_J]
    rw [hPost_comp, hPost_comp, hComm_sh a b]
  · intro q a b y
    let SC_up := CategoryTheory.ShortComplex.mk (ι_sh (a + 1) b)
      (τ_J_sh_le b (b + (a + 1) + 1) (Nat.le_succ_of_le (Nat.le_add_right b (a + 1))))
      (h0_sh (a + 1) b)
    let SC_dn := CategoryTheory.ShortComplex.mk (ι_sh a b)
      (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)))
      (h0_sh a b)
    let φ_SC : Quiver.Hom SC_up SC_dn :=
      CategoryTheory.ShortComplex.Hom.mk (τ_𝒥bar a) (τ_𝒥bar (b + a + 1))
        (CategoryTheory.CategoryStruct.id (𝒥_bar b))
        (hComm_sh a b)
        ((hsh_step b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))).symm.trans
          (CategoryTheory.Category.comp_id _).symm)
    have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality
      (hSE (a + 1) b) (hSE a b) φ_SC
    have hid : (CategoryTheory.Abelian.Ext.mk₀ φ_SC.τ₃).comp ((hSE a b).extClass)
        (Nat.zero_add 1) = (hSE a b).extClass :=
      CategoryTheory.Abelian.Ext.mk₀_id_comp ((hSE a b).extClass)
    change (y.comp ((hSE (a + 1) b).extClass) (rfl : q + 1 = q + 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (τ_𝒥bar a)) (Nat.add_zero (q + 1)) =
      y.comp ((hSE a b).extClass) (rfl : q + 1 = q + 1)
    rw [CategoryTheory.Abelian.Ext.comp_assoc y ((hSE (a + 1) b).extClass)
          (CategoryTheory.Abelian.Ext.mk₀ (τ_𝒥bar a))
          (rfl : q + 1 = q + 1) (Nat.add_zero 1) (Nat.add_zero (q + 1))]
    change y.comp (((hSE (a + 1) b).extClass).comp
        (CategoryTheory.Abelian.Ext.mk₀ φ_SC.τ₁) (Nat.add_zero 1)) (rfl : q + 1 = q + 1) =
      y.comp ((hSE a b).extClass) (rfl : q + 1 = q + 1)
    rw [hnat, hid]
  · intro K hK F_ex hAdd hLim hSurj_ex
    let m := K - 1
    have hmK : m + 1 = K := Nat.sub_add_cancel hK
    have hTor_top : (ℓ ^ K : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar m) = 0 := by
      rw [← hmK]
      exact hTor_sh m
    have hTor_Fm : ∀ x : ↑(F_ex.obj (𝒥_bar m)), (ℓ ^ K : ℕ) • x = 0 := by
      intro x
      have h := congrArg (fun f => (F_ex.map f).hom x) hTor_top
      simpa only [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
        AddMonoidHom.zero_apply] using h
    have hSurj_Fm : ∀ (u : ℕ) (hum : u ≤ m),
        Function.Surjective (F_ex.map (τ_J_sh_le u m hum)).hom :=
      fun u hum => hSurj_ex (τ_J_sh_le u m hum) hTor_top (hEpi_le u m hum)
    have hFex_pair : ∀ (u v d : ℕ) (hd : v + u + 1 = d) (hvd : v ≤ d) (hud : u ≤ d),
        ∃ ι' : Quiver.Hom (𝒥_bar u) (𝒥_bar d),
          Function.Injective (F_ex.map ι').hom ∧
          (∀ x : ↑(F_ex.obj (𝒥_bar d)),
            (F_ex.map (τ_J_sh_le v d hvd)).hom x = 0 ↔
              ∃ z : ↑(F_ex.obj (𝒥_bar u)), (F_ex.map ι').hom z = x) ∧
          (∀ y : ↑(F_ex.obj (𝒥_bar d)),
            (F_ex.map ι').hom ((F_ex.map (τ_J_sh_le u d hud)).hom y) =
              (ℓ ^ (v + 1) : ℕ) • y) := by
      intro u v d hd hvd hud
      subst hd
      refine ⟨ι_sh u v, ?_, ?_, ?_⟩
      · have : CategoryTheory.Mono (ι_sh u v) := (hSE u v).mono_f
        exact (AddCommGrpCat.mono_iff_injective (F_ex.map (ι_sh u v))).mp
          (CategoryTheory.Functor.map_mono F_ex (ι_sh u v))
      · have hRangeKer : (F_ex.map (ι_sh u v)).hom.range =
            (F_ex.map (τ_J_sh_le v (v + u + 1) hvd)).hom.ker :=
          ((hSE u v).exact.map_of_mono_of_preservesKernel F_ex
            (hSE u v).mono_f inferInstance).ab_range_eq_ker
        intro x
        rw [← AddMonoidHom.mem_ker, ← hRangeKer, AddMonoidHom.mem_range]
      · intro y
        have hrev : CategoryTheory.CategoryStruct.comp
            (τ_J_sh_le u (v + u + 1) hud) (ι_sh u v) =
            (ℓ ^ (v + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar (v + u + 1)) :=
          hRevComp u v
        have h := congrArg (fun f => (F_ex.map f).hom y) hrev
        simpa only [CategoryTheory.Functor.map_comp, AddCommGrpCat.hom_comp,
          AddMonoidHom.comp_apply, CategoryTheory.Functor.map_nsmul,
          CategoryTheory.Functor.map_id, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
          AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply] using h
    refine ⟨?_, ?_⟩
    · intro a haK x hx
      rcases Nat.eq_zero_or_pos a with rfl | ha_pos
      · rw [pow_zero, one_smul] at hx
        exact ⟨0, by rw [hx, smul_zero]⟩
      · rcases eq_or_lt_of_le haK with rfl | ha_lt
        · exact ⟨x, by rw [Nat.sub_self, pow_zero, one_smul]⟩
        · let u := a - 1
          let v := K - a - 1
          have hu1 : u + 1 = a := by omega
          have hv1 : v + 1 = K - a := by omega
          have hvu : v + u + 1 = m := by omega
          have huv : u + v + 1 = m := by omega
          have hum : u ≤ m := by omega
          have hvm : v ≤ m := by omega
          obtain ⟨ι₂, hInj₂, _, hRev₂⟩ := hFex_pair v u m huv hum hvm
          have hτv_zero : (F_ex.map (τ_J_sh_le v m hvm)).hom x = 0 := by
            apply hInj₂
            rw [hRev₂ x, hu1, hx, map_zero]
          obtain ⟨ι₁, _, hKer₁, hRev₁⟩ := hFex_pair u v m hvu hvm hum
          obtain ⟨z, hz⟩ := (hKer₁ x).mp hτv_zero
          obtain ⟨y, rfl⟩ := hSurj_Fm u hum z
          exact ⟨y, by rw [← hz, hRev₁ y, hv1]⟩
    · intro s hsK
      let hs_le : s ≤ m := Nat.le_sub_one_of_lt hsK
      refine ⟨hSurj_Fm s hs_le, fun x => ?_⟩
      rcases eq_or_lt_of_le hsK with hs_eq | hs_lt
      · have hsm : s = m := by omega
        subst hsm
        have hid : (F_ex.map (τ_J_sh_le m m hs_le)).hom x = x := by
          have hr : τ_J_sh_le m m hs_le = CategoryTheory.CategoryStruct.id (𝒥_bar m) := hsh_refl m
          rw [hr, CategoryTheory.Functor.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
        rw [hid]
        constructor
        · intro hx0
          exact ⟨0, by rw [hx0, smul_zero]⟩
        · rintro ⟨y, rfl⟩
          rw [hs_eq]
          exact hTor_Fm y
      · let u := K - s - 2
        have hsu : s + u + 1 = m := by omega
        have hum : u ≤ m := by omega
        obtain ⟨ι₁, _, hKer₁, hRev₁⟩ := hFex_pair u s m hsu hs_le hum
        constructor
        · intro hx0
          obtain ⟨z, hz⟩ := (hKer₁ x).mp hx0
          obtain ⟨y, rfl⟩ := hSurj_Fm u hum z
          exact ⟨y, by rw [← hz, hRev₁ y]⟩
        · rintro ⟨y, rfl⟩
          rw [← hRev₁ y]
          exact (hKer₁ _).mpr ⟨(F_ex.map (τ_J_sh_le u m hum)).hom y, rfl⟩

theorem weil_curve_tr_geom_rep_sheaf_construction_and_bockstein_exact (F : Type u) [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)]
    (B L_fld : ℕ → Type u)
    [∀ m, CommRing (B m)] [∀ m, IsDomain (B m)] [∀ m, Field (L_fld m)]
    [∀ m, Algebra F (B m)] [∀ m, Algebra (Polynomial F) (B m)]
    [∀ m, Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B m)]
    [∀ m, Algebra F (L_fld m)] [∀ m, Algebra (Polynomial F) (L_fld m)]
    [∀ m, Algebra (RatFunc F) (L_fld m)]
    [∀ m, Algebra (B m) (L_fld m)]
    [∀ m, Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_fld m)]
    [∀ m, IsScalarTower F (Polynomial F) (B m)]
    [∀ m, IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B m)]
    [∀ m, IsScalarTower F (RatFunc F) (L_fld m)]
    [∀ m, IsScalarTower (Polynomial F) (RatFunc F) (L_fld m)]
    [∀ m, IsScalarTower (Polynomial F) (B m) (L_fld m)]
    [∀ m, IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B m) (L_fld m)]
    [∀ m, Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B m)]
    [∀ m, Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B m)]
    [∀ m, IsFractionRing (B m) (L_fld m)]
    [∀ m, IsIntegralClosure (B m)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_fld m)]
    [∀ m, FiniteDimensional (RatFunc F) (L_fld m)] [∀ m, IsGalois (RatFunc F) (L_fld m)]
    (τ_rep : ∀ m : ℕ,
      (B m ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B m) →*
        (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (m + 1))))ˣ)
    (ι_B : ∀ m : ℕ,
      B m →ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B (m + 1))
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU_eq : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F)
          (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (hCompat_B : ∀ m : ℕ, Function.Injective (ι_B m) ∧
      ∀ τ : B (m + 1) ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B (m + 1),
        ∃ σ : B m ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B m,
          (∀ b : B m, τ (ι_B m b) = ι_B m (σ b)) ∧
          ((τ_rep (m + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) _) =
            (τ_rep m σ).val) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let D_ov := weilProjectiveSpaceOver F 1
    let D_bar := weilGeomScheme F D_ov
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
    let pr_D : Quiver.Hom D_bar D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
    let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget D_bar
    ∃ (𝒥_bar : ℕ → CategoryTheory.Sheaf D_bar.smallEtaleTopology AddCommGrpCat.{u})
      (ι_bar_J : ∀ m : ℕ, Quiver.Hom (weilGeomScheme F (weilCurveTrGeomCoverOver F (B m))) D_bar)
      (triv_J : ∀ (m : ℕ) (W : D_bar.Etale),
        ↑((𝒥_bar m).obj.obj (Opposite.op W)) →+
          LocallyConstant
            ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m))
            (Fin N → ZMod (ℓ ^ (m + 1))))
      (τ_𝒥bar : ∀ m : ℕ, Quiver.Hom (𝒥_bar (m + 1)) (𝒥_bar m))
      (τ_J_sh_le : ∀ (a b : ℕ), a ≤ b → Quiver.Hom (𝒥_bar b) (𝒥_bar a))
      (ι_sh : ∀ a b : ℕ, Quiver.Hom (𝒥_bar a) (𝒥_bar (b + a + 1))),
      (∀ m : ℕ,
        let V_ov := weilCurveTrGeomCoverOver F (B m)
        let π_m := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m)))) e_U.hom
        let ι_m := CategoryTheory.CategoryStruct.comp π_m U₀.ι
        CategoryTheory.CategoryStruct.comp (ι_bar_J m) pr_D =
          CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst V_ov.hom f₂) ι_m ∧
        CategoryTheory.CategoryStruct.comp (ι_bar_J m)
          (CategoryTheory.Limits.pullback.snd D_ov.hom f₂) =
          CategoryTheory.Limits.pullback.snd V_ov.hom f₂ ∧
        CategoryTheory.IsPullback (ι_bar_J m)
          (CategoryTheory.Limits.pullback.fst V_ov.hom f₂) pr_D ι_m ∧
        (∀ σ : B m ≃ₐ[R₀] B m,
          CategoryTheory.CategoryStruct.comp (weilCurveTrGeomDeckHom F R₀ (B m) σ) (ι_bar_J m) =
            ι_bar_J m ∧
          CategoryTheory.CategoryStruct.comp (weilCurveTrGeomDeckHom F R₀ (B m) σ)
            (CategoryTheory.Limits.pullback.fst V_ov.hom f₂) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst V_ov.hom f₂)
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))) ∧
        (∀ {W₁ W₂ : D_bar.Etale} (u : Quiver.Hom W₁ W₂)
          (u_V : Quiver.Hom
            (CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_bar_J m))
            (CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_bar_J m))),
          CategoryTheory.CategoryStruct.comp u_V
            (CategoryTheory.Limits.pullback.fst (Fgt.obj W₂).hom (ι_bar_J m)) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_bar_J m)) (Fgt.map u).left →
          CategoryTheory.CategoryStruct.comp u_V
            (CategoryTheory.Limits.pullback.snd (Fgt.obj W₂).hom (ι_bar_J m)) =
            CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_bar_J m) →
          ∀ (sec : ↑((𝒥_bar m).obj.obj (Opposite.op W₂))) (y₁),
            triv_J m W₁ (((𝒥_bar m).obj.map (Opposite.op u)) sec) y₁ =
              triv_J m W₂ sec (u_V.base y₁)) ∧
        (∀ W : D_bar.Etale,
          Function.Injective (triv_J m W) ∧
          Set.range (triv_J m W) =
            { f |
              (∃ W₀ : (Fgt.obj W).left.Opens,
                ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U_bar) ⊔ W₀ = ⊤ ∧
                ∀ y, (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m)).base y ∈ W₀ →
                  f y = 0) ∧
              (∀ (σ : B m ≃ₐ[R₀] B m)
                (m_σ : Quiver.Hom
                  (CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m))
                  (CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m))),
                CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m)) =
                  CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom (ι_bar_J m) →
                CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J m)) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom (ι_bar_J m))
                    (weilCurveTrGeomDeckHom F R₀ (B m) σ) →
                ∀ y, f (m_σ.base y) = ((τ_rep m σ).val).mulVec (f y)) })) ∧
      (∀ (m : ℕ) (W : D_bar.Etale),
        let h_W := (Fgt.obj W).hom
        let V_m := weilCurveTrGeomCoverOver F (B m)
        let V_succ := weilCurveTrGeomCoverOver F (B (m + 1))
        let W_Vm := CategoryTheory.Limits.pullback h_W (ι_bar_J m)
        let W_Vsucc := CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1))
        (∀ y : ↥W_Vm,
          ∃ (m_ι_bar : Quiver.Hom W_Vsucc W_Vm) (y_up : ↥W_Vsucc),
            CategoryTheory.CategoryStruct.comp m_ι_bar
              (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m)) =
              CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) ∧
            CategoryTheory.CategoryStruct.comp m_ι_bar
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m))
                (CategoryTheory.Limits.pullback.fst V_m.hom f₂)) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)))
                  (CategoryTheory.Limits.pullback.fst V_succ.hom f₂))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom)) ∧
            m_ι_bar.base y_up = y) ∧
        (∀ (s_up : ↑((𝒥_bar (m + 1)).obj.obj (Opposite.op W)))
          (m_ι_bar : Quiver.Hom W_Vsucc W_Vm),
          CategoryTheory.CategoryStruct.comp m_ι_bar
            (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m)) =
            CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) →
          CategoryTheory.CategoryStruct.comp m_ι_bar
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m))
              (CategoryTheory.Limits.pullback.fst V_m.hom f₂)) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)))
                (CategoryTheory.Limits.pullback.fst V_succ.hom f₂))
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom)) →
          ∀ (y_up : ↥W_Vsucc) (i : Fin N),
            triv_J m W (((τ_𝒥bar m).hom.app (Opposite.op W)) s_up) (m_ι_bar.base y_up) i =
              ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
                (triv_J (m + 1) W s_up y_up i))) ∧
      (∀ m : ℕ, (ℓ ^ (m + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar m) = 0) ∧
      (∀ a : ℕ, τ_J_sh_le a a (le_refl a) = CategoryTheory.CategoryStruct.id (𝒥_bar a)) ∧
      (∀ (a b : ℕ) (h : a ≤ b),
        τ_J_sh_le a (b + 1) (Nat.le_succ_of_le h) =
          CategoryTheory.CategoryStruct.comp (τ_𝒥bar b) (τ_J_sh_le a b h)) ∧
      (∀ a b : ℕ,
        ∃ h0 : CategoryTheory.CategoryStruct.comp (ι_sh a b)
            (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))) = 0,
          (CategoryTheory.ShortComplex.mk (ι_sh a b)
            (τ_J_sh_le b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a))) h0).ShortExact) ∧
      (∀ a b : ℕ,
        CategoryTheory.CategoryStruct.comp (ι_sh a b)
          (τ_J_sh_le a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b))) =
          (ℓ ^ (b + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar a)) ∧
      (∀ a b : ℕ,
        CategoryTheory.CategoryStruct.comp (τ_𝒥bar a) (ι_sh a b) =
          CategoryTheory.CategoryStruct.comp (ι_sh (a + 1) b) (τ_𝒥bar (b + a + 1))) :=
by
  intro R₀ D_ov D_bar f₂ pr_D U_bar Fgt
  let snd_D : D_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) :=
    CategoryTheory.Limits.pullback.snd D_ov.hom f₂
  let V_ov := fun m : ℕ => weilCurveTrGeomCoverOver F (B m)
  let V_bar := fun m : ℕ => weilGeomScheme F (V_ov m)
  let fst_Vm : ∀ m : ℕ, V_bar m ⟶ (V_ov m).left :=
    fun m => CategoryTheory.Limits.pullback.fst (V_ov m).hom f₂
  let snd_Vm : ∀ m : ℕ, V_bar m ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) :=
    fun m => CategoryTheory.Limits.pullback.snd (V_ov m).hom f₂
  have hv_cond : ∀ m : ℕ, fst_Vm m ≫ (V_ov m).hom = snd_Vm m ≫ f₂ :=
    fun _ => CategoryTheory.Limits.pullback.condition
  have D_bar_ext : ∀ {X : AlgebraicGeometry.Scheme.{u}} {g₁ g₂ : X ⟶ D_bar},
      g₁ ≫ pr_D = g₂ ≫ pr_D → g₁ ≫ snd_D = g₂ ≫ snd_D → g₁ = g₂ :=
    fun h₁ h₂ => CategoryTheory.Limits.pullback.hom_ext h₁ h₂
  have V_bar_ext : ∀ {m : ℕ} {X : AlgebraicGeometry.Scheme.{u}} {g₁ g₂ : X ⟶ V_bar m},
      g₁ ≫ fst_Vm m = g₂ ≫ fst_Vm m → g₁ ≫ snd_Vm m = g₂ ≫ snd_Vm m → g₁ = g₂ :=
    fun h₁ h₂ => CategoryTheory.Limits.pullback.hom_ext h₁ h₂
  let π_m : ∀ m : ℕ, (V_ov m).left ⟶ U₀.toScheme := fun m =>
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) ≫ e_U.hom
  let ι_m : ∀ m : ℕ, (V_ov m).left ⟶ D_ov.left := fun m => π_m m ≫ U₀.ι
  let d_bar : ∀ (m : ℕ), (B m ≃ₐ[R₀] B m) → (V_bar m ⟶ V_bar m) :=
    fun m σ => weilCurveTrGeomDeckHom F R₀ (B m) σ
  let p_m : ∀ m : ℕ, (V_ov (m + 1)).left ⟶ (V_ov m).left :=
    fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom)
  let s_aut : ∀ m : ℕ, (B m ≃ₐ[R₀] B m) → ((V_ov m).left ⟶ (V_ov m).left) :=
    fun m σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)

  
  
  
  obtain ⟨hGalIdemp, hR₀_pkg, hRelGal⟩ := weil_etale_galois_domain_idempotents_and_aut_lift
  obtain ⟨hDom_R₀, instAlg_R₀_K, hFrac_R₀_K, hST_R₀_K⟩ := hR₀_pkg F S_aff
  have : IsDomain R₀ := hDom_R₀
  letI : Algebra R₀ (RatFunc F) := instAlg_R₀_K
  have : IsFractionRing R₀ (RatFunc F) := hFrac_R₀_K
  have hST_R₀_K_L : ∀ m : ℕ, IsScalarTower R₀ (RatFunc F) (L_fld m) :=
    fun m => hST_R₀_K (B m) (L_fld m)

  have hArith_m : ∀ m : ℕ,
      (AlgebraicGeometry.Etale (π_m m) ∧ AlgebraicGeometry.Surjective (π_m m)) ∧
      (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ (V_ov m).left),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π_m m) (π_m m)
        ∃ δ : (B m ≃ₐ[R₀] B m) → (Y ⟶ Y_V),
          (∀ σ : B m ≃ₐ[R₀] B m,
            δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_m m) (π_m m) = 𝟙 Y ∧
            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_m m) (π_m m) =
              g_Y ≫ s_aut m σ ∧
            AlgebraicGeometry.Etale (δ σ) ∧
            IsOpen (Set.range (δ σ).base)) ∧
          (∀ σ₁ σ₂ : B m ≃ₐ[R₀] B m, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
          (⋃ σ : B m ≃ₐ[R₀] B m, Set.range (δ σ).base) = Set.univ ∧
          (∀ (σ τ : B m ≃ₐ[R₀] B m) (m_τ : Y_V ⟶ Y_V),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_m m) (π_m m) =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π_m m) (π_m m) →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_m m) (π_m m) =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π_m m) (π_m m) ≫ s_aut m τ →
            δ σ ≫ m_τ = δ (τ * σ))) := by
    intro m
    obtain ⟨hInj_m, k_m, equiv_Γ, e_idemp, hIdemp, hOrth, hSum, hEval, hAbsorb⟩ :=
      hGalIdemp R₀ (B m) (RatFunc F) (L_fld m)
    have hTorsor := weil_scheme_galois_torsor_clopen_sheets R₀ (B m) hInj_m k_m equiv_Γ e_idemp
      hIdemp hOrth hSum hEval hAbsorb U₀.toScheme e_U
    exact ⟨hTorsor.1, hTorsor.2.2⟩

  have hAutLift_B : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m),
      ∃ τ : B (m + 1) ≃ₐ[R₀] B (m + 1),
        (∀ b : B m, τ (ι_B m b) = ι_B m (σ b)) ∧
        ((τ_rep (m + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) _) =
          (τ_rep m σ).val := by
    intro m σ
    have hRel := hRelGal R₀ (RatFunc F) (B m) (L_fld m) (B (m + 1)) (L_fld (m + 1))
      (ι_B m) (hCompat_B m).1
    obtain ⟨τ, hτ⟩ := hRel.1 σ
    obtain ⟨σ', hσ', hrep'⟩ := (hCompat_B m).2 τ
    have hσ_eq : σ' = σ := by
      ext b
      exact (hCompat_B m).1 ((hσ' b).symm.trans (hτ b))
    subst hσ_eq
    exact ⟨τ, hτ, hrep'⟩

  have hRel_arith : ∀ m : ℕ,
      AlgebraicGeometry.Etale (p_m m) ∧
      AlgebraicGeometry.Surjective (p_m m) ∧
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (h_Z : Z ⟶ (V_ov m).left)
        (z₁ z₂ : ↥(CategoryTheory.Limits.pullback h_Z (p_m m))),
        (CategoryTheory.Limits.pullback.fst h_Z (p_m m)).base z₁ =
          (CategoryTheory.Limits.pullback.fst h_Z (p_m m)).base z₂ →
        ∃ (τ : B (m + 1) ≃ₐ[R₀] B (m + 1))
          (m_rel : CategoryTheory.Limits.pullback h_Z (p_m m) ⟶
            CategoryTheory.Limits.pullback h_Z (p_m m)),
          (∀ b : B m, τ (ι_B m b) = ι_B m b) ∧
          m_rel ≫ CategoryTheory.Limits.pullback.fst h_Z (p_m m) =
            CategoryTheory.Limits.pullback.fst h_Z (p_m m) ∧
          m_rel ≫ CategoryTheory.Limits.pullback.snd h_Z (p_m m) =
            CategoryTheory.Limits.pullback.snd h_Z (p_m m) ≫ s_aut (m + 1) τ ∧
          ((τ_rep (m + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))) = 1 ∧
          m_rel.base z₁ = z₂ := by
    intro m
    have hRel := hRelGal R₀ (RatFunc F) (B m) (L_fld m) (B (m + 1)) (L_fld (m + 1))
      (ι_B m) (hCompat_B m).1
    letI : Algebra (B m) (B (m + 1)) := (ι_B m).toRingHom.toAlgebra
    letI : Algebra (B m) (L_fld (m + 1)) :=
      ((algebraMap (B (m + 1)) (L_fld (m + 1))).comp (ι_B m).toRingHom).toAlgebra
    have hST_Bm : IsScalarTower R₀ (B m) (B (m + 1)) :=
      IsScalarTower.of_algebraMap_eq fun r => ((ι_B m).commutes r).symm
    obtain ⟨hST_BBL, hFin_BB, hEt_BB, hIntCl_BB, instL, hST_BLL, hFD_LL, hGal_LL⟩ := hRel.2
    letI : Algebra (L_fld m) (L_fld (m + 1)) := instL
    obtain ⟨hInj_rel, k_rel, equiv_rel, e_rel_idemp, hId_r, hOr_r, hSu_r, hEv_r, hAb_r⟩ :=
      hGalIdemp (B m) (B (m + 1)) (L_fld m) (L_fld (m + 1))
    have hTorsor_rel := weil_scheme_galois_torsor_clopen_sheets (B m) (B (m + 1)) hInj_rel
      k_rel equiv_rel e_rel_idemp hId_r hOr_r hSu_r hEv_r hAb_r
      ((V_ov m).left) (CategoryTheory.Iso.refl ((V_ov m).left))
    dsimp only at hTorsor_rel
    have hπ_rel_eq :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (B m) (B (m + 1)))) ≫
          (CategoryTheory.Iso.refl ((V_ov m).left)).hom = p_m m :=
      CategoryTheory.Category.comp_id _
    rw [hπ_rel_eq] at hTorsor_rel
    refine ⟨hTorsor_rel.1.1, hTorsor_rel.1.2, fun Z h_Z z₁ z₂ hz => ?_⟩
    obtain ⟨τ_rel, m_rel, hm_fst, hm_snd, hm_z⟩ := (hTorsor_rel.2.1 Z h_Z).2.2 z₁ z₂ hz
    let τ : B (m + 1) ≃ₐ[R₀] B (m + 1) := τ_rel.restrictScalars R₀
    have hτ_fix : ∀ b : B m, τ (ι_B m b) = ι_B m b := fun b => τ_rel.commutes b
    obtain ⟨σ, hσ_comm, hσ_rep⟩ := (hCompat_B m).2 τ
    have hσ1 : σ = 1 := by
      ext b
      exact (hCompat_B m).1 ((hσ_comm b).symm.trans (hτ_fix b))
    rw [hσ1, map_one, Units.val_one] at hσ_rep
    exact ⟨τ, m_rel, hτ_fix, hm_fst, hm_snd, hσ_rep, hm_z⟩

  
  
  
  have hι_hom : ∀ m : ℕ, ι_m m ≫ D_ov.hom = (V_ov m).hom := by
    intro m
    dsimp only [ι_m, π_m, V_ov, weilCurveTrGeomCoverOver, CategoryTheory.Over.mk_hom]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc e_U.hom U₀.ι D_ov.hom, heU_eq,
      CategoryTheory.Category.assoc, hj_hom,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    ext c
    change algebraMap R₀ (B m)
        (algebraMap (Polynomial F) R₀ (algebraMap F (Polynomial F) c)) =
      algebraMap F (B m) c
    rw [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B m),
      ← IsScalarTower.algebraMap_apply F (Polynomial F) (B m)]

  let ι_bar_J : ∀ m : ℕ, V_bar m ⟶ D_bar := fun m =>
    CategoryTheory.Limits.pullback.lift (fst_Vm m ≫ ι_m m) (snd_Vm m) (by
      change (fst_Vm m ≫ ι_m m) ≫ D_ov.hom = snd_Vm m ≫ f₂
      rw [CategoryTheory.Category.assoc, hι_hom m, hv_cond m])

  have hι_fst : ∀ m : ℕ, ι_bar_J m ≫ pr_D = fst_Vm m ≫ ι_m m :=
    fun m => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hι_snd : ∀ m : ℕ, ι_bar_J m ≫ snd_D = snd_Vm m :=
    fun m => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hPb_Vm : ∀ m : ℕ, CategoryTheory.IsPullback (ι_bar_J m) (fst_Vm m) pr_D (ι_m m) := by
    intro m
    refine (@CategoryTheory.IsPullback.of_bot _ _ _ _ _ _ _ _
      (fst_Vm m) pr_D f₂ (ι_bar_J m) (ι_m m) snd_D D_ov.hom ?_ (hι_fst m).symm
      (CategoryTheory.IsPullback.of_hasPullback D_ov.hom f₂)).flip
    rw [hι_snd m, hι_hom m]
    exact CategoryTheory.IsPullback.of_hasPullback (V_ov m).hom f₂

  have hEt_ι_m : ∀ m : ℕ, AlgebraicGeometry.Etale (ι_m m) := fun m => by
    have : AlgebraicGeometry.Etale (π_m m) := (hArith_m m).1.1
    exact inferInstance

  have hEt_ι_bar : ∀ m : ℕ, AlgebraicGeometry.Etale (ι_bar_J m) := fun m =>
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb_Vm m).flip (hEt_ι_m m)

  have hRange_ι_bar : ∀ m : ℕ, Set.range (ι_bar_J m).base ⊆ (U_bar : Set D_bar) := by
    intro m z hz
    rcases hz with ⟨v, rfl⟩
    change pr_D.base ((ι_bar_J m).base v) ∈ (U₀ : Set D_ov.left)
    have hpt : pr_D.base ((ι_bar_J m).base v) =
        U₀.ι.base ((π_m m).base ((fst_Vm m).base v)) :=
      congrArg (fun k => k.base v) (hι_fst m)
    rw [hpt, ← AlgebraicGeometry.Scheme.Opens.range_ι]
    exact ⟨_, rfl⟩

  have hd_fst : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m),
      d_bar m σ ≫ fst_Vm m = fst_Vm m ≫ s_aut m σ :=
    fun m σ => CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hd_snd : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m), d_bar m σ ≫ snd_Vm m = snd_Vm m :=
    fun m σ => (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
      (CategoryTheory.Category.comp_id _)

  have hd_ι : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m), d_bar m σ ≫ ι_bar_J m = ι_bar_J m := by
    intro m σ
    apply D_bar_ext
    · rw [CategoryTheory.Category.assoc, hι_fst m, ← CategoryTheory.Category.assoc, hd_fst m]
      have hspec : s_aut m σ ≫ ι_m m = ι_m m := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) ≫ e_U.hom) ≫ U₀.ι =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) ≫ e_U.hom) ≫ U₀.ι
        rw [← CategoryTheory.Category.assoc
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)),
          ← AlgebraicGeometry.Spec.map_comp]
        congr 3
        ext r
        exact σ.symm.commutes r
      rw [CategoryTheory.Category.assoc, hspec]
    · rw [CategoryTheory.Category.assoc, hι_snd m, hd_snd m]

  have hd_one : ∀ m : ℕ, d_bar m 1 = 𝟙 (V_bar m) := by
    intro m
    apply V_bar_ext
    · have h1 : s_aut m 1 = 𝟙 (V_ov m).left := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (1 : B m ≃ₐ[R₀] B m).symm.toRingHom) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (B m)))
        rw [← AlgebraicGeometry.Spec.map_id]
        rfl
      rw [hd_fst, h1, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    · rw [hd_snd, CategoryTheory.Category.id_comp]

  have hd_mul : ∀ (m : ℕ) (σ τ : B m ≃ₐ[R₀] B m),
      d_bar m (σ * τ) = d_bar m τ ≫ d_bar m σ := by
    intro m σ τ
    apply V_bar_ext
    · have hmul : s_aut m (σ * τ) = s_aut m τ ≫ s_aut m σ := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ * τ).symm.toRingHom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
        rw [← AlgebraicGeometry.Spec.map_comp]
        rfl
      calc
        d_bar m (σ * τ) ≫ fst_Vm m
          = fst_Vm m ≫ (s_aut m τ ≫ s_aut m σ) := by rw [hd_fst, hmul]
        _ = (fst_Vm m ≫ s_aut m τ) ≫ s_aut m σ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (d_bar m τ ≫ fst_Vm m) ≫ s_aut m σ := by rw [hd_fst]
        _ = d_bar m τ ≫ (fst_Vm m ≫ s_aut m σ) := CategoryTheory.Category.assoc _ _ _
        _ = d_bar m τ ≫ (d_bar m σ ≫ fst_Vm m) := by rw [hd_fst]
        _ = (d_bar m τ ≫ d_bar m σ) ≫ fst_Vm m := (CategoryTheory.Category.assoc _ _ _).symm
    · rw [hd_snd, CategoryTheory.Category.assoc, hd_snd, hd_snd]

  have hLiftPt : ∀ (m : ℕ) (W_sch : AlgebraicGeometry.Scheme.{u}) (h_W : W_sch ⟶ D_bar) (x : ↥W_sch),
      h_W.base x ∈ U_bar →
      ∃ y : ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J m)),
        (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m)).base y = x := by
    intro m W_sch h_W x hx
    have hx_U₀ : pr_D.base (h_W.base x) ∈ Set.range U₀.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact hx
    obtain ⟨u_pt, hu_pt⟩ := hx_U₀
    obtain ⟨v_pt, hv_pt⟩ := ((hArith_m m).1.2).1 u_pt
    have hv_eq : pr_D (h_W.base x) = (ι_m m) v_pt := by
      change pr_D.base (h_W.base x) = U₀.ι.base ((π_m m).base v_pt)
      rw [hv_pt, hu_pt]
    obtain ⟨z_pb, hz_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (h_W.base x) v_pt hv_eq
    let e_pb := (hPb_Vm m).isoPullback
    let v_bar : ↥(V_bar m) := e_pb.inv.base z_pb
    have hv_bar : h_W x = (ι_bar_J m) v_bar := by
      have h1 : (e_pb.inv ≫ ι_bar_J m).base z_pb =
          (CategoryTheory.Limits.pullback.fst pr_D (ι_m m)).base z_pb :=
        congrArg (fun k => k.base z_pb) (hPb_Vm m).isoPullback_inv_fst
      exact hz_fst.symm.trans h1.symm
    obtain ⟨y, hy_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x v_bar hv_bar
    exact ⟨y, hy_fst⟩

  have hp_ι_arith : ∀ m : ℕ, p_m m ≫ ι_m m = ι_m (m + 1) := by
    intro m
    have hp_π : p_m m ≫ π_m m = π_m (m + 1) := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B m))) ≫ e_U.hom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (m + 1)))) ≫ e_U.hom
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      ext r
      exact (ι_B m).commutes r
    change p_m m ≫ (π_m m ≫ U₀.ι) = π_m (m + 1) ≫ U₀.ι
    rw [← CategoryTheory.Category.assoc, hp_π]

  have hp_hom : ∀ m : ℕ, p_m m ≫ (V_ov m).hom = (V_ov (m + 1)).hom := by
    intro m
    rw [← hι_hom m, ← CategoryTheory.Category.assoc, hp_ι_arith m, hι_hom (m + 1)]

  let p_bar : ∀ m : ℕ, V_bar (m + 1) ⟶ V_bar m := fun m =>
    CategoryTheory.Limits.pullback.lift (fst_Vm (m + 1) ≫ p_m m) (snd_Vm (m + 1)) (by
      change (fst_Vm (m + 1) ≫ p_m m) ≫ (V_ov m).hom = snd_Vm (m + 1) ≫ f₂
      rw [CategoryTheory.Category.assoc, hp_hom m, hv_cond (m + 1)])

  have hp_bar_fst : ∀ m : ℕ, p_bar m ≫ fst_Vm m = fst_Vm (m + 1) ≫ p_m m :=
    fun m => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hp_bar_snd : ∀ m : ℕ, p_bar m ≫ snd_Vm m = snd_Vm (m + 1) :=
    fun m => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hp_bar_ι : ∀ m : ℕ, p_bar m ≫ ι_bar_J m = ι_bar_J (m + 1) := by
    intro m
    apply D_bar_ext
    · rw [CategoryTheory.Category.assoc, hι_fst m, ← CategoryTheory.Category.assoc,
        hp_bar_fst m, CategoryTheory.Category.assoc, hp_ι_arith m, hι_fst (m + 1)]
    · rw [CategoryTheory.Category.assoc, hι_snd m, hp_bar_snd m, hι_snd (m + 1)]

  have hp_bar_deck : ∀ (m : ℕ) (σ : B m ≃ₐ[R₀] B m) (τ : B (m + 1) ≃ₐ[R₀] B (m + 1)),
      (∀ b : B m, τ (ι_B m b) = ι_B m (σ b)) →
      d_bar (m + 1) τ ≫ p_bar m = p_bar m ≫ d_bar m σ := by
    intro m σ τ hcomm
    apply V_bar_ext
    · have hs_p : s_aut (m + 1) τ ≫ p_m m = p_m m ≫ s_aut m σ := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B m).toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext b
        change τ.symm (ι_B m b) = ι_B m (σ.symm b)
        apply τ.injective
        rw [AlgEquiv.apply_symm_apply, hcomm (σ.symm b), AlgEquiv.apply_symm_apply]
      calc
        (d_bar (m + 1) τ ≫ p_bar m) ≫ fst_Vm m
          = d_bar (m + 1) τ ≫ (fst_Vm (m + 1) ≫ p_m m) := by
              rw [CategoryTheory.Category.assoc, hp_bar_fst m]
        _ = (d_bar (m + 1) τ ≫ fst_Vm (m + 1)) ≫ p_m m :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = fst_Vm (m + 1) ≫ (s_aut (m + 1) τ ≫ p_m m) := by
              rw [hd_fst, CategoryTheory.Category.assoc]
        _ = (fst_Vm (m + 1) ≫ p_m m) ≫ s_aut m σ := by
              rw [hs_p, ← CategoryTheory.Category.assoc]
        _ = p_bar m ≫ (fst_Vm m ≫ s_aut m σ) := by
              rw [← hp_bar_fst m, CategoryTheory.Category.assoc]
        _ = (p_bar m ≫ d_bar m σ) ≫ fst_Vm m := by
              rw [← hd_fst, ← CategoryTheory.Category.assoc]
    · rw [CategoryTheory.Category.assoc, hp_bar_snd m, hd_snd,
        CategoryTheory.Category.assoc, hd_snd, hp_bar_snd m]

  have hPb_p_bar : ∀ m : ℕ, CategoryTheory.IsPullback (p_bar m) (fst_Vm (m + 1)) (fst_Vm m) (p_m m) := by
    intro m
    refine (@CategoryTheory.IsPullback.of_bot _ _ _ _ _ _ _ _
      (fst_Vm (m + 1)) (fst_Vm m) f₂ (p_bar m) (p_m m) (snd_Vm m) (V_ov m).hom ?_
      (hp_bar_fst m).symm
      (CategoryTheory.IsPullback.of_hasPullback (V_ov m).hom f₂)).flip
    rw [hp_bar_snd m, hp_hom m]
    exact CategoryTheory.IsPullback.of_hasPullback (V_ov (m + 1)).hom f₂

  let m_can : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar),
      CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) ⟶
        CategoryTheory.Limits.pullback h_W (ι_bar_J m) := fun m {_} h_W =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)))
      (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ p_bar m)
      (by rw [CategoryTheory.Category.assoc, hp_bar_ι m, CategoryTheory.Limits.pullback.condition])

  have hm_can_fst : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar),
      m_can m h_W ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m) =
        CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) :=
    fun m {_} h_W => CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hm_can_snd : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar),
      m_can m h_W ≫ CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m) =
        CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ p_bar m :=
    fun m {_} h_W => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hm_can_snd_fst : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar),
      m_can m h_W ≫ (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m) ≫ fst_Vm m) =
        (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ fst_Vm (m + 1)) ≫ p_m m := by
    intro m W_sch h_W
    rw [← CategoryTheory.Category.assoc, hm_can_snd m h_W, CategoryTheory.Category.assoc,
      hp_bar_fst m, ← CategoryTheory.Category.assoc]

  have hm_can_uniq : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar)
      (m' : CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) ⟶
        CategoryTheory.Limits.pullback h_W (ι_bar_J m)),
      m' ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m) =
        CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) →
      m' ≫ (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m) ≫ fst_Vm m) =
        (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ fst_Vm (m + 1)) ≫ p_m m →
      m' = m_can m h_W := by
    intro m W_sch h_W m' hf hs
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact hf.trans (hm_can_fst m h_W).symm
    · apply V_bar_ext
      · rw [CategoryTheory.Category.assoc, hs, ← hm_can_snd_fst m h_W,
          ← CategoryTheory.Category.assoc]
      · have hsnd : ∀ k : CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) ⟶
            CategoryTheory.Limits.pullback h_W (ι_bar_J m),
            k ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m) =
              CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) →
            (k ≫ CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m)) ≫ snd_Vm m =
              CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ snd_Vm (m + 1) := by
          intro k hk
          calc
            (k ≫ CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m)) ≫ snd_Vm m
              = k ≫ (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m) ≫ ι_bar_J m) ≫ snd_D := by
                  rw [CategoryTheory.Category.assoc, ← hι_snd m, CategoryTheory.Category.assoc]
            _ = (k ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m)) ≫ h_W ≫ snd_D := by
                  rw [← CategoryTheory.Limits.pullback.condition]
                  simp only [CategoryTheory.Category.assoc]
            _ = (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) ≫ h_W) ≫ snd_D := by
                  rw [hk, ← CategoryTheory.Category.assoc]
            _ = CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ snd_Vm (m + 1) := by
                  rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
                    hι_snd (m + 1)]
        exact (hsnd m' hf).trans (hsnd (m_can m h_W) (hm_can_fst m h_W)).symm

  have hPb_m_can : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar),
      CategoryTheory.IsPullback (m_can m h_W)
        (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ fst_Vm (m + 1))
        (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m) ≫ fst_Vm m) (p_m m) := by
    intro m W_sch h_W
    have hPb_top : CategoryTheory.IsPullback (m_can m h_W)
        (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)))
        (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m)) (p_bar m) := by
      refine (CategoryTheory.IsPullback.of_bot ?_ (hm_can_snd m h_W).symm
        (CategoryTheory.IsPullback.of_hasPullback h_W (ι_bar_J m)).flip).flip
      rw [hm_can_fst m h_W, hp_bar_ι m]
      exact (CategoryTheory.IsPullback.of_hasPullback h_W (ι_bar_J (m + 1))).flip
    exact hPb_top.paste_vert (hPb_p_bar m)

  have hEt_m_can : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar),
      AlgebraicGeometry.Etale (m_can m h_W) :=
    fun m {_} h_W => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb_m_can m h_W).flip (hRel_arith m).1

  have hSurj_m_can : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar),
      AlgebraicGeometry.Surjective (m_can m h_W) :=
    fun m {_} h_W => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb_m_can m h_W).flip (hRel_arith m).2.1

  have hRelFib_geom : ∀ (m : ℕ) {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar)
      (y₁ y₂ : ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)))),
      (m_can m h_W).base y₁ = (m_can m h_W).base y₂ →
      ∃ (τ : B (m + 1) ≃ₐ[R₀] B (m + 1))
        (m_τ : CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) ⟶
          CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1))),
        m_τ ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) =
          CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) ∧
        m_τ ≫ CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) =
          CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ d_bar (m + 1) τ ∧
        ((τ_rep (m + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))) = 1 ∧
        m_τ.base y₁ = y₂ := by
    intro m W_sch h_W y₁ y₂ hy
    let h_Z := CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m) ≫ fst_Vm m
    let e_rel := (hPb_m_can m h_W).isoPullback
    have hz_eq : (CategoryTheory.Limits.pullback.fst h_Z (p_m m)).base (e_rel.hom.base y₁) =
        (CategoryTheory.Limits.pullback.fst h_Z (p_m m)).base (e_rel.hom.base y₂) := by
      have h1 : ∀ y, (CategoryTheory.Limits.pullback.fst h_Z (p_m m)).base (e_rel.hom.base y) =
          (m_can m h_W).base y :=
        fun y => congrArg (fun k => k.base y) (hPb_m_can m h_W).isoPullback_hom_fst
      rw [h1 y₁, h1 y₂, hy]
    obtain ⟨τ, m_rel, hτ_fix, hm_rel_fst, hm_rel_snd, hτ_rep1, hm_rel_z⟩ :=
      (hRel_arith m).2.2 _ h_Z (e_rel.hom.base y₁) (e_rel.hom.base y₂) hz_eq
    let m_τ : CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) ⟶
        CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)))
        (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ d_bar (m + 1) τ)
        (by rw [CategoryTheory.Category.assoc, hd_ι (m + 1) τ,
            CategoryTheory.Limits.pullback.condition])
    have hm_τ_fst : m_τ ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) =
        CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)) :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm_τ_snd : m_τ ≫ CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) =
        CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ d_bar (m + 1) τ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hd_p : d_bar (m + 1) τ ≫ p_bar m = p_bar m := by
      have h1 := hp_bar_deck m 1 τ hτ_fix
      rwa [hd_one m, CategoryTheory.Category.comp_id] at h1
    have hm_τ_can : m_τ ≫ m_can m h_W = m_can m h_W := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hm_can_fst, hm_τ_fst]
      · rw [CategoryTheory.Category.assoc, hm_can_snd, ← CategoryTheory.Category.assoc,
          hm_τ_snd, CategoryTheory.Category.assoc, hd_p]
    have hcomm_e : m_τ ≫ e_rel.hom = e_rel.hom ≫ m_rel := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, (hPb_m_can m h_W).isoPullback_hom_fst, hm_τ_can,
          CategoryTheory.Category.assoc, hm_rel_fst, (hPb_m_can m h_W).isoPullback_hom_fst]
      · calc
          (m_τ ≫ e_rel.hom) ≫ CategoryTheory.Limits.pullback.snd h_Z (p_m m)
            = m_τ ≫ CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ fst_Vm (m + 1) := by
                rw [CategoryTheory.Category.assoc, (hPb_m_can m h_W).isoPullback_hom_snd]
          _ = (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ fst_Vm (m + 1)) ≫
                s_aut (m + 1) τ := by
                rw [← CategoryTheory.Category.assoc, hm_τ_snd, CategoryTheory.Category.assoc,
                  hd_fst, ← CategoryTheory.Category.assoc]
          _ = (e_rel.hom ≫ CategoryTheory.Limits.pullback.snd h_Z (p_m m)) ≫ s_aut (m + 1) τ := by
                rw [(hPb_m_can m h_W).isoPullback_hom_snd]
          _ = (e_rel.hom ≫ m_rel) ≫ CategoryTheory.Limits.pullback.snd h_Z (p_m m) := by
                rw [CategoryTheory.Category.assoc, ← hm_rel_snd, ← CategoryTheory.Category.assoc]
    have hy_eq : m_τ.base y₁ = y₂ := by
      have h1 : e_rel.hom.base (m_τ.base y₁) = e_rel.hom.base y₂ :=
        (congrArg (fun k => k.base y₁) hcomm_e).trans hm_rel_z
      have h2 := congrArg e_rel.inv.base h1
      have hinv : ∀ y, e_rel.inv.base (e_rel.hom.base y) = y :=
        fun y => congrArg (fun k => k.base y) e_rel.hom_inv_id
      rwa [hinv, hinv] at h2
    exact ⟨τ, m_τ, hm_τ_fst, hm_τ_snd, hτ_rep1, hy_eq⟩

  have hSheets_geom : ∀ (m : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (h_Y : Y ⟶ D_bar)
      (g_Y : Y ⟶ V_bar m),
      g_Y ≫ ι_bar_J m = h_Y →
      let Y_V := CategoryTheory.Limits.pullback h_Y (ι_bar_J m)
      ∃ δ : (B m ≃ₐ[R₀] B m) → (Y ⟶ Y_V),
        (∀ σ : B m ≃ₐ[R₀] B m,
          δ σ ≫ CategoryTheory.Limits.pullback.fst h_Y (ι_bar_J m) = 𝟙 Y ∧
          δ σ ≫ CategoryTheory.Limits.pullback.snd h_Y (ι_bar_J m) = g_Y ≫ d_bar m σ ∧
          AlgebraicGeometry.Etale (δ σ) ∧
          IsOpen (Set.range (δ σ).base)) ∧
        (∀ σ₁ σ₂ : B m ≃ₐ[R₀] B m, σ₁ ≠ σ₂ →
          Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
        (⋃ σ : B m ≃ₐ[R₀] B m, Set.range (δ σ).base) = Set.univ ∧
        (∀ (σ τ : B m ≃ₐ[R₀] B m) (m_τ : Y_V ⟶ Y_V),
          m_τ ≫ CategoryTheory.Limits.pullback.fst h_Y (ι_bar_J m) =
            CategoryTheory.Limits.pullback.fst h_Y (ι_bar_J m) →
          m_τ ≫ CategoryTheory.Limits.pullback.snd h_Y (ι_bar_J m) =
            CategoryTheory.Limits.pullback.snd h_Y (ι_bar_J m) ≫ d_bar m τ →
          δ σ ≫ m_τ = δ (τ * σ)) := by
    intro m Y h_Y g_Y hg_Y Y_V
    let g₀ : Y ⟶ (V_ov m).left := g_Y ≫ fst_Vm m
    let Y_V₀ := CategoryTheory.Limits.pullback (g₀ ≫ π_m m) (π_m m)
    obtain ⟨δ₀, hδ₀_spec, hδ₀_disj, hδ₀_univ, hδ₀_act⟩ := (hArith_m m).2 Y g₀
    let p₁ := CategoryTheory.Limits.pullback.fst (g₀ ≫ π_m m) (π_m m)
    let p₂ := CategoryTheory.Limits.pullback.snd (g₀ ≫ π_m m) (π_m m)
    let q₂ : Y_V₀ ⟶ V_bar m :=
      CategoryTheory.Limits.pullback.lift p₂ (p₁ ≫ g_Y ≫ snd_Vm m) (by
        calc
          p₂ ≫ (V_ov m).hom
            = (p₂ ≫ π_m m) ≫ U₀.ι ≫ D_ov.hom := by
                rw [← hι_hom m]; simp only [ι_m, CategoryTheory.Category.assoc]
          _ = (p₁ ≫ (g₀ ≫ π_m m)) ≫ U₀.ι ≫ D_ov.hom := by
                rw [← CategoryTheory.Limits.pullback.condition]
          _ = p₁ ≫ g_Y ≫ fst_Vm m ≫ (ι_m m ≫ D_ov.hom) := by
                simp only [g₀, ι_m, CategoryTheory.Category.assoc]
          _ = p₁ ≫ g_Y ≫ (fst_Vm m ≫ (V_ov m).hom) := by rw [hι_hom m]
          _ = (p₁ ≫ g_Y ≫ snd_Vm m) ≫ f₂ := by
                rw [hv_cond m]; simp only [CategoryTheory.Category.assoc])
    have hq₂_fst : q₂ ≫ fst_Vm m = p₂ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hq₂_snd : q₂ ≫ snd_Vm m = p₁ ≫ g_Y ≫ snd_Vm m :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let φ_hom : Y_V₀ ⟶ Y_V :=
      CategoryTheory.Limits.pullback.lift p₁ q₂ (by
        rw [← hg_Y]
        apply D_bar_ext
        · have hcond : p₁ ≫ (g₀ ≫ π_m m) = p₂ ≫ π_m m :=
            CategoryTheory.Limits.pullback.condition
          calc
            (p₁ ≫ g_Y ≫ ι_bar_J m) ≫ pr_D
              = p₁ ≫ ((g_Y ≫ ι_bar_J m) ≫ pr_D) := CategoryTheory.Category.assoc _ _ _
            _ = p₁ ≫ ((g₀ ≫ π_m m) ≫ U₀.ι) := congrArg (p₁ ≫ ·) (by
                  rw [CategoryTheory.Category.assoc, hι_fst m]
                  simp only [g₀, ι_m, CategoryTheory.Category.assoc])
            _ = (p₁ ≫ (g₀ ≫ π_m m)) ≫ U₀.ι := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (p₂ ≫ π_m m) ≫ U₀.ι := congrArg (· ≫ U₀.ι) hcond
            _ = p₂ ≫ ι_m m := CategoryTheory.Category.assoc _ _ _
            _ = (q₂ ≫ fst_Vm m) ≫ ι_m m := congrArg (· ≫ ι_m m) hq₂_fst.symm
            _ = (q₂ ≫ ι_bar_J m) ≫ pr_D :=
                  (CategoryTheory.Category.assoc q₂ (fst_Vm m) (ι_m m)).trans
                    ((congrArg (q₂ ≫ ·) (hι_fst m).symm).trans
                      (CategoryTheory.Category.assoc q₂ (ι_bar_J m) pr_D).symm)
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hι_snd m,
            CategoryTheory.Category.assoc, hι_snd m, hq₂_snd])
    let r₁ := CategoryTheory.Limits.pullback.fst h_Y (ι_bar_J m)
    let r₂ := CategoryTheory.Limits.pullback.snd h_Y (ι_bar_J m)
    have hr_cond : r₁ ≫ (g₀ ≫ π_m m) = (r₂ ≫ fst_Vm m) ≫ π_m m := by
      apply (cancel_mono U₀.ι).mp
      calc
        (r₁ ≫ g₀ ≫ π_m m) ≫ U₀.ι
          = r₁ ≫ g_Y ≫ (fst_Vm m ≫ ι_m m) := by simp only [g₀, ι_m, CategoryTheory.Category.assoc]
        _ = r₁ ≫ (g_Y ≫ ι_bar_J m) ≫ pr_D := by
            rw [← hι_fst m, CategoryTheory.Category.assoc g_Y]
        _ = (r₁ ≫ h_Y) ≫ pr_D := by rw [hg_Y, CategoryTheory.Category.assoc]
        _ = (r₂ ≫ ι_bar_J m) ≫ pr_D := by rw [CategoryTheory.Limits.pullback.condition]
        _ = r₂ ≫ fst_Vm m ≫ ι_m m := by rw [CategoryTheory.Category.assoc, hι_fst m]
        _ = ((r₂ ≫ fst_Vm m) ≫ π_m m) ≫ U₀.ι := by simp only [ι_m, CategoryTheory.Category.assoc]
    let φ_inv : Y_V ⟶ Y_V₀ :=
      CategoryTheory.Limits.pullback.lift r₁ (r₂ ≫ fst_Vm m) hr_cond
    have hφ_hom_fst : φ_hom ≫ r₁ = p₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hφ_hom_snd : φ_hom ≫ r₂ = q₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hφ_inv_fst : φ_inv ≫ p₁ = r₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hφ_inv_snd : φ_inv ≫ p₂ = r₂ ≫ fst_Vm m :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hφ_hom_inv : φ_hom ≫ φ_inv = 𝟙 Y_V₀ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (φ_hom ≫ φ_inv) ≫ p₁ = 𝟙 Y_V₀ ≫ p₁
        rw [CategoryTheory.Category.assoc, hφ_inv_fst, hφ_hom_fst, CategoryTheory.Category.id_comp]
      · change (φ_hom ≫ φ_inv) ≫ p₂ = 𝟙 Y_V₀ ≫ p₂
        rw [CategoryTheory.Category.assoc, hφ_inv_snd, ← CategoryTheory.Category.assoc,
          hφ_hom_snd, hq₂_fst, CategoryTheory.Category.id_comp]
    have hφ_inv_hom : φ_inv ≫ φ_hom = 𝟙 Y_V := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (φ_inv ≫ φ_hom) ≫ r₁ = 𝟙 Y_V ≫ r₁
        rw [CategoryTheory.Category.assoc, hφ_hom_fst, hφ_inv_fst, CategoryTheory.Category.id_comp]
      · change (φ_inv ≫ φ_hom) ≫ r₂ = 𝟙 Y_V ≫ r₂
        rw [CategoryTheory.Category.assoc, hφ_hom_snd, CategoryTheory.Category.id_comp]
        apply V_bar_ext
        · rw [CategoryTheory.Category.assoc, hq₂_fst, hφ_inv_snd]
        · rw [CategoryTheory.Category.assoc, hq₂_snd,
            ← CategoryTheory.Category.assoc, hφ_inv_fst,
            ← hι_snd m, ← CategoryTheory.Category.assoc g_Y, hg_Y,
            ← CategoryTheory.Category.assoc r₁, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc, hι_snd m]
    let e_YV : Y_V₀ ≅ Y_V := ⟨φ_hom, φ_inv, hφ_hom_inv, hφ_inv_hom⟩
    have : CategoryTheory.IsIso φ_hom := CategoryTheory.Iso.isIso_hom e_YV
    have : AlgebraicGeometry.Etale φ_hom := inferInstance
    have : AlgebraicGeometry.Etale e_YV.hom := this
    have he_inj : Function.Injective e_YV.hom.base := fun a b hab => by
      have h := congrArg e_YV.inv.base hab
      have hinv : ∀ z, e_YV.inv.base (e_YV.hom.base z) = z :=
        fun z => congrArg (fun k => k.base z) e_YV.hom_inv_id
      rwa [hinv, hinv] at h
    have he_surj : Function.Surjective e_YV.hom.base := fun z =>
      ⟨e_YV.inv.base z, congrArg (fun k => k.base z) e_YV.inv_hom_id⟩
    let δ : (B m ≃ₐ[R₀] B m) → (Y ⟶ Y_V) := fun σ => δ₀ σ ≫ e_YV.hom
    refine ⟨δ, ?_, ?_, ?_, ?_⟩
    · intro σ
      obtain ⟨h1, h2, h3, h4⟩ := hδ₀_spec σ
      refine ⟨?_, ?_, ?_, ?_⟩
      · change (δ₀ σ ≫ φ_hom) ≫ r₁ = 𝟙 Y
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, h1]
      · change (δ₀ σ ≫ φ_hom) ≫ r₂ = g_Y ≫ d_bar m σ
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        apply V_bar_ext
        · calc
            (δ₀ σ ≫ q₂) ≫ fst_Vm m
              = δ₀ σ ≫ p₂ := by rw [CategoryTheory.Category.assoc, hq₂_fst]
            _ = g_Y ≫ (fst_Vm m ≫ s_aut m σ) := by
                rw [h2]; exact CategoryTheory.Category.assoc _ _ _
            _ = (g_Y ≫ d_bar m σ) ≫ fst_Vm m := by
                rw [← hd_fst, ← CategoryTheory.Category.assoc]
        · rw [CategoryTheory.Category.assoc, hq₂_snd,
            ← CategoryTheory.Category.assoc, h1, CategoryTheory.Category.id_comp,
            CategoryTheory.Category.assoc, hd_snd]
      · have : AlgebraicGeometry.Etale (δ₀ σ) := h3
        exact inferInstance
      · have hrange : Set.range (δ σ).base = e_YV.hom.base '' Set.range (δ₀ σ).base := by
          ext z
          simp only [Set.mem_range, Set.mem_image]
          constructor
          · rintro ⟨y, rfl⟩
            exact ⟨(δ₀ σ).base y, ⟨y, rfl⟩, rfl⟩
          · rintro ⟨w, ⟨y, rfl⟩, rfl⟩
            exact ⟨y, rfl⟩
        rw [hrange]
        exact (AlgebraicGeometry.Scheme.Hom.isOpenMap e_YV.hom) _ h4
    · intro σ₁ σ₂ hne
      rw [Set.disjoint_left]
      intro z ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩
      have h_eq : (δ₀ σ₁).base y₁ = (δ₀ σ₂).base y₂ := he_inj (hy₁.trans hy₂.symm)
      exact Set.disjoint_left.mp (hδ₀_disj σ₁ σ₂ hne) ⟨y₁, rfl⟩ ⟨y₂, h_eq.symm⟩
    · ext z
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      obtain ⟨z₀, rfl⟩ := he_surj z
      have hz₀ : z₀ ∈ ⋃ σ : B m ≃ₐ[R₀] B m, Set.range (δ₀ σ).base := by
        rw [hδ₀_univ]
        trivial
      obtain ⟨σ, y, rfl⟩ := Set.mem_iUnion.mp hz₀
      exact ⟨σ, y, rfl⟩
    · intro σ τ m_τ hm_fst hm_snd
      let m_τ₀ : Y_V₀ ⟶ Y_V₀ := e_YV.hom ≫ m_τ ≫ e_YV.inv
      have hm₀_fst : m_τ₀ ≫ p₁ = p₁ := by
        calc
          (φ_hom ≫ m_τ ≫ φ_inv) ≫ p₁
            = φ_hom ≫ m_τ ≫ (φ_inv ≫ p₁) := by simp only [CategoryTheory.Category.assoc]
          _ = φ_hom ≫ (m_τ ≫ r₁) := by rw [hφ_inv_fst]
          _ = p₁ := by rw [hm_fst, hφ_hom_fst]
      have hm₀_snd : m_τ₀ ≫ p₂ = p₂ ≫ s_aut m τ := by
        calc
          (φ_hom ≫ m_τ ≫ φ_inv) ≫ p₂
            = φ_hom ≫ m_τ ≫ (φ_inv ≫ p₂) := by simp only [CategoryTheory.Category.assoc]
          _ = φ_hom ≫ (m_τ ≫ r₂) ≫ fst_Vm m := by
              rw [hφ_inv_snd, CategoryTheory.Category.assoc m_τ]
          _ = φ_hom ≫ r₂ ≫ (d_bar m τ ≫ fst_Vm m) := by
              rw [hm_snd, CategoryTheory.Category.assoc r₂]
          _ = (φ_hom ≫ r₂) ≫ fst_Vm m ≫ s_aut m τ := by
              rw [hd_fst, ← CategoryTheory.Category.assoc φ_hom]
          _ = (q₂ ≫ fst_Vm m) ≫ s_aut m τ := by
              rw [hφ_hom_snd, ← CategoryTheory.Category.assoc q₂]
          _ = p₂ ≫ s_aut m τ := by rw [hq₂_fst]
      have hact₀ := hδ₀_act σ τ m_τ₀ hm₀_fst hm₀_snd
      dsimp only [δ, m_τ₀] at hact₀ ⊢
      calc
        (δ₀ σ ≫ e_YV.hom) ≫ m_τ
          = ((δ₀ σ ≫ e_YV.hom ≫ m_τ ≫ e_YV.inv) ≫ e_YV.hom) := by
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
              CategoryTheory.Category.comp_id]
        _ = δ₀ (τ * σ) ≫ e_YV.hom := by rw [hact₀]

  
  
  
  obtain ⟨hGlueSheaf, hLocShortExact⟩ :=
    weil_zero_ext_subsheaf_gluing_and_local_shortExact D_bar
  have hSheaf_pkg := fun m : ℕ =>
    hGlueSheaf U_bar (V_bar m) (ι_bar_J m) (B m ≃ₐ[R₀] B m) (d_bar m) (hd_ι m)
      (Fin N → ZMod (ℓ ^ (m + 1))) (fun σ => ((τ_rep m σ).val).mulVecLin.toAddMonoidHom)
  let 𝒥_bar : ℕ → CategoryTheory.Sheaf D_bar.smallEtaleTopology AddCommGrpCat.{u} :=
    fun m => Classical.choose (hSheaf_pkg m)
  let triv_J : ∀ (m : ℕ) (W : D_bar.Etale),
      ↑((𝒥_bar m).obj.obj (Opposite.op W)) →+
        LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m))
          (Fin N → ZMod (ℓ ^ (m + 1))) :=
    fun m => Classical.choose (Classical.choose_spec (hSheaf_pkg m))
  have htriv_spec := fun m : ℕ =>
    Classical.choose_spec (Classical.choose_spec (hSheaf_pkg m))

  have hSheafHomExt : ∀ {m₁ m₂ : ℕ} (φ₁ φ₂ : 𝒥_bar m₁ ⟶ 𝒥_bar m₂),
      (∀ (W : D_bar.Etale) (s : ↑((𝒥_bar m₁).obj.obj (Opposite.op W))) (y) (i : Fin N),
        triv_J m₂ W ((φ₁.hom.app (Opposite.op W)) s) y i =
          triv_J m₂ W ((φ₂.hom.app (Opposite.op W)) s) y i) →
      φ₁ = φ₂ := by
    intro m₁ m₂ φ₁ φ₂ h
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W_op
    rcases W_op with ⟨W⟩
    apply AddCommGrpCat.ext
    intro s
    apply ((htriv_spec m₂).2 W).1
    ext y i
    exact h W s y i

  let mkSheafHom : ∀ (m₁ m₂ : ℕ)
      (Φ : ∀ W : D_bar.Etale,
        LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m₁))
          (Fin N → ZMod (ℓ ^ (m₁ + 1))) →+
        LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m₂))
          (Fin N → ZMod (ℓ ^ (m₂ + 1))))
      (hRange : ∀ (W : D_bar.Etale) (s : ↑((𝒥_bar m₁).obj.obj (Opposite.op W))),
        Φ W (triv_J m₁ W s) ∈ Set.range (triv_J m₂ W))
      (hNat : ∀ {W₁ W₂ : D_bar.Etale} (u : W₁ ⟶ W₂)
        (s : ↑((𝒥_bar m₁).obj.obj (Opposite.op W₂)))
        (y₁ : ↥(CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_bar_J m₂))),
        let u_V₂ : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_bar_J m₂) ⟶
            CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_bar_J m₂) :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_bar_J m₂) ≫ (Fgt.map u).left)
            (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_bar_J m₂))
            (by rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w (Fgt.map u),
                CategoryTheory.Limits.pullback.condition])
        Φ W₁ (triv_J m₁ W₁ (((𝒥_bar m₁).obj.map (Opposite.op u)) s)) y₁ =
          Φ W₂ (triv_J m₁ W₂ s) (u_V₂.base y₁)),
      { φ : 𝒥_bar m₁ ⟶ 𝒥_bar m₂ //
        ∀ (W : D_bar.Etale) (s : ↑((𝒥_bar m₁).obj.obj (Opposite.op W))),
          triv_J m₂ W ((φ.hom.app (Opposite.op W)) s) = Φ W (triv_J m₁ W s) } := by
    intro m₁ m₂ Φ hRange hNat
    let app_fn : ∀ W : D_bar.Etale,
        ↑((𝒥_bar m₁).obj.obj (Opposite.op W)) → ↑((𝒥_bar m₂).obj.obj (Opposite.op W)) :=
      fun W s => Classical.choose (hRange W s)
    have happ_eq : ∀ (W : D_bar.Etale) (s),
        triv_J m₂ W (app_fn W s) = Φ W (triv_J m₁ W s) :=
      fun W s => Classical.choose_spec (hRange W s)
    let app_hom : ∀ W : D_bar.Etale,
        (𝒥_bar m₁).obj.obj (Opposite.op W) ⟶ (𝒥_bar m₂).obj.obj (Opposite.op W) :=
      fun W => AddCommGrpCat.ofHom (AddMonoidHom.mk' (app_fn W) (fun s₁ s₂ => by
        apply ((htriv_spec m₂).2 W).1
        rw [map_add, happ_eq, happ_eq, happ_eq, map_add, map_add]))
    let η : (𝒥_bar m₁).obj ⟶ (𝒥_bar m₂).obj :=
      { app := fun W_op => app_hom W_op.unop
        naturality := fun {W₂_op W₁_op} u_op => by
          rcases W₂_op with ⟨W₂⟩
          rcases W₁_op with ⟨W₁⟩
          rcases u_op with ⟨u⟩
          apply AddCommGrpCat.ext
          intro s
          apply ((htriv_spec m₂).2 W₁).1
          ext y₁ i
          let u_V₂ : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_bar_J m₂) ⟶
              CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_bar_J m₂) :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_bar_J m₂) ≫ (Fgt.map u).left)
              (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_bar_J m₂))
              (by rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w (Fgt.map u),
                  CategoryTheory.Limits.pullback.condition])
          change triv_J m₂ W₁ (app_fn W₁ (((𝒥_bar m₁).obj.map (Opposite.op u)) s)) y₁ i =
            triv_J m₂ W₁ (((𝒥_bar m₂).obj.map (Opposite.op u)) (app_fn W₂ s)) y₁ i
          have hR := (htriv_spec m₂).1 u u_V₂
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) (app_fn W₂ s) y₁
          rw [happ_eq, hNat u s y₁, hR, happ_eq] }
    exact ⟨CategoryTheory.ObjectProperty.homMk η, fun W s => happ_eq W s⟩

  have hNsmul_app : ∀ {m₁ m₂ : ℕ} (φ : 𝒥_bar m₁ ⟶ 𝒥_bar m₂) (n : ℕ) (W : D_bar.Etale)
      (s : ↑((𝒥_bar m₁).obj.obj (Opposite.op W))),
      (((n • φ).hom.app (Opposite.op W)) s) = n • ((φ.hom.app (Opposite.op W)) s) := by
    intro m₁ m₂ φ n W s
    have h1 : (n • φ).hom = n • φ.hom :=
      (CategoryTheory.sheafToPresheaf D_bar.smallEtaleTopology AddCommGrpCat.{u}).map_nsmul
    rw [h1]
    simp

  have hTor_sh : ∀ m : ℕ, (ℓ ^ (m + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒥_bar m) = 0 := by
    intro m
    apply hSheafHomExt
    intro W s y i
    rw [hNsmul_app, map_nsmul]
    have h0_hom : ((0 : 𝒥_bar m ⟶ 𝒥_bar m).hom) = 0 :=
      (CategoryTheory.sheafToPresheaf D_bar.smallEtaleTopology AddCommGrpCat.{u}).map_zero _ _
    rw [h0_hom]
    change (ℓ ^ (m + 1) : ℕ) • triv_J m W s y i = triv_J m W 0 y i
    rw [map_zero, LocallyConstant.coe_zero, Pi.zero_apply, Pi.zero_apply, nsmul_eq_mul,
      CharP.cast_eq_zero (ZMod (ℓ ^ (m + 1))) (ℓ ^ (m + 1)), zero_mul]

  
  have hPrime : Nat.Prime ℓ := Fact.out
  have hNeZero : ∀ k : ℕ, NeZero (ℓ ^ k) := fun k => ⟨pow_ne_zero k hPrime.ne_zero⟩
  have hPowEq : ∀ a b : ℕ, ℓ ^ (b + a + 1 + 1) = ℓ ^ (b + 1) * ℓ ^ (a + 1) := by
    intro a b
    rw [← pow_add]
    exact congrArg (ℓ ^ ·) (by omega)
  have hModEq : ∀ a b n : ℕ,
      ((ℓ ^ (b + 1) * (n % ℓ ^ (a + 1)) : ℕ) : ZMod (ℓ ^ (b + a + 1 + 1))) =
        ((ℓ ^ (b + 1) * n : ℕ) : ZMod (ℓ ^ (b + a + 1 + 1))) := by
    intro a b n
    have hdiv := Nat.div_add_mod n (ℓ ^ (a + 1))
    conv_rhs =>
      rw [← hdiv, Nat.mul_add, ← mul_assoc, ← hPowEq a b,
        Nat.cast_add, Nat.cast_mul, ZMod.natCast_self, zero_mul, zero_add]
  let emb : ∀ a b : ℕ, ZMod (ℓ ^ (a + 1)) →+ ZMod (ℓ ^ (b + a + 1 + 1)) := fun a b =>
    AddMonoidHom.mk' (fun w => ((ℓ ^ (b + 1) * w.val : ℕ) : ZMod (ℓ ^ (b + a + 1 + 1))))
      (fun w₁ w₂ => by
        rw [ZMod.val_add, hModEq a b (w₁.val + w₂.val), Nat.mul_add, Nat.cast_add])
  have hemb_apply : ∀ (a b : ℕ) (w : ZMod (ℓ ^ (a + 1))),
      emb a b w = ((ℓ ^ (b + 1) * w.val : ℕ) : ZMod (ℓ ^ (b + a + 1 + 1))) :=
    fun _ _ _ => rfl
  have hemb_inj : ∀ a b : ℕ, Function.Injective (emb a b) := by
    intro a b w₁ w₂ hw
    have hpos : 0 < ℓ ^ (b + 1) := pow_pos hPrime.pos (b + 1)
    have hlt₁ : ℓ ^ (b + 1) * w₁.val < ℓ ^ (b + a + 1 + 1) := by
      rw [hPowEq a b]
      exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt w₁) hpos
    have hlt₂ : ℓ ^ (b + 1) * w₂.val < ℓ ^ (b + a + 1 + 1) := by
      rw [hPowEq a b]
      exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt w₂) hpos
    rw [hemb_apply, hemb_apply] at hw
    have hval := congrArg ZMod.val hw
    rw [ZMod.val_natCast_of_lt hlt₁, ZMod.val_natCast_of_lt hlt₂] at hval
    exact ZMod.val_injective _ (Nat.mul_left_cancel hpos hval)
  have hemb_ker : ∀ (a b : ℕ) (h : ℓ ^ (b + 1) ∣ ℓ ^ (b + a + 1 + 1))
      (z : ZMod (ℓ ^ (b + a + 1 + 1))),
      ZMod.castHom h (ZMod (ℓ ^ (b + 1))) z = 0 ↔
        ∃ w : ZMod (ℓ ^ (a + 1)), emb a b w = z := by
    intro a b h z
    constructor
    · intro hz
      have hz0 : ((z.val : ℕ) : ZMod (ℓ ^ (b + 1))) = 0 := by
        conv at hz => lhs; rw [← ZMod.natCast_zmod_val z]
        rwa [map_natCast] at hz
      obtain ⟨q, hq⟩ := (ZMod.natCast_eq_zero_iff z.val (ℓ ^ (b + 1))).mp hz0
      have hpos : 0 < ℓ ^ (b + 1) := pow_pos hPrime.pos (b + 1)
      have hq_lt : q < ℓ ^ (a + 1) := by
        have hz_lt : z.val < ℓ ^ (b + 1) * ℓ ^ (a + 1) := hPowEq a b ▸ ZMod.val_lt z
        rw [hq] at hz_lt
        exact (Nat.mul_lt_mul_left hpos).mp hz_lt
      refine ⟨(q : ZMod (ℓ ^ (a + 1))), ?_⟩
      rw [hemb_apply, ZMod.val_natCast_of_lt hq_lt, ← hq, ZMod.natCast_zmod_val]
    · rintro ⟨w, rfl⟩
      rw [hemb_apply, map_natCast, Nat.cast_mul, ZMod.natCast_self, zero_mul]
  have hemb_comp : ∀ (a b : ℕ) (h : ℓ ^ (a + 1) ∣ ℓ ^ (b + a + 1 + 1))
      (w : ZMod (ℓ ^ (a + 1))),
      ZMod.castHom h (ZMod (ℓ ^ (a + 1))) (emb a b w) = (ℓ ^ (b + 1) : ℕ) • w := by
    intro a b h w
    rw [hemb_apply, map_natCast, Nat.cast_mul, ZMod.natCast_zmod_val, nsmul_eq_mul, Nat.cast_pow]
  have hemb_comm : ∀ (a b : ℕ) (ha : ℓ ^ (a + 1) ∣ ℓ ^ (a + 1 + 1))
      (hm : ℓ ^ (b + a + 1 + 1) ∣ ℓ ^ (b + (a + 1) + 1 + 1))
      (u : ZMod (ℓ ^ (a + 1 + 1))),
      emb a b (ZMod.castHom ha (ZMod (ℓ ^ (a + 1))) u) =
        ZMod.castHom hm (ZMod (ℓ ^ (b + a + 1 + 1))) (emb (a + 1) b u) := by
    intro a b ha hm u
    have hu_eq : ZMod.castHom ha (ZMod (ℓ ^ (a + 1))) u = (u.val : ZMod (ℓ ^ (a + 1))) := by
      conv_lhs => rw [← ZMod.natCast_zmod_val u]
      rw [map_natCast]
    rw [hemb_apply, hemb_apply, hu_eq, ZMod.val_natCast, hModEq a b u.val, map_natCast]
  have hemb_mulVec : ∀ (a b : ℕ) (h : ℓ ^ (a + 1) ∣ ℓ ^ (b + a + 1 + 1))
      (M_up : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (b + a + 1 + 1))))
      (M_dn : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (a + 1)))),
      M_up.map (ZMod.castHom h (ZMod (ℓ ^ (a + 1)))) = M_dn →
      ∀ v : Fin N → ZMod (ℓ ^ (a + 1)),
        M_up.mulVec (fun i => emb a b (v i)) =
          fun i => emb a b ((M_dn.mulVec v) i) := by
    intro a b h M_up M_dn hM v
    subst hM
    ext i
    simp only [Matrix.mulVec, dotProduct, map_sum, Matrix.map_apply]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hij : ZMod.castHom h (ZMod (ℓ ^ (a + 1))) (M_up i j) =
        ((M_up i j).val : ZMod (ℓ ^ (a + 1))) := by
      conv_lhs => rw [← ZMod.natCast_zmod_val (M_up i j)]
      rw [map_natCast]
    rw [hemb_apply, hemb_apply, hij, ZMod.val_mul, ZMod.val_natCast, Nat.mod_mul_mod,
      hModEq a b ((M_up i j).val * (v j).val), ← mul_assoc,
      mul_comm (ℓ ^ (b + 1)) (M_up i j).val, mul_assoc,
      Nat.cast_mul ((M_up i j).val), ZMod.natCast_zmod_val]

  
  
  
  have hLC_descent : ∀ {X Y : Type u} {α : Type} [TopologicalSpace X] [TopologicalSpace Y]
      (q : X → Y) (hq_surj : Function.Surjective q) (hq_open : IsOpenMap q)
      (g : LocallyConstant X α),
      (∀ x₁ x₂ : X, q x₁ = q x₂ → g x₁ = g x₂) →
      ∃ g_dn : LocallyConstant Y α, ∀ x : X, g_dn (q x) = g x := by
    intro X Y α _ _ q hq_surj hq_open g hconst
    let f_dn : Y → α := fun y => g (Classical.choose (hq_surj y))
    have hf_eq : ∀ x : X, f_dn (q x) = g x := fun x =>
      hconst _ x (Classical.choose_spec (hq_surj (q x)))
    have hf_lc : IsLocallyConstant f_dn := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro a
      have hpre : f_dn ⁻¹' {a} = q '' (g ⁻¹' {a}) := by
        ext y
        constructor
        · intro hy
          obtain ⟨x, rfl⟩ := hq_surj y
          refine ⟨x, ?_, rfl⟩
          simpa only [Set.mem_preimage, hf_eq x] using hy
        · rintro ⟨x, hx, rfl⟩
          simpa only [Set.mem_preimage, hf_eq x] using hx
      rw [hpre]
      exact hq_open _ (g.isLocallyConstant {a})
    exact ⟨⟨f_dn, hf_lc⟩, hf_eq⟩

  
  have hτ_bar_pkg : ∀ m : ℕ,
      ∃ φ : 𝒥_bar (m + 1) ⟶ 𝒥_bar m,
        ∀ (W : D_bar.Etale) (s_up : ↑((𝒥_bar (m + 1)).obj.obj (Opposite.op W)))
          (y_up : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J (m + 1)))) (i : Fin N),
          triv_J m W ((φ.hom.app (Opposite.op W)) s_up)
            ((m_can m (Fgt.obj W).hom).base y_up) i =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
              (triv_J (m + 1) W s_up y_up i) := by
    intro m
    let cast_m := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
    have hDesc_W : ∀ (W : D_bar.Etale) (s_up : ↑((𝒥_bar (m + 1)).obj.obj (Opposite.op W))),
        let h_W := (Fgt.obj W).hom
        ∃ f_dn : LocallyConstant ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J m))
            (Fin N → ZMod (ℓ ^ (m + 1))),
          f_dn ∈ Set.range (triv_J m W) ∧
          ∀ (y_up : ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)))) (i : Fin N),
            f_dn ((m_can m h_W).base y_up) i = cast_m (triv_J (m + 1) W s_up y_up i) := by
      intro W s_up h_W
      let f_up := triv_J (m + 1) W s_up
      let g_up : LocallyConstant ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)))
          (Fin N → ZMod (ℓ ^ (m + 1))) :=
        f_up.map (fun v i => cast_m (v i))
      have hf_up_mem : f_up ∈ Set.range (triv_J (m + 1) W) := ⟨s_up, rfl⟩
      rw [((htriv_spec (m + 1)).2 W).2] at hf_up_mem
      obtain ⟨⟨W₀, hW₀_top, hW₀_zero⟩, hf_up_eqv⟩ := hf_up_mem
      have hconst : ∀ y₁ y₂ : ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1))),
          (m_can m h_W).base y₁ = (m_can m h_W).base y₂ → g_up y₁ = g_up y₂ := by
        intro y₁ y₂ hy
        obtain ⟨τ, m_τ, hm_fst, hm_snd, hτ_rep1, hm_y⟩ := hRelFib_geom m h_W y₁ y₂ hy
        ext i
        change cast_m (f_up y₁ i) = cast_m (f_up y₂ i)
        rw [← hm_y, hf_up_eqv τ m_τ hm_fst hm_snd y₁]
        dsimp only [LinearMap.toAddMonoidHom_coe, Matrix.mulVecLin_apply]
        have hmap := RingHom.map_mulVec cast_m (τ_rep (m + 1) τ).val (f_up y₁) i
        rw [hmap, hτ_rep1, Matrix.one_mulVec]
        rfl
      have : AlgebraicGeometry.Etale (m_can m h_W) := hEt_m_can m h_W
      let q_fn : ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1))) →
          ↥(CategoryTheory.Limits.pullback h_W (ι_bar_J m)) :=
        (m_can m h_W).base
      have hq_surj : Function.Surjective q_fn := (hSurj_m_can m h_W).1
      have hq_open : IsOpenMap q_fn := AlgebraicGeometry.Scheme.Hom.isOpenMap (m_can m h_W)
      have hconst_q : ∀ y₁ y₂, q_fn y₁ = q_fn y₂ → g_up y₁ = g_up y₂ := hconst
      obtain ⟨f_dn, hf_dn_eq⟩ := hLC_descent q_fn hq_surj hq_open g_up hconst_q
      refine ⟨f_dn, ?_, fun y_up i => congrFun (hf_dn_eq y_up) i⟩
      rw [((htriv_spec m).2 W).2]
      refine ⟨⟨W₀, hW₀_top, ?_⟩, ?_⟩
      · intro y hy
        obtain ⟨y_up, rfl⟩ := (hSurj_m_can m h_W).1 y
        rw [hf_dn_eq y_up]
        have hy_up : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1))).base y_up ∈ W₀ := by
          have h1 : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1))).base y_up =
              (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m)).base
                ((m_can m h_W).base y_up) :=
            congrArg (fun k => k.base y_up) (hm_can_fst m h_W).symm
          rwa [h1]
        ext i
        change cast_m (f_up y_up i) = 0
        rw [hW₀_zero y_up hy_up, Pi.zero_apply, map_zero]
      · intro σ m_σ hm_σ_fst hm_σ_snd y
        obtain ⟨y_up, rfl⟩ := (hSurj_m_can m h_W).1 y
        obtain ⟨τ, hτ_comm, hτ_rep⟩ := hAutLift_B m σ
        let m_τ : CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) ⟶
            CategoryTheory.Limits.pullback h_W (ι_bar_J (m + 1)) :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J (m + 1)))
            (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J (m + 1)) ≫ d_bar (m + 1) τ)
            (by rw [CategoryTheory.Category.assoc, hd_ι (m + 1) τ,
                CategoryTheory.Limits.pullback.condition])
        have hsq : m_τ ≫ m_can m h_W = m_can m h_W ≫ m_σ := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hm_can_fst,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
              hm_σ_fst, hm_can_fst]
          · rw [CategoryTheory.Category.assoc, hm_can_snd,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc, hp_bar_deck m σ τ hτ_comm,
              CategoryTheory.Category.assoc, hm_σ_snd,
              ← CategoryTheory.Category.assoc (m_can m h_W), hm_can_snd,
              CategoryTheory.Category.assoc]
        have hbase : m_σ.base ((m_can m h_W).base y_up) = (m_can m h_W).base (m_τ.base y_up) :=
          congrArg (fun k => k.base y_up) hsq.symm
        rw [hbase, hf_dn_eq (m_τ.base y_up), hf_dn_eq y_up]
        ext i
        change cast_m (f_up (m_τ.base y_up) i) = (((τ_rep m σ).val).mulVec (g_up y_up)) i
        rw [hf_up_eqv τ m_τ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) y_up]
        dsimp only [LinearMap.toAddMonoidHom_coe, Matrix.mulVecLin_apply]
        have hmap := RingHom.map_mulVec cast_m (τ_rep (m + 1) τ).val (f_up y_up) i
        rw [hmap, hτ_rep]
        rfl
    let app_fn : ∀ W : D_bar.Etale,
        ↑((𝒥_bar (m + 1)).obj.obj (Opposite.op W)) → ↑((𝒥_bar m).obj.obj (Opposite.op W)) :=
      fun W s_up => Classical.choose (Classical.choose_spec (hDesc_W W s_up)).1
    have happ_spec : ∀ (W : D_bar.Etale) (s_up) (y_up) (i : Fin N),
        triv_J m W (app_fn W s_up) ((m_can m (Fgt.obj W).hom).base y_up) i =
          cast_m (triv_J (m + 1) W s_up y_up i) := by
      intro W s_up y_up i
      have h1 := Classical.choose_spec (Classical.choose_spec (hDesc_W W s_up)).1
      have h2 := (Classical.choose_spec (hDesc_W W s_up)).2 y_up i
      rwa [h1]
    let app_hom : ∀ W : D_bar.Etale,
        (𝒥_bar (m + 1)).obj.obj (Opposite.op W) ⟶ (𝒥_bar m).obj.obj (Opposite.op W) :=
      fun W => AddCommGrpCat.ofHom (AddMonoidHom.mk' (app_fn W) (fun s₁ s₂ => by
        apply ((htriv_spec m).2 W).1
        rw [map_add (triv_J m W)]
        ext y i
        obtain ⟨y_up, rfl⟩ := (hSurj_m_can m (Fgt.obj W).hom).1 y
        change triv_J m W (app_fn W (s₁ + s₂)) ((m_can m (Fgt.obj W).hom).base y_up) i =
          triv_J m W (app_fn W s₁) ((m_can m (Fgt.obj W).hom).base y_up) i +
            triv_J m W (app_fn W s₂) ((m_can m (Fgt.obj W).hom).base y_up) i
        rw [happ_spec, happ_spec, happ_spec, map_add (triv_J (m + 1) W)]
        change cast_m ((triv_J (m + 1) W s₁ y_up + triv_J (m + 1) W s₂ y_up) i) = _
        rw [Pi.add_apply, map_add]))
    let η : (𝒥_bar (m + 1)).obj ⟶ (𝒥_bar m).obj :=
      { app := fun W_op => app_hom W_op.unop
        naturality := fun {W₂_op W₁_op} u_op => by
          rcases W₂_op with ⟨W₂⟩
          rcases W₁_op with ⟨W₁⟩
          rcases u_op with ⟨u⟩
          apply AddCommGrpCat.ext
          intro s_up
          apply ((htriv_spec m).2 W₁).1
          ext y₁ i
          obtain ⟨y₁_up, rfl⟩ := (hSurj_m_can m (Fgt.obj W₁).hom).1 y₁
          let u_Vm : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_bar_J m) ⟶
              CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_bar_J m) :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_bar_J m) ≫ (Fgt.map u).left)
              (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_bar_J m))
              (by rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w (Fgt.map u),
                  CategoryTheory.Limits.pullback.condition])
          let u_Vsucc : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_bar_J (m + 1)) ⟶
              CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_bar_J (m + 1)) :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_bar_J (m + 1)) ≫
                (Fgt.map u).left)
              (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_bar_J (m + 1)))
              (by rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w (Fgt.map u),
                  CategoryTheory.Limits.pullback.condition])
          have hsq : m_can m (Fgt.obj W₁).hom ≫ u_Vm = u_Vsucc ≫ m_can m (Fgt.obj W₂).hom := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← CategoryTheory.Category.assoc, hm_can_fst,
                CategoryTheory.Category.assoc, hm_can_fst,
                CategoryTheory.Limits.pullback.lift_fst]
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                hm_can_snd, CategoryTheory.Category.assoc, hm_can_snd,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          have hbase : u_Vm.base ((m_can m (Fgt.obj W₁).hom).base y₁_up) =
              (m_can m (Fgt.obj W₂).hom).base (u_Vsucc.base y₁_up) :=
            congrArg (fun k => k.base y₁_up) hsq
          change triv_J m W₁ (app_fn W₁ (((𝒥_bar (m + 1)).obj.map (Opposite.op u)) s_up))
              ((m_can m (Fgt.obj W₁).hom).base y₁_up) i =
            triv_J m W₁ (((𝒥_bar m).obj.map (Opposite.op u)) (app_fn W₂ s_up))
              ((m_can m (Fgt.obj W₁).hom).base y₁_up) i
          have hR := (htriv_spec m).1 u u_Vm
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            (app_fn W₂ s_up) ((m_can m (Fgt.obj W₁).hom).base y₁_up)
          have hL := (htriv_spec (m + 1)).1 u u_Vsucc
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) s_up y₁_up
          rw [happ_spec, hL, hR, hbase, happ_spec] }
    exact ⟨CategoryTheory.ObjectProperty.homMk η, happ_spec⟩

  let τ_𝒥bar : ∀ m : ℕ, 𝒥_bar (m + 1) ⟶ 𝒥_bar m :=
    fun m => Classical.choose (hτ_bar_pkg m)
  have hτ_bar_spec : ∀ (m : ℕ) (W : D_bar.Etale)
      (s_up : ↑((𝒥_bar (m + 1)).obj.obj (Opposite.op W)))
      (y_up : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J (m + 1)))) (i : Fin N),
      triv_J m W (((τ_𝒥bar m).hom.app (Opposite.op W)) s_up)
        ((m_can m (Fgt.obj W).hom).base y_up) i =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
          (triv_J (m + 1) W s_up y_up i) :=
    fun m => Classical.choose_spec (hτ_bar_pkg m)

  
  let p_le : ∀ (a b : ℕ), a ≤ b → (V_bar b ⟶ V_bar a) := fun a b h =>
    @Nat.leRec a (fun c _ => V_bar c ⟶ V_bar a) (𝟙 (V_bar a))
      (fun c _ prev => p_bar c ≫ prev) b h

  have hp_le_refl : ∀ a : ℕ, p_le a a (le_refl a) = 𝟙 (V_bar a) :=
    fun a => Nat.leRec_self _ _

  have hp_le_step : ∀ (a b : ℕ) (h : a ≤ b),
      p_le a (b + 1) (Nat.le_succ_of_le h) = p_bar b ≫ p_le a b h :=
    fun _ _ h => Nat.leRec_succ _ _ h

  let τ_J_sh_le : ∀ (a b : ℕ), a ≤ b → (𝒥_bar b ⟶ 𝒥_bar a) := fun a b h =>
    @Nat.leRec a (fun c _ => 𝒥_bar c ⟶ 𝒥_bar a) (𝟙 (𝒥_bar a))
      (fun c _ prev => τ_𝒥bar c ≫ prev) b h

  have hsh_refl : ∀ a : ℕ, τ_J_sh_le a a (le_refl a) = 𝟙 (𝒥_bar a) :=
    fun a => Nat.leRec_self _ _

  have hsh_step : ∀ (a b : ℕ) (h : a ≤ b),
      τ_J_sh_le a (b + 1) (Nat.le_succ_of_le h) = τ_𝒥bar b ≫ τ_J_sh_le a b h :=
    fun _ _ h => Nat.leRec_succ _ _ h

  have hp_le_ι : ∀ (a b : ℕ) (h : a ≤ b), p_le a b h ≫ ι_bar_J a = ι_bar_J b := by
    intro a b h
    induction h with
    | refl => rw [hp_le_refl, CategoryTheory.Category.id_comp]
    | @step b h ih => rw [hp_le_step a b h, CategoryTheory.Category.assoc, ih, hp_bar_ι b]

  let m_le : ∀ {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar) (a b : ℕ) (h : a ≤ b),
      CategoryTheory.Limits.pullback h_W (ι_bar_J b) ⟶
        CategoryTheory.Limits.pullback h_W (ι_bar_J a) := fun {_} h_W a b h =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J b))
      (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J b) ≫ p_le a b h)
      (by rw [CategoryTheory.Category.assoc, hp_le_ι a b h,
          CategoryTheory.Limits.pullback.condition])

  have hm_le_refl : ∀ {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar) (a : ℕ),
      m_le h_W a a (le_refl a) = 𝟙 _ := by
    intro W_sch h_W a
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
    · rw [CategoryTheory.Limits.pullback.lift_snd, hp_le_refl,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]

  have hm_le_step : ∀ {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar)
      (a b : ℕ) (h : a ≤ b),
      m_le h_W a (b + 1) (Nat.le_succ_of_le h) = m_can b h_W ≫ m_le h_W a b h := by
    intro W_sch h_W a b h
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, hm_can_fst]
    · rw [CategoryTheory.Limits.pullback.lift_snd, hp_le_step a b h,
        CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc (m_can b h_W), hm_can_snd,
        CategoryTheory.Category.assoc]

  have hm_le_surj : ∀ {W_sch : AlgebraicGeometry.Scheme.{u}} (h_W : W_sch ⟶ D_bar)
      (a b : ℕ) (h : a ≤ b),
      Function.Surjective (m_le h_W a b h).base := by
    intro W_sch h_W a b h
    induction h with
    | refl =>
      rw [hm_le_refl]
      exact fun y => ⟨y, rfl⟩
    | @step b h ih =>
      rw [hm_le_step h_W a b h]
      exact ih.comp (hSurj_m_can b h_W).1

  have hAutRes_le : ∀ (a b : ℕ) (h : a ≤ b) (τ : B b ≃ₐ[R₀] B b),
      ∃ σ : B a ≃ₐ[R₀] B a,
        d_bar b τ ≫ p_le a b h = p_le a b h ≫ d_bar a σ ∧
        ((τ_rep b τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right h 1)) _) =
          (τ_rep a σ).val := by
    intro a b h
    induction h with
    | refl =>
      intro τ
      refine ⟨τ, ?_, ?_⟩
      · rw [hp_le_refl, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      · ext i j
        simp only [Matrix.map_apply, ZMod.castHom_self, RingHom.id_apply]
    | @step b h ih =>
      intro τ
      obtain ⟨τ_b, hτ_b_comm, hτ_b_rep⟩ := (hCompat_B b).2 τ
      obtain ⟨σ, hσ_deck, hσ_rep⟩ := ih τ_b
      refine ⟨σ, ?_, ?_⟩
      · rw [hp_le_step a b h, ← CategoryTheory.Category.assoc,
          hp_bar_deck b τ_b τ hτ_b_comm, CategoryTheory.Category.assoc, hσ_deck,
          CategoryTheory.Category.assoc]
      · ext i j
        have hcomp := ZMod.castHom_comp
          (pow_dvd_pow ℓ (Nat.add_le_add_right h 1))
          (pow_dvd_pow ℓ (Nat.le_succ (b + 1)))
        have h1 : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (b + 1))) (ZMod (ℓ ^ (b + 1)))
            (((τ_rep (b + 1) τ).val) i j) = ((τ_rep b τ_b).val) i j := by
          have := congrFun (congrFun hτ_b_rep i) j
          simpa only [Matrix.map_apply] using this
        have h2 : ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right h 1)) (ZMod (ℓ ^ (a + 1)))
            (((τ_rep b τ_b).val) i j) = ((τ_rep a σ).val) i j := by
          have := congrFun (congrFun hσ_rep i) j
          simpa only [Matrix.map_apply] using this
        simp only [Matrix.map_apply]
        rw [← h2, ← h1, ← RingHom.comp_apply, hcomp]

  have hτ_le_spec : ∀ (a b : ℕ) (h : a ≤ b) (W : D_bar.Etale)
      (s_b : ↑((𝒥_bar b).obj.obj (Opposite.op W)))
      (y_b : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J b))) (i : Fin N),
      triv_J a W (((τ_J_sh_le a b h).hom.app (Opposite.op W)) s_b)
        ((m_le (Fgt.obj W).hom a b h).base y_b) i =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right h 1)) (ZMod (ℓ ^ (a + 1)))
          (triv_J b W s_b y_b i) := by
    intro a b h
    induction h with
    | refl =>
      intro W s_b y_b i
      rw [hsh_refl, hm_le_refl, ZMod.castHom_self, RingHom.id_apply]
      rfl
    | @step b h ih =>
      intro W s_b y_b i
      rw [hsh_step a b h, hm_le_step (Fgt.obj W).hom a b h]
      change triv_J a W (((τ_J_sh_le a b h).hom.app (Opposite.op W))
          (((τ_𝒥bar b).hom.app (Opposite.op W)) s_b))
          ((m_le (Fgt.obj W).hom a b h).base ((m_can b (Fgt.obj W).hom).base y_b)) i = _
      rw [ih W (((τ_𝒥bar b).hom.app (Opposite.op W)) s_b)
          ((m_can b (Fgt.obj W).hom).base y_b) i,
        hτ_bar_spec b W s_b y_b i, ← RingHom.comp_apply, ZMod.castHom_comp]

  
  let hle_add : ∀ a b : ℕ, a ≤ b + a + 1 :=
    fun a b => Nat.le_succ_of_le (Nat.le_add_left a b)

  have hι_sh_pkg : ∀ a b : ℕ,
      { φ : 𝒥_bar a ⟶ 𝒥_bar (b + a + 1) //
        ∀ (W : D_bar.Etale) (s_a : ↑((𝒥_bar a).obj.obj (Opposite.op W)))
          (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J (b + a + 1)))) (i : Fin N),
          triv_J (b + a + 1) W ((φ.hom.app (Opposite.op W)) s_a) y i =
            emb a b (triv_J a W s_a
              ((m_le (Fgt.obj W).hom a (b + a + 1) (hle_add a b)).base y) i) } := by
    intro a b
    let m_top := b + a + 1
    let Φ : ∀ W : D_bar.Etale,
        LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J a))
          (Fin N → ZMod (ℓ ^ (a + 1))) →+
        LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_bar_J m_top))
          (Fin N → ZMod (ℓ ^ (m_top + 1))) := fun W =>
      AddMonoidHom.mk'
        (fun f => (f.comap (m_le (Fgt.obj W).hom a m_top (hle_add a b)).base.hom).map
          (fun v i => emb a b (v i)))
        (fun f₁ f₂ => by
          ext y i
          exact map_add (emb a b) _ _)
    have hRange_Φ : ∀ (W : D_bar.Etale) (s_a : ↑((𝒥_bar a).obj.obj (Opposite.op W))),
        Φ W (triv_J a W s_a) ∈ Set.range (triv_J m_top W) := by
      intro W s_a
      let h_W := (Fgt.obj W).hom
      have hf_mem : triv_J a W s_a ∈ Set.range (triv_J a W) := ⟨s_a, rfl⟩
      rw [((htriv_spec a).2 W).2] at hf_mem
      obtain ⟨⟨W₀, hW₀_top, hW₀_zero⟩, hf_eqv⟩ := hf_mem
      rw [((htriv_spec m_top).2 W).2]
      refine ⟨⟨W₀, hW₀_top, ?_⟩, ?_⟩
      · intro y hy
        have hy_a : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J a)).base
            ((m_le h_W a m_top (hle_add a b)).base y) ∈ W₀ := by
          have hlift_fst : m_le h_W a m_top (hle_add a b) ≫
              CategoryTheory.Limits.pullback.fst h_W (ι_bar_J a) =
              CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m_top) :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have h1 : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J a)).base
              ((m_le h_W a m_top (hle_add a b)).base y) =
              (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m_top)).base y :=
            congrArg (fun k => k.base y) hlift_fst
          rwa [h1]
        ext i
        change emb a b (triv_J a W s_a ((m_le h_W a m_top (hle_add a b)).base y) i) = 0
        rw [hW₀_zero _ hy_a, Pi.zero_apply, map_zero]
      · intro τ m_τ hm_fst hm_snd y
        obtain ⟨σ, hσ_deck, hσ_rep⟩ := hAutRes_le a m_top (hle_add a b) τ
        let m_σ : CategoryTheory.Limits.pullback h_W (ι_bar_J a) ⟶
            CategoryTheory.Limits.pullback h_W (ι_bar_J a) :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J a))
            (CategoryTheory.Limits.pullback.snd h_W (ι_bar_J a) ≫ d_bar a σ)
            (by rw [CategoryTheory.Category.assoc, hd_ι a σ,
                CategoryTheory.Limits.pullback.condition])
        have hsq : m_τ ≫ m_le h_W a m_top (hle_add a b) =
            m_le h_W a m_top (hle_add a b) ≫ m_σ := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hm_fst, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, hm_snd, CategoryTheory.Category.assoc, hσ_deck,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
