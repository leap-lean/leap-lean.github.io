      Finite (↥dJ₁.ker ⧸ AddSubgroup.comap dJ₁.ker.subtype dJ₀.range) ∧
      Finite (J₂ ⧸ dJ₁.range))
    (hLatJ :
      let MJ₀ := ((M_lat_J 0).map (PadicInt.toZModPow K)).mulVecLin
      let MJ₁ := ((M_lat_J 1).map (PadicInt.toZModPow K)).mulVecLin
      let MJ₂ := ((M_lat_J 2).map (PadicInt.toZModPow K)).mulVecLin
      let B_J₁ := AddSubgroup.comap dJ₁.ker.subtype dJ₀.range
      (∃ q₀ : (Fin (b_J 0) → ZMod (ℓ ^ K)) →+ ↥dJ₀.ker,
        (∀ u, (q₀ (MJ₀ u)).1 = ΦJ₀ (q₀ u).1) ∧
        (∀ u, q₀ u = 0 → (ℓ ^ B₁ : ℕ) • u = 0) ∧
        (∀ y : ↥dJ₀.ker, ∃ u, q₀ u = (ℓ ^ B₁ : ℕ) • y)) ∧
      (∃ q₁ : (Fin (b_J 1) → ZMod (ℓ ^ K)) →+ (↥dJ₁.ker ⧸ B_J₁),
