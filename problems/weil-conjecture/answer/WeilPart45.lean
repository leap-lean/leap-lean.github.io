        ((LinearMap.proj ι).comp E_comp.toLinearMap)
        (fun x => ⟨E_comp.symm (LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) ι x), by simp⟩)
    let W_ι : Fin m_c → Type u := fun ι => TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_ι ι)
    let to_P : TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_prod q) →ₗ[Padic ℓ]
        (∀ ι : Fin m_c, W_ι ι) :=
      LinearMap.pi fun ι =>
        LinearMap.baseChange (Padic ℓ) ((LinearMap.proj ι).comp E_comp.toLinearMap)
    let from_P : (∀ ι : Fin m_c, W_ι ι) →ₗ[Padic ℓ]
        TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_prod q) :=
      ∑ ι : Fin m_c,
        (LinearMap.baseChange (Padic ℓ)
          (E_comp.symm.toLinearMap.comp
            (LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) ι))).comp
          (LinearMap.proj ι)
    let E_tens : TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_prod q) ≃ₗ[Padic ℓ]
        (∀ ι : Fin m_c, W_ι ι) :=
      { toLinearMap := to_P
        invFun := from_P
        left_inv := fun z => by
          change from_P (to_P z) = z
          induction z using TensorProduct.induction_on with
          | zero => rw [map_zero, map_zero]
          | tmul k w =>
            dsimp [from_P, to_P]
            rw [LinearMap.sum_apply]
            simp only [LinearMap.comp_apply, LinearMap.proj_apply, LinearMap.pi_apply]
            have hterm : ∀ d : Fin m_c,
                (LinearMap.baseChange (Padic ℓ)
                  (E_comp.symm.toLinearMap.comp
                    (LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) d)))
                  ((LinearMap.baseChange (Padic ℓ) ((LinearMap.proj d).comp E_comp.toLinearMap))
                    (TensorProduct.tmul (PadicInt ℓ) k w)) =
                TensorProduct.tmul (PadicInt ℓ) k
                  (E_comp.symm
                    (LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) d (E_comp w d))) := by
              intro d
              rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp, LinearMap.baseChange_tmul]
              rfl
            have hsum_u :
                (∑ x : Fin m_c,
                  E_comp.symm (LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) x (E_comp w x))) =
                  w := by
              rw [← map_sum E_comp.symm]
              have hpi :
                  (∑ x : Fin m_c,
                    LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) x (E_comp w x)) = E_comp w := by
                funext j; simp [Pi.single_apply, eq_comm]
              rw [hpi, E_comp.symm_apply_apply]
            simp_rw [hterm, ← TensorProduct.tmul_sum, hsum_u]
          | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
        right_inv := fun f => by
          funext j
          change (to_P (from_P f)) j = f j
          dsimp [to_P, from_P]
          rw [LinearMap.sum_apply, map_sum]
          have hterm : ∀ ι : Fin m_c,
              (LinearMap.baseChange (Padic ℓ) ((LinearMap.proj j).comp E_comp.toLinearMap))
                ((LinearMap.baseChange (Padic ℓ)
                  (E_comp.symm.toLinearMap.comp
                    (LinearMap.single (PadicInt ℓ) (fun i => ↥(sys_ι i)) ι)))
                  (f ι)) = if ι = j then f j else 0 := by
            intro ι
            rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp]
            by_cases hιj : ι = j
            · subst hιj
              have hid : ((LinearMap.proj ι).comp E_comp.toLinearMap).comp
                  (E_comp.symm.toLinearMap.comp
                    (LinearMap.single (PadicInt ℓ) (fun i => ↥(sys_ι i)) ι)) =
                  LinearMap.id := by
                apply LinearMap.ext; intro x; simp
              rw [hid, LinearMap.baseChange_id, LinearMap.id_apply, if_pos rfl]
            · have h0 : ((LinearMap.proj j).comp E_comp.toLinearMap).comp
                  (E_comp.symm.toLinearMap.comp
                    (LinearMap.single (PadicInt ℓ) (fun i => ↥(sys_ι i)) ι)) = 0 := by
                apply LinearMap.ext; intro x
                simp [Pi.single_eq_of_ne (Ne.symm hιj)]
              have hb0 : LinearMap.baseChange (Padic ℓ)
                  (0 : ↥(sys_ι ι) →ₗ[PadicInt ℓ] ↥(sys_ι j)) (f ι) = 0 := by
                induction (f ι) using TensorProduct.induction_on with
                | zero => rw [map_zero]
                | tmul k x =>
                  rw [LinearMap.baseChange_tmul, LinearMap.zero_apply, TensorProduct.tmul_zero]
                | add z₁ z₂ ih₁ ih₂ => rw [map_add, ih₁, ih₂, add_zero]
              rw [h0, hb0, if_neg hιj]
          simp_rw [LinearMap.comp_apply, LinearMap.proj_apply, hterm]
          rw [Finset.sum_ite_eq', if_pos (Finset.mem_univ j)] }
    let T_all := E_tens.conj (LinearMap.baseChange (Padic ℓ) (Φ_prod q))
    have htr_eq1 : LinearMap.trace (Padic ℓ) _ (LinearMap.baseChange (Padic ℓ) (Φ_prod q)) =
        LinearMap.trace (Padic ℓ) (∀ ι : Fin m_c, W_ι ι) T_all :=
      (LinearMap.trace_conj' (LinearMap.baseChange (Padic ℓ) (Φ_prod q)) E_tens).symm
    have hT_decomp : T_all =
        ∑ ι : Fin m_c,
          (T_all.comp (LinearMap.single (Padic ℓ) W_ι ι)).comp (LinearMap.proj ι) := by
      apply LinearMap.ext; intro f; funext j
      rw [LinearMap.sum_apply, Finset.sum_apply]
      have hf : f = ∑ ι : Fin m_c, LinearMap.single (Padic ℓ) W_ι ι (f ι) := by
        funext i; simp [Pi.single_apply, eq_comm]
      conv_lhs => rw [hf]
      rw [map_sum, Finset.sum_apply]
      rfl
    rw [htr_eq1, hT_decomp, map_sum]
    refine Finset.sum_congr rfl fun ι _ => ?_
    rw [LinearMap.trace_comp_comm' (LinearMap.proj ι) (T_all.comp (LinearMap.single (Padic ℓ) W_ι ι))]
    let φ_ι : ↥(sys_ι ι) →ₗ[PadicInt ℓ] ↥(sys_ι ι) :=
      ((LinearMap.proj ι).comp E_comp.toLinearMap).comp
        ((Φ_prod q).comp (E_comp.symm.toLinearMap.comp
          (LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) ι)))
    have hblk_eq : (LinearMap.proj ι).comp (T_all.comp (LinearMap.single (Padic ℓ) W_ι ι)) =
        LinearMap.baseChange (Padic ℓ) φ_ι := by
      apply LinearMap.ext
      intro z
      have hEsymm : from_P (LinearMap.single (Padic ℓ) W_ι ι z) =
          (LinearMap.baseChange (Padic ℓ)
            (E_comp.symm.toLinearMap.comp
              (LinearMap.single (PadicInt ℓ) (fun j => ↥(sys_ι j)) ι))) z := by
        dsimp [from_P]
        rw [LinearMap.sum_apply, Finset.sum_eq_single ι]
        · rw [LinearMap.comp_apply, LinearMap.proj_apply, Pi.single_eq_same]
        · intro j _ hj
          rw [LinearMap.comp_apply, LinearMap.proj_apply, Pi.single_eq_of_ne hj, map_zero]
        · intro hmem; exact False.elim (hmem (Finset.mem_univ ι))
      change (to_P ((LinearMap.baseChange (Padic ℓ) (Φ_prod q))
          (from_P (LinearMap.single (Padic ℓ) W_ι ι z)))) ι =
        (LinearMap.baseChange (Padic ℓ) φ_ι) z
      rw [hEsymm]
      dsimp [to_P]
      rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp,
        ← LinearMap.comp_apply, ← LinearMap.baseChange_comp]
      rfl
    rw [hblk_eq]
    by_cases h : π_α ι = ι
    · rw [dif_pos h]
      obtain ⟨equiv_ι, p_fix, hsmul_fix, hfrob_fix, hact_fix⟩ := hModel_fix ι h q
      have hφ_pfix : ∀ (x : ↥(sys_ι ι)) (n : ℕ), (φ_ι x).1 n = p_fix n (x.1 n) := by
        intro x n
        cases n with
        | zero =>
          haveI := hSub_comp0 ι q
          exact Subsingleton.elim _ _
        | succ m =>
          change act_comp m q
            (fun j => (LinearMap.single (PadicInt ℓ) (fun i => ↥(sys_ι i)) ι x j).1 (m + 1)) ι =
            p_fix (m + 1) (x.1 (m + 1))
          rw [hact_fix m]
          simp
      letI : Module (PadicInt ℓ) (V_fix ι h q) :=
        Module.compHom (V_fix ι h q) (algebraMap (PadicInt ℓ) (Padic ℓ))
      let bil_β : Padic ℓ →ₗ[PadicInt ℓ] ↥(sys_ι ι) →ₗ[PadicInt ℓ] V_fix ι h q :=
        { toFun := fun k =>
            { toFun := fun x => k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x)
              map_add' := fun x₁ x₂ => by rw [TensorProduct.tmul_add, map_add, smul_add]
              map_smul' := fun r x => by
                change k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) (r • x)) =
                  (algebraMap (PadicInt ℓ) (Padic ℓ) r) •
                    (k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x))
                rw [hsmul_fix r x (r • x) (hsmul_ι ι r x)]
                change k • ((algebraMap (PadicInt ℓ) (Padic ℓ) r) •
                    equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x)) =
                  (algebraMap (PadicInt ℓ) (Padic ℓ) r) •
                    (k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x))
                rw [smul_smul, smul_smul, mul_comm] }
          map_add' := fun k₁ k₂ => by apply LinearMap.ext; intro x; simp [add_smul]
          map_smul' := fun r k => by
            apply LinearMap.ext; intro x
            change (algebraMap (PadicInt ℓ) (Padic ℓ) r * k) •
                equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x) =
              (algebraMap (PadicInt ℓ) (Padic ℓ) r) •
                (k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x))
            rw [mul_smul] }
      let β_tilde_add : W_ι ι →+ V_fix ι h q := (TensorProduct.lift bil_β).toAddMonoidHom
      let β_tilde : W_ι ι →ₗ[Padic ℓ] V_fix ι h q :=
        { toFun := β_tilde_add
          map_add' := β_tilde_add.map_add
          map_smul' := fun k₀ z => by
            change β_tilde_add (k₀ • z) = k₀ • β_tilde_add z
            induction z using TensorProduct.induction_on with
            | zero => rw [smul_zero, map_zero, smul_zero]
            | tmul k x =>
              change (k₀ * k) • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x) =
                k₀ • (k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x))
              rw [mul_smul]
            | add z₁ z₂ ih₁ ih₂ => rw [smul_add, map_add, ih₁, ih₂, map_add, smul_add] }
      have hβ_surj : Function.Surjective β_tilde := by
        intro v_tgt
        have hmem_all : ∀ z_rat : TensorProduct ℤ ℚ ↥(sys_ι ι),
            equiv_ι z_rat ∈ LinearMap.range β_tilde := by
          intro z_rat
          induction z_rat using TensorProduct.induction_on with
          | zero => rw [map_zero]; exact Submodule.zero_mem _
          | tmul q_rat x =>
            let a_int : ℤ := q_rat.num
            let d_nat : ℕ := q_rat.den
            have hd_ne_Q : (d_nat : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr q_rat.den_ne_zero
            have hd_ne_K : (d_nat : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr q_rat.den_ne_zero
            have hdiv : (a_int : ℚ) / (d_nat : ℚ) = q_rat := Rat.num_div_den q_rat
            have hd_q : (d_nat : ℚ) * q_rat = (a_int : ℚ) := by
              calc (d_nat : ℚ) * q_rat
                  = ((a_int : ℚ) / (d_nat : ℚ)) * (d_nat : ℚ) := by rw [← hdiv, mul_comm]
                _ = (a_int : ℚ) * ((d_nat : ℚ)⁻¹ * (d_nat : ℚ)) := by rw [div_eq_mul_inv, mul_assoc]
                _ = (a_int : ℚ) := by rw [inv_mul_cancel₀ hd_ne_Q, mul_one]
            have hnsmul_z : d_nat • TensorProduct.tmul ℤ q_rat x =
                TensorProduct.tmul ℤ (1 : ℚ) (a_int • x) := by
              calc d_nat • TensorProduct.tmul ℤ q_rat x
                  = (d_nat : ℚ) • TensorProduct.tmul ℤ q_rat x :=
                      (Nat.cast_smul_eq_nsmul ℚ d_nat _).symm
                _ = TensorProduct.tmul ℤ ((d_nat : ℚ) * q_rat) x := TensorProduct.smul_tmul' _ _ _
                _ = TensorProduct.tmul ℤ (a_int • (1 : ℚ)) x := by rw [hd_q, zsmul_one]
                _ = TensorProduct.tmul ℤ (1 : ℚ) (a_int • x) := TensorProduct.smul_tmul a_int 1 x
            refine ⟨((d_nat : Padic ℓ)⁻¹) •
              TensorProduct.tmul (PadicInt ℓ) (1 : Padic ℓ) (a_int • x), ?_⟩
            rw [map_smul]
            change (d_nat : Padic ℓ)⁻¹ •
              ((1 : Padic ℓ) • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) (a_int • x))) = _
            rw [one_smul, ← hnsmul_z, map_nsmul, ← Nat.cast_smul_eq_nsmul (Padic ℓ) d_nat,
              inv_smul_smul₀ hd_ne_K]
          | add z₁ z₂ ih₁ ih₂ => rw [map_add]; exact Submodule.add_mem _ ih₁ ih₂
        obtain ⟨w_pre, hw_pre⟩ := hmem_all (equiv_ι.symm v_tgt)
        exact ⟨w_pre, hw_pre.trans (equiv_ι.apply_symm_apply v_tgt)⟩
      have hβ_inj : Function.Injective β_tilde := by
        rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
        intro η hη
        rw [LinearMap.mem_ker] at hη
        let f_R := (TensorProduct.mk (PadicInt ℓ) (Padic ℓ) ↥(sys_ι ι)) 1
        let f_Z := (TensorProduct.mk ℤ ℚ ↥(sys_ι ι)) 1
        haveI : IsLocalizedModule (nonZeroDivisors (PadicInt ℓ)) f_R := inferInstance
        haveI : IsLocalizedModule (nonZeroDivisors ℤ) f_Z := inferInstance
        obtain ⟨⟨y₀, s_R⟩, hs_R⟩ := IsLocalizedModule.surj (nonZeroDivisors (PadicInt ℓ)) f_R η
        dsimp at hs_R
        rw [Submonoid.smul_def] at hs_R
        have hsR_ne : (s_R : PadicInt ℓ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_R.2
        let c_s : Padic ℓ := algebraMap (PadicInt ℓ) (Padic ℓ) (s_R : PadicInt ℓ)
        have hcs_ne : c_s ≠ 0 := by
          dsimp [c_s]
          rw [← map_zero (algebraMap (PadicInt ℓ) (Padic ℓ))]
          exact (IsFractionRing.injective (PadicInt ℓ) (Padic ℓ)).ne hsR_ne
        have hsmul_W : ∀ (r : PadicInt ℓ) (w : W_ι ι),
            r • w = (algebraMap (PadicInt ℓ) (Padic ℓ) r) • w := by
          intro r w
          induction w using TensorProduct.induction_on with
          | zero => rw [smul_zero, smul_zero]
          | tmul k x =>
            change TensorProduct.tmul (PadicInt ℓ) (r • k) x =
              TensorProduct.tmul (PadicInt ℓ) (algebraMap (PadicInt ℓ) (Padic ℓ) r * k) x
            rw [Algebra.smul_def]
          | add w₁ w₂ ih₁ ih₂ => rw [smul_add, smul_add, ih₁, ih₂]
        have hcs_η : c_s • η = f_R y₀ :=
          (hsmul_W (s_R : PadicInt ℓ) η).symm.trans hs_R
        have hy₀_β : equiv_ι (f_Z y₀) = 0 := by
          have h1 : β_tilde (f_R y₀) = equiv_ι (f_Z y₀) := by
            change (1 : Padic ℓ) • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) y₀) = _
            exact one_smul (Padic ℓ) _
          rw [← h1, ← hcs_η, map_smul, hη, smul_zero]
        have hy₀_Z : f_Z y₀ = 0 := equiv_ι.injective (hy₀_β.trans (map_zero equiv_ι).symm)
        rw [← IsLocalizedModule.mk'_one (nonZeroDivisors ℤ) f_Z y₀,
          IsLocalizedModule.mk'_eq_zero'] at hy₀_Z
        obtain ⟨n_Z, hn_Z⟩ := hy₀_Z
        have hnZ_ne : (n_Z : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp n_Z.2
        rw [Submonoid.smul_def] at hn_Z
        let n_R : nonZeroDivisors (PadicInt ℓ) :=
          ⟨((n_Z : ℤ) : PadicInt ℓ),
            mem_nonZeroDivisors_iff_ne_zero.mpr (Int.cast_ne_zero.mpr hnZ_ne)⟩
        have hnR_kill : n_R • y₀ = 0 := by
          rw [Submonoid.smul_def]
          let g_y : PadicInt ℓ →+ ↥(sys_ι ι) :=
            { toFun := fun r => r • y₀
              map_zero' := zero_smul _ _
              map_add' := fun a b => add_smul a b y₀ }
          change g_y ((n_Z : ℤ) : PadicInt ℓ) = 0
          rw [← zsmul_one (n_Z : ℤ), map_zsmul, show g_y 1 = y₀ from one_smul (PadicInt ℓ) y₀]
          exact hn_Z
        have hy₀_R : f_R y₀ = 0 := by
          rw [← IsLocalizedModule.mk'_one (nonZeroDivisors (PadicInt ℓ)) f_R y₀,
            IsLocalizedModule.mk'_eq_zero']
          exact ⟨n_R, hnR_kill⟩
        rw [hy₀_R] at hcs_η
        exact (smul_eq_zero.mp hcs_η).resolve_left hcs_ne
      let E_fix : W_ι ι ≃ₗ[Padic ℓ] V_fix ι h q :=
        LinearEquiv.ofBijective β_tilde ⟨hβ_inj, hβ_surj⟩
      have hconj_fix : E_fix.conj (LinearMap.baseChange (Padic ℓ) φ_ι) = Φ_fix ι h q := by
        apply LinearMap.ext; intro w_z
        obtain ⟨z₀, rfl⟩ := E_fix.surjective w_z
        rw [LinearEquiv.conj_apply]
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, E_fix.symm_apply_apply]
        change β_tilde ((LinearMap.baseChange (Padic ℓ) φ_ι) z₀) = Φ_fix ι h q (β_tilde z₀)
        induction z₀ using TensorProduct.induction_on with
        | zero => repeat rw [map_zero]
        | tmul k x =>
          rw [LinearMap.baseChange_tmul]
          change k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) (φ_ι x)) =
            Φ_fix ι h q (k • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x))
          rw [map_smul, ← hfrob_fix x (φ_ι x) (hφ_pfix x)]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
      rw [← LinearMap.trace_conj' (LinearMap.baseChange (Padic ℓ) φ_ι) E_fix, hconj_fix]
    · rw [dif_neg h]
      have hφ_zero : φ_ι = 0 := by
        apply LinearMap.ext; intro x
        apply Subtype.ext; funext n
        cases n with
        | zero => rfl
        | succ m =>
          change act_comp m q
            (fun j => (LinearMap.single (PadicInt ℓ) (fun i => ↥(sys_ι i)) ι x j).1 (m + 1)) ι = 0
          apply hact_off m q ι
          change (Pi.single (M := fun i => ↥(sys_ι i)) ι x (π_α ι)).1 (m + 1) = 0
          rw [Pi.single_eq_of_ne h]
          rfl
      have hb_zero : LinearMap.baseChange (Padic ℓ) φ_ι = 0 := by
        rw [hφ_zero]
        apply LinearMap.ext; intro z
        change (LinearMap.baseChange (Padic ℓ) (0 : ↥(sys_ι ι) →ₗ[PadicInt ℓ] ↥(sys_ι ι))) z = 0
        induction z using TensorProduct.induction_on with
        | zero => rw [map_zero]
        | tmul k x => rw [LinearMap.baseChange_tmul, LinearMap.zero_apply, TensorProduct.tmul_zero]
        | add z₁ z₂ ih₁ ih₂ => rw [map_add, ih₁, ih₂, add_zero]
      rw [hb_zero, map_zero]

  
  have hLatAll : ∀ i : Fin 3,
      algebraMap (PadicInt ℓ) (Padic ℓ) (Matrix.trace (M_lat i)) =
        LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K i.1))
          (LinearMap.baseChange (Padic ℓ) (Φ_K i.1)) := by
    intro i
    haveI : Module.Finite (PadicInt ℓ) ↥(sys_K i.1) := hFinMod_K i.1
    haveI : Module.Finite (PadicInt ℓ) ↥(sys_K (i.1 + 1)) := hFinMod_K (i.1 + 1)
    obtain ⟨c_i, e_i, v_i, _, hDiv_i, hSpan_i⟩ := hDVR ↥(sys_K i.1)
    obtain ⟨_, e_next, _, hKill_next, _, _⟩ := hDVR ↥(sys_K (i.1 + 1))
    let ev_i : ∀ (K : ℕ), 1 ≤ K → ↥(sys_K i.1) →+ H_K i.1 (K - 1) :=
      fun K _ => (Pi.evalAddMonoidHom (H_K i.1) (K - 1)).comp (sys_K i.1).subtype
    refine hLatTrace (b i) c_i e_i e_next (M_lat i) ↥(sys_K i.1) (Φ_K i.1) v_i hDiv_i hSpan_i
      (fun K => H_K i.1 (K - 1)) (fun K => α_K (K - 1) i.1)
      (fun K hK y => by
        have hsub : K - 1 + 1 = K := Nat.sub_add_cancel hK
        simpa only [hsub] using hAnn_K i.1 (K - 1) y)
      ev_i
      (fun K _ x => rfl)
      (fun K hK z x => by
        cases K with
        | zero => omega
        | succ m => exact hsmul_K i.1 z x m)
      (fun K hK x hx => by
        obtain ⟨u, hu⟩ := hKer_K i.1 (K - 1) x hx
        rw [Nat.sub_add_cancel hK] at hu
        exact ⟨u, hu⟩)
      (fun K hK y => by
        obtain ⟨δ_hat, hδ_ann, hδ_exact⟩ := hDelta_K i.1 (K - 1)
        have hkill1 : ((ℓ : PadicInt ℓ) ^ e_next) • (δ_hat y) = 0 :=
          hKill_next (δ_hat y) ⟨K - 1 + 1, hδ_ann y⟩
        have hkill2 : δ_hat ((ℓ ^ e_next : ℕ) • y) = 0 := by
          rw [map_nsmul]
          apply Subtype.ext; funext a
          have ha := congrArg (fun w : ↥(sys_K (i.1 + 1)) => w.1 a) hkill1
          rwa [hpow_smul_K] at ha
        exact hδ_exact _ hkill2)
      (fun K hK => hLat K hK i)

  
  have hTr0 : LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 0))
      (LinearMap.baseChange (Padic ℓ) (Φ_K 0)) = 0 := by
    haveI : Module.Finite (PadicInt ℓ) ↥(sys_K 0) := hFinMod_K 0
    have hSub_L0 : Subsingleton ↥(sys_K 0) :=
      ⟨fun x y => Subtype.ext (funext fun m => by haveI := hSub₀ m; exact Subsingleton.elim _ _)⟩
    have hSub_V0 : Subsingleton (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 0)) := by
      refine ⟨fun z₁ z₂ => ?_⟩
      have hz0 : ∀ z : TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 0), z = 0 := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rfl
        | tmul k x => rw [hSub_L0.elim x 0, TensorProduct.tmul_zero]
        | add a₁ a₂ ih₁ ih₂ => rw [ih₁, ih₂, add_zero]
      exact (hz0 z₁).trans (hz0 z₂).symm
    have hmap0 : LinearMap.baseChange (Padic ℓ) (Φ_K 0) = 0 :=
      LinearMap.ext fun _ => hSub_V0.elim _ _
    rw [hmap0, map_zero]

  
  have hDeg2 :
      Module.Finite (PadicInt ℓ) ↥(sys_prod 2) ∧
      LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 2))
          (LinearMap.baseChange (Padic ℓ) (Φ_K 2)) =
        LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_prod 2))
          (LinearMap.baseChange (Padic ℓ) (Φ_prod 2)) := by
    haveI : Module.Finite (PadicInt ℓ) ↥(sys_K 2) := hFinMod_K 2
    let E₂ : ↥(sys_K 2) ≃ₗ[PadicInt ℓ] ↥(sys_prod 2) :=
      { toFun := fun x =>
          ⟨fun m => g₂_m m (x.1 m),
            hmem_sysProd.mpr fun m j =>
              ((hExc m).2.2.2.2.2.2.2.2.2.2.2 (x.1 (m + 1)) j).trans
                (congrFun (congrArg (g₂_m m) (hmem_sysK.mp x.2 m)) j)⟩
        map_add' := fun x y => by apply Subtype.ext; funext m; exact map_add _ _ _
        map_smul' := fun r x => by
          apply Subtype.ext; funext m
          simp only [RingHom.id_apply]
          rw [hsmul_prod, hsmul_K]
          exact map_nsmul (g₂_m m).toAddMonoidHom _ (x.1 m)
        invFun := fun y =>
          ⟨fun m => (g₂_m m).symm (y.1 m),
            hmem_sysK.mpr fun m => by
              apply (g₂_m m).injective
              rw [(g₂_m m).apply_symm_apply]
              funext j
              rw [← (hExc m).2.2.2.2.2.2.2.2.2.2.2 ((g₂_m (m + 1)).symm (y.1 (m + 1))) j,
                (g₂_m (m + 1)).apply_symm_apply]
              exact hmem_sysProd.mp y.2 m j⟩
        left_inv := fun x => by apply Subtype.ext; funext m; exact (g₂_m m).symm_apply_apply _
        right_inv := fun y => by apply Subtype.ext; funext m; exact (g₂_m m).apply_symm_apply _ }
    haveI hFinP2 : Module.Finite (PadicInt ℓ) ↥(sys_prod 2) :=
      Module.Finite.of_surjective E₂.toLinearMap E₂.surjective
    refine ⟨hFinP2, ?_⟩
    let E₂_K := LinearEquiv.baseChange (PadicInt ℓ) (Padic ℓ) ↥(sys_K 2) ↥(sys_prod 2) E₂
    have hconj2 : E₂_K.conj (LinearMap.baseChange (Padic ℓ) (Φ_K 2)) =
        LinearMap.baseChange (Padic ℓ) (Φ_prod 2) := by
      apply LinearMap.ext; intro z
      obtain ⟨z₀, rfl⟩ := E₂_K.surjective z
      rw [LinearEquiv.conj_apply]
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, E₂_K.symm_apply_apply]
      change E₂_K ((LinearMap.baseChange (Padic ℓ) (Φ_K 2)) z₀) =
        (LinearMap.baseChange (Padic ℓ) (Φ_prod 2)) (E₂_K z₀)
      induction z₀ using TensorProduct.induction_on with
      | zero => repeat rw [map_zero]
      | tmul k x =>
        dsimp [E₂_K]
        congr 1
        apply Subtype.ext; funext m
        exact (hExc m).2.2.2.2.2.2.2.1 (x.1 m)
      | add z₁ z₂ ih₁ ih₂ => rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
    rw [← LinearMap.trace_conj' (LinearMap.baseChange (Padic ℓ) (Φ_K 2)) E₂_K, hconj2]

  obtain ⟨hFinP0, hFinP1, hTr1⟩ := hFourTerm
  obtain ⟨hFinP2, hTr2⟩ := hDeg2
  have hC0 := hCompTrace 0 hFinP0
  have hC1 := hCompTrace 1 hFinP1
  have hC2 := hCompTrace 2 hFinP2
  have hL0 := hLatAll 0
  have hL1 := hLatAll 1
  have hL2 := hLatAll 2
  rw [map_add, map_sub, hL0, hL1, hL2]
  change LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 0))
        (LinearMap.baseChange (Padic ℓ) (Φ_K 0)) -
      LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 1))
        (LinearMap.baseChange (Padic ℓ) (Φ_K 1)) +
      LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 2))
        (LinearMap.baseChange (Padic ℓ) (Φ_K 2)) = _
  rw [hTr0, hTr1, hTr2, hC0, hC1, hC2]
  have hIic2 : (Finset.Iic 2 : Finset ℕ) = {0, 1, 2} := by decide
  have hsum_combine :
      (∑ ι : Fin m_c,
        if h : π_α ι = ι then
          ∑ i ∈ Finset.Iic 2,
            (-1 : Padic ℓ) ^ i * LinearMap.trace (Padic ℓ) (V_fix ι h i) (Φ_fix ι h i)
        else 0) =
      (∑ ι : Fin m_c, if h : π_α ι = ι then LinearMap.trace (Padic ℓ) (V_fix ι h 0) (Φ_fix ι h 0) else 0) -
        (∑ ι : Fin m_c, if h : π_α ι = ι then LinearMap.trace (Padic ℓ) (V_fix ι h 1) (Φ_fix ι h 1) else 0) +
        (∑ ι : Fin m_c, if h : π_α ι = ι then LinearMap.trace (Padic ℓ) (V_fix ι h 2) (Φ_fix ι h 2) else 0) := by
    rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun ι _ => ?_
    by_cases h : π_α ι = ι
    · rw [dif_pos h, dif_pos h, dif_pos h, dif_pos h, hIic2, Finset.sum_insert (by decide),
        Finset.sum_insert (by decide), Finset.sum_singleton]
      ring
    · rw [dif_neg h, dif_neg h, dif_neg h, dif_neg h]
      ring
  rw [hsum_combine]
  ring

theorem weil_curve_tr_open_curve_twisted_frob_trace (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
