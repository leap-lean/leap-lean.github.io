    (B₀ L₀ : Type u)
    [CommRing B₀] [IsDomain B₀] [Field L₀]
    [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra F L₀] [Algebra (Polynomial F) L₀] [Algebra (RatFunc F) L₀]
    [Algebra B₀ L₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsScalarTower F (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) B₀ L₀]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀ L₀]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsFractionRing B₀ L₀]
    [IsIntegralClosure B₀
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [FiniteDimensional (RatFunc F) L₀]
    [IsGalois (RatFunc F) L₀]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (r B₂ : ℕ) (hr : 1 ≤ r)
    (𝒦 : ℕ → CategoryTheory.Sheaf
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology AddCommGrpCat.{u})
    (τ_𝒦 : ∀ m : ℕ, Quiver.Hom (𝒦 (m + 1)) (𝒦 m))
    (b_V : (B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀) →
      Fin 3 → ℕ)
    (M_lat_V : ∀ (σ : B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀)
      (i : Fin 3), Matrix (Fin (b_V σ i)) (Fin (b_V σ i)) (PadicInt ℓ))
    (hGeomExt : WeilCurveTrGeomCoverZeroExt.{u} F S_aff U₀ ℓ B₀ e_U r 𝒦 τ_𝒦 B₂ b_V M_lat_V)
    (σ : B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    Matrix.trace (M_lat_V σ 0) - Matrix.trace (M_lat_V σ 1) + Matrix.trace (M_lat_V σ 2) =
      (Nat.card { y : ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀)) //
        IsClosed ({y} : Set ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))) ∧
        (CategoryTheory.CategoryStruct.comp
          (weilSchemeEndPow (weilGeomFrobHom F (weilCurveTrGeomCoverOver F B₀)) r)
          (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)).base y = y } : PadicInt ℓ) :=
by
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  let k := AlgebraicClosure F
  let D_ov := weilProjectiveSpaceOver F 1
  let D_bar := weilGeomScheme F D_ov
  let V_ov := weilCurveTrGeomCoverOver F B₀
  let V_bar := weilGeomScheme F V_ov
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let pr_D : Quiver.Hom D_bar D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
  let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
  let α_σ : Quiver.Hom V_bar V_bar :=
    CategoryTheory.CategoryStruct.comp
      (weilSchemeEndPow (weilGeomFrobHom F V_ov) r)
      (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)
  let g_D_r : Quiver.Hom D_bar D_bar := weilSchemeEndPow (weilGeomFrobHom F D_ov) r
  obtain ⟨ι_bar, triv_K, hι_fst, hι_snd, htriv_K, hσ_all⟩ := hGeomExt
  obtain ⟨α_H, hα_H, hLat⟩ := hσ_all σ
  obtain ⟨hPrime_p, μ, d_cov, m_bdry, M_bdry, m_c, m_sheet, g_Dr_iso, π_bar, s_bdry,
    Y_bar, p_bar, j_V, z_bdry, Y_comp, inc_comp, α_geom, φ_abs, π_bdry, π_α, α_fix, hα_fix_hom,
    _hμ, hd_cov, hm_c, hm_sheet, hg_Dr_eq, hα_ι, hπ_ι, hπ_et, hπ_surj, hSheets,
    hs_bdry, hU_compl, _hp_hom, hp_locFree, hj_V_open, hj_p, hj_range,
    hz_bdry, hz_disj, hz_compl, hcomp_all, hcomp_disj, hcomp_univ,
    hα_p, hα_j, hφ_abs, hπ_bdry, hπ_α, hα_fix_all, hCard_part⟩ :=
    weil_curve_tr_geom_completion_and_twisted_relFrob F S_aff j_aff hj_open hj_hom
      s_inf hsinf_sec hsinf_compl U₀ hU₀_eq B₀ L₀ e_U heU r hr σ ι_bar hι_fst hι_snd
  let _ : Fact (Nat.Prime (ringChar F)) := hPrime_p
  have hUnit_ℓ : IsUnit (ℓ : k) := by
    rw [isUnit_iff_ne_zero]
    intro h0
    have h0F : (ℓ : F) = 0 := by
      apply (algebraMap F k).injective
      rw [map_natCast, map_zero]
      exact h0
    have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp h0F
    have heq : ringChar F = ℓ :=
      ((Nat.dvd_prime (Fact.out : Nat.Prime ℓ)).mp hdvd).resolve_left hPrime_p.out.ne_one
    exact hℓ heq.symm
  have hTorsAnn : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m q : ℕ) (x : weilEtaleTorsionH S m q),
      (m : ℕ) • x = 0 := by
    intro S m q x
    let C := CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    let U := AddCommGrpCat.uliftFunctor.{u, 0}
    let A := AddCommGrpCat.of (ZMod m)
    let FM : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      weilEtaleTorsionSheaf S m
    have hA : (m : ℕ) • CategoryTheory.CategoryStruct.id A = 0 := by
      ext z
      have hnsmul : ∀ n : ℕ, ((n • CategoryTheory.CategoryStruct.id A).hom) z = n • z := by
        intro n
        induction n with
        | zero => rfl
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul]
          exact congrArg (· + z) ih
      change ((m • CategoryTheory.CategoryStruct.id A).hom) z = 0
      rw [hnsmul m, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    let _ : U.Additive := ⟨rfl⟩
    let T_S : S.Etale := weilEtaleIdTerminal.{u} S
    let hT_S : CategoryTheory.Limits.IsTerminal T_S := weilEtaleIdTerminalIsTerminal.{u} S
    let adj := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
    let G := (CategoryTheory.sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T_S)
    let _ : G.Additive := ⟨rfl⟩
    let _ : C.Additive := adj.left_adjoint_additive
    have hm_id : (m : ℕ) • CategoryTheory.CategoryStruct.id FM = 0 := by
      change (m : ℕ) • CategoryTheory.CategoryStruct.id (C.obj (U.obj A)) = 0
      rw [← C.map_id, ← U.map_id, ← C.map_nsmul, ← U.map_nsmul, hA, U.map_zero, C.map_zero]
    let φ : (FM ⟶ FM) →+ weilEtaleTorsionH S m q :=
      (x.precomp FM (Nat.add_zero q)).comp
        CategoryTheory.Abelian.Ext.addEquiv₀.symm.toAddMonoidHom
    have hφ_id : φ (CategoryTheory.CategoryStruct.id FM) = x := by
      dsimp [φ]
      rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id x
    calc
      (m : ℕ) • x = (m : ℕ) • φ (CategoryTheory.CategoryStruct.id FM) := by rw [← hφ_id]
      _ = φ ((m : ℕ) • CategoryTheory.CategoryStruct.id FM) := (map_nsmul φ _ _).symm
      _ = φ 0 := by rw [hm_id]
      _ = 0 := map_zero φ
  let _ : ∀ ι : Fin m_c, AlgebraicGeometry.IsProper (Y_comp ι).hom :=
    fun ι => (hcomp_all ι).2.2.2.2.1
  let _ : ∀ ι : Fin m_c, AlgebraicGeometry.SmoothOfRelativeDimension 1 (Y_comp ι).hom :=
    fun ι => (hcomp_all ι).2.2.2.2.2.1
  have hcomp_short : ∀ ι : Fin m_c,
      CategoryTheory.CategoryStruct.comp (inc_comp ι) Y_bar.hom = (Y_comp ι).hom ∧
      AlgebraicGeometry.IsOpenImmersion (inc_comp ι) ∧
      AlgebraicGeometry.IsClosedImmersion (inc_comp ι) ∧
      AlgebraicGeometry.IsIntegral (Y_comp ι).left ∧
      ∃ t : Fin M_bdry, Set.range (z_bdry t).base ⊆ Set.range (inc_comp ι).base :=
    fun ι => ⟨(hcomp_all ι).1, (hcomp_all ι).2.1, (hcomp_all ι).2.2.1, (hcomp_all ι).2.2.2.1,
      (hcomp_all ι).2.2.2.2.2.2⟩
  have hUniq_pull : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (n q : ℕ)
      (p₁ p₂ : weilEtaleTorsionH W₂ n q →+ weilEtaleTorsionH W₁ n q),
      WeilLefschetzTorsionPullback h n q p₁ →
      WeilLefschetzTorsionPullback h n q p₂ → p₁ = p₂ :=
    (weil_algClosed_transversal_endomorphism_lefschetz_trace k 1 (Y_comp ⟨0, hm_c⟩)
      (hcomp_all ⟨0, hm_c⟩).2.2.2.1 ℓ hUnit_ℓ).1
  have hFin_comp : ∀ (ι : Fin m_c) (q n : ℕ),
