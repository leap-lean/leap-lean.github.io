  have hmkMap_triv : ∀ (m₁ m₂ : ℕ) (φ : ZMod (ℓ ^ (m₁ + 1)) →+ ZMod (ℓ ^ (m₂ + 1)))
      (W : D_bar.Etale) (sec : ↑((𝒦_s m₁).obj.obj (Opposite.op W))) (y),
