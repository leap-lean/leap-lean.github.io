  have hExtBij : ∀ {𝒞₁ 𝒞₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞₁] [CategoryTheory.Abelian 𝒞₁]
      [CategoryTheory.HasExt.{u} 𝒞₁] [CategoryTheory.EnoughInjectives 𝒞₁]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞₂] [CategoryTheory.Abelian 𝒞₂]
      [CategoryTheory.HasExt.{u} 𝒞₂]
      (F : CategoryTheory.Functor 𝒞₁ 𝒞₂)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      (X₁ : 𝒞₁) (X₂ : 𝒞₂) (η : Quiver.Hom X₂ (F.obj X₁)),
      (∀ Y : 𝒞₁, Function.Bijective (fun g : Quiver.Hom X₁ Y => η ≫ F.map g)) →
      (∀ (I : 𝒞₁), CategoryTheory.Injective I →
        ∀ (k : ℕ) (z : CategoryTheory.Abelian.Ext.{u} X₂ (F.obj I) (k + 1)), z = 0) →
      ∀ (q : ℕ) (Y : 𝒞₁),
        Function.Bijective
          (((CategoryTheory.Abelian.Ext.mk₀ η).precomp (F.obj Y) (Nat.zero_add q)).comp
            (F.mapExtAddHom X₁ Y q)) := by
    intro 𝒞₁ 𝒞₂ _ _ _ _ _ _ _ F _ _ _ X₁ X₂ η hBij0 hVan q
    let d_map : ∀ (Y : 𝒞₁) (r : ℕ),
        CategoryTheory.Abelian.Ext.{u} X₁ Y r →+ CategoryTheory.Abelian.Ext.{u} X₂ (F.obj Y) r :=
      fun Y r => ((CategoryTheory.Abelian.Ext.mk₀ η).precomp (F.obj Y) (Nat.zero_add r)).comp
        (F.mapExtAddHom X₁ Y r)
    have hd_apply : ∀ (Y : 𝒞₁) (r : ℕ) (y : CategoryTheory.Abelian.Ext.{u} X₁ Y r),
        d_map Y r y = (CategoryTheory.Abelian.Ext.mk₀ η).comp
          (y.mapExactFunctor F) (Nat.zero_add r) := fun _ _ _ => rfl
    have hd_post : ∀ {Y₁ Y₂ : 𝒞₁} (φ : Quiver.Hom Y₁ Y₂) (r : ℕ)
        (y : CategoryTheory.Abelian.Ext.{u} X₁ Y₁ r),
        d_map Y₂ r (y.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero r)) =
          (d_map Y₁ r y).comp (CategoryTheory.Abelian.Ext.mk₀ (F.map φ)) (Nat.add_zero r) := by
      intro Y₁ Y₂ φ r y
      rw [hd_apply, hd_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add r) (Nat.add_zero r) (Nat.zero_add r)]
    induction q with
    | zero =>
      intro Y
      have hd0 : ∀ g : Quiver.Hom X₁ Y,
          d_map Y 0 (CategoryTheory.Abelian.Ext.mk₀ g) =
            CategoryTheory.Abelian.Ext.mk₀ (η ≫ F.map g) := by
        intro g
        rw [hd_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        obtain ⟨g₁, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X₁ Y).2 a₁
        obtain ⟨g₂, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X₁ Y).2 a₂
