theorem weil_lefschetz_pencil_transvection_trichotomy (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z₁.hom]
    [AlgebraicGeometry.IsProper Z₁.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z₁.hom]
    (P : WeilRationalLefschetzPencil F m Z₁)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Ztilde : WeilEllAdicCohomologyModel F P.Z_tilde ℓ (2 * m + 2))
    (M_Zu_low : WeilEllAdicCohomologyModel F P.Z_u₀ ℓ (2 * m))
    (M_Zu_high : WeilEllAdicCohomologyModel F P.Z_u₀ ℓ (2 * m + 2))
    (γ' : AlgebraicClosure (Padic ℓ))
    (hγ' : γ' ∈ ((M_Ztilde.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    γ' ^ 2 = ((Nat.card F : AlgebraicClosure (Padic ℓ)) ^ (m + 1)) ^ 2 ∨
    ((∃ α_low ∈ ((M_Zu_low.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)),
        γ' = (Nat.card F : AlgebraicClosure (Padic ℓ)) * α_low) ∨
      γ' ∈ ((M_Zu_high.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) ∨
    ∃ S_aff : Finset F,
      WeilTransvectionCurveSymplecticSystem.{u} F S_aff ℓ (2 * m + 1) γ' :=
by
  let L := AlgebraicClosure (Padic ℓ)
  have hq : 2 ≤ Nat.card F := Finite.one_lt_card
  have _ : AlgebraicGeometry.GeometricallyIrreducible P.Z_tilde.hom := P.hGeom_Ztilde
  have _ : AlgebraicGeometry.IsProper P.Z_tilde.hom := P.hProp_Ztilde
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) P.Z_tilde.hom := P.hSm_Ztilde
  have _ : AlgebraicGeometry.GeometricallyIrreducible P.Z_u₀.hom := P.hGeom_Zu₀
  have _ : AlgebraicGeometry.IsProper P.Z_u₀.hom := P.hProp_Zu₀
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) P.Z_u₀.hom := P.hSm_Zu₀
  have _ : AlgebraicGeometry.Flat P.f₀.left := P.hFlat_f₀
  have _ : AlgebraicGeometry.IsProper P.f₀.left := P.hProp_f₀
  have _ : AlgebraicGeometry.Surjective P.f₀.left := P.hSurj_f₀
  have hNoZeroRoot : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      [AlgebraicGeometry.GeometricallyIrreducible W.hom]
      [AlgebraicGeometry.IsProper W.hom]
      (d_W : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d_W W.hom]
      (i : ℕ) (hi : i ≤ 2 * d_W)
      (Mi : WeilEllAdicCohomologyModel F W ℓ i)
      (M_dual : WeilEllAdicCohomologyModel F W ℓ (2 * d_W - i))
      (α : L),
      α ∈ ((Mi.frob).charpoly).aroots L → α ≠ 0 := by
    intro W _ _ d_W _ i hi Mi M_dual α hα
    rintro rfl
    obtain ⟨B, hB, hEq⟩ := weil_etale_poincare_duality_pairing F W d_W ℓ hℓ i hi Mi M_dual
    have hqd_ne : ((Nat.card F : Padic ℓ) ^ d_W) ≠ 0 :=
      pow_ne_zero d_W (Nat.cast_ne_zero.mpr (by omega))
    have hInj : Function.Injective Mi.frob := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      have hBx : B x = 0 := by
        ext y
        have h0 := hEq x y
        rw [LinearMap.mem_ker.mp hx, map_zero, LinearMap.zero_apply] at h0
        exact (mul_eq_zero.mp h0.symm).resolve_left hqd_ne
      exact hB.1 (hBx.trans (map_zero B).symm)
    obtain ⟨g_inv, hg_inv⟩ :=
      LinearMap.exists_leftInverse_of_injective Mi.frob (LinearMap.ker_eq_bot.mpr hInj)
    let Φ_L : Module.End L (TensorProduct (Padic ℓ) L Mi.V) := LinearMap.baseChange L Mi.frob
    let g_L := LinearMap.baseChange L g_inv
    have hg_L : g_L ∘ₗ Φ_L = LinearMap.id := by
      rw [← LinearMap.baseChange_comp, hg_inv, LinearMap.baseChange_id]
    have h0_roots : (0 : L) ∈ (Φ_L.charpoly).roots := by
      rwa [LinearMap.charpoly_baseChange, ← Polynomial.aroots_def]
    have h0_isRoot : (Φ_L.charpoly).IsRoot 0 :=
      (Polynomial.mem_roots (LinearMap.charpoly_monic Φ_L).ne_zero).mp h0_roots
    have h0_eigen : Φ_L.HasEigenvalue 0 :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly Φ_L 0).mpr h0_isRoot
    obtain ⟨v, hv⟩ := h0_eigen.exists_hasEigenvector
    have hv_zero : Φ_L v = 0 := by
      have h1 := Module.End.mem_eigenspace_iff.mp hv.1
      rwa [zero_smul] at h1
    have hv_eq0 : v = 0 := by
      calc v = (g_L ∘ₗ Φ_L) v := by rw [hg_L]; rfl
        _ = g_L (Φ_L v) := rfl
        _ = g_L 0 := by rw [hv_zero]
        _ = 0 := map_zero g_L
    exact hv.2 hv_eq0
  rcases P.hSing_dichotomy with hSm_f₀ | ⟨j_aff, s_inf, S_aff, U₀, C_disc, ι_disc, U_disc_reg, hSing⟩
  · have _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) P.f₀.left := hSm_f₀
    right; left
    exact weil_transv_smooth_pencil_over_p1_frob_eigenvalue F m P.Z_tilde P.f₀ P.hFibIrred_f₀
      P.u₀ P.hu₀_sec P.Z_u₀ P.ι_Zu₀ P.hPb_Zu₀ ℓ hℓ M_Ztilde M_Zu_low M_Zu_high γ' hγ'
  · obtain ⟨M_Zu, -, -, -⟩ :=
      weil_etale_cohomology_grothendieck_package F P.Z_u₀ (2 * m + 1) ℓ hℓ
    rcases weil_transv_singular_pencil_vanishing_devissage F m Z₁ P j_aff s_inf S_aff U₀
        C_disc ι_disc U_disc_reg hSing ℓ hℓ M_Ztilde M_Zu γ' hγ' with
      hSq | hFib | ⟨M, hM, J, G_geom, F_u, F_mat, Δ, α_num, β_den, ℒ₀, τ_ℒ, W_mid,
        hJ_skew, hJ_det, hG_sp, hΔ_ne, hΔ_nz, hΔ_span, hΔ_orb, hΔ_inv, hΔ_transv, hDense,
        hFu_norm, hFu_sim, hF_sim, hα_mem, hβ_mem, hFibTr, hTower, hγ'_mid⟩
    · exact Or.inl hSq
    · right; left
      have hchar_low := weil_ellAdicModel_charpoly_eq F P.Z_u₀ ℓ (2 * m) (M_Zu (2 * m)) M_Zu_low
      have hchar_high :=
        weil_ellAdicModel_charpoly_eq F P.Z_u₀ ℓ (2 * m + 2) (M_Zu (2 * m + 2)) M_Zu_high
      rcases hFib with ⟨α_low, hα_low, hEq_low⟩ | hHigh
      · rw [hchar_low] at hα_low
        exact Or.inl ⟨α_low, hα_low, hEq_low⟩
      · rw [hchar_high] at hHigh
        exact Or.inr hHigh
    · right; right
      obtain ⟨M_Ztilde_pkg, -, -, -⟩ :=
        weil_etale_cohomology_grothendieck_package F P.Z_tilde (2 * m + 2) ℓ hℓ
      have hγ'_ne : γ' ≠ 0 :=
        hNoZeroRoot P.Z_tilde (2 * m + 2) (2 * m + 2) (by omega)
          M_Ztilde (M_Ztilde_pkg (2 * (2 * m + 2) - (2 * m + 2))) γ' hγ'
      have hΔ_simple : ∀ U_sub : Submodule (Padic ℓ) (Fin M → Padic ℓ),
          (∀ v ∈ Δ, ∀ u ∈ U_sub, (dotProduct u (J.mulVec v)) • v ∈ U_sub) →
          U_sub = ⊥ ∨ U_sub = ⊤ :=
        fun U_sub hU =>
