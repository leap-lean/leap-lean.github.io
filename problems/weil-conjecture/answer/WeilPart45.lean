                    ∏ t : Fin (2 * k), A (e_idx p t) (f t) * B (f t) (e_idx q t) :=
                  Fintype.prod_sum fun t i => A (e_idx p t) i * B i (e_idx q t)
              _ = ∑ m : Fin N_k,
                    ∏ t : Fin (2 * k), A (e_idx p t) (e_idx m t) * B (e_idx m t) (e_idx q t) :=
                  (Equiv.sum_comp e_idx _).symm
              _ = ∑ m : Fin N_k,
                    (∏ t : Fin (2 * k), A (e_idx p t) (e_idx m t)) *
                      (∏ t : Fin (2 * k), B (e_idx m t) (e_idx q t)) := by
                  refine Finset.sum_congr rfl fun m _ => ?_
                  exact Finset.prod_mul_distrib }
    have hkron_map : ∀ {R S : Type} [CommRing R] [CommRing S] (ξ : R →+* S)
