          simp [hne]
    have hPQ_map_K : P_Q.map (algebraMap ℚ K) = recProd (M.map (· ^ e)) := by
      rw [← hMap_QE_K P_Q, hPQ_map_E]
      change (recProd (M_E.map (· ^ e))).map ι_E.toRingHom = _
