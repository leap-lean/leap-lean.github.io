      have heq_nat : (2 : ℕ) ^ p = (2 : ℕ) ^ q := by
        apply Nat.cast_injective (R := K)
        simpa only [Nat.cast_pow, Nat.cast_ofNat] using heq_K
      exact hpq (Nat.pow_right_injective (by decide : 1 < 2) heq_nat)
    have hφ_zero : φ e_u = 0 := (mul_eq_zero.mp hbal).resolve_left hpow_ne
    rw [hφ_zero, mul_zero, mul_zero]

theorem weil_symplectic_cayley_single_eigenvalue_avoidance (ℓ M r₀ : ℕ) [Fact (Nat.Prime ℓ)] (hM : 1 ≤ M) (hr₀ : 1 ≤ r₀)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (hJ_skew : J.transpose = -J) (hJ_det : J.det ≠ 0)
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (hCong : ∀ B : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ,
      (B.val).map (PadicInt.toZModPow r₀) = 1 →
      ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J →
      B ∈ G_geom)
    (A₁ : Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (δ_list : List (AlgebraicClosure (Padic ℓ)))
    (hδ_ne : ∀ δ ∈ δ_list, δ ≠ 0) :
    ∃ B ∈ G_geom,
      ∀ δ ∈ δ_list,
        (((A₁ * B.val).map
          (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))).charpoly).eval δ ≠ 0 :=
by
  have _ := hM
  let K := Padic ℓ
  let L := AlgebraicClosure (Padic ℓ)
  let _ : DecidableEq L := Classical.decEq L
  let ι_K := algebraMap (PadicInt ℓ) K
  let ι_L := algebraMap (PadicInt ℓ) L
  let φ : PadicInt ℓ →+* ZMod (ℓ ^ r₀) := PadicInt.toZModPow r₀

  
  have hJ_unit_det : IsUnit J.det := hJ_det.isUnit
  have hJ_mul_inv : J * J⁻¹ = 1 := Matrix.mul_nonsing_inv J hJ_unit_det
  have hJ_inv_mul : J⁻¹ * J = 1 := Matrix.nonsing_inv_mul J hJ_unit_det
  have hJinv_det_ne : (J⁻¹).det ≠ 0 := by
    intro h0
    have h1 : (J * J⁻¹).det = 1 := by rw [hJ_mul_inv, Matrix.det_one]
    rw [Matrix.det_mul, h0, mul_zero] at h1
    exact zero_ne_one h1
  have hJinv_skew : (J⁻¹).transpose = -J⁻¹ := by
    have htr : (J⁻¹ * J).transpose = (1 : Matrix (Fin M) (Fin M) K).transpose :=
      congrArg Matrix.transpose hJ_inv_mul
    rw [Matrix.transpose_mul, Matrix.transpose_one, hJ_skew, Matrix.neg_mul,
      neg_eq_iff_eq_neg] at htr
    have hmul := congrArg (J⁻¹ * ·) htr
    rw [← Matrix.mul_assoc, hJ_inv_mul, Matrix.one_mul, Matrix.mul_neg, Matrix.mul_one] at hmul
    exact hmul

  obtain ⟨c₀, hc₀_int⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors (PadicInt ℓ))
    (Finset.univ : Finset (Fin M × Fin M)) (fun p => J⁻¹ p.1 p.2)
  have hc₀_ne : (c₀ : PadicInt ℓ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp c₀.2
  have hc₀_K_ne : ι_K (c₀ : PadicInt ℓ) ≠ 0 := by
    intro h0
    exact hc₀_ne (IsFractionRing.injective (PadicInt ℓ) K (h0.trans (map_zero ι_K).symm))
  let J₀ : Matrix (Fin M) (Fin M) (PadicInt ℓ) :=
    Matrix.of fun i j => (hc₀_int (i, j) (Finset.mem_univ (i, j))).choose
  let H₀ : Matrix (Fin M) (Fin M) (PadicInt ℓ) := ((ℓ : PadicInt ℓ) ^ r₀) • J₀
  let α₀ : K := (ℓ : K) ^ r₀ * ι_K (c₀ : PadicInt ℓ)
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hα₀_ne : α₀ ≠ 0 :=
    mul_ne_zero (pow_ne_zero r₀ (Nat.cast_ne_zero.mpr hℓ_prime.ne_zero)) hc₀_K_ne
  have hH₀_map_K : H₀.map ι_K = α₀ • J⁻¹ := by
    ext i j
    simp only [H₀, J₀, α₀, Matrix.map_apply, Matrix.smul_apply, Matrix.of_apply, smul_eq_mul,
      map_mul, map_pow, map_natCast]
    rw [(hc₀_int (i, j) (Finset.mem_univ (i, j))).choose_spec, Algebra.smul_def, mul_assoc]
  have hH₀_det_K : (H₀.map ι_K).det ≠ 0 := by
    rw [hH₀_map_K, Matrix.det_smul, Fintype.card_fin]
    exact mul_ne_zero (pow_ne_zero M hα₀_ne) hJinv_det_ne

  have hCongUnit : ∀ C : Matrix (Fin M) (Fin M) (PadicInt ℓ), C.map φ = 1 → IsUnit C := by
    intro C hC
    have hφ_det : φ C.det = 1 := by
      rw [RingHom.map_det φ C]
      change (C.map φ).det = 1
      rw [hC, Matrix.det_one]
    have hker : C.det - 1 ∈ RingHom.ker φ := by
      rw [RingHom.mem_ker, map_sub, hφ_det, map_one, sub_self]
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton] at hker
    rcases hker with ⟨u, hu⟩
    obtain ⟨m₀, hm₀⟩ : ∃ m₀ : ℕ, r₀ = m₀ + 1 := ⟨r₀ - 1, (Nat.sub_add_cancel hr₀).symm⟩
    have hsub_eq : 1 - C.det = (ℓ : PadicInt ℓ) * (-((ℓ : PadicInt ℓ) ^ m₀ * u)) := by
      have h1 : 1 - C.det = -(C.det - 1) := by ring
      rw [h1, hu, hm₀, pow_succ']
      ring
    have hℓ_gt_one : (1 : ℝ) < (ℓ : ℝ) := by
      have : (2 : ℝ) ≤ (ℓ : ℝ) := by exact_mod_cast hℓ_prime.two_le
      linarith
    have hnorm_lt : ‖1 - C.det‖ < 1 := by
      rw [hsub_eq, norm_mul, PadicInt.norm_p]
      calc (ℓ : ℝ)⁻¹ * ‖-((ℓ : PadicInt ℓ) ^ m₀ * u)‖
          ≤ (ℓ : ℝ)⁻¹ * 1 :=
            mul_le_mul_of_nonneg_left (PadicInt.norm_le_one _) (by positivity)
        _ = (ℓ : ℝ)⁻¹ := mul_one _
        _ < 1 := inv_lt_one_of_one_lt₀ hℓ_gt_one
    have hnorm_eq : ‖C.det‖ = 1 := by
      apply le_antisymm (PadicInt.norm_le_one C.det)
      have htri : ‖C.det + (1 - C.det)‖ ≤ max ‖C.det‖ ‖1 - C.det‖ :=
        PadicInt.nonarchimedean C.det (1 - C.det)
      rw [add_sub_cancel, norm_one] at htri
      rcases le_max_iff.mp htri with h1 | h2
      · exact h1
      · linarith
    exact (Matrix.isUnit_iff_isUnit_det C).mpr (PadicInt.isUnit_iff.mpr hnorm_eq)

  have hCayley : ∀ S : Matrix (Fin M) (Fin M) (PadicInt ℓ), S.transpose = S →
      ∃ B ∈ G_geom, B.val * (1 - H₀ * S) = 1 + H₀ * S := by
    intro S hS_symm
    let X : Matrix (Fin M) (Fin M) (PadicInt ℓ) := H₀ * S
    have hφ_pow : φ ((ℓ : PadicInt ℓ) ^ r₀) = 0 := by
      rw [map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self]
    have hX_mod : X.map φ = 0 := by
      have hX_eq : X = ((ℓ : PadicInt ℓ) ^ r₀) • (J₀ * S) := Matrix.smul_mul _ J₀ S
      rw [hX_eq]
      ext i j
      simp [Matrix.map_apply, smul_eq_mul, hφ_pow]
    have h1p_mod : (1 + X).map φ = 1 := by
      change (RingHom.mapMatrix φ) (1 + X) = 1
      rw [map_add, map_one]
      change 1 + X.map φ = 1
      rw [hX_mod, add_zero]
    have h1m_mod : (1 - X).map φ = 1 := by
      change (RingHom.mapMatrix φ) (1 - X) = 1
      rw [map_sub, map_one]
      change 1 - X.map φ = 1
      rw [hX_mod, sub_zero]
    let U_p : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ := (hCongUnit (1 + X) h1p_mod).unit
    let U_m : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ := (hCongUnit (1 - X) h1m_mod).unit
    let B : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ := U_p * U_m⁻¹
    have hB_rel : B.val * (1 - X) = 1 + X := by
      change (U_p * U_m⁻¹).val * U_m.val = U_p.val
      rw [← Units.val_mul, inv_mul_cancel_right]
    have hB_mod : (B.val).map φ = 1 := by
      have h := congrArg (RingHom.mapMatrix φ) hB_rel
      rw [map_mul] at h
      change (B.val).map φ * (1 - X).map φ = (1 + X).map φ at h
      rwa [h1m_mod, h1p_mod, mul_one] at h
    have hB_sp : ((B.val).map ι_K).transpose * J * ((B.val).map ι_K) = J := by
      let B_K := (B.val).map ι_K
      let X_K := X.map ι_K
      let S_K := S.map ι_K
      let W_K := ((U_m⁻¹).val).map ι_K
      have hSK_symm : S_K.transpose = S_K := by
        dsimp [S_K]
        rw [← Matrix.transpose_map, hS_symm]
      have hXK_eq : X_K = α₀ • (J⁻¹ * S_K) := by
        change (RingHom.mapMatrix ι_K) (H₀ * S) = α₀ • (J⁻¹ * S_K)
        rw [map_mul]
        change (H₀.map ι_K) * S_K = α₀ • (J⁻¹ * S_K)
        rw [hH₀_map_K, Matrix.smul_mul]
      have hX_lie : X_K.transpose * J + J * X_K = 0 := by
        rw [hXK_eq, Matrix.transpose_smul, Matrix.transpose_mul, hSK_symm, hJinv_skew,
          Matrix.mul_neg, smul_neg, Matrix.neg_mul, Matrix.smul_mul, Matrix.mul_assoc,
          hJ_inv_mul, Matrix.mul_one, Matrix.mul_smul, ← Matrix.mul_assoc, hJ_mul_inv,
          Matrix.one_mul, neg_add_cancel]
      have hQuad : (1 + X_K).transpose * J * (1 + X_K) = (1 - X_K).transpose * J * (1 - X_K) := by
        have hL_exp : (1 + X_K).transpose * J * (1 + X_K) = J + X_K.transpose * J * X_K := by
          rw [Matrix.transpose_add, Matrix.transpose_one, add_mul, one_mul, mul_add, mul_one, add_mul]
          calc J + X_K.transpose * J + (J * X_K + X_K.transpose * J * X_K)
              = J + (X_K.transpose * J + J * X_K) + X_K.transpose * J * X_K := by abel
            _ = J + X_K.transpose * J * X_K := by rw [hX_lie, add_zero]
        have hR_exp : (1 - X_K).transpose * J * (1 - X_K) = J + X_K.transpose * J * X_K := by
          rw [Matrix.transpose_sub, Matrix.transpose_one, sub_mul, one_mul, mul_sub, mul_one, sub_mul]
          calc J - X_K.transpose * J - (J * X_K - X_K.transpose * J * X_K)
              = J - (X_K.transpose * J + J * X_K) + X_K.transpose * J * X_K := by abel
            _ = J + X_K.transpose * J * X_K := by rw [hX_lie, sub_zero]
        rw [hL_exp, hR_exp]
      have hBK_eq : B_K = (1 + X_K) * W_K := by
        have hb : B.val = (1 + X) * (U_m⁻¹).val := rfl
        have hm := congrArg (RingHom.mapMatrix ι_K) hb
        rw [map_mul, map_add, map_one] at hm
        exact hm
      have h1m_WK : (1 - X_K) * W_K = 1 := by
        have hm1 : (1 - X) * (U_m⁻¹).val = 1 := U_m.mul_inv
        have hm := congrArg (RingHom.mapMatrix ι_K) hm1
        rw [map_mul, map_sub, map_one] at hm
        exact hm
      have hWK_tr_1m : W_K.transpose * (1 - X_K).transpose = 1 := by
        have ht := congrArg Matrix.transpose h1m_WK
        rwa [Matrix.transpose_mul, Matrix.transpose_one] at ht
      change B_K.transpose * J * B_K = J
      calc B_K.transpose * J * B_K
          = (W_K.transpose * (1 + X_K).transpose) * J * ((1 + X_K) * W_K) := by
              rw [hBK_eq, Matrix.transpose_mul]
        _ = W_K.transpose * ((1 + X_K).transpose * J * (1 + X_K)) * W_K := by
              simp only [Matrix.mul_assoc]
        _ = W_K.transpose * ((1 - X_K).transpose * J * (1 - X_K)) * W_K := by
              rw [hQuad]
        _ = (W_K.transpose * (1 - X_K).transpose) * J * ((1 - X_K) * W_K) := by
              simp only [Matrix.mul_assoc]
        _ = J := by rw [hWK_tr_1m, h1m_WK, Matrix.one_mul, Matrix.mul_one]
    exact ⟨B, hCong B hB_mod hB_sp, hB_rel⟩

  
  let A_L : Matrix (Fin M) (Fin M) L := A₁.map ι_L
  let H_L : Matrix (Fin M) (Fin M) L := H₀.map ι_L
  have hHL_eq_map : H_L = (H₀.map ι_K).map (algebraMap K L) := by
    ext i j
    simp only [H_L, ι_L, ι_K, Matrix.map_apply, ← IsScalarTower.algebraMap_apply (PadicInt ℓ) K L]
  have hHL_det : H_L.det ≠ 0 := by
    rw [hHL_eq_map]
    change ((RingHom.mapMatrix (algebraMap K L)) (H₀.map ι_K)).det ≠ 0
    rw [← RingHom.map_det]
    intro h0
    exact hH₀_det_K ((algebraMap K L).injective (h0.trans (map_zero _).symm))

  
  let P_fn (δ : L) : Matrix (Fin M) (Fin M) L := Matrix.scalar (Fin M) δ - A_L
  let Q_fn (δ : L) : Matrix (Fin M) (Fin M) L := (Matrix.scalar (Fin M) δ + A_L) * H_L
  let E_mat (p q : Fin M) : Matrix (Fin M) (Fin M) L :=
    Matrix.of fun a b => if a = p then (if b = q then 1 else 0) else 0
  have hE_tr : ∀ p q : Fin M, (E_mat p q).transpose = E_mat q p := by
    intro p q
    ext a b
    by_cases hap : b = p <;> by_cases hbq : a = q <;> simp [E_mat, hap, hbq]
  have hE_dot : ∀ (u z : Fin M → L) (p q : Fin M),
      dotProduct u ((E_mat p q).mulVec z) = u p * z q := by
    intro u z p q
    have hmv : (E_mat p q).mulVec z = fun a => if a = p then z q else 0 := by
      ext a
      by_cases hap : a = p <;> simp [E_mat, Matrix.mulVec, dotProduct, hap]
    rw [hmv]
    simp [dotProduct]

  have hSingle : ∀ δ : L, δ ≠ 0 →
      ∃ Y : Matrix (Fin M) (Fin M) L, Y.transpose = Y ∧ (P_fn δ - Q_fn δ * Y).det ≠ 0 := by
    intro δ hδ
    let P := P_fn δ
    let Q := Q_fn δ
    have hScal_tr : (Matrix.scalar (Fin M) δ).transpose = Matrix.scalar (Fin M) δ := by
      ext a b
      by_cases hab : a = b <;> simp [Matrix.scalar_apply, hab, eq_comm]
    have hScal_mv : ∀ v : Fin M → L, (Matrix.scalar (Fin M) δ).mulVec v = δ • v := by
      intro v
      ext a
      simp [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.mulVec, dotProduct]
    have hInd : ∀ (r : ℕ) (Y : Matrix (Fin M) (Fin M) L), Y.transpose = Y →
        Module.finrank L ↥(LinearMap.ker (P - Q * Y).mulVecLin) = r →
        ∃ Y_fin : Matrix (Fin M) (Fin M) L, Y_fin.transpose = Y_fin ∧ (P - Q * Y_fin).det ≠ 0 := by
      intro r
      induction r using Nat.strong_induction_on with
      | h r ih =>
        intro Y hY_symm hr
        let R := P - Q * Y
        let K₀ := LinearMap.ker R.mulVecLin
        rcases Nat.eq_zero_or_pos r with rfl | hr_pos
        · have hK₀_bot : K₀ = ⊥ := (Submodule.finrank_eq_zero (R := L) (M := Fin M → L) (S := K₀)).mp hr
          refine ⟨Y, hY_symm, ?_⟩
          intro hdet0
          obtain ⟨z, hz_ne, hz_mul⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet0
          have hz_mem : z ∈ K₀ := by
            rw [LinearMap.mem_ker, Matrix.mulVecLin_apply]
            exact hz_mul
          rw [hK₀_bot, Submodule.mem_bot] at hz_mem
          exact hz_ne hz_mem
        · have hK₀_ne_bot : K₀ ≠ ⊥ := by
            intro hbot
            have h0 : Module.finrank L ↥K₀ = 0 := Submodule.finrank_eq_zero.mpr hbot
            rw [hr] at h0
            omega
          obtain ⟨z, hz_mem, hz_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hK₀_ne_bot
          have hz_mul : R.mulVec z = 0 := by
            rwa [LinearMap.mem_ker, Matrix.mulVecLin_apply] at hz_mem
          have hR_det0 : R.det = 0 := Matrix.exists_mulVec_eq_zero_iff.mp ⟨z, hz_ne, hz_mul⟩
          have hRtr_det0 : R.transpose.det = 0 := by rw [Matrix.det_transpose, hR_det0]
          obtain ⟨w, hw_ne, hw_mul⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hRtr_det0
          let u : Fin M → L := Q.transpose.mulVec w
          have hu_ne : u ≠ 0 := by
            intro hu0
            have hPtr_w : P.transpose.mulVec w = 0 := by
              have hRtr_eq : R.transpose = P.transpose - Y.transpose * Q.transpose := by
                dsimp [R]
                rw [Matrix.transpose_sub, Matrix.transpose_mul]
              have h0 := hw_mul
              rw [hRtr_eq, Matrix.sub_mulVec, ← Matrix.mulVec_mulVec] at h0
              change P.transpose.mulVec w - Y.transpose.mulVec u = 0 at h0
              rw [hu0, Matrix.mulVec_zero, sub_zero] at h0
              exact h0
            have hAtr_w : A_L.transpose.mulVec w = δ • w := by
              change (Matrix.scalar (Fin M) δ - A_L).transpose.mulVec w = 0 at hPtr_w
              rw [Matrix.transpose_sub, hScal_tr, Matrix.sub_mulVec, hScal_mv, sub_eq_zero] at hPtr_w
              exact hPtr_w.symm
            have hQtr_eq : Q.transpose.mulVec w = H_L.transpose.mulVec ((2 * δ) • w) := by
              change ((Matrix.scalar (Fin M) δ + A_L) * H_L).transpose.mulVec w =
                H_L.transpose.mulVec ((2 * δ) • w)
              rw [Matrix.transpose_mul, Matrix.transpose_add, hScal_tr, ← Matrix.mulVec_mulVec,
                Matrix.add_mulVec, hScal_mv, hAtr_w, ← add_smul, ← two_mul]
            have hHtr_zero : H_L.transpose.mulVec ((2 * δ) • w) = 0 := hQtr_eq.symm.trans hu0
            have h2δw_zero : (2 * δ) • w = 0 := by
              by_contra h_ne
              have hdet_tr0 : H_L.transpose.det = 0 :=
                Matrix.exists_mulVec_eq_zero_iff.mp ⟨(2 * δ) • w, h_ne, hHtr_zero⟩
              rw [Matrix.det_transpose] at hdet_tr0
              exact hHL_det hdet_tr0
            have h2δ_ne : (2 : L) * δ ≠ 0 := mul_ne_zero (two_ne_zero (α := L)) hδ
            exact hw_ne ((smul_eq_zero.mp h2δw_zero).resolve_left h2δ_ne)

          have hZ₀_exists : ∃ Z₀ : Matrix (Fin M) (Fin M) L,
              Z₀.transpose = Z₀ ∧ dotProduct w ((Q * Z₀).mulVec z) ≠ 0 := by
            by_cases h_ov : ∃ k : Fin M, u k ≠ 0 ∧ z k ≠ 0
            · rcases h_ov with ⟨k, huk, hzk⟩
              refine ⟨E_mat k k + E_mat k k, by rw [Matrix.transpose_add, hE_tr, add_comm], ?_⟩
              rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose]
              change dotProduct u ((E_mat k k + E_mat k k).mulVec z) ≠ 0
              rw [Matrix.add_mulVec, dotProduct_add, hE_dot, ← two_mul]
              exact mul_ne_zero (two_ne_zero (α := L)) (mul_ne_zero huk hzk)
            · obtain ⟨i, hui⟩ := Function.ne_iff.mp hu_ne
              obtain ⟨j, hzj⟩ := Function.ne_iff.mp hz_ne
              have huj : u j = 0 := by
                by_contra huj_ne
                exact h_ov ⟨j, huj_ne, hzj⟩
              refine ⟨E_mat i j + E_mat j i, by rw [Matrix.transpose_add, hE_tr, hE_tr, add_comm], ?_⟩
              rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose]
              change dotProduct u ((E_mat i j + E_mat j i).mulVec z) ≠ 0
              rw [Matrix.add_mulVec, dotProduct_add, hE_dot, hE_dot, huj, zero_mul, add_zero]
              exact mul_ne_zero hui hzj

          rcases hZ₀_exists with ⟨Z₀, hZ₀_symm, hα_ne⟩
          let M₀ : Matrix (Fin M) (Fin M) L := Q * Z₀
          let y₀ : Fin M → L := M₀.mulVec z
          let α : L := dotProduct w y₀
          have hw_R : ∀ x : Fin M → L, dotProduct w (R.mulVec x) = 0 := by
            intro x
            rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hw_mul, zero_dotProduct]
          obtain ⟨V₁, hCompl⟩ := Submodule.exists_isCompl K₀
          let f : V₁ →ₗ[L] (Fin M → L) := R.mulVecLin.comp V₁.subtype
          have hf_ker : LinearMap.ker f = ⊥ := by
            rw [Submodule.eq_bot_iff]
            intro v hv
            have hvK : v.1 ∈ K₀ := by rwa [LinearMap.mem_ker] at hv
            have hv0 : v.1 ∈ K₀ ⊓ V₁ := ⟨hvK, v.2⟩
            rw [hCompl.inf_eq_bot, Submodule.mem_bot] at hv0
            exact Subtype.ext hv0
          obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective f hf_ker
          have hg_apply : ∀ v : V₁, g (R.mulVec v.1) = v := fun v => LinearMap.congr_fun hg v
          let ℓ_w : (Fin M → L) →ₗ[L] L :=
            { toFun := fun x => dotProduct w x
              map_add' := fun x y => dotProduct_add w x y
              map_smul' := fun c x => by simp [dotProduct_smul, smul_eq_mul] }
          let π_w : (Fin M → L) →ₗ[L] (Fin M → L) :=
            LinearMap.id - (α⁻¹ • ℓ_w).smulRight y₀
          let E : Module.End L V₁ := g.comp (π_w.comp (M₀.mulVecLin.comp V₁.subtype))
          have hpE_ne : (LinearMap.charpoly E) ≠ 0 := (LinearMap.charpoly_monic E).ne_zero
          obtain ⟨μ, hμ_notMem⟩ :=
            Infinite.exists_notMem_finset (insert (0 : L) (LinearMap.charpoly E).roots.toFinset)
          have hμ_ne : μ ≠ 0 := fun h0 => hμ_notMem (Finset.mem_insert.mpr (Or.inl h0))
          have hμ_notRoot : ¬ (LinearMap.charpoly E).IsRoot μ := by
            intro hroot
            apply hμ_notMem
            rw [Finset.mem_insert, Multiset.mem_toFinset, Polynomial.mem_roots hpE_ne]
            exact Or.inr hroot
          let t : L := μ⁻¹
          have ht_ne : t ≠ 0 := inv_ne_zero hμ_ne
          let R' : Matrix (Fin M) (Fin M) L := R - t • M₀
          let ι_prod : (V₁ × L) →ₗ[L] (Fin M → L) :=
            V₁.subtype.coprod ((LinearMap.id : L →ₗ[L] L).smulRight z)
          let Ψ : (V₁ × L) →ₗ[L] (Fin M → L) := R'.mulVecLin.comp ι_prod
          have hΨ_inj : Function.Injective Ψ := by
            rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
            rintro ⟨v, c⟩ hvc
            rw [LinearMap.mem_ker] at hvc
            have h_eq0 : R'.mulVec (v.1 + c • z) = 0 := hvc
            have h_eq1 : R.mulVec v.1 = t • (M₀.mulVec v.1 + c • y₀) := by
              dsimp [R', y₀] at h_eq0 ⊢
              rw [Matrix.sub_mulVec, Matrix.smul_mulVec, Matrix.mulVec_add, Matrix.mulVec_smul,
                hz_mul, smul_zero, add_zero, Matrix.mulVec_add, Matrix.mulVec_smul, sub_eq_zero] at h_eq0
              exact h_eq0
            have h_dot := congrArg (dotProduct w) h_eq1
            rw [hw_R v.1, dotProduct_smul, dotProduct_add, dotProduct_smul, smul_eq_mul,
              smul_eq_mul] at h_dot
            change 0 = t * (dotProduct w (M₀.mulVec v.1) + c * α) at h_dot
            have h_sum0 : dotProduct w (M₀.mulVec v.1) + c * α = 0 :=
              (mul_eq_zero.mp h_dot.symm).resolve_left ht_ne
            have hc_eq : c = -(α⁻¹ * dotProduct w (M₀.mulVec v.1)) := by
              have h1 : c * α = -dotProduct w (M₀.mulVec v.1) :=
                eq_neg_of_add_eq_zero_right h_sum0
              calc c = (c * α) * α⁻¹ := by rw [mul_assoc, mul_inv_cancel₀ hα_ne, mul_one]
                _ = -dotProduct w (M₀.mulVec v.1) * α⁻¹ := by rw [h1]
                _ = -(α⁻¹ * dotProduct w (M₀.mulVec v.1)) := by ring
            have h_eq2 : R.mulVec v.1 = t • π_w (M₀.mulVec v.1) := by
              rw [h_eq1, hc_eq]
              dsimp [π_w, ℓ_w]
              rw [neg_smul, sub_eq_add_neg]
            have hv_tE : v = t • E v := by
              have hg_eq := congrArg g h_eq2
              rw [hg_apply v, map_smul] at hg_eq
              exact hg_eq
            have hEv : E v = μ • v := by
              calc E v = (μ * t) • E v := by dsimp [t]; rw [mul_inv_cancel₀ hμ_ne, one_smul]
                _ = μ • (t • E v) := mul_smul μ t (E v)
                _ = μ • v := by rw [← hv_tE]
            have hv0 : v = 0 := by
              by_contra hv_ne
              apply hμ_notRoot
              rw [← Module.End.hasEigenvalue_iff_isRoot_charpoly]
              intro h_bot
              apply hv_ne
              rw [← Submodule.mem_bot (R := L), ← h_bot, Module.End.mem_eigenspace_iff]
              exact hEv
            have hc0 : c = 0 := by
              rw [hc_eq, hv0, Submodule.coe_zero, Matrix.mulVec_zero, dotProduct_zero,
                mul_zero, neg_zero]
            exact Prod.ext hv0 hc0
          let Ψ_cod : (V₁ × L) →ₗ[L] ↥(LinearMap.range R'.mulVecLin) :=
            Ψ.codRestrict (LinearMap.range R'.mulVecLin) (fun x => ⟨ι_prod x, rfl⟩)
          have hΨ_cod_inj : Function.Injective Ψ_cod :=
            fun x y hxy => hΨ_inj (congrArg Subtype.val hxy)
          have h_le : Module.finrank L (V₁ × L) ≤ Module.finrank L ↥(LinearMap.range R'.mulVecLin) :=
            LinearMap.finrank_le_finrank_of_injective hΨ_cod_inj
          rw [Module.finrank_prod, Module.finrank_self] at h_le
          have h_compl_dim := Submodule.finrank_add_eq_of_isCompl hCompl
          have h_rk_null := LinearMap.finrank_range_add_finrank_ker R'.mulVecLin
          have hr'_lt : Module.finrank L ↥(LinearMap.ker R'.mulVecLin) < r := by
            change Module.finrank L ↥K₀ = r at hr
            omega
          let Y' : Matrix (Fin M) (Fin M) L := Y + t • Z₀
          have hY'_symm : Y'.transpose = Y' := by
            dsimp [Y']
            rw [Matrix.transpose_add, Matrix.transpose_smul, hY_symm, hZ₀_symm]
          have hR'_eq : P - Q * Y' = R' := by
            dsimp [Y', R', R, M₀]
            rw [Matrix.mul_add, Matrix.mul_smul, sub_add_eq_sub_sub]
          rw [← hR'_eq] at hr'_lt
          exact ih _ hr'_lt Y' hY'_symm rfl
    exact hInd _ 0 Matrix.transpose_zero rfl

  
  let σ := Fin M × Fin M
  let S_gen : Matrix (Fin M) (Fin M) (MvPolynomial σ L) :=
    Matrix.of fun i j => MvPolynomial.X (i, j) + MvPolynomial.X (j, i)
  let F (δ : L) : MvPolynomial σ L :=
    ((P_fn δ).map MvPolynomial.C - (Q_fn δ).map MvPolynomial.C * S_gen).det
  have hF_eval : ∀ (δ : L) (y : σ → L),
      MvPolynomial.eval y (F δ) =
        (P_fn δ - Q_fn δ * Matrix.of (fun i j => y (i, j) + y (j, i))).det := by
    intro δ y
    dsimp [F]
    rw [RingHom.map_det (MvPolynomial.eval y)]
    congr 1
    rw [map_sub, map_mul]
    congr 1
    · ext i j
      simp [RingHom.mapMatrix_apply, Matrix.map_apply]
    · congr 1
      · ext i j
        simp [RingHom.mapMatrix_apply, Matrix.map_apply]
      · ext i j
        simp [S_gen, RingHom.mapMatrix_apply, Matrix.map_apply]
  have hF_ne : ∀ δ ∈ δ_list, F δ ≠ 0 := by
    intro δ hδ_mem hF0
    obtain ⟨Y, hY_symm, hY_det⟩ := hSingle δ (hδ_ne δ hδ_mem)
    let y : σ → L := fun p => (2 : L)⁻¹ * Y p.1 p.2
    have hy_eval := hF_eval δ y
    rw [hF0, map_zero] at hy_eval
    have hY_rec : Matrix.of (fun i j => y (i, j) + y (j, i)) = Y := by
      ext i j
      have hji : Y j i = Y i j := congrFun (congrFun hY_symm i) j
      dsimp [y]
      rw [hji, ← add_mul]
      have hhalf : (2 : L)⁻¹ + (2 : L)⁻¹ = 1 := by
        have h2 : (2 : L) ≠ 0 := two_ne_zero
        calc (2 : L)⁻¹ + (2 : L)⁻¹ = (2 : L) * (2 : L)⁻¹ := (two_mul _).symm
          _ = 1 := mul_inv_cancel₀ h2
      rw [hhalf, one_mul]
    rw [hY_rec] at hy_eval
    exact hY_det hy_eval.symm
  let F_tot : MvPolynomial σ L := (δ_list.map F).prod
  have hF_tot_ne : F_tot ≠ 0 := by
    apply List.prod_ne_zero
    rw [List.mem_map]
    rintro ⟨δ, hδ_mem, h0⟩
    exact hF_ne δ hδ_mem h0
  let s₀ : Set L := Set.range (Nat.cast : ℕ → L)
  have hs₀_inf : s₀.Infinite := Set.infinite_range_of_injective (Nat.cast_injective (R := L))
  have h_exists_pt : ∃ x : σ → L, (∀ p : σ, x p ∈ s₀) ∧ MvPolynomial.eval x F_tot ≠ 0 := by
    by_contra h_none
    apply hF_tot_ne
    apply MvPolynomial.funext_set (fun _ : σ => s₀) (fun _ => hs₀_inf)
    intro x hx
    rw [map_zero]
    by_contra hx_ne
    exact h_none ⟨x, fun p => hx p (Set.mem_univ p), hx_ne⟩
  rcases h_exists_pt with ⟨x, hx_mem, hx_eval⟩
  let k_coord : σ → ℕ := fun p => (hx_mem p).choose
  have hk_coord : ∀ p : σ, (k_coord p : L) = x p := fun p => (hx_mem p).choose_spec
  let n_mat : Fin M → Fin M → ℕ := fun i j => k_coord (i, j) + k_coord (j, i)

  
  let S : Matrix (Fin M) (Fin M) (PadicInt ℓ) := Matrix.of fun i j => (n_mat i j : PadicInt ℓ)
  have hS_symm : S.transpose = S := by
    ext i j
    dsimp [S, n_mat]
    congr 1
    exact Nat.add_comm _ _
  obtain ⟨B, hB_mem, hB_rel⟩ := hCayley S hS_symm
  let B_L := (B.val).map ι_L
  let S_L := S.map ι_L
  have hSL_eq : S_L = Matrix.of (fun i j => (n_mat i j : L)) := by
    ext i j
    simp [S_L, S]
  have hBL_rel : B_L * (1 - H_L * S_L) = 1 + H_L * S_L := by
    have h := congrArg (RingHom.mapMatrix ι_L) hB_rel
    simpa only [map_mul, map_sub, map_add, map_one, RingHom.mapMatrix_apply] using h
  have hAB_map : (A₁ * B.val).map ι_L = A_L * B_L := by
    change (RingHom.mapMatrix ι_L) (A₁ * B.val) = A_L * B_L
    rw [map_mul]
    rfl
  refine ⟨B, hB_mem, fun δ hδ_mem => ?_⟩
  have hFδ_dvd : F δ ∣ F_tot := List.dvd_prod (List.mem_map_of_mem (f := F) hδ_mem)
  rcases hFδ_dvd with ⟨G, hG⟩
  have heval_ne : MvPolynomial.eval x (F δ) ≠ 0 := by
    intro he0
    apply hx_eval
    rw [hG, map_mul, he0, zero_mul]
  rw [hF_eval] at heval_ne
  have hSL_x : Matrix.of (fun i j => x (i, j) + x (j, i)) = S_L := by
    rw [hSL_eq]
    ext i j
    simp [n_mat, Nat.cast_add, hk_coord]
  rw [hSL_x] at heval_ne
  have hMat_id : (Matrix.scalar (Fin M) δ - A_L * B_L) * (1 - H_L * S_L) = P_fn δ - Q_fn δ * S_L := by
    calc (Matrix.scalar (Fin M) δ - A_L * B_L) * (1 - H_L * S_L)
        = Matrix.scalar (Fin M) δ * (1 - H_L * S_L) - A_L * (B_L * (1 - H_L * S_L)) := by
            rw [sub_mul, Matrix.mul_assoc]
      _ = Matrix.scalar (Fin M) δ * (1 - H_L * S_L) - A_L * (1 + H_L * S_L) := by
            rw [hBL_rel]
      _ = (Matrix.scalar (Fin M) δ - Matrix.scalar (Fin M) δ * (H_L * S_L)) -
            (A_L + A_L * (H_L * S_L)) := by
            rw [mul_sub, mul_one, mul_add, mul_one]
      _ = (Matrix.scalar (Fin M) δ - A_L) -
            (Matrix.scalar (Fin M) δ * (H_L * S_L) + A_L * (H_L * S_L)) := by
            abel
      _ = P_fn δ - Q_fn δ * S_L := by
            dsimp [P_fn, Q_fn]
            rw [← add_mul, Matrix.mul_assoc]
  have hDet_id := congrArg Matrix.det hMat_id
  rw [Matrix.det_mul, ← hAB_map, ← Matrix.eval_charpoly] at hDet_id
  exact left_ne_zero_of_mul (hDet_id.symm ▸ heval_ne)

theorem weil_padic_unit_periodic_charpoly_avoidance (ℓ M : ℕ) [Fact (Nat.Prime ℓ)] (hM : 1 ≤ M)
    (A₁ B₀ : Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (hA₁_unit : IsUnit A₁) (hB₀_unit : IsUnit B₀)
    (δ_list : List (AlgebraicClosure (Padic ℓ)))
    (hδ_ne : ∀ δ ∈ δ_list, δ ≠ 0)
    (hB₀_avoid : ∀ δ ∈ δ_list,
      (((A₁ * B₀).map
        (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))).charpoly).eval δ ≠ 0) :
    ∃ k P_per : ℕ, 1 ≤ k ∧ 1 ≤ P_per ∧
      ∀ (m : ℕ) (C : Matrix (Fin M) (Fin M) (PadicInt ℓ)),
        IsUnit C →
        (C.map (PadicInt.toZModPow k)).charpoly =
          (((A₁ ^ (1 + m * P_per)) * B₀).map (PadicInt.toZModPow k)).charpoly →
        ∀ δ ∈ δ_list,
          ¬ ((1 - Polynomial.C (δ ^ (1 + m * P_per)) * Polynomial.X) ∣
            (C.map (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))).charpolyRev) :=
by
  classical
  let L := AlgebraicClosure (Padic ℓ)
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_ne_zero : ℓ ≠ 0 := hℓ_prime.ne_zero
  have hℓ_padic_ne : (ℓ : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hℓ_ne_zero
  have hℓ_L_ne : (ℓ : L) ≠ 0 := Nat.cast_ne_zero.mpr hℓ_ne_zero
  have h_s2 : ∀ (d : ℕ), 1 ≤ d →
      ∀ (C : Matrix (Fin M) (Fin M) (PadicInt ℓ)), IsUnit C →
      ∀ (δ : L), δ ≠ 0 →
      (1 - Polynomial.C (δ ^ d) * Polynomial.X) ∣
        (C.map (algebraMap (PadicInt ℓ) L)).charpolyRev →
      Polynomial.aeval (δ ^ d) C.charpoly = 0 ∧
        IsIntegral (PadicInt ℓ) δ ∧ IsIntegral (PadicInt ℓ) δ⁻¹ := by
    intro d hd C hC δ hδ hdvd
    set u : L := δ ^ d
    have hu : u ≠ 0 := pow_ne_zero d hδ
    letI : Invertible u := invertibleOfNonzero hu
    have hdvd_eval :
        (1 - Polynomial.C u * Polynomial.X).eval (u⁻¹) ∣
          ((C.map (algebraMap (PadicInt ℓ) L)).charpolyRev).eval (u⁻¹) :=
      Polynomial.eval_dvd hdvd
    have hlhs_zero : (1 - Polynomial.C u * Polynomial.X).eval (u⁻¹) = 0 := by
      rw [Polynomial.eval_sub, Polynomial.eval_one, Polynomial.eval_mul,
        Polynomial.eval_C, Polynomial.eval_X, mul_inv_cancel₀ hu, sub_self]
    rw [hlhs_zero, zero_dvd_iff] at hdvd_eval
    have hrev_L :
        Polynomial.eval₂ (RingHom.id L) (⅟u)
          ((C.map (algebraMap (PadicInt ℓ) L)).charpoly).reverse = 0 := by
      rw [Matrix.reverse_charpoly, invOf_eq_inv]
      exact hdvd_eval
    have heval_L : ((C.map (algebraMap (PadicInt ℓ) L)).charpoly).eval u = 0 :=
      (Polynomial.eval₂_reverse_eq_zero_iff (RingHom.id L) u _).mp hrev_L
    have haeval_C : Polynomial.aeval u C.charpoly = 0 := by
      rw [Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def] at heval_L
      exact heval_L
    have hu_int : IsIntegral (PadicInt ℓ) (δ ^ d) :=
      ⟨C.charpoly, Matrix.charpoly_monic C, haeval_C⟩
    have hδ_int : IsIntegral (PadicInt ℓ) δ := IsIntegral.of_pow hd hu_int
    have hrev_R : Polynomial.aeval (u⁻¹) C.charpolyRev = 0 := by
      rw [Polynomial.aeval_def, ← Matrix.reverse_charpoly, ← invOf_eq_inv]
      exact (Polynomial.eval₂_reverse_eq_zero_iff (algebraMap (PadicInt ℓ) L) u C.charpoly).mpr
        (by rwa [← Polynomial.aeval_def])
    have haeval_Cinv : Polynomial.aeval ((δ⁻¹) ^ d) (C⁻¹).charpoly = 0 := by
      rw [inv_pow, Matrix.charpoly_inv C hC, map_mul, hrev_R, mul_zero]
    have hu_inv_int : IsIntegral (PadicInt ℓ) ((δ⁻¹) ^ d) :=
      ⟨(C⁻¹).charpoly, Matrix.charpoly_monic (C⁻¹), haeval_Cinv⟩
    exact ⟨haeval_C, hδ_int, IsIntegral.of_pow hd hu_inv_int⟩
  have hinj_ι : Function.Injective (algebraMap (PadicInt ℓ) L) := by
    rw [IsScalarTower.algebraMap_eq (PadicInt ℓ) (Padic ℓ) L]
    exact (algebraMap (Padic ℓ) L).injective.comp
      (IsFractionRing.injective (PadicInt ℓ) (Padic ℓ))
  have h_not_int_inv : ¬ IsIntegral (PadicInt ℓ) ((ℓ : L)⁻¹) := by
    rintro ⟨p, hp_monic, hp_eval⟩
    let x : Padic ℓ := (ℓ : Padic ℓ)⁻¹
    have hx_map : algebraMap (Padic ℓ) L x = (ℓ : L)⁻¹ := by
      dsimp [x]
      rw [map_inv₀, map_natCast]
    have hx_eval_L : algebraMap (Padic ℓ) L (Polynomial.aeval x p) = 0 := by
      have htower := Polynomial.aeval_algHom_apply
        (IsScalarTower.toAlgHom (PadicInt ℓ) (Padic ℓ) L) x p
      change Polynomial.aeval (algebraMap (Padic ℓ) L x) p =
        algebraMap (Padic ℓ) L (Polynomial.aeval x p) at htower
      rw [← htower, hx_map]
      exact hp_eval
    have hx_eval : Polynomial.aeval x p = 0 :=
      (algebraMap (Padic ℓ) L).injective (hx_eval_L.trans (map_zero _).symm)
    have hx_int : IsIntegral (PadicInt ℓ) x := ⟨p, hp_monic, hx_eval⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hx_int
    have hy_mul : algebraMap (PadicInt ℓ) (Padic ℓ) (y * (ℓ : PadicInt ℓ)) =
        algebraMap (PadicInt ℓ) (Padic ℓ) 1 := by
      rw [map_mul, hy, map_natCast, map_one]
      exact inv_mul_cancel₀ hℓ_padic_ne
    have hy_one : y * (ℓ : PadicInt ℓ) = 1 :=
      IsFractionRing.injective (PadicInt ℓ) (Padic ℓ) hy_mul
    have h_unit : IsUnit (ℓ : PadicInt ℓ) :=
      ⟨⟨(ℓ : PadicInt ℓ), y, by rw [mul_comm, hy_one], hy_one⟩, rfl⟩
    have h_norm : ‖(ℓ : PadicInt ℓ)‖ = 1 := PadicInt.isUnit_iff.mp h_unit
    rw [PadicInt.norm_p] at h_norm
    have hℓ_ge2 : (2 : ℝ) ≤ (ℓ : ℝ) := by exact_mod_cast hℓ_prime.two_le
    have hℓ_real_ne : (ℓ : ℝ) ≠ 0 := by positivity
    have h1 := congrArg ((ℓ : ℝ) * ·) h_norm
    rw [mul_inv_cancel₀ hℓ_real_ne, mul_one] at h1
    linarith
  have h_strip : ∀ (y : L), IsIntegral (PadicInt ℓ) y → y ≠ 0 →
      ∀ (n : ℕ) (f : Polynomial (PadicInt ℓ)),
        f.natDegree ≤ n → f ≠ 0 → Polynomial.aeval y f = 0 →
        ∃ (c₀ : PadicInt ℓ) (w₀ : L),
          c₀ ≠ 0 ∧ IsIntegral (PadicInt ℓ) w₀ ∧
            y * w₀ = algebraMap (PadicInt ℓ) L c₀ := by
    intro y hy_int hy_ne n
    induction n with
    | zero =>
      intro f hf_deg hf_ne hf_eval
      have hf_deg0 : f.natDegree = 0 := Nat.eq_zero_of_le_zero hf_deg
      have hf_eq : f = Polynomial.C (f.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hf_deg0
      have hc0_ne : f.coeff 0 ≠ 0 := by
        intro hc0
        rw [hc0, map_zero] at hf_eq
        exact hf_ne hf_eq
      rw [hf_eq, Polynomial.aeval_C] at hf_eval
      exact absurd (hinj_ι (hf_eval.trans (map_zero _).symm)) hc0_ne
    | succ n ih =>
      intro f hf_deg hf_ne hf_eval
      have hdiv := congrArg (Polynomial.aeval y) (Polynomial.X_mul_divX_add f)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hf_eval] at hdiv
      by_cases hc0 : f.coeff 0 = 0
      · rw [hc0, map_zero, add_zero] at hdiv
        have hdiv_eval : Polynomial.aeval y f.divX = 0 :=
          (mul_eq_zero.mp hdiv).resolve_left hy_ne
        have hdiv_ne : f.divX ≠ 0 := by
          intro h0
          have hf0 := (Polynomial.X_mul_divX_add f).symm
          rw [h0, mul_zero, hc0, map_zero, add_zero] at hf0
          exact hf_ne hf0
        have hdiv_deg : f.divX.natDegree ≤ n := by
          rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
          omega
        exact ih f.divX hdiv_deg hdiv_ne hdiv_eval
      · let y_sub : integralClosure (PadicInt ℓ) L :=
          ⟨y, (mem_integralClosure_iff (PadicInt ℓ) L).mpr hy_int⟩
        let w_sub : integralClosure (PadicInt ℓ) L := -Polynomial.aeval y_sub f.divX
        have hw_val : (w_sub : L) = -Polynomial.aeval y f.divX := by
          change -((integralClosure (PadicInt ℓ) L).val (Polynomial.aeval y_sub f.divX)) =
            -Polynomial.aeval y f.divX
          rw [← Polynomial.aeval_algHom_apply]
          rfl
        have hw_int : IsIntegral (PadicInt ℓ) (w_sub : L) :=
          (mem_integralClosure_iff (PadicInt ℓ) L).mp w_sub.2
        refine ⟨f.coeff 0, (w_sub : L), hc0, hw_int, ?_⟩
        rw [hw_val]
        calc y * -Polynomial.aeval y f.divX
            = algebraMap (PadicInt ℓ) L (f.coeff 0) -
                (y * Polynomial.aeval y f.divX + algebraMap (PadicInt ℓ) L (f.coeff 0)) := by
                  ring
          _ = algebraMap (PadicInt ℓ) L (f.coeff 0) := by rw [hdiv, sub_zero]
  have h_s3 : ∀ (y : L), IsIntegral (PadicInt ℓ) y → y ≠ 0 →
      ∃ r : ℕ, ∀ (k : ℕ), r + 1 ≤ k →
        ∀ (w : L), IsIntegral (PadicInt ℓ) w → y + (ℓ : L) ^ k * w ≠ 0 := by
    intro y hy_int hy_ne
    obtain ⟨f, hf_monic, hf_eval⟩ := id hy_int
    obtain ⟨c₀, w₀, hc₀_ne, hw₀_int, hyw₀⟩ :=
      h_strip y hy_int hy_ne f.natDegree f (le_refl _) hf_monic.ne_zero hf_eval
    let r : ℕ := c₀.valuation
    let u : (PadicInt ℓ)ˣ := PadicInt.unitCoeff hc₀_ne
    have hc₀_spec : c₀ = (u : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ r :=
      PadicInt.unitCoeff_spec hc₀_ne
    refine ⟨r, fun k hk w hw_int hsum => ?_⟩
    have hy_eq : y = -((ℓ : L) ^ k * w) := by
      calc y = (y + (ℓ : L) ^ k * w) - (ℓ : L) ^ k * w := by ring
        _ = -((ℓ : L) ^ k * w) := by rw [hsum, zero_sub]
    have h_prod : algebraMap (PadicInt ℓ) L (u : PadicInt ℓ) * (ℓ : L) ^ r =
        -((ℓ : L) ^ k * w * w₀) := by
      calc algebraMap (PadicInt ℓ) L (u : PadicInt ℓ) * (ℓ : L) ^ r
          = algebraMap (PadicInt ℓ) L ((u : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ r) := by
              rw [map_mul, map_pow, map_natCast]
        _ = algebraMap (PadicInt ℓ) L c₀ := by rw [← hc₀_spec]
        _ = y * w₀ := hyw₀.symm
        _ = -((ℓ : L) ^ k * w * w₀) := by rw [hy_eq]; ring
    have hk_split : k = r + 1 + (k - 1 - r) := by omega
    have h_cancel_r : (ℓ : L) ^ r * algebraMap (PadicInt ℓ) L (u : PadicInt ℓ) =
        (ℓ : L) ^ r * (-((ℓ : L) * ((ℓ : L) ^ (k - 1 - r) * w * w₀))) := by
      calc (ℓ : L) ^ r * algebraMap (PadicInt ℓ) L (u : PadicInt ℓ)
          = algebraMap (PadicInt ℓ) L (u : PadicInt ℓ) * (ℓ : L) ^ r := mul_comm _ _
        _ = -((ℓ : L) ^ k * w * w₀) := h_prod
        _ = -((ℓ : L) ^ (r + 1 + (k - 1 - r)) * w * w₀) := by rw [← hk_split]
        _ = (ℓ : L) ^ r * (-((ℓ : L) * ((ℓ : L) ^ (k - 1 - r) * w * w₀))) := by ring
    have hu_eq : algebraMap (PadicInt ℓ) L (u : PadicInt ℓ) =
        -((ℓ : L) * ((ℓ : L) ^ (k - 1 - r) * w * w₀)) :=
      mul_left_cancel₀ (pow_ne_zero r hℓ_L_ne) h_cancel_r
    have hu_inv_mul :
        algebraMap (PadicInt ℓ) L ((u⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) *
          algebraMap (PadicInt ℓ) L (u : PadicInt ℓ) = 1 := by
      rw [← map_mul, Units.inv_mul, map_one]
    let z : L := -(algebraMap (PadicInt ℓ) L ((u⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) *
      ((ℓ : L) ^ (k - 1 - r) * w * w₀))
    have hℓ_mul_z : (ℓ : L) * z = 1 := by
      calc (ℓ : L) * z
          = algebraMap (PadicInt ℓ) L ((u⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) *
              (-((ℓ : L) * ((ℓ : L) ^ (k - 1 - r) * w * w₀))) := by dsimp [z]; ring
        _ = algebraMap (PadicInt ℓ) L ((u⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) *
              algebraMap (PadicInt ℓ) L (u : PadicInt ℓ) := by rw [← hu_eq]
        _ = 1 := hu_inv_mul
    have hz_eq_inv : (ℓ : L)⁻¹ = z := by
      calc (ℓ : L)⁻¹ = (ℓ : L)⁻¹ * ((ℓ : L) * z) := by rw [hℓ_mul_z, mul_one]
        _ = ((ℓ : L)⁻¹ * (ℓ : L)) * z := by ring
        _ = z := by rw [inv_mul_cancel₀ hℓ_L_ne, one_mul]
    let IC := integralClosure (PadicInt ℓ) L
    have hz_mem : z ∈ IC := by
      dsimp [z]
      apply IC.neg_mem
      apply IC.mul_mem (IC.algebraMap_mem _)
      apply IC.mul_mem
      · apply IC.mul_mem
        · have hℓ_mem : (ℓ : L) ∈ IC := by
            rw [← map_natCast (algebraMap (PadicInt ℓ) L) ℓ]
            exact IC.algebraMap_mem _
          exact IC.pow_mem hℓ_mem (k - 1 - r)
        · exact (mem_integralClosure_iff (PadicInt ℓ) L).mpr hw_int
      · exact (mem_integralClosure_iff (PadicInt ℓ) L).mpr hw₀_int
    rw [← hz_eq_inv] at hz_mem
    exact h_not_int_inv ((mem_integralClosure_iff (PadicInt ℓ) L).mp hz_mem)
  have h_s4 : ∀ (k : ℕ), 1 ≤ k →
      ∀ (δ : L), δ ≠ 0 → IsIntegral (PadicInt ℓ) δ → IsIntegral (PadicInt ℓ) δ⁻¹ →
      ∃ m_δ : ℕ, 1 ≤ m_δ ∧
        ∀ (q : ℕ) (P P₀ : Polynomial (PadicInt ℓ)),
          P.map (PadicInt.toZModPow k) = P₀.map (PadicInt.toZModPow k) →
          ∃ w : L, IsIntegral (PadicInt ℓ) w ∧
            Polynomial.aeval (δ ^ (1 + q * m_δ)) P =
              Polynomial.aeval δ P₀ + (ℓ : L) ^ k * w := by
    intro k hk δ hδ_ne hδ_int hδ_inv_int
    haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero k hℓ_ne_zero⟩
    let S₀ : Set L := {δ, δ⁻¹}
    have hS₀_fin : S₀.Finite := (Set.finite_singleton δ⁻¹).insert δ
    have hS₀_int : ∀ x ∈ S₀, IsIntegral (PadicInt ℓ) x := by
      intro x hx
      rcases Set.mem_insert_iff.mp hx with rfl | hx'
      · exact hδ_int
      · rw [Set.mem_singleton_iff.mp hx']
        exact hδ_inv_int
    let R_δ : Subalgebra (PadicInt ℓ) L := Algebra.adjoin (PadicInt ℓ) S₀
    have hR_le : R_δ ≤ integralClosure (PadicInt ℓ) L :=
      Algebra.adjoin_le fun x hx => (mem_integralClosure_iff (PadicInt ℓ) L).mpr (hS₀_int x hx)
    haveI : Module.Finite (PadicInt ℓ) R_δ :=
      Algebra.finite_adjoin_of_finite_of_isIntegral hS₀_fin hS₀_int
    let I : Ideal R_δ := Ideal.span {(ℓ : R_δ) ^ k}
    let Q := R_δ ⧸ I
    let π : R_δ →+* Q := Ideal.Quotient.mk I
    have hℓk_Q : ((ℓ ^ k : ℕ) : Q) = 0 := by
      rw [Nat.cast_pow, ← map_natCast π ℓ, ← map_pow]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hdvd_char : ringChar Q ∣ ℓ ^ k := by
      haveI : CharP Q (ringChar Q) := ringChar.charP Q
      exact (CharP.cast_eq_zero_iff Q (ringChar Q) (ℓ ^ k)).mp hℓk_Q
    let ψ : ZMod (ℓ ^ k) →+* Q := ZMod.castHom hdvd_char Q
    let φ : PadicInt ℓ →+* Q := π.comp (algebraMap (PadicInt ℓ) R_δ)
    have hφ_eq : φ = ψ.comp (PadicInt.toZModPow k) := by
      ext z
      let a : ℕ := (PadicInt.toZModPow k z).val
      have ha_mod : (a : ZMod (ℓ ^ k)) = PadicInt.toZModPow k z := ZMod.natCast_zmod_val _
      have hz_ker : z - (a : PadicInt ℓ) ∈ RingHom.ker (PadicInt.toZModPow k) := by
        rw [RingHom.mem_ker, map_sub, map_natCast, ha_mod, sub_self]
      rw [PadicInt.ker_toZModPow k, Ideal.mem_span_singleton] at hz_ker
      rcases hz_ker with ⟨t, ht⟩
      have hz_eq : z = (a : PadicInt ℓ) + (ℓ : PadicInt ℓ) ^ k * t := by
        calc z = (a : PadicInt ℓ) + (z - (a : PadicInt ℓ)) := by ring
          _ = (a : PadicInt ℓ) + (ℓ : PadicInt ℓ) ^ k * t := by rw [ht]
      have hφ_ℓk : φ ((ℓ : PadicInt ℓ) ^ k) = 0 := by
        rw [map_pow, map_natCast, ← Nat.cast_pow]
        exact hℓk_Q
      calc φ z = φ ((a : PadicInt ℓ) + (ℓ : PadicInt ℓ) ^ k * t) := by rw [← hz_eq]
        _ = φ (a : PadicInt ℓ) + φ ((ℓ : PadicInt ℓ) ^ k) * φ t := by rw [map_add, map_mul]
        _ = (a : Q) := by rw [hφ_ℓk, zero_mul, add_zero, map_natCast]
        _ = ψ (a : ZMod (ℓ ^ k)) := (map_natCast ψ a).symm
        _ = (ψ.comp (PadicInt.toZModPow k)) z := by rw [RingHom.comp_apply, ha_mod]
    obtain ⟨S_set, hS_fin, hS_span⟩ :=
      Submodule.fg_def.mp (Module.Finite.fg_top (R := PadicInt ℓ) (M := R_δ))
    let S : Finset R_δ := hS_fin.toFinset
    have hS_span' : Submodule.span (PadicInt ℓ) (S : Set R_δ) = ⊤ := by
      rwa [Set.Finite.coe_toFinset]
    let Φ : (↥S → ZMod (ℓ ^ k)) → Q :=
      fun f => ∑ s : ↥S, ψ (f s) * π s.1
    have hΦ_surj : Function.Surjective Φ := by
      intro q₀
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q₀
      have hr_mem : r ∈ Submodule.span (PadicInt ℓ) (S : Set R_δ) := by
        rw [hS_span']
        trivial
      obtain ⟨g, -, hg_sum⟩ := Submodule.mem_span_finset.mp hr_mem
      refine ⟨fun s => PadicInt.toZModPow k (g s.1), ?_⟩
      dsimp [Φ]
      calc ∑ s ∈ S.attach, ψ (PadicInt.toZModPow k (g s.1)) * π s.1
          = ∑ s ∈ S.attach, φ (g s.1) * π s.1 := by
              refine Finset.sum_congr rfl fun s _ => ?_
              rw [hφ_eq, RingHom.comp_apply]
        _ = ∑ x ∈ S, φ (g x) * π x := Finset.sum_attach S (fun x => φ (g x) * π x)
        _ = π (∑ x ∈ S, g x • x) := by
              rw [map_sum]
              refine Finset.sum_congr rfl fun x _ => ?_
              rw [Algebra.smul_def, map_mul]
              rfl
        _ = π r := by rw [hg_sum]
    haveI : Finite Q := Finite.of_surjective Φ hΦ_surj
    haveI : Finite Qˣ := inferInstance
    let δ_R : R_δ := ⟨δ, Algebra.subset_adjoin (Set.mem_insert δ {δ⁻¹})⟩
    let δ_inv_R : R_δ :=
      ⟨δ⁻¹, Algebra.subset_adjoin (Set.mem_insert_of_mem δ (Set.mem_singleton δ⁻¹))⟩
    have hδ_mul : δ_R * δ_inv_R = 1 := Subtype.ext (mul_inv_cancel₀ hδ_ne)
    have hδ_inv_mul : δ_inv_R * δ_R = 1 := Subtype.ext (inv_mul_cancel₀ hδ_ne)
    let u_δ : Qˣ :=
      ⟨π δ_R, π δ_inv_R,
        by rw [← map_mul, hδ_mul, map_one],
        by rw [← map_mul, hδ_inv_mul, map_one]⟩
    let m_δ : ℕ := Nat.card Qˣ
    have hm_δ_pos : 1 ≤ m_δ := Nat.card_pos
    have hu_pow_card : u_δ ^ m_δ = 1 := pow_card_eq_one'
    refine ⟨m_δ, hm_δ_pos, fun q P P₀ hP_mod => ?_⟩
    set d := 1 + q * m_δ
    have hu_pow_d : u_δ ^ d = u_δ := by
      have hd_eq : d = 1 + m_δ * q := by dsimp [d]; ring
      rw [hd_eq, pow_add, pow_one, pow_mul, hu_pow_card, one_pow, mul_one]
    have hπ_pow_d : π (δ_R ^ d) = π δ_R := by
      calc π (δ_R ^ d) = (π δ_R) ^ d := map_pow π δ_R d
        _ = ((u_δ ^ d : Qˣ) : Q) := (Units.val_pow_eq_pow_val u_δ d).symm
        _ = (u_δ : Q) := congrArg Units.val hu_pow_d
        _ = π δ_R := rfl
    have hπ_aeval : π (Polynomial.aeval (δ_R ^ d) P) = π (Polynomial.aeval δ_R P₀) := by
      calc π (Polynomial.aeval (δ_R ^ d) P)
          = Polynomial.eval₂ φ (π (δ_R ^ d)) P := by
              rw [Polynomial.aeval_def, Polynomial.hom_eval₂]
        _ = Polynomial.eval₂ ψ (π δ_R) (P.map (PadicInt.toZModPow k)) := by
              rw [hπ_pow_d, hφ_eq, ← Polynomial.eval₂_map]
        _ = Polynomial.eval₂ ψ (π δ_R) (P₀.map (PadicInt.toZModPow k)) := by
              rw [hP_mod]
        _ = Polynomial.eval₂ φ (π δ_R) P₀ := by
              rw [Polynomial.eval₂_map, ← hφ_eq]
        _ = π (Polynomial.aeval δ_R P₀) := by
              rw [← Polynomial.hom_eval₂, ← Polynomial.aeval_def]
    have hdiff_mem : Polynomial.aeval (δ_R ^ d) P - Polynomial.aeval δ_R P₀ ∈ I := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change π (Polynomial.aeval (δ_R ^ d) P - Polynomial.aeval δ_R P₀) = 0
      rw [map_sub, hπ_aeval, sub_self]
    rw [Ideal.mem_span_singleton] at hdiff_mem
    rcases hdiff_mem with ⟨w₀, hw₀⟩
    have hR_eq : Polynomial.aeval (δ_R ^ d) P =
        Polynomial.aeval δ_R P₀ + (ℓ : R_δ) ^ k * w₀ := by
      calc Polynomial.aeval (δ_R ^ d) P
          = Polynomial.aeval δ_R P₀ +
              (Polynomial.aeval (δ_R ^ d) P - Polynomial.aeval δ_R P₀) := by ring
        _ = Polynomial.aeval δ_R P₀ + (ℓ : R_δ) ^ k * w₀ := by rw [hw₀]
    have hL_eq := congrArg R_δ.val hR_eq
    have hlhs : R_δ.val (Polynomial.aeval (δ_R ^ d) P) = Polynomial.aeval (δ ^ d) P := by
      rw [← Polynomial.aeval_algHom_apply]
      rfl
    have hrhs : R_δ.val (Polynomial.aeval δ_R P₀ + (ℓ : R_δ) ^ k * w₀) =
        Polynomial.aeval δ P₀ + (ℓ : L) ^ k * w₀.1 := by
      rw [map_add, ← Polynomial.aeval_algHom_apply, map_mul, map_pow, map_natCast]
      rfl
    rw [hlhs, hrhs] at hL_eq
    exact ⟨w₀.1, (mem_integralClosure_iff (PadicInt ℓ) L).mp (hR_le w₀.2), hL_eq⟩
  let P₀ : Polynomial (PadicInt ℓ) := (A₁ * B₀).charpoly
  have hP₀_ne : ∀ δ ∈ δ_list, Polynomial.aeval δ P₀ ≠ 0 := by
    intro δ hδ_mem
    have h := hB₀_avoid δ hδ_mem
    rwa [Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def] at h
  have hP₀_int : ∀ δ : L, IsIntegral (PadicInt ℓ) δ →
      IsIntegral (PadicInt ℓ) (Polynomial.aeval δ P₀) := by
    intro δ hδ_int
    let δ_sub : integralClosure (PadicInt ℓ) L :=
      ⟨δ, (mem_integralClosure_iff (PadicInt ℓ) L).mpr hδ_int⟩
    let y_sub : integralClosure (PadicInt ℓ) L := Polynomial.aeval δ_sub P₀
    have hy_val : (y_sub : L) = Polynomial.aeval δ P₀ := by
      change (integralClosure (PadicInt ℓ) L).val (Polynomial.aeval δ_sub P₀) =
        Polynomial.aeval δ P₀
      rw [← Polynomial.aeval_algHom_apply]
      rfl
    rw [← hy_val]
    exact (mem_integralClosure_iff (PadicInt ℓ) L).mp y_sub.2
  let r_of : L → ℕ := fun δ =>
    if h : IsIntegral (PadicInt ℓ) δ ∧ Polynomial.aeval δ P₀ ≠ 0 then
      Classical.choose (h_s3 (Polynomial.aeval δ P₀) (hP₀_int δ h.1) h.2)
    else 0
  let k : ℕ := 1 + (δ_list.map r_of).sum
  have hk : 1 ≤ k := by dsimp [k]; omega
  have hk_avoid : ∀ δ ∈ δ_list, IsIntegral (PadicInt ℓ) δ →
      ∀ w : L, IsIntegral (PadicInt ℓ) w →
        Polynomial.aeval δ P₀ + (ℓ : L) ^ k * w ≠ 0 := by
    intro δ hδ_mem hδ_int w hw_int
    have hcond : IsIntegral (PadicInt ℓ) δ ∧ Polynomial.aeval δ P₀ ≠ 0 :=
      ⟨hδ_int, hP₀_ne δ hδ_mem⟩
    have hr_le : r_of δ ≤ (δ_list.map r_of).sum :=
      List.le_sum_of_mem (List.mem_map_of_mem (f := r_of) hδ_mem)
    have hr_k : Classical.choose
        (h_s3 (Polynomial.aeval δ P₀) (hP₀_int δ hcond.1) hcond.2) + 1 ≤ k := by
      have hr_eq : r_of δ = Classical.choose
          (h_s3 (Polynomial.aeval δ P₀) (hP₀_int δ hcond.1) hcond.2) := dif_pos hcond
      dsimp [k] at *
      omega
    exact Classical.choose_spec
      (h_s3 (Polynomial.aeval δ P₀) (hP₀_int δ hcond.1) hcond.2) k hr_k w hw_int
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero k hℓ_ne_zero⟩
  let G_mat := (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ k)))ˣ
  let N_mat : ℕ := Nat.card G_mat
  have hN_mat : 1 ≤ N_mat := Nat.card_pos
  let m_of : L → ℕ := fun δ =>
    if h : δ ≠ 0 ∧ IsIntegral (PadicInt ℓ) δ ∧ IsIntegral (PadicInt ℓ) δ⁻¹ then
      Classical.choose (h_s4 k hk δ h.1 h.2.1 h.2.2)
    else 1
  have hm_of_pos : ∀ δ : L, 1 ≤ m_of δ := by
    intro δ
    dsimp [m_of]
    split_ifs with h
    · exact (Classical.choose_spec (h_s4 k hk δ h.1 h.2.1 h.2.2)).1
    · exact le_refl 1
  let P_units : ℕ := (δ_list.map m_of).prod
  have hP_units : 1 ≤ P_units := by
    apply List.one_le_prod_of_one_le
    intro x hx
    rcases List.mem_map.mp hx with ⟨δ, -, rfl⟩
    exact hm_of_pos δ
  let P_per : ℕ := N_mat * P_units
  have hP_per : 1 ≤ P_per := Nat.mul_pos hN_mat hP_units
  refine ⟨k, P_per, hk, hP_per, fun m C hC_unit hC_mod δ hδ_mem hdvd => ?_⟩
  set d := 1 + m * P_per
  have hd : 1 ≤ d := by dsimp [d]; omega
  have hδ_ne_zero : δ ≠ 0 := hδ_ne δ hδ_mem
  obtain ⟨hC_aeval, hδ_int, hδ_inv_int⟩ := h_s2 d hd C hC_unit δ hδ_ne_zero hdvd
  let ρ_mat : Matrix (Fin M) (Fin M) (PadicInt ℓ) →+* Matrix (Fin M) (Fin M) (ZMod (ℓ ^ k)) :=
    RingHom.mapMatrix (PadicInt.toZModPow k)
  let U₁ : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ := hA₁_unit.unit
  let u₁ : G_mat := Units.map ρ_mat.toMonoidHom U₁
  have hu₁_pow_card : u₁ ^ N_mat = 1 := pow_card_eq_one'
  have hu₁_pow_d : u₁ ^ d = u₁ := by
    have hd_eq : d = 1 + N_mat * (m * P_units) := by dsimp [d, P_per]; ring
    rw [hd_eq, pow_add, pow_one, pow_mul, hu₁_pow_card, one_pow, mul_one]
  have hA₁_mod : (A₁ ^ d).map (PadicInt.toZModPow k) = A₁.map (PadicInt.toZModPow k) := by
    calc (A₁ ^ d).map (PadicInt.toZModPow k)
        = ρ_mat (A₁ ^ d) := rfl
      _ = (ρ_mat A₁) ^ d := map_pow ρ_mat A₁ d
      _ = (ρ_mat (U₁ : Matrix (Fin M) (Fin M) (PadicInt ℓ))) ^ d :=
            congrArg (fun X => (ρ_mat X) ^ d) hA₁_unit.unit_spec.symm
      _ = ((u₁ ^ d : G_mat) : Matrix (Fin M) (Fin M) (ZMod (ℓ ^ k))) :=
            (Units.val_pow_eq_pow_val u₁ d).symm
      _ = (u₁ : Matrix (Fin M) (Fin M) (ZMod (ℓ ^ k))) := congrArg Units.val hu₁_pow_d
      _ = ρ_mat (U₁ : Matrix (Fin M) (Fin M) (PadicInt ℓ)) := rfl
      _ = A₁.map (PadicInt.toZModPow k) := congrArg ρ_mat hA₁_unit.unit_spec
  have hAB_mod : ((A₁ ^ d * B₀).map (PadicInt.toZModPow k)) =
      ((A₁ * B₀).map (PadicInt.toZModPow k)) := by
    change ρ_mat (A₁ ^ d * B₀) = ρ_mat (A₁ * B₀)
    rw [map_mul, map_mul]
    change (A₁ ^ d).map (PadicInt.toZModPow k) * B₀.map (PadicInt.toZModPow k) =
      A₁.map (PadicInt.toZModPow k) * B₀.map (PadicInt.toZModPow k)
    rw [hA₁_mod]
  have hchar_mod : C.charpoly.map (PadicInt.toZModPow k) = P₀.map (PadicInt.toZModPow k) := by
    rw [← Matrix.charpoly_map, hC_mod, hAB_mod, Matrix.charpoly_map]
  have hcond_m : δ ≠ 0 ∧ IsIntegral (PadicInt ℓ) δ ∧ IsIntegral (PadicInt ℓ) δ⁻¹ :=
    ⟨hδ_ne_zero, hδ_int, hδ_inv_int⟩
  have hm_dvd : m_of δ ∣ P_units :=
    List.dvd_prod (List.mem_map_of_mem (f := m_of) hδ_mem)
  rcases hm_dvd with ⟨c_mul, hc_mul⟩
  let m_δ := Classical.choose (h_s4 k hk δ hcond_m.1 hcond_m.2.1 hcond_m.2.2)
  have hm_eq : m_of δ = m_δ := dif_pos hcond_m
  let q_mul : ℕ := m * N_mat * c_mul
  have hd_q : d = 1 + q_mul * m_δ := by
    calc d = 1 + m * (N_mat * P_units) := rfl
      _ = 1 + m * (N_mat * (m_of δ * c_mul)) := by rw [hc_mul]
      _ = 1 + m * (N_mat * (m_δ * c_mul)) := by rw [hm_eq]
      _ = 1 + q_mul * m_δ := by dsimp [q_mul]; ring
  obtain ⟨w, hw_int, haeval_eq⟩ :=
    (Classical.choose_spec (h_s4 k hk δ hcond_m.1 hcond_m.2.1 hcond_m.2.2)).2
      q_mul C.charpoly P₀ hchar_mod
  rw [← hd_q, hC_aeval] at haeval_eq
  exact hk_avoid δ hδ_mem hδ_int w hw_int haeval_eq.symm

theorem weil_deligne_periodic_coprime_zeta_rationality_descent (K : Type) [Field K] [CharZero K] [IsAlgClosed K]
    (GoodPoly : ℕ → Type u)
    (R_poly : ∀ d : ℕ, GoodPoly d → Polynomial K)
    (hR0 : ∀ (d : ℕ) (x : GoodPoly d), (R_poly d x).coeff 0 = 1)
    (hAvoid_per : ∀ (δ_list : List K),
      (∀ δ ∈ δ_list, δ ≠ 0) →
        ∃ P_per D₀ : ℕ, 1 ≤ P_per ∧
          ∀ m : ℕ, D₀ ≤ m →
            ∃ x : GoodPoly (1 + m * P_per),
              ∀ δ ∈ δ_list,
                ¬ ((1 - Polynomial.C (δ ^ (1 + m * P_per)) * Polynomial.X) ∣
                  R_poly (1 + m * P_per) x))
    (hRat : ∃ (α_num β_den : List K),
      (∀ α ∈ α_num, α ≠ 0) ∧ (∀ β ∈ β_den, β ≠ 0) ∧
      ∀ (d : ℕ) (x : GoodPoly d),
        1 ≤ d →
          ∃ A_Q B_Q : Polynomial ℚ,
            A_Q.coeff 0 = 1 ∧ B_Q.coeff 0 = 1 ∧
            (A_Q.map (algebraMap ℚ K)) *
              (β_den.map (fun β => 1 - Polynomial.C (β ^ d) * Polynomial.X)).prod =
            (B_Q.map (algebraMap ℚ K)) *
              (α_num.map (fun α => 1 - Polynomial.C (α ^ d) * Polynomial.X)).prod *
              R_poly d x)
    (d : ℕ) (hd : 1 ≤ d) (x : GoodPoly d) :
    ∃ R_Q : Polynomial ℚ, R_Q.map (algebraMap ℚ K) = R_poly d x :=
by
  classical
  let recProd : ∀ {R : Type} [CommRing R], Multiset R → Polynomial R :=
    fun N => (N.map (fun u => 1 - Polynomial.C u * Polynomial.X)).prod
  have hLin_coeff0 : ∀ {R : Type} [CommRing R] (u : R),
      (1 - Polynomial.C u * Polynomial.X : Polynomial R).coeff 0 = 1 := by
    intro R _ u
    rw [Polynomial.coeff_sub, Polynomial.coeff_one_zero, Polynomial.mul_coeff_zero,
      Polynomial.coeff_C_zero, Polynomial.coeff_X_zero, mul_zero, sub_zero]
  have hRecProd_coeff0 : ∀ {R : Type} [CommRing R] (N : Multiset R),
      (recProd N).coeff 0 = 1 := by
    intro R _ N
    induction N using Multiset.induction_on with
    | empty =>
      dsimp [recProd]
      exact Polynomial.coeff_one_zero
    | cons u N ih =>
      dsimp [recProd]
      rw [Multiset.map_cons, Multiset.prod_cons, Polynomial.mul_coeff_zero, hLin_coeff0 u, ih,
        mul_one]
  have hNe_of_coeff0_eq_one : ∀ {R : Type} [CommRing R] [Nontrivial R] {P : Polynomial R},
      P.coeff 0 = 1 → P ≠ 0 := by
    intro R _ _ P hP h0
    rw [h0, Polynomial.coeff_zero] at hP
    exact one_ne_zero hP.symm
  have hRecProd_add : ∀ {R : Type} [CommRing R] (N₁ N₂ : Multiset R),
      recProd (N₁ + N₂) = recProd N₁ * recProd N₂ := by
    intro R _ N₁ N₂
    dsimp [recProd]
    rw [Multiset.map_add, Multiset.prod_add]
  have hRecProd_map : ∀ {R S : Type} [CommRing R] [CommRing S] (φ : R →+* S) (N : Multiset R),
      (recProd N).map φ = recProd (N.map φ) := by
    intro R S _ _ φ N
    induction N using Multiset.induction_on with
    | empty =>
      simp [recProd]
    | cons u N ih =>
      dsimp [recProd] at ih ⊢
      rw [Multiset.map_cons, Multiset.prod_cons, Polynomial.map_mul, Polynomial.map_sub,
        Polynomial.map_one, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X, ih,
        Multiset.map_cons, Multiset.map_cons, Multiset.prod_cons]
  have hMap_pow_comm : ∀ {R S : Type} [CommRing R] [CommRing S] (φ : R →+* S) (M : Multiset R) (e : ℕ),
      (M.map (· ^ e)).map φ = (M.map φ).map (· ^ e) := by
    intro R S _ _ φ M e
    induction M using Multiset.induction_on with
    | empty => rfl
    | cons z M ih =>
      simp only [Multiset.map_cons, map_pow, ih]
  have hRecProd_eval : ∀ {R : Type} [CommRing R] (N : Multiset R) (y : R),
      (recProd N).eval y = (N.map (fun v => 1 - v * y)).prod := by
    intro R _ N y
    induction N using Multiset.induction_on with
    | empty =>
      simp [recProd]
    | cons u N ih =>
      dsimp [recProd] at ih ⊢
      rw [Multiset.map_cons, Multiset.prod_cons, Polynomial.eval_mul, Polynomial.eval_sub,
        Polynomial.eval_one, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, ih,
        Multiset.map_cons, Multiset.prod_cons]
  have hEq_of_dvd_of_coeff0 : ∀ {R : Type} [CommRing R] [IsDomain R] {P Q : Polynomial R},
      P.coeff 0 = 1 → Q.coeff 0 = 1 → P ∣ Q → Q ∣ P → P = Q := by
    intro R _ _ P Q hP0 hQ0 ⟨U, hU⟩ ⟨V, hV⟩
    have hP_ne : P ≠ 0 := hNe_of_coeff0_eq_one hP0
    have hUV : U * V = 1 := by
      apply mul_left_cancel₀ hP_ne
      calc P * (U * V) = (P * U) * V := (mul_assoc P U V).symm
        _ = Q * V := by rw [← hU]
        _ = P := hV.symm
        _ = P * 1 := (mul_one P).symm
    have hU_ne : U ≠ 0 := by
      intro rfl
      rw [zero_mul] at hUV
      exact zero_ne_one hUV
    have hV_ne : V ≠ 0 := by
      intro rfl
      rw [mul_zero] at hUV
      exact zero_ne_one hUV
    have hdeg0 : U.natDegree + V.natDegree = 0 := by
      rw [← Polynomial.natDegree_mul hU_ne hV_ne, hUV, Polynomial.natDegree_one]
    have hU_deg : U.natDegree = 0 := by omega
    have hU_eq_C : U = Polynomial.C (U.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hU_deg
    have hU0 : U.coeff 0 = 1 := by
      have hc : Q.coeff 0 = P.coeff 0 * U.coeff 0 := by rw [hU, Polynomial.mul_coeff_zero]
      rw [hQ0, hP0, one_mul] at hc
      exact hc.symm
    rw [hU, hU_eq_C, hU0, map_one, mul_one]
  have hLin_dvd_iff : ∀ {F : Type} [Field F] {u : F} (hu : u ≠ 0) (P : Polynomial F),
      (1 - Polynomial.C u * Polynomial.X) ∣ P ↔ P.eval u⁻¹ = 0 := by
    intro F _ u hu P
    constructor
    · rintro ⟨Q, rfl⟩
      rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_one, Polynomial.eval_mul,
        Polynomial.eval_C, Polynomial.eval_X, mul_inv_cancel₀ hu, sub_self, zero_mul]
    · intro heval
      obtain ⟨Q, hQ⟩ := @Polynomial.X_sub_C_dvd_sub_C_eval F u⁻¹ _ P
      rw [heval, map_zero, sub_zero] at hQ
      refine ⟨-Polynomial.C u⁻¹ * Q, ?_⟩
      have hfac : (1 - Polynomial.C u * Polynomial.X) * (-Polynomial.C u⁻¹) =
          Polynomial.X - Polynomial.C u⁻¹ := by
        calc (1 - Polynomial.C u * Polynomial.X) * (-Polynomial.C u⁻¹)
            = -Polynomial.C u⁻¹ + (Polynomial.C u * Polynomial.C u⁻¹) * Polynomial.X := by ring
          _ = -Polynomial.C u⁻¹ + Polynomial.C (u * u⁻¹) * Polynomial.X := by rw [← Polynomial.C_mul]
          _ = Polynomial.X - Polynomial.C u⁻¹ := by
                rw [mul_inv_cancel₀ hu, Polynomial.C_1, one_mul]
                ring
      rw [hQ, ← hfac, mul_assoc]
  have hLin_isCoprime : ∀ {F : Type} [Field F] {u : F} (hu : u ≠ 0) {P : Polynomial F},
      ¬ ((1 - Polynomial.C u * Polynomial.X) ∣ P) →
      IsCoprime (1 - Polynomial.C u * Polynomial.X) P := by
    intro F _ u hu P hndvd
    have hc : P.eval u⁻¹ ≠ 0 := mt (hLin_dvd_iff hu P).mpr hndvd
    set c := P.eval u⁻¹
    obtain ⟨Q, hQ⟩ := @Polynomial.X_sub_C_dvd_sub_C_eval F u⁻¹ _ P
    have hP_eq : P = Polynomial.C c + (Polynomial.X - Polynomial.C u⁻¹) * Q := by
      rw [← hQ]
      ring
    refine ⟨Polynomial.C c⁻¹ * Polynomial.C u⁻¹ * Q, Polynomial.C c⁻¹, ?_⟩
    rw [hP_eq]
    have h1 : Polynomial.C u⁻¹ * Polynomial.C u = 1 := by
      rw [← Polynomial.C_mul, inv_mul_cancel₀ hu, Polynomial.C_1]
    have h2 : Polynomial.C c⁻¹ * Polynomial.C c = 1 := by
      rw [← Polynomial.C_mul, inv_mul_cancel₀ hc, Polynomial.C_1]
    calc (Polynomial.C c⁻¹ * Polynomial.C u⁻¹ * Q) * (1 - Polynomial.C u * Polynomial.X) +
          Polynomial.C c⁻¹ * (Polynomial.C c + (Polynomial.X - Polynomial.C u⁻¹) * Q)
        = Polynomial.C c⁻¹ * Polynomial.C c +
            Polynomial.C c⁻¹ * Q *
              (Polynomial.C u⁻¹ - (Polynomial.C u⁻¹ * Polynomial.C u) * Polynomial.X +
                (Polynomial.X - Polynomial.C u⁻¹)) := by ring
      _ = 1 + Polynomial.C c⁻¹ * Q *
            (Polynomial.C u⁻¹ - 1 * Polynomial.X + (Polynomial.X - Polynomial.C u⁻¹)) := by
              rw [h1, h2]
      _ = 1 := by ring
  have hRecProd_isCoprime : ∀ {F : Type} [Field F] (N : Multiset F) (P : Polynomial F),
      (∀ u ∈ N, u ≠ 0 ∧ ¬ ((1 - Polynomial.C u * Polynomial.X) ∣ P)) →
      IsCoprime (recProd N) P := by
    intro F _ N P hN
    induction N using Multiset.induction_on with
    | empty =>
      simpa [recProd] using isCoprime_one_left
    | cons u N ih =>
      dsimp [recProd] at ih ⊢
      rw [Multiset.map_cons, Multiset.prod_cons]
      have hu := hN u (Multiset.mem_cons_self u N)
      exact (hLin_isCoprime hu.1 hu.2).mul_left
        (ih (fun v hv => hN v (Multiset.mem_cons_of_mem hv)))
  have hRecProd_inj : ∀ {F : Type} [Field F] {N₁ N₂ : Multiset F},
      (∀ u ∈ N₁, u ≠ 0) → (∀ v ∈ N₂, v ≠ 0) →
      recProd N₁ = recProd N₂ → N₁ = N₂ := by
    intro F _ N₁
    induction N₁ using Multiset.induction_on with
    | empty =>
      intro N₂ _ hN₂ heq
      by_contra hne
      obtain ⟨v, hv_mem⟩ := Multiset.exists_mem_of_ne_zero (Ne.symm hne)
      have hv : v ≠ 0 := hN₂ v hv_mem
      obtain ⟨N₂', rfl⟩ := Multiset.exists_cons_of_mem hv_mem
      have heval := congrArg (Polynomial.eval v⁻¹) heq
      dsimp [recProd] at heval
      rw [Polynomial.eval_one,
        Multiset.map_cons, Multiset.prod_cons, Polynomial.eval_mul, Polynomial.eval_sub,
        Polynomial.eval_one, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
        mul_inv_cancel₀ hv, sub_self, zero_mul] at heval
      exact one_ne_zero heval
    | cons u N₁ ih =>
      intro N₂ hN₁ hN₂ heq
      have hu : u ≠ 0 := hN₁ u (Multiset.mem_cons_self u N₁)
      have heval := congrArg (Polynomial.eval u⁻¹) heq
      rw [hRecProd_eval, hRecProd_eval, Multiset.map_cons, Multiset.prod_cons,
        mul_inv_cancel₀ hu, sub_self, zero_mul] at heval
      have hzero_mem : (0 : F) ∈ N₂.map (fun v => 1 - v * u⁻¹) :=
        Multiset.prod_eq_zero_iff.mp heval.symm
      obtain ⟨v, hv_mem, hv_eq⟩ := Multiset.mem_map.mp hzero_mem
      have hvu : v = u := by
        have h1 : v * u⁻¹ = 1 := (sub_eq_zero.mp hv_eq).symm
        calc v = v * (u⁻¹ * u) := by rw [inv_mul_cancel₀ hu, mul_one]
          _ = (v * u⁻¹) * u := (mul_assoc v u⁻¹ u).symm
          _ = u := by rw [h1, one_mul]
      subst hvu
      obtain ⟨N₂', rfl⟩ := Multiset.exists_cons_of_mem hv_mem
      dsimp [recProd] at heq
      rw [Multiset.map_cons, Multiset.prod_cons, Multiset.map_cons, Multiset.prod_cons] at heq
      have hlin_ne : (1 - Polynomial.C v * Polynomial.X : Polynomial F) ≠ 0 :=
        hNe_of_coeff0_eq_one (hLin_coeff0 v)
      have heq' : recProd N₁ = recProd N₂' := mul_left_cancel₀ hlin_ne heq
      rw [ih (fun w hw => hN₁ w (Multiset.mem_cons_of_mem hw))
        (fun w hw => hN₂ w (Multiset.mem_cons_of_mem hw)) heq']
  let badOrder : ∀ {G : Type} [Field G], G → ℕ :=
    fun z => if 2 ≤ orderOf z then orderOf z else 1
  have hBadOrder_pos : ∀ {G : Type} [Field G] (S : List G),
      1 ≤ (S.map badOrder).prod := by
    intro G _ S
    induction S with
    | nil => simp
    | cons z S ih =>
      rw [List.map_cons, List.prod_cons]
      have hz : 1 ≤ badOrder z := by
        dsimp [badOrder]
        split_ifs <;> omega
      exact Nat.mul_pos hz ih
  have hBadOrder_avoid : ∀ {G : Type} [Field G] (S : List G) {z : G},
      z ∈ S → z ≠ 1 → ∀ t : ℕ, z ^ (1 + t * (S.map badOrder).prod) ≠ 1 := by
    intro G _ S z hz_mem hz_ne1 t hpow
    set L := (S.map badOrder).prod
    set r := orderOf z
    have hdvd1 : r ∣ 1 + t * L := orderOf_dvd_iff_pow_eq_one.mpr hpow
    have hr_ne0 : r ≠ 0 := by
      intro hr0
      rw [hr0, zero_dvd_iff] at hdvd1
      omega
    have hr_ne1 : r ≠ 1 := by
      intro hr1
      exact hz_ne1 (orderOf_eq_one_iff.mp hr1)
    have hr_ge2 : 2 ≤ r := by omega
    have hbad_eq : badOrder z = r := by
      dsimp [badOrder]
      change (if 2 ≤ r then r else 1) = r
      simp [hr_ge2]
    have hdvd_L : r ∣ L := by
      rw [← hbad_eq]
      exact List.dvd_prod (List.mem_map.mpr ⟨z, hz_mem, rfl⟩)
    have hdvd_tL : r ∣ t * L := dvd_mul_of_dvd_right hdvd_L t
    rcases hdvd1 with ⟨a, ha⟩
    rcases hdvd_tL with ⟨b, hb⟩
    rw [hb] at ha
    have hlt : b < a := by
      by_contra hle
      have hmul_le : r * a ≤ r * b := Nat.mul_le_mul_left r (Nat.le_of_not_lt hle)
      omega
    have hge : r * (b + 1) ≤ r * a := Nat.mul_le_mul_left r hlt
    rw [Nat.mul_add, Nat.mul_one] at hge
    omega
  have hAlg_of_recProd_dvd : ∀ {M : Multiset K} {e : ℕ} {Q : Polynomial ℚ},
      1 ≤ e → (∀ γ ∈ M, γ ≠ 0) → Q ≠ 0 →
      recProd (M.map (· ^ e)) ∣ Q.map (algebraMap ℚ K) →
      ∀ γ ∈ M, IsAlgebraic ℚ γ := by
    intro M e Q he hM_ne hQ_ne hdvd γ hγ
    have hγ_ne : γ ≠ 0 := hM_ne γ hγ
    have hγe_ne : γ ^ e ≠ 0 := pow_ne_zero e hγ_ne
    have hlin_mem : (1 - Polynomial.C (γ ^ e) * Polynomial.X) ∈
        (M.map (· ^ e)).map (fun u => 1 - Polynomial.C u * Polynomial.X) :=
      Multiset.mem_map.mpr ⟨γ ^ e, Multiset.mem_map.mpr ⟨γ, hγ, rfl⟩, rfl⟩
    have hlin_dvd : (1 - Polynomial.C (γ ^ e) * Polynomial.X) ∣ Q.map (algebraMap ℚ K) :=
      (Multiset.dvd_prod hlin_mem).trans hdvd
    have heval_inv : (Q.map (algebraMap ℚ K)).eval ((γ ^ e)⁻¹) = 0 :=
      (hLin_dvd_iff hγe_ne (Q.map (algebraMap ℚ K))).mp hlin_dvd
    rw [Polynomial.eval_map] at heval_inv
    let x_inv : K := (γ ^ e)⁻¹
    have hx_inv_ne : x_inv ≠ 0 := inv_ne_zero hγe_ne
    let _ : Invertible x_inv := invertibleOfNonzero hx_inv_ne
    have hrev_eval : Polynomial.eval₂ (algebraMap ℚ K) (⅟x_inv) Q.reverse = 0 :=
      (Polynomial.eval₂_reverse_eq_zero_iff (algebraMap ℚ K) x_inv Q).mpr heval_inv
    rw [invOf_eq_inv, inv_inv] at hrev_eval
    have hQrev_ne : Q.reverse ≠ 0 := mt Polynomial.reverse_eq_zero.mp hQ_ne
    let P_alg : Polynomial ℚ := (Q.reverse).comp (Polynomial.X ^ e)
    have hXe_deg : (Polynomial.X ^ e : Polynomial ℚ).natDegree ≠ 0 := by
      rw [Polynomial.natDegree_X_pow]
      omega
    have hPalg_ne : P_alg ≠ 0 := by
      intro h0
      have hlc := Polynomial.leadingCoeff_comp (p := Q.reverse) (q := (Polynomial.X ^ e : Polynomial ℚ)) hXe_deg
      change P_alg.leadingCoeff = _ at hlc
      rw [h0, Polynomial.leadingCoeff_zero, (Polynomial.monic_X_pow (R := ℚ) e).leadingCoeff,
        one_pow, mul_one] at hlc
      exact hQrev_ne (Polynomial.leadingCoeff_eq_zero.mp hlc.symm)
    have hPalg_eval : Polynomial.aeval γ P_alg = 0 := by
      dsimp [P_alg]
      rw [Polynomial.aeval_comp, map_pow, Polynomial.aeval_X, Polynomial.aeval_def]
      exact hrev_eval
    exact ⟨P_alg, hPalg_ne, hPalg_eval⟩
  have hMultiset_map_inj_on : ∀ {α β : Type} [DecidableEq α] [DecidableEq β]
      {S : Finset α} {f : α → β}
      (hinj : ∀ z₁ ∈ S, ∀ z₂ ∈ S, f z₁ = f z₂ → z₁ = z₂)
      {N₁ N₂ : Multiset α},
      (∀ z ∈ N₁, z ∈ S) → (∀ z ∈ N₂, z ∈ S) →
      N₁.map f = N₂.map f → N₁ = N₂ := by
    intro α β _ _ S f hinj N₁
    induction N₁ using Multiset.induction_on with
    | empty =>
      intro N₂ _ _ heq
      induction N₂ using Multiset.induction_on with
      | empty => rfl
      | cons z N₂ _ => simp at heq
    | cons z₁ N₁ ih =>
      intro N₂ hN₁ hN₂ heq
      rw [Multiset.map_cons] at heq
      have hmem_f : f z₁ ∈ N₂.map f := by
        rw [← heq]
        exact Multiset.mem_cons_self _ _
      obtain ⟨z₂, hz₂_mem, hfz⟩ := Multiset.mem_map.mp hmem_f
      have hz₁_S : z₁ ∈ S := hN₁ z₁ (Multiset.mem_cons_self z₁ N₁)
      have hz₂_S : z₂ ∈ S := hN₂ z₂ hz₂_mem
      have hz_eq : z₂ = z₁ := hinj z₂ hz₂_S z₁ hz₁_S hfz
      subst hz_eq
      obtain ⟨N₂', rfl⟩ := Multiset.exists_cons_of_mem hz₂_mem
      rw [Multiset.map_cons, Multiset.cons_inj_right] at heq
      rw [ih (fun w hw => hN₁ w (Multiset.mem_cons_of_mem hw))
        (fun w hw => hN₂ w (Multiset.mem_cons_of_mem hw)) heq]
  have hGaloisDescent : ∀ (M : Multiset K),
      (∀ γ ∈ M, γ ≠ 0) →
      (∀ γ ∈ M, IsAlgebraic ℚ γ) →
      (∀ (δ_list : List K),
        (∀ δ ∈ δ_list, δ ≠ 0) →
          ∃ P_per D₀ : ℕ, 1 ≤ P_per ∧
            ∀ m : ℕ, D₀ ≤ m →
              ∃ (R : Polynomial K) (C_Q : Polynomial ℚ),
                recProd (M.map (· ^ (1 + m * P_per))) * R = C_Q.map (algebraMap ℚ K) ∧
                ∀ δ ∈ δ_list,
                  ¬ ((1 - Polynomial.C (δ ^ (1 + m * P_per)) * Polynomial.X) ∣ R)) →
      ∀ (e : ℕ), ∃ P_Q : Polynomial ℚ,
        P_Q.coeff 0 = 1 ∧
        P_Q.map (algebraMap ℚ K) = recProd (M.map (· ^ e)) := by
    intro M hM_ne hM_alg hPer
    let minList : List (Polynomial ℚ) := M.toList.map (fun γ => minpoly ℚ γ)
    let f_M : Polynomial ℚ := minList.prod
    have hf_M_monic : f_M.Monic := by
      have hlist_monic : ∀ L : List (Polynomial ℚ), (∀ p ∈ L, p.Monic) → L.prod.Monic := by
        intro L hL
        induction L with
        | nil => exact Polynomial.monic_one
        | cons p L ih =>
          rw [List.prod_cons]
          exact (hL p (by simp)).mul (ih (fun q hq => hL q (by simp [hq])))
      apply hlist_monic
      intro p hp
      obtain ⟨γ, hγ_list, rfl⟩ := List.mem_map.mp hp
      exact minpoly.monic (hM_alg γ (Multiset.mem_toList.mp hγ_list)).isIntegral
    let E := Polynomial.SplittingField f_M
    have _ : IsGalois ℚ E := IsGalois.mk
    let ι_E : E →ₐ[ℚ] K := IsAlgClosed.lift
    have hι_comp : ι_E.toRingHom.comp (algebraMap ℚ E) = algebraMap ℚ K := ι_E.comp_algebraMap
    have hMap_QE_K : ∀ Q : Polynomial ℚ,
        (Q.map (algebraMap ℚ E)).map ι_E.toRingHom = Q.map (algebraMap ℚ K) :=
      fun Q => by rw [Polynomial.map_map, hι_comp]
    let P_E : Polynomial E := f_M.map (algebraMap ℚ E)
    have hPE_splits : P_E.Splits := Polynomial.SplittingField.splits f_M
