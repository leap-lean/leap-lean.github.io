    intro Y₀ mc C_comp inc_c _ n q P v₀ i j hij f g hfg
    subst hij
    have hf_eq : f = g := (cancel_mono (inc_c j)).mp hfg
    rw [hf_eq]

  obtain ⟨hPullExUniq, _, hPullComp⟩ := weil_lefschetz_torsion_pullback_functoriality.{u}
  let pullH : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (n q : ℕ),
      weilEtaleTorsionH W₂ n q →+ weilEtaleTorsionH W₁ n q :=
    fun h n q => (hPullExUniq h n q).choose
  have hpullH_spec : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (n q : ℕ),
      WeilLefschetzTorsionPullback h n q (pullH h n q) :=
    fun h n q => (hPullExUniq h n q).choose_spec.1
  have hpullH_uniq : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) (n q : ℕ)
      (p' : weilEtaleTorsionH W₂ n q →+ weilEtaleTorsionH W₁ n q),
      WeilLefschetzTorsionPullback h n q p' → p' = pullH h n q :=
    fun h n q p' hp' => (hPullExUniq h n q).choose_spec.2 p' hp'

  let β_L := fun m : ℕ => (hβ_tors_all (ℓ ^ (m + 1))).choose
  have hβ_L_spec := fun m : ℕ => (hβ_tors_all (ℓ ^ (m + 1))).choose_spec
  have hβ_ι : ∀ m : ℕ, P_α.map (ι_JY m) ≫ β_L m = β_J m ≫ ι_JY m :=
    fun m => ((hS11 m).2.2.2.2.2.2.2.2.2.1 (β_L m) (hβ_L_spec m).1).1
  have hβ_ρ : ∀ m : ℕ, P_α.map (ρ_SY m) ≫ β_S m = β_L m ≫ ρ_SY m :=
    fun m => ((hS11 m).2.2.2.2.2.2.2.2.2.1 (β_L m) (hβ_L_spec m).1).2

  let α_comp : ∀ ι : Fin m_c, Quiver.Hom (Y_comp ι).left (Y_comp (π_α ι)).left :=
    fun ι => AlgebraicGeometry.IsOpenImmersion.lift (inc_comp (π_α ι))
      (CategoryTheory.CategoryStruct.comp (inc_comp ι)
        (CategoryTheory.CategoryStruct.comp φ_abs α_geom.hom)) (hπ_α ι)
  have hα_comp_fac : ∀ ι : Fin m_c,
      CategoryTheory.CategoryStruct.comp (α_comp ι) (inc_comp (π_α ι)) =
        CategoryTheory.CategoryStruct.comp (inc_comp ι)
          (CategoryTheory.CategoryStruct.comp φ_abs α_geom.hom) :=
    fun ι => AlgebraicGeometry.IsOpenImmersion.lift_fac (inc_comp (π_α ι))
      (CategoryTheory.CategoryStruct.comp (inc_comp ι)
        (CategoryTheory.CategoryStruct.comp φ_abs α_geom.hom)) (hπ_α ι)

  let act_comp : ∀ (m q : ℕ),
      (∀ ι : Fin m_c, weilEtaleTorsionH (Y_comp ι).left (ℓ ^ (m + 1)) q) →+
        (∀ ι : Fin m_c, weilEtaleTorsionH (Y_comp ι).left (ℓ ^ (m + 1)) q) :=
    fun m q =>
      { toFun := fun v ι => pullH (α_comp ι) (ℓ ^ (m + 1)) q (v (π_α ι))
        map_zero' := by ext ι; exact map_zero _
        map_add' := fun v₁ v₂ => by ext ι; exact map_add _ _ _ }

  let r_hom : ∀ (m q : ℕ),
      weilEtaleTorsionH Y_bar.left (ℓ ^ (m + 1)) q →+
        (∀ ι : Fin m_c, weilEtaleTorsionH (Y_comp ι).left (ℓ ^ (m + 1)) q) :=
    fun m q => AddMonoidHom.pi fun ι => pullH (inc_comp ι) (ℓ ^ (m + 1)) q
  have hr_bij : ∀ (m q : ℕ), Function.Bijective (r_hom m q) := fun m q =>
    weil_etale_clopen_cover_torsion_cohomology_bijective m_c (ℓ ^ (m + 1)) q
      Y_bar.left (fun ι => (Y_comp ι).left) inc_comp
      (fun ι => (hcomp ι).2.1) (fun ι => (hcomp ι).2.2.1) hcomp_disj hcomp_univ
      (fun ι => hFinEpi (inc_comp ι))
      (fun ι => pullH (inc_comp ι) (ℓ ^ (m + 1)) q)
      (fun ι => hpullH_spec (inc_comp ι) (ℓ ^ (m + 1)) q)
  let r_comp : ∀ m q : ℕ,
      CategoryTheory.Abelian.Ext Fℤ_Y (weilEtaleTorsionSheaf Y_bar.left (ℓ ^ (m + 1))) q ≃+
        (∀ ι : Fin m_c, weilEtaleTorsionH (Y_comp ι).left (ℓ ^ (m + 1)) q) :=
    fun m q => AddEquiv.ofBijective (r_hom m q) (hr_bij m q)

  have hact_τ : ∀ (m q : ℕ)
      (v : ∀ ι, weilEtaleTorsionH (Y_comp ι).left (ℓ ^ (m + 1 + 1)) q) (ι : Fin m_c),
      weilEtaleTorsionTransition (Y_comp ι).left ℓ (m + 1) q (act_comp (m + 1) q v ι) =
        act_comp m q (fun j => weilEtaleTorsionTransition (Y_comp j).left ℓ (m + 1) q (v j)) ι :=
    fun m q v ι =>
      hPullTrans (α_comp ι) ℓ (m + 1) q
        (pullH (α_comp ι) (ℓ ^ (m + 1 + 1)) q) (pullH (α_comp ι) (ℓ ^ (m + 1)) q)
        (hpullH_spec _ _ _) (hpullH_spec _ _ _) (v (π_α ι))
  have hact_off : ∀ (m q : ℕ) (ι : Fin m_c)
      (v : ∀ j, weilEtaleTorsionH (Y_comp j).left (ℓ ^ (m + 1)) q),
      v (π_α ι) = 0 → act_comp m q v ι = 0 := by
    intro m q ι v hv0
    change pullH (α_comp ι) (ℓ ^ (m + 1)) q (v (π_α ι)) = 0
    rw [hv0, map_zero]
  have hact_fix : ∀ (m q : ℕ) (ι : Fin m_c) (h : π_α ι = ι),
      ∃ p_fix : weilEtaleTorsionH (Y_comp ι).left (ℓ ^ (m + 1)) q →+
          weilEtaleTorsionH (Y_comp ι).left (ℓ ^ (m + 1)) q,
        WeilLefschetzTorsionPullback (α_fix ι h) (ℓ ^ (m + 1)) q p_fix ∧
        ∀ v, act_comp m q v ι = p_fix (v ι) :=
    fun m q ι h =>
      ⟨pullH (α_fix ι h) (ℓ ^ (m + 1)) q, hpullH_spec (α_fix ι h) (ℓ ^ (m + 1)) q,
        fun v => hCancelComp Y_bar.left m_c (fun j => (Y_comp j).left) inc_comp
          (fun j => (hcomp j).2.1) (ℓ ^ (m + 1)) q
          (fun f => pullH f (ℓ ^ (m + 1)) q) v ι (π_α ι) h (α_comp ι) (α_fix ι h)
          ((hα_comp_fac ι).trans (hα_fix ι h).symm)⟩
  have hr_comp_act : ∀ (m q : ℕ)
      (w : CategoryTheory.Abelian.Ext Fℤ_Y (weilEtaleTorsionSheaf Y_bar.left (ℓ ^ (m + 1))) q),
      r_comp m q
        (((CategoryTheory.Abelian.Ext.mk₀ (β_L m)).postcomp Fℤ_Y (Nat.add_zero q))
          ((CategoryTheory.Abelian.Ext.mk₀ αℤ_Y).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_α
              hAdd_α hLim_α hColim_α _ _ Fℤ_Y
              (weilEtaleTorsionSheaf Y_bar.left (ℓ ^ (m + 1))) q) w)
            (Nat.zero_add q))) =
        act_comp m q (r_comp m q w) := by
    intro m q w
    let n := ℓ ^ (m + 1)
    have hFrob_pull : WeilLefschetzTorsionPullback φ_abs n q (AddMonoidHom.id _) :=
      hConvFrob φ_abs n q (AddMonoidHom.id _)
        (weil_abs_frob_pow_torsion_pullback_id p μ n q Y_bar.left φ_abs hφ_abs)
    have hαgeom_pull := (hβ_L_spec m).2.2 q
    have hRel_pull :=
      hPullCongr Y_bar.left Y_bar.left _ _ rfl n q _ _ (AddMonoidHom.id_comp _)
        (hPullComp φ_abs α_geom.hom n q (AddMonoidHom.id _) _ hFrob_pull hαgeom_pull)
    ext ι
    have hLHS_pull :=
      hPullComp (inc_comp ι) (CategoryTheory.CategoryStruct.comp φ_abs α_geom.hom) n q
        (pullH (inc_comp ι) n q) _ (hpullH_spec (inc_comp ι) n q) hRel_pull
    have hRHS_pull :=
      hPullCongr (Y_comp ι).left Y_bar.left _ _ (hα_comp_fac ι) n q _ _ rfl
        (hPullComp (α_comp ι) (inc_comp (π_α ι)) n q
          (pullH (α_comp ι) n q) (pullH (inc_comp (π_α ι)) n q)
          (hpullH_spec _ n q) (hpullH_spec _ n q))
    have h_eq_hom : (pullH (inc_comp ι) n q).comp _ =
        (pullH (α_comp ι) n q).comp (pullH (inc_comp (π_α ι)) n q) :=
      (hpullH_uniq _ n q _ hLHS_pull).trans (hpullH_uniq _ n q _ hRHS_pull).symm
    exact DFunLike.congr_fun h_eq_hom w
  let cast_L := fun m : ℕ =>
    (CategoryTheory.constantSheaf Y_bar.left.smallEtaleTopology AddCommGrpCat.{u}).map
      (AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1)))
            (ZMod (ℓ ^ (m + 1)))).toAddMonoidHom))
  have hr_comp_cast : ∀ (m q : ℕ)
      (w : CategoryTheory.Abelian.Ext Fℤ_Y
        (weilEtaleTorsionSheaf Y_bar.left (ℓ ^ (m + 1 + 1))) q),
      r_comp m q
        (((CategoryTheory.Abelian.Ext.mk₀ (cast_L m)).postcomp Fℤ_Y (Nat.add_zero q)) w) =
        fun j => weilEtaleTorsionTransition (Y_comp j).left ℓ (m + 1) q
          (r_comp (m + 1) q w j) := by
    intro m q w
    ext j
    exact (hPullTrans (inc_comp j) ℓ (m + 1) q
      (pullH (inc_comp j) (ℓ ^ (m + 1 + 1)) q)
      (pullH (inc_comp j) (ℓ ^ (m + 1)) q)
      (hpullH_spec _ _ _) (hpullH_spec _ _ _) w).symm

  
  obtain ⟨hSub₀, hFin_K0_raw, f₀_m, δ_m, g₁_m, g₂_m, hExc⟩ :=
    weil_abelian_ext_excision_tower_and_finiteness
      (CategoryTheory.Sheaf Y_bar.left.smallEtaleTopology AddCommGrpCat.{u})
      ℓ M_bdry m_c P_α hAdd_α hLim_α hColim_α Fℤ_Y αℤ_Y
      𝒥_Y (fun m => weilEtaleTorsionSheaf Y_bar.left (ℓ ^ (m + 1))) 𝒮_Y
      ι_JY ρ_SY h0_Y
      (fun m => (hS11 m).1)
      (fun m => hSub_H0 (𝒥_Y m) (hS11 m).2.1)
      hSub_Sq τ_J cast_L τ_S
      (fun m => (hS11 m).2.2.2.1)
      (fun m => (hS11 m).2.2.2.2.1)
      β_J β_L β_S hβ_ι hβ_ρ
      (fun m q => (𝒦 m).H q)
      α_H τ_H e_K he_K_τ he_K_α
      (fun m q j => weilEtaleTorsionH (Y_comp j).left (ℓ ^ (m + 1)) q)
      (fun m q j => weilEtaleTorsionTransition (Y_comp j).left ℓ (m + 1) q)
      act_comp r_comp hr_comp_act hr_comp_cast
      π_bdry e_S0 he_S0_act he_S0_cast

  have hFin_K0_imp :
      (∀ (ι : Fin m_c) (q : ℕ), Finite (weilEtaleTorsionH (Y_comp ι).left ℓ q)) →
        ∀ q : ℕ, Finite ((𝒦 0).H q) := by
    intro hFin
    refine hFin_K0_raw (fun j q => ?_)
    rw [Nat.zero_add, pow_one]
    exact hFin j q

  rw [← hGoalEq]
  exact ⟨hSub₀, hAnn_K, hFin_K0_imp, τ_H, τ_le_H, ι_bock_H, δ_bock_H, act_comp,
    f₀_m, δ_m, g₁_m, g₂_m, hBock1, hBock2, hBock3, hBock4, hBock5, hBock6, hBock7, hBock8,
    hact_τ, hact_off, hact_fix, hExc⟩

theorem weil_curve_tr_bockstein_limit_excision_trace (ℓ B₂ M_bdry m_c : ℕ) [Fact (Nat.Prime ℓ)]
    (π_bdry : Equiv.Perm (Fin M_bdry))
    (π_α : Equiv.Perm (Fin m_c))
    (b : Fin 3 → ℕ)
    (M_lat : ∀ i : Fin 3, Matrix (Fin (b i)) (Fin (b i)) (PadicInt ℓ))
    (H_K : ℕ → ℕ → Type u) [∀ q m, AddCommGroup (H_K q m)]
    (α_K : ∀ m q : ℕ, H_K q m →+ H_K q m)
    (τ_H : ∀ q m : ℕ, H_K q (m + 1) →+ H_K q m)
    (τ_le_H : ∀ (q a b : ℕ), a ≤ b → H_K q b →+ H_K q a)
    (ι_bock_H : ∀ q a b : ℕ, H_K q a →+ H_K q (a + b + 1))
    (δ_bock_H : ∀ q a b : ℕ, H_K q b →+ H_K (q + 1) a)
    (hSub₀ : ∀ m : ℕ, Subsingleton (H_K 0 m))
    (hAnn_K : ∀ (q m : ℕ) (x : H_K q m), (ℓ ^ (m + 1) : ℕ) • x = 0)
    (hFin_K0 : ∀ q : ℕ, Finite (H_K q 0))
    (hBock :
      (∀ q a : ℕ, τ_le_H q a a (le_refl a) = AddMonoidHom.id _) ∧
      (∀ (q a b : ℕ) (h : a ≤ b),
        τ_le_H q a (b + 1) (Nat.le_succ_of_le h) = (τ_le_H q a b h).comp (τ_H q b)) ∧
      (∀ (q a b : ℕ) (x : H_K q (a + b + 1)),
        τ_le_H q b (a + b + 1) (by omega) x = 0 ↔ ∃ y, ι_bock_H q a b y = x) ∧
      (∀ (q a b : ℕ) (x : H_K q b),
        δ_bock_H q a b x = 0 ↔ ∃ y, τ_le_H q b (a + b + 1) (by omega) y = x) ∧
      (∀ (q a b : ℕ) (y : H_K q a),
        τ_le_H q a (a + b + 1) (by omega) (ι_bock_H q a b y) = (ℓ ^ (b + 1) : ℕ) • y) ∧
      (∀ (q a b : ℕ) (y : H_K q (a + 1)),
        ι_bock_H q a b (τ_H q a y) =
          τ_le_H q (a + b + 1) (a + 1 + b + 1) (by omega) (ι_bock_H q (a + 1) b y)) ∧
      (∀ (q a b : ℕ) (y : H_K q b),
        τ_H (q + 1) a (δ_bock_H q (a + 1) b y) = δ_bock_H q a b y) ∧
      (∀ (q m : ℕ) (x : H_K q (m + 1)), τ_H q m (α_K (m + 1) q x) = α_K m q (τ_H q m x)))
    (hLat : ∀ (K : ℕ), 1 ≤ K → ∀ (i : Fin 3),
      let m := K - 1
      let M_i := ((M_lat i).map (PadicInt.toZModPow K)).mulVecLin
      ∃ q_i : (Fin (b i) → ZMod (ℓ ^ K)) →+ H_K i.1 m,
        (∀ x, q_i (M_i x) = α_K m i.1 (q_i x)) ∧
        (∀ x, q_i x = 0 → (ℓ ^ B₂ : ℕ) • x = 0) ∧
        (∀ y : H_K i.1 m, ∃ x, q_i x = (ℓ ^ B₂ : ℕ) • y))
    (H_comp : Fin m_c → ℕ → ℕ → Type u) [∀ ι q n, AddCommGroup (H_comp ι q n)]
    (τ_comp : ∀ (ι : Fin m_c) (q n : ℕ), H_comp ι q (n + 1) →+ H_comp ι q n)
    (hSub_comp0 : ∀ (ι : Fin m_c) (q : ℕ), Subsingleton (H_comp ι q 0))
    (hAnn_comp : ∀ (ι : Fin m_c) (q n : ℕ) (x : H_comp ι q n), (ℓ ^ n : ℕ) • x = 0)
    (hFin_comp : ∀ (ι : Fin m_c) (q n : ℕ), Finite (H_comp ι q n))
    (act_comp : ∀ (m q : ℕ),
      (∀ ι : Fin m_c, H_comp ι q (m + 1)) →+ (∀ ι : Fin m_c, H_comp ι q (m + 1)))
    (hact_τ : ∀ (m q : ℕ) (v : ∀ ι, H_comp ι q (m + 1 + 1)) (ι : Fin m_c),
      τ_comp ι q (m + 1) (act_comp (m + 1) q v ι) =
        act_comp m q (fun j => τ_comp j q (m + 1) (v j)) ι)
    (hact_off : ∀ (m q : ℕ) (ι : Fin m_c) (v : ∀ j, H_comp j q (m + 1)),
      v (π_α ι) = 0 → act_comp m q v ι = 0)
    (f₀_m : ∀ m : ℕ, (∀ ι : Fin m_c, H_comp ι 0 (m + 1)) →+ (Fin M_bdry → ZMod (ℓ ^ (m + 1))))
    (δ_m : ∀ m : ℕ, (Fin M_bdry → ZMod (ℓ ^ (m + 1))) →+ H_K 1 m)
    (g₁_m : ∀ m : ℕ, H_K 1 m →+ (∀ ι : Fin m_c, H_comp ι 1 (m + 1)))
    (g₂_m : ∀ m : ℕ, H_K 2 m ≃+ (∀ ι : Fin m_c, H_comp ι 2 (m + 1)))
    (hExc : ∀ m : ℕ,
      Function.Injective (f₀_m m) ∧
      AddMonoidHom.range (f₀_m m) = AddMonoidHom.ker (δ_m m) ∧
      AddMonoidHom.range (δ_m m) = AddMonoidHom.ker (g₁_m m) ∧
      Function.Surjective (g₁_m m) ∧
      (∀ v t, f₀_m m (act_comp m 0 v) t = f₀_m m v (π_bdry t)) ∧
      (∀ u, δ_m m (fun t => u (π_bdry t)) = α_K m 1 (δ_m m u)) ∧
      (∀ x, g₁_m m (α_K m 1 x) = act_comp m 1 (g₁_m m x)) ∧
      (∀ x, g₂_m m (α_K m 2 x) = act_comp m 2 (g₂_m m x)) ∧
      (∀ v t, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
          (f₀_m (m + 1) v t) =
        f₀_m m (fun j => τ_comp j 0 (m + 1) (v j)) t) ∧
      (∀ u, τ_H 1 m (δ_m (m + 1) u) =
        δ_m m (fun t => ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1))) (u t))) ∧
      (∀ x j, τ_comp j 1 (m + 1) (g₁_m (m + 1) x j) = g₁_m m (τ_H 1 m x) j) ∧
      (∀ x j, τ_comp j 2 (m + 1) (g₂_m (m + 1) x j) = g₂_m m (τ_H 2 m x) j))
    (V_fix : ∀ (ι : Fin m_c), π_α ι = ι → ℕ → Type u)
    [∀ ι h q, AddCommGroup (V_fix ι h q)]
    [∀ ι h q, Module (Padic ℓ) (V_fix ι h q)]
    [∀ ι h q, Module.Finite (Padic ℓ) (V_fix ι h q)]
    (Φ_fix : ∀ (ι : Fin m_c) (h : π_α ι = ι) (q : ℕ), V_fix ι h q →ₗ[Padic ℓ] V_fix ι h q)
    (hModel_fix : ∀ (ι : Fin m_c) (h : π_α ι = ι) (q : ℕ),
      let sys_ι : AddSubgroup (∀ n : ℕ, H_comp ι q n) :=
        AddMonoidHom.ker (AddMonoidHom.pi fun n =>
          (τ_comp ι q n).comp (Pi.evalAddMonoidHom (H_comp ι q) (n + 1)) -
          Pi.evalAddMonoidHom (H_comp ι q) n)
      ∃ (equiv_ι : TensorProduct ℤ ℚ ↥sys_ι ≃+ V_fix ι h q)
        (p_fix : ∀ n : ℕ, H_comp ι q n →+ H_comp ι q n),
        (∀ (z : PadicInt ℓ) (x y : ↥sys_ι),
          (∀ n : ℕ, y.1 n = (PadicInt.toZModPow n z).val • x.1 n) →
            equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ) • equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x)) ∧
        (∀ (x y : ↥sys_ι),
          (∀ n : ℕ, y.1 n = p_fix n (x.1 n)) →
            Φ_fix ι h q (equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv_ι (TensorProduct.tmul ℤ (1 : ℚ) y)) ∧
        (∀ (m : ℕ) (v : ∀ j, H_comp j q (m + 1)),
          act_comp m q v ι = p_fix (m + 1) (v ι))) :
    algebraMap (PadicInt ℓ) (Padic ℓ)
        (Matrix.trace (M_lat 0) - Matrix.trace (M_lat 1) + Matrix.trace (M_lat 2)) =
      (∑ ι : Fin m_c,
        if h : π_α ι = ι then
          ∑ i ∈ Finset.Iic 2,
            (-1 : Padic ℓ) ^ i * LinearMap.trace (Padic ℓ) (V_fix ι h i) (Φ_fix ι h i)
        else 0) -
      (Nat.card { t : Fin M_bdry // π_bdry t = t } : Padic ℓ) :=
by
  classical
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out
  have hNeZeroPow : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hPrime_ℓ.ne_zero⟩

  
  have hModNsmul : ∀ {G : Type u} [AddCommGroup G] (N : ℕ) [NeZero N] (w : G),
      N • w = 0 → ∀ k : ℕ, ((k : ZMod N).val) • w = k • w := by
    intro G _ N _ w hw k
    rw [ZMod.val_natCast]
    conv_rhs => rw [← Nat.div_add_mod k N]
    rw [add_nsmul, mul_nsmul, hw, smul_zero, zero_add]

  
  have hPadicLift : ∀ (u : ∀ k : ℕ, ZMod (ℓ ^ k)),
      (∀ k : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (u (k + 1)) = u k) →
      ∃ z : PadicInt ℓ, ∀ k : ℕ, PadicInt.toZModPow k z = u k := by
    intro u hu
    have hu_le : ∀ {k₁ k₂ : ℕ} (h : k₁ ≤ k₂),
        ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ k₁)) (u k₂) = u k₁ := by
      intro k₁ k₂ h
      induction h with
      | refl =>
        haveI := hNeZeroPow k₁
        calc ZMod.castHom (pow_dvd_pow ℓ (le_refl k₁)) (ZMod (ℓ ^ k₁)) (u k₁)
            = ZMod.castHom (pow_dvd_pow ℓ (le_refl k₁)) (ZMod (ℓ ^ k₁)) ((u k₁).val : ZMod (ℓ ^ k₁)) := by
                rw [ZMod.natCast_zmod_val]
          _ = ((u k₁).val : ZMod (ℓ ^ k₁)) := map_natCast _ _
          _ = u k₁ := ZMod.natCast_zmod_val _
      | @step m hm ih =>
        haveI := hNeZeroPow (m + 1)
        have hcast : ∀ x : ZMod (ℓ ^ (m + 1)),
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ_of_le hm)) (ZMod (ℓ ^ k₁)) x =
              ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ k₁))
                (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) x) := by
          intro x
          conv_lhs => rw [← ZMod.natCast_zmod_val x]
          conv_rhs => rw [← ZMod.natCast_zmod_val x]
          rw [map_natCast, map_natCast, map_natCast]
        rw [hcast (u (m + 1)), hu m, ih]
    let f_hom : ∀ k : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ k) :=
      fun k => (Polynomial.aeval (R := ℤ) (u k)).toRingHom
    have hf_compat : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (f_hom k₂) = f_hom k₁ := by
      intro k₁ k₂ hk
      apply Polynomial.ringHom_ext'
      · exact RingHom.ext_int _ _
      · simp only [f_hom, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Polynomial.aeval_X]
        exact hu_le hk
    refine ⟨PadicInt.lift hf_compat Polynomial.X, fun k => ?_⟩
    have hspec := RingHom.congr_fun (PadicInt.lift_spec hf_compat k) Polynomial.X
    simpa only [f_hom, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Polynomial.aeval_X] using hspec

  
  have hSeqKonig : ∀ {X : ℕ → Type u} [∀ m, Finite (X m)] [∀ m, Nonempty (X m)]
      (p : ∀ m : ℕ, X (m + 1) → X m),
      ∃ s : ∀ m : ℕ, X m, ∀ m : ℕ, p m (s (m + 1)) = s m := by
    intro X _ _ p
    let p_le : ∀ (b a : ℕ), a ≤ b → X b → X a :=
      @Nat.rec (fun b => ∀ a : ℕ, a ≤ b → X b → X a)
        (fun a h x => Nat.eq_zero_of_le_zero h ▸ x)
        (fun b ih a h x =>
          if h' : a ≤ b then ih a h' (p b x)
          else (Nat.le_antisymm h (Nat.gt_of_not_le h')).symm ▸ x)
    have hp_refl : ∀ (a : ℕ) (h : a ≤ a) (x : X a), p_le a a h x = x := by
      intro a h x
      cases a with
      | zero => rfl
      | succ b =>
        dsimp [p_le]
        rw [dif_neg (Nat.not_succ_le_self b)]
    have hp_step : ∀ {a b : ℕ} (h : a ≤ b) (x : X (b + 1)),
        p_le (b + 1) a (Nat.le_succ_of_le h) x = p_le b a h (p b x) := by
      intro a b h x
      dsimp [p_le]
      rw [dif_pos h]
    have hp_trans : ∀ {b c : ℕ} (hbc : b ≤ c) {a : ℕ} (hab : a ≤ b) (x : X c),
        p_le b a hab (p_le c b hbc x) = p_le c a (hab.trans hbc) x := by
      intro b c hbc
      induction hbc with
      | refl =>
        intro a hab x
        rw [hp_refl]
      | @step m hm ih =>
        intro a hab x
        rw [hp_step hm, hp_step (hab.trans hm), ih hab (p m x)]
    let F_inv : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun n => X (Opposite.unop n)
        map := fun f => TypeCat.ofHom (p_le _ _ (CategoryTheory.leOfHom f.unop))
        map_id := fun n => by
          ext x
          exact hp_refl (Opposite.unop n) _ x
        map_comp := fun f g => by
          ext x
          exact (hp_trans (CategoryTheory.leOfHom f.unop) (CategoryTheory.leOfHom g.unop) x).symm }
    haveI : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := fun j => ‹∀ m, Finite (X m)› (Opposite.unop j)
    haveI : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := fun j => ‹∀ m, Nonempty (X m)› (Opposite.unop j)
    obtain ⟨s, hs⟩ := nonempty_sections_of_finite_inverse_system F_inv
    refine ⟨fun m => s (Opposite.op m), fun m => ?_⟩
    have hm := hs (CategoryTheory.homOfLE (Nat.le_succ m)).op
    change p_le (m + 1) m (Nat.le_succ m) (s (Opposite.op (m + 1))) = s (Opposite.op m) at hm
    rwa [hp_step (le_refl m), hp_refl] at hm

  
  have hSysMod : ∀ (A : ℕ → Type u) [∀ n, AddCommGroup (A n)]
      (τ : ∀ n : ℕ, A (n + 1) →+ A n) (off : ℕ),
      (∀ (n : ℕ) (x : A n), (ℓ ^ (n + off) : ℕ) • x = 0) →
      let sys : AddSubgroup (∀ n : ℕ, A n) :=
        AddMonoidHom.ker (AddMonoidHom.pi fun n =>
          (τ n).comp (Pi.evalAddMonoidHom A (n + 1)) - Pi.evalAddMonoidHom A n)
      ∃ inst : Module (PadicInt ℓ) ↥sys,
        ∀ (z : PadicInt ℓ) (x : ↥sys) (n : ℕ),
          (@SMul.smul _ _ inst.toSMul z x).1 n =
            (PadicInt.toZModPow (n + off) z).val • x.1 n := by
    intro A _ τ off hAnn sys
    have hmem : ∀ (x : ∀ n, A n), x ∈ sys ↔ ∀ n : ℕ, τ n (x (n + 1)) = x n := by
      intro x
      simp only [sys, AddMonoidHom.mem_ker, AddMonoidHom.pi_apply, AddMonoidHom.sub_apply,
        AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, funext_iff, Pi.zero_apply, sub_eq_zero]
    have hsmul_mem : ∀ (z : PadicInt ℓ) (x : ↥sys),
        (fun n => (PadicInt.toZModPow (n + off) z).val • x.1 n) ∈ sys := by
      intro z x
      rw [hmem]
      intro n
      have hx := (hmem x.1).mp x.2 n
      rw [map_nsmul, hx]
      haveI := hNeZeroPow (n + off)
      haveI := hNeZeroPow (n + 1 + off)
      have hle : n + off ≤ n + 1 + off := by omega
      have hcast := RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (n + off) (n + 1 + off) hle) z
      simp only [RingHom.comp_apply] at hcast
      have hval_cast : PadicInt.toZModPow (n + off) z =
          ((PadicInt.toZModPow (n + 1 + off) z).val : ZMod (ℓ ^ (n + off))) := by
        rw [← hcast]
        conv_lhs => rw [← ZMod.natCast_zmod_val (PadicInt.toZModPow (n + 1 + off) z)]
        exact map_natCast _ _
      rw [hval_cast, hModNsmul (ℓ ^ (n + off)) (x.1 n) (hAnn n (x.1 n))]
    let smul_fn : PadicInt ℓ → ↥sys → ↥sys :=
      fun z x => ⟨fun n => (PadicInt.toZModPow (n + off) z).val • x.1 n, hsmul_mem z x⟩
    refine ⟨{
      smul := smul_fn
      one_smul := fun x => by
        apply Subtype.ext; funext n
        haveI := hNeZeroPow (n + off)
        change (PadicInt.toZModPow (n + off) 1).val • x.1 n = x.1 n
        rw [show (1 : PadicInt ℓ) = ((1 : ℕ) : PadicInt ℓ) by simp, map_natCast,
          hModNsmul (ℓ ^ (n + off)) (x.1 n) (hAnn n (x.1 n)), one_nsmul]
      mul_smul := fun z₁ z₂ x => by
        apply Subtype.ext; funext n
        haveI := hNeZeroPow (n + off)
        change (PadicInt.toZModPow (n + off) (z₁ * z₂)).val • x.1 n =
          (PadicInt.toZModPow (n + off) z₁).val • ((PadicInt.toZModPow (n + off) z₂).val • x.1 n)
        have hprod : PadicInt.toZModPow (n + off) (z₁ * z₂) =
            (((PadicInt.toZModPow (n + off) z₁).val * (PadicInt.toZModPow (n + off) z₂).val : ℕ) :
              ZMod (ℓ ^ (n + off))) := by
          rw [map_mul, Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
        rw [hprod, hModNsmul (ℓ ^ (n + off)) (x.1 n) (hAnn n (x.1 n)), mul_nsmul']
      smul_zero := fun z => by
        apply Subtype.ext; funext n
        exact smul_zero _
      smul_add := fun z x y => by
        apply Subtype.ext; funext n
        exact smul_add _ (x.1 n) (y.1 n)
      add_smul := fun z₁ z₂ x => by
        apply Subtype.ext; funext n
        haveI := hNeZeroPow (n + off)
        change (PadicInt.toZModPow (n + off) (z₁ + z₂)).val • x.1 n =
          (PadicInt.toZModPow (n + off) z₁).val • x.1 n +
            (PadicInt.toZModPow (n + off) z₂).val • x.1 n
        have hsum : PadicInt.toZModPow (n + off) (z₁ + z₂) =
            (((PadicInt.toZModPow (n + off) z₁).val + (PadicInt.toZModPow (n + off) z₂).val : ℕ) :
              ZMod (ℓ ^ (n + off))) := by
          rw [map_add, Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
        rw [hsum, hModNsmul (ℓ ^ (n + off)) (x.1 n) (hAnn n (x.1 n)), add_nsmul]
      zero_smul := fun x => by
        apply Subtype.ext; funext n
        change (PadicInt.toZModPow (n + off) 0).val • x.1 n = 0
        rw [map_zero, ZMod.val_zero, zero_smul]
    }, fun _ _ _ => rfl⟩

  
  have hSesTrace : ∀ {V₁ V₂ V₃ : Type u}
      [AddCommGroup V₁] [Module (Padic ℓ) V₁] [Module.Finite (Padic ℓ) V₁]
      [AddCommGroup V₂] [Module (Padic ℓ) V₂] [Module.Finite (Padic ℓ) V₂]
      [AddCommGroup V₃] [Module (Padic ℓ) V₃] [Module.Finite (Padic ℓ) V₃]
      (ι : V₁ →ₗ[Padic ℓ] V₂) (π : V₂ →ₗ[Padic ℓ] V₃)
      (T₁ : V₁ →ₗ[Padic ℓ] V₁) (T₂ : V₂ →ₗ[Padic ℓ] V₂) (T₃ : V₃ →ₗ[Padic ℓ] V₃),
      Function.Injective ι → Function.Surjective π → LinearMap.range ι = LinearMap.ker π →
      ι ∘ₗ T₁ = T₂ ∘ₗ ι → π ∘ₗ T₂ = T₃ ∘ₗ π →
      LinearMap.trace (Padic ℓ) V₂ T₂ =
        LinearMap.trace (Padic ℓ) V₁ T₁ + LinearMap.trace (Padic ℓ) V₃ T₃ := by
    intro V₁ V₂ V₃ _ _ _ _ _ _ _ _ _ ι π T₁ T₂ T₃ hι hπ hexact hT₁ hT₂
    obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective π (LinearMap.range_eq_top.mpr hπ)
    let S : (V₁ × V₃) →ₗ[Padic ℓ] V₂ := ι.coprod σ
    have hπ_ι : ∀ v₁ : V₁, π (ι v₁) = 0 := fun v₁ =>
      LinearMap.mem_ker.mp (hexact ▸ LinearMap.mem_range_self ι v₁)
    have hπ_σ : ∀ v₃ : V₃, π (σ v₃) = v₃ := fun v₃ => LinearMap.congr_fun hσ v₃
    have hS_inj : Function.Injective S := by
      intro p₁ p₂ hp
      have hsub : S (p₁ - p₂) = 0 := by rw [map_sub, hp, sub_self]
      dsimp [S] at hsub
      have hπ0 : π (ι (p₁.1 - p₂.1) + σ (p₁.2 - p₂.2)) = 0 := by rw [hsub, map_zero]
      rw [map_add, hπ_ι, zero_add, hπ_σ] at hπ0
      have hp2 : p₁.2 = p₂.2 := sub_eq_zero.mp hπ0
      rw [hπ0, map_zero, add_zero] at hsub
      have hp1 : p₁.1 = p₂.1 := sub_eq_zero.mp (hι (hsub.trans (map_zero ι).symm))
      exact Prod.ext hp1 hp2
    have hS_surj : Function.Surjective S := by
      intro v₂
      have hmem : v₂ - σ (π v₂) ∈ LinearMap.range ι := by
        rw [hexact, LinearMap.mem_ker, map_sub, hπ_σ, sub_self]
      obtain ⟨v₁, hv₁⟩ := hmem
      refine ⟨(v₁, π v₂), ?_⟩
      dsimp [S]
      rw [hv₁, sub_add_cancel]
    let E : (V₁ × V₃) ≃ₗ[Padic ℓ] V₂ := LinearEquiv.ofBijective S ⟨hS_inj, hS_surj⟩
    have hE_inl : ∀ v₁ : V₁, E (v₁, 0) = ι v₁ := by
      intro v₁; change ι v₁ + σ 0 = ι v₁; rw [map_zero, add_zero]
    have hπ_E : ∀ p : V₁ × V₃, π (E p) = p.2 := by
      intro p; change π (ι p.1 + σ p.2) = p.2; rw [map_add, hπ_ι, zero_add, hπ_σ]
    have hπ_Esymm : ∀ v₂ : V₂, (E.symm v₂).2 = π v₂ := by
      intro v₂
      have h := hπ_E (E.symm v₂)
      rw [E.apply_symm_apply] at h
      exact h.symm
    let T_conj : (V₁ × V₃) →ₗ[Padic ℓ] (V₁ × V₃) := E.symm.conj T₂
    have htr_conj : LinearMap.trace (Padic ℓ) V₂ T₂ =
        LinearMap.trace (Padic ℓ) (V₁ × V₃) T_conj :=
      (LinearMap.trace_conj' T₂ E.symm).symm
    let inl₁ := LinearMap.inl (Padic ℓ) V₁ V₃
    let inr₃ := LinearMap.inr (Padic ℓ) V₁ V₃
    let fst₁ := LinearMap.fst (Padic ℓ) V₁ V₃
    let snd₃ := LinearMap.snd (Padic ℓ) V₁ V₃
    have hdecomp : T_conj = (T_conj ∘ₗ inl₁) ∘ₗ fst₁ + (T_conj ∘ₗ inr₃) ∘ₗ snd₃ := by
      apply LinearMap.ext; rintro ⟨v₁, v₃⟩
      change T_conj (v₁, v₃) = T_conj (v₁, 0) + T_conj (0, v₃)
      rw [← map_add, Prod.mk_add_mk, add_zero, zero_add]
    have hblk1 : fst₁ ∘ₗ (T_conj ∘ₗ inl₁) = T₁ := by
      apply LinearMap.ext; intro v₁
      change (E.symm (T₂ (E (v₁, 0)))).1 = T₁ v₁
      rw [hE_inl]
      have hinter := LinearMap.congr_fun hT₁ v₁
      simp only [LinearMap.comp_apply] at hinter
      rw [← hinter, ← hE_inl (T₁ v₁), E.symm_apply_apply]
    have hblk2 : snd₃ ∘ₗ (T_conj ∘ₗ inr₃) = T₃ := by
      apply LinearMap.ext; intro v₃
      change (E.symm (T₂ (E (0, v₃)))).2 = T₃ v₃
      rw [hπ_Esymm]
      have hinter := LinearMap.congr_fun hT₂ (E (0, v₃))
      simp only [LinearMap.comp_apply] at hinter
      rw [hinter, hπ_E]
    rw [htr_conj, hdecomp, map_add, LinearMap.trace_comp_comm' fst₁ (T_conj ∘ₗ inl₁),
      LinearMap.trace_comp_comm' snd₃ (T_conj ∘ₗ inr₃), hblk1, hblk2]

  
  have hDVR : ∀ (M : Type u) [AddCommGroup M] [Module (PadicInt ℓ) M]
      [Module.Finite (PadicInt ℓ) M],
      ∃ (c e_M : ℕ) (v : Fin c → M),
        (∀ z : M, (∃ n : ℕ, ((ℓ : PadicInt ℓ) ^ n) • z = 0) →
          ((ℓ : PadicInt ℓ) ^ e_M) • z = 0) ∧
        (∀ (k : ℕ) (d₀ : Fin c → PadicInt ℓ) (u : M),
          ∑ t : Fin c, d₀ t • v t = ((ℓ : PadicInt ℓ) ^ k) • u →
            ∃ d₁ : Fin c → PadicInt ℓ, ∀ t : Fin c, d₀ t = ((ℓ : PadicInt ℓ) ^ k) * d₁ t) ∧
        (∀ w : M, ∃ d₀ : Fin c → PadicInt ℓ,
          ((ℓ : PadicInt ℓ) ^ e_M) • w = ∑ t : Fin c, d₀ t • v t) := by
    intro M _ _ _
    let T : Submodule (PadicInt ℓ) M := Submodule.torsion (PadicInt ℓ) M
    let π_T : M →ₗ[PadicInt ℓ] (M ⧸ T) := T.mkQ
    obtain ⟨c, bas⟩ := Module.basisOfFiniteTypeTorsionFree' (R := PadicInt ℓ) (M := M ⧸ T)
    let v : Fin c → M := fun t => Classical.choose (Submodule.mkQ_surjective T (bas t))
    have hv : ∀ t : Fin c, π_T (v t) = bas t :=
      fun t => Classical.choose_spec (Submodule.mkQ_surjective T (bas t))
    have hbas_sum : ∀ (f : Fin c → PadicInt ℓ) (s : Fin c),
        bas.equivFun (π_T (∑ t : Fin c, f t • v t)) s = f s := by
      intro f s
      rw [map_sum, map_sum, Finset.sum_apply]
      have hterm : ∀ t : Fin c, bas.equivFun (π_T (f t • v t)) s = if t = s then f s else 0 := by
        intro t
        rw [map_smul, hv, map_smul, Pi.smul_apply, Module.Basis.equivFun_self, smul_eq_mul]
        by_cases hts : t = s
        · subst hts; rw [if_pos rfl, if_pos rfl, mul_one]
        · rw [if_neg hts, if_neg hts, mul_zero]
      simp_rw [hterm]
      rw [Finset.sum_ite_eq', if_pos (Finset.mem_univ s)]
    have hT_pointwise : ∀ x : M, x ∈ T → ∃ k : ℕ, ((ℓ : PadicInt ℓ) ^ k) • x = 0 := by
      intro x hx
      rcases hx with ⟨a, ha0⟩
      have ha_ne : (a : PadicInt ℓ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp a.2
      rw [Submonoid.smul_def] at ha0
      let u_a := PadicInt.unitCoeff ha_ne
      let k_x := (a : PadicInt ℓ).valuation
      have hfac : (a : PadicInt ℓ) = (u_a : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ k_x :=
        PadicInt.unitCoeff_spec ha_ne
      refine ⟨k_x, ?_⟩
      calc ((ℓ : PadicInt ℓ) ^ k_x) • x
          = (1 : PadicInt ℓ) • (((ℓ : PadicInt ℓ) ^ k_x) • x) := (one_smul (PadicInt ℓ) _).symm
        _ = (((↑u_a⁻¹ : PadicInt ℓ) * (u_a : PadicInt ℓ)) * (ℓ : PadicInt ℓ) ^ k_x) • x := by
            rw [Units.inv_mul, smul_smul]
        _ = (↑u_a⁻¹ : PadicInt ℓ) • ((a : PadicInt ℓ) • x) := by rw [mul_assoc, ← hfac, smul_smul]
        _ = 0 := by rw [ha0, smul_zero]
    haveI : IsNoetherian (PadicInt ℓ) M := isNoetherian_of_isNoetherianRing_of_finite (PadicInt ℓ) M
    obtain ⟨m_gen, g_gen, hspan_T⟩ :=
      Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian T)
    have hg_mem : ∀ i : Fin m_gen, g_gen i ∈ T := fun i =>
      hspan_T ▸ Submodule.subset_span ⟨i, rfl⟩
    let k_fn : Fin m_gen → ℕ := fun i => Classical.choose (hT_pointwise (g_gen i) (hg_mem i))
    have hk_fn : ∀ i : Fin m_gen, ((ℓ : PadicInt ℓ) ^ k_fn i) • g_gen i = 0 :=
      fun i => Classical.choose_spec (hT_pointwise (g_gen i) (hg_mem i))
    let e_M : ℕ := Finset.univ.sup k_fn
    have hT_kill : ∀ z : M, z ∈ T → ((ℓ : PadicInt ℓ) ^ e_M) • z = 0 := by
      have hle : T ≤ LinearMap.ker (LinearMap.lsmul (PadicInt ℓ) M ((ℓ : PadicInt ℓ) ^ e_M)) := by
        rw [← hspan_T, Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.lsmul_apply]
        have hi : k_fn i ≤ e_M := Finset.le_sup (Finset.mem_univ i)
        have hexp : e_M = (e_M - k_fn i) + k_fn i := (Nat.sub_add_cancel hi).symm
        rw [hexp, pow_add, mul_smul, hk_fn i, smul_zero]
      intro z hz
      exact LinearMap.mem_ker.mp (hle hz)
    have hℓ_ne : (ℓ : PadicInt ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hPrime_ℓ.ne_zero
    refine ⟨c, e_M, v, ?_, ?_, ?_⟩
    · intro z ⟨n, hn⟩
      exact hT_kill z ⟨⟨(ℓ : PadicInt ℓ) ^ n, mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hℓ_ne)⟩, hn⟩
    · intro k d₀ u hsum
      refine ⟨fun t => bas.equivFun (π_T u) t, fun t => ?_⟩
      have hq := congrArg (fun x => bas.equivFun (π_T x) t) hsum
      rw [hbas_sum d₀ t, map_smul, map_smul, Pi.smul_apply, smul_eq_mul] at hq
      exact hq
    · intro w
      let c₀ : Fin c → PadicInt ℓ := bas.equivFun (π_T w)
      have hz₀_mem : w - ∑ t : Fin c, c₀ t • v t ∈ T := by
        rw [← Submodule.ker_mkQ T, LinearMap.mem_ker]
        apply bas.equivFun.injective
        funext s
        rw [map_sub, map_sub, Pi.sub_apply, hbas_sum c₀ s, map_zero, Pi.zero_apply]
        exact sub_self (c₀ s)
      have hkill := hT_kill _ hz₀_mem
      rw [smul_sub, sub_eq_zero] at hkill
      refine ⟨fun t => ((ℓ : PadicInt ℓ) ^ e_M) * c₀ t, ?_⟩
      rw [hkill, Finset.smul_sum]
      refine Finset.sum_congr rfl fun t _ => ?_
      rw [smul_smul]

  
  let sys_K : ∀ q : ℕ, AddSubgroup (∀ m : ℕ, H_K q m) := fun q =>
    AddMonoidHom.ker (AddMonoidHom.pi fun m =>
      (τ_H q m).comp (Pi.evalAddMonoidHom (H_K q) (m + 1)) - Pi.evalAddMonoidHom (H_K q) m)
  have hInstK_ex : ∀ q : ℕ,
      ∃ inst : Module (PadicInt ℓ) ↥(sys_K q),
        ∀ (z : PadicInt ℓ) (x : ↥(sys_K q)) (m : ℕ),
          (@SMul.smul _ _ inst.toSMul z x).1 m =
            (PadicInt.toZModPow (m + 1) z).val • x.1 m :=
    fun q => hSysMod (H_K q) (τ_H q) 1 (hAnn_K q)
  let instK : ∀ q : ℕ, Module (PadicInt ℓ) ↥(sys_K q) :=
    fun q => Classical.choose (hInstK_ex q)
  letI : ∀ q : ℕ, Module (PadicInt ℓ) ↥(sys_K q) := instK
  have hsmul_K : ∀ (q : ℕ) (z : PadicInt ℓ) (x : ↥(sys_K q)) (m : ℕ),
      (z • x).1 m = (PadicInt.toZModPow (m + 1) z).val • x.1 m :=
    fun q => Classical.choose_spec (hInstK_ex q)

  have hmem_sysK : ∀ {q : ℕ} {f : ∀ m : ℕ, H_K q m},
      f ∈ sys_K q ↔ ∀ m : ℕ, τ_H q m (f (m + 1)) = f m := by
    intro q f
    simp only [sys_K, AddMonoidHom.mem_ker, AddMonoidHom.pi_apply, AddMonoidHom.sub_apply,
      AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, funext_iff, Pi.zero_apply, sub_eq_zero]

  have hpow_smul_K : ∀ (q k : ℕ) (x : ↥(sys_K q)) (m : ℕ),
      ((((ℓ : PadicInt ℓ) ^ k) • x).1 m) = (ℓ ^ k : ℕ) • x.1 m := by
    intro q k x m
    haveI := hNeZeroPow (m + 1)
    rw [hsmul_K, show ((ℓ : PadicInt ℓ) ^ k) = ((ℓ ^ k : ℕ) : PadicInt ℓ) by push_cast; rfl,
      map_natCast, hModNsmul (ℓ ^ (m + 1)) (x.1 m) (hAnn_K q m (x.1 m))]

  obtain ⟨hBock1, hBock2, hBock3, hBock4, hBock5, hBock6, hBock7, hBock8⟩ := hBock

  have hτ_step : ∀ (q a : ℕ), τ_le_H q a (a + 1) (Nat.le_succ a) = τ_H q a := by
    intro q a
    have h := hBock2 q a a (le_refl a)
    rwa [hBock1, AddMonoidHom.id_comp] at h

  have hτ_trans : ∀ {q a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c) (x : H_K q c),
      τ_le_H q a b hab (τ_le_H q b c hbc x) = τ_le_H q a c (hab.trans hbc) x := by
    intro q a b c hab hbc
    induction hbc with
    | refl =>
      intro x
      rw [hBock1, AddMonoidHom.id_apply]
    | @step m hm ih =>
      intro x
      rw [hBock2 q b m hm, AddMonoidHom.comp_apply, ih, ← AddMonoidHom.comp_apply,
        ← hBock2 q a m (hab.trans hm)]

  have hL_le : ∀ {q a b : ℕ} (hab : a ≤ b) (x : ↥(sys_K q)),
      τ_le_H q a b hab (x.1 b) = x.1 a := by
    intro q a b hab x
    induction hab with
    | refl => rw [hBock1, AddMonoidHom.id_apply]
    | @step m hm ih =>
      rw [hBock2 q a m hm, AddMonoidHom.comp_apply, hmem_sysK.mp x.2 m, ih]

  have hFin_K : ∀ q m : ℕ, Finite (H_K q m) := by
    suffices hall : ∀ m q : ℕ, Finite (H_K q m) from fun q m => hall m q
    intro m
    induction m with
    | zero => exact hFin_K0
    | succ m ih =>
      intro q
      let f : H_K q (m + 0 + 1) →+ H_K q 0 := τ_le_H q 0 (m + 0 + 1) (by omega)
      have hker_eq : (f.ker : Set (H_K q (m + 1))) = Set.range (ι_bock_H q m 0) := by
        ext x
        exact hBock3 q m 0 x
      haveI : Finite (H_K q m) := ih q
      haveI : Finite ↥f.ker := by
        have hfin_set : (f.ker : Set (H_K q (m + 1))).Finite := by
          rw [hker_eq]
          exact Set.finite_range _
        exact hfin_set.to_subtype
      haveI : Finite (H_K q 0) := hFin_K0 q
      haveI : Finite ↥(Set.range f) := Subtype.finite
      let sec : ↥(Set.range f) → H_K q (m + 1) := fun y => Classical.choose y.2
      have hsec : ∀ y : ↥(Set.range f), f (sec y) = y.1 := fun y => Classical.choose_spec y.2
      let y_of : H_K q (m + 1) → ↥(Set.range f) := fun x => ⟨f x, x, rfl⟩
      have hmem_sec : ∀ x : H_K q (m + 1), x - sec (y_of x) ∈ f.ker := by
        intro x
        rw [AddMonoidHom.mem_ker, map_sub, hsec (y_of x)]
        exact sub_self (f x)
      refine Finite.of_injective
        (fun x : H_K q (m + 1) =>
          (y_of x, (⟨x - sec (y_of x), hmem_sec x⟩ : ↥f.ker))) ?_
      intro x₁ x₂ h
      have h1 : y_of x₁ = y_of x₂ := congrArg Prod.fst h
      have h2 : x₁ - sec (y_of x₁) = x₂ - sec (y_of x₂) :=
        congrArg (fun p => p.2.1) h
      rw [h1] at h2
      exact sub_left_inj.mp h2

  have hKer_K : ∀ (q b_idx : ℕ) (x : ↥(sys_K q)),
      x.1 b_idx = 0 → ∃ u : ↥(sys_K q), x = ((ℓ : PadicInt ℓ) ^ (b_idx + 1)) • u := by
    intro q b_idx x hxb
    let E : ℕ → Type u := fun a => { y : H_K q a // ι_bock_H q a b_idx y = x.1 (a + b_idx + 1) }
    haveI : ∀ a : ℕ, Finite (E a) := fun a => by
      haveI := hFin_K q a
      exact Subtype.finite
    haveI : ∀ a : ℕ, Nonempty (E a) := fun a => by
      have h0 : τ_le_H q b_idx (a + b_idx + 1) (by omega) (x.1 (a + b_idx + 1)) = 0 := by
        rw [hL_le (by omega) x, hxb]
      obtain ⟨y, hy⟩ := (hBock3 q a b_idx (x.1 (a + b_idx + 1))).mp h0
      exact ⟨⟨y, hy⟩⟩
    let p_E : ∀ a : ℕ, E (a + 1) → E a := fun a y =>
      ⟨τ_H q a y.1, by
        rw [hBock6 q a b_idx y.1, y.2]
        exact hL_le (by omega) x⟩
    obtain ⟨s_E, hs_E⟩ := hSeqKonig p_E
    let u : ↥(sys_K q) :=
      ⟨fun a => (s_E a).1, hmem_sysK.mpr fun a => congrArg Subtype.val (hs_E a)⟩
    refine ⟨u, ?_⟩
    apply Subtype.ext; funext a
    rw [hpow_smul_K, ← hBock5 q a b_idx (u.1 a), (s_E a).2, hL_le (by omega) x]

  have hFinMod_K : ∀ q : ℕ, Module.Finite (PadicInt ℓ) ↥(sys_K q) := by
    intro q
    let S₀ : Set (H_K q 0) := Set.range (fun w : ↥(sys_K q) => w.1 0)
    haveI : Finite (H_K q 0) := hFin_K0 q
    haveI : Finite ↥S₀ := Subtype.finite
    let M_gen := Nat.card ↥S₀
    let e_gen : Fin M_gen ≃ ↥S₀ := (Finite.equivFin ↥S₀).symm
    let g_gen : Fin M_gen → ↥(sys_K q) := fun j => Classical.choose (e_gen j).2
    have hg_gen : ∀ j : Fin M_gen, (g_gen j).1 0 = (e_gen j).1 :=
      fun j => Classical.choose_spec (e_gen j).2
    let j_of : ↥(sys_K q) → Fin M_gen := fun w => e_gen.symm ⟨w.1 0, ⟨w, rfl⟩⟩
    have hj_of : ∀ w : ↥(sys_K q), (g_gen (j_of w)).1 0 = w.1 0 := by
      intro w
      dsimp [j_of]
      rw [hg_gen, e_gen.apply_symm_apply]
    have hstep_div : ∀ w : ↥(sys_K q),
        ∃ w' : ↥(sys_K q), w = g_gen (j_of w) + (ℓ : PadicInt ℓ) • w' := by
      intro w
      have h0 : (w - g_gen (j_of w)).1 0 = 0 := sub_eq_zero.mpr (hj_of w).symm
      obtain ⟨w', hw'⟩ := hKer_K q 0 (w - g_gen (j_of w)) h0
      rw [pow_one] at hw'
      exact ⟨w', eq_add_of_sub_eq' hw'⟩
    let next_of : ↥(sys_K q) → ↥(sys_K q) := fun w => Classical.choose (hstep_div w)
    have hnext_of : ∀ w : ↥(sys_K q), w = g_gen (j_of w) + (ℓ : PadicInt ℓ) • next_of w :=
      fun w => Classical.choose_spec (hstep_div w)
    apply Module.Finite.of_fg_top
    refine ⟨Finset.univ.image g_gen, ?_⟩
    rw [eq_top_iff]
    intro x _
    let x_seq : ℕ → ↥(sys_K q) := fun t => Nat.rec x (fun _ cur => next_of cur) t
    have hx_expand : ∀ k : ℕ,
        x = (∑ t ∈ Finset.range k, ((ℓ : PadicInt ℓ) ^ t) • g_gen (j_of (x_seq t))) +
          ((ℓ : PadicInt ℓ) ^ k) • x_seq k := by
      intro k
      induction k with
      | zero => simp [x_seq]
      | succ k ih =>
        have hstep : x_seq k = g_gen (j_of (x_seq k)) + (ℓ : PadicInt ℓ) • x_seq (k + 1) :=
          hnext_of (x_seq k)
        calc x = (∑ t ∈ Finset.range k, ((ℓ : PadicInt ℓ) ^ t) • g_gen (j_of (x_seq t))) +
                ((ℓ : PadicInt ℓ) ^ k) • x_seq k := ih
          _ = (∑ t ∈ Finset.range k, ((ℓ : PadicInt ℓ) ^ t) • g_gen (j_of (x_seq t))) +
                ((ℓ : PadicInt ℓ) ^ k) • (g_gen (j_of (x_seq k)) + (ℓ : PadicInt ℓ) • x_seq (k + 1)) := by
                rw [← hstep]
          _ = (∑ t ∈ Finset.range (k + 1), ((ℓ : PadicInt ℓ) ^ t) • g_gen (j_of (x_seq t))) +
                ((ℓ : PadicInt ℓ) ^ (k + 1)) • x_seq (k + 1) := by
                rw [Finset.sum_range_succ, smul_add, smul_smul, ← pow_succ, add_assoc]
    let eps : ℕ → Fin M_gen → ℕ := fun t j => if j = j_of (x_seq t) then 1 else 0
    have hc_ex : ∀ j : Fin M_gen, ∃ c_j : PadicInt ℓ, ∀ k : ℕ,
        PadicInt.toZModPow k c_j =
          ((∑ t ∈ Finset.range k, eps t j * ℓ ^ t : ℕ) : ZMod (ℓ ^ k)) := by
      intro j
      apply hPadicLift
      intro k
      rw [map_natCast, Finset.sum_range_succ, Nat.cast_add, Nat.cast_mul, ZMod.natCast_self,
        mul_zero, add_zero]
    let c_fn : Fin M_gen → PadicInt ℓ := fun j => Classical.choose (hc_ex j)
    have hc_fn : ∀ (j : Fin M_gen) (k : ℕ),
        PadicInt.toZModPow k (c_fn j) =
          ((∑ t ∈ Finset.range k, eps t j * ℓ ^ t : ℕ) : ZMod (ℓ ^ k)) :=
      fun j k => Classical.choose_spec (hc_ex j) k
    have hx_eq : x = ∑ j : Fin M_gen, c_fn j • g_gen j := by
      apply Subtype.ext; funext m
      have hexp := congrArg (fun w : ↥(sys_K q) => w.1 m) (hx_expand (m + 1))
      change x.1 m =
        (∑ t ∈ Finset.range (m + 1), (((ℓ : PadicInt ℓ) ^ t) • g_gen (j_of (x_seq t)))).1 m +
          (((ℓ : PadicInt ℓ) ^ (m + 1)) • x_seq (m + 1)).1 m at hexp
      rw [hpow_smul_K, hAnn_K q m, add_zero] at hexp
      have hval_sum : ∀ {ι₀ : Type} (s : Finset ι₀) (f : ι₀ → ↥(sys_K q)),
          (∑ i ∈ s, f i).1 m = ∑ i ∈ s, (f i).1 m := by
        intro ι₀ s f
        exact map_sum ((Pi.evalAddMonoidHom (H_K q) m).comp (sys_K q).subtype) f s
      rw [hexp, hval_sum, hval_sum]
      haveI := hNeZeroPow (m + 1)
      calc ∑ t ∈ Finset.range (m + 1), (((ℓ : PadicInt ℓ) ^ t) • g_gen (j_of (x_seq t))).1 m
          = ∑ t ∈ Finset.range (m + 1), (ℓ ^ t : ℕ) • (g_gen (j_of (x_seq t))).1 m := by
              refine Finset.sum_congr rfl fun t _ => hpow_smul_K q t _ m
        _ = ∑ t ∈ Finset.range (m + 1),
              ∑ j : Fin M_gen, (eps t j * ℓ ^ t) • (g_gen j).1 m := by
              refine Finset.sum_congr rfl fun t _ => ?_
              rw [Finset.sum_eq_single (j_of (x_seq t))]
              · simp [eps]
              · intro j _ hj; simp [eps, hj]
              · intro hmem; exact False.elim (hmem (Finset.mem_univ _))
        _ = ∑ j : Fin M_gen,
              (∑ t ∈ Finset.range (m + 1), eps t j * ℓ ^ t) • (g_gen j).1 m := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => Finset.sum_smul.symm
        _ = ∑ j : Fin M_gen, (c_fn j • g_gen j).1 m := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [hsmul_K, hc_fn, hModNsmul (ℓ ^ (m + 1)) _ (hAnn_K q m _)]
    rw [hx_eq]
    refine Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ ?_
    apply Submodule.subset_span
    exact Finset.mem_coe.mpr (Finset.mem_image_of_mem g_gen (Finset.mem_univ j))

  have hDelta_K : ∀ (q b_idx : ℕ),
      ∃ δ_hat : H_K q b_idx →+ ↥(sys_K (q + 1)),
        (∀ y : H_K q b_idx, ((ℓ : PadicInt ℓ) ^ (b_idx + 1)) • (δ_hat y) = 0) ∧
        (∀ y : H_K q b_idx, δ_hat y = 0 → ∃ x : ↥(sys_K q), x.1 b_idx = y) := by
    intro q b_idx
    let δ_hat : H_K q b_idx →+ ↥(sys_K (q + 1)) :=
      { toFun := fun y => ⟨fun a => δ_bock_H q a b_idx y, hmem_sysK.mpr fun a => hBock7 q a b_idx y⟩
        map_zero' := by apply Subtype.ext; funext a; exact map_zero _
        map_add' := fun y₁ y₂ => by apply Subtype.ext; funext a; exact map_add _ y₁ y₂ }
    refine ⟨δ_hat, ?_, ?_⟩
    · intro y
      apply Subtype.ext; funext a
      rw [hpow_smul_K]
      change (ℓ ^ (b_idx + 1) : ℕ) • δ_bock_H q a b_idx y = 0
      rw [← map_nsmul, hAnn_K q b_idx y, map_zero]
    · intro y hy
      let W : ℕ → Type u := fun a =>
        { u : H_K q (a + b_idx + 1) // τ_le_H q b_idx (a + b_idx + 1) (by omega) u = y }
      haveI : ∀ a : ℕ, Finite (W a) := fun a => by
        haveI := hFin_K q (a + b_idx + 1)
        exact Subtype.finite
      haveI : ∀ a : ℕ, Nonempty (W a) := fun a => by
        have h0 : δ_bock_H q a b_idx y = 0 := congrArg (fun z : ↥(sys_K (q + 1)) => z.1 a) hy
        obtain ⟨u, hu⟩ := (hBock4 q a b_idx y).mp h0
        exact ⟨⟨u, hu⟩⟩
      let p_W : ∀ a : ℕ, W (a + 1) → W a := fun a u =>
        ⟨τ_le_H q (a + b_idx + 1) (a + 1 + b_idx + 1) (by omega) u.1, by
          rw [hτ_trans]
          exact u.2⟩
      obtain ⟨s_W, hs_W⟩ := hSeqKonig p_W
      refine ⟨⟨fun m => τ_le_H q m (m + b_idx + 1) (by omega) (s_W m).1, ?_⟩, (s_W b_idx).2⟩
      rw [hmem_sysK]
      intro m
      have hm := congrArg Subtype.val (hs_W m)
      dsimp [p_W] at hm
      calc τ_H q m (τ_le_H q (m + 1) (m + 1 + b_idx + 1) (by omega) (s_W (m + 1)).1)
          = τ_le_H q m (m + 1) (Nat.le_succ m)
              (τ_le_H q (m + 1) (m + 1 + b_idx + 1) (by omega) (s_W (m + 1)).1) := by
              rw [hτ_step]
        _ = τ_le_H q m (m + 1 + b_idx + 1) (by omega) (s_W (m + 1)).1 := hτ_trans _ _ _
        _ = τ_le_H q m (m + b_idx + 1) (by omega)
              (τ_le_H q (m + b_idx + 1) (m + 1 + b_idx + 1) (by omega) (s_W (m + 1)).1) :=
              (hτ_trans (by omega) (by omega) _).symm
        _ = τ_le_H q m (m + b_idx + 1) (by omega) (s_W m).1 := by rw [hm]

  
  have hLatTrace : ∀ (b_M c e_L e_next : ℕ)
      (M_i : Matrix (Fin b_M) (Fin b_M) (PadicInt ℓ))
      (L : Type u) [AddCommGroup L] [Module (PadicInt ℓ) L] [Module.Finite (PadicInt ℓ) L]
      (Φ : L →ₗ[PadicInt ℓ] L)
      (v : Fin c → L)
      (hDiv : ∀ (k : ℕ) (d₀ : Fin c → PadicInt ℓ) (u : L),
        ∑ t : Fin c, d₀ t • v t = ((ℓ : PadicInt ℓ) ^ k) • u →
          ∃ d₁ : Fin c → PadicInt ℓ, ∀ t : Fin c, d₀ t = ((ℓ : PadicInt ℓ) ^ k) * d₁ t)
      (hSpan : ∀ w : L, ∃ d₀ : Fin c → PadicInt ℓ,
        ((ℓ : PadicInt ℓ) ^ e_L) • w = ∑ t : Fin c, d₀ t • v t)
      (A : ℕ → Type u) [∀ K, AddCommGroup (A K)]
      (α : ∀ K : ℕ, A K →+ A K)
      (hAnn_A : ∀ (K : ℕ), 1 ≤ K → ∀ y : A K, (ℓ ^ K : ℕ) • y = 0)
      (ev : ∀ (K : ℕ), 1 ≤ K → L →+ A K)
      (hev_Φ : ∀ (K : ℕ) (hK : 1 ≤ K) (x : L), ev K hK (Φ x) = α K (ev K hK x))
      (hev_smul : ∀ (K : ℕ) (hK : 1 ≤ K) (z : PadicInt ℓ) (x : L),
        ev K hK (z • x) = (PadicInt.toZModPow K z).val • ev K hK x)
      (hev_ker : ∀ (K : ℕ) (hK : 1 ≤ K) (x : L),
        ev K hK x = 0 → ∃ u : L, x = ((ℓ : PadicInt ℓ) ^ K) • u)
      (hev_coker : ∀ (K : ℕ) (hK : 1 ≤ K) (y : A K),
        ∃ x : L, ev K hK x = (ℓ ^ e_next : ℕ) • y)
      (hLat_M : ∀ (K : ℕ), 1 ≤ K →
        let M_mod := (M_i.map (PadicInt.toZModPow K)).mulVecLin
        ∃ q_M : (Fin b_M → ZMod (ℓ ^ K)) →+ A K,
          (∀ x, q_M (M_mod x) = α K (q_M x)) ∧
          (∀ x, q_M x = 0 → (ℓ ^ B₂ : ℕ) • x = 0) ∧
          (∀ y : A K, ∃ x, q_M x = (ℓ ^ B₂ : ℕ) • y)),
      algebraMap (PadicInt ℓ) (Padic ℓ) (Matrix.trace M_i) =
        LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) L)
          (LinearMap.baseChange (Padic ℓ) Φ) := by
    intro b_M c e_L e_next M_i L _ _ _ Φ v hDiv hSpan A _ α hAnn_A ev hev_Φ hev_smul hev_ker
      hev_coker hLat_M
    have hv_uniq : ∀ (a₁ a₂ : Fin c → PadicInt ℓ),
        ∑ t : Fin c, a₁ t • v t = ∑ t : Fin c, a₂ t • v t → a₁ = a₂ := by
      intro a₁ a₂ heq
      have h0 : ∑ t : Fin c, (a₁ t - a₂ t) • v t = 0 := by
        simp_rw [sub_smul]
        rw [Finset.sum_sub_distrib, heq, sub_self]
      funext t
      apply sub_eq_zero.mp
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      have h0' : ∑ s : Fin c, (a₁ s - a₂ s) • v s = ((ℓ : PadicInt ℓ) ^ k) • (0 : L) := by
        rw [h0, smul_zero]
      obtain ⟨d₁, hd₁⟩ := hDiv k (fun s => a₁ s - a₂ s) 0 h0'
      rw [hd₁ t, map_mul, map_zero,
        show ((ℓ : PadicInt ℓ) ^ k) = ((ℓ ^ k : ℕ) : PadicInt ℓ) by push_cast; rfl,
        map_natCast, ZMod.natCast_self, zero_mul]
    have hn_ex : ∀ j : Fin c, ∃ n_j : Fin c → PadicInt ℓ,
        ((ℓ : PadicInt ℓ) ^ e_L) • Φ (v j) = ∑ t : Fin c, (((ℓ : PadicInt ℓ) ^ e_L) * n_j t) • v t := by
      intro j
      obtain ⟨d₀, hd₀⟩ := hSpan (Φ (v j))
      obtain ⟨n_j, hn_j⟩ := hDiv e_L d₀ (Φ (v j)) hd₀.symm
      refine ⟨n_j, ?_⟩
      rw [hd₀]
      exact Finset.sum_congr rfl fun t _ => by rw [hn_j t]
    let n_col : Fin c → Fin c → PadicInt ℓ := fun j => Classical.choose (hn_ex j)
    have hn_col : ∀ j : Fin c,
        ((ℓ : PadicInt ℓ) ^ e_L) • Φ (v j) = ∑ t : Fin c, (((ℓ : PadicInt ℓ) ^ e_L) * n_col j t) • v t :=
      fun j => Classical.choose_spec (hn_ex j)
    let N_lat : Matrix (Fin c) (Fin c) (PadicInt ℓ) := Matrix.of (fun t j => n_col j t)
