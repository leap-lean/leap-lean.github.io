  obtain ⟨hSub₀, hAnn_K, hFin_K0_imp, τ_H, τ_le_H, ι_bock_H, δ_bock_H, act_comp,
    f₀_m, δ_m, g₁_m, g₂_m, hBock1, hBock2, hBock3, hBock4, hBock5, hBock6, hBock7, hBock8,
    hact_τ, hact_off, hact_fix, hExc⟩ :=
    weil_curve_tr_finite_pushforward_and_boundary_excision k (ringChar F) ℓ μ d_cov m_bdry M_bdry
      m_c m_sheet hd_cov hm_c hm_sheet D_bar V_bar U_bar ι_bar π_bar hπ_ι hπ_et hπ_surj hSheets
      s_bdry hs_bdry hU_compl Y_bar p_bar hp_locFree j_V hj_V_open hj_p hj_range
      z_bdry hz_bdry hz_disj hz_compl Y_comp inc_comp hcomp_short hcomp_disj hcomp_univ
      g_Dr_iso g_D_r hg_Dr_eq α_σ hα_ι α_geom hα_p hα_j φ_abs hφ_abs π_bdry hπ_bdry π_α hπ_α
      α_fix (fun ι h => (hα_fix_all ι h).1) 𝒦 τ_𝒦 triv_K htriv_K α_H hα_H
  have hFin_K0 : ∀ q : ℕ, Finite ((𝒦 0).H q) :=
    hFin_K0_imp (fun ι q => pow_one ℓ ▸ hFin_comp ι q 1)
  have hLef_fix := fun (ι : Fin m_c) (h : π_α ι = ι) =>
    (weil_algClosed_transversal_endomorphism_lefschetz_trace k 1 (Y_comp ι)
      (hcomp_all ι).2.2.2.1 ℓ hUnit_ℓ).2.2 (α_fix ι h) (hα_fix_hom ι h)
      (hα_fix_all ι h).2.1 (hα_fix_all ι h).2.2
  let H_fix : ∀ (ι : Fin m_c) (h : π_α ι = ι) (q : ℕ),
      WeilLefschetzEllAdicSpace (Y_comp ι).left ℓ q :=
    fun ι h => Classical.choose (hLef_fix ι h)
  let Φ_fix : ∀ (ι : Fin m_c) (h : π_α ι = ι) (q : ℕ),
      (H_fix ι h q).V →ₗ[Padic ℓ] (H_fix ι h q).V :=
    fun ι h => Classical.choose (Classical.choose_spec (hLef_fix ι h))
  have hSpec_fix := fun (ι : Fin m_c) (h : π_α ι = ι) =>
    Classical.choose_spec (Classical.choose_spec (hLef_fix ι h))
  let _ : ∀ (ι : Fin m_c) (h : π_α ι = ι) (q : ℕ), Module.Finite (Padic ℓ) (H_fix ι h q).V :=
    fun ι h q => (hSpec_fix ι h).1 q
  have hSub_comp0 : ∀ (ι : Fin m_c) (q : ℕ),
      Subsingleton (weilEtaleTorsionH (Y_comp ι).left (ℓ ^ 0) q) := by
    intro ι q
    refine ⟨fun x y => ?_⟩
    have hx : x = 0 := by
      have h1 := hTorsAnn (Y_comp ι).left (ℓ ^ 0) q x
      simpa only [pow_zero, one_nsmul] using h1
    have hy : y = 0 := by
      have h1 := hTorsAnn (Y_comp ι).left (ℓ ^ 0) q y
      simpa only [pow_zero, one_nsmul] using h1
    exact hx.trans hy.symm
  have hAnn_comp : ∀ (ι : Fin m_c) (q n : ℕ) (x : weilEtaleTorsionH (Y_comp ι).left (ℓ ^ n) q),
      (ℓ ^ n : ℕ) • x = 0 :=
    fun ι q n x => hTorsAnn (Y_comp ι).left (ℓ ^ n) q x
  have hTrace_eq :=
    weil_curve_tr_bockstein_limit_excision_trace ℓ B₂ M_bdry m_c π_bdry π_α (b_V σ) (M_lat_V σ)
      (fun q m => (𝒦 m).H q) α_H τ_H τ_le_H ι_bock_H δ_bock_H
      hSub₀ hAnn_K hFin_K0
      ⟨hBock1, hBock2, hBock3, hBock4, hBock5, hBock6, hBock7, hBock8⟩
      hLat
      (fun ι q n => weilEtaleTorsionH (Y_comp ι).left (ℓ ^ n) q)
      (fun ι q n => weilEtaleTorsionTransition (Y_comp ι).left ℓ n q)
      hSub_comp0 hAnn_comp hFin_comp act_comp hact_τ hact_off
      f₀_m δ_m g₁_m g₂_m hExc (fun ι h q => (H_fix ι h q).V) Φ_fix
      (fun ι h q => by
        obtain ⟨p_pull, hp_pull, hf_pull⟩ := (hSpec_fix ι h).2.1 q
        refine ⟨(H_fix ι h q).equiv, p_pull, (H_fix ι h q).hsmul, hf_pull, fun m v => ?_⟩
        obtain ⟨p_fix_m, hp_fix_m, hact_eq⟩ := hact_fix m q ι h
        have hp_eq : p_fix_m = p_pull (m + 1) :=
          hUniq_pull (α_fix ι h) (ℓ ^ (m + 1)) q p_fix_m (p_pull (m + 1)) hp_fix_m (hp_pull (m + 1))
        rw [hact_eq v, hp_eq])
  have hSum_eq :
      (∑ ι : Fin m_c,
        if h : π_α ι = ι then
          ∑ i ∈ Finset.Iic 2,
            (-1 : Padic ℓ) ^ i * LinearMap.trace (Padic ℓ) (H_fix ι h i).V (Φ_fix ι h i)
        else 0) =
      ((∑ ι : Fin m_c,
        if h : π_α ι = ι then
          let Δ_ι := CategoryTheory.Limits.pullback.diagonal (Y_comp ι).hom
          let Γ_ι := CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.id (Y_comp ι).left) (α_fix ι h)
            ((CategoryTheory.Category.id_comp (Y_comp ι).hom).trans (hα_fix_hom ι h).symm)
          Nat.card ↥(CategoryTheory.Limits.pullback Δ_ι Γ_ι)
        else 0 : ℕ) : Padic ℓ) := by
    rw [Nat.cast_sum]
    refine Finset.sum_congr rfl fun ι _ => ?_
    split_ifs with h
    · exact ((hSpec_fix ι h).2.2).symm
    · simp
  apply IsFractionRing.injective (PadicInt ℓ) (Padic ℓ)
  rw [hTrace_eq, hSum_eq, ← hCard_part, Nat.cast_add, add_sub_cancel_right]
  exact (map_natCast (algebraMap (PadicInt ℓ) (Padic ℓ)) _).symm

theorem weil_curve_tr_closed_point_orbit_fixed_sum (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (ℓ N s r : ℕ) [Fact (Nat.Prime ℓ)] (hN : 1 ≤ N) (hr : 1 ≤ r)
    (B₀ L₀ : Type u)
    [CommRing B₀] [IsDomain B₀] [Field L₀]
    [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) B₀]
    [Algebra F L₀] [Algebra (Polynomial F) L₀] [Algebra (RatFunc F) L₀]
    [Algebra B₀ L₀]
    [Algebra (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) L₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) B₀]
    [IsScalarTower F (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) B₀ L₀]
    [IsScalarTower
      (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) B₀ L₀]
    [Module.Finite
      (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) B₀]
    [Algebra.Etale
      (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) B₀]
    [IsFractionRing B₀ L₀]
    [IsIntegralClosure B₀
      (Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))) L₀]
    [FiniteDimensional (RatFunc F) L₀]
    [IsGalois (RatFunc F) L₀]
    (τ_rep₀ :
      (B₀ ≃ₐ[Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))] B₀) →*
        (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (s + 1))))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (hQP₀ : ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ∃ Q : Ideal B₀, Q.IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) B₀) Q = Ideal.span {P} ∧
        ∃ σ_P :
            B₀ ≃ₐ[Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))] B₀,
          (∀ b : B₀, σ_P.symm b - b ^ (Nat.card F ^ d) ∈ Q) ∧
          (τ_rep₀ σ_P).val = (A_mat d P hP).map (PadicInt.toZModPow (s + 1)))
    (e : ∀ d : ℕ,
      Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
        { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) :
    let R₀ := Localization.Away (∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F))
    Finite (B₀ ≃ₐ[R₀] B₀) ∧
    ∀ (K' : ℕ) [Fintype (B₀ ≃ₐ[R₀] B₀)],
      s + 1 ≤ K' →
      ∑ σ : (B₀ ≃ₐ[R₀] B₀),
        (Nat.card { y : ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀)) //
          IsClosed ({y} : Set ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))) ∧
          (CategoryTheory.CategoryStruct.comp
            (weilSchemeEndPow (weilGeomFrobHom F (weilCurveTrGeomCoverOver F B₀)) r)
            (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)).base y = y } : ZMod (ℓ ^ K')) *
          ((Matrix.trace (τ_rep₀ σ).val).val : ZMod (ℓ ^ K')) =
      (Fintype.card (B₀ ≃ₐ[R₀] B₀) : ZMod (ℓ ^ K')) *
        ∑ d ∈ Nat.divisors r,
          ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
            (d : ZMod (ℓ ^ K')) *
              ((PadicInt.toZModPow (s + 1)
                (Matrix.trace ((A_mat d (e d j).1 (e d j).2) ^ (r / d)))).val : ZMod (ℓ ^ K')) :=
by
  classical
  have _ := hN
  let g_S : Polynomial F := ∏ s_a ∈ S_aff, (Polynomial.X - Polynomial.C s_a : Polynomial F)
  let R₀ := Localization.Away g_S
  let F_bar := AlgebraicClosure F
  let q := Nat.card F
  let X_B₀ : B₀ := algebraMap (Polynomial F) B₀ Polynomial.X

  have hFixPoly : ∀ (τ : B₀ ≃ₐ[R₀] B₀) (f : Polynomial F),
      τ (algebraMap (Polynomial F) B₀ f) = algebraMap (Polynomial F) B₀ f := by
    intro τ f
    rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀ f]
    exact τ.commutes (algebraMap (Polynomial F) R₀ f)

  have hFixF : ∀ (τ : B₀ ≃ₐ[R₀] B₀) (c : F),
      τ (algebraMap F B₀ c) = algebraMap F B₀ c := by
    intro τ c
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) B₀ c]
    exact hFixPoly τ (algebraMap F (Polynomial F) c)

  let toFAlgHom : (B₀ ≃ₐ[R₀] B₀) → (B₀ →ₐ[F] B₀) := fun τ =>
    { toRingHom := τ.toRingHom
      commutes' := fun c => hFixF τ c }

  let twistAlgHom : (B₀ →ₐ[F] F_bar) → (B₀ ≃ₐ[R₀] B₀) → (B₀ →ₐ[F] F_bar) := fun χ₀ τ =>
    χ₀.comp (toFAlgHom τ)

  
  let μ_B : (B₀ ≃ₐ[R₀] B₀) → TensorProduct R₀ B₀ B₀ →ₐ[B₀] B₀ :=
    fun σ => Algebra.TensorProduct.lift (AlgHom.id B₀ B₀) σ.symm.toAlgHom (fun _ _ => Commute.all _ _)

  have hIdempPkg : ∃ (m_Γ : ℕ) (equiv_Γ : Fin m_Γ ≃ (B₀ ≃ₐ[R₀] B₀))
      (e_idem : Fin m_Γ → TensorProduct R₀ B₀ B₀),
      (∑ i : Fin m_Γ, e_idem i) = 1 ∧
      (∀ i j : Fin m_Γ, μ_B (equiv_Γ j) (e_idem i) = if i = j then 1 else 0) ∧
      (∀ (i : Fin m_Γ) (z : TensorProduct R₀ B₀ B₀),
        z * e_idem i = TensorProduct.tmul R₀ (μ_B (equiv_Γ i) z) 1 * e_idem i) := by
    have hg_monic : g_S.Monic :=
      Polynomial.monic_prod_of_monic S_aff (fun s_a => Polynomial.X - Polynomial.C s_a)
        (fun s_a _ => Polynomial.monic_X_sub_C s_a)
    have hg_ne : g_S ≠ 0 := hg_monic.ne_zero
    have hle_nzd : Submonoid.powers g_S ≤ nonZeroDivisors (Polynomial F) :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hg_ne)
    letI : IsDomain R₀ := IsLocalization.isDomain_localization hle_nzd
    have hg_rf_ne : algebraMap (Polynomial F) (RatFunc F) g_S ≠ 0 := by
      intro h0
      apply hg_ne
      exact IsFractionRing.injective (Polynomial F) (RatFunc F)
        (h0.trans (map_zero (algebraMap (Polynomial F) (RatFunc F))).symm)
    have hg_unit : IsUnit (algebraMap (Polynomial F) (RatFunc F) g_S) :=
      IsUnit.mk0 _ hg_rf_ne
    let f_R₀ : R₀ →+* RatFunc F := IsLocalization.Away.lift g_S (S := R₀) hg_unit
    letI : Algebra R₀ (RatFunc F) := f_R₀.toAlgebra
    haveI : IsScalarTower (Polynomial F) R₀ (RatFunc F) :=
      IsScalarTower.of_algebraMap_eq fun p =>
        (IsLocalization.Away.lift_eq g_S (S := R₀) hg_unit p).symm
    haveI : IsFractionRing R₀ (RatFunc F) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
        (Submonoid.powers g_S) R₀ (RatFunc F)
    haveI : IsScalarTower R₀ (RatFunc F) L₀ := by
      apply IsScalarTower.of_algebraMap_eq'
      apply IsLocalization.ringHom_ext (Submonoid.powers g_S)
      apply RingHom.ext
      intro p
      simp only [RingHom.comp_apply]
      rw [IsScalarTower.algebraMap_apply R₀ B₀ L₀,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀,
        ← IsScalarTower.algebraMap_apply (Polynomial F) B₀ L₀,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (RatFunc F),
        ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L₀]
    let K := RatFunc F
    let toGal : (B₀ ≃ₐ[R₀] B₀) → (L₀ ≃ₐ[K] L₀) :=
      fun σ => IsFractionRing.fieldEquivOfAlgEquiv K L₀ L₀ σ
    have h_toGal : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (b : B₀),
        toGal σ (algebraMap B₀ L₀ b) = algebraMap B₀ L₀ (σ b) :=
      fun σ b => IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L₀ L₀ σ b
    let e_IC : B₀ ≃ₐ[R₀] ↥(integralClosure R₀ L₀) :=
      IsIntegralClosure.equiv R₀ B₀ L₀ ↥(integralClosure R₀ L₀)
    let fromGal : (L₀ ≃ₐ[K] L₀) → (B₀ ≃ₐ[R₀] B₀) :=
      fun ψ => (e_IC.trans (AlgEquiv.mapIntegralClosure (ψ.restrictScalars R₀))).trans e_IC.symm
    have h_fromGal : ∀ (ψ : L₀ ≃ₐ[K] L₀) (b : B₀),
        algebraMap B₀ L₀ (fromGal ψ b) = ψ (algebraMap B₀ L₀ b) := by
      intro ψ b
      have h1 := IsIntegralClosure.algebraMap_equiv R₀ B₀ L₀ ↥(integralClosure R₀ L₀) (fromGal ψ b)
      have h2 := IsIntegralClosure.algebraMap_equiv R₀ B₀ L₀ ↥(integralClosure R₀ L₀) b
      change (↑(e_IC (fromGal ψ b)) : L₀) = algebraMap B₀ L₀ (fromGal ψ b) at h1
      change (↑(e_IC b) : L₀) = algebraMap B₀ L₀ b at h2
      rw [← h1, ← h2]
      dsimp [fromGal]
      rw [e_IC.apply_symm_apply]
      exact AlgEquiv.coe_mapIntegralClosure (ψ.restrictScalars R₀) (e_IC b)
    let equiv_aut : (B₀ ≃ₐ[R₀] B₀) ≃ (L₀ ≃ₐ[K] L₀) :=
      { toFun := toGal
        invFun := fromGal
        left_inv := fun σ => by
          ext b
          apply IsFractionRing.injective B₀ L₀
          rw [h_fromGal, h_toGal]
        right_inv := fun ψ => by
          have hring : (toGal (fromGal ψ)).toRingHom = ψ.toRingHom := by
            apply IsLocalization.ringHom_ext (nonZeroDivisors B₀)
            apply RingHom.ext
            intro b
            exact (h_toGal (fromGal ψ) b).trans (h_fromGal ψ b)
          ext x
          exact congrFun (congrArg DFunLike.coe hring) x }
    letI : Fintype (L₀ ≃ₐ[K] L₀) := AlgEquiv.fintype K L₀
    let m : ℕ := Fintype.card (L₀ ≃ₐ[K] L₀)
    have hm_finrank : m = Module.finrank K L₀ :=
      Nat.card_eq_fintype_card.symm.trans (IsGalois.card_aut_eq_finrank K L₀)
    let equiv_Γ : Fin m ≃ (B₀ ≃ₐ[R₀] B₀) :=
      (Fintype.equivFin (L₀ ≃ₐ[K] L₀)).symm.trans equiv_aut.symm
    have hμ_tmul : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (s₁ s₂ : B₀),
        μ_B σ (TensorProduct.tmul R₀ s₁ s₂) = s₁ * σ.symm s₂ := fun _ _ _ => rfl
    have hμ_sec : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (s : B₀),
        μ_B σ (TensorProduct.tmul R₀ s 1) = s := by
      intro σ s
      rw [hμ_tmul, map_one, mul_one]
    have hKerIdem : ∀ σ : B₀ ≃ₐ[R₀] B₀,
        ∃ f : TensorProduct R₀ B₀ B₀,
          IsIdempotentElem f ∧
          RingHom.ker (μ_B σ).toRingHom = Ideal.span ({f} : Set (TensorProduct R₀ B₀ B₀)) := by
      intro σ
      have hμ_surj : Function.Surjective (μ_B σ) := fun s => ⟨TensorProduct.tmul R₀ s 1, hμ_sec σ s⟩
      have hFG : (RingHom.ker (μ_B σ).toRingHom).FG :=
        Algebra.FinitePresentation.ker_fG_of_surjective (μ_B σ) hμ_surj
      have hIdemI : IsIdempotentElem (RingHom.ker (μ_B σ).toRingHom) := by
        letI : Algebra (TensorProduct R₀ B₀ B₀) B₀ := (μ_B σ).toRingHom.toAlgebra
        haveI : IsScalarTower B₀ (TensorProduct R₀ B₀ B₀) B₀ :=
          IsScalarTower.of_algebraMap_eq fun s => ((μ_B σ).commutes s).symm
        haveI : Algebra.Etale (TensorProduct R₀ B₀ B₀) B₀ :=
          Algebra.Etale.of_restrictScalars B₀ (TensorProduct R₀ B₀ B₀) B₀
        exact (Algebra.FormallyEtale.iff_of_surjective
          (R := TensorProduct R₀ B₀ B₀) (S := B₀) hμ_surj).mp inferInstance
      exact (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hIdemI
    let f : Fin m → TensorProduct R₀ B₀ B₀ := fun i => Classical.choose (hKerIdem (equiv_Γ i))
    have hf_spec : ∀ i : Fin m,
        IsIdempotentElem (f i) ∧
        RingHom.ker (μ_B (equiv_Γ i)).toRingHom = Ideal.span ({f i} : Set (TensorProduct R₀ B₀ B₀)) :=
      fun i => Classical.choose_spec (hKerIdem (equiv_Γ i))
    let e_idem : Fin m → TensorProduct R₀ B₀ B₀ := fun i => 1 - f i
    have hf_idem : ∀ i : Fin m, f i * f i = f i := fun i => (hf_spec i).1.eq
    have hfe_zero : ∀ i : Fin m, f i * e_idem i = 0 := by
      intro i
      dsimp [e_idem]
      rw [mul_sub, mul_one, hf_idem i, sub_self]
    have hμ_diag : ∀ i : Fin m, μ_B (equiv_Γ i) (e_idem i) = 1 := by
      intro i
      have hf_ker : f i ∈ RingHom.ker (μ_B (equiv_Γ i)).toRingHom := by
        rw [(hf_spec i).2]
        exact Ideal.mem_span_singleton_self (f i)
      change (μ_B (equiv_Γ i)) (f i) = 0 at hf_ker
      dsimp [e_idem]
      rw [map_sub, map_one, hf_ker, sub_zero]
    have h_absorb : ∀ (i : Fin m) (z : TensorProduct R₀ B₀ B₀),
        z * e_idem i = TensorProduct.tmul R₀ (μ_B (equiv_Γ i) z) 1 * e_idem i := by
      intro i z
      have hw_ker : z - TensorProduct.tmul R₀ (μ_B (equiv_Γ i) z) 1 ∈
          RingHom.ker (μ_B (equiv_Γ i)).toRingHom := by
        change μ_B (equiv_Γ i) (z - TensorProduct.tmul R₀ (μ_B (equiv_Γ i) z) 1) = 0
        rw [map_sub, hμ_sec (equiv_Γ i) (μ_B (equiv_Γ i) z), sub_self]
      rw [(hf_spec i).2, Ideal.mem_span_singleton] at hw_ker
      rcases hw_ker with ⟨c, hc⟩
      have hsub_zero : (z - TensorProduct.tmul R₀ (μ_B (equiv_Γ i) z) 1) * e_idem i = 0 := by
        rw [hc]
        calc (f i * c) * e_idem i = c * (f i * e_idem i) := by ring
          _ = c * 0 := by rw [hfe_zero i]
          _ = 0 := mul_zero c
      rw [sub_mul] at hsub_zero
      exact sub_eq_zero.mp hsub_zero
    have hμ_kronecker : ∀ i j : Fin m, μ_B (equiv_Γ j) (e_idem i) = if i = j then 1 else 0 := by
      intro i j
      by_cases hij : i = j
      · subst hij
        simp only [↓reduceIte, hμ_diag i]
      · simp only [hij, ↓reduceIte]
        have hex_s : ∃ s : B₀, (equiv_Γ i).symm s ≠ (equiv_Γ j).symm s := by
          by_contra h_all
          apply hij
          apply equiv_Γ.injective
          ext t
          have ht_eq : (equiv_Γ i).symm (equiv_Γ i t) = (equiv_Γ j).symm (equiv_Γ i t) := by
            by_contra hne
            exact h_all ⟨equiv_Γ i t, hne⟩
          have ht := congrArg (equiv_Γ j) ht_eq
          rw [(equiv_Γ i).symm_apply_apply, (equiv_Γ j).apply_symm_apply] at ht
          exact ht.symm
        rcases hex_s with ⟨s, hs_ne⟩
        have habs_s := h_absorb i (TensorProduct.tmul R₀ 1 s)
        rw [hμ_tmul (equiv_Γ i) 1 s, one_mul] at habs_s
        have hmap_j := congrArg (μ_B (equiv_Γ j)) habs_s
        rw [map_mul, map_mul, hμ_tmul (equiv_Γ j) 1 s, one_mul,
          hμ_sec (equiv_Γ j) ((equiv_Γ i).symm s)] at hmap_j
        have hmul_zero : ((equiv_Γ j).symm s - (equiv_Γ i).symm s) * μ_B (equiv_Γ j) (e_idem i) = 0 := by
          rw [sub_mul, hmap_j, sub_self]
        rcases mul_eq_zero.mp hmul_zero with hdiff | heval
        · exact False.elim (hs_ne (sub_eq_zero.mp hdiff).symm)
        · exact heval
    haveI : Algebra.Smooth R₀ B₀ := inferInstance
    haveI : Module.Flat R₀ B₀ := Algebra.Smooth.flat R₀ B₀
    haveI : Module.Flat R₀ K := IsLocalization.flat K (nonZeroDivisors R₀)
    haveI : Module.Flat R₀ L₀ := Module.Flat.trans R₀ K L₀
    let j_SL : B₀ →ₐ[R₀] L₀ := IsScalarTower.toAlgHom R₀ B₀ L₀
    have hj_SL_inj : Function.Injective j_SL := IsFractionRing.injective B₀ L₀
    let ι₁ : TensorProduct R₀ B₀ B₀ →ₐ[R₀] TensorProduct R₀ L₀ L₀ :=
      Algebra.TensorProduct.map j_SL j_SL
    have hι₁_eq : ι₁.toLinearMap = TensorProduct.map j_SL.toLinearMap j_SL.toLinearMap := by
      apply TensorProduct.ext'
      intro s₁ s₂
      rfl
    have hι₁_inj : Function.Injective ι₁ := by
      change Function.Injective ι₁.toLinearMap
      rw [hι₁_eq]
      exact TensorProduct.map_injective_of_flat_flat
        j_SL.toLinearMap j_SL.toLinearMap hj_SL_inj hj_SL_inj
    let φ_RL_KL : TensorProduct R₀ L₀ L₀ →ₐ[L₀] TensorProduct K L₀ L₀ :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft (R := K) (S := L₀) (A := L₀) (B := L₀))
        ((Algebra.TensorProduct.includeRight (R := K) (A := L₀) (B := L₀)).restrictScalars R₀)
        (fun _ _ => Commute.all _ _)
    have hφ_tmul : ∀ x y : L₀,
        φ_RL_KL (TensorProduct.tmul R₀ x y) = TensorProduct.tmul K x y := by
      intro x y
      change TensorProduct.tmul K x (1 : L₀) * TensorProduct.tmul K (1 : L₀) y =
        TensorProduct.tmul K x y
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hφ_inj : Function.Injective φ_RL_KL := by
      let u₁ : K →+* TensorProduct R₀ L₀ L₀ :=
        (Algebra.TensorProduct.includeLeftRingHom (R := R₀) (A := L₀) (B := L₀)).comp (algebraMap K L₀)
      let u₂ : K →+* TensorProduct R₀ L₀ L₀ :=
        (Algebra.TensorProduct.includeRight (R := R₀) (A := L₀) (B := L₀)).toRingHom.comp (algebraMap K L₀)
      have hu_eq : u₁ = u₂ := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R₀)
        apply RingHom.ext
        intro r₀
        dsimp [u₁, u₂]
        rw [← IsScalarTower.algebraMap_apply R₀ K L₀]
        change TensorProduct.tmul R₀ (algebraMap R₀ L₀ r₀) 1 = TensorProduct.tmul R₀ 1 (algebraMap R₀ L₀ r₀)
        have h1 : algebraMap R₀ L₀ r₀ = r₀ • (1 : L₀) := Algebra.algebraMap_eq_smul_one r₀
        rw [h1, TensorProduct.smul_tmul]
      have hk_comm : ∀ k : K,
          TensorProduct.tmul R₀ (algebraMap K L₀ k) (1 : L₀) =
            TensorProduct.tmul R₀ (1 : L₀) (algebraMap K L₀ k) :=
        fun k => congrFun (congrArg DFunLike.coe hu_eq) k
      let g_K : L₀ →ₐ[K] TensorProduct R₀ L₀ L₀ :=
        { (Algebra.TensorProduct.includeRight (R := R₀) (A := L₀) (B := L₀)).toRingHom with
          commutes' := fun k => by
            change TensorProduct.tmul R₀ (1 : L₀) (algebraMap K L₀ k) =
              algebraMap K (TensorProduct R₀ L₀ L₀) k
            rw [IsScalarTower.algebraMap_apply K L₀ (TensorProduct R₀ L₀ L₀)]
            exact (hk_comm k).symm }
      let ψ_KL_RL : TensorProduct K L₀ L₀ →ₐ[L₀] TensorProduct R₀ L₀ L₀ :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft (R := R₀) (S := L₀) (A := L₀) (B := L₀))
          g_K
          (fun _ _ => Commute.all _ _)
      have h_comp : ((ψ_KL_RL.comp φ_RL_KL).restrictScalars R₀).toLinearMap = LinearMap.id := by
        apply TensorProduct.ext'
        intro x y
        change ψ_KL_RL (φ_RL_KL (TensorProduct.tmul R₀ x y)) = TensorProduct.tmul R₀ x y
        rw [hφ_tmul]
        change TensorProduct.tmul R₀ x (1 : L₀) * TensorProduct.tmul R₀ (1 : L₀) y =
          TensorProduct.tmul R₀ x y
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      have h_left_inv : Function.LeftInverse ψ_KL_RL φ_RL_KL :=
        fun w => congrFun (congrArg DFunLike.coe h_comp) w
      exact h_left_inv.injective
    let ι_tot : TensorProduct R₀ B₀ B₀ →+* TensorProduct K L₀ L₀ :=
      φ_RL_KL.toRingHom.comp ι₁.toRingHom
    have hι_tot_inj : Function.Injective ι_tot := hφ_inj.comp hι₁_inj
    have hι_tot_tmul : ∀ s₁ s₂ : B₀,
        ι_tot (TensorProduct.tmul R₀ s₁ s₂) =
          TensorProduct.tmul K (algebraMap B₀ L₀ s₁) (algebraMap B₀ L₀ s₂) := by
      intro s₁ s₂
      change φ_RL_KL (ι₁ (TensorProduct.tmul R₀ s₁ s₂)) = _
      rw [Algebra.TensorProduct.map_tmul]
      exact hφ_tmul (j_SL s₁) (j_SL s₂)
    let μ_L : Fin m → TensorProduct K L₀ L₀ →ₐ[L₀] L₀ :=
      fun j => Algebra.TensorProduct.lift (AlgHom.id L₀ L₀)
        (toGal (equiv_Γ j)).symm.toAlgHom (fun _ _ => Commute.all _ _)
    have hμ_L_compat : ∀ (j : Fin m) (z : TensorProduct R₀ B₀ B₀),
        μ_L j (ι_tot z) = algebraMap B₀ L₀ (μ_B (equiv_Γ j) z) := by
      intro j
      let lhs_alg : TensorProduct R₀ B₀ B₀ →ₐ[R₀] L₀ :=
        (((μ_L j).restrictScalars R₀).comp (φ_RL_KL.restrictScalars R₀)).comp ι₁
      let rhs_alg : TensorProduct R₀ B₀ B₀ →ₐ[R₀] L₀ :=
        (IsScalarTower.toAlgHom R₀ B₀ L₀).comp ((μ_B (equiv_Γ j)).restrictScalars R₀)
      have hlhs_eq : lhs_alg.toLinearMap = rhs_alg.toLinearMap := by
        apply TensorProduct.ext'
        intro s₁ s₂
        change μ_L j (ι_tot (TensorProduct.tmul R₀ s₁ s₂)) =
          algebraMap B₀ L₀ (μ_B (equiv_Γ j) (TensorProduct.tmul R₀ s₁ s₂))
        rw [hι_tot_tmul, hμ_tmul, map_mul]
        change algebraMap B₀ L₀ s₁ * (toGal (equiv_Γ j)).symm (algebraMap B₀ L₀ s₂) =
          algebraMap B₀ L₀ s₁ * algebraMap B₀ L₀ ((equiv_Γ j).symm s₂)
        congr 1
        apply (toGal (equiv_Γ j)).injective
        rw [(toGal (equiv_Γ j)).apply_symm_apply, h_toGal, (equiv_Γ j).apply_symm_apply]
      intro z
      exact congrFun (congrArg DFunLike.coe hlhs_eq) z
    let e_bar : Fin m → TensorProduct K L₀ L₀ := fun i => ι_tot (e_idem i)
    have hμ_L_ebar : ∀ i j : Fin m, μ_L j (e_bar i) = if i = j then 1 else 0 := by
      intro i j
      dsimp [e_bar]
      rw [hμ_L_compat j (e_idem i), hμ_kronecker i j]
      split_ifs <;> simp
    let Φ_lin : (Fin m → L₀) →ₗ[L₀] TensorProduct K L₀ L₀ :=
      { toFun := fun c => ∑ i : Fin m, c i • e_bar i
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun a c => by
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
    let Θ_lin : TensorProduct K L₀ L₀ →ₗ[L₀] (Fin m → L₀) :=
      LinearMap.pi fun j => (μ_L j).toLinearMap
    have hΘΦ : ∀ c : Fin m → L₀, Θ_lin (Φ_lin c) = c := by
      intro c
      ext j
      change μ_L j (∑ i : Fin m, c i • e_bar i) = c j
      rw [map_sum]
      have hterm : ∀ i : Fin m, μ_L j (c i • e_bar i) = if i = j then c i else 0 := by
        intro i
        rw [map_smul, smul_eq_mul, hμ_L_ebar i j, mul_ite, mul_one, mul_zero]
      simp_rw [hterm]
      simp
    have hΦ_inj : Function.Injective Φ_lin :=
      Function.LeftInverse.injective hΘΦ
    haveI : Module.Finite K (TensorProduct K L₀ L₀) := Module.Finite.tensorProduct K L₀ L₀
    haveI : FiniteDimensional L₀ (TensorProduct K L₀ L₀) :=
      Module.Finite.of_restrictScalars_finite K L₀ (TensorProduct K L₀ L₀)
    have hfinrank_eq :
        Module.finrank L₀ (Fin m → L₀) = Module.finrank L₀ (TensorProduct K L₀ L₀) := by
      rw [Module.finrank_pi, Fintype.card_fin,
        @Module.finrank_tensorProduct L₀ K L₀ L₀, Module.finrank_self, one_mul, hm_finrank]
    have hΦ_surj : Function.Surjective Φ_lin :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfinrank_eq).mp hΦ_inj
    have hsum_bar : (∑ i : Fin m, e_bar i) = 1 := by
      set w₀ : TensorProduct K L₀ L₀ := 1 - ∑ i : Fin m, e_bar i
      have hΘw₀ : Θ_lin w₀ = 0 := by
        ext j
        change μ_L j (1 - ∑ i : Fin m, e_bar i) = 0
        rw [map_sub, map_one, map_sum]
        simp_rw [hμ_L_ebar]
        simp
      obtain ⟨c₀, hc₀⟩ := hΦ_surj w₀
      have hc₀_zero : c₀ = 0 := by
        rw [← hΘΦ c₀, hc₀, hΘw₀]
      have hw₀_zero : w₀ = 0 := by
        rw [← hc₀, hc₀_zero, map_zero]
      exact (sub_eq_zero.mp hw₀_zero).symm
    have hsum_e : (∑ i : Fin m, e_idem i) = 1 := by
      apply hι_tot_inj
      rw [map_sum, map_one]
      exact hsum_bar
    exact ⟨m, equiv_Γ, e_idem, hsum_e, hμ_kronecker, h_absorb⟩

  obtain ⟨m_Γ, equiv_Γ, e_idem, hSum_idem, hEval_idem, hAbsorb_idem⟩ := hIdempPkg
  have hFin_Γ : Finite (B₀ ≃ₐ[R₀] B₀) := Finite.of_equiv (Fin m_Γ) equiv_Γ

  refine ⟨hFin_Γ, fun K' _instFintypeΓ _hsK' => ?_⟩

  have hAvoid : ∀ (χ : B₀ →ₐ[F] F_bar) (s_a : F),
      s_a ∈ S_aff → χ X_B₀ ≠ algebraMap F F_bar s_a := by
    intro χ s_a hs_a hEq
    have hdvd : Polynomial.X - Polynomial.C s_a ∣ g_S :=
      Finset.dvd_prod_of_mem (fun x => Polynomial.X - Polynomial.C x) hs_a
    have hUnit_gS : IsUnit (algebraMap (Polynomial F) R₀ g_S) :=
      IsLocalization.Away.algebraMap_isUnit g_S
    have hUnit_R₀ : IsUnit (algebraMap (Polynomial F) R₀ (Polynomial.X - Polynomial.C s_a)) :=
      isUnit_of_dvd_unit (map_dvd (algebraMap (Polynomial F) R₀) hdvd) hUnit_gS
    have hUnit_B₀ : IsUnit (algebraMap (Polynomial F) B₀ (Polynomial.X - Polynomial.C s_a)) := by
      rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀]
      exact hUnit_R₀.map (algebraMap R₀ B₀)
    have hUnit_F_bar : IsUnit (χ (algebraMap (Polynomial F) B₀ (Polynomial.X - Polynomial.C s_a))) :=
      hUnit_B₀.map χ.toRingHom
    have hZero : χ (algebraMap (Polynomial F) B₀ (Polynomial.X - Polynomial.C s_a)) = 0 := by
      rw [map_sub, map_sub]
      have hC : algebraMap (Polynomial F) B₀ (Polynomial.C s_a) = algebraMap F B₀ s_a :=
        (IsScalarTower.algebraMap_apply F (Polynomial F) B₀ s_a).symm
      rw [hC, χ.commutes s_a]
      exact sub_eq_zero.mpr hEq
    exact hUnit_F_bar.ne_zero hZero

  have hFreeness : ∀ (χ₀ : B₀ →ₐ[F] F_bar) (γ₁ γ₂ : B₀ ≃ₐ[R₀] B₀),
      (∀ b : B₀, χ₀ (γ₁ b) = χ₀ (γ₂ b)) ↔ γ₁ = γ₂ := by
    intro χ₀ γ₁ γ₂
    refine ⟨fun hEq => ?_, fun h => by subst h; exact fun _ => rfl⟩
    have hTensor_eq : ∀ z : TensorProduct R₀ B₀ B₀,
        χ₀ (μ_B (γ₁⁻¹) z) = χ₀ (μ_B (γ₂⁻¹) z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul b₁ b₂ =>
        change χ₀ (b₁ * γ₁ b₂) = χ₀ (b₁ * γ₂ b₂)
        rw [map_mul, map_mul, hEq b₂]
      | add x y ihx ihy => simp only [map_add, ihx, ihy]
    set i₁ : Fin m_Γ := equiv_Γ.symm (γ₁⁻¹)
    set i₂ : Fin m_Γ := equiv_Γ.symm (γ₂⁻¹)
    have hSpec := hTensor_eq (e_idem i₁)
    have h1 : γ₁⁻¹ = equiv_Γ i₁ := (equiv_Γ.apply_symm_apply (γ₁⁻¹)).symm
    have h2 : γ₂⁻¹ = equiv_Γ i₂ := (equiv_Γ.apply_symm_apply (γ₂⁻¹)).symm
    rw [h1, h2, hEval_idem i₁ i₁, hEval_idem i₁ i₂, if_pos rfl, map_one] at hSpec
    have hi : i₁ = i₂ := by
      by_contra hne
      rw [if_neg hne, map_zero] at hSpec
      exact one_ne_zero hSpec
    have hinv : γ₁⁻¹ = γ₂⁻¹ := by rw [h1, h2, hi]
    exact inv_inj.mp hinv

  have hTrans : ∀ (χ₀ χ : B₀ →ₐ[F] F_bar),
      χ X_B₀ = χ₀ X_B₀ → ∃ γ : B₀ ≃ₐ[R₀] B₀, ∀ b : B₀, χ b = χ₀ (γ⁻¹ b) := by
    intro χ₀ χ hX
    have hPoly_eq : χ.comp (IsScalarTower.toAlgHom F (Polynomial F) B₀) =
        χ₀.comp (IsScalarTower.toAlgHom F (Polynomial F) B₀) := by
      apply Polynomial.algHom_ext
      exact hX
    have hR₀_hom_eq : χ.toRingHom.comp (algebraMap R₀ B₀) =
        χ₀.toRingHom.comp (algebraMap R₀ B₀) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g_S)
      apply RingHom.ext
      intro f
      have hcomp : ∀ ψ : B₀ →ₐ[F] F_bar,
          (ψ.toRingHom.comp (algebraMap R₀ B₀)).comp (algebraMap (Polynomial F) R₀) f =
            (ψ.comp (IsScalarTower.toAlgHom F (Polynomial F) B₀)) f := by
        intro ψ
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          AlgHom.comp_apply, IsScalarTower.toAlgHom_apply]
        rw [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀ f]
      rw [hcomp χ, hcomp χ₀, hPoly_eq]
    let algR₀ : Algebra R₀ F_bar := (χ₀.toRingHom.comp (algebraMap R₀ B₀)).toAlgebra
    letI : Algebra R₀ F_bar := algR₀
    let χ₀_R : B₀ →ₐ[R₀] F_bar := { toRingHom := χ₀.toRingHom, commutes' := fun _ => rfl }
    let χ_R : B₀ →ₐ[R₀] F_bar :=
      { toRingHom := χ.toRingHom
        commutes' := fun r₀ => RingHom.congr_fun hR₀_hom_eq r₀ }
    let Ψ : TensorProduct R₀ B₀ B₀ →ₐ[R₀] F_bar :=
      Algebra.TensorProduct.lift χ₀_R χ_R (fun _ _ => Commute.all _ _)
    have hΨ_sum : ∑ i : Fin m_Γ, Ψ (e_idem i) = 1 := by
      rw [← map_sum, hSum_idem, map_one]
    have hExists : ∃ i : Fin m_Γ, Ψ (e_idem i) ≠ 0 := by
      by_contra hall
      have h0 : ∑ i : Fin m_Γ, Ψ (e_idem i) = 0 :=
        Finset.sum_eq_zero fun i _ => not_not.mp (not_exists.mp hall i)
      exact one_ne_zero (hΨ_sum.symm.trans h0)
    obtain ⟨i, hi_ne⟩ := hExists
    refine ⟨equiv_Γ i, fun b => ?_⟩
    have hAbs0 := hAbsorb_idem i (TensorProduct.tmul R₀ (1 : B₀) b)
    have hμ_val : μ_B (equiv_Γ i) (TensorProduct.tmul R₀ (1 : B₀) b) = (equiv_Γ i)⁻¹ b :=
      one_mul ((equiv_Γ i)⁻¹ b)
    rw [hμ_val] at hAbs0
    have hAbs := congrArg Ψ hAbs0
    rw [map_mul, map_mul] at hAbs
    change (χ₀ 1 * χ b) * Ψ (e_idem i) = (χ₀ ((equiv_Γ i)⁻¹ b) * χ 1) * Ψ (e_idem i) at hAbs
    rw [map_one, one_mul, map_one, mul_one] at hAbs
    exact mul_right_cancel₀ hi_ne hAbs

  have hFrobLift : ∀ (d m : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P →
      ∀ (Q : Ideal B₀), Q.IsMaximal →
        Ideal.comap (algebraMap (Polynomial F) B₀) Q = Ideal.span {P} →
      ∀ (σ_P : B₀ ≃ₐ[R₀] B₀),
        (∀ b : B₀, σ_P.symm b - b ^ (q ^ d) ∈ Q) →
      ∀ (ξ : F_bar), Polynomial.aeval ξ P = 0 →
        ∃ χ₀ : B₀ →ₐ[F] F_bar,
          χ₀ X_B₀ = ξ ∧
          ∀ (γ σ : B₀ ≃ₐ[R₀] B₀),
            (∀ b : B₀, (χ₀ (γ⁻¹ (σ b))) ^ (q ^ (d * m)) = χ₀ (γ⁻¹ b)) ↔
              σ = γ * (σ_P ^ m) * γ⁻¹ := by
    intro d m P hP Q hQ_max hQ_comap σ_P hσ_P ξ hξ
    let K_Q := B₀ ⧸ Q
    letI : Field K_Q := Ideal.Quotient.field Q
    letI : Module.Finite R₀ K_Q :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ R₀ Q).toLinearMap Ideal.Quotient.mk_surjective
    letI : Fact (Irreducible P) := ⟨hP.2.1⟩
    let K_P := AdjoinRoot P
    let π_FQ : Polynomial F →ₐ[F] K_Q :=
      (Ideal.Quotient.mkₐ F Q).comp (IsScalarTower.toAlgHom F (Polynomial F) B₀)
    have hP_mem_Q : algebraMap (Polynomial F) B₀ P ∈ Q := by
      have hmem : P ∈ Ideal.comap (algebraMap (Polynomial F) B₀) Q := by
        rw [hQ_comap]
        exact Ideal.subset_span (Set.mem_singleton P)
      exact hmem
    have hP_eval_KQ : Polynomial.eval₂ (algebraMap F K_Q) (π_FQ Polynomial.X) P = 0 := by
      have h1 : Polynomial.eval₂ (algebraMap F K_Q) (π_FQ Polynomial.X) P = π_FQ P := by
        rw [← Polynomial.aeval_def, Polynomial.aeval_algHom_apply, Polynomial.aeval_X_left_apply]
      rw [h1]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hP_mem_Q
    let ι_Q : K_P →ₐ[F] K_Q :=
      AdjoinRoot.liftAlgHom P (Algebra.ofId F K_Q) (π_FQ Polynomial.X) hP_eval_KQ
    have hι_mkₐ : ι_Q.comp (AdjoinRoot.mkₐ P) = π_FQ := by
      apply Polynomial.algHom_ext
      change ι_Q (AdjoinRoot.root P) = π_FQ Polynomial.X
      exact AdjoinRoot.liftAlgHom_root P (Algebra.ofId F K_Q) (π_FQ Polynomial.X) hP_eval_KQ
    have hgS_unit_KQ : IsUnit (π_FQ g_S) := by
      change IsUnit (Ideal.Quotient.mk Q (algebraMap (Polynomial F) B₀ g_S))
      rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀ g_S]
      exact ((IsLocalization.Away.algebraMap_isUnit (S := R₀) g_S).map
        (algebraMap R₀ B₀)).map (Ideal.Quotient.mk Q)
    have hgS_ne_KP : AdjoinRoot.mk P g_S ≠ 0 := by
      intro h0
      have himg : ι_Q (AdjoinRoot.mk P g_S) = 0 := by rw [h0, map_zero]
      have hmk : ι_Q (AdjoinRoot.mk P g_S) = π_FQ g_S := AlgHom.congr_fun hι_mkₐ g_S
      exact hgS_unit_KQ.ne_zero (hmk.symm.trans himg)
    have hgS_unit_KP : IsUnit (AdjoinRoot.mk P g_S) := isUnit_iff_ne_zero.mpr hgS_ne_KP
    let ρ_R : R₀ →+* K_P := IsLocalization.Away.lift g_S (S := R₀) hgS_unit_KP
    let algR₀_KP : Algebra R₀ K_P := ρ_R.toAlgebra
    let algKP_KQ : Algebra K_P K_Q := ι_Q.toRingHom.toAlgebra
    letI : Algebra R₀ K_P := algR₀_KP
    letI : Algebra K_P K_Q := algKP_KQ
    have hTower_R₀_KP_KQ : IsScalarTower R₀ K_P K_Q := by
      apply IsScalarTower.of_algebraMap_eq'
      change algebraMap R₀ K_Q = ι_Q.toRingHom.comp ρ_R
      apply IsLocalization.ringHom_ext (Submonoid.powers g_S)
      apply RingHom.ext
      intro f
      simp only [RingHom.comp_apply]
      change Ideal.Quotient.mk Q (algebraMap R₀ B₀ (algebraMap (Polynomial F) R₀ f)) =
        ι_Q (IsLocalization.Away.lift g_S (S := R₀) hgS_unit_KP
          (algebraMap (Polynomial F) R₀ f))
      rw [IsLocalization.Away.lift_eq g_S hgS_unit_KP f,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀ f]
      exact (AlgHom.congr_fun hι_mkₐ f).symm
    letI : IsScalarTower R₀ K_P K_Q := hTower_R₀_KP_KQ
    haveI : Module.Finite K_P K_Q := Module.Finite.of_restrictScalars_finite R₀ K_P K_Q
    haveI : Algebra.IsAlgebraic K_P K_Q := Algebra.IsAlgebraic.of_finite K_P K_Q
    have hξ_eval2 : Polynomial.eval₂ (algebraMap F F_bar) ξ P = 0 := hξ
    let lam_xi : K_P →ₐ[F] F_bar := AdjoinRoot.liftAlgHom P (Algebra.ofId F F_bar) ξ hξ_eval2
    let algKP_F_bar : Algebra K_P F_bar := lam_xi.toRingHom.toAlgebra
    letI : Algebra K_P F_bar := algKP_F_bar
    let ψ_ξ : K_Q →ₐ[K_P] F_bar := IsAlgClosed.lift
    let χ₀ : B₀ →ₐ[F] F_bar :=
      { toRingHom := ψ_ξ.toRingHom.comp (Ideal.Quotient.mk Q)
        commutes' := fun c => by
          change ψ_ξ (Ideal.Quotient.mk Q (algebraMap F B₀ c)) = algebraMap F F_bar c
          have hc1 : Ideal.Quotient.mk Q (algebraMap F B₀ c) =
              algebraMap K_P K_Q (algebraMap F K_P c) := by
            change Ideal.Quotient.mk Q (algebraMap F B₀ c) = ι_Q (algebraMap F K_P c)
            rw [ι_Q.commutes c]
            rfl
          rw [hc1, ψ_ξ.commutes (algebraMap F K_P c)]
          exact lam_xi.commutes c }
    have hχ₀_X : χ₀ X_B₀ = ξ := by
      change ψ_ξ (Ideal.Quotient.mk Q X_B₀) = ξ
      have hX_eq : Ideal.Quotient.mk Q X_B₀ = algebraMap K_P K_Q (AdjoinRoot.root P) := by
        change π_FQ Polynomial.X = ι_Q (AdjoinRoot.root P)
        exact (AdjoinRoot.liftAlgHom_root P (Algebra.ofId F K_Q) (π_FQ Polynomial.X) hP_eval_KQ).symm
      rw [hX_eq, ψ_ξ.commutes (AdjoinRoot.root P)]
      exact AdjoinRoot.liftAlgHom_root P (Algebra.ofId F F_bar) ξ hξ_eval2
    have hχ₀_Q : ∀ b ∈ Q, χ₀ b = 0 := by
      intro b hb
      change ψ_ξ (Ideal.Quotient.mk Q b) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb, map_zero]
    have hχ₀_step : ∀ b : B₀, (χ₀ b) ^ (q ^ d) = χ₀ (σ_P⁻¹ b) := by
      intro b
      have h0 := hχ₀_Q _ (hσ_P b)
      rw [map_sub, map_pow] at h0
      exact (sub_eq_zero.mp h0).symm
    have hχ₀_pow : ∀ (k : ℕ) (b : B₀), (χ₀ b) ^ (q ^ (d * k)) = χ₀ ((σ_P ^ k)⁻¹ b) := by
      intro k
      induction k with
      | zero =>
        intro b
        rw [Nat.mul_zero, pow_zero, pow_one, pow_zero, inv_one, AlgEquiv.one_apply]
      | succ k ih =>
        intro b
        rw [Nat.mul_succ, pow_add, pow_mul, ih b, hχ₀_step, pow_succ, mul_inv_rev]
        rfl
    refine ⟨χ₀, hχ₀_X, fun γ σ => ?_⟩
    have hRewrite : (∀ b : B₀, (χ₀ (γ⁻¹ (σ b))) ^ (q ^ (d * m)) = χ₀ (γ⁻¹ b)) ↔
        (∀ b : B₀, χ₀ (((σ_P ^ m)⁻¹ * γ⁻¹ * σ) b) = χ₀ (γ⁻¹ b)) := by
      refine ⟨fun h b => ?_, fun h b => ?_⟩
      · have hb := h b
        rw [hχ₀_pow m (γ⁻¹ (σ b))] at hb
        exact hb
      · rw [hχ₀_pow m (γ⁻¹ (σ b))]
        exact h b
    rw [hRewrite, hFreeness χ₀ ((σ_P ^ m)⁻¹ * γ⁻¹ * σ) (γ⁻¹)]
    constructor
    · intro h
      calc
        σ = 1 * σ := (one_mul σ).symm
        _ = (γ * (σ_P ^ m) * (σ_P ^ m)⁻¹ * γ⁻¹) * σ := by
            rw [mul_assoc γ (σ_P ^ m), mul_inv_cancel, mul_one, mul_inv_cancel]
        _ = γ * (σ_P ^ m) * ((σ_P ^ m)⁻¹ * γ⁻¹ * σ) := by simp only [mul_assoc]
        _ = γ * (σ_P ^ m) * γ⁻¹ := by rw [h]
    · rintro rfl
      simp only [mul_assoc, inv_mul_cancel_left]

  
  have hPartB :
      (∀ d ∈ Nat.divisors r, ∀ (P : Polynomial F),
        IsGoodAffineCurveClosedPointPoly S_aff d P →
        Finite { ξ : F_bar // Polynomial.aeval ξ P = 0 } ∧
        Nat.card { ξ : F_bar // Polynomial.aeval ξ P = 0 } = d ∧
        ∀ ξ : F_bar, Polynomial.aeval ξ P = 0 →
          ξ ^ (q ^ r) = ξ ∧
          (∀ s_a ∈ S_aff, ξ ≠ algebraMap F F_bar s_a) ∧
          minpoly F ξ = P) ∧
      (∀ ξ : F_bar,
        ξ ^ (q ^ r) = ξ →
        (∀ s_a ∈ S_aff, ξ ≠ algebraMap F F_bar s_a) →
        (minpoly F ξ).natDegree ∈ Nat.divisors r ∧
        IsGoodAffineCurveClosedPointPoly S_aff (minpoly F ξ).natDegree (minpoly F ξ) ∧
        Polynomial.aeval ξ (minpoly F ξ) = 0) := by
    letI : Fintype F := Fintype.ofFinite F
    have hq_card : Fintype.card F = q := Fintype.card_eq_nat_card
    have hq_gt1 : 1 < q := Finite.one_lt_card
    let ι_F := algebraMap F F_bar
    refine ⟨?_, ?_⟩
    · intro d hd P ⟨hMon, hIrr, hDeg, hP_avoid⟩
      have hd_dvd : d ∣ r := (Nat.mem_divisors.mp hd).1
      let P_bar : Polynomial F_bar := P.map ι_F
      have hMon_bar : P_bar.Monic := hMon.map ι_F
      have hPbar_ne : P_bar ≠ 0 := hMon_bar.ne_zero
      have hDeg_bar : P_bar.natDegree = d := (hMon.natDegree_map ι_F).trans hDeg
      have hSep_bar : P_bar.Separable := (PerfectField.separable_of_irreducible hIrr).map
      have hSplits_bar : P_bar.Splits := IsAlgClosed.splits P_bar
      have hNodup : P_bar.roots.Nodup := Polynomial.nodup_roots hSep_bar
      have hCard_roots : (P_bar.roots.toFinset).card = d := by
        rw [Multiset.toFinset_card_of_nodup hNodup,
          ← hSplits_bar.natDegree_eq_card_roots, hDeg_bar]
      have hMem_iff : ∀ ξ : F_bar, ξ ∈ P_bar.roots.toFinset ↔ Polynomial.aeval ξ P = 0 := by
        intro ξ
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hPbar_ne, Polynomial.IsRoot.def,
          Polynomial.eval_map, ← Polynomial.aeval_def]
      let e_roots : { ξ : F_bar // Polynomial.aeval ξ P = 0 } ≃ ↥(P_bar.roots.toFinset) :=
        Equiv.subtypeEquivRight fun ξ => (hMem_iff ξ).symm
      have hFin_roots : Finite { ξ : F_bar // Polynomial.aeval ξ P = 0 } :=
        Finite.of_equiv ↥(P_bar.roots.toFinset) e_roots.symm
      have hNatCard_roots : Nat.card { ξ : F_bar // Polynomial.aeval ξ P = 0 } = d := by
        rw [Nat.card_congr e_roots, Nat.card_eq_fintype_card, Fintype.card_coe, hCard_roots]
      refine ⟨hFin_roots, hNatCard_roots, fun ξ hξ => ?_⟩
      have hMin : minpoly F ξ = P :=
        (minpoly.eq_of_irreducible_of_monic hIrr hξ hMon).symm
      have hXi_avoid : ∀ s_a ∈ S_aff, ξ ≠ ι_F s_a := by
        intro s_a hs_a hEq
        rw [hEq, Polynomial.aeval_algebraMap_apply] at hξ
        exact hP_avoid s_a hs_a (ι_F.injective (hξ.trans (map_zero ι_F).symm))
      haveI : Fact (Irreducible P) := ⟨hIrr⟩
      let pb_P : PowerBasis F (AdjoinRoot P) := AdjoinRoot.powerBasis' hMon
      haveI : FiniteDimensional F (AdjoinRoot P) := PowerBasis.finite pb_P
      haveI : Finite (AdjoinRoot P) := Module.finite_of_finite F
      letI : Fintype (AdjoinRoot P) := Fintype.ofFinite (AdjoinRoot P)
      have hcard_AP : Fintype.card (AdjoinRoot P) = q ^ d := by
        rw [← Nat.card_eq_fintype_card,
          Module.natCard_eq_pow_finrank (K := F) (V := AdjoinRoot P),
          pb_P.finrank, AdjoinRoot.powerBasis'_dim, hDeg]
      have hpow_root : (AdjoinRoot.root P) ^ (q ^ d) = AdjoinRoot.root P := by
        rw [← hcard_AP]
        exact FiniteField.pow_card (AdjoinRoot.root P)
      have hξ_eval2 : Polynomial.eval₂ ι_F ξ P = 0 := hξ
      have hξ_qd : ξ ^ (q ^ d) = ξ := by
        have h1 := congrArg (AdjoinRoot.lift ι_F ξ hξ_eval2) hpow_root
        simpa only [map_pow, AdjoinRoot.lift_root] using h1
      rcases hd_dvd with ⟨m, hm_eq⟩
      have hξ_qr : ξ ^ (q ^ r) = ξ := by
        rw [hm_eq]
        clear hm_eq hd hNatCard_roots
        induction m with
        | zero => rw [Nat.mul_zero, pow_zero, pow_one]
        | succ m ih => rw [Nat.mul_succ, pow_add, pow_mul, ih, hξ_qd]
      exact ⟨hξ_qr, hXi_avoid, hMin⟩
    · let φ_q : F_bar ≃ₐ[F] F_bar := FiniteField.frobeniusAlgEquivOfAlgebraic F F_bar
      have hφ_apply : ∀ x : F_bar, φ_q x = x ^ q := by
        intro x
        rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, hq_card]
      have hφ_pow : ∀ (k : ℕ) (x : F_bar), (φ_q ^ k) x = x ^ (q ^ k) := by
        intro k
        induction k with
        | zero => intro x; rw [pow_zero, pow_zero, pow_one, AlgEquiv.one_apply]
        | succ k ih =>
          intro x
          rw [pow_succ', AlgEquiv.mul_apply, ih x, hφ_apply, ← pow_mul, ← pow_succ]
      let E_r : IntermediateField F F_bar :=
        { (AlgHom.equalizer (φ_q ^ r).toAlgHom (AlgHom.id F F_bar)) with
          inv_mem' := by
            intro x hx
            change (φ_q ^ r) x⁻¹ = x⁻¹
            have hx' : (φ_q ^ r) x = x := hx
            rw [map_inv₀, hx'] }
      have hMem_Er : ∀ x : F_bar, x ∈ E_r ↔ x ^ (q ^ r) = x := by
        intro x
        change (φ_q ^ r) x = x ↔ x ^ (q ^ r) = x
        rw [hφ_pow r x]
      have hqr_gt1 : 1 < q ^ r := Nat.one_lt_pow (by omega) hq_gt1
      let G_r : Polynomial F_bar := Polynomial.X ^ (q ^ r) - Polynomial.X
      have hGr_deg : G_r.natDegree = q ^ r := by
        dsimp [G_r]
        rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
        rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
        exact hqr_gt1
      have hGr_ne : G_r ≠ 0 := by
        intro h0
        rw [h0, Polynomial.natDegree_zero] at hGr_deg
        omega
      have hqr_cast_zero : ((q ^ r : ℕ) : F_bar) = 0 := by
        have hq0_F : (q : F) = 0 := by
          rw [← hq_card]
          exact Nat.cast_card_eq_zero F
        have hq0_F_bar : (q : F_bar) = 0 := by
          rw [← map_natCast ι_F q, hq0_F, map_zero]
        rw [Nat.cast_pow, hq0_F_bar, zero_pow (by omega)]
      have hGr_deriv : Polynomial.derivative G_r = -1 := by
        dsimp [G_r]
        rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_X,
          hqr_cast_zero, map_zero, zero_mul, zero_sub]
      have hGr_sep : G_r.Separable := by
        change IsCoprime G_r (Polynomial.derivative G_r)
        rw [hGr_deriv]
        exact isCoprime_one_right.neg_right
      have hGr_card : (G_r.roots.toFinset).card = q ^ r := by
        rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hGr_sep),
          ← (IsAlgClosed.splits G_r).natDegree_eq_card_roots, hGr_deg]
      have hEr_iff : ∀ x : F_bar, x ∈ E_r ↔ x ∈ G_r.roots.toFinset := by
        intro x
        rw [hMem_Er, Multiset.mem_toFinset, Polynomial.mem_roots hGr_ne, Polynomial.IsRoot.def]
        simp only [G_r, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, sub_eq_zero]
      let e_Er : ↥E_r ≃ ↥(G_r.roots.toFinset) := Equiv.subtypeEquivRight hEr_iff
      haveI : Finite ↥E_r := Finite.of_equiv ↥(G_r.roots.toFinset) e_Er.symm
      haveI : FiniteDimensional F ↥E_r := inferInstance
      have hFinrank_Er : Module.finrank F ↥E_r = r := by
        have hCard_Er : Nat.card ↥E_r = q ^ r := by
          rw [Nat.card_congr e_Er, Nat.card_eq_fintype_card, Fintype.card_coe, hGr_card]
        have hPow_eq : q ^ Module.finrank F ↥E_r = q ^ r := by
          rw [← Module.natCard_eq_pow_finrank (K := F) (V := ↥E_r), hCard_Er]
        exact Nat.pow_right_injective hq_gt1 hPow_eq
      intro ξ hξ_pow hξ_avoid
      let ξ_E : ↥E_r := ⟨ξ, (hMem_Er ξ).mpr hξ_pow⟩
      have hInt_E : IsIntegral F ξ_E := Algebra.IsIntegral.isIntegral ξ_E
      have hInt_ξ : IsIntegral F ξ := by
        change IsIntegral F (E_r.val ξ_E)
        exact IsIntegral.map E_r.val hInt_E
      have hMin_eq : minpoly F ξ = minpoly F ξ_E :=
        minpoly.algHom_eq E_r.val E_r.val.injective ξ_E
      have hMon_min : (minpoly F ξ).Monic := minpoly.monic hInt_ξ
      have hIrr_min : Irreducible (minpoly F ξ) := minpoly.irreducible hInt_ξ
      have hAeval_min : Polynomial.aeval ξ (minpoly F ξ) = 0 := minpoly.aeval F ξ
      have hAvoid_min : ∀ s_a ∈ S_aff, (minpoly F ξ).eval s_a ≠ 0 := by
        intro s_a hs_a heval
        have hdvd : Polynomial.X - Polynomial.C s_a ∣ minpoly F ξ :=
          Polynomial.dvd_iff_isRoot.mpr heval
        rcases hdvd with ⟨Q_fac, hQ_fac⟩
        have hNotUnit_X : ¬ IsUnit (Polynomial.X - Polynomial.C s_a) := by
          intro hu
          have hdeg0 := Polynomial.natDegree_eq_zero_of_isUnit hu
          rw [Polynomial.natDegree_X_sub_C] at hdeg0
          exact one_ne_zero hdeg0
        have hUnit_Q : IsUnit Q_fac :=
          (hIrr_min.isUnit_or_isUnit hQ_fac).resolve_left hNotUnit_X
        have hUnit_aevalQ : IsUnit (Polynomial.aeval ξ Q_fac) :=
          hUnit_Q.map (Polynomial.aeval ξ).toRingHom.toMonoidHom
        have hZero_prod : (ξ - ι_F s_a) * Polynomial.aeval ξ Q_fac = 0 := by
          have h0 := hAeval_min
          rw [hQ_fac, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at h0
          exact h0
        have hSub0 : ξ - ι_F s_a = 0 :=
          (mul_eq_zero.mp hZero_prod).resolve_right hUnit_aevalQ.ne_zero
        exact hξ_avoid s_a hs_a (sub_eq_zero.mp hSub0)
      have hDeg_dvd : (minpoly F ξ).natDegree ∣ r := by
        let K_ξ := IntermediateField.adjoin F ({ξ_E} : Set ↥E_r)
        rw [hMin_eq, ← IntermediateField.adjoin.finrank hInt_E, ← hFinrank_Er]
        exact ⟨Module.finrank ↥K_ξ ↥E_r,
          (Module.finrank_mul_finrank F ↥K_ξ ↥E_r).symm⟩
      exact ⟨Nat.mem_divisors.mpr ⟨hDeg_dvd, by omega⟩,
        ⟨hMon_min, hIrr_min, rfl, hAvoid_min⟩, hAeval_min⟩

  
  have hPartC : ∀ σ : B₀ ≃ₐ[R₀] B₀,
      Nat.card { y : ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀)) //
        IsClosed ({y} : Set ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))) ∧
        (CategoryTheory.CategoryStruct.comp
          (weilSchemeEndPow (weilGeomFrobHom F (weilCurveTrGeomCoverOver F B₀)) r)
          (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)).base y = y } =
      Nat.card { χ : B₀ →ₐ[F] F_bar // ∀ b : B₀, (χ (σ b)) ^ (q ^ r) = χ b } := by
    haveI : Algebra.FinitePresentation (Polynomial F) R₀ :=
      IsLocalization.Away.finitePresentation g_S
    have hFT_Poly_B₀ : Algebra.FiniteType (Polynomial F) B₀ :=
      Algebra.FiniteType.trans (R := Polynomial F) (S := R₀) (A := B₀) inferInstance inferInstance
    haveI : Algebra.FiniteType F B₀ :=
      Algebra.FiniteType.trans (R := F) (S := Polynomial F) (A := B₀) inferInstance hFT_Poly_B₀
    let A := TensorProduct F B₀ F_bar
    let A' := TensorProduct F F_bar B₀
    let e_comm : A ≃ₐ[F] A' := Algebra.TensorProduct.comm F B₀ F_bar
    haveI : Algebra.FiniteType F_bar A' := Algebra.FiniteType.baseChange F_bar
    let φ_of : (B₀ →ₐ[F] F_bar) → (A →ₐ[F] F_bar) :=
      fun χ => Algebra.TensorProduct.lift χ (AlgHom.id F F_bar) (fun _ _ => Commute.all _ _)
    have hφ_surj : ∀ χ : B₀ →ₐ[F] F_bar, Function.Surjective (φ_of χ).toRingHom := by
      intro χ c
      refine ⟨TensorProduct.tmul F 1 c, ?_⟩
      change χ 1 * c = c
      rw [map_one, one_mul]
    let p_of : (B₀ →ₐ[F] F_bar) → PrimeSpectrum A := fun χ =>
      ⟨RingHom.ker (φ_of χ).toRingHom, RingHom.ker_isPrime (φ_of χ).toRingHom⟩
    have hp_closed : ∀ χ : B₀ →ₐ[F] F_bar, IsClosed ({p_of χ} : Set (PrimeSpectrum A)) := by
      intro χ
      rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal]
      exact RingHom.ker_isMaximal_of_surjective (φ_of χ).toRingHom (hφ_surj χ)
    have hp_inj : Function.Injective p_of := by
      intro χ₁ χ₂ hEq
      have hker : RingHom.ker (φ_of χ₁).toRingHom = RingHom.ker (φ_of χ₂).toRingHom :=
        congrArg PrimeSpectrum.asIdeal hEq
      ext b
      have hmem₁ : TensorProduct.tmul F b (1 : F_bar) - TensorProduct.tmul F (1 : B₀) (χ₁ b) ∈
          RingHom.ker (φ_of χ₁).toRingHom := by
        rw [RingHom.mem_ker, map_sub]
        change χ₁ b * 1 - χ₁ 1 * χ₁ b = 0
        rw [mul_one, map_one, one_mul, sub_self]
      rw [hker, RingHom.mem_ker, map_sub] at hmem₁
      change χ₂ b * 1 - χ₂ 1 * χ₁ b = 0 at hmem₁
      rw [mul_one, map_one, one_mul] at hmem₁
      exact (sub_eq_zero.mp hmem₁).symm
    have hp_surj : ∀ p : PrimeSpectrum A, IsClosed ({p} : Set (PrimeSpectrum A)) →
        ∃ χ : B₀ →ₐ[F] F_bar, p_of χ = p := by
      intro p hp
      haveI : p.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mp hp
      let m' : Ideal A' := Ideal.comap e_comm.symm.toRingHom p.asIdeal
      haveI : m'.IsMaximal :=
        Ideal.comap_isMaximal_of_surjective e_comm.symm.toRingHom e_comm.symm.surjective
      let K_m := A' ⧸ m'
      letI : Field K_m := Ideal.Quotient.field m'
      haveI : Algebra.FiniteType F_bar K_m :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ F_bar m') Ideal.Quotient.mk_surjective
      haveI : Module.Finite F_bar K_m := finite_of_finite_type_of_isJacobsonRing F_bar K_m
      haveI : Algebra.IsIntegral F_bar K_m := Algebra.IsIntegral.of_finite F_bar K_m
      have hbij : Function.Bijective (algebraMap F_bar K_m) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let ι_inv : K_m ≃ₐ[F_bar] F_bar := (AlgEquiv.ofBijective (Algebra.ofId F_bar K_m) hbij).symm
      let q_map : A' →ₐ[F_bar] F_bar := ι_inv.toAlgHom.comp (Ideal.Quotient.mkₐ F_bar m')
      let Φ : A →ₐ[F] F_bar := (q_map.restrictScalars F).comp e_comm.toAlgHom
      let χ : B₀ →ₐ[F] F_bar := Φ.comp Algebra.TensorProduct.includeLeft
      have hΦ_eq : φ_of χ = Φ := by
        apply Algebra.TensorProduct.ext
        · ext b
          change χ b * 1 = χ b
          exact mul_one (χ b)
        · ext c
          change χ 1 * c = ι_inv (Ideal.Quotient.mk m' (TensorProduct.tmul F c (1 : B₀)))
          have he : Ideal.Quotient.mk m' (TensorProduct.tmul F c (1 : B₀)) =
              algebraMap F_bar K_m c := rfl
          rw [map_one, one_mul, he]
          exact (ι_inv.commutes c).symm
      refine ⟨χ, PrimeSpectrum.ext ?_⟩
      change RingHom.ker (φ_of χ).toRingHom = p.asIdeal
      rw [hΦ_eq]
      ext z
      change Φ z = 0 ↔ z ∈ p.asIdeal
      have hker_ι : Φ z = 0 ↔ Ideal.Quotient.mk m' (e_comm z) = 0 := by
        change ι_inv (Ideal.Quotient.mk m' (e_comm z)) = 0 ↔ _
        exact ⟨fun h => ι_inv.injective (h.trans (map_zero ι_inv).symm),
          fun h => by rw [h, map_zero]⟩
      rw [hker_ι, Ideal.Quotient.eq_zero_iff_mem]
      change e_comm.symm (e_comm z) ∈ p.asIdeal ↔ z ∈ p.asIdeal
      rw [e_comm.symm_apply_apply]

    letI : Fintype F := Fintype.ofFinite F
    have hq_card : Fintype.card F = q := Fintype.card_eq_nat_card
    let φ_q : F_bar ≃ₐ[F] F_bar := FiniteField.frobeniusAlgEquivOfAlgebraic F F_bar
    let ψ : F_bar ≃ₐ[F] F_bar := φ_q.symm
    have hφ_pow : ∀ (k : ℕ) (c : F_bar), (φ_q ^ k) c = c ^ (q ^ k) := by
      intro k
      induction k with
      | zero => intro c; rw [pow_zero, pow_zero, pow_one, AlgEquiv.one_apply]
      | succ k ih =>
        intro c
        rw [pow_succ', AlgEquiv.mul_apply, ih c, FiniteField.frobeniusAlgEquivOfAlgebraic_apply,
          hq_card, ← pow_mul, ← pow_succ]
    have hφψ_pow : ∀ (k : ℕ) (c : F_bar), (φ_q ^ k) ((ψ ^ k) c) = c := by
      intro k c
      have hmul : φ_q * ψ = 1 := by ext x; exact φ_q.apply_symm_apply x
      have hcomm : Commute φ_q ψ := by
        change φ_q * ψ = ψ * φ_q
        rw [hmul]
        ext x
        exact (φ_q.symm_apply_apply x).symm
      have hpow_mul : (φ_q ^ k) * (ψ ^ k) = 1 := by
        rw [← hcomm.mul_pow, hmul, one_pow]
      exact AlgEquiv.congr_fun hpow_mul c

    let V_ov := weilCurveTrGeomCoverOver F B₀
    let f₁_pb := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F B₀))
    let f₂_pb := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F_bar))
    let P_pb := CategoryTheory.Limits.pullback f₁_pb f₂_pb
    let iso : P_pb ≅ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.pullbackSpecIso F B₀ F_bar
    let g_frob : P_pb ⟶ P_pb := weilGeomFrobHom F V_ov
    have hg_fst : g_frob ≫ CategoryTheory.Limits.pullback.fst f₁_pb f₂_pb =
        CategoryTheory.Limits.pullback.fst f₁_pb f₂_pb :=
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
    have hg_snd : g_frob ≫ CategoryTheory.Limits.pullback.snd f₁_pb f₂_pb =
        CategoryTheory.Limits.pullback.snd f₁_pb f₂_pb ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let θ_g : ∀ k : ℕ, A →ₐ[F] A :=
      fun k => Algebra.TensorProduct.map (AlgHom.id F B₀) (ψ ^ k).toAlgHom
    have hg_one : iso.inv ≫ g_frob =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_g 1).toRingHom) ≫ iso.inv := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hg_fst,
          AlgebraicGeometry.pullbackSpecIso_inv_fst,
          CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
          ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro b
        change TensorProduct.tmul F b (1 : F_bar) = TensorProduct.tmul F b ((ψ ^ 1) 1)
        rw [pow_one, map_one]
      · rw [CategoryTheory.Category.assoc, hg_snd,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
    have hg_pow : ∀ k : ℕ,
        iso.inv ≫ (weilSchemeEndPow (weilGeomFrobHom F V_ov) k : P_pb ⟶ P_pb) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_g k).toRingHom) ≫ iso.inv := by
      intro k
      induction k with
      | zero =>
        change iso.inv ≫ 𝟙 P_pb = _
        rw [CategoryTheory.Category.comp_id]
        have hθ0 : θ_g 0 = AlgHom.id F A := by
          apply Algebra.TensorProduct.ext
          · ext b; rfl
          · ext c; rfl
        have hid : CommRingCat.ofHom (θ_g 0).toRingHom = 𝟙 (CommRingCat.of A) := by
          rw [hθ0]; rfl
        rw [hid, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
      | succ k ih =>
        change iso.inv ≫ (g_frob ≫ (weilSchemeEndPow (weilGeomFrobHom F V_ov) k : P_pb ⟶ P_pb)) = _
        rw [← CategoryTheory.Category.assoc, hg_one, CategoryTheory.Category.assoc, ih,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hθ_succ : (θ_g 1).comp (θ_g k) = θ_g (k + 1) := by
          apply Algebra.TensorProduct.ext
          · ext b
            change TensorProduct.tmul F b ((ψ ^ 1) ((ψ ^ k) 1)) =
              TensorProduct.tmul F b ((ψ ^ (k + 1)) 1)
            rw [map_one, map_one, map_one]
          · ext c
            change TensorProduct.tmul F (1 : B₀) ((ψ ^ 1) ((ψ ^ k) c)) =
              TensorProduct.tmul F (1 : B₀) ((ψ ^ (k + 1)) c)
            rw [pow_one, pow_succ', AlgEquiv.mul_apply]
        have hhom_succ :
            CommRingCat.ofHom (θ_g k).toRingHom ≫ CommRingCat.ofHom (θ_g 1).toRingHom =
              CommRingCat.ofHom (θ_g (k + 1)).toRingHom := by
          rw [← hθ_succ]; rfl
        rw [hhom_succ]

    intro σ
    let d_hom : P_pb ⟶ P_pb := weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹
    have hd_fst : d_hom ≫ CategoryTheory.Limits.pullback.fst f₁_pb f₂_pb =
        CategoryTheory.Limits.pullback.fst f₁_pb f₂_pb ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ⁻¹).symm.toRingHom) :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hd_snd : d_hom ≫ CategoryTheory.Limits.pullback.snd f₁_pb f₂_pb =
        CategoryTheory.Limits.pullback.snd f₁_pb f₂_pb :=
      (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id _)
    let θ_σ : A →ₐ[F] A := Algebra.TensorProduct.map (toFAlgHom σ) (AlgHom.id F F_bar)
    have hd_σ : iso.inv ≫ d_hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_σ.toRingHom) ≫ iso.inv := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hd_fst,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
          CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
      · rw [CategoryTheory.Category.assoc, hd_snd,
          AlgebraicGeometry.pullbackSpecIso_inv_snd,
          CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        change TensorProduct.tmul F (1 : B₀) c = TensorProduct.tmul F (σ 1) c
        rw [map_one]

    let α_pb : P_pb ⟶ P_pb :=
      (weilSchemeEndPow (weilGeomFrobHom F V_ov) r : P_pb ⟶ P_pb) ≫ d_hom
    let θ_comp : A →ₐ[F] A := (θ_g r).comp θ_σ
    have hα_inter : iso.inv ≫ α_pb =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_comp.toRingHom) ≫ iso.inv := by
      dsimp [α_pb]
      rw [← CategoryTheory.Category.assoc, hg_pow r, CategoryTheory.Category.assoc, hd_σ,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      congr 1

    have hComap_p : ∀ χ : B₀ →ₐ[F] F_bar,
        PrimeSpectrum.comap θ_comp.toRingHom (p_of χ) =
          p_of ((φ_q ^ r).toAlgHom.comp (twistAlgHom χ σ)) := by
      intro χ
      let χ' : B₀ →ₐ[F] F_bar := (φ_q ^ r).toAlgHom.comp (twistAlgHom χ σ)
      have hAlg_eq : (φ_q ^ r).toAlgHom.comp ((φ_of χ).comp θ_comp) = φ_of χ' := by
        apply Algebra.TensorProduct.ext
        · ext b
          change (φ_q ^ r) (χ (σ b) * (ψ ^ r) 1) = (φ_q ^ r) (χ (σ b)) * 1
          rw [map_one, mul_one, mul_one]
        · ext c
          change (φ_q ^ r) (χ (σ 1) * (ψ ^ r) c) = (φ_q ^ r) (χ (σ 1)) * c
          rw [map_one, map_one, one_mul, map_one, one_mul]
          exact hφψ_pow r c
      apply PrimeSpectrum.ext
      ext z
      change (φ_of χ) (θ_comp z) = 0 ↔ (φ_of χ') z = 0
      have h1 : (φ_of χ) (θ_comp z) = 0 ↔ (φ_q ^ r) ((φ_of χ) (θ_comp z)) = 0 :=
        ⟨fun h => by rw [h, map_zero],
         fun h => (φ_q ^ r).injective (h.trans (map_zero (φ_q ^ r)).symm)⟩
      rw [h1]
      exact iff_of_eq (congrArg (· = 0) (AlgHom.congr_fun hAlg_eq z))

    let homeo : PrimeSpectrum A ≃ₜ ↥(weilGeomScheme F V_ov) :=
      TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso.symm)
    let α_σ := CategoryTheory.CategoryStruct.comp
      (weilSchemeEndPow (weilGeomFrobHom F V_ov) r)
      (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)
    have hα_on_homeo : ∀ p : PrimeSpectrum A,
        α_σ.base (homeo p) = homeo (PrimeSpectrum.comap θ_comp.toRingHom p) := by
      intro p
      have hpt := congrArg (fun f : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ P_pb => f.base p) hα_inter
      have hL : (iso.inv ≫ α_pb).base p = α_σ.base (homeo p) := rfl
      have hR : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_comp.toRingHom) ≫ iso.inv).base p =
          homeo (PrimeSpectrum.comap θ_comp.toRingHom p) :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_comp.toRingHom)) iso.inv p).trans
          (congrArg homeo
            (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom θ_comp.toRingHom) p))
      exact hL.symm.trans (hpt.trans hR)

    let toV : { χ : B₀ →ₐ[F] F_bar // ∀ b : B₀, (χ (σ b)) ^ (q ^ r) = χ b } →
        { y : ↥(weilGeomScheme F V_ov) //
          IsClosed ({y} : Set ↥(weilGeomScheme F V_ov)) ∧ α_σ.base y = y } :=
      fun ⟨χ, hχ⟩ =>
        ⟨homeo (p_of χ),
         by
           have hc : IsClosed (homeo '' ({p_of χ} : Set (PrimeSpectrum A))) :=
             (homeo.isClosed_image).mpr (hp_closed χ)
           rwa [Set.image_singleton] at hc,
         by
           rw [hα_on_homeo, hComap_p]
           have hχ_eq : (φ_q ^ r).toAlgHom.comp (twistAlgHom χ σ) = χ := by
             ext b
             change (φ_q ^ r) (χ (σ b)) = χ b
             rw [hφ_pow r (χ (σ b))]
             exact hχ b
           rw [hχ_eq]⟩
    have hBij_toV : Function.Bijective toV := by
      refine ⟨?_, ?_⟩
      · rintro ⟨χ₁, _⟩ ⟨χ₂, _⟩ hEq
        have hp_eq : p_of χ₁ = p_of χ₂ := homeo.injective (congrArg Subtype.val hEq)
        exact Subtype.ext (hp_inj hp_eq)
      · rintro ⟨y, hy_cl, hy_fix⟩
        let p : PrimeSpectrum A := homeo.symm y
        have hp_cl : IsClosed ({p} : Set (PrimeSpectrum A)) := by
          have hc : IsClosed (homeo.symm '' ({y} : Set ↥(weilGeomScheme F V_ov))) :=
            (homeo.symm.isClosed_image).mpr hy_cl
          rwa [Set.image_singleton] at hc
        obtain ⟨χ, hχ_p⟩ := hp_surj p hp_cl
        have hy_eq : homeo (p_of χ) = y := by
          rw [hχ_p]
          exact homeo.apply_symm_apply y
        have hFix_p : p_of ((φ_q ^ r).toAlgHom.comp (twistAlgHom χ σ)) = p_of χ := by
          apply homeo.injective
          rw [← hComap_p, ← hα_on_homeo, hy_eq, hy_fix]
        have hAlg_fix : (φ_q ^ r).toAlgHom.comp (twistAlgHom χ σ) = χ := hp_inj hFix_p
        have hχ_prop : ∀ b : B₀, (χ (σ b)) ^ (q ^ r) = χ b := by
          intro b
          have hb := AlgHom.congr_fun hAlg_fix b
          change (φ_q ^ r) (χ (σ b)) = χ b at hb
          rwa [hφ_pow r (χ (σ b))] at hb
        refine ⟨⟨χ, hχ_prop⟩, Subtype.ext hy_eq⟩
    exact (Nat.card_congr (Equiv.ofBijective toV hBij_toV)).symm

  
  obtain ⟨hPolyRoots, hXiMinpoly⟩ := hPartB
  let Good := fun d => { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }
  let Q_dj : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))), Ideal B₀ :=
    fun d j => Classical.choose (hQP₀ d.1 (e d.1 j).1 (e d.1 j).2)
  have hQ_spec : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))),
      (Q_dj d j).IsMaximal ∧
      Ideal.comap (algebraMap (Polynomial F) B₀) (Q_dj d j) = Ideal.span {(e d.1 j).1} ∧
      ∃ σ_P : B₀ ≃ₐ[R₀] B₀,
        (∀ b : B₀, σ_P.symm b - b ^ (q ^ d.1) ∈ Q_dj d j) ∧
        (τ_rep₀ σ_P).val = (A_mat d.1 (e d.1 j).1 (e d.1 j).2).map (PadicInt.toZModPow (s + 1)) :=
    fun d j => Classical.choose_spec (hQP₀ d.1 (e d.1 j).1 (e d.1 j).2)
  let σ_dj : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))), B₀ ≃ₐ[R₀] B₀ :=
    fun d j => Classical.choose (hQ_spec d j).2.2
  have hσ_spec : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))),
      (∀ b : B₀, (σ_dj d j).symm b - b ^ (q ^ d.1) ∈ Q_dj d j) ∧
      (τ_rep₀ (σ_dj d j)).val =
        (A_mat d.1 (e d.1 j).1 (e d.1 j).2).map (PadicInt.toZModPow (s + 1)) :=
    fun d j => Classical.choose_spec (hQ_spec d j).2.2

  let Roots : ∀ (d : ↥(Nat.divisors r)), Fin (Nat.card (Good d.1)) → Type u :=
    fun d j => { ξ : F_bar // Polynomial.aeval ξ (e d.1 j).1 = 0 }
  let instFinRoots : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))),
      Fintype (Roots d j) :=
    fun d j => @Fintype.ofFinite _ (hPolyRoots d.1 d.2 (e d.1 j).1 (e d.1 j).2).1
  letI : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))), Fintype (Roots d j) :=
    instFinRoots
  have hCardRoots : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))),
      Fintype.card (Roots d j) = d.1 := by
    intro d j
    rw [← Nat.card_eq_fintype_card]
    exact (hPolyRoots d.1 d.2 (e d.1 j).1 (e d.1 j).2).2.1

  have hLiftEx : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))) (ξ : Roots d j),
      ∃ χ₀ : B₀ →ₐ[F] F_bar,
        χ₀ X_B₀ = ξ.1 ∧
        ∀ (γ σ : B₀ ≃ₐ[R₀] B₀),
          (∀ b : B₀, (χ₀ (γ⁻¹ (σ b))) ^ (q ^ r) = χ₀ (γ⁻¹ b)) ↔
            σ = γ * (σ_dj d j ^ (r / d.1)) * γ⁻¹ := by
    intro d j ξ
    have hd_mul : d.1 * (r / d.1) = r := Nat.mul_div_cancel' (Nat.mem_divisors.mp d.2).1
    obtain ⟨χ₀, hX, hIff⟩ := hFrobLift d.1 (r / d.1) (e d.1 j).1 (e d.1 j).2
      (Q_dj d j) (hQ_spec d j).1 (hQ_spec d j).2.1 (σ_dj d j) (hσ_spec d j).1 ξ.1 ξ.2
    rw [hd_mul] at hIff
    exact ⟨χ₀, hX, hIff⟩

  let χ_base : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))) (ξ : Roots d j),
      B₀ →ₐ[F] F_bar :=
    fun d j ξ => Classical.choose (hLiftEx d j ξ)
  have hχ_base_X : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))) (ξ : Roots d j),
      (χ_base d j ξ) X_B₀ = ξ.1 :=
    fun d j ξ => (Classical.choose_spec (hLiftEx d j ξ)).1
  have hχ_base_iff : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))) (ξ : Roots d j)
      (γ σ : B₀ ≃ₐ[R₀] B₀),
      (∀ b : B₀, ((χ_base d j ξ) (γ⁻¹ (σ b))) ^ (q ^ r) = (χ_base d j ξ) (γ⁻¹ b)) ↔
        σ = γ * (σ_dj d j ^ (r / d.1)) * γ⁻¹ :=
    fun d j ξ => (Classical.choose_spec (hLiftEx d j ξ)).2

  let Idx := Σ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))) (_ : Roots d j),
    (B₀ ≃ₐ[R₀] B₀)
  let σ_target : Idx → (B₀ ≃ₐ[R₀] B₀) :=
    fun ⟨d, j, _, γ⟩ => γ * (σ_dj d j ^ (r / d.1)) * γ⁻¹
  let χ_of : Idx → (B₀ →ₐ[F] F_bar) :=
    fun ⟨d, j, ξ, γ⟩ => twistAlgHom (χ_base d j ξ) γ⁻¹

  have hχ_of_inj : Function.Injective χ_of := by
    rintro ⟨d₁, j₁, ξ₁, γ₁⟩ ⟨d₂, j₂, ξ₂, γ₂⟩ hEq
    have hEvalX : χ_of ⟨d₁, j₁, ξ₁, γ₁⟩ X_B₀ = χ_of ⟨d₂, j₂, ξ₂, γ₂⟩ X_B₀ :=
      AlgHom.congr_fun hEq X_B₀
    have hX_simp : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))) (ξ : Roots d j)
        (γ : B₀ ≃ₐ[R₀] B₀), χ_of ⟨d, j, ξ, γ⟩ X_B₀ = ξ.1 := by
      intro d j ξ γ
      change (χ_base d j ξ) (γ⁻¹ X_B₀) = ξ.1
      rw [hFixPoly γ⁻¹ Polynomial.X, hχ_base_X]
    rw [hX_simp, hX_simp] at hEvalX
    have hMin₁ := ((hPolyRoots d₁.1 d₁.2 (e d₁.1 j₁).1 (e d₁.1 j₁).2).2.2 ξ₁.1 ξ₁.2).2.2
    have hMin₂ := ((hPolyRoots d₂.1 d₂.2 (e d₂.1 j₂).1 (e d₂.1 j₂).2).2.2 ξ₂.1 ξ₂.2).2.2
    have hPoly_eq : (e d₁.1 j₁).1 = (e d₂.1 j₂).1 := by
      rw [← hMin₁, ← hMin₂, hEvalX]
    have hd_val : d₁.1 = d₂.1 := by
      rw [← (e d₁.1 j₁).2.2.2.1, ← (e d₂.1 j₂).2.2.2.1, hPoly_eq]
    have hd_eq : d₁ = d₂ := Subtype.ext hd_val
    subst hd_eq
    have hj_eq : j₁ = j₂ := (e d₁.1).injective (Subtype.ext hPoly_eq)
    subst hj_eq
    have hξ_eq : ξ₁ = ξ₂ := Subtype.ext hEvalX
    subst hξ_eq
    have hγ_inv_eq : γ₁⁻¹ = γ₂⁻¹ :=
      (hFreeness (χ_base d₁ j₁ ξ₁) γ₁⁻¹ γ₂⁻¹).mp fun b => AlgHom.congr_fun hEq b
    have hγ_eq : γ₁ = γ₂ := inv_inj.mp hγ_inv_eq
    subst hγ_eq
    rfl

  have hCard_σ : ∀ σ : B₀ ≃ₐ[R₀] B₀,
      (Nat.card { y : ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀)) //
        IsClosed ({y} : Set ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))) ∧
        (CategoryTheory.CategoryStruct.comp
          (weilSchemeEndPow (weilGeomFrobHom F (weilCurveTrGeomCoverOver F B₀)) r)
          (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)).base y = y } : ZMod (ℓ ^ K')) =
      ∑ t : Idx, if σ = σ_target t then (1 : ZMod (ℓ ^ K')) else 0 := by
    intro σ
    rw [hPartC σ]
    let toFix : { t : Idx // σ = σ_target t } →
        { χ : B₀ →ₐ[F] F_bar // ∀ b : B₀, (χ (σ b)) ^ (q ^ r) = χ b } :=
      fun ⟨⟨d, j, ξ, γ⟩, hσ⟩ =>
        ⟨χ_of ⟨d, j, ξ, γ⟩, (hχ_base_iff d j ξ γ σ).mpr hσ⟩
    have hBij_Fix : Function.Bijective toFix := by
      refine ⟨?_, ?_⟩
      · rintro ⟨t₁, _⟩ ⟨t₂, _⟩ hEq
        exact Subtype.ext (hχ_of_inj (congrArg Subtype.val hEq))
      · rintro ⟨χ, hχ⟩
        have hPow_X : (χ X_B₀) ^ (q ^ r) = χ X_B₀ := by
          have h := hχ X_B₀
          rwa [hFixPoly σ Polynomial.X] at h
        have hAv_X : ∀ s_a ∈ S_aff, χ X_B₀ ≠ algebraMap F F_bar s_a :=
          fun s_a hs_a => hAvoid χ s_a hs_a
        obtain ⟨hd_mem, hGood_P, hRoot_P⟩ := hXiMinpoly (χ X_B₀) hPow_X hAv_X
        let d : ↥(Nat.divisors r) := ⟨(minpoly F (χ X_B₀)).natDegree, hd_mem⟩
        let j : Fin (Nat.card (Good d.1)) := (e d.1).symm ⟨minpoly F (χ X_B₀), hGood_P⟩
        have he_apply : (e d.1 j).1 = minpoly F (χ X_B₀) := by
          change ((e d.1) ((e d.1).symm ⟨minpoly F (χ X_B₀), hGood_P⟩)).1 = _
          rw [(e d.1).apply_symm_apply]
        let ξ : Roots d j := ⟨χ X_B₀, by rw [he_apply]; exact hRoot_P⟩
        obtain ⟨γ, hγ⟩ := hTrans (χ_base d j ξ) χ (hχ_base_X d j ξ).symm
        have hχ_eq : χ = χ_of ⟨d, j, ξ, γ⟩ := AlgHom.ext hγ
        have hσ_eq : σ = σ_target ⟨d, j, ξ, γ⟩ := by
          apply (hχ_base_iff d j ξ γ σ).mp
          intro b
          rw [← hγ (σ b), ← hγ b]
          exact hχ b
        exact ⟨⟨⟨d, j, ξ, γ⟩, hσ_eq⟩, Subtype.ext hχ_eq.symm⟩
    have hNatCard : Nat.card { χ : B₀ →ₐ[F] F_bar // ∀ b : B₀, (χ (σ b)) ^ (q ^ r) = χ b } =
        ∑ t : Idx, if σ = σ_target t then 1 else 0 := by
      rw [← Nat.card_congr (Equiv.ofBijective toFix hBij_Fix), Nat.card_eq_fintype_card,
        Fintype.card_subtype, Finset.card_filter]
    rw [hNatCard, Nat.cast_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    split_ifs <;> simp

  let tr_val : (B₀ ≃ₐ[R₀] B₀) → ZMod (ℓ ^ K') :=
    fun σ => ((Matrix.trace (τ_rep₀ σ).val).val : ZMod (ℓ ^ K'))
  have hLHS_swap :
      ∑ σ : (B₀ ≃ₐ[R₀] B₀),
        (Nat.card { y : ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀)) //
          IsClosed ({y} : Set ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))) ∧
          (CategoryTheory.CategoryStruct.comp
            (weilSchemeEndPow (weilGeomFrobHom F (weilCurveTrGeomCoverOver F B₀)) r)
            (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)).base y = y } : ZMod (ℓ ^ K')) * tr_val σ =
      ∑ t : Idx, tr_val (σ_target t) := by
    calc
      _ = ∑ σ : (B₀ ≃ₐ[R₀] B₀),
            (∑ t : Idx, if σ = σ_target t then (1 : ZMod (ℓ ^ K')) else 0) * tr_val σ := by
            refine Finset.sum_congr rfl fun σ _ => ?_
            rw [hCard_σ σ]
      _ = ∑ σ : (B₀ ≃ₐ[R₀] B₀),
            ∑ t : Idx, (if σ = σ_target t then tr_val σ else 0) := by
            refine Finset.sum_congr rfl fun σ _ => ?_
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun t _ => ?_
            split_ifs <;> simp
      _ = ∑ t : Idx, ∑ σ : (B₀ ≃ₐ[R₀] B₀), (if σ = σ_target t then tr_val σ else 0) :=
            Finset.sum_comm
      _ = ∑ t : Idx, tr_val (σ_target t) := by
            refine Finset.sum_congr rfl fun t _ => ?_
            exact Fintype.sum_ite_eq' (σ_target t) tr_val

  have hTr_conj : ∀ (d : ↥(Nat.divisors r)) (j : Fin (Nat.card (Good d.1))) (ξ : Roots d j)
      (γ : B₀ ≃ₐ[R₀] B₀),
      Matrix.trace (τ_rep₀ (σ_target ⟨d, j, ξ, γ⟩)).val =
        PadicInt.toZModPow (s + 1)
          (Matrix.trace ((A_mat d.1 (e d.1 j).1 (e d.1 j).2) ^ (r / d.1))) := by
    intro d j ξ γ
    dsimp [σ_target]
    rw [map_mul, map_mul, map_pow, map_inv]
    set u := τ_rep₀ γ
    set M := ((τ_rep₀ (σ_dj d j)) ^ (r / d.1)).val
    have hconj : Matrix.trace (u.val * M * (u⁻¹).val) = Matrix.trace M := by
      rw [Matrix.trace_mul_comm (u.val * M) (u⁻¹).val, ← Matrix.mul_assoc,
        Units.inv_mul, Matrix.one_mul]
    change Matrix.trace (u.val * M * (u⁻¹).val) = _
    rw [hconj]
    dsimp [M]
    have hmap_pow : ∀ (M₀ : Matrix (Fin N) (Fin N) (PadicInt ℓ)) (k : ℕ),
        (M₀.map (PadicInt.toZModPow (s + 1))) ^ k =
          (M₀ ^ k).map (PadicInt.toZModPow (s + 1)) := by
      intro M₀ k
      induction k with
      | zero =>
        ext i₁ i₂
        by_cases h : i₁ = i₂ <;> simp [h]
      | succ k ih =>
        rw [pow_succ _ k, pow_succ _ k, ih]
        ext i₁ i₂
        simp [Matrix.mul_apply, map_sum, map_mul]
    rw [(hσ_spec d j).2, hmap_pow]
    simp only [Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]

  change ∑ σ : (B₀ ≃ₐ[R₀] B₀), _ * tr_val σ = _
  rw [hLHS_swap]
  rw [Fintype.sum_sigma]
  have hExpand :
      ∑ d : ↥(Nat.divisors r),
        ∑ x : (Σ (j : Fin (Nat.card (Good d.1))) (_ : Roots d j), (B₀ ≃ₐ[R₀] B₀)),
          tr_val (σ_target ⟨d, x.1, x.2.1, x.2.2⟩) =
      ∑ d : ↥(Nat.divisors r),
        (Fintype.card (B₀ ≃ₐ[R₀] B₀) : ZMod (ℓ ^ K')) *
          ∑ j : Fin (Nat.card (Good d.1)),
            (d.1 : ZMod (ℓ ^ K')) *
              ((PadicInt.toZModPow (s + 1)
                (Matrix.trace ((A_mat d.1 (e d.1 j).1 (e d.1 j).2) ^ (r / d.1)))).val :
                ZMod (ℓ ^ K')) := by
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [Fintype.sum_sigma, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Fintype.sum_sigma]
    have hInner :
        ∑ ξ : Roots d j, ∑ γ : (B₀ ≃ₐ[R₀] B₀), tr_val (σ_target ⟨d, j, ξ, γ⟩) =
        (d.1 : ZMod (ℓ ^ K')) *
          ((Fintype.card (B₀ ≃ₐ[R₀] B₀) : ZMod (ℓ ^ K')) *
            ((PadicInt.toZModPow (s + 1)
              (Matrix.trace ((A_mat d.1 (e d.1 j).1 (e d.1 j).2) ^ (r / d.1)))).val :
              ZMod (ℓ ^ K'))) := by
      trans (∑ _ξ : Roots d j, ∑ _γ : (B₀ ≃ₐ[R₀] B₀),
        ((PadicInt.toZModPow (s + 1)
          (Matrix.trace ((A_mat d.1 (e d.1 j).1 (e d.1 j).2) ^ (r / d.1)))).val :
          ZMod (ℓ ^ K')))
      · refine Finset.sum_congr rfl fun ξ _ => ?_
        refine Finset.sum_congr rfl fun γ _ => ?_
        dsimp [tr_val]
        rw [hTr_conj d j ξ γ]
      · rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
          Finset.sum_const, Finset.card_univ, hCardRoots d j, nsmul_eq_mul]
    rw [hInner]
    ring
  rw [hExpand, ← Finset.mul_sum]
  congr 1
  exact Finset.sum_coe_sort (Nat.divisors r) fun d =>
    ∑ j : Fin (Nat.card (Good d)),
      (d : ZMod (ℓ ^ K')) *
        ((PadicInt.toZModPow (s + 1)
          (Matrix.trace ((A_mat d (e d j).1 (e d j).2) ^ (r / d)))).val : ZMod (ℓ ^ K'))

theorem weil_curve_tower_lefschetz_trace_formula (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) (hN : 1 ≤ N)
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (𝒥₀ : ℕ → CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
      AddCommGrpCat.{u})
    (τ_𝒥 : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ r))
    (hZExt : WeilCurveZeroExtSystem.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat 𝒥₀ τ_𝒥)
    (M_c : ∀ i : ℕ, WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ i 𝒥₀ τ_𝒥)
    (r : ℕ)
    (e : ∀ d : ℕ,
      Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
        { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P })
    (hr : 1 ≤ r) :
    ∑ d ∈ Nat.divisors r,
      ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
        (d : Padic ℓ) *
          Matrix.trace (((A_mat d (e d j).1 (e d j).2).map
            (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d)) =
      ∑ i ∈ Finset.Iic 2, (-1) ^ i * LinearMap.trace (Padic ℓ) (M_c i).V ((M_c i).frob ^ r) :=
by
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out
  have hFactor : ∀ m : ℕ, 1 ≤ m → ∃ v u_ord : ℕ, m = ℓ ^ v * u_ord ∧ ¬ (ℓ ∣ u_ord) := by
    intro m
    induction m using Nat.strongRecOn with
    | ind m ih =>
      intro hm
      by_cases hdvd : ℓ ∣ m
      · rcases hdvd with ⟨m', rfl⟩
        have hm'_pos : 1 ≤ m' := by
          rcases Nat.eq_zero_or_pos m' with rfl | hpos
          · simp at hm
          · exact hpos
        have hm'_lt : m' < ℓ * m' := lt_mul_of_one_lt_left hm'_pos hPrime_ℓ.one_lt
        obtain ⟨v, u_ord, hmu, hndvd⟩ := ih m' hm'_lt hm'_pos
        exact ⟨v + 1, u_ord, by rw [hmu, pow_succ']; ring, hndvd⟩
      · exact ⟨0, m, by simp, hdvd⟩
  obtain ⟨B, L_fld,
    hCR, hDom, hFld,
    hAF_B, hAP_B, hAR_B, hAF_L, hAP_L, hARF_L, hABL, hARL,
    hST1, hST2, hST3, hST4, hST5, hST6,
    hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L,
    τ_rep, e_U, heU_eq, hQP,
    B₁, b_J, M_lat_J, hTr_J, hLevel⟩ :=
    weil_curve_tr_godement_and_bockstein_models F S_aff j_aff hj_open hj_hom
      s_inf hsinf_sec hsinf_compl U₀ hU₀_eq u₀ hu₀_sec hu₀_mem
      ℓ N hℓ hN H_geom A_u A_mat 𝒥₀ τ_𝒥 hZExt M_c r hr
  let _ : ∀ m, CommRing (B m) := hCR
  let _ : ∀ m, IsDomain (B m) := hDom
  let _ : ∀ m, Field (L_fld m) := hFld
  let _ : ∀ m, Algebra F (B m) := hAF_B
  let _ : ∀ m, Algebra (Polynomial F) (B m) := hAP_B
  let _ : ∀ m, Algebra R₀ (B m) := hAR_B
  let _ : ∀ m, Algebra F (L_fld m) := hAF_L
  let _ : ∀ m, Algebra (Polynomial F) (L_fld m) := hAP_L
  let _ : ∀ m, Algebra (RatFunc F) (L_fld m) := hARF_L
  let _ : ∀ m, Algebra (B m) (L_fld m) := hABL
  let _ : ∀ m, Algebra R₀ (L_fld m) := hARL
  let _ : ∀ m, IsScalarTower F (Polynomial F) (B m) := hST1
  let _ : ∀ m, IsScalarTower (Polynomial F) R₀ (B m) := hST2
  let _ : ∀ m, IsScalarTower F (RatFunc F) (L_fld m) := hST3
  let _ : ∀ m, IsScalarTower (Polynomial F) (RatFunc F) (L_fld m) := hST4
  let _ : ∀ m, IsScalarTower (Polynomial F) (B m) (L_fld m) := hST5
  let _ : ∀ m, IsScalarTower R₀ (B m) (L_fld m) := hST6
  let _ : ∀ m, Module.Finite R₀ (B m) := hFin_B
  let _ : ∀ m, Algebra.Etale R₀ (B m) := hEt_B
  let _ : ∀ m, IsFractionRing (B m) (L_fld m) := hFrac
  let _ : ∀ m, IsIntegralClosure (B m) R₀ (L_fld m) := hIntCl
  let _ : ∀ m, FiniteDimensional (RatFunc F) (L_fld m) := hFD_L
  let _ : ∀ m, IsGalois (RatFunc F) (L_fld m) := hGal_L
  let Good := fun d => { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }
  set LHS_int : PadicInt ℓ :=
    ∑ d ∈ Nat.divisors r,
      ∑ j : Fin (Nat.card (Good d)),
        (d : PadicInt ℓ) * Matrix.trace ((A_mat d (e d j).1 (e d j).2) ^ (r / d)) with hLHS_def
  set RHS_int : PadicInt ℓ :=
    Matrix.trace (M_lat_J 0) - Matrix.trace (M_lat_J 1) + Matrix.trace (M_lat_J 2) with hRHS_def
  have hLHS_cast : algebraMap (PadicInt ℓ) (Padic ℓ) LHS_int =
      ∑ d ∈ Nat.divisors r,
        ∑ j : Fin (Nat.card (Good d)),
          (d : Padic ℓ) *
            Matrix.trace (((A_mat d (e d j).1 (e d j).2).map
              (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d)) := by
    rw [hLHS_def]
    simp only [map_sum, map_mul, map_natCast]
    refine Finset.sum_congr rfl fun d _ => ?_
    refine Finset.sum_congr rfl fun j _ => ?_
    congr 1
    have hpow : ((A_mat d (e d j).1 (e d j).2) ^ (r / d)).map
        (algebraMap (PadicInt ℓ) (Padic ℓ)) =
      ((A_mat d (e d j).1 (e d j).2).map (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d) :=
      (RingHom.mapMatrix (algebraMap (PadicInt ℓ) (Padic ℓ))).map_pow
        (A_mat d (e d j).1 (e d j).2) (r / d)
    rw [← hpow]
    simp only [Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
  have hIic2 : (Finset.Iic 2 : Finset ℕ) = {0, 1, 2} := by decide
  have hRHS_cast : algebraMap (PadicInt ℓ) (Padic ℓ) RHS_int =
      ∑ i ∈ Finset.Iic 2, (-1) ^ i * LinearMap.trace (Padic ℓ) (M_c i).V ((M_c i).frob ^ r) := by
    rw [hIic2, Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_singleton]
    have h0 := hTr_J 0
    have h1 := hTr_J 1
    have h2 := hTr_J 2
    change LinearMap.trace (Padic ℓ) (M_c 0).V ((M_c 0).frob ^ r) = _ at h0
    change LinearMap.trace (Padic ℓ) (M_c 1).V ((M_c 1).frob ^ r) = _ at h1
    change LinearMap.trace (Padic ℓ) (M_c 2).V ((M_c 2).frob ^ r) = _ at h2
    rw [h0, h1, h2, hRHS_def, map_add, map_sub]
    ring
  rw [← hLHS_cast, ← hRHS_cast]
  congr 1
  rw [← PadicInt.ext_of_toZModPow]
  intro n
  rcases n with _ | s
  · have _ : Subsingleton (ZMod (ℓ ^ 0)) := by
      change Subsingleton (ZMod 1)
      infer_instance
    exact Subsingleton.elim _ _
  · have hQP_s : ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
        ∃ Q : Ideal (B s), Q.IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B s)) Q = Ideal.span {P} ∧
          ∃ σ_P : B s ≃ₐ[R₀] B s,
            (∀ b : B s, σ_P.symm b - b ^ (Nat.card F ^ d) ∈ Q) ∧
            (τ_rep s σ_P).val = (A_mat d P hP).map (PadicInt.toZModPow (s + 1)) :=
      fun d P hP => hQP d P hP s
    obtain ⟨hFin_Γ, hOrbitSum⟩ :=
      weil_curve_tr_closed_point_orbit_fixed_sum F S_aff ℓ N s r hN hr
        (B s) (L_fld s) (τ_rep s) A_mat hQP_s e
    let _ : Fintype (B s ≃ₐ[R₀] B s) := Fintype.ofFinite (B s ≃ₐ[R₀] B s)
    set g := Fintype.card (B s ≃ₐ[R₀] B s)
    have hg_pos : 1 ≤ g := Fintype.card_pos_iff.mpr ⟨1⟩
    obtain ⟨v, u_ord, hg_eq, hndvd_u⟩ := hFactor g hg_pos
    set K' := (s + 1) + v
    have hsK' : s + 1 ≤ K' := Nat.le_add_right (s + 1) v
    obtain ⟨𝒦_s, τ_𝒦s, B₂, b_V, M_lat_V, hGeomExt, hModels⟩ := hLevel s
    set B_max := max B₁ B₂
    set K := K' + 12 * B_max
    have hK'K : K' ≤ K := Nat.le_add_right K' (12 * B_max)
    have hs1B₁ : (s + 1) + 12 * B₁ ≤ K := by
      have hB₁ : 12 * B₁ ≤ 12 * B_max := Nat.mul_le_mul_left 12 (le_max_left B₁ B₂)
      exact Nat.add_le_add hsK' hB₁
    have hK'B₂ : K' + 12 * B₂ ≤ K := by
      have hB₂ : 12 * B₂ ≤ 12 * B_max := Nat.mul_le_mul_left 12 (le_max_right B₁ B₂)
      exact Nat.add_le_add_left hB₂ K'
    obtain ⟨F_K, M_K, hLat_FK, hFinH_MK, hFlat_MK, hBridge_MK, hLat_MK⟩ :=
      hModels K (hsK'.trans hK'K)
    obtain ⟨P_σ, T_cohom, hLat_Pσ, hCast_Tcohom, hSum_cohom⟩ :=
      weil_curve_tr_group_ring_trace_bridge (B s ≃ₐ[R₀] B s) ℓ N s K' K B₂
        hN hsK' hK'K (τ_rep s) F_K M_K b_V M_lat_V
        hFinH_MK hFlat_MK hBridge_MK hLat_MK
    have hFK_rhs :
        ZMod.castHom (pow_dvd_pow ℓ (hsK'.trans hK'K)) (ZMod (ℓ ^ (s + 1)))
          (weilCurveTrAltTrace F_K) =
        PadicInt.toZModPow (s + 1) RHS_int :=
      weil_curve_tr_pir_complex_trace_congruence ℓ K (s + 1) B₁ hs1B₁ F_K b_J M_lat_J hLat_FK
    have hTcohom_rhs :
        ZMod.castHom (pow_dvd_pow ℓ hsK') (ZMod (ℓ ^ (s + 1))) T_cohom =
        PadicInt.toZModPow (s + 1) RHS_int :=
      hCast_Tcohom.trans hFK_rhs
    have hPσ_card : ∀ σ : B s ≃ₐ[R₀] B s,
        ZMod.castHom (pow_dvd_pow ℓ hK'K) (ZMod (ℓ ^ K')) (weilCurveTrAltTrace (P_σ σ)) =
        (Nat.card { y : ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F (B s))) //
          IsClosed ({y} : Set ↥(weilGeomScheme F (weilCurveTrGeomCoverOver F (B s)))) ∧
          (CategoryTheory.CategoryStruct.comp
            (weilSchemeEndPow (weilGeomFrobHom F (weilCurveTrGeomCoverOver F (B s))) r)
            (weilCurveTrGeomDeckHom F R₀ (B s) σ⁻¹)).base y = y } : ZMod (ℓ ^ K')) := by
      intro σ
      have h1 := weil_curve_tr_pir_complex_trace_congruence ℓ K K' B₂ hK'B₂
        (P_σ σ) (b_V σ) (M_lat_V σ) (hLat_Pσ σ)
      have h2 := weil_curve_tr_open_curve_twisted_frob_trace F S_aff
        j_aff hj_open hj_hom s_inf hsinf_sec hsinf_compl U₀ hU₀_eq
        ℓ hℓ (B s) (L_fld s) e_U heU_eq r B₂ hr
        𝒦_s τ_𝒦s b_V M_lat_V hGeomExt σ
      rw [h1, h2, map_natCast]
    let T_pts : ZMod (ℓ ^ K') :=
      ∑ d ∈ Nat.divisors r,
        ∑ j : Fin (Nat.card (Good d)),
          (d : ZMod (ℓ ^ K')) *
            ((PadicInt.toZModPow (s + 1)
              (Matrix.trace ((A_mat d (e d j).1 (e d j).2) ^ (r / d)))).val : ZMod (ℓ ^ K'))
    have hEq_mul : (g : ZMod (ℓ ^ K')) * T_pts = (g : ZMod (ℓ ^ K')) * T_cohom := by
      rw [← hOrbitSum K' hsK', ← hSum_cohom]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [hPσ_card σ]
    have _ : NeZero (ℓ ^ K') := ⟨pow_ne_zero K' hPrime_ℓ.ne_zero⟩
    have _ : NeZero (ℓ ^ (s + 1)) := ⟨pow_ne_zero (s + 1) hPrime_ℓ.ne_zero⟩
    let D : ZMod (ℓ ^ K') := T_pts - T_cohom
    let w : ℕ := D.val
    have hMulD : (g : ZMod (ℓ ^ K')) * D = 0 := by
      dsimp [D]
      rw [mul_sub, hEq_mul, sub_self]
    have hNatZero : ((g * w : ℕ) : ZMod (ℓ ^ K')) = 0 := by
      dsimp [w]
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, hMulD]
    have hDvd_K' : ℓ ^ K' ∣ g * w :=
      (ZMod.natCast_eq_zero_iff (g * w) (ℓ ^ K')).mp hNatZero
    have hDvd_s1 : ℓ ^ (s + 1) ∣ w := by
      have hpow_eq : ℓ ^ K' = ℓ ^ v * ℓ ^ (s + 1) := by
        dsimp [K']
        rw [pow_add, mul_comm]
      rw [hpow_eq, hg_eq, mul_assoc] at hDvd_K'
      have hpos_v : 0 < ℓ ^ v := pow_pos hPrime_ℓ.pos v
      have hDvd_u : ℓ ^ (s + 1) ∣ u_ord * w :=
        (Nat.mul_dvd_mul_iff_left hpos_v).mp hDvd_K'
      have hCop : Nat.Coprime (ℓ ^ (s + 1)) u_ord :=
        (hPrime_ℓ.coprime_iff_not_dvd.mpr hndvd_u).pow_left (s + 1)
      exact hCop.dvd_of_dvd_mul_left hDvd_u
    let cast_s1 := ZMod.castHom (pow_dvd_pow ℓ hsK') (ZMod (ℓ ^ (s + 1)))
    have hCast_D : cast_s1 D = 0 := by
      have hD_eq : D = (w : ZMod (ℓ ^ K')) := (ZMod.natCast_zmod_val D).symm
      rw [hD_eq, map_natCast]
      exact (ZMod.natCast_eq_zero_iff w (ℓ ^ (s + 1))).mpr hDvd_s1
    have hCast_eq : cast_s1 T_pts = cast_s1 T_cohom :=
      sub_eq_zero.mp (by rwa [← map_sub])
    have hTpts_lhs : cast_s1 T_pts = PadicInt.toZModPow (s + 1) LHS_int := by
      rw [hLHS_def]
      dsimp [T_pts]
      simp only [map_sum, map_mul, map_natCast]
      refine Finset.sum_congr rfl fun d _ => ?_
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [ZMod.natCast_zmod_val]
    exact hTpts_lhs.symm.trans (hCast_eq.trans hTcohom_rhs)

theorem weil_transv_affine_curve_tower_duality_and_trace (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ M n : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) (hM : 1 ≤ M)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (hJ_skew : J.transpose = -J) (hJ_det : J.det ≠ 0)
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (hG_sp : ∀ g ∈ G_geom,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J)
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (hFu_norm : ∀ g ∈ G_geom, F_u * g * F_u⁻¹ ∈ G_geom)
    (hFu_sim : ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
      ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = ((Nat.card F : Padic ℓ) ^ n) • J)
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (hF_sim : ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((F_mat d P hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
          ((Nat.card F : Padic ℓ) ^ (n * d)) • J)
    (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r))
    (hTower : WeilTransvTriCurveSymplecticTower.{u} F S_aff j_aff U₀ u₀ ℓ M G_geom F_u F_mat ℒ₀ τ_ℒ)
    (W_mid : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
      (fun r => weilEtaleHigherDirectImage U₀.ι 0 (ℒ₀ r))
      (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℒ r)))
    (γ' : AlgebraicClosure (Padic ℓ))
    (hγ'_ne : γ' ≠ 0)
    (hγ'_mid : γ' ∈ ((W_mid.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    (∃ (V₁ : Type u) (_ : AddCommGroup V₁) (_ : Module (Padic ℓ) V₁)
        (_ : Module.Finite (Padic ℓ) V₁) (Φ₁ : V₁ →ₗ[Padic ℓ] V₁),
      γ' ∈ (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ((Nat.card F : AlgebraicClosure (Padic ℓ)) ^ (n + 1)) / γ' ∈
        (Φ₁.charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
      ∀ (r : ℕ) (e : ∀ d : ℕ,
          Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
            { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
        1 ≤ r →
          (WeilSymplecticLinInvDual ℓ M G_geom = ⊥ →
            ∑ d ∈ Nat.divisors r,
              ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
                (d : Padic ℓ) *
                  Matrix.trace (((F_mat d (e d j).1 (e d j).2).map
                    (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d)) =
              - LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r))) ∧
    (∀ k : ℕ, 1 ≤ k →
      ∃ (V₂ₖ : Type u) (_ : AddCommGroup V₂ₖ) (_ : Module (Padic ℓ) V₂ₖ)
          (_ : Module.Finite (Padic ℓ) V₂ₖ) (Φ₂ₖ : V₂ₖ →ₗ[Padic ℓ] V₂ₖ),
        ∀ (r : ℕ) (e : ∀ d : ℕ,
            Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }) ≃
              { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
          1 ≤ r →
            ((∀ φ ∈ WeilSymplecticTensorInvDual ℓ M k G_geom,
                φ.comp (PiTensorProduct.map (fun _ : Fin (2 * k) =>
                  ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin)) =
                  ((Nat.card F : Padic ℓ) ^ (k * n)) • φ) →
              ∑ d ∈ Nat.divisors r,
                ∑ j : Fin (Nat.card { P : Polynomial F // IsGoodAffineCurveClosedPointPoly S_aff d P }),
                  (d : Padic ℓ) *
                    (Matrix.trace (((F_mat d (e d j).1 (e d j).2).map
                      (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ (r / d))) ^ (2 * k) =
                (Module.finrank (Padic ℓ) ↥(WeilSymplecticTensorInvDual ℓ M k G_geom) : Padic ℓ) *
                  ((Nat.card F : Padic ℓ) ^ (k * n + 1)) ^ r -
                  LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r))) :=
by
  classical
  let K := Padic ℓ
  let L := AlgebraicClosure (Padic ℓ)
  have hIic2 : (Finset.Iic 2 : Finset ℕ) = {0, 1, 2} := by decide
  have hTraceSub : ∀ (U : Type u) [AddCommGroup U] [Module K U] [Module.Finite K U]
      [Subsingleton U] (T : U →ₗ[K] U), LinearMap.trace K U T = 0 := by
    intro U _ _ _ _ T
    have hT0 : T = 0 := LinearMap.ext fun _ => Subsingleton.elim _ _
    rw [hT0, map_zero]
  have hTower_keep := hTower
  obtain ⟨a₀, ha₀, B_tow, L_fld, hCR, hDom, hFld,
    hAF_B, hAP_B, hAR_B, hAF_L, hAP_L, hARF_L, hABL, hARL,
    hST1, hST2, hST3, hST4, hST5, hST6,
    hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L,
    ρ, ι_B, e_U, hu₀_eq, heU_eq, _hInj_ρ,
    hSurjG, hImG, hCompat_B, hQu, hQP, hTriv⟩ := hTower
  refine ⟨?_, ?_⟩
  · 
    have hSh₁ : WeilCurveRepSheafTower.{u} F S_aff j_aff U₀ u₀ ℓ M G_geom F_u F_mat ℒ₀ τ_ℒ :=
      ⟨a₀, ha₀, B_tow, L_fld, hCR, hDom, hFld,
        hAF_B, hAP_B, hAR_B, hAF_L, hAP_L, hARF_L, hABL, hARL,
        hST1, hST2, hST3, hST4, hST5, hST6,
        hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L,
        ρ, ι_B, e_U, hu₀_eq, heU_eq,
        hSurjG, hImG, hCompat_B, hQu, hQP, hTriv⟩
    obtain ⟨𝒥₁, τ_𝒥₁, M_c₁, hZExt₁, hSub₀₁, hSurjDir₁⟩ :=
      weil_curve_tower_zero_ext_models_and_dir_surj F S_aff j_aff hj_open hj_hom
        s_inf hsinf_sec hsinf_compl U₀ hU₀_eq u₀ hu₀_sec hu₀_mem
        ℓ M hℓ hM G_geom F_u F_mat ℒ₀ τ_ℒ hSh₁
    obtain ⟨π_mid, hπ_surj, hπ_inter⟩ := hSurjDir₁ W_mid
    obtain ⟨B_mid, hB_mid, hEq_mid⟩ :=
      weil_curve_tower_mid_ext_symplectic_self_duality F S_aff j_aff hj_open hj_hom
        s_inf hsinf_sec hsinf_compl U₀ hU₀_eq u₀ hu₀_sec hu₀_mem
        ℓ M n hℓ hM J hJ_skew hJ_det G_geom hG_sp F_u hFu_norm hFu_sim
        F_mat ℒ₀ τ_ℒ hTower_keep W_mid
    set V₁ := (M_c₁ 1).V
    set Φ₁ := (M_c₁ 1).frob
    set W := W_mid.V
    set Ψ := W_mid.frob
    set c_mid : K := (Nat.card F : K) ^ (n + 1)
    let bW := Module.Free.chooseBasis K W
    let bV := Module.Free.chooseBasis K V₁
    let _ : Module.Finite K (Module.Dual K W) := Module.Finite.of_basis bW.dualBasis
    let _ : Module.Finite K (Module.Dual K V₁) := Module.Finite.of_basis bV.dualBasis
    have hchar_dual_W : (Ψ.dualMap).charpoly = Ψ.charpoly := by
      have hd : Ψ.dualMap = Module.Dual.transpose Ψ := rfl
      rw [hd, ← LinearMap.charpoly_toMatrix Ψ bW,
        ← LinearMap.charpoly_toMatrix (Module.Dual.transpose Ψ) bW.dualBasis,
        LinearMap.toMatrix_transpose, Matrix.charpoly_transpose]
    have hchar_dual_V : (Φ₁.dualMap).charpoly = Φ₁.charpoly := by
      have hd : Φ₁.dualMap = Module.Dual.transpose Φ₁ := rfl
      rw [hd, ← LinearMap.charpoly_toMatrix Φ₁ bV,
        ← LinearMap.charpoly_toMatrix (Module.Dual.transpose Φ₁) bV.dualBasis,
        LinearMap.toMatrix_transpose, Matrix.charpoly_transpose]
    have hπ_dual_inj : Function.Injective π_mid.dualMap := by
      intro φ₁ φ₂ hφ
      ext w
      obtain ⟨v, rfl⟩ := hπ_surj w
      exact LinearMap.congr_fun hφ v
    have hπ_dual_inter : π_mid.dualMap ∘ₗ Ψ.dualMap = Φ₁.dualMap ∘ₗ π_mid.dualMap := by
      ext φ v
      exact congrArg φ (hπ_inter v).symm
    have hToV₁ : ∀ μ : L, μ ∈ (Ψ.charpoly).aroots L → μ ∈ (Φ₁.charpoly).aroots L := by
      intro μ hμ
      rw [← hchar_dual_W] at hμ
      rw [← hchar_dual_V]
      obtain ⟨g_inv, hg_inv⟩ :=
        LinearMap.exists_leftInverse_of_injective π_mid.dualMap
          (LinearMap.ker_eq_bot.mpr hπ_dual_inj)
      let T₁_L : Module.End L (TensorProduct K L (Module.Dual K W)) :=
        LinearMap.baseChange L Ψ.dualMap
      let T₂_L : Module.End L (TensorProduct K L (Module.Dual K V₁)) :=
        LinearMap.baseChange L Φ₁.dualMap
      let f_L := LinearMap.baseChange L π_mid.dualMap
      let g_L := LinearMap.baseChange L g_inv
      have hg_L : g_L ∘ₗ f_L = LinearMap.id := by
        rw [← LinearMap.baseChange_comp, hg_inv, LinearMap.baseChange_id]
      have hf_L : Function.Injective f_L := by
        intro x y hxy
        have hgx := congrArg g_L hxy
        simpa only [← LinearMap.comp_apply, hg_L, LinearMap.id_apply] using hgx
      have hcomm_L : f_L ∘ₗ T₁_L = T₂_L ∘ₗ f_L := by
        rw [← LinearMap.baseChange_comp, hπ_dual_inter, LinearMap.baseChange_comp]
      have hμ_roots : μ ∈ (T₁_L.charpoly).roots := by
        rwa [LinearMap.charpoly_baseChange, ← Polynomial.aroots_def]
      have hμ_isRoot : (T₁_L.charpoly).IsRoot μ :=
        (Polynomial.mem_roots (LinearMap.charpoly_monic T₁_L).ne_zero).mp hμ_roots
      have hμ_eigen : T₁_L.HasEigenvalue μ :=
        (Module.End.hasEigenvalue_iff_isRoot_charpoly T₁_L μ).mpr hμ_isRoot
      obtain ⟨v, hv⟩ := hμ_eigen.exists_hasEigenvector
      have hw_ne : f_L v ≠ 0 := fun h0 => hv.2 (hf_L (h0.trans (map_zero f_L).symm))
      have hw_eq : T₂_L (f_L v) = μ • (f_L v) := by
        calc T₂_L (f_L v) = (T₂_L ∘ₗ f_L) v := rfl
          _ = (f_L ∘ₗ T₁_L) v := by rw [← hcomm_L]
          _ = f_L (T₁_L v) := rfl
          _ = f_L (μ • v) := by rw [Module.End.mem_eigenspace_iff.mp hv.1]
          _ = μ • f_L v := map_smul f_L μ v
      have hw_eigenvec : T₂_L.HasEigenvector μ (f_L v) :=
        ⟨Module.End.mem_eigenspace_iff.mpr hw_eq, hw_ne⟩
      have hw_isRoot : (T₂_L.charpoly).IsRoot μ :=
        (Module.End.hasEigenvalue_iff_isRoot_charpoly T₂_L μ).mp
          (Module.End.hasEigenvalue_of_hasEigenvector hw_eigenvec)
      have hw_roots : μ ∈ (T₂_L.charpoly).roots :=
        (Polynomial.mem_roots (LinearMap.charpoly_monic T₂_L).ne_zero).mpr hw_isRoot
      rwa [Polynomial.aroots_def, ← LinearMap.charpoly_baseChange]
    have hRecip_W : ((Nat.card F : L) ^ (n + 1)) / γ' ∈ (Ψ.charpoly).aroots L := by
      have hc_cast : algebraMap K L c_mid = (Nat.card F : L) ^ (n + 1) := by
        dsimp [c_mid]
        rw [map_pow, map_natCast]
      rw [← hc_cast, ← hchar_dual_W]
      let e_B : W ≃ₗ[K] Module.Dual K W := LinearEquiv.ofBijective B_mid hB_mid
      have hB_op : Ψ.dualMap ∘ₗ e_B.toLinearMap ∘ₗ Ψ = c_mid • e_B.toLinearMap := by
        ext x y
        exact hEq_mid x y
      let Ψ_L : Module.End L (TensorProduct K L W) := LinearMap.baseChange L Ψ
      let Ψd_L : Module.End L (TensorProduct K L (Module.Dual K W)) :=
        LinearMap.baseChange L Ψ.dualMap
      let E_L := LinearMap.baseChange L e_B.toLinearMap
      let Einv_L := LinearMap.baseChange L e_B.symm.toLinearMap
      have hE_left : Einv_L ∘ₗ E_L = LinearMap.id := by
        rw [← LinearMap.baseChange_comp]
        have hid : e_B.symm.toLinearMap ∘ₗ e_B.toLinearMap = LinearMap.id := by
          ext x; exact e_B.symm_apply_apply x
        rw [hid, LinearMap.baseChange_id]
      have hE_inj : Function.Injective E_L := by
        intro x y hxy
        have h := congrArg Einv_L hxy
        simpa only [← LinearMap.comp_apply, hE_left, LinearMap.id_apply] using h
      have hOp_L : Ψd_L ∘ₗ (E_L ∘ₗ Ψ_L) = (algebraMap K L c_mid) • E_L := by
        rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp, hB_op,
          LinearMap.baseChange_smul, ← algebraMap_smul L c_mid E_L]
      have hγ_roots : γ' ∈ (Ψ_L.charpoly).roots := by
        rwa [LinearMap.charpoly_baseChange, ← Polynomial.aroots_def]
      have hγ_eigen : Ψ_L.HasEigenvalue γ' :=
        (Module.End.hasEigenvalue_iff_isRoot_charpoly Ψ_L γ').mpr
          ((Polynomial.mem_roots (LinearMap.charpoly_monic Ψ_L).ne_zero).mp hγ_roots)
      obtain ⟨v, hv⟩ := hγ_eigen.exists_hasEigenvector
      let w := E_L v
      have hw_ne : w ≠ 0 := fun h0 => hv.2 (hE_inj (h0.trans (map_zero E_L).symm))
      have hγ_w : γ' • Ψd_L w = (algebraMap K L c_mid) • w := by
        calc γ' • Ψd_L w = Ψd_L (γ' • E_L v) := (map_smul Ψd_L γ' (E_L v)).symm
          _ = Ψd_L (E_L (γ' • v)) := by rw [← map_smul E_L γ' v]
          _ = Ψd_L (E_L (Ψ_L v)) := by rw [← Module.End.mem_eigenspace_iff.mp hv.1]
          _ = (Ψd_L ∘ₗ (E_L ∘ₗ Ψ_L)) v := rfl
          _ = ((algebraMap K L c_mid) • E_L) v := by rw [hOp_L]
          _ = (algebraMap K L c_mid) • w := rfl
      have hw_eq : Ψd_L w = (algebraMap K L c_mid / γ') • w := by
        calc Ψd_L w = (γ'⁻¹ * γ') • Ψd_L w := by rw [inv_mul_cancel₀ hγ'_ne, one_smul]
          _ = γ'⁻¹ • (γ' • Ψd_L w) := mul_smul γ'⁻¹ γ' (Ψd_L w)
          _ = γ'⁻¹ • ((algebraMap K L c_mid) • w) := by rw [hγ_w]
          _ = (γ'⁻¹ * algebraMap K L c_mid) • w := (mul_smul γ'⁻¹ (algebraMap K L c_mid) w).symm
          _ = (algebraMap K L c_mid / γ') • w := by rw [div_eq_mul_inv, mul_comm]
      have hw_eigenvec : Ψd_L.HasEigenvector (algebraMap K L c_mid / γ') w :=
        ⟨Module.End.mem_eigenspace_iff.mpr hw_eq, hw_ne⟩
      have hw_isRoot : (Ψd_L.charpoly).IsRoot (algebraMap K L c_mid / γ') :=
        (Module.End.hasEigenvalue_iff_isRoot_charpoly Ψd_L _).mp
          (Module.End.hasEigenvalue_of_hasEigenvector hw_eigenvec)
      have hw_roots : (algebraMap K L c_mid / γ') ∈ (Ψd_L.charpoly).roots :=
        (Polynomial.mem_roots (LinearMap.charpoly_monic Ψd_L).ne_zero).mpr hw_isRoot
      rwa [Polynomial.aroots_def, ← LinearMap.charpoly_baseChange]
    refine ⟨V₁, inferInstance, inferInstance, inferInstance, Φ₁,
      hToV₁ γ' hγ'_mid, hToV₁ _ hRecip_W, fun r e hr hLinBot => ?_⟩
    obtain ⟨B_coinv₁, hB_coinv₁, _⟩ :=
      weil_curve_tower_deg_two_coinvariant_duality F S_aff j_aff hj_open hj_hom
        s_inf hsinf_sec hsinf_compl U₀ hU₀_eq u₀ hu₀_sec hu₀_mem
        ℓ M hℓ hM G_geom F_u hFu_norm F_mat 𝒥₁ τ_𝒥₁ hZExt₁ (M_c₁ 2)
    have hSubInv₁ : Subsingleton ↥(WeilSymplecticLinInvDual ℓ M G_geom) := by
      refine ⟨fun x y => Subtype.ext ?_⟩
      have hx : x.1 ∈ (⊥ : Submodule K ((Fin M → K) →ₗ[K] K)) := hLinBot ▸ x.2
      have hy : y.1 ∈ (⊥ : Submodule K ((Fin M → K) →ₗ[K] K)) := hLinBot ▸ y.2
      rw [Submodule.mem_bot] at hx hy
      exact hx.trans hy.symm
    have hSubDual₂ : Subsingleton (Module.Dual K (M_c₁ 2).V) :=
      (LinearEquiv.ofBijective B_coinv₁ hB_coinv₁).symm.subsingleton
    have hSub₂₁ : Subsingleton (M_c₁ 2).V := by
      let b2 := Module.Free.chooseBasis K (M_c₁ 2).V
      refine ⟨fun x y => ?_⟩
      apply b2.ext_elem
      intro i
      have hc0 : b2.coord i = 0 := Subsingleton.elim _ _
      change b2.coord i x = b2.coord i y
      rw [hc0]
      rfl
    have hTr_eq := weil_curve_tower_lefschetz_trace_formula F S_aff j_aff hj_open hj_hom
      s_inf hsinf_sec hsinf_compl U₀ hU₀_eq u₀ hu₀_sec hu₀_mem
      ℓ M hℓ hM G_geom F_u F_mat 𝒥₁ τ_𝒥₁ hZExt₁ M_c₁ r e hr
    rw [hTr_eq, hIic2, Finset.sum_insert (by decide), Finset.sum_insert (by decide),
      Finset.sum_singleton]
    have htr0 : LinearMap.trace K (M_c₁ 0).V ((M_c₁ 0).frob ^ r) = 0 :=
      @hTraceSub (M_c₁ 0).V _ _ _ hSub₀₁ _
    have htr2 : LinearMap.trace K (M_c₁ 2).V ((M_c₁ 2).frob ^ r) = 0 :=
      @hTraceSub (M_c₁ 2).V _ _ _ hSub₂₁ _
    rw [htr0, htr2]
    change (-1 : K) ^ 0 * 0 + ((-1 : K) ^ 1 * LinearMap.trace K V₁ (Φ₁ ^ r) + (-1 : K) ^ 2 * 0) =
      - LinearMap.trace K V₁ (Φ₁ ^ r)
    ring
  · 
    intro k hk
    set N_k : ℕ := M ^ (2 * k)
    have hNk : 1 ≤ N_k := Nat.one_le_pow (2 * k) M hM
    let e_idx : Fin N_k ≃ (Fin (2 * k) → Fin M) :=
      ((Fintype.equivFin (Fin (2 * k) → Fin M)).trans
        (finCongr (by simp [Fintype.card_fin]; rfl))).symm
    let kronHom : ∀ (R : Type) [CommRing R],
        Matrix (Fin M) (Fin M) R →* Matrix (Fin N_k) (Fin N_k) R :=
      fun R _ =>
        { toFun := fun A => Matrix.of fun p q => ∏ t : Fin (2 * k), A (e_idx p t) (e_idx q t)
          map_one' := by
            ext p q
            simp only [Matrix.of_apply]
            by_cases hpq : p = q
            · subst hpq
              simp
            · obtain ⟨t₀, ht₀⟩ := Function.ne_iff.mp (e_idx.injective.ne hpq)
              rw [Matrix.one_apply_ne hpq]
              exact Finset.prod_eq_zero (Finset.mem_univ t₀) (Matrix.one_apply_ne ht₀)
          map_mul' := by
            intro A B
            ext p q
            simp only [Matrix.of_apply, Matrix.mul_apply]
            calc ∏ t : Fin (2 * k), ∑ i : Fin M, A (e_idx p t) i * B i (e_idx q t)
