    · 
      exact (e_S0 m).injective.comp ((hinj_ρ (hSub_J0 m)).comp (r_comp m 0).symm.injective)
    · 
      ext u
      simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨v, rfl⟩
        change (e_K m 1).symm (δ_ext m ((e_S0 m).symm (e_S0 m (ρ_H m ((r_comp m 0).symm v))))) = 0
