      have hCov : ∀ k : ℕ, 1 ≤ k → WeilGaloisModEllPowCover.{u} F S_aff ℓ M k G_geom F_mat := by
        intro k hk
        obtain ⟨r, rfl⟩ : ∃ r : ℕ, k = r + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
        obtain ⟨_, _, B, L_fld, hCR, hDom, hFld, hAF_B, hAP_B, hAR_B, hAF_L, hAP_L, hARF_L,
          hABL, hARL, hST1, hST2, hST3, hST4, hST5, hST6, hFin_B, hEt_B, hFrac, hIntCl,
          hFD_L, hGal_L, ρ, _, _, _, _, _, hSurjG, _, _, _, hGoodFrob, _⟩ := hTower
        refine ⟨B r, L_fld r, hCR r, hDom r, hFld r, hAF_B r, hAP_B r, hAR_B r,
