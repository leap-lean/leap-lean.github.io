          (((pr_S m (π_bdry t)).hom.app (Opposite.op (G_α.obj T_Y))).hom z) :=
        congrArg (fun k : P_α.obj (𝒮_Y m) ⟶ (P_z t).obj L_pt =>
          (k.hom.app (Opposite.op T_Y)).hom z) (hβS_pr m t)
      have hstep2 : ((pr_S m (π_bdry t)).hom.app (Opposite.op (G_α.obj T_Y))).hom z =
          ((((P_z (π_bdry t)).obj L_pt).obj.map (Opposite.op μ_Y)).hom
            (((in_S m s ≫ pr_S m (π_bdry t)).hom.app (Opposite.op T_Y)).hom sec_s)) :=
        congrArg (fun φ => φ.hom (((in_S m s).hom.app (Opposite.op T_Y)).hom sec_s))
          ((pr_S m (π_bdry t)).hom.naturality (Opposite.op μ_Y))
      exact hstep1.trans (congrArg (((γ m t).hom.app (Opposite.op T_Y)).hom) hstep2)
    refine ⟨fun t a => ?_, fun t s hs sec_s => ?_⟩
    · let sec_π := ((L_pt.obj.map
          (Opposite.op (hT_pt.from ((weilEtaleSitePullback (z_bdry (π_bdry t))).obj T_Y)))).hom
        ((adj_pt.unit.app AM).hom (ULift.up a)))
      have hid : (((in_S m (π_bdry t) ≫ pr_S m (π_bdry t)).hom.app (Opposite.op T_Y)).hom sec_π) =
          sec_π :=
        congrArg (fun k : (P_z (π_bdry t)).obj L_pt ⟶ (P_z (π_bdry t)).obj L_pt =>
          (k.hom.app (Opposite.op T_Y)).hom sec_π) (hC6 m (π_bdry t))
      exact (hev_gen t (π_bdry t) sec_π).trans
        ((congrArg (fun w => ((γ m t).hom.app (Opposite.op T_Y)).hom
          ((((P_z (π_bdry t)).obj L_pt).obj.map (Opposite.op μ_Y)).hom w)) hid).trans
          (hγ_ev m t a))
    · have hzero : (((in_S m s ≫ pr_S m (π_bdry t)).hom.app (Opposite.op T_Y)).hom sec_s) = 0 :=
        congrArg (fun k : (P_z s).obj L_pt ⟶ (P_z (π_bdry t)).obj L_pt =>
          (k.hom.app (Opposite.op T_Y)).hom sec_s) (hC7 m s (π_bdry t) hs)
      refine (hev_gen t s sec_s).trans ?_
      have hmap0 : ((((P_z (π_bdry t)).obj L_pt).obj.map (Opposite.op μ_Y)).hom
          (((in_S m s ≫ pr_S m (π_bdry t)).hom.app (Opposite.op T_Y)).hom sec_s)) = 0 :=
        (congrArg ((((P_z (π_bdry t)).obj L_pt).obj.map (Opposite.op μ_Y)).hom) hzero).trans
          (map_zero _)
      exact (congrArg (((γ m t).hom.app (Opposite.op T_Y)).hom) hmap0).trans (map_zero _)

theorem weil_etale_clopen_cover_torsion_cohomology_bijective (m_c n q : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u})
    (Y_comp : Fin m_c → AlgebraicGeometry.Scheme.{u})
    (inc_comp : ∀ ι : Fin m_c, Quiver.Hom (Y_comp ι) Y)
    (hOpen : ∀ ι : Fin m_c, AlgebraicGeometry.IsOpenImmersion (inc_comp ι))
    (hClosed : ∀ ι : Fin m_c, AlgebraicGeometry.IsClosedImmersion (inc_comp ι))
    (hDisj : ∀ ι₁ ι₂ : Fin m_c, ι₁ ≠ ι₂ →
      Disjoint (Set.range (inc_comp ι₁).base) (Set.range (inc_comp ι₂).base))
    (hUniv : (⋃ ι : Fin m_c, Set.range (inc_comp ι).base) = Set.univ)
    (hEpi : ∀ ι : Fin m_c, WeilEtalePushforwardPreservesEpi (inc_comp ι))
    (p_inc : ∀ ι : Fin m_c, weilEtaleTorsionH Y n q →+ weilEtaleTorsionH (Y_comp ι) n q)
    (hp_inc : ∀ ι : Fin m_c, WeilLefschetzTorsionPullback (inc_comp ι) n q (p_inc ι)) :
    Function.Bijective (fun (x : weilEtaleTorsionH Y n q) (ι : Fin m_c) => p_inc ι x) :=
by
  classical
  let _ := hEpi
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y
  let Fgt_comp := fun ι : Fin m_c => AlgebraicGeometry.Scheme.Etale.forget (Y_comp ι)
  let B_comp : ∀ ι : Fin m_c, CategoryTheory.Functor Y.Etale (Y_comp ι).Etale :=
    fun ι => weilEtaleSitePullback (inc_comp ι)
  let J_Y := Y.smallEtaleTopology
  let J_comp := fun ι : Fin m_c => (Y_comp ι).smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let C_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
  let C_comp := fun ι : Fin m_c => CategoryTheory.constantSheaf (J_comp ι) AddCommGrpCat.{u}

  
  let fst_E : ∀ (E : Y.Etale) (ι : Fin m_c),
      ((Fgt_comp ι).obj ((B_comp ι).obj E)).left ⟶ (Fgt_Y.obj E).left :=
    fun E ι => CategoryTheory.Limits.pullback.fst (Fgt_Y.obj E).hom (inc_comp ι)
  let snd_E : ∀ (E : Y.Etale) (ι : Fin m_c),
      ((Fgt_comp ι).obj ((B_comp ι).obj E)).left ⟶ Y_comp ι :=
    fun E ι => CategoryTheory.Limits.pullback.snd (Fgt_Y.obj E).hom (inc_comp ι)

  have hOpen_fst : ∀ (E : Y.Etale) (ι : Fin m_c),
      AlgebraicGeometry.IsOpenImmersion (fst_E E ι) := fun E ι =>
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback (Fgt_Y.obj E).hom (inc_comp ι)).flip (hOpen ι)

  have hClosed_fst : ∀ (E : Y.Etale) (ι : Fin m_c),
      AlgebraicGeometry.IsClosedImmersion (fst_E E ι) := fun E ι =>
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback (Fgt_Y.obj E).hom (inc_comp ι)).flip (hClosed ι)

  have hInj_fst : ∀ (E : Y.Etale) (ι : Fin m_c),
      Function.Injective (fst_E E ι).base := fun E ι => by
    have := hOpen_fst E ι
    exact (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding (fst_E E ι)).toIsEmbedding.injective

  have hOpenMap_fst : ∀ (E : Y.Etale) (ι : Fin m_c),
      IsOpenMap (fst_E E ι).base := fun E ι => by
    have := hOpen_fst E ι
    exact (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding (fst_E E ι)).isOpenMap

  have hOpenCompl_fst : ∀ (E : Y.Etale) (ι : Fin m_c),
      IsOpen (Set.range (fst_E E ι).base)ᶜ := fun E ι => by
    have := hClosed_fst E ι
    exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (fst_E E ι)).isClosed_range.isOpen_compl

  have hRange_fst : ∀ (E : Y.Etale) (ι : Fin m_c) (x : ↥(Fgt_Y.obj E).left),
      x ∈ Set.range (fst_E E ι).base ↔
        (Fgt_Y.obj E).hom.base x ∈ Set.range (inc_comp ι).base := by
    intro E ι x
    constructor
    · rintro ⟨z, rfl⟩
      exact ⟨(snd_E E ι).base z,
        congrArg (fun k => k.base z)
          (CategoryTheory.Limits.pullback.condition (f := (Fgt_Y.obj E).hom)
            (g := inc_comp ι)).symm⟩
    · rintro ⟨y, hy⟩
      obtain ⟨z, hz_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x y hy.symm
      exact ⟨z, hz_fst⟩

  let res_loc : ∀ (E : Y.Etale) (ι : Fin m_c),
      LocallyConstant ↥(Fgt_Y.obj E).left ↥AM →+
        LocallyConstant ↥((Fgt_comp ι).obj ((B_comp ι).obj E)).left ↥AM :=
    fun E ι =>
      { toFun := fun f => f.comap (fst_E E ι).base.hom
        map_zero' := LocallyConstant.ext fun _ => rfl
        map_add' := fun _ _ => LocallyConstant.ext fun _ => rfl }

  let ext_raw : ∀ (E : Y.Etale) (ι : Fin m_c),
      LocallyConstant ↥((Fgt_comp ι).obj ((B_comp ι).obj E)).left ↥AM →
        ↥(Fgt_Y.obj E).left → ↥AM :=
    fun E ι g x =>
      if hx : x ∈ Set.range (fst_E E ι).base then g (Classical.choose hx) else 0

  have hext_apply_fst : ∀ (E : Y.Etale) (ι : Fin m_c)
      (g : LocallyConstant ↥((Fgt_comp ι).obj ((B_comp ι).obj E)).left ↥AM)
      (z : ↥((Fgt_comp ι).obj ((B_comp ι).obj E)).left),
      ext_raw E ι g ((fst_E E ι).base z) = g z := by
    intro E ι g z
    have hx : (fst_E E ι).base z ∈ Set.range (fst_E E ι).base := ⟨z, rfl⟩
    dsimp [ext_raw]
    simp only [hx, ↓reduceDIte]
    exact congrArg g (hInj_fst E ι (Classical.choose_spec hx))

  have hext_isLocConst : ∀ (E : Y.Etale) (ι : Fin m_c)
      (g : LocallyConstant ↥((Fgt_comp ι).obj ((B_comp ι).obj E)).left ↥AM),
      IsLocallyConstant (ext_raw E ι g) := by
    intro E ι g
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro a
    by_cases ha : a = 0
    · subst ha
      have hfib0 : ext_raw E ι g ⁻¹' {0} =
          (fst_E E ι).base '' (g ⁻¹' {0}) ∪ (Set.range (fst_E E ι).base)ᶜ := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_union, Set.mem_image,
          Set.mem_compl_iff]
        by_cases hx : x ∈ Set.range (fst_E E ι).base
        · rcases hx with ⟨z, rfl⟩
          rw [hext_apply_fst]
          constructor
          · intro hgz
            exact Or.inl ⟨z, hgz, rfl⟩
          · rintro (⟨z', hgz', hzz'⟩ | hnot)
            · rw [← hInj_fst E ι hzz']
              exact hgz'
            · exact False.elim (hnot ⟨z, rfl⟩)
        · dsimp [ext_raw]
          simp [hx]
      rw [hfib0]
      exact (hOpenMap_fst E ι _ (g.isLocallyConstant {0})).union (hOpenCompl_fst E ι)
    · have hfib_ne : ext_raw E ι g ⁻¹' {a} = (fst_E E ι).base '' (g ⁻¹' {a}) := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_image]
        by_cases hx : x ∈ Set.range (fst_E E ι).base
        · rcases hx with ⟨z, rfl⟩
          rw [hext_apply_fst]
          constructor
          · intro hgz
            exact ⟨z, hgz, rfl⟩
          · rintro ⟨z', hgz', hzz'⟩
            rw [← hInj_fst E ι hzz']
            exact hgz'
        · dsimp [ext_raw]
          simp only [hx, ↓reduceDIte]
          exact ⟨fun h0a => False.elim (ha h0a.symm),
            fun ⟨z, _, hzx⟩ => False.elim (hx ⟨z, hzx⟩)⟩
      rw [hfib_ne]
      exact hOpenMap_fst E ι _ (g.isLocallyConstant {a})

  let ext_loc : ∀ (E : Y.Etale) (ι : Fin m_c),
      LocallyConstant ↥((Fgt_comp ι).obj ((B_comp ι).obj E)).left ↥AM →+
        LocallyConstant ↥(Fgt_Y.obj E).left ↥AM :=
    fun E ι =>
      { toFun := fun g => ⟨ext_raw E ι g, hext_isLocConst E ι g⟩
        map_zero' := by
          ext x
          change (if hx : x ∈ Set.range (fst_E E ι).base then (0 : ↥AM) else 0) = 0
          split_ifs <;> rfl
        map_add' := fun g₁ g₂ => by
          ext x
          change (if hx : x ∈ Set.range (fst_E E ι).base then
              g₁ (Classical.choose hx) + g₂ (Classical.choose hx) else 0) =
            (if hx : x ∈ Set.range (fst_E E ι).base then g₁ (Classical.choose hx) else 0) +
              (if hx : x ∈ Set.range (fst_E E ι).base then g₂ (Classical.choose hx) else 0)
          split_ifs
          · rfl
          · exact (add_zero 0).symm }

  have hres_const : ∀ (E : Y.Etale) (ι : Fin m_c) (a : ↥AM),
      res_loc E ι (LocallyConstant.const _ a) = LocallyConstant.const _ a :=
    fun _ _ _ => LocallyConstant.ext fun _ => rfl

  have hfst_map_comm : ∀ {E₁ E₂ : Y.Etale} (u : Quiver.Hom E₁ E₂) (ι : Fin m_c),
      ((Fgt_comp ι).map ((B_comp ι).map u)).left ≫ fst_E E₂ ι =
        fst_E E₁ ι ≫ (Fgt_Y.map u).left := by
    intro E₁ E₂ u ι
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hres_nat : ∀ {E₁ E₂ : Y.Etale} (u : Quiver.Hom E₁ E₂) (ι : Fin m_c)
      (f : LocallyConstant ↥(Fgt_Y.obj E₂).left ↥AM),
      (res_loc E₂ ι f).comap ((Fgt_comp ι).map ((B_comp ι).map u)).left.base.hom =
        res_loc E₁ ι (f.comap (Fgt_Y.map u).left.base.hom) := by
    intro E₁ E₂ u ι f
    ext z₁
    have hcomm_z : (fst_E E₂ ι).base (((Fgt_comp ι).map ((B_comp ι).map u)).left.base z₁) =
        (Fgt_Y.map u).left.base ((fst_E E₁ ι).base z₁) :=
      congrArg (fun k => k.base z₁) (hfst_map_comm u ι)
    exact congrArg f hcomm_z

  have hext_nat : ∀ {E₁ E₂ : Y.Etale} (u : Quiver.Hom E₁ E₂) (ι : Fin m_c)
      (g : LocallyConstant ↥((Fgt_comp ι).obj ((B_comp ι).obj E₂)).left ↥AM),
      (ext_loc E₂ ι g).comap (Fgt_Y.map u).left.base.hom =
        ext_loc E₁ ι (g.comap ((Fgt_comp ι).map ((B_comp ι).map u)).left.base.hom) := by
    intro E₁ E₂ u ι g
    ext x₁
    by_cases hx₁ : x₁ ∈ Set.range (fst_E E₁ ι).base
    · rcases hx₁ with ⟨z₁, rfl⟩
      have hcomm_z : (Fgt_Y.map u).left.base ((fst_E E₁ ι).base z₁) =
          (fst_E E₂ ι).base (((Fgt_comp ι).map ((B_comp ι).map u)).left.base z₁) :=
        congrArg (fun k => k.base z₁) (hfst_map_comm u ι).symm
      change ext_raw E₂ ι g ((Fgt_Y.map u).left.base ((fst_E E₁ ι).base z₁)) =
        ext_raw E₁ ι (g.comap ((Fgt_comp ι).map ((B_comp ι).map u)).left.base.hom)
          ((fst_E E₁ ι).base z₁)
      rw [hcomm_z, hext_apply_fst, hext_apply_fst]
      rfl
    · have hx₂ : (Fgt_Y.map u).left.base x₁ ∉ Set.range (fst_E E₂ ι).base := by
        rw [hRange_fst] at hx₁ ⊢
        have hw : (Fgt_Y.obj E₂).hom.base ((Fgt_Y.map u).left.base x₁) =
            (Fgt_Y.obj E₁).hom.base x₁ :=
          congrArg (fun k => k.base x₁) (CategoryTheory.Over.w (Fgt_Y.map u))
        intro hmem
        exact hx₁ (hw ▸ hmem)
      change ext_raw E₂ ι g ((Fgt_Y.map u).left.base x₁) =
        ext_raw E₁ ι (g.comap ((Fgt_comp ι).map ((B_comp ι).map u)).left.base.hom) x₁
      dsimp [ext_raw]
      simp only [hx₂, hx₁, ↓reduceDIte]

  have hdiag_loc : ∀ (E : Y.Etale) (ι : Fin m_c)
      (g : LocallyConstant ↥((Fgt_comp ι).obj ((B_comp ι).obj E)).left ↥AM),
      res_loc E ι (ext_loc E ι g) = g := by
    intro E ι g
    ext z
    exact hext_apply_fst E ι g z

  have hoff_loc : ∀ (E : Y.Etale) (ι₁ ι₂ : Fin m_c), ι₁ ≠ ι₂ →
      ∀ (g : LocallyConstant ↥((Fgt_comp ι₁).obj ((B_comp ι₁).obj E)).left ↥AM),
        res_loc E ι₂ (ext_loc E ι₁ g) = 0 := by
    intro E ι₁ ι₂ hne g
    ext z₂
    have hnot : (fst_E E ι₂).base z₂ ∉ Set.range (fst_E E ι₁).base := by
      rw [hRange_fst]
      have hmem₂ : (Fgt_Y.obj E).hom.base ((fst_E E ι₂).base z₂) ∈
          Set.range (inc_comp ι₂).base :=
        (hRange_fst E ι₂ ((fst_E E ι₂).base z₂)).mp ⟨z₂, rfl⟩
      exact Set.disjoint_right.mp (hDisj ι₁ ι₂ hne) hmem₂
    change ext_raw E ι₁ g ((fst_E E ι₂).base z₂) = 0
    dsimp [ext_raw]
    simp only [hnot, ↓reduceDIte]

  have hsum_loc : ∀ (E : Y.Etale) (f : LocallyConstant ↥(Fgt_Y.obj E).left ↥AM),
      (∑ ι : Fin m_c, ext_loc E ι (res_loc E ι f)) = f := by
    intro E f
    ext x
    have hmem_univ : (Fgt_Y.obj E).hom.base x ∈
        (⋃ ι : Fin m_c, Set.range (inc_comp ι).base) := by
      rw [hUniv]
      exact Set.mem_univ _
    obtain ⟨ι₀, hι₀⟩ := Set.mem_iUnion.mp hmem_univ
    obtain ⟨z₀, hz₀⟩ := (hRange_fst E ι₀ x).mpr hι₀
    rw [← LocallyConstant.evalAddMonoidHom_apply x (∑ ι : Fin m_c, ext_loc E ι (res_loc E ι f)),
      map_sum]
    rw [Finset.sum_eq_single ι₀]
    · rw [LocallyConstant.evalAddMonoidHom_apply, ← hz₀]
      exact hext_apply_fst E ι₀ (res_loc E ι₀ f) z₀
    · intro ι _ hne
      rw [LocallyConstant.evalAddMonoidHom_apply]
      have hnot : x ∉ Set.range (fst_E E ι).base := by
        rw [hRange_fst]
        exact Set.disjoint_right.mp (hDisj ι ι₀ hne) hι₀
      change ext_raw E ι (res_loc E ι f) x = 0
      dsimp [ext_raw]
      simp only [hnot, ↓reduceDIte]
    · intro hnotmem
      exact False.elim (hnotmem (Finset.mem_univ ι₀))

  
  let hCont : ∀ ι : Fin m_c, (B_comp ι).IsContinuous J_Y (J_comp ι) :=
    fun ι => (hp_inc ι).choose
  let P_push := fun ι : Fin m_c =>
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (B_comp ι) AddCommGrpCat.{u} _ J_Y (J_comp ι) (hCont ι)

  have hConstPkg := weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj.2.2
  obtain ⟨hT_Y_id, θ_Y, hbij_Y, hnat_Y_raw, hunit_Y⟩ := hConstPkg Y AM
  have hnat_Y : ∀ {E₁ E₂ : Y.Etale} (f : E₁ ⟶ E₂)
      (g : LocallyConstant ↥(Fgt_Y.obj E₂).left ↥AM),
      ((C_Y.obj AM).obj.map (Opposite.op f)).hom (θ_Y E₂ g) =
        θ_Y E₁ (g.comap (Fgt_Y.map f).left.base.hom) :=
    @hnat_Y_raw
  let e_Y : ∀ E : Y.Etale,
      LocallyConstant ↥(Fgt_Y.obj E).left ↥AM ≃+ ↑((C_Y.obj AM).obj.obj (Opposite.op E)) :=
    fun E => AddEquiv.ofBijective (θ_Y E) (hbij_Y E)

  have hCompPkg := fun ι : Fin m_c => hConstPkg (Y_comp ι) AM
  let hT_comp_id := fun ι : Fin m_c => (hCompPkg ι).choose
  let θ_comp := fun ι : Fin m_c => (hCompPkg ι).choose_spec.choose
  have hbij_comp : ∀ (ι : Fin m_c) (W : (Y_comp ι).Etale),
      Function.Bijective (θ_comp ι W) :=
    fun ι => (hCompPkg ι).choose_spec.choose_spec.1
  have hnat_comp : ∀ (ι : Fin m_c) {W₁ W₂ : (Y_comp ι).Etale} (f : W₁ ⟶ W₂)
      (g : LocallyConstant ↥((Fgt_comp ι).obj W₂).left ↥AM),
      (((C_comp ι).obj AM).obj.map (Opposite.op f)).hom (θ_comp ι W₂ g) =
        θ_comp ι W₁ (g.comap ((Fgt_comp ι).map f).left.base.hom) :=
    fun ι => (hCompPkg ι).choose_spec.choose_spec.2.1
  have hunit_comp : ∀ (ι : Fin m_c) (a : ↥AM),
      θ_comp ι (AlgebraicGeometry.Scheme.Etale.mk (𝟙 (Y_comp ι))) (LocallyConstant.const _ a) =
        ((CategoryTheory.constantSheafAdj (J_comp ι) AddCommGrpCat.{u}
          (hT_comp_id ι)).unit.app AM).hom a :=
    fun ι => (hCompPkg ι).choose_spec.choose_spec.2.2
  let e_comp : ∀ (ι : Fin m_c) (W : (Y_comp ι).Etale),
      LocallyConstant ↥((Fgt_comp ι).obj W).left ↥AM ≃+
        ↑(((C_comp ι).obj AM).obj.obj (Opposite.op W)) :=
    fun ι W => AddEquiv.ofBijective (θ_comp ι W) (hbij_comp ι W)

  have he_Y_symm_nat : ∀ {E₁ E₂ : Y.Etale} (u : E₁ ⟶ E₂)
      (s : ↑((C_Y.obj AM).obj.obj (Opposite.op E₂))),
      (e_Y E₁).symm (((C_Y.obj AM).obj.map (Opposite.op u)).hom s) =
        ((e_Y E₂).symm s).comap (Fgt_Y.map u).left.base.hom := by
    intro E₁ E₂ u s
    apply (e_Y E₁).injective
    rw [(e_Y E₁).apply_symm_apply]
    change ((C_Y.obj AM).obj.map (Opposite.op u)).hom s =
      θ_Y E₁ (((e_Y E₂).symm s).comap (Fgt_Y.map u).left.base.hom)
    rw [← hnat_Y u ((e_Y E₂).symm s)]
    exact congrArg (((C_Y.obj AM).obj.map (Opposite.op u)).hom) ((e_Y E₂).apply_symm_apply s).symm

  have he_comp_symm_nat : ∀ (ι : Fin m_c) {W₁ W₂ : (Y_comp ι).Etale} (f : W₁ ⟶ W₂)
      (s : ↑(((C_comp ι).obj AM).obj.obj (Opposite.op W₂))),
      (e_comp ι W₁).symm ((((C_comp ι).obj AM).obj.map (Opposite.op f)).hom s) =
        ((e_comp ι W₂).symm s).comap ((Fgt_comp ι).map f).left.base.hom := by
    intro ι W₁ W₂ f s
    apply (e_comp ι W₁).injective
    rw [(e_comp ι W₁).apply_symm_apply]
    change (((C_comp ι).obj AM).obj.map (Opposite.op f)).hom s =
      θ_comp ι W₁ (((e_comp ι W₂).symm s).comap ((Fgt_comp ι).map f).left.base.hom)
    rw [← hnat_comp ι f ((e_comp ι W₂).symm s)]
    exact congrArg ((((C_comp ι).obj AM).obj.map (Opposite.op f)).hom)
      ((e_comp ι W₂).apply_symm_apply s).symm

  let proj_ι : ∀ ι : Fin m_c,
      C_Y.obj AM ⟶ (P_push ι).obj ((C_comp ι).obj AM) := fun ι =>
    CategoryTheory.ObjectProperty.homMk
      { app := fun E_op =>
          AddCommGrpCat.ofHom
            (((e_comp ι ((B_comp ι).obj E_op.unop)).toAddMonoidHom.comp
              (res_loc E_op.unop ι)).comp
              (e_Y E_op.unop).symm.toAddMonoidHom)
        naturality := fun {E₂_op E₁_op} u_op => by
          rcases E₂_op with ⟨E₂⟩
          rcases E₁_op with ⟨E₁⟩
          rcases u_op with ⟨u⟩
          ext s
          change θ_comp ι ((B_comp ι).obj E₁)
              (res_loc E₁ ι ((e_Y E₁).symm (((C_Y.obj AM).obj.map (Opposite.op u)).hom s))) =
            (((C_comp ι).obj AM).obj.map (Opposite.op ((B_comp ι).map u))).hom
              (θ_comp ι ((B_comp ι).obj E₂) (res_loc E₂ ι ((e_Y E₂).symm s)))
          rw [he_Y_symm_nat u s, hnat_comp ι ((B_comp ι).map u), hres_nat u ι] }

  let incl_ι : ∀ ι : Fin m_c,
      (P_push ι).obj ((C_comp ι).obj AM) ⟶ C_Y.obj AM := fun ι =>
    CategoryTheory.ObjectProperty.homMk
      { app := fun E_op =>
          AddCommGrpCat.ofHom
            (((e_Y E_op.unop).toAddMonoidHom.comp
              (ext_loc E_op.unop ι)).comp
              (e_comp ι ((B_comp ι).obj E_op.unop)).symm.toAddMonoidHom)
        naturality := fun {E₂_op E₁_op} u_op => by
          rcases E₂_op with ⟨E₂⟩
          rcases E₁_op with ⟨E₁⟩
          rcases u_op with ⟨u⟩
          ext s
          let s₂ : ↑(((C_comp ι).obj AM).obj.obj (Opposite.op ((B_comp ι).obj E₂))) := s
          change θ_Y E₁
              (ext_loc E₁ ι
                ((e_comp ι ((B_comp ι).obj E₁)).symm
                  ((((C_comp ι).obj AM).obj.map (Opposite.op ((B_comp ι).map u))).hom s₂))) =
            ((C_Y.obj AM).obj.map (Opposite.op u)).hom
              (θ_Y E₂ (ext_loc E₂ ι ((e_comp ι ((B_comp ι).obj E₂)).symm s₂)))
          rw [he_comp_symm_nat ι ((B_comp ι).map u) s₂, hnat_Y u, hext_nat u ι] }

  have hdiag_sh : ∀ ι : Fin m_c, incl_ι ι ≫ proj_ι ι = 𝟙 _ := by
    intro ι
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext E_op
    rcases E_op with ⟨E⟩
    ext s
    let s₀ : ↑(((C_comp ι).obj AM).obj.obj (Opposite.op ((B_comp ι).obj E))) := s
    change e_comp ι ((B_comp ι).obj E)
        (res_loc E ι
          ((e_Y E).symm
            (e_Y E (ext_loc E ι ((e_comp ι ((B_comp ι).obj E)).symm s₀))))) = s₀
    rw [(e_Y E).symm_apply_apply, hdiag_loc, (e_comp ι ((B_comp ι).obj E)).apply_symm_apply]

  have hoff_sh : ∀ ι₁ ι₂ : Fin m_c, ι₁ ≠ ι₂ → incl_ι ι₁ ≫ proj_ι ι₂ = 0 := by
    intro ι₁ ι₂ hne
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext E_op
    rcases E_op with ⟨E⟩
    ext s
    let s₁ : ↑(((C_comp ι₁).obj AM).obj.obj (Opposite.op ((B_comp ι₁).obj E))) := s
    change e_comp ι₂ ((B_comp ι₂).obj E)
        (res_loc E ι₂
          ((e_Y E).symm
            (e_Y E (ext_loc E ι₁ ((e_comp ι₁ ((B_comp ι₁).obj E)).symm s₁))))) = 0
    rw [(e_Y E).symm_apply_apply, hoff_loc E ι₁ ι₂ hne, map_zero]

  have hsum_sh : (∑ ι : Fin m_c, proj_ι ι ≫ incl_ι ι) = 𝟙 (C_Y.obj AM) := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext E_op
    rcases E_op with ⟨E⟩
    ext s
    let ev_sh : (C_Y.obj AM ⟶ C_Y.obj AM) →+ ↑((C_Y.obj AM).obj.obj (Opposite.op E)) :=
      { toFun := fun φ => (φ.hom.app (Opposite.op E)).hom s
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    change ev_sh (∑ ι : Fin m_c, proj_ι ι ≫ incl_ι ι) = s
    rw [map_sum]
    have hterm : ∀ ι : Fin m_c,
        ev_sh (proj_ι ι ≫ incl_ι ι) =
          e_Y E (ext_loc E ι (res_loc E ι ((e_Y E).symm s))) := by
      intro ι
      change e_Y E
          (ext_loc E ι
            ((e_comp ι ((B_comp ι).obj E)).symm
              (e_comp ι ((B_comp ι).obj E)
                (res_loc E ι ((e_Y E).symm s))))) = _
      rw [(e_comp ι ((B_comp ι).obj E)).symm_apply_apply]
    rw [Finset.sum_congr rfl fun ι _ => hterm ι, ← map_sum (e_Y E), hsum_loc,
      (e_Y E).apply_symm_apply]

  
  let split_fn : weilEtaleTorsionH Y n q →
      (∀ ι : Fin m_c, ((P_push ι).obj ((C_comp ι).obj AM)).H q) :=
    fun x ι => ((CategoryTheory.Abelian.Ext.mk₀ (proj_ι ι)).postcomp (C_Y.obj Aℤ)
      (Nat.add_zero q)) x

  let unsplit_fn : (∀ ι : Fin m_c, ((P_push ι).obj ((C_comp ι).obj AM)).H q) →
      weilEtaleTorsionH Y n q :=
    fun w => ∑ ι : Fin m_c,
      ((CategoryTheory.Abelian.Ext.mk₀ (incl_ι ι)).postcomp (C_Y.obj Aℤ)
        (Nat.add_zero q)) (w ι)

  have hBij_split : Function.Bijective split_fn := by
    refine Function.bijective_iff_has_inverse.mpr ⟨unsplit_fn, ?_, ?_⟩
    · intro x
      let φ_x : (C_Y.obj AM ⟶ C_Y.obj AM) →+ weilEtaleTorsionH Y n q :=
        (x.precomp (C_Y.obj AM) (Nat.add_zero q)).comp
          CategoryTheory.Abelian.Ext.addEquiv₀.symm.toAddMonoidHom
      have hsummand : ∀ ι : Fin m_c,
          ((CategoryTheory.Abelian.Ext.mk₀ (incl_ι ι)).postcomp (C_Y.obj Aℤ) (Nat.add_zero q))
            (split_fn x ι) = φ_x (proj_ι ι ≫ incl_ι ι) := by
        intro ι
        dsimp [φ_x, split_fn]
        rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        change (x.comp (CategoryTheory.Abelian.Ext.mk₀ (proj_ι ι)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (incl_ι ι)) (Nat.add_zero q) =
          x.comp (CategoryTheory.Abelian.Ext.mk₀ (proj_ι ι ≫ incl_ι ι)) (Nat.add_zero q)
        rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) rfl (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      change ∑ ι : Fin m_c,
          ((CategoryTheory.Abelian.Ext.mk₀ (incl_ι ι)).postcomp (C_Y.obj Aℤ) (Nat.add_zero q))
            (split_fn x ι) = x
      rw [Finset.sum_congr rfl fun ι _ => hsummand ι, ← map_sum φ_x, hsum_sh]
      dsimp [φ_x]
      rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id x
    · intro w
      funext ι₀
      change ((CategoryTheory.Abelian.Ext.mk₀ (proj_ι ι₀)).postcomp (C_Y.obj Aℤ)
          (Nat.add_zero q))
        (∑ ι : Fin m_c,
          ((CategoryTheory.Abelian.Ext.mk₀ (incl_ι ι)).postcomp (C_Y.obj Aℤ)
            (Nat.add_zero q)) (w ι)) = w ι₀
      rw [map_sum]
      refine (Finset.sum_eq_single ι₀ ?_ ?_).trans ?_
      · intro ι _ hne
        change ((w ι).comp (CategoryTheory.Abelian.Ext.mk₀ (incl_ι ι)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (proj_ι ι₀)) (Nat.add_zero q) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc (w ι) _ _ (Nat.add_zero q) rfl (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hoff_sh ι ι₀ hne,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, map_zero]
        exact map_zero ((w ι).precomp _ (Nat.add_zero q))
      · intro hnotmem
        exact False.elim (hnotmem (Finset.mem_univ ι₀))
      · change ((w ι₀).comp (CategoryTheory.Abelian.Ext.mk₀ (incl_ι ι₀)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (proj_ι ι₀)) (Nat.add_zero q) = w ι₀
        rw [CategoryTheory.Abelian.Ext.comp_assoc (w ι₀) _ _ (Nat.add_zero q) rfl (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hdiag_sh ι₀,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]

  
  have hUnit_term : ∀ (V : AlgebraicGeometry.Scheme.{u}),
      let T_id : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
      ∀ (hT_id : CategoryTheory.Limits.IsTerminal T_id)
        (θ_V : ∀ W : V.Etale,
          LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj W).left ↥AM →+
            ↑(((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj AM).obj.obj
              (Opposite.op W)))
        (_hnat_V : ∀ {W₁ W₂ : V.Etale} (f : W₁ ⟶ W₂)
          (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj W₂).left ↥AM),
          (((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj AM).obj.map
            (Opposite.op f)).hom (θ_V W₂ g) =
            θ_V W₁ (g.comap ((AlgebraicGeometry.Scheme.Etale.forget V).map f).left.base.hom))
        (_hunit_V : ∀ a : ↥AM,
          θ_V T_id (LocallyConstant.const _ a) =
            ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
              hT_id).unit.app AM).hom a)
        (T : V.Etale) (hT : CategoryTheory.Limits.IsTerminal T) (a : ↥AM),
        ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
          hT).unit.app AM).hom a = θ_V T (LocallyConstant.const _ a) := by
    intro V T_id hT_id θ_V hnat_V hunit_V T hT a
    let J_V := V.smallEtaleTopology
    let C_V := CategoryTheory.constantSheaf J_V AddCommGrpCat.{u}
    let shAdj := CategoryTheory.sheafificationAdjunction J_V AddCommGrpCat.{u}
    let cPSh := (CategoryTheory.Functor.const (Opposite V.Etale)).obj AM
    let m_T : T ⟶ T_id := hT_id.from T
    have hunit_eq : ∀ (T' : V.Etale) (hT' : CategoryTheory.Limits.IsTerminal T'),
        (CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT').unit.app AM =
          (shAdj.unit.app cPSh).app (Opposite.op T') := by
      intro T' hT'
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT').comp shAdj).unit.app AM = _
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.Category.id_comp]
      rfl
    have hnat_sh : (shAdj.unit.app cPSh).app (Opposite.op T) =
        (shAdj.unit.app cPSh).app (Opposite.op T_id) ≫ (C_V.obj AM).obj.map (Opposite.op m_T) :=
      (CategoryTheory.Category.id_comp ((shAdj.unit.app cPSh).app (Opposite.op T))).symm.trans
        ((shAdj.unit.app cPSh).naturality (Opposite.op m_T))
    have hm_app : ((shAdj.unit.app cPSh).app (Opposite.op T)).hom a =
        ((C_V.obj AM).obj.map (Opposite.op m_T)).hom
          (((shAdj.unit.app cPSh).app (Opposite.op T_id)).hom a) :=
      congrArg (fun φ => φ.hom a) hnat_sh
    have h_lhs : ((CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT).unit.app AM).hom a =
        ((shAdj.unit.app cPSh).app (Opposite.op T)).hom a :=
      congrArg (fun φ => φ.hom a) (hunit_eq T hT)
    have h_rhs : ((shAdj.unit.app cPSh).app (Opposite.op T_id)).hom a =
        θ_V T_id (LocallyConstant.const _ a) :=
      (congrArg (fun φ => φ.hom a) (hunit_eq T_id hT_id)).symm.trans (hunit_V a).symm
    exact h_lhs.trans (hm_app.trans
      ((congrArg (((C_V.obj AM).obj.map (Opposite.op m_T)).hom) h_rhs).trans
        (hnat_V m_T (LocallyConstant.const _ a))))

  
  have hComp_bij : ∀ ι : Fin m_c,
      ∃ leray_f : ((P_push ι).obj ((C_comp ι).obj AM)).H q → weilEtaleTorsionH (Y_comp ι) n q,
        Function.Bijective leray_f ∧
        ∀ x : weilEtaleTorsionH Y n q, leray_f (split_fn x ι) = p_inc ι x := by
    intro ι
    have : AlgebraicGeometry.IsClosedImmersion (inc_comp ι) := hClosed ι
    have : (weilEtaleSitePullback (inc_comp ι)).IsContinuous J_Y (J_comp ι) := hCont ι
    rcases (hp_inc ι).choose_spec with
      ⟨P_pull, adj_pull, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hp_eq⟩
    have : P_pull.Additive := hAdd
    have : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
    have : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
    let leray_f := fun z : CategoryTheory.Abelian.Ext (C_Y.obj Aℤ)
        ((P_push ι).obj ((C_comp ι).obj AM)) q =>
      (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ((C_comp ι).obj AM))).postcomp
        ((C_comp ι).obj Aℤ) (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C_Y.obj Aℤ) ((P_push ι).obj ((C_comp ι).obj AM)) q) z)
          (Nat.zero_add q))
    have hBij_l : Function.Bijective leray_f :=
      weil_etale_finite_leray_counit_bijective (inc_comp ι) P_pull adj_pull
        T₁ hT₁ T₂ hT₂ ιℤ hιπ hπι ((C_comp ι).obj AM) q
    refine ⟨leray_f, hBij_l, fun x => ?_⟩
    let adj₁ := CategoryTheory.constantSheafAdj (J_comp ι) AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT₂
    let τ : (B_comp ι).obj T₂ ⟶ T₁ := hT₁.from ((B_comp ι).obj T₂)
    have hmate_eq : adj₂.homEquiv AM ((P_push ι).obj ((C_comp ι).obj AM)) (proj_ι ι) =
        adj₁.unit.app AM ≫ ((C_comp ι).obj AM).obj.map (Opposite.op τ) := by
      ext a
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      change ((proj_ι ι).hom.app (Opposite.op T₂)).hom ((adj₂.unit.app AM).hom a) =
        (((C_comp ι).obj AM).obj.map (Opposite.op τ)).hom ((adj₁.unit.app AM).hom a)
      rw [hUnit_term Y hT_Y_id θ_Y (@hnat_Y_raw) hunit_Y T₂ hT₂ a,
        hUnit_term (Y_comp ι) (hT_comp_id ι) (θ_comp ι) (@hnat_comp ι) (hunit_comp ι) T₁ hT₁ a,
        hnat_comp ι τ]
      change e_comp ι ((B_comp ι).obj T₂)
          (res_loc T₂ ι ((e_Y T₂).symm (e_Y T₂ (LocallyConstant.const _ a)))) =
        θ_comp ι ((B_comp ι).obj T₂) (LocallyConstant.const _ a)
      rw [(e_Y T₂).symm_apply_apply, hres_const]
      rfl
    have hproj_symm : (adj₂.homEquiv AM ((P_push ι).obj ((C_comp ι).obj AM))).symm
        (adj₁.unit.app AM ≫ ((C_comp ι).obj AM).obj.map (Opposite.op τ)) = proj_ι ι :=
      (congrArg (adj₂.homEquiv AM ((P_push ι).obj ((C_comp ι).obj AM))).symm hmate_eq.symm).trans
        ((adj₂.homEquiv AM ((P_push ι).obj ((C_comp ι).obj AM))).symm_apply_apply (proj_ι ι))
    let πM : P_pull.obj (C_Y.obj AM) ⟶ (C_comp ι).obj AM :=
      (adj_pull.homEquiv (C_Y.obj AM) ((C_comp ι).obj AM)).symm
        ((adj₂.homEquiv AM ((P_push ι).obj ((C_comp ι).obj AM))).symm
          (adj₁.unit.app AM ≫ ((C_comp ι).obj AM).obj.map (Opposite.op τ)))
    have hπM_eq : πM = P_pull.map (proj_ι ι) ≫ adj_pull.counit.app ((C_comp ι).obj AM) := by
      dsimp [πM]
      rw [hproj_symm, CategoryTheory.Adjunction.homEquiv_counit]
    rw [hp_eq x]
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C_Y.obj Aℤ) ((P_push ι).obj ((C_comp ι).obj AM)) q)
            (x.comp (CategoryTheory.Abelian.Ext.mk₀ (proj_ι ι)) (Nat.add_zero q)))
          (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ((C_comp ι).obj AM)))
        (Nat.add_zero q)) =
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C_Y.obj Aℤ) (C_Y.obj AM) q) x)
          (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q))
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _ _
        (Nat.zero_add q) (Nat.add_zero q) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc _
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map (proj_ι ι)))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app ((C_comp ι).obj AM)))
        (Nat.add_zero q) rfl (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hπM_eq]

  choose leray_f hBij_leray hFac_leray using hComp_bij
  have hBij_all : Function.Bijective
      (fun (w : ∀ ι : Fin m_c, ((P_push ι).obj ((C_comp ι).obj AM)).H q) (ι : Fin m_c) =>
        leray_f ι (w ι)) := by
    constructor
    · intro w₁ w₂ hw
      funext ι
      exact (hBij_leray ι).1 (congrFun hw ι)
    · intro v
      refine ⟨fun ι => Classical.choose ((hBij_leray ι).2 (v ι)), funext fun ι => ?_⟩
      exact Classical.choose_spec ((hBij_leray ι).2 (v ι))

  have hEq_comp : (fun (x : weilEtaleTorsionH Y n q) (ι : Fin m_c) => p_inc ι x) =
      (fun w ι => leray_f ι (w ι)) ∘ split_fn := by
    funext x ι
    exact (hFac_leray ι x).symm
  rw [hEq_comp]
  exact hBij_all.comp hBij_split

theorem weil_etale_punctual_skyscraper_cohomology_and_gauge (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ M_bdry : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u})
    (z_bdry : Fin M_bdry → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Y)
    (hCont_z : ∀ t : Fin M_bdry, (weilEtaleSitePullback (z_bdry t)).IsContinuous
      Y.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
    (α_geom : CategoryTheory.Iso Y Y)
    (hCont_α : (weilAffGeomPbcSliceMap
      (inferInstance : AlgebraicGeometry.Etale α_geom.hom)).IsContinuous
      Y.smallEtaleTopology Y.smallEtaleTopology)
    (hAdd_α : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilAffGeomPbcSliceMap (inferInstance : AlgebraicGeometry.Etale α_geom.hom))
      AddCommGrpCat.{u} _ Y.smallEtaleTopology Y.smallEtaleTopology hCont_α).Additive)
    (hLim_α : CategoryTheory.Limits.PreservesFiniteLimits
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAffGeomPbcSliceMap (inferInstance : AlgebraicGeometry.Etale α_geom.hom))
        AddCommGrpCat.{u} _ Y.smallEtaleTopology Y.smallEtaleTopology hCont_α))
    (hColim_α : CategoryTheory.Limits.PreservesFiniteColimits
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAffGeomPbcSliceMap (inferInstance : AlgebraicGeometry.Etale α_geom.hom))
        AddCommGrpCat.{u} _ Y.smallEtaleTopology Y.smallEtaleTopology hCont_α))
    (π_bdry : Equiv.Perm (Fin M_bdry)) :
