              change triv_K m₂ W₁ (appFun W₁ (((𝒦_s m₁).obj.map (Opposite.op u)) sec)) y₁ =
                triv_K m₂ W₁ (((𝒦_s m₂).obj.map (Opposite.op u)) (appFun W₂ sec)) y₁
