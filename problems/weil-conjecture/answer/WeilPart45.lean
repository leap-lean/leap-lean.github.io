        AddMonoidHom.range (δ_m m) = AddMonoidHom.ker (g₁_m m) ∧
        Function.Surjective (g₁_m m) ∧
        (∀ v t, f₀_m m (act_comp m 0 v) t = f₀_m m v (π_bdry t)) ∧
        (∀ u, δ_m m (fun t => u (π_bdry t)) = α_H m 1 (δ_m m u)) ∧
        (∀ x, g₁_m m (α_H m 1 x) = act_comp m 1 (g₁_m m x)) ∧
        (∀ x, g₂_m m (α_H m 2 x) = act_comp m 2 (g₂_m m x)) ∧
        (∀ v t, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
            (f₀_m (m + 1) v t) =
          f₀_m m (fun j => trans_comp m 0 j (v j)) t) ∧
        (∀ u, τ_H 1 m (δ_m (m + 1) u) =
          δ_m m (fun t =>
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1))) (u t))) ∧
        (∀ x j, trans_comp m 1 j (g₁_m (m + 1) x j) = g₁_m m (τ_H 1 m x) j) ∧
        (∀ x j, trans_comp m 2 j (g₂_m (m + 1) x j) = g₂_m m (τ_H 2 m x) j) :=
by
  let _ : P.Additive := hAdd
  let _ : CategoryTheory.Limits.PreservesFiniteLimits P := hLim
  let _ : CategoryTheory.Limits.PreservesFiniteColimits P := hColim

  
  have hExtComp : ∀ {Y₁ Y₂ Y₃ : C} (f : Y₁ ⟶ Y₂) (g : Y₂ ⟶ Y₃) (q : ℕ)
      (x : CategoryTheory.Abelian.Ext X Y₁ q),
      ((CategoryTheory.Abelian.Ext.mk₀ (f ≫ g)).postcomp X (Nat.add_zero q)) x =
        ((CategoryTheory.Abelian.Ext.mk₀ g).postcomp X (Nat.add_zero q))
          (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp X (Nat.add_zero q)) x) := by
    intro Y₁ Y₂ Y₃ f g q x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (f ≫ g)) (Nat.add_zero q) =
      (x.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q)
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f g]
    exact (CategoryTheory.Abelian.Ext.comp_assoc x
      (CategoryTheory.Abelian.Ext.mk₀ f) (CategoryTheory.Abelian.Ext.mk₀ g)
      (Nat.add_zero q) (Nat.add_zero 0) (by omega)).symm

  
  have hExtLES : ∀ {J₀ L₀ S₀ : C} (ι₀ : J₀ ⟶ L₀) (ρ₀ : L₀ ⟶ S₀) (h0₀ : ι₀ ≫ ρ₀ = 0)
      (hSE₀ : (CategoryTheory.ShortComplex.mk ι₀ ρ₀ h0₀).ShortExact),
      let ρ_star := (CategoryTheory.Abelian.Ext.mk₀ ρ₀).postcomp X (Nat.add_zero 0)
      let δ_ext := hSE₀.extClass.postcomp X (Nat.zero_add 1)
      let ι_star := fun q : ℕ => (CategoryTheory.Abelian.Ext.mk₀ ι₀).postcomp X (Nat.add_zero q)
      (Subsingleton (CategoryTheory.Abelian.Ext X J₀ 0) → Function.Injective ρ_star) ∧
      (AddMonoidHom.range ρ_star = AddMonoidHom.ker δ_ext) ∧
      (AddMonoidHom.range δ_ext = AddMonoidHom.ker (ι_star 1)) ∧
      (Subsingleton (CategoryTheory.Abelian.Ext X S₀ 1) → Function.Surjective (ι_star 1)) ∧
      (∀ r : ℕ,
        Subsingleton (CategoryTheory.Abelian.Ext X S₀ (r + 1)) →
        Subsingleton (CategoryTheory.Abelian.Ext X S₀ (r + 2)) →
        Function.Bijective (ι_star (r + 2))) := by
    intro J₀ L₀ S₀ ι₀ ρ₀ h0₀ hSE₀ ρ_star δ_ext ι_star
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro hSub x y hxy
      have hdiff : (x - y).comp (CategoryTheory.Abelian.Ext.mk₀ ρ₀) (Nat.add_zero 0) = 0 := by
        change ρ_star (x - y) = 0
        rw [map_sub, hxy, sub_self]
      obtain ⟨w, hw⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X hSE₀ (x - y) hdiff
      have hw0 : w = 0 := @Subsingleton.elim _ hSub w 0
      rw [hw0, CategoryTheory.Abelian.Ext.zero_comp] at hw
      exact sub_eq_zero.mp hw.symm
    · ext z
      simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨w, rfl⟩
        change (w.comp (CategoryTheory.Abelian.Ext.mk₀ ρ₀) (Nat.add_zero 0)).comp
          hSE₀.extClass (Nat.zero_add 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc w (CategoryTheory.Abelian.Ext.mk₀ ρ₀)
          hSE₀.extClass (Nat.add_zero 0) (Nat.zero_add 1) (by omega),
          hSE₀.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro hz
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X hSE₀ z (Nat.zero_add 1) hz
    · ext u
      simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨z, rfl⟩
        change (z.comp hSE₀.extClass (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ι₀) (Nat.add_zero 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc z hSE₀.extClass
          (CategoryTheory.Abelian.Ext.mk₀ ι₀) (Nat.zero_add 1) (Nat.add_zero 1) (by omega),
          hSE₀.extClass_comp, CategoryTheory.Abelian.Ext.comp_zero]
      · intro hu
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hSE₀ u hu (Nat.zero_add 1)
    · intro hSub y
      have hy : y.comp (CategoryTheory.Abelian.Ext.mk₀ ρ₀) (Nat.add_zero 1) = 0 :=
        @Subsingleton.elim _ hSub _ 0
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X hSE₀ y hy
    · intro r hSub1 hSub2
      constructor
      · intro u₁ u₂ hu
        have hdiff : (u₁ - u₂).comp (CategoryTheory.Abelian.Ext.mk₀ ι₀) (Nat.add_zero (r + 2)) = 0 := by
          change ι_star (r + 2) (u₁ - u₂) = 0
          rw [map_sub, hu, sub_self]
        obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hSE₀ (u₁ - u₂)
          hdiff (rfl : (r + 1) + 1 = r + 2)
        have hz0 : z = 0 := @Subsingleton.elim _ hSub1 z 0
        rw [hz0, CategoryTheory.Abelian.Ext.zero_comp] at hz
        exact sub_eq_zero.mp hz.symm
      · intro y
        have hy : y.comp (CategoryTheory.Abelian.Ext.mk₀ ρ₀) (Nat.add_zero (r + 2)) = 0 :=
          @Subsingleton.elim _ hSub2 _ 0
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X hSE₀ y hy

  
  have hExtSliceNat : ∀ {G₁ G₂ : C} (φ : G₁ ⟶ G₂) (β₁ : P.obj G₁ ⟶ G₁) (β₂ : P.obj G₂ ⟶ G₂),
      P.map φ ≫ β₂ = β₁ ≫ φ →
      ∀ (q : ℕ) (z : CategoryTheory.Abelian.Ext X G₁ q),
        ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp X (Nat.add_zero q))
          (((CategoryTheory.Abelian.Ext.mk₀ β₁).postcomp X (Nat.add_zero q))
            ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
              ((P.mapExtAddHom X G₁ q) z) (Nat.zero_add q))) =
        ((CategoryTheory.Abelian.Ext.mk₀ β₂).postcomp X (Nat.add_zero q))
          ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
            ((P.mapExtAddHom X G₂ q)
              (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp X (Nat.add_zero q)) z))
            (Nat.zero_add q)) := by
    intro G₁ G₂ φ β₁ β₂ hcomm q z
    change (((CategoryTheory.Abelian.Ext.mk₀ αX).comp
        ((P.mapExtAddHom X G₁ q) z) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ β₁) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q) =
      ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
        ((P.mapExtAddHom X G₂ q)
          (z.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q)))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ β₂) (Nat.add_zero q)
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    rw [CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor P z) (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ β₁) (CategoryTheory.Abelian.Ext.mk₀ φ)
        (Nat.add_zero q) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ β₁ φ, ← hcomm,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (P.map φ) β₂,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor P z) (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ (P.map φ)) (CategoryTheory.Abelian.Ext.mk₀ β₂)
        (Nat.add_zero q) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ αX)
        (CategoryTheory.Abelian.Ext.mapExactFunctor P z)
        (CategoryTheory.Abelian.Ext.mk₀ (P.map φ))
        (Nat.zero_add q) (Nat.add_zero q) (by omega)]

  have hExtSliceDelta : ∀ (m : ℕ) (z₀ : CategoryTheory.Abelian.Ext X (S m) 0),
      ((hSE m).extClass.postcomp X (Nat.zero_add 1))
        (((CategoryTheory.Abelian.Ext.mk₀ (βS m)).postcomp X (Nat.add_zero 0))
          ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
            ((P.mapExtAddHom X (S m) 0) z₀) (Nat.zero_add 0))) =
      ((CategoryTheory.Abelian.Ext.mk₀ (βJ m)).postcomp X (Nat.add_zero 1))
        ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
          ((P.mapExtAddHom X (J m) 1)
