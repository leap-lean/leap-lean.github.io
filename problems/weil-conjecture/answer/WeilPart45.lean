    exact h W.unop sec

  have hSup_inf : ∀ {L : Type u} [DistribLattice L] [OrderTop L] (u_op : L)
      {n : ℕ} (w : Fin n → L),
      (∀ i : Fin n, u_op ⊔ w i = ⊤) → u_op ⊔ Finset.univ.inf w = ⊤ := by
    intro L _ _ u_op n w hw
    have hgen : ∀ s_fin : Finset (Fin n), u_op ⊔ s_fin.inf w = ⊤ := by
      intro s_fin
      induction s_fin using Finset.induction_on with
      | empty => simp
      | insert a s' _ ih =>
        rw [Finset.inf_insert, sup_inf_left, hw a, ih, top_inf_eq]
    exact hgen Finset.univ

  have hEpiFex : ∀ (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u})
      [F_ex.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F_ex],
      (∀ {ℱ₁ ℱ₂ : 𝒜} (π : ℱ₁ ⟶ ℱ₂),
        (ℓ ^ K : ℕ) • 𝟙 ℱ₁ = 0 → CategoryTheory.Epi π →
        Function.Surjective (F_ex.map π).hom) →
      ∀ {ℱ₁ ℱ₂ : 𝒜} (g : ℱ₁ ⟶ ℱ₂),
        (ℓ ^ K : ℕ) • 𝟙 ℱ₁ = 0 →
        (∀ (W : D_bar.Etale) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))) (p : ↥(Fgt.obj W).left),
          ∃ (U : D_bar.Etale) (u : U ⟶ W) (q : ↥(Fgt.obj U).left)
            (s₁ : ↑(ℱ₁.obj.obj (Opposite.op U))),
            AlgebraicGeometry.Etale (Fgt.map u).left ∧
            (Fgt.map u).left.base q = p ∧
            (g.hom.app (Opposite.op U)) s₁ = (ℱ₂.obj.map (Opposite.op u)) s₂) →
        Function.Surjective (F_ex.map g).hom := by
    intro F_ex _ _ hSurj_ex ℱ₁ ℱ₂ g hTor₁ hloc
    have : CategoryTheory.Sheaf.IsLocallySurjective g := by
      refine ⟨fun {W} s₂ => hMem_D W _ fun p => ?_⟩
      obtain ⟨U, u, q, s₁, hEt, hqp, heq⟩ := hloc W s₂ p
      refine ⟨U, u, q, ?_, hEt, hqp⟩
      rw [CategoryTheory.Presheaf.imageSieve_apply]
      exact ⟨s₁, heq⟩
    exact hSurj_ex g hTor₁ (CategoryTheory.Sheaf.epi_of_isLocallySurjective g)

  have hExactFex : ∀ (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u})
      [F_ex.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F_ex],
      (∀ {ℱ₁ ℱ₂ : 𝒜} (π : ℱ₁ ⟶ ℱ₂),
        (ℓ ^ K : ℕ) • 𝟙 ℱ₁ = 0 → CategoryTheory.Epi π →
        Function.Surjective (F_ex.map π).hom) →
      ∀ {ℱ₁ ℱ₂ ℱ₃ : 𝒜} (f : ℱ₁ ⟶ ℱ₂) (g : ℱ₂ ⟶ ℱ₃) (h0 : f ≫ g = 0),
        (ℓ ^ K : ℕ) • 𝟙 ℱ₁ = 0 →
        (∀ (W : D_bar.Etale) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))),
          (g.hom.app (Opposite.op W)) s₂ = 0 →
          ∀ p : ↥(Fgt.obj W).left,
            ∃ (U : D_bar.Etale) (u : U ⟶ W) (q : ↥(Fgt.obj U).left)
              (s₁ : ↑(ℱ₁.obj.obj (Opposite.op U))),
              AlgebraicGeometry.Etale (Fgt.map u).left ∧
              (Fgt.map u).left.base q = p ∧
              (f.hom.app (Opposite.op U)) s₁ = (ℱ₂.obj.map (Opposite.op u)) s₂) →
        ∀ y : ↑(F_ex.obj ℱ₂),
          (F_ex.map g).hom y = 0 ↔ ∃ x : ↑(F_ex.obj ℱ₁), (F_ex.map f).hom x = y := by
    intro F_ex _ _ hSurj_ex ℱ₁ ℱ₂ ℱ₃ f g h0 hTor₁ hloc_ker y
    let k_lift : ℱ₁ ⟶ Limits.kernel g := Limits.kernel.lift g f h0
    have hsurj_klift : Function.Surjective (F_ex.map k_lift).hom := by
      refine hEpiFex F_ex hSurj_ex k_lift hTor₁ (fun W sec p => ?_)
      let s₂ : ↑(ℱ₂.obj.obj (Opposite.op W)) :=
        ((Limits.kernel.ι g).hom.app (Opposite.op W)) sec
      have hs₂ : (g.hom.app (Opposite.op W)) s₂ = 0 := by
        change ((Limits.kernel.ι g ≫ g).hom.app (Opposite.op W)) sec = 0
        rw [Limits.kernel.condition]
        rfl
      obtain ⟨U, u, q, s₁, hEt, hqp, hs₁⟩ := hloc_ker W s₂ hs₂ p
      refine ⟨U, u, q, s₁, hEt, hqp, ?_⟩
      let evU := (CategoryTheory.sheafToPresheaf J_D AddCommGrpCat.{u}).comp
        ((CategoryTheory.evaluation (D_bar.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op U))
      have hMono_ev : CategoryTheory.Mono (evU.map (Limits.kernel.ι g)) := inferInstance
      have hinj : Function.Injective ((Limits.kernel.ι g).hom.app (Opposite.op U)) :=
        (AddCommGrpCat.mono_iff_injective (evU.map (Limits.kernel.ι g))).mp hMono_ev
      apply hinj
      have h_lhs : ((Limits.kernel.ι g).hom.app (Opposite.op U))
          ((k_lift.hom.app (Opposite.op U)) s₁) = (f.hom.app (Opposite.op U)) s₁ := by
        change ((k_lift ≫ Limits.kernel.ι g).hom.app (Opposite.op U)) s₁ = _
        rw [Limits.kernel.lift_ι]
      have h_nat := congrArg (fun φ => φ.hom sec)
        ((Limits.kernel.ι g).hom.naturality (Opposite.op u))
      dsimp at h_nat
      rw [h_lhs, hs₁]
      exact h_nat.symm
    constructor
    · intro hy
      let isLim := Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel g) F_ex
      let Z0 := AddCommGrpCat.of (ULift.{u} ℤ)
      let φ : Z0 ⟶ F_ex.obj ℱ₂ := AddCommGrpCat.ofHom
        { toFun := fun n => n.down • y
          map_zero' := zero_smul ℤ y
          map_add' := fun a b => add_smul a.down b.down y }
      have hφ0 : φ ≫ F_ex.map g = 0 := by
        ext ⟨n⟩
        change (F_ex.map g).hom (n • y) = 0
        rw [map_zsmul, hy, smul_zero]
      let ψ : Z0 ⟶ F_ex.obj (Limits.kernel g) :=
        Limits.Fork.IsLimit.lift isLim φ (by rw [hφ0, Limits.comp_zero])
      have hψ : ψ ≫ F_ex.map (Limits.kernel.ι g) = φ :=
        isLim.fac (Limits.KernelFork.ofι φ hφ0) Limits.WalkingParallelPair.zero
      obtain ⟨x, hx⟩ := hsurj_klift (ψ.hom (ULift.up 1))
      refine ⟨x, ?_⟩
      have h1 : (F_ex.map f).hom x =
          (F_ex.map (Limits.kernel.ι g)).hom ((F_ex.map k_lift).hom x) := by
        conv_lhs => rw [← Limits.kernel.lift_ι g f h0, F_ex.map_comp]
        rfl
      rw [h1, hx]
      have h2 := congrArg (fun h => h.hom (ULift.up 1)) hψ
      simpa [φ] using h2
    · rintro ⟨x, rfl⟩
      change ((F_ex.map f ≫ F_ex.map g).hom) x = 0
      rw [← F_ex.map_comp, h0, F_ex.map_zero]
      rfl

  let X_n (n : ℕ) : 𝒜 := ⨁ (fun _ : Fin n => 𝒳)
  have hTor_Xn : ∀ n : ℕ, (ℓ ^ K : ℕ) • 𝟙 (X_n n) = 0 := by
    intro n
    apply Limits.biproduct.hom_ext'
    intro j
    rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero]
    exact hTor_hom (Limits.biproduct.ι (fun _ : Fin n => 𝒳) j)

  let toSec (W : D_bar.Etale) (n : ℕ)
      (v : Fin n → ↑(𝒳.obj.obj (Opposite.op W))) : ↑((X_n n).obj.obj (Opposite.op W)) :=
    ∑ j : Fin n, ((Limits.biproduct.ι (fun _ : Fin n => 𝒳) j).hom.app (Opposite.op W)) (v j)
  let fromSec (W : D_bar.Etale) (n : ℕ)
      (z : ↑((X_n n).obj.obj (Opposite.op W))) (j : Fin n) : ↑(𝒳.obj.obj (Opposite.op W)) :=
    ((Limits.biproduct.π (fun _ : Fin n => 𝒳) j).hom.app (Opposite.op W)) z

  have hFromToSec : ∀ (W : D_bar.Etale) (n : ℕ)
      (v : Fin n → ↑(𝒳.obj.obj (Opposite.op W))) (k : Fin n),
      fromSec W n (toSec W n v) k = v k := by
    intro W n v k
    dsimp [fromSec, toSec]
    rw [map_sum]
    have hterm : ∀ j : Fin n,
        ((Limits.biproduct.π (fun _ : Fin n => 𝒳) k).hom.app (Opposite.op W))
          (((Limits.biproduct.ι (fun _ : Fin n => 𝒳) j).hom.app (Opposite.op W)) (v j)) =
        if j = k then v k else 0 := by
      intro j
      change ((Limits.biproduct.ι (fun _ : Fin n => 𝒳) j ≫
        Limits.biproduct.π (fun _ : Fin n => 𝒳) k).hom.app (Opposite.op W)) (v j) = _
      rw [Limits.biproduct.ι_π]
      split_ifs with hjk
      · subst hjk; rfl
      · rfl
    simp_rw [hterm]
    simp

  have hToFromSec : ∀ (W : D_bar.Etale) (n : ℕ)
      (z : ↑((X_n n).obj.obj (Opposite.op W))),
      toSec W n (fromSec W n z) = z := by
    intro W n z
    dsimp [toSec, fromSec]
    have h1 : ∑ j : Fin n,
        ((Limits.biproduct.ι (fun _ : Fin n => 𝒳) j).hom.app (Opposite.op W))
          (((Limits.biproduct.π (fun _ : Fin n => 𝒳) j).hom.app (Opposite.op W)) z) =
        ((∑ j : Fin n, Limits.biproduct.π (fun _ : Fin n => 𝒳) j ≫
          Limits.biproduct.ι (fun _ : Fin n => 𝒳) j).hom.app (Opposite.op W)) z := by
      rw [hApp_sum0]
      rfl
    rw [h1, Limits.biproduct.total]
    rfl

  have hFromSec_map : ∀ {U W : D_bar.Etale} (u : U ⟶ W) (n : ℕ)
      (z : ↑((X_n n).obj.obj (Opposite.op W))) (j : Fin n),
      fromSec U n (((X_n n).obj.map (Opposite.op u)) z) j =
        (𝒳.obj.map (Opposite.op u)) (fromSec W n z j) := by
    intro U W u n z j
    have hnat := congrArg (fun φ => φ.hom z)
      ((Limits.biproduct.π (fun _ : Fin n => 𝒳) j).hom.naturality (Opposite.op u))
    exact hnat

  have hSec_Xn_ext : ∀ (W : D_bar.Etale) (n : ℕ)
      (z₁ z₂ : ↑((X_n n).obj.obj (Opposite.op W))),
      (∀ j : Fin n, fromSec W n z₁ j = fromSec W n z₂ j) → z₁ = z₂ := by
    intro W n z₁ z₂ h
    rw [← hToFromSec W n z₁, ← hToFromSec W n z₂]
    congr 1
    funext j
    exact h j

  have hMat_sec : ∀ (W : D_bar.Etale) {n m : ℕ} (P : Fin n → Fin m → (𝒳 ⟶ 𝒳))
      (v : Fin n → ↑(𝒳.obj.obj (Opposite.op W))) (i : Fin m),
      fromSec W m (((Limits.biproduct.matrix P).hom.app (Opposite.op W)) (toSec W n v)) i =
        ∑ j : Fin n, ((P j i).hom.app (Opposite.op W)) (v j) := by
    intro W n m P v i
    dsimp [fromSec, toSec]
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    change ((Limits.biproduct.ι (fun _ : Fin n => 𝒳) j ≫
      Limits.biproduct.matrix P ≫
      Limits.biproduct.π (fun _ : Fin m => 𝒳) i).hom.app (Opposite.op W)) (v j) = _
    rw [← Category.assoc, Limits.biproduct.ι_matrix, Limits.biproduct.lift_π]

  have hDesc_sec : ∀ (W : D_bar.Etale) {n : ℕ} {𝒴 : 𝒜} (p : Fin n → (𝒳 ⟶ 𝒴))
      (v : Fin n → ↑(𝒳.obj.obj (Opposite.op W))),
      ((Limits.biproduct.desc p).hom.app (Opposite.op W)) (toSec W n v) =
        ∑ j : Fin n, ((p j).hom.app (Opposite.op W)) (v j) := by
    intro W n 𝒴 p v
    dsimp [toSec]
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    change ((Limits.biproduct.ι (fun _ : Fin n => 𝒳) j ≫
      Limits.biproduct.desc p).hom.app (Opposite.op W)) (v j) = _
    rw [Limits.biproduct.ι_desc]

  let toF (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u}) (n : ℕ)
      (v : Fin n → ↑(F_ex.obj 𝒳)) : ↑(F_ex.obj (X_n n)) :=
    ∑ j : Fin n, (F_ex.map (Limits.biproduct.ι (fun _ : Fin n => 𝒳) j)).hom (v j)
  let fromF (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u}) (n : ℕ)
      (z : ↑(F_ex.obj (X_n n))) (j : Fin n) : ↑(F_ex.obj 𝒳) :=
    (F_ex.map (Limits.biproduct.π (fun _ : Fin n => 𝒳) j)).hom z

  have hFromToF : ∀ (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u}) [F_ex.Additive]
      (n : ℕ) (v : Fin n → ↑(F_ex.obj 𝒳)) (k : Fin n),
      fromF F_ex n (toF F_ex n v) k = v k := by
    intro F_ex _ n v k
    dsimp [fromF, toF]
    rw [map_sum]
    have hterm : ∀ j : Fin n,
        (F_ex.map (Limits.biproduct.π (fun _ : Fin n => 𝒳) k)).hom
          ((F_ex.map (Limits.biproduct.ι (fun _ : Fin n => 𝒳) j)).hom (v j)) =
        if j = k then v k else 0 := by
      intro j
      change ((F_ex.map (Limits.biproduct.ι (fun _ : Fin n => 𝒳) j) ≫
        F_ex.map (Limits.biproduct.π (fun _ : Fin n => 𝒳) k)).hom) (v j) = _
      rw [← F_ex.map_comp, Limits.biproduct.ι_π]
      split_ifs with hjk
      · subst hjk
        simp
      · rw [F_ex.map_zero]
        rfl
    simp_rw [hterm]
    simp

  have hToFromF : ∀ (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u}) [F_ex.Additive]
      (n : ℕ) (z : ↑(F_ex.obj (X_n n))),
      toF F_ex n (fromF F_ex n z) = z := by
    intro F_ex _ n z
    dsimp [toF, fromF]
    let evZ : (X_n n ⟶ X_n n) →+ ↑(F_ex.obj (X_n n)) :=
      { toFun := fun φ => (F_ex.map φ).hom z
        map_zero' := by rw [F_ex.map_zero]; rfl
        map_add' := fun a b => by rw [F_ex.map_add]; rfl }
    have h1 : ∑ j : Fin n,
        (F_ex.map (Limits.biproduct.ι (fun _ : Fin n => 𝒳) j)).hom
          ((F_ex.map (Limits.biproduct.π (fun _ : Fin n => 𝒳) j)).hom z) =
        evZ (∑ j : Fin n, Limits.biproduct.π (fun _ : Fin n => 𝒳) j ≫
          Limits.biproduct.ι (fun _ : Fin n => 𝒳) j) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      change _ = (F_ex.map (_ ≫ _)).hom z
      rw [F_ex.map_comp]
      rfl
    rw [h1, Limits.biproduct.total]
    change (F_ex.map (𝟙 (X_n n))).hom z = z
    rw [F_ex.map_id]
    rfl

  have hMat_F : ∀ (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u}) [F_ex.Additive]
      {n m : ℕ} (P : Fin n → Fin m → (𝒳 ⟶ 𝒳)) (v : Fin n → ↑(F_ex.obj 𝒳)) (i : Fin m),
      fromF F_ex m ((F_ex.map (Limits.biproduct.matrix P)).hom (toF F_ex n v)) i =
        ∑ j : Fin n, (F_ex.map (P j i)).hom (v j) := by
    intro F_ex _ n m P v i
    dsimp [fromF, toF]
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    change ((F_ex.map (Limits.biproduct.ι (fun _ : Fin n => 𝒳) j) ≫
      F_ex.map (Limits.biproduct.matrix P) ≫
      F_ex.map (Limits.biproduct.π (fun _ : Fin m => 𝒳) i)).hom) (v j) = _
    rw [← F_ex.map_comp, ← F_ex.map_comp, ← Category.assoc,
      Limits.biproduct.ι_matrix, Limits.biproduct.lift_π]

  have hDesc_F : ∀ (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u}) [F_ex.Additive]
      {n : ℕ} {𝒴 : 𝒜} (p : Fin n → (𝒳 ⟶ 𝒴)) (v : Fin n → ↑(F_ex.obj 𝒳)),
      (F_ex.map (Limits.biproduct.desc p)).hom (toF F_ex n v) =
        ∑ j : Fin n, (F_ex.map (p j)).hom (v j) := by
    intro F_ex _ n 𝒴 p v
    dsimp [toF]
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    change ((F_ex.map (Limits.biproduct.ι (fun _ : Fin n => 𝒳) j) ≫
      F_ex.map (Limits.biproduct.desc p)).hom) (v j) = _
    rw [← F_ex.map_comp, Limits.biproduct.ι_desc]

  let m_W (W : D_bar.Etale) (h : Γ) :
      Limits.pullback (Fgt.obj W).hom ι_bar ⟶ Limits.pullback (Fgt.obj W).hom ι_bar :=
    Limits.pullback.lift
      (Limits.pullback.fst (Fgt.obj W).hom ι_bar)
      (Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ d h)
      (by rw [Category.assoc, hd_ι h, Limits.pullback.condition])

  have hm_W_fst : ∀ (W : D_bar.Etale) (h : Γ),
      m_W W h ≫ Limits.pullback.fst (Fgt.obj W).hom ι_bar =
        Limits.pullback.fst (Fgt.obj W).hom ι_bar :=
    fun W h => Limits.pullback.lift_fst _ _ _

  have hm_W_snd : ∀ (W : D_bar.Etale) (h : Γ),
      m_W W h ≫ Limits.pullback.snd (Fgt.obj W).hom ι_bar =
        Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ d h :=
    fun W h => Limits.pullback.lift_snd _ _ _

  have hm_W_comp : ∀ (W : D_bar.Etale) (h₁ h₂ : Γ),
      m_W W h₁ ≫ m_W W h₂ = m_W W (h₂ * h₁) := by
    intro W h₁ h₂
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hm_W_fst, hm_W_fst, hm_W_fst]
    · rw [Category.assoc, hm_W_snd, ← Category.assoc, hm_W_snd, Category.assoc,
        ← hd_mul h₂ h₁, hm_W_snd]

  have hm_W_apply : ∀ (W : D_bar.Etale) (h₁ h₂ : Γ)
      (y : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)),
      (m_W W h₂).base ((m_W W h₁).base y) = (m_W W (h₂ * h₁)).base y := by
    intro W h₁ h₂ y
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hm_W_comp]

  have hρ_mul : ∀ g₁ g₂ : Γ, ρ_X g₁ ≫ ρ_X g₂ = ρ_X (g₂ * g₁) := by
    intro g₁ g₂
    apply hSheaf_ext
    intro W sec
    apply (htriv_X_spec W).1
    ext y
    change triv_X W (((ρ_X g₂).hom.app (Opposite.op W))
      (((ρ_X g₁).hom.app (Opposite.op W)) sec)) y = _
    rw [hρ_X_spec g₂ W (m_W W g₂⁻¹) (hm_W_fst W _) (hm_W_snd W _),
      hρ_X_spec g₁ W (m_W W g₁⁻¹) (hm_W_fst W _) (hm_W_snd W _),
      hm_W_apply W g₂⁻¹ g₁⁻¹, ← mul_inv_rev g₂ g₁,
      ← hρ_X_spec (g₂ * g₁) W (m_W W (g₂ * g₁)⁻¹) (hm_W_fst W _) (hm_W_snd W _)]

  have hCollar_etale : ∀ (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens),
      AlgebraicGeometry.Etale (W₀.ι ≫ (Fgt.obj W).hom) := by
    intro W W₀
    have : AlgebraicGeometry.Etale (Fgt.obj W).hom := W.prop
    exact inferInstance

  let U_col (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens) : D_bar.Etale :=
    letI : AlgebraicGeometry.Etale (W₀.ι ≫ (Fgt.obj W).hom) := hCollar_etale W W₀
    AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ (Fgt.obj W).hom)

  have hu_col_ex : ∀ (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens),
      ∃ u : U_col W W₀ ⟶ W, (Fgt.map u).left = W₀.ι :=
    fun W W₀ => ⟨CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial, rfl⟩

  let u_col (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens) : U_col W W₀ ⟶ W :=
    Classical.choose (hu_col_ex W W₀)

  have hu_col_left : ∀ (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens),
      (Fgt.map (u_col W W₀)).left = W₀.ι :=
    fun W W₀ => Classical.choose_spec (hu_col_ex W W₀)

  have hu_col_etale : ∀ (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens),
      AlgebraicGeometry.Etale (Fgt.map (u_col W W₀)).left := by
    intro W W₀
    have h : AlgebraicGeometry.Etale W₀.ι := inferInstance
    rw [hu_col_left]
    exact h

  have hu_col_mem : ∀ (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens)
      (x : ↥(Fgt.obj (U_col W W₀)).left),
      ((Fgt.map (u_col W W₀)).left).base x ∈ W₀ := by
    intro W W₀ x
    have hW₀_range : Set.range W₀.ι.base = (W₀ : Set (Fgt.obj W).left) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    have hrange : Set.range ((Fgt.map (u_col W W₀)).left).base = (W₀ : Set (Fgt.obj W).left) := by
      rw [hu_col_left]
      exact hW₀_range
    change ((Fgt.map (u_col W W₀)).left).base x ∈ (W₀ : Set (Fgt.obj W).left)
    rw [← hrange]
    exact ⟨x, rfl⟩

  have hCollar_zero_X : ∀ (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens)
      (sec : ↑(𝒳.obj.obj (Opposite.op W))),
      (∀ y, (Limits.pullback.fst (Fgt.obj W).hom ι_bar).base y ∈ W₀ → triv_X W sec y = 0) →
      (𝒳.obj.map (Opposite.op (u_col W W₀))) sec = 0 := by
    intro W W₀ sec hzero
    apply (htriv_X_spec (U_col W W₀)).1
    ext y₁
    change triv_X (U_col W W₀) ((𝒳.obj.map (Opposite.op (u_col W W₀))) sec) y₁ =
      (triv_X (U_col W W₀) 0) y₁
    rw [map_zero]
    let h₁ := (Fgt.obj (U_col W W₀)).hom
    let h₂ := (Fgt.obj W).hom
    let u_V : Limits.pullback h₁ ι_bar ⟶ Limits.pullback h₂ ι_bar :=
      Limits.pullback.lift
        (Limits.pullback.fst h₁ ι_bar ≫ (Fgt.map (u_col W W₀)).left)
        (Limits.pullback.snd h₁ ι_bar)
        (by
          rw [Category.assoc, Over.w (Fgt.map (u_col W W₀))]
          exact Limits.pullback.condition)
    have hnat := htriv_X_nat (u_col W W₀) u_V (Limits.pullback.lift_fst _ _ _)
      (Limits.pullback.lift_snd _ _ _) sec y₁
    have hz : triv_X W sec (u_V.base y₁) = 0 := by
      apply hzero
      have hpt : (Limits.pullback.fst h₂ ι_bar).base (u_V.base y₁) =
          ((Fgt.map (u_col W W₀)).left).base ((Limits.pullback.fst h₁ ι_bar).base y₁) := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          Limits.pullback.lift_fst, AlgebraicGeometry.Scheme.Hom.comp_apply]
      rw [hpt]
      exact hu_col_mem W W₀ ((Limits.pullback.fst h₁ ι_bar).base y₁)
    exact hnat.trans hz

  have hCollar_zero_Js : ∀ (W : D_bar.Etale) (W₀ : (Fgt.obj W).left.Opens)
      (sec : ↑(𝒥_s.obj.obj (Opposite.op W))),
      (∀ y, (Limits.pullback.fst (Fgt.obj W).hom ι_bar).base y ∈ W₀ → triv_Js W sec y = 0) →
      (𝒥_s.obj.map (Opposite.op (u_col W W₀))) sec = 0 := by
    intro W W₀ sec hzero
    apply (htriv_Js_spec (U_col W W₀)).1
    ext y₁ k
    change triv_Js (U_col W W₀) ((𝒥_s.obj.map (Opposite.op (u_col W W₀))) sec) y₁ k =
      (triv_Js (U_col W W₀) 0) y₁ k
    rw [map_zero]
    let h₁ := (Fgt.obj (U_col W W₀)).hom
    let h₂ := (Fgt.obj W).hom
    let u_V : Limits.pullback h₁ ι_bar ⟶ Limits.pullback h₂ ι_bar :=
      Limits.pullback.lift
        (Limits.pullback.fst h₁ ι_bar ≫ (Fgt.map (u_col W W₀)).left)
        (Limits.pullback.snd h₁ ι_bar)
        (by
          rw [Category.assoc, Over.w (Fgt.map (u_col W W₀))]
          exact Limits.pullback.condition)
    have hnat := htriv_Js_nat (u_col W W₀) u_V (Limits.pullback.lift_fst _ _ _)
      (Limits.pullback.lift_snd _ _ _) sec y₁
    have hz : triv_Js W sec (u_V.base y₁) = 0 := by
      apply hzero
      have hpt : (Limits.pullback.fst h₂ ι_bar).base (u_V.base y₁) =
          ((Fgt.map (u_col W W₀)).left).base ((Limits.pullback.fst h₁ ι_bar).base y₁) := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          Limits.pullback.lift_fst, AlgebraicGeometry.Scheme.Hom.comp_apply]
      rw [hpt]
      exact hu_col_mem W W₀ ((Limits.pullback.fst h₁ ι_bar).base y₁)
    exact congrArg (fun f => f k) (hnat.trans hz)

  have hW'_etale : ∀ W : D_bar.Etale,
      AlgebraicGeometry.Etale (Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ ι_bar) := by
    intro W
    have : AlgebraicGeometry.Etale (Fgt.obj W).hom := W.prop
    have : AlgebraicGeometry.Etale ι_bar := hEt_ι
    exact inferInstance

  let W'_et (W : D_bar.Etale) : D_bar.Etale :=
    letI : AlgebraicGeometry.Etale (Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ ι_bar) :=
      hW'_etale W
    AlgebraicGeometry.Scheme.Etale.mk (Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ ι_bar)

  have hu'_et_ex : ∀ W : D_bar.Etale,
      ∃ u : W'_et W ⟶ W, (Fgt.map u).left = Limits.pullback.fst (Fgt.obj W).hom ι_bar :=
    fun W => ⟨CategoryTheory.MorphismProperty.Over.homMk
      (Limits.pullback.fst (Fgt.obj W).hom ι_bar) Limits.pullback.condition trivial, rfl⟩

  let u'_et (W : D_bar.Etale) : W'_et W ⟶ W :=
    Classical.choose (hu'_et_ex W)

  have hu'_et_left : ∀ W : D_bar.Etale,
      (Fgt.map (u'_et W)).left = Limits.pullback.fst (Fgt.obj W).hom ι_bar :=
    fun W => Classical.choose_spec (hu'_et_ex W)

  have hu'_et_etale : ∀ W : D_bar.Etale,
      AlgebraicGeometry.Etale (Fgt.map (u'_et W)).left := by
    intro W
    have : AlgebraicGeometry.Etale ι_bar := hEt_ι
    have h : AlgebraicGeometry.Etale (Limits.pullback.fst (Fgt.obj W).hom ι_bar) := inferInstance
    rw [hu'_et_left]
    exact h

  have hLift_pt : ∀ (W : D_bar.Etale) (p : ↥(Fgt.obj W).left),
      p ∈ (TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U_bar →
      ∃ q' : ↥(Fgt.obj (W'_et W)).left, (Fgt.map (u'_et W)).left.base q' = p := by
    intro W p hp
    have hpU : (Fgt.obj W).hom.base p ∈ (U_bar : Set D_bar) := hp
    rw [← hRange_ι] at hpU
    rcases hpU with ⟨v, hv⟩
    obtain ⟨q', hq'_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback p v hv.symm
    refine ⟨q', ?_⟩
    rw [hu'_et_left]
    exact hq'_fst

  let δ_W (W : D_bar.Etale) :
      Γ → (Limits.pullback (Fgt.obj W).hom ι_bar ⟶
        Limits.pullback (Fgt.obj (W'_et W)).hom ι_bar) :=
    Classical.choose (hSheets (Limits.pullback (Fgt.obj W).hom ι_bar)
      (Limits.pullback.snd (Fgt.obj W).hom ι_bar))

  have hδ_W_spec : ∀ W : D_bar.Etale,
      (∀ σ : Γ,
        δ_W W σ ≫ Limits.pullback.fst (Fgt.obj (W'_et W)).hom ι_bar =
          𝟙 (Limits.pullback (Fgt.obj W).hom ι_bar) ∧
        δ_W W σ ≫ Limits.pullback.snd (Fgt.obj (W'_et W)).hom ι_bar =
          Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ d σ ∧
        AlgebraicGeometry.Etale (δ_W W σ) ∧
        IsOpen (Set.range (δ_W W σ).base)) ∧
      (∀ σ₁ σ₂ : Γ, σ₁ ≠ σ₂ →
        Disjoint (Set.range (δ_W W σ₁).base) (Set.range (δ_W W σ₂).base)) ∧
      (⋃ σ : Γ, Set.range (δ_W W σ).base) = Set.univ :=
    fun W => Classical.choose_spec (hSheets (Limits.pullback (Fgt.obj W).hom ι_bar)
      (Limits.pullback.snd (Fgt.obj W).hom ι_bar))

  have hδ_m : ∀ (W : D_bar.Etale) (σ τ : Γ) (w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)),
      (m_W (W'_et W) σ).base ((δ_W W τ).base w) = (δ_W W (σ * τ)).base w := by
    intro W σ τ w
    have hhom : δ_W W τ ≫ m_W (W'_et W) σ = δ_W W (σ * τ) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hm_W_fst (W'_et W) σ]
        exact ((hδ_W_spec W).1 τ).1.trans ((hδ_W_spec W).1 (σ * τ)).1.symm
      · rw [Category.assoc, hm_W_snd (W'_et W) σ, ← Category.assoc,
          ((hδ_W_spec W).1 τ).2.1, Category.assoc, ← hd_mul σ τ,
          ((hδ_W_spec W).1 (σ * τ)).2.1]
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hhom]

  have hSheet_surj : ∀ (W : D_bar.Etale)
      (y : ↥(Limits.pullback (Fgt.obj (W'_et W)).hom ι_bar)),
      ∃ (σ : Γ) (w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)), y = (δ_W W σ).base w := by
    intro W y
    have hy_univ : y ∈ (⋃ σ : Γ, Set.range (δ_W W σ).base) := by
      rw [(hδ_W_spec W).2.2]
      trivial
    rw [Set.mem_iUnion] at hy_univ
    rcases hy_univ with ⟨σ, w, rfl⟩
    exact ⟨σ, w, rfl⟩

  have hSec_ext_W' : ∀ (W : D_bar.Etale)
      (s₁ s₂ : ↑(𝒳.obj.obj (Opposite.op (W'_et W)))),
      (∀ (τ : Γ) (w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)),
        triv_X (W'_et W) s₁ ((δ_W W τ).base w) = triv_X (W'_et W) s₂ ((δ_W W τ).base w)) →
      s₁ = s₂ := by
    intro W s₁ s₂ h
    apply (htriv_X_spec (W'_et W)).1
    ext y
    rcases hSheet_surj W y with ⟨τ, w, rfl⟩
    exact h τ w

  have hMkSec : ∀ (W : D_bar.Etale)
      (g_fam : Γ → LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar) (ZMod (ℓ ^ K))),
      ∃ sec : ↑(𝒳.obj.obj (Opposite.op (W'_et W))),
        ∀ (τ : Γ) (w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)),
          triv_X (W'_et W) sec ((δ_W W τ).base w) = g_fam τ w := by
    intro W g_fam
    let P' := Limits.pullback (Fgt.obj (W'_et W)).hom ι_bar
    let fst' := Limits.pullback.fst (Fgt.obj (W'_et W)).hom ι_bar
    have hEx : ∀ y : ↥P', ∃ σ : Γ, y ∈ Set.range (δ_W W σ).base := by
      intro y
      rcases hSheet_surj W y with ⟨σ, w, rfl⟩
      exact ⟨σ, w, rfl⟩
    let sheetOf : ↥P' → Γ := fun y => Classical.choose (hEx y)
    have hSheetOf_mem : ∀ y : ↥P', y ∈ Set.range (δ_W W (sheetOf y)).base :=
      fun y => Classical.choose_spec (hEx y)
    have hSheetOf_eq : ∀ {y : ↥P'} {σ : Γ}, y ∈ Set.range (δ_W W σ).base → sheetOf y = σ := by
      intro y σ hy
      by_contra hne
      exact Set.disjoint_left.mp ((hδ_W_spec W).2.1 (sheetOf y) σ hne) (hSheetOf_mem y) hy
    let glueFn : ↥P' → ZMod (ℓ ^ K) := fun y => g_fam (sheetOf y) (fst'.base y)
    have hLC : IsLocallyConstant glueFn := by
      rw [IsLocallyConstant.iff_exists_open]
      intro y
      set σ := sheetOf y
      obtain ⟨U₀, hU₀_open, hy_U₀, hU₀_eq⟩ :=
        (IsLocallyConstant.iff_exists_open (g_fam σ)).mp (g_fam σ).isLocallyConstant (fst'.base y)
      refine ⟨(fst'.base ⁻¹' U₀) ∩ Set.range (δ_W W σ).base,
        (hU₀_open.preimage (AlgebraicGeometry.Scheme.Hom.continuous fst')).inter
          ((hδ_W_spec W).1 σ).2.2.2,
        ⟨hy_U₀, hSheetOf_mem y⟩, ?_⟩
      rintro y' ⟨hy'_U₀, hy'_σ⟩
      dsimp [glueFn]
      rw [hSheetOf_eq hy'_σ, hU₀_eq (fst'.base y') hy'_U₀]
    let glueLC : LocallyConstant ↥P' (ZMod (ℓ ^ K)) := ⟨glueFn, hLC⟩
    have hRange : glueLC ∈ Set.range (triv_X (W'_et W)) := by
      rw [(htriv_X_spec (W'_et W)).2]
      refine ⟨⊥, ?_, fun y hy => False.elim hy⟩
      rw [sup_bot_eq]
      refine TopologicalSpace.Opens.ext (Set.eq_univ_of_forall fun w => ?_)
      let w' : ↥(Limits.pullback (Fgt.obj W).hom ι_bar) := w
      change (Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ ι_bar).base w' ∈ (U_bar : Set D_bar)
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, ← hRange_ι]
      exact ⟨_, rfl⟩
    rcases hRange with ⟨sec, hsec⟩
    refine ⟨sec, fun τ w => ?_⟩
    rw [hsec]
    change g_fam (sheetOf ((δ_W W τ).base w)) (fst'.base ((δ_W W τ).base w)) = g_fam τ w
    have h1 : sheetOf ((δ_W W τ).base w) = τ := hSheetOf_eq ⟨w, rfl⟩
    have h2 : fst'.base ((δ_W W τ).base w) = w := by
      dsimp [fst']
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ((hδ_W_spec W).1 τ).1]
      rfl
    rw [h1, h2]

  let actR (r : MonoidAlgebra (ZMod (ℓ ^ K)) Γ) : 𝒳 ⟶ 𝒳 :=
    r.coeff.sum (fun g c_g => c_g.val • ρ_X g)

  have hActR_sum : ∀ r : MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
      actR r = ∑ g : Γ, (r.coeff g).val • ρ_X g := by
    intro r
    dsimp [actR]
    exact Finsupp.sum_fintype r.coeff _ (fun g => by simp)

  have hActR_zero : actR 0 = 0 := by
    rw [hActR_sum]
    simp

  have hActR_add : ∀ r₁ r₂ : MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
      actR (r₁ + r₂) = actR r₁ + actR r₂ := by
    intro r₁ r₂
    rw [hActR_sum, hActR_sum, hActR_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun g _ => ?_
    change (r₁.coeff g + r₂.coeff g).val • ρ_X g = _
    exact hZMod_add_hom (ρ_X g) (r₁.coeff g) (r₂.coeff g)

  have hActR_single : ∀ (g : Γ) (c : ZMod (ℓ ^ K)),
      actR (MonoidAlgebra.single g c) = c.val • ρ_X g := by
    intro g c
    dsimp [actR]
    exact Finsupp.sum_single_index (by simp)

  have hMA_sum_single : ∀ r : MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
      ∑ g : Γ, MonoidAlgebra.single g (r.coeff g) = r := by
    intro r
    ext h
    simp [MonoidAlgebra.coeff_single]

  have hActR_mul : ∀ r₁ r₂ : MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
      actR (r₂ * r₁) = actR r₁ ≫ actR r₂ := by
    intro r₁ r₂
    let actRHom : MonoidAlgebra (ZMod (ℓ ^ K)) Γ →+ (𝒳 ⟶ 𝒳) :=
      { toFun := actR
        map_zero' := hActR_zero
        map_add' := hActR_add }
    conv_lhs => rw [← hMA_sum_single r₁, ← hMA_sum_single r₂, Finset.sum_mul]
    change actRHom (∑ g₂ : Γ, (MonoidAlgebra.single g₂ (r₂.coeff g₂)) *
      ∑ g₁ : Γ, MonoidAlgebra.single g₁ (r₁.coeff g₁)) = _
    rw [map_sum]
    conv_rhs => rw [← hMA_sum_single r₁, ← hMA_sum_single r₂]
    change _ = actRHom (∑ g₁ : Γ, MonoidAlgebra.single g₁ (r₁.coeff g₁)) ≫
      actRHom (∑ g₂ : Γ, MonoidAlgebra.single g₂ (r₂.coeff g₂))
    rw [map_sum, map_sum, Preadditive.comp_sum]
    refine Finset.sum_congr rfl fun g₂ _ => ?_
    rw [Finset.mul_sum, map_sum, Preadditive.sum_comp]
    refine Finset.sum_congr rfl fun g₁ _ => ?_
    change actR (MonoidAlgebra.single g₂ (r₂.coeff g₂) *
      MonoidAlgebra.single g₁ (r₁.coeff g₁)) =
      actR (MonoidAlgebra.single g₁ (r₁.coeff g₁)) ≫
        actR (MonoidAlgebra.single g₂ (r₂.coeff g₂))
    rw [MonoidAlgebra.single_mul_single, hActR_single, hActR_single, hActR_single,
      mul_comm (r₂.coeff g₂) (r₁.coeff g₁), ← hρ_mul g₁ g₂,
      hZMod_mul_hom (ρ_X g₁ ≫ ρ_X g₂),
      Preadditive.nsmul_comp, Preadditive.comp_nsmul]

  have hPart1 : ∀ (F_ex : CategoryTheory.Functor 𝒜 AddCommGrpCat.{u})
      [F_ex.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F_ex],
      (∀ {ℱ₁ ℱ₂ : 𝒜} (π : Quiver.Hom ℱ₁ ℱ₂),
        (ℓ ^ K : ℕ) • CategoryTheory.CategoryStruct.id ℱ₁ = 0 →
        CategoryTheory.Epi π →
        Function.Surjective (F_ex.map π).hom) →
      ∀ (a b c : ℕ)
        (B_eq : Fin c → Fin b → MonoidAlgebra (ZMod (ℓ ^ K)) Γ)
        (A_eq : Fin b → Fin a → MonoidAlgebra (ZMod (ℓ ^ K)) Γ),
        (∀ u : Fin b → MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
          (∀ i : Fin a, ∑ j : Fin b, A_eq j i * u j = 0) ↔
          ∃ w : Fin c → MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
            ∀ j : Fin b, u j = ∑ k : Fin c, B_eq k j * w k) →
        ∀ x : Fin b → ↑(F_ex.obj 𝒳),
          (∀ i : Fin a,
            ∑ j : Fin b,
              (A_eq j i).coeff.sum
                (fun g c_g => c_g.val • (F_ex.map (ρ_X g)).hom (x j)) = 0) ↔
          ∃ z : Fin c → ↑(F_ex.obj 𝒳),
            ∀ j : Fin b,
              x j = ∑ k : Fin c,
                (B_eq k j).coeff.sum
                  (fun g c_g => c_g.val • (F_ex.map (ρ_X g)).hom (z k)) := by
    intro F_ex _ _ hSurj_ex a b c B_eq A_eq h_eq x
    let Φ_B : Fin c → Fin b → (𝒳 ⟶ 𝒳) := fun k j => actR (B_eq k j)
    let Φ_A : Fin b → Fin a → (𝒳 ⟶ 𝒳) := fun j i => actR (A_eq j i)
    let f_B : X_n c ⟶ X_n b := Limits.biproduct.matrix Φ_B
    let f_A : X_n b ⟶ X_n a := Limits.biproduct.matrix Φ_A
    have hf_BA0 : f_B ≫ f_A = 0 := by
      apply Limits.biproduct.hom_ext'
      intro k
      apply Limits.biproduct.hom_ext
      intro i
      rw [Limits.comp_zero, Limits.zero_comp, ← Category.assoc, Limits.biproduct.ι_matrix]
      have hAB_zero : ∑ j : Fin b, A_eq j i * B_eq k j = 0 := by
        have hcol := (h_eq (fun j => B_eq k j)).mpr ⟨Pi.single k 1, fun j => by
          simp [Pi.single_apply]⟩
        exact hcol i
      have h_entry : (Limits.biproduct.lift fun j => Φ_B k j) ≫ f_A ≫
          Limits.biproduct.π (fun _ : Fin a => 𝒳) i =
          ∑ j : Fin b, Φ_B k j ≫ Φ_A j i := by
        have htot : 𝟙 (X_n b) = ∑ j : Fin b,
            Limits.biproduct.π (fun _ : Fin b => 𝒳) j ≫
              Limits.biproduct.ι (fun _ : Fin b => 𝒳) j := Limits.biproduct.total.symm
        calc (Limits.biproduct.lift fun j => Φ_B k j) ≫ f_A ≫
              Limits.biproduct.π (fun _ : Fin a => 𝒳) i
            = (Limits.biproduct.lift fun j => Φ_B k j) ≫ 𝟙 (X_n b) ≫ f_A ≫
                Limits.biproduct.π (fun _ : Fin a => 𝒳) i := by
                rw [Category.id_comp]
          _ = (Limits.biproduct.lift fun j => Φ_B k j) ≫
                (∑ j : Fin b,
                  Limits.biproduct.π (fun _ : Fin b => 𝒳) j ≫
                    Limits.biproduct.ι (fun _ : Fin b => 𝒳) j) ≫
                f_A ≫ Limits.biproduct.π (fun _ : Fin a => 𝒳) i := by
                rw [htot]
          _ = ∑ j : Fin b,
                ((Limits.biproduct.lift fun j' => Φ_B k j') ≫
                  Limits.biproduct.π (fun _ : Fin b => 𝒳) j) ≫
                  (Limits.biproduct.ι (fun _ : Fin b => 𝒳) j ≫ f_A) ≫
                    Limits.biproduct.π (fun _ : Fin a => 𝒳) i := by
                rw [Preadditive.sum_comp, Preadditive.comp_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                simp only [Category.assoc]
          _ = ∑ j : Fin b, Φ_B k j ≫ Φ_A j i := by
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [Limits.biproduct.lift_π, Limits.biproduct.ι_matrix, Limits.biproduct.lift_π]
      rw [Category.assoc, h_entry]
      let actRHom : MonoidAlgebra (ZMod (ℓ ^ K)) Γ →+ (𝒳 ⟶ 𝒳) :=
        { toFun := actR, map_zero' := hActR_zero, map_add' := hActR_add }
      calc ∑ j : Fin b, actR (B_eq k j) ≫ actR (A_eq j i)
          = ∑ j : Fin b, actRHom (A_eq j i * B_eq k j) := by
              refine Finset.sum_congr rfl fun j _ => (hActR_mul (B_eq k j) (A_eq j i)).symm
        _ = actRHom (∑ j : Fin b, A_eq j i * B_eq k j) := (map_sum actRHom _ _).symm
        _ = actRHom 0 := by rw [hAB_zero]
        _ = 0 := map_zero actRHom
    have hloc_syz : ∀ (W : D_bar.Etale) (s₂ : ↑((X_n b).obj.obj (Opposite.op W))),
        (f_A.hom.app (Opposite.op W)) s₂ = 0 →
        ∀ p : ↥(Fgt.obj W).left,
          ∃ (U : D_bar.Etale) (u : U ⟶ W) (q : ↥(Fgt.obj U).left)
            (s₁ : ↑((X_n c).obj.obj (Opposite.op U))),
            AlgebraicGeometry.Etale (Fgt.map u).left ∧
            (Fgt.map u).left.base q = p ∧
            (f_B.hom.app (Opposite.op U)) s₁ = ((X_n b).obj.map (Opposite.op u)) s₂ := by
      intro W s₂ hs₂ p
      let sb : Fin b → ↑(𝒳.obj.obj (Opposite.op W)) := fromSec W b s₂
      have hsb_eq : toSec W b sb = s₂ := hToFromSec W b s₂
      have hsb_ker : ∀ i : Fin a,
          ∑ j : Fin b, ((actR (A_eq j i)).hom.app (Opposite.op W)) (sb j) = 0 := by
        intro i
        have h1 := hMat_sec W Φ_A sb i
        rw [hsb_eq, hs₂] at h1
        dsimp [fromSec] at h1
        rw [map_zero] at h1
        exact h1.symm
      have hCol_ex : ∀ j : Fin b,
          ∃ W₀ : (Fgt.obj W).left.Opens,
            ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U_bar) ⊔ W₀ = ⊤ ∧
            ∀ y, (Limits.pullback.fst (Fgt.obj W).hom ι_bar).base y ∈ W₀ →
              triv_X W (sb j) y = 0 := by
        intro j
        have hmem : triv_X W (sb j) ∈ Set.range (triv_X W) := ⟨sb j, rfl⟩
        rwa [(htriv_X_spec W).2] at hmem
      let W₀_j : Fin b → (Fgt.obj W).left.Opens := fun j => Classical.choose (hCol_ex j)
      let W₀ : (Fgt.obj W).left.Opens := Finset.univ.inf W₀_j
      have hcov : ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U_bar) ⊔ W₀ = ⊤ :=
        hSup_inf _ W₀_j (fun j => (Classical.choose_spec (hCol_ex j)).1)
      have hp_top : p ∈ (((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U_bar) ⊔ W₀ :
          (Fgt.obj W).left.Opens) := by
        rw [hcov]
        trivial
      rcases hp_top with hpU | hpW₀
      · obtain ⟨q', hq'⟩ := hLift_pt W p hpU
        let W_V := Limits.pullback (Fgt.obj W).hom ι_bar
        let R_K := MonoidAlgebra (ZMod (ℓ ^ K)) Γ
        let sb' : Fin b → ↑(𝒳.obj.obj (Opposite.op (W'_et W))) :=
          fun j => (𝒳.obj.map (Opposite.op (u'_et W))) (sb j)
        have hsb'_ker : ∀ i : Fin a,
            ∑ j : Fin b, ((actR (A_eq j i)).hom.app (Opposite.op (W'_et W))) (sb' j) = 0 := by
          intro i
          have hstep : ∀ j : Fin b,
              ((actR (A_eq j i)).hom.app (Opposite.op (W'_et W))) (sb' j) =
                (𝒳.obj.map (Opposite.op (u'_et W)))
                  (((actR (A_eq j i)).hom.app (Opposite.op W)) (sb j)) := by
            intro j
            have hnat := congrArg (fun φ => φ.hom (sb j))
              ((actR (A_eq j i)).hom.naturality (Opposite.op (u'_et W)))
            exact hnat
          simp_rw [hstep]
          exact ((map_sum (𝒳.obj.map (Opposite.op (u'_et W))).hom _ _).symm.trans
            (congrArg (𝒳.obj.map (Opposite.op (u'_et W))).hom (hsb_ker i))).trans
            (map_zero (𝒳.obj.map (Opposite.op (u'_et W))).hom)
        let Φ_fn (sec : ↑(𝒳.obj.obj (Opposite.op (W'_et W)))) : LocallyConstant ↥W_V R_K :=
          ∑ h : Γ,
            LocallyConstant.map (MonoidAlgebra.single h)
              ((triv_X (W'_et W) sec).comap (δ_W W h).base.hom)
        have hΦ_fn_coeff : ∀ (sec : ↑(𝒳.obj.obj (Opposite.op (W'_et W)))) (w : ↥W_V) (τ : Γ),
            (Φ_fn sec w).coeff τ = triv_X (W'_et W) sec ((δ_W W τ).base w) := by
          intro sec w τ
          dsimp [Φ_fn]
          rw [hLC_sum_RK]
          let coeff_τ : R_K →+ ZMod (ℓ ^ K) :=
            { toFun := fun r => r.coeff τ, map_zero' := rfl, map_add' := fun _ _ => rfl }
          change coeff_τ (∑ h : Γ,
            MonoidAlgebra.single h (triv_X (W'_et W) sec ((δ_W W h).base w))) = _
          rw [map_sum]
          have hc : ∀ h : Γ,
              coeff_τ (MonoidAlgebra.single h (triv_X (W'_et W) sec ((δ_W W h).base w))) =
                if h = τ then triv_X (W'_et W) sec ((δ_W W h).base w) else 0 := by
            intro h
            change (MonoidAlgebra.single h _).coeff τ = _
            rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
          simp_rw [hc]
          simp
        let Φ : ↑(𝒳.obj.obj (Opposite.op (W'_et W))) →+ LocallyConstant ↥W_V R_K :=
          { toFun := Φ_fn
            map_zero' := by
              ext w τ
              change (Φ_fn 0 w).coeff τ = 0
              rw [hΦ_fn_coeff, map_zero (triv_X (W'_et W))]
              rfl
            map_add' := fun s₁ s₂ => by
              ext w τ
              change (Φ_fn (s₁ + s₂) w).coeff τ = (Φ_fn s₁ w).coeff τ + (Φ_fn s₂ w).coeff τ
              rw [hΦ_fn_coeff, hΦ_fn_coeff, hΦ_fn_coeff, map_add]
              rfl }
        have hΦ_coeff : ∀ (sec : ↑(𝒳.obj.obj (Opposite.op (W'_et W)))) (w : ↥W_V) (τ : Γ),
            (Φ sec w).coeff τ = triv_X (W'_et W) sec ((δ_W W τ).base w) := hΦ_fn_coeff
        have hΦ_actR : ∀ (r : R_K) (sec : ↑(𝒳.obj.obj (Opposite.op (W'_et W)))) (w : ↥W_V),
            Φ (((actR r).hom.app (Opposite.op (W'_et W))) sec) w = r * Φ sec w := by
          intro r sec w
          have hΦ_ρ : ∀ g : Γ,
              Φ (((ρ_X g).hom.app (Opposite.op (W'_et W))) sec) w =
                MonoidAlgebra.single g 1 * Φ sec w := by
            intro g
            ext τ
            change (Φ (((ρ_X g).hom.app (Opposite.op (W'_et W))) sec) w).coeff τ =
              (MonoidAlgebra.single g 1 * Φ sec w).coeff τ
            rw [hΦ_coeff, MonoidAlgebra.coeff_single_mul_apply, one_mul, hΦ_coeff,
              hρ_X_spec g (W'_et W) (m_W (W'_et W) g⁻¹)
                (hm_W_fst (W'_et W) _) (hm_W_snd (W'_et W) _),
              hδ_m W g⁻¹ τ w]
          rw [hActR_sum r, hApp_sumΓ]
          let ev_w : LocallyConstant ↥W_V R_K →+ R_K :=
            { toFun := fun f => f w, map_zero' := rfl, map_add' := fun _ _ => rfl }
          change ev_w (Φ (∑ g : Γ, (((r.coeff g).val • ρ_X g).hom.app (Opposite.op (W'_et W))) sec)) = _
          rw [map_sum, map_sum]
          conv_rhs => rw [← hMA_sum_single r, Finset.sum_mul]
          refine Finset.sum_congr rfl fun g _ => ?_
          have hns : ev_w (Φ ((r.coeff g).val • (((ρ_X g).hom.app (Opposite.op (W'_et W))) sec))) =
              (r.coeff g).val • (Φ (((ρ_X g).hom.app (Opposite.op (W'_et W))) sec) w) :=
            map_nsmul (ev_w.comp Φ) _ _
          change ev_w (Φ ((r.coeff g).val • (((ρ_X g).hom.app (Opposite.op (W'_et W))) sec))) = _
          rw [hns, hΦ_ρ g, ← smul_mul_assoc]
          congr 1
          have hsg : (r.coeff g).val • (MonoidAlgebra.single g (1 : ZMod (ℓ ^ K))) =
              MonoidAlgebra.single g ((r.coeff g).val • (1 : ZMod (ℓ ^ K))) :=
            (map_nsmul (MonoidAlgebra.singleAddHom g) (r.coeff g).val (1 : ZMod (ℓ ^ K))).symm
          rw [hsg, nsmul_one, ZMod.natCast_zmod_val]
        let U_fn : ↥W_V → (Fin b → R_K) := fun w j => Φ (sb' j) w
        have hU_lc : IsLocallyConstant U_fn := by
          rw [IsLocallyConstant.iff_exists_open]
          intro w
          let U_j : Fin b → Set ↥W_V := fun j => (Φ (sb' j)) ⁻¹' {Φ (sb' j) w}
          have hUj_open : ∀ j : Fin b, IsOpen (U_j j) :=
            fun j => (IsLocallyConstant.iff_isOpen_fiber_apply.mp (Φ (sb' j)).isLocallyConstant) w
          refine ⟨⋂ j : Fin b, U_j j, isOpen_iInter_of_finite hUj_open,
            Set.mem_iInter.mpr (fun j => rfl), ?_⟩
          intro w' hw'
          funext j
          exact Set.mem_iInter.mp hw' j
        let U_lc : LocallyConstant ↥W_V (Fin b → R_K) := ⟨U_fn, hU_lc⟩
        have hU_syz : ∀ (w : ↥W_V) (i : Fin a), ∑ j : Fin b, A_eq j i * U_lc w j = 0 := by
          intro w i
          calc ∑ j : Fin b, A_eq j i * Φ (sb' j) w
              = ∑ j : Fin b, Φ (((actR (A_eq j i)).hom.app (Opposite.op (W'_et W))) (sb' j)) w := by
                  refine Finset.sum_congr rfl fun j _ => (hΦ_actR _ _ _).symm
            _ = Φ (∑ j : Fin b, ((actR (A_eq j i)).hom.app (Opposite.op (W'_et W))) (sb' j)) w := by
                  let ev_w : LocallyConstant ↥W_V R_K →+ R_K :=
                    { toFun := fun f => f w, map_zero' := rfl, map_add' := fun _ _ => rfl }
                  exact (map_sum (ev_w.comp Φ) _ _).symm
            _ = Φ 0 w := by rw [hsb'_ker i]
            _ = 0 := by rw [map_zero]; rfl
        let W_sol : ↥W_V → (Fin c → R_K) :=
          fun w => Classical.choose ((h_eq (U_lc w)).mp (hU_syz w))
        have hW_sol : ∀ (w : ↥W_V) (j : Fin b),
            U_lc w j = ∑ k : Fin c, B_eq k j * W_sol w k :=
          fun w => Classical.choose_spec ((h_eq (U_lc w)).mp (hU_syz w))
        let W_lc : Fin c → LocallyConstant ↥W_V R_K := fun k =>
          LocallyConstant.map
            (fun u_v : Fin b → R_K =>
              if h : ∀ i : Fin a, ∑ j : Fin b, A_eq j i * u_v j = 0 then
                Classical.choose ((h_eq u_v).mp h) k
              else 0)
            U_lc
        have hW_lc_eval : ∀ (k : Fin c) (w : ↥W_V), W_lc k w = W_sol w k := by
          intro k w
          change (if h : ∀ i : Fin a, ∑ j : Fin b, A_eq j i * U_lc w j = 0 then
            Classical.choose ((h_eq (U_lc w)).mp h) k else 0) = W_sol w k
          split_ifs with h
          · rfl
          · exact False.elim (h (hU_syz w))
        let sc : Fin c → ↑(𝒳.obj.obj (Opposite.op (W'_et W))) := fun k =>
          Classical.choose (hMkSec W (fun τ => LocallyConstant.map (fun r : R_K => r.coeff τ) (W_lc k)))
        have hΦ_sc : ∀ (k : Fin c) (w : ↥W_V), Φ (sc k) w = W_lc k w := by
          intro k w
          ext τ
          change (Φ (sc k) w).coeff τ = (W_lc k w).coeff τ
          rw [hΦ_coeff]
          exact Classical.choose_spec
            (hMkSec W (fun τ => LocallyConstant.map (fun r : R_K => r.coeff τ) (W_lc k))) τ w
        refine ⟨W'_et W, u'_et W, q', toSec (W'_et W) c sc, hu'_et_etale W, hq', ?_⟩
        apply hSec_Xn_ext (W'_et W) b
        intro j
        rw [hMat_sec (W'_et W) Φ_B sc j, hFromSec_map (u'_et W) b s₂ j]
        change ∑ k : Fin c, ((actR (B_eq k j)).hom.app (Opposite.op (W'_et W))) (sc k) = sb' j
        apply hSec_ext_W' W
        intro τ w
        rw [← hΦ_coeff _ w τ, ← hΦ_coeff _ w τ]
        let ev_w : LocallyConstant ↥W_V R_K →+ R_K :=
          { toFun := fun f => f w, map_zero' := rfl, map_add' := fun _ _ => rfl }
        have hsum_Φ : Φ (∑ k : Fin c,
            ((actR (B_eq k j)).hom.app (Opposite.op (W'_et W))) (sc k)) w =
            ∑ k : Fin c, Φ (((actR (B_eq k j)).hom.app (Opposite.op (W'_et W))) (sc k)) w :=
          map_sum (ev_w.comp Φ) _ _
        rw [hsum_Φ]
        have hsum_eq : ∑ k : Fin c,
            Φ (((actR (B_eq k j)).hom.app (Opposite.op (W'_et W))) (sc k)) w =
            Φ (sb' j) w := by
          calc ∑ k : Fin c, Φ (((actR (B_eq k j)).hom.app (Opposite.op (W'_et W))) (sc k)) w
              = ∑ k : Fin c, B_eq k j * W_sol w k := by
                  refine Finset.sum_congr rfl fun k _ => ?_
                  rw [hΦ_actR, hΦ_sc, hW_lc_eval]
            _ = U_lc w j := (hW_sol w j).symm
            _ = Φ (sb' j) w := rfl
        rw [hsum_eq]
      · refine ⟨U_col W W₀, u_col W W₀, ⟨p, hpW₀⟩, 0, hu_col_etale W W₀,
          by rw [hu_col_left]; rfl, ?_⟩
        rw [map_zero]
        symm
        apply hSec_Xn_ext (U_col W W₀) b
        intro j
        rw [hFromSec_map (u_col W W₀) b s₂ j]
        dsimp [fromSec]
        rw [map_zero]
        refine hCollar_zero_X W W₀ (sb j) (fun y hy => ?_)
        have hle : W₀ ≤ W₀_j j := Finset.inf_le (Finset.mem_univ j)
        exact (Classical.choose_spec (hCol_ex j)).2 y (hle hy)
    have hFex_actR : ∀ (r : MonoidAlgebra (ZMod (ℓ ^ K)) Γ) (y : ↑(F_ex.obj 𝒳)),
        (F_ex.map (actR r)).hom y =
          r.coeff.sum (fun g c_g => c_g.val • (F_ex.map (ρ_X g)).hom y) := by
      intro r y
      let ev_y : (𝒳 ⟶ 𝒳) →+ ↑(F_ex.obj 𝒳) :=
        { toFun := fun φ => (F_ex.map φ).hom y
          map_zero' := by rw [F_ex.map_zero]; rfl
          map_add' := fun φ₁ φ₂ => by rw [F_ex.map_add]; rfl }
      change ev_y (r.coeff.sum (fun g c_g => c_g.val • ρ_X g)) = _
      rw [map_finsuppSum]
      refine Finsupp.sum_congr fun g _ => ?_
      rw [map_nsmul]
      rfl
    have hEx := hExactFex F_ex hSurj_ex f_B f_A hf_BA0 (hTor_Xn c) hloc_syz (toF F_ex b x)
    constructor
    · intro hx0
      have hA_zero : (F_ex.map f_A).hom (toF F_ex b x) = 0 := by
        rw [← hToFromF F_ex a ((F_ex.map f_A).hom (toF F_ex b x))]
        have hf0 : fromF F_ex a ((F_ex.map f_A).hom (toF F_ex b x)) = 0 := by
          ext i
          rw [hMat_F F_ex Φ_A x i, Pi.zero_apply]
          simpa only [Φ_A, hFex_actR] using hx0 i
        rw [hf0]
        dsimp [toF]
        simp
      obtain ⟨z_bi, hz_bi⟩ := hEx.mp hA_zero
      refine ⟨fromF F_ex c z_bi, fun j => ?_⟩
      have hj := congrArg (fun u => fromF F_ex b u j) hz_bi.symm
      rw [hFromToF F_ex b x j, ← hToFromF F_ex c z_bi, hMat_F F_ex Φ_B (fromF F_ex c z_bi) j] at hj
      simpa only [Φ_B, hFex_actR] using hj
    · rintro ⟨z, hz⟩
      have h_eq_bi : (F_ex.map f_B).hom (toF F_ex c z) = toF F_ex b x := by
        rw [← hToFromF F_ex b ((F_ex.map f_B).hom (toF F_ex c z))]
        congr 1
        ext j
        rw [hMat_F F_ex Φ_B z j, hz j]
        refine Finset.sum_congr rfl fun k _ => ?_
        exact hFex_actR (B_eq k j) (z k)
      have hA_zero := hEx.mpr ⟨toF F_ex c z, h_eq_bi⟩
      intro i
      have hi := congrArg (fun u => fromF F_ex a u i) hA_zero
      rw [hMat_F F_ex Φ_A x i] at hi
      dsimp [fromF] at hi
      rw [map_zero] at hi
      simpa only [Φ_A, hFex_actR] using hi

  let cast_s : ZMod (ℓ ^ K) →+* ZMod (ℓ ^ (s + 1)) :=
    ZMod.castHom (pow_dvd_pow ℓ hsK) (ZMod (ℓ ^ (s + 1)))

  let F_norm (j : Fin N) (W : D_bar.Etale) (sec : ↑(𝒳.obj.obj (Opposite.op W))) :
      LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar) (Fin N → ZMod (ℓ ^ (s + 1))) :=
    ∑ idx : Fin m_Γ,
      LocallyConstant.map
        (fun (z : ZMod (ℓ ^ K)) (k : Fin N) =>
          ((τ_rep₀ (equiv_Γ idx)⁻¹).val k j) * cast_s z)
        ((triv_X W sec).comap (m_W W (equiv_Γ idx)).base.hom)

  have hF_norm_eval : ∀ (j : Fin N) (W : D_bar.Etale) (sec : ↑(𝒳.obj.obj (Opposite.op W)))
      (y : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)) (k : Fin N),
      F_norm j W sec y k =
        ∑ idx : Fin m_Γ,
          ((τ_rep₀ (equiv_Γ idx)⁻¹).val k j) *
            cast_s (triv_X W sec ((m_W W (equiv_Γ idx)).base y)) := by
    intro j W sec y k
    dsimp [F_norm]
    rw [hLC_sum_Js, Finset.sum_apply]
    rfl

  have hF_norm_mem : ∀ (j : Fin N) (W : D_bar.Etale) (sec : ↑(𝒳.obj.obj (Opposite.op W))),
      F_norm j W sec ∈ Set.range (triv_Js W) := by
    intro j W sec
    have hmemX : triv_X W sec ∈ Set.range (triv_X W) := ⟨sec, rfl⟩
    rw [(htriv_X_spec W).2] at hmemX
    rcases hmemX with ⟨W₀, hW₀_cov, hW₀_zero⟩
    rw [(htriv_Js_spec W).2]
    refine ⟨⟨W₀, hW₀_cov, fun y hy => ?_⟩, fun σ m_σ hm_fst hm_snd y => ?_⟩
    · ext k
      rw [hF_norm_eval]
      refine Finset.sum_eq_zero fun idx _ => ?_
      have hy' : (Limits.pullback.fst (Fgt.obj W).hom ι_bar).base
          ((m_W W (equiv_Γ idx)).base y) ∈ W₀ := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hm_W_fst]
        exact hy
      rw [hW₀_zero _ hy', map_zero, mul_zero]
    · have hm_eq : m_σ = m_W W σ := by
        apply Limits.pullback.hom_ext
        · exact hm_fst.trans (hm_W_fst W σ).symm
        · exact hm_snd.trans (hm_W_snd W σ).symm
      rw [hm_eq]
      ext k
      rw [hF_norm_eval]
      change ∑ idx : Fin m_Γ,
          ((τ_rep₀ (equiv_Γ idx)⁻¹).val k j) *
            cast_s (triv_X W sec ((m_W W (equiv_Γ idx)).base ((m_W W σ).base y))) =
        ∑ r : Fin N, (τ_rep₀ σ).val k r * F_norm j W sec y r
      simp_rw [hm_W_apply W σ _, hF_norm_eval, Finset.mul_sum]
      rw [Finset.sum_comm]
      let e_reidx : Fin m_Γ ≃ Fin m_Γ :=
        equiv_Γ.trans ((Equiv.mulRight σ⁻¹).trans equiv_Γ.symm)
      rw [← Equiv.sum_comp e_reidx]
      refine Finset.sum_congr rfl fun idx' _ => ?_
      have he_val : equiv_Γ (e_reidx idx') = equiv_Γ idx' * σ⁻¹ := by
        simp [e_reidx]
      have hmat : ((τ_rep₀ (equiv_Γ (e_reidx idx'))⁻¹).val k j) =
          ∑ r : Fin N, (τ_rep₀ σ).val k r * (τ_rep₀ (equiv_Γ idx')⁻¹).val r j := by
        have hgrp : (equiv_Γ (e_reidx idx'))⁻¹ = σ * (equiv_Γ idx')⁻¹ := by
          rw [he_val, mul_inv_rev, inv_inv]
        rw [hgrp, map_mul, Units.val_mul, Matrix.mul_apply]
      have hpt : (m_W W (equiv_Γ (e_reidx idx') * σ)).base y =
          (m_W W (equiv_Γ idx')).base y := by
        rw [he_val, inv_mul_cancel_right]
      rw [hmat, hpt, Finset.sum_mul]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [mul_assoc]

  let N_app (j : Fin N) (W : D_bar.Etale) :
      ↑(𝒳.obj.obj (Opposite.op W)) →+ ↑(𝒥_s.obj.obj (Opposite.op W)) :=
    { toFun := fun sec => Classical.choose (hF_norm_mem j W sec)
      map_zero' := by
        apply (htriv_Js_spec W).1
        rw [Classical.choose_spec (hF_norm_mem j W 0), map_zero (triv_Js W)]
        ext y k
        rw [hF_norm_eval]
        refine Finset.sum_eq_zero fun idx _ => ?_
        rw [map_zero (triv_X W)]
        change _ * cast_s 0 = 0
        rw [map_zero, mul_zero]
      map_add' := fun s₁ s₂ => by
        apply (htriv_Js_spec W).1
        rw [Classical.choose_spec (hF_norm_mem j W (s₁ + s₂)), map_add,
          Classical.choose_spec (hF_norm_mem j W s₁),
          Classical.choose_spec (hF_norm_mem j W s₂)]
        ext y k
        change F_norm j W (s₁ + s₂) y k = F_norm j W s₁ y k + F_norm j W s₂ y k
        rw [hF_norm_eval, hF_norm_eval, hF_norm_eval, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun idx _ => ?_
        rw [map_add]
        simp only [LocallyConstant.coe_add, Pi.add_apply, map_add, mul_add] }

  have hN_app_triv : ∀ (j : Fin N) (W : D_bar.Etale) (sec : ↑(𝒳.obj.obj (Opposite.op W))),
      triv_Js W (N_app j W sec) = F_norm j W sec :=
    fun j W sec => Classical.choose_spec (hF_norm_mem j W sec)

  let N_comp : Fin N → (𝒳 ⟶ 𝒥_s) := fun j =>
    { hom :=
        { app := fun W => AddCommGrpCat.ofHom (N_app j W.unop)
          naturality := fun {W₂ W₁} u_op => by
            let u : W₁.unop ⟶ W₂.unop := u_op.unop
            have hu_eq : u_op = Opposite.op u := rfl
            rw [hu_eq]
            ext sec
            apply (htriv_Js_spec W₁.unop).1
            let h₁ := (Fgt.obj W₁.unop).hom
            let h₂ := (Fgt.obj W₂.unop).hom
            let u_V : Limits.pullback h₁ ι_bar ⟶ Limits.pullback h₂ ι_bar :=
              Limits.pullback.lift
                (Limits.pullback.fst h₁ ι_bar ≫ (Fgt.map u).left)
                (Limits.pullback.snd h₁ ι_bar)
                (by
                  rw [Category.assoc, Over.w ((Fgt.map u))]
                  exact Limits.pullback.condition)
            ext y₁ k
            symm
            change triv_Js W₁.unop
              ((𝒥_s.obj.map (Opposite.op u)) (N_app j W₂.unop sec)) y₁ k =
              triv_Js W₁.unop (N_app j W₁.unop ((𝒳.obj.map (Opposite.op u)) sec)) y₁ k
            rw [htriv_Js_nat u u_V (Limits.pullback.lift_fst _ _ _)
              (Limits.pullback.lift_snd _ _ _),
              hN_app_triv j W₂.unop sec,
              hN_app_triv j W₁.unop ((𝒳.obj.map (Opposite.op u)) sec),
              hF_norm_eval, hF_norm_eval]
            refine Finset.sum_congr rfl fun idx _ => ?_
            congr 2
            have hu_m : u_V ≫ m_W W₂.unop (equiv_Γ idx) =
                m_W W₁.unop (equiv_Γ idx) ≫ u_V := by
              apply Limits.pullback.hom_ext
              · rw [Category.assoc, hm_W_fst, Limits.pullback.lift_fst,
                  Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, hm_W_fst]
              · rw [Category.assoc, hm_W_snd, ← Category.assoc, Limits.pullback.lift_snd,
                  Category.assoc, Limits.pullback.lift_snd, hm_W_snd]
            rw [htriv_X_nat u u_V (Limits.pullback.lift_fst _ _ _)
              (Limits.pullback.lift_snd _ _ _),
              ← AlgebraicGeometry.Scheme.Hom.comp_apply, hu_m,
              AlgebraicGeometry.Scheme.Hom.comp_apply] } }

  have hN_spec : ∀ (j : Fin N) (W : D_bar.Etale) (sec : ↑(𝒳.obj.obj (Opposite.op W)))
      (y : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)) (k : Fin N),
      triv_Js W (((N_comp j).hom.app (Opposite.op W)) sec) y k =
        ∑ idx : Fin m_Γ,
          ((τ_rep₀ (equiv_Γ idx)⁻¹).val k j) *
            cast_s (triv_X W sec ((m_W W (equiv_Γ idx)).base y)) := by
    intro j W sec y k
    change triv_Js W (Classical.choose (hF_norm_mem j W sec)) y k = _
    rw [Classical.choose_spec (hF_norm_mem j W sec), hF_norm_eval]

  have hEqToHom_comp : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C] {X Y Z : C}
      (hXY : Y = X) (f : Y ⟶ Z) (g : X ⟶ Z),
      HEq f g → CategoryTheory.eqToHom hXY.symm ≫ f = g := by
    intro C _ X Y Z hXY f g hfg
    subst hXY
    simpa using eq_of_heq hfg

  have hComp_eqToHom_heq : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      {P X Y : C} (hXY : Y = X) (f : P ⟶ X),
      HEq (f ≫ CategoryTheory.eqToHom hXY.symm) f := by
    intro C _ P X Y hXY f
    subst hXY
    simp

  have hN_frob : ∀ j : Fin N,
      CategoryTheory.CategoryStruct.comp (P_Dr.map (N_comp j)) β_Js =
        CategoryTheory.CategoryStruct.comp β_X (N_comp j) := by
    intro j
    apply hSheaf_ext
    intro W sec
    apply (htriv_Js_spec W).1
    let e_L : (Fgt.obj W).left ⟶ (Fgt.obj (G_Dr.obj W)).left :=
      CategoryTheory.eqToHom ((hG_Dr_obj W).1).symm
    have he_hom : e_L ≫ (Fgt.obj (G_Dr.obj W)).hom = (Fgt.obj W).hom ≫ g_D :=
      hEqToHom_comp ((hG_Dr_obj W).1) _ _ ((hG_Dr_obj W).2)
    let w_V : Limits.pullback (Fgt.obj W).hom ι_bar ⟶
        Limits.pullback (Fgt.obj (G_Dr.obj W)).hom ι_bar :=
      Limits.pullback.lift
        (Limits.pullback.fst (Fgt.obj W).hom ι_bar ≫ e_L)
        (Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ g_V)
        (by
          rw [Category.assoc, he_hom, ← Category.assoc, Limits.pullback.condition,
            Category.assoc, ← hgV_ι, ← Category.assoc])
    have hw_fst : HEq (w_V ≫ Limits.pullback.fst (Fgt.obj (G_Dr.obj W)).hom ι_bar)
        (Limits.pullback.fst (Fgt.obj W).hom ι_bar) := by
      rw [Limits.pullback.lift_fst]
      exact hComp_eqToHom_heq ((hG_Dr_obj W).1) _
    have hw_snd : w_V ≫ Limits.pullback.snd (Fgt.obj (G_Dr.obj W)).hom ι_bar =
        Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ g_V :=
      Limits.pullback.lift_snd _ _ _
    ext y k
    change triv_Js W ((β_Js.hom.app (Opposite.op W))
      (((P_Dr.map (N_comp j)).hom.app (Opposite.op W)) sec)) y k =
      triv_Js W (((N_comp j).hom.app (Opposite.op W))
        ((β_X.hom.app (Opposite.op W)) sec)) y k
    rw [hβ_Js_spec W _ w_V hw_fst hw_snd y]
    change triv_Js (G_Dr.obj W) (((N_comp j).hom.app (Opposite.op (G_Dr.obj W))) sec)
        (w_V.base y) k =
      triv_Js W (((N_comp j).hom.app (Opposite.op W))
        ((β_X.hom.app (Opposite.op W)) sec)) y k
    rw [hN_spec j (G_Dr.obj W) sec (w_V.base y) k,
      hN_spec j W ((β_X.hom.app (Opposite.op W)) sec) y k]
    refine Finset.sum_congr rfl fun idx _ => ?_
    congr 2
    rw [hβ_X_spec W sec w_V hw_fst hw_snd ((m_W W (equiv_Γ idx)).base y)]
    congr 1
    have hw_m : w_V ≫ m_W (G_Dr.obj W) (equiv_Γ idx) = m_W W (equiv_Γ idx) ≫ w_V := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hm_W_fst, Limits.pullback.lift_fst,
          Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, hm_W_fst]
      · rw [Category.assoc, hm_W_snd, ← Category.assoc, Limits.pullback.lift_snd,
          Category.assoc, ← hd_gV (equiv_Γ idx),
          Category.assoc (m_W W (equiv_Γ idx)), Limits.pullback.lift_snd,
          ← Category.assoc (m_W W (equiv_Γ idx)), hm_W_snd, Category.assoc]
    calc (m_W (G_Dr.obj W) (equiv_Γ idx)).base (w_V.base y)
        = (w_V ≫ m_W (G_Dr.obj W) (equiv_Γ idx)).base y := rfl
      _ = (m_W W (equiv_Γ idx) ≫ w_V).base y := by rw [hw_m]
      _ = w_V.base ((m_W W (equiv_Γ idx)).base y) := rfl

  have hN_tor : ∀ j : Fin N, (ℓ ^ (s + 1) : ℕ) • N_comp j = 0 := by
    intro j
    apply hSheaf_ext
    intro W sec
    apply (htriv_Js_spec W).1
    change triv_Js W ((ℓ ^ (s + 1) : ℕ) • (((N_comp j).hom.app (Opposite.op W)) sec)) =
      triv_Js W 0
    rw [map_zero (triv_Js W)]
    ext y k
    let ev_yk : LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar)
        (Fin N → ZMod (ℓ ^ (s + 1))) →+ ZMod (ℓ ^ (s + 1)) :=
      { toFun := fun f => f y k, map_zero' := rfl, map_add' := fun _ _ => rfl }
    change ev_yk (triv_Js W ((ℓ ^ (s + 1) : ℕ) • (((N_comp j).hom.app (Opposite.op W)) sec))) = 0
    rw [map_nsmul, map_nsmul]
    change (ℓ ^ (s + 1) : ℕ) • triv_Js W (((N_comp j).hom.app (Opposite.op W)) sec) y k = 0
    rw [nsmul_eq_mul, CharP.cast_eq_zero (ZMod (ℓ ^ (s + 1))) (ℓ ^ (s + 1)), zero_mul]

  have hN_rel : ∀ (g : Γ) (j : Fin N),
      ρ_X g ≫ N_comp j = ∑ i : Fin N, (((τ_rep₀ g⁻¹).val i j).val : ℕ) • N_comp i := by
    intro g j
    apply hSheaf_ext
    intro W sec
    apply (htriv_Js_spec W).1
    ext y k
    change triv_Js W (((N_comp j).hom.app (Opposite.op W))
      (((ρ_X g).hom.app (Opposite.op W)) sec)) y k = _
    rw [hN_spec j W _ y k, hApp_sum0, map_sum]
    have hrhs : (∑ x : Fin N,
        triv_Js W ((((((τ_rep₀ g⁻¹).val x j).val : ℕ) • N_comp x).hom.app (Opposite.op W)) sec)) y k =
        ∑ i : Fin N, ((τ_rep₀ g⁻¹).val i j) *
          triv_Js W (((N_comp i).hom.app (Opposite.op W)) sec) y k := by
      let ev_yk : LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar)
          (Fin N → ZMod (ℓ ^ (s + 1))) →+ ZMod (ℓ ^ (s + 1)) :=
        { toFun := fun f => f y k, map_zero' := rfl, map_add' := fun _ _ => rfl }
      change ev_yk (∑ i : Fin N, _) = _
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      change ev_yk (triv_Js W
        ((((τ_rep₀ g⁻¹).val i j).val : ℕ) • (((N_comp i).hom.app (Opposite.op W)) sec))) = _
      rw [map_nsmul, map_nsmul]
      change (((τ_rep₀ g⁻¹).val i j).val : ℕ) •
        (triv_Js W (((N_comp i).hom.app (Opposite.op W)) sec) y k) = _
      rw [nsmul_eq_mul, ZMod.natCast_zmod_val]
    rw [hrhs]
    simp_rw [hN_spec _ W sec y k, Finset.mul_sum]
    rw [Finset.sum_comm]
    let e_reidx : Fin m_Γ ≃ Fin m_Γ :=
      equiv_Γ.trans ((Equiv.mulLeft g).trans equiv_Γ.symm)
    rw [← Equiv.sum_comp e_reidx]
    refine Finset.sum_congr rfl fun idx' _ => ?_
    have he_val : equiv_Γ (e_reidx idx') = g * equiv_Γ idx' := by simp [e_reidx]
    have hmat : ((τ_rep₀ (equiv_Γ (e_reidx idx'))⁻¹).val k j) =
        ∑ i : Fin N, (τ_rep₀ (equiv_Γ idx')⁻¹).val k i * (τ_rep₀ g⁻¹).val i j := by
      rw [he_val, mul_inv_rev, map_mul, Units.val_mul, Matrix.mul_apply]
    rw [hmat, hρ_X_spec g W (m_W W g⁻¹) (hm_W_fst W _) (hm_W_snd W _),
      he_val, hm_W_apply W (g * equiv_Γ idx') g⁻¹, inv_mul_cancel_left, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring

  let Ψ_rel : Fin (m_Γ + 1) → Fin N → Fin N → (𝒳 ⟶ 𝒳) :=
    Fin.cases
      (fun j i => if j = i then (ℓ ^ (s + 1) : ℕ) • 𝟙 𝒳 else 0)
      (fun idx j i =>
        (if j = i then ρ_X (equiv_Γ idx) else 0) -
          (((τ_rep₀ (equiv_Γ idx)⁻¹).val i j).val : ℕ) • 𝟙 𝒳)

  have hPsi_zero : ∀ (r : Fin (m_Γ + 1)) (j : Fin N),
      ∑ i : Fin N, Ψ_rel r j i ≫ N_comp i = 0 := by
    intro r j
    refine Fin.cases ?_ ?_ r
    · dsimp [Ψ_rel]
      have hterm : ∀ i : Fin N,
          (if j = i then (ℓ ^ (s + 1) : ℕ) • 𝟙 𝒳 else 0) ≫ N_comp i =
            if j = i then (ℓ ^ (s + 1) : ℕ) • N_comp i else 0 := by
        intro i
        split_ifs with hji
        · rw [Preadditive.nsmul_comp, Category.id_comp]
        · rw [Limits.zero_comp]
      simp_rw [hterm]
      simp [hN_tor j]
    · intro idx
      dsimp [Ψ_rel]
      simp_rw [Preadditive.sub_comp]
      rw [Finset.sum_sub_distrib, sub_eq_zero]
      have h1 : ∑ i : Fin N, (if j = i then ρ_X (equiv_Γ idx) else 0) ≫ N_comp i =
          ρ_X (equiv_Γ idx) ≫ N_comp j := by
        have ht : ∀ i : Fin N,
            (if j = i then ρ_X (equiv_Γ idx) else 0) ≫ N_comp i =
              if j = i then ρ_X (equiv_Γ idx) ≫ N_comp i else 0 := by
          intro i
          split_ifs <;> simp
        simp_rw [ht]
        simp
      have h2 : ∑ i : Fin N,
          ((((τ_rep₀ (equiv_Γ idx)⁻¹).val i j).val : ℕ) • 𝟙 𝒳) ≫ N_comp i =
          ∑ i : Fin N, (((τ_rep₀ (equiv_Γ idx)⁻¹).val i j).val : ℕ) • N_comp i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Preadditive.nsmul_comp, Category.id_comp]
      rw [h1, h2]
      exact hN_rel (equiv_Γ idx) j

  let conc₁ (W : D_bar.Etale)
      (f : LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar) (ZMod (ℓ ^ K))) :
      ↑(𝒳.obj.obj (Opposite.op (W'_et W))) :=
    Classical.choose (hMkSec W (fun τ => if τ = 1 then f else 0))

  have hconc₁_eval : ∀ (W : D_bar.Etale)
      (f : LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar) (ZMod (ℓ ^ K)))
      (τ : Γ) (w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)),
      triv_X (W'_et W) (conc₁ W f) ((δ_W W τ).base w) = if τ = 1 then f w else 0 := by
    intro W f τ w
    rw [Classical.choose_spec (hMkSec W (fun τ => if τ = 1 then f else 0)) τ w]
    split_ifs <;> rfl

  have hconc₁_ρ : ∀ (W : D_bar.Etale)
      (f : LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar) (ZMod (ℓ ^ K)))
      (g τ : Γ) (w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)),
      triv_X (W'_et W) (((ρ_X g).hom.app (Opposite.op (W'_et W))) (conc₁ W f))
        ((δ_W W τ).base w) = if τ = g then f w else 0 := by
    intro W f g τ w
    rw [hρ_X_spec g (W'_et W) (m_W (W'_et W) g⁻¹) (hm_W_fst _ _) (hm_W_snd _ _),
      hδ_m W g⁻¹ τ w, hconc₁_eval]
    have hiff : g⁻¹ * τ = 1 ↔ τ = g := by
      rw [inv_mul_eq_one, eq_comm]
    simp [hiff]

  have hconc₁_norm : ∀ (W : D_bar.Etale)
      (f : Fin N → LocallyConstant ↥(Limits.pullback (Fgt.obj W).hom ι_bar) (ZMod (ℓ ^ K)))
      (w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar)) (k : Fin N),
      triv_Js (W'_et W)
        (∑ j : Fin N, ((N_comp j).hom.app (Opposite.op (W'_et W))) (conc₁ W (f j)))
        ((δ_W W 1).base w) k = cast_s (f k w) := by
    intro W f w k
    let ev_wk : LocallyConstant ↥(Limits.pullback (Fgt.obj (W'_et W)).hom ι_bar)
        (Fin N → ZMod (ℓ ^ (s + 1))) →+ ZMod (ℓ ^ (s + 1)) :=
      { toFun := fun g => g ((δ_W W 1).base w) k, map_zero' := rfl, map_add' := fun _ _ => rfl }
    change ev_wk (triv_Js (W'_et W) (∑ j : Fin N, _)) = _
    rw [map_sum, map_sum]
    have hj_term : ∀ j : Fin N,
        ev_wk (triv_Js (W'_et W) (((N_comp j).hom.app (Opposite.op (W'_et W))) (conc₁ W (f j)))) =
          if k = j then cast_s (f j w) else 0 := by
      intro j
      change triv_Js (W'_et W) (((N_comp j).hom.app (Opposite.op (W'_et W))) (conc₁ W (f j)))
        ((δ_W W 1).base w) k = _
      rw [hN_spec]
      have hidx_term : ∀ idx : Fin m_Γ,
          ((τ_rep₀ (equiv_Γ idx)⁻¹).val k j) *
            cast_s (triv_X (W'_et W) (conc₁ W (f j))
              ((m_W (W'_et W) (equiv_Γ idx)).base ((δ_W W 1).base w))) =
          if idx = equiv_Γ.symm 1 then ((τ_rep₀ (1 : Γ)⁻¹).val k j) * cast_s (f j w) else 0 := by
        intro idx
        rw [hδ_m W (equiv_Γ idx) 1 w, mul_one, hconc₁_eval]
        by_cases h1 : equiv_Γ idx = 1
        · have hidx : idx = equiv_Γ.symm 1 := equiv_Γ.injective (by simp [h1])
          split_ifs
          rw [h1]
        · have hidx : idx ≠ equiv_Γ.symm 1 := fun hc => h1 (by simp [hc])
          simp [h1, hidx]
      simp_rw [hidx_term]
      simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte,
        inv_one, map_one, Units.val_one, Matrix.one_apply]
      split_ifs <;> simp
    simp_rw [hj_term]
    simp

  have hJs_rigid : ∀ (W : D_bar.Etale)
      (t₁ t₂ : ↑(𝒥_s.obj.obj (Opposite.op (W'_et W)))),
      (∀ w : ↥(Limits.pullback (Fgt.obj W).hom ι_bar),
        triv_Js (W'_et W) t₁ ((δ_W W 1).base w) = triv_Js (W'_et W) t₂ ((δ_W W 1).base w)) →
      t₁ = t₂ := by
    intro W t₁ t₂ h1
    apply (htriv_Js_spec (W'_et W)).1
    ext y k
    rcases hSheet_surj W y with ⟨σ, w, rfl⟩
    have hσ1 : (δ_W W σ).base w = (m_W (W'_et W) σ).base ((δ_W W 1).base w) := by
      rw [hδ_m W σ 1 w, mul_one]
    have hmem₁ : triv_Js (W'_et W) t₁ ∈ Set.range (triv_Js (W'_et W)) := ⟨t₁, rfl⟩
    have hmem₂ : triv_Js (W'_et W) t₂ ∈ Set.range (triv_Js (W'_et W)) := ⟨t₂, rfl⟩
    rw [(htriv_Js_spec (W'_et W)).2] at hmem₁ hmem₂
    rw [hσ1, hmem₁.2 σ (m_W (W'_et W) σ) (hm_W_fst _ _) (hm_W_snd _ _),
      hmem₂.2 σ (m_W (W'_et W) σ) (hm_W_fst _ _) (hm_W_snd _ _), h1 w]

  let g_N : X_n N ⟶ 𝒥_s := Limits.biproduct.desc N_comp
  let e_RN : Fin ((m_Γ + 1) * N) ≃ Fin (m_Γ + 1) × Fin N := finProdFinEquiv.symm
  let M_rel : Fin ((m_Γ + 1) * N) → Fin N → (𝒳 ⟶ 𝒳) :=
    fun idx i => Ψ_rel (e_RN idx).1 (e_RN idx).2 i
  let f_rel : X_n ((m_Γ + 1) * N) ⟶ X_n N := Limits.biproduct.matrix M_rel

  have hf_rel_gN0 : f_rel ≫ g_N = 0 := by
    apply Limits.biproduct.hom_ext'
    intro idx
    rw [Limits.comp_zero, ← Category.assoc, Limits.biproduct.ι_matrix]
    have htot : 𝟙 (X_n N) = ∑ i : Fin N,
        Limits.biproduct.π (fun _ : Fin N => 𝒳) i ≫
          Limits.biproduct.ι (fun _ : Fin N => 𝒳) i := Limits.biproduct.total.symm
    calc (Limits.biproduct.lift fun i => M_rel idx i) ≫ g_N
        = (Limits.biproduct.lift fun i => M_rel idx i) ≫ 𝟙 (X_n N) ≫ g_N := by
            rw [Category.id_comp]
      _ = (Limits.biproduct.lift fun i => M_rel idx i) ≫
            (∑ i : Fin N,
              Limits.biproduct.π (fun _ : Fin N => 𝒳) i ≫
                Limits.biproduct.ι (fun _ : Fin N => 𝒳) i) ≫ g_N := by
            rw [htot]
      _ = ∑ i : Fin N,
            ((Limits.biproduct.lift fun i' => M_rel idx i') ≫
              Limits.biproduct.π (fun _ : Fin N => 𝒳) i) ≫
              (Limits.biproduct.ι (fun _ : Fin N => 𝒳) i ≫ g_N) := by
            rw [Preadditive.sum_comp, Preadditive.comp_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            simp only [Category.assoc]
      _ = ∑ i : Fin N, Ψ_rel (e_RN idx).1 (e_RN idx).2 i ≫ N_comp i := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Limits.biproduct.lift_π, Limits.biproduct.ι_desc]
      _ = 0 := hPsi_zero (e_RN idx).1 (e_RN idx).2

  have hLoc_surj_gN : ∀ (W : D_bar.Etale) (s_y : ↑(𝒥_s.obj.obj (Opposite.op W)))
      (p : ↥(Fgt.obj W).left),
      ∃ (U : D_bar.Etale) (u : U ⟶ W) (q : ↥(Fgt.obj U).left)
        (s₁ : ↑((X_n N).obj.obj (Opposite.op U))),
        AlgebraicGeometry.Etale (Fgt.map u).left ∧
        (Fgt.map u).left.base q = p ∧
        (g_N.hom.app (Opposite.op U)) s₁ = (𝒥_s.obj.map (Opposite.op u)) s_y := by
    intro W s_y p
    have hmem : triv_Js W s_y ∈ Set.range (triv_Js W) := ⟨s_y, rfl⟩
