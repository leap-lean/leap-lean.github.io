theorem weil_curve_tr_projective_resolution_and_cone_bridge (Γ : Type u) [Group Γ] [Finite Γ]
    (ℓ N s K B₁ B₂ : ℕ) [Fact (Nat.Prime ℓ)] (hN : 1 ≤ N) (hsK : s + 1 ≤ K)
    (τ_rep : Γ →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (s + 1))))ˣ)
    (b_J : Fin 3 → ℕ)
    (M_lat_J : ∀ i : Fin 3, Matrix (Fin (b_J i)) (Fin (b_J i)) (PadicInt ℓ))
