  have hFin_K0_imp : (∀ (j : Fin m_c) (q : ℕ), Finite (CompH 0 q j)) → ∀ q : ℕ, Finite (KH 0 q) := by
    intro hFin_comp
    have hFin_prod : ∀ d : ℕ, Finite (∀ j : Fin m_c, CompH 0 d j) := fun d =>
      @Pi.finite _ _ _ (fun j => hFin_comp j d)
    intro q
    match q with
    | 0 =>
      have _ : Subsingleton (KH 0 0) := hSub₀ 0
      exact Finite.of_subsingleton
    | 1 =>
      have _ : NeZero (ℓ ^ (0 + 1)) := ⟨pow_ne_zero 1 (Fact.out : Nat.Prime ℓ).ne_zero⟩
      have _ : Finite (Fin M_bdry → ZMod (ℓ ^ (0 + 1))) := Pi.finite
      let K : AddSubgroup (KH 0 1) := AddMonoidHom.ker (g₁_m 0)
      have _ : Finite (∀ j : Fin m_c, CompH 0 1 j) := hFin_prod 1
      have _ : Finite ((KH 0 1) ⧸ K) :=
        Finite.of_injective (QuotientAddGroup.kerLift (g₁_m 0))
          (QuotientAddGroup.kerLift_injective (g₁_m 0))
      let qmk : KH 0 1 →+ (KH 0 1) ⧸ K := QuotientAddGroup.mk' K
      let sec : (KH 0 1) ⧸ K → KH 0 1 :=
        Function.surjInv (QuotientAddGroup.mk'_surjective K)
      let Φ : ((KH 0 1) ⧸ K) × (Fin M_bdry → ZMod (ℓ ^ (0 + 1))) → KH 0 1 :=
        fun p => δ_m 0 p.2 + sec p.1
      have hΦ_surj : Function.Surjective Φ := by
        intro x
        have hq0 : qmk (x - sec (qmk x)) = 0 := by
          rw [map_sub, Function.surjInv_eq (QuotientAddGroup.mk'_surjective K) (qmk x), sub_self]
        have hmem_K : x - sec (qmk x) ∈ K := by
          have hmem_ker : x - sec (qmk x) ∈ (QuotientAddGroup.mk' K).ker := hq0
          rwa [QuotientAddGroup.ker_mk' K] at hmem_ker
        have hmem_rng : x - sec (qmk x) ∈ AddMonoidHom.range (δ_m 0) := by
          rw [(hExc_all 0).2.2.1]
          exact hmem_K
        obtain ⟨u, hu⟩ := hmem_rng
        refine ⟨(qmk x, u), ?_⟩
        dsimp [Φ]
        rw [hu, sub_add_cancel]
      exact Finite.of_surjective Φ hΦ_surj
    | r + 2 =>
      have _ : Finite (∀ j : Fin m_c, CompH 0 (r + 2) j) := hFin_prod (r + 2)
      exact Finite.of_injective (g_all 0 (r + 2)) (hg_ge2_bij 0 r).1

  exact ⟨hSub₀, hFin_K0_imp, f₀_m, δ_m, g₁_m, g₂_m, hExc_all⟩

