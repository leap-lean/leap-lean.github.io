  have hδI : δI₁.comp δI₀ = 0 := by
    apply LinearMap.ext
    intro x
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₀) x
    change map_Finv M_K.δ₁ (map_Finv M_K.δ₀ (q_M₀ v)) = 0
    rw [hmap_Finv_mk, hmap_Finv_mk]
    have h0 : (fun i : Fin N => M_K.δ₁ (M_K.δ₀ (v i))) = 0 :=
      funext fun i => LinearMap.congr_fun M_K.hδ (v i)
    rw [h0, map_zero]

  have hψI₀_comm : δI₀.comp ψ₀ = ψ₁.comp δI₀ := by
    apply LinearMap.ext
    intro x
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (Rel_sub M_K.M₀) x
    change map_Finv M_K.δ₀ (map_Finv M_K.Φ₀ (q_M₀ v)) =
      map_Finv M_K.Φ₁ (map_Finv M_K.δ₀ (q_M₀ v))
    rw [hmap_Finv_mk, hmap_Finv_mk, hmap_Finv_mk, hmap_Finv_mk]
