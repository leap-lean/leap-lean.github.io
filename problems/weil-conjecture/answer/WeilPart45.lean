      (adj_S.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P_S.obj Fℤ)).symm
        (CategoryTheory.CategoryStruct.comp
          (adj_S.unit.app (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Fℤ.obj.map (Opposite.op μ_S)))
