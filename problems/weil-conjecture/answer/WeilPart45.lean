by
  classical
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  let k := AlgebraicClosure F
  let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
  let D_ov := weilProjectiveSpaceOver F 1
  let D_bar := weilGeomScheme F D_ov
  let V_ov := weilCurveTrGeomCoverOver F B₀
  let V_bar := weilGeomScheme F V_ov
  let Y_bar := weilBaseChangeOver F k Y_ov
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let pr_D : D_bar ⟶ D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
  let snd_D : D_bar ⟶ S₀ := (weilBaseChangeOver F k D_ov).hom
  let fst_Y : Y_bar.left ⟶ Y_ov.left := CategoryTheory.Limits.pullback.fst Y_ov.hom f₂
  let snd_Y : Y_bar.left ⟶ S₀ := Y_bar.hom
  let fst_V : V_bar ⟶ V_ov.left := CategoryTheory.Limits.pullback.fst V_ov.hom f₂
  let snd_V : V_bar ⟶ S₀ := (weilBaseChangeOver F k V_ov).hom
  let j_V₀' : V_ov.left ⟶ Y_ov.left := j_V₀
  let p₀' : Y_ov.left ⟶ D_ov.left := p₀
  let p_bar' : Y_bar.left ⟶ D_bar := p_bar
  let ι_bar' : V_bar ⟶ D_bar := ι_bar
  let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
  let α_σ : V_bar ⟶ V_bar :=
    CategoryTheory.CategoryStruct.comp
