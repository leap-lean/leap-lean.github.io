    intro m q x j
    have h1 : g_all m q (τ_H q m x) =
        fun j' => trans_comp m q j' (g_all (m + 1) q x j') := by
      change r_comp m q (ι_H m q (e_K m q (τ_H q m x))) = _
      rw [he_K_τ m q x]
      have hcomm : ι_H m q
          (((CategoryTheory.Abelian.Ext.mk₀ (τJ m)).postcomp X (Nat.add_zero q))
            (e_K (m + 1) q x)) =
          ((CategoryTheory.Abelian.Ext.mk₀ (τL m)).postcomp X (Nat.add_zero q))
