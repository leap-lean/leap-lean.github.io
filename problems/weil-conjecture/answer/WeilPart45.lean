      CategoryTheory.CategoryStruct.comp (d g) (weilSchemeEndPow frob_V k) =
      CategoryTheory.CategoryStruct.comp (weilSchemeEndPow frob_V k) (d g) := by
    intro k g
    induction k with
    | zero =>
      change d g ≫ 𝟙 V_bar = 𝟙 V_bar ≫ d g
      rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    | succ k ih =>
      change d g ≫ (frob_V ≫ weilSchemeEndPow frob_V k) =
        (frob_V ≫ weilSchemeEndPow frob_V k) ≫ d g
      rw [← CategoryTheory.Category.assoc (d g) frob_V, hd_frob1 g,
        CategoryTheory.Category.assoc frob_V (d g), ih,
        ← CategoryTheory.Category.assoc frob_V (weilSchemeEndPow frob_V k) (d g)]
  have hd_gV : ∀ g : B₀ ≃ₐ[R₀] B₀,
      CategoryTheory.CategoryStruct.comp (weilCurveTrGeomDeckHom F R₀ B₀ g) g_V_r =
      CategoryTheory.CategoryStruct.comp g_V_r (weilCurveTrGeomDeckHom F R₀ B₀ g) :=
    hd_gV_all r
  have hgV_ι_all : ∀ k : ℕ,
      CategoryTheory.CategoryStruct.comp (weilSchemeEndPow frob_V k) ι_bar =
      CategoryTheory.CategoryStruct.comp ι_bar (weilSchemeEndPow frob_D k) := by
    intro k
    induction k with
    | zero =>
      change 𝟙 V_bar ≫ ι_bar = ι_bar ≫ 𝟙 D_bar
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    | succ k ih =>
      change (frob_V ≫ weilSchemeEndPow frob_V k) ≫ ι_bar =
        ι_bar ≫ (frob_D ≫ weilSchemeEndPow frob_D k)
      rw [CategoryTheory.Category.assoc frob_V (weilSchemeEndPow frob_V k) ι_bar, ih,
        ← CategoryTheory.Category.assoc frob_V ι_bar, hfrob_ι1,
        CategoryTheory.Category.assoc ι_bar frob_D]
  have hgV_ι : CategoryTheory.CategoryStruct.comp g_V_r ι_bar =
      CategoryTheory.CategoryStruct.comp ι_bar g_D_r :=
    hgV_ι_all r
  have hgD_pr_all : ∀ k : ℕ,
      CategoryTheory.CategoryStruct.comp (weilSchemeEndPow frob_D k) pr_D = pr_D := by
    intro k
    induction k with
    | zero =>
      change 𝟙 D_bar ≫ pr_D = pr_D
      exact CategoryTheory.Category.id_comp _
    | succ k ih =>
      change (frob_D ≫ weilSchemeEndPow frob_D k) ≫ pr_D = pr_D
      rw [CategoryTheory.Category.assoc, ih]
      exact hfrob_fst D_ov
  have hgD_pr : CategoryTheory.CategoryStruct.comp g_D_r pr_D = pr_D :=
    hgD_pr_all r

  let m_pb : ∀ (W : D_bar.Etale) (_σ : B₀ ≃ₐ[R₀] B₀),
      CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar ⟶
        CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar :=
    fun W σ =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar)
        (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ d σ)
        (by
          rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hd_ι σ])
  have m_pb_fst : ∀ (W : D_bar.Etale) (σ : B₀ ≃ₐ[R₀] B₀),
      m_pb W σ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar =
      CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have m_pb_snd : ∀ (W : D_bar.Etale) (σ : B₀ ≃ₐ[R₀] B₀),
      m_pb W σ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar =
      CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ d σ :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have m_pb_uniq : ∀ (W : D_bar.Etale) (σ : B₀ ≃ₐ[R₀] B₀)
      (m' : CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar ⟶
        CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar),
      m' ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar =
        CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar →
      m' ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar =
        CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ d σ →
      m' = m_pb W σ := by
    intro W σ m' h1 h2
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [h1, m_pb_fst]
    · rw [h2, m_pb_snd]
  have m_pb_one : ∀ W : D_bar.Etale,
      m_pb W 1 = 𝟙 (CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar) := by
    intro W
    symm
    apply m_pb_uniq
    · exact CategoryTheory.Category.id_comp _
    · rw [CategoryTheory.Category.id_comp, show d 1 = 𝟙 V_bar from hd_one,
        CategoryTheory.Category.comp_id]
  have m_pb_one_base : ∀ (W : D_bar.Etale)
      (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)),
      (m_pb W 1).base y = y := by
    intro W y
    rw [m_pb_one W]
    rfl
  have m_pb_mul : ∀ (W : D_bar.Etale) (σ₁ σ₂ : B₀ ≃ₐ[R₀] B₀),
      m_pb W (σ₁ * σ₂) = m_pb W σ₂ ≫ m_pb W σ₁ := by
    intro W σ₁ σ₂
    symm
    apply m_pb_uniq
    · rw [CategoryTheory.Category.assoc, m_pb_fst, m_pb_fst]
    · rw [CategoryTheory.Category.assoc, m_pb_snd, ← CategoryTheory.Category.assoc,
        m_pb_snd, CategoryTheory.Category.assoc, ← hd_mul σ₁ σ₂]
  let u_pb : ∀ {W₁ W₂ : D_bar.Etale} (_u : W₁ ⟶ W₂),
      CategoryTheory.Limits.pullback (Fgt.obj W₁).hom ι_bar ⟶
        CategoryTheory.Limits.pullback (Fgt.obj W₂).hom ι_bar :=
    fun {W₁ W₂} u =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom ι_bar ≫ (Fgt.map u).left)
        (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom ι_bar)
        (by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w (Fgt.map u),
            CategoryTheory.Limits.pullback.condition])
  have u_pb_fst : ∀ {W₁ W₂ : D_bar.Etale} (u : W₁ ⟶ W₂),
      u_pb u ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj W₂).hom ι_bar =
      CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom ι_bar ≫ (Fgt.map u).left :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have u_pb_snd : ∀ {W₁ W₂ : D_bar.Etale} (u : W₁ ⟶ W₂),
      u_pb u ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj W₂).hom ι_bar =
      CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom ι_bar :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have u_pb_m : ∀ {W₁ W₂ : D_bar.Etale} (u : W₁ ⟶ W₂) (σ : B₀ ≃ₐ[R₀] B₀),
      u_pb u ≫ m_pb W₂ σ = m_pb W₁ σ ≫ u_pb u := by
    intro W₁ W₂ u σ
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc (u_pb u) (m_pb W₂ σ),
        CategoryTheory.Category.assoc (m_pb W₁ σ) (u_pb u),
        m_pb_fst, u_pb_fst, ← CategoryTheory.Category.assoc (m_pb W₁ σ), m_pb_fst]
    · rw [CategoryTheory.Category.assoc (u_pb u) (m_pb W₂ σ),
        CategoryTheory.Category.assoc (m_pb W₁ σ) (u_pb u),
        m_pb_snd, u_pb_snd, ← CategoryTheory.Category.assoc (u_pb u), u_pb_snd, m_pb_snd]

  have hρ_mem : ∀ (m : ℕ) (g : B₀ ≃ₐ[R₀] B₀) (W : D_bar.Etale)
      (sec : ↑((𝒦_s m).obj.obj (Opposite.op W))),
      (triv_K m W sec).comap (m_pb W g⁻¹).base.hom ∈ Set.range (triv_K m W) := by
    intro m g W sec
    have hsec : triv_K m W sec ∈ Set.range (triv_K m W) := ⟨sec, rfl⟩
    rw [((htriv_K m).2 W).2.1] at hsec ⊢
    rcases hsec with ⟨W₀, hW₀_cov, hW₀_zero⟩
    refine ⟨W₀, hW₀_cov, fun y hy => ?_⟩
    rw [LocallyConstant.coe_comap_apply]
    apply hW₀_zero ((m_pb W g⁻¹).base y)
    have hbase : (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar).base
        ((m_pb W g⁻¹).base y) =
        (m_pb W g⁻¹ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar).base y :=
      (AlgebraicGeometry.Scheme.Hom.comp_apply _ _ _).symm
    rw [hbase, m_pb_fst]
    exact hy
  let ρ_fun : ∀ (m : ℕ) (_g : B₀ ≃ₐ[R₀] B₀) (W : D_bar.Etale),
      ↑((𝒦_s m).obj.obj (Opposite.op W)) → ↑((𝒦_s m).obj.obj (Opposite.op W)) :=
    fun m g W sec => Classical.choose (hρ_mem m g W sec)
  have hρ_fun_spec : ∀ (m : ℕ) (g : B₀ ≃ₐ[R₀] B₀) (W : D_bar.Etale)
      (sec : ↑((𝒦_s m).obj.obj (Opposite.op W))) (y),
      triv_K m W (ρ_fun m g W sec) y = triv_K m W sec ((m_pb W g⁻¹).base y) := by
    intro m g W sec y
    have hspec := Classical.choose_spec (hρ_mem m g W sec)
    exact (DFunLike.congr_fun hspec y).trans
      (LocallyConstant.coe_comap_apply (m_pb W g⁻¹).base.hom (triv_K m W sec) y)
  let ρ_app : ∀ (m : ℕ) (_g : B₀ ≃ₐ[R₀] B₀) (W : D_bar.Etale),
      (𝒦_s m).obj.obj (Opposite.op W) ⟶ (𝒦_s m).obj.obj (Opposite.op W) :=
    fun m g W => AddCommGrpCat.ofHom
      { toFun := ρ_fun m g W
        map_zero' := by
          apply ((htriv_K m).2 W).1
          ext y
          rw [hρ_fun_spec, map_zero]
          rfl
        map_add' := fun s₁ s₂ => by
          apply ((htriv_K m).2 W).1
          ext y
          rw [hρ_fun_spec, map_add, map_add]
          change _ = triv_K m W (ρ_fun m g W s₁) y + triv_K m W (ρ_fun m g W s₂) y
          rw [hρ_fun_spec, hρ_fun_spec]
          rfl }
  let ρ_K : ∀ m : ℕ, (B₀ ≃ₐ[R₀] B₀) → Quiver.Hom (𝒦_s m) (𝒦_s m) :=
    fun m g => CategoryTheory.ObjectProperty.homMk
      { app := fun W => ρ_app m g W.unop
        naturality := fun {W₂_op W₁_op} f_op => by
          let W₁ := W₁_op.unop
          let W₂ := W₂_op.unop
          let u : W₁ ⟶ W₂ := f_op.unop
          ext sec
          apply ((htriv_K m).2 W₁).1
          ext y₁
          calc
            triv_K m W₁ ((((𝒦_s m).obj.map f_op) ≫ ρ_app m g W₁) sec) y₁
              = triv_K m W₁ (ρ_fun m g W₁ (((𝒦_s m).obj.map (Opposite.op u)) sec)) y₁ := rfl
            _ = triv_K m W₁ (((𝒦_s m).obj.map (Opposite.op u)) sec) ((m_pb W₁ g⁻¹).base y₁) :=
                hρ_fun_spec m g W₁ _ y₁
            _ = triv_K m W₂ sec ((u_pb u).base ((m_pb W₁ g⁻¹).base y₁)) :=
                (htriv_K m).1 u (u_pb u) (u_pb_fst u) (u_pb_snd u) sec _
            _ = triv_K m W₂ sec ((m_pb W₁ g⁻¹ ≫ u_pb u).base y₁) := by
                rw [← AlgebraicGeometry.Scheme.Hom.comp_apply]
            _ = triv_K m W₂ sec ((u_pb u ≫ m_pb W₂ g⁻¹).base y₁) := by
                rw [u_pb_m u g⁻¹]
            _ = triv_K m W₂ sec ((m_pb W₂ g⁻¹).base ((u_pb u).base y₁)) := by
                rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
            _ = triv_K m W₂ (ρ_fun m g W₂ sec) ((u_pb u).base y₁) :=
                (hρ_fun_spec m g W₂ sec _).symm
            _ = triv_K m W₁ (((𝒦_s m).obj.map (Opposite.op u)) (ρ_fun m g W₂ sec)) y₁ :=
                ((htriv_K m).1 u (u_pb u) (u_pb_fst u) (u_pb_snd u) (ρ_fun m g W₂ sec) y₁).symm
            _ = triv_K m W₁ ((ρ_app m g W₂ ≫ (𝒦_s m).obj.map f_op) sec) y₁ := rfl }
  have hρK_app : ∀ (m : ℕ) (g : B₀ ≃ₐ[R₀] B₀) (W : D_bar.Etale)
      (sec : ↑((𝒦_s m).obj.obj (Opposite.op W))) (y),
      triv_K m W (((ρ_K m g).hom.app (Opposite.op W)) sec) y =
        triv_K m W sec ((m_pb W g⁻¹).base y) :=
    fun m g W sec y => hρ_fun_spec m g W sec y
  have hρK_triv : ∀ (m : ℕ) (g : B₀ ≃ₐ[R₀] B₀) (W : D_bar.Etale)
      (m_ginv : Quiver.Hom
        (CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)
        (CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)),
      CategoryTheory.CategoryStruct.comp m_ginv
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar) =
        CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar →
      CategoryTheory.CategoryStruct.comp m_ginv
        (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar)
          (weilCurveTrGeomDeckHom F R₀ B₀ g⁻¹) →
      ∀ (sec : ↑((𝒦_s m).obj.obj (Opposite.op W))) (y),
        triv_K m W (((ρ_K m g).hom.app (Opposite.op W)) sec) y =
          triv_K m W sec (m_ginv.base y) := by
    intro m g W m_ginv hm_fst hm_snd sec y
    rw [m_pb_uniq W g⁻¹ m_ginv hm_fst hm_snd]
    exact hρK_app m g W sec y
  have hρK_one : ∀ m : ℕ, ρ_K m 1 = CategoryTheory.CategoryStruct.id (𝒦_s m) := by
    intro m
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op sec
    let W := W_op.unop
    apply ((htriv_K m).2 W).1
    ext y
    change triv_K m W (((ρ_K m 1).hom.app (Opposite.op W)) sec) y = triv_K m W sec y
    rw [hρK_app, inv_one, m_pb_one_base]
  have hρK_mul : ∀ (m : ℕ) (g₁ g₂ : B₀ ≃ₐ[R₀] B₀),
      ρ_K m (g₁ * g₂) = CategoryTheory.CategoryStruct.comp (ρ_K m g₂) (ρ_K m g₁) := by
    intro m g₁ g₂
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op sec
    let W := W_op.unop
    apply ((htriv_K m).2 W).1
    ext y
    calc
      triv_K m W (((ρ_K m (g₁ * g₂)).hom.app (Opposite.op W)) sec) y
        = triv_K m W sec ((m_pb W (g₁ * g₂)⁻¹).base y) :=
          hρK_app m (g₁ * g₂) W sec y
      _ = triv_K m W sec ((m_pb W g₁⁻¹ ≫ m_pb W g₂⁻¹).base y) := by
          rw [mul_inv_rev, m_pb_mul W g₂⁻¹ g₁⁻¹]
      _ = triv_K m W sec ((m_pb W g₂⁻¹).base ((m_pb W g₁⁻¹).base y)) := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      _ = triv_K m W (((ρ_K m g₂).hom.app (Opposite.op W)) sec) ((m_pb W g₁⁻¹).base y) :=
          (hρK_app m g₂ W sec _).symm
      _ = triv_K m W (((ρ_K m g₁).hom.app (Opposite.op W))
            (((ρ_K m g₂).hom.app (Opposite.op W)) sec)) y :=
          (hρK_app m g₁ W _ y).symm
      _ = triv_K m W (((CategoryTheory.CategoryStruct.comp (ρ_K m g₂) (ρ_K m g₁)).hom.app
            (Opposite.op W)) sec) y := rfl

  have heq_hom : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (h : X = Y)
      (f : X ⟶ Z) (g : Y ⟶ Z),
      HEq f g → CategoryTheory.eqToHom h.symm ≫ f = g := by
    rintro X _ Z rfl f g hfg
    rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp]
    exact eq_of_heq hfg
  have heq_post : ∀ {P X Y : AlgebraicGeometry.Scheme.{u}} (h : X = Y)
      (p : P ⟶ X) (q : P ⟶ Y),
      HEq p q → p = q ≫ CategoryTheory.eqToHom h.symm := by
    rintro P X _ rfl p q hpq
    rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
    exact eq_of_heq hpq
  have heq_bimorphism : ∀ {X₁ Y₁ X₂ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : X₁ = Y₁) (h₂ : X₂ = Y₂) (f : X₁ ⟶ X₂) (g : Y₁ ⟶ Y₂),
      HEq f g →
      CategoryTheory.eqToHom h₁.symm ≫ f = g ≫ CategoryTheory.eqToHom h₂.symm := by
    rintro X₁ _ X₂ _ rfl rfl f g hfg
    rw [CategoryTheory.eqToHom_refl, CategoryTheory.eqToHom_refl,
      CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    exact eq_of_heq hfg
  let e_L : ∀ W : D_bar.Etale, (Fgt.obj W).left ⟶ (Fgt.obj (G_Dr.obj W)).left :=
    fun W => CategoryTheory.eqToHom (hG_Dr_obj W).1.symm
  have he_L_hom : ∀ W : D_bar.Etale,
      e_L W ≫ (Fgt.obj (G_Dr.obj W)).hom = (Fgt.obj W).hom ≫ g_D_r :=
    fun W => heq_hom (hG_Dr_obj W).1 _ _ (hG_Dr_obj W).2
  have he_L_map : ∀ {W₁ W₂ : D_bar.Etale} (u : W₁ ⟶ W₂),
      e_L W₁ ≫ (Fgt.map (G_Dr.map u)).left = (Fgt.map u).left ≫ e_L W₂ :=
    fun {W₁ W₂} u => heq_bimorphism (hG_Dr_obj W₁).1 (hG_Dr_obj W₂).1 _ _ (hG_Dr_map u)

  let α_twist : (B₀ ≃ₐ[R₀] B₀) → (V_bar ⟶ V_bar) :=
    fun σ => g_V_r ≫ d σ⁻¹
  have hα_twist_ι : ∀ σ : B₀ ≃ₐ[R₀] B₀,
      α_twist σ ≫ ι_bar = ι_bar ≫ g_D_r := by
    intro σ
    change (g_V_r ≫ d σ⁻¹) ≫ ι_bar = ι_bar ≫ g_D_r
    rw [CategoryTheory.Category.assoc, hd_ι σ⁻¹, hgV_ι]
  have hα_twist_one : α_twist 1 = g_V_r := by
    change g_V_r ≫ d 1⁻¹ = g_V_r
    rw [inv_one, show d 1 = 𝟙 V_bar from hd_one, CategoryTheory.Category.comp_id]
  let w_pb : ∀ (W : D_bar.Etale) (_σ : B₀ ≃ₐ[R₀] B₀),
      CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar ⟶
        CategoryTheory.Limits.pullback (Fgt.obj (G_Dr.obj W)).hom ι_bar :=
    fun W σ =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar ≫ e_L W)
        (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ α_twist σ)
        (by
          rw [CategoryTheory.Category.assoc _ (e_L W), he_L_hom W,
            ← CategoryTheory.Category.assoc _ (Fgt.obj W).hom,
            CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc _ ι_bar, ← hα_twist_ι σ,
            ← CategoryTheory.Category.assoc _ (α_twist σ)])
  have w_pb_fst : ∀ (W : D_bar.Etale) (σ : B₀ ≃ₐ[R₀] B₀),
      w_pb W σ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj (G_Dr.obj W)).hom ι_bar =
      CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar ≫ e_L W :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have w_pb_snd : ∀ (W : D_bar.Etale) (σ : B₀ ≃ₐ[R₀] B₀),
      w_pb W σ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj (G_Dr.obj W)).hom ι_bar =
      CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ α_twist σ :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have w_pb_uniq : ∀ (W : D_bar.Etale) (σ : B₀ ≃ₐ[R₀] B₀)
      (w_V : CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar ⟶
        CategoryTheory.Limits.pullback (Fgt.obj (G_Dr.obj W)).hom ι_bar),
      HEq (w_V ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj (G_Dr.obj W)).hom ι_bar)
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar) →
      w_V ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj (G_Dr.obj W)).hom ι_bar =
        CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar ≫ α_twist σ →
      w_V = w_pb W σ := by
    intro W σ w_V hw_fst hw_snd
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [heq_post (hG_Dr_obj W).1 _ _ hw_fst, w_pb_fst]
    · rw [hw_snd, w_pb_snd]
  have u_pb_w : ∀ {W₁ W₂ : D_bar.Etale} (u : W₁ ⟶ W₂) (σ : B₀ ≃ₐ[R₀] B₀),
      u_pb u ≫ w_pb W₂ σ = w_pb W₁ σ ≫ u_pb (G_Dr.map u) := by
    intro W₁ W₂ u σ
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc (u_pb u) (w_pb W₂ σ), w_pb_fst,
        ← CategoryTheory.Category.assoc (u_pb u), u_pb_fst,
        CategoryTheory.Category.assoc _ (Fgt.map u).left, ← he_L_map u,
        ← CategoryTheory.Category.assoc _ (e_L W₁),
        CategoryTheory.Category.assoc (w_pb W₁ σ) (u_pb (G_Dr.map u)),
        u_pb_fst, ← CategoryTheory.Category.assoc (w_pb W₁ σ), w_pb_fst]
    · rw [CategoryTheory.Category.assoc (u_pb u) (w_pb W₂ σ), w_pb_snd,
        ← CategoryTheory.Category.assoc (u_pb u), u_pb_snd,
        CategoryTheory.Category.assoc (w_pb W₁ σ) (u_pb (G_Dr.map u)),
        u_pb_snd, w_pb_snd]
  have m_pb_w1 : ∀ (W : D_bar.Etale) (σ : B₀ ≃ₐ[R₀] B₀),
      m_pb W σ⁻¹ ≫ w_pb W 1 = w_pb W σ := by
    intro W σ
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, w_pb_fst,
        ← CategoryTheory.Category.assoc, m_pb_fst, w_pb_fst]
    · rw [CategoryTheory.Category.assoc, w_pb_snd, hα_twist_one,
        ← CategoryTheory.Category.assoc, m_pb_snd,
        CategoryTheory.Category.assoc, hd_gV σ⁻¹, w_pb_snd]
  have w1_m_pb : ∀ (W : D_bar.Etale) (g : B₀ ≃ₐ[R₀] B₀),
      w_pb W 1 ≫ m_pb (G_Dr.obj W) g⁻¹ = m_pb W g⁻¹ ≫ w_pb W 1 := by
    intro W g
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc (w_pb W 1), m_pb_fst, w_pb_fst,
        CategoryTheory.Category.assoc (m_pb W g⁻¹), w_pb_fst,
        ← CategoryTheory.Category.assoc (m_pb W g⁻¹), m_pb_fst]
    · rw [CategoryTheory.Category.assoc (w_pb W 1), m_pb_snd,
        ← CategoryTheory.Category.assoc (w_pb W 1), w_pb_snd, hα_twist_one,
        CategoryTheory.Category.assoc _ g_V_r, ← hd_gV g⁻¹,
        ← CategoryTheory.Category.assoc _ (d g⁻¹),
        CategoryTheory.Category.assoc (m_pb W g⁻¹), w_pb_snd, hα_twist_one,
        ← CategoryTheory.Category.assoc (m_pb W g⁻¹), m_pb_snd]

  have hβ_mem : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ) (W : D_bar.Etale)
      (sec : ↑((𝒦_s m).obj.obj (Opposite.op (G_Dr.obj W)))),
      (triv_K m (G_Dr.obj W) sec).comap (w_pb W σ).base.hom ∈ Set.range (triv_K m W) := by
    intro σ m W sec
    have hsec : triv_K m (G_Dr.obj W) sec ∈ Set.range (triv_K m (G_Dr.obj W)) := ⟨sec, rfl⟩
    rw [((htriv_K m).2 (G_Dr.obj W)).2.1] at hsec
    rw [((htriv_K m).2 W).2.1]
    rcases hsec with ⟨GW₀, hGW₀_cov, hGW₀_zero⟩
    refine ⟨(TopologicalSpace.Opens.map (e_L W).base).obj GW₀, ?_, ?_⟩
    · ext x
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      have hx_top : (e_L W).base x ∈
          ((TopologicalSpace.Opens.map (Fgt.obj (G_Dr.obj W)).hom.base).obj U_bar) ⊔ GW₀ := by
        rw [hGW₀_cov]
        trivial
      rcases TopologicalSpace.Opens.mem_sup.mp hx_top with hxU | hxGW₀
      · apply TopologicalSpace.Opens.mem_sup.mpr
        left
        change pr_D.base ((Fgt.obj W).hom.base x) ∈ U₀
        have hcomp_eq : (e_L W ≫ (Fgt.obj (G_Dr.obj W)).hom) ≫ pr_D =
            (Fgt.obj W).hom ≫ pr_D := by
          rw [he_L_hom W, CategoryTheory.Category.assoc, hgD_pr]
        have hpt : pr_D.base ((Fgt.obj (G_Dr.obj W)).hom.base ((e_L W).base x)) =
            pr_D.base ((Fgt.obj W).hom.base x) := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
            ← AlgebraicGeometry.Scheme.Hom.comp_apply,
            ← CategoryTheory.Category.assoc, hcomp_eq,
            AlgebraicGeometry.Scheme.Hom.comp_apply]
        rw [← hpt]
        exact hxU
      · apply TopologicalSpace.Opens.mem_sup.mpr
        right
        exact hxGW₀
    · intro y hy
      rw [LocallyConstant.coe_comap_apply]
      apply hGW₀_zero ((w_pb W σ).base y)
      have hbase : (CategoryTheory.Limits.pullback.fst (Fgt.obj (G_Dr.obj W)).hom ι_bar).base
          ((w_pb W σ).base y) =
          (e_L W).base ((CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar).base y) := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, w_pb_fst,
          AlgebraicGeometry.Scheme.Hom.comp_apply]
      rw [hbase]
      exact hy
  let β_fun : ∀ (_σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ) (W : D_bar.Etale),
      ↑((𝒦_s m).obj.obj (Opposite.op (G_Dr.obj W))) →
        ↑((𝒦_s m).obj.obj (Opposite.op W)) :=
    fun σ m W sec => Classical.choose (hβ_mem σ m W sec)
  have hβ_fun_spec : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ) (W : D_bar.Etale)
      (sec : ↑((𝒦_s m).obj.obj (Opposite.op (G_Dr.obj W)))) (y),
      triv_K m W (β_fun σ m W sec) y =
        triv_K m (G_Dr.obj W) sec ((w_pb W σ).base y) := by
    intro σ m W sec y
    have hspec := Classical.choose_spec (hβ_mem σ m W sec)
    exact (DFunLike.congr_fun hspec y).trans
      (LocallyConstant.coe_comap_apply (w_pb W σ).base.hom (triv_K m (G_Dr.obj W) sec) y)
  let β_app : ∀ (_σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ) (W : D_bar.Etale),
      ((P_Dr.obj (𝒦_s m)).obj.obj (Opposite.op W)) ⟶
        ((𝒦_s m).obj.obj (Opposite.op W)) :=
    fun σ m W => AddCommGrpCat.ofHom
      { toFun := β_fun σ m W
        map_zero' := by
          apply ((htriv_K m).2 W).1
          ext y
          rw [hβ_fun_spec, map_zero, map_zero]
          rfl
        map_add' := fun s₁ s₂ => by
          apply ((htriv_K m).2 W).1
          ext y
          rw [hβ_fun_spec, map_add, map_add]
          change _ = triv_K m W (β_fun σ m W s₁) y + triv_K m W (β_fun σ m W s₂) y
          rw [hβ_fun_spec, hβ_fun_spec]
          rfl }
  let β_K : ∀ (_σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ), Quiver.Hom (P_Dr.obj (𝒦_s m)) (𝒦_s m) :=
    fun σ m => CategoryTheory.ObjectProperty.homMk
      { app := fun W => β_app σ m W.unop
        naturality := fun {W₂_op W₁_op} f_op => by
          let W₁ := W₁_op.unop
          let W₂ := W₂_op.unop
          let u : W₁ ⟶ W₂ := f_op.unop
          ext sec
          apply ((htriv_K m).2 W₁).1
          ext y₁
          calc
            triv_K m W₁ ((((P_Dr.obj (𝒦_s m)).obj.map f_op) ≫ β_app σ m W₁) sec) y₁
              = triv_K m W₁ (β_fun σ m W₁
                  (((𝒦_s m).obj.map (Opposite.op (G_Dr.map u))) sec)) y₁ := rfl
            _ = triv_K m (G_Dr.obj W₁)
                  (((𝒦_s m).obj.map (Opposite.op (G_Dr.map u))) sec) ((w_pb W₁ σ).base y₁) :=
                  hβ_fun_spec σ m W₁ _ y₁
            _ = triv_K m (G_Dr.obj W₂) sec
                  ((u_pb (G_Dr.map u)).base ((w_pb W₁ σ).base y₁)) :=
                  (htriv_K m).1 (G_Dr.map u) (u_pb (G_Dr.map u))
                    (u_pb_fst (G_Dr.map u)) (u_pb_snd (G_Dr.map u)) sec _
            _ = triv_K m (G_Dr.obj W₂) sec
                  ((w_pb W₁ σ ≫ u_pb (G_Dr.map u)).base y₁) := by
                  rw [← AlgebraicGeometry.Scheme.Hom.comp_apply]
            _ = triv_K m (G_Dr.obj W₂) sec ((u_pb u ≫ w_pb W₂ σ).base y₁) := by
                  rw [u_pb_w u σ]
            _ = triv_K m (G_Dr.obj W₂) sec ((w_pb W₂ σ).base ((u_pb u).base y₁)) := by
                  rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
            _ = triv_K m W₂ (β_fun σ m W₂ sec) ((u_pb u).base y₁) :=
                  (hβ_fun_spec σ m W₂ sec _).symm
            _ = triv_K m W₁ (((𝒦_s m).obj.map (Opposite.op u)) (β_fun σ m W₂ sec)) y₁ :=
                  ((htriv_K m).1 u (u_pb u) (u_pb_fst u) (u_pb_snd u)
                    (β_fun σ m W₂ sec) y₁).symm
            _ = triv_K m W₁ ((β_app σ m W₂ ≫ (𝒦_s m).obj.map f_op) sec) y₁ := rfl }
  have hβK_app : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ) (W : D_bar.Etale)
      (sec : ↑((P_Dr.obj (𝒦_s m)).obj.obj (Opposite.op W))) (y),
      triv_K m W (((β_K σ m).hom.app (Opposite.op W)) sec) y =
        triv_K m (G_Dr.obj W) sec ((w_pb W σ).base y) :=
    fun σ m W sec y => hβ_fun_spec σ m W sec y
  have hβK_triv : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ) (W : D_bar.Etale)
      (sec : ↑((P_Dr.obj (𝒦_s m)).obj.obj (Opposite.op W)))
      (w_V : Quiver.Hom
        (CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)
        (CategoryTheory.Limits.pullback (Fgt.obj (G_Dr.obj W)).hom ι_bar)),
      HEq (CategoryTheory.CategoryStruct.comp w_V
        (CategoryTheory.Limits.pullback.fst (Fgt.obj (G_Dr.obj W)).hom ι_bar))
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar) →
      CategoryTheory.CategoryStruct.comp w_V
        (CategoryTheory.Limits.pullback.snd (Fgt.obj (G_Dr.obj W)).hom ι_bar) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar) (α_twist σ) →
      ∀ y,
        triv_K m W (((β_K σ m).hom.app (Opposite.op W)) sec) y =
          triv_K m (G_Dr.obj W) sec (w_V.base y) := by
    intro σ m W sec w_V hw_fst hw_snd y
    rw [w_pb_uniq W σ w_V hw_fst hw_snd]
    exact hβK_app σ m W sec y
  have hβK1_triv : ∀ (m : ℕ) (W : D_bar.Etale)
      (sec : ↑((P_Dr.obj (𝒦_s m)).obj.obj (Opposite.op W)))
      (w_V : Quiver.Hom
        (CategoryTheory.Limits.pullback (Fgt.obj W).hom ι_bar)
        (CategoryTheory.Limits.pullback (Fgt.obj (G_Dr.obj W)).hom ι_bar)),
      HEq (CategoryTheory.CategoryStruct.comp w_V
        (CategoryTheory.Limits.pullback.fst (Fgt.obj (G_Dr.obj W)).hom ι_bar))
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_bar) →
      CategoryTheory.CategoryStruct.comp w_V
        (CategoryTheory.Limits.pullback.snd (Fgt.obj (G_Dr.obj W)).hom ι_bar) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_bar) g_V_r →
      ∀ y,
        triv_K m W (((β_K 1 m).hom.app (Opposite.op W)) sec) y =
          triv_K m (G_Dr.obj W) sec (w_V.base y) := by
    intro m W sec w_V hw_fst hw_snd y
    apply hβK_triv 1 m W sec w_V hw_fst
    rwa [hα_twist_one]
  have hβK_decomp : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ),
      β_K σ m = CategoryTheory.CategoryStruct.comp (β_K 1 m) (ρ_K m σ) := by
    intro σ m
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op sec
    let W := W_op.unop
    apply ((htriv_K m).2 W).1
    ext y
    calc
      triv_K m W (((β_K σ m).hom.app (Opposite.op W)) sec) y
        = triv_K m (G_Dr.obj W) sec ((w_pb W σ).base y) :=
          hβK_app σ m W sec y
      _ = triv_K m (G_Dr.obj W) sec ((m_pb W σ⁻¹ ≫ w_pb W 1).base y) := by
          rw [m_pb_w1 W σ]
      _ = triv_K m (G_Dr.obj W) sec ((w_pb W 1).base ((m_pb W σ⁻¹).base y)) := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      _ = triv_K m W (((β_K 1 m).hom.app (Opposite.op W)) sec) ((m_pb W σ⁻¹).base y) :=
          (hβK_app 1 m W sec _).symm
      _ = triv_K m W (((ρ_K m σ).hom.app (Opposite.op W))
            (((β_K 1 m).hom.app (Opposite.op W)) sec)) y :=
          (hρK_app m σ W _ y).symm
      _ = triv_K m W (((CategoryTheory.CategoryStruct.comp (β_K 1 m) (ρ_K m σ)).hom.app
            (Opposite.op W)) sec) y := rfl
  have hβK_ρ_comm : ∀ (g : B₀ ≃ₐ[R₀] B₀) (m : ℕ),
      CategoryTheory.CategoryStruct.comp (P_Dr.map (ρ_K m g)) (β_K 1 m) =
        CategoryTheory.CategoryStruct.comp (β_K 1 m) (ρ_K m g) := by
    intro g m
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op sec
    let W := W_op.unop
    apply ((htriv_K m).2 W).1
    ext y
    calc
      triv_K m W (((CategoryTheory.CategoryStruct.comp
            (P_Dr.map (ρ_K m g)) (β_K 1 m)).hom.app (Opposite.op W)) sec) y
        = triv_K m W (((β_K 1 m).hom.app (Opposite.op W))
            (((ρ_K m g).hom.app (Opposite.op (G_Dr.obj W))) sec)) y := rfl
      _ = triv_K m (G_Dr.obj W)
            (((ρ_K m g).hom.app (Opposite.op (G_Dr.obj W))) sec) ((w_pb W 1).base y) :=
            hβK_app 1 m W _ y
      _ = triv_K m (G_Dr.obj W) sec
            ((m_pb (G_Dr.obj W) g⁻¹).base ((w_pb W 1).base y)) :=
            hρK_app m g (G_Dr.obj W) sec _
      _ = triv_K m (G_Dr.obj W) sec ((w_pb W 1 ≫ m_pb (G_Dr.obj W) g⁻¹).base y) := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply]
      _ = triv_K m (G_Dr.obj W) sec ((m_pb W g⁻¹ ≫ w_pb W 1).base y) := by
            rw [w1_m_pb W g]
      _ = triv_K m (G_Dr.obj W) sec ((w_pb W 1).base ((m_pb W g⁻¹).base y)) := by
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      _ = triv_K m W (((β_K 1 m).hom.app (Opposite.op W)) sec) ((m_pb W g⁻¹).base y) :=
            (hβK_app 1 m W sec _).symm
      _ = triv_K m W (((ρ_K m g).hom.app (Opposite.op W))
            (((β_K 1 m).hom.app (Opposite.op W)) sec)) y :=
            (hρK_app m g W _ y).symm
      _ = triv_K m W (((CategoryTheory.CategoryStruct.comp
            (β_K 1 m) (ρ_K m g)).hom.app (Opposite.op W)) sec) y := rfl
  have hβK_τ : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (m : ℕ),
      CategoryTheory.CategoryStruct.comp (P_Dr.map (τ_𝒦s m)) (β_K σ m) =
        CategoryTheory.CategoryStruct.comp (β_K σ (m + 1)) (τ_𝒦s m) := by
    intro σ m
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op sec_up
    let W := W_op.unop
    apply ((htriv_K m).2 W).1
    ext y
    calc
      triv_K m W (((CategoryTheory.CategoryStruct.comp
            (P_Dr.map (τ_𝒦s m)) (β_K σ m)).hom.app (Opposite.op W)) sec_up) y
        = triv_K m W (((β_K σ m).hom.app (Opposite.op W))
            (((τ_𝒦s m).hom.app (Opposite.op (G_Dr.obj W))) sec_up)) y := rfl
      _ = triv_K m (G_Dr.obj W)
            (((τ_𝒦s m).hom.app (Opposite.op (G_Dr.obj W))) sec_up) ((w_pb W σ).base y) :=
            hβK_app σ m W _ y
      _ = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
            (triv_K (m + 1) (G_Dr.obj W) sec_up ((w_pb W σ).base y)) :=
            ((htriv_K m).2 (G_Dr.obj W)).2.2 sec_up _
      _ = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
            (triv_K (m + 1) W (((β_K σ (m + 1)).hom.app (Opposite.op W)) sec_up) y) := by
            rw [hβK_app σ (m + 1) W sec_up y]
      _ = triv_K m W (((τ_𝒦s m).hom.app (Opposite.op W))
            (((β_K σ (m + 1)).hom.app (Opposite.op W)) sec_up)) y :=
            (((htriv_K m).2 W).2.2 _ y).symm
      _ = triv_K m W (((CategoryTheory.CategoryStruct.comp
            (β_K σ (m + 1)) (τ_𝒦s m)).hom.app (Opposite.op W)) sec_up) y := rfl

  let α_H : ∀ (_σ : B₀ ≃ₐ[R₀] B₀) (m i : ℕ), (𝒦_s m).H i →+ (𝒦_s m).H i :=
    fun σ m i =>
      ((CategoryTheory.Abelian.Ext.mk₀ (β_K σ m)).postcomp Fℤ_D (Nat.add_zero i)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ αℤ_D).precomp (P_Dr.obj (𝒦_s m))
          (Nat.zero_add i)).comp
          (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_Dr
            hAdd_P hLim_P hColim_P _ _ Fℤ_D (𝒦_s m) i))
  have hαH_def : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (m i : ℕ) (x : (𝒦_s m).H i),
      α_H σ m i x =
        (CategoryTheory.Abelian.Ext.mk₀ (β_K σ m)).postcomp Fℤ_D (Nat.add_zero i)
          ((CategoryTheory.Abelian.Ext.mk₀ αℤ_D).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_Dr
              hAdd_P hLim_P hColim_P _ _ Fℤ_D (𝒦_s m) i) x)
            (Nat.zero_add i)) :=
    fun _ _ _ _ => rfl
  have hαH_τ : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (i m : ℕ) (x : (𝒦_s (m + 1)).H i),
      τ_K_coh i m (α_H σ (m + 1) i x) = α_H σ m i (τ_K_coh i m x) := by
    intro σ i m x
    rw [hτK_coh_def i m]
    exact hAct_nat_r (τ_𝒦s m) (β_K σ (m + 1)) (β_K σ m) (hβK_τ σ m) i x
  have hZeroExt_wrap : ∀ (B₂ : ℕ)
      (b_V : (B₀ ≃ₐ[R₀] B₀) → Fin 3 → ℕ)
      (M_lat_V : ∀ (σ : B₀ ≃ₐ[R₀] B₀) (i : Fin 3),
        Matrix (Fin (b_V σ i)) (Fin (b_V σ i)) (PadicInt ℓ)),
      (∀ (σ : B₀ ≃ₐ[R₀] B₀) (K : ℕ), 1 ≤ K → ∀ (i : Fin 3),
        let m := K - 1
        let M_i := ((M_lat_V σ i).map (PadicInt.toZModPow K)).mulVecLin
        ∃ q_i : (Fin (b_V σ i) → ZMod (ℓ ^ K)) →+ (𝒦_s m).H i.1,
          (∀ x, q_i (M_i x) = α_H σ m i.1 (q_i x)) ∧
          (∀ x, q_i x = 0 → (ℓ ^ B₂ : ℕ) • x = 0) ∧
          (∀ y : (𝒦_s m).H i.1, ∃ x, q_i x = (ℓ ^ B₂ : ℕ) • y)) →
      WeilCurveTrGeomCoverZeroExt.{u} F S_aff U₀ ℓ B₀ e_U r 𝒦_s τ_𝒦s B₂ b_V M_lat_V := by
    intro B₂ b_V M_lat_V hLat
    refine ⟨ι_bar, triv_K, hι_fst, hι_snd,
      fun m => ⟨@(htriv_K m).1, (htriv_K m).2⟩,
      fun σ => ⟨α_H σ,
        ⟨G_Dr, inferInstance, hG_Dr_obj, @hG_Dr_map,
          hAdd_P, hLim_P, hColim_P, T_D, hT_D, μ_D,
          hTD_left, hTD_hom, hμD_hom,
          fun m => ⟨β_K σ m, hβK_triv σ m, fun i x => rfl⟩⟩,
        fun K hK i => hLat σ K hK i⟩⟩
  exact ⟨hd_gV, hgV_ι, ρ_K, β_K, α_H,
    hρK_one, hρK_mul, hαH_def, hαH_τ, hβK_decomp, hβK_ρ_comm,
    hZeroExt_wrap, hρK_triv, hβK1_triv⟩

theorem weil_geom_cover_eq_flatness_and_norm_presentation (D_bar : AlgebraicGeometry.Scheme.{u})
    (U_bar : D_bar.Opens)
    (V_bar : AlgebraicGeometry.Scheme.{u})
    (ι_bar : Quiver.Hom V_bar D_bar)
    (hEt_ι : AlgebraicGeometry.Etale ι_bar)
    (hRange_ι : Set.range ι_bar.base = (U_bar : Set D_bar))
