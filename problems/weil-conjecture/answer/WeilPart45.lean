        change ev_wj (∑ i : Fin N, (((τ_rep₀ g⁻¹).val i j).val : ℕ) • N_comp i) = _
        rw [map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_nsmul]
        rfl
