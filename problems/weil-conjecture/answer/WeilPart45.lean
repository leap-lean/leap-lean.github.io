    | succ q ih =>
      intro Y
      let I : 𝒞₁ := CategoryTheory.Injective.under Y
      let ι : Quiver.Hom Y I := CategoryTheory.Injective.ι Y
      let Q : 𝒞₁ := CategoryTheory.Limits.cokernel ι
      let π : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π ι
      let S : CategoryTheory.ShortComplex 𝒞₁ :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
