            (CategoryTheory.Category.assoc k (ℱ.obj.map (Opposite.op τ_inv))
                (ℱ.obj.map (Opposite.op τ_B))).trans
              ((congrArg (k ≫ ·)
                  ((ℱ.obj.map_comp (Opposite.op τ_inv) (Opposite.op τ_B)).symm.trans
                    ((congrArg (fun m => ℱ.obj.map (Opposite.op m)) hτ_B_inv).trans
                      (ℱ.obj.map_id (Opposite.op (B.obj T)))))).trans
