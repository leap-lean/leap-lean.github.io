      (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)
  let g_D_r : D_bar ⟶ D_bar := weilSchemeEndPow (weilGeomFrobHom F D_ov) r

  
  
  
  have hpb_Y : CategoryTheory.IsPullback fst_Y snd_Y Y_ov.hom f₂ :=
    CategoryTheory.IsPullback.of_hasPullback Y_ov.hom f₂
  have hpb_D : CategoryTheory.IsPullback pr_D snd_D D_ov.hom f₂ :=
    CategoryTheory.IsPullback.of_hasPullback D_ov.hom f₂
