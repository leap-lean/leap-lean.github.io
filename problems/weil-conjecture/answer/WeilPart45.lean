    (τL : ∀ m : ℕ, L (m + 1) ⟶ L m)
    (τS : ∀ m : ℕ, S (m + 1) ⟶ S m)
    (hτ_ι : ∀ m : ℕ, τJ m ≫ ι m = ι (m + 1) ≫ τL m)
