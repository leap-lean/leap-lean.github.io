      (δ_m : ∀ m : ℕ, (Fin M_bdry → ZMod (ℓ ^ (m + 1))) →+ KH m 1)
      (g₁_m : ∀ m : ℕ, KH m 1 →+ (∀ j : Fin m_c, CompH m 1 j))
      (g₂_m : ∀ m : ℕ, KH m 2 ≃+ (∀ j : Fin m_c, CompH m 2 j)),
      ∀ m : ℕ,
