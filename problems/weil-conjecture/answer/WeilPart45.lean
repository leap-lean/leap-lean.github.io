    intro i
    let L_mul : TensorProduct R A₀ S →ₗ[R] TensorProduct R B₀ S :=
      { toFun := fun w => θ w * (v i ⊗ₜ[R] (1 : S))
        map_add' := fun w₁ w₂ => by rw [map_add, add_mul]
        map_smul' := fun r w => by simp only [RingHom.id_apply, map_smul, smul_mul_assoc] }
    have h_eq : α_S i = L_mul := by
      apply TensorProduct.ext'
      intro a s
      change (φ₀_alg a * v i) ⊗ₜ[R] s = θ (a ⊗ₜ[R] s) * (v i ⊗ₜ[R] (1 : S))
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Algebra.TensorProduct.tmul_mul_tmul,
        mul_one]
    exact fun w => LinearMap.congr_fun h_eq w
  let E_tens : (Fin d → TensorProduct R A₀ S) ≃+ TensorProduct R B₀ S :=
    { toFun := fun f => ∑ i : Fin d, α_S i (f i)
      invFun := fun z j => β_S j z
      left_inv := fun f => by
        funext j
        simp only [map_sum, h_βα_S, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
      right_inv := h_sum_S
      map_add' := fun f₁ f₂ => by
        simp only [Pi.add_apply, map_add, Finset.sum_add_distrib] }
  have hE_smul : ∀ (u : TensorProduct R A₀ S) (f : Fin d → TensorProduct R A₀ S),
      E_tens (u • f) = θ u * E_tens f := by
    intro u f
    change ∑ i : Fin d, α_S i (u * f i) = θ u * ∑ i : Fin d, α_S i (f i)
    simp_rw [hα_S_mul, map_mul, mul_assoc]
    rw [← Finset.mul_sum]
  let M₁ : Type u := Fin d → A₁
  let e₁ : M₁ ≃+ B₁ :=
    (AddEquiv.piCongrRight fun _ : Fin d => ψ_A.symm.toAddEquiv).trans
      (E_tens.trans ψ_B.toAddEquiv)
  refine ⟨V, hy, hAff_V, hAff_V', M₁, inferInstance, inferInstance, e₁, ?_,
    ⟨Pi.basisFun A₁ (Fin d)⟩⟩
  intro a m
  change ψ_B (E_tens (fun i => ψ_A.symm (a * m i))) =
    (p_S.app V).hom a * ψ_B (E_tens (fun i => ψ_A.symm (m i)))
  have h_pi : (fun i : Fin d => ψ_A.symm (a * m i)) =
      ψ_A.symm a • (fun i : Fin d => ψ_A.symm (m i)) := by
    funext i
    exact map_mul ψ_A.symm a (m i)
  rw [h_pi, hE_smul, map_mul, ← h_inter (ψ_A.symm a), ψ_A.apply_symm_apply]

theorem weil_sepField_baseChange_clopen_components (F F₀ k : Type u)
    [Field F] [Finite F] [Field F₀] [Algebra F F₀] [FiniteDimensional F F₀]
    [Field k] [IsAlgClosed k] [Algebra F k]
    (Y_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Y_ov.hom]
    (h_YF₀ : Quiver.Hom Y_ov.left (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
    (hYF₀_hom : CategoryTheory.CategoryStruct.comp h_YF₀
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₀))) = Y_ov.hom) :
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let Y_bar := weilBaseChangeOver F k Y_ov
    ∃ (m_c : ℕ)
      (emb : Fin m_c → (F₀ →ₐ[F] k))
      (Y_comp : Fin m_c → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (inc_comp : ∀ ι : Fin m_c, Quiver.Hom (Y_comp ι).left Y_bar.left)
      (pr_comp : ∀ ι : Fin m_c, Quiver.Hom (Y_comp ι).left Y_ov.left),
      1 ≤ m_c ∧
      (∀ ι : Fin m_c,
        CategoryTheory.IsPullback (pr_comp ι) (Y_comp ι).hom h_YF₀
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (emb ι).toRingHom)) ∧
        CategoryTheory.CategoryStruct.comp (inc_comp ι)
          (CategoryTheory.Limits.pullback.fst Y_ov.hom f₂) = pr_comp ι ∧
        CategoryTheory.CategoryStruct.comp (inc_comp ι) Y_bar.hom = (Y_comp ι).hom ∧
        AlgebraicGeometry.IsOpenImmersion (inc_comp ι) ∧
        AlgebraicGeometry.IsClosedImmersion (inc_comp ι) ∧
        AlgebraicGeometry.IsProper (Y_comp ι).hom) ∧
      (∀ ι₁ ι₂ : Fin m_c, ι₁ ≠ ι₂ →
        Disjoint (Set.range (inc_comp ι₁).base) (Set.range (inc_comp ι₂).base)) ∧
      (⋃ ι : Fin m_c, Set.range (inc_comp ι).base) = Set.univ :=
by
  
  let m_c : ℕ := Module.finrank F F₀
  have hm_c : 1 ≤ m_c := Module.finrank_pos
  have _ : PerfectField F := PerfectField.ofFinite
  have _ : Algebra.IsAlgebraic F F₀ := Algebra.IsAlgebraic.of_finite F F₀
  have _ : Algebra.IsSeparable F F₀ := Algebra.IsAlgebraic.isSeparable_of_perfectField
  let _ : Fintype (F₀ →ₐ[F] k) := minpoly.AlgHom.fintype F F₀ k
  have hcard : Fintype.card (F₀ →ₐ[F] k) = m_c := AlgHom.card F F₀ k
  let e_emb : Fin m_c ≃ (F₀ →ₐ[F] k) := (Fintype.equivFinOfCardEq hcard).symm
  let emb : Fin m_c → (F₀ →ₐ[F] k) := ⇑e_emb
  let φ_L : F₀ →ₐ[F] (Fin m_c → k) := AlgHom.pi emb
  let φ_R : k →ₐ[F] (Fin m_c → k) := IsScalarTower.toAlgHom F k (Fin m_c → k)
  let Φ : TensorProduct F F₀ k →ₐ[F] (Fin m_c → k) :=
    Algebra.TensorProduct.lift φ_L φ_R (fun _ _ => Commute.all _ _)
  have hΦ_tmul : ∀ (u : F₀) (c : k), Φ (u ⊗ₜ[F] c) = fun ι => emb ι u * c := by
    intro u c
    rw [Algebra.TensorProduct.lift_tmul]
    ext ι
    simp [φ_L, φ_R]
  let b : Module.Basis (Fin m_c) F F₀ := Module.finBasis F F₀
  let g : (Fin m_c → k) → TensorProduct F F₀ k :=
    fun d => ∑ j : Fin m_c, b j ⊗ₜ[F] d j
  have hg_surj : Function.Surjective g := by
    intro z
    have hmem : z ∈ (⊤ : Submodule F (TensorProduct F F₀ k)) := Submodule.mem_top
    rw [← TensorProduct.span_tmul_eq_top] at hmem
    refine Submodule.span_induction ?_ ⟨0, by simp [g, TensorProduct.tmul_zero]⟩ ?_ ?_ hmem
    · rintro _ ⟨u, c, rfl⟩
      refine ⟨fun j => (b.repr u j) • c, ?_⟩
      dsimp [g]
      simp_rw [← TensorProduct.smul_tmul, ← TensorProduct.sum_tmul, b.sum_repr]
    · rintro x y _ _ ⟨d₁, hd₁⟩ ⟨d₂, hd₂⟩
      refine ⟨d₁ + d₂, ?_⟩
      dsimp [g]
      simp_rw [TensorProduct.tmul_add, Finset.sum_add_distrib]
      exact congrArg₂ (· + ·) hd₁ hd₂
    · rintro r x _ ⟨d, hd⟩
      refine ⟨r • d, ?_⟩
      rw [← hd]
      dsimp [g]
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul']
  let M : Matrix (Fin m_c) (Fin m_c) k := Matrix.of (fun ι j => emb ι (b j))
  have hΦ_g : ∀ d : Fin m_c → k, Φ (g d) = M.mulVec d := by
    intro d
    ext ι
    simp [g, map_sum, Finset.sum_apply, hΦ_tmul, M, Matrix.mulVec, dotProduct]
  let f_mon : Fin m_c → (F₀ →* k) := fun ι => (emb ι).toRingHom.toMonoidHom
  have hf_mon_inj : Function.Injective f_mon := by
    intro ι₁ ι₂ h
    apply e_emb.injective
    ext u
    exact DFunLike.congr_fun h u
  have h_linInd : LinearIndependent k (fun (ι : Fin m_c) (u : F₀) => emb ι u) := by
    simpa [Function.comp_def, f_mon] using
      (linearIndependent_monoidHom F₀ k).comp f_mon hf_mon_inj
  have hvec_inj : Function.Injective (fun w : Fin m_c → k => Matrix.vecMul w M) := by
    intro w₁ w₂ hw_eq
    let w : Fin m_c → k := w₁ - w₂
    have hw_basis : ∀ j : Fin m_c, ∑ ι : Fin m_c, w ι * emb ι (b j) = 0 := by
      intro j
      have hj := congrFun hw_eq j
      simp only [Matrix.vecMul, dotProduct, M, Matrix.of_apply] at hj
      simp only [w, Pi.sub_apply, sub_mul, Finset.sum_sub_distrib, hj, sub_self]
    have hw_all : ∑ ι : Fin m_c, w ι • (fun u : F₀ => emb ι u) = 0 := by
      ext u
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
      have hu : ∀ ι : Fin m_c,
          emb ι u = ∑ j : Fin m_c, algebraMap F k (b.repr u j) * emb ι (b j) := by
        intro ι
        conv_lhs => rw [← b.sum_repr u]
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_smul, Algebra.smul_def]
      simp_rw [hu, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero fun j _ => ?_
      have hmul : (∑ x : Fin m_c, w x * (algebraMap F k (b.repr u j) * emb x (b j))) =
          algebraMap F k (b.repr u j) * (∑ x : Fin m_c, w x * emb x (b j)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun x _ => by ring
      rw [hmul, hw_basis j, mul_zero]
    have hw_zero : ∀ ι : Fin m_c, w ι = 0 :=
      Fintype.linearIndependent_iff.mp h_linInd w hw_all
    ext ι
    exact sub_eq_zero.mp (hw_zero ι)
  have hUnit_M : IsUnit M := (Matrix.vecMul_injective_iff_isUnit (A := M)).mp hvec_inj
  have hM_inj : Function.Injective M.mulVec :=
    (Matrix.mulVec_injective_iff_isUnit (A := M)).mpr hUnit_M
  obtain ⟨u_M, hu_M⟩ := hUnit_M
  let N : Matrix (Fin m_c) (Fin m_c) k := ↑(u_M⁻¹)
  have hMN : M * N = 1 := by
    rw [← hu_M]
    exact Units.mul_inv u_M
  have hΦ_surj : Function.Surjective Φ := by
    intro y
    refine ⟨g (N.mulVec y), ?_⟩
    rw [hΦ_g, Matrix.mulVec_mulVec, hMN, Matrix.one_mulVec]
  have hΦ_inj : Function.Injective Φ := by
    intro x₁ x₂ hx
    obtain ⟨d₁, rfl⟩ := hg_surj x₁
    obtain ⟨d₂, rfl⟩ := hg_surj x₂
    rw [hΦ_g, hΦ_g] at hx
    rw [hM_inj hx]
  let Φ_ring : TensorProduct F F₀ k ≃+* (Fin m_c → k) :=
    (AlgEquiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩).toRingEquiv
  have hΦ_ring_tmul : ∀ (u : F₀) (c : k), Φ_ring (u ⊗ₜ[F] c) = fun ι => emb ι u * c :=
    hΦ_tmul

  
  let f₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₀))
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let S_F₀k := CategoryTheory.Limits.pullback f₁ f₂
  let pr_S₁ := CategoryTheory.Limits.pullback.fst f₁ f₂
  let pr_S₂ := CategoryTheory.Limits.pullback.snd f₁ f₂
  let iso_Φ : AlgebraicGeometry.Spec (CommRingCat.of (Fin m_c → k)) ≅
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F F₀ k)) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_ring.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_ring.symm.toRingHom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomp : Φ_ring.toRingHom.comp Φ_ring.symm.toRingHom = RingHom.id _ :=
          RingHom.ext fun x => Φ_ring.apply_symm_apply x
        rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomp : Φ_ring.symm.toRingHom.comp Φ_ring.toRingHom = RingHom.id _ :=
          RingHom.ext fun x => Φ_ring.symm_apply_apply x
        rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  let iso_S : AlgebraicGeometry.Spec (CommRingCat.of (Fin m_c → k)) ≅ S_F₀k :=
    iso_Φ ≪≫ (AlgebraicGeometry.pullbackSpecIso F F₀ k).symm
  have hiso_S_hom_inv : ∀ w, iso_S.inv.base (iso_S.hom.base w) = w := fun w => by
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, iso_S.hom_inv_id]
    rfl
  have hiso_S_inv_hom : ∀ y, iso_S.hom.base (iso_S.inv.base y) = y := fun y => by
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, iso_S.inv_hom_id]
    rfl
  let π_eval : ∀ ι : Fin m_c, (Fin m_c → k) →+* k :=
    fun ι => Pi.evalRingHom (fun _ : Fin m_c => k) ι
  let p_eval : ∀ ι : Fin m_c,
      Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
        (AlgebraicGeometry.Spec (CommRingCat.of (Fin m_c → k))) :=
    fun ι => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_eval ι))
  let s : ∀ ι : Fin m_c, Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) S_F₀k :=
    fun ι => p_eval ι ≫ iso_S.hom
  have hs_fst : ∀ ι : Fin m_c,
      s ι ≫ pr_S₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (emb ι).toRingHom) := by
    intro ι
    dsimp [s, p_eval, iso_S, iso_Φ, pr_S₁, f₁, f₂]
    rw [Category.assoc, Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply congrArg CommRingCat.ofHom
    exact RingHom.ext fun u => by simp [π_eval, hΦ_ring_tmul]
  have hs_snd : ∀ ι : Fin m_c,
      s ι ≫ pr_S₂ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    intro ι
    dsimp [s, p_eval, iso_S, iso_Φ, pr_S₂, f₁, f₂]
    rw [Category.assoc, Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_id, ← CommRingCat.ofHom_id]
    congr 1
    apply congrArg CommRingCat.ofHom
    exact RingHom.ext fun c => by simp [π_eval, hΦ_ring_tmul]
  have hs_open : ∀ ι : Fin m_c, AlgebraicGeometry.IsOpenImmersion (s ι) := by
    intro ι
    dsimp [s, p_eval]
    infer_instance
  have hs_closed : ∀ ι : Fin m_c, AlgebraicGeometry.IsClosedImmersion (s ι) := by
    intro ι
    have hπ_surj : Function.Surjective (π_eval ι) := fun c => ⟨fun _ => c, rfl⟩
    have _ : AlgebraicGeometry.IsClosedImmersion (p_eval ι) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (π_eval ι)) hπ_surj
    dsimp [s]
    infer_instance
  have hs_disj : ∀ ι₁ ι₂ : Fin m_c, ι₁ ≠ ι₂ →
      Disjoint (Set.range (s ι₁).base) (Set.range (s ι₂).base) := by
    intro ι₁ ι₂ hne
    rw [Set.disjoint_left]
    rintro y ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
    have h12 : (p_eval ι₁).base q₁ = (p_eval ι₂).base q₂ := by
      have h_eq : iso_S.hom.base ((p_eval ι₁).base q₁) = iso_S.hom.base ((p_eval ι₂).base q₂) := by
        calc iso_S.hom.base ((p_eval ι₁).base q₁)
            = (s ι₁).base q₁ := rfl
          _ = y := hq₁
          _ = (s ι₂).base q₂ := hq₂.symm
          _ = iso_S.hom.base ((p_eval ι₂).base q₂) := rfl
      have h_inv := congrArg iso_S.inv.base h_eq
      rwa [hiso_S_hom_inv, hiso_S_hom_inv] at h_inv
    let q₁' : PrimeSpectrum k := q₁
    let q₂' : PrimeSpectrum k := q₂
    have hcomap : PrimeSpectrum.comap (π_eval ι₁) q₁' = PrimeSpectrum.comap (π_eval ι₂) q₂' := by
      have h1 : (p_eval ι₁).base q₁ = PrimeSpectrum.comap (π_eval ι₁) q₁' :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (π_eval ι₁)) q₁'
      have h2 : (p_eval ι₂).base q₂ = PrimeSpectrum.comap (π_eval ι₂) q₂' :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (π_eval ι₂)) q₂'
      exact h1.symm.trans (h12.trans h2)
    let e₁ : Fin m_c → k := fun i => if i = ι₁ then 1 else 0
    have he₂ : e₁ ∈ (PrimeSpectrum.comap (π_eval ι₂) q₂').asIdeal := by
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      simp [π_eval, e₁, hne.symm]
    rw [← hcomap, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at he₂
    simp only [π_eval, Pi.evalRingHom_apply, e₁, ↓reduceIte] at he₂
    exact q₁'.isPrime.ne_top (top_unique fun x _ => by simpa using q₁'.asIdeal.mul_mem_left x he₂)
  have hs_univ : (⋃ ι : Fin m_c, Set.range (s ι).base) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro y
    let w : PrimeSpectrum (Fin m_c → k) := iso_S.inv.base y
    obtain ⟨ι, q, hq⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq w
    rw [Set.mem_iUnion]
    let q_spec : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := q
    refine ⟨ι, q_spec, ?_⟩
    have hpq : (p_eval ι).base q_spec = iso_S.inv.base y :=
      (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (π_eval ι)) q).trans hq
    calc (s ι).base q_spec
        = iso_S.hom.base ((p_eval ι).base q_spec) := rfl
      _ = iso_S.hom.base (iso_S.inv.base y) := by rw [hpq]
      _ = y := hiso_S_inv_hom y

  
  let Y_bar := weilBaseChangeOver F k Y_ov
  let pr_Y : Quiver.Hom Y_bar.left Y_ov.left := CategoryTheory.Limits.pullback.fst Y_ov.hom f₂
  have hpb_Ybar : CategoryTheory.IsPullback pr_Y Y_bar.hom Y_ov.hom f₂ :=
    CategoryTheory.IsPullback.of_hasPullback Y_ov.hom f₂
  have hpb_S : CategoryTheory.IsPullback pr_S₁ pr_S₂ f₁ f₂ :=
    CategoryTheory.IsPullback.of_hasPullback f₁ f₂
  have h_YS_comm : (pr_Y ≫ h_YF₀) ≫ f₁ = Y_bar.hom ≫ f₂ := by
    rw [Category.assoc, hYF₀_hom]
    exact CategoryTheory.Limits.pullback.condition
  let h_Y_S : Quiver.Hom Y_bar.left S_F₀k :=
    CategoryTheory.Limits.pullback.lift (pr_Y ≫ h_YF₀) Y_bar.hom h_YS_comm
  have hYS_fst : h_Y_S ≫ pr_S₁ = pr_Y ≫ h_YF₀ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hYS_snd : h_Y_S ≫ pr_S₂ = Y_bar.hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_outer_mid : CategoryTheory.IsPullback pr_Y (h_Y_S ≫ pr_S₂) (h_YF₀ ≫ f₁) f₂ := by
    rw [hYS_snd, hYF₀_hom]
    exact hpb_Ybar
  have hpb_mid : CategoryTheory.IsPullback pr_Y h_Y_S h_YF₀ pr_S₁ :=
    CategoryTheory.IsPullback.of_bot hpb_outer_mid hYS_fst.symm hpb_S
  let g_emb : ∀ ι : Fin m_c,
      Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
        (AlgebraicGeometry.Spec (CommRingCat.of F₀)) :=
    fun ι => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (emb ι).toRingHom)
  let Y_comp : Fin m_c → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    fun ι => CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd h_YF₀ (g_emb ι))
  let pr_comp : ∀ ι : Fin m_c, Quiver.Hom (Y_comp ι).left Y_ov.left :=
    fun ι => CategoryTheory.Limits.pullback.fst h_YF₀ (g_emb ι)
  have hpb_comp : ∀ ι : Fin m_c,
      CategoryTheory.IsPullback (pr_comp ι) (Y_comp ι).hom h_YF₀ (g_emb ι) :=
    fun ι => CategoryTheory.IsPullback.of_hasPullback h_YF₀ (g_emb ι)
  have hg_f₁ : ∀ ι : Fin m_c, g_emb ι ≫ f₁ = f₂ := by
    intro ι
    dsimp [g_emb, f₁, f₂]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 1
    exact congrArg CommRingCat.ofHom (RingHom.ext (emb ι).commutes)
  have h_inc_comm : ∀ ι : Fin m_c, pr_comp ι ≫ Y_ov.hom = (Y_comp ι).hom ≫ f₂ := by
    intro ι
    calc pr_comp ι ≫ Y_ov.hom
        = pr_comp ι ≫ (h_YF₀ ≫ f₁) := by rw [hYF₀_hom]
      _ = (pr_comp ι ≫ h_YF₀) ≫ f₁ := (Category.assoc _ _ _).symm
      _ = ((Y_comp ι).hom ≫ g_emb ι) ≫ f₁ := by
          rw [(hpb_comp ι).w]
      _ = (Y_comp ι).hom ≫ (g_emb ι ≫ f₁) := Category.assoc _ _ _
      _ = (Y_comp ι).hom ≫ f₂ := by rw [hg_f₁ ι]
  let inc_comp : ∀ ι : Fin m_c, Quiver.Hom (Y_comp ι).left Y_bar.left :=
    fun ι => CategoryTheory.Limits.pullback.lift (pr_comp ι) (Y_comp ι).hom (h_inc_comm ι)
  have hinc_fst : ∀ ι : Fin m_c, inc_comp ι ≫ pr_Y = pr_comp ι :=
    fun ι => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hinc_snd : ∀ ι : Fin m_c, inc_comp ι ≫ Y_bar.hom = (Y_comp ι).hom :=
    fun ι => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have h_sq_inc : ∀ ι : Fin m_c, inc_comp ι ≫ h_Y_S = (Y_comp ι).hom ≫ s ι := by
    intro ι
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc (inc_comp ι ≫ h_Y_S) ≫ pr_S₁
          = inc_comp ι ≫ (h_Y_S ≫ pr_S₁) := Category.assoc _ _ _
        _ = inc_comp ι ≫ (pr_Y ≫ h_YF₀) := by rw [hYS_fst]
        _ = (inc_comp ι ≫ pr_Y) ≫ h_YF₀ := (Category.assoc _ _ _).symm
        _ = pr_comp ι ≫ h_YF₀ := by rw [hinc_fst ι]
        _ = (Y_comp ι).hom ≫ g_emb ι := (hpb_comp ι).w
        _ = (Y_comp ι).hom ≫ (s ι ≫ pr_S₁) := by rw [hs_fst ι]
        _ = ((Y_comp ι).hom ≫ s ι) ≫ pr_S₁ := (Category.assoc _ _ _).symm
    · calc (inc_comp ι ≫ h_Y_S) ≫ pr_S₂
          = inc_comp ι ≫ (h_Y_S ≫ pr_S₂) := Category.assoc _ _ _
        _ = inc_comp ι ≫ Y_bar.hom := by rw [hYS_snd]
        _ = (Y_comp ι).hom := hinc_snd ι
        _ = (Y_comp ι).hom ≫ 𝟙 _ := (Category.comp_id _).symm
        _ = (Y_comp ι).hom ≫ (s ι ≫ pr_S₂) := by rw [hs_snd ι]
        _ = ((Y_comp ι).hom ≫ s ι) ≫ pr_S₂ := (Category.assoc _ _ _).symm
  have hpb_inc : ∀ ι : Fin m_c,
      CategoryTheory.IsPullback (inc_comp ι) (Y_comp ι).hom h_Y_S (s ι) := by
    intro ι
    have hpb_outer : CategoryTheory.IsPullback (inc_comp ι ≫ pr_Y) (Y_comp ι).hom
        h_YF₀ (s ι ≫ pr_S₁) := by
      rw [hinc_fst ι, hs_fst ι]
      exact hpb_comp ι
    exact CategoryTheory.IsPullback.of_right hpb_outer (h_sq_inc ι) hpb_mid
  have hOpen_inc : ∀ ι : Fin m_c, AlgebraicGeometry.IsOpenImmersion (inc_comp ι) :=
    fun ι => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hpb_inc ι).flip (hs_open ι)
  have hClosed_inc : ∀ ι : Fin m_c, AlgebraicGeometry.IsClosedImmersion (inc_comp ι) :=
    fun ι => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hpb_inc ι).flip (hs_closed ι)
  have _ : AlgebraicGeometry.IsProper Y_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Ybar inferInstance
  have hProper_comp : ∀ ι : Fin m_c, AlgebraicGeometry.IsProper (Y_comp ι).hom := by
    intro ι
    have _ : AlgebraicGeometry.IsClosedImmersion (inc_comp ι) := hClosed_inc ι
    have _ : AlgebraicGeometry.IsFinite (inc_comp ι) :=
      ((AlgebraicGeometry.IsClosedImmersion.iff_isFinite_and_mono (inc_comp ι)).mp
        (hClosed_inc ι)).1
    rw [← hinc_snd ι]
    infer_instance
  have hrange_inc : ∀ ι : Fin m_c,
      Set.range (inc_comp ι).base = h_Y_S.base ⁻¹' Set.range (s ι).base := by
    intro ι
    let e_pb := (hpb_inc ι).isoPullback
    have he_fst : inc_comp ι = e_pb.hom ≫ CategoryTheory.Limits.pullback.fst h_Y_S (s ι) :=
      ((hpb_inc ι).isoPullback_hom_fst).symm
    have hsurj_e : Function.Surjective e_pb.hom.base := by
      intro z
      refine ⟨e_pb.inv.base z, ?_⟩
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, e_pb.inv_hom_id]
      rfl
    have hrange_eq : Set.range (inc_comp ι).base =
        Set.range (CategoryTheory.Limits.pullback.fst h_Y_S (s ι)).base := by
      rw [he_fst]
      ext x
      simp only [Set.mem_range, AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact ⟨fun ⟨w, hw⟩ => ⟨e_pb.hom.base w, hw⟩,
        fun ⟨z, hz⟩ => let ⟨w, hw⟩ := hsurj_e z; ⟨w, by rw [hw, hz]⟩⟩
    rw [hrange_eq]
    simpa using AlgebraicGeometry.Scheme.Pullback.range_fst h_Y_S (s ι)
  refine ⟨m_c, emb, Y_comp, inc_comp, pr_comp, hm_c,
    fun ι => ⟨hpb_comp ι, hinc_fst ι, hinc_snd ι, hOpen_inc ι, hClosed_inc ι, hProper_comp ι⟩,
    ?_, ?_⟩
  · intro ι₁ ι₂ hne
    rw [hrange_inc ι₁, hrange_inc ι₂]
    exact (hs_disj ι₁ ι₂ hne).preimage h_Y_S.base
  · simp_rw [hrange_inc, ← Set.preimage_iUnion, hs_univ, Set.preimage_univ]

theorem weil_constField_chart_tensor_integrallyClosed_krullDim_one (F F₀ L₀ k : Type u)
    [Field F] [Finite F] [Field F₀] [Finite F₀] [Field L₀] [Field k] [IsAlgClosed k]
    [Algebra F F₀] [Algebra F L₀] [Algebra F₀ L₀] [IsScalarTower F F₀ L₀]
    [Algebra F k] [Algebra.IsAlgebraic F k] [Algebra F₀ k] [IsScalarTower F F₀ k]
    (hF₀_algClosed : ∀ x : L₀, IsIntegral F x → ∃ c : F₀, algebraMap F₀ L₀ c = x)
    (A B : Type u) [CommRing A] [CommRing B] [IsIntegrallyClosed B]
    [Algebra F A] [Algebra F₀ B]
    (φ_A : Polynomial F ≃+* A)
    (hφ_A : ∀ c : F, φ_A (Polynomial.C c) = algebraMap F A c)
    (f_AB : A →+* B)
    (hf_fin : f_AB.Finite)
    (hf_inj : Function.Injective f_AB)
    (hf_F : ∀ c : F, f_AB (algebraMap F A c) = algebraMap F₀ B (algebraMap F F₀ c))
    (ι_K : B →+* L₀)
    (hι_inj : Function.Injective ι_K)
    (hFrac : @IsFractionRing B _ L₀ _ ι_K.toAlgebra)
    (hι_F₀ : ∀ c : F₀, ι_K (algebraMap F₀ B c) = algebraMap F₀ L₀ c) :
    let A_k := TensorProduct F A k
    let C := TensorProduct F₀ B k
    letI : Algebra k C := Algebra.TensorProduct.rightAlgebra
    Nontrivial A_k ∧
    IsDomain C ∧
    IsIntegrallyClosed C ∧
    Algebra.FiniteType k C ∧
    ringKrullDim C = (1 : WithBot ℕ∞) ∧
    (∀ p : Ideal C, p.IsPrime → p.height ≤ 1) ∧
    ∃ θ : A_k →+* C,
      (∀ (a : A) (c : k), θ (a ⊗ₜ[F] c) = f_AB a ⊗ₜ[F₀] c) ∧
      (∀ q : Ideal A_k, q.IsPrime → ∃ P : Ideal C, P.IsPrime ∧ Ideal.comap θ P = q) :=
by
  classical
  let A_k := TensorProduct F A k
  let C := TensorProduct F₀ B k
  letI : Algebra k C := Algebra.TensorProduct.rightAlgebra
  
  haveI : PerfectField F₀ := PerfectField.ofFinite
  haveI : Algebra.IsIntegral F F₀ := Algebra.IsIntegral.of_finite F F₀
  have hF₀_closed : ∀ x : L₀, IsIntegral F₀ x → ∃ c : F₀, algebraMap F₀ L₀ c = x := by
    intro x hx
    exact hF₀_algClosed x (isIntegral_trans (R := F) x hx)
  haveI : Algebra.IsIntegral F k := Algebra.isAlgebraic_iff_isIntegral.mp inferInstance
  have hk_intF₀ : ∀ c : k, IsIntegral F₀ c := fun c =>
    IsIntegral.tower_top (Algebra.IsIntegral.isIntegral (R := F) c)
  haveI : Algebra.IsIntegral F₀ k := ⟨hk_intF₀⟩
  haveI : Algebra.IsAlgebraic F₀ k := Algebra.isAlgebraic_iff_isIntegral.mpr inferInstance
  have hinj_tmul_one : ∀ (M : Type u) [AddCommGroup M] [Module F₀ M],
      Function.Injective (fun m : M => m ⊗ₜ[F₀] (1 : k)) := by
    intro M _ _ m₁ m₂ hm
    have h1 : Function.Injective (LinearMap.lTensor M (Algebra.linearMap F₀ k)) :=
      Module.Flat.lTensor_preserves_injective_linearMap (Algebra.linearMap F₀ k)
        (RingHom.injective (algebraMap F₀ k))
    have h2 : LinearMap.lTensor M (Algebra.linearMap F₀ k) (m₁ ⊗ₜ[F₀] (1 : F₀)) =
        LinearMap.lTensor M (Algebra.linearMap F₀ k) (m₂ ⊗ₜ[F₀] (1 : F₀)) := by
      simpa using hm
    exact (TensorProduct.rid F₀ M).symm.injective (h1 h2)
  have h_tmul_F : ∀ r : F,
      (1 : B) ⊗ₜ[F₀] algebraMap F k r =
        (algebraMap F₀ B (algebraMap F F₀ r)) ⊗ₜ[F₀] (1 : k) := by
    intro r
    rw [IsScalarTower.algebraMap_apply F F₀ k r,
      Algebra.algebraMap_eq_smul_one (R := F₀) (A := k),
      ← TensorProduct.smul_tmul,
      ← Algebra.algebraMap_eq_smul_one (R := F₀) (A := B)]

  
  have hΨ_ex : ∃ Ψ_A : Polynomial k ≃+* A_k,
      (∀ c : k, Ψ_A (Polynomial.C c) = (1 : A) ⊗ₜ[F] c) ∧
      Ψ_A Polynomial.X = φ_A Polynomial.X ⊗ₜ[F] (1 : k) := by
    let φ_A_alg : Polynomial F ≃ₐ[F] A := AlgEquiv.ofRingEquiv (f := φ_A) hφ_A
    let Ψ_A : Polynomial k ≃+* A_k :=
      (polyEquivTensor F k).toRingEquiv.trans
        ((Algebra.TensorProduct.comm F k (Polynomial F)).toRingEquiv.trans
          (Algebra.TensorProduct.congr φ_A_alg (AlgEquiv.refl : k ≃ₐ[F] k)).toRingEquiv)
    refine ⟨Ψ_A, ?_, ?_⟩
    · intro c
      dsimp [Ψ_A, φ_A_alg]
      rw [Polynomial.eval₂_C]
      simp
    · dsimp [Ψ_A, φ_A_alg]
      rw [Polynomial.eval₂_X]
      simp
  obtain ⟨Ψ_A, hΨ_C, hΨ_X⟩ := hΨ_ex
  have hNontriv_Ak : Nontrivial A_k := Ψ_A.symm.toEquiv.nontrivial

  have hθ_ex : ∃ θ : A_k →+* C, ∀ (a : A) (c : k), θ (a ⊗ₜ[F] c) = f_AB a ⊗ₜ[F₀] c := by
    letI : Algebra F C := ((algebraMap F₀ C).comp (algebraMap F F₀)).toAlgebra
    let g_A : A →ₐ[F] C :=
      { toRingHom := Algebra.TensorProduct.includeLeftRingHom.comp f_AB
        commutes' := fun r => by
          change f_AB (algebraMap F A r) ⊗ₜ[F₀] (1 : k) =
            (algebraMap F₀ B (algebraMap F F₀ r)) ⊗ₜ[F₀] (1 : k)
          rw [hf_F r] }
    let g_k : k →ₐ[F] C :=
      { toRingHom := (Algebra.TensorProduct.includeRight : k →ₐ[F₀] C).toRingHom
        commutes' := fun r => by
          change (1 : B) ⊗ₜ[F₀] algebraMap F k r =
            (algebraMap F₀ B (algebraMap F F₀ r)) ⊗ₜ[F₀] (1 : k)
          exact h_tmul_F r }
    let θ_alg : A_k →ₐ[F] C :=
      Algebra.TensorProduct.lift g_A g_k (fun _ _ => Commute.all _ _)
    refine ⟨θ_alg.toRingHom, fun a c => ?_⟩
    change (f_AB a ⊗ₜ[F₀] (1 : k)) * ((1 : B) ⊗ₜ[F₀] c) = f_AB a ⊗ₜ[F₀] c
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  obtain ⟨θ, hθ⟩ := hθ_ex

  let ψ_poly : Polynomial k →+* C := θ.comp Ψ_A.toRingHom
  have hψ_C : ∀ c : k, ψ_poly (Polynomial.C c) = (1 : B) ⊗ₜ[F₀] c := by
    intro c
    change θ (Ψ_A (Polynomial.C c)) = (1 : B) ⊗ₜ[F₀] c
    rw [hΨ_C, hθ, map_one]
  have hψ_X : ψ_poly Polynomial.X = f_AB (φ_A Polynomial.X) ⊗ₜ[F₀] (1 : k) := by
    change θ (Ψ_A Polynomial.X) = f_AB (φ_A Polynomial.X) ⊗ₜ[F₀] (1 : k)
    rw [hΨ_X, hθ]
  have hψ_mapF : ∀ P : Polynomial F,
      ψ_poly (P.map (algebraMap F k)) = f_AB (φ_A P) ⊗ₜ[F₀] (1 : k) := by
    have h_ext : ψ_poly.comp (Polynomial.mapRingHom (algebraMap F k)) =
        Algebra.TensorProduct.includeLeftRingHom.comp (f_AB.comp φ_A.toRingHom) := by
      apply Polynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C, hψ_C,
          RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, hφ_A, hf_F,
          Algebra.TensorProduct.includeLeftRingHom_apply]
        exact h_tmul_F r
      · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X, hψ_X,
          RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeLeftRingHom_apply]
    intro P
    exact RingHom.congr_fun h_ext P

  have hψ_fin : ψ_poly.Finite := by
    have hs_B : ∃ s_B : Finset B, ∀ b : B, ∃ coeff : B → A, b = ∑ g ∈ s_B, f_AB (coeff g) * g := by
      letI : Algebra A B := f_AB.toAlgebra
      haveI : Module.Finite A B := hf_fin
      obtain ⟨s_B, hs_span⟩ := Module.Finite.fg_top (R := A) (M := B)
      refine ⟨s_B, fun b => ?_⟩
      have hb : b ∈ Submodule.span A (s_B : Set B) := by
        rw [hs_span]
        trivial
      obtain ⟨coeff, -, hsum⟩ := Submodule.mem_span_finset.mp hb
      exact ⟨coeff, hsum.symm⟩
    obtain ⟨s_B, hs_B⟩ := hs_B
    letI : Algebra (Polynomial k) C := ψ_poly.toAlgebra
    change Module.Finite (Polynomial k) C
    let S_C : Finset C := s_B.image (fun g : B => g ⊗ₜ[F₀] (1 : k))
    refine Module.finite_def.mpr ⟨S_C, ?_⟩
    suffices h_all : ∀ z : C, z ∈ Submodule.span (Polynomial k) (S_C : Set C) from
      eq_top_iff.mpr fun z _ => h_all z
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact Submodule.zero_mem _
    | tmul b c =>
      obtain ⟨coeff, rfl⟩ := hs_B b
      have hsum_tmul : (∑ g ∈ s_B, f_AB (coeff g) * g) ⊗ₜ[F₀] c =
          ∑ g ∈ s_B, (f_AB (coeff g) * g) ⊗ₜ[F₀] c :=
        map_sum ((TensorProduct.mk F₀ B k).flip c) (fun g => f_AB (coeff g) * g) s_B
      rw [hsum_tmul]
      refine Submodule.sum_mem _ fun g hg => ?_
      let P_g : Polynomial F := φ_A.symm (coeff g)
      have hPg : φ_A P_g = coeff g := φ_A.apply_symm_apply (coeff g)
      let q_g : Polynomial k := P_g.map (algebraMap F k) * Polynomial.C c
      have h_eq : (f_AB (coeff g) * g) ⊗ₜ[F₀] c = q_g • (g ⊗ₜ[F₀] (1 : k)) := by
        change (f_AB (coeff g) * g) ⊗ₜ[F₀] c = ψ_poly q_g * (g ⊗ₜ[F₀] (1 : k))
        dsimp [q_g]
        rw [map_mul, hψ_mapF, hPg, hψ_C, Algebra.TensorProduct.tmul_mul_tmul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, mul_one]
      rw [h_eq]
      exact Submodule.smul_mem _ q_g
        (Submodule.subset_span (Finset.mem_image_of_mem _ hg))
    | add x y hx hy => exact Submodule.add_mem _ hx hy

  have hFT_C : Algebra.FiniteType k C := by
    letI : Algebra (Polynomial k) C := ψ_poly.toAlgebra
    haveI : Module.Finite (Polynomial k) C := hψ_fin
    haveI : IsScalarTower k (Polynomial k) C :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun c => (hψ_C c).symm)
    exact Algebra.FiniteType.trans (R := k) (S := Polynomial k) (A := C) inferInstance inferInstance

  have hψ_int : ψ_poly.IsIntegral := RingHom.Finite.to_isIntegral hψ_fin
  have hθ_int : θ.IsIntegral := by
    intro z
    obtain ⟨P, hP_mon, hP_eval⟩ := hψ_int z
    refine ⟨P.map Ψ_A.toRingHom, hP_mon.map Ψ_A.toRingHom, ?_⟩
    rw [Polynomial.eval₂_map]
    have hcomp : θ.comp Ψ_A.toRingHom = ψ_poly := rfl
    rwa [hcomp]

  have hψ_inj : Function.Injective ψ_poly := by
    intro Q_a Q_b hQ_eq
    rw [← sub_eq_zero]
    set Q : Polynomial k := Q_a - Q_b
    have hQ_ker : ψ_poly Q = 0 := by rw [map_sub, hQ_eq, sub_self]
    by_contra hQ_ne
    let u : k := Q.leadingCoeff
    have hu : u ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hQ_ne
    let Q₁ : Polynomial k := Polynomial.C u⁻¹ * Q
    have hQ₁_mon : Q₁.Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
      exact inv_mul_cancel₀ hu
    have hQ₁_eval : ψ_poly Q₁ = 0 := by
      dsimp [Q₁]
      rw [map_mul, hQ_ker, mul_zero]
    let X_C : C := f_AB (φ_A Polynomial.X) ⊗ₜ[F₀] (1 : k)
    have hψ_eq_eval : ∀ R : Polynomial k, ψ_poly R = Polynomial.eval₂ (algebraMap k C) X_C R := by
      intro R
      have hext : ψ_poly = Polynomial.eval₂RingHom (algebraMap k C) X_C := by
        apply Polynomial.ringHom_ext
        · intro c
          change ψ_poly (Polynomial.C c) = Polynomial.eval₂ (algebraMap k C) X_C (Polynomial.C c)
          rw [hψ_C, Polynomial.eval₂_C]
          rfl
        · change ψ_poly Polynomial.X = Polynomial.eval₂ (algebraMap k C) X_C Polynomial.X
          rw [hψ_X, Polynomial.eval₂_X]
      exact RingHom.congr_fun hext R
    have hXC_int_k : _root_.IsIntegral k X_C :=
      ⟨Q₁, hQ₁_mon, (hψ_eq_eval Q₁).symm.trans hQ₁_eval⟩
    letI : Algebra F C := ((algebraMap k C).comp (algebraMap F k)).toAlgebra
    haveI : IsScalarTower F k C := IsScalarTower.of_algebraMap_eq' rfl
    have hXC_int_F : _root_.IsIntegral F X_C := isIntegral_trans (R := F) X_C hXC_int_k
    obtain ⟨M, hM_mon, hM_eval⟩ := hXC_int_F
    have hM_map : Polynomial.eval₂ (algebraMap F C) X_C M =
        f_AB (φ_A M) ⊗ₜ[F₀] (1 : k) := by
      change Polynomial.eval₂ ((algebraMap k C).comp (algebraMap F k)) X_C M = _
      rw [← Polynomial.eval₂_map, ← hψ_eq_eval, hψ_mapF]
    rw [hM_map] at hM_eval
    have hM_zero : M = 0 :=
      φ_A.injective (hf_inj (hinj_tmul_one B (by simpa using hM_eval)))
    exact hM_mon.ne_zero hM_zero

  have hθ_inj : Function.Injective θ := by
    have hθ_eq : θ = ψ_poly.comp Ψ_A.symm.toRingHom :=
      RingHom.ext fun x => by
        change θ x = θ (Ψ_A (Ψ_A.symm x))
        rw [Ψ_A.apply_symm_apply]
    rw [hθ_eq]
    exact hψ_inj.comp Ψ_A.symm.injective

  
  have he_TP_gen : ∀ (P : Polynomial F₀) (P_L : Polynomial L₀),
      P_L = P.map (algebraMap F₀ L₀) →
      Nonempty (TensorProduct F₀ L₀ (AdjoinRoot P) ≃+* AdjoinRoot P_L) := by
    intro P P_L hPL_def
    let T := TensorProduct F₀ L₀ (AdjoinRoot P)
    let R_L := AdjoinRoot P_L
    have hev_fwd : Polynomial.eval₂ (algebraMap F₀ R_L) (AdjoinRoot.root P_L) P = 0 := by
      rw [IsScalarTower.algebraMap_eq F₀ L₀ R_L, ← Polynomial.eval₂_map, ← hPL_def]
      exact AdjoinRoot.eval₂_root P_L
    let g_L : L₀ →ₐ[F₀] R_L := IsScalarTower.toAlgHom F₀ L₀ R_L
    let g_P : AdjoinRoot P →ₐ[F₀] R_L :=
      { toRingHom := AdjoinRoot.lift (algebraMap F₀ R_L) (AdjoinRoot.root P_L) hev_fwd
        commutes' := fun _ => AdjoinRoot.lift_of hev_fwd }
    let φ_fwd_alg : T →ₐ[F₀] R_L :=
      Algebra.TensorProduct.lift g_L g_P (fun _ _ => Commute.all _ _)
    let φ_fwd : T →+* R_L := φ_fwd_alg.toRingHom
    have hφ_fwd_tmul : ∀ (l : L₀) (x : AdjoinRoot P), φ_fwd (l ⊗ₜ[F₀] x) = g_L l * g_P x := by
      intro l x
      simp only [φ_fwd, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      exact Algebra.TensorProduct.lift_tmul g_L g_P (fun _ _ => Commute.all _ _) l x
    let incR : AdjoinRoot P →+* T :=
      (Algebra.TensorProduct.includeRight : AdjoinRoot P →ₐ[F₀] T).toRingHom
    have hev_inv : Polynomial.eval₂
        (Algebra.TensorProduct.includeLeftRingHom : L₀ →+* T)
        (incR (AdjoinRoot.root P)) P_L = 0 := by
      rw [hPL_def, Polynomial.eval₂_map]
      have h_hom : (Algebra.TensorProduct.includeLeftRingHom : L₀ →+* T).comp
          (algebraMap F₀ L₀) = incR.comp (AdjoinRoot.of P) := by
        refine RingHom.ext fun c => ?_
        change (algebraMap F₀ L₀ c) ⊗ₜ[F₀] (1 : AdjoinRoot P) =
          (1 : L₀) ⊗ₜ[F₀] (AdjoinRoot.of P c)
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
          ← Algebra.algebraMap_eq_smul_one]
        rfl
      rw [h_hom, ← Polynomial.hom_eval₂, AdjoinRoot.eval₂_root, map_zero]
    let φ_inv : R_L →+* T :=
      AdjoinRoot.lift (Algebra.TensorProduct.includeLeftRingHom : L₀ →+* T)
        (incR (AdjoinRoot.root P)) hev_inv
    have h_fwd_inv : φ_fwd.comp φ_inv = RingHom.id R_L := by
      apply AdjoinRoot.ringHom_ext
      · refine RingHom.ext fun l => ?_
        simp only [RingHom.comp_apply]
        change φ_fwd (φ_inv (AdjoinRoot.of P_L l)) = AdjoinRoot.of P_L l
        rw [AdjoinRoot.lift_of]
        change φ_fwd (l ⊗ₜ[F₀] (1 : AdjoinRoot P)) = AdjoinRoot.of P_L l
        rw [hφ_fwd_tmul, map_one, mul_one]
        rfl
      · simp only [RingHom.comp_apply]
        change φ_fwd (φ_inv (AdjoinRoot.root P_L)) = AdjoinRoot.root P_L
        rw [AdjoinRoot.lift_root]
        change φ_fwd ((1 : L₀) ⊗ₜ[F₀] AdjoinRoot.root P) = AdjoinRoot.root P_L
        rw [hφ_fwd_tmul, map_one, one_mul]
        exact AdjoinRoot.lift_root hev_fwd
    have h_inv_right : ∀ x : AdjoinRoot P,
        φ_inv (φ_fwd ((1 : L₀) ⊗ₜ[F₀] x)) = (1 : L₀) ⊗ₜ[F₀] x := by
      let u₁ : AdjoinRoot P →+* T := φ_inv.comp (φ_fwd.comp incR)
      let u₂ : AdjoinRoot P →+* T := incR
      have hu : u₁ = u₂ := by
        apply AdjoinRoot.ringHom_ext
        · refine RingHom.ext fun c => ?_
          simp only [u₁, u₂, RingHom.comp_apply]
          change φ_inv (φ_fwd ((1 : L₀) ⊗ₜ[F₀] AdjoinRoot.of P c)) =
            (1 : L₀) ⊗ₜ[F₀] AdjoinRoot.of P c
          rw [hφ_fwd_tmul, map_one, one_mul]
          have hgc : g_P (AdjoinRoot.of P c) = AdjoinRoot.of P_L (algebraMap F₀ L₀ c) := by
            change g_P (algebraMap F₀ (AdjoinRoot P) c) = _
            rw [g_P.commutes c, IsScalarTower.algebraMap_apply F₀ L₀ R_L c]
            rfl
          rw [hgc, AdjoinRoot.lift_of]
          change (algebraMap F₀ L₀ c) ⊗ₜ[F₀] (1 : AdjoinRoot P) =
            (1 : L₀) ⊗ₜ[F₀] AdjoinRoot.of P c
          rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
            ← Algebra.algebraMap_eq_smul_one]
          rfl
        · simp only [u₁, u₂, RingHom.comp_apply]
          change φ_inv (φ_fwd ((1 : L₀) ⊗ₜ[F₀] AdjoinRoot.root P)) =
            (1 : L₀) ⊗ₜ[F₀] AdjoinRoot.root P
          rw [hφ_fwd_tmul, map_one, one_mul]
          have hgr : g_P (AdjoinRoot.root P) = AdjoinRoot.root P_L :=
            AdjoinRoot.lift_root hev_fwd
          rw [hgr, AdjoinRoot.lift_root]
          rfl
      intro x
      exact RingHom.congr_fun hu x
    have h_inv_fwd : ∀ z : T, φ_inv (φ_fwd z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul l x =>
        have hdecomp : (l ⊗ₜ[F₀] x : T) = (l ⊗ₜ[F₀] 1) * (1 ⊗ₜ[F₀] x) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hdecomp, map_mul, map_mul, h_inv_right x]
        have hl : φ_inv (φ_fwd (l ⊗ₜ[F₀] (1 : AdjoinRoot P))) = l ⊗ₜ[F₀] (1 : AdjoinRoot P) := by
          rw [hφ_fwd_tmul, map_one, mul_one]
          exact AdjoinRoot.lift_of hev_inv
        rw [hl]
      | add y₁ y₂ hy₁ hy₂ => rw [map_add, map_add, hy₁, hy₂]
    exact ⟨RingEquiv.ofRingHom φ_fwd φ_inv h_fwd_inv (RingHom.ext h_inv_fwd)⟩

  have hIrr_map : ∀ (P : Polynomial F₀) (P_L : Polynomial L₀),
      P.Monic → Irreducible P → P_L = P.map (algebraMap F₀ L₀) → Irreducible P_L := by
    intro P P_L hP_mon hP_irr hPL_def
    have hPL_mon : P_L.Monic := hPL_def ▸ hP_mon.map (algebraMap F₀ L₀)
    have hPL_deg : P_L.natDegree = P.natDegree := by
      rw [hPL_def]
      exact Polynomial.natDegree_map_eq_of_injective (RingHom.injective (algebraMap F₀ L₀)) P
    have hP_pos : 0 < P.natDegree := Irreducible.natDegree_pos hP_irr
    have hPL_not_unit : ¬ IsUnit P_L := by
      intro hu
      have h0 := Polynomial.natDegree_eq_zero_of_isUnit hu
      omega
    refine ⟨hPL_not_unit, ?_⟩
    intro Q R hQR
    have hPL_ne : P_L ≠ 0 := hPL_mon.ne_zero
    have hQR_ne : Q * R ≠ 0 := hQR ▸ hPL_ne
    have hQ_ne : Q ≠ 0 := left_ne_zero_of_mul hQR_ne
    have hR_ne : R ≠ 0 := right_ne_zero_of_mul hQR_ne
    let u_Q : L₀ := Q.leadingCoeff
    have hu_Q : u_Q ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hQ_ne
    let Q₁ : Polynomial L₀ := Polynomial.C u_Q⁻¹ * Q
    have hQ₁_mon : Q₁.Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
      exact inv_mul_cancel₀ hu_Q
    have hQ₁_deg : Q₁.natDegree = Q.natDegree := Polynomial.natDegree_C_mul (inv_ne_zero hu_Q)
    have hQ₁_dvd : Q₁ ∣ P_L := ⟨Polynomial.C u_Q * R, by
      calc P_L = 1 * (Q * R) := by rw [one_mul, hQR]
        _ = (Polynomial.C u_Q⁻¹ * Polynomial.C u_Q) * (Q * R) := by
            rw [← Polynomial.C_mul, inv_mul_cancel₀ hu_Q, Polynomial.C_1]
        _ = Q₁ * (Polynomial.C u_Q * R) := by dsimp [Q₁]; ring⟩
    let Ω := AlgebraicClosure L₀
    let Q_Ω : Polynomial Ω := Q₁.map (algebraMap L₀ Ω)
    let P_Ω : Polynomial Ω := P_L.map (algebraMap L₀ Ω)
    have hQΩ_mon : Q_Ω.Monic := hQ₁_mon.map (algebraMap L₀ Ω)
    have hQΩ_dvd : Q_Ω ∣ P_Ω := Polynomial.map_dvd (algebraMap L₀ Ω) hQ₁_dvd
    have hPΩ_eq : P_Ω = P.map (algebraMap F₀ Ω) := by
      dsimp [P_Ω]
      rw [hPL_def, Polynomial.map_map, ← IsScalarTower.algebraMap_eq F₀ L₀ Ω]
    have hQΩ_prod : Q_Ω = (Q_Ω.roots.map (fun β : Ω => Polynomial.X - Polynomial.C β)).prod :=
      Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits Q_Ω) hQΩ_mon
    have hroots_int : ∀ β ∈ Q_Ω.roots, IsIntegral F₀ β := by
      intro β hβ
      have hβ_Q : Polynomial.eval β Q_Ω = 0 := (Polynomial.mem_roots'.mp hβ).2
      obtain ⟨S_Ω, hS_Ω⟩ := hQΩ_dvd
      have hβ_P : Polynomial.eval β P_Ω = 0 := by
        rw [hS_Ω, Polynomial.eval_mul, hβ_Q, zero_mul]
      rw [hPΩ_eq, Polynomial.eval_map] at hβ_P
      exact ⟨P, hP_mon, hβ_P⟩
    have hprod_int : ∀ (M : Multiset Ω), (∀ β ∈ M, IsIntegral F₀ β) →
        ∃ F_int : Polynomial ↥(integralClosure F₀ Ω),
          F_int.map (integralClosure F₀ Ω).val.toRingHom =
            (M.map (fun β : Ω => Polynomial.X - Polynomial.C β)).prod := by
      intro M
      induction M using Multiset.induction_on with
      | empty =>
        intro _
        exact ⟨1, by simp⟩
      | cons a s ih =>
        intro hMs
        have ha : IsIntegral F₀ a := hMs a (Multiset.mem_cons_self a s)
        obtain ⟨F_s, hFs⟩ := ih (fun β hβ => hMs β (Multiset.mem_cons_of_mem hβ))
        refine ⟨(Polynomial.X - Polynomial.C ⟨a, ha⟩) * F_s, ?_⟩
        rw [Multiset.map_cons, Multiset.prod_cons, Polynomial.map_mul, Polynomial.map_sub,
          Polynomial.map_X, Polynomial.map_C, hFs]
        rfl
    obtain ⟨F_int, hF_int⟩ := hprod_int Q_Ω.roots hroots_int
    have hQ₁_coeff_int : ∀ n : ℕ, IsIntegral F₀ (Q₁.coeff n) := by
      intro n
      have h_in_Ω : IsIntegral F₀ (algebraMap L₀ Ω (Q₁.coeff n)) := by
        have hc : algebraMap L₀ Ω (Q₁.coeff n) = (F_int.coeff n).1 := by
          have hc1 : Q_Ω.coeff n = algebraMap L₀ Ω (Q₁.coeff n) :=
            Polynomial.coeff_map (algebraMap L₀ Ω) n
          rw [← hc1, hQΩ_prod, ← hF_int, Polynomial.coeff_map]
          rfl
        rw [hc]
        exact (F_int.coeff n).2
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom F₀ L₀ Ω)
        (RingHom.injective (algebraMap L₀ Ω))).mp h_in_Ω
    choose c_fn hc_fn using fun n => hF₀_closed (Q₁.coeff n) (hQ₁_coeff_int n)
    let Q₀ : Polynomial F₀ :=
      ∑ n ∈ Finset.range (Q₁.natDegree + 1), Polynomial.monomial n (c_fn n)
    have hQ₀_map : Q₀.map (algebraMap F₀ L₀) = Q₁ := by
      ext k_idx
      rw [Polynomial.coeff_map]
      dsimp [Q₀]
      rw [Polynomial.finset_sum_coeff, map_sum]
      simp only [Polynomial.coeff_monomial, apply_ite (algebraMap F₀ L₀), map_zero, hc_fn]
      by_cases hk : k_idx < Q₁.natDegree + 1
      · rw [Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr hk)]
      · rw [Finset.sum_ite_eq', if_neg (by simpa using hk)]
        exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).symm
    have hQ₀_dvd : Q₀ ∣ P := by
      apply (Polynomial.map_dvd_map' (algebraMap F₀ L₀)).mp
      rw [hQ₀_map, ← hPL_def]
      exact hQ₁_dvd
    obtain ⟨R₀, hPR₀⟩ := hQ₀_dvd
    have hQ₀_deg : Q₀.natDegree = Q.natDegree := by
      have h1 := Polynomial.natDegree_map_eq_of_injective (RingHom.injective (algebraMap F₀ L₀)) Q₀
      rw [hQ₀_map, hQ₁_deg] at h1
      exact h1.symm
    rcases hP_irr.isUnit_or_isUnit hPR₀ with hQ₀_u | hR₀_u
    · left
      have hdeg0 : Q.natDegree = 0 := by
        rw [← hQ₀_deg]
        exact Polynomial.natDegree_eq_zero_of_isUnit hQ₀_u
      rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg0]
      have hc0 : Q.coeff 0 ≠ 0 := by
        intro h0
        apply hQ_ne
        rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg0, h0, map_zero]
      exact Polynomial.isUnit_C.mpr (IsUnit.mk0 _ hc0)
    · right
      have hP_ne : P ≠ 0 := hP_mon.ne_zero
      have hPR₀_ne : Q₀ * R₀ ≠ 0 := hPR₀ ▸ hP_ne
      have hdegP : P.natDegree = Q₀.natDegree + R₀.natDegree := by
        rw [hPR₀]
        exact Polynomial.natDegree_mul (left_ne_zero_of_mul hPR₀_ne)
          (right_ne_zero_of_mul hPR₀_ne)
      have hdegR₀ : R₀.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hR₀_u
      have hdegPL : P_L.natDegree = Q.natDegree + R.natDegree := by
        rw [hQR]
        exact Polynomial.natDegree_mul hQ_ne hR_ne
      have hdegR : R.natDegree = 0 := by omega
      rw [Polynomial.eq_C_of_natDegree_eq_zero hdegR]
      have hc0 : R.coeff 0 ≠ 0 := by
        intro h0
        apply hR_ne
        rw [Polynomial.eq_C_of_natDegree_eq_zero hdegR, h0, map_zero]
      exact Polynomial.isUnit_C.mpr (IsUnit.mk0 _ hc0)

  have hField_LE : ∀ (E : Type u) [Field E] [Algebra F₀ E] [FiniteDimensional F₀ E],
      IsField (TensorProduct F₀ L₀ E) := by
    intro E _ _ _
    haveI : Algebra.IsIntegral F₀ E := Algebra.IsIntegral.of_finite F₀ E
    haveI : Algebra.IsAlgebraic F₀ E := Algebra.isAlgebraic_iff_isIntegral.mpr inferInstance
    haveI : Algebra.IsSeparable F₀ E := Algebra.IsAlgebraic.isSeparable_of_perfectField
    obtain ⟨α, hα_top⟩ := Field.exists_primitive_element F₀ E
    have hα_int : IsIntegral F₀ α := Algebra.IsIntegral.isIntegral α
    let P : Polynomial F₀ := minpoly F₀ α
    have hP_mon : P.Monic := minpoly.monic hα_int
    have hP_irr : Irreducible P := minpoly.irreducible hα_int
    let e_E : AdjoinRoot P ≃ₐ[F₀] E :=
      (IntermediateField.adjoinRootEquivAdjoin F₀ hα_int).trans
        ((IntermediateField.equivOfEq hα_top).trans IntermediateField.topEquiv)
    let P_L : Polynomial L₀ := P.map (algebraMap F₀ L₀)
    obtain ⟨e_TP⟩ := he_TP_gen P P_L rfl
    have hPL_irr : Irreducible P_L := hIrr_map P P_L hP_mon hP_irr rfl
    letI : Fact (Irreducible P_L) := ⟨hPL_irr⟩
    let Ψ_tot : TensorProduct F₀ L₀ E ≃+* AdjoinRoot P_L :=
      (Algebra.TensorProduct.congr (AlgEquiv.refl : L₀ ≃ₐ[F₀] L₀) e_E.symm).toRingEquiv.trans e_TP
    exact MulEquiv.isField (Field.toIsField (AdjoinRoot P_L)) Ψ_tot.toMulEquiv

  let K_k := TensorProduct F₀ L₀ k
  have hField_Kk : IsField K_k :=
    { exists_pair_ne := ⟨0, 1, fun h01 =>
        zero_ne_one (α := L₀) (hinj_tmul_one L₀ (by simpa using h01))⟩
      mul_comm := mul_comm
      mul_inv_cancel := fun {z} hz => by
        obtain ⟨S, rfl⟩ := TensorProduct.exists_finset z
        let T_fin : Finset k := S.image Prod.snd
        let E' : IntermediateField F₀ k := IntermediateField.adjoin F₀ (T_fin : Set k)
        haveI : FiniteDimensional F₀ ↥E' :=
          IntermediateField.finiteDimensional_adjoin (fun c _ => hk_intF₀ c)
        let j_LE : TensorProduct F₀ L₀ ↥E' →+* K_k :=
          (Algebra.TensorProduct.map (AlgHom.id F₀ L₀) E'.val).toRingHom
        let z₀ : TensorProduct F₀ L₀ ↥E' :=
          ∑ p ∈ S.attach, p.1.1 ⊗ₜ[F₀]
            (⟨p.1.2, IntermediateField.subset_adjoin F₀ (T_fin : Set k)
              (Finset.mem_image_of_mem Prod.snd p.2)⟩ : ↥E')
        have hz_eq : j_LE z₀ = ∑ p ∈ S, p.1 ⊗ₜ[F₀] p.2 := by
          dsimp [z₀]
          rw [map_sum]
          conv_rhs => rw [← Finset.sum_attach S]
          refine Finset.sum_congr rfl fun p _ => ?_
          rfl
        have hz₀_ne : z₀ ≠ 0 := by
          intro h0
          apply hz
          rw [← hz_eq, h0, map_zero]
        obtain ⟨w₀, hw₀⟩ := (hField_LE ↥E').mul_inv_cancel hz₀_ne
        refine ⟨j_LE w₀, ?_⟩
        rw [← hz_eq, ← map_mul, hw₀, map_one] }

  have hj_BK_ex : ∃ j_BK : C →+* K_k,
      (∀ (b : B) (c : k), j_BK (b ⊗ₜ[F₀] c) = ι_K b ⊗ₜ[F₀] c) ∧
      Function.Injective j_BK := by
    letI : Algebra B L₀ := ι_K.toAlgebra
    haveI : IsScalarTower F₀ B L₀ :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun c => (hι_F₀ c).symm)
    let f_BL : B →ₐ[F₀] L₀ := IsScalarTower.toAlgHom F₀ B L₀
    let j_alg : C →ₐ[F₀] K_k := Algebra.TensorProduct.map f_BL (AlgHom.id F₀ k)
    have hinj : Function.Injective j_alg.toRingHom :=
      Module.Flat.rTensor_preserves_injective_linearMap f_BL.toLinearMap hι_inj
    exact ⟨j_alg.toRingHom, fun b c => rfl, hinj⟩
  obtain ⟨j_BK, hj_BK_tmul, hj_BK_inj⟩ := hj_BK_ex

  have hDom_C : IsDomain C := by
    letI : Field K_k := hField_Kk.toField
    exact Function.Injective.isDomain j_BK hj_BK_inj
  letI : IsDomain C := hDom_C

  
  have hIntCl_C : IsIntegrallyClosed C := by
    letI : Field K_k := hField_Kk.toField
    letI : Algebra C K_k := j_BK.toAlgebra
    letI : Algebra B L₀ := ι_K.toAlgebra
    haveI : IsDomain B := Function.Injective.isDomain ι_K hι_inj
    haveI : IsScalarTower F₀ B L₀ :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun c => (hι_F₀ c).symm)
    haveI : IsFractionRing B L₀ := hFrac
    have hFrac_C : IsFractionRing C K_k :=
      { map_units := fun y => by
          have hy : (y : C) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
          have hjy : j_BK y ≠ 0 := fun h0 => hy (hj_BK_inj (h0.trans (map_zero j_BK).symm))
          exact IsUnit.mk0 (j_BK y) hjy
        surj := fun z => by
          obtain ⟨S, rfl⟩ := TensorProduct.exists_finset z
          obtain ⟨d, hd_int⟩ :=
            IsLocalization.exist_integer_multiples (nonZeroDivisors B) S Prod.fst
          have hd_ne : (d : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
          have hιd_ne : ι_K d ≠ 0 := fun h0 => hd_ne (hι_inj (h0.trans (map_zero ι_K).symm))
          let d_C : C := (d : B) ⊗ₜ[F₀] (1 : k)
          have hd_C_ne : d_C ≠ 0 := by
            intro h0
            have h1 : j_BK d_C = 0 := by rw [h0, map_zero]
            rw [hj_BK_tmul] at h1
            exact hιd_ne (hinj_tmul_one L₀ (by simpa using h1))
          have hd_C_mem : d_C ∈ nonZeroDivisors C := mem_nonZeroDivisors_of_ne_zero hd_C_ne
          have hb_ex : ∀ p : {x // x ∈ S}, ∃ b : B, ι_K b = p.1.1 * ι_K d := by
            intro p
            obtain ⟨b, hb⟩ := hd_int p.1 p.2
            refine ⟨b, ?_⟩
            change ι_K b = ι_K d * p.1.1 at hb
            rw [hb, mul_comm]
          choose b_fn hb_fn using hb_ex
          let w_C : C := ∑ p ∈ S.attach, b_fn p ⊗ₜ[F₀] p.1.2
          refine ⟨(w_C, ⟨d_C, hd_C_mem⟩), ?_⟩
          change (∑ p ∈ S, p.1 ⊗ₜ[F₀] p.2) * j_BK d_C = j_BK w_C
          dsimp [d_C, w_C]
          rw [hj_BK_tmul, map_sum, ← Finset.sum_attach S, Finset.sum_mul]
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [hj_BK_tmul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, hb_fn p]
        exists_of_eq := fun {x y} hxy => ⟨1, by rw [hj_BK_inj hxy]⟩ }
    haveI : IsFractionRing C K_k := hFrac_C
    rw [isIntegrallyClosed_iff (K := K_k)]
    intro x hx
    obtain ⟨Q, hQ_mon, hQ_eval⟩ := hx
    let n : ℕ := Q.natDegree
    obtain ⟨S_x, hx_sum⟩ := TensorProduct.exists_finset x
    have hcoeff_fin : ∀ m : ℕ, ∃ S_m : Finset (B × k),
        Q.coeff m = ∑ p ∈ S_m, p.1 ⊗ₜ[F₀] p.2 := fun m => TensorProduct.exists_finset (Q.coeff m)
    choose S_coeff hS_coeff using hcoeff_fin
    let T_k : Finset k :=
      S_x.image Prod.snd ∪ (Finset.range n).biUnion (fun m => (S_coeff m).image Prod.snd)
    let E' : IntermediateField F₀ k := IntermediateField.adjoin F₀ (T_k : Set k)
    haveI : FiniteDimensional F₀ ↥E' :=
      IntermediateField.finiteDimensional_adjoin (fun c _ => hk_intF₀ c)
    haveI : Algebra.IsIntegral F₀ ↥E' := Algebra.IsIntegral.of_finite F₀ ↥E'
    haveI : Algebra.IsAlgebraic F₀ ↥E' := Algebra.isAlgebraic_iff_isIntegral.mpr inferInstance
    haveI : Algebra.IsSeparable F₀ ↥E' := Algebra.IsAlgebraic.isSeparable_of_perfectField
    let B_E := TensorProduct F₀ B ↥E'
    let L_E := TensorProduct F₀ L₀ ↥E'
    let j_BE : B_E →+* C := (Algebra.TensorProduct.map (AlgHom.id F₀ B) E'.val).toRingHom
    let j_LE : L_E →+* K_k := (Algebra.TensorProduct.map (AlgHom.id F₀ L₀) E'.val).toRingHom
    let j_BLE : B_E →+* L_E :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom F₀ B L₀) (AlgHom.id F₀ ↥E')).toRingHom
    have hj_LE_inj : Function.Injective j_LE :=
      Module.Flat.lTensor_preserves_injective_linearMap E'.val.toLinearMap E'.val.injective
    have hj_comm : j_LE.comp j_BLE = j_BK.comp j_BE := by
      refine RingHom.ext fun z₀ => ?_
      induction z₀ using TensorProduct.induction_on with
      | zero => simp
      | tmul b e_val =>
        simp only [RingHom.comp_apply]
        change ι_K b ⊗ₜ[F₀] (e_val : k) = j_BK (b ⊗ₜ[F₀] (e_val : k))
        rw [hj_BK_tmul]
      | add y₁ y₂ hy₁ hy₂ => rw [map_add, map_add, hy₁, hy₂]
    let x₀ : L_E :=
      ∑ p ∈ S_x.attach, p.1.1 ⊗ₜ[F₀]
        (⟨p.1.2, IntermediateField.subset_adjoin F₀ (T_k : Set k)
          (Finset.mem_union_left _ (Finset.mem_image_of_mem Prod.snd p.2))⟩ : ↥E')
    have hx₀ : j_LE x₀ = x := by
      dsimp [x₀]
      rw [map_sum, hx_sum, ← Finset.sum_attach S_x]
      exact Finset.sum_congr rfl fun _ _ => rfl
    let c₀_fn : ∀ m ∈ Finset.range n, B_E := fun m hm =>
      ∑ p ∈ (S_coeff m).attach, p.1.1 ⊗ₜ[F₀]
        (⟨p.1.2, IntermediateField.subset_adjoin F₀ (T_k : Set k)
          (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
            ⟨m, hm, Finset.mem_image_of_mem Prod.snd p.2⟩))⟩ : ↥E')
    have hc₀_fn : ∀ (m : ℕ) (hm : m ∈ Finset.range n), j_BE (c₀_fn m hm) = Q.coeff m := by
      intro m hm
      dsimp [c₀_fn]
      rw [map_sum, hS_coeff m, ← Finset.sum_attach (S_coeff m)]
      exact Finset.sum_congr rfl fun _ _ => rfl
    let Q₀ : Polynomial B_E :=
      Polynomial.X ^ n + ∑ m ∈ (Finset.range n).attach, Polynomial.monomial m.1 (c₀_fn m.1 m.2)
    have hsum_coeff_ge : ∀ k_idx : ℕ, n ≤ k_idx →
        (∑ m ∈ (Finset.range n).attach, Polynomial.monomial m.1 (c₀_fn m.1 m.2)).coeff k_idx = 0 := by
      intro k_idx hk
      rw [Polynomial.finset_sum_coeff]
      refine Finset.sum_eq_zero fun m _ => ?_
      rw [Polynomial.coeff_monomial, if_neg]
      have hm_lt : m.1 < n := Finset.mem_range.mp m.2
      omega
    have hQ₀_deg_le : Q₀.natDegree ≤ n := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro k_idx hk
      dsimp [Q₀]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega),
        hsum_coeff_ge k_idx (by omega), add_zero]
    have hQ₀_coeff_n : Q₀.coeff n = 1 := by
      dsimp [Q₀]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_pos rfl,
        hsum_coeff_ge n (le_refl n), add_zero]
    have hQ₀_mon : Q₀.Monic := by
      rcases eq_or_lt_of_le hQ₀_deg_le with hdeg_eq | hdeg_lt
      · rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg_eq, hQ₀_coeff_n]
      · exfalso
        have h0 : Q₀.coeff n = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt hdeg_lt
        rw [hQ₀_coeff_n] at h0
        exact one_ne_zero h0
    have hQ₀_map : Q₀.map j_BE = Q := by
      ext k_idx
      rw [Polynomial.coeff_map]
      rcases lt_trichotomy k_idx n with hlt | rfl | hgt
      · dsimp [Q₀]
        rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
          Polynomial.finset_sum_coeff, map_sum]
        have hk_mem : k_idx ∈ Finset.range n := Finset.mem_range.mpr hlt
        have hsingle : ∑ x ∈ (Finset.range n).attach,
            j_BE ((Polynomial.monomial x.1 (c₀_fn x.1 x.2)).coeff k_idx) =
            j_BE (c₀_fn k_idx hk_mem) := by
          rw [Finset.sum_eq_single ⟨k_idx, hk_mem⟩]
          · rw [Polynomial.coeff_monomial_same]
          · intro b _ hb_ne
            have hne : b.1 ≠ k_idx := fun h => hb_ne (Subtype.ext h)
            rw [Polynomial.coeff_monomial, if_neg hne, map_zero]
          · intro h_abs
            exact absurd (Finset.mem_attach _ ⟨k_idx, hk_mem⟩) h_abs
        rw [hsingle, hc₀_fn k_idx hk_mem]
      · rw [hQ₀_coeff_n, map_one, hQ_mon.coeff_natDegree]
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hQ₀_deg_le hgt), map_zero,
          Polynomial.coeff_eq_zero_of_natDegree_lt hgt]
    have hx₀_eval : Polynomial.eval₂ j_BLE x₀ Q₀ = 0 := by
      apply hj_LE_inj
      rw [map_zero, Polynomial.hom_eval₂, hj_comm, hx₀, ← Polynomial.eval₂_map, hQ₀_map]
      exact hQ_eval

    let e_B_basis := Module.finBasis F₀ ↥E'
    have hx₀_int_B : IsIntegral B x₀ := by
      letI : Field L_E := (hField_LE ↥E').toField
      letI : Algebra B_E L_E := j_BLE.toAlgebra
      haveI : IsScalarTower B B_E L_E := ⟨fun b y z => by
        have hy : j_BLE (b • y) = b • j_BLE y := by
          induction y using TensorProduct.induction_on with
          | zero => rw [smul_zero, map_zero, smul_zero]
          | tmul b' e' =>
            rw [TensorProduct.smul_tmul', smul_eq_mul]
            change ι_K (b * b') ⊗ₜ[F₀] e' = b • (ι_K b' ⊗ₜ[F₀] e')
            rw [TensorProduct.smul_tmul', map_mul]
            rfl
          | add y₁ y₂ hy₁ hy₂ => rw [smul_add, map_add, map_add, smul_add, hy₁, hy₂]
        change j_BLE (b • y) * z = b • (j_BLE y * z)
        rw [hy]
        suffices hmul : ∀ w : L_E, (b • w) * z = b • (w * z) from hmul (j_BLE y)
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul l₁ e₁ =>
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul l₂ e₂ =>
            rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul,
              Algebra.TensorProduct.tmul_mul_tmul, TensorProduct.smul_tmul']
            change ((ι_K b * l₁) * l₂) ⊗ₜ[F₀] (e₁ * e₂) = (ι_K b * (l₁ * l₂)) ⊗ₜ[F₀] (e₁ * e₂)
            rw [mul_assoc]
          | add z₁ z₂ hz₁ hz₂ => rw [mul_add, mul_add, smul_add, hz₁, hz₂]
        | add w₁ w₂ hw₁ hw₂ => rw [smul_add, add_mul, add_mul, smul_add, hw₁, hw₂]⟩
      haveI : Module.Finite B B_E := Module.Finite.of_basis (e_B_basis.baseChange B)
      haveI : Algebra.IsIntegral B B_E := Algebra.IsIntegral.of_finite B B_E
      have hx₀_int_BE : IsIntegral B_E x₀ := ⟨Q₀, hQ₀_mon, hx₀_eval⟩
      exact isIntegral_trans (R := B) x₀ hx₀_int_BE

    let e_L_basis : Module.Basis (Fin (Module.finrank F₀ ↥E')) L₀ L_E := e_B_basis.baseChange L₀
    have hNondeg := traceForm_nondegenerate F₀ ↥E'
    let e_dual := (Algebra.traceForm F₀ ↥E').dualBasis hNondeg e_B_basis
    have htrace_bc : ∀ u : ↥E',
        Algebra.trace L₀ L_E ((1 : L₀) ⊗ₜ[F₀] u) =
          algebraMap F₀ L₀ (Algebra.trace F₀ ↥E' u) := by
      intro u
      have h_lmul : Algebra.lmul L₀ L_E ((1 : L₀) ⊗ₜ[F₀] u) =
          LinearMap.baseChange L₀ (Algebra.lmul F₀ ↥E' u) := by
        apply LinearMap.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul l' v =>
          change ((1 : L₀) ⊗ₜ[F₀] u) * (l' ⊗ₜ[F₀] v) =
            LinearMap.baseChange L₀ (Algebra.lmul F₀ ↥E' u) (l' ⊗ₜ[F₀] v)
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, LinearMap.baseChange_tmul]
          rfl
        | add z₁ z₂ hz₁ hz₂ => rw [map_add, map_add, hz₁, hz₂]
      rw [Algebra.trace_apply, Algebra.trace_apply, h_lmul]
      exact LinearMap.trace_baseChange (Algebra.lmul F₀ ↥E' u) L₀

    let l_coord : Fin (Module.finrank F₀ ↥E') → L₀ := e_L_basis.repr x₀
    have hx₀_expand : ∑ i, l_coord i • ((1 : L₀) ⊗ₜ[F₀] e_B_basis i) = x₀ := by
      calc ∑ i, l_coord i • ((1 : L₀) ⊗ₜ[F₀] e_B_basis i)
        _ = ∑ i, (e_L_basis.repr x₀) i • e_L_basis i := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Module.Basis.baseChange_apply]
        _ = x₀ := e_L_basis.sum_repr x₀

    have hl_int : ∀ j : Fin (Module.finrank F₀ ↥E'), IsIntegral B (l_coord j) := by
      letI : Field L_E := (hField_LE ↥E').toField
      haveI : FiniteDimensional L₀ L_E := Module.Finite.of_basis e_L_basis
      intro j
      have he_dual_intF₀ : IsIntegral F₀ ((1 : L₀) ⊗ₜ[F₀] e_dual j) := by
        have h1 : IsIntegral F₀ (e_dual j) := Algebra.IsIntegral.isIntegral (e_dual j)
        exact h1.map (Algebra.TensorProduct.includeRight : ↥E' →ₐ[F₀] L_E)
      have he_dual_intB : IsIntegral B ((1 : L₀) ⊗ₜ[F₀] e_dual j) :=
        IsIntegral.tower_top he_dual_intF₀
      let y_j : L_E := ((1 : L₀) ⊗ₜ[F₀] e_dual j) * x₀
      have hy_j_int : IsIntegral B y_j := he_dual_intB.mul hx₀_int_B
      have htr_int : IsIntegral B (Algebra.trace L₀ L_E y_j) :=
        Algebra.isIntegral_trace hy_j_int
      have htr_eq : Algebra.trace L₀ L_E y_j = l_coord j := by
        dsimp [y_j]
        rw [← hx₀_expand, Finset.mul_sum, map_sum]
        have hterm : ∀ i : Fin (Module.finrank F₀ ↥E'),
            Algebra.trace L₀ L_E (((1 : L₀) ⊗ₜ[F₀] e_dual j) *
              (l_coord i • ((1 : L₀) ⊗ₜ[F₀] e_B_basis i))) =
            if i = j then l_coord i else 0 := by
          intro i
          rw [mul_smul_comm, LinearMap.map_smul, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
            htrace_bc]
          have hdual := LinearMap.BilinForm.apply_dualBasis_left hNondeg e_B_basis j i
          rw [Algebra.traceForm_apply] at hdual
          rw [hdual, smul_eq_mul]
          split_ifs with hij
          · rw [map_one, mul_one]
          · rw [map_zero, mul_zero]
        simp_rw [hterm]
        simp
      rwa [htr_eq] at htr_int

    have hb_coord : ∀ j : Fin (Module.finrank F₀ ↥E'), ∃ b : B, ι_K b = l_coord j := by
      intro j
      exact (IsIntegrallyClosed.isIntegral_iff (x := l_coord j)).mp (hl_int j)
    choose b_coord hb_coord using hb_coord
    refine ⟨∑ j, b_coord j ⊗ₜ[F₀] (e_B_basis j : k), ?_⟩
    change j_BK (∑ j, b_coord j ⊗ₜ[F₀] (e_B_basis j : k)) = x
    rw [map_sum j_BK, ← hx₀, ← hx₀_expand, map_sum j_LE]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hj_BK_tmul, hb_coord j, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rfl

  
  have hLyingOver : ∀ q : Ideal A_k, q.IsPrime →
      ∃ P : Ideal C, P.IsPrime ∧ Ideal.comap θ P = q := by
    letI : Algebra A_k C := θ.toAlgebra
    haveI : Algebra.IsIntegral A_k C := ⟨hθ_int⟩
    intro q hq
    letI : q.IsPrime := hq
    have hker : RingHom.ker (algebraMap A_k C) ≤ q := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      have hx0 : x = 0 := hθ_inj (hx.trans (map_zero θ).symm)
      rw [hx0]
      exact q.zero_mem
    exact Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain q hker

  have hDim_and_Ht : ringKrullDim C = (1 : WithBot ℕ∞) ∧
      (∀ p : Ideal C, p.IsPrime → p.height ≤ 1) := by
    letI : Algebra (Polynomial k) C := ψ_poly.toAlgebra
    haveI : Algebra.IsIntegral (Polynomial k) C := ⟨hψ_int⟩
    haveI : Ring.DimensionLEOne C := Ring.DimensionLEOne.of_isIntegral (Polynomial k) C
    have hKrullLE : Ring.KrullDimLE 1 C := Ring.KrullDimLE.mk₁ fun I hI => by
      letI : I.IsPrime := hI
      by_cases hI_bot : I = ⊥
      · left
        rw [IsDomain.minimalPrimes_eq_singleton_bot C, Set.mem_singleton_iff]
        exact hI_bot
      · right
        exact hI.isMaximal hI_bot
    have hDim_le : ringKrullDim C ≤ (1 : WithBot ℕ∞) := by
      simpa using (Ring.krullDimLE_iff (n := 1) (R := C)).mp hKrullLE
    have hHt_le : ∀ p : Ideal C, p.IsPrime → p.height ≤ 1 := by
      intro p hp
      have hp_le : (p.height : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) :=
        (ringKrullDim_le_iff_height_le (1 : WithBot ℕ∞)).mp hDim_le hp
      exact WithBot.coe_le_coe.mp hp_le
    let qX : Ideal (Polynomial k) := Ideal.span {Polynomial.X}
    haveI : qX.IsPrime :=
      (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr Polynomial.prime_X
    have hker_ψ : RingHom.ker (algebraMap (Polynomial k) C) ≤ qX := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      have hx0 : x = 0 := hψ_inj (hx.trans (map_zero ψ_poly).symm)
      rw [hx0]
      exact qX.zero_mem
    obtain ⟨P_top, hP_top_prime, hP_top_over⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain qX hker_ψ
    have hX_in_P : ψ_poly Polynomial.X ∈ P_top := by
      have hX_q : Polynomial.X ∈ qX := Ideal.subset_span (Set.mem_singleton Polynomial.X)
      rw [← hP_top_over, Ideal.mem_comap] at hX_q
      exact hX_q
    have hψX_ne : ψ_poly Polynomial.X ≠ 0 := by
      intro h0
      exact Polynomial.X_ne_zero (hψ_inj (h0.trans (map_zero ψ_poly).symm))
    have hP_ne_bot : P_top ≠ ⊥ := by
      intro hbot
      rw [hbot, Ideal.mem_bot] at hX_in_P
      exact hψX_ne hX_in_P
    let pt_bot : PrimeSpectrum C := ⊥
    let pt_top : PrimeSpectrum C := ⟨P_top, hP_top_prime⟩
    have hlt_spec : pt_bot < pt_top := by
      apply lt_of_le_of_ne bot_le
      intro heq
      apply hP_ne_bot
      exact (congrArg PrimeSpectrum.asIdeal heq).symm
    let ser : LTSeries (PrimeSpectrum C) :=
      { length := 1
        toFun := fun i => if (i : ℕ) = 0 then pt_bot else pt_top
        step := fun i => by
          have hi : (i : ℕ) = 0 := Nat.lt_one_iff.mp i.2
          change (if (i.castSucc : ℕ) = 0 then pt_bot else pt_top) <
            (if (i.succ : ℕ) = 0 then pt_bot else pt_top)
          rw [Fin.coe_castSucc, Fin.val_succ, hi]
          exact hlt_spec }
    have hDim_ge : (1 : WithBot ℕ∞) ≤ ringKrullDim C := by
      have hlen := Order.LTSeries.length_le_krullDim ser
      simpa [ser, ringKrullDim] using hlen
    exact ⟨le_antisymm hDim_le hDim_ge, hHt_le⟩

  exact ⟨hNontriv_Ak, hDom_C, hIntCl_C, hFT_C, hDim_and_Ht.1, hDim_and_Ht.2,
    θ, hθ, hLyingOver⟩

theorem weil_two_chart_pullback_curve_integral_smooth_and_surj (F F₀ k : Type u)
    [Field F] [Field F₀] [Field k] [IsAlgClosed k]
    [Algebra F F₀] [Algebra F k] [Algebra F₀ k] [IsScalarTower F F₀ k]
    (D_ov Y_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (h_irred_Dbar : IrreducibleSpace ↥(weilBaseChangeOver F k D_ov).left)
    (p₀ : Quiver.Hom Y_ov.left D_ov.left)
    (hp₀_hom : CategoryTheory.CategoryStruct.comp p₀ D_ov.hom = Y_ov.hom)
    (h_YF₀ : Quiver.Hom Y_ov.left (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
    (hYF₀_hom : CategoryTheory.CategoryStruct.comp h_YF₀
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₀))) = Y_ov.hom)
    (Y_ι : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (pr_Y_ι : Quiver.Hom Y_ι.left Y_ov.left)
    (hPb_ι : CategoryTheory.IsPullback pr_Y_ι Y_ι.hom h_YF₀
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₀ k))))
    (π_ι : Quiver.Hom Y_ι.left (weilBaseChangeOver F k D_ov).left)
    (hπ_fst : CategoryTheory.CategoryStruct.comp π_ι
      (CategoryTheory.Limits.pullback.fst D_ov.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)))) =
      CategoryTheory.CategoryStruct.comp pr_Y_ι p₀)
    (hπ_snd : CategoryTheory.CategoryStruct.comp π_ι (weilBaseChangeOver F k D_ov).hom = Y_ι.hom)
    (W_chart : Fin 2 → D_ov.left.Opens)
    (hW_top : W_chart 0 ⊔ W_chart 1 = ⊤)
    (hSmAway : ∀ (C : Type u) [CommRing C] [IsDomain C] [IsIntegrallyClosed C]
      [Algebra k C] [Algebra.FiniteType k C],
      ringKrullDim C = (1 : WithBot ℕ∞) →
      ∀ (p : Ideal C) [p.IsPrime], p.height ≤ 1 →
      ∃ f : C, f ∉ p ∧ Algebra.IsStandardSmoothOfRelativeDimension 1 k (Localization.Away f))
    (hCharts_alg : ∀ a : Fin 2,
      let W := W_chart a
      let W' : Y_ov.left.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
      let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
      let B_W := ↑(Y_ov.left.presheaf.obj (Opposite.op W'))
      letI : Algebra F A_W :=
        (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
              (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
      letI : Algebra F₀ B_W :=
        (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
              (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
      let A_k := TensorProduct F A_W k
      let C := TensorProduct F₀ B_W k
      letI : Algebra k C := Algebra.TensorProduct.rightAlgebra
      AlgebraicGeometry.IsAffineOpen W ∧
      AlgebraicGeometry.IsAffineOpen W' ∧
      Nontrivial A_k ∧
      IsDomain C ∧
      IsIntegrallyClosed C ∧
      Algebra.FiniteType k C ∧
      ringKrullDim C = (1 : WithBot ℕ∞) ∧
      (∀ p : Ideal C, p.IsPrime → p.height ≤ 1) ∧
      ∃ θ : A_k →+* C,
        (∀ (x : A_W) (c : k),
          θ (x ⊗ₜ[F] c) =
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) x ⊗ₜ[F₀] c) ∧
        (∀ q : Ideal A_k, q.IsPrime → ∃ P : Ideal C, P.IsPrime ∧ Ideal.comap θ P = q)) :
    AlgebraicGeometry.IsIntegral Y_ι.left ∧
    AlgebraicGeometry.SmoothOfRelativeDimension 1 Y_ι.hom ∧
    ∀ x_bar : ↥(weilBaseChangeOver F k D_ov).left,
      x_bar ∈ (TopologicalSpace.Opens.map
        (CategoryTheory.Limits.pullback.fst D_ov.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)))).base).obj
        (W_chart 1) →
      ∃ z : ↥Y_ι.left, π_ι.base z = x_bar :=
by
  have _ := And.intro hp₀_hom hYF₀_hom
  
  have hChartPb : ∀ (R : Type u) [CommRing R] [Algebra R k]
      (X₀ X_k : AlgebraicGeometry.Scheme.{u})
      (s₀ : X₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (pr : X_k ⟶ X₀)
      (s_k : X_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (_hPb : CategoryTheory.IsPullback pr s_k s₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k))))
      (U₀ : X₀.Opens)
      (hU₀ : AlgebraicGeometry.IsAffineOpen U₀),
      let U_k : X_k.Opens := (TopologicalSpace.Opens.map pr.base).obj U₀
      let A : Type u := ↑(X₀.presheaf.obj (Opposite.op U₀))
      letI : Algebra R A :=
        (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop s₀)
              (X₀.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
      ∃ e : U_k.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R A k)),
        (e.inv ≫ U_k.ι) ≫ pr =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
            hU₀.fromSpec ∧
        (e.inv ≫ U_k.ι) ≫ s_k =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := k)).toRingHom) := by
    intro R _ _ X₀ X_k s₀ pr s_k hPb U₀ hU₀
    dsimp only
    let U_k : X_k.Opens := (TopologicalSpace.Opens.map pr.base).obj U₀
    let R_cat : CommRingCat.{u} := CommRingCat.of R
    let A_cat : CommRingCat.{u} := X₀.presheaf.obj (Opposite.op U₀)
    let A : Type u := ↑A_cat
    let α_RA : R_cat ⟶ A_cat :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv ≫
        (s₀.appTop ≫ X₀.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op)
    let _ : Algebra R A := α_RA.hom.toAlgebra
    have h_algMap_eq : CommRingCat.ofHom (algebraMap R A) = α_RA :=
      CommRingCat.ofHom_hom α_RA
    have hs₀_eq : s₀ = X₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map s₀.appTop ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv := by
      have hnat := AlgebraicGeometry.Scheme.toSpecΓ_naturality s₀
      rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom R_cat] at hnat
      have h1 := congrArg
        (· ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv) hnat
      rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp, Iso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id, Category.comp_id] at h1
      exact h1
    have h_str_U₀ : U₀.ι ≫ s₀ =
        hU₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A)) := by
      conv_lhs => rw [hs₀_eq]
      rw [← AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc U₀]
      rw [← hU₀.isoSpec_hom, h_algMap_eq]
      dsimp only [α_RA]
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
    let φ_Rk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k))
    let f_RA := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A))
    have hpb_mid : CategoryTheory.IsPullback (pr ∣_ U₀) U_k.ι U₀.ι pr :=
      AlgebraicGeometry.isPullback_morphismRestrict pr U₀
    have hpb_mb : CategoryTheory.IsPullback (pr ∣_ U₀) (U_k.ι ≫ s_k) (U₀.ι ≫ s₀) φ_Rk :=
      hpb_mid.paste_vert hPb
    have hpb_iso : CategoryTheory.IsPullback hU₀.isoSpec.hom (U₀.ι ≫ s₀) f_RA
        (𝟙 (AlgebraicGeometry.Spec R_cat)) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]; exact h_str_U₀.symm⟩
    have hpb_Uk : CategoryTheory.IsPullback ((pr ∣_ U₀) ≫ hU₀.isoSpec.hom) (U_k.ι ≫ s_k)
        f_RA φ_Rk := by
      have h := hpb_mb.paste_horiz hpb_iso
      rwa [Category.comp_id] at h
    let e : U_k.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R A k)) :=
      hpb_Uk.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso R A k
    refine ⟨e, ?_, ?_⟩
    · have hfst : e.inv ≫ ((pr ∣_ U₀) ≫ hU₀.isoSpec.hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
        dsimp [e]
        rw [Category.assoc, CategoryTheory.IsPullback.isoPullback_inv_fst,
          AlgebraicGeometry.pullbackSpecIso_inv_fst]
      have hpost := congrArg (· ≫ (hU₀.isoSpec.inv ≫ U₀.ι)) hfst
      have hlhs : (e.inv ≫ (pr ∣_ U₀) ≫ hU₀.isoSpec.hom) ≫ hU₀.isoSpec.inv ≫ U₀.ι =
          (e.inv ≫ U_k.ι) ≫ pr := by
        calc (e.inv ≫ (pr ∣_ U₀) ≫ hU₀.isoSpec.hom) ≫ hU₀.isoSpec.inv ≫ U₀.ι
            = e.inv ≫ (pr ∣_ U₀) ≫ (hU₀.isoSpec.hom ≫ hU₀.isoSpec.inv) ≫ U₀.ι := by
                simp only [Category.assoc]
          _ = e.inv ≫ (pr ∣_ U₀) ≫ U₀.ι := by rw [Iso.hom_inv_id, Category.id_comp]
          _ = e.inv ≫ U_k.ι ≫ pr := by rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = (e.inv ≫ U_k.ι) ≫ pr := (Category.assoc _ _ _).symm
      rw [hlhs, hU₀.isoSpec_inv_ι] at hpost
      exact hpost
    · calc (e.inv ≫ U_k.ι) ≫ s_k
          = (AlgebraicGeometry.pullbackSpecIso R A k).inv ≫
              (hpb_Uk.isoPullback.inv ≫ (U_k.ι ≫ s_k)) := by
              dsimp [e]; simp only [Category.assoc]
        _ = (AlgebraicGeometry.pullbackSpecIso R A k).inv ≫
              CategoryTheory.Limits.pullback.snd f_RA φ_Rk := by
              rw [CategoryTheory.IsPullback.isoPullback_inv_snd]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := k)).toRingHom) :=
              AlgebraicGeometry.pullbackSpecIso_inv_snd R A k

  
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let D_bar_ov := weilBaseChangeOver F k D_ov
  let D_bar := D_bar_ov.left
  let pr_D : D_bar ⟶ D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
  let str_D : D_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := D_bar_ov.hom
  have hPb_D : CategoryTheory.IsPullback pr_D str_D D_ov.hom f₂ :=
    CategoryTheory.IsPullback.of_hasPullback D_ov.hom f₂

  let W'_chart : Fin 2 → Y_ov.left.Opens :=
    fun a => (TopologicalSpace.Opens.map p₀.base).obj (W_chart a)
  let A_W : Fin 2 → Type u := fun a => ↑(D_ov.left.presheaf.obj (Opposite.op (W_chart a)))
  let B_W : Fin 2 → Type u := fun a => ↑(Y_ov.left.presheaf.obj (Opposite.op (W'_chart a)))
  let instAlgFA : ∀ a : Fin 2, Algebra F (A_W a) := fun a =>
    (CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
          (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
  let instAlgF0B : ∀ a : Fin 2, Algebra F₀ (B_W a) := fun a =>
    (CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
          (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
  let A_k : Fin 2 → Type u := fun a => TensorProduct F (A_W a) k
  let C_chart : Fin 2 → Type u := fun a => TensorProduct F₀ (B_W a) k
  let instAlgkC : ∀ a : Fin 2, Algebra k (C_chart a) := fun _ =>
    Algebra.TensorProduct.rightAlgebra

  have hAff_W : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (W_chart a) :=
    fun a => (hCharts_alg a).1
  have hAff_W' : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (W'_chart a) :=
    fun a => (hCharts_alg a).2.1
  have hNontriv : ∀ a : Fin 2, Nontrivial (A_k a) :=
    fun a => (hCharts_alg a).2.2.1
  have hDom : ∀ a : Fin 2, IsDomain (C_chart a) :=
    fun a => (hCharts_alg a).2.2.2.1
  have hIntCl : ∀ a : Fin 2, IsIntegrallyClosed (C_chart a) :=
    fun a => (hCharts_alg a).2.2.2.2.1
  have hFT : ∀ a : Fin 2, Algebra.FiniteType k (C_chart a) :=
    fun a => (hCharts_alg a).2.2.2.2.2.1
  have hDim : ∀ a : Fin 2, ringKrullDim (C_chart a) = (1 : WithBot ℕ∞) :=
    fun a => (hCharts_alg a).2.2.2.2.2.2.1
  have hHt : ∀ a : Fin 2, ∀ p : Ideal (C_chart a), p.IsPrime → p.height ≤ 1 :=
    fun a => (hCharts_alg a).2.2.2.2.2.2.2.1
  let θ : ∀ a : Fin 2, A_k a →+* C_chart a :=
    fun a => Classical.choose (hCharts_alg a).2.2.2.2.2.2.2.2
  have hθ_tmul : ∀ (a : Fin 2) (x : A_W a) (c : k),
      θ a (x ⊗ₜ[F] c) =
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a))) x ⊗ₜ[F₀] c :=
    fun a => (Classical.choose_spec (hCharts_alg a).2.2.2.2.2.2.2.2).1
  have hLyingOver : ∀ (a : Fin 2) (q : Ideal (A_k a)), q.IsPrime →
      ∃ P : Ideal (C_chart a), P.IsPrime ∧ Ideal.comap (θ a) P = q :=
    fun a => (Classical.choose_spec (hCharts_alg a).2.2.2.2.2.2.2.2).2

  let W_bar : Fin 2 → D_bar.Opens :=
    fun a => (TopologicalSpace.Opens.map pr_D.base).obj (W_chart a)
  let U_cov : Fin 2 → Y_ι.left.Opens :=
    fun a => (TopologicalSpace.Opens.map pr_Y_ι.base).obj (W'_chart a)

  have hPb_D_chart := fun a : Fin 2 =>
    hChartPb F D_ov.left D_bar D_ov.hom pr_D str_D hPb_D (W_chart a) (hAff_W a)
  let e_Wbar : ∀ a : Fin 2,
      (W_bar a).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (A_k a)) :=
    fun a => Classical.choose (hPb_D_chart a)
  have he_Wbar_pr : ∀ a : Fin 2,
      ((e_Wbar a).inv ≫ (W_bar a).ι) ≫ pr_D =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
          (hAff_W a).fromSpec :=
    fun a => (Classical.choose_spec (hPb_D_chart a)).1
  have he_Wbar_str : ∀ a : Fin 2,
      ((e_Wbar a).inv ≫ (W_bar a).ι) ≫ str_D =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight (R := F) (A := A_W a) (B := k)).toRingHom) :=
    fun a => (Classical.choose_spec (hPb_D_chart a)).2

  have hPb_Y_chart := fun a : Fin 2 =>
    hChartPb F₀ Y_ov.left Y_ι.left h_YF₀ pr_Y_ι Y_ι.hom hPb_ι (W'_chart a) (hAff_W' a)
  let e_U : ∀ a : Fin 2,
      (U_cov a).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (C_chart a)) :=
    fun a => Classical.choose (hPb_Y_chart a)
  have he_U_pr : ∀ a : Fin 2,
      ((e_U a).inv ≫ (U_cov a).ι) ≫ pr_Y_ι =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
          (hAff_W' a).fromSpec :=
    fun a => (Classical.choose_spec (hPb_Y_chart a)).1
  have he_U_str : ∀ a : Fin 2,
      ((e_U a).inv ≫ (U_cov a).ι) ≫ Y_ι.hom =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight (R := F₀) (A := B_W a) (B := k)).toRingHom) :=
    fun a => (Classical.choose_spec (hPb_Y_chart a)).2

  let j_Wbar : ∀ a : Fin 2, AlgebraicGeometry.Spec (CommRingCat.of (A_k a)) ⟶ D_bar :=
    fun a => (e_Wbar a).inv ≫ (W_bar a).ι
  let j_U : ∀ a : Fin 2, AlgebraicGeometry.Spec (CommRingCat.of (C_chart a)) ⟶ Y_ι.left :=
    fun a => (e_U a).inv ≫ (U_cov a).ι

  
  have h_fromSpec_p₀ : ∀ a : Fin 2,
      (hAff_W' a).fromSpec ≫ p₀ =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a)) ≫
          (hAff_W a).fromSpec := by
    intro a
    have hnat := AlgebraicGeometry.Scheme.Opens.toSpecΓ_naturality p₀ (W_chart a)
    rw [← (hAff_W a).isoSpec_hom, ← (hAff_W' a).isoSpec_hom] at hnat
    have h1 := congrArg
      (fun g => (hAff_W' a).isoSpec.inv ≫ g ≫ ((hAff_W a).isoSpec.inv ≫ (W_chart a).ι)) hnat
    have hlhs : (hAff_W' a).isoSpec.inv ≫ ((p₀ ∣_ W_chart a) ≫ (hAff_W a).isoSpec.hom) ≫
        (hAff_W a).isoSpec.inv ≫ (W_chart a).ι = (hAff_W' a).fromSpec ≫ p₀ := by
      calc (hAff_W' a).isoSpec.inv ≫ ((p₀ ∣_ W_chart a) ≫ (hAff_W a).isoSpec.hom) ≫
            (hAff_W a).isoSpec.inv ≫ (W_chart a).ι
          = (hAff_W' a).isoSpec.inv ≫ (p₀ ∣_ W_chart a) ≫
              ((hAff_W a).isoSpec.hom ≫ (hAff_W a).isoSpec.inv) ≫ (W_chart a).ι := by
              simp only [Category.assoc]
        _ = (hAff_W' a).isoSpec.inv ≫ ((p₀ ∣_ W_chart a) ≫ (W_chart a).ι) := by
              rw [Iso.hom_inv_id, Category.id_comp]
        _ = ((hAff_W' a).isoSpec.inv ≫ (W'_chart a).ι) ≫ p₀ := by
              rw [AlgebraicGeometry.morphismRestrict_ι, Category.assoc]
        _ = (hAff_W' a).fromSpec ≫ p₀ := by rw [(hAff_W' a).isoSpec_inv_ι]
    have hrhs : (hAff_W' a).isoSpec.inv ≫ ((hAff_W' a).isoSpec.hom ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a))) ≫
        (hAff_W a).isoSpec.inv ≫ (W_chart a).ι =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a)) ≫
          (hAff_W a).fromSpec := by
      calc (hAff_W' a).isoSpec.inv ≫ ((hAff_W' a).isoSpec.hom ≫
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a))) ≫
            (hAff_W a).isoSpec.inv ≫ (W_chart a).ι
          = ((hAff_W' a).isoSpec.inv ≫ (hAff_W' a).isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a)) ≫
              ((hAff_W a).isoSpec.inv ≫ (W_chart a).ι) := by
              simp only [Category.assoc]
        _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a)) ≫
              (hAff_W a).fromSpec := by
              rw [Iso.inv_hom_id, Category.id_comp, (hAff_W a).isoSpec_inv_ι]
    rw [hlhs, hrhs] at h1
    exact h1.symm

  
  have h_intertwine : ∀ a : Fin 2,
      j_U a ≫ π_ι = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ a)) ≫ j_Wbar a := by
    intro a
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc (j_U a ≫ π_ι) ≫ pr_D
          = j_U a ≫ (π_ι ≫ pr_D) := Category.assoc _ _ _
        _ = j_U a ≫ (pr_Y_ι ≫ p₀) := by rw [hπ_fst]
        _ = (j_U a ≫ pr_Y_ι) ≫ p₀ := (Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
              ((hAff_W' a).fromSpec ≫ p₀) := by
              rw [he_U_pr a, Category.assoc]
        _ = (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a))) ≫
              (hAff_W a).fromSpec := by
              rw [h_fromSpec_p₀ a, Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ a)) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)) ≫
              (hAff_W a).fromSpec := by
              congr 1
              conv_lhs => rw [← CommRingCat.ofHom_hom (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a))]
              rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
              congr 2
              ext x
              exact (hθ_tmul a x 1).symm
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ a)) ≫ j_Wbar a) ≫ pr_D := by
              rw [Category.assoc, Category.assoc, he_Wbar_pr a]
    · calc (j_U a ≫ π_ι) ≫ str_D
          = j_U a ≫ (π_ι ≫ str_D) := Category.assoc _ _ _
        _ = j_U a ≫ Y_ι.hom := by rw [hπ_snd]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Algebra.TensorProduct.includeRight (R := F₀) (A := B_W a) (B := k)).toRingHom) :=
              he_U_str a
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ a)) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (Algebra.TensorProduct.includeRight (R := F) (A := A_W a) (B := k)).toRingHom) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              congr 2
              ext c
              change (1 : B_W a) ⊗ₜ[F₀] c = θ a ((1 : A_W a) ⊗ₜ[F] c)
              rw [hθ_tmul a 1 c, map_one]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ a)) ≫ j_Wbar a) ≫ str_D := by
              rw [Category.assoc, he_Wbar_str a]

  
  have hSurj_chart : ∀ (a : Fin 2) (x_bar : ↥D_bar),
      x_bar ∈ W_bar a → ∃ z : ↥Y_ι.left, z ∈ U_cov a ∧ π_ι.base z = x_bar := by
    intro a x_bar hx
    let q_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (A_k a))) :=
      (e_Wbar a).hom.base ⟨x_bar, hx⟩
    obtain ⟨P, hP_prime, hP_comap⟩ := hLyingOver a q_pt.asIdeal q_pt.isPrime
    let P_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (C_chart a))) := ⟨P, hP_prime⟩
    let z : ↥Y_ι.left := (j_U a).base P_pt
    have hz_mem : z ∈ U_cov a := ((e_U a).inv.base P_pt).2
    have hSpec_θ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ a))).base P_pt = q_pt :=
      PrimeSpectrum.ext hP_comap
    have hj_q : (j_Wbar a).base q_pt = x_bar := by
      dsimp [j_Wbar, q_pt]
      have h1 : (e_Wbar a).inv.base ((e_Wbar a).hom.base ⟨x_bar, hx⟩) = ⟨x_bar, hx⟩ := by
        change ((e_Wbar a).hom ≫ (e_Wbar a).inv).base ⟨x_bar, hx⟩ = ⟨x_bar, hx⟩
        rw [Iso.hom_inv_id]
        rfl
      change (W_bar a).ι.base ((e_Wbar a).inv.base ((e_Wbar a).hom.base ⟨x_bar, hx⟩)) = x_bar
      rw [h1]
      rfl
    have hπ_z : π_ι.base z = x_bar := by
      change (j_U a ≫ π_ι).base P_pt = x_bar
      rw [h_intertwine a]
      change (j_Wbar a).base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ a))).base P_pt) = x_bar
      rw [hSpec_θ, hj_q]
    exact ⟨z, hz_mem, hπ_z⟩

  
  have hU_mem : ∀ z : ↥Y_ι.left, z ∈ U_cov 0 ∨ z ∈ U_cov 1 := by
    intro z
    have hmem : p₀.base (pr_Y_ι.base z) ∈ (⊤ : D_ov.left.Opens) := trivial
    rw [← hW_top] at hmem
    exact hmem
  have hU_univ : (⋃ a : Fin 2, (U_cov a : Set ↥Y_ι.left)) = Set.univ := by
    ext z
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    rcases hU_mem z with h0 | h1
    · exact ⟨0, h0⟩
    · exact ⟨1, h1⟩

  have hWbar_nonempty : ∀ a : Fin 2, ((W_bar a : Set ↥D_bar)).Nonempty := by
    intro a
    have _ : Nontrivial (A_k a) := hNontriv a
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (A_k a)
    let m_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (A_k a))) := ⟨M, hM.isPrime⟩
    exact ⟨(j_Wbar a).base m_pt, ((e_Wbar a).inv.base m_pt).2⟩

  have hWbar_inter : ((W_bar 0 : Set ↥D_bar) ∩ (W_bar 1 : Set ↥D_bar)).Nonempty := by
    have hPreD := @PreirreducibleSpace.isPreirreducible_univ ↥D_bar _ h_irred_Dbar.toPreirreducibleSpace
    obtain ⟨x_01, -, hx01⟩ := hPreD (W_bar 0 : Set ↥D_bar) (W_bar 1 : Set ↥D_bar)
      (W_bar 0).2 (W_bar 1).2
      (by rw [Set.univ_inter]; exact hWbar_nonempty 0)
      (by rw [Set.univ_inter]; exact hWbar_nonempty 1)
    exact ⟨x_01, hx01⟩

  obtain ⟨x_01, hx0, hx1⟩ := hWbar_inter
  obtain ⟨z_01, hz0, hπ_z01⟩ := hSurj_chart 0 x_01 hx0
  have hz1 : z_01 ∈ U_cov 1 := by
    change p₀.base (pr_Y_ι.base z_01) ∈ W_chart 1
    have h1 : p₀.base (pr_Y_ι.base z_01) = pr_D.base (π_ι.base z_01) := by
      change (pr_Y_ι ≫ p₀).base z_01 = (π_ι ≫ pr_D).base z_01
      rw [hπ_fst]
    rw [h1, hπ_z01]
    exact hx1

  have hInt_Y : AlgebraicGeometry.IsIntegral Y_ι.left := by
    have hCov : TopologicalSpace.IsOpenCover U_cov :=
      TopologicalSpace.IsOpenCover.of_sets (fun a => (U_cov a).2) hU_univ
    let 𝒰 : Y_ι.left.OpenCover := Y_ι.left.openCoverOfIsOpenCover U_cov hCov
    have hRed_Ua : ∀ a : Fin 2, AlgebraicGeometry.IsReduced (𝒰.X a) := by
      intro a
      change AlgebraicGeometry.IsReduced (U_cov a).toScheme
      let _ : IsDomain (C_chart a) := hDom a
      have hRed_Ca : IsReduced ↑(CommRingCat.of (C_chart a)) := by
        change IsReduced (C_chart a)
        infer_instance
      have hRed_Spec : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of (C_chart a))) :=
        @AlgebraicGeometry.instIsReducedSpecOfIsReducedCarrier
          (CommRingCat.of (C_chart a)) hRed_Ca
      exact @AlgebraicGeometry.isReduced_of_isOpenImmersion _ _ (e_U a).hom _ hRed_Spec
    have hRed_Y : AlgebraicGeometry.IsReduced Y_ι.left :=
      @AlgebraicGeometry.IsReduced.of_openCover Y_ι.left 𝒰 hRed_Ua
    have hRange_jU : ∀ a : Fin 2, Set.range (j_U a).base = (U_cov a : Set ↥Y_ι.left) := by
      intro a
      ext y
      constructor
      · rintro ⟨p, rfl⟩
        exact ((e_U a).inv.base p).2
      · intro hy
        refine ⟨(e_U a).hom.base ⟨y, hy⟩, ?_⟩
        dsimp [j_U]
        have h1 : (e_U a).inv.base ((e_U a).hom.base ⟨y, hy⟩) = ⟨y, hy⟩ := by
          change ((e_U a).hom ≫ (e_U a).inv).base ⟨y, hy⟩ = ⟨y, hy⟩
          rw [Iso.hom_inv_id]
          rfl
        change (U_cov a).ι.base ((e_U a).inv.base ((e_U a).hom.base ⟨y, hy⟩)) = y
        rw [h1]
        rfl
    have hPre_U : ∀ a : Fin 2, IsPreirreducible (U_cov a : Set ↥Y_ι.left) := by
      intro a
      have hDom_a : IsDomain (C_chart a) := hDom a
      have hIrred_Spec : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (C_chart a))) :=
        @PrimeSpectrum.irreducibleSpace (C_chart a) _ hDom_a
      rw [← hRange_jU a, ← Set.image_univ]
      exact (@PreirreducibleSpace.isPreirreducible_univ
        ↥(AlgebraicGeometry.Spec (CommRingCat.of (C_chart a))) _
        hIrred_Spec.toPreirreducibleSpace).image (j_U a).base
        (AlgebraicGeometry.Scheme.Hom.continuous (j_U a)).continuousOn
    have hMeet_U0 : ∀ (O : Set ↥Y_ι.left), IsOpen O → O.Nonempty →
        ((U_cov 0 : Set ↥Y_ι.left) ∩ O).Nonempty := by
      intro O hO ⟨y, hyO⟩
      rcases hU_mem y with hy0 | hy1
      · exact ⟨y, hy0, hyO⟩
      · obtain ⟨w, _, hw⟩ :=
          hPre_U 1 (U_cov 0 : Set ↥Y_ι.left) O (U_cov 0).2 hO ⟨z_01, hz1, hz0⟩ ⟨y, hy1, hyO⟩
        exact ⟨w, hw⟩
    have hIrred_Y : IrreducibleSpace ↥Y_ι.left := by
      refine @IrreducibleSpace.mk _ _ ⟨?_⟩ ⟨z_01⟩
      intro O₁ O₂ hO₁ hO₂ h1 h2
      rw [Set.univ_inter] at h1 h2 ⊢
      obtain ⟨w, _, hw⟩ :=
        hPre_U 0 O₁ O₂ hO₁ hO₂ (hMeet_U0 O₁ hO₁ h1) (hMeet_U0 O₂ hO₂ h2)
      exact ⟨w, hw⟩
    exact @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y_ι.left hRed_Y hIrred_Y

  
  have hSm_Y : AlgebraicGeometry.SmoothOfRelativeDimension 1 Y_ι.hom := by
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk (fun x => ?_)
    have hx_ex : ∃ a : Fin 2, x ∈ U_cov a := by
      rcases hU_mem x with h0 | h1
      · exact ⟨0, h0⟩
      · exact ⟨1, h1⟩
    obtain ⟨a, hx⟩ := hx_ex
    let _ : IsDomain (C_chart a) := hDom a
    let _ : IsIntegrallyClosed (C_chart a) := hIntCl a
    let _ : Algebra.FiniteType k (C_chart a) := hFT a
    let P : ↥(AlgebraicGeometry.Spec (CommRingCat.of (C_chart a))) :=
      (e_U a).hom.base ⟨x, hx⟩
    have hj_P : (j_U a).base P = x := by
      dsimp [j_U, P]
      have h1 : (e_U a).inv.base ((e_U a).hom.base ⟨x, hx⟩) = ⟨x, hx⟩ := by
        change ((e_U a).hom ≫ (e_U a).inv).base ⟨x, hx⟩ = ⟨x, hx⟩
        rw [Iso.hom_inv_id]
        rfl
      change (U_cov a).ι.base ((e_U a).inv.base ((e_U a).hom.base ⟨x, hx⟩)) = x
      rw [h1]
      rfl
    have _ : P.asIdeal.IsPrime := P.isPrime
    obtain ⟨f, hf_notMem, hf_sm⟩ :=
      hSmAway (C_chart a) (hDim a) P.asIdeal (hHt a P.asIdeal P.isPrime)
    let S_f := Localization.Away f
    let g_loc : AlgebraicGeometry.Spec (CommRingCat.of S_f) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (C_chart a)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (C_chart a) S_f))
    have _ : AlgebraicGeometry.IsOpenImmersion g_loc :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization f
    let j_f : AlgebraicGeometry.Spec (CommRingCat.of S_f) ⟶ Y_ι.left := g_loc ≫ j_U a
    let V_f : Y_ι.left.Opens := j_f.opensRange
    have hVf_aff : AlgebraicGeometry.IsAffineOpen V_f :=
      AlgebraicGeometry.isAffineOpen_opensRange j_f
    have hDisj : Disjoint (Submonoid.powers f : Set (C_chart a)) (P.asIdeal : Set (C_chart a)) := by
      rw [Set.disjoint_left]
      rintro y ⟨m, rfl⟩ hyP
      exact hf_notMem (P.isPrime.mem_of_pow_mem m hyP)
    let Q : Ideal S_f := Ideal.map (algebraMap (C_chart a) S_f) P.asIdeal
    have hQ_prime : Q.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) S_f P.asIdeal P.isPrime hDisj
    have hQ_comap : Ideal.comap (algebraMap (C_chart a) S_f) Q = P.asIdeal :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) S_f P.isPrime hDisj
    let Q_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of S_f)) := ⟨Q, hQ_prime⟩
    have hg_Q : g_loc.base Q_pt = P := PrimeSpectrum.ext hQ_comap
    have hx_Vf : x ∈ V_f := by
      refine ⟨Q_pt, ?_⟩
      change (j_U a).base (g_loc.base Q_pt) = x
      rw [hg_Q, hj_P]
    let U_top : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens := ⊤
    have hle : V_f ≤ (TopologicalSpace.Opens.map Y_ι.hom.base).obj U_top := le_top
    refine ⟨U_top, AlgebraicGeometry.isAffineOpen_top _, V_f, hVf_aff, hx_Vf, hle, ?_⟩
    have hjf_str : j_f ≫ Y_ι.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k S_f)) := by
      dsimp [j_f, g_loc]
      rw [Category.assoc, he_U_str a, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    have hVf_str : V_f.ι ≫ Y_ι.hom =
        j_f.isoOpensRange.inv ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k S_f)) := by
      have h1 := AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι j_f
      calc V_f.ι ≫ Y_ι.hom
          = (j_f.isoOpensRange.inv ≫ j_f.isoOpensRange.hom) ≫ V_f.ι ≫ Y_ι.hom := by
              rw [Iso.inv_hom_id, Category.id_comp]
        _ = j_f.isoOpensRange.inv ≫ (j_f.isoOpensRange.hom ≫ V_f.ι) ≫ Y_ι.hom := by
              simp only [Category.assoc]
        _ = j_f.isoOpensRange.inv ≫ (j_f ≫ Y_ι.hom) := by rw [h1, Category.assoc]
        _ = j_f.isoOpensRange.inv ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k S_f)) := by
              rw [hjf_str]
    have hV_res : V_f.ι.appTop ≫ V_f.topIso.hom =
        Y_ι.left.presheaf.map (CategoryTheory.homOfLE (le_top : V_f ≤ ⊤)).op := by
      have h1 := AlgebraicGeometry.Scheme.Opens.ι_appTop V_f
      have h2 := AlgebraicGeometry.Scheme.Opens.topIso_hom V_f
      refine (congrArg₂ CategoryTheory.CategoryStruct.comp h1 h2).trans ?_
      refine (Y_ι.left.presheaf.map_comp _ _).symm.trans ?_
      exact congrArg Y_ι.left.presheaf.map (Subsingleton.elim _ _)
    have happ_lhs : (V_f.ι ≫ Y_ι.hom).appTop ≫ V_f.topIso.hom =
        Y_ι.hom.appLE U_top V_f hle := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, Category.assoc, hV_res]
      exact (congrArg (· ≫ _)
        (AlgebraicGeometry.Scheme.Hom.appLE_eq_app Y_ι.hom (U := ⊤)).symm).trans
        (AlgebraicGeometry.Scheme.Hom.appLE_map Y_ι.hom _ _)
    have happ_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k S_f))).appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
          CommRingCat.ofHom (algebraMap k S_f) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S_f)).inv := by
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (CommRingCat.ofHom (algebraMap k S_f))
      have h1 := congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S_f)).inv) hnat
      rw [Category.assoc, Iso.hom_inv_id, Category.comp_id, Category.assoc] at h1
      exact h1
    let iso_dom : ((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U_top)) ≅
        CommRingCat.of k :=
      AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    let iso_mid : (AlgebraicGeometry.Spec (CommRingCat.of S_f)).presheaf.obj (Opposite.op ⊤) ≅
        V_f.toScheme.presheaf.obj (Opposite.op ⊤) :=
      { hom := j_f.isoOpensRange.inv.appTop
        inv := j_f.isoOpensRange.hom.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Iso.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Iso.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    let iso_cod : CommRingCat.of S_f ≅ Y_ι.left.presheaf.obj (Opposite.op V_f) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S_f)).symm ≪≫ iso_mid ≪≫ V_f.topIso
    have hsm_alg : RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap k S_f) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hf_sm
    have hsm_cod : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((CommRingCat.ofHom (algebraMap k S_f) ≫ iso_cod.hom).hom) := by
      rw [CommRingCat.hom_comp]
      exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).left
        (algebraMap k S_f) iso_cod.commRingCatIsoToRingEquiv hsm_alg
    have hsm_both : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((iso_dom.hom ≫ (CommRingCat.ofHom (algebraMap k S_f) ≫ iso_cod.hom)).hom) := by
      rw [CommRingCat.hom_comp]
      exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).right
        (CommRingCat.ofHom (algebraMap k S_f) ≫ iso_cod.hom).hom
        iso_dom.commRingCatIsoToRingEquiv hsm_cod
    have happ_eq : Y_ι.hom.appLE U_top V_f hle =
        iso_dom.hom ≫ (CommRingCat.ofHom (algebraMap k S_f) ≫ iso_cod.hom) := by
      rw [← happ_lhs, hVf_str, AlgebraicGeometry.Scheme.Hom.comp_appTop, happ_spec]
      dsimp [iso_dom, iso_cod, iso_mid]
      simp only [Category.assoc]
    rw [happ_eq]
    exact hsm_both

  refine ⟨hInt_Y, hSm_Y, fun x_bar hx_bar => ?_⟩
  obtain ⟨z, _, hz⟩ := hSurj_chart 1 x_bar hx_bar
  exact ⟨z, hz⟩

theorem weil_curve_tr_geom_components_smooth_proper_and_locFree (F : Type u) [Finite F] [Field F]
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hsinf_disj : Disjoint (Set.range s_inf.base) (U₀ : Set ↥(weilProjectiveSpaceOver F 1).left))
    (F₀ L₀ : Type u)
    [Field F₀] [Finite F₀] [Field L₀]
    [Algebra F F₀] [FiniteDimensional F F₀]
    [Algebra F L₀] [Algebra F₀ L₀] [IsScalarTower F F₀ L₀]
    (hF₀_algClosed : ∀ x : L₀, IsIntegral F x → ∃ c : F₀, algebraMap F₀ L₀ c = x)
    (d_cov : ℕ) (hd_cov : 1 ≤ d_cov)
    (Y_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Y_ov.hom]
    (p₀ : Quiver.Hom Y_ov.left (weilProjectiveSpaceOver F 1).left)
    (hp₀_hom : CategoryTheory.CategoryStruct.comp p₀ (weilProjectiveSpaceOver F 1).hom = Y_ov.hom)
    (hp₀_locFree : WeilTopDegFiniteLocallyFreeOfRank d_cov p₀)
    (h_YF₀ : Quiver.Hom Y_ov.left (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
    (hYF₀_hom : CategoryTheory.CategoryStruct.comp h_YF₀
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₀))) = Y_ov.hom)
    (W_chart : Fin 2 → (weilProjectiveSpaceOver F 1).left.Opens)
    (hW_top : W_chart 0 ⊔ W_chart 1 = ⊤)
    (hsinf_W1 : Set.range s_inf.base ⊆ (W_chart 1 : Set ↥(weilProjectiveSpaceOver F 1).left))
    (hChart : ∀ a : Fin 2,
      let D_ov := weilProjectiveSpaceOver F 1
      let W := W_chart a
      let W' : Y_ov.left.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
      let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
      let B_W := ↑(Y_ov.left.presheaf.obj (Opposite.op W'))
      AlgebraicGeometry.IsAffineOpen W ∧
      AlgebraicGeometry.IsAffineOpen W' ∧
      (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)).Finite ∧
      Function.Injective (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) ∧
      ∃ (φ_A : Polynomial F ≃+* A_W) (ι_K : B_W →+* L₀),
        (∀ c : F,
          φ_A (Polynomial.C c) =
            (CommRingCat.Hom.hom
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
                  (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) ∧
        Function.Injective ι_K ∧
        IsIntegrallyClosed B_W ∧
        @IsFractionRing B_W _ L₀ _ ι_K.toAlgebra ∧
        (∀ c : F₀,
          ι_K ((CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
                (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) =
            algebraMap F₀ L₀ c)) :
    let k := AlgebraicClosure F
    let D_ov := weilProjectiveSpaceOver F 1
    let D_bar_ov := weilBaseChangeOver F k D_ov
    let D_bar := weilGeomScheme F D_ov
    let Y_bar := weilBaseChangeOver F k Y_ov
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let pr_D : Quiver.Hom D_bar D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
    let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
    ∃ (m_c : ℕ)
      (p_bar : Quiver.Hom Y_bar.left D_bar)
      (Y_comp : Fin m_c → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (inc_comp : ∀ ι : Fin m_c, Quiver.Hom (Y_comp ι).left Y_bar.left),
      1 ≤ m_c ∧
      CategoryTheory.CategoryStruct.comp p_bar pr_D =
        CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst Y_ov.hom f₂) p₀ ∧
      CategoryTheory.CategoryStruct.comp p_bar D_bar_ov.hom = Y_bar.hom ∧
      WeilTopDegFiniteLocallyFreeOfRank d_cov p_bar ∧
      (∀ ι : Fin m_c,
        CategoryTheory.CategoryStruct.comp (inc_comp ι) Y_bar.hom = (Y_comp ι).hom ∧
        AlgebraicGeometry.IsOpenImmersion (inc_comp ι) ∧
        AlgebraicGeometry.IsClosedImmersion (inc_comp ι) ∧
        AlgebraicGeometry.IsIntegral (Y_comp ι).left ∧
        AlgebraicGeometry.IsProper (Y_comp ι).hom ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (Y_comp ι).hom ∧
        ∃ y ∈ Set.range (inc_comp ι).base, p_bar.base y ∉ (U_bar : Set ↥D_bar)) ∧
      (∀ ι₁ ι₂ : Fin m_c, ι₁ ≠ ι₂ →
        Disjoint (Set.range (inc_comp ι₁).base) (Set.range (inc_comp ι₂).base)) ∧
      (⋃ ι : Fin m_c, Set.range (inc_comp ι).base) = Set.univ :=
by
  let k := AlgebraicClosure F
  let D_ov := weilProjectiveSpaceOver F 1
  let D_bar_ov := weilBaseChangeOver F k D_ov
  let D_bar := weilGeomScheme F D_ov
  let Y_bar := weilBaseChangeOver F k Y_ov
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let pr_D : Quiver.Hom D_bar D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
  let pr_Y : Quiver.Hom Y_bar.left Y_ov.left := CategoryTheory.Limits.pullback.fst Y_ov.hom f₂
  let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
  have hGeom_D : AlgebraicGeometry.GeometricallyIrreducible D_ov.hom :=
    (weil_coinv_projLine_proper_smooth_geomIrred F).1
  have h_irred_Dbar : IrreducibleSpace ↥(weilBaseChangeOver F k D_ov).left := by
    rw [AlgebraicGeometry.geometricallyIrreducible_iff] at hGeom_D
    exact @hGeom_D k inferInstance f₂ D_bar pr_D D_bar_ov.hom
      (CategoryTheory.IsPullback.of_hasPullback D_ov.hom f₂)
  obtain ⟨p_bar, hp_bar_fst, hp_bar_snd, hp_bar_locFree⟩ :=
    weil_baseChange_finiteLocallyFreeOfRank F k d_cov Y_ov D_ov p₀ hp₀_hom hp₀_locFree
  obtain ⟨m_c, emb, Y_comp, inc_comp, pr_comp, hm_c, hcomp_base, hcomp_disj, hcomp_univ⟩ :=
    weil_sepField_baseChange_clopen_components F F₀ k Y_ov h_YF₀ hYF₀_hom
  have hs_comm : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f₂ s_inf)
      D_ov.hom =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k))) f₂ := by
    rw [CategoryTheory.Category.assoc, hsinf_sec, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.id_comp]
  let s_bar_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) D_bar :=
    CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.comp f₂ s_inf)
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k))) hs_comm
  have hs_bar_fst : CategoryTheory.CategoryStruct.comp s_bar_inf pr_D =
      CategoryTheory.CategoryStruct.comp f₂ s_inf :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := default
  let x_bar_inf : ↥D_bar := s_bar_inf.base pt_k
  have hx_inf_eq : pr_D.base x_bar_inf = s_inf.base (f₂.base pt_k) := by
    dsimp only [x_bar_inf]
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply s_bar_inf pr_D pt_k, hs_bar_fst,
      AlgebraicGeometry.Scheme.Hom.comp_apply f₂ s_inf pt_k]
  have hx_inf_range : pr_D.base x_bar_inf ∈ Set.range s_inf.base :=
    ⟨f₂.base pt_k, hx_inf_eq.symm⟩
  have hx_inf_W1 : x_bar_inf ∈ (TopologicalSpace.Opens.map pr_D.base).obj (W_chart 1) :=
    hsinf_W1 hx_inf_range
  have hx_inf_not_U : x_bar_inf ∉ (U_bar : Set ↥D_bar) :=
    fun hU => Set.disjoint_left.mp hsinf_disj hx_inf_range hU
  have hf_F_gen : ∀ (D₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (p : Quiver.Hom Y_ov.left D₀.left),
      CategoryTheory.CategoryStruct.comp p D₀.hom = Y_ov.hom →
      ∀ (W : D₀.left.Opens) (c : F),
        let W' : Y_ov.left.Opens := (TopologicalSpace.Opens.map p.base).obj W
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p W))
          ((CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.Hom.appTop D₀.hom)
                (D₀.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) =
        (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
              (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op))))
          (algebraMap F F₀ c) := by
    intro D₀ p hp_hom W c W'
    let φ_FF₀ := CommRingCat.ofHom (algebraMap F F₀)
    let α_F := CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appTop D₀.hom)
        (D₀.left.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op))
    let α_F₀ := CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
        (Y_ov.left.presheaf.map (CategoryTheory.homOfLE (le_top : W' ≤ ⊤)).op))
    have h_res_nat :
        CategoryTheory.CategoryStruct.comp
          (D₀.left.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op)
          (AlgebraicGeometry.Scheme.Hom.app p W) =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appTop p)
          (Y_ov.left.presheaf.map (CategoryTheory.homOfLE (le_top : W' ≤ ⊤)).op) := by
      have h1 := AlgebraicGeometry.Scheme.Hom.naturality p
        (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op
      have hsub : ((TopologicalSpace.Opens.map p.base).map
          (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op.unop) =
          CategoryTheory.homOfLE (le_top : W' ≤ ⊤) := Subsingleton.elim _ _
      rw [hsub] at h1
      exact h1
    have h_hom_eq :
        CategoryTheory.CategoryStruct.comp α_F (AlgebraicGeometry.Scheme.Hom.app p W) =
        CategoryTheory.CategoryStruct.comp φ_FF₀ α_F₀ := by
      dsimp only [α_F, α_F₀]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_res_nat,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.Hom.appTop D₀.hom),
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop p D₀.hom, hp_hom, ← hYF₀_hom,
        AlgebraicGeometry.Scheme.Hom.comp_appTop h_YF₀ (AlgebraicGeometry.Spec.map φ_FF₀),
        CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv,
        ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality φ_FF₀,
        CategoryTheory.Category.assoc]
    have h_eval := congrArg (fun g => CommRingCat.Hom.hom g c) h_hom_eq
    rw [CommRingCat.hom_comp α_F (AlgebraicGeometry.Scheme.Hom.app p W),
      CommRingCat.hom_comp φ_FF₀ α_F₀, RingHom.comp_apply, RingHom.comp_apply,
      CommRingCat.hom_ofHom] at h_eval
    exact h_eval
  have hf_F_all : ∀ a : Fin 2, ∀ c : F,
      (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ (W_chart a)))
        ((CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
              (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) =
      (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
            (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op))))
        (algebraMap F F₀ c) :=
    fun a c => hf_F_gen D_ov p₀ hp₀_hom (W_chart a) c
  refine ⟨m_c, p_bar, Y_comp, inc_comp, hm_c, hp_bar_fst, hp_bar_snd, hp_bar_locFree,
    ?_, hcomp_disj, hcomp_univ⟩
  intro ι
  obtain ⟨hPb_comp, hinc_pr, hinc_hom, hinc_open, hinc_closed, hProp_comp⟩ := hcomp_base ι
  letI : Algebra F₀ k := (emb ι).toRingHom.toAlgebra
  haveI : IsScalarTower F F₀ k :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun r => ((emb ι).commutes r).symm)
  let π_ι : Quiver.Hom (Y_comp ι).left D_bar :=
    CategoryTheory.CategoryStruct.comp (inc_comp ι) p_bar
  have hπ_fst : CategoryTheory.CategoryStruct.comp π_ι pr_D =
      CategoryTheory.CategoryStruct.comp (pr_comp ι) p₀ :=
    (CategoryTheory.Category.assoc (inc_comp ι) p_bar pr_D).trans
      ((congrArg (CategoryTheory.CategoryStruct.comp (inc_comp ι)) hp_bar_fst).trans
        ((CategoryTheory.Category.assoc (inc_comp ι) pr_Y p₀).symm.trans
          (congrArg (fun g => CategoryTheory.CategoryStruct.comp g p₀) hinc_pr)))
  have hπ_snd : CategoryTheory.CategoryStruct.comp π_ι D_bar_ov.hom = (Y_comp ι).hom := by
    dsimp [π_ι]
    rw [CategoryTheory.Category.assoc, hp_bar_snd, hinc_hom]
  have hCharts_alg : ∀ a : Fin 2,
      let W := W_chart a
      let W' : Y_ov.left.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
      let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
      let B_W := ↑(Y_ov.left.presheaf.obj (Opposite.op W'))
      letI : Algebra F A_W :=
        (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
              (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
      letI : Algebra F₀ B_W :=
        (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
              (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
      let A_k := TensorProduct F A_W k
      let C := TensorProduct F₀ B_W k
      letI : Algebra k C := Algebra.TensorProduct.rightAlgebra
      AlgebraicGeometry.IsAffineOpen W ∧
      AlgebraicGeometry.IsAffineOpen W' ∧
      Nontrivial A_k ∧
      IsDomain C ∧
      IsIntegrallyClosed C ∧
      Algebra.FiniteType k C ∧
      ringKrullDim C = (1 : WithBot ℕ∞) ∧
      (∀ p : Ideal C, p.IsPrime → p.height ≤ 1) ∧
      ∃ θ : A_k →+* C,
        (∀ (x : A_W) (c : k),
          θ (x ⊗ₜ[F] c) =
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) x ⊗ₜ[F₀] c) ∧
        (∀ q : Ideal A_k, q.IsPrime → ∃ P : Ideal C, P.IsPrime ∧ Ideal.comap θ P = q) := by
    intro a
    dsimp only
    let W := W_chart a
    let W' : Y_ov.left.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
    let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
    let B_W := ↑(Y_ov.left.presheaf.obj (Opposite.op W'))
    letI : Algebra F A_W :=
      (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
            (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
    letI : Algebra F₀ B_W :=
      (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
            (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))).toAlgebra
    obtain ⟨hAff_W, hAff_W', hf_fin, hf_inj, φ_A, ι_K, hφ_A, hι_inj, hIntCl_B, hFrac_B, hι_F₀⟩ :=
      hChart a
    letI : IsIntegrallyClosed B_W := hIntCl_B
    have hAlg_pack :=
      weil_constField_chart_tensor_integrallyClosed_krullDim_one F F₀ L₀ k hF₀_algClosed
        A_W B_W φ_A hφ_A (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W))
        hf_fin hf_inj (hf_F_all a) ι_K hι_inj hFrac_B hι_F₀
    exact ⟨hAff_W, hAff_W', hAlg_pack⟩
  obtain ⟨hInt_ι, hSm_ι, hSurj_W1⟩ :=
    weil_two_chart_pullback_curve_integral_smooth_and_surj F F₀ k D_ov Y_ov h_irred_Dbar
      p₀ hp₀_hom h_YF₀ hYF₀_hom (Y_comp ι) (pr_comp ι) hPb_comp π_ι hπ_fst hπ_snd
      W_chart hW_top
      (fun C _ _ _ _ _ hDim p _ hp =>
        weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k 1 C hDim p hp)
      hCharts_alg
  obtain ⟨z, hz⟩ := hSurj_W1 x_bar_inf hx_inf_W1
  refine ⟨hinc_hom, hinc_open, hinc_closed, hInt_ι, hProp_comp, hSm_ι,
    (inc_comp ι).base z, ⟨z, rfl⟩, ?_⟩
  have hpy : p_bar.base ((inc_comp ι).base z) = x_bar_inf := by
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply (inc_comp ι) p_bar z]
    exact hz
  rw [hpy]
  exact hx_inf_not_U

theorem weil_algClosed_proper_iteratedAbsFrob_fixed_finite_etale_card (k : Type u) [Field k] [IsAlgClosed k]
    (p μ : ℕ) [Fact (Nat.Prime p)] (hμ : 1 ≤ μ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    (φ_X β : Quiver.Hom X.left X.left)
    (hφ_X : WeilTopDegIsIteratedAbsFrob p μ X.left φ_X)
    (hα_hom : CategoryTheory.CategoryStruct.comp
      (CategoryTheory.CategoryStruct.comp φ_X β) X.hom = X.hom) :
    let α := CategoryTheory.CategoryStruct.comp φ_X β
    let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
    let Γ_α := CategoryTheory.Limits.pullback.lift
      (CategoryTheory.CategoryStruct.id X.left) α
      ((CategoryTheory.Category.id_comp X.hom).trans hα_hom.symm)
    let W := CategoryTheory.Limits.pullback Δ Γ_α
    AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst Δ Γ_α) X.hom) ∧
    AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst Δ Γ_α) X.hom) ∧
    Finite ↥W ∧
    Nonempty (↥W ≃ { x : ↥X.left // IsClosed ({x} : Set ↥X.left) ∧ α.base x = x }) :=
by
  let S : Scheme.{u} := X.left
  let p_hom : S ⟶ Spec (CommRingCat.of k) := X.hom
  let α : S ⟶ S := φ_X ≫ β
  let Δ := Limits.pullback.diagonal p_hom
  let Γ_α := Limits.pullback.lift (𝟙 S) α ((Category.id_comp p_hom).trans hα_hom.symm)
  let W := Limits.pullback Δ Γ_α
  let i_W : W ⟶ S := Limits.pullback.fst Δ Γ_α
  let j_W : W ⟶ S := Limits.pullback.snd Δ Γ_α
  let Q : ℕ := p ^ μ

  have hp_ge2 : 2 ≤ p := (Fact.out : Nat.Prime p).two_le
  have hQ_ge2 : 2 ≤ Q := le_trans hp_ge2 (Nat.le_self_pow (by omega : μ ≠ 0) p)
  have hQ_pos : 1 ≤ Q := by omega

  
  
  
  have h_binom_nil : ∀ {R : Type u} [CommRing R] (r δ : R), δ * δ = 0 →
      ∀ m : ℕ, (r + δ) ^ (m + 1) = r ^ (m + 1) + ((m + 1 : ℕ) : R) * r ^ m * δ := by
    intro R _ r δ hδ m
    induction m with
    | zero =>
      push_cast
      ring
    | succ m ih =>
      rw [pow_succ (r + δ) (m + 1), ih]
      calc
        (r ^ (m + 1) + ((m + 1 : ℕ) : R) * r ^ m * δ) * (r + δ) =
            r ^ (m + 2) + ((m + 1 + 1 : ℕ) : R) * r ^ (m + 1) * δ +
              ((m + 1 : ℕ) : R) * r ^ m * (δ * δ) := by
          push_cast
          ring
        _ = r ^ (m + 2) + ((m + 1 + 1 : ℕ) : R) * r ^ (m + 1) * δ := by
          rw [hδ, mul_zero, add_zero]

  have h_frobPow_etale_art :
      ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
        (g : A) [IsLocalization.Away g B]
        (κ : k →+* B) (_hκ : κ.FiniteType)
        (_hp : ((p : ℕ) : B) = 0)
        (θ : A →+* B),
        let J : Ideal B :=
          Ideal.span (Set.range (fun a : A => algebraMap A B a - (θ a) ^ Q))
        ((Ideal.Quotient.mk J).comp κ).Etale ∧ IsArtinianRing (B ⧸ J) := by
    intro A B _ _ _ g _ κ hκ hp θ
    let J : Ideal B := Ideal.span (Set.range (fun a : A => algebraMap A B a - (θ a) ^ Q))
    let C : Type u := B ⧸ J
    let _ : Algebra k B := κ.toAlgebra
    have : Algebra.FiniteType k B := RingHom.finiteType_algebraMap.mp hκ
    let π : B →+* C := Ideal.Quotient.mk J
    have : Algebra.FiniteType k C :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k J) Ideal.Quotient.mk_surjective
    have : Algebra.FinitePresentation k C :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance

    have hπ_rel : ∀ a : A, π (algebraMap A B a) = (π (θ a)) ^ Q := by
      intro a
      have hmem : algebraMap A B a - (θ a) ^ Q ∈ J := Ideal.subset_span ⟨a, rfl⟩
      have h0 : π (algebraMap A B a - (θ a) ^ Q) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_pow, sub_eq_zero] at h0
      exact h0

    rcases IsLocalization.Away.algebraMap_isUnit (S := B) g with ⟨u_B, hu_B⟩
    let u₀ : B := ↑(u_B⁻¹)
    have hu₀ : algebraMap A B g * u₀ = 1 := by
      rw [← hu_B]
      exact Units.mul_inv u_B
    have hgu_one : π (algebraMap A B g) * π u₀ = 1 := by
      rw [← map_mul, hu₀, map_one]
    have hπ_gu₀ : (π (θ g)) ^ Q * π u₀ = 1 := by
      rw [← hπ_rel g]
      exact hgu_one
    let w₀ : C := (π (θ g)) ^ (Q - 1) * π u₀
    have hw₀_inv : π (θ g) * w₀ = 1 := by
      dsimp only [w₀]
      rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel hQ_pos]
      exact hπ_gu₀
    have hu₀_pow : π u₀ = w₀ ^ Q := by
      have h1 : (π (θ g)) ^ Q * w₀ ^ Q = 1 := by
        rw [← mul_pow, hw₀_inv, one_pow]
      calc
        π u₀ = 1 * π u₀ := (one_mul _).symm
        _ = ((π (θ g)) ^ Q * w₀ ^ Q) * π u₀ := by rw [h1]
        _ = w₀ ^ Q * ((π (θ g)) ^ Q * π u₀) := by ring
        _ = w₀ ^ Q * 1 := by rw [hπ_gu₀]
        _ = w₀ ^ Q := mul_one _

    have h_surj_Q : ∀ y : C, ∃ z : C, z ^ Q = y := by
      intro y
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨n, a, hbn⟩ := IsLocalization.Away.surj g b
      refine ⟨π (θ a) * w₀ ^ n, ?_⟩
      calc
        (π (θ a) * w₀ ^ n) ^ Q = (π (θ a)) ^ Q * (w₀ ^ Q) ^ n := by ring
        _ = π (algebraMap A B a) * (π u₀) ^ n := by rw [← hπ_rel a, ← hu₀_pow]
        _ = π (b * (algebraMap A B g) ^ n) * (π u₀) ^ n := by rw [← hbn]
        _ = π b * (π (algebraMap A B g) * π u₀) ^ n := by
          rw [map_mul, map_pow]
          ring
        _ = π b * 1 ^ n := by rw [hgu_one]
        _ = π b := by rw [one_pow, mul_one]

    have hpC : ((p : ℕ) : C) = 0 := by
      rw [← map_natCast π p, hp, map_zero]

    have : Algebra.FormallyUnramified k C := by
      rw [Algebra.FormallyUnramified.iff_comp_injective]
      intro R_test _ _ I_test hI_sq g₁ g₂ hg
      have hpR : ((p : ℕ) : R_test) = 0 := by
        rw [← map_natCast g₁ p, hpC, map_zero]
      have hQR : ((Q : ℕ) : R_test) = 0 := by
        dsimp only [Q]
        rw [Nat.cast_pow, hpR, zero_pow (by omega : μ ≠ 0)]
      ext y
      obtain ⟨z, rfl⟩ := h_surj_Q y
      let r : R_test := g₂ z
      let δ : R_test := g₁ z - g₂ z
      have hg₁z : g₁ z = r + δ := (add_sub_cancel r (g₁ z)).symm
      have hδ_mem : δ ∈ I_test := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change Ideal.Quotient.mkₐ k I_test (g₁ z - g₂ z) = 0
        rw [map_sub, sub_eq_zero]
        exact AlgHom.congr_fun hg z
      have hδ_sq : δ * δ = 0 := by
        have hmem2 : δ * δ ∈ I_test ^ 2 := by
          rw [sq]
          exact Submodule.mul_mem_mul hδ_mem hδ_mem
        rwa [hI_sq, Submodule.mem_bot] at hmem2
      have hQ_eq : Q = (Q - 1) + 1 := (Nat.sub_add_cancel hQ_pos).symm
      rw [map_pow, map_pow, hg₁z, hQ_eq, h_binom_nil r δ hδ_sq (Q - 1), ← hQ_eq,
        hQR, zero_mul, zero_mul, add_zero]

    have : Algebra.FormallyEtale k C :=
      Algebra.FormallyEtale.of_formallyUnramified_of_field k C
    have : Algebra.Etale k C := Algebra.Etale.mk
    have hEt : ((Ideal.Quotient.mk J).comp κ).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance

    obtain ⟨I_idx, hFinI, Ai, hFieldAi, hAlgAi, e_pi, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k C).mp inferInstance
    let _ : Finite I_idx := hFinI
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra k (Ai i) := hAlgAi
    have : ∀ i, Module.Finite k (Ai i) := fun i => (hFinSep i).1
    have : Module.Finite k ((i : I_idx) → Ai i) := Module.Finite.pi
    have : Module.Finite k C := Module.Finite.equiv e_pi.symm.toLinearEquiv
    have hArt : IsArtinianRing C := IsArtinianRing.of_finite k C
    exact ⟨hEt, hArt⟩

  
  
  
  have hW_cond : i_W ≫ Δ = j_W ≫ Γ_α := Limits.pullback.condition

  have h_iW_eq_jW : i_W = j_W := by
    calc
      i_W = i_W ≫ (Δ ≫ Limits.pullback.fst p_hom p_hom) := by
        rw [Limits.pullback.diagonal_fst, Category.comp_id]
      _ = (i_W ≫ Δ) ≫ Limits.pullback.fst p_hom p_hom := (Category.assoc _ _ _).symm
      _ = (j_W ≫ Γ_α) ≫ Limits.pullback.fst p_hom p_hom := by rw [hW_cond]
      _ = j_W ≫ (Γ_α ≫ Limits.pullback.fst p_hom p_hom) := Category.assoc _ _ _
      _ = j_W := by rw [Limits.pullback.lift_fst, Category.comp_id]

  have h_iW_α : i_W ≫ α = i_W := by
    calc
      i_W ≫ α = j_W ≫ (Γ_α ≫ Limits.pullback.snd p_hom p_hom) := by
        rw [h_iW_eq_jW, Limits.pullback.lift_snd]
      _ = (j_W ≫ Γ_α) ≫ Limits.pullback.snd p_hom p_hom := (Category.assoc _ _ _).symm
      _ = (i_W ≫ Δ) ≫ Limits.pullback.snd p_hom p_hom := by rw [← hW_cond]
      _ = i_W ≫ (Δ ≫ Limits.pullback.snd p_hom p_hom) := Category.assoc _ _ _
      _ = i_W := by rw [Limits.pullback.diagonal_snd, Category.comp_id]

  have h_iW_mono : Mono i_W :=
    ⟨fun {T} a b hab => Limits.pullback.hom_ext hab (by
      change a ≫ j_W = b ≫ j_W
      rwa [← h_iW_eq_jW])⟩

  obtain ⟨liftW, h_liftW_iW⟩ :
      ∃ liftW : ∀ {T : Scheme.{u}} (t : T ⟶ S), t ≫ α = t → (T ⟶ W),
        ∀ {T : Scheme.{u}} (t : T ⟶ S) (ht : t ≫ α = t), liftW t ht ≫ i_W = t :=
    ⟨fun {T} t ht =>
      Limits.pullback.lift t t
        (Limits.pullback.hom_ext
          (by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id,
                Category.assoc, Limits.pullback.lift_fst, Category.comp_id])
          (by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
                Category.assoc, Limits.pullback.lift_snd, ht])),
     fun t ht => Limits.pullback.lift_fst _ _ _⟩

  let toSpecHom : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}},
      (T ⟶ Spec R) → (R ⟶ Γ(T, ⊤)) :=
    fun {T} {R} g => ((ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm g).unop

  have toSpecHom_inj : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}} {g₁ g₂ : T ⟶ Spec R},
      toSpecHom g₁ = toSpecHom g₂ → g₁ = g₂ := by
    intro T R g₁ g₂ h
    apply (ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm.injective
    exact Quiver.Hom.unop_inj h

  have toSpecHom_comp_right : ∀ {T : Scheme.{u}} {R R' : CommRingCat.{u}}
      (g : T ⟶ Spec R) (ψ : R' ⟶ R),
      toSpecHom (g ≫ Spec.map ψ) = ψ ≫ toSpecHom g :=
    fun g ψ => congrArg Quiver.Hom.unop (ΓSpec.adjunction.homEquiv_naturality_right_symm g ψ.op)

  let fromSpecHom : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}},
      (R ⟶ Γ(T, ⊤)) → (T ⟶ Spec R) :=
    fun {T} {R} ψ => (ΓSpec.adjunction.homEquiv T (Opposite.op R)) (Opposite.op ψ)

  have toSpecHom_fromSpecHom : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}} (ψ : R ⟶ Γ(T, ⊤)),
      toSpecHom (fromSpecHom ψ) = ψ :=
    fun {T} {R} ψ => congrArg Quiver.Hom.unop
      ((ΓSpec.adjunction.homEquiv T (Opposite.op R)).symm_apply_apply (Opposite.op ψ))

  
  
  
  have h_chart : ∀ w : ↥W,
      ∃ (C : Type u) (_ : CommRing C) (_ : IsArtinianRing C)
        (φ_k : k →+* C)
        (v : Spec (CommRingCat.of C) ⟶ W)
        (z : ↥(Spec (CommRingCat.of C))),
        φ_k.Etale ∧
        IsOpenImmersion v ∧
        v.base z = w ∧
        v ≫ (i_W ≫ p_hom) = Spec.map (CommRingCat.ofHom φ_k) := by
    intro w
    let x : ↥S := i_W.base w
    have hx_α : α.base x = x := by
      change (i_W ≫ α).base w = i_W.base w
      rw [h_iW_α]
    obtain ⟨U, hU, hxU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := S) (x := x) (U := ⊤) trivial
    let U' : S.Opens := (TopologicalSpace.Opens.map α.base).obj U
    have hxU' : x ∈ U' := by
      change α.base x ∈ U
      rwa [hx_α]
    obtain ⟨g, hg_U', hxV⟩ := hU.exists_basicOpen_le (⟨x, hxU'⟩ : ↥U') hxU
    let V : S.Opens := S.basicOpen g
    have hV : IsAffineOpen V := hU.basicOpen g
    have hg_U : V ≤ U := S.basicOpen_le g
    let R_U : CommRingCat.{u} := S.presheaf.obj (Opposite.op U)
    let R_V : CommRingCat.{u} := S.presheaf.obj (Opposite.op V)
    let A : Type u := ↑R_U
    let B : Type u := ↑R_V
    have : IsLocalization.Away g B := hU.isLocalization_basicOpen g
    have : IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
    have : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec

    let κ_cat : CommRingCat.of k ⟶ R_V :=
      (Spec.fullyFaithful.preimage (hV.fromSpec ≫ p_hom)).unop
    have hκ_spec : Spec.map κ_cat = hV.fromSpec ≫ p_hom :=
      Spec.fullyFaithful.map_preimage _
    let κ : k →+* B := κ_cat.hom
    have hκ_ft : κ.FiniteType := by
      have hlft : LocallyOfFiniteType (hV.fromSpec ≫ p_hom) := inferInstance
      rw [← hκ_spec] at hlft
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft

    have hp_B : ((p : ℕ) : B) = 0 := hφ_X.1 V
    have hφ_base_pt : ∀ y : ↥S, φ_X.base y = y := by
      intro y
      have h := hφ_X.2.1
      change φ_X.base y = (CategoryStruct.id S).base y
      rw [h]
    have hV_φ : V ≤ (TopologicalSpace.Opens.map φ_X.base).obj V := by
      intro y hy
      change φ_X.base y ∈ V
      rwa [hφ_base_pt y]
    have hV_β : V ≤ (TopologicalSpace.Opens.map β.base).obj U := by
      intro y hy
      have hyU' : y ∈ U' := hg_U' hy
      change β.base y ∈ U
      have hαy : α.base y = β.base (φ_X.base y) := rfl
      rw [← hφ_base_pt y, ← hαy]
      exact hyU'

    let θ : A →+* B := (β.appLE U V hV_β).hom
    have hα_app : ∀ a : A, (α.appLE U V hg_U').hom a = (θ a) ^ Q := by
      intro a
      have hcomp := Scheme.Hom.appLE_comp_appLE φ_X β U V V hV_β hV_φ
      have happ := congrArg (fun f : R_U ⟶ R_V => f.hom a) hcomp.symm
      change (α.appLE U V hg_U').hom a = (φ_X.appLE V V hV_φ).hom (θ a) at happ
      rw [happ]
      exact hφ_X.2.2 V hV_φ (θ a)

    let J : Ideal B :=
      Ideal.span (Set.range (fun a : A => algebraMap A B a - (θ a) ^ Q))
    let C : Type u := B ⧸ J
    obtain ⟨hEt_C, hArt_C⟩ := h_frobPow_etale_art A B g κ hκ_ft hp_B θ

    let ρ_cat : R_U ⟶ R_V := S.presheaf.map (homOfLE hg_U).op
    let α_cat : R_U ⟶ R_V := α.appLE U V hg_U'
    have hρ_fromSpec : Spec.map ρ_cat ≫ hU.fromSpec = hV.fromSpec :=
      hU.map_fromSpec hV (homOfLE hg_U).op
    have hα_fromSpec : Spec.map α_cat ≫ hU.fromSpec = hV.fromSpec ≫ α :=
      hU.SpecMap_appLE_fromSpec α hV hg_U'

    let π_quot : Spec (CommRingCat.of C) ⟶ Spec R_V :=
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
    have : IsClosedImmersion π_quot :=
      IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (Ideal.Quotient.mk J)) Ideal.Quotient.mk_surjective
    have : Mono π_quot :=
      ((IsClosedImmersion.iff_isFinite_and_mono π_quot).mp inferInstance).2

    have hπ_eq : π_quot ≫ Spec.map α_cat = π_quot ≫ Spec.map ρ_cat := by
      dsimp only [π_quot]
      rw [← Spec.map_comp, ← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      change Ideal.Quotient.mk J (α_cat.hom a) = Ideal.Quotient.mk J (algebraMap A B a)
      rw [hα_app a]
      symm
      rw [Ideal.Quotient.eq]
      exact Ideal.subset_span ⟨a, rfl⟩

    have hπV_α : (π_quot ≫ hV.fromSpec) ≫ α = π_quot ≫ hV.fromSpec := by
      rw [Category.assoc, ← hα_fromSpec, ← Category.assoc, hπ_eq, Category.assoc, hρ_fromSpec]

    obtain ⟨v, hv_iW⟩ : ∃ v : Spec (CommRingCat.of C) ⟶ W, v ≫ i_W = π_quot ≫ hV.fromSpec :=
      ⟨liftW (π_quot ≫ hV.fromSpec) hπV_α, h_liftW_iW (π_quot ≫ hV.fromSpec) hπV_α⟩

    have hv_comp :
        v ≫ (i_W ≫ p_hom) = Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J).comp κ)) := by
      rw [← Category.assoc, hv_iW, Category.assoc, ← hκ_spec, ← Spec.map_comp]
      rfl

    let W_V := Limits.pullback i_W hV.fromSpec
    let p_V : W_V ⟶ W := Limits.pullback.fst i_W hV.fromSpec
    let q_V : W_V ⟶ Spec R_V := Limits.pullback.snd i_W hV.fromSpec
    let α_V : Spec (CommRingCat.of C) ⟶ W_V :=
      Limits.pullback.lift v π_quot hv_iW

    have hq_eq : q_V ≫ Spec.map α_cat = q_V ≫ Spec.map ρ_cat := by
      apply (cancel_mono hU.fromSpec).mp
      calc
        (q_V ≫ Spec.map α_cat) ≫ hU.fromSpec
            = q_V ≫ (Spec.map α_cat ≫ hU.fromSpec) := Category.assoc _ _ _
        _ = q_V ≫ (hV.fromSpec ≫ α) := by rw [hα_fromSpec]
        _ = (q_V ≫ hV.fromSpec) ≫ α := (Category.assoc _ _ _).symm
        _ = (p_V ≫ i_W) ≫ α := by rw [← Limits.pullback.condition]
        _ = p_V ≫ (i_W ≫ α) := Category.assoc _ _ _
        _ = p_V ≫ i_W := by rw [h_iW_α]
        _ = q_V ≫ hV.fromSpec := Limits.pullback.condition
        _ = q_V ≫ (Spec.map ρ_cat ≫ hU.fromSpec) := by rw [hρ_fromSpec]
        _ = (q_V ≫ Spec.map ρ_cat) ≫ hU.fromSpec := (Category.assoc _ _ _).symm

    let fq : B →+* ↑Γ(W_V, ⊤) := (toSpecHom q_V).hom
    have hfq_eq : α_cat ≫ toSpecHom q_V = ρ_cat ≫ toSpecHom q_V := by
      rw [← toSpecHom_comp_right, ← toSpecHom_comp_right, hq_eq]
    have hker : J ≤ RingHom.ker fq := by
      rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, sub_eq_zero]
      have h1 := ConcreteCategory.congr_hom hfq_eq a
      change fq (α_cat.hom a) = fq (algebraMap A B a) at h1
      rw [hα_app a] at h1
      exact h1.symm
    let lq : C →+* ↑Γ(W_V, ⊤) := Ideal.Quotient.lift J fq hker
    let β_V : W_V ⟶ Spec (CommRingCat.of C) := fromSpecHom (CommRingCat.ofHom lq)
    have hβ_π : β_V ≫ π_quot = q_V := by
      apply toSpecHom_inj
      rw [toSpecHom_comp_right, toSpecHom_fromSpecHom]
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      rfl

    have hαβ : α_V ≫ β_V = 𝟙 _ := by
      apply (cancel_mono π_quot).mp
      rw [Category.assoc, hβ_π, Limits.pullback.lift_snd, Category.id_comp]

    have hβα : β_V ≫ α_V = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · apply (cancel_mono i_W).mp
        calc
          ((β_V ≫ α_V) ≫ p_V) ≫ i_W
              = β_V ≫ ((α_V ≫ p_V) ≫ i_W) := by simp only [Category.assoc]
          _ = β_V ≫ (v ≫ i_W) := by rw [Limits.pullback.lift_fst]
          _ = (β_V ≫ π_quot) ≫ hV.fromSpec := by rw [hv_iW, Category.assoc]
          _ = q_V ≫ hV.fromSpec := by rw [hβ_π]
          _ = p_V ≫ i_W := Limits.pullback.condition.symm
          _ = (𝟙 W_V ≫ p_V) ≫ i_W := by rw [Category.id_comp]
      · rw [Category.assoc, Limits.pullback.lift_snd, hβ_π, Category.id_comp]

    have : IsIso α_V := ⟨⟨β_V, hαβ, hβα⟩⟩
    have hv_eq_comp : v = α_V ≫ p_V := (Limits.pullback.lift_fst v π_quot hv_iW).symm
    have hv_open : IsOpenImmersion v := by
      rw [hv_eq_comp]
      infer_instance

    have hw_mem : w ∈ p_V.opensRange := by
      rw [Scheme.Hom.opensRange_pullbackFst hV.fromSpec i_W]
      change i_W.base w ∈ hV.fromSpec.opensRange
      rw [hV.opensRange_fromSpec]
      exact hxV
    rcases hw_mem with ⟨z₀, hz₀⟩
    refine ⟨C, inferInstance, hArt_C, (Ideal.Quotient.mk J).comp κ, v, β_V.base z₀,
      hEt_C, hv_open, ?_, hv_comp⟩
    rw [hv_eq_comp]
    change (β_V ≫ α_V ≫ p_V).base z₀ = w
    rw [← Category.assoc, hβα, Category.id_comp]
    exact hz₀

  
  
  
  choose C_w hCR_w hArt_w φ_kw v_w z_w hEt_w hv_open_w hv_z_w hv_comp_w using h_chart
  let _ : ∀ w : ↥W, CommRing (C_w w) := hCR_w
  let _ : ∀ w : ↥W, IsArtinianRing (C_w w) := hArt_w
  have _ : ∀ w : ↥W, IsOpenImmersion (v_w w) := hv_open_w

  have hW_disc : DiscreteTopology ↥W := by
    rw [discreteTopology_iff_isOpen_singleton]
    intro w
    have hArtSch : IsArtinianScheme (Spec (CommRingCat.of (C_w w))) :=
      Scheme.isArtinianScheme_Spec.mpr inferInstance
    have : DiscreteTopology ↥(Spec (CommRingCat.of (C_w w))) :=
      (IsArtinianScheme.iff_isNoetherian_and_discreteTopology.mp hArtSch).2
    have hz_open : IsOpen ({z_w w} : Set ↥(Spec (CommRingCat.of (C_w w)))) :=
      isOpen_discrete {z_w w}
    have himg : (v_w w).base '' ({z_w w} : Set ↥(Spec (CommRingCat.of (C_w w)))) = {w} := by
      rw [Set.image_singleton, hv_z_w w]
    rw [← himg]
    exact (v_w w).isOpenEmbedding.isOpenMap _ hz_open

  have : IsClosedImmersion Γ_α := by
    have hΓ_fst : Γ_α ≫ Limits.pullback.fst p_hom p_hom = 𝟙 S :=
      Limits.pullback.lift_fst _ _ _
    have : IsClosedImmersion (Γ_α ≫ Limits.pullback.fst p_hom p_hom) := by
      rw [hΓ_fst]
      infer_instance
    exact IsClosedImmersion.of_comp Γ_α (Limits.pullback.fst p_hom p_hom)

  have : IsClosedImmersion i_W := inferInstance
  have : IsProper i_W := inferInstance
  have : IsProper (i_W ≫ p_hom) := inferInstance
  have : QuasiCompact (i_W ≫ p_hom) := inferInstance
  have : CompactSpace ↥W := QuasiCompact.compactSpace_of_compactSpace (i_W ≫ p_hom)
  have hFinType_W : Finite ↥W := finite_of_compact_of_discrete
  have : IsAffine W := inferInstance
  have : IsAffineHom (i_W ≫ p_hom) := isAffineHom_of_isAffine (i_W ≫ p_hom)
  have hW_fin : IsFinite (i_W ≫ p_hom) :=
    IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩

  let 𝒰_W : W.OpenCover :=
    Scheme.Cover.mkOfCovers ↥W (fun w => Spec (CommRingCat.of (C_w w))) v_w
      (fun w => ⟨w, z_w w, hv_z_w w⟩)

  have hW_et : Etale (i_W ≫ p_hom) := by
    have : IsZariskiLocalAtSource (@Etale.{u}) :=
      HasRingHomProperty.instIsZariskiLocalAtSource (P := @Etale.{u})
    apply IsZariskiLocalAtSource.of_openCover 𝒰_W
    intro w
    change Etale (v_w w ≫ (i_W ≫ p_hom))
    rw [hv_comp_w w]
    exact (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (hEt_w w)

  
  let pt₀ : ↥(Spec (CommRingCat.of k)) := default

  obtain ⟨ι_S, hι_S⟩ : ∃ ι_S : ∀ x : ↥S, CommRingCat.of k ⟶ S.residueField x,
      ∀ x : ↥S, Spec.map (ι_S x) = S.fromSpecResidueField x ≫ p_hom :=
    ⟨fun x => (Spec.fullyFaithful.preimage (S.fromSpecResidueField x ≫ p_hom)).unop,
     fun _ => Spec.fullyFaithful.map_preimage _⟩

  have h_closed_bij : ∀ x : ↥S,
      IsClosed ({x} : Set ↥S) → Function.Bijective (ι_S x).hom := by
    intro x hx
    have : IsClosedImmersion (S.fromSpecResidueField x) :=
      (isClosed_singleton_iff_isClosedImmersion (x := x)).mp hx
    have hlft_comp : LocallyOfFiniteType (S.fromSpecResidueField x ≫ p_hom) := inferInstance
    rw [← hι_S x] at hlft_comp
    have hft : RingHom.FiniteType (ι_S x).hom :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft_comp
    have hfin : RingHom.Finite (ι_S x).hom :=
      RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hft
    let _ : Algebra k ↥(S.residueField x) := (ι_S x).hom.toAlgebra
    have : Module.Finite k ↥(S.residueField x) := hfin
    have : Algebra.IsIntegral k ↥(S.residueField x) :=
      Algebra.IsIntegral.of_finite k ↥(S.residueField x)
    exact IsAlgClosed.algebraMap_bijective_of_isIntegral

  let eS₀ := Scheme.SpecToEquivOfField k S
  have h_eS₀_pt : ∀ (s : Spec (CommRingCat.of k) ⟶ S), s.base pt₀ = (eS₀ s).1 := by
    intro s
    conv_lhs => rw [← eS₀.symm_apply_apply s]
    rw [Scheme.SpecToEquivOfField_symm_apply]
    exact Scheme.fromSpecResidueField_apply (eS₀ s).1 ((Spec.map (eS₀ s).2).base pt₀)

  have h_eS₀_sec : ∀ xf : (x : ↥S) × (S.residueField x ⟶ CommRingCat.of k),
      (eS₀.symm xf ≫ p_hom = 𝟙 _) ↔ (ι_S xf.1 ≫ xf.2 = 𝟙 _) := by
    intro xf
    rw [Scheme.SpecToEquivOfField_symm_apply, Category.assoc,
      ← hι_S xf.1, ← Spec.map_comp, ← Spec.map_id]
    exact Spec.map_injective.eq_iff

  have h_rinv : ∀ (x : ↥S) (ψ : S.residueField x ⟶ CommRingCat.of k),
      ι_S x ≫ ψ = 𝟙 _ → ∀ y : ↥(S.residueField x), (ι_S x).hom (ψ.hom y) = y := by
    intro x ψ hψ y
    apply RingHom.injective ψ.hom
    exact ConcreteCategory.congr_hom hψ (ψ.hom y)

  have h_sec_ext : ∀ (s₁ s₂ : Spec (CommRingCat.of k) ⟶ S),
      s₁ ≫ p_hom = 𝟙 _ → s₂ ≫ p_hom = 𝟙 _ → s₁.base pt₀ = s₂.base pt₀ → s₁ = s₂ := by
    intro s₁ s₂ hs₁ hs₂ hpt
    apply eS₀.injective
    have hx : (eS₀ s₁).1 = (eS₀ s₂).1 := by
      rw [← h_eS₀_pt s₁, ← h_eS₀_pt s₂, hpt]
    have hψ₁ : ι_S (eS₀ s₁).1 ≫ (eS₀ s₁).2 = 𝟙 _ :=
      (h_eS₀_sec (eS₀ s₁)).mp (by rw [eS₀.symm_apply_apply]; exact hs₁)
    have hψ₂ : ι_S (eS₀ s₂).1 ≫ (eS₀ s₂).2 = 𝟙 _ :=
      (h_eS₀_sec (eS₀ s₂)).mp (by rw [eS₀.symm_apply_apply]; exact hs₂)
    rcases h1 : eS₀ s₁ with ⟨x₁, ψ₁⟩
    rcases h2 : eS₀ s₂ with ⟨x₂, ψ₂⟩
    rw [h1] at hx hψ₁
    rw [h2] at hx hψ₂
    dsimp only at hx hψ₁ hψ₂
    subst hx
    congr 1
    ext y
    calc
      ψ₁.hom y = ψ₁.hom ((ι_S x₁).hom (ψ₂.hom y)) := by rw [h_rinv x₁ ψ₂ hψ₂ y]
      _ = ψ₂.hom y := ConcreteCategory.congr_hom hψ₁ (ψ₂.hom y)

  have h_iW_emb : Topology.IsClosedEmbedding i_W.base :=
    IsClosedImmersion.isClosedEmbedding i_W

  let toFixedPt : ↥W → { x : ↥S // IsClosed ({x} : Set ↥S) ∧ α.base x = x } :=
    fun w =>
      ⟨i_W.base w,
        by
          have hw_cl : IsClosed ({w} : Set ↥W) := isClosed_discrete {w}
          have himg : i_W.base '' ({w} : Set ↥W) = {i_W.base w} := Set.image_singleton
          rw [← himg]
          exact h_iW_emb.isClosedMap _ hw_cl,
        by
          change (i_W ≫ α).base w = i_W.base w
          rw [h_iW_α]⟩

  have h_toFixedPt_bij : Function.Bijective toFixedPt := by
    constructor
    · intro w₁ w₂ hw
      exact h_iW_emb.injective (congrArg Subtype.val hw)
    · rintro ⟨x, hx_cl, hx_fix⟩
      have hbij := h_closed_bij x hx_cl
      let ψ_x : S.residueField x ⟶ CommRingCat.of k :=
        CommRingCat.ofHom (RingEquiv.ofBijective (ι_S x).hom hbij).symm.toRingHom
      let s_x : Spec (CommRingCat.of k) ⟶ S := eS₀.symm ⟨x, ψ_x⟩
      have hs_p : s_x ≫ p_hom = 𝟙 _ :=
        (h_eS₀_sec ⟨x, ψ_x⟩).mpr (by
          ext c
          exact (RingEquiv.ofBijective (ι_S x).hom hbij).symm_apply_apply c)
      have hs_pt : s_x.base pt₀ = x := by
        dsimp only [s_x]
        rw [h_eS₀_pt, eS₀.apply_symm_apply]
      have hs_α : s_x ≫ α = s_x := by
        apply h_sec_ext (s_x ≫ α) s_x
        · rw [Category.assoc, hα_hom, hs_p]
        · exact hs_p
        · change α.base (s_x.base pt₀) = s_x.base pt₀
          rw [hs_pt, hx_fix]
      let s_tilde : Spec (CommRingCat.of k) ⟶ W := liftW s_x hs_α
      refine ⟨s_tilde.base pt₀, ?_⟩
      apply Subtype.ext
      change (s_tilde ≫ i_W).base pt₀ = x
      rw [h_liftW_iW s_x hs_α, hs_pt]

  exact ⟨hW_fin, hW_et, hFinType_W, ⟨Equiv.ofBijective toFixedPt h_toFixedPt_bij⟩⟩

theorem weil_curve_tr_geom_frob_bdry_and_comp_permutations (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (B₀ : Type u) [CommRing B₀]
    [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (r : ℕ) (hr : 1 ≤ r)
    (σ : B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀)
    (ι_bar : Quiver.Hom (weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)))
    (hι_fst : CategoryTheory.CategoryStruct.comp ι_bar
        (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst (weilCurveTrGeomCoverOver F B₀).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap
                (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
                B₀)))
            e_U.hom)
          U₀.ι))
    (hι_snd : CategoryTheory.CategoryStruct.comp ι_bar
        (CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) =
