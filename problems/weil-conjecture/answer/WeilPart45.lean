          rw [hex_ρδ]
          exact h0_δ
        obtain ⟨w, hw⟩ := hmem
        refine ⟨r_comp m 0 w, ?_⟩
        change e_S0 m (ρ_H m ((r_comp m 0).symm (r_comp m 0 w))) = u
        rw [(r_comp m 0).symm_apply_apply, hw, (e_S0 m).apply_symm_apply]
    · 
      ext x
      simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨u, rfl⟩
        change r_comp m 1 (ι_H m 1 (e_K m 1 ((e_K m 1).symm (δ_ext m ((e_S0 m).symm u))))) = 0
        rw [(e_K m 1).apply_symm_apply]
        have hmem : δ_ext m ((e_S0 m).symm u) ∈ AddMonoidHom.ker (ι_H m 1) := by
          rw [← hex_δι]
          exact ⟨(e_S0 m).symm u, rfl⟩
        rw [AddMonoidHom.mem_ker.mp hmem, map_zero]
      · intro hx
        have h0_ι : ι_H m 1 (e_K m 1 x) = 0 := by
          apply (r_comp m 1).injective
          rw [map_zero]
          exact hx
        have hmem : e_K m 1 x ∈ AddMonoidHom.range (δ_ext m) := by
          rw [hex_δι]
          exact h0_ι
        obtain ⟨z, hz⟩ := hmem
        refine ⟨e_S0 m z, ?_⟩
        change (e_K m 1).symm (δ_ext m ((e_S0 m).symm (e_S0 m z))) = x
        rw [(e_S0 m).symm_apply_apply, hz, (e_K m 1).symm_apply_apply]
    · 
      exact (r_comp m 1).surjective.comp
        ((hsurj_ι (hSub_Sq m 1 (le_refl 1))).comp (e_K m 1).surjective)
    · 
      intro v t
      let w := (r_comp m 0).symm v
      have hw_act : (r_comp m 0).symm (act_comp m 0 v) =
          ((CategoryTheory.Abelian.Ext.mk₀ (βL m)).postcomp X (Nat.add_zero 0))
            ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
              ((P.mapExtAddHom X (L m) 0) w) (Nat.zero_add 0)) := by
        apply (r_comp m 0).injective
        rw [(r_comp m 0).apply_symm_apply]
        exact ((hr_comp_act m 0 w).trans (congrArg (act_comp m 0) ((r_comp m 0).apply_symm_apply v))).symm
      change e_S0 m (ρ_H m ((r_comp m 0).symm (act_comp m 0 v))) t =
        e_S0 m (ρ_H m w) (π_bdry t)
