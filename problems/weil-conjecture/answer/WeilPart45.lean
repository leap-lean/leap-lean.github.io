          (k • (1 : Matrix (Fin m₀) (Fin m₀) (ZMod (ℓ ^ K)))) i j * v_x j = (k • v_x) i
        rw [Finset.sum_eq_single i]
        · rw [Matrix.smul_apply, Matrix.one_apply, if_pos rfl, Pi.smul_apply, nsmul_eq_mul,
            nsmul_eq_mul, mul_one]
        · intro j _ hji
          rw [Matrix.smul_apply, Matrix.one_apply, if_neg (Ne.symm hji), smul_zero, zero_mul]
        · intro hi; exact False.elim (hi (Finset.mem_univ i))
      have hVU : s₂ • (V_mat * U_mat) =
          (s₁ * s₂ ^ 2) • (1 : Matrix (Fin b_M) (Fin b_M) (ZMod (ℓ ^ K))) := by
        have h1 : (ℓ ^ B₂ : ℕ) • (V_mat * U_mat - (ℓ ^ (B₁ + B₂) : ℕ) • 1) = 0 := by
          apply hmulVec_nsmul_zero
          intro x
          apply hqM_ker
          rw [hsub_mv, map_sub, Matrix.mulVecLin_mul, LinearMap.comp_apply, hV_mul,
            hU_mul, ← mul_nsmul, ← pow_add, hid_mv, map_nsmul, sub_self]
        rw [smul_sub, sub_eq_zero, hnsmul_mat, hnsmul_mat, hnsmul_mat, smul_smul] at h1
        rw [h1]
        congr 1
        dsimp [s₁, s₂]
        push_cast
        ring
      have hUV : s₁ • (U_mat * V_mat) =
          (s₁ ^ 2 * s₂) • (1 : Matrix (Fin c) (Fin c) (ZMod (ℓ ^ K))) := by
        have h1 : (ℓ ^ B₁ : ℕ) • (U_mat * V_mat - (ℓ ^ (B₁ + B₂) : ℕ) • 1) = 0 := by
          apply hmulVec_nsmul_zero
          intro y
          apply hqN_ker
          rw [hsub_mv, map_sub, Matrix.mulVecLin_mul, LinearMap.comp_apply, hU_mul,
            hV_mul, ← mul_nsmul, ← pow_add, add_comm B₂ B₁, hid_mv, map_nsmul, sub_self]
        rw [smul_sub, sub_eq_zero, hnsmul_mat, hnsmul_mat, hnsmul_mat, smul_smul] at h1
        rw [h1]
        congr 1
        dsimp [s₁, s₂]
        push_cast
        ring
      have htr_mod : (s₁ ^ 2 * s₂ ^ 2) * Matrix.trace M_bar =
          (s₁ ^ 2 * s₂ ^ 2) * Matrix.trace N_bar := by
        calc (s₁ ^ 2 * s₂ ^ 2) * Matrix.trace M_bar
            = Matrix.trace (((s₁ * s₂ ^ 2) •
                (1 : Matrix (Fin b_M) (Fin b_M) (ZMod (ℓ ^ K)))) * (s₁ • M_bar)) := by
                rw [Matrix.smul_mul, Matrix.mul_smul, one_mul, smul_smul, Matrix.trace_smul,
                  smul_eq_mul]
                ring
          _ = Matrix.trace ((s₂ • (V_mat * U_mat)) * (s₁ • M_bar)) := by rw [← hVU]
          _ = Matrix.trace ((s₂ • V_mat) * (s₁ • (U_mat * M_bar))) := by
                rw [Matrix.smul_mul, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_smul,
                  Matrix.mul_assoc]
          _ = Matrix.trace ((s₂ • V_mat) * (s₁ • (N_bar * U_mat))) := by rw [hUM]
          _ = Matrix.trace ((s₁ • (N_bar * U_mat)) * (s₂ • V_mat)) := Matrix.trace_mul_comm _ _
          _ = Matrix.trace ((s₂ • N_bar) * (s₁ • (U_mat * V_mat))) := by
                rw [Matrix.smul_mul, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_smul,
                  Matrix.mul_assoc, smul_comm s₁ s₂]
          _ = Matrix.trace ((s₂ • N_bar) *
                ((s₁ ^ 2 * s₂) • (1 : Matrix (Fin c) (Fin c) (ZMod (ℓ ^ K))))) := by rw [hUV]
          _ = (s₁ ^ 2 * s₂ ^ 2) * Matrix.trace N_bar := by
                rw [Matrix.smul_mul, Matrix.mul_smul, mul_one, smul_smul, Matrix.trace_smul,
                  smul_eq_mul]
                ring
      let D : ZMod (ℓ ^ K) := PadicInt.toZModPow K (Matrix.trace M_i) -
        PadicInt.toZModPow K (Matrix.trace N_lat)
      let w_D : ℕ := D.val
      have htr_Mbar : Matrix.trace M_bar = PadicInt.toZModPow K (Matrix.trace M_i) := by
        simp only [M_bar, Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
      have htr_Nbar : Matrix.trace N_bar = PadicInt.toZModPow K (Matrix.trace N_lat) := by
        simp only [N_bar, Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
      have hmul_D : ((ℓ ^ (2 * B₁ + 2 * B₂) : ℕ) : ZMod (ℓ ^ K)) * D = 0 := by
        have hpow_s : ((ℓ ^ (2 * B₁ + 2 * B₂) : ℕ) : ZMod (ℓ ^ K)) = s₁ ^ 2 * s₂ ^ 2 := by
          dsimp [s₁, s₂]; push_cast; ring
        rw [hpow_s, mul_sub, ← htr_Mbar, ← htr_Nbar, htr_mod, sub_self]
      have hnat_zero : ((ℓ ^ (2 * B₁ + 2 * B₂) * w_D : ℕ) : ZMod (ℓ ^ K)) = 0 := by
        dsimp [w_D]
        rw [Nat.cast_mul, ZMod.natCast_zmod_val, hmul_D]
      have hdvd_K : ℓ ^ K ∣ ℓ ^ (2 * B₁ + 2 * B₂) * w_D :=
        (ZMod.natCast_eq_zero_iff _ (ℓ ^ K)).mp hnat_zero
      have hdvd_K' : ℓ ^ K' ∣ w_D := by
        have hpow_K : ℓ ^ K = ℓ ^ (2 * B₁ + 2 * B₂) * ℓ ^ K' := by
          dsimp [K]; rw [add_assoc, add_comm K', pow_add]
        rw [hpow_K] at hdvd_K
        exact (Nat.mul_dvd_mul_iff_left (pow_pos hPrime_ℓ.pos _)).mp hdvd_K
      have hK'_le : K' ≤ K := by omega
      let cast_K' := ZMod.castHom (pow_dvd_pow ℓ hK'_le) (ZMod (ℓ ^ K'))
      have hcast_D : cast_K' D = 0 := by
        have hD_val : D = (w_D : ZMod (ℓ ^ K)) := (ZMod.natCast_zmod_val D).symm
        rw [hD_val, map_natCast]
        exact (ZMod.natCast_eq_zero_iff w_D (ℓ ^ K')).mpr hdvd_K'
      have hcast_M := RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow K' K hK'_le)
        (Matrix.trace M_i)
      have hcast_N := RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow K' K hK'_le)
        (Matrix.trace N_lat)
      simp only [RingHom.comp_apply] at hcast_M hcast_N
      rw [← hcast_M, ← hcast_N]
      exact sub_eq_zero.mp (by rwa [← map_sub])

  
  let τ_prod : ∀ (q m : ℕ),
      (∀ ι : Fin m_c, H_comp ι q (m + 1 + 1)) →+ (∀ ι : Fin m_c, H_comp ι q (m + 1)) :=
    fun q m =>
      { toFun := fun v ι => τ_comp ι q (m + 1) (v ι)
        map_zero' := by funext ι; exact map_zero _
        map_add' := fun v₁ v₂ => by funext ι; exact map_add _ _ _ }
  have hAnn_prod : ∀ (q m : ℕ) (v : ∀ ι : Fin m_c, H_comp ι q (m + 1)),
      (ℓ ^ (m + 1) : ℕ) • v = 0 := by
    intro q m v; funext ι; exact hAnn_comp ι q (m + 1) (v ι)
  let sys_prod : ∀ q : ℕ, AddSubgroup (∀ m : ℕ, ∀ ι : Fin m_c, H_comp ι q (m + 1)) :=
    fun q => AddMonoidHom.ker (AddMonoidHom.pi fun m =>
      (τ_prod q m).comp (Pi.evalAddMonoidHom (fun k => ∀ ι, H_comp ι q (k + 1)) (m + 1)) -
      Pi.evalAddMonoidHom (fun k => ∀ ι, H_comp ι q (k + 1)) m)
  have hInstProd_ex : ∀ q : ℕ,
      ∃ inst : Module (PadicInt ℓ) ↥(sys_prod q),
        ∀ (z : PadicInt ℓ) (x : ↥(sys_prod q)) (m : ℕ),
          (@SMul.smul _ _ inst.toSMul z x).1 m =
            (PadicInt.toZModPow (m + 1) z).val • x.1 m :=
    fun q => hSysMod (fun m => ∀ ι : Fin m_c, H_comp ι q (m + 1)) (τ_prod q) 1 (hAnn_prod q)
  let instProd : ∀ q : ℕ, Module (PadicInt ℓ) ↥(sys_prod q) :=
    fun q => Classical.choose (hInstProd_ex q)
  letI : ∀ q : ℕ, Module (PadicInt ℓ) ↥(sys_prod q) := instProd
  have hsmul_prod : ∀ (q : ℕ) (z : PadicInt ℓ) (x : ↥(sys_prod q)) (m : ℕ),
      (z • x).1 m = (PadicInt.toZModPow (m + 1) z).val • x.1 m :=
    fun q => Classical.choose_spec (hInstProd_ex q)

  have hmem_sysProd : ∀ {q : ℕ} {f : ∀ m : ℕ, ∀ ι : Fin m_c, H_comp ι q (m + 1)},
      f ∈ sys_prod q ↔ ∀ (m : ℕ) (ι : Fin m_c), τ_comp ι q (m + 1) (f (m + 1) ι) = f m ι := by
    intro q f
    simp only [sys_prod, AddMonoidHom.mem_ker, AddMonoidHom.pi_apply, AddMonoidHom.sub_apply,
      AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, funext_iff, Pi.zero_apply, sub_eq_zero,
      τ_prod, AddMonoidHom.coe_mk, ZeroHom.coe_mk]

  let Φ_K : ∀ q : ℕ, ↥(sys_K q) →ₗ[PadicInt ℓ] ↥(sys_K q) := fun q =>
    { toFun := fun x => ⟨fun m => α_K m q (x.1 m),
        hmem_sysK.mpr fun m => (hBock8 q m (x.1 (m + 1))).trans (congrArg (α_K m q) (hmem_sysK.mp x.2 m))⟩
      map_add' := fun x y => by apply Subtype.ext; funext m; exact map_add _ _ _
      map_smul' := fun z x => by
        apply Subtype.ext; funext m
        simp only [RingHom.id_apply]
        rw [hsmul_K, hsmul_K]
        exact map_nsmul (α_K m q) _ (x.1 m) }

  let Φ_prod : ∀ q : ℕ, ↥(sys_prod q) →ₗ[PadicInt ℓ] ↥(sys_prod q) := fun q =>
    { toFun := fun x => ⟨fun m => act_comp m q (x.1 m),
        hmem_sysProd.mpr fun m ι => by
          rw [hact_τ m q (x.1 (m + 1)) ι]
          have hx : (fun j => τ_comp j q (m + 1) (x.1 (m + 1) j)) = x.1 m :=
            funext (hmem_sysProd.mp x.2 m)
          rw [hx]⟩
      map_add' := fun x y => by apply Subtype.ext; funext m; exact map_add _ _ _
      map_smul' := fun z x => by
        apply Subtype.ext; funext m
        simp only [RingHom.id_apply]
        rw [hsmul_prod, hsmul_prod]
        exact map_nsmul (act_comp m q) _ (x.1 m) }

  
  have hFourTerm :
      Module.Finite (PadicInt ℓ) ↥(sys_prod 0) ∧
      Module.Finite (PadicInt ℓ) ↥(sys_prod 1) ∧
      LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_K 1))
          (LinearMap.baseChange (Padic ℓ) (Φ_K 1)) =
        (Nat.card { t : Fin M_bdry // π_bdry t = t } : Padic ℓ) -
          LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_prod 0))
            (LinearMap.baseChange (Padic ℓ) (Φ_prod 0)) +
          LinearMap.trace (Padic ℓ) (TensorProduct (PadicInt ℓ) (Padic ℓ) ↥(sys_prod 1))
            (LinearMap.baseChange (Padic ℓ) (Φ_prod 1)) := by
    let L_A := ↥(sys_prod 0)
    let L_B := ↥(sys_K 1)
    let L_C := ↥(sys_prod 1)
    let W_R := Fin M_bdry → PadicInt ℓ
    haveI : Module.Finite (PadicInt ℓ) L_B := hFinMod_K 1
    let Φ_bdry : W_R →ₗ[PadicInt ℓ] W_R :=
      { toFun := fun c t => c (π_bdry t)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hf₀_lift_ex : ∀ (x : L_A) (t : Fin M_bdry),
        ∃ z : PadicInt ℓ, ∀ m : ℕ, PadicInt.toZModPow (m + 1) z = f₀_m m (x.1 m) t := by
      intro x t
      let u : ∀ k : ℕ, ZMod (ℓ ^ k) := fun k =>
        match k with
        | 0 => 0
        | m + 1 => f₀_m m (x.1 m) t
      have hu : ∀ k : ℕ,
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (u (k + 1)) = u k := by
        intro k
        cases k with
        | zero =>
          have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
          exact Subsingleton.elim _ _
        | succ m =>
          change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
            (f₀_m (m + 1) (x.1 (m + 1)) t) = f₀_m m (x.1 m) t
          rw [(hExc m).2.2.2.2.2.2.2.2.1 (x.1 (m + 1)) t]
          have hx : (fun j => τ_comp j 0 (m + 1) (x.1 (m + 1) j)) = x.1 m :=
            funext (hmem_sysProd.mp x.2 m)
          rw [hx]
      obtain ⟨z, hz⟩ := hPadicLift u hu
      exact ⟨z, fun m => hz (m + 1)⟩
    let f₀_fn : L_A → W_R := fun x t => Classical.choose (hf₀_lift_ex x t)
    have hf₀_fn : ∀ (x : L_A) (t : Fin M_bdry) (m : ℕ),
        PadicInt.toZModPow (m + 1) (f₀_fn x t) = f₀_m m (x.1 m) t :=
      fun x t m => Classical.choose_spec (hf₀_lift_ex x t) m
    have hext_R_succ : ∀ {z₁ z₂ : PadicInt ℓ},
        (∀ m : ℕ, PadicInt.toZModPow (m + 1) z₁ = PadicInt.toZModPow (m + 1) z₂) → z₁ = z₂ := by
      intro z₁ z₂ h
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      cases k with
      | zero =>
        have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
        exact Subsingleton.elim _ _
      | succ m => exact h m
    let f₀_hat : L_A →ₗ[PadicInt ℓ] W_R :=
      { toFun := f₀_fn
        map_add' := fun x y => by
          funext t; apply hext_R_succ; intro m
          rw [Pi.add_apply, map_add, hf₀_fn, hf₀_fn, hf₀_fn]
          exact congrFun (map_add (f₀_m m) (x.1 m) (y.1 m)) t
        map_smul' := fun r x => by
          funext t; apply hext_R_succ; intro m
          change PadicInt.toZModPow (m + 1) (f₀_fn (r • x) t) =
            PadicInt.toZModPow (m + 1) (r * f₀_fn x t)
          rw [hf₀_fn, map_mul, hf₀_fn, hsmul_prod, map_nsmul, Pi.smul_apply, nsmul_eq_mul,
            ZMod.natCast_zmod_val] }
    have hf₀_inj : Function.Injective f₀_hat := by
      intro x₁ x₂ hx
      apply Subtype.ext; funext m
      apply (hExc m).1
      funext t
      rw [← hf₀_fn x₁ t m, ← hf₀_fn x₂ t m]
      exact congrArg (PadicInt.toZModPow (m + 1)) (congrFun hx t)
    have hf₀_inter : f₀_hat ∘ₗ Φ_prod 0 = Φ_bdry ∘ₗ f₀_hat := by
      apply LinearMap.ext; intro x; funext t; apply hext_R_succ; intro m
      simp only [LinearMap.comp_apply, Φ_bdry, LinearMap.coe_mk, AddHom.coe_mk]
      change PadicInt.toZModPow (m + 1) (f₀_fn (Φ_prod 0 x) t) =
        PadicInt.toZModPow (m + 1) (f₀_fn x (π_bdry t))
      rw [hf₀_fn, hf₀_fn]
      exact (hExc m).2.2.2.2.1 (x.1 m) t
    haveI : IsNoetherian (PadicInt ℓ) W_R :=
      isNoetherian_of_isNoetherianRing_of_finite (PadicInt ℓ) W_R
    haveI hFinMod_A : Module.Finite (PadicInt ℓ) L_A := by
      let e_range := LinearEquiv.ofInjective f₀_hat hf₀_inj
      exact Module.Finite.of_surjective e_range.symm.toLinearMap e_range.symm.surjective
    let δ_hat_exc : W_R →ₗ[PadicInt ℓ] L_B :=
      { toFun := fun c =>
          ⟨fun m => δ_m m (fun t => PadicInt.toZModPow (m + 1) (c t)),
            hmem_sysK.mpr fun m => by
              rw [(hExc m).2.2.2.2.2.2.2.2.2.1]
              congr 1; funext t
              exact RingHom.congr_fun
                (PadicInt.zmod_cast_comp_toZModPow (m + 1) (m + 2) (Nat.le_succ (m + 1))) (c t)⟩
        map_add' := fun c₁ c₂ => by
          apply Subtype.ext; funext m
          change δ_m m (fun t => PadicInt.toZModPow (m + 1) (c₁ t + c₂ t)) = _
          have hadd : (fun t => PadicInt.toZModPow (m + 1) (c₁ t + c₂ t)) =
              (fun t => PadicInt.toZModPow (m + 1) (c₁ t)) +
                (fun t => PadicInt.toZModPow (m + 1) (c₂ t)) := by funext t; exact map_add _ _ _
          rw [hadd, map_add]; rfl
        map_smul' := fun r c => by
          apply Subtype.ext; funext m
          simp only [RingHom.id_apply]
          rw [hsmul_K]
          change δ_m m (fun t => PadicInt.toZModPow (m + 1) (r * c t)) =
            (PadicInt.toZModPow (m + 1) r).val • δ_m m (fun t => PadicInt.toZModPow (m + 1) (c t))
          rw [← map_nsmul]
          congr 1; funext t
          rw [map_mul, Pi.smul_apply, nsmul_eq_mul, ZMod.natCast_zmod_val] }
    have hδ_inter : δ_hat_exc ∘ₗ Φ_bdry = Φ_K 1 ∘ₗ δ_hat_exc := by
      apply LinearMap.ext; intro c; apply Subtype.ext; funext m
      exact (hExc m).2.2.2.2.2.1 (fun t => PadicInt.toZModPow (m + 1) (c t))
    let g₁_hat : L_B →ₗ[PadicInt ℓ] L_C :=
      { toFun := fun y =>
          ⟨fun m => g₁_m m (y.1 m),
            hmem_sysProd.mpr fun m j =>
              ((hExc m).2.2.2.2.2.2.2.2.2.2.1 (y.1 (m + 1)) j).trans
                (congrFun (congrArg (g₁_m m) (hmem_sysK.mp y.2 m)) j)⟩
        map_add' := fun y₁ y₂ => by apply Subtype.ext; funext m; exact map_add _ _ _
        map_smul' := fun r y => by
          apply Subtype.ext; funext m
          simp only [RingHom.id_apply]
          rw [hsmul_prod, hsmul_K]
          exact map_nsmul (g₁_m m) _ (y.1 m) }
    have hg₁_inter : g₁_hat ∘ₗ Φ_K 1 = Φ_prod 1 ∘ₗ g₁_hat := by
      apply LinearMap.ext; intro y; apply Subtype.ext; funext m
      exact (hExc m).2.2.2.2.2.2.1 (y.1 m)
    have hexact_W : Function.Exact f₀_hat δ_hat_exc := by
      intro c
      constructor
      · intro hc
        have ha_ex : ∀ m : ℕ, ∃ a_m : ∀ ι, H_comp ι 0 (m + 1),
            f₀_m m a_m = fun t => PadicInt.toZModPow (m + 1) (c t) := by
          intro m
          have hm0 : δ_m m (fun t => PadicInt.toZModPow (m + 1) (c t)) = 0 :=
            congrArg (fun z : L_B => z.1 m) hc
          exact AddMonoidHom.mem_range.mp (((hExc m).2.1).symm ▸ hm0)
        let a_fn : ∀ m : ℕ, ∀ ι, H_comp ι 0 (m + 1) := fun m => Classical.choose (ha_ex m)
        have ha_fn : ∀ m : ℕ, f₀_m m (a_fn m) = fun t => PadicInt.toZModPow (m + 1) (c t) :=
          fun m => Classical.choose_spec (ha_ex m)
        have ha_mem : a_fn ∈ sys_prod 0 := by
          rw [hmem_sysProd]
          intro m
          have heq : (fun j => τ_comp j 0 (m + 1) (a_fn (m + 1) j)) = a_fn m := by
            apply (hExc m).1
            funext t
            rw [← (hExc m).2.2.2.2.2.2.2.2.1 (a_fn (m + 1)) t, ha_fn (m + 1), ha_fn m]
            exact RingHom.congr_fun
              (PadicInt.zmod_cast_comp_toZModPow (m + 1) (m + 2) (Nat.le_succ (m + 1))) (c t)
          exact congrFun heq
        refine ⟨⟨a_fn, ha_mem⟩, ?_⟩
        funext t; apply hext_R_succ; intro m
        change PadicInt.toZModPow (m + 1) (f₀_fn ⟨a_fn, ha_mem⟩ t) =
          PadicInt.toZModPow (m + 1) (c t)
        rw [hf₀_fn]
        exact congrFun (ha_fn m) t
      · rintro ⟨x, rfl⟩
        apply Subtype.ext; funext m
        change δ_m m (fun t => PadicInt.toZModPow (m + 1) (f₀_fn x t)) = 0
        have hfun : (fun t => PadicInt.toZModPow (m + 1) (f₀_fn x t)) = f₀_m m (x.1 m) :=
          funext fun t => hf₀_fn x t m
        rw [hfun]
        exact AddMonoidHom.mem_ker.mp ((hExc m).2.1 ▸ ⟨x.1 m, rfl⟩)
    have hexact_B : Function.Exact δ_hat_exc g₁_hat := by
      intro y
      constructor
      · intro hy
        let F_fib : ℕ → Type := fun m =>
          { u : Fin M_bdry → ZMod (ℓ ^ (m + 1)) // δ_m m u = y.1 m }
        let F_fib_u : ℕ → Type u := fun m => ULift.{u, 0} (F_fib m)
        haveI : ∀ m : ℕ, Finite (F_fib_u m) := fun m => by
          haveI := hNeZeroPow (m + 1)
          haveI : Finite (F_fib m) := Subtype.finite
          exact Finite.of_equiv (F_fib m) Equiv.ulift.symm
        haveI : ∀ m : ℕ, Nonempty (F_fib_u m) := fun m => by
          have hm0 : y.1 m ∈ (g₁_m m).ker :=
            AddMonoidHom.mem_ker.mpr (congrArg (fun z : L_C => z.1 m) hy)
          rw [← (hExc m).2.2.1] at hm0
          obtain ⟨u, hu⟩ := AddMonoidHom.mem_range.mp hm0
          exact ⟨ULift.up ⟨u, hu⟩⟩
