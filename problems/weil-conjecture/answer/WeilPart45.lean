    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  let τ_K_sh_le : ∀ (a b : ℕ), a ≤ b → Quiver.Hom (𝒦_s b) (𝒦_s a) :=
    fun a => Nat.rec
      (fun h => CategoryTheory.eqToHom (congrArg 𝒦_s (Nat.eq_zero_of_le_zero h).symm))
      (fun b ih h =>
        if hab : a = b + 1 then
          CategoryTheory.eqToHom (congrArg 𝒦_s hab.symm)
        else
          CategoryTheory.CategoryStruct.comp (τ_𝒦s b) (ih (by omega)))
  have hsh_refl : ∀ (a : ℕ) (h : a ≤ a), τ_K_sh_le a a h = CategoryTheory.CategoryStruct.id (𝒦_s a) := by
    intro a h
    cases a with
    | zero => simp [τ_K_sh_le]
    | succ a => simp [τ_K_sh_le]
  have hsh_step : ∀ (a b : ℕ) (h : a ≤ b) (h' : a ≤ b + 1),
