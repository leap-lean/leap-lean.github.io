          (eH₂ : (↑(C₂.obj ℱ) ⧸ AddMonoidHom.range (d₁.app ℱ).hom) ≃+ ℱ.H 2),
          ∀ (β : Quiver.Hom (P_S.obj ℱ) ℱ),
            let act (i : ℕ) (x : ℱ.H i) : ℱ.H i :=
              (CategoryTheory.Abelian.Ext.mk₀ β).postcomp Fℤ (Nat.add_zero i)
