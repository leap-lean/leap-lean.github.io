          q₂ (MV₂ u) = QuotientAddGroup.mk' dK₁.range (ρK₂ σ (ΦK₂ z))) ∧
        (∀ u, q₂ u = 0 → (ℓ ^ B₂ : ℕ) • u = 0) ∧
        (∀ y : K₂ ⧸ dK₁.range, ∃ u, q₂ u = (ℓ ^ B₂ : ℕ) • y)))
    (hTorJ : (∀ x : J₀, (ℓ ^ K : ℕ) • x = 0) ∧
      (∀ x : J₁, (ℓ ^ K : ℕ) • x = 0) ∧
      (∀ x : J₂, (ℓ ^ K : ℕ) • x = 0))
    (hPerJ : ∀ a : ℕ, a ≤ K →
      (∀ x : J₀, (ℓ ^ a : ℕ) • x = 0 → ∃ y : J₀, x = (ℓ ^ (K - a) : ℕ) • y) ∧
      (∀ x : J₁, (ℓ ^ a : ℕ) • x = 0 → ∃ y : J₁, x = (ℓ ^ (K - a) : ℕ) • y) ∧
      (∀ x : J₂, (ℓ ^ a : ℕ) • x = 0 → ∃ y : J₂, x = (ℓ ^ (K - a) : ℕ) • y))
    (hdJ : dJ₁.comp dJ₀ = 0 ∧
