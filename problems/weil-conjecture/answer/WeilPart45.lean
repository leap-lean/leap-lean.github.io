        let U : D_bar.Etale := AlgebraicGeometry.Scheme.Etale.mk (u_sch ≫ h_W)
        let u : U ⟶ W := CategoryTheory.MorphismProperty.Over.homMk u_sch rfl trivial
        have hg_top : g_top ≫ ι_bar_J m_top = (Fgt.obj U).hom :=
          CategoryTheory.Limits.pullback.condition.symm
        let g_Ua : U_sch ⟶ V_bar a := g_top ≫ p_le a m_top (hle_add a b)
        have hg_Ua : g_Ua ≫ ι_bar_J a = (Fgt.obj U).hom := by
          rw [CategoryTheory.Category.assoc, hp_le_ι, hg_top]
        obtain ⟨δ₁_top, hδ₁_top_fst, hδ₁_top_snd, _, hDiagInj_top⟩ :=
          hDiagPkg m_top U g_top hg_top
        obtain ⟨δ₁_a, hδ₁_a_fst, hδ₁_a_snd, hDiagLift_a, _⟩ :=
          hDiagPkg a U g_Ua hg_Ua
        have hδ₁_comm : δ₁_top ≫ m_le (Fgt.obj U).hom a m_top (hle_add a b) = δ₁_a := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hδ₁_top_fst, hδ₁_a_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, hδ₁_top_snd, hδ₁_a_snd]
            rfl
        let s₂_U := ((𝒥_bar m_top).obj.map (Opposite.op u)) s₂
        have hs₂_U_ker : ((τ_J_sh_le b m_top h_b_le).hom.app (Opposite.op U)) s₂_U = 0 := by
          have hnat := congrArg (fun f => f s₂)
            (congrArg AddCommGrpCat.Hom.hom
              ((τ_J_sh_le b m_top h_b_le).hom.naturality (Opposite.op u)))
          change ((τ_J_sh_le b m_top h_b_le).hom.app (Opposite.op U))
              (((𝒥_bar m_top).obj.map (Opposite.op u)) s₂) =
            ((𝒥_bar b).obj.map (Opposite.op u))
              (((τ_J_sh_le b m_top h_b_le).hom.app (Opposite.op W)) s₂) at hnat
          rw [hnat, hs₂, map_zero]
          rfl
        let h_dvd_b := pow_dvd_pow ℓ (Nat.add_le_add_right h_b_le 1)
        let unemb : ZMod (ℓ ^ (m_top + 1)) → ZMod (ℓ ^ (a + 1)) := fun z =>
          if hz : ZMod.castHom h_dvd_b (ZMod (ℓ ^ (b + 1))) z = 0 then
            Classical.choose ((hemb_ker a b h_dvd_b z).mp hz)
          else 0
        let h₀_a : LocallyConstant ↥U_sch (Fin N → ZMod (ℓ ^ (a + 1))) :=
          ((triv_J m_top U s₂_U).comap δ₁_top.base.hom).map (fun v i => unemb (v i))
        have hh₀_a_spec : ∀ (q : ↥U_sch) (i : Fin N),
            emb a b (h₀_a q i) = triv_J m_top U s₂_U (δ₁_top.base q) i := by
          intro q i
          have hz0 : ZMod.castHom h_dvd_b (ZMod (ℓ ^ (b + 1)))
              (triv_J m_top U s₂_U (δ₁_top.base q) i) = 0 := by
            rw [← hτ_le_spec b m_top h_b_le U s₂_U (δ₁_top.base q) i, hs₂_U_ker, map_zero]
            rfl
          change emb a b (unemb (triv_J m_top U s₂_U (δ₁_top.base q) i)) = _
          dsimp only [unemb]
          split_ifs with hz
          · exact Classical.choose_spec ((hemb_ker a b h_dvd_b _).mp hz)
          · exact False.elim (hz hz0)
        obtain ⟨s₁, hs₁⟩ := hDiagLift_a h₀_a
        refine ⟨U, u, y, s₁, (inferInstance : AlgebraicGeometry.Etale u_sch), hy, ?_⟩
        apply hDiagInj_top
        intro q
        ext i
        rw [hι_sh_spec a b U s₁ (δ₁_top.base q) i]
        have hbase : (m_le (Fgt.obj U).hom a m_top (hle_add a b)).base (δ₁_top.base q) =
            δ₁_a.base q :=
          congrArg (fun k => k.base q) hδ₁_comm
        rw [hbase, hs₁ q]
        exact hh₀_a_spec q i
      · 
        have : AlgebraicGeometry.Etale h_W := W.prop
        have : AlgebraicGeometry.Etale (W₀.ι ≫ h_W) := inferInstance
        let U : D_bar.Etale := AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_W)
        let u : U ⟶ W := CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial
        refine ⟨U, u, ⟨x, hx_W₀⟩, 0, (inferInstance : AlgebraicGeometry.Etale W₀.ι), rfl, ?_⟩
        rw [map_zero]
        apply ((htriv_spec m_top).2 U).1
        ext y₁ i
        let u_V : CategoryTheory.Limits.pullback (Fgt.obj U).hom (ι_bar_J m_top) ⟶
            CategoryTheory.Limits.pullback h_W (ι_bar_J m_top) :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J m_top) ≫ W₀.ι)
            (CategoryTheory.Limits.pullback.snd (Fgt.obj U).hom (ι_bar_J m_top))
            ((CategoryTheory.Category.assoc _ W₀.ι h_W).trans
              CategoryTheory.Limits.pullback.condition)
        rw [map_zero, LocallyConstant.coe_zero, Pi.zero_apply, Pi.zero_apply,
          (htriv_spec m_top).1 u u_V (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₂ y₁]
        have hy₁_W₀ : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m_top)).base
            (u_V.base y₁) ∈ W₀ := by
          have hu_fst : u_V ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m_top) =
              CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J m_top) ≫ W₀.ι :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have h1 : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m_top)).base (u_V.base y₁) =
              W₀.ι.base ((CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J m_top)).base y₁) :=
            congrArg (fun k => k.base y₁) hu_fst
          rw [h1]
          exact ((CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J m_top)).base y₁).2
        rw [hW₀_zero _ hy₁_W₀, Pi.zero_apply]
    · 
      intro W s₃ x
      let h_W := (Fgt.obj W).hom
      have hf₃_mem : triv_J b W s₃ ∈ Set.range (triv_J b W) := ⟨s₃, rfl⟩
      rw [((htriv_spec b).2 W).2] at hf₃_mem
      obtain ⟨⟨W₀, hW₀_top, hW₀_zero⟩, _⟩ := hf₃_mem
      have hx_cov : x ∈ ((TopologicalSpace.Opens.map h_W.base).obj U_bar) ⊔ W₀ := by
        rw [hW₀_top]
        trivial
      rcases hx_cov with hx_U | hx_W₀
      · 
        obtain ⟨y, hy⟩ := hLiftPt m_top (Fgt.obj W).left h_W x hx_U
        let U_sch := CategoryTheory.Limits.pullback h_W (ι_bar_J m_top)
        let u_sch : U_sch ⟶ (Fgt.obj W).left :=
          CategoryTheory.Limits.pullback.fst h_W (ι_bar_J m_top)
        let g_top : U_sch ⟶ V_bar m_top :=
          CategoryTheory.Limits.pullback.snd h_W (ι_bar_J m_top)
        have : AlgebraicGeometry.Etale h_W := W.prop
        have : AlgebraicGeometry.Etale u_sch := inferInstance
        have : AlgebraicGeometry.Etale (u_sch ≫ h_W) := inferInstance
        let U : D_bar.Etale := AlgebraicGeometry.Scheme.Etale.mk (u_sch ≫ h_W)
        let u : U ⟶ W := CategoryTheory.MorphismProperty.Over.homMk u_sch rfl trivial
        have hg_top : g_top ≫ ι_bar_J m_top = (Fgt.obj U).hom :=
          CategoryTheory.Limits.pullback.condition.symm
        let g_Ub : U_sch ⟶ V_bar b := g_top ≫ p_le b m_top h_b_le
        have hg_Ub : g_Ub ≫ ι_bar_J b = (Fgt.obj U).hom := by
          rw [CategoryTheory.Category.assoc, hp_le_ι, hg_top]
        obtain ⟨δ₁_top, hδ₁_top_fst, hδ₁_top_snd, hDiagLift_top, _⟩ :=
          hDiagPkg m_top U g_top hg_top
        obtain ⟨δ₁_b, hδ₁_b_fst, hδ₁_b_snd, _, hDiagInj_b⟩ :=
          hDiagPkg b U g_Ub hg_Ub
        have hδ₁_comm : δ₁_top ≫ m_le (Fgt.obj U).hom b m_top h_b_le = δ₁_b := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hδ₁_top_fst, hδ₁_b_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, hδ₁_top_snd, hδ₁_b_snd]
            rfl
        let s₃_U := ((𝒥_bar b).obj.map (Opposite.op u)) s₃
        let h₀_top : LocallyConstant ↥U_sch (Fin N → ZMod (ℓ ^ (m_top + 1))) :=
          ((triv_J b U s₃_U).comap δ₁_b.base.hom).map
            (fun v i => ((v i).val : ZMod (ℓ ^ (m_top + 1))))
        obtain ⟨s₂, hs₂⟩ := hDiagLift_top h₀_top
        refine ⟨U, u, y, s₂, (inferInstance : AlgebraicGeometry.Etale u_sch), hy, ?_⟩
        apply hDiagInj_b
        intro q
        ext i
        have hbase : δ₁_b.base q = (m_le (Fgt.obj U).hom b m_top h_b_le).base (δ₁_top.base q) :=
          congrArg (fun k => k.base q) hδ₁_comm.symm
        conv_lhs => rw [hbase]
        rw [hτ_le_spec b m_top h_b_le U s₂ (δ₁_top.base q) i, hs₂ q]
        change ZMod.castHom _ (ZMod (ℓ ^ (b + 1)))
            (((triv_J b U s₃_U (δ₁_b.base q) i).val : ℕ) : ZMod (ℓ ^ (m_top + 1))) =
          triv_J b U s₃_U (δ₁_b.base q) i
        rw [map_natCast, ZMod.natCast_zmod_val]
      · 
        have : AlgebraicGeometry.Etale h_W := W.prop
        have : AlgebraicGeometry.Etale (W₀.ι ≫ h_W) := inferInstance
        let U : D_bar.Etale := AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_W)
        let u : U ⟶ W := CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial
        refine ⟨U, u, ⟨x, hx_W₀⟩, 0, (inferInstance : AlgebraicGeometry.Etale W₀.ι), rfl, ?_⟩
        rw [map_zero]
        symm
        apply ((htriv_spec b).2 U).1
        ext y₁ i
        let u_V : CategoryTheory.Limits.pullback (Fgt.obj U).hom (ι_bar_J b) ⟶
            CategoryTheory.Limits.pullback h_W (ι_bar_J b) :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J b) ≫ W₀.ι)
            (CategoryTheory.Limits.pullback.snd (Fgt.obj U).hom (ι_bar_J b))
            ((CategoryTheory.Category.assoc _ W₀.ι h_W).trans
              CategoryTheory.Limits.pullback.condition)
        rw [map_zero, LocallyConstant.coe_zero, Pi.zero_apply, Pi.zero_apply,
          (htriv_spec b).1 u u_V (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₃ y₁]
        have hy₁_W₀ : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J b)).base
            (u_V.base y₁) ∈ W₀ := by
          have hu_fst : u_V ≫ CategoryTheory.Limits.pullback.fst h_W (ι_bar_J b) =
              CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J b) ≫ W₀.ι :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have h1 : (CategoryTheory.Limits.pullback.fst h_W (ι_bar_J b)).base (u_V.base y₁) =
              W₀.ι.base ((CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J b)).base y₁) :=
            congrArg (fun k => k.base y₁) hu_fst
          rw [h1]
          exact ((CategoryTheory.Limits.pullback.fst (Fgt.obj U).hom (ι_bar_J b)).base y₁).2
        rw [hW₀_zero _ hy₁_W₀, Pi.zero_apply]

  
  
  
  refine ⟨𝒥_bar, ι_bar_J, triv_J, τ_𝒥bar, τ_J_sh_le, ι_sh,
    ?_, ?_, hTor_sh, hsh_refl, hsh_step, fun a b => ⟨h0_sh a b, hSE_sh a b⟩, hComp_sh, hComm_sh⟩
  · 
    intro m
    refine ⟨hι_fst m, hι_snd m, hPb_Vm m, fun σ => ⟨hd_ι m σ, hd_fst m σ⟩,
      @(htriv_spec m).1, (htriv_spec m).2⟩
  · 
    intro m W
    let h_W := (Fgt.obj W).hom
    refine ⟨fun y => ?_, fun s_up m_ι_bar hm_fst hm_snd y_up i => ?_⟩
    · obtain ⟨y_up, hy_up⟩ := (hSurj_m_can m h_W).1 y
      exact ⟨m_can m h_W, y_up, hm_can_fst m h_W, hm_can_snd_fst m h_W, hy_up⟩
    · have hm_eq : m_ι_bar = m_can m h_W := hm_can_uniq m h_W m_ι_bar hm_fst hm_snd
      rw [hm_eq]
      exact hτ_bar_spec m W s_up y_up i

