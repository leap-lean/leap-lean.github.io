                    ((congrArg (snd_D ≫ ·) hi₂_comp).trans
                      ((CategoryTheory.Category.comp_id snd_D).trans
                        (CategoryTheory.Category.id_comp snd_D).symm))))))
      inv_hom_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc _ _ pr_D).trans
            ((congrArg (g_D_inv ≫ ·) hgD_fst).trans
              (hgDinv_fst.trans (CategoryTheory.Category.id_comp pr_D).symm))
        · exact (CategoryTheory.Category.assoc _ _ snd_D).trans
            ((congrArg (g_D_inv ≫ ·) hgD_snd).trans
              ((CategoryTheory.Category.assoc _ snd_D i₂).symm.trans
                ((congrArg (· ≫ i₂) hgDinv_snd).trans
                  ((CategoryTheory.Category.assoc snd_D i₂_inv i₂).trans
                    ((congrArg (snd_D ≫ ·) hi₂_inv_comp).trans
                      ((CategoryTheory.Category.comp_id snd_D).trans
                        (CategoryTheory.Category.id_comp snd_D).symm)))))) }
  let powIso : ℕ → CategoryTheory.Iso D_bar D_bar := fun n =>
    Nat.rec (CategoryTheory.Iso.refl D_bar) (fun _ ih_iso => g_D1_iso ≪≫ ih_iso) n
  have hpowIso_hom : ∀ n : ℕ, (powIso n).hom = weilSchemeEndPow (weilGeomFrobHom F D_ov) n := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih =>
      change g_D1_iso.hom ≫ (powIso n).hom =
        weilGeomFrobHom F D_ov ≫ weilSchemeEndPow (weilGeomFrobHom F D_ov) n
      rw [ih]
  let g_Dr_iso : CategoryTheory.Iso D_bar D_bar := powIso r
  have hg_Dr_eq : g_Dr_iso.hom = g_D_r := hpowIso_hom r

  let V₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B₀)
  let fst_V : V_bar ⟶ V₀ := CategoryTheory.Limits.pullback.fst V_ov.hom f₂
  let snd_V : V_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    CategoryTheory.Limits.pullback.snd V_ov.hom f₂
  let f_RB : V₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀))
  let π₀ : V₀ ⟶ U₀.toScheme := f_RB ≫ e_U.hom
  let ι₀ : V₀ ⟶ D_ov.left := π₀ ≫ U₀.ι

  have hm_τ_ι₀ : ∀ τ : B₀ ≃ₐ[R₀] B₀,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ≫ ι₀ = ι₀ := by
    intro τ
    have hcomm_τ : CommRingCat.ofHom (algebraMap R₀ B₀) ≫ CommRingCat.ofHom τ.symm.toRingHom =
        CommRingCat.ofHom (algebraMap R₀ B₀) := by
      ext r_el
      change τ.symm (algebraMap R₀ B₀ r_el) = algebraMap R₀ B₀ r_el
      exact τ.symm.commutes r_el
    have h_fRB : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ≫ f_RB = f_RB :=
      (AlgebraicGeometry.Spec.map_comp
        (CommRingCat.ofHom (algebraMap R₀ B₀))
        (CommRingCat.ofHom τ.symm.toRingHom)).symm.trans
        (congrArg AlgebraicGeometry.Spec.map hcomm_τ)
    exact (CategoryTheory.Category.assoc _ π₀ U₀.ι).symm.trans
      (congrArg (· ≫ U₀.ι)
        ((CategoryTheory.Category.assoc _ f_RB e_U.hom).symm.trans
          (congrArg (· ≫ e_U.hom) h_fRB)))

  have h_deck_all : ∀ τ : B₀ ≃ₐ[R₀] B₀,
      weilCurveTrGeomDeckHom F R₀ B₀ τ ≫ ι_bar = ι_bar := by
    intro τ
    have hfst_deck : weilCurveTrGeomDeckHom F R₀ B₀ τ ≫ fst_V =
        fst_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hsnd_deck : weilCurveTrGeomDeckHom F R₀ B₀ τ ≫ snd_V = snd_V :=
      (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id snd_V)
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc _ ι_bar pr_D).trans
        ((congrArg (weilCurveTrGeomDeckHom F R₀ B₀ τ ≫ ·) hι_fst).trans
          ((CategoryTheory.Category.assoc _ fst_V ι₀).symm.trans
            ((congrArg (· ≫ ι₀) hfst_deck).trans
              ((CategoryTheory.Category.assoc fst_V _ ι₀).trans
                ((congrArg (fst_V ≫ ·) (hm_τ_ι₀ τ)).trans hι_fst.symm)))))
    · exact (CategoryTheory.Category.assoc _ ι_bar snd_D).trans
        ((congrArg (weilCurveTrGeomDeckHom F R₀ B₀ τ ≫ ·) hι_snd).trans
          (hsnd_deck.trans hι_snd.symm))

  have hfrob_step : weilGeomFrobHom F V_ov ≫ ι_bar = ι_bar ≫ weilGeomFrobHom F D_ov := by
    have hgV_fst : weilGeomFrobHom F V_ov ≫ fst_V = fst_V :=
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id fst_V)
    have hgV_snd : weilGeomFrobHom F V_ov ≫ snd_V = snd_V ≫ i₂ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc _ ι_bar pr_D).trans
        ((congrArg (weilGeomFrobHom F V_ov ≫ ·) hι_fst).trans
          ((CategoryTheory.Category.assoc _ fst_V ι₀).symm.trans
            ((congrArg (· ≫ ι₀) hgV_fst).trans
              (hι_fst.symm.trans
                ((congrArg (ι_bar ≫ ·) hgD_fst.symm).trans
                  (CategoryTheory.Category.assoc ι_bar _ pr_D).symm)))))
    · exact (CategoryTheory.Category.assoc _ ι_bar snd_D).trans
        ((congrArg (weilGeomFrobHom F V_ov ≫ ·) hι_snd).trans
          (hgV_snd.trans
            ((congrArg (· ≫ i₂) hι_snd.symm).trans
              ((CategoryTheory.Category.assoc ι_bar snd_D i₂).trans
                ((congrArg (ι_bar ≫ ·) hgD_snd.symm).trans
                  (CategoryTheory.Category.assoc ι_bar _ snd_D).symm)))))

  have hfrob_pow : ∀ n : ℕ,
      weilSchemeEndPow (weilGeomFrobHom F V_ov) n ≫ ι_bar =
        ι_bar ≫ weilSchemeEndPow (weilGeomFrobHom F D_ov) n := by
    intro n
    induction n with
    | zero =>
      change 𝟙 V_bar ≫ ι_bar = ι_bar ≫ 𝟙 D_bar
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    | succ n ih =>
      change (weilGeomFrobHom F V_ov ≫ weilSchemeEndPow (weilGeomFrobHom F V_ov) n) ≫ ι_bar =
        ι_bar ≫ (weilGeomFrobHom F D_ov ≫ weilSchemeEndPow (weilGeomFrobHom F D_ov) n)
      rw [CategoryTheory.Category.assoc, ih, ← CategoryTheory.Category.assoc, hfrob_step,
        CategoryTheory.Category.assoc]

  have hα_ι : α_σ ≫ ι_bar = ι_bar ≫ g_D_r := by
    dsimp [α_σ, g_D_r]
    change (weilSchemeEndPow (weilGeomFrobHom F V_ov) r ≫ weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹) ≫
      ι_bar = _
    rw [CategoryTheory.Category.assoc, h_deck_all σ⁻¹, hfrob_pow r]

  
  
  
  have h_range_ι : Set.range ι_bar.base ⊆ Set.range U_bar.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    change pr_D.base (ι_bar.base y) ∈ (U₀ : Set ↥D_ov.left)
    have hy : (ι_bar ≫ pr_D).base y = (fst_V ≫ ι₀).base y := by
      rw [hι_fst]
      rfl
    change (ι_bar ≫ pr_D).base y ∈ (U₀ : Set ↥D_ov.left)
    rw [hy, ← AlgebraicGeometry.Scheme.Opens.range_ι U₀]
    exact ⟨π₀.base (fst_V.base y), rfl⟩

  let π_bar : V_bar ⟶ U_bar.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_bar.ι ι_bar h_range_ι
  have hπ_ι : π_bar ≫ U_bar.ι = ι_bar :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_bar.ι ι_bar h_range_ι

  let pr_U : U_bar.toScheme ⟶ U₀.toScheme := pr_D ∣_ U₀
  have hpb_mid : CategoryTheory.IsPullback pr_U U_bar.ι U₀.ι pr_D :=
    AlgebraicGeometry.isPullback_morphismRestrict pr_D U₀
  have hpb_bot : CategoryTheory.IsPullback pr_D snd_D D_ov.hom f₂ :=
    CategoryTheory.IsPullback.of_hasPullback D_ov.hom f₂
  have hpb_mb : CategoryTheory.IsPullback pr_U (U_bar.ι ≫ snd_D) (U₀.ι ≫ D_ov.hom) f₂ :=
    hpb_mid.paste_vert hpb_bot

  have hV_hom_eq : π₀ ≫ (U₀.ι ≫ D_ov.hom) = V_ov.hom := by
    have h1 : π₀ ≫ (U₀.ι ≫ D_ov.hom) =
        f_RB ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      calc
        π₀ ≫ (U₀.ι ≫ D_ov.hom) = f_RB ≫ (e_U.hom ≫ U₀.ι) ≫ D_ov.hom := by
          dsimp [π₀]
          simp only [CategoryTheory.Category.assoc]
        _ = f_RB ≫ (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)) ≫ j_aff) ≫ D_ov.hom := by
          rw [heU]
        _ = f_RB ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)) ≫ (j_aff ≫ D_ov.hom) := by
          simp only [CategoryTheory.Category.assoc]
        _ = f_RB ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
          rw [hj_hom]
    have h2 : f_RB ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = V_ov.hom := by
      dsimp [f_RB, V_ov, weilCurveTrGeomCoverOver]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro c
      simp only [RingHom.comp_apply]
      have hC : Polynomial.C c = algebraMap F (Polynomial F) c := rfl
      rw [hC, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) B₀]
    exact h1.trans h2

  have hsnd_V_eq : π_bar ≫ (U_bar.ι ≫ snd_D) = snd_V := by
    rw [← CategoryTheory.Category.assoc, hπ_ι]
    exact hι_snd

  have hpb_outer : CategoryTheory.IsPullback fst_V (π_bar ≫ (U_bar.ι ≫ snd_D))
      (π₀ ≫ (U₀.ι ≫ D_ov.hom)) f₂ := by
    rw [hsnd_V_eq, hV_hom_eq]
    exact CategoryTheory.IsPullback.of_hasPullback V_ov.hom f₂

  have htop_comm : fst_V ≫ π₀ = π_bar ≫ pr_U := by
    apply (CategoryTheory.cancel_mono U₀.ι).mp
    calc
      (fst_V ≫ π₀) ≫ U₀.ι = fst_V ≫ (π₀ ≫ U₀.ι) :=
        CategoryTheory.Category.assoc fst_V π₀ U₀.ι
      _ = ι_bar ≫ pr_D := hι_fst.symm
      _ = (π_bar ≫ U_bar.ι) ≫ pr_D := by rw [hπ_ι]
      _ = π_bar ≫ (U_bar.ι ≫ pr_D) := CategoryTheory.Category.assoc π_bar U_bar.ι pr_D
      _ = π_bar ≫ (pr_U ≫ U₀.ι) := by
        dsimp [pr_U]
        rw [AlgebraicGeometry.morphismRestrict_ι pr_D U₀]
      _ = (π_bar ≫ pr_U) ≫ U₀.ι := (CategoryTheory.Category.assoc π_bar pr_U U₀.ι).symm

  have hpb_top : CategoryTheory.IsPullback fst_V π_bar π₀ pr_U :=
    CategoryTheory.IsPullback.of_bot hpb_outer htop_comm hpb_mb

  have hEt_fRB : AlgebraicGeometry.Etale f_RB :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  have hEt_π₀ : P_Et π₀ := by
    dsimp [P_Et, π₀]
    haveI : AlgebraicGeometry.Etale f_RB := hEt_fRB
    infer_instance

  have hSurj_fRB : AlgebraicGeometry.Surjective f_RB := by
    rw [AlgebraicGeometry.surjective_iff]
    intro p_spec
    haveI : Algebra.IsIntegral R₀ B₀ := Algebra.IsIntegral.of_finite R₀ B₀
    haveI : p_spec.asIdeal.IsPrime := p_spec.isPrime
    have hker_le : RingHom.ker (algebraMap R₀ B₀) ≤ p_spec.asIdeal := by
      intro r_el hr_el
      rw [RingHom.mem_ker, ← map_zero (algebraMap R₀ B₀)] at hr_el
      rw [hInj_RB hr_el]
      exact p_spec.asIdeal.zero_mem
    obtain ⟨Q, hQ_prime, hQ_over⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain p_spec.asIdeal hker_le
    exact ⟨⟨Q, hQ_prime⟩, PrimeSpectrum.ext hQ_over⟩
  have hSurj_π₀ : P_Surj π₀ := by
    dsimp [P_Surj, π₀]
    haveI : AlgebraicGeometry.Surjective f_RB := hSurj_fRB
    infer_instance

  have hπ_et : AlgebraicGeometry.Etale π_bar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_top hEt_π₀
  have hπ_surj : AlgebraicGeometry.Surjective π_bar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_top hSurj_π₀

  
  let T_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A_tp)
  let p₁ : T_sch ⟶ V₀ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
  let p₂ : T_sch ⟶ V₀ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight (R := R₀) (A := B₀) (B := B₀)).toRingHom)
  have hcomm_p₁p₂_fRB : p₁ ≫ f_RB = p₂ ≫ f_RB := by
    dsimp [p₁, p₂, f_RB]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply RingHom.ext
    intro r_el
    change algebraMap R₀ B₀ r_el ⊗ₜ[R₀] (1 : B₀) = (1 : B₀) ⊗ₜ[R₀] algebraMap R₀ B₀ r_el
    calc
      algebraMap R₀ B₀ r_el ⊗ₜ[R₀] (1 : B₀) = (r_el • (1 : B₀)) ⊗ₜ[R₀] (1 : B₀) := by
        rw [Algebra.smul_def, mul_one]
      _ = (1 : B₀) ⊗ₜ[R₀] (r_el • (1 : B₀)) := (TensorProduct.tmul_smul r_el _ _).symm
      _ = (1 : B₀) ⊗ₜ[R₀] algebraMap R₀ B₀ r_el := by rw [Algebra.smul_def, mul_one]
  have hpb_T_fRB : CategoryTheory.IsPullback p₁ p₂ f_RB f_RB :=
    CategoryTheory.IsPullback.of_iso_pullback ⟨hcomm_p₁p₂_fRB⟩
      (AlgebraicGeometry.pullbackSpecIso R₀ B₀ B₀).symm
      (AlgebraicGeometry.pullbackSpecIso_inv_fst R₀ B₀ B₀)
      (AlgebraicGeometry.pullbackSpecIso_inv_snd R₀ B₀ B₀)
  have hpb_eU : CategoryTheory.IsPullback f_RB (𝟙 V₀) e_U.hom π₀ :=
    CategoryTheory.IsPullback.of_vert_isIso
      ⟨(CategoryTheory.Category.id_comp π₀).symm⟩
  have hpb_T : CategoryTheory.IsPullback p₁ p₂ π₀ π₀ := by
    have hp := hpb_T_fRB.paste_vert hpb_eU
    rwa [CategoryTheory.Category.comp_id] at hp

  have hΔ_p₁_aut : ∀ τ : B₀ ≃ₐ[R₀] B₀,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ τ).toRingHom) ≫ p₁ = 𝟙 V₀ := by
    intro τ
    dsimp [p₁, V₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_id (CommRingCat.of B₀), ← CommRingCat.ofHom_id]
    congr 2
    apply RingHom.ext
    intro b
    change μ τ (b ⊗ₜ[R₀] (1 : B₀)) = b
    dsimp [μ]
    rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one]
  have hΔ_p₂_aut : ∀ τ : B₀ ≃ₐ[R₀] B₀,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ τ).toRingHom) ≫ p₂ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) := by
    intro τ
    dsimp [p₂]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply RingHom.ext
    intro b
    change μ τ ((1 : B₀) ⊗ₜ[R₀] b) = τ.symm b
    dsimp [μ]
    rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, one_mul]
    rfl
  let Δ_mod : Fin m_sheet → (V₀ ⟶ T_sch) := fun i =>
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ (equiv_Γ i)).toRingHom)
  have hΔ_p₁ : ∀ i : Fin m_sheet, Δ_mod i ≫ p₁ = 𝟙 V₀ :=
    fun i => hΔ_p₁_aut (equiv_Γ i)
  have hΔ_p₂ : ∀ i : Fin m_sheet,
      Δ_mod i ≫ p₂ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (equiv_Γ i).symm.toRingHom) :=
    fun i => hΔ_p₂_aut (equiv_Γ i)
  have hΔ_et : ∀ i : Fin m_sheet, P_Et (Δ_mod i) := fun i =>
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (hKer_idemp (equiv_Γ i)).1
  have hΔ_range : ∀ i : Fin m_sheet,
      Set.range (Δ_mod i).base = (PrimeSpectrum.basicOpen (e_id i)).1 := by
    intro i
    ext P
    constructor
    · rintro ⟨q, rfl⟩
      refine (PrimeSpectrum.mem_basicOpen (e_id i) _).mpr ?_
      intro hmem
      have h1 : μ (equiv_Γ i) (e_id i) ∈ q.asIdeal := hmem
      rw [he_eval i i] at h1
      simp only [↓reduceIte] at h1
      exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    · intro hP
      have hnot : e_id i ∉ P.asIdeal := (PrimeSpectrum.mem_basicOpen (e_id i) P).mp hP
      let q : PrimeSpectrum B₀ :=
        PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom P
      refine ⟨q, PrimeSpectrum.ext ?_⟩
      ext z
      have habs := he_absorb i z
      change μ (equiv_Γ i) z ∈ q.asIdeal ↔ z ∈ P.asIdeal
      change Algebra.TensorProduct.includeLeftRingHom (μ (equiv_Γ i) z) ∈ P.asIdeal ↔
        z ∈ P.asIdeal
      constructor
      · intro hq_mem
        have hmul : TensorProduct.tmul R₀ (μ (equiv_Γ i) z) 1 * e_id i ∈ P.asIdeal :=
          Ideal.mul_mem_right (e_id i) P.asIdeal hq_mem
        rw [← habs] at hmul
        exact (P.isPrime.mem_or_mem hmul).resolve_right hnot
      · intro hz_mem
        have hmul : z * e_id i ∈ P.asIdeal := Ideal.mul_mem_right (e_id i) P.asIdeal hz_mem
        rw [habs] at hmul
        exact (P.isPrime.mem_or_mem hmul).resolve_right hnot

  have hD_disj : ∀ i j : Fin m_sheet, i ≠ j →
      Disjoint ((PrimeSpectrum.basicOpen (e_id i)).1 : Set ↥T_sch)
        ((PrimeSpectrum.basicOpen (e_id j)).1 : Set ↥T_sch) := by
    intro i j hij
    rw [Set.disjoint_left]
    intro P hPi hPj
    have hni : e_id i ∉ P.asIdeal := (PrimeSpectrum.mem_basicOpen (e_id i) P).mp hPi
    have hnj : e_id j ∉ P.asIdeal := (PrimeSpectrum.mem_basicOpen (e_id j) P).mp hPj
    have h0 : e_id i * e_id j ∈ P.asIdeal := by
      rw [he_orth i j hij]
      exact P.asIdeal.zero_mem
    rcases P.isPrime.mem_or_mem h0 with hi | hj
    · exact hni hi
    · exact hnj hj

  have hD_univ : (⋃ i : Fin m_sheet, ((PrimeSpectrum.basicOpen (e_id i)).1 : Set ↥T_sch)) =
      Set.univ := by
    ext P
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    by_contra h_none
    have hall : ∀ i ∈ (Finset.univ : Finset (Fin m_sheet)), e_id i ∈ P.asIdeal := by
      intro i _
      by_contra hni
      exact h_none ⟨i, (PrimeSpectrum.mem_basicOpen (e_id i) P).mpr hni⟩
    have hsum_mem : (∑ i : Fin m_sheet, e_id i) ∈ P.asIdeal :=
      Ideal.sum_mem P.asIdeal hall
    rw [he_sum] at hsum_mem
    exact P.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hsum_mem isUnit_one)

  have hSheets : ∀ (Y_s : AlgebraicGeometry.Scheme.{u}) (g_Y : Quiver.Hom Y_s V_bar),
      let Y_V := CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.comp g_Y π_bar) π_bar
      ∃ δ : Fin m_sheet → Quiver.Hom Y_s Y_V,
        (∀ i : Fin m_sheet,
          CategoryTheory.CategoryStruct.comp (δ i)
            (CategoryTheory.Limits.pullback.fst (CategoryTheory.CategoryStruct.comp g_Y π_bar) π_bar) =
            CategoryTheory.CategoryStruct.id Y_s ∧
          AlgebraicGeometry.Etale (δ i) ∧
          IsOpen (Set.range (δ i).base)) ∧
        (∀ i j : Fin m_sheet, i ≠ j → Disjoint (Set.range (δ i).base) (Set.range (δ j).base)) ∧
        (⋃ i : Fin m_sheet, Set.range (δ i).base) = Set.univ := by
    intro Y_s g_Y Y_V
    let fst_YV := CategoryTheory.Limits.pullback.fst (g_Y ≫ π_bar) π_bar
    let snd_YV := CategoryTheory.Limits.pullback.snd (g_Y ≫ π_bar) π_bar
    have hdeck_π : ∀ i : Fin m_sheet,
        weilCurveTrGeomDeckHom F R₀ B₀ (equiv_Γ i) ≫ π_bar = π_bar := by
      intro i
      apply (CategoryTheory.cancel_mono U_bar.ι).mp
      rw [CategoryTheory.Category.assoc, hπ_ι, h_deck_all (equiv_Γ i)]
    let δ : Fin m_sheet → (Y_s ⟶ Y_V) := fun i =>
      CategoryTheory.Limits.pullback.lift (𝟙 Y_s)
        (g_Y ≫ weilCurveTrGeomDeckHom F R₀ B₀ (equiv_Γ i))
        (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hdeck_π i])
    have hq_comm : (fst_YV ≫ (g_Y ≫ fst_V)) ≫ π₀ = (snd_YV ≫ fst_V) ≫ π₀ := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, htop_comm,
        ← CategoryTheory.Category.assoc g_Y, ← CategoryTheory.Category.assoc fst_YV,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, ← htop_comm,
        ← CategoryTheory.Category.assoc]
    let q_YV : Y_V ⟶ T_sch := hpb_T.lift (fst_YV ≫ (g_Y ≫ fst_V)) (snd_YV ≫ fst_V) hq_comm
    have hq_p₁ : q_YV ≫ p₁ = fst_YV ≫ (g_Y ≫ fst_V) := hpb_T.lift_fst _ _ _
    have hq_p₂ : q_YV ≫ p₂ = snd_YV ≫ fst_V := hpb_T.lift_snd _ _ _
    have hpb_YV_outer : CategoryTheory.IsPullback (q_YV ≫ p₂) fst_YV π₀
        ((g_Y ≫ fst_V) ≫ π₀) := by
      rw [hq_p₂, CategoryTheory.Category.assoc, htop_comm, ← CategoryTheory.Category.assoc]
      exact (CategoryTheory.IsPullback.of_hasPullback (g_Y ≫ π_bar) π_bar).flip.paste_horiz hpb_top
    have hpb_q : CategoryTheory.IsPullback q_YV fst_YV p₁ (g_Y ≫ fst_V) :=
      CategoryTheory.IsPullback.of_right hpb_YV_outer hq_p₁ hpb_T.flip
    have hδ_pb : ∀ i : Fin m_sheet,
        CategoryTheory.IsPullback (g_Y ≫ fst_V) (δ i) (Δ_mod i) q_YV := by
      intro i
      have hδ_fst : δ i ≫ fst_YV = 𝟙 Y_s := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hδ_snd : δ i ≫ snd_YV = g_Y ≫ weilCurveTrGeomDeckHom F R₀ B₀ (equiv_Γ i) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have htop_δ : (g_Y ≫ fst_V) ≫ Δ_mod i = δ i ≫ q_YV := by
        apply hpb_T.hom_ext
        · rw [CategoryTheory.Category.assoc, hΔ_p₁ i, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.assoc, hq_p₁, ← CategoryTheory.Category.assoc, hδ_fst,
            CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hΔ_p₂ i,
            CategoryTheory.Category.assoc (δ i) q_YV p₂, hq_p₂,
            ← CategoryTheory.Category.assoc, hδ_snd,
            CategoryTheory.Category.assoc g_Y (weilCurveTrGeomDeckHom F R₀ B₀ (equiv_Γ i)) fst_V]
          exact (CategoryTheory.Category.assoc g_Y fst_V _).trans
            (congrArg (g_Y ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
      have houter_iso : CategoryTheory.IsPullback (g_Y ≫ fst_V) (δ i ≫ fst_YV)
          (Δ_mod i ≫ p₁) (g_Y ≫ fst_V) := by
        rw [hδ_fst, hΔ_p₁ i]
        exact CategoryTheory.IsPullback.of_vert_isIso
          ⟨(CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm⟩
      exact CategoryTheory.IsPullback.of_bot houter_iso htop_δ hpb_q
    have hδ_range : ∀ i : Fin m_sheet,
        Set.range (δ i).base =
          q_YV.base ⁻¹' ((PrimeSpectrum.basicOpen (e_id i)).1 : Set ↥T_sch) := by
      intro i
      rw [hRange_of_isPullback (hδ_pb i).flip, hΔ_range i]
    refine ⟨δ, ?_, ?_, ?_⟩
    · intro i
      refine ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _,
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hδ_pb i) (hΔ_et i), ?_⟩
      rw [hδ_range i]
      exact (PrimeSpectrum.basicOpen (e_id i)).2.preimage
        (AlgebraicGeometry.Scheme.Hom.continuous q_YV)
    · intro i j hij
      rw [hδ_range i, hδ_range j]
      exact (hD_disj i j hij).preimage q_YV.base
    · ext y
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hmem : q_YV.base y ∈
          (⋃ i : Fin m_sheet, ((PrimeSpectrum.basicOpen (e_id i)).1 : Set ↥T_sch)) := by
        rw [hD_univ]
        trivial
      rcases Set.mem_iUnion.mp hmem with ⟨i, hi⟩
      refine ⟨i, ?_⟩
      rw [hδ_range i]
      exact hi

  
  
  
  have hSep₀ : P_Sep D_ov.hom := by
    dsimp [P_Sep, D_ov, weilProjectiveSpaceOver]
    infer_instance
  have hSep_bar : AlgebraicGeometry.IsSeparated D_bar_ov.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_bot hSep₀
  haveI : AlgebraicGeometry.IsSeparated D_bar_ov.hom := hSep_bar

  let baseChangeSec : ∀ (s₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D_ov.left),
      s₀ ≫ D_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) →
      (AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar) :=
    fun s₀ hs₀ =>
      CategoryTheory.Limits.pullback.lift (f₂ ≫ s₀)
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (by rw [CategoryTheory.Category.assoc, hs₀, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp])

  have hBaseChangeSec_spec : ∀ (s₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D_ov.left)
      (hs₀ : s₀ ≫ D_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F))),
      let s_bar := baseChangeSec s₀ hs₀
      (s_bar ≫ D_bar_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
        AlgebraicGeometry.IsClosedImmersion s_bar) ∧
      Set.range s_bar.base = pr_D.base ⁻¹' Set.range s₀.base := by
    intro s₀ hs₀ s_bar
    have hs_hom : s_bar ≫ D_bar_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hs_closed : AlgebraicGeometry.IsClosedImmersion s_bar := by
      haveI : AlgebraicGeometry.IsClosedImmersion (s_bar ≫ D_bar_ov.hom) := by
        rw [hs_hom]
        infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp s_bar D_bar_ov.hom
    have hpb_s : CategoryTheory.IsPullback s_bar f₂ pr_D s₀ := by
      have houter : CategoryTheory.IsPullback f₂ (s_bar ≫ D_bar_ov.hom) (s₀ ≫ D_ov.hom) f₂ := by
        rw [hs_hom, hs₀]
        exact CategoryTheory.IsPullback.of_vert_isIso
          ⟨(CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm⟩
      have htop_s : f₂ ≫ s₀ = s_bar ≫ pr_D :=
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      exact (CategoryTheory.IsPullback.of_bot houter htop_s hpb_bot).flip
    exact ⟨⟨hs_hom, hs_closed⟩, hRange_of_isPullback hpb_s⟩

  let s_aff_pt : F → (AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D_ov.left) := fun a =>
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff
  have hs_aff_sec : ∀ a : F,
      s_aff_pt a ≫ D_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) := by
    intro a
    dsimp [s_aff_pt]
    rw [CategoryTheory.Category.assoc, hj_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hevalC : (Polynomial.evalRingHom a).comp Polynomial.C = RingHom.id F := by
      ext c
      exact Polynomial.eval_C
    rw [hevalC]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of F)

  have heval_range : ∀ (a : F)
      (p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))),
      Polynomial.X - Polynomial.C a ∈ p.asIdeal ↔
        p ∈ Set.range (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.evalRingHom a))).base := by
    intro a p
    constructor
    · intro hmem
      have hsurj_ev : Function.Surjective (Polynomial.evalRingHom a) := fun c =>
        ⟨Polynomial.C c, Polynomial.eval_C⟩
      haveI : (RingHom.ker (Polynomial.evalRingHom a)).IsMaximal :=
        RingHom.ker_isMaximal_of_surjective (Polynomial.evalRingHom a) hsurj_ev
      have hker_le : RingHom.ker (Polynomial.evalRingHom a) ≤ p.asIdeal := by
        refine le_trans ?_ ((Ideal.span_singleton_le_iff_mem p.asIdeal).mpr hmem)
        intro Q hQ
        rw [RingHom.mem_ker] at hQ
        have hdvd : Polynomial.X - Polynomial.C a ∣ Q :=
          Polynomial.dvd_iff_isRoot.mpr hQ
        exact Ideal.mem_span_singleton.mpr hdvd
      have hker_eq : RingHom.ker (Polynomial.evalRingHom a) = p.asIdeal :=
        Ideal.IsMaximal.eq_of_le inferInstance p.isPrime.ne_top hker_le
      let pt₀ : PrimeSpectrum F := default
      have hpt₀_bot : pt₀.asIdeal = ⊥ := Ideal.eq_bot_of_prime pt₀.asIdeal
      refine ⟨pt₀, PrimeSpectrum.ext ?_⟩
      ext Q
      change Polynomial.evalRingHom a Q ∈ pt₀.asIdeal ↔ Q ∈ p.asIdeal
      rw [hpt₀_bot, Ideal.mem_bot, ← RingHom.mem_ker, hker_eq]
    · rintro ⟨pt, rfl⟩
      let pt' : PrimeSpectrum F := pt
      have hpt_bot : pt'.asIdeal = ⊥ := Ideal.eq_bot_of_prime pt'.asIdeal
      change Polynomial.evalRingHom a (Polynomial.X - Polynomial.C a) ∈ pt'.asIdeal
      rw [hpt_bot, Ideal.mem_bot, map_sub]
      change Polynomial.eval a Polynomial.X - Polynomial.eval a (Polynomial.C a) = 0
      rw [Polynomial.eval_X, Polynomial.eval_C, sub_self]

  let s₀_opt : Option ↥S_aff → (AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D_ov.left)
    | none => s_inf
    | some a => s_aff_pt a.1
  have hs₀_opt : ∀ o : Option ↥S_aff,
      s₀_opt o ≫ D_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F))
    | none => hsinf_sec
    | some a => hs_aff_sec a.1

  have hU₀_compl : (U₀ : Set ↥D_ov.left)ᶜ =
      ⋃ o : Option ↥S_aff, Set.range (s₀_opt o).base := by
    have hj_inj : Function.Injective j_aff.base :=
      (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding j_aff).toIsEmbedding.injective
    ext z
    simp only [Set.mem_compl_iff, Set.mem_iUnion]
    by_cases hz_aff : z ∈ Set.range j_aff.base
    · rcases hz_aff with ⟨p, rfl⟩
      rw [hU₀_eq, hj_inj.mem_set_image]
      change (¬ ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal) ↔ _
      simp only [not_forall, Classical.not_not]
      constructor
      · rintro ⟨a, haS, hmem⟩
        refine ⟨some ⟨a, haS⟩, ?_⟩
        rcases (heval_range a p).mp hmem with ⟨pt, rfl⟩
        exact ⟨pt, rfl⟩
      · rintro ⟨o, ho⟩
        cases o with
        | none =>
          exfalso
          dsimp [s₀_opt] at ho
          rw [← hsinf_compl] at ho
          exact ho ⟨p, rfl⟩
        | some a =>
          rcases ho with ⟨pt, hpt⟩
          have hp_eq : (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.evalRingHom a.1))).base pt = p :=
            hj_inj hpt
          exact ⟨a.1, a.2, (heval_range a.1 p).mpr ⟨pt, hp_eq⟩⟩
    · constructor
      · intro _
        refine ⟨none, ?_⟩
        dsimp [s₀_opt]
        rwa [← hsinf_compl]
      · intro _ hzU₀
        rw [hU₀_eq] at hzU₀
        rcases hzU₀ with ⟨p, _, rfl⟩
        exact hz_aff ⟨p, rfl⟩

  let m_bdry : ℕ := S_aff.card + 1
  have hcard_opt : Fintype.card (Option ↥S_aff) = m_bdry := by
    rw [Fintype.card_option, Fintype.card_coe]
  let e_bdry : Fin m_bdry ≃ Option ↥S_aff :=
    (Fintype.equivFinOfCardEq hcard_opt).symm
  let s_bdry : Fin m_bdry → (AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar) :=
    fun t => baseChangeSec (s₀_opt (e_bdry t)) (hs₀_opt (e_bdry t))

  have hs_bdry_props : ∀ t : Fin m_bdry,
      CategoryTheory.CategoryStruct.comp (s_bdry t) D_bar_ov.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      AlgebraicGeometry.IsClosedImmersion (s_bdry t) :=
    fun t => (hBaseChangeSec_spec (s₀_opt (e_bdry t)) (hs₀_opt (e_bdry t))).1

  have hU_bar_compl : (U_bar : Set ↥D_bar)ᶜ =
      ⋃ t : Fin m_bdry, Set.range (s_bdry t).base := by
    have hU_pre : (U_bar : Set ↥D_bar) = pr_D.base ⁻¹' (U₀ : Set ↥D_ov.left) := rfl
    rw [hU_pre, ← Set.preimage_compl, hU₀_compl, Set.preimage_iUnion]
    have h1 : (⋃ i : Option ↥S_aff, pr_D.base ⁻¹' Set.range (s₀_opt i).base) =
        ⋃ i : Option ↥S_aff, Set.range (baseChangeSec (s₀_opt i) (hs₀_opt i)).base := by
      refine Set.iUnion_congr fun i => ?_
      exact ((hBaseChangeSec_spec (s₀_opt i) (hs₀_opt i)).2).symm
    rw [h1]
    ext x
    simp only [Set.mem_iUnion]
    exact ⟨fun ⟨o, ho⟩ => ⟨e_bdry.symm o, by
        dsimp [s_bdry]
        rwa [e_bdry.apply_symm_apply]⟩,
      fun ⟨t, ht⟩ => ⟨e_bdry t, ht⟩⟩

  exact ⟨m_bdry, m_sheet, g_Dr_iso, π_bar, s_bdry, hm_sheet, hg_Dr_eq, hα_ι, hπ_ι,
    hπ_et, hπ_surj, hSheets, hs_bdry_props, hU_bar_compl⟩

theorem weil_curve_tr_constant_field_and_deck_lift (F : Type u) [Finite F] [Field F]
    (g : Polynomial F) (hg : g ≠ 0)
    (R₀ B₀ L₀ : Type u) [CommRing R₀] [CommRing B₀] [IsDomain B₀] [Field L₀]
    [Algebra (Polynomial F) R₀] [IsLocalization.Away g R₀]
    [Algebra F B₀] [Algebra (Polynomial F) B₀] [Algebra R₀ B₀]
    [Algebra F L₀] [Algebra (Polynomial F) L₀] [Algebra (RatFunc F) L₀]
    [Algebra B₀ L₀] [Algebra R₀ L₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower F (RatFunc F) L₀] [IsScalarTower (Polynomial F) (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) R₀ B₀] [IsScalarTower (Polynomial F) B₀ L₀]
    [IsScalarTower R₀ B₀ L₀]
    [Module.Finite R₀ B₀]
    [IsFractionRing B₀ L₀]
    [IsIntegralClosure B₀ R₀ L₀]
    [FiniteDimensional (RatFunc F) L₀] [IsGalois (RatFunc F) L₀]
    (σ : B₀ ≃ₐ[R₀] B₀) :
    ∃ (F₀ : Type u) (_ : Field F₀) (_ : Finite F₀) (_ : Algebra F F₀)
      (_ : FiniteDimensional F F₀) (_ : Algebra F₀ L₀) (_ : IsScalarTower F F₀ L₀)
      (σ_L : L₀ ≃ₐ[R₀] L₀),
      1 ≤ Module.finrank (RatFunc F) L₀ ∧
      Algebra.IsSeparable (RatFunc F) L₀ ∧
      IsDomain R₀ ∧
      Nontrivial R₀ ∧
      IsPrincipalIdealRing R₀ ∧
      IsDedekindDomain R₀ ∧
      IsScalarTower (Polynomial F) R₀ L₀ ∧
      (∀ x : L₀, IsIntegral F x → ∃ c : F₀, algebraMap F₀ L₀ c = x) ∧
      (∀ c : F, algebraMap (Polynomial F) L₀ (Polynomial.C c) = algebraMap F L₀ c) ∧
      (∀ b : B₀, σ_L (algebraMap B₀ L₀ b) = algebraMap B₀ L₀ (σ b)) ∧
      (∀ f : Polynomial F, σ_L (algebraMap (Polynomial F) L₀ f) = algebraMap (Polynomial F) L₀ f) ∧
      (∀ f : Polynomial F,
        σ_L.symm (algebraMap (Polynomial F) L₀ f) = algebraMap (Polynomial F) L₀ f) :=
by
  have hd_cov : 1 ≤ Module.finrank (RatFunc F) L₀ := Module.finrank_pos
  have hSep : Algebra.IsSeparable (RatFunc F) L₀ :=
    @IsGalois.to_isSeparable (RatFunc F) _ L₀ _ _ _
  have hC_F : ∀ c : F, algebraMap (Polynomial F) L₀ (Polynomial.C c) = algebraMap F L₀ c := by
    intro c
    have hC : (Polynomial.C c : Polynomial F) = algebraMap F (Polynomial F) c :=
      (DFunLike.congr_fun Polynomial.algebraMap_eq c).symm
    rw [hC, IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L₀,
      ← IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F),
      ← IsScalarTower.algebraMap_apply F (RatFunc F) L₀]
  have hST_FPL : IsScalarTower F (Polynomial F) L₀ :=
    IsScalarTower.of_algebraMap_eq fun c => by
      have hC : algebraMap F (Polynomial F) c = Polynomial.C c :=
        DFunLike.congr_fun Polynomial.algebraMap_eq c
      rw [hC, hC_F c]
  have hST_PRL : IsScalarTower (Polynomial F) R₀ L₀ :=
    IsScalarTower.of_algebraMap_eq fun f => by
      rw [IsScalarTower.algebraMap_apply (Polynomial F) B₀ L₀,
        IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀,
        ← IsScalarTower.algebraMap_apply R₀ B₀ L₀]
  have hST_FBL : IsScalarTower F B₀ L₀ :=
    IsScalarTower.of_algebraMap_eq fun c => by
      have hC : algebraMap F (Polynomial F) c = Polynomial.C c :=
        DFunLike.congr_fun Polynomial.algebraMap_eq c
      rw [← hC_F c, ← hC, IsScalarTower.algebraMap_apply (Polynomial F) B₀ L₀,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) B₀]
  letI : IsScalarTower F (Polynomial F) L₀ := hST_FPL
  letI : IsScalarTower (Polynomial F) R₀ L₀ := hST_PRL
  letI : IsScalarTower F B₀ L₀ := hST_FBL
  have hDom_R₀ : IsDomain R₀ :=
    IsLocalization.isDomain_of_le_nonZeroDivisors R₀
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg))
  letI : IsDomain R₀ := hDom_R₀
  have hNontriv_R₀ : Nontrivial R₀ := inferInstance
  have hPID_R₀ : IsPrincipalIdealRing R₀ :=
    IsPrincipalIdealRing.mk fun I => by
      obtain ⟨a, ha⟩ := Submodule.IsPrincipal.principal (Ideal.under (Polynomial F) I)
      refine ⟨algebraMap (Polynomial F) R₀ a, ?_⟩
      calc
        I = Ideal.map (algebraMap (Polynomial F) R₀) (Ideal.under (Polynomial F) I) :=
            (IsLocalization.map_under (Submonoid.powers g) R₀ I).symm
        _ = Ideal.map (algebraMap (Polynomial F) R₀) (Submodule.span (Polynomial F) {a}) := by
            rw [ha]
        _ = Ideal.map (algebraMap (Polynomial F) R₀) (Ideal.span {a}) := by
            rw [Ideal.submodule_span_eq]
        _ = Ideal.span (algebraMap (Polynomial F) R₀ '' {a}) :=
            Ideal.map_span (algebraMap (Polynomial F) R₀) {a}
        _ = Ideal.span {algebraMap (Polynomial F) R₀ a} := by
            rw [Set.image_singleton]
        _ = Submodule.span R₀ {algebraMap (Polynomial F) R₀ a} := by
            rw [Ideal.submodule_span_eq]
  letI : IsPrincipalIdealRing R₀ := hPID_R₀
  have hDed_R₀ : IsDedekindDomain R₀ := IsPrincipalIdealRing.isDedekindDomain R₀
  let S₀ : Subalgebra F L₀ := integralClosure F L₀
  have hIsField_S₀ : IsField ↥S₀ :=
    IsIntegralClosure.isField (R := F) (B := L₀) (↥S₀) (Field.toIsField F)
  have h_inv : ∀ x ∈ S₀, x⁻¹ ∈ S₀ := by
    intro x hx
    by_cases hx0 : x = 0
    · rw [hx0, inv_zero]
      exact S₀.zero_mem
    · have hs_ne : (⟨x, hx⟩ : ↥S₀) ≠ 0 := fun h => hx0 (congrArg Subtype.val h)
      obtain ⟨y, hy⟩ := hIsField_S₀.mul_inv_cancel hs_ne
      have hxy : x * y.1 = 1 := congrArg Subtype.val hy
      have hx_inv : x⁻¹ = y.1 := by
        calc
          x⁻¹ = x⁻¹ * 1 := (mul_one x⁻¹).symm
          _ = x⁻¹ * (x * y.1) := by rw [hxy]
          _ = (x⁻¹ * x) * y.1 := (mul_assoc x⁻¹ x y.1).symm
          _ = 1 * y.1 := by rw [inv_mul_cancel₀ hx0]
          _ = y.1 := one_mul y.1
      rw [hx_inv]
      exact y.2
  let E₀ : IntermediateField F L₀ := S₀.toIntermediateField h_inv
  let F₀ : Type u := ↥E₀
  have hF₀_int : ∀ x : L₀, IsIntegral F x → ∃ c : F₀, algebraMap F₀ L₀ c = x :=
    fun x hx => ⟨⟨x, (mem_integralClosure_iff F L₀).mpr hx⟩, rfl⟩
  have h_ex : ∀ c : F₀, ∃ b : B₀, algebraMap B₀ L₀ b = algebraMap F₀ L₀ c := by
    intro c
    have hc_F : IsIntegral F (algebraMap F₀ L₀ c) := (mem_integralClosure_iff F L₀).mp c.2
    have hc_P : IsIntegral (Polynomial F) (algebraMap F₀ L₀ c) :=
      IsIntegral.tower_top (R := F) hc_F
    have hc_R : IsIntegral R₀ (algebraMap F₀ L₀ c) :=
      IsIntegral.tower_top (R := Polynomial F) hc_P
    exact (IsIntegralClosure.isIntegral_iff (A := B₀) (R := R₀) (B := L₀)).mp hc_R
  let liftB : F₀ → B₀ := fun c => Classical.choose (h_ex c)
  have h_liftB : ∀ c : F₀, algebraMap B₀ L₀ (liftB c) = algebraMap F₀ L₀ c :=
    fun c => Classical.choose_spec (h_ex c)
  have h_injB : Function.Injective (algebraMap B₀ L₀) := IsFractionRing.injective B₀ L₀
  let ψ_B : F₀ →ₐ[F] B₀ :=
    { toFun := liftB
      map_one' := h_injB (by rw [h_liftB, map_one, map_one])
      map_mul' := fun x y => h_injB (by rw [h_liftB, map_mul, map_mul, h_liftB, h_liftB])
      map_zero' := h_injB (by rw [h_liftB, map_zero, map_zero])
      map_add' := fun x y => h_injB (by rw [h_liftB, map_add, map_add, h_liftB, h_liftB])
      commutes' := fun a => h_injB (by
        rw [h_liftB, ← IsScalarTower.algebraMap_apply F F₀ L₀,
          IsScalarTower.algebraMap_apply F B₀ L₀]) }
  have hFT_FP : Algebra.FiniteType F (Polynomial F) := inferInstance
  have hFT_PR : Algebra.FiniteType (Polynomial F) R₀ :=
    RingHom.finiteType_algebraMap.mp (RingHom.finiteType_holdsForLocalizationAway R₀ g)
  have hFT_RB : Algebra.FiniteType R₀ B₀ := Module.Finite.finiteType B₀
  have hFT_PB : Algebra.FiniteType (Polynomial F) B₀ :=
    @Algebra.FiniteType.trans (Polynomial F) R₀ B₀ _ _ _ _ _ _ _ hFT_PR hFT_RB
  letI : Algebra.FiniteType F B₀ :=
    @Algebra.FiniteType.trans F (Polynomial F) B₀ _ _ _ _ _ _ _ hFT_FP hFT_PB
  obtain ⟨m, hm⟩ := Ideal.exists_maximal B₀
  letI : m.IsMaximal := hm
  let φ_Q : F₀ →ₐ[F] (B₀ ⧸ m) := (Ideal.Quotient.mkₐ F m).comp ψ_B
  have hFT_Q : Algebra.FiniteType F (B₀ ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ F m) (Ideal.Quotient.mkₐ_surjective F m)
  letI : Field (B₀ ⧸ m) := Ideal.Quotient.field m
  have hφ_inj : Function.Injective φ_Q := RingHom.injective φ_Q.toRingHom
  letI : Module.Finite F (B₀ ⧸ m) :=
    @finite_of_finite_type_of_isJacobsonRing F (B₀ ⧸ m) _ (Ideal.Quotient.field m)
      inferInstance inferInstance hFT_Q
  have hFD_F₀ : FiniteDimensional F F₀ := FiniteDimensional.of_injective φ_Q.toLinearMap hφ_inj
  letI : FiniteDimensional F F₀ := hFD_F₀
  have hFin_F₀ : Finite F₀ := Module.finite_of_finite F
  let σ_L : L₀ ≃ₐ[R₀] L₀ := IsFractionRing.algEquivOfAlgEquiv σ
  have hσ_B : ∀ b : B₀, σ_L (algebraMap B₀ L₀ b) = algebraMap B₀ L₀ (σ b) :=
    fun b => IsFractionRing.algEquivOfAlgEquiv_algebraMap (K := L₀) σ b
  have hσ_P : ∀ f : Polynomial F,
      σ_L (algebraMap (Polynomial F) L₀ f) = algebraMap (Polynomial F) L₀ f := by
    intro f
    rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ L₀]
    exact σ_L.commutes (algebraMap (Polynomial F) R₀ f)
  have hσ_symm_P : ∀ f : Polynomial F,
      σ_L.symm (algebraMap (Polynomial F) L₀ f) = algebraMap (Polynomial F) L₀ f := by
    intro f
    rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ L₀]
    exact σ_L.symm.commutes (algebraMap (Polynomial F) R₀ f)
  exact ⟨F₀, inferInstance, hFin_F₀, inferInstance, hFD_F₀, inferInstance, inferInstance, σ_L,
    hd_cov, hSep, hDom_R₀, hNontriv_R₀, hPID_R₀, hDed_R₀, hST_PRL,
    hF₀_int, hC_F, hσ_B, hσ_P, hσ_symm_P⟩

theorem weil_p1_two_chart_pid_atlas_and_functionField (F : Type u) [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (hNontriv_R₀ : Nontrivial
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let D_ov := weilProjectiveSpaceOver F 1
    AlgebraicGeometry.IsProper D_ov.hom ∧
    ∃ (_ : AlgebraicGeometry.IsIntegral D_ov.left)
      (_ : QuasiSeparatedSpace ↥D_ov.left)
      (_ : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}))
      (W_chart : Fin 2 → D_ov.left.Opens)
      (e_ff : ↑D_ov.left.functionField ≃+* RatFunc F)
      (hU₀_aff : AlgebraicGeometry.IsAffineOpen U₀)
      (φ_U_cat : CategoryTheory.Iso
        (D_ov.left.presheaf.obj (Opposite.op U₀)) (CommRingCat.of R₀)),
      W_chart 0 ⊔ W_chart 1 = ⊤ ∧
      Set.range s_inf.base ⊆ (W_chart 1 : Set ↥D_ov.left) ∧
      (∀ a : Fin 2,
        let W := W_chart a
        let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
        AlgebraicGeometry.IsAffineOpen W ∧
        Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) ∧
        IsDomain A_W ∧
        IsPrincipalIdealRing A_W ∧
        IsDedekindDomain A_W ∧
        ∃ φ_A : Polynomial F ≃+* A_W,
          ∀ c : F,
            φ_A (Polynomial.C c) =
              (CommRingCat.Hom.hom
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
                    (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) ∧
      (∀ (W : D_ov.left.Opens), AlgebraicGeometry.IsAffineOpen W →
        Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) →
          ∃ z : ↥W, z.1 ≠ genericPoint ↥D_ov.left) ∧
      (∀ (K : Type u) [Field K] [Algebra (Polynomial F) K] [Algebra (RatFunc F) K]
          [IsScalarTower (Polynomial F) (RatFunc F) K],
        let ξ := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) K))) j_aff
        let ψ_K := (algebraMap (RatFunc F) K).comp e_ff.toRingHom
        (FiniteDimensional (RatFunc F) K →
          @FiniteDimensional ↑D_ov.left.functionField K _ _ ψ_K.toAlgebra.toModule ∧
          @Module.finrank ↑D_ov.left.functionField K _ _ ψ_K.toAlgebra.toModule =
            Module.finrank (RatFunc F) K) ∧
        (Algebra.IsSeparable (RatFunc F) K →
          @Algebra.IsSeparable ↑D_ov.left.functionField K _ _ ψ_K.toAlgebra) ∧
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)),
          ξ.base pt = genericPoint ↥D_ov.left) ∧
        (∀ (W : D_ov.left.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})]
            (he : ⊤ ≤ (TopologicalSpace.Opens.map ξ.base).obj W),
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appLE ξ W ⊤ he)
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom =
            ψ_K.comp (D_ov.left.germToFunctionField W).hom)) ∧
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map φ_U_cat.hom) hU₀_aff.fromSpec =
        CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι ∧
      (∀ (K : Type u) [Field K] [Algebra (Polynomial F) K] [Algebra (RatFunc F) K]
          [Algebra R₀ K] [IsScalarTower (Polynomial F) (RatFunc F) K]
          [IsScalarTower (Polynomial F) R₀ K],
        let ψ_K := (algebraMap (RatFunc F) K).comp e_ff.toRingHom
        (ψ_K.comp (CommRingCat.Hom.hom (D_ov.left.germToFunctionField U₀))).comp
          φ_U_cat.inv.hom = algebraMap R₀ K) :=
by
  have _ := hsinf_sec
  
  have hOpenImmIso : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (R : Type u) [CommRing R]
      (f : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R)) X)
      [AlgebraicGeometry.IsOpenImmersion f]
      (W : X.Opens)
      (hW_range : (W : Set ↥X) = Set.range f.base)
      (he_f : ⊤ ≤ (TopologicalSpace.Opens.map f.base).obj W),
      ∃ (hW_aff : AlgebraicGeometry.IsAffineOpen W)
        (α_cat : CategoryTheory.Iso (X.presheaf.obj (Opposite.op W)) (CommRingCat.of R)),
        (Nontrivial R → Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})) ∧
        α_cat.hom = CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appLE f W ⊤ he_f)
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).hom ∧
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map α_cat.hom) hW_aff.fromSpec = f ∧
        ∀ (f_X : Quiver.Hom X (AlgebraicGeometry.Spec (CommRingCat.of F)))
          (i_F : F →+* R),
          CategoryTheory.CategoryStruct.comp f f_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom i_F) →
          ∀ c : F,
            α_cat.inv.hom (i_F c) =
              (CommRingCat.Hom.hom
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Scheme.Hom.appTop f_X)
                    (X.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c := by
    intro X R _ f _ W hW_range he_f
    have hW_eq : W = f.opensRange := TopologicalSpace.Opens.ext hW_range
    have hW_aff : AlgebraicGeometry.IsAffineOpen W :=
      hW_eq ▸ AlgebraicGeometry.isAffineOpen_opensRange f
    have hNe : Nontrivial R → Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := by
      intro _
      obtain ⟨m, hm⟩ := Ideal.exists_maximal R
      let p₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) := ⟨m, hm.isPrime⟩
      have hp₀ : f.base p₀ ∈ W := by
        change f.base p₀ ∈ (W : Set ↥X)
        rw [hW_range]
        exact ⟨p₀, rfl⟩
      exact ⟨⟨f.base p₀, hp₀⟩⟩
    have hRange_eq : Set.range f.base = Set.range hW_aff.fromSpec.base :=
      hW_range.symm.trans hW_aff.range_fromSpec.symm
    let e_Spec := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq f hW_aff.fromSpec hRange_eq
    have he_fac : e_Spec.hom ≫ hW_aff.fromSpec = f :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac f hW_aff.fromSpec hRange_eq
    let α_cat : CategoryTheory.Iso (X.presheaf.obj (Opposite.op W)) (CommRingCat.of R) :=
      { hom := AlgebraicGeometry.Spec.preimage e_Spec.hom
        inv := AlgebraicGeometry.Spec.preimage e_Spec.inv
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.preimage_comp, e_Spec.inv_hom_id,
            AlgebraicGeometry.Spec.preimage_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.preimage_comp, e_Spec.hom_inv_id,
            AlgebraicGeometry.Spec.preimage_id] }
    have hSpec_fac : AlgebraicGeometry.Spec.map α_cat.hom ≫ hW_aff.fromSpec = f := by
      change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_Spec.hom) ≫
        hW_aff.fromSpec = f
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact he_fac
    have hα_hom : α_cat.hom =
        AlgebraicGeometry.Scheme.Hom.appLE f W ⊤ he_f ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).hom := by
      have he_comp : ⊤ ≤ (AlgebraicGeometry.Spec.map α_cat.hom ≫ hW_aff.fromSpec) ⁻¹ᵁ W := by
        change ⊤ ≤ (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map α_cat.hom ≫ hW_aff.fromSpec).base).obj W
        rw [hSpec_fac]; exact he_f
      have he_step : ⊤ ≤ (AlgebraicGeometry.Spec.map α_cat.hom) ⁻¹ᵁ (hW_aff.fromSpec ⁻¹ᵁ W) :=
        he_comp
      have he_rw : AlgebraicGeometry.Scheme.Hom.appLE f W ⊤ he_f =
          AlgebraicGeometry.Scheme.Hom.app hW_aff.fromSpec W ≫
            AlgebraicGeometry.Scheme.Hom.appLE (AlgebraicGeometry.Spec.map α_cat.hom)
              (hW_aff.fromSpec ⁻¹ᵁ W) ⊤ he_step := by
        have h1 : AlgebraicGeometry.Scheme.Hom.appLE f W ⊤ he_f =
            AlgebraicGeometry.Scheme.Hom.appLE
              (AlgebraicGeometry.Spec.map α_cat.hom ≫ hW_aff.fromSpec) W ⊤ he_comp := by
          congr 1; exact hSpec_fac.symm
        exact h1.trans (AlgebraicGeometry.Scheme.Hom.comp_appLE _ _ _ _ _)
      rw [he_rw, hW_aff.fromSpec_app_self,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc
          ((AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op W))).presheaf.map _),
        AlgebraicGeometry.Scheme.Hom.map_appLE]
      have h_appLE_eq : ∀ (h1 : ⊤ ≤
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map α_cat.hom).base).obj ⊤),
          AlgebraicGeometry.Scheme.Hom.appLE (AlgebraicGeometry.Spec.map α_cat.hom) ⊤ ⊤ h1 =
          AlgebraicGeometry.Scheme.Hom.appTop (AlgebraicGeometry.Spec.map α_cat.hom) :=
        fun _ => rfl
      rw [h_appLE_eq, AlgebraicGeometry.Scheme.ΓSpecIso_naturality α_cat.hom,
        ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp]
    refine ⟨hW_aff, α_cat, hNe, hα_hom, hSpec_fac, ?_⟩
    intro f_X i_F h_comm c
    let ρ : CommRingCat.of F ⟶ X.presheaf.obj (Opposite.op W) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (AlgebraicGeometry.Scheme.Hom.appTop f_X ≫
          X.presheaf.map (CategoryTheory.homOfLE le_top).op)
    suffices h_cat : CommRingCat.ofHom i_F ≫ α_cat.inv = ρ by
      exact congrArg (fun g => g.hom c) h_cat
    rw [← CategoryTheory.Iso.cancel_iso_hom_right _ _ α_cat, CategoryTheory.Category.assoc,
      CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
    dsimp [ρ]
    rw [hα_hom, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (X.presheaf.map _),
      AlgebraicGeometry.Scheme.Hom.map_appLE]
    have hf_appTop : ∀ (h1 : ⊤ ≤ (TopologicalSpace.Opens.map f.base).obj ⊤),
        AlgebraicGeometry.Scheme.Hom.appLE f ⊤ ⊤ h1 = AlgebraicGeometry.Scheme.Hom.appTop f :=
      fun _ => rfl
    rw [hf_appTop, ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.Hom.appTop f_X),
      ← AlgebraicGeometry.Scheme.Hom.comp_appTop, h_comm,
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom i_F),
      ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp]
  
  have hFF_and_U₀ : ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
      (j₀_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) X)
      [AlgebraicGeometry.IsOpenImmersion j₀_aff]
      (R : Type u) [CommRing R] [Algebra (Polynomial F) R]
      (U : X.Opens) [Nonempty ↥(U : AlgebraicGeometry.Scheme.{u})]
      (e : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R)) U.toScheme)
      (he : CategoryTheory.CategoryStruct.comp e.hom U.ι =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R))) j₀_aff)
      (hU_range : (U : Set ↥X) = Set.range (CategoryTheory.CategoryStruct.comp e.hom U.ι).base)
      (he_fU : ⊤ ≤ (TopologicalSpace.Opens.map
        (CategoryTheory.CategoryStruct.comp e.hom U.ι).base).obj U)
      (φ_cat : CategoryTheory.Iso (X.presheaf.obj (Opposite.op U)) (CommRingCat.of R))
      (hφ_hom : φ_cat.hom = CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE
          (CategoryTheory.CategoryStruct.comp e.hom U.ι) U ⊤ he_fU)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).hom),
      (∀ (W : X.Opens), AlgebraicGeometry.IsAffineOpen W →
        Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) →
          ∃ z : ↥W, z.1 ≠ genericPoint ↥X) ∧
      ∃ (e_ff : ↑X.functionField ≃+* RatFunc F),
        (∀ (K : Type u) [Field K] [Algebra (Polynomial F) K] [Algebra (RatFunc F) K]
            [IsScalarTower (Polynomial F) (RatFunc F) K],
          let ξ := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) K))) j₀_aff
          let ψ_K := (algebraMap (RatFunc F) K).comp e_ff.toRingHom
          (FiniteDimensional (RatFunc F) K →
            @FiniteDimensional ↑X.functionField K _ _ ψ_K.toAlgebra.toModule ∧
            @Module.finrank ↑X.functionField K _ _ ψ_K.toAlgebra.toModule =
              Module.finrank (RatFunc F) K) ∧
          (Algebra.IsSeparable (RatFunc F) K →
            @Algebra.IsSeparable ↑X.functionField K _ _ ψ_K.toAlgebra) ∧
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)),
            ξ.base pt = genericPoint ↥X) ∧
          (∀ (W : X.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})]
              (he_W : ⊤ ≤ (TopologicalSpace.Opens.map ξ.base).obj W),
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appLE ξ W ⊤ he_W)
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom =
              ψ_K.comp (X.germToFunctionField W).hom)) ∧
        (∀ (K : Type u) [Field K] [Algebra (Polynomial F) K] [Algebra (RatFunc F) K]
            [Algebra R K] [IsScalarTower (Polynomial F) (RatFunc F) K]
            [IsScalarTower (Polynomial F) R K],
          let ψ_K := (algebraMap (RatFunc F) K).comp e_ff.toRingHom
          (ψ_K.comp (CommRingCat.Hom.hom (X.germToFunctionField U))).comp
            φ_cat.inv.hom = algebraMap R K) := by
    intro X _ j₀_aff _ R _ _ U _ e he hU_range he_fU φ_cat hφ_hom
    let bot_P : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
      (⊥ : PrimeSpectrum (Polynomial F))
    have hgen_j : j₀_aff.base bot_P = genericPoint ↥X := by
      have h1 := AlgebraicGeometry.genericPoint_eq_of_isOpenImmersion j₀_aff
      have h2 : genericPoint ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) = bot_P :=
        AlgebraicGeometry.genericPoint_eq_bot_of_affine (CommRingCat.of (Polynomial F))
      rwa [h2] at h1
    have hNonGen : ∀ (W : X.Opens), AlgebraicGeometry.IsAffineOpen W →
        Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) →
          ∃ z : ↥W, z.1 ≠ genericPoint ↥X := by
      intro W _ hNe
      obtain ⟨w₀⟩ := hNe
      have hη_W : genericPoint ↥X ∈ (W : Set ↥X) :=
        ((genericPoint_spec ↥X).mem_open_set_iff W.isOpen).mpr
          ⟨w₀.1, Set.mem_univ _, w₀.2⟩
      let U_pre : Set (PrimeSpectrum (Polynomial F)) := j₀_aff.base ⁻¹' (W : Set ↥X)
      have hU_open : IsOpen U_pre :=
        W.isOpen.preimage (AlgebraicGeometry.Scheme.Hom.continuous j₀_aff)
      have hbot_U : (⊥ : PrimeSpectrum (Polynomial F)) ∈ U_pre := by
        change j₀_aff.base bot_P ∈ (W : Set ↥X)
        rwa [hgen_j]
      obtain ⟨B, ⟨g, rfl⟩, hbot_B, hB_sub⟩ :=
        (TopologicalSpace.IsTopologicalBasis.mem_nhds_iff
          PrimeSpectrum.isTopologicalBasis_basic_opens).mp (hU_open.mem_nhds hbot_U)
      have hg_ne : g ≠ 0 := by
        have hmem : (⊥ : PrimeSpectrum (Polynomial F)) ∈ PrimeSpectrum.basicOpen g := hbot_B
        rwa [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.asIdeal_bot, Ideal.mem_bot] at hmem
      let h_poly : Polynomial F := Polynomial.X * g + Polynomial.C 1
      have hh_deg : 0 < h_poly.natDegree := by
        dsimp [h_poly]
        have hX_deg : (Polynomial.X * g).natDegree = g.natDegree + 1 := by
          rw [mul_comm, Polynomial.natDegree_mul_X hg_ne]
        rw [Polynomial.natDegree_add_C, hX_deg]
        omega
      have hh_nonunit : h_poly ∈ nonunits (Polynomial F) :=
        mem_nonunits_iff.mpr (Polynomial.not_isUnit_of_natDegree_pos h_poly hh_deg)
      obtain ⟨m, hm_max, hh_m⟩ := exists_max_ideal_of_mem_nonunits hh_nonunit
      let q_m : PrimeSpectrum (Polynomial F) := ⟨m, hm_max.isPrime⟩
      have hq_B : q_m ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum (Polynomial F))) := by
        change q_m ∈ PrimeSpectrum.basicOpen g
        rw [PrimeSpectrum.mem_basicOpen]
        intro hg_m
        apply hm_max.ne_top
        rw [Ideal.eq_top_iff_one]
        have hXg_m : Polynomial.X * g ∈ m := Ideal.mul_mem_left m Polynomial.X hg_m
        have h1 : (1 : Polynomial F) = h_poly - Polynomial.X * g := by
          dsimp [h_poly]; simp
        rw [h1]
        exact Ideal.sub_mem m hh_m hXg_m
      have hq_W : j₀_aff.base q_m ∈ W := hB_sub hq_B
      refine ⟨⟨j₀_aff.base q_m, hq_W⟩, ?_⟩
      intro heq
      rw [← hgen_j] at heq
      have hinj : Function.Injective j₀_aff.base := j₀_aff.isOpenEmbedding.injective
      have hqm_bot : q_m = (⊥ : PrimeSpectrum (Polynomial F)) := hinj heq
      have hm_bot : m = ⊥ := congrArg PrimeSpectrum.asIdeal hqm_bot
      rw [hm_bot, Ideal.mem_bot] at hh_m
      rw [hh_m, Polynomial.natDegree_zero] at hh_deg
      exact lt_irrefl 0 hh_deg
    let W₀ : X.Opens := j₀_aff.opensRange
    have he_j0 : ⊤ ≤ (TopologicalSpace.Opens.map j₀_aff.base).obj W₀ := fun pt _ => ⟨pt, rfl⟩
    obtain ⟨hW₀_aff, α₀, hNe_W₀_fn, hα₀_hom, _, _⟩ :=
      hOpenImmIso X (Polynomial F) j₀_aff W₀ rfl he_j0
    have _ : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := hNe_W₀_fn inferInstance
    let A₀ := ↑(X.presheaf.obj (Opposite.op W₀))
    let j₀ : A₀ ≃+* Polynomial F := α₀.commRingCatIsoToRingEquiv
    have H_nzd : Submonoid.map j₀.toMonoidHom (nonZeroDivisors A₀) =
        nonZeroDivisors (Polynomial F) := by
      ext p
      rw [Submonoid.mem_map]
      constructor
      · rintro ⟨a, ha, rfl⟩
        rw [mem_nonZeroDivisors_iff_right]
        intro q hq
        have hq' : q * j₀ a = 0 := hq
        have h2 : j₀.symm q * a = 0 :=
          j₀.injective (by rw [map_mul, j₀.apply_symm_apply, hq', map_zero])
        have hsymm0 : j₀.symm q = 0 := mem_nonZeroDivisors_iff_right.mp ha (j₀.symm q) h2
        simpa using congrArg j₀ hsymm0
      · intro hp
        refine ⟨j₀.symm p, ?_, j₀.apply_symm_apply p⟩
        rw [mem_nonZeroDivisors_iff_right]
        intro b hb
        have h1 : j₀ b * p = 0 := by
