    (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
    (μ_S : Quiver.Hom (G_S.obj T_S) T_S)
    (hT_left : ((AlgebraicGeometry.Scheme.Etale.forget S).obj T_S).left = S)
    (hT_hom : HEq ((AlgebraicGeometry.Scheme.Etale.forget S).obj T_S).hom
