          (∑ j : Fin N, (((τ_rep₀ g⁻¹).val i j).val : ℕ) • w j) =
          ∑ i : Fin N, ∑ j : Fin N,
            (((τ_rep₀ g⁻¹).val i j).val : ℕ) • (F_ex.map (N_comp i)).hom (w j) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => map_nsmul _ _ _
      rw [hlhs, hrhs, Finset.sum_comm]

