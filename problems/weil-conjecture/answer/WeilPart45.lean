    (hβ_ρ : ∀ m : ℕ, P.map (ρ m) ≫ βS m = βL m ≫ ρ m)
    (KH : ℕ → ℕ → Type u) [∀ m q, AddCommGroup (KH m q)]
    (α_H : ∀ m q : ℕ, KH m q →+ KH m q)
    (τ_H : ∀ q m : ℕ, KH (m + 1) q →+ KH m q)
    (e_K : ∀ m q : ℕ, KH m q ≃+ CategoryTheory.Abelian.Ext X (J m) q)
    (he_K_τ : ∀ (m q : ℕ) (x : KH (m + 1) q),
      e_K m q (τ_H q m x) =
        ((CategoryTheory.Abelian.Ext.mk₀ (τJ m)).postcomp X (Nat.add_zero q))
          (e_K (m + 1) q x))
    (he_K_α : ∀ (m q : ℕ) (x : KH m q),
      e_K m q (α_H m q x) =
        ((CategoryTheory.Abelian.Ext.mk₀ (βJ m)).postcomp X (Nat.add_zero q))
          ((CategoryTheory.Abelian.Ext.mk₀ αX).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P hAdd hLim hColim _ _ X (J m) q)
