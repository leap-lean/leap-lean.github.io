    hLatJ
    ⟨hTor_map C₀ (hTor_J_sh s), hTor_map C₁ (hTor_J_sh s), hTor_map C₂ (hTor_J_sh s)⟩
    hdIG
    ⟨hqG₀_surj, hqG₁_surj, hqG₂_surj,
     fun v => by
       dsimp [qG₀, qG₁, dIG₀, dK₀]
       rw [AddMonoidHom.finsetSum_apply, map_sum, AddMonoidHom.finsetSum_apply]
       refine Finset.sum_congr rfl fun j _ => ?_
       have h := congrArg (fun f => f.hom (v j)) (d₀.naturality (N_comp j))
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply] using h,
     fun v => by
       dsimp [qG₁, qG₂, dIG₁, dK₁]
       rw [AddMonoidHom.finsetSum_apply, map_sum, AddMonoidHom.finsetSum_apply]
       refine Finset.sum_congr rfl fun j _ => ?_
       have h := congrArg (fun f => f.hom (v j)) (d₁.naturality (N_comp j))
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply] using h,
     fun v => by
       dsimp [qG₀, ψG₀, ΦK₀]
       rw [AddMonoidHom.finsetSum_apply, map_sum, AddMonoidHom.finsetSum_apply]
       refine Finset.sum_congr rfl fun j _ => ?_
       have h := congrArg (fun f => f.hom (v j))
         ((hΦ_nat (N_comp j) (β_K 1 m) (β_J s) (hN_β_comm j)).1).symm
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply] using h,
     fun v => by
       dsimp [qG₁, ψG₁, ΦK₁]
       rw [AddMonoidHom.finsetSum_apply, map_sum, AddMonoidHom.finsetSum_apply]
       refine Finset.sum_congr rfl fun j _ => ?_
       have h := congrArg (fun f => f.hom (v j))
         ((hΦ_nat (N_comp j) (β_K 1 m) (β_J s) (hN_β_comm j)).2.1).symm
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply] using h,
     fun v => by
       dsimp [qG₂, ψG₂, ΦK₂]
       rw [AddMonoidHom.finsetSum_apply, map_sum, AddMonoidHom.finsetSum_apply]
       refine Finset.sum_congr rfl fun j _ => ?_
       have h := congrArg (fun f => f.hom (v j))
         ((hΦ_nat (N_comp j) (β_K 1 m) (β_J s) (hN_β_comm j)).2.2).symm
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply] using h,
     hqG₀_ker, hqG₁_ker, hqG₂_ker⟩
    ⟨(hπJ₀ s hsK).1, (hπJ₁ s hsK).1, (hπJ₂ s hsK).1,
     (hπJ₀ s hsK).2, (hπJ₁ s hsK).2, (hπJ₂ s hsK).2,
     fun x => by
       have h := congrArg (fun f => f.hom x) (d₀.naturality (τ_J_sh_le s m hs_le))
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] using h,
     fun x => by
       have h := congrArg (fun f => f.hom x) (d₁.naturality (τ_J_sh_le s m hs_le))
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] using h,
     fun x => by
       have h := congrArg (fun f => f.hom x)
         ((hΦ_nat (τ_J_sh_le s m hs_le) (β_J m) (β_J s) (hβJ_comm s m hs_le)).1).symm
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] using h,
     fun x => by
       have h := congrArg (fun f => f.hom x)
         ((hΦ_nat (τ_J_sh_le s m hs_le) (β_J m) (β_J s) (hβJ_comm s m hs_le)).2.1).symm
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] using h,
     fun x => by
       have h := congrArg (fun f => f.hom x)
         ((hΦ_nat (τ_J_sh_le s m hs_le) (β_J m) (β_J s) (hβJ_comm s m hs_le)).2.2).symm
       simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] using h⟩

theorem weil_curve_tr_open_base_sheets_and_bdry_sections (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (B₀ L₀ : Type u)
    [CommRing B₀] [IsDomain B₀] [Field L₀]
    [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra F L₀] [Algebra (Polynomial F) L₀] [Algebra (RatFunc F) L₀]
    [Algebra B₀ L₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsScalarTower F (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) B₀ L₀]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀ L₀]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsFractionRing B₀ L₀]
    [IsIntegralClosure B₀
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [FiniteDimensional (RatFunc F) L₀]
    [IsGalois (RatFunc F) L₀]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (r : ℕ)
    (σ : B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀)
    (ι_bar : Quiver.Hom (weilGeomScheme F (weilCurveTrGeomCoverOver F B₀))
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)))
    (hι_fst : CategoryTheory.CategoryStruct.comp ι_bar
        (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst (weilCurveTrGeomCoverOver F B₀).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap
                (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
                B₀)))
            e_U.hom)
          U₀.ι))
    (hι_snd : CategoryTheory.CategoryStruct.comp ι_bar
        (CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) =
      CategoryTheory.Limits.pullback.snd (weilCurveTrGeomCoverOver F B₀).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let k := AlgebraicClosure F
    let D_ov := weilProjectiveSpaceOver F 1
    let D_bar_ov := weilBaseChangeOver F k D_ov
    let D_bar := weilGeomScheme F D_ov
    let V_ov := weilCurveTrGeomCoverOver F B₀
    let V_bar := weilGeomScheme F V_ov
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let pr_D : Quiver.Hom D_bar D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
    let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
    let α_σ : Quiver.Hom V_bar V_bar :=
      CategoryTheory.CategoryStruct.comp
        (weilSchemeEndPow (weilGeomFrobHom F V_ov) r)
        (weilCurveTrGeomDeckHom F R₀ B₀ σ⁻¹)
    let g_D_r : Quiver.Hom D_bar D_bar := weilSchemeEndPow (weilGeomFrobHom F D_ov) r
    ∃ (m_bdry m_sheet : ℕ)
      (g_Dr_iso : CategoryTheory.Iso D_bar D_bar)
      (π_bar : Quiver.Hom V_bar U_bar.toScheme)
      (s_bdry : Fin m_bdry → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) D_bar),
      1 ≤ m_sheet ∧
      g_Dr_iso.hom = g_D_r ∧
      CategoryTheory.CategoryStruct.comp α_σ ι_bar =
        CategoryTheory.CategoryStruct.comp ι_bar g_D_r ∧
      CategoryTheory.CategoryStruct.comp π_bar U_bar.ι = ι_bar ∧
      AlgebraicGeometry.Etale π_bar ∧
      AlgebraicGeometry.Surjective π_bar ∧
      (∀ (Y_s : AlgebraicGeometry.Scheme.{u}) (g_Y : Quiver.Hom Y_s V_bar),
        let Y_V := CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.comp g_Y π_bar) π_bar
        ∃ δ : Fin m_sheet → Quiver.Hom Y_s Y_V,
          (∀ i : Fin m_sheet,
            CategoryTheory.CategoryStruct.comp (δ i)
              (CategoryTheory.Limits.pullback.fst (CategoryTheory.CategoryStruct.comp g_Y π_bar) π_bar) =
              CategoryTheory.CategoryStruct.id Y_s ∧
            AlgebraicGeometry.Etale (δ i) ∧
            IsOpen (Set.range (δ i).base)) ∧
          (∀ i j : Fin m_sheet, i ≠ j → Disjoint (Set.range (δ i).base) (Set.range (δ j).base)) ∧
          (⋃ i : Fin m_sheet, Set.range (δ i).base) = Set.univ) ∧
      (∀ t : Fin m_bdry,
        CategoryTheory.CategoryStruct.comp (s_bdry t) D_bar_ov.hom =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
        AlgebraicGeometry.IsClosedImmersion (s_bdry t)) ∧
      ((U_bar : Set ↥D_bar)ᶜ = ⋃ t : Fin m_bdry, Set.range (s_bdry t).base) :=
by
  classical
  intro R₀ k D_ov D_bar_ov D_bar V_ov V_bar f₂ pr_D U_bar α_σ g_D_r
  let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  let P_Surj : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Surjective.{u}
  let P_Sep : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.IsSeparated.{u}

  have hRange_of_isPullback : ∀ {W X Y Z : AlgebraicGeometry.Scheme.{u}}
      {f : W ⟶ X} {g : W ⟶ Y} {u : X ⟶ Z} {v : Y ⟶ Z},
      CategoryTheory.IsPullback f g u v →
      Set.range f.base = u.base ⁻¹' Set.range v.base := by
    intro W X Y Z f g u v hpb
    have hfac := hpb.isoPullback_hom_fst
    have hsurj : Function.Surjective hpb.isoPullback.hom.base := fun z =>
      ⟨hpb.isoPullback.inv.base z, by
        change (hpb.isoPullback.inv ≫ hpb.isoPullback.hom).base z = z
        rw [hpb.isoPullback.inv_hom_id]
        rfl⟩
    have hr : Set.range f.base = Set.range (CategoryTheory.Limits.pullback.fst u v).base := by
      rw [← hfac]
      exact hsurj.range_comp (CategoryTheory.Limits.pullback.fst u v).base
    rw [hr, AlgebraicGeometry.Scheme.Pullback.range_fst]

  
  
  
  let P_S : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  let K := RatFunc F
  have hPS_monic : P_S.Monic :=
    Polynomial.monic_prod_of_monic S_aff _ (fun s _ => Polynomial.monic_X_sub_C s)
  have hPS_ne : P_S ≠ 0 := hPS_monic.ne_zero
  have hSub_nzd : Submonoid.powers P_S ≤ nonZeroDivisors (Polynomial F) := by
    rw [Submonoid.powers_le]
    exact mem_nonZeroDivisors_of_ne_zero hPS_ne
  letI : IsDomain R₀ := IsLocalization.isDomain_localization hSub_nzd
  have hPS_K_ne : algebraMap (Polynomial F) K P_S ≠ 0 := fun h0 =>
    hPS_ne (IsFractionRing.injective (Polynomial F) K (h0.trans (map_zero _).symm))
  have hPS_K_unit : IsUnit (algebraMap (Polynomial F) K P_S) := hPS_K_ne.isUnit
  letI : Algebra R₀ K := (IsLocalization.Away.lift P_S hPS_K_unit).toAlgebra
  haveI : IsScalarTower (Polynomial F) R₀ K :=
    IsScalarTower.of_algebraMap_eq fun p =>
      (IsLocalization.Away.lift_eq P_S hPS_K_unit p).symm
  haveI : IsFractionRing R₀ K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers P_S) R₀ K
  haveI : IsScalarTower R₀ K L₀ := by
    have hcomp : (algebraMap K L₀).comp (algebraMap R₀ K) = algebraMap R₀ L₀ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers P_S)
      apply RingHom.ext
      intro p
      simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ K,
        ← IsScalarTower.algebraMap_apply (Polynomial F) K L₀]
      rw [IsScalarTower.algebraMap_apply R₀ B₀ L₀,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₀,
        ← IsScalarTower.algebraMap_apply (Polynomial F) B₀ L₀]
    exact IsScalarTower.of_algebraMap_eq fun r_el => (RingHom.congr_fun hcomp r_el).symm

  have hInj_RB : Function.Injective (algebraMap R₀ B₀) := by
    intro r₁ r₂ heq
    have hL : algebraMap R₀ L₀ r₁ = algebraMap R₀ L₀ r₂ := by
      rw [IsScalarTower.algebraMap_apply R₀ B₀ L₀, heq,
        ← IsScalarTower.algebraMap_apply R₀ B₀ L₀]
    rw [IsScalarTower.algebraMap_apply R₀ K L₀, IsScalarTower.algebraMap_apply R₀ K L₀] at hL
    exact IsFractionRing.injective R₀ K ((algebraMap K L₀).injective hL)

  letI : IsIntegralClosure ↥(integralClosure R₀ L₀) R₀ L₀ :=
    integralClosure.isIntegralClosure R₀ L₀
  let e_ic : B₀ ≃ₐ[R₀] ↥(integralClosure R₀ L₀) :=
    IsIntegralClosure.equiv R₀ B₀ L₀ ↥(integralClosure R₀ L₀)
  let extAut : (B₀ ≃ₐ[R₀] B₀) → (L₀ ≃ₐ[K] L₀) :=
    fun τ => IsFractionRing.fieldEquivOfAlgEquiv K L₀ L₀ τ
  let resAut : (L₀ ≃ₐ[K] L₀) → (B₀ ≃ₐ[R₀] B₀) :=
    fun ψ => e_ic.trans (((ψ.restrictScalars R₀).mapIntegralClosure).trans e_ic.symm)
  have hresAut_apply : ∀ (ψ : L₀ ≃ₐ[K] L₀) (b : B₀),
      algebraMap B₀ L₀ (resAut ψ b) = ψ (algebraMap B₀ L₀ b) := by
    intro ψ b
    dsimp [resAut]
    have h1 := IsIntegralClosure.algebraMap_equiv R₀ ↥(integralClosure R₀ L₀) L₀ B₀
      ((ψ.restrictScalars R₀).mapIntegralClosure (e_ic b))
    have h_symm : IsIntegralClosure.equiv R₀ ↥(integralClosure R₀ L₀) L₀ B₀ = e_ic.symm := by
      ext x
      apply IsFractionRing.injective B₀ L₀
      rw [IsIntegralClosure.algebraMap_equiv]
      have h2 := IsIntegralClosure.algebraMap_equiv R₀ B₀ L₀ ↥(integralClosure R₀ L₀) (e_ic.symm x)
      rw [e_ic.apply_symm_apply] at h2
      exact h2
    rw [← h_symm, h1]
    change ↑((ψ.restrictScalars R₀).mapIntegralClosure (e_ic b)) = ψ (algebraMap B₀ L₀ b)
    rw [AlgEquiv.coe_mapIntegralClosure]
    change ψ (algebraMap ↥(integralClosure R₀ L₀) L₀ (e_ic b)) = ψ (algebraMap B₀ L₀ b)
    rw [IsIntegralClosure.algebraMap_equiv]

  let equiv_aut : (B₀ ≃ₐ[R₀] B₀) ≃ (L₀ ≃ₐ[K] L₀) :=
    { toFun := extAut
      invFun := resAut
      left_inv := fun τ => by
        ext b
        apply IsFractionRing.injective B₀ L₀
        rw [hresAut_apply]
        exact IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L₀ L₀ τ b
      right_inv := fun ψ => by
        apply AlgEquiv.ext
        have hEq : (extAut (resAut ψ)).toRingHom = ψ.toRingHom := by
          apply IsLocalization.ringHom_ext (nonZeroDivisors B₀)
          apply RingHom.ext
          intro b
          change extAut (resAut ψ) (algebraMap B₀ L₀ b) = ψ (algebraMap B₀ L₀ b)
          rw [IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L₀ L₀ (resAut ψ) b,
            hresAut_apply]
        intro x
        exact RingHom.congr_fun hEq x }

  letI : Fintype (L₀ ≃ₐ[K] L₀) := AlgEquiv.fintype K L₀
  let m_sheet : ℕ := Fintype.card (L₀ ≃ₐ[K] L₀)
  have hm_eq_finrank : m_sheet = Module.finrank K L₀ := by
    dsimp [m_sheet]
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank K L₀]
  have hm_sheet : 1 ≤ m_sheet := by
    rw [hm_eq_finrank]
    exact Module.finrank_pos
  let equiv_Γ : Fin m_sheet ≃ (B₀ ≃ₐ[R₀] B₀) :=
    (Fintype.equivFin (L₀ ≃ₐ[K] L₀)).symm.trans equiv_aut.symm

  
  
  
  let A_tp := TensorProduct R₀ B₀ B₀
  let μ : (B₀ ≃ₐ[R₀] B₀) → A_tp →ₐ[B₀] B₀ :=
    fun τ => Algebra.TensorProduct.lift (AlgHom.id B₀ B₀) τ.symm.toAlgHom
      (fun _ _ => Commute.all _ _)
  have hμ_surj : ∀ τ : B₀ ≃ₐ[R₀] B₀, Function.Surjective (μ τ) := fun τ b =>
    ⟨TensorProduct.tmul R₀ b 1, by
      dsimp [μ]
      rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one]⟩

  have hKer_idemp : ∀ τ : B₀ ≃ₐ[R₀] B₀,
      ((μ τ).toRingHom).Etale ∧
      ∃ f : A_tp, f * f = f ∧ RingHom.ker (μ τ).toRingHom = Ideal.span {f} := by
    intro τ
    have hFG : (RingHom.ker (μ τ).toRingHom).FG :=
      Algebra.FinitePresentation.ker_fG_of_surjective (μ τ) (hμ_surj τ)
    let algAB₀ : Algebra A_tp B₀ := (μ τ).toRingHom.toAlgebra
    letI : Algebra A_tp B₀ := algAB₀
    have hST : @IsScalarTower B₀ A_tp B₀ _ algAB₀.toSMul _ :=
      @IsScalarTower.of_algebraMap_eq B₀ A_tp B₀ _ _ _ _ algAB₀ _ fun b =>
        ((μ τ).commutes b).symm
    letI : IsScalarTower B₀ A_tp B₀ := hST
    have hEtA : @Algebra.Etale A_tp B₀ _ _ algAB₀ :=
      Algebra.Etale.of_restrictScalars B₀ A_tp B₀
    letI : Algebra.Etale A_tp B₀ := hEtA
    have hEt_rh : ((μ τ).toRingHom).Etale :=
      (@RingHom.etale_algebraMap A_tp B₀ _ _ algAB₀).mpr hEtA
    have hIdempI : IsIdempotentElem (RingHom.ker (μ τ).toRingHom) :=
      (@Algebra.FormallyEtale.iff_of_surjective A_tp B₀ _ _ algAB₀ (hμ_surj τ)).mp inferInstance
    obtain ⟨f, hf_idem, hspan⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hIdempI
    exact ⟨hEt_rh, f, hf_idem, hspan⟩

  let f_ker : Fin m_sheet → A_tp := fun i =>
    Classical.choose (hKer_idemp (equiv_Γ i)).2
  have hf_spec : ∀ i : Fin m_sheet,
      f_ker i * f_ker i = f_ker i ∧
      RingHom.ker (μ (equiv_Γ i)).toRingHom = Ideal.span {f_ker i} :=
    fun i => Classical.choose_spec (hKer_idemp (equiv_Γ i)).2
  let e_id : Fin m_sheet → A_tp := fun i => 1 - f_ker i

  have he_idem : ∀ i : Fin m_sheet, e_id i * e_id i = e_id i := by
    intro i
    dsimp [e_id]
    calc
      (1 - f_ker i) * (1 - f_ker i) = 1 - 2 * f_ker i + f_ker i * f_ker i := by ring
      _ = 1 - 2 * f_ker i + f_ker i := by rw [(hf_spec i).1]
      _ = 1 - f_ker i := by ring

  have hf_mul_e : ∀ i : Fin m_sheet, f_ker i * e_id i = 0 := by
    intro i
    dsimp [e_id]
    rw [mul_sub, mul_one, (hf_spec i).1, sub_self]

  have he_absorb : ∀ (i : Fin m_sheet) (z : A_tp),
      z * e_id i = TensorProduct.tmul R₀ (μ (equiv_Γ i) z) 1 * e_id i := by
    intro i z
    have hmem : z - TensorProduct.tmul R₀ (μ (equiv_Γ i) z) 1 ∈
        RingHom.ker (μ (equiv_Γ i)).toRingHom := by
      rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub]
      dsimp [μ]
      rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one, sub_self]
    rw [(hf_spec i).2, Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨q, hq⟩
    have hzero : (z - TensorProduct.tmul R₀ (μ (equiv_Γ i) z) 1) * e_id i = 0 := by
      rw [hq, mul_right_comm, hf_mul_e i, zero_mul]
    rwa [sub_mul, sub_eq_zero] at hzero

  have he_eval : ∀ i j : Fin m_sheet,
      μ (equiv_Γ j) (e_id i) = if i = j then 1 else 0 := by
    intro i j
    split_ifs with hij
    · subst hij
      have hf0 : μ (equiv_Γ i) (f_ker i) = 0 := by
        have hm : f_ker i ∈ RingHom.ker (μ (equiv_Γ i)).toRingHom := by
          rw [(hf_spec i).2]
          exact Ideal.mem_span_singleton_self _
        exact hm
      dsimp [e_id]
      rw [map_sub, map_one, hf0, sub_zero]
    · have hne_aut : equiv_Γ i ≠ equiv_Γ j := equiv_Γ.injective.ne hij
      have hne_symm : (equiv_Γ i).symm ≠ (equiv_Γ j).symm := fun hs =>
        hne_aut (AlgEquiv.ext fun b => by
          have h1 := congrArg (equiv_Γ j) (AlgEquiv.congr_fun hs ((equiv_Γ i) b))
          rw [AlgEquiv.symm_apply_apply, AlgEquiv.apply_symm_apply] at h1
          exact h1.symm)
      have hex_b : ∃ b : B₀, (equiv_Γ i).symm b ≠ (equiv_Γ j).symm b := by
        by_contra h_all
        exact hne_symm (AlgEquiv.ext fun b => Classical.not_not.mp fun hne => h_all ⟨b, hne⟩)
      rcases hex_b with ⟨b, hb⟩
      have habs := he_absorb i (TensorProduct.tmul R₀ 1 b)
      have hμ1 : μ (equiv_Γ i) (TensorProduct.tmul R₀ 1 b) = (equiv_Γ i).symm b := by
        dsimp [μ]
        rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, one_mul]
        rfl
      rw [hμ1] at habs
      have happ := congrArg (μ (equiv_Γ j)) habs
      rw [map_mul, map_mul] at happ
      have hL_eval : μ (equiv_Γ j) (TensorProduct.tmul R₀ 1 b) = (equiv_Γ j).symm b := by
        dsimp [μ]
        rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, one_mul]
        rfl
      have hR_eval : μ (equiv_Γ j) (TensorProduct.tmul R₀ ((equiv_Γ i).symm b) 1) =
          (equiv_Γ i).symm b := by
        dsimp [μ]
        rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one]
      rw [hL_eval, hR_eval] at happ
      have hmul0 : ((equiv_Γ j).symm b - (equiv_Γ i).symm b) * μ (equiv_Γ j) (e_id i) = 0 := by
        rw [sub_mul, happ, sub_self]
      exact (mul_eq_zero.mp hmul0).resolve_left (sub_ne_zero.mpr hb.symm)

  have he_orth : ∀ i j : Fin m_sheet, i ≠ j → e_id i * e_id j = 0 := by
    intro i j hij
    rw [he_absorb j (e_id i), he_eval i j]
    simp only [hij, ↓reduceIte, TensorProduct.zero_tmul, zero_mul]

  have he_sum : (∑ i : Fin m_sheet, e_id i) = 1 := by
    haveI : Module.Flat R₀ B₀ := Algebra.Smooth.flat R₀ B₀
    haveI : Module.Flat R₀ K := IsLocalization.flat K (nonZeroDivisors R₀)
    haveI : Module.Flat R₀ L₀ := Module.Flat.trans R₀ K L₀
    let ι_BL_lin : B₀ →ₗ[R₀] L₀ := (IsScalarTower.toAlgHom R₀ B₀ L₀).toLinearMap
    have hι_BL_inj : Function.Injective ι_BL_lin := IsFractionRing.injective B₀ L₀
    have hmap_inj : Function.Injective (TensorProduct.map ι_BL_lin ι_BL_lin) :=
      TensorProduct.map_injective_of_flat_flat ι_BL_lin ι_BL_lin hι_BL_inj hι_BL_inj
    let T_RL := TensorProduct R₀ L₀ L₀
    let T_KL := TensorProduct K L₀ L₀
    let φ_RL_KL : T_RL →ₐ[R₀] T_KL :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := K) (S := K) (A := L₀) (B := L₀)).restrictScalars R₀)
        ((Algebra.TensorProduct.includeRight (R := K) (A := L₀) (B := L₀)).restrictScalars R₀)
        (fun _ _ => Commute.all _ _)
    have hφ_inj : Function.Injective φ_RL_KL := by
      have hcomm_K : (Algebra.TensorProduct.includeRight (R := R₀) (A := L₀) (B := L₀)).toRingHom.comp
          (algebraMap K L₀) =
          Algebra.TensorProduct.includeLeftRingHom.comp (algebraMap K L₀) := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R₀)
        ext r_el
        simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply R₀ K L₀,
          Algebra.TensorProduct.includeLeftRingHom_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
        calc
          (1 : L₀) ⊗ₜ[R₀] algebraMap R₀ L₀ r_el = (1 : L₀) ⊗ₜ[R₀] (r_el • (1 : L₀)) := by
            rw [Algebra.smul_def, mul_one]
          _ = (r_el • (1 : L₀)) ⊗ₜ[R₀] (1 : L₀) :=
            (TensorProduct.smul_tmul r_el (1 : L₀) (1 : L₀)).symm
          _ = algebraMap R₀ L₀ r_el ⊗ₜ[R₀] (1 : L₀) := by rw [Algebra.smul_def, mul_one]
      let j₁ : L₀ →ₐ[K] T_RL :=
        Algebra.TensorProduct.includeLeft (R := R₀) (S := K) (A := L₀) (B := L₀)
      let j₂ : L₀ →ₐ[K] T_RL :=
        { toRingHom := (Algebra.TensorProduct.includeRight (R := R₀) (A := L₀) (B := L₀)).toRingHom
          commutes' := fun c =>
            (RingHom.congr_fun hcomm_K c).trans
              (Algebra.TensorProduct.algebraMap_apply (R := R₀) (S := K) (A := L₀) (B := L₀) c).symm }
      let ψ_alg : T_KL →ₐ[K] T_RL :=
        Algebra.TensorProduct.lift j₁ j₂ (fun _ _ => Commute.all _ _)
      let ψ_KL_RL : T_KL →+* T_RL := ψ_alg.toRingHom
      have hleft : ∀ z : T_RL, ψ_KL_RL (φ_RL_KL z) = z := by
        have hlin : ((AlgHom.mk ψ_KL_RL (fun r_el => by
            change ψ_alg (algebraMap R₀ T_KL r_el) = algebraMap R₀ T_RL r_el
            have hr : algebraMap R₀ T_KL r_el = TensorProduct.tmul K (algebraMap R₀ L₀ r_el) 1 := by
              rw [IsScalarTower.algebraMap_apply R₀ K T_KL,
                Algebra.TensorProduct.algebraMap_apply, IsScalarTower.algebraMap_apply R₀ K L₀]
            rw [hr]
            dsimp [ψ_alg]
            rw [Algebra.TensorProduct.lift_tmul]
            change (algebraMap R₀ L₀ r_el ⊗ₜ[R₀] (1 : L₀)) * ((1 : L₀) ⊗ₜ[R₀] (1 : L₀)) = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one]
            exact (Algebra.TensorProduct.algebraMap_apply
              (R := R₀) (S := R₀) (A := L₀) (B := L₀) r_el).symm)).comp φ_RL_KL).toLinearMap =
            LinearMap.id := by
          apply TensorProduct.ext'
          intro x y
          simp only [AlgHom.toLinearMap_apply, AlgHom.comp_apply, LinearMap.id_apply]
          change ψ_alg (φ_RL_KL (x ⊗ₜ[R₀] y)) = x ⊗ₜ[R₀] y
          dsimp [φ_RL_KL, ψ_alg]
          rw [Algebra.TensorProduct.lift_tmul]
          change (Algebra.TensorProduct.lift j₁ j₂ (fun _ _ => Commute.all _ _))
            (((x : L₀) ⊗ₜ[K] (1 : L₀)) * ((1 : L₀) ⊗ₜ[K] (y : L₀))) = x ⊗ₜ[R₀] y
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
            Algebra.TensorProduct.lift_tmul]
          change (x ⊗ₜ[R₀] (1 : L₀)) * ((1 : L₀) ⊗ₜ[R₀] y) = x ⊗ₜ[R₀] y
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        intro z
        exact LinearMap.congr_fun hlin z
      exact Function.LeftInverse.injective hleft
    let ι_AK : A_tp →ₐ[R₀] T_KL :=
      φ_RL_KL.comp (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₀ B₀ L₀)
        (IsScalarTower.toAlgHom R₀ B₀ L₀))
    have hι_AK_eq : ι_AK.toLinearMap = φ_RL_KL.toLinearMap.comp
        (TensorProduct.map ι_BL_lin ι_BL_lin) := by
      apply TensorProduct.ext'
      intro b₁ b₂
      rfl
    have hι_AK_inj : Function.Injective ι_AK := by
      change Function.Injective ι_AK.toLinearMap
      rw [hι_AK_eq]
      exact hφ_inj.comp hmap_inj
    let μ_L : Fin m_sheet → T_KL →ₐ[L₀] L₀ := fun j =>
      Algebra.TensorProduct.lift (AlgHom.id L₀ L₀) (equiv_aut (equiv_Γ j)).symm.toAlgHom
        (fun _ _ => Commute.all _ _)
    have hμ_compat : ∀ (j : Fin m_sheet) (z : A_tp),
        μ_L j (ι_AK z) = algebraMap B₀ L₀ (μ (equiv_Γ j) z) := by
      intro j
      have hlin : ((μ_L j).restrictScalars R₀).toLinearMap.comp ι_AK.toLinearMap =
          ι_BL_lin.comp ((μ (equiv_Γ j)).restrictScalars R₀).toLinearMap := by
        apply TensorProduct.ext'
        intro b₁ b₂
        simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.coe_restrictScalars']
        dsimp [ι_AK, φ_RL_KL, μ, ι_BL_lin]
        rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.lift_tmul]
        change μ_L j ((algebraMap B₀ L₀ b₁ ⊗ₜ[K] 1) * (1 ⊗ₜ[K] algebraMap B₀ L₀ b₂)) =
          algebraMap B₀ L₀ (b₁ * (equiv_Γ j).symm b₂)
        dsimp [μ_L]
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
          Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_mul]
        congr 1
        have hsymm := IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L₀ L₀ (equiv_Γ j)
          ((equiv_Γ j).symm b₂)
        rw [(equiv_Γ j).apply_symm_apply] at hsymm
        dsimp [equiv_aut, extAut]
        have h2 := congrArg (IsFractionRing.fieldEquivOfAlgEquiv K L₀ L₀ (equiv_Γ j)).symm hsymm
        rw [AlgEquiv.symm_apply_apply] at h2
        exact h2.symm
      intro z
      exact LinearMap.congr_fun hlin z
    let e_L : Fin m_sheet → T_KL := fun i => ι_AK (e_id i)
    let Ψ : (Fin m_sheet → L₀) →ₗ[L₀] T_KL :=
      { toFun := fun c => ∑ i : Fin m_sheet, c i • e_L i
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun x c => by
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
    have hΨ_inj : Function.Injective Ψ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro c hc
      ext j
      have happ : (μ_L j).toLinearMap (∑ x : Fin m_sheet, c x • e_L x) = 0 := by
        change (μ_L j).toLinearMap (Ψ c) = 0
        rw [hc, map_zero]
      rw [map_sum] at happ
      have hsum : (∑ x : Fin m_sheet, (μ_L j).toLinearMap (c x • e_L x)) = c j := by
        calc
          (∑ x : Fin m_sheet, (μ_L j).toLinearMap (c x • e_L x)) =
              ∑ x : Fin m_sheet, if x = j then c x else 0 := by
            refine Finset.sum_congr rfl fun x _ => ?_
            rw [LinearMap.map_smul]
            dsimp [e_L]
            rw [hμ_compat j (e_id x), he_eval x j]
            split_ifs <;> simp
          _ = c j := by simp
      exact hsum.symm.trans happ
    have hfin_eq : Module.finrank L₀ (Fin m_sheet → L₀) = Module.finrank L₀ T_KL := by
      rw [Module.finrank_pi, Fintype.card_fin]
      have htp := Module.finrank_tensorProduct (R := L₀) (S := K) (M := L₀) (M' := L₀)
      rw [htp, Module.finrank_self, one_mul, hm_eq_finrank]
    have hΨ_surj : Function.Surjective Ψ :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin_eq).mp hΨ_inj
    obtain ⟨c, hc⟩ := hΨ_surj 1
    apply hι_AK_inj
    rw [map_sum, map_one]
    change (∑ j : Fin m_sheet, e_L j) = 1
    calc
      (∑ j : Fin m_sheet, e_L j) = 1 * (∑ j : Fin m_sheet, e_L j) := (one_mul _).symm
      _ = (∑ i : Fin m_sheet, c i • e_L i) * (∑ j : Fin m_sheet, e_L j) := by rw [← hc]; rfl
      _ = ∑ i : Fin m_sheet, ∑ j : Fin m_sheet, (c i • e_L i) * e_L j := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Finset.mul_sum]
      _ = ∑ i : Fin m_sheet, c i • e_L i := by
          refine Finset.sum_congr rfl fun i _ => ?_
          have hinner : (∑ j : Fin m_sheet, (c i • e_L i) * e_L j) =
              ∑ j : Fin m_sheet, if j = i then c i • e_L i else 0 := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [smul_mul_assoc]
            dsimp [e_L]
            rw [← map_mul]
            by_cases hji : j = i
            · subst hji
              rw [he_idem j]
              simp only [↓reduceIte]
            · rw [he_orth i j (Ne.symm hji), map_zero, smul_zero]
              simp only [hji, ↓reduceIte]
          rw [hinner]
          simp
      _ = 1 := hc

  
  
  
  let ψ_frob := (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _).symm
  let i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_frob.toRingHom)
  let i₂_inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_frob.symm.toRingHom)
  have hi₂_comp : i₂ ≫ i₂_inv = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    have heq : CommRingCat.ofHom ψ_frob.symm.toRingHom ≫ CommRingCat.ofHom ψ_frob.toRingHom =
        𝟙 (CommRingCat.of k) := by
      ext x
      change ψ_frob (ψ_frob.symm x) = x
      exact ψ_frob.apply_symm_apply x
    exact (AlgebraicGeometry.Spec.map_comp
      (CommRingCat.ofHom ψ_frob.symm.toRingHom)
      (CommRingCat.ofHom ψ_frob.toRingHom)).symm.trans
      ((congrArg AlgebraicGeometry.Spec.map heq).trans
        (AlgebraicGeometry.Spec.map_id (CommRingCat.of k)))
  have hi₂_inv_comp : i₂_inv ≫ i₂ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    have heq : CommRingCat.ofHom ψ_frob.toRingHom ≫ CommRingCat.ofHom ψ_frob.symm.toRingHom =
        𝟙 (CommRingCat.of k) := by
      ext x
      change ψ_frob.symm (ψ_frob x) = x
      exact ψ_frob.symm_apply_apply x
    exact (AlgebraicGeometry.Spec.map_comp
      (CommRingCat.ofHom ψ_frob.toRingHom)
      (CommRingCat.ofHom ψ_frob.symm.toRingHom)).symm.trans
      ((congrArg AlgebraicGeometry.Spec.map heq).trans
        (AlgebraicGeometry.Spec.map_id (CommRingCat.of k)))
  have hf₂_inv : f₂ ≫ 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) = i₂_inv ≫ f₂ := by
    have heq : CommRingCat.ofHom (algebraMap F k) ≫ CommRingCat.ofHom ψ_frob.symm.toRingHom =
        CommRingCat.ofHom (algebraMap F k) := by
      ext c
      change ψ_frob.symm (algebraMap F k c) = algebraMap F k c
      exact ψ_frob.symm.commutes c
    exact (CategoryTheory.Category.comp_id f₂).trans
      ((congrArg AlgebraicGeometry.Spec.map heq.symm).trans
        (AlgebraicGeometry.Spec.map_comp
          (CommRingCat.ofHom (algebraMap F k))
          (CommRingCat.ofHom ψ_frob.symm.toRingHom)))
  let g_D_inv : D_bar ⟶ D_bar :=
    CategoryTheory.Limits.pullback.map D_ov.hom f₂ D_ov.hom f₂
      (𝟙 D_ov.left) i₂_inv (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
      ((CategoryTheory.Category.comp_id D_ov.hom).trans (CategoryTheory.Category.id_comp D_ov.hom).symm)
      hf₂_inv

  let snd_D : D_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    CategoryTheory.Limits.pullback.snd D_ov.hom f₂
  have hgD_fst : weilGeomFrobHom F D_ov ≫ pr_D = pr_D :=
    (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id pr_D)
  have hgD_snd : weilGeomFrobHom F D_ov ≫ snd_D = snd_D ≫ i₂ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hgDinv_fst : g_D_inv ≫ pr_D = pr_D :=
    (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id pr_D)
  have hgDinv_snd : g_D_inv ≫ snd_D = snd_D ≫ i₂_inv :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  let g_D1_iso : CategoryTheory.Iso D_bar D_bar :=
    { hom := weilGeomFrobHom F D_ov
      inv := g_D_inv
      hom_inv_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc _ _ pr_D).trans
            ((congrArg (weilGeomFrobHom F D_ov ≫ ·) hgDinv_fst).trans
              (hgD_fst.trans (CategoryTheory.Category.id_comp pr_D).symm))
        · exact (CategoryTheory.Category.assoc _ _ snd_D).trans
            ((congrArg (weilGeomFrobHom F D_ov ≫ ·) hgDinv_snd).trans
              ((CategoryTheory.Category.assoc _ snd_D i₂_inv).symm.trans
                ((congrArg (· ≫ i₂_inv) hgD_snd).trans
