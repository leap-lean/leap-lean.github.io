        Function.Surjective (C₀.map π).hom ∧
        Function.Surjective (C₁.map π).hom ∧
        Function.Surjective (C₂.map π).hom) ∧
      (∀ ℱ : 𝒜, CategoryTheory.CategoryStruct.comp (d₀.app ℱ) (d₁.app ℱ) = 0) ∧
      (∀ (ℱ : 𝒜) (β : Quiver.Hom (P_S.obj ℱ) ℱ),
        CategoryTheory.CategoryStruct.comp (Φ₀ β) (d₀.app ℱ) =
          CategoryTheory.CategoryStruct.comp (d₀.app ℱ) (Φ₁ β) ∧
        CategoryTheory.CategoryStruct.comp (Φ₁ β) (d₁.app ℱ) =
          CategoryTheory.CategoryStruct.comp (d₁.app ℱ) (Φ₂ β)) ∧
      (∀ (ℱ : 𝒜) (β : Quiver.Hom (P_S.obj ℱ) ℱ) (ρ : Quiver.Hom ℱ ℱ),
        Φ₀ (CategoryTheory.CategoryStruct.comp β ρ) =
          CategoryTheory.CategoryStruct.comp (Φ₀ β) (C₀.map ρ) ∧
        Φ₁ (CategoryTheory.CategoryStruct.comp β ρ) =
          CategoryTheory.CategoryStruct.comp (Φ₁ β) (C₁.map ρ) ∧
        Φ₂ (CategoryTheory.CategoryStruct.comp β ρ) =
          CategoryTheory.CategoryStruct.comp (Φ₂ β) (C₂.map ρ)) ∧
      (∀ {ℱ₁ ℱ₂ : 𝒜} (φ : Quiver.Hom ℱ₁ ℱ₂)
        (β₁ : Quiver.Hom (P_S.obj ℱ₁) ℱ₁) (β₂ : Quiver.Hom (P_S.obj ℱ₂) ℱ₂),
        CategoryTheory.CategoryStruct.comp (P_S.map φ) β₂ =
          CategoryTheory.CategoryStruct.comp β₁ φ →
        CategoryTheory.CategoryStruct.comp (Φ₀ β₁) (C₀.map φ) =
          CategoryTheory.CategoryStruct.comp (C₀.map φ) (Φ₀ β₂) ∧
        CategoryTheory.CategoryStruct.comp (Φ₁ β₁) (C₁.map φ) =
          CategoryTheory.CategoryStruct.comp (C₁.map φ) (Φ₁ β₂) ∧
        CategoryTheory.CategoryStruct.comp (Φ₂ β₁) (C₂.map φ) =
          CategoryTheory.CategoryStruct.comp (C₂.map φ) (Φ₂ β₂)) ∧
      (∀ (ℱ : 𝒜), m • CategoryTheory.CategoryStruct.id ℱ = 0 →
