          (@AlgebraicGeometry.Proj.toSpecZero _ _ _ _ _ 𝒜 MvPolynomial.gradedAlgebra) :=
        @AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat
          _ _ _ _ _ 𝒜 MvPolynomial.gradedAlgebra hFT
      have _ : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥(𝒜 0)))) := by
        have heq : CommRingCat.ofHom (algebraMap F ↥(𝒜 0)) = e_zero.toCommRingCatIso.hom := rfl
        rw [heq]
        infer_instance
      dsimp [D_ov, weilProjectiveSpaceOver]
      infer_instance
    have _ : AlgebraicGeometry.IsProper D_ov.hom := hProp
    have hQS : QuasiSeparatedSpace ↥D_ov.left :=
      (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace D_ov.hom).mp inferInstance
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := default
    let x_inf : ProjectiveSpectrum 𝒜 := s_inf.base pt₀
    have hex_i₀ : ∃ i₀ : Fin 2, MvPolynomial.X i₀ ∉ x_inf.asHomogeneousIdeal := by
      by_contra h_all
      have h_mem : ∀ i : Fin 2, MvPolynomial.X i ∈ x_inf.asHomogeneousIdeal :=
        fun i => Decidable.not_not.mp fun hi => h_all ⟨i, hi⟩
      apply x_inf.not_irrelevant_le
      intro f hf
      rw [HomogeneousIdeal.mem_irrelevant_iff] at hf
      change f ∈ x_inf.asHomogeneousIdeal.toIdeal
      rw [← DirectSum.sum_support_decompose 𝒜 f]
      refine Ideal.sum_mem _ fun n _ => ?_
      by_cases hn0 : n = 0
      · subst hn0
        change (GradedRing.proj 𝒜 0 f : MvPolynomial (Fin 2) F) ∈ x_inf.asHomogeneousIdeal.toIdeal
        rw [hf]
        exact Ideal.zero_mem _
      · have hg_mem : ((DirectSum.decompose 𝒜 f n).1 : MvPolynomial (Fin 2) F) ∈ 𝒜 n :=
          (DirectSum.decompose 𝒜 f n).2
        rw [MvPolynomial.mem_homogeneousSubmodule] at hg_mem
        set g : MvPolynomial (Fin 2) F := (DirectSum.decompose 𝒜 f n).1
        change g ∈ x_inf.asHomogeneousIdeal.toIdeal
        rw [MvPolynomial.as_sum g]
        refine Ideal.sum_mem _ fun d hd => ?_
        rw [MvPolynomial.monomial_eq]
        have hcoeff_ne : g.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hw := hg_mem hcoeff_ne
        rw [hdeg_fin2 d] at hw
        have hd_ex : d 0 ≠ 0 ∨ d 1 ≠ 0 := by omega
        have hprod_mem : (d.prod fun k e => MvPolynomial.X (R := F) k ^ e) ∈
            x_inf.asHomogeneousIdeal.toIdeal := by
          rw [Finsupp.prod_fintype d _ (fun _ => pow_zero _), Fin.prod_univ_two]
          rcases hd_ex with h0 | h1
          · exact Ideal.mul_mem_right _ _
              (Ideal.pow_mem_of_mem _ (h_mem 0) _ (Nat.pos_of_ne_zero h0))
          · exact Ideal.mul_mem_left _ _
              (Ideal.pow_mem_of_mem _ (h_mem 1) _ (Nat.pos_of_ne_zero h1))
        exact Ideal.mul_mem_left _ _ hprod_mem
    obtain ⟨i₀, hi₀⟩ := hex_i₀
    let i₁ : Fin 2 := if i₀ = 0 then 1 else 0
    have hi₁_ne : i₁ ≠ i₀ := by fin_cases i₀ <;> decide
    let T₀ : MvPolynomial (Fin 2) F := MvPolynomial.X i₀
    let T₁ : MvPolynomial (Fin 2) F := MvPolynomial.X i₁
    have hT₀_deg : T₀ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X F i₀
    have hT₁_deg : T₁ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X F i₁
    let H₀ := HomogeneousLocalization.Away 𝒜 T₀
    let L₀ := Localization.Away T₀
    obtain ⟨ev, hev_C, hev_X⟩ : ∃ ev : MvPolynomial (Fin 2) F →+* Polynomial F,
        (∀ c : F, ev (MvPolynomial.C c) = Polynomial.C c) ∧
        (∀ j : Fin 2, ev (MvPolynomial.X j) = if j = i₀ then 1 else Polynomial.X) :=
      ⟨MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i₀ then 1 else Polynomial.X),
        MvPolynomial.eval₂_C _ _, MvPolynomial.eval₂_X _ _⟩
    have hev_T₀ : ev T₀ = 1 := by simp [T₀, hev_X]
    have hev_T₁ : ev T₁ = Polynomial.X := by simp [T₁, hev_X, hi₁_ne]
    have hev_unit : IsUnit (ev T₀) := hev_T₀ ▸ isUnit_one
    obtain ⟨ev_loc, hev_loc⟩ : ∃ ev_loc : L₀ →+* Polynomial F,
        ∀ a : MvPolynomial (Fin 2) F, ev_loc (algebraMap _ L₀ a) = ev a :=
      ⟨IsLocalization.Away.lift T₀ hev_unit, IsLocalization.Away.lift_eq T₀ hev_unit⟩
    obtain ⟨ψ, hψ_val⟩ : ∃ ψ : H₀ →+* Polynomial F, ∀ z : H₀, ψ z = ev_loc z.val :=
      ⟨{ toFun := fun z => ev_loc z.val
         map_one' := by rw [HomogeneousLocalization.val_one, map_one]
         map_mul' := fun x y => by rw [HomogeneousLocalization.val_mul, map_mul]
         map_zero' := by rw [HomogeneousLocalization.val_zero, map_zero]
         map_add' := fun x y => by rw [HomogeneousLocalization.val_add, map_add] },
       fun _ => rfl⟩
    let t_rep : HomogeneousLocalization.NumDenSameDeg 𝒜 (Submonoid.powers T₀) :=
      { deg := 1
        num := ⟨T₁, hT₁_deg⟩
        den := ⟨T₀, hT₀_deg⟩
        den_mem := Submonoid.mem_powers T₀ }
    obtain ⟨t_coord, ht_val⟩ : ∃ t_coord : H₀,
        t_coord.val * algebraMap _ L₀ T₀ = algebraMap _ L₀ T₁ := by
      refine ⟨HomogeneousLocalization.mk t_rep, ?_⟩
      rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk']
      exact IsLocalization.mk'_spec L₀ T₁ ⟨T₀, Submonoid.mem_powers T₀⟩
    let c_hom : F →+* H₀ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers T₀)).comp
        (algebraMap F ↥(𝒜 0))
    have hc_hom_val : ∀ c : F,
        (c_hom c).val = algebraMap (MvPolynomial (Fin 2) F) L₀ (MvPolynomial.C c) := by
      intro c
      dsimp [c_hom]
      rw [← HomogeneousLocalization.algebraMap_eq, ← HomogeneousLocalization.algebraMap_apply,
        ← IsScalarTower.algebraMap_apply ↥(𝒜 0) H₀ L₀]
      have halg0 : algebraMap ↥(𝒜 0) L₀ (algebraMap F ↥(𝒜 0) c) =
          algebraMap (MvPolynomial (Fin 2) F) L₀ ((algebraMap F ↥(𝒜 0) c).1) := rfl
      rw [halg0]
      rfl
    obtain ⟨φ, hφ_C, hφ_X⟩ : ∃ φ : Polynomial F →+* H₀,
        (∀ c : F, φ (Polynomial.C c) = c_hom c) ∧ φ Polynomial.X = t_coord :=
      ⟨Polynomial.eval₂RingHom c_hom t_coord, fun _ => Polynomial.eval₂_C _ _, Polynomial.eval₂_X _ _⟩
    have hc_val : ∀ c : F,
        (φ (Polynomial.C c)).val = algebraMap (MvPolynomial (Fin 2) F) L₀ (MvPolynomial.C c) := by
      intro c; rw [hφ_C, hc_hom_val]
    have hψφ : ψ.comp φ = RingHom.id (Polynomial F) := by
      apply Polynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.id_apply, hψ_val, hc_val, hev_loc, hev_C]
      · rw [RingHom.comp_apply, RingHom.id_apply, hφ_X, hψ_val]
        have hev_eq := congrArg ev_loc ht_val
        rw [map_mul, hev_loc, hev_loc, hev_T₀, mul_one, hev_T₁] at hev_eq
        exact hev_eq
    have hval_sum : ∀ (S : Finset (Fin 2 →₀ ℕ)) (g : (Fin 2 →₀ ℕ) → Polynomial F),
        (φ (∑ d ∈ S, g d)).val = ∑ d ∈ S, (φ (g d)).val := by
      intro S g
      induction S using Finset.cons_induction with
      | empty => simp [HomogeneousLocalization.val_zero]
      | cons a s ha ih =>
        rw [Finset.sum_cons, Finset.sum_cons, map_add, HomogeneousLocalization.val_add, ih]
    have hval_pow : ∀ k : ℕ, (t_coord ^ k).val = (t_coord.val) ^ k := by
      intro k
      induction k with
      | zero => simp [HomogeneousLocalization.val_one]
      | succ k ih => rw [pow_succ, pow_succ, HomogeneousLocalization.val_mul, ih]
    have h_homog_eq : ∀ (m : ℕ) (f : MvPolynomial (Fin 2) F), f ∈ 𝒜 m →
        (φ (ev f)).val * algebraMap _ L₀ (T₀ ^ m) = algebraMap _ L₀ f := by
      intro m f hf
      rw [MvPolynomial.mem_homogeneousSubmodule] at hf
      have hf_sum := MvPolynomial.as_sum f
      conv_lhs => rw [hf_sum]
      conv_rhs => rw [hf_sum]
      rw [map_sum ev, hval_sum, Finset.sum_mul, map_sum (algebraMap _ L₀)]
      refine Finset.sum_congr rfl fun d hd => ?_
      have hd_sum : d i₀ + d i₁ = m := by
        have hcoeff_ne : f.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hw := hf hcoeff_ne
        rw [hdeg_fin2 d] at hw
        fin_cases i₀
        · exact hw
        · dsimp [i₁]; omega
      have hmon : MvPolynomial.monomial d (f.coeff d) =
          MvPolynomial.C (f.coeff d) * (T₀ ^ d i₀ * T₁ ^ d i₁) := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype d _ (fun _ => pow_zero _),
          Fin.prod_univ_two]
        fin_cases i₀
        · rfl
        · dsimp [T₀, T₁, i₁]; ring
      rw [hmon]
      have hev_mon : ev (MvPolynomial.C (f.coeff d) * (T₀ ^ d i₀ * T₁ ^ d i₁)) =
          Polynomial.C (f.coeff d) * Polynomial.X ^ d i₁ := by
        rw [map_mul, map_mul, map_pow, map_pow, hev_T₀, hev_T₁, one_pow, one_mul, hev_C]
      rw [hev_mon, map_mul, map_pow, HomogeneousLocalization.val_mul,
        hφ_X, hval_pow, hc_val, ← hd_sum, pow_add,
        map_mul, map_pow, map_mul, map_mul, map_pow, map_pow]
      calc algebraMap _ L₀ (MvPolynomial.C (f.coeff d)) * t_coord.val ^ d i₁ *
            (algebraMap _ L₀ T₀ ^ d i₀ * algebraMap _ L₀ T₀ ^ d i₁)
          = algebraMap _ L₀ (MvPolynomial.C (f.coeff d)) *
            (algebraMap _ L₀ T₀ ^ d i₀ * (t_coord.val * algebraMap _ L₀ T₀) ^ d i₁) := by ring
        _ = algebraMap _ L₀ (MvPolynomial.C (f.coeff d)) *
            (algebraMap _ L₀ T₀ ^ d i₀ * algebraMap _ L₀ (T₁ ^ d i₁)) := by rw [ht_val, map_pow]
    have hφψ : ∀ z : H₀, φ (ψ z) = z := by
      intro z
      obtain ⟨rep, rfl⟩ : ∃ rep, HomogeneousLocalization.mk rep = z := Quotient.exists_rep z
      apply (HomogeneousLocalization.ext_iff_val _ _).mpr
      rcases rep with ⟨m, ⟨f, hf⟩, ⟨den, hden⟩, hden_mem⟩
      obtain ⟨k, hk⟩ : ∃ k : ℕ, T₀ ^ k = den := id hden_mem
      have hval_rep : (HomogeneousLocalization.mk ⟨m, ⟨f, hf⟩, ⟨den, hden⟩, hden_mem⟩ : H₀).val =
          IsLocalization.mk' L₀ f ⟨den, hden_mem⟩ := by
        rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk']
      have hkm : k = m := by
        have hden_ne : den ≠ 0 := by
          intro h0
          have h1 := congrArg ev hk
          rw [h0, map_zero, map_pow, hev_T₀, one_pow] at h1
          exact one_ne_zero h1
        have hk_hom : (T₀ ^ k).IsHomogeneous k := by
          simpa using (MvPolynomial.isHomogeneous_X F i₀).pow k
        rw [hk] at hk_hom
        have hm_hom : den.IsHomogeneous m := (MvPolynomial.mem_homogeneousSubmodule m den).mp hden
        obtain ⟨d, hd⟩ := MvPolynomial.support_nonempty.mpr hden_ne
        have hcoeff_ne : den.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        exact (hk_hom hcoeff_ne).symm.trans (hm_hom hcoeff_ne)
      subst hkm
      have hspec : (HomogeneousLocalization.mk ⟨k, ⟨f, hf⟩, ⟨den, hden⟩, hden_mem⟩ : H₀).val *
          algebraMap _ L₀ (T₀ ^ k) = algebraMap _ L₀ f := by
        rw [hval_rep, hk]
        exact IsLocalization.mk'_spec L₀ f ⟨den, hden_mem⟩
      have hψ_eq : ψ (HomogeneousLocalization.mk ⟨k, ⟨f, hf⟩, ⟨den, hden⟩, hden_mem⟩) = ev f := by
        rw [hψ_val]
        have hev_spec := congrArg ev_loc hspec
        rw [map_mul, hev_loc, hev_loc, map_pow, hev_T₀, one_pow, mul_one] at hev_spec
        exact hev_spec
      rw [hψ_eq]
      have hunit : IsUnit (algebraMap (MvPolynomial (Fin 2) F) L₀ (T₀ ^ k)) := by
        rw [map_pow]
        exact (IsLocalization.Away.algebraMap_isUnit T₀).pow k
      exact hunit.mul_right_cancel ((h_homog_eq k f hf).trans hspec.symm)
    let Φ : Polynomial F ≃+* H₀ :=
      { φ with
        invFun := ψ
        left_inv := fun p => RingHom.congr_fun hψφ p
        right_inv := hφψ }
    let away_i₀ : AlgebraicGeometry.Spec (CommRingCat.of H₀) ⟶ D_ov.left :=
      @AlgebraicGeometry.Proj.awayι _ _ _ _ _ 𝒜 MvPolynomial.gradedAlgebra
        T₀ 1 hT₀_deg zero_lt_one
    have haway_open : AlgebraicGeometry.IsOpenImmersion away_i₀ :=
      @AlgebraicGeometry.Proj.instIsOpenImmersionAwayι _ _ _ _ _ 𝒜
        MvPolynomial.gradedAlgebra T₀ 1 hT₀_deg zero_lt_one
    let j_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D_ov.left :=
      AlgebraicGeometry.Spec.map Φ.symm.toCommRingCatIso.hom ≫ away_i₀
    have hj_inf_open : AlgebraicGeometry.IsOpenImmersion j_inf :=
      AlgebraicGeometry.IsOpenImmersion.comp _ _
    have hj_inf_hom : j_inf ≫ D_ov.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      dsimp [j_inf, away_i₀, D_ov, weilProjectiveSpaceOver]
      have hIso_hom : Φ.symm.toCommRingCatIso.hom = CommRingCat.ofHom ψ := rfl
      rw [hIso_hom, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
        (@AlgebraicGeometry.Proj.awayι _ _ _ _ _ 𝒜 MvPolynomial.gradedAlgebra
          T₀ 1 hT₀_deg zero_lt_one),
        AlgebraicGeometry.Proj.awayι_toSpecZero,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro c
      change ψ (c_hom c) = Polynomial.C c
      rw [← hφ_C c]
      exact RingHom.congr_fun hψφ (Polynomial.C c)
    have hrange_j_inf : Set.range j_inf.base =
        (@AlgebraicGeometry.Proj.basicOpen _ _ _ _ _ 𝒜 MvPolynomial.gradedAlgebra T₀ :
          Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
      have hsurj : Function.Surjective
          (AlgebraicGeometry.Spec.map Φ.symm.toCommRingCatIso.hom).base := by
        intro y
        refine ⟨(AlgebraicGeometry.Spec.map Φ.symm.toCommRingCatIso.inv).base y, ?_⟩
        change (AlgebraicGeometry.Spec.map Φ.symm.toCommRingCatIso.inv ≫
          AlgebraicGeometry.Spec.map Φ.symm.toCommRingCatIso.hom).base y = y
        rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.hom_inv_id,
          AlgebraicGeometry.Spec.map_id]
        rfl
      change Set.range (away_i₀.base ∘
        (AlgebraicGeometry.Spec.map Φ.symm.toCommRingCatIso.hom).base) = _
      rw [Set.range_comp, hsurj.range_eq, Set.image_univ]
      exact congrArg
        (fun U : (AlgebraicGeometry.Proj 𝒜).Opens => (U : Set ↥(AlgebraicGeometry.Proj 𝒜)))
        (@AlgebraicGeometry.Proj.opensRange_awayι _ _ _ _ _ 𝒜
          MvPolynomial.gradedAlgebra T₀ 1 hT₀_deg zero_lt_one)
    have hsinf_sub : Set.range s_inf.base ⊆ Set.range j_inf.base := by
      rw [hrange_j_inf]
      rintro _ ⟨q, rfl⟩
      have hq : q = pt₀ := Subsingleton.elim q pt₀
      rw [hq]
      exact (@ProjectiveSpectrum.mem_basicOpen _ _ _ _ _ 𝒜
        MvPolynomial.gradedAlgebra T₀ x_inf).mpr hi₀
    let j_c : Fin 2 → (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D_ov.left) :=
      ![j_aff, j_inf]
    have hj_c_open : ∀ a : Fin 2, AlgebraicGeometry.IsOpenImmersion (j_c a) := by
      intro a; fin_cases a
      · exact hj_open
      · exact hj_inf_open
    let W_c : Fin 2 → D_ov.left.Opens := fun a => (j_c a).opensRange
    have hW_cov : TopologicalSpace.IsOpenCover W_c := by
      rw [TopologicalSpace.IsOpenCover]
      ext x
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, TopologicalSpace.Opens.coe_top,
        Set.mem_univ, iff_true]
      by_cases hx : x ∈ Set.range j_aff.base
      · exact ⟨0, hx⟩
      · refine ⟨1, ?_⟩
        have hx' : x ∈ (Set.range j_aff.base)ᶜ := hx
        rw [hsinf_compl] at hx'
        exact hsinf_sub hx'
    let 𝒰 := AlgebraicGeometry.Scheme.openCoverOfIsOpenCover D_ov.left W_c hW_cov
    have hRed_i : ∀ a : Fin 2, AlgebraicGeometry.IsReduced (W_c a).toScheme := by
      intro a
      have _ : AlgebraicGeometry.IsOpenImmersion (j_c a) := hj_c_open a
      let e_a := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (j_c a) (W_c a).ι
        (AlgebraicGeometry.Scheme.Opens.range_ι (W_c a)).symm
      exact AlgebraicGeometry.isReduced_of_isOpenImmersion e_a.inv
    have hIrr : IrreducibleSpace ↥D_ov.left := by
      have _ : AlgebraicGeometry.IsOpenImmersion j_aff := hj_open
      let O₀ : Set ↥D_ov.left := Set.range j_aff.base
      let O₁ : Set ↥D_ov.left := Set.range j_inf.base
      have hO₀_open : IsOpen O₀ := j_aff.opensRange.isOpen
      have hO₁_open : IsOpen O₁ := j_inf.opensRange.isOpen
      have hPre0 : IsPreirreducible O₀ := by
        dsimp [O₀]; rw [← Set.image_univ]
        exact PreirreducibleSpace.isPreirreducible_univ.image j_aff.base
          (AlgebraicGeometry.Scheme.Hom.continuous j_aff).continuousOn
      have hPre1 : IsPreirreducible O₁ := by
        dsimp [O₁]; rw [← Set.image_univ]
        exact PreirreducibleSpace.isPreirreducible_univ.image j_inf.base
          (AlgebraicGeometry.Scheme.Hom.continuous j_inf).continuousOn
      have hcov : ∀ x : ↥D_ov.left, x ∈ O₀ ∨ x ∈ O₁ := by
        intro x
        by_cases hx : x ∈ O₀
        · exact Or.inl hx
        · have hx' : x ∈ O₀ᶜ := hx
          rw [hsinf_compl] at hx'
          exact Or.inr (hsinf_sub hx')
      let p₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
        (⊥ : PrimeSpectrum (Polynomial F))
      let p₁ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
        (⟨RingHom.ker (Polynomial.evalRingHom (0 : F)), RingHom.ker_isPrime _⟩ :
          PrimeSpectrum (Polynomial F))
      have hp_ne : p₀ ≠ p₁ := by
        intro heq
        have hX_mem : Polynomial.X ∈ (p₁ : PrimeSpectrum (Polynomial F)).asIdeal := by
          change Polynomial.eval (0 : F) Polynomial.X = 0
          exact Polynomial.eval_X
        rw [← heq] at hX_mem
        have hX0 : (Polynomial.X : Polynomial F) = 0 := Ideal.mem_bot.mp hX_mem
        exact Polynomial.X_ne_zero hX0
      have hz_inter : (O₀ ∩ O₁).Nonempty := by
        by_cases hp₀_O₀ : j_inf.base p₀ ∈ O₀
        · exact ⟨j_inf.base p₀, hp₀_O₀, ⟨p₀, rfl⟩⟩
        · refine ⟨j_inf.base p₁, ?_, ⟨p₁, rfl⟩⟩
          by_contra hp₁_O₀
          have h0_inf : j_inf.base p₀ ∈ Set.range s_inf.base := hsinf_compl ▸ hp₀_O₀
          have h1_inf : j_inf.base p₁ ∈ Set.range s_inf.base := hsinf_compl ▸ hp₁_O₀
          rcases h0_inf with ⟨q₀, hq₀⟩
          rcases h1_inf with ⟨q₁, hq₁⟩
          have hq_eq : q₀ = q₁ := Subsingleton.elim q₀ q₁
          rw [hq_eq] at hq₀
          exact hp_ne (j_inf.isOpenEmbedding.injective (hq₀.symm.trans hq₁))
      rcases hz_inter with ⟨z₀, hz₀_0, hz₀_1⟩
      have hMeet_O₀ : ∀ (A : Set ↥D_ov.left), IsOpen A → A.Nonempty → (O₀ ∩ A).Nonempty := by
        intro A hA ⟨a, ha⟩
        rcases hcov a with ha0 | ha1
        · exact ⟨a, ha0, ha⟩
        · obtain ⟨w, hw1, hw0, hwA⟩ :=
            hPre1 O₀ A hO₀_open hA ⟨z₀, hz₀_1, hz₀_0⟩ ⟨a, ha1, ha⟩
          exact ⟨w, hw0, hwA⟩
      refine @IrreducibleSpace.mk _ _ ⟨?_⟩ ⟨z₀⟩
      intro U V hU hV ⟨u, _, hu⟩ ⟨v, _, hv⟩
      obtain ⟨u', hu'0, hu'U⟩ := hMeet_O₀ U hU ⟨u, hu⟩
      obtain ⟨v', hv'0, hv'V⟩ := hMeet_O₀ V hV ⟨v, hv⟩
      obtain ⟨w, _, hwU, hwV⟩ := hPre0 U V hU hV ⟨u', hu'0, hu'U⟩ ⟨v', hv'0, hv'V⟩
      exact ⟨w, Set.mem_univ w, hwU, hwV⟩
    have _ : IrreducibleSpace ↥D_ov.left := hIrr
    have _ : AlgebraicGeometry.IsReduced D_ov.left :=
      @AlgebraicGeometry.IsReduced.of_openCover D_ov.left 𝒰 hRed_i
    have hInt : AlgebraicGeometry.IsIntegral D_ov.left :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced D_ov.left
    exact ⟨hProp, hQS, j_inf, hj_inf_open, hj_inf_hom, hsinf_sub, hInt⟩
  
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  obtain ⟨hProp, hQS, j_inf, hj_inf_open, hj_inf_hom, hsinf_sub, hInt⟩ := hProjChart
  have _ : AlgebraicGeometry.IsIntegral D_ov.left := hInt
  have _ : AlgebraicGeometry.IsOpenImmersion j_aff := hj_open
  let j_chart : Fin 2 → (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D_ov.left) :=
    ![j_aff, j_inf]
  have hj_chart_open : ∀ a : Fin 2, AlgebraicGeometry.IsOpenImmersion (j_chart a) := by
    intro a; fin_cases a
    · exact hj_open
    · exact hj_inf_open
  have hj_chart_hom : ∀ a : Fin 2, j_chart a ≫ D_ov.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    intro a; fin_cases a
    · exact hj_hom
    · exact hj_inf_hom
  let W_chart : Fin 2 → D_ov.left.Opens := fun a => (j_chart a).opensRange
  have hW_top : W_chart 0 ⊔ W_chart 1 = ⊤ := by
    ext x
    simp only [TopologicalSpace.Opens.coe_sup, Set.mem_union, TopologicalSpace.Opens.coe_top,
      Set.mem_univ, iff_true]
    by_cases hx : x ∈ Set.range j_aff.base
    · exact Or.inl hx
    · refine Or.inr ?_
      have hx' : x ∈ (Set.range j_aff.base)ᶜ := hx
      rw [hsinf_compl] at hx'
      exact hsinf_sub hx'
  have hW_charts : ∀ a : Fin 2,
      let W := W_chart a
      let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
      AlgebraicGeometry.IsAffineOpen W ∧
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) ∧
      IsDomain A_W ∧
      IsPrincipalIdealRing A_W ∧
      IsDedekindDomain A_W ∧
      ∃ φ_A : Polynomial F ≃+* A_W,
        ∀ c : F,
          φ_A (Polynomial.C c) =
            (CommRingCat.Hom.hom
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
                  (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c := by
    intro a
    have _ : AlgebraicGeometry.IsOpenImmersion (j_chart a) := hj_chart_open a
    have he_ja : ⊤ ≤ (TopologicalSpace.Opens.map (j_chart a).base).obj (W_chart a) :=
      fun pt _ => ⟨pt, rfl⟩
    obtain ⟨hWa_aff, α_a, hNe_Wa_fn, _, _, hConst_a⟩ :=
      hOpenImmIso D_ov.left (Polynomial F) (j_chart a) (W_chart a) rfl he_ja
    let φ_A : Polynomial F ≃+* ↑(D_ov.left.presheaf.obj (Opposite.op (W_chart a))) :=
      α_a.commRingCatIsoToRingEquiv.symm
    have _ : IsDomain ↑(D_ov.left.presheaf.obj (Opposite.op (W_chart a))) :=
      Function.Injective.isDomain φ_A.symm.toRingHom φ_A.symm.injective
    have _ : IsPrincipalIdealRing ↑(D_ov.left.presheaf.obj (Opposite.op (W_chart a))) :=
      IsPrincipalIdealRing.of_surjective φ_A.toRingHom φ_A.surjective
    have hDed_a : IsDedekindDomain ↑(D_ov.left.presheaf.obj (Opposite.op (W_chart a))) :=
      IsPrincipalIdealRing.isDedekindDomain _
    exact ⟨hWa_aff, hNe_Wa_fn inferInstance, ‹_›, ‹_›, hDed_a, φ_A,
      hConst_a D_ov.hom Polynomial.C (hj_chart_hom a)⟩
  let f_U : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ D_ov.left := e_U.hom ≫ U₀.ι
  have _ : AlgebraicGeometry.IsOpenImmersion f_U := AlgebraicGeometry.IsOpenImmersion.comp _ _
  have hU₀_range : (U₀ : Set ↥D_ov.left) = Set.range f_U.base := by
    have hsurj_e : Function.Surjective e_U.hom.base := fun y =>
      ⟨e_U.inv.base y, by
        change (e_U.inv ≫ e_U.hom).base y = y
        rw [e_U.inv_hom_id]; rfl⟩
    change (U₀ : Set ↥D_ov.left) = Set.range (U₀.ι.base ∘ e_U.hom.base)
    rw [Set.range_comp, hsurj_e.range_eq, Set.image_univ,
      AlgebraicGeometry.Scheme.Opens.range_ι]
  have he_fU : ⊤ ≤ (TopologicalSpace.Opens.map f_U.base).obj U₀ := by
    intro pt _
    change f_U.base pt ∈ (U₀ : Set ↥D_ov.left)
    rw [hU₀_range]
    exact ⟨pt, rfl⟩
  obtain ⟨hU₀_aff, φ_U_cat, hNe_U₀_fn, hφ_U_hom, hφ_U_spec, _⟩ :=
    hOpenImmIso D_ov.left R₀ f_U U₀ hU₀_range he_fU
  have hNe_U₀ : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := hNe_U₀_fn hNontriv_R₀
  have _ : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := hNe_U₀
  obtain ⟨hNonGen, e_ff, hGen_K, hU₀_germ⟩ :=
    hFF_and_U₀ D_ov.left j_aff R₀ U₀ e_U heU hU₀_range he_fU φ_U_cat hφ_U_hom
  exact ⟨hProp, hInt, hQS, hNe_U₀, W_chart, e_ff, hU₀_aff, φ_U_cat,
    hW_top, hsinf_sub, hW_charts, hNonGen, hGen_K, hφ_U_spec, hU₀_germ⟩

theorem weil_pid_atlas_generic_normalization_locFree_and_can_ic (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] [QuasiSeparatedSpace ↥Z]
    (W_chart : Fin 2 → Z.Opens)
    (hW_top : W_chart 0 ⊔ W_chart 1 = ⊤)
    (hW_pid : ∀ a : Fin 2,
      let W := W_chart a
      let A_W := ↑(Z.presheaf.obj (Opposite.op W))
      AlgebraicGeometry.IsAffineOpen W ∧
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) ∧
      IsDomain A_W ∧
      IsPrincipalIdealRing A_W ∧
      IsDedekindDomain A_W)
    (hNonGen : ∀ (W : Z.Opens), AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) → ∃ z : ↥W, z.1 ≠ genericPoint ↥Z)
    (K : Type u) [Field K]
    (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of K)) Z)
    [AlgebraicGeometry.QuasiCompact ξ] [AlgebraicGeometry.QuasiSeparated ξ]
    (ψ_K : ↑Z.functionField →+* K)
    (d_cov : ℕ)
    (hFinDim : @FiniteDimensional ↑Z.functionField K _ _ ψ_K.toAlgebra.toModule)
    (hSep : @Algebra.IsSeparable ↑Z.functionField K _ _ ψ_K.toAlgebra)
    (hd_cov : @Module.finrank ↑Z.functionField K _ _ ψ_K.toAlgebra.toModule = d_cov)
    (hξ_gen : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)), ξ.base pt = genericPoint ↥Z)
    (hξ_app : ∀ (W : Z.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})]
      (he : ⊤ ≤ (TopologicalSpace.Opens.map ξ.base).obj W),
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE ξ W ⊤ he)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom =
        ψ_K.comp (Z.germToFunctionField W).hom) :
    let Y := AlgebraicGeometry.Scheme.Hom.normalization ξ
    let p₀ : Quiver.Hom Y Z := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
    let η_to : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of K)) Y :=
      AlgebraicGeometry.Scheme.Hom.toNormalization ξ
    AlgebraicGeometry.IsIntegral Y ∧
    AlgebraicGeometry.IsFinite p₀ ∧
    WeilTopDegFiniteLocallyFreeOfRank d_cov p₀ ∧
    ∀ (W : Z.Opens), AlgebraicGeometry.IsAffineOpen W →
      ∀ (_ : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})),
        IsDedekindDomain ↑(Z.presheaf.obj (Opposite.op W)) →
        let W' : Y.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
        let B_W := ↑(Y.presheaf.obj (Opposite.op W'))
        AlgebraicGeometry.IsAffineOpen W' ∧
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)).Finite ∧
        Function.Injective (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) ∧
        IsIntegrallyClosed B_W ∧
        ∃ (he_η : ⊤ ≤ (TopologicalSpace.Opens.map η_to.base).obj W')
          (ι_K : B_W →+* K),
          ι_K = (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η)
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom ∧
          Function.Injective ι_K ∧
          @IsFractionRing B_W _ K _ ι_K.toAlgebra ∧
          ι_K.comp (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) =
            ψ_K.comp (Z.germToFunctionField W).hom ∧
          (∀ x : K, (ψ_K.comp (Z.germToFunctionField W).hom).IsIntegralElem x ↔
            ∃ b : B_W, ι_K b = x) :=
by
  classical
  let _ := hNonGen
  let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let K₀ : Type u := ↑Z.functionField
  let Y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.normalization ξ
  let p₀ : Y ⟶ Z := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
  let η_to : X₀ ⟶ Y := AlgebraicGeometry.Scheme.Hom.toNormalization ξ
  have hIntHom : AlgebraicGeometry.IsIntegralHom p₀ :=
    AlgebraicGeometry.Scheme.Hom.instIsIntegralHomFromNormalization ξ
  have hAffHom : AlgebraicGeometry.IsAffineHom p₀ := inferInstance
  have _ : IrreducibleSpace ↥Z := inferInstance
  have hη_p₀ : η_to ≫ p₀ = ξ :=
    AlgebraicGeometry.Scheme.Hom.toNormalization_fromNormalization ξ
  let _ : Algebra K₀ K := ψ_K.toAlgebra
  have _ : FiniteDimensional K₀ K := hFinDim
  have _ : Algebra.IsSeparable K₀ K := hSep

  have hChart : ∀ (W : Z.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})],
      IsDedekindDomain ↑(Z.presheaf.obj (Opposite.op W)) →
      let W' : Y.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
      let B_W := ↑(Y.presheaf.obj (Opposite.op W'))
      (∃ hW' : AlgebraicGeometry.IsAffineOpen W',
        ∀ pt : ↥X₀, ∃ hy₀ : η_to.base pt ∈ W',
          (hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩).asIdeal = ⊥) ∧
      IsDomain B_W ∧
      (AlgebraicGeometry.IsAffineOpen W' ∧
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)).Finite ∧
        Function.Injective (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) ∧
        IsIntegrallyClosed B_W ∧
        ∃ (he_η : ⊤ ≤ (TopologicalSpace.Opens.map η_to.base).obj W')
          (ι_K : B_W →+* K),
          ι_K = (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η)
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom ∧
          Function.Injective ι_K ∧
          @IsFractionRing B_W _ K _ ι_K.toAlgebra ∧
          ι_K.comp (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) =
            ψ_K.comp (Z.germToFunctionField W).hom ∧
          (∀ x : K, (ψ_K.comp (Z.germToFunctionField W).hom).IsIntegralElem x ↔
            ∃ b : B_W, ι_K b = x)) := by
    intro W hW hNeW hDedW
    dsimp only
    let A_W_cat : CommRingCat.{u} := Z.presheaf.obj (Opposite.op W)
    let A_W : Type u := ↑A_W_cat
    let W' : Y.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
    let B_W_cat : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W')
    let B_W : Type u := ↑B_W_cat
    have hW' : AlgebraicGeometry.IsAffineOpen W' :=
      (AlgebraicGeometry.isAffineHom_iff p₀).mp hAffHom W hW
    have hgen_W : genericPoint ↥Z ∈ W := by
      obtain ⟨w₀⟩ := hNeW
      exact ((genericPoint_spec ↥Z).mem_open_set_iff W.isOpen).mpr ⟨w₀.1, trivial, w₀.2⟩
    have he_W : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map ξ.base).obj W := by
      intro pt _
      change ξ.base pt ∈ W
      rw [hξ_gen pt]
      exact hgen_W
    have hξW_top : (TopologicalSpace.Opens.map ξ.base).obj W = ⊤ := top_unique he_W
    have he_η : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map η_to.base).obj W' := by
      intro pt _
      change p₀.base (η_to.base pt) ∈ W
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hη_p₀, hξ_gen pt]
      exact hgen_W

    let U_ξ : X₀.Opens := (TopologicalSpace.Opens.map ξ.base).obj W
    let S_W_cat : CommRingCat.{u} := X₀.presheaf.obj (Opposite.op U_ξ)
    let S_W : Type u := ↑S_W_cat
    let _ : Algebra A_W S_W := (ξ.app W).hom.toAlgebra
    let _ : Algebra A_W K := (ψ_K.comp (Z.germToFunctionField W).hom).toAlgebra
    let e_K_cat : S_W_cat ≅ CommRingCat.of K :=
      X₀.presheaf.mapIso (CategoryTheory.eqToIso hξW_top.symm).op ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)
    have h_eK_comp : (ξ.app W ≫ e_K_cat.hom).hom =
        ψ_K.comp (Z.germToFunctionField W).hom := by
      have h_hom_eq : (CategoryTheory.eqToIso hξW_top.symm).op.hom =
          (CategoryTheory.homOfLE he_W).op :=
        congrArg Opposite.op (Subsingleton.elim _ _)
      have h_cat : ξ.app W ≫ e_K_cat.hom =
          ξ.appLE W ⊤ he_W ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom := by
        dsimp only [e_K_cat, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
        rw [h_hom_eq, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.Hom.appLE_eq_app ξ,
          AlgebraicGeometry.Scheme.Hom.appLE_map]
      rw [h_cat]
      exact hξ_app W he_W
    let e_K_ring : S_W ≃+* K := e_K_cat.commRingCatIsoToRingEquiv
    let α_W : S_W ≃ₐ[A_W] K :=
      AlgEquiv.ofRingEquiv (f := e_K_ring) (fun a => by
        change (ξ.app W ≫ e_K_cat.hom).hom a = (ψ_K.comp (Z.germToFunctionField W).hom) a
        exact DFunLike.congr_fun h_eK_comp a)
    let β_W : ↥(integralClosure A_W S_W) ≃ₐ[A_W] ↥(integralClosure A_W K) :=
      AlgEquiv.mapIntegralClosure α_W
    let ν_W : B_W_cat ≅ CommRingCat.of ↥(integralClosure A_W S_W) :=
      AlgebraicGeometry.Scheme.Hom.normalizationObjIso ξ hW
    let e_W : B_W ≃+* ↥(integralClosure A_W K) :=
      ν_W.commRingCatIsoToRingEquiv.trans β_W.toRingEquiv

    let ι_K : B_W →+* K :=
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom
    have hι_K_eq_eW : ∀ b : B_W, ι_K b = (e_W b).1 := by
      have happLE_η : η_to.appLE W' ⊤ he_η =
          η_to.app W' ≫ X₀.presheaf.map (CategoryTheory.homOfLE he_η).op := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app η_to,
          AlgebraicGeometry.Scheme.Hom.appLE_map]
      have h_to := AlgebraicGeometry.Scheme.Hom.toNormalization_app_preimage ξ ⟨W, hW⟩
      change η_to.app W' = _ at h_to
      have h_cat_ι : η_to.appLE W' ⊤ he_η ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom =
          ν_W.hom ≫ CommRingCat.ofHom (integralClosure A_W S_W).val.toRingHom ≫ e_K_cat.hom := by
        rw [happLE_η, h_to]
        dsimp only [e_K_cat, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
        simp only [CategoryTheory.Category.assoc]
        congr 2
      intro b
      have hb_eval : ι_K b = e_K_ring ((ν_W.commRingCatIsoToRingEquiv b).1) :=
        DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_cat_ι) b
      rw [hb_eval]
      exact (AlgEquiv.coe_mapIntegralClosure α_W (ν_W.commRingCatIsoToRingEquiv b)).symm

    have hInj_ιK : Function.Injective ι_K := by
      intro b₁ b₂ hb
      apply e_W.injective
      apply Subtype.ext
      rw [← hι_K_eq_eW b₁, ← hι_K_eq_eW b₂, hb]

    have hComp_ιK : ι_K.comp (p₀.app W).hom = ψ_K.comp (Z.germToFunctionField W).hom := by
      have h_from : p₀.app W ≫ ν_W.hom =
          CommRingCat.ofHom (algebraMap A_W ↥(integralClosure A_W S_W)) := by
        rw [AlgebraicGeometry.Scheme.Hom.fromNormalization_app ξ hW,
          CategoryTheory.Category.assoc, ν_W.inv_hom_id, CategoryTheory.Category.comp_id]
      ext a
      simp only [RingHom.comp_apply, hι_K_eq_eW]
      have h1 : ν_W.commRingCatIsoToRingEquiv ((p₀.app W).hom a) =
          algebraMap A_W ↥(integralClosure A_W S_W) a :=
        DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_from) a
      change (β_W (ν_W.commRingCatIsoToRingEquiv ((p₀.app W).hom a))).1 =
        algebraMap A_W K a
      rw [h1, β_W.commutes a]
      rfl

    have hInj_p₀W : Function.Injective (p₀.app W).hom := by
      intro a₁ a₂ ha
      have h1 : (ψ_K.comp (Z.germToFunctionField W).hom) a₁ =
          (ψ_K.comp (Z.germToFunctionField W).hom) a₂ := by
        rw [← hComp_ιK]
        exact congrArg ι_K ha
      exact AlgebraicGeometry.Scheme.germToFunctionField_injective Z W (ψ_K.injective h1)

    have hInt_iff : ∀ x : K, (ψ_K.comp (Z.germToFunctionField W).hom).IsIntegralElem x ↔
        ∃ b : B_W, ι_K b = x := by
      intro x
      change _root_.IsIntegral A_W x ↔ ∃ b : B_W, ι_K b = x
      constructor
      · intro hx
        have hx' : x ∈ integralClosure A_W K := (mem_integralClosure_iff A_W K).mpr hx
        refine ⟨e_W.symm ⟨x, hx'⟩, ?_⟩
        rw [hι_K_eq_eW]
        exact congrArg Subtype.val (e_W.apply_symm_apply ⟨x, hx'⟩)
      · rintro ⟨b, rfl⟩
        rw [hι_K_eq_eW]
        exact (mem_integralClosure_iff A_W K).mp (e_W b).2

    have hBot_fiber : ∀ pt : ↥X₀, ∃ hy₀ : η_to.base pt ∈ W',
        (hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩).asIdeal = ⊥ := by
      have hInj_appLE_η : Function.Injective (η_to.appLE W' ⊤ he_η).hom :=
        fun b₁ b₂ hb => hInj_ιK
          (congrArg (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom hb)
      have hSpec_η : AlgebraicGeometry.Spec.map (η_to.appLE W' ⊤ he_η) ≫ hW'.fromSpec =
          X₀.isoSpec.inv ≫ η_to := by
        rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_top (X := X₀)]
        exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec η_to hW'
          (AlgebraicGeometry.isAffineOpen_top X₀) he_η
      let e_top : ↑(X₀.presheaf.obj (Opposite.op ⊤)) ≃+* K :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv
      intro pt
      have hy₀ : η_to.base pt ∈ W' := he_η trivial
      refine ⟨hy₀, ?_⟩
      let q₀ : PrimeSpectrum ↑(X₀.presheaf.obj (Opposite.op ⊤)) := X₀.isoSpec.hom.base pt
      have hq₀_bot : q₀.asIdeal = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro r hr
        by_contra hr0
        have he_ne : e_top r ≠ 0 :=
          fun h0 => hr0 (e_top.injective (h0.trans e_top.map_zero.symm))
        have hu : IsUnit r := by
          refine ⟨⟨r, e_top.symm (e_top r)⁻¹, ?_, ?_⟩, rfl⟩
          · apply e_top.injective
            rw [map_mul, e_top.apply_symm_apply, mul_inv_cancel₀ he_ne, map_one]
          · apply e_top.injective
            rw [map_mul, e_top.apply_symm_apply, inv_mul_cancel₀ he_ne, map_one]
        exact q₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q₀.asIdeal hr hu)
      let p_B : PrimeSpectrum B_W :=
        (AlgebraicGeometry.Spec.map (η_to.appLE W' ⊤ he_η)).base q₀
      have hp_B_bot : p_B.asIdeal = ⊥ := by
        change (PrimeSpectrum.comap (η_to.appLE W' ⊤ he_η).hom q₀).asIdeal = ⊥
        rw [PrimeSpectrum.comap_asIdeal, hq₀_bot, Submodule.eq_bot_iff]
        intro b hb
        have hb0 : (η_to.appLE W' ⊤ he_η).hom b = 0 := hb
        exact hInj_appLE_η (hb0.trans (map_zero _).symm)
      have hbase_eq : hW'.fromSpec.base p_B =
          hW'.fromSpec.base (hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩) := by
        have h1 : hW'.fromSpec.base p_B = (X₀.isoSpec.inv ≫ η_to).base q₀ :=
          congrArg (fun f : AlgebraicGeometry.Spec (X₀.presheaf.obj (Opposite.op ⊤)) ⟶ Y =>
            f.base q₀) hSpec_η
        have h2 : (X₀.isoSpec.inv ≫ η_to).base q₀ = η_to.base pt := by
          change η_to.base (X₀.isoSpec.inv.base (X₀.isoSpec.hom.base pt)) = η_to.base pt
          congr 1
          exact congrArg (fun f : X₀ ⟶ X₀ => f.base pt) X₀.isoSpec.hom_inv_id
        exact h1.trans (h2.trans (hW'.fromSpec_primeIdealOf ⟨η_to.base pt, hy₀⟩).symm)
      have hp_eq : hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩ = p_B :=
        hW'.fromSpec.isOpenEmbedding.injective hbase_eq.symm
      rw [hp_eq]
      exact hp_B_bot

    let _ : IsDedekindDomain A_W := hDedW
    let _ : Algebra A_W K₀ := (Z.germToFunctionField W).hom.toAlgebra
    have _ : IsFractionRing A_W K₀ :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z W hW
    have _ : IsScalarTower A_W K₀ K := IsScalarTower.of_algebraMap_eq' rfl
    let _ : Algebra A_W B_W := (p₀.app W).hom.toAlgebra
    let _ : Algebra B_W K := ι_K.toAlgebra
    have _ : IsScalarTower A_W B_W K := IsScalarTower.of_algebraMap_eq' hComp_ιK.symm
    have _ : IsIntegralClosure B_W A_W K :=
      IsIntegralClosure.mk hInj_ιK (fun {x} => hInt_iff x)
    have hDom_BW : IsDomain B_W := Function.Injective.isDomain ι_K hInj_ιK
    have _ : IsDedekindDomain B_W :=
      IsIntegralClosure.isDedekindDomain A_W K₀ K B_W
    have hIC_BW : IsIntegrallyClosed B_W := inferInstance
    have hModFin_BW : Module.Finite A_W B_W :=
      IsIntegralClosure.finite A_W K₀ K B_W
    have hHomFin_W : (p₀.app W).hom.Finite :=
      RingHom.finite_algebraMap.mpr hModFin_BW
    have hFrac_BW_K : @IsFractionRing B_W _ K _ ι_K.toAlgebra :=
      IsIntegralClosure.isFractionRing_of_finite_extension A_W K₀ K B_W

    exact ⟨⟨hW', hBot_fiber⟩, hDom_BW, hW', hHomFin_W, hInj_p₀W, hIC_BW,
      ⟨he_η, ι_K, rfl, hInj_ιK, hFrac_BW_K, hComp_ιK, hInt_iff⟩⟩

  have hCovZ : ∀ y : ↥Z, ∃ a : Fin 2, y ∈ W_chart a := by
    intro y
    have hy_top : y ∈ (⊤ : Z.Opens) := trivial
    rw [← hW_top, TopologicalSpace.Opens.mem_sup] at hy_top
    rcases hy_top with hy0 | hy1
    · exact ⟨0, hy0⟩
    · exact ⟨1, hy1⟩

  let W'_chart : Fin 2 → Y.Opens := fun a => (TopologicalSpace.Opens.map p₀.base).obj (W_chart a)
  have hChart_a : ∀ a : Fin 2,
      let W := W_chart a
      let W' := W'_chart a
      let B_W := ↑(Y.presheaf.obj (Opposite.op W'))
      (∃ hW' : AlgebraicGeometry.IsAffineOpen W',
        ∀ pt : ↥X₀, ∃ hy₀ : η_to.base pt ∈ W',
          (hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩).asIdeal = ⊥) ∧
      IsDomain B_W ∧
      AlgebraicGeometry.IsAffineOpen W' ∧
      (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)).Finite := by
    intro a
    let _ : Nonempty ↥(W_chart a : AlgebraicGeometry.Scheme.{u}) := (hW_pid a).2.1
    obtain ⟨h1, h2, h3, h4, _⟩ := hChart (W_chart a) (hW_pid a).1 (hW_pid a).2.2.2.2
    exact ⟨h1, h2, h3, h4⟩

  have hW'_aff : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (W'_chart a) :=
    fun a => (hChart_a a).2.2.1
  have hDom_a : ∀ a : Fin 2, IsDomain ↑(Y.presheaf.obj (Opposite.op (W'_chart a))) :=
    fun a => (hChart_a a).2.1
  have hFin_a : ∀ a : Fin 2, (p₀.app (W_chart a)).hom.Finite :=
    fun a => (hChart_a a).2.2.2

  have hFin_p₀ : AlgebraicGeometry.IsFinite p₀ := by
    rw [AlgebraicGeometry.IsFinite.iff_isIntegralHom_and_locallyOfFiniteType]
    refine ⟨hIntHom, ?_⟩
    have hSup_W' : (⨆ a : Fin 2, W'_chart a) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      obtain ⟨a, ha⟩ := hCovZ (p₀.base x)
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
    have _ : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.LocallyOfFiniteType.{u}) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top W'_chart hSup_W' (fun a => ?_)
    have h_ι_p₀ : (W'_chart a).ι ≫ p₀ =
        (hW'_aff a).isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (p₀.app (W_chart a)) ≫ ((hW_pid a).1).fromSpec := by
      rw [← (hW'_aff a).isoSpec_hom_fromSpec, CategoryTheory.Category.assoc]
      congr 1
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app p₀]
      exact (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p₀
        (hW_pid a).1 (hW'_aff a) le_rfl).symm
    have _ : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (p₀.app (W_chart a))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr (hFin_a a).to_finiteType
    rw [h_ι_p₀]
    infer_instance

  let 𝒰 : Y.OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
      (Fin 2) (fun a => AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op (W'_chart a))))
      (fun a => (hW'_aff a).fromSpec)
      (fun x => by
        obtain ⟨a, ha⟩ := hCovZ (p₀.base x)
        have hx : x ∈ (W'_chart a : Set ↥Y) := ha
        rw [← (hW'_aff a).range_fromSpec] at hx
        obtain ⟨p, hp⟩ := hx
        exact ⟨a, p, hp⟩)
      (fun a => inferInstance)
  have _ : AlgebraicGeometry.IsReduced Y :=
    @AlgebraicGeometry.IsReduced.of_openCover Y 𝒰 (fun a => by
      have _ : IsDomain ↑(Y.presheaf.obj (Opposite.op (W'_chart a))) := hDom_a a
      exact (inferInstance : AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op (W'_chart a))))))

  let pt_K : ↥X₀ := IsLocalRing.closedPoint K
  let y₀ : ↥Y := η_to.base pt_K
  have hy₀_in_open : ∀ (G : Set ↥Y), IsOpen G → G.Nonempty → y₀ ∈ G := by
    intro G hG ⟨x, hxG⟩
    obtain ⟨a, ha⟩ := hCovZ (p₀.base x)
    have hx_mem : x ∈ W'_chart a := ha
    obtain ⟨hW'_alt, hBot_a⟩ := (hChart_a a).1
    obtain ⟨hy₀_mem, hbot_y₀⟩ := hBot_a pt_K
    let q₀ := hW'_alt.primeIdealOf ⟨y₀, hy₀_mem⟩
    let q_x := hW'_alt.primeIdealOf ⟨x, hx_mem⟩
    have h_le : q₀.asIdeal ≤ q_x.asIdeal := hbot_y₀.symm ▸ bot_le
    have hqx_cl : q_x ∈ closure ({q₀} : Set _) :=
      (PrimeSpectrum.le_iff_mem_closure q₀ q_x).mp h_le
    have hOpen_O : IsOpen (hW'_alt.fromSpec.base ⁻¹' G) :=
      hW'_alt.fromSpec.continuous.isOpen_preimage G hG
    have hqx_O : q_x ∈ hW'_alt.fromSpec.base ⁻¹' G := by
      change hW'_alt.fromSpec.base q_x ∈ G
      rw [hW'_alt.fromSpec_primeIdealOf ⟨x, hx_mem⟩]
      exact hxG
    obtain ⟨_, hq₀_O, hq₀_sing⟩ :=
      mem_closure_iff.mp hqx_cl (hW'_alt.fromSpec.base ⁻¹' G) hOpen_O hqx_O
    rw [Set.mem_singleton_iff] at hq₀_sing
    have hq₀_G : hW'_alt.fromSpec.base q₀ ∈ G := hq₀_sing ▸ hq₀_O
    rwa [hW'_alt.fromSpec_primeIdealOf ⟨y₀, hy₀_mem⟩] at hq₀_G
  have _ : IrreducibleSpace ↥Y :=
    { isPreirreducible_univ := fun U V hU hV ⟨u, _, hu⟩ ⟨v, _, hv⟩ =>
        ⟨y₀, trivial, hy₀_in_open U hU ⟨u, hu⟩, hy₀_in_open V hV ⟨v, hv⟩⟩
      toNonempty := ⟨y₀⟩ }
  have hInt_Y : AlgebraicGeometry.IsIntegral Y :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y

  have hLocFree_p₀ : WeilTopDegFiniteLocallyFreeOfRank d_cov p₀ := by
    refine ⟨hFin_p₀, fun y => ?_⟩
    obtain ⟨a, hy_a⟩ := hCovZ y
    let V : Z.Opens := W_chart a
    let A_V : Type u := ↑(Z.presheaf.obj (Opposite.op V))
    let V' : Y.Opens := (TopologicalSpace.Opens.map p₀.base).obj V
    let B_V : Type u := ↑(Y.presheaf.obj (Opposite.op V'))
    obtain ⟨hV_aff, hV_ne, hDom_AV, hPID_AV, hDed_AV⟩ := hW_pid a
    let _ : Nonempty ↥(V : AlgebraicGeometry.Scheme.{u}) := hV_ne
    let _ : IsDomain A_V := hDom_AV
    let _ : IsPrincipalIdealRing A_V := hPID_AV
    let _ : IsDedekindDomain A_V := hDed_AV
    obtain ⟨_, _, hV'_aff, _, _, _, ⟨_, ι_KV, _, hInj_KV, _, hComp_KV, hInt_KV⟩⟩ :=
      hChart V hV_aff hDed_AV
    let _ : Algebra A_V K₀ := (Z.germToFunctionField V).hom.toAlgebra
    have _ : IsFractionRing A_V K₀ :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z V hV_aff
    let _ : Algebra A_V K := (ψ_K.comp (Z.germToFunctionField V).hom).toAlgebra
    have _ : IsScalarTower A_V K₀ K := IsScalarTower.of_algebraMap_eq' rfl
    let _ : Algebra A_V B_V := (p₀.app V).hom.toAlgebra
    let _ : Algebra B_V K := ι_KV.toAlgebra
    have _ : IsScalarTower A_V B_V K := IsScalarTower.of_algebraMap_eq' hComp_KV.symm
    have _ : IsIntegralClosure B_V A_V K :=
      IsIntegralClosure.mk hInj_KV (fun {x} => hInt_KV x)
    have _ : Module.Finite A_V B_V :=
      IsIntegralClosure.finite A_V K₀ K B_V
    have hInj_AK : Function.Injective (algebraMap A_V K) := by
      rw [IsScalarTower.algebraMap_eq A_V K₀ K]
      exact (algebraMap K₀ K).injective.comp (IsFractionRing.injective A_V K₀)
    have _ : FaithfulSMul A_V K := (faithfulSMul_iff_algebraMap_injective A_V K).mpr hInj_AK
    have _ : Module.IsTorsionFree A_V K := FaithfulSMul.to_isTorsionFree A_V K
    have _ : Module.Free A_V B_V := IsIntegralClosure.module_free A_V K₀ K B_V
    have h_rk : Module.finrank A_V B_V = Module.finrank K₀ K :=
      IsIntegralClosure.rank A_V K₀ K B_V
    let b_raw := Module.Free.chooseBasis A_V B_V
    have _ : StrongRankCondition A_V := commRing_strongRankCondition A_V
    have hcard : Fintype.card (Module.Free.ChooseBasisIndex A_V B_V) = d_cov :=
      (Module.finrank_eq_card_basis b_raw).symm.trans (h_rk.trans hd_cov)
    let b_fin : @Module.Basis (Fin d_cov) A_V B_V _ _ (p₀.app V).hom.toAlgebra.toModule :=
      b_raw.reindex (Fintype.equivFinOfCardEq hcard)
    exact ⟨V, hy_a, hV_aff, hV'_aff, B_V, inferInstance,
      (p₀.app V).hom.toAlgebra.toModule, AddEquiv.refl B_V, fun _ _ => rfl, ⟨b_fin⟩⟩

  exact ⟨hInt_Y, hFin_p₀, hLocFree_p₀,
    fun W hW hNeW hDedW => by
      let _ : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := hNeW
      exact (hChart W hW hDedW).2.2⟩

theorem weil_normalization_open_ic_iso_deck_and_base_factorization (Z : AlgebraicGeometry.Scheme.{u})
    (F F₀ K : Type u) [Field F] [Field F₀] [Field K]
    [Algebra F F₀] [FiniteDimensional F F₀]
    [Algebra F K] [Algebra F₀ K] [IsScalarTower F F₀ K]
    (f_Z : Quiver.Hom Z (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of K)) Z)
    [AlgebraicGeometry.QuasiCompact ξ] [AlgebraicGeometry.QuasiSeparated ξ]
    (hξ_base : CategoryTheory.CategoryStruct.comp ξ f_Z =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K)))
    (U₀ : Z.Opens) (hU₀ : AlgebraicGeometry.IsAffineOpen U₀)
    (hU₀' : AlgebraicGeometry.IsAffineOpen
      ((TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj U₀))
    (he_ηU : ⊤ ≤ (TopologicalSpace.Opens.map
      (AlgebraicGeometry.Scheme.Hom.toNormalization ξ).base).obj
      ((TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj U₀))
    (R₀ B₀ : Type u) [CommRing R₀] [CommRing B₀] [IsDomain B₀]
    [Algebra R₀ B₀] [Algebra R₀ K] [Algebra B₀ K] [IsScalarTower R₀ B₀ K]
    [IsFractionRing B₀ K] [IsIntegralClosure B₀ R₀ K]
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
    (φ_U_cat : CategoryTheory.Iso (Z.presheaf.obj (Opposite.op U₀)) (CommRingCat.of R₀))
    (hφ_U_spec : CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map φ_U_cat.hom) hU₀.fromSpec =
      CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι)
    (hInj_KU : Function.Injective
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE (AlgebraicGeometry.Scheme.Hom.toNormalization ξ)
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj U₀)
          ⊤ he_ηU)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom)
    (hComp_KU :
      ((CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE (AlgebraicGeometry.Scheme.Hom.toNormalization ξ)
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj U₀)
          ⊤ he_ηU)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom).comp
        ((CommRingCat.Hom.hom
          (AlgebraicGeometry.Scheme.Hom.app (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ) U₀)).comp
          φ_U_cat.inv.hom) = algebraMap R₀ K)
    (hInt_KU : ∀ x : K, IsIntegral R₀ x ↔
      ∃ b : ↑((AlgebraicGeometry.Scheme.Hom.normalization ξ).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map
          (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj U₀))),
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appLE (AlgebraicGeometry.Scheme.Hom.toNormalization ξ)
            ((TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj U₀)
            ⊤ he_ηU)
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom b = x)
    (σ : B₀ ≃ₐ[R₀] B₀)
    (σ_K : K ≃ₐ[R₀] K)
    (hσ_ξ : CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom)) ξ = ξ)
    (hσ_inv_ξ : CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.symm.toRingHom)) ξ = ξ)
    (hσ_compat : ∀ b : B₀, σ_K (algebraMap B₀ K b) = algebraMap B₀ K (σ b)) :
    let Y := AlgebraicGeometry.Scheme.Hom.normalization ξ
    let p₀ : Quiver.Hom Y Z := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
    let η_to : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of K)) Y :=
      AlgebraicGeometry.Scheme.Hom.toNormalization ξ
    ∃ (h_YF₀ : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
      (j_V₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₀)) Y)
      (m_Y₀ : CategoryTheory.Iso Y Y),
      CategoryTheory.CategoryStruct.comp h_YF₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₀))) =
        CategoryTheory.CategoryStruct.comp p₀ f_Z ∧
      (∀ (W' : Y.Opens) (he_η : ⊤ ≤ (TopologicalSpace.Opens.map η_to.base).obj W') (c : F₀),
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η)
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom
          ((CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
                (Y.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) =
          algebraMap F₀ K c) ∧
      AlgebraicGeometry.IsOpenImmersion j_V₀ ∧
      CategoryTheory.CategoryStruct.comp j_V₀ p₀ =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)))
            e_U.hom)
          U₀.ι ∧
      Set.range j_V₀.base = p₀.base ⁻¹' (U₀ : Set ↥Z) ∧
      CategoryTheory.CategoryStruct.comp m_Y₀.hom p₀ = p₀ ∧
      CategoryTheory.CategoryStruct.comp j_V₀ m_Y₀.hom =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom))
          j_V₀ :=
by
  intro Y p₀ η_to
  
  let g_F₀ : AlgebraicGeometry.Spec (CommRingCat.of F₀) ⟶ AlgebraicGeometry.Spec (CommRingCat.of F) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₀))
  let k_F₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ AlgebraicGeometry.Spec (CommRingCat.of F₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₀ K))
  have hInt_FF₀ : Algebra.IsIntegral F F₀ := Algebra.IsIntegral.of_finite F F₀
  have hInt_map : (CommRingCat.ofHom (algebraMap F F₀)).hom.IsIntegral := by
    rw [CommRingCat.hom_ofHom]
    exact algebraMap_isIntegral_iff.mpr hInt_FF₀
  have : AlgebraicGeometry.IsIntegralHom g_F₀ :=
    AlgebraicGeometry.IsIntegralHom.SpecMap_iff.mpr hInt_map
  let f₂ := CategoryTheory.Limits.pullback.fst f_Z g_F₀
  let pr₂ := CategoryTheory.Limits.pullback.snd f_Z g_F₀
  have h_cone : ξ ≫ f_Z = k_F₀ ≫ g_F₀ := by
    rw [hξ_base]
    dsimp only [g_F₀, k_F₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq F F₀ K]
  let f₁ := CategoryTheory.Limits.pullback.lift ξ k_F₀ h_cone
  have hf₁_fst : f₁ ≫ f₂ = ξ := CategoryTheory.Limits.pullback.lift_fst ξ k_F₀ h_cone
  have hf₁_snd : f₁ ≫ pr₂ = k_F₀ := CategoryTheory.Limits.pullback.lift_snd ξ k_F₀ h_cone
  let d_F₀ : Y ⟶ CategoryTheory.Limits.pullback f_Z g_F₀ :=
    AlgebraicGeometry.Scheme.Hom.normalizationDesc ξ f₁ f₂ hf₁_fst.symm
  let h_YF₀ : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of F₀) := d_F₀ ≫ pr₂
  have hC1 : h_YF₀ ≫ g_F₀ = p₀ ≫ f_Z := by
    dsimp only [h_YF₀, p₀]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.normalizationDesc_comp]
  have hη_F₀ : η_to ≫ h_YF₀ = k_F₀ := by
    dsimp only [η_to, h_YF₀, d_F₀]
    rw [← CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.Hom.toNormalization_normalizationDesc, hf₁_snd]
  have hC2 : ∀ (W' : Y.Opens) (he_η : ⊤ ≤ (TopologicalSpace.Opens.map η_to.base).obj W') (c : F₀),
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom
        ((CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
              (Y.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) =
        algebraMap F₀ K c := by
    intro W' he_η c
    have h_step1 : AlgebraicGeometry.Scheme.Hom.appTop h_YF₀ ≫
        Y.presheaf.map (CategoryTheory.homOfLE (x := W') (y := ⊤) le_top).op =
        AlgebraicGeometry.Scheme.Hom.appLE h_YF₀ ⊤ W' le_top :=
      (congrArg (· ≫ Y.presheaf.map (CategoryTheory.homOfLE le_top).op)
        (AlgebraicGeometry.Scheme.Hom.app_eq_appLE h_YF₀ (U := ⊤))).trans
        (AlgebraicGeometry.Scheme.Hom.appLE_map h_YF₀ _ (CategoryTheory.homOfLE le_top).op)
    have h_step2 : AlgebraicGeometry.Scheme.Hom.appLE h_YF₀ ⊤ W' le_top ≫
        AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η =
        AlgebraicGeometry.Scheme.Hom.appTop k_F₀ :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE η_to h_YF₀ ⊤ W' ⊤ le_top he_η).trans
        ((AlgebraicGeometry.Scheme.Hom.app_eq_appLE (η_to ≫ h_YF₀) (U := ⊤)).symm.trans
          (congrArg AlgebraicGeometry.Scheme.Hom.appTop hη_F₀))
    have h_mor :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv ≫
          (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀ ≫
            Y.presheaf.map (CategoryTheory.homOfLE le_top).op)) ≫
          (AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom) =
        CommRingCat.ofHom (algebraMap F₀ K) := by
      rw [h_step1]
      calc ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE h_YF₀ ⊤ W' le_top) ≫
              (AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom)
          = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv ≫
              (AlgebraicGeometry.Scheme.Hom.appLE h_YF₀ ⊤ W' le_top ≫
                AlgebraicGeometry.Scheme.Hom.appLE η_to W' ⊤ he_η) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom := by
            simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv ≫
              (AlgebraicGeometry.Scheme.Hom.appTop k_F₀ ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom) := by
            rw [h_step2]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).hom ≫
                CommRingCat.ofHom (algebraMap F₀ K)) := by
            rw [AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap F₀ K))]
        _ = CommRingCat.ofHom (algebraMap F₀ K) := by
            rw [CategoryTheory.Iso.inv_hom_id_assoc]
    have h_ev := congrArg (fun φ => φ.hom c) h_mor
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using h_ev

  
  let U₀' : Y.Opens := (TopologicalSpace.Opens.map p₀.base).obj U₀
  let X_U : CommRingCat.{u} := Y.presheaf.obj (Opposite.op U₀')
  let B_U : Type u := ↑X_U
  let mor_KU : X_U ⟶ CommRingCat.of K :=
    AlgebraicGeometry.Scheme.Hom.appLE η_to U₀' ⊤ he_ηU ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom
  let ι_KU : B_U →+* K := mor_KU.hom
  let alg_R₀_BU : Algebra R₀ B_U :=
    (((AlgebraicGeometry.Scheme.Hom.app p₀ U₀).hom).comp φ_U_cat.inv.hom).toAlgebra
  let alg_BU_K : Algebra B_U K := ι_KU.toAlgebra
  have : IsScalarTower R₀ B_U K := IsScalarTower.of_algebraMap_eq' hComp_KU.symm
  have : IsIntegralClosure B_U R₀ K :=
    @IsIntegralClosure.mk B_U R₀ K _ _ _ _ _ hInj_KU (fun {x} => hInt_KU x)
  let θ_U : B₀ ≃ₐ[R₀] B_U := IsIntegralClosure.equiv R₀ B₀ K B_U
  have hθ_K : ∀ u : B_U, algebraMap B₀ K (θ_U.symm u) = ι_KU u := by
    intro u
    have h1 : algebraMap B_U K (θ_U (θ_U.symm u)) = algebraMap B₀ K (θ_U.symm u) :=
      IsIntegralClosure.algebraMap_equiv R₀ B₀ K B_U (θ_U.symm u)
    rw [AlgEquiv.apply_symm_apply] at h1
    exact h1.symm
  have hφ_inv_hom : ∀ a : ↑(Z.presheaf.obj (Opposite.op U₀)),
      φ_U_cat.inv.hom (φ_U_cat.hom.hom a) = a := by
    intro a
    have h := congrArg (fun f => f.hom a) φ_U_cat.hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using h
  have hθ_R : ∀ a : ↑(Z.presheaf.obj (Opposite.op U₀)),
      θ_U.symm ((AlgebraicGeometry.Scheme.Hom.app p₀ U₀).hom a) =
        algebraMap R₀ B₀ (φ_U_cat.hom.hom a) := by
    intro a
    apply θ_U.injective
    rw [AlgEquiv.apply_symm_apply, θ_U.commutes]
    change (AlgebraicGeometry.Scheme.Hom.app p₀ U₀).hom a =
      (AlgebraicGeometry.Scheme.Hom.app p₀ U₀).hom (φ_U_cat.inv.hom (φ_U_cat.hom.hom a))
    rw [hφ_inv_hom]
  let ψ_cat : X_U ≅ CommRingCat.of B₀ :=
    { hom := CommRingCat.ofHom θ_U.symm.toRingEquiv.toRingHom
      inv := CommRingCat.ofHom θ_U.toRingEquiv.toRingHom
      hom_inv_id := by
        ext u
        simp
      inv_hom_id := by
        ext b
        simp }
  let j_V₀ : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ Y :=
    AlgebraicGeometry.Spec.map ψ_cat.hom ≫ hU₀'.fromSpec
  have : CategoryTheory.IsIso ψ_cat.hom := ⟨⟨ψ_cat.inv, ψ_cat.hom_inv_id, ψ_cat.inv_hom_id⟩⟩
  have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map ψ_cat.hom) := inferInstance
  have hC3 : AlgebraicGeometry.IsOpenImmersion j_V₀ := by
    dsimp only [j_V₀]
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map ψ_cat.hom) :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso (AlgebraicGeometry.Spec.map ψ_cat.hom)
    have : AlgebraicGeometry.IsOpenImmersion hU₀'.fromSpec := hU₀'.isOpenImmersion_fromSpec
    exact AlgebraicGeometry.IsOpenImmersion.comp (AlgebraicGeometry.Spec.map ψ_cat.hom) hU₀'.fromSpec
  have hC5 : Set.range j_V₀.base = p₀.base ⁻¹' (U₀ : Set ↥Z) := by
    have h_surj : Function.Surjective (AlgebraicGeometry.Spec.map ψ_cat.hom).base := by
      intro x
      refine ⟨(AlgebraicGeometry.Spec.map ψ_cat.inv).base x, ?_⟩
      have h_id : AlgebraicGeometry.Spec.map ψ_cat.inv ≫ AlgebraicGeometry.Spec.map ψ_cat.hom =
          𝟙 (AlgebraicGeometry.Spec X_U) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ψ_cat.hom_inv_id, AlgebraicGeometry.Spec.map_id]
      exact congrArg (fun f => f.base x) h_id
    change Set.range (hU₀'.fromSpec.base ∘ (AlgebraicGeometry.Spec.map ψ_cat.hom).base) =
      p₀.base ⁻¹' (U₀ : Set ↥Z)
    rw [h_surj.range_comp, hU₀'.range_fromSpec]
    rfl
  have hC4 : j_V₀ ≫ p₀ =
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)) ≫ e_U.hom) ≫ U₀.ι := by
    have h_fromSpec_p₀ : hU₀'.fromSpec ≫ p₀ =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ U₀) ≫ hU₀.fromSpec := by
      have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p₀ hU₀ hU₀' (le_refl U₀')
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE] at h1
      exact h1.symm
    have h_ring_U : AlgebraicGeometry.Scheme.Hom.app p₀ U₀ ≫ ψ_cat.hom =
        φ_U_cat.hom ≫ CommRingCat.ofHom (algebraMap R₀ B₀) := by
      ext a
      exact hθ_R a
    calc j_V₀ ≫ p₀
        = AlgebraicGeometry.Spec.map ψ_cat.hom ≫ (hU₀'.fromSpec ≫ p₀) := by
            dsimp only [j_V₀]; rw [CategoryTheory.Category.assoc]
      _ = (AlgebraicGeometry.Spec.map ψ_cat.hom ≫
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ U₀)) ≫
            hU₀.fromSpec := by
            rw [h_fromSpec_p₀, CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app p₀ U₀ ≫ ψ_cat.hom) ≫
            hU₀.fromSpec := by
            rw [← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)) ≫
            (AlgebraicGeometry.Spec.map φ_U_cat.hom ≫ hU₀.fromSpec) := by
            rw [h_ring_U, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)) ≫ e_U.hom) ≫ U₀.ι := by
            rw [hφ_U_spec, CategoryTheory.Category.assoc]
  have hj_η : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ K)) ≫ j_V₀ = η_to := by
    have h_top_spec : (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of K))).fromSpec =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top, AlgebraicGeometry.Scheme.isoSpec_Spec_inv]
    have h_eta_chart := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec η_to hU₀'
      (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of K))) he_ηU
    rw [h_top_spec] at h_eta_chart
    have h_eta_eq : η_to = AlgebraicGeometry.Spec.map mor_KU ≫ hU₀'.fromSpec := by
      have h_pre := congrArg
        (fun f => AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫ f)
        h_eta_chart.symm
      have h_lhs : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫
          (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ η_to) = η_to := by
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
      have h_rhs : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫
          (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.appLE η_to U₀' ⊤ he_ηU) ≫ hU₀'.fromSpec) =
          AlgebraicGeometry.Spec.map mor_KU ≫ hU₀'.fromSpec := by
        dsimp only [mor_KU]
        rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
      exact h_lhs.symm.trans (h_pre.trans h_rhs)
    have h_mor_KU_eq : mor_KU = ψ_cat.hom ≫ CommRingCat.ofHom (algebraMap B₀ K) := by
      ext u
      exact (hθ_K u).symm
    rw [h_eta_eq, h_mor_KU_eq, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]

  
  have : AlgebraicGeometry.IsIntegralHom p₀ := inferInstance
  have : AlgebraicGeometry.IsAffineHom p₀ := inferInstance
  have hm_fac : ξ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom) ≫ η_to) ≫ p₀ := by
    dsimp only [η_to, p₀]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toNormalization_fromNormalization, hσ_ξ]
  have hminv_fac : ξ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.symm.toRingHom) ≫ η_to) ≫ p₀ := by
    dsimp only [η_to, p₀]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toNormalization_fromNormalization, hσ_inv_ξ]
  let m_hom : Y ⟶ Y := AlgebraicGeometry.Scheme.Hom.normalizationDesc ξ
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom) ≫ η_to) p₀ hm_fac
  let m_inv : Y ⟶ Y := AlgebraicGeometry.Scheme.Hom.normalizationDesc ξ
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.symm.toRingHom) ≫ η_to) p₀ hminv_fac
  have hm_p₀ : m_hom ≫ p₀ = p₀ :=
    AlgebraicGeometry.Scheme.Hom.normalizationDesc_comp ξ _ p₀ hm_fac
  have hminv_p₀ : m_inv ≫ p₀ = p₀ :=
    AlgebraicGeometry.Scheme.Hom.normalizationDesc_comp ξ _ p₀ hminv_fac
  have hη_m : η_to ≫ m_hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom) ≫ η_to :=
    AlgebraicGeometry.Scheme.Hom.toNormalization_normalizationDesc ξ _ p₀ hm_fac
  have hη_minv : η_to ≫ m_inv = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.symm.toRingHom) ≫ η_to :=
    AlgebraicGeometry.Scheme.Hom.toNormalization_normalizationDesc ξ _ p₀ hminv_fac
  have hm_hom_inv : m_hom ≫ m_inv = 𝟙 Y := by
    apply AlgebraicGeometry.Scheme.Hom.normalization.hom_ext ξ (m_hom ≫ m_inv) (𝟙 Y) p₀
    · calc AlgebraicGeometry.Scheme.Hom.toNormalization ξ ≫ (m_hom ≫ m_inv)
          = (η_to ≫ m_hom) ≫ m_inv := (CategoryTheory.Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom) ≫ (η_to ≫ m_inv) := by
              rw [hη_m, CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.symm.toRingHom)) ≫ η_to := by
              rw [hη_minv, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom σ_K.symm.toRingHom ≫ CommRingCat.ofHom σ_K.toRingHom) ≫ η_to := by
              rw [← AlgebraicGeometry.Spec.map_comp]
        _ = 𝟙 _ ≫ η_to := by
              have h_id_K : CommRingCat.ofHom σ_K.symm.toRingHom ≫ CommRingCat.ofHom σ_K.toRingHom =
                  𝟙 (CommRingCat.of K) := by
                ext x
                simp
              rw [h_id_K, AlgebraicGeometry.Spec.map_id]
        _ = AlgebraicGeometry.Scheme.Hom.toNormalization ξ ≫ 𝟙 Y := by
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc, hminv_p₀, hm_p₀]
    · exact CategoryTheory.Category.id_comp p₀
  have hm_inv_hom : m_inv ≫ m_hom = 𝟙 Y := by
    apply AlgebraicGeometry.Scheme.Hom.normalization.hom_ext ξ (m_inv ≫ m_hom) (𝟙 Y) p₀
    · calc AlgebraicGeometry.Scheme.Hom.toNormalization ξ ≫ (m_inv ≫ m_hom)
          = (η_to ≫ m_inv) ≫ m_hom := (CategoryTheory.Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.symm.toRingHom) ≫ (η_to ≫ m_hom) := by
              rw [hη_minv, CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.symm.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom)) ≫ η_to := by
              rw [hη_m, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom σ_K.toRingHom ≫ CommRingCat.ofHom σ_K.symm.toRingHom) ≫ η_to := by
              rw [← AlgebraicGeometry.Spec.map_comp]
        _ = 𝟙 _ ≫ η_to := by
              have h_id_K : CommRingCat.ofHom σ_K.toRingHom ≫ CommRingCat.ofHom σ_K.symm.toRingHom =
                  𝟙 (CommRingCat.of K) := by
                ext x
                simp
              rw [h_id_K, AlgebraicGeometry.Spec.map_id]
        _ = AlgebraicGeometry.Scheme.Hom.toNormalization ξ ≫ 𝟙 Y := by
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc, hm_p₀, hminv_p₀]
    · exact CategoryTheory.Category.id_comp p₀
  let m_Y₀ : Y ≅ Y :=
    { hom := m_hom
      inv := m_inv
      hom_inv_id := hm_hom_inv
      inv_hom_id := hm_inv_hom }
  have hC6 : m_Y₀.hom ≫ p₀ = p₀ := hm_p₀
  have hC7 : j_V₀ ≫ m_Y₀.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ j_V₀ := by
    have : AlgebraicGeometry.IsOpenImmersion j_V₀ := hC3
    have h_im : Set.range ⇑(j_V₀ ≫ m_hom) ⊆ Set.range ⇑j_V₀ := by
      rw [hC5]
      rintro _ ⟨x, rfl⟩
      have hx : j_V₀.base x ∈ Set.range j_V₀.base := ⟨x, rfl⟩
      rw [hC5] at hx
      have h_eq : p₀.base ((j_V₀ ≫ m_hom).base x) = p₀.base (j_V₀.base x) := by
        change ((j_V₀ ≫ m_hom) ≫ p₀).base x = (j_V₀ ≫ p₀).base x
        rw [CategoryTheory.Category.assoc, hm_p₀]
      change p₀.base ((j_V₀ ≫ m_hom).base x) ∈ (U₀ : Set ↥Z)
      rw [h_eq]
      exact hx
    let g_lift : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_V₀ (j_V₀ ≫ m_hom) h_im
    have hg_fac : g_lift ≫ j_V₀ = j_V₀ ≫ m_hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_V₀ (j_V₀ ≫ m_hom) h_im
    let i_BK := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ K))
    have h_lhs_K : (i_BK ≫ g_lift) ≫ j_V₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom) ≫ η_to := by
      rw [CategoryTheory.Category.assoc, hg_fac, ← CategoryTheory.Category.assoc, hj_η, hη_m]
    have h_comm_BK : CommRingCat.ofHom σ.toRingHom ≫ CommRingCat.ofHom (algebraMap B₀ K) =
        CommRingCat.ofHom (algebraMap B₀ K) ≫ CommRingCat.ofHom σ_K.toRingHom := by
      ext b
      exact (hσ_compat b).symm
    have h_rhs_K : (i_BK ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)) ≫ j_V₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_K.toRingHom) ≫ η_to := by
      dsimp only [i_BK]
      rw [← AlgebraicGeometry.Spec.map_comp, h_comm_BK, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, hj_η]
    have : CategoryTheory.Mono j_V₀ := AlgebraicGeometry.IsOpenImmersion.mono j_V₀
    have h_eq_K : i_BK ≫ g_lift =
        i_BK ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) :=
      (CategoryTheory.cancel_mono j_V₀).mp (h_lhs_K.trans h_rhs_K.symm)
    let φ_g : CommRingCat.of B₀ ⟶ CommRingCat.of B₀ := AlgebraicGeometry.Spec.homEquiv g_lift
    have hφ_g_spec : AlgebraicGeometry.Spec.map φ_g = g_lift := by
      rw [← AlgebraicGeometry.Spec.homEquiv_symm_apply]
      exact AlgebraicGeometry.Spec.homEquiv.symm_apply_apply g_lift
    rw [← hφ_g_spec] at h_eq_K
    have h_ring_K : φ_g ≫ CommRingCat.ofHom (algebraMap B₀ K) =
        CommRingCat.ofHom σ.toRingHom ≫ CommRingCat.ofHom (algebraMap B₀ K) := by
      apply AlgebraicGeometry.Spec.map_inj.mp
      simpa only [AlgebraicGeometry.Spec.map_comp] using h_eq_K
    have hφ_g_eq : φ_g = CommRingCat.ofHom σ.toRingHom := by
      ext b
      apply IsFractionRing.injective B₀ K
      have h_eval := congrArg (fun f => f.hom b) h_ring_K
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using h_eval
    have hg_eq : g_lift = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) := by
      rw [← hφ_g_spec, hφ_g_eq]
    dsimp only [m_Y₀]
    rw [← hg_fac, hg_eq]
  exact ⟨h_YF₀, j_V₀, m_Y₀, hC1, hC2, hC3, hC4, hC5, hC6, hC7⟩

theorem weil_curve_tr_f_normalization_and_constant_field (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (B₀ L₀ : Type u)
    [CommRing B₀] [IsDomain B₀] [Field L₀]
    [Algebra F B₀] [Algebra (Polynomial F) B₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra F L₀] [Algebra (Polynomial F) L₀] [Algebra (RatFunc F) L₀]
    [Algebra B₀ L₀]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [IsScalarTower F (Polynomial F) B₀]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsScalarTower F (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) (RatFunc F) L₀]
    [IsScalarTower (Polynomial F) B₀ L₀]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀ L₀]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B₀]
    [IsFractionRing B₀ L₀]
    [IsIntegralClosure B₀
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L₀]
    [FiniteDimensional (RatFunc F) L₀]
    [IsGalois (RatFunc F) L₀]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (σ : B₀ ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B₀) :
    ∃ (F₀ : Type u) (_ : Field F₀) (_ : Finite F₀) (_ : Algebra F F₀)
      (_ : FiniteDimensional F F₀) (_ : Algebra F₀ L₀) (_ : IsScalarTower F F₀ L₀)
      (d_cov : ℕ)
      (Y_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (p₀ : Quiver.Hom Y_ov.left (weilProjectiveSpaceOver F 1).left)
      (h_YF₀ : Quiver.Hom Y_ov.left (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
      (j_V₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₀)) Y_ov.left)
      (m_Y₀ : CategoryTheory.Iso Y_ov.left Y_ov.left)
      (W_chart : Fin 2 → (weilProjectiveSpaceOver F 1).left.Opens),
      1 ≤ d_cov ∧
      (∀ x : L₀, IsIntegral F x → ∃ c : F₀, algebraMap F₀ L₀ c = x) ∧
      AlgebraicGeometry.IsProper Y_ov.hom ∧
      AlgebraicGeometry.IsFinite p₀ ∧
      CategoryTheory.CategoryStruct.comp p₀ (weilProjectiveSpaceOver F 1).hom = Y_ov.hom ∧
      WeilTopDegFiniteLocallyFreeOfRank d_cov p₀ ∧
      CategoryTheory.CategoryStruct.comp h_YF₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₀))) = Y_ov.hom ∧
      AlgebraicGeometry.IsOpenImmersion j_V₀ ∧
      CategoryTheory.CategoryStruct.comp j_V₀ p₀ =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap
                (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
                B₀)))
            e_U.hom)
          U₀.ι ∧
      Set.range j_V₀.base = p₀.base ⁻¹' (U₀ : Set ↥(weilProjectiveSpaceOver F 1).left) ∧
      CategoryTheory.CategoryStruct.comp m_Y₀.hom p₀ = p₀ ∧
      CategoryTheory.CategoryStruct.comp j_V₀ m_Y₀.hom =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom))
          j_V₀ ∧
      W_chart 0 ⊔ W_chart 1 = ⊤ ∧
      Set.range s_inf.base ⊆ (W_chart 1 : Set ↥(weilProjectiveSpaceOver F 1).left) ∧
      (∀ a : Fin 2,
        let D_ov := weilProjectiveSpaceOver F 1
        let W := W_chart a
        let W' : Y_ov.left.Opens := (TopologicalSpace.Opens.map p₀.base).obj W
        let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
        let B_W := ↑(Y_ov.left.presheaf.obj (Opposite.op W'))
        AlgebraicGeometry.IsAffineOpen W ∧
        AlgebraicGeometry.IsAffineOpen W' ∧
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)).Finite ∧
        Function.Injective (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ W)) ∧
        ∃ (φ_A : Polynomial F ≃+* A_W) (ι_K : B_W →+* L₀),
          (∀ c : F,
            φ_A (Polynomial.C c) =
              (CommRingCat.Hom.hom
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Scheme.Hom.appTop D_ov.hom)
                    (D_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) ∧
          Function.Injective ι_K ∧
          IsIntegrallyClosed B_W ∧
          @IsFractionRing B_W _ L₀ _ ι_K.toAlgebra ∧
          (∀ c : F₀,
            ι_K ((CommRingCat.Hom.hom
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F₀)).inv
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.Hom.appTop h_YF₀)
                  (Y_ov.left.presheaf.map (CategoryTheory.homOfLE le_top).op)))) c) =
              algebraMap F₀ L₀ c)) :=
by
  have _ := hU₀_eq
  let g_poly : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  let R₀ := Localization.Away g_poly
  let D_ov := weilProjectiveSpaceOver F 1
  have hg_ne : g_poly ≠ 0 :=
    (Polynomial.monic_prod_of_monic S_aff _ fun s _ => Polynomial.monic_X_sub_C s).ne_zero
  obtain ⟨F₀, hField_F₀, hFin_F₀, hAlg_FF₀, hFD_FF₀, hAlg_F₀L₀, hST_FF₀L₀, σ_L,
    hd_cov, hSep_L₀, hDom_R₀, hNontriv_R₀, hPID_R₀, _hDed_R₀, hST_PRL₀,
    hF₀_int, hC_F, hσ_compat, hσ_poly, hσ_inv_poly⟩ :=
    weil_curve_tr_constant_field_and_deck_lift F g_poly hg_ne R₀ B₀ L₀ σ
  let _ : Field F₀ := hField_F₀
  let _ : Finite F₀ := hFin_F₀
  let _ : Algebra F F₀ := hAlg_FF₀
  have _ : FiniteDimensional F F₀ := hFD_FF₀
  let _ : Algebra F₀ L₀ := hAlg_F₀L₀
  have _ : IsScalarTower F F₀ L₀ := hST_FF₀L₀
  have _ : IsDomain R₀ := hDom_R₀
  have _ : IsPrincipalIdealRing R₀ := hPID_R₀
  have _ : IsScalarTower (Polynomial F) R₀ L₀ := hST_PRL₀
  set d_cov : ℕ := Module.finrank (RatFunc F) L₀
  obtain ⟨hProp_D, hInt_D, hQS_D, hNe_U₀, W_chart, e_ff, hU₀_aff, φ_U_cat,
    hW_top, hsinf_W1, hW_charts, hNonGen, hGen_K, hφ_U_spec, hU₀_germ⟩ :=
    weil_p1_two_chart_pid_atlas_and_functionField F S_aff j_aff hj_open hj_hom
      s_inf hsinf_sec hsinf_compl U₀ e_U heU hNontriv_R₀
  have _ : AlgebraicGeometry.IsProper D_ov.hom := hProp_D
  have _ : AlgebraicGeometry.IsIntegral D_ov.left := hInt_D
  have _ : QuasiSeparatedSpace ↥D_ov.left := hQS_D
  have _ : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := hNe_U₀
  let ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of L₀)) D_ov.left :=
    CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) L₀))) j_aff
  have _ : AlgebraicGeometry.QuasiCompact ξ := AlgebraicGeometry.quasiCompact_of_compactSpace ξ
  have _ : AlgebraicGeometry.QuasiSeparated ξ := inferInstance
  let ψ_K : ↑D_ov.left.functionField →+* L₀ := (algebraMap (RatFunc F) L₀).comp e_ff.toRingHom
  obtain ⟨hFD_Sep, hSep_imp, hξ_gen, hξ_app⟩ := hGen_K L₀
  obtain ⟨hFinDim_K, hd_cov_K⟩ := hFD_Sep inferInstance
  have hSep_K := hSep_imp hSep_L₀
  have hW_pid : ∀ a : Fin 2,
      let W := W_chart a
      let A_W := ↑(D_ov.left.presheaf.obj (Opposite.op W))
      AlgebraicGeometry.IsAffineOpen W ∧
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) ∧
      IsDomain A_W ∧
      IsPrincipalIdealRing A_W ∧
      IsDedekindDomain A_W :=
    fun a => ⟨(hW_charts a).1, (hW_charts a).2.1, (hW_charts a).2.2.1,
      (hW_charts a).2.2.2.1, (hW_charts a).2.2.2.2.1⟩
  obtain ⟨_hInt_Y, hFin_p₀, hp₀_locFree, hNorm_W⟩ :=
    weil_pid_atlas_generic_normalization_locFree_and_can_ic D_ov.left W_chart hW_top hW_pid
      hNonGen L₀ ξ ψ_K d_cov hFinDim_K hSep_K hd_cov_K hξ_gen hξ_app
  let Y := AlgebraicGeometry.Scheme.Hom.normalization ξ
  let p₀ : Quiver.Hom Y D_ov.left := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
  let η_to : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of L₀)) Y :=
    AlgebraicGeometry.Scheme.Hom.toNormalization ξ
  have _ : AlgebraicGeometry.IsFinite p₀ := hFin_p₀
  let Y_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
    CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp p₀ D_ov.hom)
  have hProp_Yov : AlgebraicGeometry.IsProper Y_ov.hom := by
    change AlgebraicGeometry.IsProper (p₀ ≫ D_ov.hom)
    infer_instance
  let e_U_ring := φ_U_cat.commRingCatIsoToRingEquiv
  have _ : IsDomain ↑(D_ov.left.presheaf.obj (Opposite.op U₀)) :=
    Function.Injective.isDomain e_U_ring.toRingHom e_U_ring.injective
  have _ : IsPrincipalIdealRing ↑(D_ov.left.presheaf.obj (Opposite.op U₀)) :=
    IsPrincipalIdealRing.of_surjective e_U_ring.symm.toRingHom e_U_ring.symm.surjective
  have hDed_U₀ : IsDedekindDomain ↑(D_ov.left.presheaf.obj (Opposite.op U₀)) :=
    IsPrincipalIdealRing.isDedekindDomain _
  obtain ⟨hU₀', _, _, _, he_ηU, ι_KU, hι_KU_eq, hInj_KU, _, hComp_raw, hInt_raw⟩ :=
    hNorm_W U₀ hU₀_aff hNe_U₀ hDed_U₀
  rw [hι_KU_eq] at hInj_KU hComp_raw hInt_raw
  have hGerm_L₀ := hU₀_germ L₀
  have hComp_KU :
      ((CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE η_to
          ((TopologicalSpace.Opens.map p₀.base).obj U₀) ⊤ he_ηU)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L₀)).hom).hom).comp
        ((CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app p₀ U₀)).comp
          φ_U_cat.inv.hom) = algebraMap R₀ L₀ := by
    rw [← RingHom.comp_assoc, hComp_raw]
    exact hGerm_L₀
  have hα_U₀ : ψ_K.comp (D_ov.left.germToFunctionField U₀).hom =
      (algebraMap R₀ L₀).comp φ_U_cat.hom.hom := by
    ext a
    have ha : φ_U_cat.inv.hom (φ_U_cat.hom.hom a) = a := by
      simp
    calc (ψ_K.comp (D_ov.left.germToFunctionField U₀).hom) a
        = (ψ_K.comp (D_ov.left.germToFunctionField U₀).hom)
            (φ_U_cat.inv.hom (φ_U_cat.hom.hom a)) :=
          congrArg (ψ_K.comp (D_ov.left.germToFunctionField U₀).hom) ha.symm
      _ = ((ψ_K.comp (D_ov.left.germToFunctionField U₀).hom).comp φ_U_cat.inv.hom)
            (φ_U_cat.hom.hom a) := rfl
      _ = algebraMap R₀ L₀ (φ_U_cat.hom.hom a) := by rw [hGerm_L₀]
  have hInt_KU : ∀ x : L₀, IsIntegral R₀ x ↔
      ∃ b : ↑(Y.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map p₀.base).obj U₀))),
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appLE η_to
            ((TopologicalSpace.Opens.map p₀.base).obj U₀) ⊤ he_ηU)
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L₀)).hom).hom b = x := by
    intro x
    rw [← hInt_raw x]
    constructor
    · rintro ⟨p, hp_mon, hp_eval⟩
      refine ⟨p.map φ_U_cat.inv.hom, hp_mon.map φ_U_cat.inv.hom, ?_⟩
      rw [Polynomial.eval₂_map, hGerm_L₀]
      exact hp_eval
    · rintro ⟨q, hq_mon, hq_eval⟩
      refine ⟨q.map φ_U_cat.hom.hom, hq_mon.map φ_U_cat.hom.hom, ?_⟩
      rw [Polynomial.eval₂_map, ← hα_U₀]
      exact hq_eval
  have hξ_base : CategoryTheory.CategoryStruct.comp ξ D_ov.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F L₀)) := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) L₀)) ≫
        j_aff) ≫ D_ov.hom = _
    rw [CategoryTheory.Category.assoc, hj_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have h_eq : CommRingCat.ofHom ((algebraMap (Polynomial F) L₀).comp Polynomial.C) =
        CommRingCat.ofHom (algebraMap F L₀) :=
      congrArg CommRingCat.ofHom (RingHom.ext hC_F)
    rw [h_eq]
  have hσ_ξ : CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_L.toRingHom)) ξ = ξ := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_L.toRingHom) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) L₀)) ≫
          j_aff) = _
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have h_eq : CommRingCat.ofHom (σ_L.toRingHom.comp (algebraMap (Polynomial F) L₀)) =
        CommRingCat.ofHom (algebraMap (Polynomial F) L₀) :=
      congrArg CommRingCat.ofHom (RingHom.ext hσ_poly)
    rw [h_eq]
  have hσ_inv_ξ : CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_L.symm.toRingHom)) ξ = ξ := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_L.symm.toRingHom) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) L₀)) ≫
          j_aff) = _
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have h_eq : CommRingCat.ofHom (σ_L.symm.toRingHom.comp (algebraMap (Polynomial F) L₀)) =
        CommRingCat.ofHom (algebraMap (Polynomial F) L₀) :=
      congrArg CommRingCat.ofHom (RingHom.ext hσ_inv_poly)
    rw [h_eq]
  obtain ⟨h_YF₀, j_V₀, m_Y₀, hYF₀_hom, hYF₀_sec, hj_V₀_open, hj_V₀_p₀, hj_V₀_range,
    hm_p₀, hm_jV₀⟩ :=
    weil_normalization_open_ic_iso_deck_and_base_factorization D_ov.left F F₀ L₀ D_ov.hom ξ
      hξ_base U₀ hU₀_aff hU₀' he_ηU R₀ B₀ e_U φ_U_cat hφ_U_spec hInj_KU hComp_KU hInt_KU
      σ σ_L hσ_ξ hσ_inv_ξ hσ_compat
  refine ⟨F₀, hField_F₀, hFin_F₀, hAlg_FF₀, hFD_FF₀, hAlg_F₀L₀, hST_FF₀L₀,
    d_cov, Y_ov, p₀, h_YF₀, j_V₀, m_Y₀, W_chart,
    hd_cov, hF₀_int, hProp_Yov, hFin_p₀, rfl, hp₀_locFree, hYF₀_hom,
    hj_V₀_open, hj_V₀_p₀, hj_V₀_range, hm_p₀, hm_jV₀, hW_top, hsinf_W1, fun a => ?_⟩
  obtain ⟨hWa_aff, hWa_ne, _, _, hWa_ded, φ_A, hφ_A⟩ := hW_charts a
  obtain ⟨hWa'_aff, hWa_fin, hWa_inj, hIC_Ba, he_ηa, ι_Ka, hι_Ka_eq, hInj_Ka, hFrac_Ba, _, _⟩ :=
    hNorm_W (W_chart a) hWa_aff hWa_ne hWa_ded
  exact ⟨hWa_aff, hWa'_aff, hWa_fin, hWa_inj, φ_A, ι_Ka,
    hφ_A, hInj_Ka, hIC_Ba, hFrac_Ba, fun c => by rw [hι_Ka_eq]; exact hYF₀_sec _ he_ηa c⟩

theorem weil_baseChange_finiteLocallyFreeOfRank (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (d : ℕ)
    (X Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of R)))
    (p₀ : Quiver.Hom X.left Y.left)
    (hp₀_hom : CategoryTheory.CategoryStruct.comp p₀ Y.hom = X.hom)
    (hp₀_locFree : WeilTopDegFiniteLocallyFreeOfRank d p₀) :
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))
    let X_S := weilBaseChangeOver R S X
    let Y_S := weilBaseChangeOver R S Y
    ∃ p_S : Quiver.Hom X_S.left Y_S.left,
      CategoryTheory.CategoryStruct.comp p_S (CategoryTheory.Limits.pullback.fst Y.hom f₂) =
        CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst X.hom f₂) p₀ ∧
      CategoryTheory.CategoryStruct.comp p_S Y_S.hom = X_S.hom ∧
      WeilTopDegFiniteLocallyFreeOfRank d p_S :=
by
  let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))
  let X_S := weilBaseChangeOver R S X
  let Y_S := weilBaseChangeOver R S Y
  let pr_X : X_S.left ⟶ X.left := CategoryTheory.Limits.pullback.fst X.hom f₂
  let pr_Y : Y_S.left ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom f₂
  have hcomm_pS : (pr_X ≫ p₀) ≫ Y.hom = X_S.hom ≫ f₂ := by
    rw [Category.assoc, hp₀_hom]
    exact CategoryTheory.Limits.pullback.condition
  let p_S : X_S.left ⟶ Y_S.left :=
    CategoryTheory.Limits.pullback.lift (pr_X ≫ p₀) X_S.hom hcomm_pS
  have hp_fst : p_S ≫ pr_Y = pr_X ≫ p₀ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hp_snd : p_S ≫ Y_S.hom = X_S.hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_X : CategoryTheory.IsPullback pr_X X_S.hom X.hom f₂ :=
    CategoryTheory.IsPullback.of_hasPullback X.hom f₂
  have hpb_Y : CategoryTheory.IsPullback pr_Y Y_S.hom Y.hom f₂ :=
    CategoryTheory.IsPullback.of_hasPullback Y.hom f₂
  have hpb_outer : CategoryTheory.IsPullback pr_X (p_S ≫ Y_S.hom) (p₀ ≫ Y.hom) f₂ := by
    rwa [hp_snd, hp₀_hom]
  have hpb_p : CategoryTheory.IsPullback pr_X p_S p₀ pr_Y :=
    CategoryTheory.IsPullback.of_bot hpb_outer hp_fst.symm hpb_Y
  obtain ⟨hFin_p₀, hCharts_p₀⟩ := hp₀_locFree
  have _ : AlgebraicGeometry.IsFinite p₀ := hFin_p₀
  have hFin_pS : AlgebraicGeometry.IsFinite p_S :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_p inferInstance
  
  have hChart : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of R)))
      (Z_S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of S)))
      (_hZS : Z_S = weilBaseChangeOver R S Z)
      (pr_Z : Z_S.left ⟶ Z.left)
      (_hprZ : pr_Z = _hZS ▸ CategoryTheory.Limits.pullback.fst Z.hom f₂)
      (U₀ : Z.left.Opens) (hAff_U₀ : AlgebraicGeometry.IsAffineOpen U₀)
      (U₁ : Z_S.left.Opens) (hU₁ : U₁ = pr_Z ⁻¹ᵁ U₀),
      let C₀ := ↑(Z.left.presheaf.obj (Opposite.op U₀))
      let C₁ := ↑(Z_S.left.presheaf.obj (Opposite.op U₁))
      let α_Z : CommRingCat.of R ⟶ Z.left.presheaf.obj (Opposite.op U₀) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ Z.hom.appTop ≫
          Z.left.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op
      let _ : Algebra R C₀ := α_Z.hom.toAlgebra
      ∃ (hAff_U₁ : AlgebraicGeometry.IsAffineOpen U₁)
        (r_Z : U₁.toScheme ⟶ U₀.toScheme)
        (e_U₁_hom : U₁.toScheme ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R C₀ S)))
        (ψ_C : TensorProduct R C₀ S ≃+* C₁),
        r_Z ≫ U₀.ι = U₁.ι ≫ pr_Z ∧
        e_U₁_hom ≫ (AlgebraicGeometry.pullbackSpecIso R C₀ S).inv ≫
          CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R C₀))) f₂ =
          r_Z ≫ U₀.toSpecΓ ∧
        e_U₁_hom ≫ (AlgebraicGeometry.pullbackSpecIso R C₀ S).inv ≫
          CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R C₀))) f₂ =
          U₁.ι ≫ Z_S.hom ∧
        U₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_C.toRingHom) =
          e_U₁_hom := by
    intro Z Z_S hZS pr_Z hprZ U₀ hAff_U₀ U₁ hU₁ C₀ C₁ α_Z _
    subst hZS
    subst hprZ
    let Z_S := weilBaseChangeOver R S Z
    let pr_Z : Z_S.left ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom f₂
    let r_Z : U₁.toScheme ⟶ U₀.toScheme := (Z_S.left.isoOfEq hU₁).hom ≫ (pr_Z ∣_ U₀)
    have hpb_Z : CategoryTheory.IsPullback pr_Z Z_S.hom Z.hom f₂ :=
