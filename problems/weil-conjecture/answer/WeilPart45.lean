    simp only [C_K, Matrix.map_apply, ← IsScalarTower.algebraMap_apply (PadicInt ℓ) K L]
  have hRQ_K : R_Q.map (algebraMap ℚ K) = C_K.charpolyRev := by
    apply Polynomial.map_injective (algebraMap K L) (algebraMap K L).injective
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq ℚ K L, hRQ_L]
    dsimp [R_poly, C_Z]
    rw [hCZ_map_L, hcharpolyRev_map]
  let Q_P : Polynomial ℚ :=
    ∑ j ∈ Finset.range (M + 1), Polynomial.monomial j (R_Q.coeff (M - j))
  have hQP_coeff : ∀ j : ℕ, Q_P.coeff j = if j ≤ M then R_Q.coeff (M - j) else 0 := by
    intro j
    dsimp [Q_P]
    rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_monomial]
    by_cases hj : j ≤ M
    · have hj_mem : j ∈ Finset.range (M + 1) := Finset.mem_range.mpr (by omega)
      rw [Finset.sum_eq_single j]
      · simp [hj]
      · intro b _ hbj
        simp [hbj]
      · intro hnot
        exact absurd hj_mem hnot
    · simp only [hj, ↓reduceIte]
      refine Finset.sum_eq_zero fun b hb => ?_
      have hb_le : b ≤ M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hb)
      have hne : b ≠ j := by omega
      simp [hne]
  have hQP_map_K : Q_P.map (algebraMap ℚ K) = C_K.charpoly := by
    ext j
    rw [Polynomial.coeff_map, hQP_coeff j]
    by_cases hj : j ≤ M
    · simp only [hj, ↓reduceIte]
      rw [← Polynomial.coeff_map, hRQ_K, ← Matrix.reverse_charpoly,
        Polynomial.coeff_reverse, hCK_deg, Polynomial.revAt_le (Nat.sub_le M j),
        Nat.sub_sub_self hj]
    · simp only [hj, ↓reduceIte, map_zero]
      exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hCK_deg]; omega)).symm
  have hQP_deg : Q_P.natDegree = M := by
    have hinj : Function.Injective (algebraMap ℚ K) := (algebraMap ℚ K).injective
    rw [← Polynomial.natDegree_map_eq_of_injective hinj Q_P, hQP_map_K, hCK_deg]
  have hQP_mon : Q_P.Monic := by
    rw [Polynomial.Monic]
    apply (algebraMap ℚ K).injective
    have hlc_CK : C_K.charpoly.coeff M = 1 := by
      have h := hCK_mon.leadingCoeff
      rwa [Polynomial.leadingCoeff, hCK_deg] at h
    rw [map_one, Polynomial.leadingCoeff, hQP_deg, ← Polynomial.coeff_map, hQP_map_K, hlc_CK]
  have hRQ_deg_le : R_Q.natDegree ≤ M := by
    have hinj : Function.Injective (algebraMap ℚ K) := (algebraMap ℚ K).injective
    rw [← Polynomial.natDegree_map_eq_of_injective hinj R_Q, hRQ_K, ← Matrix.reverse_charpoly]
    exact (Polynomial.reverse_natDegree_le C_K.charpoly).trans hCK_deg.le
  have hRQ_eq_sum : R_Q = ∑ i ∈ Finset.range (M + 1), Polynomial.monomial i (Q_P.coeff (M - i)) := by
    ext i
    rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_monomial]
    by_cases hi : i ≤ M
    · have hi_mem : i ∈ Finset.range (M + 1) := Finset.mem_range.mpr (by omega)
      rw [Finset.sum_eq_single i]
      · simp only [↓reduceIte, hQP_coeff (M - i), Nat.sub_le, Nat.sub_sub_self hi]
      · intro b _ hbi
        simp [hbi]
      · intro hnot
        exact absurd hi_mem hnot
    · symm
      rw [Finset.sum_eq_zero]
      · exact (Polynomial.coeff_eq_zero_of_natDegree_lt
          (lt_of_le_of_lt hRQ_deg_le (Nat.lt_of_not_ge hi))).symm
      · intro b hb
        have hb_le : b ≤ M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hb)
        have hne : b ≠ i := by omega
        simp [hne]
  let μ_Q : ℚ := (q : ℚ) ^ (n * d)
  have hμ_Q_ne : μ_Q ≠ 0 := pow_ne_zero (n * d) (Nat.cast_ne_zero.mpr (by omega))
  let μ_K : K := algebraMap ℚ K μ_Q
  have hμ_K_eq : μ_K = (q : K) ^ (n * d) := by
    dsimp [μ_K, μ_Q]
    simp only [map_pow, map_natCast]
  have hμ_K_ne : μ_K ≠ 0 := by
    intro h0
    exact hμ_Q_ne ((algebraMap ℚ K).injective (h0.trans (map_zero _).symm))
  let U_J : (Matrix (Fin M) (Fin M) K)ˣ := ((Matrix.isUnit_iff_isUnit_det J).mpr hJ_det.isUnit).unit
  have hUJ_val : U_J.val = J := rfl
  have hCK_inv_eq : C_K⁻¹ = (U_J.val)⁻¹ * (μ_K⁻¹ • C_K.transpose) * U_J.val := by
    rw [← hUnits_inv_val U_J]
    have hmul : ((U_J⁻¹).val * (μ_K⁻¹ • C_K.transpose) * U_J.val) * C_K = 1 := by
      have hsim : C_K.transpose * J * C_K = μ_K • J := by
        rw [hμ_K_eq]
        exact hF_sim d P hP
      calc ((U_J⁻¹).val * (μ_K⁻¹ • C_K.transpose) * U_J.val) * C_K
          = (U_J⁻¹).val * (μ_K⁻¹ • (C_K.transpose * J * C_K)) := by
              change (U_J⁻¹).val * (μ_K⁻¹ • C_K.transpose) * J * C_K = _
              simp only [Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_assoc]
        _ = (U_J⁻¹).val * (μ_K⁻¹ • (μ_K • J)) := by rw [hsim]
        _ = (μ_K⁻¹ * μ_K) • ((U_J⁻¹).val * U_J.val) := by
              rw [smul_smul, Matrix.mul_smul]
              rfl
        _ = 1 := by rw [inv_mul_cancel₀ hμ_K_ne, one_smul, U_J.inv_mul]
    calc C_K⁻¹ = 1 * C_K⁻¹ := (Matrix.one_mul _).symm
      _ = (((U_J⁻¹).val * (μ_K⁻¹ • C_K.transpose) * U_J.val) * C_K) * C_K⁻¹ := by rw [hmul]
      _ = ((U_J⁻¹).val * (μ_K⁻¹ • C_K.transpose) * U_J.val) * (C_K * C_K⁻¹) := Matrix.mul_assoc _ _ _
      _ = (U_J⁻¹).val * (μ_K⁻¹ • C_K.transpose) * U_J.val := by
            rw [Matrix.mul_nonsing_inv C_K hCK_det_unit, Matrix.mul_one]
  have hscale_charpoly : (μ_K⁻¹ • C_K).charpoly =
      (Polynomial.C (μ_Q⁻¹ ^ M) * Q_P.comp (Polynomial.C μ_Q * Polynomial.X)).map (algebraMap ℚ K) := by
    apply Polynomial.funext
    intro x
    rw [Matrix.eval_charpoly]
    have hscal : Matrix.scalar (Fin M) x - μ_K⁻¹ • C_K =
        μ_K⁻¹ • (Matrix.scalar (Fin M) (μ_K * x) - C_K) := by
      ext i j
      by_cases hij : i = j
      · subst hij
        simp [Matrix.scalar_apply, mul_sub, inv_mul_cancel_left₀ hμ_K_ne]
      · simp [Matrix.scalar_apply, hij]
        ring
    rw [hscal, Matrix.det_smul, Fintype.card_fin, ← Matrix.eval_charpoly, ← hQP_map_K,
      Polynomial.map_mul, Polynomial.map_C, Polynomial.map_comp, Polynomial.map_mul,
      Polynomial.map_C, Polynomial.map_X, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
      map_pow, map_inv₀]
  have hinv_char_1 : (C_K⁻¹).charpoly = (μ_K⁻¹ • C_K).charpoly := by
    rw [hCK_inv_eq, Matrix.charpoly_units_conj' U_J (μ_K⁻¹ • C_K.transpose),
      ← Matrix.transpose_smul, Matrix.charpoly_transpose]
  have hinv_char_2 : (C_K⁻¹).charpoly =
      Polynomial.C ((-1 : K) ^ M * Ring.inverse C_K.det) * (R_Q.map (algebraMap ℚ K)) := by
    rw [Matrix.charpoly_inv C_K hCK_unit, Fintype.card_fin, hRQ_K]
    have hneg1 : (-1 : Polynomial K) = Polynomial.C (-1 : K) := by simp
    rw [hneg1, ← map_pow, ← Polynomial.C_mul]
  set c_K : K := (-1 : K) ^ M * Ring.inverse C_K.det
  have hpoly_K : Polynomial.C c_K * (R_Q.map (algebraMap ℚ K)) =
      (Polynomial.C (μ_Q⁻¹ ^ M) * Q_P.comp (Polynomial.C μ_Q * Polynomial.X)).map (algebraMap ℚ K) :=
    hinv_char_2.symm.trans (hinv_char_1.trans hscale_charpoly)
  have hc_K_eq : c_K = algebraMap ℚ K (μ_Q⁻¹ ^ M * Q_P.coeff 0) := by
    have heval0 := congrArg (Polynomial.eval 0) hpoly_K
    have hlhs : (Polynomial.C c_K * (R_Q.map (algebraMap ℚ K))).eval 0 = c_K := by
      rw [Polynomial.eval_mul, Polynomial.eval_C, hRQ_K, Matrix.eval_charpolyRev, mul_one]
    have hrhs : ((Polynomial.C (μ_Q⁻¹ ^ M) * Q_P.comp (Polynomial.C μ_Q * Polynomial.X)).map
        (algebraMap ℚ K)).eval 0 = algebraMap ℚ K (μ_Q⁻¹ ^ M * Q_P.coeff 0) := by
      rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_map,
        Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
        mul_zero, ← Polynomial.coeff_zero_eq_eval_zero]
    rwa [hlhs, hrhs] at heval0
  have hpoly_Q' : Polynomial.C (μ_Q⁻¹ ^ M * Q_P.coeff 0) * R_Q =
      Polynomial.C (μ_Q⁻¹ ^ M) * Q_P.comp (Polynomial.C μ_Q * Polynomial.X) := by
    apply Polynomial.map_injective (algebraMap ℚ K) (algebraMap ℚ K).injective
    rw [Polynomial.map_mul, Polynomial.map_C, ← hc_K_eq]
    exact hpoly_K
  have hRecip_Q : Polynomial.C (Q_P.coeff 0) * R_Q =
      Q_P.comp (Polynomial.C μ_Q * Polynomial.X) := by
    have hmul := congrArg (Polynomial.C (μ_Q ^ M) * ·) hpoly_Q'
    rw [← mul_assoc, ← Polynomial.C_mul, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ hμ_Q_ne,
      one_pow, one_mul, ← mul_assoc, ← Polynomial.C_mul, ← mul_pow, mul_inv_cancel₀ hμ_Q_ne,
      one_pow, Polynomial.C_1, one_mul] at hmul
    exact hmul
  have hQP_c0_ne : Q_P.coeff 0 ≠ 0 := by
    intro hc0
    have h0 : (C_K.charpoly).eval 0 = 0 := by
      rw [← Polynomial.coeff_zero_eq_eval_zero, ← hQP_map_K, Polynomial.coeff_map, hc0, map_zero]
    rw [Matrix.eval_charpoly, map_zero, zero_sub, Matrix.det_neg, Fintype.card_fin] at h0
    exact mul_ne_zero (pow_ne_zero M (neg_ne_zero.mpr one_ne_zero)) hCK_det_unit.ne_zero h0
  have hQP_sum_self : Q_P = ∑ j ∈ Finset.range (M + 1), Polynomial.monomial j (Q_P.coeff j) := by
    apply Polynomial.ext
    intro k
    conv_rhs => rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_monomial]
    by_cases hk : k ≤ M
    · have hk_mem : k ∈ Finset.range (M + 1) := Finset.mem_range.mpr (by omega)
      rw [Finset.sum_eq_single k]
      · simp
      · intro b _ hbk
        simp [hbk]
      · intro hnot
        exact absurd hk_mem hnot
    · symm
      rw [Finset.sum_eq_zero]
      · exact (Polynomial.coeff_eq_zero_of_natDegree_lt
          (lt_of_le_of_lt hQP_deg.le (Nat.lt_of_not_ge hk))).symm
      · intro b hb
        have hb_le : b ≤ M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hb)
        have hne : b ≠ k := by omega
        simp [hne]
  have hReflect_C : ∀ z : ℂ, z ≠ 0 →
      z ^ M * Polynomial.aeval (z⁻¹) R_Q = Polynomial.aeval z Q_P := by
    intro z hz_ne
    conv_lhs => rw [hRQ_eq_sum]
    rw [map_sum, Finset.mul_sum]
    have hcongr : ∑ i ∈ Finset.range (M + 1),
        z ^ M * Polynomial.aeval (z⁻¹) (Polynomial.monomial i (Q_P.coeff (M - i))) =
      ∑ i ∈ Finset.range (M + 1),
        algebraMap ℚ ℂ (Q_P.coeff (M + 1 - 1 - i)) * z ^ (M + 1 - 1 - i) := by
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_le : i ≤ M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hsub : M + 1 - 1 - i = M - i := by omega
      rw [hsub, Polynomial.aeval_monomial]
      have hpow : z ^ M * (z⁻¹) ^ i = z ^ (M - i) := by
        calc z ^ M * (z⁻¹) ^ i = z ^ (M - i + i) * (z⁻¹) ^ i := by rw [Nat.sub_add_cancel hi_le]
          _ = z ^ (M - i) * (z ^ i * (z⁻¹) ^ i) := by rw [pow_add, mul_assoc]
          _ = z ^ (M - i) * (z * z⁻¹) ^ i := by rw [← mul_pow]
          _ = z ^ (M - i) := by rw [mul_inv_cancel₀ hz_ne, one_pow, mul_one]
      calc z ^ M * (algebraMap ℚ ℂ (Q_P.coeff (M - i)) * (z⁻¹) ^ i)
          = algebraMap ℚ ℂ (Q_P.coeff (M - i)) * (z ^ M * (z⁻¹) ^ i) := by ring
        _ = algebraMap ℚ ℂ (Q_P.coeff (M - i)) * z ^ (M - i) := by rw [hpow]
    rw [hcongr, Finset.sum_range_reflect (fun j => algebraMap ℚ ℂ (Q_P.coeff j) * z ^ j) (M + 1)]
    conv_rhs => rw [hQP_sum_self]
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Polynomial.aeval_monomial]
  refine ⟨Q_P, hQP_mon, hQP_deg, hQP_map_K, ?_⟩
  intro z hz
  have hz_eval : Polynomial.aeval z Q_P = 0 := (Polynomial.mem_aroots.mp hz).2
  have hz_ne : z ≠ 0 := by
    intro rfl
    have h0 : algebraMap ℚ ℂ (Q_P.coeff 0) = 0 := by
      rw [← Polynomial.coeff_map, Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_map,
        ← Polynomial.aeval_def]
      exact hz_eval
    exact hQP_c0_ne ((algebraMap ℚ ℂ).injective (h0.trans (map_zero _).symm))
  refine ⟨hz_ne, ?_⟩
  have hprod_zero : z ^ M * Polynomial.aeval (z⁻¹) R_Q = 0 :=
    (hReflect_C z hz_ne).trans hz_eval
  have hz_inv_RQ : Polynomial.aeval (z⁻¹) R_Q = 0 :=
    (mul_eq_zero.mp hprod_zero).resolve_left (pow_ne_zero M hz_ne)
  have hcomp_eval := congrArg (Polynomial.aeval (z⁻¹)) hRecip_Q
  rw [map_mul, Polynomial.aeval_C, hz_inv_RQ, mul_zero, Polynomial.aeval_comp, map_mul,
    Polynomial.aeval_C, Polynomial.aeval_X] at hcomp_eval
  have harg_eq : algebraMap ℚ ℂ μ_Q * z⁻¹ = ((Nat.card F : ℂ) ^ (n * d)) / z := by
    dsimp [μ_Q, q]
    simp only [map_pow, map_natCast, div_eq_mul_inv]
  rw [harg_eq] at hcomp_eval
  exact Polynomial.mem_aroots.mpr ⟨hQP_mon.ne_zero, hcomp_eval.symm⟩

theorem weil_lefschetz_pencil_even_dim_step (K : Type u) [Finite K] [Field K]
    (m : ℕ)
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z.hom]
    (hProjZ : ∃ (N : ℕ) (ι : Z ⟶ weilProjectiveSpaceOver K N),
      AlgebraicGeometry.IsClosedImmersion ι.left)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (M_Z : WeilEllAdicCohomologyModel K Z ℓ (2 * m + 2))
    (γ : AlgebraicClosure (Padic ℓ))
    (hγ : γ ∈ ((M_Z.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    ∃ (K' : Type u) (_ : Finite K') (_ : Field K') (_ : Algebra K K')
      (_ : FiniteDimensional K K'),
      let r := Module.finrank K K'
      γ ^ r = (Nat.card K' : AlgebraicClosure (Padic ℓ)) ^ (m + 1) ∨
      (∃ (H₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K')))
          (_ : AlgebraicGeometry.GeometricallyIrreducible H₀.hom)
          (_ : AlgebraicGeometry.IsProper H₀.hom)
          (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) H₀.hom)
          (_ : ∃ (N' : ℕ) (ι' : H₀ ⟶ weilProjectiveSpaceOver K' N'),
            AlgebraicGeometry.IsClosedImmersion ι'.left)
          (M_H : WeilEllAdicCohomologyModel K' H₀ ℓ (2 * m))
          (α_H : AlgebraicClosure (Padic ℓ)),
        α_H ∈ ((M_H.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) ∧
        γ ^ r = (Nat.card K' : AlgebraicClosure (Padic ℓ)) * α_H) ∨
      WeilSymplecticCurveTracePackage.{u} ℓ (Nat.card K') (2 * m + 1) (γ ^ r) :=
by
  classical
  let L := AlgebraicClosure (Padic ℓ)
  obtain ⟨K₁, hFin₁, hField₁, hAlg₁, hFinDim₁, ⟨P⟩⟩ :=
    weil_veronese_lefschetz_pencil_existence K m Z hProjZ
  let _ : Finite K₁ := hFin₁
  let _ : Field K₁ := hField₁
  let _ : Algebra K K₁ := hAlg₁
  let _ : FiniteDimensional K K₁ := hFinDim₁
  set r₁ := Module.finrank K K₁
  have hchar_K₁ : CharP K₁ (ringChar K) :=
    (RingHom.charP_iff_charP (algebraMap K K₁) (ringChar K)).mp inferInstance
  have hchar_eq : ringChar K₁ = ringChar K :=
    @ringChar.eq K₁ _ (ringChar K) hchar_K₁
  have hℓ₁ : ℓ ≠ ringChar K₁ := by
    rw [hchar_eq]
    exact hℓ
  let g_bc := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))
  have hpb_Z₁ : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst Z.hom g_bc)
      (weilBaseChangeOver K K₁ Z).hom Z.hom g_bc :=
    CategoryTheory.IsPullback.of_hasPullback Z.hom g_bc
  let _ : AlgebraicGeometry.GeometricallyIrreducible (weilBaseChangeOver K K₁ Z).hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z₁ inferInstance
  let _ : AlgebraicGeometry.IsProper (weilBaseChangeOver K K₁ Z).hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z₁ inferInstance
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) (weilBaseChangeOver K K₁ Z).hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Z₁ inferInstance
  let _ : AlgebraicGeometry.GeometricallyIrreducible P.Z_tilde.hom := P.hGeom_Ztilde
  let _ : AlgebraicGeometry.IsProper P.Z_tilde.hom := P.hProp_Ztilde
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) P.Z_tilde.hom := P.hSm_Ztilde
  let _ : AlgebraicGeometry.GeometricallyIrreducible P.Z_u₀.hom := P.hGeom_Zu₀
  let _ : AlgebraicGeometry.IsProper P.Z_u₀.hom := P.hProp_Zu₀
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) P.Z_u₀.hom := P.hSm_Zu₀
  let _ : AlgebraicGeometry.GeometricallyIrreducible P.H₀.hom := P.hGeom_H₀
  let _ : AlgebraicGeometry.IsProper P.H₀.hom := P.hProp_H₀
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) P.H₀.hom := P.hSm_H₀
  let _ : CategoryTheory.IsIso (P.π₀.left ∣_ P.U_axis) := P.hIso_π₀
  obtain ⟨M_Ztilde_pkg, -, -, -⟩ :=
    weil_etale_cohomology_grothendieck_package K₁ P.Z_tilde (2 * m + 2) ℓ hℓ₁
  obtain ⟨M_Zu_pkg, -, hDual_Zu, -⟩ :=
    weil_etale_cohomology_grothendieck_package K₁ P.Z_u₀ (2 * m + 1) ℓ hℓ₁
  obtain ⟨M_H_pkg, -, hDual_H, -⟩ :=
    weil_etale_cohomology_grothendieck_package K₁ P.H₀ (2 * m) ℓ hℓ₁
  let M_Ztilde := M_Ztilde_pkg (2 * m + 2)
  obtain ⟨f_pull, hf_inj, hf_inter⟩ :=
    weil_etale_alteration_pullback_injective K Z (2 * m + 2) K₁ P.Z_tilde P.π₀
      P.hProp_π₀ P.hSurj_π₀ P.U_axis P.hU_axis_ne
      inferInstance inferInstance inferInstance
      ℓ hℓ (2 * m + 2) (by omega) M_Z M_Ztilde
  have hγ' : γ ^ r₁ ∈ ((M_Ztilde.frob).charpoly).aroots L := by
    obtain ⟨g_inv, hg_inv⟩ :=
      LinearMap.exists_leftInverse_of_injective f_pull (LinearMap.ker_eq_bot.mpr hf_inj)
    let Φ_L : Module.End L (TensorProduct (Padic ℓ) L M_Z.V) :=
      LinearMap.baseChange L M_Z.frob
    let Ψ_L : Module.End L (TensorProduct (Padic ℓ) L M_Ztilde.V) :=
      LinearMap.baseChange L M_Ztilde.frob
    let f_L := LinearMap.baseChange L f_pull
    let g_L := LinearMap.baseChange L g_inv
    have hg_L : g_L ∘ₗ f_L = LinearMap.id := by
      rw [← LinearMap.baseChange_comp, hg_inv, LinearMap.baseChange_id]
    have hf_L : Function.Injective f_L := by
      intro x y hxy
      have hgx := congrArg g_L hxy
      simpa only [← LinearMap.comp_apply, hg_L, LinearMap.id_apply] using hgx
