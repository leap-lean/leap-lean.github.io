        let _ : AlgebraicGeometry.SmoothOfRelativeDimension (d * d + d * (i - d)) W.hom := hSmW₀
        have hdim_eq : d * d + d * (i - d) = D := by
          dsimp [D]
          simp only [hid, ↓reduceIte]
          have hsub : d + (i - d) = i := by omega
          rw [← Nat.mul_add, hsub]
        have hdeg_eq : i * d + 0 * (i - d) = D := by
          dsimp [D]
          simp only [hid, ↓reduceIte]
          ring
        obtain ⟨hSmW, M_W, hδ_W⟩ := hTransport hdim_eq hdeg_eq M_W₀ hprod
        refine ⟨W, hGeomW, hPropW, hSmW, hProjW, M_W, ?_⟩
        have hδ_eq : δ = γ ^ d * (1 : L) ^ (i - d) := by
          dsimp [δ, c₀]
          simp only [hid, ↓reduceIte, map_one, one_mul, one_pow, mul_one]
        rwa [hδ_eq]
    obtain ⟨W, hGeomW, hPropW, hSmW, hProjW, M_W, hδ_W⟩ := hMellit
    let _ : AlgebraicGeometry.GeometricallyIrreducible W.hom := hGeomW
    let _ : AlgebraicGeometry.IsProper W.hom := hPropW
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension D W.hom := hSmW
    have hEvenPow : ∀ k : ℕ, 1 ≤ k →
        IsAlgebraic ℚ (δ ^ (2 * k)) ∧
        ∀ θ : ℂ, Polynomial.aeval θ (minpoly ℚ (δ ^ (2 * k))) = 0 →
          (Nat.card K : ℝ) ^ (2 * (k * D)) ≤ (Nat.card K : ℝ) * ‖θ‖ ^ 2 ∧
          ‖θ‖ ^ 2 ≤ (Nat.card K : ℝ) ^ (2 * (k * D) + 1) := by
      intro k hk
      have h2k : 1 ≤ 2 * k := by omega
      obtain ⟨Z_k, hGeomZ, hPropZ, hSmZ₀, hProjZ, M_Z₀, hδ_Z₀⟩ :=
        hPow W D hProjW D M_W δ hδ_W (2 * k) h2k
      let _ : AlgebraicGeometry.GeometricallyIrreducible Z_k.hom := hGeomZ
      let _ : AlgebraicGeometry.IsProper Z_k.hom := hPropZ
      let _ : AlgebraicGeometry.SmoothOfRelativeDimension (D * (2 * k)) Z_k.hom := hSmZ₀
      have hdimZ : D * (2 * k) = 2 * (k * D) := by ring
      obtain ⟨hSmZ, M_Z, hδ_Z⟩ := hTransport hdimZ hdimZ M_Z₀ hδ_Z₀
      let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (k * D)) Z_k.hom := hSmZ
      exact hEven (k * D) K Z_k hProjZ hℓ M_Z (δ ^ (2 * k)) hδ_Z
    exact hSqueeze (Nat.card K) d i hq hd hi γ hEvenPow

theorem weil_algebraic_eigenvalue_descent_and_complex_lift (K : Type) [Field K] [CharZero K]
    (q m d : ℕ) (hq : 2 ≤ q) (hm : 1 ≤ m) (N : ℕ → ℕ)
    (V W : ℕ → Type u)
    [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)] [∀ i, Module.Finite K (V i)]
    [∀ i, AddCommGroup (W i)] [∀ i, Module K (W i)] [∀ i, Module.Finite K (W i)]
    (Φ : ∀ i, V i →ₗ[K] V i) (Ψ : ∀ i, W i →ₗ[K] W i)
    (hV0 : ((Φ 0).charpoly).aroots (AlgebraicClosure K) = {1})
    (hDual : ∀ i ≤ 2 * d,
      (((Φ (2 * d - i)).charpoly).aroots (AlgebraicClosure K)) =
        ((((Φ i).charpoly).aroots (AlgebraicClosure K)).map
          ((q : AlgebraicClosure K) ^ d / ·)))
    (hTr : ∀ n : ℕ, 1 ≤ n →
      (N n : K) =
        ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * LinearMap.trace K (V i) (Φ i ^ n))
    (hInj : ∀ i ≤ 2 * d, ∃ f : V i →ₗ[K] W i,
      Function.Injective f ∧ ∀ v, f ((Φ i ^ m) v) = Ψ i (f v))
    (hPureW : ∀ i ≤ 2 * d, ∀ γ ∈ ((Ψ i).charpoly).aroots (AlgebraicClosure K),
      IsAlgebraic ℚ γ ∧
      ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ γ) = 0 → ‖β‖ = √((q ^ m) ^ i)) :
    ∃ A : ℕ → Multiset ℂ, A 0 = {1} ∧
      (∀ i ≤ 2 * d, A (2 * d - i) = (A i).map ((q : ℂ) ^ d / · : ℂ → ℂ)) ∧
      (∀ n : ℕ, 1 ≤ n →
        (N n : ℂ) =
          ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((A i).map (· ^ n)).sum) ∧
      (∀ i ≤ 2 * d, ∀ α ∈ A i,
        IsAlgebraic ℚ α ∧
        ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ α) = 0 → ‖β‖ = √(q ^ i)) :=
by
  classical
  
  have h_trace_algClosed : ∀ (L' : Type) [Field L'] [IsAlgClosed L'] [DecidableEq L']
      (M : Type u) [AddCommGroup M] [Module L' M] [Module.Finite L' M]
      (T : Module.End L' M) (n : ℕ),
      LinearMap.trace L' M (T ^ n) = ((T.charpoly.roots).map (· ^ n)).sum := by
    intro L' _ _ _ M _ _ _ T n
    have hInt : DirectSum.IsInternal T.maxGenEigenspace :=
      DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
        (Module.End.independent_maxGenEigenspace T)
        (Module.End.iSup_maxGenEigenspace_eq_top T)
    have hrk : ∀ μ : L', Module.finrank L' ↥(T.maxGenEigenspace μ) =
        Multiset.count μ (T.charpoly.roots) := by
      intro μ
      rw [LinearMap.finrank_maxGenEigenspace_eq T μ, Polynomial.count_roots]
    have hmem_supp : ∀ μ : L', T.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ (T.charpoly.roots).toFinset := by
      intro μ
      rw [ne_eq, ← Submodule.finrank_eq_zero, ← ne_eq, ← Nat.pos_iff_ne_zero, hrk μ,
        Multiset.count_pos, Multiset.mem_toFinset]
    have hSupp : {μ : L' | T.maxGenEigenspace μ ≠ ⊥} = ↑((T.charpoly.roots).toFinset) := by
      ext μ
      exact (hmem_supp μ).trans Finset.mem_coe.symm
    have hFin : {μ : L' | T.maxGenEigenspace μ ≠ ⊥}.Finite := by
      rw [hSupp]
      exact Finset.finite_toSet _
    have hFin_eq : hFin.toFinset = (T.charpoly.roots).toFinset := by
      ext μ
      exact hFin.mem_toFinset.trans (hmem_supp μ)
    have hf1 : ∀ μ : L', Set.MapsTo T (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
      fun μ => Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl T) μ
    have hfn : ∀ μ : L', Set.MapsTo (T ^ n) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
      fun μ => Module.End.mapsTo_maxGenEigenspace_of_comm ((Commute.refl T).pow_right n) μ
    rw [LinearMap.trace_eq_sum_trace_restrict' hInt hFin hfn, hFin_eq,
      Finset.sum_multiset_map_count (T.charpoly.roots) (· ^ n)]
    refine Finset.sum_congr rfl fun μ _ => ?_
    let T_μ : Module.End L' ↥(T.maxGenEigenspace μ) := T.restrict (fun x hx => hf1 μ hx)
    have hrestrict_pow : (T ^ n).restrict (hfn μ) = T_μ ^ n := by
      have haux : ∀ (k : ℕ) (hk : Set.MapsTo (T ^ k) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ)),
          (T ^ k).restrict hk = T_μ ^ k := by
        intro k
        induction k with
        | zero =>
          intro hk
          ext x
          rfl
        | succ k ih =>
          intro hk
          have hk' : Set.MapsTo (T ^ k) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
            Module.End.mapsTo_maxGenEigenspace_of_comm ((Commute.refl T).pow_right k) μ
          ext x
          have hx : (T ^ k) x.1 = ((T_μ ^ k) x).1 :=
            congrArg Subtype.val (LinearMap.congr_fun (ih hk') x)
          change (T ^ (k + 1)) x.1 = ((T_μ ^ (k + 1)) x).1
          rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
            LinearMap.comp_apply, LinearMap.comp_apply]
          change T ((T ^ k) x.1) = T ((T_μ ^ k) x).1
          rw [hx]
      exact haux n (hfn μ)
    rw [hrestrict_pow]
    let id_μ : Module.End L' ↥(T.maxGenEigenspace μ) := 1
    let id_M : Module.End L' M := 1
    let ν : Module.End L' ↥(T.maxGenEigenspace μ) := T_μ - μ • id_μ
    have hν_pow : ∀ (k : ℕ) (x : ↥(T.maxGenEigenspace μ)),
        ((ν ^ k) x).1 = (((T - μ • id_M) ^ k) x.1) := by
      intro k
      induction k with
      | zero =>
        intro x
        rfl
      | succ k ih =>
        intro x
        rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
          LinearMap.comp_apply, LinearMap.comp_apply]
        change T ((ν ^ k) x).1 - μ • ((ν ^ k) x).1 =
          T (((T - μ • id_M) ^ k) x.1) - μ • (((T - μ • id_M) ^ k) x.1)
        rw [ih x]
    have hNil : IsNilpotent ν := by
      refine ⟨Module.finrank L' M, ?_⟩
      ext x
      have hx_mem : x.1 ∈ (T.genEigenspace μ) ↑(Module.finrank L' M) := by
        rw [← Module.End.maxGenEigenspace_eq_genEigenspace_finrank T μ]
        exact x.2
      have hx_ker : ((T - μ • id_M) ^ Module.finrank L' M) x.1 = 0 :=
        LinearMap.mem_ker.mp (Module.End.mem_genEigenspace_nat.mp hx_mem)
      simp only [LinearMap.zero_apply, Submodule.coe_zero]
      exact (hν_pow (Module.finrank L' M) x).trans hx_ker
    have hT_eq : T_μ = ν + μ • id_μ := (sub_add_cancel T_μ (μ • id_μ)).symm
    have hComm : Commute ν (μ • id_μ) :=
      (Commute.one_right ν).smul_right μ
    rw [hT_eq, hComm.add_pow n, Finset.sum_range_succ', map_add, map_sum]
    have hsum_zero : ∑ k ∈ Finset.range n,
        LinearMap.trace L' ↥(T.maxGenEigenspace μ)
          (ν ^ (k + 1) * (μ • id_μ) ^ (n - (k + 1)) * ↑(n.choose (k + 1))) = 0 := by
      refine Finset.sum_eq_zero fun k _ => ?_
      set g_k : Module.End L' ↥(T.maxGenEigenspace μ) :=
        (μ • id_μ) ^ (n - (k + 1)) * ↑(n.choose (k + 1))
      have hcomm_gk : Commute (ν ^ (k + 1)) g_k :=
        ((hComm.pow_left (k + 1)).pow_right (n - (k + 1))).mul_right
          (Nat.commute_cast (ν ^ (k + 1)) (n.choose (k + 1)))
      have hnil_prod : IsNilpotent (ν ^ (k + 1) * g_k) :=
        hcomm_gk.isNilpotent_mul_right (IsNilpotent.pow_succ k hNil)
      rw [mul_assoc]
      exact isNilpotent_iff_eq_zero.mp (LinearMap.isNilpotent_trace_of_isNilpotent hnil_prod)
    rw [hsum_zero, zero_add, pow_zero, one_mul, Nat.choose_zero_right, Nat.cast_one, mul_one]
    change LinearMap.trace L' ↥(T.maxGenEigenspace μ)
      ((μ • (1 : Module.End L' ↥(T.maxGenEigenspace μ))) ^ n) = _
    rw [smul_pow, one_pow, map_smul, LinearMap.trace_one, hrk μ, smul_eq_mul, nsmul_eq_mul,
      mul_comm]
  let L := AlgebraicClosure K
  let R : ℕ → Multiset L := fun i => ((Φ i).charpoly).aroots L
  have hR0 : R 0 = {1} := hV0
  have hRDual : ∀ i ≤ 2 * d, R (2 * d - i) = (R i).map ((q : L) ^ d / ·) := hDual
  
  have h_step1 : ∀ (i : ℕ), i ≤ 2 * d →
      ∀ α ∈ R i, α ^ m ∈ ((Ψ i).charpoly).aroots L := by
    intro i hi α hα
    obtain ⟨f, hf, hInter⟩ := hInj i hi
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective f (LinearMap.ker_eq_bot.mpr hf)
    let Φ_L : Module.End L (TensorProduct K L (V i)) := LinearMap.baseChange L (Φ i)
    let Ψ_L : Module.End L (TensorProduct K L (W i)) := LinearMap.baseChange L (Ψ i)
    let f_L := LinearMap.baseChange L f
    let g_L := LinearMap.baseChange L g
    have hg_L : g_L ∘ₗ f_L = LinearMap.id := by
      rw [← LinearMap.baseChange_comp, hg, LinearMap.baseChange_id]
    have hf_L : Function.Injective f_L := by
      intro x y hxy
      have hgx := congrArg g_L hxy
      simpa only [← LinearMap.comp_apply, hg_L, LinearMap.id_apply] using hgx
    have hInter_comp : f ∘ₗ (Φ i ^ m) = Ψ i ∘ₗ f := LinearMap.ext hInter
    have hInter_L : f_L ∘ₗ (Φ_L ^ m) = Ψ_L ∘ₗ f_L := by
      rw [← LinearMap.baseChange_pow, ← LinearMap.baseChange_comp, hInter_comp,
        LinearMap.baseChange_comp]
    have hα_roots : α ∈ (Φ_L.charpoly).roots := by
      rw [LinearMap.charpoly_baseChange, ← Polynomial.aroots_def]
      exact hα
    have hα_isRoot : (Φ_L.charpoly).IsRoot α :=
      (Polynomial.mem_roots (LinearMap.charpoly_monic Φ_L).ne_zero).mp hα_roots
    have hα_eigen : Φ_L.HasEigenvalue α :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly Φ_L α).mpr hα_isRoot
    obtain ⟨v, hv⟩ := hα_eigen.exists_hasEigenvector
    have hw_ne : f_L v ≠ 0 := by
      intro h0
      exact hv.2 (hf_L (h0.trans (map_zero f_L).symm))
    have hw_eq : Ψ_L (f_L v) = (α ^ m) • (f_L v) := by
      calc Ψ_L (f_L v) = (Ψ_L ∘ₗ f_L) v := rfl
        _ = (f_L ∘ₗ (Φ_L ^ m)) v := by rw [← hInter_L]
        _ = f_L ((Φ_L ^ m) v) := rfl
        _ = f_L ((α ^ m) • v) := by rw [hv.pow_apply m]
        _ = (α ^ m) • f_L v := map_smul f_L (α ^ m) v
    have hw_eigenvec : Ψ_L.HasEigenvector (α ^ m) (f_L v) :=
      ⟨Module.End.mem_eigenspace_iff.mpr hw_eq, hw_ne⟩
    have hw_eigenval : Ψ_L.HasEigenvalue (α ^ m) :=
      Module.End.hasEigenvalue_of_hasEigenvector hw_eigenvec
    have hw_isRoot : (Ψ_L.charpoly).IsRoot (α ^ m) :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly Ψ_L (α ^ m)).mp hw_eigenval
    have hw_roots : α ^ m ∈ (Ψ_L.charpoly).roots :=
      (Polynomial.mem_roots (LinearMap.charpoly_monic Ψ_L).ne_zero).mpr hw_isRoot
    rw [Polynomial.aroots_def, ← LinearMap.charpoly_baseChange]
    exact hw_roots
  
  have h_step2 : ∀ (i : ℕ) (α : L),
      IsAlgebraic ℚ (α ^ m) →
      (∀ β : ℂ, Polynomial.aeval β (minpoly ℚ (α ^ m)) = 0 → ‖β‖ = √((q ^ m) ^ i)) →
      IsAlgebraic ℚ α ∧
        ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ α) = 0 → ‖β‖ = √(q ^ i) := by
    intro i α hAlg hNorm
    let p : Polynomial ℚ := minpoly ℚ (α ^ m)
    have hp_monic : p.Monic := minpoly.monic hAlg.isIntegral
    have hp_aeval : Polynomial.aeval (α ^ m) p = 0 := minpoly.aeval ℚ (α ^ m)
    let Q : Polynomial ℚ := p.comp (Polynomial.X ^ m)
    have hQ_monic : Q.Monic := by
      apply hp_monic.comp (Polynomial.monic_X_pow m)
      rw [Polynomial.natDegree_X_pow]
      omega
    have hQ_aeval : Polynomial.aeval α Q = 0 := by
      simp only [Q, Polynomial.aeval_comp, map_pow, Polynomial.aeval_X, hp_aeval]
    refine ⟨⟨Q, hQ_monic.ne_zero, hQ_aeval⟩, fun β hβ => ?_⟩
    obtain ⟨R_poly, hQR⟩ := minpoly.dvd ℚ α hQ_aeval
    have hβm : Polynomial.aeval (β ^ m) p = 0 := by
      have h1 : Polynomial.aeval β Q = Polynomial.aeval (β ^ m) p := by
        simp only [Q, Polynomial.aeval_comp, map_pow, Polynomial.aeval_X]
      rw [← h1, hQR, map_mul, hβ, zero_mul]
    have hnorm_βm : ‖β‖ ^ m = √((q ^ m) ^ i) := by
      rw [← norm_pow]
      exact hNorm (β ^ m) hβm
    have hsq : (‖β‖ ^ 2) ^ m = ((q : ℝ) ^ i) ^ m := by
      calc (‖β‖ ^ 2) ^ m = (‖β‖ ^ m) ^ 2 := by ring
        _ = (√((q ^ m) ^ i)) ^ 2 := by rw [hnorm_βm]
        _ = ((q ^ m) ^ i : ℝ) := Real.sq_sqrt (by positivity)
        _ = ((q : ℝ) ^ i) ^ m := by ring
    have hsq_eq : ‖β‖ ^ 2 = (q : ℝ) ^ i :=
      (pow_left_inj₀ (sq_nonneg ‖β‖) (by positivity) (by omega)).mp hsq
    symm
    rw [Real.sqrt_eq_iff_eq_sq (by positivity) (norm_nonneg β)]
    exact hsq_eq.symm
  
  have h_step3 : ∀ (i n : ℕ),
      algebraMap K L (LinearMap.trace K (V i) (Φ i ^ n)) =
        ((R i).map (· ^ n)).sum := by
    intro i n
    let T : Module.End (AlgebraicClosure K) (TensorProduct K (AlgebraicClosure K) (V i)) :=
      LinearMap.baseChange (AlgebraicClosure K) (Φ i)
    have htr_bc : algebraMap K (AlgebraicClosure K) (LinearMap.trace K (V i) (Φ i ^ n)) =
        LinearMap.trace (AlgebraicClosure K) (TensorProduct K (AlgebraicClosure K) (V i))
          (T ^ n) := by
      rw [← LinearMap.trace_baseChange (Φ i ^ n) (AlgebraicClosure K), LinearMap.baseChange_pow]
    have hroots_bc : R i = (T.charpoly).roots := by
      dsimp only [R, L]
      rw [Polynomial.aroots_def, LinearMap.charpoly_baseChange]
    dsimp only [L]
    rw [htr_bc, hroots_bc]
    exact h_trace_algClosed (AlgebraicClosure K)
      (TensorProduct K (AlgebraicClosure K) (V i)) T n
  
  have hRPure : ∀ i ≤ 2 * d, ∀ x ∈ R i,
      IsAlgebraic ℚ x ∧
      ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ x) = 0 → ‖β‖ = √(q ^ i) := by
    intro i hi x hx
    have hxm := h_step1 i hi x hx
    obtain ⟨hAlg_m, hNorm_m⟩ := hPureW i hi (x ^ m) hxm
    exact h_step2 i x hAlg_m hNorm_m
  let S : Set L := {x : L | ∃ i ≤ 2 * d, x ∈ R i}
  let E : IntermediateField ℚ L := IntermediateField.adjoin ℚ S
  have hAlgE : Algebra.IsAlgebraic ℚ ↥E := by
    rw [IntermediateField.isAlgebraic_adjoin_iff_isAlgebraic]
    rintro x ⟨i, hi, hx⟩
    exact (hRPure i hi x hx).1
  let σ : ↥E →ₐ[ℚ] ℂ := IsAlgClosed.lift
  let ι : ↥E →ₐ[ℚ] L := E.val
  have hσ : Function.Injective σ := σ.toRingHom.injective
  have hι : Function.Injective ι := Subtype.val_injective
  let R_E : ℕ → Multiset ↥E := fun i =>
    if hi : i ≤ 2 * d then
      (R i).pmap (fun x hx => ⟨x, IntermediateField.subset_adjoin ℚ S ⟨i, hi, hx⟩⟩)
        (fun _ hx => hx)
    else 0
  have hR_E_ι : ∀ i ≤ 2 * d, (R_E i).map ι = R i := by
    intro i hi
    simp only [R_E, hi, ↓reduceDIte, Multiset.map_pmap]
    change Multiset.pmap (fun a _ => a) (R i) (fun _ hx => hx) = R i
    rw [Multiset.pmap_eq_map]
    exact Multiset.map_id' (R i)
  let A : ℕ → Multiset ℂ := fun i => (R_E i).map σ
  refine ⟨A, ?_, ?_, ?_, ?_⟩
  · have h0 : 0 ≤ 2 * d := Nat.zero_le (2 * d)
    have hRE0 : R_E 0 = {1} := by
      apply Multiset.map_injective hι
      rw [hR_E_ι 0 h0, Multiset.map_singleton, map_one]
      exact hR0
    simp only [A, hRE0, Multiset.map_singleton, map_one]
  · intro i hi
    have hi' : 2 * d - i ≤ 2 * d := Nat.sub_le (2 * d) i
    have hRE_dual : R_E (2 * d - i) = (R_E i).map ((q : ↥E) ^ d / ·) := by
      apply Multiset.map_injective hι
      rw [hR_E_ι (2 * d - i) hi', hRDual i hi, ← hR_E_ι i hi, Multiset.map_map, Multiset.map_map]
      refine Multiset.map_congr rfl fun y _ => ?_
      simp only [Function.comp_apply, map_div₀, map_pow, map_natCast]
    simp only [A, hRE_dual, Multiset.map_map]
    refine Multiset.map_congr rfl fun y _ => ?_
    simp only [Function.comp_apply, map_div₀, map_pow, map_natCast]
  · intro n hn
    let z_E : ↥E := ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((R_E i).map (· ^ n)).sum
    have hι_eq : ι (N n : ↥E) = ι z_E := by
      rw [map_natCast]
      have hL := congrArg (algebraMap K L) (hTr n hn)
      rw [map_natCast, map_sum] at hL
      rw [hL]
      simp only [z_E, map_sum, map_mul, map_pow, map_neg, map_one, map_multiset_sum]
      refine Finset.sum_congr rfl fun i hi => ?_
      rw [h_step3 i n]
      have hmap : ((R_E i).map (· ^ n)).map ι = (R i).map (· ^ n) := by
        rw [← hR_E_ι i (Finset.mem_Iic.mp hi), Multiset.map_map, Multiset.map_map]
        refine Multiset.map_congr rfl fun x _ => ?_
        simp only [Function.comp_apply, map_pow]
      rw [hmap]
    have hz_eq : (N n : ↥E) = z_E := hι hι_eq
    calc (N n : ℂ) = σ (N n : ↥E) := (map_natCast σ (N n)).symm
      _ = σ z_E := by rw [hz_eq]
      _ = ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((A i).map (· ^ n)).sum := by
        simp only [z_E, map_sum, map_mul, map_pow, map_neg, map_one, map_multiset_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        have hmap_σ : ((R_E i).map (· ^ n)).map σ = (A i).map (· ^ n) := by
          simp only [A, Multiset.map_map]
          refine Multiset.map_congr rfl fun y _ => ?_
          simp only [Function.comp_apply, map_pow]
        rw [hmap_σ]
  · intro i hi α hα
    obtain ⟨y, hy, rfl⟩ := Multiset.mem_map.mp hα
    have hιy : ι y ∈ R i := by
      rw [← hR_E_ι i hi]
      exact Multiset.mem_map_of_mem ι hy
    obtain ⟨hAlg_x, hNorm_x⟩ := hRPure i hi (ι y) hιy
    have hAlg_y : IsAlgebraic ℚ y := (isAlgebraic_algHom_iff ι hι).mp hAlg_x
    have hAlg_σy : IsAlgebraic ℚ (σ y) := (isAlgebraic_algHom_iff σ hσ).mpr hAlg_y
    have hmin : minpoly ℚ (σ y) = minpoly ℚ (ι y) := by
      rw [minpoly.algHom_eq σ hσ y, minpoly.algHom_eq ι hι y]
    refine ⟨hAlg_σy, fun β hβ => hNorm_x β ?_⟩
    rwa [← hmin]

