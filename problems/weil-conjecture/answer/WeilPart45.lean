        CategoryTheory.CategoryStruct.comp (τ_𝒦s b) (τ_K_sh_le a b h) := by
    intro a b h h'
    have hne : a ≠ b + 1 := by omega
    dsimp [τ_K_sh_le]
    rw [dite_cond_eq_false (eq_false hne)]
  have hsh_le_triv : ∀ (a b : ℕ) (h : a ≤ b) (W : D_bar.Etale)
      (sec : ↑((𝒦_s b).obj.obj (Opposite.op W))) (y),
