        (h0_sh a b)).ShortExact := by
    intro a b
    let m_top := b + a + 1
    let h_b_le : b ≤ m_top := Nat.le_succ_of_le (Nat.le_add_right b a)
    refine hLocShortExact (𝒥_bar a) (𝒥_bar m_top) (𝒥_bar b)
