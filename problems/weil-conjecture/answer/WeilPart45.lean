          (M_Zu i) (M_Zu (2 * (2 * m + 1) - i)) β hβ_i
      obtain ⟨hj_open, hj_hom, hsinf_sec, hsinf_compl, hU₀_eq, hu₀_mem, hSm_U₀, _⟩ := hSing
      have hRat : ∃ (α_num' β_den' : List L),
          (∀ α ∈ α_num', α ≠ 0) ∧ (∀ β ∈ β_den', β ≠ 0) ∧
          ∀ (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
            1 ≤ d →
              ∃ A_Q B_Q : Polynomial ℚ,
                A_Q.coeff 0 = 1 ∧ B_Q.coeff 0 = 1 ∧
                (A_Q.map (algebraMap ℚ L)) *
                  (β_den'.map (fun β => 1 - Polynomial.C (β ^ d) * Polynomial.X)).prod =
                (B_Q.map (algebraMap ℚ L)) *
                  (α_num'.map (fun α => 1 - Polynomial.C (α ^ d) * Polynomial.X)).prod *
                  (((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) L)).charpolyRev) := by
        refine ⟨α_num, β_den, hα_ne, hβ_ne, fun d P_poly hP hd => ?_⟩
        have hMon : P_poly.Monic := hP.1
        have hIrr : Irreducible P_poly := hP.2.1
        have hAvoid : ∀ s ∈ S_aff, P_poly.eval s ≠ 0 := hP.2.2.2
        have _ : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
        let pb_P : PowerBasis F (AdjoinRoot P_poly) := AdjoinRoot.powerBasis' hMon
        have _ : FiniteDimensional F (AdjoinRoot P_poly) := PowerBasis.finite pb_P
        have hFin_P : Finite (AdjoinRoot P_poly) := Module.finite_of_finite F
        let _ : Finite (AdjoinRoot P_poly) := hFin_P
        have hchar_FP : CharP (AdjoinRoot P_poly) (ringChar F) :=
          (RingHom.charP_iff_charP (algebraMap F (AdjoinRoot P_poly)) (ringChar F)).mp inferInstance
        have hchar_eq : ringChar (AdjoinRoot P_poly) = ringChar F :=
          @ringChar.eq (AdjoinRoot P_poly) _ (ringChar F) hchar_FP
        have hℓ_P : ℓ ≠ ringChar (AdjoinRoot P_poly) := by
          rw [hchar_eq]
          exact hℓ
        set x_P : AlgebraicGeometry.Spec (CommRingCat.of (AdjoinRoot P_poly)) ⟶
            (weilProjectiveSpaceOver F 1).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AdjoinRoot.mk P_poly)) ≫ j_aff
        set Z_P := weilTransvTriClosedPointFiber F P.f₀ j_aff P_poly
        let fst_ZP : Z_P.left ⟶ P.Z_tilde.left := CategoryTheory.Limits.pullback.fst P.f₀.left x_P
        have hpb_ZP : CategoryTheory.IsPullback fst_ZP Z_P.hom P.f₀.left x_P :=
          CategoryTheory.IsPullback.of_hasPullback P.f₀.left x_P
        have _ : AlgebraicGeometry.IsProper Z_P.hom :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_ZP inferInstance
        have hx_range : Set.range x_P.base ⊆ Set.range U₀.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨pt, rfl⟩
          rw [hU₀_eq]
          refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AdjoinRoot.mk P_poly))).base pt,
            ?_, rfl⟩
          intro a ha hmem
          have hmk_mem : AdjoinRoot.mk P_poly (Polynomial.X - Polynomial.C a) ∈ pt.asIdeal := hmem
          have hne : AdjoinRoot.mk P_poly (Polynomial.X - Polynomial.C a) ≠ 0 := by
            intro hzero
            obtain ⟨Q, hQ⟩ := (AdjoinRoot.mk_eq_zero).mp hzero
            have hUnitQ : IsUnit Q :=
              ((Polynomial.irreducible_X_sub_C a).isUnit_or_isUnit hQ).resolve_left hIrr.not_isUnit
            have hev := congrArg (Polynomial.eval a) hQ
            simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self,
              Polynomial.eval_mul] at hev
            have hUnitEv : IsUnit (Q.eval a) := hUnitQ.map (Polynomial.evalRingHom a)
            exact hAvoid a ha ((mul_eq_zero.mp hev.symm).resolve_right hUnitEv.ne_zero)
          exact pt.isPrime.ne_top
            (Ideal.eq_top_of_isUnit_mem pt.asIdeal hmk_mem (isUnit_iff_ne_zero.mpr hne))
        let x_U₀ : AlgebraicGeometry.Spec (CommRingCat.of (AdjoinRoot P_poly)) ⟶ U₀.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift U₀.ι x_P hx_range
        have hx_U₀ : x_U₀ ≫ U₀.ι = x_P :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι x_P hx_range
        have hpb_res := (AlgebraicGeometry.isPullback_morphismRestrict P.f₀.left U₀).flip
        have hcond_res : fst_ZP ≫ P.f₀.left = (Z_P.hom ≫ x_U₀) ≫ U₀.ι := by
          rw [CategoryTheory.Category.assoc, hx_U₀]
          exact hpb_ZP.w
        let ι' : Z_P.left ⟶ (P.f₀.left ⁻¹ᵁ U₀).toScheme :=
          hpb_res.lift fst_ZP (Z_P.hom ≫ x_U₀) hcond_res
        have hι'_fst : ι' ≫ (P.f₀.left ⁻¹ᵁ U₀).ι = fst_ZP := hpb_res.lift_fst _ _ _
        have hpb_outer : CategoryTheory.IsPullback (ι' ≫ (P.f₀.left ⁻¹ᵁ U₀).ι) Z_P.hom P.f₀.left
            (x_U₀ ≫ U₀.ι) := by
          rw [hι'_fst, hx_U₀]
          exact hpb_ZP
        have hpb_left : CategoryTheory.IsPullback ι' Z_P.hom (P.f₀.left ∣_ U₀) x_U₀ :=
          CategoryTheory.IsPullback.of_right hpb_outer (hpb_res.lift_snd _ _ _) hpb_res
        have _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_P.hom :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_left hSm_U₀
        have _ : AlgebraicGeometry.GeometricallyIrreducible Z_P.hom := by
          rw [AlgebraicGeometry.geometricallyIrreducible_iff]
          intro K _ y Z fst snd hpb_Z
          let Ω := AlgebraicClosure K
          let u : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
              AlgebraicGeometry.Spec (CommRingCat.of K) :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K Ω))
          have hu_surj : AlgebraicGeometry.Surjective u :=
            ⟨fun _ => ⟨default, Subsingleton.elim _ _⟩⟩
          have hpb_u := CategoryTheory.IsPullback.of_hasPullback snd u
          have hpr_surj : AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst snd u) :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_u.flip hu_surj
          have hpb_paste := (hpb_u.paste_horiz hpb_Z).paste_horiz hpb_ZP
          let e := hpb_paste.isoPullback
          let q := e.inv ≫ CategoryTheory.Limits.pullback.fst snd u
          have _ : IrreducibleSpace ↥(CategoryTheory.Limits.pullback P.f₀.left ((u ≫ y) ≫ x_P)) :=
            P.hFibIrred_f₀ Ω ((u ≫ y) ≫ x_P)
          have hsurj_e : Function.Surjective e.inv.base := fun z =>
            ⟨e.hom.base z, by
              change (e.hom ≫ e.inv).base z = z
              rw [e.hom_inv_id]
              rfl⟩
          have hsurj_q : Function.Surjective q.base := hpr_surj.1.comp hsurj_e
          refine @IrreducibleSpace.mk _ _ ⟨?_⟩ (Nonempty.map q.base inferInstance)
          rw [← Set.image_univ_of_surjective hsurj_q]
          exact PreirreducibleSpace.isPreirreducible_univ.image q.base
            (AlgebraicGeometry.Scheme.Hom.continuous q).continuousOn
        obtain ⟨_, Z_ser, hZ0, hZ_ode⟩ :=
          weil_zeta_powerSeries_integrality (AdjoinRoot P_poly) Z_P
        obtain ⟨M_ZP, -, -, hTr_ZP⟩ :=
          weil_etale_cohomology_grothendieck_package (AdjoinRoot P_poly) Z_P (2 * m + 1) ℓ hℓ_P
        have hN_tr : ∀ k : ℕ, 1 ≤ k →
            (weilPointCount (AdjoinRoot P_poly) Z_P k : L) =
              ((β_den.map (· ^ d)).map (· ^ k)).sum -
                ((α_num.map (· ^ d)).map (· ^ k)).sum -
                Matrix.trace (((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) L)) ^ k) := by
          intro k hk
          have h1 := congrArg (algebraMap (Padic ℓ) L) (hTr_ZP k hk)
          rw [map_natCast] at h1
          exact h1.trans (hFibTr d P_poly hP hd hFin_P M_ZP k hk)
        obtain ⟨A_Q, B_Q, hA0, hB0, hAB⟩ :=
          weil_transv_powerSeries_rational_charpolyRev_descent L M
            (weilPointCount (AdjoinRoot P_poly) Z_P) Z_ser hZ0 hZ_ode
            (α_num.map (· ^ d)) (β_den.map (· ^ d))
            ((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) L)) hN_tr
        simp only [List.map_map] at hAB
        exact ⟨A_Q, B_Q, hA0, hB0, hAB⟩
      obtain ⟨hSys_V₁, hSys_V₂ₖ⟩ :=
        weil_transv_affine_curve_tower_duality_and_trace F S_aff j_aff hj_open hj_hom
          s_inf hsinf_sec hsinf_compl U₀ hU₀_eq P.u₀ P.hu₀_sec hu₀_mem
          ℓ M (2 * m + 1) hℓ hM J hJ_skew hJ_det G_geom hG_sp F_u hFu_norm hFu_sim
          F_mat hF_sim ℒ₀ τ_ℒ hTower W_mid γ' hγ'_ne hγ'_mid
      exact ⟨S_aff, hγ'_ne, M, hM, J, G_geom, F_u, F_mat, hJ_skew, hJ_det, hG_sp,
        ⟨Δ, hΔ_ne, hΔ_nz, hΔ_inv, hΔ_simple, hΔ_transv⟩,
        hFu_norm, hFu_sim, hF_sim, hCov, hRat, hSys_V₁, hSys_V₂ₖ⟩

theorem weil_kazhdan_margulis_transvection_sp_open (ℓ M : ℕ) [Fact (Nat.Prime ℓ)]
    (hM : 1 ≤ M)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (hJ_skew : J.transpose = -J)
    (hJ_det : J.det ≠ 0)
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (hG_sp : ∀ g ∈ G_geom,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J)
    (hG_transv : ∃ Δ : Set (Fin M → Padic ℓ),
      Δ.Nonempty ∧ (∀ v ∈ Δ, v ≠ 0) ∧
      (∀ g ∈ G_geom, ∀ v ∈ Δ,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v ∈ Δ) ∧
      (∀ U_sub : Submodule (Padic ℓ) (Fin M → Padic ℓ),
        (∀ v ∈ Δ, ∀ u ∈ U_sub, (dotProduct u (J.mulVec v)) • v ∈ U_sub) →
        U_sub = ⊥ ∨ U_sub = ⊤) ∧
      (∀ v ∈ Δ, ∀ t : PadicInt ℓ,
        ∃ g ∈ G_geom,
          ∀ x : Fin M → Padic ℓ,
            ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v)) :
    ∃ r₀ : ℕ, 1 ≤ r₀ ∧
      ∀ B : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ,
        (B.val).map (PadicInt.toZModPow r₀) = 1 →
        ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J →
        B ∈ G_geom :=
by
  classical
  rcases hG_transv with ⟨Δ, hΔ_ne, hΔ_nz, hΔ_inv, hΔ_simple, hΔ_transv⟩
  let R := PadicInt ℓ
  let K := Padic ℓ
  let ι : R →+* K := algebraMap R K
  let ψ : (Fin M → K) → (Fin M → K) → K := fun x y => dotProduct x (J.mulVec y)
  let N_of : (Fin M → K) → Matrix (Fin M) (Fin M) K :=
    fun v => Matrix.of (fun i j => v i * (J.mulVec v) j)
  let S_of : (Fin M → K) → (Fin M → K) → Matrix (Fin M) (Fin M) K :=
    fun x y => N_of (x + y) - N_of x - N_of y
  let 𝔐 : Submodule K (Matrix (Fin M) (Fin M) K) := Submodule.span K (N_of '' Δ)

  have hJ_entry : ∀ i j : Fin M, J j i = -J i j := by
    intro i j
    have h := congrFun (congrFun hJ_skew i) j
    simpa [Matrix.transpose_apply] using h

  have hψ_skew : ∀ x y : Fin M → K, ψ y x = -ψ x y := by
    intro x y
    dsimp [ψ, dotProduct, Matrix.mulVec]
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hJ_entry i j]
    ring

  have hψ_add_right : ∀ x y₁ y₂ : Fin M → K, ψ x (y₁ + y₂) = ψ x y₁ + ψ x y₂ := by
    intro x y₁ y₂
    dsimp [ψ]
    rw [Matrix.mulVec_add, dotProduct_add]

  have hS_apply : ∀ (x y : Fin M → K) (i j : Fin M),
      S_of x y i j = x i * (J.mulVec y) j + y i * (J.mulVec x) j := by
    intro x y i j
    change (x i + y i) * (J.mulVec (x + y)) j - x i * (J.mulVec x) j - y i * (J.mulVec y) j = _
    rw [Matrix.mulVec_add, Pi.add_apply]
    ring

  have hN_comm : ∀ u v : Fin M → K,
      N_of u * N_of v - N_of v * N_of u = (ψ v u) • S_of u v := by
    intro u v
    ext i j
    have hmul : ∀ a b : Fin M → K, (N_of a * N_of b) i j = ψ b a * a i * (J.mulVec b) j := by
      intro a b
      dsimp [N_of, ψ, dotProduct]
      rw [Matrix.mul_apply]
      calc ∑ r : Fin M, (a i * (J.mulVec a) r) * (b r * (J.mulVec b) j)
          = ∑ r : Fin M, (b r * (J.mulVec a) r) * (a i * (J.mulVec b) j) := by
              refine Finset.sum_congr rfl fun r _ => by ring
        _ = (∑ r : Fin M, b r * (J.mulVec a) r) * (a i * (J.mulVec b) j) := by
              rw [← Finset.sum_mul]
        _ = (∑ r : Fin M, b r * (J.mulVec a) r) * a i * (J.mulVec b) j := by ring
    simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, hmul, hS_apply]
    rw [hψ_skew v u]
    ring

  have hΔ_pm : ∀ u ∈ Δ, ∀ v ∈ Δ, u + (ψ u v) • v ∈ Δ ∧ u - (ψ u v) • v ∈ Δ := by
    intro u hu v hv
    constructor
    · obtain ⟨g₁, hg₁, hg₁_eq⟩ := hΔ_transv v hv (1 : PadicInt ℓ)
      have hmem := hΔ_inv g₁ hg₁ u hu
      rw [hg₁_eq u] at hmem
      have hc1 : ((1 : PadicInt ℓ) : K) = 1 := PadicInt.coe_one
      rw [hc1, one_mul] at hmem
      exact hmem
    · obtain ⟨gm, hgm, hgm_eq⟩ := hΔ_transv v hv (-1 : PadicInt ℓ)
      have hmem := hΔ_inv gm hgm u hu
      rw [hgm_eq u] at hmem
      have hcm : ((-1 : PadicInt ℓ) : K) = -1 := by rw [PadicInt.coe_neg, PadicInt.coe_one]
      have hvec : u + (((-1 : PadicInt ℓ) : K) * dotProduct u (J.mulVec v)) • v = u - (ψ u v) • v := by
        rw [hcm]
        ext i
        change u i + (-1 : K) * ψ u v * v i = u i - ψ u v * v i
        ring
      rwa [hvec] at hmem

  have h2_ne : (2 : K) ≠ 0 := two_ne_zero

  have hN_comm_delta : ∀ u ∈ Δ, ∀ v ∈ Δ, N_of u * N_of v - N_of v * N_of u ∈ 𝔐 := by
    intro u hu v hv
    obtain ⟨h_plus, h_minus⟩ := hΔ_pm u hu v hv
    set c : K := ψ u v
    have h_id : N_of u * N_of v - N_of v * N_of u =
        (-(2 : K)⁻¹) • (N_of (u + c • v) - N_of (u - c • v)) := by
      rw [hN_comm u v, hψ_skew u v]
      ext i j
      simp only [N_of, Matrix.smul_apply, Matrix.sub_apply, Matrix.of_apply, smul_eq_mul,
        hS_apply, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, Matrix.mulVec_add,
        Matrix.mulVec_sub, Matrix.mulVec_smul]
      have hcalc : (u i + c * v i) * ((J.mulVec u) j + c * (J.mulVec v) j) -
          (u i - c * v i) * ((J.mulVec u) j - c * (J.mulVec v) j) =
          (2 : K) * (c * (u i * (J.mulVec v) j + v i * (J.mulVec u) j)) := by ring
      rw [hcalc]
      dsimp [c]
      rw [neg_mul, neg_mul, inv_mul_cancel_left₀ h2_ne]
    rw [h_id]
    refine 𝔐.smul_mem (-(2 : K)⁻¹) (𝔐.sub_mem ?_ ?_)
    · exact Submodule.subset_span ⟨u + c • v, h_plus, rfl⟩
    · exact Submodule.subset_span ⟨u - c • v, h_minus, rfl⟩

  have h𝔐_lie_gen : ∀ A ∈ 𝔐, ∀ v ∈ Δ, A * N_of v - N_of v * A ∈ 𝔐 := by
    intro A hA v hv
    refine Submodule.span_induction
      (p := fun X _ => X * N_of v - N_of v * X ∈ 𝔐)
      (fun X hX => ?_) ?_ (fun X Y _ _ hX hY => ?_) (fun a X _ hX => ?_) hA
    · rcases hX with ⟨u, hu, rfl⟩
      exact hN_comm_delta u hu v hv
    · simp only [zero_mul, mul_zero, sub_self, 𝔐.zero_mem]
    · have h_add : (X + Y) * N_of v - N_of v * (X + Y) =
          (X * N_of v - N_of v * X) + (Y * N_of v - N_of v * Y) := by
        rw [add_mul, mul_add]; abel
      rw [h_add]
      exact 𝔐.add_mem hX hY
    · have h_smul : (a • X) * N_of v - N_of v * (a • X) = a • (X * N_of v - N_of v * X) := by
        rw [Matrix.smul_mul, Matrix.mul_smul, smul_sub]
      rw [h_smul]
      exact 𝔐.smul_mem a hX

  have h𝔐_lie : ∀ A ∈ 𝔐, ∀ B ∈ 𝔐, A * B - B * A ∈ 𝔐 := by
    intro A hA B hB
    refine Submodule.span_induction
      (p := fun Y _ => A * Y - Y * A ∈ 𝔐)
      (fun Y hY => ?_) ?_ (fun X Y _ _ hX hY => ?_) (fun a X _ hX => ?_) hB
    · rcases hY with ⟨v, hv, rfl⟩
      exact h𝔐_lie_gen A hA v hv
    · simp only [mul_zero, zero_mul, sub_self, 𝔐.zero_mem]
    · have h_add : A * (X + Y) - (X + Y) * A = (A * X - X * A) + (A * Y - Y * A) := by
        rw [mul_add, add_mul]; abel
      rw [h_add]
      exact 𝔐.add_mem hX hY
    · have h_smul : A * (a • X) - (a • X) * A = a • (A * X - X * A) := by
        rw [Matrix.mul_smul, Matrix.smul_mul, smul_sub]
      rw [h_smul]
      exact 𝔐.smul_mem a hX

  have h_lift : ∀ v ∈ Δ, ∃ X₀ : Matrix (Fin M) (Fin M) R,
      X₀.map ι = N_of v ∧ ∀ t : PadicInt ℓ, ∃ g ∈ G_geom, g.val = 1 + t • X₀ := by
    intro v hv
    have h_mat_eq : ∀ (t : PadicInt ℓ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ),
        (∀ x : Fin M → K,
          ((g.val).map ι).mulVec x = x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v) →
        (g.val).map ι = 1 + (t : Padic ℓ) • N_of v := by
      intro t g hg_eq
      ext i j
      have hj := congrFun (hg_eq (Pi.single j 1)) i
      have hlhs : (((g.val).map ι).mulVec (Pi.single j (1 : K))) i = ((g.val).map ι) i j := by
        simp [Matrix.mulVec, dotProduct, Pi.single_apply]
      have hdot : dotProduct (Pi.single j (1 : K)) (J.mulVec v) = (J.mulVec v) j := by
        simp [dotProduct, Pi.single_apply]
      rw [hlhs, Pi.add_apply, Pi.smul_apply, hdot, smul_eq_mul] at hj
      rw [hj]
      simp only [Matrix.add_apply, Matrix.one_apply, Matrix.smul_apply, N_of, Matrix.of_apply,
        Pi.single_apply, smul_eq_mul]
      split_ifs <;> ring
    obtain ⟨g₁, _, hg₁_eq⟩ := hΔ_transv v hv (1 : PadicInt ℓ)
    let X₀ : Matrix (Fin M) (Fin M) R := g₁.val - 1
    have hX₀_map : X₀.map ι = N_of v := by
      have hg₁_mat := h_mat_eq (1 : PadicInt ℓ) g₁ hg₁_eq
      have hc1 : ((1 : PadicInt ℓ) : Padic ℓ) = 1 := PadicInt.coe_one
      rw [hc1, one_smul] at hg₁_mat
      change (ι.mapMatrix (g₁.val - 1)) = N_of v
      rw [map_sub, map_one]
      change (g₁.val).map ι - 1 = N_of v
      rw [hg₁_mat, add_sub_cancel_left]
    refine ⟨X₀, hX₀_map, fun t => ?_⟩
    obtain ⟨gt, hgt, hgt_eq⟩ := hΔ_transv v hv t
    refine ⟨gt, hgt, ?_⟩
    have hgt_mat := h_mat_eq t gt hgt_eq
    have hinj : Function.Injective ι := IsFractionRing.injective R K
    ext i j
    apply hinj
    have h1 : ι (gt.val i j) = ((gt.val).map ι) i j := rfl
    have h2 : ι ((1 + t • X₀) i j) = (1 + (t : Padic ℓ) • N_of v) i j := by
      have hmap : (ι.mapMatrix (1 + t • X₀)) i j = (1 + (t : Padic ℓ) • N_of v) i j := by
        rw [map_add, map_one]
        have hsmul : ι.mapMatrix (t • X₀) = (ι t) • (ι.mapMatrix X₀) := by
          ext r c; simp [RingHom.mapMatrix_apply, Matrix.map_apply]
        rw [hsmul, PadicInt.algebraMap_apply]
        change (1 + (t : Padic ℓ) • X₀.map ι) i j = _
        rw [hX₀_map]
      exact hmap
    rw [h1, h2, hgt_mat]

  have hN_smul : ∀ (c : K) (v : Fin M → K), N_of (c • v) = (c ^ 2) • N_of v := by
    intro c v
    ext i j
    simp only [N_of, Matrix.of_apply, Matrix.smul_apply, Pi.smul_apply, Matrix.mulVec_smul,
      smul_eq_mul]
    ring

  have hN_quad : ∀ (u v : Fin M → K) (b : K),
      N_of (u + b • v) = N_of u + b • S_of u v + (b ^ 2) • N_of v := by
    intro u v b
    ext i j
    simp only [N_of, Matrix.of_apply, Matrix.add_apply, Matrix.smul_apply, hS_apply,
      Pi.add_apply, Pi.smul_apply, Matrix.mulVec_add, Matrix.mulVec_smul, smul_eq_mul]
    ring

  have hS_add_left : ∀ u₁ u₂ v : Fin M → K, S_of (u₁ + u₂) v = S_of u₁ v + S_of u₂ v := by
    intro u₁ u₂ v
    ext i j
    simp only [Matrix.add_apply, hS_apply, Pi.add_apply, Matrix.mulVec_add]
    ring

  have hSN_comm : ∀ u u₀ v : Fin M → K,
      S_of u u₀ * N_of v - N_of v * S_of u u₀ =
        (ψ v u) • S_of u₀ v + (ψ v u₀) • S_of u v := by
    intro u u₀ v
    have hexp : S_of u u₀ * N_of v - N_of v * S_of u u₀ =
        (N_of (u + u₀) * N_of v - N_of v * N_of (u + u₀)) -
        (N_of u * N_of v - N_of v * N_of u) -
        (N_of u₀ * N_of v - N_of v * N_of u₀) := by
      dsimp [S_of]
      rw [sub_mul, sub_mul, mul_sub, mul_sub]
      abel
    rw [hexp, hN_comm (u + u₀) v, hN_comm u v, hN_comm u₀ v, hψ_add_right, hS_add_left]
    ext i j
    simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
    ring

  let W_𝔐 : Set (Fin M → K) := { w | N_of w ∈ 𝔐 }
  have hΔ_sub_W : Δ ⊆ W_𝔐 := fun v hv => Submodule.subset_span ⟨v, hv, rfl⟩
  have hW_smul : ∀ (c : K) {w : Fin M → K}, w ∈ W_𝔐 → c • w ∈ W_𝔐 := by
    intro c w hw
    show N_of (c • w) ∈ 𝔐
    rw [hN_smul]
    exact 𝔐.smul_mem (c ^ 2) hw

  have h_finrank_V : Module.finrank K (Fin M → K) = M := Module.finrank_fin_fun K
  let P_rank : ℕ → Prop := fun d =>
    ∃ U : Submodule K (Fin M → K), (U : Set (Fin M → K)) ⊆ W_𝔐 ∧ Module.finrank K ↥U = d
  let S_ranks : Finset ℕ := (Finset.range (M + 1)).filter P_rank

  obtain ⟨v₀, hv₀⟩ := hΔ_ne
  have hv₀_nz : v₀ ≠ 0 := hΔ_nz v₀ hv₀
  let U₁ : Submodule K (Fin M → K) := Submodule.span K {v₀}
  have hU₁_sub : (U₁ : Set (Fin M → K)) ⊆ W_𝔐 := by
    intro x hx
    rw [SetLike.mem_coe, Submodule.mem_span_singleton] at hx
    rcases hx with ⟨c, rfl⟩
    exact hW_smul c (hΔ_sub_W hv₀)
  have hU₁_ne_bot : U₁ ≠ ⊥ := by
    intro hbot
    have hmem : v₀ ∈ U₁ := Submodule.subset_span (Set.mem_singleton v₀)
    rw [hbot, Submodule.mem_bot] at hmem
    exact hv₀_nz hmem
  have hU₁_pos : 0 < Module.finrank K ↥U₁ := by
    rw [Nat.pos_iff_ne_zero, ne_eq, Submodule.finrank_eq_zero]
    exact hU₁_ne_bot
  have hU₁_le : Module.finrank K ↥U₁ ≤ M :=
    (Submodule.finrank_le U₁).trans_eq h_finrank_V
  have hS_ne : S_ranks.Nonempty := by
    refine ⟨Module.finrank K ↥U₁, Finset.mem_filter.mpr ⟨?_, U₁, hU₁_sub, rfl⟩⟩
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hU₁_le)

  let d_max : ℕ := S_ranks.max' hS_ne
  have hd_max_mem : d_max ∈ S_ranks := Finset.max'_mem S_ranks hS_ne
  have hd_max_pos : 0 < d_max :=
    lt_of_lt_of_le hU₁_pos
      (Finset.le_max' S_ranks (Module.finrank K ↥U₁)
        (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le hU₁_le), U₁, hU₁_sub, rfl⟩))
  obtain ⟨U_max, hU_max_sub, hU_max_dim⟩ := (Finset.mem_filter.mp hd_max_mem).2
  have hU_max_ne_bot : U_max ≠ ⊥ := by
    rw [ne_eq, ← Submodule.finrank_eq_zero]
    omega

  have h_orth : ∀ u ∈ U_max, ∀ v ∈ W_𝔐, v ∉ U_max → ψ u v = 0 := by
    intro u₀ hu₀ v hv_W hv_not
    by_contra h_nz
    have h_vu₀_nz : ψ v u₀ ≠ 0 := by
      rw [hψ_skew u₀ v]
      exact neg_ne_zero.mpr h_nz
    have hS_u₀v : S_of u₀ v ∈ 𝔐 := by
      have hcomm : N_of u₀ * N_of v - N_of v * N_of u₀ ∈ 𝔐 :=
        h𝔐_lie _ (hU_max_sub hu₀) _ hv_W
      rw [hN_comm u₀ v] at hcomm
      have hsm := 𝔐.smul_mem (ψ v u₀)⁻¹ hcomm
      rwa [inv_smul_smul₀ h_vu₀_nz] at hsm
    have hS_uv_all : ∀ u ∈ U_max, S_of u v ∈ 𝔐 := by
      intro u hu
      have hS_uu₀ : S_of u u₀ ∈ 𝔐 := by
        dsimp [S_of]
        exact 𝔐.sub_mem (𝔐.sub_mem (hU_max_sub (U_max.add_mem hu hu₀)) (hU_max_sub hu))
          (hU_max_sub hu₀)
      have hcomm2 : S_of u u₀ * N_of v - N_of v * S_of u u₀ ∈ 𝔐 :=
        h𝔐_lie _ hS_uu₀ _ hv_W
      rw [hSN_comm u u₀ v] at hcomm2
      have hterm : (ψ v u₀) • S_of u v ∈ 𝔐 := by
        have hsub := 𝔐.sub_mem hcomm2 (𝔐.smul_mem (ψ v u) hS_u₀v)
        rwa [add_sub_cancel_left] at hsub
      have hsm := 𝔐.smul_mem (ψ v u₀)⁻¹ hterm
      rwa [inv_smul_smul₀ h_vu₀_nz] at hsm
    let U' : Submodule K (Fin M → K) := U_max ⊔ Submodule.span K {v}
    have hU'_sub : (U' : Set (Fin M → K)) ⊆ W_𝔐 := by
      intro z hz
      rw [SetLike.mem_coe, Submodule.mem_sup] at hz
      rcases hz with ⟨u, hu, w, hw, rfl⟩
      rw [Submodule.mem_span_singleton] at hw
      rcases hw with ⟨b, rfl⟩
      show N_of (u + b • v) ∈ 𝔐
      rw [hN_quad u v b]
      exact 𝔐.add_mem (𝔐.add_mem (hU_max_sub hu) (𝔐.smul_mem b (hS_uv_all u hu)))
        (𝔐.smul_mem (b ^ 2) hv_W)
    have h_lt : U_max < U' := by
      refine lt_of_le_of_ne le_sup_left ?_
      intro heq
      apply hv_not
      rw [heq]
      exact Submodule.mem_sup_right (Submodule.subset_span (Set.mem_singleton v))
    have h_dim_lt : d_max < Module.finrank K ↥U' := by
      rw [← hU_max_dim]
      exact Submodule.finrank_lt_finrank_of_lt h_lt
    have h_dim_le_M : Module.finrank K ↥U' ≤ M :=
      (Submodule.finrank_le U').trans_eq h_finrank_V
    have h_mem_S : Module.finrank K ↥U' ∈ S_ranks :=
      Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le h_dim_le_M), U', hU'_sub, rfl⟩
    have h_le_dmax : Module.finrank K ↥U' ≤ d_max := Finset.le_max' S_ranks _ h_mem_S
    omega

  have hU_max_top : U_max = ⊤ := by
    have h_inv : ∀ v ∈ Δ, ∀ u ∈ U_max, (dotProduct u (J.mulVec v)) • v ∈ U_max := by
      intro v hv u hu
      by_cases hv_mem : v ∈ U_max
      · exact U_max.smul_mem _ hv_mem
      · have h0 : ψ u v = 0 := h_orth u hu v (hΔ_sub_W hv) hv_mem
        change (ψ u v) • v ∈ U_max
        rw [h0, zero_smul]
        exact U_max.zero_mem
    rcases hΔ_simple U_max h_inv with hbot | htop
    · exact False.elim (hU_max_ne_bot hbot)
    · exact htop

  have hN_all : ∀ w : Fin M → K, N_of w ∈ 𝔐 := by
    intro w
    have hw : w ∈ U_max := by rw [hU_max_top]; trivial
    exact hU_max_sub hw

  have hS_all : ∀ x y : Fin M → K, S_of x y ∈ 𝔐 := by
    intro x y
    exact 𝔐.sub_mem (𝔐.sub_mem (hN_all (x + y)) (hN_all x)) (hN_all y)

  have h_sp_le : ∀ X : Matrix (Fin M) (Fin M) K, X.transpose * J + J * X = 0 → X ∈ 𝔐 := by
    intro X hX
    have hJ_unit : IsUnit J.det := isUnit_iff_ne_zero.mpr hJ_det
    have hJ_mul_inv : J * J⁻¹ = 1 := Matrix.mul_nonsing_inv J hJ_unit
    have hJ_inv_mul : J⁻¹ * J = 1 := Matrix.nonsing_inv_mul J hJ_unit
    let e_vec : Fin M → (Fin M → K) := fun a => Pi.single a 1
    let f_vec : Fin M → (Fin M → K) := fun a => J⁻¹.mulVec (e_vec a)
    have hJ_f : ∀ a : Fin M, J.mulVec (f_vec a) = e_vec a := by
      intro a
      dsimp [f_vec]
      rw [Matrix.mulVec_mulVec, hJ_mul_inv, Matrix.one_mulVec]
    have hJN : ∀ (w : Fin M → K) (i j : Fin M),
        (J * N_of w) i j = (J.mulVec w) i * (J.mulVec w) j := by
      intro w i j
      rw [Matrix.mul_apply]
      simp only [N_of, Matrix.of_apply, Matrix.mulVec, dotProduct]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun r _ => by ring
    have hJS : ∀ a b i j : Fin M,
        (J * S_of (f_vec a) (f_vec b)) i j = e_vec a i * e_vec b j + e_vec b i * e_vec a j := by
      intro a b i j
      dsimp [S_of]
      rw [mul_sub, mul_sub]
      simp only [Matrix.sub_apply, hJN, Matrix.mulVec_add, hJ_f, Pi.add_apply]
      ring
    have hJX_symm : ∀ i j : Fin M, (J * X) j i = (J * X) i j := by
      have htr : (J * X).transpose = J * X := by
        rw [Matrix.transpose_mul, hJ_skew, Matrix.mul_neg]
        have h1 : X.transpose * J = -(J * X) := eq_neg_of_add_eq_zero_left hX
        rw [h1, neg_neg]
      intro i j
      have h := congrFun (congrFun htr i) j
      simpa [Matrix.transpose_apply] using h
    let W : Matrix (Fin M) (Fin M) K :=
      (2 : K)⁻¹ • ∑ a : Fin M, ∑ b : Fin M, (J * X) a b • S_of (f_vec a) (f_vec b)
    have hW_mem : W ∈ 𝔐 :=
      𝔐.smul_mem _ (𝔐.sum_mem fun a _ => 𝔐.sum_mem fun b _ => 𝔐.smul_mem _ (hS_all _ _))
    have hJW : J * W = J * X := by
      ext i j
      dsimp [W]
      rw [Matrix.mul_smul, Matrix.mul_sum]
      simp only [Matrix.smul_apply, Matrix.sum_apply, smul_eq_mul]
      have hinner : ∀ a : Fin M,
          (J * ∑ b : Fin M, (J * X) a b • S_of (f_vec a) (f_vec b)) i j =
          ∑ b : Fin M, (J * X) a b * (e_vec a i * e_vec b j + e_vec b i * e_vec a j) := by
        intro a
        rw [Matrix.mul_sum, Matrix.sum_apply]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [Matrix.mul_smul, Matrix.smul_apply, smul_eq_mul, hJS]
      simp_rw [hinner]
      have hsum1 : ∑ a : Fin M, ∑ b : Fin M, (J * X) a b * (e_vec a i * e_vec b j) = (J * X) i j := by
        dsimp [e_vec]
        simp [Pi.single_apply, Finset.sum_ite_eq]
      have hsum2 : ∑ a : Fin M, ∑ b : Fin M, (J * X) a b * (e_vec b i * e_vec a j) = (J * X) j i := by
        dsimp [e_vec]
        rw [Finset.sum_comm]
        simp [Pi.single_apply, Finset.sum_ite_eq]
      have hsplit : ∑ a : Fin M, ∑ b : Fin M,
            (J * X) a b * (e_vec a i * e_vec b j + e_vec b i * e_vec a j) =
          (∑ a : Fin M, ∑ b : Fin M, (J * X) a b * (e_vec a i * e_vec b j)) +
          (∑ a : Fin M, ∑ b : Fin M, (J * X) a b * (e_vec b i * e_vec a j)) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun b _ => by ring
      rw [hsplit, hsum1, hsum2, hJX_symm i j]
      have h2x : (J * X) i j + (J * X) i j = (2 : K) * (J * X) i j := (two_mul _).symm
      rw [h2x, inv_mul_cancel_left₀ h2_ne]
    have hX_eq_W : X = W := by
      calc X = 1 * X := (Matrix.one_mul X).symm
        _ = (J⁻¹ * J) * X := by rw [hJ_inv_mul]
        _ = J⁻¹ * (J * X) := Matrix.mul_assoc _ _ _
        _ = J⁻¹ * (J * W) := by rw [hJW]
        _ = (J⁻¹ * J) * W := (Matrix.mul_assoc _ _ _).symm
        _ = 1 * W := by rw [hJ_inv_mul]
        _ = W := Matrix.one_mul W
    rwa [hX_eq_W]

  let D : ℕ := Module.finrank K ↥𝔐
  obtain ⟨f_bas, hf_mem, hf_span, hf_indep⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq K (N_of '' Δ)
  let v_bas : Fin D → (Fin M → K) := fun α => Classical.choose (hf_mem α)
  have hv_mem : ∀ α : Fin D, v_bas α ∈ Δ := fun α => (Classical.choose_spec (hf_mem α)).1
  have hv_eq : ∀ α : Fin D, N_of (v_bas α) = f_bas α :=
    fun α => (Classical.choose_spec (hf_mem α)).2
  let X_bas : Fin D → Matrix (Fin M) (Fin M) R :=
    fun α => Classical.choose (h_lift (v_bas α) (hv_mem α))
  have hX_map : ∀ α : Fin D, (X_bas α).map ι = f_bas α := fun α =>
    ((Classical.choose_spec (h_lift (v_bas α) (hv_mem α))).1).trans (hv_eq α)
  have hX_one_param : ∀ (α : Fin D) (t : R), ∃ g ∈ G_geom, g.val = 1 + t • X_bas α :=
    fun α => (Classical.choose_spec (h_lift (v_bas α) (hv_mem α))).2
  have hX_sp : ∀ α : Fin D, ((X_bas α).map ι).transpose * J + J * ((X_bas α).map ι) = 0 := by
    intro α
    rw [hX_map α, ← hv_eq α]
    set v := v_bas α
    ext i k_idx
    simp only [Matrix.add_apply, Matrix.zero_apply, Matrix.mul_apply, Matrix.transpose_apply,
      N_of, Matrix.of_apply]
    have h1 : ∑ r : Fin M, (v r * (J.mulVec v) i) * J r k_idx =
        -(J.mulVec v) i * (J.mulVec v) k_idx := by
      dsimp [Matrix.mulVec, dotProduct]
      calc ∑ r : Fin M, (v r * ∑ c : Fin M, J i c * v c) * J r k_idx
          = (∑ c : Fin M, J i c * v c) * ∑ r : Fin M, J r k_idx * v r := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun r _ => by ring
        _ = (∑ c : Fin M, J i c * v c) * ∑ r : Fin M, (-J k_idx r) * v r := by
              congr 1
              refine Finset.sum_congr rfl fun r _ => by rw [hJ_entry k_idx r]
        _ = -(∑ c : Fin M, J i c * v c) * ∑ r : Fin M, J k_idx r * v r := by
              simp only [neg_mul, Finset.sum_neg_distrib, mul_neg]
    have h2 : ∑ r : Fin M, J i r * (v r * (J.mulVec v) k_idx) =
        (J.mulVec v) i * (J.mulVec v) k_idx := by
      dsimp [Matrix.mulVec, dotProduct]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun r _ => by ring
    rw [h1, h2]
    ring

  let Λ₀ : (Fin D → K) →ₗ[K] Matrix (Fin M) (Fin M) K :=
    { toFun := fun v => ∑ α : Fin D, v α • f_bas α
      map_add' := fun u v => by simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun c v => by
        simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum, RingHom.id_apply] }

  have hΛ₀_ker : LinearMap.ker Λ₀ = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro v hv
    rw [LinearMap.mem_ker] at hv
    ext α
    exact Fintype.linearIndependent_iff.mp hf_indep v hv α

  obtain ⟨Ψ, hΨ_left⟩ := LinearMap.exists_leftInverse_of_injective Λ₀ hΛ₀_ker
  have hΨ_Λ₀ : ∀ v : Fin D → K, Ψ (Λ₀ v) = v := fun v => LinearMap.congr_fun hΨ_left v
  have hΛ₀_Ψ : ∀ Z : Matrix (Fin M) (Fin M) K, Z.transpose * J + J * Z = 0 → Λ₀ (Ψ Z) = Z := by
    intro Z hZ
    have hmem : Z ∈ Submodule.span K (Set.range f_bas) := by
      rw [hf_span]
      exact h_sp_le Z hZ
    rw [Submodule.mem_span_range_iff_exists_fun] at hmem
    rcases hmem with ⟨v, hv⟩
    change Λ₀ v = Z at hv
    rw [← hv, hΨ_Λ₀ v]

  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_K_ne : (ℓ : K) ≠ 0 := Nat.cast_ne_zero.mpr hℓ_prime.ne_zero
  have hinj_ι : Function.Injective ι := IsFractionRing.injective R K
  have hℓ_R_ne : (ℓ : R) ≠ 0 := by
    intro h0
    apply hℓ_K_ne
    have h1 := congrArg ι h0
    rwa [map_natCast, map_zero] at h1

  have h_pow_bound : ∀ x : K, ∃ n : ℕ, ‖((ℓ : K) ^ n) * x‖ ≤ 1 := by
    intro x
    by_cases hx : x = 0
    · exact ⟨0, by simp [hx]⟩
    · have h1lt : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr hℓ_prime.one_lt
      obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt ‖x‖ h1lt
      refine ⟨n, ?_⟩
      rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := by positivity
      calc ((ℓ : ℝ) ^ n)⁻¹ * ‖x‖
          ≤ ((ℓ : ℝ) ^ n)⁻¹ * (ℓ : ℝ) ^ n := mul_le_mul_of_nonneg_left hn.le (by positivity)
        _ = 1 := inv_mul_cancel₀ hpos.ne'

  let E_mat : Fin M → Fin M → Matrix (Fin M) (Fin M) K :=
    fun i j => Matrix.of (fun r c => if r = i then (if c = j then 1 else 0) else 0)
  let c_entry : Fin D × Fin M × Fin M → K := fun p => Ψ (E_mat p.2.1 p.2.2) p.1
  let n_entry : Fin D × Fin M × Fin M → ℕ := fun p => Classical.choose (h_pow_bound (c_entry p))
  let c₀ : ℕ := Finset.univ.sup n_entry

  have hc₀_bound : ∀ (α : Fin D) (i j : Fin M), ‖((ℓ : K) ^ c₀) * Ψ (E_mat i j) α‖ ≤ 1 := by
    intro α i j
    let p : Fin D × Fin M × Fin M := (α, i, j)
    have hle : n_entry p ≤ c₀ := Finset.le_sup (Finset.mem_univ p)
    have hsub : c₀ = (c₀ - n_entry p) + n_entry p := (Nat.sub_add_cancel hle).symm
    rw [hsub, pow_add, mul_assoc, norm_mul]
    have h1 : ‖(ℓ : K) ^ (c₀ - n_entry p)‖ ≤ 1 := by
      rw [norm_pow, Padic.norm_p]
      refine pow_le_one₀ (by positivity) (inv_le_one_of_one_le₀ ?_)
      exact_mod_cast hℓ_prime.one_lt.le
    have h2 : ‖(ℓ : K) ^ n_entry p * Ψ (E_mat i j) α‖ ≤ 1 :=
      Classical.choose_spec (h_pow_bound (c_entry p))
    calc ‖(ℓ : K) ^ (c₀ - n_entry p)‖ * ‖(ℓ : K) ^ n_entry p * Ψ (E_mat i j) α‖
        ≤ 1 * 1 := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
      _ = 1 := mul_one 1

  let d_int : Fin D → Fin M → Fin M → R :=
    fun α i j => ⟨((ℓ : K) ^ c₀) * Ψ (E_mat i j) α, hc₀_bound α i j⟩
  let Ψ_int : Matrix (Fin M) (Fin M) R → (Fin D → R) :=
    fun Z α => ∑ i : Fin M, ∑ j : Fin M, d_int α i j * Z i j

  have hΨ_int_ι : ∀ (Z : Matrix (Fin M) (Fin M) R) (α : Fin D),
      ι (Ψ_int Z α) = ((ℓ : K) ^ c₀) * Ψ (Z.map ι) α := by
    intro Z α
    have hZ_decomp : Z.map ι = ∑ i : Fin M, ∑ j : Fin M, (ι (Z i j)) • E_mat i j := by
      ext r c
      simp only [Matrix.map_apply, Matrix.sum_apply, Matrix.smul_apply, E_mat, Matrix.of_apply,
        smul_eq_mul]
      have hinner : ∀ i : Fin M,
          (∑ j : Fin M, ι (Z i j) * (if r = i then if c = j then (1 : K) else 0 else 0)) =
          if r = i then ι (Z i c) else 0 := by
        intro i
        by_cases hri : r = i
        · subst hri
          simp [Finset.sum_ite_eq]
        · simp [hri]
      simp_rw [hinner]
      simp [Finset.sum_ite_eq]
    dsimp [Ψ_int]
    simp only [map_sum, map_mul]
    have hd_ι : ∀ i j : Fin M, ι (d_int α i j) = ((ℓ : K) ^ c₀) * Ψ (E_mat i j) α := by
      intro i j
      exact PadicInt.algebraMap_apply (d_int α i j)
    simp_rw [hd_ι]
    rw [hZ_decomp, map_sum, Finset.sum_apply, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_sum, Finset.sum_apply, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, Pi.smul_apply, smul_eq_mul]
    ring

  let k : ℕ := c₀ + 1
  have hk_pos : 1 ≤ k := Nat.le_add_left 1 c₀
  let r₀ : ℕ := k + c₀ + 1
  have hr₀_pos : 1 ≤ r₀ := Nat.le_add_left 1 (k + c₀)

  let U_of : Matrix (Fin M) (Fin M) R → Matrix (Fin M) (Fin M) R :=
    fun Y => 1 + ((ℓ : R) ^ k) • Y
  have hDet_U : ∀ Y : Matrix (Fin M) (Fin M) R, IsUnit (U_of Y).det := by
    intro Y
    let φ : R →+* ZMod ℓ := PadicInt.toZMod
    have hφ_pow : φ ((ℓ : R) ^ k) = 0 := by
      rw [map_pow, map_natCast, ZMod.natCast_self, zero_pow (by omega)]
    have hφ_U : φ.mapMatrix (U_of Y) = 1 := by
      ext i j
      simp only [U_of, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.add_apply,
        Matrix.one_apply, Matrix.smul_apply, smul_eq_mul, map_add, map_mul, hφ_pow,
        zero_mul, add_zero]
      split_ifs <;> simp
    have hφ_det : φ (U_of Y).det = 1 := by
      rw [RingHom.map_det, hφ_U, Matrix.det_one]
    have hker : (U_of Y).det ∉ RingHom.ker φ := by
      rw [RingHom.mem_ker, hφ_det]
      exact one_ne_zero
    rwa [PadicInt.ker_toZMod, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hker

  let W_of : Matrix (Fin M) (Fin M) R → Matrix (Fin M) (Fin M) R := fun Y => (U_of Y)⁻¹
  let c_tilde : Matrix (Fin M) (Fin M) R → Matrix (Fin M) (Fin M) R := fun Y => Y * W_of Y
  have hUW : ∀ Y : Matrix (Fin M) (Fin M) R, U_of Y * W_of Y = 1 :=
    fun Y => Matrix.mul_nonsing_inv (U_of Y) (hDet_U Y)
  have hWU : ∀ Y : Matrix (Fin M) (Fin M) R, W_of Y * U_of Y = 1 :=
    fun Y => Matrix.nonsing_inv_mul (U_of Y) (hDet_U Y)

  have hW_id : ∀ Y : Matrix (Fin M) (Fin M) R, W_of Y = 1 - ((ℓ : R) ^ k) • c_tilde Y := by
    intro Y
    calc W_of Y = 1 * W_of Y := (Matrix.one_mul _).symm
      _ = (U_of Y - ((ℓ : R) ^ k) • Y) * W_of Y := by dsimp [U_of]; rw [add_sub_cancel_right]
      _ = U_of Y * W_of Y - (((ℓ : R) ^ k) • Y) * W_of Y := Matrix.sub_mul _ _ _
      _ = 1 - ((ℓ : R) ^ k) • c_tilde Y := by rw [hUW Y, Matrix.smul_mul]

  have hc_inj : ∀ Y₁ Y₂ : Matrix (Fin M) (Fin M) R, c_tilde Y₁ = c_tilde Y₂ → Y₁ = Y₂ := by
    intro Y₁ Y₂ hc
    have hW_eq : W_of Y₁ = W_of Y₂ := by rw [hW_id Y₁, hW_id Y₂, hc]
    have hU_eq : U_of Y₂ = U_of Y₁ := by
      calc U_of Y₂ = 1 * U_of Y₂ := (Matrix.one_mul _).symm
        _ = (U_of Y₁ * W_of Y₁) * U_of Y₂ := by rw [hUW Y₁]
        _ = U_of Y₁ * (W_of Y₂ * U_of Y₂) := by rw [Matrix.mul_assoc, hW_eq]
        _ = U_of Y₁ * 1 := by rw [hWU Y₂]
        _ = U_of Y₁ := Matrix.mul_one _
    have hsm : ((ℓ : R) ^ k) • Y₁ = ((ℓ : R) ^ k) • Y₂ := add_left_cancel hU_eq.symm
    ext i j
    have hij := congrFun (congrFun hsm i) j
    simp only [Matrix.smul_apply, smul_eq_mul] at hij
    exact mul_left_cancel₀ (pow_ne_zero k hℓ_R_ne) hij

  have hmap_smul_ι : ∀ (r : R) (A : Matrix (Fin M) (Fin M) R),
      (r • A).map ι = (ι r) • (A.map ι) := by
    intro r A
    ext i j
    simp [Matrix.map_apply, Matrix.smul_apply]

  have hc_sp : ∀ Y : Matrix (Fin M) (Fin M) R,
      (((1 + (2 * (ℓ : R) ^ k) • Y).map ι).transpose * J *
        ((1 + (2 * (ℓ : R) ^ k) • Y).map ι) = J) →
      ((c_tilde Y).map ι).transpose * J + J * ((c_tilde Y).map ι) = 0 := by
    intro Y hsp
    let α_k : K := (ℓ : K) ^ k
    let Yk : Matrix (Fin M) (Fin M) K := Y.map ι
    let Uk : Matrix (Fin M) (Fin M) K := (U_of Y).map ι
    let Wk : Matrix (Fin M) (Fin M) K := (W_of Y).map ι
    have hUk_eq : Uk = 1 + α_k • Yk := by
      change ι.mapMatrix (1 + ((ℓ : R) ^ k) • Y) = 1 + α_k • Yk
      rw [map_add, map_one]
      change 1 + (((ℓ : R) ^ k) • Y).map ι = 1 + α_k • Yk
      rw [hmap_smul_ι, map_pow, map_natCast]
    have hAk_eq : (1 + (2 * (ℓ : R) ^ k) • Y).map ι = 1 + ((2 : K) * α_k) • Yk := by
      change ι.mapMatrix (1 + (2 * (ℓ : R) ^ k) • Y) = 1 + ((2 : K) * α_k) • Yk
      rw [map_add, map_one]
      change 1 + ((2 * (ℓ : R) ^ k) • Y).map ι = 1 + ((2 : K) * α_k) • Yk
      rw [hmap_smul_ι, map_mul, map_ofNat, map_pow, map_natCast]
    have hUW_k : Uk * Wk = 1 := by
      have h := congrArg (ι.mapMatrix) (hUW Y)
      rwa [map_mul, map_one] at h
    rw [hAk_eq] at hsp
    have hexp1 : (1 + ((2 : K) * α_k) • Yk).transpose * J * (1 + ((2 : K) * α_k) • Yk) =
        J + ((2 : K) * α_k) • (Yk.transpose * J + J * Yk + ((2 : K) * α_k) • (Yk.transpose * J * Yk)) := by
      rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_smul,
        Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, Matrix.add_mul]
      simp only [Matrix.smul_mul, Matrix.mul_smul, smul_add, Matrix.mul_assoc]
      abel
    rw [hexp1] at hsp
    have hzero1 : ((2 : K) * α_k) •
        (Yk.transpose * J + J * Yk + ((2 : K) * α_k) • (Yk.transpose * J * Yk)) = 0 := by
      have h := congrArg (fun M_x => -J + M_x) hsp
      simpa using h
    have hc_ne : (2 : K) * α_k ≠ 0 := mul_ne_zero h2_ne (pow_ne_zero k hℓ_K_ne)
    have hzero2 : Yk.transpose * J + J * Yk + ((2 : K) * α_k) • (Yk.transpose * J * Yk) = 0 := by
      have h := congrArg (fun M_x => ((2 : K) * α_k)⁻¹ • M_x) hzero1
      rwa [inv_smul_smul₀ hc_ne, smul_zero] at h
    have hUk_quad : Uk.transpose * J * Yk + Yk.transpose * J * Uk = 0 := by
      rw [hUk_eq, Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_smul,
        Matrix.add_mul, Matrix.one_mul, Matrix.add_mul, Matrix.mul_add, Matrix.mul_one]
      simp only [Matrix.smul_mul, Matrix.mul_smul]
      have htwo : α_k • (Yk.transpose * J * Yk) + α_k • (Yk.transpose * J * Yk) =
          ((2 : K) * α_k) • (Yk.transpose * J * Yk) := by
        rw [← add_smul, two_mul]
      have hrearr : J * Yk + α_k • (Yk.transpose * J * Yk) +
          (Yk.transpose * J + α_k • (Yk.transpose * J * Yk)) =
          Yk.transpose * J + J * Yk +
            (α_k • (Yk.transpose * J * Yk) + α_k • (Yk.transpose * J * Yk)) := by abel
      rw [hrearr, htwo]
      exact hzero2
    have h_conj : Wk.transpose * (Uk.transpose * J * Yk + Yk.transpose * J * Uk) * Wk = 0 := by
      rw [hUk_quad, Matrix.mul_zero, Matrix.zero_mul]
    have hWU_tr : Wk.transpose * Uk.transpose = 1 := by
      rw [← Matrix.transpose_mul, hUW_k, Matrix.transpose_one]
    have hYW_eq : Yk * Wk = (c_tilde Y).map ι := by
      change Y.map ι * (W_of Y).map ι = (Y * W_of Y).map ι
      exact ((ι.mapMatrix).map_mul Y (W_of Y)).symm
    have hlhs : Wk.transpose * (Uk.transpose * J * Yk + Yk.transpose * J * Uk) * Wk =
        J * ((c_tilde Y).map ι) + ((c_tilde Y).map ι).transpose * J := by
      rw [Matrix.mul_add, Matrix.add_mul]
      have ht1 : Wk.transpose * (Uk.transpose * J * Yk) * Wk = J * (Yk * Wk) := by
        calc Wk.transpose * (Uk.transpose * J * Yk) * Wk
            = (Wk.transpose * Uk.transpose) * J * (Yk * Wk) := by simp only [Matrix.mul_assoc]
          _ = J * (Yk * Wk) := by rw [hWU_tr, Matrix.one_mul]
      have ht2 : Wk.transpose * (Yk.transpose * J * Uk) * Wk = (Yk * Wk).transpose * J := by
        calc Wk.transpose * (Yk.transpose * J * Uk) * Wk
            = (Wk.transpose * Yk.transpose) * J * (Uk * Wk) := by simp only [Matrix.mul_assoc]
          _ = (Yk * Wk).transpose * J := by rw [← Matrix.transpose_mul, hUW_k, Matrix.mul_one]
      rw [ht1, ht2, hYW_eq]
    rw [hlhs, add_comm] at h_conj
    exact h_conj

  let g_elem : Fin D → R → (Matrix (Fin M) (Fin M) R)ˣ :=
    fun α t => Classical.choose (hX_one_param α t)
  have hg_elem_mem : ∀ (α : Fin D) (t : R), g_elem α t ∈ G_geom :=
    fun α t => (Classical.choose_spec (hX_one_param α t)).1
  have hg_elem_val : ∀ (α : Fin D) (t : R), (g_elem α t).val = 1 + t • X_bas α :=
    fun α t => (Classical.choose_spec (hX_one_param α t)).2

  let π_R : R := 2 * (ℓ : R) ^ k

  let P_rec : ℕ → (Fin D → R) → (Matrix (Fin M) (Fin M) R)ˣ :=
    fun d s => Nat.rec 1
      (fun n prev => if hd : n < D then prev * g_elem ⟨n, hd⟩ (π_R * s ⟨n, hd⟩) else prev) d

  let L_rec : ℕ → (Fin D → R) → Matrix (Fin M) (Fin M) R :=
    fun d s => Nat.rec 0
      (fun n prev => if hd : n < D then prev + s ⟨n, hd⟩ • X_bas ⟨n, hd⟩ else prev) d

  let Y_rec : ℕ → (Fin D → R) → Matrix (Fin M) (Fin M) R :=
    fun d s => Nat.rec 0
      (fun n prev =>
        if hd : n < D then
          prev + s ⟨n, hd⟩ • X_bas ⟨n, hd⟩ + (π_R * s ⟨n, hd⟩) • (prev * X_bas ⟨n, hd⟩)
        else prev) d

  let Q_rec : ℕ → (Fin D → R) → Matrix (Fin M) (Fin M) R :=
    fun d s => Nat.rec 0
      (fun n prev =>
        if hd : n < D then prev + s ⟨n, hd⟩ • (Y_rec n s * X_bas ⟨n, hd⟩) else prev) d

  have hP_mem : ∀ (d : ℕ) (s : Fin D → R), P_rec d s ∈ G_geom := by
    intro d s
    induction d with
    | zero => exact G_geom.one_mem
    | succ d ih =>
      dsimp [P_rec]
      split_ifs with hd
      · exact G_geom.mul_mem ih (hg_elem_mem _ _)
      · exact ih

  have hP_val : ∀ (d : ℕ) (s : Fin D → R), (P_rec d s).val = 1 + π_R • Y_rec d s := by
    intro d s
    induction d with
    | zero =>
      dsimp [P_rec, Y_rec]
      simp
    | succ d ih =>
      change (if hd : d < D then P_rec d s * g_elem ⟨d, hd⟩ (π_R * s ⟨d, hd⟩) else P_rec d s).val =
        1 + π_R • (if hd : d < D then
          Y_rec d s + s ⟨d, hd⟩ • X_bas ⟨d, hd⟩ + (π_R * s ⟨d, hd⟩) • (Y_rec d s * X_bas ⟨d, hd⟩)
        else Y_rec d s)
      split_ifs with hd
      · rw [Units.val_mul, ih, hg_elem_val]
        set α : Fin D := ⟨d, hd⟩
        rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one,
          Matrix.smul_mul, Matrix.mul_smul, mul_smul π_R (s α), mul_smul π_R (s α),
          smul_add, smul_add]
        abel
      · exact ih

  have hY_decomp : ∀ (d : ℕ) (s : Fin D → R), Y_rec d s = L_rec d s + π_R • Q_rec d s := by
    intro d s
    induction d with
    | zero =>
      dsimp [Y_rec, L_rec, Q_rec]
      simp
    | succ d ih =>
      change (if hd : d < D then
          Y_rec d s + s ⟨d, hd⟩ • X_bas ⟨d, hd⟩ + (π_R * s ⟨d, hd⟩) • (Y_rec d s * X_bas ⟨d, hd⟩)
        else Y_rec d s) =
        (if hd : d < D then L_rec d s + s ⟨d, hd⟩ • X_bas ⟨d, hd⟩ else L_rec d s) +
        π_R • (if hd : d < D then Q_rec d s + s ⟨d, hd⟩ • (Y_rec d s * X_bas ⟨d, hd⟩) else Q_rec d s)
      split_ifs with hd
      · rw [ih, mul_smul π_R (s ⟨d, hd⟩), smul_add]
        abel
      · exact ih

  have hL_sum : ∀ (d : ℕ) (hd_le : d ≤ D) (s : Fin D → R),
      L_rec d s = ∑ α ∈ Finset.univ.filter (fun α : Fin D => α.1 < d), s α • X_bas α := by
    intro d hd_le s
    induction d with
    | zero =>
      have hemp : Finset.univ.filter (fun α : Fin D => α.1 < 0) = ∅ := by
        ext α; simp
      rw [hemp, Finset.sum_empty]
      rfl
    | succ d ih =>
      have hd_lt : d < D := Nat.lt_of_succ_le hd_le
      change (if hd : d < D then L_rec d s + s ⟨d, hd⟩ • X_bas ⟨d, hd⟩ else L_rec d s) = _
      simp only [hd_lt, ↓reduceDIte]
      rw [ih (Nat.le_of_lt hd_lt)]
      let α_d : Fin D := ⟨d, hd_lt⟩
      have hfilt : Finset.univ.filter (fun α : Fin D => α.1 < d + 1) =
          insert α_d (Finset.univ.filter (fun α : Fin D => α.1 < d)) := by
        ext α
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert]
        constructor
        · intro hlt
          rcases Nat.lt_succ_iff_lt_or_eq.mp hlt with h | h
          · exact Or.inr h
          · exact Or.inl (Fin.ext h)
        · rintro (rfl | h)
          · exact Nat.lt_succ_self d
          · exact Nat.lt_succ_of_lt h
      have hnot_mem : α_d ∉ Finset.univ.filter (fun α : Fin D => α.1 < d) := by
        simp [α_d]
      rw [hfilt, Finset.sum_insert hnot_mem, add_comm]

  let L_fn : (Fin D → R) → Matrix (Fin M) (Fin M) R := L_rec D
  let Y_fn : (Fin D → R) → Matrix (Fin M) (Fin M) R := Y_rec D
  let Q_fn : (Fin D → R) → Matrix (Fin M) (Fin M) R := Q_rec D
  let R_k : (Fin D → R) → Matrix (Fin M) (Fin M) R :=
    fun s => (2 : R) • Q_fn s - Y_fn s * Y_fn s * W_of (Y_fn s)

  have hL_fn_sum : ∀ s : Fin D → R, L_fn s = ∑ α : Fin D, s α • X_bas α := by
    intro s
    dsimp [L_fn]
    rw [hL_sum D (le_refl D) s]
    have huniv : Finset.univ.filter (fun α : Fin D => α.1 < D) = Finset.univ := by
      ext α; simp
    rw [huniv]

  have hL_fn_map : ∀ s : Fin D → R, (L_fn s).map ι = Λ₀ (fun α => ι (s α)) := by
    intro s
    rw [hL_fn_sum s]
    change ι.mapMatrix (∑ α : Fin D, s α • X_bas α) = ∑ α : Fin D, ι (s α) • f_bas α
    rw [map_sum]
    refine Finset.sum_congr rfl fun α _ => ?_
    change (s α • X_bas α).map ι = ι (s α) • f_bas α
    rw [hmap_smul_ι, hX_map α]

  have hL_fn_sp : ∀ s : Fin D → R, ((L_fn s).map ι).transpose * J + J * ((L_fn s).map ι) = 0 := by
    intro s
    rw [hL_fn_map s]
    dsimp [Λ₀]
    rw [Matrix.transpose_sum, Matrix.sum_mul, Matrix.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun α _ => ?_
    rw [Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, ← smul_add, ← hX_map α,
      hX_sp α, smul_zero]

  have hc_Y_fn : ∀ s : Fin D → R, c_tilde (Y_fn s) = L_fn s + ((ℓ : R) ^ k) • R_k s := by
    intro s
    dsimp [c_tilde]
    conv_lhs => rw [hW_id (Y_fn s)]
    rw [Matrix.mul_sub, Matrix.mul_one, Matrix.mul_smul]
    dsimp [c_tilde]
    have h_assoc : Y_fn s * (Y_fn s * W_of (Y_fn s)) = Y_fn s * Y_fn s * W_of (Y_fn s) :=
      (Matrix.mul_assoc _ _ _).symm
    rw [h_assoc]
    have hstep : Y_fn s - ((ℓ : R) ^ k) • (Y_fn s * Y_fn s * W_of (Y_fn s)) =
        (L_fn s + π_R • Q_fn s) - ((ℓ : R) ^ k) • (Y_fn s * Y_fn s * W_of (Y_fn s)) :=
      congrArg (fun M_x => M_x - ((ℓ : R) ^ k) • (Y_fn s * Y_fn s * W_of (Y_fn s))) (hY_decomp D s)
    rw [hstep]
    dsimp [R_k, π_R]
    rw [mul_comm (2 : R) ((ℓ : R) ^ k), mul_smul ((ℓ : R) ^ k) (2 : R), smul_sub]
    abel

  have hRk_sp : ∀ s : Fin D → R, ((R_k s).map ι).transpose * J + J * ((R_k s).map ι) = 0 := by
    intro s
    have hP_sp : (((1 + (2 * (ℓ : R) ^ k) • Y_fn s).map ι).transpose * J *
        ((1 + (2 * (ℓ : R) ^ k) • Y_fn s).map ι) = J) := by
      have hp := hG_sp (P_rec D s) (hP_mem D s)
      rwa [hP_val D s] at hp
    have hc_zero := hc_sp (Y_fn s) hP_sp
    have hc_map : (c_tilde (Y_fn s)).map ι = (L_fn s).map ι + ((ℓ : K) ^ k) • ((R_k s).map ι) := by
      change ι.mapMatrix (c_tilde (Y_fn s)) = _
      rw [hc_Y_fn s, map_add]
      change (L_fn s).map ι + (((ℓ : R) ^ k) • R_k s).map ι = _
      rw [hmap_smul_ι, map_pow, map_natCast]
    rw [hc_map, Matrix.transpose_add, Matrix.transpose_smul, Matrix.add_mul, Matrix.mul_add,
      Matrix.smul_mul, Matrix.mul_smul] at hc_zero
    have hrearr : (((L_fn s).map ι).transpose * J + J * ((L_fn s).map ι)) +
        ((ℓ : K) ^ k) • (((R_k s).map ι).transpose * J + J * ((R_k s).map ι)) = 0 := by
      rw [smul_add]
      calc (((L_fn s).map ι).transpose * J + J * ((L_fn s).map ι)) +
            (((ℓ : K) ^ k) • (((R_k s).map ι).transpose * J) + ((ℓ : K) ^ k) • (J * ((R_k s).map ι)))
          = ((L_fn s).map ι).transpose * J + ((ℓ : K) ^ k) • (((R_k s).map ι).transpose * J) +
            (J * ((L_fn s).map ι) + ((ℓ : K) ^ k) • (J * ((R_k s).map ι))) := by abel
        _ = 0 := hc_zero
    rw [hL_fn_sp s, zero_add] at hrearr
    have hpow_ne : (ℓ : K) ^ k ≠ 0 := pow_ne_zero k hℓ_K_ne
    have hsm := congrArg (fun M_x => ((ℓ : K) ^ k)⁻¹ • M_x) hrearr
    rwa [inv_smul_smul₀ hpow_ne, smul_zero] at hsm

  have h_sum_norm : ∀ {ι_t : Type} (s_fin : Finset ι_t) (f_t : ι_t → R) (C : ℝ),
      0 ≤ C → (∀ x ∈ s_fin, ‖f_t x‖ ≤ C) → ‖∑ x ∈ s_fin, f_t x‖ ≤ C := by
    intro ι_t s_fin f_t C hC
    induction s_fin using Finset.induction_on with
    | empty =>
      intro _
      simpa using hC
    | @insert a s_sub ha ih =>
      intro hbound
      rw [Finset.sum_insert ha]
      refine (PadicInt.nonarchimedean (f_t a) (∑ x ∈ s_sub, f_t x)).trans (max_le ?_ ?_)
      · exact hbound a (Finset.mem_insert_self a s_sub)
      · exact ih fun x hx => hbound x (Finset.mem_insert_of_mem hx)

  let MatNormLe : Matrix (Fin M) (Fin M) R → ℝ → Prop :=
    fun A C => ∀ i j : Fin M, ‖A i j‖ ≤ C

  have hMN_zero : ∀ {C : ℝ}, 0 ≤ C → MatNormLe 0 C := by
    intro C hC i j; simpa using hC

  have hMN_add : ∀ {A B : Matrix (Fin M) (Fin M) R} {C : ℝ},
      MatNormLe A C → MatNormLe B C → MatNormLe (A + B) C := by
    intro A B C hA hB i j
    exact (PadicInt.nonarchimedean (A i j) (B i j)).trans (max_le (hA i j) (hB i j))

  have hMN_neg : ∀ {A : Matrix (Fin M) (Fin M) R} {C : ℝ},
      MatNormLe A C → MatNormLe (-A) C := by
    intro A C hA i j
    simpa only [Matrix.neg_apply, norm_neg] using hA i j

  have hMN_sub : ∀ {A B : Matrix (Fin M) (Fin M) R} {C : ℝ},
      MatNormLe A C → MatNormLe B C → MatNormLe (A - B) C := by
    intro A B C hA hB
    rw [sub_eq_add_neg]
    exact hMN_add hA (hMN_neg hB)

  have hMN_smul_right : ∀ (r : R) {A : Matrix (Fin M) (Fin M) R} {C : ℝ},
      0 ≤ C → MatNormLe A C → MatNormLe (r • A) C := by
    intro r A C _ hA i j
    simp only [Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖r‖ * ‖A i j‖ ≤ 1 * C :=
          mul_le_mul (PadicInt.norm_le_one r) (hA i j) (norm_nonneg _) zero_le_one
      _ = C := one_mul C

  have hMN_smul_left : ∀ {r : R} (A : Matrix (Fin M) (Fin M) R) {C : ℝ},
      ‖r‖ ≤ C → MatNormLe (r • A) C := by
    intro r A C hr i j
    simp only [Matrix.smul_apply, smul_eq_mul, norm_mul]
    have hC : 0 ≤ C := (norm_nonneg r).trans hr
    calc ‖r‖ * ‖A i j‖ ≤ C * 1 :=
          mul_le_mul hr (PadicInt.norm_le_one (A i j)) (norm_nonneg _) hC
      _ = C := mul_one C

  have hMN_mul_right : ∀ {A : Matrix (Fin M) (Fin M) R} (B : Matrix (Fin M) (Fin M) R) {C : ℝ},
      0 ≤ C → MatNormLe A C → MatNormLe (A * B) C := by
    intro A B C hC hA i j
    rw [Matrix.mul_apply]
    refine h_sum_norm Finset.univ (fun r => A i r * B r j) C hC fun r _ => ?_
    rw [norm_mul]
    calc ‖A i r‖ * ‖B r j‖ ≤ C * 1 :=
          mul_le_mul (hA i r) (PadicInt.norm_le_one (B r j)) (norm_nonneg _) hC
      _ = C := mul_one C

  have hMN_mul_left : ∀ (A : Matrix (Fin M) (Fin M) R) {B : Matrix (Fin M) (Fin M) R} {C : ℝ},
      0 ≤ C → MatNormLe B C → MatNormLe (A * B) C := by
    intro A B C hC hB i j
    rw [Matrix.mul_apply]
    refine h_sum_norm Finset.univ (fun r => A i r * B r j) C hC fun r _ => ?_
    rw [norm_mul]
    calc ‖A i r‖ * ‖B r j‖ ≤ 1 * C :=
          mul_le_mul (PadicInt.norm_le_one (A i r)) (hB r j) (norm_nonneg _) zero_le_one
      _ = C := one_mul C

  have hMN_mul_diff : ∀ {A₁ A₂ B₁ B₂ : Matrix (Fin M) (Fin M) R} {C : ℝ},
      0 ≤ C → MatNormLe (A₁ - A₂) C → MatNormLe (B₁ - B₂) C →
      MatNormLe (A₁ * B₁ - A₂ * B₂) C := by
    intro A₁ A₂ B₁ B₂ C hC hA hB
    have hid : A₁ * B₁ - A₂ * B₂ = (A₁ - A₂) * B₁ + A₂ * (B₁ - B₂) := by
      rw [Matrix.sub_mul, Matrix.mul_sub]; abel
    rw [hid]
    exact hMN_add (hMN_mul_right B₁ hC hA) (hMN_mul_left A₂ hC hB)

  have hMN_smul_diff : ∀ {r₁ r₂ : R} {A₁ A₂ : Matrix (Fin M) (Fin M) R} {C : ℝ},
      0 ≤ C → ‖r₁ - r₂‖ ≤ C → MatNormLe (A₁ - A₂) C →
      MatNormLe (r₁ • A₁ - r₂ • A₂) C := by
    intro r₁ r₂ A₁ A₂ C hC hr hA
    have hid : r₁ • A₁ - r₂ • A₂ = (r₁ - r₂) • A₁ + r₂ • (A₁ - A₂) := by
      rw [sub_smul, smul_sub]; abel
    rw [hid]
    exact hMN_add (hMN_smul_left A₁ hr) (hMN_smul_right r₂ hC hA)

  have hY_lip : ∀ (d : ℕ) (s s' : Fin D → R),
      MatNormLe (Y_rec d s - Y_rec d s') ‖s - s'‖ := by
    intro d s s'
    have hC : 0 ≤ ‖s - s'‖ := norm_nonneg _
    induction d with
    | zero =>
      dsimp [Y_rec]
      simpa using hMN_zero hC
    | succ d ih =>
      change MatNormLe
        ((if hd : d < D then
            Y_rec d s + s ⟨d, hd⟩ • X_bas ⟨d, hd⟩ + (π_R * s ⟨d, hd⟩) • (Y_rec d s * X_bas ⟨d, hd⟩)
          else Y_rec d s) -
         (if hd : d < D then
            Y_rec d s' + s' ⟨d, hd⟩ • X_bas ⟨d, hd⟩ + (π_R * s' ⟨d, hd⟩) • (Y_rec d s' * X_bas ⟨d, hd⟩)
          else Y_rec d s')) ‖s - s'‖
      split_ifs with hd
      · set α : Fin D := ⟨d, hd⟩
        have hs_α : ‖s α - s' α‖ ≤ ‖s - s'‖ := norm_le_pi_norm (s - s') α
        have hπs_α : ‖π_R * s α - π_R * s' α‖ ≤ ‖s - s'‖ := by
          rw [← mul_sub, norm_mul]
          calc ‖π_R‖ * ‖s α - s' α‖
              ≤ 1 * ‖s - s'‖ :=
                mul_le_mul (PadicInt.norm_le_one π_R) hs_α (norm_nonneg _) zero_le_one
            _ = ‖s - s'‖ := one_mul _
        have hYX : MatNormLe (Y_rec d s * X_bas α - Y_rec d s' * X_bas α) ‖s - s'‖ := by
          rw [← Matrix.sub_mul]
          exact hMN_mul_right (X_bas α) hC ih
        have hrearr : (Y_rec d s + s α • X_bas α + (π_R * s α) • (Y_rec d s * X_bas α)) -
            (Y_rec d s' + s' α • X_bas α + (π_R * s' α) • (Y_rec d s' * X_bas α)) =
            (Y_rec d s - Y_rec d s') + (s α - s' α) • X_bas α +
              ((π_R * s α) • (Y_rec d s * X_bas α) - (π_R * s' α) • (Y_rec d s' * X_bas α)) := by
          rw [sub_smul]; abel
        rw [hrearr]
        exact hMN_add (hMN_add ih (hMN_smul_left (X_bas α) hs_α)) (hMN_smul_diff hC hπs_α hYX)
      · exact ih

  have hQ_lip : ∀ (d : ℕ) (s s' : Fin D → R),
      MatNormLe (Q_rec d s - Q_rec d s') ‖s - s'‖ := by
    intro d s s'
    have hC : 0 ≤ ‖s - s'‖ := norm_nonneg _
    induction d with
    | zero =>
      dsimp [Q_rec]
      simpa using hMN_zero hC
    | succ d ih =>
      change MatNormLe
        ((if hd : d < D then Q_rec d s + s ⟨d, hd⟩ • (Y_rec d s * X_bas ⟨d, hd⟩) else Q_rec d s) -
         (if hd : d < D then Q_rec d s' + s' ⟨d, hd⟩ • (Y_rec d s' * X_bas ⟨d, hd⟩) else Q_rec d s'))
        ‖s - s'‖
      split_ifs with hd
      · set α : Fin D := ⟨d, hd⟩
        have hs_α : ‖s α - s' α‖ ≤ ‖s - s'‖ := norm_le_pi_norm (s - s') α
        have hYX : MatNormLe (Y_rec d s * X_bas α - Y_rec d s' * X_bas α) ‖s - s'‖ := by
          rw [← Matrix.sub_mul]
          exact hMN_mul_right (X_bas α) hC (hY_lip d s s')
        have hrearr : (Q_rec d s + s α • (Y_rec d s * X_bas α)) -
            (Q_rec d s' + s' α • (Y_rec d s' * X_bas α)) =
            (Q_rec d s - Q_rec d s') +
              (s α • (Y_rec d s * X_bas α) - s' α • (Y_rec d s' * X_bas α)) := by abel
        rw [hrearr]
        exact hMN_add ih (hMN_smul_diff hC hs_α hYX)
      · exact ih

  have hRk_lip : ∀ s s' : Fin D → R, ‖Ψ_int (R_k s) - Ψ_int (R_k s')‖ ≤ ‖s - s'‖ := by
    intro s s'
    have hC : 0 ≤ ‖s - s'‖ := norm_nonneg _
    have hY_d : MatNormLe (Y_fn s - Y_fn s') ‖s - s'‖ := hY_lip D s s'
    have hQ_d : MatNormLe (Q_fn s - Q_fn s') ‖s - s'‖ := hQ_lip D s s'
    have hW_res : W_of (Y_fn s) - W_of (Y_fn s') =
        W_of (Y_fn s) * (((ℓ : R) ^ k) • (Y_fn s' - Y_fn s)) * W_of (Y_fn s') := by
      have h1 : W_of (Y_fn s) * U_of (Y_fn s') * W_of (Y_fn s') = W_of (Y_fn s) := by
        rw [Matrix.mul_assoc, hUW (Y_fn s'), Matrix.mul_one]
      have h2 : W_of (Y_fn s) * U_of (Y_fn s) * W_of (Y_fn s') = W_of (Y_fn s') := by
        rw [hWU (Y_fn s), Matrix.one_mul]
      calc W_of (Y_fn s) - W_of (Y_fn s')
          = W_of (Y_fn s) * U_of (Y_fn s') * W_of (Y_fn s') -
            W_of (Y_fn s) * U_of (Y_fn s) * W_of (Y_fn s') := by rw [h1, h2]
        _ = W_of (Y_fn s) * (U_of (Y_fn s') - U_of (Y_fn s)) * W_of (Y_fn s') := by
            rw [← Matrix.sub_mul, ← Matrix.mul_sub]
        _ = W_of (Y_fn s) * (((ℓ : R) ^ k) • (Y_fn s' - Y_fn s)) * W_of (Y_fn s') := by
            dsimp [U_of]
            have hsub : (1 + ((ℓ : R) ^ k) • Y_fn s') - (1 + ((ℓ : R) ^ k) • Y_fn s) =
                ((ℓ : R) ^ k) • (Y_fn s' - Y_fn s) := by rw [smul_sub]; abel
            rw [hsub]
    have hW_d : MatNormLe (W_of (Y_fn s) - W_of (Y_fn s')) ‖s - s'‖ := by
      rw [hW_res]
      refine hMN_mul_right (W_of (Y_fn s')) hC (hMN_mul_left (W_of (Y_fn s)) hC ?_)
      refine hMN_smul_right ((ℓ : R) ^ k) hC ?_
      have hneg : Y_fn s' - Y_fn s = -(Y_fn s - Y_fn s') := by abel
      rw [hneg]
      exact hMN_neg hY_d
    have hYY_d : MatNormLe (Y_fn s * Y_fn s - Y_fn s' * Y_fn s') ‖s - s'‖ :=
      hMN_mul_diff hC hY_d hY_d
    have hYYW_d : MatNormLe
        (Y_fn s * Y_fn s * W_of (Y_fn s) - Y_fn s' * Y_fn s' * W_of (Y_fn s')) ‖s - s'‖ :=
      hMN_mul_diff hC hYY_d hW_d
    have hR_d : MatNormLe (R_k s - R_k s') ‖s - s'‖ := by
      dsimp [R_k]
      have hrearr : ((2 : R) • Q_fn s - Y_fn s * Y_fn s * W_of (Y_fn s)) -
          ((2 : R) • Q_fn s' - Y_fn s' * Y_fn s' * W_of (Y_fn s')) =
          (2 : R) • (Q_fn s - Q_fn s') -
            (Y_fn s * Y_fn s * W_of (Y_fn s) - Y_fn s' * Y_fn s' * W_of (Y_fn s')) := by
        rw [smul_sub]; abel
      rw [hrearr]
      exact hMN_sub (hMN_smul_right 2 hC hQ_d) hYYW_d
    rw [pi_norm_le_iff_of_nonneg hC]
    intro α
    rw [Pi.sub_apply]
    dsimp [Ψ_int]
    rw [← Finset.sum_sub_distrib]
    refine h_sum_norm Finset.univ _ ‖s - s'‖ hC fun i _ => ?_
    rw [← Finset.sum_sub_distrib]
    refine h_sum_norm Finset.univ _ ‖s - s'‖ hC fun j _ => ?_
    rw [← mul_sub, norm_mul]
    calc ‖d_int α i j‖ * ‖(R_k s - R_k s') i j‖
        ≤ 1 * ‖s - s'‖ :=
          mul_le_mul (PadicInt.norm_le_one _) (hR_d i j) (norm_nonneg _) zero_le_one
      _ = ‖s - s'‖ := one_mul _

  have h_ell_div2 : ∀ x : R, ∃ z : R, (ℓ : R) * x = (2 : R) * z := by
    by_cases hℓ2 : ℓ = 2
    · intro x
      refine ⟨x, ?_⟩
      have hℓR : (ℓ : R) = (2 : R) :=
        (congrArg (Nat.cast (R := R)) hℓ2).trans Nat.cast_two
      rw [hℓR]
    · have h2_unit : IsUnit (2 : R) := by
        let φ : R →+* ZMod ℓ := PadicInt.toZMod
        have h2_lt : 2 < ℓ := lt_of_le_of_ne hℓ_prime.two_le (Ne.symm hℓ2)
        have hφ2_ne : φ (2 : R) ≠ 0 := by
          have h2_eq : (2 : R) = ((2 : ℕ) : R) := by norm_num
          rw [h2_eq, map_natCast, ne_eq, ZMod.natCast_eq_zero_iff]
          intro hdvd
          have hle : ℓ ≤ 2 := Nat.le_of_dvd (by decide) hdvd
          omega
        have hker : (2 : R) ∉ RingHom.ker φ := hφ2_ne
        rwa [PadicInt.ker_toZMod, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hker
      obtain ⟨u2, hu2⟩ := h2_unit
      intro x
      refine ⟨(↑(u2⁻¹) : R) * ((ℓ : R) * x), ?_⟩
      rw [← hu2, ← mul_assoc, Units.mul_inv, one_mul]

  refine ⟨r₀, hr₀_pos, fun B hB_mod hB_sp => ?_⟩
  have hB_ker : ∀ i j : Fin M, ∃ m_ij : R, (B.val - 1) i j = ((ℓ : R) ^ r₀) * m_ij := by
    intro i j
    have hmem_ker : (B.val - 1) i j ∈ RingHom.ker (PadicInt.toZModPow r₀) := by
      rw [RingHom.mem_ker, Matrix.sub_apply, map_sub]
      have hBij : PadicInt.toZModPow r₀ (B.val i j) =
          ((B.val).map (PadicInt.toZModPow r₀)) i j := rfl
      rw [hBij, hB_mod]
      simp only [Matrix.one_apply]
      split_ifs <;> simp
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton, dvd_iff_exists_eq_mul_right] at hmem_ker
    exact hmem_ker

  let M_B : Matrix (Fin M) (Fin M) R := Matrix.of (fun i j => Classical.choose (hB_ker i j))
  have hM_B_eq : B.val - 1 = ((ℓ : R) ^ r₀) • M_B := by
    ext i j
    exact Classical.choose_spec (hB_ker i j)

  let Z_B : Matrix (Fin M) (Fin M) R := Matrix.of (fun i j => Classical.choose (h_ell_div2 (M_B i j)))
  have hZ_B_eq : (ℓ : R) • M_B = (2 : R) • Z_B := by
    ext i j
    exact Classical.choose_spec (h_ell_div2 (M_B i j))

  let Y_B : Matrix (Fin M) (Fin M) R := ((ℓ : R) ^ c₀) • Z_B
  have hB_val : B.val = 1 + (2 * (ℓ : R) ^ k) • Y_B := by
    have hr₀_split : (ℓ : R) ^ r₀ = ((ℓ : R) ^ k * (ℓ : R) ^ c₀) * (ℓ : R) := by
      dsimp [r₀]
      rw [pow_add, pow_add, pow_one]
    calc B.val = 1 + (B.val - 1) := (add_sub_cancel 1 B.val).symm
      _ = 1 + ((ℓ : R) ^ r₀) • M_B := by rw [hM_B_eq]
      _ = 1 + ((ℓ : R) ^ k * (ℓ : R) ^ c₀) • ((ℓ : R) • M_B) := by rw [hr₀_split, mul_smul]
      _ = 1 + ((ℓ : R) ^ k * (ℓ : R) ^ c₀) • ((2 : R) • Z_B) := by rw [hZ_B_eq]
      _ = 1 + (2 * (ℓ : R) ^ k) • Y_B := by
          dsimp [Y_B]
          rw [smul_smul, smul_smul]
          congr 2
          ring

  have hc_YB_sp : ((c_tilde Y_B).map ι).transpose * J + J * ((c_tilde Y_B).map ι) = 0 := by
    apply hc_sp Y_B
    rwa [← hB_val]

  have hc_YB_factor : c_tilde Y_B = ((ℓ : R) ^ c₀) • (Z_B * W_of Y_B) := by
    dsimp [c_tilde, Y_B]
    exact Matrix.smul_mul _ _ _

  let T_map : (Fin D → R) → (Fin D → R) :=
    fun s => Ψ_int (Z_B * W_of Y_B) - (ℓ : R) • Ψ_int (R_k s)

  let K_lip : NNReal := (ℓ : NNReal)⁻¹
  have hK_lt_one : K_lip < 1 := by
    dsimp [K_lip]
    refine inv_lt_one_of_one_lt₀ ?_
    exact_mod_cast hℓ_prime.one_lt

  have hT_lip : LipschitzWith K_lip T_map := by
    refine LipschitzWith.of_dist_le_mul fun s s' => ?_
    rw [dist_eq_norm, dist_eq_norm]
    have hsub_T : T_map s - T_map s' = -((ℓ : R) • (Ψ_int (R_k s) - Ψ_int (R_k s'))) := by
      dsimp [T_map]
      rw [smul_sub]
      abel
    rw [hsub_T, norm_neg]
    have hK_coe : (K_lip : ℝ) = (ℓ : ℝ)⁻¹ := rfl
    rw [hK_coe]
    have hnonneg : 0 ≤ (ℓ : ℝ)⁻¹ * ‖s - s'‖ := by positivity
    rw [pi_norm_le_iff_of_nonneg hnonneg]
    intro α
    rw [Pi.smul_apply, smul_eq_mul, norm_mul, PadicInt.norm_p]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact (norm_le_pi_norm _ α).trans (hRk_lip s s')

  have hT_contr : ContractingWith K_lip T_map := ⟨hK_lt_one, hT_lip⟩
  let s_star : Fin D → R := ContractingWith.fixedPoint T_map hT_contr
  have hs_fix : T_map s_star = s_star := ContractingWith.fixedPoint_isFixedPt hT_contr

  have hs_K : (fun α : Fin D => ι (s_star α)) =
      Ψ ((c_tilde Y_B).map ι - ((ℓ : K) ^ k) • ((R_k s_star).map ι)) := by
    ext α
    have hα := congrArg ι (congrFun hs_fix.symm α)
    dsimp [T_map] at hα
    rw [map_sub, map_mul, map_natCast, hΨ_int_ι, hΨ_int_ι] at hα
    have hterm1 : ((ℓ : K) ^ c₀) * Ψ ((Z_B * W_of Y_B).map ι) α =
        Ψ ((c_tilde Y_B).map ι) α := by
      have hmap : (c_tilde Y_B).map ι = ((ℓ : K) ^ c₀) • ((Z_B * W_of Y_B).map ι) := by
        rw [hc_YB_factor, hmap_smul_ι, map_pow, map_natCast]
      rw [hmap, map_smul, Pi.smul_apply, smul_eq_mul]
    have hterm2 : (ℓ : K) * (((ℓ : K) ^ c₀) * Ψ ((R_k s_star).map ι) α) =
        Ψ (((ℓ : K) ^ k) • ((R_k s_star).map ι)) α := by
      have hk_pow : (ℓ : K) * (ℓ : K) ^ c₀ = (ℓ : K) ^ k := (pow_succ' (ℓ : K) c₀).symm
      rw [← mul_assoc, hk_pow, map_smul, Pi.smul_apply, smul_eq_mul]
    rw [hα, hterm1, hterm2, map_sub, Pi.sub_apply]

  have hZ_diff_sp :
      ((c_tilde Y_B).map ι - ((ℓ : K) ^ k) • ((R_k s_star).map ι)).transpose * J +
      J * ((c_tilde Y_B).map ι - ((ℓ : K) ^ k) • ((R_k s_star).map ι)) = 0 := by
    rw [Matrix.transpose_sub, Matrix.transpose_smul, Matrix.sub_mul, Matrix.mul_sub,
      Matrix.smul_mul, Matrix.mul_smul]
    calc ((c_tilde Y_B).map ι).transpose * J - ((ℓ : K) ^ k) • (((R_k s_star).map ι).transpose * J) +
          (J * (c_tilde Y_B).map ι - ((ℓ : K) ^ k) • (J * (R_k s_star).map ι))
        = (((c_tilde Y_B).map ι).transpose * J + J * (c_tilde Y_B).map ι) -
          ((ℓ : K) ^ k) • (((R_k s_star).map ι).transpose * J + J * (R_k s_star).map ι) := by
            rw [smul_add]; abel
      _ = 0 := by rw [hc_YB_sp, hRk_sp s_star, smul_zero, sub_self]

  have hL_eq : (L_fn s_star).map ι =
      (c_tilde Y_B).map ι - ((ℓ : K) ^ k) • ((R_k s_star).map ι) := by
    rw [hL_fn_map s_star, hs_K, hΛ₀_Ψ _ hZ_diff_sp]

  have hc_map_eq : (c_tilde (Y_fn s_star)).map ι = (c_tilde Y_B).map ι := by
    change ι.mapMatrix (c_tilde (Y_fn s_star)) = (c_tilde Y_B).map ι
    rw [hc_Y_fn s_star, map_add]
    change (L_fn s_star).map ι + (((ℓ : R) ^ k) • R_k s_star).map ι = (c_tilde Y_B).map ι
    rw [hmap_smul_ι, map_pow, map_natCast, hL_eq, sub_add_cancel]

  have hc_eq : c_tilde (Y_fn s_star) = c_tilde Y_B := by
    ext i j
    exact hinj_ι (congrFun (congrFun hc_map_eq i) j)

  have hY_eq : Y_fn s_star = Y_B := hc_inj (Y_fn s_star) Y_B hc_eq
  have hP_eq_B : P_rec D s_star = B := by
    apply Units.ext
    rw [hP_val D s_star]
    dsimp [π_R, Y_fn] at hY_eq ⊢
    rw [hY_eq, ← hB_val]
  rw [← hP_eq_B]
  exact hP_mem D s_star

theorem weil_weyl_symplectic_tensor_coinvariant_trace (ℓ M r₀ : ℕ) [Fact (Nat.Prime ℓ)]
    (hM : 1 ≤ M) (hr₀ : 1 ≤ r₀)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (hJ_skew : J.transpose = -J)
    (hJ_det : J.det ≠ 0)
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (hCong : ∀ B : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ,
      (B.val).map (PadicInt.toZModPow r₀) = 1 →
      ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((B.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J →
      B ∈ G_geom)
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (c_mult : Padic ℓ)
    (hFu_sim : ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
      ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = c_mult • J) :
    WeilSymplecticLinInvDual ℓ M G_geom = ⊥ ∧
    ∀ (k : ℕ), 1 ≤ k →
      ∀ φ ∈ WeilSymplecticTensorInvDual ℓ M k G_geom,
        φ.comp (PiTensorProduct.map (fun _ : Fin (2 * k) =>
          ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin)) =
          (c_mult ^ k) • φ :=
by
  have _ := hr₀
  let K := Padic ℓ
  let V := Fin M → K
  let ι : PadicInt ℓ →+* K := algebraMap (PadicInt ℓ) K
  have hι_apply : ∀ z : PadicInt ℓ, ι z = z.1 := fun _ => rfl
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_ne_K : (ℓ : K) ≠ 0 := Nat.cast_ne_zero.mpr hℓ_prime.ne_zero
  
  let B_J : LinearMap.BilinForm K V := Matrix.toBilin' J
  have hBJ_apply : ∀ x y : V, B_J x y = dotProduct x (J.mulVec y) :=
    fun x y => Matrix.toBilin'_apply' J x y
  have hJ_entry : ∀ a b : Fin M, J a b = - J b a := by
    intro a b
    simpa only [Matrix.transpose_apply, Matrix.neg_apply] using congrFun (congrFun hJ_skew b) a
  have hBJ_skew : ∀ x y : V, B_J y x = - B_J x y := by
    intro x y
    simp only [hBJ_apply, dotProduct, Matrix.mulVec]
    calc ∑ i : Fin M, y i * ∑ j : Fin M, J i j * x j
      _ = ∑ i : Fin M, ∑ j : Fin M, y i * (J i j * x j) :=
          Finset.sum_congr rfl (fun i _ => Finset.mul_sum _ _ _)
      _ = ∑ j : Fin M, - (x j * ∑ i : Fin M, J j i * y i) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun j _ => ?_
          calc ∑ i : Fin M, y i * (J i j * x j)
            _ = ∑ i : Fin M, (- x j) * (J j i * y i) :=
                Finset.sum_congr rfl (fun i _ => by rw [hJ_entry i j]; ring)
            _ = (- x j) * ∑ i : Fin M, J j i * y i := (Finset.mul_sum _ _ _).symm
            _ = - (x j * ∑ i : Fin M, J j i * y i) := neg_mul _ _
      _ = - ∑ j : Fin M, x j * ∑ i : Fin M, J j i * y i := by rw [Finset.sum_neg_distrib]
  have hBJ_alt : ∀ x : V, B_J x x = 0 := by
    intro x
    have h2 : (2 : K) * B_J x x = 0 := by
      have h := hBJ_skew x x
      linear_combination h
    exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
  have hBJ_nondeg : ∀ x : V, (∀ y : V, B_J x y = 0) → x = 0 :=
    ((Matrix.nondegenerate_iff_det_ne_zero.mpr hJ_det).toBilin').1
  let N_mat : V → Matrix (Fin M) (Fin M) K :=
    fun v => Matrix.of (fun i j => v i * (J.mulVec v) j)
  have hN_mulVec : ∀ (v x : V), (N_mat v).mulVec x = (B_J x v) • v := by
    intro v x; funext i
    simp only [N_mat, Matrix.mulVec, dotProduct, Matrix.of_apply, hBJ_apply]
    change (∑ j : Fin M, v i * (J.mulVec v) j * x j) = (∑ j : Fin M, x j * (J.mulVec v) j) * v i
    calc ∑ j : Fin M, v i * (J.mulVec v) j * x j
      _ = ∑ j : Fin M, (x j * (J.mulVec v) j) * v i := Finset.sum_congr rfl (fun j _ => by ring)
      _ = (∑ j : Fin M, x j * (J.mulVec v) j) * v i := (Finset.sum_mul _ _ _).symm
  have h_smul_mulVec : ∀ (c : K) (A_m : Matrix (Fin M) (Fin M) K) (x : V),
      (c • A_m).mulVec x = c • A_m.mulVec x := by
    intro c A_m x; funext i
    simp only [Matrix.mulVec, dotProduct, Matrix.smul_apply, Pi.smul_apply, smul_eq_mul,
      Finset.mul_sum, mul_assoc]
  have hT_mulVec : ∀ (v : V) (t : K) (x : V),
      (1 + t • N_mat v).mulVec x = x + (t * B_J x v) • v := by
    intro v t x
    rw [Matrix.add_mulVec, Matrix.one_mulVec, h_smul_mulVec, hN_mulVec, smul_smul]
  have hN_sq : ∀ v : V, N_mat v * N_mat v = 0 := by
    intro v; ext i j
    simp only [N_mat, Matrix.mul_apply, Matrix.of_apply, Matrix.zero_apply]
    have hv0 : ∑ a : Fin M, v a * (J.mulVec v) a = 0 := by
      simpa only [hBJ_apply, dotProduct] using hBJ_alt v
    calc ∑ a : Fin M, v i * (J.mulVec v) a * (v a * (J.mulVec v) j)
      _ = ∑ a : Fin M, (v i * (J.mulVec v) j) * (v a * (J.mulVec v) a) :=
          Finset.sum_congr rfl (fun a _ => by ring)
      _ = (v i * (J.mulVec v) j) * ∑ a : Fin M, v a * (J.mulVec v) a := (Finset.mul_sum _ _ _).symm
      _ = 0 := by rw [hv0, mul_zero]
  have hN_inf_sp : ∀ v : V, (N_mat v).transpose * J + J * N_mat v = 0 := by
    intro v; ext i j
    simp only [N_mat, Matrix.add_apply, Matrix.mul_apply, Matrix.transpose_apply,
      Matrix.of_apply, Matrix.zero_apply]
    have h1 : ∑ a : Fin M, v a * (J.mulVec v) i * J a j = - ((J.mulVec v) i * (J.mulVec v) j) := by
      calc ∑ a : Fin M, v a * (J.mulVec v) i * J a j
        _ = ∑ a : Fin M, - ((J.mulVec v) i * (J j a * v a)) :=
            Finset.sum_congr rfl (fun a _ => by rw [hJ_entry a j]; ring)
        _ = - ∑ a : Fin M, (J.mulVec v) i * (J j a * v a) := by rw [Finset.sum_neg_distrib]
        _ = - ((J.mulVec v) i * ∑ a : Fin M, J j a * v a) := by rw [← Finset.mul_sum]
        _ = - ((J.mulVec v) i * (J.mulVec v) j) := rfl
    have h2 : ∑ a : Fin M, J i a * (v a * (J.mulVec v) j) = (J.mulVec v) i * (J.mulVec v) j := by
      calc ∑ a : Fin M, J i a * (v a * (J.mulVec v) j)
        _ = ∑ a : Fin M, (J i a * v a) * (J.mulVec v) j :=
            Finset.sum_congr rfl (fun a _ => by ring)
        _ = (∑ a : Fin M, J i a * v a) * (J.mulVec v) j := (Finset.sum_mul _ _ _).symm
        _ = (J.mulVec v) i * (J.mulVec v) j := rfl
    rw [h1, h2, neg_add_cancel]
  have hT_sp : ∀ (v : V) (t : K), (1 + t • N_mat v).transpose * J * (1 + t • N_mat v) = J := by
    intro v t
    have hNTJN : (N_mat v).transpose * J * N_mat v = 0 := by
      have hneg : (N_mat v).transpose * J = - (J * N_mat v) :=
        eq_neg_of_add_eq_zero_left (hN_inf_sp v)
      rw [hneg, Matrix.neg_mul, Matrix.mul_assoc, hN_sq v, Matrix.mul_zero, neg_zero]
    rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_smul]
    simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
      Matrix.smul_mul, Matrix.mul_smul, hNTJN, smul_zero, add_zero]
    rw [add_assoc, ← smul_add, hN_inf_sp v, smul_zero, add_zero]
  
  have hCongFamily : ∀ v : V, ∃ m : ℕ, ∀ s : PadicInt ℓ,
      ∃ g ∈ G_geom, (g.val).map ι = 1 + ((ℓ : K) ^ (r₀ + m) * ι s) • N_mat v := by
    intro v
    have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓ_prime.one_lt
    have hℓ_pos : (0 : ℝ) < (ℓ : ℝ) := by linarith
    have hℓ_ne_R : (ℓ : ℝ) ≠ 0 := hℓ_pos.ne'
    let m_fn : Fin M × Fin M → ℕ :=
      fun p => Classical.choose (pow_unbounded_of_one_lt ‖N_mat v p.1 p.2‖ hℓ_gt1)
    let m : ℕ := Finset.univ.sup m_fn
    have hnorm_le1 : ∀ i j : Fin M, ‖(ℓ : K) ^ m * N_mat v i j‖ ≤ 1 := by
      intro i j
      have hle_m : m_fn (i, j) ≤ m := Finset.le_sup (f := m_fn) (Finset.mem_univ (i, j))
      have hpow_le : (ℓ : ℝ) ^ m_fn (i, j) ≤ (ℓ : ℝ) ^ m := pow_le_pow_right₀ hℓ_gt1.le hle_m
      have hlt_entry : ‖N_mat v i j‖ ≤ (ℓ : ℝ) ^ m :=
        (Classical.choose_spec (pow_unbounded_of_one_lt ‖N_mat v i j‖ hℓ_gt1)).le.trans hpow_le
      rw [norm_mul, norm_pow, Padic.norm_p]
      calc ((ℓ : ℝ)⁻¹) ^ m * ‖N_mat v i j‖
        _ ≤ ((ℓ : ℝ)⁻¹) ^ m * (ℓ : ℝ) ^ m :=
            mul_le_mul_of_nonneg_left hlt_entry (by positivity)
        _ = ((ℓ : ℝ)⁻¹ * (ℓ : ℝ)) ^ m := (mul_pow _ _ _).symm
        _ = 1 := by rw [inv_mul_cancel₀ hℓ_ne_R, one_pow]
    let M₀ : Matrix (Fin M) (Fin M) (PadicInt ℓ) :=
      Matrix.of (fun i j => ⟨(ℓ : K) ^ m * N_mat v i j, hnorm_le1 i j⟩)
    have hM₀_sq : M₀ * M₀ = 0 := by
      ext i j
      apply Subtype.ext
      change ι ((M₀ * M₀) i j) = 0
      rw [Matrix.mul_apply, map_sum]
      have hsq_ij := congrFun (congrFun (hN_sq v) i) j
      simp only [Matrix.mul_apply, Matrix.zero_apply] at hsq_ij
      calc ∑ a : Fin M, ι (M₀ i a * M₀ a j)
        _ = ∑ a : Fin M, ((ℓ : K) ^ m * (ℓ : K) ^ m) * (N_mat v i a * N_mat v a j) :=
            Finset.sum_congr rfl (fun a _ => by
              rw [map_mul]
              change ((ℓ : K) ^ m * N_mat v i a) * ((ℓ : K) ^ m * N_mat v a j) = _
              ring)
        _ = ((ℓ : K) ^ m * (ℓ : K) ^ m) * ∑ a : Fin M, N_mat v i a * N_mat v a j :=
            (Finset.mul_sum _ _ _).symm
        _ = 0 := by rw [hsq_ij, mul_zero]
    refine ⟨m, fun s => ?_⟩
    let c_s : PadicInt ℓ := (ℓ : PadicInt ℓ) ^ r₀ * s
    let E_pos : Matrix (Fin M) (Fin M) (PadicInt ℓ) := 1 + c_s • M₀
    let E_neg : Matrix (Fin M) (Fin M) (PadicInt ℓ) := 1 + (-c_s) • M₀
    have h_mul_pair : ∀ a b : PadicInt ℓ, a + b = 0 →
        (1 + a • M₀) * (1 + b • M₀) = 1 := by
      intro a b hab
      simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
        Matrix.smul_mul, Matrix.mul_smul, hM₀_sq, smul_zero, add_zero]
      rw [add_assoc, ← add_smul, hab, zero_smul, add_zero]
    let B_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ :=
      ⟨E_pos, E_neg, h_mul_pair c_s (-c_s) (add_neg_cancel c_s),
        h_mul_pair (-c_s) c_s (neg_add_cancel c_s)⟩
    have hBu_mod : (B_u.val).map (PadicInt.toZModPow r₀) = 1 := by
      have hc_mod : PadicInt.toZModPow r₀ c_s = 0 := by
        simp only [c_s, map_mul, map_pow, map_natCast]
        rw [← Nat.cast_pow, ZMod.natCast_self, zero_mul]
      ext i j
      simp only [B_u, E_pos, Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply,
        smul_eq_mul, map_add, map_mul, hc_mod, zero_mul, add_zero, Matrix.one_apply]
      split_ifs <;> simp
    have hBu_map : (B_u.val).map ι = 1 + ((ℓ : K) ^ (r₀ + m) * ι s) • N_mat v := by
      ext i j
      have h_entry : ι (c_s * M₀ i j) = ((ℓ : K) ^ (r₀ + m) * ι s) * N_mat v i j := by
        rw [map_mul]
        have hc_ι : ι c_s = (ℓ : K) ^ r₀ * ι s := by
          simp only [c_s, map_mul, map_pow, map_natCast]
        have hM_ι : ι (M₀ i j) = (ℓ : K) ^ m * N_mat v i j := rfl
        rw [hc_ι, hM_ι, pow_add]
        ring
      change ι ((1 : Matrix (Fin M) (Fin M) (PadicInt ℓ)) i j + c_s * M₀ i j) =
        (1 : Matrix (Fin M) (Fin M) K) i j + ((ℓ : K) ^ (r₀ + m) * ι s) * N_mat v i j
      rw [map_add, h_entry, Matrix.one_apply, Matrix.one_apply]
      split_ifs <;> simp
    have hBu_sp : ((B_u.val).map ι).transpose * J * ((B_u.val).map ι) = J := by
      rw [hBu_map]
      exact hT_sp v ((ℓ : K) ^ (r₀ + m) * ι s)
    exact ⟨B_u, hCong B_u hBu_mod hBu_sp, hBu_map⟩
  
  have hLinInv : WeilSymplecticLinInvDual ℓ M G_geom = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro φ hφ
    apply LinearMap.ext
    intro v
    rw [LinearMap.zero_apply]
    by_cases hv : v = 0
    · rw [hv, map_zero]
    · obtain ⟨m, hm_fam⟩ := hCongFamily v
      obtain ⟨g, hg_mem, hg_map⟩ := hm_fam 1
      have hφ_g := hφ g hg_mem
      have hnot_all_zero : ¬ ∀ x : V, B_J v x = 0 := fun hall => hv (hBJ_nondeg v hall)
      obtain ⟨x, hx⟩ := Classical.not_forall.mp hnot_all_zero
      have hxv : B_J x v ≠ 0 := by
        rw [hBJ_skew v x]
        exact neg_ne_zero.mpr hx
      have heval := LinearMap.congr_fun hφ_g x
      rw [LinearMap.comp_apply, hg_map, map_one, mul_one, Matrix.mulVecLin_apply,
        hT_mulVec, map_add, map_smul, smul_eq_mul] at heval
      have hprod_zero : ((ℓ : K) ^ (r₀ + m) * B_J x v) * φ v = 0 := by
        linear_combination heval
      have hcoeff_ne : (ℓ : K) ^ (r₀ + m) * B_J x v ≠ 0 :=
        mul_ne_zero (pow_ne_zero (r₀ + m) hℓ_ne_K) hxv
      exact (mul_eq_zero.mp hprod_zero).resolve_left hcoeff_ne
  
  have hTransvInv : ∀ (k : ℕ), 1 ≤ k →
      ∀ φ ∈ WeilSymplecticTensorInvDual ℓ M k G_geom,
        ∀ (v : V) (t₀ : K),
          φ.comp (PiTensorProduct.map (fun _ : Fin (2 * k) =>
            (1 + t₀ • N_mat v).mulVecLin)) = φ := by
    intro k _ φ hφ v t₀
    apply PiTensorProduct.ext
    apply MultilinearMap.ext
    intro w
    change φ ((PiTensorProduct.map (fun _ : Fin (2 * k) => (1 + t₀ • N_mat v).mulVecLin))
      (PiTensorProduct.tprod K w)) = φ (PiTensorProduct.tprod K w)
    rw [PiTensorProduct.map_tprod]
    simp only [Matrix.mulVecLin_apply]
    let Φ : MultilinearMap K (fun _ : Fin (2 * k) => V) K :=
      φ.compMultilinearMap (PiTensorProduct.tprod K)
    let u_vec : Fin (2 * k) → V := fun i => (B_J (w i) v) • v
    have h_expand : ∀ t : K,
        φ (PiTensorProduct.tprod K (fun i => (1 + t • N_mat v).mulVec (w i))) =
          ∑ S : Finset (Fin (2 * k)), t ^ S.card * Φ (S.piecewise u_vec w) := by
      intro t
      have hfun : (fun i => (1 + t • N_mat v).mulVec (w i)) =
          (fun i => t • u_vec i) + w := by
        funext i
        rw [Pi.add_apply, hT_mulVec, add_comm]
        simp only [u_vec, smul_smul]
      change Φ (fun i => (1 + t • N_mat v).mulVec (w i)) = _
      rw [hfun, MultilinearMap.map_add_univ]
      refine Finset.sum_congr rfl fun S _ => ?_
      have hpw_eq : S.piecewise (fun i => t • u_vec i) w =
          S.piecewise (fun i => t • S.piecewise u_vec w i) (S.piecewise u_vec w) := by
        funext i
        by_cases hi : i ∈ S <;> simp [Finset.piecewise, hi]
      rw [hpw_eq, Φ.map_piecewise_smul (fun _ => t) (S.piecewise u_vec w) S,
        Finset.prod_const, smul_eq_mul]
    let P : Polynomial K :=
      ∑ S : Finset (Fin (2 * k)),
        Polynomial.C (Φ (S.piecewise u_vec w)) * Polynomial.X ^ S.card
    let Q : Polynomial K := P - Polynomial.C (Φ w)
    have hQ_eval : ∀ t : K,
        Q.eval t = φ (PiTensorProduct.tprod K (fun i => (1 + t • N_mat v).mulVec (w i))) - Φ w := by
      intro t
      simp only [Q, P, Polynomial.eval_sub, Polynomial.eval_finsetSum, Polynomial.eval_mul,
        Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, h_expand t]
      congr 1
      refine Finset.sum_congr rfl fun S _ => mul_comm _ _
    obtain ⟨m, hm_fam⟩ := hCongFamily v
    let c₀ : K := (ℓ : K) ^ (r₀ + m)
    have hc₀_ne : c₀ ≠ 0 := pow_ne_zero (r₀ + m) hℓ_ne_K
    have hQ_roots : ∀ n : ℕ, Q.eval (c₀ * (n : K)) = 0 := by
      intro n
      obtain ⟨g, hg_mem, hg_map⟩ := hm_fam (n : PadicInt ℓ)
      have hφ_g := LinearMap.congr_fun (hφ g hg_mem) (PiTensorProduct.tprod K w)
      rw [LinearMap.comp_apply, PiTensorProduct.map_tprod] at hφ_g
      have hι_n : ι (n : PadicInt ℓ) = (n : K) := map_natCast ι n
      rw [hg_map, hι_n] at hφ_g
      simp only [Matrix.mulVecLin_apply] at hφ_g
      rw [hQ_eval]
      exact sub_eq_zero.mpr hφ_g
    have hQ_zero : Q = 0 := by
      classical
      by_contra hQ_ne
      let η : ℕ → K := fun n => c₀ * (n : K)
      have hη_inj : Function.Injective η := by
        intro a b hab
        exact Nat.cast_injective (mul_left_cancel₀ hc₀_ne hab)
      let I : Finset K := (Finset.range (Q.natDegree + 1)).image η
      have hI_card : I.card = Q.natDegree + 1 := by
        rw [Finset.card_image_of_injective _ hη_inj, Finset.card_range]
      have hI_sub : I ⊆ Q.roots.toFinset := by
        intro z hz
        obtain ⟨n, _, rfl⟩ := Finset.mem_image.mp hz
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hQ_ne]
        exact hQ_roots n
      have hcard_le : I.card ≤ Q.natDegree :=
        (Finset.card_le_card hI_sub).trans
          ((Multiset.toFinset_card_le Q.roots).trans (Polynomial.card_roots' Q))
      omega
    have hQ_t₀ : Q.eval t₀ = 0 := by rw [hQ_zero, Polynomial.eval_zero]
    rw [hQ_eval t₀] at hQ_t₀
    exact sub_eq_zero.mp hQ_t₀
  
  have hDarboux : ∀ (d : ℕ) (V₀ : Type) [AddCommGroup V₀] [Module K V₀] [FiniteDimensional K V₀],
      Module.finrank K V₀ = d →
      ∀ (B : LinearMap.BilinForm K V₀),
        (∀ x : V₀, B x x = 0) →
        (∀ x : V₀, (∀ y : V₀, B x y = 0) → x = 0) →
        ∃ (g : ℕ) (b : Module.Basis (Fin g ⊕ Fin g) K V₀),
          ∀ r s : Fin g,
            B (b (Sum.inl r)) (b (Sum.inl s)) = 0 ∧
            B (b (Sum.inr r)) (b (Sum.inr s)) = 0 ∧
            B (b (Sum.inl r)) (b (Sum.inr s)) = (if r = s then 1 else 0) ∧
            B (b (Sum.inr r)) (b (Sum.inl s)) = (if r = s then -1 else 0) := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro V₀ _ _ _ hdim B hAlt hNondeg
      have hSkew : ∀ x y : V₀, B y x = - B x y := by
        intro x y
        have hsum : B (x + y) (x + y) = 0 := hAlt (x + y)
        simp only [map_add, LinearMap.add_apply, hAlt, zero_add, add_zero] at hsum
        exact eq_neg_of_add_eq_zero_left hsum
      rcases Nat.eq_zero_or_pos d with rfl | hd_pos
      · have : Subsingleton V₀ := Module.finrank_zero_iff.mp hdim
        let e_zero : V₀ ≃ₗ[K] (Fin 0 ⊕ Fin 0 →₀ K) :=
          { toFun := fun _ => 0
            map_add' := fun _ _ => by simp
            map_smul' := fun _ _ => by simp
            invFun := fun _ => 0
            left_inv := fun x => Subsingleton.elim _ _
            right_inv := fun y => Subsingleton.elim _ _ }
        exact ⟨0, Module.Basis.ofRepr e_zero, fun r => Fin.elim0 r⟩
      · have : Nontrivial V₀ := Module.finrank_pos_iff.mp (hdim.symm ▸ hd_pos)
        obtain ⟨e, he⟩ := exists_ne (0 : V₀)
        have hnot_orth : ¬ ∀ y : V₀, B e y = 0 := fun hall => he (hNondeg e hall)
        obtain ⟨y₀, hy₀⟩ := Classical.not_forall.mp hnot_orth
        let f : V₀ := (B e y₀)⁻¹ • y₀
        have hBef : B e f = 1 := by
          simp only [f, map_smul, smul_eq_mul, inv_mul_cancel₀ hy₀]
        have hBfe : B f e = -1 := by rw [hSkew e f, hBef]
        let W : Submodule K V₀ := LinearMap.ker (B e) ⊓ LinearMap.ker (B f)
        have hf_not_W : f ∉ W := by
          intro hfW
          exact one_ne_zero (hBef.symm.trans hfW.1)
        have hW_ne_top : W ≠ ⊤ := fun htop => hf_not_W (htop ▸ Submodule.mem_top)
        have hdim_W : Module.finrank K ↥W < d := by
          rw [← hdim]
          exact Submodule.finrank_lt hW_ne_top
        let π_W : V₀ → V₀ := fun x => x - B x f • e + B x e • f
        have hπ_mem : ∀ x : V₀, π_W x ∈ W := by
          intro x
          refine ⟨?_, ?_⟩
          · change B e (x - B x f • e + B x e • f) = 0
            simp only [map_add, map_sub, map_smul, smul_eq_mul, hAlt e, hBef, mul_zero, mul_one,
              sub_zero, hSkew e x]
            ring
          · change B f (x - B x f • e + B x e • f) = 0
            simp only [map_add, map_sub, map_smul, smul_eq_mul, hAlt f, hBfe, mul_zero,
              add_zero, hSkew f x]
            ring
        let B_W : LinearMap.BilinForm K ↥W := (B.compl₂ W.subtype).comp W.subtype
        have hBW_alt : ∀ u : ↥W, B_W u u = 0 := fun u => hAlt u.1
        have hBW_nondeg : ∀ u : ↥W, (∀ w : ↥W, B_W u w = 0) → u = 0 := by
          intro u hu
          apply Subtype.ext
          apply hNondeg u.1
          intro x
          have hx_decomp : x = B x f • e - B x e • f + π_W x := by simp only [π_W]; abel
          have hue : B u.1 e = 0 := by rw [hSkew e u.1, u.2.1, neg_zero]
          have huf : B u.1 f = 0 := by rw [hSkew f u.1, u.2.2, neg_zero]
          have huπ : B u.1 (π_W x) = 0 := hu ⟨π_W x, hπ_mem x⟩
          rw [hx_decomp]
          simp only [map_add, map_sub, map_smul, smul_eq_mul, hue, huf, huπ, mul_zero, sub_zero,
            add_zero]
        obtain ⟨g', b_W, hb_W⟩ := ih (Module.finrank K ↥W) hdim_W ↥W rfl B_W hBW_alt hBW_nondeg
        let v_fam : Fin (g' + 1) ⊕ Fin (g' + 1) → V₀
          | Sum.inl j => Fin.cases e (fun r => (b_W (Sum.inl r)).1) j
          | Sum.inr j => Fin.cases f (fun r => (b_W (Sum.inr r)).1) j
        have hv_pair : ∀ r s : Fin (g' + 1),
            B (v_fam (Sum.inl r)) (v_fam (Sum.inl s)) = 0 ∧
            B (v_fam (Sum.inr r)) (v_fam (Sum.inr s)) = 0 ∧
            B (v_fam (Sum.inl r)) (v_fam (Sum.inr s)) = (if r = s then 1 else 0) ∧
            B (v_fam (Sum.inr r)) (v_fam (Sum.inl s)) = (if r = s then -1 else 0) := by
          intro r s
          refine Fin.cases ?_ (fun r' => ?_) r
          · refine Fin.cases ?_ (fun s' => ?_) s
            · simp [v_fam, hAlt e, hAlt f, hBef, hBfe]
            · have hsL := (b_W (Sum.inl s')).2
              have hsR := (b_W (Sum.inr s')).2
              have hne : (0 : Fin (g' + 1)) ≠ s'.succ := (Fin.succ_ne_zero s').symm
              simp only [v_fam, Fin.cases_zero, Fin.cases_succ, hne, ↓reduceIte]
              exact ⟨hsL.1, hsR.2, hsR.1, hsL.2⟩
          · refine Fin.cases ?_ (fun s' => ?_) s
            · have hrL := (b_W (Sum.inl r')).2
              have hrR := (b_W (Sum.inr r')).2
              have hne : r'.succ ≠ (0 : Fin (g' + 1)) := Fin.succ_ne_zero r'
              simp only [v_fam, Fin.cases_zero, Fin.cases_succ, hne, ↓reduceIte]
              refine ⟨?_, ?_, ?_, ?_⟩
              · rw [hSkew e _, hrL.1, neg_zero]
              · rw [hSkew f _, hrR.2, neg_zero]
              · rw [hSkew f _, hrL.2, neg_zero]
              · rw [hSkew e _, hrR.1, neg_zero]
            · simp only [v_fam, Fin.cases_succ, Fin.succ_inj]
              exact hb_W r' s'
        have hv_indep : LinearIndependent K v_fam := by
          rw [Fintype.linearIndependent_iff]
          intro c hc idx
          rcases idx with r | r
          · have hpair := congrArg (fun z => B z (v_fam (Sum.inr r))) hc
            rw [Fintype.sum_sum_type] at hpair
            simp only [map_zero, LinearMap.zero_apply, map_add, LinearMap.add_apply,
              map_sum, LinearMap.sum_apply, map_smul, LinearMap.smul_apply, smul_eq_mul] at hpair
            have hsum_L : (∑ i : Fin (g' + 1),
                c (Sum.inl i) * B (v_fam (Sum.inl i)) (v_fam (Sum.inr r))) = c (Sum.inl r) := by
              have hcongr : ∀ i : Fin (g' + 1),
                  c (Sum.inl i) * B (v_fam (Sum.inl i)) (v_fam (Sum.inr r)) =
                    if i = r then c (Sum.inl r) else 0 := by
                intro i
                rw [(hv_pair i r).2.2.1]
                split_ifs with hir
                · rw [hir, mul_one]
                · rw [mul_zero]
              simp [hcongr]
            have hsum_R : (∑ i : Fin (g' + 1),
                c (Sum.inr i) * B (v_fam (Sum.inr i)) (v_fam (Sum.inr r))) = 0 :=
              Finset.sum_eq_zero (fun i _ => by rw [(hv_pair i r).2.1, mul_zero])
            rw [hsum_L, hsum_R, add_zero] at hpair
            exact hpair
          · have hpair := congrArg (fun z => B (v_fam (Sum.inl r)) z) hc
            rw [Fintype.sum_sum_type] at hpair
            simp only [map_zero, map_add, map_sum, map_smul, smul_eq_mul] at hpair
            have hsum_L : (∑ i : Fin (g' + 1),
                c (Sum.inl i) * B (v_fam (Sum.inl r)) (v_fam (Sum.inl i))) = 0 :=
              Finset.sum_eq_zero (fun i _ => by rw [(hv_pair r i).1, mul_zero])
            have hsum_R : (∑ i : Fin (g' + 1),
                c (Sum.inr i) * B (v_fam (Sum.inl r)) (v_fam (Sum.inr i))) = c (Sum.inr r) := by
              have hcongr : ∀ i : Fin (g' + 1),
                  c (Sum.inr i) * B (v_fam (Sum.inl r)) (v_fam (Sum.inr i)) =
                    if r = i then c (Sum.inr r) else 0 := by
                intro i
                rw [(hv_pair r i).2.2.1]
                split_ifs with hri
                · rw [hri, mul_one]
                · rw [mul_zero]
              simp [hcongr]
            rw [hsum_L, hsum_R, zero_add] at hpair
            exact hpair
        have hv_span : ⊤ ≤ Submodule.span K (Set.range v_fam) := by
          intro x _
          have he_mem : e ∈ Submodule.span K (Set.range v_fam) :=
            Submodule.subset_span ⟨Sum.inl 0, rfl⟩
          have hf_mem : f ∈ Submodule.span K (Set.range v_fam) :=
            Submodule.subset_span ⟨Sum.inr 0, rfl⟩
          let w_x : ↥W := ⟨π_W x, hπ_mem x⟩
          have hw_eq : π_W x = ∑ idx : Fin g' ⊕ Fin g', (b_W.repr w_x idx) • (b_W idx).1 := by
            have hrepr := congrArg Subtype.val (b_W.sum_repr w_x).symm
            simpa only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul] using hrepr
          have hw_mem : π_W x ∈ Submodule.span K (Set.range v_fam) := by
            rw [hw_eq]
            refine Submodule.sum_mem _ fun idx _ => Submodule.smul_mem _ _ ?_
            rcases idx with r | r
            · exact Submodule.subset_span ⟨Sum.inl r.succ, rfl⟩
            · exact Submodule.subset_span ⟨Sum.inr r.succ, rfl⟩
          have hx_decomp : x = B x f • e - B x e • f + π_W x := by simp only [π_W]; abel
          rw [hx_decomp]
          exact Submodule.add_mem _
            (Submodule.sub_mem _ (Submodule.smul_mem _ _ he_mem) (Submodule.smul_mem _ _ hf_mem))
            hw_mem
        let b_full : Module.Basis (Fin (g' + 1) ⊕ Fin (g' + 1)) K V₀ :=
          Module.Basis.mk hv_indep hv_span
        refine ⟨g' + 1, b_full, fun r s => ?_⟩
        simpa only [b_full, Module.Basis.coe_mk] using hv_pair r s
  
  have hArtin : ∀ (d : ℕ) (V₀ : Type) [AddCommGroup V₀] [Module K V₀] [FiniteDimensional K V₀],
      Module.finrank K V₀ = d →
      ∀ (B : LinearMap.BilinForm K V₀),
        (∀ x : V₀, B x x = 0) →
        (∀ x : V₀, (∀ y : V₀, B x y = 0) → x = 0) →
        ∀ (S : Module.End K V₀),
          (∀ x y : V₀, B (S x) (S y) = B x y) →
          S ∈ Submonoid.closure { f : Module.End K V₀ |
            ∃ (v : V₀) (t : K), ∀ x : V₀, f x = x + (t * B x v) • v } := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro V₀ _ _ _ hdim B hAlt hNondeg S hS
      have hSkew : ∀ x y : V₀, B y x = - B x y := by
        intro x y
        have hsum : B (x + y) (x + y) = 0 := hAlt (x + y)
        simp only [map_add, LinearMap.add_apply, hAlt, zero_add, add_zero] at hsum
        exact eq_neg_of_add_eq_zero_left hsum
      let τ : V₀ → K → Module.End K V₀ :=
        fun v t => LinearMap.id + (t • (B.flip v)).smulRight v
      have hτ_apply : ∀ (v : V₀) (t : K) (x : V₀), τ v t x = x + (t * B x v) • v :=
        fun _ _ _ => rfl
      let Gen : Set (Module.End K V₀) :=
        { f : Module.End K V₀ | ∃ (v : V₀) (t : K), ∀ x : V₀, f x = x + (t * B x v) • v }
      let T_grp : Submonoid (Module.End K V₀) := Submonoid.closure Gen
      have hτ_mem : ∀ (v : V₀) (t : K), τ v t ∈ T_grp :=
        fun v t => Submonoid.subset_closure ⟨v, t, fun x => hτ_apply v t x⟩
      have hτ_pres : ∀ (v : V₀) (t : K) (x y : V₀), B (τ v t x) (τ v t y) = B x y := by
        intro v t x y
        rw [hτ_apply, hτ_apply]
        simp only [map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply, smul_eq_mul,
          hAlt v, mul_zero, add_zero, hSkew y v]
        ring
      have hT_pres : ∀ g ∈ T_grp, ∀ x y : V₀, B (g x) (g y) = B x y := by
        intro g hg
        induction hg using Submonoid.closure_induction with
        | mem f hf =>
          obtain ⟨v, t, hft⟩ := hf
          have hfeq : f = τ v t := LinearMap.ext hft
          rw [hfeq]
          exact hτ_pres v t
        | one => intro x y; rfl
        | mul g₁ g₂ _ _ ih₁ ih₂ =>
          intro x y
          exact (ih₁ (g₂ x) (g₂ y)).trans (ih₂ x y)
      have hT_inv : ∀ g ∈ T_grp, ∃ g_inv ∈ T_grp, g_inv * g = 1 ∧ g * g_inv = 1 := by
        have hτ_comp : ∀ (v : V₀) (a b : K), a + b = 0 → τ v a * τ v b = 1 := by
          intro v a b hab
          apply LinearMap.ext; intro x
          change τ v a (τ v b x) = x
          simp only [hτ_apply, map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply,
            smul_eq_mul, hAlt v, mul_zero, add_zero]
          rw [add_assoc, ← add_smul]
          have h0 : b * B x v + a * B x v = 0 := by linear_combination B x v * hab
          rw [h0, zero_smul, add_zero]
        intro g hg
        induction hg using Submonoid.closure_induction with
        | mem f hf =>
          obtain ⟨v, t, hft⟩ := hf
          have hfeq : f = τ v t := LinearMap.ext hft
          rw [hfeq]
          exact ⟨τ v (-t), hτ_mem v (-t),
            hτ_comp v (-t) t (neg_add_cancel t), hτ_comp v t (-t) (add_neg_cancel t)⟩
        | one => exact ⟨1, T_grp.one_mem, one_mul 1, mul_one 1⟩
        | mul g₁ g₂ _ _ ih₁ ih₂ =>
          obtain ⟨i₁, hi₁_mem, hi₁_l, hi₁_r⟩ := ih₁
          obtain ⟨i₂, hi₂_mem, hi₂_l, hi₂_r⟩ := ih₂
          refine ⟨i₂ * i₁, T_grp.mul_mem hi₂_mem hi₁_mem, ?_, ?_⟩
          · calc (i₂ * i₁) * (g₁ * g₂) = i₂ * (i₁ * g₁) * g₂ := by simp [mul_assoc]
              _ = i₂ * g₂ := by rw [hi₁_l, mul_one]
              _ = 1 := hi₂_l
          · calc (g₁ * g₂) * (i₂ * i₁) = g₁ * (g₂ * i₂) * i₁ := by simp [mul_assoc]
              _ = g₁ * i₁ := by rw [hi₂_r, mul_one]
              _ = 1 := hi₁_r
      have hMoveNonOrth : ∀ x y : V₀, B x y ≠ 0 → ∃ g ∈ T_grp, g x = y := by
        intro x y hxy
        refine ⟨τ (y - x) (B x y)⁻¹, hτ_mem (y - x) (B x y)⁻¹, ?_⟩
        rw [hτ_apply, map_sub, hAlt x, sub_zero, inv_mul_cancel₀ hxy, one_smul, add_sub_cancel]
      have hTransVec : ∀ x y : V₀, x ≠ 0 → y ≠ 0 → ∃ g ∈ T_grp, g x = y := by
        intro x y hx hy
        by_cases hxy : B x y = 0
        · have hnot_x : ¬ ∀ z : V₀, B x z = 0 := fun hall => hx (hNondeg x hall)
          have hnot_y : ¬ ∀ z : V₀, B y z = 0 := fun hall => hy (hNondeg y hall)
          obtain ⟨z₁, hz₁⟩ := Classical.not_forall.mp hnot_x
          obtain ⟨z₂, hz₂_y⟩ := Classical.not_forall.mp hnot_y
          have hz₂ : B z₂ y ≠ 0 := by rw [hSkew y z₂]; exact neg_ne_zero.mpr hz₂_y
          have hex_z : ∃ z : V₀, B x z ≠ 0 ∧ B z y ≠ 0 := by
            by_cases hz₁y : B z₁ y = 0
            · by_cases hxz₂ : B x z₂ = 0
              · refine ⟨z₁ + z₂, ?_, ?_⟩
                · rw [map_add, hxz₂, add_zero]; exact hz₁
                · rw [map_add, LinearMap.add_apply, hz₁y, zero_add]; exact hz₂
              · exact ⟨z₂, hxz₂, hz₂⟩
            · exact ⟨z₁, hz₁, hz₁y⟩
          obtain ⟨z, hxz, hzy⟩ := hex_z
          obtain ⟨g₁, hg₁_mem, hg₁⟩ := hMoveNonOrth x z hxz
          obtain ⟨g₂, hg₂_mem, hg₂⟩ := hMoveNonOrth z y hzy
          refine ⟨g₂ * g₁, T_grp.mul_mem hg₂_mem hg₁_mem, ?_⟩
          change g₂ (g₁ x) = y
          rw [hg₁, hg₂]
        · exact hMoveNonOrth x y hxy
      have hTransHyp : ∀ e₁ f₁ e₂ f₂ : V₀,
          B e₁ f₁ = 1 → B e₂ f₂ = 1 → ∃ g ∈ T_grp, g e₁ = e₂ ∧ g f₁ = f₂ := by
        intro e₁ f₁ e₂ f₂ h1 h2
        have he₁ : e₁ ≠ 0 := by
          intro h0; rw [h0, map_zero, LinearMap.zero_apply] at h1; exact zero_ne_one h1
        have he₂ : e₂ ≠ 0 := by
          intro h0; rw [h0, map_zero, LinearMap.zero_apply] at h2; exact zero_ne_one h2
        obtain ⟨g₁, hg₁_mem, hg₁_e⟩ := hTransVec e₁ e₂ he₁ he₂
        let f' : V₀ := g₁ f₁
        have hf'_pair : B e₂ f' = 1 := by
          dsimp [f']
          rw [← hg₁_e, hT_pres g₁ hg₁_mem e₁ f₁, h1]
        by_cases hff : B f' f₂ = 0
        · let h_pert : Module.End K V₀ := τ e₂ (-1)
          have hpert_mem : h_pert ∈ T_grp := hτ_mem e₂ (-1)
