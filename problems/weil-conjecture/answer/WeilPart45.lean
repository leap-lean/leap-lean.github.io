  have hTor_sh : ∀ m : ℕ, (ℓ ^ (m + 1) : ℕ) • CategoryTheory.CategoryStruct.id (𝒦_s m) = 0 := by
    intro m
    apply sheaf_hom_ext_triv
    intro W sec y
    rw [hnsmul_id_app]
    have h0_app : (((0 : 𝒦_s m ⟶ 𝒦_s m).hom.app (Opposite.op W)) sec) = 0 := by simp
    rw [h0_app, map_nsmul, map_zero]
