    have hcA : 0 < Multiset.count α A' := Multiset.count_pos.mpr hα
    have hcB : 0 < Multiset.count α B' := Multiset.count_pos.mpr hβ
    dsimp [A', B', I_mset] at hcA hcB
    rw [Multiset.count_sub, Multiset.count_inter] at hcA hcB
    omega
