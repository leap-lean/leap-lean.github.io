        rw [hRecProd_map, hMap_pow_comm]
        change recProd (((M_E.map ⇑σ.symm).map ⇑σ).map (· ^ d_star)) = _
        rw [hsymm_cancel]
      have h2_map : (recProd (M_E.map (· ^ d_star))).map σ.toRingHom =
