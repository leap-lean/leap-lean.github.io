                  (Nat.zero_add i))
            (∀ (z : ↥(AddMonoidHom.ker (d₀.app ℱ).hom))
              (hz' : (Φ₀ β).hom z.1 ∈ AddMonoidHom.ker (d₀.app ℱ).hom),
              eH₀ ⟨(Φ₀ β).hom z.1, hz'⟩ = act 0 (eH₀ z)) ∧
            (∀ (z : ↥(AddMonoidHom.ker (d₁.app ℱ).hom))
              (hz' : (Φ₁ β).hom z.1 ∈ AddMonoidHom.ker (d₁.app ℱ).hom),
              eH₁ (QuotientAddGroup.mk' _ ⟨(Φ₁ β).hom z.1, hz'⟩) =
                act 1 (eH₁ (QuotientAddGroup.mk' _ z))) ∧
            (∀ (z : ↑(C₂.obj ℱ)),
              eH₂ (QuotientAddGroup.mk' _ ((Φ₂ β).hom z)) =
                act 2 (eH₂ (QuotientAddGroup.mk' _ z)))) :=
by
