      intro σ k
      have hpoly_σ : P_Ed.map σ.toRingHom = P_Ed := by
        dsimp [P_Ed]
        rw [hRecProd_map, hMap_pow_comm]
        change recProd ((M_E.map ⇑σ).map (· ^ e)) = _
