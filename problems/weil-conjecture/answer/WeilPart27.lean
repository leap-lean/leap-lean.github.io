      let _ : Algebra (Localization.Away q₁) B₁_s := algQ
      have hInt_φ : φ₁_s.IsIntegral := hφ₁_fin.to_isIntegral
      have : Algebra.IsIntegral (Localization.Away q₁) B₁_s := ⟨hInt_φ⟩
      refine le_trans (Order.krullDim_le_of_strictMono (PrimeSpectrum.comap φ₁_s) ?_) hDim_Qq₁
      intro P₁ P₂ hlt
      have hlt_id : P₁.asIdeal < P₂.asIdeal := hlt
      obtain ⟨x, hx₂, hx₁⟩ := SetLike.exists_of_lt hlt_id
      exact Ideal.under_lt_under_of_integral_mem_sdiff (R := Localization.Away q₁)
        (le_of_lt hlt_id) ⟨hx₂, hx₁⟩ (hInt_φ x)
    have hVs_sub_j1 : (V_s : Set ↥C_s) ⊆ (j₁_s.opensRange : Set ↥C_s) := by
