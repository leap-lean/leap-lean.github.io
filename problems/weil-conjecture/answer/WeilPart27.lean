                ((adj₂'.homEquiv (pf_φ.obj FM_src) FM_tilde) u₂) :=
            hLeftUniq_symm adj₁ adj₂' _
          _ = e_L.hom.app (pf_φ.obj FM_src) ≫ u₂ := by rw [Equiv.symm_apply_apply]
      rw [hu_hom, ← CategoryTheory.Category.assoc, e_L.inv_hom_id_app,
