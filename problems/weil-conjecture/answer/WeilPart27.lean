      · exact congrArg (fun ψ : G_P ⟶ G_P => (ψ.hom.app (Opposite.op U)).hom b) h_inv_hom
    · intro F₁ F₂ F₃ f g h0 hInj hMid hSurj
      have hLift_ex :
          ∀ {W : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (k_h : W ⟶ F₂),
            CategoryTheory.CategoryStruct.comp k_h g = 0 →
            ∀ (U : 𝒞) (w : ↥(W.obj.obj (Opposite.op U))),
