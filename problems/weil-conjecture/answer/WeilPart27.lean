      have hΦ_inj : Function.Injective Φ := by
        rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
        intro f hf
        rw [LinearMap.mem_ker] at hf
        let I_f : Ideal B₂ :=
          { carrier := { b : B₂ | ∀ j : Fin δ, b * f j = 0 }
            zero_mem' := fun j => zero_mul (f j)
            add_mem' := fun {b₁ b₂} hb₁ hb₂ j => by rw [add_mul, hb₁ j, hb₂ j, add_zero]
            smul_mem' := fun c {b} hb j => by rw [smul_eq_mul, mul_assoc, hb j, mul_zero] }
        have hIf_top : I_f = ⊤ := by
          by_contra hIf_ne
          obtain ⟨𝔐, h𝔐_max, hIf_le⟩ := Ideal.exists_le_maximal I_f hIf_ne
          letI : 𝔐.IsPrime := h𝔐_max.isPrime
          let 𝔮 : Ideal R₂ := Ideal.comap (algebraMap R₂ B₂) 𝔐
          have h𝔮 : 𝔮.IsPrime := Ideal.IsPrime.comap (algebraMap R₂ B₂)
          obtain ⟨s, hs_not_𝔮, M_s, _, _, b_s, e_s, he_s⟩ := hLoc 𝔮 h𝔮
          let s_B : B₂ := algebraMap R₂ B₂ s
          have hs_not_𝔐 : s_B ∉ 𝔐 := hs_not_𝔮
          let C₂ := Localization.Away (r * s)
          let C₁ := Localization.Away (φ₂₁ (r * s))
          let ψ_rs : C₂ →+* C₁ := Localization.awayMap φ₂₁ (r * s)
          letI : Algebra C₂ C₁ := ψ_rs.toAlgebra
          let rs_inv : C₂ := IsLocalization.Away.invSelf (S := C₂) (r * s)
          have hrs_inv : algebraMap R₂ C₂ (r * s) * rs_inv = 1 :=
            IsLocalization.Away.mul_invSelf (r * s)
          have hψrs_inv : algebraMap R₁ C₁ (φ₂₁ (r * s)) * ψ_rs rs_inv = 1 := by
            have h1 : ψ_rs (algebraMap R₂ C₂ (r * s)) = algebraMap R₁ C₁ (φ₂₁ (r * s)) :=
              h_away_eq φ₂₁ (r * s) (r * s)
            rw [← h1, ← ψ_rs.map_mul, hrs_inv, map_one]
          have hr_unit_C₂ : IsUnit (algebraMap R₂ C₂ r) :=
            isUnit_iff_exists_inv.mpr ⟨algebraMap R₂ C₂ s * rs_inv, by
              rw [← mul_assoc, ← (algebraMap R₂ C₂).map_mul, hrs_inv]⟩
          have hs_unit_C₂ : IsUnit (algebraMap R₂ C₂ s) :=
            isUnit_iff_exists_inv.mpr ⟨algebraMap R₂ C₂ r * rs_inv, by
              rw [← mul_assoc, mul_comm (algebraMap R₂ C₂ s),
                ← (algebraMap R₂ C₂).map_mul, hrs_inv]⟩
          have hφr_unit_C₁ : IsUnit (algebraMap R₁ C₁ (φ₂₁ r)) :=
            isUnit_iff_exists_inv.mpr ⟨algebraMap R₁ C₁ (φ₂₁ s) * ψ_rs rs_inv, by
              rw [← mul_assoc, ← (algebraMap R₁ C₁).map_mul, ← φ₂₁.map_mul, hψrs_inv]⟩
          have hφs_unit_C₁ : IsUnit (algebraMap R₁ C₁ (φ₂₁ s)) :=
            isUnit_iff_exists_inv.mpr ⟨algebraMap R₁ C₁ (φ₂₁ r) * ψ_rs rs_inv, by
              rw [← mul_assoc, mul_comm (algebraMap R₁ C₁ (φ₂₁ s)),
                ← (algebraMap R₁ C₁).map_mul, ← φ₂₁.map_mul, hψrs_inv]⟩
          let α_r : B₂ →+* C₂ := Localization.awayLift (algebraMap R₂ C₂) r hr_unit_C₂
          let β_r : B₁ →+* C₁ := Localization.awayLift (algebraMap R₁ C₁) (φ₂₁ r) hφr_unit_C₁
          let α_s : Localization.Away s →+* C₂ :=
            Localization.awayLift (algebraMap R₂ C₂) s hs_unit_C₂
          let β_s : Localization.Away (φ₂₁ s) →+* C₁ :=
            Localization.awayLift (algebraMap R₁ C₁) (φ₂₁ s) hφs_unit_C₁
          have hcomm_r : β_r.comp ψ_r = ψ_rs.comp α_r := by
            apply IsLocalization.ringHom_ext (Submonoid.powers r)
            ext a₂
            simp only [RingHom.comp_apply]
            have h1 : ψ_r (algebraMap R₂ B₂ a₂) = algebraMap R₁ B₁ (φ₂₁ a₂) :=
