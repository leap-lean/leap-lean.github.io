      (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := d)).2
        (P.hom.appLE ⊤ V₀ le_top).hom
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv
        hStd₀
    obtain ⟨g, _, hg_et⟩ := hStd_k.exists_etale_mvPolynomial
    let ι_V : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ P.left := hAff_V₀.fromSpec
    have hOpen : Topology.IsOpenEmbedding ι_V.base := ι_V.isOpenEmbedding
    have hRange : Set.range ι_V.base = (V₀ : Set ↥P.left) :=
      AlgebraicGeometry.IsAffineOpen.range_fromSpec hAff_V₀
    obtain ⟨z₀, hz₀⟩ : ∃ z₀ : PrimeSpectrum A, ι_V.base z₀ = y₀ := by
      have hy_mem : y₀ ∈ Set.range ι_V.base := by rw [hRange]; exact hy₀_V₀
      exact hy_mem
    let toSpecIC : ∀ i : Fin (p.length + 1),
        TopologicalSpace.IrreducibleCloseds ↥(AlgebraicGeometry.Spec (CommRingCat.of A)) := fun i =>
      { carrier := ι_V.base ⁻¹' (p i).1
        isIrreducible' := by
          refine ⟨⟨z₀, ?_⟩, ?_⟩
          · show ι_V.base z₀ ∈ (p i).1
            rw [hz₀]
            exact (p.monotone (Fin.zero_le i)) hy₀_C0
          · intro O₁ O₂ hO₁ hO₂ ⟨w₁, hw₁_C, hw₁_O₁⟩ ⟨w₂, hw₂_C, hw₂_O₂⟩
            have hIm₁ : IsOpen (ι_V.base '' O₁) := hOpen.isOpenMap O₁ hO₁
            have hIm₂ : IsOpen (ι_V.base '' O₂) := hOpen.isOpenMap O₂ hO₂
            obtain ⟨y, hy_C, ⟨u₁, hu₁, hy₁⟩, ⟨u₂, hu₂, hy₂⟩⟩ :=
              (p i).2.2 (ι_V.base '' O₁) (ι_V.base '' O₂) hIm₁ hIm₂
                ⟨ι_V.base w₁, hw₁_C, ⟨w₁, hw₁_O₁, rfl⟩⟩
                ⟨ι_V.base w₂, hw₂_C, ⟨w₂, hw₂_O₂, rfl⟩⟩
            have hu_eq : u₁ = u₂ := hOpen.injective (hy₁.trans hy₂.symm)
            subst hu_eq
            exact ⟨u₁, by simpa [hy₁] using hy_C, hu₁, hu₂⟩
        isClosed' := (p i).3.preimage ι_V.continuous }
    let p_A : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(AlgebraicGeometry.Spec (CommRingCat.of A))) :=
      { length := p.length
        toFun := toSpecIC
        step := fun i => by
          have hstep : p (Fin.castSucc i) < p i.succ := p.step i
          have hsub : toSpecIC (Fin.castSucc i) ≤ toSpecIC i.succ :=
            fun w hw => hstep.le hw
          refine lt_of_le_of_ne hsub ?_
          intro heq
          have heq_set : (toSpecIC (Fin.castSucc i)).1 = (toSpecIC i.succ).1 :=
            congrArg TopologicalSpace.IrreducibleCloseds.carrier heq
          have hnot_sub : ¬ ((p i.succ).1 ⊆ (p (Fin.castSucc i)).1) :=
            fun hle => hstep.not_ge hle
          obtain ⟨y₁, hy₁_succ, hy₁_not⟩ := Set.not_subset.mp hnot_sub
          have hy₀_succ : y₀ ∈ (p i.succ).1 :=
            (p.monotone (Fin.zero_le i.succ)) hy₀_C0
          obtain ⟨y₂, hy₂_succ, hy₂_V₀, hy₂_compl⟩ :=
            (p i.succ).2.2 (V₀ : Set ↥P.left) ((p (Fin.castSucc i)).1)ᶜ
              V₀.isOpen (p (Fin.castSucc i)).3.isOpen_compl
              ⟨y₀, hy₀_succ, hy₀_V₀⟩ ⟨y₁, hy₁_succ, hy₁_not⟩
          have hy₂_range : y₂ ∈ Set.range ι_V.base := by rw [hRange]; exact hy₂_V₀
          obtain ⟨w₂, rfl⟩ := hy₂_range
          have hw₂_in : w₂ ∈ (toSpecIC i.succ).1 := hy₂_succ
          rw [← heq_set] at hw₂_in
          exact hy₂_compl hw₂_in }
    calc ((p.length : ℕ∞) : WithBot ℕ∞)
      _ = ((p_A.length : ℕ∞) : WithBot ℕ∞) := rfl
      _ ≤ topologicalKrullDim ↥(AlgebraicGeometry.Spec (CommRingCat.of A)) :=
          Order.LTSeries.length_le_krullDim p_A
      _ = topologicalKrullDim (PrimeSpectrum A) := rfl
      _ = ringKrullDim A := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A
      _ ≤ ringKrullDim (MvPolynomial (Fin d) k) := h_etale_dim _ _ g hg_et
      _ = (d : WithBot ℕ∞) := by
          rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
            zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
          rfl

  
  
  
  have hPart2_compl : ∀ (k : Type u) [Field k] (m d : ℕ) (_ : m + 1 = d)
      (P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper P.hom],
      AlgebraicGeometry.IsIntegral P.left →
      topologicalKrullDim P.left ≤ (d : WithBot ℕ∞) →
      ∀ (W₀ : P.left.Opens), Nonempty ↥W₀ →
      let Z_sch : AlgebraicGeometry.Scheme.{u} := (weilAltClosedComplIdeal P.left W₀).subscheme
      let i_Z : Quiver.Hom Z_sch P.left := (weilAltClosedComplIdeal P.left W₀).subschemeι
      AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp i_Z P.hom) ∧
      topologicalKrullDim Z_sch ≤ (m : WithBot ℕ∞) := by
    clear * -
    intro k hFk m d hmd P hPropP hInt hDimLe W₀ hNe Z_sch i_Z
    let _ : Field k := hFk
    have : AlgebraicGeometry.IsProper P.hom := hPropP
    refine ⟨inferInstance, ?_⟩
    have hEmb : Topology.IsClosedEmbedding i_Z.base := i_Z.isClosedEmbedding
    have hRange : Set.range i_Z.base = (W₀ : Set ↥P.left)ᶜ := by
      have h1 := AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι (weilAltClosedComplIdeal P.left W₀)
      have h2 : ((weilAltClosedComplIdeal P.left W₀).support : Set ↥P.left) = (W₀ : Set ↥P.left)ᶜ :=
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal _
      exact h1.trans h2
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z_sch) ≤ (m : WithBot ℕ∞)
    refine iSup_le fun p => ?_
    let f_ic : TopologicalSpace.IrreducibleCloseds ↥Z_sch →
        TopologicalSpace.IrreducibleCloseds ↥P.left := fun C =>
      { carrier := i_Z.base '' C.1
        isIrreducible' := C.2.image i_Z.base i_Z.continuous.continuousOn
        isClosed' := hEmb.isClosedMap C.1 C.3 }
    have hf_strict : StrictMono f_ic := by
      intro C₁ C₂ hlt
      have hsub : f_ic C₁ ≤ f_ic C₂ := Set.image_mono hlt.le
      refine lt_of_le_of_ne hsub ?_
      intro heq
      apply hlt.ne
      ext z
      constructor
      · intro hz
        exact hlt.le hz
      · intro hz₂
        have hz_im : i_Z.base z ∈ (f_ic C₂).1 := ⟨z, hz₂, rfl⟩
        rw [← congrArg TopologicalSpace.IrreducibleCloseds.carrier heq] at hz_im
        obtain ⟨z₁, hz₁, heq_z⟩ := hz_im
        rwa [← hEmb.injective heq_z]
    let p' : LTSeries (TopologicalSpace.IrreducibleCloseds ↥P.left) := p.map f_ic hf_strict
    have : IrreducibleSpace ↥P.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral P.left
    let T_top : TopologicalSpace.IrreducibleCloseds ↥P.left :=
      { carrier := Set.univ
        isIrreducible' := IrreducibleSpace.isIrreducible_univ ↥P.left
        isClosed' := isClosed_univ }
    have h_lt_top : p'.last < T_top := by
      have hle_top : p'.last ≤ T_top := Set.subset_univ _
      refine lt_of_le_of_ne hle_top ?_
      intro heq
      obtain ⟨x₀, hx₀⟩ := hNe
      have hx_univ : x₀ ∈ T_top.1 := trivial
      rw [← congrArg TopologicalSpace.IrreducibleCloseds.carrier heq] at hx_univ
      have hlast_eq : p'.last = f_ic p.last := rfl
      rw [hlast_eq] at hx_univ
      obtain ⟨z, _, rfl⟩ := hx_univ
      have hmem_range : i_Z.base z ∈ Set.range i_Z.base := ⟨z, rfl⟩
      rw [hRange] at hmem_range
      exact hmem_range hx₀
    let p'' : LTSeries (TopologicalSpace.IrreducibleCloseds ↥P.left) := p'.snoc T_top h_lt_top
    have hlen_snoc : p''.length = p.length + 1 := rfl
    have hbound : (((p.length + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ (d : WithBot ℕ∞) := by
      calc (((p.length + 1 : ℕ) : ℕ∞) : WithBot ℕ∞)
        _ = ((p''.length : ℕ∞) : WithBot ℕ∞) := by simp [hlen_snoc]
        _ ≤ topologicalKrullDim P.left := Order.LTSeries.length_le_krullDim p''
        _ ≤ (d : WithBot ℕ∞) := hDimLe
    have hbound_enat : ((p.length + 1 : ℕ) : ℕ∞) ≤ (d : ℕ∞) := WithBot.coe_le_coe.mp hbound
    have hbound_nat : p.length + 1 ≤ d := ENat.natCast_le_natCast.mp hbound_enat
    have hm_le : p.length ≤ m := by omega
    exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr hm_le)

  
  
  
  have hMemEtale : ∀ {X : AlgebraicGeometry.Scheme.{u}}
      (U : X.Etale) (R : CategoryTheory.Sieve U),
      R ∈ X.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (Y : X.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    clear * -
    intro X U R
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩
    have : P_et.IsStableUnderComposition := this
    have hJ :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) X (le_refl P_et)
    change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et X U ↔ _
    rw [hJ]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R

  have hEtLeft : ∀ {X : AlgebraicGeometry.Scheme.{u}} {Y U : X.Etale} (f : Y ⟶ U),
      AlgebraicGeometry.Etale f.left := by
    clear * -
    intro X Y U f
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩
    have : P_et.IsStableUnderComposition := this
    have hcomp : P_et (f.left ≫ U.hom) := by
      rw [CategoryTheory.MorphismProperty.Over.w f]
      exact Y.prop
    exact @CategoryTheory.MorphismProperty.of_postcomp _ _ P_et P_et _ Y.left U.left X
      f.left U.hom U.prop hcomp

  
  
  
  have hPart3_site : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
      ∃ (hCont : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology),
        let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          S₂.smallEtaleTopology S₁.smallEtaleTopology hCont
        (∀ (I : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (P_push.obj I)) ∧
        (∀ (T₂ : S₂.Etale), CategoryTheory.Limits.IsTerminal T₂ →
          Nonempty (CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback h).obj T₂))) := by
    clear * - hMemEtale
    intro S₁ S₂ h
    classical
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩
    have : P_et.IsStableUnderComposition := this
    let B : S₂.Etale ⥤ S₁.Etale := weilEtaleSitePullback h
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget S₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget S₂

    have hLimOverPb : CategoryTheory.Limits.PreservesFiniteLimits (CategoryTheory.Over.pullback h) :=
      ((CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits.{0, 0}).preservesFiniteLimits
    have hLimComp : CategoryTheory.Limits.PreservesFiniteLimits
        (Fgt₂.comp (CategoryTheory.Over.pullback h)) :=
      @CategoryTheory.Limits.comp_preservesFiniteLimits _ _ _ _ _ _ Fgt₂
        (CategoryTheory.Over.pullback h) inferInstance hLimOverPb
    have hEqComp : B.comp Fgt₁ = Fgt₂.comp (CategoryTheory.Over.pullback h) := rfl
    have hLimComp' : CategoryTheory.Limits.PreservesFiniteLimits (B.comp Fgt₁) := by
      rw [hEqComp]
      exact hLimComp
    have hLimB : CategoryTheory.Limits.PreservesFiniteLimits B :=
      @CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
        B Fgt₁ hLimComp' inferInstance

    let T₂ : S₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S₂)
      (inferInstance : AlgebraicGeometry.Etale (𝟙 S₂))
    have hT₂ : CategoryTheory.Limits.IsTerminal T₂ :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id _))
        (fun U m => CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m)))
    have : CategoryTheory.Limits.HasTerminal S₂.Etale := hT₂.hasTerminal
    have : CategoryTheory.Limits.HasFiniteLimits S₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.RepresentablyFlat B := CategoryTheory.flat_of_preservesFiniteLimits B

    have hCovB : CategoryTheory.CoverPreserving J₂ J₁ B := by
      refine ⟨fun {V R} hR => ?_⟩
      rw [hMemEtale] at hR ⊢
      intro x
      let v_hom : (Fgt₂.obj V).left ⟶ S₂ := (Fgt₂.obj V).hom
      let fst_V : CategoryTheory.Limits.pullback v_hom h ⟶ (Fgt₂.obj V).left :=
        CategoryTheory.Limits.pullback.fst v_hom h
      let snd_V : CategoryTheory.Limits.pullback v_hom h ⟶ S₁ :=
        CategoryTheory.Limits.pullback.snd v_hom h
      obtain ⟨Y, f, w, hRf, hf_et, hw⟩ := hR (fst_V x)
      let y_hom : (Fgt₂.obj Y).left ⟶ S₂ := (Fgt₂.obj Y).hom
      let f_sch : (Fgt₂.obj Y).left ⟶ (Fgt₂.obj V).left := (Fgt₂.map f).left
      let fst_Y : CategoryTheory.Limits.pullback y_hom h ⟶ (Fgt₂.obj Y).left :=
        CategoryTheory.Limits.pullback.fst y_hom h
      let snd_Y : CategoryTheory.Limits.pullback y_hom h ⟶ S₁ :=
        CategoryTheory.Limits.pullback.snd y_hom h
      let bf_sch : CategoryTheory.Limits.pullback y_hom h ⟶ CategoryTheory.Limits.pullback v_hom h :=
        ((CategoryTheory.Over.pullback h).map (Fgt₂.map f)).left
      have hbf_fst : bf_sch ≫ fst_V = fst_Y ≫ f_sch := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hbf_snd : bf_sch ≫ snd_V = snd_Y := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hfy : f_sch ≫ v_hom = y_hom := CategoryTheory.Over.w (Fgt₂.map f)
      have h_outer : CategoryTheory.IsPullback (bf_sch ≫ snd_V) fst_Y h (f_sch ≫ v_hom) := by
        rw [hbf_snd, hfy]
        exact (CategoryTheory.IsPullback.of_hasPullback y_hom h).flip
      have hpb : CategoryTheory.IsPullback bf_sch fst_Y fst_V f_sch :=
        CategoryTheory.IsPullback.of_right h_outer hbf_fst (CategoryTheory.IsPullback.of_hasPullback v_hom h).flip
      obtain ⟨z, hz_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x w (hw.symm : fst_V x = f_sch w)
      have hbf_et : P_et bf_sch :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hf_et
      have hpush_arrow : (R.functorPushforward B).arrows (B.map f) :=
        ⟨Y, f, 𝟙 (B.obj Y), hRf, (CategoryTheory.Category.id_comp _).symm⟩
      refine ⟨B.obj Y, B.map f, hpb.isoPullback.inv z, hpush_arrow, hbf_et, ?_⟩
      have hinv_fst : hpb.isoPullback.inv ≫ bf_sch = CategoryTheory.Limits.pullback.fst fst_V f_sch :=
        hpb.isoPullback_inv_fst
      change (hpb.isoPullback.inv ≫ bf_sch) z = x
      rw [hinv_fst]
      exact hz_fst

    have hContB : B.IsContinuous J₂ J₁ :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving
        (CategoryTheory.compatiblePreservingOfFlat J₁ B) hCovB

    let e_small := CategoryTheory.equivSmallModel.{u} S₂.AffineEtale
    let g₀ : CategoryTheory.SmallModel.{u} S₂.AffineEtale → S₂.Etale := fun i =>
      let W := e_small.inverse.obj i
      CategoryTheory.MorphismProperty.Over.mk ⊤ W.hom W.prop
    let Stage₂ : ℕ → Σ (X : Type u), (X → S₂.Etale) :=
      Nat.rec
        ⟨PUnit.{u + 1} ⊕ CategoryTheory.SmallModel.{u} S₂.AffineEtale, Sum.elim (fun _ => ⊤_ S₂.Etale) g₀⟩
        (fun _ prev =>
          ⟨prev.1 ⊕ Σ (a b c : prev.1) (_ : prev.2 a ⟶ prev.2 c) (_ : prev.2 b ⟶ prev.2 c),
            PUnit.{1},
           Sum.elim prev.2 (fun p => CategoryTheory.Limits.pullback p.2.2.2.1 p.2.2.2.2.1)⟩)
    let Idx₂ : Type u := Σ m : ℕ, (Stage₂ m).1
    let eval₂ : Idx₂ → S₂.Etale := fun p => (Stage₂ p.1).2 p.2
    let D₂ : Type u := CategoryTheory.InducedCategory S₂.Etale eval₂
    let G₂ : D₂ ⥤ S₂.Etale := CategoryTheory.inducedFunctor eval₂
    have lift_add : ∀ (m d : ℕ) (x : (Stage₂ m).1),
        ∃ y : (Stage₂ (m + d)).1, (Stage₂ (m + d)).2 y = (Stage₂ m).2 x := by
      intro m d x
      induction d with
      | zero => exact ⟨x, rfl⟩
      | succ d ih =>
        obtain ⟨y, hy⟩ := ih
        exact ⟨Sum.inl y, hy⟩
    have lift_le : ∀ {m N : ℕ} (hle : m ≤ N) (x : (Stage₂ m).1),
        ∃ y : (Stage₂ N).1, (Stage₂ N).2 y = eval₂ ⟨m, x⟩ := by
      intro m N hle x
      obtain ⟨y, hy⟩ := lift_add m (N - m) x
      have hN : m + (N - m) = N := Nat.add_sub_of_le hle
      revert y
      rw [hN]
      exact fun y hy => ⟨y, hy⟩
    let t₀ : D₂ := (⟨0, Sum.inl PUnit.unit⟩ : Idx₂)
    have ht₀ : CategoryTheory.Limits.IsTerminal t₀ :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun d => CategoryTheory.InducedCategory.homMk (CategoryTheory.Limits.terminal.from (eval₂ d)))
        (fun d m => CategoryTheory.InducedCategory.hom_ext (CategoryTheory.Limits.terminal.hom_ext m.hom _))
    have : CategoryTheory.Limits.HasTerminal D₂ := ht₀.hasTerminal
    have : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Functor.empty.{0} D₂) G₂ := by
      have hmap_term : CategoryTheory.Limits.IsLimit (G₂.mapCone (CategoryTheory.Limits.asEmptyCone t₀)) :=
        { lift := fun s => (CategoryTheory.Limits.terminal.from s.pt : s.pt ⟶ ⊤_ S₂.Etale)
          fac := fun s j => j.as.elim
          uniq := fun s m _ => CategoryTheory.Limits.terminal.hom_ext (m : s.pt ⟶ ⊤_ S₂.Etale) _ }
      exact CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone ht₀ hmap_term
    have : CategoryTheory.Limits.PreservesLimitsOfShape (CategoryTheory.Discrete PEmpty.{1}) G₂ :=
      CategoryTheory.Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G₂
    have hCospan : ∀ (K : CategoryTheory.Limits.WalkingCospan ⥤ D₂),
        ∃ (c : CategoryTheory.Limits.Cone K), Nonempty (CategoryTheory.Limits.IsLimit (G₂.mapCone c)) := by
      intro K
      let d₁ : Idx₂ := K.obj CategoryTheory.Limits.WalkingCospan.left
      let d₂ : Idx₂ := K.obj CategoryTheory.Limits.WalkingCospan.right
      let d₃ : Idx₂ := K.obj CategoryTheory.Limits.WalkingCospan.one
      let u : K.obj CategoryTheory.Limits.WalkingCospan.left ⟶ K.obj CategoryTheory.Limits.WalkingCospan.one :=
        K.map CategoryTheory.Limits.WalkingCospan.Hom.inl
      let v : K.obj CategoryTheory.Limits.WalkingCospan.right ⟶ K.obj CategoryTheory.Limits.WalkingCospan.one :=
        K.map CategoryTheory.Limits.WalkingCospan.Hom.inr
      obtain ⟨N, ⟨x₁, hx₁⟩, ⟨x₂, hx₂⟩, ⟨x₃, hx₃⟩⟩ :
          ∃ N : ℕ,
            (∃ x₁ : (Stage₂ N).1, (Stage₂ N).2 x₁ = G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.left)) ∧
            (∃ x₂ : (Stage₂ N).1, (Stage₂ N).2 x₂ = G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.right)) ∧
            (∃ x₃ : (Stage₂ N).1, (Stage₂ N).2 x₃ = G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.one)) :=
        ⟨max d₁.1 (max d₂.1 d₃.1),
          lift_le (le_max_left _ _) d₁.2,
          lift_le ((le_max_left _ _).trans (le_max_right _ _)) d₂.2,
          lift_le ((le_max_right _ _).trans (le_max_right _ _)) d₃.2⟩
      let X₁ : S₂.Etale := (Stage₂ N).2 x₁
      let X₂ : S₂.Etale := (Stage₂ N).2 x₂
      let X₃ : S₂.Etale := (Stage₂ N).2 x₃
      let f₁ : X₁ ⟶ X₃ := eqToHom hx₁ ≫ G₂.map u ≫ eqToHom hx₃.symm
      let f₂ : X₂ ⟶ X₃ := eqToHom hx₂ ≫ G₂.map v ≫ eqToHom hx₃.symm
