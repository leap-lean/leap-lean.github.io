theorem weil_top_deg_schematic_graph_image_and_proper_cancel (k : Type u) [Field k] :
    (∀ (A : Type u) [CommRing A] [IsDomain A]
        (Z_amb : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Z_amb.hom]
        (f : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A)) Z_amb.left),
      let Γ_left := AlgebraicGeometry.Scheme.Hom.image f
      let ι_Γ := AlgebraicGeometry.Scheme.Hom.imageι f
      let j_Γ := AlgebraicGeometry.Scheme.Hom.toImage f
      (AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp ι_Γ Z_amb.hom) ∧
        AlgebraicGeometry.IsIntegral Γ_left ∧
        CategoryTheory.CategoryStruct.comp j_Γ ι_Γ = f ∧
        (∀ (T : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
            [AlgebraicGeometry.IsProper T.hom]
            (g₁ g₂ : Quiver.Hom Γ_left T.left),
          CategoryTheory.CategoryStruct.comp j_Γ g₁ =
            CategoryTheory.CategoryStruct.comp j_Γ g₂ →
          g₁ = g₂)) ∧
      (∀ (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          [AlgebraicGeometry.IsProper S.hom]
          (p_amb : Quiver.Hom Z_amb.left S.left)
          (j_S : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A)) S.left)
          (hj_S : AlgebraicGeometry.IsOpenImmersion j_S),
        letI := hj_S
        CategoryTheory.CategoryStruct.comp f p_amb = j_S →
        let p := CategoryTheory.CategoryStruct.comp ι_Γ p_amb
        let O_S : S.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange j_S
        AlgebraicGeometry.IsOpenImmersion j_Γ ∧
        Set.range j_Γ.base = p.base ⁻¹' (O_S : Set ↥S.left) ∧
        CategoryTheory.IsIso (p ∣_ O_S)) ∧
      (AlgebraicGeometry.IsOpenImmersion j_Γ →
        ∀ (P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          [AlgebraicGeometry.IsProper P.hom]
          (p_P : Quiver.Hom Γ_left P.left)
          (U_P : P.left.Opens)
          (u_P : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A)) U_P.toScheme)
          [AlgebraicGeometry.IsProper u_P],
          CategoryTheory.CategoryStruct.comp j_Γ p_P =
            CategoryTheory.CategoryStruct.comp u_P U_P.ι →
          Set.range j_Γ.base = p_P.base ⁻¹' (U_P : Set ↥P.left))) ∧
    (∀ {X S : AlgebraicGeometry.Scheme.{u}} (φ : Quiver.Hom X S)
        (A B : Type u) [CommRing A] [CommRing B] (ψ : B →+* A) (m : ℕ)
        (M : Type u) [AddCommGroup M] [Module B M]
        (_ : Module.Basis (Fin m) B M) (eM : M ≃+ A),
      (∀ b x, eM (b • x) = ψ b * eM x) →
      ∀ (iso_X : CategoryTheory.Iso X (AlgebraicGeometry.Spec (CommRingCat.of A)))
        (iso_S : CategoryTheory.Iso S (AlgebraicGeometry.Spec (CommRingCat.of B))),
        CategoryTheory.CategoryStruct.comp iso_X.inv φ =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) iso_S.inv →
        WeilTopDegFiniteLocallyFreeOfRank m φ) :=
by
  have hSep_over : ∀ (T : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper T.hom], T.left.IsSeparated := by
    intro T _
    rw [AlgebraicGeometry.Scheme.isSeparated_iff]
    haveI : AlgebraicGeometry.IsSeparated
        (CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k))) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff _).mp inferInstance
    have h_comp : AlgebraicGeometry.IsSeparated
        (CategoryTheory.CategoryStruct.comp T.hom
          (CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k)))) :=
      inferInstance
    rwa [CategoryTheory.Limits.terminal.hom_ext
      (CategoryTheory.CategoryStruct.comp T.hom
        (CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k))))
      (CategoryTheory.Limits.terminal.from T.left)] at h_comp
  refine ⟨?_, ?_⟩
  · intro A _ _ Z_amb _ f
    let Γ_left := AlgebraicGeometry.Scheme.Hom.image f
    let ι_Γ := AlgebraicGeometry.Scheme.Hom.imageι f
