        CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer
      haveI : CategoryTheory.Epi g := by
        refine ⟨fun {Z} h₁ h₂ hg => ?_⟩
        apply sheaf_hom_ext
        ext opU : 2
        apply AddCommGrpCat.hom_ext
        ext z
        let U : 𝒞 := opU.unop
