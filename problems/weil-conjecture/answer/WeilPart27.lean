              intro heq
              have hsub : (p idx_b : Set ↥C_s) ⊆ (p idx_a : Set ↥C_s) ∪ (V_s : Set ↥C_s)ᶜ := by
                intro z hz
                by_cases hzV : z ∈ V_s
                · have hz' : (⟨z, hzV⟩ : ↥V_s) ∈ r_ic t.succ := hz
                  rw [← heq] at hz'
                  exact Or.inl hz'
                · exact Or.inr hzV
              rcases isPreirreducible_iff_isClosed_union_isClosed.mp
                  (p idx_b).isIrreducible.isPreirreducible _ _
                  (p idx_a).isClosed V_s.isOpen.isClosed_compl hsub with h1 | h2
              · exact not_le_of_gt hab h1
