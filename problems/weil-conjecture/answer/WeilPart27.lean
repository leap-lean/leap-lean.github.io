        { hom := e_hom
          inv := ε_P
          hom_inv_id := h_hom_inv
          inv_hom_id := h_inv_hom }
      refine ⟨e_P, rfl, ?_⟩
      intro U
      refine ⟨fun a b hab => ?_, fun b => ⟨(ε_P.hom.app (Opposite.op U)).hom b, ?_⟩⟩
      · have h1 := congrArg (fun ψ : P ⟶ P => (ψ.app (Opposite.op U)).hom a) h_rt
        have h2 := congrArg (fun ψ : P ⟶ P => (ψ.app (Opposite.op U)).hom b) h_rt
        change (ε_P.hom.app (Opposite.op U)).hom ((η_P.app (Opposite.op U)).hom a) = a at h1
        change (ε_P.hom.app (Opposite.op U)).hom ((η_P.app (Opposite.op U)).hom b) = b at h2
