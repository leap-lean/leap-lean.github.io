          · exact Or.inl ⟨w, h1, hw⟩
          · exact Or.inr ⟨w, h2, hw⟩
        rcases isPreirreducible_iff_isClosed_union_isClosed.mp
            (p idx0.castSucc).isIrreducible.isPreirreducible _ _
            ((hcl_Z₀.isClosedMap _ hA₁).preimage h_emb_comp.continuous)
            ((hcl_Z₀.isClosedMap _ hA₂).preimage h_emb_comp.continuous) hcov' with h1 | h2
        · left
          intro w ⟨z, hz, hw⟩
          rcases h1 hz with ⟨w', hw', hw'_eq⟩
          have hw_eq : w = w' := hcl_Z₀.injective (hw.symm.trans hw'_eq.symm)
