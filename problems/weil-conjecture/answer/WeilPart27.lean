      apply TopCat.Presheaf.section_ext Γ_left.sheaf W s 0
      intro x hx
      have hClosed_compl : IsClosed ((W : Set ↥Γ_left)ᶜ) := W.isOpen.isClosed_compl
      have hClosed_img : IsClosed (⇑ι_Γ '' ((W : Set ↥Γ_left)ᶜ)) :=
