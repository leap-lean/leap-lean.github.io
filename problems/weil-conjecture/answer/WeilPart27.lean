    let _ : Algebra k B_Vs := algK_Vs
    have hFT_BVs : Algebra.FiniteType k B_Vs := by
      have h1 : RingHom.FiniteType (AlgebraicGeometry.Scheme.Hom.appLE C_ov.hom ⊤ V_s le_top).hom :=
        C_ov.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_k) hAff_Vs le_top
      have h2 : RingHom.FiniteType
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
        RingHom.FiniteType.of_surjective _
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv).surjective
      exact h1.comp h2

    refine iSup_le fun p => ?_
    by_cases hp1 : p.length ≤ 1
    · exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hp1)
    · exfalso
      have hp2 : 2 ≤ p.length := by omega
      let i0 : Fin (p.length + 1) := ⟨0, by omega⟩
      let i1 : Fin (p.length + 1) := ⟨1, by omega⟩
      let i2 : Fin (p.length + 1) := ⟨2, by omega⟩
      have h01 : p i0 < p i1 := p.step ⟨0, by omega⟩
      have h12 : p i1 < p i2 := p.step ⟨1, by omega⟩
      by_cases h0_Vs : ((p i0 : Set ↥C_s) ∩ (V_s : Set ↥C_s)).Nonempty
      · 
        rcases h0_Vs with ⟨x₀, hx₀_0, hx₀_Vs⟩
        let r_ic : Fin 3 → TopologicalSpace.IrreducibleCloseds ↥V_s := fun t =>
          let idx : Fin (p.length + 1) := ⟨t.1, by omega⟩
          { carrier := (Subtype.val : ↥V_s → ↥C_s) ⁻¹' (p idx : Set ↥C_s)
            isIrreducible' :=
              ⟨⟨⟨x₀, hx₀_Vs⟩, p.monotone (Fin.mk_le_mk.mpr (Nat.zero_le t.1)) hx₀_0⟩,
