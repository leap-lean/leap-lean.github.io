      rw [← (hAff_cov α).range_fromSpec]
      exact ⟨q, rfl⟩
    exact hle_pt (e_cov α).1 hq_mem
  let g_cov : ∀ α : Fin r_cov,
      AlgebraicGeometry.Spec (Z₀_ov.left.presheaf.obj (Opposite.op (U_cov α))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_base) :=
    fun α => AlgebraicGeometry.IsOpenImmersion.lift ι_m' ((hAff_cov α).fromSpec ≫ h_Z₀) (h_lift_cov α)
  let φ_cov : ∀ α : Fin r_cov, R_base →ₐ[k] C_cov α := fun α =>
    { toRingHom := (AlgebraicGeometry.Spec.preimage (g_cov α)).hom
      commutes' := fun c => by
        have h1 : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (g_cov α)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R_base)) =
            (hAff_cov α).fromSpec ≫ Z₀_ov.hom := by
          rw [AlgebraicGeometry.Spec.map_preimage, ← hι_m'_ov, ← CategoryTheory.Category.assoc]
          dsimp [g_cov]
          rw [AlgebraicGeometry.IsOpenImmersion.lift_fac, CategoryTheory.Category.assoc, hh_Z₀_ov]
        rw [← AlgebraicGeometry.Spec.map_comp, h_spec_over Z₀_ov (U_cov α) (hAff_cov α)] at h1
        have h2 := AlgebraicGeometry.Spec.map_injective h1
