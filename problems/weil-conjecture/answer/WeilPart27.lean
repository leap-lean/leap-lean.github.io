      let S_f : Type u := ↑(C_tilde.left.presheaf.obj (Opposite.op W))
      let res_R : R₀ →+* R_f :=
        (P₁_ov.left.presheaf.map (CategoryTheory.homOfLE (P₁_ov.left.basicOpen_le f_y)).op).hom
      let res_S : S₀ →+* S_f :=
        (C_tilde.left.presheaf.map (CategoryTheory.homOfLE
          ((TopologicalSpace.Opens.map u_tilde.base).monotone (P₁_ov.left.basicOpen_le f_y))).op).hom
      let α_f : R_f →+* S_f := (u_tilde.app V).hom
      have hLoc_Rf : @IsLocalization.Away R₀ _ f_y R_f _ res_R.toAlgebra :=
        hAff_V₀.isLocalization_basicOpen f_y
      have h_pre_bf : W = C_tilde.left.basicOpen (α₀ f_y) :=
        u_tilde.preimage_basicOpen f_y
      let S_bf : Type u := ↑(C_tilde.left.presheaf.obj (Opposite.op (C_tilde.left.basicOpen (α₀ f_y))))
      let res_Sbf : S₀ →+* S_bf :=
        (C_tilde.left.presheaf.map (CategoryTheory.homOfLE
          (C_tilde.left.basicOpen_le (α₀ f_y))).op).hom
      haveI hLoc_Sbf : @IsLocalization.Away S₀ _ (α₀ f_y) S_bf _ res_Sbf.toAlgebra :=
        hAff_W₀.isLocalization_basicOpen (α₀ f_y)
      let e_Sf : S_bf ≃+* S_f :=
        (C_tilde.left.presheaf.mapIso (CategoryTheory.eqToIso h_pre_bf).op).commRingCatIsoToRingEquiv
      have he_Sf_res : e_Sf.toRingHom.comp res_Sbf = res_S := by
        ext s
        change (C_tilde.left.presheaf.map _ ≫ C_tilde.left.presheaf.map _).hom s = _
        rw [← Functor.map_comp]
        congr 2
      have hLoc_Sf : @IsLocalization.Away S₀ _ (α₀ f_y) S_f _ res_S.toAlgebra := by
        letI : Algebra S₀ S_bf := res_Sbf.toAlgebra
        letI : Algebra S₀ S_f := res_S.toAlgebra
        exact
          { map_units := by
              rintro ⟨_, n, rfl⟩
              change IsUnit (res_S ((α₀ f_y) ^ n))
              rw [← he_Sf_res, RingHom.comp_apply]
              exact (IsLocalization.map_units S_bf (⟨(α₀ f_y) ^ n, n, rfl⟩ : Submonoid.powers (α₀ f_y))).map
                e_Sf.toRingHom
            surj := by
              intro z
              obtain ⟨⟨a, m⟩, hzm⟩ := IsLocalization.surj (Submonoid.powers (α₀ f_y)) (e_Sf.symm z)
              refine ⟨⟨a, m⟩, ?_⟩
              have h1 := congrArg e_Sf hzm
              rw [map_mul, e_Sf.apply_symm_apply] at h1
              change z * res_S m.1 = res_S a
              rw [← he_Sf_res]
              exact h1
            exists_of_eq := fun {x₁ x₂} hx => by
              have hx' : res_Sbf x₁ = res_Sbf x₂ := by
                apply e_Sf.injective
                change (e_Sf.toRingHom.comp res_Sbf) x₁ = (e_Sf.toRingHom.comp res_Sbf) x₂
                rw [he_Sf_res]
                exact hx
              exact IsLocalization.exists_of_eq (M := Submonoid.powers (α₀ f_y)) hx' }
      have hcomp_f : α_f.comp res_R = res_S.comp α₀ := by
        have hnat := u_tilde.naturality (CategoryTheory.homOfLE (P₁_ov.left.basicOpen_le f_y)).op
        ext r
        exact congrArg (fun φ => φ.hom r) hnat
      obtain ⟨b_Sf⟩ := hBasis_away R_f S_f res_R res_S α_f hLoc_Rf hLoc_Sf hcomp_f
      letI : Algebra R_f S_f := α_f.toAlgebra
      exact ⟨V, hy_V, hAff_V, hAff_W, S_f, inferInstance, inferInstance, AddEquiv.refl S_f,
        fun b m => Algebra.smul_def b m, ⟨b_Sf⟩⟩
    exact ⟨d_rk, B_norm, hRB, hDom_Bn, hAlgB, ψ_comp, j_norm,
      hd_rk_pos, hLocFree, hj_norm_open, hj_norm_comm, hj_norm_gs, hj_norm_gs_range,
      ⟨b_Bn⟩, hψ_ker, hψ_frac⟩

theorem weil_curve_fiber_minimalPrime_chart_bijection_and_disjoint_opens (k : Type u) [Field k] [IsAlgClosed k]
    (C_s : AlgebraicGeometry.Scheme.{u})
    (f_Cs : Quiver.Hom C_s (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper f_Cs]
    (hDim_Cs : topologicalKrullDim C_s ≤ (1 : WithBot ℕ∞))
    (V_s : C_s.Opens) (hAff_Vs : AlgebraicGeometry.IsAffineOpen V_s)
    (hDim_Zs : topologicalKrullDim (weilAltClosedComplIdeal C_s V_s).subscheme ≤
      (0 : WithBot ℕ∞))
    (B₀₀ B_s₀ : Type u) [CommRing B₀₀] [IsDomain B₀₀] [IsPrincipalIdealRing B₀₀]
    [CommRing B_s₀]
    (φ_s₀ : B₀₀ →+* B_s₀)
    (m₀ : ℕ) (hm₀ : 1 ≤ m₀)
    (j_s₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_s₀)) C_s)
    (hDim₀₀ : ringKrullDim B₀₀ = (1 : WithBot ℕ∞))
    (hj_open₀ : AlgebraicGeometry.IsOpenImmersion j_s₀)
    (hVs_range₀ : (V_s : Set ↥C_s) ⊆ Set.range j_s₀.base)
    (hb₀ : letI : Algebra B₀₀ B_s₀ := φ_s₀.toAlgebra
      Nonempty (Module.Basis (Fin m₀) B₀₀ B_s₀)) :
    let B₁₂ := ↑(C_s.presheaf.obj (Opposite.op V_s))
    ∃ (c : ℕ)
      (p_V : Fin c → Ideal B₁₂)
      (_ : 1 ≤ c)
      (_ : Function.Injective p_V)
      (hp_V_range : Set.range p_V = minimalPrimes B₁₂),
      (∀ i : Fin c, ringKrullDim (B₁₂ ⧸ p_V i) = (1 : WithBot ℕ∞)) ∧
      (∀ (B₀ B_s : Type u) [CommRing B₀] [IsDomain B₀] [IsPrincipalIdealRing B₀]
         [CommRing B_s]
         (φ_s : B₀ →+* B_s)
         (m_rk : ℕ) (_ : 1 ≤ m_rk)
         (j_s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_s)) C_s),
         ringKrullDim B₀ = (1 : WithBot ℕ∞) →
         AlgebraicGeometry.IsOpenImmersion j_s →
         (V_s : Set ↥C_s) ⊆ Set.range j_s.base →
         (letI : Algebra B₀ B_s := φ_s.toAlgebra
          Nonempty (Module.Basis (Fin m_rk) B₀ B_s)) →
         ∃ (p_B : Fin c → Ideal B_s)
           (_ : Function.Injective p_B)
           (hp_B_range : Set.range p_B = minimalPrimes B_s),
           ∀ i : Fin c,
             letI : (p_B i).IsPrime := (hp_B_range ▸ Set.mem_range_self i).1.1
             letI : (p_V i).IsPrime := (hp_V_range ▸ Set.mem_range_self i).1.1
             j_s.base ⟨p_B i, (hp_B_range ▸ Set.mem_range_self i).1.1⟩ =
               hAff_Vs.fromSpec.base ⟨p_V i, (hp_V_range ▸ Set.mem_range_self i).1.1⟩ ∧
             (p_B i).comap φ_s = ⊥ ∧
             RingHom.Finite φ_s ∧
             (Module.length (Localization.AtPrime (p_B i))
               (Localization.AtPrime (p_B i))).toNat =
               (Module.length (Localization.AtPrime (p_V i))
                 (Localization.AtPrime (p_V i))).toNat) ∧
      (∀ (s_cond : Fin c → B₁₂),
         (∀ i : Fin c, s_cond i ∉ p_V i) →
         ∃ g_open : Fin c → B₁₂,
           (∀ i : Fin c,
             g_open i ∉ p_V i ∧
             (∃ u_i : B₁₂, g_open i = s_cond i * u_i) ∧
             (∀ j : Fin c, j ≠ i → g_open i ∈ p_V j)) ∧
           let V'_comp : Fin c → C_s.Opens := fun i => C_s.basicOpen (g_open i)
           (_root_.Pairwise fun i j : Fin c => Disjoint (V'_comp i) (V'_comp j)) ∧
           (⨆ i : Fin c, V'_comp i) ≤ V_s ∧
           topologicalKrullDim
             (weilAltClosedComplIdeal C_s (⨆ i : Fin c, V'_comp i)).subscheme ≤
               (0 : WithBot ℕ∞)) :=
by
  classical
  let _ := hDim_Cs
  intro B₁₂
  let R_Vs : CommRingCat.{u} := C_s.presheaf.obj (Opposite.op V_s)

  
  have hClSpec : ∀ {R : Type u} [CommRing R] (x y : PrimeSpectrum R),
      y ∈ closure ({x} : Set (PrimeSpectrum R)) ↔ x.asIdeal ≤ y.asIdeal := by
    intro R _ x y
    rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus]
    rfl
  have hBotPrime : ∀ (R : Type u) [CommRing R] [IsDomain R], (⊥ : Ideal R).IsPrime := by
    intro R _ _
    refine ⟨bot_ne_top, ?_⟩
    intro x y hxy
    rw [Ideal.mem_bot] at hxy ⊢
    rw [Ideal.mem_bot]
    exact mul_eq_zero.mp hxy

  
  have hLengthEq : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (e : R₁ ≃+* R₂),
      Module.length R₁ R₁ = Module.length R₂ R₂ := by
    intro R₁ R₂ _ _ e
    letI : RingHomInvPair e.toRingHom e.symm.toRingHom :=
      ⟨RingHom.ext e.symm_apply_apply, RingHom.ext e.apply_symm_apply⟩
    letI : RingHomInvPair e.symm.toRingHom e.toRingHom :=
      ⟨RingHom.ext e.apply_symm_apply, RingHom.ext e.symm_apply_apply⟩
    let e_sl : R₁ ≃ₛₗ[e.toRingHom] R₂ := { e with map_smul' := e.map_mul }
    have h_kd : Order.krullDim (Submodule R₁ R₁) = Order.krullDim (Submodule R₂ R₂) :=
      Order.krullDim_eq_of_orderIso (Submodule.orderIsoMapComap e_sl)
    rw [← Module.coe_length, ← Module.coe_length] at h_kd
    exact WithBot.coe_inj.mp h_kd

  
  have hMaxClosed : ∀ (𝔪 : Ideal B₁₂) (h𝔪 : 𝔪.IsMaximal),
      IsClosed ({hAff_Vs.fromSpec.base ⟨𝔪, h𝔪.isPrime⟩} : Set ↥C_s) := by
    intro 𝔪 h𝔪
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let φ_k_cat : CommRingCat.of k ⟶ R_Vs :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ f_Cs.appLE ⊤ V_s le_top
    letI : Algebra k B₁₂ := φ_k_cat.hom.toAlgebra
    have hFT_B : Algebra.FiniteType k B₁₂ := by
      have h1 : RingHom.FiniteType (f_Cs.appLE ⊤ V_s le_top).hom :=
        f_Cs.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_k) hAff_Vs le_top
      have h2 : RingHom.FiniteType ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
        RingHom.FiniteType.of_surjective _
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv).surjective
      exact h1.comp h2
    obtain ⟨n, Ψ, hΨ_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_B
    haveI : Ideal.IsMaximal 𝔪 := h𝔪
    let 𝔐 : Ideal (MvPolynomial (Fin n) k) := 𝔪.comap Ψ.toRingHom
    have h𝔐_max : 𝔐.IsMaximal :=
      Ideal.comap_isMaximal_of_surjective Ψ.toRingHom hΨ_surj
    obtain ⟨a, ha⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp h𝔐_max
    let κ : Type u := B₁₂ ⧸ 𝔪
    letI : Field κ := Ideal.Quotient.field 𝔪
    have hSurj_alg : Function.Surjective (algebraMap k κ) := by
      intro z
      obtain ⟨b_elem, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨p, rfl⟩ := hΨ_surj b_elem
      refine ⟨MvPolynomial.aeval a p, ?_⟩
      have hmem : p - MvPolynomial.C (MvPolynomial.aeval a p) ∈ 𝔐 := by
        rw [ha, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp
      have hmem' : Ψ p - algebraMap k B₁₂ (MvPolynomial.aeval a p) ∈ 𝔪 := by
        have h1 : Ψ (p - MvPolynomial.C (MvPolynomial.aeval a p)) ∈ 𝔪 := hmem
        have hC : MvPolynomial.C (MvPolynomial.aeval a p) =
            algebraMap k (MvPolynomial (Fin n) k) (MvPolynomial.aeval a p) := rfl
        rwa [map_sub, hC, AlgHom.commutes] at h1
      have hq0 : Ideal.Quotient.mk 𝔪 (Ψ p - algebraMap k B₁₂ (MvPolynomial.aeval a p)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hmem'
      rw [map_sub] at hq0
      exact (sub_eq_zero.mp hq0).symm
    let e_k : k ≃+* κ :=
      RingEquiv.ofBijective (algebraMap k κ) ⟨(algebraMap k κ).injective, hSurj_alg⟩
    let ev_k : B₁₂ →+* k := e_k.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪)
    have hev_comp : φ_k_cat ≫ CommRingCat.ofHom ev_k = 𝟙 (CommRingCat.of k) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_id,
        RingHom.comp_apply, RingHom.id_apply]
      exact e_k.symm_apply_apply c
    let s_k : S_k ⟶ C_s := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_k) ≫ hAff_Vs.fromSpec
    have h_comp_iso : CategoryTheory.IsIso (s_k ≫ f_Cs) := by
      have h1 : s_k ≫ f_Cs =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_k) ≫
            (AlgebraicGeometry.Spec.map (f_Cs.appLE ⊤ V_s le_top) ≫
              (AlgebraicGeometry.isAffineOpen_top S_k).fromSpec) := by
        rw [Category.assoc, ← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_Cs
          (AlgebraicGeometry.isAffineOpen_top S_k) hAff_Vs le_top]
      have h2 : f_Cs.appLE ⊤ V_s le_top ≫ CommRingCat.ofHom ev_k =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom := by
        calc
          f_Cs.appLE ⊤ V_s le_top ≫ CommRingCat.ofHom ev_k
            = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
                (φ_k_cat ≫ CommRingCat.ofHom ev_k) := by
              simp [φ_k_cat]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom := by
              rw [hev_comp, Category.comp_id]
      have h3 : s_k ≫ f_Cs =
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).hom ≫
            S_k.isoSpec.inv := by
        rw [h1, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, h2,
          AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      rw [h3]
      infer_instance
    haveI : CategoryTheory.IsIso (s_k ≫ f_Cs) := h_comp_iso
    haveI : AlgebraicGeometry.IsProper s_k :=
      @AlgebraicGeometry.IsProper.of_comp _ _ _ s_k f_Cs inferInstance inferInstance
    have hCl_range : IsClosed (Set.range s_k.base) := by
      rw [← Set.image_univ]
      exact s_k.isClosedMap Set.univ isClosed_univ
    let pt_bot : PrimeSpectrum k := ⟨⊥, hBotPrime k⟩
    have hmap_bot : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_k)).base pt_bot =
        (⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum B₁₂) := by
      apply PrimeSpectrum.ext
      ext z
      change ev_k z = 0 ↔ z ∈ 𝔪
      change e_k.symm (Ideal.Quotient.mk 𝔪 z) = 0 ↔ z ∈ 𝔪
      rw [map_eq_zero_iff e_k.symm e_k.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hRange_eq : Set.range s_k.base = {hAff_Vs.fromSpec.base ⟨𝔪, h𝔪.isPrime⟩} := by
      ext x
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨pt, rfl⟩
        have hpt_bot : pt.asIdeal = ⊥ := by
          rw [eq_bot_iff]
          intro c hc
          rw [Ideal.mem_bot]
          by_contra hc0
          exact pt.isPrime.ne_top (pt.asIdeal.eq_top_of_isUnit_mem hc (IsUnit.mk0 c hc0))
        have hpt : (pt : PrimeSpectrum k) = pt_bot := PrimeSpectrum.ext hpt_bot
        rw [show pt = pt_bot from hpt]
        exact (congrArg hAff_Vs.fromSpec.base hmap_bot).symm ▸ rfl
      · rintro rfl
        exact ⟨pt_bot, congrArg hAff_Vs.fromSpec.base hmap_bot⟩
    rwa [← hRange_eq]

  
  have hComplDimZero : ∀ (U : C_s.Opens),
      topologicalKrullDim (weilAltClosedComplIdeal C_s U).subscheme ≤ (0 : WithBot ℕ∞) ↔
      ∀ T₁ T₂ : TopologicalSpace.IrreducibleCloseds ↥C_s,
        T₁ < T₂ → ¬ ((T₂ : Set ↥C_s) ⊆ (U : Set ↥C_s)ᶜ) := by
    intro U
    let Z : Set ↥C_s := (U : Set ↥C_s)ᶜ
    let I_Z := weilAltClosedComplIdeal C_s U
    let ι_Z : I_Z.subscheme ⟶ C_s := I_Z.subschemeι
    have hEmb : Topology.IsClosedEmbedding ι_Z.base := ι_Z.isClosedEmbedding
    have hRange_Z : Set.range ι_Z.base = Z := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι]
      exact AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal _
    let pushIC : TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme →
        TopologicalSpace.IrreducibleCloseds ↥C_s :=
      fun S => ⟨ι_Z.base '' (S : Set ↥I_Z.subscheme),
        S.isIrreducible.image ι_Z.base hEmb.continuous.continuousOn,
        hEmb.isClosedMap _ S.isClosed⟩
    have hPush_sub : ∀ S, (pushIC S : Set ↥C_s) ⊆ Z :=
      fun S => hRange_Z ▸ Set.image_subset_range _ _
    have hPush_strict : StrictMono pushIC := by
      intro S₁ S₂ hlt
      have hle : pushIC S₁ ≤ pushIC S₂ := by
        rintro _ ⟨x, hx, rfl⟩
        exact ⟨x, (le_of_lt hlt) hx, rfl⟩
      refine lt_of_le_not_ge hle ?_
      intro hge
      apply not_le_of_gt hlt
      intro x hx
      obtain ⟨x', hx'S₁, hx'_eq⟩ := hge ⟨x, hx, rfl⟩
      exact hEmb.injective hx'_eq ▸ hx'S₁
    let pullIC : ∀ (T : TopologicalSpace.IrreducibleCloseds ↥C_s),
        (T : Set ↥C_s) ⊆ Z → TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme :=
      fun T hTZ =>
        { carrier := ι_Z.base ⁻¹' (T : Set ↥C_s)
          isIrreducible' := by
            refine ⟨?_, ?_⟩
            · obtain ⟨y, hy⟩ := T.isIrreducible.nonempty
              obtain ⟨x, hx⟩ : y ∈ Set.range ι_Z.base := hRange_Z.symm ▸ hTZ hy
              exact ⟨x, by change ι_Z.base x ∈ (T : Set ↥C_s); rwa [hx]⟩
            · intro u v hu hv ⟨x₁, hx₁T, hx₁u⟩ ⟨x₂, hx₂T, hx₂v⟩
              obtain ⟨u', hu', rfl⟩ := hEmb.isEmbedding.isInducing.isOpen_iff.mp hu
              obtain ⟨v', hv', rfl⟩ := hEmb.isEmbedding.isInducing.isOpen_iff.mp hv
              obtain ⟨y₀, hy₀T, hy₀u, hy₀v⟩ :=
                T.isIrreducible.isPreirreducible u' v' hu' hv'
                  ⟨ι_Z.base x₁, hx₁T, hx₁u⟩ ⟨ι_Z.base x₂, hx₂T, hx₂v⟩
              obtain ⟨x₀, hx₀_eq⟩ : y₀ ∈ Set.range ι_Z.base := hRange_Z.symm ▸ hTZ hy₀T
              have hx₀_T : x₀ ∈ ι_Z.base ⁻¹' (T : Set ↥C_s) := by
                change ι_Z.base x₀ ∈ (T : Set ↥C_s)
                rwa [hx₀_eq]
              have hx₀_uv : x₀ ∈ ι_Z.base ⁻¹' u' ∩ ι_Z.base ⁻¹' v' := by
                change ι_Z.base x₀ ∈ u' ∧ ι_Z.base x₀ ∈ v'
                rw [hx₀_eq]
                exact ⟨hy₀u, hy₀v⟩
              exact ⟨x₀, hx₀_T, hx₀_uv⟩
          isClosed' := T.isClosed.preimage hEmb.continuous }
    constructor
    · intro hDim T₁ T₂ hT_lt hT₂_sub
      have hT₁_sub : (T₁ : Set ↥C_s) ⊆ Z := Set.Subset.trans (le_of_lt hT_lt) hT₂_sub
      let S₁ := pullIC T₁ hT₁_sub
      let S₂ := pullIC T₂ hT₂_sub
      have hS_le : S₁ ≤ S₂ := fun x hx => (le_of_lt hT_lt) hx
      have hS_lt : S₁ < S₂ := by
        refine lt_of_le_not_ge hS_le ?_
        intro hge
        apply not_le_of_gt hT_lt
        intro y hy
        obtain ⟨x, hx_eq⟩ : y ∈ Set.range ι_Z.base := hRange_Z.symm ▸ hT₂_sub hy
        have hx_S₂ : x ∈ (S₂ : Set ↥I_Z.subscheme) := by
          change ι_Z.base x ∈ (T₂ : Set ↥C_s)
          rwa [hx_eq]
        have hx_S₁ : x ∈ (S₁ : Set ↥I_Z.subscheme) := hge hx_S₂
        change y ∈ (T₁ : Set ↥C_s)
        rw [← hx_eq]
        exact hx_S₁
      let p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme) :=
        { length := 1
          toFun := ![S₁, S₂]
          step := fun i => by fin_cases i; exact hS_lt }
      have h1 : (1 : WithBot ℕ∞) ≤
          Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme) :=
        Order.LTSeries.length_le_krullDim p
      have h10 : (1 : WithBot ℕ∞) ≤ (0 : WithBot ℕ∞) := le_trans h1 hDim
      exact absurd h10 (by decide)
    · intro hNoChain
      change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme) ≤ (0 : WithBot ℕ∞)
      by_cases hEmp : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme)
      · rw [@Order.krullDim_eq_bot _ _ hEmp]
        exact bot_le
      · haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme) :=
          not_isEmpty_iff.mp hEmp
        rw [Order.krullDim_eq_iSup_length]
        change ((⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme),
          (p.length : ℕ∞) : ℕ∞) : WithBot ℕ∞) ≤ ((0 : ℕ∞) : WithBot ℕ∞)
        rw [WithBot.coe_le_coe]
        refine iSup_le fun l => ?_
        by_cases hl : l.length = 0
        · simp [hl]
        · have hl_pos : 0 < l.length := Nat.pos_of_ne_zero hl
          have hstep : l ⟨0, Nat.succ_pos _⟩ < l ⟨1, Nat.succ_lt_succ hl_pos⟩ :=
            l.step ⟨0, hl_pos⟩
          exact False.elim (hNoChain _ _ (hPush_strict hstep) (hPush_sub _))

  
  have hAlgChart : ∀ (B₀ B_s : Type u) [CommRing B₀] [IsDomain B₀] [IsPrincipalIdealRing B₀]
      [CommRing B_s] (φ_s : B₀ →+* B_s) (m_rk : ℕ) (_ : 1 ≤ m_rk),
      ringKrullDim B₀ = (1 : WithBot ℕ∞) →
      (letI : Algebra B₀ B_s := φ_s.toAlgebra
       Nonempty (Module.Basis (Fin m_rk) B₀ B_s)) →
      RingHom.Finite φ_s ∧
      (minimalPrimes B_s).Finite ∧
      (minimalPrimes B_s).Nonempty ∧
      ringKrullDim B_s ≤ (1 : WithBot ℕ∞) ∧
      ∀ 𝔭 ∈ minimalPrimes B_s, 𝔭.comap φ_s = ⊥ ∧ ∃ 𝔮 : Ideal B_s, 𝔮.IsPrime ∧ 𝔭 < 𝔮 := by
    intro B₀ B_s _ _ _ _ φ_s m_rk hm_rk hDim₀ hb
    letI : Algebra B₀ B_s := φ_s.toAlgebra
    obtain ⟨b⟩ := hb
    have hModFin : Module.Finite B₀ B_s := Module.Finite.of_basis b
    haveI : Module.Finite B₀ B_s := hModFin
    have hFin_φ : RingHom.Finite φ_s := hModFin
    haveI : Algebra.FiniteType B₀ B_s := RingHom.Finite.to_finiteType hFin_φ
    haveI : IsNoetherianRing B_s := Algebra.FiniteType.isNoetherianRing B₀ B_s
    have hMinFin : (minimalPrimes B_s).Finite := minimalPrimes.finite_of_isNoetherianRing B_s
    haveI : Nontrivial B_s := by
      let idx0 : Fin m_rk := ⟨0, hm_rk⟩
      refine ⟨⟨b idx0, 0, fun h0 => ?_⟩⟩
      have h10 : (b.repr (b idx0)) idx0 = (b.repr 0) idx0 := congrArg (fun v => b.repr v idx0) h0
      simp only [Module.Basis.repr_self, Finsupp.single_eq_same, map_zero,
        Finsupp.zero_apply] at h10
      exact one_ne_zero h10
    have hMinNe : (minimalPrimes B_s).Nonempty := by
      obtain ⟨𝔪, h𝔪_max, _⟩ := Ideal.exists_le_maximal (⊥ : Ideal B_s) bot_ne_top
      haveI : 𝔪.IsPrime := h𝔪_max.isPrime
      obtain ⟨𝔭, h𝔭_min, _⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal B_s) ≤ 𝔪)
      exact ⟨𝔭, h𝔭_min⟩
    haveI : Algebra.IsIntegral B₀ B_s := Algebra.IsIntegral.of_finite B₀ B_s
    have hStrictComap : StrictMono (PrimeSpectrum.comap φ_s) := by
      intro Q₀ Q₁ hQ_lt
      have hQ_id_lt : Q₀.asIdeal < Q₁.asIdeal := hQ_lt
      change Q₀.asIdeal.comap φ_s < Q₁.asIdeal.comap φ_s
      obtain ⟨r, hr₁, hr₀⟩ := SetLike.exists_of_lt hQ_id_lt
      obtain ⟨P, hP_monic, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := B₀) r
      haveI : Q₀.asIdeal.IsPrime := Q₀.isPrime
      let p₀ : Ideal B₀ := Q₀.asIdeal.comap φ_s
      haveI : p₀.IsPrime := Ideal.IsPrime.comap φ_s
      haveI : IsDomain (B₀ ⧸ p₀) := (Ideal.Quotient.isDomain_iff_prime p₀).mpr inferInstance
      have hP_ne : P.map (Ideal.Quotient.mk p₀) ≠ 0 :=
        (hP_monic.map (Ideal.Quotient.mk p₀)).ne_zero
      have hP_mem : Polynomial.eval₂ φ_s r P ∈ Q₀.asIdeal := by
        change Polynomial.eval₂ (algebraMap B₀ B_s) r P ∈ Q₀.asIdeal
        rw [hP_eval]
        exact Q₀.asIdeal.zero_mem
      exact Ideal.comap_lt_comap_of_root_mem_sdiff (le_of_lt hQ_id_lt) ⟨hr₁, hr₀⟩ hP_ne hP_mem
    have hDim_Bs : ringKrullDim B_s ≤ (1 : WithBot ℕ∞) := by
      calc
        ringKrullDim B_s
          = Order.krullDim (PrimeSpectrum B_s) := rfl
        _ ≤ Order.krullDim (PrimeSpectrum B₀) :=
            Order.krullDim_le_of_strictMono (PrimeSpectrum.comap φ_s) hStrictComap
        _ = ringKrullDim B₀ := rfl
        _ = (1 : WithBot ℕ∞) := hDim₀
    have hP₀_ex : ∃ P₀ : Ideal B₀, P₀.IsPrime ∧ (⊥ : Ideal B₀) < P₀ := by
      by_contra h_no
      have h_sub : Subsingleton (PrimeSpectrum B₀) := by
        refine ⟨fun x y => ?_⟩
        have hx : x.asIdeal = ⊥ :=
          le_antisymm (by_contra fun h => h_no ⟨x.asIdeal, x.isPrime, lt_of_le_not_ge bot_le h⟩)
            bot_le
        have hy : y.asIdeal = ⊥ :=
          le_antisymm (by_contra fun h => h_no ⟨y.asIdeal, y.isPrime, lt_of_le_not_ge bot_le h⟩)
            bot_le
        exact PrimeSpectrum.ext (hx.trans hy.symm)
      haveI : Nonempty (PrimeSpectrum B₀) := ⟨⟨⊥, hBotPrime B₀⟩⟩
      have hDim_le0 : ringKrullDim B₀ ≤ (0 : WithBot ℕ∞) := by
        change Order.krullDim (PrimeSpectrum B₀) ≤ (0 : WithBot ℕ∞)
        rw [Order.krullDim_eq_iSup_length]
        change ((⨆ p : LTSeries (PrimeSpectrum B₀), (p.length : ℕ∞) : ℕ∞) : WithBot ℕ∞) ≤
          ((0 : ℕ∞) : WithBot ℕ∞)
        rw [WithBot.coe_le_coe]
        refine iSup_le fun l => ?_
        by_cases hl : l.length = 0
        · simp [hl]
        · have hl_pos : 0 < l.length := Nat.pos_of_ne_zero hl
          have hstep := l.step ⟨0, hl_pos⟩
          exact False.elim (ne_of_lt hstep (h_sub.elim _ _))
      rw [hDim₀] at hDim_le0
      exact absurd hDim_le0 (by decide)
    refine ⟨hFin_φ, hMinFin, hMinNe, hDim_Bs, ?_⟩
    intro 𝔭 h𝔭
    haveI : 𝔭.IsPrime := h𝔭.1.1
    have h_comap_bot : 𝔭.comap φ_s = ⊥ := by
      rw [eq_bot_iff]
      intro a ha
      change a ∈ (⊥ : Ideal B₀)
      rw [Ideal.mem_bot]
      have ha_mem : φ_s a ∈ 𝔭 := ha
      let A_p := Localization.AtPrime 𝔭
      have hz_nil : algebraMap B_s A_p (φ_s a) ∈ nilradical A_p := by
        rw [nilradical_eq_sInf, Ideal.mem_sInf]
        intro P hP_prime
        haveI : P.IsPrime := hP_prime
        let Q : Ideal B_s := P.comap (algebraMap B_s A_p)
        have hQ_prime : Q.IsPrime := Ideal.IsPrime.comap (algebraMap B_s A_p)
        have hQ_le : Q ≤ 𝔭 := by
          intro x hxQ
          by_contra hx_not
          have hunit : IsUnit (algebraMap B_s A_p x) :=
            IsLocalization.map_units A_p (⟨x, hx_not⟩ : 𝔭.primeCompl)
          exact hP_prime.ne_top (P.eq_top_of_isUnit_mem hxQ hunit)
        have h𝔭_le_Q : 𝔭 ≤ Q := h𝔭.2 ⟨hQ_prime, bot_le⟩ hQ_le
        exact h𝔭_le_Q ha_mem
      obtain ⟨n_pow, hn_pow⟩ := mem_nilradical.mp hz_nil
      rw [← map_pow] at hn_pow
      obtain ⟨⟨t, ht_not_mem⟩, ht_zero⟩ :=
        (IsLocalization.map_eq_zero_iff 𝔭.primeCompl A_p _).mp hn_pow
      have ht_ne : t ≠ 0 := fun ht0 => ht_not_mem (ht0 ▸ 𝔭.zero_mem)
      have hrepr_ne : b.repr t ≠ 0 := fun h0 => ht_ne (b.repr.injective (h0.trans (map_zero _).symm))
      obtain ⟨idx, hidx_ne⟩ := Finsupp.ne_iff.mp hrepr_ne
      have hsmul0 : (a ^ n_pow) • t = 0 := by
        change φ_s (a ^ n_pow) * t = 0
        rw [map_pow]
        calc
          (φ_s a) ^ n_pow * t = t * (φ_s a) ^ n_pow := mul_comm _ _
          _ = 0 := ht_zero
      have hmul0 : a ^ n_pow * (b.repr t idx) = 0 := by
        have h_eval := congrArg (fun v => b.repr v idx) hsmul0
        simpa only [map_smul, map_zero, Finsupp.smul_apply, smul_eq_mul,
          Finsupp.zero_apply] using h_eval
      have han0 : a ^ n_pow = 0 := (mul_eq_zero.mp hmul0).resolve_right hidx_ne
      by_contra ha_ne
      exact pow_ne_zero n_pow ha_ne han0
    obtain ⟨P₀, hP₀_prime, hP₀_pos⟩ := hP₀_ex
    haveI : P₀.IsPrime := hP₀_prime
    have h_le_P₀ : Ideal.comap (algebraMap B₀ B_s) 𝔭 ≤ P₀ := by
      change 𝔭.comap φ_s ≤ P₀
      rw [h_comap_bot]
      exact bot_le
    obtain ⟨𝔮, h𝔭_le_𝔮, h𝔮_prime, h𝔮_over⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime P₀ 𝔭 h_le_P₀
    refine ⟨h_comap_bot, 𝔮, h𝔮_prime, lt_of_le_of_ne h𝔭_le_𝔮 ?_⟩
    intro h_eq
    subst h_eq
    change 𝔭.comap φ_s = P₀ at h𝔮_over
    rw [h_comap_bot] at h𝔮_over
    exact ne_of_lt hP₀_pos h𝔮_over

  
  have hChartMinInVs : ∀ (B₀ B_s : Type u) [CommRing B₀] [IsDomain B₀] [IsPrincipalIdealRing B₀]
      [CommRing B_s] (φ_s : B₀ →+* B_s) (m_rk : ℕ) (_ : 1 ≤ m_rk)
      (j_s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_s)) C_s),
      ringKrullDim B₀ = (1 : WithBot ℕ∞) →
      AlgebraicGeometry.IsOpenImmersion j_s →
      (letI : Algebra B₀ B_s := φ_s.toAlgebra
       Nonempty (Module.Basis (Fin m_rk) B₀ B_s)) →
      ∀ (𝔭 : Ideal B_s) (h𝔭 : 𝔭 ∈ minimalPrimes B_s),
        j_s.base ⟨𝔭, h𝔭.1.1⟩ ∈ V_s := by
    intro B₀ B_s _ _ _ _ φ_s m_rk hm_rk j_s hDim₀ hj_open hb 𝔭 h𝔭
    obtain ⟨_, _, _, _, hGoUp⟩ := hAlgChart B₀ B_s φ_s m_rk hm_rk hDim₀ hb
    obtain ⟨_, 𝔮, h𝔮_prime, h_lt⟩ := hGoUp 𝔭 h𝔭
    let pt_p : PrimeSpectrum B_s := ⟨𝔭, h𝔭.1.1⟩
    let pt_q : PrimeSpectrum B_s := ⟨𝔮, h𝔮_prime⟩
    let f_js : PrimeSpectrum B_s → ↥C_s := j_s.base
    have hf_cont : Continuous f_js := j_s.continuous
    haveI : AlgebraicGeometry.IsOpenImmersion j_s := hj_open
    have hf_emb : Topology.IsEmbedding f_js := j_s.isOpenEmbedding.isEmbedding
    let x : ↥C_s := f_js pt_p
    let y : ↥C_s := f_js pt_q
    by_contra hx_not
    let T₁ : TopologicalSpace.IrreducibleCloseds ↥C_s :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    let T₂ : TopologicalSpace.IrreducibleCloseds ↥C_s :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hy_in_clx : y ∈ closure ({x} : Set ↥C_s) := by
      have hq_cl : pt_q ∈ closure ({pt_p} : Set (PrimeSpectrum B_s)) :=
        (hClSpec pt_p pt_q).mpr (le_of_lt h_lt)
      have himg : f_js pt_q ∈ closure (f_js '' {pt_p}) :=
        image_closure_subset_closure_image hf_cont ⟨pt_q, hq_cl, rfl⟩
      rwa [Set.image_singleton] at himg
    have hT_le : T₁ ≤ T₂ :=
      closure_minimal (Set.singleton_subset_iff.mpr hy_in_clx) isClosed_closure
    have hx_not_cly : x ∉ closure ({y} : Set ↥C_s) := by
      intro hx_in
      have hpre : pt_p ∈ f_js ⁻¹' closure (f_js '' {pt_q}) := by
        rw [Set.image_singleton]
        exact hx_in
      rw [← hf_emb.closure_eq_preimage_closure_image] at hpre
      exact not_le_of_gt h_lt ((hClSpec pt_q pt_p).mp hpre)
    have hT_lt : T₁ < T₂ := by
      refine lt_of_le_not_ge hT_le ?_
      intro hge
      exact hx_not_cly (hge (subset_closure rfl))
    have hT₂_compl : (T₂ : Set ↥C_s) ⊆ (V_s : Set ↥C_s)ᶜ :=
      closure_minimal (Set.singleton_subset_iff.mpr hx_not) V_s.isOpen.isClosed_compl
    exact ((hComplDimZero V_s).mp hDim_Zs) T₁ T₂ hT_lt hT₂_compl

  
  have hOpenChart : ∀ (B_s : Type u) [CommRing B_s]
      (j_s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_s)) C_s),
      AlgebraicGeometry.IsOpenImmersion j_s →
      (V_s : Set ↥C_s) ⊆ Set.range j_s.base →
      (∀ (𝔭 : Ideal B_s) (h𝔭 : 𝔭 ∈ minimalPrimes B_s), j_s.base ⟨𝔭, h𝔭.1.1⟩ ∈ V_s) →
      ringKrullDim B₁₂ ≤ ringKrullDim B_s ∧
      ∃ Φ : PrimeSpectrum B₁₂ → PrimeSpectrum B_s,
        (∀ p : PrimeSpectrum B₁₂, j_s.base (Φ p) = hAff_Vs.fromSpec.base p) ∧
        Function.Injective Φ ∧
        (∀ p : PrimeSpectrum B₁₂,
          p.asIdeal ∈ minimalPrimes B₁₂ ↔ (Φ p).asIdeal ∈ minimalPrimes B_s) ∧
        (∀ q : PrimeSpectrum B_s, q.asIdeal ∈ minimalPrimes B_s →
          ∃ p : PrimeSpectrum B₁₂, p.asIdeal ∈ minimalPrimes B₁₂ ∧ Φ p = q) ∧
        (∀ p : PrimeSpectrum B₁₂,
          Module.length (Localization.AtPrime (Φ p).asIdeal)
            (Localization.AtPrime (Φ p).asIdeal) =
          Module.length (Localization.AtPrime p.asIdeal)
            (Localization.AtPrime p.asIdeal)) := by
    intro B_s _ j_s hj_open hVs_range hMin_in_Vs
    haveI : AlgebraicGeometry.IsOpenImmersion j_s := hj_open
    have hrange_spec : Set.range hAff_Vs.fromSpec.base ⊆ Set.range j_s.base := by
      rwa [hAff_Vs.range_fromSpec]
    let ι : AlgebraicGeometry.Spec R_Vs ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_s) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_s hAff_Vs.fromSpec hrange_spec
    have hι_fac : ι ≫ j_s = hAff_Vs.fromSpec :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_s hAff_Vs.fromSpec hrange_spec
    have hι_comp_open : AlgebraicGeometry.IsOpenImmersion (ι ≫ j_s) := by
      rw [hι_fac]
      infer_instance
    have hι_open : AlgebraicGeometry.IsOpenImmersion ι :=
      @AlgebraicGeometry.IsOpenImmersion.of_comp _ _ _ ι j_s hj_open hι_comp_open
    haveI : AlgebraicGeometry.IsOpenImmersion ι := hι_open
    let Φ : PrimeSpectrum B₁₂ → PrimeSpectrum B_s := ι.base
    have hΦ_base : ∀ p : PrimeSpectrum B₁₂, j_s.base (Φ p) = hAff_Vs.fromSpec.base p := by
      intro p
      exact (AlgebraicGeometry.Scheme.Hom.comp_apply ι j_s p).symm.trans
        (congrArg (fun g => g.base p) hι_fac)
    have hemb : Topology.IsOpenEmbedding Φ := ι.isOpenEmbedding
    have hOrder : ∀ p₁ p₂ : PrimeSpectrum B₁₂,
        p₁.asIdeal ≤ p₂.asIdeal ↔ (Φ p₁).asIdeal ≤ (Φ p₂).asIdeal := by
      intro p₁ p₂
      rw [← hClSpec p₁ p₂, ← hClSpec (Φ p₁) (Φ p₂),
        hemb.isEmbedding.closure_eq_preimage_closure_image]
      rw [Set.image_singleton]
      rfl
    have hStrictΦ : StrictMono Φ := by
      intro p₁ p₂ hlt
      exact lt_of_le_not_ge ((hOrder p₁ p₂).mp (le_of_lt hlt))
        (mt (hOrder p₂ p₁).mpr (not_le_of_gt hlt))
    have hDim_le : ringKrullDim B₁₂ ≤ ringKrullDim B_s :=
      Order.krullDim_le_of_strictMono Φ hStrictΦ
    have hDownClosed : ∀ (p : PrimeSpectrum B₁₂) (q' : PrimeSpectrum B_s),
        q'.asIdeal ≤ (Φ p).asIdeal → ∃ p' : PrimeSpectrum B₁₂, Φ p' = q' := by
      intro p q' hle
      have hcl : Φ p ∈ closure ({q'} : Set (PrimeSpectrum B_s)) :=
        (hClSpec q' (Φ p)).mpr hle
      obtain ⟨_, ⟨⟨p', rfl⟩, hmem_q'⟩⟩ :=
        mem_closure_iff.mp hcl (Set.range Φ) hemb.isOpen_range ⟨p, rfl⟩
      rw [Set.mem_singleton_iff] at hmem_q'
      exact ⟨p', hmem_q'⟩
    have hMinIff : ∀ p : PrimeSpectrum B₁₂,
        p.asIdeal ∈ minimalPrimes B₁₂ ↔ (Φ p).asIdeal ∈ minimalPrimes B_s := by
      intro p
      constructor
      · intro hp
        refine ⟨⟨(Φ p).isPrime, bot_le⟩, ?_⟩
        rintro I ⟨hI_prime, _⟩ hI_le
        obtain ⟨p', hp'_eq⟩ := hDownClosed p ⟨I, hI_prime⟩ hI_le
        have hp'_le : p'.asIdeal ≤ p.asIdeal := by
          apply (hOrder p' p).mpr
          rw [hp'_eq]
          exact hI_le
        have hp_le : p.asIdeal ≤ p'.asIdeal := hp.2 ⟨p'.isPrime, bot_le⟩ hp'_le
        have hΦ_le := (hOrder p p').mp hp_le
        rwa [hp'_eq] at hΦ_le
      · intro hΦp
        refine ⟨⟨p.isPrime, bot_le⟩, ?_⟩
        rintro J ⟨hJ_prime, _⟩ hJ_le
        let p' : PrimeSpectrum B₁₂ := ⟨J, hJ_prime⟩
        have hΦ'_le : (Φ p').asIdeal ≤ (Φ p).asIdeal := (hOrder p' p).mp hJ_le
        have hΦ_le : (Φ p).asIdeal ≤ (Φ p').asIdeal := hΦp.2 ⟨(Φ p').isPrime, bot_le⟩ hΦ'_le
        exact (hOrder p p').mpr hΦ_le
    have hMinSurj : ∀ q : PrimeSpectrum B_s, q.asIdeal ∈ minimalPrimes B_s →
        ∃ p : PrimeSpectrum B₁₂, p.asIdeal ∈ minimalPrimes B₁₂ ∧ Φ p = q := by
      intro q hq
      have hq_Vs : j_s.base q ∈ (V_s : Set ↥C_s) := by
        have hq_eq : (⟨q.asIdeal, hq.1.1⟩ : PrimeSpectrum B_s) = q := PrimeSpectrum.ext rfl
        rw [← hq_eq]
        exact hMin_in_Vs q.asIdeal hq
      rw [← hAff_Vs.range_fromSpec] at hq_Vs
      obtain ⟨p, hp_eq⟩ := hq_Vs
      have hΦp_eq : Φ p = q := by
        apply j_s.isOpenEmbedding.injective
        rw [hΦ_base p, hp_eq]
      exact ⟨p, (hMinIff p).mpr (hΦp_eq.symm ▸ hq), hΦp_eq⟩
    have hLenEq : ∀ p : PrimeSpectrum B₁₂,
        Module.length (Localization.AtPrime (Φ p).asIdeal)
          (Localization.AtPrime (Φ p).asIdeal) =
        Module.length (Localization.AtPrime p.asIdeal)
          (Localization.AtPrime p.asIdeal) := by
      intro p
      have hStalkIso : CategoryTheory.IsIso (ι.stalkMap p) :=
        @AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap _ _ ι hι_open p
      let e₁ : Localization.AtPrime (Φ p).asIdeal ≃+*
          ↑((AlgebraicGeometry.Spec (CommRingCat.of B_s)).presheaf.stalk (Φ p)) :=
        (AlgebraicGeometry.StructureSheaf.stalkIso B_s (Φ p)).toRingEquiv
      let e₂ : ↑((AlgebraicGeometry.Spec (CommRingCat.of B_s)).presheaf.stalk (Φ p)) ≃+*
          ↑((AlgebraicGeometry.Spec R_Vs).presheaf.stalk p) :=
        (@CategoryTheory.asIso _ _ _ _ (ι.stalkMap p) hStalkIso).commRingCatIsoToRingEquiv
      let e₃ : ↑((AlgebraicGeometry.Spec R_Vs).presheaf.stalk p) ≃+*
          Localization.AtPrime p.asIdeal :=
        (AlgebraicGeometry.StructureSheaf.stalkIso B₁₂ p).toRingEquiv.symm
      exact hLengthEq (e₁.trans (e₂.trans e₃))
    exact ⟨hDim_le, Φ, hΦ_base, hemb.injective, hMinIff, hMinSurj, hLenEq⟩

  
  obtain ⟨_, hMinFin₀, hMinNe₀, hDim_Bs₀, hGoUp₀⟩ :=
    hAlgChart B₀₀ B_s₀ φ_s₀ m₀ hm₀ hDim₀₀ hb₀
  have hMinInVs₀ :=
    hChartMinInVs B₀₀ B_s₀ φ_s₀ m₀ hm₀ j_s₀ hDim₀₀ hj_open₀ hb₀
  obtain ⟨hDim_B12_le₀, Φ₀, hΦ₀_base, hΦ₀_inj, hΦ₀_min_iff, hΦ₀_min_surj, _⟩ :=
    hOpenChart B_s₀ j_s₀ hj_open₀ hVs_range₀ hMinInVs₀
  have hDim_B12 : ringKrullDim B₁₂ ≤ (1 : WithBot ℕ∞) := le_trans hDim_B12_le₀ hDim_Bs₀

  haveI : Finite ↥(minimalPrimes B₁₂) := by
    haveI : Finite ↥(minimalPrimes B_s₀) := hMinFin₀.to_subtype
    let g_min : ↥(minimalPrimes B₁₂) → ↥(minimalPrimes B_s₀) :=
      fun ⟨I, hI⟩ => ⟨(Φ₀ ⟨I, hI.1.1⟩).asIdeal, (hΦ₀_min_iff ⟨I, hI.1.1⟩).mp hI⟩
    have hg_inj : Function.Injective g_min := by
      rintro ⟨I₁, hI₁⟩ ⟨I₂, hI₂⟩ heq
      have hspec : Φ₀ ⟨I₁, hI₁.1.1⟩ = Φ₀ ⟨I₂, hI₂.1.1⟩ :=
        PrimeSpectrum.ext (congrArg Subtype.val heq)
      exact Subtype.ext (congrArg PrimeSpectrum.asIdeal (hΦ₀_inj hspec))
    exact Finite.of_injective g_min hg_inj
  haveI : Nonempty ↥(minimalPrimes B₁₂) := by
    obtain ⟨𝔭₀, h𝔭₀⟩ := hMinNe₀
    obtain ⟨p₀, hp₀_min, _⟩ := hΦ₀_min_surj ⟨𝔭₀, h𝔭₀.1.1⟩ h𝔭₀
    exact ⟨⟨p₀.asIdeal, hp₀_min⟩⟩

  letI : Fintype ↥(minimalPrimes B₁₂) := Fintype.ofFinite ↥(minimalPrimes B₁₂)
  let c : ℕ := Fintype.card ↥(minimalPrimes B₁₂)
  let e_fin : Fin c ≃ ↥(minimalPrimes B₁₂) := (Fintype.equivFin ↥(minimalPrimes B₁₂)).symm
  let p_V : Fin c → Ideal B₁₂ := fun i => (e_fin i).1
  have hc_pos : 1 ≤ c := Fintype.card_pos
  have hp_V_inj : Function.Injective p_V := Subtype.val_injective.comp e_fin.injective
  have hp_V_range : Set.range p_V = minimalPrimes B₁₂ := by
    ext I
    constructor
    · rintro ⟨i, rfl⟩
      exact (e_fin i).2
    · intro hI
      exact ⟨e_fin.symm ⟨I, hI⟩, congrArg Subtype.val (e_fin.apply_symm_apply ⟨I, hI⟩)⟩

  refine ⟨c, p_V, hc_pos, hp_V_inj, hp_V_range, ?_, ?_, ?_⟩

  
  · intro i
    have hp_Vi : p_V i ∈ minimalPrimes B₁₂ := (e_fin i).2
    haveI : (p_V i).IsPrime := hp_Vi.1.1
    have h_le1 : ringKrullDim (B₁₂ ⧸ p_V i) ≤ (1 : WithBot ℕ∞) :=
      le_trans (ringKrullDim_quotient_le (p_V i)) hDim_B12
    let pt_V : PrimeSpectrum B₁₂ := ⟨p_V i, hp_Vi.1.1⟩
    have h_not_max : ¬ (p_V i).IsMaximal := by
      intro hMax
      have hCl_pt : IsClosed ({hAff_Vs.fromSpec.base pt_V} : Set ↥C_s) :=
        hMaxClosed (p_V i) hMax
      have hΦ_min : (Φ₀ pt_V).asIdeal ∈ minimalPrimes B_s₀ :=
        (hΦ₀_min_iff pt_V).mp hp_Vi
      obtain ⟨_, 𝔮₀, h𝔮₀_prime, h_lt₀⟩ := hGoUp₀ (Φ₀ pt_V).asIdeal hΦ_min
      let pt_q₀ : PrimeSpectrum B_s₀ := ⟨𝔮₀, h𝔮₀_prime⟩
      let f_js₀ : PrimeSpectrum B_s₀ → ↥C_s := j_s₀.base
      have hq₀_cl : pt_q₀ ∈ closure ({Φ₀ pt_V} : Set (PrimeSpectrum B_s₀)) :=
        (hClSpec (Φ₀ pt_V) pt_q₀).mpr (le_of_lt h_lt₀)
      have himg : f_js₀ pt_q₀ ∈ closure (f_js₀ '' {Φ₀ pt_V}) :=
        image_closure_subset_closure_image j_s₀.continuous ⟨pt_q₀, hq₀_cl, rfl⟩
      rw [Set.image_singleton] at himg
      change j_s₀.base pt_q₀ ∈ closure {j_s₀.base (Φ₀ pt_V)} at himg
      rw [hΦ₀_base pt_V, hCl_pt.closure_eq, Set.mem_singleton_iff, ← hΦ₀_base pt_V] at himg
      haveI : AlgebraicGeometry.IsOpenImmersion j_s₀ := hj_open₀
      have h_eq_pt : pt_q₀ = Φ₀ pt_V := j_s₀.isOpenEmbedding.injective himg
      exact ne_of_gt h_lt₀ (congrArg PrimeSpectrum.asIdeal h_eq_pt)
    obtain ⟨𝔪, h𝔪_max, h_le_𝔪⟩ :=
      Ideal.exists_le_maximal (p_V i) (Ideal.IsPrime.ne_top inferInstance)
    have h_lt_𝔪 : p_V i < 𝔪 :=
      lt_of_le_of_ne h_le_𝔪 (fun heq => h_not_max (heq ▸ h𝔪_max))
    obtain ⟨x_m, hx_m, hx_not_p⟩ := SetLike.exists_of_lt h_lt_𝔪
    let mk_q : B₁₂ →+* (B₁₂ ⧸ p_V i) := Ideal.Quotient.mk (p_V i)
    let M_q : Ideal (B₁₂ ⧸ p_V i) := Ideal.map mk_q 𝔪
    haveI : 𝔪.IsPrime := h𝔪_max.isPrime
    have hM_prime : M_q.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
    haveI : IsDomain (B₁₂ ⧸ p_V i) :=
      (Ideal.Quotient.isDomain_iff_prime (p_V i)).mpr inferInstance
    let P₀_q : PrimeSpectrum (B₁₂ ⧸ p_V i) := ⟨⊥, hBotPrime (B₁₂ ⧸ p_V i)⟩
    let P₁_q : PrimeSpectrum (B₁₂ ⧸ p_V i) := ⟨M_q, hM_prime⟩
    have hP_lt : P₀_q < P₁_q := by
      refine lt_of_le_not_ge (bot_le : (⊥ : Ideal (B₁₂ ⧸ p_V i)) ≤ M_q) ?_
      intro hge
      have hx_in_bot : mk_q x_m ∈ (⊥ : Ideal (B₁₂ ⧸ p_V i)) :=
        hge (Ideal.mem_map_of_mem mk_q hx_m)
      rw [Ideal.mem_bot] at hx_in_bot
      exact hx_not_p (Ideal.Quotient.eq_zero_iff_mem.mp hx_in_bot)
    let ser : LTSeries (PrimeSpectrum (B₁₂ ⧸ p_V i)) :=
      { length := 1
        toFun := ![P₀_q, P₁_q]
        step := fun s => by fin_cases s; exact hP_lt }
    have h_ge1 : (1 : WithBot ℕ∞) ≤ ringKrullDim (B₁₂ ⧸ p_V i) :=
      Order.LTSeries.length_le_krullDim ser
    exact le_antisymm h_le1 h_ge1

  
  · intro B₀ B_s _ _ _ _ φ_s m_rk hm_rk j_s hDim₀ hj_open hVs_range hb
    obtain ⟨hFin_φ, _, _, _, hGoUp⟩ := hAlgChart B₀ B_s φ_s m_rk hm_rk hDim₀ hb
    have hMinInVs := hChartMinInVs B₀ B_s φ_s m_rk hm_rk j_s hDim₀ hj_open hb
    obtain ⟨_, Φ, hΦ_base, hΦ_inj, hΦ_min_iff, hΦ_min_surj, hΦ_len⟩ :=
      hOpenChart B_s j_s hj_open hVs_range hMinInVs
    let pt_V : Fin c → PrimeSpectrum B₁₂ :=
      fun i => ⟨p_V i, (hp_V_range ▸ Set.mem_range_self i).1.1⟩
    let p_B : Fin c → Ideal B_s := fun i => (Φ (pt_V i)).asIdeal
    have hp_B_inj : Function.Injective p_B := by
      intro i₁ i₂ heq
      have hspec : Φ (pt_V i₁) = Φ (pt_V i₂) := PrimeSpectrum.ext heq
      exact hp_V_inj (congrArg PrimeSpectrum.asIdeal (hΦ_inj hspec))
    have hp_B_range : Set.range p_B = minimalPrimes B_s := by
      ext I
      constructor
      · rintro ⟨i, rfl⟩
        exact (hΦ_min_iff (pt_V i)).mp (hp_V_range ▸ Set.mem_range_self i)
      · intro hI
        obtain ⟨p, hp_min, hp_eq⟩ := hΦ_min_surj ⟨I, hI.1.1⟩ hI
        rw [← hp_V_range] at hp_min
        obtain ⟨i, hi_eq⟩ := hp_min
        have hpt_eq : pt_V i = p := PrimeSpectrum.ext hi_eq
        refine ⟨i, ?_⟩
        dsimp [p_B]
        rw [hpt_eq, hp_eq]
    refine ⟨p_B, hp_B_inj, hp_B_range, ?_⟩
    intro i
    have hptB_eq : (⟨p_B i, (hp_B_range ▸ Set.mem_range_self i).1.1⟩ : PrimeSpectrum B_s) =
        Φ (pt_V i) :=
      PrimeSpectrum.ext rfl
    refine ⟨?_, ?_, hFin_φ, ?_⟩
    · rw [hptB_eq]
      exact hΦ_base (pt_V i)
    · exact (hGoUp (p_B i) (hp_B_range ▸ Set.mem_range_self i)).1
    · exact congrArg ENat.toNat (hΦ_len (pt_V i))

  
  · intro s_cond hs_cond
    have h_sep : ∀ (i j : Fin c), j ≠ i → ∃ u : B₁₂, u ∈ p_V j ∧ u ∉ p_V i := by
      intro i j hji
      by_contra h_all
      have hle : p_V j ≤ p_V i := fun u hu => by_contra fun hu_not => h_all ⟨u, hu, hu_not⟩
      have hp_i : p_V i ∈ minimalPrimes B₁₂ := hp_V_range ▸ Set.mem_range_self i
      have hp_j : p_V j ∈ minimalPrimes B₁₂ := hp_V_range ▸ Set.mem_range_self j
      have hge : p_V i ≤ p_V j := hp_i.2 ⟨hp_j.1.1, bot_le⟩ hle
      exact hji (hp_V_inj (le_antisymm hle hge))
    let u_elem : Fin c → Fin c → B₁₂ :=
      fun i j => if h : j ≠ i then Classical.choose (h_sep i j h) else 1
    let u_prod : Fin c → B₁₂ :=
      fun i => Finset.prod (Finset.univ.erase i) (fun j => u_elem i j)
    let g_open : Fin c → B₁₂ := fun i => s_cond i * u_prod i
    have hg_props : ∀ i : Fin c,
        g_open i ∉ p_V i ∧
        (∃ u_i : B₁₂, g_open i = s_cond i * u_i) ∧
        (∀ j : Fin c, j ≠ i → g_open i ∈ p_V j) := by
      intro i
      have hp_i : p_V i ∈ minimalPrimes B₁₂ := hp_V_range ▸ Set.mem_range_self i
      have hp_i_prime : (p_V i).IsPrime := hp_i.1.1
      refine ⟨?_, ⟨u_prod i, rfl⟩, ?_⟩
      · intro hmem
        have hu_mem : u_prod i ∈ p_V i :=
          (hp_i_prime.mul_mem_iff_mem_or_mem.mp hmem).resolve_left (hs_cond i)
        obtain ⟨j, hj_erase, hj_mem⟩ := hp_i_prime.prod_mem_iff.mp hu_mem
        have hji : j ≠ i := Finset.ne_of_mem_erase hj_erase
        have hueq : u_elem i j = Classical.choose (h_sep i j hji) := by simp [u_elem, hji]
        rw [hueq] at hj_mem
        exact (Classical.choose_spec (h_sep i j hji)).2 hj_mem
      · intro j hji
        have hj_erase : j ∈ Finset.univ.erase i :=
          Finset.mem_erase.mpr ⟨hji, Finset.mem_univ j⟩
        obtain ⟨w, hw⟩ := Finset.dvd_prod_of_mem (fun r => u_elem i r) hj_erase
        have hueq : u_elem i j = Classical.choose (h_sep i j hji) := by simp [u_elem, hji]
        have hu_j : u_elem i j ∈ p_V j := by
          rw [hueq]
          exact (Classical.choose_spec (h_sep i j hji)).1
        have hg_eq : g_open i = u_elem i j * (s_cond i * w) := by
          dsimp [g_open, u_prod]
          rw [hw]
          ring
        rw [hg_eq]
        exact (p_V j).mul_mem_right _ hu_j
    have hBasicMem : ∀ (x : ↥C_s) (hxV : x ∈ V_s) (f_sec : B₁₂),
        x ∈ C_s.basicOpen f_sec ↔ f_sec ∉ (hAff_Vs.primeIdealOf ⟨x, hxV⟩).asIdeal := by
      intro x hxV f_sec
      let q_x := hAff_Vs.primeIdealOf ⟨x, hxV⟩
      have hfrom_x : hAff_Vs.fromSpec.base q_x = x := hAff_Vs.fromSpec_primeIdealOf ⟨x, hxV⟩
      have hpre := hAff_Vs.fromSpec_preimage_basicOpen f_sec
      have hiff : q_x ∈ (TopologicalSpace.Opens.map hAff_Vs.fromSpec.base).obj
          (C_s.basicOpen f_sec) ↔ q_x ∈ PrimeSpectrum.basicOpen f_sec :=
        Eq.to_iff (congrArg (q_x ∈ ·) hpre)
      rw [PrimeSpectrum.mem_basicOpen] at hiff
      change hAff_Vs.fromSpec.base q_x ∈ C_s.basicOpen f_sec ↔ f_sec ∉ q_x.asIdeal at hiff
      rwa [hfrom_x] at hiff
    let V'_comp : Fin c → C_s.Opens := fun i => C_s.basicOpen (g_open i)
    refine ⟨g_open, hg_props, ?_, ?_, ?_⟩
    · 
      intro i j hij
      rw [disjoint_iff_inf_le]
      rintro x ⟨hxi, hxj⟩
      have hxV : x ∈ V_s := C_s.basicOpen_le (g_open i) hxi
      let q_x := hAff_Vs.primeIdealOf ⟨x, hxV⟩
      have hgi_not : g_open i ∉ q_x.asIdeal := (hBasicMem x hxV (g_open i)).mp hxi
      have hgj_not : g_open j ∉ q_x.asIdeal := (hBasicMem x hxV (g_open j)).mp hxj
      obtain ⟨𝔭, h𝔭_min, h𝔭_le⟩ :=
        Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal B₁₂) ≤ q_x.asIdeal)
      change 𝔭 ∈ minimalPrimes B₁₂ at h𝔭_min
      rw [← hp_V_range] at h𝔭_min
      obtain ⟨r, rfl⟩ := h𝔭_min
      by_cases hri : r = i
      · subst hri
        exact False.elim (hgj_not (h𝔭_le ((hg_props j).2.2 r hij)))
      · exact False.elim (hgi_not (h𝔭_le ((hg_props i).2.2 r hri)))
    · 
      exact iSup_le (fun i => C_s.basicOpen_le (g_open i))
    · 
      let V'_s : C_s.Opens := ⨆ i : Fin c, V'_comp i
      rw [hComplDimZero V'_s]
      intro T₁ T₂ hT_lt hT₂_sub
      let x₂ : ↥C_s := T₂.isIrreducible.genericPoint
      have hcl_x₂ : closure ({x₂} : Set ↥C_s) = (T₂ : Set ↥C_s) :=
        (T₂.isIrreducible.isGenericPoint_genericPoint T₂.isClosed).def
      have hx₂_T₂ : x₂ ∈ (T₂ : Set ↥C_s) := hcl_x₂ ▸ subset_closure rfl
      have hx₂_Vs : x₂ ∈ V_s := by
        by_contra hx₂_not_Vs
        have hT₂_compl_Vs : (T₂ : Set ↥C_s) ⊆ (V_s : Set ↥C_s)ᶜ := by
          rw [← hcl_x₂]
          exact closure_minimal (Set.singleton_subset_iff.mpr hx₂_not_Vs)
            V_s.isOpen.isClosed_compl
        exact ((hComplDimZero V_s).mp hDim_Zs) T₁ T₂ hT_lt hT₂_compl_Vs
      have hx₂_not_closed : ¬ IsClosed ({x₂} : Set ↥C_s) := by
        intro hCl
        have hT₂_sing : (T₂ : Set ↥C_s) = {x₂} := by
          rw [← hcl_x₂, hCl.closure_eq]
        obtain ⟨x₁, hx₁_T₁⟩ := T₁.isIrreducible.nonempty
        have hx₁_T₂ : x₁ ∈ (T₂ : Set ↥C_s) := (le_of_lt hT_lt) hx₁_T₁
        rw [hT₂_sing, Set.mem_singleton_iff] at hx₁_T₂
        subst hx₁_T₂
        apply not_le_of_gt hT_lt
        intro z hz
        change z ∈ (T₂ : Set ↥C_s) at hz
        rw [hT₂_sing, Set.mem_singleton_iff] at hz
        subst hz
        exact hx₁_T₁
      let q₂ : PrimeSpectrum B₁₂ := hAff_Vs.primeIdealOf ⟨x₂, hx₂_Vs⟩
      have hfrom_q₂ : hAff_Vs.fromSpec.base q₂ = x₂ :=
        hAff_Vs.fromSpec_primeIdealOf ⟨x₂, hx₂_Vs⟩
      have hq₂_not_max : ¬ q₂.asIdeal.IsMaximal := by
        intro hMax
        have hq₂_eq : (⟨q₂.asIdeal, hMax.isPrime⟩ : PrimeSpectrum B₁₂) = q₂ :=
          PrimeSpectrum.ext rfl
        have hCl := hMaxClosed q₂.asIdeal hMax
        rw [hq₂_eq, hfrom_q₂] at hCl
        exact hx₂_not_closed hCl
      obtain ⟨𝔪₂, h𝔪₂_max, hq₂_le_𝔪₂⟩ :=
        Ideal.exists_le_maximal q₂.asIdeal (Ideal.IsPrime.ne_top q₂.isPrime)
      have hq₂_lt_𝔪₂ : q₂ < ⟨𝔪₂, h𝔪₂_max.isPrime⟩ :=
        lt_of_le_of_ne hq₂_le_𝔪₂ (fun heq =>
          hq₂_not_max ((congrArg PrimeSpectrum.asIdeal heq) ▸ h𝔪₂_max))
      obtain ⟨𝔭₂, h𝔭₂_min, h𝔭₂_le_q₂⟩ :=
        Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal B₁₂) ≤ q₂.asIdeal)
      have h𝔭₂_eq_q₂ : 𝔭₂ = q₂.asIdeal := by
        by_contra hne
        have hlt₁ : (⟨𝔭₂, h𝔭₂_min.1.1⟩ : PrimeSpectrum B₁₂) < q₂ :=
          lt_of_le_of_ne h𝔭₂_le_q₂ (fun h => hne (congrArg PrimeSpectrum.asIdeal h))
        let ser₂ : LTSeries (PrimeSpectrum B₁₂) :=
          { length := 2
            toFun := ![⟨𝔭₂, h𝔭₂_min.1.1⟩, q₂, ⟨𝔪₂, h𝔪₂_max.isPrime⟩]
            step := fun s => by
              fin_cases s
              · exact hlt₁
              · exact hq₂_lt_𝔪₂ }
        have h2 : (2 : WithBot ℕ∞) ≤ ringKrullDim B₁₂ :=
          Order.LTSeries.length_le_krullDim ser₂
        have h21 : (2 : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) := le_trans h2 hDim_B12
        exact absurd h21 (by decide)
      have hq₂_min : q₂.asIdeal ∈ minimalPrimes B₁₂ := h𝔭₂_eq_q₂ ▸ h𝔭₂_min
      rw [← hp_V_range] at hq₂_min
      obtain ⟨i₀, hi₀_eq⟩ := hq₂_min
      have hx₂_basic : x₂ ∈ V'_comp i₀ := by
        apply (hBasicMem x₂ hx₂_Vs (g_open i₀)).mpr
        rw [← hi₀_eq]
        exact (hg_props i₀).1
      have hx₂_V's : x₂ ∈ V'_s := (le_iSup V'_comp i₀) hx₂_basic
      exact hT₂_sub hx₂_T₂ hx₂_V's

theorem weil_curve_artinian_mult_and_smooth_norm_valuation (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (P₁_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
       [AlgebraicGeometry.IsProper P₁_ov.hom]
       [AlgebraicGeometry.IsIntegral P₁_ov.left]
       [AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁_ov.hom]
       (_hProj_P1 : IsProjectiveOverField k P₁_ov)
       (ι_1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) P₁_ov.left),
       AlgebraicGeometry.IsOpenImmersion ι_1 →
       CategoryTheory.CategoryStruct.comp ι_1 P₁_ov.hom =
         AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) →
       ∀ (C_s : AlgebraicGeometry.Scheme.{u})
         (V_s : C_s.Opens)
         (g₁_s g₂_s : Quiver.Hom C_s P₁_ov.left)
         (q₁ q₂ : Polynomial k) (m₁ m₂ : ℕ)
         (U₁_s U₂_s : P₁_ov.left.Opens)
         (iso_U₁ : CategoryTheory.Iso U₁_s.toScheme
           (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away q₁))))
         (iso_U₂ : CategoryTheory.Iso U₂_s.toScheme
           (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away q₂))))
         (B₁_s B₂_s : Type u) [CommRing B₁_s] [CommRing B₂_s]
         (φ₁_s : Localization.Away q₁ →+* B₁_s)
         (φ₂_s : Localization.Away q₂ →+* B₂_s)
         (j₁_s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₁_s)) C_s)
         (j₂_s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₂_s)) C_s),
         AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp g₁_s P₁_ov.hom) →
         CategoryTheory.CategoryStruct.comp g₁_s P₁_ov.hom =
           CategoryTheory.CategoryStruct.comp g₂_s P₁_ov.hom →
         topologicalKrullDim C_s ≤ (1 : WithBot ℕ∞) →
         topologicalKrullDim (weilAltClosedComplIdeal C_s V_s).subscheme ≤ (0 : WithBot ℕ∞) →
         AlgebraicGeometry.IsAffineOpen V_s →
