        exact congrArg (fun ψ : W ⟶ F₃ => (ψ.hom.app (Opposite.op U)).hom w) hk
      let lift_hom : ∀ {W : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (k_h : W ⟶ F₂),
          CategoryTheory.CategoryStruct.comp k_h g = 0 → (W ⟶ F₁) := fun {W} k_h hk =>
        ⟨{ app := fun opU => AddCommGrpCat.ofHom
            { toFun := fun w => Classical.choose (hLift_ex k_h hk opU.unop w)
              map_zero' := by
                apply hInj opU.unop
                rw [Classical.choose_spec (hLift_ex k_h hk opU.unop 0), map_zero, map_zero]
              map_add' := fun w₁ w₂ => by
                apply hInj opU.unop
                rw [Classical.choose_spec (hLift_ex k_h hk opU.unop (w₁ + w₂)),
                  map_add, map_add,
                  Classical.choose_spec (hLift_ex k_h hk opU.unop w₁),
                  Classical.choose_spec (hLift_ex k_h hk opU.unop w₂)] }
           naturality := fun {opU₁ opU₂} q => by
             apply AddCommGrpCat.hom_ext
             ext w
             apply hInj opU₂.unop
             change (f.hom.app opU₂).hom (Classical.choose (hLift_ex k_h hk opU₂.unop ((W.obj.map q).hom w))) =
               (f.hom.app opU₂).hom ((F₁.obj.map q).hom (Classical.choose (hLift_ex k_h hk opU₁.unop w)))
             have hnat_f := congrArg (fun ψ => ψ.hom (Classical.choose (hLift_ex k_h hk opU₁.unop w)))
               (f.hom.naturality q)
             have hnat_k := congrArg (fun ψ => ψ.hom w) (k_h.hom.naturality q)
             change (f.hom.app opU₂).hom ((F₁.obj.map q).hom _) =
               (F₂.obj.map q).hom ((f.hom.app opU₁).hom _) at hnat_f
             change (k_h.hom.app opU₂).hom ((W.obj.map q).hom w) =
               (F₂.obj.map q).hom ((k_h.hom.app opU₁).hom w) at hnat_k
             rw [Classical.choose_spec (hLift_ex k_h hk opU₂.unop _), hnat_f, hnat_k,
               Classical.choose_spec (hLift_ex k_h hk opU₁.unop w)] }⟩
      have h_fac : ∀ {W : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (k_h : W ⟶ F₂)
