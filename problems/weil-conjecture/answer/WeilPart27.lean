            (Algebra.TensorProduct.map (AlgHom.id F F) (ψ_comp i))
            ((Algebra.TensorProduct.cancelBaseChange B₀ F R' R' B_s).symm
              (Algebra.TensorProduct.map ι_R (AlgHom.id B₀ B_s) w)))
        z (fun _ _ => rfl)
        (fun x y ihx ihy => by
          rw [map_add, map_add, map_add, map_add, map_add, map_add, ihx, ihy])
    rw [hRHS_i]
    let z_i := Algebra.TensorProduct.map (AlgHom.id R' R')
      (Pi.evalAlgHom F (fun j => Localization.AtPrime (p_min j)) i) (E_Φ z_F)
    change Algebra.norm R' z_i = _
    rw [s5_localArtinian F R' (Localization.AtPrime (p_min i)) z_i, ← he_def i]
    congr 1
    let E_θi := Algebra.TensorProduct.congr (AlgEquiv.refl : R' ≃ₐ[R'] R') (θ i)
    have hNormθ : Algebra.norm R'
        (E_θi (Algebra.TensorProduct.map (AlgHom.id R' R')
          (Ideal.Quotient.mkₐ F
            (IsLocalRing.maximalIdeal (Localization.AtPrime (p_min i)))) z_i)) =
        Algebra.norm R'
          (Algebra.TensorProduct.map (AlgHom.id R' R')
            (Ideal.Quotient.mkₐ F
              (IsLocalRing.maximalIdeal (Localization.AtPrime (p_min i)))) z_i) :=
      @Algebra.norm_eq_of_algEquiv R'
        (TensorProduct F R'
          (Localization.AtPrime (p_min i) ⧸
            IsLocalRing.maximalIdeal (Localization.AtPrime (p_min i))))
        (TensorProduct F R' (TensorProduct B₀ F (B_norm i)))
        _ _ _ _ _ E_θi _
    rw [← hNormθ]
    congr 1
    have hComm_i : ∀ u_F : TensorProduct F R' (TensorProduct B₀ F B_s),
        E_θi (Algebra.TensorProduct.map (AlgHom.id R' R')
          (Ideal.Quotient.mkₐ F
            (IsLocalRing.maximalIdeal (Localization.AtPrime (p_min i))))
          (Algebra.TensorProduct.map (AlgHom.id R' R')
            (Pi.evalAlgHom F (fun j => Localization.AtPrime (p_min j)) i) (E_Φ u_F))) =
        Algebra.TensorProduct.map (AlgHom.id R' R')
          (Algebra.TensorProduct.map (AlgHom.id F F) (ψ_comp i)) u_F := by
      intro u_F
      refine TensorProduct.inductionOn
        (motive := fun u_F =>
          E_θi (Algebra.TensorProduct.map (AlgHom.id R' R')
            (Ideal.Quotient.mkₐ F
              (IsLocalRing.maximalIdeal (Localization.AtPrime (p_min i))))
            (Algebra.TensorProduct.map (AlgHom.id R' R')
              (Pi.evalAlgHom F (fun j => Localization.AtPrime (p_min j)) i) (E_Φ u_F))) =
          Algebra.TensorProduct.map (AlgHom.id R' R')
            (Algebra.TensorProduct.map (AlgHom.id F F) (ψ_comp i)) u_F)
        u_F (fun r' w => ?_)
        (fun x y ihx ihy => by rw [map_add, map_add, map_add, map_add, map_add, ihx, ihy])
      change r' ⊗ₜ[F] θ i (Ideal.Quotient.mkₐ F
          (IsLocalRing.maximalIdeal (Localization.AtPrime (p_min i))) (Φ_gen w i)) =
        r' ⊗ₜ[F] Algebra.TensorProduct.map (AlgHom.id F F) (ψ_comp i) w
      rw [hΨ_eq i w]
    exact hComm_i z_F
  exact @s6_assemble (FractionRing B₀) _ _ _ hPrime_p

