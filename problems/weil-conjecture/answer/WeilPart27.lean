        m_g.hom.naturality (Opposite.op (hT₂.from ((weilEtaleSitePullback f).obj T₃)))
      have hmg_app : adj_c₂.unit.app Aℤ ≫ m_g.hom.app (Opposite.op T₂) =
          adj_c₁.unit.app Aℤ ≫ Fℤ₁.obj.map
            (Opposite.op (hT₁.from ((weilEtaleSitePullback g).obj T₂))) := by
        have h1 : adj_c₂.unit.app Aℤ ≫ m_g.hom.app (Opposite.op T₂) =
