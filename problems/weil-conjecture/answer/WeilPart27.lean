    have hg2 := TopCat.Presheaf.germ_res_apply W.presheaf
      (CategoryTheory.homOfLE (le_top : W_x.ι ''ᵁ ⊤ ≤ ⊤)) x hx' s₂_sec
    exact hg1.symm.trans
      ((congrArg (W.presheaf.germ (W_x.ι ''ᵁ ⊤) x hx').hom h_appTop_eq).trans hg2)

theorem weil_zero_bdry_open_isFinite_higherDirectImage_isZero (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (Z₁ Z₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z₁.hom] [AlgebraicGeometry.IsProper Z₂.hom]
    (f : Quiver.Hom Z₁.left Z₂.left)
    (hf_over : CategoryTheory.CategoryStruct.comp f Z₂.hom = Z₁.hom)
    (O₂ : Z₂.left.Opens) (O₁ : Z₁.left.Opens)
    (hO₁ : O₁ = (TopologicalSpace.Opens.map f.base).obj O₂)
    (hFin : AlgebraicGeometry.IsFinite (f ∣_ O₂))
    (hSh_zero : CategoryTheory.Presheaf.IsSheaf Z₁.left.smallEtaleTopology
      (weilAltZeroBdrySubpresheaf Z₁.left O₁ n))
    (s : ℕ) (hs : 1 ≤ s) :
    CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage f s ⟨weilAltZeroBdrySubpresheaf Z₁.left O₁ n, hSh_zero⟩) :=
by
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
  let K₁ : CategoryTheory.Sheaf Z₁.left.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilAltZeroBdrySubpresheaf Z₁.left O₁ n, hSh_zero⟩

  
  have hn_K₁ : n • CategoryTheory.CategoryStruct.id K₁ = 0 := by
    have h_nsmul_down : ∀ (m₀ : ℕ) (U : Z₁.left.Etale)
        (σ : ↥(weilAltZeroBdrySubgroup Z₁.left O₁ n U))
        (x : ↥((AlgebraicGeometry.Scheme.Etale.forget Z₁.left).obj U).left),
        (((((m₀ • CategoryTheory.CategoryStruct.id K₁).hom.app (Opposite.op U)) σ) :
          ↥(weilAltZeroBdrySubgroup Z₁.left O₁ n U)).1 x).down = m₀ • (σ.1 x).down := by
      intro m₀ U σ x
      induction m₀ with
      | zero =>
        rw [zero_smul, zero_smul]
        rfl
      | succ m₀ ih =>
        rw [succ_nsmul, succ_nsmul]
        exact congrArg (· + (σ.1 x).down) ih
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext U_op
    induction U_op using Opposite.rec with
    | op U =>
      apply AddCommGrpCat.ext
      intro σ
      let σ₀ : ↥(weilAltZeroBdrySubgroup Z₁.left O₁ n U) := σ
      let lhs : ↥(weilAltZeroBdrySubgroup Z₁.left O₁ n U) :=
        ((n • CategoryTheory.CategoryStruct.id K₁).hom.app (Opposite.op U)) σ₀
      change lhs = (0 : ↥(weilAltZeroBdrySubgroup Z₁.left O₁ n U))
      apply Subtype.ext
      apply LocallyConstant.ext
      intro x
      apply ULift.ext
      change (lhs.1 x).down = 0
      rw [h_nsmul_down n U σ₀ x, nsmul_eq_mul, ZMod.natCast_self, zero_mul]

  have hDisj_K₁ : ∀ {W : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom W Z₁.left)
      (F_W : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      Disjoint (Set.range i.base) (O₁ : Set ↥Z₁.left) →
      WeilIsEtaleSheafPullback i K₁ F_W →
      CategoryTheory.Limits.IsZero F_W := by
    intro W i F_W hDisj hPb
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_i : CategoryTheory.Functor Z₁.left.Etale W.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    rcases hPb with ⟨hc, hr, ⟨e_iso⟩⟩
    let pf_i := B_i.sheafPushforwardContinuous AddCommGrpCat.{u}
      Z₁.left.smallEtaleTopology W.smallEtaleTopology
    let pb_i := B_i.sheafPullback AddCommGrpCat.{u}
      Z₁.left.smallEtaleTopology W.smallEtaleTopology
    let adj_i := B_i.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z₁.left.smallEtaleTopology W.smallEtaleTopology
    refine CategoryTheory.Limits.IsZero.of_iso ?_ e_iso.symm
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    let α : K₁ ⟶ pf_i.obj (pb_i.obj K₁) := adj_i.unit.app K₁
    have hα_zero : α = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      induction U_op using Opposite.rec with
      | op U =>
        apply AddCommGrpCat.ext
        intro σ
        let FgtZ := AlgebraicGeometry.Scheme.Etale.forget Z₁.left
        let U_sch : AlgebraicGeometry.Scheme.{u} := (FgtZ.obj U).left
        let u_hom : U_sch ⟶ Z₁.left := (FgtZ.obj U).hom
        have _ : AlgebraicGeometry.Etale u_hom := U.prop
        let V₀ : U_sch.Opens :=
          ⟨{ x : ↥U_sch | σ.1 x = 0 }, σ.1.isLocallyConstant {0}⟩
        let U₀ : Z₁.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (V₀.ι ≫ u_hom) inferInstance
        let j₀ : U₀ ⟶ U :=
          CategoryTheory.MorphismProperty.Over.homMk V₀.ι rfl
        have hσ_j₀ : (K₁.obj.map j₀.op) σ = 0 := by
          apply Subtype.ext
          apply LocallyConstant.ext
          intro y
          change σ.1 (V₀.ι.base y) = 0
          exact y.2
        have h_nat := congrArg (fun φ : K₁.obj.obj (Opposite.op U) ⟶
            (pf_i.obj (pb_i.obj K₁)).obj.obj (Opposite.op U₀) => φ σ)
          (α.hom.naturality j₀.op)
        dsimp at h_nat
        rw [hσ_j₀, map_zero] at h_nat
        let z_U : ↑((pb_i.obj K₁).obj.obj (Opposite.op (B_i.obj U))) :=
          (α.hom.app (Opposite.op U)) σ
        have h_pb_map_zero : ((pb_i.obj K₁).obj.map (B_i.map j₀).op) z_U = 0 :=
          h_nat.symm
        let pr₁ : CategoryTheory.Limits.pullback u_hom i ⟶ U_sch :=
          CategoryTheory.Limits.pullback.fst u_hom i
        let pr₂ : CategoryTheory.Limits.pullback u_hom i ⟶ W :=
          CategoryTheory.Limits.pullback.snd u_hom i
        have h_range : Set.range pr₁.base ⊆ Set.range V₀.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨p, rfl⟩
          change σ.1 (pr₁.base p) = 0
          apply σ.2
          have h_cond : u_hom.base (pr₁.base p) = i.base (pr₂.base p) := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.Limits.pullback.condition,
              AlgebraicGeometry.Scheme.Hom.comp_apply]
          rw [h_cond]
          exact Set.disjoint_left.mp hDisj ⟨pr₂.base p, rfl⟩
        let l : CategoryTheory.Limits.pullback u_hom i ⟶ V₀.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift V₀.ι pr₁ h_range
        have hl : l ≫ V₀.ι = pr₁ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac V₀.ι pr₁ h_range
        have h_lift_cond : l ≫ (V₀.ι ≫ u_hom) = pr₂ ≫ i := by
          rw [← CategoryTheory.Category.assoc, hl, CategoryTheory.Limits.pullback.condition]
        let inv_sch : CategoryTheory.Limits.pullback u_hom i ⟶
            CategoryTheory.Limits.pullback (V₀.ι ≫ u_hom) i :=
          CategoryTheory.Limits.pullback.lift l pr₂ h_lift_cond
        let inv_et : B_i.obj U ⟶ B_i.obj U₀ :=
          CategoryTheory.MorphismProperty.Over.homMk inv_sch
            (CategoryTheory.Limits.pullback.lift_snd l pr₂ h_lift_cond)
        have h_map_fst : (B_i.map j₀).left ≫ pr₁ =
            CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) i ≫ V₀.ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h_map_snd : (B_i.map j₀).left ≫ pr₂ =
            CategoryTheory.Limits.pullback.snd (V₀.ι ≫ u_hom) i :=
          CategoryTheory.MorphismProperty.Over.w (B_i.map j₀)
        have h_inv_fst : (inv_sch ≫ (B_i.map j₀).left) ≫ pr₁ =
            CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.pullback u_hom i) ≫ pr₁ :=
          (CategoryTheory.Category.assoc inv_sch (B_i.map j₀).left pr₁).trans
            ((congrArg (inv_sch ≫ ·) h_map_fst).trans
              ((CategoryTheory.Category.assoc inv_sch
                  (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ u_hom) i) V₀.ι).symm.trans
                ((congrArg (· ≫ V₀.ι)
                    (CategoryTheory.Limits.pullback.lift_fst l pr₂ h_lift_cond)).trans
                  (hl.trans (CategoryTheory.Category.id_comp pr₁).symm))))
        have h_inv_snd : (inv_sch ≫ (B_i.map j₀).left) ≫ pr₂ =
            CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.pullback u_hom i) ≫ pr₂ :=
          (CategoryTheory.Category.assoc inv_sch (B_i.map j₀).left pr₂).trans
            ((congrArg (inv_sch ≫ ·) h_map_snd).trans
              ((CategoryTheory.Limits.pullback.lift_snd l pr₂ h_lift_cond).trans
                (CategoryTheory.Category.id_comp pr₂).symm))
        have h_inv_left : inv_sch ≫ (B_i.map j₀).left =
            CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.pullback u_hom i) :=
          CategoryTheory.Limits.pullback.hom_ext h_inv_fst h_inv_snd
        have h_ret : inv_et ≫ B_i.map j₀ = CategoryTheory.CategoryStruct.id (B_i.obj U) :=
          CategoryTheory.MorphismProperty.Over.Hom.ext h_inv_left
        have h_op : (B_i.map j₀).op ≫ inv_et.op = 𝟙 (Opposite.op (B_i.obj U)) := by
          rw [← op_comp, h_ret, op_id]
        have h1 : ((pb_i.obj K₁).obj.map (𝟙 (Opposite.op (B_i.obj U)))) z_U = z_U := by
          rw [CategoryTheory.Functor.map_id]
          rfl
        have h2 : ((pb_i.obj K₁).obj.map ((B_i.map j₀).op ≫ inv_et.op)) z_U = 0 := by
          rw [CategoryTheory.Functor.map_comp]
          change ((pb_i.obj K₁).obj.map inv_et.op)
            (((pb_i.obj K₁).obj.map (B_i.map j₀).op) z_U) = 0
          rw [h_pb_map_zero, map_zero]
        rw [h_op] at h2
        exact h1.symm.trans h2
    have h_id_symm : (adj_i.homEquiv K₁ (pb_i.obj K₁)).symm α = 𝟙 (pb_i.obj K₁) := by
      rw [CategoryTheory.Adjunction.homEquiv_counit]
      exact adj_i.left_triangle_components K₁
    have h_zero_symm : (adj_i.homEquiv K₁ (pb_i.obj K₁)).symm 0 = 0 := by
      let _ : CategoryTheory.Limits.PreservesColimitsOfSize pb_i :=
        adj_i.leftAdjoint_preservesColimits
      rw [CategoryTheory.Adjunction.homEquiv_counit, CategoryTheory.Functor.map_zero,
        CategoryTheory.Limits.zero_comp]
    rw [← h_id_symm, hα_zero, h_zero_symm]

  
  have hHDI_zero_and_mid : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (g_mor : Quiver.Hom X S),
      (∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Limits.IsZero F →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g_mor s F)) ∧
      (∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})),
        SC.ShortExact →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g_mor s SC.X₁) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g_mor s SC.X₃) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g_mor s SC.X₂)) := by
    intro X S g_mor
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_mor :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) g_mor :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_g : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_mor
    let F_coh := CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology s
    let F_wh := (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj B_g.op
    let F_sh := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have _ : F_coh.PreservesZeroMorphisms :=
      ⟨fun A B => by
        apply CategoryTheory.NatTrans.ext
        funext V
        induction V using Opposite.rec with
        | op V₀ =>
          apply AddCommGrpCat.ext
          intro x
          change ((CategoryTheory.Abelian.Ext.mk₀ (0 : A ⟶ B)).postcomp
            (weilPolyP1CohomologyRepSheaf X V₀) (Nat.add_zero s)) x = 0
          simp
          rfl⟩
    have _ : F_wh.PreservesZeroMorphisms :=
      ⟨fun A B => by
        apply CategoryTheory.NatTrans.ext
        funext U
        rfl⟩
    let _ : CategoryTheory.Limits.PreservesColimitsOfSize F_sh :=
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
        AddCommGrpCat.{u}).leftAdjoint_preservesColimits
    let F_psh := F_coh ⋙ F_wh
    let F_hdi := F_psh ⋙ F_sh
    constructor
    · intro F hF
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero] at hF ⊢
      change 𝟙 (F_hdi.obj F) = 0
      rw [← F_hdi.map_id, hF, F_hdi.map_zero]
    · intro SC hSC hZ₁ hZ₃
      let SC_psh := SC.map F_psh
      have hEx_psh : SC_psh.Exact := by
        rw [CategoryTheory.ShortComplex.exact_iff_isZero_homology]
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        apply CategoryTheory.NatTrans.ext
        funext U
        induction U using Opposite.rec with
        | op U₀ =>
          let ev_U := (CategoryTheory.evaluation (Opposite S.Etale)
            AddCommGrpCat.{u}).obj (Opposite.op U₀)
          let Y_U := weilPolyP1CohomologyRepSheaf X (B_g.obj U₀)
          have hEx_U : (SC_psh.map ev_U).Exact :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' Y_U hSC s
          rw [CategoryTheory.ShortComplex.exact_iff_isZero_homology] at hEx_U
          have hZero_U : CategoryTheory.Limits.IsZero (SC_psh.homology.obj (Opposite.op U₀)) :=
            CategoryTheory.Limits.IsZero.of_iso hEx_U
              (CategoryTheory.ShortComplex.mapHomologyIso SC_psh ev_U).symm
          exact hZero_U.eq_of_src _ _
      let SC_sh := SC_psh.map F_sh
      have hEx_sh : SC_sh.Exact := hEx_psh.map F_sh
      have hZ₁' : CategoryTheory.Limits.IsZero SC_sh.X₁ := hZ₁
      have hZ₃' : CategoryTheory.Limits.IsZero SC_sh.X₃ := hZ₃
      have hf0 : SC_sh.f = 0 := hZ₁'.eq_of_src _ _
      have hg0 : SC_sh.g = 0 := hZ₃'.eq_of_tgt _ _
      exact hEx_sh.isZero_X₂ hf0 hg0

  have hDevissage : ∀ (m ℓ : ℕ), ℓ ∣ m →
      ∀ (F : CategoryTheory.Sheaf Z₁.left.smallEtaleTopology AddCommGrpCat.{u}),
        m • CategoryTheory.CategoryStruct.id F = 0 →
        (∀ {W : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom W Z₁.left)
          (F_W : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
          Disjoint (Set.range i.base) (O₁ : Set ↥Z₁.left) →
          WeilIsEtaleSheafPullback i F F_W →
          CategoryTheory.Limits.IsZero F_W) →
        ∃ SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf Z₁.left.smallEtaleTopology AddCommGrpCat.{u}),
          SC.ShortExact ∧
          SC.X₂ = F ∧
          ℓ • CategoryTheory.CategoryStruct.id SC.X₁ = 0 ∧
          (m / ℓ) • CategoryTheory.CategoryStruct.id SC.X₃ = 0 ∧
          (∀ {W : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom W Z₁.left)
            (G₁ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
            Disjoint (Set.range i.base) (O₁ : Set ↥Z₁.left) →
            WeilIsEtaleSheafPullback i SC.X₁ G₁ →
            CategoryTheory.Limits.IsZero G₁) ∧
          (∀ {W : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom W Z₁.left)
            (G₃ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
            Disjoint (Set.range i.base) (O₁ : Set ↥Z₁.left) →
            WeilIsEtaleSheafPullback i SC.X₃ G₃ →
            CategoryTheory.Limits.IsZero G₃) := by
    intro m ℓ h_dvd F hm_F hDisj_F
    let φ : F ⟶ F := ℓ • CategoryTheory.CategoryStruct.id F
    let K := CategoryTheory.Limits.kernel φ
    let I := CategoryTheory.Limits.image φ
    let ι : K ⟶ F := CategoryTheory.Limits.kernel.ι φ
    let π : F ⟶ I := CategoryTheory.Limits.factorThruImage φ
    let j : I ⟶ F := CategoryTheory.Limits.image.ι φ
    have h0 : ι ≫ π = 0 := by
      rw [← cancel_mono j, CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
        CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    let SC := CategoryTheory.ShortComplex.mk ι π h0
    have h_isLim : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι ι h0) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun x hx => CategoryTheory.Limits.kernel.lift φ x
          (by rw [← CategoryTheory.Limits.image.fac φ, ← CategoryTheory.Category.assoc, hx,
            CategoryTheory.Limits.zero_comp]))
        (fun x hx => CategoryTheory.Limits.kernel.lift_ι φ x _)
        (fun x hx b hb => by rw [← cancel_mono ι, hb, CategoryTheory.Limits.kernel.lift_ι])
    have hSC : SC.ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel SC h_isLim
        mono_f := inferInstance
        epi_g := inferInstance }
    refine ⟨SC, hSC, rfl, ?_, ?_, ?_, ?_⟩
    · change ℓ • 𝟙 K = 0
      rw [← cancel_mono ι, Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
        CategoryTheory.Limits.zero_comp]
      have h_comm : ℓ • ι = ι ≫ φ := by
        dsimp [φ]
        rw [Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
      rw [h_comm, CategoryTheory.Limits.kernel.condition]
    · change (m / ℓ) • 𝟙 I = 0
      rw [← cancel_epi π, ← cancel_mono j, Preadditive.comp_nsmul, Preadditive.nsmul_comp,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.image.fac]
      dsimp [φ]
      rw [← mul_smul, Nat.div_mul_cancel h_dvd, hm_F, CategoryTheory.Limits.zero_comp,
        CategoryTheory.Limits.comp_zero]
    · intro W i G₁ hDisj hPb₁
      obtain ⟨G₃, hPb₃, _, _⟩ :=
        (weil_etale_pullback_exact_and_pseudofunctor 0).1 i SC.X₃
      obtain ⟨SC', hSC', hX₁', _, hPb₂', _⟩ :=
        (weil_etale_pullback_exact_and_pseudofunctor 0).2.2.2.2.2 i SC G₁ G₃ hSC hPb₁ hPb₃
      have hZ₂ : CategoryTheory.Limits.IsZero SC'.X₂ := hDisj_F i SC'.X₂ hDisj hPb₂'
      have _ : CategoryTheory.Mono SC'.f := hSC'.mono_f
      rw [← hX₁', CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← cancel_mono SC'.f]
      exact hZ₂.eq_of_tgt _ _
    · intro W i G₃ hDisj hPb₃
      obtain ⟨G₁, hPb₁, _, _⟩ :=
        (weil_etale_pullback_exact_and_pseudofunctor 0).1 i SC.X₁
      obtain ⟨SC', hSC', _, hX₃', hPb₂', _⟩ :=
        (weil_etale_pullback_exact_and_pseudofunctor 0).2.2.2.2.2 i SC G₁ G₃ hSC hPb₁ hPb₃
      have hZ₂ : CategoryTheory.Limits.IsZero SC'.X₂ := hDisj_F i SC'.X₂ hDisj hPb₂'
      have _ : CategoryTheory.Epi SC'.g := hSC'.epi_g
      rw [← hX₃', CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← cancel_epi SC'.g]
      exact hZ₂.eq_of_src _ _

  
  have _ : AlgebraicGeometry.IsProper (f ≫ Z₂.hom) := by
    rw [hf_over]
    infer_instance
  have hf_prop : AlgebraicGeometry.IsProper f :=
    AlgebraicGeometry.IsProper.of_comp f Z₂.hom

  have hFibDichot : ∀ (σ : Quiver.Hom S_k Z₂.left),
      CategoryTheory.CategoryStruct.comp σ Z₂.hom = CategoryTheory.CategoryStruct.id S_k →
      let X'_sch := CategoryTheory.Limits.pullback f σ
      let g'_left := CategoryTheory.Limits.pullback.fst f σ
      let f'_left := CategoryTheory.Limits.pullback.snd f σ
      CategoryTheory.CategoryStruct.comp g'_left Z₁.hom = f'_left ∧
      (Disjoint (Set.range g'_left.base) (O₁ : Set ↥Z₁.left) ∨
        (AlgebraicGeometry.IsProper f'_left ∧
          AlgebraicGeometry.IsFinite f'_left ∧
