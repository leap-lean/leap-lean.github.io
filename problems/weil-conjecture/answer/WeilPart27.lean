    have ha_germW : (W_O.left.presheaf.germ O_topW z.1.1 trivial).hom
        (O_topW.topIso.hom.hom a₀_W) =
        e_stk_W (algebraMap S_O (Localization.AtPrime 𝔪) a₀) :=
      (congrArg (W_O.left.presheaf.germ O_topW z.1.1 trivial).hom ha_topW).trans
        (e_stk_W.commutes a₀).symm
    have hb_germW : (W_O.left.presheaf.germ O_topW z.1.1 trivial).hom
        (O_topW.topIso.hom.hom b₀_W) =
        e_stk_W (algebraMap S_O (Localization.AtPrime 𝔪) b_orig_S) :=
      (congrArg (W_O.left.presheaf.germ O_topW z.1.1 trivial).hom hb_topW).trans
        (e_stk_W.commutes b_orig_S).symm
    obtain ⟨hDom_sC, hDVR_sC⟩ := hDVR_C W_O z.1
    letI : IsDomain ↑(W_O.left.presheaf.stalk z.1.1) := hDom_sC
    letI : IsDiscreteValuationRing ↑(W_O.left.presheaf.stalk z.1.1) := hDVR_sC
    obtain ⟨ha_stkW_ne, ha_stkW_sp⟩ :=
      hSpanTrans e_stk_W.toRingEquiv (algebraMap S_O (Localization.AtPrime 𝔪) a₀)
        (n_a 𝔪) ha_𝔪_ne ha_𝔪_span
    obtain ⟨hb_stkW_ne, hb_stkW_sp⟩ :=
      hSpanTrans e_stk_W.toRingEquiv (algebraMap S_O (Localization.AtPrime 𝔪) b_orig_S)
        (n_b 𝔪) hb_𝔪_ne hb_𝔪_span
    refine hOrd_C W_O s_O z.1 O_topW trivial a₀_W b₀_W (n_a 𝔪) (n_b 𝔪) h_frac_topW
      (fun h0 => ha_stkW_ne (ha_germW.symm.trans h0))
      (fun h0 => hb_stkW_ne (hb_germW.symm.trans h0))
      ((congrArg (fun x => Ideal.span ({x} : Set _)) ha_germW).trans ha_stkW_sp)
      ((congrArg (fun x => Ideal.span ({x} : Set _)) hb_germW).trans hb_stkW_sp)
  let hFin_fib : Fintype Fib_O := Fintype.ofEquiv { 𝔪 : Ideal S_O // 𝔪 ∈ M_fib } e_fib.symm
  have hRHS_val : valDiv_1 O_et
      ((u_div.hom.app (Opposite.op O_et)).hom
        ((div_C.hom.app (Opposite.op W_O)).hom
          ((η_K_C.app (Opposite.op W_O)).hom s_O))) y_O =
      Finset.sum M_fib (fun 𝔪 => (n_a 𝔪 : ℤ) - (n_b 𝔪 : ℤ)) := by
    have h_step1 := hu_div_val O_et
      ((div_C.hom.app (Opposite.op W_O)).hom ((η_K_C.app (Opposite.op W_O)).hom s_O))
      y_O hFin_fib
    have h_sum1 : @Finset.sum Fib_O ℤ _ (@Finset.univ Fib_O hFin_fib)
        (fun z => valDiv_C W_O
          ((div_C.hom.app (Opposite.op W_O)).hom ((η_K_C.app (Opposite.op W_O)).hom s_O)) z.1) =
        @Finset.sum Fib_O ℤ _ (@Finset.univ Fib_O hFin_fib)
          (fun z => (n_a (e_fib z).1 : ℤ) - (n_b (e_fib z).1 : ℤ)) :=
      Finset.sum_congr rfl fun z _ => hOrd_each z
    have h_bij : @Finset.sum Fib_O ℤ _ (@Finset.univ Fib_O hFin_fib)
        (fun z => (n_a (e_fib z).1 : ℤ) - (n_b (e_fib z).1 : ℤ)) =
        Finset.sum Finset.univ
          (fun m : { 𝔪 : Ideal S_O // 𝔪 ∈ M_fib } => (n_a m.1 : ℤ) - (n_b m.1 : ℤ)) := by
      letI : Fintype Fib_O := hFin_fib
      exact Equiv.sum_comp e_fib (fun m : { 𝔪 : Ideal S_O // 𝔪 ∈ M_fib } =>
        (n_a m.1 : ℤ) - (n_b m.1 : ℤ))
    have h_att : Finset.sum Finset.univ
        (fun m : { 𝔪 : Ideal S_O // 𝔪 ∈ M_fib } => (n_a m.1 : ℤ) - (n_b m.1 : ℤ)) =
        Finset.sum M_fib (fun 𝔪 => (n_a 𝔪 : ℤ) - (n_b 𝔪 : ℤ)) := by
      rw [Finset.univ_eq_attach]
      exact Finset.sum_attach M_fib (fun 𝔪 => (n_a 𝔪 : ℤ) - (n_b 𝔪 : ℤ))
    exact h_step1.trans (h_sum1.trans (h_bij.trans h_att))
  exact hLHS_red.trans (hLHS_val.trans (hSum_eq.trans (hRHS_val.symm.trans hRHS_red.symm)))

theorem weil_etale_smooth_curve_kummer_divisor_norm_trace (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (hDvrNorm : ∀ (R S : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
       [CommRing S] [Algebra k S] [Algebra R S] [IsScalarTower k R S]
       (δ : ℕ) (_ : 1 ≤ δ),
       (∀ r : R, ∃ c : k, r - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) →
       Nonempty (Module.Basis (Fin δ) R S) →
       (∀ (𝔪 : Ideal S), (h𝔪 : 𝔪.IsMaximal) →
         letI : 𝔪.IsPrime := h𝔪.isPrime
         ∃ hDom_m : IsDomain (Localization.AtPrime 𝔪),
           @IsDiscreteValuationRing (Localization.AtPrime 𝔪) _ hDom_m) →
       ∀ (a : S), a ∈ nonZeroDivisors S →
         Algebra.norm R a ≠ 0 ∧
         ∃ (M_max : Finset (Ideal S)) (ord_a : Ideal S → ℕ),
           (∀ 𝔪 : Ideal S, 𝔪 ∈ M_max ↔ 𝔪.IsMaximal) ∧
           (∀ (𝔪 : Ideal S) (h𝔪 : 𝔪.IsMaximal),
             letI : 𝔪.IsPrime := h𝔪.isPrime
             Ideal.span ({algebraMap S (Localization.AtPrime 𝔪) a} : Set (Localization.AtPrime 𝔪)) =
               (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) ^ (ord_a 𝔪)) ∧
           Ideal.span ({Algebra.norm R a} : Set R) =
             (IsLocalRing.maximalIdeal R) ^ (Finset.sum M_max ord_a))
    (P₁_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper P₁_ov.hom]
    [AlgebraicGeometry.IsIntegral P₁_ov.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁_ov.hom]
    (ι_1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) P₁_ov.left)
    (s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) P₁_ov.left)
    (hOpen_1 : AlgebraicGeometry.IsOpenImmersion ι_1)
    (hι_1_ov : CategoryTheory.CategoryStruct.comp ι_1 P₁_ov.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (hs_inf_ov : CategoryTheory.CategoryStruct.comp s_inf P₁_ov.hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_inf_disj : Disjoint (Set.range ι_1.base) (Set.range s_inf.base))
    (hs_inf_cov : Set.range ι_1.base ∪ Set.range s_inf.base = Set.univ)
    (tr_1 : weilEtaleTorsionH P₁_ov.left n 2 →+ ZMod n)
    (hTrSpec : WeilTopDegKummerLastCoordP1DivTraceSpec k n ζ P₁_ov s_inf tr_1)
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper C.hom]
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (w : weilEtaleTorsionH C.left n 2) :
    ∃ D : ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ),
      ∀ (δ : ℕ) (_ : 1 ≤ δ)
        (u : Quiver.Hom C.left P₁_ov.left)
        (u_shriek : weilEtaleTorsionH C.left n 2 →+ weilEtaleTorsionH P₁_ov.left n 2),
        CategoryTheory.CategoryStruct.comp u P₁_ov.hom = C.hom →
        WeilTopDegFiniteLocallyFreeOfRank δ u →
        WeilTopDegAffineFiniteFreePushforward k n δ 2 ζ C P₁_ov u u_shriek →
        tr_1 (u_shriek w) = ((D.sum fun _ m => m : ℤ) : ZMod n) :=
by
  classical
  let _ := hTrSpec
  have hNeZero_n : NeZero n := ⟨by omega⟩
  obtain ⟨hGmSheaf, hCurvePkg⟩ :=
    weil_etale_curve_canonical_divisor_surj_and_p1_degree k
  obtain ⟨hComp_C, _hSep_C, hKSheaf_C, hSubGm2_C, hSubK1_C,
    Div_sh_C, ι_gm_C, div_C, h0_div_C, valDiv_C,
    hEx_div_C, hι_gm_C, hVal_C, hValNat_C, hDVR_C, hChart_C, hOrd_C, _⟩ := hCurvePkg C
  obtain ⟨_hComp_1, _hSep_1, hKSheaf_1, _hSubGm2_1, _hSubK1_1,
    Div_sh_1, ι_gm_1, div_1, h0_div_1, valDiv_1,
    hEx_div_1, hι_gm_1, hVal_1, hValNat_1, hDVR_1, hChart_1, hOrd_1, hP1Deg⟩ := hCurvePkg P₁_ov
  obtain ⟨d_inf, hd_inf_spec⟩ :=
    hP1Deg hEx_div_1 ι_1 s_inf hOpen_1 hι_1_ov hs_inf_ov hs_inf_disj hs_inf_cov
  obtain ⟨ι_kum, p_kum, h0_kum, hKum_Z, hKum_push⟩ :=
    weil_etale_kummer_short_exact_and_finite_free_norm_ladder k n hn hUnit ζ hζ hGmSheaf
  have hEx_kum_C : (CategoryTheory.ShortComplex.mk (ι_kum C) (p_kum C) (h0_kum C)).ShortExact :=
    (hKum_Z C).2
  have hEx_kum_1 :
      (CategoryTheory.ShortComplex.mk (ι_kum P₁_ov) (p_kum P₁_ov) (h0_kum P₁_ov)).ShortExact :=
    (hKum_Z P₁_ov).2
  let J₁ := C.left.smallEtaleTopology
  let J₂ := P₁_ov.left.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  let Fℤ_C := C₁.obj Aℤ
  let Fℤ_1 := C₂.obj Aℤ
  
  have hw_f0 : w.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_kum C)) (Nat.add_zero 2) = 0 :=
    hSubGm2_C.elim _ _
  obtain ⟨x_gm_C, hx_gm_C⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hEx_kum_C w hw_f0 (Nat.one_add 1)
  have hx_f0 : x_gm_C.comp (CategoryTheory.Abelian.Ext.mk₀ ι_gm_C) (Nat.add_zero 1) = 0 :=
    hSubK1_C.elim _ _
  obtain ⟨d_C, hd_C⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hEx_div_C x_gm_C hx_f0 (Nat.zero_add 1)
  have hd_C_w :
      (d_C.comp hEx_div_C.extClass (Nat.zero_add 1)).comp
        hEx_kum_C.extClass (Nat.one_add 1) = w := by
    rw [hd_C, hx_gm_C]
  
  let T_id_C := weilEtaleIdTerminal.{u} C.left
  let hT_id_C := weilEtaleIdTerminalIsTerminal.{u} C.left
  let adj_id_C := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT_id_C
  let f_C : Fℤ_C ⟶ Div_sh_C := CategoryTheory.Abelian.Ext.addEquiv₀ d_C
  let s_C : ↥(Div_sh_C.obj.obj (Opposite.op T_id_C)) :=
    ((adj_id_C.homEquiv Aℤ Div_sh_C f_C).hom (ULift.up (1 : ℤ)))
  have hSupp_C : (Function.support (valDiv_C T_id_C s_C)).Finite := by
    have hRange_C : Set.range (valDiv_C T_id_C) = { D | { y | D y ≠ 0 }.Finite } :=
      (hVal_C T_id_C).2.2 hComp_C
    have hmem : valDiv_C T_id_C s_C ∈ Set.range (valDiv_C T_id_C) := ⟨s_C, rfl⟩
    rwa [hRange_C] at hmem
  let D_can : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ :=
    Finsupp.ofSupportFinite (valDiv_C T_id_C s_C) hSupp_C
  have hD_can_val : ∀ x : { x : ↥T_id_C.left // IsClosed ({T_id_C.hom.base x} : Set ↥C.left) },
      valDiv_C T_id_C s_C x = D_can ⟨x.1, x.2⟩ := fun _ => rfl
  
  let w_inf_can : weilEtaleTorsionH P₁_ov.left n 2 :=
    (d_inf.comp hEx_div_1.extClass (Nat.zero_add 1)).comp hEx_kum_1.extClass (Nat.one_add 1)
  let c₀ : ℕ := (tr_1 w_inf_can).val
  let D : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ := (c₀ : ℤ) • D_can
  refine ⟨D, ?_⟩
  intro δ hδ u u_shriek hu_ov hu_free hu_shriek
  
  rcases hu_shriek with ⟨hCont, P_pull, adj_pull, hAdd, hLim, hColim,
    T₁, hT₁, T₂, hT₂, ιℤ, hιπ, _hπι, _hBij_leray,
    ι₁, ι₂, τM, hι₁_inj, hι₂_inj, hι₁_nat, hι₂_nat, hι₁_unit, hι₂_unit, hτM_det, h_ushriek⟩
  letI : P_pull.Additive := hAdd
  letI : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
  letI : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
  let B := weilEtaleSitePullback u
  let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
    AddCommGrpCat.{u} _ J₂ J₁ hCont
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  
  obtain ⟨⟨h0_pkum, hEx_pkum⟩, N_gm, hN_gm_pow, hN_gm_det, hN_gm_τ⟩ :=
    hKum_push C P₁_ov δ hδ u hu_ov hu_free hCont
  have hτM_kum :
      CategoryTheory.CategoryStruct.comp τM (ι_kum P₁_ov) =
        CategoryTheory.CategoryStruct.comp (P_push.map (ι_kum C)) N_gm :=
    hN_gm_τ T₁ hT₁ T₂ hT₂ ι₁ ι₂ τM hι₁_inj hι₂_inj hι₁_nat hι₂_nat hι₁_unit hι₂_unit hτM_det
  obtain ⟨⟨h0_pdiv, hEx_pdiv⟩, N_K, u_div, hN_gm_K, hN_K_div, hDiv_deg⟩ :=
    weil_etale_smooth_curve_weil_divisor_norm_ladder k hDvrNorm hGmSheaf C P₁_ov
      hKSheaf_C hKSheaf_1
      Div_sh_C ι_gm_C div_C h0_div_C valDiv_C hEx_div_C hι_gm_C hVal_C hValNat_C
      hDVR_C hChart_C hOrd_C
      Div_sh_1 ι_gm_1 div_1 h0_div_1 valDiv_1 hEx_div_1 hι_gm_1 hVal_1 hValNat_1
      hDVR_1 hChart_1 hOrd_1
      δ hδ u hu_ov hu_free hCont N_gm hN_gm_det
  obtain ⟨D_P1, hDP1_val, hDP1_deg⟩ := hDiv_deg s_C D_can hD_can_val
  
  let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
  let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
  let T_id_1 := weilEtaleIdTerminal.{u} P₁_ov.left
  let hT_id_1 := weilEtaleIdTerminalIsTerminal.{u} P₁_ov.left
  let adj_id_1 := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT_id_1
  let τ_id : B.obj T_id_1 ⟶ T_id_C := hT_id_C.from (B.obj T_id_1)
  let g₀ : Fℤ_1 ⟶ P_push.obj Fℤ_C :=
    (adj₂.homEquiv Aℤ (P_push.obj Fℤ_C)).symm
      (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
        (Fℤ_C.obj.map (Opposite.op (hT₁.from (B.obj T₂)))))
  let πℤ : P_pull.obj Fℤ_1 ⟶ Fℤ_C := (adj_pull.homEquiv Fℤ_1 Fℤ_C).symm g₀
  let f_push : Fℤ_1 ⟶ P_push.obj Div_sh_C :=
    adj_pull.homEquiv Fℤ_1 Div_sh_C (CategoryTheory.CategoryStruct.comp πℤ f_C)
  let d_push : CategoryTheory.Abelian.Ext Fℤ_1 (P_push.obj Div_sh_C) 0 :=
    CategoryTheory.Abelian.Ext.mk₀ f_push
  have hd_leray :
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull d_push) (Nat.zero_add 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app Div_sh_C)) (Nat.add_zero 0) = d_C := by
    dsimp [d_push]
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hcounit : CategoryTheory.CategoryStruct.comp (P_pull.map f_push)
        (adj_pull.counit.app Div_sh_C) = CategoryTheory.CategoryStruct.comp πℤ f_C :=
      (adj_pull.homEquiv_counit Fℤ_1 Div_sh_C f_push).symm.trans
        ((adj_pull.homEquiv Fℤ_1 Div_sh_C).left_inv (CategoryTheory.CategoryStruct.comp πℤ f_C))
    rw [CategoryTheory.Category.assoc, hcounit, ← CategoryTheory.Category.assoc,
      hιπ, CategoryTheory.Category.id_comp]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply d_C
  have hf_push_eq : f_push = CategoryTheory.CategoryStruct.comp g₀ (P_push.map f_C) :=
    (adj_pull.homEquiv_naturality_right πℤ f_C).trans
      (congrArg (fun h => CategoryTheory.CategoryStruct.comp h (P_push.map f_C))
        ((adj_pull.homEquiv Fℤ_1 Fℤ_C).right_inv g₀))
  have hunit_indep₁ : ∀ {U V : C.left.Etale}
      (hU : CategoryTheory.Limits.IsTerminal U) (hV : CategoryTheory.Limits.IsTerminal V)
      (m : U ⟶ V),
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hV).unit.app Aℤ)
        (Fℤ_C.obj.map m.op) =
      (CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hU).unit.app Aℤ :=
    fun _ _ m =>
      (((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app
        ((CategoryTheory.Functor.const _).obj Aℤ)).naturality m.op).symm.trans
        (CategoryTheory.Category.id_comp _)
  have hunit_indep₂ : ∀ {U V : P₁_ov.left.Etale}
      (hU : CategoryTheory.Limits.IsTerminal U) (hV : CategoryTheory.Limits.IsTerminal V)
      (m : U ⟶ V),
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hV).unit.app Aℤ)
        (Fℤ_1.obj.map m.op) =
      (CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hU).unit.app Aℤ :=
    fun _ _ m =>
      (((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).unit.app
        ((CategoryTheory.Functor.const _).obj Aℤ)).naturality m.op).symm.trans
        (CategoryTheory.Category.id_comp _)
  let m₂ : T_id_1 ⟶ T₂ := hT₂.from T_id_1
  let m₁ : T₁ ⟶ T_id_C := hT_id_C.from T₁
  have hτ_comp :
      CategoryTheory.CategoryStruct.comp (B.map m₂)
        (CategoryTheory.CategoryStruct.comp (hT₁.from (B.obj T₂)) m₁) = τ_id :=
    hT_id_C.hom_ext _ _
  have hg₀_unit :
      CategoryTheory.CategoryStruct.comp (adj₂.unit.app Aℤ) (g₀.hom.app (Opposite.op T₂)) =
        CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
          (Fℤ_C.obj.map (Opposite.op (hT₁.from (B.obj T₂)))) :=
    (adj₂.homEquiv_unit Aℤ (P_push.obj Fℤ_C) g₀).symm.trans
      ((adj₂.homEquiv Aℤ (P_push.obj Fℤ_C)).right_inv _)
  have hg₀_eval :
      CategoryTheory.CategoryStruct.comp (adj_id_1.unit.app Aℤ) (g₀.hom.app (Opposite.op T_id_1)) =
        CategoryTheory.CategoryStruct.comp (adj_id_C.unit.app Aℤ) (Fℤ_C.obj.map τ_id.op) := by
    have hs1 :
        CategoryTheory.CategoryStruct.comp (adj_id_1.unit.app Aℤ) (g₀.hom.app (Opposite.op T_id_1)) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (adj₂.unit.app Aℤ) (g₀.hom.app (Opposite.op T₂)))
            ((P_push.obj Fℤ_C).obj.map m₂.op) := by
      rw [← hunit_indep₂ hT_id_1 hT₂ m₂, CategoryTheory.Category.assoc,
        g₀.hom.naturality m₂.op, ← CategoryTheory.Category.assoc]
    have hs2 :
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (adj₂.unit.app Aℤ) (g₀.hom.app (Opposite.op T₂)))
          ((P_push.obj Fℤ_C).obj.map m₂.op) : Aℤ ⟶ Fℤ_C.obj.obj (Opposite.op (B.obj T_id_1))) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
            (Fℤ_C.obj.map (Opposite.op (hT₁.from (B.obj T₂)))))
