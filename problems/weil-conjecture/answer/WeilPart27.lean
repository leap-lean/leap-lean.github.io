        obtain ⟨u_el, hu_el, m_el, hm_el, hum⟩ := Ideal.isCoprime_iff_exists.mp hcop_u
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hu_el
        have hz_eq : z = m_el * z := by
          calc
