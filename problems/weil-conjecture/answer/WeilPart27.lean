        (hDetExUniq Z₁ Z₂ f hf_over m hm O₂ O₁ hO₁ hf_free).2 τ₀ τ_norm hτ₀ hτ
      let e_lift := AddEquiv.ofBijective
        ((extToTorsHom Z₁.left O₁ (2 * d)).comp (lerayHom f O₁ (2 * d)))
        ((hBij_exc_fn Z₁ O₁ hDim₁).comp
