        exact h1.trans hm_g_val
      let u_f : (weilEtaleSitePullback f).obj T₃ ⟶ T₂ :=
        hT₂.from ((weilEtaleSitePullback f).obj T₃)
      let u_g : (weilEtaleSitePullback g).obj T₂ ⟶ weilEtaleIdTerminal.{u} X₁ :=
        hT₁.from ((weilEtaleSitePullback g).obj T₂)
      let η₁ : Aℤ ⟶ Fℤ₁.obj.obj (Opposite.op (weilEtaleIdTerminal.{u} X₁)) :=
