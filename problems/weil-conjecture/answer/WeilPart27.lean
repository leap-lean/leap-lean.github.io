            (Opposite.op (hT₂.from ((weilEtaleSitePullback f).obj T₃))) :=
        Equiv.apply_symm_apply (adj_c₃.homEquiv Aℤ (pf_f.obj Fℤ₂)) _
      have hm_g_val : (adj_c₂.homEquiv Aℤ (pf_g.obj Fℤ₁)) m_g =
          adj_c₁.unit.app Aℤ ≫ Fℤ₁.obj.map
            (Opposite.op (hT₁.from ((weilEtaleSitePullback g).obj T₂))) :=
        Equiv.apply_symm_apply (adj_c₂.homEquiv Aℤ (pf_g.obj Fℤ₁)) _
      have hin : (adj_g.homEquiv (pb_f.obj Fℤ₃) Fℤ₁) (pb_g.map πℤ_f ≫ πℤ_g) =
