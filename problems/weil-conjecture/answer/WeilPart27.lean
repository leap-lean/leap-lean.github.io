      exact @h_no_chain α I₁ I₀ hI₁_p hI₀_p hI_lt ⟨h_ker_eq _ hq₁_H1, h_ker_eq _ hq₀_H1⟩

  have hDim_Cs : topologicalKrullDim C_s ≤ (1 : WithBot ℕ∞) := by
    
    obtain ⟨FC₁⟩ := hChart₁
    let _ : AlgebraicGeometry.IsOpenImmersion j₁_s := FC₁.hj_open
    have hDim_Qq₁ : ringKrullDim (Localization.Away q₁) ≤ (1 : WithBot ℕ∞) := by
      have hle : ringKrullDim (Localization.Away q₁) ≤ ringKrullDim (Polynomial k) :=
        Order.krullDim_le_of_strictMono
          (fun p => ((IsLocalization.primeSpectrumOrderIso (Submonoid.powers q₁)
            (Localization.Away q₁)) p).1)
          (Subtype.strictMono_coe _ |>.comp (IsLocalization.primeSpectrumOrderIso _ _).strictMono)
      have hpoly : ringKrullDim (Polynomial k) = (1 : WithBot ℕ∞) := by
        rw [Polynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add]
