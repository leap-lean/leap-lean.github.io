      let A₀ := Z₀.presheaf.obj (Opposite.op ⊤)
      let A₁ := Z₁.presheaf.obj (Opposite.op ⊤)
      let A₂ := Z₂.presheaf.obj (Opposite.op ⊤)
      let A_P := P.presheaf.obj (Opposite.op ⊤)
      let R₀ : Type u := ↑A₀
      let R₁ : Type u := ↑A₁
      let R₂ : Type u := ↑A₂
      let R_P : Type u := ↑A_P
      let φ₁ : R₀ →+* R₁ := CommRingCat.Hom.hom f₁.appTop
      let φ₂ : R₀ →+* R₂ := CommRingCat.Hom.hom f₂.appTop
      let π₁ : R₁ →+* R_P := CommRingCat.Hom.hom p₁.appTop
      let π₂ : R₂ →+* R_P := CommRingCat.Hom.hom p₂.appTop
      letI : Algebra R₀ R₁ := RingHom.toAlgebra φ₁
      letI : Algebra R₀ R₂ := RingHom.toAlgebra φ₂
      let g₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₁))
      let g₂ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₂))
      have hg₁ : g₁ = AlgebraicGeometry.Spec.map f₁.appTop := rfl
      have hg₂ : g₂ = AlgebraicGeometry.Spec.map f₂.appTop := rfl
      have hu_comm : (p₁ ≫ Z₁.isoSpec.hom) ≫ g₁ = (p₂ ≫ Z₂.isoSpec.hom) ≫ g₂ := by
        rw [Category.assoc, Category.assoc, hg₁, hg₂,
          AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₁,
          AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₂,
          ← Category.assoc, ← Category.assoc, hPB.w]
      let PB := CategoryTheory.Limits.pullback g₁ g₂
      let u_pb : P ⟶ PB := CategoryTheory.Limits.pullback.lift
        (p₁ ≫ Z₁.isoSpec.hom) (p₂ ≫ Z₂.isoSpec.hom) hu_comm
      have hv_comm : (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv) ≫ f₁ =
          (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv) ≫ f₂ := by
        rw [← cancel_mono Z₀.isoSpec.hom]
        calc
          ((CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv) ≫ f₁) ≫ Z₀.isoSpec.hom
            = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv ≫
                (Z₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map f₁.appTop) := by
              rw [Category.assoc, Category.assoc, AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₁]
          _ = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ g₁ := by
              rw [← Category.assoc Z₁.isoSpec.inv, Z₁.isoSpec.inv_hom_id, Category.id_comp, hg₁]
          _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ g₂ := CategoryTheory.Limits.pullback.condition
          _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv ≫
                (Z₂.isoSpec.hom ≫ AlgebraicGeometry.Spec.map f₂.appTop) := by
              rw [← Category.assoc Z₂.isoSpec.inv, Z₂.isoSpec.inv_hom_id, Category.id_comp, hg₂]
          _ = ((CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv) ≫ f₂) ≫ Z₀.isoSpec.hom := by
              rw [Category.assoc, Category.assoc, AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₂]
      let v_pb : PB ⟶ P := hPB.lift
        (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv)
        (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv) hv_comm
      let e_pb : P ≅ PB :=
        { hom := u_pb
          inv := v_pb
          hom_inv_id := hPB.hom_ext
            (by
              dsimp [u_pb, v_pb]
              rw [Category.assoc, hPB.lift_fst, ← Category.assoc,
                CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
                Iso.hom_inv_id, Category.comp_id, Category.id_comp])
            (by
              dsimp [u_pb, v_pb]
              rw [Category.assoc, hPB.lift_snd, ← Category.assoc,
                CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
                Iso.hom_inv_id, Category.comp_id, Category.id_comp])
          inv_hom_id := CategoryTheory.Limits.pullback.hom_ext
            (by
              dsimp [u_pb, v_pb]
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← Category.assoc, hPB.lift_fst, Category.assoc,
                Iso.inv_hom_id, Category.comp_id, Category.id_comp])
            (by
              dsimp [u_pb, v_pb]
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← Category.assoc, hPB.lift_snd, Category.assoc,
                Iso.inv_hom_id, Category.comp_id, Category.id_comp]) }
      let T_cat : CommRingCat.{u} := CommRingCat.of (TensorProduct R₀ R₁ R₂)
      let e_sch : P ≅ AlgebraicGeometry.Spec T_cat :=
        e_pb ≪≫ AlgebraicGeometry.pullbackSpecIso R₀ R₁ R₂
      have he_fst : e_sch.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
          p₁ ≫ Z₁.toSpecΓ := by
        dsimp [e_sch, e_pb, u_pb]
        rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst R₀ R₁ R₂,
          CategoryTheory.Limits.pullback.lift_fst]
        rfl
      have he_snd : e_sch.hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] TensorProduct R₀ R₁ R₂).toRingHom) =
          p₂ ≫ Z₂.toSpecΓ := by
        dsimp [e_sch, e_pb, u_pb]
        rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_snd R₀ R₁ R₂,
          CategoryTheory.Limits.pullback.lift_snd]
        rfl
      let Φ_hom : T_cat ⟶ A_P :=
        (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).inv ≫ e_sch.hom.appTop
      let Φ_inv : A_P ⟶ T_cat :=
        e_sch.inv.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).hom
      let Φ_iso : T_cat ≅ A_P :=
        { hom := Φ_hom
          inv := Φ_inv
          hom_inv_id := by
            dsimp [Φ_hom, Φ_inv]
            rw [Category.assoc, ← Category.assoc e_sch.hom.appTop,
              ← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop, Category.id_comp, Iso.inv_hom_id]
          inv_hom_id := by
            dsimp [Φ_hom, Φ_inv]
            rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).hom,
              Iso.hom_inv_id, Category.id_comp,
              ← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] }
      have hΦ_left : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ Φ_hom =
          p₁.appTop := by
        let h_inc₁ : A₁ ⟶ T_cat := CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
        change h_inc₁ ≫ Φ_hom = p₁.appTop
        rw [← Iso.cancel_iso_hom_left (AlgebraicGeometry.Scheme.ΓSpecIso A₁)]
        have h1 := congrArg AlgebraicGeometry.Scheme.Hom.appTop he_fst
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.toSpecΓ_appTop] at h1
        have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality h_inc₁
        have hnat' : (AlgebraicGeometry.Spec.map h_inc₁).appTop =
            (AlgebraicGeometry.Scheme.ΓSpecIso A₁).hom ≫ h_inc₁ ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).inv := by
          rw [← Iso.cancel_iso_hom_right _ _ (AlgebraicGeometry.Scheme.ΓSpecIso T_cat), hnat]
          simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        change (AlgebraicGeometry.Spec.map h_inc₁).appTop ≫ e_sch.hom.appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso A₁).hom ≫ p₁.appTop at h1
        rw [hnat'] at h1
        simpa only [Φ_hom, h_inc₁, Category.assoc] using h1
      have hΦ_right : CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] TensorProduct R₀ R₁ R₂).toRingHom ≫
            Φ_hom = p₂.appTop := by
        rw [← Iso.cancel_iso_hom_left (AlgebraicGeometry.Scheme.ΓSpecIso A₂)]
        have h2 := congrArg AlgebraicGeometry.Scheme.Hom.appTop he_snd
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.toSpecΓ_appTop] at h2
        let h_inc : A₂ ⟶ T_cat := CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] TensorProduct R₀ R₁ R₂).toRingHom
        have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality h_inc
        have hnat' : (AlgebraicGeometry.Spec.map h_inc).appTop =
            (AlgebraicGeometry.Scheme.ΓSpecIso A₂).hom ≫ h_inc ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).inv := by
          rw [← Iso.cancel_iso_hom_right _ _ (AlgebraicGeometry.Scheme.ΓSpecIso T_cat), hnat]
          simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [hnat'] at h2
        simpa only [Φ_hom, h_inc, Category.assoc] using h2
      refine ⟨Φ_iso.commRingCatIsoToRingEquiv.toAddEquiv, fun r₁ r₂ => ?_⟩
      change Φ_hom.hom (r₁ ⊗ₜ[R₀] r₂) = π₁ r₁ * π₂ r₂
      have h_mul : (r₁ ⊗ₜ[R₀] (1 : R₂)) * ((1 : R₁) ⊗ₜ[R₀] r₂) = r₁ ⊗ₜ[R₀] r₂ := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [← h_mul, map_mul]
      have hl : Φ_hom.hom (r₁ ⊗ₜ[R₀] (1 : R₂)) = π₁ r₁ :=
        congrArg (fun ψ => ψ.hom r₁) hΦ_left
      have hr : Φ_hom.hom ((1 : R₁) ⊗ₜ[R₀] r₂) = π₂ r₂ :=
        congrArg (fun ψ => ψ.hom r₂) hΦ_right
      rw [hl, hr]

    
    have hTopIso_comm : ∀ {X₀ S₀ : AlgebraicGeometry.Scheme.{u}} (f₀ : X₀ ⟶ S₀) (V₀ : S₀.Opens),
        V₀.topIso.inv ≫ (f₀ ∣_ V₀).appTop =
          f₀.app V₀ ≫
            (AlgebraicGeometry.Scheme.Opens.topIso
              ((TopologicalSpace.Opens.map f₀.base).obj V₀)).inv := by
      intro X₀ S₀ f₀ V₀
      rw [← Iso.cancel_iso_hom_left
        (AlgebraicGeometry.Scheme.ΓSpecIso (S₀.presheaf.obj (Opposite.op V₀)))]
      have hnat := congrArg AlgebraicGeometry.Scheme.Hom.appTop
        (AlgebraicGeometry.Scheme.Opens.toSpecΓ_naturality f₀ V₀)
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop] at hnat
      have hΓ := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (f₀.app V₀)
      rw [← Category.assoc, hΓ] at hnat
      simpa only [Category.assoc] using hnat.symm

    
    have hFin_φ : AlgebraicGeometry.IsFinite φ := hφ_free.1
    have hFin_φt : AlgebraicGeometry.IsFinite φ_tilde :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hFin_φ
    haveI : AlgebraicGeometry.IsFinite φ := hFin_φ
    haveI : AlgebraicGeometry.IsFinite φ_tilde := hFin_φt
    haveI : AlgebraicGeometry.IsAffineHom φ := AlgebraicGeometry.IsFinite.toIsAffineHom
    haveI : AlgebraicGeometry.IsAffineHom φ_tilde := AlgebraicGeometry.IsFinite.toIsAffineHom

    have hφt_free : WeilTopDegFiniteLocallyFreeOfRank δ φ_tilde := by
      refine ⟨hFin_φt, fun y' => ?_⟩
      obtain ⟨V, hy_V, hAff_V, hAff_U, M_V, hAdd_V, hMod_V, e_V, he_V, ⟨bM_V⟩⟩ :=
        hφ_free.2 (π.base y')
      letI : AddCommGroup M_V := hAdd_V
      letI : Module ↑(Y.left.presheaf.obj (Opposite.op V)) M_V := hMod_V
      let U_V : Y.left.Opens := (TopologicalSpace.Opens.map φ.base).obj V
      have hy'_pre : y' ∈ (TopologicalSpace.Opens.map π.base).obj V := hy_V
      obtain ⟨W', hAff_W', hy'_W', hW'_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy'_pre
      let U' : Γ_tilde.left.Opens := (TopologicalSpace.Opens.map φ_tilde.base).obj W'
      have hAff_U' : AlgebraicGeometry.IsAffineOpen U' := hAff_W'.preimage φ_tilde
      refine ⟨W', hy'_W', hAff_W', hAff_U', ?_⟩
      haveI : AlgebraicGeometry.IsAffine V.toScheme := hAff_V
      haveI : AlgebraicGeometry.IsAffine U_V.toScheme := hAff_U
      haveI : AlgebraicGeometry.IsAffine W'.toScheme := hAff_W'
      haveI : AlgebraicGeometry.IsAffine U'.toScheme := hAff_U'
      have hU'_le : U' ≤ (TopologicalSpace.Opens.map π_tilde.base).obj U_V := by
        intro z hz
        have hz_W' : φ_tilde.base z ∈ W' := hz
        have hπ_z : π.base (φ_tilde.base z) ∈ V := hW'_le hz_W'
        have hw_z : φ.base (π_tilde.base z) = π.base (φ_tilde.base z) := by
          change (π_tilde ≫ φ).base z = (φ_tilde ≫ π).base z
          rw [hPb.w]
        change φ.base (π_tilde.base z) ∈ V
        rwa [hw_z]
      let p_bot_W : W'.toScheme ⟶ V.toScheme := π.resLE V W' hW'_le
      let p_top_U : U'.toScheme ⟶ U_V.toScheme := π_tilde.resLE U_V U' hU'_le
      have hp_bot_ι : p_bot_W ≫ V.ι = W'.ι ≫ π :=
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι π hW'_le
      have hp_top_ι : p_top_U ≫ U_V.ι = U'.ι ≫ π_tilde :=
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι π_tilde hU'_le
      have h_res_comm : p_top_U ≫ (φ ∣_ V) = (φ_tilde ∣_ W') ≫ p_bot_W := by
        rw [← cancel_mono V.ι]
        have h1 : (φ ∣_ V) ≫ V.ι = U_V.ι ≫ φ :=
          (AlgebraicGeometry.isPullback_morphismRestrict φ V).w
        have h2 : (φ_tilde ∣_ W') ≫ W'.ι = U'.ι ≫ φ_tilde :=
          (AlgebraicGeometry.isPullback_morphismRestrict φ_tilde W').w
        rw [Category.assoc, h1, ← Category.assoc p_top_U, hp_top_ι,
          Category.assoc U'.ι, hPb.w, ← Category.assoc U'.ι, ← h2,
          Category.assoc (φ_tilde ∣_ W'), ← hp_bot_ι, Category.assoc]
      have hPB_outer : CategoryTheory.IsPullback
          (p_top_U ≫ U_V.ι) (φ_tilde ∣_ W') φ (p_bot_W ≫ V.ι) := by
        rw [hp_top_ι, hp_bot_ι]
        exact ((AlgebraicGeometry.isPullback_morphismRestrict φ_tilde W').flip).paste_horiz hPb
      have hPB_right : CategoryTheory.IsPullback U_V.ι (φ ∣_ V) φ V.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict φ V).flip
      have hPB_four : CategoryTheory.IsPullback (φ_tilde ∣_ W') p_top_U p_bot_W (φ ∣_ V) :=
        (CategoryTheory.IsPullback.of_right hPB_outer h_res_comm hPB_right).flip
      obtain ⟨e_tens, he_tens⟩ := hB_aff_pb hPB_four
      let R_V_top : Type u := ↑(V.toScheme.presheaf.obj (Opposite.op ⊤))
      let R_W'_top : Type u := ↑(W'.toScheme.presheaf.obj (Opposite.op ⊤))
      let S_U_top : Type u := ↑(U_V.toScheme.presheaf.obj (Opposite.op ⊤))
      let S_U'_top : Type u := ↑(U'.toScheme.presheaf.obj (Opposite.op ⊤))
      let R_V : Type u := ↑(Y.left.presheaf.obj (Opposite.op V))
      let S_U : Type u := ↑(Y.left.presheaf.obj (Opposite.op U_V))
      let R_W' : Type u := ↑(Γ_V.left.presheaf.obj (Opposite.op W'))
      let S_U' : Type u := ↑(Γ_tilde.left.presheaf.obj (Opposite.op U'))
      let φ_res : R_V_top →+* S_U_top := CommRingCat.Hom.hom (φ ∣_ V).appTop
      let ψ_bot : R_V_top →+* R_W'_top := CommRingCat.Hom.hom p_bot_W.appTop
      let φt_res : R_W'_top →+* S_U'_top := CommRingCat.Hom.hom (φ_tilde ∣_ W').appTop
      letI : Algebra R_V_top R_W'_top := RingHom.toAlgebra ψ_bot
      letI : Algebra R_V_top S_U_top := RingHom.toAlgebra φ_res
      have h_res_V : ∀ r : R_V_top,
          U_V.topIso.inv.hom ((φ.app V).hom (V.topIso.hom.hom r)) = φ_res r := by
        intro r
        have h1 := congrArg (fun ψ => ψ.hom (V.topIso.hom.hom r)) (hTopIso_comm φ V)
        simpa only [U_V, CommRingCat.hom_comp, RingHom.comp_apply, Iso.hom_inv_id_apply] using
          h1.symm
      have h_res_W' : ∀ b : R_W',
          U'.topIso.hom.hom (φt_res (W'.topIso.inv.hom b)) = (φ_tilde.app W').hom b := by
        intro b
        have h1 := congrArg (fun ψ => U'.topIso.hom.hom (ψ.hom b)) (hTopIso_comm φ_tilde W')
        simpa only [U', CommRingCat.hom_comp, RingHom.comp_apply, Iso.inv_hom_id_apply] using h1
      let M_0 : Type u := Fin δ →₀ R_V_top
      let bM_0 : Module.Basis (Fin δ) R_V_top M_0 := Finsupp.basisSingleOne
      let e_map : M_0 ≃+ (Fin δ →₀ R_V) :=
        Finsupp.mapRange.addEquiv V.topIso.commRingCatIsoToRingEquiv.toAddEquiv
      let e_V_lin : M_0 ≃ₗ[R_V_top] S_U_top :=
        { ((e_map.trans bM_V.repr.symm.toAddEquiv).trans e_V).trans
            U_V.topIso.symm.commRingCatIsoToRingEquiv.toAddEquiv with
          map_smul' := fun r m => by
            have h_smul : e_map (r • m) = V.topIso.hom.hom r • e_map m := by
              ext i
              exact map_mul V.topIso.hom.hom r (m i)
            change U_V.topIso.inv.hom (e_V (bM_V.repr.symm (e_map (r • m)))) =
              φ_res r * U_V.topIso.inv.hom (e_V (bM_V.repr.symm (e_map m)))
            rw [h_smul, map_smul, he_V, map_mul, h_res_V] }
      let M_W_top : Type u := TensorProduct R_V_top R_W'_top M_0
      let bM_W_top : Module.Basis (Fin δ) R_W'_top M_W_top := bM_0.baseChange R_W'_top
      let e_W_top : M_W_top ≃+ S_U'_top :=
        (LinearEquiv.baseChange R_V_top R_W'_top M_0 S_U_top e_V_lin).toAddEquiv.trans e_tens
      have he_W_top : ∀ (r'₀ : R_W'_top) (x : M_W_top),
          e_W_top (r'₀ • x) = φt_res r'₀ * e_W_top x := by
        intro r'₀ x
        refine TensorProduct.induction_on
          (motive := fun x => e_W_top (r'₀ • x) = φt_res r'₀ * e_W_top x) x ?_ ?_ ?_
        · simp only [smul_zero, map_zero, mul_zero]
        · intro r'₁ m₀
          change e_tens ((LinearEquiv.baseChange R_V_top R_W'_top M_0 S_U_top e_V_lin)
              (r'₀ • (r'₁ ⊗ₜ[R_V_top] m₀))) =
            φt_res r'₀ * e_tens ((LinearEquiv.baseChange R_V_top R_W'_top M_0 S_U_top e_V_lin)
              (r'₁ ⊗ₜ[R_V_top] m₀))
          rw [TensorProduct.smul_tmul', smul_eq_mul, LinearEquiv.baseChange_tmul,
            LinearEquiv.baseChange_tmul]
          erw [he_tens (r'₀ * r'₁) (e_V_lin m₀), he_tens r'₁ (e_V_lin m₀)]
          change φt_res (r'₀ * r'₁) * _ = φt_res r'₀ * (φt_res r'₁ * _)
          rw [map_mul, mul_assoc]
        · intro x₁ x₂ ih₁ ih₂
          rw [smul_add, map_add, ih₁, ih₂, map_add, mul_add]
      let M' : Type u := Fin δ →₀ R_W'
      let bM' : Module.Basis (Fin δ) R_W' M' := Finsupp.basisSingleOne
      let e'_map : M' ≃+ (Fin δ →₀ R_W'_top) :=
        Finsupp.mapRange.addEquiv W'.topIso.symm.commRingCatIsoToRingEquiv.toAddEquiv
      let e' : M' ≃+ S_U' :=
        ((e'_map.trans bM_W_top.repr.symm.toAddEquiv).trans e_W_top).trans
          U'.topIso.commRingCatIsoToRingEquiv.toAddEquiv
      refine ⟨M', inferInstance, inferInstance, e', ?_, ⟨bM'⟩⟩
      intro b m'
      have h_smul' : e'_map (b • m') = W'.topIso.inv.hom b • e'_map m' := by
        ext i
        exact map_mul W'.topIso.inv.hom b (m' i)
      change U'.topIso.hom.hom (e_W_top (bM_W_top.repr.symm (e'_map (b • m')))) =
        (φ_tilde.app W').hom b * U'.topIso.hom.hom (e_W_top (bM_W_top.repr.symm (e'_map m')))
      rw [h_smul', map_smul, he_W_top, map_mul, h_res_W']

    
    have hChart_etale : ∀ {X₀ S₀ : AlgebraicGeometry.Scheme.{u}} (f₀ : X₀ ⟶ S₀),
        WeilTopDegFiniteLocallyFreeOfRank δ f₀ →
        ∀ (U : S₀.Etale) (O₀ : S₀.Opens)
          (x : ↥((AlgebraicGeometry.Scheme.Etale.forget S₀).obj U).left),
