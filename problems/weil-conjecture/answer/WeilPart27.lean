  have hg₂ : g₂ ≠ 0 := hg₂_eq ▸ hg₂_ne

  obtain ⟨M₁_raw, hAdd_M₁_raw, hMod_M₁_raw, bM₁_raw, eM₁_raw, heM₁_raw, hFin_g₁_raw, hTens₁_raw⟩ :=
