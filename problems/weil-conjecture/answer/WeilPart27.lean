  have hEdge_pkg : ∀ δ : ℕ,
      WeilPolyP1ModelTraceEdgeSyzygyPkg n δ (δ + 1)
        (weilPolyP1Over k δ).left (@hc_all) (@hr_all) (E_edge_fam δ) :=
    fun δ => Classical.choose_spec (hEdge_ex δ)
  have hHz_std : ∀ (δ b : ℕ), 3 ≤ b → CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage (π_fst δ) b
        (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n)) :=
    fun δ b hb =>
      hVan_R_b δ (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n) b
        (hTor_const (weilPolyP1Over k (δ + 1)).left) hb
  let stepHom : ∀ δ : ℕ,
      weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left n (2 * (δ + 1)) →+
        weilEtaleTorsionH (weilPolyP1Over k δ).left n (2 * δ) :=
    fun δ => weilPolyP1ModelStepHom (π_fst δ) n (2 * δ) (2 * (δ + 1)) (Tr_rel δ)
      (E_edge_fam δ (weilPolyP1Over k (δ + 1)).left (π_fst δ)
        (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n)
        (hTor_const (weilPolyP1Over k (δ + 1)).left)
        (hHz_std δ))
  let tr_Pd : ∀ δ : ℕ,
      weilEtaleTorsionH (weilPolyP1Over k δ).left n (2 * δ) →+ ZMod n :=
    Nat.rec (tr_0 k) (fun δ tr_prev => tr_prev.comp (stepHom δ))
  have hBij_Pd : ∀ δ : ℕ, Function.Bijective (tr_Pd δ) := by
    intro δ
    induction δ with
    | zero => exact (hSpec.2.1 k).1
    | succ δ ih =>
      exact ih.comp (hStepHom_bij (π_fst δ) (2 * δ) (2 * (δ + 1))
        (Tr_rel δ) (γ_rel δ) (hStep δ).1 (hStep δ).2.1 _)
  refine ⟨tr_P1, tr_Pd, hBij_P1, hBij_Pd, hCD_Pd, (hSpec.2.1 k).2.1, ?_, ?_, ?_⟩
  · intro P₁_ov hP1 ι_1 tr_1 hι htr hInt1 s_inf hs_sec hs_disj
    subst hP1
    cases eq_of_heq hι
    cases eq_of_heq htr
    have hInt_eq : hInt1 = hInt_1 := Subsingleton.elim _ _
    subst hInt_eq
    exact hDiv_P1 s_inf hs_sec hs_disj
  · intro P₁_ov P_1 hP1 hP_1 π₂_0 tr_1 tr_P_1 hπ₂ htr1 htrP1 p_snd0 hp_snd0 w
    subst hP1
    subst hP_1
    cases eq_of_heq hπ₂
    cases eq_of_heq htr1
    cases eq_of_heq htrP1
    exact (hStep 0).2.2.1 (E_edge_fam 0) (hEdge_pkg 0) rfl rfl
      (hTor_const (weilPolyP1Over k 1).left)
      (hHz_std 0)
      p_snd0 hp_snd0 w
      (weilPolyP1TorsionHExtEquiv (weilPolyP1Over k 1).left n 2 (p_snd0 w))
      (stepHom 0 (p_snd0 w))
      HEq.rfl HEq.rfl
  · rintro _ rfl _ rfl δ _ rfl _ _ rfl rfl _ _ _ _ rfl rfl rfl rfl
    have hInd_tr : ∀ (w : weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left n (2 * (δ + 1)))
        (w_ext : CategoryTheory.Abelian.Ext
          ((CategoryTheory.constantSheaf (weilPolyP1Over k (δ + 1)).left.smallEtaleTopology
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
          (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n) (2 * (δ + 1)))
        (u_base : weilEtaleTorsionH (weilPolyP1Over k δ).left n (2 * δ)),
        HEq w_ext w →
        HEq u_base
          ((CategoryTheory.Abelian.Ext.mk₀ (Tr_rel δ)).postcomp
            ((CategoryTheory.constantSheaf (weilPolyP1Over k δ).left.smallEtaleTopology
              AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
            (Nat.add_zero (2 * δ))
            (E_edge_fam δ (weilPolyP1Over k (δ + 1)).left (π_fst δ)
              (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n)
              (hTor_const (weilPolyP1Over k (δ + 1)).left) (hHz_std δ) w_ext)) →
        tr_Pd (δ + 1) w = tr_Pd δ u_base := by
      intro w w_ext u_base hw_ext hu_base
      have hw' : w_ext =
          weilPolyP1TorsionHExtEquiv (weilPolyP1Over k (δ + 1)).left n (2 * (δ + 1)) w :=
        hExtEq (weilPolyP1Over k (δ + 1)).left (2 * (δ + 1)) w_ext w hw_ext
      rw [hw'] at hu_base
      have hu' : u_base = stepHom δ w :=
        hSymmEq (weilPolyP1Over k δ).left (2 * δ) u_base _ hu_base
      rw [hu']
      rfl
    exact ⟨Tr_rel δ, γ_rel δ, E_edge_fam δ, (hStep δ).1, (hStep δ).2.1, (hEdge_pkg δ).1,
      ⟨hTor_const (weilPolyP1Over k (δ + 1)).left, hHz_std δ, hInd_tr⟩,
      (hStep δ).2.2.2.1,
      (hStep δ).2.2.2.2 (E_edge_fam δ) (hEdge_pkg δ) (tr_Pd δ) (tr_Pd (δ + 1))
        (hTor_const (weilPolyP1Over k (δ + 1)).left) (hHz_std δ) hInd_tr⟩

theorem weil_top_deg_krullDim_integral_compl_and_isFinite_preimage (k : Type u) [Field k]
    (d : ℕ) :
    (∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsIntegral Z.left)
        [AlgebraicGeometry.LocallyOfFiniteType Z.hom],
      (∀ (W : Z.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W) (_ : Nonempty ↥W),
        let A_W := ↑(Z.left.presheaf.obj (Opposite.op W))
        let kAlgW : Algebra k A_W :=
          RingHom.toAlgebra (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ W le_top)))
        IsDomain A_W ∧ @Algebra.FiniteType k A_W _ _ kAlgW) ∧
      (∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [Algebra k A₀],
        Algebra.trdeg k A₀ = (d : Cardinal.{u}) →
        ∀ (j₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A₀)) Z.left)
          (_ : AlgebraicGeometry.IsOpenImmersion j₀),
          CategoryTheory.CategoryStruct.comp j₀ Z.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)) →
          topologicalKrullDim Z.left = (d : WithBot ℕ∞))) ∧
    (1 ≤ d →
      ∀ (X : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsIntegral X),
        topologicalKrullDim X = (d : WithBot ℕ∞) →
        ∀ (O : X.Opens) (_ : Nonempty ↥O),
          topologicalKrullDim (weilAltClosedComplIdeal X O).subscheme ≤
            ((d - 1 : ℕ) : WithBot ℕ∞)) ∧
    (∀ (X S : AlgebraicGeometry.Scheme.{u})
        (f : Quiver.Hom X S) [AlgebraicGeometry.IsFinite f]
        (O_S : S.Opens) (m : ℕ),
      topologicalKrullDim (weilAltClosedComplIdeal S O_S).subscheme ≤ (m : WithBot ℕ∞) →
      topologicalKrullDim
        (weilAltClosedComplIdeal X ((TopologicalSpace.Opens.map f.base).obj O_S)).subscheme ≤
          (m : WithBot ℕ∞)) :=
by
  
  have h_le_iff_lt_succ : ∀ (w : WithBot ℕ∞) (m : ℕ),
      w ≤ (m : WithBot ℕ∞) ↔ w < ((m + 1 : ℕ) : WithBot ℕ∞) := by
    intro w m
    induction w using WithBot.recBotCoe with
    | bot =>
      simp [bot_lt_iff_ne_bot]
    | coe a =>
      induction a using ENat.recTopCoe with
      | top =>
        change ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((m : ℕ∞) : WithBot ℕ∞) ↔
          ((⊤ : ℕ∞) : WithBot ℕ∞) < (((m + 1 : ℕ) : ℕ∞) : WithBot ℕ∞)
        rw [WithBot.coe_le_coe, WithBot.coe_lt_coe]
        simp
      | coe n =>
        change ((n : ℕ) : WithBot ℕ∞) ≤ (m : WithBot ℕ∞) ↔
          ((n : ℕ) : WithBot ℕ∞) < ((m + 1 : ℕ) : WithBot ℕ∞)
        norm_cast
        omega
  have h_krullDim_le_nat_iff : ∀ {α : Type u} [Preorder α] (m : ℕ),
      Order.krullDim α ≤ (m : WithBot ℕ∞) ↔ ∀ l : LTSeries α, l.length < m + 1 := by
    intro α _ m
    rw [h_le_iff_lt_succ, Order.krullDim_lt_coe_iff]

  
  have h_open_cover_dim : ∀ (T : Type u) [TopologicalSpace T] [Nonempty T],
      (∀ x : T, ∃ V : TopologicalSpace.Opens T,
        x ∈ V ∧ topologicalKrullDim ↥V = (d : WithBot ℕ∞)) →
      topologicalKrullDim T = (d : WithBot ℕ∞) := by
    intro T _ hNeT hcov
    apply le_antisymm
    · change Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ (d : WithBot ℕ∞)
      rw [h_krullDim_le_nat_iff]
      intro l
      obtain ⟨x₀, hx₀⟩ := (l 0).isIrreducible.nonempty
      obtain ⟨V, hx₀V, hdimV⟩ := hcov x₀
      let f_V : Fin (l.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V := fun i =>
        { carrier := (Subtype.val : ↥V → T) ⁻¹' (l i : Set T)
          isIrreducible' :=
            ⟨⟨⟨x₀, hx₀V⟩, l.strictMono.monotone (Fin.zero_le i) hx₀⟩,
              (l i).isIrreducible.isPreirreducible.preimage V.isOpen.isOpenEmbedding_subtypeVal⟩
          isClosed' := (l i).isClosed.preimage continuous_subtype_val }
      have h_step : ∀ i : Fin l.length, f_V (Fin.castSucc i) < f_V i.succ := by
        intro i
        have hli : l (Fin.castSucc i) < l i.succ := l.step i
        have hli_sub : (l (Fin.castSucc i) : Set T) ⊆ (l i.succ : Set T) := le_of_lt hli
        rw [lt_iff_le_not_ge]
        refine ⟨show (f_V (Fin.castSucc i) : Set ↥V) ⊆ (f_V i.succ : Set ↥V) from
          fun z hz => hli_sub hz, fun h_rev => ?_⟩
        have h_union : (l i.succ : Set T) ⊆ (l (Fin.castSucc i) : Set T) ∪ (V : Set T)ᶜ := by
          intro y hy
          by_cases hyV : y ∈ (V : Set T)
          · exact Or.inl (h_rev (show (⟨y, hyV⟩ : ↥V) ∈ (f_V i.succ : Set ↥V) from hy))
          · exact Or.inr hyV
        rcases isPreirreducible_iff_isClosed_union_isClosed.mp
            (l i.succ).isIrreducible.isPreirreducible _ _
            (l (Fin.castSucc i)).isClosed V.isOpen.isClosed_compl h_union with h1 | h2
        · exact not_le_of_gt hli h1
        · exact h2 (l.strictMono.monotone (Fin.zero_le i.succ) hx₀) hx₀V
      let l_V : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
        { length := l.length, toFun := f_V, step := h_step }
      have h_len : (l.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥V :=
        Order.LTSeries.length_le_krullDim l_V
      rw [hdimV] at h_len
      norm_cast at h_len
      omega
    · obtain ⟨x₀⟩ := hNeT
      obtain ⟨V₀, _, hV₀⟩ := hcov x₀
      have hsub := topologicalKrullDim_subspace_le T (V₀ : Set T)
      change topologicalKrullDim ↥V₀ ≤ topologicalKrullDim T at hsub
      rwa [hV₀] at hsub

  
  have h_closed_compl_dim : 1 ≤ d →
      ∀ (A B : Type u) [TopologicalSpace A] [TopologicalSpace B] [IrreducibleSpace B],
        topologicalKrullDim B = (d : WithBot ℕ∞) →
        ∀ (e : A → B), Topology.IsClosedEmbedding e →
          (∃ x₀ : B, x₀ ∉ Set.range e) →
          topologicalKrullDim A ≤ ((d - 1 : ℕ) : WithBot ℕ∞) := by
    intro hd A B _ _ _ hdimB e he ⟨x₀, hx₀⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds A) ≤ ((d - 1 : ℕ) : WithBot ℕ∞)
    rw [h_krullDim_le_nat_iff, Nat.sub_add_cancel hd]
    intro l
    let g_B : Fin (l.length + 1) → TopologicalSpace.IrreducibleCloseds B := fun i =>
      { carrier := e '' (l i : Set A)
        isIrreducible' := (l i).isIrreducible.image e he.continuous.continuousOn
        isClosed' := he.isClosedMap _ (l i).isClosed }
    have h_step : ∀ i : Fin l.length, g_B (Fin.castSucc i) < g_B i.succ := by
      intro i
      have hli : l (Fin.castSucc i) < l i.succ := l.step i
      have hli_sub : (l (Fin.castSucc i) : Set A) ⊆ (l i.succ : Set A) := le_of_lt hli
      rw [lt_iff_le_not_ge]
      refine ⟨show (g_B (Fin.castSucc i) : Set B) ⊆ (g_B i.succ : Set B) from
        Set.image_mono hli_sub, fun h_rev => ?_⟩
      apply not_le_of_gt hli
      have h_pre := Set.preimage_mono (f := e) (show (g_B i.succ : Set B) ⊆ g_B (Fin.castSucc i) from h_rev)
      simpa [g_B, Set.preimage_image_eq _ he.injective] using h_pre
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds B) :=
      { length := l.length, toFun := g_B, step := h_step }
    let top_B : TopologicalSpace.IrreducibleCloseds B :=
      { carrier := Set.univ
        isIrreducible' := IrreducibleSpace.isIrreducible_univ B
        isClosed' := isClosed_univ }
    have h_lt_top : q.last < top_B := by
      rw [lt_iff_le_not_ge]
      refine ⟨show (q.last : Set B) ⊆ Set.univ from Set.subset_univ _, fun h_univ => hx₀ ?_⟩
      obtain ⟨a, _, rfl⟩ := h_univ (Set.mem_univ x₀)
      exact ⟨a, rfl⟩
    let q' := q.snoc top_B h_lt_top
    have h_len : (q'.length : WithBot ℕ∞) ≤ topologicalKrullDim B :=
      Order.LTSeries.length_le_krullDim q'
    have hq'_len : q'.length = l.length + 1 := rfl
    rw [hq'_len, hdimB] at h_len
    norm_cast at h_len

  
  have h_noether_dim : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
      [Algebra.FiniteType k S],
      Algebra.trdeg k S = (d : Cardinal.{u}) →
      ringKrullDim S = (d : WithBot ℕ∞) := by
    intro S _ _ _ _ htr
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k S
    let R₀ := MvPolynomial (Fin s) k
    let algR₀S : Algebra R₀ S := g.toRingHom.toAlgebra
    letI : Algebra R₀ S := algR₀S
    haveI : IsScalarTower k R₀ S := IsScalarTower.of_algebraMap_eq' (RingHom.ext g.commutes).symm
    haveI : FaithfulSMul k R₀ :=
      (faithfulSMul_iff_algebraMap_injective k R₀).mpr (RingHom.injective (algebraMap k R₀))
    haveI : FaithfulSMul R₀ S :=
      (faithfulSMul_iff_algebraMap_injective R₀ S).mpr hg_inj
    haveI : Algebra.IsIntegral R₀ S := ⟨hg_int⟩
    haveI : Algebra.IsAlgebraic R₀ S := Algebra.IsIntegral.isAlgebraic
    have h_add := trdeg_add_eq k R₀ (A := S)
    rw [trdeg_eq_zero (R := R₀) (A := S), add_zero, htr] at h_add
    have h_tr_R₀ : Algebra.trdeg k R₀ = (s : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain (ι := Fin s) (S := k), Cardinal.mk_fintype (Fin s),
        Fintype.card_fin s, Cardinal.lift_natCast]
    have hs_eq : s = d := Nat.cast_injective (h_tr_R₀.symm.trans h_add)
    have h_dim_R₀ : ringKrullDim R₀ = (d : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing (R := k) (ι := Fin s),
        ringKrullDim_eq_zero_of_field k, zero_add, ENat.card_eq_coe_fintype_card,
        Fintype.card_fin, hs_eq]
      simp
    apply le_antisymm
    · have h_strict : StrictMono (PrimeSpectrum.comap g.toRingHom) := by
        intro q₁ q₂ hlt
        rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
        have hlt_id : q₁.asIdeal < q₂.asIdeal := (PrimeSpectrum.asIdeal_lt_asIdeal q₁ q₂).mpr hlt
        obtain ⟨x, hx₂, hx₁⟩ := SetLike.exists_of_lt hlt_id
        exact @Ideal.under_lt_under_of_integral_mem_sdiff R₀ _ S _ q₁.asIdeal q₂.asIdeal
          algR₀S q₁.isPrime (le_of_lt hlt_id) x ⟨hx₂, hx₁⟩ (hg_int x)
      exact (Order.krullDim_le_of_strictMono _ h_strict).trans (le_of_eq h_dim_R₀)
    · have h_le_R₀ : (d : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum R₀) :=
        le_of_eq h_dim_R₀.symm
      obtain ⟨l₀, hl₀_len⟩ := Order.le_krullDim_iff.mp h_le_R₀
      have h_lift : ∀ n : ℕ, (hn : n ≤ l₀.length) →
          ∃ l_S : LTSeries (PrimeSpectrum S),
            l_S.length = n ∧
            PrimeSpectrum.comap g.toRingHom l_S.last = l₀ ⟨n, Nat.lt_succ_of_le hn⟩ := by
        intro n
        induction n with
        | zero =>
          intro hn
          have hker : RingHom.ker (algebraMap R₀ S) ≤ (l₀ ⟨0, Nat.lt_succ_of_le hn⟩).asIdeal := by
            intro x hx
            rw [RingHom.mem_ker] at hx
            have hx0 : x = 0 := hg_inj (hx.trans (map_zero g).symm)
            rw [hx0]
            exact Ideal.zero_mem _
          obtain ⟨Q₀, hQ₀_prime, hQ₀_under⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain
              (S := S) (l₀ ⟨0, Nat.lt_succ_of_le hn⟩).asIdeal hker
          refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, ?_⟩
          exact PrimeSpectrum.ext hQ₀_under
        | succ n ih =>
          intro hn1
          obtain ⟨l_S, hl_len, hl_last⟩ := ih (Nat.le_of_succ_le hn1)
          let p_n := l₀ ⟨n, Nat.lt_succ_of_le (Nat.le_of_succ_le hn1)⟩
          let p_succ := l₀ ⟨n + 1, Nat.lt_succ_of_le hn1⟩
          have hp_lt : p_n < p_succ :=
            l₀.strictMono (show (⟨n, _⟩ : Fin (l₀.length + 1)) < ⟨n + 1, _⟩ from Nat.lt_succ_self n)
          have h_under_eq : Ideal.under R₀ l_S.last.asIdeal = p_n.asIdeal :=
            congrArg PrimeSpectrum.asIdeal hl_last
          have h_under_le : Ideal.under R₀ l_S.last.asIdeal ≤ p_succ.asIdeal := by
            rw [h_under_eq]
            exact (PrimeSpectrum.asIdeal_le_asIdeal p_n p_succ).mpr (le_of_lt hp_lt)
          obtain ⟨Q₁, hQ₁_ge, hQ₁_prime, hQ₁_under⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
              p_succ.asIdeal l_S.last.asIdeal h_under_le
          let q₁ : PrimeSpectrum S := ⟨Q₁, hQ₁_prime⟩
          have hq_lt : l_S.last < q₁ := by
            rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
            refine lt_of_le_of_ne hQ₁_ge ?_
            intro h_eq
            apply ne_of_lt ((PrimeSpectrum.asIdeal_lt_asIdeal p_n p_succ).mpr hp_lt)
            rw [← h_under_eq, h_eq, hQ₁_under]
          refine ⟨l_S.snoc q₁ hq_lt, by simp [hl_len], ?_⟩
          rw [RelSeries.last_snoc]
          exact PrimeSpectrum.ext hQ₁_under
      obtain ⟨l_S, hl_S_len, _⟩ := h_lift l₀.length le_rfl
      have h_len := Order.LTSeries.length_le_krullDim l_S
      rwa [hl_S_len, hl₀_len] at h_len

  
  have h_res_trdeg : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
      (U' U : Y.Opens) (hU' : AlgebraicGeometry.IsAffineOpen U') [Nonempty ↥U'.toScheme]
      (hU : AlgebraicGeometry.IsAffineOpen U) [Nonempty ↥U.toScheme] (hle : U' ≤ U)
      (algU : Algebra k ↑(Y.presheaf.obj (Opposite.op U)))
      (algU' : Algebra k ↑(Y.presheaf.obj (Opposite.op U'))),
      (∀ c : k,
        (Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom (@algebraMap k _ _ _ algU c) =
          @algebraMap k _ _ _ algU' c) →
      @Algebra.trdeg k ↑(Y.presheaf.obj (Opposite.op U)) _ _ algU =
        @Algebra.trdeg k ↑(Y.presheaf.obj (Opposite.op U')) _ _ algU' := by
    intro Y _ U' U hU' _ hU _ hle algU algU' hcomm
    let R_U := ↑(Y.presheaf.obj (Opposite.op U))
    let R_U' := ↑(Y.presheaf.obj (Opposite.op U'))
    let res : R_U →+* R_U' := (Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom
    haveI : IrreducibleSpace ↥Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y
    haveI : IsDomain R_U := AlgebraicGeometry.IsIntegral.component_integral U
    haveI : IsDomain R_U' := AlgebraicGeometry.IsIntegral.component_integral U'
    haveI : IsFractionRing R_U ↑Y.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y U hU
    haveI : IsFractionRing R_U' ↑Y.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y U' hU'
    have h_germ_comp :
        CategoryTheory.CategoryStruct.comp
          (Y.presheaf.map (CategoryTheory.homOfLE hle).op)
          (Y.germToFunctionField U') = Y.germToFunctionField U :=
      TopCat.Presheaf.germ_res Y.presheaf (CategoryTheory.homOfLE hle) (genericPoint ↥Y) _
    have h_germ_eq : ∀ a : R_U,
        algebraMap R_U' ↑Y.functionField (res a) = algebraMap R_U ↑Y.functionField a := by
      intro a
      exact congrArg (fun m : Y.presheaf.obj (Opposite.op U) ⟶ Y.functionField => m.hom a)
        h_germ_comp
    have h_res_inj : Function.Injective res := by
      intro a₁ a₂ heq
      apply IsFractionRing.injective R_U ↑Y.functionField
      rw [← h_germ_eq a₁, ← h_germ_eq a₂, heq]
    letI : Algebra k R_U := algU
    letI : Algebra k R_U' := algU'
    let algRes : Algebra R_U R_U' := res.toAlgebra
    letI : Algebra R_U R_U' := algRes
    haveI : IsScalarTower k R_U R_U' :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext hcomm).symm
    haveI : FaithfulSMul k R_U :=
      (faithfulSMul_iff_algebraMap_injective k R_U).mpr (RingHom.injective (algebraMap k R_U))
    haveI : FaithfulSMul R_U R_U' :=
      (faithfulSMul_iff_algebraMap_injective R_U R_U').mpr h_res_inj
    haveI : Algebra.IsAlgebraic R_U R_U' := by
      refine ⟨fun a' => ?_⟩
      obtain ⟨⟨num, den⟩, hmul⟩ :=
        IsLocalization.surj (nonZeroDivisors R_U) (algebraMap R_U' ↑Y.functionField a')
      have h_clear : a' * res (den : R_U) = res num := by
        apply IsFractionRing.injective R_U' ↑Y.functionField
        rw [map_mul, h_germ_eq (den : R_U), hmul, h_germ_eq num]
      refine ⟨Polynomial.C (den : R_U) * Polynomial.X - Polynomial.C num, ?_, ?_⟩
      · intro hP0
        have h_coeff := congrArg (fun q : Polynomial R_U => q.coeff 1) hP0
        simp at h_coeff
      · rw [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
          Polynomial.eval₂_C, Polynomial.eval₂_X, Polynomial.eval₂_C]
        change res (den : R_U) * a' - res num = 0
        rw [mul_comm, h_clear, sub_self]
    have h_tr := trdeg_add_eq k R_U (A := R_U')
    rw [trdeg_eq_zero (R := R_U) (A := R_U'), add_zero] at h_tr
    exact h_tr

  
  have h_finite_preimage_dim : ∀ (X S : AlgebraicGeometry.Scheme.{u})
      (f : Quiver.Hom X S) [AlgebraicGeometry.IsFinite f]
      (Z_X Z_S : Type u) [TopologicalSpace Z_X] [TopologicalSpace Z_S]
      (e_X : Z_X → ↥X) (_ : Topology.IsClosedEmbedding e_X)
      (e_S : Z_S → ↥S) (_ : Topology.IsClosedEmbedding e_S),
      (∀ z : Z_X, f.base (e_X z) ∈ Set.range e_S) →
      topologicalKrullDim Z_X ≤ topologicalKrullDim Z_S := by
    intro X S f _ Z_X Z_S _ _ e_X he_X e_S he_S h_maps
    haveI : AlgebraicGeometry.IsProper f := AlgebraicGeometry.IsProper.instOfIsFinite f
    have hf_closed : IsClosedMap (f : ↥X → ↥S) := f.isClosedMap
    have hf_cont : Continuous (f : ↥X → ↥S) := f.continuous
    let Φ : TopologicalSpace.IrreducibleCloseds Z_X →
        TopologicalSpace.IrreducibleCloseds Z_S := fun C =>
      let F_C : Set ↥X := e_X '' (C : Set Z_X)
      let G_C : Set ↥S := (f : ↥X → ↥S) '' F_C
      have hF_irred : IsIrreducible F_C := C.isIrreducible.image e_X he_X.continuous.continuousOn
      have hF_cl : IsClosed F_C := he_X.isClosedMap _ C.isClosed
      have hG_irred : IsIrreducible G_C := hF_irred.image _ hf_cont.continuousOn
      have hG_cl : IsClosed G_C := hf_closed _ hF_cl
      have hG_sub : G_C ⊆ Set.range e_S := by
        rintro _ ⟨_, ⟨z, _, rfl⟩, rfl⟩
        exact h_maps z
      { carrier := e_S ⁻¹' G_C
        isIrreducible' := by
          refine ⟨?_, ?_⟩
          · obtain ⟨y, hy⟩ := hG_irred.nonempty
            obtain ⟨w, rfl⟩ := hG_sub hy
            exact ⟨w, hy⟩
          · rw [isPreirreducible_iff_isClosed_union_isClosed]
            intro K₁ K₂ hK₁ hK₂ hsub
            have h_img_D : e_S '' (e_S ⁻¹' G_C) = G_C := Set.image_preimage_eq_of_subset hG_sub
            have hsubG : G_C ⊆ (e_S '' K₁) ∪ (e_S '' K₂) := by
              rw [← h_img_D, ← Set.image_union]
              exact Set.image_mono hsub
            rcases isPreirreducible_iff_isClosed_union_isClosed.mp hG_irred.isPreirreducible
                _ _ (he_S.isClosedMap _ hK₁) (he_S.isClosedMap _ hK₂) hsubG with h1 | h2
            · left
              simpa [Set.preimage_image_eq _ he_S.injective] using Set.preimage_mono (f := e_S) h1
            · right
              simpa [Set.preimage_image_eq _ he_S.injective] using Set.preimage_mono (f := e_S) h2
        isClosed' := hG_cl.preimage he_S.continuous }
    have hΦ_strict : StrictMono Φ := by
      intro C₁ C₂ hlt
      rw [lt_iff_le_not_ge]
      have hlt_sub : (C₁ : Set Z_X) ⊆ (C₂ : Set Z_X) := le_of_lt hlt
      have hle : Φ C₁ ≤ Φ C₂ := by
        rintro z ⟨_, ⟨w, hw, rfl⟩, hx⟩
        exact ⟨e_X w, ⟨w, hlt_sub hw, rfl⟩, hx⟩
      refine ⟨hle, fun h_rev => ?_⟩
      let F₁ : Set ↥X := e_X '' (C₁ : Set Z_X)
      let F₂ : Set ↥X := e_X '' (C₂ : Set Z_X)
      have hF₁_irred : IsIrreducible F₁ := C₁.isIrreducible.image e_X he_X.continuous.continuousOn
      have hF₁_cl : IsClosed F₁ := he_X.isClosedMap _ C₁.isClosed
      have hF₂_irred : IsIrreducible F₂ := C₂.isIrreducible.image e_X he_X.continuous.continuousOn
      have hF₂_cl : IsClosed F₂ := he_X.isClosedMap _ C₂.isClosed
      have hF_sub : F₁ ⊆ F₂ := Set.image_mono hlt_sub
      have hF_ne : F₁ ≠ F₂ := by
        intro hF
        apply not_le_of_gt hlt
        have h_pre := Set.preimage_mono (f := e_X) (le_of_eq hF.symm)
        simpa [F₁, F₂, Set.preimage_image_eq _ he_X.injective] using h_pre
      have hG₁_sub : (f : ↥X → ↥S) '' F₁ ⊆ Set.range e_S := by
        rintro _ ⟨_, ⟨z, _, rfl⟩, rfl⟩; exact h_maps z
      have hG₂_sub : (f : ↥X → ↥S) '' F₂ ⊆ Set.range e_S := by
        rintro _ ⟨_, ⟨z, _, rfl⟩, rfl⟩; exact h_maps z
      have hD_eq : (Φ C₁ : Set Z_S) = (Φ C₂ : Set Z_S) :=
        Set.Subset.antisymm hle h_rev
      have hG_eq : (f : ↥X → ↥S) '' F₁ = (f : ↥X → ↥S) '' F₂ := by
        calc
          (f : ↥X → ↥S) '' F₁ = e_S '' (Φ C₁ : Set Z_S) :=
            (Set.image_preimage_eq_of_subset hG₁_sub).symm
          _ = e_S '' (Φ C₂ : Set Z_S) := by rw [hD_eq]
          _ = (f : ↥X → ↥S) '' F₂ := Set.image_preimage_eq_of_subset hG₂_sub
      let η₁ : ↥X := hF₁_irred.genericPoint
      let η₂ : ↥X := hF₂_irred.genericPoint
      have hcl₁ : closure ({η₁} : Set ↥X) = F₁ := hF₁_irred.closure_genericPoint hF₁_cl
      have hcl₂ : closure ({η₂} : Set ↥X) = F₂ := hF₂_irred.closure_genericPoint hF₂_cl
      have hη₁_mem : η₁ ∈ F₁ := (hF₁_irred.isGenericPoint_genericPoint hF₁_cl).mem
      have hη₁_cl₂ : η₁ ∈ closure ({η₂} : Set ↥X) := hcl₂ ▸ hF_sub hη₁_mem
      have hη_ne : η₁ ≠ η₂ := fun h => hF_ne (by rw [← hcl₁, ← hcl₂, h])
      have h_cl_img : closure ({(f : ↥X → ↥S) η₁} : Set ↥S) =
          closure ({(f : ↥X → ↥S) η₂} : Set ↥S) := by
        calc
          closure ({(f : ↥X → ↥S) η₁} : Set ↥S)
            = closure ((f : ↥X → ↥S) '' {η₁}) := by rw [Set.image_singleton]
          _ = (f : ↥X → ↥S) '' closure ({η₁} : Set ↥X) :=
            IsClosedMap.closure_image_eq_of_continuous hf_closed hf_cont {η₁}
          _ = (f : ↥X → ↥S) '' F₁ := by rw [hcl₁]
          _ = (f : ↥X → ↥S) '' F₂ := hG_eq
          _ = (f : ↥X → ↥S) '' closure ({η₂} : Set ↥X) := by rw [hcl₂]
          _ = closure ((f : ↥X → ↥S) '' {η₂}) :=
            (IsClosedMap.closure_image_eq_of_continuous hf_closed hf_cont {η₂}).symm
          _ = closure ({(f : ↥X → ↥S) η₂} : Set ↥S) := by rw [Set.image_singleton]
      have hf_eq : (f : ↥X → ↥S) η₁ = (f : ↥X → ↥S) η₂ :=
        Inseparable.eq (inseparable_iff_closure_eq.mpr h_cl_img)
      obtain ⟨V_S, hV_S, hs₀_V, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (X := S) (U := ⊤) (x := (f : ↥X → ↥S) η₂) trivial
      let U_X : X.Opens := (TopologicalSpace.Opens.map f.base).obj V_S
      have hU_X : AlgebraicGeometry.IsAffineOpen U_X := hV_S.preimage f
      have hη₂_U : η₂ ∈ U_X := hs₀_V
      have hη₁_U : η₁ ∈ U_X := by
        change (f : ↥X → ↥S) η₁ ∈ V_S
        rwa [hf_eq]
      let x₁ : ↥U_X := ⟨η₁, hη₁_U⟩
      let x₂ : ↥U_X := ⟨η₂, hη₂_U⟩
      have hx_ne : x₁ ≠ x₂ := fun h => hη_ne (congrArg Subtype.val h)
      have hx₁_cl₂ : x₁ ∈ closure ({x₂} : Set ↥U_X) := by
        rw [closure_subtype, Set.image_singleton]
        exact hη₁_cl₂
      let homeo_U : ↥U_X ≃ₜ ↥(AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U_X))) :=
        TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso hU_X.isoSpec)
      let q₁ : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U_X)) := homeo_U x₁
      let q₂ : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U_X)) := homeo_U x₂
      have hq_ne : q₁ ≠ q₂ := fun h => hx_ne (homeo_U.injective h)
      have hq₁_cl₂ : q₁ ∈ closure ({q₂} : Set _) := by
        change homeo_U x₁ ∈ closure ({homeo_U x₂} : Set _)
        rw [← Set.image_singleton, ← Homeomorph.image_closure]
        exact ⟨x₁, hx₁_cl₂, rfl⟩
      have hq_le : q₂.asIdeal ≤ q₁.asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal q₂ q₁).mpr
          ((PrimeSpectrum.le_iff_specializes q₂ q₁).mpr
            (specializes_iff_mem_closure.mpr hq₁_cl₂))
      have hq_lt : q₂.asIdeal < q₁.asIdeal :=
        lt_of_le_of_ne hq_le (fun h => hq_ne (PrimeSpectrum.ext h.symm))
      let φ_mor := f.appLE V_S U_X le_rfl
      let φ_ring : ↑(S.presheaf.obj (Opposite.op V_S)) →+*
          ↑(X.presheaf.obj (Opposite.op U_X)) := φ_mor.hom
      have h_sq :
          hU_X.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_mor ≫ hV_S.fromSpec =
            U_X.ι ≫ f := by
        calc
          hU_X.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_mor ≫ hV_S.fromSpec
            = hU_X.isoSpec.hom ≫ hU_X.fromSpec ≫ f := by
              rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hV_S hU_X le_rfl]
          _ = (hU_X.isoSpec.hom ≫ hU_X.isoSpec.inv ≫ U_X.ι) ≫ f := by
              rw [AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hU_X, Category.assoc]
          _ = U_X.ι ≫ f := by
              rw [Iso.hom_inv_id_assoc]
      have h_pt_eq :
          (AlgebraicGeometry.Spec.map φ_mor) (homeo_U x₁) =
            (AlgebraicGeometry.Spec.map φ_mor) (homeo_U x₂) := by
        apply hV_S.fromSpec.isOpenEmbedding.injective
        have h1 := congrArg (fun m : U_X.toScheme ⟶ S => (m : ↥U_X → ↥S) x₁) h_sq
        have h2 := congrArg (fun m : U_X.toScheme ⟶ S => (m : ↥U_X → ↥S) x₂) h_sq
        change hV_S.fromSpec ((AlgebraicGeometry.Spec.map φ_mor) (homeo_U x₁)) =
          (f : ↥X → ↥S) η₁ at h1
        change hV_S.fromSpec ((AlgebraicGeometry.Spec.map φ_mor) (homeo_U x₂)) =
          (f : ↥X → ↥S) η₂ at h2
        rw [h1, h2, hf_eq]
      have h_comap_spec : PrimeSpectrum.comap φ_ring q₁ = PrimeSpectrum.comap φ_ring q₂ :=
        (AlgebraicGeometry.Spec.map_apply φ_mor (homeo_U x₁)).symm.trans
          (h_pt_eq.trans (AlgebraicGeometry.Spec.map_apply φ_mor (homeo_U x₂)))
      have h_comap_eq : Ideal.comap φ_ring q₁.asIdeal = Ideal.comap φ_ring q₂.asIdeal :=
        congrArg PrimeSpectrum.asIdeal h_comap_spec
      obtain ⟨a, ha₁, ha₂⟩ := SetLike.exists_of_lt hq_lt
      have h_fin_φ : φ_ring.Finite := by
        have h_app_eq : f.app V_S = φ_mor := AlgebraicGeometry.Scheme.Hom.app_eq_appLE f
        have h_fin := f.finite_app V_S hV_S
        rwa [h_app_eq] at h_fin
      have h_int_a := h_fin_φ.to_isIntegral a
      have h_under_lt :=
        @Ideal.under_lt_under_of_integral_mem_sdiff _ _ _ _ q₂.asIdeal q₁.asIdeal
          φ_ring.toAlgebra q₂.isPrime (le_of_lt hq_lt) a ⟨ha₁, ha₂⟩ h_int_a
      exact ne_of_lt h_under_lt h_comap_eq.symm
    exact Order.krullDim_le_of_strictMono Φ hΦ_strict

  
