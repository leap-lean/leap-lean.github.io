  have hφ_cov_base : ∀ (α : Fin r_cov) (q : PrimeSpectrum (C_cov α)),
      h_Z₀.base ((hAff_cov α).fromSpec.base q) =
        ι_m'.base (PrimeSpectrum.comap (φ_cov α).toRingHom q) := by
    intro α q
    have hfac : g_cov α ≫ ι_m' = (hAff_cov α).fromSpec ≫ h_Z₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    have hpt := congrArg (fun φ => φ.base q) hfac.symm
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply (hAff_cov α).fromSpec h_Z₀ q,
      AlgebraicGeometry.Scheme.Hom.comp_apply (g_cov α) ι_m' q] at hpt
    rw [hpt]
    congr 1
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_cov α).toRingHom) = g_cov α :=
      AlgebraicGeometry.Spec.map_preimage (g_cov α)
    rw [← hmap]
    exact AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (φ_cov α).toRingHom) q

  
  obtain ⟨h_B, hh_B_ne, hg₁_ne, hg₂_ne, hh_B_spec⟩ :=
    @hClear k _ m d hmd g₁₀ g₂₀ _hg₁₀ _hg₂₀ r_cov C_cov _ algC hFT_cov hDim_cov φ_cov
  obtain ⟨g₁, hg₁_eq⟩ : ∃ x : R₀, x = π_head h_B * g₁₀ := ⟨_, rfl⟩
  obtain ⟨g₂, hg₂_eq⟩ : ∃ x : R₀, x = π_head h_B * g₂₀ := ⟨_, rfl⟩
