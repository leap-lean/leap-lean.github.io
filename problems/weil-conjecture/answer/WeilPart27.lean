        fun U i => G₁.obj.map (j_c U i).op ≫ φ_good (V_c U i) ((hj_spec U).2 i)
      have hx_c : ∀ (U : 𝒞) ⦃W : 𝒞⦄ ⦃i₁ i₂ : Idx_c U⦄
