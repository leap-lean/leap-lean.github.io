        obtain ⟨w, hw⟩ := h_surj_jVP ⟨x, hx⟩
        refine ⟨w, ?_⟩
        change j_Γ w = x
        rw [← hj_VP, AlgebraicGeometry.Scheme.Hom.comp_apply, hw]
        rfl
  · intro X S φ A B _ _ ψ m M _ _ bM eM heM iso_X iso_S hφ
    have hφ_eq : φ =
        CategoryTheory.CategoryStruct.comp iso_X.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) iso_S.inv) := by
      rw [← hφ, CategoryTheory.Iso.hom_inv_id_assoc]
    haveI : AlgebraicGeometry.IsAffine X := AlgebraicGeometry.IsAffine.of_isIso iso_X.hom
    haveI : AlgebraicGeometry.IsAffine S := AlgebraicGeometry.IsAffine.of_isIso iso_S.hom
    have hFin_φ : AlgebraicGeometry.IsFinite φ := by
      letI : Algebra B A := ψ.toAlgebra
      let e_lin : M ≃ₗ[B] A :=
        { eM with map_smul' := fun b x => heM b x }
      haveI : Module.Finite B M := Module.Finite.of_basis bM
      have hFin_ψ : RingHom.Finite ψ := Module.Finite.equiv e_lin
      haveI : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom ψ)).mpr hFin_ψ
      rw [hφ_eq]
      infer_instance
    refine ⟨hFin_φ, fun y => ?_⟩
    refine ⟨(⊤ : S.Opens), trivial, AlgebraicGeometry.isAffineOpen_top S,
      AlgebraicGeometry.isAffineOpen_top X,
      Fin m → ↑(S.presheaf.obj (Opposite.op (⊤ : S.Opens))),
      inferInstance, inferInstance, ?_⟩
    let iso_top_S : S.presheaf.obj (Opposite.op (⊤ : S.Opens)) ≅
        (AlgebraicGeometry.Spec (CommRingCat.of B)).presheaf.obj (Opposite.op ⊤) :=
      { hom := AlgebraicGeometry.Scheme.Hom.appTop iso_S.inv
        inv := AlgebraicGeometry.Scheme.Hom.appTop iso_S.hom
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_S.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_S.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    let iso_top_X : (AlgebraicGeometry.Spec (CommRingCat.of A)).presheaf.obj (Opposite.op ⊤) ≅
        X.presheaf.obj (Opposite.op (⊤ : X.Opens)) :=
      { hom := AlgebraicGeometry.Scheme.Hom.appTop iso_X.hom
        inv := AlgebraicGeometry.Scheme.Hom.appTop iso_X.inv
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_X.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_X.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    let α_B : ↑(S.presheaf.obj (Opposite.op (⊤ : S.Opens))) ≃+* B :=
      (CategoryTheory.Iso.trans iso_top_S
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B))).commRingCatIsoToRingEquiv
    let α_A : A ≃+* ↑(X.presheaf.obj (Opposite.op (⊤ : X.Opens))) :=
      (CategoryTheory.Iso.trans
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).symm
        iso_top_X).commRingCatIsoToRingEquiv
    have h_app_top : ∀ r : ↑(S.presheaf.obj (Opposite.op (⊤ : S.Opens))),
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app φ (⊤ : S.Opens))) r =
          α_A (ψ (α_B r)) := by
      intro r
      have h_mor : AlgebraicGeometry.Scheme.Hom.appTop φ =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appTop iso_S.inv)
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).hom)
            (CategoryTheory.CategoryStruct.comp
              (CommRingCat.ofHom ψ)
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv
                (AlgebraicGeometry.Scheme.Hom.appTop iso_X.hom))) := by
        rw [hφ_eq, AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.Hom.comp_appTop]
        have h_nat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ψ)
        have h_spec_app :
            AlgebraicGeometry.Scheme.Hom.appTop
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).hom
              (CategoryTheory.CategoryStruct.comp
                (CommRingCat.ofHom ψ)
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv) := by
          rw [← CategoryTheory.cancel_mono
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom,
            h_nat]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.comp_id]
        rw [h_spec_app]
        simp only [CategoryTheory.Category.assoc]
      change (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop φ)) r = _
      rw [h_mor]
      rfl
    let e₁ : (Fin m → ↑(S.presheaf.obj (Opposite.op (⊤ : S.Opens)))) ≃+ (Fin m → B) :=
      AddEquiv.piCongrRight (fun _ => α_B.toAddEquiv)
    let e₂ : (Fin m → B) ≃+ M := bM.equivFun.symm.toAddEquiv
    let e₃ : M ≃+ ↑(X.presheaf.obj (Opposite.op (⊤ : X.Opens))) :=
      eM.trans α_A.toAddEquiv
    let e_top : (Fin m → ↑(S.presheaf.obj (Opposite.op (⊤ : S.Opens)))) ≃+
        ↑(X.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map φ.base).obj (⊤ : S.Opens)))) :=
      e₁.trans (e₂.trans e₃)
    refine ⟨e_top, ?_, ⟨Pi.basisFun ↑(S.presheaf.obj (Opposite.op (⊤ : S.Opens))) (Fin m)⟩⟩
    intro b c
    have he₁ : e₁ (b • c) = α_B b • e₁ c := by
      ext i
      exact map_mul α_B b (c i)
    have he₂ : e₂ (α_B b • e₁ c) = α_B b • e₂ (e₁ c) :=
      bM.equivFun.symm.map_smul (α_B b) (e₁ c)
    change α_A (eM (e₂ (e₁ (b • c)))) = _
    rw [he₁, he₂, heM, map_mul, h_app_top]
    rfl

theorem weil_top_deg_transBasis_loc_basis_and_annihilator (k : Type u) [Field k] (d : ℕ) :
    let R₀ := MvPolynomial (Fin d) k
    (∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A]
        (w : Fin d → A) (_ : IsTranscendenceBasis k w)
        (g : R₀) (_ : g ≠ 0),
      let ψ : R₀ →+* A := (MvPolynomial.aeval w).toRingHom
      let A_g := Localization.Away (ψ g)
      Function.Injective ψ ∧
      ψ g ≠ 0 ∧
      IsDomain A_g ∧
      Algebra.trdeg k A_g = (d : Cardinal.{u})) ∧
    (∀ (A A' : Type u) [CommRing A] [IsDomain A] [Algebra k A]
        [CommRing A'] [IsDomain A'] [Algebra k A']
        (ρ : A →ₐ[k] A'),
      Function.Injective ρ →
      RingHom.Finite ρ.toRingHom →
      ∀ (w : Fin d → A),
        IsTranscendenceBasis k w →
        IsTranscendenceBasis k (fun i : Fin d => ρ (w i))) ∧
    (∀ (B A : Type u) [CommRing B] [IsDomain B] [CommRing A] [IsDomain A]
        (ψ : B →+* A),
      Function.Injective ψ →
      (∀ (g h g' : B), g ≠ 0 → h ≠ 0 → g * h = g' →
        ∀ (m : ℕ) (M : Type u) [AddCommGroup M] [Module (Localization.Away g) M]
          (_ : Module.Basis (Fin m) (Localization.Away g) M)
          (eM : M ≃+ Localization.Away (ψ g)),
          (∀ b x, eM (b • x) = Localization.awayMap ψ g b * eM x) →
          ∃ eM' : (Fin m → Localization.Away g') ≃+ Localization.Away (ψ g'),
            ∀ (b : Localization.Away g') (x : Fin m → Localization.Away g'),
              eM' (b • x) = Localization.awayMap ψ g' b * eM' x) ∧
      (∀ (g₁ : B) (_ : g₁ ≠ 0) (m₁ : ℕ)
          (M₁ : Type u) [AddCommGroup M₁] [Module (Localization.Away g₁) M₁]
          (_ : Module.Basis (Fin m₁) (Localization.Away g₁) M₁)
          (eM₁ : M₁ ≃+ Localization.Away (ψ g₁))
          (_ : ∀ b x, eM₁ (b • x) = Localization.awayMap ψ g₁ b * eM₁ x)
          (g₂ : B) (_ : g₂ ≠ 0) (m₂ : ℕ)
          (M₂ : Type u) [AddCommGroup M₂] [Module (Localization.Away g₂) M₂]
          (_ : Module.Basis (Fin m₂) (Localization.Away g₂) M₂)
          (eM₂ : M₂ ≃+ Localization.Away (ψ g₂))
          (_ : ∀ b x, eM₂ (b • x) = Localization.awayMap ψ g₂ b * eM₂ x),
        m₁ = m₂)) ∧
    (∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A]
        (w : Fin d → A) (_ : IsTranscendenceBasis k w)
        (f₀ : A) (_ : f₀ ≠ 0),
      let ψ : R₀ →+* A := (MvPolynomial.aeval w).toRingHom
      ∃ (c₀ : R₀) (q₀ : A), c₀ ≠ 0 ∧ ψ c₀ = f₀ * q₀) ∧
    ((∀ {B' B A A' : Type u} [CommRing B'] [CommRing B] [CommRing A] [CommRing A']
        (β : B' ≃+* B) (α : A ≃+* A') (ψ : B →+* A) (ψ' : B' →+* A'),
        (∀ b', α (ψ (β b')) = ψ' b') →
        ∀ (m : ℕ) (M : Type u) [AddCommGroup M] [Module B M]
          (_ : Module.Basis (Fin m) B M) (eM : M ≃+ A),
          (∀ b x, eM (b • x) = ψ b * eM x) →
          ∃ eM' : (Fin m → B') ≃+ A',
            ∀ (b' : B') (x : Fin m → B'), eM' (b' • x) = ψ' b' * eM' x) ∧
      (∀ {B A₁ A₂ : Type u} [CommRing B] [CommRing A₁] [CommRing A₂]
          (ψ₁ : B →+* A₁) (ψ₂ : A₁ →+* A₂) (m δ : ℕ)
          (M₁ : Type u) [AddCommGroup M₁] [Module B M₁]
          (_ : Module.Basis (Fin m) B M₁) (eM₁ : M₁ ≃+ A₁)
          (_ : ∀ b x, eM₁ (b • x) = ψ₁ b * eM₁ x)
          (M₂ : Type u) [AddCommGroup M₂] [Module A₁ M₂]
          (_ : Module.Basis (Fin δ) A₁ M₂) (eM₂ : M₂ ≃+ A₂)
          (_ : ∀ a x, eM₂ (a • x) = ψ₂ a * eM₂ x),
        ∃ eM₁₂ : (Fin (m * δ) → B) ≃+ A₂,
          ∀ (b : B) (x : Fin (m * δ) → B), eM₁₂ (b • x) = (ψ₂.comp ψ₁) b * eM₁₂ x)) :=
by
  intro R₀
  have hAlg_R₀ : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A]
      (w : Fin d → A), IsTranscendenceBasis k w →
      ∀ (x : A), ∃ P₀ : Polynomial R₀,
        P₀ ≠ 0 ∧ Polynomial.eval₂ (MvPolynomial.aeval w).toRingHom x P₀ = 0 := by
    intro A _ _ _ w hw x
    obtain ⟨hw_ind, hw_alg⟩ :=
      isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hw
    let ψ : R₀ →+* A := (MvPolynomial.aeval w).toRingHom
    have hψ_inj : Function.Injective ψ :=
      algebraicIndependent_iff_injective_aeval.mp hw_ind
    set S_w : Subalgebra k A := Algebra.adjoin k (Set.range w)
    have h_range : S_w = (MvPolynomial.aeval w).range :=
      Algebra.adjoin_range_eq_range_aeval k w
    let φ_Sw : R₀ →+* ↥S_w :=
      { toFun := fun p => ⟨ψ p, by rw [h_range]; exact ⟨p, rfl⟩⟩
        map_one' := Subtype.ext (map_one ψ)
        map_mul' := fun a b => Subtype.ext (map_mul ψ a b)
        map_zero' := Subtype.ext (map_zero ψ)
        map_add' := fun a b => Subtype.ext (map_add ψ a b) }
    have hφ_inj : Function.Injective φ_Sw :=
      fun p₁ p₂ h => hψ_inj (congrArg Subtype.val h)
    have hφ_surj : Function.Surjective φ_Sw := by
      rintro ⟨a, ha⟩
      rw [h_range] at ha
      rcases ha with ⟨p, hp⟩
      exact ⟨p, Subtype.ext hp⟩
    let e_orig : R₀ ≃+* ↥S_w := RingEquiv.ofBijective φ_Sw ⟨hφ_inj, hφ_surj⟩
    let e_Sw : ↥S_w ≃+* R₀ := e_orig.symm
    have h_comp : ψ.comp (e_Sw : ↥S_w →+* R₀) = algebraMap ↥S_w A := by
      ext s
      exact congrArg Subtype.val (e_orig.apply_symm_apply s)
    obtain ⟨P₁, hP₁_ne, hP₁_ev⟩ := hw_alg.isAlgebraic x
    let P₀ : Polynomial R₀ := Polynomial.map (e_Sw : ↥S_w →+* R₀) P₁
    have hP₀_ne : P₀ ≠ 0 := by
      intro h0
      exact hP₁_ne (Polynomial.map_injective (e_Sw : ↥S_w →+* R₀) e_Sw.injective
        (h0.trans (Polynomial.map_zero (e_Sw : ↥S_w →+* R₀)).symm))
    refine ⟨P₀, hP₀_ne, ?_⟩
    dsimp [P₀]
    rw [Polynomial.eval₂_map]
    change Polynomial.eval₂ (ψ.comp ↑e_Sw) x P₁ = 0
    rw [h_comp, ← Polynomial.aeval_def, hP₁_ev]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  
  · intro A _ _ _ w hw g hg ψ A_g
    have hw_ind : AlgebraicIndependent k w :=
      (isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hw).1
    have hψ_inj : Function.Injective ψ :=
      algebraicIndependent_iff_injective_aeval.mp hw_ind
    have hψg_ne : ψ g ≠ 0 := by
      intro h0
      apply hg
      apply hψ_inj
      rw [h0, map_zero]
    have h_pow : Submonoid.powers (ψ g) ≤ nonZeroDivisors A :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hψg_ne)
    have hDom_Ag : IsDomain A_g := IsLocalization.isDomain_localization h_pow
    refine ⟨hψ_inj, hψg_ne, hDom_Ag, ?_⟩
    let : IsDomain A_g := hDom_Ag
    have : FaithfulSMul k A :=
      (faithfulSMul_iff_algebraMap_injective k A).mpr (RingHom.injective (algebraMap k A))
    have : FaithfulSMul A A_g :=
      (faithfulSMul_iff_algebraMap_injective A A_g).mpr (IsLocalization.injective A_g h_pow)
    have : Algebra.IsAlgebraic A A_g := IsLocalization.isAlgebraic A_g (Submonoid.powers (ψ g))
    have h_trdeg_zero : Algebra.trdeg A A_g = 0 := trdeg_eq_zero
    have h_trdeg_add : Algebra.trdeg k A + Algebra.trdeg A A_g = Algebra.trdeg k A_g :=
      trdeg_add_eq k A (A := A_g)
    rw [h_trdeg_zero, add_zero] at h_trdeg_add
    have h_card := hw.lift_cardinalMk_eq_trdeg
    simp only [Cardinal.mk_fintype, Fintype.card_fin, Cardinal.lift_natCast,
      Cardinal.lift_uzero] at h_card
    rw [← h_trdeg_add, ← h_card]
  
  · intro A A' _ _ _ _ _ _ ρ hρ_inj hFin w hw
    obtain ⟨hw_ind, _⟩ :=
      isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hw
    have h_comp : MvPolynomial.aeval (fun i : Fin d => ρ (w i)) =
        ρ.comp (MvPolynomial.aeval w) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [MvPolynomial.aeval_X, AlgHom.comp_apply]
    have hψ'_inj : Function.Injective (MvPolynomial.aeval (R := k) (fun i : Fin d => ρ (w i))) := by
      rw [h_comp]
      exact hρ_inj.comp (algebraicIndependent_iff_injective_aeval.mp hw_ind)
    rw [isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic]
    refine ⟨algebraicIndependent_iff_injective_aeval.mpr hψ'_inj, ?_⟩
    let algR₀A : Algebra R₀ A := (MvPolynomial.aeval w).toRingHom.toAlgebra
    let algAA' : Algebra A A' := ρ.toRingHom.toAlgebra
    let algR₀A' : Algebra R₀ A' :=
      (ρ.toRingHom.comp (MvPolynomial.aeval w).toRingHom).toAlgebra
    have : IsScalarTower R₀ A A' := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.IsAlgebraic R₀ A :=
      ⟨fun x => by
        obtain ⟨P₀, hP₀_ne, hP₀_ev⟩ := hAlg_R₀ A w hw x
        refine ⟨P₀, hP₀_ne, ?_⟩
        rw [Polynomial.aeval_def]
        exact hP₀_ev⟩
    have : Algebra.IsIntegral A A' := ⟨hFin.to_isIntegral⟩
    have : Algebra.IsAlgebraic A A' := Algebra.IsIntegral.isAlgebraic
    have hAlgR₀A' : Algebra.IsAlgebraic R₀ A' := Algebra.IsAlgebraic.trans R₀ A A'
    set S_ρw : Subalgebra k A' := Algebra.adjoin k (Set.range (fun i : Fin d => ρ (w i)))
    have h_range_ρw : S_ρw = (MvPolynomial.aeval (fun i : Fin d => ρ (w i))).range :=
      Algebra.adjoin_range_eq_range_aeval k (fun i : Fin d => ρ (w i))
    let ψ' : R₀ →+* A' := (MvPolynomial.aeval (fun i : Fin d => ρ (w i))).toRingHom
    let φ_ρw : R₀ →+* ↥S_ρw :=
      { toFun := fun p => ⟨ψ' p, by rw [h_range_ρw]; exact ⟨p, rfl⟩⟩
        map_one' := Subtype.ext (map_one ψ')
        map_mul' := fun a b => Subtype.ext (map_mul ψ' a b)
        map_zero' := Subtype.ext (map_zero ψ')
        map_add' := fun a b => Subtype.ext (map_add ψ' a b) }
    have hφ_ρw_inj : Function.Injective φ_ρw :=
      fun p₁ p₂ h => hψ'_inj (congrArg Subtype.val h)
    refine ⟨fun y => ?_⟩
    obtain ⟨P, hP_ne, hP_ev⟩ := @Algebra.IsAlgebraic.isAlgebraic R₀ A' _ _ algR₀A' hAlgR₀A' y
    have hP'_ne : Polynomial.map φ_ρw P ≠ 0 := by
      intro h0
      exact hP_ne (Polynomial.map_injective φ_ρw hφ_ρw_inj
        (h0.trans (Polynomial.map_zero φ_ρw).symm))
    refine ⟨Polynomial.map φ_ρw P, hP'_ne, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    have h_hom_eq : (algebraMap ↥S_ρw A').comp φ_ρw =
        @algebraMap R₀ A' _ _ algR₀A' := by
      apply RingHom.ext
      intro p
      exact AlgHom.congr_fun h_comp p
    rw [h_hom_eq]
    rw [Polynomial.aeval_def] at hP_ev
    exact hP_ev
  
  · intro B A _ _ _ _ ψ hψ_inj
    have hAwayEq : ∀ (x : B) (r : B),
        Localization.awayMap ψ x (algebraMap B (Localization.Away x) r) =
          algebraMap A (Localization.Away (ψ x)) (ψ r) := by
      intro x r
      exact IsLocalization.Away.lift_eq x
        (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (ψ x)) (ψ x)) r
    have h3a : ∀ (g h g' : B), g ≠ 0 → h ≠ 0 → g * h = g' →
        ∀ (m : ℕ) (M : Type u) [AddCommGroup M] [Module (Localization.Away g) M]
          (_ : Module.Basis (Fin m) (Localization.Away g) M)
          (eM : M ≃+ Localization.Away (ψ g)),
          (∀ b x, eM (b • x) = Localization.awayMap ψ g b * eM x) →
          ∃ eM' : (Fin m → Localization.Away g') ≃+ Localization.Away (ψ g'),
            ∀ (b : Localization.Away g') (x : Fin m → Localization.Away g'),
              eM' (b • x) = Localization.awayMap ψ g' b * eM' x := by
      intro g h g' hg hh hgh m M _ _ bM eM heM
      subst hgh
      let B_g := Localization.Away g
      let B_gh := Localization.Away (g * h)
      let A_g := Localization.Away (ψ g)
      let A_gh := Localization.Away (ψ (g * h))
      let ψ_g : B_g →+* A_g := Localization.awayMap ψ g
      let ψ_gh : B_gh →+* A_gh := Localization.awayMap ψ (g * h)
      have hgh_ne : g * h ≠ 0 := mul_ne_zero hg hh
      have hψgh_ne : ψ (g * h) ≠ 0 := by
        intro h0
        apply hgh_ne
        apply hψ_inj
        rw [h0, map_zero]
      have h_inj_Agh : Function.Injective (algebraMap A A_gh) :=
        IsLocalization.injective A_gh
          (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hψgh_ne))
      let u_B : B_gh := IsLocalization.Away.invSelf (S := B_gh) (g * h)
      let u_A : A_gh := IsLocalization.Away.invSelf (S := A_gh) (ψ (g * h))
      have hu_Bg : IsUnit (algebraMap B B_gh g) := by
        have hmul : algebraMap B B_gh g * (algebraMap B B_gh h * u_B) = 1 := by
          rw [← mul_assoc, ← map_mul]
          exact IsLocalization.Away.mul_invSelf (S := B_gh) (g * h)
        exact ⟨⟨algebraMap B B_gh g, algebraMap B B_gh h * u_B, hmul, by rw [mul_comm, hmul]⟩, rfl⟩
      have hu_Ag : IsUnit (algebraMap A A_gh (ψ g)) := by
        have hmul : algebraMap A A_gh (ψ g) * (algebraMap A A_gh (ψ h) * u_A) = 1 := by
          rw [← mul_assoc, ← map_mul, ← map_mul ψ g h]
          exact IsLocalization.Away.mul_invSelf (S := A_gh) (ψ (g * h))
        exact ⟨⟨algebraMap A A_gh (ψ g), algebraMap A A_gh (ψ h) * u_A, hmul,
          by rw [mul_comm, hmul]⟩, rfl⟩
      let β₁ : B_g →+* B_gh := IsLocalization.Away.lift g hu_Bg
      let α₁ : A_g →+* A_gh := IsLocalization.Away.lift (ψ g) hu_Ag
      have hβ₁_eq : ∀ r : B, β₁ (algebraMap B B_g r) = algebraMap B B_gh r :=
        IsLocalization.Away.lift_eq g hu_Bg
      have hα₁_eq : ∀ a : A, α₁ (algebraMap A A_g a) = algebraMap A A_gh a :=
        IsLocalization.Away.lift_eq (ψ g) hu_Ag
      have h_αψ : ∀ b : B_g, α₁ (ψ_g b) = ψ_gh (β₁ b) := by
        have h_ext : α₁.comp ψ_g = ψ_gh.comp β₁ := by
          refine IsLocalization.ringHom_ext (Submonoid.powers g) ?_
          ext r
          simp only [RingHom.comp_apply]
          change α₁ (Localization.awayMap ψ g (algebraMap B B_g r)) =
            Localization.awayMap ψ (g * h) (β₁ (algebraMap B B_g r))
          rw [hAwayEq g r, hα₁_eq, hβ₁_eq, hAwayEq (g * h) r]
        exact fun b => RingHom.congr_fun h_ext b
      have hα₁_inj : Function.Injective α₁ := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨k₀, a, hza⟩ := IsLocalization.Away.surj (ψ g) z
        have h_app : α₁ (z * algebraMap A A_g (ψ g) ^ k₀) = α₁ (algebraMap A A_g a) :=
          congrArg α₁ hza
        rw [map_mul α₁, hz, zero_mul, hα₁_eq] at h_app
        have ha0 : a = 0 := h_inj_Agh (h_app.symm.trans (map_zero _).symm)
        rw [ha0, map_zero] at hza
        exact ((IsLocalization.Away.algebraMap_isUnit (S := A_g) (ψ g)).pow k₀).mul_left_eq_zero.mp hza
      let v : Fin m → A_gh := fun i => α₁ (eM (bM i))
      let F : (Fin m → B_gh) →+ A_gh :=
        { toFun := fun c => ∑ i : Fin m, ψ_gh (c i) * v i
          map_zero' := by simp
          map_add' := fun x y => by
            simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib] }
      have hF_smul : ∀ (b : B_gh) (c : Fin m → B_gh), F (b • c) = ψ_gh b * F c := by
        intro b c
        change (∑ i : Fin m, ψ_gh (b * c i) * v i) = ψ_gh b * ∑ i : Fin m, ψ_gh (c i) * v i
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul ψ_gh, mul_assoc]
      have hF_surj : Function.Surjective F := by
        intro z
        obtain ⟨n, a, hza⟩ := IsLocalization.Away.surj (ψ (g * h)) z
        have hu_inv : algebraMap A A_gh (ψ (g * h)) * ψ_gh u_B = 1 := by
          rw [← hAwayEq (g * h) (g * h), ← map_mul ψ_gh]
          exact (congrArg ψ_gh (IsLocalization.Away.mul_invSelf (S := B_gh) (g * h))).trans
            (map_one ψ_gh)
        have hu_pow : algebraMap A A_gh (ψ (g * h)) ^ n * ψ_gh (u_B ^ n) = 1 := by
          rw [map_pow ψ_gh u_B n, ← mul_pow, hu_inv, one_pow]
        have hz_eq : z = ψ_gh (u_B ^ n) * α₁ (algebraMap A A_g a) := by
          calc
            z = z * 1 := (mul_one z).symm
            _ = z * (algebraMap A A_gh (ψ (g * h)) ^ n * ψ_gh (u_B ^ n)) := by rw [← hu_pow]
            _ = (z * algebraMap A A_gh (ψ (g * h)) ^ n) * ψ_gh (u_B ^ n) := (mul_assoc _ _ _).symm
            _ = algebraMap A A_gh a * ψ_gh (u_B ^ n) := by rw [hza]
            _ = ψ_gh (u_B ^ n) * α₁ (algebraMap A A_g a) := by rw [mul_comm, hα₁_eq]
        let x₀ : M := eM.symm (algebraMap A A_g a)
        let c₀ : Fin m → B_g := bM.equivFun x₀
        have ha_exp : α₁ (algebraMap A A_g a) = F (fun i => β₁ (c₀ i)) := by
          have hx₀ : ∑ i : Fin m, c₀ i • bM i = x₀ := bM.sum_equivFun x₀
          have he₀ : eM (∑ i : Fin m, c₀ i • bM i) = algebraMap A A_g a := by
            rw [hx₀, eM.apply_symm_apply]
          rw [map_sum] at he₀
          have he₀' : algebraMap A A_g a = ∑ i : Fin m, ψ_g (c₀ i) * eM (bM i) := by
            rw [← he₀]
            exact Finset.sum_congr rfl fun i _ => heM (c₀ i) (bM i)
          rw [he₀', map_sum]
          change (∑ i : Fin m, α₁ (ψ_g (c₀ i) * eM (bM i))) =
            ∑ i : Fin m, ψ_gh (β₁ (c₀ i)) * v i
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul α₁, h_αψ]
        refine ⟨u_B ^ n • fun i => β₁ (c₀ i), ?_⟩
        rw [hF_smul, ← ha_exp, ← hz_eq]
      have hF_inj : Function.Injective F := by
        rw [injective_iff_map_eq_zero]
        intro c hc
        choose n r hnr using fun i : Fin m => IsLocalization.Away.surj (g * h) (c i)
        let N : ℕ := Finset.univ.sup n
        let r' : Fin m → B := fun i => r i * (g * h) ^ (N - n i)
        have hN_c : ∀ i : Fin m,
            algebraMap B B_gh (g * h) ^ N * c i = β₁ (algebraMap B B_g (r' i)) := by
          intro i
          have hi : n i ≤ N := Finset.le_sup (Finset.mem_univ i)
          have h_add : n i + (N - n i) = N := Nat.add_sub_of_le hi
          calc
            algebraMap B B_gh (g * h) ^ N * c i
              = c i * algebraMap B B_gh (g * h) ^ (n i + (N - n i)) := by
                  rw [mul_comm, h_add]
            _ = (c i * algebraMap B B_gh (g * h) ^ (n i)) *
                  algebraMap B B_gh (g * h) ^ (N - n i) := by
                  rw [pow_add, mul_assoc]
            _ = algebraMap B B_gh (r i) * algebraMap B B_gh ((g * h) ^ (N - n i)) := by
                  rw [hnr i, map_pow]
            _ = algebraMap B B_gh (r' i) := (map_mul _ _ _).symm
            _ = β₁ (algebraMap B B_g (r' i)) := (hβ₁_eq (r' i)).symm
        have h_sum_zero : α₁ (eM (∑ i : Fin m, algebraMap B B_g (r' i) • bM i)) = 0 := by
          have h0 : F (algebraMap B B_gh (g * h) ^ N • c) = 0 := by
            rw [hF_smul, hc, mul_zero]
          have h_eq : F (algebraMap B B_gh (g * h) ^ N • c) =
              α₁ (eM (∑ i : Fin m, algebraMap B B_g (r' i) • bM i)) := by
            rw [map_sum eM, map_sum α₁]
            change (∑ i : Fin m, ψ_gh (algebraMap B B_gh (g * h) ^ N * c i) * v i) =
              ∑ i : Fin m, α₁ (eM (algebraMap B B_g (r' i) • bM i))
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hN_c i, ← h_αψ, heM, map_mul α₁]
          rw [← h_eq, h0]
        have h_m_zero : ∑ i : Fin m, algebraMap B B_g (r' i) • bM i = 0 :=
          eM.injective (hα₁_inj (by rw [h_sum_zero, map_zero, map_zero]))
        have h_symm : bM.equivFun.symm (fun i => algebraMap B B_g (r' i)) = 0 := by
          rw [bM.equivFun_symm_apply]
          exact h_m_zero
        have h_fun_zero : (fun i : Fin m => algebraMap B B_g (r' i)) = 0 :=
          bM.equivFun.symm.injective (by rw [h_symm, map_zero])
        funext i
        have hr'_zero : algebraMap B B_g (r' i) = 0 := congrFun h_fun_zero i
        have hci_zero : algebraMap B B_gh (g * h) ^ N * c i = 0 := by
          rw [hN_c i, hr'_zero, map_zero]
        exact ((IsLocalization.Away.algebraMap_isUnit (S := B_gh) (g * h)).pow N).mul_right_eq_zero.mp
          hci_zero
      let eM' : (Fin m → B_gh) ≃+ A_gh := AddEquiv.ofBijective F ⟨hF_inj, hF_surj⟩
      exact ⟨eM', hF_smul⟩
    refine ⟨h3a, ?_⟩
    intro g₁ hg₁ m₁ M₁ _ _ bM₁ eM₁ heM₁ g₂ hg₂ m₂ M₂ _ _ bM₂ eM₂ heM₂
    let g₁₂ := g₁ * g₂
    have hg₁₂ : g₁₂ ≠ 0 := mul_ne_zero hg₁ hg₂
    obtain ⟨e₁, he₁⟩ := h3a g₁ g₂ g₁₂ hg₁ hg₂ rfl m₁ M₁ bM₁ eM₁ heM₁
    obtain ⟨e₂, he₂⟩ := h3a g₂ g₁ g₁₂ hg₂ hg₁ (mul_comm g₂ g₁) m₂ M₂ bM₂ eM₂ heM₂
    let B₁₂ := Localization.Away g₁₂
    let A₁₂ := Localization.Away (ψ g₁₂)
    let : Algebra B₁₂ A₁₂ := (Localization.awayMap ψ g₁₂).toAlgebra
    let eL₁ : (Fin m₁ → B₁₂) ≃ₗ[B₁₂] A₁₂ := { e₁ with map_smul' := he₁ }
    let eL₂ : (Fin m₂ → B₁₂) ≃ₗ[B₁₂] A₁₂ := { e₂ with map_smul' := he₂ }
    have : IsDomain B₁₂ :=
      IsLocalization.isDomain_localization
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg₁₂))
    have : InvariantBasisNumber B₁₂ := invariantBasisNumber_of_nontrivial_of_commRing
    exact InvariantBasisNumber.eq_of_fin_equiv (eL₁.trans eL₂.symm)
  
  · intro A _ _ _ w hw f₀ hf₀ ψ
    obtain ⟨P₀, hP₀_ne, hP₀_ev⟩ := hAlg_R₀ A w hw f₀
    let r : ℕ := P₀.natTrailingDegree
    let c₀ : R₀ := P₀.coeff r
    have hc₀ : c₀ ≠ 0 := Polynomial.coeff_natTrailingDegree_ne_zero.mpr hP₀_ne
    have h_dvd : Polynomial.X ^ (r + 1) ∣ P₀ - Polynomial.monomial r c₀ := by
      rw [Polynomial.X_pow_dvd_iff]
      intro m hm
      rw [Polynomial.coeff_sub]
      by_cases hmr : m = r
      · subst hmr
        rw [Polynomial.coeff_monomial_same]
        exact sub_self c₀
      · have hlt : m < r := by omega
        rw [Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hlt]
        simp only [Polynomial.coeff_monomial, Ne.symm hmr, ↓reduceIte, sub_zero]
    rcases h_dvd with ⟨H, hH⟩
    have hP₀_eq : P₀ = Polynomial.monomial r c₀ + Polynomial.X ^ (r + 1) * H := by
      rw [← hH]
      ring
    have h_ev_fac : f₀ ^ r * (ψ c₀ + f₀ * Polynomial.eval₂ ψ f₀ H) = 0 := by
      have h0 : Polynomial.eval₂ ψ f₀ P₀ = 0 := hP₀_ev
      rw [hP₀_eq, Polynomial.eval₂_add, Polynomial.eval₂_monomial,
        Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at h0
      calc
        f₀ ^ r * (ψ c₀ + f₀ * Polynomial.eval₂ ψ f₀ H)
          = ψ c₀ * f₀ ^ r + f₀ ^ (r + 1) * Polynomial.eval₂ ψ f₀ H := by
              rw [pow_succ]
              ring
        _ = 0 := h0
    have hf₀_pow : f₀ ^ r ≠ 0 := pow_ne_zero r hf₀
    have h_lin : ψ c₀ + f₀ * Polynomial.eval₂ ψ f₀ H = 0 :=
      (mul_eq_zero.mp h_ev_fac).resolve_left hf₀_pow
    refine ⟨c₀, -Polynomial.eval₂ ψ f₀ H, hc₀, ?_⟩
    rw [mul_neg]
    exact eq_neg_of_add_eq_zero_left h_lin
  
  · refine ⟨?_, ?_⟩
    · intro B' B A A' _ _ _ _ β α ψ ψ' hcomm m M _ _ bM eM heM
      let e₁ : (Fin m → B') ≃+ (Fin m → B) :=
        AddEquiv.piCongrRight (fun _ => β.toAddEquiv)
      let e₂ : (Fin m → B) ≃+ M := bM.equivFun.symm.toAddEquiv
      let e₃ : M ≃+ A' := eM.trans α.toAddEquiv
      let eM' : (Fin m → B') ≃+ A' := (e₁.trans e₂).trans e₃
      refine ⟨eM', fun b' x => ?_⟩
      have he₁ : e₁ (b' • x) = β b' • e₁ x := by
        funext i
        exact map_mul β b' (x i)
      change α (eM (bM.equivFun.symm (e₁ (b' • x)))) =
        ψ' b' * α (eM (bM.equivFun.symm (e₁ x)))
      rw [he₁, bM.equivFun.symm.map_smul, heM, map_mul, hcomm]
    · intro B A₁ A₂ _ _ _ ψ₁ ψ₂ m δ M₁ _ _ bM₁ eM₁ heM₁ M₂ _ _ bM₂ eM₂ heM₂
      let algBA₁ : Algebra B A₁ := ψ₁.toAlgebra
      let algA₁A₂ : Algebra A₁ A₂ := ψ₂.toAlgebra
      let algBA₂ : Algebra B A₂ := (ψ₂.comp ψ₁).toAlgebra
      have : IsScalarTower B A₁ A₂ := IsScalarTower.of_algebraMap_eq' rfl
      let eL₁ : M₁ ≃ₗ[B] A₁ := { eM₁ with map_smul' := heM₁ }
      let eL₂ : M₂ ≃ₗ[A₁] A₂ := { eM₂ with map_smul' := heM₂ }
      let b₁₂ : Module.Basis (Fin (m * δ)) B A₂ :=
        ((bM₁.map eL₁).smulTower (bM₂.map eL₂)).reindex finProdFinEquiv
      refine ⟨b₁₂.equivFun.symm.toAddEquiv, fun b x => ?_⟩
      exact b₁₂.equivFun.symm.map_smul b x

theorem weil_top_deg_affineOpen_away_iso_and_finiteFree_pullback (k : Type u) [Field k]
    (d : ℕ) :
    let R₀ := MvPolynomial (Fin d) k
    ((∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
        let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
        let kAlgW : Algebra k A_W :=
          RingHom.toAlgebra (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
        CategoryTheory.CategoryStruct.comp hW.fromSpec Y.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (@algebraMap k A_W _ _ kAlgW))) ∧
      (∀ (P_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_d : Quiver.Hom (weilAffineSpaceOver k d).left P_ov.left)
          (hOpen_d : AlgebraicGeometry.IsOpenImmersion ι_d),
        CategoryTheory.CategoryStruct.comp ι_d P_ov.hom =
          (weilAffineSpaceOver k d).hom →
        letI := hOpen_d
        let W_aff : P_ov.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_d
        ∀ (hAff_P : AlgebraicGeometry.IsAffineOpen W_aff)
          (x_std : Fin d → ↑(P_ov.left.presheaf.obj (Opposite.op W_aff))),
          (∀ i : Fin d,
            (CommRingCat.Hom.hom
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.Hom.appLE ι_d W_aff ⊤ (fun x _ => ⟨x, rfl⟩))
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom))
              (x_std i) = MvPolynomial.X i) →
          let ψ_std := weilTopDegKummerChartEvalHom k d P_ov W_aff x_std
          Function.Bijective ψ_std ∧
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_std)) ι_d =
            hAff_P.fromSpec)) ∧
    (∀ (P_ov Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_d : Quiver.Hom (weilAffineSpaceOver k d).left P_ov.left)
        (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
        (ψ_w : R₀ →+* ↑(Y.left.presheaf.obj (Opposite.op W)))
        (g h g' : R₀),
      g * h = g' →
      ∀ (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (π_Y : Quiver.Hom Γ.left Y.left)
        (π_P : Quiver.Hom Γ.left P_ov.left)
        (U_g : P_ov.left.Opens)
        (iso_Ug : CategoryTheory.Iso U_g.toScheme
          (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))))
        (j_Γ : Quiver.Hom
          (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Γ.left)
        (j_Y : Quiver.Hom
          (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Y.left),
        WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g
          Γ π_Y π_P U_g iso_Ug j_Γ j_Y →
        let u_g' : Quiver.Hom
            (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g'))) P_ov.left :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g'))))
            ι_d
        ∀ (hu_g' : AlgebraicGeometry.IsOpenImmersion u_g'),
          letI := hu_g'
          let U_g' : P_ov.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange u_g'
          U_g' ≤ U_g ∧
          ∃ f_g' : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g')))) Γ.left,
            AlgebraicGeometry.IsOpenImmersion f_g' ∧
            Set.range f_g'.base = π_P.base ⁻¹' (U_g' : Set ↥P_ov.left) ∧
            CategoryTheory.CategoryStruct.comp f_g' π_Y =
              CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap _ (Localization.Away (ψ_w g')))))
                hW.fromSpec ∧
            CategoryTheory.CategoryStruct.comp f_g' π_P =
              CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ_w g')))
                u_g') ∧
    (∀ (X : AlgebraicGeometry.Scheme.{u})
        (W' W : X.Opens)
        (hW' : AlgebraicGeometry.IsAffineOpen W') (_ : Nonempty ↥W')
        (hW : AlgebraicGeometry.IsAffineOpen W)
        (hle : W' ≤ W),
      let res := CommRingCat.Hom.hom
        (X.presheaf.map (Opposite.op (CategoryTheory.homOfLE hle)))
      (∃ f₀ : ↑(X.presheaf.obj (Opposite.op W)), f₀ ≠ 0 ∧ X.basicOpen f₀ ≤ W') ∧
      (∀ (s : ↑(X.presheaf.obj (Opposite.op W)))
          (s' : ↑(X.presheaf.obj (Opposite.op W'))),
        X.basicOpen s ≤ W' →
        res s = s' →
        ∃ ρ : Localization.Away s ≃+* Localization.Away s',
          (∀ x : ↑(X.presheaf.obj (Opposite.op W)),
            ρ (algebraMap _ (Localization.Away s) x) =
              algebraMap _ (Localization.Away s') (res x)) ∧
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom))
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap _ (Localization.Away s))))
              hW.fromSpec) =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap _ (Localization.Away s'))))
              hW'.fromSpec)) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsIntegral Y.left)
        (δ : ℕ) (_ : 1 ≤ δ)
        (φ : Quiver.Hom Y.left Y.left),
      CategoryTheory.CategoryStruct.comp φ Y.hom = Y.hom →
      WeilTopDegFiniteLocallyFreeOfRank δ φ →
      ∀ (V : Y.left.Opens) (hV : AlgebraicGeometry.IsAffineOpen V),
        let U : Y.left.Opens := (TopologicalSpace.Opens.map φ.base).obj V
        let kAlgV : Algebra k ↑(Y.left.presheaf.obj (Opposite.op V)) :=
          RingHom.toAlgebra (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ V le_top)))
        let kAlgU : Algebra k ↑(Y.left.presheaf.obj (Opposite.op U)) :=
          RingHom.toAlgebra (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ U le_top)))
        let φ_V := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app φ V)
        ∀ (hU : AlgebraicGeometry.IsAffineOpen U) (_ : Nonempty ↥U),
          (Function.Injective φ_V ∧
            RingHom.Finite φ_V ∧
            ∀ c : k, φ_V (@algebraMap k _ _ _ kAlgV c) = @algebraMap k _ _ _ kAlgU c) ∧
          (∃ f₀ : ↑(Y.left.presheaf.obj (Opposite.op V)),
            f₀ ≠ 0 ∧
            ∀ (s : ↑(Y.left.presheaf.obj (Opposite.op V)))
              (s' : ↑(Y.left.presheaf.obj (Opposite.op U))),
              s ≠ 0 →
              (∃ q, s = f₀ * q) →
              φ_V s = s' →
              let A_Vs := Localization.Away s
              let A_Us := Localization.Away s'
              let j_YV := CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ A_Vs)))
                hV.fromSpec
              let j_YU := CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ A_Us)))
                hU.fromSpec
              ∃ (φ_loc : A_Vs →+* A_Us)
                (e_δ : (Fin δ → A_Vs) ≃+ A_Us),
                (∀ x : ↑(Y.left.presheaf.obj (Opposite.op V)),
                  φ_loc (algebraMap _ A_Vs x) = algebraMap _ A_Us (φ_V x)) ∧
                (∀ (b : A_Vs) (x : Fin δ → A_Vs), e_δ (b • x) = φ_loc b * e_δ x) ∧
                CategoryTheory.CategoryStruct.comp j_YU φ =
                  CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)) j_YV ∧
                Set.range j_YU.base = φ.base ⁻¹' (Set.range j_YV.base))) :=
by
  classical
  let R₀ := MvPolynomial (Fin d) k
  have h_top_fromSpec : ∀ (R : CommRingCat.{u}),
      (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec R)).fromSpec =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv := by
    intro R
    rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
    have h1 := AlgebraicGeometry.Scheme.isoSpec_inv_toSpecΓ (AlgebraicGeometry.Spec R)
    have h2 := AlgebraicGeometry.SpecMap_ΓSpecIso_inv_toSpecΓ R
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec R).toSpecΓ := by
      rw [← AlgebraicGeometry.Scheme.isoSpec_hom (AlgebraicGeometry.Spec R)]
      infer_instance
    rw [← cancel_mono (AlgebraicGeometry.Spec R).toSpecΓ, h1, h2]

  have hRangeAwayFromSpec : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (O : X.Opens) (hO : AlgebraicGeometry.IsAffineOpen O)
      (r : ↑(X.presheaf.obj (Opposite.op O))),
      Set.range
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap _ (Localization.Away r))))
          hO.fromSpec).base =
        (X.basicOpen r : Set ↥X) := by
    intro X O hO r
    have hfun :
        ⇑(CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap _ (Localization.Away r))))
          hO.fromSpec).base =
        ⇑hO.fromSpec.base ∘
          ⇑(AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap _ (Localization.Away r)))).base := rfl
    rw [hfun, Set.range_comp]
    have hdom :
        Set.range
          ⇑(AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap _ (Localization.Away r)))).base =
        (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum ↑(X.presheaf.obj (Opposite.op O)))) := by
      have heq :
          ⇑(AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap _ (Localization.Away r)))).base =
          PrimeSpectrum.comap (algebraMap ↑(X.presheaf.obj (Opposite.op O)) (Localization.Away r)) := by
        ext p
        exact AlgebraicGeometry.Spec.map_apply _ p
      rw [heq]
      exact PrimeSpectrum.localization_away_comap_range (Localization.Away r) r
    rw [hdom, ← hO.fromSpec_image_basicOpen r]
    rfl

  have hAwayMul : ∀ {R : Type u} [CommRing R] (g h g' : R),
      g * h = g' →
      ∃ β : Localization.Away g →+* Localization.Away g',
        (∀ r : R, β (algebraMap R (Localization.Away g) r) =
          algebraMap R (Localization.Away g') r) ∧
        AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β)) ∧
        (∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))),
          p ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β)).base ↔
            algebraMap R (Localization.Away g) h ∉ p.asIdeal) := by
    rintro R _ g h _ rfl
    let B_g := Localization.Away g
    let B_gh := Localization.Away (g * h)
    have hUnit_gh : IsUnit (algebraMap R B_gh (g * h)) :=
      IsLocalization.Away.algebraMap_isUnit (S := B_gh) (g * h)
    rw [map_mul] at hUnit_gh
    have hUnit_g : IsUnit (algebraMap R B_gh g) := isUnit_of_mul_isUnit_left hUnit_gh
    let β : B_g →+* B_gh := IsLocalization.Away.lift g hUnit_g
    have hβ_alg : ∀ r : R, β (algebraMap R B_g r) = algebraMap R B_gh r :=
      fun r => IsLocalization.Away.lift_eq g hUnit_g r
    let h_Bg : B_g := algebraMap R B_g h
    have hLoc_Bg : @IsLocalization.Away B_g _ h_Bg B_gh _ β.toAlgebra := by
      let T₀ := Localization.Away h_Bg
      have : IsLocalization.Away (g * h) T₀ := IsLocalization.Away.mul' B_g T₀ g h
      let e_R : T₀ ≃ₐ[R] B_gh :=
        IsLocalization.algEquiv (Submonoid.powers (g * h)) T₀ B_gh
      have he_Bg : ∀ x : B_g, e_R (algebraMap B_g T₀ x) = β x := by
        have hhom : e_R.toRingHom.comp (algebraMap B_g T₀) = β := by
          refine IsLocalization.ringHom_ext (Submonoid.powers g) ?_
          apply RingHom.ext
          intro r
          change e_R (algebraMap B_g T₀ (algebraMap R B_g r)) = β (algebraMap R B_g r)
          rw [← IsScalarTower.algebraMap_apply R B_g T₀ r, hβ_alg]
          exact e_R.commutes r
        exact fun x => RingHom.congr_fun hhom x
      let e_Bg : @AlgEquiv B_g T₀ B_gh _ _ _ _ β.toAlgebra :=
        letI : Algebra B_g B_gh := β.toAlgebra
        AlgEquiv.ofRingEquiv (f := e_R.toRingEquiv) he_Bg
      exact @IsLocalization.isLocalization_of_algEquiv B_g _ (Submonoid.powers h_Bg)
        T₀ _ _ B_gh _ β.toAlgebra _ e_Bg
    refine ⟨β, hβ_alg, ?_, ?_⟩
    · exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization
        B_g B_gh _ _ β.toAlgebra h_Bg hLoc_Bg
    · intro p
      have hrange :
          Set.range ⇑(AlgebraicGeometry.Spec.map (CommRingCat.ofHom β)).base =
          (PrimeSpectrum.basicOpen h_Bg : Set (PrimeSpectrum B_g)) := by
        let : Algebra B_g B_gh := β.toAlgebra
        have : IsLocalization.Away h_Bg B_gh := hLoc_Bg
        have heq :
            ⇑(AlgebraicGeometry.Spec.map (CommRingCat.ofHom β)).base =
            PrimeSpectrum.comap (algebraMap B_g B_gh) := by
          ext q
          exact AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom β) q
        rw [heq]
        exact PrimeSpectrum.localization_away_comap_range B_gh h_Bg
      change (p : PrimeSpectrum B_g) ∈
          Set.range ⇑(AlgebraicGeometry.Spec.map (CommRingCat.ofHom β)).base ↔
        h_Bg ∉ p.asIdeal
      rw [hrange]
      exact Iff.rfl

  have hBasisInj : ∀ {B A : Type u} [CommRing B] [CommRing A]
      (ψ : B →+* A) {δ : ℕ} (_ : 1 ≤ δ)
      {M : Type u} [AddCommGroup M] [Module B M]
      (bM : Module.Basis (Fin δ) B M) (eM : M ≃+ A),
      (∀ (b : B) (m : M), eM (b • m) = ψ b * eM m) →
      Function.Injective ψ := by
    intro B A _ _ ψ δ hδ M _ _ bM eM heM b₁ b₂ hb_eq
    have hdiff0 : ψ (b₁ - b₂) = 0 := by rw [map_sub, hb_eq, sub_self]
    let idx0 : Fin δ := ⟨0, hδ⟩
    have he0 : eM ((b₁ - b₂) • bM idx0) = eM 0 := by
      rw [heM, hdiff0, zero_mul, map_zero]
    have hsmul0 : (b₁ - b₂) • bM idx0 = 0 := eM.injective he0
    have hrepr0 := congrArg (fun v => (bM.repr v) idx0) hsmul0
    simp only [map_smul, map_zero, Module.Basis.repr_self, Finsupp.smul_single,
      smul_eq_mul, mul_one, Finsupp.single_eq_same, Finsupp.zero_apply] at hrepr0
    exact sub_eq_zero.mp hrepr0

  have hBasisAway : ∀ {B A : Type u} [CommRing B] [CommRing A]
      (ψ : B →+* A) {δ : ℕ}
      {M : Type u} [AddCommGroup M] [Module B M]
      (bM : Module.Basis (Fin δ) B M) (eM : M ≃+ A),
      (∀ (b : B) (m : M), eM (b • m) = ψ b * eM m) →
      ∀ (t : B) {B' A' : Type u} [CommRing B'] [CommRing A']
        (β_iso : B' ≃+* Localization.Away t)
        (α_iso : Localization.Away (ψ t) ≃+* A')
        (ψ' : B' →+* A'),
        (∀ b' : B', α_iso (Localization.awayMap ψ t (β_iso b')) = ψ' b') →
        ∃ e_δ : (Fin δ → B') ≃+ A',
          ∀ (b' : B') (x : Fin δ → B'), e_δ (b' • x) = ψ' b' * e_δ x := by
    intro B A _ _ ψ δ M _ _ bM eM heM t B' A' _ _ β_iso α_iso ψ' h_inter
    let Φ : (Fin δ → B) ≃+ A := bM.equivFun.symm.toAddEquiv.trans eM
    let m_i : Fin δ → M := fun i => bM.equivFun.symm (Pi.single i 1)
    let v : Fin δ → A := fun i => eM (m_i i)
    have h_pi_sum : ∀ c : Fin δ → B,
        c = Finset.univ.sum fun i : Fin δ => c i • Pi.single i (1 : B) := by
      intro c
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    have hΦ_sum : ∀ c : Fin δ → B, Φ c = Finset.univ.sum fun i : Fin δ => ψ (c i) * v i := by
      intro c
      change eM (bM.equivFun.symm c) = _
      conv_lhs => rw [h_pi_sum c]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [LinearEquiv.map_smul, heM]
    let B_t := Localization.Away t
    let A_t := Localization.Away (ψ t)
    let ψ_t : B_t →+* A_t := Localization.awayMap ψ t
    have hψ_t_eq : ∀ r : B, ψ_t (algebraMap B B_t r) = algebraMap A A_t (ψ r) :=
      fun r => IsLocalization.Away.lift_eq t
        (IsLocalization.Away.algebraMap_isUnit (S := A_t) (ψ t)) r
    let Φ_t : (Fin δ → B_t) →+ A_t :=
      AddMonoidHom.mk'
        (fun y => Finset.univ.sum fun i : Fin δ => ψ_t (y i) * algebraMap A A_t (v i))
        (fun y₁ y₂ => by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib])
    have hΦ_t_smul : ∀ (b : B_t) (y : Fin δ → B_t), Φ_t (b • y) = ψ_t b * Φ_t y := by
      intro b y
      change (Finset.univ.sum fun i : Fin δ => ψ_t (b * y i) * algebraMap A A_t (v i)) =
        ψ_t b * (Finset.univ.sum fun i : Fin δ => ψ_t (y i) * algebraMap A A_t (v i))
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, mul_assoc]
    have hΦ_t_alg : ∀ c : Fin δ → B,
        Φ_t (fun i => algebraMap B B_t (c i)) = algebraMap A A_t (Φ c) := by
      intro c
      change (Finset.univ.sum fun i : Fin δ =>
        ψ_t (algebraMap B B_t (c i)) * algebraMap A A_t (v i)) = _
      rw [hΦ_sum c, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hψ_t_eq, map_mul]
    have hInj_Φt : Function.Injective Φ_t := by
      intro y₁ y₂ hy_eq
      suffices h0 : y₁ - y₂ = 0 from sub_eq_zero.mp h0
      set y := y₁ - y₂
      have hy0 : Φ_t y = 0 := by
        dsimp [y]
        rw [map_sub, hy_eq, sub_self]
      have hsurj : ∀ i : Fin δ, ∃ p : ℕ × B,
          y i * (algebraMap B B_t t) ^ p.1 = algebraMap B B_t p.2 := by
        intro i
        obtain ⟨n_i, r_i, h_i⟩ := IsLocalization.Away.surj t (y i)
        exact ⟨(n_i, r_i), h_i⟩
      choose p hp using hsurj
      let N : ℕ := Finset.univ.sup (fun i : Fin δ => (p i).1)
      let r' : Fin δ → B := fun i => (p i).2 * t ^ (N - (p i).1)
      have hr'_eq : ∀ i : Fin δ,
          (algebraMap B B_t t ^ N) * y i = algebraMap B B_t (r' i) := by
        intro i
        have hle : (p i).1 ≤ N := Finset.le_sup (f := fun j : Fin δ => (p j).1) (Finset.mem_univ i)
        have hN : (p i).1 + (N - (p i).1) = N := Nat.add_sub_of_le hle
        dsimp [r']
        rw [map_mul, map_pow, ← hp i, mul_assoc, ← pow_add, hN, mul_comm]
      have h_vec : (algebraMap B B_t t ^ N) • y = fun i => algebraMap B B_t (r' i) := by
        ext i
        exact hr'_eq i
      have halg0 : algebraMap A A_t (Φ r') = algebraMap A A_t 0 := by
        rw [map_zero, ← hΦ_t_alg r', ← h_vec, hΦ_t_smul, hy0, mul_zero]
      obtain ⟨⟨_, ⟨k_exp, rfl⟩⟩, hk0⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers (ψ t)) A_t).mp halg0
      change (ψ t) ^ k_exp * Φ r' = (ψ t) ^ k_exp * 0 at hk0
      rw [mul_zero] at hk0
      have hΦ_k : Φ (fun i => t ^ k_exp * r' i) = 0 := by
        rw [hΦ_sum, ← hk0, hΦ_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, map_pow, mul_assoc]
      have hr'_ann : ∀ i : Fin δ, t ^ k_exp * r' i = 0 := by
        have hfun0 : (fun i => t ^ k_exp * r' i) = 0 :=
          Φ.injective (hΦ_k.trans (map_zero Φ).symm)
        exact fun i => congrFun hfun0 i
      ext i
      have h_unit : IsUnit (algebraMap B B_t t ^ (k_exp + N)) :=
        (IsLocalization.Away.algebraMap_isUnit (S := B_t) t).pow (k_exp + N)
      apply h_unit.mul_right_eq_zero.mp
      calc
        (algebraMap B B_t t ^ (k_exp + N)) * y i
          = (algebraMap B B_t t ^ k_exp) * ((algebraMap B B_t t ^ N) * y i) := by
            rw [pow_add, mul_assoc]
        _ = (algebraMap B B_t t ^ k_exp) * algebraMap B B_t (r' i) := by rw [hr'_eq i]
        _ = algebraMap B B_t (t ^ k_exp * r' i) := by rw [← map_pow, ← map_mul]
        _ = 0 := by rw [hr'_ann i, map_zero]
    have hSurj_Φt : Function.Surjective Φ_t := by
      intro z
      obtain ⟨n, a, hza⟩ := IsLocalization.Away.surj (ψ t) z
      let w : B_t := IsLocalization.Away.invSelf (S := B_t) t
      have hw_mul : algebraMap A A_t (ψ t) * ψ_t w = 1 := by
        rw [← hψ_t_eq t, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      have hw_pow : (algebraMap A A_t (ψ t)) ^ n * (ψ_t w) ^ n = 1 := by
        rw [← mul_pow, hw_mul, one_pow]
      let c : Fin δ → B := Φ.symm a
      refine ⟨(w ^ n) • (fun i => algebraMap B B_t (c i)), ?_⟩
      rw [hΦ_t_smul, hΦ_t_alg, map_pow, Φ.apply_symm_apply, ← hza]
      calc
        ψ_t w ^ n * (z * algebraMap A A_t (ψ t) ^ n)
          = z * (algebraMap A A_t (ψ t) ^ n * ψ_t w ^ n) := by ring
        _ = z := by rw [hw_pow, mul_one]
    let e_loc : (Fin δ → B_t) ≃+ A_t := AddEquiv.ofBijective Φ_t ⟨hInj_Φt, hSurj_Φt⟩
    let e_pi : (Fin δ → B') ≃+ (Fin δ → B_t) :=
      AddEquiv.arrowCongr (Equiv.refl (Fin δ)) β_iso.toAddEquiv
    let e_δ : (Fin δ → B') ≃+ A' := e_pi.trans (e_loc.trans α_iso.toAddEquiv)
    refine ⟨e_δ, fun b' x => ?_⟩
    have hpi_smul : e_pi (b' • x) = β_iso b' • e_pi x := by
      ext i
      exact map_mul β_iso b' (x i)
    change α_iso (Φ_t (e_pi (b' • x))) = ψ' b' * α_iso (Φ_t (e_pi x))
    rw [hpi_smul, hΦ_t_smul, map_mul, h_inter b']

  refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · intro Y W hW A_W kAlgW
    have happ := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
      Y.hom (AlgebraicGeometry.isAffineOpen_top _) hW le_top
    rw [← happ, h_top_fromSpec (CommRingCat.of k), ← AlgebraicGeometry.Spec.map_comp]
    rfl

  · intro P_ov ι_d hOpen_d h_over_d
    have := hOpen_d
    intro W_aff hAff_P x_std hx_std ψ_std
    let A_spec : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R₀)
    let A_P := ↑(P_ov.left.presheaf.obj (Opposite.op W_aff))
    let kAlgP : Algebra k A_P :=
      RingHom.toAlgebra (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appLE P_ov.hom ⊤ W_aff le_top)))
    let ι_d_std : A_spec ⟶ P_ov.left := ι_d
    have : AlgebraicGeometry.IsOpenImmersion ι_d_std := hOpen_d
    let e_sch : A_spec ≅ W_aff.toScheme := ι_d_std.isoOpensRange
    let e_ι_app : P_ov.left.presheaf.obj (Opposite.op W_aff) ≅
        W_aff.toScheme.presheaf.obj (Opposite.op ⊤) :=
      CategoryTheory.asIso
        (AlgebraicGeometry.Scheme.Hom.appLE W_aff.ι W_aff ⊤ (fun x _ => x.2))
    let e_appTop : W_aff.toScheme.presheaf.obj (Opposite.op ⊤) ≅
        A_spec.presheaf.obj (Opposite.op ⊤) :=
      { hom := e_sch.hom.appTop
        inv := e_sch.inv.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    let Φ_ring : P_ov.left.presheaf.obj (Opposite.op W_aff) ≅ CommRingCat.of R₀ :=
      e_ι_app ≪≫ e_appTop ≪≫ AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)
    have h_appLE_congr : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}
        {O₂ : Z₂.Opens} {O₁ : Z₁.Opens}
        (g₁ g₂ : Z₁ ⟶ Z₂), g₁ = g₂ →
        ∀ (h₁ : O₁ ≤ (TopologicalSpace.Opens.map g₁.base).obj O₂)
          (h₂ : O₁ ≤ (TopologicalSpace.Opens.map g₂.base).obj O₂),
        g₁.appLE O₂ O₁ h₁ = g₂.appLE O₂ O₁ h₂ := by
      rintro _ _ _ _ g₁ _ rfl _ _
      rfl
    have h_app_eq : e_ι_app.hom ≫ e_sch.hom.appTop =
        AlgebraicGeometry.Scheme.Hom.appLE ι_d_std W_aff ⊤ (fun x _ => ⟨x, rfl⟩) :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e_sch.hom W_aff.ι W_aff ⊤ ⊤
        (fun x _ => x.2) (fun _ _ => trivial)).trans
        (h_appLE_congr (e_sch.hom ≫ W_aff.ι) ι_d_std
          (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_d_std) _ _)
    have hΦ_hom_eq : Φ_ring.hom =
        ι_d_std.appLE W_aff ⊤ (fun x _ => ⟨x, rfl⟩) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom :=
      (CategoryTheory.Category.assoc e_ι_app.hom e_sch.hom.appTop
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom).symm.trans
        (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) h_app_eq)
    have hΦ_k_comm : ∀ c : k,
        Φ_ring.inv.hom (algebraMap k R₀ c) = @algebraMap k A_P _ _ kAlgP c := by
      intro c
      have h_fwd : Φ_ring.hom.hom (@algebraMap k A_P _ _ kAlgP c) = algebraMap k R₀ c := by
        let specC : A_spec ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀))
        have h_comp1 : P_ov.hom.appLE ⊤ W_aff le_top ≫
            ι_d_std.appLE W_aff ⊤ (fun x _ => ⟨x, rfl⟩) = specC.appTop :=
          (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_d_std P_ov.hom ⊤ W_aff ⊤
            (fun _ _ => trivial) (fun x _ => ⟨x, rfl⟩)).trans
            (h_appLE_congr (O₂ := ⊤) (O₁ := ⊤) (ι_d_std ≫ P_ov.hom) specC h_over_d
              (fun _ _ => trivial) (fun _ _ => trivial))
        have h_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (specC.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) =
            CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) :=
          (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
            (AlgebraicGeometry.Scheme.ΓSpecIso_naturality
              (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀)))).trans
            (CategoryTheory.Iso.inv_hom_id_assoc _ _)
        have h_hom_chain : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            P_ov.hom.appLE ⊤ W_aff le_top) ≫ Φ_ring.hom =
            CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) := by
          rw [hΦ_hom_eq]
          calc
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                P_ov.hom.appLE ⊤ W_aff le_top) ≫
              (ι_d_std.appLE W_aff ⊤ (fun x _ => ⟨x, rfl⟩) ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom)
              = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  ((P_ov.hom.appLE ⊤ W_aff le_top ≫
                    ι_d_std.appLE W_aff ⊤ (fun x _ => ⟨x, rfl⟩)) ≫
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) :=
                (CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
                    (CategoryTheory.Category.assoc _ _ _).symm)
            _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  (specC.appTop ≫
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) :=
                congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
                  (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom)
                    h_comp1)
