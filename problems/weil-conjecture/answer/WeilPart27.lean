          (weilPolyP1Over k δ).left (@hc_all) (@hr_all) E_edge :=
    fun δ => (hSyzygy_all δ (δ + 1) rfl (weilPolyP1Over k δ).left (hCD_Pd δ)).2
  let E_edge_fam : ∀ (δ : ℕ) (Y : AlgebraicGeometry.Scheme.{u})
      (f : Quiver.Hom Y (weilPolyP1Over k δ).left)
      (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
