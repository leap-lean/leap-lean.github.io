        have hq_F₁ : (hAff_cov α).fromSpec.base q' ∈ F₁_Z₀ := by
          rw [hfrom]; exact hq
        rcases hq_F₁ with ⟨z, _, hz_eq⟩
        have hz_eq' : ι_Cs.base (I_Zs.subschemeι.base z) =
