      have hDim_rg : Module.finrank k ↥(LinearMap.range φ) = 1 := by
        rw [← e_rg.finrank_eq, hDim₁]
      have hle_pow : 𝔪 ^ (m + 1) ≤ 𝔪 ^ m := Ideal.pow_le_pow_right (Nat.le_succ m)
      let ψ : (D ⧸ 𝔪 ^ (m + 1)) →ₗ[k] (D ⧸ 𝔪 ^ m) :=
        (Ideal.Quotient.factorₐ k hle_pow).toLinearMap
      have hψ_surj : Function.Surjective ψ := Ideal.Quotient.factor_surjective hle_pow
      have hker_ψ : LinearMap.ker ψ = LinearMap.range φ := by
        ext w
        obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective w
        simp only [LinearMap.mem_ker, LinearMap.mem_range]
        have hψ_mk : ψ (Ideal.Quotient.mk (𝔪 ^ (m + 1)) d) = Ideal.Quotient.mk (𝔪 ^ m) d := rfl
        rw [hψ_mk, Ideal.Quotient.eq_zero_iff_mem, h𝔪_pow m, Ideal.mem_span_singleton]
        constructor
        · rintro ⟨x, rfl⟩
          exact ⟨x, rfl⟩
        · rintro ⟨x, hx⟩
          have hsub : d - ϖ ^ m * x ∈ 𝔪 ^ m := by
            apply hle_pow
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
            exact hx.symm
          rw [h𝔪_pow m, Ideal.mem_span_singleton] at hsub
          obtain ⟨z, hz⟩ := hsub
          refine ⟨x + z, ?_⟩
          calc
            d = ϖ ^ m * x + (d - ϖ ^ m * x) := by ring
            _ = ϖ ^ m * x + ϖ ^ m * z := by rw [hz]
            _ = ϖ ^ m * (x + z) := by ring
      let e_qt : ((D ⧸ 𝔪 ^ (m + 1)) ⧸ LinearMap.range φ) ≃ₗ[k] (D ⧸ 𝔪 ^ m) :=
        (Submodule.quotEquivOfEq _ _ hker_ψ.symm).trans
          (LinearMap.quotKerEquivOfSurjective ψ hψ_surj)
      have hFin_qt : Module.Finite k ((D ⧸ 𝔪 ^ (m + 1)) ⧸ LinearMap.range φ) :=
        Module.Finite.equiv e_qt.symm
      have hDim_qt : Module.finrank k ((D ⧸ 𝔪 ^ (m + 1)) ⧸ LinearMap.range φ) = m := by
        rw [e_qt.finrank_eq, hDim_m]
      have hFin_succ : Module.Finite k (D ⧸ 𝔪 ^ (m + 1)) :=
        Module.Finite.of_submodule_quotient (LinearMap.range φ)
      have hDim_succ : Module.finrank k (D ⧸ 𝔪 ^ (m + 1)) = m + 1 := by
        have hsum := Submodule.finrank_quotient_add_finrank (LinearMap.range φ)
        rw [hDim_qt, hDim_rg] at hsum
        exact hsum.symm
      exact ⟨hFin_succ, hDim_succ⟩

  
  let 𝔪_R : Ideal R := IsLocalRing.maximalIdeal R
  have hQuotR : ∀ n : ℕ, Module.Finite k (R ⧸ 𝔪_R ^ n) ∧ Module.finrank k (R ⧸ 𝔪_R ^ n) = n :=
    hDVR_dim R hRes_R
  let L_a : S →ₗ[R] S := Algebra.lmul R S a
  have hL_inj : Function.Injective L_a := by
    intro x y hxy
    have hmul : (x - y) * a = 0 := by
      have hsub : a * x - a * y = 0 := sub_eq_zero.mpr hxy
      calc
        (x - y) * a = a * (x - y) := mul_comm _ _
        _ = a * x - a * y := mul_sub a x y
        _ = 0 := hsub
    exact sub_eq_zero.mp (mem_nonZeroDivisors_iff_right.mp ha (x - y) hmul)
  let N : Submodule R S := LinearMap.range L_a
  let e_a : S ≃ₗ[R] ↥N := LinearEquiv.ofInjective L_a hL_inj
  have hrk : Module.finrank R ↥N = Module.finrank R S := e_a.symm.finrank_eq
  let b_top : Module.Basis (Fin δ) R S := Submodule.smithNormalFormTopBasis b hrk
  let b_bot : Module.Basis (Fin δ) R ↥N := Submodule.smithNormalFormBotBasis b hrk
  let c : Fin δ → R := Submodule.smithNormalFormCoeffs b hrk
  let u : S ≃ₗ[R] S := b_top.equiv (b_bot.map e_a.symm) (Equiv.refl (Fin δ))
  have hcomp_diag : L_a.comp u.toLinearMap = Matrix.toLin b_top b_top (Matrix.diagonal c) := by
    apply b_top.ext
    intro i
    have hu_i : u (b_top i) = e_a.symm (b_bot i) := by
      simp [u]
    have hL_ea : L_a (e_a.symm (b_bot i)) = (b_bot i : S) :=
      congrArg Subtype.val (e_a.apply_symm_apply (b_bot i))
    calc
      (L_a.comp u.toLinearMap) (b_top i) = L_a (u (b_top i)) := rfl
      _ = L_a (e_a.symm (b_bot i)) := by rw [hu_i]
      _ = (b_bot i : S) := hL_ea
      _ = c i • b_top i := Submodule.smithNormalFormBotBasis_def b hrk i
      _ = (Matrix.toLin b_top b_top (Matrix.diagonal c)) (b_top i) := by
        simp [Matrix.toLin_self, Matrix.diagonal_apply]
  have hdet_eq : Algebra.norm R a * LinearMap.det u.toLinearMap = ∏ i : Fin δ, c i := by
    rw [Algebra.norm_apply, ← LinearMap.det_comp, hcomp_diag, LinearMap.det_toLin,
      Matrix.det_diagonal]
  have hu_unit : IsUnit (LinearMap.det u.toLinearMap) := LinearEquiv.isUnit_det' u
  have hNontriv_S : Nontrivial S :=
    nontrivial_of_ne (b ⟨0, hδ⟩) 0 (b.ne_zero ⟨0, hδ⟩)
  have hNontriv_N : Nontrivial ↥N := e_a.symm.surjective.nontrivial
  have hc_ne : ∀ i : Fin δ, c i ≠ 0 := by
    intro i hci
    have hbot_ne : (b_bot i : S) ≠ 0 := by
      intro h0
      exact b_bot.ne_zero i (Subtype.ext h0)
    apply hbot_ne
    rw [Submodule.smithNormalFormBotBasis_def b hrk i]
    change c i • b_top i = 0
    rw [hci, zero_smul]
  have hprod_ne : (∏ i : Fin δ, c i) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hc_ne i)
  have hNorm_ne : Algebra.norm R a ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hdet_eq
    exact hprod_ne hdet_eq.symm
  obtain ⟨ϖ_R, hϖ_R⟩ := IsDiscreteValuationRing.exists_irreducible R
  have h𝔪R_span : 𝔪_R = Ideal.span ({ϖ_R} : Set R) :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ_R).mp hϖ_R
  have hc_pow_ex : ∀ i : Fin δ, ∃ n : ℕ, Ideal.span ({c i} : Set R) = 𝔪_R ^ n := by
    intro i
    have hne_bot : Ideal.span ({c i} : Set R) ≠ ⊥ := by
      rw [ne_eq, Ideal.span_singleton_eq_bot]
      exact hc_ne i
    obtain ⟨n, hn⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hne_bot hϖ_R
    refine ⟨n, ?_⟩
    rw [hn, h𝔪R_span, Ideal.span_singleton_pow]
  let k_snf : Fin δ → ℕ := fun i => Classical.choose (hc_pow_ex i)
  have hc_pow : ∀ i : Fin δ, Ideal.span ({c i} : Set R) = 𝔪_R ^ (k_snf i) :=
    fun i => Classical.choose_spec (hc_pow_ex i)
  have hprod_span : ∀ s : Finset (Fin δ),
      Ideal.span ({∏ i ∈ s, c i} : Set R) = 𝔪_R ^ (∑ i ∈ s, k_snf i) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      simp [Ideal.one_eq_top]
    | @insert j s hj ih =>
      rw [Finset.prod_insert hj, Finset.sum_insert hj,
        ← Ideal.span_singleton_mul_span_singleton, hc_pow j, ih, ← pow_add]
  have hNorm_span_sum : Ideal.span ({Algebra.norm R a} : Set R) = 𝔪_R ^ (∑ i : Fin δ, k_snf i) := by
    calc
      Ideal.span ({Algebra.norm R a} : Set R)
        = Ideal.span ({Algebra.norm R a * LinearMap.det u.toLinearMap} : Set R) :=
          (Ideal.span_singleton_mul_right_unit hu_unit (Algebra.norm R a)).symm
      _ = Ideal.span ({∏ i : Fin δ, c i} : Set R) := by rw [hdet_eq]
      _ = 𝔪_R ^ (∑ i : Fin δ, k_snf i) := hprod_span Finset.univ
  have hFin_ci : ∀ i : Fin δ, Module.Finite k (R ⧸ Ideal.span ({c i} : Set R)) := by
    intro i
    have : Module.Finite k (R ⧸ 𝔪_R ^ (k_snf i)) := (hQuotR (k_snf i)).1
    exact Module.Finite.equiv
      (Ideal.quotientEquivAlgOfEq k (hc_pow i)).symm.toLinearEquiv
  have hDim_ci : ∀ i : Fin δ, Module.finrank k (R ⧸ Ideal.span ({c i} : Set R)) = k_snf i := by
    intro i
    have heq := (Ideal.quotientEquivAlgOfEq k (hc_pow i)).toLinearEquiv.finrank_eq
    exact heq.trans (hQuotR (k_snf i)).2
  have hDim_SN : Module.finrank k (S ⧸ N) = ∑ i : Fin δ, k_snf i := by
    rw [Submodule.finrank_quotient_eq_sum k b hrk]
    exact Finset.sum_congr rfl (fun i _ => hDim_ci i)
  let I_a : Ideal S := Ideal.span ({a} : Set S)
  let p_N : S →ₗ[k] (S ⧸ N) := N.mkQ.restrictScalars k
  let q_Ia : S →ₗ[k] (S ⧸ I_a) := (Ideal.Quotient.mkₐ k I_a).toLinearMap
  have hker_N_Ia : LinearMap.ker p_N = LinearMap.ker q_Ia := by
    ext x
    simp only [LinearMap.mem_ker, p_N, q_Ia, LinearMap.restrictScalars_apply,
      Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, AlgHom.toLinearMap_apply,
      Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, N, LinearMap.mem_range,
      I_a, Ideal.mem_span_singleton]
    constructor
    · rintro ⟨y, hy⟩
      exact ⟨y, hy.symm⟩
    · rintro ⟨y, rfl⟩
      exact ⟨y, rfl⟩
  let e_N_Ia : (S ⧸ N) ≃ₗ[k] (S ⧸ I_a) :=
    (LinearMap.quotKerEquivOfSurjective p_N (Submodule.mkQ_surjective N)).symm.trans
      ((Submodule.quotEquivOfEq _ _ hker_N_Ia).trans
        (LinearMap.quotKerEquivOfSurjective q_Ia Ideal.Quotient.mk_surjective))
  have hNorm_span_finrank : Ideal.span ({Algebra.norm R a} : Set R) =
      𝔪_R ^ (Module.finrank k (S ⧸ I_a)) := by
    rw [← e_N_Ia.finrank_eq, hDim_SN, hNorm_span_sum]

  
  have hFin_RS : Module.Finite R S := Module.Finite.of_basis b
  have hInt_RS : (algebraMap R S).IsIntegral :=
    algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.of_finite R S)
  let I₀ : Ideal S := Ideal.map (algebraMap R S) 𝔪_R
  let π₀ : S →ₐ[k] (S ⧸ I₀) := Ideal.Quotient.mkₐ k I₀
  let g₀ : (Fin δ → k) →ₗ[k] (S ⧸ I₀) :=
    { toFun := fun v => ∑ i : Fin δ, v i • π₀ (b i)
      map_add' := fun v₁ v₂ => by
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun r v => by
        simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
  have hg₀_surj : Function.Surjective g₀ := by
    intro q
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
    let v : Fin δ → k := fun i => Classical.choose (hRes_R (b.repr x i))
    have hv : ∀ i : Fin δ, b.repr x i - algebraMap k R (v i) ∈ 𝔪_R :=
      fun i => Classical.choose_spec (hRes_R (b.repr x i))
    refine ⟨v, ?_⟩
    change (∑ i : Fin δ, v i • π₀ (b i)) = π₀ x
    conv_rhs => rw [← b.sum_repr x]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro i _
    let m_i : R := b.repr x i - algebraMap k R (v i)
    have hr_eq : b.repr x i = algebraMap k R (v i) + m_i := by
      dsimp [m_i]; ring
    have hsmul_eq : (b.repr x i) • b i = v i • b i + algebraMap R S m_i * b i := by
      rw [hr_eq, add_smul, IsScalarTower.algebraMap_smul R (v i) (b i),
        Algebra.smul_def m_i (b i)]
    have hm_mem : algebraMap R S m_i * b i ∈ I₀ :=
      Ideal.mul_mem_right (b i) I₀ (Ideal.mem_map_of_mem (algebraMap R S) (hv i))
    have hπ_m : π₀ (algebraMap R S m_i * b i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hm_mem
    rw [hsmul_eq, map_add, map_smul, hπ_m, add_zero]
  have hFin_I₀ : Module.Finite k (S ⧸ I₀) := Module.Finite.of_surjective g₀ hg₀_surj
  have hArt_I₀ : IsArtinianRing (S ⧸ I₀) := isArtinian_of_tower k inferInstance
  have hI₀_le : ∀ (𝔪 : Ideal S), 𝔪.IsMaximal → I₀ ≤ 𝔪 := by
    intro 𝔪 h𝔪
    have : 𝔪.IsMaximal := h𝔪
    have hcomap_max : (Ideal.comap (algebraMap R S) 𝔪).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R S) hInt_RS 𝔪
    have hcomap_eq : Ideal.comap (algebraMap R S) 𝔪 = 𝔪_R :=
      IsLocalRing.eq_maximalIdeal hcomap_max
    exact Ideal.map_le_iff_le_comap.mpr hcomap_eq.symm.le
  have hFin_quot : ∀ (𝔪 : Ideal S), 𝔪.IsMaximal → Module.Finite k (S ⧸ 𝔪) := by
    intro 𝔪 h𝔪
    exact Module.Finite.of_surjective
      (Ideal.Quotient.factorₐ k (hI₀_le 𝔪 h𝔪)).toLinearMap
      (Ideal.Quotient.factor_surjective (hI₀_le 𝔪 h𝔪))
  have hFin_max_set : {𝔪 : Ideal S | 𝔪.IsMaximal}.Finite := by
    have hP₀_fin : {P : Ideal (S ⧸ I₀) | P.IsPrime}.Finite :=
      IsArtinianRing.setOfPred_isPrime_finite (S ⧸ I₀)
    let q₀ : S →+* (S ⧸ I₀) := Ideal.Quotient.mk I₀
    refine (hP₀_fin.image (Ideal.comap q₀)).subset ?_
    intro 𝔪 h𝔪
    dsimp at h𝔪
    let P : Ideal (S ⧸ I₀) := Ideal.map q₀ 𝔪
    have hcomap_P : Ideal.comap q₀ P = 𝔪 := by
      rw [Ideal.comap_map_of_surjective' q₀ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr (hI₀_le 𝔪 h𝔪)
    have hP_max : P.IsMaximal := by
      rw [Ideal.isMaximal_def]
      refine ⟨?_, ?_⟩
      · intro htop
        apply h𝔪.ne_top
        rw [← hcomap_P, htop]
        rfl
      · intro J hPJ
        have h𝔪_lt : 𝔪 < Ideal.comap q₀ J := by
          refine lt_of_le_of_ne ?_ ?_
          · rw [← hcomap_P]
            exact Ideal.comap_mono hPJ.le
          · intro heq
            apply hPJ.ne
            calc
              P = Ideal.map q₀ (Ideal.comap q₀ J) := by rw [← heq]
              _ = J := Ideal.map_comap_of_surjective q₀ Ideal.Quotient.mk_surjective J
        have hcomap_top : Ideal.comap q₀ J = ⊤ := (Ideal.isMaximal_def.mp h𝔪).2 _ h𝔪_lt
        rw [Ideal.eq_top_iff_one] at hcomap_top ⊢
        simpa using hcomap_top
    exact ⟨P, hP_max.isPrime, hcomap_P⟩
  let M_max : Finset (Ideal S) := hFin_max_set.toFinset
  have hM_max : ∀ 𝔪 : Ideal S, 𝔪 ∈ M_max ↔ 𝔪.IsMaximal :=
    fun 𝔪 => hFin_max_set.mem_toFinset

  
  have hLoc_ex : ∀ (𝔪 : Ideal S) (h𝔪 : 𝔪.IsMaximal),
      letI : 𝔪.IsPrime := h𝔪.isPrime
      ∃ n : ℕ,
        Ideal.span ({algebraMap S (Localization.AtPrime 𝔪) a} : Set (Localization.AtPrime 𝔪)) =
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) ^ n := by
    intro 𝔪 h𝔪
    have : 𝔪.IsPrime := h𝔪.isPrime
    obtain ⟨hDom_m, hDVR_m⟩ := hLocDVR 𝔪 h𝔪
    have : IsDomain (Localization.AtPrime 𝔪) := hDom_m
    have : IsDiscreteValuationRing (Localization.AtPrime 𝔪) := hDVR_m
    let S_𝔪 := Localization.AtPrime 𝔪
    let a_𝔪 : S_𝔪 := algebraMap S S_𝔪 a
    have ha_𝔪_ne : a_𝔪 ≠ 0 := by
      intro h0
      obtain ⟨u, hu⟩ := (IsLocalization.map_eq_zero_iff 𝔪.primeCompl S_𝔪 a).mp h0
      have hu_mul : (u : S) * a = 0 := by
        simpa [Algebra.smul_def] using hu
      have hu0 : (u : S) = 0 := mem_nonZeroDivisors_iff_right.mp ha (u : S) hu_mul
      exact u.2 (hu0 ▸ 𝔪.zero_mem)
    have hspan_ne_bot : Ideal.span ({a_𝔪} : Set S_𝔪) ≠ ⊥ := by
      rw [ne_eq, Ideal.span_singleton_eq_bot]
      exact ha_𝔪_ne
    obtain ⟨ϖ_𝔪, hϖ_𝔪⟩ := IsDiscreteValuationRing.exists_irreducible S_𝔪
    have h𝔫_span : IsLocalRing.maximalIdeal S_𝔪 = Ideal.span ({ϖ_𝔪} : Set S_𝔪) :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ_𝔪).mp hϖ_𝔪
    obtain ⟨n, hn⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hspan_ne_bot hϖ_𝔪
    refine ⟨n, ?_⟩
    rw [hn, h𝔫_span, Ideal.span_singleton_pow]
  let ord_a : Ideal S → ℕ :=
    fun 𝔪 => if h𝔪 : 𝔪.IsMaximal then Classical.choose (hLoc_ex 𝔪 h𝔪) else 0
  have hLoc_span : ∀ (𝔪 : Ideal S) (h𝔪 : 𝔪.IsMaximal),
      letI : 𝔪.IsPrime := h𝔪.isPrime
      Ideal.span ({algebraMap S (Localization.AtPrime 𝔪) a} : Set (Localization.AtPrime 𝔪)) =
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) ^ (ord_a 𝔪) := by
    intro 𝔪 h𝔪
    dsimp [ord_a]
    simp only [h𝔪, ↓reduceDIte]
    exact Classical.choose_spec (hLoc_ex 𝔪 h𝔪)

  
  have hBezout : ∀ (𝔪 : Ideal S), 𝔪.IsMaximal → ∀ (u : S), u ∉ 𝔪 → ∀ n : ℕ,
      ∃ v w : S, w ∈ 𝔪 ^ n ∧ u * v + w = 1 := by
    intro 𝔪 h𝔪 u hu n
    have hsup_top : Ideal.span ({u} : Set S) ⊔ 𝔪 = ⊤ := by
      apply (Ideal.isMaximal_def.mp h𝔪).2
      refine lt_of_le_of_ne le_sup_right ?_
      intro heq
      apply hu
      rw [heq]
      exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self u)
    have hcop₁ : IsCoprime (Ideal.span ({u} : Set S)) 𝔪 :=
      Ideal.isCoprime_iff_sup_eq.mpr hsup_top
    have hcop_n : IsCoprime (Ideal.span ({u} : Set S)) (𝔪 ^ n) := by
      simpa only [pow_one] using hcop₁.pow (m := 1) (n := n)
    have hsup_n : Ideal.span ({u} : Set S) ⊔ 𝔪 ^ n = ⊤ :=
      Ideal.isCoprime_iff_sup_eq.mp hcop_n
    have h1_mem : (1 : S) ∈ Ideal.span ({u} : Set S) ⊔ 𝔪 ^ n := by
      rw [hsup_n]; trivial
    obtain ⟨x₁, hx₁, w, hw, hxw⟩ := Submodule.mem_sup.mp h1_mem
    obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton.mp hx₁
    exact ⟨v, w, hw, hxw⟩

  
  let f_pow : ↥M_max → Ideal S := fun i => i.1 ^ (ord_a i.1)
  have hSpan_iInf : I_a = ⨅ i : ↥M_max, f_pow i := by
    apply le_antisymm
    · rw [le_iInf_iff]
      intro i
      rw [Ideal.span_singleton_le_iff_mem]
      let 𝔪 : Ideal S := i.1
      have h𝔪 : 𝔪.IsMaximal := (hM_max 𝔪).mp i.2
      have : 𝔪.IsPrime := h𝔪.isPrime
      let S_𝔪 := Localization.AtPrime 𝔪
      let n : ℕ := ord_a 𝔪
      have ha_mem_loc : algebraMap S S_𝔪 a ∈ Ideal.map (algebraMap S S_𝔪) (𝔪 ^ n) := by
        rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
        change algebraMap S S_𝔪 a ∈ (IsLocalRing.maximalIdeal S_𝔪) ^ n
        rw [← hLoc_span 𝔪 h𝔪]
        exact Ideal.mem_span_singleton_self _
      obtain ⟨u, hu, hua⟩ :=
        (IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔪.primeCompl S_𝔪 (𝔪 ^ n) a).mp
          ha_mem_loc
      obtain ⟨v, w, hw, huv⟩ := hBezout 𝔪 h𝔪 u hu n
      have ha_eq : a = v * (u * a) + w * a := by
        calc
          a = 1 * a := (one_mul a).symm
          _ = (u * v + w) * a := by rw [huv]
          _ = v * (u * a) + w * a := by ring
      rw [ha_eq]
      exact add_mem (Ideal.mul_mem_left _ v hua) (Ideal.mul_mem_right a _ hw)
    · intro x hx
      by_contra hx_not
      let C : Ideal S :=
        { carrier := {s : S | s * x ∈ I_a}
          add_mem' := fun {s₁ s₂} hs₁ hs₂ => by
            dsimp at hs₁ hs₂ ⊢
            rw [add_mul]
            exact add_mem hs₁ hs₂
          zero_mem' := by
            dsimp
            rw [zero_mul]
            exact I_a.zero_mem
          smul_mem' := fun r {s} hs => by
            dsimp at hs ⊢
            rw [mul_assoc]
            exact Ideal.mul_mem_left I_a r hs }
      have hC_ne_top : C ≠ ⊤ := by
        intro htop
        apply hx_not
        have h1 : (1 : S) ∈ C := by rw [htop]; trivial
        simpa [C] using h1
      obtain ⟨𝔮, h𝔮_max, hC𝔮⟩ := Ideal.exists_le_maximal C hC_ne_top
      have h𝔮_mem : 𝔮 ∈ M_max := (hM_max 𝔮).mpr h𝔮_max
      have hx_q : x ∈ 𝔮 ^ (ord_a 𝔮) := (Ideal.mem_iInf.mp hx) ⟨𝔮, h𝔮_mem⟩
      have : 𝔮.IsPrime := h𝔮_max.isPrime
      let S_𝔮 := Localization.AtPrime 𝔮
      have hx_loc : algebraMap S S_𝔮 x ∈
          Ideal.span ({algebraMap S S_𝔮 a} : Set S_𝔮) := by
        rw [hLoc_span 𝔮 h𝔮_max]
        change algebraMap S S_𝔮 x ∈ (IsLocalRing.maximalIdeal S_𝔮) ^ (ord_a 𝔮)
        rw [← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem (algebraMap S S_𝔮) hx_q
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hx_loc
      obtain ⟨⟨s, u₁⟩, hsu₁⟩ := IsLocalization.surj 𝔮.primeCompl z
      have heq_loc : algebraMap S S_𝔮 ((u₁ : S) * x) = algebraMap S S_𝔮 (a * s) := by
        calc
          algebraMap S S_𝔮 ((u₁ : S) * x)
            = algebraMap S S_𝔮 x * algebraMap S S_𝔮 (u₁ : S) := by rw [map_mul, mul_comm]
          _ = (algebraMap S S_𝔮 a * z) * algebraMap S S_𝔮 (u₁ : S) := by rw [hz]
          _ = algebraMap S S_𝔮 a * (z * algebraMap S S_𝔮 (u₁ : S)) := by rw [mul_assoc]
          _ = algebraMap S S_𝔮 a * algebraMap S S_𝔮 s := by rw [hsu₁]
          _ = algebraMap S S_𝔮 (a * s) := (map_mul _ _ _).symm
      obtain ⟨u₂, hu₂⟩ := (IsLocalization.eq_iff_exists 𝔮.primeCompl S_𝔮).mp heq_loc
      have hu_mem_C : (u₂ : S) * (u₁ : S) ∈ C := by
        change ((u₂ : S) * (u₁ : S)) * x ∈ I_a
        have hmul : ((u₂ : S) * (u₁ : S)) * x = a * ((u₂ : S) * s) := by
          calc
            ((u₂ : S) * (u₁ : S)) * x = (u₂ : S) * ((u₁ : S) * x) := mul_assoc _ _ _
            _ = (u₂ : S) * (a * s) := hu₂
            _ = a * ((u₂ : S) * s) := by ring
        rw [hmul]
        exact Ideal.mem_span_singleton.mpr ⟨(u₂ : S) * s, rfl⟩
      exact (u₂ * u₁).2 (hC𝔮 hu_mem_C)

  
  have hLocQuot : ∀ (𝔪 : Ideal S) (h𝔪 : 𝔪.IsMaximal) (n : ℕ),
      letI : 𝔪.IsPrime := h𝔪.isPrime
      Nonempty ((S ⧸ 𝔪 ^ n) ≃ₐ[k]
        ((Localization.AtPrime 𝔪) ⧸
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) ^ n)) := by
    intro 𝔪 h𝔪 n
    have : 𝔪.IsPrime := h𝔪.isPrime
    let S_𝔪 := Localization.AtPrime 𝔪
    let 𝔫_𝔪 : Ideal S_𝔪 := IsLocalRing.maximalIdeal S_𝔪
    have hmap_pow : Ideal.map (algebraMap S S_𝔪) (𝔪 ^ n) = 𝔫_𝔪 ^ n := by
      rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
    let Φ : S →ₐ[k] (S_𝔪 ⧸ 𝔫_𝔪 ^ n) :=
      (Ideal.Quotient.mkₐ k (𝔫_𝔪 ^ n)).comp (IsScalarTower.toAlgHom k S S_𝔪)
    have hΦ_ker : ∀ x : S, Φ x = 0 ↔ x ∈ 𝔪 ^ n := by
      intro x
      change Ideal.Quotient.mk (𝔫_𝔪 ^ n) (algebraMap S S_𝔪 x) = 0 ↔ x ∈ 𝔪 ^ n
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hmap_pow,
        IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔪.primeCompl S_𝔪 (𝔪 ^ n) x]
      constructor
      · rintro ⟨u, hu, hux⟩
        obtain ⟨v, w, hw, huv⟩ := hBezout 𝔪 h𝔪 u hu n
        have hx_eq : x = v * (u * x) + w * x := by
          calc
            x = 1 * x := (one_mul x).symm
            _ = (u * v + w) * x := by rw [huv]
            _ = v * (u * x) + w * x := by ring
        rw [hx_eq]
        exact add_mem (Ideal.mul_mem_left _ v hux) (Ideal.mul_mem_right x _ hw)
      · intro hx
        exact ⟨1, 𝔪.primeCompl.one_mem, by simpa using hx⟩
    have hΦ_surj : Function.Surjective Φ := by
      intro q
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨⟨s, u⟩, hsu⟩ := IsLocalization.surj 𝔪.primeCompl z
      obtain ⟨v, w, hw, huv⟩ := hBezout 𝔪 h𝔪 (u : S) u.2 n
      refine ⟨s * v, ?_⟩
      change Ideal.Quotient.mk (𝔫_𝔪 ^ n) (algebraMap S S_𝔪 (s * v)) =
        Ideal.Quotient.mk (𝔫_𝔪 ^ n) z
      rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      have huv_sub : (u : S) * v - 1 = -w := by
        calc
          (u : S) * v - 1 = (u : S) * v + w - 1 - w := by ring
          _ = 1 - 1 - w := by rw [huv]
          _ = -w := by ring
      have hdiff : algebraMap S S_𝔪 (s * v) - z = z * (-(algebraMap S S_𝔪 w)) := by
        calc
          algebraMap S S_𝔪 (s * v) - z
            = algebraMap S S_𝔪 s * algebraMap S S_𝔪 v - z := by rw [map_mul]
          _ = (z * algebraMap S S_𝔪 (u : S)) * algebraMap S S_𝔪 v - z := by rw [← hsu]
          _ = z * (algebraMap S S_𝔪 (u : S) * algebraMap S S_𝔪 v - 1) := by ring
          _ = z * algebraMap S S_𝔪 ((u : S) * v - 1) := by
            rw [← map_mul, ← map_one (algebraMap S S_𝔪), ← map_sub]
          _ = z * (-(algebraMap S S_𝔪 w)) := by rw [huv_sub, map_neg]
      rw [hdiff]
      have hw_loc : algebraMap S S_𝔪 w ∈ 𝔫_𝔪 ^ n := by
        rw [← hmap_pow]
        exact Ideal.mem_map_of_mem (algebraMap S S_𝔪) hw
      exact Ideal.mul_mem_left _ z (neg_mem hw_loc)
    let Φbar : (S ⧸ 𝔪 ^ n) →ₐ[k] (S_𝔪 ⧸ 𝔫_𝔪 ^ n) :=
      Ideal.Quotient.liftₐ (𝔪 ^ n) Φ (fun x hx => (hΦ_ker x).mpr hx)
    have hΦbar_inj : Function.Injective Φbar := by
      rw [injective_iff_map_eq_zero]
      intro q hq
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hΦ_ker x).mp hq)
    have hΦbar_surj : Function.Surjective Φbar := by
      intro q
      obtain ⟨y, rfl⟩ := hΦ_surj q
      exact ⟨Ideal.Quotient.mk (𝔪 ^ n) y, rfl⟩
    exact ⟨AlgEquiv.ofBijective Φbar ⟨hΦbar_inj, hΦbar_surj⟩⟩

  have hFactor_dim : ∀ i : ↥M_max,
      Module.Finite k (S ⧸ f_pow i) ∧ Module.finrank k (S ⧸ f_pow i) = ord_a i.1 := by
    intro i
    let 𝔪 : Ideal S := i.1
    have h𝔪 : 𝔪.IsMaximal := (hM_max 𝔪).mp i.2
    have : 𝔪.IsPrime := h𝔪.isPrime
    obtain ⟨hDom_m, hDVR_m⟩ := hLocDVR 𝔪 h𝔪
    have : IsDomain (Localization.AtPrime 𝔪) := hDom_m
    have : IsDiscreteValuationRing (Localization.AtPrime 𝔪) := hDVR_m
    let S_𝔪 := Localization.AtPrime 𝔪
    let 𝔫_𝔪 : Ideal S_𝔪 := IsLocalRing.maximalIdeal S_𝔪
    obtain ⟨e_loc1⟩ := hLocQuot 𝔪 h𝔪 1
    let e₁_m : (S ⧸ 𝔪) ≃ₐ[k] (S_𝔪 ⧸ 𝔫_𝔪) :=
      (Ideal.quotientEquivAlgOfEq k (pow_one 𝔪).symm).trans
        (e_loc1.trans (Ideal.quotientEquivAlgOfEq k (pow_one 𝔫_𝔪)))
    have : Module.Finite k (S ⧸ 𝔪) := hFin_quot 𝔪 h𝔪
    have : Module.Finite k (S_𝔪 ⧸ 𝔫_𝔪) := Module.Finite.equiv e₁_m.toLinearEquiv
    have : Algebra.IsIntegral k (S_𝔪 ⧸ 𝔫_𝔪) := Algebra.IsIntegral.of_finite k (S_𝔪 ⧸ 𝔫_𝔪)
    have : 𝔫_𝔪.IsMaximal := IsLocalRing.maximalIdeal.isMaximal S_𝔪
    have : 𝔫_𝔪.IsPrime := Ideal.IsMaximal.isPrime inferInstance
    have hbij_res : Function.Bijective (algebraMap k (S_𝔪 ⧸ 𝔫_𝔪)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    have hRes_𝔪 : ∀ z : S_𝔪, ∃ c₀ : k, z - algebraMap k S_𝔪 c₀ ∈ 𝔫_𝔪 := by
      intro z
      obtain ⟨c₀, hc₀⟩ := hbij_res.2 (Ideal.Quotient.mk 𝔫_𝔪 z)
      refine ⟨c₀, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
      have hmap : Ideal.Quotient.mk 𝔫_𝔪 (algebraMap k S_𝔪 c₀) = algebraMap k (S_𝔪 ⧸ 𝔫_𝔪) c₀ :=
        (IsScalarTower.algebraMap_apply k S_𝔪 (S_𝔪 ⧸ 𝔫_𝔪) c₀).symm
      rw [hmap, hc₀]
    obtain ⟨hFin_loc_n, hDim_loc_n⟩ := hDVR_dim S_𝔪 hRes_𝔪 (ord_a 𝔪)
    obtain ⟨e_loc_n⟩ := hLocQuot 𝔪 h𝔪 (ord_a 𝔪)
    have : Module.Finite k (S_𝔪 ⧸ 𝔫_𝔪 ^ (ord_a 𝔪)) := hFin_loc_n
    have hFin_S_n : Module.Finite k (S ⧸ f_pow i) :=
      Module.Finite.equiv e_loc_n.symm.toLinearEquiv
    have hDim_S_n : Module.finrank k (S ⧸ f_pow i) = ord_a i.1 :=
      e_loc_n.toLinearEquiv.finrank_eq.trans hDim_loc_n
    exact ⟨hFin_S_n, hDim_S_n⟩

  have hCop : Pairwise (Function.onFun IsCoprime f_pow) := by
    intro i j hij
    have hij_val : i.1 ≠ j.1 := fun h => hij (Subtype.ext h)
    have hi_max : i.1.IsMaximal := (hM_max i.1).mp i.2
    have hj_max : j.1.IsMaximal := (hM_max j.1).mp j.2
    have hsup_top : i.1 ⊔ j.1 = ⊤ := by
      apply (Ideal.isMaximal_def.mp hi_max).2
      refine lt_of_le_of_ne le_sup_left ?_
      intro heq
      have hj_le : j.1 ≤ i.1 := le_sup_right.trans heq.symm.le
      rcases lt_or_eq_of_le hj_le with hlt | h_eq
      · exact hi_max.ne_top ((Ideal.isMaximal_def.mp hj_max).2 _ hlt)
      · exact hij_val h_eq.symm
    have hcop₁ : IsCoprime i.1 j.1 := Ideal.isCoprime_iff_sup_eq.mpr hsup_top
    exact hcop₁.pow

  let φ_pi : (S ⧸ ⨅ i : ↥M_max, f_pow i) →ₗ[k] (∀ i : ↥M_max, S ⧸ f_pow i) :=
    { toFun := Ideal.quotientInfToPiQuotient f_pow
      map_add' := map_add (Ideal.quotientInfToPiQuotient f_pow)
      map_smul' := fun r q => by
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
        ext i
        change (Ideal.quotientInfToPiQuotient f_pow) (r • Ideal.Quotient.mk (⨅ j, f_pow j) x) i =
          r • ((Ideal.quotientInfToPiQuotient f_pow) (Ideal.Quotient.mk (⨅ j, f_pow j) x) i)
        have hsmul₁ : r • Ideal.Quotient.mk (⨅ j, f_pow j) x =
            Ideal.Quotient.mk (⨅ j, f_pow j) (r • x) :=
          (map_smul (Ideal.Quotient.mkₐ k (⨅ j, f_pow j)) r x).symm
        have hsmul₂ : r • Ideal.Quotient.mk (f_pow i) x =
            Ideal.Quotient.mk (f_pow i) (r • x) :=
          (map_smul (Ideal.Quotient.mkₐ k (f_pow i)) r x).symm
        rw [hsmul₁, Ideal.quotientInfToPiQuotient_mk', Ideal.quotientInfToPiQuotient_mk', hsmul₂] }
  let e_pi : (S ⧸ ⨅ i : ↥M_max, f_pow i) ≃ₗ[k] (∀ i : ↥M_max, S ⧸ f_pow i) :=
    LinearEquiv.ofBijective φ_pi
      ⟨Ideal.quotientInfToPiQuotient_inj f_pow, Ideal.quotientInfToPiQuotient_surj hCop⟩
  let e_CRT : (S ⧸ I_a) ≃ₗ[k] (∀ i : ↥M_max, S ⧸ f_pow i) :=
    (Ideal.quotientEquivAlgOfEq k hSpan_iInf).toLinearEquiv.trans e_pi
  have : ∀ i : ↥M_max, Module.Finite k (S ⧸ f_pow i) := fun i => (hFactor_dim i).1
  have hDim_Ia : Module.finrank k (S ⧸ I_a) = Finset.sum M_max ord_a := by
    calc
      Module.finrank k (S ⧸ I_a)
        = Module.finrank k (∀ i : ↥M_max, S ⧸ f_pow i) := e_CRT.finrank_eq
      _ = ∑ i : ↥M_max, Module.finrank k (S ⧸ f_pow i) := Module.finrank_pi_fintype k
      _ = ∑ i : ↥M_max, ord_a i.1 := Finset.sum_congr rfl (fun i _ => (hFactor_dim i).2)
      _ = M_max.attach.sum (fun i => ord_a i.1) := by rw [Finset.univ_eq_attach]
      _ = Finset.sum M_max ord_a := Finset.sum_attach M_max ord_a
  refine ⟨hNorm_ne, M_max, ord_a, hM_max, hLoc_span, ?_⟩
  rw [hNorm_span_finrank, hDim_Ia]

theorem weil_flat_pid_free_alg_norm_eq_prod_minimalPrime_pow_length (B₀ B_s : Type u) [CommRing B₀] [IsDomain B₀] [IsPrincipalIdealRing B₀]
    [CommRing B_s] [Algebra B₀ B_s]
    (m_rk c : ℕ) (hm_rk : 1 ≤ m_rk)
    (hb_s : Nonempty (Module.Basis (Fin m_rk) B₀ B_s))
    (p_min : Fin c → Ideal B_s)
    (hp_inj : Function.Injective p_min)
    (hp_range : Set.range p_min = minimalPrimes B_s)
    (e d_rk : Fin c → ℕ)
    (B_norm : Fin c → Type u)
    [∀ i, CommRing (B_norm i)] [∀ i, IsDomain (B_norm i)] [∀ i, Algebra B₀ (B_norm i)]
    (ψ_comp : ∀ i : Fin c, B_s →ₐ[B₀] B_norm i)
    (he_def : ∀ i : Fin c,
      letI : (p_min i).IsPrime := (hp_range ▸ Set.mem_range_self i).1.1
      e i = (Module.length (Localization.AtPrime (p_min i))
        (Localization.AtPrime (p_min i))).toNat)
    (hb_norm : ∀ i : Fin c, Nonempty (Module.Basis (Fin (d_rk i)) B₀ (B_norm i)))
    (hker_ψ : ∀ i : Fin c, RingHom.ker (ψ_comp i).toRingHom = p_min i)
    (hfrac_ψ : ∀ (i : Fin c) (y : B_norm i),
      ∃ a b : B_s, b ∉ p_min i ∧ ψ_comp i b * y = ψ_comp i a) :
    (∀ i : Fin c, 1 ≤ e i ∧ 1 ≤ d_rk i) ∧
    (∀ (R : Type u) [CommRing R] [Algebra B₀ R] [Module.Flat B₀ R]
       (z : TensorProduct B₀ R B_s),
      Algebra.norm R z =
        Finset.univ.prod fun i : Fin c =>
          (Algebra.norm R (Algebra.TensorProduct.map (AlgHom.id R R) (ψ_comp i) z)) ^ (e i)) :=
by
  classical
  have hPrime_p : ∀ i : Fin c, (p_min i).IsPrime :=
    fun i => (hp_range ▸ Set.mem_range_self i).1.1
  
  have s1_tensorField : ∀ (F : Type u) [Field F] [Algebra B₀ F] [IsFractionRing B₀ F]
      (n : ℕ) (A : Type u) [CommRing A] [Algebra B₀ A],
      Nonempty (Module.Basis (Fin n) B₀ A) →
      let jA : A →ₐ[B₀] TensorProduct B₀ F A := Algebra.TensorProduct.includeRight
      Function.Injective jA ∧
      (∀ s ∈ nonZeroDivisors B₀, IsUnit (jA (algebraMap B₀ A s))) ∧
      (∀ w : TensorProduct B₀ F A, ∃ (a : A) (s : nonZeroDivisors B₀),
        w * jA (algebraMap B₀ A s.1) = jA a) := by
    intro F _ _ _ n A _ _ ⟨bA⟩
    dsimp only
    let jA : A →ₐ[B₀] TensorProduct B₀ F A := Algebra.TensorProduct.includeRight
    let bF : Module.Basis (Fin n) F (TensorProduct B₀ F A) := bA.baseChange F
    have hinj : Function.Injective jA := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro a ha
      rw [RingHom.mem_ker] at ha
      apply bA.repr.injective
      ext k
      simp only [map_zero, Finsupp.zero_apply]
      apply IsFractionRing.injective B₀ F
      rw [map_zero]
      have hexp : jA a = ∑ m : Fin n, (algebraMap B₀ F (bA.repr a m)) • bF m := by
        calc
          jA a = jA (∑ m : Fin n, (bA.repr a m) • bA m) := by
            congr 1; exact (bA.sum_repr a).symm
          _ = ∑ m : Fin n, jA ((bA.repr a m) • bA m) := map_sum jA _ _
          _ = ∑ m : Fin n, (algebraMap B₀ F (bA.repr a m)) • bF m := by
            refine Finset.sum_congr rfl fun m _ => ?_
            have hbFm : bF m = (1 : F) ⊗ₜ[B₀] bA m := Module.Basis.baseChange_apply F bA m
            rw [hbFm]
            change (1 : F) ⊗ₜ[B₀] ((bA.repr a m) • bA m) =
              (algebraMap B₀ F (bA.repr a m)) • ((1 : F) ⊗ₜ[B₀] bA m)
            rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul', Algebra.smul_def,
              smul_eq_mul, mul_one]
      have h0 : (bF.repr (jA a)) k = 0 := by rw [ha, map_zero, Finsupp.zero_apply]
      rw [hexp, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply] at h0
      simp only [LinearEquiv.map_smul, bF.repr_self, Finsupp.smul_single, smul_eq_mul,
        mul_one, Finsupp.single_apply, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at h0
      exact h0
    have hunits : ∀ s ∈ nonZeroDivisors B₀, IsUnit (jA (algebraMap B₀ A s)) := by
      intro s hs
      have hs0 : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
      have hf0 : algebraMap B₀ F s ≠ 0 := fun h =>
        hs0 (IsFractionRing.injective B₀ F (h.trans (map_zero _).symm))
      have heq : jA (algebraMap B₀ A s) =
          (Algebra.TensorProduct.includeLeft : F →ₐ[B₀] TensorProduct B₀ F A)
            (algebraMap B₀ F s) := by
        change (1 : F) ⊗ₜ[B₀] algebraMap B₀ A s = (algebraMap B₀ F s) ⊗ₜ[B₀] (1 : A)
        have hsA : algebraMap B₀ A s = s • (1 : A) := by rw [Algebra.smul_def, mul_one]
        rw [hsA, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      rw [heq]
      exact (IsUnit.mk0 (algebraMap B₀ F s) hf0).map _
    have hsurj : ∀ w : TensorProduct B₀ F A, ∃ (a : A) (s : nonZeroDivisors B₀),
        w * jA (algebraMap B₀ A s.1) = jA a := by
      intro w
      refine TensorProduct.inductionOn
        (motive := fun w => ∃ (a : A) (s : nonZeroDivisors B₀),
          w * jA (algebraMap B₀ A s.1) = jA a)
        w (fun f a => ?_) (fun w₁ w₂ ih₁ ih₂ => ?_)
      · obtain ⟨⟨n₀, d₀⟩, hfd⟩ := IsLocalization.surj (nonZeroDivisors B₀) f
        dsimp only at hfd
        refine ⟨n₀ • a, d₀, ?_⟩
        change (f ⊗ₜ[B₀] a) * ((1 : F) ⊗ₜ[B₀] algebraMap B₀ A d₀.1) =
          (1 : F) ⊗ₜ[B₀] (n₀ • a)
        calc
          (f ⊗ₜ[B₀] a) * ((1 : F) ⊗ₜ[B₀] algebraMap B₀ A d₀.1)
            = (f * 1) ⊗ₜ[B₀] (a * algebraMap B₀ A d₀.1) :=
                Algebra.TensorProduct.tmul_mul_tmul f 1 a (algebraMap B₀ A d₀.1)
