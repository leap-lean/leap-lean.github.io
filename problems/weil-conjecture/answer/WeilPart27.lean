            (adj_φ.homEquiv (pf_φ.obj FM_src) (pf_πt.obj FM_tilde))
              ((adj_πt.homEquiv (pb_φ.obj (pf_φ.obj FM_src)) FM_tilde) u₁) := by
        rw [congrArg (fun e => e (pf_φ.obj FM_src) FM_tilde u₁)
          (CategoryTheory.Adjunction.comp_homEquiv adj_φ adj_πt)]
        rfl
      have h_adj₂'_u₂ :
          (adj₂'.homEquiv (pf_φ.obj FM_src) FM_tilde) u₂ =
            (adj_π.homEquiv (pf_φ.obj FM_src) (pf_φt.obj FM_tilde))
              ((adj_φt.homEquiv (pb_π.obj (pf_φ.obj FM_src)) FM_tilde) u₂) ≫
              e_R.inv.app FM_tilde := by
        rw [hadj₂'_equiv,
          congrArg (fun e => e (pf_φ.obj FM_src) FM_tilde u₂)
            (CategoryTheory.Adjunction.comp_homEquiv adj_π adj_φt)]
        rfl
      rw [h_adj₁_u₁, h_adj₂'_u₂, hL_in, hL_out, hR_in, hR_mid,
        CategoryTheory.Category.assoc, e_R.hom_inv_id_app FM_tilde]
      exact (CategoryTheory.Category.comp_id (pf_φ.map η_M_πt)).symm
    have hu_rel : e_L.inv.app (pf_φ.obj FM_src) ≫ u₁ = u₂ := by
      have hu_hom : u₁ = e_L.hom.app (pf_φ.obj FM_src) ≫ u₂ := by
        calc
