    haveI : PreirreducibleSpace ↥Γ_left := ⟨hIrred_univ_Γ.2⟩
    haveI : IrreducibleSpace ↥Γ_left := ⟨let ⟨x₀, _⟩ := hIrred_univ_Γ.1; ⟨x₀⟩⟩
    have hRed_aff : ∀ U : Z_amb.left.affineOpens,
        IsReduced ↑(Γ_left.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map ι_Γ.base).obj U.1))) := by
      intro U
      let r1 := (f.ker.subschemeObjIso U).commRingCatIsoToRingEquiv
