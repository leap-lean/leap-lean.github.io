      change pushExtToTorsRHom O₂ (2 * d) τ₀ (e_lift.symm α₁) = _
      rw [hsymm, hτ_eq]
    · intro Z₁ Z₂ _ _ f hf_over m hm O₂ O₁ hO₁ hf_free hDim₁ α₁
      let τ₀ := Classical.choose (hDetExUniq Z₁ Z₂ f hf_over m hm O₂ O₁ hO₁ hf_free).1
