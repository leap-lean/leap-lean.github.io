          have hψC_inj : Function.Injective ψ_C := by
            rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
            intro g hg
            rw [LinearMap.mem_ker] at hg
            let surj_g : ∀ j : Fin δ, R₂ × Submonoid.powers (r * s) := fun j =>
              Classical.choose (IsLocalization.surj (Submonoid.powers (r * s)) (g j))
            have hsurj_g : ∀ j : Fin δ,
                g j * algebraMap R₂ C₂ (surj_g j).2.1 = algebraMap R₂ C₂ (surj_g j).1 := fun j =>
              Classical.choose_spec (IsLocalization.surj (Submonoid.powers (r * s)) (g j))
            let n_j : Fin δ → ℕ := fun j => Classical.choose (surj_g j).2.2
            have hn_j : ∀ j : Fin δ, (r * s) ^ n_j j = (surj_g j).2.1 := fun j =>
