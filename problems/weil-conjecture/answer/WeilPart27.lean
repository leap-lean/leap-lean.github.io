              change I.mkQ (y - j) = 0
              rw [map_sub, hjy, sub_self]
            have hsum : y = y - j + j := (sub_add_cancel y j).symm
            rw [hsum]
            exact J.add_mem (le_of_lt hIJ hdiff) hjJ
          rcases lt_or_eq_of_le hI_le with hI_lt | hI_eq
          · right
            have hJ'_eq : J' = J := by
              rcases lt_or_eq_of_le hJ'_le with hlt | heq
              · exact False.elim (hJ_min J' hI_lt hlt)
              · exact heq
