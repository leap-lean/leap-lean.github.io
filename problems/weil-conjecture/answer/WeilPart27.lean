          have hw_e : (Fgt_t.map (e_fun.inv.app U_x)).left ≫
              (Fgt_t.obj (B_πt.obj (B_φ.obj U_x))).hom =
              (Fgt_t.obj (B_φt.obj (B_π.obj U_x))).hom :=
            CategoryTheory.MorphismProperty.Over.w (e_fun.inv.app U_x)
          have hw_k : (Fgt_t.map (B_φt.map k'_w)).left ≫
              (Fgt_t.obj (B_φt.obj (B_π.obj U_x))).hom =
              (Fgt_t.obj (B_φt.obj V_w)).hom :=
            CategoryTheory.MorphismProperty.Over.w (B_φt.map k'_w)
          dsimp [q₁]
          rw [Category.assoc, Category.assoc, hw_pb,
            ← Category.assoc (Fgt_t.map (e_fun.inv.app U_x)).left, hw_e,
            ← Category.assoc, hw_k]
        have hOuter_sq : CategoryTheory.IsPullback
            (q₁ ≫ (Fgt_Y.obj (B_φ.obj U_x)).hom) fst_Vw_φt
            φ (p_bot ≫ (Fgt_Y.obj U_x).hom) := by
          rw [hq₁_tri, hp_bot_tri]
          exact ((CategoryTheory.IsPullback.of_hasPullback
            (Fgt_V.obj V_w).hom φ_tilde).flip).paste_horiz hPb
        have hRight_sq : CategoryTheory.IsPullback
            (Fgt_Y.obj (B_φ.obj U_x)).hom fst_Ux_φ
            φ (Fgt_Y.obj U_x).hom :=
          (CategoryTheory.IsPullback.of_hasPullback (Fgt_Y.obj U_x).hom φ).flip
        have hPb_aff : CategoryTheory.IsPullback fst_Vw_φt q₁ p_bot fst_Ux_φ :=
          (CategoryTheory.IsPullback.of_right hOuter_sq hq₁_comm hRight_sq).flip

        
        have hAff_Ux_et : AlgebraicGeometry.IsAffine (Fgt_Y.obj U_x).left := hAff_WU
        have hAff_Vw_et : AlgebraicGeometry.IsAffine (Fgt_V.obj V_w).left := hAff_WV
        haveI : AlgebraicGeometry.IsAffine (Fgt_Y.obj U_x).left := hAff_Ux_et
        haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj V_w).left := hAff_Vw_et
        haveI : AlgebraicGeometry.IsAffine (Fgt_Y.obj (B_φ.obj U_x)).left := by
          change AlgebraicGeometry.IsAffine
            (CategoryTheory.Limits.pullback (Fgt_Y.obj U_x).hom φ)
          infer_instance
        haveI : AlgebraicGeometry.IsAffine (Fgt_t.obj (B_φt.obj V_w)).left := by
          change AlgebraicGeometry.IsAffine
            (CategoryTheory.Limits.pullback (Fgt_V.obj V_w).hom φ_tilde)
          infer_instance
        obtain ⟨e_tens_sq, he_tens_sq⟩ := hB_aff_pb hPb_aff
        let σ_x : ↑(FM_Y.obj.obj (Opposite.op (B_φ.obj U_x))) :=
          (FM_Y.obj.map (Opposite.op (B_φ.map j_x))) σ
        let u_x : LocallyConstant ↥(Fgt_Y.obj (B_φ.obj U_x)).left (ULift.{u} (ZMod n)) :=
          ((D.Φ_loc Y.left).hom.hom.app (Opposite.op (B_φ.obj U_x))) σ_x
        let R_Ux : Type u := ↑(((Fgt_Y.obj U_x).left).presheaf.obj (Opposite.op ⊤))
        let S_Ux : Type u := ↑(((Fgt_Y.obj (B_φ.obj U_x)).left).presheaf.obj (Opposite.op ⊤))
        let R_Vw : Type u := ↑(((Fgt_V.obj V_w).left).presheaf.obj (Opposite.op ⊤))
        let S_Vw : Type u := ↑(((Fgt_t.obj (B_φt.obj V_w)).left).presheaf.obj (Opposite.op ⊤))
        let ρ_Ux : R_Ux →+* S_Ux := CommRingCat.Hom.hom fst_Ux_φ.appTop
        let ρ_Vw : R_Vw →+* S_Vw := CommRingCat.Hom.hom fst_Vw_φt.appTop
        let ψ_bot_sq : R_Ux →+* R_Vw := CommRingCat.Hom.hom p_bot.appTop
        let ψ_q₁ : S_Ux →+* S_Vw := CommRingCat.Hom.hom q₁.appTop
        obtain ⟨L_x, hL_x⟩ := hA_ex ρ_Ux M_x e_x he_x (D.ι_ζ Y (B_φ.obj U_x) u_x)
        let v_x : LocallyConstant ↥(Fgt_Y.obj U_x).left (ULift.{u} (ZMod n)) :=
          ((D.Φ_loc Y.left).hom.hom.app (Opposite.op U_x)) ((τ_M.hom.app (Opposite.op U_x)) σ_x)
        have hτ_M_Ux : D.ι_ζ Y U_x v_x = ((LinearMap.toMatrix b_x b_x) L_x).det :=
          hτ_M U_x hAff_Ux_et M_x hAdd_Mx hMod_Mx b_x e_x he_x σ_x L_x hL_x
        letI : Algebra R_Ux R_Vw := RingHom.toAlgebra ψ_bot_sq
        letI : Algebra R_Ux S_Ux := RingHom.toAlgebra ρ_Ux
        let e_x_lin : M_x ≃ₗ[R_Ux] S_Ux :=
          { e_x with map_smul' := fun r₀ m => he_x r₀ m }
        let M_Vw : Type u := TensorProduct R_Ux R_Vw M_x
        let b_Vw : Module.Basis (Fin δ) R_Vw M_Vw := b_x.baseChange R_Vw
        let e_Vw : M_Vw ≃+ S_Vw :=
          (LinearEquiv.baseChange R_Ux R_Vw M_x S_Ux e_x_lin).toAddEquiv.trans e_tens_sq
        have he_Vw : ∀ (r'₀ : R_Vw) (m' : M_Vw), e_Vw (r'₀ • m') = ρ_Vw r'₀ * e_Vw m' := by
          intro r'₀ m'
          refine TensorProduct.induction_on
            (motive := fun m' => e_Vw (r'₀ • m') = ρ_Vw r'₀ * e_Vw m') m' ?_ ?_ ?_
          · simp only [smul_zero, map_zero, mul_zero]
          · intro r'₁ m
            change e_tens_sq ((LinearEquiv.baseChange R_Ux R_Vw M_x S_Ux e_x_lin)
                (r'₀ • (r'₁ ⊗ₜ[R_Ux] m))) =
              ρ_Vw r'₀ * e_tens_sq ((LinearEquiv.baseChange R_Ux R_Vw M_x S_Ux e_x_lin)
                (r'₁ ⊗ₜ[R_Ux] m))
            rw [TensorProduct.smul_tmul', smul_eq_mul, LinearEquiv.baseChange_tmul,
              LinearEquiv.baseChange_tmul]
            erw [he_tens_sq (r'₀ * r'₁) (e_x_lin m), he_tens_sq r'₁ (e_x_lin m)]
            change ρ_Vw (r'₀ * r'₁) * _ = ρ_Vw r'₀ * (ρ_Vw r'₁ * _)
            rw [map_mul, mul_assoc]
          · intro m₁ m₂ ih₁ ih₂
            rw [smul_add, map_add, ih₁, ih₂, map_add, mul_add]

        
        let g_L : LocallyConstant ↥(Fgt_V.obj (B_π.obj U)).left (ULift.{u} (ZMod n)) :=
          (α_L.hom.app (Opposite.op U)) σ
        let g_R : LocallyConstant ↥(Fgt_V.obj (B_π.obj U)).left (ULift.{u} (ZMod n)) :=
          (α_R.hom.app (Opposite.op U)) σ
        change g_L w = g_R w
        let g_L_Vw : LocallyConstant ↥(Fgt_V.obj V_w).left (ULift.{u} (ZMod n)) :=
          ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op j_V)) g_L
        let g_R_Vw : LocallyConstant ↥(Fgt_V.obj V_w).left (ULift.{u} (ZMod n)) :=
          ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op j_V)) g_R
        suffices hVw_eq : g_L_Vw = g_R_Vw by
          exact congrArg
            (fun f_v : LocallyConstant ↥(Fgt_V.obj V_w).left (ULift.{u} (ZMod n)) =>
              f_v ⟨w, hw_WV⟩) hVw_eq
        apply hι_inj Γ_V V_w
        
        have hg_R_Vw_eq : g_R_Vw =
            ⟨fun y_V => v_x (p_bot.base y_V),
              fun t => p_bot.base.hom.continuous.isOpen_preimage _ (v_x.isLocallyConstant t)⟩ := by
          have hnat_R : ((weilAltLocConstPresheaf Γ_V.left n).map
              (Opposite.op (B_π.map j_x))) g_R =
              (α_R.hom.app (Opposite.op U_x)) σ_x :=
            (congrArg (fun φ_m => φ_m σ) (α_R.hom.naturality (Opposite.op j_x))).symm
          have hcomp_R : g_R_Vw =
              ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op k'_w))
                ((α_R.hom.app (Opposite.op U_x)) σ_x) := by
            have hj1 : (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op j_V) =
                (weilAltLocConstPresheaf Γ_V.left n).map
                  (Opposite.op (k'_w ≫ B_π.map j_x)) :=
              congrArg (fun h => (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op h))
                hk'_j.symm
            have hj2 : (weilAltLocConstPresheaf Γ_V.left n).map
                (Opposite.op (k'_w ≫ B_π.map j_x)) =
                (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op (B_π.map j_x)) ≫
                  (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op k'_w) :=
              (weilAltLocConstPresheaf Γ_V.left n).map_comp
                (Opposite.op (B_π.map j_x)) (Opposite.op k'_w)
            exact (congrArg (fun φ_m => φ_m g_R) (hj1.trans hj2)).trans
              (congrArg ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op k'_w)) hnat_R)
          rw [hcomp_R]
          exact LocallyConstant.ext fun _ => rfl
        have hι_R_Vw : D.ι_ζ Γ_V V_w g_R_Vw =
            ψ_bot_sq (((LinearMap.toMatrix b_x b_x) L_x).det) := by
          rw [hg_R_Vw_eq, hι_cross Γ_V Y π hπ_over V_w U_x p_bot hp_bot_tri v_x, hτ_M_Ux]

        
        let s_epf_Ux :
            LocallyConstant ↥(Fgt_t.obj (B_φt.obj (B_π.obj U_x))).left (ULift.{u} (ZMod n)) :=
          ((e_pf.hom.app LSh_t).hom.app (Opposite.op U_x))
            (((weilAltLocConstPullbackNat π_tilde n).app (Opposite.op (B_φ.obj U_x))) u_x)
        let s_w : LocallyConstant ↥(Fgt_t.obj (B_φt.obj V_w)).left (ULift.{u} (ZMod n)) :=
          ((weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (B_φt.map k'_w))) s_epf_Ux
        have hg_L_Vw_eq : g_L_Vw = (τ_tilde_L.hom.app (Opposite.op V_w)) s_w := by
          have hnat_L : ((weilAltLocConstPresheaf Γ_V.left n).map
              (Opposite.op (B_π.map j_x))) g_L =
              (α_L.hom.app (Opposite.op U_x)) σ_x :=
            (congrArg (fun φ_m => φ_m σ) (α_L.hom.naturality (Opposite.op j_x))).symm
          have hcomp_L : g_L_Vw =
              ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op k'_w))
                ((α_L.hom.app (Opposite.op U_x)) σ_x) := by
            have hj1 : (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op j_V) =
                (weilAltLocConstPresheaf Γ_V.left n).map
                  (Opposite.op (k'_w ≫ B_π.map j_x)) :=
              congrArg (fun h => (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op h))
                hk'_j.symm
            have hj2 : (weilAltLocConstPresheaf Γ_V.left n).map
                (Opposite.op (k'_w ≫ B_π.map j_x)) =
                (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op (B_π.map j_x)) ≫
                  (weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op k'_w) :=
              (weilAltLocConstPresheaf Γ_V.left n).map_comp
                (Opposite.op (B_π.map j_x)) (Opposite.op k'_w)
            exact (congrArg (fun φ_m => φ_m g_L) (hj1.trans hj2)).trans
              (congrArg ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op k'_w)) hnat_L)
          rw [hcomp_L]
          exact (congrArg (fun φ_m => φ_m s_epf_Ux)
            (τ_tilde_L.hom.naturality (Opposite.op k'_w))).symm
        have hs_w_eq : s_w =
            ⟨fun z => u_x (q₁.base z),
              fun t => q₁.base.hom.continuous.isOpen_preimage _ (u_x.isLocallyConstant t)⟩ := by
          apply LocallyConstant.ext
          intro z
          have hepf_app : (e_pf.hom.app LSh_t).hom.app (Opposite.op U_x) =
              (weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (e_fun.inv.app U_x)) := by
            dsimp [e_pf]
            rw [CategoryTheory.Functor.sheafPushforwardContinuousIso_hom]
            rfl
          have hs_epf_eq : s_epf_Ux =
              ((weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (e_fun.inv.app U_x)))
                (((weilAltLocConstPullbackNat π_tilde n).app (Opposite.op (B_φ.obj U_x))) u_x) :=
            congrArg
              (fun φ_m => φ_m
                (((weilAltLocConstPullbackNat π_tilde n).app (Opposite.op (B_φ.obj U_x))) u_x))
              hepf_app
          change s_epf_Ux ((Fgt_t.map (B_φt.map k'_w)).left.base z) = u_x (q₁.base z)
          rw [hs_epf_eq]
          rfl
        have hι_sw : D.ι_ζ Γ_tilde (B_φt.obj V_w) s_w =
            ψ_q₁ (D.ι_ζ Y (B_φ.obj U_x) u_x) := by
          rw [hs_w_eq]
          exact hι_cross Γ_tilde Y π_tilde hπt_over (B_φt.obj V_w) (B_φ.obj U_x) q₁ hq₁_tri u_x
        obtain ⟨L_Vw, hL_Vw⟩ := hA_ex ρ_Vw M_Vw e_Vw he_Vw
          (D.ι_ζ Γ_tilde (B_φt.obj V_w) s_w)
        have hL_Vw_q₁ : ∀ m' : M_Vw,
            e_Vw (L_Vw m') = ψ_q₁ (D.ι_ζ Y (B_φ.obj U_x) u_x) * e_Vw m' := by
          intro m'
          rw [← hι_sw]
          exact hL_Vw m'
        have hdet_Vw : ((LinearMap.toMatrix b_Vw b_Vw) L_Vw).det =
            ψ_bot_sq (((LinearMap.toMatrix b_x b_x) L_x).det) :=
          hA_bc ρ_Ux ρ_Vw ψ_bot_sq ψ_q₁ e_tens_sq he_tens_sq
            M_x b_x e_x he_x M_Vw b_Vw e_Vw he_Vw
            (D.ι_ζ Y (B_φ.obj U_x) u_x) L_x L_Vw hL_x hL_Vw_q₁
        have hι_L_Vw : D.ι_ζ Γ_V V_w g_L_Vw =
            ψ_bot_sq (((LinearMap.toMatrix b_x b_x) L_x).det) := by
          have hspec_Vw : D.ι_ζ Γ_V V_w ((τ_tilde_L.hom.app (Opposite.op V_w)) s_w) =
              ((LinearMap.toMatrix b_Vw b_Vw) L_Vw).det :=
            hτ_lc_spec V_w hAff_Vw_et M_Vw inferInstance inferInstance b_Vw e_Vw he_Vw s_w L_Vw hL_Vw
          rw [hg_L_Vw_eq, hspec_Vw, hdet_Vw]
        exact hι_L_Vw.trans hι_R_Vw.symm

theorem weil_top_deg_shriek_witness_alignment_and_cartesian_leray (k : Type u) [Field k]
    (n : ℕ) (hn : 2 ≤ n)
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (D : WeilTopDegKummerZeroBdrySiteData k n)
    (hNorm : WeilTopDegKummerZeroBdrySiteNorm k n ζ D) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (δ q : ℕ) (_ : 1 ≤ δ)
        (φ : Quiver.Hom Y.left Y.left),
      CategoryTheory.CategoryStruct.comp φ Y.hom = Y.hom →
      WeilTopDegFiniteLocallyFreeOfRank δ φ →
      ∀ (φ_shriek : weilEtaleTorsionH Y.left n q →+ weilEtaleTorsionH Y.left n q),
        WeilTopDegAffineFiniteFreePushforward k n δ q ζ Y Y φ φ_shriek →
        ∃ τ_M : Quiver.Hom
            ((weilTopDegKummerZeroBdryPush D φ).obj (weilEtaleTorsionSheaf Y.left n))
            (weilEtaleTorsionSheaf Y.left n),
          (∀ (U : Y.left.Etale)
              (_ : AlgebraicGeometry.IsAffine
                ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left)
              (M : Type u) (_ : AddCommGroup M)
              (_ : Module ↑((((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left).presheaf.obj (Opposite.op ⊤)) M)
              (bM : Module.Basis (Fin δ)
                ↑((((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left).presheaf.obj (Opposite.op ⊤)) M)
              (e : M ≃+ ↑((((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj
                ((weilEtaleSitePullback φ).obj U)).left).presheaf.obj (Opposite.op ⊤))),
            (∀ (r₀ : ↑((((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left).presheaf.obj (Opposite.op ⊤)))
               (m : M),
              e (r₀ • m) =
                @Mul.mul
                  ↑((((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj
                    ((weilEtaleSitePullback φ).obj U)).left).presheaf.obj (Opposite.op ⊤)) _
                  (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop
                    (CategoryTheory.Limits.pullback.fst
                      (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).hom) φ)) r₀)
                  (e m)) →
            ∀ (σ : ↑((weilEtaleTorsionSheaf Y.left n).obj.obj
                  (Opposite.op ((weilEtaleSitePullback φ).obj U))))
              (L : M →ₗ[↑((((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left).presheaf.obj (Opposite.op ⊤))] M),
              (∀ m : M, e (L m) =
                D.ι_ζ Y ((weilEtaleSitePullback φ).obj U)
                  (((D.Φ_loc Y.left).hom.hom.app
                    (Opposite.op ((weilEtaleSitePullback φ).obj U))) σ) * e m) →
              D.ι_ζ Y U (((D.Φ_loc Y.left).hom.hom.app (Opposite.op U))
                ((τ_M.hom.app (Opposite.op U)) σ)) =
                ((LinearMap.toMatrix bM bM) L).det) ∧
          (∀ (α : weilEtaleTorsionH Y.left n q),
            ∃ ξ : CategoryTheory.Abelian.Ext (weilTopDegKummerZeroBdryFℤ Y.left)
                ((weilTopDegKummerZeroBdryPush D φ).obj (weilEtaleTorsionSheaf Y.left n)) q,
              (CategoryTheory.Abelian.Ext.mk₀
                  ((weilTopDegKummerZeroBdryAdj D φ).counit.app
                    (weilEtaleTorsionSheaf Y.left n))).postcomp
                (weilTopDegKummerZeroBdryFℤ Y.left) (Nat.add_zero q)
                ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all φ)).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _
                    (weilTopDegKummerZeroBdryPull D φ)
                    (D.hAdd_all φ) (D.hLim_all φ) (D.hColim_all φ) _ _
                    (weilTopDegKummerZeroBdryFℤ Y.left)
                    ((weilTopDegKummerZeroBdryPush D φ).obj
                      (weilEtaleTorsionSheaf Y.left n)) q) ξ)
                  (Nat.zero_add q)) = α ∧
              φ_shriek α =
                ((CategoryTheory.Abelian.Ext.mk₀ τ_M).postcomp
                  (weilTopDegKummerZeroBdryFℤ Y.left) (Nat.add_zero q)) ξ)) ∧
    (∀ {Y_src Y_tgt Γ_V Γ_tilde : AlgebraicGeometry.Scheme.{u}}
        (φ : Quiver.Hom Y_src Y_tgt)
        (π : Quiver.Hom Γ_V Y_tgt)
        (π_tilde : Quiver.Hom Γ_tilde Y_src)
        (φ_tilde : Quiver.Hom Γ_tilde Γ_V)
        (hw : CategoryTheory.CategoryStruct.comp π_tilde φ =
          CategoryTheory.CategoryStruct.comp φ_tilde π)
        (q : ℕ)
        (p_πt : weilEtaleTorsionH Y_src n q →+ weilEtaleTorsionH Γ_tilde n q),
      WeilIsTorsionEtalePullback π_tilde n q p_πt →
      ∀ (ξ : CategoryTheory.Abelian.Ext (weilTopDegKummerZeroBdryFℤ Y_tgt)
          ((weilTopDegKummerZeroBdryPush D φ).obj (weilEtaleTorsionSheaf Y_src n)) q),
        let B_φ : CategoryTheory.Functor Y_tgt.Etale Y_src.Etale := weilEtaleSitePullback φ
        let B_π : CategoryTheory.Functor Y_tgt.Etale Γ_V.Etale := weilEtaleSitePullback π
        let B_φt : CategoryTheory.Functor Γ_V.Etale Γ_tilde.Etale :=
          weilEtaleSitePullback φ_tilde
        let B_πt : CategoryTheory.Functor Y_src.Etale Γ_tilde.Etale :=
          weilEtaleSitePullback π_tilde
        let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_φ B_πt)
            (CategoryTheory.Functor.comp B_π B_φt) :=
          CategoryTheory.Iso.trans
            (CategoryTheory.Iso.symm
              (CategoryTheory.MorphismProperty.Over.pullbackComp π_tilde φ))
            (CategoryTheory.Iso.trans
              (CategoryTheory.MorphismProperty.Over.pullbackCongr hw)
              (CategoryTheory.MorphismProperty.Over.pullbackComp φ_tilde π))
        letI : (CategoryTheory.Functor.comp B_φ B_πt).IsContinuous
            Y_tgt.smallEtaleTopology Γ_tilde.smallEtaleTopology :=
          @CategoryTheory.Functor.isContinuous_comp _ _ _ _ _ _ B_φ B_πt
            Y_tgt.smallEtaleTopology Y_src.smallEtaleTopology
            Γ_tilde.smallEtaleTopology
            (D.hCont_all φ) (D.hCont_all π_tilde)
        letI : (CategoryTheory.Functor.comp B_π B_φt).IsContinuous
            Y_tgt.smallEtaleTopology Γ_tilde.smallEtaleTopology :=
          @CategoryTheory.Functor.isContinuous_comp _ _ _ _ _ _ B_π B_φt
            Y_tgt.smallEtaleTopology Γ_V.smallEtaleTopology
            Γ_tilde.smallEtaleTopology
