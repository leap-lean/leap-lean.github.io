          CategoryTheory.Limits.pullback (FgtS.obj O_et).hom f :=
        CategoryTheory.Limits.pullback.lift (fst_O₁ ≫ g_O_et) (snd_O₁ ≫ ι_X') (by
          rw [CategoryTheory.Category.assoc, hg_O_hom, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
            ← hPb.w, CategoryTheory.Category.assoc])
      have hq_O₁_fst : q_O₁ ≫ fst_O = fst_O₁ ≫ g_O_et :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hq_O₁_snd : q_O₁ ≫ snd_O = snd_O₁ ≫ ι_X' :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      let map_uO : CategoryTheory.Limits.pullback (FgtS.obj O_et).hom f ⟶
          CategoryTheory.Limits.pullback (FgtS.obj U_et).hom f :=
        (FgtX.map (B_f.map u_O)).left
      let map_uO₁ : CategoryTheory.Limits.pullback (FgtS'.obj O₁_et).hom f' ⟶
          CategoryTheory.Limits.pullback (FgtS'.obj U_1).hom f' :=
        (FgtX'.map (B_f'.map u_O₁)).left
      let q_U_sch : CategoryTheory.Limits.pullback (FgtS'.obj U_1).hom f' ⟶
          CategoryTheory.Limits.pullback (FgtS.obj U_et).hom f := q_U
      have hq_O₁_compat : q_O₁ ≫ map_uO = map_uO₁ ≫ q_U_sch := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hm₁ : map_uO ≫ CategoryTheory.Limits.pullback.fst (FgtS.obj U_et).hom f =
              fst_O ≫ (FgtS.map u_O).left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hm₂ : map_uO₁ ≫ CategoryTheory.Limits.pullback.fst (FgtS'.obj U_1).hom f' =
              fst_O₁ ≫ (FgtS'.map u_O₁).left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hq_fst' : q_U_sch ≫ CategoryTheory.Limits.pullback.fst (FgtS.obj U_et).hom f =
              CategoryTheory.Limits.pullback.fst (FgtS'.obj U_1).hom f' ≫ fst_1 := hq_fst
          have hg_O_fac' : g_O_et ≫ (FgtS.map u_O).left = (FgtS'.map u_O₁).left ≫ fst_1 :=
            hg_O_fac
          exact (CategoryTheory.Category.assoc q_O₁ map_uO _).trans
            ((congrArg (q_O₁ ≫ ·) hm₁).trans
              ((CategoryTheory.Category.assoc q_O₁ fst_O _).symm.trans
                ((congrArg (· ≫ (FgtS.map u_O).left) hq_O₁_fst).trans
                  ((CategoryTheory.Category.assoc fst_O₁ g_O_et _).trans
                    ((congrArg (fst_O₁ ≫ ·) hg_O_fac').trans
                      ((CategoryTheory.Category.assoc fst_O₁ (FgtS'.map u_O₁).left fst_1).symm.trans
                        ((congrArg (· ≫ fst_1) hm₂.symm).trans
                          ((CategoryTheory.Category.assoc map_uO₁ _ fst_1).trans
                            ((congrArg (map_uO₁ ≫ ·) hq_fst'.symm).trans
                              (CategoryTheory.Category.assoc map_uO₁ q_U_sch _).symm)))))))))
        · have hm₁ : map_uO ≫ CategoryTheory.Limits.pullback.snd (FgtS.obj U_et).hom f =
              snd_O :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hm₂ : map_uO₁ ≫ CategoryTheory.Limits.pullback.snd (FgtS'.obj U_1).hom f' =
              snd_O₁ :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hq_snd' : q_U_sch ≫ CategoryTheory.Limits.pullback.snd (FgtS.obj U_et).hom f =
              CategoryTheory.Limits.pullback.snd (FgtS'.obj U_1).hom f' ≫ ι_X' := hq_snd
          rw [CategoryTheory.Category.assoc, hm₁, hq_O₁_snd,
            CategoryTheory.Category.assoc, hq_snd', ← CategoryTheory.Category.assoc, hm₂]
      have hAff_O_et : AlgebraicGeometry.IsAffine (FgtS.obj O_et).left := hAff_O
      have hAff_O₁_et : AlgebraicGeometry.IsAffine (FgtS'.obj O₁_et).left := hAff_O₁
      let _ : AlgebraicGeometry.IsAffine (FgtS.obj O_et).left := hAff_O_et
      let _ : AlgebraicGeometry.IsAffine (FgtS'.obj O₁_et).left := hAff_O₁_et
      have hSub_O_id : Set.range ((FgtS.obj O_et).hom ≫ 𝟙 S.left).base ⊆ (U : Set ↥S.left) := by
        rw [CategoryTheory.Category.comp_id]
        exact hSub_O
      obtain ⟨M_O, hAdd_O, hMod_O, b_O, e_O, he_O⟩ := (h_s3_id_2a (FgtS.obj O_et).hom hSub_O_id).2
      obtain ⟨M_O₁, hAdd_O₁, hMod_O₁, b_O₁, e_O₁, he_O₁⟩ :=
        (h_s3_pb_2a (FgtS'.obj O₁_et).hom hSub_O₁_S).2
      let _ : AddCommGroup M_O := hAdd_O
      let _ : Module ↑(((FgtS.obj O_et).left).presheaf.obj (Opposite.op ⊤)) M_O := hMod_O
      let _ : AddCommGroup M_O₁ := hAdd_O₁
      let _ : Module ↑(((FgtS'.obj O₁_et).left).presheaf.obj (Opposite.op ⊤)) M_O₁ := hMod_O₁
      obtain ⟨e_tensor, he_tensor⟩ :=
        h_s3_pb_2b (FgtS.obj O_et).hom hSub_O (FgtS'.obj O₁_et).hom g_O_et hg_O_hom
          q_O₁ hq_O₁_fst hq_O₁_snd
      let σ_O : ↥(weilAltZeroBdrySubgroup X.left V₀ n W_O) :=
        ((weilAltZeroBdrySubpresheaf X.left V₀ n).map (Opposite.op (B_f.map u_O))).hom σ
      let σ_O₁ : ↥(weilAltZeroBdrySubgroup X'.left V'₀ n W_O₁) :=
        ((weilAltZeroBdrySubpresheaf X'.left V'₀ n).map (Opposite.op (B_f'.map u_O₁))).hom σ_s
      let q_O₁_et : (FgtX'.obj W_O₁).left ⟶ (FgtX.obj W_O).left := q_O₁
      have hq_O₁_ov : CategoryTheory.CategoryStruct.comp q_O₁_et
          (CategoryTheory.CategoryStruct.comp (FgtX.obj W_O).hom X.hom) =
          CategoryTheory.CategoryStruct.comp (FgtX'.obj W_O₁).hom X'.hom := by
        change q_O₁ ≫ snd_O ≫ X.hom = snd_O₁ ≫ X'.hom
        rw [← CategoryTheory.Category.assoc, hq_O₁_snd, CategoryTheory.Category.assoc, hιX'_ov]
      have hσ_O₁_eq : ∀ w : ↥(FgtX'.obj W_O₁).left, σ_O₁.1 w = σ_O.1 (q_O₁_et.base w) := by
        intro w
        change σ_s.1 (map_uO₁.base w) = σ.1 (map_uO.base (q_O₁.base w))
        rw [hσ_eq (map_uO₁.base w)]
        exact congrArg σ.1 (congrArg (fun m => m.base w) hq_O₁_compat.symm)
      have hu_cross : D.ι_ζ X' W_O₁ σ_O₁.1 = q_O₁_et.appTop.hom (D.ι_ζ X W_O σ_O.1) :=
        hζ_cross X' X W_O₁ W_O q_O₁_et hq_O₁_ov σ_O.1 σ_O₁.1 hσ_O₁_eq
      let ρ_O : ↑(((FgtS.obj O_et).left).presheaf.obj (Opposite.op ⊤)) →+*
          ↑((CategoryTheory.Limits.pullback (FgtS.obj O_et).hom f).presheaf.obj (Opposite.op ⊤)) :=
        CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop fst_O)
      let ρ_O₁ : ↑(((FgtS'.obj O₁_et).left).presheaf.obj (Opposite.op ⊤)) →+*
          ↑((CategoryTheory.Limits.pullback (FgtS'.obj O₁_et).hom f').presheaf.obj (Opposite.op ⊤)) :=
        CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop fst_O₁)
      let u_O_val : ↑((CategoryTheory.Limits.pullback (FgtS.obj O_et).hom f).presheaf.obj
          (Opposite.op ⊤)) :=
        D.ι_ζ X W_O σ_O.1
      let u_O₁_val : ↑((CategoryTheory.Limits.pullback (FgtS'.obj O₁_et).hom f').presheaf.obj
          (Opposite.op ⊤)) :=
        D.ι_ζ X' W_O₁ σ_O₁.1
      obtain ⟨L_O, hL_O⟩ := (h_s2_1 _ _ ρ_O M_O b_O e_O he_O).1 u_O_val
      obtain ⟨L_O₁, hL_O₁⟩ := (h_s2_1 _ _ ρ_O₁ M_O₁ b_O₁ e_O₁ he_O₁).1 u_O₁_val
      have hL_O₁_psi : ∀ m₁ : M_O₁, e_O₁ (L_O₁ m₁) = q_O₁.appTop.hom u_O_val * e_O₁ m₁ := by
        intro m₁
        have hu' : u_O₁_val = q_O₁.appTop.hom u_O_val := hu_cross
        rw [hL_O₁ m₁, hu']
      have hdet_bc : ((LinearMap.toMatrix b_O₁ b_O₁) L_O₁).det =
          g_O_et.appTop.hom (((LinearMap.toMatrix b_O b_O) L_O).det) :=
        h_s2_2 _ _ _ _ ρ_O ρ_O₁ g_O_et.appTop.hom q_O₁.appTop.hom e_tensor he_tensor
          M_O b_O e_O he_O M_O₁ b_O₁ e_O₁ he_O₁ u_O_val L_O L_O₁ hL_O hL_O₁_psi
      have hDet_O := hDet O_et hAff_O_et hSub_O M_O _ _ b_O e_O he_O σ_O L_O hL_O
      have hDet_O₁ := hDet' O₁_et hAff_O₁_et hSub_O₁ M_O₁ _ _ b_O₁ e_O₁ he_O₁ σ_O₁ L_O₁ hL_O₁
      let v_O : LocallyConstant ↥(FgtS.obj O_et).left (ULift.{u} (ZMod n)) :=
        ((weilAltLocConstPresheaf S.left n).map (Opposite.op u_O)).hom v
      let v'_O₁ : LocallyConstant ↥(FgtS'.obj O₁_et).left (ULift.{u} (ZMod n)) :=
        ((weilAltLocConstPresheaf S'.left n).map (Opposite.op u_O₁)).hom v'
      have hnat_τ : ((τ_norm.hom.app (Opposite.op O_et)).hom σ_O).1 = v_O := by
        have hnat₀ := τ_norm.hom.naturality (Opposite.op u_O)
        exact congrArg (fun φ => Subtype.val (AddCommGrpCat.Hom.hom φ σ)) hnat₀
      have hnat_τ' : ((τ_norm'.hom.app (Opposite.op O₁_et)).hom σ_O₁).1 = v'_O₁ := by
        have hnat'₀ := τ_norm'.hom.naturality (Opposite.op u_O₁)
        exact congrArg (fun φ => Subtype.val (AddCommGrpCat.Hom.hom φ σ_s)) hnat'₀
      let w₁ : LocallyConstant ↥(FgtS'.obj O₁_et).left (ULift.{u} (ZMod n)) :=
        { toFun := fun z₁ => v_O (g_O_et.base z₁)
          isLocallyConstant := fun t =>
            g_O_et.continuous.isOpen_preimage _ (v_O.isLocallyConstant t) }
      have hg_O_ov : CategoryTheory.CategoryStruct.comp g_O_et
          (CategoryTheory.CategoryStruct.comp (FgtS.obj O_et).hom S.hom) =
          CategoryTheory.CategoryStruct.comp (FgtS'.obj O₁_et).hom S'.hom := by
        rw [← CategoryTheory.Category.assoc, hg_O_hom, CategoryTheory.Category.assoc, hιS'_ov]
      have hw₁_ι : D.ι_ζ S' O₁_et w₁ = D.ι_ζ S' O₁_et v'_O₁ :=
        (hζ_cross S' S O₁_et O_et g_O_et hg_O_ov v_O w₁ (fun _ => rfl)).trans
          ((congrArg g_O_et.appTop.hom
              ((congrArg (D.ι_ζ S O_et) hnat_τ.symm).trans hDet_O)).trans
            (hdet_bc.symm.trans
              (hDet_O₁.symm.trans (congrArg (D.ι_ζ S' O₁_et) hnat_τ'))))
      have hv'_eq_w₁ : v'_O₁ = w₁ := hζ_inj S' O₁_et hw₁_ι.symm
      let z_x : ↥(FgtS'.obj O₁_et).left := ⟨x, hx_O₁⟩
      have heval := congrArg (fun g => g z_x) hv'_eq_w₁
      change v' (O₁.ι.base ⟨x, hx_O₁⟩) = v (O.ι.base (g_O.base ⟨x, hx_O₁⟩)) at heval
      have hpt : O.ι.base (g_O.base ⟨x, hx_O₁⟩) = fst_1.base x := by
        change (g_O ≫ O.ι).base ⟨x, hx_O₁⟩ = fst_1.base x
        rw [hg_O_fac]
        rfl
      rw [hpt] at heval
      exact heval
    · 
      have hv0 : v (fst_1.base x) = 0 :=
        ((τ_norm.hom.app (Opposite.op U_et)).hom σ).2 (fst_1.base x) hs₀
      have hs₀' : (FgtS'.obj U_1).hom.base x ∉ (U' : Set ↥S'.left) := by
        rw [hU']
        intro hmem
        change ι_S'.base ((FgtS'.obj U_1).hom.base x) ∈ (U : Set ↥S.left) at hmem
        rw [hs₀_eq] at hmem
        exact hs₀ hmem
      have hv'0 : v' x = 0 :=
        ((τ_norm'.hom.app (Opposite.op U_1)).hom σ_s).2 x hs₀'
      exact hv'0.trans hv0.symm

theorem weil_top_deg_kummer_zero_bdry_site_leray_and_baseChange (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n) :
    ∃ D : WeilTopDegKummerZeroBdrySiteData k n,
      WeilTopDegKummerZeroBdryChartLerayPkg k n ζ D :=
by
  classical
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  obtain ⟨hLoc1, hExc2⟩ := weil_zero_bdry_locConst_sheaf_iso_and_closed_excision.{u} n
  let hSh_loc : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilAltLocConstPresheaf Z n) :=
    fun Z => (hLoc1 Z).1
  let hSh_zero : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V₀ : Z.Opens),
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilAltZeroBdrySubpresheaf Z V₀ n) :=
    fun Z V₀ => (hLoc1 Z).2.1 V₀
  let Φ_loc : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Iso (weilEtaleTorsionSheaf Z n) ⟨weilAltLocConstPresheaf Z n, hSh_loc Z⟩ :=
    fun Z => ((hLoc1 Z).2.2 (hSh_loc Z)).choose
  have hUnit_loc : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u}
          (weilEtaleIdTerminalIsTerminal.{u} Z)).unit.app AM)
        ((Φ_loc Z).hom.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Z))) =
        weilAltLocConstConstHom Z (weilEtaleIdTerminal.{u} Z) n :=
    fun Z => ((hLoc1 Z).2.2 (hSh_loc Z)).choose_spec

  
  let hCont_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
    fun f => (weil_etale_pullback_exact_adjoint f).choose
  have hAdj_ex : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (hCont_all f)).IsRightAdjoint := by
    intro X₁ X₂ f
    obtain ⟨P_pull₀, adj₀, _⟩ := (weil_etale_pullback_exact_adjoint f).choose_spec
    exact ⟨P_pull₀, ⟨adj₀⟩⟩
  let hAdj_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (hCont_all f)).IsRightAdjoint :=
    fun f => hAdj_ex f
  have hExact_ex : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      let P_pull := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (hCont_all f) (hAdj_all f)
      P_pull.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits P_pull ∧
      CategoryTheory.Limits.PreservesFiniteColimits P_pull := by
    intro X₁ X₂ f
    let P_pull := @CategoryTheory.Functor.sheafPullback _ _ _ _
      (weilEtaleSitePullback f) AddCommGrpCat.{u} _
      X₂.smallEtaleTopology X₁.smallEtaleTopology (hCont_all f) (hAdj_all f)
    let adj_pull := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      (weilEtaleSitePullback f) AddCommGrpCat.{u} _
      X₂.smallEtaleTopology X₁.smallEtaleTopology (hCont_all f) (hAdj_all f)
    obtain ⟨P_pull₀, adj₀, _, hLim₀, _, _⟩ := (weil_etale_pullback_exact_adjoint f).choose_spec
    let e_pull := CategoryTheory.Adjunction.leftAdjointUniq adj_pull adj₀
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull := by
      haveI : CategoryTheory.Limits.PreservesFiniteLimits P_pull₀ := hLim₀
      exact CategoryTheory.Limits.preservesFiniteLimits_of_natIso e_pull.symm
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull := by
      have := adj_pull.leftAdjoint_preservesColimits
      infer_instance
    have hAdd : P_pull.Additive :=
      CategoryTheory.Functor.additive_of_preserves_binary_products P_pull
    exact ⟨hAdd, hLim, hColim⟩
  have hιℤ_ex : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      let P_pull := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (hCont_all f) (hAdj_all f)
      let πℤ := @weilEtaleConstPullbackHom _ _ f (hCont_all f) (hAdj_all f) _
        (weilEtaleIdTerminalIsTerminal.{u} X₁) _ (weilEtaleIdTerminalIsTerminal.{u} X₂) Aℤ
      ∃ ιℤ : Quiver.Hom (weilTopDegKummerZeroBdryFℤ X₁)
          (P_pull.obj (weilTopDegKummerZeroBdryFℤ X₂)),
        CategoryTheory.CategoryStruct.comp ιℤ πℤ =
          CategoryTheory.CategoryStruct.id (weilTopDegKummerZeroBdryFℤ X₁) ∧
        CategoryTheory.CategoryStruct.comp πℤ ιℤ =
          CategoryTheory.CategoryStruct.id (P_pull.obj (weilTopDegKummerZeroBdryFℤ X₂)) := by
    intro X₁ X₂ f
    let B := weilEtaleSitePullback f
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B AddCommGrpCat.{u} _ J₂ J₁ (hCont_all f)
    let P_pull := @CategoryTheory.Functor.sheafPullback _ _ _ _
      B AddCommGrpCat.{u} _ J₂ J₁ (hCont_all f) (hAdj_all f)
    let adj_pull := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      B AddCommGrpCat.{u} _ J₂ J₁ (hCont_all f) (hAdj_all f)
    let T₁ := weilEtaleIdTerminal.{u} X₁
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} X₁
    let T₂ := weilEtaleIdTerminal.{u} X₂
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} X₂
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let Fℤ₁ := weilTopDegKummerZeroBdryFℤ X₁
    let Fℤ₂ := weilTopDegKummerZeroBdryFℤ X₂
    have hTB_ne : Nonempty (CategoryTheory.Limits.IsTerminal (B.obj T₂)) := by
      obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hTerm⟩ :=
        (weil_etale_pullback_exact_adjoint f).choose_spec
      exact hTerm T₂ hT₂
    let hTB : CategoryTheory.Limits.IsTerminal (B.obj T₂) := Classical.choice hTB_ne
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    let σ : T₁ ⟶ B.obj T₂ := hTB.from T₁
    have hστ : σ ≫ τ = 𝟙 T₁ := hT₁.hom_ext _ _
    have hτσ : τ ≫ σ = 𝟙 (B.obj T₂) := hTB.hom_ext _ _
    let post_σ : ∀ 𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u},
        (Aℤ ⟶ ((CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj
          (Opposite.op T₂)).obj (P_push.obj 𝒢)) ≃
        (Aℤ ⟶ ((CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj
          (Opposite.op T₁)).obj 𝒢) :=
      fun 𝒢 =>
        { toFun := fun u => u ≫ 𝒢.obj.map (Opposite.op σ)
          invFun := fun v => v ≫ 𝒢.obj.map (Opposite.op τ)
          left_inv := fun u =>
            (CategoryTheory.Category.assoc u (𝒢.obj.map (Opposite.op σ))
              (𝒢.obj.map (Opposite.op τ))).trans
              ((congrArg (u ≫ ·) ((𝒢.obj.map_comp (Opposite.op σ) (Opposite.op τ)).symm.trans
                ((congrArg (fun m => 𝒢.obj.map (Opposite.op m)) hτσ).trans
                  (𝒢.obj.map_id (Opposite.op (B.obj T₂)))))).trans
                (CategoryTheory.Category.comp_id u))
          right_inv := fun v =>
