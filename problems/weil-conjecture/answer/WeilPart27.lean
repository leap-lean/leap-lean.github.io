          (CategoryTheory.Limits.pullback.fst T_id_1.hom u).base z.1 = y.1 },
          valDiv_C (B.obj T_id_1) ((Div_sh_C.obj.map τ_id.op).hom s_C) z.1 =
            D_C (π_fib T_id_1 y z).1 := by
        intro z
