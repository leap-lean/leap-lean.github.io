  let d₀_1 : CategoryTheory.Abelian.Ext Fℤ_1 Div_sh_1 0 :=
    d_push.comp (CategoryTheory.Abelian.Ext.mk₀ u_div) (Nat.add_zero 0)
  have hd₀_eval_sec :
