          ((weilTopDegKummerZeroBdryPush D f).obj
            ((weilTopDegKummerZeroBdryPush D g).obj (weilTopDegKummerZeroBdryFℤ X₁))))
          (((weilTopDegKummerZeroBdryAdj D f).comp
            (weilTopDegKummerZeroBdryAdj D g)).homEquiv
            (weilTopDegKummerZeroBdryFℤ X₃) (weilTopDegKummerZeroBdryFℤ X₁)
            ((weilTopDegKummerZeroBdryPull D g).map πℤ_f ≫ πℤ_g)) =
          adj_c₁.unit.app Aℤ ≫
            (weilTopDegKummerZeroBdryFℤ X₁).obj.map
              (Opposite.op (hT₁.from
                ((weilEtaleSitePullback g).obj ((weilEtaleSitePullback f).obj T₃)))) := by
      intro X₁ X₂ X₃ g f hT₁ hT₂ T₃ hT₃ adj_c₁ adj_c₃ πℤ_g πℤ_f
      let T₂ := weilEtaleIdTerminal.{u} X₂
      let adj_c₂ := CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
      let pf_g := weilTopDegKummerZeroBdryPush D g
      let pb_g := weilTopDegKummerZeroBdryPull D g
      let adj_g := weilTopDegKummerZeroBdryAdj D g
      let pf_f := weilTopDegKummerZeroBdryPush D f
      let pb_f := weilTopDegKummerZeroBdryPull D f
      let adj_f := weilTopDegKummerZeroBdryAdj D f
      let Fℤ₁ := weilTopDegKummerZeroBdryFℤ X₁
      let Fℤ₂ := weilTopDegKummerZeroBdryFℤ X₂
      let Fℤ₃ := weilTopDegKummerZeroBdryFℤ X₃
      let m_g : Fℤ₂ ⟶ pf_g.obj Fℤ₁ :=
        (adj_c₂.homEquiv Aℤ (pf_g.obj Fℤ₁)).symm
          (adj_c₁.unit.app Aℤ ≫ Fℤ₁.obj.map
            (Opposite.op (hT₁.from ((weilEtaleSitePullback g).obj T₂))))
      let m_f : Fℤ₃ ⟶ pf_f.obj Fℤ₂ :=
        (adj_c₃.homEquiv Aℤ (pf_f.obj Fℤ₂)).symm
          (adj_c₂.unit.app Aℤ ≫ Fℤ₂.obj.map
            (Opposite.op (hT₂.from ((weilEtaleSitePullback f).obj T₃))))
      have hm_g_eq : (adj_g.homEquiv Fℤ₂ Fℤ₁) πℤ_g = m_g :=
        Equiv.apply_symm_apply (adj_g.homEquiv Fℤ₂ Fℤ₁) m_g
      have hm_f_eq : (adj_f.homEquiv Fℤ₃ Fℤ₂) πℤ_f = m_f :=
        Equiv.apply_symm_apply (adj_f.homEquiv Fℤ₃ Fℤ₂) m_f
      have hm_f_val : (adj_c₃.homEquiv Aℤ (pf_f.obj Fℤ₂)) m_f =
