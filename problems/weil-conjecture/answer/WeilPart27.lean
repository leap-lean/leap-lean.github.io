            Fℤ_tilde.obj.map (Opposite.op (e_fun.hom.app T_tgt)) := by
        change (e_pf.inv.app Fℤ_tilde).hom.app (Opposite.op T_tgt) = _
        dsimp only [e_pf]
        rw [CategoryTheory.Functor.sheafPushforwardContinuousIso_inv]
        rfl
      let η_tilde : Aℤ ⟶ Fℤ_tilde.obj.obj (Opposite.op (weilEtaleIdTerminal.{u} Γ_tilde)) :=
        adj_c_tilde.unit.app Aℤ
      let w₁ : B_πt.obj (B_φ.obj T_tgt) ⟶ weilEtaleIdTerminal.{u} Γ_tilde :=
        hT_tilde.from (B_πt.obj (B_φ.obj T_tgt))
      let w₂ : B_φt.obj (B_π.obj T_tgt) ⟶ weilEtaleIdTerminal.{u} Γ_tilde :=
        hT_tilde.from (B_φt.obj (B_π.obj T_tgt))
      let u_fun : B_πt.obj (B_φ.obj T_tgt) ⟶ B_φt.obj (B_π.obj T_tgt) :=
