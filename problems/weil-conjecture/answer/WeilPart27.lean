          u.base x.1 = T_id_1.hom.base y.1 } ≃
        { x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) } // u_pt x = y₀ } :=
        { toFun := fun x => ⟨x.1, Subtype.ext x.2⟩
          invFun := fun x => ⟨x.1, congrArg Subtype.val x.2⟩
