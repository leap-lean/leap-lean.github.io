    intro 𝒞 _ J _
    refine ⟨?_, ?_, ?_⟩
    · intro P hP
      let adj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
      let S_P : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P, hP⟩
      let G_P := (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P
      let η_P := adj.unit.app P
      let ε_P : G_P ⟶ S_P := adj.counit.app S_P
      let e_hom : S_P ⟶ G_P := ⟨η_P⟩
      have h_rt : CategoryTheory.CategoryStruct.comp η_P ε_P.hom = CategoryTheory.CategoryStruct.id P :=
