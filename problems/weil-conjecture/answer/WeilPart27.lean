          ((CategoryTheory.Abelian.Ext.mk₀
              ((weilTopDegKummerZeroBdryAdj D φ).counit.app
                (weilEtaleTorsionSheaf Y_src n))).postcomp
            (weilTopDegKummerZeroBdryFℤ Y_src) (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all φ)).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _
                (weilTopDegKummerZeroBdryPull D φ)
                (D.hAdd_all φ) (D.hLim_all φ) (D.hColim_all φ) _ _
                (weilTopDegKummerZeroBdryFℤ Y_tgt)
