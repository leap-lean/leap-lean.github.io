      have he_inv_app' : e_inv_T = Fℤ_tilde.obj.map (Opposite.op u_fun) := he_inv_app
      have h_comp_w :
          Fℤ_tilde.obj.map (Opposite.op w₂) ≫ Fℤ_tilde.obj.map (Opposite.op u_fun) =
            Fℤ_tilde.obj.map (Opposite.op w₁) :=
        (Fℤ_tilde.obj.map_comp (Opposite.op w₂) (Opposite.op u_fun)).symm.trans
          (congrArg (fun u => Fℤ_tilde.obj.map (Opposite.op u))
            (hT_tilde.hom_ext (u_fun ≫ w₂) w₁))
      have h_maps : (η_tilde ≫ Fℤ_tilde.obj.map (Opposite.op w₂)) ≫ e_inv_T =
          η_tilde ≫ Fℤ_tilde.obj.map (Opposite.op w₁) :=
        (congrArg ((η_tilde ≫ Fℤ_tilde.obj.map (Opposite.op w₂)) ≫ ·) he_inv_app').trans
          ((CategoryTheory.Category.assoc η_tilde (Fℤ_tilde.obj.map (Opposite.op w₂))
            (Fℤ_tilde.obj.map (Opposite.op u_fun))).trans
              (congrArg (η_tilde ≫ ·) h_comp_w))
      have hr₀ : rhs₀ = rhs₁ :=
        congrArg (adj_c_tgt.homEquiv Aℤ ((CategoryTheory.Functor.comp pf_πt pf_φ).obj Fℤ_tilde))
          (hadj₂'_equiv Fℤ_tgt Fℤ_tilde v₂)
      have hr₁ : rhs₁ = lhs₂ ≫ e_inv_T := h_split
      have hr₂ : lhs₂ ≫ e_inv_T =
          (η_tilde ≫ Fℤ_tilde.obj.map (Opposite.op w₂)) ≫ e_inv_T :=
        congrArg (· ≫ e_inv_T)
          (h_eval₂ : lhs₂ = η_tilde ≫ Fℤ_tilde.obj.map (Opposite.op w₂))
      have hl₁ : lhs₁ = η_tilde ≫ Fℤ_tilde.obj.map (Opposite.op w₁) := h_eval₁
      exact (adj_c_tgt.homEquiv Aℤ
        ((CategoryTheory.Functor.comp pf_πt pf_φ).obj Fℤ_tilde)).injective
        (hl₁.trans (hr₀.trans (hr₁.trans (hr₂.trans h_maps))).symm)

    have hv_rel : v₁ = e_L.hom.app Fℤ_tgt ≫ v₂ := by
      calc
        v₁ = (adj₁.homEquiv Fℤ_tgt Fℤ_tilde).symm ((adj₁.homEquiv Fℤ_tgt Fℤ_tilde) v₁) :=
          (Equiv.symm_apply_apply _ _).symm
        _ = (adj₁.homEquiv Fℤ_tgt Fℤ_tilde).symm ((adj₂'.homEquiv Fℤ_tgt Fℤ_tilde) v₂) := by
          rw [hv_mate]
        _ = e_L.hom.app Fℤ_tgt ≫
            (adj₂'.homEquiv Fℤ_tgt Fℤ_tilde).symm ((adj₂'.homEquiv Fℤ_tgt Fℤ_tilde) v₂) :=
          hLeftUniq_symm adj₁ adj₂' _
        _ = e_L.hom.app Fℤ_tgt ≫ v₂ := by rw [Equiv.symm_apply_apply]

    let ι_left₁ : Fℤ_tilde ⟶ (CategoryTheory.Functor.comp pb_φ pb_πt).obj Fℤ_tgt :=
      D.ιℤ_all π_tilde ≫ pb_πt.map (D.ιℤ_all φ)
    let ι_left₂ : Fℤ_tilde ⟶ (CategoryTheory.Functor.comp pb_π pb_φt).obj Fℤ_tgt :=
      D.ιℤ_all φ_tilde ≫ pb_φt.map (D.ιℤ_all π)
    have hι_left_rel : ι_left₁ ≫ e_L.hom.app Fℤ_tgt = ι_left₂ := by
      have hv₂_inv : v₂ ≫ ι_left₂ = 𝟙 _ := by
        dsimp only [v₂, ι_left₂, πℤ_φt, πℤ_π]
        rw [CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc _ (D.ιℤ_all φ_tilde),
          (hNorm.2.2.1 φ_tilde _ hT_tilde _ hT_V).2,
          CategoryTheory.Category.id_comp,
          ← pb_φt.map_comp, (hNorm.2.2.1 π _ hT_V _ hT_tgt).2, pb_φt.map_id]
        rfl
      have hι₁_inv : ι_left₁ ≫ v₁ = 𝟙 _ := by
        dsimp only [v₁, ι_left₁, πℤ_φ, πℤ_πt]
        rw [CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc (pb_πt.map (D.ιℤ_all φ)),
          ← pb_πt.map_comp, (hNorm.2.2.1 φ _ hT_src _ hT_tgt).1,
          pb_πt.map_id, CategoryTheory.Category.id_comp,
          (hNorm.2.2.1 π_tilde _ hT_tilde _ hT_src).1]
      calc
        ι_left₁ ≫ e_L.hom.app Fℤ_tgt
          = (ι_left₁ ≫ e_L.hom.app Fℤ_tgt) ≫ (v₂ ≫ ι_left₂) := by
            rw [hv₂_inv, CategoryTheory.Category.comp_id]
        _ = (ι_left₁ ≫ (e_L.hom.app Fℤ_tgt ≫ v₂)) ≫ ι_left₂ := by
            simp only [CategoryTheory.Category.assoc]
        _ = (ι_left₁ ≫ v₁) ≫ ι_left₂ := by rw [← hv_rel]
        _ = ι_left₂ := by rw [hι₁_inv, CategoryTheory.Category.id_comp]

    
    rw [hp_D_eval π_tilde q p_πt hp_πt]
    have hLHS_simp :
        ((CategoryTheory.Abelian.Ext.mk₀ (adj_φt.counit.app FM_tilde)).postcomp
          Fℤ_tilde (Nat.add_zero q))
          ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all φ_tilde)).comp
            ((pb_φt.mapExtAddHom Fℤ_V (pf_φt.obj FM_tilde) q)
              (((CategoryTheory.Abelian.Ext.mk₀ Θ).postcomp Fℤ_V (Nat.add_zero q))
                ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all π)).comp
                  ((pb_π.mapExtAddHom Fℤ_tgt (pf_φ.obj FM_src) q) ξ)
                  (Nat.zero_add q))))
            (Nat.zero_add q)) =
        (CategoryTheory.Abelian.Ext.mk₀ ι_left₂).comp
          ((CategoryTheory.Abelian.Ext.mapExactFunctor
            (CategoryTheory.Functor.comp pb_π pb_φt) ξ).comp
            (CategoryTheory.Abelian.Ext.mk₀ u₂) (Nat.add_zero q))
          (Nat.zero_add q) := by
      rw [hPost_apply, hPost_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← hMapExact_comp pb_π pb_φt ξ,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          ((CategoryTheory.Abelian.Ext.mk₀ (pb_φt.map (D.ιℤ_all π))).comp _ (Nat.zero_add q))
          _ _ (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ (pb_φt.map (D.ιℤ_all π))) _ _ (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
    have hRHS_simp :
        ((CategoryTheory.Abelian.Ext.mk₀ π_M_πt).postcomp Fℤ_tilde (Nat.add_zero q))
          ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all π_tilde)).comp
            ((pb_πt.mapExtAddHom Fℤ_src FM_src q)
              (((CategoryTheory.Abelian.Ext.mk₀ (adj_φ.counit.app FM_src)).postcomp
                Fℤ_src (Nat.add_zero q))
                ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all φ)).comp
                  ((pb_φ.mapExtAddHom Fℤ_tgt (pf_φ.obj FM_src) q) ξ)
                  (Nat.zero_add q))))
            (Nat.zero_add q)) =
        (CategoryTheory.Abelian.Ext.mk₀ ι_left₁).comp
          ((CategoryTheory.Abelian.Ext.mapExactFunctor
            (CategoryTheory.Functor.comp pb_φ pb_πt) ξ).comp
            (CategoryTheory.Abelian.Ext.mk₀ u₁) (Nat.add_zero q))
          (Nat.zero_add q) := by
      rw [hPost_apply, hPost_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← hMapExact_comp pb_φ pb_πt ξ,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          ((CategoryTheory.Abelian.Ext.mk₀ (pb_πt.map (D.ιℤ_all φ))).comp _ (Nat.zero_add q))
          _ _ (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ (pb_πt.map (D.ιℤ_all φ))) _ _ (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
    change ((CategoryTheory.Abelian.Ext.mk₀ (adj_φt.counit.app FM_tilde)).postcomp
        Fℤ_tilde (Nat.add_zero q))
        ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all φ_tilde)).comp
          ((pb_φt.mapExtAddHom Fℤ_V (pf_φt.obj FM_tilde) q)
            (((CategoryTheory.Abelian.Ext.mk₀ Θ).postcomp Fℤ_V (Nat.add_zero q))
              ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all π)).comp
                ((pb_π.mapExtAddHom Fℤ_tgt (pf_φ.obj FM_src) q) ξ)
                (Nat.zero_add q))))
          (Nat.zero_add q)) =
      ((CategoryTheory.Abelian.Ext.mk₀ π_M_πt).postcomp Fℤ_tilde (Nat.add_zero q))
        ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all π_tilde)).comp
          ((pb_πt.mapExtAddHom Fℤ_src FM_src q)
            (((CategoryTheory.Abelian.Ext.mk₀ (adj_φ.counit.app FM_src)).postcomp
              Fℤ_src (Nat.add_zero q))
              ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all φ)).comp
                ((pb_φ.mapExtAddHom Fℤ_tgt (pf_φ.obj FM_src) q) ξ)
                (Nat.zero_add q))))
          (Nat.zero_add q))
    rw [hLHS_simp, hRHS_simp, hMapExact_iso e_L ξ,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      hι_left_rel,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hu_rel]

theorem weil_top_deg_proper_zero_bdry_leray_and_base_change (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (hd : 1 ≤ d)
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (hCD : ∀ (m q : ℕ)
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper Z.hom],
      topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
      2 * m < q →
      Subsingleton (weilEtaleTorsionH Z.left n q))
    (D : WeilTopDegKummerZeroBdrySiteData k n)
    (hNorm : WeilTopDegKummerZeroBdrySiteNorm k n ζ D) :
    (∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Z.hom]
        (O : Z.left.Opens),
      topologicalKrullDim (weilAltClosedComplIdeal Z.left O).subscheme ≤
        ((d - 1 : ℕ) : WithBot ℕ∞) →
      Function.Bijective (weilTopDegKummerZeroBdryExtToTors D Z.left O (2 * d))) ∧
    (∀ (Z₁ Z₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Z₁.hom] [AlgebraicGeometry.IsProper Z₂.hom]
        (f : Quiver.Hom Z₁.left Z₂.left),
      CategoryTheory.CategoryStruct.comp f Z₂.hom = Z₁.hom →
      ∀ (O₂ : Z₂.left.Opens) (O₁ : Z₁.left.Opens),
        O₁ = (TopologicalSpace.Opens.map f.base).obj O₂ →
        AlgebraicGeometry.IsFinite (f ∣_ O₂) →
        (∀ s : ℕ, 1 ≤ s →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage f s
              (weilTopDegKummerZeroBdryKSh D Z₁.left O₁))) ∧
        (∀ q : ℕ,
          Function.Bijective (weilTopDegKummerZeroBdryLerayMap D f O₁ q))) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
        (O'₁ O₁ : X₁.Opens)
        (inc₁ : Quiver.Hom
          (weilTopDegKummerZeroBdryKSh D X₁ O'₁)
          (weilTopDegKummerZeroBdryKSh D X₁ O₁))
        (q : ℕ)
        (β' : CategoryTheory.Abelian.Ext (weilTopDegKummerZeroBdryFℤ X₂)
          ((weilTopDegKummerZeroBdryPush D f).obj
            (weilTopDegKummerZeroBdryKSh D X₁ O'₁)) q),
      weilTopDegKummerZeroBdryLerayMap D f O₁ q
          (((CategoryTheory.Abelian.Ext.mk₀
              ((weilTopDegKummerZeroBdryPush D f).map inc₁)).postcomp
            (weilTopDegKummerZeroBdryFℤ X₂) (Nat.add_zero q)) β') =
        ((CategoryTheory.Abelian.Ext.mk₀ inc₁).postcomp
          (weilTopDegKummerZeroBdryFℤ X₁) (Nat.add_zero q))
          (weilTopDegKummerZeroBdryLerayMap D f O'₁ q β')) ∧
    (∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom X₁ X₂) (f : Quiver.Hom X₂ X₃)
        (O₁ : X₁.Opens) (O₂ : X₂.Opens)
        (τ_g : Quiver.Hom
          ((weilTopDegKummerZeroBdryPush D g).obj
            (weilTopDegKummerZeroBdryKSh D X₁ O₁))
          (weilTopDegKummerZeroBdryKSh D X₂ O₂))
        (q : ℕ)
        (β₃ : CategoryTheory.Abelian.Ext (weilTopDegKummerZeroBdryFℤ X₃)
          ((weilTopDegKummerZeroBdryPush D (CategoryTheory.CategoryStruct.comp g f)).obj
            (weilTopDegKummerZeroBdryKSh D X₁ O₁)) q),
      ∃ β₁ : CategoryTheory.Abelian.Ext (weilTopDegKummerZeroBdryFℤ X₂)
          ((weilTopDegKummerZeroBdryPush D g).obj
            (weilTopDegKummerZeroBdryKSh D X₁ O₁)) q,
        weilTopDegKummerZeroBdryLerayMap D g O₁ q β₁ =
          weilTopDegKummerZeroBdryLerayMap D
            (CategoryTheory.CategoryStruct.comp g f) O₁ q β₃ ∧
        weilTopDegKummerZeroBdryLerayMap D f O₂ q
            (((CategoryTheory.Abelian.Ext.mk₀
                (CategoryTheory.CategoryStruct.comp
                  (weilTopDegKummerZeroBdryPushCompHom D g f
                    (weilTopDegKummerZeroBdryKSh D X₁ O₁))
                  ((weilTopDegKummerZeroBdryPush D f).map τ_g))).postcomp
              (weilTopDegKummerZeroBdryFℤ X₃) (Nat.add_zero q)) β₃) =
          ((CategoryTheory.Abelian.Ext.mk₀ τ_g).postcomp
            (weilTopDegKummerZeroBdryFℤ X₂) (Nat.add_zero q)) β₁) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
        (O₂ : X₂.Opens) (O₁ : X₁.Opens)
        (η_zb : Quiver.Hom
          (weilTopDegKummerZeroBdryKSh D X₂ O₂)
          ((weilTopDegKummerZeroBdryPush D f).obj
            (weilTopDegKummerZeroBdryKSh D X₁ O₁))),
      (∀ (U : X₂.Etale)
          (g : ↥(weilAltZeroBdrySubgroup X₂ O₂ n U))
          (y : ↥((AlgebraicGeometry.Scheme.Etale.forget X₁).obj
            ((weilEtaleSitePullback f).obj U)).left),
        (((η_zb.hom.app (Opposite.op U)) g).1) y =
          g.1 ((CategoryTheory.Limits.pullback.fst
            (((AlgebraicGeometry.Scheme.Etale.forget X₂).obj U).hom) f).base y)) →
      ∀ (q : ℕ)
        (p_f : weilEtaleTorsionH X₂ n q →+ weilEtaleTorsionH X₁ n q),
        WeilIsTorsionEtalePullback f n q p_f →
        ∀ (γ₂ : CategoryTheory.Abelian.Ext (weilTopDegKummerZeroBdryFℤ X₂)
            (weilTopDegKummerZeroBdryKSh D X₂ O₂) q),
          weilTopDegKummerZeroBdryExtToTors D X₁ O₁ q
              (weilTopDegKummerZeroBdryLerayMap D f O₁ q
                (((CategoryTheory.Abelian.Ext.mk₀ η_zb).postcomp
                  (weilTopDegKummerZeroBdryFℤ X₂) (Nat.add_zero q)) γ₂)) =
            p_f (weilTopDegKummerZeroBdryExtToTors D X₂ O₂ q γ₂)) ∧
    (∀ (Y Γ_V Γ_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Y.hom]
        [AlgebraicGeometry.IsProper Γ_V.hom]
        [AlgebraicGeometry.IsProper Γ_tilde.hom]
        (δ : ℕ) (_ : 1 ≤ δ)
        (φ : Quiver.Hom Y.left Y.left),
      CategoryTheory.CategoryStruct.comp φ Y.hom = Y.hom →
      WeilTopDegFiniteLocallyFreeOfRank δ φ →
      ∀ (φ_shriek : weilEtaleTorsionH Y.left n (2 * d) →+ weilEtaleTorsionH Y.left n (2 * d)),
        WeilTopDegAffineFiniteFreePushforward k n δ (2 * d) ζ Y Y φ φ_shriek →
        ∀ (π : Quiver.Hom Γ_V.left Y.left)
          (π_tilde : Quiver.Hom Γ_tilde.left Y.left)
          (φ_tilde : Quiver.Hom Γ_tilde.left Γ_V.left),
          CategoryTheory.CategoryStruct.comp π Y.hom = Γ_V.hom →
          CategoryTheory.CategoryStruct.comp π_tilde Y.hom = Γ_tilde.hom →
          CategoryTheory.CategoryStruct.comp φ_tilde Γ_V.hom = Γ_tilde.hom →
          CategoryTheory.IsPullback π_tilde φ_tilde φ π →
          ∀ (O_V : Γ_V.left.Opens) (O_tilde : Γ_tilde.left.Opens),
            O_tilde = (TopologicalSpace.Opens.map φ_tilde.base).obj O_V →
            AlgebraicGeometry.IsOpenImmersion (CategoryTheory.CategoryStruct.comp O_V.ι π) →
            WeilTopDegFiniteLocallyFreeOfRank δ (φ_tilde ∣_ O_V) →
            ∀ (p_π : weilEtaleTorsionH Y.left n (2 * d) →+
                  weilEtaleTorsionH Γ_V.left n (2 * d))
              (p_πt : weilEtaleTorsionH Y.left n (2 * d) →+
                  weilEtaleTorsionH Γ_tilde.left n (2 * d))
              (τ_φt : Quiver.Hom
                ((weilTopDegKummerZeroBdryPush D φ_tilde).obj
                  (weilTopDegKummerZeroBdryKSh D Γ_tilde.left O_tilde))
                (weilTopDegKummerZeroBdryKSh D Γ_V.left O_V)),
              WeilIsTorsionEtalePullback π n (2 * d) p_π →
              WeilIsTorsionEtalePullback π_tilde n (2 * d) p_πt →
              WeilTopDegKummerZeroBdryDetSpec D Γ_tilde Γ_V φ_tilde δ O_V O_tilde τ_φt →
              ∀ (α : weilEtaleTorsionH Y.left n (2 * d))
                (β_t : CategoryTheory.Abelian.Ext (weilTopDegKummerZeroBdryFℤ Γ_V.left)
                  ((weilTopDegKummerZeroBdryPush D φ_tilde).obj
                    (weilTopDegKummerZeroBdryKSh D Γ_tilde.left O_tilde)) (2 * d)),
                weilTopDegKummerZeroBdryExtToTors D Γ_tilde.left O_tilde (2 * d)
                    (weilTopDegKummerZeroBdryLerayMap D φ_tilde O_tilde (2 * d) β_t) =
                  p_πt α →
                weilTopDegKummerZeroBdryPushExtToTorsR D O_V (2 * d) τ_φt β_t =
                  p_π (φ_shriek α)) :=
by
  classical
  have hPostId : ∀ {C : Type (u + 1)} [CategoryTheory.Category C]
      [CategoryTheory.Abelian C] [CategoryTheory.HasExt C]
      {W Y : C} {q : ℕ} (x : CategoryTheory.Abelian.Ext W Y q),
      ((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id Y)).postcomp W
        (Nat.add_zero q)) x = x := by
    intro C _ _ _ W Y q x
    simp
  have hPostComp : ∀ {C : Type (u + 1)} [CategoryTheory.Category C]
      [CategoryTheory.Abelian C] [CategoryTheory.HasExt C]
      {W X Y Z : C} {q : ℕ} (f : Quiver.Hom X Y) (g : Quiver.Hom Y Z)
      (x : CategoryTheory.Abelian.Ext W X q),
      ((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp f g)).postcomp W
        (Nat.add_zero q)) x =
        ((CategoryTheory.Abelian.Ext.mk₀ g).postcomp W (Nat.add_zero q))
          (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp W (Nat.add_zero q)) x) := by
    intro C _ _ _ W X Y Z q f g x
    simp [CategoryTheory.Abelian.Ext.postcomp]

  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hPullUniq : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂) (m i : ℕ)
      (p₁ p₂ : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i),
      WeilIsTorsionEtalePullback h m i p₁ →
      WeilIsTorsionEtalePullback h m i p₂ →
      p₁ = p₂ := by
    intro S₁ S₂ h m i p₁ p₂ hp₁ hp₂
    obtain ⟨p_id, hp_id⟩ := hPullEx (CategoryTheory.CategoryStruct.id S₁) m i
    have hid : p_id = AddMonoidHom.id _ := hPullId m i p_id hp_id
    have hcomp := hPullComp (CategoryTheory.CategoryStruct.id S₁) h m i p_id p₂ p₁ hp_id hp₂
      (by rwa [CategoryTheory.Category.id_comp])
    rw [hcomp, hid, AddMonoidHom.id_comp]

  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
