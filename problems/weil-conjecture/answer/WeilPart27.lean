    have hMono_push : CategoryTheory.Mono (P_push.map f) := by
      refine ⟨fun {W_sh} α β hαβ => ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      ext opU : 2
      induction opU with
      | op U =>
        apply AddCommGrpCat.ext
        intro w
        apply hInj₁ (B.obj U)
        exact congrArg (fun φ : W_sh ⟶ P_push.obj F₂ => (φ.hom.app (Opposite.op U)).hom w) hαβ
