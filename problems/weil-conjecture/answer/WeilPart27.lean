          have hψC_surj : Function.Surjective ψ_C := by
            intro z
            obtain ⟨⟨x, p⟩, hz⟩ := IsLocalization.surj (Submonoid.powers (φ₂₁ (r * s))) z
            obtain ⟨k, hp⟩ := p.2
            have hp' : (φ₂₁ (r * s)) ^ k = p.1 := hp
            let x_s : Localization.Away (φ₂₁ s) := algebraMap R₁ (Localization.Away (φ₂₁ s)) x
            let c_s : Fin δ → Localization.Away s := fun j => b_s.repr (e_s.symm x_s) j
            have hx_s : x_s = ∑ j : Fin δ, Localization.awayMap φ₂₁ s (c_s j) * e_s (b_s j) := by
              have h1 : e_s.symm x_s = ∑ j : Fin δ, c_s j • b_s j := (b_s.sum_repr _).symm
              have h2 := congrArg e_s h1
              rw [e_s.apply_symm_apply, map_sum] at h2
              simpa [he_s] using h2
            refine ⟨fun j => rs_inv ^ k * α_s (c_s j), ?_⟩
            change (∑ j : Fin δ, ψ_rs (rs_inv ^ k * α_s (c_s j)) * β_s (e_s (b_s j))) = z
            have hsum_x : (∑ j : Fin δ, ψ_rs (rs_inv ^ k * α_s (c_s j)) * β_s (e_s (b_s j))) =
                (ψ_rs rs_inv) ^ k * algebraMap R₁ C₁ x := by
              have hβx : β_s x_s = algebraMap R₁ C₁ x :=
                IsLocalization.Away.lift_eq (φ₂₁ s) hφs_unit_C₁ x
              rw [← hβx, hx_s, map_sum, Finset.mul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              have hcj := RingHom.congr_fun hcomm_s (c_s j)
              simp only [RingHom.comp_apply] at hcj
              rw [ψ_rs.map_mul, ψ_rs.map_pow, β_s.map_mul, hcj, mul_assoc]
            rw [hsum_x, ← hz, ← hp', (algebraMap R₁ C₁).map_pow]
            calc
              (ψ_rs rs_inv) ^ k * (z * (algebraMap R₁ C₁ (φ₂₁ (r * s))) ^ k) =
