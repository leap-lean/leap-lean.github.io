    let algBQ : Algebra B_g Q_q := θ_q.toAlgebra
    let algBA : Algebra B_g A_g := ψ_g.toAlgebra
    let _ : Algebra B_g Q_q := algBQ
    let _ : Algebra B_g A_g := algBA
    let B_s : Type u := TensorProduct B_g Q_q A_g
    let φ_s : Q_q →+* B_s := Algebra.TensorProduct.includeLeftRingHom
    let ρ_s : A_g →+* B_s := (Algebra.TensorProduct.includeRight : A_g →ₐ[B_g] B_s).toRingHom
    let e_spec := AlgebraicGeometry.pullbackSpecIso B_g Q_q A_g
    have hPb_Spec : CategoryTheory.IsPullback
