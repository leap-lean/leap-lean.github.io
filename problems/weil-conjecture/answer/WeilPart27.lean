        obtain ⟨w₁, hw₁⟩ := (h_into_Z₀ z₁).1
        have hw₁_F0 : w₁ ∈ F₀_Z₀ := by rw [heq]; exact ⟨z₁, hz₁, hw₁.symm⟩
        rcases hw₁_F0 with ⟨z₀, hz₀, hw₀⟩
