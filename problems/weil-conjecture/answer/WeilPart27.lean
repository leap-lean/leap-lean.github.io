                (h_away_eq φ₂₁ s ((r * s) ^ K)).trans
                  (congrArg (algebraMap R₁ (Localization.Away (φ₂₁ s))) (φ₂₁.map_pow (r * s) K))
              rw [haway_rs]
              have hmul_my :
                  algebraMap R₁ (Localization.Away (φ₂₁ s)) ((φ₂₁ (r * s)) ^ K) *
                    (y_s * (algebraMap R₁ (Localization.Away (φ₂₁ s)) (φ₂₁ s)) ^ m_y) = 0 := by
                rw [← (algebraMap R₁ (Localization.Away (φ₂₁ s))).map_pow, hm_y', hy_surj,
                  ← (algebraMap R₁ (Localization.Away (φ₂₁ s))).map_mul, hK_xy', map_zero]
              calc
                algebraMap R₁ (Localization.Away (φ₂₁ s)) ((φ₂₁ (r * s)) ^ K) * y_s =
                    algebraMap R₁ (Localization.Away (φ₂₁ s)) ((φ₂₁ (r * s)) ^ K) * y_s *
                      (algebraMap R₁ (Localization.Away (φ₂₁ s)) (φ₂₁ s) * φs_inv) ^ m_y := by
                  rw [hφs_inv, one_pow, mul_one]
                _ = (algebraMap R₁ (Localization.Away (φ₂₁ s)) ((φ₂₁ (r * s)) ^ K) *
                      (y_s * (algebraMap R₁ (Localization.Away (φ₂₁ s)) (φ₂₁ s)) ^ m_y)) *
                    φs_inv ^ m_y := by
                  rw [mul_pow]
                  ring
                _ = 0 := by rw [hmul_my, zero_mul]
            have he_s_zero : e_s (∑ j : Fin δ,
                (algebraMap R₂ (Localization.Away s) ((r * s) ^ K * a' j)) • b_s j) = 0 := by
              rw [map_sum]
              have hrew : (∑ j : Fin δ,
                  e_s ((algebraMap R₂ (Localization.Away s) ((r * s) ^ K * a' j)) • b_s j)) =
                  Localization.awayMap φ₂₁ s (algebraMap R₂ (Localization.Away s) ((r * s) ^ K)) *
                    y_s := by
                dsimp [y_s]
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [he_s, (algebraMap R₂ (Localization.Away s)).map_mul,
                  (Localization.awayMap φ₂₁ s).map_mul, mul_assoc]
              rw [hrew]
              exact hys_K
            have hsum_bs : (∑ j : Fin δ,
                (algebraMap R₂ (Localization.Away s) ((r * s) ^ K * a' j)) • b_s j) = 0 :=
              e_s.injective (he_s_zero.trans e_s.map_zero.symm)
            ext j
            have hcoeff_s : algebraMap R₂ (Localization.Away s) ((r * s) ^ K * a' j) = 0 := by
              have h := congrArg (fun x => b_s.repr x j) hsum_bs
              simpa [map_sum, b_s.repr_self, Finsupp.single_apply] using h
            obtain ⟨⟨p_L, ⟨L_j, hp_L⟩⟩, hLj_zero⟩ :=
              (IsLocalization.map_eq_zero_iff (Submonoid.powers s) (Localization.Away s) _).mp
                hcoeff_s
            have hLj_zero' : s ^ L_j * ((r * s) ^ K * a' j) = 0 := by
              have hp_L' : s ^ L_j = p_L := hp_L
              rw [hp_L']
              exact hLj_zero
            have hg_unit_prod :
                (algebraMap R₂ C₂ s) ^ L_j * (algebraMap R₂ C₂ (r * s)) ^ (K + N) * g j = 0 := by
              calc
                (algebraMap R₂ C₂ s) ^ L_j * (algebraMap R₂ C₂ (r * s)) ^ (K + N) * g j =
