theorem weil_top_deg_zero_bdry_det_norm_sheaf_and_tower (k : Type u) [Field k]
    (n : ℕ) (hn : 2 ≤ n)
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n) :
