        have hIf : ((CategoryTheory.Sieve.ofArrows (V_c U) (j_c U)).pullback w).arrows I.f := I.hf
        rcases hIf with ⟨Z₀, u₀, g₀, ⟨i⟩, hfac⟩
        refine G₂.cond.hom_ext_ofArrows (j_c I.Y) (hj_spec I.Y).1 fun m => ?_
        have h_lhs :
            ((Φ_app U ≫ G₂.obj.map w.op) ≫ G₂.obj.map I.f.op) ≫ G₂.obj.map (j_c I.Y m).op =
            G₁.obj.map (j_c I.Y m ≫ I.f ≫ w).op ≫ φ_good (V_c I.Y m) ((hj_spec I.Y).2 m) := by
          calc
            ((Φ_app U ≫ G₂.obj.map w.op) ≫ G₂.obj.map I.f.op) ≫ G₂.obj.map (j_c I.Y m).op
