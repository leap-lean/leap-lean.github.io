    let C_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (g₁_s ≫ P₁_ov.hom)
    let _ : AlgebraicGeometry.IsProper C_ov.hom := hProp_g₁s
    let algK_Vs : Algebra k B_Vs :=
