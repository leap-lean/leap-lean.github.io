      let U_s : P₁_ov.left.Opens := (TopologicalSpace.Opens.map ι_s.base).obj U_g
      ∃ (iso_U : U_s.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away q)))
