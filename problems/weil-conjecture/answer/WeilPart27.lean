      let α_g : ↑(U₂.toScheme.presheaf.obj (Opposite.op ⊤)) ≃+* Localization.Away (φ₃₂ t) :=
        U₂.topIso.commRingCatIsoToRingEquiv.trans e_O₂_g.symm
      let β_g : Localization.Away (φ₂₁ (φ₃₂ t)) ≃+* ↑(U₁.toScheme.presheaf.obj (Opposite.op ⊤)) :=
        e_O₁_g.trans U₁.topIso.symm.commRingCatIsoToRingEquiv
      have hcomm_g_top : ∀ r₁ : ↑(U₂.toScheme.presheaf.obj (Opposite.op ⊤)),
          β_g (Localization.awayMap φ₂₁ (φ₃₂ t) (α_g r₁)) = ((g₀ ∣_ U₂).appTop).hom r₁ := by
        intro r₁
        have hstep1 : β_g (Localization.awayMap φ₂₁ (φ₃₂ t) (α_g r₁)) =
            U₁.topIso.inv.hom ((g₀.app U₂).hom (U₂.topIso.hom.hom r₁)) := by
          dsimp [α_g, β_g]
          exact congrArg U₁.topIso.inv.hom
            ((hcomm_g (e_O₂_g.symm (U₂.topIso.hom.hom r₁))).trans
              (congrArg (g₀.app U₂).hom (e_O₂_g.apply_symm_apply _)))
        have hstep2 : U₂.topIso.hom ≫ (g₀.app U₂ ≫ U₁.topIso.inv) = (g₀ ∣_ U₂).appTop := by
          rw [hTopIsoComm g₀ U₂, CategoryTheory.Iso.hom_inv_id_assoc]
        exact hstep1.trans (congrArg (fun k => k.hom r₁) hstep2)
      obtain ⟨e_g0, he_g0⟩ := hTransportBasis (Localization.awayMap φ₂₁ (φ₃₂ t))
        ((g₀ ∣_ U₂).appTop).hom α_g β_g hcomm_g_top δ M₁_t b₁_t e₁_t he₁_t

      exact ⟨U₃, hz_U₃, hU₃, hU₂, hU₁, ⟨e₁₃, he₁₃⟩, ⟨e_f0, he_f0⟩, ⟨e_g0, he_g0⟩⟩

    refine ⟨?_, ?_⟩
    
    · rw [AlgebraicGeometry.morphismRestrict_comp g f O₃]
      refine ⟨hFin_gf₀, fun z => ?_⟩
      obtain ⟨U₃, hz_U₃, hU₃, _, hU₁, ⟨e₁₃, he₁₃⟩, _, _⟩ := hJointBasicOpen z
      exact ⟨U₃, hz_U₃, hU₃, hU₁, Fin (m * δ) → ↑(X₃.presheaf.obj (Opposite.op U₃)),
        inferInstance, inferInstance, e₁₃, he₁₃, ⟨Pi.basisFun _ (Fin (m * δ))⟩⟩

    
    · intro W h hrange x
      let z₃ : ↥X₃ := ⟨h.base x, hrange ⟨x, rfl⟩⟩
      obtain ⟨U₃, hz₃_U₃, hU₃, hU₂, hU₁, _, ⟨e_f0, he_f0⟩, ⟨e_g0, he_g0⟩⟩ := hJointBasicOpen z₃
      let U₂ : X₂.Opens := (TopologicalSpace.Opens.map f₀.base).obj U₃
      let U₁ : X₁.Opens := (TopologicalSpace.Opens.map g₀.base).obj U₂
      let j₃ : U₃.toScheme ⟶ Z₃ := U₃.ι ≫ O₃.ι
      let O_U₃ : Z₃.Opens := j₃.opensRange
      have hx_OU₃ : x ∈ (TopologicalSpace.Opens.map h.base).obj O_U₃ :=
        ⟨⟨z₃, hz₃_U₃⟩, rfl⟩
      obtain ⟨W_x, hW_x, hx_Wx, hWx_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x) (U := (TopologicalSpace.Opens.map h.base).obj O_U₃) hx_OU₃
      let h_x := W_x.ι ≫ h
      have hrange_u₃ : Set.range h_x.base ⊆ Set.range j₃.base := by
        rintro _ ⟨w, rfl⟩
        exact hWx_sub w.2
      have hrange_hx : Set.range h_x.base ⊆ (O₃ : Set ↥Z₃) := by
        intro z hz
        rcases hrange_u₃ hz with ⟨u, rfl⟩
        exact (U₃.ι.base u).2
      let u₃ : W_x.toScheme ⟶ U₃.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift j₃ h_x hrange_u₃
      have hu₃ : u₃ ≫ j₃ = h_x :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j₃ h_x hrange_u₃

      
      have hPB_fU₃ : CategoryTheory.IsPullback (f₀ ∣_ U₃)
          (U₂.ι ≫ O₂'.ι) j₃ f :=
        (AlgebraicGeometry.isPullback_morphismRestrict f₀ U₃).paste_vert
          (AlgebraicGeometry.isPullback_morphismRestrict f O₃)
      obtain ⟨u₂, _, hu₂_snd, hPB_Pf⟩ := hPullbackFactor hPB_fU₃ h_x u₃ hu₃
      have hrange_sndf :
          Set.range (CategoryTheory.Limits.pullback.snd h_x f).base ⊆ (O₂' : Set ↥Z₂) := by
        rw [← hu₂_snd]
        rintro _ ⟨p, rfl⟩
        exact (U₂.ι.base (u₂.base p)).2
      haveI : AlgebraicGeometry.IsAffineHom (f₀ ∣_ U₃) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict f₀ U₃).flip
          (inferInstance : AlgebraicGeometry.IsAffineHom f₀)
      haveI : AlgebraicGeometry.IsAffineHom (CategoryTheory.Limits.pullback.fst h_x f) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPB_Pf.flip
          (inferInstance : AlgebraicGeometry.IsAffineHom (f₀ ∣_ U₃))
      haveI : AlgebraicGeometry.IsAffine W_x.toScheme := hW_x
      haveI : AlgebraicGeometry.IsAffine U₃.toScheme := hU₃
      haveI : AlgebraicGeometry.IsAffine U₂.toScheme := hU₂
      haveI : AlgebraicGeometry.IsAffine U₁.toScheme := hU₁
      let P_f := CategoryTheory.Limits.pullback h_x f
      have hAff_Pf : AlgebraicGeometry.IsAffine P_f :=
        AlgebraicGeometry.isAffine_of_isAffineHom (CategoryTheory.Limits.pullback.fst h_x f)
      haveI : AlgebraicGeometry.IsAffine P_f := hAff_Pf
      obtain ⟨_, _, hBC_Pf⟩ := hAffPullback hPB_Pf
      obtain ⟨M_f, hAdd_Mf, hMod_Mf, b_f, e_f, he_f⟩ :=
        hBC_Pf m (Fin m → ↑(U₃.toScheme.presheaf.obj (Opposite.op ⊤)))
          (Pi.basisFun _ (Fin m)) e_f0 he_f0

      
      have hPB_gU₂ : CategoryTheory.IsPullback (g₀ ∣_ U₂)
          (U₁.ι ≫ O₁'.ι) (U₂.ι ≫ O₂'.ι) g :=
        (AlgebraicGeometry.isPullback_morphismRestrict g₀ U₂).paste_vert
          (AlgebraicGeometry.isPullback_morphismRestrict g O₂')
      obtain ⟨u₁, _, _, hPB_Pg⟩ :=
        hPullbackFactor hPB_gU₂ (CategoryTheory.Limits.pullback.snd h_x f) u₂ hu₂_snd
      haveI : AlgebraicGeometry.IsAffineHom (g₀ ∣_ U₂) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict g₀ U₂).flip
          (inferInstance : AlgebraicGeometry.IsAffineHom g₀)
      haveI : AlgebraicGeometry.IsAffineHom
          (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd h_x f) g) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPB_Pg.flip
          (inferInstance : AlgebraicGeometry.IsAffineHom (g₀ ∣_ U₂))
      let P_g := CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd h_x f) g
      have hAff_Pg : AlgebraicGeometry.IsAffine P_g :=
        AlgebraicGeometry.isAffine_of_isAffineHom
          (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd h_x f) g)
      haveI : AlgebraicGeometry.IsAffine P_g := hAff_Pg
      obtain ⟨_, _, hBC_Pg⟩ := hAffPullback hPB_Pg
      obtain ⟨M_g, hAdd_Mg, hMod_Mg, b_g, e_g, he_g⟩ :=
        hBC_Pg δ (Fin δ → ↑(U₂.toScheme.presheaf.obj (Opposite.op ⊤)))
          (Pi.basisFun _ (Fin δ)) e_g0 he_g0

      
      let e_ass := CategoryTheory.Limits.pullbackLeftPullbackSndIso h_x f g
      let P_gf := CategoryTheory.Limits.pullback h_x (g ≫ f)
      have hAff_Pgf : AlgebraicGeometry.IsAffine P_gf :=
        AlgebraicGeometry.IsAffine.of_isIso e_ass.inv

      exact ⟨W_x, hW_x, hx_Wx, hrange_hx, hrange_sndf, hAff_Pf, hAff_Pg, hAff_Pgf,
        ⟨e_ass.hom,
          CategoryTheory.Limits.pullbackLeftPullbackSndIso_hom_fst h_x f g,
          CategoryTheory.Limits.pullbackLeftPullbackSndIso_hom_snd h_x f g,
          inferInstance⟩,
        ⟨M_f, hAdd_Mf, hMod_Mf, b_f, e_f, he_f⟩,
        ⟨M_g, hAdd_Mg, hMod_Mg, b_g, e_g, he_g⟩⟩

theorem weil_zero_bdry_site_norm_from_id_terminal (k : Type u) [Field k]
    (n : ℕ) (ζ : kˣ)
    (D : WeilTopDegKummerZeroBdrySiteData k n)
    (hUnit_id : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u}
          (weilEtaleIdTerminalIsTerminal.{u} Z)).unit.app
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))))
        ((D.Φ_loc Z).hom.hom.app (Opposite.op (weilEtaleIdTerminal.{u} Z))) =
        weilAltLocConstConstHom Z (weilEtaleIdTerminal.{u} Z) n)
    (hConst_ex : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      ∃ (T₁_0 : X₁.Etale) (hT₁_0 : CategoryTheory.Limits.IsTerminal T₁_0)
        (T₂_0 : X₂.Etale) (hT₂_0 : CategoryTheory.Limits.IsTerminal T₂_0),
        let πℤ₀ := @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) _
          hT₁_0 _ hT₂_0 (AddCommGrpCat.of (ULift.{u} ℤ))
        CategoryTheory.CategoryStruct.comp (D.ιℤ_all f) πℤ₀ =
          CategoryTheory.CategoryStruct.id (weilTopDegKummerZeroBdryFℤ X₁) ∧
        CategoryTheory.CategoryStruct.comp πℤ₀ (D.ιℤ_all f) =
          CategoryTheory.CategoryStruct.id
            ((weilTopDegKummerZeroBdryPull D f).obj (weilTopDegKummerZeroBdryFℤ X₂)))
    (hZB_ex_raw : ∀ (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens),
      ∃ (K₀ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (ι₀ : Quiver.Hom K₀ (weilEtaleTorsionSheaf S n)),
        WeilAltIsZeroBdryExact S V n K₀ ι₀)
    (hζ_inj : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (U : Z.left.Etale),
      Function.Injective (D.ι_ζ Z U))
    (hζ_surj : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (U : Z.left.Etale)
        (v : ↑(((AlgebraicGeometry.Scheme.Etale.forget Z.left).obj U).left.presheaf.obj
          (Opposite.op ⊤))),
      v ^ n = 1 →
      ∃ s, D.ι_ζ Z U s = v)
    (hζ_mul : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (U : Z.left.Etale),
      D.ι_ζ Z U 0 = 1 ∧
      ∀ s₁ s₂,
        D.ι_ζ Z U (s₁ + s₂) = D.ι_ζ Z U s₁ * D.ι_ζ Z U s₂ ∧
        (D.ι_ζ Z U s₁) ^ n = 1)
    (hζ_nat : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        {U' U : Z.left.Etale} (u : Quiver.Hom U' U) (s),
      D.ι_ζ Z U' (((weilAltLocConstPresheaf Z.left n).map (Opposite.op u)) s) =
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop
          ((AlgebraicGeometry.Scheme.Etale.forget Z.left).map u).left)) (D.ι_ζ Z U s))
    (hζ_const_id : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (a : ZMod n),
      let T_id := weilEtaleIdTerminal.{u} Z.left
      D.ι_ζ Z T_id (LocallyConstant.const _ (ULift.up a)) =
        (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget Z.left).obj T_id).hom Z.hom)))
          ((ζ : kˣ) : k)) ^ a.val) :
    WeilTopDegKummerZeroBdrySiteNorm k n ζ D :=
by
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  have hUnitMap : ∀ {W : AlgebraicGeometry.Scheme.{u}} {T₁ T₂ : W.Etale}
      (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (α : Quiver.Hom T₂ T₁) (A : AddCommGrpCat.{u}),
      (CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT₂).unit.app A =
        CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app A)
          (((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
            (Opposite.op α)) := by
    intro W T₁ T₂ hT₁ hT₂ α A
    let J := W.smallEtaleTopology
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let P_A := (CategoryTheory.Functor.const (Opposite W.Etale)).obj A
    let F_A := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A
    let u : Quiver.Hom P_A F_A.obj := shAdj.unit.app P_A
    have hu : ∀ {T : W.Etale} (hT : CategoryTheory.Limits.IsTerminal T),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A =
          u.app (Opposite.op T) := by
      intro T hT
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT).comp shAdj).unit.app A = _
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [hu hT₂, hu hT₁]
    have hnat := u.naturality (Opposite.op α)
    change CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id A)
        (u.app (Opposite.op T₂)) = _ at hnat
    rwa [CategoryTheory.Category.id_comp] at hnat
  have hΦ_norm_uniq : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z),
      CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z).unit.app AM)
          ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z)) =
        weilAltLocConstConstHom Z T_Z n ∧
      ∀ (Φ' : CategoryTheory.Iso (weilEtaleTorsionSheaf Z n) (weilTopDegKummerZeroBdryLSh D Z)),
        CategoryTheory.CategoryStruct.comp
            ((CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z).unit.app AM)
            (Φ'.hom.hom.app (Opposite.op T_Z)) =
          weilAltLocConstConstHom Z T_Z n →
        Φ' = D.Φ_loc Z := by
    intro Z T_Z hT_Z
    let T₀ := weilEtaleIdTerminal.{u} Z
    let hT₀ := weilEtaleIdTerminalIsTerminal.{u} Z
    let α : Quiver.Hom T_Z T₀ := hT₀.from T_Z
    let adj₀ := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT₀
    let adj_T := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
    have hNorm_TZ : CategoryTheory.CategoryStruct.comp
        (adj_T.unit.app AM) ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z)) =
        weilAltLocConstConstHom Z T_Z n := by
      have hnat := (D.Φ_loc Z).hom.hom.naturality (Opposite.op α)
      change CategoryTheory.CategoryStruct.comp
          ((weilEtaleTorsionSheaf Z n).obj.map (Opposite.op α))
          ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z)) =
        CategoryTheory.CategoryStruct.comp
          ((D.Φ_loc Z).hom.hom.app (Opposite.op T₀))
          ((weilAltLocConstPresheaf Z n).map (Opposite.op α)) at hnat
      calc
        CategoryTheory.CategoryStruct.comp
            (adj_T.unit.app AM) ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z))
          = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (adj₀.unit.app AM)
                ((weilEtaleTorsionSheaf Z n).obj.map (Opposite.op α)))
              ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z)) :=
            congrArg
              (fun f => CategoryTheory.CategoryStruct.comp f
                ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z)))
              (hUnitMap hT₀ hT_Z α AM)
        _ = CategoryTheory.CategoryStruct.comp (adj₀.unit.app AM)
              (CategoryTheory.CategoryStruct.comp
                ((weilEtaleTorsionSheaf Z n).obj.map (Opposite.op α))
                ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z))) :=
            CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.CategoryStruct.comp (adj₀.unit.app AM)
              (CategoryTheory.CategoryStruct.comp
                ((D.Φ_loc Z).hom.hom.app (Opposite.op T₀))
                ((weilAltLocConstPresheaf Z n).map (Opposite.op α))) :=
            congrArg (CategoryTheory.CategoryStruct.comp (adj₀.unit.app AM)) hnat
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (adj₀.unit.app AM)
                ((D.Φ_loc Z).hom.hom.app (Opposite.op T₀)))
              ((weilAltLocConstPresheaf Z n).map (Opposite.op α)) :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = CategoryTheory.CategoryStruct.comp
              (weilAltLocConstConstHom Z T₀ n)
              ((weilAltLocConstPresheaf Z n).map (Opposite.op α)) :=
            congrArg
              (fun f => CategoryTheory.CategoryStruct.comp f
                ((weilAltLocConstPresheaf Z n).map (Opposite.op α)))
              (hUnit_id Z)
        _ = weilAltLocConstConstHom Z T_Z n := by
            apply AddCommGrpCat.ext
            intro a
            apply LocallyConstant.ext
            intro x
            rfl
    refine ⟨hNorm_TZ, ?_⟩
    intro Φ' hΦ'
    apply CategoryTheory.Iso.ext
    apply (adj_T.homEquiv AM (weilTopDegKummerZeroBdryLSh D Z)).injective
    have heq1 : (adj_T.homEquiv AM (weilTopDegKummerZeroBdryLSh D Z)) Φ'.hom =
        CategoryTheory.CategoryStruct.comp (adj_T.unit.app AM)
          (Φ'.hom.hom.app (Opposite.op T_Z)) :=
      CategoryTheory.Adjunction.homEquiv_unit adj_T AM _ Φ'.hom
    have heq2 : (adj_T.homEquiv AM (weilTopDegKummerZeroBdryLSh D Z)) (D.Φ_loc Z).hom =
        CategoryTheory.CategoryStruct.comp (adj_T.unit.app AM)
          ((D.Φ_loc Z).hom.hom.app (Opposite.op T_Z)) :=
      CategoryTheory.Adjunction.homEquiv_unit adj_T AM _ (D.Φ_loc Z).hom
    rw [heq1, heq2, hΦ', hNorm_TZ]
  have hConst_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
      (T₁ : X₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : X₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
      let πℤ := @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) _ hT₁ _ hT₂ Aℤ
      CategoryTheory.CategoryStruct.comp (D.ιℤ_all f) πℤ =
        CategoryTheory.CategoryStruct.id (weilTopDegKummerZeroBdryFℤ X₁) ∧
      CategoryTheory.CategoryStruct.comp πℤ (D.ιℤ_all f) =
        CategoryTheory.CategoryStruct.id
          ((weilTopDegKummerZeroBdryPull D f).obj (weilTopDegKummerZeroBdryFℤ X₂)) := by
    intro X₁ X₂ f T₁ hT₁ T₂ hT₂
    obtain ⟨T₁_0, hT₁_0, T₂_0, hT₂_0, h_ιπ₀, h_πι₀⟩ := hConst_ex f
    let πℤ := @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) _ hT₁ _ hT₂ Aℤ
    let πℤ₀ := @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) _ hT₁_0 _ hT₂_0 Aℤ
    suffices hπ_eq : πℤ = πℤ₀ by
      change CategoryTheory.CategoryStruct.comp (D.ιℤ_all f) πℤ = _ ∧
        CategoryTheory.CategoryStruct.comp πℤ (D.ιℤ_all f) = _
      rw [hπ_eq]
      exact ⟨h_ιπ₀, h_πι₀⟩
    let B := weilEtaleSitePullback f
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let Fℤ₁ := weilTopDegKummerZeroBdryFℤ X₁
    let Fℤ₂ := weilTopDegKummerZeroBdryFℤ X₂
    let P_push := weilTopDegKummerZeroBdryPush D f
    let adj_pull := weilTopDegKummerZeroBdryAdj D f
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let adj₁_0 := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁_0
    let adj₂_0 := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂_0
    let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
    let τ₀ : Quiver.Hom (B.obj T₂_0) T₁_0 := hT₁_0.from (B.obj T₂_0)
    let v₁ : Quiver.Hom T₁ T₁_0 := hT₁_0.from T₁
    let u₂ : Quiver.Hom T₂ T₂_0 := hT₂_0.from T₂
