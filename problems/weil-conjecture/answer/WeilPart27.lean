        (h_emb_comp.isClosedMap _ (p idx0.castSucc).isClosed).preimage I_Z₀.subschemeι.continuous
      have hF₁_cl : IsClosed F₁_Z₀ :=
        (h_emb_comp.isClosedMap _ (p idx0.succ).isClosed).preimage I_Z₀.subschemeι.continuous
      have hF₀_irr : IsIrreducible F₀_Z₀ := by
        obtain ⟨z₀, hz₀⟩ := (p idx0.castSucc).isIrreducible.nonempty
        obtain ⟨w₀, hw₀⟩ := (h_into_Z₀ z₀).1
        refine ⟨⟨w₀, ⟨z₀, hz₀, hw₀.symm⟩⟩, ?_⟩
        rw [isPreirreducible_iff_isClosed_union_isClosed]
        intro A₁ A₂ hA₁ hA₂ hcov
        have hcov' : (p idx0.castSucc : Set _) ⊆
            (ι_Cs.base ∘ I_Zs.subschemeι.base) ⁻¹' (I_Z₀.subschemeι.base '' A₁) ∪
            (ι_Cs.base ∘ I_Zs.subschemeι.base) ⁻¹' (I_Z₀.subschemeι.base '' A₂) := by
          intro z hz
          obtain ⟨w, hw⟩ := (h_into_Z₀ z).1
          have hw_F : w ∈ F₀_Z₀ := ⟨z, hz, hw.symm⟩
