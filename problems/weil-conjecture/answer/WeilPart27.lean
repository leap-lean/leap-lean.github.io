    have hy₀_V : y₀ ∈ V := hx₀_U
    obtain ⟨hφ_fin, hφ_charts⟩ := hφ_free
    have : AlgebraicGeometry.IsFinite φ := hφ_fin
    have : AlgebraicGeometry.IsAffineHom φ := hφ_fin.toIsAffineHom
    obtain ⟨V_free, hy₀_Vf, hVf, _, M_free, hAddM, hModM, e_free, he_free, ⟨bM_free⟩⟩ :=
      hφ_charts y₀
    let U_free : X.Opens := (TopologicalSpace.Opens.map φ.base).obj V_free
    have hUf : AlgebraicGeometry.IsAffineOpen U_free := hVf.preimage φ
    let φ_Vf := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app φ V_free)
    have hInj_Vf : Function.Injective φ_Vf := by
      let : AddCommGroup M_free := hAddM
      let : Module ↑(X.presheaf.obj (Opposite.op V_free)) M_free := hModM
      exact hBasisInj φ_Vf hδ bM_free e_free he_free
    obtain ⟨h₁, hW₀_le_V, hy₀_W₀⟩ := hVf.exists_basicOpen_le (V := V) ⟨y₀, hy₀_V⟩ hy₀_Vf
    let W₀ : X.Opens := X.basicOpen h₁
    let U₀ : X.Opens := (TopologicalSpace.Opens.map φ.base).obj W₀
    have hW₀_le_Vf : W₀ ≤ V_free := X.basicOpen_le h₁
    have hW₀ : AlgebraicGeometry.IsAffineOpen W₀ := hVf.basicOpen h₁
    have hU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hW₀.preimage φ
    have hx₀_U₀ : x₀ ∈ U₀ := hy₀_W₀
    have hU₀_le_Uf : U₀ ≤ U_free := (TopologicalSpace.Opens.map φ.base).monotone hW₀_le_Vf
    have hU₀_le_U : U₀ ≤ U := (TopologicalSpace.Opens.map φ.base).monotone hW₀_le_V
    obtain ⟨f₀, hf₀_le_W₀, hy₀_bf₀⟩ := hV.exists_basicOpen_le (V := W₀) ⟨y₀, hy₀_W₀⟩ hy₀_V
    have hf₀_ne : f₀ ≠ 0 := by
      intro hf0
      rw [hf0, X.basicOpen_zero] at hy₀_bf₀
      exact False.elim hy₀_bf₀
    let res_Vf_W₀ := (X.presheaf.map (CategoryTheory.homOfLE hW₀_le_Vf).op).hom
    have h_surj_W₀ : ∀ z : ↑(X.presheaf.obj (Opposite.op W₀)),
        IsUnit (res_Vf_W₀ h₁) ∧
        ∃ (n : ℕ) (v : ↑(X.presheaf.obj (Opposite.op V_free))),
          z * (res_Vf_W₀ h₁) ^ n = res_Vf_W₀ v := by
      intro z
      let : Algebra ↑(X.presheaf.obj (Opposite.op V_free))
          ↑(X.presheaf.obj (Opposite.op W₀)) := res_Vf_W₀.toAlgebra
      have : IsLocalization.Away h₁ ↑(X.presheaf.obj (Opposite.op W₀)) :=
        hVf.isLocalization_basicOpen h₁
      exact ⟨IsLocalization.Away.algebraMap_isUnit h₁, IsLocalization.Away.surj h₁ z⟩
    have hInj_φW₀ : Function.Injective (AlgebraicGeometry.Scheme.Hom.app φ W₀).hom := by
      intro z₁ z₂ hz_eq
      suffices h0 : z₁ - z₂ = 0 from sub_eq_zero.mp h0
      set z := z₁ - z₂
      have hz0 : (AlgebraicGeometry.Scheme.Hom.app φ W₀).hom z = 0 := by
        dsimp [z]
        rw [map_sub, hz_eq, sub_self]
      obtain ⟨hUnit_h₁, n, v, hzv⟩ := h_surj_W₀ z
      have hnat := AlgebraicGeometry.Scheme.Hom.naturality φ (CategoryTheory.homOfLE hW₀_le_Vf).op
      have hres_v0 : (X.presheaf.map (CategoryTheory.homOfLE hU₀_le_Uf).op).hom (φ_Vf v) = 0 := by
        have hcomm : (X.presheaf.map (CategoryTheory.homOfLE hU₀_le_Uf).op).hom (φ_Vf v) =
            (AlgebraicGeometry.Scheme.Hom.app φ W₀).hom (res_Vf_W₀ v) :=
          (congrArg (fun ψ => ψ.hom v) hnat).symm
        rw [hcomm, ← hzv, map_mul, hz0, zero_mul]
      have hφv0 : φ_Vf v = 0 :=
        hRes_inj U₀ U_free hU₀ ⟨⟨x₀, hx₀_U₀⟩⟩ hUf hU₀_le_Uf
          (hres_v0.trans (map_zero _).symm)
      have hv0 : v = 0 := hInj_Vf (hφv0.trans (map_zero _).symm)
      rw [hv0, map_zero] at hzv
      exact (hUnit_h₁.pow n).mul_left_eq_zero.mp hzv
    have hInj_φV : Function.Injective φ_V := by
      intro a₁ a₂ ha_eq
      suffices h0 : a₁ - a₂ = 0 from sub_eq_zero.mp h0
      set a := a₁ - a₂
      have ha0 : φ_V a = 0 := by
        dsimp [a]
        rw [map_sub, ha_eq, sub_self]
      have hnat := AlgebraicGeometry.Scheme.Hom.naturality φ (CategoryTheory.homOfLE hW₀_le_V).op
      have hφW0_a : (AlgebraicGeometry.Scheme.Hom.app φ W₀).hom
          ((X.presheaf.map (CategoryTheory.homOfLE hW₀_le_V).op).hom a) = 0 := by
        have hcomm : (AlgebraicGeometry.Scheme.Hom.app φ W₀).hom
            ((X.presheaf.map (CategoryTheory.homOfLE hW₀_le_V).op).hom a) =
            (X.presheaf.map (CategoryTheory.homOfLE hU₀_le_U).op).hom (φ_V a) :=
          congrArg (fun ψ => ψ.hom a) hnat
        rw [hcomm, ha0, map_zero]
      have hres_a0 : (X.presheaf.map (CategoryTheory.homOfLE hW₀_le_V).op).hom a = 0 :=
        hInj_φW₀ (hφW0_a.trans (map_zero _).symm)
      exact hRes_inj W₀ V hW₀ ⟨⟨y₀, hy₀_W₀⟩⟩ hV hW₀_le_V
        (hres_a0.trans (map_zero _).symm)
    have hFin_φV : RingHom.Finite φ_V := hφ_fin.finite_app V hV
    have hφ_k_comm : ∀ c : k,
        φ_V (@algebraMap k _ _ _ kAlgV c) = @algebraMap k _ _ _ kAlgU c := by
      intro c
      let i_V : Opposite.op ((TopologicalSpace.Opens.map Y.hom.base).obj ⊤) ⟶ Opposite.op V :=
        Opposite.op (CategoryTheory.homOfLE (fun _ _ => trivial))
      have h_phi_app : AlgebraicGeometry.Scheme.Hom.app φ V = φ.appLE V U (le_refl U) := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      have hstep1 : Y.hom.appLE ⊤ V le_top ≫ AlgebraicGeometry.Scheme.Hom.app φ V =
          Y.hom.app ⊤ ≫ (X.presheaf.map i_V ≫ φ.appLE V U (le_refl U)) :=
        (congrArg ((Y.hom.app ⊤ ≫ X.presheaf.map i_V) ≫ ·) h_phi_app).trans
          (CategoryTheory.Category.assoc (Y.hom.app ⊤) (X.presheaf.map i_V)
            (φ.appLE V U (le_refl U)))
      have hstep2 : X.presheaf.map i_V ≫ φ.appLE V U (le_refl U) =
          φ.appLE ((TopologicalSpace.Opens.map Y.hom.base).obj ⊤) U (fun _ _ => trivial) :=
        AlgebraicGeometry.Scheme.Hom.map_appLE φ (le_refl U) i_V
      have hstep3 : Y.hom.app ⊤ ≫
          φ.appLE ((TopologicalSpace.Opens.map Y.hom.base).obj ⊤) U (fun _ _ => trivial) =
          (CategoryTheory.CategoryStruct.comp φ Y.hom).appLE ⊤ U (fun _ _ => trivial) :=
        (AlgebraicGeometry.Scheme.Hom.comp_appLE φ Y.hom ⊤ U (fun _ _ => trivial)).symm
      have happ_comp : (Y.hom.appLE ⊤ V le_top ≫ AlgebraicGeometry.Scheme.Hom.app φ V) =
          Y.hom.appLE ⊤ U le_top :=
        ((hstep1.trans (congrArg (Y.hom.app ⊤ ≫ ·) hstep2)).trans hstep3).trans
          (congrArg (fun g => g.appLE ⊤ U (fun _ _ => trivial)) hφ_over)
      exact congrArg (fun ψ =>
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ψ).hom c) happ_comp
    refine ⟨⟨hInj_φV, hFin_φV, hφ_k_comm⟩, ⟨f₀, hf₀_ne, ?_⟩⟩
    rintro s _ _ ⟨q, hsq⟩ rfl
    intro A_Vs A_Us j_YV j_YU
    let φ_loc : A_Vs →+* A_Us := Localization.awayMap φ_V s
    have hφ_loc_alg : ∀ x : ↑(X.presheaf.obj (Opposite.op V)),
        φ_loc (algebraMap _ A_Vs x) = algebraMap _ A_Us (φ_V x) :=
      fun x => IsLocalization.Away.lift_eq s
        (IsLocalization.Away.algebraMap_isUnit (S := A_Us) (φ_V s)) x
    let O_s : X.Opens := X.basicOpen s
    have hOs_le_W₀ : O_s ≤ W₀ := by
      dsimp [O_s]
      rw [hsq, X.basicOpen_mul]
      exact le_trans inf_le_left hf₀_le_W₀
    have hOs_le_Vf : O_s ≤ V_free := le_trans hOs_le_W₀ hW₀_le_Vf
    let s_W₀ : ↑(X.presheaf.obj (Opposite.op W₀)) :=
      (X.presheaf.map (CategoryTheory.homOfLE hW₀_le_V).op).hom s
    have hs_W₀_bo : X.basicOpen s_W₀ = O_s :=
      (X.basicOpen_res s (CategoryTheory.homOfLE hW₀_le_V).op).trans
        (inf_of_le_right hOs_le_W₀)
    obtain ⟨hUnit_h₁, k_exp, h₂, hs_clear⟩ := h_surj_W₀ s_W₀
    let t : ↑(X.presheaf.obj (Opposite.op V_free)) := h₁ * h₂
    let O_t : X.Opens := X.basicOpen t
    have hOt_eq : O_t = O_s := by
      calc
        O_t = W₀ ⊓ X.basicOpen h₂ := X.basicOpen_mul h₁ h₂
        _ = X.basicOpen (res_Vf_W₀ h₂) :=
            (X.basicOpen_res h₂ (CategoryTheory.homOfLE hW₀_le_Vf).op).symm
        _ = X.basicOpen (s_W₀ * (res_Vf_W₀ h₁) ^ k_exp) := by rw [← hs_clear]
        _ = X.basicOpen s_W₀ ⊓ X.basicOpen ((res_Vf_W₀ h₁) ^ k_exp) :=
            X.basicOpen_mul s_W₀ ((res_Vf_W₀ h₁) ^ k_exp)
        _ = O_s ⊓ W₀ := by
            rw [hs_W₀_bo, X.basicOpen_of_isUnit (hUnit_h₁.pow k_exp)]
        _ = O_s := inf_of_le_left hOs_le_W₀
    let O'_s : X.Opens := X.basicOpen (φ_V s)
    let O'_t : X.Opens := X.basicOpen (φ_Vf t)
    have h_pre_s : (TopologicalSpace.Opens.map φ.base).obj O_s = O'_s :=
      X.preimage_basicOpen φ s
    have h_pre_t : (TopologicalSpace.Opens.map φ.base).obj O_t = O'_t :=
      X.preimage_basicOpen φ t
    have hO't_eq : O'_t = O'_s := by
      rw [← h_pre_t, hOt_eq, h_pre_s]
    have hO's_le_U : O'_s ≤ U := X.basicOpen_le (φ_V s)
    have hO's_le_Uf : O'_s ≤ U_free := hO't_eq ▸ X.basicOpen_le (φ_Vf t)
    have he_Vs_ex : ∃ e_Vs : A_Vs ≃+* ↑(X.presheaf.obj (Opposite.op O_s)),
        ∀ x : ↑(X.presheaf.obj (Opposite.op V)),
          e_Vs (algebraMap _ A_Vs x) =
            (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le s)).op).hom x := by
      let : Algebra ↑(X.presheaf.obj (Opposite.op V)) ↑(X.presheaf.obj (Opposite.op O_s)) :=
        (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le s)).op).hom.toAlgebra
      have : IsLocalization.Away s ↑(X.presheaf.obj (Opposite.op O_s)) :=
        hV.isLocalization_basicOpen s
      let e := IsLocalization.algEquiv (Submonoid.powers s) A_Vs ↑(X.presheaf.obj (Opposite.op O_s))
      exact ⟨e.toRingEquiv, fun x => e.commutes x⟩
    obtain ⟨e_Vs, he_Vs⟩ := he_Vs_ex
    have he_Vft_ex : ∃ e_Vft : Localization.Away t ≃+* ↑(X.presheaf.obj (Opposite.op O_s)),
        ∀ y : ↑(X.presheaf.obj (Opposite.op V_free)),
          e_Vft (algebraMap _ (Localization.Away t) y) =
            (X.presheaf.map (CategoryTheory.homOfLE hOs_le_Vf).op).hom y := by
      let : Algebra ↑(X.presheaf.obj (Opposite.op V_free)) ↑(X.presheaf.obj (Opposite.op O_t)) :=
        (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le t)).op).hom.toAlgebra
      have : IsLocalization.Away t ↑(X.presheaf.obj (Opposite.op O_t)) :=
        hVf.isLocalization_basicOpen t
      let e₀ := IsLocalization.algEquiv (Submonoid.powers t)
        (Localization.Away t) ↑(X.presheaf.obj (Opposite.op O_t))
      let e_eq := (X.presheaf.mapIso (CategoryTheory.eqToIso hOt_eq.symm).op).commRingCatIsoToRingEquiv
      refine ⟨e₀.toRingEquiv.trans e_eq, fun y => ?_⟩
      change e_eq (e₀ (algebraMap _ (Localization.Away t) y)) = _
      rw [e₀.commutes y]
      have hmor : (CategoryTheory.homOfLE (X.basicOpen_le t)).op ≫
          (CategoryTheory.eqToHom hOt_eq.symm).op =
          (CategoryTheory.homOfLE hOs_le_Vf).op := Subsingleton.elim _ _
      change (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le t)).op ≫
          X.presheaf.map (CategoryTheory.eqToHom hOt_eq.symm).op).hom y = _
      rw [← X.presheaf.map_comp, hmor]
    obtain ⟨e_Vft, he_Vft⟩ := he_Vft_ex
    have he_Us_ex : ∃ e_Us : A_Us ≃+* ↑(X.presheaf.obj (Opposite.op O'_s)),
        ∀ x' : ↑(X.presheaf.obj (Opposite.op U)),
          e_Us (algebraMap _ A_Us x') =
            (X.presheaf.map (CategoryTheory.homOfLE hO's_le_U).op).hom x' := by
      let : Algebra ↑(X.presheaf.obj (Opposite.op U)) ↑(X.presheaf.obj (Opposite.op O'_s)) :=
        (X.presheaf.map (CategoryTheory.homOfLE hO's_le_U).op).hom.toAlgebra
      have : IsLocalization.Away (φ_V s) ↑(X.presheaf.obj (Opposite.op O'_s)) :=
        hU.isLocalization_basicOpen (φ_V s)
      let e := IsLocalization.algEquiv (Submonoid.powers (φ_V s))
        A_Us ↑(X.presheaf.obj (Opposite.op O'_s))
      exact ⟨e.toRingEquiv, fun x' => e.commutes x'⟩
    obtain ⟨e_Us, he_Us⟩ := he_Us_ex
    have he_Uft_ex : ∃ e_Uft : Localization.Away (φ_Vf t) ≃+* ↑(X.presheaf.obj (Opposite.op O'_s)),
        ∀ y' : ↑(X.presheaf.obj (Opposite.op U_free)),
          e_Uft (algebraMap _ (Localization.Away (φ_Vf t)) y') =
            (X.presheaf.map (CategoryTheory.homOfLE hO's_le_Uf).op).hom y' := by
      let : Algebra ↑(X.presheaf.obj (Opposite.op U_free)) ↑(X.presheaf.obj (Opposite.op O'_t)) :=
        (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (φ_Vf t))).op).hom.toAlgebra
      have : IsLocalization.Away (φ_Vf t) ↑(X.presheaf.obj (Opposite.op O'_t)) :=
        hUf.isLocalization_basicOpen (φ_Vf t)
      let e₀ := IsLocalization.algEquiv (Submonoid.powers (φ_Vf t))
        (Localization.Away (φ_Vf t)) ↑(X.presheaf.obj (Opposite.op O'_t))
      let e_eq := (X.presheaf.mapIso (CategoryTheory.eqToIso hO't_eq.symm).op).commRingCatIsoToRingEquiv
      refine ⟨e₀.toRingEquiv.trans e_eq, fun y' => ?_⟩
      change e_eq (e₀ (algebraMap _ (Localization.Away (φ_Vf t)) y')) = _
      rw [e₀.commutes y']
      have hmor : (CategoryTheory.homOfLE (X.basicOpen_le (φ_Vf t))).op ≫
          (CategoryTheory.eqToHom hO't_eq.symm).op =
          (CategoryTheory.homOfLE hO's_le_Uf).op := Subsingleton.elim _ _
      change (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (φ_Vf t))).op ≫
          X.presheaf.map (CategoryTheory.eqToHom hO't_eq.symm).op).hom y' = _
      rw [← X.presheaf.map_comp, hmor]
    obtain ⟨e_Uft, he_Uft⟩ := he_Uft_ex
    let β_iso : A_Vs ≃+* Localization.Away t := e_Vs.trans e_Vft.symm
    let α_iso : Localization.Away (φ_Vf t) ≃+* A_Us := e_Uft.trans e_Us.symm
    let φ_Os : ↑(X.presheaf.obj (Opposite.op O_s)) →+* ↑(X.presheaf.obj (Opposite.op O'_s)) :=
      (φ.appLE O_s O'_s (le_of_eq h_pre_s.symm)).hom
    have h_comm_s : e_Us.toRingHom.comp φ_loc = φ_Os.comp e_Vs.toRingHom := by
      refine IsLocalization.ringHom_ext (Submonoid.powers s) ?_
      apply RingHom.ext
      intro x
      change e_Us (φ_loc (algebraMap _ A_Vs x)) = φ_Os (e_Vs (algebraMap _ A_Vs x))
      rw [hφ_loc_alg x, he_Us, he_Vs]
      have h1 : (AlgebraicGeometry.Scheme.Hom.app φ V ≫
          X.presheaf.map (CategoryTheory.homOfLE hO's_le_U).op) =
          φ.appLE V O'_s (le_trans hO's_le_U le_rfl) := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      have h2 : (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le s)).op ≫
          φ.appLE O_s O'_s (le_of_eq h_pre_s.symm)) =
          φ.appLE V O'_s (le_trans hO's_le_U le_rfl) :=
        AlgebraicGeometry.Scheme.Hom.map_appLE φ (le_of_eq h_pre_s.symm)
          (CategoryTheory.homOfLE (X.basicOpen_le s)).op
      exact congrArg (fun ψ => ψ.hom x) (h1.trans h2.symm)
    have h_comm_t : e_Uft.toRingHom.comp (Localization.awayMap φ_Vf t) =
        φ_Os.comp e_Vft.toRingHom := by
      refine IsLocalization.ringHom_ext (Submonoid.powers t) ?_
      apply RingHom.ext
      intro y
      change e_Uft (Localization.awayMap φ_Vf t (algebraMap _ (Localization.Away t) y)) =
        φ_Os (e_Vft (algebraMap _ (Localization.Away t) y))
      have hlift : Localization.awayMap φ_Vf t (algebraMap _ (Localization.Away t) y) =
          algebraMap _ (Localization.Away (φ_Vf t)) (φ_Vf y) :=
        IsLocalization.Away.lift_eq t
          (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (φ_Vf t)) (φ_Vf t)) y
      rw [hlift, he_Uft, he_Vft]
      have h1 : (AlgebraicGeometry.Scheme.Hom.app φ V_free ≫
          X.presheaf.map (CategoryTheory.homOfLE hO's_le_Uf).op) =
          φ.appLE V_free O'_s (le_trans hO's_le_Uf le_rfl) := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      have h2 : (X.presheaf.map (CategoryTheory.homOfLE hOs_le_Vf).op ≫
          φ.appLE O_s O'_s (le_of_eq h_pre_s.symm)) =
          φ.appLE V_free O'_s (le_trans hO's_le_Uf le_rfl) :=
        AlgebraicGeometry.Scheme.Hom.map_appLE φ (le_of_eq h_pre_s.symm)
          (CategoryTheory.homOfLE hOs_le_Vf).op
      exact congrArg (fun ψ => ψ.hom y) (h1.trans h2.symm)
    have h_intertwine : ∀ b : A_Vs,
        α_iso (Localization.awayMap φ_Vf t (β_iso b)) = φ_loc b := by
      intro b
      change e_Us.symm (e_Uft (Localization.awayMap φ_Vf t (e_Vft.symm (e_Vs b)))) = φ_loc b
      have ht_b := RingHom.congr_fun h_comm_t (e_Vft.symm (e_Vs b))
      change e_Uft (Localization.awayMap φ_Vf t (e_Vft.symm (e_Vs b))) =
        φ_Os (e_Vft (e_Vft.symm (e_Vs b))) at ht_b
      rw [e_Vft.apply_symm_apply] at ht_b
      have hs_b := RingHom.congr_fun h_comm_s b
      change e_Us (φ_loc b) = φ_Os (e_Vs b) at hs_b
      rw [ht_b, ← hs_b, e_Us.symm_apply_apply]
    obtain ⟨e_δ, he_δ⟩ := by
      let : AddCommGroup M_free := hAddM
      let : Module ↑(X.presheaf.obj (Opposite.op V_free)) M_free := hModM
      exact hBasisAway φ_Vf bM_free e_free he_free t β_iso α_iso φ_loc h_intertwine
    have hj_comm : CategoryTheory.CategoryStruct.comp j_YU φ =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)) j_YV := by
      have happ_spec := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec φ hV hU le_rfl
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE] at happ_spec
      have hring : AlgebraicGeometry.Scheme.Hom.app φ V ≫
          CommRingCat.ofHom (algebraMap _ A_Us) =
          CommRingCat.ofHom (algebraMap _ A_Vs) ≫ CommRingCat.ofHom φ_loc := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        exact (hφ_loc_alg x).symm
      calc
        j_YU ≫ φ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ A_Us)) ≫
            (hU.fromSpec ≫ φ) := CategoryTheory.Category.assoc _ _ _
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ A_Us)) ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app φ V)) ≫
              hV.fromSpec := by
            rw [← happ_spec, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ A_Vs)) ≫
                hV.fromSpec) := by
            rw [← AlgebraicGeometry.Spec.map_comp, hring, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ j_YV := rfl
    have hj_range : Set.range j_YU.base = φ.base ⁻¹' (Set.range j_YV.base) := by
      rw [hRangeAwayFromSpec X U hU (φ_V s), hRangeAwayFromSpec X V hV s]
      exact congrArg (fun O : X.Opens => (O : Set ↥X)) h_pre_s.symm
    exact ⟨φ_loc, e_δ, hφ_loc_alg, he_δ, hj_comm, hj_range⟩

theorem weil_top_deg_kummer_graph_roof_and_chart_alignment (k : Type u) [Field k]
    (d : ℕ) (hd : 1 ≤ d)
    (P_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper P_ov.hom]
    (hIntP : AlgebraicGeometry.IsIntegral P_ov.left)
    (hDimP : topologicalKrullDim P_ov.left = (d : WithBot ℕ∞))
    (ι_d : Quiver.Hom (weilAffineSpaceOver k d).left P_ov.left)
    (hOpen_d : AlgebraicGeometry.IsOpenImmersion ι_d)
    (h_over_d : CategoryTheory.CategoryStruct.comp ι_d P_ov.hom =
      (weilAffineSpaceOver k d).hom) :
    let R₀ := MvPolynomial (Fin d) k
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsIntegral Y.left)
        [AlgebraicGeometry.IsProper Y.hom]
        (_ : topologicalKrullDim Y.left = (d : WithBot ℕ∞)),
      (∀ (W : Y.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W) (_ : Nonempty ↥W),
        let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
        let kAlgW : Algebra k A_W :=
          RingHom.toAlgebra (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
        IsDomain A_W ∧ @Algebra.FiniteType k A_W _ _ kAlgW) ∧
      (∀ (O : Y.left.Opens) (_ : Nonempty ↥O),
        topologicalKrullDim (weilAltClosedComplIdeal Y.left O).subscheme ≤
          ((d - 1 : ℕ) : WithBot ℕ∞))) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsIntegral Y.left)
        [AlgebraicGeometry.IsProper Y.hom]
        (_ : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
        (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (_ : Nonempty ↥W),
      let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
      let kAlgW : Algebra k A_W :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
      ∀ (w : Fin d → A_W) (_ : @IsTranscendenceBasis (Fin d) k A_W _ _ kAlgW w)
        (g : R₀) (_ : g ≠ 0) (m_w : ℕ) (_ : 1 ≤ m_w),
        let ψ_w : R₀ →+* A_W := weilTopDegKummerChartEvalHom k d Y W w
        let B_g := Localization.Away g
        let A_g := Localization.Away (ψ_w g)
        let ψ_g : B_g →+* A_g := Localization.awayMap ψ_w g
        ∀ (M : Type u) [AddCommGroup M] [Module B_g M]
          (_ : Module.Basis (Fin m_w) B_g M) (eM : M ≃+ A_g),
          (∀ (b : B_g) (m : M), eM (b • m) = ψ_g b * eM m) →
          (∀ (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (π_Y : Quiver.Hom Γ.left Y.left)
              (π_P : Quiver.Hom Γ.left P_ov.left)
              (U_g : P_ov.left.Opens)
              (iso_Ug : CategoryTheory.Iso U_g.toScheme
                (AlgebraicGeometry.Spec (CommRingCat.of B_g)))
              (j_Γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Γ.left)
              (j_Y : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Y.left),
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g
              Γ π_Y π_P U_g iso_Ug j_Γ j_Y →
            Nonempty ↥((TopologicalSpace.Opens.map π_P.base).obj U_g) ∧
            WeilTopDegFiniteLocallyFreeOfRank m_w (π_P ∣_ U_g)) ∧
          (∃ (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (π_Y : Quiver.Hom Γ.left Y.left)
              (π_P : Quiver.Hom Γ.left P_ov.left)
              (U_g : P_ov.left.Opens)
              (iso_Ug : CategoryTheory.Iso U_g.toScheme
                (AlgebraicGeometry.Spec (CommRingCat.of B_g)))
              (j_Γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Γ.left)
              (j_Y : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Y.left)
              (O_Y : Y.left.Opens),
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g
              Γ π_Y π_P U_g iso_Ug j_Γ j_Y ∧
            Nonempty ↥O_Y ∧
            (TopologicalSpace.Opens.map π_Y.base).obj O_Y =
              (TopologicalSpace.Opens.map π_P.base).obj U_g ∧
            CategoryTheory.IsIso (π_Y ∣_ O_Y))) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsIntegral Y.left)
        [AlgebraicGeometry.IsProper Y.hom]
        (_ : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
        (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (_ : Nonempty ↥W),
      let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
      let kAlgW : Algebra k A_W :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
      ∀ (w : Fin d → A_W) (_ : @IsTranscendenceBasis (Fin d) k A_W _ _ kAlgW w),
        let ψ_w : R₀ →+* A_W := weilTopDegKummerChartEvalHom k d Y W w
        ∀ (g₁ : R₀) (_ : g₁ ≠ 0) (m₁ : ℕ) (_ : 1 ≤ m₁)
          (M₁ : Type u) [AddCommGroup M₁] [Module (Localization.Away g₁) M₁]
          (_ : Module.Basis (Fin m₁) (Localization.Away g₁) M₁)
          (eM₁ : M₁ ≃+ Localization.Away (ψ_w g₁))
          (_ : ∀ b m, eM₁ (b • m) = Localization.awayMap ψ_w g₁ b * eM₁ m)
          (Γ₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (π_Y₁ : Quiver.Hom Γ₁.left Y.left) (π_P₁ : Quiver.Hom Γ₁.left P_ov.left)
          (U₁ : P_ov.left.Opens)
          (iso₁ : CategoryTheory.Iso U₁.toScheme
            (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₁))))
          (j_Γ₁ : Quiver.Hom
            (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g₁)))) Γ₁.left)
          (j_Y₁ : Quiver.Hom
            (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g₁)))) Y.left),
          WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g₁
            Γ₁ π_Y₁ π_P₁ U₁ iso₁ j_Γ₁ j_Y₁ →
          ∀ (g₂ : R₀) (_ : g₂ ≠ 0) (m₂ : ℕ) (_ : 1 ≤ m₂)
            (M₂ : Type u) [AddCommGroup M₂] [Module (Localization.Away g₂) M₂]
            (_ : Module.Basis (Fin m₂) (Localization.Away g₂) M₂)
            (eM₂ : M₂ ≃+ Localization.Away (ψ_w g₂))
            (_ : ∀ b m, eM₂ (b • m) = Localization.awayMap ψ_w g₂ b * eM₂ m)
            (Γ₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
            (π_Y₂ : Quiver.Hom Γ₂.left Y.left) (π_P₂ : Quiver.Hom Γ₂.left P_ov.left)
            (U₂ : P_ov.left.Opens)
            (iso₂ : CategoryTheory.Iso U₂.toScheme
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₂))))
            (j_Γ₂ : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g₂)))) Γ₂.left)
            (j_Y₂ : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g₂)))) Y.left),
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g₂
              Γ₂ π_Y₂ π_P₂ U₂ iso₂ j_Γ₂ j_Y₂ →
            m₁ = m₂ ∧
            ∃ (Γ₁₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (U₁₂ : P_ov.left.Opens)
              (q₁ : Quiver.Hom Γ₁₂.left Γ₁.left)
              (q₂ : Quiver.Hom Γ₁₂.left Γ₂.left),
              AlgebraicGeometry.IsProper Γ₁₂.hom ∧
              AlgebraicGeometry.IsIntegral Γ₁₂.left ∧
              topologicalKrullDim Γ₁₂.left = (d : WithBot ℕ∞) ∧
              CategoryTheory.CategoryStruct.comp q₁ Γ₁.hom = Γ₁₂.hom ∧
              CategoryTheory.CategoryStruct.comp q₂ Γ₂.hom = Γ₁₂.hom ∧
              CategoryTheory.CategoryStruct.comp q₁ π_Y₁ =
                CategoryTheory.CategoryStruct.comp q₂ π_Y₂ ∧
              CategoryTheory.CategoryStruct.comp q₁ π_P₁ =
                CategoryTheory.CategoryStruct.comp q₂ π_P₂ ∧
              U₁₂ ≤ U₁ ∧
              U₁₂ ≤ U₂ ∧
              Nonempty ↥((TopologicalSpace.Opens.map
                (CategoryTheory.CategoryStruct.comp q₁ π_P₁).base).obj U₁₂) ∧
              CategoryTheory.IsIso (q₁ ∣_ ((TopologicalSpace.Opens.map π_P₁.base).obj U₁₂)) ∧
              CategoryTheory.IsIso (q₂ ∣_ ((TopologicalSpace.Opens.map π_P₂.base).obj U₁₂))) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsIntegral Y.left)
        [AlgebraicGeometry.IsProper Y.hom]
        (_ : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
        (W' W : Y.left.Opens)
        (hW' : AlgebraicGeometry.IsAffineOpen W') (_ : Nonempty ↥W')
        (hW : AlgebraicGeometry.IsAffineOpen W) (_ : Nonempty ↥W)
        (hle : W' ≤ W),
      let kAlgW : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W)) :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
      let kAlgW' : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W')) :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W' le_top)))
      ∀ (w : Fin d → ↑(Y.left.presheaf.obj (Opposite.op W)))
        (_ : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgW w)
        (_ : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgW'
          (fun i => (CommRingCat.Hom.hom
            (Y.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE hle)))) (w i))),
        let w' : Fin d → ↑(Y.left.presheaf.obj (Opposite.op W')) :=
          fun i => (CommRingCat.Hom.hom
            (Y.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE hle)))) (w i)
        let ψ_w := weilTopDegKummerChartEvalHom k d Y W w
        let ψ_w' := weilTopDegKummerChartEvalHom k d Y W' w'
        ∀ (g₀ : R₀) (_ : g₀ ≠ 0) (m₀ : ℕ) (_ : 1 ≤ m₀)
          (M₀ : Type u) [AddCommGroup M₀] [Module (Localization.Away g₀) M₀]
          (_ : Module.Basis (Fin m₀) (Localization.Away g₀) M₀)
          (eM₀ : M₀ ≃+ Localization.Away (ψ_w g₀)),
          (∀ b m, eM₀ (b • m) = Localization.awayMap ψ_w g₀ b * eM₀ m) →
          ∃ (g : R₀) (_ : g ≠ 0)
            (M_W : Type u) (_ : AddCommGroup M_W) (_ : Module (Localization.Away g) M_W)
            (_ : Module.Basis (Fin m₀) (Localization.Away g) M_W)
            (eM_W : M_W ≃+ Localization.Away (ψ_w g))
            (M_W' : Type u) (_ : AddCommGroup M_W') (_ : Module (Localization.Away g) M_W')
            (_ : Module.Basis (Fin m₀) (Localization.Away g) M_W')
            (eM_W' : M_W' ≃+ Localization.Away (ψ_w' g))
            (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
            (π_Y : Quiver.Hom Γ.left Y.left)
            (π_P : Quiver.Hom Γ.left P_ov.left)
            (U_g : P_ov.left.Opens)
            (iso_Ug : CategoryTheory.Iso U_g.toScheme
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))))
            (j_Γ : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Γ.left)
            (j_Y : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Y.left)
            (j'_Γ : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w' g)))) Γ.left)
            (j'_Y : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w' g)))) Y.left),
            (∀ (b : Localization.Away g) (m : M_W),
              eM_W (b • m) = Localization.awayMap ψ_w g b * eM_W m) ∧
            (∀ (b : Localization.Away g) (m : M_W'),
              eM_W' (b • m) = Localization.awayMap ψ_w' g b * eM_W' m) ∧
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g
              Γ π_Y π_P U_g iso_Ug j_Γ j_Y ∧
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W' hW' ψ_w' g
              Γ π_Y π_P U_g iso_Ug j'_Γ j'_Y) ∧
    (letI := hOpen_d
      let W_aff : P_ov.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_d
      ∀ (hAff_P : AlgebraicGeometry.IsAffineOpen W_aff)
        (_ : Nonempty ↥W_aff),
      let kAlgP : Algebra k ↑(P_ov.left.presheaf.obj (Opposite.op W_aff)) :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE P_ov.hom ⊤ W_aff le_top)))
      ∀ (x_std : Fin d → ↑(P_ov.left.presheaf.obj (Opposite.op W_aff))),
        (∀ i : Fin d,
          (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appLE ι_d W_aff ⊤ (fun x _ => ⟨x, rfl⟩))
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom))
            (x_std i) = MvPolynomial.X i) →
        (let ψ_std := weilTopDegKummerChartEvalHom k d P_ov W_aff x_std
          ∃ (M_id : Type u) (_ : AddCommGroup M_id)
            (_ : Module (Localization.Away (1 : R₀)) M_id)
            (_ : Module.Basis (Fin 1) (Localization.Away (1 : R₀)) M_id)
            (eM_id : M_id ≃+ Localization.Away (ψ_std 1))
            (iso_U1 : CategoryTheory.Iso W_aff.toScheme
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (1 : R₀)))))
            (j_Γ1 : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_std 1)))) P_ov.left)
            (j_Y1 : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_std 1)))) P_ov.left),
            (∀ (b : Localization.Away (1 : R₀)) (m : M_id),
              eM_id (b • m) = Localization.awayMap ψ_std 1 b * eM_id m) ∧
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d P_ov W_aff hAff_P ψ_std 1
              P_ov (CategoryTheory.CategoryStruct.id P_ov.left)
              (CategoryTheory.CategoryStruct.id P_ov.left)
              W_aff iso_U1 j_Γ1 j_Y1) ∧
        (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
            (_ : AlgebraicGeometry.IsIntegral Y.left)
            [AlgebraicGeometry.IsProper Y.hom]
            (_ : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
            (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (_ : Nonempty ↥W),
          let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
          let kAlgW : Algebra k A_W :=
            RingHom.toAlgebra (CommRingCat.Hom.hom
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
                (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
          ∀ (w : Fin d → A_W) (_ : @IsTranscendenceBasis (Fin d) k A_W _ _ kAlgW w),
            let ψ_w := weilTopDegKummerChartEvalHom k d Y W w
            ∀ (g : R₀) (_ : g ≠ 0) (m_w : ℕ) (_ : 1 ≤ m_w)
              (M : Type u) [AddCommGroup M] [Module (Localization.Away g) M]
              (_ : Module.Basis (Fin m_w) (Localization.Away g) M)
              (eM : M ≃+ Localization.Away (ψ_w g)),
              (∀ b m, eM (b • m) = Localization.awayMap ψ_w g b * eM m) →
              ∀ (θ : R₀ ≃ₐ[k] R₀),
                let g' : R₀ := θ.symm g
                let w_θ : Fin d → A_W :=
                  fun i => @MvPolynomial.aeval k A_W (Fin d) _ _ kAlgW w (θ (MvPolynomial.X i))
                let x_θ : Fin d → ↑(P_ov.left.presheaf.obj (Opposite.op W_aff)) :=
                  fun i => @MvPolynomial.aeval k _ (Fin d) _ _ kAlgP x_std (θ (MvPolynomial.X i))
                let ψ_wθ := weilTopDegKummerChartEvalHom k d Y W w_θ
                let ψ_xθ := weilTopDegKummerChartEvalHom k d P_ov W_aff x_θ
                g' ≠ 0 ∧
                ∃ (M_P : Type u) (_ : AddCommGroup M_P)
                  (_ : Module (Localization.Away g') M_P)
                  (_ : Module.Basis (Fin 1) (Localization.Away g') M_P)
                  (eM_P : M_P ≃+ Localization.Away (ψ_xθ g'))
                  (M_θ : Type u) (_ : AddCommGroup M_θ)
                  (_ : Module (Localization.Away g') M_θ)
                  (_ : Module.Basis (Fin m_w) (Localization.Away g') M_θ)
                  (eM_θ : M_θ ≃+ Localization.Away (ψ_wθ g'))
                  (Γ_θ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
                  (π_1θ : Quiver.Hom Γ_θ.left P_ov.left)
                  (π_2θ : Quiver.Hom Γ_θ.left P_ov.left)
                  (U_g : P_ov.left.Opens)
                  (iso_Ug : CategoryTheory.Iso U_g.toScheme
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))))
                  (U'_g' : P_ov.left.Opens)
                  (iso_Ug' : CategoryTheory.Iso U'_g'.toScheme
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g'))))
                  (j_Γθ : Quiver.Hom
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_xθ g'))))
                    Γ_θ.left)
                  (j_Pθ : Quiver.Hom
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_xθ g'))))
                    P_ov.left)
                  (Γ_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
                  (h_θ : Quiver.Hom Γ_tilde.left Γ_θ.left)
                  (π_tilde_Y : Quiver.Hom Γ_tilde.left Y.left)
                  (j_Γt1 : Quiver.Hom
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g))))
                    Γ_tilde.left)
                  (j_Yt1 : Quiver.Hom
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g))))
                    Y.left)
                  (j_Γt2 : Quiver.Hom
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_wθ g'))))
                    Γ_tilde.left)
                  (j_Yt2 : Quiver.Hom
                    (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_wθ g'))))
                    Y.left),
                  (∀ (b : Localization.Away g') (m : M_P),
                    eM_P (b • m) = Localization.awayMap ψ_xθ g' b * eM_P m) ∧
                  (∀ (b : Localization.Away g') (m : M_θ),
                    eM_θ (b • m) = Localization.awayMap ψ_wθ g' b * eM_θ m) ∧
                  WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d P_ov W_aff hAff_P ψ_xθ g'
                    Γ_θ π_1θ π_2θ U'_g' iso_Ug' j_Γθ j_Pθ ∧
                  (TopologicalSpace.Opens.map π_1θ.base).obj U_g =
                    (TopologicalSpace.Opens.map π_2θ.base).obj U'_g' ∧
                  CategoryTheory.IsIso (π_1θ ∣_ U_g) ∧
                  CategoryTheory.CategoryStruct.comp h_θ Γ_θ.hom = Γ_tilde.hom ∧
                  WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g
                    Γ_tilde π_tilde_Y (CategoryTheory.CategoryStruct.comp h_θ π_1θ)
                    U_g iso_Ug j_Γt1 j_Yt1 ∧
                  WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_wθ g'
                    Γ_tilde π_tilde_Y (CategoryTheory.CategoryStruct.comp h_θ π_2θ)
                    U'_g' iso_Ug' j_Γt2 j_Yt2 ∧
                  WeilTopDegFiniteLocallyFreeOfRank m_w
                    (h_θ ∣_ ((TopologicalSpace.Opens.map π_1θ.base).obj U_g)))) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsIntegral Y.left)
        [AlgebraicGeometry.IsProper Y.hom]
        (_ : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
        (δ : ℕ) (_ : 1 ≤ δ)
        (φ : Quiver.Hom Y.left Y.left),
      CategoryTheory.CategoryStruct.comp φ Y.hom = Y.hom →
      WeilTopDegFiniteLocallyFreeOfRank δ φ →
      ∀ (V : Y.left.Opens) (hV : AlgebraicGeometry.IsAffineOpen V) (_ : Nonempty ↥V),
        let U : Y.left.Opens := (TopologicalSpace.Opens.map φ.base).obj V
        let kAlgV : Algebra k ↑(Y.left.presheaf.obj (Opposite.op V)) :=
          RingHom.toAlgebra (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ V le_top)))
        ∀ (hU : AlgebraicGeometry.IsAffineOpen U) (_ : Nonempty ↥U)
          (u : Fin d → ↑(Y.left.presheaf.obj (Opposite.op V)))
          (_ : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgV u),
          let u' : Fin d → ↑(Y.left.presheaf.obj (Opposite.op U)) :=
            fun i => (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app φ V)) (u i)
          let ψ_u := weilTopDegKummerChartEvalHom k d Y V u
          let ψ_u' := weilTopDegKummerChartEvalHom k d Y U u'
          ∀ (g₀ : R₀) (_ : g₀ ≠ 0) (m_u : ℕ) (_ : 1 ≤ m_u)
            (M₀ : Type u) [AddCommGroup M₀] [Module (Localization.Away g₀) M₀]
            (_ : Module.Basis (Fin m_u) (Localization.Away g₀) M₀)
            (eM₀ : M₀ ≃+ Localization.Away (ψ_u g₀)),
            (∀ b m, eM₀ (b • m) = Localization.awayMap ψ_u g₀ b * eM₀ m) →
            ∃ (g : R₀) (_ : g ≠ 0)
              (M_V : Type u) (_ : AddCommGroup M_V) (_ : Module (Localization.Away g) M_V)
              (_ : Module.Basis (Fin m_u) (Localization.Away g) M_V)
              (eM_V : M_V ≃+ Localization.Away (ψ_u g))
              (M_U : Type u) (_ : AddCommGroup M_U) (_ : Module (Localization.Away g) M_U)
              (_ : Module.Basis (Fin (m_u * δ)) (Localization.Away g) M_U)
              (eM_U : M_U ≃+ Localization.Away (ψ_u' g))
              (Γ_V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (π_YV : Quiver.Hom Γ_V.left Y.left)
              (π_PV : Quiver.Hom Γ_V.left P_ov.left)
              (U_g : P_ov.left.Opens)
              (iso_Ug : CategoryTheory.Iso U_g.toScheme
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))))
              (j_ΓV : Quiver.Hom
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_u g)))) Γ_V.left)
              (j_YV : Quiver.Hom
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_u g)))) Y.left)
              (Γ_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (π_tilde : Quiver.Hom Γ_tilde.left Y.left)
              (φ_tilde : Quiver.Hom Γ_tilde.left Γ_V.left)
              (Γ_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (π_YU : Quiver.Hom Γ_U.left Y.left)
              (π_PU : Quiver.Hom Γ_U.left P_ov.left)
              (j_ΓU : Quiver.Hom
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_u' g)))) Γ_U.left)
              (j_YU : Quiver.Hom
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_u' g)))) Y.left)
              (i_U : Quiver.Hom Γ_U.left Γ_tilde.left),
              let V_ΓV : Γ_V.left.Opens := (TopologicalSpace.Opens.map π_PV.base).obj U_g
              let O_tilde : Γ_tilde.left.Opens :=
                (TopologicalSpace.Opens.map φ_tilde.base).obj V_ΓV
              (∀ (b : Localization.Away g) (m : M_V),
                eM_V (b • m) = Localization.awayMap ψ_u g b * eM_V m) ∧
              (∀ (b : Localization.Away g) (m : M_U),
                eM_U (b • m) = Localization.awayMap ψ_u' g b * eM_U m) ∧
              WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y V hV ψ_u g
                Γ_V π_YV π_PV U_g iso_Ug j_ΓV j_YV ∧
              AlgebraicGeometry.IsOpenImmersion (CategoryTheory.CategoryStruct.comp V_ΓV.ι π_YV) ∧
              AlgebraicGeometry.IsProper Γ_tilde.hom ∧
              CategoryTheory.CategoryStruct.comp π_tilde Y.hom = Γ_tilde.hom ∧
              CategoryTheory.CategoryStruct.comp φ_tilde Γ_V.hom = Γ_tilde.hom ∧
              CategoryTheory.IsPullback π_tilde φ_tilde φ π_YV ∧
              WeilTopDegFiniteLocallyFreeOfRank δ (φ_tilde ∣_ V_ΓV) ∧
              topologicalKrullDim
                (weilAltClosedComplIdeal Γ_tilde.left O_tilde).subscheme ≤
                  ((d - 1 : ℕ) : WithBot ℕ∞) ∧
              WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y U hU ψ_u' g
                Γ_U π_YU π_PU U_g iso_Ug j_ΓU j_YU ∧
              CategoryTheory.CategoryStruct.comp i_U Γ_tilde.hom = Γ_U.hom ∧
              CategoryTheory.CategoryStruct.comp i_U π_tilde = π_YU ∧
              CategoryTheory.CategoryStruct.comp i_U
                (CategoryTheory.CategoryStruct.comp φ_tilde π_PV) = π_PU ∧
              CategoryTheory.IsIso (i_U ∣_ O_tilde)) :=
by
  classical
  let R₀ := MvPolynomial (Fin d) k
  obtain ⟨hDim1, hDim2, hDim3⟩ :=
    weil_top_deg_krullDim_integral_compl_and_isFinite_preimage k d
  obtain ⟨hImg1, hImg2⟩ :=
    weil_top_deg_schematic_graph_image_and_proper_cancel k
  obtain ⟨hAlg1, hAlg2, hAlg3, hAlg4, hAlg5a, hAlg5b⟩ :=
    weil_top_deg_transBasis_loc_basis_and_annihilator k d
  obtain ⟨⟨hAff1a, hAff1b⟩, hAff2, hAff3, hAff4⟩ :=
    weil_top_deg_affineOpen_away_iso_and_finiteFree_pullback k d

  
  have hAwayEquiv : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (e : R ≃+* S) (r : R) (s : S) (_ : e r = s),
      ∃ α : Localization.Away r ≃+* Localization.Away s,
        ∀ x : R, α (algebraMap R (Localization.Away r) x) =
          algebraMap S (Localization.Away s) (e x) := by
    intro R S _ _ e r s hrs
    refine ⟨IsLocalization.ringEquivOfRingEquiv
      (M := Submonoid.powers r) (T := Submonoid.powers s)
      (Localization.Away r) (Localization.Away s) e ?_,
      fun x => IsLocalization.ringEquivOfRingEquiv_eq _ x⟩
    rw [← hrs]
    ext y
    simp only [Submonoid.mem_map, Submonoid.mem_powers_iff]
    exact ⟨fun ⟨z, ⟨n, hz⟩, hy⟩ => ⟨n, by
        change e z = y at hy
        rw [← hy, ← hz, map_pow]⟩,
      fun ⟨n, hy⟩ => ⟨r ^ n, ⟨n, rfl⟩, by
        change e (r ^ n) = y
        rw [map_pow, hy]⟩⟩

  
  have hRange_comp_iso : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}}
      (e : X ⟶ Y) [CategoryTheory.IsIso e] (f : Y ⟶ Z),
      Set.range (e ≫ f).base = Set.range f.base := by
    intro X Y Z e _ f
    ext z
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨e.base x, rfl⟩
    · rintro ⟨y, rfl⟩
      refine ⟨(CategoryTheory.inv e).base y, ?_⟩
      change ((CategoryTheory.inv e ≫ e) ≫ f).base y = f.base y
      rw [CategoryTheory.IsIso.inv_hom_id, Category.id_comp]

  
  have hOpenIsoOfRange : ∀ {X Y : AlgebraicGeometry.Scheme.{u}}
      (j : X ⟶ Y) (hj : AlgebraicGeometry.IsOpenImmersion j)
      (O : Y.Opens) (_ : Set.range j.base = (O : Set ↥Y)),
      ∃ iso_O : O.toScheme ≅ X, iso_O.inv ≫ O.ι = j := by
    intro X Y j hj O h_range
    have : AlgebraicGeometry.IsOpenImmersion j := hj
    have h_sub : Set.range j.base ⊆ Set.range O.ι.base := by
      rw [h_range, AlgebraicGeometry.Scheme.Opens.range_ι]
    let j_O : X ⟶ O.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O.ι j h_sub
    have hj_O_fac : j_O ≫ O.ι = j :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι j h_sub
    have hj_O_open : AlgebraicGeometry.IsOpenImmersion j_O := by
      rw [← hj_O_fac] at hj
      exact AlgebraicGeometry.IsOpenImmersion.of_comp j_O O.ι
    have hsurj : Function.Surjective j_O.base := by
      rintro ⟨y, hy⟩
      have hy' : y ∈ Set.range j.base := h_range.symm ▸ hy
      obtain ⟨x, hx⟩ := hy'
      refine ⟨x, Subtype.ext ?_⟩
      change (j_O ≫ O.ι).base x = y
      rw [hj_O_fac]
      exact hx
    have : CategoryTheory.Epi j_O.base :=
      (TopCat.epi_iff_surjective j_O.base).mpr hsurj
    have : CategoryTheory.IsIso j_O :=
      AlgebraicGeometry.IsOpenImmersion.isIso j_O
    exact ⟨(CategoryTheory.asIso j_O).symm, hj_O_fac⟩

  
  have hOpen_ug : ∀ g : R₀,
      AlgebraicGeometry.IsOpenImmersion
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))))
          ι_d) := by
    intro g
    let ι_std : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ P_ov.left := ι_d
    have : AlgebraicGeometry.IsOpenImmersion ι_std := hOpen_d
    change AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) ≫ ι_std)
    infer_instance

  have h_ug_over_all : ∀ g : R₀,
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))))
        ι_d) ≫ P_ov.hom =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) ≫
          CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) := by
    intro g
    let ι_std : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ P_ov.left := ι_d
    have h_ov_std : ι_std ≫ P_ov.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀)) :=
      h_over_d
    calc
      (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) ≫ ι_std) ≫ P_ov.hom
        = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) ≫
            (ι_std ≫ P_ov.hom) := Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀)) := by
          rw [h_ov_std]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) ≫
              CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm

  have hAwayMap_eq : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (f : R →+* S) (r x : R),
      Localization.awayMap f r (algebraMap R (Localization.Away r) x) =
        algebraMap S (Localization.Away (f r)) (f x) :=
    fun f r x => IsLocalization.Away.lift_eq r
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (f r)) (f r)) x

  
  have hFin1Equiv : ∀ {B A : Type u} [CommRing B] [CommRing A]
      (ψ : B →+* A) (α : B ≃+* A) (_ : α.toRingHom = ψ),
      ∃ eM : (Fin 1 → B) ≃+ A,
        ∀ (b : B) (m : Fin 1 → B), eM (b • m) = ψ b * eM m := by
    intro B A _ _ ψ α hα
    refine ⟨{
      toFun := fun c => α (c 0)
      invFun := fun a _ => α.symm a
      left_inv := fun c => by ext i; dsimp; rw [Fin.eq_zero i, α.symm_apply_apply]
      right_inv := fun a => α.apply_symm_apply a
      map_add' := fun c₁ c₂ => map_add α (c₁ 0) (c₂ 0) }, ?_⟩
    intro b m
    change α (b * m 0) = ψ b * α (m 0)
    rw [map_mul, ← hα]
    rfl

  
  have hGeom1 : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (_ : AlgebraicGeometry.IsIntegral Y.left)
      [AlgebraicGeometry.IsProper Y.hom]
      (_ : topologicalKrullDim Y.left = (d : WithBot ℕ∞)),
      (∀ (W : Y.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W) (_ : Nonempty ↥W),
        let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
        let kAlgW : Algebra k A_W :=
          RingHom.toAlgebra (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
        IsDomain A_W ∧ @Algebra.FiniteType k A_W _ _ kAlgW) ∧
      (∀ (O : Y.left.Opens) (_ : Nonempty ↥O),
        topologicalKrullDim (weilAltClosedComplIdeal Y.left O).subscheme ≤
          ((d - 1 : ℕ) : WithBot ℕ∞)) := by
    intro Y hIntY _ hDimY
    exact ⟨(hDim1 Y hIntY).1, hDim2 hd Y.left hIntY hDimY⟩

  
  have hGeom2a : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (hIntY : AlgebraicGeometry.IsIntegral Y.left)
      [AlgebraicGeometry.IsProper Y.hom]
      (hDimY : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
      (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W),
      let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
      let kAlgW : Algebra k A_W :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
      ∀ (w : Fin d → A_W) (_ : @IsTranscendenceBasis (Fin d) k A_W _ _ kAlgW w)
        (g : R₀) (_ : g ≠ 0) (m_w : ℕ) (_ : 1 ≤ m_w),
        let ψ_w : R₀ →+* A_W := weilTopDegKummerChartEvalHom k d Y W w
        let B_g := Localization.Away g
        let A_g := Localization.Away (ψ_w g)
        let ψ_g : B_g →+* A_g := Localization.awayMap ψ_w g
        ∀ (M : Type u) [AddCommGroup M] [Module B_g M]
          (_ : Module.Basis (Fin m_w) B_g M) (eM : M ≃+ A_g),
          (∀ (b : B_g) (m : M), eM (b • m) = ψ_g b * eM m) →
          ∀ (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
            (π_Y : Quiver.Hom Γ.left Y.left)
            (π_P : Quiver.Hom Γ.left P_ov.left)
            (U_g : P_ov.left.Opens)
            (iso_Ug : CategoryTheory.Iso U_g.toScheme
              (AlgebraicGeometry.Spec (CommRingCat.of B_g)))
            (j_Γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Γ.left)
            (j_Y : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Y.left),
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g
              Γ π_Y π_P U_g iso_Ug j_Γ j_Y →
            Nonempty ↥((TopologicalSpace.Opens.map π_P.base).obj U_g) ∧
            WeilTopDegFiniteLocallyFreeOfRank m_w (π_P ∣_ U_g) := by
    intro Y hIntY _ hDimY W hW hNe A_W kAlgW w hw g hg m_w _ ψ_w B_g A_g ψ_g
      M _ _ bM eM heM Γ π_Y π_P U_g iso_Ug j_Γ j_Y hRoof
    let : Algebra k A_W := kAlgW
    have : IsDomain A_W := ((hGeom1 Y hIntY hDimY).1 W hW hNe).1
    have : IsDomain A_g := (hAlg1 A_W w hw g hg).2.2.1
    obtain ⟨pt₀⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of A_g)) := inferInstance
    let V_Γ : Γ.left.Opens := (TopologicalSpace.Opens.map π_P.base).obj U_g
    have hj_Γ_open : AlgebraicGeometry.IsOpenImmersion j_Γ := hRoof.2.2.2.2.2.2.1
    have hj_Γ_P := hRoof.2.2.2.2.2.2.2.2.2.2.1
    have hj_Γ_range : Set.range j_Γ.base = (V_Γ : Set ↥Γ.left) := hRoof.2.2.2.2.2.2.2.2.2.2.2
    have hpt_V : j_Γ.base pt₀ ∈ V_Γ := by
      change j_Γ.base pt₀ ∈ (V_Γ : Set ↥Γ.left)
      rw [← hj_Γ_range]
      exact ⟨pt₀, rfl⟩
    obtain ⟨iso_V, hiso_V⟩ := hOpenIsoOfRange j_Γ hj_Γ_open V_Γ hj_Γ_range
    refine ⟨⟨⟨j_Γ.base pt₀, hpt_V⟩⟩,
      hImg2 (π_P ∣_ U_g) A_g B_g ψ_g m_w M bM eM heM iso_V iso_Ug ?_⟩
    rw [← cancel_mono U_g.ι]
    calc
      (iso_V.inv ≫ (π_P ∣_ U_g)) ≫ U_g.ι
        = iso_V.inv ≫ ((π_P ∣_ U_g) ≫ U_g.ι) := Category.assoc _ _ _
      _ = iso_V.inv ≫ (V_Γ.ι ≫ π_P) := by rw [AlgebraicGeometry.morphismRestrict_ι]
      _ = (iso_V.inv ≫ V_Γ.ι) ≫ π_P := (Category.assoc _ _ _).symm
      _ = j_Γ ≫ π_P := by rw [hiso_V]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_g) ≫ (iso_Ug.inv ≫ U_g.ι) := hj_Γ_P
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_g) ≫ iso_Ug.inv) ≫ U_g.ι :=
          (Category.assoc _ _ _).symm

  
  have hRoof_ex : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (hIntY : AlgebraicGeometry.IsIntegral Y.left)
      [AlgebraicGeometry.IsProper Y.hom]
      (hDimY : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
      (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W),
      let A_W := ↑(Y.left.presheaf.obj (Opposite.op W))
      let kAlgW : Algebra k A_W :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
      ∀ (w : Fin d → A_W) (_ : @IsTranscendenceBasis (Fin d) k A_W _ _ kAlgW w)
        (g : R₀) (_ : g ≠ 0) (m_w : ℕ) (_ : 1 ≤ m_w),
        let ψ_w : R₀ →+* A_W := weilTopDegKummerChartEvalHom k d Y W w
        let B_g := Localization.Away g
        let A_g := Localization.Away (ψ_w g)
        let ψ_g : B_g →+* A_g := Localization.awayMap ψ_w g
        ∀ (M : Type u) [AddCommGroup M] [Module B_g M]
          (_ : Module.Basis (Fin m_w) B_g M) (eM : M ≃+ A_g),
          (∀ (b : B_g) (m : M), eM (b • m) = ψ_g b * eM m) →
          letI := hOpen_ug g
          let u_P := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_g))) ι_d
          let U_g : P_ov.left.Opens := u_P.opensRange
          let iso_Ug : CategoryTheory.Iso U_g.toScheme
              (AlgebraicGeometry.Spec (CommRingCat.of B_g)) :=
            u_P.isoOpensRange.symm
          let j_Y : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Y.left :=
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_W A_g)))
              hW.fromSpec
          ∃ (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
            (π_Y : Quiver.Hom Γ.left Y.left)
            (π_P : Quiver.Hom Γ.left P_ov.left)
            (j_Γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g)) Γ.left)
            (O_Y : Y.left.Opens),
            WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y W hW ψ_w g
              Γ π_Y π_P U_g iso_Ug j_Γ j_Y ∧
            (O_Y : Set ↥Y.left) = Set.range j_Y.base ∧
            Nonempty ↥O_Y ∧
            (TopologicalSpace.Opens.map π_Y.base).obj O_Y =
              (TopologicalSpace.Opens.map π_P.base).obj U_g ∧
            CategoryTheory.IsIso (π_Y ∣_ O_Y) := by
    intro Y hIntY _ hDimY W hW hNe A_W kAlgW w hw g hg m_w _ ψ_w B_g A_g ψ_g
      M _ _ bM eM heM
    let : Algebra k A_W := kAlgW
    have : IsDomain A_W := ((hGeom1 Y hIntY hDimY).1 W hW hNe).1
    obtain ⟨_, _, hDom_Ag0, hTrdeg_Ag0⟩ := hAlg1 A_W w hw g hg
    have : IsDomain A_g := hDom_Ag0
    have hTrdeg_Ag : Algebra.trdeg k A_g = (d : Cardinal.{u}) := hTrdeg_Ag0
    have : AlgebraicGeometry.IsOpenImmersion
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_g))) ι_d) := hOpen_ug g
    let u_P := CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_g))) ι_d
    let U_g : P_ov.left.Opens := u_P.opensRange
