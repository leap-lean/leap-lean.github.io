              (heM : ∀ b m, eM (b • m) = Localization.awayMap ψ_w g b * eM m)
              (Γ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (π_Y : Quiver.Hom Γ.left Y.left)
              (π_P : Quiver.Hom Γ.left Pd.left)
              (U_g : Pd.left.Opens)
              (iso_Ug : CategoryTheory.Iso U_g.toScheme
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))))
              (j_Γ : Quiver.Hom
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Γ.left)
              (j_Y : Quiver.Hom
                (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_w g)))) Y.left)
              (hRoof : WeilTopDegKummerIsChartGraphRoof k d Pd ι_d_main Y W hW ψ_w g
                Γ π_Y π_P U_g iso_Ug j_Γ j_Y),
              letI : AlgebraicGeometry.IsProper Γ.hom := hRoof.1
              let hProps := (hGeom2 Y hIntY hDimY W hW hNe w hw g hg m_w hm_w M bM eM heM).1
                Γ π_Y π_P U_g iso_Ug j_Γ j_Y hRoof
              let V_Γ : Γ.left.Opens := (TopologicalSpace.Opens.map π_P.base).obj U_g
              let hDim_Γ := (hGeom1 Γ hRoof.2.1 hRoof.2.2.1).2 V_Γ hProps.1
              ∀ (p_Y : weilEtaleTorsionH Y.left n (2 * d) →+ weilEtaleTorsionH Γ.left n (2 * d)),
                WeilIsTorsionEtalePullback π_Y n (2 * d) p_Y →
                ∀ (α : weilEtaleTorsionH Y.left n (2 * d)),
                  F_push Y hIntY hDimY W hW hNe w hw α =
                    zbPush Γ Pd π_P hRoof.2.2.2.2.1 m_w hm_w U_g V_Γ rfl hProps.2 hDim_Γ
                      (p_Y α) :=
    ⟨fun Y hIntY _ hDimY W hW hNe w hw =>
       Classical.choose (hF_pointwise Y hIntY hDimY W hW hNe w hw),
     fun Y hIntY _ hDimY W hW hNe w hw =>
       Classical.choose_spec (hF_pointwise Y hIntY hDimY W hW hNe w hw)⟩
  clear hF_pointwise

  
  have h_std_coords : ∀ (P₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι_d : Quiver.Hom (weilAffineSpaceOver k d).left P₀.left)
      (hOpen : AlgebraicGeometry.IsOpenImmersion ι_d)
      (_ : CategoryTheory.CategoryStruct.comp ι_d P₀.hom = (weilAffineSpaceOver k d).hom),
      letI := hOpen
      let W₀ : P₀.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_d
      let kAlg₀ : Algebra k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE P₀.hom ⊤ W₀ le_top)))
      AlgebraicGeometry.IsAffineOpen W₀ ∧
      Nonempty ↥W₀ ∧
      ∃ x₀ : Fin d → ↑(P₀.left.presheaf.obj (Opposite.op W₀)),
        (∀ i : Fin d,
          (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appLE ι_d W₀ ⊤ (fun x _ => ⟨x, rfl⟩))
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom))
            (x₀ i) = MvPolynomial.X i) ∧
        (∀ θ : R₀ ≃ₐ[k] R₀,
          @IsTranscendenceBasis (Fin d) k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ kAlg₀
            (fun i : Fin d =>
              @MvPolynomial.aeval k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) (Fin d) _ _ kAlg₀
                x₀ (θ (MvPolynomial.X i)))) ∧
        (∀ x₀' : Fin d → ↑(P₀.left.presheaf.obj (Opposite.op W₀)),
          (∀ i : Fin d,
            (CommRingCat.Hom.hom
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.Hom.appLE ι_d W₀ ⊤ (fun x _ => ⟨x, rfl⟩))
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom))
              (x₀' i) = MvPolynomial.X i) →
          x₀' = x₀) := by
    intro P₀ ι_d hOpen h_ov
    have : AlgebraicGeometry.IsOpenImmersion ι_d := hOpen
    let W₀ : P₀.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_d
    let kAlg₀ : Algebra k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) :=
      RingHom.toAlgebra (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appLE P₀.hom ⊤ W₀ le_top)))
    have : AlgebraicGeometry.IsAffine (weilAffineSpaceOver k d).left := by
      change AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of R₀))
      infer_instance
    have hAff₀ : AlgebraicGeometry.IsAffineOpen W₀ :=
      AlgebraicGeometry.isAffineOpen_opensRange ι_d
    have hNe_Spec : Nonempty ↥(weilAffineSpaceOver k d).left := by
      change Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀))
      infer_instance
    obtain ⟨pt_aff⟩ := hNe_Spec
    have hNe₀ : Nonempty ↥W₀ := ⟨⟨ι_d.base pt_aff, ⟨pt_aff, rfl⟩⟩⟩
    let A_spec : AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Spec (CommRingCat.of R₀)
    let ι_d_std : A_spec ⟶ P₀.left := ι_d
    have : AlgebraicGeometry.IsOpenImmersion ι_d_std := hOpen
    let e_sch : A_spec ≅ W₀.toScheme := ι_d_std.isoOpensRange
    let e_ι_app : P₀.left.presheaf.obj (Opposite.op W₀) ≅
        W₀.toScheme.presheaf.obj (Opposite.op ⊤) :=
      CategoryTheory.asIso
        (AlgebraicGeometry.Scheme.Hom.appLE W₀.ι W₀ ⊤ (fun x _ => x.2))
    let e_appTop : W₀.toScheme.presheaf.obj (Opposite.op ⊤) ≅
        A_spec.presheaf.obj (Opposite.op ⊤) :=
      { hom := e_sch.hom.appTop
        inv := e_sch.inv.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    let Φ_ring : P₀.left.presheaf.obj (Opposite.op W₀) ≅ CommRingCat.of R₀ :=
      e_ι_app ≪≫ e_appTop ≪≫ AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)
    have h_appLE_congr : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}
        {O₂ : Z₂.Opens} {O₁ : Z₁.Opens}
        (g₁ g₂ : Z₁ ⟶ Z₂), g₁ = g₂ →
        ∀ (h₁ : O₁ ≤ (TopologicalSpace.Opens.map g₁.base).obj O₂)
          (h₂ : O₁ ≤ (TopologicalSpace.Opens.map g₂.base).obj O₂),
        g₁.appLE O₂ O₁ h₁ = g₂.appLE O₂ O₁ h₂ := by
      rintro _ _ _ _ g₁ _ rfl _ _
      rfl
    have h_app_eq : e_ι_app.hom ≫ e_sch.hom.appTop =
        AlgebraicGeometry.Scheme.Hom.appLE ι_d W₀ ⊤ (fun x _ => ⟨x, rfl⟩) :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e_sch.hom W₀.ι W₀ ⊤ ⊤
        (fun x _ => x.2) (fun _ _ => trivial)).trans
        (h_appLE_congr (e_sch.hom ≫ W₀.ι) ι_d
          (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_d_std) _ _)
    have hΦ_hom_eq : Φ_ring.hom =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Hom.appLE ι_d W₀ ⊤ (fun x _ => ⟨x, rfl⟩))
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom :=
      (CategoryTheory.Category.assoc e_ι_app.hom e_sch.hom.appTop
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom).symm.trans
        (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) h_app_eq)
    have hΦ_k_comm : ∀ c : k,
        Φ_ring.inv.hom (algebraMap k R₀ c) =
          @algebraMap k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ kAlg₀ c := by
      intro c
      have h_fwd : Φ_ring.hom.hom
          (@algebraMap k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ kAlg₀ c) =
          algebraMap k R₀ c := by
        let specC : A_spec ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀))
        have h_comp1 : P₀.hom.appLE ⊤ W₀ le_top ≫
            ι_d.appLE W₀ ⊤ (fun x _ => ⟨x, rfl⟩) =
            specC.appTop :=
          (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_d P₀.hom ⊤ W₀ ⊤
            (fun _ _ => trivial) (fun x _ => ⟨x, rfl⟩)).trans
            (h_appLE_congr (O₂ := ⊤) (O₁ := ⊤) (ι_d ≫ P₀.hom) specC h_ov
              (fun _ _ => trivial) (fun _ _ => trivial))
        have h_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (specC.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) =
            CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) :=
          (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
            (AlgebraicGeometry.Scheme.ΓSpecIso_naturality
              (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀)))).trans
            (CategoryTheory.Iso.inv_hom_id_assoc _ _)
        have h_hom_chain : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            P₀.hom.appLE ⊤ W₀ le_top) ≫ Φ_ring.hom =
            CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) := by
          rw [hΦ_hom_eq]
          calc
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                P₀.hom.appLE ⊤ W₀ le_top) ≫
              (AlgebraicGeometry.Scheme.Hom.appLE ι_d W₀ ⊤ (fun x _ => ⟨x, rfl⟩) ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom)
              = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  ((P₀.hom.appLE ⊤ W₀ le_top ≫
                    ι_d.appLE W₀ ⊤ (fun x _ => ⟨x, rfl⟩)) ≫
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) :=
                (CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
                    (CategoryTheory.Category.assoc _ _ _).symm)
            _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                  (specC.appTop ≫
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom) :=
                congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
                  (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom)
                    h_comp1)
            _ = CommRingCat.ofHom (MvPolynomial.C : k →+* R₀) := h_nat
        exact congrArg (fun ψ => ψ.hom c) h_hom_chain
      calc
        Φ_ring.inv.hom (algebraMap k R₀ c)
          = Φ_ring.inv.hom (Φ_ring.hom.hom
              (@algebraMap k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ kAlg₀ c)) := by
            rw [h_fwd]
        _ = (Φ_ring.hom ≫ Φ_ring.inv).hom
              (@algebraMap k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ kAlg₀ c) := rfl
        _ = @algebraMap k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ kAlg₀ c := by
            rw [Φ_ring.hom_inv_id]; rfl
    let e_aff : @AlgEquiv k R₀ ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ _ _ kAlg₀ :=
      letI : Algebra k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) := kAlg₀
      AlgEquiv.ofRingEquiv (f := Φ_ring.symm.commRingCatIsoToRingEquiv) hΦ_k_comm
    let x₀ : Fin d → ↑(P₀.left.presheaf.obj (Opposite.op W₀)) :=
      fun i => e_aff (MvPolynomial.X i)
    have hx₀_app : ∀ i : Fin d,
        (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Hom.appLE ι_d W₀ ⊤ (fun x _ => ⟨x, rfl⟩))
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom))
          (x₀ i) = MvPolynomial.X i := by
      intro i
      rw [← hΦ_hom_eq]
      change (Φ_ring.inv ≫ Φ_ring.hom).hom (MvPolynomial.X i) = MvPolynomial.X i
      rw [Φ_ring.inv_hom_id]
      rfl
    have htb_θ : ∀ θ : R₀ ≃ₐ[k] R₀,
        @IsTranscendenceBasis (Fin d) k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) _ _ kAlg₀
          (fun i : Fin d =>
            @MvPolynomial.aeval k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) (Fin d) _ _ kAlg₀
              x₀ (θ (MvPolynomial.X i))) := by
      let : Algebra k ↑(P₀.left.presheaf.obj (Opposite.op W₀)) := kAlg₀
      have h_alg : MvPolynomial.aeval x₀ = e_aff.toAlgHom := by
        apply MvPolynomial.algHom_ext
        intro i
        exact MvPolynomial.aeval_X x₀ i
      have htb_X : IsTranscendenceBasis k (MvPolynomial.X : Fin d → R₀) :=
        IsTranscendenceBasis.mvPolynomial (Fin d) k
      intro θ
      have h_eq : (fun i : Fin d => MvPolynomial.aeval x₀ (θ (MvPolynomial.X i))) =
          (⇑(θ.trans e_aff) ∘ (MvPolynomial.X : Fin d → R₀)) := by
        ext i
        exact AlgHom.congr_fun h_alg (θ (MvPolynomial.X i))
      rw [h_eq]
      exact (θ.trans e_aff).isTranscendenceBasis htb_X
    have hx₀_uniq : ∀ x₀' : Fin d → ↑(P₀.left.presheaf.obj (Opposite.op W₀)),
        (∀ i : Fin d,
          (CommRingCat.Hom.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Hom.appLE ι_d W₀ ⊤ (fun x _ => ⟨x, rfl⟩))
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom))
            (x₀' i) = MvPolynomial.X i) →
        x₀' = x₀ := by
      intro x₀' hx₀'
      funext i
      have h_eq_img : Φ_ring.hom.hom (x₀' i) = Φ_ring.hom.hom (x₀ i) := by
        rw [hΦ_hom_eq]
        exact (hx₀' i).trans (hx₀_app i).symm
      calc
        x₀' i = (Φ_ring.hom ≫ Φ_ring.inv).hom (x₀' i) := by
          rw [Φ_ring.hom_inv_id]; rfl
        _ = Φ_ring.inv.hom (Φ_ring.hom.hom (x₀' i)) := rfl
        _ = Φ_ring.inv.hom (Φ_ring.hom.hom (x₀ i)) := by rw [h_eq_img]
        _ = (Φ_ring.hom ≫ Φ_ring.inv).hom (x₀ i) := rfl
        _ = x₀ i := by rw [Φ_ring.hom_inv_id]; rfl
    exact ⟨hAff₀, hNe₀, x₀, hx₀_app, htb_θ, hx₀_uniq⟩

  let W_aff : Pd.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_d_main
  let kAlgP : Algebra k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) :=
    RingHom.toAlgebra (CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (AlgebraicGeometry.Scheme.Hom.appLE Pd.hom ⊤ W_aff le_top)))
  obtain ⟨hAff_P, hNe_P, x_std, hx_std_app, htb_θ, hx_std_uniq⟩ :=
    h_std_coords Pd ι_d_main hOpen_d h_over_d
  clear h_std_coords

  obtain ⟨A_aut, hA_aut_def⟩ :
      ∃ A_aut : (R₀ ≃ₐ[k] R₀) →
          (weilEtaleTorsionH Pd.left n (2 * d) →+ weilEtaleTorsionH Pd.left n (2 * d)),
        ∀ θ : R₀ ≃ₐ[k] R₀,
          A_aut θ = F_push Pd hIntP hDimP W_aff hAff_P hNe_P _ (htb_θ θ) :=
    ⟨fun θ => F_push Pd hIntP hDimP W_aff hAff_P hNe_P _ (htb_θ θ),
     fun _ => rfl⟩

  have hIso_id_res : ∀ (S : AlgebraicGeometry.Scheme.{u}) (O : S.Opens),
      CategoryTheory.IsIso ((CategoryTheory.CategoryStruct.id S) ∣_ O) :=
    fun _ _ => inferInstance

  have hF_w_congr : ∀ {w₁ w₂ : Fin d → ↑(Pd.left.presheaf.obj (Opposite.op W_aff))}
      (_ : w₁ = w₂)
      (hw₁ : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgP w₁)
      (hw₂ : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgP w₂),
      F_push Pd hIntP hDimP W_aff hAff_P hNe_P w₁ hw₁ =
        F_push Pd hIntP hDimP W_aff hAff_P hNe_P w₂ hw₂ := by
    rintro w₁ _ rfl _ _
    rfl

  have hA_id : A_aut (AlgEquiv.refl : R₀ ≃ₐ[k] R₀) = AddMonoidHom.id _ := by
    obtain ⟨M_id, hAdd_id, hMod_id, bM_id, eM_id, iso_U1, j_Γ1, j_Y1, heM_id, hRoof_id⟩ :=
      (hGeom5 hAff_P hNe_P x_std hx_std_app).1
    let : AddCommGroup M_id := hAdd_id
    let : Module (Localization.Away (1 : R₀)) M_id := hMod_id
    have hx_refl : (fun i : Fin d =>
        @MvPolynomial.aeval k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) (Fin d) _ _ kAlgP
          x_std ((AlgEquiv.refl : R₀ ≃ₐ[k] R₀) (MvPolynomial.X i))) = x_std := by
      let : Algebra k ↑(Pd.left.presheaf.obj (Opposite.op W_aff)) := kAlgP
      funext i
      exact MvPolynomial.aeval_X x_std i
    have htb_std : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgP x_std := by
      rw [← hx_refl]; exact htb_θ AlgEquiv.refl
    have hF_congr : A_aut AlgEquiv.refl =
        F_push Pd hIntP hDimP W_aff hAff_P hNe_P x_std htb_std := by
      rw [hA_aut_def AlgEquiv.refl]
      exact hF_w_congr hx_refl (htb_θ AlgEquiv.refl) htb_std
    rw [hF_congr]
    ext α
    have hp_id : WeilIsTorsionEtalePullback
        (CategoryTheory.CategoryStruct.id Pd.left) n (2 * d) (AddMonoidHom.id _) := by
      have heq := hPullId n (2 * d) (pullH (CategoryTheory.CategoryStruct.id Pd.left))
        (hpullH (CategoryTheory.CategoryStruct.id Pd.left))
      exact heq ▸ hpullH (CategoryTheory.CategoryStruct.id Pd.left)
    rw [F_push_eq_roof Pd hIntP hDimP W_aff hAff_P hNe_P x_std htb_std
      1 one_ne_zero 1 le_rfl M_id bM_id eM_id heM_id
      Pd (CategoryTheory.CategoryStruct.id Pd.left) (CategoryTheory.CategoryStruct.id Pd.left)
      W_aff iso_U1 j_Γ1 j_Y1 hRoof_id (AddMonoidHom.id _) hp_id α]
    exact (zbPush_birat Pd Pd (CategoryTheory.CategoryStruct.id Pd.left)
      hRoof_id.2.2.2.2.1 W_aff ((TopologicalSpace.Opens.map
        (CategoryTheory.CategoryStruct.id Pd.left).base).obj W_aff) rfl
      (hIso_id_res Pd.left W_aff)
      ((hGeom2 Pd hIntP hDimP W_aff hAff_P hNe_P x_std htb_std
        1 one_ne_zero 1 le_rfl M_id bM_id eM_id heM_id).1
        Pd _ _ W_aff iso_U1 j_Γ1 j_Y1 hRoof_id).2
      ((hGeom1 Pd hIntP hDimP).2 _
        ((hGeom2 Pd hIntP hDimP W_aff hAff_P hNe_P x_std htb_std
          1 one_ne_zero 1 le_rfl M_id bM_id eM_id heM_id).1
          Pd _ _ W_aff iso_U1 j_Γ1 j_Y1 hRoof_id).1)
      ((hGeom1 Pd hIntP hDimP).2 W_aff hNe_P)
      (AddMonoidHom.id _) hp_id).1 α

  have hA_nat : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (hIntY : AlgebraicGeometry.IsIntegral Y.left)
      [AlgebraicGeometry.IsProper Y.hom]
      (hDimY : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
      (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W),
      let kAlgW : Algebra k ↑(Y.left.presheaf.obj (Opposite.op W)) :=
        RingHom.toAlgebra (CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
      ∀ (w : Fin d → ↑(Y.left.presheaf.obj (Opposite.op W)))
        (hw : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgW w)
        (θ : R₀ ≃ₐ[k] R₀)
        (hwθ : @IsTranscendenceBasis (Fin d) k _ _ _ kAlgW
          (fun i => @MvPolynomial.aeval k ↑(Y.left.presheaf.obj (Opposite.op W)) (Fin d)
            _ _ kAlgW w (θ (MvPolynomial.X i)))),
        F_push Y hIntY hDimY W hW hNe _ hwθ =
