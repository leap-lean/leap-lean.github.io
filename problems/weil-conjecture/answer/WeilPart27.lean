      (U_g : Set ↥P_d.left) = (U_g₀ : Set ↥P_d.left) ∩ π₁.base ⁻¹' (O_m : Set ↥P_m.left) := by
    intro g g₀ hgg₀ U_g U_g₀
    have h_rd : ∀ f : R₀,
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (Localization.Away f))) ≫ ι_d').opensRange :
          Set ↥P_d.left) =
        ι_d'.base '' (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R₀)) := by
