        let c₁ : Aℤ ⟶ Z.obj.obj (Opposite.op U) := zHom _ ((h₁.hom.app (Opposite.op U)).hom z)
        let c₂ : Aℤ ⟶ Z.obj.obj (Opposite.op U) := zHom _ ((h₂.hom.app (Opposite.op U)).hom z)
