              rw [Homeomorph.preimage_symm]
              exact (h_open_preirred hF₁_irr.isPreirreducible (U_cov α).isOpen).image _
                e_specα.continuous.continuousOn⟩
          isClosed' := (hF₁_cl.preimage continuous_subtype_val).preimage e_specα.symm.continuous }
      have hH_lt : H₀ < H₁ := by
        apply lt_of_le_of_ne (fun q hq => le_of_lt hF_lt hq)
        intro heq
        have hF_sub : F₁_Z₀ ⊆ F₀_Z₀ ∪ (U_cov α : Set ↥Z₀_ov.left)ᶜ := by
          intro w hw
          by_cases hwU : w ∈ U_cov α
