      let e_A₀_Top :
          (@AlgEquiv k A₀ ↑(S₀.presheaf.obj (Opposite.op ⊤)) _ _ _ _ algTop) :=
        @AlgEquiv.ofRingEquiv k A₀ _ _ _ _ _ algTop
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A₀)).symm.commRingCatIsoToRingEquiv
          (fun _ => rfl)
      have h_tr_Top_A₀ :
          @Algebra.trdeg k ↑(S₀.presheaf.obj (Opposite.op ⊤)) _ _ algTop =
            Algebra.trdeg k A₀ :=
        (@AlgEquiv.trdeg_eq k A₀ _ _ _ _ _ algTop e_A₀_Top).symm
      rw [h_tr_WU', h_tr_U'_U'', h_tr_U''_B₀, h_tr_B₀_Top, h_tr_Top_A₀, htrA₀]
    letI : Algebra k A_W := kAlgW
    haveI : IsDomain A_W := hDomW
    haveI : Algebra.FiniteType k A_W := hFtW
    have h_rkd : ringKrullDim A_W = (d : WithBot ℕ∞) := h_noether_dim A_W htrW
    let homeo_W : ↥W ≃ₜ PrimeSpectrum A_W :=
      TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso hW.isoSpec)
    rw [IsHomeomorph.topologicalKrullDim_eq homeo_W homeo_W.isHomeomorph,
      PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, h_rkd]
  · intro hd X hIntX hDimX O ⟨x₀, hx₀⟩
    haveI : AlgebraicGeometry.IsIntegral X := hIntX
