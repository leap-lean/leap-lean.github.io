    exact @h_compl_dim_le Γ.left hIrred_Γ m hDimΓ_m V_12_0 hNe_V12_0

  
  let h_Z₀ : Z₀_ov.left ⟶ P_m.left := I_Z₀.subschemeι ≫ h_Wf
  have hh_Z₀_ov : h_Z₀ ≫ P_m.hom = Z₀_ov.hom := by
    dsimp [h_Z₀, Z₀_ov]
    rw [CategoryTheory.Category.assoc, hh_Wf_ov]
  have : AlgebraicGeometry.IsProper h_Z₀ := by
    have : AlgebraicGeometry.IsProper (h_Z₀ ≫ P_m.hom) := by rw [hh_Z₀_ov]; infer_instance
    exact AlgebraicGeometry.IsProper.of_comp h_Z₀ P_m.hom
  let W_m : P_m.left.Opens := ι_m'.opensRange
  have hAff_Wm : AlgebraicGeometry.IsAffineOpen W_m := AlgebraicGeometry.isAffineOpen_opensRange ι_m'
  let Z_0m : Z₀_ov.left.Opens := (TopologicalSpace.Opens.map h_Z₀.base).obj W_m
  have hComp_Z0m : IsCompact (Z_0m : Set ↥Z₀_ov.left) :=
    AlgebraicGeometry.QuasiCompact.isCompact_preimage (f := h_Z₀) (W_m : Set ↥P_m.left)
      W_m.isOpen hAff_Wm.isCompact
  have h_aff_nhd : ∀ z : ↥Z_0m, ∃ U : Z₀_ov.left.Opens,
      AlgebraicGeometry.IsAffineOpen U ∧ z.1 ∈ U ∧ U ≤ Z_0m :=
    fun z => AlgebraicGeometry.exists_isAffineOpen_mem_and_subset z.2
  choose U_pt hAff_pt hmem_pt hle_pt using h_aff_nhd
  obtain ⟨S_cov, hS_cov⟩ := hComp_Z0m.elim_finite_subcover
    (fun z : ↥Z_0m => (U_pt z : Set ↥Z₀_ov.left))
    (fun z => (U_pt z).isOpen)
    (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hmem_pt ⟨x, hx⟩⟩)
  let r_cov : ℕ := S_cov.card
  let e_cov : Fin r_cov ≃ ↥S_cov := S_cov.equivFin.symm
  let U_cov : Fin r_cov → Z₀_ov.left.Opens := fun α => U_pt (e_cov α).1
  have hAff_cov : ∀ α : Fin r_cov, AlgebraicGeometry.IsAffineOpen (U_cov α) :=
    fun α => hAff_pt (e_cov α).1
  let C_cov : Fin r_cov → Type u := fun α => ↑(Z₀_ov.left.presheaf.obj (Opposite.op (U_cov α)))
  let algC : ∀ α : Fin r_cov, Algebra k (C_cov α) := fun α =>
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE Z₀_ov.hom ⊤ (U_cov α) le_top).hom.toAlgebra
  let _ : ∀ α : Fin r_cov, Algebra k (C_cov α) := algC
  have hFT_cov : ∀ α : Fin r_cov, Algebra.FiniteType k (C_cov α) := by
    intro α
    have h1 : RingHom.FiniteType
        (AlgebraicGeometry.Scheme.Hom.appLE Z₀_ov.hom ⊤ (U_cov α) le_top).hom :=
      Z₀_ov.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_k) (hAff_cov α) le_top
    have h2 : RingHom.FiniteType
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
