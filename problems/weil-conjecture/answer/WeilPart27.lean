          CategoryTheory.IsPushout
            (CommRingCat.ofHom g_A) (CommRingCat.ofHom π)
            (CommRingCat.ofHom π_B) (CommRingCat.ofHom f_Z) := by
      intro A A_Z B_Z_ring _ _ _ π hπ_surj f_Z hf_et
      let _ : Algebra A_Z B_Z_ring := f_Z.toAlgebra
      have : Algebra.Etale A_Z B_Z_ring := RingHom.etale_algebraMap.mp hf_et
      have hStd₀ : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z_ring :=
        Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
      rcases hStd₀.out with ⟨ι₀, σ₀, hFin_σ, hFin_ι, P₀, hdim₀⟩
      obtain ⟨n_v, ⟨e_ι⟩⟩ := @Finite.exists_equiv_fin ι₀ hFin_ι
      obtain ⟨n_r, ⟨e_σ⟩⟩ := @Finite.exists_equiv_fin σ₀ hFin_σ
      let P_Z : Algebra.SubmersivePresentation A_Z B_Z_ring (Fin n_v) (Fin n_r) :=
        P₀.reindex e_ι.symm e_σ.symm
      have hcard_ι : Nat.card ι₀ = n_v := (Nat.card_congr e_ι).trans (Nat.card_fin n_v)
      have hcard_σ : Nat.card σ₀ = n_r := (Nat.card_congr e_σ).trans (Nat.card_fin n_r)
      have hdim_sub : n_v - n_r = 0 := by
        change Nat.card ι₀ - Nat.card σ₀ = 0 at hdim₀
        rwa [hcard_ι, hcard_σ] at hdim₀
      choose rel_A hrel_A using fun c : Fin n_r =>
        MvPolynomial.map_surjective π hπ_surj (P_Z.relation c)
      let I_A : Ideal (MvPolynomial (Fin n_v) A) := Ideal.span (Set.range rel_A)
      let Q_A : Type u := MvPolynomial (Fin n_v) A ⧸ I_A
      let P_Q : Algebra.PreSubmersivePresentation A Q_A (Fin n_v) (Fin n_r) :=
        Algebra.PreSubmersivePresentation.naive (v := rel_A) P_Z.map P_Z.map_inj
      let j_Q : Q_A := P_Q.jacobian
      let B_A : Type u := Localization.Away j_Q
      let g_A : A →+* B_A := algebraMap A B_A
      let Q_loc : Algebra.PreSubmersivePresentation Q_A B_A Unit Unit :=
        Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
      let P_tot : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ Fin n_v) (Unit ⊕ Fin n_r) :=
        Q_loc.comp P_Q
      have hUnit_jQ : IsUnit (algebraMap Q_A B_A j_Q) := IsLocalization.Away.algebraMap_isUnit j_Q
      have hUnit_tot : IsUnit P_tot.jacobian := by
        dsimp only [P_tot]
        rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
          Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
        exact hUnit_jQ.mul hUnit_jQ
      let P_sub_tot : Algebra.SubmersivePresentation A B_A (Unit ⊕ Fin n_v) (Unit ⊕ Fin n_r) :=
        { __ := P_tot, jacobian_isUnit := hUnit_tot }
      have hdim_tot : P_sub_tot.dimension = 0 := by
        change (Q_loc.comp P_Q).dimension = 0
        rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension]
        have hd₁ : Q_loc.dimension = 0 := by change Nat.card Unit - Nat.card Unit = 0; omega
        have hd₂ : P_Q.dimension = 0 := by
          change Nat.card (Fin n_v) - Nat.card (Fin n_r) = 0
          rw [Nat.card_fin, Nat.card_fin]
          exact hdim_sub
        omega
      have hStd_A : Algebra.IsStandardSmoothOfRelativeDimension 0 A B_A :=
        ⟨⟨Unit ⊕ Fin n_v, Unit ⊕ Fin n_r, inferInstance, inferInstance, P_sub_tot, hdim_tot⟩⟩
      have hg_et : RingHom.Etale g_A :=
        RingHom.etale_algebraMap.mpr (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hStd_A)
      let aeval_Z : MvPolynomial (Fin n_v) A_Z →+* B_Z_ring := (MvPolynomial.aeval P_Z.val).toRingHom
      have hker_Z : Ideal.span (Set.range P_Z.relation) = RingHom.ker aeval_Z := by
        have hspan := P_Z.span_range_relation_eq_ker
        have halg : algebraMap P_Z.Ring B_Z_ring = aeval_Z :=
          RingHom.ext (fun x => P_Z.algebraMap_apply x)
        exact hspan.trans (congrArg RingHom.ker halg)
      let φ_poly : MvPolynomial (Fin n_v) A →+* B_Z_ring := aeval_Z.comp (MvPolynomial.map π)
      have hI_le_ker : I_A ≤ RingHom.ker φ_poly := by
        rw [Ideal.span_le]
        rintro _ ⟨c, rfl⟩
        change aeval_Z (MvPolynomial.map π (rel_A c)) = 0
        rw [hrel_A c]
        have hmem : P_Z.relation c ∈ RingHom.ker aeval_Z := by
          rw [← hker_Z]
          exact Ideal.subset_span ⟨c, rfl⟩
        exact hmem
      let q₀ : Q_A →+* B_Z_ring := Ideal.Quotient.lift I_A φ_poly hI_le_ker
      have hq₀_jQ : q₀ j_Q = P_Z.jacobian := by
        dsimp only [j_Q]
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
          Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
          P_Z.algebraMap_apply]
        change aeval_Z ((MvPolynomial.map π) P_Q.jacobiMatrix.det) = aeval_Z P_Z.jacobiMatrix.det
        congr 1
        rw [RingHom.map_det]
        congr 1
        refine Matrix.ext (fun i j => ?_)
        change MvPolynomial.map π (P_Q.jacobiMatrix i j) = P_Z.jacobiMatrix i j
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
          Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        have hmap_eq : P_Q.map i = P_Z.map i := rfl
        have hrel_eq : P_Q.relation j = rel_A j := rfl
        rw [hmap_eq, hrel_eq, ← MvPolynomial.pderiv_map, hrel_A j]
      have hUnit_q₀ : IsUnit (q₀ j_Q) := by rw [hq₀_jQ]; exact P_Z.jacobian_isUnit
      let π_B : B_A →+* B_Z_ring := IsLocalization.Away.lift j_Q hUnit_q₀
      have hπB_q₀ : π_B.comp (algebraMap Q_A B_A) = q₀ :=
        RingHom.ext (fun x => IsLocalization.Away.lift_eq j_Q hUnit_q₀ x)
      have hπB_comm : π_B.comp g_A = f_Z.comp π := by
        ext a
        change π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a))) = f_Z (π a)
        have h1 := RingHom.congr_fun hπB_q₀ (Ideal.Quotient.mk I_A (MvPolynomial.C a))
        rw [RingHom.comp_apply] at h1
        rw [h1]
        change (MvPolynomial.aeval P_Z.val) (MvPolynomial.map π (MvPolynomial.C a)) = f_Z (π a)
        rw [MvPolynomial.map_C]
        exact MvPolynomial.aeval_C P_Z.val (π a)
      have hπB_surj : Function.Surjective π_B := by
        intro b
        obtain ⟨p_Z, hp_Z⟩ := P_Z.aeval_val_surjective b
        obtain ⟨p_A, hp_A⟩ := MvPolynomial.map_surjective π hπ_surj p_Z
        refine ⟨algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A), ?_⟩
        have h1 := RingHom.congr_fun hπB_q₀ (Ideal.Quotient.mk I_A p_A)
        rw [RingHom.comp_apply] at h1
        rw [h1]
        change aeval_Z (MvPolynomial.map π p_A) = b
        rw [hp_A]
        exact hp_Z
      have hcomm_cat : CommRingCat.ofHom g_A ≫ CommRingCat.ofHom π_B =
          CommRingCat.ofHom π ≫ CommRingCat.ofHom f_Z := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hπB_comm]
      let e_quot : (MvPolynomial (Fin n_v) A_Z ⧸ RingHom.ker aeval_Z) ≃+* B_Z_ring :=
        RingHom.quotientKerEquivOfSurjective P_Z.aeval_val_surjective
      have he_quot_symm : ∀ p_Z : MvPolynomial (Fin n_v) A_Z,
          e_quot.symm (aeval_Z p_Z) = Ideal.Quotient.mk (RingHom.ker aeval_Z) p_Z := by
        intro p_Z
        apply e_quot.injective
        rw [e_quot.apply_symm_apply]
        rfl
      have hdesc_cone : ∀ (s : CategoryTheory.Limits.PushoutCocone (CommRingCat.ofHom g_A) (CommRingCat.ofHom π)),
          ∃ w : B_Z_ring →+* ↑s.pt,
            w.comp π_B = s.inl.hom ∧ w.comp f_Z = s.inr.hom := by
        intro s
        let u₁ : B_A →+* ↑s.pt := s.inl.hom
        let u₂ : A_Z →+* ↑s.pt := s.inr.hom
        have hu_comm : u₁.comp g_A = u₂.comp π := congrArg CommRingCat.Hom.hom s.condition
        let x_R : Fin n_v → ↑s.pt :=
          fun i => u₁ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.X i)))
        let ψ_R : MvPolynomial (Fin n_v) A_Z →+* ↑s.pt := MvPolynomial.eval₂Hom u₂ x_R
        have hψ_map : ψ_R.comp (MvPolynomial.map π) =
            u₁.comp ((algebraMap Q_A B_A).comp (Ideal.Quotient.mk I_A)) := by
          apply MvPolynomial.ringHom_ext'
          · ext a
            change ψ_R (MvPolynomial.map π (MvPolynomial.C a)) = u₁ (g_A a)
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            exact (RingHom.congr_fun hu_comm a).symm
          · intro i
            change ψ_R (MvPolynomial.map π (MvPolynomial.X i)) = x_R i
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        have hker_le : RingHom.ker aeval_Z ≤ RingHom.ker ψ_R := by
          rw [← hker_Z, Ideal.span_le]
          rintro _ ⟨c, rfl⟩
          change ψ_R (P_Z.relation c) = 0
          rw [← hrel_A c]
          have h1 := RingHom.congr_fun hψ_map (rel_A c)
          rw [RingHom.comp_apply] at h1
          rw [h1]
          have hmk0 : Ideal.Quotient.mk I_A (rel_A c) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨c, rfl⟩)
          simp [hmk0]
        have hker_zero : ∀ a ∈ RingHom.ker aeval_Z, ψ_R a = 0 := fun _ ha => hker_le ha
        let w : B_Z_ring →+* ↑s.pt :=
          (Ideal.Quotient.lift (RingHom.ker aeval_Z) ψ_R hker_zero).comp e_quot.symm.toRingHom
        have hw_aeval : ∀ p_Z : MvPolynomial (Fin n_v) A_Z, w (aeval_Z p_Z) = ψ_R p_Z := by
          intro p_Z
          change Ideal.Quotient.lift (RingHom.ker aeval_Z) ψ_R hker_zero (e_quot.symm (aeval_Z p_Z)) =
            ψ_R p_Z
          rw [he_quot_symm p_Z]
          exact Ideal.Quotient.lift_mk (RingHom.ker aeval_Z) ψ_R hker_zero
        refine ⟨w, ?_, ?_⟩
        · apply IsLocalization.ringHom_ext (Submonoid.powers j_Q)
          rw [RingHom.comp_assoc, hπB_q₀]
          refine RingHom.ext (fun p_q => ?_)
          obtain ⟨p_A, rfl⟩ := Ideal.Quotient.mk_surjective p_q
          change w (aeval_Z (MvPolynomial.map π p_A)) =
            u₁ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A))
          rw [hw_aeval]
          exact RingHom.congr_fun hψ_map p_A
        · refine RingHom.ext (fun a_z => ?_)
          have hC : aeval_Z (MvPolynomial.C a_z) = f_Z a_z := MvPolynomial.aeval_C P_Z.val a_z
          change w (f_Z a_z) = u₂ a_z
          rw [← hC, hw_aeval, MvPolynomial.eval₂Hom_C]
      have hColim : CategoryTheory.Limits.IsColimit
          (CategoryTheory.Limits.PushoutCocone.mk (CommRingCat.ofHom π_B) (CommRingCat.ofHom f_Z) hcomm_cat) :=
        CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_cat
          (fun s => CommRingCat.ofHom (Classical.choose (hdesc_cone s)))
          (fun s => CommRingCat.Hom.ext (Classical.choose_spec (hdesc_cone s)).1)
          (fun s => CommRingCat.Hom.ext (Classical.choose_spec (hdesc_cone s)).2)
          (fun s m hm₁ _ => CommRingCat.Hom.ext (RingHom.ext fun b => by
            obtain ⟨a, rfl⟩ := hπB_surj b
            exact (congrArg (fun k : CommRingCat.of B_A ⟶ s.pt => k a) hm₁).trans
              (RingHom.congr_fun (Classical.choose_spec (hdesc_cone s)).1 a).symm))
      exact ⟨B_A, inferInstance, g_A, π_B, hg_et, { w := hcomm_cat, isColimit' := ⟨hColim⟩ }⟩

    have hEmptySheafSub : ∀ (𝒢 : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}) (W₀ : Z.Etale),
        IsEmpty ↥W₀.left → Subsingleton (𝒢.obj.obj (Opposite.op W₀)) := by
      intro 𝒢 W₀ hEmp
      have hF_type : CategoryTheory.Presieve.IsSheaf J_Z
          (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
        rw [← CategoryTheory.isSheaf_iff_isSheaf_of_type]
        exact CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J_Z 𝒢.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) 𝒢.property
      refine ⟨fun a b => ?_⟩
      have hbot : (⊥ : CategoryTheory.Sieve W₀) ∈ J_Z W₀ :=
        (hMemEtale W₀ ⊥).mpr (fun x => IsEmpty.elim hEmp x)
      obtain ⟨t₀, _, ht₀_uniq⟩ := (hF_type ⊥ hbot)
        (fun _ _ hf => False.elim hf)
        (fun _ _ _ _ _ _ _ hf₁ _ _ => False.elim hf₁)
      exact (ht₀_uniq a (fun _ _ hf => False.elim hf)).trans
        (ht₀_uniq b (fun _ _ hf => False.elim hf)).symm

    have hPresEpi : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}} (φ : 𝒢₁ ⟶ 𝒢₂)
        [CategoryTheory.Epi φ], CategoryTheory.Epi (P_push_Z.map φ) := by
      intro 𝒢₁ 𝒢₂ φ _
      have hSurj_Z : CategoryTheory.Sheaf.IsLocallySurjective φ :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} φ).mpr inferInstance
      have : CategoryTheory.Sheaf.IsLocallySurjective (P_push_Z.map φ) := by
        refine ⟨fun {U'} t => ?_⟩
        rw [hMemEtale]
        intro x
        let Z' : AlgebraicGeometry.Scheme.{u} := (B_Z.obj U').left
        let ι' : Z' ⟶ U'.left := CategoryTheory.Limits.pullback.fst U'.hom i_Z
        have : AlgebraicGeometry.IsClosedImmersion ι' :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback U'.hom i_Z).flip inferInstance
        have hCl : Topology.IsClosedEmbedding ι' := AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι'
        by_cases hx : x ∈ Set.range ι'
        · rcases hx with ⟨z₀, rfl⟩
          have hmem_Z : CategoryTheory.Presheaf.imageSieve φ.hom t ∈ J_Z (B_Z.obj U') :=
            hSurj_Z.imageSieve_mem t
          obtain ⟨W'_Z, g_Z, w₀, ⟨s₀, hs₀⟩, hg_et, hgw₀⟩ :=
            (hMemEtale (B_Z.obj U') _).mp hmem_Z z₀
          obtain ⟨_, ⟨U_aff, hU_aff, rfl⟩, hx_aff, -⟩ :=
            (AlgebraicGeometry.Scheme.isBasis_affineOpens U'.left).exists_subset_of_mem_open
              (Set.mem_univ (ι' z₀)) isOpen_univ
          let Z_aff : Z'.Opens := (TopologicalSpace.Opens.map ι'.base).obj U_aff
          have hZ_aff : AlgebraicGeometry.IsAffineOpen Z_aff :=
            AlgebraicGeometry.IsAffineHom.isAffine_preimage U_aff hU_aff
          have hz₀_aff : z₀ ∈ Z_aff := hx_aff
          let W_pre : W'_Z.left.Opens := (TopologicalSpace.Opens.map g_Z.left.base).obj Z_aff
          have hw₀_pre : w₀ ∈ W_pre := by
            change g_Z.left w₀ ∈ Z_aff
            rw [hgw₀]
            exact hz₀_aff
          obtain ⟨_, ⟨W_aff, hW_aff, rfl⟩, hw₀_aff, hW_sub⟩ :=
            (AlgebraicGeometry.Scheme.isBasis_affineOpens W'_Z.left).exists_subset_of_mem_open
              hw₀_pre W_pre.isOpen
          have hW_le : W_aff ≤ W_pre := hW_sub
          let A : Type u := ↑(U'.left.presheaf.obj (Opposite.op U_aff))
          let A_Z : Type u := ↑(Z'.presheaf.obj (Opposite.op Z_aff))
          let B_Z_ring : Type u := ↑(W'_Z.left.presheaf.obj (Opposite.op W_aff))
          let π_hom : U'.left.presheaf.obj (Opposite.op U_aff) ⟶ Z'.presheaf.obj (Opposite.op Z_aff) :=
            ι'.appLE U_aff Z_aff (le_refl _)
          have hπ_surj : Function.Surjective π_hom.hom := by
            dsimp only [π_hom]
            rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
            exact AlgebraicGeometry.Scheme.Hom.app_surjective ι' U_aff hU_aff
          let f_Z_hom : Z'.presheaf.obj (Opposite.op Z_aff) ⟶
              W'_Z.left.presheaf.obj (Opposite.op W_aff) :=
            g_Z.left.appLE Z_aff W_aff hW_le
          have hSpec_fZ : AlgebraicGeometry.Spec.map f_Z_hom ≫ hZ_aff.fromSpec = hW_aff.fromSpec ≫ g_Z.left :=
            hZ_aff.SpecMap_appLE_fromSpec g_Z.left hW_aff hW_le
          have : AlgebraicGeometry.IsOpenImmersion hZ_aff.fromSpec := hZ_aff.isOpenImmersion_fromSpec
          have : AlgebraicGeometry.IsOpenImmersion hW_aff.fromSpec := hW_aff.isOpenImmersion_fromSpec
          have hRHS_et : P_et (hW_aff.fromSpec ≫ g_Z.left) :=
            CategoryTheory.MorphismProperty.comp_mem P_et _ _ inferInstance hg_et
          have hSpec_et : P_et (AlgebraicGeometry.Spec.map f_Z_hom) := by
            rw [← hSpec_fZ] at hRHS_et
            exact @CategoryTheory.MorphismProperty.of_postcomp _ _ P_et P_et _ _ _ _
              (AlgebraicGeometry.Spec.map f_Z_hom) hZ_aff.fromSpec inferInstance hRHS_et
          have hf_Z_et : RingHom.Etale f_Z_hom.hom :=
            (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et) (φ := f_Z_hom)).mp hSpec_et
          obtain ⟨B_A, hCommBA, g_A, π_B, hg_A_et, hPush⟩ :=
            @hAffLift A A_Z B_Z_ring _ _ _ π_hom.hom hπ_surj f_Z_hom.hom hf_Z_et
          let _ : CommRing B_A := hCommBA
          have hPb_spec : CategoryTheory.IsPullback
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B))
              (AlgebraicGeometry.Spec.map f_Z_hom)
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_A))
              (AlgebraicGeometry.Spec.map π_hom) :=
            AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
          have hSpec_gA_et : P_et (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_A)) :=
            (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et) (φ := CommRingCat.ofHom g_A)).mpr hg_A_et
          have : AlgebraicGeometry.IsOpenImmersion hU_aff.fromSpec := hU_aff.isOpenImmersion_fromSpec
          let f_x_left : AlgebraicGeometry.Spec (CommRingCat.of B_A) ⟶ U'.left :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_A) ≫ hU_aff.fromSpec
          have hfx_et : P_et f_x_left :=
            CategoryTheory.MorphismProperty.comp_mem P_et _ _ hSpec_gA_et inferInstance
          let V_x : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f_x_left ≫ U'.hom)
            (CategoryTheory.MorphismProperty.comp_mem P_et _ _ hfx_et U'.prop)
          let f_x : V_x ⟶ U' := CategoryTheory.MorphismProperty.Over.homMk f_x_left rfl
          let w_spec : ↥(AlgebraicGeometry.Spec (CommRingCat.of B_Z_ring)) := hW_aff.isoSpec.hom ⟨w₀, hw₀_aff⟩
          let y₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of B_A)) :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) w_spec
          have hy₀_x : f_x_left y₀ = ι' z₀ := by
            have hSpec_π : AlgebraicGeometry.Spec.map π_hom ≫ hU_aff.fromSpec = hZ_aff.fromSpec ≫ ι' :=
              hU_aff.SpecMap_appLE_fromSpec ι' hZ_aff (le_refl _)
            have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫ f_x_left) w_spec =
                (AlgebraicGeometry.Scheme.Opens.ι W_aff ≫ g_Z.left ≫ ι') ⟨w₀, hw₀_aff⟩ := by
              dsimp only [f_x_left]
              rw [← CategoryTheory.Category.assoc, hPb_spec.w, CategoryTheory.Category.assoc, hSpec_π,
                ← CategoryTheory.Category.assoc, hSpec_fZ, CategoryTheory.Category.assoc]
              change ((hW_aff.isoSpec.hom ≫ hW_aff.fromSpec) ≫ g_Z.left ≫ ι') ⟨w₀, hw₀_aff⟩ = _
              rw [show hW_aff.isoSpec.hom ≫ hW_aff.fromSpec = AlgebraicGeometry.Scheme.Opens.ι W_aff from
                CategoryTheory.Iso.hom_inv_id_assoc hW_aff.isoSpec (AlgebraicGeometry.Scheme.Opens.ι W_aff)]
            change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫ f_x_left) w_spec = ι' z₀
            rw [h1]
            change ι' (g_Z.left w₀) = ι' z₀
            rw [hgw₀]
          let P_V : AlgebraicGeometry.Scheme.{u} := (B_Z.obj V_x).left
          let p₁ : P_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_A) :=
            CategoryTheory.Limits.pullback.fst V_x.hom i_Z
          let m_U : P_V ⟶ Z' := (B_Z.map f_x).left
          have hm_U_fst : m_U ≫ ι' = p₁ ≫ f_x_left := CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hRange_mU : Set.range m_U ⊆ Set.range (AlgebraicGeometry.Scheme.Opens.ι Z_aff) := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨q_pt, rfl⟩
