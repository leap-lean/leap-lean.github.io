        _ = (φ ∣_ O_YV) ≫ (CategoryTheory.inv (π_YV ∣_ O_YV) ≫ (π_YV ∣_ O_YV)) ≫ O_YV.ι := by
            rw [CategoryTheory.IsIso.inv_hom_id, Category.id_comp]
        _ = (φ ∣_ O_YV) ≫ CategoryTheory.inv (π_YV ∣_ O_YV) ≫ ((π_YV ∣_ O_YV) ≫ O_YV.ι) := by
            simp only [Category.assoc]
        _ = ((φ ∣_ O_YV) ≫ CategoryTheory.inv (π_YV ∣_ O_YV) ≫ W_OV.ι) ≫ π_YV := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
            simp only [Category.assoc]
            rfl
    let s_YU : O_YU.toScheme ⟶ Γ_tilde.left :=
      Limits.pullback.lift O_YU.ι
        ((φ ∣_ O_YV) ≫ CategoryTheory.inv (π_YV ∣_ O_YV) ≫ W_OV.ι) h_sec_comm
    have hs_YU_range : Set.range s_YU.base ⊆ Set.range O_tY.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      change π_tilde.base (s_YU.base x) ∈ (O_YU : Set ↥Y.left)
      have h1 : (s_YU ≫ π_tilde).base x = O_YU.ι.base x :=
        congrArg (fun m : AlgebraicGeometry.Scheme.Hom O_YU.toScheme Y.left => m.base x)
          (Limits.pullback.lift_fst _ _ _)
      change (s_YU ≫ π_tilde).base x ∈ (O_YU : Set ↥Y.left)
      rw [h1]
      exact x.2
    let s_tY : O_YU.toScheme ⟶ O_tY.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O_tY.ι s_YU hs_YU_range
    have hs_tY_fac : s_tY ≫ O_tY.ι = s_YU :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O_tY.ι s_YU hs_YU_range
    have h_s_π : s_tY ≫ (π_tilde ∣_ O_YU) = 𝟙 O_YU.toScheme := by
      rw [← cancel_mono O_YU.ι, Category.id_comp, Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc, hs_tY_fac,
        Limits.pullback.lift_fst]
    have h_π_s : (π_tilde ∣_ O_YU) ≫ s_tY = 𝟙 O_tY.toScheme := by
      rw [← cancel_mono O_tY.ι, Category.id_comp, Category.assoc, hs_tY_fac]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, AlgebraicGeometry.morphismRestrict_ι]
      · rw [Category.assoc, Limits.pullback.lift_snd]
        have h_ot_range : Set.range (O_tY.ι ≫ φ_tilde).base ⊆ Set.range W_OV.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          change (O_tY.ι ≫ (φ_tilde ≫ π_YV)).base x ∈ (O_YV : Set ↥Y.left)
          rw [← Limits.pullback.condition]
          exact x.2
        let g_W : O_tY.toScheme ⟶ W_OV.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift W_OV.ι (O_tY.ι ≫ φ_tilde) h_ot_range
        have hg_W_fac : g_W ≫ W_OV.ι = O_tY.ι ≫ φ_tilde :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac W_OV.ι (O_tY.ι ≫ φ_tilde) h_ot_range
        have hg_W_eq : g_W = (π_tilde ∣_ O_YU) ≫ (φ ∣_ O_YV) ≫
            CategoryTheory.inv (π_YV ∣_ O_YV) := by
          rw [← cancel_mono (π_YV ∣_ O_YV), Category.assoc, Category.assoc,
            CategoryTheory.IsIso.inv_hom_id, Category.comp_id, ← cancel_mono O_YV.ι]
          calc
            (g_W ≫ (π_YV ∣_ O_YV)) ≫ O_YV.ι
              = g_W ≫ ((π_YV ∣_ O_YV) ≫ O_YV.ι) := Category.assoc _ _ _
            _ = (g_W ≫ W_OV.ι) ≫ π_YV := by
                rw [AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc]
            _ = O_tY.ι ≫ (φ_tilde ≫ π_YV) := by rw [hg_W_fac, Category.assoc]
            _ = (O_tY.ι ≫ π_tilde) ≫ φ := by
                rw [← Limits.pullback.condition, ← Category.assoc]
            _ = (π_tilde ∣_ O_YU) ≫ (O_YU.ι ≫ φ) := by
                rw [← AlgebraicGeometry.morphismRestrict_ι, Category.assoc]
            _ = ((π_tilde ∣_ O_YU) ≫ (φ ∣_ O_YV)) ≫ O_YV.ι := by
                rw [← AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc]
        rw [← hg_W_fac, hg_W_eq]
        simp only [Category.assoc]
    have hIso_πt : CategoryTheory.IsIso (π_tilde ∣_ O_YU) :=
      ⟨⟨s_tY, h_π_s, h_s_π⟩⟩

    let j_ΓV' : AlgebraicGeometry.Spec (CommRingCat.of A_Vg) ⟶ Γ_V.left := j_ΓV
    have hj_ΓV_Y : j_ΓV' ≫ π_YV = j_YV := hRoof_V.2.2.2.2.2.2.2.2.2.1
    have hj_ΓV_P : j_ΓV' ≫ π_PV =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ_u g)) ≫
          (iso_Ug.inv ≫ U_g.ι) := hRoof_V.2.2.2.2.2.2.2.2.2.2.1
    have hj_YU_φ' : j_YU ≫ φ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ j_YV := hj_YU_φ
    have hf_U_comm : j_YU ≫ φ =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ j_ΓV') ≫ π_YV := by
      rw [hj_YU_φ', ← hj_ΓV_Y, ← Category.assoc]
    let f_U_tilde : AlgebraicGeometry.Spec (CommRingCat.of A_Ug) ⟶ Γ_tilde.left :=
      Limits.pullback.lift j_YU
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ j_ΓV') hf_U_comm
    have hf_Ut_range_sub : Set.range f_U_tilde.base ⊆ Set.range O_tilde.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, hOt_eq]
      rintro _ ⟨x, rfl⟩
      change (f_U_tilde ≫ π_tilde).base x ∈ (O_YU : Set ↥Y.left)
      rw [Limits.pullback.lift_fst, ← hj_YU_range_OYU]
      exact ⟨x, rfl⟩
    let f_Ot : AlgebraicGeometry.Spec (CommRingCat.of A_Ug) ⟶ O_tilde.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O_tilde.ι f_U_tilde hf_Ut_range_sub
    have hf_Ot_fac : f_Ot ≫ O_tilde.ι = f_U_tilde :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O_tilde.ι f_U_tilde hf_Ut_range_sub
    let e_Ot_tY : O_tilde.toScheme ⟶ O_tY.toScheme :=
      Γ_tilde.left.homOfLE (le_of_eq hOt_eq)
    have : CategoryTheory.IsIso e_Ot_tY :=
      ⟨⟨Γ_tilde.left.homOfLE (le_of_eq hOt_eq.symm),
        by rw [← cancel_mono O_tilde.ι, Category.assoc,
             AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι,
             Category.id_comp],
        by rw [← cancel_mono O_tY.ι, Category.assoc,
             AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι,
             Category.id_comp]⟩⟩
    have hf_Ot_comp : f_Ot ≫ e_Ot_tY ≫ (π_tilde ∣_ O_YU) = iso_OYU.inv := by
      rw [← cancel_mono O_YU.ι, Category.assoc, Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι]
      change f_Ot ≫ e_Ot_tY ≫ O_tY.ι ≫ π_tilde = iso_OYU.inv ≫ O_YU.ι
      rw [← Category.assoc e_Ot_tY, AlgebraicGeometry.Scheme.homOfLE_ι,
        ← Category.assoc, hf_Ot_fac, Limits.pullback.lift_fst, hiso_OYU]
    have hIso_fOt : CategoryTheory.IsIso f_Ot := by
      have h_eq : f_Ot = iso_OYU.inv ≫ CategoryTheory.inv (e_Ot_tY ≫ (π_tilde ∣_ O_YU)) := by
        rw [← hf_Ot_comp, Category.assoc, CategoryTheory.IsIso.hom_inv_id, Category.comp_id]
      rw [h_eq]
      infer_instance
    have hf_Ut_open : AlgebraicGeometry.IsOpenImmersion f_U_tilde := by
      rw [← hf_Ot_fac]
      infer_instance
    have hf_Ut_range : Set.range f_U_tilde.base = (O_tilde : Set ↥Γ_tilde.left) := by
      rw [← hf_Ot_fac, hRange_comp_iso f_Ot O_tilde.ι]
      exact Subtype.range_coe
    let iso_Ot : O_tilde.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of A_Ug) :=
      (CategoryTheory.asIso f_Ot).symm
    obtain ⟨iso_VΓV, hiso_VΓV⟩ :=
      hOpenIsoOfRange j_ΓV hRoof_V.2.2.2.2.2.2.1 V_ΓV hRoof_V.2.2.2.2.2.2.2.2.2.2.2
    have hFree_φt : WeilTopDegFiniteLocallyFreeOfRank δ (φ_tilde ∣_ V_ΓV) := by
      refine hImg2 (φ_tilde ∣_ V_ΓV) A_Ug A_Vg φ_loc δ _ b_δ e_δ he_δ iso_Ot iso_VΓV ?_
      rw [← cancel_mono V_ΓV.ι]
      calc
        (iso_Ot.inv ≫ (φ_tilde ∣_ V_ΓV)) ≫ V_ΓV.ι
          = f_Ot ≫ ((φ_tilde ∣_ V_ΓV) ≫ V_ΓV.ι) := Category.assoc _ _ _
        _ = f_Ot ≫ (O_tilde.ι ≫ φ_tilde) := by rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (f_Ot ≫ O_tilde.ι) ≫ φ_tilde := (Category.assoc _ _ _).symm
        _ = f_U_tilde ≫ φ_tilde := by rw [hf_Ot_fac]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ j_ΓV :=
            Limits.pullback.lift_snd _ _ _
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ iso_VΓV.inv) ≫ V_ΓV.ι := by
            rw [Category.assoc, hiso_VΓV]

    
    have : IsDomain A_Ug := hDom_AUg
    obtain ⟨⟨hProp_U, hInt_U, hjU_eq, _⟩, hSec_U, _⟩ := hImg1 A_Ug Γ_tilde f_U_tilde
    let i_U := AlgebraicGeometry.Scheme.Hom.imageι f_U_tilde
    let j_ΓU := AlgebraicGeometry.Scheme.Hom.toImage f_U_tilde
    let Γ_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (i_U ≫ Γ_tilde.hom)
    have : AlgebraicGeometry.IsProper Γ_U.hom := hProp_U
    let π_YU : Γ_U.left ⟶ Y.left := i_U ≫ π_tilde
    let π_PU : Γ_U.left ⟶ P_ov.left := i_U ≫ (φ_tilde ≫ π_PV)
    obtain ⟨hj_ΓU_open, hj_ΓU_range_Ot, hIso_iU₀⟩ :=
      hSec_U Γ_tilde (𝟙 Γ_tilde.left) f_U_tilde hf_Ut_open (Category.comp_id _)
    have hOt_eq_range : (letI := hf_Ut_open; f_U_tilde.opensRange) = O_tilde :=
      TopologicalSpace.Opens.ext hf_Ut_range
    have hIso_iU : CategoryTheory.IsIso ((i_U ≫ 𝟙 Γ_tilde.left) ∣_ O_tilde) :=
      hOt_eq_range ▸ hIso_iU₀
    have hIso_iU' : CategoryTheory.IsIso (i_U ∣_ O_tilde) := by
      generalize hm : i_U ≫ 𝟙 Γ_tilde.left = m at hIso_iU
      rw [Category.comp_id] at hm
      subst hm
      exact hIso_iU
    have hj_ΓU_Y : j_ΓU ≫ π_YU = j_YU := by
      change j_ΓU ≫ i_U ≫ π_tilde = j_YU
      rw [← Category.assoc, hjU_eq, Limits.pullback.lift_fst]
    have hj_ΓU_P : j_ΓU ≫ π_PU =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ_u' g)) ≫
          (iso_Ug.inv ≫ U_g.ι) := by
      calc
        j_ΓU ≫ π_PU
          = (j_ΓU ≫ i_U) ≫ (φ_tilde ≫ π_PV) := (Category.assoc _ _ _).symm
        _ = (f_U_tilde ≫ φ_tilde) ≫ π_PV := by rw [hjU_eq, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ (j_ΓV' ≫ π_PV) := by
            rw [Limits.pullback.lift_snd, Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ_u g))) ≫
              (iso_Ug.inv ≫ U_g.ι) := by
            rw [hj_ΓV_P, ← Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Localization.awayMap ψ_u g) ≫
                CommRingCat.ofHom φ_loc) ≫
              (iso_Ug.inv ≫ U_g.ι) := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ_u' g)) ≫
              (iso_Ug.inv ≫ U_g.ι) := by
            rw [← CommRingCat.ofHom_comp, hφ_away]
    have hj_ΓU_range_P : Set.range j_ΓU.base = π_PU.base ⁻¹' (U_g : Set ↥P_ov.left) := by
      rw [hj_ΓU_range_Ot]
      change (i_U ≫ 𝟙 Γ_tilde.left).base ⁻¹' Set.range f_U_tilde.base = _
      rw [Category.comp_id, hf_Ut_range]
      rfl
    have hDim_U : topologicalKrullDim Γ_U.left = (d : WithBot ℕ∞) := by
      let : Algebra k A_U := kAlgU
      have hTrdeg_AUg : Algebra.trdeg k A_Ug = (d : Cardinal.{u}) := hTrdeg_AUg_0
      refine (hDim1 Γ_U hInt_U).2 A_Ug hTrdeg_AUg j_ΓU hj_ΓU_open ?_
      calc
        j_ΓU ≫ Γ_U.hom
          = j_ΓU ≫ i_U ≫ Γ_tilde.hom := rfl
        _ = j_ΓU ≫ i_U ≫ π_tilde ≫ Y.hom := by rw [hπt_ov]
        _ = j_YU ≫ Y.hom := by
            change (j_ΓU ≫ π_YU) ≫ Y.hom = _
            rw [hj_ΓU_Y]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_U A_Ug)) ≫
              (hU.fromSpec ≫ Y.hom) := Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_U A_Ug)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A_U)) := by
            rw [hAff1a Y U hU]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap k A_U) ≫
                CommRingCat.ofHom (algebraMap A_U A_Ug)) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A_Ug)) := by
            rw [← CommRingCat.ofHom_comp]
    have hRoof_U : WeilTopDegKummerIsChartGraphRoof k d P_ov ι_d Y U hU ψ_u' g
        Γ_U π_YU π_PU U_g iso_Ug j_ΓU j_YU :=
      ⟨hProp_U, hInt_U, hDim_U,
        by change (i_U ≫ π_tilde) ≫ Y.hom = _; rw [Category.assoc, hπt_ov]; rfl,
        by change (i_U ≫ (φ_tilde ≫ π_PV)) ≫ P_ov.hom = _
           rw [Category.assoc, Category.assoc, hRoof_V.2.2.2.2.1, hφt_ov]; rfl,
        hRoof_V.2.2.2.2.2.1, hj_ΓU_open, hj_YU_open, rfl, hj_ΓU_Y, hj_ΓU_P, hj_ΓU_range_P⟩
    exact ⟨g, hg, _, inferInstance, inferInstance, bM_V, eM_V,
      _, inferInstance, inferInstance, bM_U, eM_U,
      Γ_V, π_YV, π_PV, U_g, iso_Ug, j_ΓV, j_YV,
      Γ_tilde, π_tilde, φ_tilde,
      Γ_U, π_YU, π_PU, j_ΓU, j_YU, i_U,
      heM_V, heM_U, hRoof_V, hOpen_VΓV_YV, hProp_t, hπt_ov, hφt_ov, hPb_t,
      hFree_φt, hDim_Ot, hRoof_U, rfl, rfl, rfl, hIso_iU'⟩

theorem weil_comm_ring_det_norm_and_semilocal_tower_basis : (∀ (R S : Type u) [CommRing R] [CommRing S]
        (φ : R →+* S) (δ : ℕ)
        (M : Type u) [AddCommGroup M] [Module R M]
        (b : Module.Basis (Fin δ) R M) (e : M ≃+ S),
      (∀ (r : R) (m : M), e (r • m) = φ r * e m) →
      (∀ v : S,
        (∃ L : M →ₗ[R] M, ∀ m : M, e (L m) = v * e m) ∧
        (∀ L₁ L₂ : M →ₗ[R] M,
          (∀ m : M, e (L₁ m) = v * e m) →
          (∀ m : M, e (L₂ m) = v * e m) →
          L₁ = L₂) ∧
        (∀ (M' : Type u) [AddCommGroup M'] [Module R M']
            (b' : Module.Basis (Fin δ) R M') (e' : M' ≃+ S),
          (∀ (r : R) (m' : M'), e' (r • m') = φ r * e' m') →
          ∀ (L : M →ₗ[R] M) (L' : M' →ₗ[R] M'),
            (∀ m : M, e (L m) = v * e m) →
            (∀ m' : M', e' (L' m') = v * e' m') →
            ((LinearMap.toMatrix b b) L).det = ((LinearMap.toMatrix b' b') L').det)) ∧
      (∀ L : M →ₗ[R] M,
        (∀ m : M, e (L m) = 1 * e m) →
        ((LinearMap.toMatrix b b) L).det = 1) ∧
      (∀ (v₁ v₂ : S) (L₁ L₂ L₁₂ : M →ₗ[R] M),
        (∀ m : M, e (L₁ m) = v₁ * e m) →
        (∀ m : M, e (L₂ m) = v₂ * e m) →
        (∀ m : M, e (L₁₂ m) = (v₁ * v₂) * e m) →
        ((LinearMap.toMatrix b b) L₁₂).det =
          ((LinearMap.toMatrix b b) L₁).det * ((LinearMap.toMatrix b b) L₂).det) ∧
      (∀ (n : ℕ) (v : S) (L : M →ₗ[R] M),
        v ^ n = 1 →
        (∀ m : M, e (L m) = v * e m) →
        (((LinearMap.toMatrix b b) L).det) ^ n = 1) ∧
      (δ = 1 →
        ∀ (r₀ : R) (L : M →ₗ[R] M),
          (∀ m : M, e (L m) = φ r₀ * e m) →
          ((LinearMap.toMatrix b b) L).det = r₀) ∧
      (∀ (R' S' : Type u) [CommRing R'] [CommRing S']
          (ψ : R →+* R') (ξ : S →+* S') (φ' : R' →+* S'),
        ξ.comp φ = φ'.comp ψ →
        letI : Algebra R R' := ψ.toAlgebra
        letI : Algebra R S := φ.toAlgebra
        ∀ (e_T : TensorProduct R R' S ≃+ S'),
          (∀ (r' : R') (s : S),
            e_T (TensorProduct.tmul R r' s) = φ' r' * ξ s) →
          ∃ (M' : Type u) (_ : AddCommGroup M') (_ : Module R' M')
            (b' : Module.Basis (Fin δ) R' M') (e' : M' ≃+ S'),
            (∀ (r' : R') (m' : M'), e' (r' • m') = φ' r' * e' m') ∧
            ∀ (v : S) (L : M →ₗ[R] M) (L' : M' →ₗ[R'] M'),
              (∀ m : M, e (L m) = v * e m) →
              (∀ m' : M', e' (L' m') = ξ v * e' m') →
              ((LinearMap.toMatrix b' b') L').det = ψ (((LinearMap.toMatrix b b) L).det))) ∧
    (∀ (R₃ R₂ R₁ : Type u) [CommRing R₃] [CommRing R₂] [CommRing R₁]
        (φ₃₂ : R₃ →+* R₂) (φ₂₁ : R₂ →+* R₁)
        (m δ : ℕ),
      1 ≤ m →
      1 ≤ δ →
      ∀ (M₂ : Type u) [AddCommGroup M₂] [Module R₃ M₂]
        (_b₂ : Module.Basis (Fin m) R₃ M₂) (e₂ : M₂ ≃+ R₂),
        (∀ (r : R₃) (m₂ : M₂), e₂ (r • m₂) = φ₃₂ r * e₂ m₂) →
        φ₂₁.Finite →
        ∀ (𝔭 : Ideal R₃) [𝔭.IsPrime],
          (∀ (𝔮 : Ideal R₂), 𝔮.IsPrime →
            ∃ (s : R₂), s ∉ 𝔮 ∧
              ∃ (M_s : Type u) (_ : AddCommGroup M_s) (_ : Module (Localization.Away s) M_s)
                (_b_s : Module.Basis (Fin δ) (Localization.Away s) M_s)
                (e_s : M_s ≃+ Localization.Away (φ₂₁ s)),
                ∀ (b : Localization.Away s) (x : M_s),
                  e_s (b • x) = Localization.awayMap φ₂₁ s b * e_s x) →
          ∃ (t : R₃), t ∉ 𝔭 ∧
            (∃ (M₂_t : Type u) (_ : AddCommGroup M₂_t) (_ : Module (Localization.Away t) M₂_t)
                (_b₂_t : Module.Basis (Fin m) (Localization.Away t) M₂_t)
                (e₂_t : M₂_t ≃+ Localization.Away (φ₃₂ t)),
              ∀ (b : Localization.Away t) (x : M₂_t),
                e₂_t (b • x) = Localization.awayMap φ₃₂ t b * e₂_t x) ∧
            (∃ (M₁_t : Type u) (_ : AddCommGroup M₁_t) (_ : Module (Localization.Away (φ₃₂ t)) M₁_t)
                (_b₁_t : Module.Basis (Fin δ) (Localization.Away (φ₃₂ t)) M₁_t)
                (e₁_t : M₁_t ≃+ Localization.Away (φ₂₁ (φ₃₂ t))),
              ∀ (b : Localization.Away (φ₃₂ t)) (x : M₁_t),
                e₁_t (b • x) = Localization.awayMap φ₂₁ (φ₃₂ t) b * e₁_t x) ∧
            (∃ (M₁₃_t : Type u) (_ : AddCommGroup M₁₃_t) (_ : Module (Localization.Away t) M₁₃_t)
