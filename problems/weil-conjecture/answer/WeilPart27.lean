        have h_comp_app :
            Z.hom.appLE ⊤ U'' le_top ≫ (j₀.appIso V₀).hom =
              (j₀ ≫ Z.hom).appLE ⊤ V₀ le_top := by
          rw [h_appIso]
          exact AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j₀ Z.hom ⊤ U'' V₀ le_top _
        have h_top_res :
            (j₀ ≫ Z.hom).appLE ⊤ V₀ le_top =
              (j₀ ≫ Z.hom).appTop ≫
                S₀.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op := by
          symm
          exact AlgebraicGeometry.Scheme.Hom.appLE_map (j₀ ≫ Z.hom) (U := ⊤) (V := ⊤) le_top
            (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op
        have h_nat :
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              (AlgebraicGeometry.Spec.map φ_k).appTop =
            φ_k ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A₀)).inv := by
          rw [← cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A₀)).hom,
            Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id,
            AlgebraicGeometry.Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
        rw [h_comp_app, h_top_res, hj₀_over, ← Category.assoc, h_nat, Category.assoc]
      let e_U''_B₀ :
          (@AlgEquiv k ↑(Z.left.presheaf.obj (Opposite.op U''))
            ↑(S₀.presheaf.obj (Opposite.op V₀)) _ _ _ kAlgU'' algB₀) :=
        @AlgEquiv.ofRingEquiv k _ _ _ _ _ kAlgU'' algB₀
          (j₀.appIso V₀).commRingCatIsoToRingEquiv
          (fun c => congrArg (fun m => m.hom c) h_iso_mor)
      have h_tr_U''_B₀ :
          @Algebra.trdeg k ↑(Z.left.presheaf.obj (Opposite.op U'')) _ _ kAlgU'' =
            @Algebra.trdeg k ↑(S₀.presheaf.obj (Opposite.op V₀)) _ _ algB₀ :=
        @AlgEquiv.trdeg_eq k _ _ _ kAlgU'' _ _ algB₀ e_U''_B₀
      have h_tr_B₀_Top :
          @Algebra.trdeg k ↑(S₀.presheaf.obj (Opposite.op V₀)) _ _ algB₀ =
            @Algebra.trdeg k ↑(S₀.presheaf.obj (Opposite.op ⊤)) _ _ algTop :=
