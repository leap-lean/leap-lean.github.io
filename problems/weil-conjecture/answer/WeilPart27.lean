    apply hι_inj
    let z_F : TensorProduct F R' (TensorProduct B₀ F B_s) :=
      (Algebra.TensorProduct.cancelBaseChange B₀ F R' R' B_s).symm
        (Algebra.TensorProduct.map ι_R (AlgHom.id B₀ B_s) z)
    have hLHS : ι_R (Algebra.norm R z) = Algebra.norm R' z_F :=
      hNorm_bc m_rk B_s hb_s z
    rw [hLHS, map_prod]
    let E_Φ := Algebra.TensorProduct.congr (AlgEquiv.refl : R' ≃ₐ[R'] R') Φ_gen
    have hNormΦ : Algebra.norm R' (E_Φ z_F) = Algebra.norm R' z_F :=
      @Algebra.norm_eq_of_algEquiv R'
        (TensorProduct F R' (TensorProduct B₀ F B_s))
        (TensorProduct F R' (∀ i : Fin c, Localization.AtPrime (p_min i)))
        _ _ _ _ _ E_Φ z_F
    rw [← hNormΦ, s4_piNorm F R' c (fun i => Localization.AtPrime (p_min i)) (E_Φ z_F)]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [map_pow]
    have hRHS_i : ι_R (Algebra.norm R (Algebra.TensorProduct.map (AlgHom.id R R) (ψ_comp i) z)) =
        Algebra.norm R'
          (Algebra.TensorProduct.map (AlgHom.id R' R')
            (Algebra.TensorProduct.map (AlgHom.id F F) (ψ_comp i)) z_F) := by
      rw [hNorm_bc (d_rk i) (B_norm i) (hb_norm i)
        (Algebra.TensorProduct.map (AlgHom.id R R) (ψ_comp i) z)]
      congr 1
      refine TensorProduct.inductionOn
        (motive := fun w =>
          (Algebra.TensorProduct.cancelBaseChange B₀ F R' R' (B_norm i)).symm
            (Algebra.TensorProduct.map ι_R (AlgHom.id B₀ (B_norm i))
