                rw [← mul_assoc, hu_inv]
              _ = 0 := by rw [hg_unit_prod, mul_zero]
          let e_ψC : (Fin δ → C₂) ≃ₗ[C₂] C₁ :=
            LinearEquiv.ofBijective ψ_C ⟨hψC_inj, hψC_surj⟩
          
          let Φ_C : (Fin δ → C₂) →ₗ[C₂] C₁ :=
            { toFun := fun g => ∑ j : Fin δ, g j • algebraMap R₁ C₁ (w j)
              map_add' := fun g₁ g₂ => by simp [add_smul, Finset.sum_add_distrib]
              map_smul' := fun c g => by simp [mul_smul, Finset.smul_sum] }
          have hΦC_surj : Function.Surjective Φ_C := by
            intro z
            obtain ⟨⟨x, p⟩, hz⟩ := IsLocalization.surj (Submonoid.powers (φ₂₁ (r * s))) z
            obtain ⟨k, hp⟩ := p.2
            have hp' : (φ₂₁ (r * s)) ^ k = p.1 := hp
            obtain ⟨h, hh⟩ := hΦ_surj (algebraMap R₁ B₁ x)
            refine ⟨fun j => rs_inv ^ k * α_r (h j), ?_⟩
            change (∑ j : Fin δ, ψ_rs (rs_inv ^ k * α_r (h j)) * algebraMap R₁ C₁ (w j)) = z
            have hβx : β_r (Φ h) = algebraMap R₁ C₁ x := by
              rw [hh]
              exact IsLocalization.Away.lift_eq (φ₂₁ r) hφr_unit_C₁ x
            have hsum_x : (∑ j : Fin δ, ψ_rs (rs_inv ^ k * α_r (h j)) * algebraMap R₁ C₁ (w j)) =
                (ψ_rs rs_inv) ^ k * algebraMap R₁ C₁ x := by
              rw [← hβx]
              change _ = (ψ_rs rs_inv) ^ k *
                β_r (∑ j : Fin δ, ψ_r (h j) * algebraMap R₁ B₁ (w j))
              rw [map_sum, Finset.mul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              have hcomm_j := RingHom.congr_fun hcomm_r (h j)
              simp only [RingHom.comp_apply] at hcomm_j
              have hβw : β_r (algebraMap R₁ B₁ (w j)) = algebraMap R₁ C₁ (w j) :=
                IsLocalization.Away.lift_eq (φ₂₁ r) hφr_unit_C₁ (w j)
              rw [ψ_rs.map_mul, ψ_rs.map_pow, β_r.map_mul, hcomm_j, hβw, mul_assoc]
            rw [hsum_x, ← hz, ← hp', (algebraMap R₁ C₁).map_pow]
            calc
              (ψ_rs rs_inv) ^ k * (z * (algebraMap R₁ C₁ (φ₂₁ (r * s))) ^ k) =
                  z * (algebraMap R₁ C₁ (φ₂₁ (r * s)) * ψ_rs rs_inv) ^ k := by
                rw [mul_pow]
                ring
              _ = z := by rw [hψrs_inv, one_pow, mul_one]
          let E_end : Module.End C₂ (Fin δ → C₂) := e_ψC.symm.toLinearMap.comp Φ_C
          have hE_inj : Function.Injective E_end :=
            Module.End.injective_of_surjective_fin (e_ψC.symm.surjective.comp hΦC_surj)
          have hΦC_inj : Function.Injective Φ_C := fun g₁ g₂ heq =>
            hE_inj (congrArg e_ψC.symm heq)
          have hΦC_f : Φ_C (fun j => α_r (f j)) = 0 := by
            have h1 : Φ_C (fun j => α_r (f j)) = β_r (Φ f) := by
              change (∑ j : Fin δ, ψ_rs (α_r (f j)) * algebraMap R₁ C₁ (w j)) =
                β_r (∑ j : Fin δ, ψ_r (f j) * algebraMap R₁ B₁ (w j))
              rw [map_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              have hcomm_j := RingHom.congr_fun hcomm_r (f j)
              simp only [RingHom.comp_apply] at hcomm_j
              have hβw : β_r (algebraMap R₁ B₁ (w j)) = algebraMap R₁ C₁ (w j) :=
                IsLocalization.Away.lift_eq (φ₂₁ r) hφr_unit_C₁ (w j)
              rw [β_r.map_mul, hcomm_j, hβw]
            rw [h1, hf, map_zero]
          have hαf_zero : ∀ j : Fin δ, α_r (f j) = 0 := by
            have hfun := hΦC_inj (hΦC_f.trans Φ_C.map_zero.symm)
            exact fun j => congrFun hfun j
          have hs_kill : ∀ j : Fin δ, ∃ k_j : ℕ, s_B ^ k_j * f j = 0 := by
            intro j
            obtain ⟨⟨a_j, p_j⟩, hfj⟩ := IsLocalization.surj (Submonoid.powers r) (f j)
            obtain ⟨n_j, hnj⟩ := p_j.2
            have hnj' : r ^ n_j = p_j.1 := hnj
            have ha_C₂ : algebraMap R₂ C₂ a_j = 0 := by
              have hαa : α_r (algebraMap R₂ B₂ a_j) = algebraMap R₂ C₂ a_j :=
                IsLocalization.Away.lift_eq r hr_unit_C₂ a_j
              rw [← hαa, ← hfj, α_r.map_mul, hαf_zero j, zero_mul]
            obtain ⟨⟨p_k, ⟨k_j, hp_k⟩⟩, hkj_zero⟩ :=
              (IsLocalization.map_eq_zero_iff (Submonoid.powers (r * s)) C₂ _).mp ha_C₂
            have hkj_zero' : (r * s) ^ k_j * a_j = 0 := by
              have hp_k' : (r * s) ^ k_j = p_k := hp_k
              rw [hp_k']
              exact hkj_zero
            refine ⟨k_j, ?_⟩
            have hB₂_zero : (algebraMap R₂ B₂ r) ^ k_j * s_B ^ k_j * algebraMap R₂ B₂ a_j = 0 := by
              have hrew : (algebraMap R₂ B₂ r) ^ k_j * s_B ^ k_j * algebraMap R₂ B₂ a_j =
                  algebraMap R₂ B₂ ((r * s) ^ k_j * a_j) := by
                dsimp [s_B]
                rw [(algebraMap R₂ B₂).map_mul, (algebraMap R₂ B₂).map_pow,
                  (algebraMap R₂ B₂).map_mul, mul_pow]
              rw [hrew, hkj_zero', map_zero]
            have hfj_pow : f j * (algebraMap R₂ B₂ r) ^ n_j = algebraMap R₂ B₂ a_j := by
              rwa [← hnj', (algebraMap R₂ B₂).map_pow] at hfj
            calc
              s_B ^ k_j * f j =
                  s_B ^ k_j * f j * (algebraMap R₂ B₂ r * r_inv) ^ (k_j + n_j) := by
                rw [hr_inv, one_pow, mul_one]
              _ = r_inv ^ (k_j + n_j) *
                    ((algebraMap R₂ B₂ r) ^ k_j * s_B ^ k_j *
                      (f j * (algebraMap R₂ B₂ r) ^ n_j)) := by
                rw [mul_pow, pow_add]
                ring
              _ = 0 := by rw [hfj_pow, hB₂_zero, mul_zero]
          let k_fn : Fin δ → ℕ := fun j => Classical.choose (hs_kill j)
          have hk_fn : ∀ j : Fin δ, s_B ^ k_fn j * f j = 0 := fun j =>
            Classical.choose_spec (hs_kill j)
          let K : ℕ := ∑ j : Fin δ, k_fn j
          have hsK_mem : s_B ^ K ∈ I_f := by
            intro j
            have hle : k_fn j ≤ K :=
              Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
            have hK_eq : K = (K - k_fn j) + k_fn j := (Nat.sub_add_cancel hle).symm
            rw [hK_eq, pow_add, mul_assoc, hk_fn j, mul_zero]
          exact hs_not_𝔐 (Ideal.IsPrime.mem_of_pow_mem inferInstance K (hIf_le hsK_mem))
        ext j
        have h1_mem : (1 : B₂) ∈ I_f := by rw [hIf_top]; trivial
        simpa [one_mul] using h1_mem j
      let e₁_t : (Fin δ → B₂) ≃+ B₁ :=
        (LinearEquiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩).toAddEquiv
      refine ⟨Fin δ → B₂, inferInstance, inferInstance, Pi.basisFun B₂ (Fin δ), e₁_t, ?_⟩
      intro b x
      exact (LinearEquiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩).map_smul b x
    
    refine ⟨hM₂_t, hM₁_t, ?_⟩
    obtain ⟨M₂_t, hAdd₂_t, hMod₂_t, b₂_t, e₂_t, he₂_t⟩ := hM₂_t
    obtain ⟨M₁_t, hAdd₁_t, hMod₁_t, b₁_t, e₁_t, he₁_t⟩ := hM₁_t
    letI : AddCommGroup M₂_t := hAdd₂_t
    letI : Module (Localization.Away t) M₂_t := hMod₂_t
    letI : AddCommGroup M₁_t := hAdd₁_t
    letI : Module (Localization.Away (φ₃₂ t)) M₁_t := hMod₁_t
    let B₃ := Localization.Away t
    let B₂ := Localization.Away (φ₃₂ t)
    let B₁ := Localization.Away ((φ₂₁.comp φ₃₂) t)
    let ψ₃₂_t : B₃ →+* B₂ := Localization.awayMap φ₃₂ t
    let ψ₂₁_t : B₂ →+* B₁ := Localization.awayMap φ₂₁ (φ₃₂ t)
    let ψ₃₁_t : B₃ →+* B₁ := Localization.awayMap (φ₂₁.comp φ₃₂) t
    have hcomp_t : ψ₂₁_t.comp ψ₃₂_t = ψ₃₁_t := by
      apply IsLocalization.ringHom_ext (Submonoid.powers t)
      ext r₃
      simp only [RingHom.comp_apply]
      have h1 : ψ₃₂_t (algebraMap R₃ B₃ r₃) = algebraMap R₂ B₂ (φ₃₂ r₃) :=
        h_away_eq φ₃₂ t r₃
      have h2 : ψ₂₁_t (algebraMap R₂ B₂ (φ₃₂ r₃)) = algebraMap R₁ B₁ (φ₂₁ (φ₃₂ r₃)) :=
        h_away_eq φ₂₁ (φ₃₂ t) (φ₃₂ r₃)
      have h3 : ψ₃₁_t (algebraMap R₃ B₃ r₃) = algebraMap R₁ B₁ ((φ₂₁.comp φ₃₂) r₃) :=
        h_away_eq (φ₂₁.comp φ₃₂) t r₃
      rw [h1, h2, h3]
      rfl
    letI : Algebra B₃ B₂ := ψ₃₂_t.toAlgebra
    letI : Algebra B₂ B₁ := ψ₂₁_t.toAlgebra
    letI : Algebra B₃ B₁ := ψ₃₁_t.toAlgebra
    haveI : IsScalarTower B₃ B₂ B₁ := IsScalarTower.of_algebraMap_eq' hcomp_t.symm
    let e₂_t_lin : M₂_t ≃ₗ[B₃] B₂ := { e₂_t with map_smul' := he₂_t }
    let e₁_t_lin : M₁_t ≃ₗ[B₂] B₁ := { e₁_t with map_smul' := he₁_t }
    let b₂_ring : Module.Basis (Fin m) B₃ B₂ := b₂_t.map e₂_t_lin
    let b₁_ring : Module.Basis (Fin δ) B₂ B₁ := b₁_t.map e₁_t_lin
    let b₁₃_t : Module.Basis (Fin (m * δ)) B₃ B₁ :=
      (b₂_ring.smulTower b₁_ring).reindex finProdFinEquiv
    refine ⟨B₁, inferInstance, inferInstance, b₁₃_t, AddEquiv.refl B₁, ?_⟩
    intro b x
    rfl
  · 
    intro A₃ A₂ A₁ _ _ _ ψ₃₂ ψ₂₁ m δ M₂ _ _ b₂ e₂ he₂ M₁ _ _ b₁ e₁ he₁ M₁₃ _ _ b₁₃ e₁₃ he₁₃
      v₁ L₁ L₂ L₁₃ hL₁ hL₂ hL₁₃
    letI : Algebra A₃ A₂ := ψ₃₂.toAlgebra
    letI : Algebra A₂ A₁ := ψ₂₁.toAlgebra
    letI : Algebra A₃ A₁ := (ψ₂₁.comp ψ₃₂).toAlgebra
    haveI : IsScalarTower A₃ A₂ A₁ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let e₂_lin : M₂ ≃ₗ[A₃] A₂ := { e₂ with map_smul' := he₂ }
    let e₁_lin : M₁ ≃ₗ[A₂] A₁ := { e₁ with map_smul' := he₁ }
    let e₁₃_lin : M₁₃ ≃ₗ[A₃] A₁ := { e₁₃ with map_smul' := he₁₃ }
    haveI : Module.Free A₃ A₂ := Module.Free.of_basis (b₂.map e₂_lin)
    haveI : Module.Free A₂ A₁ := Module.Free.of_basis (b₁.map e₁_lin)
    have hdet_eq_norm : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
        {k : ℕ} {M : Type u} [AddCommGroup M] [Module R M]
        (b : Module.Basis (Fin k) R M) (e_l : M ≃ₗ[R] S) (v : S) (L : M →ₗ[R] M),
        (∀ x : M, e_l (L x) = v * e_l x) →
        ((LinearMap.toMatrix b b) L).det = Algebra.norm R v := by
      intro R S _ _ _ k M _ _ b e_l v L hL
      have hconj : e_l.toLinearMap ∘ₗ L ∘ₗ e_l.symm.toLinearMap = Algebra.lmul R S v := by
        ext s
        change e_l (L (e_l.symm s)) = v * s
        rw [hL (e_l.symm s), e_l.apply_symm_apply]
      rw [LinearMap.det_toMatrix b L, ← LinearMap.det_conj L e_l, hconj, ← Algebra.norm_apply]
    have h₁ : ((LinearMap.toMatrix b₁ b₁) L₁).det = Algebra.norm A₂ v₁ :=
      hdet_eq_norm b₁ e₁_lin v₁ L₁ hL₁
    have h₂ : ((LinearMap.toMatrix b₂ b₂) L₂).det =
        Algebra.norm A₃ (((LinearMap.toMatrix b₁ b₁) L₁).det) :=
      hdet_eq_norm b₂ e₂_lin (((LinearMap.toMatrix b₁ b₁) L₁).det) L₂ hL₂
    have h₁₃ : ((LinearMap.toMatrix b₁₃ b₁₃) L₁₃).det = Algebra.norm A₃ v₁ :=
      hdet_eq_norm b₁₃ e₁₃_lin v₁ L₁₃ hL₁₃
    rw [h₂, h₁, h₁₃]
    exact Algebra.norm_norm

theorem weil_scheme_open_finite_locally_free_charts_and_tower (k : Type u) [Field k] :
    (∀ (Z₁ Z₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Z₁.hom] [AlgebraicGeometry.IsProper Z₂.hom]
        (f : Quiver.Hom Z₁.left Z₂.left),
      CategoryTheory.CategoryStruct.comp f Z₂.hom = Z₁.hom →
      AlgebraicGeometry.IsProper f ∧
      ∀ (W : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W Z₂.left),
        IsClosedMap (CategoryTheory.Limits.pullback.fst h f).base) ∧
    ((∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Z₁ Z₂)
        (m : ℕ) (O'₂ O₂ : Z₂.Opens),
        O'₂ ≤ O₂ →
        WeilTopDegFiniteLocallyFreeOfRank m (f ∣_ O₂) →
        WeilTopDegFiniteLocallyFreeOfRank m (f ∣_ O'₂)) ∧
      (∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Z₁ Z₂) (O₂ : Z₂.Opens),
        CategoryTheory.IsIso (f ∣_ O₂) →
        WeilTopDegFiniteLocallyFreeOfRank 1 (f ∣_ O₂) ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W Z₂),
          Set.range h.base ⊆ (O₂ : Set ↥Z₂) →
          CategoryTheory.IsIso (CategoryTheory.Limits.pullback.fst h f)) ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W Z₂)
            (W_x : W.Opens) (y : ↥(CategoryTheory.Limits.pullback h f))
            (hx : (CategoryTheory.Limits.pullback.fst h f).base y ∈ W_x),
          ∃ y_x : ↥(CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.comp W_x.ι h) f),
            (CategoryTheory.Limits.pullback.fst (CategoryTheory.CategoryStruct.comp W_x.ι h) f).base y_x =
              ⟨(CategoryTheory.Limits.pullback.fst h f).base y, hx⟩ ∧
            (CategoryTheory.Limits.pullback.lift
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst (CategoryTheory.CategoryStruct.comp W_x.ι h) f)
                W_x.ι)
              (CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.comp W_x.ι h) f)
              ((CategoryTheory.Category.assoc _ W_x.ι h).trans
                CategoryTheory.Limits.pullback.condition)).base y_x = y))) ∧
    (∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Z₁ Z₂) (m : ℕ) (O₂ : Z₂.Opens),
      WeilTopDegFiniteLocallyFreeOfRank m (f ∣_ O₂) →
      (∀ (W₁ W₂ : AlgebraicGeometry.Scheme.{u})
          [AlgebraicGeometry.IsAffine W₁] [AlgebraicGeometry.IsAffine W₂]
          (h₁ : Quiver.Hom W₁ Z₂) (h₂ : Quiver.Hom W₂ Z₂)
          (u_sch : Quiver.Hom W₁ W₂)
          (hu : CategoryTheory.CategoryStruct.comp u_sch h₂ = h₁),
        Set.range h₂.base ⊆ (O₂ : Set ↥Z₂) →
        let P₂ := CategoryTheory.Limits.pullback h₂ f
        let P₁ := CategoryTheory.Limits.pullback h₁ f
        let q_u : Quiver.Hom P₁ P₂ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h₁ f) u_sch)
            (CategoryTheory.Limits.pullback.snd h₁ f)
            ((CategoryTheory.Category.assoc _ u_sch h₂).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp _) hu).trans
                CategoryTheory.Limits.pullback.condition))
        let R₂ := ↑(W₂.presheaf.obj (Opposite.op ⊤))
        let R₁ := ↑(W₁.presheaf.obj (Opposite.op ⊤))
        let S₂ := ↑(P₂.presheaf.obj (Opposite.op ⊤))
        let S₁ := ↑(P₁.presheaf.obj (Opposite.op ⊤))
        let φ₂ : R₂ →+* S₂ :=
          CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (CategoryTheory.Limits.pullback.fst h₂ f))
        let φ₁ : R₁ →+* S₁ :=
          CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (CategoryTheory.Limits.pullback.fst h₁ f))
        let ψ : R₂ →+* R₁ := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop u_sch)
        let ξ : S₂ →+* S₁ := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop q_u)
        letI : Algebra R₂ R₁ := ψ.toAlgebra
        letI : Algebra R₂ S₂ := φ₂.toAlgebra
        AlgebraicGeometry.IsAffine P₂ ∧
        AlgebraicGeometry.IsAffine P₁ ∧
        ξ.comp φ₂ = φ₁.comp ψ ∧
        ∃ e_T : TensorProduct R₂ R₁ S₂ ≃+ S₁,
          ∀ (r₁ : R₁) (s₂ : S₂),
            e_T (TensorProduct.tmul R₂ r₁ s₂) =
              φ₁ r₁ * ξ s₂) ∧
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W Z₂) (V : W.Opens) (x : ↥W),
        x ∈ V →
        (V : Set ↥W) ⊆ h.base ⁻¹' (O₂ : Set ↥Z₂) →
        ∃ (W_x : W.Opens),
          AlgebraicGeometry.IsAffineOpen W_x ∧
          x ∈ W_x ∧
          W_x ≤ V ∧
          Set.range (CategoryTheory.CategoryStruct.comp W_x.ι h).base ⊆ (O₂ : Set ↥Z₂) ∧
          AlgebraicGeometry.IsAffine
            (CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.comp W_x.ι h) f) ∧
          ∃ (M_x : Type u) (_ : AddCommGroup M_x)
            (_ : Module ↑(W_x.toScheme.presheaf.obj (Opposite.op ⊤)) M_x)
            (b_x : Module.Basis (Fin m) ↑(W_x.toScheme.presheaf.obj (Opposite.op ⊤)) M_x)
            (e_x : M_x ≃+ ↑((CategoryTheory.Limits.pullback
              (CategoryTheory.CategoryStruct.comp W_x.ι h) f).presheaf.obj (Opposite.op ⊤))),
            ∀ (r₀ : ↑(W_x.toScheme.presheaf.obj (Opposite.op ⊤))) (v : M_x),
              e_x (r₀ • v) =
                CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop
                  (CategoryTheory.Limits.pullback.fst
                    (CategoryTheory.CategoryStruct.comp W_x.ι h) f)) r₀ * e_x v)) ∧
    ((∀ (R₃ R₂ R₁ : Type u) [CommRing R₃] [CommRing R₂] [CommRing R₁]
        (φ₃₂ : R₃ →+* R₂) (φ₂₁ : R₂ →+* R₁)
        (m δ : ℕ),
        1 ≤ m →
        1 ≤ δ →
        ∀ (M₂ : Type u) [AddCommGroup M₂] [Module R₃ M₂]
          (_b₂ : Module.Basis (Fin m) R₃ M₂) (e₂ : M₂ ≃+ R₂),
          (∀ (r : R₃) (m₂ : M₂), e₂ (r • m₂) = φ₃₂ r * e₂ m₂) →
          φ₂₁.Finite →
          ∀ (𝔭 : Ideal R₃) [𝔭.IsPrime],
            (∀ (𝔮 : Ideal R₂), 𝔮.IsPrime →
              ∃ (s : R₂), s ∉ 𝔮 ∧
                ∃ (M_s : Type u) (_ : AddCommGroup M_s) (_ : Module (Localization.Away s) M_s)
                  (_b_s : Module.Basis (Fin δ) (Localization.Away s) M_s)
                  (e_s : M_s ≃+ Localization.Away (φ₂₁ s)),
                  ∀ (b : Localization.Away s) (x : M_s),
                    e_s (b • x) = Localization.awayMap φ₂₁ s b * e_s x) →
            ∃ (t : R₃), t ∉ 𝔭 ∧
              (∃ (M₂_t : Type u) (_ : AddCommGroup M₂_t) (_ : Module (Localization.Away t) M₂_t)
                  (_b₂_t : Module.Basis (Fin m) (Localization.Away t) M₂_t)
                  (e₂_t : M₂_t ≃+ Localization.Away (φ₃₂ t)),
                ∀ (b : Localization.Away t) (x : M₂_t),
                  e₂_t (b • x) = Localization.awayMap φ₃₂ t b * e₂_t x) ∧
              (∃ (M₁_t : Type u) (_ : AddCommGroup M₁_t) (_ : Module (Localization.Away (φ₃₂ t)) M₁_t)
                  (_b₁_t : Module.Basis (Fin δ) (Localization.Away (φ₃₂ t)) M₁_t)
                  (e₁_t : M₁_t ≃+ Localization.Away (φ₂₁ (φ₃₂ t))),
                ∀ (b : Localization.Away (φ₃₂ t)) (x : M₁_t),
                  e₁_t (b • x) = Localization.awayMap φ₂₁ (φ₃₂ t) b * e₁_t x) ∧
              (∃ (M₁₃_t : Type u) (_ : AddCommGroup M₁₃_t) (_ : Module (Localization.Away t) M₁₃_t)
                  (_b₁₃_t : Module.Basis (Fin (m * δ)) (Localization.Away t) M₁₃_t)
                  (e₁₃_t : M₁₃_t ≃+ Localization.Away ((φ₂₁.comp φ₃₂) t)),
                ∀ (b : Localization.Away t) (x : M₁₃_t),
                  e₁₃_t (b • x) = Localization.awayMap (φ₂₁.comp φ₃₂) t b * e₁₃_t x)) →
      ∀ (Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u})
        (g : Quiver.Hom Z₁ Z₂) (f : Quiver.Hom Z₂ Z₃)
        (δ m : ℕ),
        1 ≤ δ →
        1 ≤ m →
        ∀ (O₃ : Z₃.Opens) (O₂ : Z₂.Opens) (O₁ : Z₁.Opens),
          O₂ = (TopologicalSpace.Opens.map f.base).obj O₃ →
          O₁ = (TopologicalSpace.Opens.map g.base).obj O₂ →
          WeilTopDegFiniteLocallyFreeOfRank δ (g ∣_ O₂) →
          WeilTopDegFiniteLocallyFreeOfRank m (f ∣_ O₃) →
          WeilTopDegFiniteLocallyFreeOfRank (m * δ)
            ((CategoryTheory.CategoryStruct.comp g f) ∣_ O₃) ∧
          ∀ (W : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom W Z₃),
            Set.range h.base ⊆ (O₃ : Set ↥Z₃) →
            ∀ x : ↥W,
              ∃ (W_x : W.Opens),
                AlgebraicGeometry.IsAffineOpen W_x ∧
                x ∈ W_x ∧
                let h_x := CategoryTheory.CategoryStruct.comp W_x.ι h
                let P_f := CategoryTheory.Limits.pullback h_x f
                let P_g := CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd h_x f) g
                let P_gf := CategoryTheory.Limits.pullback h_x (CategoryTheory.CategoryStruct.comp g f)
                Set.range h_x.base ⊆ (O₃ : Set ↥Z₃) ∧
                Set.range (CategoryTheory.Limits.pullback.snd h_x f).base ⊆ (O₂ : Set ↥Z₂) ∧
                AlgebraicGeometry.IsAffine P_f ∧
                AlgebraicGeometry.IsAffine P_g ∧
                AlgebraicGeometry.IsAffine P_gf ∧
                (∃ p_ass : Quiver.Hom P_g P_gf,
                  CategoryTheory.CategoryStruct.comp p_ass
                      (CategoryTheory.Limits.pullback.fst h_x (CategoryTheory.CategoryStruct.comp g f)) =
                    CategoryTheory.CategoryStruct.comp
                      (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd h_x f) g)
                      (CategoryTheory.Limits.pullback.fst h_x f) ∧
                  CategoryTheory.CategoryStruct.comp p_ass
                      (CategoryTheory.Limits.pullback.snd h_x (CategoryTheory.CategoryStruct.comp g f)) =
                    CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd h_x f) g ∧
                  CategoryTheory.IsIso p_ass) ∧
                (∃ (M_f : Type u) (_ : AddCommGroup M_f)
                    (_ : Module ↑(W_x.toScheme.presheaf.obj (Opposite.op ⊤)) M_f)
                    (b_f : Module.Basis (Fin m) ↑(W_x.toScheme.presheaf.obj (Opposite.op ⊤)) M_f)
                    (e_f : M_f ≃+ ↑(P_f.presheaf.obj (Opposite.op ⊤))),
                  ∀ (r₀ : ↑(W_x.toScheme.presheaf.obj (Opposite.op ⊤))) (y : M_f),
                    e_f (r₀ • y) =
                      CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop
                        (CategoryTheory.Limits.pullback.fst h_x f)) r₀ * e_f y) ∧
                (∃ (M_g : Type u) (_ : AddCommGroup M_g)
                    (_ : Module ↑(P_f.presheaf.obj (Opposite.op ⊤)) M_g)
                    (b_g : Module.Basis (Fin δ) ↑(P_f.presheaf.obj (Opposite.op ⊤)) M_g)
                    (e_g : M_g ≃+ ↑(P_g.presheaf.obj (Opposite.op ⊤))),
                  ∀ (r₁ : ↑(P_f.presheaf.obj (Opposite.op ⊤))) (z : M_g),
                    e_g (r₁ • z) =
                      CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop
                        (CategoryTheory.Limits.pullback.fst
                          (CategoryTheory.Limits.pullback.snd h_x f) g)) r₁ * e_g z)) :=
by
  
  have hCancelPB :
      ∀ {A B C D E F : AlgebraicGeometry.Scheme.{u}}
        {f₁ : A ⟶ B} {g₁ : A ⟶ D} {u : B ⟶ E} {f₂ : D ⟶ E}
        {i_D : D ⟶ F} {i_E : E ⟶ C} {h : F ⟶ C}
        (_hOuter : CategoryTheory.IsPullback f₁ (g₁ ≫ i_D) (u ≫ i_E) h)
        (_hTop : g₁ ≫ f₂ = f₁ ≫ u)
        (_hBot : CategoryTheory.IsPullback f₂ i_D i_E h),
        CategoryTheory.IsPullback f₁ g₁ u f₂ := by
    intro A B C D E F f₁ g₁ u f₂ i_D i_E h hOuter hTop hBot
    exact (CategoryTheory.IsPullback.of_right hOuter.flip hTop hBot.flip).flip

  
  have hPullbackFactor :
      ∀ {B C D E F : AlgebraicGeometry.Scheme.{u}}
        {f₂ : D ⟶ E} {i_D : D ⟶ F} {i_E : E ⟶ C} {f : F ⟶ C}
        (_hBot : CategoryTheory.IsPullback f₂ i_D i_E f)
        (h_top : B ⟶ C) (u : B ⟶ E) (_hu : u ≫ i_E = h_top),
        ∃ q : CategoryTheory.Limits.pullback h_top f ⟶ D,
          q ≫ f₂ = CategoryTheory.Limits.pullback.fst h_top f ≫ u ∧
          q ≫ i_D = CategoryTheory.Limits.pullback.snd h_top f ∧
          CategoryTheory.IsPullback (CategoryTheory.Limits.pullback.fst h_top f) q u f₂ := by
    intro B C D E F f₂ i_D i_E f hBot h_top u hu
    have hcond : (CategoryTheory.Limits.pullback.fst h_top f ≫ u) ≫ i_E =
        CategoryTheory.Limits.pullback.snd h_top f ≫ f := by
      rw [CategoryTheory.Category.assoc, hu, CategoryTheory.Limits.pullback.condition]
    let q := hBot.lift (CategoryTheory.Limits.pullback.fst h_top f ≫ u)
      (CategoryTheory.Limits.pullback.snd h_top f) hcond
    have hq1 : q ≫ f₂ = CategoryTheory.Limits.pullback.fst h_top f ≫ u :=
      hBot.lift_fst _ _ _
    have hq2 : q ≫ i_D = CategoryTheory.Limits.pullback.snd h_top f :=
      hBot.lift_snd _ _ _
    have hOuter : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst h_top f) (q ≫ i_D) (u ≫ i_E) f := by
      rw [hq2, hu]
      exact CategoryTheory.IsPullback.of_hasPullback h_top f
    exact ⟨q, hq1, hq2, hCancelPB hOuter hq1 hBot⟩

  
  have hRestrictLEPullback :
      ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Z₁ ⟶ Z₂)
        {O'₂ O₂ : Z₂.Opens} (hle : O'₂ ≤ O₂),
        CategoryTheory.IsPullback (f ∣_ O'₂)
          (Z₁.homOfLE ((TopologicalSpace.Opens.map f.base).monotone hle))
          (Z₂.homOfLE hle)
          (f ∣_ O₂) := by
    intro Z₁ Z₂ f O'₂ O₂ hle
    let O₁ : Z₁.Opens := (TopologicalSpace.Opens.map f.base).obj O₂
    let O'₁ : Z₁.Opens := (TopologicalSpace.Opens.map f.base).obj O'₂
    let j₂ := Z₂.homOfLE hle
    let j₁ := Z₁.homOfLE ((TopologicalSpace.Opens.map f.base).monotone hle)
    have hj₂ : j₂ ≫ O₂.ι = O'₂.ι := Z₂.homOfLE_ι hle
    have hj₁ : j₁ ≫ O₁.ι = O'₁.ι :=
      Z₁.homOfLE_ι ((TopologicalSpace.Opens.map f.base).monotone hle)
    have hTop : j₁ ≫ (f ∣_ O₂) = (f ∣_ O'₂) ≫ j₂ := by
      rw [← CategoryTheory.cancel_mono O₂.ι]
      calc
        (j₁ ≫ (f ∣_ O₂)) ≫ O₂.ι = j₁ ≫ ((f ∣_ O₂) ≫ O₂.ι) :=
          CategoryTheory.Category.assoc _ _ _
        _ = j₁ ≫ (O₁.ι ≫ f) := by
          rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (j₁ ≫ O₁.ι) ≫ f :=
          (CategoryTheory.Category.assoc _ _ _).symm
        _ = O'₁.ι ≫ f := by rw [hj₁]
        _ = (f ∣_ O'₂) ≫ O'₂.ι := (AlgebraicGeometry.morphismRestrict_ι f O'₂).symm
        _ = (f ∣_ O'₂) ≫ (j₂ ≫ O₂.ι) := by rw [hj₂]
        _ = ((f ∣_ O'₂) ≫ j₂) ≫ O₂.ι := (CategoryTheory.Category.assoc _ _ _).symm
    have hOuter : CategoryTheory.IsPullback (f ∣_ O'₂)
        (j₁ ≫ O₁.ι) (j₂ ≫ O₂.ι) f := by
      rw [hj₁, hj₂]
      exact AlgebraicGeometry.isPullback_morphismRestrict f O'₂
    exact hCancelPB hOuter hTop (AlgebraicGeometry.isPullback_morphismRestrict f O₂)

  
  have hTransportBasis :
      ∀ {R R' S S' : Type u} [CommRing R] [CommRing R'] [CommRing S] [CommRing S']
        (φ : R →+* S) (φ' : R' →+* S')
        (α : R' ≃+* R) (β : S ≃+* S')
        (_hcomm : ∀ r' : R', β (φ (α r')) = φ' r')
        (m : ℕ)
        (M : Type u) [AddCommGroup M] [Module R M]
        (_b : Module.Basis (Fin m) R M) (e : M ≃+ S)
        (_he : ∀ (r : R) (v : M), e (r • v) = φ r * e v),
        ∃ e' : (Fin m → R') ≃+ S',
          ∀ (r' : R') (v' : Fin m → R'), e' (r' • v') = φ' r' * e' v' := by
    intro R R' S S' _ _ _ _ φ φ' α β hcomm m M _ _ b e he
    let e₀ : (Fin m → R) ≃+ S := b.equivFun.symm.toAddEquiv.trans e
    have he₀ : ∀ (r : R) (v : Fin m → R), e₀ (r • v) = φ r * e₀ v := by
      intro r v
      change e (b.equivFun.symm (r • v)) = φ r * e (b.equivFun.symm v)
      rw [b.equivFun.symm.map_smul r v]
      exact he r (b.equivFun.symm v)
    let e_pi : (Fin m → R') ≃+ (Fin m → R) :=
      { toFun := fun v' i => α (v' i)
        invFun := fun v i => α.symm (v i)
        left_inv := fun v' => by ext i; exact α.symm_apply_apply (v' i)
        right_inv := fun v => by ext i; exact α.apply_symm_apply (v i)
        map_add' := fun u' v' => by ext i; exact α.map_add (u' i) (v' i) }
    have he_pi : ∀ (r' : R') (v' : Fin m → R'), e_pi (r' • v') = α r' • e_pi v' := by
      intro r' v'
      ext i
      exact α.map_mul r' (v' i)
    let e' : (Fin m → R') ≃+ S' := (e_pi.trans e₀).trans β.toAddEquiv
    refine ⟨e', fun r' v' => ?_⟩
    change β (e₀ (e_pi (r' • v'))) = φ' r' * β (e₀ (e_pi v'))
    rw [he_pi r' v', he₀ (α r') (e_pi v'), β.map_mul, hcomm r']

  
  have hTopIsoComm :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (φ : X ⟶ Y) (V : Y.Opens),
        let U : X.Opens := (TopologicalSpace.Opens.map φ.base).obj V
        φ.app V ≫ U.topIso.inv = V.topIso.inv ≫ (φ ∣_ V).appTop := by
    intro X Y φ V
    let U : X.Opens := (TopologicalSpace.Opens.map φ.base).obj V
    have hnat := congrArg AlgebraicGeometry.Scheme.Hom.appTop
      (AlgebraicGeometry.Scheme.Opens.toSpecΓ_naturality φ V)
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
      AlgebraicGeometry.Scheme.Hom.comp_appTop,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop U,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop V,
      ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality (φ.app V),
      CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc] at hnat
    simpa using congrArg
      (fun k => (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op V))).inv ≫ k) hnat

  
  have hAffPullback :
      ∀ {P X₁ X₂ X₀ : AlgebraicGeometry.Scheme.{u}}
        [AlgebraicGeometry.IsAffine P] [AlgebraicGeometry.IsAffine X₁]
        [AlgebraicGeometry.IsAffine X₂] [AlgebraicGeometry.IsAffine X₀]
        {p₁ : P ⟶ X₁} {p₂ : P ⟶ X₂} {f₁ : X₁ ⟶ X₀} {f₂ : X₂ ⟶ X₀}
        (_hPB : CategoryTheory.IsPullback p₁ p₂ f₁ f₂),
        let R₀ := ↑(X₀.presheaf.obj (Opposite.op ⊤))
        let R₁ := ↑(X₁.presheaf.obj (Opposite.op ⊤))
        let R₂ := ↑(X₂.presheaf.obj (Opposite.op ⊤))
        let R_P := ↑(P.presheaf.obj (Opposite.op ⊤))
        let φ₁ : R₀ →+* R₁ := CommRingCat.Hom.hom f₁.appTop
        let φ₂ : R₀ →+* R₂ := CommRingCat.Hom.hom f₂.appTop
        let π₁ : R₁ →+* R_P := CommRingCat.Hom.hom p₁.appTop
        let π₂ : R₂ →+* R_P := CommRingCat.Hom.hom p₂.appTop
        letI : Algebra R₀ R₁ := φ₁.toAlgebra
        letI : Algebra R₀ R₂ := φ₂.toAlgebra
        π₂.comp φ₂ = π₁.comp φ₁ ∧
        (∃ e_T : TensorProduct R₀ R₁ R₂ ≃+ R_P,
          ∀ (r₁ : R₁) (r₂ : R₂),
            e_T (TensorProduct.tmul R₀ r₁ r₂) = π₁ r₁ * π₂ r₂) ∧
        (∀ (m : ℕ) (M₀ : Type u) [AddCommGroup M₀] [Module R₀ M₀]
            (_b₀ : Module.Basis (Fin m) R₀ M₀) (e₀ : M₀ ≃+ R₂),
          (∀ (r₀ : R₀) (v : M₀), e₀ (r₀ • v) = φ₂ r₀ * e₀ v) →
          ∃ (M₁ : Type u) (_ : AddCommGroup M₁) (_ : Module R₁ M₁)
            (_b₁ : Module.Basis (Fin m) R₁ M₁) (e₁ : M₁ ≃+ R_P),
            ∀ (r₁ : R₁) (v : M₁), e₁ (r₁ • v) = π₁ r₁ * e₁ v) := by
    intro P X₁ X₂ X₀ _ _ _ _ p₁ p₂ f₁ f₂ hPB
    let R₀ := ↑(X₀.presheaf.obj (Opposite.op ⊤))
    let R₁ := ↑(X₁.presheaf.obj (Opposite.op ⊤))
    let R₂ := ↑(X₂.presheaf.obj (Opposite.op ⊤))
    let R_P := ↑(P.presheaf.obj (Opposite.op ⊤))
    let φ₁ : R₀ →+* R₁ := CommRingCat.Hom.hom f₁.appTop
    let φ₂ : R₀ →+* R₂ := CommRingCat.Hom.hom f₂.appTop
    let π₁ : R₁ →+* R_P := CommRingCat.Hom.hom p₁.appTop
    let π₂ : R₂ →+* R_P := CommRingCat.Hom.hom p₂.appTop
    letI : Algebra R₀ R₁ := φ₁.toAlgebra
    letI : Algebra R₀ R₂ := φ₂.toAlgebra
    have hcomm : π₂.comp φ₂ = π₁.comp φ₁ := by
      have hw := congrArg AlgebraicGeometry.Scheme.Hom.appTop hPB.w
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Hom.comp_appTop] at hw
      ext r₀
      exact congrArg (fun k => k.hom r₀) hw.symm
    let g₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₁))
    let g₂ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₂))
    have hg₁_eq : AlgebraicGeometry.Spec.map f₁.appTop = g₁ :=
      congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
    have hg₂_eq : AlgebraicGeometry.Spec.map f₂.appTop = g₂ :=
      congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
    have hcond_hom : (p₁ ≫ X₁.isoSpec.hom) ≫ g₁ = (p₂ ≫ X₂.isoSpec.hom) ≫ g₂ := by
      rw [← hg₁_eq, ← hg₂_eq, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₁,
        AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₂,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hPB.w]
    let pb_hom : P ⟶ CategoryTheory.Limits.pullback g₁ g₂ :=
      CategoryTheory.Limits.pullback.lift (p₁ ≫ X₁.isoSpec.hom) (p₂ ≫ X₂.isoSpec.hom) hcond_hom
    have hcond_inv :
        (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ X₁.isoSpec.inv) ≫ f₁ =
        (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ X₂.isoSpec.inv) ≫ f₂ := by
      rw [← CategoryTheory.cancel_mono X₀.isoSpec.hom]
      calc
        ((CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ X₁.isoSpec.inv) ≫ f₁) ≫ X₀.isoSpec.hom
          = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ X₁.isoSpec.inv ≫ (f₁ ≫ X₀.isoSpec.hom) := by
            simp [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ X₁.isoSpec.inv ≫
              (X₁.isoSpec.hom ≫ g₁) := by
            rw [← AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₁, hg₁_eq]
        _ = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ g₁ := by simp
        _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ g₂ :=
            CategoryTheory.Limits.pullback.condition
        _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ X₂.isoSpec.inv ≫
              (X₂.isoSpec.hom ≫ g₂) := by simp
        _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ X₂.isoSpec.inv ≫ (f₂ ≫ X₀.isoSpec.hom) := by
            rw [← hg₂_eq, AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₂]
        _ = ((CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ X₂.isoSpec.inv) ≫ f₂) ≫ X₀.isoSpec.hom := by
            simp [CategoryTheory.Category.assoc]
    let pb_inv : CategoryTheory.Limits.pullback g₁ g₂ ⟶ P :=
      hPB.lift (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ X₁.isoSpec.inv)
        (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ X₂.isoSpec.inv) hcond_inv
    let e_pb : P ≅ CategoryTheory.Limits.pullback g₁ g₂ :=
      { hom := pb_hom
        inv := pb_inv
        hom_inv_id := by
          apply hPB.hom_ext
          · dsimp [pb_hom, pb_inv]
            rw [CategoryTheory.Category.assoc, hPB.lift_fst,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          · dsimp [pb_hom, pb_inv]
            rw [CategoryTheory.Category.assoc, hPB.lift_snd,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · dsimp [pb_hom, pb_inv]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, hPB.lift_fst,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          · dsimp [pb_hom, pb_inv]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, hPB.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    let T_ring := CommRingCat.of (TensorProduct R₀ R₁ R₂)
    let e_sch : P ≅ AlgebraicGeometry.Spec T_ring :=
      e_pb ≪≫ AlgebraicGeometry.pullbackSpecIso R₀ R₁ R₂
    have hiso_toSpec₁ : X₁.isoSpec.hom = X₁.toSpecΓ := by
      rw [← CategoryTheory.Category.comp_id X₁.isoSpec.hom,
        ← AlgebraicGeometry.Scheme.isoSpec_inv_toSpecΓ X₁,
        ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp]
    have hiso_toSpec₂ : X₂.isoSpec.hom = X₂.toSpecΓ := by
      rw [← CategoryTheory.Category.comp_id X₂.isoSpec.hom,
        ← AlgebraicGeometry.Scheme.isoSpec_inv_toSpecΓ X₂,
        ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp]
    let inl_hom : CommRingCat.of R₁ ⟶ T_ring :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let inr_hom : CommRingCat.of R₂ ⟶ T_ring :=
      CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] TensorProduct R₀ R₁ R₂))
    have he_fst : e_sch.hom ≫ AlgebraicGeometry.Spec.map inl_hom = p₁ ≫ X₁.toSpecΓ := by
      dsimp [e_sch, e_pb, pb_hom, inl_hom]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst R₀ R₁ R₂,
        CategoryTheory.Limits.pullback.lift_fst, hiso_toSpec₁]
    have he_snd : e_sch.hom ≫ AlgebraicGeometry.Spec.map inr_hom = p₂ ≫ X₂.toSpecΓ := by
      dsimp [e_sch, e_pb, pb_hom, inr_hom]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_snd R₀ R₁ R₂,
        CategoryTheory.Limits.pullback.lift_snd, hiso_toSpec₂]
    let Φ_iso : T_ring ≅ P.presheaf.obj (Opposite.op ⊤) :=
      { hom := (AlgebraicGeometry.Scheme.ΓSpecIso T_ring).inv ≫ e_sch.hom.appTop
        inv := e_sch.inv.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_ring).hom
        hom_inv_id := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_sch.hom.appTop,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
            CategoryTheory.Iso.inv_hom_id]
        inv_hom_id := by
          rw [CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso T_ring).hom,
            CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    have hΦ_inl : inl_hom ≫ Φ_iso.hom = p₁.appTop := by
      dsimp [Φ_iso]
      rw [AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality_assoc,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, he_fst,
        AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.toSpecΓ_appTop X₁]
      exact CategoryTheory.Iso.inv_hom_id_assoc
        (AlgebraicGeometry.Scheme.ΓSpecIso (X₁.presheaf.obj (Opposite.op ⊤))) p₁.appTop
    have hΦ_inr : inr_hom ≫ Φ_iso.hom = p₂.appTop := by
      dsimp [Φ_iso]
      rw [AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality_assoc,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, he_snd,
        AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.toSpecΓ_appTop X₂]
      exact CategoryTheory.Iso.inv_hom_id_assoc
        (AlgebraicGeometry.Scheme.ΓSpecIso (X₂.presheaf.obj (Opposite.op ⊤))) p₂.appTop
    let Φ_ring : TensorProduct R₀ R₁ R₂ ≃+* R_P := Φ_iso.commRingCatIsoToRingEquiv
    let e_T : TensorProduct R₀ R₁ R₂ ≃+ R_P := Φ_ring.toAddEquiv
    have he_T : ∀ (r₁ : R₁) (r₂ : R₂),
        e_T (TensorProduct.tmul R₀ r₁ r₂) = π₁ r₁ * π₂ r₂ := by
      intro r₁ r₂
      have hmul : (TensorProduct.tmul R₀ r₁ r₂ : TensorProduct R₀ R₁ R₂) =
          inl_hom.hom r₁ * inr_hom.hom r₂ := by
        change TensorProduct.tmul R₀ r₁ r₂ =
          TensorProduct.tmul R₀ r₁ 1 * TensorProduct.tmul R₀ 1 r₂
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      change Φ_iso.hom.hom (TensorProduct.tmul R₀ r₁ r₂) = π₁ r₁ * π₂ r₂
      rw [hmul, map_mul]
      have h1 : Φ_iso.hom.hom (inl_hom.hom r₁) = π₁ r₁ :=
        congrArg (fun k => k.hom r₁) hΦ_inl
      have h2 : Φ_iso.hom.hom (inr_hom.hom r₂) = π₂ r₂ :=
        congrArg (fun k => k.hom r₂) hΦ_inr
      rw [h1, h2]
    refine ⟨hcomm, ⟨e_T, he_T⟩, ?_⟩
    intro m M₀ _ _ b₀ e₀ he₀
    let e₀_lin : M₀ ≃ₗ[R₀] R₂ :=
      { e₀ with
        map_smul' := fun r₀ v => by
          change e₀ (r₀ • v) = φ₂ r₀ * e₀ v
          exact he₀ r₀ v }
    let M₁ : Type u := TensorProduct R₀ R₁ M₀
    let b₁ : Module.Basis (Fin m) R₁ M₁ := b₀.baseChange R₁
    let e₁ : M₁ ≃+ R_P :=
      (LinearEquiv.baseChange R₀ R₁ M₀ R₂ e₀_lin).toAddEquiv.trans e_T
    refine ⟨M₁, inferInstance, inferInstance, b₁, e₁, fun r'₁ z => ?_⟩
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul r₁ v =>
      change e_T ((LinearEquiv.baseChange R₀ R₁ M₀ R₂ e₀_lin) (r'₁ • TensorProduct.tmul R₀ r₁ v)) =
        π₁ r'₁ * e_T ((LinearEquiv.baseChange R₀ R₁ M₀ R₂ e₀_lin) (TensorProduct.tmul R₀ r₁ v))
      rw [TensorProduct.smul_tmul', smul_eq_mul, LinearEquiv.baseChange_tmul,
        LinearEquiv.baseChange_tmul, he_T, he_T, map_mul, mul_assoc]
    | add z₁ z₂ ih₁ ih₂ =>
      rw [smul_add, map_add, map_add, ih₁, ih₂, mul_add]

  
  have hBaseChangeAffineOpenBasis :
      ∀ {X' Y' X Y : AlgebraicGeometry.Scheme.{u}}
        {φ' : X' ⟶ Y'} {φ : X ⟶ Y}
        {V' : Y'.Opens} (_hV' : AlgebraicGeometry.IsAffineOpen V')
        (_hU' : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map φ'.base).obj V'))
        {V : Y.Opens} (_hV : AlgebraicGeometry.IsAffineOpen V)
        (_hU : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map φ.base).obj V))
        {q_U : AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map φ'.base).obj V') ⟶
          AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map φ.base).obj V)}
        {u_V : V'.toScheme ⟶ V.toScheme}
        (_hPB_UV : CategoryTheory.IsPullback (φ' ∣_ V') q_U u_V (φ ∣_ V))
        (m : ℕ)
        (M : Type u) [AddCommGroup M] [Module ↑(Y.presheaf.obj (Opposite.op V)) M]
        (_b : Module.Basis (Fin m) ↑(Y.presheaf.obj (Opposite.op V)) M)
        (e : M ≃+ ↑(X.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map φ.base).obj V))))
        (_he : ∀ (r : ↑(Y.presheaf.obj (Opposite.op V))) (v : M),
          e (r • v) = (φ.app V).hom r * e v),
        ∃ e' : (Fin m → ↑(Y'.presheaf.obj (Opposite.op V'))) ≃+
            ↑(X'.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map φ'.base).obj V'))),
          ∀ (r' : ↑(Y'.presheaf.obj (Opposite.op V')))
            (v' : Fin m → ↑(Y'.presheaf.obj (Opposite.op V'))),
            e' (r' • v') = (φ'.app V').hom r' * e' v' := by
    intro X' Y' X Y φ' φ V' hV' hU' V hV hU q_U u_V hPB_UV m M _ _ b e he
    let U : X.Opens := (TopologicalSpace.Opens.map φ.base).obj V
    let U' : X'.Opens := (TopologicalSpace.Opens.map φ'.base).obj V'
    haveI : AlgebraicGeometry.IsAffine V.toScheme := hV
    haveI : AlgebraicGeometry.IsAffine U.toScheme := hU
    haveI : AlgebraicGeometry.IsAffine V'.toScheme := hV'
    haveI : AlgebraicGeometry.IsAffine U'.toScheme := hU'
    have htop_V : ∀ r₀ : ↑(V.toScheme.presheaf.obj (Opposite.op ⊤)),
        U.topIso.symm.commRingCatIsoToRingEquiv
          ((φ.app V).hom (V.topIso.commRingCatIsoToRingEquiv r₀)) =
          ((φ ∣_ V).appTop).hom r₀ := by
      intro r₀
      have h1 : V.topIso.hom ≫ (φ.app V ≫ U.topIso.inv) = (φ ∣_ V).appTop := by
        rw [hTopIsoComm φ V, CategoryTheory.Iso.hom_inv_id_assoc]
      exact congrArg (fun k => k.hom r₀) h1
    obtain ⟨e_top, he_top⟩ := hTransportBasis (φ.app V).hom ((φ ∣_ V).appTop).hom
      V.topIso.commRingCatIsoToRingEquiv U.topIso.symm.commRingCatIsoToRingEquiv
      htop_V m M b e he
    obtain ⟨_, _, hBC⟩ := hAffPullback hPB_UV
    obtain ⟨M₁, hAdd₁, hMod₁, b₁, e₁, he₁⟩ :=
      hBC m (Fin m → ↑(V.toScheme.presheaf.obj (Opposite.op ⊤)))
        (Pi.basisFun _ (Fin m)) e_top he_top
    letI : AddCommGroup M₁ := hAdd₁
    letI : Module ↑(V'.toScheme.presheaf.obj (Opposite.op ⊤)) M₁ := hMod₁
    have htop_V' : ∀ r' : ↑(Y'.presheaf.obj (Opposite.op V')),
        U'.topIso.commRingCatIsoToRingEquiv
          (((φ' ∣_ V').appTop).hom (V'.topIso.symm.commRingCatIsoToRingEquiv r')) =
          (φ'.app V').hom r' := by
      intro r'
      have h1 : (V'.topIso.inv ≫ (φ' ∣_ V').appTop) ≫ U'.topIso.hom = φ'.app V' := by
        rw [← hTopIsoComm φ' V', CategoryTheory.Category.assoc,
          CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
      exact congrArg (fun k => k.hom r') h1
    exact hTransportBasis ((φ' ∣_ V').appTop).hom (φ'.app V').hom
      V'.topIso.symm.commRingCatIsoToRingEquiv U'.topIso.commRingCatIsoToRingEquiv
      htop_V' m M₁ b₁ e₁ he₁

  
  have hFreeBaseChange :
      ∀ {X' Y' X Y : AlgebraicGeometry.Scheme.{u}} (m : ℕ)
        {φ' : X' ⟶ Y'} {q : X' ⟶ X} {u : Y' ⟶ Y} {φ : X ⟶ Y}
        (_hPB : CategoryTheory.IsPullback φ' q u φ)
        (_hφ : WeilTopDegFiniteLocallyFreeOfRank m φ),
        WeilTopDegFiniteLocallyFreeOfRank m φ' := by
    intro X' Y' X Y m φ' q u φ hPB hφ
    have hFin' : AlgebraicGeometry.IsFinite φ' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPB.flip hφ.1
    haveI : AlgebraicGeometry.IsFinite φ' := hFin'
    haveI : AlgebraicGeometry.IsAffineHom φ' := hFin'.toIsAffineHom
    refine ⟨hFin', fun y' => ?_⟩
    obtain ⟨V, hyV, hV, hU, M, hAddM, hModM, e, he, ⟨b⟩⟩ := hφ.2 (u.base y')
    letI : AddCommGroup M := hAddM
    letI : Module ↑(Y.presheaf.obj (Opposite.op V)) M := hModM
    obtain ⟨V', hV', hyV', hV'_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := y') (U := (TopologicalSpace.Opens.map u.base).obj V) hyV
    let U' : X'.Opens := (TopologicalSpace.Opens.map φ'.base).obj V'
    have hU' : AlgebraicGeometry.IsAffineOpen U' := hV'.preimage φ'
    have hrange_uV : Set.range (V'.ι ≫ u).base ⊆ Set.range V.ι.base := by
      rw [V.range_ι]
      rintro _ ⟨z, rfl⟩
      exact hV'_sub z.2
    let u_V : V'.toScheme ⟶ V.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V.ι (V'.ι ≫ u) hrange_uV
    have hu_V : u_V ≫ V.ι = V'.ι ≫ u :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V.ι (V'.ι ≫ u) hrange_uV
    let U : X.Opens := (TopologicalSpace.Opens.map φ.base).obj V
    have hPB_pasted : CategoryTheory.IsPullback (φ' ∣_ V') (U'.ι ≫ q) (V'.ι ≫ u) φ :=
      (AlgebraicGeometry.isPullback_morphismRestrict φ' V').paste_vert hPB
    have hPB_V := AlgebraicGeometry.isPullback_morphismRestrict φ V
    have hcond_qU : ((φ' ∣_ V') ≫ u_V) ≫ V.ι = (U'.ι ≫ q) ≫ φ := by
      rw [CategoryTheory.Category.assoc, hu_V, hPB_pasted.w]
    let q_U := hPB_V.lift ((φ' ∣_ V') ≫ u_V) (U'.ι ≫ q) hcond_qU
    have hqU_fst : q_U ≫ (φ ∣_ V) = (φ' ∣_ V') ≫ u_V := hPB_V.lift_fst _ _ _
    have hqU_snd : q_U ≫ U.ι = U'.ι ≫ q :=
      hPB_V.lift_snd _ _ _
    have hOuter_UV : CategoryTheory.IsPullback (φ' ∣_ V')
        (q_U ≫ U.ι) (u_V ≫ V.ι) φ := by
      rw [hqU_snd, hu_V]
      exact hPB_pasted
    have hPB_UV : CategoryTheory.IsPullback (φ' ∣_ V') q_U u_V (φ ∣_ V) :=
      hCancelPB hOuter_UV hqU_fst hPB_V
    obtain ⟨e', he'⟩ := hBaseChangeAffineOpenBasis hV' hU' hV hU hPB_UV m M b e he
    exact ⟨V', hyV', hV', hU', Fin m → ↑(Y'.presheaf.obj (Opposite.op V')),
      inferInstance, inferInstance, e', he', ⟨Pi.basisFun _ (Fin m)⟩⟩

  
  have hBasicOpenIntertwine :
      ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
        {V : Y₂.Opens} (_hV : AlgebraicGeometry.IsAffineOpen V)
        (_hU : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map h.base).obj V))
        (φ : ↑(Y₂.presheaf.obj (Opposite.op V)) →+*
          ↑(Y₁.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map h.base).obj V))))
        (_hφ : φ = (h.app V).hom)
        (r : ↑(Y₂.presheaf.obj (Opposite.op V)))
        (O : Y₂.Opens) (_hO_eq : O = Y₂.basicOpen r),
        let O' : Y₁.Opens := (TopologicalSpace.Opens.map h.base).obj O
        ∃ (e_O : Localization.Away r ≃+* ↑(Y₂.presheaf.obj (Opposite.op O)))
          (e_O' : Localization.Away (φ r) ≃+* ↑(Y₁.presheaf.obj (Opposite.op O'))),
          ∀ b : Localization.Away r,
            e_O' (Localization.awayMap φ r b) = (h.app O).hom (e_O b) := by
    intro Y₁ Y₂ h V hV hU φ hφ r O hO_eq
    subst hφ
    subst hO_eq
    let U : Y₁.Opens := (TopologicalSpace.Opens.map h.base).obj V
    let O₀ : Y₂.Opens := Y₂.basicOpen r
    let O' : Y₁.Opens := (TopologicalSpace.Opens.map h.base).obj O₀
    let r' : ↑(Y₁.presheaf.obj (Opposite.op U)) := (h.app V).hom r
    let B₁ : Y₁.Opens := Y₁.basicOpen r'
    have hO'_eq : O' = B₁ := AlgebraicGeometry.Scheme.preimage_basicOpen h r
    haveI : IsLocalization.Away r ↑(Y₂.presheaf.obj (Opposite.op O₀)) :=
      hV.isLocalization_basicOpen r
    haveI : IsLocalization.Away r' ↑(Y₁.presheaf.obj (Opposite.op B₁)) :=
      hU.isLocalization_basicOpen r'
    let e_O : Localization.Away r ≃+* ↑(Y₂.presheaf.obj (Opposite.op O₀)) :=
      (IsLocalization.algEquiv (Submonoid.powers r)
        (Localization.Away r) ↑(Y₂.presheaf.obj (Opposite.op O₀))).toRingEquiv
    let e_B₁ : Localization.Away r' ≃+* ↑(Y₁.presheaf.obj (Opposite.op B₁)) :=
      (IsLocalization.algEquiv (Submonoid.powers r')
        (Localization.Away r') ↑(Y₁.presheaf.obj (Opposite.op B₁))).toRingEquiv
    let e_eq : ↑(Y₁.presheaf.obj (Opposite.op B₁)) ≃+* ↑(Y₁.presheaf.obj (Opposite.op O')) :=
      (Y₁.presheaf.mapIso (CategoryTheory.eqToIso hO'_eq).op).commRingCatIsoToRingEquiv
    let e_O' : Localization.Away r' ≃+* ↑(Y₁.presheaf.obj (Opposite.op O')) :=
      e_B₁.trans e_eq
    refine ⟨e_O, e_O', ?_⟩
    have hhom_eq : e_O'.toRingHom.comp (Localization.awayMap (h.app V).hom r) =
        (h.app O₀).hom.comp e_O.toRingHom := by
      apply IsLocalization.ringHom_ext (Submonoid.powers r)
      ext a
      simp only [RingHom.comp_apply, Localization.awayMap, IsLocalization.Away.map,
        IsLocalization.map_eq]
      have hc_O : e_O (algebraMap _ (Localization.Away r) a) =
          (Y₂.presheaf.map (CategoryTheory.homOfLE (Y₂.basicOpen_le r)).op).hom a :=
        (IsLocalization.algEquiv (Submonoid.powers r)
          (Localization.Away r) ↑(Y₂.presheaf.obj (Opposite.op O₀))).commutes a
      have hc_B₁ : e_B₁ (algebraMap _ (Localization.Away r') ((h.app V).hom a)) =
          (Y₁.presheaf.map (CategoryTheory.homOfLE (Y₁.basicOpen_le r')).op).hom
            ((h.app V).hom a) :=
        (IsLocalization.algEquiv (Submonoid.powers r')
          (Localization.Away r') ↑(Y₁.presheaf.obj (Opposite.op B₁))).commutes ((h.app V).hom a)
      change e_eq (e_B₁ (algebraMap _ (Localization.Away r') ((h.app V).hom a))) =
        (h.app O₀).hom (e_O (algebraMap _ (Localization.Away r) a))
      rw [hc_O, hc_B₁]
      have hmor_op :
          (CategoryTheory.homOfLE (Y₁.basicOpen_le r')).op ≫ (CategoryTheory.eqToHom hO'_eq).op =
          ((TopologicalSpace.Opens.map h.base).map
            (CategoryTheory.homOfLE (Y₂.basicOpen_le r))).op :=
        congrArg Opposite.op (Subsingleton.elim _ _)
      have heq_map : e_eq ((Y₁.presheaf.map (CategoryTheory.homOfLE (Y₁.basicOpen_le r')).op).hom
          ((h.app V).hom a)) =
          (Y₁.presheaf.map ((TopologicalSpace.Opens.map h.base).map
            (CategoryTheory.homOfLE (Y₂.basicOpen_le r))).op).hom ((h.app V).hom a) := by
        change (Y₁.presheaf.map (CategoryTheory.homOfLE (Y₁.basicOpen_le r')).op ≫
          Y₁.presheaf.map (CategoryTheory.eqToHom hO'_eq).op).hom ((h.app V).hom a) = _
        rw [← Y₁.presheaf.map_comp, hmor_op]
      rw [heq_map]
      exact (congrArg (fun k => k.hom a)
        (AlgebraicGeometry.Scheme.Hom.naturality h
          (CategoryTheory.homOfLE (Y₂.basicOpen_le r)).op)).symm
    intro b
    exact congrArg (fun k : Localization.Away r →+* _ => k b) hhom_eq

  
  refine ⟨?_, ⟨?_, ?_⟩, ?_, ?_⟩

  
  
  
