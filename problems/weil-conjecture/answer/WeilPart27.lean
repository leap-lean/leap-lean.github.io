          rw [← map_natCast (algebraMap R T_R') m]
          exact hUnit_m.map _
        have hw_u : IsUnit W_bar := ⟨w, rfl⟩
        exact hm_u.mul (hw_u.pow (m - 1))
      obtain ⟨zu, hzu⟩ := hz_unit
      let z_inv : T_R' := ((zu⁻¹ : T_R'ˣ) : T_R')
      have hz_mul : z * z_inv = 1 := by
        rw [← hzu]
        exact Units.mul_inv zu
      let M_zinv := (LinearMap.toMatrix b_bar b_bar) (Algebra.lmul R' T_R' z_inv)
      have hM_mul : M_z * M_zinv = 1 := by
        dsimp only [M_z, M_zinv]
        rw [← LinearMap.toMatrix_comp b_bar b_bar b_bar, ← LinearMap.toMatrix_id b_bar]
        congr 1
        apply LinearMap.ext
        intro x
        change z * (z_inv * x) = x
        rw [← mul_assoc, hz_mul, one_mul]
      have hdet_mul : M_z.det * M_zinv.det = 1 := by
        rw [← Matrix.det_mul, hM_mul, Matrix.det_one]
      exact ⟨⟨M_z.det, M_zinv.det, hdet_mul, mul_comm M_zinv.det M_z.det ▸ hdet_mul⟩, rfl⟩
    let P_sub : Algebra.SubmersivePresentation R R' (Fin δ) (Fin δ) := ⟨P_pre, hUnit_jac⟩
    have hDim0 : P_sub.dimension = 0 := Nat.sub_self _
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 R R' :=
      P_sub.isStandardSmoothOfRelativeDimension hDim0
    haveI : Algebra.Etale R R' := inferInstance
    have hEt : RingHom.Etale (algebraMap R R') := RingHom.etale_algebraMap.mpr inferInstance
    have hHensel_pow :
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
          (m : Ω) ≠ 0 →
          ∀ (lam : Ω), lam ≠ 0 →
          ∀ (e : ℕ), ∃ q_p : Polynomial Ω,
            (Polynomial.X - Polynomial.C lam) ^ e ∣ (q_p ^ m - Polynomial.X) := by
      intro Ω _ _ hm_Ω lam hlam e
      rcases e with _ | k_e
      · exact ⟨0, by simp⟩
      · have hp_mon : (Polynomial.X ^ m - Polynomial.C lam : Polynomial Ω).Monic :=
          Polynomial.monic_X_pow_sub_C lam (by omega)
        have hp_deg : (Polynomial.X ^ m - Polynomial.C lam : Polynomial Ω).natDegree = m :=
          Polynomial.natDegree_X_pow_sub_C
        have hdeg_root : (Polynomial.X ^ m - Polynomial.C lam : Polynomial Ω).degree ≠ 0 := by
          have hm_nz : m ≠ 0 := by omega
          rw [Polynomial.degree_eq_natDegree hp_mon.ne_zero, hp_deg]
          exact ne_of_gt (WithBot.coe_pos.mpr (Nat.pos_of_ne_zero hm_nz))
        obtain ⟨μ, hμ_rt⟩ := IsAlgClosed.exists_root
          (Polynomial.X ^ m - Polynomial.C lam : Polynomial Ω) hdeg_root
        have hμ_pow : μ ^ m = lam := by
          rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
            Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hμ_rt
          exact hμ_rt
        have hμ_ne : μ ≠ 0 := by
          intro h0
          apply hlam
          rw [← hμ_pow, h0, zero_pow (by omega)]
        suffices h_ind : ∃ q_p : Polynomial Ω,
            q_p.eval lam = μ ∧
            (Polynomial.X - Polynomial.C lam) ^ (k_e + 1) ∣ (q_p ^ m - Polynomial.X) from
          let ⟨q_p, _, hdvd⟩ := h_ind; ⟨q_p, hdvd⟩
        induction k_e with
        | zero =>
          refine ⟨Polynomial.C μ, Polynomial.eval_C, ⟨-1, ?_⟩⟩
          rw [pow_one, ← Polynomial.C_pow, hμ_pow]
          ring
        | succ k_e ih =>
          obtain ⟨q_k, hqk_ev, h_quot, hqk_eq⟩ := ih
          let d₀ : Ω := (m : Ω) * μ ^ (m - 1)
          have hd₀_ne : d₀ ≠ 0 := mul_ne_zero hm_Ω (pow_ne_zero (m - 1) hμ_ne)
          let c₀ : Ω := -(h_quot.eval lam) / d₀
          let X_lam : Polynomial Ω := Polynomial.X - Polynomial.C lam
          let q_next : Polynomial Ω := q_k + Polynomial.C c₀ * X_lam ^ (k_e + 1)
          have hqn_ev : q_next.eval lam = μ := by
            simp only [q_next, X_lam, Polynomial.eval_add, Polynomial.eval_mul,
              Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
              sub_self, zero_pow (Nat.succ_ne_zero k_e), mul_zero, add_zero, hqk_ev]
          let S_geom : Polynomial Ω :=
            ∑ t ∈ Finset.range m, q_next ^ t * q_k ^ (m - 1 - t)
          have h_diff : q_next ^ m - q_k ^ m =
              X_lam ^ (k_e + 1) * (Polynomial.C c₀ * S_geom) := by
            have hg := (geom_sum₂_mul q_next q_k m).symm
            have hsub : q_next - q_k = Polynomial.C c₀ * X_lam ^ (k_e + 1) := by
              dsimp only [q_next]; ring
            rw [hg, hsub]
            dsimp only [S_geom]
            ring
          let R_rem : Polynomial Ω := Polynomial.C c₀ * S_geom + h_quot
          have h_tot : q_next ^ m - Polynomial.X = X_lam ^ (k_e + 1) * R_rem := by
            calc
              q_next ^ m - Polynomial.X
                = (q_next ^ m - q_k ^ m) + (q_k ^ m - Polynomial.X) := by ring
              _ = X_lam ^ (k_e + 1) * (Polynomial.C c₀ * S_geom) + X_lam ^ (k_e + 1) * h_quot := by
                rw [h_diff, hqk_eq]
              _ = X_lam ^ (k_e + 1) * R_rem := by
                dsimp only [R_rem]; ring
          have hS_ev : S_geom.eval lam = d₀ := by
            dsimp only [S_geom, d₀]
            rw [Polynomial.eval_finset_sum]
            have hterm : ∀ t ∈ Finset.range m,
                (q_next ^ t * q_k ^ (m - 1 - t)).eval lam = μ ^ (m - 1) := by
              intro t ht
              rw [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_pow,
                hqn_ev, hqk_ev, ← pow_add,
                Nat.add_sub_of_le (Nat.le_sub_one_of_lt (Finset.mem_range.mp ht))]
            rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          have hR_root : R_rem.IsRoot lam := by
            rw [Polynomial.IsRoot.def]
            dsimp only [R_rem, c₀]
            rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, hS_ev,
              div_mul_cancel₀ _ hd₀_ne, neg_add_cancel]
          obtain ⟨h_next, hh_next⟩ := Polynomial.dvd_iff_isRoot.mpr hR_root
          refine ⟨q_next, hqn_ev, ⟨h_next, ?_⟩⟩
          rw [h_tot, hh_next]
          dsimp only [X_lam]
          ring
    have hBezout_monic :
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
          (m : Ω) ≠ 0 →
          ∀ (d_deg : ℕ) (p_m : Polynomial Ω),
            p_m.natDegree ≤ d_deg → p_m.Monic → p_m.eval 0 ≠ 0 →
            ∃ q_p : Polynomial Ω, p_m ∣ (q_p ^ m - Polynomial.X) := by
      intro Ω _ _ hm_Ω d_deg
      induction d_deg with
      | zero =>
        intro p_m hm_deg hm_mon _
        have hm1 : p_m = 1 :=
          Polynomial.eq_one_of_monic_natDegree_zero hm_mon (Nat.eq_zero_of_le_zero hm_deg)
        rw [hm1]
        exact ⟨0, one_dvd _⟩
      | succ d_deg ih =>
        intro p_m hm_deg hm_mon hm0
        by_cases hm_z : p_m.natDegree = 0
        · have hm1 : p_m = 1 := Polynomial.eq_one_of_monic_natDegree_zero hm_mon hm_z
          rw [hm1]
          exact ⟨0, one_dvd _⟩
        · have hm_ne : p_m ≠ 0 := hm_mon.ne_zero
          have hm_deg_ne : p_m.degree ≠ 0 := by
            rw [Polynomial.degree_eq_natDegree hm_ne]
            exact ne_of_gt (WithBot.coe_pos.mpr (Nat.pos_of_ne_zero hm_z))
          obtain ⟨lam, hlam_rt⟩ := IsAlgClosed.exists_root p_m hm_deg_ne
          have hlam_ne : lam ≠ 0 := by
            intro h0
            rw [h0, Polynomial.IsRoot.def] at hlam_rt
            exact hm0 hlam_rt
          let e := p_m.rootMultiplicity lam
          have _he_pos : 0 < e := (Polynomial.rootMultiplicity_pos hm_ne).mpr hlam_rt
          obtain ⟨m₂, hm_fac, hm₂_ndvd⟩ :=
            Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd p_m hm_ne lam
          let m₁ : Polynomial Ω := (Polynomial.X - Polynomial.C lam) ^ e
          have hm₁_mon : m₁.Monic := (Polynomial.monic_X_sub_C lam).pow e
          have hm_fac' : m₁ * m₂ = p_m := hm_fac.symm
          have hm₂_mon : m₂.Monic := hm₁_mon.of_mul_monic_left (hm_fac' ▸ hm_mon)
          have hm₂_0 : m₂.eval 0 ≠ 0 := by
            intro h0
            apply hm0
            rw [hm_fac, Polynomial.eval_mul, h0, mul_zero]
          have hm₁_deg : m₁.natDegree = e := by
            dsimp only [m₁]
            rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C, mul_one]
          have hm₂_deg : m₂.natDegree ≤ d_deg := by
            have h_add : p_m.natDegree = m₁.natDegree + m₂.natDegree := by
              rw [hm_fac, Polynomial.natDegree_mul hm₁_mon.ne_zero hm₂_mon.ne_zero]
            omega
          obtain ⟨q₁, hq₁⟩ := hHensel_pow Ω hm_Ω lam hlam_ne e
          obtain ⟨q₂, hq₂⟩ := ih m₂ hm₂_deg hm₂_mon hm₂_0
          have h_cop0 : IsCoprime (Polynomial.X - Polynomial.C lam) m₂ :=
            (Polynomial.irreducible_X_sub_C lam).coprime_iff_not_dvd.mpr hm₂_ndvd
          have h_cop : IsCoprime m₁ m₂ := h_cop0.pow_left
          have ⟨a_c, b_c, hab_c⟩ := h_cop
          let q_tot : Polynomial Ω := a_c * m₁ * q₂ + b_c * m₂ * q₁
          have hdvd₁ : m₁ ∣ (q_tot ^ m - Polynomial.X) := by
            have hsub₁ : m₁ ∣ (q_tot - q₁) := by
              refine ⟨a_c * (q₂ - q₁), ?_⟩
              have hb_eq : b_c * m₂ = 1 - a_c * m₁ := eq_sub_of_add_eq' hab_c
              dsimp only [q_tot]
              rw [hb_eq]
              ring
            have hpow₁ : m₁ ∣ (q_tot ^ m - q₁ ^ m) := hsub₁.trans (sub_dvd_pow_sub_pow q_tot q₁ m)
            have hsum₁ : q_tot ^ m - Polynomial.X = (q_tot ^ m - q₁ ^ m) + (q₁ ^ m - Polynomial.X) := by
              ring
            rw [hsum₁]
            exact dvd_add hpow₁ hq₁
          have hdvd₂ : m₂ ∣ (q_tot ^ m - Polynomial.X) := by
            have hsub₂ : m₂ ∣ (q_tot - q₂) := by
              refine ⟨b_c * (q₁ - q₂), ?_⟩
              have ha_eq : a_c * m₁ = 1 - b_c * m₂ := eq_sub_of_add_eq hab_c
              dsimp only [q_tot]
              rw [ha_eq]
              ring
            have hpow₂ : m₂ ∣ (q_tot ^ m - q₂ ^ m) := hsub₂.trans (sub_dvd_pow_sub_pow q_tot q₂ m)
            have hsum₂ : q_tot ^ m - Polynomial.X = (q_tot ^ m - q₂ ^ m) + (q₂ ^ m - Polynomial.X) := by
              ring
            rw [hsum₂]
            exact dvd_add hpow₂ hq₂
          refine ⟨q_tot, ?_⟩
          rw [hm_fac]
          exact h_cop.mul_dvd hdvd₁ hdvd₂
    have hSurj_comap : Function.Surjective (PrimeSpectrum.comap (algebraMap R R')) := by
      intro p
      letI : p.asIdeal.IsPrime := p.isPrime
      let D_p : Type u := R ⧸ p.asIdeal
      letI : IsDomain D_p := Ideal.Quotient.isDomain p.asIdeal
      let κ_p : Type u := FractionRing D_p
      let Ω : Type u := AlgebraicClosure κ_p
      let ψ_R : R →+* Ω :=
        (algebraMap κ_p Ω).comp ((algebraMap D_p κ_p).comp (Ideal.Quotient.mk p.asIdeal))
      have hψ_ker : ∀ r : R, ψ_R r = 0 ↔ r ∈ p.asIdeal := by
        intro r
        dsimp only [ψ_R]
        rw [RingHom.comp_apply, RingHom.comp_apply,
          map_eq_zero_iff _ (RingHom.injective (algebraMap κ_p Ω)),
          map_eq_zero_iff _ (IsFractionRing.injective D_p κ_p),
          Ideal.Quotient.eq_zero_iff_mem]
      letI : Algebra R Ω := RingHom.toAlgebra ψ_R
      have hm_Ω : (m : Ω) ≠ 0 := by
        have hu : IsUnit (ψ_R (m : R)) := hUnit_m.map ψ_R
        rw [map_natCast] at hu
        exact hu.ne_zero
      let A_Ω : Type u := TensorProduct R Ω S
      letI : CommRing A_Ω := inferInstance
      letI : Algebra R A_Ω := inferInstance
      letI : Algebra Ω A_Ω := inferInstance
      let β : Module.Basis (Fin δ) Ω A_Ω := b.baseChange Ω
      let u₀ : A_Ω := (1 : Ω) ⊗ₜ[R] (v : S)
      let u₀_inv : A_Ω := (1 : Ω) ⊗ₜ[R] ((v⁻¹ : Sˣ) : S)
      have hu₀_mul : u₀ * u₀_inv = 1 := by
        dsimp only [u₀, u₀_inv]
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, Units.mul_inv]
        rfl
      let M₀ : Matrix (Fin δ) (Fin δ) Ω :=
        (LinearMap.toMatrix β β) (Algebra.lmul Ω A_Ω u₀)
      let M₀_inv : Matrix (Fin δ) (Fin δ) Ω :=
        (LinearMap.toMatrix β β) (Algebra.lmul Ω A_Ω u₀_inv)
      have hM₀_mul : M₀ * M₀_inv = 1 := by
        dsimp only [M₀, M₀_inv]
        rw [← LinearMap.toMatrix_comp β β β, ← LinearMap.toMatrix_id β]
        congr 1
        apply LinearMap.ext
        intro x
        change u₀ * (u₀_inv * x) = x
        rw [← mul_assoc, hu₀_mul, one_mul]
      have hdet_M₀ : M₀.det ≠ 0 := by
        have hd : M₀.det * M₀_inv.det = 1 := by
          rw [← Matrix.det_mul, hM₀_mul, Matrix.det_one]
        exact left_ne_zero_of_mul_eq_one hd
      let m_ch : Polynomial Ω := M₀.charpoly
      have hm_mon : m_ch.Monic := Matrix.charpoly_monic M₀
      have hm_ev0 : m_ch.eval 0 ≠ 0 := by
        dsimp only [m_ch]
        rw [Matrix.eval_charpoly]
        have hmat0 : Matrix.scalar (Fin δ) (0 : Ω) - M₀ = (-1 : Ω) • M₀ := by
          ext i j; simp; ring
        rw [hmat0, Matrix.det_smul, Fintype.card_fin]
        exact mul_ne_zero (pow_ne_zero δ (neg_ne_zero.mpr one_ne_zero)) hdet_M₀
      have hm_u₀ : Polynomial.aeval u₀ m_ch = 0 := by
        have hCH : Polynomial.aeval M₀ m_ch = 0 := Matrix.aeval_self_charpoly M₀
        let E_alg : (A_Ω →ₗ[Ω] A_Ω) ≃ₐ[Ω] Matrix (Fin δ) (Fin δ) Ω :=
          LinearMap.toMatrixAlgEquiv β
        have hLM : E_alg.toAlgHom ((Algebra.lmul Ω A_Ω) u₀) = M₀ := rfl
        have h_end0 : Polynomial.aeval ((Algebra.lmul Ω A_Ω) u₀) m_ch = 0 := by
          apply E_alg.injective
          change E_alg.toAlgHom (Polynomial.aeval ((Algebra.lmul Ω A_Ω) u₀) m_ch) = E_alg.toAlgHom 0
          rw [map_zero, ← Polynomial.aeval_algHom_apply E_alg.toAlgHom ((Algebra.lmul Ω A_Ω) u₀) m_ch, hLM, hCH]
        have h_alg : (Algebra.lmul Ω A_Ω) (Polynomial.aeval u₀ m_ch) =
            Polynomial.aeval ((Algebra.lmul Ω A_Ω) u₀) m_ch :=
          (Polynomial.aeval_algHom_apply (Algebra.lmul Ω A_Ω) u₀ m_ch).symm
        rw [← h_alg] at h_end0
        have h_app1 := congrArg (fun f : A_Ω →ₗ[Ω] A_Ω => f 1) h_end0
        simpa using h_app1
      obtain ⟨q_poly, h_div, hq_div⟩ := hBezout_monic Ω hm_Ω m_ch.natDegree m_ch le_rfl hm_mon hm_ev0
      let w₀ : A_Ω := Polynomial.aeval u₀ q_poly
      have hw₀_pow : w₀ ^ m = u₀ := by
        have hsub0 : w₀ ^ m - u₀ = 0 := by
          calc
            w₀ ^ m - u₀
              = Polynomial.aeval u₀ (q_poly ^ m - Polynomial.X) := by
                simp [w₀]
            _ = Polynomial.aeval u₀ (m_ch * h_div) := by rw [hq_div]
            _ = Polynomial.aeval u₀ m_ch * Polynomial.aeval u₀ h_div := map_mul _ _ _
            _ = 0 := by rw [hm_u₀, zero_mul]
        exact sub_eq_zero.mp hsub0
      let c_vec : Fin δ → Ω := fun j => (β.repr w₀) j
      have hw₀_sum : ∑ j : Fin δ, (c_vec j) ⊗ₜ[R] b j = w₀ := by
        have h := β.sum_repr w₀
        refine (Finset.sum_congr rfl fun j _ => ?_).trans h
        rw [Module.Basis.baseChange_apply]
        change (c_vec j) ⊗ₜ[R] b j = (c_vec j) • ((1 : Ω) ⊗ₜ[R] b j)
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      let ev_c : P →ₐ[R] Ω := MvPolynomial.aeval c_vec
      let Φ_c : A_P →ₐ[R] A_Ω := Algebra.TensorProduct.map ev_c (AlgHom.id R S)
      have hΦc_W : Φ_c W = w₀ := by
        dsimp only [W]
        rw [map_sum]
        have hterm : ∀ j : Fin δ, Φ_c ((MvPolynomial.X j : P) ⊗ₜ[R] b j) = (c_vec j) ⊗ₜ[R] b j := by
          intro j
          change (ev_c (MvPolynomial.X j)) ⊗ₜ[R] b j = (c_vec j) ⊗ₜ[R] b j
          rw [MvPolynomial.aeval_X]
        rw [Finset.sum_congr rfl fun j _ => hterm j]
        exact hw₀_sum
      have hF_zero : ∀ i : Fin δ, ev_c (F i) = 0 := by
        have h_zero_sum : ∑ k : Fin δ, ev_c (F k) • β k = 0 := by
          have hΦc_v : Φ_c ((1 : P) ⊗ₜ[R] (v : S)) = u₀ := by
            change (ev_c 1) ⊗ₜ[R] (v : S) = u₀
            rw [map_one]
          have h1 : Φ_c (W ^ m - (1 : P) ⊗ₜ[R] (v : S)) = 0 := by
            rw [map_sub, map_pow, hΦc_W, hΦc_v, hw₀_pow, sub_self]
          rw [hWn_sub, map_sum] at h1
          refine (Finset.sum_congr rfl fun k _ => ?_).trans h1
          rw [Module.Basis.baseChange_apply]
          change ev_c (F k) • ((1 : Ω) ⊗ₜ[R] b k) = (ev_c (F k)) ⊗ₜ[R] b k
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        intro i
        have hi := congrArg (fun x => (β.repr x) i) h_zero_sum
        simpa only [map_sum, map_smul, Module.Basis.repr_self, Finsupp.smul_single,
          smul_eq_mul, mul_one, Finsupp.finset_sum_apply, Finsupp.single_apply,
          Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte, map_zero, Finsupp.zero_apply] using hi
      have hI_le : I ≤ RingHom.ker ev_c.toRingHom := by
        dsimp only [I]
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        exact hF_zero i
      let ψ_lift : R' →ₐ[R] Ω := Ideal.Quotient.liftₐ I ev_c (fun a ha => hI_le ha)
      let q_spec : PrimeSpectrum R' := ⟨RingHom.ker ψ_lift.toRingHom, RingHom.ker_isPrime _⟩
      refine ⟨q_spec, ?_⟩
      ext r
      change ψ_lift (algebraMap R R' r) = 0 ↔ r ∈ p.asIdeal
      rw [ψ_lift.commutes]
      exact hψ_ker r
    exact ⟨R', inferInstance, inferInstance, hEt, hSurj_comap, w, hW_pow⟩

  
  have h_pillar2 :
      (∀ (X : AlgebraicGeometry.Scheme.{u}),
        let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
