  let u_E := CategoryTheory.CategoryStruct.comp v_A (ι_aff d)
  let U_E : P_d.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ u_E hEt_comp
  have : AlgebraicGeometry.Etale u_E := hEt_comp
  have hOpen_uE : IsOpenMap u_E := AlgebraicGeometry.Scheme.Hom.isOpenMap u_E
  let W₀ : P_d.left.Opens := ⟨Set.range u_E, hOpen_uE.isOpen_range⟩
  have hNe_W₀ : Nonempty ↥W₀ := by
    obtain ⟨e₀⟩ := ‹Nonempty ↥E›
    exact ⟨⟨u_E e₀, e₀, rfl⟩⟩
  obtain ⟨hProp_Z, hDim_Z⟩ := hPart2_compl k m d hmd P_d hInt_Pd hDim_Pd W₀ hNe_W₀
  let I_Z := weilAltClosedComplIdeal P_d.left W₀
  let Z_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp I_Z.subschemeι P_d.hom)
  have : AlgebraicGeometry.IsProper Z_ov.hom := hProp_Z
  have hlt_deg : 2 * m < 2 * d := by omega
  have hSubZ : Subsingleton (weilEtaleTorsionH I_Z.subscheme n (2 * d)) :=
    hCD m (2 * d) Z_ov hDim_Z hlt_deg
  obtain ⟨hCont_Z, hInj_Z, hTerm_Z⟩ := hPart3_site I_Z.subschemeι
  have hSurj_counit :
