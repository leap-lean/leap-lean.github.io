    have hDim_Vs : topologicalKrullDim ↥V_s ≤ (1 : WithBot ℕ∞) := by
      let inc_Vs : ↥(V_s : Set ↥C_s) → ↥(j₁_s.opensRange : Set ↥C_s) :=
