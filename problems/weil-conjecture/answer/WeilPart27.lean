    exact ⟨CategoryTheory.Limits.IsTerminal.isTerminalObj B T₂ hT₂⟩

  rcases weil_canonical_torsion_pbc_and_pasting k n hn1 hUnit (@hc_all) (@hr_all) (@hExact_pb) hPBC_prime
