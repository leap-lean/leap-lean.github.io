          CategoryTheory.CategoryStruct.comp (lift_hom k_h hk) f = k_h := by
        intro W k_h hk
        apply sheaf_hom_ext
        ext opU : 2
        apply AddCommGrpCat.hom_ext
        ext w
        exact Classical.choose_spec (hLift_ex k_h hk opU.unop w)
      have h_uniq : ∀ {W : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (k_h : W ⟶ F₂)
          (hk : CategoryTheory.CategoryStruct.comp k_h g = 0) (m : W ⟶ F₁),
          CategoryTheory.CategoryStruct.comp m f = k_h → m = lift_hom k_h hk := by
        intro W k_h hk m hm
        apply sheaf_hom_ext
        ext opU : 2
        apply AddCommGrpCat.hom_ext
        ext w
        apply hInj opU.unop
        have hm_w := congrArg (fun ψ : W ⟶ F₂ => (ψ.hom.app opU).hom w) hm
        have hl_w := congrArg (fun ψ : W ⟶ F₂ => (ψ.hom.app opU).hom w) (h_fac k_h hk)
        exact hm_w.trans hl_w.symm
