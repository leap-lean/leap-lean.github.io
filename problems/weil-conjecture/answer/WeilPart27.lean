    have hS6 := weil_acyclic_leray_composition_and_edge_spec_eval n (@hc_all) (@hr_all) (@hExact_pb)
    have hPull_term_eval :=
      fun {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂)
        {T₁ : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂) =>
