        rw [hG_comm, hx₁]
    let e_G := Equiv.ofBijective G hG_bij
    letI := hFin_can U₁ y₁
    letI := hFin_can U₂ y₂
    symm
    calc
      Finset.sum Finset.univ
          (fun z₁ => valDiv_C (B.obj U₁) ((Div_sh_C.obj.map (B.map g).op).hom d) z₁.1)
