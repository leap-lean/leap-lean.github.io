by
  classical
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)

  have hPost_apply : ∀ {A : Type (u + 1)} [CategoryTheory.Category A]
      [CategoryTheory.Abelian A] [CategoryTheory.HasExt.{u} A]
      {W X Y : A} {q : ℕ} (f : X ⟶ Y) (x : CategoryTheory.Abelian.Ext W X q),
      ((CategoryTheory.Abelian.Ext.mk₀ f).postcomp W (Nat.add_zero q)) x =
        x.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q) :=
    fun _ _ => rfl

  have hMapExact_iso : ∀ {A B : Type (u + 1)}
      [CategoryTheory.Category A] [CategoryTheory.Abelian A]
      [CategoryTheory.HasExt.{u} A] [CategoryTheory.EnoughInjectives A]
      [CategoryTheory.Category B] [CategoryTheory.Abelian B]
      [CategoryTheory.HasExt.{u} B]
      {F₁ F₂ : CategoryTheory.Functor A B}
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (e : CategoryTheory.Iso F₁ F₂)
      {X₀ Y₀ : A} {q : ℕ} (x : CategoryTheory.Abelian.Ext X₀ Y₀ q),
      CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x =
        (CategoryTheory.Abelian.Ext.mk₀ (e.hom.app X₀)).comp
          ((CategoryTheory.Abelian.Ext.mapExactFunctor F₂ x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (e.inv.app Y₀)) (Nat.add_zero q))
          (Nat.zero_add q) := by
    intro A B _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ e X₀ Y₀ q
    induction q generalizing Y₀ with
    | zero =>
      intro x
      rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [← CategoryTheory.Category.assoc, ← e.hom.naturality,
        CategoryTheory.Category.assoc, e.hom_inv_id_app,
        CategoryTheory.Category.comp_id]
    | succ q ih =>
      intro x
      let ι : Y₀ ⟶ CategoryTheory.Injective.under Y₀ := CategoryTheory.Injective.ι Y₀
      let S_Y : CategoryTheory.ShortComplex A :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have hS_Y : S_Y.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS_Y x hx0 rfl
      rw [← hz]
      let hS₁ : (S_Y.map F₁).ShortExact := hS_Y.map_of_exact F₁
      let hS₂ : (S_Y.map F₂).ShortExact := hS_Y.map_of_exact F₂
      let φ_S : S_Y.map F₂ ⟶ S_Y.map F₁ := S_Y.mapNatTrans e.inv
      have h_nat : hS₂.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (e.inv.app Y₀))
          (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (e.inv.app S_Y.X₃)).comp hS₁.extClass
            (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₂ hS₁ φ_S
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₁ hS_Y,
        ih z,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q)
          (rfl : q + 1 = q + 1) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _
          (rfl : q + 1 = q + 1),
        ← h_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _
          (rfl : q + 1 = q + 1),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₂ hS_Y,
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]

  have hMapExact_comp : ∀ {A B E : Type (u + 1)}
      [CategoryTheory.Category A] [CategoryTheory.Abelian A]
      [CategoryTheory.HasExt.{u} A] [CategoryTheory.EnoughInjectives A]
      [CategoryTheory.Category B] [CategoryTheory.Abelian B]
      [CategoryTheory.HasExt.{u} B]
      [CategoryTheory.Category E] [CategoryTheory.Abelian E]
      [CategoryTheory.HasExt.{u} E]
      (F : CategoryTheory.Functor A B) (G : CategoryTheory.Functor B E)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      {X₀ Y₀ : A} {q : ℕ} (x : CategoryTheory.Abelian.Ext X₀ Y₀ q),
      CategoryTheory.Abelian.Ext.mapExactFunctor (CategoryTheory.Functor.comp F G) x =
        CategoryTheory.Abelian.Ext.mapExactFunctor G
          (CategoryTheory.Abelian.Ext.mapExactFunctor F x) := by
    intro A B E _ _ _ _ _ _ _ _ _ _ F G _ _ _ _ _ _ X₀ Y₀ q
    induction q generalizing Y₀ with
    | zero =>
      intro x
      rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ q ih =>
      intro x
      let ι : Y₀ ⟶ CategoryTheory.Injective.under Y₀ := CategoryTheory.Injective.ι Y₀
      let S_Y : CategoryTheory.ShortComplex A :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have hS_Y : S_Y.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS_Y x hx0 rfl
      rw [← hz,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (CategoryTheory.Functor.comp F G) hS_Y,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS_Y,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G (hS_Y.map_of_exact F),
        ih z]

  have hLeftUniq_symm : ∀ {A B : Type (u + 1)}
      [CategoryTheory.Category A] [CategoryTheory.Category B]
      {L₁ L₂ : CategoryTheory.Functor A B} {R : CategoryTheory.Functor B A}
      (adj₁ : L₁ ⊣ R) (adj₂ : L₂ ⊣ R) {W : A} {Z : B} (g : W ⟶ R.obj Z),
      (adj₁.homEquiv W Z).symm g =
        (adj₁.leftAdjointUniq adj₂).hom.app W ≫ (adj₂.homEquiv W Z).symm g := by
    intro A B _ _ L₁ L₂ R adj₁ adj₂ W Z g
    apply (adj₁.homEquiv W Z).injective
    rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit,
      CategoryTheory.Functor.map_comp, ← CategoryTheory.Category.assoc,
      CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj₁ adj₂ W,
      ← CategoryTheory.Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

  have hConstAdj_unit_map : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {T T' : S.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T')
      (A : AddCommGrpCat.{u}) (w : T ⟶ T'),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT).unit.app A =
        (CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT').unit.app A ≫
          (((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
            (Opposite.op w)) := by
    intro S T T' hT hT' A w
    let J := S.smallEtaleTopology
    let P := (CategoryTheory.Functor.const (S.Etale)ᵒᵖ).obj A
    let C_A := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A
    let η_app : ∀ U : S.Etale, A ⟶ C_A.obj.obj (Opposite.op U) :=
      fun U => ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app P).app
        (Opposite.op U)
    have hnat' : 𝟙 A ≫ η_app T = η_app T' ≫ C_A.obj.map (Opposite.op w) :=
      ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app P).naturality
        (Opposite.op w)
    rw [CategoryTheory.Category.id_comp] at hnat'
    have huT : (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A = η_app T :=
      (congrArg (fun k : A ⟶ A => k ≫ η_app T)
        (CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT A)).trans
        (CategoryTheory.Category.id_comp (η_app T))
    have huT' : (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A = η_app T' :=
      (congrArg (fun k : A ⟶ A => k ≫ η_app T')
        (CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT' A)).trans
        (CategoryTheory.Category.id_comp (η_app T'))
    rw [huT, huT']
    exact hnat'

  have hConstPull_indep : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
      {T₁ T'₁ : X₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT'₁ : CategoryTheory.Limits.IsTerminal T'₁)
      {T₂ T'₂ : X₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (hT'₂ : CategoryTheory.Limits.IsTerminal T'₂)
      (A : AddCommGrpCat.{u}),
      @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) T₁ hT₁ T₂ hT₂ A =
        @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) T'₁ hT'₁ T'₂ hT'₂ A := by
    intro X₁ X₂ f T₁ T'₁ hT₁ hT'₁ T₂ T'₂ hT₂ hT'₂ A
    let B_f := weilEtaleSitePullback f
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let pf_f := weilTopDegKummerZeroBdryPush D f
    let adj_f := weilTopDegKummerZeroBdryAdj D f
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj'₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT'₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let adj'₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT'₂
    let m' : C₂.obj A ⟶ pf_f.obj (C₁.obj A) :=
      (adj'₂.homEquiv A (pf_f.obj (C₁.obj A))).symm
        (adj'₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op (hT'₁.from (B_f.obj T'₂))))
    unfold weilEtaleConstPullbackHom
    apply congrArg (adj_f.homEquiv (C₂.obj A) (C₁.obj A)).symm
    apply (adj₂.homEquiv A (pf_f.obj (C₁.obj A))).injective
    rw [Equiv.apply_symm_apply]
    change adj₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op (hT₁.from (B_f.obj T₂))) =
      (adj₂.homEquiv A (pf_f.obj (C₁.obj A))) m'
    have hL : adj₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op (hT₁.from (B_f.obj T₂))) =
        adj'₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op (hT'₁.from (B_f.obj T₂))) := by
      rw [hConstAdj_unit_map X₁ hT₁ hT'₁ A (hT'₁.from T₁), CategoryTheory.Category.assoc,
        ← (C₁.obj A).obj.map_comp]
      exact congrArg (fun u => adj'₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op u))
        (hT'₁.hom_ext _ _)
    have hR : (adj₂.homEquiv A (pf_f.obj (C₁.obj A))) m' =
        adj'₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op (hT'₁.from (B_f.obj T₂))) := by
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      change adj₂.unit.app A ≫ m'.hom.app (Opposite.op T₂) = _
      rw [hConstAdj_unit_map X₂ hT₂ hT'₂ A (hT'₂.from T₂), CategoryTheory.Category.assoc,
        m'.hom.naturality (Opposite.op (hT'₂.from T₂)), ← CategoryTheory.Category.assoc]
      have hm'_app : adj'₂.unit.app A ≫ m'.hom.app (Opposite.op T'₂) =
          (adj'₂.homEquiv A (pf_f.obj (C₁.obj A))) m' := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      rw [hm'_app, Equiv.apply_symm_apply]
      change (adj'₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op (hT'₁.from (B_f.obj T'₂)))) ≫
          (C₁.obj A).obj.map (Opposite.op (B_f.map (hT'₂.from T₂))) = _
      rw [CategoryTheory.Category.assoc, ← (C₁.obj A).obj.map_comp]
      exact congrArg (fun u => adj'₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op u))
        (hT'₁.hom_ext _ _)
    exact hL.trans hR.symm

  have hp_D_eval : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂) (q : ℕ)
      (p : weilEtaleTorsionH X₂ n q →+ weilEtaleTorsionH X₁ n q),
      WeilIsTorsionEtalePullback f n q p →
      ∀ (x : weilEtaleTorsionH X₂ n q),
        p x =
          (CategoryTheory.Abelian.Ext.mk₀
            (@weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f)
              _ (weilEtaleIdTerminalIsTerminal.{u} X₁)
              _ (weilEtaleIdTerminalIsTerminal.{u} X₂) AM)).postcomp
            (weilTopDegKummerZeroBdryFℤ X₁) (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ (D.ιℤ_all f)).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _
                (weilTopDegKummerZeroBdryPull D f)
                (D.hAdd_all f) (D.hLim_all f) (D.hColim_all f) _ _
                (weilTopDegKummerZeroBdryFℤ X₂) (weilEtaleTorsionSheaf X₂ n) q) x)
              (Nat.zero_add q)) := by
    intro X₁ X₂ f q p hp x
    rcases hp with ⟨hc, hr, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hι1, _, hp_eq⟩
    obtain rfl : hc = D.hCont_all f := Subsingleton.elim _ _
    obtain rfl : hr = D.hAdj_all f := Subsingleton.elim _ _
    obtain rfl : hAdd = D.hAdd_all f := Subsingleton.elim _ _
    obtain rfl : hLim = D.hLim_all f := Subsingleton.elim _ _
    obtain rfl : hColim = D.hColim_all f := Subsingleton.elim _ _
    rw [hp_eq x]
    let πℤ := @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) T₁ hT₁ T₂ hT₂ Aℤ
    have hι1' : ιℤ ≫ πℤ = 𝟙 _ := hι1
    have hι_eq : ιℤ = D.ιℤ_all f := by
      calc
        ιℤ = ιℤ ≫ (πℤ ≫ D.ιℤ_all f) := by
          rw [(hNorm.2.2.1 f T₁ hT₁ T₂ hT₂).2, CategoryTheory.Category.comp_id]
        _ = (ιℤ ≫ πℤ) ≫ D.ιℤ_all f := (CategoryTheory.Category.assoc _ _ _).symm
        _ = D.ιℤ_all f := by rw [hι1', CategoryTheory.Category.id_comp]
    have hπM_eq :
        @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f) T₁ hT₁ T₂ hT₂ AM =
        @weilEtaleConstPullbackHom _ _ f (D.hCont_all f) (D.hAdj_all f)
          _ (weilEtaleIdTerminalIsTerminal.{u} X₁)
          _ (weilEtaleIdTerminalIsTerminal.{u} X₂) AM :=
      hConstPull_indep f hT₁ (weilEtaleIdTerminalIsTerminal.{u} X₁)
