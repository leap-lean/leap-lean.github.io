        · exact not_le_of_gt hF_lt h1
        · exact h2 (le_of_lt hF_lt hw₀_F0) hw₀_Uα
      obtain ⟨hI₀_p, hzl₀⟩ := h_irred_vanishing_prime H₀
      obtain ⟨hI₁_p, hzl₁⟩ := h_irred_vanishing_prime H₁
      let I₀ := PrimeSpectrum.vanishingIdeal (H₀ : Set (PrimeSpectrum (C_cov α)))
      let I₁ := PrimeSpectrum.vanishingIdeal (H₁ : Set (PrimeSpectrum (C_cov α)))
