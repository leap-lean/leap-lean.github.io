        refine G₂.cond.hom_ext_ofArrows (j_c W) (hj_spec W).1 fun k_i => ?_
        have h_side : ∀ (i₀ : Idx_c U) (g₀ : W ⟶ V_c U i₀),
            (x_c U i₀ ≫ G₂.obj.map g₀.op) ≫ G₂.obj.map (j_c W k_i).op =
