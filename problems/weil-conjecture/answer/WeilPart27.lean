      exact CategoryTheory.ShortComplex.ShortExact.mk' hExact inferInstance inferInstance
    · intro Good hCov
      have hExt : ∀ (H G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (α β : H ⟶ G₂),
