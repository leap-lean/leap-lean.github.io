        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv).surjective
    exact h1.comp h2
  have hDim_cov : ∀ α : Fin r_cov, ringKrullDim (C_cov α) ≤ (m : WithBot ℕ∞) := by
    intro α
    have hhomeo : topologicalKrullDim ↥(U_cov α) = topologicalKrullDim (PrimeSpectrum (C_cov α)) :=
