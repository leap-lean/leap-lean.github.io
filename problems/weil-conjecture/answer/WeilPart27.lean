by
  classical
  
  have hSelfSplit : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
      [Module.Finite R S] [Algebra.Etale R S],
      ∃ (Q : Type u) (_ : CommRing Q) (_ : Algebra S Q),
        Module.Finite S Q ∧
        Algebra.Etale S Q ∧
        Nonempty (TensorProduct R S S ≃ₐ[S] S × Q) ∧
        (∀ q : PrimeSpectrum S,
          1 + Module.rankAtStalk Q q =
            Module.rankAtStalk S (PrimeSpectrum.comap (algebraMap R S) q)) := by
    intro R S _ _ _ _ _
    let S' := TensorProduct R S S
    have : Algebra.Etale S S' := Algebra.Etale.baseChange R S S
    have : Module.Finite S S' := Module.Finite.base_change R S S
    let μ_S : S' →ₐ[S] S :=
      { (Algebra.TensorProduct.lmul' R : S' →ₐ[R] S).toRingHom with
        commutes' := fun s => by
          change (Algebra.TensorProduct.lmul' R : S' →ₐ[R] S) (s ⊗ₜ[R] (1 : S)) = s
          simp }
    have hSurj_μ : Function.Surjective μ_S := fun s => ⟨s ⊗ₜ[R] 1, by
      change (Algebra.TensorProduct.lmul' R : S' →ₐ[R] S) (s ⊗ₜ[R] (1 : S)) = s
      simp⟩
    let I : Ideal S' := KaehlerDifferential.ideal R S
    have hI_ker : RingHom.ker μ_S.toRingHom = I := rfl
    have hFG : I.FG := by
      rw [← hI_ker]
      exact Algebra.FinitePresentation.ker_fG_of_surjective μ_S hSurj_μ
    have hSubΩ : Subsingleton I.Cotangent :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential (R := R) (A := S)
    have hIdem_I : IsIdempotentElem I := by
      change I * I = I
      rw [← pow_two]
      apply le_antisymm (Ideal.pow_le_self two_ne_zero)
      intro z hz
      have hz0 : I.toCotangent ⟨z, hz⟩ = 0 := @Subsingleton.elim _ hSubΩ _ _
      exact (Ideal.mem_toCotangent_ker I (x := ⟨z, hz⟩)).mp hz0
    obtain ⟨e, he, hI_span⟩ := (Ideal.isIdempotentElem_iff_of_fg I hFG).mp hIdem_I
    let f : S' := 1 - e
    have hf : IsIdempotentElem f := he.one_sub
    have hef_add : e + f = 1 := add_sub_cancel e 1
    have hef_mul : e * f = 0 := by
      dsimp [f]
      rw [mul_sub, mul_one, he.eq, sub_self]
    let Q := S' ⧸ Ideal.span ({f} : Set S')
    have hKer_eq : RingHom.ker μ_S = Ideal.span ({e} : Set S') := by
      change RingHom.ker μ_S.toRingHom = Ideal.span ({e} : Set S')
      rw [hI_ker, hI_span]
    let e_quot_S : (S' ⧸ Ideal.span ({e} : Set S')) ≃ₐ[S] S :=
      hKer_eq ▸ Ideal.quotientKerAlgEquivOfSurjective hSurj_μ
    let e_split : S' ≃ₐ[S] S × Q :=
      (AlgEquiv.prodQuotientOfIsIdempotentElem S he hf hef_add hef_mul).trans
        (e_quot_S.prodCongr (AlgEquiv.refl : Q ≃ₐ[S] Q))
    have hFinQ : Module.Finite S Q :=
      Module.Finite.of_surjective
        (Ideal.Quotient.mkₐ S (Ideal.span ({f} : Set S'))).toLinearMap
        Ideal.Quotient.mk_surjective
    have hKer_mk : RingHom.ker (Ideal.Quotient.mkₐ S (Ideal.span ({f} : Set S'))).toRingHom =
        Ideal.span ({f} : Set S') := Ideal.mk_ker
    have hFP_Q : Algebra.FinitePresentation S Q :=
      Algebra.FinitePresentation.of_surjective (f := Ideal.Quotient.mkₐ S (Ideal.span ({f} : Set S')))
        Ideal.Quotient.mk_surjective (by rw [hKer_mk]; exact Submodule.fg_span_singleton f)
    have hFE_prod : Algebra.FormallyEtale S (S × Q) :=
      (Algebra.FormallyEtale.iff_of_equiv e_split).mp inferInstance
    let instCR : ∀ b : Bool, CommRing (Bool.rec Q S b) :=
      @Bool.rec (fun b => CommRing (Bool.rec Q S b)) inferInstance inferInstance
    let instAlg : ∀ b : Bool, @Algebra S (Bool.rec Q S b) _ (instCR b).toSemiring :=
      @Bool.rec (fun b => @Algebra S (Bool.rec Q S b) _ (instCR b).toSemiring)
        inferInstance inferInstance
    letI : ∀ b : Bool, CommRing (Bool.rec Q S b) := instCR
    letI : ∀ b : Bool, Algebra S (Bool.rec Q S b) := instAlg
    let e_bool : (S × Q) ≃ₐ[S] (∀ b : Bool, Bool.rec Q S b) :=
      { toFun := fun x => Bool.rec x.2 x.1
        invFun := fun g => (g true, g false)
        left_inv := fun x => by cases x; rfl
        right_inv := fun g => funext fun b => by cases b <;> rfl
        map_mul' := fun x y => funext fun b => by cases b <;> rfl
        map_add' := fun x y => funext fun b => by cases b <;> rfl
        commutes' := fun s => funext fun b => by cases b <;> rfl }
    have hFE_pi : Algebra.FormallyEtale S (∀ b : Bool, Bool.rec Q S b) :=
      (Algebra.FormallyEtale.iff_of_equiv e_bool).mp hFE_prod
    have hFE_Q : Algebra.FormallyEtale S Q :=
      ((Algebra.FormallyEtale.pi_iff (Bool.rec Q S)).mp hFE_pi) false
    have hEt_Q : Algebra.Etale S Q := {}
    refine ⟨Q, inferInstance, inferInstance, hFinQ, hEt_Q, ⟨e_split⟩, ?_⟩
    intro q
    have h_bc : Module.rankAtStalk S' q =
        Module.rankAtStalk S (PrimeSpectrum.comap (algebraMap R S) q) :=
      Module.rankAtStalk_baseChange (R := R) (M := S) (S := S) q
    have h_eqv : Module.rankAtStalk S' q = Module.rankAtStalk (S × Q) q :=
      congr_fun (Module.rankAtStalk_eq_of_equiv e_split.toLinearEquiv) q
    have h_prd : Module.rankAtStalk (S × Q) q =
        Module.rankAtStalk S q + Module.rankAtStalk Q q :=
      congr_fun (Module.rankAtStalk_prod (R := S) S Q) q
    have : Nontrivial S := by
      refine ⟨⟨0, 1, fun h01 => q.isPrime.ne_top ?_⟩⟩
      rw [Ideal.eq_top_iff_one, ← h01]
      exact q.asIdeal.zero_mem
    have h_self : Module.rankAtStalk (R := S) S q = 1 :=
      congr_fun (Module.rankAtStalk_self (R := S)) q
    omega

  
  have hPiTriv : ∀ (δ : ℕ) (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      [Module.Finite A B] [Algebra.Etale A B],
      (∀ p : PrimeSpectrum A, Module.rankAtStalk B p = δ) →
      ∀ p₀ : PrimeSpectrum A,
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
        Algebra.Etale A C ∧
        (∃ q₀ : PrimeSpectrum C, PrimeSpectrum.comap (algebraMap A C) q₀ = p₀) ∧
        Nonempty (TensorProduct A C B ≃ₐ[C] (Fin δ → C)) := by
    intro δ
    induction δ with
    | zero =>
      intro A B _ _ _ _ _ hRk p₀
      have hRk0 : Module.rankAtStalk (R := A) B = 0 := funext hRk
      have : Subsingleton B :=
        (Module.rankAtStalk_eq_zero_iff_subsingleton (R := A) (M := B)).mp hRk0
      have : Subsingleton (TensorProduct A A B) :=
        (Algebra.TensorProduct.lid A B).injective.subsingleton
      have : Subsingleton (Fin 0 → A) := inferInstance
      refine ⟨A, inferInstance, inferInstance, inferInstance, ⟨p₀, PrimeSpectrum.ext rfl⟩, ⟨?_⟩⟩
      exact
        { toFun := fun _ => 0
          invFun := fun _ => 0
          left_inv := fun _ => Subsingleton.elim _ _
          right_inv := fun _ => Subsingleton.elim _ _
          map_mul' := fun _ _ => Subsingleton.elim _ _
          map_add' := fun _ _ => Subsingleton.elim _ _
          commutes' := fun _ => Subsingleton.elim _ _ }
    | succ r ih =>
      intro A B _ _ _ _ _ hRk p₀
      let K := p₀.asIdeal.ResidueField
      let p_K : PrimeSpectrum K := ⊥
      have hp_K : PrimeSpectrum.comap (algebraMap A K) p_K = p₀ :=
        PrimeSpectrum.ext (Ideal.ker_algebraMap_residueField p₀.asIdeal)
      have hRk_K : Module.rankAtStalk (TensorProduct A K B) p_K = r + 1 := by
        rw [Module.rankAtStalk_baseChange, hp_K, hRk p₀]
      have hNotSub : ¬ Subsingleton (TensorProduct A K B) := by
        intro hSub
        have h0 : Module.rankAtStalk (R := K) (TensorProduct A K B) = 0 :=
          (Module.rankAtStalk_eq_zero_iff_subsingleton (R := K) (M := TensorProduct A K B)).mpr hSub
        have : r + 1 = 0 := hRk_K.symm.trans (congr_fun h0 p_K)
        omega
      have : Nontrivial (TensorProduct A K B) := not_subsingleton_iff_nontrivial.mp hNotSub
      obtain ⟨𝔮⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr ‹Nontrivial (TensorProduct A K B)›
      let q_B : PrimeSpectrum B :=
        PrimeSpectrum.comap (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).toRingHom 𝔮
      have hq_B : PrimeSpectrum.comap (algebraMap A B) q_B = p₀ := by
        have h1 : PrimeSpectrum.comap (algebraMap K (TensorProduct A K B)) 𝔮 = p_K :=
          Subsingleton.elim _ _
        have h_comp : ((Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).toRingHom.comp
            (algebraMap A B)) = (algebraMap K (TensorProduct A K B)).comp (algebraMap A K) := by
          ext a
          exact (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).commutes a
        calc
          PrimeSpectrum.comap (algebraMap A B) q_B
            = PrimeSpectrum.comap
                ((Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).toRingHom.comp
                  (algebraMap A B)) 𝔮 := PrimeSpectrum.ext rfl
          _ = PrimeSpectrum.comap
                ((algebraMap K (TensorProduct A K B)).comp (algebraMap A K)) 𝔮 := by
                rw [h_comp]
          _ = PrimeSpectrum.comap (algebraMap A K)
                (PrimeSpectrum.comap (algebraMap K (TensorProduct A K B)) 𝔮) :=
                PrimeSpectrum.ext rfl
          _ = p₀ := by rw [h1, hp_K]
      obtain ⟨Q, hCommQ, hAlgBQ, hFinQ, hEtQ, ⟨e_split⟩, hRkQ_step⟩ := hSelfSplit A B
      let _ : CommRing Q := hCommQ
      let _ : Algebra B Q := hAlgBQ
      have hRkQ : ∀ q : PrimeSpectrum B, Module.rankAtStalk Q q = r := by
        intro q
        have hstep := hRkQ_step q
        rw [hRk] at hstep
        omega
      obtain ⟨C, hCommC, hAlgBC, hEtBC, ⟨q₀, hq₀⟩, ⟨e_rest⟩⟩ := ih B Q hRkQ q_B
      let _ : CommRing C := hCommC
      let _ : Algebra B C := hAlgBC
      let _ : Algebra A C := ((algebraMap B C).comp (algebraMap A B)).toAlgebra
      have : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.Etale A C := Algebra.Etale.comp A B C
      have hq₀_A : PrimeSpectrum.comap (algebraMap A C) q₀ = p₀ := by
        calc
          PrimeSpectrum.comap (algebraMap A C) q₀
            = PrimeSpectrum.comap (algebraMap A B) (PrimeSpectrum.comap (algebraMap B C) q₀) :=
              PrimeSpectrum.ext rfl
          _ = p₀ := by rw [hq₀, hq_B]
      let e_finCons : (C × (Fin r → C)) ≃ₐ[C] (Fin (r + 1) → C) :=
        { toFun := fun x => Fin.cons x.1 x.2
          invFun := fun g => (g 0, Fin.tail g)
          left_inv := fun x => by ext <;> simp
          right_inv := fun g => by ext i; refine Fin.cases ?_ ?_ i <;> simp [Fin.tail]
          map_mul' := fun x y => by ext i; refine Fin.cases ?_ ?_ i <;> simp
          map_add' := fun x y => by ext i; refine Fin.cases ?_ ?_ i <;> simp
          commutes' := fun c => by ext i; refine Fin.cases ?_ ?_ i <;> simp }
      let e_tot : TensorProduct A C B ≃ₐ[C] (Fin (r + 1) → C) :=
        (Algebra.TensorProduct.cancelBaseChange A B C C B).symm.trans
          (((Algebra.TensorProduct.congr (AlgEquiv.refl : C ≃ₐ[C] C) e_split).trans
            (Algebra.TensorProduct.prodRight B C C B Q)).trans
            (((Algebra.TensorProduct.rid B C C).prodCongr e_rest).trans e_finCons))
      exact ⟨C, inferInstance, inferInstance, inferInstance, ⟨q₀, hq₀_A⟩, ⟨e_tot⟩⟩

  
  let R₀ := MvPolynomial (Fin d) k
  let ψ_u := weilTopDegKummerChartEvalHom k d Y V u
  let B_g := Localization.Away g
  let A_g := Localization.Away (ψ_u g)
  let ψ_g : B_g →+* A_g := Localization.awayMap ψ_u g
  let _ : Algebra B_g A_g := ψ_g.toAlgebra
  have hSub_nzd : Submonoid.powers g ≤ nonZeroDivisors R₀ := by
    rw [Submonoid.powers_le]
    exact mem_nonZeroDivisors_of_ne_zero hg
  have : IsDomain B_g :=
    IsLocalization.isDomain_localization (M := Submonoid.powers g) hSub_nzd
  obtain ⟨p₀⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr (inferInstance : Nontrivial B_g)
  let eM_lin : M ≃ₗ[B_g] A_g :=
    { eM with
      map_smul' := fun b m => by
        change eM (b • m) = ψ_g b * eM m
        exact heM b m }
  let b_Ag : Module.Basis (Fin m_u) B_g A_g := bM.map eM_lin
  have : Module.Finite B_g A_g := Module.Finite.of_basis b_Ag
  have : Module.Free B_g A_g := Module.Free.of_basis b_Ag
  have hRk_Ag : ∀ p : PrimeSpectrum B_g, Module.rankAtStalk A_g p = m_u := by
    intro p
    rw [congr_fun (Module.rankAtStalk_eq_finrank_of_free (R := B_g) (M := A_g)) p,
      Module.finrank_eq_card_basis b_Ag, Fintype.card_fin]
    rfl
  have hEt_ψg : RingHom.Etale ψ_g :=
    RingHom.Etale.propertyIsLocal.localizationAwayPreserves ψ_u g B_g A_g hEt
  have : Algebra.Etale B_g A_g := RingHom.etale_algebraMap.mp hEt_ψg
  obtain ⟨C, hCommC, hAlgBgC, hEtBgC, ⟨q₀, _⟩, ⟨e_pi⟩⟩ := hPiTriv m_u B_g A_g hRk_Ag p₀
  let _ : CommRing C := hCommC
  let _ : Algebra B_g C := hAlgBgC

  
  obtain ⟨_, _, _, _, hπ_P_ov, hiso_Ug, hj_Γ_open, _, _, _, hj_Γ_P, hj_Γ_range⟩ := hRoof
  obtain ⟨_, hΦ_norm_all, _, hInj_all, _, hZeroMul_all, _, hNat_all, hConst_all, _⟩ := hNorm
  let E := AlgebraicGeometry.Spec (CommRingCat.of C)
  let v_B : Quiver.Hom E (AlgebraicGeometry.Spec (CommRingCat.of B_g)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_g C))
  let loc_g : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_g))
      (weilAffineSpaceOver k d).left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_g))
  have : AlgebraicGeometry.Etale v_B :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr hEtBgC)
  have : AlgebraicGeometry.IsOpenImmersion loc_g :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
  have : AlgebraicGeometry.IsOpenImmersion ι_d := hOpen_d
  let v_A : Quiver.Hom E (weilAffineSpaceOver k d).left :=
    CategoryTheory.CategoryStruct.comp v_B loc_g
  have hv_et : AlgebraicGeometry.Etale v_A := inferInstance
  have hEt_comp : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp v_A ι_d) :=
    inferInstance
  let j_P : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_g)) P_ov.left :=
    CategoryTheory.CategoryStruct.comp iso_Ug.inv U_g.ι
  have hvA_jP : CategoryTheory.CategoryStruct.comp v_A ι_d =
      CategoryTheory.CategoryStruct.comp v_B j_P := by
    dsimp [v_A, j_P]
    rw [CategoryTheory.Category.assoc, hiso_Ug]
    rfl
  have hRange_Ug : Set.range (CategoryTheory.CategoryStruct.comp v_A ι_d).base ⊆
      (U_g : Set ↥P_ov.left) := by
    rintro _ ⟨x, rfl⟩
    rw [hvA_jP]
    dsimp [j_P]
    change U_g.ι.base ((CategoryTheory.CategoryStruct.comp v_B iso_Ug.inv).base x) ∈
      (U_g : Set ↥P_ov.left)
    exact ((CategoryTheory.CategoryStruct.comp v_B iso_Ug.inv).base x).2
  let u_g : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g))
      (AlgebraicGeometry.Spec (CommRingCat.of B_g)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_g)
  have : AlgebraicGeometry.IsOpenImmersion j_P := inferInstance
  have : AlgebraicGeometry.IsOpenImmersion j_Γ := hj_Γ_open
  let l_P : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A_g))
      (CategoryTheory.Limits.pullback j_P π_P) :=
    CategoryTheory.Limits.pullback.lift u_g j_Γ hj_Γ_P.symm
  have hl_snd : CategoryTheory.CategoryStruct.comp l_P
      (CategoryTheory.Limits.pullback.snd j_P π_P) = j_Γ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have : AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.snd j_P π_P) :=
    inferInstance
  have : AlgebraicGeometry.IsOpenImmersion l_P := by
    have : AlgebraicGeometry.IsOpenImmersion
        (CategoryTheory.CategoryStruct.comp l_P (CategoryTheory.Limits.pullback.snd j_P π_P)) := by
      rw [hl_snd]; infer_instance
    exact AlgebraicGeometry.IsOpenImmersion.of_comp l_P (CategoryTheory.Limits.pullback.snd j_P π_P)
  have hSurj_lP : Function.Surjective l_P.base := by
    intro z
    have hz_mem : π_P.base ((CategoryTheory.Limits.pullback.snd j_P π_P).base z) ∈
        (U_g : Set ↥P_ov.left) := by
      have hcond := congrArg (fun f => f.base z)
        (CategoryTheory.Limits.pullback.condition (f := j_P) (g := π_P))
      change (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd j_P π_P) π_P).base z ∈ _
      rw [← hcond]
      exact (iso_Ug.inv.base ((CategoryTheory.Limits.pullback.fst j_P π_P).base z)).2
    have hz_pre : (CategoryTheory.Limits.pullback.snd j_P π_P).base z ∈ Set.range j_Γ.base := by
      rw [hj_Γ_range]; exact hz_mem
    obtain ⟨w, hw⟩ := hz_pre
    refine ⟨w, (CategoryTheory.Limits.pullback.snd j_P π_P).isOpenEmbedding.injective ?_⟩
    change (CategoryTheory.CategoryStruct.comp l_P (CategoryTheory.Limits.pullback.snd j_P π_P)).base w = _
    rw [hl_snd]
    exact hw
  have : CategoryTheory.Epi l_P.base := (TopCat.epi_iff_surjective l_P.base).mpr hSurj_lP
  have : CategoryTheory.IsIso l_P := AlgebraicGeometry.IsOpenImmersion.isIso l_P
  have hpb_roof : CategoryTheory.IsPullback u_g j_Γ j_P π_P :=
    CategoryTheory.IsPullback.of_iso_pullback ⟨hj_Γ_P.symm⟩ (CategoryTheory.asIso l_P)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _) hl_snd
  let u_E : Quiver.Hom E P_ov.left := CategoryTheory.CategoryStruct.comp v_A ι_d
  have hpb_paste : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst v_B u_g)
      (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd v_B u_g) j_Γ)
      u_E π_P := by
    change CategoryTheory.IsPullback _ _ (CategoryTheory.CategoryStruct.comp v_A ι_d) π_P
    rw [hvA_jP]
    exact (CategoryTheory.IsPullback.of_hasPullback v_B u_g).paste_vert hpb_roof
  let W_PB := CategoryTheory.Limits.pullback u_E π_P
  let fst := CategoryTheory.Limits.pullback.fst u_E π_P
  let snd := CategoryTheory.Limits.pullback.snd u_E π_P
  let e_pb : CategoryTheory.Iso W_PB (CategoryTheory.Limits.pullback v_B u_g) :=
    hpb_paste.isoPullback.symm
  have he_pb_fst : CategoryTheory.CategoryStruct.comp e_pb.hom
      (CategoryTheory.Limits.pullback.fst v_B u_g) = fst :=
    hpb_paste.isoPullback_inv_fst

  
  let R_π := Fin m_u → C
  let φ_inv : R_π →+* TensorProduct B_g C A_g := e_pi.symm.toRingHom
  let φ_hom : TensorProduct B_g C A_g →+* R_π := e_pi.toRingHom
  let e_pi_spec : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B_g C A_g)))
      (AlgebraicGeometry.Spec (CommRingCat.of R_π)) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_inv)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_hom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
        exact congrArg AlgebraicGeometry.Spec.map
          (CommRingCat.hom_ext (RingHom.ext fun x => e_pi.symm_apply_apply x))
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
        exact congrArg AlgebraicGeometry.Spec.map
          (CommRingCat.hom_ext (RingHom.ext fun x => e_pi.apply_symm_apply x)) }
  let Ψ : CategoryTheory.Iso W_PB (AlgebraicGeometry.Spec (CommRingCat.of R_π)) :=
    e_pb ≪≫ AlgebraicGeometry.pullbackSpecIso B_g C A_g ≪≫ e_pi_spec
  have hΨ_fst : CategoryTheory.CategoryStruct.comp Ψ.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C R_π))) = fst := by
    have h_alg : CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap C R_π)) (CommRingCat.ofHom φ_inv) =
        CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom :=
      CommRingCat.hom_ext (RingHom.ext fun c => e_pi.symm.commutes c)
    change (e_pb.hom ≫ (AlgebraicGeometry.pullbackSpecIso B_g C A_g).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_inv)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C R_π)) = fst
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, h_alg,
      AlgebraicGeometry.pullbackSpecIso_hom_fst B_g C A_g]
    exact he_pb_fst

  let π_ev : Fin m_u → (R_π →+* C) := fun j => Pi.evalRingHom (fun _ => C) j
  let τ_sh : Fin m_u → Quiver.Hom E (AlgebraicGeometry.Spec (CommRingCat.of R_π)) :=
    fun j => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_ev j))
  let s_sh : Fin m_u → Quiver.Hom E W_PB :=
    fun j => CategoryTheory.CategoryStruct.comp (τ_sh j) Ψ.inv
  have hs_fst : ∀ j : Fin m_u,
      CategoryTheory.CategoryStruct.comp (s_sh j) fst = CategoryTheory.CategoryStruct.id E := by
    intro j
    dsimp [s_sh, τ_sh]
    rw [← hΨ_fst, CategoryTheory.Category.assoc, Ψ.inv_hom_id_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
    exact congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext (RingHom.ext fun _ => rfl))
  have hs_et : ∀ j : Fin m_u, AlgebraicGeometry.Etale (s_sh j) := by
    intro j
    let _ : Algebra R_π C := (π_ev j).toAlgebra
    let e_j : R_π := Pi.single j 1
    have hLoc : IsLocalization.Away e_j C := by
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, m, rfl⟩
        change IsUnit ((π_ev j) (e_j ^ m))
        rw [map_pow]
        have hej : π_ev j e_j = 1 := Pi.single_eq_same j 1
        rw [hej, one_pow]
        exact isUnit_one
      · intro c
        exact ⟨(fun _ => c, 1), by simp [π_ev]; rfl⟩
      · intro x y hxy
        refine ⟨⟨e_j, 1, pow_one e_j⟩, ?_⟩
        ext i
        by_cases hij : i = j
        · subst hij
          change e_j i * x i = e_j i * y i
          have hx_eq : x i = y i := hxy
          rw [hx_eq]
        · change e_j i * x i = e_j i * y i
          have he0 : e_j i = 0 := Pi.single_eq_of_ne hij 1
          rw [he0, zero_mul, zero_mul]
    have : AlgebraicGeometry.IsOpenImmersion (τ_sh j) :=
      @AlgebraicGeometry.IsOpenImmersion.of_isLocalization R_π C _ _ _ e_j hLoc
    dsimp [s_sh]
    infer_instance

  let R_E := ↑(E.presheaf.obj (Opposite.op ⊤))
  let S_W := ↑(W_PB.presheaf.obj (Opposite.op ⊤))
  let iso_C := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)
  let iso_Rπ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_π)
  let iso_Ψ_top : W_PB.presheaf.obj (Opposite.op ⊤) ≅
      (AlgebraicGeometry.Spec (CommRingCat.of R_π)).presheaf.obj (Opposite.op ⊤) :=
    { hom := Ψ.inv.appTop
      inv := Ψ.hom.appTop
      hom_inv_id := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Ψ.hom_inv_id,
          AlgebraicGeometry.Scheme.Hom.id_appTop]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Ψ.inv_hom_id,
          AlgebraicGeometry.Scheme.Hom.id_appTop] }
  let Θ_RE : S_W ≃+* (Fin m_u → R_E) :=
    (iso_Ψ_top ≪≫ iso_Rπ).commRingCatIsoToRingEquiv.trans
      (RingEquiv.piCongrRight fun _ => iso_C.symm.commRingCatIsoToRingEquiv)
  have hΘ_eval : ∀ (w : S_W) (j : Fin m_u),
      Θ_RE w j = CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (s_sh j)) w := by
    intro w j
    apply iso_C.commRingCatIsoToRingEquiv.injective
    have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (π_ev j))
    have hs_top : (s_sh j).appTop = Ψ.inv.appTop ≫ (τ_sh j).appTop :=
      AlgebraicGeometry.Scheme.Hom.comp_appTop (τ_sh j) Ψ.inv
    have h1 : iso_C.hom.hom ((s_sh j).appTop.hom w) =
        (π_ev j) (iso_Rπ.hom.hom (Ψ.inv.appTop.hom w)) := by
      rw [hs_top]
      exact congrArg (fun f => f.hom (Ψ.inv.appTop.hom w)) hnat
    change iso_C.hom.hom (iso_C.inv.hom ((iso_Rπ.hom.hom (Ψ.inv.appTop.hom w)) j)) =
      iso_C.hom.hom ((s_sh j).appTop.hom w)
    rw [h1]
    change (iso_C.inv ≫ iso_C.hom).hom ((π_ev j) (iso_Rπ.hom.hom (Ψ.inv.appTop.hom w))) = _
    rw [iso_C.inv_hom_id]
    rfl

  
  let j₀ : Fin m_u := ⟨0, hm_u⟩
  let e₀ : R_π := Pi.single j₀ 1
  have he₀_mul : e₀ * (1 - e₀) = 0 := by
    ext j
    change e₀ j * (1 - e₀ j) = 0
    by_cases hj : j = j₀
    · rw [hj]
      have h1 : e₀ j₀ = 1 := Pi.single_eq_same j₀ 1
      rw [h1, sub_self, mul_zero]
    · have h0 : e₀ j = 0 := Pi.single_eq_of_ne hj 1
      rw [h0, zero_mul]
  let B₀ : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R_π)) :=
    (PrimeSpectrum.basicOpen e₀ : Set (PrimeSpectrum R_π))
  have hB₀_open : IsOpen B₀ := (PrimeSpectrum.basicOpen e₀).isOpen
  have hB₀_compl : B₀ᶜ = (PrimeSpectrum.basicOpen (1 - e₀) : Set (PrimeSpectrum R_π)) := by
    ext p
    change ¬ (e₀ ∉ p.asIdeal) ↔ 1 - e₀ ∉ p.asIdeal
    rw [Classical.not_not]
    constructor
    · intro hp h1
      have hsum : e₀ + (1 - e₀) = 1 := add_sub_cancel e₀ 1
      have hmem1 : (1 : R_π) ∈ p.asIdeal := hsum ▸ p.asIdeal.add_mem hp h1
      exact p.isPrime.one_notMem hmem1
    · intro hp
      have h0 : e₀ * (1 - e₀) ∈ p.asIdeal := by rw [he₀_mul]; exact p.asIdeal.zero_mem
      rcases p.isPrime.mem_or_mem h0 with h_in | h_in
      · exact h_in
      · exact False.elim (hp h_in)
  let S₀ : Set ↥W_PB := Ψ.hom.base ⁻¹' B₀
  have hS₀_open : IsOpen S₀ := Ψ.hom.base.hom.continuous.isOpen_preimage _ hB₀_open
  have hS₀_compl_open : IsOpen S₀ᶜ := by
    change IsOpen (Ψ.hom.base ⁻¹' B₀ᶜ)
    rw [hB₀_compl]
    exact Ψ.hom.base.hom.continuous.isOpen_preimage _ (PrimeSpectrum.basicOpen (1 - e₀)).isOpen
  have hLC_ind : ∀ a : ULift.{u} (ZMod n),
      IsLocallyConstant (fun y : ↥W_PB => if y ∈ S₀ then a else 0) := by
    intro a t
    by_cases ha : a ∈ t <;> by_cases h0 : (0 : ULift.{u} (ZMod n)) ∈ t
    · convert isOpen_univ
      ext y; simp only [Set.mem_preimage, Set.mem_univ, iff_true]; split_ifs <;> assumption
    · convert hS₀_open
      ext y; simp only [Set.mem_preimage]; split_ifs with hy <;> simp [hy, ha, h0]
    · convert hS₀_compl_open
      ext y; simp only [Set.mem_preimage, Set.mem_compl_iff]; split_ifs with hy <;> simp [hy, ha, h0]
    · convert isOpen_empty
      ext y; simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]; split_ifs <;> assumption
  let indHom : ULift.{u} (ZMod n) →+ LocallyConstant ↥W_PB (ULift.{u} (ZMod n)) :=
    { toFun := fun a => ⟨fun y => if y ∈ S₀ then a else 0, hLC_ind a⟩
      map_zero' := LocallyConstant.ext fun y => by simp
      map_add' := fun a b => LocallyConstant.ext fun y => by
        change (if y ∈ S₀ then a + b else 0) = (if y ∈ S₀ then a else 0) + (if y ∈ S₀ then b else 0)
        split_ifs <;> simp }
  have hind_eval : ∀ (a : ULift.{u} (ZMod n)) (j : Fin m_u) (x : ↥E),
      indHom a ((s_sh j).base x) = if j = j₀ then a else 0 := by
    intro a j x
    have h_comp_sh : CategoryTheory.CategoryStruct.comp (s_sh j) Ψ.hom = τ_sh j := by
      dsimp [s_sh]
      rw [CategoryTheory.Category.assoc, Ψ.inv_hom_id, CategoryTheory.Category.comp_id]
    have h_map : Ψ.hom.base ((s_sh j).base x) = (τ_sh j).base x :=
      (AlgebraicGeometry.Scheme.Hom.comp_apply (s_sh j) Ψ.hom x).symm.trans
        (congrArg (fun f => f.base x) h_comp_sh)
    change (if Ψ.hom.base ((s_sh j).base x) ∈ B₀ then a else 0) = if j = j₀ then a else 0
    rw [h_map]
    by_cases hj : j = j₀
    · rw [hj]
      have hmem : (τ_sh j₀).base x ∈ B₀ := by
        change (e₀ j₀ : C) ∉ x.asIdeal
        have he1 : e₀ j₀ = 1 := Pi.single_eq_same j₀ 1
        rw [he1]
        exact x.isPrime.one_notMem
      simp only [hmem, ↓reduceIte]
    · have hnmem : (τ_sh j).base x ∉ B₀ := by
        change ¬ (π_ev j e₀ ∉ x.asIdeal)
        rw [Classical.not_not]
        have he0 : π_ev j e₀ = 0 := Pi.single_eq_of_ne hj 1
        rw [he0]
        exact x.asIdeal.zero_mem
      simp only [hnmem, hj, ↓reduceIte]

  let U_E : P_ov.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ u_E hEt_comp
  let W_et : Γ.left.Etale := (weilEtaleSitePullback π_P).obj U_E
  have hZB : ∀ g₀ : LocallyConstant ↥W_PB (ULift.{u} (ZMod n)),
      g₀ ∈ weilAltZeroBdrySubgroup Γ.left V_Γ n W_et := by
    intro g₀ y hy_not
    exfalso
    apply hy_not
    rw [hV_Γ]
    change π_P.base (snd.base y) ∈ (U_g : Set ↥P_ov.left)
    have hcond : π_P.base (snd.base y) = u_E.base (fst.base y) := by
      have hc := congrArg (fun f => f.base y)
        (CategoryTheory.Limits.pullback.condition (f := u_E) (g := π_P))
      exact (AlgebraicGeometry.Scheme.Hom.comp_apply snd π_P y).symm.trans
        (hc.symm.trans (AlgebraicGeometry.Scheme.Hom.comp_apply fst u_E y))
    rw [hcond]
    exact hRange_Ug ⟨fst.base y, rfl⟩

  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let pf_K := (weilTopDegKummerZeroBdryPush D π_P).obj
    (weilTopDegKummerZeroBdryKSh D Γ.left V_Γ)
  let φ₀ : Quiver.Hom AM (pf_K.obj.obj (Opposite.op U_E)) :=
    AddCommGrpCat.ofHom
      { toFun := fun a => ⟨indHom a, hZB (indHom a)⟩
        map_zero' := Subtype.ext (map_zero indHom)
        map_add' := fun a b => Subtype.ext (map_add indHom a b) }
  let μ_σ : Quiver.Hom (weilEtaleLocalTorsionSheaf P_ov.left n U_E) pf_K :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm φ₀
  refine ⟨E, inferInstance, ⟨q₀⟩, v_A, hv_et, hEt_comp, μ_σ, ?_⟩

  
  let σ₁ : ↥(weilAltZeroBdrySubgroup Γ.left V_Γ n W_et) :=
    ⟨indHom (ULift.up (1 : ZMod n)), hZB (indHom (ULift.up (1 : ZMod n)))⟩
  let w₁ : S_W := D.ι_ζ Γ W_et σ₁.1
  let kMap_E : k →+* R_E :=
    CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
      (AlgebraicGeometry.Scheme.Hom.appTop
        (CategoryTheory.CategoryStruct.comp u_E P_ov.hom)))
  let c_ζ : R_E := kMap_E ((ζ : kˣ) : k)
  have h1_lt_n : Fact (1 < n) := ⟨by omega⟩

  have hw₁_sheet : ∀ j : Fin m_u,
      CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (s_sh j)) w₁ =
        if j = j₀ then c_ζ else 1 := by
    intro j
    letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEt_comp_j : AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp (s_sh j) W_et.hom) :=
      CategoryTheory.MorphismProperty.comp_mem _ (s_sh j) W_et.hom (hs_et j) W_et.prop
    let U'_j : Γ.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp (s_sh j) W_et.hom) hEt_comp_j
    let u_j : Quiver.Hom U'_j W_et :=
      CategoryTheory.MorphismProperty.Over.homMk (s_sh j) rfl trivial
    have h_nat_j : CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (s_sh j)) w₁ =
        D.ι_ζ Γ U'_j (((weilAltLocConstPresheaf Γ.left n).map (Opposite.op u_j)) σ₁.1) :=
      (hNat_all Γ u_j σ₁.1).symm
    refine h_nat_j.trans ?_
    by_cases hj : j = j₀
    · have h_pull_one : ((weilAltLocConstPresheaf Γ.left n).map (Opposite.op u_j)) σ₁.1 =
          LocallyConstant.const _ (ULift.up (1 : ZMod n)) := by
        apply LocallyConstant.ext
        intro x
        exact (hind_eval (ULift.up (1 : ZMod n)) j x).trans (by simp [hj])
      have h_over_j : CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget Γ.left).obj U'_j).hom) Γ.hom =
          CategoryTheory.CategoryStruct.comp u_E P_ov.hom := by
        change CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (s_sh j) snd) Γ.hom = _
        rw [← hπ_P_ov, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc snd π_P,
          ← CategoryTheory.Limits.pullback.condition (f := u_E) (g := π_P),
          CategoryTheory.Category.assoc fst u_E P_ov.hom,
          ← CategoryTheory.Category.assoc (s_sh j) fst, hs_fst j,
          CategoryTheory.Category.id_comp]
      have h_val_one : D.ι_ζ Γ U'_j (LocallyConstant.const _ (ULift.up (1 : ZMod n))) = c_ζ := by
        rw [hConst_all Γ U'_j 1, @ZMod.val_one n h1_lt_n, pow_one, h_over_j]
        rfl
      exact (congrArg (D.ι_ζ Γ U'_j) h_pull_one).trans
        (h_val_one.trans (by simp only [hj, ↓reduceIte]; rfl))
    · have h_pull_zero : ((weilAltLocConstPresheaf Γ.left n).map (Opposite.op u_j)) σ₁.1 = 0 := by
        apply LocallyConstant.ext
        intro x
        exact (hind_eval (ULift.up (1 : ZMod n)) j x).trans (by simp [hj]; rfl)
      exact (congrArg (D.ι_ζ Γ U'_j) h_pull_zero).trans
        (((hZeroMul_all Γ U'_j).1).trans (by simp only [hj, ↓reduceIte]; rfl))

  let M_U := Fin m_u → R_E
  let b_U : Module.Basis (Fin m_u) R_E M_U := Pi.basisFun R_E (Fin m_u)
  let e_U : M_U ≃+ S_W := Θ_RE.symm.toAddEquiv
  have hΘ_fst : ∀ r₀ : R_E,
      Θ_RE (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop fst) r₀) =
        fun _ => r₀ := by
    intro r₀
    ext j
    rw [hΘ_eval]
    change (fst.appTop ≫ (s_sh j).appTop).hom r₀ = r₀
    rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hs_fst j,
      AlgebraicGeometry.Scheme.Hom.id_appTop]
    rfl
  have h_smul_eU : ∀ (r₀ : R_E) (m : M_U),
      e_U (r₀ • m) =
        CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop fst) r₀ * e_U m := by
    intro r₀ m
    apply Θ_RE.injective
    have h1 : Θ_RE (e_U (r₀ • m)) = r₀ • m := Θ_RE.apply_symm_apply (r₀ • m)
    have h2 : Θ_RE (e_U m) = m := Θ_RE.apply_symm_apply m
    rw [h1, map_mul, hΘ_fst, h2]
    ext j
    rfl
  let d_vec : Fin m_u → R_E := fun j => if j = j₀ then c_ζ else 1
  have hΘ_w₁ : Θ_RE w₁ = d_vec := by
    ext j
    rw [hΘ_eval, hw₁_sheet]
  let L : M_U →ₗ[R_E] M_U :=
    { toFun := fun m j => d_vec j * m j
      map_add' := fun m₁ m₂ => funext fun j => mul_add (d_vec j) (m₁ j) (m₂ j)
      map_smul' := fun r₀ m => funext fun j => mul_left_comm (d_vec j) r₀ (m j) }
  have hL_mul : ∀ m : M_U, e_U (L m) = w₁ * e_U m := by
    intro m
    apply Θ_RE.injective
    have h1 : Θ_RE (e_U (L m)) = L m := Θ_RE.apply_symm_apply (L m)
    have h2 : Θ_RE (e_U m) = m := Θ_RE.apply_symm_apply m
    rw [h1, map_mul, hΘ_w₁, h2]
    rfl
  have hL_mat : LinearMap.toMatrix b_U b_U L = Matrix.diagonal d_vec := by
    ext i l
    rw [LinearMap.toMatrix_apply]
    have hb_l : b_U l = (Pi.single l 1 : M_U) := Pi.basisFun_apply R_E (Fin m_u) l
    have hb_repr : ∀ v : M_U, (b_U.repr v) i = v i := fun v => rfl
    rw [hb_repr, hb_l]
    let e_l : M_U := Pi.single l 1
    change d_vec i * e_l i = Matrix.diagonal d_vec i l
    by_cases hil : i = l
    · subst hil
      have he1 : e_l i = 1 := Pi.single_eq_same i 1
      rw [he1, mul_one, Matrix.diagonal_apply_eq]
    · have he0 : e_l i = 0 := Pi.single_eq_of_ne hil 1
      rw [he0, mul_zero, Matrix.diagonal_apply_ne _ hil]
  have hdet_L : ((LinearMap.toMatrix b_U b_U) L).det = c_ζ := by
    rw [hL_mat, Matrix.det_diagonal]
    simp [d_vec]
  have hτ_eval : D.ι_ζ P_ov U_E (((τ_norm.hom.app (Opposite.op U_E)).hom σ₁).1) = c_ζ := by
    have h := hτ U_E (inferInstance : AlgebraicGeometry.IsAffine E) hRange_Ug
      M_U _ _ b_U e_U h_smul_eU σ₁ L hL_mul
    exact h.trans hdet_L

  let Z := P_ov.left
  let J := Z.smallEtaleTopology
  let SubSh := weilTopDegKummerZeroBdrySubSh D P_ov.left U_g
  apply (CategoryTheory.cancel_mono (D.Φ_loc Z).hom).mp
  have h_cancel_inv : CategoryTheory.CategoryStruct.comp
      (CategoryTheory.CategoryStruct.comp μ_σ
        (CategoryTheory.CategoryStruct.comp τ_norm
          (CategoryTheory.CategoryStruct.comp SubSh (D.Φ_loc Z).inv)))
      (D.Φ_loc Z).hom =
      CategoryTheory.CategoryStruct.comp μ_σ (CategoryTheory.CategoryStruct.comp τ_norm SubSh) := by
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, (D.Φ_loc Z).inv_hom_id, CategoryTheory.Category.comp_id]
  rw [h_cancel_inv]
  apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
  have h_fy_comp : ∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (α : Quiver.Hom (weilEtaleLocalTorsionSheaf Z n U_E) F) (f : Quiver.Hom F G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.comp α f) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv α) (f.hom.app (Opposite.op U_E)) :=
    fun α f =>
      (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
        ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv_naturality_right α f)).trans
        (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)
  let T_Z := weilEtaleIdTerminal.{u} Z
  let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z
  let t_U : Quiver.Hom U_E T_Z := hT_Z.from U_E
  let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
  let P_AM := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj AM
  let η_const := shAdj.unit.app P_AM
  have h_lhs_fy : CategoryTheory.Sheaf.freeYonedaHomEquiv
      (CategoryTheory.CategoryStruct.comp μ_σ (CategoryTheory.CategoryStruct.comp τ_norm SubSh)) =
      CategoryTheory.CategoryStruct.comp φ₀
        ((CategoryTheory.CategoryStruct.comp τ_norm SubSh).hom.app (Opposite.op U_E)) := by
    rw [h_fy_comp]
    exact congrArg (CategoryTheory.CategoryStruct.comp · _)
      (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply φ₀)
  have h_unit_T : (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_Z).unit.app AM =
      η_const.app (Opposite.op T_Z) := by
    dsimp [CategoryTheory.constantSheafAdj]
    rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
      CategoryTheory.Category.id_comp]
    rfl
  have h_rhs_fy : CategoryTheory.Sheaf.freeYonedaHomEquiv
      (CategoryTheory.CategoryStruct.comp (weilEtaleLocalTorsionCounit Z n U_E) (D.Φ_loc Z).hom) =
      weilAltLocConstConstHom Z U_E n := by
    have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.CategoryStruct.comp (weilEtaleLocalTorsionCounit Z n U_E) (D.Φ_loc Z).hom) =
        CategoryTheory.CategoryStruct.comp
          (η_const.app (Opposite.op U_E)) ((D.Φ_loc Z).hom.hom.app (Opposite.op U_E)) :=
      (h_fy_comp (weilEtaleLocalTorsionCounit Z n U_E) (D.Φ_loc Z).hom).trans
        (congrArg (CategoryTheory.CategoryStruct.comp · _)
          (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _))
    have h_nat1 : η_const.app (Opposite.op U_E) =
        CategoryTheory.CategoryStruct.comp (η_const.app (Opposite.op T_Z))
          ((weilEtaleTorsionSheaf Z n).obj.map (Opposite.op t_U)) :=
      (CategoryTheory.Category.id_comp (η_const.app (Opposite.op U_E))).symm.trans
        (η_const.naturality (Opposite.op t_U))
    have h2 : CategoryTheory.CategoryStruct.comp
        (η_const.app (Opposite.op U_E)) ((D.Φ_loc Z).hom.hom.app (Opposite.op U_E)) =
        weilAltLocConstConstHom Z U_E n :=
      (congrArg (CategoryTheory.CategoryStruct.comp · ((D.Φ_loc Z).hom.hom.app (Opposite.op U_E)))
        h_nat1).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp _)
            ((D.Φ_loc Z).hom.hom.naturality (Opposite.op t_U))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (CategoryTheory.CategoryStruct.comp · _)
                ((congrArg (CategoryTheory.CategoryStruct.comp · _) h_unit_T.symm).trans
                  ((hΦ_norm_all Z T_Z hT_Z).1))).trans
                (AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl)))))
    exact h1.trans h2
  refine h_lhs_fy.trans (?_ :
    CategoryTheory.CategoryStruct.comp φ₀
      ((CategoryTheory.CategoryStruct.comp τ_norm SubSh).hom.app (Opposite.op U_E)) =
      weilAltLocConstConstHom Z U_E n) |>.trans h_rhs_fy.symm

  have : NeZero n := ⟨by omega⟩
  let lhs_hom := CategoryTheory.CategoryStruct.comp φ₀
    ((CategoryTheory.CategoryStruct.comp τ_norm SubSh).hom.app (Opposite.op U_E))
  have h_eq_one : lhs_hom.hom (ULift.up (1 : ZMod n)) =
      (weilAltLocConstConstHom Z U_E n).hom (ULift.up (1 : ZMod n)) := by
    apply hInj_all P_ov U_E
    have hLHS : D.ι_ζ P_ov U_E (lhs_hom.hom (ULift.up (1 : ZMod n))) = c_ζ := hτ_eval
    have hRHS : D.ι_ζ P_ov U_E ((weilAltLocConstConstHom Z U_E n).hom (ULift.up (1 : ZMod n))) = c_ζ := by
      change D.ι_ζ P_ov U_E (LocallyConstant.const _ (ULift.up (1 : ZMod n))) = c_ζ
      rw [hConst_all P_ov U_E 1, @ZMod.val_one n h1_lt_n, pow_one]
      rfl
    exact hLHS.trans hRHS.symm
  apply AddCommGrpCat.ext
  intro x
  let m : ℕ := (x : ULift.{u} (ZMod n)).down.val
  have hx_gen : x = m • (ULift.up (1 : ZMod n) : ↑AM) := by
    apply ULift.ext
    change (x : ULift.{u} (ZMod n)).down = m • (1 : ZMod n)
    rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
  calc
    lhs_hom.hom x
      = lhs_hom.hom (m • (ULift.up (1 : ZMod n) : ↑AM)) := congrArg lhs_hom.hom hx_gen
    _ = m • lhs_hom.hom (ULift.up (1 : ZMod n)) := map_nsmul lhs_hom.hom m _
    _ = m • (weilAltLocConstConstHom Z U_E n).hom (ULift.up (1 : ZMod n)) :=
        congrArg (m • ·) h_eq_one
    _ = (weilAltLocConstConstHom Z U_E n).hom (m • (ULift.up (1 : ZMod n) : ↑AM)) :=
        (map_nsmul (weilAltLocConstConstHom Z U_E n).hom m _).symm
    _ = (weilAltLocConstConstHom Z U_E n).hom x :=
        congrArg (weilAltLocConstConstHom Z U_E n).hom hx_gen.symm

theorem weil_top_deg_kummer_chart_pushforward_and_tower_norm (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (hd : 1 ≤ d)
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
