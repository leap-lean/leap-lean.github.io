                simp only [CategoryTheory.Category.assoc]
            _ = Φ_app U ≫ G₂.obj.map (j_c I.Y m ≫ (I.f ≫ w)).op := by
                rw [← G₂.obj.map_comp, ← op_comp, ← G₂.obj.map_comp, ← op_comp,
                  CategoryTheory.Category.assoc (j_c I.Y m) I.f w]
            _ = Φ_app U ≫ G₂.obj.map (j_c I.Y m ≫ (u₀ ≫ j_c U i)).op := by
                rw [← hfac]
            _ = (Φ_app U ≫ G₂.obj.map (j_c U i).op) ≫ G₂.obj.map (j_c I.Y m ≫ u₀).op := by
                rw [← CategoryTheory.Category.assoc (j_c I.Y m) u₀ (j_c U i), op_comp,
