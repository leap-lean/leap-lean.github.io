        apply lt_of_le_of_ne (PrimeSpectrum.vanishingIdeal_anti_mono (le_of_lt hH_lt))
        intro heq
        have hzl_eq : (H₁ : Set (PrimeSpectrum (C_cov α))) = (H₀ : Set (PrimeSpectrum (C_cov α))) := by
          rw [← hzl₁, ← hzl₀, heq]
