  have s6_assemble : ∀ (F : Type u) [Field F] [Algebra B₀ F] [IsFractionRing B₀ F]
      [∀ i : Fin c, (p_min i).IsPrime],
      (∀ i : Fin c, 1 ≤ e i ∧ 1 ≤ d_rk i) ∧
      (∀ (R : Type u) [CommRing R] [Algebra B₀ R] [Module.Flat B₀ R]
         (z : TensorProduct B₀ R B_s),
        Algebra.norm R z =
          Finset.univ.prod fun i : Fin c =>
            (Algebra.norm R (Algebra.TensorProduct.map (AlgHom.id R R) (ψ_comp i) z)) ^ (e i)) := by
    intro F _ _ _ _
    obtain ⟨h_pos, instAlgF, hArtFin, Φ_gen, θ, hΨ_eq⟩ := s3_genericDecomp F
    refine ⟨h_pos, fun R _ _ _ z => ?_⟩
    let R' := TensorProduct B₀ F R
    let ι_R : R →ₐ[B₀] R' := Algebra.TensorProduct.includeRight
    let _ : ∀ i : Fin c, Algebra F (Localization.AtPrime (p_min i)) := instAlgF
    have _ : ∀ i : Fin c, IsArtinianRing (Localization.AtPrime (p_min i)) :=
      fun i => (hArtFin i).1
    have _ : ∀ i : Fin c, FiniteDimensional F (Localization.AtPrime (p_min i)) :=
      fun i => (hArtFin i).2
