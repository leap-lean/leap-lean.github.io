          have h_ne_val : q₁.asIdeal ≠ m.1 := fun h => hq_in (h ▸ m.2)
          rw [if_neg h_ne_val, mul_zero]]
        symm
        apply hOffFib_zero z₁
        intro hz₁_eq
        have h_fs_q₁ : hTop_W₁.fromSpec.base q₁ = z₁.1 :=
          hTop_W₁.fromSpec_primeIdealOf ⟨g_W.left.base z_V.1, trivial⟩
        have h_comap_q₁ : Ideal.comap ρ₁ q₁.asIdeal = 𝔭 := by
          rw [← hFromSpec_iff p_fst_1 u_bar₁ q₁, h_fs_q₁]
          exact hz₁_eq
        exact hq_in (hM_fib_prime q₁.asIdeal q₁.isPrime h_comap_q₁)
    · push_neg at h_ex
      refine ⟨V₁, hu₀_V₁, 0, ?_⟩
      apply (hVal_C W₁).1
      funext z₁
      rw [map_zero, map_zero]
      exact (h_ex z₁).symm
  let V_fn : ↥U.left → U.left.Opens := fun u₀ => Classical.choose (hPointwise u₀)
  have hV_fn : ∀ u₀ : ↥U.left, u₀ ∈ V_fn u₀ :=
    fun u₀ => Classical.choose (Classical.choose_spec (hPointwise u₀))
  refine ⟨↥U.left,
    (fun u₀ => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp (V_fn u₀).ι U.hom)
      (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance) :
      ↥U.left → P₁_ov.left.Etale),
    (fun u₀ => CategoryTheory.MorphismProperty.Over.homMk (V_fn u₀).ι rfl),
    hCover_et U V_fn hV_fn,
    fun u₀ => Classical.choose_spec (Classical.choose_spec (hPointwise u₀))⟩

theorem weil_dvr_chart_two_call_norm_valuation_sum (k : Type u) [Field k] [IsAlgClosed k]
    (hDvrNorm : ∀ (R S : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
       [CommRing S] [Algebra k S] [Algebra R S] [IsScalarTower k R S]
       (δ : ℕ) (_ : 1 ≤ δ),
       (∀ r : R, ∃ c : k, r - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) →
       Nonempty (Module.Basis (Fin δ) R S) →
       (∀ (𝔪 : Ideal S), (h𝔪 : 𝔪.IsMaximal) →
         letI : 𝔪.IsPrime := h𝔪.isPrime
         ∃ hDom_m : IsDomain (Localization.AtPrime 𝔪),
           @IsDiscreteValuationRing (Localization.AtPrime 𝔪) _ hDom_m) →
       ∀ (a : S), a ∈ nonZeroDivisors S →
         Algebra.norm R a ≠ 0 ∧
         ∃ (M_max : Finset (Ideal S)) (ord_a : Ideal S → ℕ),
           (∀ 𝔪 : Ideal S, 𝔪 ∈ M_max ↔ 𝔪.IsMaximal) ∧
           (∀ (𝔪 : Ideal S) (h𝔪 : 𝔪.IsMaximal),
             letI : 𝔪.IsPrime := h𝔪.isPrime
             Ideal.span ({algebraMap S (Localization.AtPrime 𝔪) a} : Set (Localization.AtPrime 𝔪)) =
               (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) ^ (ord_a 𝔪)) ∧
           Ideal.span ({Algebra.norm R a} : Set R) =
             (IsLocalRing.maximalIdeal R) ^ (Finset.sum M_max ord_a))
    (δ : ℕ) (hδ : 1 ≤ δ)
    (R₀ S₀ : Type u) [CommRing R₀] [IsDomain R₀] [Algebra k R₀] [Algebra.FiniteType k R₀]
    [CommRing S₀] [Algebra k S₀] [Algebra R₀ S₀] [IsScalarTower k R₀ S₀]
    (M₀ : Type u) [AddCommGroup M₀] [Module R₀ M₀]
    (bM₀ : Module.Basis (Fin δ) R₀ M₀)
    (e₀ : M₀ ≃+ S₀)
    (he₀ : ∀ (r : R₀) (m : M₀), e₀ (r • m) = algebraMap R₀ S₀ r * e₀ m)
    (𝔭 : Ideal R₀) [𝔭.IsPrime] (h𝔭_max : 𝔭.IsMaximal)
    (hDVR_𝔭 : ∃ hDom_p : IsDomain (Localization.AtPrime 𝔭),
      @IsDiscreteValuationRing (Localization.AtPrime 𝔭) _ hDom_p)
    (hLocDVR₀ : ∀ (𝔪 : Ideal S₀) (h𝔪 : 𝔪.IsMaximal),
      Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭 →
      letI : 𝔪.IsPrime := h𝔪.isPrime
      ∃ hDom : IsDomain (Localization.AtPrime 𝔪),
        @IsDiscreteValuationRing (Localization.AtPrime 𝔪) _ hDom)
    (r₀ : R₀) (hr₀ : r₀ ≠ 0)
    (a₀ : S₀) (ha₀ : a₀ ∈ nonZeroDivisors S₀)
    (L : M₀ →ₗ[R₀] M₀)
    (hL : ∀ m : M₀, e₀ (L m) = a₀ * e₀ m) :
    ∃ (M_fib : Finset (Ideal S₀)) (N_a N_b : ℕ) (n_a n_b : Ideal S₀ → ℕ),
      (∀ 𝔪 : Ideal S₀, 𝔪 ∈ M_fib ↔ (𝔪.IsMaximal ∧ Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭)) ∧
      (let R := Localization.AtPrime 𝔭
       let a_R := algebraMap R₀ R (((LinearMap.toMatrix bM₀ bM₀) L).det)
       let b_R := algebraMap R₀ R (r₀ ^ δ)
       a_R ≠ 0 ∧ b_R ≠ 0 ∧
       Ideal.span ({a_R} : Set R) = (IsLocalRing.maximalIdeal R) ^ N_a ∧
       Ideal.span ({b_R} : Set R) = (IsLocalRing.maximalIdeal R) ^ N_b) ∧
      (∀ (𝔪 : Ideal S₀) (h𝔪 : 𝔪.IsMaximal),
        Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭 →
        letI : 𝔪.IsPrime := h𝔪.isPrime
        let S_𝔪 := Localization.AtPrime 𝔪
        let a_𝔪 := algebraMap S₀ S_𝔪 a₀
        let b_𝔪 := algebraMap S₀ S_𝔪 (algebraMap R₀ S₀ r₀)
        a_𝔪 ≠ 0 ∧ b_𝔪 ≠ 0 ∧
        Ideal.span ({a_𝔪} : Set S_𝔪) = (IsLocalRing.maximalIdeal S_𝔪) ^ (n_a 𝔪) ∧
        Ideal.span ({b_𝔪} : Set S_𝔪) = (IsLocalRing.maximalIdeal S_𝔪) ^ (n_b 𝔪)) ∧
      (N_a : ℤ) - (N_b : ℤ) = Finset.sum M_fib (fun 𝔪 => (n_a 𝔪 : ℤ) - (n_b 𝔪 : ℤ)) :=
by
  classical
  obtain ⟨hDom_R, hDVR_R⟩ := hDVR_𝔭
  let R : Type u := Localization.AtPrime 𝔭
  letI : IsDomain R := hDom_R
  letI : IsDiscreteValuationRing R := hDVR_R
  
  have hSurj_k : Function.Surjective (algebraMap k (R₀ ⧸ 𝔭)) := by
    letI : 𝔭.IsMaximal := h𝔭_max
    letI : Field (R₀ ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    haveI : Algebra.FiniteType k (R₀ ⧸ 𝔭) := inferInstance
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k (R₀ ⧸ 𝔭)
    have hs : s = 0 := by
      by_contra hs_ne
      let alg_mv : Algebra (MvPolynomial (Fin s) k) (R₀ ⧸ 𝔭) := g.toRingHom.toAlgebra
      have hInt_mv : @Algebra.IsIntegral (MvPolynomial (Fin s) k) (R₀ ⧸ 𝔭) _ _ alg_mv :=
        (@Algebra.isIntegral_def (MvPolynomial (Fin s) k) (R₀ ⧸ 𝔭) _ _ alg_mv).mpr hg_int
      have hField_mv : IsField (MvPolynomial (Fin s) k) :=
        (@Algebra.IsIntegral.isField_iff_isField (MvPolynomial (Fin s) k) (R₀ ⧸ 𝔭) _ _
          alg_mv hInt_mv _ hg_inj).mpr (Field.toIsField (R₀ ⧸ 𝔭))
      let i₀ : Fin s := ⟨0, Nat.pos_of_ne_zero hs_ne⟩
      have hX_ne : (MvPolynomial.X i₀ : MvPolynomial (Fin s) k) ≠ 0 := MvPolynomial.X_ne_zero i₀
      obtain ⟨q, hq⟩ := hField_mv.mul_inv_cancel hX_ne
      have hev := congrArg (MvPolynomial.eval (0 : Fin s → k)) hq
      rw [map_mul, MvPolynomial.eval_X, Pi.zero_apply, zero_mul, map_one] at hev
      exact zero_ne_one hev
    subst hs
    let e_mv : MvPolynomial (Fin 0) k ≃ₐ[k] k := MvPolynomial.isEmptyAlgEquiv k (Fin 0)
    have hg_comp : (algebraMap k (R₀ ⧸ 𝔭)).comp e_mv.toAlgHom.toRingHom = g.toRingHom := by
      apply RingHom.ext
      intro p
      have hp : e_mv.symm (e_mv p) = p := e_mv.symm_apply_apply p
      have hp2 : e_mv.symm (e_mv p) = algebraMap k (MvPolynomial (Fin 0) k) (e_mv p) := by
        simpa using e_mv.symm.commutes (e_mv p)
      change algebraMap k (R₀ ⧸ 𝔭) (e_mv p) = g p
      rw [← g.commutes (e_mv p), ← hp2, hp]
    have : Algebra.IsIntegral k (R₀ ⧸ 𝔭) := by
      rw [Algebra.isIntegral_def]
      intro x
      obtain ⟨P, hP_monic, hP_eval⟩ := hg_int x
      refine ⟨P.map e_mv.toAlgHom.toRingHom, hP_monic.map e_mv.toAlgHom.toRingHom, ?_⟩
      rw [Polynomial.eval₂_map, hg_comp]
      exact hP_eval
    exact (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := R₀ ⧸ 𝔭)).2
  have hRes_k : ∀ r : R, ∃ c : k, r - algebraMap k R c ∈ IsLocalRing.maximalIdeal R := by
    intro r
    obtain ⟨⟨u_r, v_r⟩, h_uv⟩ := IsLocalization.surj 𝔭.primeCompl r
    dsimp only at h_uv
    obtain ⟨c₁, hc₁⟩ := hSurj_k (Ideal.Quotient.mk 𝔭 u_r)
    obtain ⟨c₂, hc₂⟩ := hSurj_k (Ideal.Quotient.mk 𝔭 v_r.1)
    have hu_mem : u_r - algebraMap k R₀ c₁ ∈ 𝔭 :=
      Ideal.Quotient.eq.mp (hc₁.symm.trans (IsScalarTower.algebraMap_apply k R₀ (R₀ ⧸ 𝔭) c₁))
    have hv_mem : v_r.1 - algebraMap k R₀ c₂ ∈ 𝔭 :=
      Ideal.Quotient.eq.mp (hc₂.symm.trans (IsScalarTower.algebraMap_apply k R₀ (R₀ ⧸ 𝔭) c₂))
    have hc₂_ne : c₂ ≠ 0 := by
      intro hc₂_0
      subst hc₂_0
      rw [map_zero, sub_zero] at hv_mem
      exact v_r.2 hv_mem
    let c : k := c₁ / c₂
    refine ⟨c, ?_⟩
    have hc_mul : algebraMap k R₀ c * algebraMap k R₀ c₂ = algebraMap k R₀ c₁ := by
      rw [← map_mul, div_mul_cancel₀ c₁ hc₂_ne]
    have h_diff_p : u_r - algebraMap k R₀ c * v_r.1 ∈ 𝔭 := by
      have h_eq : u_r - algebraMap k R₀ c * v_r.1 =
          (u_r - algebraMap k R₀ c₁) - algebraMap k R₀ c * (v_r.1 - algebraMap k R₀ c₂) := by
        rw [mul_sub, hc_mul]
        ring
      rw [h_eq]
      exact Ideal.sub_mem 𝔭 hu_mem (Ideal.mul_mem_left 𝔭 _ hv_mem)
    have h_map_mem : algebraMap R₀ R (u_r - algebraMap k R₀ c * v_r.1) ∈
        IsLocalRing.maximalIdeal R := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.mem_map_of_mem (algebraMap R₀ R) h_diff_p
    have h_prod_mem : (r - algebraMap k R c) * algebraMap R₀ R v_r.1 ∈
        IsLocalRing.maximalIdeal R := by
      have h_eq : (r - algebraMap k R c) * algebraMap R₀ R v_r.1 =
          algebraMap R₀ R (u_r - algebraMap k R₀ c * v_r.1) := by
        rw [sub_mul, h_uv, map_sub, map_mul, ← IsScalarTower.algebraMap_apply k R₀ R c]
      rw [h_eq]
      exact h_map_mem
    let u_v : Rˣ := (IsLocalization.map_units R v_r).unit
    have hu_v_val : (u_v : R) = algebraMap R₀ R v_r.1 :=
      (IsLocalization.map_units R v_r).unit_spec
    have h_mul_inv := Ideal.mul_mem_right (↑u_v⁻¹ : R) (IsLocalRing.maximalIdeal R) h_prod_mem
    rwa [mul_assoc, ← hu_v_val, Units.mul_inv, mul_one] at h_mul_inv
  
  let e₀_lin : M₀ ≃ₗ[R₀] S₀ :=
    { toFun := e₀
      invFun := e₀.symm
      left_inv := e₀.left_inv
      right_inv := e₀.right_inv
      map_add' := e₀.map_add
      map_smul' := fun r m => by
        simp only [RingHom.id_apply, Algebra.smul_def]
        exact he₀ r m }
  let bS₀ : Module.Basis (Fin δ) R₀ S₀ := bM₀.map e₀_lin
  have h_r_nzd : ∀ {r : R₀}, r ≠ 0 → algebraMap R₀ S₀ r ∈ nonZeroDivisors S₀ := by
    intro r hr_ne
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have he0 : e₀ (r • e₀.symm x) = 0 := by
      rw [he₀, e₀.apply_symm_apply, mul_comm, hx]
    have hm0 : r • e₀.symm x = 0 := e₀.injective (he0.trans (map_zero e₀).symm)
    have hrepr0 : bM₀.repr (e₀.symm x) = 0 := by
      ext i
      have hi : bM₀.repr (r • e₀.symm x) i = 0 := by rw [hm0, map_zero, Finsupp.zero_apply]
      rw [map_smul, Finsupp.smul_apply, smul_eq_mul] at hi
      exact (mul_eq_zero.mp hi).resolve_left hr_ne
    have hsymm0 : e₀.symm x = 0 := bM₀.repr.injective (hrepr0.trans (map_zero bM₀.repr).symm)
    rw [← e₀.apply_symm_apply x, hsymm0, map_zero]
  let M_mult : Submonoid S₀ := Submonoid.map (algebraMap R₀ S₀) 𝔭.primeCompl
  let S : Type u := Localization M_mult
  have hM_nzd : M_mult ≤ nonZeroDivisors S₀ := by
    rintro y ⟨t, ht, rfl⟩
    apply h_r_nzd
    intro ht0
    subst ht0
    exact ht 𝔭.zero_mem
  have hInj_S₀S : Function.Injective (algebraMap S₀ S) :=
    IsLocalization.injective S hM_nzd
  let φ_RS : R →+* S :=
    IsLocalization.map S (algebraMap R₀ S₀) (Submonoid.le_comap_map 𝔭.primeCompl)
  letI : Algebra R S := φ_RS.toAlgebra
  have hφ_comp : ∀ r : R₀,
      algebraMap R S (algebraMap R₀ R r) = algebraMap S₀ S (algebraMap R₀ S₀ r) := by
    intro r
    exact RingHom.congr_fun
      (IsLocalization.map_comp (M := 𝔭.primeCompl) (S := R) (Q := S)
        (g := algebraMap R₀ S₀) (Submonoid.le_comap_map 𝔭.primeCompl)) r
  haveI : IsScalarTower k R S := by
    apply IsScalarTower.of_algebraMap_eq
    intro c
    rw [IsScalarTower.algebraMap_apply k S₀ S c,
      IsScalarTower.algebraMap_apply k R₀ S₀ c,
      ← hφ_comp,
      ← IsScalarTower.algebraMap_apply k R₀ R c]
  let v_S : Fin δ → S := fun j => algebraMap S₀ S (e₀ (bM₀ j))
  have hli_S : LinearIndependent R v_S := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i₀
    let surj_g := fun j : Fin δ => IsLocalization.surj 𝔭.primeCompl (g j)
    let num : Fin δ → R₀ := fun j => (Classical.choose (surj_g j)).1
    let den : Fin δ → 𝔭.primeCompl := fun j => (Classical.choose (surj_g j)).2
    have h_num_den : ∀ j : Fin δ,
        g j * algebraMap R₀ R (den j : R₀) = algebraMap R₀ R (num j) :=
      fun j => Classical.choose_spec (surj_g j)
    let T : 𝔭.primeCompl := ∏ l : Fin δ, den l
    let w : Fin δ → R₀ := fun j =>
      num j * ∏ l ∈ Finset.univ.erase j, (den l : R₀)
    have hT_mul : ∀ j : Fin δ,
        algebraMap R₀ R (T : R₀) * g j = algebraMap R₀ R (w j) := by
      intro j
      have hT_coe : (T : R₀) = (den j : R₀) * ∏ l ∈ Finset.univ.erase j, (den l : R₀) := by
        dsimp [T]
        rw [Submonoid.coe_finsetProd,
          ← Finset.mul_prod_erase Finset.univ (fun l : Fin δ => (den l : R₀)) (Finset.mem_univ j)]
      calc
        algebraMap R₀ R (T : R₀) * g j =
            (algebraMap R₀ R (den j : R₀) *
              algebraMap R₀ R (∏ l ∈ Finset.univ.erase j, (den l : R₀))) * g j := by
          rw [hT_coe, map_mul]
        _ = (g j * algebraMap R₀ R (den j : R₀)) *
              algebraMap R₀ R (∏ l ∈ Finset.univ.erase j, (den l : R₀)) := by ring
        _ = algebraMap R₀ R (w j) := by
          rw [h_num_den j]
          dsimp [w]
          rw [map_mul]
    have h_sum_S : algebraMap S₀ S (e₀ (∑ j : Fin δ, w j • bM₀ j)) = 0 := by
      have h0 : algebraMap R₀ R (T : R₀) • (∑ j : Fin δ, g j • v_S j) = 0 := by
        rw [hg, smul_zero]
      rw [Finset.smul_sum] at h0
      have h_term : ∀ j : Fin δ,
          algebraMap R₀ R (T : R₀) • (g j • v_S j) =
            algebraMap S₀ S (e₀ (w j • bM₀ j)) := by
        intro j
        rw [← mul_smul, hT_mul j, Algebra.smul_def, hφ_comp, ← map_mul, ← he₀]
      have h_sum_eq : (∑ j : Fin δ, algebraMap R₀ R (T : R₀) • (g j • v_S j)) =
          algebraMap S₀ S (e₀ (∑ j : Fin δ, w j • bM₀ j)) := by
        rw [map_sum, map_sum]
        exact Finset.sum_congr rfl fun j _ => h_term j
      exact h_sum_eq.symm.trans h0
    have h_sum_M₀ : (∑ j : Fin δ, w j • bM₀ j) = 0 :=
      e₀.injective (hInj_S₀S (h_sum_S.trans (by rw [map_zero, map_zero])))
    have hw0 : w i₀ = 0 :=
      Fintype.linearIndependent_iff.mp bM₀.linearIndependent w h_sum_M₀ i₀
    have hTg0 : algebraMap R₀ R (T : R₀) * g i₀ = 0 := by
      rw [hT_mul i₀, hw0, map_zero]
    have hT_ne : algebraMap R₀ R (T : R₀) ≠ 0 :=
      (IsLocalization.map_units R T).ne_zero
    exact (mul_eq_zero.mp hTg0).resolve_left hT_ne
  have hsp_S : ⊤ ≤ Submodule.span R (Set.range v_S) := by
    intro z _
    obtain ⟨⟨s₀, m⟩, h_sm⟩ := IsLocalization.surj M_mult z
    dsimp only at h_sm
    obtain ⟨t, ht, hm_eq⟩ := m.2
    let u_t : Rˣ := (IsLocalization.map_units R ⟨t, ht⟩).unit
    have hu_t_val : (u_t : R) = algebraMap R₀ R t :=
      (IsLocalization.map_units R ⟨t, ht⟩).unit_spec
    have hm_S : algebraMap S₀ S (m : S₀) = algebraMap R S (u_t : R) := by
      rw [← hm_eq, ← hφ_comp, hu_t_val]
    have hs₀_eq : algebraMap S₀ S s₀ =
        ∑ j : Fin δ, (algebraMap R₀ R (bM₀.repr (e₀.symm s₀) j)) • v_S j := by
      conv_lhs => rw [← e₀.apply_symm_apply s₀, ← bM₀.sum_repr (e₀.symm s₀)]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [he₀, map_mul, ← hφ_comp, ← Algebra.smul_def]
    have hz_eq : z =
        ∑ j : Fin δ, ((↑u_t⁻¹ : R) * algebraMap R₀ R (bM₀.repr (e₀.symm s₀) j)) • v_S j := by
      have h1 : (↑u_t⁻¹ : R) • (z * algebraMap S₀ S (m : S₀)) = z := by
        rw [hm_S, Algebra.smul_def]
        calc
          algebraMap R S (↑u_t⁻¹ : R) * (z * algebraMap R S (u_t : R)) =
              z * (algebraMap R S (u_t : R) * algebraMap R S (↑u_t⁻¹ : R)) := by ring
          _ = z * algebraMap R S ((u_t : R) * (↑u_t⁻¹ : R)) := by rw [map_mul]
          _ = z := by rw [Units.mul_inv, map_one, mul_one]
      rw [← h1, h_sm, hs₀_eq, Finset.smul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [mul_smul]
    rw [hz_eq]
    refine Submodule.sum_mem _ fun j _ => ?_
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  let b_S : Module.Basis (Fin δ) R S := Module.Basis.mk hli_S hsp_S
  have hb_S_apply : ∀ j : Fin δ, b_S j = v_S j := fun j => Module.Basis.mk_apply hli_S hsp_S j
  
  haveI : Module.Finite R₀ S₀ := Module.Finite.of_basis bS₀
  haveI : Algebra.IsIntegral R₀ S₀ := Algebra.IsIntegral.of_finite R₀ S₀
  haveI : Module.Finite R S := Module.Finite.of_basis b_S
  haveI : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
  have hComap_inj : ∀ {𝔐₁ 𝔐₂ : Ideal S}, 𝔐₁.IsPrime → 𝔐₂.IsPrime →
      Ideal.comap (algebraMap S₀ S) 𝔐₁ = Ideal.comap (algebraMap S₀ S) 𝔐₂ → 𝔐₁ = 𝔐₂ := by
    intro 𝔐₁ 𝔐₂ hP₁ hP₂ h_eq
    have h_iso : IsLocalization.orderIsoOfPrime M_mult S ⟨𝔐₁, hP₁⟩ =
        IsLocalization.orderIsoOfPrime M_mult S ⟨𝔐₂, hP₂⟩ := by
      apply Subtype.ext
      rw [IsLocalization.orderIsoOfPrime_apply_coe, IsLocalization.orderIsoOfPrime_apply_coe,
        Ideal.under_def, Ideal.under_def]
      exact h_eq
    exact congrArg Subtype.val ((IsLocalization.orderIsoOfPrime M_mult S).injective h_iso)
  have hMax_fwd : ∀ (𝔐 : Ideal S), 𝔐.IsMaximal →
      (Ideal.comap (algebraMap S₀ S) 𝔐).IsMaximal ∧
        Ideal.comap (algebraMap R₀ S₀) (Ideal.comap (algebraMap S₀ S) 𝔐) = 𝔭 := by
    intro 𝔐 h𝔐
    letI : 𝔐.IsMaximal := h𝔐
    letI : 𝔐.IsPrime := h𝔐.isPrime
    let 𝔪 : Ideal S₀ := Ideal.comap (algebraMap S₀ S) 𝔐
    letI : 𝔪.IsPrime := Ideal.comap_isPrime (algebraMap S₀ S) 𝔐
    have h_under_R_max : (Ideal.comap (algebraMap R S) 𝔐).IsMaximal := by
      rw [← Ideal.under_def]
      exact Ideal.IsMaximal.under R 𝔐
    have h_under_R_eq : Ideal.comap (algebraMap R S) 𝔐 = IsLocalRing.maximalIdeal R :=
      (IsLocalRing.isMaximal_iff R).mp h_under_R_max
    have h_comap_p : Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭 := by
      have h_step : Ideal.comap (algebraMap R₀ S₀) 𝔪 =
          Ideal.comap (algebraMap R₀ R) (Ideal.comap (algebraMap R S) 𝔐) := by
        ext r
        simp only [𝔪, Ideal.mem_comap, hφ_comp r]
      rw [h_step, h_under_R_eq, ← Ideal.under_def]
      exact Localization.AtPrime.under_maximalIdeal
    have h𝔪_max : 𝔪.IsMaximal := by
      letI : 𝔭.IsMaximal := h𝔭_max
      have h_int_hom : (algebraMap R₀ S₀).IsIntegral :=
        Algebra.isIntegral_def.mp inferInstance
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R₀ S₀) h_int_hom 𝔪
        (by rwa [h_comap_p])
    exact ⟨h𝔪_max, h_comap_p⟩
  have hLocDVR_S : ∀ (𝔐 : Ideal S), (h𝔐 : 𝔐.IsMaximal) →
      letI : 𝔐.IsPrime := h𝔐.isPrime
      ∃ hDom_m : IsDomain (Localization.AtPrime 𝔐),
        @IsDiscreteValuationRing (Localization.AtPrime 𝔐) _ hDom_m := by
    intro 𝔐 h𝔐
    letI : 𝔐.IsPrime := h𝔐.isPrime
    obtain ⟨h𝔪_max, h𝔪_comap⟩ := hMax_fwd 𝔐 h𝔐
    let 𝔪 : Ideal S₀ := Ideal.comap (algebraMap S₀ S) 𝔐
    letI : 𝔪.IsPrime := Ideal.comap_isPrime (algebraMap S₀ S) 𝔐
    obtain ⟨hDom_𝔪, hDVR_𝔪⟩ := hLocDVR₀ 𝔪 h𝔪_max h𝔪_comap
    letI : IsDomain (Localization.AtPrime 𝔪) := hDom_𝔪
    letI : IsDiscreteValuationRing (Localization.AtPrime 𝔪) := hDVR_𝔪
    let e_iso : Localization.AtPrime 𝔪 ≃ₐ[S₀] Localization.AtPrime 𝔐 :=
      IsLocalization.localizationLocalizationAtPrimeIsoLocalization M_mult 𝔐
    have hDom_𝔐 : IsDomain (Localization.AtPrime 𝔐) :=
      Function.Injective.isDomain e_iso.symm.toRingHom e_iso.symm.injective
    letI : IsDomain (Localization.AtPrime 𝔐) := hDom_𝔐
    exact ⟨hDom_𝔐,
      IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e_iso.toRingEquiv⟩
  let liftMax : ∀ (𝔪 : Ideal S₀),
      (𝔪.IsMaximal ∧ Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭) →
      { 𝔐 : Ideal S // 𝔐.IsMaximal ∧ Ideal.comap (algebraMap S₀ S) 𝔐 = 𝔪 } := by
    intro 𝔪 h
    letI : 𝔪.IsPrime := h.1.isPrime
    have hDisj : Disjoint (M_mult : Set S₀) (𝔪 : Set S₀) := by
      rw [Set.disjoint_left]
      rintro y ⟨t, ht, rfl⟩ hy_mem
      have ht_mem : t ∈ Ideal.comap (algebraMap R₀ S₀) 𝔪 := hy_mem
      rw [h.2] at ht_mem
      exact ht ht_mem
    let P_S := (IsLocalization.orderIsoOfPrime M_mult S).symm ⟨𝔪, h.1.isPrime, hDisj⟩
    let 𝔐 : Ideal S := P_S.1
    letI : 𝔐.IsPrime := P_S.2
    have h𝔐_comap : Ideal.comap (algebraMap S₀ S) 𝔐 = 𝔪 := by
      have h_app : (IsLocalization.orderIsoOfPrime M_mult S) P_S = ⟨𝔪, h.1.isPrime, hDisj⟩ :=
        (IsLocalization.orderIsoOfPrime M_mult S).apply_symm_apply _
      have h_coe := congrArg Subtype.val h_app
      rwa [IsLocalization.orderIsoOfPrime_apply_coe, Ideal.under_def] at h_coe
    let Q_R : Ideal R := Ideal.comap (algebraMap R S) 𝔐
    letI : Q_R.IsPrime := Ideal.comap_isPrime (algebraMap R S) 𝔐
    have hQ_comap : Ideal.comap (algebraMap R₀ R) Q_R = 𝔭 := by
      have h_step : Ideal.comap (algebraMap R₀ R) Q_R = Ideal.comap (algebraMap R₀ S₀) 𝔪 := by
        rw [← h𝔐_comap]
        ext r
        simp only [Q_R, Ideal.mem_comap, hφ_comp r]
      rw [h_step, h.2]
    have hQ_eq : Q_R = IsLocalRing.maximalIdeal R := by
      let m_R : Ideal R := IsLocalRing.maximalIdeal R
      letI : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal R
      letI : m_R.IsPrime := Ideal.IsMaximal.isPrime inferInstance
      have h_iso : IsLocalization.orderIsoOfPrime 𝔭.primeCompl R ⟨Q_R, inferInstance⟩ =
          IsLocalization.orderIsoOfPrime 𝔭.primeCompl R ⟨m_R, inferInstance⟩ := by
        apply Subtype.ext
        rw [IsLocalization.orderIsoOfPrime_apply_coe, IsLocalization.orderIsoOfPrime_apply_coe,
          Ideal.under_def, hQ_comap]
        exact Localization.AtPrime.under_maximalIdeal.symm
      exact congrArg Subtype.val ((IsLocalization.orderIsoOfPrime 𝔭.primeCompl R).injective h_iso)
    have hQ_max : Q_R.IsMaximal := by
      rw [hQ_eq]
      exact IsLocalRing.maximalIdeal.isMaximal R
    have h𝔐_max : 𝔐.IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R S)
        (Algebra.isIntegral_def.mp inferInstance) 𝔐 hQ_max
    exact ⟨𝔐, h𝔐_max, h𝔐_comap⟩
  
  let a : S := algebraMap S₀ S a₀
  let b₀ : S₀ := algebraMap R₀ S₀ r₀
  let b : S := algebraMap R S (algebraMap R₀ R r₀)
  have hb₀_nzd : b₀ ∈ nonZeroDivisors S₀ := h_r_nzd hr₀
  have hb_eq : b = algebraMap S₀ S b₀ := hφ_comp r₀
  have ha_nzd : a ∈ nonZeroDivisors S :=
    IsLocalization.map_nonZeroDivisors_le M_mult S ⟨a₀, ha₀, rfl⟩
  have hb_nzd : b ∈ nonZeroDivisors S := by
    rw [hb_eq]
    exact IsLocalization.map_nonZeroDivisors_le M_mult S ⟨b₀, hb₀_nzd, rfl⟩
  have hMat_a : Algebra.leftMulMatrix b_S a =
      (algebraMap R₀ R).mapMatrix ((LinearMap.toMatrix bM₀ bM₀) L) := by
    ext i j
    rw [Algebra.leftMulMatrix_eq_repr_mul, RingHom.mapMatrix_apply, Matrix.map_apply,
      LinearMap.toMatrix_apply]
    have h_mul_j : a * b_S j =
        ∑ l : Fin δ, (algebraMap R₀ R (bM₀.repr (L (bM₀ j)) l)) • b_S l := by
      calc
        a * b_S j = algebraMap S₀ S a₀ * algebraMap S₀ S (e₀ (bM₀ j)) := by
          rw [hb_S_apply]
        _ = algebraMap S₀ S (a₀ * e₀ (bM₀ j)) := (map_mul _ _ _).symm
        _ = algebraMap S₀ S (e₀ (L (bM₀ j))) := by rw [← hL (bM₀ j)]
        _ = algebraMap S₀ S (e₀ (∑ l : Fin δ, (bM₀.repr (L (bM₀ j)) l) • bM₀ l)) := by
          rw [bM₀.sum_repr (L (bM₀ j))]
        _ = ∑ l : Fin δ, (algebraMap R₀ R (bM₀.repr (L (bM₀ j)) l)) • b_S l := by
          rw [map_sum, map_sum]
          refine Finset.sum_congr rfl fun l _ => ?_
          rw [he₀, map_mul, ← hφ_comp, ← Algebra.smul_def, hb_S_apply]
    rw [h_mul_j, map_sum, Finsupp.finsetSum_apply]
    have h_single : ∀ l : Fin δ,
        (b_S.repr ((algebraMap R₀ R (bM₀.repr (L (bM₀ j)) l)) • b_S l)) i =
          if l = i then algebraMap R₀ R (bM₀.repr (L (bM₀ j)) l) else 0 := by
      intro l
      rw [map_smul, Finsupp.smul_apply, b_S.repr_self, smul_eq_mul, Finsupp.single_apply]
      split_ifs <;> ring
    simp_rw [h_single]
    simp
  have hNorm_a : Algebra.norm R a =
      algebraMap R₀ R (((LinearMap.toMatrix bM₀ bM₀) L).det) := by
    rw [Algebra.norm_eq_matrix_det b_S a, hMat_a, ← RingHom.map_det]
  have hNorm_b : Algebra.norm R b = algebraMap R₀ R (r₀ ^ δ) := by
    dsimp [b]
    rw [Algebra.norm_algebraMap_of_basis b_S (algebraMap R₀ R r₀), Fintype.card_fin, ← map_pow]
  
  obtain ⟨ha_norm_ne, M_max_a, ord_a, hM_a, hLoc_a, hSpan_norm_a⟩ :=
    hDvrNorm R S δ hδ hRes_k ⟨b_S⟩ hLocDVR_S a ha_nzd
  obtain ⟨hb_norm_ne, M_max_b, ord_b, hM_b, hLoc_b, hSpan_norm_b⟩ :=
    hDvrNorm R S δ hδ hRes_k ⟨b_S⟩ hLocDVR_S b hb_nzd
  have hM_eq : M_max_a = M_max_b :=
    Finset.ext fun 𝔐 => (hM_a 𝔐).trans (hM_b 𝔐).symm
  let M_fib : Finset (Ideal S₀) := M_max_a.image (Ideal.comap (algebraMap S₀ S))
  let N_a : ℕ := Finset.sum M_max_a ord_a
  let N_b : ℕ := Finset.sum M_max_b ord_b
  let n_a : Ideal S₀ → ℕ := fun 𝔪 =>
    if h : 𝔪.IsMaximal ∧ Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭 then
      ord_a (liftMax 𝔪 h).1
    else 0
  let n_b : Ideal S₀ → ℕ := fun 𝔪 =>
    if h : 𝔪.IsMaximal ∧ Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭 then
      ord_b (liftMax 𝔪 h).1
    else 0
  refine ⟨M_fib, N_a, N_b, n_a, n_b, ?_, ?_, ?_, ?_⟩
  · intro 𝔪
    dsimp [M_fib]
    rw [Finset.mem_image]
    constructor
    · rintro ⟨𝔐, h𝔐_mem, rfl⟩
      exact hMax_fwd 𝔐 ((hM_a 𝔐).mp h𝔐_mem)
    · intro h
      obtain ⟨𝔐, h𝔐_max, h𝔐_comap⟩ := liftMax 𝔪 h
      exact ⟨𝔐, (hM_a 𝔐).mpr h𝔐_max, h𝔐_comap⟩
  · dsimp only
    rw [hNorm_a] at ha_norm_ne hSpan_norm_a
    rw [hNorm_b] at hb_norm_ne hSpan_norm_b
    exact ⟨ha_norm_ne, hb_norm_ne, hSpan_norm_a, hSpan_norm_b⟩
  · intro 𝔪 h𝔪 h𝔪_comap
    letI : 𝔪.IsPrime := h𝔪.isPrime
    let S_𝔪 := Localization.AtPrime 𝔪
    let a_𝔪 := algebraMap S₀ S_𝔪 a₀
    let b_𝔪 := algebraMap S₀ S_𝔪 (algebraMap R₀ S₀ r₀)
    obtain ⟨hDom_𝔪, _⟩ := hLocDVR₀ 𝔪 h𝔪 h𝔪_comap
    letI : IsDomain S_𝔪 := hDom_𝔪
    have ha_𝔪_ne : a_𝔪 ≠ 0 :=
      nonZeroDivisors.ne_zero
        (IsLocalization.map_nonZeroDivisors_le 𝔪.primeCompl S_𝔪 ⟨a₀, ha₀, rfl⟩)
    have hb_𝔪_ne : b_𝔪 ≠ 0 :=
      nonZeroDivisors.ne_zero
        (IsLocalization.map_nonZeroDivisors_le 𝔪.primeCompl S_𝔪 ⟨b₀, hb₀_nzd, rfl⟩)
    have h_cond : 𝔪.IsMaximal ∧ Ideal.comap (algebraMap R₀ S₀) 𝔪 = 𝔭 := ⟨h𝔪, h𝔪_comap⟩
    let 𝔐 : Ideal S := (liftMax 𝔪 h_cond).1
    have h𝔐_max : 𝔐.IsMaximal := (liftMax 𝔪 h_cond).2.1
    have h𝔐_comap : Ideal.comap (algebraMap S₀ S) 𝔐 = 𝔪 := (liftMax 𝔪 h_cond).2.2
    letI : 𝔐.IsPrime := h𝔐_max.isPrime
    have hna_eq : n_a 𝔪 = ord_a 𝔐 := by
      dsimp [n_a, 𝔐]
      split_ifs
      rfl
    have hnb_eq : n_b 𝔪 = ord_b 𝔐 := by
      dsimp [n_b, 𝔐]
      split_ifs
      rfl
    have hLoc_𝔐 : IsLocalization 𝔪.primeCompl (Localization.AtPrime 𝔐) := by
      have h_sub_eq : (Ideal.comap (algebraMap S₀ S) 𝔐).primeCompl = 𝔪.primeCompl := by
        ext x
        simp only [Ideal.mem_primeCompl_iff, h𝔐_comap]
      have h_iso_prop : IsLocalization (Ideal.comap (algebraMap S₀ S) 𝔐).primeCompl
          (Localization.AtPrime 𝔐) :=
        IsLocalization.isLocalization_atPrime_localization_atPrime M_mult 𝔐
      rwa [h_sub_eq] at h_iso_prop
    let e_loc : S_𝔪 ≃ₐ[S₀] Localization.AtPrime 𝔐 :=
      @IsLocalization.algEquiv S₀ _ 𝔪.primeCompl S_𝔪 _ _ _
        (Localization.AtPrime 𝔐) _ _ hLoc_𝔐
    have he_symm_max : Ideal.map e_loc.symm.toRingEquiv
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐)) =
        IsLocalRing.maximalIdeal S_𝔪 := by
      have h_max : (Ideal.map e_loc.symm.toRingEquiv
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐))).IsMaximal :=
        Ideal.map_isMaximal_of_equiv e_loc.symm.toRingEquiv
      exact (IsLocalRing.isMaximal_iff S_𝔪).mp h_max
    have he_symm_a : e_loc.symm.toRingEquiv (algebraMap S (Localization.AtPrime 𝔐) a) = a_𝔪 := by
      apply e_loc.injective
      change e_loc (e_loc.symm _) = _
      rw [e_loc.apply_symm_apply]
      dsimp [a, a_𝔪]
      rw [← IsScalarTower.algebraMap_apply S₀ S (Localization.AtPrime 𝔐) a₀]
      exact (e_loc.commutes a₀).symm
    have he_symm_b : e_loc.symm.toRingEquiv (algebraMap S (Localization.AtPrime 𝔐) b) = b_𝔪 := by
      apply e_loc.injective
      change e_loc (e_loc.symm _) = _
      rw [e_loc.apply_symm_apply, hb_eq]
      dsimp [b₀, b_𝔪]
      rw [← IsScalarTower.algebraMap_apply S₀ S (Localization.AtPrime 𝔐) (algebraMap R₀ S₀ r₀)]
      exact (e_loc.commutes (algebraMap R₀ S₀ r₀)).symm
    have hSpan_a_𝔪 : Ideal.span ({a_𝔪} : Set S_𝔪) =
        (IsLocalRing.maximalIdeal S_𝔪) ^ (n_a 𝔪) := by
      have h_sp := congrArg (Ideal.map e_loc.symm.toRingEquiv) (hLoc_a 𝔐 h𝔐_max)
      rw [Ideal.map_span, Set.image_singleton, he_symm_a, Ideal.map_pow,
        he_symm_max, ← hna_eq] at h_sp
      exact h_sp
    have hSpan_b_𝔪 : Ideal.span ({b_𝔪} : Set S_𝔪) =
        (IsLocalRing.maximalIdeal S_𝔪) ^ (n_b 𝔪) := by
      have h_sp := congrArg (Ideal.map e_loc.symm.toRingEquiv) (hLoc_b 𝔐 h𝔐_max)
      rw [Ideal.map_span, Set.image_singleton, he_symm_b, Ideal.map_pow,
        he_symm_max, ← hnb_eq] at h_sp
      exact h_sp
    exact ⟨ha_𝔪_ne, hb_𝔪_ne, hSpan_a_𝔪, hSpan_b_𝔪⟩
  · have hInjOn : Set.InjOn (Ideal.comap (algebraMap S₀ S)) ↑M_max_a := by
      intro 𝔐₁ h₁ 𝔐₂ h₂ h_eq
      exact hComap_inj
        (((hM_a 𝔐₁).mp (Finset.mem_coe.mp h₁)).isPrime)
        (((hM_a 𝔐₂).mp (Finset.mem_coe.mp h₂)).isPrime)
        h_eq
    have h_sum_img : Finset.sum M_fib (fun 𝔪 => (n_a 𝔪 : ℤ) - (n_b 𝔪 : ℤ)) =
        Finset.sum M_max_a (fun 𝔐 => (ord_a 𝔐 : ℤ) - (ord_b 𝔐 : ℤ)) := by
      dsimp [M_fib]
      rw [Finset.sum_image hInjOn]
      refine Finset.sum_congr rfl fun 𝔐 h𝔐_mem => ?_
      have h𝔐_max : 𝔐.IsMaximal := (hM_a 𝔐).mp h𝔐_mem
      have h_cond := hMax_fwd 𝔐 h𝔐_max
      have h_lift_eq : (liftMax (Ideal.comap (algebraMap S₀ S) 𝔐) h_cond).1 = 𝔐 :=
        hComap_inj
          (liftMax (Ideal.comap (algebraMap S₀ S) 𝔐) h_cond).2.1.isPrime
          h𝔐_max.isPrime
          (liftMax (Ideal.comap (algebraMap S₀ S) 𝔐) h_cond).2.2
      have hna : n_a (Ideal.comap (algebraMap S₀ S) 𝔐) = ord_a 𝔐 := by
        dsimp [n_a]
        split_ifs
        exact congrArg ord_a h_lift_eq
      have hnb : n_b (Ideal.comap (algebraMap S₀ S) 𝔐) = ord_b 𝔐 := by
        dsimp [n_b]
        split_ifs
        exact congrArg ord_b h_lift_eq
      rw [hna, hnb]
    rw [h_sum_img, Finset.sum_sub_distrib, ← Nat.cast_sum, ← Nat.cast_sum]
    dsimp [N_a, N_b]
    rw [hM_eq]

theorem weil_etale_smooth_curve_weil_divisor_norm_ladder (k : Type u) [Field k] [IsAlgClosed k]
    (hDvrNorm : ∀ (R S : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
       [CommRing S] [Algebra k S] [Algebra R S] [IsScalarTower k R S]
       (δ : ℕ) (_ : 1 ≤ δ),
       (∀ r : R, ∃ c : k, r - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) →
       Nonempty (Module.Basis (Fin δ) R S) →
       (∀ (𝔪 : Ideal S), (h𝔪 : 𝔪.IsMaximal) →
         letI : 𝔪.IsPrime := h𝔪.isPrime
         ∃ hDom_m : IsDomain (Localization.AtPrime 𝔪),
           @IsDiscreteValuationRing (Localization.AtPrime 𝔪) _ hDom_m) →
       ∀ (a : S), a ∈ nonZeroDivisors S →
         Algebra.norm R a ≠ 0 ∧
         ∃ (M_max : Finset (Ideal S)) (ord_a : Ideal S → ℕ),
           (∀ 𝔪 : Ideal S, 𝔪 ∈ M_max ↔ 𝔪.IsMaximal) ∧
           (∀ (𝔪 : Ideal S) (h𝔪 : 𝔪.IsMaximal),
             letI : 𝔪.IsPrime := h𝔪.isPrime
             Ideal.span ({algebraMap S (Localization.AtPrime 𝔪) a} : Set (Localization.AtPrime 𝔪)) =
               (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) ^ (ord_a 𝔪)) ∧
           Ideal.span ({Algebra.norm R a} : Set R) =
             (IsLocalRing.maximalIdeal R) ^ (Finset.sum M_max ord_a))
    (hGmSheaf : ∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X))
    (C P₁_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper C.hom]
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    [AlgebraicGeometry.IsProper P₁_ov.hom]
    [AlgebraicGeometry.IsIntegral P₁_ov.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁_ov.hom]
    (hKSheaf_C : CategoryTheory.Presheaf.IsSheaf C.left.smallEtaleTopology (weilEtaleKPresheaf C.left))
    (hKSheaf_1 : CategoryTheory.Presheaf.IsSheaf P₁_ov.left.smallEtaleTopology (weilEtaleKPresheaf P₁_ov.left))
