    intro S_k J_k T_0 hT_0 AM pb_of p₁ T_1 R2_1 P_F1 η_sh_p₁ adj_0 η_AM πM_of
    let pf_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
