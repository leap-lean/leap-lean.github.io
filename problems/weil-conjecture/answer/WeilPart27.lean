        CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q F) := by
    intro X S f q F
    exact ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).comp
      (((CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
        AddCommGrpCat.{u}).obj (weilEtaleSitePullback f).op).comp
        (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}))).map_id F
  have hR_comp : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) (q : ℕ)
      {F₁ F₂ F₃ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : Quiver.Hom F₁ F₂) (ψ : Quiver.Hom F₂ F₃),
      weilTopDegKummerHigherDirectImageMap f q (φ ≫ ψ) =
        weilTopDegKummerHigherDirectImageMap f q φ ≫
          weilTopDegKummerHigherDirectImageMap f q ψ := by
    intro X S f q F₁ F₂ F₃ φ ψ
    exact ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).comp
      (((CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
        AddCommGrpCat.{u}).obj (weilEtaleSitePullback f).op).comp
        (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}))).map_comp φ ψ
  have hR_unit_app : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) (q : ℕ)
      {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : Quiver.Hom F₁ F₂) (V : S.Etale)
      (s : ↑((CategoryTheory.Sheaf.cohomologyPresheaf F₁ q).obj
        (Opposite.op ((weilEtaleSitePullback f).obj V)))),
      let η₁ := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
        AddCommGrpCat.{u}).unit.app
        (CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
          (CategoryTheory.Sheaf.cohomologyPresheaf F₁ q))
      let η₂ := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
        AddCommGrpCat.{u}).unit.app
        (CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
          (CategoryTheory.Sheaf.cohomologyPresheaf F₂ q))
      ((weilTopDegKummerHigherDirectImageMap f q φ).hom.app (Opposite.op V)).hom
        ((η₁.app (Opposite.op V)).hom s) =
      (η₂.app (Opposite.op V)).hom
        (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
          (weilPolyP1CohomologyRepSheaf X ((weilEtaleSitePullback f).obj V))
          (Nat.add_zero q)) s) := by
    intro X S f q F₁ F₂ φ V s η₁ η₂
    let ψ_P := CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).map φ)
    have hnat := ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
      AddCommGrpCat.{u}).unit.naturality ψ_P).symm
    have h_ev := congrArg (fun τ => (τ.app (Opposite.op V)).hom s) hnat
    change ((weilTopDegKummerHigherDirectImageMap f q φ).hom.app (Opposite.op V)).hom
        ((η₁.app (Opposite.op V)).hom s) =
      (η₂.app (Opposite.op V)).hom ((ψ_P.app (Opposite.op V)).hom s) at h_ev
    rw [h_ev]
    congr 1
  have hTermPres_nonempty : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
      {T₂ : X₂.Etale} (_ : CategoryTheory.Limits.IsTerminal T₂),
      Nonempty (CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T₂)) := by
    intro X₁ X₂ f T₂ hT₂
    let B := weilEtaleSitePullback f
    have : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback f) :=
