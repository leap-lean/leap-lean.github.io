            have h4 : ψ_rs (algebraMap R₂ C₂ a₂) = algebraMap R₁ C₁ (φ₂₁ a₂) :=
              h_away_eq φ₂₁ (r * s) a₂
            rw [h1, h2, h3, h4]
          
          let ψ_C : (Fin δ → C₂) →ₗ[C₂] C₁ :=
            { toFun := fun g => ∑ j : Fin δ, g j • β_s (e_s (b_s j))
