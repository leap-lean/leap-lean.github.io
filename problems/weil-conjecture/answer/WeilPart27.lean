      AlgebraicGeometry.IsOpenImmersion j_Γ →
      iso_Ug.inv ≫ U_g.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) ≫ ι_d' →
