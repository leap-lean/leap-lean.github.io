    fun f => ⟨(hSpec.1 f).1, (hSpec.1 f).2.1, (hSpec.1 f).2.2.1⟩
  have hR_id : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) (q : ℕ)
      (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
