        intro q hq
        let q' : ↥(AlgebraicGeometry.Spec (Z₀_ov.left.presheaf.obj (Opposite.op (U_cov α)))) := q
        have hfrom : (hAff_cov α).fromSpec.base q' = (e_specα.symm q).1 := by
          have h_inv_app : (hAff_cov α).isoSpec.inv.base q' = e_specα.symm q := by
