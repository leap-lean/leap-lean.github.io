            obtain ⟨⟨p_K, ⟨K, hp_K⟩⟩, hK_xy⟩ :=
              (IsLocalization.map_eq_zero_iff (Submonoid.powers (φ₂₁ (r * s))) C₁ _).mp hx_C₁
            have hK_xy' : (φ₂₁ (r * s)) ^ K * x_y = 0 := by
              have hp_K' : (φ₂₁ (r * s)) ^ K = p_K := hp_K
              rw [hp_K']
              exact hK_xy
            let φs_inv : Localization.Away (φ₂₁ s) :=
              IsLocalization.Away.invSelf (S := Localization.Away (φ₂₁ s)) (φ₂₁ s)
            have hφs_inv : algebraMap R₁ (Localization.Away (φ₂₁ s)) (φ₂₁ s) * φs_inv = 1 :=
              IsLocalization.Away.mul_invSelf (φ₂₁ s)
            have hys_K :
