  obtain ⟨hj_Γ₁_range, ⟨pt_V1⟩⟩ := h_chart_cancel g₁ hg₁ ψ₁ g_map_1 hψ₁_inj hg₁_ov hj_W_g₁ hFin_g₁
  obtain ⟨hj_Γ₂_range, ⟨pt_V2⟩⟩ := h_chart_cancel g₂ hg₂ ψ₂ g_map_2 hψ₂_inj hg₂_ov hj_W_g₂ hFin_g₂

  let V_12 : Γ.left.Opens :=
