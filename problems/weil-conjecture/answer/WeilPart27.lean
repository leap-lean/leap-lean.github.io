      let η₂ : Aℤ ⟶ Fℤ₂.obj.obj (Opposite.op T₂) :=
        adj_c₂.unit.app Aℤ
      let η₃ : Aℤ ⟶ Fℤ₃.obj.obj (Opposite.op T₃) :=
        adj_c₃.unit.app Aℤ
