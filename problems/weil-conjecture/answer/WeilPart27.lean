      { z : { z : ↥(B.obj U₂).left //
          IsClosed ({(B.obj U₂).hom.base z} : Set ↥C.left) } //
        (CategoryTheory.Limits.pullback.fst U₂.hom u).base z.1 = y₂.1 } :=
      fun z₁ =>
        ⟨⟨(B.map g).left.base z₁.1.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
            CategoryTheory.MorphismProperty.Over.w (B.map g)]
          exact z₁.1.2⟩, by
          have h1 := congrArg (fun φ => φ.base z₁.1.1) hg_fst
          exact h1.trans (congrArg g.left.base z₁.2)⟩
    have hy_base_eq : U₂.hom.base y₂.1 = U₁.hom.base y₁.1 := by
      change (g.left ≫ U₂.hom).base y₁.1 = U₁.hom.base y₁.1
      rw [CategoryTheory.MorphismProperty.Over.w g]
    let e_base : { x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) } //
        u.base x.1 = U₂.hom.base y₂.1 } ≃
      { x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) } //
        u.base x.1 = U₁.hom.base y₁.1 } :=
      { toFun := fun x => ⟨x.1, x.2.trans hy_base_eq⟩
        invFun := fun x => ⟨x.1, x.2.trans hy_base_eq.symm⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl }
    have hG_comm : (e_base ∘ π_fib U₂ y₂) ∘ G = π_fib U₁ y₁ := by
      ext z₁ : 1
      apply Subtype.ext
      apply Subtype.ext
      change ((B.map g).left ≫ (B.obj U₂).hom).base z₁.1.1 = (B.obj U₁).hom.base z₁.1.1
      rw [CategoryTheory.MorphismProperty.Over.w (B.map g)]
    have h_ebase_bij : Function.Bijective (e_base ∘ π_fib U₂ y₂) :=
      e_base.bijective.comp (hBij_fib U₂ y₂)
    have hG_bij : Function.Bijective G := by
      refine ⟨fun a b hab => ?_, fun z₂ => ?_⟩
      · apply (hBij_fib U₁ y₁).1
        rw [← hG_comm]
        exact congrArg (e_base ∘ π_fib U₂ y₂) hab
      · obtain ⟨x₁, hx₁⟩ := (hBij_fib U₁ y₁).2 ((e_base ∘ π_fib U₂ y₂) z₂)
