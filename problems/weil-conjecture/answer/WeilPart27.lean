      let H₀ : TopologicalSpace.IrreducibleCloseds (PrimeSpectrum (C_cov α)) :=
        { carrier := e_specα.symm ⁻¹' ((Subtype.val : ↥(U_cov α) → _) ⁻¹' F₀_Z₀)
          isIrreducible' :=
            ⟨⟨e_specα ⟨w₀, hw₀_Uα⟩, by
