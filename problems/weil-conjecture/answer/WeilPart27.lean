by
  classical
  have hn1 : 1 ≤ n := by omega
  have hNeZero : NeZero n := ⟨by omega⟩
  have hEtPb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
