        have hη_eq : η_M_πt = adj_πt.unit.app FM_src ≫ pf_πt.map π_M_πt := by
          dsimp only [η_M_πt]
          rw [CategoryTheory.Adjunction.homEquiv_unit]
        dsimp only [u₁]
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_comp,
          ← CategoryTheory.Category.assoc, h_unit_nat,
          CategoryTheory.Category.assoc, ← hη_eq]
      have hL_out :
          (adj_φ.homEquiv (pf_φ.obj FM_src) (pf_πt.obj FM_tilde))
            (adj_φ.counit.app FM_src ≫ η_M_πt) =
            pf_φ.map η_M_πt := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_comp,
          ← CategoryTheory.Category.assoc, adj_φ.right_triangle_components FM_src,
          CategoryTheory.Category.id_comp]
      have hR_in :
          (adj_φt.homEquiv (pb_π.obj (pf_φ.obj FM_src)) FM_tilde) u₂ = Θ := by
        have hu₂_symm : u₂ =
            (adj_φt.homEquiv (pb_π.obj (pf_φ.obj FM_src)) FM_tilde).symm Θ := by
          rw [CategoryTheory.Adjunction.homEquiv_counit]
        rw [hu₂_symm, Equiv.apply_symm_apply]
      have hR_mid :
