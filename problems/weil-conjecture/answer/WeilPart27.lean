          have hg_i := congrArg (fun ψ : F₂ ⟶ Z => (ψ.hom.app (Opposite.op (V i))).hom x_i) hg
          change (h₁.hom.app (Opposite.op (V i))).hom ((g.hom.app (Opposite.op (V i))).hom x_i) =
            (h₂.hom.app (Opposite.op (V i))).hom ((g.hom.app (Opposite.op (V i))).hom x_i) at hg_i
