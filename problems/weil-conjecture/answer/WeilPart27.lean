  have hDim_Z₀ : topologicalKrullDim Z₀_ov.left ≤ (m : WithBot ℕ∞) := by
    have hDimΓ_m : topologicalKrullDim Γ.left = ((m + 1 : ℕ) : WithBot ℕ∞) := by
