        have hpt_bot : (pt_z : PrimeSpectrum k) = pt_0 := hpt_0_uniq _
        have hz_ev : h_Wf.base (ι_Cs.base (I_Zs.subschemeι.base z)) = ι_m'.base pt_ev := by
