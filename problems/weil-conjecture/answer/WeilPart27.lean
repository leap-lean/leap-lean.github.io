      let rhs₁ : Aℤ ⟶ Fℤ_tilde.obj.obj (Opposite.op (B_πt.obj (B_φ.obj T_tgt))) :=
        (adj_c_tgt.homEquiv Aℤ ((CategoryTheory.Functor.comp pf_πt pf_φ).obj Fℤ_tilde))
          ((adj₂.homEquiv Fℤ_tgt Fℤ_tilde v₂) ≫ e_R.inv.app Fℤ_tilde)
      let lhs₂ : Aℤ ⟶ Fℤ_tilde.obj.obj (Opposite.op (B_φt.obj (B_π.obj T_tgt))) :=
