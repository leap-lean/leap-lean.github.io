        O₃ O₁ hO₁₃ hgf_free hDim₁ α₁ =
      zbPush Z₂ Z₃ f hf_over m hm O₃ O₂ hO₂ hf_free hDim₂
        (zbPush Z₁ Z₂ g hg_over δ hδ O₂ O₁ hO₁ hg_free hDim₁ α₁) := by
    intro Z₁ Z₂ Z₃ _ _ _ g f hg_over hf_over hgf_over δ m hδ hm hmδ
      O₃ O₂ O₁ hO₂ hO₁ hO₁₃ hg_free hf_free hgf_free hDim₁ hDim₂ α₁
    obtain ⟨τ_gf, β₃, hτ_gf, hβ₃_lift, h_gf_val⟩ :=
