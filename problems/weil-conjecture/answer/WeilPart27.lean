                  (G₁.obj.map (j_c I.Y m ≫ u₀).op ≫ φ_good (V_c I.Y m) ((hj_spec I.Y).2 m)) := by
                rw [CategoryTheory.Category.assoc,
                  ← hNat_op ((hj_spec I.Y).2 m) ((hj_spec U).2 i) (j_c I.Y m ≫ u₀)]
            _ = G₁.obj.map (j_c I.Y m ≫ I.f ≫ w).op ≫
                  φ_good (V_c I.Y m) ((hj_spec I.Y).2 m) := by
                rw [← CategoryTheory.Category.assoc, ← G₁.obj.map_comp, ← op_comp,
