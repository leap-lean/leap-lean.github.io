          _ = (d₀.1 • f) ⊗ₜ[B₀] a := (TensorProduct.smul_tmul d₀.1 f a).symm
          _ = (f * algebraMap B₀ F d₀.1) ⊗ₜ[B₀] a := by rw [Algebra.smul_def, mul_comm]
          _ = (algebraMap B₀ F n₀) ⊗ₜ[B₀] a := by rw [hfd]
          _ = (n₀ • (1 : F)) ⊗ₜ[B₀] a := by rw [Algebra.smul_def, mul_one]
          _ = (1 : F) ⊗ₜ[B₀] (n₀ • a) := TensorProduct.smul_tmul n₀ (1 : F) a
      · obtain ⟨a₁, s₁, hw₁⟩ := ih₁
        obtain ⟨a₂, s₂, hw₂⟩ := ih₂
        refine ⟨a₁ * algebraMap B₀ A s₂.1 + a₂ * algebraMap B₀ A s₁.1, s₁ * s₂, ?_⟩
