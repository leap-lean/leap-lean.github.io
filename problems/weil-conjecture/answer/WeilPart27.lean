      obtain ⟨w₀, hw₀_F0⟩ := hF₀_irr.nonempty
      have hw₀_Z0m : w₀ ∈ (Z_0m : Set ↥Z₀_ov.left) := by
        rcases hw₀_F0 with ⟨z₀, _, hw₀_eq⟩
        change h_Z₀.base w₀ ∈ Set.range ι_m'.base
        have hw₀_eq' : ι_Cs.base (I_Zs.subschemeι.base z₀) = I_Z₀.subschemeι.base w₀ := hw₀_eq
        dsimp only [h_Z₀]
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, ← hw₀_eq']
        exact ⟨pt_ev, (h_into_Z₀ z₀).2.symm⟩
      have hw₀_cov := hS_cov hw₀_Z0m
      rw [Set.mem_iUnion₂] at hw₀_cov
      rcases hw₀_cov with ⟨pt_s, hpt_s, hw₀_U⟩
      let α : Fin r_cov := e_cov.symm ⟨pt_s, hpt_s⟩
      have hw₀_Uα : w₀ ∈ U_cov α := by
        dsimp [U_cov, α]; rw [Equiv.apply_symm_apply]; exact hw₀_U
      
      let e_specα : ↥(U_cov α) ≃ₜ PrimeSpectrum (C_cov α) :=
