          obtain ⟨y, hyJ, hy_not⟩ := SetLike.exists_of_lt hlt
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
          have ha_not : a ∉ 𝔐 := fun ha => hy_not (Ideal.mem_map_of_mem π₂ ha)
          have hsup_top : 𝔐 ⊔ Ideal.span {a} = ⊤ := by
            by_contra hne_top
            have heq := h𝔐.eq_of_le hne_top le_sup_left
            exact ha_not (heq.symm ▸ Ideal.mem_sup_right (Ideal.mem_span_singleton_self a))
          have h1_mem : (1 : A₂) ∈ 𝔐 ⊔ Ideal.span {a} := by rw [hsup_top]; trivial
          obtain ⟨m_a, hm_a, r_a, hr_a, h_sum⟩ := Submodule.mem_sup.mp h1_mem
          obtain ⟨c_a, rfl⟩ := Ideal.mem_span_singleton'.mp hr_a
          rw [Ideal.eq_top_iff_one]
          have h1_bar : (1 : B_bar) = π₂ m_a + π₂ c_a * π₂ a := by
            rw [← map_mul, ← map_add, h_sum, map_one]
          rw [h1_bar]
          exact add_mem (hlt.le (Ideal.mem_map_of_mem π₂ hm_a)) (J.mul_mem_left (π₂ c_a) hyJ)
      have hFin_max : { 𝔐 : Ideal A₂ | 𝔐.IsMaximal }.Finite := by
        refine Set.Finite.of_finite_image (f := Ideal.map π₂) ?_ ?_
        · exact hFin_bar.subset (by rintro _ ⟨𝔐, h𝔐, rfl⟩; exact (hMax_A₂ 𝔐 h𝔐).2)
        · intro 𝔐₁ h₁ 𝔐₂ h₂ heq
          rw [← (hMax_A₂ 𝔐₁ h₁).1, ← (hMax_A₂ 𝔐₂ h₂).1, heq]
      let ℳ : Finset (Ideal A₂) := hFin_max.toFinset
      have hℳ_mem : ∀ 𝔐 : Ideal A₂, 𝔐 ∈ ℳ ↔ 𝔐.IsMaximal := fun 𝔐 => hFin_max.mem_toFinset
      
      have hRes_span : ∀ (𝔐 : Ideal A₂), 𝔐.IsMaximal →
          ∃ v : Fin δ → A₁, ∀ z : A₁, ∃ c : Fin δ → A₂,
            z - ∑ j : Fin δ, ψ₂₁ (c j) * v j ∈ Ideal.map ψ₂₁ 𝔐 := by
        intro 𝔐 h𝔐
        letI : 𝔐.IsMaximal := h𝔐
        letI : 𝔐.IsPrime := h𝔐.isPrime
        let 𝔮 : Ideal R₂ := Ideal.comap (algebraMap R₂ A₂) 𝔐
        have h𝔮 : 𝔮.IsPrime := Ideal.IsPrime.comap (algebraMap R₂ A₂)
        obtain ⟨s, hs_not_𝔮, M_s, _, _, b_s, e_s, he_s⟩ := hLoc 𝔮 h𝔮
        let K_𝔐 := A₂ ⧸ 𝔐
        letI : Field K_𝔐 := Ideal.Quotient.field 𝔐
        let q₂ : A₂ →+* K_𝔐 := Ideal.Quotient.mk 𝔐
        let J₁ : Ideal A₁ := Ideal.map ψ₂₁ 𝔐
        let Q_𝔐 := A₁ ⧸ J₁
        let q₁ : A₁ →+* Q_𝔐 := Ideal.Quotient.mk J₁
        let bar_ψ : K_𝔐 →+* Q_𝔐 :=
          Ideal.Quotient.lift 𝔐 (q₁.comp ψ₂₁) (fun a ha => by
            change Ideal.Quotient.mk J₁ (ψ₂₁ a) = 0
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem ψ₂₁ ha))
        have hs_ne : q₂ (algebraMap R₂ A₂ s) ≠ 0 :=
          mt Ideal.Quotient.eq_zero_iff_mem.mp hs_not_𝔮
        have hs_unit_K : IsUnit ((q₂.comp (algebraMap R₂ A₂)) s) := IsUnit.mk0 _ hs_ne
        have hφs_unit_Q : IsUnit ((q₁.comp (algebraMap R₁ A₁)) (φ₂₁ s)) := by
          have heq_s : (q₁.comp (algebraMap R₁ A₁)) (φ₂₁ s) =
              bar_ψ ((q₂.comp (algebraMap R₂ A₂)) s) := by
            change q₁ (algebraMap R₁ A₁ (φ₂₁ s)) = q₁ (ψ₂₁ (algebraMap R₂ A₂ s))
            rw [hψ₂₁_eq]
          rw [heq_s]
          exact hs_unit_K.map bar_ψ
        let α_𝔐 : Localization.Away s →+* K_𝔐 :=
          Localization.awayLift (q₂.comp (algebraMap R₂ A₂)) s hs_unit_K
        let β_𝔐 : Localization.Away (φ₂₁ s) →+* Q_𝔐 :=
          Localization.awayLift (q₁.comp (algebraMap R₁ A₁)) (φ₂₁ s) hφs_unit_Q
        have h_comm_s : β_𝔐.comp (Localization.awayMap φ₂₁ s) = bar_ψ.comp α_𝔐 := by
          apply IsLocalization.ringHom_ext (Submonoid.powers s)
          ext r₂
          simp only [RingHom.comp_apply]
          have h1 : (Localization.awayMap φ₂₁ s) (algebraMap R₂ (Localization.Away s) r₂) =
              algebraMap R₁ (Localization.Away (φ₂₁ s)) (φ₂₁ r₂) :=
            h_away_eq φ₂₁ s r₂
          have h2 : β_𝔐 (algebraMap R₁ (Localization.Away (φ₂₁ s)) (φ₂₁ r₂)) =
              q₁ (algebraMap R₁ A₁ (φ₂₁ r₂)) :=
            IsLocalization.Away.lift_eq (φ₂₁ s) hφs_unit_Q (φ₂₁ r₂)
          have h3 : α_𝔐 (algebraMap R₂ (Localization.Away s) r₂) =
              q₂ (algebraMap R₂ A₂ r₂) :=
            IsLocalization.Away.lift_eq s hs_unit_K r₂
          rw [h1, h2, h3]
          change q₁ (algebraMap R₁ A₁ (φ₂₁ r₂)) = q₁ (ψ₂₁ (algebraMap R₂ A₂ r₂))
          rw [hψ₂₁_eq]
        let v : Fin δ → A₁ := fun j =>
          Classical.choose (Ideal.Quotient.mk_surjective (β_𝔐 (e_s (b_s j))))
        have hv : ∀ j : Fin δ, q₁ (v j) = β_𝔐 (e_s (b_s j)) := fun j =>
          Classical.choose_spec (Ideal.Quotient.mk_surjective (β_𝔐 (e_s (b_s j))))
        refine ⟨v, fun z => ?_⟩
        obtain ⟨⟨x, s₁⟩, hz⟩ := IsLocalization.surj S₁ z
        obtain ⟨t₀, ht₀, ht₀_eq⟩ := s₁.2
        let d_inv : A₃ := IsLocalization.mk' A₃ 1 ⟨t₀, ht₀⟩
        have hd_mul : d_inv * algebraMap R₃ A₃ t₀ = 1 :=
          (IsLocalization.mk'_spec A₃ 1 ⟨t₀, ht₀⟩).trans (map_one _)
        have hz_eq : z = ψ₂₁ (ψ₃₂ d_inv) * algebraMap R₁ A₁ x := by
          have hd₁_mul : ψ₂₁ (ψ₃₂ d_inv) * algebraMap R₁ A₁ s₁.1 = 1 := by
            rw [← ht₀_eq]
            change ψ₂₁ (ψ₃₂ d_inv) * algebraMap R₁ A₁ (φ₂₁ (φ₃₂ t₀)) = 1
            rw [← hψ₂₁_eq, ← hψ₃₂_eq, ← map_mul, ← map_mul, hd_mul, map_one, map_one]
          rw [← hz]
          calc
            z = z * (ψ₂₁ (ψ₃₂ d_inv) * algebraMap R₁ A₁ s₁.1) := by rw [hd₁_mul, mul_one]
            _ = ψ₂₁ (ψ₃₂ d_inv) * (z * algebraMap R₁ A₁ s₁.1) := by ring
        let x_loc : Localization.Away (φ₂₁ s) := algebraMap R₁ (Localization.Away (φ₂₁ s)) x
        let c_s : Fin δ → Localization.Away s := fun j => b_s.repr (e_s.symm x_loc) j
        have hx_loc : x_loc = ∑ j : Fin δ, Localization.awayMap φ₂₁ s (c_s j) * e_s (b_s j) := by
          have h1 : e_s.symm x_loc = ∑ j : Fin δ, c_s j • b_s j := (b_s.sum_repr _).symm
          have h2 := congrArg e_s h1
          rw [e_s.apply_symm_apply, map_sum] at h2
          simpa [he_s] using h2
        let a_lift : Fin δ → A₂ := fun j =>
          Classical.choose (Ideal.Quotient.mk_surjective (α_𝔐 (c_s j)))
        have ha_lift : ∀ j : Fin δ, q₂ (a_lift j) = α_𝔐 (c_s j) := fun j =>
          Classical.choose_spec (Ideal.Quotient.mk_surjective (α_𝔐 (c_s j)))
        refine ⟨fun j => ψ₃₂ d_inv * a_lift j, ?_⟩
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
        change q₁ z = q₁ (∑ j : Fin δ, ψ₂₁ (ψ₃₂ d_inv * a_lift j) * v j)
        have hq₁_x : q₁ (algebraMap R₁ A₁ x) = ∑ j : Fin δ, q₁ (ψ₂₁ (a_lift j)) * q₁ (v j) := by
          have hβ : β_𝔐 x_loc = q₁ (algebraMap R₁ A₁ x) :=
            IsLocalization.Away.lift_eq (φ₂₁ s) hφs_unit_Q x
          rw [← hβ, hx_loc, map_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [β_𝔐.map_mul, hv j]
          have hcomm_j := RingHom.congr_fun h_comm_s (c_s j)
          simp only [RingHom.comp_apply] at hcomm_j
          rw [hcomm_j, ← ha_lift j]
          rfl
        rw [hz_eq, q₁.map_mul, hq₁_x, map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp only [map_mul]
        ring
      let v_loc : Ideal A₂ → Fin δ → A₁ := fun 𝔐 =>
        if h : 𝔐.IsMaximal then Classical.choose (hRes_span 𝔐 h) else 0
      have hv_loc : ∀ (𝔐 : Ideal A₂) (h : 𝔐.IsMaximal) (z : A₁),
          ∃ c : Fin δ → A₂, z - ∑ j : Fin δ, ψ₂₁ (c j) * v_loc 𝔐 j ∈ Ideal.map ψ₂₁ 𝔐 := by
        intro 𝔐 h z
        dsimp [v_loc]
        rw [dif_pos h]
        exact Classical.choose_spec (hRes_span 𝔐 h) z
      have hCoprime : ∀ (I J : Ideal A₂), I.IsMaximal → J.IsMaximal → I ≠ J →
          ∃ a ∈ I, ∃ b ∈ J, a + b = 1 := by
        intro I J hI hJ hne
        have hnot_le : ¬ J ≤ I := fun hle =>
          hne (hJ.eq_of_le hI.ne_top hle).symm
        obtain ⟨y, hyJ, hyI⟩ := Set.not_subset.mp hnot_le
        have hsup : I ⊔ J = ⊤ := by
          by_contra hne_top
          have heq := hI.eq_of_le hne_top le_sup_left
          exact hyI (heq.symm ▸ Ideal.mem_sup_right hyJ)
        have h1 : (1 : A₂) ∈ I ⊔ J := by rw [hsup]; trivial
        obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
        exact ⟨a, ha, b, hb, hab⟩
      let b_crt : Ideal A₂ → Ideal A₂ → A₂ := fun I J =>
        if h : I.IsMaximal ∧ J.IsMaximal ∧ I ≠ J then
          Classical.choose (Classical.choose_spec (hCoprime I J h.1 h.2.1 h.2.2)).2
        else 1
      have hb_crt : ∀ (I J : Ideal A₂), I.IsMaximal → J.IsMaximal → I ≠ J →
          b_crt I J ∈ J ∧ 1 - b_crt I J ∈ I := by
        intro I J hI hJ hne
        have h : I.IsMaximal ∧ J.IsMaximal ∧ I ≠ J := ⟨hI, hJ, hne⟩
        set p := hCoprime I J hI hJ hne
        set ha_spec := Classical.choose_spec p
        set b_val := Classical.choose ha_spec.2
        have hb_spec : b_val ∈ J ∧ Classical.choose p + b_val = 1 :=
          Classical.choose_spec ha_spec.2
        have hbeq : b_crt I J = b_val := dif_pos h
        rw [hbeq]
        refine ⟨hb_spec.1, ?_⟩
        have hsub : 1 - b_val = Classical.choose p := by
          calc
            1 - b_val = (Classical.choose p + b_val) - b_val := by rw [hb_spec.2]
            _ = Classical.choose p := add_sub_cancel_right _ _
        rw [hsub]
        exact ha_spec.1
      let e_crt : Ideal A₂ → A₂ := fun 𝔐 => ∏ 𝔐' ∈ ℳ.erase 𝔐, b_crt 𝔐 𝔐'
      have he_crt_other : ∀ (𝔐 𝔐₀ : Ideal A₂), 𝔐 ∈ ℳ → 𝔐₀ ∈ ℳ → 𝔐 ≠ 𝔐₀ → e_crt 𝔐 ∈ 𝔐₀ := by
        intro 𝔐 𝔐₀ h𝔐 h𝔐₀ hne
        have hmem_erase : 𝔐₀ ∈ ℳ.erase 𝔐 := Finset.mem_erase.mpr ⟨hne.symm, h𝔐₀⟩
        dsimp only [e_crt]
        rw [← Finset.mul_prod_erase (ℳ.erase 𝔐) (b_crt 𝔐) hmem_erase]
        exact 𝔐₀.mul_mem_right _ ((hb_crt 𝔐 𝔐₀ ((hℳ_mem 𝔐).mp h𝔐) ((hℳ_mem 𝔐₀).mp h𝔐₀) hne).1)
      have he_crt_self : ∀ (𝔐₀ : Ideal A₂), 𝔐₀ ∈ ℳ → e_crt 𝔐₀ - 1 ∈ 𝔐₀ := by
        intro 𝔐₀ h𝔐₀
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, sub_eq_zero]
        dsimp [e_crt]
        rw [map_prod]
        have hprod1 : (∏ 𝔐' ∈ ℳ.erase 𝔐₀, (Ideal.Quotient.mk 𝔐₀) (b_crt 𝔐₀ 𝔐')) =
            ∏ _𝔐' ∈ ℳ.erase 𝔐₀, (1 : A₂ ⧸ 𝔐₀) := by
          refine Finset.prod_congr rfl fun 𝔐' h𝔐' => ?_
          obtain ⟨hne', h𝔐'_mem⟩ := Finset.mem_erase.mp h𝔐'
          have h1sub := (hb_crt 𝔐₀ 𝔐' ((hℳ_mem 𝔐₀).mp h𝔐₀) ((hℳ_mem 𝔐').mp h𝔐'_mem) hne'.symm).2
          have hq0 : (Ideal.Quotient.mk 𝔐₀) (1 - b_crt 𝔐₀ 𝔐') = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr h1sub
          rw [map_sub, map_one, sub_eq_zero] at hq0
          exact hq0.symm
        rw [hprod1, Finset.prod_const_one]
      let u : Fin δ → A₁ := fun j => ∑ 𝔐 ∈ ℳ, ψ₂₁ (e_crt 𝔐) * v_loc 𝔐 j
      have hu_diff : ∀ (𝔐₀ : Ideal A₂), 𝔐₀ ∈ ℳ → ∀ j : Fin δ,
          u j - v_loc 𝔐₀ j ∈ Ideal.map ψ₂₁ 𝔐₀ := by
        intro 𝔐₀ h𝔐₀ j
        have hsum_split : u j = ψ₂₁ (e_crt 𝔐₀) * v_loc 𝔐₀ j +
            ∑ 𝔐 ∈ ℳ.erase 𝔐₀, ψ₂₁ (e_crt 𝔐) * v_loc 𝔐 j := by
          dsimp [u]
          rw [← Finset.add_sum_erase ℳ (fun 𝔐 => ψ₂₁ (e_crt 𝔐) * v_loc 𝔐 j) h𝔐₀]
        have hrew : u j - v_loc 𝔐₀ j = ψ₂₁ (e_crt 𝔐₀ - 1) * v_loc 𝔐₀ j +
            ∑ 𝔐 ∈ ℳ.erase 𝔐₀, ψ₂₁ (e_crt 𝔐) * v_loc 𝔐 j := by
          rw [hsum_split, map_sub, map_one]
          ring
        rw [hrew]
        refine add_mem ?_ ?_
        · exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem ψ₂₁ (he_crt_self 𝔐₀ h𝔐₀))
        · refine sum_mem fun 𝔐 h𝔐 => ?_
          obtain ⟨hne, h𝔐_mem⟩ := Finset.mem_erase.mp h𝔐
          exact Ideal.mul_mem_right _ _
            (Ideal.mem_map_of_mem ψ₂₁ (he_crt_other 𝔐 𝔐₀ h𝔐_mem h𝔐₀ hne))
      
      let surj_u : ∀ j : Fin δ, R₁ × S₁ := fun j => Classical.choose (IsLocalization.surj S₁ (u j))
      have hsurj_u : ∀ j : Fin δ,
          u j * algebraMap R₁ A₁ (surj_u j).2.1 = algebraMap R₁ A₁ (surj_u j).1 := fun j =>
        Classical.choose_spec (IsLocalization.surj S₁ (u j))
      let w : Fin δ → R₁ := fun j => (surj_u j).1
      have hu_eq_w : ∀ j : Fin δ, ∃ a_inv : A₂, u j = ψ₂₁ a_inv * algebraMap R₁ A₁ (w j) := by
        intro j
        obtain ⟨d_j, hd_j, hd_eq⟩ := (surj_u j).2.2
        let d_inv : A₃ := IsLocalization.mk' A₃ 1 ⟨d_j, hd_j⟩
        have hd_mul : d_inv * algebraMap R₃ A₃ d_j = 1 :=
          (IsLocalization.mk'_spec A₃ 1 ⟨d_j, hd_j⟩).trans (map_one _)
        have hd₁_mul : ψ₂₁ (ψ₃₂ d_inv) * algebraMap R₁ A₁ (surj_u j).2.1 = 1 := by
          rw [← hd_eq]
          change ψ₂₁ (ψ₃₂ d_inv) * algebraMap R₁ A₁ (φ₂₁ (φ₃₂ d_j)) = 1
          rw [← hψ₂₁_eq, ← hψ₃₂_eq, ← map_mul, ← map_mul, hd_mul, map_one, map_one]
        refine ⟨ψ₃₂ d_inv, ?_⟩
        rw [← hsurj_u j]
        calc
          u j = u j * (ψ₂₁ (ψ₃₂ d_inv) * algebraMap R₁ A₁ (surj_u j).2.1) := by
            rw [hd₁_mul, mul_one]
          _ = ψ₂₁ (ψ₃₂ d_inv) * (u j * algebraMap R₁ A₁ (surj_u j).2.1) := by ring
      let a_inv_w : Fin δ → A₂ := fun j => Classical.choose (hu_eq_w j)
      have ha_inv_w : ∀ j : Fin δ, u j = ψ₂₁ (a_inv_w j) * algebraMap R₁ A₁ (w j) := fun j =>
        Classical.choose_spec (hu_eq_w j)
      
      let Φ_A : (Fin δ → A₂) →ₗ[A₂] A₁ :=
        { toFun := fun c => ∑ j : Fin δ, c j • algebraMap R₁ A₁ (w j)
          map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
      let N_A : Submodule A₂ A₁ := LinearMap.range Φ_A
      let Q_A := A₁ ⧸ N_A
      let π_Q : A₁ →ₗ[A₂] Q_A := N_A.mkQ
      have hFG_QA : (⊤ : Submodule A₂ Q_A).FG := by
        have hmap_top : Submodule.map π_Q (⊤ : Submodule A₂ A₁) = ⊤ :=
          LinearMap.range_eq_top.mpr (Submodule.mkQ_surjective N_A) ▸ Submodule.map_top π_Q
        rw [← hmap_top]
        exact hFG_A₁.map π_Q
      let Ann : Ideal A₂ :=
        { carrier := { b : A₂ | ∀ q : Q_A, b • q = 0 }
          zero_mem' := fun q => zero_smul A₂ q
          add_mem' := fun {b₁ b₂} hb₁ hb₂ q => by rw [add_smul, hb₁ q, hb₂ q, add_zero]
          smul_mem' := fun c {b} hb q => by rw [smul_eq_mul, mul_smul, hb q, smul_zero] }
      have hAnn_top : Ann = ⊤ := by
        by_contra hAnn_ne
        obtain ⟨𝔐₀, h𝔐₀_max, hAnn_le⟩ := Ideal.exists_le_maximal Ann hAnn_ne
        have h𝔐₀_mem : 𝔐₀ ∈ ℳ := (hℳ_mem 𝔐₀).mpr h𝔐₀_max
        let M_smul : Submodule A₂ A₁ := 𝔐₀ • (⊤ : Submodule A₂ A₁)
        let J_sub : Ideal A₁ :=
          { carrier := (M_smul : Set A₁)
            zero_mem' := M_smul.zero_mem
            add_mem' := fun ha hb => M_smul.add_mem ha hb
            smul_mem' := fun a₁ {x} hx => by
              rw [smul_eq_mul]
              change a₁ * x ∈ M_smul
              refine Submodule.smul_induction_on hx ?_ ?_
              · intro m₀ hm₀ y _
                have h_comm_mul : a₁ * (m₀ • y) = m₀ • (a₁ * y) := by
                  change a₁ * (ψ₂₁ m₀ * y) = ψ₂₁ m₀ * (a₁ * y)
                  ring
                rw [h_comm_mul]
                exact Submodule.smul_mem_smul hm₀ trivial
              · intro y₁ y₂ hy₁ hy₂
                rw [mul_add]
                exact M_smul.add_mem hy₁ hy₂ }
        have hmap_le_smul : Ideal.map ψ₂₁ 𝔐₀ ≤ J_sub := by
          rw [Ideal.map_le_iff_le_comap]
          intro m₀ hm₀
          change ψ₂₁ m₀ ∈ M_smul
          have h1_smul : m₀ • (1 : A₁) = ψ₂₁ m₀ := by
            change ψ₂₁ m₀ * 1 = ψ₂₁ m₀
            exact mul_one _
          rw [← h1_smul]
          exact Submodule.smul_mem_smul hm₀ trivial
        have hQA_le : (⊤ : Submodule A₂ Q_A) ≤ 𝔐₀ • (⊤ : Submodule A₂ Q_A) := by
          intro q _
          obtain ⟨z, rfl⟩ := Submodule.mkQ_surjective N_A q
          obtain ⟨c, hc⟩ := hv_loc 𝔐₀ h𝔐₀_max z
          have hdiff_u : z - ∑ j : Fin δ, ψ₂₁ (c j) * u j ∈ Ideal.map ψ₂₁ 𝔐₀ := by
            have hdecomp : z - ∑ j : Fin δ, ψ₂₁ (c j) * u j =
                (z - ∑ j : Fin δ, ψ₂₁ (c j) * v_loc 𝔐₀ j) -
                ∑ j : Fin δ, ψ₂₁ (c j) * (u j - v_loc 𝔐₀ j) := by
              simp only [mul_sub, Finset.sum_sub_distrib]
              ring
            rw [hdecomp]
            refine sub_mem hc (sum_mem fun j _ => ?_)
            exact Ideal.mul_mem_left _ _ (hu_diff 𝔐₀ h𝔐₀_mem j)
          let s_w : A₁ := ∑ j : Fin δ, ψ₂₁ (c j * a_inv_w j) * algebraMap R₁ A₁ (w j)
          have hs_eq_u : ∑ j : Fin δ, ψ₂₁ (c j) * u j = s_w := by
            dsimp [s_w]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [ha_inv_w j, map_mul, mul_assoc]
          have hr_mem : z - s_w ∈ M_smul := hmap_le_smul (hs_eq_u ▸ hdiff_u)
          have hs_mem_NA : s_w ∈ N_A := ⟨fun j => c j * a_inv_w j, rfl⟩
          have hπ_s : π_Q s_w = 0 := (Submodule.Quotient.mk_eq_zero N_A).mpr hs_mem_NA
          have hπ_z : π_Q z = π_Q (z - s_w) := by
            rw [map_sub, hπ_s, sub_zero]
          rw [hπ_z]
          refine Submodule.smul_induction_on hr_mem ?_ ?_
          · intro m₀ hm₀ y _
            rw [map_smul]
            exact Submodule.smul_mem_smul hm₀ trivial
          · intro y₁ y₂ hy₁ hy₂
            rw [map_add]
            exact add_mem hy₁ hy₂
        obtain ⟨m₀, hm₀, hm₀_eq⟩ :=
          Submodule.exists_mem_and_smul_eq_self_of_fg_of_le_smul 𝔐₀ (⊤ : Submodule A₂ Q_A)
            hFG_QA hQA_le
        have h1_sub_mem : 1 - m₀ ∈ Ann := by
          intro q
          rw [sub_smul, one_smul, hm₀_eq q trivial, sub_self]
        have h1_in_𝔐₀ : (1 : A₂) ∈ 𝔐₀ := by
          have hsum1 : (1 : A₂) = (1 - m₀) + m₀ := by ring
          rw [hsum1]
          exact add_mem (hAnn_le h1_sub_mem) hm₀
        exact h𝔐₀_max.ne_top ((Ideal.eq_top_iff_one 𝔐₀).mpr h1_in_𝔐₀)
      have hNA_top : ∀ z : A₁, z ∈ N_A := by
        intro z
        have h1_ann : (1 : A₂) ∈ Ann := by rw [hAnn_top]; trivial
        have hπ0 : π_Q z = 0 := by simpa [one_smul] using h1_ann (π_Q z)
        exact (Submodule.Quotient.mk_eq_zero N_A).mp hπ0
      have hClear_one : ∀ x : R₁, ∃ t_x ∈ S₃, ∃ c : Fin δ → R₂,
          φ₂₁ (φ₃₂ t_x) * x = ∑ j : Fin δ, φ₂₁ (c j) * w j := by
        intro x
        obtain ⟨c_A, hc_A⟩ := hNA_top (algebraMap R₁ A₁ x)
        let surj_c : ∀ j : Fin δ, R₂ × S₂ := fun j =>
          Classical.choose (IsLocalization.surj S₂ (c_A j))
        have hsurj_c : ∀ j : Fin δ,
            c_A j * algebraMap R₂ A₂ (surj_c j).2.1 = algebraMap R₂ A₂ (surj_c j).1 := fun j =>
          Classical.choose_spec (IsLocalization.surj S₂ (c_A j))
        let d₂ : Fin δ → R₃ := fun j => Classical.choose (surj_c j).2.2
        have hd₂ : ∀ j : Fin δ, d₂ j ∈ S₃ ∧ φ₃₂ (d₂ j) = (surj_c j).2.1 := fun j =>
          Classical.choose_spec (surj_c j).2.2
        let D₁ : R₃ := ∏ j : Fin δ, d₂ j
        have hD₁ : D₁ ∈ S₃ := S₃.prod_mem fun j _ => (hd₂ j).1
        let r'₂ : Fin δ → R₂ := fun j =>
          φ₃₂ (∏ k ∈ Finset.univ.erase j, d₂ k) * (surj_c j).1
        have hc_D₁ : ∀ j : Fin δ,
            c_A j * algebraMap R₂ A₂ (φ₃₂ D₁) = algebraMap R₂ A₂ (r'₂ j) := by
          intro j
          have hD₁_split : D₁ = d₂ j * ∏ k ∈ Finset.univ.erase j, d₂ k :=
            (Finset.mul_prod_erase Finset.univ d₂ (Finset.mem_univ j)).symm
          calc
            c_A j * algebraMap R₂ A₂ (φ₃₂ D₁) =
                (c_A j * algebraMap R₂ A₂ (surj_c j).2.1) *
                  algebraMap R₂ A₂ (φ₃₂ (∏ k ∈ Finset.univ.erase j, d₂ k)) := by
              rw [hD₁_split, map_mul, map_mul, (hd₂ j).2, mul_assoc]
            _ = algebraMap R₂ A₂ (r'₂ j) := by
              rw [hsurj_c j, ← map_mul, mul_comm]
        have heq_A₁ : algebraMap R₁ A₁ (φ₂₁ (φ₃₂ D₁) * x - ∑ j : Fin δ, φ₂₁ (r'₂ j) * w j) = 0 := by
          rw [map_sub, map_mul, ← hψ₂₁_eq (φ₃₂ D₁), ← hc_A]
          change ψ₂₁ (algebraMap R₂ A₂ (φ₃₂ D₁)) *
              (∑ j : Fin δ, ψ₂₁ (c_A j) * algebraMap R₁ A₁ (w j)) -
            algebraMap R₁ A₁ (∑ j : Fin δ, φ₂₁ (r'₂ j) * w j) = 0
          rw [Finset.mul_sum, map_sum, sub_eq_zero]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [← mul_assoc, ← map_mul, mul_comm (algebraMap R₂ A₂ (φ₃₂ D₁)) (c_A j),
            hc_D₁ j, hψ₂₁_eq, ← map_mul]
        obtain ⟨s₁, hs₁_zero⟩ :=
          (IsLocalization.map_eq_zero_iff S₁ A₁ _).mp heq_A₁
        obtain ⟨D₂, hD₂, hD₂_eq⟩ := s₁.2
        have hD₂_φ : φ₂₁ (φ₃₂ D₂) = s₁.1 := hD₂_eq
        refine ⟨D₂ * D₁, S₃.mul_mem hD₂ hD₁, fun j => φ₃₂ D₂ * r'₂ j, ?_⟩
        rw [← sub_eq_zero]
        have hmul_zero : φ₂₁ (φ₃₂ D₂) * (φ₂₁ (φ₃₂ D₁) * x - ∑ j : Fin δ, φ₂₁ (r'₂ j) * w j) = 0 := by
          rw [hD₂_φ]
          exact hs₁_zero
        calc
          φ₂₁ (φ₃₂ (D₂ * D₁)) * x - ∑ j : Fin δ, φ₂₁ (φ₃₂ D₂ * r'₂ j) * w j =
              φ₂₁ (φ₃₂ D₂) * (φ₂₁ (φ₃₂ D₁) * x - ∑ j : Fin δ, φ₂₁ (r'₂ j) * w j) := by
            simp only [map_mul, mul_sub, Finset.mul_sum, mul_assoc]
          _ = 0 := hmul_zero
      let t_g : R₁ → R₃ := fun g => Classical.choose (hClear_one g)
      let c_g : R₁ → Fin δ → R₂ := fun g =>
        Classical.choose (Classical.choose_spec (hClear_one g)).2
      have ht_g : ∀ g : R₁, t_g g ∈ S₃ ∧
          φ₂₁ (φ₃₂ (t_g g)) * g = ∑ j : Fin δ, φ₂₁ (c_g g j) * w j := fun g =>
        ⟨(Classical.choose_spec (hClear_one g)).1,
          Classical.choose_spec (Classical.choose_spec (hClear_one g)).2⟩
      let t : R₃ := ∏ g ∈ G, t_g g
      have ht_mem : t ∈ S₃ := S₃.prod_mem fun g _ => (ht_g g).1
      let W_sub : Submodule R₃ R₁ :=
        { carrier := { x : R₁ | ∃ c : Fin δ → R₂, φ₂₁ (φ₃₂ t) * x = ∑ j : Fin δ, φ₂₁ (c j) * w j }
          zero_mem' := ⟨0, by simp⟩
          add_mem' := fun {x y} ⟨cx, hcx⟩ ⟨cy, hcy⟩ =>
            ⟨cx + cy, by
              simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib,
                mul_add, hcx, hcy]⟩
          smul_mem' := fun r₃ {x} ⟨cx, hcx⟩ =>
            ⟨fun j => φ₃₂ r₃ * cx j, by
              change φ₂₁ (φ₃₂ t) * (φ₂₁ (φ₃₂ r₃) * x) =
                ∑ j : Fin δ, φ₂₁ (φ₃₂ r₃ * cx j) * w j
              calc
                φ₂₁ (φ₃₂ t) * (φ₂₁ (φ₃₂ r₃) * x) =
                    φ₂₁ (φ₃₂ r₃) * (φ₂₁ (φ₃₂ t) * x) := by ring
                _ = φ₂₁ (φ₃₂ r₃) * ∑ j : Fin δ, φ₂₁ (cx j) * w j := by rw [hcx]
                _ = ∑ j : Fin δ, φ₂₁ (φ₃₂ r₃ * cx j) * w j := by
                  simp only [Finset.mul_sum, map_mul, mul_assoc]⟩ }
      have hG_le : (G : Set R₁) ⊆ W_sub := by
        intro g hg
        have ht_split : t = t_g g * ∏ g' ∈ G.erase g, t_g g' :=
          (Finset.mul_prod_erase G t_g hg).symm
        refine ⟨fun j => φ₃₂ (∏ g' ∈ G.erase g, t_g g') * c_g g j, ?_⟩
        calc
          φ₂₁ (φ₃₂ t) * g =
              φ₂₁ (φ₃₂ (∏ g' ∈ G.erase g, t_g g')) * (φ₂₁ (φ₃₂ (t_g g)) * g) := by
            rw [ht_split, map_mul, map_mul]
            ring
          _ = φ₂₁ (φ₃₂ (∏ g' ∈ G.erase g, t_g g')) * ∑ j : Fin δ, φ₂₁ (c_g g j) * w j := by
            rw [(ht_g g).2]
          _ = ∑ j : Fin δ, φ₂₁ (φ₃₂ (∏ g' ∈ G.erase g, t_g g') * c_g g j) * w j := by
            simp only [Finset.mul_sum, map_mul, mul_assoc]
      have hW_top : W_sub = ⊤ := top_unique (hG_span ▸ Submodule.span_le.mpr hG_le)
      refine ⟨t, ht_mem, w, fun x => ?_⟩
      have hxW : x ∈ W_sub := by rw [hW_top]; trivial
      exact hxW
    
    obtain ⟨t, ht, w, hw⟩ := hSpan
    refine ⟨t, ht, ?_⟩
    
    have hM₂_t : ∃ (M₂_t : Type u) (_ : AddCommGroup M₂_t) (_ : Module (Localization.Away t) M₂_t)
        (_b₂_t : Module.Basis (Fin m) (Localization.Away t) M₂_t)
        (e₂_t : M₂_t ≃+ Localization.Away (φ₃₂ t)),
        ∀ (b : Localization.Away t) (x : M₂_t),
          e₂_t (b • x) = Localization.awayMap φ₃₂ t b * e₂_t x := by
      let B₃ := Localization.Away t
      let B₂ := Localization.Away (φ₃₂ t)
      let ψ₃₂_t : B₃ →+* B₂ := Localization.awayMap φ₃₂ t
      letI : Algebra B₃ B₂ := ψ₃₂_t.toAlgebra
      let Ψ : (Fin m → B₃) →ₗ[B₃] B₂ :=
        { toFun := fun g => ∑ i : Fin m, g i • algebraMap R₂ B₂ (e₂ (b₂ i))
          map_add' := fun g₁ g₂ => by simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun r g => by simp [mul_smul, Finset.smul_sum] }
      have hΨ_surj : Function.Surjective Ψ := by
        intro z
        obtain ⟨⟨y, p⟩, hz⟩ := IsLocalization.surj (Submonoid.powers (φ₃₂ t)) z
        obtain ⟨k, hp⟩ := p.2
        let t_inv : B₃ := IsLocalization.Away.invSelf (S := B₃) t
        have ht_inv : algebraMap R₃ B₃ t * t_inv = 1 := IsLocalization.Away.mul_invSelf t
        have hψt_inv : algebraMap R₂ B₂ (φ₃₂ t) * ψ₃₂_t t_inv = 1 := by
          have h1 : ψ₃₂_t (algebraMap R₃ B₃ t) = algebraMap R₂ B₂ (φ₃₂ t) :=
            h_away_eq φ₃₂ t t
          rw [← h1, ← ψ₃₂_t.map_mul, ht_inv, map_one]
        let c : Fin m → R₃ := fun i => b₂.repr (e₂.symm y) i
        have hy_eq : y = ∑ i : Fin m, φ₃₂ (c i) * e₂ (b₂ i) := by
          have h1 : e₂.symm y = ∑ i : Fin m, c i • b₂ i := (b₂.sum_repr _).symm
          have h2 := congrArg e₂ h1
          rw [e₂.apply_symm_apply, map_sum] at h2
          simpa [he₂] using h2
        refine ⟨fun i => t_inv ^ k * algebraMap R₃ B₃ (c i), ?_⟩
        change (∑ i : Fin m, ψ₃₂_t (t_inv ^ k * algebraMap R₃ B₃ (c i)) *
            algebraMap R₂ B₂ (e₂ (b₂ i))) = z
        have hsum_y : (∑ i : Fin m, ψ₃₂_t (t_inv ^ k * algebraMap R₃ B₃ (c i)) *
            algebraMap R₂ B₂ (e₂ (b₂ i))) =
            (ψ₃₂_t t_inv) ^ k * algebraMap R₂ B₂ y := by
          rw [hy_eq, map_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          have hci : ψ₃₂_t (algebraMap R₃ B₃ (c i)) = algebraMap R₂ B₂ (φ₃₂ (c i)) :=
            h_away_eq φ₃₂ t (c i)
          rw [ψ₃₂_t.map_mul, ψ₃₂_t.map_pow, hci, (algebraMap R₂ B₂).map_mul, mul_assoc]
        rw [hsum_y, ← hz, ← hp, (algebraMap R₂ B₂).map_pow]
        calc
          (ψ₃₂_t t_inv) ^ k * (z * (algebraMap R₂ B₂ (φ₃₂ t)) ^ k) =
              z * (algebraMap R₂ B₂ (φ₃₂ t) * ψ₃₂_t t_inv) ^ k := by
            rw [mul_pow]
            ring
          _ = z := by rw [hψt_inv, one_pow, mul_one]
      have hΨ_inj : Function.Injective Ψ := by
        rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
        intro g hg
        rw [LinearMap.mem_ker] at hg
        let surj_g : ∀ i : Fin m, R₃ × Submonoid.powers t := fun i =>
          Classical.choose (IsLocalization.surj (Submonoid.powers t) (g i))
        have hsurj_g : ∀ i : Fin m,
            g i * algebraMap R₃ B₃ (surj_g i).2.1 = algebraMap R₃ B₃ (surj_g i).1 := fun i =>
          Classical.choose_spec (IsLocalization.surj (Submonoid.powers t) (g i))
        let n_i : Fin m → ℕ := fun i => Classical.choose (surj_g i).2.2
        have hn_i : ∀ i : Fin m, t ^ n_i i = (surj_g i).2.1 := fun i =>
          Classical.choose_spec (surj_g i).2.2
        let N : ℕ := ∑ i : Fin m, n_i i
        let a' : Fin m → R₃ := fun i => (surj_g i).1 * t ^ (N - n_i i)
        have hg_N : ∀ i : Fin m,
            g i * (algebraMap R₃ B₃ t) ^ N = algebraMap R₃ B₃ (a' i) := by
          intro i
          have hle : n_i i ≤ N := Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
          have hN_eq : N = n_i i + (N - n_i i) := (Nat.add_sub_of_le hle).symm
          calc
            g i * (algebraMap R₃ B₃ t) ^ N =
                (g i * algebraMap R₃ B₃ (surj_g i).2.1) * (algebraMap R₃ B₃ t) ^ (N - n_i i) := by
              rw [← hn_i i, (algebraMap R₃ B₃).map_pow]
              conv_lhs => rw [hN_eq]
              rw [pow_add, mul_assoc]
            _ = algebraMap R₃ B₃ (a' i) := by
              rw [hsurj_g i, ← (algebraMap R₃ B₃).map_pow, ← (algebraMap R₃ B₃).map_mul]
        have hzero_B₂ : algebraMap R₂ B₂ (∑ i : Fin m, φ₃₂ (a' i) * e₂ (b₂ i)) = 0 := by
          have h1 : algebraMap R₂ B₂ (∑ i : Fin m, φ₃₂ (a' i) * e₂ (b₂ i)) =
              ψ₃₂_t ((algebraMap R₃ B₃ t) ^ N) * Ψ g := by
            change _ = ψ₃₂_t ((algebraMap R₃ B₃ t) ^ N) *
              ∑ i : Fin m, ψ₃₂_t (g i) * algebraMap R₂ B₂ (e₂ (b₂ i))
            rw [map_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            have ha' : ψ₃₂_t (algebraMap R₃ B₃ (a' i)) = algebraMap R₂ B₂ (φ₃₂ (a' i)) :=
              h_away_eq φ₃₂ t (a' i)
            rw [(algebraMap R₂ B₂).map_mul, ← ha', ← hg_N i, ψ₃₂_t.map_mul]
            ring
          rw [h1, hg, mul_zero]
        obtain ⟨⟨_, ⟨K, rfl⟩⟩, hK_zero⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (φ₃₂ t)) B₂ _).mp hzero_B₂
        have he₂_zero : e₂ (∑ i : Fin m, (t ^ K * a' i) • b₂ i) = 0 := by
          rw [map_sum]
          have hrew : (∑ i : Fin m, e₂ ((t ^ K * a' i) • b₂ i)) =
              (φ₃₂ t) ^ K * ∑ i : Fin m, φ₃₂ (a' i) * e₂ (b₂ i) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [he₂, φ₃₂.map_mul, φ₃₂.map_pow, mul_assoc]
          rw [hrew]
          exact hK_zero
        have hsum_b₂ : (∑ i : Fin m, (t ^ K * a' i) • b₂ i) = 0 :=
          e₂.injective (he₂_zero.trans e₂.map_zero.symm)
        ext i
        have hcoeff_zero : t ^ K * a' i = 0 := by
          have h := congrArg (fun x => b₂.repr x i) hsum_b₂
          simpa [map_sum, b₂.repr_self, Finsupp.single_apply] using h
        let t_inv : B₃ := IsLocalization.Away.invSelf (S := B₃) t
        have ht_inv : algebraMap R₃ B₃ t * t_inv = 1 := IsLocalization.Away.mul_invSelf t
        have hg_tKN : g i * (algebraMap R₃ B₃ t) ^ (K + N) = 0 := by
          calc
            g i * (algebraMap R₃ B₃ t) ^ (K + N) =
                (algebraMap R₃ B₃ t) ^ K * (g i * (algebraMap R₃ B₃ t) ^ N) := by
              rw [pow_add]
              ring
            _ = algebraMap R₃ B₃ (t ^ K * a' i) := by
              rw [hg_N i, ← (algebraMap R₃ B₃).map_pow, ← (algebraMap R₃ B₃).map_mul]
            _ = 0 := by rw [hcoeff_zero, map_zero]
        calc
          g i = g i * (algebraMap R₃ B₃ t * t_inv) ^ (K + N) := by rw [ht_inv, one_pow, mul_one]
          _ = (g i * (algebraMap R₃ B₃ t) ^ (K + N)) * t_inv ^ (K + N) := by
            rw [mul_pow]
            ring
          _ = 0 := by rw [hg_tKN, zero_mul]
      let e₂_t : (Fin m → B₃) ≃+ B₂ :=
        (LinearEquiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩).toAddEquiv
      refine ⟨Fin m → B₃, inferInstance, inferInstance, Pi.basisFun B₃ (Fin m), e₂_t, ?_⟩
      intro b x
      exact (LinearEquiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩).map_smul b x
    
    have hM₁_t : ∃ (M₁_t : Type u) (_ : AddCommGroup M₁_t)
        (_ : Module (Localization.Away (φ₃₂ t)) M₁_t)
        (_b₁_t : Module.Basis (Fin δ) (Localization.Away (φ₃₂ t)) M₁_t)
        (e₁_t : M₁_t ≃+ Localization.Away (φ₂₁ (φ₃₂ t))),
        ∀ (b : Localization.Away (φ₃₂ t)) (x : M₁_t),
          e₁_t (b • x) = Localization.awayMap φ₂₁ (φ₃₂ t) b * e₁_t x := by
      let r : R₂ := φ₃₂ t
      let B₂ := Localization.Away r
      let B₁ := Localization.Away (φ₂₁ r)
      let ψ_r : B₂ →+* B₁ := Localization.awayMap φ₂₁ r
      letI : Algebra B₂ B₁ := ψ_r.toAlgebra
      let Φ : (Fin δ → B₂) →ₗ[B₂] B₁ :=
        { toFun := fun f => ∑ j : Fin δ, f j • algebraMap R₁ B₁ (w j)
          map_add' := fun f₁ f₂ => by simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun b f => by simp [mul_smul, Finset.smul_sum] }
      let r_inv : B₂ := IsLocalization.Away.invSelf (S := B₂) r
      have hr_inv : algebraMap R₂ B₂ r * r_inv = 1 := IsLocalization.Away.mul_invSelf r
      have hψr_inv : algebraMap R₁ B₁ (φ₂₁ r) * ψ_r r_inv = 1 := by
        have h1 : ψ_r (algebraMap R₂ B₂ r) = algebraMap R₁ B₁ (φ₂₁ r) :=
          h_away_eq φ₂₁ r r
        rw [← h1, ← ψ_r.map_mul, hr_inv, map_one]
      have hΦ_surj : Function.Surjective Φ := by
        intro z
        obtain ⟨⟨x, p⟩, hz⟩ := IsLocalization.surj (Submonoid.powers (φ₂₁ r)) z
        obtain ⟨k, hp⟩ := p.2
        obtain ⟨c, hc⟩ := hw x
        refine ⟨fun j => r_inv ^ (k + 1) * algebraMap R₂ B₂ (c j), ?_⟩
        change (∑ j : Fin δ, ψ_r (r_inv ^ (k + 1) * algebraMap R₂ B₂ (c j)) *
            algebraMap R₁ B₁ (w j)) = z
        have hsum_x : (∑ j : Fin δ, ψ_r (r_inv ^ (k + 1) * algebraMap R₂ B₂ (c j)) *
            algebraMap R₁ B₁ (w j)) =
            (ψ_r r_inv) ^ (k + 1) * algebraMap R₁ B₁ (φ₂₁ r * x) := by
          rw [hc, map_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          have hcj : ψ_r (algebraMap R₂ B₂ (c j)) = algebraMap R₁ B₁ (φ₂₁ (c j)) :=
            h_away_eq φ₂₁ r (c j)
          rw [ψ_r.map_mul, ψ_r.map_pow, hcj, (algebraMap R₁ B₁).map_mul, mul_assoc]
        rw [hsum_x, (algebraMap R₁ B₁).map_mul, ← hz, ← hp, (algebraMap R₁ B₁).map_pow]
        calc
          (ψ_r r_inv) ^ (k + 1) * (algebraMap R₁ B₁ (φ₂₁ r) *
              (z * (algebraMap R₁ B₁ (φ₂₁ r)) ^ k)) =
              z * (algebraMap R₁ B₁ (φ₂₁ r) * ψ_r r_inv) ^ (k + 1) := by
            rw [pow_succ, pow_succ, mul_pow]
