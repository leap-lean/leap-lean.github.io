                change _ = ψ_rs ((algebraMap R₂ C₂ (r * s)) ^ N) *
                  ∑ j : Fin δ, ψ_rs (g j) * β_s (e_s (b_s j))
                rw [map_sum, Finset.mul_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                have hcj : β_s ((Localization.awayMap φ₂₁ s)
