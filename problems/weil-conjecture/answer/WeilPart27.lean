        have h1 : (CategoryTheory.Limits.pullback.fst f₁ f₂ ≫ f₁) ≫ eqToHom hx₃ = pr₁_et ≫ G₂.map u := by
          dsimp only [f₁, pr₁_et]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            eqToHom_trans, eqToHom_refl, CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc]
        have h2 : (CategoryTheory.Limits.pullback.snd f₁ f₂ ≫ f₂) ≫ eqToHom hx₃ = pr₂_et ≫ G₂.map v := by
          dsimp only [f₂, pr₂_et]
