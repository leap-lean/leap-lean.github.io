          congr 1
          exact (AlgebraicGeometry.Spec.map_apply
            (CommRingCat.ofHom ev_s.toRingHom) pt_z).trans (congrArg _ hpt_bot)
        have hz_Om : h_Wf.base (ι_Cs.base (I_Zs.subschemeι.base z)) ∈ (O_m : Set ↥P_m.left) := by
          rw [hz_hWf]; exact hs_Om _
        have hz_not_V12_0 : ι_Cs.base (I_Zs.subschemeι.base z) ∉ (V_12_0 : Set ↥Γ.left) := by
          intro hm0
          apply hz_not_V12
          rw [hV12_eq]
          exact ⟨hm0, hz_Om⟩
        rw [hr_Z₀]
        exact ⟨hz_not_V12_0, hz_ev⟩
      
      let F₀_Z₀ : Set ↥Z₀_ov.left :=
        I_Z₀.subschemeι.base ⁻¹' ((ι_Cs.base ∘ I_Zs.subschemeι.base) '' (p idx0.castSucc : Set _))
      let F₁_Z₀ : Set ↥Z₀_ov.left :=
        I_Z₀.subschemeι.base ⁻¹' ((ι_Cs.base ∘ I_Zs.subschemeι.base) '' (p idx0.succ : Set _))
      have h_im_sub : ∀ S : Set ↥I_Zs.subscheme,
          (ι_Cs.base ∘ I_Zs.subschemeι.base) '' S ⊆ Set.range I_Z₀.subschemeι.base := by
        rintro S _ ⟨z, _, rfl⟩; exact (h_into_Z₀ z).1
      have h_emb_comp : Topology.IsClosedEmbedding (ι_Cs.base ∘ I_Zs.subschemeι.base) :=
