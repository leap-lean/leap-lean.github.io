    let Γ_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp ι_Γ Z_amb.hom)
    haveI : AlgebraicGeometry.IsProper Γ_ov.hom := hProp_Γ
    haveI : Γ_left.IsSeparated := hSep_over Γ_ov
    have h_surj_of_closed_lift : ∀ (V : Γ_left.Opens)
