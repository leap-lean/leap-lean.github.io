    haveI : CategoryTheory.Epi (P_push.map g) := hEpi_push
    exact
      { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer₂
        mono_f := hMono_push
        epi_g := hEpi_push }
