    let zbPush_fn : ∀ (Z₁ Z₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Z₁.hom] [AlgebraicGeometry.IsProper Z₂.hom]
        (f : Quiver.Hom Z₁.left Z₂.left)
        (_ : CategoryTheory.CategoryStruct.comp f Z₂.hom = Z₁.hom)
        (m : ℕ) (_ : 1 ≤ m)
        (O₂ : Z₂.left.Opens) (O₁ : Z₁.left.Opens)
