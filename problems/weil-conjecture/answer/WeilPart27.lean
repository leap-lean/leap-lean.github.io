      (hgf_free : WeilTopDegFiniteLocallyFreeOfRank (m * δ)
        ((CategoryTheory.CategoryStruct.comp g f) ∣_ O₃))
      (hDim₁ : topologicalKrullDim (weilAltClosedComplIdeal Z₁.left O₁).subscheme ≤
