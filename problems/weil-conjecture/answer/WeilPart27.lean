theorem weil_top_deg_kummer_rel_p1_trace_and_fiber_clauses (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (hc_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (weilEtaleSitePullback f).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
    (hr_all : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology (@hc_all X₁ X₂ f)).IsRightAdjoint)
    (tr_0 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of Ω)) n 0 →+ ZMod n)
    (hSpec : WeilPolyP1ModelTraceSpecConservPkg n (@hc_all) (@hr_all) tr_0)
    (hPBC_prime : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
      ∀ (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        (f : Quiver.Hom X S) [AlgebraicGeometry.IsProper f.left],
        WeilCanonicalModPrimePBC ℓ f.left)
    (hCD1_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
       (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : Ω) ≠ 0 →
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper C.hom],
        topologicalKrullDim C.left ≤ (1 : WithBot ℕ∞) →
        ∀ (G : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id G = 0 →
          ∀ (q : ℕ), 2 < q → Subsingleton (G.H q))
    (hRes : WeilPolyP1ModelTraceTwoStepResPkg n (@hc_all))
    (P₁_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper P₁_ov.hom]
    [AlgebraicGeometry.IsIntegral P₁_ov.left]
    (hProj : IsProjectiveOverField k P₁_ov)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁_ov.hom]
    (ι_1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) P₁_ov.left)
    (hOpen_1 : AlgebraicGeometry.IsOpenImmersion ι_1)
    (hOver_1 : CategoryTheory.CategoryStruct.comp ι_1 P₁_ov.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (hInf_ex : ∃ s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) P₁_ov.left,
      CategoryTheory.CategoryStruct.comp s_inf P₁_ov.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      Disjoint (Set.range ι_1.base) (Set.range s_inf.base) ∧
      Set.range ι_1.base ∪ Set.range s_inf.base = Set.univ)
    (tr_1 : weilEtaleTorsionH P₁_ov.left n 2 →+ ZMod n)
    (hBij_1 : Function.Bijective tr_1)
    (hDiv_1 : ∀ s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) P₁_ov.left,
      CategoryTheory.CategoryStruct.comp s_inf P₁_ov.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      Disjoint (Set.range ι_1.base) (Set.range s_inf.base) →
      WeilTopDegKummerLastCoordP1DivTraceSpec k n ζ P₁_ov s_inf tr_1)
    (δ δ' : ℕ) (hδ : δ + 1 = δ')
    (P_δ P_succ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper P_δ.hom]
    (π₁ : Quiver.Hom P_succ.left P_δ.left)
    (π₂ : Quiver.Hom P_succ.left P₁_ov.left)
    (hOver_succ : CategoryTheory.CategoryStruct.comp π₁ P_δ.hom = P_succ.hom)
    (hPb_succ : CategoryTheory.IsPullback π₁ π₂ P_δ.hom P₁_ov.hom) :
    (∀ (F : CategoryTheory.Sheaf P_succ.left.smallEtaleTopology AddCommGrpCat.{u}) (b : ℕ),
      n • CategoryTheory.CategoryStruct.id F = 0 →
      3 ≤ b →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π₁ b F)) ∧
    ∃ (Tr_rel : Quiver.Hom
        (weilEtaleHigherDirectImage π₁ 2 (weilEtaleTorsionSheaf P_succ.left n))
        (weilEtaleTorsionSheaf P_δ.left n))
      (γ_rel : Quiver.Hom
        (weilEtaleTorsionSheaf P_δ.left n)
        (weilEtaleHigherDirectImage π₁ 2 (weilEtaleTorsionSheaf P_succ.left n))),
      WeilPolyP1ModelTraceRelStepPkg k n (@hc_all) (@hr_all) tr_0 P₁_ov tr_1 δ δ'
