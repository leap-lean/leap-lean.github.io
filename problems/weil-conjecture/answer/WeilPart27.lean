      simp only [AlgebraicGeometry.Scheme.Hom.comp_apply, Set.mem_range]
      constructor
      · rintro ⟨q, rfl⟩
        refine ⟨(AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away f)))).base q, ?_, rfl⟩
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away f) f]
        exact ⟨q, (AlgebraicGeometry.Spec.map_apply
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away f))) q).symm⟩
      · rintro ⟨p, hp, rfl⟩
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away f) f] at hp
        rcases hp with ⟨q, hq⟩
        exact ⟨q, congrArg ι_d'.base ((AlgebraicGeometry.Spec.map_apply
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away f))) q).trans hq)⟩
    have h_rm : (O_m : Set ↥P_m.left) =
        ι_m'.base '' (PrimeSpectrum.basicOpen h_B : Set (PrimeSpectrum R_base)) := by
      ext z
      change z ∈ Set.range _ ↔ _
      simp only [j_Om, AlgebraicGeometry.Scheme.Hom.comp_apply, Set.mem_range]
      constructor
      · rintro ⟨q, rfl⟩
        refine ⟨(AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R_base (Localization.Away h_B)))).base q, ?_, rfl⟩
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h_B) h_B]
        exact ⟨q, (AlgebraicGeometry.Spec.map_apply
          (CommRingCat.ofHom (algebraMap R_base (Localization.Away h_B))) q).symm⟩
      · rintro ⟨p, hp, rfl⟩
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h_B) h_B] at hp
        rcases hp with ⟨q, hq⟩
        exact ⟨q, congrArg ι_m'.base ((AlgebraicGeometry.Spec.map_apply
          (CommRingCat.ofHom (algebraMap R_base (Localization.Away h_B))) q).trans hq)⟩
    rw [h_rd g, h_rd g₀, h_rm, hgg₀, PrimeSpectrum.basicOpen_mul]
    ext z
    constructor
    · rintro ⟨p, ⟨hp_hB, hp_g0⟩, rfl⟩
      refine ⟨⟨p, hp_g0, rfl⟩, ?_⟩
      rw [Set.mem_preimage, ← AlgebraicGeometry.Scheme.Hom.comp_apply ι_d' π₁ p,
        hι_d'_π₁, AlgebraicGeometry.Scheme.Hom.comp_apply _ ι_m' p]
      refine ⟨PrimeSpectrum.comap π_head.toRingHom p, hp_hB, ?_⟩
      rw [AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom π_head.toRingHom) p]
      rfl
    · rintro ⟨⟨p, hp_g0, rfl⟩, hz_Om⟩
      refine ⟨p, ⟨?_, hp_g0⟩, rfl⟩
      rw [Set.mem_preimage, ← AlgebraicGeometry.Scheme.Hom.comp_apply ι_d' π₁ p,
        hι_d'_π₁, AlgebraicGeometry.Scheme.Hom.comp_apply _ ι_m' p] at hz_Om
      rcases hz_Om with ⟨p_m, hp_m, heq_pm⟩
      have hp_eq := hOpen_m.base_open.injective heq_pm
      rw [hp_eq, AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom π_head.toRingHom) p] at hp_m
      exact hp_m

  have hUg₁_eq := hUg_eq g₁ g₁₀ hg₁_eq
  have hUg₂_eq := hUg_eq g₂ g₂₀ hg₂_eq
  have hV12_eq : (V_12 : Set ↥Γ.left) =
