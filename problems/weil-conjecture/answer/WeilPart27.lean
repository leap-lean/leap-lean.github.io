        refine G₂.cond.hom_ext_ofArrows j hSieve fun i => ?_
        have hn₁ := α.hom.naturality (Opposite.op (j i))
        have hn₂ := β.hom.naturality (Opposite.op (j i))
        change H.obj.map (Opposite.op (j i)) ≫ α.hom.app (Opposite.op (V i)) =
