                    ψ_rs (algebraMap R₂ C₂ (a' j)) := by
                  have hc₁ := RingHom.congr_fun hcomm_s (algebraMap R₂ (Localization.Away s) (a' j))
                  simp only [RingHom.comp_apply] at hc₁
                  have hc₂ : α_s (algebraMap R₂ (Localization.Away s) (a' j)) =
