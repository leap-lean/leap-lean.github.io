      e₂₀ (b • x) =
        Localization.awayMap (weilTopDegKummerChartEvalHom k d Y W w₂) g₂₀ b * e₂₀ x) :
    Nonempty (WeilTopDegKummerLastCoordJointGraphPkg k m d P₁_ov P_m P_d ι_1 ι_d π₁ π₂
      Y W hW w₁ w₂ m₁ m₂) :=
by
  
  have hDomDim : ∀ (k₀ : Type u) [Field k₀]
      (R K : Type u) [CommRing R] [IsDomain R] [Algebra k₀ R] [Algebra.FiniteType k₀ R]
      [Field K] [Algebra k₀ K] [Algebra R K] [IsScalarTower k₀ R K] [IsFractionRing R K],
      ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k₀ K ∧ ringKrullDim R = (s : WithBot ℕ∞) := by
    intro k₀ _ R K _ _ _ _ _ _ _ _ _
    classical
    have : FaithfulSMul k₀ R :=
      (faithfulSMul_iff_algebraMap_injective k₀ R).mpr (algebraMap k₀ R).injective
    have : FaithfulSMul R K :=
      (faithfulSMul_iff_algebraMap_injective R K).mpr (IsFractionRing.injective R K)
    have : Algebra.IsAlgebraic R K := IsLocalization.isAlgebraic K (nonZeroDivisors R)
    have h_tr_RK : Algebra.trdeg k₀ R = Algebra.trdeg k₀ K := by
      have hadd := trdeg_add_eq k₀ R (A := K)
      rw [trdeg_eq_zero (R := R) (A := K), add_zero] at hadd
      exact hadd
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k₀ R
    let P := MvPolynomial (Fin s) k₀
    refine ⟨s, ?_, ?_⟩
    · let algPR : Algebra P R := g.toRingHom.toAlgebra
      let _ : Algebra P R := algPR
      have : IsScalarTower k₀ P R := IsScalarTower.of_algebraMap_eq fun c => (g.commutes c).symm
      have : FaithfulSMul P R := (faithfulSMul_iff_algebraMap_injective P R).mpr hg_inj
      have : Algebra.IsIntegral P R := ⟨hg_int⟩
      have : Algebra.IsAlgebraic P R := Algebra.IsIntegral.isAlgebraic
      have hadd := trdeg_add_eq k₀ P (A := R)
      rw [trdeg_eq_zero (R := P) (A := R), add_zero, MvPolynomial.trdeg_of_isDomain] at hadd
      have hcard : Cardinal.lift.{u, 0} (Cardinal.mk (Fin s)) = (s : Cardinal.{u}) := by simp
      exact hcard.symm.trans (hadd.trans h_tr_RK)
    · have hDimP : ringKrullDim P = (s : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
        simp
      rw [← hDimP]
      let algPR : Algebra P R := g.toRingHom.toAlgebra
      let _ : Algebra P R := algPR
      have : Algebra.IsIntegral P R := ⟨hg_int⟩
      apply le_antisymm
      · refine Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap P R)) ?_
        intro q₁ q₂ hlt
        have hlt_id : q₁.asIdeal < q₂.asIdeal := hlt
        obtain ⟨x, hx₂, hx₁⟩ := SetLike.exists_of_lt hlt_id
        exact Ideal.under_lt_under_of_integral_mem_sdiff (R := P)
          (le_of_lt hlt_id) ⟨hx₂, hx₁⟩ (hg_int x)
      · refine iSup_le fun p => ?_
        suffices h_lift : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum P)), p.length = n →
            ∃ q : LTSeries (PrimeSpectrum R),
              q.length = n ∧ PrimeSpectrum.comap (algebraMap P R) q.last = p.last by
          obtain ⟨q, hq_len, _⟩ := h_lift p.length p rfl
          rw [← hq_len]
          exact Order.LTSeries.length_le_krullDim q
        intro n
        induction n with
        | zero =>
          intro p _
          have hker : Ideal.comap (algebraMap P R) (⊥ : Ideal R) ≤ (p.last).asIdeal := by
            have hk0 : Ideal.comap (algebraMap P R) (⊥ : Ideal R) = ⊥ :=
              (RingHom.injective_iff_ker_eq_bot _).mp hg_inj
            rw [hk0]
            exact bot_le
          obtain ⟨Q, _, hQp, hQ_comap⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral (R := P) (S := R)
              (p.last).asIdeal (⊥ : Ideal R) hker
          refine ⟨RelSeries.singleton _ ⟨Q, hQp⟩, rfl, ?_⟩
          ext1
          exact hQ_comap
        | succ n ih =>
          intro p hpn
          have h_erase_len : p.eraseLast.length = n := by
            rw [RelSeries.eraseLast_length, hpn, Nat.add_sub_cancel]
          obtain ⟨q₀, hq₀_len, hq₀_last⟩ := ih p.eraseLast h_erase_len
          let idx : Fin p.length := ⟨n, by omega⟩
          have h_step : p.eraseLast.last < p.last := by
            have h1 : p.eraseLast.last = p idx.castSucc := by
              dsimp [RelSeries.last, RelSeries.eraseLast, idx]
              congr 1; ext; simp; omega
            have h2 : p.last = p idx.succ := by
              dsimp [RelSeries.last, idx]
              congr 1; ext; simp [hpn]
            rw [h1, h2]
            exact p.step idx
          have h_comap_le : Ideal.comap (algebraMap P R) (q₀.last).asIdeal ≤ (p.last).asIdeal := by
            have heq : Ideal.comap (algebraMap P R) (q₀.last).asIdeal =
                (p.eraseLast.last).asIdeal :=
              congrArg PrimeSpectrum.asIdeal hq₀_last
            rw [heq]
            exact le_of_lt h_step
          obtain ⟨Q, hQ_ge, hQp, hQ_comap⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (R := P) (S := R)
              (p.last).asIdeal (q₀.last).asIdeal h_comap_le
          have hQ_ge' : q₀.last ≤ (⟨Q, hQp⟩ : PrimeSpectrum R) := hQ_ge
          have hQ_lt : q₀.last < (⟨Q, hQp⟩ : PrimeSpectrum R) := by
            apply lt_of_le_of_ne hQ_ge'
            intro heq
            have hc : PrimeSpectrum.comap (algebraMap P R) q₀.last =
                PrimeSpectrum.comap (algebraMap P R) ⟨Q, hQp⟩ := congrArg _ heq
            rw [hq₀_last] at hc
            have hc' : p.eraseLast.last = p.last := by
              ext1
              exact (congrArg PrimeSpectrum.asIdeal hc).trans hQ_comap
            exact ne_of_lt h_step hc'
          refine ⟨q₀.snoc ⟨Q, hQp⟩ hQ_lt, ?_, ?_⟩
          · rw [RelSeries.snoc_length, hq₀_len]
          · rw [RelSeries.last_snoc]
            ext1
            exact hQ_comap

  
  have hMaxFin : ∀ (k₀ : Type u) [Field k₀]
      (B : Type u) [CommRing B] [Algebra k₀ B] [Algebra.FiniteType k₀ B]
      (𝔪 : Ideal B) [𝔪.IsMaximal],
      Module.Finite k₀ (B ⧸ 𝔪) := by
    intro k₀ _ B _ _ _ 𝔪 _
    let L := B ⧸ 𝔪
    let _ : Field L := Ideal.Quotient.field 𝔪
    have : Algebra.FiniteType k₀ L := Algebra.FiniteType.quotient k₀ 𝔪
    obtain ⟨s, h_tr, h_dim⟩ := hDomDim k₀ L L
    rw [ringKrullDim_eq_zero_of_field] at h_dim
    have hs0 : s = 0 := by
      have h0 : ((s : ℕ) : WithBot ℕ∞) = ((0 : ℕ) : WithBot ℕ∞) := h_dim.symm
      exact Nat.cast_injective (WithBot.coe_inj.mp h0)
    subst hs0
    have h_alg : Algebra.IsAlgebraic k₀ L := trdeg_eq_zero_iff.mp (by simpa using h_tr.symm)
    exact @Algebra.finite_of_essFiniteType_of_isAlgebraic k₀ _ L _ _ _ h_alg

  
  have hClear : ∀ (k₀ : Type u) [Field k₀]
      (m₀ d₀ : ℕ) (hmd₀ : m₀ + 1 = d₀)
      (g₁₀' g₂₀' : MvPolynomial (Fin d₀) k₀), g₁₀' ≠ 0 → g₂₀' ≠ 0 →
      ∀ (r : ℕ) (C : Fin r → Type u)
        [∀ α, CommRing (C α)] [∀ α, Algebra k₀ (C α)] [∀ α, Algebra.FiniteType k₀ (C α)],
        (∀ α : Fin r, ringKrullDim (C α) ≤ (m₀ : WithBot ℕ∞)) →
        ∀ (φ : ∀ α : Fin r, MvPolynomial (Fin m₀) k₀ →ₐ[k₀] C α),
          let π_head₀ : MvPolynomial (Fin m₀) k₀ →ₐ[k₀] MvPolynomial (Fin d₀) k₀ :=
            MvPolynomial.rename (fun i : Fin m₀ => Fin.cast hmd₀ (Fin.castSucc i))
          ∃ h_B : MvPolynomial (Fin m₀) k₀,
            h_B ≠ 0 ∧
            π_head₀ h_B * g₁₀' ≠ 0 ∧
            π_head₀ h_B * g₂₀' ≠ 0 ∧
            ∀ ev : MvPolynomial (Fin m₀) k₀ →ₐ[k₀] k₀,
              ev h_B ≠ 0 →
              let eval_ev : MvPolynomial (Fin d₀) k₀ →ₐ[k₀] Polynomial k₀ :=
                MvPolynomial.aeval (fun j : Fin d₀ =>
                  Fin.lastCases (Polynomial.X : Polynomial k₀)
                    (fun i : Fin m₀ => Polynomial.C (ev (MvPolynomial.X i)))
                    (Fin.cast hmd₀.symm j))
              eval_ev (π_head₀ h_B * g₁₀') ≠ 0 ∧
              eval_ev (π_head₀ h_B * g₂₀') ≠ 0 ∧
              ∀ (α : Fin r) (q₁ q₂ : Ideal (C α)) [q₁.IsPrime] [q₂.IsPrime],
                q₁ < q₂ →
                ¬(Ideal.comap (φ α).toRingHom q₁ = RingHom.ker ev.toRingHom ∧
                  Ideal.comap (φ α).toRingHom q₂ = RingHom.ker ev.toRingHom) := by
    intro k₀ _ m₀ d₀ hmd₀ g₁₀' g₂₀' hg₁₀' hg₂₀' r C _ _ _ hDimC φ
    classical
    subst hmd₀
    intro π_head₀
    let R_base₀ := MvPolynomial (Fin m₀) k₀
    let e_var : Option (Fin m₀) ≃ Fin (m₀ + 1) :=
      { toFun := fun o => Option.casesOn o (Fin.last m₀) Fin.castSucc
        invFun := fun j => Fin.lastCases none some j
        left_inv := fun o => by
          cases o with
          | none => simp [Fin.lastCases_last]
          | some i => simp [Fin.lastCases_castSucc]
        right_inv := fun j => by
          refine Fin.lastCases ?_ ?_ j
          · simp [Fin.lastCases_last]
          · intro i; simp [Fin.lastCases_castSucc] }
    let Φ_split_raw : MvPolynomial (Fin (m₀ + 1)) k₀ ≃ₐ[k₀] Polynomial R_base₀ :=
      (MvPolynomial.renameEquiv k₀ e_var.symm).trans (MvPolynomial.optionEquivLeft k₀ (Fin m₀))
    have hΦ_head_raw : ∀ b : R_base₀, Φ_split_raw (π_head₀ b) = Polynomial.C b := by
      suffices h_alg : Φ_split_raw.toAlgHom.comp π_head₀ =
          Polynomial.CAlgHom (R := k₀) (A := R_base₀) by
        intro b; exact AlgHom.congr_fun h_alg b
      apply MvPolynomial.algHom_ext
      intro i
      change Φ_split_raw (π_head₀ (MvPolynomial.X i)) = Polynomial.C (MvPolynomial.X i)
      dsimp [Φ_split_raw, π_head₀, e_var]
      rw [MvPolynomial.rename_X, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
      dsimp
      rw [Fin.lastCases_castSucc]
      exact MvPolynomial.optionEquivLeft_X_some k₀ (Fin m₀) i
    have hΦ_eval_raw : ∀ (ev : R_base₀ →ₐ[k₀] k₀) (p : MvPolynomial (Fin (m₀ + 1)) k₀),
        MvPolynomial.aeval (fun j : Fin (m₀ + 1) =>
          Fin.lastCases (Polynomial.X : Polynomial k₀)
            (fun i : Fin m₀ => Polynomial.C (ev (MvPolynomial.X i))) j) p =
        Polynomial.map ev.toRingHom (Φ_split_raw p) := by
      intro ev
      let lhs : MvPolynomial (Fin (m₀ + 1)) k₀ →ₐ[k₀] Polynomial k₀ :=
        MvPolynomial.aeval (fun j : Fin (m₀ + 1) =>
          Fin.lastCases (Polynomial.X : Polynomial k₀)
            (fun i : Fin m₀ => Polynomial.C (ev (MvPolynomial.X i))) j)
      let rhs : MvPolynomial (Fin (m₀ + 1)) k₀ →ₐ[k₀] Polynomial k₀ :=
        (Polynomial.mapAlgHom ev).comp Φ_split_raw.toAlgHom
      suffices h_eq : lhs = rhs from fun p => AlgHom.congr_fun h_eq p
      apply MvPolynomial.algHom_ext
      intro j
      refine Fin.lastCases ?_ ?_ j
      · change lhs (MvPolynomial.X (Fin.last m₀)) =
          Polynomial.map ev.toRingHom (Φ_split_raw (MvPolynomial.X (Fin.last m₀)))
        dsimp [lhs, Φ_split_raw, e_var]
        rw [MvPolynomial.aeval_X, Fin.lastCases_last, MvPolynomial.renameEquiv_apply,
          MvPolynomial.rename_X]
        dsimp
        rw [Fin.lastCases_last, MvPolynomial.optionEquivLeft_X_none, Polynomial.map_X]
      · intro i
        change lhs (MvPolynomial.X i.castSucc) =
          Polynomial.map ev.toRingHom (Φ_split_raw (MvPolynomial.X i.castSucc))
        dsimp [lhs, Φ_split_raw, e_var]
        rw [MvPolynomial.aeval_X, Fin.lastCases_castSucc, MvPolynomial.renameEquiv_apply,
          MvPolynomial.rename_X]
        dsimp
        rw [Fin.lastCases_castSucc, MvPolynomial.optionEquivLeft_X_some, Polynomial.map_C]
        rfl
    obtain ⟨Φ_split, hΦ_split_eq⟩ :
        ∃ e : MvPolynomial (Fin (m₀ + 1)) k₀ ≃ₐ[k₀] Polynomial R_base₀, e = Φ_split_raw := ⟨_, rfl⟩
    have hΦ_head : ∀ b : R_base₀, Φ_split (π_head₀ b) = Polynomial.C b := by
      rw [hΦ_split_eq]; exact hΦ_head_raw
    have hΦ_eval : ∀ (ev : R_base₀ →ₐ[k₀] k₀) (p : MvPolynomial (Fin (m₀ + 1)) k₀),
        MvPolynomial.aeval (fun j : Fin (m₀ + 1) =>
          Fin.lastCases (Polynomial.X : Polynomial k₀)
            (fun i : Fin m₀ => Polynomial.C (ev (MvPolynomial.X i))) j) p =
        Polynomial.map ev.toRingHom (Φ_split p) := by
      rw [hΦ_split_eq]; exact hΦ_eval_raw
    obtain ⟨P₁₀, hP₁₀_eq⟩ : ∃ P : Polynomial R_base₀, P = Φ_split g₁₀' := ⟨_, rfl⟩
    obtain ⟨P₂₀, hP₂₀_eq⟩ : ∃ P : Polynomial R_base₀, P = Φ_split g₂₀' := ⟨_, rfl⟩
    have hP₁₀ : P₁₀ ≠ 0 := by
      rw [hP₁₀_eq]; exact fun h0 => hg₁₀' (Φ_split.injective (h0.trans (map_zero _).symm))
    have hP₂₀ : P₂₀ ≠ 0 := by
      rw [hP₂₀_eq]; exact fun h0 => hg₂₀' (Φ_split.injective (h0.trans (map_zero _).symm))
    obtain ⟨c₁, hc₁_eq⟩ : ∃ c : R_base₀, c = P₁₀.leadingCoeff := ⟨_, rfl⟩
    obtain ⟨c₂, hc₂_eq⟩ : ∃ c : R_base₀, c = P₂₀.leadingCoeff := ⟨_, rfl⟩
    have hc₁ : c₁ ≠ 0 := by rw [hc₁_eq]; exact Polynomial.leadingCoeff_ne_zero.mpr hP₁₀
    have hc₂ : c₂ ≠ 0 := by rw [hc₂_eq]; exact Polynomial.leadingCoeff_ne_zero.mpr hP₂₀
    have h_alpha_factor : ∀ α : Fin r, ∃ h_α : R_base₀, h_α ≠ 0 ∧
        ∀ (ev : R_base₀ →ₐ[k₀] k₀), ev h_α ≠ 0 →
          ∀ (q₁ q₂ : Ideal (C α)) [q₁.IsPrime] [q₂.IsPrime],
            q₁ < q₂ →
            ¬(Ideal.comap (φ α).toRingHom q₁ = RingHom.ker ev.toRingHom ∧
              Ideal.comap (φ α).toRingHom q₂ = RingHom.ker ev.toRingHom) := by
      intro α
      have : IsNoetherianRing (C α) := Algebra.FiniteType.isNoetherianRing k₀ (C α)
      obtain ⟨F_α, hF_α_eq⟩ :
          ∃ S : Finset (Ideal (C α)), S = (minimalPrimes.finite_of_isNoetherianRing (C α)).toFinset :=
        ⟨_, rfl⟩
      have h_p_factor : ∀ p ∈ F_α, ∃ h_p : R_base₀, h_p ≠ 0 ∧
          ∀ (ev : R_base₀ →ₐ[k₀] k₀), ev h_p ≠ 0 →
            ∀ (q₁ q₂ : Ideal (C α)) [q₁.IsPrime] [q₂.IsPrime],
              p ≤ q₁ → q₁ < q₂ →
              ¬(Ideal.comap (φ α).toRingHom q₁ = RingHom.ker ev.toRingHom ∧
                Ideal.comap (φ α).toRingHom q₂ = RingHom.ker ev.toRingHom) := by
        intro p hp_mem
        have hp_min : p ∈ minimalPrimes (C α) := by
          rw [hF_α_eq] at hp_mem
          exact (minimalPrimes.finite_of_isNoetherianRing (C α)).mem_toFinset.mp hp_mem
        have : p.IsPrime := hp_min.1.1
        let D := C α ⧸ p
        have : IsDomain D := Ideal.Quotient.isDomain p
        have : Algebra.FiniteType k₀ D := Algebra.FiniteType.quotient k₀ p
        let ψ_p : R_base₀ →ₐ[k₀] D := (Ideal.Quotient.mkₐ k₀ p).comp (φ α)
        by_cases hInj : Function.Injective ψ_p
        · obtain ⟨s_D, hs_tr, hs_dim⟩ := hDomDim k₀ D (FractionRing D)
          have hDimD : ringKrullDim D ≤ (m₀ : WithBot ℕ∞) :=
            le_trans (ringKrullDim_quotient_le p) (hDimC α)
          rw [hs_dim] at hDimD
          have hs_le_m : s_D ≤ m₀ := Nat.cast_le.mp (WithBot.coe_le_coe.mp hDimD)
          let algRD : Algebra R_base₀ D := ψ_p.toRingHom.toAlgebra
          let _ : Algebra R_base₀ D := algRD
          have : IsScalarTower k₀ R_base₀ D :=
            IsScalarTower.of_algebraMap_eq fun c => (ψ_p.commutes c).symm
          have : FaithfulSMul R_base₀ D :=
            (faithfulSMul_iff_algebraMap_injective R_base₀ D).mpr hInj
          have h_tr_R : Algebra.trdeg k₀ R_base₀ = (m₀ : Cardinal.{u}) := by
            rw [MvPolynomial.trdeg_of_isDomain]
            simp
          have h_tr_D : Algebra.trdeg k₀ D = (s_D : Cardinal.{u}) := by
            have : FaithfulSMul D (FractionRing D) :=
              (faithfulSMul_iff_algebraMap_injective D (FractionRing D)).mpr
                (IsFractionRing.injective D _)
            have : Algebra.IsAlgebraic D (FractionRing D) :=
              IsLocalization.isAlgebraic (FractionRing D) (nonZeroDivisors D)
            have hadd := trdeg_add_eq k₀ D (A := FractionRing D)
            rw [trdeg_eq_zero (R := D) (A := FractionRing D), add_zero] at hadd
            exact hadd.trans hs_tr.symm
          have h_tr_add := trdeg_add_eq k₀ R_base₀ (A := D)
          rw [h_tr_R, h_tr_D] at h_tr_add
          have h_tr0 : Algebra.trdeg R_base₀ D = 0 := by
            by_contra hne
            have h1 : (1 : Cardinal.{u}) ≤ Algebra.trdeg R_base₀ D :=
              Cardinal.one_le_iff_ne_zero.mpr hne
            have hle1 : ((m₀ + 1 : ℕ) : Cardinal.{u}) ≤ (s_D : Cardinal.{u}) := by
              push_cast
              rw [← h_tr_add]
              exact add_le_add_right h1 _
            have hm1 : m₀ + 1 ≤ s_D := Nat.cast_le.mp hle1
            omega
          have h_algRD : Algebra.IsAlgebraic R_base₀ D := trdeg_eq_zero_iff.mp h_tr0
          obtain ⟨S_gen, hS_gen⟩ := Algebra.FiniteType.out (R := k₀) (A := D)
          have h_poly : ∀ z : S_gen, ∃ P_z : Polynomial R_base₀,
              P_z ≠ 0 ∧ Polynomial.aeval z.1 P_z = 0 := fun z => h_algRD.isAlgebraic z.1
          choose P_z hPz_ne hPz_ev using h_poly
          refine ⟨∏ z : S_gen, (P_z z).leadingCoeff, ?_, ?_⟩
          · rw [Finset.prod_ne_zero_iff]
            intro z _
            exact Polynomial.leadingCoeff_ne_zero.mpr (hPz_ne z)
          · intro ev hev q₁ q₂ _ _ hpq₁ hq_lt ⟨hq₁_ker, _⟩
            let Q := C α ⧸ q₁
            have : IsDomain Q := Ideal.Quotient.isDomain q₁
            let π_Q : D →ₐ[k₀] Q := Ideal.Quotient.factorₐ k₀ hpq₁
            have hπ_ψ : ∀ r₀ : R_base₀, π_Q (ψ_p r₀) = algebraMap k₀ Q (ev r₀) := by
              intro r₀
              have hmem_ker : r₀ - algebraMap k₀ R_base₀ (ev r₀) ∈ RingHom.ker ev.toRingHom := by
                rw [RingHom.mem_ker]
                change ev (r₀ - algebraMap k₀ R_base₀ (ev r₀)) = 0
                rw [map_sub, ev.commutes]
                exact sub_self _
              rw [← hq₁_ker, Ideal.mem_comap] at hmem_ker
              have hq0 : Ideal.Quotient.mk q₁ (φ α (r₀ - algebraMap k₀ R_base₀ (ev r₀))) = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr hmem_ker
              have hq1 : π_Q (ψ_p (r₀ - algebraMap k₀ R_base₀ (ev r₀))) = 0 := hq0
              rw [map_sub, map_sub, ψ_p.commutes, π_Q.commutes, sub_eq_zero] at hq1
              exact hq1
            have h_int_gen : ∀ z : S_gen, _root_.IsIntegral k₀ (π_Q z.1) := by
              intro z
              rw [← isAlgebraic_iff_isIntegral]
              refine ⟨Polynomial.map ev.toRingHom (P_z z), ?_, ?_⟩
              · intro hmap0
                have hdvd : (P_z z).leadingCoeff ∣ ∏ w : S_gen, (P_z w).leadingCoeff :=
                  Finset.dvd_prod_of_mem _ (Finset.mem_univ z)
                rcases hdvd with ⟨u, hu⟩
                apply hev
                rw [hu, map_mul]
                have hcoeff : (Polynomial.map ev.toRingHom (P_z z)).coeff (P_z z).natDegree =
                    ev ((P_z z).leadingCoeff) := Polynomial.coeff_map _ _
                rw [hmap0, Polynomial.coeff_zero] at hcoeff
                rw [← hcoeff, zero_mul]
              · have hev0 : π_Q.toRingHom (Polynomial.aeval z.1 (P_z z)) = 0 := by
                  change π_Q (Polynomial.aeval z.1 (P_z z)) = 0
                  rw [hPz_ev z, map_zero]
                rw [← hev0, Polynomial.aeval_def, Polynomial.eval₂_map, Polynomial.aeval_def,
                  Polynomial.hom_eval₂]
                congr 1
                exact RingHom.ext fun r₀ => (hπ_ψ r₀).symm
            have h_int_Q : Algebra.IsIntegral k₀ Q := by
              constructor
              intro y
              obtain ⟨x, rfl⟩ : ∃ x : D, π_Q x = y := Ideal.Quotient.factor_surjective hpq₁ y
              have hx_top : x ∈ (⊤ : Subalgebra k₀ D) := Algebra.mem_top
              rw [← hS_gen] at hx_top
              refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx_top
              · intro d₁ hd₁
                exact h_int_gen ⟨d₁, hd₁⟩
              · intro c
                rw [AlgHom.commutes]
                exact isIntegral_algebraMap
              · intro a b _ _ ha hb
                rw [map_add]
                exact ha.add hb
              · intro a b _ _ ha hb
                rw [map_mul]
                exact ha.mul hb
            have hFieldQ : IsField Q :=
              @isField_of_isIntegral_of_isField' k₀ Q _ _ _ _ h_int_Q (Field.toIsField k₀)
            obtain ⟨x, hx₂, hx₁⟩ := SetLike.exists_of_lt hq_lt
            let xbar : Q := Ideal.Quotient.mk q₁ x
            have hxbar_ne : xbar ≠ 0 := fun h0 => hx₁ (Ideal.Quotient.eq_zero_iff_mem.mp h0)
            obtain ⟨ybar, hybar⟩ := hFieldQ.mul_inv_cancel hxbar_ne
            obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective ybar
            have h1_mem : (1 : C α) ∈ q₂ := by
              have hsub : 1 - x * y ∈ q₁ := by
                apply Ideal.Quotient.eq_zero_iff_mem.mp
                rw [map_sub, map_one, map_mul, hybar, sub_self]
              have hxy : x * y ∈ q₂ := q₂.mul_mem_right y hx₂
              have hsum := q₂.add_mem (le_of_lt hq_lt hsub) hxy
              simpa using hsum
            exact ‹q₂.IsPrime›.ne_top (Ideal.eq_top_of_isUnit_mem q₂ h1_mem isUnit_one)
        · have hker_ne : RingHom.ker ψ_p.toRingHom ≠ ⊥ :=
            fun h0 => hInj ((RingHom.injective_iff_ker_eq_bot _).mpr h0)
          obtain ⟨h_p, hh_mem, hh_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker_ne
          refine ⟨h_p, hh_ne, ?_⟩
          intro ev hev q₁ q₂ _ _ hpq₁ _ ⟨hq₁_ker, _⟩
          have hφ_p : φ α h_p ∈ p := Ideal.Quotient.eq_zero_iff_mem.mp hh_mem
          have hφ_q₁ : h_p ∈ Ideal.comap (φ α).toRingHom q₁ := hpq₁ hφ_p
          rw [hq₁_ker, RingHom.mem_ker] at hφ_q₁
          exact hev hφ_q₁
      choose f_p hf_p_ne hf_p_spec using fun (p : F_α) => h_p_factor p.1 p.2
      refine ⟨∏ p : F_α, f_p p, ?_, ?_⟩
      · rw [Finset.prod_ne_zero_iff]
        intro p _
        exact hf_p_ne p
      · intro ev hev q₁ q₂ _ _ hq_lt hboth
        obtain ⟨p, hp_min, hp_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ q₁)
        have hp_F : p ∈ F_α := by
          rw [hF_α_eq]
          exact (minimalPrimes.finite_of_isNoetherianRing (C α)).mem_toFinset.mpr hp_min
        let p_sub : F_α := ⟨p, hp_F⟩
        have hev_p : ev (f_p p_sub) ≠ 0 := by
          intro h0
          have hdvd : f_p p_sub ∣ ∏ w : F_α, f_p w :=
            Finset.dvd_prod_of_mem f_p (Finset.mem_univ p_sub)
          rcases hdvd with ⟨u, hu⟩
          apply hev
          rw [hu, map_mul, h0, zero_mul]
        exact hf_p_spec p_sub ev hev_p q₁ q₂ hp_le hq_lt hboth
    choose h_α hh_α_ne hh_α_spec using h_alpha_factor
    obtain ⟨h_B, hh_B_eq⟩ : ∃ x : R_base₀, x = c₁ * c₂ * ∏ α : Fin r, h_α α := ⟨_, rfl⟩
    have hh_B_ne : h_B ≠ 0 := by
      rw [hh_B_eq]
      refine mul_ne_zero (mul_ne_zero hc₁ hc₂) ?_
      rw [Finset.prod_ne_zero_iff]
      intro α _
      exact hh_α_ne α
    obtain ⟨π_head', hπ_head_eq⟩ :
        ∃ f : R_base₀ →ₐ[k₀] MvPolynomial (Fin (m₀ + 1)) k₀, f = π_head₀ := ⟨_, rfl⟩
    have hπ_inj : Function.Injective π_head' := by
      rw [hπ_head_eq]
      exact MvPolynomial.rename_injective _ (Fin.castSucc_injective m₀)
    have hπ_hB_ne : π_head' h_B ≠ 0 :=
      fun h0 => hh_B_ne (hπ_inj (h0.trans (map_zero _).symm))
    refine ⟨h_B, hh_B_ne, ?_, ?_, ?_⟩
    · rw [← hπ_head_eq]; exact mul_ne_zero hπ_hB_ne hg₁₀'
    · rw [← hπ_head_eq]; exact mul_ne_zero hπ_hB_ne hg₂₀'
    intro ev hev eval_ev
    obtain ⟨eval_ev', heval_ev_eq⟩ :
        ∃ f : MvPolynomial (Fin (m₀ + 1)) k₀ →ₐ[k₀] Polynomial k₀, f = eval_ev := ⟨_, rfl⟩
    have hev_c₁ : ev c₁ ≠ 0 := by
      intro h0; apply hev; rw [hh_B_eq, map_mul, map_mul, h0, zero_mul, zero_mul]
    have hev_c₂ : ev c₂ ≠ 0 := by
      intro h0; apply hev; rw [hh_B_eq, map_mul, map_mul, h0, mul_zero, zero_mul]
    have hev_head : eval_ev' (π_head' h_B) = Polynomial.C (ev h_B) := by
      rw [heval_ev_eq, hπ_head_eq]
      dsimp [eval_ev]
      rw [hΦ_eval, hΦ_head, Polynomial.map_C]
      rfl
    have hev_hB_poly : eval_ev' (π_head' h_B) ≠ 0 := by
      rw [hev_head]
      exact Polynomial.C_ne_zero.mpr hev
    have hev_g₁₀ : eval_ev' g₁₀' ≠ 0 := by
      rw [heval_ev_eq]
      dsimp [eval_ev]
      rw [hΦ_eval, ← hP₁₀_eq]
      intro hmap0
      have hc : (Polynomial.map ev.toRingHom P₁₀).coeff P₁₀.natDegree = ev c₁ := by
        rw [hc₁_eq]; exact Polynomial.coeff_map _ _
      rw [hmap0, Polynomial.coeff_zero] at hc
      exact hev_c₁ hc.symm
    have hev_g₂₀ : eval_ev' g₂₀' ≠ 0 := by
      rw [heval_ev_eq]
      dsimp [eval_ev]
      rw [hΦ_eval, ← hP₂₀_eq]
      intro hmap0
      have hc : (Polynomial.map ev.toRingHom P₂₀).coeff P₂₀.natDegree = ev c₂ := by
        rw [hc₂_eq]; exact Polynomial.coeff_map _ _
      rw [hmap0, Polynomial.coeff_zero] at hc
      exact hev_c₂ hc.symm
    refine ⟨?_, ?_, ?_⟩
    · rw [← heval_ev_eq, ← hπ_head_eq, map_mul]
      exact mul_ne_zero hev_hB_poly hev_g₁₀
    · rw [← heval_ev_eq, ← hπ_head_eq, map_mul]
      exact mul_ne_zero hev_hB_poly hev_g₂₀
    · intro α q₁ q₂ _ _ hq_lt
      have hev_α : ev (h_α α) ≠ 0 := by
        intro h0
        have hdvd : h_α α ∣ ∏ β : Fin r, h_α β := Finset.dvd_prod_of_mem h_α (Finset.mem_univ α)
        rcases hdvd with ⟨u, hu⟩
        apply hev
        rw [hh_B_eq, hu, map_mul, map_mul, map_mul, h0, zero_mul, mul_zero]
      exact hh_α_spec α ev hev_α q₁ q₂ hq_lt

  
  have hBasis : ∀ {R₀' A' : Type u} [CommRing R₀'] [CommRing A']
      (ψ : R₀' →+* A') (h₀ g₀ : R₀') (m_rk : ℕ)
      (M₀ : Type u) [AddCommGroup M₀] [Module (Localization.Away g₀) M₀]
      (_b₀ : Module.Basis (Fin m_rk) (Localization.Away g₀) M₀)
      (e₀ : M₀ ≃+ Localization.Away (ψ g₀)),
      (∀ (b : Localization.Away g₀) (x : M₀),
        e₀ (b • x) = Localization.awayMap ψ g₀ b * e₀ x) →
      let g := h₀ * g₀
      ∃ (M : Type u) (hAdd : AddCommGroup M) (hMod : Module (Localization.Away g) M),
        letI := hAdd; letI := hMod
        ∃ (_bM : Module.Basis (Fin m_rk) (Localization.Away g) M)
          (eM : M ≃+ Localization.Away (ψ g)),
          (∀ (b : Localization.Away g) (x : M),
            eM (b • x) = Localization.awayMap ψ g b * eM x) ∧
          (Localization.awayMap ψ g).Finite ∧
          ∀ (Q : Type u) [CommRing Q] (θ : Localization.Away g →+* Q),
            let algBQ : Algebra (Localization.Away g) Q := θ.toAlgebra
            let algBA : Algebra (Localization.Away g) (Localization.Away (ψ g)) :=
              (Localization.awayMap ψ g).toAlgebra
            letI := algBQ; letI := algBA
            let B_Q : Type u := TensorProduct (Localization.Away g) Q (Localization.Away (ψ g))
            let φ_Q : Q →+* B_Q := Algebra.TensorProduct.includeLeftRingHom
            ∃ (M_s : Type u) (hAdd_s : AddCommGroup M_s) (hMod_s : Module Q M_s),
              letI := hAdd_s; letI := hMod_s
              ∃ (_b_s : Module.Basis (Fin m_rk) Q M_s) (e_s : M_s ≃+ B_Q),
                ∀ (q : Q) (x : M_s), e_s (q • x) = φ_Q q * e_s x := by
    intro R₀' A' _ _ ψ h₀ g₀ m_rk M₀ _ _ b₀ e₀ he₀ g
    let B₀ := Localization.Away g₀
    let A₀ := Localization.Away (ψ g₀)
    let B := Localization.Away g
    let A_g := Localization.Away (ψ g)
    let ψ₀ : B₀ →+* A₀ := Localization.awayMap ψ g₀
    let ψ_g : B →+* A_g := Localization.awayMap ψ g
    have h_ug : IsUnit (algebraMap R₀' B g) := IsLocalization.Away.algebraMap_isUnit g
    have h_uh₀ : IsUnit (algebraMap R₀' B h₀) := by
      have hm : algebraMap R₀' B h₀ * (algebraMap R₀' B g₀ * IsLocalization.Away.invSelf g) = 1 := by
        rw [← mul_assoc, ← map_mul]
        exact IsLocalization.Away.mul_invSelf g
      exact ⟨⟨_, _, hm, by rw [mul_comm]; exact hm⟩, rfl⟩
    have h_ug₀ : IsUnit (algebraMap R₀' B g₀) := by
      have hm : algebraMap R₀' B g₀ * (algebraMap R₀' B h₀ * IsLocalization.Away.invSelf g) = 1 := by
        rw [← mul_assoc, mul_comm (algebraMap R₀' B g₀), ← map_mul]
        exact IsLocalization.Away.mul_invSelf g
      exact ⟨⟨_, _, hm, by rw [mul_comm]; exact hm⟩, rfl⟩
    have h_uψg₀ : IsUnit (algebraMap A' A_g (ψ g₀)) := by
      have hm : algebraMap A' A_g (ψ g₀) *
          (algebraMap A' A_g (ψ h₀) * IsLocalization.Away.invSelf (ψ g)) = 1 := by
        rw [← mul_assoc, mul_comm (algebraMap A' A_g (ψ g₀)), ← map_mul, ← map_mul]
        exact IsLocalization.Away.mul_invSelf (ψ g)
      exact ⟨⟨_, _, hm, by rw [mul_comm]; exact hm⟩, rfl⟩
    let ι_B : B₀ →+* B := IsLocalization.Away.lift g₀ h_ug₀
    let ι_A : A₀ →+* A_g := IsLocalization.Away.lift (ψ g₀) h_uψg₀
    have h_ι_comm : ψ_g.comp ι_B = ι_A.comp ψ₀ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g₀)
      ext r
      simp only [RingHom.comp_apply]
      calc
        ψ_g (ι_B (algebraMap R₀' B₀ r))
          = ψ_g (algebraMap R₀' B r) := congrArg ψ_g (IsLocalization.Away.lift_eq g₀ h_ug₀ r)
        _ = algebraMap A' A_g (ψ r) := IsLocalization.map_eq _ r
        _ = ι_A (algebraMap A' A₀ (ψ r)) := (IsLocalization.Away.lift_eq (ψ g₀) h_uψg₀ (ψ r)).symm
        _ = ι_A (ψ₀ (algebraMap R₀' B₀ r)) := congrArg ι_A (IsLocalization.map_eq _ r).symm
    let algBA : Algebra B A_g := ψ_g.toAlgebra
    let _ : Algebra B A_g := algBA
    let w : Fin m_rk → A_g := fun i => ι_A (e₀ (b₀ i))
    have hw_li : LinearIndependent B w := by
      rw [Fintype.linearIndependent_iff]
      intro c hc
      choose n_i r_i h_ci using fun i : Fin m_rk => IsLocalization.Away.surj g (c i)
      let N : ℕ := Finset.univ.sup n_i
      let r'_i : Fin m_rk → R₀' := fun i => r_i i * g ^ (N - n_i i)
      have h_ci_N : ∀ i : Fin m_rk,
          c i * (algebraMap R₀' B g) ^ N = ι_B (algebraMap R₀' B₀ (r'_i i)) := by
        intro i
        have hN : n_i i + (N - n_i i) = N := Nat.add_sub_of_le (Finset.le_sup (Finset.mem_univ i))
        calc
          c i * (algebraMap R₀' B g) ^ N
            = c i * (algebraMap R₀' B g) ^ (n_i i + (N - n_i i)) := by rw [hN]
          _ = (c i * (algebraMap R₀' B g) ^ n_i i) * (algebraMap R₀' B g) ^ (N - n_i i) := by
            rw [pow_add, mul_assoc]
          _ = algebraMap R₀' B (r_i i) * algebraMap R₀' B (g ^ (N - n_i i)) := by
            rw [h_ci i, map_pow]
          _ = algebraMap R₀' B (r'_i i) := (map_mul _ _ _).symm
          _ = ι_B (algebraMap R₀' B₀ (r'_i i)) := (IsLocalization.Away.lift_eq g₀ h_ug₀ _).symm
      let x₀ : A₀ := ∑ i : Fin m_rk, ψ₀ (algebraMap R₀' B₀ (r'_i i)) * e₀ (b₀ i)
      have hx₀_map : ι_A x₀ = 0 := by
        dsimp [x₀]
        rw [map_sum]
        have h_mul0 : ψ_g ((algebraMap R₀' B g) ^ N) * (∑ i : Fin m_rk, c i • w i) = 0 := by
          rw [hc, mul_zero]
        rw [Finset.mul_sum] at h_mul0
        refine (Finset.sum_congr rfl fun i _ => ?_).trans h_mul0
        calc
          ι_A (ψ₀ (algebraMap R₀' B₀ (r'_i i)) * e₀ (b₀ i))
            = ι_A (ψ₀ (algebraMap R₀' B₀ (r'_i i))) * w i := map_mul _ _ _
          _ = ψ_g (ι_B (algebraMap R₀' B₀ (r'_i i))) * w i :=
              congrArg (· * w i) (RingHom.congr_fun h_ι_comm _).symm
          _ = ψ_g (c i * (algebraMap R₀' B g) ^ N) * w i :=
              congrArg (fun t => ψ_g t * w i) (h_ci_N i).symm
          _ = (ψ_g (c i) * ψ_g ((algebraMap R₀' B g) ^ N)) * w i :=
              congrArg (· * w i) (map_mul ψ_g _ _)
          _ = ψ_g ((algebraMap R₀' B g) ^ N) * (c i • w i) := by
              change (ψ_g (c i) * ψ_g ((algebraMap R₀' B g) ^ N)) * w i =
                ψ_g ((algebraMap R₀' B g) ^ N) * (ψ_g (c i) * w i)
              ring
      obtain ⟨m₀_p, a₀, ha₀_eq⟩ := IsLocalization.Away.surj (ψ g₀) x₀
      have ha₀_map0 : algebraMap A' A_g a₀ = 0 := by
        have h1 : ι_A (x₀ * (algebraMap A' A₀ (ψ g₀)) ^ m₀_p) = ι_A (algebraMap A' A₀ a₀) :=
          congrArg ι_A ha₀_eq
        rw [map_mul, hx₀_map, zero_mul] at h1
        exact (IsLocalization.Away.lift_eq (ψ g₀) h_uψg₀ a₀).symm.trans h1.symm
      rw [IsLocalization.map_eq_zero_iff (Submonoid.powers (ψ g)) A_g] at ha₀_map0
      obtain ⟨⟨_, K_p, rfl⟩, hK0⟩ := ha₀_map0
      have hx₀_kill : ψ₀ (algebraMap R₀' B₀ (h₀ ^ K_p)) * x₀ = 0 := by
        have h_u₀ : IsUnit ((algebraMap A' A₀ (ψ g₀)) ^ m₀_p) :=
          (IsLocalization.Away.algebraMap_isUnit (ψ g₀)).pow m₀_p
        apply h_u₀.mul_right_cancel
        rw [zero_mul, mul_assoc, ha₀_eq]
        have h_psi0 : ψ₀ (algebraMap R₀' B₀ (h₀ ^ K_p)) = algebraMap A' A₀ (ψ (h₀ ^ K_p)) :=
          IsLocalization.map_eq _ (h₀ ^ K_p)
        rw [h_psi0, ← map_mul]
        have h_uK : IsUnit ((algebraMap A' A₀ (ψ g₀)) ^ K_p) :=
          (IsLocalization.Away.algebraMap_isUnit (ψ g₀)).pow K_p
        apply h_uK.mul_left_cancel
        rw [mul_zero, ← map_pow, ← map_mul]
        have h_eqA : (ψ g₀) ^ K_p * (ψ (h₀ ^ K_p) * a₀) = (ψ g) ^ K_p * a₀ := by
          dsimp [g]
          rw [map_mul, map_pow, mul_pow, ← mul_assoc, mul_comm ((ψ g₀) ^ K_p)]
        rw [h_eqA, hK0, map_zero]
      have h_e0_sum : e₀ (∑ i : Fin m_rk, (algebraMap R₀' B₀ (h₀ ^ K_p * r'_i i)) • b₀ i) = 0 := by
        rw [map_sum]
        have h_rw : (∑ i : Fin m_rk, e₀ ((algebraMap R₀' B₀ (h₀ ^ K_p * r'_i i)) • b₀ i)) =
            ψ₀ (algebraMap R₀' B₀ (h₀ ^ K_p)) * x₀ := by
          dsimp [x₀]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [he₀, map_mul, map_mul, mul_assoc]
        exact h_rw.trans hx₀_kill
      have h_sum0 : (∑ i : Fin m_rk, (algebraMap R₀' B₀ (h₀ ^ K_p * r'_i i)) • b₀ i) = 0 :=
        e₀.injective (h_e0_sum.trans (map_zero e₀).symm)
      have h_coeff0 := Fintype.linearIndependent_iff.mp b₀.linearIndependent _ h_sum0
      intro i
      have h_mapB0 : ι_B (algebraMap R₀' B₀ (h₀ ^ K_p * r'_i i)) = 0 := by
        rw [h_coeff0 i, map_zero]
      have h_prod0 : (algebraMap R₀' B h₀) ^ K_p * (c i * (algebraMap R₀' B g) ^ N) = 0 := by
        calc
          (algebraMap R₀' B h₀) ^ K_p * (c i * (algebraMap R₀' B g) ^ N)
            = (algebraMap R₀' B h₀) ^ K_p * ι_B (algebraMap R₀' B₀ (r'_i i)) :=
              congrArg _ (h_ci_N i)
          _ = ι_B (algebraMap R₀' B₀ (h₀ ^ K_p)) * ι_B (algebraMap R₀' B₀ (r'_i i)) := by
              rw [IsLocalization.Away.lift_eq g₀ h_ug₀ (h₀ ^ K_p), map_pow]
          _ = ι_B (algebraMap R₀' B₀ (h₀ ^ K_p * r'_i i)) := by rw [← map_mul, ← map_mul]
          _ = 0 := h_mapB0
      have h_uB1 : IsUnit ((algebraMap R₀' B h₀) ^ K_p) := h_uh₀.pow K_p
      have h_uB2 : IsUnit ((algebraMap R₀' B g) ^ N) := h_ug.pow N
      exact h_uB2.mul_right_cancel
        ((h_uB1.mul_left_cancel (h_prod0.trans (mul_zero _).symm)).trans (zero_mul _).symm)
    have hw_span : ⊤ ≤ Submodule.span B (Set.range w) := by
      intro z _
      obtain ⟨k_pow, a, hak⟩ := IsLocalization.Away.surj (ψ g) z
      have h_ug_inv : z = ((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) • algebraMap A' A_g a := by
        have h_psi_ug : ψ_g (algebraMap R₀' B g) = algebraMap A' A_g (ψ g) :=
          IsLocalization.map_eq _ g
        have h_uA : IsUnit ((algebraMap A' A_g (ψ g)) ^ k_pow) :=
          (IsLocalization.Away.algebraMap_isUnit (ψ g)).pow k_pow
        apply h_uA.mul_right_cancel
        have hu1 : ((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) * (algebraMap R₀' B g) ^ k_pow = 1 := by
          change ((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) * ((h_ug.unit : Bˣ) ^ k_pow : B) = 1
          rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_mul,
            ← mul_pow, inv_mul_cancel, one_pow, Units.val_one]
        calc
          z * (algebraMap A' A_g (ψ g)) ^ k_pow
            = algebraMap A' A_g a := hak
          _ = 1 * algebraMap A' A_g a := (one_mul _).symm
          _ = ψ_g (((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) * (algebraMap R₀' B g) ^ k_pow) *
              algebraMap A' A_g a := by rw [hu1, map_one]
          _ = (ψ_g ((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) * ψ_g ((algebraMap R₀' B g) ^ k_pow)) *
              algebraMap A' A_g a := congrArg (· * algebraMap A' A_g a) (map_mul ψ_g _ _)
          _ = (ψ_g ((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) * (ψ_g (algebraMap R₀' B g)) ^ k_pow) *
              algebraMap A' A_g a := congrArg (fun t => (_ * t) * _) (map_pow ψ_g _ _)
          _ = (ψ_g ((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) * (algebraMap A' A_g (ψ g)) ^ k_pow) *
              algebraMap A' A_g a :=
              congrArg (fun t => (ψ_g _ * t ^ k_pow) * algebraMap A' A_g a) h_psi_ug
          _ = (ψ_g ((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) * algebraMap A' A_g a) *
              (algebraMap A' A_g (ψ g)) ^ k_pow := by ring
          _ = (((h_ug.unit⁻¹ : Bˣ) ^ k_pow : B) • algebraMap A' A_g a) *
              (algebraMap A' A_g (ψ g)) ^ k_pow := rfl
      rw [h_ug_inv]
      refine Submodule.smul_mem _ _ ?_
      let v₀ : M₀ := e₀.symm (algebraMap A' A₀ a)
      have hv₀ : ∑ i : Fin m_rk, (b₀.repr v₀ i) • b₀ i = v₀ := b₀.sum_repr v₀
      have he_v₀ : algebraMap A' A₀ a = ∑ i : Fin m_rk, ψ₀ (b₀.repr v₀ i) * e₀ (b₀ i) := by
        calc
          algebraMap A' A₀ a = e₀ v₀ := (e₀.apply_symm_apply _).symm
          _ = e₀ (∑ i : Fin m_rk, (b₀.repr v₀ i) • b₀ i) := by rw [hv₀]
          _ = ∑ i : Fin m_rk, ψ₀ (b₀.repr v₀ i) * e₀ (b₀ i) := by
            rw [map_sum]
            exact Finset.sum_congr rfl fun i _ => he₀ _ _
      have ha_eq : algebraMap A' A_g a = ∑ i : Fin m_rk, (ι_B (b₀.repr v₀ i)) • w i := by
        calc
          algebraMap A' A_g a = ι_A (algebraMap A' A₀ a) :=
            (IsLocalization.Away.lift_eq (ψ g₀) h_uψg₀ a).symm
          _ = ∑ i : Fin m_rk, ι_A (ψ₀ (b₀.repr v₀ i)) * w i := by
            rw [he_v₀, map_sum]
            exact Finset.sum_congr rfl fun i _ => map_mul _ _ _
          _ = ∑ i : Fin m_rk, (ι_B (b₀.repr v₀ i)) • w i := by
            refine Finset.sum_congr rfl fun i _ => ?_
            have hc : ι_A (ψ₀ (b₀.repr v₀ i)) = ψ_g (ι_B (b₀.repr v₀ i)) :=
              (RingHom.congr_fun h_ι_comm _).symm
            rw [hc]; rfl
      rw [ha_eq]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    let bM : Module.Basis (Fin m_rk) B A_g := Module.Basis.mk hw_li hw_span
    have hFin_g : ψ_g.Finite := by
      change Module.Finite B A_g
      exact Module.Finite.of_basis bM
    refine ⟨A_g, inferInstance, algBA.toModule, bM, AddEquiv.refl A_g, fun _ _ => rfl, hFin_g, ?_⟩
    intro Q _ θ algBQ _ B_Q φ_Q
    let _ : Algebra B Q := algBQ
    let b_tens : Module.Basis (Fin m_rk) Q B_Q := Algebra.TensorProduct.basis Q bM
    refine ⟨B_Q, inferInstance, inferInstance, b_tens, AddEquiv.refl B_Q, ?_⟩
    intro q x
    dsimp only [AddEquiv.refl_apply]
    refine TensorProduct.inductionOn x (fun q' a => ?_) (fun x₁ x₂ ih₁ ih₂ => ?_)
    · change (q • q') ⊗ₜ[B] a = (q ⊗ₜ[B] (1 : A_g)) * (q' ⊗ₜ[B] a)
      rw [Algebra.TensorProduct.tmul_mul_tmul, smul_eq_mul, one_mul]
    · rw [smul_add, mul_add, ih₁, ih₂]

  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let R_base := MvPolynomial (Fin m) k
  let R₀ := MvPolynomial (Fin d) k
  let π_head : R_base →ₐ[k] R₀ :=
    MvPolynomial.rename (fun i : Fin m => Fin.cast hmd (Fin.castSucc i))
  let ι_m' : AlgebraicGeometry.Spec (CommRingCat.of R_base) ⟶ P_m.left := ι_m
  let ι_d' : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ P_d.left := ι_d
  have : AlgebraicGeometry.IsOpenImmersion ι_1 := hOpen_1
  have : AlgebraicGeometry.IsOpenImmersion ι_m' := hOpen_m
  have : AlgebraicGeometry.IsOpenImmersion ι_d' := hOpen_d
  have hι_m'_ov : ι_m' ≫ P_m.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R_base)) := hι_m_ov
  have hι_d'_ov : ι_d' ≫ P_d.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* R₀)) := hι_d_ov
  have hι_d'_π₁ : ι_d' ≫ π₁ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_head.toRingHom) ≫ ι_m' := hι_d_π₁
  have hι_d'_π₂ : ι_d' ≫ π₂ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Polynomial.aeval
          (MvPolynomial.X (Fin.cast hmd (Fin.last m)) : MvPolynomial (Fin d) k)).toRingHom) ≫ ι_1 :=
    hι_d_π₂

  
  have h_spec_over : ∀ (Z : CategoryTheory.Over S_k) (U : Z.left.Opens)
      (hU : AlgebraicGeometry.IsAffineOpen U),
      hU.fromSpec ≫ Z.hom =
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ U le_top) := by
    intro Z U hU
    rw [AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Scheme.isoSpec_Spec_inv (CommRingCat.of k),
      ← AlgebraicGeometry.IsAffineOpen.fromSpec_top,
      (AlgebraicGeometry.isAffineOpen_top S_k).SpecMap_appLE_fromSpec Z.hom hU le_top]

  
  have h_pb_open : ∀ {X₀ S₀ X S : AlgebraicGeometry.Scheme.{u}}
      (j_X : X₀ ⟶ X) (f₀ : X₀ ⟶ S₀) (f : X ⟶ S) (j_S : S₀ ⟶ S)
      [AlgebraicGeometry.IsOpenImmersion j_X] [AlgebraicGeometry.IsOpenImmersion j_S]
      (hw : j_X ≫ f = f₀ ≫ j_S),
      Set.range j_X.base = f.base ⁻¹' Set.range j_S.base →
      CategoryTheory.IsPullback j_X f₀ f j_S := by
    intro X₀ S₀ X S j_X f₀ f j_S _ _ hw hrange
    have h_sub : ∀ s : CategoryTheory.Limits.PullbackCone f j_S,
        Set.range s.fst.base ⊆ Set.range j_X.base := by
      intro s x hx
      rcases hx with ⟨t, rfl⟩
      rw [hrange, Set.mem_preimage]
      have ht : (s.fst ≫ f).base t = (s.snd ≫ j_S).base t :=
        congrArg (fun φ => φ.base t) s.condition
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Scheme.Hom.comp_apply] at ht
      rw [ht]
      exact ⟨s.snd.base t, rfl⟩
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift j_X s.fst (h_sub s))
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift_fac j_X s.fst (h_sub s))
        (fun s => by
          rw [← cancel_mono j_S, CategoryTheory.Category.assoc, ← hw,
            ← CategoryTheory.Category.assoc,
            AlgebraicGeometry.IsOpenImmersion.lift_fac j_X s.fst (h_sub s), s.condition])
        (fun s u hu _ => by
          rw [← cancel_mono j_X, hu,
            AlgebraicGeometry.IsOpenImmersion.lift_fac j_X s.fst (h_sub s)]))

  
  have h_open_preirred : ∀ {T : Type u} [TopologicalSpace T] {F U : Set T},
      IsPreirreducible F → IsOpen U →
      IsPreirreducible ((Subtype.val : ↥U → T) ⁻¹' F) := by
    intro T _ F U hF hU
    rw [isPreirreducible_iff_isClosed_union_isClosed] at hF ⊢
    intro z₁ z₂ hz₁ hz₂ hsub
    rw [isClosed_induced_iff] at hz₁ hz₂
    rcases hz₁ with ⟨D₁, hD₁, rfl⟩
    rcases hz₂ with ⟨D₂, hD₂, rfl⟩
    have hF_cov : F ⊆ (D₁ ∪ D₂) ∪ Uᶜ := by
      intro x hx
      by_cases hxU : x ∈ U
      · exact Or.inl (hsub (show (⟨x, hxU⟩ : ↥U) ∈ Subtype.val ⁻¹' F from hx))
      · exact Or.inr hxU
    rcases hF (D₁ ∪ D₂) Uᶜ (hD₁.union hD₂) hU.isClosed_compl hF_cov with hFD | hFUc
    · rcases hF D₁ D₂ hD₁ hD₂ hFD with h1 | h2
      · left; intro y hy; exact h1 hy
      · right; intro y hy; exact h2 hy
    · left; intro y hy; exact False.elim (hFUc hy y.2)

  
  have h_irred_vanishing_prime : ∀ {R : Type u} [CommRing R]
      (H : TopologicalSpace.IrreducibleCloseds (PrimeSpectrum R)),
      (PrimeSpectrum.vanishingIdeal (H : Set (PrimeSpectrum R))).IsPrime ∧
      PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal (H : Set (PrimeSpectrum R)) : Set R) =
        (H : Set (PrimeSpectrum R)) := by
    intro R _ H
    have hzl : PrimeSpectrum.zeroLocus
        (PrimeSpectrum.vanishingIdeal (H : Set (PrimeSpectrum R)) : Set R) =
        (H : Set (PrimeSpectrum R)) := by
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, H.isClosed.closure_eq]
    refine ⟨?_, hzl⟩
    rw [Ideal.isPrime_iff]
    refine ⟨?_, ?_⟩
    · obtain ⟨q₀, hq₀⟩ := H.isIrreducible.nonempty
      intro htop
      have h1 : (1 : R) ∈ PrimeSpectrum.vanishingIdeal (H : Set (PrimeSpectrum R)) := by
        rw [htop]; trivial
      exact q₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _
        ((PrimeSpectrum.mem_vanishingIdeal _ _).mp h1 q₀ hq₀) isUnit_one)
    · intro a b hab
      have hsub : (H : Set (PrimeSpectrum R)) ⊆
          PrimeSpectrum.zeroLocus ({a} : Set R) ∪ PrimeSpectrum.zeroLocus ({b} : Set R) := by
        intro q hq
        have hab_q : a * b ∈ q.asIdeal := (PrimeSpectrum.mem_vanishingIdeal _ _).mp hab q hq
        rcases q.isPrime.mem_or_mem hab_q with ha | hb
        · exact Or.inl (Set.singleton_subset_iff.mpr ha)
        · exact Or.inr (Set.singleton_subset_iff.mpr hb)
      have hpre := isPreirreducible_iff_isClosed_union_isClosed.mp H.isIrreducible.isPreirreducible
        _ _ (PrimeSpectrum.isClosed_zeroLocus _) (PrimeSpectrum.isClosed_zeroLocus _) hsub
      rcases hpre with ha | hb
      · left; exact (PrimeSpectrum.mem_vanishingIdeal _ _).mpr fun q hq => ha hq (Set.mem_singleton a)
      · right; exact (PrimeSpectrum.mem_vanishingIdeal _ _).mpr fun q hq => hb hq (Set.mem_singleton b)

  
  have h_open_dim_eq : ∀ (Z : CategoryTheory.Over S_k)
      (_ : AlgebraicGeometry.IsIntegral Z.left) [AlgebraicGeometry.IsProper Z.hom]
      (O : Z.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen O) (_ : Nonempty ↥O),
      topologicalKrullDim Z.left = topologicalKrullDim ↥O := by
    intro Z hIntZ _ O hAffO hNeO
    let _ : AlgebraicGeometry.IsIntegral Z.left := hIntZ
    have : Nonempty ↥((⊤ : Z.left.Opens) : AlgebraicGeometry.Scheme.{u}) :=
      let ⟨z₀⟩ := hIntZ.nonempty; ⟨⟨z₀, trivial⟩⟩
    let kToFF : k →+* ↑Z.left.functionField :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ ⊤ le_top ≫
        Z.left.germToFunctionField ⊤).hom
    let algKFF : Algebra k ↑Z.left.functionField := kToFF.toAlgebra
    let _ : Algebra k ↑Z.left.functionField := algKFF
    have h_aff_dim : ∀ (U : Z.left.Opens),
        AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
        ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k ↑Z.left.functionField ∧
          topologicalKrullDim ↥U = (s : WithBot ℕ∞) := by
      intro U hAffU ⟨xU, hxU⟩
      have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := ⟨⟨xU, hxU⟩⟩
      let R_U := ↑(Z.left.presheaf.obj (Opposite.op U))
      have : IsDomain R_U := @AlgebraicGeometry.IsIntegral.component_integral Z.left hIntZ U inferInstance
      let algKU : Algebra k R_U :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ U le_top).hom.toAlgebra
      let _ : Algebra k R_U := algKU
      have : Algebra.FiniteType k R_U := by
        have h1 : RingHom.FiniteType (AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ U le_top).hom :=
          Z.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_k) hAffU le_top
        have h2 : RingHom.FiniteType
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
          RingHom.FiniteType.of_surjective _
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv).surjective
        exact h1.comp h2
      have : IsFractionRing R_U ↑Z.left.functionField :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z.left U hAffU
      have : IsScalarTower k R_U ↑Z.left.functionField := by
        refine IsScalarTower.of_algebraMap_eq fun c => ?_
        have hmap : AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ ⊤ le_top ≫
            Z.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE (le_top : U ≤ ⊤))) =
            AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ U le_top :=
          AlgebraicGeometry.Scheme.Hom.appLE_map Z.hom le_top
            (Opposite.op (CategoryTheory.homOfLE (le_top : U ≤ ⊤)))
        have hgerm : Z.left.presheaf.map (Opposite.op (CategoryTheory.homOfLE (le_top : U ≤ ⊤))) ≫
            Z.left.germToFunctionField U = Z.left.germToFunctionField ⊤ :=
          TopCat.Presheaf.germ_res Z.left.presheaf (CategoryTheory.homOfLE (le_top : U ≤ ⊤)) _ _
        have hcomp : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ U le_top) ≫
            Z.left.germToFunctionField U =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE Z.hom ⊤ ⊤ le_top ≫
              Z.left.germToFunctionField ⊤ := by
          rw [← hmap, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hgerm]
        exact (congrArg (fun ψ => ψ.hom c) hcomp).symm
      obtain ⟨s, hs_tr, hs_dim⟩ := hDomDim k R_U ↑Z.left.functionField
      refine ⟨s, hs_tr, ?_⟩
      have hhomeo : topologicalKrullDim ↥U = topologicalKrullDim (PrimeSpectrum R_U) :=
        (AlgebraicGeometry.Scheme.homeoOfIso hAffU.isoSpec).isHomeomorph.topologicalKrullDim_eq
      rw [hhomeo, PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, hs_dim]
    obtain ⟨s₀, hs₀_tr, hs₀_O⟩ := h_aff_dim O hAffO hNeO
    rw [hs₀_O]
    apply le_antisymm
    · refine iSup_le fun p => ?_
      obtain ⟨x₀, hx₀_p0⟩ := (p 0).isIrreducible.nonempty
      obtain ⟨U, hAffU, hx₀_U, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show x₀ ∈ (⊤ : Z.left.Opens) from trivial)
      obtain ⟨s_U, hsU_tr, hsU_dim⟩ := h_aff_dim U hAffU ⟨⟨x₀, hx₀_U⟩⟩
      have hs_eq : s_U = s₀ := Nat.cast_injective (hsU_tr.trans hs₀_tr.symm)
      rw [hs_eq] at hsU_dim
      let restrict_ic : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥U := fun i =>
        { carrier := (Subtype.val : ↥U → ↥Z.left) ⁻¹' (p i : Set ↥Z.left)
          isIrreducible' :=
            ⟨⟨⟨x₀, hx₀_U⟩, p.monotone (Fin.zero_le i) hx₀_p0⟩,
              h_open_preirred (p i).isIrreducible.isPreirreducible U.isOpen⟩
          isClosed' := (p i).isClosed.preimage continuous_subtype_val }
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥U) :=
        { length := p.length
          toFun := restrict_ic
          step := fun i => by
            have hst : p i.castSucc < p i.succ := p.step i
            have hle : restrict_ic i.castSucc ≤ restrict_ic i.succ := fun y hy =>
              le_of_lt hst hy
            apply lt_of_le_of_ne hle
            intro heq
            have hsub : (p i.succ : Set ↥Z.left) ⊆ (p i.castSucc : Set ↥Z.left) ∪ (U : Set ↥Z.left)ᶜ := by
              intro z hz
              by_cases hzU : z ∈ U
              · have hz' : (⟨z, hzU⟩ : ↥U) ∈ restrict_ic i.succ := hz
                rw [← heq] at hz'
                exact Or.inl hz'
              · exact Or.inr hzU
            have hpre := isPreirreducible_iff_isClosed_union_isClosed.mp
              (p i.succ).isIrreducible.isPreirreducible _ _
              (p i.castSucc).isClosed U.isOpen.isClosed_compl hsub
            rcases hpre with h1 | h2
            · exact not_le_of_gt hst h1
            · exact h2 (p.monotone (Fin.zero_le i.succ) hx₀_p0) hx₀_U }
      rw [← hsU_dim]
      exact Order.LTSeries.length_le_krullDim q
    · rw [← hs₀_O]
      exact topologicalKrullDim_subspace_le Z.left (O : Set ↥Z.left)

  
  have h_compl_dim_le : ∀ (X : AlgebraicGeometry.Scheme.{u}) [IrreducibleSpace ↥X]
      (k₀ : ℕ), topologicalKrullDim X = ((k₀ + 1 : ℕ) : WithBot ℕ∞) →
      ∀ (V : X.Opens), Nonempty ↥V →
      topologicalKrullDim (weilAltClosedComplIdeal X V).subscheme ≤ (k₀ : WithBot ℕ∞) := by
    intro X _ k₀ hDimX V ⟨v₀, hv₀⟩
    let I_Z := weilAltClosedComplIdeal X V
    let i_Z := I_Z.subschemeι
    have hcl : Topology.IsClosedEmbedding i_Z.base := i_Z.isClosedEmbedding
    have hrange : Set.range i_Z.base = (V : Set ↥X)ᶜ :=
      (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_Z).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal _)
    refine iSup_le fun p => ?_
    let map_ic : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥X := fun t =>
      { carrier := i_Z.base '' (p t : Set ↥I_Z.subscheme)
        isIrreducible' := (p t).isIrreducible.image _ i_Z.continuous.continuousOn
        isClosed' := hcl.isClosedMap _ (p t).isClosed }
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥X) :=
      { length := p.length
        toFun := map_ic
        step := fun t => by
          have hst : p t.castSucc < p t.succ := p.step t
          apply lt_of_le_of_ne (Set.image_mono (le_of_lt hst))
          intro heq
          have h_eq_set : (p t.castSucc : Set _) = (p t.succ : Set _) :=
            hcl.injective.image_injective heq
          exact ne_of_lt hst (SetLike.ext' h_eq_set) }
    let top_X : TopologicalSpace.IrreducibleCloseds ↥X :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥X, isClosed_univ⟩
    have h_lt_top : q.last < top_X := by
      apply lt_of_le_of_ne (fun _ _ => trivial)
      intro heq
      have hv_mem : v₀ ∈ (q.last : Set ↥X) := by
        have h1 : (q.last : Set ↥X) = Set.univ :=
          congrArg (fun S : TopologicalSpace.IrreducibleCloseds ↥X => (S : Set ↥X)) heq
        rw [h1]; trivial
      have hv_sub : (q.last : Set ↥X) ⊆ (V : Set ↥X)ᶜ := by
        rw [← hrange]
        exact Set.image_subset_range _ _
      exact hv_sub hv_mem hv₀
    have hlen := Order.LTSeries.length_le_krullDim (q.snoc top_X h_lt_top)
    rw [RelSeries.snoc_length] at hlen
    change ((p.length + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim X at hlen
    rw [hDimX] at hlen
    have hk : p.length + 1 ≤ k₀ + 1 := Nat.cast_le.mp (WithBot.coe_le_coe.mp hlen)
    exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr (by omega))

  
  let A_W : Type u := ↑(Y.left.presheaf.obj (Opposite.op W))
  let kAlgW : Algebra k A_W :=
    RingHom.toAlgebra (CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
  have hDom_AW : IsDomain A_W := by
    obtain ⟨x₀, hx₀⟩ := hNe
    have : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨x₀, hx₀⟩⟩
    exact @AlgebraicGeometry.IsIntegral.component_integral Y.left hIntY W inferInstance
  let ψ₁ : R₀ →+* A_W := weilTopDegKummerChartEvalHom k d Y W w₁
  let ψ₂ : R₀ →+* A_W := weilTopDegKummerChartEvalHom k d Y W w₂
  have hψ₁_inj : Function.Injective ψ₁ := by
    let _ : Algebra k A_W := kAlgW
    exact (algebraicIndependent_iff_injective_aeval (R := k) (x := w₁)).mp _hw₁.1
  have hψ₂_inj : Function.Injective ψ₂ := by
    let _ : Algebra k A_W := kAlgW
    exact (algebraicIndependent_iff_injective_aeval (R := k) (x := w₂)).mp _hw₂.1
  have hψ_head : ∀ b : R_base, ψ₁ (π_head b) = ψ₂ (π_head b) := by
    let _ : Algebra k A_W := kAlgW
    let f₁ : R_base →ₐ[k] A_W := (MvPolynomial.aeval w₁).comp π_head
    let f₂ : R_base →ₐ[k] A_W := (MvPolynomial.aeval w₂).comp π_head
    suffices hf : f₁ = f₂ from fun b => AlgHom.congr_fun hf b
    apply MvPolynomial.algHom_ext
    intro i
    change (MvPolynomial.aeval w₁) (π_head (MvPolynomial.X i)) =
      (MvPolynomial.aeval w₂) (π_head (MvPolynomial.X i))
    dsimp [π_head]
    rw [MvPolynomial.rename_X, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
    apply _hAgree
    intro heq
    exact Fin.castSucc_ne_last i ((Fin.cast_injective hmd) heq)

  have : AlgebraicGeometry.IsProper π₁ := by
    have : AlgebraicGeometry.IsProper (π₁ ≫ P_m.hom) := by rw [hπ₁_ov]; infer_instance
    exact AlgebraicGeometry.IsProper.of_comp π₁ P_m.hom
  let P_12 := CategoryTheory.Limits.pullback π₁ π₁
  let pr₁ : P_12 ⟶ P_d.left := CategoryTheory.Limits.pullback.fst π₁ π₁
  let pr₂ : P_12 ⟶ P_d.left := CategoryTheory.Limits.pullback.snd π₁ π₁
  let p_12 : P_12 ⟶ S_k := pr₁ ≫ P_d.hom
  let P_amb := CategoryTheory.Limits.pullback Y.hom p_12
  let fst_amb : P_amb ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom p_12
  let snd_amb : P_amb ⟶ P_12 := CategoryTheory.Limits.pullback.snd Y.hom p_12
  let p_amb : P_amb ⟶ S_k := fst_amb ≫ Y.hom
  let X_W := AlgebraicGeometry.Spec (Y.left.presheaf.obj (Opposite.op W))
  have : IsDomain ↑(Y.left.presheaf.obj (Opposite.op W)) := hDom_AW
  have hInt_XW : AlgebraicGeometry.IsIntegral X_W := by
    dsimp [X_W]; infer_instance
  let u₁ : X_W ⟶ P_d.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ ι_d'
  let u₂ : X_W ⟶ P_d.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫ ι_d'
  have hu12_π₁ : u₁ ≫ π₁ = u₂ ≫ π₁ := by
    dsimp [u₁, u₂]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hι_d'_π₁,
      ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    exact CommRingCat.hom_ext (RingHom.ext hψ_head)
  let u_12 : X_W ⟶ P_12 := CategoryTheory.Limits.pullback.lift u₁ u₂ hu12_π₁
  have hW_u12 : hW.fromSpec ≫ Y.hom = u_12 ≫ p_12 := by
    dsimp [u_12, p_12, pr₁]
    rw [CategoryTheory.Limits.pullback.lift_fst_assoc]
    dsimp [u₁]
    rw [CategoryTheory.Category.assoc, hι_d'_ov,
      ← AlgebraicGeometry.Spec.map_comp, h_spec_over Y W hW]
    congr 1
    apply CommRingCat.hom_ext
    ext c
    let _ : Algebra k A_W := kAlgW
    change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top).hom c =
      (MvPolynomial.aeval w₁) (MvPolynomial.C c)
    exact (MvPolynomial.aeval_C w₁ c).symm
  let f_gr : X_W ⟶ P_amb := CategoryTheory.Limits.pullback.lift hW.fromSpec u_12 hW_u12
  have : AlgebraicGeometry.IsImmersion f_gr := by
    let Q_amb := CategoryTheory.Limits.pullback hW.fromSpec fst_amb
    let q₁ : Q_amb ⟶ X_W := CategoryTheory.Limits.pullback.fst hW.fromSpec fst_amb
    let q₂ : Q_amb ⟶ P_amb := CategoryTheory.Limits.pullback.snd hW.fromSpec fst_amb
    let s_gr : X_W ⟶ Q_amb := CategoryTheory.Limits.pullback.lift (𝟙 X_W) f_gr
      ((CategoryTheory.Category.id_comp _).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
    have hs_id : s_gr ≫ q₁ = 𝟙 X_W := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have : AlgebraicGeometry.IsClosedImmersion (s_gr ≫ q₁) := by rw [hs_id]; infer_instance
    have : AlgebraicGeometry.IsClosedImmersion s_gr :=
      AlgebraicGeometry.IsClosedImmersion.of_comp s_gr q₁
    have hfac : s_gr ≫ q₂ = f_gr := CategoryTheory.Limits.pullback.lift_snd _ _ _
    rw [← hfac]
    infer_instance
  have : AlgebraicGeometry.QuasiCompact f_gr := by
    have hf_ov : f_gr ≫ p_amb = hW.fromSpec ≫ Y.hom := by
      dsimp [f_gr, p_amb, fst_amb]
      rw [CategoryTheory.Limits.pullback.lift_fst_assoc]
    have : AlgebraicGeometry.QuasiCompact (f_gr ≫ p_amb) := by
      rw [hf_ov]
      infer_instance
    exact AlgebraicGeometry.QuasiCompact.of_comp f_gr p_amb

  let Γ : CategoryTheory.Over S_k := CategoryTheory.Over.mk (f_gr.imageι ≫ p_amb)
  let j_W : X_W ⟶ Γ.left := f_gr.toImage
  have hProp_Γ : AlgebraicGeometry.IsProper Γ.hom := by
    change AlgebraicGeometry.IsProper (f_gr.imageι ≫ p_amb)
    infer_instance
  let _ : AlgebraicGeometry.IsProper Γ.hom := hProp_Γ
  have hj_W_open : AlgebraicGeometry.IsOpenImmersion j_W := inferInstance
  have hIrred_Γ : IrreducibleSpace ↥Γ.left := by
    have h_dense : DenseRange j_W.base := AlgebraicGeometry.IsDominant.denseRange (f := j_W)
    have h_irred_XW : IsIrreducible (Set.univ : Set ↥X_W) :=
      @IrreducibleSpace.isIrreducible_univ ↥X_W _
        (@AlgebraicGeometry.irreducibleSpace_of_isIntegral X_W hInt_XW)
    have h_range : IsIrreducible (Set.range j_W.base) := by
      rw [← Set.image_univ]
      exact h_irred_XW.image _ j_W.continuous.continuousOn
    have h_univ : IsIrreducible (Set.univ : Set ↥Γ.left) := by
      rw [← h_dense.closure_range]
      exact h_range.closure
    obtain ⟨x₀_Γ, _⟩ := h_univ.nonempty
    exact { isPreirreducible_univ := h_univ.isPreirreducible, toNonempty := ⟨x₀_Γ⟩ }
  have hRed_Γ : AlgebraicGeometry.IsReduced Γ.left := by
    have h_stalk : ∀ x : ↥Γ.left, _root_.IsReduced ↑(Γ.left.presheaf.stalk x) := by
      intro x
      obtain ⟨U, hAffU, hxU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (show f_gr.imageι.base x ∈ (⊤ : P_amb.Opens) from trivial)
      let V : Γ.left.Opens := (TopologicalSpace.Opens.map f_gr.imageι.base).obj U
      have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffU.preimage f_gr.imageι
      let e_obj := f_gr.ker.subschemeObjIso ⟨U, hAffU⟩
      have hRed_XW : AlgebraicGeometry.IsReduced X_W :=
        @AlgebraicGeometry.isReduced_of_isIntegral X_W hInt_XW
      have hRed_QU : _root_.IsReduced (↑(P_amb.presheaf.obj (Opposite.op U)) ⧸ f_gr.ker.ideal ⟨U, hAffU⟩) := by
        refine _root_.IsReduced.mk fun z hz => ?_
        rcases hz with ⟨n, hn⟩
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, f_gr.ker_apply ⟨U, hAffU⟩,
          RingHom.mem_ker, map_pow] at hn
        have ha0 : (f_gr.app U).hom a = 0 := isNilpotent_iff_eq_zero.mp ⟨n, hn⟩
        rw [Ideal.Quotient.eq_zero_iff_mem, f_gr.ker_apply ⟨U, hAffU⟩, RingHom.mem_ker]
        exact ha0
      have hRed_RV : _root_.IsReduced ↑(Γ.left.presheaf.obj (Opposite.op V)) := by
        let _ := hRed_QU
        refine _root_.IsReduced.mk fun z hz => ?_
        rcases hz with ⟨n, hn⟩
        apply e_obj.commRingCatIsoToRingEquiv.injective
        rw [map_zero]
        exact isNilpotent_iff_eq_zero.mp ⟨n, by rw [← map_pow, hn, map_zero]⟩
      have hxV : x ∈ V := hxU
      let alg_stalk : Algebra ↑(Γ.left.presheaf.obj (Opposite.op V)) ↑(Γ.left.presheaf.stalk x) :=
        TopCat.Presheaf.algebra_section_stalk Γ.left.presheaf ⟨x, hxV⟩
      let _ : Algebra ↑(Γ.left.presheaf.obj (Opposite.op V)) ↑(Γ.left.presheaf.stalk x) := alg_stalk
      have hLoc : IsLocalization.AtPrime ↑(Γ.left.presheaf.stalk x)
          (hAffV.primeIdealOf ⟨x, hxV⟩).asIdeal := hAffV.isLocalization_stalk ⟨x, hxV⟩
      refine _root_.IsReduced.mk fun s hs => ?_
      rcases hs with ⟨n, hn⟩
      obtain ⟨⟨r, m_sub⟩, hsm⟩ := IsLocalization.surj (hAffV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl s
      have hrn : algebraMap ↑(Γ.left.presheaf.obj (Opposite.op V)) ↑(Γ.left.presheaf.stalk x) (r ^ n) = 0 := by
        rw [map_pow, ← hsm, mul_pow, hn, zero_mul]
      rw [IsLocalization.map_eq_zero_iff (hAffV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl] at hrn
      obtain ⟨c, hcr⟩ := hrn
      have hcr_pow : (c.1 * r) ^ n = 0 := by
        cases n with
        | zero =>
          have hc0 : c.1 = 0 := by simpa only [pow_zero, mul_one] using hcr
          exact False.elim (c.2 (hc0 ▸ (hAffV.primeIdealOf ⟨x, hxV⟩).asIdeal.zero_mem))
        | succ k_idx =>
          rw [mul_pow, pow_succ c.1 k_idx, mul_assoc (c.1 ^ k_idx) c.1 (r ^ (k_idx + 1)), hcr, mul_zero]
      let _ := hRed_RV
      have hcr0 : c.1 * r = 0 := isNilpotent_iff_eq_zero.mp ⟨n, hcr_pow⟩
      have h_unit_m : IsUnit (algebraMap _ ↑(Γ.left.presheaf.stalk x) m_sub.1) :=
        IsLocalization.map_units _ m_sub
      have h_unit_c : IsUnit (algebraMap _ ↑(Γ.left.presheaf.stalk x) c.1) :=
        IsLocalization.map_units _ c
      apply h_unit_m.mul_right_cancel
      rw [zero_mul, hsm]
      apply h_unit_c.mul_left_cancel
      rw [mul_zero, ← map_mul, hcr0, map_zero]
    exact @AlgebraicGeometry.isReduced_of_isReduced_stalk Γ.left h_stalk
  have hInt_Γ : AlgebraicGeometry.IsIntegral Γ.left :=
    @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Γ.left hRed_Γ hIrred_Γ

  let π_Y : Γ.left ⟶ Y.left := f_gr.imageι ≫ fst_amb
  let g_map_1 : Γ.left ⟶ P_d.left := f_gr.imageι ≫ (snd_amb ≫ pr₁)
  let g_map_2 : Γ.left ⟶ P_d.left := f_gr.imageι ≫ (snd_amb ≫ pr₂)
  let h_Wf : Γ.left ⟶ P_m.left := g_map_1 ≫ π₁
  have hπ_Y_ov : π_Y ≫ Y.hom = Γ.hom := CategoryTheory.Category.assoc _ _ _
  have hg₁_ov : g_map_1 ≫ P_d.hom = Γ.hom := by
    dsimp [g_map_1, Γ, p_amb, p_12]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Limits.pullback.condition]
  have hg₁_π₁ : g_map_1 ≫ π₁ = h_Wf := rfl
  have hg₂_π₁ : g_map_2 ≫ π₁ = h_Wf := by
    dsimp [g_map_2, g_map_1, h_Wf, pr₁, pr₂]
    simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
  have hh_Wf_ov : h_Wf ≫ P_m.hom = Γ.hom := by
    dsimp [h_Wf]
    rw [CategoryTheory.Category.assoc, hπ₁_ov, hg₁_ov]
  have hg₂_ov : g_map_2 ≫ P_d.hom = Γ.hom := by
    rw [← hπ₁_ov, ← CategoryTheory.Category.assoc, hg₂_π₁, hh_Wf_ov]
  have hj_W_πY : j_W ≫ π_Y = hW.fromSpec := by
    dsimp [j_W, π_Y, f_gr, fst_amb]
    rw [← CategoryTheory.Category.assoc, f_gr.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_fst]
  have hj_W_g₁ : j_W ≫ g_map_1 = u₁ := by
    dsimp [j_W, g_map_1, f_gr, snd_amb, u_12, pr₁]
    rw [← CategoryTheory.Category.assoc, f_gr.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_snd_assoc,
      CategoryTheory.Limits.pullback.lift_fst]
  have hj_W_g₂ : j_W ≫ g_map_2 = u₂ := by
    dsimp [j_W, g_map_2, f_gr, snd_amb, u_12, pr₂]
    rw [← CategoryTheory.Category.assoc, f_gr.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_snd_assoc,
      CategoryTheory.Limits.pullback.lift_snd]

  have hDim_Γ : topologicalKrullDim Γ.left = (d : WithBot ℕ∞) := by
    let U_Γ : Γ.left.Opens := j_W.opensRange
    have hAff_UΓ : AlgebraicGeometry.IsAffineOpen U_Γ :=
      AlgebraicGeometry.isAffineOpen_opensRange j_W
    have h2 := h_open_dim_eq Y hIntY W hW hNe
    obtain ⟨w₀, hw₀⟩ := hNe
    have hNe_XW : Nonempty ↥X_W :=
      ⟨(AlgebraicGeometry.Scheme.homeoOfIso hW.isoSpec) ⟨w₀, hw₀⟩⟩
    obtain ⟨pt_XW⟩ := hNe_XW
    have hNe_UΓ : Nonempty ↥U_Γ := ⟨⟨j_W.base pt_XW, ⟨pt_XW, rfl⟩⟩⟩
    have h1 := h_open_dim_eq Γ hInt_Γ U_Γ hAff_UΓ hNe_UΓ
    have h_iso_UW : U_Γ.toScheme ≅ W.toScheme := j_W.isoOpensRange.symm ≪≫ hW.isoSpec.symm
    have h3 : topologicalKrullDim ↥U_Γ = topologicalKrullDim ↥W :=
      (AlgebraicGeometry.Scheme.homeoOfIso h_iso_UW).isHomeomorph.topologicalKrullDim_eq
    rw [h1, h3, ← h2, hDimY]

  
  have h_chart_cancel : ∀ (g : R₀), g ≠ 0 →
      ∀ (ψ : R₀ →+* A_W) (g_map : Γ.left ⟶ P_d.left),
        Function.Injective ψ →
        g_map ≫ P_d.hom = Γ.hom →
        j_W ≫ g_map = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι_d' →
        (Localization.awayMap ψ g).Finite →
        let j_Ug := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) ≫ ι_d'
        let U_g : P_d.left.Opens := j_Ug.opensRange
        let j_Γ := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A_W (Localization.Away (ψ g)))) ≫ j_W
        Set.range j_Γ.base = g_map.base ⁻¹' (U_g : Set ↥P_d.left) ∧
        Nonempty ↥((TopologicalSpace.Opens.map g_map.base).obj U_g) := by
    intro g hg ψ g_map hψ_inj hg_ov hjW_g hFin_g j_Ug U_g j_Γ
    have hj_Ug_open : AlgebraicGeometry.IsOpenImmersion j_Ug := inferInstance
    have hj_Γ_open : AlgebraicGeometry.IsOpenImmersion j_Γ := inferInstance
    have hj_Γ_g : j_Γ ≫ g_map =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ g)) ≫ j_Ug := by
      dsimp [j_Γ, j_Ug]
      rw [CategoryTheory.Category.assoc, hjW_g, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      change algebraMap A_W (Localization.Away (ψ g)) (ψ r) =
        Localization.awayMap ψ g (algebraMap R₀ (Localization.Away g) r)
      exact (IsLocalization.map_eq _ r).symm
    let V_Γ : Γ.left.Opens := (TopologicalSpace.Opens.map g_map.base).obj U_g
    have h_sub_VΓ : Set.range j_Γ.base ⊆ Set.range V_Γ.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      change (j_Γ ≫ g_map).base x ∈ (U_g : Set ↥P_d.left)
      rw [hj_Γ_g]
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ g))).base x, rfl⟩
    let j'_Γ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ g))) ⟶ V_Γ.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V_Γ.ι j_Γ h_sub_VΓ
    have hj'_fac : j'_Γ ≫ V_Γ.ι = j_Γ := AlgebraicGeometry.IsOpenImmersion.lift_fac V_Γ.ι j_Γ h_sub_VΓ
    have : AlgebraicGeometry.IsOpenImmersion (j'_Γ ≫ V_Γ.ι) := by rw [hj'_fac]; exact hj_Γ_open
    have hj'_open : AlgebraicGeometry.IsOpenImmersion j'_Γ :=
      AlgebraicGeometry.IsOpenImmersion.of_comp j'_Γ V_Γ.ι
    have h_sub_Ug : Set.range (V_Γ.ι ≫ g_map).base ⊆ Set.range j_Ug.base := by
      rintro _ ⟨y, rfl⟩
      exact y.2
    let g' : V_Γ.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_Ug (V_Γ.ι ≫ g_map) h_sub_Ug
    have hg'_fac : g' ≫ j_Ug = V_Γ.ι ≫ g_map :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_Ug (V_Γ.ι ≫ g_map) h_sub_Ug
    have hj'_g' : j'_Γ ≫ g' =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ g)) := by
      rw [← cancel_mono j_Ug, CategoryTheory.Category.assoc, hg'_fac,
        ← CategoryTheory.Category.assoc, hj'_fac, hj_Γ_g]
    have : AlgebraicGeometry.IsFinite (j'_Γ ≫ g') := by
      rw [hj'_g']
      exact (AlgebraicGeometry.IsFinite.SpecMap_iff _).mpr hFin_g
    have : AlgebraicGeometry.IsProper (j'_Γ ≫ g') := inferInstance
    let p_Bg : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶ S_k :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap R₀ (Localization.Away g)).comp MvPolynomial.C))
    have hg'_ov : g' ≫ p_Bg = V_Γ.ι ≫ Γ.hom := by
      have hj_Ug_ov : j_Ug ≫ P_d.hom = p_Bg := by
        dsimp [j_Ug, p_Bg]
        rw [CategoryTheory.Category.assoc, hι_d'_ov, ← AlgebraicGeometry.Spec.map_comp]
      rw [← hj_Ug_ov, ← CategoryTheory.Category.assoc, hg'_fac,
        CategoryTheory.Category.assoc, hg_ov]
    have : AlgebraicGeometry.IsSeparated (g' ≫ p_Bg) := by
      rw [hg'_ov]
      infer_instance
    have : AlgebraicGeometry.IsSeparated g' := AlgebraicGeometry.IsSeparated.of_comp g' p_Bg
    have : AlgebraicGeometry.IsProper j'_Γ := AlgebraicGeometry.IsProper.of_comp j'_Γ g'
    have hψg_ne : ψ g ≠ 0 := fun h0 => hg (hψ_inj (h0.trans (map_zero ψ).symm))
    have : Nontrivial (Localization.Away (ψ g)) := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      rw [← map_one (algebraMap A_W (Localization.Away (ψ g)))] at h01
      have h10 : algebraMap A_W (Localization.Away (ψ g)) 1 = 0 := h01.symm
      rw [IsLocalization.map_eq_zero_iff (Submonoid.powers (ψ g))] at h10
      rcases h10 with ⟨⟨_, k_p, rfl⟩, hk0⟩
      rw [mul_one] at hk0
      exact pow_ne_zero k_p hψg_ne hk0
    obtain ⟨pt_Ag⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ g)))) :=
      inferInstance
    have hNe_VΓ : Nonempty ↥V_Γ := ⟨j'_Γ.base pt_Ag⟩
    have hPre_VΓ : IsPreirreducible (Set.univ : Set ↥V_Γ) := by
      have heq_univ : (Set.univ : Set ↥V_Γ) =
          (Subtype.val : ↥(V_Γ : Set ↥Γ.left) → ↥Γ.left) ⁻¹' (Set.univ : Set ↥Γ.left) := rfl
      rw [heq_univ]
      exact h_open_preirred (@IrreducibleSpace.isIrreducible_univ ↥Γ.left _ hIrred_Γ).isPreirreducible
        V_Γ.isOpen
    have hCl_range : IsClosed (Set.range j'_Γ.base) := j'_Γ.isClosedMap.isClosed_range
    have hOp_range : IsOpen (Set.range j'_Γ.base) := hj'_open.base_open.isOpen_range
    have h_univ_sub : (Set.univ : Set ↥V_Γ) ⊆ Set.range j'_Γ.base ∪ (Set.range j'_Γ.base)ᶜ :=
      fun x _ => Classical.em _
    have h_range_univ : Set.range j'_Γ.base = Set.univ := by
      rcases isPreirreducible_iff_isClosed_union_isClosed.mp hPre_VΓ _ _
          hCl_range hOp_range.isClosed_compl h_univ_sub with h1 | h2
      · exact Set.Subset.antisymm (fun _ _ => trivial) h1
      · exact False.elim (h2 trivial ⟨pt_Ag, rfl⟩)
    refine ⟨?_, hNe_VΓ⟩
    rw [← hj'_fac]
    ext y
    simp only [AlgebraicGeometry.Scheme.Hom.comp_apply, Set.mem_range]
    constructor
    · rintro ⟨x, rfl⟩
      exact (j'_Γ.base x).2
    · intro hy
      have hy' : (⟨y, hy⟩ : ↥V_Γ) ∈ Set.range j'_Γ.base := by rw [h_range_univ]; trivial
      rcases hy' with ⟨x, hx⟩
      exact ⟨x, congrArg Subtype.val hx⟩

  
  have hFin_10 : (Localization.awayMap ψ₁ g₁₀).Finite := by
    obtain ⟨_, _, _, _, _, _, hF, _⟩ := hBasis ψ₁ 1 g₁₀ m₁ M₁₀ _b₁₀ e₁₀ _he₁₀
