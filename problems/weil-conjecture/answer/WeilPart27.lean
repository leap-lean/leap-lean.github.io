        obtain ⟨W, hAff_W, hx_W, _, M_W, hAdd_W, hMod_W, b_W, e_W, he_W⟩ :=
          hChart_etale φ_tilde hφt_free U ⊤ x trivial
        exact ⟨W, hAff_W, hx_W, M_W, hAdd_W, hMod_W, b_W, e_W, he_W⟩

      choose chart_W hchart_aff hchart_mem chart_M hchart_add hchart_mod chart_b chart_e hchart_e
        using h_chart_all
      let chart_et : ∀ (U : Γ_V.left.Etale) (x : ↥(Fgt_V.obj U).left), Γ_V.left.Etale :=
        fun U x => CategoryTheory.MorphismProperty.Over.mk ⊤
          ((chart_W U x).ι ≫ (Fgt_V.obj U).hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (chart_W U x).ι (Fgt_V.obj U).hom inferInstance U.prop)
      let chart_j : ∀ (U : Γ_V.left.Etale) (x : ↥(Fgt_V.obj U).left),
          Quiver.Hom (chart_et U x) U :=
        fun U x => CategoryTheory.MorphismProperty.Over.homMk (chart_W U x).ι rfl

      have h_sec_ex : ∀ (U : Γ_V.left.Etale)
          (s : LocallyConstant ↥(Fgt_t.obj (B_φt.obj U)).left (ULift.{u} (ZMod n)))
          (x : ↥(Fgt_V.obj U).left),
          ∃ t_x : LocallyConstant ↥(Fgt_V.obj (chart_et U x)).left (ULift.{u} (ZMod n)),
            letI : AddCommGroup (chart_M U x) := hchart_add U x
            letI : Module ↑(((Fgt_V.obj (chart_et U x)).left).presheaf.obj (Opposite.op ⊤))
              (chart_M U x) := hchart_mod U x
            ∀ (L_x : chart_M U x →ₗ[↑(((Fgt_V.obj (chart_et U x)).left).presheaf.obj
                (Opposite.op ⊤))] chart_M U x),
              (∀ m : chart_M U x, chart_e U x (L_x m) =
                D.ι_ζ Γ_tilde (B_φt.obj (chart_et U x))
                  (((weilAltLocConstPresheaf Γ_tilde.left n).map
                    (Opposite.op (B_φt.map (chart_j U x)))) s) *
                  chart_e U x m) →
              D.ι_ζ Γ_V (chart_et U x) t_x =
                ((LinearMap.toMatrix (chart_b U x) (chart_b U x)) L_x).det :=
        fun U s x =>
          h_local_sec (chart_et U x) (chart_M U x) (hchart_add U x) (hchart_mod U x)
            (chart_b U x) (chart_e U x) (hchart_e U x)
            (((weilAltLocConstPresheaf Γ_tilde.left n).map
              (Opposite.op (B_φt.map (chart_j U x)))) s)

      choose chart_sec hchart_sec using h_sec_ex
      let f_val : ∀ (U : Γ_V.left.Etale),
          LocallyConstant ↥(Fgt_t.obj (B_φt.obj U)).left (ULift.{u} (ZMod n)) →
          ↥(Fgt_V.obj U).left → ULift.{u} (ZMod n) :=
        fun U s x => chart_sec U s x ⟨x, hchart_mem U x⟩

      have h_agree : ∀ (U V : Γ_V.left.Etale)
          (_ : AlgebraicGeometry.IsAffine (Fgt_V.obj V).left)
          (u : Quiver.Hom V U)
          (M_V : Type u) [AddCommGroup M_V]
          [Module ↑(((Fgt_V.obj V).left).presheaf.obj (Opposite.op ⊤)) M_V]
          (b_V : Module.Basis (Fin δ)
            ↑(((Fgt_V.obj V).left).presheaf.obj (Opposite.op ⊤)) M_V)
          (e_V : M_V ≃+
            ↑(((Fgt_t.obj (B_φt.obj V)).left).presheaf.obj (Opposite.op ⊤))),
          (∀ (r₀ : ↑(((Fgt_V.obj V).left).presheaf.obj (Opposite.op ⊤))) (m : M_V),
            e_V (r₀ • m) =
              @Mul.mul ↑(((Fgt_t.obj (B_φt.obj V)).left).presheaf.obj (Opposite.op ⊤)) _
                (CommRingCat.Hom.hom
                  (CategoryTheory.Limits.pullback.fst (Fgt_V.obj V).hom φ_tilde).appTop r₀)
                (e_V m)) →
          ∀ (s : LocallyConstant ↥(Fgt_t.obj (B_φt.obj U)).left (ULift.{u} (ZMod n)))
            (L_V : M_V →ₗ[↑(((Fgt_V.obj V).left).presheaf.obj (Opposite.op ⊤))] M_V),
            (∀ m : M_V, e_V (L_V m) =
              D.ι_ζ Γ_tilde (B_φt.obj V)
                (((weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (B_φt.map u))) s) *
                e_V m) →
            ∀ (t_V : LocallyConstant ↥(Fgt_V.obj V).left (ULift.{u} (ZMod n))),
              D.ι_ζ Γ_V V t_V = ((LinearMap.toMatrix b_V b_V) L_V).det →
              ∀ y : ↥(Fgt_V.obj V).left,
                f_val U s ((Fgt_V.map u).left.base y) = t_V y := by
        intro U V hAff_V u M_V _ _ b_V e_V he_V s L_V hL_V t_V ht_V y
        let x : ↥(Fgt_V.obj U).left := (Fgt_V.map u).left.base y
        have hy_pre : y ∈ (TopologicalSpace.Opens.map (Fgt_V.map u).left.base).obj (chart_W U x) :=
          hchart_mem U x
        obtain ⟨W', hAff_W', hy_W', hW'_le⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_pre
        let hEt_W' : AlgebraicGeometry.Etale (W'.ι ≫ (Fgt_V.obj V).hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            W'.ι (Fgt_V.obj V).hom inferInstance V.prop
        let W'_et : Γ_V.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (W'.ι ≫ (Fgt_V.obj V).hom) hEt_W'
        let i_V : Quiver.Hom W'_et V :=
          CategoryTheory.MorphismProperty.Over.homMk W'.ι rfl
        let res_u : W'.toScheme ⟶ (chart_W U x).toScheme :=
          (Fgt_V.map u).left.resLE (chart_W U x) W' hW'_le
        have hres_u_ι : res_u ≫ (chart_W U x).ι = W'.ι ≫ (Fgt_V.map u).left :=
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι (Fgt_V.map u).left hW'_le
        have hi_W_w : res_u ≫ (Fgt_V.obj (chart_et U x)).hom = (Fgt_V.obj W'_et).hom := by
          have hu_w : (Fgt_V.map u).left ≫ (Fgt_V.obj U).hom = (Fgt_V.obj V).hom :=
            CategoryTheory.MorphismProperty.Over.w u
          change res_u ≫ ((chart_W U x).ι ≫ (Fgt_V.obj U).hom) = W'.ι ≫ (Fgt_V.obj V).hom
          rw [← Category.assoc, hres_u_ι, Category.assoc, hu_w]
        let i_W : Quiver.Hom W'_et (chart_et U x) :=
          CategoryTheory.MorphismProperty.Over.homMk res_u hi_W_w
        have hi_comm : CategoryTheory.CategoryStruct.comp i_V u =
            CategoryTheory.CategoryStruct.comp i_W (chart_j U x) :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext hres_u_ι.symm (Subsingleton.elim _ _)
        letI : AddCommGroup (chart_M U x) := hchart_add U x
        letI : Module ↑(((Fgt_V.obj (chart_et U x)).left).presheaf.obj (Opposite.op ⊤))
          (chart_M U x) := hchart_mod U x
        let s_x : LocallyConstant ↥(Fgt_t.obj (B_φt.obj (chart_et U x))).left
            (ULift.{u} (ZMod n)) :=
          ((weilAltLocConstPresheaf Γ_tilde.left n).map
            (Opposite.op (B_φt.map (chart_j U x)))) s
        let fst_x_φt : (Fgt_t.obj (B_φt.obj (chart_et U x))).left ⟶
            (Fgt_V.obj (chart_et U x)).left :=
          CategoryTheory.Limits.pullback.fst (Fgt_V.obj (chart_et U x)).hom φ_tilde
        let ρ_x : ↑(((Fgt_V.obj (chart_et U x)).left).presheaf.obj (Opposite.op ⊤)) →+*
            ↑(((Fgt_t.obj (B_φt.obj (chart_et U x))).left).presheaf.obj (Opposite.op ⊤)) :=
          CommRingCat.Hom.hom fst_x_φt.appTop
        obtain ⟨L_x, hL_x⟩ := hA_ex ρ_x (chart_M U x) (chart_e U x) (hchart_e U x)
          (D.ι_ζ Γ_tilde (B_φt.obj (chart_et U x)) s_x)
        have ht_x : D.ι_ζ Γ_V (chart_et U x) (chart_sec U s x) =
            ((LinearMap.toMatrix (chart_b U x) (chart_b U x)) L_x).det :=
          hchart_sec U s x L_x hL_x
        let R_V : Type u := ↑(((Fgt_V.obj V).left).presheaf.obj (Opposite.op ⊤))
        let R_W' : Type u := ↑(((Fgt_V.obj W'_et).left).presheaf.obj (Opposite.op ⊤))
        let S_V : Type u := ↑(((Fgt_t.obj (B_φt.obj V)).left).presheaf.obj (Opposite.op ⊤))
        let S_W' : Type u := ↑(((Fgt_t.obj (B_φt.obj W'_et)).left).presheaf.obj (Opposite.op ⊤))
        let fst_V_φt : (Fgt_t.obj (B_φt.obj V)).left ⟶ (Fgt_V.obj V).left :=
          CategoryTheory.Limits.pullback.fst (Fgt_V.obj V).hom φ_tilde
        let fst_W'_φt : (Fgt_t.obj (B_φt.obj W'_et)).left ⟶ (Fgt_V.obj W'_et).left :=
          CategoryTheory.Limits.pullback.fst (Fgt_V.obj W'_et).hom φ_tilde
        let ρ_V : R_V →+* S_V := CommRingCat.Hom.hom fst_V_φt.appTop
        let ρ_W' : R_W' →+* S_W' := CommRingCat.Hom.hom fst_W'_φt.appTop
        let ψ_RV : R_V →+* R_W' := CommRingCat.Hom.hom (Fgt_V.map i_V).left.appTop
        let ψ_SV : S_V →+* S_W' := CommRingCat.Hom.hom (Fgt_t.map (B_φt.map i_V)).left.appTop
        have hAff_W'_et : AlgebraicGeometry.IsAffine (Fgt_V.obj W'_et).left := hAff_W'
        have hAff_chart_et : AlgebraicGeometry.IsAffine (Fgt_V.obj (chart_et U x)).left :=
          hchart_aff U x
        obtain ⟨e_tens_V, he_tens_V⟩ := hB_etale_bc_φt hAff_W'_et hAff_V i_V
        obtain ⟨e_tens_x, he_tens_x⟩ := hB_etale_bc_φt hAff_W'_et hAff_chart_et i_W
        letI : Algebra R_V R_W' := RingHom.toAlgebra ψ_RV
        letI : Algebra R_V S_V := RingHom.toAlgebra ρ_V
        let e_V_lin : M_V ≃ₗ[R_V] S_V :=
          { e_V with map_smul' := fun r₀ m => he_V r₀ m }
        let M_W' : Type u := TensorProduct R_V R_W' M_V
        let b_W' : Module.Basis (Fin δ) R_W' M_W' := b_V.baseChange R_W'
        let e_W' : M_W' ≃+ S_W' :=
          (LinearEquiv.baseChange R_V R_W' M_V S_V e_V_lin).toAddEquiv.trans e_tens_V
        have he_W' : ∀ (r'₀ : R_W') (m' : M_W'), e_W' (r'₀ • m') = ρ_W' r'₀ * e_W' m' := by
          intro r'₀ m'
          refine TensorProduct.induction_on
            (motive := fun m' => e_W' (r'₀ • m') = ρ_W' r'₀ * e_W' m') m' ?_ ?_ ?_
          · simp only [smul_zero, map_zero, mul_zero]
          · intro r'₁ m
            change e_tens_V ((LinearEquiv.baseChange R_V R_W' M_V S_V e_V_lin)
                (r'₀ • (r'₁ ⊗ₜ[R_V] m))) =
              ρ_W' r'₀ * e_tens_V ((LinearEquiv.baseChange R_V R_W' M_V S_V e_V_lin)
                (r'₁ ⊗ₜ[R_V] m))
            rw [TensorProduct.smul_tmul', smul_eq_mul, LinearEquiv.baseChange_tmul,
              LinearEquiv.baseChange_tmul]
            erw [he_tens_V (r'₀ * r'₁) (e_V_lin m), he_tens_V r'₁ (e_V_lin m)]
            change ρ_W' (r'₀ * r'₁) * _ = ρ_W' r'₀ * (ρ_W' r'₁ * _)
            rw [map_mul, mul_assoc]
          · intro m₁ m₂ ih₁ ih₂
            rw [smul_add, map_add, ih₁, ih₂, map_add, mul_add]
        let s_V : LocallyConstant ↥(Fgt_t.obj (B_φt.obj V)).left (ULift.{u} (ZMod n)) :=
          ((weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (B_φt.map u))) s
        let s_W' : LocallyConstant ↥(Fgt_t.obj (B_φt.obj W'_et)).left (ULift.{u} (ZMod n)) :=
          ((weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (B_φt.map i_V))) s_V
        have hs_W'_eq : (((weilAltLocConstPresheaf Γ_tilde.left n).map
            (Opposite.op (B_φt.map i_W))) s_x :
            LocallyConstant ↥(Fgt_t.obj (B_φt.obj W'_et)).left (ULift.{u} (ZMod n))) = s_W' := by
          dsimp [s_x, s_V, s_W']
          have hcomp_B : B_φt.map i_W ≫ B_φt.map (chart_j U x) =
              B_φt.map i_V ≫ B_φt.map u := by
            rw [← B_φt.map_comp, ← B_φt.map_comp, hi_comm]
          have hm1 : (weilAltLocConstPresheaf Γ_tilde.left n).map
                (Opposite.op (B_φt.map (chart_j U x))) ≫
              (weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (B_φt.map i_W)) =
              (weilAltLocConstPresheaf Γ_tilde.left n).map
                (Opposite.op (B_φt.map i_W ≫ B_φt.map (chart_j U x))) :=
            ((weilAltLocConstPresheaf Γ_tilde.left n).map_comp
              (Opposite.op (B_φt.map (chart_j U x))) (Opposite.op (B_φt.map i_W))).symm
          have hm2 : (weilAltLocConstPresheaf Γ_tilde.left n).map
              (Opposite.op (B_φt.map i_W ≫ B_φt.map (chart_j U x))) =
              (weilAltLocConstPresheaf Γ_tilde.left n).map
                (Opposite.op (B_φt.map i_V ≫ B_φt.map u)) :=
            congrArg (fun h => (weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op h))
              hcomp_B
          have hm3 : (weilAltLocConstPresheaf Γ_tilde.left n).map
              (Opposite.op (B_φt.map i_V ≫ B_φt.map u)) =
              (weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (B_φt.map u)) ≫
                (weilAltLocConstPresheaf Γ_tilde.left n).map (Opposite.op (B_φt.map i_V)) :=
            (weilAltLocConstPresheaf Γ_tilde.left n).map_comp
              (Opposite.op (B_φt.map u)) (Opposite.op (B_φt.map i_V))
          exact congrArg (fun φ_m => φ_m s) (hm1.trans (hm2.trans hm3))
        obtain ⟨L_W', hL_W'⟩ := hA_ex ρ_W' M_W' e_W' he_W'
          (D.ι_ζ Γ_tilde (B_φt.obj W'_et) s_W')
        have hL_W'_V : ∀ m' : M_W',
            e_W' (L_W' m') = ψ_SV (D.ι_ζ Γ_tilde (B_φt.obj V) s_V) * e_W' m' := by
          intro m'
          have hι_iV : D.ι_ζ Γ_tilde (B_φt.obj W'_et) s_W' =
              ψ_SV (D.ι_ζ Γ_tilde (B_φt.obj V) s_V) :=
            hι_nat Γ_tilde (B_φt.map i_V) s_V
          rw [hL_W' m', hι_iV]
        have hL_W'_x : ∀ m' : M_W',
            e_W' (L_W' m') =
              (CommRingCat.Hom.hom (Fgt_t.map (B_φt.map i_W)).left.appTop)
                (D.ι_ζ Γ_tilde (B_φt.obj (chart_et U x)) s_x) * e_W' m' := by
          intro m'
          have hι_iW : D.ι_ζ Γ_tilde (B_φt.obj W'_et) s_W' =
              (CommRingCat.Hom.hom (Fgt_t.map (B_φt.map i_W)).left.appTop)
                (D.ι_ζ Γ_tilde (B_φt.obj (chart_et U x)) s_x) :=
            (congrArg (D.ι_ζ Γ_tilde (B_φt.obj W'_et)) hs_W'_eq.symm).trans
              (hι_nat Γ_tilde (B_φt.map i_W) s_x)
          rw [hL_W' m', hι_iW]
        have hdet_V : ((LinearMap.toMatrix b_W' b_W') L_W').det =
            ψ_RV (((LinearMap.toMatrix b_V b_V) L_V).det) :=
          hA_bc ρ_V ρ_W' ψ_RV ψ_SV e_tens_V he_tens_V
            M_V b_V e_V he_V M_W' b_W' e_W' he_W'
            (D.ι_ζ Γ_tilde (B_φt.obj V) s_V) L_V L_W' hL_V hL_W'_V
        have hdet_x : ((LinearMap.toMatrix b_W' b_W') L_W').det =
            (CommRingCat.Hom.hom (Fgt_V.map i_W).left.appTop)
              (((LinearMap.toMatrix (chart_b U x) (chart_b U x)) L_x).det) :=
          hA_bc ρ_x ρ_W'
            (CommRingCat.Hom.hom (Fgt_V.map i_W).left.appTop)
            (CommRingCat.Hom.hom (Fgt_t.map (B_φt.map i_W)).left.appTop)
            e_tens_x he_tens_x
            (chart_M U x) (chart_b U x) (chart_e U x) (hchart_e U x) M_W' b_W' e_W' he_W'
            (D.ι_ζ Γ_tilde (B_φt.obj (chart_et U x)) s_x) L_x L_W' hL_x hL_W'_x
        have hsec_eq : ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op i_W))
            (chart_sec U s x) =
            ((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op i_V)) t_V := by
          have hι_lhs : D.ι_ζ Γ_V W'_et
              (((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op i_W))
                (chart_sec U s x)) =
              (CommRingCat.Hom.hom (Fgt_V.map i_W).left.appTop)
                (((LinearMap.toMatrix (chart_b U x) (chart_b U x)) L_x).det) :=
            (hι_nat Γ_V i_W (chart_sec U s x)).trans (congrArg _ ht_x)
          have hι_rhs : D.ι_ζ Γ_V W'_et
              (((weilAltLocConstPresheaf Γ_V.left n).map (Opposite.op i_V)) t_V) =
              ψ_RV (((LinearMap.toMatrix b_V b_V) L_V).det) :=
            (hι_nat Γ_V i_V t_V).trans (congrArg _ ht_V)
          exact hι_inj Γ_V W'_et (hι_lhs.trans (hdet_x.symm.trans (hdet_V.trans hι_rhs.symm)))
        have heval := congrArg
          (fun g : LocallyConstant ↥(Fgt_V.obj W'_et).left (ULift.{u} (ZMod n)) =>
            g ⟨y, hy_W'⟩) hsec_eq
        have hpt_eq : res_u.base ⟨y, hy_W'⟩ = ⟨x, hchart_mem U x⟩ := by
          apply Subtype.ext
          change ((res_u ≫ (chart_W U x).ι).base ⟨y, hy_W'⟩) = (Fgt_V.map u).left.base y
          rw [hres_u_ι]
          rfl
        change chart_sec U s x (res_u.base ⟨y, hy_W'⟩) = t_V y at heval
        rwa [hpt_eq] at heval

      have hf_val_chart : ∀ (U : Γ_V.left.Etale)
          (s : LocallyConstant ↥(Fgt_t.obj (B_φt.obj U)).left (ULift.{u} (ZMod n)))
          (x : ↥(Fgt_V.obj U).left) (z : ↥(Fgt_V.obj (chart_et U x)).left),
          f_val U s z.1 = chart_sec U s x z := by
        intro U s x z
        letI : AddCommGroup (chart_M U x) := hchart_add U x
        letI : Module ↑(((Fgt_V.obj (chart_et U x)).left).presheaf.obj (Opposite.op ⊤))
          (chart_M U x) := hchart_mod U x
        let s_x := ((weilAltLocConstPresheaf Γ_tilde.left n).map
          (Opposite.op (B_φt.map (chart_j U x)))) s
        let ρ_x := CommRingCat.Hom.hom
          (CategoryTheory.Limits.pullback.fst (Fgt_V.obj (chart_et U x)).hom φ_tilde).appTop
        obtain ⟨L_x, hL_x⟩ := hA_ex ρ_x (chart_M U x) (chart_e U x) (hchart_e U x)
          (D.ι_ζ Γ_tilde (B_φt.obj (chart_et U x)) s_x)
        exact h_agree U (chart_et U x) (hchart_aff U x) (chart_j U x)
          (chart_M U x) (chart_b U x) (chart_e U x) (hchart_e U x)
          s L_x hL_x (chart_sec U s x) (hchart_sec U s x L_x hL_x) z

      have hf_val_lc : ∀ (U : Γ_V.left.Etale)
          (s : LocallyConstant ↥(Fgt_t.obj (B_φt.obj U)).left (ULift.{u} (ZMod n))),
          IsLocallyConstant (f_val U s) := by
        intro U s S
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        refine ⟨Subtype.val '' ((chart_sec U s x) ⁻¹' S), ?_, ?_, ?_⟩
        · rintro _ ⟨z, hz, rfl⟩
          change f_val U s z.1 ∈ S
          rwa [hf_val_chart U s x z]
        · exact (chart_W U x).isOpen.isOpenMap_subtype_val _
            ((chart_sec U s x).isLocallyConstant S)
        · exact ⟨⟨x, hchart_mem U x⟩, hx, rfl⟩

      let τ_lc : ∀ (U : Γ_V.left.Etale),
          LocallyConstant ↥(Fgt_t.obj (B_φt.obj U)).left (ULift.{u} (ZMod n)) →
          LocallyConstant ↥(Fgt_V.obj U).left (ULift.{u} (ZMod n)) :=
        fun U s => ⟨f_val U s, hf_val_lc U s⟩

      have hτ_lc_zero : ∀ U : Γ_V.left.Etale, τ_lc U 0 = 0 := by
        intro U
        apply LocallyConstant.ext
        intro x
        letI : AddCommGroup (chart_M U x) := hchart_add U x
        letI : Module ↑(((Fgt_V.obj (chart_et U x)).left).presheaf.obj (Opposite.op ⊤))
          (chart_M U x) := hchart_mod U x
        let id_x : chart_M U x →ₗ[↑(((Fgt_V.obj (chart_et U x)).left).presheaf.obj
            (Opposite.op ⊤))] chart_M U x := LinearMap.id
        have hL_id : ∀ m : chart_M U x,
            chart_e U x (id_x m) =
              D.ι_ζ Γ_tilde (B_φt.obj (chart_et U x))
                (((weilAltLocConstPresheaf Γ_tilde.left n).map
