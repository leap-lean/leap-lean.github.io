        ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm)
    have hPb_rect : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_s) ≫ j_Γ)
