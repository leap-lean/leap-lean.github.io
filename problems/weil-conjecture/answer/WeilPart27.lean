      [AlgebraicGeometry.IsProper Z₂.hom]
      [AlgebraicGeometry.IsProper Z₃.hom]
      (g : Quiver.Hom Z₁.left Z₂.left)
      (f : Quiver.Hom Z₂.left Z₃.left)
      (hg_over : CategoryTheory.CategoryStruct.comp g Z₂.hom = Z₁.hom)
      (hf_over : CategoryTheory.CategoryStruct.comp f Z₃.hom = Z₂.hom)
      (hgf_over : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp g f) Z₃.hom = Z₁.hom)
      (δ m : ℕ) (hδ : 1 ≤ δ) (hm : 1 ≤ m) (hmδ : 1 ≤ m * δ)
      (O₃ : Z₃.left.Opens) (O₂ : Z₂.left.Opens) (O₁ : Z₁.left.Opens)
      (hO₂ : O₂ = (TopologicalSpace.Opens.map f.base).obj O₃)
      (hO₁ : O₁ = (TopologicalSpace.Opens.map g.base).obj O₂)
      (hO₁₃ : O₁ = (TopologicalSpace.Opens.map
        (CategoryTheory.CategoryStruct.comp g f).base).obj O₃)
      (hg_free : WeilTopDegFiniteLocallyFreeOfRank δ (g ∣_ O₂))
