            rw [AlgebraicGeometry.Scheme.homeoOfIso_symm]
            exact (AlgebraicGeometry.Scheme.homeoOfIso_apply (hAff_cov α).isoSpec.symm q').symm
          rw [← (hAff_cov α).isoSpec_inv_ι,
            AlgebraicGeometry.Scheme.Hom.comp_apply (hAff_cov α).isoSpec.inv (U_cov α).ι q',
