        have hev := congrArg (fun g => asLC g y) (htL_amalg f hfR)
        change (asLC tL) (f.left y) = (sec f hfR).1 y at hev
        rw [hfy] at hev
        refine hev.trans ((sec f hfR).2 y ?_)
        intro hyV
        apply hx
        have hw : Y.hom y = U.hom x := by
          rw [← hfy, ← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w f]
        change U.hom x ∈ (W₀ : Set ↥S)
        change Y.hom y ∈ (W₀ : Set ↥S) at hyV
        rwa [← hw]
      exact ⟨⟨asLC tL, htL_mem⟩,
        fun _ f hf => Subtype.ext (htL_amalg f hf),
        fun t' ht' => Subtype.ext (htL_uniq t'.1 (fun _ f hf => congrArg Subtype.val (ht' f hf)))⟩

    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    have hTorsionIso : ∀ (W : AlgebraicGeometry.Scheme.{u}),
        let L_W : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u} :=
          ⟨weilAltLocConstPresheaf W n, hLocConstIsSheaf W⟩
        ∃ Φ_W : weilEtaleTorsionSheaf W n ≅ L_W,
          ∀ U : W.Etale,
            (((CategoryTheory.sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}).unit.app
              ((CategoryTheory.Functor.const (Opposite W.Etale)).obj AM)).app (Opposite.op U)) ≫
              (Φ_W.hom.hom.app (Opposite.op U)) =
            weilAltLocConstConstHom W U n := by
      intro W L_W
      let T_W : W.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 W)
        (inferInstance : AlgebraicGeometry.Etale (𝟙 W))
      have hT_W : CategoryTheory.Limits.IsTerminal T_W :=
        CategoryTheory.Limits.IsTerminal.ofUniqueHom
          (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id _))
          (fun U m => CategoryTheory.MorphismProperty.Over.Hom.ext
            ((CategoryTheory.Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m)))
      let J_W := W.smallEtaleTopology
      let F_sh : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} := weilEtaleTorsionSheaf W n
      let F_pre := F_sh.obj
      let L_pre := weilAltLocConstPresheaf W n
      let adj_W := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W
      let η_W : AM ⟶ F_pre.obj (Opposite.op T_W) := adj_W.unit.app AM
      let c_W : AM ⟶ L_pre.obj (Opposite.op T_W) := weilAltLocConstConstHom W T_W n
      let Φ_hom : F_sh ⟶ L_W := (adj_W.homEquiv AM L_W).symm c_W
      have hΦ_unit : η_W ≫ Φ_hom.hom.app (Opposite.op T_W) = c_W :=
        (adj_W.homEquiv AM L_W).apply_symm_apply c_W
      have hF_type : CategoryTheory.Presieve.IsSheaf J_W
          (F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
        rw [← CategoryTheory.isSheaf_iff_isSheaf_of_type]
        exact CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J_W F_pre
          (CategoryTheory.forget AddCommGrpCat.{u}) F_sh.property
      have hEmpty_sub : ∀ (Z₀ : W.Etale), IsEmpty ↥Z₀.left → Subsingleton (F_pre.obj (Opposite.op Z₀)) := by
        intro Z₀ hEmp
        refine ⟨fun a b => ?_⟩
        have hbot : (⊥ : CategoryTheory.Sieve Z₀) ∈ J_W Z₀ :=
          (hMemEtale Z₀ ⊥).mpr (fun x => IsEmpty.elim hEmp x)
        obtain ⟨t₀, _, ht₀_uniq⟩ := (hF_type ⊥ hbot)
          (fun _ _ hf => False.elim hf)
          (fun _ _ _ _ _ _ _ hf₁ _ _ => False.elim hf₁)
        exact (ht₀_uniq a (fun _ _ hf => False.elim hf)).trans
          (ht₀_uniq b (fun _ _ hf => False.elim hf)).symm
      let openEtale : ∀ (U : W.Etale) (O : U.left.Opens), W.Etale :=
        fun U O => CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et O.ι U.hom inferInstance U.prop)
      let openEtaleHom : ∀ (U : W.Etale) (O : U.left.Opens), openEtale U O ⟶ U :=
        fun U O => CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
      let O_lvl : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (x : ↥U.left), U.left.Opens :=
        fun U s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
      let W_lvl : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (x : ↥U.left), W.Etale :=
        fun U s x => openEtale U (O_lvl U s x)
      let j_lvl : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (x : ↥U.left), W_lvl U s x ⟶ U :=
        fun U s x => openEtaleHom U (O_lvl U s x)
      have hArrows_gluing : ∀ {U : W.Etale} {ι : Type u} (Y : ι → W.Etale) (π : ∀ i : ι, Y i ⟶ U),
          (∀ x : ↥U.left, ∃ i : ι, x ∈ Set.range (π i).left) →
          (∀ i : ι, AlgebraicGeometry.Etale (π i).left) →
          ∀ (sec : ∀ i : ι, F_pre.obj (Opposite.op (Y i))),
          CategoryTheory.Presieve.Arrows.Compatible (F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) π sec →
          ∃! t : F_pre.obj (Opposite.op U), ∀ i : ι, F_pre.map (π i).op t = sec i := by
        intro U ι Y π hcov het sec hcomp
        have hmem : CategoryTheory.Sieve.ofArrows Y π ∈ J_W U := by
          rw [hMemEtale]
          intro x
          obtain ⟨i, y, rfl⟩ := hcov x
          exact ⟨Y i, π i, y, CategoryTheory.Sieve.ofArrows_mk Y π i, het i, rfl⟩
        have hsf := hF_type.isSheafFor _ hmem
        rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hsf
        exact hsf sec hcomp
      have hj_cov : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (x : ↥U.left),
          ∃ i : ↥U.left, x ∈ Set.range (j_lvl U s i).left :=
        fun U s x => ⟨x, ⟨x, show s x = s x from rfl⟩, rfl⟩
      have hj_et : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (x : ↥U.left),
          AlgebraicGeometry.Etale (j_lvl U s x).left := fun U s x => hEtLeft (j_lvl U s x)
      let σ_lvl : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (x : ↥U.left),
          F_pre.obj (Opposite.op (W_lvl U s x)) :=
        fun U s x => F_pre.map (hT_W.from (W_lvl U s x)).op (η_W (s x))
      have hF_map_comp : ∀ {X₁ X₂ X₃ : W.Etale} (g₁ : X₁ ⟶ X₂) (g₂ : X₂ ⟶ X₃)
          (v : F_pre.obj (Opposite.op X₃)),
          F_pre.map g₁.op (F_pre.map g₂.op v) = F_pre.map (g₁ ≫ g₂).op v := by
        intro X₁ X₂ X₃ g₁ g₂ v
        rw [op_comp, F_pre.map_comp]
        rfl
      have hσ_compat : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM),
          CategoryTheory.Presieve.Arrows.Compatible (F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u})
            (j_lvl U s) (σ_lvl U s) := by
        intro U s x₁ x₂ Z₀ f₁ f₂ hf_eq
        by_cases hZ₀ : Nonempty ↥Z₀.left
        · obtain ⟨z₀⟩ := hZ₀
          have hz₁ : s ((f₁ ≫ j_lvl U s x₁).left z₀) = s x₁ := (f₁.left z₀).2
          have hz₂ : s ((f₂ ≫ j_lvl U s x₂).left z₀) = s x₂ := (f₂.left z₀).2
          rw [hf_eq] at hz₁
          have hs_eq : s x₁ = s x₂ := hz₁.symm.trans hz₂
          have hterm : f₁ ≫ hT_W.from (W_lvl U s x₁) = f₂ ≫ hT_W.from (W_lvl U s x₂) :=
            hT_W.hom_ext _ _
          change F_pre.map f₁.op (F_pre.map (hT_W.from (W_lvl U s x₁)).op (η_W (s x₁))) =
            F_pre.map f₂.op (F_pre.map (hT_W.from (W_lvl U s x₂)).op (η_W (s x₂)))
          rw [hF_map_comp, hF_map_comp, hterm, hs_eq]
        · have : IsEmpty ↥Z₀.left := not_nonempty_iff.mp hZ₀
          have : Subsingleton (F_pre.obj (Opposite.op Z₀)) := hEmpty_sub Z₀ inferInstance
          exact Subsingleton.elim _ _
      let ψ_fun : ∀ (U : W.Etale), LocallyConstant ↥U.left ↥AM → F_pre.obj (Opposite.op U) :=
        fun U s => Classical.choose
          (hArrows_gluing (W_lvl U s) (j_lvl U s) (hj_cov U s) (hj_et U s) (σ_lvl U s) (hσ_compat U s))
      have hψ_spec : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (x : ↥U.left),
          F_pre.map (j_lvl U s x).op (ψ_fun U s) = F_pre.map (hT_W.from (W_lvl U s x)).op (η_W (s x)) :=
        fun U s => (Classical.choose_spec
          (hArrows_gluing (W_lvl U s) (j_lvl U s) (hj_cov U s) (hj_et U s) (σ_lvl U s) (hσ_compat U s))).1
      have hψ_uniq : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left ↥AM) (t : F_pre.obj (Opposite.op U)),
          (∀ x : ↥U.left, F_pre.map (j_lvl U s x).op t =
            F_pre.map (hT_W.from (W_lvl U s x)).op (η_W (s x))) →
          t = ψ_fun U s :=
        fun U s t ht => (Classical.choose_spec
          (hArrows_gluing (W_lvl U s) (j_lvl U s) (hj_cov U s) (hj_et U s) (σ_lvl U s) (hσ_compat U s))).2 t ht
      have hψ_const : ∀ {U₁ U₂ : W.Etale} (g : U₁ ⟶ U₂) (s : LocallyConstant ↥U₂.left ↥AM) (a : ↥AM),
          (∀ y : ↥U₁.left, s (g.left y) = a) →
          F_pre.map g.op (ψ_fun U₂ s) = F_pre.map (hT_W.from U₁).op (η_W a) := by
        intro U₁ U₂ g s a hconst
        by_cases hU₁ : Nonempty ↥U₁.left
        · obtain ⟨y₀⟩ := hU₁
          let x₀ : ↥U₂.left := g.left y₀
          have hx₀ : s x₀ = a := hconst y₀
          have hrange : Set.range g.left ⊆ Set.range (O_lvl U₂ s x₀).ι := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨y, rfl⟩
            change s (g.left y) = s x₀
            rw [hconst y, hx₀]
          let g_lift₀ : U₁.left ⟶ (O_lvl U₂ s x₀).toScheme :=
            AlgebraicGeometry.IsOpenImmersion.lift (O_lvl U₂ s x₀).ι g.left hrange
          have hfac₀ : g_lift₀ ≫ (O_lvl U₂ s x₀).ι = g.left :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac (O_lvl U₂ s x₀).ι g.left hrange
          let g_lift : U₁ ⟶ W_lvl U₂ s x₀ := CategoryTheory.MorphismProperty.Over.homMk g_lift₀ (by
            change g_lift₀ ≫ (O_lvl U₂ s x₀).ι ≫ U₂.hom = U₁.hom
            rw [← CategoryTheory.Category.assoc, hfac₀]
            exact CategoryTheory.MorphismProperty.Over.w g)
          have hfac : g_lift ≫ j_lvl U₂ s x₀ = g := CategoryTheory.MorphismProperty.Over.Hom.ext hfac₀
          have hterm : g_lift ≫ hT_W.from (W_lvl U₂ s x₀) = hT_W.from U₁ := hT_W.hom_ext _ _
          rw [← hfac, ← hF_map_comp, hψ_spec U₂ s x₀, hF_map_comp, hterm, hx₀]
        · have : IsEmpty ↥U₁.left := not_nonempty_iff.mp hU₁
          have : Subsingleton (F_pre.obj (Opposite.op U₁)) := hEmpty_sub U₁ inferInstance
          exact Subsingleton.elim _ _
      have hψ_zero : ∀ U : W.Etale, ψ_fun U 0 = 0 := by
        intro U
        symm
        apply hψ_uniq U 0 0
        intro x
        change (F_pre.map (j_lvl U 0 x).op) 0 = F_pre.map (hT_W.from (W_lvl U 0 x)).op (η_W 0)
        rw [map_zero, map_zero, map_zero]
      have hψ_add : ∀ (U : W.Etale) (s₁ s₂ : LocallyConstant ↥U.left ↥AM),
          ψ_fun U (s₁ + s₂) = ψ_fun U s₁ + ψ_fun U s₂ := by
        intro U s₁ s₂
        let O₁₂ : ↥U.left → U.left.Opens := fun x => O_lvl U s₁ x ⊓ O_lvl U s₂ x
        let Y₁₂ : ↥U.left → W.Etale := fun x => openEtale U (O₁₂ x)
        let k₁₂ : ∀ x : ↥U.left, Y₁₂ x ⟶ U := fun x => openEtaleHom U (O₁₂ x)
        have hk_cov : ∀ x : ↥U.left, ∃ i : ↥U.left, x ∈ Set.range (k₁₂ i).left :=
          fun x => ⟨x, ⟨x, rfl, rfl⟩, rfl⟩
        have hk_et : ∀ x : ↥U.left, AlgebraicGeometry.Etale (k₁₂ x).left := fun x => hEtLeft (k₁₂ x)
        have hcomp_lhs : CategoryTheory.Presieve.Arrows.Compatible (F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) k₁₂
            (fun x => F_pre.map (k₁₂ x).op (ψ_fun U (s₁ + s₂))) := by
          intro x₁ x₂ Z₀ f₁ f₂ hf_eq
          change F_pre.map f₁.op (F_pre.map (k₁₂ x₁).op (ψ_fun U (s₁ + s₂))) =
            F_pre.map f₂.op (F_pre.map (k₁₂ x₂).op (ψ_fun U (s₁ + s₂)))
          rw [hF_map_comp, hF_map_comp, hf_eq]
        obtain ⟨t_u, _, ht_uniq⟩ := hArrows_gluing Y₁₂ k₁₂ hk_cov hk_et _ hcomp_lhs
        have h1 : ψ_fun U (s₁ + s₂) = t_u := ht_uniq _ (fun _ => rfl)
        have h2 : ψ_fun U s₁ + ψ_fun U s₂ = t_u := by
          apply ht_uniq
          intro x
          have hc₁ : ∀ y : ↥(Y₁₂ x).left, s₁ ((k₁₂ x).left y) = s₁ x := fun y => y.2.1
          have hc₂ : ∀ y : ↥(Y₁₂ x).left, s₂ ((k₁₂ x).left y) = s₂ x := fun y => y.2.2
          have hc₁₂ : ∀ y : ↥(Y₁₂ x).left, (s₁ + s₂) ((k₁₂ x).left y) = s₁ x + s₂ x :=
            fun y => (LocallyConstant.add_apply s₁ s₂ ((k₁₂ x).left y)).trans
              (congrArg₂ (· + ·) (hc₁ y) (hc₂ y))
          rw [map_add, hψ_const (k₁₂ x) s₁ (s₁ x) hc₁, hψ_const (k₁₂ x) s₂ (s₂ x) hc₂,
            hψ_const (k₁₂ x) (s₁ + s₂) (s₁ x + s₂ x) hc₁₂, map_add, map_add]
        exact h1.trans h2.symm
      have hψ_nat : ∀ {U₁ U₂ : W.Etale} (u : U₁ ⟶ U₂) (s : LocallyConstant ↥U₂.left ↥AM),
          F_pre.map u.op (ψ_fun U₂ s) = ψ_fun U₁ ((L_pre.map u.op) s) := by
        intro U₁ U₂ u s
        let s' : LocallyConstant ↥U₁.left ↥AM := (L_pre.map u.op) s
        apply hψ_uniq U₁ s'
        intro x'
        rw [hF_map_comp]
        exact hψ_const (j_lvl U₁ s' x' ≫ u) s (s' x') (fun y => y.2)
      let Φ_inv : L_W ⟶ F_sh := CategoryTheory.ObjectProperty.homMk
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := ψ_fun (Opposite.unop U)
              map_zero' := hψ_zero (Opposite.unop U)
              map_add' := hψ_add (Opposite.unop U) }
          naturality := fun {U₁ U₂} u => AddCommGrpCat.ext (fun s => (hψ_nat u.unop s).symm) }
      have hcΨ : c_W ≫ Φ_inv.hom.app (Opposite.op T_W) = η_W := by
        ext a
        change ψ_fun T_W (c_W a) = η_W a
        have h1 := hψ_const (𝟙 T_W) (c_W a) a (fun _ => rfl)
        have htid : hT_W.from T_W = 𝟙 T_W := hT_W.hom_ext _ _
        rw [htid, op_id, F_pre.map_id] at h1
        exact h1
      have h_hom_inv : Φ_hom ≫ Φ_inv = 𝟙 F_sh := by
        apply (adj_W.homEquiv AM F_sh).injective
        let R_sec := (CategoryTheory.sheafSections J_W AddCommGrpCat.{u}).obj (Opposite.op T_W)
        have hL : (adj_W.homEquiv AM F_sh) (Φ_hom ≫ Φ_inv) =
            ((adj_W.homEquiv AM L_W) Φ_hom) ≫ R_sec.map Φ_inv :=
          CategoryTheory.Adjunction.homEquiv_naturality_right adj_W Φ_hom Φ_inv
        have hR : (adj_W.homEquiv AM F_sh) (𝟙 F_sh) = η_W := by
          rw [CategoryTheory.Adjunction.homEquiv_unit, R_sec.map_id]
          exact CategoryTheory.Category.comp_id _
        rw [hL, hR, (adj_W.homEquiv AM L_W).apply_symm_apply]
        exact hcΨ
      have h_inv_hom : Φ_inv ≫ Φ_hom = 𝟙 L_W := by
        apply CategoryTheory.ObjectProperty.hom_ext
        refine CategoryTheory.NatTrans.ext (funext fun U => AddCommGrpCat.ext fun s => ?_)
        let asL : ∀ {Y : W.Etale}, L_pre.obj (Opposite.op Y) → LocallyConstant ↥Y.left ↥AM := fun g => g
        let U₀ := Opposite.unop U
        let s₀ : LocallyConstant ↥U₀.left ↥AM := s
        let lhs₀ : LocallyConstant ↥U₀.left ↥AM := asL ((Φ_hom.hom.app (Opposite.op U₀)) (ψ_fun U₀ s₀))
        change lhs₀ = s₀
        refine LocallyConstant.ext (fun x => ?_)
        let x_pt : ↥(W_lvl U₀ s₀ x).left := ⟨x, rfl⟩
        have hnat₁ := congrArg (fun k => k (ψ_fun U₀ s₀))
          (Φ_hom.hom.naturality (j_lvl U₀ s₀ x).op)
        have hnat₂ := congrArg (fun k => k (η_W (s₀ x)))
          (Φ_hom.hom.naturality (hT_W.from (W_lvl U₀ s₀ x)).op)
        have hev₁ : asL ((L_pre.map (j_lvl U₀ s₀ x).op) lhs₀) x_pt = lhs₀ x := rfl
        rw [← hev₁]
        have hstep : (L_pre.map (j_lvl U₀ s₀ x).op) lhs₀ =
            (L_pre.map (hT_W.from (W_lvl U₀ s₀ x)).op) ((η_W ≫ Φ_hom.hom.app (Opposite.op T_W)) (s₀ x)) :=
          hnat₁.symm.trans
            ((congrArg (Φ_hom.hom.app (Opposite.op (W_lvl U₀ s₀ x))) (hψ_spec U₀ s₀ x)).trans hnat₂)
        rw [hstep, hΦ_unit]
        rfl
      let Φ_W : F_sh ≅ L_W := ⟨Φ_hom, Φ_inv, h_hom_inv, h_inv_hom⟩
      refine ⟨Φ_W, fun U => ?_⟩
      let u_sh := (CategoryTheory.sheafificationAdjunction J_W AddCommGrpCat.{u}).unit.app
        ((CategoryTheory.Functor.const (Opposite W.Etale)).obj AM)
      let t_U : U ⟶ T_W := hT_W.from U
      apply AddCommGrpCat.ext
      intro a
      have hn : (u_sh.app (Opposite.op U)) a = (F_pre.map t_U.op) (η_W a) :=
        congrArg (fun k => k a) (u_sh.naturality t_U.op)
      have hφ_nat : (Φ_hom.hom.app (Opposite.op U)) ((F_pre.map t_U.op) (η_W a)) =
          (L_pre.map t_U.op) ((Φ_hom.hom.app (Opposite.op T_W)) (η_W a)) :=
        congrArg (fun k => k (η_W a)) (Φ_hom.hom.naturality t_U.op)
      have hφ_u : (Φ_hom.hom.app (Opposite.op T_W)) (η_W a) = c_W a :=
        congrArg (fun k => k a) hΦ_unit
      change (Φ_hom.hom.app (Opposite.op U)) ((u_sh.app (Opposite.op U)) a) =
        (weilAltLocConstConstHom W U n) a
      rw [hn, hφ_nat, hφ_u]
      exact LocallyConstant.ext (fun _ => rfl)

    let I_Z := weilAltClosedComplIdeal S W₀
    let Z_sch := I_Z.subscheme
    let i_Z := I_Z.subschemeι
    have hRange_iZ : Set.range i_Z = (W₀ : Set ↥S)ᶜ :=
      (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_Z).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal _)
    have : (weilEtaleSitePullback i_Z).IsContinuous S.smallEtaleTopology Z_sch.smallEtaleTopology := hCont
    let B_Z := weilEtaleSitePullback i_Z
    let P_push_Z := B_Z.sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology Z_sch.smallEtaleTopology
    let L_S : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf S n, hLocConstIsSheaf S⟩
    let L_Z : CategoryTheory.Sheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf Z_sch n, hLocConstIsSheaf Z_sch⟩
    let L0_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltZeroBdrySubpresheaf S W₀ n, hZeroBdryIsSheaf⟩
    obtain ⟨Φ_S, hunit_S⟩ := hTorsionIso S
    obtain ⟨Φ_Z, _⟩ := hTorsionIso Z_sch

    let ι_lc : L0_sh ⟶ L_S := CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι S W₀ n)
    let π_lc : L_S ⟶ P_push_Z.obj L_Z := CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_Z n)
    have hRange_pb : ∀ (U : S.Etale) (x : ↥U.left),
        x ∈ Set.range (CategoryTheory.Limits.pullback.fst U.hom i_Z) ↔ U.hom x ∉ (W₀ : Set ↥S) := by
      intro U x
      constructor
      · rintro ⟨z, rfl⟩
        have hcomm : U.hom (CategoryTheory.Limits.pullback.fst U.hom i_Z z) =
            i_Z (CategoryTheory.Limits.pullback.snd U.hom i_Z z) := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Scheme.Hom.comp_apply,
            CategoryTheory.Limits.pullback.condition]
        rw [hcomm]
        have hmem : i_Z (CategoryTheory.Limits.pullback.snd U.hom i_Z z) ∈ (W₀ : Set ↥S)ᶜ := by
          rw [← hRange_iZ]
          exact ⟨_, rfl⟩
        exact hmem
      · intro hxV
        have hx_range : U.hom x ∈ Set.range i_Z := by
          rw [hRange_iZ]
          exact hxV
        rcases hx_range with ⟨z₀, hz₀⟩
        obtain ⟨z, hz, -⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x z₀ hz₀.symm
        exact ⟨z, hz⟩

    have h0_lc : ι_lc ≫ π_lc = 0 := by
      apply CategoryTheory.ObjectProperty.hom_ext
      refine CategoryTheory.NatTrans.ext (funext fun U => AddCommGrpCat.ext fun g => ?_)
      let U₀ := Opposite.unop U
      let g₀ : ↥(weilAltZeroBdrySubgroup S W₀ n U₀) := g
      exact LocallyConstant.ext (fun z => g₀.2 _ ((hRange_pb U₀ _).mp ⟨z, rfl⟩))

    have hKer_lc : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι ι_lc h0_lc) := by
      let asLZ : ∀ {Y : S.Etale},
          (P_push_Z.obj L_Z).obj.obj (Opposite.op Y) →
            LocallyConstant ↥(B_Z.obj Y).left (ULift.{u} (ZMod n)) := fun g => g
      refine CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun {X_sh} k hk => CategoryTheory.ObjectProperty.homMk
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := fun w =>
                  let kw : LocallyConstant ↥(Opposite.unop U).left (ULift.{u} (ZMod n)) := k.hom.app U w
                  ⟨kw, fun x hxV => by
                    rcases (hRange_pb (Opposite.unop U) x).mpr hxV with ⟨z, rfl⟩
                    exact congrArg (fun m : X_sh ⟶ P_push_Z.obj L_Z =>
                      asLZ (m.hom.app (Opposite.op (Opposite.unop U)) w) z) hk⟩
                map_zero' := Subtype.ext (map_zero (k.hom.app U).hom)
                map_add' := fun a b => Subtype.ext (map_add (k.hom.app U).hom a b) }
            naturality := fun {U₁ U₂} u => AddCommGrpCat.ext (fun w =>
              Subtype.ext (congrArg (fun m => m w) (k.hom.naturality u))) })
        (fun {X_sh} _ _ => by
          apply CategoryTheory.ObjectProperty.hom_ext
          exact CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext (fun _ => rfl)))
        (fun {X_sh} _ _ m hm => by
          apply CategoryTheory.ObjectProperty.hom_ext
          exact CategoryTheory.NatTrans.ext (funext fun U => AddCommGrpCat.ext (fun w => Subtype.ext
            (congrArg (fun q_hom : X_sh ⟶ L_S => q_hom.hom.app U w) hm))))

    have hMono_ι : CategoryTheory.Mono ι_lc :=
      CategoryTheory.Limits.mono_of_isLimit_fork hKer_lc
    have hExact_lc : (CategoryTheory.ShortComplex.mk ι_lc π_lc h0_lc).Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer_lc

    have : CategoryTheory.Sheaf.IsLocallySurjective π_lc := by
      refine ⟨fun {U} s => ?_⟩
      let s₀ : LocallyConstant ↥(B_Z.obj U).left (ULift.{u} (ZMod n)) := s
      rw [hMemEtale]
      intro x
      let ι' : (B_Z.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom i_Z
      have : AlgebraicGeometry.IsClosedImmersion ι' :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback U.hom i_Z).flip inferInstance
      have hCl : Topology.IsClosedEmbedding ι' := AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι'
      let openEtaleU : ∀ (O : U.left.Opens), S.Etale :=
        fun O => CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et O.ι U.hom inferInstance U.prop)
      let openEtaleHomU : ∀ (O : U.left.Opens), openEtaleU O ⟶ U :=
        fun O => CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
      by_cases hx : x ∈ Set.range ι'
      · rcases hx with ⟨z₀, rfl⟩
        have hOpen_sz : IsOpen (s₀ ⁻¹' {s₀ z₀}) := s₀.isLocallyConstant {s₀ z₀}
        obtain ⟨O_z, hOz_open, hOz_pre⟩ := hCl.isInducing.isOpen_iff.mp hOpen_sz
        have hxz : ι' z₀ ∈ O_z := by
          change z₀ ∈ ι' ⁻¹' O_z
          rw [hOz_pre]
          rfl
        let W_z : U.left.Opens := ⟨O_z, hOz_open⟩
        let Y_z := openEtaleU W_z
        let f_z := openEtaleHomU W_z
        refine ⟨Y_z, f_z, ⟨ι' z₀, hxz⟩, ?_, hEtLeft f_z, rfl⟩
        refine ⟨LocallyConstant.const ↥Y_z.left (s₀ z₀), ?_⟩
        refine LocallyConstant.ext (fun p => ?_)
        let m : (B_Z.obj Y_z).left ⟶ (B_Z.obj U).left := (B_Z.map f_z).left
        have hm_fst : m ≫ ι' = CategoryTheory.Limits.pullback.fst Y_z.hom i_Z ≫ W_z.ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hp_mem : ι' (m p) ∈ O_z := by
          have h1 : ι' (m p) = W_z.ι (CategoryTheory.Limits.pullback.fst Y_z.hom i_Z p) :=
            (AlgebraicGeometry.Scheme.Hom.comp_apply m ι' p).symm.trans
              ((congrArg (fun k : (B_Z.obj Y_z).left ⟶ U.left => k p) hm_fst).trans
                (AlgebraicGeometry.Scheme.Hom.comp_apply (CategoryTheory.Limits.pullback.fst Y_z.hom i_Z) W_z.ι p))
          rw [h1]
          exact (CategoryTheory.Limits.pullback.fst Y_z.hom i_Z p).2
        have hp_pre : m p ∈ s₀ ⁻¹' {s₀ z₀} := by
          rw [← hOz_pre]
          exact hp_mem
        exact hp_pre.symm
      · let W_0 : U.left.Opens := ⟨(Set.range ι')ᶜ, hCl.isClosed_range.isOpen_compl⟩
        let Y_0 := openEtaleU W_0
        let f_0 := openEtaleHomU W_0
        refine ⟨Y_0, f_0, ⟨x, hx⟩, ?_, hEtLeft f_0, rfl⟩
        refine ⟨0, ?_⟩
        refine LocallyConstant.ext (fun p => ?_)
        let m : (B_Z.obj Y_0).left ⟶ (B_Z.obj U).left := (B_Z.map f_0).left
        have hm_fst : m ≫ ι' = CategoryTheory.Limits.pullback.fst Y_0.hom i_Z ≫ W_0.ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h1 : ι' (m p) = W_0.ι (CategoryTheory.Limits.pullback.fst Y_0.hom i_Z p) :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply m ι' p).symm.trans
            ((congrArg (fun k : (B_Z.obj Y_0).left ⟶ U.left => k p) hm_fst).trans
              (AlgebraicGeometry.Scheme.Hom.comp_apply (CategoryTheory.Limits.pullback.fst Y_0.hom i_Z) W_0.ι p))
        have hp_not : ι' (m p) ∈ (Set.range ι')ᶜ := by
          rw [h1]
          exact (CategoryTheory.Limits.pullback.fst Y_0.hom i_Z p).2
        exact False.elim (hp_not ⟨m p, rfl⟩)

    have hEpi_π : CategoryTheory.Epi π_lc :=
      CategoryTheory.Sheaf.epi_of_isLocallySurjective π_lc
    have hS_lc : (CategoryTheory.ShortComplex.mk ι_lc π_lc h0_lc).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hExact_lc hMono_ι hEpi_π

    let ℒ_U := weilEtaleLocalTorsionSheaf S n U_E
    let u₀ : AM ⟶ L0_sh.obj.obj (Opposite.op U_E) :=
      AddCommGrpCat.ofHom
        { toFun := fun a =>
            ⟨LocallyConstant.const ↥U_E.left a, fun e he => by
              exfalso
              apply he
              rw [hW₀]
              exact ⟨e, rfl⟩⟩
          map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
          map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
    let c₀ : ℒ_U ⟶ L0_sh := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm u₀

    have hFreeHomComp : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : ℒ_U ⟶ ℱ) (f : ℱ ⟶ 𝒢),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ f) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ f.hom.app (Opposite.op U_E) := by
      intro ℱ 𝒢 α f
      let P_free := CategoryTheory.Presheaf.freeYoneda U_E AM
      let adj_sh := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
      let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj P_free ⟶ ℱ := α
      change CategoryTheory.Presheaf.freeYonedaHomEquiv (adj_sh.homEquiv P_free 𝒢 (α' ≫ f)) =
        CategoryTheory.Presheaf.freeYonedaHomEquiv (adj_sh.homEquiv P_free ℱ α') ≫
          f.hom.app (Opposite.op U_E)
      rw [adj_sh.homEquiv_naturality_right α' f]
      exact CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

    have hc₀_comp_ΦS : c₀ ≫ ι_lc = weilEtaleLocalTorsionCounit S n U_E ≫ Φ_S.hom := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeHomComp, hFreeHomComp]
      have hL : CategoryTheory.Sheaf.freeYonedaHomEquiv c₀ = u₀ :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply u₀
      have hR : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S n U_E) =
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
            ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)).app (Opposite.op U_E)) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
      rw [hL, hR]
      exact (by rfl : u₀ ≫ ι_lc.hom.app (Opposite.op U_E) = weilAltLocConstConstHom S U_E n).trans
        (hunit_S U_E).symm

    have hc₀_counit : c₀ ≫ (ι_lc ≫ Φ_S.inv) = weilEtaleLocalTorsionCounit S n U_E := by
      rw [← CategoryTheory.Category.assoc, hc₀_comp_ΦS, CategoryTheory.Category.assoc,
        Φ_S.hom_inv_id, CategoryTheory.Category.comp_id]

    have : CategoryTheory.Sheaf.IsLocallySurjective c₀ := by
      refine ⟨fun {V} g => ?_⟩
      let g₀ : ↥(weilAltZeroBdrySubgroup S W₀ n V) := g
      rw [hMemEtale]
      intro x
      let O_x : V.left.Opens := ⟨g₀.1 ⁻¹' {g₀.1 x}, g₀.1.isLocallyConstant {g₀.1 x}⟩
      let V_x : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ V.hom)
        (CategoryTheory.MorphismProperty.comp_mem P_et O_x.ι V.hom inferInstance V.prop)
      let j_x : V_x ⟶ V := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
      by_cases hg : g₀.1 x = 0
      · refine ⟨V_x, j_x, ⟨x, rfl⟩, ⟨0, ?_⟩, hEtLeft j_x, rfl⟩
        rw [map_zero]
        refine Subtype.ext (LocallyConstant.ext fun w => ?_)
        change (0 : ULift.{u} (ZMod n)) = g₀.1 w.1
        have hw : g₀.1 w.1 = g₀.1 x := w.2
        rw [hw, hg]
      · have hx_W0 : V.hom x ∈ (W₀ : Set ↥S) := by
          by_contra hnot
          exact hg (g₀.2 x hnot)
        rw [hW₀] at hx_W0
        obtain ⟨e_x, hex⟩ := hx_W0
        let vx_hom : V_x.left ⟶ S := V_x.hom
        let ue_hom : U_E.left ⟶ S := U_E.hom
        let e_x' : ↥U_E.left := e_x
        have hex' : vx_hom.base (⟨x, rfl⟩ : ↥V_x.left) = ue_hom.base e_x' :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply O_x.ι V.hom (⟨x, rfl⟩ : ↥O_x.toScheme)).trans hex.symm
        obtain ⟨z_x, hz₁, _⟩ :=
          @AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            V_x.left U_E.left S V_x.hom U_E.hom (⟨x, rfl⟩ : ↥V_x.left) e_x' hex'
        have hp_et : P_et (CategoryTheory.Limits.pullback.fst V_x.hom U_E.hom) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback V_x.hom U_E.hom).flip U_E.prop
        let W_x : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.fst V_x.hom U_E.hom ≫ V_x.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et _ _ hp_et V_x.prop)
        let fst_V : W_x ⟶ V_x := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst V_x.hom U_E.hom) rfl
        let p_U : W_x ⟶ U_E := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.snd V_x.hom U_E.hom)
          CategoryTheory.Limits.pullback.condition.symm
        let h_x : W_x ⟶ V := fst_V ≫ j_x
        let η_free := CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 ℒ_U)
        let s_W := (ℒ_U.obj.map p_U.op) (η_free (g₀.1 x))
        refine ⟨W_x, h_x, z_x, ⟨s_W, ?_⟩, hEtLeft h_x, ?_⟩
        · have hnat_c₀ := congrArg (fun m => m (η_free (g₀.1 x))) (c₀.hom.naturality p_U.op)
          change (c₀.hom.app (Opposite.op W_x)) s_W =
            (L0_sh.obj.map p_U.op) ((c₀.hom.app (Opposite.op U_E)) (η_free (g₀.1 x))) at hnat_c₀
          have hc₀_eval : (c₀.hom.app (Opposite.op U_E)) (η_free (g₀.1 x)) = u₀ (g₀.1 x) := by
            have h_id_comp : c₀ = 𝟙 ℒ_U ≫ c₀ := (CategoryTheory.Category.id_comp c₀).symm
            have h1 := hFreeHomComp (𝟙 ℒ_U) c₀
            rw [← h_id_comp, CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply u₀] at h1
            exact congrArg (fun m => m (g₀.1 x)) h1.symm
          rw [hnat_c₀, hc₀_eval]
          refine Subtype.ext (LocallyConstant.ext fun w => ?_)
          change g₀.1 x = g₀.1 ((fst_V.left w).1)
          exact ((fst_V.left w).2).symm
        · exact (AlgebraicGeometry.Scheme.Hom.comp_apply
              (CategoryTheory.Limits.pullback.fst vx_hom ue_hom) O_x.ι z_x).trans
            (congrArg (fun p : ↥V_x.left => O_x.ι p) hz₁)

    have hEpi_c₀ : CategoryTheory.Epi c₀ :=
      CategoryTheory.Sheaf.epi_of_isLocallySurjective c₀

    have hTor_LU : n • CategoryTheory.CategoryStruct.id ℒ_U = 0 := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 := hFreeHomComp (𝟙 ℒ_U) (n • 𝟙 ℒ_U)
      rw [CategoryTheory.Category.id_comp] at h1
      rw [h1]
      have h0_rhs : CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : ℒ_U ⟶ ℒ_U) = 0 := by
        have h0 := hFreeHomComp (𝟙 ℒ_U) (0 : ℒ_U ⟶ ℒ_U)
        rw [CategoryTheory.Limits.comp_zero] at h0
        rw [h0]
        exact AddCommGrpCat.ext (fun _ => rfl)
      rw [h0_rhs]
      have h_app_nsmul : ∀ m : ℕ, ((m • 𝟙 ℒ_U : ℒ_U ⟶ ℒ_U).hom.app (Opposite.op U_E)) =
          m • 𝟙 (ℒ_U.obj.obj (Opposite.op U_E)) := by
        intro m
        induction m with
        | zero => rw [zero_smul, zero_smul]; rfl
        | succ m ih =>
            rw [succ_nsmul, succ_nsmul]
            change (m • 𝟙 ℒ_U).hom.app (Opposite.op U_E) + (𝟙 ℒ_U : ℒ_U ⟶ ℒ_U).hom.app (Opposite.op U_E) = _
            rw [ih]
            rfl
      rw [h_app_nsmul n]
      apply AddCommGrpCat.ext
      intro a
      have ha0 : n • a = 0 := by
        apply ULift.ext
        change n • a.down = 0
        rw [nsmul_eq_mul, CharP.cast_eq_zero (ZMod n) n, zero_mul]
      change ((n • 𝟙 (ℒ_U.obj.obj (Opposite.op U_E))).hom)
        ((CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 ℒ_U)).hom a) = 0
      have h_id_smul : ∀ (M : AddCommGrpCat.{u}) (m : ℕ) (x : M),
          (m • 𝟙 M : M ⟶ M).hom x = m • x := by
        intro M m x
        induction m with
        | zero => rw [zero_smul, zero_smul]; rfl
        | succ m ih =>
            rw [succ_nsmul, succ_nsmul]
            change (m • 𝟙 M : M ⟶ M).hom x + x = m • x + x
            rw [ih]
      rw [h_id_smul, ← map_nsmul, ha0, map_zero]

    let 𝒩 := CategoryTheory.Limits.kernel c₀
    let i_𝒩 := CategoryTheory.Limits.kernel.ι c₀
    have hTor_𝒩 : n • CategoryTheory.CategoryStruct.id 𝒩 = 0 := by
      rw [← CategoryTheory.cancel_mono i_𝒩, CategoryTheory.Limits.zero_comp]
      have h_comm_nsmul : ∀ m : ℕ, (m • 𝟙 𝒩 : 𝒩 ⟶ 𝒩) ≫ i_𝒩 = i_𝒩 ≫ (m • 𝟙 ℒ_U : ℒ_U ⟶ ℒ_U) := by
        intro m
        induction m with
        | zero => rw [zero_smul, zero_smul, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
        | succ m ih =>
            rw [succ_nsmul, succ_nsmul, CategoryTheory.Preadditive.add_comp,
              CategoryTheory.Preadditive.comp_add, ih, CategoryTheory.Category.id_comp,
              CategoryTheory.Category.comp_id]
      rw [h_comm_nsmul n, hTor_LU, CategoryTheory.Limits.comp_zero]

    have hS_c : (CategoryTheory.ShortComplex.mk i_𝒩 c₀ (CategoryTheory.Limits.kernel.condition c₀)).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_kernel c₀) inferInstance hEpi_c₀

    let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_Z := (CategoryTheory.constantSheaf Z_sch.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    have hSubLZ : Subsingleton (L_Z.H q) := by
      refine ⟨fun x₁ x₂ => ?_⟩
      let p_inv := (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.inv).postcomp Fℤ_Z (Nat.add_zero q)
      have h_eq : p_inv x₁ = p_inv x₂ := Subsingleton.elim _ _
      calc x₁
        _ = x₁.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 L_Z)) (Nat.add_zero q) :=
            (CategoryTheory.Abelian.Ext.comp_mk₀_id x₁).symm
        _ = x₁.comp (CategoryTheory.Abelian.Ext.mk₀ (Φ_Z.inv ≫ Φ_Z.hom)) (Nat.add_zero q) := by
            rw [Φ_Z.inv_hom_id]
        _ = (p_inv x₁).comp (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.hom) (Nat.add_zero q) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero x₁
                (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.inv) (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.hom)
                (Nat.add_zero q)]
            rfl
        _ = (p_inv x₂).comp (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.hom) (Nat.add_zero q) := by
            rw [h_eq]
        _ = x₂.comp (CategoryTheory.Abelian.Ext.mk₀ (Φ_Z.inv ≫ Φ_Z.hom)) (Nat.add_zero q) := by
            change (x₂.comp (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.inv) (Nat.add_zero q)).comp
                (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.hom) (Nat.add_zero q) = _
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero x₂
                (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.inv) (CategoryTheory.Abelian.Ext.mk₀ Φ_Z.hom)
                (Nat.add_zero q)]
        _ = x₂ := by
            rw [Φ_Z.inv_hom_id]
            exact CategoryTheory.Abelian.Ext.comp_mk₀_id x₂

    have hSubPushLZ : Subsingleton ((P_push_Z.obj L_Z).H q) :=
      hSubPush (hLocConstIsSheaf Z_sch) hSubLZ
    have hSubKer : Subsingleton (𝒩.H (q + 1)) :=
      hCD_S 𝒩 hTor_𝒩

    intro y
    let y_lc : L_S.H q := y.comp (CategoryTheory.Abelian.Ext.mk₀ Φ_S.hom) (Nat.add_zero q)
    have hy_π : y_lc.comp (CategoryTheory.Abelian.Ext.mk₀ π_lc) (Nat.add_zero q) = 0 :=
      @Subsingleton.elim _ hSubPushLZ _ 0
    obtain ⟨x₁, hx₁⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_S hS_lc y_lc hy_π
    have hx₁_δ : x₁.comp hS_c.extClass rfl = 0 :=
      @Subsingleton.elim _ hSubKer _ 0
    obtain ⟨z, hz⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_S hS_c x₁ rfl hx₁_δ
    refine ⟨z, ?_⟩
    change z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S n U_E)) (Nat.add_zero q) = y
    calc z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S n U_E)) (Nat.add_zero q)
      _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (c₀ ≫ (ι_lc ≫ Φ_S.inv))) (Nat.add_zero q) := by
            rw [hc₀_counit]
      _ = (z.comp (CategoryTheory.Abelian.Ext.mk₀ c₀) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (ι_lc ≫ Φ_S.inv)) (Nat.add_zero q) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero z
                (CategoryTheory.Abelian.Ext.mk₀ c₀)
                (CategoryTheory.Abelian.Ext.mk₀ (ι_lc ≫ Φ_S.inv)) (Nat.add_zero q)]
      _ = x₁.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_lc ≫ Φ_S.inv)) (Nat.add_zero q) := by
            rw [hz]
      _ = (x₁.comp (CategoryTheory.Abelian.Ext.mk₀ ι_lc) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ Φ_S.inv) (Nat.add_zero q) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero x₁
                (CategoryTheory.Abelian.Ext.mk₀ ι_lc)
                (CategoryTheory.Abelian.Ext.mk₀ Φ_S.inv) (Nat.add_zero q)]
      _ = (y.comp (CategoryTheory.Abelian.Ext.mk₀ Φ_S.hom) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ Φ_S.inv) (Nat.add_zero q) := by
            rw [hx₁]
      _ = y.comp (CategoryTheory.Abelian.Ext.mk₀ (Φ_S.hom ≫ Φ_S.inv)) (Nat.add_zero q) := by
            rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero y
                (CategoryTheory.Abelian.Ext.mk₀ Φ_S.hom)
                (CategoryTheory.Abelian.Ext.mk₀ Φ_S.inv) (Nat.add_zero q),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = y := by
            rw [Φ_S.hom_inv_id]
            exact CategoryTheory.Abelian.Ext.comp_mk₀_id y

  
  
  
  rcases hCoord with ⟨_, _, _, _, _, _, _, _, hCoord_all⟩
  rcases hCoord_all d with ⟨hProp_Pd, hInt_Pd, hSm_Pd, _⟩
  rcases hTrace with ⟨_, hBij_trPd, hVan_Pd, _⟩
  let P_d := weilPolyP1Over k d
