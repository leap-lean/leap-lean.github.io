  let U_g₂₀ : P_d.left.Opens := j_Ug₂₀.opensRange
  obtain ⟨_, ⟨pt_V10⟩⟩ := h_chart_cancel g₁₀ _hg₁₀ ψ₁ g_map_1 hψ₁_inj hg₁_ov hj_W_g₁ hFin_10
  obtain ⟨_, ⟨pt_V20⟩⟩ := h_chart_cancel g₂₀ _hg₂₀ ψ₂ g_map_2 hψ₂_inj hg₂_ov hj_W_g₂ hFin_20
  let V_12_0 : Γ.left.Opens :=
