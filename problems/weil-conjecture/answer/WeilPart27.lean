      hS3.2.2.2.1 f g f' g'
  have hbc_iso := hS3.2.2.2.2
  clear hS3

  
  
  
  let rec hTraces :
      let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
      let J_k := S_k.smallEtaleTopology
      let T_0 : S_k.Etale := weilEtaleIdTerminal.{u} S_k
      let hT_0 : CategoryTheory.Limits.IsTerminal T_0 := weilEtaleIdTerminalIsTerminal.{u} S_k
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
      let pb_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
        @CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
      let p₁ : Quiver.Hom P₁_ov.left S_k := P₁_ov.hom
      let T_1 : P₁_ov.left.Etale := (weilEtaleSitePullback p₁).obj T_0
      let R2_1 := weilEtaleHigherDirectImage p₁ 2 (weilEtaleTorsionSheaf P₁_ov.left n)
      let P_F1 := CategoryTheory.Functor.comp (weilEtaleSitePullback p₁).op
        (CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf P₁_ov.left n) 2)
      let η_sh_p₁ := (CategoryTheory.sheafificationAdjunction J_k AddCommGrpCat.{u}).unit.app P_F1
      let adj_0 := CategoryTheory.constantSheafAdj J_k AddCommGrpCat.{u} hT_0
      let η_AM : AM ⟶ (weilEtaleTorsionSheaf S_k n).obj.obj (Opposite.op T_0) := adj_0.unit.app AM
      let πM_of : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
          Quiver.Hom ((pb_of h).obj (weilEtaleTorsionSheaf Z₂ n)) (weilEtaleTorsionSheaf Z₁ n) :=
        fun {Z₁ Z₂} h =>
          @weilEtaleConstPullbackHom Z₁ Z₂ h (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
