        sheaf_hom_ext h_rt
      have h_inv_hom : CategoryTheory.CategoryStruct.comp ε_P e_hom = CategoryTheory.CategoryStruct.id G_P := by
        apply (adj.homEquiv P G_P).injective
        rw [adj.homEquiv_unit, adj.homEquiv_unit]
