    rw [hV12_eq]; exact Set.inter_subset_right

  
  have hPkg_M₁ : ∃ (M₁ : Type u) (hAdd : AddCommGroup M₁) (hMod : Module (Localization.Away g₁) M₁),
      letI := hAdd; letI := hMod
      ∃ (_bM₁ : Module.Basis (Fin m₁) (Localization.Away g₁) M₁)
        (eM₁ : M₁ ≃+ Localization.Away (ψ₁ g₁)),
        (∀ (b : Localization.Away g₁) (x : M₁),
          eM₁ (b • x) = Localization.awayMap ψ₁ g₁ b * eM₁ x) ∧
        ∀ (Q : Type u) [CommRing Q] (θ : Localization.Away g₁ →+* Q),
          let algBQ : Algebra (Localization.Away g₁) Q := θ.toAlgebra
          let algBA : Algebra (Localization.Away g₁) (Localization.Away (ψ₁ g₁)) :=
            (Localization.awayMap ψ₁ g₁).toAlgebra
          letI := algBQ; letI := algBA
          let B_Q : Type u := TensorProduct (Localization.Away g₁) Q (Localization.Away (ψ₁ g₁))
          let φ_Q : Q →+* B_Q := Algebra.TensorProduct.includeLeftRingHom
          ∃ (M_s : Type u) (hAdd_s : AddCommGroup M_s) (hMod_s : Module Q M_s),
            letI := hAdd_s; letI := hMod_s
            ∃ (_b_s : Module.Basis (Fin m₁) Q M_s) (e_s : M_s ≃+ B_Q),
              ∀ (q : Q) (x : M_s), e_s (q • x) = φ_Q q * e_s x := by
    rw [hg₁_eq]
    exact ⟨M₁_raw, hAdd_M₁_raw, hMod_M₁_raw, bM₁_raw, eM₁_raw, heM₁_raw, hTens₁_raw⟩
  obtain ⟨M₁, hAdd_M₁, hMod_M₁, bM₁, eM₁, heM₁, hTens₁⟩ := hPkg_M₁
  have hPkg_M₂ : ∃ (M₂ : Type u) (hAdd : AddCommGroup M₂) (hMod : Module (Localization.Away g₂) M₂),
      letI := hAdd; letI := hMod
      ∃ (_bM₂ : Module.Basis (Fin m₂) (Localization.Away g₂) M₂)
        (eM₂ : M₂ ≃+ Localization.Away (ψ₂ g₂)),
        (∀ (b : Localization.Away g₂) (x : M₂),
          eM₂ (b • x) = Localization.awayMap ψ₂ g₂ b * eM₂ x) ∧
        ∀ (Q : Type u) [CommRing Q] (θ : Localization.Away g₂ →+* Q),
          let algBQ : Algebra (Localization.Away g₂) Q := θ.toAlgebra
          let algBA : Algebra (Localization.Away g₂) (Localization.Away (ψ₂ g₂)) :=
            (Localization.awayMap ψ₂ g₂).toAlgebra
          letI := algBQ; letI := algBA
          let B_Q : Type u := TensorProduct (Localization.Away g₂) Q (Localization.Away (ψ₂ g₂))
          let φ_Q : Q →+* B_Q := Algebra.TensorProduct.includeLeftRingHom
          ∃ (M_s : Type u) (hAdd_s : AddCommGroup M_s) (hMod_s : Module Q M_s),
            letI := hAdd_s; letI := hMod_s
            ∃ (_b_s : Module.Basis (Fin m₂) Q M_s) (e_s : M_s ≃+ B_Q),
              ∀ (q : Q) (x : M_s), e_s (q • x) = φ_Q q * e_s x := by
    rw [hg₂_eq]
    exact ⟨M₂_raw, hAdd_M₂_raw, hMod_M₂_raw, bM₂_raw, eM₂_raw, heM₂_raw, hTens₂_raw⟩
  obtain ⟨M₂, hAdd_M₂, hMod_M₂, bM₂, eM₂, heM₂, hTens₂⟩ := hPkg_M₂
  let _ : AddCommGroup M₁ := hAdd_M₁
  let _ : Module (Localization.Away g₁) M₁ := hMod_M₁
  let _ : AddCommGroup M₂ := hAdd_M₂
  let _ : Module (Localization.Away g₂) M₂ := hMod_M₂

  have hj_Γ₁_P : j_Γ₁ ≫ g_map_1 =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ₁ g₁)) ≫
        (iso_Ug₁.inv ≫ U_g₁.ι) := by
    dsimp [iso_Ug₁, U_g₁]
    rw [j_Ug₁.isoOpensRange_hom_ι]
    dsimp [j_Γ₁, j_Ug₁]
    rw [CategoryTheory.Category.assoc, hj_W_g₁]
    dsimp [u₁]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    change algebraMap A_W (Localization.Away (ψ₁ g₁)) (ψ₁ r) =
      Localization.awayMap ψ₁ g₁ (algebraMap R₀ (Localization.Away g₁) r)
    exact (IsLocalization.map_eq _ r).symm
  have hj_Γ₂_P : j_Γ₂ ≫ g_map_2 =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Localization.awayMap ψ₂ g₂)) ≫
        (iso_Ug₂.inv ≫ U_g₂.ι) := by
    dsimp [iso_Ug₂, U_g₂]
    rw [j_Ug₂.isoOpensRange_hom_ι]
    dsimp [j_Γ₂, j_Ug₂]
    rw [CategoryTheory.Category.assoc, hj_W_g₂]
    dsimp [u₂]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    change algebraMap A_W (Localization.Away (ψ₂ g₂)) (ψ₂ r) =
      Localization.awayMap ψ₂ g₂ (algebraMap R₀ (Localization.Away g₂) r)
    exact (IsLocalization.map_eq _ r).symm

  
  refine ⟨{
    g₁ := g₁
    g₂ := g₂
    hg₁ := hg₁
    hg₂ := hg₂
    hm₁ := _hm₁
    hm₂ := _hm₂
    M₁ := M₁
    bM₁ := bM₁
    eM₁ := eM₁
    M₂ := M₂
    bM₂ := bM₂
    eM₂ := eM₂
    O_m := O_m
    Γ := Γ
    hProp_Γ := hProp_Γ
    hInt_Γ := hInt_Γ
    hDim_Γ := hDim_Γ
    π_Y := π_Y
    g_map_1 := g_map_1
    g_map_2 := g_map_2
    h_Wf := h_Wf
    U_g₁ := U_g₁
    U_g₂ := U_g₂
    iso_Ug₁ := iso_Ug₁
    iso_Ug₂ := iso_Ug₂
    j_Γ₁ := j_Γ₁
    j_Y₁ := j_Y₁
    j_Γ₂ := j_Γ₂
    j_Y₂ := j_Y₂
    heM₁ := heM₁
    heM₂ := heM₂
    hπ_Y_ov := hπ_Y_ov
    hg₁_ov := hg₁_ov
    hg₂_ov := hg₂_ov
    hh_Wf_ov := hh_Wf_ov
    hg₁_π₁ := hg₁_π₁
    hg₂_π₁ := hg₂_π₁
    hiso_Ug₁ := j_Ug₁.isoOpensRange_hom_ι
    hj_Γ₁_open := inferInstance
    hj_Y₁_open := inferInstance
    hj_Y₁_eq := rfl
    hj_Γ₁_Y := by
      dsimp [j_Γ₁, j_Y₁]
      rw [CategoryTheory.Category.assoc, hj_W_πY]
    hj_Γ₁_P := hj_Γ₁_P
    hj_Γ₁_range := hj_Γ₁_range
    hiso_Ug₂ := j_Ug₂.isoOpensRange_hom_ι
    hj_Γ₂_open := inferInstance
    hj_Y₂_open := inferInstance
    hj_Y₂_eq := rfl
    hj_Γ₂_Y := by
      dsimp [j_Γ₂, j_Y₂]
      rw [CategoryTheory.Category.assoc, hj_W_πY]
    hj_Γ₂_P := hj_Γ₂_P
    hj_Γ₂_range := hj_Γ₂_range
    hV12_sub := hV12_sub
    hDim_Z12 := hDim_Z12
    hFib_pkg := ?_ }⟩

  intro s hs_sec hs_Om ι_s hι_s_π₁ hι_s_π₂
  let C_s := CategoryTheory.Limits.pullback h_Wf s
  let ι_Cs := CategoryTheory.Limits.pullback.fst h_Wf s
  let p₂_Cs := CategoryTheory.Limits.pullback.snd h_Wf s
  let V_s : C_s.Opens := (TopologicalSpace.Opens.map ι_Cs.base).obj V_12
  let g₁_s := ι_Cs ≫ (g_map_1 ≫ π₂)
  let g₂_s := ι_Cs ≫ (g_map_2 ≫ π₂)

  
  have : AlgebraicGeometry.IsClosedImmersion (s ≫ P_m.hom) := by rw [hs_sec]; infer_instance
  have hs_closed : AlgebraicGeometry.IsClosedImmersion s :=
    AlgebraicGeometry.IsClosedImmersion.of_comp s P_m.hom
  have hι_Cs_closed : AlgebraicGeometry.IsClosedImmersion ι_Cs := inferInstance
  have hAff_Vs : AlgebraicGeometry.IsAffineOpen V_s := hAff_V12.preimage ι_Cs
  have : AlgebraicGeometry.IsProper h_Wf := by
    have : AlgebraicGeometry.IsProper (h_Wf ≫ P_m.hom) := by rw [hh_Wf_ov]; infer_instance
    exact AlgebraicGeometry.IsProper.of_comp h_Wf P_m.hom
  have : AlgebraicGeometry.IsProper p₂_Cs := inferInstance
  have hπ₂_ov : π₂ ≫ P₁_ov.hom = P_d.hom := hPb_Pd.w.symm.trans hπ₁_ov
  have hι_Cs_ov : ι_Cs ≫ Γ.hom = p₂_Cs := by
    calc
      ι_Cs ≫ Γ.hom = ι_Cs ≫ (h_Wf ≫ P_m.hom) := by rw [hh_Wf_ov]
      _ = (ι_Cs ≫ h_Wf) ≫ P_m.hom := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (p₂_Cs ≫ s) ≫ P_m.hom := by rw [CategoryTheory.Limits.pullback.condition]
      _ = p₂_Cs ≫ (s ≫ P_m.hom) := CategoryTheory.Category.assoc _ _ _
      _ = p₂_Cs := by rw [hs_sec, CategoryTheory.Category.comp_id]
  have hg₁_s_p₂ : g₁_s ≫ P₁_ov.hom = p₂_Cs := by
    dsimp [g₁_s]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hπ₂_ov, hg₁_ov, hι_Cs_ov]
  have hg₂_s_p₂ : g₂_s ≫ P₁_ov.hom = p₂_Cs := by
    dsimp [g₂_s]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hπ₂_ov, hg₂_ov, hι_Cs_ov]
  have hProp_g₁s : AlgebraicGeometry.IsProper (g₁_s ≫ P₁_ov.hom) := by
    rw [hg₁_s_p₂]; infer_instance
  have hg12_s_eq : g₁_s ≫ P₁_ov.hom = g₂_s ≫ P₁_ov.hom := hg₁_s_p₂.trans hg₂_s_p₂.symm

  
  have hPb_s : CategoryTheory.IsPullback ι_s P₁_ov.hom π₁ s := by
    have h_outer : CategoryTheory.IsPullback (ι_s ≫ π₂) P₁_ov.hom P₁_ov.hom (s ≫ P_m.hom) := by
      rw [hι_s_π₂, hs_sec]
      exact CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
    exact CategoryTheory.IsPullback.of_right h_outer hι_s_π₁ hPb_Pd.flip
  have h_g₁_sq : ι_Cs ≫ g_map_1 = g₁_s ≫ ι_s := by
    apply hPb_Pd.hom_ext
    · rw [CategoryTheory.Category.assoc, hg₁_π₁, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, hι_s_π₁, ← CategoryTheory.Category.assoc, hg₁_s_p₂]
    · rw [CategoryTheory.Category.assoc g₁_s ι_s π₂, hι_s_π₂, CategoryTheory.Category.comp_id]
      exact CategoryTheory.Category.assoc ι_Cs g_map_1 π₂
  have h_g₂_sq : ι_Cs ≫ g_map_2 = g₂_s ≫ ι_s := by
    apply hPb_Pd.hom_ext
    · rw [CategoryTheory.Category.assoc, hg₂_π₁, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, hι_s_π₁, ← CategoryTheory.Category.assoc, hg₂_s_p₂]
    · rw [CategoryTheory.Category.assoc g₂_s ι_s π₂, hι_s_π₂, CategoryTheory.Category.comp_id]
      exact CategoryTheory.Category.assoc ι_Cs g_map_2 π₂
  have hPb_Cs₁ : CategoryTheory.IsPullback ι_Cs g₁_s g_map_1 ι_s := by
    have h_tot : CategoryTheory.IsPullback ι_Cs (g₁_s ≫ P₁_ov.hom) (g_map_1 ≫ π₁) s := by
      rw [hg₁_s_p₂, hg₁_π₁]
      exact CategoryTheory.IsPullback.of_hasPullback h_Wf s
    exact CategoryTheory.IsPullback.of_bot h_tot h_g₁_sq hPb_s
  have hPb_Cs₂ : CategoryTheory.IsPullback ι_Cs g₂_s g_map_2 ι_s := by
    have h_tot : CategoryTheory.IsPullback ι_Cs (g₂_s ≫ P₁_ov.hom) (g_map_2 ≫ π₁) s := by
      rw [hg₂_s_p₂, hg₂_π₁]
      exact CategoryTheory.IsPullback.of_hasPullback h_Wf s
    exact CategoryTheory.IsPullback.of_bot h_tot h_g₂_sq hPb_s

  
  have hs_sub_Om : Set.range s.base ⊆ Set.range j_Om.base := by
    rintro _ ⟨pt, rfl⟩; exact hs_Om pt
  let s_loc : S_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_B)) :=
    AlgebraicGeometry.IsOpenImmersion.lift j_Om s hs_sub_Om
  have hs_loc_fac : s_loc ≫ j_Om = s := AlgebraicGeometry.IsOpenImmersion.lift_fac j_Om s hs_sub_Om
  let ev_loc_hom : Localization.Away h_B →+* k := (AlgebraicGeometry.Spec.preimage s_loc).hom
  obtain ⟨ev_s, hev_s_eq⟩ : ∃ f : R_base →ₐ[k] k, f =
      { toRingHom := ev_loc_hom.comp (algebraMap R_base (Localization.Away h_B))
        commutes' := fun c => by
          have h1 : s_loc ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((algebraMap R_base (Localization.Away h_B)).comp MvPolynomial.C)) =
              𝟙 S_k := by
            rw [← hs_sec, ← hs_loc_fac]
            dsimp [j_Om]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hι_m'_ov,
              ← AlgebraicGeometry.Spec.map_comp]
          have h2 : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage s_loc) = s_loc :=
            AlgebraicGeometry.Spec.map_preimage s_loc
          rw [← h2, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id] at h1
          have h3 := AlgebraicGeometry.Spec.map_injective h1
          exact congrArg (fun φ => φ.hom c) h3 } := ⟨_, rfl⟩
  have hev_s_hB : ev_s h_B ≠ 0 := by
    have hu : IsUnit (ev_s h_B) := by
      rw [hev_s_eq]
      exact (IsLocalization.Away.algebraMap_isUnit h_B).map ev_loc_hom
    exact hu.ne_zero
  have hs_spec_eq : s = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_s.toRingHom) ≫ ι_m' := by
    rw [← hs_loc_fac]
    dsimp [j_Om]
    rw [← CategoryTheory.Category.assoc]
    congr 1
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_loc_hom) = s_loc :=
      AlgebraicGeometry.Spec.map_preimage s_loc
    rw [← hmap, ← AlgebraicGeometry.Spec.map_comp, hev_s_eq]
    rfl

  obtain ⟨hq₁_ne_raw, hq₂_ne_raw, h_no_chain⟩ := hh_B_spec ev_s hev_s_hB
  obtain ⟨eval_s, heval_s_eq⟩ : ∃ f : R₀ →ₐ[k] Polynomial k, f =
      MvPolynomial.aeval (fun j : Fin d =>
        Fin.lastCases (Polynomial.X : Polynomial k)
          (fun i : Fin m => Polynomial.C (ev_s (MvPolynomial.X i)))
          (Fin.cast hmd.symm j)) := ⟨_, rfl⟩
  obtain ⟨q₁, hq₁_eq⟩ : ∃ q : Polynomial k, q = eval_s g₁ := ⟨_, rfl⟩
  obtain ⟨q₂, hq₂_eq⟩ : ∃ q : Polynomial k, q = eval_s g₂ := ⟨_, rfl⟩
  have hq₁_ne : q₁ ≠ 0 := by rw [hq₁_eq, heval_s_eq, hg₁_eq]; exact hq₁_ne_raw
  have hq₂_ne : q₂ ≠ 0 := by rw [hq₂_eq, heval_s_eq, hg₂_eq]; exact hq₂_ne_raw

  
  let f_s : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom eval_s.toRingHom)
  have hf_s_comm : f_s ≫ ι_d' = ι_1 ≫ ι_s := by
    apply hPb_Pd.hom_ext
    · dsimp [f_s]
      rw [CategoryTheory.Category.assoc, hι_d'_π₁, CategoryTheory.Category.assoc, hι_s_π₁,
        ← CategoryTheory.Category.assoc ι_1 P₁_ov.hom s, hι_1_ov, hs_spec_eq,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      apply CommRingCat.hom_ext
      have halg : eval_s.comp π_head = (Polynomial.CAlgHom (R := k) (A := k)).comp ev_s := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [heval_s_eq]
        change (MvPolynomial.aeval _) (π_head (MvPolynomial.X i)) = Polynomial.C (ev_s (MvPolynomial.X i))
        dsimp [π_head]
        rw [MvPolynomial.rename_X, MvPolynomial.aeval_X]
        have hc : Fin.cast hmd.symm (Fin.cast hmd i.castSucc) = i.castSucc := by ext; rfl
        rw [hc, Fin.lastCases_castSucc]
      exact congrArg AlgHom.toRingHom halg
    · dsimp [f_s]
      rw [CategoryTheory.Category.assoc, hι_d'_π₂, CategoryTheory.Category.assoc, hι_s_π₂,
        CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp]
      refine Eq.trans ?_ (CategoryTheory.Category.id_comp ι_1)
      congr 1
      rw [← AlgebraicGeometry.Spec.map_id]
      congr 1
      apply CommRingCat.hom_ext
      have hcomp : eval_s.comp
          (Polynomial.aeval (R := k)
            (MvPolynomial.X (Fin.cast hmd (Fin.last m)) : MvPolynomial (Fin d) k)) =
          AlgHom.id k (Polynomial k) := by
        apply Polynomial.algHom_ext
        rw [heval_s_eq]
        change (MvPolynomial.aeval _)
          ((Polynomial.aeval (R := k)
            (MvPolynomial.X (Fin.cast hmd (Fin.last m)) : MvPolynomial (Fin d) k))
            Polynomial.X) = Polynomial.X
        rw [Polynomial.aeval_X, MvPolynomial.aeval_X]
        have hc : Fin.cast hmd.symm (Fin.cast hmd (Fin.last m)) = Fin.last m := by ext; rfl
        rw [hc, Fin.lastCases_last]
      exact congrArg AlgHom.toRingHom hcomp

  have h_ιs_preimage : ∀ (g : R₀) (q : Polynomial k), q = eval_s g →
      let U_g : P_d.left.Opens :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) ≫ ι_d').opensRange
      let j_Us := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away q))) ≫ ι_1
      Set.range j_Us.base = ((TopologicalSpace.Opens.map ι_s.base).obj U_g : Set ↥P₁_ov.left) := by
    intro g q hqg U_g j_Us
    let mor_g := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g)))
    let mor_q := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away q)))
    ext y
    constructor
    · rintro ⟨p_q, rfl⟩
      have hp_not : q ∉ (PrimeSpectrum.comap
          (algebraMap (Polynomial k) (Localization.Away q)) p_q).asIdeal := by
        have hmem : PrimeSpectrum.comap (algebraMap (Polynomial k) (Localization.Away q)) p_q ∈
            Set.range (PrimeSpectrum.comap (algebraMap (Polynomial k) (Localization.Away q))) :=
          ⟨p_q, rfl⟩
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away q) q] at hmem
        exact hmem
      let p_poly := mor_q.base p_q
      have hg_not : g ∉ (f_s.base p_poly).asIdeal := by
        have hf_app : f_s.base p_poly = PrimeSpectrum.comap eval_s.toRingHom p_poly :=
          AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom eval_s.toRingHom) p_poly
        rw [hf_app]
        change eval_s g ∉ p_poly.asIdeal
        have hp_app : p_poly =
            PrimeSpectrum.comap (algebraMap (Polynomial k) (Localization.Away q)) p_q :=
          AlgebraicGeometry.Spec.map_apply
            (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away q))) p_q
        rw [← hqg, hp_app]
        exact hp_not
      have hf_mem : f_s.base p_poly ∈
          Set.range (PrimeSpectrum.comap (algebraMap R₀ (Localization.Away g))) := by
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away g) g]
        exact hg_not
      rcases hf_mem with ⟨p_g, hp_g⟩
      let p_g' : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))) := p_g
      refine ⟨p_g', ?_⟩
      change (mor_g ≫ ι_d').base p_g' = ι_s.base ((mor_q ≫ ι_1).base p_q)
      have h_pg_app : mor_g.base p_g' = f_s.base p_poly :=
        (AlgebraicGeometry.Spec.map_apply
          (CommRingCat.ofHom (algebraMap R₀ (Localization.Away g))) p_g').trans hp_g
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply mor_g ι_d' p_g', h_pg_app,
        ← AlgebraicGeometry.Scheme.Hom.comp_apply f_s ι_d' p_poly, hf_s_comm,
        AlgebraicGeometry.Scheme.Hom.comp_apply ι_1 ι_s p_poly,
        AlgebraicGeometry.Scheme.Hom.comp_apply mor_q ι_1 p_q]
    · rintro ⟨p_g, hp_g_eq⟩
      let p_d := mor_g.base p_g
      have hp_g_eq' : ι_d'.base p_d = ι_s.base y := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply mor_g ι_d' p_g]
        exact hp_g_eq
      have hy_π₂ : y = (ι_d' ≫ π₂).base p_d := by
        calc
