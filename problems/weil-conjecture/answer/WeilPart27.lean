        have hpt_eq := hOpen_m.base_open.injective hmap_q'
        exact congrArg PrimeSpectrum.asIdeal hpt_eq
      have hq₀_H1 : (⟨I₀, hI₀_p⟩ : PrimeSpectrum (C_cov α)) ∈ (H₁ : Set (PrimeSpectrum (C_cov α))) := by
        apply le_of_lt hH_lt
        change (⟨I₀, hI₀_p⟩ : PrimeSpectrum (C_cov α)) ∈ (H₀ : Set (PrimeSpectrum (C_cov α)))
