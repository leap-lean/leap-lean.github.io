            have h4 : ψ_rs (algebraMap R₂ C₂ a₂) = algebraMap R₁ C₁ (φ₂₁ a₂) :=
              h_away_eq φ₂₁ (r * s) a₂
            rw [h1, h2, h3, h4]
          have hcomm_s : β_s.comp (Localization.awayMap φ₂₁ s) = ψ_rs.comp α_s := by
            apply IsLocalization.ringHom_ext (Submonoid.powers s)
            ext a₂
            simp only [RingHom.comp_apply]
            have h1 : (Localization.awayMap φ₂₁ s) (algebraMap R₂ (Localization.Away s) a₂) =
