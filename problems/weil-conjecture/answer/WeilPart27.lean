              h_away_eq φ₂₁ s a₂
            have h2 : β_s (algebraMap R₁ (Localization.Away (φ₂₁ s)) (φ₂₁ a₂)) =
                algebraMap R₁ C₁ (φ₂₁ a₂) :=
              IsLocalization.Away.lift_eq (φ₂₁ s) hφs_unit_C₁ (φ₂₁ a₂)
            have h3 : α_s (algebraMap R₂ (Localization.Away s) a₂) = algebraMap R₂ C₂ a₂ :=
