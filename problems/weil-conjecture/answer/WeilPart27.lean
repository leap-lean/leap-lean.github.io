    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, ← hhomeo]
    exact le_trans (topologicalKrullDim_subspace_le Z₀_ov.left (U_cov α : Set ↥Z₀_ov.left)) hDim_Z₀
  have h_lift_cov : ∀ α : Fin r_cov,
      Set.range ((hAff_cov α).fromSpec ≫ h_Z₀).base ⊆ Set.range ι_m'.base := by
    rintro α _ ⟨q, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply (hAff_cov α).fromSpec h_Z₀ q]
    have hq_mem : (hAff_cov α).fromSpec.base q ∈ U_cov α := by
