    hPart5_6 P_d.left n (2 * d) U_E W₀ (by ext x; rfl) hCont_Z
      (fun hShZ hSubLZ =>
        hPart4_crux I_Z.subschemeι hCont_Z hInj_Z hTerm_Z
          ⟨weilAltLocConstPresheaf I_Z.subscheme n, hShZ⟩ (2 * d) hSubLZ)
      hSubZ
      (fun F hF => hVan_Pd d F (2 * d + 1) hF (Nat.lt_succ_self (2 * d)))
  exact (hBij_trPd d).surjective.comp hSurj_counit

