            (fun z₂ : { z : { z : ↥(B.obj U₂).left //
                IsClosed ({(B.obj U₂).hom.base z} : Set ↥C.left) } //
              (CategoryTheory.Limits.pullback.fst U₂.hom u).base z.1 = y₂.1 } =>
              valDiv_C (B.obj U₂) d z₂.1) :=
          Equiv.sum_comp e_G (fun z₂ => valDiv_C (B.obj U₂) d z₂.1)
  let u_div : P_push.obj Div_sh_C ⟶ Div_sh_1 :=
    { hom :=
        { app := fun opU => u_div_app (Opposite.unop opU)
          naturality := fun _ _ g => (hu_div_nat g.unop).symm } }
  refine ⟨hClosed_iff, hFib_fin, u_div, ?_, ?_⟩
