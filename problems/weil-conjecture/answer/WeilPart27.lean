theorem weil_top_deg_kummer_last_coord_curve_norm_invariance (k : Type u) [Field k] [IsAlgClosed k]
    (m d : ℕ) (hmd : m + 1 = d)
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (hCD : ∀ (m₀ q : ℕ)
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper Z.hom],
      topologicalKrullDim Z.left ≤ (m₀ : WithBot ℕ∞) →
      2 * m₀ < q →
      Subsingleton (weilEtaleTorsionH Z.left n q))
    (hGenFree : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
      (w : Fin d → A),
      IsTranscendenceBasis k w →
      let ψ : MvPolynomial (Fin d) k →ₐ[k] A := MvPolynomial.aeval w
      ∃ (g : MvPolynomial (Fin d) k) (m_w : ℕ),
        g ≠ 0 ∧
        1 ≤ m_w ∧
        let B_g := Localization.Away g
        let A_g := Localization.Away (ψ g)
        let ψ_g : B_g →+* A_g := Localization.awayMap ψ.toRingHom g
        ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module B_g M)
          (e : M ≃+ A_g),
          (∀ (b : B_g) (x : M), e (b • x) = ψ_g b * e x) ∧
          Nonempty (Module.Basis (Fin m_w) B_g M))
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilTopDegKummerPolyP1CoordPkg k ι_P1 ι_aff)
    (tr_P1 : weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left n 2 →+ ZMod n)
    (tr_Pd : ∀ δ : ℕ,
      weilEtaleTorsionH (weilPolyP1Over k δ).left n (2 * δ) →+ ZMod n)
    (hTrace : WeilTopDegKummerPolyP1TracePkg k n ζ ι_P1 tr_P1 tr_Pd)
    (F_push : WeilTopDegKummerChartPushFn k d n)
    (hPush : WeilTopDegKummerChartPushPkg k d n ζ ι_aff F_push)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    [AlgebraicGeometry.IsProper Y.hom]
    (hDimY : topologicalKrullDim Y.left = (d : WithBot ℕ∞))
    (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W)
    (w₁ w₂ : Fin d → ↑(Y.left.presheaf.obj (Opposite.op W)))
    (hw₁ : @IsTranscendenceBasis (Fin d) k ↑(Y.left.presheaf.obj (Opposite.op W)) _ _
      (RingHom.toAlgebra (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))) w₁)
    (hw₂ : @IsTranscendenceBasis (Fin d) k ↑(Y.left.presheaf.obj (Opposite.op W)) _ _
      (RingHom.toAlgebra (CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))) w₂)
    (hAgree : ∀ j : Fin d, j ≠ Fin.cast hmd (Fin.last m) → w₁ j = w₂ j) :
    (tr_Pd d).comp (F_push Y hIntY hDimY W hW hNe w₁ hw₁) =
      (tr_Pd d).comp (F_push Y hIntY hDimY W hW hNe w₂ hw₂) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let A_W : Type u := ↑(Y.left.presheaf.obj (Opposite.op W))
  let kAlgW : Algebra k A_W :=
    RingHom.toAlgebra (CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top)))
  have hDom_AW : IsDomain A_W := by
    obtain ⟨x₀, hx₀⟩ := hNe
    have _ : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨x₀, hx₀⟩⟩
    exact @AlgebraicGeometry.IsIntegral.component_integral Y.left hIntY W inferInstance
  have hFT_AW : @Algebra.FiniteType k A_W _ _ kAlgW := by
    have h1 : RingHom.FiniteType (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ W le_top).hom :=
      Y.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hW le_top
    have h2 : RingHom.FiniteType
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
      RingHom.FiniteType.of_surjective _
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv).surjective
    exact h1.comp h2
  obtain ⟨g₁₀, m₁, hg₁₀, hm₁, M₁₀, hAdd₁₀, hMod₁₀, e₁₀, he₁₀, ⟨b₁₀⟩⟩ :=
    @hGenFree A_W _ hDom_AW kAlgW hFT_AW w₁ hw₁
  obtain ⟨g₂₀, m₂, hg₂₀, hm₂, M₂₀, hAdd₂₀, hMod₂₀, e₂₀, he₂₀, ⟨b₂₀⟩⟩ :=
    @hGenFree A_W _ hDom_AW kAlgW hFT_AW w₂ hw₂
  letI : AddCommGroup M₁₀ := hAdd₁₀
  letI : Module (Localization.Away g₁₀) M₁₀ := hMod₁₀
  letI : AddCommGroup M₂₀ := hAdd₂₀
  letI : Module (Localization.Away g₂₀) M₂₀ := hMod₂₀
  have hPush_ex := (weil_top_deg_affine_finite_free_det_pushforward k n hn hUnit ζ hζ).1
  obtain ⟨hCurveDecomp, hDvrNorm⟩ := weil_curve_artinian_mult_and_smooth_norm_valuation k
  obtain ⟨D, hSite⟩ :=
    weil_top_deg_kummer_zero_bdry_site_leray_and_baseChange k n hn hUnit ζ hζ
  have hSub_compl : ∀ (m₀ q : ℕ) (Z_ov : CategoryTheory.Over S_k)
      [AlgebraicGeometry.IsProper Z_ov.hom] (V₀ : Z_ov.left.Opens),
      topologicalKrullDim (weilAltClosedComplIdeal Z_ov.left V₀).subscheme ≤
        (m₀ : WithBot ℕ∞) →
      2 * m₀ < q →
      Subsingleton (weilEtaleTorsionH (weilAltClosedComplIdeal Z_ov.left V₀).subscheme n q) := by
    intro m₀ q Z_ov _ V₀ hDim_c hq
    let I_Z := weilAltClosedComplIdeal Z_ov.left V₀
    let Z_sub : CategoryTheory.Over S_k :=
      CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp I_Z.subschemeι Z_ov.hom)
    have _ : AlgebraicGeometry.IsProper Z_sub.hom := by
      change AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp I_Z.subschemeι Z_ov.hom)
      infer_instance
    exact hCD m₀ q Z_sub hDim_c hq
  have h_gen :
