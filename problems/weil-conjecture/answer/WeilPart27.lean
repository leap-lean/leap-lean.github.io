          (fun p hp => (hR_g1_Q p hp).1) Δ₂_1 hΔ₂_1_sec τ₁
          hg₁s_p₁ hg₁s_sq hPb_g₁ τ₁_s hτ₁_compat x₀ α_sec hα_sec
      obtain ⟨β₂_s, u₂_s, hβ₂s_leray, hu₂s_eq, hEv₂⟩ :=
        hBranch_fib g₂ hg₂_π₁ hg₂_over hAcyc_g₂ hSE_pf2_0 hSE_pf2_1
          (fun p hp => (hR_g2_Q p hp).1) Δ₂_2 hΔ₂_2_sec τ₂
          hg₂s_p₁ hg₂s_sq hPb_g₂ τ₂_s hτ₂_compat x₀ α_sec hα_sec
      have htr1_eq : tr_1 u₁_s = tr_1 u₂_s :=
        hFib_tr_clean _ β₁_s β₂_s u₁_s u₂_s hβ₁s_leray hβ₂s_leray hu₁s_eq hu₂s_eq
      change (((CategoryTheory.CategoryStruct.comp ((pb_of s).map Ψ_tilde₁) (πM_of s)).hom.app
          (Opposite.op T_0)).hom x₀) =
        (((CategoryTheory.CategoryStruct.comp ((pb_of s).map Ψ_tilde₂) (πM_of s)).hom.app
          (Opposite.op T_0)).hom x₀)
      rw [hEv₁, hEv₂, htr1_eq]

    · 
      rw [not_forall] at h_in
      obtain ⟨pt₀, hpt₀⟩ := h_in
      have : Subsingleton ↥S_k := by
        change Subsingleton (PrimeSpectrum k); infer_instance
      have hVs_empty : (V_s : Set ↥C_s) = ∅ := by
        ext c
        simp only [Set.mem_empty_iff_false, iff_false]
        intro hc
        have hc_V12 : ι_Cs.base c ∈ (V_12 : Set ↥W_top.left) := hc
        have hc_O : h_Wf.base (ι_Cs.base c) ∈ (O_δ : Set ↥P_δ.left) := hV12_sub hc_V12
        have hcomm_c : h_Wf.base (ι_Cs.base c) = s.base (p_Cs.base c) := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
            ← AlgebraicGeometry.Scheme.Hom.comp_apply, hPb_Cs.w]
        have hpt_eq : p_Cs.base c = pt₀ := Subsingleton.elim _ _
        rw [hcomm_c, hpt_eq] at hc_O
        exact hpt₀ hc_O
      let hSh_Cs₀ := hSpec.2.2.2.1 C_s V_s
      let K_Cs₀ : CategoryTheory.Sheaf C_s.smallEtaleTopology AddCommGrpCat.{u} :=
        ⟨weilAltZeroBdrySubpresheaf C_s V_s n, hSh_Cs₀⟩
      have hZero_KCs₀ : CategoryTheory.Limits.IsZero K_Cs₀ :=
        (hZeroBdry_tor_empty C_s V_s hSh_Cs₀).2 hVs_empty
      obtain ⟨ψ_ι₀, _⟩ := hZeroBdry_pull ι_Cs V_12 hSh_W hSh_Cs₀
      have hBranch_out_zero : ∀ (g : Quiver.Hom W_top.left P_succ.left)
          (hg_π₁ : CategoryTheory.CategoryStruct.comp g π₁ = h_Wf)
          (hg_over : CategoryTheory.CategoryStruct.comp g P_succ.hom = W_top.hom)
          [AlgebraicGeometry.IsProper g]
          (Δ₂ : Quiver.Hom ((pf_of π₁).obj ((pf_of g).obj Q_2))
            (weilEtaleHigherDirectImage π₁ 2 ((pf_of g).obj K_W)))
          (τ : Quiver.Hom ((pf_of g).obj K_W) L_Pd),
          let g_s := CategoryTheory.CategoryStruct.comp ι_Cs (CategoryTheory.CategoryStruct.comp g π₂)
          CategoryTheory.IsPullback ι_Cs g_s g ι_s →
          let Ψ_tilde := (θ_push g π₁ h_Wf hg_π₁ Q_2).hom ≫ Δ₂ ≫
            weilTopDegKummerHigherDirectImageMap π₁ 2 (τ ≫ Φ_Pd.inv) ≫ Tr_rel
          (CategoryTheory.CategoryStruct.comp ((pb_of s).map Ψ_tilde) (πM_of s)).hom.app
            (Opposite.op T_0) = 0 := by
        intro g hg_π₁ hg_over _ Δ₂ τ g_s hPb_g Ψ_tilde
        have : (pf_of g_s).Additive := hAdd_pf g_s
        let g_ov : W_top ⟶ P_succ := CategoryTheory.Over.homMk g hg_over
        have : AlgebraicGeometry.IsProper g_ov.left := by
          change AlgebraicGeometry.IsProper g; infer_instance
        have : CategoryTheory.IsIso (bc g ι_s g_s ι_Cs hPb_g.w 0 K_W) :=
          hbc_iso W_top P_succ g_ov ι_s g_s ι_Cs hPb_g 0 K_W hTor_KW
        let iso_zero : (pb_of ι_s).obj ((pf_of g).obj K_W) ≅ (pf_of g_s).obj K_Cs₀ :=
          ((pb_of ι_s).mapIso (e0 g K_W)).symm ≪≫
            CategoryTheory.asIso (bc g ι_s g_s ι_Cs hPb_g.w 0 K_W) ≪≫
            e0 g_s ((pb_of ι_Cs).obj K_W) ≪≫
            (pf_of g_s).mapIso ψ_ι₀
        have hZero_pf : CategoryTheory.Limits.IsZero ((pf_of g_s).obj K_Cs₀) :=
          CategoryTheory.Functor.map_isZero (pf_of g_s) hZero_KCs₀
        have hZero_pb : CategoryTheory.Limits.IsZero ((pb_of ι_s).obj ((pf_of g).obj K_W)) :=
          hZero_pf.of_iso iso_zero
        let G_mid := (pb_of ι_s).obj ((pf_of g).obj K_W)
        have hSub_H : Subsingleton (G_mid.H 2) := by
          refine subsingleton_iff_forall_eq 0 |>.mpr fun z => ?_
          have hid0 : CategoryTheory.CategoryStruct.id G_mid = 0 := hZero_pb.eq_of_src _ _
          calc
            z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id G_mid))
                  (Nat.add_zero 2) := (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
            _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ 0) (Nat.add_zero 2) := by rw [hid0]
            _ = 0 := by
                  rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        have hSub_R : Subsingleton ↑((weilEtaleHigherDirectImage p₁ 2 G_mid).obj.obj
            (Opposite.op T_0)) :=
          (Equiv.ofBijective _ (hEvSpec_bij p₁ hT_1 G_mid 2)).symm.injective.subsingleton
        rw [hΨ_right_fac g hg_π₁ Δ₂ τ]
        apply AddCommGrpCat.ext
        intro x₀
        let pre_mor := (pb_of s).map (θ_push g π₁ h_Wf hg_π₁ Q_2).hom ≫
          (pb_of s).map Δ₂ ≫ bc π₁ s p₁ ι_s hι₁ 2 ((pf_of g).obj K_W)
        let post_mor := weilTopDegKummerHigherDirectImageMap p₁ 2
          ((pb_of ι_s).map (τ ≫ Φ_Pd.inv) ≫ πM_of ι_s) ≫ Tr_1
        let mid_x : ↑((weilEtaleHigherDirectImage p₁ 2 G_mid).obj.obj (Opposite.op T_0)) :=
          (pre_mor.hom.app (Opposite.op T_0)).hom x₀
        have hmid0 : mid_x = 0 := @Subsingleton.elim _ hSub_R mid_x 0
        change ((post_mor.hom.app (Opposite.op T_0)).hom mid_x) = 0
        rw [hmid0, map_zero]
      exact (hBranch_out_zero g₁ hg₁_π₁ hg₁_over Δ₂_1 τ₁ hPb_g₁).trans
        (hBranch_out_zero g₂ hg₂_π₁ hg₂_over Δ₂_2 τ₂ hPb_g₂).symm

  exact ⟨hPart1, Tr_rel, γ_rel, hPkg⟩

theorem weil_top_deg_kummer_polyP1_model_trace (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (hCD : ∀ (m q : ℕ)
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper Z.hom],
      topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
      2 * m < q →
      Subsingleton (weilEtaleTorsionH Z.left n q))
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilTopDegKummerPolyP1CoordPkg k ι_P1 ι_aff) :
    ∃ (tr_P1 : weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left n 2 →+ ZMod n)
      (tr_Pd : ∀ δ : ℕ,
        weilEtaleTorsionH (weilPolyP1Over k δ).left n (2 * δ) →+ ZMod n),
      WeilTopDegKummerPolyP1TracePkg k n ζ ι_P1 tr_P1 tr_Pd :=
by
  classical
  let _ := @hCD
  have hn1 : 1 ≤ n := by omega
  rcases hCoord with ⟨hProp_1, hInt_1, hProj_1, hSm_1, hOpen_1, hOver_1, hInf_ex, -, hCoord_Pd⟩
  have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom := hProp_1
  have : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left := hInt_1
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom := hSm_1
  have hTor_const : ∀ Z : AlgebraicGeometry.Scheme.{u},
      n • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z n) = 0 := by
    intro Z
    let J := Z.smallEtaleTopology
    let C_Z := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    have : C_Z.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products C_Z
    have hAM : n • CategoryTheory.CategoryStruct.id AM = 0 := by
      ext ⟨x⟩
      change ULift.up (n • x) = ULift.up 0
      simp
    change n • CategoryTheory.CategoryStruct.id (C_Z.obj AM) = 0
    rw [← C_Z.map_id, ← C_Z.map_nsmul, hAM, C_Z.map_zero]
  have hStepHom_bij : ∀ {B Y : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom Y B) (q q' : ℕ)
      (Tr_rel : Quiver.Hom (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y n))
        (weilEtaleTorsionSheaf B n))
      (γ_rel : Quiver.Hom (weilEtaleTorsionSheaf B n)
        (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y n)))
      (hγT : CategoryTheory.CategoryStruct.comp γ_rel Tr_rel =
        CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf B n))
      (hTγ : CategoryTheory.CategoryStruct.comp Tr_rel γ_rel =
        CategoryTheory.CategoryStruct.id
          (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y n)))
      (e_edge : CategoryTheory.Abelian.Ext
          ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)))
          (weilEtaleTorsionSheaf Y n) q' ≃+
        CategoryTheory.Abelian.Ext
          ((CategoryTheory.constantSheaf B.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)))
          (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y n)) q),
      Function.Bijective (weilPolyP1ModelStepHom f n q q' Tr_rel e_edge) := by
    intro B Y f q q' Tr_rel γ_rel hγT hTγ e_edge
    let Fℤ_B := (CategoryTheory.constantSheaf B.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hPost_bij : Function.Bijective
        ((CategoryTheory.Abelian.Ext.mk₀ Tr_rel).postcomp Fℤ_B (Nat.add_zero q)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨(CategoryTheory.Abelian.Ext.mk₀ γ_rel).postcomp Fℤ_B (Nat.add_zero q),
          fun a => ?_, fun b => ?_⟩
      · exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero a
          (CategoryTheory.Abelian.Ext.mk₀ Tr_rel) (CategoryTheory.Abelian.Ext.mk₀ γ_rel)
          (Nat.add_zero q)).trans
          ((congrArg (fun u => a.comp u (Nat.add_zero q))
            ((CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ Tr_rel γ_rel).trans
              (congrArg CategoryTheory.Abelian.Ext.mk₀ hTγ))).trans
            (CategoryTheory.Abelian.Ext.comp_mk₀_id a))
      · exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero b
          (CategoryTheory.Abelian.Ext.mk₀ γ_rel) (CategoryTheory.Abelian.Ext.mk₀ Tr_rel)
          (Nat.add_zero q)).trans
          ((congrArg (fun u => b.comp u (Nat.add_zero q))
            ((CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ γ_rel Tr_rel).trans
              (congrArg CategoryTheory.Abelian.Ext.mk₀ hγT))).trans
            (CategoryTheory.Abelian.Ext.comp_mk₀_id b))
    exact (weilPolyP1TorsionHExtEquiv B n q).symm.bijective.comp
      (hPost_bij.comp (e_edge.bijective.comp (weilPolyP1TorsionHExtEquiv Y n q').bijective))
  have hExtEq : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (q : ℕ)
      (x_ext : CategoryTheory.Abelian.Ext
        ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))
        (weilEtaleTorsionSheaf Z n) q)
      (x : weilEtaleTorsionH Z n q),
      HEq x_ext x → x_ext = weilPolyP1TorsionHExtEquiv Z n q x := by
    intro Z q x_ext x h
    exact eq_of_heq h
  have hSymmEq : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (q : ℕ)
      (u : weilEtaleTorsionH Z n q)
      (u_ext : CategoryTheory.Abelian.Ext
        ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))
        (weilEtaleTorsionSheaf Z n) q),
      HEq u u_ext → u = (weilPolyP1TorsionHExtEquiv Z n q).symm u_ext := by
    intro Z q u u_ext h
    exact eq_of_heq h
  obtain ⟨tr_P1, hBij_P1, hDiv_P1⟩ :=
    weil_top_deg_kummer_p1_divisor_trace_pkg k n hn hUnit ζ hζ
      (weilProjectiveSpaceOver k 1) hProj_1 ι_P1 hOpen_1 hOver_1 hInf_ex
  obtain ⟨hc_all, hr_all, tr_0, hSpec⟩ :=
    weil_top_deg_kummer_specField_and_kPoint_conservativity.{u} n hn1
  obtain ⟨hPBC_prime, hCD1_prime⟩ :=
    weil_top_deg_kummer_mod_prime_pbc_and_curve_cd k
  obtain ⟨hRes, hSyzygy_all⟩ :=
    weil_top_deg_kummer_two_step_syzygy_edge_iso n hn1 (@hc_all) (@hr_all)
  let π_fst : ∀ δ : ℕ, Quiver.Hom (weilPolyP1Over k (δ + 1)).left (weilPolyP1Over k δ).left :=
    fun δ => CategoryTheory.Limits.pullback.fst
      (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom
  let π_snd : ∀ δ : ℕ, Quiver.Hom (weilPolyP1Over k (δ + 1)).left
      (weilProjectiveSpaceOver k 1).left :=
    fun δ => CategoryTheory.Limits.pullback.snd
      (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom
  have hProp_Pd : ∀ δ : ℕ, AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom :=
    fun δ => (hCoord_Pd δ).1
  have hRel_all : ∀ δ : ℕ,
      (∀ (F : CategoryTheory.Sheaf (weilPolyP1Over k (δ + 1)).left.smallEtaleTopology
          AddCommGrpCat.{u}) (b : ℕ),
        n • CategoryTheory.CategoryStruct.id F = 0 →
        3 ≤ b →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage (π_fst δ) b F)) ∧
      ∃ (Tr_rel : Quiver.Hom
          (weilEtaleHigherDirectImage (π_fst δ) 2
            (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n))
          (weilEtaleTorsionSheaf (weilPolyP1Over k δ).left n))
        (γ_rel : Quiver.Hom
          (weilEtaleTorsionSheaf (weilPolyP1Over k δ).left n)
          (weilEtaleHigherDirectImage (π_fst δ) 2
            (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n))),
        WeilPolyP1ModelTraceRelStepPkg k n (@hc_all) (@hr_all) tr_0
          (weilProjectiveSpaceOver k 1) tr_P1 δ (δ + 1)
          (weilPolyP1Over k δ) (weilPolyP1Over k (δ + 1)) (π_fst δ) (π_snd δ) Tr_rel γ_rel := by
    intro δ
    have : AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom := hProp_Pd δ
    exact weil_top_deg_kummer_rel_p1_trace_and_fiber_clauses k n hn hUnit ζ hζ
      (@hc_all) (@hr_all) tr_0 hSpec hPBC_prime hCD1_prime hRes
      (weilProjectiveSpaceOver k 1) hProj_1 ι_P1 hOpen_1 hOver_1 hInf_ex
      tr_P1 hBij_P1 hDiv_P1 δ (δ + 1) rfl
      (weilPolyP1Over k δ) (weilPolyP1Over k (δ + 1)) (π_fst δ) (π_snd δ) rfl
      (CategoryTheory.IsPullback.of_hasPullback
        (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom)
  have hVan_R_b : ∀ (δ : ℕ)
      (F : CategoryTheory.Sheaf (weilPolyP1Over k (δ + 1)).left.smallEtaleTopology
        AddCommGrpCat.{u}) (b : ℕ),
      n • CategoryTheory.CategoryStruct.id F = 0 →
      3 ≤ b →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage (π_fst δ) b F) :=
    fun δ => (hRel_all δ).1
  let Tr_rel : ∀ δ : ℕ, Quiver.Hom
      (weilEtaleHigherDirectImage (π_fst δ) 2
        (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n))
      (weilEtaleTorsionSheaf (weilPolyP1Over k δ).left n) :=
    fun δ => Classical.choose (hRel_all δ).2
  let γ_rel : ∀ δ : ℕ, Quiver.Hom
      (weilEtaleTorsionSheaf (weilPolyP1Over k δ).left n)
      (weilEtaleHigherDirectImage (π_fst δ) 2
        (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left n)) :=
    fun δ => Classical.choose (Classical.choose_spec (hRel_all δ).2)
  have hStep : ∀ δ : ℕ,
      WeilPolyP1ModelTraceRelStepPkg k n (@hc_all) (@hr_all) tr_0
        (weilProjectiveSpaceOver k 1) tr_P1 δ (δ + 1)
        (weilPolyP1Over k δ) (weilPolyP1Over k (δ + 1)) (π_fst δ) (π_snd δ)
        (Tr_rel δ) (γ_rel δ) :=
    fun δ => Classical.choose_spec (Classical.choose_spec (hRel_all δ).2)
  have hCD_Pd : ∀ (δ : ℕ)
      (F : CategoryTheory.Sheaf (weilPolyP1Over k δ).left.smallEtaleTopology AddCommGrpCat.{u})
