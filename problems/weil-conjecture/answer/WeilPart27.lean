              (w₂ * jA (algebraMap B₀ A s₂.1)) * jA (algebraMap B₀ A s₁.1) := by ring
          _ = jA a₁ * jA (algebraMap B₀ A s₂.1) + jA a₂ * jA (algebraMap B₀ A s₁.1) := by
              rw [hw₁, hw₂]
    exact ⟨hinj, hunits, hsurj⟩
  
  have s2_baseChange : ∀ (F R : Type u) [Field F] [Algebra B₀ F] [IsFractionRing B₀ F]
      [CommRing R] [Algebra B₀ R] [Module.Flat B₀ R],
      let R' := TensorProduct B₀ F R
      let ι_R : R →ₐ[B₀] R' := Algebra.TensorProduct.includeRight
      Function.Injective ι_R ∧
      ∀ (n : ℕ) (A : Type u) [CommRing A] [Algebra B₀ A],
        Nonempty (Module.Basis (Fin n) B₀ A) →
        ∀ (w : TensorProduct B₀ R A),
          ι_R (Algebra.norm R w) =
            Algebra.norm R'
              ((Algebra.TensorProduct.cancelBaseChange B₀ F R' R' A).symm
                (Algebra.TensorProduct.map ι_R (AlgHom.id B₀ A) w)) := by
    intro F R _ _ _ _ _ _
    dsimp only
    let R' := TensorProduct B₀ F R
    let ι_R : R →ₐ[B₀] R' := Algebra.TensorProduct.includeRight
    refine ⟨?_, ?_⟩
    · let f₀ : B₀ →ₗ[B₀] F := Algebra.linearMap B₀ F
      have hf₀ : Function.Injective f₀ := IsFractionRing.injective B₀ F
      have hrT : Function.Injective (f₀.rTensor R) :=
        Module.Flat.rTensor_preserves_injective_linearMap f₀ hf₀
      intro r₁ r₂ hr
      apply (TensorProduct.lid B₀ R).symm.injective
      apply hrT
      have heq : ∀ r : R, f₀.rTensor R ((TensorProduct.lid B₀ R).symm r) = ι_R r := by
        intro r
        simp [f₀, ι_R]
        rfl
      rw [heq, heq]
      exact hr
    · intro n A _ _ ⟨b_A⟩ w
      let Φ : TensorProduct B₀ R A →ₐ[B₀] TensorProduct B₀ R' A :=
        Algebra.TensorProduct.map ι_R (AlgHom.id B₀ A)
      have hCancel :
          Algebra.norm R'
            ((Algebra.TensorProduct.cancelBaseChange B₀ F R' R' A).symm (Φ w)) =
          Algebra.norm R' (Φ w) :=
        @Algebra.norm_eq_of_algEquiv R' (TensorProduct B₀ R' A)
          (TensorProduct F R' (TensorProduct B₀ F A)) _ _ _ _ _
          (Algebra.TensorProduct.cancelBaseChange B₀ F R' R' A).symm (Φ w)
      change ι_R (Algebra.norm R w) =
        Algebra.norm R' ((Algebra.TensorProduct.cancelBaseChange B₀ F R' R' A).symm (Φ w))
      rw [hCancel]
      let b_R : Module.Basis (Fin n) R (TensorProduct B₀ R A) := b_A.baseChange R
      let b_R' : Module.Basis (Fin n) R' (TensorProduct B₀ R' A) := b_A.baseChange R'
      rw [Algebra.norm_eq_matrix_det b_R, Algebra.norm_eq_matrix_det b_R']
      change ι_R.toRingHom ((Algebra.leftMulMatrix b_R) w).det = _
      rw [RingHom.map_det ι_R.toRingHom]
      congr 1
      ext i k
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply,
        Algebra.leftMulMatrix_eq_repr_mul]
      have hΦ_smul : ∀ (r : R) (j : Fin n), Φ (r • b_R j) = (ι_R r) • b_R' j := by
        intro r j
        have hbR : b_R j = (1 : R) ⊗ₜ[B₀] b_A j := Module.Basis.baseChange_apply R b_A j
        have hbR' : b_R' j = (1 : R') ⊗ₜ[B₀] b_A j := Module.Basis.baseChange_apply R' b_A j
        rw [hbR, hbR', TensorProduct.smul_tmul', TensorProduct.smul_tmul',
          smul_eq_mul, smul_eq_mul, mul_one, mul_one]
        rfl
      have hΦ_b : ∀ j : Fin n, Φ (b_R j) = b_R' j := by
        intro j
        simpa using hΦ_smul 1 j
      have hexp : Φ w * b_R' k =
          ∑ j : Fin n, ι_R ((b_R.repr (w * b_R k)) j) • b_R' j := by
        calc
          Φ w * b_R' k = Φ w * Φ (b_R k) := by rw [hΦ_b]
          _ = Φ (w * b_R k) := (map_mul Φ w (b_R k)).symm
          _ = Φ (∑ j : Fin n, (b_R.repr (w * b_R k) j) • b_R j) := by
              congr 1
              exact (b_R.sum_repr (w * b_R k)).symm
          _ = ∑ j : Fin n, Φ ((b_R.repr (w * b_R k) j) • b_R j) := map_sum Φ _ _
          _ = ∑ j : Fin n, ι_R ((b_R.repr (w * b_R k)) j) • b_R' j := by
              refine Finset.sum_congr rfl fun j _ => hΦ_smul _ j
      rw [hexp, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
      simp only [LinearEquiv.map_smul, b_R'.repr_self, Finsupp.smul_single, smul_eq_mul,
        mul_one, Finsupp.single_apply, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
      rfl
  
  have s3_genericDecomp : ∀ (F : Type u) [Field F] [Algebra B₀ F] [IsFractionRing B₀ F]
      [∀ i : Fin c, (p_min i).IsPrime],
      (∀ i : Fin c, 1 ≤ e i ∧ 1 ≤ d_rk i) ∧
      ∃ (instAlgF : ∀ i : Fin c, Algebra F (Localization.AtPrime (p_min i))),
        letI : ∀ i : Fin c, Algebra F (Localization.AtPrime (p_min i)) := instAlgF
