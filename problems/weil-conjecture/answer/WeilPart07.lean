      F φ_VF η_semi C_tilde g_tilde q η_tilde U_dom b K_bad y_bad V_tilde₀ V_tilde₁ T₀ S₁ hDom
  obtain ⟨m₀, x_bar, hx_bar_mem, hk_pos, hx_bar_cocycle, hx_bar_unit, hAcyclic_mod⟩ :=
