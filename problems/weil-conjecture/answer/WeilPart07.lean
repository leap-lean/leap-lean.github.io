        obtain ⟨α₁, hα₁_mem, hα₁_d⟩ := acyc_D D_β₁ (by simp) 1 ξ
          (inC_mono (fun S hS => (hSub S hS).2.2.1) hξ_mem) hξ_coc
        let δ : Simp 1 → F := fun I => α₀ I - α₁ I
        have hδ_mem : inC 1 D_β₀₁ δ :=
          inC_sub (inC_mono (fun S hS => (hSub S hS).2.2.2.1) hα₀_mem)
            (inC_mono (fun S hS => (hSub S hS).2.2.2.2.1) hα₁_mem)
        have hδ_coc : ∀ J : Simp 2, cechD 1 δ J = 0 := by
          intro J; rw [cechD_sub 1 α₀ α₁ J, hα₀_d J, hα₁_d J, sub_self]
        obtain ⟨γ, hγ_mem, hγ_d⟩ := acyc_D D_β₀₁ (by simp) 0 δ hδ_mem hδ_coc
        have hγ_a : ∀ a : Fin (N + 1), (t_loc a) ^ k * γ (ι₀ a) ∈ D_β₀₁ {a} := by
          intro a; have h := hγ_mem (ι₀ a); rwa [himg_simp0 (ι₀ a)] at h
        choose z₀ hz₀ z₁ hz₁ c_a hc_a using fun a : Fin (N + 1) => hGQ_decomp a _ (hγ_a a)
        let γ₀ : Simp 0 → F := fun I => z₀ (I.1 0) / (t_loc (I.1 0)) ^ k
        let γ₁ : Simp 0 → F := fun I => z₁ (I.1 0) / (t_loc (I.1 0)) ^ k
        have hγ₀_mem : inC 0 D_β₀ γ₀ := by
          intro I; rw [himg_simp0 I]; dsimp only [γ₀]
          rw [mul_div_cancel₀ _ (pow_ne_zero k (ht_ne (I.1 0)))]; exact hz₀ (I.1 0)
        have hγ₁_mem : inC 0 D_β₁ γ₁ := by
          intro I; rw [himg_simp0 I]; dsimp only [γ₁]
          rw [mul_div_cancel₀ _ (pow_ne_zero k (ht_ne (I.1 0)))]; exact hz₁ (I.1 0)
        let c : Fin L → ↥R_β := fun ℓ => c_a (e_Λ ℓ).1 (e_Λ ℓ).2
        have hγ_decomp : ∀ I : Simp 0,
            γ I = (γ₀ I - γ₁ I) + ∑ ℓ : Fin L, φ_VF (R_β.subtype (c ℓ)) * e_coch ℓ I := by
          intro I
          let a := I.1 0
          have hI_eq : I = ι₀ a := hι₀_eq I
          have hsum_eq : (∑ ℓ : Fin L, φ_VF (R_β.subtype (c ℓ)) * e_coch ℓ I) =
              (∑ g : ↥(G_Q a), φ_VF (R_β.subtype (c_a a g)) * (g : F)) / (t_loc a) ^ k := by
            have h1 := Equiv.sum_comp e_Λ
              (fun x : Λ => φ_VF (R_β.subtype (c_a x.1 x.2)) *
