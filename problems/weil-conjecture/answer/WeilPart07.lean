        have hp0_ne : p₀ ≠ 0 := by
          intro h0
          subst h0
          exact Nat.not_lt_zero (r : ℕ) hlt
        have hp : (r.predAbove p₀ : ℕ) + 1 = (p₀ : ℕ) := by
          rw [Fin.predAbove_of_castSucc_lt r p₀ hlt, Fin.val_pred p₀ hp0_ne]
          exact Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (Fin.val_ne_zero_iff.mpr hp0_ne))
