    · intro U₀ hU₀ p₀ q_B hp₀_eq hp₀_le hqB_min
      let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R m_R.ResidueField))
      let fst₀ := CategoryTheory.Limits.pullback.fst g s₀
      let snd₀ := CategoryTheory.Limits.pullback.snd g s₀
      have hs₀_bot : (s₀.base (⊥ : PrimeSpectrum m_R.ResidueField)).asIdeal = m_R := hsQ_bot m_R
      let γ₀ := (AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ g)).hom
      let y₀ : ↥X := hU₀.fromSpec.base q_B
      have hqB_comap : Ideal.comap γ₀ q_B.asIdeal = m_R :=
        le_antisymm (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.comap γ₀).ne_top)
          (Ideal.map_le_iff_le_comap.mp hqB_min.1.2)
