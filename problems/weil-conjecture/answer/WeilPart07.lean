        refine ⟨z', ?_⟩
        ext i
        have hnat := congrFun (h_bdryM_nat (j + 1) Z_sub.subtype z') i
        dsimp only [Function.comp_apply, Submodule.coe_subtype] at hnat
        rw [hnat]
        have hcoe : Subtype.val ∘ z' = v' := rfl
        rw [hcoe]
        dsimp only [v']
        rw [map_sub, Pi.sub_apply, h_bdryM_sq (j + 1) F_mod y, Pi.zero_apply, sub_zero]
