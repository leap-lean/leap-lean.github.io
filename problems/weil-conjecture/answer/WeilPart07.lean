      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver S 1).hom :=
    fun S _ => (hCoord_pkg S 1).1
  have hCov_P1 : (⨆ a : Fin (1 + 1), weilProjBasicOpen ↥V 1 a) = ⊤ :=
