        have hz_in_Z : (⟨z, hz_Z⟩ : ↥Z_sub) ∈ 𝔪 • (⊤ : Submodule R ↥Z_sub) :=
          (h_bdryM_zero_iff ↥Z_sub ⟨z, hz_Z⟩).mp ⟨v_Z, hv_Z_eq⟩
