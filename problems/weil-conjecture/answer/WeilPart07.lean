    have hChart_inter : ∀ (U : C.Opens) (φU : U.toScheme ⟶ P_next.left)
        (ψU : MvPolynomial (Fin (N' + 1)) ↥V →+* ↑(U.toScheme.presheaf.obj (Opposite.op ⊤)))
        (hψU : Ideal.map ψU (HomogeneousIdeal.irrelevant 𝒜_V).toIdeal = ⊤)
        (s : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op U))),
