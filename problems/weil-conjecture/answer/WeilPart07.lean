            res₀_Y.map_mul (h₀_Y ^ (m₁ + n₁)) b₂]
    have hN_mem : h₀_Y ^ N * d₀ ∈ RingHom.ker π_Z0 ⊔ RingHom.ker π'_0 := by
      rw [hInj₀ hN_res]
      exact Submodule.add_mem_sup
        (Ideal.mul_mem_left _ _ hb₁_ker)
        (Ideal.mul_mem_left _ _ hb₂_ker)
    have hSup_N : (RingHom.ker π_Z0 ⊔ RingHom.ker π'_0) ⊔ Ideal.span {h₀_Y ^ N} = ⊤ := by
      rw [← Ideal.span_singleton_pow]
