    have hh_tA : ∀ j, h_t j ∈ A := fun j => A.mul_mem (A.pow_mem (hhγ j).1 n₁) hw₀
    have hW_pow : ∀ M : ℕ, ∃ (R : ℕ) (α_t : Fin r₀ → F) (γ_t : Fin r₁ → F),
