      have hηY_range : fst₀.base η_Y ∈ Set.range hU₀.fromSpec.base := by
        rw [hU₀.range_fromSpec]
        exact hηY_U₀
      obtain ⟨q_η, hqη_eq⟩ := hηY_range
      have hqη_comap : Ideal.comap γ₀ q_η.asIdeal = m_R := by
        rw [hAffine_comap U₀ hU₀ q_η, hqη_eq]
        have hcond : g.base (fst₀.base η_Y) = s₀.base (snd₀.base η_Y) := by
          change (fst₀ ≫ g).base η_Y = (snd₀ ≫ s₀).base η_Y
          rw [CategoryTheory.Limits.pullback.condition]
