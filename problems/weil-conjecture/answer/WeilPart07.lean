      have : Algebra.FiniteType R_mod B_P := inferInstance
      have : Algebra.FiniteType κ_P B_P := Algebra.FiniteType.trans (R := κ_P) (S := R_mod) (A := B_P) inferInstance inferInstance
      have : Algebra.FiniteType κ_P D := inferInstance
      have hFinSpecD : Finite (PrimeSpectrum D) := by
