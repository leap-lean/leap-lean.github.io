      have h_ι : hV_sm.isoSpec.hom ≫ hV_sm.fromSpec ≫ f = V_sm.ι ≫ f := by
        rw [← Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_hom, hV_sm.toSpecΓ_fromSpec]
