    refine ⟨?_, ?_⟩
    · have hLocalFin : ∀ y : Sing, ∃ O_y : Set ↥X,
          IsOpen O_y ∧ y.1 ∈ O_y ∧ (O_y ∩ Sing).Finite := by
        rintro ⟨y, hy⟩
        obtain ⟨_W_X, _hW_X, B, _, _φ₁, φ₂, ι_WU, v₀, hφ₂_et, hOpen_ι, hv₀_y, _, _, hOffSm⟩ :=
          hChart y hy
        refine ⟨Set.range ι_WU.base, ?_, ⟨v₀, hv₀_y⟩, ?_⟩
        · rw [← Set.image_univ]
