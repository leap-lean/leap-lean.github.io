                η ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) = ξ I)
      (_ : ∀ (p : ℕ) (ξ : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F)
          (K : {K : Fin (p + 3) → Fin (N + 1) // StrictMono K}),
        (∑ r : Fin (p + 3), (-1 : F) ^ (r : ℕ) *
          (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
            ξ ⟨(K.1 ∘ r.succAbove) ∘ q.succAbove,
              (K.2.comp (Fin.strictMono_succAbove r)).comp (Fin.strictMono_succAbove q)⟩)) = 0)
      (_ : ∀ (A : Finset (Fin (N + 1)) → Subring F),
        (∀ S S' : Finset (Fin (N + 1)), S.Nonempty → S ⊆ S' → A S ≤ A S') →
        (∀ S : Finset (Fin (N + 1)), S.Nonempty → ∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ A S) →
        ∀ (p : ℕ) (ξ : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F),
          (∀ I, (t_loc (I.1 0)) ^ k * ξ I ∈ A (Finset.univ.image I.1)) →
          ∀ J : {J : Fin (p + 2) → Fin (N + 1) // StrictMono J},
            (t_loc (J.1 0)) ^ k *
              (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
                ξ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩) ∈
              A (Finset.univ.image J.1))
      (q : ℕ),
      ∃ (L : ℕ) (ω : Fin L → {I : Fin (q + 2) → Fin (N + 1) // StrictMono I} → F),
        (∀ ℓ : Fin L,
          (∀ I, (t_loc (I.1 0)) ^ k * ω ℓ I ∈ B_β (Finset.univ.image I.1)) ∧
          (∀ J : {J : Fin (q + 3) → Fin (N + 1) // StrictMono J},
            (∑ r : Fin (q + 3), (-1 : F) ^ (r : ℕ) *
              ω ℓ ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩) = 0)) ∧
        ∀ ξ : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I} → F,
          (∀ I, (t_loc (I.1 0)) ^ k * ξ I ∈ B_β (Finset.univ.image I.1)) →
          (∀ J : {J : Fin (q + 3) → Fin (N + 1) // StrictMono J},
            (∑ r : Fin (q + 3), (-1 : F) ^ (r : ℕ) *
              ξ ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩) = 0) →
          ∃ (η : {I : Fin (q + 1) → Fin (N + 1) // StrictMono I} → F) (c : Fin L → ↥R_β),
            (∀ I, (t_loc (I.1 0)) ^ k * η I ∈ B_β (Finset.univ.image I.1)) ∧
            ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
              ξ I = (∑ r : Fin (q + 2), (-1 : F) ^ (r : ℕ) *
                η ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩) +
                ∑ ℓ : Fin L, φ_VF (R_β.subtype (c ℓ)) * ω ℓ I := by
    clear * -
    intro K _ V R_β _ F _ φ_VF N k B_β D_β₀ D_β₁ D_β₀₁ t_loc ht_ne hSub hMono hOverlap
      hGQ hGM hAcycD hd_sq hd_mem q
    let Simp : ℕ → Type := fun p => {I : Fin (p + 1) → Fin (N + 1) // StrictMono I}
    let cechD : ∀ (p : ℕ), (Simp p → F) → Simp (p + 1) → F :=
      fun p ξ J => ∑ r : Fin (p + 2), (-1 : F) ^ (r : ℕ) *
        ξ ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩
    let inC : ∀ (p : ℕ), (Finset (Fin (N + 1)) → Subring F) → (Simp p → F) → Prop :=
      fun p A ξ => ∀ I : Simp p, (t_loc (I.1 0)) ^ k * ξ I ∈ A (Finset.univ.image I.1)
    have hne_img : ∀ {p : ℕ} (I : Simp p), (Finset.univ.image I.1).Nonempty :=
      fun I => ⟨I.1 0, Finset.mem_image_of_mem _ (Finset.mem_univ 0)⟩
    have acyc_D : ∀ (D_ε : Finset (Fin (N + 1)) → Subring F),
        D_ε ∈ ({D_β₀, D_β₁, D_β₀₁} : Set (Finset (Fin (N + 1)) → Subring F)) →
        ∀ (p : ℕ) (ξ : Simp (p + 1) → F),
          inC (p + 1) D_ε ξ →
          (∀ J : Simp (p + 2), cechD (p + 1) ξ J = 0) →
          ∃ η : Simp p → F, inC p D_ε η ∧ ∀ I : Simp (p + 1), cechD p η I = ξ I :=
      fun D_ε hmem p ξ hξ hcoc => hAcycD D_ε hmem p ξ hξ hcoc
    have cechD_add : ∀ (p : ℕ) (ξ₁ ξ₂ : Simp p → F) (J : Simp (p + 1)),
        cechD p (fun I => ξ₁ I + ξ₂ I) J = cechD p ξ₁ J + cechD p ξ₂ J := by
      intro p ξ₁ ξ₂ J; dsimp only [cechD]; simp_rw [mul_add, Finset.sum_add_distrib]
    have cechD_sub : ∀ (p : ℕ) (ξ₁ ξ₂ : Simp p → F) (J : Simp (p + 1)),
        cechD p (fun I => ξ₁ I - ξ₂ I) J = cechD p ξ₁ J - cechD p ξ₂ J := by
      intro p ξ₁ ξ₂ J; dsimp only [cechD]; simp_rw [mul_sub, Finset.sum_sub_distrib]
    have cechD_mul_const : ∀ (p : ℕ) (c₀ : F) (ξ : Simp p → F) (J : Simp (p + 1)),
        cechD p (fun I => c₀ * ξ I) J = c₀ * cechD p ξ J := by
      intro p c₀ ξ J
      dsimp only [cechD]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun r _ => by ring
    have cechD_sum : ∀ (p L : ℕ) (f : Fin L → Simp p → F) (J : Simp (p + 1)),
        cechD p (fun I => ∑ ℓ : Fin L, f ℓ I) J = ∑ ℓ : Fin L, cechD p (f ℓ) J := by
      intro p L f J
      dsimp only [cechD]
      simp_rw [Finset.mul_sum]
      exact Finset.sum_comm
    have cechD_sq : ∀ (p : ℕ) (ξ : Simp p → F) (K : Simp (p + 2)),
        cechD (p + 1) (cechD p ξ) K = 0 := hd_sq
    have inC_inter : ∀ {p : ℕ} {ξ : Simp p → F},
        inC p D_β₀ ξ → inC p D_β₁ ξ → inC p B_β ξ := by
      intro p ξ h0 h1 I
      rw [← (hSub _ (hne_img I)).2.2.2.2.2.1]
      exact ⟨h0 I, h1 I⟩
    have inC_mono : ∀ {p : ℕ} {A₁ A₂ : Finset (Fin (N + 1)) → Subring F} {ξ : Simp p → F},
        (∀ S, S.Nonempty → A₁ S ≤ A₂ S) → inC p A₁ ξ → inC p A₂ ξ :=
      fun hle hξ I => hle _ (hne_img I) (hξ I)
    have inC_sub : ∀ {p : ℕ} {A : Finset (Fin (N + 1)) → Subring F} {ξ₁ ξ₂ : Simp p → F},
        inC p A ξ₁ → inC p A ξ₂ → inC p A (fun I => ξ₁ I - ξ₂ I) := by
      intro p A ξ₁ ξ₂ h1 h2 I
      rw [mul_sub]
      exact Subring.sub_mem _ (h1 I) (h2 I)
    have inC_R_mul : ∀ {p : ℕ} {A : Finset (Fin (N + 1)) → Subring F}
        (hBA : ∀ S, S.Nonempty → B_β S ≤ A S) (r : ↥R_β) {ξ : Simp p → F},
        inC p A ξ → inC p A (fun I => φ_VF (R_β.subtype r) * ξ I) := by
      intro p A hBA r ξ hξ I
      have hr : φ_VF (R_β.subtype r) ∈ A (Finset.univ.image I.1) :=
        hBA _ (hne_img I) ((hSub _ (hne_img I)).1 r)
      have heq : (t_loc (I.1 0)) ^ k * (φ_VF (R_β.subtype r) * ξ I) =
          φ_VF (R_β.subtype r) * ((t_loc (I.1 0)) ^ k * ξ I) := by ring
      rw [heq]
      exact Subring.mul_mem _ hr (hξ I)
    have inC_fin_sum : ∀ {p L : ℕ} {A : Finset (Fin (N + 1)) → Subring F}
        (f : Fin L → Simp p → F),
        (∀ ℓ, inC p A (f ℓ)) → inC p A (fun I => ∑ ℓ : Fin L, f ℓ I) := by
      intro p L A f hf I
      rw [Finset.mul_sum]
      exact Subring.sum_mem _ fun ℓ _ => hf ℓ I
    have hd_D0 : ∀ {p : ℕ} {ξ : Simp p → F}, inC p D_β₀ ξ → inC (p + 1) D_β₀ (cechD p ξ) :=
      fun {p ξ} hξ => hd_mem D_β₀ (fun S S' hS hsub => (hMono S S' hS hsub).2.1)
        (fun S hS a ha b hb => (hSub S hS).2.1 ((hSub S hS).2.2.2.2.2.2 a ha b hb)) p ξ hξ
    have hd_D1 : ∀ {p : ℕ} {ξ : Simp p → F}, inC p D_β₁ ξ → inC (p + 1) D_β₁ (cechD p ξ) :=
      fun {p ξ} hξ => hd_mem D_β₁ (fun S S' hS hsub => (hMono S S' hS hsub).2.2.1)
        (fun S hS a ha b hb => (hSub S hS).2.2.1 ((hSub S hS).2.2.2.2.2.2 a ha b hb)) p ξ hξ
    have hd_D01 : ∀ {p : ℕ} {ξ : Simp p → F}, inC p D_β₀₁ ξ → inC (p + 1) D_β₀₁ (cechD p ξ) :=
      fun {p ξ} hξ => hd_mem D_β₀₁ (fun S S' hS hsub => (hMono S S' hS hsub).2.2.2)
        (fun S hS a ha b hb => (hSub S hS).2.2.2.1 ((hSub S hS).2.1 ((hSub S hS).2.2.2.2.2.2 a ha b hb))) p ξ hξ
    have split_ge1 : ∀ (p : ℕ) (γ : Simp (p + 1) → F),
