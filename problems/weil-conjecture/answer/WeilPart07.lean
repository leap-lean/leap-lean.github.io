    intro J
    have h01 : (J.1 0 : ℕ) < (J.1 1 : ℕ) := J.2 (by decide)
    have h12 : (J.1 1 : ℕ) < (J.1 2 : ℕ) := J.2 (by decide)
    have h2_lt : (J.1 2 : ℕ) < 2 := (J.1 2).isLt
    omega
  obtain ⟨β₀, hβ₀⟩ := hAffCech U hU 1 V_cov hV_le hV_aff hV_sup 0 α₀ hα₀
  let I₀ : {I : Fin 2 → Fin 2 // StrictMono I} := ⟨id, strictMono_id⟩
  have hW₀₁_le_I₀ : W₀₁ ≤ Finset.inf (Finset.univ.image I₀.1) V_cov := by
    refine Finset.le_inf fun a _ => ?_
    fin_cases a
    · exact inf_le_inf_left U inf_le_left
    · exact inf_le_inf_left U inf_le_right
  let K_r0 : {K : Fin 1 → Fin 2 // StrictMono K} :=
    ⟨I₀.1 ∘ (0 : Fin 2).succAbove, I₀.2.comp (Fin.strictMono_succAbove 0)⟩
  let K_r1 : {K : Fin 1 → Fin 2 // StrictMono K} :=
    ⟨I₀.1 ∘ (1 : Fin 2).succAbove, I₀.2.comp (Fin.strictMono_succAbove 1)⟩
  have hW₁_le_Kr0 : W₁ ≤ Finset.inf (Finset.univ.image K_r0.1) V_cov := by
    refine Finset.le_inf fun b hb => ?_
    rw [Finset.mem_image] at hb
    obtain ⟨t, _, rfl⟩ := hb
    fin_cases t
    rfl
  have hW₀_le_Kr1 : W₀ ≤ Finset.inf (Finset.univ.image K_r1.1) V_cov := by
    refine Finset.le_inf fun b hb => ?_
    rw [Finset.mem_image] at hb
    obtain ⟨t, _, rfl⟩ := hb
    fin_cases t
    rfl
  let c₁_tilde : ↑(Y.presheaf.obj (Opposite.op W₁)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE hW₁_le_Kr0).op).hom (β₀ K_r0)
  let c₀ : ↑(Y.presheaf.obj (Opposite.op W₀)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE hW₀_le_Kr1).op).hom (β₀ K_r1)
  have hsplit_g' :
      (Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_inf_left U inf_le_right : W₀₁ ≤ W₁)).op).hom c₁_tilde -
      (Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_inf_left U inf_le_left : W₀₁ ≤ W₀)).op).hom c₀ = g' := by
    have h := congrArg
      ((Y.presheaf.map (CategoryTheory.homOfLE hW₀₁_le_I₀).op).hom) (hβ₀ I₀)
    rw [Fin.sum_univ_two, map_add, map_zsmul, map_zsmul, hY_map_comp, hY_map_comp] at h
    dsimp only [α₀] at h
    rw [hY_map_comp, hY_map_id] at h
    have h0 : ((-1 : ℤ) ^ ((0 : Fin 2) : ℕ)) = 1 := rfl
    have h1 : ((-1 : ℤ) ^ ((1 : Fin 2) : ℕ)) = -1 := rfl
    rw [h0, h1, one_zsmul, neg_one_zsmul, ← sub_eq_add_neg] at h
    dsimp only [c₁_tilde, c₀]
    rw [hY_map_comp, hY_map_comp]
    exact h
  let s_W₁ : ↑(Y.presheaf.obj (Opposite.op W₁)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ≤ V₁)).op).hom s₁
  let c₁ : ↑(Y.presheaf.obj (Opposite.op W₁)) := s_W₁ ^ m₀ * c₁_tilde
  refine ⟨c₀, c₁, ?_⟩
  have hc₁_res :
      (Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_inf_left U inf_le_right : W₀₁ ≤ W₁)).op).hom c₁ =
      s₀₁ ^ m₀ *
        (Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_inf_left U inf_le_right : W₀₁ ≤ W₁)).op).hom c₁_tilde := by
    dsimp only [c₁, s_W₁, s₀₁]
    rw [map_mul, map_pow, hY_map_comp]
  have hdiff :
      (Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_inf_left U inf_le_left : W₀₁ ≤ W₀)).op).hom c₀ -
      (Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_inf_left U inf_le_right : W₀₁ ≤ W₁)).op).hom c₁_tilde =
      f₀₁ ^ m₀ * g := by
    dsimp only [g'] at hsplit_g'
    linear_combination -hsplit_g'
  calc
    g = (f₀₁ * s₀₁) ^ m₀ * g := by rw [hmul₀₁, one_pow, one_mul]
    _ = s₀₁ ^ m₀ * (f₀₁ ^ m₀ * g) := by ring
    _ = s₀₁ ^ m₀ *
        ((Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_inf_left U inf_le_left : W₀₁ ≤ W₀)).op).hom c₀ -
        (Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_inf_left U inf_le_right : W₀₁ ≤ W₁)).op).hom c₁_tilde) := by rw [hdiff]
    _ = s₀₁ ^ m₀ *
        (Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_inf_left U inf_le_left : W₀₁ ≤ W₀)).op).hom c₀ -
        (Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_inf_left U inf_le_right : W₀₁ ≤ W₁)).op).hom c₁ := by
        rw [mul_sub, hc₁_res]

theorem weil_twoChart_twisted_cech_and_subring_mod_acyclicity (K : Type u) [Field K]
    (V : ValuationSubring K)
    (F : Type u) [Field F]
    (φ_VF : ↥V →+* F)
    (N m₀ k : ℕ)
    (B : Finset (Fin (N + 1)) → Subring F)
    (t_loc : Fin (N + 1) → F)
    (hB_mono : ∀ S S' : Finset (Fin (N + 1)), S.Nonempty → S ⊆ S' → B S ≤ B S')
    (ht_mem : ∀ a : Fin (N + 1), t_loc a ∈ B {a} ∧ t_loc a ≠ 0)
    (ht_ratio : ∀ S : Finset (Fin (N + 1)), S.Nonempty →
      ∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ B S)
    (Y : AlgebraicGeometry.Scheme.{u})
    (hAffInter : ∀ U₁ U₂ : Y.Opens,
      AlgebraicGeometry.IsAffineOpen U₁ →
      AlgebraicGeometry.IsAffineOpen U₂ →
      AlgebraicGeometry.IsAffineOpen (U₁ ⊓ U₂))
    (hLocSplit : ∀ (U V₀ V₁ : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      AlgebraicGeometry.IsAffineOpen V₀ →
      AlgebraicGeometry.IsAffineOpen V₁ →
      U ≤ V₀ ⊔ V₁ →
      ∀ (f₀ : ↑(Y.presheaf.obj (Opposite.op V₀)))
        (s₁ : ↑(Y.presheaf.obj (Opposite.op V₁))),
        Y.basicOpen f₀ = V₀ ⊓ V₁ →
        Y.basicOpen s₁ = V₀ ⊓ V₁ →
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom f₀ *
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom s₁ = 1 →
        ∀ (g : ↑(Y.presheaf.obj (Opposite.op (U ⊓ (V₀ ⊓ V₁))))),
          ∃ (c₀ : ↑(Y.presheaf.obj (Opposite.op (U ⊓ V₀))))
            (c₁ : ↑(Y.presheaf.obj (Opposite.op (U ⊓ V₁)))),
            g =
              ((Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_right.trans inf_le_right : U ⊓ (V₀ ⊓ V₁) ≤ V₁)).op).hom s₁) ^ m₀ *
              (Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_left U inf_le_left : U ⊓ (V₀ ⊓ V₁) ≤ U ⊓ V₀)).op).hom c₀ -
              (Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_left U inf_le_right : U ⊓ (V₀ ⊓ V₁) ≤ U ⊓ V₁)).op).hom c₁)
    (hAffCech : ∀ (U : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      ∀ (V_cov : Fin (N + 1) → Y.Opens),
        (∀ a : Fin (N + 1), V_cov a ≤ U) →
        (∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (V_cov a)) →
        (⨆ a : Fin (N + 1), V_cov a) = U →
        ∀ (q : ℕ)
          (α : ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
            ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) V_cov)))),
          (∀ J : {J : Fin (q + 3) → Fin (N + 1) // StrictMono J},
            (∑ r : Fin (q + 3),
              (-1 : ℤ) ^ (r : ℕ) •
                (Y.presheaf.map (CategoryTheory.homOfLE
                  (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                    Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))).op).hom
                  (α ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) = 0) →
          ∃ β : ∀ K : {K : Fin (q + 1) → Fin (N + 1) // StrictMono K},
              ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image K.1) V_cov))),
            ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
              (∑ r : Fin (q + 2),
                (-1 : ℤ) ^ (r : ℕ) •
                  (Y.presheaf.map (CategoryTheory.homOfLE
                    (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                      Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))).op).hom
                    (β ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩)) = α I)
    (W_Y : Fin (N + 1) → Y.Opens)
    (hWY_cov : (⨆ a : Fin (N + 1), W_Y a) = ⊤ ∧
      ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (W_Y a))
    (ψ_Y : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      ↥(B S) →+* ↑(Y.presheaf.obj (Opposite.op (Finset.inf S W_Y))))
    (hψ_surj_ker : ∀ (S : Finset (Fin (N + 1))) (hS : S.Nonempty),
      Function.Surjective (ψ_Y S hS) ∧
      ∀ z : ↥(B S),
        ψ_Y S hS z = 0 ↔
          ∃ (π : ↥V) (b : F),
