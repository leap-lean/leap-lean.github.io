    (hπ_comm : π ≫ (weilProjectiveSpaceOver ↥V 1).hom = g_semi)
    (hπ_pole : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) ↥V) :=
        MvPolynomial.gradedAlgebra
