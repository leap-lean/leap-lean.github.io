      have hm_snd : m_pb ≫ C.homOfLE (inf_le_right : U_fam a ⊓ U_fam b ≤ U_fam b) = snd := by
        rw [← cancel_mono (U_fam b).ι, Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι,
