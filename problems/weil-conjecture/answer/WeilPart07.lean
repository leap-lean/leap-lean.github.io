        have hr₀_ne : r₀ ≠ r := hr_ne.symm
        obtain ⟨t₀, ht₀⟩ := Fin.exists_succAbove_eq hr₀_ne
        have ha_mem_r : a ∈ Set.range (I.1 ∘ r.succAbove) :=
