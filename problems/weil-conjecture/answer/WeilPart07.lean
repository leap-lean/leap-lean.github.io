        ((congrArg (_ ≫ ·) h3).trans
          ((Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ U.topIso.inv) (AlgebraicGeometry.Scheme.Hom.appLE_map g le_rfl _))))
    have hmap : g.appLE ⊤ V_o le_top ≫ C.presheaf.map (CategoryTheory.homOfLE hle).op =
        g.appLE ⊤ U le_top :=
      AlgebraicGeometry.Scheme.Hom.appLE_map g le_top (CategoryTheory.homOfLE hle).op
    have htot : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ (U.ι ≫ g).appTop =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ g.appLE ⊤ V_o le_top) ≫
          C.presheaf.map (CategoryTheory.homOfLE hle).op ≫ U.topIso.inv := by
      rw [hcomp, ← hmap]
