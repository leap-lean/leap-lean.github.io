        C_semi.presheaf.map (CategoryTheory.homOfLE (le_top : Finset.inf {a} W ≤ ⊤)).op).hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom π_a)
