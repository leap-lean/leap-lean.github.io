      obtain ⟨t, ht⟩ := hSing_compact.elim_finite_subcover O hO_open hSub
      have hSing_eq : Sing = ⋃ y ∈ t, (O y ∩ Sing) := by
        ext z
        simp only [Set.mem_iUnion, Set.mem_inter_iff]
        constructor
        · intro hz
          obtain ⟨y, hy_t, hz_O⟩ := Set.mem_iUnion₂.mp (ht hz)
