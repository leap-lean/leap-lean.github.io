        dsimp only [g] at h1
        split_ifs at h1 <;> simp only [Fin.val_succ, Fin.val_castSucc] at h1 <;> omega
      · intro x
        exact Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩
      · intro ⟨⟨r, hr⟩, ⟨q, hq⟩⟩
        dsimp only [g]
        split_ifs with h1 h2 h3
        · simp only [Fin.val_succ] at h2; omega
        · ext <;> simp
        · (ext <;> simp); omega
        · simp only [Fin.val_castSucc] at h3; omega
    · intro A hA_mono hA_rat ht p ξ hξ J
      rw [Finset.mul_sum]
      apply Subring.sum_mem
      intro q _
      let I_q : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} :=
        ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩
      have hne_Iq : (Finset.univ.image I_q.1).Nonempty :=
        ⟨I_q.1 0, Finset.mem_image_of_mem _ (Finset.mem_univ 0)⟩
