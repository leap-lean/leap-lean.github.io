              (PrimeSpectrum.basicOpen (t_P1 0 1)) =
            (TopologicalSpace.Opens.map j₁.base).obj (C.basicOpen t₀) := by
          rw [AlgebraicGeometry.SpecMap_preimage_basicOpen,
            hAff₁.fromSpec_preimage_basicOpen t₀]
          exact congrArg PrimeSpectrum.basicOpen hψ₁_1
        have hq_mem : q ∈ (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)).base).obj
            (PrimeSpectrum.basicOpen (t_P1 0 1)) := hq'
        have hjq_bas : j₁.base q ∈ C.basicOpen t₀ := by
          change q ∈ (TopologicalSpace.Opens.map j₁.base).obj (C.basicOpen t₀)
          rw [← h_open_eq1]
          exact hq_mem
        rw [hBas₁] at hjq_bas
        exact hjq_bas.1
    · intro hx₀
      rw [← hAff₀.range_fromSpec] at hx₀
      rcases hx₀ with ⟨p, rfl⟩
      let p' := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)).base p
      have hπjp : π.base (j₀.base p) = (hAff_P1 1).fromSpec.base p' := by
        change (j₀ ≫ π).base p = f₀.base p
        rw [hj₀_π]
      change π.base (j₀.base p) ∈ (U_P1 : Set P₁.left)
      rw [hπjp, ← (hAff_P1 1).range_fromSpec]
      exact ⟨p', rfl⟩
  have hpre₀ : (TopologicalSpace.Opens.map π.base).obj U_P0 = V₁ := by
    ext x
    constructor
    · intro hπx
      have hx_top : x ∈ (⊤ : C.Opens) := trivial
      rw [← hCov] at hx_top
      rcases hx_top with hx₀ | hx₁
      · rw [← hAff₀.range_fromSpec] at hx₀
        rcases hx₀ with ⟨p, rfl⟩
        let p' := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)).base p
        have hπjp : π.base (j₀.base p) = (hAff_P1 1).fromSpec.base p' := by
          change (j₀ ≫ π).base p = f₀.base p
          rw [hj₀_π]
        have h_in1 : (hAff_P1 1).fromSpec.base p' ∈ U_P1 := by
          change (hAff_P1 1).fromSpec.base p' ∈ (U_P1 : Set P₁.left)
          rw [← (hAff_P1 1).range_fromSpec]
          exact ⟨p', rfl⟩
        have h_in0 : (hAff_P1 1).fromSpec.base p' ∈ U_P0 := by
          rw [← hπjp]
          exact hπx
        have h_basP : (hAff_P1 1).fromSpec.base p' ∈ P₁.left.basicOpen (t_P1 1 0) := by
          rw [hBas_P1 1 0]
          exact ⟨h_in1, h_in0⟩
        have hp' : p' ∈ PrimeSpectrum.basicOpen (t_P1 1 0) := by
          rw [← (hAff_P1 1).fromSpec_preimage_basicOpen (t_P1 1 0)]
          exact h_basP
        have h_open_eq0 :
            (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)).base).obj
              (PrimeSpectrum.basicOpen (t_P1 1 0)) =
            (TopologicalSpace.Opens.map j₀.base).obj (C.basicOpen h₀) := by
          rw [AlgebraicGeometry.SpecMap_preimage_basicOpen,
            hAff₀.fromSpec_preimage_basicOpen h₀]
          exact congrArg PrimeSpectrum.basicOpen hψ₀_0
        have hp_mem : p ∈ (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)).base).obj
            (PrimeSpectrum.basicOpen (t_P1 1 0)) := hp'
        have hjp_bas : j₀.base p ∈ C.basicOpen h₀ := by
          change p ∈ (TopologicalSpace.Opens.map j₀.base).obj (C.basicOpen h₀)
          rw [← h_open_eq0]
          exact hp_mem
        rw [hBas₀] at hjp_bas
        exact hjp_bas.2
      · exact hx₁
    · intro hx₁
      rw [← hAff₁.range_fromSpec] at hx₁
      rcases hx₁ with ⟨q, rfl⟩
      let q' := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)).base q
      have hπjq : π.base (j₁.base q) = (hAff_P1 0).fromSpec.base q' := by
        change (j₁ ≫ π).base q = f₁.base q
        rw [hj₁_π]
      change π.base (j₁.base q) ∈ (U_P0 : Set P₁.left)
      rw [hπjq, ← (hAff_P1 0).range_fromSpec]
      exact ⟨q', rfl⟩
  have : AlgebraicGeometry.IsProper P₁.hom := hProp_P1
  have : AlgebraicGeometry.IsSeparated P₁.hom := inferInstance
  have : AlgebraicGeometry.IsProper (π ≫ P₁.hom) := by
    rw [hπ_g]
    infer_instance
  have hProp_π : AlgebraicGeometry.IsProper π :=
    AlgebraicGeometry.IsProper.of_comp π P₁.hom
  have hAffHom_π : AlgebraicGeometry.IsAffineHom π := by
    apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
    intro z
    have hz_top : z ∈ (⊤ : P₁.left.Opens) := trivial
    rw [← hSup_P1, TopologicalSpace.Opens.mem_iSup] at hz_top
    rcases hz_top with ⟨a, ha⟩
    fin_cases a
    · exact ⟨U_P0, ha, hAff_P1 0, hpre₀.symm ▸ hAff₁⟩
    · exact ⟨U_P1, ha, hAff_P1 1, hpre₁.symm ▸ hAff₀⟩
  have hFin_π : AlgebraicGeometry.IsFinite π :=
    AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_π, hAffHom_π⟩
  
  have hFin_app1 : (π.app U_P1).hom.Finite :=
    ((AlgebraicGeometry.isFinite_iff π).mp hFin_π).2 U_P1 (hAff_P1 1)
  have hFin_app0 : (π.app U_P0).hom.Finite :=
    ((AlgebraicGeometry.isFinite_iff π).mp hFin_π).2 U_P0 (hAff_P1 0)
  have : AlgebraicGeometry.IsOpenImmersion (hAff_P1 1).fromSpec :=
    (hAff_P1 1).isOpenImmersion_fromSpec
  have : AlgebraicGeometry.IsOpenImmersion (hAff_P1 0).fromSpec :=
    (hAff_P1 0).isOpenImmersion_fromSpec
  have h_appLE1 : π.appLE U_P1 V₀ hpre₁.ge = CommRingCat.ofHom ψ₀ := by
    apply AlgebraicGeometry.Spec.map_injective
    apply (CategoryTheory.cancel_mono (hAff_P1 1).fromSpec).mp
    rw [(hAff_P1 1).SpecMap_appLE_fromSpec π hAff₀ hpre₁.ge]
    exact hj₀_π
  have h_appLE0 : π.appLE U_P0 V₁ hpre₀.ge = CommRingCat.ofHom ψ₁ := by
    apply AlgebraicGeometry.Spec.map_injective
    apply (CategoryTheory.cancel_mono (hAff_P1 0).fromSpec).mp
    rw [(hAff_P1 0).SpecMap_appLE_fromSpec π hAff₁ hpre₀.ge]
    exact hj₁_π
  have hFin_ψ₀ : ψ₀.Finite := by
    let res_ge := C.presheaf.map (CategoryTheory.homOfLE hpre₁.ge).op
    let res_le := C.presheaf.map (CategoryTheory.homOfLE hpre₁.le).op
    have h_comp : π.app U_P1 ≫ res_ge = CommRingCat.ofHom ψ₀ := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE_map, h_appLE1]
    have h_surj : Function.Surjective res_ge.hom := by
      intro y
      refine ⟨res_le.hom y, ?_⟩
      have h_id : res_le ≫ res_ge = 𝟙 R₀ := by
        rw [← C.presheaf.map_comp,
          Subsingleton.elim
            ((CategoryTheory.homOfLE hpre₁.le).op ≫ (CategoryTheory.homOfLE hpre₁.ge).op)
            (𝟙 (Opposite.op V₀)),
          C.presheaf.map_id]
      exact congrArg (fun φ => φ.hom y) h_id
    have hFin_res : res_ge.hom.Finite := RingHom.Finite.of_surjective res_ge.hom h_surj
    have hψ₀_eq : ψ₀ = res_ge.hom.comp (π.app U_P1).hom := by
      ext x
      exact congrArg (fun φ => φ.hom x) h_comp.symm
    rw [hψ₀_eq]
    exact hFin_res.comp hFin_app1
  have hFin_ψ₁ : ψ₁.Finite := by
    let res_ge := C.presheaf.map (CategoryTheory.homOfLE hpre₀.ge).op
    let res_le := C.presheaf.map (CategoryTheory.homOfLE hpre₀.le).op
    have h_comp : π.app U_P0 ≫ res_ge = CommRingCat.ofHom ψ₁ := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE_map, h_appLE0]
    have h_surj : Function.Surjective res_ge.hom := by
      intro y
      refine ⟨res_le.hom y, ?_⟩
      have h_id : res_le ≫ res_ge = 𝟙 R₁ := by
        rw [← C.presheaf.map_comp,
          Subsingleton.elim
            ((CategoryTheory.homOfLE hpre₀.le).op ≫ (CategoryTheory.homOfLE hpre₀.ge).op)
            (𝟙 (Opposite.op V₁)),
          C.presheaf.map_id]
      exact congrArg (fun φ => φ.hom y) h_id
    have hFin_res : res_ge.hom.Finite := RingHom.Finite.of_surjective res_ge.hom h_surj
    have hψ₁_eq : ψ₁ = res_ge.hom.comp (π.app U_P0).hom := by
      ext x
      exact congrArg (fun φ => φ.hom x) h_comp.symm
    rw [hψ₁_eq]
    exact hFin_res.comp hFin_app0
  let α₀ : Polynomial R →+* ↑A₁ := Polynomial.eval₂RingHom (c_P1 1) (t_P1 1 0)
  have hSurj_α₀ : Function.Surjective α₀ := by
    rw [← RingHom.range_eq_top, eq_top_iff, ← hGen_P1 1, Subring.closure_le]
    rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
    · exact ⟨Polynomial.C r, Polynomial.eval₂_C _ _⟩
    · revert b
      rw [Fin.forall_fin_two]
      refine ⟨⟨Polynomial.X, Polynomial.eval₂_X _ _⟩, ?_⟩
      rw [ht_diag 1]
      exact ⟨1, map_one α₀⟩
  have hFin_α₀ : α₀.Finite := RingHom.Finite.of_surjective α₀ hSurj_α₀
  have h_eval₀ : Polynomial.eval₂RingHom φ₀ h₀ = ψ₀.comp α₀ := by
    apply Polynomial.ringHom_ext'
    · ext r
      simp [α₀, ← hψ₀_c]
    · simp [α₀, hψ₀_0]
  let α₁ : Polynomial R →+* ↑A₀ := Polynomial.eval₂RingHom (c_P1 0) (t_P1 0 1)
  have hSurj_α₁ : Function.Surjective α₁ := by
    rw [← RingHom.range_eq_top, eq_top_iff, ← hGen_P1 0, Subring.closure_le]
    rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
    · exact ⟨Polynomial.C r, Polynomial.eval₂_C _ _⟩
    · revert b
      rw [Fin.forall_fin_two]
      refine ⟨?_, ⟨Polynomial.X, Polynomial.eval₂_X _ _⟩⟩
      rw [ht_diag 0]
      exact ⟨1, map_one α₁⟩
  have hFin_α₁ : α₁.Finite := RingHom.Finite.of_surjective α₁ hSurj_α₁
  have h_eval₁ : Polynomial.eval₂RingHom φ₁ t₀ = ψ₁.comp α₁ := by
    apply Polynomial.ringHom_ext'
    · ext r
      simp [α₁, ← hψ₁_c]
    · simp [α₁, hψ₁_1]
  refine ⟨?_, ?_⟩
  · rw [h_eval₀]
    exact hFin_ψ₀.comp hFin_α₀
  · rw [h_eval₁]
    exact hFin_ψ₁.comp hFin_α₁

theorem weil_smoothCurve_section_zeroLocus_finite (k₀ : Type u) [Field k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (sndY : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    [AlgebraicGeometry.IsProper sndY]
    (hFinY : (irreducibleComponents ↥Y).Finite)
    (U₁ : Y.Opens)
    (hGen : ∀ E ∈ irreducibleComponents ↥Y,
      ∃ η_E ∈ E, closure ({η_E} : Set ↥Y) = E ∧ η_E ∈ U₁)
    (hSm : ∀ y : ↥Y, y ∉ U₁ →
      ∃ V_sm : Y.Opens,
        y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ sndY)) :
    ((U₁ : Set ↥Y)ᶜ).Finite :=
by
  let _ := hFinY
  have : CompactSpace ↥Y := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace sndY
  let K₀ : Set ↥Y := (U₁ : Set ↥Y)ᶜ
  have hK₀_closed : IsClosed K₀ := U₁.isOpen.isClosed_compl
  have hK₀_compact : IsCompact K₀ := hK₀_closed.isCompact
  have hEtaleFin : ∀ (S : Type u) [CommRing S] (g_poly : Polynomial k₀ →+* S),
      g_poly.Etale →
      ∀ (Z : Set (PrimeSpectrum S)),
        IsClosed Z →
        (∀ p : PrimeSpectrum S, p.asIdeal ∈ minimalPrimes S → p ∉ Z) →
        Z.Finite := by
    intro S _ g_poly hg_poly Z hZ_cl hZ_no_min
    let : Algebra (Polynomial k₀) S := g_poly.toAlgebra
    have : Algebra.Etale (Polynomial k₀) S := hg_poly.toAlgebra
    have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing (Polynomial k₀) S
    have hFibEq : ∀ (q₁ q₂ : PrimeSpectrum S),
        q₁ ≤ q₂ →
        PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) q₁ =
          PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) q₂ →
        q₁ = q₂ := by
      intro q₁ q₂ hq₁₂ hcomap
      let P : PrimeSpectrum (Polynomial k₀) :=
        PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) q₁
      have : P.asIdeal.IsPrime := P.isPrime
      let F := P.asIdeal.ResidueField
      let B := P.asIdeal.Fiber S
      have : Module.Finite F B := Algebra.QuasiFinite.finite_fiber P.asIdeal
      have : Algebra.IsIntegral F B := Algebra.IsIntegral.of_finite F B
      let e_fib := PrimeSpectrum.preimageOrderIsoFiber (Polynomial k₀) S P
      let u₁ : ↑(PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) ⁻¹' {P}) := ⟨q₁, rfl⟩
      let u₂ : ↑(PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) ⁻¹' {P}) := ⟨q₂, hcomap.symm⟩
      let Q₁ : PrimeSpectrum B := e_fib u₁
      let Q₂ : PrimeSpectrum B := e_fib u₂
      have hQ₁₂ : Q₁.asIdeal ≤ Q₂.asIdeal := (e_fib.le_iff_le).mpr hq₁₂
      have : (Ideal.comap (algebraMap F B) Q₁.asIdeal).IsPrime :=
        Ideal.IsPrime.comap (algebraMap F B)
      have h_bot_eq : (⊥ : Ideal F) = Ideal.comap (algebraMap F B) Q₁.asIdeal :=
        (@Ideal.bot_isMaximal F _).eq_of_le (Ideal.IsPrime.ne_top inferInstance) bot_le
      have hQ₁_over : Q₁.asIdeal ∈ (⊥ : Ideal F).primesOver B := ⟨Q₁.isPrime, ⟨h_bot_eq⟩⟩
      have hQ₁_max : Q₁.asIdeal.IsMaximal :=
        @Ideal.isMaximal_of_mem_primesOver F _ (⊥ : Ideal F) Ideal.bot_isMaximal B _ _ _
          Q₁.asIdeal hQ₁_over
      have hQ_eq : Q₁ = Q₂ :=
        PrimeSpectrum.ext (hQ₁_max.eq_of_le Q₂.isPrime.ne_top hQ₁₂)
      exact congrArg Subtype.val (e_fib.injective hQ_eq)
    have hDichot : ∀ q : PrimeSpectrum S,
        q.asIdeal ∈ minimalPrimes S ∨ q.asIdeal.IsMaximal := by
      intro q
      let P : PrimeSpectrum (Polynomial k₀) :=
        PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) q
      by_cases hP_bot : P.asIdeal = ⊥
      · left
        rw [minimalPrimes_eq_minimals]
        refine ⟨q.isPrime, fun J hJ_prime hJ_le_q => ?_⟩
        let q' : PrimeSpectrum S := ⟨J, hJ_prime⟩
        have hcomap_le : (PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) q').asIdeal ≤ ⊥ := by
          calc
            Ideal.comap (algebraMap (Polynomial k₀) S) J ≤
                Ideal.comap (algebraMap (Polynomial k₀) S) q.asIdeal :=
              Ideal.comap_mono hJ_le_q
            _ = P.asIdeal := rfl
            _ = ⊥ := hP_bot
        have hcomap_eq :
            PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) q' = P :=
          PrimeSpectrum.ext ((le_bot_iff.mp hcomap_le).trans hP_bot.symm)
        have hq'_eq : q' = q := hFibEq q' q hJ_le_q hcomap_eq
        exact le_of_eq (congrArg PrimeSpectrum.asIdeal hq'_eq).symm
      · right
        have hP_max : P.asIdeal.IsMaximal :=
          @IsPrime.to_maximal_ideal (Polynomial k₀) _ _ _ P.asIdeal P.isPrime hP_bot
        obtain ⟨𝔪, h𝔪_max, hq_le_𝔪⟩ := Ideal.exists_le_maximal q.asIdeal q.isPrime.ne_top
        have : 𝔪.IsPrime := h𝔪_max.isPrime
        let m_pt : PrimeSpectrum S := ⟨𝔪, inferInstance⟩
        let P_m : PrimeSpectrum (Polynomial k₀) :=
          PrimeSpectrum.comap (algebraMap (Polynomial k₀) S) m_pt
        have hP_le_Pm : P.asIdeal ≤ P_m.asIdeal := Ideal.comap_mono hq_le_𝔪
        have hP_eq_Pm : P = P_m :=
          PrimeSpectrum.ext (hP_max.eq_of_le P_m.isPrime.ne_top hP_le_Pm)
        have hq_eq_m : q = m_pt := hFibEq q m_pt hq_le_𝔪 hP_eq_Pm
        have hq_ideal_eq : q.asIdeal = 𝔪 := congrArg PrimeSpectrum.asIdeal hq_eq_m
        rw [hq_ideal_eq]
        exact h𝔪_max
    let I : Ideal S := PrimeSpectrum.vanishingIdeal Z
    have hZ_zero : PrimeSpectrum.zeroLocus (I : Set S) = Z := by
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hZ_cl.closure_eq]
    have hZ_min : ∀ q ∈ Z, q.asIdeal ∈ I.minimalPrimes := by
      intro q hq
      have hq_zero : q ∈ PrimeSpectrum.zeroLocus (I : Set S) := by
        rw [hZ_zero]
        exact hq
      have hI_le_q : I ≤ q.asIdeal :=
        SetLike.coe_subset_coe.mp ((PrimeSpectrum.mem_zeroLocus q (I : Set S)).mp hq_zero)
      refine ⟨⟨q.isPrime, hI_le_q⟩, fun J ⟨hJ_prime, hI_le_J⟩ hJ_le_q => ?_⟩
      let q' : PrimeSpectrum S := ⟨J, hJ_prime⟩
      rcases hDichot q' with hJ_min | hJ_max
      · exfalso
        have hq'_zero : q' ∈ PrimeSpectrum.zeroLocus (I : Set S) :=
          (PrimeSpectrum.mem_zeroLocus q' (I : Set S)).mpr (SetLike.coe_subset_coe.mpr hI_le_J)
        rw [hZ_zero] at hq'_zero
        exact hZ_no_min q' hJ_min hq'_zero
      · have hJ_eq : J = q.asIdeal := hJ_max.eq_of_le q.isPrime.ne_top hJ_le_q
        exact le_of_eq hJ_eq.symm
    have hMinFin : (I.minimalPrimes).Finite :=
      Ideal.finite_minimalPrimes_of_isNoetherianRing S I
    have hImgFin : (PrimeSpectrum.asIdeal '' Z).Finite := by
      refine hMinFin.subset ?_
      rintro _ ⟨q, hq, rfl⟩
      exact hZ_min q hq
    exact Set.Finite.of_finite_image hImgFin (fun _ _ _ _ h => PrimeSpectrum.ext h)
  have hLocal : ∀ y : ↥K₀, ∃ O : Set ↥Y, IsOpen O ∧ y.1 ∈ O ∧ (O ∩ K₀).Finite := by
    intro y
    obtain ⟨V_sm, hy_V, hSm_V⟩ := hSm y.1 y.2
    obtain ⟨U_base, _hU_aff, W', hW'_aff, hy_W', he_sub, hStd⟩ :=
      @AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
        1 _ _ (V_sm.ι ≫ sndY) hSm_V ⟨y.1, hy_V⟩
    let R_U : Type u := ↑((AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.obj (Opposite.op U_base))
    let S_y : Type u := ↑(V_sm.toScheme.presheaf.obj (Opposite.op W'))
    obtain ⟨g₁, _, hg₁_et⟩ := hStd.exists_etale_mvPolynomial
    have hU_top : U_base = ⊤ := by
      have hz₀ : (V_sm.ι ≫ sndY).base ⟨y.1, hy_V⟩ ∈ U_base := he_sub hy_W'
      ext z
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      have hz_eq : z = (V_sm.ι ≫ sndY).base ⟨y.1, hy_V⟩ := Subsingleton.elim _ _
      rw [hz_eq]
      exact hz₀
    let iso_k : CommRingCat.of k₀ ≅
        (AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.obj (Opposite.op U_base) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).symm ≪≫
        (AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.mapIso (CategoryTheory.eqToIso hU_top).op
    let e_k : k₀ ≃+* R_U := iso_k.commRingCatIsoToRingEquiv
    let e_poly : Polynomial k₀ ≃+* MvPolynomial (Fin 1) R_U :=
      (MvPolynomial.uniqueAlgEquiv k₀ (Fin 1)).symm.toRingEquiv.trans
        (MvPolynomial.mapEquiv (Fin 1) e_k)
    have hg_poly : (g₁.comp e_poly.toRingHom).Etale :=
      RingHom.Etale.stableUnderComposition e_poly.toRingHom g₁
        (RingHom.Etale.of_bijective e_poly.bijective) hg₁_et
    have : AlgebraicGeometry.IsOpenImmersion hW'_aff.fromSpec := hW'_aff.isOpenImmersion_fromSpec
    let φ_y : AlgebraicGeometry.Spec (V_sm.toScheme.presheaf.obj (Opposite.op W')) ⟶ Y :=
      hW'_aff.fromSpec ≫ V_sm.ι
    have : AlgebraicGeometry.IsOpenImmersion φ_y := inferInstance
    let f_y : PrimeSpectrum S_y → ↥Y := fun p => φ_y.base p
    have hf_open : Topology.IsOpenEmbedding f_y := φ_y.isOpenEmbedding
    let O_y : Set ↥Y := Set.range f_y
    have hOy_open : IsOpen O_y := hf_open.isOpen_range
    have hy_Oy : y.1 ∈ O_y := by
      have hy_range : (⟨y.1, hy_V⟩ : ↥V_sm.toScheme) ∈ Set.range hW'_aff.fromSpec.base := by
        rw [hW'_aff.range_fromSpec]
        exact hy_W'
      rcases hy_range with ⟨q_y, hqy⟩
      refine ⟨q_y, ?_⟩
      change V_sm.ι.base (hW'_aff.fromSpec.base q_y) = y.1
      rw [hqy]
      exact V_sm.ι_apply ⟨y.1, hy_V⟩
    let Z_y : Set (PrimeSpectrum S_y) := f_y ⁻¹' K₀
    have hZy_cl : IsClosed Z_y := hK₀_closed.preimage hf_open.continuous
    have hZy_no_min : ∀ p₀ : PrimeSpectrum S_y, p₀.asIdeal ∈ minimalPrimes S_y → p₀ ∉ Z_y := by
      intro p₀ hp₀_min hp₀_Z
      let x₀ : ↥Y := f_y p₀
      have hx₀_Oy : x₀ ∈ O_y := ⟨p₀, rfl⟩
      let E : Set ↥Y := irreducibleComponent x₀
      have hE_mem : E ∈ irreducibleComponents ↥Y := irreducibleComponent_mem_irreducibleComponents x₀
      have hx₀_E : x₀ ∈ E := mem_irreducibleComponent
      obtain ⟨η_E, _hη_E, hcl_η, hη_U₁⟩ := hGen E hE_mem
      have hη_Oy : η_E ∈ O_y := by
        by_contra hnot
        have hsub : E ⊆ O_yᶜ := by
          rw [← hcl_η]
          exact closure_minimal (Set.singleton_subset_iff.mpr hnot) hOy_open.isClosed_compl
        exact hsub hx₀_E hx₀_Oy
      rcases hη_Oy with ⟨q_E, hqE_eq⟩
      have hp₀_cl : p₀ ∈ closure ({q_E} : Set (PrimeSpectrum S_y)) := by
        rw [hf_open.isEmbedding.closure_eq_preimage_closure_image, Set.image_singleton,
          hqE_eq, hcl_η]
        exact hx₀_E
      have hqE_le : q_E.asIdeal ≤ p₀.asIdeal :=
        (PrimeSpectrum.le_iff_mem_closure q_E p₀).mpr hp₀_cl
      rw [minimalPrimes_eq_minimals] at hp₀_min
      have hp₀_le : p₀.asIdeal ≤ q_E.asIdeal := hp₀_min.2 q_E.isPrime hqE_le
      have hp₀_eq : p₀ = q_E := PrimeSpectrum.ext (le_antisymm hp₀_le hqE_le)
      have hx₀_U₁ : f_y p₀ ∈ (U₁ : Set ↥Y) := by
        rw [hp₀_eq, hqE_eq]
        exact hη_U₁
      exact hp₀_Z hx₀_U₁
    have hZy_fin : Z_y.Finite :=
      hEtaleFin S_y (g₁.comp e_poly.toRingHom) hg_poly Z_y hZy_cl hZy_no_min
    have hOyK₀_eq : O_y ∩ K₀ = f_y '' Z_y := by
      ext w
      constructor
      · rintro ⟨⟨p, rfl⟩, hw_K₀⟩
        exact ⟨p, hw_K₀, rfl⟩
      · rintro ⟨p, hp_Z, rfl⟩
        exact ⟨⟨p, rfl⟩, hp_Z⟩
    refine ⟨O_y, hOy_open, hy_Oy, ?_⟩
    rw [hOyK₀_eq]
    exact hZy_fin.image _
  choose O hO_open hy_O hOK₀_fin using hLocal
  obtain ⟨t, ht_cov⟩ := hK₀_compact.elim_finite_subcover O hO_open (by
    intro z hz
    exact Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hy_O ⟨z, hz⟩⟩)
  refine (t.finite_toSet.biUnion (fun y _ => hOK₀_fin y)).subset ?_
  intro z hz
  have hz_cov : z ∈ ⋃ y ∈ t, O y := ht_cov hz
  rw [Set.mem_iUnion₂] at hz_cov ⊢
  rcases hz_cov with ⟨y, hy_t, hz_Oy⟩
  exact ⟨y, hy_t, hz_Oy, hz⟩

theorem weil_etaleNodal_proj_closedPoint_linearForms (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (R : Type u) [CommRing R]
    (φ_Rk : R →+* k₀)
    (hSurj : Function.Surjective φ_Rk)
    (M : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u})
    (sndY : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀)) :
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P_M := (weilProjectiveSpaceOver R M).left
    let p_M := (weilProjectiveSpaceOver R M).hom
    ∀ (ι_YV : Y ⟶ P_M),
      ι_YV ≫ p_M = sndY ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Rk) →
      ∀ (q : ↥Y)
        (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : ↥U')
        (e₁ : U' ⟶ Y)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₂ →
        e₁.base u₀ = q →
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) →
        e₁ ≫ sndY =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
        ∃ (a₀ : Fin (M + 1)) (c : Fin (M + 1) → R),
          ι_YV.base q ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a₀) ∧
          ∀ b : Fin (M + 1),
            ι_YV.base q ∉ AlgebraicGeometry.Proj.basicOpen 𝒜
              (MvPolynomial.X b - MvPolynomial.C (c b) * MvPolynomial.X a₀) :=
by
  intro 𝒜 P_M p_M ι_YV hComm_YV q U' u₀ e₁ e₂ hEt₂ hu₀_eq hXi he_comm
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let z : ↥(AlgebraicGeometry.Proj 𝒜) := ι_YV.base q
  
  have ha₀_ex : ∃ a₀ : Fin (M + 1), z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a₀) := by
    by_contra hNo
    rw [not_exists] at hNo
    have hAll : ∀ a : Fin (M + 1), MvPolynomial.X a ∈ z.asHomogeneousIdeal := by
      intro a
      have ha := hNo a
      rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not] at ha
      exact ha
    let I_z : Ideal (MvPolynomial (Fin (M + 1)) R) := z.asHomogeneousIdeal.toIdeal
    let ρ₁ : MvPolynomial (Fin (M + 1)) R →+* MvPolynomial (Fin (M + 1)) R ⧸ I_z :=
      Ideal.Quotient.mk I_z
    let ρ₂ : MvPolynomial (Fin (M + 1)) R →+* MvPolynomial (Fin (M + 1)) R ⧸ I_z :=
      ((Ideal.Quotient.mk I_z).comp MvPolynomial.C).comp MvPolynomial.constantCoeff
    have hρ_eq : ρ₁ = ρ₂ := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        simp [ρ₁, ρ₂]
      · intro a
        change Ideal.Quotient.mk I_z (MvPolynomial.X a) =
          Ideal.Quotient.mk I_z (MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.X a)))
        rw [MvPolynomial.constantCoeff_X, map_zero, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hAll a)
    apply z.not_irrelevant_le
    rw [HomogeneousIdeal.irrelevant_le]
    intro i hi F hF
    have hF_hom : F.IsHomogeneous i := (MvPolynomial.mem_homogeneousSubmodule i F).mp hF
    have h0_ne : (∑ x ∈ (0 : Fin (M + 1) →₀ ℕ).support, (0 : Fin (M + 1) →₀ ℕ) x) ≠ i := by
      simpa using hi.ne
    have hF_const : MvPolynomial.constantCoeff F = 0 := by
      rw [MvPolynomial.constantCoeff_eq]
      exact hF_hom.coeff_eq_zero h0_ne
    have hρF : ρ₁ F = 0 := by
      rw [hρ_eq]
      change Ideal.Quotient.mk I_z (MvPolynomial.C (MvPolynomial.constantCoeff F)) = 0
      rw [hF_const, map_zero, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp hρF
  obtain ⟨a₀, ha₀⟩ := ha₀_ex
  
  let f_proj : U' ⟶ P_M := e₁ ≫ ι_YV
  let U_proj : P_M.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a₀)
  have hf_u₀ : f_proj.base u₀ = z := by
    change ι_YV.base (e₁.base u₀) = z
    rw [hu₀_eq]
  let W₀ : U'.Opens := (TopologicalSpace.Opens.map f_proj.base).obj U_proj
  have hu₀_W₀ : u₀ ∈ W₀ := by
    change f_proj.base u₀ ∈ U_proj
    rw [hf_u₀]
    exact ha₀
  obtain ⟨W, hW_aff, hu₀_W, hW_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_W₀
  let B_cat : CommRingCat.{u} := U'.presheaf.obj (Opposite.op W)
  let B : Type u := ↑B_cat
  have hu₀_range : u₀ ∈ Set.range hW_aff.fromSpec.base := by
    rw [hW_aff.range_fromSpec]
    exact hu₀_W
  obtain ⟨p_u, hp_u⟩ := hu₀_range
  let p_B : PrimeSpectrum B := p_u
  let Q : Ideal B := p_B.asIdeal
  have : Q.IsPrime := p_B.isPrime
  let I_span : Ideal (MvPolynomial (Fin 2) k₀) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
  let A_nod : Type u := MvPolynomial (Fin 2) k₀ ⧸ I_span
  let α_nod_cat : CommRingCat.of A_nod ⟶ B_cat :=
    AlgebraicGeometry.Spec.preimage (hW_aff.fromSpec ≫ e₂)
  let α_nod : A_nod →+* B := α_nod_cat.hom
  have hSpec_α : AlgebraicGeometry.Spec.map α_nod_cat = hW_aff.fromSpec ≫ e₂ :=
    AlgebraicGeometry.Spec.map_preimage (hW_aff.fromSpec ≫ e₂)
  have : AlgebraicGeometry.IsOpenImmersion hW_aff.fromSpec := hW_aff.isOpenImmersion_fromSpec
  have : AlgebraicGeometry.Etale e₂ := hEt₂
  have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map α_nod_cat) := by
    rw [hSpec_α]
    exact inferInstance
  have hα_et : RingHom.Etale α_nod :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale) (Q := @RingHom.Etale)).mp hEt_spec
  have hComap_Q : Ideal.comap α_nod Q = (e₂.base u₀).asIdeal := by
    have hpt : (AlgebraicGeometry.Spec.map α_nod_cat).base p_u = (hW_aff.fromSpec ≫ e₂).base p_u :=
      congrArg (fun φ => φ.base p_u) hSpec_α
    have hlhs : (AlgebraicGeometry.Spec.map α_nod_cat).base p_u = PrimeSpectrum.comap α_nod p_B := rfl
    have hrhs : (hW_aff.fromSpec ≫ e₂).base p_u = e₂.base u₀ := by
      change e₂.base (hW_aff.fromSpec.base p_u) = e₂.base u₀
      rw [hp_u]
    exact congrArg PrimeSpectrum.asIdeal (hlhs.symm.trans (hpt.trans hrhs))
  
  let c_nod : k₀ →+* A_nod := (Ideal.Quotient.mk I_span).comp MvPolynomial.C
  let γ_k : k₀ →+* B ⧸ Q := ((Ideal.Quotient.mk Q).comp α_nod).comp c_nod
  have hKer_span : ∀ f ∈ I_span, MvPolynomial.constantCoeff f = 0 := by
    intro f hf
    rw [Ideal.mem_span_singleton] at hf
    rcases hf with ⟨g, rfl⟩
    simp [MvPolynomial.constantCoeff_X]
  let π_k : A_nod →+* k₀ := Ideal.Quotient.lift I_span MvPolynomial.constantCoeff hKer_span
  have hTower_eq : γ_k.comp π_k = (Ideal.Quotient.mk Q).comp α_nod := by
    have h_pre : (γ_k.comp π_k).comp (Ideal.Quotient.mk I_span) =
        ((Ideal.Quotient.mk Q).comp α_nod).comp (Ideal.Quotient.mk I_span) := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        change γ_k (π_k (Ideal.Quotient.mk I_span (MvPolynomial.C r))) =
          Ideal.Quotient.mk Q (α_nod (Ideal.Quotient.mk I_span (MvPolynomial.C r)))
        have hπ_C : π_k (Ideal.Quotient.mk I_span (MvPolynomial.C r)) = r := by
          change MvPolynomial.constantCoeff (MvPolynomial.C r) = r
          simp
        rw [hπ_C]
        rfl
      · intro i
        change γ_k (π_k (Ideal.Quotient.mk I_span (MvPolynomial.X i))) =
          Ideal.Quotient.mk Q (α_nod (Ideal.Quotient.mk I_span (MvPolynomial.X i)))
        have hπ_X : π_k (Ideal.Quotient.mk I_span (MvPolynomial.X i)) = 0 := by
          change MvPolynomial.constantCoeff (MvPolynomial.X i) = 0
          simp
        have hmemQ : α_nod (Ideal.Quotient.mk I_span (MvPolynomial.X i)) ∈ Q := by
          change Ideal.Quotient.mk I_span (MvPolynomial.X i) ∈ Ideal.comap α_nod Q
          rw [hComap_Q]
          exact hXi i
        rw [hπ_X, map_zero, Ideal.Quotient.eq_zero_iff_mem.mpr hmemQ]
    apply RingHom.ext
    intro x
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective (I := I_span) x
    exact congrArg (fun φ => φ f) h_pre
  have hγ_surj : Function.Surjective γ_k := by
    letI : Algebra A_nod B := α_nod.toAlgebra
    have : Algebra.Etale A_nod B := hα_et.toAlgebra
    letI : Algebra A_nod k₀ := π_k.toAlgebra
    letI : Algebra k₀ (B ⧸ Q) := γ_k.toAlgebra
    letI : Algebra A_nod (B ⧸ Q) := ((Ideal.Quotient.mk Q).comp α_nod).toAlgebra
    have : IsScalarTower A_nod k₀ (B ⧸ Q) := IsScalarTower.of_algebraMap_eq' hTower_eq.symm
    have : IsScalarTower A_nod B (B ⧸ Q) := IsScalarTower.of_algebraMap_eq' rfl
    let E := TensorProduct A_nod k₀ B
    have : Algebra.Etale k₀ E := Algebra.Etale.baseChange A_nod B k₀
    obtain ⟨I, hFinI, Ai, instFieldAi, instAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k₀ E).mp inferInstance
    have : Finite I := hFinI
    letI : ∀ i, Field (Ai i) := instFieldAi
    letI : ∀ i, Algebra k₀ (Ai i) := instAlgAi
    have : ∀ i, Module.Finite k₀ (Ai i) := fun i => (hFinSep i).1
    have : Module.Finite k₀ ((i : I) → Ai i) := inferInstance
    have : Module.Finite k₀ E := Module.Finite.equiv e_prod.symm.toLinearEquiv
    let Φ : E →ₐ[k₀] (B ⧸ Q) :=
      Algebra.TensorProduct.lift (Algebra.ofId k₀ (B ⧸ Q))
        (Ideal.Quotient.mkₐ A_nod Q) (fun _ _ => Commute.all _ _)
    have hΦ_surj : Function.Surjective Φ := by
      intro y
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨1 ⊗ₜ[A_nod] b, ?_⟩
      dsimp only [Φ]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have : Module.Finite k₀ (B ⧸ Q) := Module.Finite.of_surjective Φ.toLinearMap hΦ_surj
    have : Algebra.IsIntegral k₀ (B ⧸ Q) := Algebra.IsIntegral.of_finite k₀ (B ⧸ Q)
    have : IsDomain (B ⧸ Q) := (Ideal.Quotient.isDomain_iff_prime Q).mpr inferInstance
    exact (@IsAlgClosed.algebraMap_bijective_of_isIntegral k₀ (B ⧸ Q) _ _ _ _ _ _).2
  
  have hXa₀ : MvPolynomial.X a₀ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X R a₀
  let ι_a₀ := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one
  have : AlgebraicGeometry.IsOpenImmersion ι_a₀ :=
    @AlgebraicGeometry.Proj.instIsOpenImmersionAwayι _ _ _ _ _ 𝒜 _ (MvPolynomial.X a₀) 1 hXa₀ zero_lt_one
  let g_W : AlgebraicGeometry.Spec B_cat ⟶ AlgebraicGeometry.Proj 𝒜 := hW_aff.fromSpec ≫ f_proj
  have hRange_gW : Set.range g_W.base ⊆ Set.range ι_a₀.base := by
    have h_range_ι : Set.range ι_a₀.base = (U_proj : Set ↥P_M) := by
      rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange ι_a₀,
        AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one]
      rfl
    rw [h_range_ι]
    rintro _ ⟨p, rfl⟩
    have hp_W : hW_aff.fromSpec.base p ∈ (W : Set ↥U') := by
      rw [← hW_aff.range_fromSpec]
      exact ⟨p, rfl⟩
    exact hW_sub hp_W
  let g_lift := AlgebraicGeometry.IsOpenImmersion.lift ι_a₀ g_W hRange_gW
  let ψ_cat := AlgebraicGeometry.Spec.preimage g_lift
  let ψ_proj : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a₀) →+* B := ψ_cat.hom
  have hψ_fac : AlgebraicGeometry.Spec.map ψ_cat ≫ ι_a₀ = hW_aff.fromSpec ≫ f_proj := by
    rw [AlgebraicGeometry.Spec.map_preimage]
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac ι_a₀ g_W hRange_gW
  have hz_eq : ι_a₀.base (PrimeSpectrum.comap ψ_proj p_B) = z := by
    have hpt : (AlgebraicGeometry.Spec.map ψ_cat ≫ ι_a₀).base p_u =
        (hW_aff.fromSpec ≫ f_proj).base p_u :=
      congrArg (fun φ => φ.base p_u) hψ_fac
    have hlhs : (AlgebraicGeometry.Spec.map ψ_cat ≫ ι_a₀).base p_u =
        ι_a₀.base (PrimeSpectrum.comap ψ_proj p_B) := rfl
    have hrhs : (hW_aff.fromSpec ≫ f_proj).base p_u = z := by
      change f_proj.base (hW_aff.fromSpec.base p_u) = z
      rw [hp_u, hf_u₀]
    exact hlhs.symm.trans (hpt.trans hrhs)
  have hBase_B : ∀ r : R,
      ψ_proj (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a₀))
        (algebraMap R ↥(𝒜 0) r)) = α_nod (c_nod (φ_Rk r)) := by
    have h_comp : (AlgebraicGeometry.Spec.map ψ_cat ≫ ι_a₀) ≫ p_M =
        (hW_aff.fromSpec ≫ f_proj) ≫ p_M :=
      congrArg (fun φ => φ ≫ p_M) hψ_fac
    have hlhs : (AlgebraicGeometry.Spec.map ψ_cat ≫ ι_a₀) ≫ p_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((ψ_proj.comp (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X a₀)))).comp (algebraMap R ↥(𝒜 0)))) := by
      change (AlgebraicGeometry.Spec.map ψ_cat ≫ ι_a₀) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) = _
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc ι_a₀,
        AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X a₀) hXa₀ zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hrhs : (hW_aff.fromSpec ≫ f_proj) ≫ p_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((α_nod.comp c_nod).comp φ_Rk)) := by
      dsimp only [f_proj]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hComm_YV,
        ← CategoryTheory.Category.assoc e₁, he_comm,
        CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc hW_aff.fromSpec,
        ← hSpec_α, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have h_hom := AlgebraicGeometry.Spec.map_injective (hlhs.symm.trans (h_comp.trans hrhs))
    intro r
    exact congrArg (fun φ => φ.hom r) h_hom
  
  have hXb1 : ∀ b : Fin (M + 1), MvPolynomial.X b ∈ 𝒜 (1 • 1) := by
    intro b
    rw [one_smul]
    exact MvPolynomial.isHomogeneous_X R b
  have hComp_surj : Function.Surjective (γ_k.comp φ_Rk) := hγ_surj.comp hSurj
  choose c hc using fun b : Fin (M + 1) =>
    hComp_surj (Ideal.Quotient.mk Q (ψ_proj
      (HomogeneousLocalization.Away.mk 𝒜 hXa₀ 1 (MvPolynomial.X b) (hXb1 b))))
  refine ⟨a₀, c, ha₀, fun b hMem => ?_⟩
  let L_b : MvPolynomial (Fin (M + 1)) R :=
    MvPolynomial.X b - MvPolynomial.C (c b) * MvPolynomial.X a₀
  have hXb : MvPolynomial.X b ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X R b
  have hLin_b : L_b ∈ 𝒜 1 := by
    apply Submodule.sub_mem
    · exact hXb
    · have hC : (MvPolynomial.C (c b) : MvPolynomial (Fin (M + 1)) R) ∈ 𝒜 0 :=
        MvPolynomial.isHomogeneous_C (Fin (M + 1)) (c b)
      simpa using SetLike.GradedMul.mul_mem hC hXa₀
  have hSub_b : HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLin_b =
      HomogeneousLocalization.Away.mk 𝒜 hXa₀ 1 (MvPolynomial.X b) (hXb1 b) -
        HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a₀))
          (algebraMap R ↥(𝒜 0) (c b)) := by
    apply HomogeneousLocalization.val_injective
    let S_a₀ : Submonoid (MvPolynomial (Fin (M + 1)) R) :=
      Submonoid.powers (MvPolynomial.X a₀)
    let s_X : ↥S_a₀ := ⟨MvPolynomial.X a₀ ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩
    let s_1 : ↥S_a₀ := ⟨1, one_mem _⟩
    rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk]
    change Localization.mk (L_b ^ 1) s_X =
      Localization.mk (MvPolynomial.X b) s_X -
        Localization.mk (↑(algebraMap R ↥(𝒜 0) (c b))) s_1
    have hcoe_alg : (↑(algebraMap R ↥(𝒜 0) (c b)) : MvPolynomial (Fin (M + 1)) R) =
        MvPolynomial.C (c b) := by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    rw [hcoe_alg, Localization.sub_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    dsimp only [L_b, s_X, s_1]
    simp only [Submonoid.coe_one, Submonoid.coe_mul, pow_one]
    ring
  change z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 L_b at hMem
  rw [← hz_eq] at hMem
  have hPre : PrimeSpectrum.comap ψ_proj p_B ∈
      (TopologicalSpace.Opens.map ι_a₀.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜 L_b) :=
    hMem
  rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hXa₀ zero_lt_one hLin_b zero_lt_one] at hPre
  have hNotMem_Q : ψ_proj (HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLin_b) ∉ Q :=
    hPre
  have hZero_quot : Ideal.Quotient.mk Q
      (ψ_proj (HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLin_b)) = 0 := by
    rw [hSub_b, map_sub, map_sub, hBase_B (c b)]
    change Ideal.Quotient.mk Q (ψ_proj
        (HomogeneousLocalization.Away.mk 𝒜 hXa₀ 1 (MvPolynomial.X b) (hXb1 b))) -
      γ_k (φ_Rk (c b)) = 0
    have hc_b : γ_k (φ_Rk (c b)) =
        Ideal.Quotient.mk Q (ψ_proj
          (HomogeneousLocalization.Away.mk 𝒜 hXa₀ 1 (MvPolynomial.X b) (hXb1 b))) :=
      hc b
    rw [hc_b, sub_self]
  exact hNotMem_Q (Ideal.Quotient.eq_zero_iff_mem.mp hZero_quot)

theorem weil_sup1_vandermonde_gl_pencil_and_koszul_witness (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let fstY := CategoryTheory.Limits.pullback.fst g s₀
    let sndY := CategoryTheory.Limits.pullback.snd g s₀
    let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
    let Δ : Set ↥Y := Z ∩ Y'_set
    (irreducibleComponents ↥Y).Finite →
    AlgebraicGeometry.IsReduced Y →
    {y : ↥Y | ¬ ∃ V_sm : Y.Opens,
      y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ sndY)}.Finite →
    (∀ E ∈ irreducibleComponents ↥Y,
      (∃ η_E ∈ E, closure ({η_E} : Set ↥Y) = E ∧
        ∃ V_sm : Y.Opens,
          η_E ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ sndY)) ∧
      ∀ U_aff : Y.Opens, AlgebraicGeometry.IsAffineOpen U_aff →
        (E \ (U_aff : Set ↥Y)).Nonempty) →
    ∀ (Y'_sch : AlgebraicGeometry.Scheme.{u}) (ιY' : Y'_sch ⟶ Y),
      AlgebraicGeometry.IsClosedImmersion ιY' →
      Set.range ιY'.base = Y'_set →
      ∃ (V₀ V₁ : C.Opens)
        (h₀ : ↑(C.presheaf.obj (Opposite.op V₀)))
        (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
        (u₁_V₁ : ↑(Y.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map fstY.base).obj V₁))))
        (u₁_V₀ : ↑(Y.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map fstY.base).obj V₀)))),
        let R₀ := C.presheaf.obj (Opposite.op V₀)
        let R₁ := C.presheaf.obj (Opposite.op V₁)
        letI : Algebra ↥V ↑R₀ := (
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom.toAlgebra
        letI : Algebra ↥V ↑R₁ := (
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom.toAlgebra
        let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
        let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
        AlgebraicGeometry.IsAffineOpen V₀ ∧
        AlgebraicGeometry.IsAffineOpen V₁ ∧
        V₀ ⊔ V₁ = ⊤ ∧
        C.basicOpen h₀ = V₀ ⊓ V₁ ∧
        C.basicOpen t₀ = V₀ ⊓ V₁ ∧
        (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom h₀ *
          (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom t₀ = 1 ∧
        (Polynomial.aeval (R := ↥V) h₀).toRingHom.Finite ∧
        (Polynomial.aeval (R := ↥V) t₀).toRingHom.Finite ∧
        (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
          (τ j).base b ∈ V₀ ∧ (τ j).base b ∈ V₁) ∧
        (∀ q ∈ Δ, fstY.base q ∈ V₁) ∧
        (∀ y : ↥Y, fstY.base y ∈ V₀ → fstY.base y ∉ (C.basicOpen h₀ : Set C) →
          ∃ W_sm : Y.Opens,
            y ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ sndY)) ∧
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom
            ((fstY.appLE V₀ V₀_Y le_rfl).hom (h₀ ^ 2)) *
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom u₁_V₁ =
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom u₁_V₀ ∧
        (∀ q ∈ Δ, q ∉ (Y.basicOpen u₁_V₁ : Set Y)) ∧
        Y'_set \ (V₁_Y : Set Y) ⊆ (Y.basicOpen u₁_V₀ : Set Y) ∧
        AlgebraicGeometry.IsAffineOpen
          ((TopologicalSpace.Opens.map ιY'.base).obj (Y.basicOpen u₁_V₁ ⊔ Y.basicOpen u₁_V₀)) :=
by
  intro k₀ s₀ Y fstY sndY Y'_set Δ hFinY hRedY hSingFin hCompY Y'_sch ιY' hClY' hRangeY'
  obtain ⟨⟨_hIntC, _hFlat_g, hProp_g, _hLFP_g, _hSurj_g, ⟨M, ιP, hClP, hCommP⟩, hSec_g, _⟩,
    _hDisj_τ, _hSm_τ, hFib_C⟩ := hSemi
  obtain ⟨_hZ_comp, _hClZ, _hIntZ, _hRangeZ, _hIsoP1, _hClY'_set, _hNeY'_set, _hUnionZY',
    _hΔ_fin, hΔ_ge1, hΔ_le2, _hΔ_no_sec, hΔ_not_sm, _⟩ := hUnstab
  let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
  have : 𝔪_V.IsMaximal := inferInstance
  have : 𝔪_V.IsPrime := inferInstance
  have : IsAlgClosed k₀ := hPkg.2.2.2.2.1 𝔪_V hMaxNeBot
  have : Infinite k₀ := IsAlgClosed.instInfinite
  have hSurj_k₀ : Function.Surjective (algebraMap ↥V k₀) :=
    Ideal.algebraMap_residueField_surjective 𝔪_V
  have : AlgebraicGeometry.IsClosedImmersion s₀ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (algebraMap ↥V k₀)) hSurj_k₀
  have : AlgebraicGeometry.IsProper g := hProp_g
  have : AlgebraicGeometry.IsClosedImmersion ιP := hClP
  have : AlgebraicGeometry.IsClosedImmersion ιY' := hClY'
  have : AlgebraicGeometry.IsClosedImmersion fstY := inferInstance
  have : AlgebraicGeometry.IsProper sndY := inferInstance
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) ↥V
  let _instGraded : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P_M := (weilProjectiveSpaceOver ↥V M).left
  let p_M := (weilProjectiveSpaceOver ↥V M).hom
  let ι_YV : Y ⟶ P_M := fstY ≫ ιP
  have : AlgebraicGeometry.IsClosedImmersion ι_YV := inferInstance
  have hInj_YV : Function.Injective ι_YV.base :=
    ι_YV.isClosedEmbedding.isEmbedding.injective
  have hComm_YV : ι_YV ≫ p_M = sndY ≫ s₀ := by
    calc
      (fstY ≫ ιP) ≫ p_M = fstY ≫ (ιP ≫ p_M) := CategoryTheory.Category.assoc _ _ _
      _ = fstY ≫ g := by rw [hCommP]
      _ = sndY ≫ s₀ := CategoryTheory.Limits.pullback.condition
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)) := (⊥ : PrimeSpectrum k₀)
  have hpt₀_uniq : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)), pt = pt₀ := by
    intro pt
    apply PrimeSpectrum.ext
    change pt.asIdeal = ⊥
    rcases Ideal.eq_bot_or_top pt.asIdeal with hbot | htop
    · exact hbot
    · exact False.elim (pt.isPrime.ne_top htop)
  have hs₀_pt₀ : (s₀.base pt₀).asIdeal = 𝔪_V := by
    change Ideal.comap (algebraMap ↥V k₀) (⊥ : Ideal k₀) = 𝔪_V
    exact Ideal.ker_algebraMap_residueField 𝔪_V
  have hBase_YV : ∀ y : ↥Y, (p_M.base (ι_YV.base y)).asIdeal = 𝔪_V := by
    intro y
    have h_eq : (ι_YV ≫ p_M).base y = (sndY ≫ s₀).base y := by
      rw [hComm_YV]
    have h_lhs : (ι_YV ≫ p_M).base y = p_M.base (ι_YV.base y) := rfl
    have h_rhs : (sndY ≫ s₀).base y = s₀.base (sndY.base y) := rfl
    rw [h_lhs, h_rhs, hpt₀_uniq (sndY.base y)] at h_eq
    rw [h_eq, hs₀_pt₀]
  obtain ⟨hAff_proj, c_proj, t_proj, hCoord_proj, _⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  obtain ⟨hVand, ratio, hR_aff, hR_diag, hR_bas, hR_cocycle, hR_mul, hR_uniq, hR_linZero⟩ :=
    weil_proj_degreeOne_ratio_sections_and_vandermonde ↥V M
  have hX_mem : ∀ b : Fin (M + 1), (MvPolynomial.X b : MvPolynomial (Fin (M + 1)) ↥V) ∈ 𝒜 1 :=
    fun b => MvPolynomial.isHomogeneous_X ↥V b
  have hX_cov : ∀ z : ↥P_M, ∃ b : Fin (M + 1), z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X b) := by
    intro z
    have htop : (⨆ b : Fin (M + 1), weilProjBasicOpen ↥V M b) = ⊤ := (hCoord_proj ↥V M).2.1
    have hz_top : z ∈ (⊤ : P_M.Opens) := trivial
    rw [← htop, TopologicalSpace.Opens.mem_iSup] at hz_top
    exact hz_top
  let σ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y) := fun j =>
    CategoryTheory.Limits.pullback.lift (s₀ ≫ τ j) (𝟙 _) (by
      rw [CategoryTheory.Category.assoc, hSec_g j,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let p_mark : Fin n → ↥Y := fun j => (σ₀ j).base pt₀
  have hp_mark_fst : ∀ j : Fin n, fstY.base (p_mark j) = (τ j).base (s₀.base pt₀) := by
    intro j
    have h_fst : σ₀ j ≫ fstY = s₀ ≫ τ j := CategoryTheory.Limits.pullback.lift_fst _ _ _
    exact congrArg (fun φ => φ.base pt₀) h_fst
  let Sing_Y : Set ↥Y := {y : ↥Y | ¬ ∃ V_sm : Y.Opens,
    y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ sndY)}
  have : Finite ↥(irreducibleComponents ↥Y) := hFinY.to_subtype
  let η_map : ↥(irreducibleComponents ↥Y) → ↥Y := fun E => ((hCompY E.1 E.2).1).choose
  let Gen_Y : Set ↥Y := Set.range η_map
  have hGen_fin : Gen_Y.Finite := Set.finite_range η_map
  let F₀ : Set ↥Y := Gen_Y ∪ Sing_Y ∪ Set.range p_mark
  have hF₀_fin : F₀.Finite :=
    (hGen_fin.union hSingFin).union (Set.finite_range p_mark)
  obtain ⟨r₀, hL₀, hL₀_avoid⟩ := hVand 𝔪_V (ι_YV.base '' F₀) (hF₀_fin.image _)
    (by
      rintro _ ⟨y, _, rfl⟩
      exact hBase_YV y)
    (fun b => MvPolynomial.X b) hX_mem
    (fun z _ => hX_cov z)
  let L₀ : MvPolynomial (Fin (M + 1)) ↥V :=
    ∑ b : Fin (M + 1), MvPolynomial.C (r₀ ^ (b : ℕ)) * MvPolynomial.X b
  let D₀ : P_M.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 L₀
  let V₁ : C.Opens := (TopologicalSpace.Opens.map ιP.base).obj D₀
  let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
  have hF₀_in_V₁Y : F₀ ⊆ (V₁_Y : Set ↥Y) := by
    intro y hy
    exact hL₀_avoid (ι_YV.base y) ⟨y, hy, rfl⟩
  have hΔ_V₁ : ∀ q ∈ Δ, fstY.base q ∈ V₁ := by
    intro q hq
    exact hF₀_in_V₁Y (Or.inl (Or.inr (hΔ_not_sm q hq)))
  have hComplV₁_fin : ((V₁_Y : Set ↥Y)ᶜ).Finite := by
    apply weil_smoothCurve_section_zeroLocus_finite k₀ Y sndY hFinY V₁_Y
    · intro E hE
      refine ⟨η_map ⟨E, hE⟩, ((hCompY E hE).1).choose_spec.1,
        ((hCompY E hE).1).choose_spec.2.1, ?_⟩
      exact hF₀_in_V₁Y (Or.inl (Or.inl ⟨⟨E, hE⟩, rfl⟩))
    · intro y hy_not
      have hy_not_sing : y ∉ Sing_Y := fun hsing =>
        hy_not (hF₀_in_V₁Y (Or.inl (Or.inr hsing)))
      exact Classical.not_not.mp hy_not_sing
  let F₁ : Set ↥Y := ((V₁_Y : Set ↥Y)ᶜ) ∪ Set.range p_mark
  have hF₁_fin : F₁.Finite := hComplV₁_fin.union (Set.finite_range p_mark)
  obtain ⟨r₁, hL₁, hL₁_avoid⟩ := hVand 𝔪_V (ι_YV.base '' F₁) (hF₁_fin.image _)
    (by
      rintro _ ⟨y, _, rfl⟩
      exact hBase_YV y)
    (fun b => MvPolynomial.X b) hX_mem
    (fun z _ => hX_cov z)
  let L₁ : MvPolynomial (Fin (M + 1)) ↥V :=
    ∑ b : Fin (M + 1), MvPolynomial.C (r₁ ^ (b : ℕ)) * MvPolynomial.X b
  let D₁ : P_M.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 L₁
  let V₀ : C.Opens := (TopologicalSpace.Opens.map ιP.base).obj D₁
  let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
  have hF₁_in_V₀Y : F₁ ⊆ (V₀_Y : Set ↥Y) := by
    intro y hy
    exact hL₁_avoid (ι_YV.base y) ⟨y, hy, rfl⟩
  have hCov_Y : V₀_Y ⊔ V₁_Y = ⊤ := by
    ext y
    simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top,
      Set.mem_union, Set.mem_univ, iff_true]
    by_cases hy₁ : y ∈ (V₁_Y : Set ↥Y)
    · exact Or.inr hy₁
    · exact Or.inl (hF₁_in_V₀Y (Or.inl hy₁))
  let h₀ : ↑(C.presheaf.obj (Opposite.op V₀)) :=
    (ιP.app D₁).hom (ratio L₁ L₀ hL₁ hL₀)
  let t₀ : ↑(C.presheaf.obj (Opposite.op V₁)) :=
    (ιP.app D₀).hom (ratio L₀ L₁ hL₀ hL₁)
  have hAff_D₁ : AlgebraicGeometry.IsAffineOpen D₁ := hR_aff L₁ hL₁
  have hAff_D₀ : AlgebraicGeometry.IsAffineOpen D₀ := hR_aff L₀ hL₀
  have : AlgebraicGeometry.IsAffineHom ιP :=
    (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hClP).1
  have hAff₀ : AlgebraicGeometry.IsAffineOpen V₀ := hAff_D₁.preimage ιP
  have hAff₁ : AlgebraicGeometry.IsAffineOpen V₁ := hAff_D₀.preimage ιP
  have hCov : V₀ ⊔ V₁ = ⊤ := by
    ext x
    simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
    by_contra hx_not
    let K_bad : Set ↥C := ((V₀ ⊔ V₁ : C.Opens) : Set ↥C)ᶜ
    have hK_cl : IsClosed K_bad := (V₀ ⊔ V₁).isOpen.isClosed_compl
    have hImg_cl : IsClosed (g.base '' K_bad) := g.isClosedMap K_bad hK_cl
    obtain ⟨I_bad, hI_bad⟩ :=
      (PrimeSpectrum.isClosed_iff_zeroLocus (g.base '' K_bad)).mp hImg_cl
    have hxg_mem : g.base x ∈ PrimeSpectrum.zeroLocus I_bad := by
      rw [← hI_bad]
      exact ⟨x, hx_not, rfl⟩
    have hpt₀_mem : s₀.base pt₀ ∈ PrimeSpectrum.zeroLocus I_bad := by
      intro v hv
      rw [hs₀_pt₀]
      exact IsLocalRing.le_maximalIdeal (g.base x).isPrime.ne_top (hxg_mem hv)
    rw [← hI_bad] at hpt₀_mem
    rcases hpt₀_mem with ⟨x₀, hx₀_bad, hx₀_eq⟩
    obtain ⟨y₀, hy₀_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x₀ pt₀ hx₀_eq
    have hy₀_cov : y₀ ∈ (V₀_Y ⊔ V₁_Y : Y.Opens) := by
      rw [hCov_Y]
      trivial
    have hx₀_cov : x₀ ∈ (V₀ ⊔ V₁ : C.Opens) := by
      rcases hy₀_cov with hy₀ | hy₀
      · left
        rw [← hy₀_fst]
        exact hy₀
      · right
        rw [← hy₀_fst]
        exact hy₀
    exact hx₀_bad hx₀_cov
  have hBas₀ : C.basicOpen h₀ = V₀ ⊓ V₁ := by
    dsimp only [h₀]
    rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ιP (ratio L₁ L₀ hL₁ hL₀),
      hR_bas L₁ L₀ hL₁ hL₀]
    rfl
  have hBas₁ : C.basicOpen t₀ = V₀ ⊓ V₁ := by
    dsimp only [t₀]
    rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ιP (ratio L₀ L₁ hL₀ hL₁),
      hR_bas L₀ L₁ hL₀ hL₁]
    exact inf_comm V₁ V₀
  have hNat_ιP_left : ∀ s : ↑(P_M.presheaf.obj (Opposite.op D₁)),
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
        ((ιP.app D₁).hom s) =
      (ιP.appLE (D₁ ⊓ D₀) (V₀ ⊓ V₁) le_rfl).hom
        ((P_M.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D₁ ⊓ D₀ ≤ D₁)).op).hom s) := by
    intro s
    rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ιP]
    have h1 : ιP.appLE D₁ V₀ le_rfl ≫
        C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op =
        ιP.appLE D₁ (V₀ ⊓ V₁) inf_le_left :=
      AlgebraicGeometry.Scheme.Hom.appLE_map _ _ _
    have h2 : P_M.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D₁ ⊓ D₀ ≤ D₁)).op ≫
        ιP.appLE (D₁ ⊓ D₀) (V₀ ⊓ V₁) le_rfl =
        ιP.appLE D₁ (V₀ ⊓ V₁) inf_le_left :=
      AlgebraicGeometry.Scheme.Hom.map_appLE _ _ _
    exact congrArg (fun φ => φ.hom s) (h1.trans h2.symm)
  have hNat_ιP_right : ∀ s : ↑(P_M.presheaf.obj (Opposite.op D₀)),
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
        ((ιP.app D₀).hom s) =
