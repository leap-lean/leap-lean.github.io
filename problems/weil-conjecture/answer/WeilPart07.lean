    rw [AlgebraicGeometry.isDominant_iff]
    intro z
    rw [mem_closure_iff]
    intro W hW hzW
    let pt_F : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := ⟨⊥, hbot_F⟩
    exact ⟨η_F.base pt_F, hηF_mem ⟨W, hW⟩ ⟨⟨z, hzW⟩⟩ pt_F, pt_F, rfl⟩
  obtain ⟨⟨s₀, hs₀, hLocV⟩, hFuncModel, hSmPoles⟩ :=
    weil_valuation_model_functionField_and_smooth_poles K m V hPkg
      C_K p_K n σ_K hIntCK hSmCK hStabCK F η_F hηF_comm hFuncF
  obtain ⟨hInjVF, hEssTr, hη_semi, hFunc_semi,
      r₀, U_semi, hAff_semi, φ_semi, L, h1L, f, I_semi,
      hCov_semi, _hNe_semi, _hFrac_semi, hf_ne, hGen_semi⟩ :=
    hs8 K V s₀ hLocV C_K p_K hIntCK hSmCK F φ_KF η_F hηF_φ hFuncF
      C_semi g_semi ι_semi hInt_semi hProp_semi hLfp_semi hPb_semi
  let η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi := η_F ≫ ι_semi
  have h2L : 2 ≤ 2 ^ L := by
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ 2 ^ L := Nat.pow_le_pow_right (by omega) h1L
  have h2_prod : 2 ≤ (M' + 1) * 2 ^ L := by
    calc 2 = 1 * 2 := (one_mul 2).symm
      _ ≤ (M' + 1) * 2 ^ L := Nat.mul_le_mul (Nat.succ_pos M') h2L
  let M : ℕ := (M' + 1) * 2 ^ L - 1
  have h1M : 1 ≤ M := by omega
  have hM_succ : M + 1 = (M' + 1) * 2 ^ L := by omega
  have hCard_seg : Fintype.card (Fin (M' + 1) × Finset (Fin L)) = M + 1 := by
    rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_finset, Fintype.card_fin, hM_succ]
  let eSeg : Fin (M + 1) ≃ Fin (M' + 1) × Finset (Fin L) :=
    (Fintype.equivFinOfCardEq hCard_seg).symm
  have hFunc' : IsSchemeFunctionField C' F (η_F ≫ ι') :=
    hFuncModel C' g' τ' ι' hMod'
  obtain ⟨ξ, _r_gen, _hξ_gen, hC'K_charts, hSegMake⟩ :=
    weil_generic_curve_coords_and_segre_closedImmersion K V C_K p_K n σ_K hIntCK
      F η_F hηF_comm hFuncF hSmPoles C' g' τ' ι' hMod' hFunc' M' ιP' hClP' hCommP'
      hAff_proj c_proj t_proj hCoord_proj hBase_proj
  obtain ⟨Ψ_K, hSegK⟩ := hSegMake L f hf_ne M eSeg
  obtain ⟨Φ_KV, hBase_KV⟩ := hBase_proj ↥V K V.subtype M
  obtain ⟨C_tilde, g_tilde, τ_tilde, ι_tilde, ιP_tilde,
      hMod_tilde, hClP_tilde, hCommP_tilde, hιP_tilde_eq⟩ :=
    weil_schematicClosure_valuation_pointed_curve_model K m V hPkg
      C_K p_K n σ_K hIntCK hStabCK s₀ hs₀ hLocV M
      (hAff_proj ↥V M) (c_proj ↥V M) (t_proj ↥V M) (hCoord_proj ↥V M)
      (hAff_proj K M) (c_proj K M) (t_proj K M) (hCoord_proj K M)
      Φ_KV hBase_KV Ψ_K hSegK.1 hSegK.2.1
  let η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde := η_F ≫ ι_tilde
  have hFunc_tilde : IsSchemeFunctionField C_tilde F η_tilde :=
    hFuncModel C_tilde g_tilde τ_tilde ι_tilde hMod_tilde
  have hSeg_tilde :=
    (weil_segre_model_domination_and_slice_properness K V C_K p_K n σ_K hIntCK
      F η_F hηF_comm hFuncF C' g' τ' ι' hMod' hFunc' M' ιP' hClP' hCommP'
      hAff_proj c_proj t_proj hCoord_proj ξ hC'K_charts L f hf_ne M eSeg Ψ_K hSegK
      Φ_KV hBase_KV C_tilde g_tilde τ_tilde ι_tilde ιP_tilde
      hMod_tilde hFunc_tilde hClP_tilde hCommP_tilde hιP_tilde_eq).1
  obtain ⟨hInt_tilde, _hFlat_tilde, hProp_tilde, hLfp_tilde, hSurj_tilde,
      _, _, hPb_tilde, _⟩ := hMod_tilde
  obtain ⟨q, U_gen, hProp_q, hq_comm, hη_q, hIso_gen, hU_gen⟩ :=
    hs9 K V s₀ hLocV C_K p_K hIntCK F φ_KF η_F hDom_ηF hηF_φ
      C_semi g_semi ι_semi hInt_semi hProp_semi hPb_semi
      r₀ U_semi hAff_semi φ_semi hCov_semi
      (fun a => (_hFrac_semi a).2) L f hf_ne I_semi hGen_semi M' M ξ eSeg
      (weilProjectiveSpaceOver ↥V M) (weilProjBasicOpen ↥V M)
      (hAff_proj ↥V M) (c_proj ↥V M) (t_proj ↥V M)
      (hCoord_proj ↥V M).2.1 (hCoord_proj ↥V M).2.2.1
      (hCoord_proj ↥V M).2.2.2.2.2.2.2.1
      C_tilde g_tilde ι_tilde ιP_tilde hInt_tilde hProp_tilde hPb_tilde
      hClP_tilde hCommP_tilde hFunc_tilde hSeg_tilde
  have hBij_q : ∀ U : C_semi.Opens, Function.Bijective (q.app U).hom :=
    hs10 C_tilde C_semi hInt_tilde hInt_semi hNorm_semi F η_tilde η_semi
      hFunc_tilde hFunc_semi q hProp_q hη_q
  exact ⟨F, instFieldF, φ_KF, η_semi, M, h1M,
    C_tilde, g_tilde, ιP_tilde, q, η_tilde, U_gen,
    hInjVF, hEssTr, hη_semi, hη_q, hFunc_semi, hFunc_tilde,
    hInt_tilde, hProp_tilde, hLfp_tilde, hSurj_tilde,
    hClP_tilde, hCommP_tilde, hProp_q, hq_comm, hBij_q, hIso_gen, hU_gen⟩

theorem weil_valuation_fiber_krullDimLE_one_and_closed_dichotomy (K : Type u) [Field K]
    (V : ValuationSubring K)
    (F : Type u) [Field F]
    (φ_KF : K →+* F)
    (hTwoVar : ∀ (W : ValuationSubring F)
        (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
        (P : Ideal ↥V) [P.IsPrime],
      (∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
      ¬ ∃ (t₁ t₂ : ↥W),
        ∀ (Q : MvPolynomial (Fin 2) ↥V),
          (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
          MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
            IsLocalRing.maximalIdeal ↥W)
    (A : Type u) [CommRing A] [IsDomain A]
    (c_A : ↥V →+* A)
    (hc_FT : c_A.FiniteType)
    (ψ_A : A →+* F)
    (hInj_A : Function.Injective ψ_A)
    (hCompat_A : ψ_A.comp c_A = φ_KF.comp V.subtype)
    (P : PrimeSpectrum ↥V) :
    letI : Algebra ↥V A := c_A.toAlgebra
    Ring.KrullDimLE 1 (P.asIdeal.Fiber A) ∧
    {q : ↑(PrimeSpectrum.comap c_A ⁻¹' {P}) |
      ¬ IsClosed ({q} : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P}))}.Finite ∧
    (∀ Z : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P}),
      IsClosed Z → ¬ Z.Finite →
      ∃ q ∈ Z, ¬ IsClosed ({q} : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P}))) :=
by
  let _ : Algebra ↥V A := c_A.toAlgebra
  let κ_P := P.asIdeal.ResidueField
  let R_fib := P.asIdeal.Fiber A
  have hKrull1 : Ring.KrullDimLE 1 R_fib := by
    apply Ring.KrullDimLE.mk₁
    intro I₁ hI₁
    by_contra hNotOr
    have hI₁_not_min : I₁ ∉ minimalPrimes R_fib := fun h => hNotOr (Or.inl h)
    have hI₁_not_max : ¬ I₁.IsMaximal := fun h => hNotOr (Or.inr h)
    have : I₁.IsPrime := hI₁
    obtain ⟨I₀, hI₀_min, hI₀_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal R_fib) ≤ I₁)
    have hI₀ : I₀.IsPrime := hI₀_min.1.1
    have hI₀_ne : I₀ ≠ I₁ := by
      intro hEq
      rw [hEq] at hI₀_min
      exact hI₁_not_min hI₀_min
    have hI₀_lt : I₀ < I₁ := lt_of_le_of_ne hI₀_le hI₀_ne
    obtain ⟨I₂, hI₂_max, hI₁_le⟩ := Ideal.exists_le_maximal I₁ hI₁.ne_top
    have hI₂ : I₂.IsPrime := hI₂_max.isPrime
    have hI₁_ne : I₁ ≠ I₂ := by
      intro hEq
      rw [← hEq] at hI₂_max
      exact hI₁_not_max hI₂_max
    have hI₁_lt : I₁ < I₂ := lt_of_le_of_ne hI₁_le hI₁_ne
    let e_ord := PrimeSpectrum.preimageOrderIsoFiber ↥V A P
    let p₀ : PrimeSpectrum R_fib := ⟨I₀, hI₀⟩
    let p₁ : PrimeSpectrum R_fib := ⟨I₁, hI₁⟩
    let p₂ : PrimeSpectrum R_fib := ⟨I₂, hI₂⟩
    have hp₀₁ : p₀ < p₁ := hI₀_lt
    have hp₁₂ : p₁ < p₂ := hI₁_lt
    let q₀ := e_ord.symm p₀
    let q₁ := e_ord.symm p₁
    let q₂ := e_ord.symm p₂
    have hq₀₁ : q₀ < q₁ := e_ord.symm.strictMono hp₀₁
    have hq₁₂ : q₁ < q₂ := e_ord.symm.strictMono hp₁₂
    let Q₀ : Ideal A := q₀.1.asIdeal
    let Q₁ : Ideal A := q₁.1.asIdeal
    let Q₂ : Ideal A := q₂.1.asIdeal
    have hQ₀_prime : Q₀.IsPrime := q₀.1.isPrime
    have hQ₀₁ : Q₀ < Q₁ := hq₀₁
    have hQ₁₂ : Q₁ < Q₂ := hq₁₂
    have hQ₀_comap : Ideal.comap c_A Q₀ = P.asIdeal :=
      congrArg PrimeSpectrum.asIdeal q₀.2
    let ι_R : A →ₐ[↥V] R_fib := Algebra.TensorProduct.includeRight
    have mem_Q_iff : ∀ (p : PrimeSpectrum R_fib) (a : A),
        a ∈ (e_ord.symm p).1.asIdeal ↔ ι_R a ∈ p.asIdeal := by
      intro p a
      dsimp only [e_ord]
      change a ∈ ((RelIso.symm (PrimeSpectrum.preimageOrderIsoFiber ↥V A P) p).1.asIdeal : Set A) ↔
        ι_R a ∈ (p.asIdeal : Set R_fib)
      rw [PrimeSpectrum.coe_preimageOrderIsoFiber_symm_apply_coe_asIdeal ↥V A P p]
      rfl
    obtain ⟨u₀, hu₀_Q₁, hu₀_not_Q₀⟩ := SetLike.exists_of_lt hQ₀₁
    obtain ⟨u₁, hu₁_Q₂, hu₁_not_Q₁⟩ := SetLike.exists_of_lt hQ₁₂
    let x₀ : R_fib := ι_R u₀
    let x₁ : R_fib := ι_R u₁
    have hx₀_I₁ : x₀ ∈ I₁ := (mem_Q_iff p₁ u₀).mp hu₀_Q₁
    have hx₀_not_I₀ : x₀ ∉ I₀ := fun h => hu₀_not_Q₀ ((mem_Q_iff p₀ u₀).mpr h)
    have hx₁_I₂ : x₁ ∈ I₂ := (mem_Q_iff p₂ u₁).mp hu₁_Q₂
    have hx₁_not_I₁ : x₁ ∉ I₁ := fun h => hu₁_not_Q₁ ((mem_Q_iff p₁ u₁).mpr h)
    let E : MvPolynomial (Fin 2) κ_P →+* R_fib :=
      (MvPolynomial.aeval ![x₀, x₁]).toRingHom
    let r₀ : Ideal (MvPolynomial (Fin 2) κ_P) := Ideal.comap E I₀
    let r₁ : Ideal (MvPolynomial (Fin 2) κ_P) := Ideal.comap E I₁
    let r₂ : Ideal (MvPolynomial (Fin 2) κ_P) := Ideal.comap E I₂
    have hr₀_prime : r₀.IsPrime := Ideal.comap_isPrime E I₀
    have hr₁_prime : r₁.IsPrime := Ideal.comap_isPrime E I₁
    have hr₂_prime : r₂.IsPrime := Ideal.comap_isPrime E I₂
    have hEX₀ : E (MvPolynomial.X 0) = x₀ := MvPolynomial.aeval_X ![x₀, x₁] 0
    have hEX₁ : E (MvPolynomial.X 1) = x₁ := MvPolynomial.aeval_X ![x₀, x₁] 1
    have hr₀₁ : r₀ < r₁ := by
      refine lt_of_le_of_ne (Ideal.comap_mono hI₀_le) ?_
      intro hEq
      have hX0_r1 : MvPolynomial.X (0 : Fin 2) ∈ r₁ := by
        change E (MvPolynomial.X 0) ∈ I₁
        rw [hEX₀]
        exact hx₀_I₁
      have hX0_r0 : MvPolynomial.X (0 : Fin 2) ∈ r₀ := hEq ▸ hX0_r1
      change E (MvPolynomial.X 0) ∈ I₀ at hX0_r0
      rw [hEX₀] at hX0_r0
      exact hx₀_not_I₀ hX0_r0
    have hr₁₂ : r₁ < r₂ := by
      refine lt_of_le_of_ne (Ideal.comap_mono hI₁_le) ?_
      intro hEq
      have hX1_r2 : MvPolynomial.X (1 : Fin 2) ∈ r₂ := by
        change E (MvPolynomial.X 1) ∈ I₂
        rw [hEX₁]
        exact hx₁_I₂
      have hX1_r1 : MvPolynomial.X (1 : Fin 2) ∈ r₁ := hEq ▸ hX1_r2
      change E (MvPolynomial.X 1) ∈ I₁ at hX1_r1
      rw [hEX₁] at hX1_r1
      exact hx₁_not_I₁ hX1_r1
    have hr₀_bot : r₀ = ⊥ := by
      by_contra hr₀_ne
      have hbot_lt : (⊥ : Ideal (MvPolynomial (Fin 2) κ_P)) < r₀ := bot_lt_iff_ne_bot.mpr hr₀_ne
      have hbot_prime : (⊥ : Ideal (MvPolynomial (Fin 2) κ_P)).IsPrime := inferInstance
      let s_pts : Fin 4 → PrimeSpectrum (MvPolynomial (Fin 2) κ_P) :=
        ![⟨⊥, hbot_prime⟩, ⟨r₀, hr₀_prime⟩, ⟨r₁, hr₁_prime⟩, ⟨r₂, hr₂_prime⟩]
      let s_chain : LTSeries (PrimeSpectrum (MvPolynomial (Fin 2) κ_P)) :=
        RelSeries.mk 3 s_pts (by
          intro i
          fin_cases i
          · exact hbot_lt
          · exact hr₀₁
          · exact hr₁₂)
      have hlen : (3 : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin 2) κ_P) :=
        Order.LTSeries.length_le_krullDim s_chain
      have hdim : ringKrullDim (MvPolynomial (Fin 2) κ_P) = (2 : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
          ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
        rfl
      rw [hdim] at hlen
      exact absurd hlen (by decide)
    have hComp_fib : ι_R.toRingHom.comp c_A =
        (algebraMap κ_P R_fib).comp (algebraMap ↥V κ_P) := by
      ext v
      calc
        ι_R (c_A v) = (1 : κ_P) ⊗ₜ[↥V] (algebraMap ↥V A v) :=
          Algebra.TensorProduct.includeRight_apply (R := ↥V) (A := κ_P) (B := A) (c_A v)
        _ = (1 : κ_P) ⊗ₜ[↥V] (v • (1 : A)) := by
          rw [Algebra.algebraMap_eq_smul_one]
        _ = (v • (1 : κ_P)) ⊗ₜ[↥V] (1 : A) :=
          (TensorProduct.smul_tmul v (1 : κ_P) (1 : A)).symm
        _ = (algebraMap ↥V κ_P v) ⊗ₜ[↥V] (1 : A) := by
          rw [Algebra.algebraMap_eq_smul_one]
        _ = algebraMap κ_P R_fib (algebraMap ↥V κ_P v) :=
          (Algebra.TensorProduct.algebraMap_apply (R := ↥V) (A := κ_P) (B := A) _).symm
    have hAvoid : ∀ Q : MvPolynomial (Fin 2) ↥V,
        (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P.asIdeal) →
        MvPolynomial.eval₂ c_A ![u₀, u₁] Q ∉ Q₀ := by
      rintro Q ⟨d₀, hd₀⟩ hMemQ₀
      have hMemI₀ : ι_R (MvPolynomial.eval₂ c_A ![u₀, u₁] Q) ∈ I₀ :=
        (mem_Q_iff p₀ _).mp hMemQ₀
      have hVec_fib : (fun i : Fin 2 => ι_R.toRingHom (![u₀, u₁] i)) = ![x₀, x₁] :=
        funext (Fin.forall_fin_two.mpr ⟨rfl, rfl⟩)
      have hEval_eq : ι_R (MvPolynomial.eval₂ c_A ![u₀, u₁] Q) =
          E (MvPolynomial.map (algebraMap ↥V κ_P) Q) := by
        change ι_R.toRingHom (MvPolynomial.eval₂ c_A ![u₀, u₁] Q) =
          (MvPolynomial.aeval ![x₀, x₁]) (MvPolynomial.map (algebraMap ↥V κ_P) Q)
        rw [MvPolynomial.hom_eval₂, hComp_fib, hVec_fib,
          ← MvPolynomial.eval₂_map, MvPolynomial.aeval_eq_eval₂Hom]
        rfl
      rw [hEval_eq] at hMemI₀
      have hMap_r0 : MvPolynomial.map (algebraMap ↥V κ_P) Q ∈ r₀ := hMemI₀
      rw [hr₀_bot, Submodule.mem_bot] at hMap_r0
      have hCoeff0 : (MvPolynomial.map (algebraMap ↥V κ_P) Q).coeff d₀ = 0 := by
        rw [hMap_r0]
        rfl
      rw [MvPolynomial.coeff_map] at hCoeff0
      exact hd₀ (Ideal.algebraMap_residueField_eq_zero.mp hCoeff0)
    have hUnit : ∀ y : Q₀.primeCompl, IsUnit (ψ_A y) := by
      intro y
      apply IsUnit.mk0
      intro hy0
      have hy_eq : (y : A) = 0 := hInj_A (hy0.trans (map_zero ψ_A).symm)
      exact y.2 (hy_eq ▸ Q₀.zero_mem)
    let ψ_loc : Localization.AtPrime Q₀ →+* F :=
      IsLocalization.lift (M := Q₀.primeCompl) hUnit
    obtain ⟨W, hW_loc, hLocal⟩ := IsLocalRing.exists_factor_valuationRing ψ_loc
    let ψ_W : Localization.AtPrime Q₀ →+* ↥W :=
      ψ_loc.codRestrict W.toSubring hW_loc
    have : IsLocalHom ψ_W := hLocal
    let ρ : A →+* ↥W := ψ_W.comp (algebraMap A (Localization.AtPrime Q₀))
    have hρ_val : ∀ a : A, ((ρ a : ↥W) : F) = ψ_A a := by
      intro a
      change ψ_loc (algebraMap A (Localization.AtPrime Q₀) a) = ψ_A a
      exact IsLocalization.lift_eq (M := Q₀.primeCompl) hUnit a
    have hφ_eq : ∀ c : ↥V, φ_KF (V.subtype c) = ((ρ (c_A c) : ↥W) : F) := by
      intro c
      have hc := RingHom.congr_fun hCompat_A c
      change ψ_A (c_A c) = φ_KF (V.subtype c) at hc
      rw [← hc, hρ_val]
    have hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W := by
      intro c
      rw [hφ_eq c]
      exact (ρ (c_A c)).2
    have hCodEq : (φ_KF.comp V.subtype).codRestrict W.toSubring hV = ρ.comp c_A := by
      ext c
      exact hφ_eq c
    have hMax_iff : ∀ a : A, ρ a ∈ IsLocalRing.maximalIdeal ↥W ↔ a ∈ Q₀ := by
      intro a
      let z : Localization.AtPrime Q₀ := algebraMap A (Localization.AtPrime Q₀) a
      change ψ_W z ∈ IsLocalRing.maximalIdeal ↥W ↔ a ∈ Q₀
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        ← IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q₀) Q₀ a,
        IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact ⟨fun h hz => h (hz.map ψ_W), fun h hψz => h (isUnit_of_map_unit ψ_W z hψz)⟩
    have hCenter : ∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P.asIdeal) := by
      intro c
      have hc_eq : (⟨φ_KF (V.subtype c), hV c⟩ : ↥W) = ρ (c_A c) := Subtype.ext (hφ_eq c)
      rw [hc_eq, hMax_iff (c_A c), ← hQ₀_comap]
      rfl
    apply hTwoVar W hV P.asIdeal hCenter
    refine ⟨ρ u₀, ρ u₁, fun Q hQ => ?_⟩
    rw [hCodEq]
    have hVec_W : ![ρ u₀, ρ u₁] = fun i : Fin 2 => ρ (![u₀, u₁] i) :=
      funext (Fin.forall_fin_two.mpr ⟨rfl, rfl⟩)
    rw [hVec_W, ← MvPolynomial.hom_eval₂, hMax_iff]
    exact hAvoid Q hQ
  have : Algebra.FiniteType ↥V A := hc_FT
  have : Algebra.FiniteType κ_P R_fib := inferInstance
  have : IsNoetherianRing R_fib := Algebra.FiniteType.isNoetherianRing κ_P R_fib
  let h_fib := PrimeSpectrum.preimageHomeomorphFiber ↥V A P
  have hClosed_singleton_iff : ∀ q : ↑(PrimeSpectrum.comap c_A ⁻¹' {P}),
      IsClosed ({q} : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P})) ↔
        (h_fib q).asIdeal.IsMaximal := by
    intro q
    rw [← h_fib.isClosed_image, Set.image_singleton,
      PrimeSpectrum.isClosed_singleton_iff_isMaximal]
  let S_nc : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P}) :=
    {q : ↑(PrimeSpectrum.comap c_A ⁻¹' {P}) |
      ¬ IsClosed ({q} : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P}))}
  have hFin_nc : S_nc.Finite := by
    let f : ↑(PrimeSpectrum.comap c_A ⁻¹' {P}) → Ideal R_fib :=
      fun q => (h_fib q).asIdeal
    have hf_inj : Function.Injective f :=
      fun q₁ q₂ hEq => h_fib.injective (PrimeSpectrum.ext hEq)
    have hSub : f '' S_nc ⊆ minimalPrimes R_fib := by
      rintro _ ⟨q, hq, rfl⟩
      have hNotMax : ¬ (h_fib q).asIdeal.IsMaximal :=
        fun hMax => hq ((hClosed_singleton_iff q).mpr hMax)
      exact (Ring.krullDimLE_one_iff.mp hKrull1 (h_fib q).asIdeal (h_fib q).isPrime).resolve_right
        hNotMax
    exact ((minimalPrimes.finite_of_isNoetherianRing R_fib).subset hSub).of_finite_image
      hf_inj.injOn
  have hDich : ∀ Z : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P}),
      IsClosed Z → ¬ Z.Finite →
      ∃ q ∈ Z, ¬ IsClosed ({q} : Set ↑(PrimeSpectrum.comap c_A ⁻¹' {P})) := by
    intro Z hZ_cl hZ_inf
    by_contra hNo
    have hAllMax : ∀ q ∈ Z, (h_fib q).asIdeal.IsMaximal := by
      intro q hq
      rw [← hClosed_singleton_iff]
      by_contra hNotCl
      exact hNo ⟨q, hq, hNotCl⟩
    let Z' : Set (PrimeSpectrum R_fib) := h_fib '' Z
    have hZ'_cl : IsClosed Z' := h_fib.isClosed_image.mpr hZ_cl
    have hZ'_inf : ¬ Z'.Finite :=
      fun hFin => hZ_inf (hFin.of_finite_image h_fib.injective.injOn)
    let I : Ideal R_fib := PrimeSpectrum.vanishingIdeal Z'
    have hZL : PrimeSpectrum.zeroLocus (I : Set R_fib) = Z' := by
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hZ'_cl.closure_eq]
    have hSub_min : PrimeSpectrum.asIdeal '' Z' ⊆ I.minimalPrimes := by
      rintro _ ⟨p, hp, rfl⟩
      have hp_ZL : p ∈ PrimeSpectrum.zeroLocus (I : Set R_fib) := hZL.symm ▸ hp
      have hI_le_p : I ≤ p.asIdeal := by
        rw [PrimeSpectrum.mem_zeroLocus] at hp_ZL
        exact SetLike.coe_subset_coe.mp hp_ZL
      refine ⟨⟨p.isPrime, hI_le_p⟩, ?_⟩
      rintro J ⟨hJ_prime, hI_le_J⟩ hJ_le_p
      let pJ : PrimeSpectrum R_fib := ⟨J, hJ_prime⟩
      have hpJ_Z' : pJ ∈ Z' := by
        rw [← hZL, PrimeSpectrum.mem_zeroLocus]
        exact SetLike.coe_subset_coe.mpr hI_le_J
      obtain ⟨qJ, hqJ_Z, hqJ_eq⟩ := hpJ_Z'
      have hJ_max : J.IsMaximal := by
        change pJ.asIdeal.IsMaximal
        rw [← hqJ_eq]
        exact hAllMax qJ hqJ_Z
      exact (hJ_max.eq_of_le p.isPrime.ne_top hJ_le_p).ge
    have hFin_Z' : Z'.Finite :=
      ((Ideal.finite_minimalPrimes_of_isNoetherianRing R_fib I).subset hSub_min).of_finite_image
        (fun _ _ _ _ hEq => PrimeSpectrum.ext hEq)
    exact hZ'_inf hFin_Z'
  exact ⟨hKrull1, hFin_nc, hDich⟩

theorem weil_proper_curve_closed_fiber_point_section_and_specialization_unique (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hProp_semi : AlgebraicGeometry.IsProper g_semi) :
    (∀ z : ↥C_semi,
      let P : Ideal ↥V := (g_semi.base z).asIdeal
      P ≠ ⊥ →
      IsClosed ({⟨z, rfl⟩} : Set ↑(g_semi.base ⁻¹' {g_semi.base z})) →
      ∃ (σ : AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P)) ⟶ C_semi),
        σ ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P)) ∧
        z ∈ Set.range σ.base ∧
        IsClosed (Set.range σ.base)) ∧
    (∀ (P₁ P₂ : Ideal ↥V) [P₁.IsPrime] [P₂.IsPrime]
        (σ₁ : AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P₁)) ⟶ C_semi)
        (σ₂ : AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P₂)) ⟶ C_semi),
      σ₁ ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P₁)) →
      σ₂ ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P₂)) →
      ¬ Disjoint (Set.range σ₁.base) (Set.range σ₂.base) →
      ∀ (pt₁ : PrimeSpectrum (↥V ⧸ P₁)) (pt₂ : PrimeSpectrum (↥V ⧸ P₂)),
        Ideal.comap (Ideal.Quotient.mk P₁) pt₁.asIdeal = IsLocalRing.maximalIdeal ↥V →
        Ideal.comap (Ideal.Quotient.mk P₂) pt₂.asIdeal = IsLocalRing.maximalIdeal ↥V →
        σ₁.base pt₁ = σ₂.base pt₂) :=
by
  have : AlgebraicGeometry.IsProper g_semi := hProp_semi
  refine ⟨?_, ?_⟩
  · intro z P hP_ne_bot hz_cl
    let P₀ : PrimeSpectrum ↥V := g_semi.base z
    have : P.IsPrime := P₀.isPrime
    have : IsAlgClosed P.ResidueField := hPkg.2.2.2.2.1 P hP_ne_bot
    obtain ⟨W, hW, hz_W, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
    let B : Type u := ↑(C_semi.presheaf.obj (Opposite.op W))
    let c_B : ↥V →+* B := (AlgebraicGeometry.Spec.preimage (hW.fromSpec ≫ g_semi)).hom
    have hc_FT : c_B.FiniteType := by
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType (hW.fromSpec ≫ g_semi) := inferInstance
      rw [← AlgebraicGeometry.Spec.map_preimage (hW.fromSpec ≫ g_semi)] at hLFT
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
    have hz_rng : z ∈ Set.range hW.fromSpec.base := by
      rw [hW.range_fromSpec]
      exact hz_W
    obtain ⟨p_z_raw, hpz_eq⟩ := hz_rng
    let p_z : PrimeSpectrum B := p_z_raw
    have hFromSpec_P : ∀ p : PrimeSpectrum B,
        g_semi.base (hW.fromSpec.base p) = PrimeSpectrum.comap c_B p := by
      intro p
      let p' : ↥(AlgebraicGeometry.Spec (C_semi.presheaf.obj (Opposite.op W))) := p
      have h₁ := (AlgebraicGeometry.Scheme.Hom.comp_apply hW.fromSpec g_semi p').symm
      have h₂ := congrArg (fun h => h p')
        (AlgebraicGeometry.Spec.map_preimage (hW.fromSpec ≫ g_semi)).symm
      exact h₁.trans (h₂.trans (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom c_B) p))
    have hp_z : PrimeSpectrum.comap c_B p_z = P₀ := by
      rw [← hFromSpec_P p_z]
      exact congrArg g_semi.base hpz_eq
    let ι_W : ↑(PrimeSpectrum.comap c_B ⁻¹' {P₀}) → ↑(g_semi.base ⁻¹' {P₀}) :=
      fun q => ⟨hW.fromSpec.base q.1, (hFromSpec_P q.1).trans q.2⟩
    have hCont_ιW : Continuous ι_W :=
      Continuous.subtype_mk (hW.fromSpec.continuous.comp continuous_subtype_val) _
    have hPre_z : ι_W ⁻¹' ({⟨z, rfl⟩} : Set ↑(g_semi.base ⁻¹' {P₀})) = {⟨p_z, hp_z⟩} := by
      ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hq
        have hval : hW.fromSpec.base q.1 = z := congrArg Subtype.val hq
        apply Subtype.ext
        exact hW.fromSpec.isOpenEmbedding.injective (hval.trans hpz_eq.symm)
      · intro hq
        rw [hq]
        exact Subtype.ext hpz_eq
    have hp_cl : IsClosed ({⟨p_z, hp_z⟩} : Set ↑(PrimeSpectrum.comap c_B ⁻¹' {P₀})) := by
      rw [← hPre_z]
      exact hz_cl.preimage hCont_ιW
    let _ : Algebra ↥V B := c_B.toAlgebra
    have : Algebra.FiniteType ↥V B := hc_FT
    let κ_P : Type u := P₀.asIdeal.ResidueField
    have : IsAlgClosed κ_P := by change IsAlgClosed P.ResidueField; infer_instance
    let R_fib : Type u := P₀.asIdeal.Fiber B
    let h_fib := PrimeSpectrum.preimageHomeomorphFiber ↥V B P₀
    let q_z : PrimeSpectrum R_fib := h_fib ⟨p_z, hp_z⟩
    have hqz_cl : IsClosed ({q_z} : Set (PrimeSpectrum R_fib)) := by
      have hImg := h_fib.isClosed_image.mpr hp_cl
      rwa [Set.image_singleton] at hImg
    have : q_z.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_z).mp hqz_cl
    let L : Type u := R_fib ⧸ q_z.asIdeal
    let _ : Field L := Ideal.Quotient.field q_z.asIdeal
    have : Algebra.FiniteType κ_P L :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ κ_P q_z.asIdeal)
        Ideal.Quotient.mk_surjective
    have : Module.Finite κ_P L := finite_of_finite_type_of_isJacobsonRing κ_P L
    have : Algebra.IsIntegral κ_P L := Algebra.IsIntegral.of_finite κ_P L
    have hBij_L : Function.Bijective (algebraMap κ_P L) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ_P) (K := L)
    let e_L : κ_P ≃+* L := RingEquiv.ofBijective (algebraMap κ_P L) hBij_L
    let ev_z : B →+* κ_P :=
      e_L.symm.toRingHom.comp
        ((Ideal.Quotient.mk q_z.asIdeal).comp
          (Algebra.TensorProduct.includeRight : B →ₐ[↥V] R_fib).toRingHom)
    have hev_comp : ev_z.comp c_B = algebraMap ↥V κ_P := by
      ext v
      change e_L.symm (Ideal.Quotient.mk q_z.asIdeal
        ((Algebra.TensorProduct.includeRight : B →ₐ[↥V] R_fib) (algebraMap ↥V B v))) =
        algebraMap ↥V κ_P v
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply ↥V κ_P R_fib v]
      have hmk : Ideal.Quotient.mk q_z.asIdeal (algebraMap κ_P R_fib (algebraMap ↥V κ_P v)) =
          algebraMap κ_P L (algebraMap ↥V κ_P v) :=
        (Ideal.Quotient.mkₐ κ_P q_z.asIdeal).commutes (algebraMap ↥V κ_P v)
      rw [hmk]
      exact e_L.symm_apply_apply (algebraMap ↥V κ_P v)
    let pt₀ : PrimeSpectrum κ_P := ⊥
    have hev_comap : PrimeSpectrum.comap ev_z pt₀ = p_z := by
      have hsymm : (PrimeSpectrum.preimageEquivFiber ↥V B P₀).symm q_z = ⟨p_z, hp_z⟩ :=
        (PrimeSpectrum.preimageEquivFiber ↥V B P₀).symm_apply_apply ⟨p_z, hp_z⟩
      have hcoe := PrimeSpectrum.preimageEquivFiber_symm_apply_coe ↥V B P₀ q_z
      rw [hsymm] at hcoe
      change p_z = PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : B →ₐ[↥V] R_fib).toRingHom q_z at hcoe
      rw [hcoe]
      ext b
      change ev_z b ∈ (⊥ : Ideal κ_P) ↔
        (Algebra.TensorProduct.includeRight : B →ₐ[↥V] R_fib) b ∈ q_z.asIdeal
      rw [Submodule.mem_bot]
      change e_L.symm (Ideal.Quotient.mk q_z.asIdeal _) = 0 ↔ _
      rw [map_eq_zero_iff e_L.symm e_L.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
      exact Iff.rfl
    let e_z : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶ C_semi :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_z) ≫ hW.fromSpec
    have he_comm : e_z ≫ g_semi =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)) := by
      dsimp [e_z]
      rw [CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_preimage (hW.fromSpec ≫ g_semi)]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_z) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_B) = _
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hev_comp]
    have he_hit : e_z.base pt₀ = z := by
      let pt₀' : ↥(AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField)) := pt₀
      have h₁ : e_z.base pt₀' =
          hW.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_z)).base pt₀') :=
        AlgebraicGeometry.Scheme.Hom.comp_apply _ _ pt₀'
      have h₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_z)).base pt₀' =
          PrimeSpectrum.comap ev_z pt₀ :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom ev_z) pt₀
      exact (h₁.trans (congrArg hW.fromSpec.base (h₂.trans hev_comap))).trans hpz_eq
    let R_P : Type u := ↥V ⧸ P
    have : ValuationRing R_P := Ideal.Quotient.mk_surjective.valuationRing (Ideal.Quotient.mk P)
    let i₂ : AlgebraicGeometry.Spec (CommRingCat.of R_P) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P))
    let j_P : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_P P.ResidueField))
    have hj_i₂ : j_P ≫ i₂ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)) := by
      dsimp [j_P, i₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    have hSq : CategoryTheory.CommSq e_z j_P g_semi i₂ := ⟨he_comm.trans hj_i₂.symm⟩
    have hUniv : AlgebraicGeometry.UniversallyClosed g_semi := inferInstance
    rw [AlgebraicGeometry.universallyClosed_eq_universallySpecializing] at hUniv
    have hEx : AlgebraicGeometry.ValuativeCriterion.Existence g_semi :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap g_semi hUniv.1
    let S : AlgebraicGeometry.ValuativeCommSq g_semi :=
      AlgebraicGeometry.ValuativeCommSq.mk R_P P.ResidueField e_z i₂ hSq
    have : S.commSq.HasLift := hEx S
    let σ : AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P)) ⟶ C_semi := S.commSq.lift
    have hσ_comm : σ ≫ g_semi = i₂ := S.commSq.fac_right
    have hj_σ : j_P ≫ σ = e_z := S.commSq.fac_left
    refine ⟨σ, hσ_comm, ?_, ?_⟩
    · let pt₀' : ↥(AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField)) := pt₀
      refine ⟨j_P.base pt₀', ?_⟩
      have h₁ : σ.base (j_P.base pt₀') = (j_P ≫ σ).base pt₀' :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply j_P σ pt₀').symm
      rw [h₁, hj_σ]
      exact he_hit
    · have : AlgebraicGeometry.IsClosedImmersion i₂ :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (Ideal.Quotient.mk P)) Ideal.Quotient.mk_surjective
      have : AlgebraicGeometry.IsProper i₂ := inferInstance
      have : AlgebraicGeometry.IsProper (σ ≫ g_semi) := by
        rw [hσ_comm]
        infer_instance
      have : AlgebraicGeometry.IsProper σ := AlgebraicGeometry.IsProper.of_comp σ g_semi
      exact σ.isClosedMap.isClosed_range
  · intro P₁ P₂ _ _ σ₁ σ₂ hσ₁_comm hσ₂_comm hNotDisj pt₁ pt₂ hpt₁_max hpt₂_max
    obtain ⟨w, ⟨r₁_raw, hr₁⟩, ⟨r₂_raw, hr₂⟩⟩ := Set.not_disjoint_iff.mp hNotDisj
    let r₁ : PrimeSpectrum (↥V ⧸ P₁) := r₁_raw
    let r₂ : PrimeSpectrum (↥V ⧸ P₂) := r₂_raw
    let Q₀ : PrimeSpectrum ↥V := g_semi.base w
    let Q : Ideal ↥V := Q₀.asIdeal
    have : Q.IsPrime := Q₀.isPrime
    let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
    have : 𝔪_V.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥V
    have hQ_le_max : Q ≤ 𝔪_V := IsLocalRing.le_maximalIdeal Q₀.isPrime.ne_top
    let m_bar_Q : PrimeSpectrum (↥V ⧸ Q) :=
      ⟨Ideal.map (Ideal.Quotient.mk Q) 𝔪_V,
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
          (by rw [Ideal.mk_ker]; exact hQ_le_max)⟩
    have hm_bar_Q_comap : Ideal.comap (Ideal.Quotient.mk Q) m_bar_Q.asIdeal = 𝔪_V := by
      change Ideal.comap (Ideal.Quotient.mk Q) (Ideal.map (Ideal.Quotient.mk Q) 𝔪_V) = 𝔪_V
      rw [Ideal.comap_map_of_surjective' (Ideal.Quotient.mk Q) Ideal.Quotient.mk_surjective,
        Ideal.mk_ker, sup_eq_left.mpr hQ_le_max]
    have hRestrict : ∀ (P_i : Ideal ↥V) [P_i.IsPrime]
        (σ_i : AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_i)) ⟶ C_semi),
        σ_i ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P_i)) →
        ∀ (r_i pt_i : PrimeSpectrum (↥V ⧸ P_i)),
          σ_i.base r_i = w →
          Ideal.comap (Ideal.Quotient.mk P_i) pt_i.asIdeal = 𝔪_V →
          ∃ τ_i : AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ Q)) ⟶ C_semi,
            τ_i ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q)) ∧
            τ_i.base (⊥ : PrimeSpectrum (↥V ⧸ Q)) = w ∧
            τ_i.base m_bar_Q = σ_i.base pt_i := by
      intro P_i _ σ_i hσ_i r_i pt_i hr_i hpt_i
      let r_i' : ↥(AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_i))) := r_i
      have hBase_r : g_semi.base (σ_i.base r_i') =
          PrimeSpectrum.comap (Ideal.Quotient.mk P_i) r_i := by
        have h₁ := (AlgebraicGeometry.Scheme.Hom.comp_apply σ_i g_semi r_i').symm
        have h₂ := congrArg (fun h => h r_i') hσ_i
        exact h₁.trans (h₂.trans
          (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (Ideal.Quotient.mk P_i)) r_i))
      have hQ_eq : Q = Ideal.comap (Ideal.Quotient.mk P_i) r_i.asIdeal := by
        change (g_semi.base w).asIdeal = _
        rw [← hr_i]
        exact congrArg PrimeSpectrum.asIdeal hBase_r
      have hP_le_Q : P_i ≤ Q := by
        intro v hv
        rw [hQ_eq, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hv]
        exact r_i.asIdeal.zero_mem
      let f_i : (↥V ⧸ P_i) →+* (↥V ⧸ Q) := Ideal.Quotient.factor hP_le_Q
      have hf_comp : f_i.comp (Ideal.Quotient.mk P_i) = Ideal.Quotient.mk Q :=
        Ideal.Quotient.factor_comp_mk hP_le_Q
      let τ_i : AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ Q)) ⟶ C_semi :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_i) ≫ σ_i
      have hτ_comm : τ_i ≫ g_semi =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q)) := by
        dsimp [τ_i]
        rw [CategoryTheory.Category.assoc, hσ_i, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hf_comp]
      have hComap_bot : PrimeSpectrum.comap f_i (⊥ : PrimeSpectrum (↥V ⧸ Q)) = r_i := by
        apply PrimeSpectrum.ext
        have hComap_eq : Ideal.comap (Ideal.Quotient.mk P_i)
            (PrimeSpectrum.comap f_i (⊥ : PrimeSpectrum (↥V ⧸ Q))).asIdeal =
            Ideal.comap (Ideal.Quotient.mk P_i) r_i.asIdeal := by
          rw [← hQ_eq]
          ext v
          change f_i (Ideal.Quotient.mk P_i v) ∈ (⊥ : Ideal (↥V ⧸ Q)) ↔ v ∈ Q
          have hf_v : f_i (Ideal.Quotient.mk P_i v) = Ideal.Quotient.mk Q v :=
            congrFun (congrArg DFunLike.coe hf_comp) v
          rw [hf_v, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
        have hMap_eq := congrArg (Ideal.map (Ideal.Quotient.mk P_i)) hComap_eq
        simpa only [Ideal.map_comap_of_surjective (Ideal.Quotient.mk P_i)
          Ideal.Quotient.mk_surjective] using hMap_eq
      have hComap_max : PrimeSpectrum.comap f_i m_bar_Q = pt_i := by
        apply PrimeSpectrum.ext
        have hComap_eq : Ideal.comap (Ideal.Quotient.mk P_i)
            (PrimeSpectrum.comap f_i m_bar_Q).asIdeal =
            Ideal.comap (Ideal.Quotient.mk P_i) pt_i.asIdeal := by
          rw [hpt_i, ← hm_bar_Q_comap]
          ext v
          change f_i (Ideal.Quotient.mk P_i v) ∈ m_bar_Q.asIdeal ↔
            Ideal.Quotient.mk Q v ∈ m_bar_Q.asIdeal
          have hf_v : f_i (Ideal.Quotient.mk P_i v) = Ideal.Quotient.mk Q v :=
            congrFun (congrArg DFunLike.coe hf_comp) v
          rw [hf_v]
        have hMap_eq := congrArg (Ideal.map (Ideal.Quotient.mk P_i)) hComap_eq
        simpa only [Ideal.map_comap_of_surjective (Ideal.Quotient.mk P_i)
          Ideal.Quotient.mk_surjective] using hMap_eq
      refine ⟨τ_i, hτ_comm, ?_, ?_⟩
      · let bot_Q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ Q))) :=
          (⊥ : PrimeSpectrum (↥V ⧸ Q))
        have h₁ : τ_i.base bot_Q =
            σ_i.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_i)).base bot_Q) :=
          AlgebraicGeometry.Scheme.Hom.comp_apply _ _ bot_Q
        have h₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_i)).base bot_Q =
            PrimeSpectrum.comap f_i (⊥ : PrimeSpectrum (↥V ⧸ Q)) :=
          AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom f_i) (⊥ : PrimeSpectrum (↥V ⧸ Q))
        exact (h₁.trans (congrArg σ_i.base (h₂.trans hComap_bot))).trans hr_i
      · let m_Q' : ↥(AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ Q))) := m_bar_Q
        have h₁ : τ_i.base m_Q' =
            σ_i.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_i)).base m_Q') :=
          AlgebraicGeometry.Scheme.Hom.comp_apply _ _ m_Q'
        have h₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_i)).base m_Q' =
            PrimeSpectrum.comap f_i m_bar_Q :=
          AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom f_i) m_bar_Q
        exact h₁.trans (congrArg σ_i.base (h₂.trans hComap_max))
    obtain ⟨τ₁, hτ₁_comm, hτ₁_bot, hτ₁_max⟩ :=
      hRestrict P₁ σ₁ hσ₁_comm r₁ pt₁ hr₁ hpt₁_max
    obtain ⟨τ₂, hτ₂_comm, hτ₂_bot, hτ₂_max⟩ :=
      hRestrict P₂ σ₂ hσ₂_comm r₂ pt₂ hr₂ hpt₂_max
    let R_Q : Type u := ↥V ⧸ Q
    have : ValuationRing R_Q := Ideal.Quotient.mk_surjective.valuationRing (Ideal.Quotient.mk Q)
    let κ_Q : Type u := Q.ResidueField
    let j_Q : AlgebraicGeometry.Spec (CommRingCat.of κ_Q) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_Q) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_Q κ_Q))
    have hj_Q_pt : ∀ pt : PrimeSpectrum κ_Q,
        j_Q.base pt = (⊥ : PrimeSpectrum R_Q) := by
      intro pt
      have h₁ : j_Q.base pt = PrimeSpectrum.comap (algebraMap R_Q κ_Q) pt :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap R_Q κ_Q)) pt
      rw [h₁]
      apply PrimeSpectrum.ext
      have hpt_bot : pt.asIdeal = ⊥ := Ideal.eq_bot_of_prime pt.asIdeal
      ext x
      change algebraMap R_Q κ_Q x ∈ pt.asIdeal ↔ x ∈ (⊥ : Ideal R_Q)
      rw [hpt_bot, Submodule.mem_bot, Submodule.mem_bot]
      exact map_eq_zero_iff (algebraMap R_Q κ_Q) (IsFractionRing.injective R_Q κ_Q)
    obtain ⟨W_w, hWw, hw_Ww, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := w) trivial
    let B_w : Type u := ↑(C_semi.presheaf.obj (Opposite.op W_w))
    let c_Bw : ↥V →+* B_w := (AlgebraicGeometry.Spec.preimage (hWw.fromSpec ≫ g_semi)).hom
    have hLiftGen : ∀ (τ : AlgebraicGeometry.Spec (CommRingCat.of R_Q) ⟶ C_semi),
        τ ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q)) →
        τ.base (⊥ : PrimeSpectrum R_Q) = w →
        ∃ ψ : B_w →+* κ_Q,
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hWw.fromSpec = j_Q ≫ τ ∧
          ψ.comp c_Bw = algebraMap ↥V κ_Q ∧
          hWw.fromSpec.base (PrimeSpectrum.comap ψ (⊥ : PrimeSpectrum κ_Q)) = w := by
      intro τ hτ_comm hτ_bot
      have hτ_pt : ∀ pt : PrimeSpectrum κ_Q, (j_Q ≫ τ).base pt = w := by
        intro pt
        let pt' : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ_Q)) := pt
        have h₁ : (j_Q ≫ τ).base pt' = τ.base (j_Q.base pt') :=
          AlgebraicGeometry.Scheme.Hom.comp_apply j_Q τ pt'
        exact (h₁.trans (congrArg τ.base (hj_Q_pt pt))).trans hτ_bot
      have hSub : Set.range (j_Q ≫ τ).base ⊆ Set.range hWw.fromSpec.base := by
        rw [hWw.range_fromSpec]
        rintro _ ⟨pt, rfl⟩
        rw [hτ_pt pt]
        exact hw_Ww
      let ℓ := AlgebraicGeometry.IsOpenImmersion.lift hWw.fromSpec (j_Q ≫ τ) hSub
      have hℓ_fac : ℓ ≫ hWw.fromSpec = j_Q ≫ τ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hWw.fromSpec (j_Q ≫ τ) hSub
      let ψ : B_w →+* κ_Q := (AlgebraicGeometry.Spec.preimage ℓ).hom
      have hψ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) = ℓ :=
        AlgebraicGeometry.Spec.map_preimage ℓ
      have hψ_fac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hWw.fromSpec =
          j_Q ≫ τ := by
        rw [hψ_map, hℓ_fac]
      have hψ_comp : ψ.comp c_Bw = algebraMap ↥V κ_Q := by
        have hSpec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp c_Bw)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V κ_Q)) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (hWw.fromSpec ≫ g_semi)) = _
          rw [AlgebraicGeometry.Spec.map_preimage, ← CategoryTheory.Category.assoc, hψ_fac,
            CategoryTheory.Category.assoc, hτ_comm]
          dsimp [j_Q]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          rfl
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_eq)
      refine ⟨ψ, hψ_fac, hψ_comp, ?_⟩
      let pt_Q : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ_Q)) := (⊥ : PrimeSpectrum κ_Q)
      have h₁ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hWw.fromSpec).base pt_Q =
          hWw.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base pt_Q) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply _ _ pt_Q
      have h₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base pt_Q =
          PrimeSpectrum.comap ψ (⊥ : PrimeSpectrum κ_Q) :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom ψ) (⊥ : PrimeSpectrum κ_Q)
      rw [← h₂, ← h₁, hψ_fac]
      exact hτ_pt (⊥ : PrimeSpectrum κ_Q)
    obtain ⟨ψ₁, hψ₁_fac, hψ₁_comp, hψ₁_pt⟩ := hLiftGen τ₁ hτ₁_comm hτ₁_bot
    obtain ⟨ψ₂, hψ₂_fac, hψ₂_comp, hψ₂_pt⟩ := hLiftGen τ₂ hτ₂_comm hτ₂_bot
    have hComap_ψ : PrimeSpectrum.comap ψ₁ (⊥ : PrimeSpectrum κ_Q) =
        PrimeSpectrum.comap ψ₂ (⊥ : PrimeSpectrum κ_Q) :=
      hWw.fromSpec.isOpenEmbedding.injective (hψ₁_pt.trans hψ₂_pt.symm)
    have hKer_eq : RingHom.ker ψ₁ = RingHom.ker ψ₂ :=
      congrArg PrimeSpectrum.asIdeal hComap_ψ
    have hψ_eq : ψ₁ = ψ₂ := by
      ext b
      obtain ⟨⟨v_bar, s_bar⟩, h_surj⟩ :=
        IsLocalization.surj (nonZeroDivisors R_Q) (ψ₁ b)
      dsimp only at h_surj
      obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective v_bar
      obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective s_bar.1
      have hs_bar_ne : s_bar.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_bar.2
      let s_tilde : κ_Q := algebraMap ↥V κ_Q s
      let v_tilde : κ_Q := algebraMap ↥V κ_Q v
      have hs_tilde_eq : s_tilde = algebraMap R_Q κ_Q s_bar.1 := by
        dsimp [s_tilde]
        rw [← hs]
        exact (Ideal.algebraMap_quotient_residueField_mk Q s).symm
      have hv_tilde_eq : v_tilde = algebraMap R_Q κ_Q v_bar := by
        dsimp [v_tilde]
        rw [← hv]
        exact (Ideal.algebraMap_quotient_residueField_mk Q v).symm
      have hs_tilde_ne : s_tilde ≠ 0 := by
        rw [hs_tilde_eq]
        exact fun h0 => hs_bar_ne ((IsFractionRing.injective R_Q κ_Q)
          (h0.trans (map_zero (algebraMap R_Q κ_Q)).symm))
      have hψ₁_c : ∀ u : ↥V, ψ₁ (c_Bw u) = algebraMap ↥V κ_Q u :=
        fun u => congrFun (congrArg DFunLike.coe hψ₁_comp) u
      have hψ₂_c : ∀ u : ↥V, ψ₂ (c_Bw u) = algebraMap ↥V κ_Q u :=
        fun u => congrFun (congrArg DFunLike.coe hψ₂_comp) u
      have h_mul₁ : ψ₁ b * s_tilde = v_tilde := by
        rw [hs_tilde_eq, hv_tilde_eq]
        exact h_surj
      have hd_ker₁ : b * c_Bw s - c_Bw v ∈ RingHom.ker ψ₁ := by
        rw [RingHom.mem_ker, map_sub, map_mul, hψ₁_c s, hψ₁_c v]
        exact sub_eq_zero.mpr h_mul₁
      have hd_ker₂ : b * c_Bw s - c_Bw v ∈ RingHom.ker ψ₂ := by
        rwa [← hKer_eq]
      rw [RingHom.mem_ker, map_sub, map_mul, hψ₂_c s, hψ₂_c v] at hd_ker₂
      have h_mul₂ : ψ₂ b * s_tilde = v_tilde := sub_eq_zero.mp hd_ker₂
      exact mul_right_cancel₀ hs_tilde_ne (h_mul₁.trans h_mul₂.symm)
    have heq_gen : j_Q ≫ τ₁ = j_Q ≫ τ₂ := by
      rw [← hψ₁_fac, ← hψ₂_fac, hψ_eq]
    let i_Q : AlgebraicGeometry.Spec (CommRingCat.of R_Q) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q))
    have hSq_Q : CategoryTheory.CommSq (j_Q ≫ τ₁) j_Q g_semi i_Q :=
      ⟨by rw [CategoryTheory.Category.assoc, hτ₁_comm]⟩
    let S_Q : AlgebraicGeometry.ValuativeCommSq g_semi :=
      AlgebraicGeometry.ValuativeCommSq.mk R_Q κ_Q (j_Q ≫ τ₁) i_Q hSq_Q
    have hUniq : AlgebraicGeometry.ValuativeCriterion.Uniqueness g_semi :=
      AlgebraicGeometry.IsSeparated.valuativeCriterion g_semi
    have : Subsingleton S_Q.commSq.LiftStruct := hUniq S_Q
    let L₁ : S_Q.commSq.LiftStruct := ⟨τ₁, rfl, hτ₁_comm⟩
    let L₂ : S_Q.commSq.LiftStruct := ⟨τ₂, heq_gen.symm, hτ₂_comm⟩
    have hτ_eq : τ₁ = τ₂ :=
      congrArg CategoryTheory.CommSq.LiftStruct.l (Subsingleton.elim L₁ L₂)
    rw [← hτ₁_max, ← hτ₂_max, hτ_eq]

theorem weil_open_subscheme_birational_locallyQuasiFinite_setup (C_tilde C_semi : AlgebraicGeometry.Scheme.{u})
    (F : Type u) [Field F]
    (q : C_tilde ⟶ C_semi)
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
    (η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi)
    (hInt_tilde : AlgebraicGeometry.IsIntegral C_tilde)
    (hInt_semi : AlgebraicGeometry.IsIntegral C_semi)
    (hNorm_semi : IsAffineNormalScheme C_semi)
    (hProp_q : AlgebraicGeometry.IsProper q)
    (hη_q : η_tilde ≫ q = η_semi)
    (hFunc_tilde : IsSchemeFunctionField C_tilde F η_tilde)
    (hFunc_semi : IsSchemeFunctionField C_semi F η_semi)
    (U_dom : C_semi.Opens)
    (hη_mem : ∀ pt : PrimeSpectrum F, η_semi.base pt ∈ U_dom)
    (hFin_fib : ∀ y : ↥C_semi, y ∈ U_dom → (q.base ⁻¹' {y}).Finite) :
    let V_dom : C_tilde.Opens := (TopologicalSpace.Opens.map q.base).obj U_dom
    ∃ (η_C : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ V_dom.toScheme)
      (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U_dom.toScheme),
      AlgebraicGeometry.IsIntegral V_dom.toScheme ∧
      AlgebraicGeometry.IsIntegral U_dom.toScheme ∧
      IsAffineNormalScheme U_dom.toScheme ∧
      AlgebraicGeometry.IsProper (q ∣_ U_dom) ∧
      AlgebraicGeometry.IsDominant η_C ∧
      η_C ≫ (q ∣_ U_dom) = η_X ∧
      IsSchemeFunctionField V_dom.toScheme F η_C ∧
      IsSchemeFunctionField U_dom.toScheme F η_X ∧
      (∀ z : ↥V_dom.toScheme,
        ∃ (U_X : U_dom.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (V_C : V_dom.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map (q ∣_ U_dom).base).obj U_X),
          z ∈ V_C ∧
          ((q ∣_ U_dom).appLE U_X V_C e_X).hom.FiniteType ∧
          ((q ∣_ U_dom).appLE U_X V_C e_X).hom.QuasiFinite) :=
by
  intro V_dom
  have : AlgebraicGeometry.IsIntegral C_tilde := hInt_tilde
  have : AlgebraicGeometry.IsIntegral C_semi := hInt_semi
  have : AlgebraicGeometry.IsProper q := hProp_q
  let pt₀ : PrimeSpectrum F := ⊥
  let pt₀' : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := pt₀
  have hq_η : ∀ pt : PrimeSpectrum F, q.base (η_tilde.base pt) = η_semi.base pt := by
    intro pt
    let pt' : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := pt
    have h₁ := (AlgebraicGeometry.Scheme.Hom.comp_apply η_tilde q pt').symm
    have h₂ := congrArg
      (fun h : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi => h.base pt') hη_q
    exact h₁.trans h₂
  have hy₀ : η_semi.base pt₀' ∈ U_dom := hη_mem pt₀
  have hx₀_Vdom : η_tilde.base pt₀' ∈ V_dom := by
    change q.base (η_tilde.base pt₀) ∈ U_dom
    rw [hq_η pt₀]
    exact hη_mem pt₀
  have hNeU : Nonempty ↥U_dom.toScheme := ⟨⟨η_semi.base pt₀', hy₀⟩⟩
  have hNeV : Nonempty ↥V_dom.toScheme := ⟨⟨η_tilde.base pt₀', hx₀_Vdom⟩⟩
  have hIntV : AlgebraicGeometry.IsIntegral V_dom.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion V_dom.ι
  have hIntU : AlgebraicGeometry.IsIntegral U_dom.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_dom.ι
  have hProp_res : AlgebraicGeometry.IsProper (q ∣_ U_dom) := inferInstance
  have hRng_semi : Set.range η_semi.base ⊆ Set.range U_dom.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    exact hη_mem pt
  have hRng_tilde : Set.range η_tilde.base ⊆ Set.range V_dom.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    change q.base (η_tilde.base pt) ∈ U_dom
    rw [hq_η pt]
    exact hη_mem pt
  let η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U_dom.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_dom.ι η_semi hRng_semi
  let η_C : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ V_dom.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift V_dom.ι η_tilde hRng_tilde
  have hηX_fac : η_X ≫ U_dom.ι = η_semi :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_dom.ι η_semi hRng_semi
  have hηC_fac : η_C ≫ V_dom.ι = η_tilde :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac V_dom.ι η_tilde hRng_tilde
  have hη_res : η_C ≫ (q ∣_ U_dom) = η_X := by
    apply (CategoryTheory.cancel_mono U_dom.ι).mp
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
      ← CategoryTheory.Category.assoc, hηC_fac, hη_q, hηX_fac]
  have hChartBridge : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (W₀ : Y.Opens)
      (U : W₀.toScheme.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      Nonempty ↥U →
      ∃ (W : Y.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
        Nonempty ↥W ∧
        ∃ (e_iso : Y.presheaf.obj (Opposite.op W) ≅ W₀.toScheme.presheaf.obj (Opposite.op U)),
          AlgebraicGeometry.Spec.map e_iso.hom ≫ hW.fromSpec = hU.fromSpec ≫ W₀.ι := by
    intro Y W₀ U hU hUne
    let ι := W₀.ι
    let W : Y.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor ι).obj U
    have hW : AlgebraicGeometry.IsAffineOpen W := hU.image_of_isOpenImmersion ι
    obtain ⟨⟨u₀, hu₀⟩⟩ := hUne
    have hu₀_W : ι.base u₀ ∈ W := by
      change ι.base u₀ ∈ (W : Set ↥Y)
      rw [AlgebraicGeometry.Scheme.Hom.coe_image]
      exact ⟨u₀, hu₀, rfl⟩
    have hWne : Nonempty ↥W := ⟨⟨ι.base u₀, hu₀_W⟩⟩
    have h_pre : (TopologicalSpace.Opens.map ι.base).obj W = U :=
      AlgebraicGeometry.Scheme.Hom.preimage_image_eq ι U
    have h_le : U ≤ (TopologicalSpace.Opens.map ι.base).obj W := le_of_eq h_pre.symm
    have : CategoryTheory.IsIso (ι.app W) :=
      AlgebraicGeometry.Scheme.Hom.isIso_app ι W
        (AlgebraicGeometry.Scheme.Hom.image_le_opensRange ι U)
    have h_app_eq : ι.app W ≫
        W₀.toScheme.presheaf.map (CategoryTheory.eqToHom h_pre.symm).op =
        ι.appLE W U h_le := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    have : CategoryTheory.IsIso (ι.appLE W U h_le) := by
      rw [← h_app_eq]
      infer_instance
    let e_iso : Y.presheaf.obj (Opposite.op W) ≅ W₀.toScheme.presheaf.obj (Opposite.op U) :=
      CategoryTheory.asIso (ι.appLE W U h_le)
    refine ⟨W, hW, hWne, e_iso, ?_⟩
    exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι hW hU h_le
  have hNormU : IsAffineNormalScheme U_dom.toScheme := by
    intro U hU hUne
    obtain ⟨W, hW, hWne, e_iso, _⟩ := hChartBridge C_semi U_dom U hU hUne
    let e_ring := e_iso.commRingCatIsoToRingEquiv
    obtain ⟨hDomW, hICW⟩ := hNorm_semi W hW hWne
    exact ⟨@MulEquiv.isDomain _ _ _ _ hDomW e_ring.symm.toMulEquiv,
      @IsIntegrallyClosed.of_equiv _ _ _ _ e_ring hICW⟩
  have hFuncBridge : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (W₀ : Y.Opens)
      (η : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y)
      (η₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W₀.toScheme),
      η₀ ≫ W₀.ι = η →
      IsSchemeFunctionField Y F η →
      IsSchemeFunctionField W₀.toScheme F η₀ := by
    intro Y W₀ η η₀ hfac hFunc U hU hUne
    obtain ⟨W, hW, hWne, e_iso, hSpec_appLE⟩ := hChartBridge Y W₀ U hU hUne
    obtain ⟨φ_W, hFrac_W, hSpec_W⟩ := hFunc W hW hWne
    let φ_U : W₀.toScheme.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F :=
      e_iso.inv ≫ φ_W
    have hSpec_U : AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = η₀ := by
      apply (CategoryTheory.cancel_mono W₀.ι).mp
      calc
        (AlgebraicGeometry.Spec.map (e_iso.inv ≫ φ_W) ≫ hU.fromSpec) ≫ W₀.ι
          = (AlgebraicGeometry.Spec.map φ_W ≫ AlgebraicGeometry.Spec.map e_iso.inv) ≫
              (hU.fromSpec ≫ W₀.ι) := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map φ_W ≫ AlgebraicGeometry.Spec.map e_iso.inv ≫
              (AlgebraicGeometry.Spec.map e_iso.hom ≫ hW.fromSpec) := by
            rw [← hSpec_appLE, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map φ_W ≫
              (AlgebraicGeometry.Spec.map e_iso.inv ≫ AlgebraicGeometry.Spec.map e_iso.hom) ≫
              hW.fromSpec := by
            simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map φ_W ≫
              AlgebraicGeometry.Spec.map (e_iso.hom ≫ e_iso.inv) ≫ hW.fromSpec := by
            rw [AlgebraicGeometry.Spec.map_comp]
        _ = η₀ ≫ W₀.ι := by
            rw [e_iso.hom_inv_id, AlgebraicGeometry.Spec.map_id,
              CategoryTheory.Category.id_comp, hSpec_W, hfac]
    refine ⟨φ_U, ?_, hSpec_U⟩
    let A : Type u := ↑(Y.presheaf.obj (Opposite.op W))
    let B : Type u := ↑(W₀.toScheme.presheaf.obj (Opposite.op U))
    let e_ring : A ≃+* B := e_iso.commRingCatIsoToRingEquiv
    have he_ring_apply : ∀ a : A, e_ring a = e_iso.hom.hom a := fun _ => rfl
    have hφ_apply : ∀ a : A, φ_U.hom (e_ring a) = φ_W.hom a := by
      intro a
      change (e_iso.inv ≫ φ_W).hom (e_ring a) = φ_W.hom a
      rw [CommRingCat.hom_comp, RingHom.comp_apply, he_ring_apply]
      have h_id : e_iso.inv.hom (e_iso.hom.hom a) = a := by
        change (e_iso.hom ≫ e_iso.inv).hom a = a
        rw [e_iso.hom_inv_id, CommRingCat.hom_id, RingHom.id_apply]
      rw [h_id]
    have he_inv_inj : Function.Injective e_iso.inv.hom := by
      intro b₁ b₂ hb
      have h₁ : e_iso.hom.hom (e_iso.inv.hom b₁) = b₁ := by
        change (e_iso.inv ≫ e_iso.hom).hom b₁ = b₁
        rw [e_iso.inv_hom_id, CommRingCat.hom_id, RingHom.id_apply]
      have h₂ : e_iso.hom.hom (e_iso.inv.hom b₂) = b₂ := by
        change (e_iso.inv ≫ e_iso.hom).hom b₂ = b₂
        rw [e_iso.inv_hom_id, CommRingCat.hom_id, RingHom.id_apply]
      rw [← h₁, ← h₂, hb]
    have hInj_A : Function.Injective φ_W.hom :=
      @IsFractionRing.injective A _ F _ φ_W.hom.toAlgebra hFrac_W
    have hInj_B : Function.Injective φ_U.hom := by
      change Function.Injective (e_iso.inv ≫ φ_W).hom
      rw [CommRingCat.hom_comp]
      exact hInj_A.comp he_inv_inj
    have : IsDomain A := Function.Injective.isDomain φ_W.hom hInj_A
    have : IsDomain B := Function.Injective.isDomain φ_U.hom hInj_B
    let _ : Algebra B F := φ_U.hom.toAlgebra
    exact IsLocalization'.mk (Submonoid.IsLocalizationMap.mk
      (fun y => by
        have hy_ne : (y : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        have hmap_ne : φ_U.hom (y : B) ≠ 0 := fun h0 =>
          hy_ne (hInj_B (h0.trans (map_zero φ_U.hom).symm))
        exact IsUnit.mk0 (φ_U.hom (y : B)) hmap_ne)
      (fun z => by
        obtain ⟨⟨a₁, s₁⟩, hz⟩ :=
          @IsLocalization.surj A _ (nonZeroDivisors A) F _ φ_W.hom.toAlgebra hFrac_W z
        have hs₁_ne : (s₁ : A) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s₁.2
        have hs₁'_ne : e_ring (s₁ : A) ≠ 0 := fun h0 =>
          hs₁_ne (e_ring.injective (h0.trans (map_zero e_ring).symm))
        let s₁' : nonZeroDivisors B := ⟨e_ring (s₁ : A), mem_nonZeroDivisors_of_ne_zero hs₁'_ne⟩
        refine ⟨(e_ring a₁, s₁'), ?_⟩
        change z * φ_U.hom (e_ring (s₁ : A)) = φ_U.hom (e_ring a₁)
        rw [hφ_apply (s₁ : A), hφ_apply a₁]
        exact hz)
      (fun {b₁ b₂} hb => by
        have h_eq : b₁ = b₂ := hInj_B hb
        exact ⟨1, by simp [h_eq]⟩))
  have hFuncV : IsSchemeFunctionField V_dom.toScheme F η_C :=
    hFuncBridge C_tilde V_dom η_tilde η_C hηC_fac hFunc_tilde
  have hFuncU : IsSchemeFunctionField U_dom.toScheme F η_X :=
    hFuncBridge C_semi U_dom η_semi η_X hηX_fac hFunc_semi
  have hDomC : AlgebraicGeometry.IsDominant η_C := by
    let x₀ : ↥V_dom.toScheme := η_C.base pt₀'
    obtain ⟨V₀, hV₀, hx₀_V₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x₀) trivial
    have hNeV₀ : Nonempty ↥V₀ := ⟨⟨x₀, hx₀_V₀⟩⟩
    obtain ⟨φ₀, hFrac₀, hSpec₀⟩ := hFuncV V₀ hV₀ hNeV₀
    let R₀ : Type u := ↑(V_dom.toScheme.presheaf.obj (Opposite.op V₀))
    have hInj₀ : Function.Injective φ₀.hom :=
      @IsFractionRing.injective R₀ _ F _ φ₀.hom.toAlgebra hFrac₀
    have : IsDomain R₀ := Function.Injective.isDomain φ₀.hom hInj₀
    let botR₀ : PrimeSpectrum R₀ := ⊥
    let botR₀' : ↥(AlgebraicGeometry.Spec (V_dom.toScheme.presheaf.obj (Opposite.op V₀))) := botR₀
    have hBot_map : (AlgebraicGeometry.Spec.map φ₀).base pt₀' = botR₀' := by
      apply PrimeSpectrum.ext
      change Ideal.comap φ₀.hom pt₀.asIdeal = (⊥ : PrimeSpectrum R₀).asIdeal
      rw [PrimeSpectrum.asIdeal_bot, PrimeSpectrum.asIdeal_bot]
      ext r
      simp only [Ideal.mem_comap, Submodule.mem_bot]
      exact ⟨fun hr => hInj₀ (hr.trans (map_zero φ₀.hom).symm),
        fun hr => by rw [hr, map_zero]⟩
    have hFromSpec_bot : hV₀.fromSpec.base botR₀' = x₀ := by
      rw [← hBot_map]
      have h₁ := (AlgebraicGeometry.Scheme.Hom.comp_apply
        (AlgebraicGeometry.Spec.map φ₀) hV₀.fromSpec pt₀').symm
      have h₂ := congrArg
        (fun h : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ V_dom.toScheme => h.base pt₀')
        hSpec₀
      exact h₁.trans h₂
    have : IrreducibleSpace ↥V_dom.toScheme :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral V_dom.toScheme hIntV
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
    intro w
    rw [mem_closure_iff]
    intro O hO hwO
    have hDenseV₀ : Dense (V₀ : Set ↥V_dom.toScheme) := V₀.isOpen.dense ⟨x₀, hx₀_V₀⟩
    obtain ⟨u, huO, huV₀⟩ := hDenseV₀.inter_open_nonempty O hO ⟨w, hwO⟩
    have hu_rng : u ∈ Set.range hV₀.fromSpec.base := by
      rw [hV₀.range_fromSpec]
      exact huV₀
    obtain ⟨p₀, hp₀⟩ := hu_rng
    let p₀_spec : PrimeSpectrum R₀ := p₀
    have hp₀_cl : p₀_spec ∈ closure ({botR₀} : Set (PrimeSpectrum R₀)) :=
      (PrimeSpectrum.le_iff_mem_closure botR₀ p₀_spec).mp (bot_le : (⊥ : Ideal R₀) ≤ p₀_spec.asIdeal)
    let O' : Set (PrimeSpectrum R₀) := hV₀.fromSpec.base ⁻¹' O
    have hO' : IsOpen O' := hO.preimage hV₀.fromSpec.continuous
    have hp₀_O' : p₀_spec ∈ O' := by
      change hV₀.fromSpec.base p₀ ∈ O
      rw [hp₀]
      exact huO
    obtain ⟨q₀, hq₀_O', hq₀_eq⟩ := mem_closure_iff.mp hp₀_cl O' hO' hp₀_O'
    rw [Set.mem_singleton_iff] at hq₀_eq
    have hbot_O : hV₀.fromSpec.base botR₀' ∈ O := by
      change botR₀ ∈ O'
      rw [← hq₀_eq]
      exact hq₀_O'
    rw [hFromSpec_bot] at hbot_O
    exact ⟨x₀, hbot_O, ⟨pt₀', rfl⟩⟩
  have hLocQF : ∀ z : ↥V_dom.toScheme,
      ∃ (U_X : U_dom.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : V_dom.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map (q ∣_ U_dom).base).obj U_X),
        z ∈ V_C ∧
        ((q ∣_ U_dom).appLE U_X V_C e_X).hom.FiniteType ∧
        ((q ∣_ U_dom).appLE U_X V_C e_X).hom.QuasiFinite := by
    intro z
    let q_res := q ∣_ U_dom
    have : AlgebraicGeometry.IsProper q_res := hProp_res
    obtain ⟨U_X, hUX, hz_UX, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := q_res.base z) trivial
    have hz_pre : z ∈ (TopologicalSpace.Opens.map q_res.base).obj U_X := hz_UX
    obtain ⟨V_C, hVC, hz_VC, e_X⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (TopologicalSpace.Opens.map q_res.base).obj U_X) (x := z) hz_pre
    let R_X : Type u := ↑(U_dom.toScheme.presheaf.obj (Opposite.op U_X))
    let S_C : Type u := ↑(V_dom.toScheme.presheaf.obj (Opposite.op V_C))
    let α : R_X →+* S_C := (q_res.appLE U_X V_C e_X).hom
    have hFT : α.FiniteType :=
      AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE q_res hUX hVC e_X
    have hQF : α.QuasiFinite := by
      let _ : Algebra R_X S_C := α.toAlgebra
      have _ : Algebra.FiniteType R_X S_C := hFT
      change (algebraMap R_X S_C).QuasiFinite
      rw [RingHom.quasiFinite_algebraMap, Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
      intro x
      let x' : ↥(AlgebraicGeometry.Spec (U_dom.toScheme.presheaf.obj (Opposite.op U_X))) := x
      let y : ↥C_semi := U_dom.ι.base (hUX.fromSpec.base x')
      have hy : y ∈ U_dom := by
        have hy_rng : y ∈ Set.range U_dom.ι.base := ⟨hUX.fromSpec.base x', rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hy_rng
        exact hy_rng
      let g_inj : PrimeSpectrum S_C → ↥C_tilde := fun p =>
        let p' : ↥(AlgebraicGeometry.Spec (V_dom.toScheme.presheaf.obj (Opposite.op V_C))) := p
        V_dom.ι.base (hVC.fromSpec.base p')
      have hg_inj : Function.Injective g_inj := by
        intro p₁ p₂ hp_eq
        let p₁' : ↥(AlgebraicGeometry.Spec (V_dom.toScheme.presheaf.obj (Opposite.op V_C))) := p₁
        let p₂' : ↥(AlgebraicGeometry.Spec (V_dom.toScheme.presheaf.obj (Opposite.op V_C))) := p₂
        exact hVC.fromSpec.isOpenEmbedding.injective (V_dom.ι.isOpenEmbedding.injective hp_eq)
      have hSub_fib : g_inj '' (PrimeSpectrum.comap (algebraMap R_X S_C) ⁻¹' {x}) ⊆
          q.base ⁻¹' {y} := by
        rintro _ ⟨p, hp_mem, rfl⟩
        rw [Set.mem_preimage, Set.mem_singleton_iff] at hp_mem ⊢
        let p' : ↥(AlgebraicGeometry.Spec (V_dom.toScheme.presheaf.obj (Opposite.op V_C))) := p
        have h₁ : q.base (g_inj p) = (V_dom.ι ≫ q).base (hVC.fromSpec.base p') :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply V_dom.ι q (hVC.fromSpec.base p')).symm
        have h₂ : (V_dom.ι ≫ q).base (hVC.fromSpec.base p') =
            (q_res ≫ U_dom.ι).base (hVC.fromSpec.base p') :=
          congrArg (fun h : V_dom.toScheme ⟶ C_semi => h.base (hVC.fromSpec.base p'))
            (AlgebraicGeometry.morphismRestrict_ι q U_dom).symm
        have h₃ : (q_res ≫ U_dom.ι).base (hVC.fromSpec.base p') =
            U_dom.ι.base ((hVC.fromSpec ≫ q_res).base p') := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply]
        have h₄ : (hVC.fromSpec ≫ q_res).base p' =
            (AlgebraicGeometry.Spec.map (q_res.appLE U_X V_C e_X) ≫ hUX.fromSpec).base p' :=
          congrArg (fun h : AlgebraicGeometry.Spec _ ⟶ U_dom.toScheme => h.base p')
            (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec q_res hUX hVC e_X).symm
        have h₅ : (AlgebraicGeometry.Spec.map (q_res.appLE U_X V_C e_X) ≫ hUX.fromSpec).base p' =
            hUX.fromSpec.base ((AlgebraicGeometry.Spec.map (q_res.appLE U_X V_C e_X)).base p') :=
          AlgebraicGeometry.Scheme.Hom.comp_apply _ _ p'
        have h₆ : (AlgebraicGeometry.Spec.map (q_res.appLE U_X V_C e_X)).base p' = x' := by
          change PrimeSpectrum.comap (algebraMap R_X S_C) p = x
          exact hp_mem
        rw [h₁, h₂, h₃, h₄, h₅, h₆]
      exact Set.Finite.of_finite_image ((hFin_fib y hy).subset hSub_fib) hg_inj.injOn
    exact ⟨U_X, hUX, V_C, hVC, e_X, hz_VC, hFT, hQF⟩
  exact ⟨η_C, η_X, hIntV, hIntU, hNormU, hProp_res, hDomC, hη_res, hFuncV, hFuncU, hLocQF⟩

theorem weil_projective_modification_finite_bad_locus_and_open_iso (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hInt_semi : AlgebraicGeometry.IsIntegral C_semi)
    (hNorm_semi : IsAffineNormalScheme C_semi)
    (hProp_semi : AlgebraicGeometry.IsProper g_semi)
    (F : Type u) [Field F] (φ_KF : K →+* F)
    (hEss : letI : Algebra K F := φ_KF.toAlgebra; Algebra.EssFiniteType K F)
    (hTr : letI : Algebra K F := φ_KF.toAlgebra; Algebra.trdeg K F ≤ 1)
    (η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi)
    (hη_semi : η_semi ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF.comp V.subtype)))
    (hFunc_semi : IsSchemeFunctionField C_semi F η_semi)
    (M : ℕ)
    (C_tilde : AlgebraicGeometry.Scheme.{u})
    (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ιP_tilde : C_tilde ⟶ (weilProjectiveSpaceOver ↥V M).left)
    (hInt_tilde : AlgebraicGeometry.IsIntegral C_tilde)
    (hProp_tilde : AlgebraicGeometry.IsProper g_tilde)
    (hClP_tilde : AlgebraicGeometry.IsClosedImmersion ιP_tilde)
    (hCommP_tilde : ιP_tilde ≫ (weilProjectiveSpaceOver ↥V M).hom = g_tilde)
    (q : C_tilde ⟶ C_semi)
    (hProp_q : AlgebraicGeometry.IsProper q)
    (hq_comm : q ≫ g_semi = g_tilde)
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
    (hη_q : η_tilde ≫ q = η_semi)
    (hFunc_tilde : IsSchemeFunctionField C_tilde F η_tilde)
    (U_gen : C_semi.Opens)
    (hIso_gen : CategoryTheory.IsIso (q ∣_ U_gen))
    (hU_gen : ∀ x : C_semi, (g_semi.base x).asIdeal = ⊥ → x ∈ U_gen) :
    ∃ (U_dom : C_semi.Opens)
      (b : ℕ) (K_bad : Fin b → Set ↥C_semi) (y_bad : Fin b → ↥C_semi),
      CategoryTheory.IsIso (q ∣_ U_dom) ∧
      (U_dom : Set ↥C_semi)ᶜ = (⋃ ν : Fin b, K_bad ν) ∧
      (∀ ν : Fin b, IsClosed (K_bad ν) ∧ y_bad ν ∈ K_bad ν ∧
        (g_semi.base (y_bad ν)).asIdeal = IsLocalRing.maximalIdeal ↥V) ∧
      (∀ ν ν' : Fin b, ν ≠ ν' → Disjoint (K_bad ν) (K_bad ν')) ∧
      (∀ ν : Fin b,
        ∃ (r_ν : ℕ) (P_ν : Fin r_ν → Ideal ↥V) (_ : ∀ j, (P_ν j).IsPrime)
          (σ_ν : ∀ j : Fin r_ν, AlgebraicGeometry.Spec (CommRingCat.of (↥V ⧸ P_ν j)) ⟶ C_semi),
          (∀ j : Fin r_ν,
            P_ν j ≠ ⊥ ∧
            σ_ν j ≫ g_semi = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (P_ν j))) ∧
            ∀ pt : PrimeSpectrum (↥V ⧸ P_ν j),
              Ideal.comap (Ideal.Quotient.mk (P_ν j)) pt.asIdeal = IsLocalRing.maximalIdeal ↥V →
              (σ_ν j).base pt = y_bad ν) ∧
          K_bad ν = ⋃ j : Fin r_ν, Set.range (σ_ν j).base) :=
by
  classical
  have hTwoVar :=
    (weil_gauss_divisorial_valuation_finiteness_and_trdeg_bound K V F φ_KF hEss hTr).2
  have : AlgebraicGeometry.IsProper g_tilde := hProp_tilde
  have : AlgebraicGeometry.IsProper q := hProp_q
  have : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥V)) :=
    PrimeSpectrum.compactSpace
  have : CompactSpace ↥C_tilde :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g_tilde
  
  have hExAff : ∀ x₀ : ↥C_tilde, ∃ W : C_tilde.Opens,
      AlgebraicGeometry.IsAffineOpen W ∧ x₀ ∈ W := by
    intro x₀
    obtain ⟨W, hW, hx₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x₀) trivial
    exact ⟨W, hW, hx₀⟩
  choose V_pt hVpt_aff hx_Vpt using hExAff
  obtain ⟨S_cov, hScov_univ⟩ := isCompact_univ.elim_finite_subcover
    (fun x₀ : ↥C_tilde => (V_pt x₀ : Set ↥C_tilde))
    (fun x₀ => (V_pt x₀).isOpen)
    (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_Vpt x⟩)
  have hScov : ∀ x : ↥C_tilde, ∃ x₀ ∈ S_cov, x ∈ V_pt x₀ := by
    intro x
    have hx := hScov_univ (Set.mem_univ x)
    simpa only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] using hx
  let A_pt : ↥C_tilde → Type u := fun x₀ => ↑(C_tilde.presheaf.obj (Opposite.op (V_pt x₀)))
  have hNe_Vpt : ∀ x₀ : ↥C_tilde, Nonempty ↥(V_pt x₀) := fun x₀ => ⟨⟨x₀, hx_Vpt x₀⟩⟩
  choose φ_pt hFrac_pt hSpec_pt using fun x₀ => hFunc_tilde (V_pt x₀) (hVpt_aff x₀) (hNe_Vpt x₀)
  let ψ_pt : ∀ x₀ : ↥C_tilde, A_pt x₀ →+* F := fun x₀ => (φ_pt x₀).hom
  have hInj_pt : ∀ x₀ : ↥C_tilde, Function.Injective (ψ_pt x₀) := fun x₀ =>
    @IsFractionRing.injective (A_pt x₀) _ F _ (φ_pt x₀).hom.toAlgebra (hFrac_pt x₀)
  have hDom_pt : ∀ x₀ : ↥C_tilde, IsDomain (A_pt x₀) := fun x₀ =>
    Function.Injective.isDomain (ψ_pt x₀) (hInj_pt x₀)
  let c_pt : ∀ x₀ : ↥C_tilde, ↥V →+* A_pt x₀ := fun x₀ =>
    (AlgebraicGeometry.Spec.preimage ((hVpt_aff x₀).fromSpec ≫ g_tilde)).hom
  have hc_FT : ∀ x₀ : ↥C_tilde, (c_pt x₀).FiniteType := by
    intro x₀
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType ((hVpt_aff x₀).fromSpec ≫ g_tilde) :=
      inferInstance
    rw [← AlgebraicGeometry.Spec.map_preimage ((hVpt_aff x₀).fromSpec ≫ g_tilde)] at hLFT
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
  have hCompat_pt : ∀ x₀ : ↥C_tilde, (ψ_pt x₀).comp (c_pt x₀) = φ_KF.comp V.subtype := by
    intro x₀
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ_pt x₀).comp (c_pt x₀))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF.comp V.subtype)) := by
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ_pt x₀).comp (c_pt x₀)))
          = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (c_pt x₀) ≫ CommRingCat.ofHom (ψ_pt x₀)) := by
            rw [CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Spec.preimage ((hVpt_aff x₀).fromSpec ≫ g_tilde) ≫ φ_pt x₀) :=
            rfl
        _ = AlgebraicGeometry.Spec.map (φ_pt x₀) ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Spec.preimage ((hVpt_aff x₀).fromSpec ≫ g_tilde)) :=
            AlgebraicGeometry.Spec.map_comp _ _
        _ = AlgebraicGeometry.Spec.map (φ_pt x₀) ≫ ((hVpt_aff x₀).fromSpec ≫ g_tilde) := by
            rw [AlgebraicGeometry.Spec.map_preimage]
        _ = (AlgebraicGeometry.Spec.map (φ_pt x₀) ≫ (hVpt_aff x₀).fromSpec) ≫ g_tilde := by
            rw [CategoryTheory.Category.assoc]
        _ = η_tilde ≫ g_tilde := by rw [hSpec_pt x₀]
        _ = η_tilde ≫ (q ≫ g_semi) := by rw [hq_comm]
        _ = (η_tilde ≫ q) ≫ g_semi := by rw [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF.comp V.subtype)) := by
            rw [hη_q, hη_semi]
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap)
  
  have hFibP : ∀ P : PrimeSpectrum ↥V,
      {y : ↑(g_semi.base ⁻¹' {P}) | ¬ (q.base ⁻¹' {y.1}).Finite}.Finite ∧
      ∀ y : ↑(g_semi.base ⁻¹' {P}),
        ¬ (q.base ⁻¹' {y.1}).Finite →
        IsClosed ({y} : Set ↑(g_semi.base ⁻¹' {P})) := by
    intro P
    let Φ_tilde : Set ↥C_tilde := g_tilde.base ⁻¹' {P}
    let Φ_semi : Set ↥C_semi := g_semi.base ⁻¹' {P}
    let q_P : ↥Φ_tilde → ↥Φ_semi := fun x =>
      ⟨q.base x.1, by
        change g_semi.base (q.base x.1) = P
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hq_comm]
        exact x.2⟩
    have hq_P_cont : Continuous q_P :=
      Continuous.subtype_mk (q.continuous.comp continuous_subtype_val) _
    have hq_P_closed : IsClosedMap q_P := by
      intro Z hZ
      obtain ⟨F_cl, hF_cl, rfl⟩ := isClosed_induced_iff.mp hZ
      have hImg : q_P '' (Subtype.val ⁻¹' F_cl) = Subtype.val ⁻¹' (q.base '' F_cl) := by
        ext y
        constructor
        · rintro ⟨x, hx, rfl⟩
          exact ⟨x.1, hx, rfl⟩
        · rintro ⟨x₁, hx₁, hqx₁⟩
          have hx₁_mem : x₁ ∈ Φ_tilde := by
            change g_tilde.base x₁ = P
            rw [← hq_comm, AlgebraicGeometry.Scheme.Hom.comp_apply, hqx₁]
            exact y.2
