theorem weil_localRing_affineOpen_closedFiber_pullback_spec (R : Type u) [CommRing R] [IsLocalRing R]
    (X : AlgebraicGeometry.Scheme.{u})
    (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (U : X.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal R).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))
    let Y := CategoryTheory.Limits.pullback f s₀
    let fstY := CategoryTheory.Limits.pullback.fst f s₀
    let A := X.presheaf.obj (Opposite.op U)
    let φ_A : R →+* ↑A := (
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE f ⊤ U le_top).hom
    let I_m : Ideal ↑A := Ideal.map φ_A (IsLocalRing.maximalIdeal R)
    (AlgebraicGeometry.Flat f → φ_A.Flat) ∧
