        exact hsum
      rw [hsum_s, Fintype.sum_sum_type] at hcEq
      let K_c : ℕ := (Finset.univ : Finset (Fin r₀ ⊕ Fin r₁)).card
      refine ⟨(K_c * L + 1) + M,
        fun i => c (Sum.inl i) * (α i) ^ (L + 1) * (f i) ^ (M * n₁ + 1),
        fun j => c (Sum.inr j) * (γ j) ^ (L + 1) * (h j) ^ (M * n₀ + 1),
        fun i => A.mul_mem (A.mul_mem (hcA _ (Finset.mem_univ _)) (A.pow_mem (hfα i).2 _))
