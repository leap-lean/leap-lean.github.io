    have hIC_RP : IsIntegrallyClosed (↥V ⧸ P_id) := IsIntegrallyClosed.of_equiv e_VP.symm
    refine ⟨⟨V_P, e_VP, hVP_comm⟩, hIC_RP, ?_⟩
    intro D _ φ hφ p q m_x _ _ _ hp_min hq_ge hpm hqm
    exact poly_etale_incidence_abstract (↥V) P_id hIC_RP D φ hφ p q m_x hp_min hq_ge hpm hqm
