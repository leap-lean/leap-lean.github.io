    have _ : AlgebraicGeometry.IsAffineHom fst_s :=
      CategoryTheory.MorphismProperty.pullback_fst (P := @AlgebraicGeometry.IsAffineHom) g s hAff_s
    let V₀_s : (CategoryTheory.Limits.pullback g s).Opens :=
      (TopologicalSpace.Opens.map fst_s.base).obj V₀
    let V₁_s : (CategoryTheory.Limits.pullback g s).Opens :=
      (TopologicalSpace.Opens.map fst_s.base).obj V₁
    have hAff₀_s : AlgebraicGeometry.IsAffineOpen V₀_s := hAff₀.preimage fst_s
    have hAff₁_s : AlgebraicGeometry.IsAffineOpen V₁_s := hAff₁.preimage fst_s
    obtain ⟨y₁, hy₁E, hy₁_notV₁⟩ := hNonAff V₁_s hAff₁_s
    have hy₁_V₀ : y₁ ∈ (V₀_s : Set ↥(CategoryTheory.Limits.pullback g s)) := by
      have htop : fst_s.base y₁ ∈ (⊤ : C.Opens) := trivial
      rw [← hCov] at htop
      rcases htop with h0 | h1
      · exact h0
      · exact False.elim (hy₁_notV₁ h1)
    obtain ⟨y₀, hy₀E, hy₀_notV₀⟩ := hNonAff V₀_s hAff₀_s
    have hy₀_V₁ : y₀ ∈ (V₁_s : Set ↥(CategoryTheory.Limits.pullback g s)) := by
      have htop : fst_s.base y₀ ∈ (⊤ : C.Opens) := trivial
      rw [← hCov] at htop
      rcases htop with h0 | h1
      · exact False.elim (hy₀_notV₀ h0)
      · exact h1
    obtain ⟨y, hyE, hyV₀, hyV₁⟩ :=
      hE.1.2 (V₀_s : Set ↥(CategoryTheory.Limits.pullback g s))
        (V₁_s : Set ↥(CategoryTheory.Limits.pullback g s))
        V₀_s.2 V₁_s.2 ⟨y₁, hy₁E, hy₁_V₀⟩ ⟨y₀, hy₀E, hy₀_V₁⟩
    exact ⟨y, ⟨hyV₀, hyV₁⟩, hyE⟩
  have hNzdOfMinPrimes :
      ∀ {B : Type u} [CommRing B] [IsReduced B] {u : B},
        (∀ p ∈ minimalPrimes B, u ∉ p) → ∀ b : B, u * b = 0 → b = 0 := by
    intro B _ _ u hu b hub
    have hb_sInf : b ∈ sInf (minimalPrimes B) := by
      rw [Ideal.mem_sInf]
      intro p hp
      have hp_prime : p.IsPrime := Ideal.IsMinimalPrime.isPrime hp
      have hmul : u * b ∈ p := hub.symm ▸ p.zero_mem
      exact (hp_prime.mul_mem_iff_mem_or_mem.mp hmul).resolve_left (hu p hp)
    change b ∈ sInf (⊥ : Ideal B).minimalPrimes at hb_sInf
    rw [Ideal.sInf_minimalPrimes] at hb_sInf
    change b ∈ nilradical B at hb_sInf
    rw [nilradical_eq_zero, Submodule.zero_eq_bot] at hb_sInf
    exact Ideal.mem_bot.mp hb_sInf
  refine ⟨hOverlapGen, ?_⟩
  intro hNonAffY ψ₀ ψ₁ hRange₀ hBasψ₀ hRed₀ hMin₀ hRange₁ hBasψ₁ hRed₁ hMin₁
  have hNzd_h₀ : ∀ r : ℕ, ∀ b : ↑R₀ ⧸ I_m0, Ideal.Quotient.mk I_m0 (h₀ ^ r) * b = 0 → b = 0 := by
    intro r
    apply hNzdOfMinPrimes
    intro p hp
    have hp_prime : p.IsPrime := Ideal.IsMinimalPrime.isPrime hp
    obtain ⟨E, hE, hPreE⟩ := hMin₀ p hp
    obtain ⟨y, ⟨hyV₀, hyV₁⟩, hyE⟩ := hOverlapGen k₀ s₀ E hE (hNonAffY E hE)
    have hy_range₀ : y ∈ Set.range ψ₀.base := by
      rw [hRange₀]
      exact hyV₀
    obtain ⟨q, hq_eq⟩ := hy_range₀
    have hq_pre : q ∈ ψ₀.base ⁻¹' E := by
      change ψ₀.base q ∈ E
      rwa [hq_eq]
    have hp_le_q : (p : Set (↑R₀ ⧸ I_m0)) ⊆ q.asIdeal :=
      (PrimeSpectrum.mem_zeroLocus _ _).mp (hPreE ▸ hq_pre)
    have hbas_q : fstY.base (ψ₀.base q) ∈ (C.basicOpen h₀ : Set C) := by
      rw [hq_eq, hBas₀]
      exact ⟨hyV₀, hyV₁⟩
    have hh₀_not_q : Ideal.Quotient.mk I_m0 h₀ ∉ q.asIdeal := (hBasψ₀ h₀ q).mp hbas_q
    have hh₀_not_p : Ideal.Quotient.mk I_m0 h₀ ∉ p := fun hmem => hh₀_not_q (hp_le_q hmem)
    intro hpow
    rw [map_pow] at hpow
    exact hh₀_not_p (hp_prime.mem_of_pow_mem r hpow)
  let m_R : Ideal R := IsLocalRing.maximalIdeal R
  have _ : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal R
  let F := R ⧸ m_R
  let _ : Field F := Ideal.Quotient.field m_R
  let π_R : R →+* F := Ideal.Quotient.mk m_R
  let q₁ : ↑R₁ →+* (↑R₁ ⧸ I_m1) := Ideal.Quotient.mk I_m1
  let bar_t₀ : ↑R₁ ⧸ I_m1 := q₁ t₀
  let bar_φ₁ : F →+* (↑R₁ ⧸ I_m1) :=
    Ideal.Quotient.lift m_R (q₁.comp φ₁) (fun r hr =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem φ₁ hr))
  have hbar_comp : bar_φ₁.comp π_R = q₁.comp φ₁ := RingHom.ext fun _ => rfl
  have hAff_s₀ : AlgebraicGeometry.IsAffineHom s₀ := AlgebraicGeometry.isAffineHom_of_isAffine s₀
  have _ : AlgebraicGeometry.IsAffineHom fstY :=
    CategoryTheory.MorphismProperty.pullback_fst (P := @AlgebraicGeometry.IsAffineHom) g s₀ hAff_s₀
  have hAff₀_Y : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map fstY.base).obj V₀) :=
    hAff₀.preimage fstY
  have hNzd_Q :
      ∀ Q : Polynomial R, Q.Monic →
        ∀ b : ↑R₁ ⧸ I_m1, Ideal.Quotient.mk I_m1 (Polynomial.eval₂ φ₁ t₀ Q) * b = 0 → b = 0 := by
    intro Q hQ
    apply hNzdOfMinPrimes
    intro p hp
    have hp_prime : p.IsPrime := Ideal.IsMinimalPrime.isPrime hp
    obtain ⟨E, hE, hPreE⟩ := hMin₁ p hp
    obtain ⟨y_ov, ⟨hy_ov_V₀, hy_ov_V₁⟩, hy_ov_E⟩ := hOverlapGen k₀ s₀ E hE (hNonAffY E hE)
    have hy_ov_range₁ : y_ov ∈ Set.range ψ₁.base := by
      rw [hRange₁]
      exact hy_ov_V₁
    obtain ⟨q_ov, hq_ov_eq⟩ := hy_ov_range₁
    have hq_ov_pre : q_ov ∈ ψ₁.base ⁻¹' E := by
      change ψ₁.base q_ov ∈ E
      rwa [hq_ov_eq]
    have hp_le_q_ov : (p : Set (↑R₁ ⧸ I_m1)) ⊆ q_ov.asIdeal :=
      (PrimeSpectrum.mem_zeroLocus _ _).mp (hPreE ▸ hq_ov_pre)
    have hbas_q_ov : fstY.base (ψ₁.base q_ov) ∈ (C.basicOpen t₀ : Set C) := by
      rw [hq_ov_eq, hBas₁]
      exact ⟨hy_ov_V₀, hy_ov_V₁⟩
    have ht₀_not_q_ov : bar_t₀ ∉ q_ov.asIdeal := (hBasψ₁ t₀ q_ov).mp hbas_q_ov
    have ht₀_not_p : bar_t₀ ∉ p := fun hmem => ht₀_not_q_ov (hp_le_q_ov hmem)
    obtain ⟨y₀, hy₀E, hy₀_notV₀⟩ :=
      hNonAffY E hE ((TopologicalSpace.Opens.map fstY.base).obj V₀) hAff₀_Y
    have hy₀_V₁ : fstY.base y₀ ∈ (V₁ : Set C) := by
      have htop : fstY.base y₀ ∈ (⊤ : C.Opens) := trivial
      rw [← hCov] at htop
      rcases htop with h0 | h1
      · exact False.elim (hy₀_notV₀ h0)
      · exact h1
    have hy₀_not_t₀ : fstY.base y₀ ∉ (C.basicOpen t₀ : Set C) := by
      rw [hBas₁]
      intro hmem
      exact hy₀_notV₀ hmem.1
    have hy₀_range₁ : y₀ ∈ Set.range ψ₁.base := by
      rw [hRange₁]
      exact hy₀_V₁
    obtain ⟨q₀, hq₀_eq⟩ := hy₀_range₁
    have hq₀_pre : q₀ ∈ ψ₁.base ⁻¹' E := by
      change ψ₁.base q₀ ∈ E
      rwa [hq₀_eq]
    have hp_le_q₀ : (p : Set (↑R₁ ⧸ I_m1)) ⊆ q₀.asIdeal :=
      (PrimeSpectrum.mem_zeroLocus _ _).mp (hPreE ▸ hq₀_pre)
    have ht₀_mem_q₀ : bar_t₀ ∈ q₀.asIdeal := by
      by_contra hnot
      exact hy₀_not_t₀ (hq₀_eq ▸ (hBasψ₁ t₀ q₀).mpr hnot)
    have hNoMonic :
        ∀ (d : ℕ) (P : Polynomial F),
          P.natDegree = d → P.Monic → Polynomial.eval₂ bar_φ₁ bar_t₀ P ∈ p → False := by
      intro d
      induction d with
      | zero =>
        intro P hPd hPM hEval
        have hP1 : P = 1 := Polynomial.eq_one_of_monic_natDegree_zero hPM hPd
        rw [hP1, Polynomial.eval₂_one] at hEval
        exact hp_prime.ne_top ((Ideal.eq_top_iff_one p).mpr hEval)
      | succ d ih =>
        intro P hPd hPM hEval
        have h_le : P.divX.natDegree ≤ d := by
          rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
          intro N hN
          rw [Polynomial.coeff_divX]
          apply Polynomial.coeff_eq_zero_of_natDegree_lt
          omega
        have h_cd : P.divX.coeff d = 1 := by
          rw [Polynomial.coeff_divX, ← hPd]
          exact hPM.coeff_natDegree
        have h_deg_divX : P.divX.natDegree = d :=
          Polynomial.natDegree_eq_of_le_of_coeff_ne_zero h_le (h_cd.symm ▸ one_ne_zero)
        have h_monic_divX : P.divX.Monic := by
          rw [Polynomial.Monic, Polynomial.leadingCoeff, h_deg_divX, h_cd]
        have hEvalEqP :
            Polynomial.eval₂ bar_φ₁ bar_t₀ P =
              bar_t₀ * Polynomial.eval₂ bar_φ₁ bar_t₀ P.divX + bar_φ₁ (P.coeff 0) := by
          conv_lhs => rw [← Polynomial.X_mul_divX_add P]
          rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
        have hSum_p : bar_t₀ * Polynomial.eval₂ bar_φ₁ bar_t₀ P.divX + bar_φ₁ (P.coeff 0) ∈ p := by
          rwa [hEvalEqP] at hEval
        by_cases hc₀ : P.coeff 0 = 0
        · rw [hc₀, map_zero, add_zero] at hSum_p
          have hDiv_p : Polynomial.eval₂ bar_φ₁ bar_t₀ P.divX ∈ p :=
            (hp_prime.mul_mem_iff_mem_or_mem.mp hSum_p).resolve_left ht₀_not_p
          exact ih P.divX h_deg_divX h_monic_divX hDiv_p
        · have hSum_q₀ :
              bar_t₀ * Polynomial.eval₂ bar_φ₁ bar_t₀ P.divX + bar_φ₁ (P.coeff 0) ∈ q₀.asIdeal :=
            hp_le_q₀ hSum_p
          have hMul_q₀ : bar_t₀ * Polynomial.eval₂ bar_φ₁ bar_t₀ P.divX ∈ q₀.asIdeal :=
            q₀.asIdeal.mul_mem_right _ ht₀_mem_q₀
          have hc₀_q₀ : bar_φ₁ (P.coeff 0) ∈ q₀.asIdeal := by
            have hsub := q₀.asIdeal.sub_mem hSum_q₀ hMul_q₀
            rwa [add_sub_cancel_left] at hsub
          have hone_q₀ : (1 : ↑R₁ ⧸ I_m1) ∈ q₀.asIdeal := by
            have hmul := q₀.asIdeal.mul_mem_right (bar_φ₁ (P.coeff 0)⁻¹) hc₀_q₀
            rwa [← map_mul, mul_inv_cancel₀ hc₀, map_one] at hmul
          exact q₀.isPrime.ne_top ((Ideal.eq_top_iff_one q₀.asIdeal).mpr hone_q₀)
    let Q_bar : Polynomial F := Polynomial.map π_R Q
    have hQ_bar : Q_bar.Monic := hQ.map π_R
    have hEvalEq :
        Ideal.Quotient.mk I_m1 (Polynomial.eval₂ φ₁ t₀ Q) =
          Polynomial.eval₂ bar_φ₁ bar_t₀ Q_bar := by
      change q₁ (Polynomial.eval₂ φ₁ t₀ Q) = Polynomial.eval₂ bar_φ₁ bar_t₀ (Polynomial.map π_R Q)
      rw [Polynomial.hom_eval₂ Q φ₁ q₁ t₀, ← hbar_comp, ← Polynomial.eval₂_map]
    intro hmem
    rw [hEvalEq] at hmem
    exact hNoMonic Q_bar.natDegree Q_bar rfl hQ_bar hmem
  have hNzd_t₀ : ∀ r : ℕ, ∀ b : ↑R₁ ⧸ I_m1, Ideal.Quotient.mk I_m1 (t₀ ^ r) * b = 0 → b = 0 := by
    intro r b hb
    rw [← Polynomial.eval₂_X_pow φ₁ t₀] at hb
    exact hNzd_Q (Polynomial.X ^ r) (Polynomial.monic_X_pow r) b hb
  exact ⟨hNzd_h₀, hNzd_t₀, hNzd_Q⟩

theorem weil_closedFiber_infinity_clopen_idempotent_witness (R : Type u) [CommRing R] [IsLocalRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (V₀ V₁ : C.Opens)
    (h₀ : ↑(C.presheaf.obj (Opposite.op V₀))) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal R).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let fstY := CategoryTheory.Limits.pullback.fst g s₀
    let R₀ := C.presheaf.obj (Opposite.op V₀)
    let φ₀ : R →+* ↑R₀ := (
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom
    let I_m0 : Ideal ↑R₀ := Ideal.map φ₀ (IsLocalRing.maximalIdeal R)
    let I_mh : Ideal ↑R₀ := I_m0 ⊔ Ideal.span ({h₀} : Set ↑R₀)
    V₀ ⊔ V₁ = ⊤ →
    C.basicOpen h₀ = V₀ ⊓ V₁ →
    ∀ (ψ₀ : AlgebraicGeometry.Spec (CommRingCat.of (↑R₀ ⧸ I_m0)) ⟶ Y),
      Set.range ψ₀.base = fstY.base ⁻¹' (V₀ : Set C) →
      (∀ (a : ↑R₀) (p : AlgebraicGeometry.Spec (CommRingCat.of (↑R₀ ⧸ I_m0))),
        fstY.base (ψ₀.base p) ∈ (C.basicOpen a : Set C) ↔ Ideal.Quotient.mk I_m0 a ∉ p.asIdeal) →
      ∀ (Z_cl Y'_cl : Set ↥Y),
        IsClosed Z_cl →
        IsClosed Y'_cl →
        Z_cl ∪ Y'_cl = Set.univ →
        (∀ q ∈ Z_cl ∩ Y'_cl, fstY.base q ∈ V₁) →
        (Z_cl \ fstY.base ⁻¹' (V₁ : Set C)).Nonempty →
        (Y'_cl \ fstY.base ⁻¹' (V₁ : Set C)).Nonempty →
        (∀ r : ℕ, 1 ≤ r → Nontrivial (↑R₀ ⧸ Ideal.span ({h₀ ^ r} : Set ↑R₀))) ∧
        ∃ u₀ : ↑R₀,
          Ideal.Quotient.mk I_mh u₀ * Ideal.Quotient.mk I_mh u₀ = Ideal.Quotient.mk I_mh u₀ ∧
          ∀ (eZ eY : ↑R₀),
            Ideal.Quotient.mk I_mh eZ = Ideal.Quotient.mk I_mh u₀ →
            Ideal.Quotient.mk I_mh eY = 1 - Ideal.Quotient.mk I_mh u₀ →
            Nontrivial (↑R₀ ⧸ Ideal.span ({h₀, eY} : Set ↑R₀)) ∧
            Nontrivial (↑R₀ ⧸ Ideal.span ({h₀, eZ} : Set ↑R₀)) ∧
            Z_cl ⊆ fstY.base ⁻¹' ((V₁ ⊔ C.basicOpen eZ : C.Opens) : Set C) ∧
            Y'_cl ⊆ fstY.base ⁻¹' ((V₁ ⊔ C.basicOpen eY : C.Opens) : Set C) :=
by
  intro k₀ s₀ Y fstY R₀ φ₀ I_m0 I_mh hCov hBas₀ ψ₀ hRangeψ₀ hBasψ₀
    Z_cl Y'_cl hZ_cl hY'_cl hUniv hInterV₁ hZ_ne hY'_ne
  let π_h : (↑R₀ ⧸ I_m0) →+* (↑R₀ ⧸ I_mh) :=
    Ideal.Quotient.factor (le_sup_left : I_m0 ≤ I_mh)
  let φ_inf : PrimeSpectrum (↑R₀ ⧸ I_mh) → ↥Y :=
    fun p => ψ₀.base (PrimeSpectrum.comap π_h p)
  have hφ_cont : Continuous φ_inf :=
    ψ₀.base.hom.continuous.comp (PrimeSpectrum.continuous_comap π_h)
  have hh₀_Imh : h₀ ∈ I_mh :=
    Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton h₀))
  have hmk_h₀ : Ideal.Quotient.mk I_mh h₀ = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr hh₀_Imh
  have hφ_notV₁ : ∀ p : PrimeSpectrum (↑R₀ ⧸ I_mh), fstY.base (φ_inf p) ∉ (V₁ : Set C) := by
    intro p hpV₁
    have hp_range : φ_inf p ∈ Set.range ψ₀.base := ⟨PrimeSpectrum.comap π_h p, rfl⟩
    rw [hRangeψ₀] at hp_range
    have hp_inf : fstY.base (φ_inf p) ∈ ((V₀ ⊓ V₁ : C.Opens) : Set C) := ⟨hp_range, hpV₁⟩
    rw [← hBas₀] at hp_inf
    have hnmem := (hBasψ₀ h₀ (PrimeSpectrum.comap π_h p)).mp hp_inf
    apply hnmem
    change π_h (Ideal.Quotient.mk I_m0 h₀) ∈ p.asIdeal
    rw [Ideal.Quotient.factor_mk, hmk_h₀]
    exact p.asIdeal.zero_mem
  have hφ_surj : ∀ y : ↥Y, fstY.base y ∉ (V₁ : Set C) →
      ∃ p : PrimeSpectrum (↑R₀ ⧸ I_mh), φ_inf p = y := by
    intro y hy_notV₁
    have hy_V₀ : fstY.base y ∈ (V₀ : Set C) := by
      have htop : fstY.base y ∈ ((⊤ : C.Opens) : Set C) := trivial
      rw [← hCov, TopologicalSpace.Opens.coe_sup] at htop
      exact htop.resolve_right hy_notV₁
    have hy_range : y ∈ Set.range ψ₀.base := by
      rw [hRangeψ₀]
      exact hy_V₀
    obtain ⟨q, hq_eq⟩ := hy_range
    have hh₀_q : Ideal.Quotient.mk I_m0 h₀ ∈ q.asIdeal := by
      by_contra hh₀_nmem
      have hbas : fstY.base (ψ₀.base q) ∈ (C.basicOpen h₀ : Set C) :=
        (hBasψ₀ h₀ q).mpr hh₀_nmem
      rw [hq_eq, hBas₀] at hbas
      exact hy_notV₁ hbas.2
    let q' : PrimeSpectrum (↑R₀ ⧸ I_m0) := q
    have hq_comap : q' ∈ Set.range (PrimeSpectrum.comap π_h) := by
      rw [_root_.range_comap_of_surjective (↑R₀ ⧸ I_mh) π_h
        (Ideal.Quotient.factor_surjective le_sup_left)]
      rw [PrimeSpectrum.mem_zeroLocus]
      intro x hx
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      have ha_zero : Ideal.Quotient.mk I_mh a = 0 := by
        have hker : π_h (Ideal.Quotient.mk I_m0 a) = 0 := hx
        rwa [Ideal.Quotient.factor_mk] at hker
      have ha_Imh : a ∈ I_mh := Ideal.Quotient.eq_zero_iff_mem.mp ha_zero
      have hImh_le : I_mh ≤ Ideal.comap (Ideal.Quotient.mk I_m0) q'.asIdeal := by
        refine sup_le ?_ ?_
        · intro b hb
          change Ideal.Quotient.mk I_m0 b ∈ q'.asIdeal
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb]
          exact q'.asIdeal.zero_mem
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          exact hh₀_q
      exact hImh_le ha_Imh
    obtain ⟨p, hp_eq⟩ := hq_comap
    refine ⟨p, ?_⟩
    dsimp [φ_inf]
    rw [hp_eq]
    exact hq_eq
  obtain ⟨y_Z, hy_Z_cl, hy_Z_notV₁⟩ := hZ_ne
  obtain ⟨p_Z, hp_Z_eq⟩ := hφ_surj y_Z hy_Z_notV₁
  let P_Z : Ideal ↑R₀ := Ideal.comap (Ideal.Quotient.mk I_mh) p_Z.asIdeal
  have hPZ_prime : P_Z.IsPrime := Ideal.comap_isPrime (Ideal.Quotient.mk I_mh) p_Z.asIdeal
  have hh₀_PZ : h₀ ∈ P_Z := by
    change Ideal.Quotient.mk I_mh h₀ ∈ p_Z.asIdeal
    rw [hmk_h₀]
    exact p_Z.asIdeal.zero_mem
  refine ⟨?_, ?_⟩
  · intro r hr
    have hpow_mem : h₀ ^ r ∈ P_Z := Ideal.pow_mem_of_mem P_Z hh₀_PZ r hr
    refine Ideal.Quotient.nontrivial_iff.mpr (fun htop => hPZ_prime.ne_top ?_)
    exact top_unique (htop ▸ Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hpow_mem))
  · let S_Z : Set (PrimeSpectrum (↑R₀ ⧸ I_mh)) := φ_inf ⁻¹' Z_cl
    let S_Y' : Set (PrimeSpectrum (↑R₀ ⧸ I_mh)) := φ_inf ⁻¹' Y'_cl
    have hSZ_closed : IsClosed S_Z := hZ_cl.preimage hφ_cont
    have hSY'_closed : IsClosed S_Y' := hY'_cl.preimage hφ_cont
    have hCompl : S_Zᶜ = S_Y' := by
      ext p
      simp only [S_Z, S_Y', Set.mem_compl_iff, Set.mem_preimage]
      constructor
      · intro hp_notZ
        have huniv : φ_inf p ∈ (Set.univ : Set ↥Y) := trivial
        rw [← hUniv] at huniv
        exact huniv.resolve_left hp_notZ
      · intro hp_Y' hp_Z
        exact hφ_notV₁ p (hInterV₁ (φ_inf p) ⟨hp_Z, hp_Y'⟩)
    have hSZ_open : IsOpen S_Z := isClosed_compl_iff.mp (hCompl.symm ▸ hSY'_closed)
    have hSZ_clopen : IsClopen S_Z := ⟨hSZ_closed, hSZ_open⟩
    obtain ⟨u_bar, v_bar, huv_mul, huv_add, hSZ_basic, hSZc_basic⟩ :=
      PrimeSpectrum.exists_mul_eq_zero_add_eq_one_basicOpen_eq_of_isClopen hSZ_clopen
    have hSY'_basic : S_Y' = (PrimeSpectrum.basicOpen v_bar : Set (PrimeSpectrum (↑R₀ ⧸ I_mh))) := by
      rw [← hCompl, hSZc_basic]
    obtain ⟨u₀, hu₀_mk⟩ := Ideal.Quotient.mk_surjective u_bar
    have hu_idem : u_bar * u_bar = u_bar := by
      calc
        u_bar * u_bar = u_bar * u_bar + u_bar * v_bar := by rw [huv_mul, add_zero]
        _ = u_bar * (u_bar + v_bar) := by rw [mul_add]
        _ = u_bar := by rw [huv_add, mul_one]
    have hv_eq : v_bar = 1 - u_bar := eq_sub_of_add_eq' huv_add
    refine ⟨u₀, ?_, ?_⟩
    · rw [hu₀_mk]
      exact hu_idem
    · intro eZ eY heZ heY
      have heZ_bar : Ideal.Quotient.mk I_mh eZ = u_bar := heZ.trans hu₀_mk
      have heY_bar : Ideal.Quotient.mk I_mh eY = v_bar := by
        rw [heY, hu₀_mk, hv_eq]
      refine ⟨?_, ?_, ?_, ?_⟩
      · have hpZ_SZ : p_Z ∈ S_Z := by
          change φ_inf p_Z ∈ Z_cl
          rwa [hp_Z_eq]
        rw [hSZ_basic] at hpZ_SZ
        have hu_nmem_pZ : u_bar ∉ p_Z.asIdeal := hpZ_SZ
        have hv_mem_pZ : v_bar ∈ p_Z.asIdeal := by
          have hmul_mem : u_bar * v_bar ∈ p_Z.asIdeal := by
            rw [huv_mul]
            exact p_Z.asIdeal.zero_mem
          exact (p_Z.isPrime.mul_mem_iff_mem_or_mem.mp hmul_mem).resolve_left hu_nmem_pZ
        have heY_PZ : eY ∈ P_Z := by
          change Ideal.Quotient.mk I_mh eY ∈ p_Z.asIdeal
          rwa [heY_bar]
        refine Ideal.Quotient.nontrivial_iff.mpr (fun htop => hPZ_prime.ne_top ?_)
        refine top_unique (htop ▸ Ideal.span_le.mpr ?_)
        simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
        exact ⟨hh₀_PZ, heY_PZ⟩
      · obtain ⟨y_Y', hy_Y'_cl, hy_Y'_notV₁⟩ := hY'_ne
        obtain ⟨p_Y', hp_Y'_eq⟩ := hφ_surj y_Y' hy_Y'_notV₁
        let P_Y' : Ideal ↑R₀ := Ideal.comap (Ideal.Quotient.mk I_mh) p_Y'.asIdeal
        have hPY'_prime : P_Y'.IsPrime := Ideal.comap_isPrime (Ideal.Quotient.mk I_mh) p_Y'.asIdeal
        have hh₀_PY' : h₀ ∈ P_Y' := by
          change Ideal.Quotient.mk I_mh h₀ ∈ p_Y'.asIdeal
          rw [hmk_h₀]
          exact p_Y'.asIdeal.zero_mem
        have hpY'_SY' : p_Y' ∈ S_Y' := by
          change φ_inf p_Y' ∈ Y'_cl
          rwa [hp_Y'_eq]
        rw [hSY'_basic] at hpY'_SY'
        have hv_nmem_pY' : v_bar ∉ p_Y'.asIdeal := hpY'_SY'
        have hu_mem_pY' : u_bar ∈ p_Y'.asIdeal := by
          have hmul_mem : u_bar * v_bar ∈ p_Y'.asIdeal := by
            rw [huv_mul]
            exact p_Y'.asIdeal.zero_mem
          exact (p_Y'.isPrime.mul_mem_iff_mem_or_mem.mp hmul_mem).resolve_right hv_nmem_pY'
        have heZ_PY' : eZ ∈ P_Y' := by
          change Ideal.Quotient.mk I_mh eZ ∈ p_Y'.asIdeal
          rwa [heZ_bar]
        refine Ideal.Quotient.nontrivial_iff.mpr (fun htop => hPY'_prime.ne_top ?_)
        refine top_unique (htop ▸ Ideal.span_le.mpr ?_)
        simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
        exact ⟨hh₀_PY', heZ_PY'⟩
      · intro y hyZ
        change fstY.base y ∈ ((V₁ ⊔ C.basicOpen eZ : C.Opens) : Set C)
        rw [TopologicalSpace.Opens.coe_sup]
        by_cases hyV₁ : fstY.base y ∈ (V₁ : Set C)
        · exact Or.inl hyV₁
        · right
          obtain ⟨p, hp_eq⟩ := hφ_surj y hyV₁
          have hp_SZ : p ∈ S_Z := by
            change φ_inf p ∈ Z_cl
            rwa [hp_eq]
          rw [hSZ_basic] at hp_SZ
          have hu_nmem : u_bar ∉ p.asIdeal := hp_SZ
          have heZ_nmem : Ideal.Quotient.mk I_m0 eZ ∉ (PrimeSpectrum.comap π_h p).asIdeal := by
            intro hmem
            apply hu_nmem
            have hmem' : π_h (Ideal.Quotient.mk I_m0 eZ) ∈ p.asIdeal := hmem
            rwa [Ideal.Quotient.factor_mk, heZ_bar] at hmem'
          have hbas := (hBasψ₀ eZ (PrimeSpectrum.comap π_h p)).mpr heZ_nmem
          change fstY.base (φ_inf p) ∈ (C.basicOpen eZ : Set C) at hbas
          rwa [hp_eq] at hbas
      · intro y hyY'
        change fstY.base y ∈ ((V₁ ⊔ C.basicOpen eY : C.Opens) : Set C)
        rw [TopologicalSpace.Opens.coe_sup]
        by_cases hyV₁ : fstY.base y ∈ (V₁ : Set C)
        · exact Or.inl hyV₁
        · right
          obtain ⟨p, hp_eq⟩ := hφ_surj y hyV₁
          have hp_SY' : p ∈ S_Y' := by
            change φ_inf p ∈ Y'_cl
            rwa [hp_eq]
          rw [hSY'_basic] at hp_SY'
          have hv_nmem : v_bar ∉ p.asIdeal := hp_SY'
          have heY_nmem : Ideal.Quotient.mk I_m0 eY ∉ (PrimeSpectrum.comap π_h p).asIdeal := by
            intro hmem
            apply hv_nmem
            have hmem' : π_h (Ideal.Quotient.mk I_m0 eY) ∈ p.asIdeal := hmem
            rwa [Ideal.Quotient.factor_mk, heY_bar] at hmem'
          have hbas := (hBasψ₀ eY (PrimeSpectrum.comap π_h p)).mpr heY_nmem
          change fstY.base (φ_inf p) ∈ (C.basicOpen eY : Set C) at hbas
          rwa [hp_eq] at hbas

theorem weil_localRing_flat_lfp_fiber_smoothOfRelDim_lift (R : Type u) [CommRing R] [IsLocalRing R]
    (X : AlgebraicGeometry.Scheme.{u})
    (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat f)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation f) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal R).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))
    ∀ (y₀ : ↥(CategoryTheory.Limits.pullback f s₀))
      (W_sm : (CategoryTheory.Limits.pullback f s₀).Opens),
      y₀ ∈ W_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (W_sm.ι ≫ CategoryTheory.Limits.pullback.snd f s₀) →
      ∃ V_sm : X.Opens,
        (CategoryTheory.Limits.pullback.fst f s₀).base y₀ ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f) :=
by
  have h_step5 :
      let k₀ : Type u := (IsLocalRing.maximalIdeal R).ResidueField
      let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))
      ∀ (y₀ : ↥(CategoryTheory.Limits.pullback f s₀))
        (W_sm : (CategoryTheory.Limits.pullback f s₀).Opens),
        y₀ ∈ W_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (W_sm.ι ≫ CategoryTheory.Limits.pullback.snd f s₀) →
        ∃ (A' : CommRingCat.{u}) (φ : R →+* ↑A') (P : Ideal ↑A'),
          P.IsPrime ∧
          φ.Flat ∧
          φ.FinitePresentation ∧
          Ideal.map φ (IsLocalRing.maximalIdeal R) ≤ P ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (Ideal.quotientMap
              (Ideal.map φ (IsLocalRing.maximalIdeal R))
              φ Ideal.le_comap_map) ∧
          (∀ g : ↑A', g ∉ P →
            RingHom.IsStandardSmoothOfRelativeDimension 1
              ((algebraMap (↑A') (Localization.Away g)).comp φ) →
            ∃ V_sm : X.Opens,
              (CategoryTheory.Limits.pullback.fst f s₀).base y₀ ∈ V_sm ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f)) := by
    classical
    intro k₀ s₀ y₀ W_sm hy₀ hSm
    let m_R : Ideal R := IsLocalRing.maximalIdeal R
    let k_bar := R ⧸ m_R
    let x₀ : X := (CategoryTheory.Limits.pullback.fst f s₀).base y₀
    obtain ⟨U₀, hU₀, hx₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x₀) (U := ⊤) trivial
    let A_cat : CommRingCat.{u} := X.presheaf.obj (Opposite.op U₀)
    let A : Type u := ↑A_cat
    let φ_cat : CommRingCat.of R ⟶ A_cat := AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ f)
    have hφ_cat : AlgebraicGeometry.Spec.map φ_cat = hU₀.fromSpec ≫ f :=
      AlgebraicGeometry.Spec.map_preimage (hU₀.fromSpec ≫ f)
    let φ_RA : R →+* A := φ_cat.hom
    let _ : Algebra R A := φ_RA.toAlgebra
    have hbij_res : Function.Bijective (algebraMap k_bar k₀) :=
      Ideal.bijective_algebraMap_quotient_residueField m_R
    let e_res_ring : k_bar ≃+* k₀ := RingEquiv.ofBijective (algebraMap k_bar k₀) hbij_res
    let e_res : k_bar ≃ₐ[R] k₀ :=
      { e_res_ring with
        commutes' := fun r => (IsScalarTower.algebraMap_apply R k_bar k₀ r).symm }
    let m_A : Ideal A := Ideal.map φ_RA m_R
    let A_bar := A ⧸ m_A
    let π_A : A →+* A_bar := Ideal.Quotient.mk m_A
    let ψ₀ : k_bar →+* A_bar := Ideal.quotientMap m_A φ_RA Ideal.le_comap_map
    let ψ_k₀ : k₀ →+* A_bar := ψ₀.comp e_res_ring.symm.toRingHom
    have hψ_alg : ψ_k₀.comp (algebraMap R k₀) = π_A.comp φ_RA := by
      ext r
      change ψ₀ (e_res_ring.symm (algebraMap R k₀ r)) = π_A (φ_RA r)
      have hr : algebraMap R k₀ r = e_res_ring (Ideal.Quotient.mk m_R r) :=
        IsScalarTower.algebraMap_apply R k_bar k₀ r
      rw [hr, RingEquiv.symm_apply_apply]
      rfl
    let e₁ : A_bar ≃ₐ[A] TensorProduct R A k_bar :=
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot A m_R
    let e₂ : TensorProduct R A k_bar ≃ₐ[R] TensorProduct R A k₀ :=
      Algebra.TensorProduct.congr AlgEquiv.refl e_res
    let e_tp : A_bar ≃+* TensorProduct R A k₀ := e₁.toRingEquiv.trans e₂.toRingEquiv
    have he_tp_left : e_tp.symm.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom = π_A := by
      apply RingHom.ext
      intro a
      apply e_tp.injective
      have h1 : e_tp (e_tp.symm (Algebra.TensorProduct.includeLeftRingHom a)) =
          Algebra.TensorProduct.includeLeftRingHom a := e_tp.apply_symm_apply _
      change e_tp (e_tp.symm (Algebra.TensorProduct.includeLeftRingHom a)) = e_tp (π_A a)
      rw [h1]
      symm
      change e₂ (e₁ (algebraMap A A_bar a)) = a ⊗ₜ[R] 1
      rw [e₁.commutes a]
      change e₂ (a ⊗ₜ[R] 1) = a ⊗ₜ[R] 1
      simp [e₂]
    have he_tp_right :
        e_tp.symm.toRingHom.comp
          (Algebra.TensorProduct.includeRight : k₀ →ₐ[R] TensorProduct R A k₀).toRingHom = ψ_k₀ := by
      apply RingHom.ext
      intro x
      obtain ⟨q, rfl⟩ := e_res_ring.surjective x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
      apply e_tp.injective
      have h1 : e_tp (e_tp.symm (1 ⊗ₜ[R] e_res_ring (Ideal.Quotient.mk m_R r))) =
          1 ⊗ₜ[R] e_res_ring (Ideal.Quotient.mk m_R r) := e_tp.apply_symm_apply _
      change e_tp (e_tp.symm (1 ⊗ₜ[R] e_res_ring (Ideal.Quotient.mk m_R r))) =
        e_tp (ψ_k₀ (e_res_ring (Ideal.Quotient.mk m_R r)))
      rw [h1]
      symm
      have hx_alg : e_res_ring (Ideal.Quotient.mk m_R r) = algebraMap R k₀ r :=
        (IsScalarTower.algebraMap_apply R k_bar k₀ r).symm
      have hψ_val : ψ_k₀ (e_res_ring (Ideal.Quotient.mk m_R r)) = π_A (φ_RA r) := by
        change ψ₀ (e_res_ring.symm (e_res_ring (Ideal.Quotient.mk m_R r))) = _
        rw [RingEquiv.symm_apply_apply]
        rfl
      rw [hψ_val]
      change e₂ (e₁ (algebraMap A A_bar (algebraMap R A r))) =
        1 ⊗ₜ[R] e_res_ring (Ideal.Quotient.mk m_R r)
      rw [e₁.commutes, hx_alg]
      change e₂ (algebraMap R A r ⊗ₜ[R] (1 : k_bar)) = (1 : A) ⊗ₜ[R] algebraMap R k₀ r
      have h_lhs : algebraMap R A r ⊗ₜ[R] (1 : k_bar) = r • (1 : TensorProduct R A k_bar) := by
        rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul']
        rfl
      have h_rhs : (1 : A) ⊗ₜ[R] algebraMap R k₀ r = r • (1 : TensorProduct R A k₀) := by
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul]
        rfl
      rw [h_lhs, h_rhs, map_smul, map_one]
    let i_tp : AlgebraicGeometry.Spec (CommRingCat.of A_bar) ≅
        AlgebraicGeometry.Spec ↧(TensorProduct R A k₀) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_tp.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_tp.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          simp
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          simp }
    let e_fib : AlgebraicGeometry.Spec (CommRingCat.of A_bar) ≅
        CategoryTheory.Limits.pullback (AlgebraicGeometry.Spec.map φ_cat) s₀ :=
      i_tp.trans (AlgebraicGeometry.pullbackSpecIso R A k₀).symm
    have he_fib_fst :
        e_fib.hom ≫ CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map φ_cat) s₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A) := by
      change (i_tp.hom ≫ (AlgebraicGeometry.pullbackSpecIso R A k₀).inv) ≫
        CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A))) s₀ = _
      dsimp only [i_tp]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, he_tp_left]
    have he_fib_snd :
        e_fib.hom ≫ CategoryTheory.Limits.pullback.snd (AlgebraicGeometry.Spec.map φ_cat) s₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀) := by
      change (i_tp.hom ≫ (AlgebraicGeometry.pullbackSpecIso R A k₀).inv) ≫
        CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A))) s₀ = _
      dsimp only [i_tp]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      exact congrArg (fun h => AlgebraicGeometry.Spec.map (CommRingCat.ofHom h)) he_tp_right
    have hComm_spec : CategoryTheory.CommSq
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀))
        (AlgebraicGeometry.Spec.map φ_cat) s₀ := by
      refine ⟨?_⟩
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      exact CommRingCat.ofHom_comp φ_RA π_A ▸
        (CommRingCat.ofHom_comp (algebraMap R k₀) ψ_k₀ ▸ congrArg CommRingCat.ofHom hψ_alg.symm)
    have hPb_spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀))
        (AlgebraicGeometry.Spec.map φ_cat) s₀ :=
      CategoryTheory.IsPullback.of_iso_pullback hComm_spec e_fib he_fib_fst he_fib_snd
    let ι_fib : AlgebraicGeometry.Spec (CommRingCat.of A_bar) ⟶
        CategoryTheory.Limits.pullback f s₀ :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A) ≫ hU₀.fromSpec)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀))
        (by rw [Category.assoc, ← hφ_cat]; exact hPb_spec.w)
    have hPb_outer : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A))
        (ι_fib ≫ CategoryTheory.Limits.pullback.snd f s₀)
        (hU₀.fromSpec ≫ f) s₀ := by
      rw [CategoryTheory.Limits.pullback.lift_snd, ← hφ_cat]
      exact hPb_spec
    have hPb_top : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A))
        ι_fib hU₀.fromSpec (CategoryTheory.Limits.pullback.fst f s₀) :=
      CategoryTheory.IsPullback.of_bot hPb_outer
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback f s₀)
    have _ : AlgebraicGeometry.IsOpenImmersion ι_fib :=
      AlgebraicGeometry.IsOpenImmersion.of_isPullback hPb_top inferInstance
    have hx₀_range : x₀ ∈ Set.range hU₀.fromSpec.base := by
      rw [hU₀.range_fromSpec]
      exact hx₀
    obtain ⟨P₀, hP₀⟩ := hx₀_range
    obtain ⟨p_bar₀, hp_bar_P₀, hp_bar_y₀⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_top P₀ y₀ hP₀
    let S_bar := AlgebraicGeometry.Spec (CommRingCat.of A_bar)
    let W_bar₀ : S_bar.Opens := (TopologicalSpace.Opens.map ι_fib.base).obj W_sm
    have hp_bar_W : p_bar₀ ∈ W_bar₀ := by
      change ι_fib.base p_bar₀ ∈ W_sm
      rw [hp_bar_y₀]
      exact hy₀
    have hrange_W : Set.range (W_bar₀.ι ≫ ι_fib).base ⊆ Set.range W_sm.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact z.2
    let ι_W : W_bar₀.toScheme ⟶ W_sm.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W_sm.ι (W_bar₀.ι ≫ ι_fib) hrange_W
    have hι_W_fac : ι_W ≫ W_sm.ι = W_bar₀.ι ≫ ι_fib :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_sm.ι (W_bar₀.ι ≫ ι_fib) hrange_W
    have _ : AlgebraicGeometry.IsOpenImmersion (ι_W ≫ W_sm.ι) := by
      rw [hι_W_fac]
      infer_instance
    have _ : AlgebraicGeometry.IsOpenImmersion ι_W :=
      AlgebraicGeometry.IsOpenImmersion.of_comp ι_W W_sm.ι
    have hSm_Wbar : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (W_bar₀.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀)) := by
      have hcomp := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 ι_W
        (W_sm.ι ≫ CategoryTheory.Limits.pullback.snd f s₀)
      have heq : ι_W ≫ W_sm.ι ≫ CategoryTheory.Limits.pullback.snd f s₀ =
          W_bar₀.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀) := by
        rw [← Category.assoc, hι_W_fac, Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      simpa [heq] using hcomp
    obtain ⟨U_k, hUk, V_w, hVw, hp_Vw, he_Vw, hSm_app⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1
        (W_bar₀.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀))).mp
        hSm_Wbar ⟨p_bar₀, hp_bar_W⟩
    have hUk_top : U_k = ⊤ := by
      have hmem_Uk : (W_bar₀.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀)).base
          ⟨p_bar₀, hp_bar_W⟩ ∈ U_k := he_Vw hp_Vw
      ext q
      constructor
      · intro _
        trivial
      · intro _
        have hq : q = (W_bar₀.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀)).base
            ⟨p_bar₀, hp_bar_W⟩ := Subsingleton.elim _ _
        rw [hq]
        exact hmem_Uk
    subst hUk_top
    let V_bar : S_bar.Opens := (W_bar₀.ι.opensFunctor).obj V_w
    have hVbar : AlgebraicGeometry.IsAffineOpen V_bar := hVw.image_of_isOpenImmersion W_bar₀.ι
    have hp_Vbar : p_bar₀ ∈ V_bar := ⟨⟨p_bar₀, hp_bar_W⟩, hp_Vw, rfl⟩
    let g_k₀ : S_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_k₀)
    have he_Vbar_Vw : V_w ≤ (TopologicalSpace.Opens.map W_bar₀.ι.base).obj V_bar := by
      intro z hz
      exact ⟨z, hz, rfl⟩
    have he_pre_Vbar : (TopologicalSpace.Opens.map W_bar₀.ι.base).obj V_bar = V_w := by
      ext z
      constructor
      · rintro ⟨w, hw, hzw⟩
        have h_eq : w = z := W_bar₀.ι.isOpenEmbedding.injective hzw
        exact h_eq ▸ hw
      · intro hz
        exact ⟨z, hz, rfl⟩
    have happLE_W : W_bar₀.ι.appLE V_bar V_w he_Vbar_Vw = (W_bar₀.ι.appIso V_w).hom := by
      rw [AlgebraicGeometry.Scheme.Hom.appIso_hom]
      dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
      congr 2
    let ρ_top_Vbar : CommRingCat.of A_bar ⟶ S_bar.presheaf.obj (Opposite.op V_bar) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_bar)).inv ≫
        S_bar.presheaf.map (CategoryTheory.homOfLE (le_top : V_bar ≤ ⊤)).op
    have hSm_Vbar : RingHom.IsStandardSmoothOfRelativeDimension 1
        (CommRingCat.ofHom ψ₀ ≫ ρ_top_Vbar).hom := by
      let i_left : CommRingCat.of k_bar ≅
          (AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.obj (Opposite.op ⊤) :=
        (e_res_ring.toCommRingCatIso).trans
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).symm
      let i_right : W_bar₀.toScheme.presheaf.obj (Opposite.op V_w) ≅
          S_bar.presheaf.obj (Opposite.op V_bar) :=
        (W_bar₀.ι.appIso V_w).symm
      have hfac : i_left.hom ≫ (W_bar₀.ι ≫ g_k₀).appLE ⊤ V_w he_Vw ≫ i_right.hom =
          CommRingCat.ofHom ψ₀ ≫ ρ_top_Vbar := by
        have he_top_Vbar : V_bar ≤ (TopologicalSpace.Opens.map g_k₀.base).obj ⊤ :=
          fun _ _ => trivial
        have hcomp_appLE :
            g_k₀.appLE ⊤ V_bar he_top_Vbar ≫ W_bar₀.ι.appLE V_bar V_w he_Vbar_Vw =
              (W_bar₀.ι ≫ g_k₀).appLE ⊤ V_w he_Vw :=
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W_bar₀.ι g_k₀ ⊤ V_bar V_w
