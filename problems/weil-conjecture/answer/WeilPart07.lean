      let E : Set ↥(CategoryTheory.Limits.pullback g s₀) := irreducibleComponent y_gen
      have hE_mem : E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀) :=
        irreducibleComponent_mem_irreducibleComponents y_gen
      have hE_irred : IsIrreducible E := isIrreducible_irreducibleComponent
      have hE_closed : IsClosed E := isClosed_irreducibleComponent
      let η_Y : ↥(CategoryTheory.Limits.pullback g s₀) := hE_irred.genericPoint
