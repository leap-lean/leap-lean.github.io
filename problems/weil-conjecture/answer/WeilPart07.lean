        AlgebraicGeometry.Scheme.Opens.topIso_inv U
      have hV_inv : W_o.topIso.inv = X.presheaf.map (CategoryTheory.eqToHom hV_eq).op := by
        rw [AlgebraicGeometry.Scheme.Opens.topIso_inv W_o]
        exact congrArg X.presheaf.map (Subsingleton.elim _ _)
      exact (congrArg (· ≫ _) hU_inv).trans
        ((AlgebraicGeometry.Scheme.Hom.map_appLE f_m _ (CategoryTheory.eqToHom hU_eq).op).trans
          ((AlgebraicGeometry.Scheme.Hom.appLE_map f_m hle (CategoryTheory.eqToHom hV_eq).op).symm.trans
            (congrArg (f_m.appLE U W_o hle ≫ ·) hV_inv.symm)))
