      _ = α I := by
          rw [hc, map_one, one_mul]
  
  refine ⟨?_, hAffCech⟩
  intro U V₀ V₁ hU hV₀ hV₁ hle f₀ s₁ _hf₀ _hs₁ hmul m₀ g
  let W₀ : Y.Opens := U ⊓ V₀
  let W₁ : Y.Opens := U ⊓ V₁
  let W₀₁ : Y.Opens := U ⊓ (V₀ ⊓ V₁)
  let V_cov : Fin 2 → Y.Opens := fun a => if a = 0 then W₀ else W₁
  have hV_le : ∀ a : Fin 2, V_cov a ≤ U := by
    intro a
    dsimp only [V_cov]
    split_ifs <;> exact inf_le_left
  have hV_aff : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (V_cov a) := by
    intro a
    dsimp only [V_cov]
    split_ifs
    · exact hAffInter U V₀ hU hV₀
    · exact hAffInter U V₁ hU hV₁
  have hV_sup : (⨆ a : Fin 2, V_cov a) = U := by
    apply le_antisymm
    · exact iSup_le hV_le
    · calc
        U = U ⊓ (V₀ ⊔ V₁) := (inf_eq_left.mpr hle).symm
        _ = W₀ ⊔ W₁ := inf_sup_left U V₀ V₁
        _ = V_cov 0 ⊔ V_cov 1 := rfl
        _ ≤ ⨆ a : Fin 2, V_cov a := sup_le (le_iSup V_cov 0) (le_iSup V_cov 1)
  let f₀₁ : ↑(Y.presheaf.obj (Opposite.op W₀₁)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE
      (inf_le_right.trans inf_le_left : W₀₁ ≤ V₀)).op).hom f₀
  let s₀₁ : ↑(Y.presheaf.obj (Opposite.op W₀₁)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE
      (inf_le_right.trans inf_le_right : W₀₁ ≤ V₁)).op).hom s₁
  have hmul₀₁ : f₀₁ * s₀₁ = 1 := by
    have h := congrArg
      ((Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀₁ ≤ V₀ ⊓ V₁)).op).hom) hmul
    rw [map_mul, map_one, hY_map_comp, hY_map_comp] at h
    exact h
  have hI_le_W₀₁ : ∀ I : {I : Fin 2 → Fin 2 // StrictMono I},
      Finset.inf (Finset.univ.image I.1) V_cov ≤ W₀₁ := by
    intro I
    have h01 : (I.1 0 : ℕ) < (I.1 1 : ℕ) := I.2 (by decide)
    have h1_lt : (I.1 1 : ℕ) < 2 := (I.1 1).isLt
    have hI0 : I.1 0 = 0 := Fin.ext (by omega)
    have hI1 : I.1 1 = 1 := Fin.ext (by omega)
    have hle0 : Finset.inf (Finset.univ.image I.1) V_cov ≤ W₀ := by
      have hmem0 : (0 : Fin 2) ∈ Finset.univ.image I.1 :=
        hI0 ▸ Finset.mem_image_of_mem I.1 (Finset.mem_univ 0)
      exact Finset.inf_le hmem0
    have hle1 : Finset.inf (Finset.univ.image I.1) V_cov ≤ W₁ := by
      have hmem1 : (1 : Fin 2) ∈ Finset.univ.image I.1 :=
        hI1 ▸ Finset.mem_image_of_mem I.1 (Finset.mem_univ 1)
      exact Finset.inf_le hmem1
    exact le_inf (hle0.trans inf_le_left) (le_inf (hle0.trans inf_le_right) (hle1.trans inf_le_right))
  let g' : ↑(Y.presheaf.obj (Opposite.op W₀₁)) := - (f₀₁ ^ m₀ * g)
  let α₀ : ∀ I : {I : Fin 2 → Fin 2 // StrictMono I},
      ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) V_cov))) :=
    fun I => (Y.presheaf.map (CategoryTheory.homOfLE (hI_le_W₀₁ I)).op).hom g'
  have hα₀ : ∀ J : {J : Fin 3 → Fin 2 // StrictMono J},
      (∑ r : Fin 3,
        (-1 : ℤ) ^ (r : ℕ) •
          (Y.presheaf.map (CategoryTheory.homOfLE
