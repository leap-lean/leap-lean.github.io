          (fstY.appLE V₁ V₁_Y le_rfl).hom f₁ := by
        have hm : fstY.appLE W_compl W_Y le_rfl ≫ Y.presheaf.map (CategoryTheory.homOfLE hle_V₁).op =
            C.presheaf.map (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ W_compl)).op ≫
