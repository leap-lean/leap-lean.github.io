      obtain ⟨A_R, instCR_AR, instAlg_AR, ι_R, X_R, g_R, hDesc_a⟩ :=
        hSV_base a R_β (hBase_in_R a)
      letI := instCR_AR
      letI := instAlg_AR
      exact hDesc_s2 a R_β A_R ι_R X_R g_R hDesc_a
    let B_β : Finset (Fin (N + 1)) → Subring F :=
      fun S => Subring.closure (⋃ a ∈ S, (B_R_a a : Set F))
    obtain ⟨hBβ_sing, hBβ_mono, hBβ_S⟩ :=
      hOv R_β hOv_in_R (fun a => (hSing_all a).2.2.2)
    have hBβ_sing' : ∀ a : Fin (N + 1), B_β {a} = B_R_a a := hBβ_sing
    refine ⟨R_β, B_β, hNoeth, hLocRing, hLocHom, hSV_in_R, hBβ_mono, hBβ_S, ?_⟩
    intro a
    rw [hBβ_sing' a]
    obtain ⟨hg_in, hy_in, hsat_a, _⟩ := hSing_all a
    exact ⟨hg_in, hy_in, rfl, hsat_a⟩

theorem weil_subring_partitionOfUnity_cech_acyclicity_and_dualBasis_span (K : Type u) [Field K] (V : ValuationSubring K)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (t_loc : Fin (N + 1) → F) (k : ℕ)
    (R_β : Subring ↥V) (t₀ s₁ : F)
    (d₀ : ℕ) (gen₀ : Fin d₀ → F)
    (R_β0 R_β1 R_β01 : Subring F)
    (D_β0 D_β1 D_β01 : Finset (Fin (N + 1)) → Subring F)
    (ht_ne : ∀ a : Fin (N + 1), t_loc a ≠ 0)
    (hts : t₀ * s₁ = 1)
    (ht₀ : t₀ ∈ R_β0)
    (hs₁ : s₁ ∈ R_β1)
    (hR_mem : ∀ r : ↥R_β, φ_VF (R_β.subtype r) ∈ R_β0 ∧ φ_VF (R_β.subtype r) ∈ R_β1)
    (hgen₀ : ∀ μ : Fin d₀, gen₀ μ ∈ R_β0)
    (hspan₀ : ∀ w ∈ R_β0, ∃ P : Fin d₀ → Polynomial ↥R_β,
      w = ∑ μ : Fin d₀, Polynomial.eval₂ (φ_VF.comp R_β.subtype) t₀ (P μ) * gen₀ μ)
    (hR01 : R_β01 = Subring.closure ((R_β0 : Set F) ∪ {s₁}))
    (hD_mono : ∀ (S S' : Finset (Fin (N + 1))), S.Nonempty → S ⊆ S' →
      D_β0 S ≤ D_β0 S' ∧ D_β1 S ≤ D_β1 S' ∧ D_β01 S ≤ D_β01 S')
    (hD_struct : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      R_β0 ≤ D_β0 S ∧ R_β1 ≤ D_β1 S ∧ R_β01 ≤ D_β01 S ∧
      D_β0 S ≤ D_β01 S ∧ D_β1 S ≤ D_β01 S ∧
      D_β01 S = Subring.closure ((D_β0 S : Set F) ∪ {s₁}) ∧
      D_β01 S = Subring.closure ((D_β1 S : Set F) ∪ {t₀}) ∧
      (∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ D_β0 S ∧ t_loc a / t_loc b ∈ D_β1 S))
    (hPOU : ∀ (R_ε : Subring F) (D_ε : Finset (Fin (N + 1)) → Subring F),
      (R_ε = R_β0 ∧ D_ε = D_β0 ∨ R_ε = R_β1 ∧ D_ε = D_β1 ∨ R_ε = R_β01 ∧ D_ε = D_β01) →
      ∃ (s : ℕ) (a_idx : Fin s → Fin (N + 1)) (f α : Fin s → F),
        (∀ j : Fin s, f j ∈ R_ε ∧ α j ∈ R_ε) ∧
        (∑ j : Fin s, α j * f j) = 1 ∧
        (∀ (j : Fin s), ∀ w ∈ D_ε {a_idx j}, ∃ r : ℕ, (f j) ^ r * w ∈ R_ε) ∧
        (∀ (j : Fin s) (S : Finset (Fin (N + 1))), S.Nonempty →
          ∀ w ∈ D_ε (insert (a_idx j) S), ∃ r : ℕ, (f j) ^ r * w ∈ D_ε S)) :
    (∃ G_M : Finset F,
      (∀ g ∈ G_M, ∀ a : Fin (N + 1), (t_loc a) ^ k * g ∈ D_β01 {a}) ∧
      ∀ ξ : F, (∀ a : Fin (N + 1), (t_loc a) ^ k * ξ ∈ D_β01 {a}) →
        ∃ ξ₀ ξ₁ : F,
          (∀ a : Fin (N + 1), (t_loc a) ^ k * ξ₀ ∈ D_β0 {a}) ∧
          (∀ a : Fin (N + 1), (t_loc a) ^ k * ξ₁ ∈ D_β1 {a}) ∧
          ∃ c : ↥G_M → ↥R_β,
            ξ = ξ₀ - ξ₁ + ∑ g : ↥G_M, φ_VF (R_β.subtype (c g)) * (g : F)) ∧
    (∀ D_ε ∈ ({D_β0, D_β1, D_β01} : Set (Finset (Fin (N + 1)) → Subring F)),
      ∀ (p : ℕ) (ξ : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I} → F),
        (∀ I, (t_loc (I.1 0)) ^ k * ξ I ∈ D_ε (Finset.univ.image I.1)) →
        (∀ J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J},
          (∑ q : Fin (p + 3), (-1 : F) ^ (q : ℕ) *
            ξ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩) = 0) →
        ∃ η : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F,
          (∀ I, (t_loc (I.1 0)) ^ k * η I ∈ D_ε (Finset.univ.image I.1)) ∧
          ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
            (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
              η ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) = ξ I) :=
by
  classical
  have hpow_le : ∀ (A : Subring F) (x w : F) (r R : ℕ),
      x ∈ A → r ≤ R → x ^ r * w ∈ A → x ^ R * w ∈ A := by
    intro A x w r R hx hr hw
    have hxR : x ^ R = x ^ (R - r) * x ^ r := by
      rw [← pow_add, Nat.sub_add_cancel hr]
    rw [hxR, mul_assoc]
    exact A.mul_mem (A.pow_mem hx (R - r)) hw
  have hPow : ∀ (R : Subring F) (s : ℕ) (f α : Fin s → F),
      (∀ j : Fin s, f j ∈ R ∧ α j ∈ R) →
      (∑ j : Fin s, α j * f j) = 1 →
      ∀ M : ℕ, ∃ β : Fin s → F,
        (∀ j : Fin s, β j ∈ R) ∧ (∑ j : Fin s, β j * (f j) ^ M) = 1 := by
    intro R s f α hfα hsum M
    cases M with
    | zero =>
      refine ⟨fun j => α j * f j, fun j => R.mul_mem (hfα j).2 (hfα j).1, ?_⟩
      simpa [pow_zero, mul_one] using hsum
    | succ n =>
      let g : Fin s → ↥R := fun j => ⟨α j * f j, R.mul_mem (hfα j).2 (hfα j).1⟩
      have hg_sum : (∑ j ∈ (Finset.univ : Finset (Fin s)), g j) = (1 : ↥R) := by
        apply Subtype.ext
        simpa [g] using hsum
      have hmem := Ideal.sum_pow_mem_span_pow (Finset.univ : Finset (Fin s)) g n
      rw [hg_sum, one_pow, Finset.coe_univ, Set.image_univ] at hmem
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ↥R).mp hmem
      refine ⟨fun j => (c j : F) * (α j) ^ (n + 1),
        fun j => R.mul_mem (c j).2 (R.pow_mem (hfα j).2 (n + 1)), ?_⟩
      have hc_val : (↑(∑ j : Fin s, c j • g j ^ (n + 1)) : F) = 1 :=
        congrArg Subtype.val hc
      rw [← hc_val]
      push_cast
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [g, smul_eq_mul]
      push_cast
      rw [mul_pow, mul_assoc]
  have hclos_clear : ∀ (A : Subring F) (x y : F),
      x * y = 1 → x ∈ A →
      ∀ z ∈ Subring.closure ((A : Set F) ∪ {y}), ∃ m : ℕ, x ^ m * z ∈ A := by
    intro A x y hxy hx
    let S_Ax : Subring F :=
      { carrier := {z : F | ∃ m : ℕ, x ^ m * z ∈ A}
        mul_mem' := by
          intro a b ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩
          refine ⟨m₁ + m₂, ?_⟩
          have heq : x ^ (m₁ + m₂) * (a * b) = (x ^ m₁ * a) * (x ^ m₂ * b) := by
            rw [pow_add]; ring
          rw [heq]
          exact A.mul_mem hm₁ hm₂
        one_mem' := ⟨0, by simp⟩
        add_mem' := by
          intro a b ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩
          refine ⟨m₁ + m₂, ?_⟩
          have heq : x ^ (m₁ + m₂) * (a + b) =
              x ^ m₂ * (x ^ m₁ * a) + x ^ m₁ * (x ^ m₂ * b) := by
            rw [pow_add]; ring
          rw [heq]
          exact A.add_mem (A.mul_mem (A.pow_mem hx m₂) hm₁) (A.mul_mem (A.pow_mem hx m₁) hm₂)
        zero_mem' := ⟨0, by simp⟩
        neg_mem' := by
          intro a ⟨m, hm⟩
          refine ⟨m, ?_⟩
          have heq : x ^ m * (-a) = -(x ^ m * a) := mul_neg (x ^ m) a
          rw [heq]
          exact A.neg_mem hm }
    have hle : Subring.closure ((A : Set F) ∪ {y}) ≤ S_Ax := by
      rw [Subring.closure_le]
      intro z hz
      rcases hz with hzA | hzy
      · exact ⟨0, by simpa using hzA⟩
      · rw [Set.mem_singleton_iff.mp hzy]
        exact ⟨1, by rw [pow_one, hxy]; exact A.one_mem⟩
    intro z hz
    exact hle hz
  constructor
  · 
    obtain ⟨s, a_idx, f, α, hfα, hsum, hclear_glob, hclear_ins⟩ :=
      hPOU R_β01 D_β01 (Or.inr (Or.inr ⟨rfl, rfl⟩))
    have hR01_le : ∀ a : Fin (N + 1), R_β01 ≤ D_β01 {a} := fun a =>
      (hD_struct {a} (Finset.singleton_nonempty a)).2.2.1
    have ht_ratio_01 : ∀ a b : Fin (N + 1),
        t_loc a / t_loc b ∈ D_β01 (insert b {a}) := by
      intro a b
      have hne : (insert b ({a} : Finset (Fin (N + 1)))).Nonempty :=
        Finset.insert_nonempty b {a}
      have hb : b ∈ insert b ({a} : Finset (Fin (N + 1))) :=
        Finset.mem_insert_self b {a}
      have ha : a ∈ insert b ({a} : Finset (Fin (N + 1))) :=
        Finset.mem_insert_of_mem (Finset.mem_singleton_self a)
      have hst := hD_struct (insert b {a}) hne
      exact hst.2.2.2.1 ((hst.2.2.2.2.2.2.2 a ha b hb).1)
    have hex_r1 : ∀ (j : Fin s) (a : Fin (N + 1)),
        ∃ r : ℕ, (f j) ^ r * (t_loc a / t_loc (a_idx j)) ^ k ∈ D_β01 {a} := by
      intro j a
      exact hclear_ins j {a} (Finset.singleton_nonempty a)
        ((t_loc a / t_loc (a_idx j)) ^ k)
        ((D_β01 (insert (a_idx j) {a})).pow_mem (ht_ratio_01 a (a_idx j)) k)
    choose r₁ hr₁ using hex_r1
    have hex_r2 : ∀ (j l : Fin s),
        ∃ r' r'' : ℕ,
          (f l) ^ r'' * ((f j) ^ r' * (t_loc (a_idx j) / t_loc (a_idx l)) ^ k) ∈ R_β01 := by
      intro j l
      have hmem_ins : (t_loc (a_idx j) / t_loc (a_idx l)) ^ k ∈
          D_β01 (insert (a_idx j) {a_idx l}) := by
        have hne : (insert (a_idx j) ({a_idx l} : Finset (Fin (N + 1)))).Nonempty :=
          Finset.insert_nonempty _ _
        have hj : a_idx j ∈ insert (a_idx j) ({a_idx l} : Finset (Fin (N + 1))) :=
          Finset.mem_insert_self _ _
        have hl : a_idx l ∈ insert (a_idx j) ({a_idx l} : Finset (Fin (N + 1))) :=
          Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
        have hst := hD_struct (insert (a_idx j) {a_idx l}) hne
        exact (D_β01 _).pow_mem (hst.2.2.2.1 ((hst.2.2.2.2.2.2.2 _ hj _ hl).1)) k
      obtain ⟨r', hr'⟩ := hclear_ins j {a_idx l} (Finset.singleton_nonempty _) _ hmem_ins
      obtain ⟨r'', hr''⟩ := hclear_glob l _ hr'
      exact ⟨r', r'', hr''⟩
    choose r₂' r₂'' hr₂ using hex_r2
    let R₁ : ℕ := (Finset.univ : Finset (Fin s × Fin (N + 1))).sup (fun p => r₁ p.1 p.2)
    let R₂ : ℕ := (Finset.univ : Finset (Fin s × Fin s)).sup
      (fun q => max (r₂' q.1 q.2) (r₂'' q.1 q.2))
    let R_exp : ℕ := max R₁ R₂
    have hR1_clear : ∀ (j : Fin s) (a : Fin (N + 1)),
        (f j) ^ R_exp * (t_loc a / t_loc (a_idx j)) ^ k ∈ D_β01 {a} := by
      intro j a
      have hle : r₁ j a ≤ R_exp :=
        le_trans (Finset.le_sup (f := fun p : Fin s × Fin (N + 1) => r₁ p.1 p.2)
          (Finset.mem_univ (j, a))) (le_max_left R₁ R₂)
      exact hpow_le (D_β01 {a}) (f j) _ (r₁ j a) R_exp (hR01_le a (hfα j).1) hle (hr₁ j a)
    have hR2_clear : ∀ (j l : Fin s),
        (f l) ^ R_exp * ((f j) ^ R_exp * (t_loc (a_idx j) / t_loc (a_idx l)) ^ k) ∈ R_β01 := by
      intro j l
      have hsup : max (r₂' j l) (r₂'' j l) ≤ R_exp :=
        le_trans (Finset.le_sup (f := fun q : Fin s × Fin s => max (r₂' q.1 q.2) (r₂'' q.1 q.2))
          (Finset.mem_univ (j, l))) (le_max_right R₁ R₂)
      have hle' : r₂' j l ≤ R_exp := le_trans (le_max_left _ _) hsup
      have hle'' : r₂'' j l ≤ R_exp := le_trans (le_max_right _ _) hsup
      have hf1 : (f j) ^ R_exp = (f j) ^ (R_exp - r₂' j l) * (f j) ^ (r₂' j l) := by
        rw [← pow_add, Nat.sub_add_cancel hle']
      have hf2 : (f l) ^ R_exp = (f l) ^ (R_exp - r₂'' j l) * (f l) ^ (r₂'' j l) := by
        rw [← pow_add, Nat.sub_add_cancel hle'']
      have heq : (f l) ^ R_exp * ((f j) ^ R_exp * (t_loc (a_idx j) / t_loc (a_idx l)) ^ k) =
          (f l) ^ (R_exp - r₂'' j l) * (f j) ^ (R_exp - r₂' j l) *
            ((f l) ^ (r₂'' j l) * ((f j) ^ (r₂' j l) *
              (t_loc (a_idx j) / t_loc (a_idx l)) ^ k)) := by
        rw [hf1, hf2]
        ring
      rw [heq]
      exact R_β01.mul_mem
        (R_β01.mul_mem (R_β01.pow_mem (hfα l).1 _) (R_β01.pow_mem (hfα j).1 _))
        (hr₂ j l)
    let ω : Fin s → F := fun j => (f j) ^ R_exp * ((t_loc (a_idx j)) ^ k)⁻¹
    have hω_mem : ∀ (j : Fin s) (a : Fin (N + 1)), (t_loc a) ^ k * ω j ∈ D_β01 {a} := by
      intro j a
      have heq : (t_loc a) ^ k * ω j = (f j) ^ R_exp * (t_loc a / t_loc (a_idx j)) ^ k := by
        dsimp [ω]
        rw [div_pow, div_eq_mul_inv]
        ring
      rw [heq]
      exact hR1_clear j a
    obtain ⟨β_dual, hβ_dual_mem, hβ_dual_sum⟩ :=
      hPow R_β01 s f α hfα hsum (2 * R_exp)
    have hω_rep : ∀ ξ : F, (∀ a : Fin (N + 1), (t_loc a) ^ k * ξ ∈ D_β01 {a}) →
        ∃ u : Fin s → F, (∀ j : Fin s, u j ∈ R_β01) ∧ ξ = ∑ j : Fin s, u j * ω j := by
      intro ξ hξ
      choose m_l hm_l using fun l : Fin s =>
        hclear_glob l ((t_loc (a_idx l)) ^ k * ξ) (hξ (a_idx l))
      let z : Fin s → F := fun j => (f j) ^ R_exp * ((t_loc (a_idx j)) ^ k * ξ)
      have hz_mem : ∀ j : Fin s, z j ∈ R_β01 := by
        intro j
        let M_z : ℕ := (Finset.univ : Finset (Fin s)).sup (fun l => R_exp + m_l l)
        obtain ⟨γ, hγ_mem, hγ_sum⟩ := hPow R_β01 s f α hfα hsum M_z
        have hz_eq : z j = ∑ l : Fin s, γ l * ((f l) ^ M_z * z j) := by
          calc
            z j = 1 * z j := (one_mul _).symm
            _ = (∑ l : Fin s, γ l * (f l) ^ M_z) * z j := by rw [hγ_sum]
            _ = ∑ l : Fin s, γ l * ((f l) ^ M_z * z j) := by
              rw [Finset.sum_mul]
              exact Finset.sum_congr rfl fun l _ => mul_assoc _ _ _
        rw [hz_eq]
        refine R_β01.sum_mem fun l _ => R_β01.mul_mem (hγ_mem l) ?_
        have hle_M : R_exp + m_l l ≤ M_z :=
          Finset.le_sup (f := fun l : Fin s => R_exp + m_l l) (Finset.mem_univ l)
        refine hpow_le R_β01 (f l) (z j) (R_exp + m_l l) M_z (hfα l).1 hle_M ?_
        have htl_ne : (t_loc (a_idx l)) ^ k ≠ 0 := pow_ne_zero k (ht_ne (a_idx l))
        have heq_z : (f l) ^ (R_exp + m_l l) * z j =
            ((f l) ^ R_exp * ((f j) ^ R_exp * (t_loc (a_idx j) / t_loc (a_idx l)) ^ k)) *
              ((f l) ^ (m_l l) * ((t_loc (a_idx l)) ^ k * ξ)) := by
          dsimp [z]
          rw [pow_add, div_pow]
          have hdiv : (t_loc (a_idx j)) ^ k / (t_loc (a_idx l)) ^ k * (t_loc (a_idx l)) ^ k =
              (t_loc (a_idx j)) ^ k := div_mul_cancel₀ _ htl_ne
          calc
            ((f l) ^ R_exp * (f l) ^ (m_l l)) * ((f j) ^ R_exp * ((t_loc (a_idx j)) ^ k * ξ)) =
                ((f l) ^ R_exp * ((f j) ^ R_exp *
                  ((t_loc (a_idx j)) ^ k / (t_loc (a_idx l)) ^ k * (t_loc (a_idx l)) ^ k))) *
                  ((f l) ^ (m_l l) * ξ) := by
              rw [hdiv]
              ring
            _ = ((f l) ^ R_exp * ((f j) ^ R_exp *
                  ((t_loc (a_idx j)) ^ k / (t_loc (a_idx l)) ^ k))) *
                  ((f l) ^ (m_l l) * ((t_loc (a_idx l)) ^ k * ξ)) := by
              ring
        rw [heq_z]
        exact R_β01.mul_mem (hR2_clear j l) (hm_l l)
      refine ⟨fun j => β_dual j * z j, fun j => R_β01.mul_mem (hβ_dual_mem j) (hz_mem j), ?_⟩
      have hterm : ∀ j : Fin s, (β_dual j * z j) * ω j = β_dual j * (f j) ^ (2 * R_exp) * ξ := by
        intro j
        have htj_ne : (t_loc (a_idx j)) ^ k ≠ 0 := pow_ne_zero k (ht_ne (a_idx j))
        dsimp [z, ω]
        have h2R : 2 * R_exp = R_exp + R_exp := two_mul R_exp
        rw [h2R, pow_add]
        calc
          (β_dual j * ((f j) ^ R_exp * ((t_loc (a_idx j)) ^ k * ξ))) *
              ((f j) ^ R_exp * ((t_loc (a_idx j)) ^ k)⁻¹) =
              β_dual j * ((f j) ^ R_exp * (f j) ^ R_exp) *
                ((t_loc (a_idx j)) ^ k * ((t_loc (a_idx j)) ^ k)⁻¹) * ξ := by
            ring
          _ = β_dual j * ((f j) ^ R_exp * (f j) ^ R_exp) * ξ := by
            rw [mul_inv_cancel₀ htj_ne, mul_one]
      calc
        ξ = 1 * ξ := (one_mul ξ).symm
        _ = (∑ j : Fin s, β_dual j * (f j) ^ (2 * R_exp)) * ξ := by rw [hβ_dual_sum]
        _ = ∑ j : Fin s, β_dual j * (f j) ^ (2 * R_exp) * ξ := Finset.sum_mul _ _ _
        _ = ∑ j : Fin s, (β_dual j * z j) * ω j :=
          Finset.sum_congr rfl fun j _ => (hterm j).symm
    
    let ψ : ↥R_β →+* F := φ_VF.comp R_β.subtype
    have hst_sing : ∀ a : Fin (N + 1),
        R_β0 ≤ D_β0 {a} ∧ R_β1 ≤ D_β1 {a} ∧
        D_β0 {a} ≤ D_β01 {a} ∧ D_β1 {a} ≤ D_β01 {a} ∧
        D_β01 {a} = Subring.closure ((D_β0 {a} : Set F) ∪ {s₁}) ∧
        D_β01 {a} = Subring.closure ((D_β1 {a} : Set F) ∪ {t₀}) := by
      intro a
      have h := hD_struct {a} (Finset.singleton_nonempty a)
      exact ⟨h.1, h.2.1, h.2.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2.1, h.2.2.2.2.2.2.1⟩
    have hex_a0 : ∀ (j : Fin s) (μ : Fin d₀) (a : Fin (N + 1)),
        ∃ m : ℕ, t₀ ^ m * ((t_loc a) ^ k * (gen₀ μ * ω j)) ∈ D_β0 {a} := by
      intro j μ a
      have hgen_01 : gen₀ μ ∈ D_β01 {a} :=
        (hst_sing a).2.2.1 ((hst_sing a).1 (hgen₀ μ))
      have hw_01 : (t_loc a) ^ k * (gen₀ μ * ω j) ∈ D_β01 {a} := by
        have heq : (t_loc a) ^ k * (gen₀ μ * ω j) = gen₀ μ * ((t_loc a) ^ k * ω j) := by ring
        rw [heq]
