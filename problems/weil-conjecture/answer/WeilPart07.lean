            Subtype.ext hJ_comp
          exact (hα_res_eq hJI _ _).symm
        · refine Finset.sum_congr rfl fun r _ => ?_
          rw [map_zsmul, hY_map_comp]
      have hterm : ∀ r : Fin (q + 2),
          (-1 : ℤ) ^ (r : ℕ) •
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_inf_left (V_cov a)
                (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                  Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t)))))).op).hom
              (η_a ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩) =
          - ((-1 : ℤ) ^ (p₀ : ℕ) •
              ((-1 : ℤ) ^ (p₀.succAbove r : ℕ) •
                (Y.presheaf.map (CategoryTheory.homOfLE
                  (hWJ_le.trans (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                    Finset.mem_image_of_mem J.1
                      (Finset.mem_univ ((p₀.succAbove r).succAbove t)))))).op).hom
                  (α ⟨J.1 ∘ (p₀.succAbove r).succAbove,
                    J.2.comp (Fin.strictMono_succAbove (p₀.succAbove r))⟩))) := by
        intro r
        let J_r : {I' : Fin (q + 2) → Fin (N + 1) // StrictMono I'} :=
          ⟨J.1 ∘ (p₀.succAbove r).succAbove,
            J.2.comp (Fin.strictMono_succAbove (p₀.succAbove r))⟩
        let p_r : Fin (q + 2) := r.predAbove p₀
        have hp_r : J_r.1 p_r = a := by
          change J.1 ((p₀.succAbove r).succAbove (r.predAbove p₀)) = a
          rw [Fin.succAbove_succAbove_predAbove p₀ r]
          exact hp₀
        have hcomp_r : J_r.1 ∘ p_r.succAbove = I.1 ∘ r.succAbove := by
          funext k
          change J.1 ((p₀.succAbove r).succAbove ((r.predAbove p₀).succAbove k)) =
            I.1 (r.succAbove k)
          rw [Fin.succAbove_succAbove_succAbove_predAbove p₀ r k]
          exact congrFun hJ_comp (r.succAbove k)
        have hle_Jr : V_cov a ⊓ Finset.inf (Finset.univ.image (I.1 ∘ r.succAbove)) V_cov ≤
            Finset.inf (Finset.univ.image J_r.1) V_cov :=
          hInf_le hp_r hcomp_r
        rw [hη_char ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩
          J_r p_r hp_r hcomp_r hle_Jr,
          map_zsmul, hY_map_comp, ← mul_zsmul, hSign p₀ r, neg_zsmul, mul_zsmul]
      calc
        (∑ r : Fin (q + 2),
            (-1 : ℤ) ^ (r : ℕ) •
              (Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_left (V_cov a)
                  (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                    Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t)))))).op).hom
                (η_a ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩))
          = ∑ r : Fin (q + 2),
              - ((-1 : ℤ) ^ (p₀ : ℕ) •
                  ((-1 : ℤ) ^ (p₀.succAbove r : ℕ) •
                    (Y.presheaf.map (CategoryTheory.homOfLE
                      (hWJ_le.trans (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                        Finset.mem_image_of_mem J.1
                          (Finset.mem_univ ((p₀.succAbove r).succAbove t)))))).op).hom
                      (α ⟨J.1 ∘ (p₀.succAbove r).succAbove,
                        J.2.comp (Fin.strictMono_succAbove (p₀.succAbove r))⟩))) :=
            Finset.sum_congr rfl fun r _ => hterm r
        _ = - ((-1 : ℤ) ^ (p₀ : ℕ) •
              ∑ r : Fin (q + 2),
                (-1 : ℤ) ^ (p₀.succAbove r : ℕ) •
                  (Y.presheaf.map (CategoryTheory.homOfLE
                    (hWJ_le.trans (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                      Finset.mem_image_of_mem J.1
                        (Finset.mem_univ ((p₀.succAbove r).succAbove t)))))).op).hom
                    (α ⟨J.1 ∘ (p₀.succAbove r).succAbove,
                      J.2.comp (Fin.strictMono_succAbove (p₀.succAbove r))⟩)) := by
            rw [Finset.sum_neg_distrib, ← Finset.smul_sum]
        _ = - ((-1 : ℤ) ^ (p₀ : ℕ) •
              (- ((-1 : ℤ) ^ (p₀ : ℕ) •
                (Y.presheaf.map (CategoryTheory.homOfLE
                  (inf_le_right : V_cov a ⊓ Finset.inf (Finset.univ.image I.1) V_cov ≤
                    Finset.inf (Finset.univ.image I.1) V_cov)).op).hom (α I)))) := by
            rw [eq_neg_of_add_eq_zero_right hcoc_split]
        _ = (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : V_cov a ⊓ Finset.inf (Finset.univ.image I.1) V_cov ≤
                Finset.inf (Finset.univ.image I.1) V_cov)).op).hom (α I) := by
            rw [smul_neg, neg_neg, ← mul_zsmul, hNegOneSq, one_zsmul]
  
  have hAffCech : ∀ (U : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      ∀ (N : ℕ) (V_cov : Fin (N + 1) → Y.Opens),
        (∀ a : Fin (N + 1), V_cov a ≤ U) →
        (∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (V_cov a)) →
        (⨆ a : Fin (N + 1), V_cov a) = U →
        ∀ (q : ℕ)
          (α : ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
            ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) V_cov)))),
          (∀ J : {J : Fin (q + 3) → Fin (N + 1) // StrictMono J},
            (∑ r : Fin (q + 3),
              (-1 : ℤ) ^ (r : ℕ) •
                (Y.presheaf.map (CategoryTheory.homOfLE
                  (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                    Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))).op).hom
                  (α ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) = 0) →
          ∃ β : ∀ K : {K : Fin (q + 1) → Fin (N + 1) // StrictMono K},
              ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image K.1) V_cov))),
            ∀ I : {I : Fin (q + 2) → Fin (N + 1) // StrictMono I},
              (∑ r : Fin (q + 2),
