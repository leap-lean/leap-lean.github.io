        dsimp [s_sum, f_t]
        rw [mul_pow, hL0, pow_add, pow_mul, mul_pow]
        ring
      · refine Finset.sum_congr rfl fun j _ => ?_
        have hL1 : L + 1 = (M * n₀ + 1) + n₁ * M := by dsimp [L]; ring
        dsimp [s_sum, h_t]
