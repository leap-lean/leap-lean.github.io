    have h_ker_appLE : RingHom.ker ((γ.appLE W_div ⊤ h_le).hom) = Ideal.span {t_div} := by
      let f_sp := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W)
      have h_le' : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) ≤
          (TopologicalSpace.Opens.map (f_sp ≫ hW.fromSpec).base).obj W_div := by
        rwa [← hγ_W]
      have h_app_eq : γ.appLE W_div ⊤ h_le = (f_sp ≫ hW.fromSpec).appLE W_div ⊤ h_le' := by
        congr 1
      have h_gen : ∀ (U' : (AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op W_div))).Opens)
          (hU' : U' = ⊤) (he : ⊤ ≤ (TopologicalSpace.Opens.map f_sp.base).obj U'),
          (AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op W_div))).presheaf.map
            (CategoryTheory.eqToHom hU').op ≫ f_sp.appLE U' ⊤ he = f_sp.appTop := by
        rintro _ rfl _
        simp [AlgebraicGeometry.Scheme.Hom.appTop, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      rw [h_app_eq, AlgebraicGeometry.Scheme.Hom.comp_appLE, hW.fromSpec_app_self,
        CategoryTheory.Category.assoc, h_gen _ hW.fromSpec_preimage_self h_le',
        ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality]
      ext z
      rw [RingHom.mem_ker, ← hψW_ker, RingHom.mem_ker]
      change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (ψ_W z) = 0 ↔ ψ_W z = 0
      exact map_eq_zero_iff _
        (CategoryTheory.ConcreteCategory.bijective_of_isIso
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv).injective
    have hSurj_ψW : Function.Surjective ψ_W := fun r =>
      ⟨φ_W (Polynomial.C r), DFunLike.congr_fun hψW_id r⟩
    have h_basic_compl : (C.basicOpen t_div : Set ↥C) = (W_div : Set ↥C) \ Set.range γ.base := by
      ext y
      by_cases hy : y ∈ (W_div : Set ↥C)
      · have hy_r : y ∈ Set.range hW.fromSpec.base := by rwa [hW.range_fromSpec]
        obtain ⟨p, rfl⟩ := hy_r
        let p_ps : PrimeSpectrum D := p
        have h_lhs : hW.fromSpec.base p ∈ (C.basicOpen t_div : Set ↥C) ↔
            t_div ∉ p_ps.asIdeal := by
          change p ∈ (TopologicalSpace.Opens.map hW.fromSpec.base).obj (C.basicOpen t_div) ↔ _
          rw [hW.fromSpec_preimage_basicOpen t_div]
          exact PrimeSpectrum.mem_basicOpen t_div (x := p_ps)
        have h_rhs : hW.fromSpec.base p ∈ (W_div : Set ↥C) \ Set.range γ.base ↔
            t_div ∉ p_ps.asIdeal := by
          simp only [Set.mem_sdiff, hy, true_and]
          rw [hγ_W]
          have h_inj : hW.fromSpec.base p ∈ Set.range
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W) ≫ hW.fromSpec).base ↔
              p_ps ∈ Set.range (PrimeSpectrum.comap ψ_W) := by
            constructor
            · rintro ⟨q, hq⟩
              exact ⟨q, hW.fromSpec.isOpenEmbedding.injective hq⟩
            · rintro ⟨q, hq⟩
              exact ⟨q, congrArg hW.fromSpec.base hq⟩
          rw [h_inj, _root_.range_comap_of_surjective _ ψ_W hSurj_ψW, hψW_ker]
          have h_zl : p_ps ∈ PrimeSpectrum.zeroLocus (Ideal.span {t_div} : Set D) ↔
              t_div ∈ p_ps.asIdeal := by
            rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.span_singleton_le_iff_mem]
          rw [h_zl]
        exact h_lhs.trans h_rhs.symm
      · constructor
        · intro h_in
          exact absurd (C.basicOpen_le t_div h_in) hy
        · intro h_in
          exact absurd h_in.1 hy
    exact ⟨W_div, t_div, e_div, hW, he_et, hW_comm, ht_ne, ⟨h_le, h_ker_appLE⟩, h_basic_compl, hDisj⟩
  have : HenselianLocalRing ↥V := hHensel
  have : AlgebraicGeometry.IsSeparated g_semi := hSS.2.2.1
  let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
  let k₀ : Type u := 𝔪_V.ResidueField
  let π_V : ↥V →+* k₀ := algebraMap ↥V k₀
  have hBij_res : Function.Bijective (algebraMap (↥V ⧸ 𝔪_V) k₀) :=
    Ideal.bijective_algebraMap_quotient_residueField 𝔪_V
  have hπV_eq : ∀ r : ↥V, π_V r = algebraMap (↥V ⧸ 𝔪_V) k₀ (Ideal.Quotient.mk 𝔪_V r) :=
    fun r => IsScalarTower.algebraMap_apply ↥V (↥V ⧸ 𝔪_V) k₀ r
  have hSurj : Function.Surjective π_V := by
    intro y
    obtain ⟨q, rfl⟩ := hBij_res.surjective y
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
    exact ⟨r, (hπV_eq r).symm⟩
  have hKer : RingHom.ker π_V = 𝔪_V := by
    ext r
    rw [RingHom.mem_ker, hπV_eq r, map_eq_zero_iff _ hBij_res.injective,
      Ideal.Quotient.eq_zero_iff_mem]
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_V)
  let fst₀ := CategoryTheory.Limits.pullback.fst g_semi s₀
  let pt₀ : PrimeSpectrum k₀ := ⊥
  have hPolChart : ∀ i : Fin (r_pts + 1),
      ∃ (W' : C_semi.Opens)
        (e' : W'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
        fst₀.base ((σ_bar i).base pt₀) ∈ W' ∧
        AlgebraicGeometry.Etale e' ∧
        W'.ι ≫ g_semi = e' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    intro i
    rcases hSS.2.2.2.2 (fst₀.base ((σ_bar i).base pt₀)) with
      ⟨W', e', hxW', hEt', hComm'⟩ | ⟨W, a, e, hxW, _ha_ne, hEt, hComm⟩
    · exact ⟨W', e', hxW', hEt', hComm'⟩
    · obtain ⟨V_sm, hqV, hSmV⟩ := hSm_bar i
      obtain ⟨ε, hε⟩ := h_step1 ↥V k₀ π_V C_semi g_semi W a e hEt hComm
        (σ_bar i) (hSec_bar i) V_sm hqV hSmV hxW
      exact h_step2 ↥V C_semi g_semi W a e hEt hComm _ hxW ε hε
  have hSingleLift : ∀ i : Fin (r_pts + 1),
      ∃ (γ : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi)
        (U : C_semi.Opens)
        (hU : AlgebraicGeometry.IsAffineOpen U)
        (φ : Polynomial ↥V →+* ↑(C_semi.presheaf.obj (Opposite.op U)))
        (ψ : ↑(C_semi.presheaf.obj (Opposite.op U)) →+* ↥V),
        σ_bar i ≫ fst₀ = s₀ ≫ γ ∧
        γ ≫ g_semi = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) ∧
        AlgebraicGeometry.IsClosedImmersion γ ∧
        φ.Etale ∧
        hU.fromSpec ≫ g_semi =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp Polynomial.C)) ∧
        γ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec ∧
        ψ.comp (φ.comp Polynomial.C) = RingHom.id ↥V ∧
        RingHom.ker ψ = Ideal.span {φ Polynomial.X} := by
    intro i
    obtain ⟨W', e', hxW', hEt', hComm'⟩ := hPolChart i
    exact h_step3 ↥V k₀ π_V hSurj hKer
      (fun A _ _ _ ω hω => hHenselSec ↥V A k₀ π_V hSurj hKer ω hω)
      C_semi g_semi (σ_bar i) (hSec_bar i) W' e' hxW' hEt' hComm'
  choose γ_div U_1 hU_1 φ_1 ψ_1 hLift using hSingleLift
  have : AlgebraicGeometry.IsClosedImmersion s₀ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π_V) hSurj
  have : AlgebraicGeometry.IsClosedImmersion fst₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_semi s₀).flip inferInstance
  let m_V : PrimeSpectrum ↥V := ⟨𝔪_V, inferInstance⟩
  have hmV_eq : (m_V : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥V))) = s₀.base pt₀ := by
    apply PrimeSpectrum.ext
    change 𝔪_V = Ideal.comap π_V pt₀.asIdeal
    have hpt₀_bot : pt₀.asIdeal = ⊥ := by
      ext z
      simp only [Submodule.mem_bot]
      constructor
      · intro hz
        by_contra hne
        exact pt₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hz (IsUnit.mk0 _ hne))
      · rintro rfl
        exact zero_mem _
    rw [hpt₀_bot, ← RingHom.ker_eq_comap_bot, hKer]
  let Z_other : Fin (r_pts + 1) → Set ↥C_semi :=
    fun i => ⋃ j : {j : Fin (r_pts + 1) // j ≠ i}, Set.range (γ_div j.1).base
  have hZ_cl : ∀ i : Fin (r_pts + 1), IsClosed (Z_other i) := by
    intro i
    refine isClosed_iUnion_of_finite (fun j => ?_)
    have : AlgebraicGeometry.IsClosedImmersion (γ_div j.1) := (hLift j.1).2.2.1
    exact (γ_div j.1).isClosedEmbedding.isClosed_range
  have hZ_avoid : ∀ i : Fin (r_pts + 1), (γ_div i).base m_V ∉ Z_other i := by
    intro i h_in
    rw [Set.mem_iUnion] at h_in
    obtain ⟨⟨j, hj_ne⟩, P, hP_eq⟩ := h_in
    have hP_mV : P = m_V := by
      have h1 : (γ_div j ≫ g_semi).base P = P := by
        rw [(hLift j).2.1]
        rfl
      have h2 : (γ_div i ≫ g_semi).base m_V = m_V := by
        rw [(hLift i).2.1]
        rfl
      have h3 : g_semi.base ((γ_div j).base P) = g_semi.base ((γ_div i).base m_V) :=
        congrArg g_semi.base hP_eq
      exact h1.symm.trans (h3.trans h2)
    rw [hP_mV, hmV_eq] at hP_eq
    have h_fst_eq : fst₀.base ((σ_bar j).base pt₀) = fst₀.base ((σ_bar i).base pt₀) := by
      have hj_c := congrArg (fun f => f.base pt₀) (hLift j).1
      have hi_c := congrArg (fun f => f.base pt₀) (hLift i).1
      exact hj_c.trans (hP_eq.trans hi_c.symm)
    have h_σ_eq : (σ_bar j).base pt₀ = (σ_bar i).base pt₀ :=
      fst₀.isClosedEmbedding.injective h_fst_eq
    exact hj_ne (hInj_bar h_σ_eq)
  have hCartierAll : ∀ i : Fin (r_pts + 1),
      ∃ (W_div : C_semi.Opens)
        (t_div : ↑(C_semi.presheaf.obj (Opposite.op W_div)))
        (e_div : W_div.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
        AlgebraicGeometry.IsAffineOpen W_div ∧
        AlgebraicGeometry.Etale e_div ∧
        W_div.ι ≫ g_semi =
          e_div ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        t_div ≠ 0 ∧
        (∃ h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
            (TopologicalSpace.Opens.map (γ_div i).base).obj W_div,
          RingHom.ker (((γ_div i).appLE W_div ⊤ h_le).hom) = Ideal.span {t_div}) ∧
        (C_semi.basicOpen t_div : Set ↥C_semi) =
          (W_div : Set ↥C_semi) \ Set.range (γ_div i).base ∧
        Disjoint (W_div : Set ↥C_semi) (Z_other i) :=
    fun i => h_step4 ↥V C_semi g_semi (γ_div i) (U_1 i) (hU_1 i) (φ_1 i) (ψ_1 i)
      (hLift i).2.2.2.1 (hLift i).2.2.2.2.1 (hLift i).2.2.2.2.2.1
      (hLift i).2.2.2.2.2.2.1 (hLift i).2.2.2.2.2.2.2
      (Z_other i) (hZ_cl i) (hZ_avoid i)
  choose W_div t_div e_div hCartier using hCartierAll
  refine ⟨γ_div, W_div, t_div, e_div, fun i => (hLift i).1, fun i => ?_, fun i j hij => ?_⟩
  · exact ⟨(hLift i).2.1, (hLift i).2.2.1, (hCartier i).1, (hCartier i).2.1,
      (hCartier i).2.2.1, (hCartier i).2.2.2.1, (hCartier i).2.2.2.2.1,
      (hCartier i).2.2.2.2.2.1⟩
  · exact (hCartier i).2.2.2.2.2.2.mono_right
      (Set.subset_iUnion (fun k : {k : Fin (r_pts + 1) // k ≠ i} => Set.range (γ_div k.1).base)
        ⟨j, hij.symm⟩)

theorem weil_strictlySemistable_all_prime_fiber_component_specialization (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hAlgRes_max : IsAlgClosed (IsLocalRing.maximalIdeal ↥V).ResidueField)
    (hEtDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
      [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
      (m : Ideal B) [m.IsPrime],
      ∃ s : B, s ∉ m ∧ IsDomain (Localization.Away s))
    (hNodalNorm : ∀ (K' : Type u) [Field K'] (V' : ValuationSubring K') (a' : ↥V'), a' ≠ 0 →
      IsDomain (MvPolynomial (Fin 2) ↥V' ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a'}) ∧
      IsIntegrallyClosed (MvPolynomial (Fin 2) ↥V' ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a'}))
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hProp : AlgebraicGeometry.IsProper g_semi)
    (hSS : IsStrictlySemistableCurveOverValuation V g_semi)
    (r_pts : ℕ)
    (σ_bar : Fin (r_pts + 1) →
      (AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥V).ResidueField) ⟶
        CategoryTheory.Limits.pullback g_semi
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (hHit_bar : ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))),
      ∃ i : Fin (r_pts + 1),
        (σ_bar i).base (⊥ : PrimeSpectrum (IsLocalRing.maximalIdeal ↥V).ResidueField) ∈ E)
    (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (W_div : Fin (r_pts + 1) → C_semi.Opens)
    (e_div : ∀ i : Fin (r_pts + 1),
      (W_div i).toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)))
    (hCompat : ∀ i : Fin (r_pts + 1),
      σ_bar i ≫ CategoryTheory.Limits.pullback.fst g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)) ≫ γ_div i)
    (hSec : ∀ i : Fin (r_pts + 1),
      γ_div i ≫ g_semi = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)))
    (hAff : ∀ i : Fin (r_pts + 1), AlgebraicGeometry.IsAffineOpen (W_div i))
    (hRange : ∀ i : Fin (r_pts + 1), Set.range (γ_div i).base ⊆ (W_div i : Set ↥C_semi))
    (hEt : ∀ i : Fin (r_pts + 1), AlgebraicGeometry.Etale (e_div i))
    (hComm : ∀ i : Fin (r_pts + 1),
      (W_div i).ι ≫ g_semi =
        e_div i ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (P : PrimeSpectrum ↥V)
    (E_P : Set ↥(CategoryTheory.Limits.pullback g_semi
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hEP : E_P ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_semi
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))) :
    ∃ (i : Fin (r_pts + 1))
      (q_P : ↥(CategoryTheory.Limits.pullback g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))),
      q_P ∈ E_P ∧
      (CategoryTheory.Limits.pullback.fst g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base
          q_P ∈ Set.range (γ_div i).base :=
by
  clear hAlgRes_max
  have etale_quotient_of_surjective :
      ∀ (A₀ A₁ B : Type u) [CommRing A₀] [CommRing A₁] [CommRing B]
        (φ : A₀ →+* B) (π : A₀ →+* A₁),
        φ.Etale → Function.Surjective π →
        ∃ ψ : A₁ →+* (B ⧸ Ideal.map φ (RingHom.ker π)),
          ψ.Etale ∧ ψ.comp π = (Ideal.Quotient.mk (Ideal.map φ (RingHom.ker π))).comp φ := by
    clear * -
    intro A₀ A₁ B _ _ _ φ π hφ hπ
    let J_B : Ideal B := Ideal.map φ (RingHom.ker π)
    let q_B : B →+* (B ⧸ J_B) := Ideal.Quotient.mk J_B
    let inv_π : A₁ → A₀ := Function.surjInv hπ
    have hwd : ∀ x y : A₀, π x = π y → q_B (φ x) = q_B (φ y) := by
      intro x y hxy
      have hker : x - y ∈ RingHom.ker π := by
        rw [RingHom.mem_ker, map_sub, sub_eq_zero]
        exact hxy
      have hmap : φ x - φ y ∈ J_B := by
        rw [← map_sub]
        exact Ideal.mem_map_of_mem φ hker
      exact Ideal.Quotient.eq.mpr hmap
    let ψ_fun : A₁ → (B ⧸ J_B) := fun a₁ => q_B (φ (inv_π a₁))
    have hψ_pi : ∀ a₀ : A₀, ψ_fun (π a₀) = q_B (φ a₀) := fun a₀ =>
      hwd (inv_π (π a₀)) a₀ (Function.surjInv_eq hπ (π a₀))
    let ψ : A₁ →+* (B ⧸ J_B) :=
      { toFun := ψ_fun
        map_one' := by
          rw [← map_one π, hψ_pi 1, map_one, map_one]
        map_mul' := fun x y => by
          obtain ⟨a, rfl⟩ := hπ x
          obtain ⟨b, rfl⟩ := hπ y
          rw [← map_mul π, hψ_pi (a * b), hψ_pi a, hψ_pi b, map_mul, map_mul]
        map_zero' := by
          rw [← map_zero π, hψ_pi 0, map_zero, map_zero]
        map_add' := fun x y => by
          obtain ⟨a, rfl⟩ := hπ x
          obtain ⟨b, rfl⟩ := hπ y
          rw [← map_add π, hψ_pi (a + b), hψ_pi a, hψ_pi b, map_add, map_add] }
    have hψ_comp : ψ.comp π = q_B.comp φ := RingHom.ext hψ_pi
    refine ⟨ψ, ?_, hψ_comp⟩
    change @Algebra.Etale A₁ (B ⧸ J_B) _ _ ψ.toAlgebra
    letI : Algebra A₀ A₁ := π.toAlgebra
    letI : Algebra A₀ B := φ.toAlgebra
    letI : Algebra A₁ (B ⧸ J_B) := ψ.toAlgebra
    haveI : IsScalarTower A₀ A₁ (B ⧸ J_B) :=
      IsScalarTower.of_algebraMap_eq' hψ_comp.symm
    haveI : Algebra.Etale A₀ B := hφ.toAlgebra
    haveI : Algebra.Etale A₁ (TensorProduct A₀ A₁ B) :=
      Algebra.Etale.baseChange A₀ B A₁
    let toFun : TensorProduct A₀ A₁ B →ₐ[A₁] (B ⧸ J_B) :=
      Algebra.TensorProduct.lift (Algebra.ofId A₁ (B ⧸ J_B)) (Ideal.Quotient.mkₐ A₀ J_B)
        (fun _ _ => mul_comm _ _)
    have htoFun_tmul : ∀ (a₁ : A₁) (b : B), toFun (a₁ ⊗ₜ[A₀] b) = ψ a₁ * q_B b :=
      fun a₁ b => Algebra.TensorProduct.lift_tmul _ _ _ a₁ b
    let inr : B →+* TensorProduct A₀ A₁ B :=
      (Algebra.TensorProduct.includeRight (R := A₀) (A := A₁) (B := B)).toRingHom
    have hinr_ker : J_B ≤ RingHom.ker inr := by
      rw [Ideal.map_le_iff_le_comap]
      intro a₀ ha₀
      change (1 : A₁) ⊗ₜ[A₀] (φ a₀) = 0
      have hsmulB : φ a₀ = a₀ • (1 : B) :=
        Algebra.algebraMap_eq_smul_one (R := A₀) (A := B) a₀
      have hsmulA : π a₀ = a₀ • (1 : A₁) :=
        Algebra.algebraMap_eq_smul_one (R := A₀) (A := A₁) a₀
      rw [hsmulB, ← TensorProduct.smul_tmul, ← hsmulA, RingHom.mem_ker.mp ha₀,
        TensorProduct.zero_tmul]
    let invFun : (B ⧸ J_B) →+* TensorProduct A₀ A₁ B :=
      Ideal.Quotient.lift J_B inr hinr_ker
    have h_right : ∀ y : B ⧸ J_B, toFun (invFun y) = y := by
      intro y
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
      change toFun ((1 : A₁) ⊗ₜ[A₀] b) = q_B b
      rw [htoFun_tmul, map_one, one_mul]
    have h_left : ∀ z : TensorProduct A₀ A₁ B, invFun (toFun z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul a₁ b =>
        obtain ⟨a₀, rfl⟩ := hπ a₁
        have hsmulA : π a₀ = a₀ • (1 : A₁) :=
          Algebra.algebraMap_eq_smul_one (R := A₀) (A := A₁) a₀
        have htmul : (π a₀) ⊗ₜ[A₀] b = (1 : A₁) ⊗ₜ[A₀] (φ a₀ * b) := by
          calc
            (π a₀) ⊗ₜ[A₀] b = (a₀ • (1 : A₁)) ⊗ₜ[A₀] b := by rw [hsmulA]
            _ = (1 : A₁) ⊗ₜ[A₀] (a₀ • b) := TensorProduct.smul_tmul a₀ 1 b
            _ = (1 : A₁) ⊗ₜ[A₀] (φ a₀ * b) := by rw [Algebra.smul_def]; rfl
        rw [htmul, htoFun_tmul, map_one, one_mul]
