  have hAdjoinInv : ∀ (A : Subring F) (x y : F), x ∈ A → x * y = 1 →
      ∀ z ∈ Subring.closure ((A : Set F) ∪ {y}), ∃ a ∈ A, ∃ m : ℕ, z = a * y ^ m := by
    intro A x y hx hxy
    let S_inv : Subring F :=
      { carrier := {z : F | ∃ a ∈ A, ∃ m : ℕ, z = a * y ^ m}
        mul_mem' := by
          rintro _ _ ⟨a₁, ha₁, m₁, rfl⟩ ⟨a₂, ha₂, m₂, rfl⟩
          refine ⟨a₁ * a₂, A.mul_mem ha₁ ha₂, m₁ + m₂, ?_⟩
          rw [pow_add]
          ring
        one_mem' := ⟨1, A.one_mem, 0, by simp⟩
        add_mem' := by
          rintro _ _ ⟨a₁, ha₁, m₁, rfl⟩ ⟨a₂, ha₂, m₂, rfl⟩
          have hxy_pow : ∀ k : ℕ, x ^ k * y ^ k = 1 := fun k => by
            rw [← mul_pow, hxy, one_pow]
          refine ⟨a₁ * x ^ m₂ + a₂ * x ^ m₁,
            A.add_mem (A.mul_mem ha₁ (A.pow_mem hx m₂)) (A.mul_mem ha₂ (A.pow_mem hx m₁)),
            m₁ + m₂, ?_⟩
          have h1 := hxy_pow m₂
          have h2 := hxy_pow m₁
          calc
            a₁ * y ^ m₁ + a₂ * y ^ m₂
                = a₁ * y ^ m₁ * (x ^ m₂ * y ^ m₂) + a₂ * y ^ m₂ * (x ^ m₁ * y ^ m₁) := by
                  rw [h1, h2, mul_one, mul_one]
            _ = (a₁ * x ^ m₂ + a₂ * x ^ m₁) * y ^ (m₁ + m₂) := by
                  rw [pow_add]
                  ring
        zero_mem' := ⟨0, A.zero_mem, 0, by simp⟩
        neg_mem' := by
          rintro _ ⟨a, ha, m, rfl⟩
          exact ⟨-a, A.neg_mem ha, m, by ring⟩ }
    have hle : Subring.closure ((A : Set F) ∪ {y}) ≤ S_inv := by
      rw [Subring.closure_le]
      rintro z (hz | hz)
      · exact ⟨z, hz, 0, by simp⟩
      · rw [Set.mem_singleton_iff] at hz
        subst z
        exact ⟨1, A.one_mem, 1, by simp⟩
    intro z hz
    exact hle hz

