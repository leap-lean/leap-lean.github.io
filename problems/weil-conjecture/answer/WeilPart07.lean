  obtain ⟨z_sum, hz_coe, hz_psi⟩ := h_scale_coboundary p η hη_mem I
  let S_I := Finset.univ.image I.1
  have hSI : S_I.Nonempty := ⟨I.1 0, Finset.mem_image_of_mem I.1 (Finset.mem_univ 0)⟩
  let diff_B : ↥(B S_I) := z_sum - ⟨(t_loc (I.1 0)) ^ k * ξ I, hξ_mem I⟩
  have hz_psi_eq : ψ_Y S_I hSI z_sum = z_bar I := by
    rw [hz_psi, ← hw_dtw I]
    refine Finset.sum_congr rfl fun q _ => ?_
    congr 2
    let K_q : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K} :=
      ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩
    have hsub_eq : (⟨(t_loc (K_q.1 0)) ^ k * η K_q, hη_mem K_q⟩ : ↥(B (Finset.univ.image K_q.1))) =
        w_B K_q := Subtype.ext (hη_mul K_q)
    change ρ _ (ψ_Y _ _ ⟨(t_loc (K_q.1 0)) ^ k * η K_q, hη_mem K_q⟩) = ρ _ (w_bar K_q)
    rw [hsub_eq, hw_B K_q]
  have hdiff_zero : ψ_Y S_I hSI diff_B = 0 := by
    dsimp only [diff_B]
    rw [map_sub, hz_psi_eq]
    exact sub_self (z_bar I)
  obtain ⟨π_I, b_I, hπ_I, hb_I, hdiff_eq⟩ := ((hψ_surj_ker S_I hSI).2 diff_B).mp hdiff_zero
  refine ⟨π_I, b_I, hπ_I, hb_I, ?_⟩
  have hcoe_diff : (diff_B : F) =
      (t_loc (I.1 0)) ^ k *
        ((∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
          η ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) - ξ I) := by
    change (z_sum : F) - ((t_loc (I.1 0)) ^ k * ξ I) = _
    rw [hz_coe, mul_sub]
  rw [← hcoe_diff]
  exact hdiff_eq

theorem weil_closed_fiber_polar_cech_acyclicity_and_cocycle (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_semi)
    (r_pts k₁ : ℕ)
    (σ_bar : Fin (r_pts + 1) →
      (AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥V).ResidueField) ⟶
        CategoryTheory.Limits.pullback g_semi
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (π_bar : CategoryTheory.Limits.pullback g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))) ⟶
      (weilProjectiveSpaceOver (IsLocalRing.maximalIdeal ↥V).ResidueField 1).left)
    (hPolar : IsClosedFiberPolarProjLineMap (IsLocalRing.maximalIdeal ↥V).ResidueField
      (CategoryTheory.Limits.pullback.snd g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
      r_pts k₁ σ_bar π_bar)
    (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (W_div : Fin (r_pts + 1) → C_semi.Opens)
    (t_div : ∀ i : Fin (r_pts + 1), ↑(C_semi.presheaf.obj (Opposite.op (W_div i))))
    (hCompat : ∀ i : Fin (r_pts + 1),
      σ_bar i ≫ CategoryTheory.Limits.pullback.fst g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)) ≫ γ_div i)
    (hLift : IsLiftedSmoothDivisorSystem V g_semi r_pts γ_div W_div t_div)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (W : Fin (N + 1) → C_semi.Opens)
    (tag : Fin (N + 1) → Option (Fin (r_pts + 1)))
    (B : Finset (Fin (N + 1)) → Subring F)
    (t_loc : Fin (N + 1) → F)
    (φ_cov : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      ↑(C_semi.presheaf.obj (Opposite.op (Finset.inf S W))) ≃+* ↥(B S))
    (hCov : IsDivisorAdaptedSubringCover V g_semi r_pts γ_div W_div t_div F φ_VF
      N W tag B t_loc φ_cov) :
    ∃ (m₀ : ℕ) (x_bar : Fin (N + 1) → F)
      (hx_mem : ∀ a : Fin (N + 1), x_bar a ∈ B {a}),
      1 ≤ m₀ * k₁ ∧
      (∀ a b : Fin (N + 1),
        ∃ (π_ab : ↥V) (w_ab : F),
          π_ab ∈ IsLocalRing.maximalIdeal ↥V ∧
          w_ab ∈ B {a, b} ∧
          x_bar b * (t_loc a / t_loc b) ^ (m₀ * k₁) - x_bar a = φ_VF π_ab * w_ab) ∧
      (∀ (i : Fin (r_pts + 1)) (a : Fin (N + 1)),
        tag a = some i →
        ∀ h_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
            (TopologicalSpace.Opens.map (γ_div i).base).obj (Finset.inf {a} W),
          IsUnit
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom.hom
              (((γ_div i).appLE (Finset.inf {a} W) ⊤ h_top).hom
                ((φ_cov {a} (Finset.singleton_nonempty a)).symm ⟨x_bar a, hx_mem a⟩)))) ∧
      (∀ (p : ℕ) (ξ : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I} → F),
        (∀ I, (t_loc (I.1 0)) ^ (m₀ * k₁) * ξ I ∈ B (Finset.univ.image I.1)) →
        (∀ J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J},
          ∃ (π_J : ↥V) (b_J : F),
            π_J ∈ IsLocalRing.maximalIdeal ↥V ∧
            b_J ∈ B (Finset.univ.image J.1) ∧
            (t_loc (J.1 0)) ^ (m₀ * k₁) *
              (∑ q : Fin (p + 3), (-1 : F) ^ (q : ℕ) *
                ξ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩) =
              φ_VF π_J * b_J) →
        ∃ η : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F,
          (∀ I, (t_loc (I.1 0)) ^ (m₀ * k₁) * η I ∈ B (Finset.univ.image I.1)) ∧
          ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
            ∃ (π_I : ↥V) (b_I : F),
              π_I ∈ IsLocalRing.maximalIdeal ↥V ∧
              b_I ∈ B (Finset.univ.image I.1) ∧
              (t_loc (I.1 0)) ^ (m₀ * k₁) *
                ((∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
                  η ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) - ξ I) =
                φ_VF π_I * b_I) :=
by
  have hSep : AlgebraicGeometry.IsSeparated g_semi := hSS.2.2.1
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let Y : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g_semi s₀
  let fst : Y ⟶ C_semi := CategoryTheory.Limits.pullback.fst g_semi s₀
  let p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
    CategoryTheory.Limits.pullback.snd g_semi s₀
  obtain ⟨hAff_P, _c_proj, _t_proj, hCoord_P, _⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg
  have hP1_cov :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsAffineOpen
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 0)) ∧
      AlgebraicGeometry.IsAffineOpen
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 1)) ∧
      AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 0) ⊔
        AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 1) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) :=
      MvPolynomial.gradedAlgebra
    refine ⟨hAff_P k₀ 1 0, hAff_P k₀ 1 1, ?_⟩
    apply le_antisymm le_top
    have hsup : (⨆ a : Fin (1 + 1),
        AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X a)) = ⊤ :=
      (hCoord_P k₀ 1).2.1
    rw [← hsup]
    refine iSup_le fun a => ?_
    fin_cases a
    · exact le_sup_left
    · exact le_sup_right
  obtain ⟨hAffInter, hAffSurjKer, hPreRange, hUnitBridge, hDiv_Y⟩ :=
    weil_closed_fiber_pullback_affine_bezout_and_divisor_reduction K V C_semi g_semi hSep
      r_pts σ_bar γ_div W_div t_div hCompat hLift
  obtain ⟨_hInjVF, hSupW, hCov_aff, hCov_mono, ht_mem, ht_ratio, hCov_tag, _hCov_div⟩ := hCov
  have hY_map_comp : ∀ {U₁ U₂ U₃ : Y.Opens} (h₁ : U₂ ≤ U₁) (h₂ : U₃ ≤ U₂)
      (x : ↑(Y.presheaf.obj (Opposite.op U₁))),
      (Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom
        ((Y.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x) =
      (Y.presheaf.map (CategoryTheory.homOfLE (h₂.trans h₁)).op).hom x := by
    intro U₁ U₂ U₃ h₁ h₂ x
    have hop : (CategoryTheory.homOfLE h₁).op ≫ (CategoryTheory.homOfLE h₂).op =
        (CategoryTheory.homOfLE (h₂.trans h₁)).op :=
      congrArg Quiver.Hom.op
        (Subsingleton.elim
          (CategoryTheory.homOfLE h₂ ≫ CategoryTheory.homOfLE h₁)
          (CategoryTheory.homOfLE (h₂.trans h₁)))
    change (Y.presheaf.map (CategoryTheory.homOfLE h₁).op ≫
      Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom x = _
    rw [← CategoryTheory.Functor.map_comp, hop]
  have hY_map_id : ∀ {U₁ : Y.Opens} (h₁ : U₁ ≤ U₁)
      (x : ↑(Y.presheaf.obj (Opposite.op U₁))),
      (Y.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x = x := by
    intro U₁ h₁ x
    have hid : (CategoryTheory.homOfLE h₁).op = 𝟙 (Opposite.op U₁) :=
      congrArg Quiver.Hom.op (Subsingleton.elim (CategoryTheory.homOfLE h₁) (𝟙 U₁))
    rw [hid, CategoryTheory.Functor.map_id]
    rfl
  have hC_map_comp : ∀ {U₁ U₂ U₃ : C_semi.Opens} (h₁ : U₂ ≤ U₁) (h₂ : U₃ ≤ U₂)
      (x : ↑(C_semi.presheaf.obj (Opposite.op U₁))),
      (C_semi.presheaf.map (CategoryTheory.homOfLE h₂).op).hom
        ((C_semi.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x) =
      (C_semi.presheaf.map (CategoryTheory.homOfLE (h₂.trans h₁)).op).hom x := by
    intro U₁ U₂ U₃ h₁ h₂ x
    have hop : (CategoryTheory.homOfLE h₁).op ≫ (CategoryTheory.homOfLE h₂).op =
        (CategoryTheory.homOfLE (h₂.trans h₁)).op :=
      congrArg Quiver.Hom.op
        (Subsingleton.elim
          (CategoryTheory.homOfLE h₂ ≫ CategoryTheory.homOfLE h₁)
          (CategoryTheory.homOfLE (h₂.trans h₁)))
    change (C_semi.presheaf.map (CategoryTheory.homOfLE h₁).op ≫
      C_semi.presheaf.map (CategoryTheory.homOfLE h₂).op).hom x = _
    rw [← CategoryTheory.Functor.map_comp, hop]
  have hfst_nat : ∀ {U U' : C_semi.Opens} (h : U' ≤ U)
      (s : ↑(C_semi.presheaf.obj (Opposite.op U))),
      (fst.app U').hom ((C_semi.presheaf.map (CategoryTheory.homOfLE h).op).hom s) =
      (Y.presheaf.map
        (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map fst.base).monotone h)).op).hom
        ((fst.app U).hom s) := by
    intro U U' h s
    have hnat := AlgebraicGeometry.Scheme.Hom.naturality fst (CategoryTheory.homOfLE h).op
    have hsub : (TopologicalSpace.Opens.map fst.base).map (CategoryTheory.homOfLE h) =
        CategoryTheory.homOfLE ((TopologicalSpace.Opens.map fst.base).monotone h) :=
      Subsingleton.elim _ _
    have happ := congrArg (fun φ => φ.hom s) hnat
    simpa [hsub] using happ
  let W_Y : Fin (N + 1) → Y.Opens :=
    fun a => (TopologicalSpace.Opens.map fst.base).obj (W a)
  have heq_inf : ∀ S : Finset (Fin (N + 1)),
      (TopologicalSpace.Opens.map fst.base).obj (Finset.inf S W) = Finset.inf S W_Y := by
    intro S
    induction S using Finset.induction_on with
    | empty => rfl
    | @insert a S' _ ih =>
      rw [Finset.inf_insert, Finset.inf_insert, ← ih]
      rfl
  have hWY_cov : (⨆ a : Fin (N + 1), W_Y a) = ⊤ ∧
      ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (W_Y a) := by
    refine ⟨?_, ?_⟩
    · apply le_antisymm le_top
      intro y _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hy : fst.base y ∈ (⨆ a : Fin (N + 1), W a) := by
        rw [hSupW]
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hy
      exact hy
    · intro a
      have hAff_a : AlgebraicGeometry.IsAffineOpen (W a) := by
        have h := (hCov_aff {a} (Finset.singleton_nonempty a)).1
        rwa [Finset.inf_singleton] at h
      exact (hAffSurjKer (W a) hAff_a).1
  have hB_mono : ∀ S S' : Finset (Fin (N + 1)), S.Nonempty → S ⊆ S' → B S ≤ B S' := by
    intro S S' hS hsub
    exact (hCov_mono S S' hS (hS.mono hsub) hsub).1
  let ψ_Y : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      ↥(B S) →+* ↑(Y.presheaf.obj (Opposite.op (Finset.inf S W_Y))) :=
    fun S hS =>
      ((Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq (heq_inf S).symm)).op).hom.comp
        (fst.app (Finset.inf S W)).hom).comp (φ_cov S hS).symm.toRingHom
  have hψ_surj_ker : ∀ (S : Finset (Fin (N + 1))) (hS : S.Nonempty),
      Function.Surjective (ψ_Y S hS) ∧
      ∀ z : ↥(B S),
        ψ_Y S hS z = 0 ↔
          ∃ (π : ↥V) (b : F),
            π ∈ IsLocalRing.maximalIdeal ↥V ∧ b ∈ B S ∧ (z : F) = φ_VF π * b := by
    intro S hS
    have hAff_S : AlgebraicGeometry.IsAffineOpen (Finset.inf S W) := (hCov_aff S hS).1
    obtain ⟨_, hSurj_S, hKer_S⟩ := hAffSurjKer (Finset.inf S W) hAff_S
    refine ⟨?_, ?_⟩
    · intro y
      obtain ⟨s, hs⟩ := hSurj_S
        ((Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq (heq_inf S))).op).hom y)
      refine ⟨(φ_cov S hS) s, ?_⟩
      dsimp [ψ_Y]
      rw [(φ_cov S hS).symm_apply_apply, hs, hY_map_comp, hY_map_id]
    · intro z
      constructor
      · intro hz
        have h0 : (fst.app (Finset.inf S W)).hom ((φ_cov S hS).symm z) = 0 := by
          have h1 := congrArg
            ((Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq (heq_inf S))).op).hom) hz
          rw [map_zero] at h1
          dsimp [ψ_Y] at h1
          rwa [hY_map_comp, hY_map_id] at h1
        obtain ⟨π, w, hπ, hw⟩ := (hKer_S ((φ_cov S hS).symm z)).mp h0
        refine ⟨π, ((φ_cov S hS) w : F), hπ, ((φ_cov S hS) w).2, ?_⟩
        have hz_eq := congrArg (fun t => ((φ_cov S hS) t : F)) hw
        rw [(φ_cov S hS).apply_symm_apply, map_mul, Subring.coe_mul,
          (hCov_aff S hS).2.2 π] at hz_eq
        exact hz_eq
      · rintro ⟨π, b, hπ, hb, hzb⟩
        have hw : (φ_cov S hS).symm z =
            (g_semi.appTop ≫ C_semi.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom π) *
              (φ_cov S hS).symm ⟨b, hb⟩ := by
          apply (φ_cov S hS).injective
          apply Subtype.ext
          rw [(φ_cov S hS).apply_symm_apply, map_mul, Subring.coe_mul,
            (hCov_aff S hS).2.2 π, (φ_cov S hS).apply_symm_apply]
          exact hzb
        have h0 : (fst.app (Finset.inf S W)).hom ((φ_cov S hS).symm z) = 0 :=
          (hKer_S ((φ_cov S hS).symm z)).mpr ⟨π, (φ_cov S hS).symm ⟨b, hb⟩, hπ, hw⟩
        dsimp [ψ_Y]
        rw [h0, map_zero]
  have hψ_res : ∀ (S S' : Finset (Fin (N + 1))) (hS : S.Nonempty) (hS' : S'.Nonempty)
      (hsub : S ⊆ S') (z : ↥(B S)),
      (Y.presheaf.map (CategoryTheory.homOfLE (Finset.inf_mono hsub)).op).hom (ψ_Y S hS z) =
        ψ_Y S' hS' ⟨(z : F), hB_mono S S' hS hsub z.2⟩ := by
    intro S S' hS hS' hsub z
    have hsymm : (φ_cov S' hS').symm ⟨(z : F), hB_mono S S' hS hsub z.2⟩ =
        (C_semi.presheaf.map (CategoryTheory.homOfLE (Finset.inf_mono hsub)).op).hom
          ((φ_cov S hS).symm z) := by
      apply (φ_cov S' hS').injective
      apply Subtype.ext
      rw [(φ_cov S' hS').apply_symm_apply,
        (hCov_mono S S' hS hS' hsub).2 ((φ_cov S hS).symm z),
        (φ_cov S hS).apply_symm_apply]
    dsimp [ψ_Y]
    rw [hsymm, hfst_nat (Finset.inf_mono hsub), hY_map_comp, hY_map_comp]
  let W_Y_div : Fin (r_pts + 1) → Y.Opens :=
    fun i => (TopologicalSpace.Opens.map fst.base).obj (W_div i)
  let t_Y_div : ∀ i : Fin (r_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y_div i))) :=
    fun i => (fst.app (W_div i)).hom (t_div i)
  have hW_div_aff : ∀ i : Fin (r_pts + 1), AlgebraicGeometry.IsAffineOpen (W_Y_div i) :=
    fun i => (hAffSurjKer (W_div i) (hLift.1 i).2.2.1).1
  let t_Y_loc : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y a))) :=
    fun a =>
      (Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq Finset.inf_singleton.symm)).op).hom
        (ψ_Y {a} (Finset.singleton_nonempty a) ⟨t_loc a, (ht_mem a).1⟩)
  have heq_pair : ∀ a b : Fin (N + 1), Finset.inf {a, b} W_Y = W_Y a ⊓ W_Y b := by
    intro a b
    rw [Finset.inf_insert, Finset.inf_singleton]
  let u_Y_ab : ∀ a b : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y a ⊓ W_Y b))) :=
    fun a b =>
      (Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq (heq_pair a b).symm)).op).hom
        (ψ_Y {a, b} (Finset.insert_nonempty a {b})
          ⟨t_loc a / t_loc b,
            ht_ratio {a, b} (Finset.insert_nonempty a {b})
              a (Finset.mem_insert_self a {b})
              b (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))⟩)
  have hTag_none : ∀ a : Fin (N + 1),
      tag a = none →
      Disjoint (W_Y a : Set ↥Y) (⋃ i : Fin (r_pts + 1), Set.range (σ_bar i).base) ∧
      t_Y_loc a = 1 := by
    intro a hnone
    obtain ⟨hDisj_W, ht1⟩ := (hCov_tag a).1 hnone
    refine ⟨?_, ?_⟩
    · rw [Set.disjoint_left] at hDisj_W ⊢
      intro y hy hmem
      rw [Set.mem_iUnion] at hmem
      obtain ⟨i, hi⟩ := hmem
      rw [← hPreRange i] at hi
      exact hDisj_W hy (Set.mem_iUnion.mpr ⟨i, hi⟩)
    · have hsub1 : (⟨t_loc a, (ht_mem a).1⟩ : ↥(B {a})) = 1 := Subtype.ext ht1
      dsimp [t_Y_loc]
      rw [hsub1, map_one, map_one]
  have hTag_some : ∀ (a : Fin (N + 1)) (i : Fin (r_pts + 1)),
      tag a = some i →
      ∃ h_le : W_Y a ≤ W_Y_div i,
