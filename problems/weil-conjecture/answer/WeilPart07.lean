        · exact Set.mem_union_left _ hz
        · exact Set.mem_union_right _ (Set.mem_union_left _ hz)
        · exact Set.mem_union_right _ (Set.mem_union_right _ hz)
      refine hPowClear A ({s₁} ∪ Set.range gen₁) (h_t j) (hh_tA j) ?_ v (hD₁_sub hv)
      rintro g (hg | ⟨ν, rfl⟩)
      · rw [Set.mem_singleton_iff] at hg; subst g; exact (hh_clr j).1
      · exact (hh_clr j).2 ν
    refine ⟨?_, ?_⟩
    · intro x hx0 hx1
      choose m₀ hm₀ using hD₀_clr x hx0
      choose m₁ hm₁ using hD₁_clr x hx1
      let M : ℕ := max (Finset.univ.sup m₀) (Finset.univ.sup m₁)
      obtain ⟨R, α_t, γ_t, hα_t, hγ_t, hR_eq⟩ := hW_pow M
      refine ⟨R, ?_⟩
      rw [hR_eq, add_mul, Finset.sum_mul, Finset.sum_mul]
      apply A.add_mem
      · apply A.sum_mem
        intro i _
        have hi_le : m₀ i ≤ M := le_trans (Finset.le_sup (Finset.mem_univ i)) (le_max_left _ _)
        have hsplit : M = (M - m₀ i) + m₀ i := (Nat.sub_add_cancel hi_le).symm
        have hfx : α_t i * (f_t i) ^ M * x =
            α_t i * (f_t i) ^ (M - m₀ i) * ((f_t i) ^ (m₀ i) * x) := by
          conv_lhs => rw [hsplit, pow_add]
          ring
        rw [hfx]
        exact A.mul_mem (A.mul_mem (hα_t i) (A.pow_mem (hf_tA i) _)) (hm₀ i)
      · apply A.sum_mem
        intro j _
        have hj_le : m₁ j ≤ M := le_trans (Finset.le_sup (Finset.mem_univ j)) (le_max_right _ _)
        have hsplit : M = (M - m₁ j) + m₁ j := (Nat.sub_add_cancel hj_le).symm
        have hhx : γ_t j * (h_t j) ^ M * x =
            γ_t j * (h_t j) ^ (M - m₁ j) * ((h_t j) ^ (m₁ j) * x) := by
          conv_lhs => rw [hsplit, pow_add]
          ring
        rw [hhx]
        exact A.mul_mem (A.mul_mem (hγ_t j) (A.pow_mem (hh_tA j) _)) (hm₁ j)
    · intro z hz
      have ht₀_D₀ : t₀ ∈ D₀ :=
        Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _ rfl))
      have hs₁_D₁ : s₁ ∈ D₁ :=
        Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _ rfl))
      have hA_D₀ : A ≤ D₀ := fun a ha =>
        Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ ha))
      have hA_D₁ : A ≤ D₁ := fun a ha =>
        Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ ha))
      obtain ⟨w, hw_D₀, d, rfl⟩ := hAdjoinInv D₀ t₀ s₁ ht₀_D₀ hts z hz
      choose m₀ hm₀ using hD₀_clr w hw_D₀
      let M : ℕ := max (Finset.univ.sup m₀) d
      obtain ⟨R, α_t, γ_t, hα_t, hγ_t, hR_eq⟩ := hW_pow M
      have hf_z : ∀ i : Fin r₀, (f_t i) ^ M * (w * s₁ ^ d) ∈ D₁ := by
        intro i
        have hi_le : m₀ i ≤ M := le_trans (Finset.le_sup (Finset.mem_univ i)) (le_max_left _ _)
        have hsplit : M = (M - m₀ i) + m₀ i := (Nat.sub_add_cancel hi_le).symm
        have hfw : (f_t i) ^ M * w ∈ A := by
          have heq : (f_t i) ^ M * w = (f_t i) ^ (M - m₀ i) * ((f_t i) ^ (m₀ i) * w) := by
            conv_lhs => rw [hsplit, pow_add]
            ring
          rw [heq]
          exact A.mul_mem (A.pow_mem (hf_tA i) _) (hm₀ i)
        have hassoc : (f_t i) ^ M * (w * s₁ ^ d) = ((f_t i) ^ M * w) * s₁ ^ d := by ring
        rw [hassoc]
        exact D₁.mul_mem (hA_D₁ hfw) (D₁.pow_mem hs₁_D₁ d)
      have hh_z : ∀ j : Fin r₁, (h_t j) ^ M * (w * s₁ ^ d) ∈ D₀ := by
        intro j
        have hd_le : d ≤ M := le_max_right _ _
        have hsplit : M = (M - d) + d := (Nat.sub_add_cancel hd_le).symm
        have hhs : (h_t j) ^ M * s₁ ^ d ∈ A := by
          have heq : (h_t j) ^ M * s₁ ^ d = (h_t j) ^ (M - d) * (h_t j * s₁) ^ d := by
            conv_lhs => rw [hsplit, pow_add]
            rw [mul_pow]
            ring
          rw [heq]
          exact A.mul_mem (A.pow_mem (hh_tA j) _) (A.pow_mem (hh_clr j).1 d)
        have hassoc : (h_t j) ^ M * (w * s₁ ^ d) = w * ((h_t j) ^ M * s₁ ^ d) := by ring
        rw [hassoc]
        exact D₀.mul_mem hw_D₀ (hA_D₀ hhs)
      refine ⟨R,
        ∑ j : Fin r₁, γ_t j * ((h_t j) ^ M * (w * s₁ ^ d)),
        - ∑ i : Fin r₀, α_t i * ((f_t i) ^ M * (w * s₁ ^ d)),
        D₀.sum_mem fun j _ => D₀.mul_mem (hA_D₀ (hγ_t j)) (hh_z j),
        D₁.neg_mem (D₁.sum_mem fun i _ => D₁.mul_mem (hA_D₁ (hα_t i)) (hf_z i)),
        ?_⟩
      rw [hR_eq, add_mul, Finset.sum_mul, Finset.sum_mul]
      simp only [mul_assoc]
      ring

  
  
  
  have hShiftedCokernel : ∀ (R : Type u) [CommRing R] (ψ : R →+* F)
      (Y : Finset F) (B_a : Subring F),
      B_a = Subring.closure (Set.range ψ ∪ (Y : Set F)) →
      ∀ (r : ℕ) (c : Fin r → ↥Y → R) (W : AddSubgroup F),
      (∀ b ∈ B_a, ∀ w ∈ W, b * w ∈ W) →
      ∀ (ι : Type) [Fintype ι] (e : ι → F),
      (∀ (i : ι) (y_vec : Fin r → ↥Y),
        ∃ m : ℕ, (∏ j : Fin r, ((y_vec j : F) - ψ (c j (y_vec j)))) ^ m * e i ∈ W) →
      ∃ G_Q : Finset F,
        (∀ g ∈ G_Q, ∃ b ∈ B_a, ∃ i : ι, g = b * e i) ∧
        ∀ b : ι → F, (∀ i : ι, b i ∈ B_a) →
          ∃ w ∈ W, ∃ coeff : ↥G_Q → R,
            (∑ i : ι, b i * e i) = w + ∑ g : ↥G_Q, ψ (coeff g) * (g : F) := by
    intro R _ ψ Y B_a hBa r c W hW_mul ι _ e hAnn
    rcases Nat.eq_zero_or_pos r with rfl | hr
    · have he_W : ∀ i : ι, e i ∈ W := by
        intro i
        obtain ⟨m, hm⟩ := hAnn i Fin.elim0
        simpa using hm
      refine ⟨∅, by simp, fun b hb =>
        ⟨∑ i : ι, b i * e i,
          W.sum_mem fun i _ => hW_mul (b i) (hb i) (e i) (he_W i),
          fun g => False.elim (Finset.notMem_empty g.1 g.2),
          by simp⟩⟩
    · have hψ_Ba : ∀ x : R, ψ x ∈ B_a := fun x => by
        rw [hBa]; exact Subring.subset_closure (Set.mem_union_left _ ⟨x, rfl⟩)
      have hY_Ba : ∀ y : ↥Y, (y : F) ∈ B_a := fun y => by
        rw [hBa]; exact Subring.subset_closure (Set.mem_union_right _ y.2)
      let δ : Fin r → ↥Y → F := fun j y => (y : F) - ψ (c j y)
      have hδ_Ba : ∀ j y, δ j y ∈ B_a := fun j y => B_a.sub_mem (hY_Ba y) (hψ_Ba (c j y))
      let u_prod : (Fin r → ↥Y) → F := fun w_vec => ∏ j : Fin r, δ j (w_vec j)
      have hu_Ba : ∀ w_vec, u_prod w_vec ∈ B_a :=
        fun w_vec => B_a.prod_mem fun j _ => hδ_Ba j (w_vec j)
      choose m₀ hm₀ using hAnn
      let m_star : ℕ := (Finset.univ : Finset (ι × (Fin r → ↥Y))).sup (fun p => m₀ p.1 p.2)
      let L : ℕ := Fintype.card (Fin r → ↥Y)
      let M : ℕ := L * m_star + 1
      have hM_pos : 0 < M := Nat.succ_pos _
      let K : ℕ := M * r
      have hK_pos : 0 < K := Nat.mul_pos hM_pos hr
      let Φ : Fin K → Fin r := fun n => (finProdFinEquiv.symm n).2
      let Δ_Φ : (Fin K → ↥Y) → F := fun y_tup => ∏ n : Fin K, δ (Φ n) (y_tup n)
      let J : AddSubgroup F :=
        { carrier := {x : F | x ∈ B_a ∧ ∀ i : ι, x * e i ∈ W}
          add_mem' := fun ha hb =>
            ⟨B_a.add_mem ha.1 hb.1, fun i => by rw [add_mul]; exact W.add_mem (ha.2 i) (hb.2 i)⟩
          zero_mem' := ⟨B_a.zero_mem, fun _ => by simp⟩
          neg_mem' := fun ha =>
            ⟨B_a.neg_mem ha.1, fun i => by rw [neg_mul]; exact W.neg_mem (ha.2 i)⟩ }
      have hJ_mul : ∀ b ∈ B_a, ∀ x ∈ J, b * x ∈ J := fun b hb x hx =>
        ⟨B_a.mul_mem hb hx.1, fun i => by rw [mul_assoc]; exact hW_mul b hb (x * e i) (hx.2 i)⟩
      have hΔ_J : ∀ y_tup : Fin K → ↥Y, Δ_Φ y_tup ∈ J := by
        intro y_tup
        refine ⟨B_a.prod_mem fun n _ => hδ_Ba (Φ n) (y_tup n), fun i => ?_⟩
        let g_blk : Fin M → (Fin r → ↥Y) := fun q j => y_tup (finProdFinEquiv (q, j))
        have hΔ_eq : Δ_Φ y_tup = ∏ q : Fin M, u_prod (g_blk q) := by
          dsimp [Δ_Φ, u_prod, g_blk, Φ]
          rw [← Equiv.prod_comp finProdFinEquiv (fun n => δ (finProdFinEquiv.symm n).2 (y_tup n))]
          rw [Fintype.prod_prod_type]
          refine Finset.prod_congr rfl fun q _ => Finset.prod_congr rfl fun j _ => ?_
          rw [Equiv.symm_apply_apply]
        have hcard_lt : Fintype.card (Fin r → ↥Y) * m_star < Fintype.card (Fin M) := by
          rw [Fintype.card_fin]
          exact Nat.lt_succ_self (L * m_star)
        obtain ⟨w₀, hw₀_card⟩ := Fintype.exists_lt_card_fiber_of_mul_lt_card g_blk hcard_lt
        let S₀ : Finset (Fin M) := Finset.univ.filter (fun q : Fin M => g_blk q = w₀)
        have hm_le_star : m₀ i w₀ ≤ m_star :=
          Finset.le_sup (f := fun p : ι × (Fin r → ↥Y) => m₀ p.1 p.2) (Finset.mem_univ (i, w₀))
        have hm_le_S₀ : m₀ i w₀ ≤ S₀.card := le_of_lt (lt_of_le_of_lt hm_le_star hw₀_card)
        have hprod_S₀ : ∏ q ∈ S₀, u_prod (g_blk q) = (u_prod w₀) ^ S₀.card := by
          calc
            ∏ q ∈ S₀, u_prod (g_blk q) = ∏ _q ∈ S₀, u_prod w₀ :=
              Finset.prod_congr rfl fun q hq => by rw [(Finset.mem_filter.mp hq).2]
            _ = (u_prod w₀) ^ S₀.card := Finset.prod_const (u_prod w₀)
        have hsplit_card : S₀.card = (S₀.card - m₀ i w₀) + m₀ i w₀ :=
          (Nat.sub_add_cancel hm_le_S₀).symm
        let rem_prod : F := ∏ q ∈ Finset.univ.filter (fun q : Fin M => ¬ g_blk q = w₀),
          u_prod (g_blk q)
        have hrem_Ba : rem_prod ∈ B_a := B_a.prod_mem fun q _ => hu_Ba (g_blk q)
        have hΔ_fac : Δ_Φ y_tup =
            ((u_prod w₀) ^ (S₀.card - m₀ i w₀) * rem_prod) * (u_prod w₀) ^ (m₀ i w₀) := by
          rw [hΔ_eq,
            ← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun q : Fin M => g_blk q = w₀)
              (fun q => u_prod (g_blk q))]
          change (∏ q ∈ S₀, u_prod (g_blk q)) * rem_prod = _
          rw [hprod_S₀]
          conv_lhs => rw [hsplit_card, pow_add]
          ring
        rw [hΔ_fac, mul_assoc]
        exact hW_mul _ (B_a.mul_mem (B_a.pow_mem (hu_Ba w₀) _) hrem_Ba) _ (hm₀ i w₀)
      let monList : List ↥Y → F := fun l => (l.map Subtype.val).prod
      have hmon_append : ∀ l₁ l₂ : List ↥Y, monList (l₁ ++ l₂) = monList l₁ * monList l₂ :=
        fun l₁ l₂ => by simp [monList, List.prod_append]
      have hmon_Ba : ∀ l : List ↥Y, monList l ∈ B_a := fun l => by
        induction l with
        | nil => simp [monList]
        | cons y tl ih => simpa [monList] using B_a.mul_mem (hY_Ba y) ih
      let evalTerms : List (R × List ↥Y) → F :=
        fun terms => (terms.map (fun p => ψ p.1 * monList p.2)).sum
      have heval_append : ∀ t₁ t₂, evalTerms (t₁ ++ t₂) = evalTerms t₁ + evalTerms t₂ :=
        fun t₁ t₂ => by simp [evalTerms, List.sum_append]
      let scaleTerms : R → List (R × List ↥Y) → List (R × List ↥Y) :=
        fun r₀ terms => terms.map (fun p => (r₀ * p.1, p.2))
      have heval_scale : ∀ r₀ terms, evalTerms (scaleTerms r₀ terms) = ψ r₀ * evalTerms terms := by
        intro r₀ terms
        induction terms with
        | nil => simp [evalTerms, scaleTerms]
        | cons hd tl ih =>
          simp only [scaleTerms, evalTerms, List.map_cons, List.sum_cons, map_mul] at ih ⊢
          rw [ih]
          ring
      let appendRight : List ↥Y → List (R × List ↥Y) → List (R × List ↥Y) :=
        fun l_r terms => terms.map (fun p => (p.1, p.2 ++ l_r))
      have heval_appR : ∀ l_r terms,
          evalTerms (appendRight l_r terms) = evalTerms terms * monList l_r := by
        intro l_r terms
        induction terms with
        | nil => simp [evalTerms, appendRight]
        | cons hd tl ih =>
          simp only [appendRight, evalTerms, List.map_cons, List.sum_cons] at ih ⊢
          rw [hmon_append, ih]
          ring
      have hBinomDiff : ∀ (k : ℕ) (χ : Fin k → Fin r) (v : Fin k → ↥Y),
          ∃ terms : List (R × List ↥Y),
            (∀ p ∈ terms, p.2.length < k) ∧
            (∏ t : Fin k, (v t : F)) - (∏ t : Fin k, δ (χ t) (v t)) = evalTerms terms := by
        intro k
        induction k with
        | zero =>
          intro _ _
          exact ⟨[], by simp, by simp [evalTerms]⟩
        | succ k ih =>
          intro χ v
          obtain ⟨terms₀, hlen₀, heq₀⟩ := ih (fun t => χ t.castSucc) (fun t => v t.castSucc)
          let P_val : F := ∏ t : Fin k, (v t.castSucc : F)
          let D_val : F := ∏ t : Fin k, δ (χ t.castSucc) (v t.castSucc)
          let y_k : ↥Y := v (Fin.last k)
          let r_k : R := c (χ (Fin.last k)) y_k
          let l_P : List ↥Y := List.ofFn (fun t : Fin k => v t.castSucc)
          have hmon_lP : monList l_P = P_val := by
            dsimp [monList, l_P, P_val]
            rw [List.map_ofFn, List.prod_ofFn]
            rfl
          have hlen_lP : l_P.length = k := List.length_ofFn
          refine ⟨appendRight [y_k] terms₀ ++ [(r_k, l_P)] ++ scaleTerms (-r_k) terms₀, ?_, ?_⟩
          · intro p hp
            simp only [List.mem_append, List.mem_singleton, appendRight, scaleTerms,
              List.mem_map] at hp
            rcases hp with (⟨q, hq, rfl⟩ | rfl) | ⟨q, hq, rfl⟩
            · have hql := hlen₀ q hq
              simp only [List.length_append, List.length_singleton]
              omega
            · simp [hlen_lP]
            · exact Nat.lt_succ_of_lt (hlen₀ q hq)
          · rw [Fin.prod_univ_castSucc, Fin.prod_univ_castSucc]
            change P_val * (y_k : F) - D_val * δ (χ (Fin.last k)) y_k = _
            have hPD : evalTerms terms₀ = P_val - D_val := heq₀.symm
            rw [heval_append, heval_append, heval_appR, heval_scale, hPD]
            have hev_mid : evalTerms [(r_k, l_P)] = ψ r_k * P_val := by
              simp [evalTerms, hmon_lP]
            have hmon_yk : monList [y_k] = (y_k : F) := by simp [monList]
            rw [hev_mid, hmon_yk, map_neg]
            dsimp [δ, r_k]
            ring
      let M_lt_K : Finset F :=
        (Finset.range K).biUnion (fun d =>
          Finset.univ.image (fun v : Fin d → ↥Y => ∏ t : Fin d, (v t : F)))
      have hM_lt_Ba : ∀ m ∈ M_lt_K, m ∈ B_a := by
        intro m hm
        rcases Finset.mem_biUnion.mp hm with ⟨d, _, hm_img⟩
        rcases Finset.mem_image.mp hm_img with ⟨v, _, rfl⟩
        exact B_a.prod_mem fun t _ => hY_Ba (v t)
      have hmon_in_M : ∀ l : List ↥Y, l.length < K → monList l ∈ M_lt_K := by
        intro l hl
        refine Finset.mem_biUnion.mpr ⟨l.length, Finset.mem_range.mpr hl, ?_⟩
        refine Finset.mem_image.mpr ⟨fun t => l[t.1], Finset.mem_univ _, ?_⟩
        exact Fin.prod_univ_fun_getElem l Subtype.val
      let S_good_set : Set F :=
        {x : F | x ∈ B_a ∧ ∃ coeff : ↥M_lt_K → R, ∃ j ∈ J,
          x = (∑ m : ↥M_lt_K, ψ (coeff m) * (m : F)) + j}
      have hSg_zero : (0 : F) ∈ S_good_set :=
        ⟨B_a.zero_mem, fun _ => 0, 0, J.zero_mem, by simp⟩
      have hSg_J : ∀ j ∈ J, j ∈ S_good_set := fun j hj =>
        ⟨hj.1, fun _ => 0, j, hj, by simp⟩
      have hSg_add : ∀ {x₁ x₂ : F}, x₁ ∈ S_good_set → x₂ ∈ S_good_set → x₁ + x₂ ∈ S_good_set := by
        rintro x₁ x₂ ⟨hb₁, c₁, j₁, hj₁, rfl⟩ ⟨hb₂, c₂, j₂, hj₂, rfl⟩
        refine ⟨B_a.add_mem hb₁ hb₂, fun m => c₁ m + c₂ m, j₁ + j₂, J.add_mem hj₁ hj₂, ?_⟩
        simp only [map_add, add_mul, Finset.sum_add_distrib]
        ring
      have hSg_neg : ∀ {x : F}, x ∈ S_good_set → -x ∈ S_good_set := by
        rintro x ⟨hb, c₀, j₀, hj₀, rfl⟩
        refine ⟨B_a.neg_mem hb, fun m => -c₀ m, -j₀, J.neg_mem hj₀, ?_⟩
        simp only [map_neg, neg_mul, Finset.sum_neg_distrib]
        ring
      have hSg_smul : ∀ (r₀ : R) {x : F}, x ∈ S_good_set → ψ r₀ * x ∈ S_good_set := by
        rintro r₀ x ⟨hb, c₀, j₀, hj₀, rfl⟩
        refine ⟨B_a.mul_mem (hψ_Ba r₀) hb, fun m => r₀ * c₀ m, ψ r₀ * j₀,
          hJ_mul (ψ r₀) (hψ_Ba r₀) j₀ hj₀, ?_⟩
        rw [mul_add, Finset.mul_sum]
        congr 1
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [map_mul, mul_assoc]
      have hSg_evalTerms : ∀ terms : List (R × List ↥Y),
          (∀ p ∈ terms, monList p.2 ∈ S_good_set) → evalTerms terms ∈ S_good_set := by
        intro terms hterms
        induction terms with
        | nil => simpa [evalTerms] using hSg_zero
        | cons hd tl ih =>
          simp only [evalTerms, List.map_cons, List.sum_cons]
          exact hSg_add
            (hSg_smul hd.1 (hterms hd (List.mem_cons_self ..)))
            (ih fun p hp => hterms p (List.mem_cons_of_mem _ hp))
      have hSg_mon : ∀ (d : ℕ) (l : List ↥Y), l.length = d → monList l ∈ S_good_set := by
        intro d
        induction d using Nat.strong_induction_on with
        | h d ih =>
          intro l hlen
          by_cases hd : d < K
          · have hm : monList l ∈ M_lt_K := hmon_in_M l (hlen ▸ hd)
            refine ⟨hmon_Ba l, fun m => if m = ⟨monList l, hm⟩ then 1 else 0, 0, J.zero_mem, ?_⟩
            have hsum_ite : ∑ m : ↥M_lt_K,
                ψ (if m = ⟨monList l, hm⟩ then 1 else 0) * (m : F) = monList l := by
              calc
                ∑ m : ↥M_lt_K, ψ (if m = ⟨monList l, hm⟩ then 1 else 0) * (m : F)
                    = ∑ m : ↥M_lt_K, if m = ⟨monList l, hm⟩ then (m : F) else 0 := by
                      refine Finset.sum_congr rfl fun m _ => ?_
                      split_ifs <;> simp
                _ = monList l := by simp
            rw [hsum_ite, add_zero]
          · have hK_le : K ≤ d := Nat.le_of_not_lt hd
            let l₁ : List ↥Y := l.take K
            let l₂ : List ↥Y := l.drop K
            have hl_app : l₁ ++ l₂ = l := List.take_append_drop K l
            have hl₁_len : l₁.length = K := List.length_take_of_le (hlen ▸ hK_le)
            have hl₂_len : l₂.length = d - K := by simp [l₂, hlen]
            let v₁ : Fin K → ↥Y := fun t => l₁[t.1]'(by rw [hl₁_len]; exact t.2)
            have hprod_v₁ : (∏ t : Fin K, (v₁ t : F)) = monList l₁ := by
              let e_len : Fin K ≃ Fin l₁.length := finCongr hl₁_len.symm
              calc
                ∏ t : Fin K, (v₁ t : F)
                    = ∏ s : Fin l₁.length, (l₁[s.1] : F) := by
                      rw [← Equiv.prod_comp e_len (fun s : Fin l₁.length => (l₁[s.1] : F))]
                      rfl
                _ = monList l₁ := Fin.prod_univ_fun_getElem l₁ Subtype.val
            obtain ⟨terms, hterms_len, hterms_eq⟩ := hBinomDiff K Φ v₁
            rw [hprod_v₁] at hterms_eq
            have hl₁_eq : monList l₁ = evalTerms terms + Δ_Φ v₁ := by
              linear_combination hterms_eq
            have hl_prod : monList l =
                evalTerms (appendRight l₂ terms) + monList l₂ * Δ_Φ v₁ := by
              rw [← hl_app, hmon_append, hl₁_eq, heval_appR]
              ring
            rw [hl_prod]
            refine hSg_add (hSg_evalTerms (appendRight l₂ terms) ?_)
              (hSg_J _ (hJ_mul (monList l₂) (hmon_Ba l₂) (Δ_Φ v₁) (hΔ_J v₁)))
            intro p' hp'
            rcases List.mem_map.mp hp' with ⟨p, hp, rfl⟩
            have hp_lt : p.2.length < K := hterms_len p hp
            have htot_lt : (p.2 ++ l₂).length < d := by
              rw [List.length_append, hl₂_len]
              omega
            exact ih (p.2 ++ l₂).length htot_lt (p.2 ++ l₂) rfl
      have hSg_finSum : ∀ {α_s : Type u} (S_f : Finset α_s) (f_s : α_s → F),
          (∀ a ∈ S_f, f_s a ∈ S_good_set) → ∑ a ∈ S_f, f_s a ∈ S_good_set := by
        intro α_s S_f f_s hf_s
        induction S_f using Finset.induction_on with
        | empty => simpa using hSg_zero
        | @insert a S_f ha ih =>
          rw [Finset.sum_insert ha]
          exact hSg_add (hf_s a (Finset.mem_insert_self a S_f))
            (ih fun b hb => hf_s b (Finset.mem_insert_of_mem hb))
      have hSg_mul : ∀ {x₁ x₂ : F}, x₁ ∈ S_good_set → x₂ ∈ S_good_set → x₁ * x₂ ∈ S_good_set := by
        rintro x₁ x₂ ⟨hb₁, c₁, j₁, hj₁, hx₁⟩ ⟨hb₂, c₂, j₂, hj₂, hx₂⟩
        let s₁_val : F := ∑ m : ↥M_lt_K, ψ (c₁ m) * (m : F)
        have hs₁_Ba : s₁_val ∈ B_a :=
          B_a.sum_mem fun m _ => B_a.mul_mem (hψ_Ba (c₁ m)) (hM_lt_Ba m.1 m.2)
        have hm_mul : ∀ m₁ m₂ : ↥M_lt_K, (m₁ : F) * (m₂ : F) ∈ S_good_set := by
          intro m₁ m₂
          rcases Finset.mem_biUnion.mp m₁.2 with ⟨d₁_w, _, hm₁_img⟩
          rcases Finset.mem_image.mp hm₁_img with ⟨v₁, _, hm₁_eq⟩
          rcases Finset.mem_biUnion.mp m₂.2 with ⟨d₂_w, _, hm₂_img⟩
          rcases Finset.mem_image.mp hm₂_img with ⟨v₂, _, hm₂_eq⟩
          have hv₁_eq : (m₁ : F) = monList (List.ofFn v₁) := by
            rw [← hm₁_eq]; dsimp [monList]; rw [List.map_ofFn, List.prod_ofFn]; rfl
          have hv₂_eq : (m₂ : F) = monList (List.ofFn v₂) := by
            rw [← hm₂_eq]; dsimp [monList]; rw [List.map_ofFn, List.prod_ofFn]; rfl
          rw [hv₁_eq, hv₂_eq, ← hmon_append]
          exact hSg_mon _ _ rfl
        have hs_prod_Sg :
            s₁_val * (∑ m₂ : ↥M_lt_K, ψ (c₂ m₂) * (m₂ : F)) ∈ S_good_set := by
          dsimp [s₁_val]
          rw [Finset.sum_mul]
          refine hSg_finSum Finset.univ _ fun m₁ _ => ?_
          rw [Finset.mul_sum]
          refine hSg_finSum Finset.univ _ fun m₂ _ => ?_
          have hrew : (ψ (c₁ m₁) * (m₁ : F)) * (ψ (c₂ m₂) * (m₂ : F)) =
              ψ (c₁ m₁ * c₂ m₂) * ((m₁ : F) * (m₂ : F)) := by
            rw [map_mul]; ring
          rw [hrew]
          exact hSg_smul (c₁ m₁ * c₂ m₂) (hm_mul m₁ m₂)
        have hrem_J : s₁_val * j₂ + x₂ * j₁ ∈ J :=
          J.add_mem (hJ_mul s₁_val hs₁_Ba j₂ hj₂) (hJ_mul x₂ hb₂ j₁ hj₁)
        have hsplit_prod : x₁ * x₂ =
            s₁_val * (∑ m₂ : ↥M_lt_K, ψ (c₂ m₂) * (m₂ : F)) + (s₁_val * j₂ + x₂ * j₁) := by
          calc
            x₁ * x₂ = (s₁_val + j₁) * x₂ := by rw [hx₁]
            _ = s₁_val * (∑ m₂ : ↥M_lt_K, ψ (c₂ m₂) * (m₂ : F) + j₂) + j₁ * x₂ := by
              rw [add_mul, hx₂]
            _ = s₁_val * (∑ m₂ : ↥M_lt_K, ψ (c₂ m₂) * (m₂ : F)) + (s₁_val * j₂ + x₂ * j₁) := by
              ring
        rw [hsplit_prod]
        exact hSg_add hs_prod_Sg (hSg_J _ hrem_J)
      let S_good : Subring F :=
        { carrier := S_good_set
          mul_mem' := hSg_mul
          one_mem' := hSg_mon 0 [] rfl
          add_mem' := hSg_add
          zero_mem' := hSg_zero
          neg_mem' := hSg_neg }
      have hBa_le_Sg : B_a ≤ S_good := by
        rw [hBa, Subring.closure_le]
        rintro x (⟨r₀, rfl⟩ | hxY)
        · change ψ r₀ ∈ S_good_set
          have h1 := hSg_smul r₀ (hSg_mon 0 [] rfl)
          simpa [monList] using h1
        · change x ∈ S_good_set
          have hx_mon : x = monList [⟨x, hxY⟩] := by simp [monList]
          rw [hx_mon]
          exact hSg_mon 1 [⟨x, hxY⟩] rfl
      let I_idx : Finset (F × ι) := M_lt_K ×ˢ Finset.univ
      let φ_gen : F × ι → F := fun p => p.1 * e p.2
      let G_Q : Finset F := I_idx.image φ_gen
      refine ⟨G_Q, ?_, ?_⟩
      · intro g hg
        rcases Finset.mem_image.mp hg with ⟨⟨m, i⟩, hp, rfl⟩
        have hm : m ∈ M_lt_K := (Finset.mem_product.mp hp).1
        exact ⟨m, hM_lt_Ba m hm, i, rfl⟩
      · intro b hb
        have hb_Sg : ∀ i : ι, b i ∈ S_good_set := fun i => hBa_le_Sg (hb i)
        choose c_mat j_vec hj_vec hb_eq using fun i => (hb_Sg i).2
        let c_ext : ι → F → R :=
          fun i m => if hm : m ∈ M_lt_K then c_mat i ⟨m, hm⟩ else 0
        have hsum_m : ∀ i : ι,
            ∑ m : ↥M_lt_K, ψ (c_mat i m) * (m : F) = ∑ m ∈ M_lt_K, ψ (c_ext i m) * m := by
          intro i
          rw [← Finset.sum_coe_sort M_lt_K (fun m => ψ (c_ext i m) * m)]
          refine Finset.sum_congr rfl fun m _ => ?_
          simp [c_ext, m.2]
        let coeff_fn : ↥G_Q → R := fun g =>
          ∑ p ∈ I_idx.filter (fun p => φ_gen p = (g : F)), c_ext p.2 p.1
        refine ⟨∑ i : ι, j_vec i * e i, W.sum_mem fun i _ => (hj_vec i).2 i, coeff_fn, ?_⟩
        have hsplit_b : ∑ i : ι, b i * e i =
            (∑ i : ι, j_vec i * e i) + ∑ p ∈ I_idx, ψ (c_ext p.2 p.1) * φ_gen p := by
          calc
            ∑ i : ι, b i * e i
                = ∑ i : ι, ((∑ m ∈ M_lt_K, ψ (c_ext i m) * m) + j_vec i) * e i := by
                  refine Finset.sum_congr rfl fun i _ => ?_
                  rw [hb_eq i, hsum_m i]
            _ = (∑ i : ι, j_vec i * e i) +
                  ∑ i : ι, ∑ m ∈ M_lt_K, ψ (c_ext i m) * (m * e i) := by
                  simp only [add_mul, Finset.sum_add_distrib, Finset.sum_mul, mul_assoc]
                  ring
            _ = (∑ i : ι, j_vec i * e i) + ∑ p ∈ I_idx, ψ (c_ext p.2 p.1) * φ_gen p := by
                  congr 1
                  rw [Finset.sum_comm]
                  dsimp [I_idx, φ_gen]
                  rw [Finset.sum_product]
        rw [hsplit_b]
        congr 1
        have hmaps : ∀ p ∈ I_idx, φ_gen p ∈ G_Q :=
          fun p hp => Finset.mem_image_of_mem φ_gen hp
        rw [← Finset.sum_fiberwise_of_maps_to hmaps (fun p => ψ (c_ext p.2 p.1) * φ_gen p)]
        rw [← Finset.sum_coe_sort G_Q (fun g =>
          ∑ p ∈ I_idx.filter (fun p => φ_gen p = g), ψ (c_ext p.2 p.1) * φ_gen p)]
        refine Finset.sum_congr rfl fun g _ => ?_
        dsimp [coeff_fn]
        rw [map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun p hp => ?_
        rw [(Finset.mem_filter.mp hp).2]

  
  
  
  have hV_Ba : ∀ (a : Fin (N + 1)) (v : ↥V), φ_VF v ∈ B {a} := by
    intro a v
    rw [← hInter {a} (Finset.singleton_nonempty a)]
    exact ⟨Subring.subset_closure (Set.mem_union_right _ (hV_mem v).1),
      Subring.subset_closure (Set.mem_union_right _ (hV_mem v).2)⟩

  have hY_mem : ∀ (a : Fin (N + 1)), ∀ y ∈ Y_a a, y ∈ B {a} :=
    fun a y hy => ((hBase a).choose_spec.2.2 ⟨y, hy⟩).choose

  
  have hM_pole_ex : ∃ M_pole : ℕ, 1 ≤ M_pole ∧ ∀ μ : Fin d₀, s₁ ^ M_pole * gen₀ μ ∈ R_t1 := by
    have hm₀_ex : ∀ μ : Fin d₀, ∃ m : ℕ, s₁ ^ m * gen₀ μ ∈ R_t1 := by
      intro μ
      have hmem : gen₀ μ ∈ Subring.closure ((R_t1 : Set F) ∪ {t₀}) := by
        rw [← hR01_eq]
        exact Subring.subset_closure (Set.mem_union_left _ (hgen₀ μ))
      obtain ⟨u₁, hu₁, m, h_eq⟩ := hAdjoinInv R_t1 s₁ t₀ hs₁ hst (gen₀ μ) hmem
      refine ⟨m, ?_⟩
      have hrew : s₁ ^ m * gen₀ μ = u₁ * (s₁ * t₀) ^ m := by rw [h_eq, mul_pow]; ring
      rw [hrew, hst, one_pow, mul_one]
      exact hu₁
    choose m₀_fn hm₀_fn using hm₀_ex
    let W_pole : ℕ := Finset.univ.sup m₀_fn
    refine ⟨W_pole + 1, Nat.succ_pos W_pole, fun μ => ?_⟩
    have hle : m₀_fn μ ≤ W_pole + 1 :=
      le_trans (Finset.le_sup (Finset.mem_univ μ)) (Nat.le_succ W_pole)
    have hsplit : W_pole + 1 = (W_pole + 1 - m₀_fn μ) + m₀_fn μ := (Nat.sub_add_cancel hle).symm
    have hrew : s₁ ^ (W_pole + 1) * gen₀ μ =
        s₁ ^ (W_pole + 1 - m₀_fn μ) * (s₁ ^ (m₀_fn μ) * gen₀ μ) := by
      conv_lhs => rw [hsplit, pow_add]
      ring
    rw [hrew]
    exact R_t1.mul_mem (R_t1.pow_mem hs₁ _) (hm₀_fn μ)
  obtain ⟨M_pole, _hM_pole_pos, hM_pole_mem⟩ := hM_pole_ex

  
  have hPen_ex : ∃ (S_V_pen : Finset ↥V)
      (s_p0 : ℕ) (a_idx0 : Fin s_p0 → Fin (N + 1)) (f_p0 α_p0 : Fin s_p0 → F) (N_p0 : Fin s_p0 → ℕ)
      (s_p1 : ℕ) (a_idx1 : Fin s_p1 → Fin (N + 1)) (f_p1 α_p1 : Fin s_p1 → F) (N_p1 : Fin s_p1 → ℕ)
      (s_p01 : ℕ) (a_idx01 : Fin s_p01 → Fin (N + 1)) (f_p01 α_p01 : Fin s_p01 → F)
      (N_p01 : Fin s_p01 → ℕ),
      (∑ j : Fin s_p0, α_p0 j * f_p0 j) = 1 ∧
      (∑ j : Fin s_p1, α_p1 j * f_p1 j) = 1 ∧
      (∑ j : Fin s_p01, α_p01 j * f_p01 j) = 1 ∧
      ∀ (R_β : Subring ↥V), (∀ v ∈ S_V_pen, v ∈ R_β) →
        let ψ_β : ↥R_β →+* F := φ_VF.comp R_β.subtype
        let R_β0 : Subring F := Subring.closure (Set.range ψ_β ∪ {t₀} ∪ Set.range gen₀)
        let R_β1 : Subring F := Subring.closure (Set.range ψ_β ∪ {s₁} ∪ Set.range gen₁)
        let R_β01 : Subring F := Subring.closure ((R_β0 : Set F) ∪ {s₁})
        (∃ Q_one : Fin d₀ → Polynomial ↥R_β,
          (1 : F) = ∑ μ : Fin d₀, Polynomial.eval₂ ψ_β t₀ (Q_one μ) * gen₀ μ) ∧
        (∀ μ₁ μ₂ : Fin d₀, ∃ Q_m : Fin d₀ → Polynomial ↥R_β,
          gen₀ μ₁ * gen₀ μ₂ = ∑ μ : Fin d₀, Polynomial.eval₂ ψ_β t₀ (Q_m μ) * gen₀ μ) ∧
        (∀ μ : Fin d₀, s₁ ^ M_pole * gen₀ μ ∈ R_β1) ∧
        (∀ ν : Fin d₁, ∃ m : ℕ, t₀ ^ m * gen₁ ν ∈ R_β0) ∧
        (∀ j : Fin s_p0, f_p0 j ∈ R_β0 ∧ α_p0 j ∈ R_β0 ∧
          ∀ y ∈ Y_a (a_idx0 j), (f_p0 j) ^ (N_p0 j) * y ∈ R_β0) ∧
        (∀ j : Fin s_p1, f_p1 j ∈ R_β1 ∧ α_p1 j ∈ R_β1 ∧
          ∀ y ∈ Y_a (a_idx1 j), (f_p1 j) ^ (N_p1 j) * y ∈ R_β1) ∧
        (∀ j : Fin s_p01, f_p01 j ∈ R_β01 ∧ α_p01 j ∈ R_β01 ∧
          ∀ y ∈ Y_a (a_idx01 j), (f_p01 j) ^ (N_p01 j) * y ∈ R_β01) := by
    have hSpan0_fin : ∀ (L_elts : Finset F), (∀ w ∈ L_elts, w ∈ R_t0) →
        ∃ S_V : Finset ↥V, ∀ (R_β : Subring ↥V), (∀ v ∈ S_V, v ∈ R_β) →
          ∀ w ∈ L_elts,
            (∃ Q : Fin d₀ → Polynomial ↥R_β,
              w = ∑ μ : Fin d₀, Polynomial.eval₂ (φ_VF.comp R_β.subtype) t₀ (Q μ) * gen₀ μ) ∧
            w ∈ Subring.closure (Set.range (φ_VF.comp R_β.subtype) ∪ {t₀} ∪ Set.range gen₀) := by
      intro L_elts hL
      choose P hP using fun (w : F) (hw : w ∈ L_elts) => hspan₀ w (hL w hw)
      refine ⟨L_elts.attach.biUnion (fun w => Finset.univ.biUnion (fun μ => (P w.1 w.2 μ).coeffs)), ?_⟩
      intro R_β hSV w hw
      have hc_sub : ∀ μ : Fin d₀, ((P w hw μ).coeffs : Set ↥V) ⊆ R_β := fun μ v hv =>
        hSV v (Finset.mem_biUnion.mpr ⟨⟨w, hw⟩, Finset.mem_attach _ _,
          Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ μ, hv⟩⟩)
      let ψ_β : ↥R_β →+* F := φ_VF.comp R_β.subtype
      let R_β0 : Subring F := Subring.closure (Set.range ψ_β ∪ {t₀} ∪ Set.range gen₀)
      let Q : Fin d₀ → Polynomial ↥R_β := fun μ => (P w hw μ).toSubring R_β (hc_sub μ)
      have hw_eq : w = ∑ μ : Fin d₀, Polynomial.eval₂ ψ_β t₀ (Q μ) * gen₀ μ := by
        conv_lhs => rw [hP w hw]
        refine Finset.sum_congr rfl fun μ _ => ?_
        congr 1
        dsimp [ψ_β, Q]
        rw [← Polynomial.eval₂_map, Polynomial.map_toSubring]
      refine ⟨⟨Q, hw_eq⟩, ?_⟩
      rw [hw_eq]
      refine R_β0.sum_mem fun μ _ => R_β0.mul_mem ?_
        (Subring.subset_closure (Set.mem_union_right _ ⟨μ, rfl⟩))
      rw [Polynomial.eval₂_eq_sum_range]
      exact R_β0.sum_mem fun k _ => R_β0.mul_mem
        (Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ ⟨_, rfl⟩)))
        (R_β0.pow_mem (Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _ rfl))) k)

    have hSpan1_fin : ∀ (L_elts : Finset F), (∀ w ∈ L_elts, w ∈ R_t1) →
        ∃ S_V : Finset ↥V, ∀ (R_β : Subring ↥V), (∀ v ∈ S_V, v ∈ R_β) →
          ∀ w ∈ L_elts,
            w ∈ Subring.closure (Set.range (φ_VF.comp R_β.subtype) ∪ {s₁} ∪ Set.range gen₁) := by
      intro L_elts hL
      choose P hP using fun (w : F) (hw : w ∈ L_elts) => hspan₁ w (hL w hw)
      refine ⟨L_elts.attach.biUnion (fun w => Finset.univ.biUnion (fun ν => (P w.1 w.2 ν).coeffs)), ?_⟩
      intro R_β hSV w hw
      have hc_sub : ∀ ν : Fin d₁, ((P w hw ν).coeffs : Set ↥V) ⊆ R_β := fun ν v hv =>
        hSV v (Finset.mem_biUnion.mpr ⟨⟨w, hw⟩, Finset.mem_attach _ _,
          Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, hv⟩⟩)
      let ψ_β : ↥R_β →+* F := φ_VF.comp R_β.subtype
      let R_β1 : Subring F := Subring.closure (Set.range ψ_β ∪ {s₁} ∪ Set.range gen₁)
      let Q : Fin d₁ → Polynomial ↥R_β := fun ν => (P w hw ν).toSubring R_β (hc_sub ν)
      have hw_eq : w = ∑ ν : Fin d₁, Polynomial.eval₂ ψ_β s₁ (Q ν) * gen₁ ν := by
        conv_lhs => rw [hP w hw]
        refine Finset.sum_congr rfl fun ν _ => ?_
        congr 1
        dsimp [ψ_β, Q]
        rw [← Polynomial.eval₂_map, Polynomial.map_toSubring]
      rw [hw_eq]
      refine R_β1.sum_mem fun ν _ => R_β1.mul_mem ?_
        (Subring.subset_closure (Set.mem_union_right _ ⟨ν, rfl⟩))
      rw [Polynomial.eval₂_eq_sum_range]
      exact R_β1.sum_mem fun k _ => R_β1.mul_mem
        (Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ ⟨_, rfl⟩)))
        (R_β1.pow_mem (Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _ rfl))) k)

    have hm₁_ex : ∀ ν : Fin d₁, ∃ m : ℕ, t₀ ^ m * gen₁ ν ∈ R_t0 := by
      intro ν
      have hmem : gen₁ ν ∈ Subring.closure ((R_t0 : Set F) ∪ {s₁}) := by
        rw [hR01_eq]
        exact Subring.subset_closure (Set.mem_union_left _ (hgen₁ ν))
      obtain ⟨u₀, hu₀, m, h_eq⟩ := hAdjoinInv R_t0 t₀ s₁ ht₀ hts (gen₁ ν) hmem
      refine ⟨m, ?_⟩
      have hrew : t₀ ^ m * gen₁ ν = u₀ * (t₀ * s₁) ^ m := by rw [h_eq, mul_pow]; ring
      rw [hrew, hts, one_pow, mul_one]
      exact hu₀
    choose m₁_fn hm₁_fn using hm₁_ex

    let R_t01 : Subring F := Subring.closure ((R_t0 : Set F) ∪ {s₁})
    obtain ⟨s_p0, a_idx0, f_p0, α_p0, hfα_p0, hsum_p0, hclr_p0⟩ := hPOU R_t0 (by simp)
    obtain ⟨s_p1, a_idx1, f_p1, α_p1, hfα_p1, hsum_p1, hclr_p1⟩ := hPOU R_t1 (by simp)
    obtain ⟨s_p01, a_idx01, f_p01, α_p01, hfα_p01, hsum_p01, hclr_p01⟩ :=
      hPOU R_t01 (by simp [R_t01])

    choose n_p0 hn_p0 using fun (j : Fin s_p0) (y : ↥(Y_a (a_idx0 j))) =>
      hclr_p0 j y.1 (hY_mem (a_idx0 j) y.1 y.2)
    let N_p0 : Fin s_p0 → ℕ := fun j => (Y_a (a_idx0 j)).attach.sup (fun y => n_p0 j y)
    have hc_p0_mem : ∀ (j : Fin s_p0), ∀ y ∈ Y_a (a_idx0 j),
        (f_p0 j) ^ (N_p0 j) * y ∈ R_t0 := by
      intro j y hy
      let y_s : ↥(Y_a (a_idx0 j)) := ⟨y, hy⟩
      have hle : n_p0 j y_s ≤ N_p0 j := Finset.le_sup (Finset.mem_attach _ y_s)
      have hsplit : N_p0 j = (N_p0 j - n_p0 j y_s) + n_p0 j y_s := (Nat.sub_add_cancel hle).symm
      have hrew : (f_p0 j) ^ (N_p0 j) * y =
          (f_p0 j) ^ (N_p0 j - n_p0 j y_s) * ((f_p0 j) ^ (n_p0 j y_s) * y) := by
        conv_lhs => rw [hsplit, pow_add]
        ring
      rw [hrew]
      exact R_t0.mul_mem (R_t0.pow_mem (hfα_p0 j).1 _) (hn_p0 j y_s)

    choose n_p1 hn_p1 using fun (j : Fin s_p1) (y : ↥(Y_a (a_idx1 j))) =>
      hclr_p1 j y.1 (hY_mem (a_idx1 j) y.1 y.2)
    let N_p1 : Fin s_p1 → ℕ := fun j => (Y_a (a_idx1 j)).attach.sup (fun y => n_p1 j y)
    have hc_p1_mem : ∀ (j : Fin s_p1), ∀ y ∈ Y_a (a_idx1 j),
        (f_p1 j) ^ (N_p1 j) * y ∈ R_t1 := by
      intro j y hy
      let y_s : ↥(Y_a (a_idx1 j)) := ⟨y, hy⟩
      have hle : n_p1 j y_s ≤ N_p1 j := Finset.le_sup (Finset.mem_attach _ y_s)
      have hsplit : N_p1 j = (N_p1 j - n_p1 j y_s) + n_p1 j y_s := (Nat.sub_add_cancel hle).symm
      have hrew : (f_p1 j) ^ (N_p1 j) * y =
          (f_p1 j) ^ (N_p1 j - n_p1 j y_s) * ((f_p1 j) ^ (n_p1 j y_s) * y) := by
        conv_lhs => rw [hsplit, pow_add]
        ring
      rw [hrew]
      exact R_t1.mul_mem (R_t1.pow_mem (hfα_p1 j).1 _) (hn_p1 j y_s)

    choose n_p01 hn_p01 using fun (j : Fin s_p01) (y : ↥(Y_a (a_idx01 j))) =>
      hclr_p01 j y.1 (hY_mem (a_idx01 j) y.1 y.2)
    let N_p01 : Fin s_p01 → ℕ := fun j => (Y_a (a_idx01 j)).attach.sup (fun y => n_p01 j y)
    have hc_p01_mem : ∀ (j : Fin s_p01) (y : ↥(Y_a (a_idx01 j))),
        (f_p01 j) ^ (N_p01 j) * y.1 ∈ R_t01 := by
      intro j y
      have hle : n_p01 j y ≤ N_p01 j := Finset.le_sup (Finset.mem_attach _ y)
      have hsplit : N_p01 j = (N_p01 j - n_p01 j y) + n_p01 j y := (Nat.sub_add_cancel hle).symm
      have hrew : (f_p01 j) ^ (N_p01 j) * y.1 =
          (f_p01 j) ^ (N_p01 j - n_p01 j y) * ((f_p01 j) ^ (n_p01 j y) * y.1) := by
        conv_lhs => rw [hsplit, pow_add]
        ring
      rw [hrew]
      exact R_t01.mul_mem (R_t01.pow_mem (hfα_p01 j).1 _) (hn_p01 j y)

    choose u_f01 hu_f01 d_f01 hd_f01 using fun j : Fin s_p01 =>
      hAdjoinInv R_t0 t₀ s₁ ht₀ hts (f_p01 j) (hfα_p01 j).1
    choose u_α01 hu_α01 d_α01 hd_α01 using fun j : Fin s_p01 =>
      hAdjoinInv R_t0 t₀ s₁ ht₀ hts (α_p01 j) (hfα_p01 j).2
    choose u_cy01 hu_cy01 d_cy01 hd_cy01 using fun (j : Fin s_p01) (y : ↥(Y_a (a_idx01 j))) =>
      hAdjoinInv R_t0 t₀ s₁ ht₀ hts ((f_p01 j) ^ (N_p01 j) * y.1) (hc_p01_mem j y)

    obtain ⟨SV_1, hSV_1⟩ := hSpan0_fin {1} (by simp [R_t0.one_mem])
    obtain ⟨SV_mul, hSV_mul⟩ := hSpan0_fin
      (Finset.univ.biUnion fun μ₁ : Fin d₀ => Finset.univ.image fun μ₂ : Fin d₀ => gen₀ μ₁ * gen₀ μ₂)
      (by intro w hw; simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image] at hw;
          rcases hw with ⟨μ₁, μ₂, rfl⟩; exact R_t0.mul_mem (hgen₀ μ₁) (hgen₀ μ₂))
    obtain ⟨SV_m1, hSV_m1⟩ := hSpan0_fin
      (Finset.univ.image fun ν : Fin d₁ => t₀ ^ (m₁_fn ν) * gen₁ ν)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨ν, _, rfl⟩; exact hm₁_fn ν)
    obtain ⟨SV_f0, hSV_f0⟩ := hSpan0_fin (Finset.univ.image f_p0)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨j, _, rfl⟩; exact (hfα_p0 j).1)
    obtain ⟨SV_α0, hSV_α0⟩ := hSpan0_fin (Finset.univ.image α_p0)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨j, _, rfl⟩; exact (hfα_p0 j).2)
    obtain ⟨SV_cy0, hSV_cy0⟩ := hSpan0_fin
      (Finset.univ.biUnion fun j : Fin s_p0 => (Y_a (a_idx0 j)).image fun y => (f_p0 j) ^ (N_p0 j) * y)
      (by intro w hw; rcases Finset.mem_biUnion.mp hw with ⟨j, _, hw'⟩;
          rcases Finset.mem_image.mp hw' with ⟨y, hy, rfl⟩; exact hc_p0_mem j y hy)
    obtain ⟨SV_uf01, hSV_uf01⟩ := hSpan0_fin (Finset.univ.image u_f01)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨j, _, rfl⟩; exact hu_f01 j)
    obtain ⟨SV_uα01, hSV_uα01⟩ := hSpan0_fin (Finset.univ.image u_α01)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨j, _, rfl⟩; exact hu_α01 j)
    obtain ⟨SV_ucy01, hSV_ucy01⟩ := hSpan0_fin
      (Finset.univ.biUnion fun j : Fin s_p01 => (Y_a (a_idx01 j)).attach.image fun y => u_cy01 j y)
      (by intro w hw; rcases Finset.mem_biUnion.mp hw with ⟨j, _, hw'⟩;
          rcases Finset.mem_image.mp hw' with ⟨y, _, rfl⟩; exact hu_cy01 j y)
    obtain ⟨SV_pole1, hSV_pole1⟩ := hSpan1_fin
      (Finset.univ.image fun μ : Fin d₀ => s₁ ^ M_pole * gen₀ μ)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨μ, _, rfl⟩; exact hM_pole_mem μ)
    obtain ⟨SV_f1, hSV_f1⟩ := hSpan1_fin (Finset.univ.image f_p1)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨j, _, rfl⟩; exact (hfα_p1 j).1)
    obtain ⟨SV_α1, hSV_α1⟩ := hSpan1_fin (Finset.univ.image α_p1)
      (by intro w hw; rcases Finset.mem_image.mp hw with ⟨j, _, rfl⟩; exact (hfα_p1 j).2)
    obtain ⟨SV_cy1, hSV_cy1⟩ := hSpan1_fin
      (Finset.univ.biUnion fun j : Fin s_p1 => (Y_a (a_idx1 j)).image fun y => (f_p1 j) ^ (N_p1 j) * y)
      (by intro w hw; rcases Finset.mem_biUnion.mp hw with ⟨j, _, hw'⟩;
          rcases Finset.mem_image.mp hw' with ⟨y, hy, rfl⟩; exact hc_p1_mem j y hy)

    let S_V_all : Finset ↥V :=
      SV_1 ∪ (SV_mul ∪ (SV_m1 ∪ (SV_f0 ∪ (SV_α0 ∪ (SV_cy0 ∪
        (SV_uf01 ∪ (SV_uα01 ∪ (SV_ucy01 ∪ (SV_pole1 ∪ (SV_f1 ∪ (SV_α1 ∪ SV_cy1)))))))))))
    refine ⟨S_V_all, s_p0, a_idx0, f_p0, α_p0, N_p0,
      s_p1, a_idx1, f_p1, α_p1, N_p1, s_p01, a_idx01, f_p01, α_p01, N_p01,
      hsum_p0, hsum_p1, hsum_p01, ?_⟩
    intro R_β hSV ψ_β R_β0 R_β1 R_β01
    have hsub : ∀ {S₀ S₁ : Finset ↥V}, S₀ ⊆ S_V_all → (∀ v ∈ S₀, v ∈ R_β) :=
      fun {S₀ _} h v hv => hSV v (h hv)
    have h1 := (hSV_1 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) 1 (by simp)).1
    have hmul : ∀ μ₁ μ₂ : Fin d₀, ∃ Q_m : Fin d₀ → Polynomial ↥R_β,
        gen₀ μ₁ * gen₀ μ₂ = ∑ μ : Fin d₀, Polynomial.eval₂ ψ_β t₀ (Q_m μ) * gen₀ μ :=
      fun μ₁ μ₂ => (hSV_mul R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
        (Finset.mem_biUnion.mpr ⟨μ₁, Finset.mem_univ μ₁,
          Finset.mem_image_of_mem _ (Finset.mem_univ μ₂)⟩)).1
    have hpole1 : ∀ μ : Fin d₀, s₁ ^ M_pole * gen₀ μ ∈ R_β1 :=
      fun μ => hSV_pole1 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
        (Finset.mem_image_of_mem _ (Finset.mem_univ μ))
    have hm1 : ∀ ν : Fin d₁, ∃ m : ℕ, t₀ ^ m * gen₁ ν ∈ R_β0 :=
      fun ν => ⟨m₁_fn ν, (hSV_m1 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
        (Finset.mem_image_of_mem _ (Finset.mem_univ ν))).2⟩
    have hp0 : ∀ j : Fin s_p0, f_p0 j ∈ R_β0 ∧ α_p0 j ∈ R_β0 ∧
        ∀ y ∈ Y_a (a_idx0 j), (f_p0 j) ^ (N_p0 j) * y ∈ R_β0 := by
      intro j
      refine ⟨(hSV_f0 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_image_of_mem _ (Finset.mem_univ j))).2,
        (hSV_α0 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_image_of_mem _ (Finset.mem_univ j))).2,
        fun y hy => (hSV_cy0 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, Finset.mem_image_of_mem _ hy⟩)).2⟩
    have hp1 : ∀ j : Fin s_p1, f_p1 j ∈ R_β1 ∧ α_p1 j ∈ R_β1 ∧
        ∀ y ∈ Y_a (a_idx1 j), (f_p1 j) ^ (N_p1 j) * y ∈ R_β1 := by
      intro j
      refine ⟨hSV_f1 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_image_of_mem _ (Finset.mem_univ j)),
        hSV_α1 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_image_of_mem _ (Finset.mem_univ j)),
        fun y hy => hSV_cy1 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, Finset.mem_image_of_mem _ hy⟩)⟩
    have hp01 : ∀ j : Fin s_p01, f_p01 j ∈ R_β01 ∧ α_p01 j ∈ R_β01 ∧
        ∀ y ∈ Y_a (a_idx01 j), (f_p01 j) ^ (N_p01 j) * y ∈ R_β01 := by
      have hs₁_01 : s₁ ∈ R_β01 := Subring.subset_closure (Set.mem_union_right _ rfl)
      have hR0_01 : R_β0 ≤ R_β01 := fun z hz => Subring.subset_closure (Set.mem_union_left _ hz)
      intro j
      refine ⟨?_, ?_, ?_⟩
      · rw [hd_f01 j]
        exact R_β01.mul_mem (hR0_01 (hSV_uf01 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_image_of_mem _ (Finset.mem_univ j))).2) (R_β01.pow_mem hs₁_01 _)
      · rw [hd_α01 j]
        exact R_β01.mul_mem (hR0_01 (hSV_uα01 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_image_of_mem _ (Finset.mem_univ j))).2) (R_β01.pow_mem hs₁_01 _)
      · intro y hy
        rw [hd_cy01 j ⟨y, hy⟩]
        exact R_β01.mul_mem (hR0_01 (hSV_ucy01 R_β (fun v hv => hSV v (by simp [S_V_all, hv])) _
          (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j,
            Finset.mem_image_of_mem _ (Finset.mem_attach _ ⟨y, hy⟩)⟩)).2) (R_β01.pow_mem hs₁_01 _)
    exact ⟨h1, hmul, hpole1, hm1, hp0, hp1, hp01⟩

  obtain ⟨S_V_pen, s_p0, a_idx0, f_p0, α_p0, N_p0,
    s_p1, a_idx1, f_p1, α_p1, N_p1, s_p01, a_idx01, f_p01, α_p01, N_p01,
    hsum_p0, hsum_p1, hsum_p01, hPenLift⟩ := hPen_ex

  
  have hClearTables_ex : ∃ (S_V_tc : Finset ↥V) (S_F_tc : Finset F),
      (∀ v ∈ S_V_pen, v ∈ S_V_tc) ∧
      (∀ (a : Fin (N + 1)) (j : Fin (r_a a)) (y : ↥(Y_a a)), c_aj a j y ∈ S_V_tc) ∧
      (∀ (S : Finset (Fin (N + 1))), 2 ≤ S.card →
        ∀ (A : Subring F), (∀ z ∈ S_F_tc, z ∈ B S → z ∈ A) →
          ∃ (n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
            (∀ i, f i ∈ A ∧ α i ∈ A) ∧
            (∀ j, h j ∈ A ∧ γ j ∈ A) ∧
            (∑ i, α i * f i) + (∑ j, γ j * h j) = 1 ∧
            (∀ i, (f i) ^ n₀ * 1 * t₀ ∈ A ∧ ∀ μ, (f i) ^ n₀ * 1 * gen₀ μ ∈ A) ∧
            (∀ j, (h j) ^ n₁ * 1 * s₁ ∈ A ∧ ∀ ν, (h j) ^ n₁ * 1 * gen₁ ν ∈ A)) ∧
      (∀ (a : Fin (N + 1)) (A : Subring F), (∀ z ∈ S_F_tc, z ∈ B {a} → z ∈ A) →
        ∃ (N₀ n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
          (∀ i, f i ∈ A ∧ α i ∈ A) ∧
          (∀ j, h j ∈ A ∧ γ j ∈ A) ∧
          (∑ i, α i * f i) + (∑ j, γ j * h j) = (g_a a) ^ N₀ ∧
          (∀ i, (f i) ^ n₀ * (g_a a) ^ N₀ * t₀ ∈ A ∧
            ∀ μ, (f i) ^ n₀ * (g_a a) ^ N₀ * gen₀ μ ∈ A) ∧
          (∀ j, (h j) ^ n₁ * (g_a a) ^ N₀ * s₁ ∈ A ∧
            ∀ ν, (h j) ^ n₁ * (g_a a) ^ N₀ * gen₁ ν ∈ A)) ∧
      (∀ (a : Fin (N + 1)) (y_vec : Fin (r_a a) → ↥(Y_a a)) (A : Subring F),
        (∀ z ∈ S_F_tc, z ∈ B {a} → z ∈ A) →
        let u_v : F := ∏ j : Fin (r_a a), ((y_vec j : F) - φ_VF (c_aj a j (y_vec j)))
        ∃ (N₀ n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
          (∀ i, f i ∈ A ∧ α i ∈ A) ∧
          (∀ j, h j ∈ A ∧ γ j ∈ A) ∧
          (∑ i, α i * f i) + (∑ j, γ j * h j) = u_v ^ N₀ ∧
          (∀ i, (f i) ^ n₀ * u_v ^ N₀ * t₀ ∈ A ∧
            ∀ μ, (f i) ^ n₀ * u_v ^ N₀ * gen₀ μ ∈ A) ∧
          (∀ j, (h j) ^ n₁ * u_v ^ N₀ * s₁ ∈ A ∧
            ∀ ν, (h j) ^ n₁ * u_v ^ N₀ * gen₁ ν ∈ A)) := by
    let packClearSet : ∀ (w₀ : F) (n₀ n₁ r₀ r₁ : ℕ)
        (_f _α : Fin r₀ → F) (_h _γ : Fin r₁ → F), Finset F :=
      fun w₀ n₀ n₁ r₀ r₁ f α h γ =>
        Finset.univ.image f ∪
        (Finset.univ.image α ∪
        (Finset.univ.image (fun i => (f i) ^ n₀ * w₀ * t₀) ∪
        (Finset.univ.biUnion (fun i => Finset.univ.image (fun μ => (f i) ^ n₀ * w₀ * gen₀ μ)) ∪
        (Finset.univ.image h ∪
        (Finset.univ.image γ ∪
        (Finset.univ.image (fun j => (h j) ^ n₁ * w₀ * s₁) ∪
          Finset.univ.biUnion (fun j => Finset.univ.image (fun ν => (h j) ^ n₁ * w₀ * gen₁ ν))))))))
    have hPack_lift : ∀ {B₀ A : Subring F} {S_big : Finset F}
        (w₀ : F) (n₀ n₁ r₀ r₁ : ℕ) (f α : Fin r₀ → F) (h γ : Fin r₁ → F),
        (∀ z ∈ packClearSet w₀ n₀ n₁ r₀ r₁ f α h γ, z ∈ S_big) →
        (∀ z ∈ S_big, z ∈ B₀ → z ∈ A) →
        (∀ i, f i ∈ B₀ ∧ α i ∈ B₀) →
        (∀ j, h j ∈ B₀ ∧ γ j ∈ B₀) →
        (∀ i, (f i) ^ n₀ * w₀ * t₀ ∈ B₀ ∧ ∀ μ, (f i) ^ n₀ * w₀ * gen₀ μ ∈ B₀) →
        (∀ j, (h j) ^ n₁ * w₀ * s₁ ∈ B₀ ∧ ∀ ν, (h j) ^ n₁ * w₀ * gen₁ ν ∈ B₀) →
        (∀ i, f i ∈ A ∧ α i ∈ A) ∧
        (∀ j, h j ∈ A ∧ γ j ∈ A) ∧
        (∀ i, (f i) ^ n₀ * w₀ * t₀ ∈ A ∧ ∀ μ, (f i) ^ n₀ * w₀ * gen₀ μ ∈ A) ∧
        (∀ j, (h j) ^ n₁ * w₀ * s₁ ∈ A ∧ ∀ ν, (h j) ^ n₁ * w₀ * gen₁ ν ∈ A) := by
      intro B₀ A S_big w₀ n₀ n₁ r₀ r₁ f α h γ hsub hcap hfα hhγ hfc hhc
      have hm : ∀ z ∈ packClearSet w₀ n₀ n₁ r₀ r₁ f α h γ, z ∈ B₀ → z ∈ A :=
        fun z hz hzB => hcap z (hsub z hz) hzB
      refine ⟨fun i => ⟨hm _ ?_ (hfα i).1, hm _ ?_ (hfα i).2⟩,
        fun j => ⟨hm _ ?_ (hhγ j).1, hm _ ?_ (hhγ j).2⟩,
        fun i => ⟨hm _ ?_ (hfc i).1, fun μ => hm _ ?_ ((hfc i).2 μ)⟩,
        fun j => ⟨hm _ ?_ (hhc j).1, fun ν => hm _ ?_ ((hhc j).2 ν)⟩⟩
      · simp [packClearSet]
      · simp [packClearSet]
      · simp [packClearSet]
      · simp [packClearSet]
      · dsimp only [packClearSet]
        exact Finset.mem_union_right _ (Finset.mem_union_right _
          (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
      · simp [packClearSet]
      · dsimp only [packClearSet]
        exact Finset.mem_union_right _ (Finset.mem_union_right _ (Finset.mem_union_right _
          (Finset.mem_union_right _ (Finset.mem_union_right _ (Finset.mem_union_right _
            (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ j))))))))
      · simp [packClearSet]

    let ov_sets : Finset (Finset (Fin (N + 1))) :=
      Finset.univ.filter (fun S : Finset (Fin (N + 1)) => 2 ≤ S.card)
    choose ov_n₀ ov_n₁ ov_r₀ ov_r₁ ov_f ov_α ov_h ov_γ
      hov_fα hov_hγ hov_sum hov_fclr hov_hclr using
      fun S : ↥ov_sets => hClear_ov S.1 (Finset.mem_filter.mp S.2).2
    let S_F_ov : Finset F :=
      ov_sets.attach.biUnion (fun S =>
        packClearSet 1 (ov_n₀ S) (ov_n₁ S) (ov_r₀ S) (ov_r₁ S)
          (ov_f S) (ov_α S) (ov_h S) (ov_γ S))

    choose hg_mem _hg_ne hg_rho hy_rho using hBase
    choose ga_N₀ ga_n₀ ga_n₁ ga_r₀ ga_r₁ ga_f ga_α ga_h ga_γ
      hga_fα hga_hγ hga_sum hga_fclr hga_hclr using
      fun a : Fin (N + 1) => hClear_bad a ⟨g_a a, hg_mem a⟩ (hg_rho a)
    let S_F_ga : Finset F :=
      Finset.univ.biUnion (fun a : Fin (N + 1) =>
        packClearSet ((g_a a) ^ (ga_N₀ a)) (ga_n₀ a) (ga_n₁ a) (ga_r₀ a) (ga_r₁ a)
          (ga_f a) (ga_α a) (ga_h a) (ga_γ a))

    let u_vec_val : ∀ (a : Fin (N + 1)), (Fin (r_a a) → ↥(Y_a a)) → F :=
      fun a y_vec => ∏ j : Fin (r_a a), ((y_vec j : F) - φ_VF (c_aj a j (y_vec j)))
    have hu_vec_mem : ∀ (a : Fin (N + 1)) (y_vec : Fin (r_a a) → ↥(Y_a a)),
        u_vec_val a y_vec ∈ B {a} :=
      fun a y_vec => (B {a}).prod_mem fun j _ =>
        (B {a}).sub_mem (hY_mem a _ (y_vec j).2) (hV_Ba a (c_aj a j (y_vec j)))
    have hu_vec_rho : ∀ (a : Fin (N + 1)) (y_vec : Fin (r_a a) → ↥(Y_a a))
        (j₀ : Fin (r_a a)),
        ρ_a a j₀ ⟨u_vec_val a y_vec, hu_vec_mem a y_vec⟩ = 0 := by
      intro a y_vec j₀
      let factor_sub : Fin (r_a a) → ↥(B {a}) := fun j =>
        ⟨(y_vec j : F), (hy_rho a (y_vec j)).choose⟩ -
        ⟨φ_VF (c_aj a j (y_vec j)), hV_Ba a (c_aj a j (y_vec j))⟩
      have hsub_eq : (⟨u_vec_val a y_vec, hu_vec_mem a y_vec⟩ : ↥(B {a})) =
          ∏ j : Fin (r_a a), factor_sub j := by
        apply Subtype.ext
        simp [u_vec_val, factor_sub]
      rw [hsub_eq, map_prod]
      refine Finset.prod_eq_zero (Finset.mem_univ j₀) ?_
      dsimp [factor_sub]
      rw [map_sub, (hy_rho a (y_vec j₀)).choose_spec j₀, hρ_V a j₀ (c_aj a j₀ (y_vec j₀))]
      exact sub_self _
    choose uv_N₀ uv_n₀ uv_n₁ uv_r₀ uv_r₁ uv_f uv_α uv_h uv_γ
      huv_fα huv_hγ huv_sum huv_fclr huv_hclr using
      fun (a : Fin (N + 1)) (y_vec : Fin (r_a a) → ↥(Y_a a)) =>
        hClear_bad a ⟨u_vec_val a y_vec, hu_vec_mem a y_vec⟩ (hu_vec_rho a y_vec)
    let S_F_uv : Finset F :=
      Finset.univ.biUnion (fun a : Fin (N + 1) =>
        Finset.univ.biUnion (fun y_vec : Fin (r_a a) → ↥(Y_a a) =>
          packClearSet ((u_vec_val a y_vec) ^ (uv_N₀ a y_vec))
            (uv_n₀ a y_vec) (uv_n₁ a y_vec) (uv_r₀ a y_vec) (uv_r₁ a y_vec)
            (uv_f a y_vec) (uv_α a y_vec) (uv_h a y_vec) (uv_γ a y_vec)))

    let S_V_tc : Finset ↥V :=
      S_V_pen ∪
      Finset.univ.biUnion (fun a : Fin (N + 1) =>
        Finset.univ.biUnion (fun j : Fin (r_a a) =>
          (Y_a a).attach.image (fun y => c_aj a j y)))
    let S_F_tc : Finset F := S_F_ov ∪ (S_F_ga ∪ S_F_uv)

    refine ⟨S_V_tc, S_F_tc,
      fun v hv => Finset.mem_union_left _ hv,
      fun a j y => Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨a, Finset.mem_univ a,
          Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j,
            Finset.mem_image_of_mem _ (Finset.mem_attach _ y)⟩⟩),
      ?_, ?_, ?_⟩
    · intro S hcard A hcap
      let S_s : ↥ov_sets := ⟨S, Finset.mem_filter.mpr ⟨Finset.mem_univ S, hcard⟩⟩
      obtain ⟨hfα, hhγ, hfc, hhc⟩ := hPack_lift 1 (ov_n₀ S_s) (ov_n₁ S_s) (ov_r₀ S_s) (ov_r₁ S_s)
        (ov_f S_s) (ov_α S_s) (ov_h S_s) (ov_γ S_s)
        (fun z hz => Finset.mem_union_left _
          (Finset.mem_biUnion.mpr ⟨S_s, Finset.mem_attach _ S_s, hz⟩))
        hcap (hov_fα S_s) (hov_hγ S_s)
        (fun i => by simpa using hov_fclr S_s i)
        (fun j => by simpa using hov_hclr S_s j)
      exact ⟨ov_n₀ S_s, ov_n₁ S_s, ov_r₀ S_s, ov_r₁ S_s, ov_f S_s, ov_α S_s, ov_h S_s, ov_γ S_s,
        hfα, hhγ, hov_sum S_s, hfc, hhc⟩
    · intro a A hcap
      obtain ⟨hfα, hhγ, hfc, hhc⟩ := hPack_lift ((g_a a) ^ (ga_N₀ a))
        (ga_n₀ a) (ga_n₁ a) (ga_r₀ a) (ga_r₁ a) (ga_f a) (ga_α a) (ga_h a) (ga_γ a)
        (fun z hz => Finset.mem_union_right _ (Finset.mem_union_left _
          (Finset.mem_biUnion.mpr ⟨a, Finset.mem_univ a, hz⟩)))
        hcap (hga_fα a) (hga_hγ a) (hga_fclr a) (hga_hclr a)
      exact ⟨ga_N₀ a, ga_n₀ a, ga_n₁ a, ga_r₀ a, ga_r₁ a, ga_f a, ga_α a, ga_h a, ga_γ a,
        hfα, hhγ, hga_sum a, hfc, hhc⟩
    · intro a y_vec A hcap
      obtain ⟨hfα, hhγ, hfc, hhc⟩ := hPack_lift ((u_vec_val a y_vec) ^ (uv_N₀ a y_vec))
        (uv_n₀ a y_vec) (uv_n₁ a y_vec) (uv_r₀ a y_vec) (uv_r₁ a y_vec)
        (uv_f a y_vec) (uv_α a y_vec) (uv_h a y_vec) (uv_γ a y_vec)
        (fun z hz => Finset.mem_union_right _ (Finset.mem_union_right _
          (Finset.mem_biUnion.mpr ⟨a, Finset.mem_univ a,
            Finset.mem_biUnion.mpr ⟨y_vec, Finset.mem_univ y_vec, hz⟩⟩)))
        hcap (huv_fα a y_vec) (huv_hγ a y_vec) (huv_fclr a y_vec) (huv_hclr a y_vec)
      exact ⟨uv_N₀ a y_vec, uv_n₀ a y_vec, uv_n₁ a y_vec, uv_r₀ a y_vec, uv_r₁ a y_vec,
        uv_f a y_vec, uv_α a y_vec, uv_h a y_vec, uv_γ a y_vec,
        hfα, hhγ, huv_sum a y_vec, hfc, hhc⟩

  obtain ⟨S_V_tc, S_F_tc, hSV_pen_sub, hc_aj_tc, hClr_ov_β, hClr_ga_β, hClr_uv_β⟩ := hClearTables_ex

  
  
  
  refine ⟨S_V_tc, S_F_tc, ?_⟩
  intro R_β B_β hSV_tc hBβ_mono hBβ_S hBβ_a
  have hSV_pen : ∀ v ∈ S_V_pen, v ∈ R_β := fun v hv => hSV_tc v (hSV_pen_sub v hv)
  have hc_aj_Rβ : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)) (y : ↥(Y_a a)), c_aj a j y ∈ R_β :=
    fun a j y => hSV_tc _ (hc_aj_tc a j y)

  let ψ_β : ↥R_β →+* F := φ_VF.comp R_β.subtype
  let C_β : Set F := Set.range ψ_β
  let R_β0 : Subring F := Subring.closure (C_β ∪ {t₀} ∪ Set.range gen₀)
  let R_β1 : Subring F := Subring.closure (C_β ∪ {s₁} ∪ Set.range gen₁)
  let R_β01 : Subring F := Subring.closure ((R_β0 : Set F) ∪ {s₁})
  let D_β0 : Finset (Fin (N + 1)) → Subring F :=
    fun S => Subring.closure ((B_β S : Set F) ∪ (R_β0 : Set F))
  let D_β1 : Finset (Fin (N + 1)) → Subring F :=
    fun S => Subring.closure ((B_β S : Set F) ∪ (R_β1 : Set F))
  let D_β01 : Finset (Fin (N + 1)) → Subring F :=
    fun S => Subring.closure ((B_β S : Set F) ∪ (R_β01 : Set F))

  have ht₀_Rβ0 : t₀ ∈ R_β0 :=
    Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _ rfl))
  have hs₁_Rβ1 : s₁ ∈ R_β1 :=
    Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_right _ rfl))
  have hCβ_Rβ0 : ∀ r : ↥R_β, ψ_β r ∈ R_β0 :=
    fun r => Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ ⟨r, rfl⟩))
  have hCβ_Rβ1 : ∀ r : ↥R_β, ψ_β r ∈ R_β1 :=
    fun r => Subring.subset_closure (Set.mem_union_left _ (Set.mem_union_left _ ⟨r, rfl⟩))
  have hgen₀_Rβ0 : ∀ μ : Fin d₀, gen₀ μ ∈ R_β0 :=
    fun μ => Subring.subset_closure (Set.mem_union_right _ ⟨μ, rfl⟩)
  have hgen₁_Rβ1 : ∀ ν : Fin d₁, gen₁ ν ∈ R_β1 :=
    fun ν => Subring.subset_closure (Set.mem_union_right _ ⟨ν, rfl⟩)

  obtain ⟨⟨Q_one, hQ_one⟩, hQ_mul_ex, hs₁M_Rβ1, hm₁_Rβ0_ex, hp0_β, hp1_β, hp01_β⟩ :=
    hPenLift R_β hSV_pen
  choose Q_mul hQ_mul using hQ_mul_ex
  choose m₁_β hm₁_β using hm₁_Rβ0_ex

  
  have hM₀_span : ∀ (R' : Type u) [CommRing R'] (φ' : R' →+* F) (ι : ↥R_β →+* R'),
      φ'.comp ι = ψ_β →
      ∀ w ∈ Subring.closure (Set.range φ' ∪ {t₀} ∪ Set.range gen₀),
        ∃ P : Fin d₀ → Polynomial R',
          w = ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (P μ) * gen₀ μ := by
    intro R' _ φ' ι hι
    let P_one : Fin d₀ → Polynomial R' := fun μ => Polynomial.map ι (Q_one μ)
    have hP_one : (1 : F) = ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (P_one μ) * gen₀ μ := by
      conv_lhs => rw [hQ_one]
      refine Finset.sum_congr rfl fun μ _ => ?_
      dsimp [P_one]
      rw [Polynomial.eval₂_map, hι]
    let P_mul : Fin d₀ → Fin d₀ → Fin d₀ → Polynomial R' :=
      fun μ₁ μ₂ μ => Polynomial.map ι (Q_mul μ₁ μ₂ μ)
    have hP_mul : ∀ μ₁ μ₂ : Fin d₀,
        gen₀ μ₁ * gen₀ μ₂ = ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (P_mul μ₁ μ₂ μ) * gen₀ μ := by
      intro μ₁ μ₂
      conv_lhs => rw [hQ_mul μ₁ μ₂]
      refine Finset.sum_congr rfl fun μ _ => ?_
      dsimp [P_mul]
      rw [Polynomial.eval₂_map, hι]
    let M₀_sub : Subring F :=
      { carrier := {w : F | ∃ P : Fin d₀ → Polynomial R',
          w = ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (P μ) * gen₀ μ}
        mul_mem' := by
          rintro _ _ ⟨P₁, rfl⟩ ⟨P₂, rfl⟩
          refine ⟨fun μ => ∑ μ₁ : Fin d₀, ∑ μ₂ : Fin d₀,
            P₁ μ₁ * P₂ μ₂ * P_mul μ₁ μ₂ μ, ?_⟩
          have h_rhs : ∑ μ : Fin d₀,
              Polynomial.eval₂ φ' t₀
                (∑ μ₁ : Fin d₀, ∑ μ₂ : Fin d₀, P₁ μ₁ * P₂ μ₂ * P_mul μ₁ μ₂ μ) * gen₀ μ =
              ∑ μ₁ : Fin d₀, ∑ μ₂ : Fin d₀,
                Polynomial.eval₂ φ' t₀ (P₁ μ₁) * Polynomial.eval₂ φ' t₀ (P₂ μ₂) *
                  (∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (P_mul μ₁ μ₂ μ) * gen₀ μ) := by
            calc
              _ = ∑ μ : Fin d₀, ∑ μ₁ : Fin d₀, ∑ μ₂ : Fin d₀,
                    Polynomial.eval₂ φ' t₀ (P₁ μ₁) * Polynomial.eval₂ φ' t₀ (P₂ μ₂) *
                      Polynomial.eval₂ φ' t₀ (P_mul μ₁ μ₂ μ) * gen₀ μ := by
                    refine Finset.sum_congr rfl fun μ _ => ?_
                    rw [Polynomial.eval₂_finsetSum, Finset.sum_mul]
                    refine Finset.sum_congr rfl fun μ₁ _ => ?_
                    rw [Polynomial.eval₂_finsetSum, Finset.sum_mul]
                    refine Finset.sum_congr rfl fun μ₂ _ => ?_
                    rw [Polynomial.eval₂_mul, Polynomial.eval₂_mul]
              _ = ∑ μ₁ : Fin d₀, ∑ μ₂ : Fin d₀, ∑ μ : Fin d₀,
                    Polynomial.eval₂ φ' t₀ (P₁ μ₁) * Polynomial.eval₂ φ' t₀ (P₂ μ₂) *
                      (Polynomial.eval₂ φ' t₀ (P_mul μ₁ μ₂ μ) * gen₀ μ) := by
                    rw [Finset.sum_comm]
                    refine Finset.sum_congr rfl fun μ₁ _ => ?_
                    rw [Finset.sum_comm]
                    refine Finset.sum_congr rfl fun μ₂ _ => Finset.sum_congr rfl fun μ _ => ?_
                    ring
              _ = _ := by
                    refine Finset.sum_congr rfl fun μ₁ _ => Finset.sum_congr rfl fun μ₂ _ => ?_
                    rw [← Finset.mul_sum]
          rw [h_rhs]
          calc
            (∑ μ₁ : Fin d₀, Polynomial.eval₂ φ' t₀ (P₁ μ₁) * gen₀ μ₁) *
                (∑ μ₂ : Fin d₀, Polynomial.eval₂ φ' t₀ (P₂ μ₂) * gen₀ μ₂)
                = ∑ μ₁ : Fin d₀, ∑ μ₂ : Fin d₀,
                    Polynomial.eval₂ φ' t₀ (P₁ μ₁) * Polynomial.eval₂ φ' t₀ (P₂ μ₂) *
                      (gen₀ μ₁ * gen₀ μ₂) := by
                  rw [Finset.sum_mul]
                  refine Finset.sum_congr rfl fun μ₁ _ => ?_
                  rw [Finset.mul_sum]
                  refine Finset.sum_congr rfl fun μ₂ _ => ?_
                  ring
            _ = _ := by
                  refine Finset.sum_congr rfl fun μ₁ _ => Finset.sum_congr rfl fun μ₂ _ => ?_
                  rw [hP_mul μ₁ μ₂]
        one_mem' := ⟨P_one, hP_one⟩
        add_mem' := by
          rintro _ _ ⟨P₁, rfl⟩ ⟨P₂, rfl⟩
          refine ⟨fun μ => P₁ μ + P₂ μ, ?_⟩
          simp only [Polynomial.eval₂_add, add_mul, Finset.sum_add_distrib]
        zero_mem' := ⟨fun _ => 0, by simp⟩
        neg_mem' := by
          rintro _ ⟨P₁, rfl⟩
          refine ⟨fun μ => -P₁ μ, ?_⟩
          simp only [Polynomial.eval₂_neg, neg_mul, Finset.sum_neg_distrib] }
    have hle : Subring.closure (Set.range φ' ∪ {t₀} ∪ Set.range gen₀) ≤ M₀_sub := by
      rw [Subring.closure_le]
      rintro z ((⟨r', rfl⟩ | hz_t) | ⟨μ₀, rfl⟩)
      · refine ⟨fun μ => Polynomial.C r' * P_one μ, ?_⟩
        calc
          φ' r' = φ' r' * 1 := (mul_one _).symm
          _ = φ' r' * ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (P_one μ) * gen₀ μ := by rw [← hP_one]
          _ = ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (Polynomial.C r' * P_one μ) * gen₀ μ := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun μ _ => ?_
            rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, mul_assoc]
      · rw [Set.mem_singleton_iff] at hz_t
        subst z
        refine ⟨fun μ => Polynomial.X * P_one μ, ?_⟩
        calc
          t₀ = t₀ * 1 := (mul_one _).symm
          _ = t₀ * ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (P_one μ) * gen₀ μ := by rw [← hP_one]
          _ = ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (Polynomial.X * P_one μ) * gen₀ μ := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun μ _ => ?_
            rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, mul_assoc]
      · refine ⟨fun μ => if μ = μ₀ then 1 else 0, ?_⟩
        calc
          gen₀ μ₀ = ∑ μ : Fin d₀, if μ = μ₀ then gen₀ μ else 0 := by simp
          _ = ∑ μ : Fin d₀, Polynomial.eval₂ φ' t₀ (if μ = μ₀ then 1 else 0) * gen₀ μ := by
            refine Finset.sum_congr rfl fun μ _ => ?_
            split_ifs <;> simp
    intro w hw
    exact hle hw

  
  have hRβ01_alt : R_β01 = Subring.closure ((R_β1 : Set F) ∪ {t₀}) := by
    let sub10 : Subring F := Subring.closure ((R_β1 : Set F) ∪ {t₀})
    change R_β01 = sub10
    apply le_antisymm
    · rw [Subring.closure_le]
      rintro z (hz | hz)
      · revert z
        change R_β0 ≤ sub10
        rw [Subring.closure_le]
        rintro z ((⟨r, rfl⟩ | hz_t) | ⟨μ, rfl⟩)
        · exact Subring.subset_closure (Set.mem_union_left _ (hCβ_Rβ1 r))
        · exact Subring.subset_closure (Set.mem_union_right _ hz_t)
        · have h1 : s₁ ^ M_pole * gen₀ μ ∈ sub10 :=
            Subring.subset_closure (Set.mem_union_left _ (hs₁M_Rβ1 μ))
          have h2 : t₀ ^ M_pole ∈ sub10 :=
            sub10.pow_mem (Subring.subset_closure (Set.mem_union_right _ rfl)) M_pole
          have heq : (s₁ ^ M_pole * gen₀ μ) * t₀ ^ M_pole = gen₀ μ := by
            calc
              (s₁ ^ M_pole * gen₀ μ) * t₀ ^ M_pole = gen₀ μ * (t₀ * s₁) ^ M_pole := by
                rw [mul_pow]; ring
              _ = gen₀ μ := by rw [hts, one_pow, mul_one]
          rw [← heq]
          exact sub10.mul_mem h1 h2
      · rw [Set.mem_singleton_iff] at hz
        subst z
        exact Subring.subset_closure (Set.mem_union_left _ hs₁_Rβ1)
    · rw [Subring.closure_le]
      rintro z (hz | hz)
      · revert z
        change R_β1 ≤ R_β01
        rw [Subring.closure_le]
        rintro z ((⟨r, rfl⟩ | hz_s) | ⟨ν, rfl⟩)
        · exact Subring.subset_closure (Set.mem_union_left _ (hCβ_Rβ0 r))
        · exact Subring.subset_closure (Set.mem_union_right _ hz_s)
