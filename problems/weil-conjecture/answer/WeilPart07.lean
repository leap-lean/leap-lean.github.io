          rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
          have h1 : ρ_fun (Fin.castAdd N a).succ = MvPolynomial.X a.succ := by simp [ρ_fun]
          have h2 : (q_m ∘ z_gen) (Fin.castAdd N a).succ = q_m (y_gen a.succ) := by simp [z_gen]
          rw [h1, h2, MvPolynomial.aeval_X, hy_gen a.succ]
        · intro d
          change (MvPolynomial.aeval P₁.val) ((MvPolynomial.aeval ρ_fun) (MvPolynomial.X (Fin.natAdd r d).succ)) =
            (MvPolynomial.aeval (q_m ∘ z_gen)) (MvPolynomial.X (Fin.natAdd r d).succ)
          rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
          have h1 : ρ_fun (Fin.natAdd r d).succ = G_bar d := by simp [ρ_fun]
          have h2 : (q_m ∘ z_gen) (Fin.natAdd r d).succ = q_m (x_gen d) := by simp [z_gen]
          rw [h1, h2, hG_bar d]
    have hker_pi_bar : ∀ F_bar : MvPolynomial (Fin (r + N + 1)) k_bar, pi_bar_alg F_bar = 0 → F_bar ∈ I_bar := by
      intro F_bar hF_bar
      have h1 : (MvPolynomial.aeval P₁.val) (ρ F_bar) = 0 := by
        rw [← AlgHom.comp_apply, hρ_eval, hF_bar]
      have h2 : ρ F_bar ∈ Ideal.span (Set.range P₁.relation) := by
        rw [P₁.span_range_relation_eq_ker]
        exact h1
      have h3 : MvPolynomial.rename ι_Y (ρ F_bar) ∈ I_bar := by
        have hle : Ideal.span (Set.range P₁.relation) ≤
            Ideal.comap (MvPolynomial.rename ι_Y).toRingHom I_bar := by
          rw [Ideal.span_le]
          rintro _ ⟨b, rfl⟩
          change MvPolynomial.rename ι_Y (P₁.relation b) ∈ I_bar
          have hQb : Q_bar (Fin.castAdd N b) = MvPolynomial.rename ι_Y (P₁.relation b) := by
            simp [Q_bar]
          rw [← hQb]
          exact Ideal.subset_span ⟨Fin.castAdd N b, rfl⟩
        exact hle h2
      have h4 := AlgHom.congr_fun hρ_mod F_bar
      change Ideal.Quotient.mk I_bar (MvPolynomial.rename ι_Y (ρ F_bar)) = Ideal.Quotient.mk I_bar F_bar at h4
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr h3] at h4
      exact Ideal.Quotient.eq_zero_iff_mem.mp h4.symm
    let π_poly : P_big →+* MvPolynomial (Fin (r + N + 1)) k_bar :=
      MvPolynomial.map (Ideal.Quotient.mk m_R)
    have hπ_poly_surj : Function.Surjective π_poly :=
      MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
    have h_comm_sq : q_m.comp π_alg.toRingHom = pi_bar_alg.toRingHom.comp π_poly := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change q_m ((MvPolynomial.aeval z_gen) (MvPolynomial.C c)) =
          (MvPolynomial.aeval (q_m ∘ z_gen)) (MvPolynomial.map (Ideal.Quotient.mk m_R) (MvPolynomial.C c))
        rw [MvPolynomial.aeval_C, MvPolynomial.map_C, MvPolynomial.aeval_C]
        rfl
      · intro k
        change q_m ((MvPolynomial.aeval z_gen) (MvPolynomial.X k)) =
          (MvPolynomial.aeval (q_m ∘ z_gen)) (MvPolynomial.map (Ideal.Quotient.mk m_R) (MvPolynomial.X k))
        rw [MvPolynomial.map_X, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        rfl
    let I_m : Ideal P_big := Ideal.map MvPolynomial.C m_R
    have hπ_poly_Im_le : I_m ≤ RingHom.ker π_poly := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      change MvPolynomial.map (Ideal.Quotient.mk m_R) (MvPolynomial.C m) = 0
      rw [MvPolynomial.map_C, Ideal.Quotient.eq_zero_iff_mem.mpr hm, map_zero]
    have h_lift_mA' : ∀ x ∈ m_A', ∃ c ∈ I_m, π_alg c = x := by
      intro x hx
      change x ∈ Ideal.span (algebraMap R A' '' (m_R : Set R)) at hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨m, hm, rfl⟩
        exact ⟨MvPolynomial.C m, Ideal.mem_map_of_mem _ hm, MvPolynomial.aeval_C z_gen m⟩
      · exact ⟨0, I_m.zero_mem, map_zero π_alg⟩
      · rintro x₁ x₂ _ _ ⟨c₁, hc₁, rfl⟩ ⟨c₂, hc₂, rfl⟩
        exact ⟨c₁ + c₂, I_m.add_mem hc₁ hc₂, map_add π_alg c₁ c₂⟩
      · rintro a x₀ _ ⟨c, hc, rfl⟩
        obtain ⟨H, rfl⟩ := hSurj a
        exact ⟨H * c, I_m.mul_mem_left H hc, map_mul π_alg H c⟩
    choose Q₀ hQ₀ using fun j : Fin (r + N) => hπ_poly_surj (Q_bar j)
    have hQ₀_mA' : ∀ j : Fin (r + N), π_alg (Q₀ j) ∈ m_A' := by
      intro j
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change (q_m.comp π_alg.toRingHom) (Q₀ j) = 0
      rw [h_comm_sq]
      change pi_bar_alg (π_poly (Q₀ j)) = 0
      rw [hQ₀ j, hpi_bar_Q_bar j]
    choose c_Q hc_Q_mem hc_Q_eq using fun j : Fin (r + N) => h_lift_mA' (π_alg (Q₀ j)) (hQ₀_mA' j)
    let Q : Fin (r + N) → P_big := fun j => Q₀ j - c_Q j
    have hQ_ker : ∀ j : Fin (r + N), π_alg (Q j) = 0 := by
      intro j
      simp [Q, hc_Q_eq j]
    have hQ_mod : ∀ j : Fin (r + N), π_poly (Q j) = Q_bar j := by
      intro j
      have hc0 : π_poly (c_Q j) = 0 := hπ_poly_Im_le (hc_Q_mem j)
      simp [Q, hQ₀ j, hc0]
    let M_lift : Matrix (Fin (r + N)) (Fin (r + N)) P_big :=
      Matrix.of fun (i j : Fin (r + N)) => MvPolynomial.pderiv i.succ (Q j)
    let Δ_lift : P_big := M_lift.det
    let M_bar : Matrix (Fin (r + N)) (Fin (r + N)) (MvPolynomial (Fin (r + N + 1)) k_bar) :=
      π_poly.mapMatrix M_lift
    have hpderiv_X_not_Y : ∀ (d : Fin N) (p : MvPolynomial (Fin (r + 1)) k_bar),
        MvPolynomial.pderiv (ι_X d) (MvPolynomial.rename ι_Y p) = 0 := by
      intro d p
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro hmem
      have himg := MvPolynomial.vars_rename ι_Y p hmem
      rcases Finset.mem_image.mp himg with ⟨k, _, hk⟩
      exact hι_X_not_Y d ⟨k, hk⟩
    let J₁₁ : Matrix (Fin r) (Fin r) (MvPolynomial (Fin (r + N + 1)) k_bar) :=
      (MvPolynomial.rename ι_Y).toRingHom.mapMatrix P₁.jacobiMatrix
    let J₁₂ : Matrix (Fin r) (Fin N) (MvPolynomial (Fin (r + N + 1)) k_bar) :=
      Matrix.of fun a d => M_bar (finSumFinEquiv (Sum.inl a)) (finSumFinEquiv (Sum.inr d))
    have hM_bar_blocks :
        Matrix.reindex finSumFinEquiv.symm finSumFinEquiv.symm M_bar =
          Matrix.fromBlocks J₁₁ J₁₂ 0 1 := by
      refine Matrix.ext fun x y => ?_
      rcases x with a | c <;> rcases y with b | d
      · change π_poly (MvPolynomial.pderiv (Fin.castAdd N a).succ (Q (Fin.castAdd N b))) =
          MvPolynomial.rename ι_Y (P₁.jacobiMatrix a b)
        rw [← MvPolynomial.pderiv_map, hQ_mod]
        dsimp only [Q_bar]
        rw [Fin.addCases_left]
