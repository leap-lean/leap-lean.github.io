        haveI : AlgebraicGeometry.Etale e := he
        haveI : AlgebraicGeometry.Etale (j₀ ≫ e) := inferInstance
        let φ₀ : R₀ →+* A₀ := (AlgebraicGeometry.Spec.preimage (j₀ ≫ e)).hom
        have hφ₀_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) = j₀ ≫ e :=
          AlgebraicGeometry.Spec.map_preimage (j₀ ≫ e)
        have hφ₀_etale : φ₀.Etale := by
          rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)]
          change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀))
          rw [hφ₀_spec]; infer_instance
        let α₀ : ↥V →+* A₀ := φ₀.comp c₀
        have hα₀_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) = hV₀.fromSpec ≫ g_semi := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom c₀ ≫ CommRingCat.ofHom φ₀) =
