        · have hFin_orig : {v : PrimeSpectrum B |
              φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ v.asIdeal ∧
              φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ v.asIdeal}.Finite :=
            (hNodalLoc B φ₂ hφ₂_et).2.1
          refine (hFin_orig.image ι_WU.base).subset ?_
          rintro z ⟨⟨v, rfl⟩, hzSing⟩
          refine ⟨v, ⟨?_, ?_⟩, rfl⟩
          · by_contra hx0
            exact hzSing (hOffSm v 0 hx0)
          · by_contra hx1
            exact hzSing (hOffSm v 1 hx1)
      choose O hO_open hy_O hO_fin using hLocalFin
      have hSub : Sing ⊆ ⋃ y : Sing, O y := by
        intro y hy
