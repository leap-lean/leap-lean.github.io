      have hj₁₂ : j₁ ≠ j₂ := by intro h; have := congrArg Fin.val h; dsimp [j₁, j₂] at this; omega
      apply hNo3
      refine ⟨(τ_Y j₀).base pt₀, (τ_Y j₁).base pt₀, (τ_Y j₂).base pt₀,
        hτ_inj hj₀₁, hτ_inj hj₀₂, hτ_inj hj₁₂,
        hZ_univ ▸ Set.mem_univ _, hZ_univ ▸ Set.mem_univ _, hZ_univ ▸ Set.mem_univ _, ?_⟩
      intro q hq
      rcases hq with rfl | rfl | rfl
      · exact Or.inr ⟨j₀, s₀.base pt₀, (hτ_fst j₀).symm⟩
      · exact Or.inr ⟨j₁, s₀.base pt₀, (hτ_fst j₁).symm⟩
      · exact Or.inr ⟨j₂, s₀.base pt₀, (hτ_fst j₂).symm⟩
    have hCardCompGe2 : 2 ≤ Nat.card ↥(irreducibleComponents ↥Y) := by
      obtain ⟨y', hy'⟩ := hY'_ne
      simp only [Y'_set, Set.mem_iUnion, Set.mem_sdiff, Set.mem_singleton_iff] at hy'
      rcases hy' with ⟨E', ⟨hE'_mem, hE'_ne⟩, _hy'E'⟩
      have : Finite ↥(irreducibleComponents ↥Y) := hFin.to_subtype
      have : Nontrivial ↥(irreducibleComponents ↥Y) :=
        ⟨⟨Z, hZ_mem⟩, ⟨E', hE'_mem⟩, fun h => hE'_ne (congrArg Subtype.val h).symm⟩
      have h1lt : 1 < Nat.card ↥(irreducibleComponents ↥Y) :=
        Finite.one_lt_card_iff_nontrivial.mpr inferInstance
      omega
    have hΔ_ne : Δ.Nonempty := by
      by_contra hΔ_empty
      have hΔ_eq_emp : Z ∩ Y'_set = ∅ := Set.not_nonempty_iff_eq_empty.mp hΔ_empty
      have hZc_eq : Zᶜ = Y'_set := by
        ext y
        simp only [Set.mem_compl_iff]
        constructor
        · intro hyNotZ
          have hyU : y ∈ Z ∪ Y'_set := hUnion_univ ▸ Set.mem_univ y
          exact hyU.resolve_left hyNotZ
        · intro hyY' hyZ
          have hyEmp : y ∈ (∅ : Set ↥Y) := hΔ_eq_emp ▸ ⟨hyZ, hyY'⟩
          exact False.elim hyEmp
      have hOpen_Z : IsOpen Z := isClosed_compl_iff.mp (hZc_eq.symm ▸ hClosed_Y')
      have hClosed_Z : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ_mem
      have hZ_univ : Z = Set.univ := IsClopen.eq_univ ⟨hClosed_Z, hOpen_Z⟩ hZ_mem.1.1
      obtain ⟨y', hy'⟩ := hY'_ne
      have hy'_emp : y' ∈ (∅ : Set ↥Y) := by
        rw [← hΔ_eq_emp, hZ_univ]
        exact ⟨Set.mem_univ y', hy'⟩
      exact hy'_emp
    have hΔ_spec : ∀ q ∈ Δ, ∃ E' ∈ irreducibleComponents ↥Y, E' ≠ Z ∧ q ∈ E' := by
      intro q hq
      have hqY' : q ∈ Y'_set := hq.2
      simp only [Y'_set, Set.mem_iUnion, Set.mem_sdiff, Set.mem_singleton_iff] at hqY'
      rcases hqY' with ⟨E', ⟨hE'_mem, hE'_ne⟩, hqE'⟩
      exact ⟨E', hE'_mem, hE'_ne, hqE'⟩
    have hΔ_no3 : ∀ {q₁ q₂ q₃ : ↥Y},
        q₁ ∈ Δ → q₂ ∈ Δ → q₃ ∈ Δ → q₁ ≠ q₂ → q₁ ≠ q₃ → q₂ ≠ q₃ → False := by
      intro q₁ q₂ q₃ hq₁ hq₂ hq₃ h12 h13 h23
      apply hNo3
      refine ⟨q₁, q₂, q₃, h12, h13, h23, hq₁.1, hq₂.1, hq₃.1, ?_⟩
      intro q hq
      rcases hq with rfl | rfl | rfl
      · exact Or.inl (hΔ_spec _ hq₁)
      · exact Or.inl (hΔ_spec _ hq₂)
      · exact Or.inl (hΔ_spec _ hq₃)
    have hΔ_fin_bounds : Δ.Finite ∧ 1 ≤ Δ.ncard ∧ Δ.ncard ≤ 2 := by
      obtain ⟨q₁, hq₁⟩ := hΔ_ne
      by_cases hSub1 : Δ ⊆ {q₁}
      · have hΔ_eq : Δ = {q₁} :=
          Set.Subset.antisymm hSub1 (Set.singleton_subset_iff.mpr hq₁)
        rw [hΔ_eq]
        refine ⟨Set.finite_singleton q₁, ?_⟩
        rw [Set.ncard_singleton q₁]
        omega
      · obtain ⟨q₂, hq₂, hq₂_not⟩ := Set.not_subset.mp hSub1
        have hq₁₂ : q₁ ≠ q₂ := fun h => hq₂_not (Set.mem_singleton_iff.mpr h.symm)
        have hΔ_eq : Δ = {q₁, q₂} := by
          ext q₃
          simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
          constructor
          · intro hq₃
            by_contra hnot
            rcases not_or.mp hnot with ⟨hne₁, hne₂⟩
            exact hΔ_no3 hq₁ hq₂ hq₃ hq₁₂ (Ne.symm hne₁) (Ne.symm hne₂)
          · rintro (rfl | rfl)
            · exact hq₁
            · exact hq₂
        rw [hΔ_eq]
        refine ⟨(Set.finite_singleton q₂).insert q₁, ?_⟩
        rw [Set.ncard_pair hq₁₂]
        omega
    have hNonSmΔ : ∀ q ∈ Δ, ¬ ∃ V_sm : Y.Opens,
        q ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ π_Y) := by
      intro q hq ⟨V_sm, hq_Vsm, hSm⟩
      obtain ⟨E', hE'_mem, hE'_ne, hqE'⟩ := hΔ_spec q hq
      exact hE'_ne (h_smooth_unique_comp q V_sm hq_Vsm hSm E' Z hE'_mem hZ_mem hqE' hq.1)
    have hMarkAvoidΔ : ∀ (q : ↥Y) (j : Fin n), q ∈ Δ →
        fst_Y.base q ∉ Set.range (τ j).base := by
      intro q j hq ⟨b, hb⟩
      obtain ⟨V_C, hb_VC, hSm_C⟩ := hSmSec j b
      let W_sm : Y.Opens := (TopologicalSpace.Opens.map fst_Y.base).obj V_C
      have hq_Wsm : q ∈ W_sm := by
        change fst_Y.base q ∈ V_C
        rwa [← hb]
      have hPb_W : CategoryTheory.IsPullback (fst_Y ∣_ V_C) (W_sm.ι ≫ π_Y) (V_C.ι ≫ g) s₀ :=
        (AlgebraicGeometry.isPullback_morphismRestrict fst_Y V_C).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback g s₀)
      have hSm_W : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ π_Y) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_W hSm_C
      exact hNonSmΔ q hq ⟨W_sm, hq_Wsm, hSm_W⟩
    have hCard2Mark : Δ.ncard = 2 → ∀ (q : ↥Y) (j : Fin n), q ∈ Z →
        fst_Y.base q ∉ Set.range (τ j).base := by
      intro hCard2 q j hqZ hmem
      obtain ⟨q_a, q_b, hne_ab, hΔ_ab⟩ := Set.ncard_eq_two.mp hCard2
      have hq_a : q_a ∈ Δ := hΔ_ab ▸ Set.mem_insert q_a {q_b}
      have hq_b : q_b ∈ Δ := hΔ_ab ▸ Set.mem_insert_of_mem q_a (Set.mem_singleton q_b)
      have hne_aq : q_a ≠ q := fun h => hMarkAvoidΔ q_a j hq_a (h ▸ hmem)
      have hne_bq : q_b ≠ q := fun h => hMarkAvoidΔ q_b j hq_b (h ▸ hmem)
      apply hNo3
      refine ⟨q_a, q_b, q, hne_ab, hne_aq, hne_bq, hq_a.1, hq_b.1, hqZ, ?_⟩
      intro r hr
      rcases hr with rfl | rfl | rfl
      · exact Or.inl (hΔ_spec _ hq_a)
      · exact Or.inl (hΔ_spec _ hq_b)
      · exact Or.inr ⟨j, hmem⟩
    have hCard1Mark : Δ.ncard = 1 → ∀ (i j : Fin n) (q₁ q₂ : ↥Y),
        q₁ ∈ Z → q₂ ∈ Z →
        fst_Y.base q₁ ∈ Set.range (τ i).base →
        fst_Y.base q₂ ∈ Set.range (τ j).base →
        i = j := by
      intro hCard1 i j q₁ q₂ hq₁Z hq₂Z h₁ h₂
      obtain ⟨q₀, hΔ_0⟩ := Set.ncard_eq_one.mp hCard1
      have hq₀ : q₀ ∈ Δ := hΔ_0 ▸ Set.mem_singleton q₀
      have hne_01 : q₀ ≠ q₁ := fun h => hMarkAvoidΔ q₀ i hq₀ (h ▸ h₁)
      have hne_02 : q₀ ≠ q₂ := fun h => hMarkAvoidΔ q₀ j hq₀ (h ▸ h₂)
      have hq₁₂_eq : q₁ = q₂ := by
        by_contra hne_12
        apply hNo3
        refine ⟨q₀, q₁, q₂, hne_01, hne_02, hne_12, hq₀.1, hq₁Z, hq₂Z, ?_⟩
        intro r hr
        rcases hr with rfl | rfl | rfl
        · exact Or.inl (hΔ_spec _ hq₀)
        · exact Or.inr ⟨i, h₁⟩
        · exact Or.inr ⟨j, h₂⟩
      by_contra hij
      exact Set.disjoint_left.mp (hDisj hij) h₁ (hq₁₂_eq ▸ h₂)
    exact ⟨Z, Z_sch, ιZ, hZ_mem, hCl_ιZ, hInt_Z, hRange_ιZ, hP1,
      hClosed_Y', hY'_ne, hUnion_univ,
      hΔ_fin_bounds.1, hΔ_fin_bounds.2.1, hΔ_fin_bounds.2.2,
      hMarkAvoidΔ, hNonSmΔ, hCard2Mark, hCard1Mark, hCardCompGe2⟩

theorem weil_smooth_one_point_clean_etale_chart (K' : Type u) [Field K']
    (A' : CommRingCat.{u})
    (ιK : CommRingCat.of K' ⟶ A')
    (ev : A' ⟶ CommRingCat.of K')
    (hev : ιK ≫ ev = 𝟙 (CommRingCat.of K'))
    (V : (AlgebraicGeometry.Spec A').Opens)
    (hp : (⟨RingHom.ker ev.hom, RingHom.ker_isPrime ev.hom⟩ : PrimeSpectrum A') ∈ V)
    (hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (V.ι ≫ AlgebraicGeometry.Spec.map ιK)) :
    ∃ (h : A'),
      ev.hom h = 1 ∧
      ∀ (f : A') (hf : IsUnit (ev.hom (h * f))),
        ∃ (g : MvPolynomial (Fin 1) K' →+* Localization.Away (h * f)),
          g.comp MvPolynomial.C = (algebraMap A' (Localization.Away (h * f))).comp ιK.hom ∧
          RingHom.Etale g ∧
          (IsLocalization.Away.lift (h * f) hf : Localization.Away (h * f) →+* K')
            (g (MvPolynomial.X 0)) = 0 ∧
          RingHom.ker (IsLocalization.Away.lift (h * f) hf : Localization.Away (h * f) →+* K') =
            Ideal.span {g (MvPolynomial.X 0)} :=
by
  have hev_apply : ∀ c : K', ev.hom (ιK.hom c) = c := fun c => by
    have h1 := congrArg (fun φ : CommRingCat.of K' ⟶ CommRingCat.of K' => φ.hom c) hev
    simpa using h1
  
  
  
  have hStage1 : ∃ (a₀ : A') (ha₀ : ev.hom a₀ = 1)
      (g₀ : MvPolynomial (Fin 1) K' →+* Localization.Away a₀),
      g₀.comp MvPolynomial.C = (algebraMap A' (Localization.Away a₀)).comp ιK.hom ∧
      RingHom.Etale g₀ ∧
      (IsLocalization.Away.lift a₀ (ha₀.symm ▸ isUnit_one : IsUnit (ev.hom a₀)) :
        Localization.Away a₀ →+* K') (g₀ (MvPolynomial.X 0)) = 0 := by
    let p : PrimeSpectrum A' := ⟨RingHom.ker ev.hom, RingHom.ker_isPrime ev.hom⟩
    let x : ↥V.toScheme := ⟨p, hp⟩
    let f_sm : V.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of K') :=
      V.ι ≫ AlgebraicGeometry.Spec.map ιK
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_sm := hSm
    obtain ⟨U₀, _hU₀, W₀, hW₀, hx, e, hStd₀⟩ :=
      AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
        (n := 1) (f := f_sm) x
    have hU₀_top : U₀ = ⊤ := by
      ext q
      constructor
      · intro _; trivial
      · intro _
        rw [Subsingleton.elim q (f_sm.base x)]
        exact e hx
    subst hU₀_top
    let W'₀ : (AlgebraicGeometry.Spec A').Opens := (V.ι.opensFunctor).obj W₀
    have hW'₀ : AlgebraicGeometry.IsAffineOpen W'₀ := hW₀.image_of_isOpenImmersion V.ι
    have hp_W'₀ : p ∈ W'₀ := ⟨x, hx, rfl⟩
    have e_W : W₀ ≤ (TopologicalSpace.Opens.map V.ι.base).obj W'₀ := fun z hz => ⟨z, hz, rfl⟩
    obtain ⟨_, ⟨a'₀, rfl⟩, hp_a'₀, ha'₀_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hp_W'₀
    have hev_a'₀ : ev.hom a'₀ ≠ 0 := by
      have hnot : a'₀ ∉ p.asIdeal := (PrimeSpectrum.mem_basicOpen a'₀ p).mp hp_a'₀
      simpa [p, RingHom.mem_ker] using hnot
    let a₀ : A' := ιK.hom ((ev.hom a'₀)⁻¹) * a'₀
    have ha₀ : ev.hom a₀ = 1 := by
      simp only [a₀, map_mul, hev_apply]
      exact inv_mul_cancel₀ hev_a'₀
    let D₀ : (AlgebraicGeometry.Spec A').Opens := PrimeSpectrum.basicOpen a₀
    have hD₀_W'₀ : D₀ ≤ W'₀ := by
      refine le_trans ?_ ha'₀_le
      intro q hq
      change a₀ ∉ q.asIdeal at hq
      change a'₀ ∉ q.asIdeal
      intro ha'₀_mem
      exact hq (q.asIdeal.mul_mem_left _ ha'₀_mem)
    have e_top_W'₀ : W'₀ ≤ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map ιK).base).obj ⊤ :=
      fun _ _ => trivial
    have e_top_D₀ : D₀ ≤ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map ιK).base).obj ⊤ :=
      fun _ _ => trivial
    have happ_V : V.ι.appLE W'₀ W₀ e_W =
        𝟙 ((AlgebraicGeometry.Spec A').presheaf.obj (Opposite.op W'₀)) := by
      rw [AlgebraicGeometry.Scheme.Opens.ι_appLE]
      refine Eq.trans
        (congrArg (AlgebraicGeometry.Spec A').presheaf.map
          (Subsingleton.elim _ (𝟙 (Opposite.op W'₀)))) ?_
      exact (AlgebraicGeometry.Spec A').presheaf.map_id (Opposite.op W'₀)
    have happ_comp : (AlgebraicGeometry.Spec.map ιK).appLE ⊤ W'₀ e_top_W'₀ =
        f_sm.appLE ⊤ W₀ e := by
      have h1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V.ι (AlgebraicGeometry.Spec.map ιK)
        ⊤ W'₀ W₀ e_top_W'₀ e_W
      erw [happ_V, CategoryTheory.Category.comp_id] at h1
      exact h1
    have hStd_W'₀ : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((AlgebraicGeometry.Spec.map ιK).appLE ⊤ W'₀ e_top_W'₀).hom := by
      rw [happ_comp]
      exact hStd₀
    let s_top : ↑((AlgebraicGeometry.Spec A').presheaf.obj (Opposite.op ⊤)) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso A').inv.hom a₀
    let s_W : ↑((AlgebraicGeometry.Spec A').presheaf.obj (Opposite.op W'₀)) :=
      ((AlgebraicGeometry.Spec A').presheaf.map (CategoryTheory.homOfLE (le_top : W'₀ ≤ ⊤)).op).hom s_top
    have hbO_top : (AlgebraicGeometry.Spec A').basicOpen s_top = D₀ :=
      AlgebraicGeometry.basicOpen_eq_of_affine a₀
    have hbO_W : (AlgebraicGeometry.Spec A').basicOpen s_W = D₀ := by
      rw [(AlgebraicGeometry.Spec A').basicOpen_res, hbO_top, inf_eq_right.mpr hD₀_W'₀]
    haveI : IsLocalization.Away s_W
        ↑((AlgebraicGeometry.Spec A').presheaf.obj
          (Opposite.op ((AlgebraicGeometry.Spec A').basicOpen s_W))) :=
      hW'₀.isLocalization_basicOpen s_W
    have hStd_bO : RingHom.IsStandardSmoothOfRelativeDimension 0
        ((AlgebraicGeometry.Spec A').presheaf.map
          (CategoryTheory.homOfLE ((AlgebraicGeometry.Spec A').basicOpen_le s_W)).op).hom := by
      have h_alg : algebraMap ↑((AlgebraicGeometry.Spec A').presheaf.obj (Opposite.op W'₀))
          ↑((AlgebraicGeometry.Spec A').presheaf.obj
            (Opposite.op ((AlgebraicGeometry.Spec A').basicOpen s_W))) =
          ((AlgebraicGeometry.Spec A').presheaf.map
            (CategoryTheory.homOfLE ((AlgebraicGeometry.Spec A').basicOpen_le s_W)).op).hom := rfl
      rw [← h_alg]
      exact RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway s_W
    let iso_bO : (AlgebraicGeometry.Spec A').presheaf.obj
          (Opposite.op ((AlgebraicGeometry.Spec A').basicOpen s_W)) ≅
        (AlgebraicGeometry.Spec A').presheaf.obj (Opposite.op D₀) :=
      (AlgebraicGeometry.Spec A').presheaf.mapIso (CategoryTheory.eqToIso (congrArg Opposite.op hbO_W))
    let e_bO : ↑((AlgebraicGeometry.Spec A').presheaf.obj
          (Opposite.op ((AlgebraicGeometry.Spec A').basicOpen s_W))) ≃+*
        ↑((AlgebraicGeometry.Spec A').presheaf.obj (Opposite.op D₀)) :=
      { toFun := iso_bO.hom.hom
        invFun := iso_bO.inv.hom
        left_inv := fun z => congrArg (fun φ => CommRingCat.Hom.hom φ z) iso_bO.hom_inv_id
        right_inv := fun z => congrArg (fun φ => CommRingCat.Hom.hom φ z) iso_bO.inv_hom_id
        map_mul' := map_mul _
        map_add' := map_add _ }
    have hStd_res : RingHom.IsStandardSmoothOfRelativeDimension 0
        ((AlgebraicGeometry.Spec A').presheaf.map (CategoryTheory.homOfLE hD₀_W'₀).op).hom := by
      have h_res_eq : ((AlgebraicGeometry.Spec A').presheaf.map (CategoryTheory.homOfLE hD₀_W'₀).op).hom =
          e_bO.toRingHom.comp ((AlgebraicGeometry.Spec A').presheaf.map
            (CategoryTheory.homOfLE ((AlgebraicGeometry.Spec A').basicOpen_le s_W)).op).hom := by
        have h_cat : (AlgebraicGeometry.Spec A').presheaf.map
              (CategoryTheory.homOfLE ((AlgebraicGeometry.Spec A').basicOpen_le s_W)).op ≫ iso_bO.hom =
            (AlgebraicGeometry.Spec A').presheaf.map (CategoryTheory.homOfLE hD₀_W'₀).op := by
          dsimp [iso_bO]
          rw [← (AlgebraicGeometry.Spec A').presheaf.map_comp]
          congr 1
        exact (congrArg CommRingCat.Hom.hom h_cat).symm
      rw [h_res_eq]
      exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _ e_bO hStd_bO
    have hStd_D₀ : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀).hom := by
      have h_comp_eq : ((AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀).hom =
          ((AlgebraicGeometry.Spec A').presheaf.map (CategoryTheory.homOfLE hD₀_W'₀).op).hom.comp
            ((AlgebraicGeometry.Spec.map ιK).appLE ⊤ W'₀ e_top_W'₀).hom := by
        have h_cat := AlgebraicGeometry.Scheme.Hom.appLE_map (AlgebraicGeometry.Spec.map ιK)
          e_top_W'₀ (CategoryTheory.homOfLE hD₀_W'₀).op
        exact (congrArg CommRingCat.Hom.hom h_cat).symm
      rw [h_comp_eq]
      exact hStd_res.comp hStd_W'₀
    let R₀ := Localization.Away a₀
    let iso_Y := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).symm
    let e_Y : ↑(CommRingCat.of K') ≃+*
        ↑((AlgebraicGeometry.Spec (CommRingCat.of K')).presheaf.obj (Opposite.op ⊤)) :=
      { toFun := iso_Y.hom.hom
        invFun := iso_Y.inv.hom
        left_inv := fun z => congrArg (fun φ => CommRingCat.Hom.hom φ z) iso_Y.hom_inv_id
        right_inv := fun z => congrArg (fun φ => CommRingCat.Hom.hom φ z) iso_Y.inv_hom_id
        map_mul' := map_mul _
        map_add' := map_add _ }
    haveI : IsLocalization.Away a₀
        ↑((AlgebraicGeometry.Spec.structureSheaf ↑A').obj.obj (Opposite.op D₀)) :=
      AlgebraicGeometry.StructureSheaf.IsLocalization.to_basicOpen ↑A' a₀
    let e_loc : ↑((AlgebraicGeometry.Spec.structureSheaf ↑A').obj.obj (Opposite.op D₀)) ≃ₐ[↑A'] R₀ :=
      IsLocalization.algEquiv (Submonoid.powers a₀)
        ↑((AlgebraicGeometry.Spec.structureSheaf ↑A').obj.obj (Opposite.op D₀)) R₀
    have hStd_R₀ : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((algebraMap ↑A' R₀).comp ιK.hom) := by
      have h1 := RingHom.isStandardSmoothOfRelativeDimension_respectsIso.right
        ((AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀).hom e_Y hStd_D₀
      have h2 := RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left
        (((AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀).hom.comp e_Y.toRingHom)
        e_loc.toRingEquiv h1
      have h_eq_hom : e_loc.toRingEquiv.toRingHom.comp
          ((((AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀).hom).comp e_Y.toRingHom) =
          (algebraMap ↑A' R₀).comp ιK.hom := by
        have h_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
            (AlgebraicGeometry.Spec.map ιK).appTop =
            ιK ≫ (AlgebraicGeometry.Scheme.ΓSpecIso A').inv := by
          rw [CategoryTheory.Iso.inv_comp_eq, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Scheme.ΓSpecIso_naturality ιK, CategoryTheory.Category.assoc,
            CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id]
        have h_cat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
            (AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀ =
            ιK ≫ CommRingCat.ofHom
              (algebraMap ↑A' ↑((AlgebraicGeometry.Spec.structureSheaf ↑A').presheaf.obj (Opposite.op D₀))) := by
          have happTop_res : (AlgebraicGeometry.Spec.map ιK).appTop ≫
              (AlgebraicGeometry.Spec A').presheaf.map (CategoryTheory.homOfLE (le_top : D₀ ≤ ⊤)).op =
              (AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀ :=
            AlgebraicGeometry.Scheme.Hom.appLE_map (AlgebraicGeometry.Spec.map ιK)
              (U := ⊤) (fun _ _ => trivial) (CategoryTheory.homOfLE (le_top : D₀ ≤ ⊤)).op
          rw [← happTop_res, ← CategoryTheory.Category.assoc, h_nat, CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Scheme.toOpen_eq A' D₀]
          rfl
        ext c
        have hc := congrArg (fun φ : CommRingCat.of K' ⟶
          (AlgebraicGeometry.Spec A').presheaf.obj (Opposite.op D₀) => e_loc (φ.hom c)) h_cat
        change (e_loc.toRingEquiv.toRingHom.comp
            (((AlgebraicGeometry.Spec.map ιK).appLE ⊤ D₀ e_top_D₀).hom.comp e_Y.toRingHom)) c =
          e_loc (algebraMap ↑A' _ (ιK.hom c)) at hc
        rw [AlgEquiv.commutes] at hc
        exact hc
      erw [h_eq_hom] at h2
      exact h2
    obtain ⟨g_raw, hg_raw_C, hg_raw_et⟩ := hStd_R₀.exists_etale_mvPolynomial
    let hu_a₀ : IsUnit (ev.hom a₀) := ha₀.symm ▸ isUnit_one
    let π₀ : R₀ →+* K' := IsLocalization.Away.lift a₀ hu_a₀
    let c₀ : K' := π₀ (g_raw (MvPolynomial.X 0))
    let τ : MvPolynomial (Fin 1) K' →+* MvPolynomial (Fin 1) K' :=
      (MvPolynomial.aeval (fun _ : Fin 1 => MvPolynomial.X 0 - MvPolynomial.C c₀)).toRingHom
    let τ_inv : MvPolynomial (Fin 1) K' →+* MvPolynomial (Fin 1) K' :=
      (MvPolynomial.aeval (fun _ : Fin 1 => MvPolynomial.X 0 + MvPolynomial.C c₀)).toRingHom
    have hτ_left : τ_inv.comp τ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [τ, τ_inv]
      · intro i
        rw [Subsingleton.elim i 0]
        simp [τ, τ_inv]
    have hτ_right : τ.comp τ_inv = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [τ, τ_inv]
      · intro i
        rw [Subsingleton.elim i 0]
        simp [τ, τ_inv]
    have hτ_bij : Function.Bijective τ :=
      ⟨fun p₁ p₂ h => by
        have h1 := congrArg τ_inv h
        simpa using (RingHom.congr_fun hτ_left p₁).symm.trans (h1.trans (RingHom.congr_fun hτ_left p₂)),
       fun p => ⟨τ_inv p, RingHom.congr_fun hτ_right p⟩⟩
    let g₀ : MvPolynomial (Fin 1) K' →+* R₀ := g_raw.comp τ
    have hg₀_C : g₀.comp MvPolynomial.C = (algebraMap ↑A' R₀).comp ιK.hom := by
      have hτ_C : τ.comp MvPolynomial.C = MvPolynomial.C := by
        ext c; simp [τ]
      rw [RingHom.comp_assoc, hτ_C, hg_raw_C]
    have hg₀_et : RingHom.Etale g₀ :=
      RingHom.Etale.stableUnderComposition τ g_raw (RingHom.Etale.of_bijective hτ_bij) hg_raw_et
    have hg₀_X : π₀ (g₀ (MvPolynomial.X 0)) = 0 := by
      have hX : g₀ (MvPolynomial.X 0) = g_raw (MvPolynomial.X 0) - g_raw (MvPolynomial.C c₀) := by
        simp [g₀, τ]
      have hC : g_raw (MvPolynomial.C c₀) = algebraMap ↑A' R₀ (ιK.hom c₀) :=
        RingHom.congr_fun hg_raw_C c₀
      rw [hX, map_sub, hC, IsLocalization.Away.lift_eq a₀ hu_a₀, hev_apply]
      exact sub_self c₀
    exact ⟨a₀, ha₀, g₀, hg₀_C, hg₀_et, hg₀_X⟩

  obtain ⟨a₀, ha₀, g₀, hg₀_C, hg₀_et, hg₀_X⟩ := hStage1
  have hπ₀_C_apply : ∀ c : K',
      (IsLocalization.Away.lift a₀ (ha₀.symm ▸ isUnit_one : IsUnit (ev.hom a₀)) :
        Localization.Away a₀ →+* K') (g₀ (MvPolynomial.C c)) = c := fun c => by
    have hc : g₀ (MvPolynomial.C c) = algebraMap ↑A' (Localization.Away a₀) (ιK.hom c) :=
      RingHom.congr_fun hg₀_C c
    rw [hc, IsLocalization.Away.lift_eq a₀ (ha₀.symm ▸ isUnit_one : IsUnit (ev.hom a₀)), hev_apply]

  
  
  
  have hStage2_gen : ∀ (R₀ : Type u) [CommRing R₀]
      (g_et : MvPolynomial (Fin 1) K' →+* R₀) (_ : RingHom.Etale g_et)
      (π₀ : R₀ →+* K'),
      (∀ c : K', π₀ (g_et (MvPolynomial.C c)) = c) →
      π₀ (g_et (MvPolynomial.X 0)) = 0 →
      ∃ (r₀ : R₀), π₀ r₀ = 1 ∧
        ∀ (y : R₀), π₀ y = 0 → r₀ * y ∈ Ideal.span {g_et (MvPolynomial.X 0)} := by
    intro R₀ _ g_et hg_et π₀ hπ_C hπ_X
    let P := MvPolynomial (Fin 1) K'
    let t₀ : R₀ := g_et (MvPolynomial.X 0)
    let I₀ : Ideal R₀ := Ideal.span {t₀}
    let Q₀ := R₀ ⧸ I₀
    let q_mk : R₀ →+* Q₀ := Ideal.Quotient.mk I₀
    letI : Algebra P R₀ := g_et.toAlgebra
    letI : Algebra K' R₀ := (g_et.comp MvPolynomial.C).toAlgebra
    haveI : IsScalarTower K' P R₀ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale P R₀ := hg_et.toAlgebra
    haveI : Algebra.FiniteType P R₀ := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.FiniteType K' R₀ :=
      Algebra.FiniteType.trans (S := P) (by infer_instance) (by infer_instance)
    haveI : Algebra.FiniteType K' Q₀ :=
      Algebra.FiniteType.of_surjective (IsScalarTower.toAlgHom K' R₀ Q₀) Ideal.Quotient.mk_surjective
    have hπ₀_ker : ∀ r ∈ I₀, π₀ r = 0 := by
      intro r hr
      rcases Ideal.mem_span_singleton.mp hr with ⟨u, rfl⟩
      simp [t₀, hπ_X]
    let π_bar : Q₀ →+* K' := Ideal.Quotient.lift I₀ π₀ hπ₀_ker
    let ι_Q : K' →+* Q₀ := algebraMap K' Q₀
    have hι_Q_eq : ∀ c : K', ι_Q c = q_mk (g_et (MvPolynomial.C c)) := fun _ => rfl
    have hπ_bar_ι : ∀ c : K', π_bar (ι_Q c) = c := fun c => by
      rw [hι_Q_eq]
      exact hπ_C c
    let n_id : Ideal Q₀ := RingHom.ker π_bar
    have hn_fg : n_id.FG := by
      obtain ⟨S_gen, hS_gen⟩ := Algebra.FiniteType.out (R := K') (A := Q₀)
      let S_set : Set Q₀ := (fun s => s - ι_Q (π_bar s)) '' (S_gen : Set Q₀)
      let J : Ideal Q₀ := Ideal.span S_set
      have hJ_le : J ≤ n_id := by
        rw [Ideal.span_le]
        rintro z ⟨s, _, rfl⟩
        change π_bar (s - ι_Q (π_bar s)) = 0
        rw [map_sub, hπ_bar_ι, sub_self]
      have h_all : ∀ q : Q₀, q - ι_Q (π_bar q) ∈ J := by
        intro q
        have hq_top : q ∈ Algebra.adjoin K' (S_gen : Set Q₀) := by
          rw [hS_gen]; trivial
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hq_top
        · intro s hs
          exact Ideal.subset_span ⟨s, hs, rfl⟩
        · intro c
          change ι_Q c - ι_Q (π_bar (ι_Q c)) ∈ J
          rw [hπ_bar_ι, sub_self]
          exact J.zero_mem
        · intro x y _ _ hx hy
          have h_add : (x + y) - ι_Q (π_bar (x + y)) = (x - ι_Q (π_bar x)) + (y - ι_Q (π_bar y)) := by
            simp only [map_add]; ring
          rw [h_add]
          exact J.add_mem hx hy
        · intro x y _ _ hx hy
          have h_mul : (x * y) - ι_Q (π_bar (x * y)) =
              x * (y - ι_Q (π_bar y)) + ι_Q (π_bar y) * (x - ι_Q (π_bar x)) := by
            simp only [map_mul]; ring
          rw [h_mul]
          exact J.add_mem (J.mul_mem_left x hy) (J.mul_mem_left _ hx)
      have hn_le_J : n_id ≤ J := by
        intro z hz
        have hz0 : π_bar z = 0 := hz
        have h1 := h_all z
        rwa [hz0, map_zero, sub_zero] at h1
      have hn_eq : n_id = J := le_antisymm hn_le_J hJ_le
      rw [hn_eq]
      exact Submodule.fg_span (S_gen.finite_toSet.image _)
    let N₂ : Ideal Q₀ := n_id • n_id
    let M := Q₀ ⧸ N₂
    let mk₂ : Q₀ →+* M := Ideal.Quotient.mk N₂
    let δ : R₀ → Q₀ := fun r => q_mk r - ι_Q (π₀ r)
    have hδ_mem : ∀ r : R₀, δ r ∈ n_id := fun r => by
      change π_bar (q_mk r - ι_Q (π₀ r)) = 0
      rw [map_sub, hπ_bar_ι]
      exact sub_self (π₀ r)
    have hδ_P : ∀ F : P, δ (g_et F) = 0 := by
      have hψ_eq : q_mk.comp g_et = (ι_Q.comp π₀).comp g_et := by
        apply MvPolynomial.ringHom_ext
        · intro c
          change q_mk (g_et (MvPolynomial.C c)) = ι_Q (π₀ (g_et (MvPolynomial.C c)))
          rw [hπ_C c, hι_Q_eq]
        · intro i
          rw [Subsingleton.elim i 0]
          change q_mk (g_et (MvPolynomial.X 0)) = ι_Q (π₀ (g_et (MvPolynomial.X 0)))
          rw [hπ_X, map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      intro F
      exact sub_eq_zero.mpr (RingHom.congr_fun hψ_eq F)
    have h_leib : ∀ r₁ r₂ : R₀,
        mk₂ (δ (r₁ * r₂)) = r₁ • mk₂ (δ r₂) + r₂ • mk₂ (δ r₁) := by
      intro r₁ r₂
      have h_diff : δ (r₁ * r₂) - (q_mk r₁ * δ r₂ + q_mk r₂ * δ r₁) = -(δ r₁ * δ r₂) := by
        simp only [δ, map_mul]
        ring
      have h_prod_mem : δ r₁ * δ r₂ ∈ N₂ :=
        Submodule.smul_mem_smul (hδ_mem r₁) (hδ_mem r₂)
      have h_sub_mem : δ (r₁ * r₂) - (q_mk r₁ * δ r₂ + q_mk r₂ * δ r₁) ∈ N₂ := by
        rw [h_diff]
        exact N₂.neg_mem h_prod_mem
      have h_eq_M : mk₂ (δ (r₁ * r₂)) = mk₂ (q_mk r₁ * δ r₂ + q_mk r₂ * δ r₁) :=
        Ideal.Quotient.eq.mpr h_sub_mem
      rw [h_eq_M, map_add]
      rfl
    let d_lin : R₀ →ₗ[P] M :=
      { toFun := fun r => mk₂ (δ r)
        map_add' := fun r₁ r₂ => by
          have h_add : δ (r₁ + r₂) = δ r₁ + δ r₂ := by
            simp only [δ, map_add]; ring
          rw [h_add, map_add]
        map_smul' := fun F r => by
          change mk₂ (δ (g_et F * r)) = F • mk₂ (δ r)
          rw [h_leib (g_et F) r, hδ_P F, map_zero, smul_zero, add_zero]
          rfl }
    let d_der : Derivation P R₀ M := Derivation.mk' d_lin h_leib
    haveI : Subsingleton Ω[R₀⁄P] := Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    have hd_zero : d_der = 0 :=
      (KaehlerDifferential.linearMapEquivDerivation P R₀).symm.injective (Subsingleton.elim _ _)
    have hn_le : n_id ≤ n_id • n_id := by
      intro z hz
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hπr : π₀ r = 0 := hz
      have hdr : d_der r = 0 := by rw [hd_zero]; rfl
      change mk₂ (q_mk r - ι_Q (π₀ r)) = 0 at hdr
      rw [hπr, map_zero, sub_zero] at hdr
      exact Ideal.Quotient.eq_zero_iff_mem.mp hdr
    obtain ⟨r_bar, hr_sub, hr_ann⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul n_id n_id hn_fg hn_le
    obtain ⟨r₀, hr₀_mk⟩ := Ideal.Quotient.mk_surjective r_bar
    have hr₀_one : π₀ r₀ = 1 := by
      have h1 : π_bar (r_bar - 1) = 0 := hr_sub
      rw [← hr₀_mk, map_sub, map_one] at h1
      exact sub_eq_zero.mp h1
    have hr₀_ann : ∀ y : R₀, π₀ y = 0 → r₀ * y ∈ I₀ := by
      intro y hy
      have hy_mem : q_mk y ∈ n_id := hy
      have h_zero : r_bar * q_mk y = 0 := hr_ann (q_mk y) hy_mem
      have h_mk : Ideal.Quotient.mk I₀ (r₀ * y) = 0 := by
        rw [map_mul, hr₀_mk]
        exact h_zero
      exact Ideal.Quotient.eq_zero_iff_mem.mp h_mk
    exact ⟨r₀, hr₀_one, hr₀_ann⟩

  obtain ⟨r₀, hr₀_one, hr₀_ann⟩ := hStage2_gen (Localization.Away a₀) g₀ hg₀_et
    (IsLocalization.Away.lift a₀ (ha₀.symm ▸ isUnit_one : IsUnit (ev.hom a₀))) hπ₀_C_apply hg₀_X

  
  
  
  have hStage3_gen : ∀ (R : Type u) [CommRing R]
      (ι_hom : K' →+* R) (ev_hom : R →+* K')
      (a : R) (ha : ev_hom a = 1)
      (R₀ : Type u) [CommRing R₀] [Algebra R R₀] [IsLocalization.Away a R₀]
      (g_a : MvPolynomial (Fin 1) K' →+* R₀),
      g_a.comp MvPolynomial.C = (algebraMap R R₀).comp ι_hom →
      RingHom.Etale g_a →
      (IsLocalization.Away.lift a (ha.symm ▸ isUnit_one : IsUnit (ev_hom a)) : R₀ →+* K')
        (g_a (MvPolynomial.X 0)) = 0 →
      ∀ (r : R₀),
        (IsLocalization.Away.lift a (ha.symm ▸ isUnit_one : IsUnit (ev_hom a)) : R₀ →+* K') r = 1 →
        (∀ y : R₀,
          (IsLocalization.Away.lift a (ha.symm ▸ isUnit_one : IsUnit (ev_hom a)) : R₀ →+* K') y = 0 →
          r * y ∈ Ideal.span {g_a (MvPolynomial.X 0)}) →
        ∃ (h : R), ev_hom h = 1 ∧
          ∀ (f : R) (hf : IsUnit (ev_hom (h * f)))
            (D : Type u) [CommRing D] [Algebra R D] [IsLocalization.Away (h * f) D],
            ∃ (g : MvPolynomial (Fin 1) K' →+* D),
              g.comp MvPolynomial.C = (algebraMap R D).comp ι_hom ∧
              RingHom.Etale g ∧
              (IsLocalization.Away.lift (h * f) hf : D →+* K') (g (MvPolynomial.X 0)) = 0 ∧
              RingHom.ker (IsLocalization.Away.lift (h * f) hf : D →+* K') =
                Ideal.span {g (MvPolynomial.X 0)} := by
    intro R _ ι_hom ev_hom a ha R₀ _ _ _ g_a hg_a_C hg_a_et hg_a_X r hr_one hr_ann
    let hu_a : IsUnit (ev_hom a) := ha.symm ▸ isUnit_one
    let π_a : R₀ →+* K' := IsLocalization.Away.lift a hu_a
    let b : R := (IsLocalization.Away.sec a r).1
    let k_exp : ℕ := (IsLocalization.Away.sec a r).2
    have hsec_r : r * algebraMap R R₀ (a ^ k_exp) = algebraMap R R₀ b :=
      IsLocalization.Away.sec_spec a r
    have hb : ev_hom b = 1 := by
      have h1 := congrArg π_a hsec_r
      rw [map_mul, hr_one,
        IsLocalization.Away.lift_eq (S := R₀) (g := ev_hom) a hu_a (a ^ k_exp),
        IsLocalization.Away.lift_eq (S := R₀) (g := ev_hom) a hu_a b,
        map_pow, ha, one_pow, mul_one] at h1
      exact h1.symm
    let h : R := a * b
    refine ⟨h, by simp [h, map_mul, ha, hb], ?_⟩
    intro f hf D _ _ _
    let ε : D →+* K' := IsLocalization.Away.lift (S := D) (g := ev_hom) (h * f) hf
    have hu_hf_D : IsUnit (algebraMap R D (h * f)) :=
      IsLocalization.Away.algebraMap_isUnit (h * f)
    obtain ⟨u_hf, hu_hf_eq⟩ := hu_hf_D
    have hu_a_D : IsUnit (algebraMap R D a) := by
      refine IsUnit.of_mul_eq_one (algebraMap R D (b * f) * ↑(u_hf⁻¹)) ?_
      calc
        algebraMap R D a * (algebraMap R D (b * f) * ↑(u_hf⁻¹))
          = (algebraMap R D a * algebraMap R D (b * f)) * ↑(u_hf⁻¹) := by ring
        _ = algebraMap R D (h * f) * ↑(u_hf⁻¹) := by
            rw [← map_mul]; dsimp [h]; rw [← mul_assoc]
        _ = ↑u_hf * ↑(u_hf⁻¹) := by rw [hu_hf_eq]
        _ = 1 := Units.mul_inv u_hf
    have hu_b_D : IsUnit (algebraMap R D b) := by
      refine IsUnit.of_mul_eq_one (algebraMap R D (a * f) * ↑(u_hf⁻¹)) ?_
      calc
        algebraMap R D b * (algebraMap R D (a * f) * ↑(u_hf⁻¹))
          = (algebraMap R D b * algebraMap R D (a * f)) * ↑(u_hf⁻¹) := by ring
        _ = algebraMap R D (h * f) * ↑(u_hf⁻¹) := by
            rw [← map_mul]; congr 2; dsimp [h]; ring
        _ = ↑u_hf * ↑(u_hf⁻¹) := by rw [hu_hf_eq]
        _ = 1 := Units.mul_inv u_hf
    let ψ : R₀ →+* D := IsLocalization.Away.lift (S := R₀) (g := algebraMap R D) a hu_a_D
    have hψ_alg : ψ.comp (algebraMap R R₀) = algebraMap R D := by
      ext x_r
      exact IsLocalization.Away.lift_eq (S := R₀) (g := algebraMap R D) a hu_a_D x_r
    let g : MvPolynomial (Fin 1) K' →+* D := ψ.comp g_a
    have hg_C : g.comp MvPolynomial.C = (algebraMap R D).comp ι_hom := by
      rw [RingHom.comp_assoc, hg_a_C, ← RingHom.comp_assoc, hψ_alg]
    have hψ_et : RingHom.Etale ψ := by
      let T' := Localization.Away (algebraMap R R₀ (b * f))
      have h_loc_mul : IsLocalization.Away (a * (b * f)) T' :=
        IsLocalization.Away.mul' R₀ T' a (b * f)
      have h_assoc_hf : a * (b * f) = h * f := (mul_assoc a b f).symm
      haveI : IsLocalization (Submonoid.powers (h * f)) T' := by
        rw [← h_assoc_hf]
        exact h_loc_mul
      let e_TD : T' ≃ₐ[R] D := IsLocalization.algEquiv (Submonoid.powers (h * f)) T' D
      have hψ_eq_TD : ψ = e_TD.toRingEquiv.toRingHom.comp (algebraMap R₀ T') := by
        apply IsLocalization.ringHom_ext (Submonoid.powers a)
        ext x_r
        simp only [RingHom.comp_apply, ψ]
        rw [IsLocalization.Away.lift_eq (S := R₀) (g := algebraMap R D) a hu_a_D x_r]
        change algebraMap R D x_r = e_TD (algebraMap R T' x_r)
        exact (e_TD.commutes x_r).symm
      have hStd_T' : RingHom.IsStandardSmoothOfRelativeDimension 0 (algebraMap R₀ T') :=
        RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
          (algebraMap R R₀ (b * f))
      have hEt_T' : RingHom.Etale (algebraMap R₀ T') := by
        rw [RingHom.etale_algebraMap, Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero,
          ← RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
        exact hStd_T'
      rw [hψ_eq_TD]
      exact RingHom.Etale.respectsIso.left (algebraMap R₀ T') e_TD.toRingEquiv hEt_T'
    have hg_et : RingHom.Etale g :=
      RingHom.Etale.stableUnderComposition g_a ψ hg_a_et hψ_et
    have hεψ : ε.comp ψ = π_a := by
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      ext x_r
      simp only [RingHom.comp_apply, ε, ψ, π_a]
      rw [IsLocalization.Away.lift_eq (S := R₀) (g := algebraMap R D) a hu_a_D x_r,
        IsLocalization.Away.lift_eq (S := D) (g := ev_hom) (h * f) hf x_r,
        IsLocalization.Away.lift_eq (S := R₀) (g := ev_hom) a hu_a x_r]
    have hg_X : ε (g (MvPolynomial.X 0)) = 0 := by
      change (ε.comp ψ) (g_a (MvPolynomial.X 0)) = 0
      rw [hεψ]
      exact hg_a_X
    have hg_ker : RingHom.ker ε = Ideal.span {g (MvPolynomial.X 0)} := by
      apply le_antisymm
      · intro z hz
        have hz0 : ε z = 0 := hz
        let a_z : R := (IsLocalization.Away.sec (h * f) z).1
        let m_exp : ℕ := (IsLocalization.Away.sec (h * f) z).2
        have hsec_z : z * algebraMap R D ((h * f) ^ m_exp) = algebraMap R D a_z :=
          IsLocalization.Away.sec_spec (h * f) z
        have hev_az : ev_hom a_z = 0 := by
          have h1 := congrArg ε hsec_z
          rw [map_mul, hz0, zero_mul,
            IsLocalization.Away.lift_eq (S := D) (g := ev_hom) (h * f) hf a_z] at h1
          exact h1.symm
        let y₀ : R₀ := algebraMap R R₀ a_z
        have hπ_y₀ : π_a y₀ = 0 := by
          dsimp [y₀]
          rw [IsLocalization.Away.lift_eq (S := R₀) (g := ev_hom) a hu_a a_z]
          exact hev_az
        obtain ⟨s₀, hs₀⟩ := Ideal.mem_span_singleton.mp (hr_ann y₀ hπ_y₀)
        have hψ_ann : ψ r * (z * algebraMap R D ((h * f) ^ m_exp)) =
            g (MvPolynomial.X 0) * ψ s₀ := by
          have h1 := congrArg ψ hs₀
          rw [map_mul, map_mul] at h1
          have hψ_y₀ : ψ y₀ = z * algebraMap R D ((h * f) ^ m_exp) := by
            dsimp [y₀]
            rw [IsLocalization.Away.lift_eq (S := R₀) (g := algebraMap R D) a hu_a_D a_z, ← hsec_z]
          rw [hψ_y₀] at h1
          exact h1
        obtain ⟨u_b, hu_b_eq⟩ := hu_b_D
        have hu_r_D : IsUnit (ψ r) := by
          have hψ_sec := congrArg ψ hsec_r
          rw [map_mul,
            IsLocalization.Away.lift_eq (S := R₀) (g := algebraMap R D) a hu_a_D (a ^ k_exp),
            IsLocalization.Away.lift_eq (S := R₀) (g := algebraMap R D) a hu_a_D b] at hψ_sec
          refine IsUnit.of_mul_eq_one (algebraMap R D (a ^ k_exp) * ↑(u_b⁻¹)) ?_
          calc
            ψ r * (algebraMap R D (a ^ k_exp) * ↑(u_b⁻¹))
              = (ψ r * algebraMap R D (a ^ k_exp)) * ↑(u_b⁻¹) := by ring
            _ = algebraMap R D b * ↑(u_b⁻¹) := by rw [hψ_sec]
            _ = ↑u_b * ↑(u_b⁻¹) := by rw [hu_b_eq]
            _ = 1 := Units.mul_inv u_b
        obtain ⟨u_r, hu_r_eq⟩ := hu_r_D
        have hu_m_D : IsUnit (algebraMap R D ((h * f) ^ m_exp)) := by
          rw [map_pow, ← hu_hf_eq]
          exact IsUnit.pow m_exp u_hf.isUnit
        obtain ⟨u_m, hu_m_eq⟩ := hu_m_D
        rw [← hu_r_eq, ← hu_m_eq] at hψ_ann
        refine Ideal.mem_span_singleton.mpr ⟨↑(u_r⁻¹) * ψ s₀ * ↑(u_m⁻¹), ?_⟩
        calc
          z = (↑(u_r⁻¹) * ↑u_r) * z * (↑u_m * ↑(u_m⁻¹)) := by
              rw [Units.inv_mul, Units.mul_inv, one_mul, mul_one]
          _ = ↑(u_r⁻¹) * (↑u_r * (z * ↑u_m)) * ↑(u_m⁻¹) := by ring
          _ = ↑(u_r⁻¹) * (g (MvPolynomial.X 0) * ψ s₀) * ↑(u_m⁻¹) := by rw [hψ_ann]
          _ = g (MvPolynomial.X 0) * (↑(u_r⁻¹) * ψ s₀ * ↑(u_m⁻¹)) := by ring
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hg_X
    exact ⟨g, hg_C, hg_et, hg_X, hg_ker⟩

  obtain ⟨h, hh, h_all⟩ := hStage3_gen ↑A' ιK.hom ev.hom a₀ ha₀
    (Localization.Away a₀) g₀ hg₀_C hg₀_et hg₀_X r₀ hr₀_one hr₀_ann
  exact ⟨h, hh, fun f hf => h_all f hf (Localization.Away (h * f))⟩

theorem weil_two_point_eqLocus_quadratic_etale_split (K' : Type u) [Field K']
    (A' : Type u) [CommRing A']
    (ιK : K' →+* A')
    (ev₁ ev₂ : A' →+* K')
    (hev₁ : ev₁.comp ιK = RingHom.id K')
    (hev₂ : ev₂.comp ιK = RingHom.id K')
    (hNeKer : RingHom.ker ev₁ ≠ RingHom.ker ev₂)
    (h₁ h₂ : A')
    (hh₁ : ev₁ h₁ = 1)
    (hh₂ : ev₂ h₂ = 1) :
    ∃ (f₁ f₂ : A')
      (hf₁ : IsUnit (ev₁ (h₁ * f₁)))
      (hf₂ : IsUnit (ev₂ (h₂ * f₂)))
      (φ_pinch : ↥(RingHom.eqLocus ev₁ ev₂) →+*
        ↥(RingHom.eqLocus
          ((IsLocalization.Away.lift (h₁ * f₁) hf₁ : Localization.Away (h₁ * f₁) →+* K').comp
            (RingHom.fst (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))
          ((IsLocalization.Away.lift (h₂ * f₂) hf₂ : Localization.Away (h₂ * f₂) →+* K').comp
            (RingHom.snd (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂)))))),
      RingHom.Etale φ_pinch ∧
      ∀ x : ↥(RingHom.eqLocus ev₁ ev₂),
        (φ_pinch x).1 =
          (algebraMap A' (Localization.Away (h₁ * f₁)) x.1,
           algebraMap A' (Localization.Away (h₂ * f₂)) x.1) :=
by
  
  have hsurj₁ : Function.Surjective ev₁ := fun c => ⟨ιK c, RingHom.congr_fun hev₁ c⟩
  have hsurj₂ : Function.Surjective ev₂ := fun c => ⟨ιK c, RingHom.congr_fun hev₂ c⟩
  have hMax₁ : (RingHom.ker ev₁).IsMaximal := RingHom.ker_isMaximal_of_surjective ev₁ hsurj₁
  have hMax₂ : (RingHom.ker ev₂).IsMaximal := RingHom.ker_isMaximal_of_surjective ev₂ hsurj₂
  have hCop : IsCoprime (RingHom.ker ev₁) (RingHom.ker ev₂) :=
    @Ideal.isCoprime_of_isMaximal _ _ _ _ hMax₁ hMax₂ hNeKer
  obtain ⟨T, hT_mem, s, hs_mem, hTs⟩ := Ideal.isCoprime_iff_exists.mp hCop
  have hT₁ : ev₁ T = 0 := hT_mem
  have hs₂ : ev₂ s = 0 := hs_mem
  have hT₂ : ev₂ T = 1 := by
    have h1 : ev₂ (T + s) = ev₂ 1 := congrArg ev₂ hTs
    rw [map_add, map_one, hs₂, add_zero] at h1
    exact h1

  
  let f₁ : A' := (1 - T) * (2 * T - 1)
  let f₂ : A' := T * (2 * T - 1)
  have hev₁_hf₁ : ev₁ (h₁ * f₁) = -1 := by
    dsimp [f₁]
    rw [map_mul, map_mul, map_sub, map_sub, map_mul, map_one, map_ofNat, hh₁, hT₁]
    ring
  have hev₂_hf₂ : ev₂ (h₂ * f₂) = 1 := by
    dsimp [f₂]
    rw [map_mul, map_mul, map_sub, map_mul, map_one, map_ofNat, hh₂, hT₂]
    ring
  have hf₁ : IsUnit (ev₁ (h₁ * f₁)) := hev₁_hf₁ ▸ isUnit_one.neg
  have hf₂ : IsUnit (ev₂ (h₂ * f₂)) := hev₂_hf₂ ▸ isUnit_one

  let x₁ : ↥(RingHom.eqLocus ev₁ ev₂) := ⟨T * (T - 1), by
    change ev₁ (T * (T - 1)) = ev₂ (T * (T - 1))
    rw [map_mul, map_sub, map_one, map_mul, map_sub, map_one, hT₁, hT₂]
    ring⟩
  let q₀ : ↥(RingHom.eqLocus ev₁ ev₂) := ⟨h₁ * (1 - T) ^ 2 + h₂ * T ^ 2, by
    change ev₁ (h₁ * (1 - T) ^ 2 + h₂ * T ^ 2) = ev₂ (h₁ * (1 - T) ^ 2 + h₂ * T ^ 2)
    rw [map_add, map_mul, map_pow, map_sub, map_one, map_mul, map_pow,
      map_add, map_mul, map_pow, map_sub, map_one, map_mul, map_pow,
      hh₁, hh₂, hT₁, hT₂]
    ring⟩
  let q₁ : ↥(RingHom.eqLocus ev₁ ev₂) := ⟨-h₁ * (1 - T) - h₂ * T, by
    change ev₁ (-h₁ * (1 - T) - h₂ * T) = ev₂ (-h₁ * (1 - T) - h₂ * T)
    rw [map_sub, map_mul, map_neg, map_sub, map_one, map_mul,
      map_sub, map_mul, map_neg, map_sub, map_one, map_mul,
      hh₁, hh₂, hT₁, hT₂]
    ring⟩

  
  let P : Polynomial ↥(RingHom.eqLocus ev₁ ev₂) :=
    Polynomial.X ^ 2 - Polynomial.X - Polynomial.C x₁
  have h12 : (1 : WithBot ℕ) < ((2 : ℕ) : WithBot ℕ) := by decide
  have h02 : (0 : WithBot ℕ) < ((2 : ℕ) : WithBot ℕ) := by decide
  have hdeg : (Polynomial.X + Polynomial.C x₁ :
      Polynomial ↥(RingHom.eqLocus ev₁ ev₂)).degree < ((2 : ℕ) : WithBot ℕ) := by
    refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) ?_
    exact max_lt (lt_of_le_of_lt Polynomial.degree_X_le h12)
      (lt_of_le_of_lt Polynomial.degree_C_le h02)
  have hMonic : P.Monic := by
    dsimp [P]
    rw [sub_sub]
    exact Polynomial.monic_X_pow_sub hdeg

  let g_poly : Polynomial ↥(RingHom.eqLocus ev₁ ev₂) :=
    (Polynomial.X - 1) * (2 * Polynomial.X - 1) * (Polynomial.C q₀ + Polynomial.C q₁ * Polynomial.X)
  have hderiv : Polynomial.derivative P = 2 * Polynomial.X - 1 := by
    dsimp [P]
    rw [Polynomial.derivative_sub, Polynomial.derivative_sub,
      Polynomial.derivative_X_pow, Polynomial.derivative_X, Polynomial.derivative_C]
    simp only [Nat.cast_ofNat, map_ofNat]
    ring
  have hcond : ∃ p₁ p₂ n, Polynomial.derivative P * p₁ + P * p₂ = g_poly ^ n := by
    refine ⟨(Polynomial.X - 1) * (Polynomial.C q₀ + Polynomial.C q₁ * Polynomial.X), 0, 1, ?_⟩
    rw [hderiv]
    dsimp [g_poly]
    ring

  let ofP : ↥(RingHom.eqLocus ev₁ ev₂) →+* AdjoinRoot P := AdjoinRoot.of P
  let w : AdjoinRoot P := AdjoinRoot.root P
  let u_g : AdjoinRoot P := Polynomial.aeval w g_poly

  have hEt_alg : RingHom.Etale ((algebraMap (AdjoinRoot P) (Localization.Away u_g)).comp ofP) := by
    let P_et : StandardEtalePair ↥(RingHom.eqLocus ev₁ ev₂) := ⟨P, hMonic, g_poly, hcond⟩
    have hEt_std : RingHom.Etale (algebraMap ↥(RingHom.eqLocus ev₁ ev₂) P_et.Ring) :=
      RingHom.etale_algebraMap.mpr inferInstance
    let w_g : Localization.Away u_g := algebraMap (AdjoinRoot P) (Localization.Away u_g) w
    have hw_g : P_et.HasMap w_g := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval (algebraMap (AdjoinRoot P) (Localization.Away u_g) w) P = 0
        rw [Polynomial.aeval_algebraMap_apply (Localization.Away u_g) w P,
            AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, map_zero]
      · change IsUnit (Polynomial.aeval (algebraMap (AdjoinRoot P) (Localization.Away u_g) w) g_poly)
        rw [Polynomial.aeval_algebraMap_apply (Localization.Away u_g) w g_poly]
        exact IsLocalization.Away.algebraMap_isUnit u_g
    let toE : P_et.Ring →ₐ[↥(RingHom.eqLocus ev₁ ev₂)] Localization.Away u_g := P_et.lift w_g hw_g
    have htoE_X : toE P_et.X = w_g := P_et.lift_X w_g hw_g
    have hX_P : Polynomial.eval₂ (↑(Algebra.ofId ↥(RingHom.eqLocus ev₁ ev₂) P_et.Ring)) P_et.X P = 0 :=
      P_et.hasMap_X.1
    have hX_g : IsUnit (Polynomial.aeval P_et.X g_poly) := P_et.hasMap_X.2
    let fromE₀ : AdjoinRoot P →ₐ[↥(RingHom.eqLocus ev₁ ev₂)] P_et.Ring :=
      AdjoinRoot.liftAlgHom P (Algebra.ofId ↥(RingHom.eqLocus ev₁ ev₂) P_et.Ring) P_et.X hX_P
    have hfromE₀_w : fromE₀ w = P_et.X := AdjoinRoot.lift_root hX_P
    have hfromE₀_ug : fromE₀ u_g = Polynomial.aeval P_et.X g_poly := by
      dsimp [u_g]
      rw [← Polynomial.aeval_algHom_apply fromE₀ w g_poly, hfromE₀_w]
    have hfromE₀_powers : ∀ y : Submonoid.powers u_g, IsUnit (fromE₀ y.1) := by
      rintro ⟨_, k, rfl⟩
      rw [map_pow, hfromE₀_ug]
      exact hX_g.pow k
    let fromE : Localization.Away u_g →ₐ[↥(RingHom.eqLocus ev₁ ev₂)] P_et.Ring :=
      IsLocalization.liftAlgHom hfromE₀_powers
    have hfromE_alg : ∀ z : AdjoinRoot P,
        fromE (algebraMap (AdjoinRoot P) (Localization.Away u_g) z) = fromE₀ z := by
      intro z
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    have hcomp₁ : fromE.comp toE = AlgHom.id ↥(RingHom.eqLocus ev₁ ev₂) P_et.Ring := by
      apply P_et.homEquiv.injective
      apply Subtype.ext
      rw [StandardEtalePair.homEquiv_apply_coe, StandardEtalePair.homEquiv_apply_coe]
      change fromE (toE P_et.X) = P_et.X
      rw [htoE_X, hfromE_alg, hfromE₀_w]
    have hcomp₂ : toE.comp fromE = AlgHom.id ↥(RingHom.eqLocus ev₁ ev₂) (Localization.Away u_g) := by
      apply IsLocalization.algHom_ext (Submonoid.powers u_g)
      apply AdjoinRoot.algHom_ext
      change toE (fromE (algebraMap (AdjoinRoot P) (Localization.Away u_g) w)) = w_g
      rw [hfromE_alg, hfromE₀_w, htoE_X]
    have hBij_toE : Function.Bijective toE.toRingHom := by
      refine ⟨?_, ?_⟩
      · intro a b hab
        have h1 := AlgHom.congr_fun hcomp₁ a
        have h2 := AlgHom.congr_fun hcomp₁ b
        simp only [AlgHom.comp_apply, AlgHom.id_apply] at h1 h2
        rw [← h1, ← h2]
        exact congrArg fromE hab
      · intro y
        refine ⟨fromE y, ?_⟩
        have h1 := AlgHom.congr_fun hcomp₂ y
        change toE (fromE y) = y at h1
        exact h1
    have hEt_toE : RingHom.Etale toE.toRingHom := RingHom.Etale.of_bijective hBij_toE
    have hEt_comp : RingHom.Etale (toE.toRingHom.comp (algebraMap ↥(RingHom.eqLocus ev₁ ev₂) P_et.Ring)) :=
      RingHom.Etale.stableUnderComposition _ _ hEt_std hEt_toE
    have hEq_hom : toE.toRingHom.comp (algebraMap ↥(RingHom.eqLocus ev₁ ev₂) P_et.Ring) =
        (algebraMap (AdjoinRoot P) (Localization.Away u_g)).comp ofP := by
      ext x
      exact (toE.commutes x).trans
        (IsScalarTower.algebraMap_apply ↥(RingHom.eqLocus ev₁ ev₂) (AdjoinRoot P) (Localization.Away u_g) x)
    rwa [hEq_hom] at hEt_comp

  
  let α₁ : A' →+* Localization.Away (h₁ * f₁) := algebraMap A' (Localization.Away (h₁ * f₁))
  let α₂ : A' →+* Localization.Away (h₂ * f₂) := algebraMap A' (Localization.Away (h₂ * f₂))
  let ε₁ : Localization.Away (h₁ * f₁) →+* K' := IsLocalization.Away.lift (h₁ * f₁) hf₁
  let ε₂ : Localization.Away (h₂ * f₂) →+* K' := IsLocalization.Away.lift (h₂ * f₂) hf₂
  let π₁ : ↥(RingHom.eqLocus
      (ε₁.comp (RingHom.fst (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))
      (ε₂.comp (RingHom.snd (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))) →+*
      Localization.Away (h₁ * f₁) :=
    (RingHom.fst _ _).comp (RingHom.eqLocus _ _).subtype
  let π₂ : ↥(RingHom.eqLocus
      (ε₁.comp (RingHom.fst (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))
      (ε₂.comp (RingHom.snd (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))) →+*
      Localization.Away (h₂ * f₂) :=
    (RingHom.snd _ _).comp (RingHom.eqLocus _ _).subtype

  let diag : ↥(RingHom.eqLocus ev₁ ev₂) →+*
      ↥(RingHom.eqLocus
        (ε₁.comp (RingHom.fst (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))
        (ε₂.comp (RingHom.snd (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))) :=
    { toFun := fun x => ⟨(α₁ x.1, α₂ x.1), by
        change ε₁ (α₁ x.1) = ε₂ (α₂ x.1)
        rw [IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ x.1,
            IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ x.1]
        exact x.2⟩
      map_one' := Subtype.ext (Prod.ext (map_one α₁) (map_one α₂))
      map_mul' := fun x y => Subtype.ext (Prod.ext (map_mul α₁ x.1 y.1) (map_mul α₂ x.1 y.1))
      map_zero' := Subtype.ext (Prod.ext (map_zero α₁) (map_zero α₂))
      map_add' := fun x y => Subtype.ext (Prod.ext (map_add α₁ x.1 y.1) (map_add α₂ x.1 y.1)) }

  let ω : ↥(RingHom.eqLocus
      (ε₁.comp (RingHom.fst (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))
      (ε₂.comp (RingHom.snd (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))) :=
    ⟨(α₁ T, α₂ (1 - T)), by
      change ε₁ (α₁ T) = ε₂ (α₂ (1 - T))
      rw [IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ T,
          IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ (1 - T),
          map_sub, map_one, hT₁, hT₂, sub_self]⟩

  have hπ₁_diag : ∀ x : ↥(RingHom.eqLocus ev₁ ev₂), π₁ (diag x) = α₁ x.1 := fun _ => rfl
  have hπ₂_diag : ∀ x : ↥(RingHom.eqLocus ev₁ ev₂), π₂ (diag x) = α₂ x.1 := fun _ => rfl
  have hπ₁_ω : π₁ ω = α₁ T := rfl
  have hπ₂_ω : π₂ ω = α₂ (1 - T) := rfl

  have hω_P : Polynomial.eval₂ diag ω P = 0 := by
    dsimp [P]
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_X, Polynomial.eval₂_C]
    apply Subtype.ext
    apply Prod.ext
    · change (π₁ ω) ^ 2 - π₁ ω - π₁ (diag x₁) = 0
      rw [hπ₁_ω, hπ₁_diag, ← map_pow, ← map_sub, ← map_sub]
      convert map_zero α₁ using 1
      dsimp [x₁]
      ring
    · change (π₂ ω) ^ 2 - π₂ ω - π₂ (diag x₁) = 0
      rw [hπ₂_ω, hπ₂_diag, ← map_pow, ← map_sub, ← map_sub]
      convert map_zero α₂ using 1
      dsimp [x₁]
      ring

  let Θ₀ := AdjoinRoot.lift diag ω hω_P
  let ψ₁ : AdjoinRoot P →+* Localization.Away (h₁ * f₁) := π₁.comp Θ₀
  let ψ₂ : AdjoinRoot P →+* Localization.Away (h₂ * f₂) := π₂.comp Θ₀

  let δ : AdjoinRoot P := (w - 1) * (2 * w - 1)
  let γ : AdjoinRoot P := ofP q₀ + ofP q₁ * w
  have hu_g_eq : u_g = δ * γ := by
    dsimp [u_g, g_poly, δ, γ, ofP, w]
    simp only [map_mul, map_add, map_sub, map_one, map_ofNat,
      Polynomial.aeval_X, Polynomial.aeval_C]
    rfl

  have hΘ₀_of : ∀ x : ↥(RingHom.eqLocus ev₁ ev₂), Θ₀ (ofP x) = diag x := fun _ =>
    AdjoinRoot.lift_of hω_P
  have hΘ₀_w : Θ₀ w = ω := AdjoinRoot.lift_root hω_P
  have hψ₁_w : ψ₁ w = α₁ T := by dsimp [ψ₁]; rw [hΘ₀_w, hπ₁_ω]
  have hψ₂_w : ψ₂ w = α₂ (1 - T) := by dsimp [ψ₂]; rw [hΘ₀_w, hπ₂_ω]

  have hπ₁_lin : ∀ c₀ c₁ : ↥(RingHom.eqLocus ev₁ ev₂),
      π₁ (Θ₀ (ofP c₀ + ofP c₁ * w)) = α₁ (c₀.1 + c₁.1 * T) := by
    intro c₀ c₁
    rw [Θ₀.map_add, Θ₀.map_mul, hΘ₀_of, hΘ₀_of, hΘ₀_w,
        π₁.map_add, π₁.map_mul, hπ₁_diag, hπ₁_diag, hπ₁_ω, ← α₁.map_mul, ← α₁.map_add]
  have hπ₂_lin : ∀ c₀ c₁ : ↥(RingHom.eqLocus ev₁ ev₂),
      π₂ (Θ₀ (ofP c₀ + ofP c₁ * w)) = α₂ (c₀.1 + c₁.1 * (1 - T)) := by
    intro c₀ c₁
    rw [Θ₀.map_add, Θ₀.map_mul, hΘ₀_of, hΘ₀_of, hΘ₀_w,
        π₂.map_add, π₂.map_mul, hπ₂_diag, hπ₂_diag, hπ₂_ω, ← α₂.map_mul, ← α₂.map_add]

  have hπ₁_δ : π₁ (Θ₀ δ) = α₁ (-f₁) := by
    change ψ₁ ((w - 1) * (2 * w - 1)) = α₁ (-f₁)
    rw [ψ₁.map_mul, ψ₁.map_sub, ψ₁.map_sub, ψ₁.map_mul, ψ₁.map_one, map_ofNat ψ₁ 2, hψ₁_w]
    dsimp [f₁]
    rw [α₁.map_neg, α₁.map_mul, α₁.map_sub, α₁.map_sub, α₁.map_mul, α₁.map_one, map_ofNat α₁ 2]
    ring
  have hπ₂_δ : π₂ (Θ₀ δ) = α₂ f₂ := by
    change ψ₂ ((w - 1) * (2 * w - 1)) = α₂ f₂
    rw [ψ₂.map_mul, ψ₂.map_sub, ψ₂.map_sub, ψ₂.map_mul, ψ₂.map_one, map_ofNat ψ₂ 2, hψ₂_w]
    dsimp [f₂]
    rw [α₂.map_mul, α₂.map_sub, α₂.map_sub, α₂.map_mul, α₂.map_one, map_ofNat α₂ 2]
    ring
  have hπ₁_γ : π₁ (Θ₀ γ) = α₁ (-(h₁ * f₁)) := by
    refine (hπ₁_lin q₀ q₁).trans ?_
    congr 1
    dsimp [q₀, q₁, f₁]
    ring
  have hπ₂_γ : π₂ (Θ₀ γ) = α₂ (h₂ * f₂) := by
    refine (hπ₂_lin q₀ q₁).trans ?_
    congr 1
    dsimp [q₀, q₁, f₂]
    ring

  have h_ug_unit : IsUnit (Θ₀ u_g) := by
    let U₁ : (Localization.Away (h₁ * f₁))ˣ :=
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (h₁ * f₁)) (h₁ * f₁)).unit
    let U₂ : (Localization.Away (h₂ * f₂))ˣ :=
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (h₂ * f₂)) (h₂ * f₂)).unit
    have hU₁ : (U₁ : Localization.Away (h₁ * f₁)) = α₁ (h₁ * f₁) := IsUnit.unit_spec _
    have hU₂ : (U₂ : Localization.Away (h₂ * f₂)) = α₂ (h₂ * f₂) := IsUnit.unit_spec _
    let v₁ : Localization.Away (h₁ * f₁) := α₁ h₁ * (↑(U₁⁻¹) : Localization.Away (h₁ * f₁)) ^ 2
    let v₂ : Localization.Away (h₂ * f₂) := α₂ h₂ * (↑(U₂⁻¹) : Localization.Away (h₂ * f₂)) ^ 2
    have hmul₁ : π₁ (Θ₀ u_g) * v₁ = 1 := by
      rw [hu_g_eq, map_mul, map_mul, hπ₁_δ, hπ₁_γ]
      have h1 : α₁ (-f₁) * α₁ (-(h₁ * f₁)) * v₁ =
          (α₁ (h₁ * f₁) * (↑(U₁⁻¹) : Localization.Away (h₁ * f₁))) ^ 2 := by
        dsimp [v₁]
        simp only [map_neg, map_mul]
        ring
      rw [h1, ← hU₁, Units.mul_inv, one_pow]
    have hmul₂ : π₂ (Θ₀ u_g) * v₂ = 1 := by
      rw [hu_g_eq, map_mul, map_mul, hπ₂_δ, hπ₂_γ]
      have h2 : α₂ f₂ * α₂ (h₂ * f₂) * v₂ =
          (α₂ (h₂ * f₂) * (↑(U₂⁻¹) : Localization.Away (h₂ * f₂))) ^ 2 := by
        dsimp [v₂]
        simp only [map_mul]
        ring
      rw [h2, ← hU₂, Units.mul_inv, one_pow]
    have hε₁_ug : ε₁ (π₁ (Θ₀ u_g)) = 1 := by
      rw [hu_g_eq, map_mul, map_mul, hπ₁_δ, hπ₁_γ, map_mul,
          IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ (-f₁),
          IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ (-(h₁ * f₁))]
      rw [map_neg, map_neg, hev₁_hf₁]
      dsimp [f₁]
      rw [map_mul, map_sub, map_sub, map_mul, map_one, map_ofNat, hT₁]
      ring
    have hε₂_ug : ε₂ (π₂ (Θ₀ u_g)) = 1 := by
      rw [hu_g_eq, map_mul, map_mul, hπ₂_δ, hπ₂_γ, map_mul,
          IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ f₂,
          IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ (h₂ * f₂),
          hev₂_hf₂]
      dsimp [f₂]
      rw [map_mul, map_sub, map_mul, map_one, map_ofNat, hT₂]
      ring
    have hε₁_v₁ : ε₁ v₁ = 1 := by
      have h := congrArg ε₁ hmul₁
      rw [map_mul, map_one, hε₁_ug, one_mul] at h
      exact h
    have hε₂_v₂ : ε₂ v₂ = 1 := by
      have h := congrArg ε₂ hmul₂
      rw [map_mul, map_one, hε₂_ug, one_mul] at h
      exact h
    let v : ↥(RingHom.eqLocus
        (ε₁.comp (RingHom.fst (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))
        (ε₂.comp (RingHom.snd (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))) :=
      ⟨(v₁, v₂), by
        change ε₁ v₁ = ε₂ v₂
        rw [hε₁_v₁, hε₂_v₂]⟩
    have hv_mul : Θ₀ u_g * v = 1 := Subtype.ext (Prod.ext hmul₁ hmul₂)
    exact IsUnit.of_mul_eq_one v hv_mul

  let Θ : Localization.Away u_g →+*
      ↥(RingHom.eqLocus
        (ε₁.comp (RingHom.fst (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))
        (ε₂.comp (RingHom.snd (Localization.Away (h₁ * f₁)) (Localization.Away (h₂ * f₂))))) :=
    IsLocalization.Away.lift u_g h_ug_unit
  have hΘ_alg : ∀ z : AdjoinRoot P,
      Θ (algebraMap (AdjoinRoot P) (Localization.Away u_g) z) = Θ₀ z := fun z =>
    IsLocalization.Away.lift_eq u_g h_ug_unit z

  
  have hw_sq : w ^ 2 = w + ofP x₁ := by
    have h0 := AdjoinRoot.eval₂_root P
    dsimp [P] at h0
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_X, Polynomial.eval₂_C] at h0
    change w ^ 2 - w - ofP x₁ = 0 at h0
    linear_combination h0

  have hmul_E₀ : ∀ a b c d : ↥(RingHom.eqLocus ev₁ ev₂),
      (ofP a + ofP b * w) * (ofP c + ofP d * w) =
        ofP (a * c + b * d * x₁) + ofP (a * d + b * c + b * d) * w := by
    intro a b c d
    calc
      (ofP a + ofP b * w) * (ofP c + ofP d * w)
        = ofP a * ofP c + (ofP a * ofP d + ofP b * ofP c) * w + ofP b * ofP d * w ^ 2 := by ring
      _ = ofP a * ofP c + (ofP a * ofP d + ofP b * ofP c) * w + ofP b * ofP d * (w + ofP x₁) := by
        rw [hw_sq]
      _ = ofP (a * c + b * d * x₁) + ofP (a * d + b * c + b * d) * w := by
        rw [ofP.map_add, ofP.map_mul, ofP.map_mul, ofP.map_mul,
            ofP.map_add, ofP.map_add, ofP.map_mul, ofP.map_mul, ofP.map_mul]
        ring

  let ν₁ : ∀ b₁ : A', ev₁ b₁ = 0 → AdjoinRoot P := fun b₁ hb₁ =>
    ofP ⟨b₁ * (T - 1) ^ 2, by
      change ev₁ (b₁ * (T - 1) ^ 2) = ev₂ (b₁ * (T - 1) ^ 2)
      rw [map_mul, map_pow, map_sub, map_one, map_mul, map_pow, map_sub, map_one, hb₁, hT₂]
      ring⟩ +
    ofP ⟨b₁ * (T - 1), by
      change ev₁ (b₁ * (T - 1)) = ev₂ (b₁ * (T - 1))
      rw [map_mul, map_sub, map_one, map_mul, map_sub, map_one, hb₁, hT₂]
      ring⟩ * w

  let ν₂ : ∀ b₂ : A', ev₂ b₂ = 0 → AdjoinRoot P := fun b₂ hb₂ =>
    ofP ⟨b₂ * T ^ 2, by
      change ev₁ (b₂ * T ^ 2) = ev₂ (b₂ * T ^ 2)
      rw [map_mul, map_pow, map_mul, map_pow, hT₁, hb₂]
      ring⟩ +
    ofP ⟨-b₂ * T, by
      change ev₁ (-b₂ * T) = ev₂ (-b₂ * T)
      rw [map_mul, map_neg, map_mul, map_neg, hT₁, hb₂]
      ring⟩ * w

  have hν₁_congr : ∀ (b b' : A') (hb : ev₁ b = 0) (hb' : ev₁ b' = 0),
      b = b' → ν₁ b hb = ν₁ b' hb' := by
    rintro b _ hb hb' rfl
    rfl
  have hν₂_congr : ∀ (b b' : A') (hb : ev₂ b = 0) (hb' : ev₂ b' = 0),
      b = b' → ν₂ b hb = ν₂ b' hb' := by
    rintro b _ hb hb' rfl
    rfl

  have hν₁_zero : ν₁ 0 (map_zero ev₁) = 0 := by
    dsimp only [ν₁]
    refine Eq.trans (b := ofP 0 + ofP 0 * w) ?_ (by rw [ofP.map_zero, zero_mul, add_zero])
    congr 1
    · congr 1
      exact Subtype.ext (zero_mul _)
    · congr 2
      exact Subtype.ext (zero_mul _)
  have hν₂_zero : ν₂ 0 (map_zero ev₂) = 0 := by
    dsimp only [ν₂]
    refine Eq.trans (b := ofP 0 + ofP 0 * w) ?_ (by rw [ofP.map_zero, zero_mul, add_zero])
    congr 1
    · congr 1
      exact Subtype.ext (zero_mul _)
    · congr 2
      exact Subtype.ext (by simp)

  
  have hInj : Function.Injective Θ := by
    intro y₁' y₂' hy_eq
    suffices h0 : ∀ y : Localization.Away u_g, Θ y = 0 → y = 0 by
      exact sub_eq_zero.mp (h0 (y₁' - y₂') (by rw [map_sub, hy_eq, sub_self]))
    intro y hy
    let z : AdjoinRoot P := (IsLocalization.Away.sec u_g y).1
    let m : ℕ := (IsLocalization.Away.sec u_g y).2
    have hsec : y * algebraMap (AdjoinRoot P) (Localization.Away u_g) (u_g ^ m) =
        algebraMap (AdjoinRoot P) (Localization.Away u_g) z :=
      IsLocalization.Away.sec_spec u_g y
    have hΘz : Θ₀ z = 0 := by
      have h1 := congrArg Θ hsec
      rw [map_mul, hy, zero_mul, hΘ_alg] at h1
      exact h1.symm
    have hE₀_span : ∀ x : AdjoinRoot P,
        ∃ p q : ↥(RingHom.eqLocus ev₁ ev₂), x = ofP p + ofP q * w := by
      intro x
      refine AdjoinRoot.induction_on P x ?_
      intro F
      refine Polynomial.induction_on F ?_ ?_ ?_
      · intro a
        refine ⟨a, 0, ?_⟩
        rw [AdjoinRoot.mk_C, ofP.map_zero, zero_mul, add_zero]
      · rintro F₁ F₂ ⟨p₁, q₁', hF₁⟩ ⟨p₂, q₂', hF₂⟩
        refine ⟨p₁ + p₂, q₁' + q₂', ?_⟩
        rw [map_add, hF₁, hF₂, ofP.map_add, ofP.map_add]
        ring
      · rintro n a ⟨p, q, hFn⟩
        refine ⟨q * x₁, p + q, ?_⟩
        have hstep : AdjoinRoot.mk P (Polynomial.C a * Polynomial.X ^ (n + 1)) =
            AdjoinRoot.mk P (Polynomial.C a * Polynomial.X ^ n) * w := by
          rw [pow_succ, ← mul_assoc, map_mul, AdjoinRoot.mk_X]
        rw [hstep, hFn]
        calc
          (ofP p + ofP q * w) * w = ofP p * w + ofP q * w ^ 2 := by ring
          _ = ofP p * w + ofP q * (w + ofP x₁) := by rw [hw_sq]
          _ = ofP (q * x₁) + ofP (p + q) * w := by
            rw [ofP.map_mul, ofP.map_add]
            ring
    obtain ⟨p, q, hz_eq⟩ := hE₀_span z
    let a₁ : A' := p.1 + q.1 * T
    let a₂ : A' := p.1 + q.1 * (1 - T)
    have hα₁_a₁ : α₁ a₁ = 0 := by
      have h1 := congrArg π₁ hΘz
      rw [hz_eq, hπ₁_lin p q, map_zero] at h1
      exact h1
    have hα₂_a₂ : α₂ a₂ = 0 := by
      have h2 := congrArg π₂ hΘz
      rw [hz_eq, hπ₂_lin p q, map_zero] at h2
      exact h2
    have ha₁_ev : ev₁ a₁ = 0 := by
      have h := congrArg ε₁ hα₁_a₁
      rw [IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ a₁, map_zero] at h
      exact h
    have ha₂_ev : ev₂ a₂ = 0 := by
      have h := congrArg ε₂ hα₂_a₂
      rw [IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ a₂, map_zero] at h
      exact h
    have hα₁_eq : α₁ a₁ = α₁ 0 := by rw [hα₁_a₁, map_zero]
    have hα₂_eq : α₂ a₂ = α₂ 0 := by rw [hα₂_a₂, map_zero]
    obtain ⟨⟨_, n₁, rfl⟩, hn₁⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers (h₁ * f₁)) (Localization.Away (h₁ * f₁))).mp hα₁_eq
    obtain ⟨⟨_, n₂, rfl⟩, hn₂⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers (h₂ * f₂)) (Localization.Away (h₂ * f₂))).mp hα₂_eq
    simp only [mul_zero] at hn₁ hn₂
    let N : ℕ := n₁ + n₂
    have hN₁ : (h₁ * f₁) ^ N * a₁ = 0 := by
      dsimp [N]
      rw [pow_add, mul_comm ((h₁ * f₁) ^ n₁), mul_assoc, hn₁, mul_zero]
    have hN₂ : (h₂ * f₂) ^ N * a₂ = 0 := by
      dsimp [N]
      rw [pow_add, mul_assoc, hn₂, mul_zero]

    have hδ_lin : δ = ofP (x₁ + x₁ + 1) + ofP (-1) * w := by
      dsimp [δ]
      calc
        (w - 1) * (2 * w - 1) = 2 * w ^ 2 - 3 * w + 1 := by ring
        _ = 2 * (w + ofP x₁) - 3 * w + 1 := by rw [hw_sq]
        _ = ofP (x₁ + x₁ + 1) + ofP (-1) * w := by
          rw [ofP.map_add, ofP.map_add, ofP.map_one, ofP.map_neg, ofP.map_one]
          ring

    have hrec : ν₁ a₁ ha₁_ev + ν₂ a₂ ha₂_ev = δ * z := by
      rw [hz_eq, hδ_lin, hmul_E₀]
      dsimp [ν₁, ν₂]
      have hsum : ∀ c₁₀ c₁₁ c₂₀ c₂₁ : ↥(RingHom.eqLocus ev₁ ev₂),
          (ofP c₁₀ + ofP c₁₁ * w) + (ofP c₂₀ + ofP c₂₁ * w) =
            ofP (c₁₀ + c₂₀) + ofP (c₁₁ + c₂₁) * w := by
        intro c₁₀ c₁₁ c₂₀ c₂₁
        rw [ofP.map_add, ofP.map_add]
        ring
      rw [hsum]
      congr 1
      · congr 1
        apply Subtype.ext
        change a₁ * (T - 1) ^ 2 + a₂ * T ^ 2 =
          (x₁.1 + x₁.1 + 1) * p.1 + (-1) * q.1 * x₁.1
        dsimp [a₁, a₂, x₁]
        ring
      · congr 2
        apply Subtype.ext
        change a₁ * (T - 1) + -a₂ * T =
          (x₁.1 + x₁.1 + 1) * q.1 + (-1) * p.1 + (-1) * q.1
        dsimp [a₁, a₂, x₁]
        ring

    have hγ_ν₁ : ∀ (b₁ : A') (hb₁ : ev₁ b₁ = 0),
        γ * ν₁ b₁ hb₁ = ν₁ (-(h₁ * f₁) * b₁) (by rw [map_mul, hb₁, mul_zero]) := by
      intro b₁ hb₁
      dsimp [γ, ν₁]
      rw [hmul_E₀]
      congr 1
      · congr 1
        apply Subtype.ext
        change q₀.1 * (b₁ * (T - 1) ^ 2) + q₁.1 * (b₁ * (T - 1)) * x₁.1 =
          -(h₁ * f₁) * b₁ * (T - 1) ^ 2
        dsimp [q₀, q₁, x₁, f₁]
        ring
      · congr 2
        apply Subtype.ext
        change q₀.1 * (b₁ * (T - 1)) + q₁.1 * (b₁ * (T - 1) ^ 2) + q₁.1 * (b₁ * (T - 1)) =
          -(h₁ * f₁) * b₁ * (T - 1)
        dsimp [q₀, q₁, f₁]
        ring

    have hγ_ν₂ : ∀ (b₂ : A') (hb₂ : ev₂ b₂ = 0),
        γ * ν₂ b₂ hb₂ = ν₂ ((h₂ * f₂) * b₂) (by rw [map_mul, hb₂, mul_zero]) := by
      intro b₂ hb₂
      dsimp [γ, ν₂]
      rw [hmul_E₀]
      congr 1
      · congr 1
        apply Subtype.ext
        change q₀.1 * (b₂ * T ^ 2) + q₁.1 * (-b₂ * T) * x₁.1 =
          h₂ * f₂ * b₂ * T ^ 2
        dsimp [q₀, q₁, x₁, f₂]
        ring
      · congr 2
        apply Subtype.ext
        change q₀.1 * (-b₂ * T) + q₁.1 * (b₂ * T ^ 2) + q₁.1 * (-b₂ * T) =
          -(h₂ * f₂ * b₂) * T
        dsimp [q₀, q₁, f₂]
        ring

    have hγ_pow_ν₁ : ∀ (k : ℕ) (b₁ : A') (hb₁ : ev₁ b₁ = 0),
        γ ^ k * ν₁ b₁ hb₁ = ν₁ ((-(h₁ * f₁)) ^ k * b₁) (by rw [map_mul, hb₁, mul_zero]) := by
      intro k
      induction k with
      | zero =>
        intro b₁ hb₁
        simp only [pow_zero, one_mul]
      | succ k ih =>
        intro b₁ hb₁
        have hstep : γ ^ (k + 1) * ν₁ b₁ hb₁ = γ ^ k * (γ * ν₁ b₁ hb₁) := by
          rw [pow_succ]
          ring
        rw [hstep, hγ_ν₁ b₁ hb₁, ih (-(h₁ * f₁) * b₁) (by rw [map_mul, hb₁, mul_zero])]
        exact hν₁_congr
          ((-(h₁ * f₁)) ^ k * (-(h₁ * f₁) * b₁))
          ((-(h₁ * f₁)) ^ (k + 1) * b₁)
          (by rw [map_mul, map_mul, hb₁, mul_zero, mul_zero])
          (by rw [map_mul, hb₁, mul_zero])
          (by rw [pow_succ]; ring)

    have hγ_pow_ν₂ : ∀ (k : ℕ) (b₂ : A') (hb₂ : ev₂ b₂ = 0),
        γ ^ k * ν₂ b₂ hb₂ = ν₂ ((h₂ * f₂) ^ k * b₂) (by rw [map_mul, hb₂, mul_zero]) := by
      intro k
      induction k with
      | zero =>
        intro b₂ hb₂
        simp only [pow_zero, one_mul]
      | succ k ih =>
        intro b₂ hb₂
        have hstep : γ ^ (k + 1) * ν₂ b₂ hb₂ = γ ^ k * (γ * ν₂ b₂ hb₂) := by
          rw [pow_succ]
          ring
        rw [hstep, hγ_ν₂ b₂ hb₂, ih ((h₂ * f₂) * b₂) (by rw [map_mul, hb₂, mul_zero])]
        exact hν₂_congr
          ((h₂ * f₂) ^ k * (h₂ * f₂ * b₂))
          ((h₂ * f₂) ^ (k + 1) * b₂)
          (by rw [map_mul, map_mul, hb₂, mul_zero, mul_zero])
          (by rw [map_mul, hb₂, mul_zero])
          (by rw [pow_succ]; ring)

    have hkill_δz : γ ^ N * (δ * z) = 0 := by
      rw [← hrec, mul_add, hγ_pow_ν₁ N a₁ ha₁_ev, hγ_pow_ν₂ N a₂ ha₂_ev]
      have hz₁ : (-(h₁ * f₁)) ^ N * a₁ = 0 := by
        rw [neg_eq_neg_one_mul (h₁ * f₁), mul_pow, mul_assoc, hN₁, mul_zero]
      rw [hν₁_congr _ 0 (by rw [hz₁, map_zero]) (map_zero ev₁) hz₁,
          hν₂_congr _ 0 (by rw [hN₂, map_zero]) (map_zero ev₂) hN₂,
          hν₁_zero, hν₂_zero, add_zero]

    have hkill_z : u_g ^ (N + 1) * z = 0 := by
      have hpow : u_g ^ (N + 1) * z = δ ^ N * γ * (γ ^ N * (δ * z)) := by
        rw [hu_g_eq]
        ring
      rw [hpow, hkill_δz, mul_zero]

    have hu_unit : IsUnit (algebraMap (AdjoinRoot P) (Localization.Away u_g) u_g) :=
      IsLocalization.Away.algebraMap_isUnit u_g
    have hz_loc : algebraMap (AdjoinRoot P) (Localization.Away u_g) z = 0 := by
      have hmap := congrArg (algebraMap (AdjoinRoot P) (Localization.Away u_g)) hkill_z
      rw [map_mul, map_pow, map_zero] at hmap
      exact (hu_unit.pow (N + 1)).mul_right_eq_zero.mp hmap
    rw [hz_loc, map_pow] at hsec
    exact (hu_unit.pow m).mul_left_eq_zero.mp hsec

  
  have hSurj : Function.Surjective Θ := by
    let φ₁ : Localization.Away u_g →+* Localization.Away (h₁ * f₁) := π₁.comp Θ
    let φ₂ : Localization.Away u_g →+* Localization.Away (h₂ * f₂) := π₂.comp Θ
    rintro ⟨⟨d₁, d₂⟩, hb⟩
    change ε₁ d₁ = ε₂ d₂ at hb
    let c₀ : K' := ε₁ d₁
    have hc₀_ev₁ : ev₁ (ιK c₀) = c₀ := RingHom.congr_fun hev₁ c₀
    have hc₀_ev₂ : ev₂ (ιK c₀) = c₀ := RingHom.congr_fun hev₂ c₀
    let c_pinch : ↥(RingHom.eqLocus ev₁ ev₂) := ⟨ιK c₀, by
      change ev₁ (ιK c₀) = ev₂ (ιK c₀)
      rw [hc₀_ev₁, hc₀_ev₂]⟩
    let y₀ : Localization.Away u_g := algebraMap (AdjoinRoot P) (Localization.Away u_g) (ofP c_pinch)
    have hφ₁_y₀ : φ₁ y₀ = α₁ (ιK c₀) := by
      dsimp [φ₁, y₀]
      rw [hΘ_alg, hΘ₀_of]
      rfl
    have hφ₂_y₀ : φ₂ y₀ = α₂ (ιK c₀) := by
      dsimp [φ₂, y₀]
      rw [hΘ_alg, hΘ₀_of]
      rfl

    let d'₁ : Localization.Away (h₁ * f₁) := d₁ - α₁ (ιK c₀)
    let d'₂ : Localization.Away (h₂ * f₂) := d₂ - α₂ (ιK c₀)
    have hε₁_d'₁ : ε₁ d'₁ = 0 := by
      dsimp [d'₁, c₀]
      rw [map_sub, IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ (ιK c₀), hc₀_ev₁, sub_self]
    have hε₂_d'₂ : ε₂ d'₂ = 0 := by
      dsimp [d'₂, c₀]
      rw [map_sub, ← hb, IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ (ιK c₀), hc₀_ev₂, sub_self]

    let a₁ : A' := (IsLocalization.Away.sec (h₁ * f₁) d'₁).1
    let N : ℕ := (IsLocalization.Away.sec (h₁ * f₁) d'₁).2
    have hsec₁ : d'₁ * α₁ ((h₁ * f₁) ^ N) = α₁ a₁ :=
      IsLocalization.Away.sec_spec (h₁ * f₁) d'₁
    let a₂ : A' := (IsLocalization.Away.sec (h₂ * f₂) d'₂).1
    let M : ℕ := (IsLocalization.Away.sec (h₂ * f₂) d'₂).2
    have hsec₂ : d'₂ * α₂ ((h₂ * f₂) ^ M) = α₂ a₂ :=
      IsLocalization.Away.sec_spec (h₂ * f₂) d'₂

    have ha₁_ev : ev₁ a₁ = 0 := by
      have h := congrArg ε₁ hsec₁.symm
      rw [IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ a₁, map_mul, hε₁_d'₁, zero_mul] at h
      exact h
    have ha₂_ev : ev₂ a₂ = 0 := by
      have h := congrArg ε₂ hsec₂.symm
      rw [IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ a₂, map_mul, hε₂_d'₂, zero_mul] at h
      exact h

    have hπ₁_ν₁ : π₁ (Θ₀ (ν₁ a₁ ha₁_ev)) = α₁ (-f₁ * a₁) := by
      refine (hπ₁_lin _ _).trans ?_
      congr 1
      change a₁ * (T - 1) ^ 2 + a₁ * (T - 1) * T = -f₁ * a₁
      dsimp [f₁]
      ring
    have hπ₂_ν₁ : π₂ (Θ₀ (ν₁ a₁ ha₁_ev)) = 0 := by
      refine (hπ₂_lin _ _).trans ?_
      rw [← α₂.map_zero]
      congr 1
      change a₁ * (T - 1) ^ 2 + a₁ * (T - 1) * (1 - T) = 0
      ring
    have hπ₁_ν₂ : π₁ (Θ₀ (ν₂ a₂ ha₂_ev)) = 0 := by
      refine (hπ₁_lin _ _).trans ?_
      rw [← α₁.map_zero]
      congr 1
      change a₂ * T ^ 2 + -a₂ * T * T = 0
      ring
    have hπ₂_ν₂ : π₂ (Θ₀ (ν₂ a₂ ha₂_ev)) = α₂ (f₂ * a₂) := by
      refine (hπ₂_lin _ _).trans ?_
      congr 1
      change a₂ * T ^ 2 + -a₂ * T * (1 - T) = f₂ * a₂
      dsimp [f₂]
      ring

    let δ_g : Localization.Away u_g := algebraMap (AdjoinRoot P) (Localization.Away u_g) δ
    let γ_g : Localization.Away u_g := algebraMap (AdjoinRoot P) (Localization.Away u_g) γ
    let U_g : (Localization.Away u_g)ˣ :=
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away u_g) u_g).unit
    have hU_g : (U_g : Localization.Away u_g) = δ_g * γ_g := by
      calc
        (U_g : Localization.Away u_g) = algebraMap (AdjoinRoot P) (Localization.Away u_g) u_g :=
          IsUnit.unit_spec _
        _ = algebraMap (AdjoinRoot P) (Localization.Away u_g) (δ * γ) :=
          congrArg (algebraMap (AdjoinRoot P) (Localization.Away u_g)) hu_g_eq
        _ = δ_g * γ_g := map_mul (algebraMap (AdjoinRoot P) (Localization.Away u_g)) δ γ
    let δ_inv : Localization.Away u_g := γ_g * (↑(U_g⁻¹) : Localization.Away u_g)
    let γ_inv : Localization.Away u_g := δ_g * (↑(U_g⁻¹) : Localization.Away u_g)
    have hδ_mul : δ_g * δ_inv = 1 := by
      dsimp [δ_inv]
      rw [← mul_assoc, ← hU_g, Units.mul_inv]
    have hγ_mul : γ_g * γ_inv = 1 := by
      dsimp [γ_inv]
      rw [← mul_assoc, mul_comm γ_g δ_g, ← hU_g, Units.mul_inv]

    have hφ₁_δ : φ₁ δ_g = α₁ (-f₁) := by
      dsimp [φ₁, δ_g]
      rw [hΘ_alg, hπ₁_δ]
    have hφ₂_δ : φ₂ δ_g = α₂ f₂ := by
      dsimp [φ₂, δ_g]
      rw [hΘ_alg, hπ₂_δ]
    have hφ₁_γ : φ₁ γ_g = α₁ (-(h₁ * f₁)) := by
      dsimp [φ₁, γ_g]
      rw [hΘ_alg, hπ₁_γ]
    have hφ₂_γ : φ₂ γ_g = α₂ (h₂ * f₂) := by
      dsimp [φ₂, γ_g]
      rw [hΘ_alg, hπ₂_γ]

    have hinv₁_δ : α₁ (-f₁) * φ₁ δ_inv = 1 := by
      have h := congrArg φ₁ hδ_mul
      rw [map_mul, map_one, hφ₁_δ] at h
      exact h
    have hinv₂_δ : α₂ f₂ * φ₂ δ_inv = 1 := by
      have h := congrArg φ₂ hδ_mul
      rw [map_mul, map_one, hφ₂_δ] at h
      exact h
    have hinv₁_γ : α₁ (-(h₁ * f₁)) * φ₁ γ_inv = 1 := by
      have h := congrArg φ₁ hγ_mul
      rw [map_mul, map_one, hφ₁_γ] at h
      exact h
    have hinv₂_γ : α₂ (h₂ * f₂) * φ₂ γ_inv = 1 := by
      have h := congrArg φ₂ hγ_mul
      rw [map_mul, map_one, hφ₂_γ] at h
      exact h

    let y₁ : Localization.Away u_g :=
      (-1) ^ N * algebraMap (AdjoinRoot P) (Localization.Away u_g) (ν₁ a₁ ha₁_ev) * δ_inv * γ_inv ^ N
    let y₂ : Localization.Away u_g :=
      algebraMap (AdjoinRoot P) (Localization.Away u_g) (ν₂ a₂ ha₂_ev) * δ_inv * γ_inv ^ M

    have hφ₁_ν₁ : φ₁ (algebraMap (AdjoinRoot P) (Localization.Away u_g) (ν₁ a₁ ha₁_ev)) =
        α₁ (-f₁ * a₁) := by
      dsimp [φ₁]
      rw [hΘ_alg, hπ₁_ν₁]
    have hφ₂_ν₁ : φ₂ (algebraMap (AdjoinRoot P) (Localization.Away u_g) (ν₁ a₁ ha₁_ev)) = 0 := by
      dsimp [φ₂]
      rw [hΘ_alg, hπ₂_ν₁]
    have hφ₁_ν₂ : φ₁ (algebraMap (AdjoinRoot P) (Localization.Away u_g) (ν₂ a₂ ha₂_ev)) = 0 := by
      dsimp [φ₁]
      rw [hΘ_alg, hπ₁_ν₂]
    have hφ₂_ν₂ : φ₂ (algebraMap (AdjoinRoot P) (Localization.Away u_g) (ν₂ a₂ ha₂_ev)) =
        α₂ (f₂ * a₂) := by
      dsimp [φ₂]
      rw [hΘ_alg, hπ₂_ν₂]

    have hφ₁_y₁ : φ₁ y₁ = d'₁ := by
      dsimp [y₁]
      rw [φ₁.map_mul, φ₁.map_mul, φ₁.map_mul, φ₁.map_pow, φ₁.map_pow, φ₁.map_neg, φ₁.map_one, hφ₁_ν₁]
      have h1 : (-1 : Localization.Away (h₁ * f₁)) ^ N * α₁ (-f₁ * a₁) * φ₁ δ_inv * φ₁ γ_inv ^ N =
          (-1 : Localization.Away (h₁ * f₁)) ^ N * (α₁ a₁ * (α₁ (-f₁) * φ₁ δ_inv)) * φ₁ γ_inv ^ N := by
        rw [α₁.map_mul]
        ring
      rw [h1, hinv₁_δ, mul_one, ← hsec₁, α₁.map_pow]
      have h2 : (-1 : Localization.Away (h₁ * f₁)) ^ N * (d'₁ * α₁ (h₁ * f₁) ^ N) * φ₁ γ_inv ^ N =
          d'₁ * (α₁ (-(h₁ * f₁)) * φ₁ γ_inv) ^ N := by
        rw [α₁.map_neg, neg_eq_neg_one_mul (α₁ (h₁ * f₁)), mul_pow, mul_pow]
        ring
      rw [h2, hinv₁_γ, one_pow, mul_one]

    have hφ₂_y₁ : φ₂ y₁ = 0 := by
      dsimp [y₁]
      rw [φ₂.map_mul, φ₂.map_mul, φ₂.map_mul, hφ₂_ν₁, mul_zero, zero_mul, zero_mul]

    have hφ₁_y₂ : φ₁ y₂ = 0 := by
      dsimp [y₂]
      rw [φ₁.map_mul, φ₁.map_mul, hφ₁_ν₂, zero_mul, zero_mul]

    have hφ₂_y₂ : φ₂ y₂ = d'₂ := by
      dsimp [y₂]
      rw [φ₂.map_mul, φ₂.map_mul, φ₂.map_pow, hφ₂_ν₂]
      have h1 : α₂ (f₂ * a₂) * φ₂ δ_inv * φ₂ γ_inv ^ M =
          (α₂ a₂ * (α₂ f₂ * φ₂ δ_inv)) * φ₂ γ_inv ^ M := by
        rw [α₂.map_mul]
        ring
      rw [h1, hinv₂_δ, mul_one, ← hsec₂, α₂.map_pow]
      have h2 : d'₂ * α₂ (h₂ * f₂) ^ M * φ₂ γ_inv ^ M =
          d'₂ * (α₂ (h₂ * f₂) * φ₂ γ_inv) ^ M := by ring
      rw [h2, hinv₂_γ, one_pow, mul_one]

    refine ⟨y₀ + y₁ + y₂, ?_⟩
    apply Subtype.ext
    apply Prod.ext
    · change φ₁ (y₀ + y₁ + y₂) = d₁
      rw [φ₁.map_add, φ₁.map_add, hφ₁_y₀, hφ₁_y₁, hφ₁_y₂, add_zero]
      dsimp [d'₁]
      ring
    · change φ₂ (y₀ + y₁ + y₂) = d₂
      rw [φ₂.map_add, φ₂.map_add, hφ₂_y₀, hφ₂_y₁, hφ₂_y₂, add_zero]
      dsimp [d'₂]
      ring

  
  have hEt_Θ : RingHom.Etale Θ := RingHom.Etale.of_bijective ⟨hInj, hSurj⟩
  let φ_pinch := Θ.comp ((algebraMap (AdjoinRoot P) (Localization.Away u_g)).comp ofP)
  have hEt_pinch : RingHom.Etale φ_pinch :=
    RingHom.Etale.stableUnderComposition _ _ hEt_alg hEt_Θ
  refine ⟨f₁, f₂, hf₁, hf₂, φ_pinch, hEt_pinch, ?_⟩
  intro x
  dsimp [φ_pinch]
  rw [hΘ_alg, hΘ₀_of]
  rfl

theorem weil_nodal_ring_to_etale_fiber_product_etale (K' : Type u) [Field K']
    (D₁ D₂ : Type u) [CommRing D₁] [CommRing D₂]
    (g₁ : MvPolynomial (Fin 1) K' →+* D₁)
    (g₂ : MvPolynomial (Fin 1) K' →+* D₂)
    (hg₁ : RingHom.Etale g₁)
    (hg₂ : RingHom.Etale g₂)
    (ε₁ : D₁ →+* K')
    (ε₂ : D₂ →+* K')
    (hε₁_C : ε₁.comp (g₁.comp MvPolynomial.C) = RingHom.id K')
    (hε₂_C : ε₂.comp (g₂.comp MvPolynomial.C) = RingHom.id K')
    (hker₁ : RingHom.ker ε₁ = Ideal.span {g₁ (MvPolynomial.X 0)})
    (hker₂ : RingHom.ker ε₂ = Ideal.span {g₂ (MvPolynomial.X 0)}) :
    ∃ (φ_nod :
        (MvPolynomial (Fin 2) K' ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+*
        ↥(RingHom.eqLocus (ε₁.comp (RingHom.fst D₁ D₂)) (ε₂.comp (RingHom.snd D₁ D₂)))),
      RingHom.Etale φ_nod ∧
      (φ_nod (Ideal.Quotient.mk _ (MvPolynomial.X 0))).1 = (g₁ (MvPolynomial.X 0), 0) ∧
      (φ_nod (Ideal.Quotient.mk _ (MvPolynomial.X 1))).1 = (0, g₂ (MvPolynomial.X 0)) ∧
      ∀ c : K',
        (φ_nod (Ideal.Quotient.mk _ (MvPolynomial.C c))).1 =
          (g₁ (MvPolynomial.C c), g₂ (MvPolynomial.C c)) :=
by
  let I_nod : Ideal (MvPolynomial (Fin 2) K') :=
    Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}
  let R_nod := MvPolynomial (Fin 2) K' ⧸ I_nod
  let π_nod : MvPolynomial (Fin 2) K' →+* R_nod := Ideal.Quotient.mk I_nod
  let S_eq := RingHom.eqLocus (ε₁.comp (RingHom.fst D₁ D₂)) (ε₂.comp (RingHom.snd D₁ D₂))
  let B' := ↥S_eq
  let t₁ : D₁ := g₁ (MvPolynomial.X 0)
  let t₂ : D₂ := g₂ (MvPolynomial.X 0)
  let η₁ : K' →+* D₁ := g₁.comp MvPolynomial.C
  let η₂ : K' →+* D₂ := g₂.comp MvPolynomial.C
  have hε₁_η : ∀ c : K', ε₁ (η₁ c) = c := fun c => RingHom.congr_fun hε₁_C c
  have hε₂_η : ∀ c : K', ε₂ (η₂ c) = c := fun c => RingHom.congr_fun hε₂_C c
  have ht₁_ker : ε₁ t₁ = 0 := by
    have hmem : t₁ ∈ RingHom.ker ε₁ := by
      rw [hker₁]
      exact Ideal.mem_span_singleton_self t₁
    exact RingHom.mem_ker.mp hmem
  have ht₂_ker : ε₂ t₂ = 0 := by
    have hmem : t₂ ∈ RingHom.ker ε₂ := by
      rw [hker₂]
      exact Ideal.mem_span_singleton_self t₂
    exact RingHom.mem_ker.mp hmem
  let η_B' : K' →+* B' :=
    (η₁.prod η₂).codRestrict S_eq (fun c => by
      rw [RingHom.mem_eqLocus]
      simp [RingHom.prod_apply, hε₁_η, hε₂_η])
  let x₀_B' : B' := ⟨(t₁, 0), by
    rw [RingHom.mem_eqLocus]
    simp [ht₁_ker]⟩
  let x₁_B' : B' := ⟨(0, t₂), by
    rw [RingHom.mem_eqLocus]
    simp [ht₂_ker]⟩
  have hx₀x₁ : x₀_B' * x₁_B' = 0 := by
    apply Subtype.ext
    exact Prod.ext (mul_zero t₁) (zero_mul t₂)
  let φ_raw : MvPolynomial (Fin 2) K' →+* B' :=
    MvPolynomial.eval₂Hom η_B' (fun i : Fin 2 => if i = 0 then x₀_B' else x₁_B')
  have hφ_vanish : ∀ p ∈ I_nod, φ_raw p = 0 := by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
    have hX0 : φ_raw (MvPolynomial.X 0) = x₀_B' := by
      simp [φ_raw, MvPolynomial.eval₂Hom_X']
    have hX1 : φ_raw (MvPolynomial.X 1) = x₁_B' := by
      have h10 : (1 : Fin 2) ≠ 0 := by decide
      simp [φ_raw, MvPolynomial.eval₂Hom_X', h10]
    rw [map_mul, map_mul, hX0, hX1, hx₀x₁, zero_mul]
  let φ_nod : R_nod →+* B' := Ideal.Quotient.lift I_nod φ_raw hφ_vanish
  have hφ_X0 : (φ_nod (π_nod (MvPolynomial.X 0))).1 = (t₁, 0) := by
    dsimp only [φ_nod, π_nod]
    rw [Ideal.Quotient.lift_mk]
    simp [φ_raw, MvPolynomial.eval₂Hom_X', x₀_B']
  have hφ_X1 : (φ_nod (π_nod (MvPolynomial.X 1))).1 = (0, t₂) := by
    have h10 : (1 : Fin 2) ≠ 0 := by decide
    dsimp only [φ_nod, π_nod]
    rw [Ideal.Quotient.lift_mk]
    simp [φ_raw, MvPolynomial.eval₂Hom_X', h10, x₁_B']
  have hφ_C : ∀ c : K', (φ_nod (π_nod (MvPolynomial.C c))).1 = (η₁ c, η₂ c) := by
    intro c
    dsimp only [φ_nod, π_nod, φ_raw]
    rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    rfl
  let ι₁_sharp : D₁ →+* B' :=
    ((RingHom.id D₁).prod (η₂.comp ε₁)).codRestrict S_eq (fun d₁ => by
      rw [RingHom.mem_eqLocus]
      simp [RingHom.prod_apply, hε₂_η])
  let ι₂_sharp : D₂ →+* B' :=
    ((η₁.comp ε₂).prod (RingHom.id D₂)).codRestrict S_eq (fun d₂ => by
      rw [RingHom.mem_eqLocus]
      simp [RingHom.prod_apply, hε₁_η])
  let ψ₀ : MvPolynomial (Fin 1) K' →+* R_nod :=
    MvPolynomial.eval₂Hom (π_nod.comp MvPolynomial.C) (fun _ => π_nod (MvPolynomial.X 0))
  let ψ'₁ : MvPolynomial (Fin 1) K' →+* R_nod :=
    MvPolynomial.eval₂Hom (π_nod.comp MvPolynomial.C) (fun _ => π_nod (MvPolynomial.X 1))
  let P₁_cat : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 1) K')
  let R_nod_cat : CommRingCat.{u} := CommRingCat.of R_nod
  let D₁_cat : CommRingCat.{u} := CommRingCat.of D₁
  let D₂_cat : CommRingCat.{u} := CommRingCat.of D₂
  let B'_cat : CommRingCat.{u} := CommRingCat.of B'
  let f₀ : P₁_cat ⟶ R_nod_cat := CommRingCat.ofHom ψ₀
  let g₁_cat : P₁_cat ⟶ D₁_cat := CommRingCat.ofHom g₁
  let E₁_cat : CommRingCat.{u} := CategoryTheory.Limits.pushout f₀ g₁_cat
  let j₁ : R_nod_cat ⟶ E₁_cat := CategoryTheory.Limits.pushout.inl f₀ g₁_cat
  let inr₁ : D₁_cat ⟶ E₁_cat := CategoryTheory.Limits.pushout.inr f₀ g₁_cat
  let f₁ : P₁_cat ⟶ E₁_cat := CommRingCat.ofHom ψ'₁ ≫ j₁
  let g₂_cat : P₁_cat ⟶ D₂_cat := CommRingCat.ofHom g₂
  let E₂_cat : CommRingCat.{u} := CategoryTheory.Limits.pushout f₁ g₂_cat
  let j₂ : E₁_cat ⟶ E₂_cat := CategoryTheory.Limits.pushout.inl f₁ g₂_cat
  let inr₂ : D₂_cat ⟶ E₂_cat := CategoryTheory.Limits.pushout.inr f₁ g₂_cat
  have hj₁_et : RingHom.Etale j₁.hom :=
    RingHom.IsStableUnderBaseChange.pushout_inl
      RingHom.Etale.isStableUnderBaseChange RingHom.Etale.respectsIso f₀ g₁_cat hg₁
  have hj₂_et : RingHom.Etale j₂.hom :=
    RingHom.IsStableUnderBaseChange.pushout_inl
      RingHom.Etale.isStableUnderBaseChange RingHom.Etale.respectsIso f₁ g₂_cat hg₂
  have hj₁₂_et : RingHom.Etale (j₁ ≫ j₂).hom := by
    rw [CommRingCat.hom_comp]
    exact RingHom.Etale.stableUnderComposition j₁.hom j₂.hom hj₁_et hj₂_et
  have w₁ : f₀ ≫ CommRingCat.ofHom φ_nod = g₁_cat ≫ CommRingCat.ofHom ι₁_sharp := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
    dsimp only [f₀, g₁_cat]
    rw [CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      apply Subtype.ext
      simp only [RingHom.comp_apply, ψ₀, MvPolynomial.eval₂Hom_C, hφ_C, ι₁_sharp]
      exact Prod.ext rfl (congrArg η₂ (hε₁_η c)).symm
    · intro i
      rw [Fin.eq_zero i]
      apply Subtype.ext
      simp only [RingHom.comp_apply, ψ₀, MvPolynomial.eval₂Hom_X', hφ_X0, ι₁_sharp]
      change (t₁, (0 : D₂)) = (t₁, η₂ (ε₁ t₁))
      rw [ht₁_ker, map_zero]
  let Φ₁_cat : E₁_cat ⟶ B'_cat :=
    CategoryTheory.Limits.pushout.desc (CommRingCat.ofHom φ_nod) (CommRingCat.ofHom ι₁_sharp) w₁
  have hj₁_Φ₁ : j₁ ≫ Φ₁_cat = CommRingCat.ofHom φ_nod :=
    CategoryTheory.Limits.pushout.inl_desc _ _ w₁
  have hinr₁_Φ₁ : inr₁ ≫ Φ₁_cat = CommRingCat.ofHom ι₁_sharp :=
    CategoryTheory.Limits.pushout.inr_desc _ _ w₁
  have w₂ : f₁ ≫ Φ₁_cat = g₂_cat ≫ CommRingCat.ofHom ι₂_sharp := by
    dsimp only [f₁]
    rw [CategoryTheory.Category.assoc, hj₁_Φ₁]
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
    dsimp only [g₂_cat]
    rw [CommRingCat.hom_ofHom]
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      apply Subtype.ext
      simp only [RingHom.comp_apply, ψ'₁, MvPolynomial.eval₂Hom_C, hφ_C, ι₂_sharp]
      exact Prod.ext (congrArg η₁ (hε₂_η c)).symm rfl
    · intro i
      rw [Fin.eq_zero i]
      apply Subtype.ext
      simp only [RingHom.comp_apply, ψ'₁, MvPolynomial.eval₂Hom_X', hφ_X1, ι₂_sharp]
      change ((0 : D₁), t₂) = (η₁ (ε₂ t₂), t₂)
      rw [ht₂_ker, map_zero]
  let Φ_cat : E₂_cat ⟶ B'_cat :=
    CategoryTheory.Limits.pushout.desc Φ₁_cat (CommRingCat.ofHom ι₂_sharp) w₂
  have hj₂_Φ : j₂ ≫ Φ_cat = Φ₁_cat :=
    CategoryTheory.Limits.pushout.inl_desc _ _ w₂
  have hj₁₂_Φ : (j₁ ≫ j₂) ≫ Φ_cat = CommRingCat.ofHom φ_nod := by
    rw [CategoryTheory.Category.assoc, hj₂_Φ, hj₁_Φ₁]
  have hκ₁_Φ : (inr₁ ≫ j₂) ≫ Φ_cat = CommRingCat.ofHom ι₁_sharp := by
    rw [CategoryTheory.Category.assoc, hj₂_Φ, hinr₁_Φ₁]
  have hκ₂_Φ : inr₂ ≫ Φ_cat = CommRingCat.ofHom ι₂_sharp :=
    CategoryTheory.Limits.pushout.inr_desc _ _ w₂
  let j₁₂ : R_nod →+* E₂_cat := (j₁ ≫ j₂).hom
  let κ₁ : D₁ →+* E₂_cat := (inr₁ ≫ j₂).hom
  let κ₂ : D₂ →+* E₂_cat := inr₂.hom
  let η_E₂ : K' →+* E₂_cat := j₁₂.comp (π_nod.comp MvPolynomial.C)
  have hcond₁ : j₁₂.comp ψ₀ = κ₁.comp g₁ := by
    have h := CategoryTheory.Limits.pushout.condition (f := f₀) (g := g₁_cat)
    have h' : f₀ ≫ (j₁ ≫ j₂) = g₁_cat ≫ (inr₁ ≫ j₂) := by
      dsimp only [j₁, inr₁]
      rw [← CategoryTheory.Category.assoc, h, CategoryTheory.Category.assoc]
    have hhom := congrArg CommRingCat.Hom.hom h'
    simpa [CommRingCat.hom_comp, f₀, g₁_cat, j₁₂, κ₁] using hhom
  have hcond₂ : j₁₂.comp ψ'₁ = κ₂.comp g₂ := by
    have h := CategoryTheory.Limits.pushout.condition (f := f₁) (g := g₂_cat)
    have h' : CommRingCat.ofHom ψ'₁ ≫ (j₁ ≫ j₂) = g₂_cat ≫ inr₂ := by
      dsimp only [f₁, j₂, inr₂] at h ⊢
      rw [← CategoryTheory.Category.assoc]
      exact h
    have hhom := congrArg CommRingCat.Hom.hom h'
    simpa [CommRingCat.hom_comp, g₂_cat, j₁₂, κ₂] using hhom
  have hκ₁_η : ∀ c : K', κ₁ (η₁ c) = η_E₂ c := by
    intro c
    have hc := RingHom.congr_fun hcond₁ (MvPolynomial.C c)
    simpa [ψ₀, MvPolynomial.eval₂Hom_C, η₁, η_E₂] using hc.symm
  have hκ₂_η : ∀ c : K', κ₂ (η₂ c) = η_E₂ c := by
    intro c
    have hc := RingHom.congr_fun hcond₂ (MvPolynomial.C c)
    simpa [ψ'₁, MvPolynomial.eval₂Hom_C, η₂, η_E₂] using hc.symm
  have hκ₁_t₁ : κ₁ t₁ = j₁₂ (π_nod (MvPolynomial.X 0)) := by
    have hx := RingHom.congr_fun hcond₁ (MvPolynomial.X 0)
    simpa [ψ₀, MvPolynomial.eval₂Hom_X', t₁] using hx.symm
  have hκ₂_t₂ : κ₂ t₂ = j₁₂ (π_nod (MvPolynomial.X 1)) := by
    have hx := RingHom.congr_fun hcond₂ (MvPolynomial.X 0)
    simpa [ψ'₁, MvPolynomial.eval₂Hom_X', t₂] using hx.symm
  have ht₁t₂_zero : κ₁ t₁ * κ₂ t₂ = 0 := by
    rw [hκ₁_t₁, hκ₂_t₂, ← map_mul, ← map_mul]
    have hzero : π_nod (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    rw [hzero, map_zero]
  have h_orth : ∀ (x₁ : D₁) (x₂ : D₂), ε₁ x₁ = 0 → ε₂ x₂ = 0 → κ₁ x₁ * κ₂ x₂ = 0 := by
    intro x₁ x₂ hx₁ hx₂
    have hx₁_mem : x₁ ∈ Ideal.span {t₁} := by
      rw [← hker₁]
      exact RingHom.mem_ker.mpr hx₁
    have hx₂_mem : x₂ ∈ Ideal.span {t₂} := by
      rw [← hker₂]
      exact RingHom.mem_ker.mpr hx₂
    obtain ⟨y₁, rfl⟩ := Ideal.mem_span_singleton.mp hx₁_mem
    obtain ⟨y₂, rfl⟩ := Ideal.mem_span_singleton.mp hx₂_mem
    calc
      κ₁ (t₁ * y₁) * κ₂ (t₂ * y₂) = (κ₁ t₁ * κ₁ y₁) * (κ₂ t₂ * κ₂ y₂) := by
        rw [map_mul, map_mul]
      _ = (κ₁ t₁ * κ₂ t₂) * (κ₁ y₁ * κ₂ y₂) := by ring
      _ = 0 := by rw [ht₁t₂_zero, zero_mul]
  let Ψ : B' →+* E₂_cat :=
    { toFun := fun b => κ₁ b.1.1 + κ₂ b.1.2 - η_E₂ (ε₁ b.1.1)
      map_one' := by
        change κ₁ 1 + κ₂ 1 - η_E₂ (ε₁ 1) = 1
        simp only [map_one, add_sub_cancel_right]
      map_zero' := by
        change κ₁ 0 + κ₂ 0 - η_E₂ (ε₁ 0) = 0
        simp only [map_zero, add_zero, sub_self]
      map_add' := by
        intro b b'
        change κ₁ (b.1.1 + b'.1.1) + κ₂ (b.1.2 + b'.1.2) - η_E₂ (ε₁ (b.1.1 + b'.1.1)) =
          (κ₁ b.1.1 + κ₂ b.1.2 - η_E₂ (ε₁ b.1.1)) + (κ₁ b'.1.1 + κ₂ b'.1.2 - η_E₂ (ε₁ b'.1.1))
        simp only [map_add]
        ring
      map_mul' := by
        intro b b'
        let c : K' := ε₁ b.1.1
        let c' : K' := ε₁ b'.1.1
        have hc₂ : ε₂ b.1.2 = c := (RingHom.mem_eqLocus.mp b.2).symm
        have hc'₂ : ε₂ b'.1.2 = c' := (RingHom.mem_eqLocus.mp b'.2).symm
        let x₁ : D₁ := b.1.1 - η₁ c
        let x₂ : D₂ := b.1.2 - η₂ c
        let x'₁ : D₁ := b'.1.1 - η₁ c'
        let x'₂ : D₂ := b'.1.2 - η₂ c'
        have hx₁ : ε₁ x₁ = 0 := by simp [x₁, c, hε₁_η]
        have hx₂ : ε₂ x₂ = 0 := by simp [x₂, hc₂, hε₂_η]
        have hx'₁ : ε₁ x'₁ = 0 := by simp [x'₁, c', hε₁_η]
        have hx'₂ : ε₂ x'₂ = 0 := by simp [x'₂, hc'₂, hε₂_η]
        have horth₁ : κ₁ x₁ * κ₂ x'₂ = 0 := h_orth x₁ x'₂ hx₁ hx'₂
        have horth₂ : κ₁ x'₁ * κ₂ x₂ = 0 := h_orth x'₁ x₂ hx'₁ hx₂
        have hb₁ : b.1.1 = η₁ c + x₁ := by simp [x₁]
        have hb₂ : b.1.2 = η₂ c + x₂ := by simp [x₂]
        have hb'₁ : b'.1.1 = η₁ c' + x'₁ := by simp [x'₁]
        have hb'₂ : b'.1.2 = η₂ c' + x'₂ := by simp [x'₂]
        change κ₁ (b.1.1 * b'.1.1) + κ₂ (b.1.2 * b'.1.2) - η_E₂ (ε₁ (b.1.1 * b'.1.1)) =
          (κ₁ b.1.1 + κ₂ b.1.2 - η_E₂ c) * (κ₁ b'.1.1 + κ₂ b'.1.2 - η_E₂ c')
        have hε_mul : ε₁ (b.1.1 * b'.1.1) = c * c' := map_mul ε₁ b.1.1 b'.1.1
        rw [hε_mul, map_mul η_E₂, hb₁, hb₂, hb'₁, hb'₂]
        simp only [map_mul, map_add, hκ₁_η, hκ₂_η]
        linear_combination -(horth₁ + horth₂) }
  have hΦ_j₁₂ : Φ_cat.hom.comp j₁₂ = φ_nod := by
    have h := congrArg CommRingCat.Hom.hom hj₁₂_Φ
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h
    exact h
  have hΦ_κ₁ : Φ_cat.hom.comp κ₁ = ι₁_sharp := by
    have h := congrArg CommRingCat.Hom.hom hκ₁_Φ
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h
    exact h
  have hΦ_κ₂ : Φ_cat.hom.comp κ₂ = ι₂_sharp := by
    have h := congrArg CommRingCat.Hom.hom hκ₂_Φ
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h
    exact h
  have hΦ_η : ∀ c : K', Φ_cat.hom (η_E₂ c) = η_B' c := by
    intro c
    have h := RingHom.congr_fun hΦ_j₁₂ (π_nod (MvPolynomial.C c))
    simp only [RingHom.comp_apply] at h
    change Φ_cat.hom (j₁₂ (π_nod (MvPolynomial.C c))) = η_B' c
    rw [h]
    apply Subtype.ext
    rw [hφ_C c]
    rfl
  have hΦΨ : ∀ b : B', Φ_cat.hom (Ψ b) = b := by
    intro b
    have hb_eq : ε₁ b.1.1 = ε₂ b.1.2 := RingHom.mem_eqLocus.mp b.2
    have h1 : Φ_cat.hom (κ₁ b.1.1) = ι₁_sharp b.1.1 := RingHom.congr_fun hΦ_κ₁ b.1.1
    have h2 : Φ_cat.hom (κ₂ b.1.2) = ι₂_sharp b.1.2 := RingHom.congr_fun hΦ_κ₂ b.1.2
    change Φ_cat.hom (κ₁ b.1.1 + κ₂ b.1.2 - η_E₂ (ε₁ b.1.1)) = b
    rw [map_sub, map_add, h1, h2, hΦ_η]
    apply Subtype.ext
    change (b.1.1 + η₁ (ε₂ b.1.2) - η₁ (ε₁ b.1.1), η₂ (ε₁ b.1.1) + b.1.2 - η₂ (ε₁ b.1.1)) = b.1
    rw [← hb_eq]
    exact Prod.ext (by ring) (by ring)
  have hΨΦ_cat : Φ_cat ≫ CommRingCat.ofHom Ψ = 𝟙 E₂_cat := by
    apply CategoryTheory.Limits.pushout.hom_ext
    · change j₂ ≫ (Φ_cat ≫ CommRingCat.ofHom Ψ) = j₂ ≫ 𝟙 E₂_cat
      rw [← CategoryTheory.Category.assoc, hj₂_Φ, CategoryTheory.Category.comp_id]
      apply CategoryTheory.Limits.pushout.hom_ext
      · change j₁ ≫ (Φ₁_cat ≫ CommRingCat.ofHom Ψ) = j₁ ≫ j₂
        rw [← CategoryTheory.Category.assoc, hj₁_Φ₁]
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply]
          have hval : (φ_nod (π_nod (MvPolynomial.C c))).1 = (η₁ c, η₂ c) := hφ_C c
          change κ₁ (φ_nod (π_nod (MvPolynomial.C c))).1.1 +
              κ₂ (φ_nod (π_nod (MvPolynomial.C c))).1.2 -
              η_E₂ (ε₁ (φ_nod (π_nod (MvPolynomial.C c))).1.1) = η_E₂ c
          rw [hval]
          dsimp only
          rw [hκ₁_η, hκ₂_η, hε₁_η]
          ring
        · intro i
          simp only [RingHom.comp_apply]
          fin_cases i
          · change κ₁ (φ_nod (π_nod (MvPolynomial.X 0))).1.1 +
                κ₂ (φ_nod (π_nod (MvPolynomial.X 0))).1.2 -
                η_E₂ (ε₁ (φ_nod (π_nod (MvPolynomial.X 0))).1.1) = j₁₂ (π_nod (MvPolynomial.X 0))
            rw [hφ_X0]
            dsimp only
            rw [hκ₁_t₁, map_zero, ht₁_ker, map_zero]
            ring
          · change κ₁ (φ_nod (π_nod (MvPolynomial.X 1))).1.1 +
                κ₂ (φ_nod (π_nod (MvPolynomial.X 1))).1.2 -
                η_E₂ (ε₁ (φ_nod (π_nod (MvPolynomial.X 1))).1.1) = j₁₂ (π_nod (MvPolynomial.X 1))
            rw [hφ_X1]
            dsimp only
            rw [map_zero, hκ₂_t₂, map_zero, map_zero]
            ring
      · change inr₁ ≫ (Φ₁_cat ≫ CommRingCat.ofHom Ψ) = inr₁ ≫ j₂
        rw [← CategoryTheory.Category.assoc, hinr₁_Φ₁]
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
        apply RingHom.ext
        intro d₁
        simp only [RingHom.comp_apply]
        change κ₁ (ι₁_sharp d₁).1.1 + κ₂ (ι₁_sharp d₁).1.2 - η_E₂ (ε₁ (ι₁_sharp d₁).1.1) = κ₁ d₁
        have hval : (ι₁_sharp d₁).1 = (d₁, η₂ (ε₁ d₁)) := rfl
        rw [hval]
        dsimp only
        rw [hκ₂_η]
        ring
    · change inr₂ ≫ (Φ_cat ≫ CommRingCat.ofHom Ψ) = inr₂ ≫ 𝟙 E₂_cat
      rw [← CategoryTheory.Category.assoc, hκ₂_Φ, CategoryTheory.Category.comp_id]
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      apply RingHom.ext
      intro d₂
      simp only [RingHom.comp_apply]
      change κ₁ (ι₂_sharp d₂).1.1 + κ₂ (ι₂_sharp d₂).1.2 - η_E₂ (ε₁ (ι₂_sharp d₂).1.1) = κ₂ d₂
      have hval : (ι₂_sharp d₂).1 = (η₁ (ε₂ d₂), d₂) := rfl
      rw [hval]
      dsimp only
      rw [hκ₁_η, hε₁_η]
      ring
  have hΨΦ : Function.LeftInverse Ψ Φ_cat.hom := by
    intro e
    have h := congrArg (fun f : E₂_cat ⟶ E₂_cat => f.hom e) hΨΦ_cat
    simpa [CommRingCat.hom_comp] using h
  have hBij : Function.Bijective Φ_cat.hom :=
    ⟨hΨΦ.injective, Function.RightInverse.surjective hΦΨ⟩
  have hΦ_et : RingHom.Etale Φ_cat.hom := RingHom.Etale.of_bijective hBij
  have hφ_nod_et : RingHom.Etale φ_nod := by
    rw [← hΦ_j₁₂]
    exact RingHom.Etale.stableUnderComposition j₁₂ Φ_cat.hom hj₁₂_et hΦ_et
  exact ⟨φ_nod, hφ_nod_et, hφ_X0, hφ_X1, hφ_C⟩

theorem weil_two_point_pinch_etale_nodal_roof (K' : Type u) [Field K'] [IsAlgClosed K']
    (X_fib : AlgebraicGeometry.Scheme.{u})
    (p_fib : X_fib ⟶ AlgebraicGeometry.Spec (CommRingCat.of K'))
    (y : ↥X_fib)
    (hPinch : HasTwoPointPinchAt K' p_fib y) :
    ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
      (e₁ : U' ⟶ X_fib)
      (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) K' ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
      AlgebraicGeometry.Etale e₁ ∧
      AlgebraicGeometry.Etale e₂ ∧
      e₁.base u₀ = y ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
      e₁ ≫ p_fib =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) :=
by
  obtain ⟨W_y, hy, A', ιK, ev₁, ev₂, hev₁, hev₂, hNeKer,
    ⟨V₁, hp₁, hSm₁⟩, ⟨V₂, hp₂, hSm₂⟩, hK, isoW, hisoComm, hisoPt⟩ := hPinch
  obtain ⟨h₁, hh₁, hg₁_all⟩ :=
    weil_smooth_one_point_clean_etale_chart K' A' ιK ev₁ hev₁ V₁ hp₁ hSm₁
  obtain ⟨h₂, hh₂, hg₂_all⟩ :=
    weil_smooth_one_point_clean_etale_chart K' A' ιK ev₂ hev₂ V₂ hp₂ hSm₂
  have hev₁_hom : ev₁.hom.comp ιK.hom = RingHom.id K' := by
    simpa using congrArg CommRingCat.Hom.hom hev₁
  have hev₂_hom : ev₂.hom.comp ιK.hom = RingHom.id K' := by
    simpa using congrArg CommRingCat.Hom.hom hev₂
  obtain ⟨f₁, f₂, hf₁, hf₂, φ_pinch, hφ_pinch_et, hφ_pinch_diag⟩ :=
    weil_two_point_eqLocus_quadratic_etale_split K' A' ιK.hom ev₁.hom ev₂.hom
      hev₁_hom hev₂_hom hNeKer h₁ h₂ hh₁ hh₂
  obtain ⟨g₁, hg₁_C, hg₁_et, hg₁_X, hg₁_ker⟩ := hg₁_all f₁ hf₁
  obtain ⟨g₂, hg₂_C, hg₂_et, hg₂_X, hg₂_ker⟩ := hg₂_all f₂ hf₂
  let D₁ := Localization.Away (h₁ * f₁)
  let D₂ := Localization.Away (h₂ * f₂)
  let ε₁ : D₁ →+* K' := IsLocalization.Away.lift (h₁ * f₁) hf₁
  let ε₂ : D₂ →+* K' := IsLocalization.Away.lift (h₂ * f₂) hf₂
  have hε₁_C : ε₁.comp (g₁.comp MvPolynomial.C) = RingHom.id K' := by
    rw [hg₁_C]
    ext c
    simp only [RingHom.comp_apply, RingHom.id_apply, ε₁]
    rw [IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ (ιK.hom c)]
    exact RingHom.congr_fun hev₁_hom c
  have hε₂_C : ε₂.comp (g₂.comp MvPolynomial.C) = RingHom.id K' := by
    rw [hg₂_C]
    ext c
    simp only [RingHom.comp_apply, RingHom.id_apply, ε₂]
    rw [IsLocalization.Away.lift_eq (h₂ * f₂) hf₂ (ιK.hom c)]
    exact RingHom.congr_fun hev₂_hom c
  obtain ⟨φ_nod, hφ_nod_et, hφ_X0, hφ_X1, hφ_C⟩ :=
    weil_nodal_ring_to_etale_fiber_product_etale K' D₁ D₂ g₁ g₂ hg₁_et hg₂_et
      ε₁ ε₂ hε₁_C hε₂_C hg₁_ker hg₂_ker
  let B' := ↥(RingHom.eqLocus (ε₁.comp (RingHom.fst D₁ D₂)) (ε₂.comp (RingHom.snd D₁ D₂)))
  let U' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B')
  let ε_B' : B' →+* K' :=
    (ε₁.comp (RingHom.fst D₁ D₂)).comp
      (RingHom.eqLocus (ε₁.comp (RingHom.fst D₁ D₂)) (ε₂.comp (RingHom.snd D₁ D₂))).subtype
  let u₀ : U' := (⟨RingHom.ker ε_B', RingHom.ker_isPrime ε_B'⟩ : PrimeSpectrum B')
  let e_pinch : U' ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of ↥(RingHom.eqLocus ev₁.hom ev₂.hom)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_pinch)
  let e₁ : U' ⟶ X_fib := e_pinch ≫ isoW.inv ≫ W_y.ι
  let e₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_nod)
  have he_pinch_et : AlgebraicGeometry.Etale e_pinch :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_pinch_et
  have he₂_et : AlgebraicGeometry.Etale e₂ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_nod_et
  have he₁_et : AlgebraicGeometry.Etale e₁ := by
    dsimp [e₁]
    infer_instance
  refine ⟨U', u₀, e₁, e₂, he₁_et, he₂_et, ?_, ?_, ?_⟩
  · have hu₀_pinch : e_pinch.base u₀ = isoW.hom.base ⟨y, hy⟩ := by
      apply PrimeSpectrum.ext
      rw [hisoPt]
      ext x
      simp only [e_pinch, AlgebraicGeometry.Spec.map_base,
        u₀, RingHom.mem_ker, RingHom.comp_apply, ε_B']
      change ε₁ (φ_pinch x).1.1 = 0 ↔ ev₁.hom x.1 = 0
      rw [hφ_pinch_diag x]
      dsimp only [ε₁]
      rw [IsLocalization.Away.lift_eq (h₁ * f₁) hf₁ x.1]
    have hcomp_base : e₁.base u₀ = W_y.ι.base (isoW.inv.base (e_pinch.base u₀)) := rfl
    rw [hcomp_base, hu₀_pinch]
    have hinv_hom : isoW.inv.base (isoW.hom.base ⟨y, hy⟩) = ⟨y, hy⟩ :=
      congrArg (fun f : W_y.toScheme ⟶ W_y.toScheme => f.base ⟨y, hy⟩) isoW.hom_inv_id
    rw [hinv_hom]
    exact AlgebraicGeometry.Scheme.Opens.ι_apply W_y ⟨y, hy⟩
  · intro i
    simp only [e₂, AlgebraicGeometry.Spec.map_base, u₀, ε_B']
    fin_cases i
    · change ε₁ (φ_nod (Ideal.Quotient.mk _ (MvPolynomial.X 0))).1.1 = 0
      rw [hφ_X0]
      exact hg₁_X
    · change ε₁ (φ_nod (Ideal.Quotient.mk _ (MvPolynomial.X 1))).1.1 = 0
      rw [hφ_X1]
      exact map_zero ε₁
  · have hisoComm' : isoW.inv ≫ W_y.ι ≫ p_fib =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (ιK.hom.codRestrict (RingHom.eqLocus ev₁.hom ev₂.hom).toSubsemiring hK)) := by
      rw [← hisoComm, ← CategoryTheory.Category.assoc, isoW.inv_hom_id,
        CategoryTheory.Category.id_comp]
    dsimp [e₁, e₂, e_pinch]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hisoComm',
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    apply Subtype.ext
    change (φ_pinch ⟨ιK.hom c, hK c⟩).1 = (φ_nod (Ideal.Quotient.mk _ (MvPolynomial.C c))).1
    rw [hφ_pinch_diag ⟨ιK.hom c, hK c⟩, hφ_C c]
    have hc₁ : algebraMap (↑A') D₁ (ιK.hom c) = g₁ (MvPolynomial.C c) :=
      (RingHom.congr_fun hg₁_C c).symm
    have hc₂ : algebraMap (↑A') D₂ (ιK.hom c) = g₂ (MvPolynomial.C c) :=
      (RingHom.congr_fun hg₂_C c).symm
    exact Prod.ext hc₁ hc₂

theorem weil_etale_roof_relDimOne_smooth_descent (K' : Type u) [Field K']
    (S₀ : Type u) [CommRing S₀] [Algebra K' S₀] [Algebra.FinitePresentation K' S₀]
    (p : Ideal S₀) [p.IsPrime]
    (T₀ : Type u) [CommRing T₀] [Algebra K' T₀] [Algebra S₀ T₀]
    [IsScalarTower K' S₀ T₀] [Algebra.Etale S₀ T₀]
    (q : Ideal T₀) [q.IsPrime]
    (hpq : p = Ideal.comap (algebraMap S₀ T₀) q)
    (φ_poly : Polynomial K' →+* T₀)
    (hφ_et : φ_poly.Etale)
    (hφ_comp : φ_poly.comp Polynomial.C = algebraMap K' T₀) :
    ∃ f : S₀, f ∉ p ∧
      RingHom.IsStandardSmoothOfRelativeDimension 1
        (algebraMap K' (Localization.Away f)) :=
by
  
  have hT₀_poly : Algebra.FormallySmooth K' T₀ ∧ Nonempty (Ω[T₀ ⁄ K'] ≃ₗ[T₀] T₀) := by
    letI : Algebra (Polynomial K') T₀ := φ_poly.toAlgebra
    haveI : IsScalarTower K' (Polynomial K') T₀ :=
      IsScalarTower.of_algebraMap_eq' hφ_comp.symm
    haveI : Algebra.Etale (Polynomial K') T₀ := hφ_et
    have hFS : Algebra.FormallySmooth K' T₀ :=
      Algebra.FormallySmooth.comp K' (Polynomial K') T₀
    let e1 := (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' (Polynomial K') T₀).symm
    let e2 := LinearEquiv.baseChange (Polynomial K') T₀ Ω[Polynomial K' ⁄ K'] (Polynomial K')
      (KaehlerDifferential.polynomialEquiv K')
    let e3 := TensorProduct.AlgebraTensorModule.rid (Polynomial K') T₀ T₀
    exact ⟨hFS, ⟨(e1.trans e2).trans e3⟩⟩
  haveI hFS_T₀ : Algebra.FormallySmooth K' T₀ := hT₀_poly.1
  haveI hSub_T₀ : Subsingleton (Algebra.H1Cotangent K' T₀) :=
    Algebra.FormallySmooth.subsingleton_h1Cotangent
  obtain ⟨e_ΩT₀⟩ := hT₀_poly.2

  
  have hKaehler_Sp : Module.Projective (Localization.AtPrime p) Ω[Localization.AtPrime p ⁄ K'] ∧
      Module.rank (Localization.AtPrime p) Ω[Localization.AtPrime p ⁄ K'] = 1 := by
    let S_p : Type u := Localization.AtPrime p
    let T_q : Type u := Localization.AtPrime q
    let ψ_loc : S_p →+* T_q := Localization.localRingHom p q (algebraMap S₀ T₀) hpq
    have h_loc_eq : ψ_loc.comp (algebraMap S₀ S_p) = algebraMap S₀ T_q :=
      RingHom.ext fun x => by
        rw [RingHom.comp_apply, Localization.localRingHom_to_map,
          IsScalarTower.algebraMap_apply S₀ T₀ T_q]
    letI : Algebra S_p T_q := ψ_loc.toAlgebra
    haveI : IsScalarTower S₀ S_p T_q := IsScalarTower.of_algebraMap_eq' h_loc_eq.symm
    haveI : IsScalarTower K' S_p T_q := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq K' S₀ T_q, ← h_loc_eq, RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq K' S₀ S_p]
      rfl
    have hFlat_S₀T₀ : (algebraMap S₀ T₀).Flat :=
      RingHom.flat_algebraMap_iff.mpr (Algebra.Smooth.flat S₀ T₀)
    haveI : Module.Flat S_p T_q := RingHom.Flat.localRingHom hFlat_S₀T₀ q p hpq
    haveI : IsLocalHom (algebraMap S_p T_q) :=
      Localization.isLocalHom_localRingHom p q (algebraMap S₀ T₀) hpq
    haveI : Module.FaithfullyFlat S_p T_q := Module.FaithfullyFlat.of_flat_of_isLocalHom

    haveI : Algebra.FormallyEtale S₀ S_p := Algebra.FormallyEtale.of_isLocalization p.primeCompl
    haveI : Algebra.FormallyEtale T₀ T_q := Algebra.FormallyEtale.of_isLocalization q.primeCompl
    haveI : Algebra.FormallyEtale S₀ T_q := Algebra.FormallyEtale.comp S₀ T₀ T_q
    haveI : Algebra.FormallyEtale S_p T_q := Algebra.FormallyEtale.localization_base p.primeCompl

    let e_stalk : TensorProduct S_p T_q Ω[S_p ⁄ K'] ≃ₗ[T_q] T_q :=
      (((KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' S_p T_q).trans
        (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' T₀ T_q).symm).trans
        (LinearEquiv.baseChange T₀ T_q Ω[T₀ ⁄ K'] T₀ e_ΩT₀)).trans
        (TensorProduct.AlgebraTensorModule.rid T₀ T_q T_q)
    haveI : Module.Flat T_q (TensorProduct S_p T_q Ω[S_p ⁄ K']) :=
      Module.Flat.of_linearEquiv e_stalk
    haveI : Module.Flat S_p Ω[S_p ⁄ K'] :=
      Module.Flat.of_flat_tensorProduct S_p Ω[S_p ⁄ K'] T_q
    haveI : Module.Finite S₀ Ω[S₀ ⁄ K'] := KaehlerDifferential.finite K' S₀
    haveI : Module.Finite S_p Ω[S_p ⁄ K'] :=
      Module.Finite.equiv (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' S₀ S_p)
    haveI : Module.Free S_p Ω[S_p ⁄ K'] := Module.free_of_flat_of_isLocalRing
    refine ⟨inferInstance, ?_⟩
    have hbc := Module.rank_baseChange (R := T_q) (S := S_p) (M' := Ω[S_p ⁄ K'])
    rw [Cardinal.lift_id] at hbc
    rw [← hbc, e_stalk.rank_eq, Module.rank_self T_q]

  
  have h_ext_H1 : ∀ (E : Algebra.Extension K' S₀) [Algebra.FormallySmooth K' E.Ring],
      Function.Surjective (algebraMap E.Ring S₀) →
      Subsingleton (TensorProduct S₀ T₀ E.H1Cotangent) := by
    intro E _ hπ₀_surj
    have hStd0 : Algebra.IsStandardSmoothOfRelativeDimension 0 S₀ T₀ :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    obtain ⟨ι, σ, hFinσ, hFinι, Q, hQdim⟩ := hStd0.out
    letI : Finite σ := hFinσ
    letI : Finite ι := hFinι
    letI : Fintype σ := Fintype.ofFinite σ
    letI : DecidableEq σ := Classical.decEq σ
    letI : DecidableEq ι := Classical.decEq ι
    have hCard_le : Nat.card σ ≤ Nat.card ι :=
      Nat.card_le_card_of_injective Q.map Q.map_inj
    have hCard_eq : Nat.card ι = Nat.card σ := by
      have h0 : Nat.card ι - Nat.card σ = 0 := hQdim
      omega

    have hMap_surj : Function.Surjective (MvPolynomial.map (algebraMap E.Ring S₀) :
        MvPolynomial ι E.Ring →+* MvPolynomial ι S₀) :=
      MvPolynomial.map_surjective (algebraMap E.Ring S₀) hπ₀_surj
    choose g_tilde hg_tilde using fun s : σ => hMap_surj (Q.relation s)

    let I_g : Ideal (MvPolynomial ι E.Ring) := Ideal.span (Set.range g_tilde)
    let q_A₀ : MvPolynomial ι E.Ring →ₐ[E.Ring] (MvPolynomial ι E.Ring ⧸ I_g) :=
      Ideal.Quotient.mkₐ E.Ring I_g
    let M_tilde : Matrix σ σ (MvPolynomial ι E.Ring) :=
      Matrix.of fun a b => MvPolynomial.pderiv (Q.map a) (g_tilde b)
    let Δ₀ : MvPolynomial ι E.Ring := M_tilde.det
    let δ_tilde : MvPolynomial ι E.Ring ⧸ I_g := q_A₀ Δ₀
    let R' : Type u := Localization.Away δ_tilde

    
    haveI hEt_P₀R' : Algebra.Etale E.Ring R' := by
      let val' : ι ⊕ Unit → R' := Sum.elim
        (fun i => algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ (MvPolynomial.X i)))
        (fun _ => IsLocalization.Away.invSelf δ_tilde)
      have h_aeval_inl : ∀ F : MvPolynomial ι E.Ring,
          MvPolynomial.aeval val' (MvPolynomial.rename Sum.inl F) =
            algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) := by
        intro F
        rw [MvPolynomial.aeval_rename]
        have h_eq : (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R').comp q_A₀.toRingHom =
            (MvPolynomial.aeval (val' ∘ Sum.inl)).toRingHom := by
          apply MvPolynomial.ringHom_ext
          · intro p₀
            simp [← IsScalarTower.algebraMap_apply E.Ring (MvPolynomial ι E.Ring ⧸ I_g) R']
          · intro i
            simp [val']
        exact (DFunLike.congr_fun h_eq F).symm
      have h_val'_surj : Function.Surjective (MvPolynomial.aeval val' :
          MvPolynomial (ι ⊕ Unit) E.Ring →ₐ[E.Ring] R') := by
        intro z
        obtain ⟨k, a, hza⟩ := IsLocalization.Away.surj δ_tilde z
        obtain ⟨F, rfl⟩ : ∃ F : MvPolynomial ι E.Ring, q_A₀ F = a :=
          Ideal.Quotient.mk_surjective a
        refine ⟨MvPolynomial.rename Sum.inl F * (MvPolynomial.X (Sum.inr ())) ^ k, ?_⟩
        rw [map_mul, map_pow, h_aeval_inl, MvPolynomial.aeval_X]
        simp only [val', Sum.elim_inr]
        have hinv : algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde *
            IsLocalization.Away.invSelf δ_tilde = 1 :=
          IsLocalization.Away.mul_invSelf δ_tilde
        have hpow : (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde) ^ k *
            (IsLocalization.Away.invSelf δ_tilde) ^ k = 1 := by
          rw [← mul_pow, hinv, one_pow]
        calc
          algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) *
              IsLocalization.Away.invSelf δ_tilde ^ k
            = z * algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
                IsLocalization.Away.invSelf δ_tilde ^ k := by
              rw [hza]
          _ = z * (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
                IsLocalization.Away.invSelf δ_tilde ^ k) := by
              ring
          _ = z := by rw [hpow, mul_one]

      let G_R' : Algebra.Generators E.Ring R' (ι ⊕ Unit) :=
        Algebra.Generators.ofSurjective val' h_val'_surj
      let rel' : σ ⊕ Unit → MvPolynomial (ι ⊕ Unit) E.Ring := Sum.elim
        (fun s => MvPolynomial.rename Sum.inl (g_tilde s))
        (fun _ => MvPolynomial.rename Sum.inl Δ₀ * MvPolynomial.X (Sum.inr ()) - 1)
      have h_rel'_ker : Ideal.span (Set.range rel') = G_R'.ker := by
        let I_rel' : Ideal (MvPolynomial (ι ⊕ Unit) E.Ring) := Ideal.span (Set.range rel')
        have h_le : I_rel' ≤ RingHom.ker (MvPolynomial.aeval val').toRingHom := by
          rw [Ideal.span_le]
          rintro _ ⟨x, rfl⟩
          cases x with
          | inl s =>
            simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe,
              AlgHom.coe_toRingHom, rel', Sum.elim_inl, h_aeval_inl]
            have hmem : g_tilde s ∈ I_g := Ideal.subset_span ⟨s, rfl⟩
            have hq0 : q_A₀ (g_tilde s) = 0 :=
              (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
            rw [hq0, map_zero]
          | inr u =>
            simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe,
              AlgHom.coe_toRingHom, rel', Sum.elim_inr, map_sub, map_mul, map_one,
              h_aeval_inl, MvPolynomial.aeval_X, val']
            change algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde *
              IsLocalization.Away.invSelf δ_tilde - 1 = 0
            rw [IsLocalization.Away.mul_invSelf δ_tilde, sub_self]
        apply le_antisymm h_le
        let Q_quot := MvPolynomial (ι ⊕ Unit) E.Ring ⧸ I_rel'
        let mk_rel' : MvPolynomial (ι ⊕ Unit) E.Ring →ₐ[E.Ring] Q_quot :=
          Ideal.Quotient.mkₐ E.Ring I_rel'
        let Φ_fwd : Q_quot →ₐ[E.Ring] R' := Ideal.Quotient.liftₐ I_rel' (MvPolynomial.aeval val')
          (fun f hf => h_le hf)
        let φ_inl : MvPolynomial ι E.Ring →ₐ[E.Ring] Q_quot :=
          mk_rel'.comp (MvPolynomial.rename Sum.inl)
        have h_φ_inl_ker : ∀ f ∈ I_g, φ_inl f = 0 := by
          have hsub : I_g ≤ RingHom.ker φ_inl.toRingHom := by
            rw [Ideal.span_le]
            rintro _ ⟨s, rfl⟩
            change Ideal.Quotient.mk I_rel' (rel' (Sum.inl s)) = 0
            exact (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span ⟨Sum.inl s, rfl⟩)
          exact fun f hf => hsub hf
        let ψ₀ : (MvPolynomial ι E.Ring ⧸ I_g) →ₐ[E.Ring] Q_quot :=
          Ideal.Quotient.liftₐ I_g φ_inl h_φ_inl_ker
        have h_δ_mul : ψ₀ δ_tilde * mk_rel' (MvPolynomial.X (Sum.inr ())) = 1 := by
          have hmem : rel' (Sum.inr ()) ∈ I_rel' := Ideal.subset_span ⟨Sum.inr (), rfl⟩
          have h0 : mk_rel' (rel' (Sum.inr ())) = 0 :=
            (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
          simp only [rel', Sum.elim_inr, map_sub, map_mul, map_one] at h0
          exact sub_eq_zero.mp h0
        have h_δ_unit : IsUnit (ψ₀.toRingHom δ_tilde) :=
          ⟨⟨ψ₀ δ_tilde, mk_rel' (MvPolynomial.X (Sum.inr ())), h_δ_mul,
            by rw [mul_comm]; exact h_δ_mul⟩, rfl⟩
        let Φ_inv : R' →+* Q_quot := IsLocalization.Away.lift δ_tilde h_δ_unit
        have h_left_inv : Φ_inv.comp Φ_fwd.toRingHom = RingHom.id Q_quot := by
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext
          · intro p₀
            change Φ_inv (Φ_fwd (mk_rel' (MvPolynomial.C p₀))) = mk_rel' (MvPolynomial.C p₀)
            have h1 : Φ_fwd (mk_rel' (MvPolynomial.C p₀)) = algebraMap E.Ring R' p₀ := by
              change (MvPolynomial.aeval val') (MvPolynomial.C p₀) = algebraMap E.Ring R' p₀
              exact MvPolynomial.aeval_C val' p₀
            rw [h1, IsScalarTower.algebraMap_apply E.Ring (MvPolynomial ι E.Ring ⧸ I_g) R' p₀,
              IsLocalization.Away.lift_eq δ_tilde h_δ_unit]
            change ψ₀ (algebraMap E.Ring (MvPolynomial ι E.Ring ⧸ I_g) p₀) = _
            rw [ψ₀.commutes]
            rfl
          · intro x
            change Φ_inv (Φ_fwd (mk_rel' (MvPolynomial.X x))) = mk_rel' (MvPolynomial.X x)
            cases x with
            | inl i =>
              have h1 : Φ_fwd (mk_rel' (MvPolynomial.X (Sum.inl i))) =
                  algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ (MvPolynomial.X i)) := by
                change (MvPolynomial.aeval val') (MvPolynomial.X (Sum.inl i)) = _
                rw [MvPolynomial.aeval_X]
                rfl
              rw [h1, IsLocalization.Away.lift_eq δ_tilde h_δ_unit]
              change mk_rel' (MvPolynomial.rename Sum.inl (MvPolynomial.X i)) = _
              rw [MvPolynomial.rename_X]
            | inr u =>
              cases u
              have h1 : Φ_fwd (mk_rel' (MvPolynomial.X (Sum.inr ()))) =
                  IsLocalization.Away.invSelf δ_tilde := by
                change (MvPolynomial.aeval val') (MvPolynomial.X (Sum.inr ())) = _
                rw [MvPolynomial.aeval_X]
                rfl
              rw [h1]
              have h_inv_mul : ψ₀ δ_tilde * Φ_inv (IsLocalization.Away.invSelf δ_tilde) = 1 := by
                have h2 : ψ₀ δ_tilde =
                    Φ_inv (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde) :=
                  (IsLocalization.Away.lift_eq δ_tilde h_δ_unit δ_tilde).symm
                rw [h2, ← map_mul, IsLocalization.Away.mul_invSelf δ_tilde, map_one]
              calc
                Φ_inv (IsLocalization.Away.invSelf δ_tilde)
                  = Φ_inv (IsLocalization.Away.invSelf δ_tilde) *
                      (ψ₀ δ_tilde * mk_rel' (MvPolynomial.X (Sum.inr ()))) := by
                    rw [h_δ_mul, mul_one]
                _ = (ψ₀ δ_tilde * Φ_inv (IsLocalization.Away.invSelf δ_tilde)) *
                      mk_rel' (MvPolynomial.X (Sum.inr ())) := by ring
                _ = mk_rel' (MvPolynomial.X (Sum.inr ())) := by rw [h_inv_mul, one_mul]
        intro f hf
        have hmk : Φ_fwd (mk_rel' f) = 0 := hf
        have h2 : Φ_inv (Φ_fwd (mk_rel' f)) = 0 := by rw [hmk, map_zero]
        have h3 : mk_rel' f = 0 := by
          simpa using (DFunLike.congr_fun h_left_inv (mk_rel' f)).symm.trans h2
        exact (Ideal.Quotient.eq_zero_iff_mem).mp h3

      let pres_R' : Algebra.Presentation E.Ring R' (ι ⊕ Unit) (σ ⊕ Unit) :=
        Algebra.Presentation.mk G_R' rel' h_rel'_ker
      have h_map'_inj : Function.Injective (Sum.map Q.map (@id Unit)) :=
        Q.map_inj.sumMap Function.injective_id
      let pre_R' : Algebra.PreSubmersivePresentation E.Ring R' (ι ⊕ Unit) (σ ⊕ Unit) :=
        Algebra.PreSubmersivePresentation.mk pres_R' (Sum.map Q.map (@id Unit)) h_map'_inj
      have h_jac_unit : IsUnit pre_R'.jacobian := by
        letI : Fintype (σ ⊕ Unit) := inferInstance
        letI : DecidableEq (σ ⊕ Unit) := inferInstance
        rw [pre_R'.jacobian_eq_jacobiMatrix_det]
        have h_notMem : ∀ F : MvPolynomial ι E.Ring,
            (Sum.inr () : ι ⊕ Unit) ∉ (MvPolynomial.rename Sum.inl F).vars := by
          intro F hmem
          have hsub := MvPolynomial.vars_rename Sum.inl F hmem
          simp at hsub
        let B₁₁ : Matrix σ σ (MvPolynomial (ι ⊕ Unit) E.Ring) :=
          (MvPolynomial.rename Sum.inl).toRingHom.mapMatrix M_tilde
        let B₁₂ : Matrix σ Unit (MvPolynomial (ι ⊕ Unit) E.Ring) :=
          Matrix.of fun a _ => pre_R'.jacobiMatrix (Sum.inl a) (Sum.inr ())
        let B₂₂ : Matrix Unit Unit (MvPolynomial (ι ⊕ Unit) E.Ring) :=
          Matrix.of fun _ _ => MvPolynomial.rename Sum.inl Δ₀
        have h_mat_eq : pre_R'.jacobiMatrix = Matrix.fromBlocks B₁₁ B₁₂ 0 B₂₂ := by
          refine Matrix.ext fun x y => ?_
          cases x with
          | inl a =>
            cases y with
            | inl b =>
              rw [pre_R'.jacobiMatrix_apply]
              exact MvPolynomial.pderiv_rename Sum.inl_injective (Q.map a) (g_tilde b)
            | inr u => rfl
          | inr u =>
            cases u
            cases y with
            | inl b =>
              rw [pre_R'.jacobiMatrix_apply]
              exact MvPolynomial.pderiv_eq_zero_of_notMem_vars (h_notMem (g_tilde b))
            | inr v =>
              cases v
              rw [pre_R'.jacobiMatrix_apply]
              change MvPolynomial.pderiv (Sum.inr ())
                (MvPolynomial.rename Sum.inl Δ₀ * MvPolynomial.X (Sum.inr ()) - 1) =
                MvPolynomial.rename Sum.inl Δ₀
              rw [map_sub, Derivation.map_one_eq_zero, MvPolynomial.pderiv_mul,
                MvPolynomial.pderiv_X_self,
                MvPolynomial.pderiv_eq_zero_of_notMem_vars (h_notMem Δ₀)]
              ring
        rw [h_mat_eq, Matrix.det_fromBlocks_zero₂₁]
        have hdet1 : B₁₁.det = MvPolynomial.rename Sum.inl Δ₀ := by
          dsimp [B₁₁, Δ₀]
          exact (RingHom.map_det (MvPolynomial.rename Sum.inl).toRingHom M_tilde).symm
        have hdet2 : B₂₂.det = MvPolynomial.rename Sum.inl Δ₀ := by
          rw [Matrix.det_unique]
          rfl
        rw [hdet1, hdet2]
        change IsUnit (MvPolynomial.aeval val'
          (MvPolynomial.rename Sum.inl Δ₀ * MvPolynomial.rename Sum.inl Δ₀))
        rw [map_mul, h_aeval_inl]
        exact (IsLocalization.Away.algebraMap_isUnit δ_tilde).mul
          (IsLocalization.Away.algebraMap_isUnit δ_tilde)

      let sub_R' : Algebra.SubmersivePresentation E.Ring R' (ι ⊕ Unit) (σ ⊕ Unit) :=
        Algebra.SubmersivePresentation.mk pre_R' h_jac_unit
      have h_dim_R' : sub_R'.dimension = 0 := by
        change Nat.card (ι ⊕ Unit) - Nat.card (σ ⊕ Unit) = 0
        rw [Nat.card_sum, Nat.card_sum, hCard_eq, Nat.sub_self]
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 E.Ring R' :=
        sub_R'.isStandardSmoothOfRelativeDimension h_dim_R'
      exact Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr inferInstance

    haveI : Module.Flat E.Ring R' := Algebra.Smooth.flat E.Ring R'
    haveI : Algebra.FormallyEtale E.Ring R' := inferInstance
    haveI : Algebra.FormallySmooth K' R' := Algebra.FormallySmooth.comp K' E.Ring R'

    
    let ev_T₀ : MvPolynomial ι E.Ring →+* T₀ :=
      (MvPolynomial.aeval Q.val).toRingHom.comp (MvPolynomial.map (algebraMap E.Ring S₀))
    have h_ev_ker : ∀ f ∈ I_g, ev_T₀ f = 0 := by
      have hsub : I_g ≤ RingHom.ker ev_T₀ := by
        rw [Ideal.span_le]
        rintro _ ⟨s, rfl⟩
        simp only [SetLike.mem_coe, RingHom.mem_ker, ev_T₀, RingHom.comp_apply, hg_tilde]
        have hmem : Q.relation s ∈ Q.ker := by
          rw [← Q.span_range_relation_eq_ker]
          exact Ideal.subset_span ⟨s, rfl⟩
        have h0 : (algebraMap Q.Ring T₀) (Q.relation s) = 0 := hmem
        rwa [Q.algebraMap_apply] at h0
      exact fun f hf => hsub hf
    let ψ_A₀ : (MvPolynomial ι E.Ring ⧸ I_g) →+* T₀ := Ideal.Quotient.lift I_g ev_T₀ h_ev_ker
    have h_ψ_δ_eq : ψ_A₀ δ_tilde = Q.jacobian := by
      rw [Q.jacobian_eq_jacobiMatrix_det, Q.algebraMap_apply]
      change (MvPolynomial.aeval Q.val) (MvPolynomial.map (algebraMap E.Ring S₀) M_tilde.det) =
        (MvPolynomial.aeval Q.val) Q.jacobiMatrix.det
      congr 1
      rw [RingHom.map_det]
      congr 1
      refine Matrix.ext fun a b => ?_
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, M_tilde, Matrix.of_apply,
        Q.jacobiMatrix_apply, ← hg_tilde]
      exact (MvPolynomial.pderiv_map).symm
    have h_ψ_δ_unit : IsUnit (ψ_A₀ δ_tilde) := h_ψ_δ_eq ▸ Q.jacobian_isUnit
    let ψ_R'_hom : R' →+* T₀ := IsLocalization.Away.lift δ_tilde h_ψ_δ_unit
    have h_ψ_P₀ : ∀ p₀ : E.Ring, ψ_R'_hom (algebraMap E.Ring R' p₀) =
        algebraMap S₀ T₀ (algebraMap E.Ring S₀ p₀) := by
      intro p₀
      rw [IsScalarTower.algebraMap_apply E.Ring (MvPolynomial ι E.Ring ⧸ I_g) R' p₀,
        IsLocalization.Away.lift_eq δ_tilde h_ψ_δ_unit, ← q_A₀.commutes p₀]
      change (MvPolynomial.aeval Q.val)
        (MvPolynomial.map (algebraMap E.Ring S₀) (MvPolynomial.C p₀)) = _
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
    let ψ_R' : R' →ₐ[K'] T₀ :=
      { ψ_R'_hom with
        commutes' := fun c => by
          change ψ_R'_hom (algebraMap K' R' c) = algebraMap K' T₀ c
          rw [IsScalarTower.algebraMap_apply K' E.Ring R' c, h_ψ_P₀,
            ← IsScalarTower.algebraMap_apply K' E.Ring S₀,
            ← IsScalarTower.algebraMap_apply K' S₀ T₀] }
    have h_ψ_surj : Function.Surjective ψ_R' := by
      intro t
      obtain ⟨F_S, hFS⟩ := Q.algebraMap_surjective t
      rw [Q.algebraMap_apply] at hFS
      obtain ⟨F_P, hFP⟩ := hMap_surj F_S
      refine ⟨algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F_P), ?_⟩
      change ψ_R'_hom (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F_P)) = t
      rw [IsLocalization.Away.lift_eq δ_tilde h_ψ_δ_unit]
      change (MvPolynomial.aeval Q.val) (MvPolynomial.map (algebraMap E.Ring S₀) F_P) = t
      rw [hFP]
      exact hFS

    have h_ker_R' : RingHom.ker ψ_R'_hom = Ideal.map (algebraMap E.Ring R') E.ker := by
      apply le_antisymm
      · intro z hz
        have hz0 : ψ_R'_hom z = 0 := hz
        obtain ⟨k, a, hza⟩ := IsLocalization.Away.surj δ_tilde z
        obtain ⟨F, rfl⟩ : ∃ F : MvPolynomial ι E.Ring, q_A₀ F = a :=
          Ideal.Quotient.mk_surjective a
        have h_evF : ev_T₀ F = 0 := by
          have h1 : ψ_R'_hom (z * algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k) =
              ψ_R'_hom (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F)) :=
            congrArg ψ_R'_hom hza
          rw [map_mul, hz0, zero_mul, IsLocalization.Away.lift_eq δ_tilde h_ψ_δ_unit] at h1
          exact h1.symm
        have h_in_Qker : MvPolynomial.map (algebraMap E.Ring S₀) F ∈ Q.ker := by
          change (algebraMap Q.Ring T₀) (MvPolynomial.map (algebraMap E.Ring S₀) F) = 0
          rw [Q.algebraMap_apply]
          exact h_evF
        rw [← Q.span_range_relation_eq_ker] at h_in_Qker
        have h_range : Set.range Q.relation =
            MvPolynomial.map (algebraMap E.Ring S₀) '' Set.range g_tilde := by
          ext h
          simp only [Set.mem_range, Set.mem_image]
          constructor
          · rintro ⟨s, rfl⟩
            exact ⟨g_tilde s, ⟨s, rfl⟩, hg_tilde s⟩
          · rintro ⟨_, ⟨s, rfl⟩, rfl⟩
            exact ⟨s, (hg_tilde s).symm⟩
        rw [h_range, ← Ideal.map_span] at h_in_Qker
        obtain ⟨G, hG_mem, hGF⟩ :=
          Ideal.mem_image_of_mem_map_of_surjective _ hMap_surj h_in_Qker
        have h_diff : F - G ∈ RingHom.ker (MvPolynomial.map (algebraMap E.Ring S₀)) := by
          rw [RingHom.mem_ker, map_sub, hGF, sub_self]
        rw [MvPolynomial.ker_map] at h_diff
        change F - G ∈ Ideal.map MvPolynomial.C E.ker at h_diff
        have h_qFG : q_A₀ (F - G) ∈
            Ideal.map (algebraMap E.Ring (MvPolynomial ι E.Ring ⧸ I_g)) E.ker := by
          have h1 : q_A₀ (F - G) ∈ Ideal.map q_A₀.toRingHom (Ideal.map MvPolynomial.C E.ker) :=
            Ideal.mem_map_of_mem q_A₀.toRingHom h_diff
          rw [Ideal.map_map] at h1
          have hcomp : q_A₀.toRingHom.comp MvPolynomial.C =
              algebraMap E.Ring (MvPolynomial ι E.Ring ⧸ I_g) := by
            ext p₀
            exact q_A₀.commutes p₀
          rwa [hcomp] at h1
        have h_qG : q_A₀ G = 0 := (Ideal.Quotient.eq_zero_iff_mem).mpr hG_mem
        rw [map_sub, h_qG, sub_zero] at h_qFG
        have h_in_R' : algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) ∈
            Ideal.map (algebraMap E.Ring R') E.ker := by
          have h2 := Ideal.mem_map_of_mem (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R') h_qFG
          rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq E.Ring _ R'] at h2
          exact h2
        have hz_eq : z = algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) *
            (IsLocalization.Away.invSelf δ_tilde) ^ k := by
          have hinv : algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
              (IsLocalization.Away.invSelf δ_tilde) ^ k = 1 := by
            rw [← mul_pow, IsLocalization.Away.mul_invSelf δ_tilde, one_pow]
          calc
            z = z * (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
                  (IsLocalization.Away.invSelf δ_tilde) ^ k) := by
              rw [hinv, mul_one]
            _ = (z * algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k) *
                  (IsLocalization.Away.invSelf δ_tilde) ^ k := by
              ring
            _ = algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) *
                  (IsLocalization.Away.invSelf δ_tilde) ^ k := by
              rw [hza]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ _ h_in_R'
      · rw [Ideal.map_le_iff_le_comap]
        intro j hj
        have hj0 : algebraMap E.Ring S₀ j = 0 := hj
        simp only [Ideal.mem_comap, RingHom.mem_ker]
        rw [h_ψ_P₀, hj0, map_zero]

    let P' : Algebra.Extension K' T₀ := Algebra.Extension.ofSurjective ψ_R' h_ψ_surj
    let _ : Algebra E.Ring P'.Ring := (inferInstance : Algebra E.Ring R')
    have _ : Module.Flat E.Ring P'.Ring := (inferInstance : Module.Flat E.Ring R')
    let f_ext : E.Hom P' :=
      Algebra.Extension.Hom.mk (algebraMap E.Ring P'.Ring)
        (fun c => (IsScalarTower.algebraMap_apply K' E.Ring R' c).symm)
        (fun p₀ => h_ψ_P₀ p₀)

    
    have h_ker_bij : Function.Bijective
        (LinearMap.liftBaseChange P'.Ring (f_ext.mapKer rfl)) := by
      let L_ker : TensorProduct E.Ring P'.Ring ↥E.ker →ₗ[P'.Ring] ↥P'.ker :=
        LinearMap.liftBaseChange P'.Ring (f_ext.mapKer rfl)
      let sub_P' : ↥P'.ker →ₗ[E.Ring] P'.Ring := P'.ker.subtype.restrictScalars E.Ring
      have h_comp : sub_P' ∘ₗ (L_ker.restrictScalars E.Ring) =
          ((TensorProduct.AlgebraTensorModule.rid E.Ring P'.Ring P'.Ring).toLinearMap.restrictScalars E.Ring) ∘ₗ
            LinearMap.lTensor P'.Ring E.ker.subtype := by
        apply TensorProduct.ext'
        intro r' x
        simp only [L_ker, sub_P', LinearMap.comp_apply, LinearMap.coe_restrictScalars,
          LinearMap.liftBaseChange_tmul, Submodule.coe_subtype, SetLike.val_smul,
          smul_eq_mul, LinearEquiv.coe_toLinearMap, LinearMap.lTensor_tmul,
          TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
        exact mul_comm _ _
      have h_inj : Function.Injective L_ker := by
        change Function.Injective (L_ker.restrictScalars E.Ring)
        apply Function.Injective.of_comp (f := sub_P')
        change Function.Injective ⇑(sub_P' ∘ₗ L_ker.restrictScalars E.Ring)
        rw [h_comp]
        exact (TensorProduct.AlgebraTensorModule.rid E.Ring P'.Ring P'.Ring).injective.comp
          (Module.Flat.lTensor_preserves_injective_linearMap E.ker.subtype Subtype.val_injective)
      refine ⟨h_inj, ?_⟩
      intro y
      have hy : y.1 ∈ Ideal.map (algebraMap E.Ring P'.Ring) E.ker := by
        have hy_ker : (y.1 : R') ∈ RingHom.ker ψ_R'_hom := y.2
        exact h_ker_R' ▸ hy_ker
      rw [Ideal.map] at hy
      have hex : ∃ u : TensorProduct E.Ring P'.Ring ↥E.ker, (L_ker u).1 = y.1 := by
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
        · rintro _ ⟨j, hj, rfl⟩
          refine ⟨(1 : P'.Ring) ⊗ₜ[E.Ring] (⟨j, hj⟩ : ↥E.ker), ?_⟩
          have h1 := LinearMap.congr_fun h_comp ((1 : P'.Ring) ⊗ₜ[E.Ring] ⟨j, hj⟩)
          simpa [sub_P', Algebra.smul_def] using h1
        · exact ⟨0, by simp⟩
        · rintro x₁ x₂ _ _ ⟨u₁, hu₁⟩ ⟨u₂, hu₂⟩
          exact ⟨u₁ + u₂, by simp [hu₁, hu₂]⟩
        · rintro r' x₁ _ ⟨u₁, hu₁⟩
          refine ⟨r' • u₁, ?_⟩
          rw [map_smul]
          exact congrArg (r' * ·) hu₁
      obtain ⟨u, hu⟩ := hex
      exact ⟨u, Subtype.ext hu⟩

    let e_cot : TensorProduct S₀ T₀ E.Cotangent ≃ₗ[T₀] P'.Cotangent :=
      Algebra.Extension.tensorCotangent f_ext rfl h_ker_bij

    
    letI : Algebra E.Ring T₀ := ((algebraMap S₀ T₀).comp (algebraMap E.Ring S₀)).toAlgebra
    haveI : IsScalarTower E.Ring S₀ T₀ := IsScalarTower.of_algebraMap_eq' rfl
    letI : Algebra R' T₀ := P'.algebra₂
    haveI : IsScalarTower E.Ring R' T₀ :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun p₀ => (h_ψ_P₀ p₀).symm)

    let e_sp1 : TensorProduct S₀ T₀ (TensorProduct E.Ring S₀ Ω[E.Ring ⁄ K']) ≃ₗ[T₀]
        TensorProduct E.Ring T₀ Ω[E.Ring ⁄ K'] :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange E.Ring S₀ T₀ T₀ Ω[E.Ring ⁄ K']
    let e_sp2 : TensorProduct E.Ring T₀ Ω[E.Ring ⁄ K'] ≃ₗ[T₀]
        TensorProduct R' T₀ (TensorProduct E.Ring R' Ω[E.Ring ⁄ K']) :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange E.Ring R' T₀ T₀ Ω[E.Ring ⁄ K']).symm
    let e_sp3 : TensorProduct R' T₀ (TensorProduct E.Ring R' Ω[E.Ring ⁄ K']) ≃ₗ[T₀]
        TensorProduct R' T₀ Ω[R' ⁄ K'] :=
      LinearEquiv.baseChange R' T₀ (TensorProduct E.Ring R' Ω[E.Ring ⁄ K']) Ω[R' ⁄ K']
        (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' E.Ring R')
    let e_sp : TensorProduct S₀ T₀ E.CotangentSpace ≃ₗ[T₀] P'.CotangentSpace :=
      (e_sp1.trans e_sp2).trans e_sp3

    have h_esp_apply : ∀ u : TensorProduct S₀ T₀ E.CotangentSpace,
        e_sp u = LinearMap.liftBaseChange T₀ (Algebra.Extension.CotangentSpace.map f_ext) u := by
      intro u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
      | tmul t v =>
        induction v using TensorProduct.induction_on with
        | zero => simp
        | add x y ihx ihy => rw [TensorProduct.tmul_add, map_add, map_add, ihx, ihy]
        | tmul s ω =>
          have hω_top : ω ∈ (⊤ : Submodule E.Ring Ω[E.Ring ⁄ K']) := Submodule.mem_top
          rw [← KaehlerDifferential.span_range_derivation K' E.Ring] at hω_top
          revert s
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hω_top
          · rintro _ ⟨y, rfl⟩ s
            have hLHS : e_sp (t ⊗ₜ[S₀] (s ⊗ₜ[E.Ring] KaehlerDifferential.D K' E.Ring y)) =
                (s • t) ⊗ₜ[R'] KaehlerDifferential.D K' R' (algebraMap E.Ring R' y) := by
              change e_sp3 (e_sp2 (e_sp1 (t ⊗ₜ[S₀]
                (s ⊗ₜ[E.Ring] KaehlerDifferential.D K' E.Ring y)))) = _
              rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
              rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul]
              rw [LinearEquiv.baseChange_tmul,
                KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
                KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D, one_smul]
            rw [hLHS, LinearMap.liftBaseChange_tmul, Algebra.Extension.CotangentSpace.map_tmul]
            change (s • t) ⊗ₜ[R'] KaehlerDifferential.D K' R' (algebraMap E.Ring R' y) =
              t • (algebraMap S₀ T₀ s ⊗ₜ[R'] KaehlerDifferential.D K' R' (algebraMap E.Ring R' y))
            rw [TensorProduct.smul_tmul', Algebra.smul_def, smul_eq_mul, mul_comm]
          · intro s
            simp
          · intro ω₁ ω₂ _ _ ih₁ ih₂ s
            simp [TensorProduct.tmul_add, ih₁ s, ih₂ s]
          · intro p₀ ω₁ _ ih₁ s
            have hsmul : s ⊗ₜ[E.Ring] (p₀ • ω₁) = (p₀ • s) ⊗ₜ[E.Ring] ω₁ := by
              rw [TensorProduct.smul_tmul]
            rw [hsmul]
            exact ih₁ (p₀ • s)

    have h_comm_cc : ∀ u : TensorProduct S₀ T₀ E.Cotangent,
        e_sp (LinearMap.lTensor T₀ E.cotangentComplex u) =
          P'.cotangentComplex (e_cot u) := by
      intro u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | add x y ihx ihy => rw [map_add, map_add, map_add, map_add, ihx, ihy]
      | tmul t x =>
        rw [LinearMap.lTensor_tmul, h_esp_apply, LinearMap.liftBaseChange_tmul]
        have hmap := LinearMap.congr_fun
          (Algebra.Extension.CotangentSpace.map_comp_cotangentComplex f_ext) x
        simp only [LinearMap.comp_apply, LinearMap.coe_restrictScalars] at hmap
        rw [hmap, ← map_smul]
        rfl

    have h_P'_inj : Function.Injective P'.cotangentComplex :=
      (@Algebra.Extension.cotangentComplex_injective_iff K' T₀ _ _ _ P'
        (inferInstance : Algebra.FormallySmooth K' R')).mpr hSub_T₀
    have h_lTensor_cc_inj : Function.Injective
        (LinearMap.lTensor T₀ E.cotangentComplex) := by
      intro u₁ u₂ hu
      apply e_cot.injective
      apply h_P'_inj
      rw [← h_comm_cc u₁, ← h_comm_cc u₂, hu]

    haveI : Module.Flat S₀ T₀ := Algebra.Smooth.flat S₀ T₀
    have h_ι_inj : Function.Injective
        (LinearMap.lTensor T₀ E.h1Cotangentι) :=
      Module.Flat.lTensor_preserves_injective_linearMap
        E.h1Cotangentι Algebra.Extension.h1Cotangentι_injective
    have h_cc_ι_zero : E.cotangentComplex ∘ₗ E.h1Cotangentι = 0 := by
      ext x
      exact x.2
    refine Subsingleton.intro fun u v => ?_
    apply h_ι_inj
    apply h_lTensor_cc_inj
    have hcomp : LinearMap.lTensor T₀ E.cotangentComplex ∘ₗ
        LinearMap.lTensor T₀ E.h1Cotangentι = 0 := by
      rw [← LinearMap.lTensor_comp, h_cc_ι_zero, LinearMap.lTensor_zero]
    have hu := LinearMap.congr_fun hcomp u
    have hv := LinearMap.congr_fun hcomp v
    simpa using hu.trans hv.symm

  haveI : Algebra.FormallySmooth K' (Algebra.Generators.self K' S₀).toExtension.Ring := by
    change Algebra.FormallySmooth K' (MvPolynomial S₀ K')
    infer_instance
  have h_sub_T₀H1 : Subsingleton (TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀)) :=
    h_ext_H1 (Algebra.Generators.self K' S₀).toExtension
      (Algebra.Generators.self K' S₀).algebraMap_surjective

  
  have hSub_Sp : Subsingleton (Algebra.H1Cotangent K' (Localization.AtPrime p)) := by
    let S_p : Type u := Localization.AtPrime p
    let T_q : Type u := Localization.AtPrime q
    let ψ_loc : S_p →+* T_q := Localization.localRingHom p q (algebraMap S₀ T₀) hpq
    have h_loc_eq : ψ_loc.comp (algebraMap S₀ S_p) = algebraMap S₀ T_q :=
      RingHom.ext fun x => by
        rw [RingHom.comp_apply, Localization.localRingHom_to_map,
          IsScalarTower.algebraMap_apply S₀ T₀ T_q]
    letI : Algebra S_p T_q := ψ_loc.toAlgebra
    haveI : IsScalarTower S₀ S_p T_q := IsScalarTower.of_algebraMap_eq' h_loc_eq.symm
    have hFlat_S₀T₀ : (algebraMap S₀ T₀).Flat :=
      RingHom.flat_algebraMap_iff.mpr (Algebra.Smooth.flat S₀ T₀)
    haveI : Module.Flat S_p T_q := RingHom.Flat.localRingHom hFlat_S₀T₀ q p hpq
    haveI : IsLocalHom (algebraMap S_p T_q) :=
      Localization.isLocalHom_localRingHom p q (algebraMap S₀ T₀) hpq
    haveI : Module.FaithfullyFlat S_p T_q := Module.FaithfullyFlat.of_flat_of_isLocalHom

    haveI : Subsingleton (TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀)) := h_sub_T₀H1
    haveI : Subsingleton
        (TensorProduct T₀ T_q (TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀))) := by
      let M₀ := TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀)
      have hid0 : (LinearMap.id : M₀ →ₗ[T₀] M₀) = 0 := by
        ext m
        exact Subsingleton.elim _ _
      refine ⟨fun x y => ?_⟩
      have hzero : ∀ z : TensorProduct T₀ T_q M₀, z = 0 := by
        intro z
        have hz : LinearMap.lTensor T_q (LinearMap.id : M₀ →ₗ[T₀] M₀) z = z := by
          rw [LinearMap.lTensor_id]
          rfl
        rw [← hz, hid0, LinearMap.lTensor_zero, LinearMap.zero_apply]
      rw [hzero x, hzero y]

    let e_h1_1 := TensorProduct.AlgebraTensorModule.cancelBaseChange S₀ T₀ T_q T_q
      (Algebra.H1Cotangent K' S₀)
    let e_h1_2 := (TensorProduct.AlgebraTensorModule.cancelBaseChange S₀ S_p T_q T_q
      (Algebra.H1Cotangent K' S₀)).symm
    let e_h1_3 := LinearEquiv.baseChange S_p T_q
      (TensorProduct S₀ S_p (Algebra.H1Cotangent K' S₀)) (Algebra.H1Cotangent K' S_p)
      (Algebra.tensorH1CotangentOfIsLocalization K' S_p p.primeCompl)
    let e_h1 := (e_h1_1.trans e_h1_2).trans e_h1_3
    haveI : Subsingleton (TensorProduct S_p T_q (Algebra.H1Cotangent K' S_p)) :=
      e_h1.symm.injective.subsingleton

    let zero_map : Algebra.H1Cotangent K' S_p →ₗ[S_p] Algebra.H1Cotangent K' S_p := 0
    have h_lt_zero_inj : Function.Injective (LinearMap.lTensor T_q zero_map) :=
      fun x y _ => Subsingleton.elim x y
    have h_zero_inj : Function.Injective zero_map :=
      (Module.FaithfullyFlat.lTensor_injective_iff_injective S_p T_q zero_map).mp h_lt_zero_inj
    exact ⟨fun x y => h_zero_inj (by simp [zero_map])⟩

  
  haveI : Algebra.IsSmoothAt K' p := Algebra.FormallySmooth.mk hKaehler_Sp.1 hSub_Sp
  obtain ⟨f, hf, hStd_f⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth K' p
  haveI : Algebra.IsStandardSmooth K' (Localization.Away f) := hStd_f

  have h_powers_unit : ∀ y : Submonoid.powers f,
      IsUnit (algebraMap S₀ (Localization.AtPrime p) y) := by
    rintro ⟨_, k, rfl⟩
    change IsUnit (algebraMap S₀ (Localization.AtPrime p) (f ^ k))
    rw [map_pow]
    exact (IsLocalization.map_units (Localization.AtPrime p) (⟨f, hf⟩ : p.primeCompl)).pow k
  let φ_fp : Localization.Away f →+* Localization.AtPrime p :=
    IsLocalization.lift (M := Submonoid.powers f) h_powers_unit
  have h_fp_eq : φ_fp.comp (algebraMap S₀ (Localization.Away f)) =
      algebraMap S₀ (Localization.AtPrime p) :=
    RingHom.ext fun x =>
      IsLocalization.lift_eq (M := Submonoid.powers f) (S := Localization.Away f) h_powers_unit x
  letI : Algebra (Localization.Away f) (Localization.AtPrime p) := φ_fp.toAlgebra
  haveI : IsScalarTower S₀ (Localization.Away f) (Localization.AtPrime p) :=
    IsScalarTower.of_algebraMap_eq' h_fp_eq.symm
  haveI : IsScalarTower K' (Localization.Away f) (Localization.AtPrime p) := by
    apply IsScalarTower.of_algebraMap_eq'
    rw [IsScalarTower.algebraMap_eq K' S₀ (Localization.AtPrime p), ← h_fp_eq,
      RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq K' S₀ (Localization.Away f)]
    rfl

  haveI : Algebra.FormallyEtale S₀ (Localization.AtPrime p) :=
    Algebra.FormallyEtale.of_isLocalization p.primeCompl
  haveI : Algebra.FormallyEtale (Localization.Away f) (Localization.AtPrime p) :=
    Algebra.FormallyEtale.localization_base (Submonoid.powers f)
  let e_fp : TensorProduct (Localization.Away f) (Localization.AtPrime p)
      Ω[Localization.Away f ⁄ K'] ≃ₗ[Localization.AtPrime p] Ω[Localization.AtPrime p ⁄ K'] :=
    KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K'
      (Localization.Away f) (Localization.AtPrime p)
  haveI : Nontrivial (Localization.Away f) := RingHom.domain_nontrivial φ_fp
  haveI : Module.Free (Localization.Away f) Ω[Localization.Away f ⁄ K'] :=
    Algebra.IsStandardSmooth.free_kaehlerDifferential
  have hRank_Sf : Module.rank (Localization.Away f) Ω[Localization.Away f ⁄ K'] =
      ((1 : ℕ) : Cardinal.{u}) := by
    have hbc := Module.rank_baseChange
      (R := Localization.AtPrime p) (S := Localization.Away f)
      (M' := Ω[Localization.Away f ⁄ K'])
    rw [Cardinal.lift_id] at hbc
    rw [← hbc, e_fp.rank_eq, hKaehler_Sp.2, Nat.cast_one]
  haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 K' (Localization.Away f) :=
    (Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth 1).mpr hRank_Sf
  exact ⟨f, hf, (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance⟩

theorem weil_nodal_etale_algebra_reduced_and_branch_ideals (K' : Type u) [Field K'] :
    let A_nod : Type u :=
      MvPolynomial (Fin 2) K' ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) K'))
    let c_nod : K' →+* A_nod := (Ideal.Quotient.mk _).comp MvPolynomial.C
    ((∀ (R B : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R]
        [CommRing B] [Algebra R B] [Algebra.Etale R B], IsReduced B) ∧
      IsNoetherianRing A_nod ∧ IsReduced A_nod) ∧
    (∀ (B : Type u) [CommRing B] (φ₂ : A_nod →+* B),
      φ₂.Etale →
      (∀ i : Fin 2,
        ∃ ψ_i : Polynomial K' →+*
            Localization.Away (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))),
          ψ_i.Etale ∧
          ψ_i.comp Polynomial.C =
            (algebraMap B (Localization.Away (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))))).comp
              (φ₂.comp c_nod)) ∧
      {v : PrimeSpectrum B |
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ v.asIdeal ∧
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ v.asIdeal}.Finite ∧
      (∀ v₀ : PrimeSpectrum B,
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ v₀.asIdeal →
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ v₀.asIdeal →
        ∃ v₁ : PrimeSpectrum B,
          v₁.asIdeal ≤ v₀.asIdeal ∧
          φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∉ v₁.asIdeal)) ∧
    (∀ (B : Type u) [CommRing B] (φ₂ : A_nod →+* B),
      φ₂.Etale →
      ∀ (q : Ideal B) [q.IsPrime],
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ q →
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ q →
        (let B_q := Localization.AtPrime q
         let 𝔓 : Fin 2 → Ideal B_q := fun i =>
           Ideal.span ({algebraMap B B_q (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)))} : Set B_q)
         (𝔓 0).IsPrime ∧ (𝔓 1).IsPrime ∧
         ¬ (𝔓 0 ≤ 𝔓 1) ∧ ¬ (𝔓 1 ≤ 𝔓 0) ∧
         (∀ Q : Ideal B_q, Q.IsPrime → 𝔓 0 ≤ Q ∨ 𝔓 1 ≤ Q) ∧
         (∀ (i : Fin 2) (Q : Ideal B_q),
           Q.IsPrime → 𝔓 i ≤ Q → Q = 𝔓 i ∨ Q = IsLocalRing.maximalIdeal B_q)) ∧
        (∀ i : Fin 2,
          ∃ ψ_q : Polynomial K' →+*
              (B ⧸ Ideal.span ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))} : Set B)),
            ψ_q.Etale ∧
            ψ_q.comp Polynomial.C = (Ideal.Quotient.mk _).comp (φ₂.comp c_nod))) :=
by
  dsimp only
  let I_nod : Ideal (MvPolynomial (Fin 2) K') :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) K'))
  let c_nod : K' →+* MvPolynomial (Fin 2) K' ⧸ I_nod :=
    (Ideal.Quotient.mk I_nod).comp MvPolynomial.C
  let u : Fin 2 → MvPolynomial (Fin 2) K' ⧸ I_nod :=
    fun i => Ideal.Quotient.mk I_nod (MvPolynomial.X i)
  have hu_mul : u 0 * u 1 = 0 := by
    change Ideal.Quotient.mk I_nod (MvPolynomial.X 0) * Ideal.Quotient.mk I_nod (MvPolynomial.X 1) = 0
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span rfl
  have hX_mon : ∀ i : Fin 2,
      (MvPolynomial.X i : MvPolynomial (Fin 2) K') = MvPolynomial.monomial (Finsupp.single i 1) 1 := by
    intro i
    simpa using (MvPolynomial.X_pow_eq_monomial (R := K') (σ := Fin 2) (e := 1) (n := i))
  let ev₀ : MvPolynomial (Fin 2) K' →+* Polynomial K' :=
    MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
  let ev₁ : MvPolynomial (Fin 2) K' →+* Polynomial K' :=
    MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0]
  have hev₀_ker : ∀ a ∈ I_nod, ev₀ a = 0 := by
    intro a ha
    rw [Ideal.mem_span_singleton] at ha
    rcases ha with ⟨q, rfl⟩
    simp [ev₀]
  have hev₁_ker : ∀ a ∈ I_nod, ev₁ a = 0 := by
    intro a ha
    rw [Ideal.mem_span_singleton] at ha
    rcases ha with ⟨q, rfl⟩
    simp [ev₁]
  let π₀ : MvPolynomial (Fin 2) K' ⧸ I_nod →+* Polynomial K' :=
    Ideal.Quotient.lift I_nod ev₀ hev₀_ker
  let π₁ : MvPolynomial (Fin 2) K' ⧸ I_nod →+* Polynomial K' :=
    Ideal.Quotient.lift I_nod ev₁ hev₁_ker
  let ε_mv : MvPolynomial (Fin 2) K' →+* K' := MvPolynomial.constantCoeff
  have hε_ker : ∀ a ∈ I_nod, ε_mv a = 0 := by
    intro a ha
    rw [Ideal.mem_span_singleton] at ha
    rcases ha with ⟨q, rfl⟩
    simp [ε_mv]
  let ε₀ : MvPolynomial (Fin 2) K' ⧸ I_nod →+* K' :=
    Ideal.Quotient.lift I_nod ε_mv hε_ker
  let 𝔪_nod : Ideal (MvPolynomial (Fin 2) K' ⧸ I_nod) :=
    Ideal.span ({u 0, u 1} : Set (MvPolynomial (Fin 2) K' ⧸ I_nod))
  have hε₀_surj : Function.Surjective ε₀ := by
    intro c
    refine ⟨c_nod c, ?_⟩
    simp [ε₀, ε_mv, c_nod]
  have hε₀_ker_eq : RingHom.ker ε₀ = 𝔪_nod := by
    apply le_antisymm
    · intro a ha
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
      have hP0 : P.coeff 0 = 0 := by
        have h1 : ε_mv P = 0 := ha
        simpa [ε_mv, MvPolynomial.constantCoeff_eq] using h1
      rw [MvPolynomial.as_sum P, map_sum]
      refine Submodule.sum_mem 𝔪_nod fun d hd => ?_
      have hd_ne : P.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
      have hd_zero_ne : d ≠ 0 := by
        intro h0
        exact hd_ne (h0 ▸ hP0)
      have hd_pos : d 0 ≠ 0 ∨ d 1 ≠ 0 := by
        by_contra h_both
        push Not at h_both
        apply hd_zero_ne
        ext j
        exact (Fin.forall_fin_two (p := fun j => d j = 0)).mpr ⟨h_both.1, h_both.2⟩ j
      rcases hd_pos with hd0 | hd1
      · let e0 : Fin 2 →₀ ℕ := Finsupp.single 0 1
        have he0_0 : e0 0 = 1 := by simp [e0]
        have he0_1 : e0 1 = 0 := by simp [e0]
        have h_add : e0 + (d - e0) = d := by
          ext j
          refine (Fin.forall_fin_two (p := fun j => (e0 + (d - e0)) j = d j)).mpr ⟨?_, ?_⟩ j
          · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he0_0]
            omega
          · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he0_1, zero_add, tsub_zero]
        have h_mon : MvPolynomial.monomial d (P.coeff d) =
            MvPolynomial.X 0 * MvPolynomial.monomial (d - e0) (P.coeff d) := by
          rw [hX_mon 0, MvPolynomial.monomial_mul_monomial, one_mul]
          exact congrArg (fun s => MvPolynomial.monomial s (P.coeff d)) h_add.symm
        rw [h_mon, map_mul]
        exact Ideal.mul_mem_right _ 𝔪_nod (Ideal.subset_span (by simp [u]))
      · let e1 : Fin 2 →₀ ℕ := Finsupp.single 1 1
        have he1_0 : e1 0 = 0 := by simp [e1]
        have he1_1 : e1 1 = 1 := by simp [e1]
        have h_add : e1 + (d - e1) = d := by
          ext j
          refine (Fin.forall_fin_two (p := fun j => (e1 + (d - e1)) j = d j)).mpr ⟨?_, ?_⟩ j
          · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he1_0, zero_add, tsub_zero]
          · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he1_1]
            omega
        have h_mon : MvPolynomial.monomial d (P.coeff d) =
            MvPolynomial.X 1 * MvPolynomial.monomial (d - e1) (P.coeff d) := by
          rw [hX_mon 1, MvPolynomial.monomial_mul_monomial, one_mul]
          exact congrArg (fun s => MvPolynomial.monomial s (P.coeff d)) h_add.symm
        rw [h_mon, map_mul]
        exact Ideal.mul_mem_right _ 𝔪_nod (Ideal.subset_span (by simp [u]))
    · rw [Ideal.span_le]
      intro y hy
      rcases hy with rfl | rfl
      · simp [u, ε₀, ε_mv]
      · simp [u, ε₀, ε_mv]
  have hQuotEtale :
      ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
        (φ : A →+* B) (π : A →+* C),
        φ.Etale →
        Function.Surjective π →
        ∀ (J : Ideal B),
          Ideal.map φ (RingHom.ker π) = J →
          ∃ ψ : C →+* (B ⧸ J),
            ψ.Etale ∧ ∀ a : A, ψ (π a) = Ideal.Quotient.mk J (φ a) := by
    intro A B C _ _ _ φ π hφ hπ J hJ
    letI : Algebra A B := φ.toAlgebra
    haveI : Algebra.Etale A B := RingHom.etale_algebraMap.mp hφ
    let I_A : Ideal A := RingHom.ker π
    let e_C : (A ⧸ I_A) ≃+* C := RingHom.quotientKerEquivOfSurjective hπ
    haveI : Algebra.Etale (A ⧸ I_A) (TensorProduct A (A ⧸ I_A) B) :=
      Algebra.Etale.baseChange A B (A ⧸ I_A)
    have hJ_alg : Ideal.map (algebraMap A B) I_A = J := hJ
    let e_B : TensorProduct A (A ⧸ I_A) B ≃+* (B ⧸ J) :=
      ((Algebra.TensorProduct.comm A (A ⧸ I_A) B).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I_A).symm.toRingEquiv).trans
        (Ideal.quotEquivOfEq hJ_alg)
    let ψ : C →+* (B ⧸ J) :=
      e_B.toRingHom.comp
        ((algebraMap (A ⧸ I_A) (TensorProduct A (A ⧸ I_A) B)).comp e_C.symm.toRingHom)
    have hψ_et : ψ.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.of_bijective (f := e_C.symm.toRingHom) e_C.symm.bijective)
          (RingHom.etale_algebraMap.mpr inferInstance))
        (RingHom.Etale.of_bijective (f := e_B.toRingHom) e_B.bijective)
    refine ⟨ψ, hψ_et, fun a => ?_⟩
    have heC : e_C.symm (π a) = Ideal.Quotient.mk I_A a := by
      apply e_C.injective
      rw [e_C.apply_symm_apply]
      rfl
    change e_B (algebraMap (A ⧸ I_A) (TensorProduct A (A ⧸ I_A) B) (e_C.symm (π a))) =
      Ideal.Quotient.mk J (φ a)
    rw [heC]
    change Ideal.quotEquivOfEq hJ_alg
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I_A).symm
        ((1 : B) ⊗ₜ[A] Ideal.Quotient.mk I_A a)) = Ideal.Quotient.mk J (φ a)
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
    have hsmul : a • (1 : B) = φ a := by
      rw [Algebra.smul_def, mul_one]; rfl
    rw [hsmul]
    rfl
  have hPillar1 :
      (∀ (R B : Type u) [CommRing R] [IsNoetherianRing R] [_root_.IsReduced R]
        [CommRing B] [Algebra R B] [Algebra.Etale R B], _root_.IsReduced B) ∧
      IsNoetherianRing (MvPolynomial (Fin 2) K' ⧸ I_nod) ∧
      _root_.IsReduced (MvPolynomial (Fin 2) K' ⧸ I_nod) := by
    refine ⟨?_, inferInstance, ?_⟩
    · intro R B _ _ _ _ _ _
      let M : Type u := ↥(minimalPrimes R)
      have hFinM : Finite M := (minimalPrimes.finite_of_isNoetherianRing R).to_subtype
      let : Fintype M := Fintype.ofFinite M
      let : DecidableEq M := Classical.decEq M
      have : ∀ m : M, m.1.IsPrime := fun m => m.2.1.1
      let : ∀ m : M, IsDomain (R ⧸ m.1) := fun m => Ideal.Quotient.isDomain m.1
      let ι_R : R →ₗ[R] (∀ m : M, FractionRing (R ⧸ m.1)) :=
        LinearMap.pi (fun m : M => Algebra.linearMap R (FractionRing (R ⧸ m.1)))
      have hι_inj : Function.Injective ι_R := by
        rw [injective_iff_map_eq_zero]
        intro r hr
        have hr_nil : r ∈ nilradical R := by
          rw [nilradical_eq_sInf R, Ideal.mem_sInf]
          intro P hP
          obtain ⟨q, hq_min, hq_le⟩ := @Ideal.exists_minimalPrimes_le R _ ⊥ P hP bot_le
          have hq_M : q ∈ minimalPrimes R := hq_min
          have hm0 : algebraMap R (FractionRing (R ⧸ q)) r = 0 := congrFun hr ⟨q, hq_M⟩
          rw [IsScalarTower.algebraMap_apply R (R ⧸ q) (FractionRing (R ⧸ q)) r] at hm0
          have h_mk : Ideal.Quotient.mk q r = 0 :=
            (injective_iff_map_eq_zero _).mp
              (IsFractionRing.injective (R ⧸ q) (FractionRing (R ⧸ q))) _ hm0
          exact hq_le (Ideal.Quotient.eq_zero_iff_mem.mp h_mk)
        exact IsNilpotent.eq_zero (mem_nilradical.mp hr_nil)
      have : Module.Flat R B := Algebra.Smooth.flat R B
      have hlT_inj : Function.Injective (LinearMap.lTensor B ι_R) :=
        Module.Flat.lTensor_preserves_injective_linearMap ι_R hι_inj
      let j_B : B →+* (∀ m : M, TensorProduct R B (FractionRing (R ⧸ m.1))) :=
        RingHom.pi (fun m : M =>
          (Algebra.TensorProduct.includeLeft :
            B →ₐ[R] TensorProduct R B (FractionRing (R ⧸ m.1))).toRingHom)
      have hj_eq : ∀ b : B,
          j_B b = TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
            (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b)) := by
        intro b
        ext m
        simp [j_B, ι_R, TensorProduct.piRight]
      have hj_inj : Function.Injective j_B := by
        intro b₁ b₂ h
        have h1 : TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
            (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b₁)) =
          TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
            (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b₂)) := by
          rw [← hj_eq b₁, ← hj_eq b₂, h]
        exact (TensorProduct.rid R B).symm.injective
          (hlT_inj ((TensorProduct.piRight R R B _).injective h1))
      have : ∀ m : M, _root_.IsReduced (TensorProduct R B (FractionRing (R ⧸ m.1))) := by
        intro m
        have : Algebra.Etale (FractionRing (R ⧸ m.1))
            (TensorProduct R (FractionRing (R ⧸ m.1)) B) :=
          Algebra.Etale.baseChange R B (FractionRing (R ⧸ m.1))
        have : _root_.IsReduced (TensorProduct R (FractionRing (R ⧸ m.1)) B) :=
          Algebra.FormallyUnramified.isReduced_of_field (FractionRing (R ⧸ m.1)) _
        exact isReduced_of_injective
          (Algebra.TensorProduct.comm R B (FractionRing (R ⧸ m.1))).toRingEquiv
          (Algebra.TensorProduct.comm R B (FractionRing (R ⧸ m.1))).injective
      exact isReduced_of_injective j_B hj_inj
    · have hev₀_mon : ∀ (d : Fin 2 →₀ ℕ) (c : K'),
          ev₀ (MvPolynomial.monomial d c) =
            Polynomial.C c * ((0 : Polynomial K') ^ (d 0) * Polynomial.X ^ (d 1)) := by
        intro d c
        rw [MvPolynomial.eval₂Hom_monomial,
          Finsupp.prod_of_support_subset d (Finset.subset_univ d.support) _ (fun i _ => pow_zero _),
          Fin.prod_univ_two]
        simp
      have hev₁_mon : ∀ (d : Fin 2 →₀ ℕ) (c : K'),
          ev₁ (MvPolynomial.monomial d c) =
            Polynomial.C c * (Polynomial.X ^ (d 0) * (0 : Polynomial K') ^ (d 1)) := by
        intro d c
        rw [MvPolynomial.eval₂Hom_monomial,
          Finsupp.prod_of_support_subset d (Finset.subset_univ d.support) _ (fun i _ => pow_zero _),
          Fin.prod_univ_two]
        simp
      let π_prod : MvPolynomial (Fin 2) K' ⧸ I_nod →+* Polynomial K' × Polynomial K' :=
        RingHom.prod π₀ π₁
      have hπ_inj : Function.Injective π_prod := by
        rw [injective_iff_map_eq_zero]
        intro a ha
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
        have hev₀_P : ev₀ P = 0 := congrArg Prod.fst ha
        have hev₁_P : ev₁ P = 0 := congrArg Prod.snd ha
        rw [Ideal.Quotient.eq_zero_iff_mem]
        have h_supp : ∀ d ∈ P.support, d 0 ≠ 0 ∧ d 1 ≠ 0 := by
          intro d hd
          have hd_ne : P.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
          refine ⟨?_, ?_⟩
          · intro hd0
            have h0 : (ev₀ P).coeff (d 1) = 0 := by rw [hev₀_P, Polynomial.coeff_zero]
            rw [MvPolynomial.as_sum P, map_sum, Polynomial.finsetSum_coeff] at h0
            rw [Finset.sum_eq_single d] at h0
            · rw [hev₀_mon, hd0, pow_zero, one_mul, Polynomial.coeff_C_mul_X_pow] at h0
              simp at h0
              exact hd_ne h0
            · intro d' _ hd'_ne
              by_cases hd'0 : d' 0 = 0
              · have hd'1 : d' 1 ≠ d 1 := by
                  intro h1
                  apply hd'_ne
                  ext j
                  exact (Fin.forall_fin_two (p := fun j => d' j = d j)).mpr
                    ⟨hd'0.trans hd0.symm, h1⟩ j
                rw [hev₀_mon, hd'0, pow_zero, one_mul, Polynomial.coeff_C_mul_X_pow]
                exact ite_eq_right_iff.mpr fun h_eq => False.elim (hd'1 h_eq.symm)
              · rw [hev₀_mon, zero_pow hd'0, zero_mul, mul_zero, Polynomial.coeff_zero]
            · intro hd_abs; exact False.elim (hd_abs hd)
          · intro hd1
            have h0 : (ev₁ P).coeff (d 0) = 0 := by rw [hev₁_P, Polynomial.coeff_zero]
            rw [MvPolynomial.as_sum P, map_sum, Polynomial.finsetSum_coeff] at h0
            rw [Finset.sum_eq_single d] at h0
            · rw [hev₁_mon, hd1, pow_zero, mul_one, Polynomial.coeff_C_mul_X_pow] at h0
              simp at h0
              exact hd_ne h0
            · intro d' _ hd'_ne
              by_cases hd'1 : d' 1 = 0
              · have hd'0 : d' 0 ≠ d 0 := by
                  intro h1
                  apply hd'_ne
                  ext j
