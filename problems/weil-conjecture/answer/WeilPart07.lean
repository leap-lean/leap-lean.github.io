        rw [← hGen.def]
        exact closure_minimal (Set.singleton_subset_iff.mpr hη_cl_z) isClosed_closure
      have hz_sub_E : closure ({z} : Set ↥X) ⊆ E :=
        hE.2 isIrreducible_singleton.closure hE_sub_z
      have hz_in_cl_η : z ∈ closure ({η_E} : Set ↥X) := by
        rw [hGen.def]
        exact hz_sub_E (subset_closure (Set.mem_singleton z))
      let p₀ : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op W_X)) := PrimeSpectrum.comap φ₁ v₀
      let p₁ : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op W_X)) := PrimeSpectrum.comap φ₁ v₁
      have hp₀_η : hW_X.fromSpec.base p₀ = η_E := by
        rw [← h_ι_comap v₀, hv₀_η]
      have hp₁_z : hW_X.fromSpec.base p₁ = z := (h_ι_comap v₁).symm
      have _ : AlgebraicGeometry.IsOpenImmersion hW_X.fromSpec := hW_X.isOpenImmersion_fromSpec
      have hEmb : Topology.IsOpenEmbedding hW_X.fromSpec.base :=
