        _ = res₀_Y (h₀_Y ^ m₁) * res₀_Y a₁ := by rw [ha₁]
    obtain ⟨⟨a₂, ⟨_, n₂, rfl⟩⟩, ha₂⟩ :=
      @IsLocalization.surj _ _ (Submonoid.powers h₀_Y) ↑R₀₁_Y _ res₀_Y.toAlgebra hLoc_R01 j_Y'
