        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        change (MvPolynomial.aeval P₁.val) (MvPolynomial.X 0) = q_m (y_gen 0)
        rw [MvPolynomial.aeval_X, hy_gen 0]
