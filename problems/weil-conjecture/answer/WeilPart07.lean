      γ_div W_div t_div hCompat hLift F φ_VF N W tag B t_loc φ_cov hCov
  have ⟨hInjVF, _hSupW, hCov_aff, hCov_mono, ht_mem, ht_ratio, _hCov_tag, _hCov_div⟩ := hCov
  have hB_V : ∀ S : Finset (Fin (N + 1)), S.Nonempty → ∀ v : ↥V, φ_VF v ∈ B S := by
