by
  
  obtain ⟨_, hNorm_pkg, hFunc_pkg⟩ :=
    weil_strictlySemistable_isAffineNormal_and_funcField K m V hPkg
  have hIntC : AlgebraicGeometry.IsIntegral C_semi := hSS.1
  have hNormC : IsAffineNormalScheme C_semi := hNorm_pkg C_semi g_semi hSS
  obtain ⟨F, instFieldF, η_C, hFuncC⟩ := hFunc_pkg C_semi g_semi hSS
  letI : Field F := instFieldF
  have _ := hSurj
  
  obtain ⟨hAff_pkg, c_proj, t_proj, hCoord_pkg, hBase_pkg⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  have hAff_P1 : ∀ (S : Type u) [CommRing S] (a : Fin (1 + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen S 1 a) :=
    fun S _ a => hAff_pkg S 1 a
