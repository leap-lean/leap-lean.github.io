        rw [← map_smul, Prod.smul_mk, hvq, smul_zero, Prod.mk_zero_zero, map_zero]
      have hx0 : x = 0 := hFreeTorsFree _ v x hv hvx
      have hq0 : (q, (0 : R₀ ⧸ I_Y' ^ k)) = 0 := by
        calc
          (q, (0 : R₀ ⧸ I_Y' ^ k)) = e_prod x := (e_prod.apply_symm_apply (q, 0)).symm
          _ = 0 := by rw [hx0, map_zero]
      exact congrArg Prod.fst hq0
    have hFree_IZk : Module.Free ↥V (R₀ ⧸ I_Z ^ k) :=
      hVFreeOfFinTF (R₀ ⧸ I_Z ^ k) hTF_IZk
    by_cases hr : r = 0
    · subst hr
      have hJ0 : Ideal.span ({h₀ ^ 0} : Set R₀) * I_Z ^ k = I_Z ^ k := by
        ext x
        rw [hSpanMul]
        simp
      let e0_alg : (R₀ ⧸ (Ideal.span ({h₀ ^ 0} : Set R₀) * I_Z ^ k)) ≃ₐ[↥V] (R₀ ⧸ I_Z ^ k) :=
        { Ideal.quotEquivOfEq hJ0 with commutes' := fun _ => rfl }
      exact Module.Free.of_equiv e0_alg.symm.toLinearEquiv
    · have hr_pos : 1 ≤ r := Nat.one_le_iff_ne_zero.mpr hr
      let H_r : Ideal R₀ := Ideal.span ({h₀ ^ r} : Set R₀)
      let J : Ideal R₀ := H_r * I_Z ^ k
      have hJ_le_Hr : J ≤ H_r := Ideal.mul_le_left
      let p_alg : (R₀ ⧸ J) →ₐ[↥V] (R₀ ⧸ H_r) :=
        Ideal.Quotient.liftₐ J (Ideal.Quotient.mkₐ ↥V H_r)
          (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr (hJ_le_Hr ha))
      let p : (R₀ ⧸ J) →ₗ[↥V] (R₀ ⧸ H_r) := p_alg.toLinearMap
      have hp_surj : Function.Surjective p := by
        intro q
        induction q using Quotient.inductionOn' with
        | h x => exact ⟨Ideal.Quotient.mk J x, rfl⟩
      let μ₀ : R₀ →ₗ[↥V] (R₀ ⧸ J) :=
        { toFun := fun z => Ideal.Quotient.mk J (h₀ ^ r * z)
          map_add' := fun z₁ z₂ => by rw [mul_add, map_add]
          map_smul' := fun v z => by
            simp only [RingHom.id_apply]
            change Ideal.Quotient.mk J (h₀ ^ r * (v • z)) = v • Ideal.Quotient.mk J (h₀ ^ r * z)
            rw [mul_smul_comm]
            rfl }
      let μ : (R₀ ⧸ I_Z ^ k) →ₗ[↥V] (R₀ ⧸ J) :=
        Submodule.liftQ ((I_Z ^ k).restrictScalars ↥V) μ₀
          (fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr
            ((hSpanMul (h₀ ^ r) (I_Z ^ k) (h₀ ^ r * z)).mpr ⟨z, hz, rfl⟩))
      have hFree_Hr : Module.Free ↥V (R₀ ⧸ H_r) := (hQuot₀ r hr_pos).1
      have hFin_Hr : Module.Finite ↥V (R₀ ⧸ H_r) := (hQuot₀ r hr_pos).2.1
      have hMap_p_fg : (Submodule.map p ⊤).FG := by
        have htop : Submodule.map p ⊤ = ⊤ := by
          ext q
          simp only [Submodule.mem_map, Submodule.mem_top, true_and, iff_true]
          exact hp_surj q
        rw [htop]
        exact (hFinIffFG (R₀ ⧸ H_r)).mp hFin_Hr
      have hKer_p_eq : (⊤ : Submodule ↥V (R₀ ⧸ J)) ⊓ LinearMap.ker p = Submodule.map μ ⊤ := by
        ext q
        simp only [Submodule.mem_inf, Submodule.mem_top, true_and, LinearMap.mem_ker,
          Submodule.mem_map]
        induction q using Quotient.inductionOn' with
        | h x =>
          change p (Ideal.Quotient.mk J x) = 0 ↔ ∃ q' : R₀ ⧸ I_Z ^ k, μ q' = Ideal.Quotient.mk J x
          constructor
          · intro hx
            have hx_mem : x ∈ H_r := Ideal.Quotient.eq_zero_iff_mem.mp hx
            rcases Ideal.mem_span_singleton.mp hx_mem with ⟨z, rfl⟩
            exact ⟨Ideal.Quotient.mk (I_Z ^ k) z, rfl⟩
          · rintro ⟨q', hq'⟩
            induction q' using Quotient.inductionOn' with
            | h z =>
              have hμz : Ideal.Quotient.mk J (h₀ ^ r * z) = Ideal.Quotient.mk J x := hq'
              rw [← hμz]
              change Ideal.Quotient.mk H_r (h₀ ^ r * z) = 0
              exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨z, rfl⟩)
      have hKer_p_fg : ((⊤ : Submodule ↥V (R₀ ⧸ J)) ⊓ LinearMap.ker p).FG := by
        rw [hKer_p_eq]
        exact Submodule.FG.map μ ((hFinIffFG (R₀ ⧸ I_Z ^ k)).mp hFin_IZk)
      have hFin_J : Module.Finite ↥V (R₀ ⧸ J) :=
        (hFinIffFG (R₀ ⧸ J)).mpr (Submodule.fg_of_fg_map_of_fg_inf_ker p hMap_p_fg hKer_p_fg)
      have hTF_J : ∀ (v : ↥V) (q : R₀ ⧸ J), v ≠ 0 → v • q = 0 → q = 0 := by
        intro v q hv hvq
        induction q using Quotient.inductionOn' with
        | h x =>
          change Ideal.Quotient.mk J x = 0
          have hvx_J : v • x ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp hvq
          rcases (hSpanMul (h₀ ^ r) (I_Z ^ k) (v • x)).mp hvx_J with ⟨y, hy_mem, hvy_eq⟩
          have hvx_Hr : v • Ideal.Quotient.mk H_r x = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (hJ_le_Hr hvx_J)
          have hx_Hr0 : Ideal.Quotient.mk H_r x = 0 :=
            hFreeTorsFree (R₀ ⧸ H_r) v (Ideal.Quotient.mk H_r x) hv hvx_Hr
          rcases Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hx_Hr0) with ⟨z, rfl⟩
          have hhr_ne : h₀ ^ r ≠ 0 := pow_ne_zero r hh₀_ne
          have hvz_eq_y : v • z = y := by
            apply mul_left_cancel₀ hhr_ne
            rw [mul_smul_comm, hvy_eq]
          have hvz_IZ : v • Ideal.Quotient.mk (I_Z ^ k) z = 0 := by
            change Ideal.Quotient.mk (I_Z ^ k) (v • z) = 0
            rw [hvz_eq_y]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr hy_mem
          have hz_IZ0 : Ideal.Quotient.mk (I_Z ^ k) z = 0 :=
            hFreeTorsFree (R₀ ⧸ I_Z ^ k) v (Ideal.Quotient.mk (I_Z ^ k) z) hv hvz_IZ
          have hz_mem : z ∈ I_Z ^ k := Ideal.Quotient.eq_zero_iff_mem.mp hz_IZ0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr
            ((hSpanMul (h₀ ^ r) (I_Z ^ k) (h₀ ^ r * z)).mpr ⟨z, hz_mem, rfl⟩)
      exact hVFreeOfFinTF (R₀ ⧸ J) hTF_J
  have hSingleScalar : ∀ {A : Type u} [CommRing A] [Algebra ↥V A] (a : A),
      a ∈ Ideal.map (algebraMap ↥V A) (IsLocalRing.maximalIdeal ↥V) →
      ∃ m ∈ IsLocalRing.maximalIdeal ↥V, ∃ y : A, a = m • y := by
    intro A _ _ a ha
    refine Submodule.span_induction
      (fun x hx => ?_)
      ⟨0, (IsLocalRing.maximalIdeal ↥V).zero_mem, 0, by simp⟩
      (fun x₁ x₂ _ _ hx₁ hx₂ => ?_)
      (fun r x _ hx => ?_)
      ha
    · rcases hx with ⟨m, hm, rfl⟩
      exact ⟨m, hm, 1, by rw [Algebra.smul_def, mul_one]⟩
    · rcases hx₁ with ⟨m₁, hm₁, y₁, rfl⟩
      rcases hx₂ with ⟨m₂, hm₂, y₂, rfl⟩
      rcases ValuationRing.dvd_total m₁ m₂ with ⟨u, rfl⟩ | ⟨u, rfl⟩
      · exact ⟨m₁, hm₁, y₁ + u • y₂, by rw [smul_add, mul_smul]⟩
      · exact ⟨m₂, hm₂, u • y₁ + y₂, by rw [smul_add, mul_smul]⟩
    · rcases hx with ⟨m, hm, y, rfl⟩
      exact ⟨m, hm, r * y, by rw [smul_eq_mul, mul_smul_comm]⟩
  have hht_pow : ∀ m : ℕ, res₀ (h₀ ^ m) * res₁ (t₀ ^ m) = 1 := by
    intro m
    rw [map_pow, map_pow, ← mul_pow, hht, one_pow]
  have hComm₀_app : ∀ x : R₀, res₀_Y (π₀ x) = π₀₁ (res₀ x) :=
    fun x => RingHom.congr_fun hComm₀ x
  have hComm₁_app : ∀ x : R₁, res₁_Y (π₁ x) = π₀₁ (res₁ x) :=
    fun x => RingHom.congr_fun hComm₁ x
  have hMap_IZ : ∀ k : ℕ, Ideal.map π₀ (I_Z ^ k) = I_Z_Y ^ k := by
    intro k
    dsimp [I_Z, I_Z_Y]
    rw [Ideal.map_pow, Ideal.map_span, Set.image_pair]
  refine ⟨hColon, ?_, ?_⟩
  · intro k₁ k₂ x₁ x₂ ⟨y₁, hy₁_mem, hy₁_eq⟩ ⟨y₂, hy₂_mem, hy₂_eq⟩
    refine ⟨y₁ * y₂, ?_, ?_⟩
    · rw [pow_add]
      exact Ideal.mul_mem_mul hy₁_mem hy₂_mem
    · rw [map_mul, map_mul, pow_add, map_mul, hy₁_eq, hy₂_eq]
      ring
  · intro k hk hSurj_Y
    let I : Ideal R₀ := I_Z ^ k
    have hh₀_mem : h₀ ^ k ∈ I := Ideal.pow_mem_pow (Ideal.subset_span (by simp)) k
    let φ : ℕ → (R₀ →ₗ[↥V] R₀₁) := fun m =>
      { toFun := fun x₀ => res₁ (t₀ ^ m) * res₀ x₀
        map_add' := fun x y => by rw [map_add, mul_add]
        map_smul' := fun v x => by simp only [_root_.map_smul, mul_smul_comm, RingHom.id_apply] }
    let M_I : Submodule ↥V R₀₁ := Submodule.map (φ k) (I.restrictScalars ↥V)
    let S_I : Submodule ↥V R₀₁ := M_I ⊔ LinearMap.range res₁.toLinearMap
    have hSurj_V : ∀ z : R₀₁, ∃ x₀ ∈ I_Z ^ k, ∃ x₁ : R₁, res₁ (t₀ ^ k) * res₀ x₀ - res₁ x₁ = z := by
      have hRange₀_le : LinearMap.range res₀.toLinearMap ≤ S_I := by
        rintro z ⟨x, rfl⟩
        apply Submodule.mem_sup_left
        refine ⟨h₀ ^ k * x, I.mul_mem_right x hh₀_mem, ?_⟩
        change res₁ (t₀ ^ k) * res₀ (h₀ ^ k * x) = res₀ x
        rw [map_mul, ← mul_assoc, mul_comm (res₁ (t₀ ^ k)) (res₀ (h₀ ^ k)), hht_pow k, one_mul]
      have hRange₁_le : LinearMap.range res₁.toLinearMap ≤ S_I := le_sup_right
      have hQ_fg : (⊤ : Submodule ↥V (R₀₁ ⧸ S_I)).FG := hH1_fg S_I hRange₀_le hRange₁_le
      let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
      have hQ_smul : (⊤ : Submodule ↥V (R₀₁ ⧸ S_I)) ≤ 𝔪_V • ⊤ := by
        intro q _
        induction q using Submodule.Quotient.induction_on with
        | H z =>
          obtain ⟨x₀_Y, hx₀_Y_mem, x₁_Y, hz_Y⟩ := hSurj_Y (π₀₁ z)
          rw [← hMap_IZ k] at hx₀_Y_mem
          obtain ⟨x₀, hx₀_mem, rfl⟩ := (Ideal.mem_map_iff_of_surjective π₀ hSurj₀).mp hx₀_Y_mem
          obtain ⟨x₁, rfl⟩ := hSurj₁ x₁_Y
          let u : R₀₁ := φ k x₀ - res₁ x₁
          have hu_mem : u ∈ S_I :=
            S_I.sub_mem (Submodule.mem_sup_left ⟨x₀, hx₀_mem, rfl⟩)
              (Submodule.mem_sup_right ⟨x₁, rfl⟩)
          have hker_zu : z - u ∈ RingHom.ker π₀₁ := by
            rw [RingHom.mem_ker, map_sub, sub_eq_zero]
            dsimp [u, φ]
            rw [map_sub, map_mul, ← hComm₁_app (t₀ ^ k), ← hComm₀_app x₀, ← hComm₁_app x₁,
              map_pow]
            exact hz_Y.symm
          rw [hKer₀₁] at hker_zu
          obtain ⟨m, hm, y, hzy⟩ := hSingleScalar (z - u) hker_zu
          have hmk_eq : Submodule.Quotient.mk z = m • (Submodule.Quotient.mk y : R₀₁ ⧸ S_I) := by
            have h1 : (Submodule.Quotient.mk u : R₀₁ ⧸ S_I) = 0 :=
              (Submodule.Quotient.mk_eq_zero S_I).mpr hu_mem
            calc
              (Submodule.Quotient.mk z : R₀₁ ⧸ S_I)
                  = Submodule.Quotient.mk (z - u + u) := by rw [sub_add_cancel]
              _ = Submodule.Quotient.mk (z - u) + Submodule.Quotient.mk u := rfl
              _ = Submodule.Quotient.mk (m • y) + 0 := by rw [hzy, h1]
              _ = m • Submodule.Quotient.mk y := by rw [add_zero]; rfl
          rw [hmk_eq]
          exact Submodule.smul_mem_smul hm Submodule.mem_top
      have hQ_bot : (⊤ : Submodule ↥V (R₀₁ ⧸ S_I)) = ⊥ :=
        Submodule.eq_bot_of_le_smul_of_le_jacobson_bot 𝔪_V ⊤ hQ_fg hQ_smul
          (IsLocalRing.maximalIdeal_le_jacobson ⊥)
      intro z
      have hz_bot : (Submodule.Quotient.mk z : R₀₁ ⧸ S_I) ∈ (⊥ : Submodule ↥V (R₀₁ ⧸ S_I)) := by
        rw [← hQ_bot]; exact Submodule.mem_top
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero] at hz_bot
      rcases Submodule.mem_sup.mp hz_bot with ⟨u₀, ⟨x₀, hx₀_mem, rfl⟩, u₁, ⟨y₁, rfl⟩, hsum⟩
      refine ⟨x₀, hx₀_mem, -y₁, ?_⟩
      change φ k x₀ - res₁ (-y₁) = z
      rw [map_neg, sub_neg_eq_add]
      exact hsum
    let H₀_k : Submodule ↥V R₁ := Submodule.comap res₁.toLinearMap M_I
    have hH₀_mem : ∀ x₁ : R₁, x₁ ∈ H₀_k ↔ ∃ x₀ ∈ I_Z ^ k, res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁ := by
      intro x₁
      simp only [H₀_k, M_I, Submodule.mem_comap, Submodule.mem_map, Submodule.restrictScalars_mem]
      constructor
      · rintro ⟨x₀, hx₀_mem, hx₀_eq⟩
        refine ⟨x₀, hx₀_mem, ?_⟩
        change res₁ (t₀ ^ k) * res₀ x₀ = res₁ x₁ at hx₀_eq
        calc
          res₀ x₀ = (res₀ (h₀ ^ k) * res₁ (t₀ ^ k)) * res₀ x₀ := by rw [hht_pow k, one_mul]
          _ = res₀ (h₀ ^ k) * (res₁ (t₀ ^ k) * res₀ x₀) := by ring
          _ = res₀ (h₀ ^ k) * res₁ x₁ := by rw [hx₀_eq]
      · rintro ⟨x₀, hx₀_mem, hx₀_eq⟩
        refine ⟨x₀, hx₀_mem, ?_⟩
        change res₁ (t₀ ^ k) * res₀ x₀ = res₁ x₁
        calc
          res₁ (t₀ ^ k) * res₀ x₀ = res₁ (t₀ ^ k) * (res₀ (h₀ ^ k) * res₁ x₁) := by rw [hx₀_eq]
          _ = (res₀ (h₀ ^ k) * res₁ (t₀ ^ k)) * res₁ x₁ := by ring
          _ = res₁ x₁ := by rw [hht_pow k, one_mul]
    have hFree_I0 : Module.Free ↥V (R₀ ⧸ I) := by
      have h0 := hFree_IZ 0 k hk
      have hJ0 : Ideal.span ({h₀ ^ 0} : Set R₀) * I = I := by
        ext x
        rw [hSpanMul]
        simp
      let e0_alg : (R₀ ⧸ (Ideal.span ({h₀ ^ 0} : Set R₀) * I)) ≃ₐ[↥V] (R₀ ⧸ I) :=
        { Ideal.quotEquivOfEq hJ0 with commutes' := fun _ => rfl }
      exact Module.Free.of_equiv e0_alg.toLinearEquiv
    have hH₀_sat : ∀ (v : ↥V) (x₁ : R₁), v ≠ 0 → v • x₁ ∈ H₀_k → x₁ ∈ H₀_k := by
      intro v x₁ hv hvx₁
      obtain ⟨x₀, hx₀_mem, hx₀_eq⟩ := (hH₀_mem (v • x₁)).mp hvx₁
      let s := @IsLocalization.Away.sec R₀ _ R₀₁ _ res₀.toRingHom.toAlgebra h₀ hLoc₀ (res₁ x₁)
      have hs_spec : res₁ x₁ * res₀ (h₀ ^ s.2) = res₀ s.1 :=
        @IsLocalization.Away.sec_spec R₀ _ R₀₁ _ res₀.toRingHom.toAlgebra h₀ hLoc₀ (res₁ x₁)
      let y₀ : R₀ := h₀ ^ k * s.1
      have hy₀_res : res₀ y₀ = res₀ (h₀ ^ s.2) * (res₀ (h₀ ^ k) * res₁ x₁) := by
        dsimp [y₀]
        rw [map_mul, ← hs_spec]
        ring
      have hvy₀_eq : v • y₀ = h₀ ^ s.2 * x₀ := by
        apply hInj₀
        rw [_root_.map_smul, hy₀_res, map_mul, hx₀_eq, _root_.map_smul, mul_smul_comm,
          mul_smul_comm]
      by_cases hn : s.2 = 0
      · have hvy₀_I : v • Ideal.Quotient.mk I y₀ = 0 := by
          change Ideal.Quotient.mk I (v • y₀) = 0
          rw [hvy₀_eq, hn, pow_zero, one_mul]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hx₀_mem
        have hy₀_I0 : Ideal.Quotient.mk I y₀ = 0 :=
          hFreeTorsFree (R₀ ⧸ I) v (Ideal.Quotient.mk I y₀) hv hvy₀_I
        have hy₀_mem : y₀ ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp hy₀_I0
        rw [hH₀_mem]
        refine ⟨y₀, hy₀_mem, ?_⟩
        rw [hy₀_res, hn, pow_zero, map_one, one_mul]
      · have hn_pos : 1 ≤ s.2 := Nat.one_le_iff_ne_zero.mpr hn
        let H_n : Ideal R₀ := Ideal.span ({h₀ ^ s.2} : Set R₀)
        have hFree_Hn : Module.Free ↥V (R₀ ⧸ H_n) := (hQuot₀ s.2 hn_pos).1
        have hvy₀_Hn : v • Ideal.Quotient.mk H_n y₀ = 0 := by
          change Ideal.Quotient.mk H_n (v • y₀) = 0
          rw [hvy₀_eq]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨x₀, rfl⟩)
        have hy₀_Hn0 : Ideal.Quotient.mk H_n y₀ = 0 :=
          hFreeTorsFree (R₀ ⧸ H_n) v (Ideal.Quotient.mk H_n y₀) hv hvy₀_Hn
        rcases Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hy₀_Hn0) with
          ⟨x_tilde, hy₀_fac⟩
        have hhn_ne : h₀ ^ s.2 ≠ 0 := pow_ne_zero s.2 hh₀_ne
        have hvx_tilde_eq : v • x_tilde = x₀ := by
          apply mul_left_cancel₀ hhn_ne
          rw [mul_smul_comm, ← hy₀_fac, hvy₀_eq]
        have hvx_tilde_I : v • Ideal.Quotient.mk I x_tilde = 0 := by
          change Ideal.Quotient.mk I (v • x_tilde) = 0
          rw [hvx_tilde_eq]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hx₀_mem
        have hx_tilde_I0 : Ideal.Quotient.mk I x_tilde = 0 :=
          hFreeTorsFree (R₀ ⧸ I) v (Ideal.Quotient.mk I x_tilde) hv hvx_tilde_I
        have hx_tilde_mem : x_tilde ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp hx_tilde_I0
        rw [hH₀_mem]
        refine ⟨x_tilde, hx_tilde_mem, ?_⟩
        have hmul_eq :
            res₀ (h₀ ^ s.2) * res₀ x_tilde = res₀ (h₀ ^ s.2) * (res₀ (h₀ ^ k) * res₁ x₁) := by
          rw [← map_mul, ← hy₀_fac, hy₀_res]
        calc
          res₀ x_tilde = (res₀ (h₀ ^ s.2) * res₁ (t₀ ^ s.2)) * res₀ x_tilde := by
            rw [hht_pow s.2, one_mul]
          _ = res₁ (t₀ ^ s.2) * (res₀ (h₀ ^ s.2) * res₀ x_tilde) := by ring
          _ = res₁ (t₀ ^ s.2) * (res₀ (h₀ ^ s.2) * (res₀ (h₀ ^ k) * res₁ x₁)) := by rw [hmul_eq]
          _ = (res₀ (h₀ ^ s.2) * res₁ (t₀ ^ s.2)) * (res₀ (h₀ ^ k) * res₁ x₁) := by ring
          _ = res₀ (h₀ ^ k) * res₁ x₁ := by rw [hht_pow s.2, one_mul]
    have hH₀_fg : H₀_k.FG := by
      let B : ℕ := max A₀ k
      have hA₀_le_B : A₀ ≤ B := le_max_left A₀ k
      have hk_le_B : k ≤ B := le_max_right A₀ k
      let W_B : Submodule ↥V R₁ := Submodule.comap res₁.toLinearMap (LinearMap.range (φ B))
      have hWB_mem : ∀ w₁ : R₁, w₁ ∈ W_B ↔ ∃ x₀ : R₀, res₀ x₀ = res₀ (h₀ ^ B) * res₁ w₁ := by
        intro w₁
        simp only [W_B, Submodule.mem_comap, LinearMap.mem_range]
        constructor
        · rintro ⟨x₀, hx₀⟩
          refine ⟨x₀, ?_⟩
          change res₁ (t₀ ^ B) * res₀ x₀ = res₁ w₁ at hx₀
          calc
            res₀ x₀ = (res₀ (h₀ ^ B) * res₁ (t₀ ^ B)) * res₀ x₀ := by rw [hht_pow B, one_mul]
            _ = res₀ (h₀ ^ B) * (res₁ (t₀ ^ B) * res₀ x₀) := by ring
            _ = res₀ (h₀ ^ B) * res₁ w₁ := by rw [hx₀]
        · rintro ⟨x₀, hx₀⟩
          refine ⟨x₀, ?_⟩
          change res₁ (t₀ ^ B) * res₀ x₀ = res₁ w₁
          calc
            res₁ (t₀ ^ B) * res₀ x₀ = res₁ (t₀ ^ B) * (res₀ (h₀ ^ B) * res₁ w₁) := by rw [hx₀]
            _ = (res₀ (h₀ ^ B) * res₁ (t₀ ^ B)) * res₁ w₁ := by ring
            _ = res₁ w₁ := by rw [hht_pow B, one_mul]
      let ν_fun : ↥W_B → R₀ := fun w => Classical.choose ((hWB_mem w.1).mp w.2)
      have hν_spec : ∀ w : ↥W_B, res₀ (ν_fun w) = res₀ (h₀ ^ B) * res₁ w.1 :=
        fun w => Classical.choose_spec ((hWB_mem w.1).mp w.2)
      let ν_B : ↥W_B →ₗ[↥V] R₀ :=
        { toFun := ν_fun
          map_add' := fun w₁ w₂ => hInj₀ (by
            rw [hν_spec (w₁ + w₂), map_add, hν_spec w₁, hν_spec w₂]
            change res₀ (h₀ ^ B) * res₁ (w₁.1 + w₂.1) = _
            rw [map_add, mul_add])
          map_smul' := fun v w => hInj₀ (by
            simp only [RingHom.id_apply]
            rw [hν_spec (v • w), _root_.map_smul, hν_spec w]
            change res₀ (h₀ ^ B) * res₁ (v • w.1) = _
            rw [_root_.map_smul, mul_smul_comm]) }
      have hνB_spec : ∀ w : ↥W_B, res₀ (ν_B w) = res₀ (h₀ ^ B) * res₁ w.1 := hν_spec
      let H_BA : Ideal R₀ := Ideal.span ({h₀ ^ (B - A₀)} : Set R₀)
      let Q₁ := R₀ ⧸ H_BA
      let θ₁ : ↥W_B →ₗ[↥V] Q₁ := (Ideal.Quotient.mkₐ ↥V H_BA).toLinearMap.comp ν_B
      have hθ₁_surj : Function.Surjective θ₁ := by
        intro q
        induction q using Quotient.inductionOn' with
        | h a =>
          obtain ⟨u₀, u₁, hu⟩ := hA₀_surj (res₁ (t₀ ^ B) * res₀ a)
          have hw₁_eq : res₀ (a - h₀ ^ (B - A₀) * u₀) = res₀ (h₀ ^ B) * res₁ (-u₁) := by
            have hB_split : h₀ ^ B = h₀ ^ (B - A₀) * h₀ ^ A₀ := by
              rw [← pow_add, Nat.sub_add_cancel hA₀_le_B]
            have hneg : res₁ (-u₁) = res₁ (t₀ ^ B) * res₀ a - res₁ (t₀ ^ A₀) * res₀ u₀ := by
              rw [map_neg, ← hu]; ring
            rw [hneg, mul_sub, ← mul_assoc, hht_pow B, one_mul, hB_split, map_mul, map_sub,
              map_mul]
            have hcancel : (res₀ (h₀ ^ (B - A₀)) * res₀ (h₀ ^ A₀)) * (res₁ (t₀ ^ A₀) * res₀ u₀) =
                res₀ (h₀ ^ (B - A₀)) * res₀ u₀ := by
              calc
                (res₀ (h₀ ^ (B - A₀)) * res₀ (h₀ ^ A₀)) * (res₁ (t₀ ^ A₀) * res₀ u₀)
                    = res₀ (h₀ ^ (B - A₀)) * ((res₀ (h₀ ^ A₀) * res₁ (t₀ ^ A₀)) * res₀ u₀) := by ring
                _ = res₀ (h₀ ^ (B - A₀)) * res₀ u₀ := by rw [hht_pow A₀, one_mul]
            rw [hcancel]
          have hw₁_mem : -u₁ ∈ W_B := (hWB_mem (-u₁)).mpr ⟨a - h₀ ^ (B - A₀) * u₀, hw₁_eq⟩
          let w : ↥W_B := ⟨-u₁, hw₁_mem⟩
          have hν_w : ν_B w = a - h₀ ^ (B - A₀) * u₀ :=
            hInj₀ ((hν_spec w).trans hw₁_eq.symm)
          refine ⟨w, ?_⟩
          change Ideal.Quotient.mk H_BA (ν_B w) = Ideal.Quotient.mk H_BA a
          rw [hν_w, map_sub]
          have hzero : Ideal.Quotient.mk H_BA (h₀ ^ (B - A₀) * u₀) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨u₀, rfl⟩)
          rw [hzero, sub_zero]
      have hMap_θ₁_fg : (Submodule.map θ₁ ⊤).FG := by
        have htop : Submodule.map θ₁ ⊤ = ⊤ := by
          ext q
          simp only [Submodule.mem_map, Submodule.mem_top, true_and, iff_true]
          exact hθ₁_surj q
        rw [htop]
        by_cases hBA : B - A₀ = 0
        · have hHBA_top : H_BA = ⊤ := by
            dsimp [H_BA]; rw [hBA, pow_zero, Ideal.span_singleton_one]
          have hQ₁_bot : (⊤ : Submodule ↥V Q₁) = ⊥ := by
            rw [eq_bot_iff]
            intro q _
            rw [Submodule.mem_bot]
            induction q using Quotient.inductionOn' with
            | h r =>
              exact Ideal.Quotient.eq_zero_iff_mem.mpr (by rw [hHBA_top]; trivial)
          rw [hQ₁_bot]
          exact Submodule.fg_bot
        · have hBA_pos : 1 ≤ B - A₀ := Nat.one_le_iff_ne_zero.mpr hBA
          exact (hFinIffFG Q₁).mp (hQuot₀ (B - A₀) hBA_pos).2.1
      have hKer_θ₁_map : Submodule.map W_B.subtype (⊤ ⊓ LinearMap.ker θ₁) = W := by
        ext x₁
        simp only [Submodule.mem_map, Submodule.mem_inf, Submodule.mem_top, true_and,
          LinearMap.mem_ker, Submodule.subtype_apply]
        have hB_split : h₀ ^ B = h₀ ^ (B - A₀) * h₀ ^ A₀ := by
          rw [← pow_add, Nat.sub_add_cancel hA₀_le_B]
        constructor
        · rintro ⟨w, hw_ker, rfl⟩
          have hν_mem : ν_B w ∈ H_BA := Ideal.Quotient.eq_zero_iff_mem.mp hw_ker
          rcases Ideal.mem_span_singleton.mp hν_mem with ⟨y₀, hy₀_eq⟩
          rw [hW_mem]
          refine ⟨y₀, ?_⟩
          have hmul_eq : res₀ (h₀ ^ (B - A₀)) * res₀ y₀ =
              res₀ (h₀ ^ (B - A₀)) * (res₀ (h₀ ^ A₀) * res₁ w.1) := by
            rw [← map_mul, ← hy₀_eq, hνB_spec w, hB_split, map_mul, mul_assoc]
          calc
            res₀ y₀ = (res₀ (h₀ ^ (B - A₀)) * res₁ (t₀ ^ (B - A₀))) * res₀ y₀ := by
              rw [hht_pow (B - A₀), one_mul]
            _ = res₁ (t₀ ^ (B - A₀)) * (res₀ (h₀ ^ (B - A₀)) * res₀ y₀) := by ring
            _ = res₁ (t₀ ^ (B - A₀)) * (res₀ (h₀ ^ (B - A₀)) * (res₀ (h₀ ^ A₀) * res₁ w.1)) := by
              rw [hmul_eq]
            _ = (res₀ (h₀ ^ (B - A₀)) * res₁ (t₀ ^ (B - A₀))) * (res₀ (h₀ ^ A₀) * res₁ w.1) := by
              ring
            _ = res₀ (h₀ ^ A₀) * res₁ w.1 := by rw [hht_pow (B - A₀), one_mul]
        · intro hx₁
          obtain ⟨y₀, hy₀_eq⟩ := (hW_mem x₁).mp hx₁
          have hx₁_B : res₀ (h₀ ^ (B - A₀) * y₀) = res₀ (h₀ ^ B) * res₁ x₁ := by
            rw [map_mul, hy₀_eq, hB_split, map_mul, mul_assoc]
          have hx₁_WB : x₁ ∈ W_B := (hWB_mem x₁).mpr ⟨h₀ ^ (B - A₀) * y₀, hx₁_B⟩
          let w : ↥W_B := ⟨x₁, hx₁_WB⟩
          have hν_w : ν_B w = h₀ ^ (B - A₀) * y₀ := hInj₀ ((hν_spec w).trans hx₁_B.symm)
          refine ⟨w, ?_, rfl⟩
          change Ideal.Quotient.mk H_BA (ν_B w) = 0
          rw [hν_w]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨y₀, rfl⟩)
      have hKer_θ₁_fg : ((⊤ : Submodule ↥V ↥W_B) ⊓ LinearMap.ker θ₁).FG := by
        apply (Submodule.fg_map_iff W_B.subtype Subtype.val_injective).mp
        rwa [hKer_θ₁_map]
      have hWB_fg : (⊤ : Submodule ↥V ↥W_B).FG :=
        Submodule.fg_of_fg_map_of_fg_inf_ker θ₁ hMap_θ₁_fg hKer_θ₁_fg
      let J_Bk : Ideal R₀ := Ideal.span ({h₀ ^ (B - k)} : Set R₀) * I
      let Q₂ := R₀ ⧸ J_Bk
      let θ₂ : ↥W_B →ₗ[↥V] Q₂ := (Ideal.Quotient.mkₐ ↥V J_Bk).toLinearMap.comp ν_B
      have hB_split_k : h₀ ^ B = h₀ ^ (B - k) * h₀ ^ k := by
        rw [← pow_add, Nat.sub_add_cancel hk_le_B]
      have hθ₂_surj : Function.Surjective θ₂ := by
        intro q
        induction q using Quotient.inductionOn' with
        | h a =>
          obtain ⟨u₀, hu₀_mem, u₁, hu⟩ := hSurj_V (res₁ (t₀ ^ B) * res₀ a)
          have hw₁_eq : res₀ (a - h₀ ^ (B - k) * u₀) = res₀ (h₀ ^ B) * res₁ (-u₁) := by
            have hneg : res₁ (-u₁) = res₁ (t₀ ^ B) * res₀ a - res₁ (t₀ ^ k) * res₀ u₀ := by
              rw [map_neg, ← hu]; ring
            rw [hneg, mul_sub, ← mul_assoc, hht_pow B, one_mul, hB_split_k, map_mul, map_sub,
              map_mul]
            have hcancel : (res₀ (h₀ ^ (B - k)) * res₀ (h₀ ^ k)) * (res₁ (t₀ ^ k) * res₀ u₀) =
                res₀ (h₀ ^ (B - k)) * res₀ u₀ := by
              calc
                (res₀ (h₀ ^ (B - k)) * res₀ (h₀ ^ k)) * (res₁ (t₀ ^ k) * res₀ u₀)
                    = res₀ (h₀ ^ (B - k)) * ((res₀ (h₀ ^ k) * res₁ (t₀ ^ k)) * res₀ u₀) := by ring
                _ = res₀ (h₀ ^ (B - k)) * res₀ u₀ := by rw [hht_pow k, one_mul]
            rw [hcancel]
          have hw₁_mem : -u₁ ∈ W_B := (hWB_mem (-u₁)).mpr ⟨a - h₀ ^ (B - k) * u₀, hw₁_eq⟩
          let w : ↥W_B := ⟨-u₁, hw₁_mem⟩
          have hν_w : ν_B w = a - h₀ ^ (B - k) * u₀ :=
            hInj₀ ((hν_spec w).trans hw₁_eq.symm)
          refine ⟨w, ?_⟩
          change Ideal.Quotient.mk J_Bk (ν_B w) = Ideal.Quotient.mk J_Bk a
          rw [hν_w, map_sub]
          have hzero : Ideal.Quotient.mk J_Bk (h₀ ^ (B - k) * u₀) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr
              ((hSpanMul (h₀ ^ (B - k)) I (h₀ ^ (B - k) * u₀)).mpr ⟨u₀, hu₀_mem, rfl⟩)
          rw [hzero, sub_zero]
      have hH₀_le_WB : H₀_k ≤ W_B := by
        intro x₁ hx₁
        obtain ⟨y₀, _, hy₀_eq⟩ := (hH₀_mem x₁).mp hx₁
        exact (hWB_mem x₁).mpr ⟨h₀ ^ (B - k) * y₀, by
          rw [map_mul, hy₀_eq, hB_split_k, map_mul, mul_assoc]⟩
      have hθ₂_ker_iff : ∀ w : ↥W_B, θ₂ w = 0 ↔ w.1 ∈ H₀_k := by
        intro w
        constructor
        · intro hw0
          have hν_mem : ν_B w ∈ J_Bk := Ideal.Quotient.eq_zero_iff_mem.mp hw0
          rcases (hSpanMul (h₀ ^ (B - k)) I (ν_B w)).mp hν_mem with ⟨y₀, hy₀_mem, hy₀_eq⟩
          rw [hH₀_mem]
          refine ⟨y₀, hy₀_mem, ?_⟩
          have hmul_eq : res₀ (h₀ ^ (B - k)) * res₀ y₀ =
              res₀ (h₀ ^ (B - k)) * (res₀ (h₀ ^ k) * res₁ w.1) := by
            rw [← map_mul, ← hy₀_eq, hνB_spec w, hB_split_k, map_mul, mul_assoc]
          calc
            res₀ y₀ = (res₀ (h₀ ^ (B - k)) * res₁ (t₀ ^ (B - k))) * res₀ y₀ := by
              rw [hht_pow (B - k), one_mul]
            _ = res₁ (t₀ ^ (B - k)) * (res₀ (h₀ ^ (B - k)) * res₀ y₀) := by ring
            _ = res₁ (t₀ ^ (B - k)) * (res₀ (h₀ ^ (B - k)) * (res₀ (h₀ ^ k) * res₁ w.1)) := by
              rw [hmul_eq]
            _ = (res₀ (h₀ ^ (B - k)) * res₁ (t₀ ^ (B - k))) * (res₀ (h₀ ^ k) * res₁ w.1) := by
              ring
            _ = res₀ (h₀ ^ k) * res₁ w.1 := by rw [hht_pow (B - k), one_mul]
        · intro hwH
          obtain ⟨y₀, hy₀_mem, hy₀_eq⟩ := (hH₀_mem w.1).mp hwH
          have hν_eq : ν_B w = h₀ ^ (B - k) * y₀ := by
            apply hInj₀
            rw [hνB_spec w, map_mul, hy₀_eq, hB_split_k, map_mul, mul_assoc]
          change Ideal.Quotient.mk J_Bk (ν_B w) = 0
          rw [hν_eq]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr
            ((hSpanMul (h₀ ^ (B - k)) I (h₀ ^ (B - k) * y₀)).mpr ⟨y₀, hy₀_mem, rfl⟩)
      have hFree_Q₂ : Module.Free ↥V Q₂ := hFree_IZ (B - k) k hk
      have hProj_Q₂ : Module.Projective ↥V Q₂ := Module.Projective.of_free
      obtain ⟨σ, hσ⟩ :=
        Module.projective_lifting_property θ₂ (LinearMap.id : Q₂ →ₗ[↥V] Q₂) hθ₂_surj
      let ρ : ↥W_B →ₗ[↥V] R₁ := W_B.subtype.comp (LinearMap.id - σ.comp θ₂)
      have hMap_ρ : Submodule.map ρ ⊤ = H₀_k := by
        ext x₁
        simp only [Submodule.mem_map, Submodule.mem_top, true_and]
        constructor
        · rintro ⟨w, rfl⟩
          let w' : ↥W_B := w - σ (θ₂ w)
          have hρw : ρ w = w'.1 := rfl
          rw [hρw, ← hθ₂_ker_iff w']
          dsimp [w']
          have hσ_app : θ₂ (σ (θ₂ w)) = θ₂ w := LinearMap.congr_fun hσ (θ₂ w)
          rw [map_sub, hσ_app, sub_self]
        · intro hx₁
          let w : ↥W_B := ⟨x₁, hH₀_le_WB hx₁⟩
          refine ⟨w, ?_⟩
          have hw0 : θ₂ w = 0 := (hθ₂_ker_iff w).mpr hx₁
          change (w - σ (θ₂ w)).1 = x₁
          rw [hw0, map_zero, sub_zero]
      rw [← hMap_ρ]
      exact Submodule.FG.map ρ hWB_fg
    have hht_Y : res₀_Y (π₀ h₀ ^ k) * res₁_Y (π₁ t₀ ^ k) = 1 := by
      rw [← map_pow, ← map_pow, hComm₀_app (h₀ ^ k), hComm₁_app (t₀ ^ k), ← map_mul,
        hht_pow k, map_one]
    have hLift : ∀ x₁_Y : R₁_Y,
        (∃ x₀_Y ∈ I_Z_Y ^ k, res₀_Y x₀_Y = res₀_Y (π₀ h₀ ^ k) * res₁_Y x₁_Y) ↔
          ∃ x₁ ∈ H₀_k, π₁ x₁ = x₁_Y := by
      intro x₁_Y
      constructor
      · rintro ⟨x₀_Y, hx₀_Y_mem, hx₀_Y_eq⟩
        rw [← hMap_IZ k] at hx₀_Y_mem
        obtain ⟨x'₀, hx'₀_mem, rfl⟩ := (Ideal.mem_map_iff_of_surjective π₀ hSurj₀).mp hx₀_Y_mem
        obtain ⟨x'₁, rfl⟩ := hSurj₁ x₁_Y
        let δ : R₀₁ := res₁ (t₀ ^ k) * res₀ x'₀ - res₁ x'₁
        have hδ_ker : δ ∈ RingHom.ker π₀₁ := by
          rw [RingHom.mem_ker]
          dsimp [δ]
          rw [map_sub, map_mul, ← hComm₁_app (t₀ ^ k), ← hComm₀_app x'₀, ← hComm₁_app x'₁,
            map_pow, hx₀_Y_eq]
          calc
            res₁_Y (π₁ t₀ ^ k) * (res₀_Y (π₀ h₀ ^ k) * res₁_Y (π₁ x'₁)) - res₁_Y (π₁ x'₁)
                = (res₀_Y (π₀ h₀ ^ k) * res₁_Y (π₁ t₀ ^ k)) * res₁_Y (π₁ x'₁) - res₁_Y (π₁ x'₁) := by
              ring
            _ = 0 := by rw [hht_Y, one_mul, sub_self]
        rw [hKer₀₁] at hδ_ker
        obtain ⟨m, hm, z₀, hδ_eq⟩ := hSingleScalar δ hδ_ker
        obtain ⟨u₀, hu₀_mem, u₁, hu_eq⟩ := hSurj_V z₀
        let x₀ : R₀ := x'₀ - m • u₀
        let x₁ : R₁ := x'₁ - m • u₁
        have hx₀_mem : x₀ ∈ I := by
          refine I.sub_mem hx'₀_mem ?_
          rw [Algebra.smul_def]
          exact I.mul_mem_left _ hu₀_mem
        have hx₁_H₀ : x₁ ∈ H₀_k := by
          rw [hH₀_mem]
          refine ⟨x₀, hx₀_mem, ?_⟩
          have hdiff_zero : res₁ (t₀ ^ k) * res₀ x₀ - res₁ x₁ = 0 := by
            dsimp [x₀, x₁]
            rw [map_sub, _root_.map_smul, map_sub, _root_.map_smul, mul_sub, mul_smul_comm]
            calc
              (res₁ (t₀ ^ k) * res₀ x'₀ - m • (res₁ (t₀ ^ k) * res₀ u₀)) - (res₁ x'₁ - m • res₁ u₁)
                  = (res₁ (t₀ ^ k) * res₀ x'₀ - res₁ x'₁) -
                      (m • (res₁ (t₀ ^ k) * res₀ u₀) - m • res₁ u₁) := by abel
              _ = δ - m • (res₁ (t₀ ^ k) * res₀ u₀ - res₁ u₁) := by rw [smul_sub]
              _ = δ - m • z₀ := by rw [hu_eq]
              _ = 0 := by rw [hδ_eq, sub_self]
          have htx_eq : res₁ (t₀ ^ k) * res₀ x₀ = res₁ x₁ := sub_eq_zero.mp hdiff_zero
          calc
            res₀ x₀ = (res₀ (h₀ ^ k) * res₁ (t₀ ^ k)) * res₀ x₀ := by rw [hht_pow k, one_mul]
            _ = res₀ (h₀ ^ k) * (res₁ (t₀ ^ k) * res₀ x₀) := by ring
            _ = res₀ (h₀ ^ k) * res₁ x₁ := by rw [htx_eq]
        have hπ₁_x₁ : π₁ x₁ = π₁ x'₁ := by
          dsimp [x₁]
          have hmu_ker : m • u₁ ∈ RingHom.ker π₁ := by
            rw [hKer₁, Algebra.smul_def]
            exact Ideal.mul_mem_right u₁ _ (Ideal.mem_map_of_mem (algebraMap ↥V R₁) hm)
          rw [RingHom.mem_ker] at hmu_ker
          rw [map_sub, hmu_ker, sub_zero]
        exact ⟨x₁, hx₁_H₀, hπ₁_x₁⟩
      · rintro ⟨x₁, hx₁_H₀, rfl⟩
        obtain ⟨x₀, hx₀_mem, hx₀_eq⟩ := (hH₀_mem x₁).mp hx₁_H₀
        refine ⟨π₀ x₀, ?_, ?_⟩
        · rw [← hMap_IZ k]
          exact Ideal.mem_map_of_mem π₀ hx₀_mem
        · rw [hComm₀_app x₀, hx₀_eq, map_mul, ← hComm₀_app (h₀ ^ k), ← hComm₁_app x₁, map_pow]
    have hKer_mod : ∀ x₁ ∈ H₀_k, π₁ x₁ = 0 → x₁ ∈ (IsLocalRing.maximalIdeal ↥V) • H₀_k := by
      intro x₁ hx₁ hπ₁
      have hx₁_ker : x₁ ∈ RingHom.ker π₁ := hπ₁
      rw [hKer₁] at hx₁_ker
      obtain ⟨m, hm, y₁, rfl⟩ := hSingleScalar x₁ hx₁_ker
      by_cases hm0 : m = 0
      · rw [hm0, zero_smul]
        exact zero_mem _
      · have hy₁_mem : y₁ ∈ H₀_k := hH₀_sat m y₁ hm0 hx₁
        exact Submodule.smul_mem_smul hm hy₁_mem
    exact ⟨hSurj_V, H₀_k, hH₀_fg, hH₀_mem, hLift, hKer_mod⟩

theorem weil_sup1_relative_cech_freeness_and_veronese_basis (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let fstY := CategoryTheory.Limits.pullback.fst g s₀
    let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
    let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
    (∃ (A₀ : ℕ),
      1 ≤ A₀ ∧
      ∀ z : ↑(Y.presheaf.obj (Opposite.op (V₀_Y ⊓ V₁_Y))),
        ∃ (x₀ : ↑(Y.presheaf.obj (Opposite.op V₀_Y)))
          (x₁ : ↑(Y.presheaf.obj (Opposite.op V₁_Y))),
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom
              ((fstY.appLE V₁ V₁_Y le_rfl).hom (t₀ ^ A₀)) *
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom x₀ -
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom x₁ = z) ∧
    (∀ (m₀ : ℕ) (f₁_bar : ↑(Y.presheaf.obj (Opposite.op V₁_Y))),
      IsClosedFiberVeroneseSeed V g Z V₀ V₁ h₀ eZ eY t₀ m₀ f₁_bar →
      ∃ (N' : ℕ)
        (f : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op V₁)))
        (f_Y f_Z : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op V₀))),
        IsRelativeVeroneseBasisPkg V g Z V₀ V₁ h₀ eZ eY t₀ m₀ N' f f_Y f_Z) :=
by
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let Y := CategoryTheory.Limits.pullback g s₀
  let fstY := CategoryTheory.Limits.pullback.fst g s₀
  let sndY := CategoryTheory.Limits.pullback.snd g s₀
  let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
  let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
  let R₀ := C.presheaf.obj (Opposite.op V₀)
  let R₁ := C.presheaf.obj (Opposite.op V₁)
  let R₀₁ := C.presheaf.obj (Opposite.op (V₀ ⊓ V₁))
  let R₀_Y := Y.presheaf.obj (Opposite.op V₀_Y)
  let R₁_Y := Y.presheaf.obj (Opposite.op V₁_Y)
  let R₀₁_Y := Y.presheaf.obj (Opposite.op (V₀_Y ⊓ V₁_Y))
  let c₀ : ↥V →+* ↑R₀ :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom
  let c₁ : ↥V →+* ↑R₁ :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom
  let c₀₁ : ↥V →+* ↑R₀₁ :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ (V₀ ⊓ V₁) le_top).hom
  let c₁_Y : k₀ →+* ↑R₁_Y :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE sndY ⊤ V₁_Y le_top).hom
  let res₀_hom : ↑R₀ →+* ↑R₀₁ :=
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
  let res₁_hom : ↑R₁ →+* ↑R₀₁ :=
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
  let res₀_Y : ↑R₀_Y →+* ↑R₀₁_Y :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom
  let res₁_Y : ↑R₁_Y →+* ↑R₀₁_Y :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀_Y ⊓ V₁_Y ≤ V₁_Y)).op).hom
  let π₀ : ↑R₀ →+* ↑R₀_Y := (fstY.appLE V₀ V₀_Y le_rfl).hom
  let π₁ : ↑R₁ →+* ↑R₁_Y := (fstY.appLE V₁ V₁_Y le_rfl).hom
  let π₀₁ : ↑R₀₁ →+* ↑R₀₁_Y := (fstY.appLE (V₀ ⊓ V₁) (V₀_Y ⊓ V₁_Y) le_rfl).hom
  obtain ⟨hDom₀, hDom₁, hDom₀₁, hh₀_ne, ht₀_ne, hLoc₀, hLoc₁,
    hInj₀, hInj₁, hc₀_compat, hc₁_compat, hTorsFree₁,
    hSurj₀, hSurj₁, hSurj₀₁, hKer₁, hKer₀₁,
    hComm₀, hComm₁, hc₁Y_compat, hInj_res₀_Y, hGoingUp⟩ :=
    weil_sup1_relative_pencil_scheme_to_ring_bridge K m V hMaxNeBot hPkg
      C_K p_K n σ_K C g τ ι hSemi Z Z_sch ιZ hUnstab V₀ V₁ h₀ eZ eY t₀ hPencil
  letI : IsDomain ↑R₀ := hDom₀
  letI : IsDomain ↑R₁ := hDom₁
  letI : IsDomain ↑R₀₁ := hDom₀₁
  letI : Algebra ↥V ↑R₀ := c₀.toAlgebra
  letI : Algebra ↥V ↑R₁ := c₁.toAlgebra
  letI : Algebra ↥V ↑R₀₁ := c₀₁.toAlgebra
  letI : Algebra k₀ ↑R₁_Y := c₁_Y.toAlgebra
  let res₀ : ↑R₀ →ₐ[↥V] ↑R₀₁ := { res₀_hom with commutes' := hc₀_compat }
  let res₁ : ↑R₁ →ₐ[↥V] ↑R₀₁ := { res₁_hom with commutes' := hc₁_compat }
  obtain ⟨hSatFG, hBasisLift⟩ :=
    weil_sup1_valuation_saturated_submodule_fg_and_basis_lift K V
  rcases hPencil with ⟨_hV₀, _hV₁, _hCov, _hBasic₀, _hBasic₁,
    hht, hFin₀, hFin₁, hQuot₀, hQuot₁_all, hMonic₁_both,
    heZ_add, heZ_mul, _hPencil_rest⟩
  have hQuot₁ : Module.Free ↥V (↑R₁ ⧸ Ideal.span ({t₀} : Set ↑R₁)) ∧
      Module.Finite ↥V (↑R₁ ⧸ Ideal.span ({t₀} : Set ↑R₁)) ∧
      Nontrivial (↑R₁ ⧸ Ideal.span ({t₀} : Set ↑R₁)) := by
    have h1 := hQuot₁_all 1 le_rfl
    rwa [pow_one] at h1
  have hMonic₁ : ∀ Q : Polynomial ↥V, Q.Monic →
      Module.Free ↥V (↑R₁ ⧸ Ideal.span ({Polynomial.aeval t₀ Q} : Set ↑R₁)) :=
    fun Q hQ => (hMonic₁_both Q hQ).1
  obtain ⟨A₀, W, hA₀_pos, hA₀_surj_V, hH1_fg, hW_mem, hW_fg⟩ :=
    weil_sup1_monic_saturation_untwisted_cech_fg K V hMaxNeBot hSatFG
      ↑R₀ ↑R₁ ↑R₀₁ res₀ res₁ hInj₀ hInj₁ h₀ t₀ hh₀_ne ht₀_ne hht
      hLoc₀ hLoc₁ hFin₀ hFin₁ hQuot₀ hQuot₁ hMonic₁
  have hComm₀_app : ∀ x : ↑R₀, res₀_Y (π₀ x) = π₀₁ (res₀ x) :=
    fun x => RingHom.congr_fun hComm₀ x
  have hComm₁_app : ∀ x : ↑R₁, res₁_Y (π₁ x) = π₀₁ (res₁ x) :=
    fun x => RingHom.congr_fun hComm₁ x
  refine ⟨?_, ?_⟩
  · refine ⟨A₀, hA₀_pos, ?_⟩
    intro z_Y
    obtain ⟨z, rfl⟩ := hSurj₀₁ z_Y
    obtain ⟨x₀, x₁, hz⟩ := hA₀_surj_V z
