      rw [injective_iff_map_eq_zero]
      intro t ht
      let ι_aS : ↥(B_R_a a₀) →ₐ[↥R] ↥(B_R S) :=
        { toRingHom := Subring.inclusion hle_a_S, commutes' := fun _ => Subtype.ext rfl }
      have hle_Ba_BS : B {a₀} ≤ B S := by
