          (R_z.isoSpec.inv ≫ k_z) hWz_aff.fromSpec hRange_eq
        have hθ_fac : θ_z.hom ≫ hWz_aff.fromSpec = R_z.isoSpec.inv ≫ k_z :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac _ hWz_aff.fromSpec hRange_eq
        let ρ_z : ↑(R_z.presheaf.obj (Opposite.op ⊤)) →+* F :=
          ι_W.comp (AlgebraicGeometry.Spec.preimage θ_z.inv).hom
        have hρ_inj : Function.Injective ρ_z := by
          refine hιW_inj.comp ?_
          have hIsoPre : CategoryTheory.IsIso (AlgebraicGeometry.Spec.preimage θ_z.inv) := by
            refine ⟨⟨AlgebraicGeometry.Spec.preimage θ_z.hom, ?_, ?_⟩⟩ <;>
              apply AlgebraicGeometry.Spec.map_injective <;>
              simp [AlgebraicGeometry.Spec.map_preimage]
          exact (ConcreteCategory.bijective_of_isIso (AlgebraicGeometry.Spec.preimage θ_z.inv)).1
        have hρ_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_z) ≫
            R_z.isoSpec.inv ≫ k_z = η_X := by
          change AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Spec.preimage θ_z.inv ≫ CommRingCat.ofHom ι_W) ≫
            (R_z.isoSpec.inv ≫ k_z) = η_X
          rw [AlgebraicGeometry.Spec.map_comp,
            AlgebraicGeometry.Spec.map_preimage, ← hθ_fac,
            CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc θ_z.inv,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp, hιW_spec]
        let m₁ := R_z.isoSpec.inv ≫ u_z ≫ CategoryTheory.Limits.pullback.fst (𝒰.f i₁) (𝒰.f i₂)
        let m₂ := R_z.isoSpec.inv ≫ u_z ≫ CategoryTheory.Limits.pullback.snd (𝒰.f i₁) (𝒰.f i₂)
        let γ₁ : ↑(X.presheaf.obj (Opposite.op i₁.1)) →+* ↑(R_z.presheaf.obj (Opposite.op ⊤)) :=
          (AlgebraicGeometry.Spec.preimage m₁).hom
        let γ₂ : ↑(X.presheaf.obj (Opposite.op i₂.1)) →+* ↑(R_z.presheaf.obj (Opposite.op ⊤)) :=
          (AlgebraicGeometry.Spec.preimage m₂).hom
        have hγ₁ : ρ_z.comp γ₁ = ι_loc i₁ := by
          have hCat : CommRingCat.ofHom γ₁ ≫ CommRingCat.ofHom ρ_z =
              CommRingCat.ofHom (ι_loc i₁) := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [← cancel_mono (𝒰.f i₁), AlgebraicGeometry.Spec.map_comp]
            have hm₁_pre : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ₁) = m₁ :=
              AlgebraicGeometry.Spec.map_preimage m₁
            rw [hm₁_pre, CategoryTheory.Category.assoc]
            have hm₁_eq : m₁ ≫ 𝒰.f i₁ = R_z.isoSpec.inv ≫ k_z := by
              simp [m₁, k_z, CategoryTheory.Category.assoc]
            rw [hm₁_eq, hρ_spec, hι_spec_loc i₁]
          exact congrArg CommRingCat.Hom.hom hCat
        have hγ₂ : ρ_z.comp γ₂ = ι_loc i₂ := by
          have hCat : CommRingCat.ofHom γ₂ ≫ CommRingCat.ofHom ρ_z =
              CommRingCat.ofHom (ι_loc i₂) := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [← cancel_mono (𝒰.f i₂), AlgebraicGeometry.Spec.map_comp]
            have hm₂_pre : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ₂) = m₂ :=
              AlgebraicGeometry.Spec.map_preimage m₂
            rw [hm₂_pre, CategoryTheory.Category.assoc]
            have hm₂_eq : m₂ ≫ 𝒰.f i₂ = R_z.isoSpec.inv ≫ k_z := by
              dsimp [m₂]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hk_z2]
            rw [hm₂_eq, hρ_spec, hι_spec_loc i₂]
          exact congrArg CommRingCat.Hom.hom hCat
        have hγβ : γ₁.comp (β_loc i₁) = γ₂.comp (β_loc i₂) := by
          apply RingHom.ext; intro b
          apply hρ_inj
          calc
            ρ_z (γ₁ (β_loc i₁ b)) = (ρ_z.comp γ₁) (β_loc i₁ b) := rfl
            _ = (ι_loc i₁) (β_loc i₁ b) := by rw [hγ₁]
            _ = b.1 := RingHom.congr_fun (hιβ_loc i₁) b
            _ = (ι_loc i₂) (β_loc i₂ b) := (RingHom.congr_fun (hιβ_loc i₂) b).symm
            _ = (ρ_z.comp γ₂) (β_loc i₂ b) := by rw [hγ₂]
            _ = ρ_z (γ₂ (β_loc i₂ b)) := rfl
        rw [← cancel_epi R_z.isoSpec.inv]
        change m₁ ≫ g_cov i₁ = m₂ ≫ g_cov i₂
        rw [← AlgebraicGeometry.Spec.map_preimage m₁, ← AlgebraicGeometry.Spec.map_preimage m₂]
        dsimp [g_cov]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        exact CommRingCat.hom_ext_iff.mpr hγβ
      · rw [← cancel_epi R_z.isoSpec.inv]
        have hEmptySpec : IsEmpty (PrimeSpectrum ↑(R_z.presheaf.obj (Opposite.op ⊤))) := by
          refine ⟨fun p => hne_z ⟨R_z.isoSpec.inv.base p⟩⟩
        haveI : Subsingleton ↑(R_z.presheaf.obj (Opposite.op ⊤)) :=
          PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmptySpec
        let lhs := R_z.isoSpec.inv ≫ u_z ≫
          CategoryTheory.Limits.pullback.fst (𝒰.f i₁) (𝒰.f i₂) ≫ g_cov i₁
        let rhs := R_z.isoSpec.inv ≫ u_z ≫
          CategoryTheory.Limits.pullback.snd (𝒰.f i₁) (𝒰.f i₂) ≫ g_cov i₂
        change lhs = rhs
        rw [← AlgebraicGeometry.Spec.map_preimage lhs, ← AlgebraicGeometry.Spec.map_preimage rhs]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext; intro _
        exact Subsingleton.elim _ _
    let ψ : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of B') :=
      AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰 g_cov hg_compat
    have hψ_loc : ∀ i : 𝒰.I₀, i.2.1.fromSpec ≫ ψ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_loc i)) :=
      AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰 g_cov hg_compat
    have hψ_f : ψ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B')) = f := by
      apply AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰
      intro i
      change i.2.1.fromSpec ≫ ψ ≫ _ = i.2.1.fromSpec ≫ f
      rw [← CategoryTheory.Category.assoc, hψ_loc i, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hβA_loc i]
    have : AlgebraicGeometry.IsProper
        (ψ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B'))) :=
      hψ_f.symm ▸ hPropF
    have : AlgebraicGeometry.IsProper ψ :=
      AlgebraicGeometry.IsProper.of_comp ψ
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B')))
    have hOpen_loc : ∀ x : ↥X, ∃ U_x : X.Opens,
        x ∈ U_x ∧ AlgebraicGeometry.IsOpenImmersion (U_x.ι ≫ ψ) := by
      intro x
      let i : I₀ := idx_fn x
      let U := i.1
      let hU := i.2.1
      obtain ⟨p, hp_eq⟩ := hidx_fn x
      let S_U : Type u := ↑(X.presheaf.obj (Opposite.op U))
      let α_U : A →+* S_U := (β_loc i).comp (algebraMap A B')
      have hαU_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) = hU.fromSpec ≫ f :=
        hβA_loc i
      letI : Algebra A S_U := α_U.toAlgebra
      have : AlgebraicGeometry.LocallyOfFiniteType (hU.fromSpec ≫ f) := inferInstance
      have hFT_α : α_U.FiniteType :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (by rw [hαU_spec]; infer_instance)
      have : Algebra.FiniteType A S_U := RingHom.finiteType_algebraMap.mp hFT_α
      have : Algebra.QuasiFinite A S_U := by
        rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
        intro y
        have hInj_from : Function.Injective hU.fromSpec.base :=
          AlgebraicGeometry.Scheme.Hom.injective hU.fromSpec
        have hSub : hU.fromSpec.base '' (PrimeSpectrum.comap (algebraMap A S_U) ⁻¹' {y}) ⊆
            f.base ⁻¹' {y} := by
          rintro _ ⟨q, hqy, rfl⟩
          change (hU.fromSpec ≫ f).base q = y
          rw [← hαU_spec]
          exact hqy
        exact ((hFinFibF y).subset hSub).of_finite_image hInj_from.injOn
      let p' : PrimeSpectrum S_U := p
      haveI : p'.asIdeal.IsPrime := p'.isPrime
      have hZMP : Algebra.ZariskisMainProperty A p'.asIdeal :=
        Algebra.ZariskisMainProperty.of_finiteType (R := A) (S := S_U) p'.asIdeal
      obtain ⟨r₀, hr₀_not_mem, hr₀_int, h_zmt⟩ :=
        (Algebra.zariskisMainProperty_iff (R := A) (S := S_U) (p := p'.asIdeal)).mp hZMP
      have hr₀_int_F : _root_.IsIntegral A (ι_loc i r₀) := by
        obtain ⟨P_pol, hPm, hPev⟩ := hr₀_int
        refine ⟨P_pol, hPm, ?_⟩
        rw [← map_zero (ι_loc i), ← hPev, Polynomial.hom_eval₂]
        have hcomm : (ι_loc i).comp (algebraMap A S_U) = algebraMap A F := by
          apply RingHom.ext; intro a
          change ι_loc i (β_loc i (algebraMap A B' a)) = φ_A a
          exact RingHom.congr_fun (hιβ_loc i) (algebraMap A B' a)
        rw [hcomm]
      let b₀ : B' := ⟨ι_loc i r₀, hr₀_int_F⟩
      have hβ_b₀ : β_loc i b₀ = r₀ :=
        hι_inj_loc i (RingHom.congr_fun (hιβ_loc i) b₀)
      let U_x : X.Opens := X.basicOpen r₀
      have hx_Ux : x ∈ U_x := by
        rw [← hp_eq]
        change p ∈ (hU.fromSpec ⁻¹ᵁ X.basicOpen r₀)
        rw [hU.fromSpec_preimage_basicOpen]
        exact hr₀_not_mem
      have hUx_aff : AlgebraicGeometry.IsAffineOpen U_x := hU.basicOpen r₀
      let j : I₀ := ⟨U_x, hUx_aff, ⟨x, hx_Ux⟩⟩
      let T : Type u := ↑(X.presheaf.obj (Opposite.op U_x))
      let res_hom := X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le r₀)).op
      let res : S_U →+* T := res_hom.hom
      have hres_from : AlgebraicGeometry.Spec.map res_hom ≫ hU.fromSpec = hUx_aff.fromSpec :=
        hU.map_fromSpec hUx_aff (CategoryTheory.homOfLE (X.basicOpen_le r₀)).op
      have hι_res : (ι_loc j).comp res = ι_loc i := by
        have hCat : res_hom ≫ CommRingCat.ofHom (ι_loc j) = CommRingCat.ofHom (ι_loc i) := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [← cancel_mono hU.fromSpec, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc, hres_from, hι_spec_loc j, hι_spec_loc i]
        exact congrArg CommRingCat.Hom.hom hCat
      have hβ_res : β_loc j = res.comp (β_loc i) := by
        apply RingHom.ext; intro b
        apply hι_inj_loc j
        calc
          ι_loc j (β_loc j b) = b.1 := RingHom.congr_fun (hιβ_loc j) b
          _ = ι_loc i (β_loc i b) := (RingHom.congr_fun (hιβ_loc i) b).symm
          _ = (ι_loc j).comp res (β_loc i b) := by rw [hι_res]
          _ = ι_loc j (res (β_loc i b)) := rfl
      have hLocR₀ : IsLocalization.Away r₀ T := hU.isLocalization_basicOpen r₀
      letI : Algebra B' T := (β_loc j).toAlgebra
      have hLocB₀ : @IsLocalization.Away B' _ b₀ T _ (β_loc j).toAlgebra := by
        refine
          { map_units := ?_
            surj := ?_
            exists_of_eq := ?_ }
        · rintro ⟨_, k, rfl⟩
          change IsUnit (β_loc j (b₀ ^ k))
          rw [map_pow, hβ_res, RingHom.comp_apply, hβ_b₀, ← map_pow]
          exact @IsLocalization.map_units S_U _ (Submonoid.powers r₀) T _ _ hLocR₀
            ⟨r₀ ^ k, k, rfl⟩
        · intro z
          obtain ⟨⟨s, _, k, rfl⟩, hzs⟩ :=
            @IsLocalization.surj S_U _ (Submonoid.powers r₀) T _ _ hLocR₀ z
          change z * res (r₀ ^ k) = res s at hzs
          obtain ⟨m_z, hm_int⟩ := h_zmt s
          have hm_int_F : _root_.IsIntegral A (ι_loc i (r₀ ^ m_z * s)) := by
            obtain ⟨P_pol, hPm, hPev⟩ := hm_int
            refine ⟨P_pol, hPm, ?_⟩
            rw [← map_zero (ι_loc i), ← hPev, Polynomial.hom_eval₂]
            have hcomm : (ι_loc i).comp (algebraMap A S_U) = algebraMap A F := by
              apply RingHom.ext; intro a
              change ι_loc i (β_loc i (algebraMap A B' a)) = φ_A a
              exact RingHom.congr_fun (hιβ_loc i) (algebraMap A B' a)
            rw [hcomm]
          let b_s : B' := ⟨ι_loc i (r₀ ^ m_z * s), hm_int_F⟩
          have hβ_bs : β_loc i b_s = r₀ ^ m_z * s :=
            hι_inj_loc i (RingHom.congr_fun (hιβ_loc i) b_s)
          refine ⟨⟨b_s, ⟨b₀ ^ (k + m_z), k + m_z, rfl⟩⟩, ?_⟩
          change z * β_loc j (b₀ ^ (k + m_z)) = β_loc j b_s
          rw [hβ_res, RingHom.comp_apply, RingHom.comp_apply, hβ_bs, map_pow, hβ_b₀, pow_add,
            map_mul, ← mul_assoc, hzs, ← map_mul, mul_comm s (r₀ ^ m_z)]
        · intro b₁ b₂ hb_eq
          refine ⟨1, ?_⟩
          simp only [Submonoid.coe_one, one_mul]
          have hinj_βj : Function.Injective (β_loc j) := by
            intro u₁ u₂ hu
            apply Subtype.ext
            calc
              u₁.1 = ι_loc j (β_loc j u₁) := (RingHom.congr_fun (hιβ_loc j) u₁).symm
              _ = ι_loc j (β_loc j u₂) := by rw [hu]
              _ = u₂.1 := RingHom.congr_fun (hιβ_loc j) u₂
          exact hinj_βj hb_eq
      haveI : AlgebraicGeometry.IsOpenImmersion (hUx_aff.fromSpec ≫ ψ) := by
        rw [hψ_loc j]
        exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization B' T _ _ (β_loc j).toAlgebra b₀ hLocB₀
      have hRange_Ux : Set.range U_x.ι.base = Set.range hUx_aff.fromSpec.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hUx_aff.range_fromSpec]
      let e_Ux := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq U_x.ι hUx_aff.fromSpec hRange_Ux
      have he_Ux : U_x.ι ≫ ψ = e_Ux.hom ≫ (hUx_aff.fromSpec ≫ ψ) := by
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac U_x.ι hUx_aff.fromSpec hRange_Ux]
      refine ⟨U_x, hx_Ux, ?_⟩
      rw [he_Ux]
      infer_instance
    choose U_x hx_Ux hOpen_Ux using hOpen_loc
    have hInj_ψ : Function.Injective ψ.base := by
      intro x₁ x₂ hx_eq
      haveI := hOpen_Ux x₁
      haveI := hOpen_Ux x₂
      let W₂ : (AlgebraicGeometry.Spec (CommRingCat.of B')).Opens := ((U_x x₂).ι ≫ ψ).opensRange
      let U'₁ : X.Opens := U_x x₁ ⊓ (TopologicalSpace.Opens.map ψ.base).obj W₂
      have hx₁_U'₁ : x₁ ∈ U'₁ := by
        refine ⟨hx_Ux x₁, ?_⟩
        change ψ.base x₁ ∈ Set.range ((U_x x₂).ι ≫ ψ).base
        rw [hx_eq]
        exact ⟨⟨x₂, hx_Ux x₂⟩, rfl⟩
      have hRange_U'₁ : Set.range (U'₁.ι ≫ ψ).base ⊆ Set.range ((U_x x₂).ι ≫ ψ).base := by
        rintro _ ⟨z, rfl⟩
        exact z.2.2
      let g₀ : U'₁.toScheme ⟶ (U_x x₂).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift ((U_x x₂).ι ≫ ψ) (U'₁.ι ≫ ψ) hRange_U'₁
      have hg₀_fac : g₀ ≫ (U_x x₂).ι ≫ ψ = U'₁.ι ≫ ψ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hRange_U'₁
      have hℓ_sq : U'₁.ι ≫ ψ = (g₀ ≫ (U_x x₂).ι) ≫ ψ := by
        rw [CategoryTheory.Category.assoc, hg₀_fac]
      let ℓ : U'₁.toScheme ⟶ CategoryTheory.Limits.pullback ψ ψ :=
        CategoryTheory.Limits.pullback.lift U'₁.ι (g₀ ≫ (U_x x₂).ι) hℓ_sq
      let U₁₂ : X.Opens := U_x x₁ ⊓ U_x x₂
      have hU₁₂_le : U₁₂ ≤ U'₁ := by
        intro z hz
        exact ⟨hz.1, ⟨⟨z, hz.2⟩, rfl⟩⟩
      let inc : U₁₂.toScheme ⟶ U'₁.toScheme := X.homOfLE hU₁₂_le
      have hinc_g₀ : inc ≫ g₀ = X.homOfLE inf_le_right := by
        rw [← cancel_mono ((U_x x₂).ι ≫ ψ), CategoryTheory.Category.assoc, hg₀_fac]
        dsimp [inc, U₁₂]
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      have hinc_ℓ : inc ≫ ℓ = U₁₂.ι ≫ CategoryTheory.Limits.pullback.diagonal ψ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [ℓ, inc]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            AlgebraicGeometry.Scheme.homOfLE_ι, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, hinc_g₀]
          dsimp [U₁₂]
          rw [AlgebraicGeometry.Scheme.homOfLE_ι, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id]
      let D_Δ : Set ↥(CategoryTheory.Limits.pullback ψ ψ) :=
        Set.range (CategoryTheory.Limits.pullback.diagonal ψ).base
      have hD_cl : IsClosed D_Δ :=
