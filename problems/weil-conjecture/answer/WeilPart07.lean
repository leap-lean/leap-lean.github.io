        have hz_F : Z_sub.subtype ∘ z ∈ LinearMap.ker (bdryM j F_mod) := by
          rw [LinearMap.mem_ker, ← h_bdryM_nat j Z_sub.subtype z, LinearMap.mem_ker.mp hz]
          rfl
        obtain ⟨v, hv⟩ := h_bdryM_flat F_mod j hz_F
