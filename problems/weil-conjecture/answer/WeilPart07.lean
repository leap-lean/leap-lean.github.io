    have _ : IsDomain ↑(C.presheaf.obj (Opposite.op V₁)) :=
      @AlgebraicGeometry.IsIntegral.component_integral C _ V₁ hNE_V₁
    have _ : IsDomain ↑(C.presheaf.obj (Opposite.op (V₀ ⊓ V₁))) :=
      @AlgebraicGeometry.IsIntegral.component_integral C _ (V₀ ⊓ V₁) hNE_V₀₁
    let res₀ : ↑(C.presheaf.obj (Opposite.op V₀)) →+* ↑(C.presheaf.obj (Opposite.op (V₀ ⊓ V₁))) :=
