        have hqη_le_q₀ : q_η.asIdeal ≤ q₀ :=
          (PrimeSpectrum.le_iff_mem_closure q_η w₀).mpr hw₀_cl_qη
        exact hq₀_ne (le_antisymm hq₀_le hqη_le_q₀)
      have hq_not_max : ¬ q_η.asIdeal.IsMaximal := by
        intro hq_max
        have _ : Algebra.FiniteType (MvPolynomial (Fin 1) K') S := inferInstance
        have _ : Algebra.FiniteType K' S :=
          Algebra.FiniteType.trans (S := MvPolynomial (Fin 1) K') inferInstance inferInstance
        obtain ⟨r, π_mv, hπ_surj⟩ :=
          (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := K') (S := S)).mp inferInstance
        have hM_max : (Ideal.comap π_mv.toRingHom q_η.asIdeal).IsMaximal :=
          Ideal.comap_isMaximal_of_surjective π_mv.toRingHom hπ_surj
        obtain ⟨x_pt, hx_pt⟩ :=
          (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := K')).mp hM_max
        obtain ⟨P_lift, hP_lift⟩ := hπ_surj (g_mv (MvPolynomial.X 0))
        let c : K' := MvPolynomial.aeval x_pt P_lift
        have h_mem_van : P_lift - MvPolynomial.C c ∈ MvPolynomial.vanishingIdeal K' {x_pt} := by
          rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
          simp [c]
        rw [← hx_pt] at h_mem_van
        have h_in_qη : π_mv (P_lift - MvPolynomial.C c) ∈ q_η.asIdeal := h_mem_van
        have hπ_C : π_mv (MvPolynomial.C c) = g_mv (MvPolynomial.C c) := by
          rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
          rfl
        have h_gmv_mem : g_mv (MvPolynomial.X 0 - MvPolynomial.C c) ∈ q_η.asIdeal := by
          rw [map_sub, ← hP_lift, ← hπ_C, ← map_sub]
          exact h_in_qη
        have h_in_under : MvPolynomial.X 0 - MvPolynomial.C c ∈
            Ideal.under (MvPolynomial (Fin 1) K') q_η.asIdeal := h_gmv_mem
        rw [hp_bot, Ideal.mem_bot] at h_in_under
        have h_eval := congrArg (MvPolynomial.eval (fun _ : Fin 1 => c + 1)) h_in_under
        simp at h_eval
      obtain ⟨𝔪, h𝔪_max, hq_le_𝔪⟩ := Ideal.exists_le_maximal q_η.asIdeal q_η.isPrime.ne_top
      let w_𝔪 : PrimeSpectrum S := ⟨𝔪, h𝔪_max.isPrime⟩
      let z : ↥X := φ_open.base w_𝔪
      have hw_ne : w_𝔪 ≠ q_η := by
        intro h_eq
        apply hq_not_max
        have h_id : 𝔪 = q_η.asIdeal := congrArg PrimeSpectrum.asIdeal h_eq
