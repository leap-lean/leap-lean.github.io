      have hy_in_cl_ηY : y_gen ∈ closure ({η_Y} : Set _) := by
        rw [hηY_cl]
        exact mem_irreducibleComponent
      have hy₀_U₀ : y₀ ∈ (U₀ : Set ↥X) := by
        rw [← hU₀.range_fromSpec]
        exact ⟨q_B, rfl⟩
      have hηY_U₀ : fst₀.base η_Y ∈ (U₀ : Set ↥X) := by
        have hopen : IsOpen (fst₀.base ⁻¹' (U₀ : Set ↥X)) := U₀.isOpen.preimage fst₀.continuous
        have hy_mem : y_gen ∈ fst₀.base ⁻¹' (U₀ : Set ↥X) := by
