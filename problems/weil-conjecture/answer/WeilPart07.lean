      simp_rw [Finset.mul_sum]
      rw [← Finset.sum_product']
      let simpOf : Fin (p + 3) × Fin (p + 2) →
          {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} := fun x =>
        ⟨(K.1 ∘ x.1.succAbove) ∘ x.2.succAbove,
          (K.2.comp (Fin.strictMono_succAbove x.1)).comp (Fin.strictMono_succAbove x.2)⟩
      let f : Fin (p + 3) × Fin (p + 2) → F := fun x =>
        (-1 : F) ^ (x.1 : ℕ) * ((-1 : F) ^ (x.2 : ℕ) * ξ (simpOf x))
      let g : Fin (p + 3) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) := fun x =>
        if _ : (x.1 : ℕ) ≤ (x.2 : ℕ) then
          (x.2.succ, ⟨x.1.1, by omega⟩)
        else
          (x.2.castSucc, ⟨x.1.1 - 1, by omega⟩)
