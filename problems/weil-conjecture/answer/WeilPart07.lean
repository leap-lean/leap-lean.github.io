          (congrArg (fun x => ρ.hom
            ((V₁.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_tilde ≤ ⊤)).op).hom x))
            (hψ₁_X a)).trans (hρ_res (f a))
        have hfac_rhs : ρ.hom
            ((V₁.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_tilde ≤ ⊤)).op).hom
              (ψ₁ P)) =
            (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le (f a))).op).hom
              (MvPolynomial.eval₂Hom c_R₁ f P) :=
          hρ_res (MvPolynomial.eval₂Hom c_R₁ f P)
        rw [map_mul, map_pow] at happ_eq
        have hlhs_eq : ρ.hom ((φ₀.appLE D_a W_tilde hle_tilde).hom θ) =
            (φ.appLE D_a W_a hle_a).hom θ :=
          RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hρ_app) θ
        exact (congrArg₂ (· * ·) hlhs_eq.symm (congrArg (· ^ r) hfac2.symm)).trans
          (happ_eq.trans hfac_rhs)
      obtain ⟨hle_a, heval⟩ := hEval_C
      let res_Wa : ↑(C.presheaf.obj (Opposite.op V₁)) →+* ↑(C.presheaf.obj (Opposite.op W_a)) :=
        (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le (f a))).op).hom
      let ρ_Ω_W : ↑(C.presheaf.obj (Opposite.op Ω_a)) →+* ↑(C.presheaf.obj (Opposite.op W_a)) :=
        (C.presheaf.map (CategoryTheory.homOfLE hle_a).op).hom
      have hinj_res_Wa : Function.Injective res_Wa := by
        rcases hNE_Wa with ⟨zw, hzw⟩
        exact @AlgebraicGeometry.map_injective_of_isIntegral C _ _ _
          (CategoryTheory.homOfLE (C.basicOpen_le (f a))) ⟨⟨zw, hzw⟩⟩
      have hinj_ρ : Function.Injective ρ_Ω_W := by
        rcases hNE_Wa with ⟨zw, hzw⟩
        exact @AlgebraicGeometry.map_injective_of_isIntegral C _ _ _
          (CategoryTheory.homOfLE hle_a) ⟨⟨zw, hzw⟩⟩
      have happLE_eq : (φ.appLE D_a W_a hle_a).hom θ = ρ_Ω_W ((φ.app D_a).hom θ) := by
        have hm : φ.app D_a ≫ C.presheaf.map (CategoryTheory.homOfLE hle_a).op =
            φ.appLE D_a W_a hle_a := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact (RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hm) θ).symm
      rw [happLE_eq] at heval
      have hu_fa : IsUnit (res_Wa (f a) ^ r) :=
        (C.toRingedSpace.isUnit_res_basicOpen (f a)).pow r
      change (φ.app D_a).hom θ = 0 ↔ MvPolynomial.eval₂Hom c_R₁ f (MvPolynomial.X a * P) = 0
      rw [map_mul, MvPolynomial.eval₂Hom_X']
      constructor
      · intro h0
        rw [h0, map_zero, zero_mul] at heval
        have hev0 : MvPolynomial.eval₂Hom c_R₁ f P = 0 :=
          hinj_res_Wa (by rw [map_zero]; exact heval.symm)
        rw [hev0, mul_zero]
      · intro h0
        have hev0 : MvPolynomial.eval₂Hom c_R₁ f P = 0 :=
          (mul_eq_zero.mp h0).resolve_left hfa
        rw [hev0, map_zero] at heval
        have hρ0 : ρ_Ω_W ((φ.app D_a).hom θ) = 0 :=
          hu_fa.mul_right_cancel (by rw [zero_mul, heval])
        exact hinj_ρ (by rw [map_zero]; exact hρ0)

  
  
  
  refine ⟨φ, U_next₀, f₁_gl, hφ_comm, hSurj_q, rfl, hAff_Unext₀, hPre_Unext₀,
    hf₁_V₁, hf₁_Z_mul, hf₁_vanish,
    ⟨ψ₁, hψ₁, ψ_Z, hψ_Z, ψ_Y, hψ_Y,
      hψ₁_C, hψ₁_X, hφ₀,
      hψZ_C, hψZ_X_mul, hφ₁,
      hψY_C, hψY_X, hφ₂⟩,
    hKer⟩

theorem weil_sup1_baseChange_veronese_basis_and_chart_injections (K : Type u) [Field K] (V : ValuationSubring K)
    (R₀ R₁ R₀₁ : Type u) [CommRing R₀] [IsDomain R₀] [CommRing R₁] [CommRing R₀₁]
    [Algebra ↥V R₀] [Algebra ↥V R₁] [Algebra ↥V R₀₁] [Module.Flat ↥V R₀₁]
    (res₀ : R₀ →ₐ[↥V] R₀₁) (res₁ : R₁ →ₐ[↥V] R₀₁)
    (h₀ eZ eY : R₀) (t₀ : R₁) (m₀ N' : ℕ)
    (f : Fin (N' + 1) → R₁) (f_Y f_Z : Fin (N' + 1) → R₀)
    (hh₀_ne : h₀ ≠ 0)
    (hInj_res₀ : Function.Injective res₀)
    (hInv : res₀ h₀ * res₁ t₀ = 1)
    (hLoc_sec : ∀ z : R₀₁, ∃ (p : ℕ) (a₀ : R₀), res₀ (h₀ ^ p) * z = res₀ a₀)
    (he_sum : eZ + eY = 1)
    (he_prod : eZ * eY ∈ Ideal.span ({h₀} : Set R₀))
    (hFree_quot : ∀ p : ℕ, 1 ≤ p → Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀ ^ p} : Set R₀)))
    (hm₀ : 1 ≤ m₀)
    (hN' : 1 ≤ N')
    (hf0 : f 0 = 1)
    (hfY0 : f_Y 0 = h₀ ^ m₀)
    (hfZ0 : f_Z 0 = eZ ^ m₀)
    (hfY_mem : ∀ a : Fin (N' + 1), f_Y a ∈ (Ideal.span ({h₀, eY} : Set R₀)) ^ m₀)
    (hfY_gl : ∀ a : Fin (N' + 1), res₀ (f_Y a) = res₀ (h₀ ^ m₀) * res₁ (f a))
    (hfZ_gl : ∀ a : Fin (N' + 1), f_Z a * h₀ ^ m₀ = eZ ^ m₀ * f_Y a)
    (hCech : ∀ r : ℕ, 1 ≤ r → ∀ z : R₀₁,
      ∃ x₀ ∈ (Ideal.span ({h₀, eY} : Set R₀)) ^ (r * m₀), ∃ x₁ : R₁,
        res₁ (t₀ ^ (r * m₀)) * res₀ x₀ - res₁ x₁ = z)
    (hVerBasis : ∀ r : ℕ, 1 ≤ r →
      ∃ (D_r : ℕ) (B_r : Fin D_r → MvPolynomial (Fin (N' + 1)) ↥V),
        (∀ i : Fin D_r, B_r i ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V r) ∧
        (∀ x₁ : R₁,
          (∃ x₀ ∈ (Ideal.span ({h₀, eY} : Set R₀)) ^ (r * m₀),
            res₀ x₀ = res₀ (h₀ ^ (r * m₀)) * res₁ x₁) ↔
            ∃ c : Fin D_r → ↥V, x₁ = ∑ i : Fin D_r, c i • MvPolynomial.aeval f (B_r i)) ∧
        (∀ c : Fin D_r → ↥V,
          (∑ i : Fin D_r, c i • MvPolynomial.aeval f (B_r i)) = 0 → ∀ i : Fin D_r, c i = 0))
    (F' : Type u) [Field F'] (ρ : ↥V →+* F')
    (R₀_s R₁_s R₀₁_s : Type u) [CommRing R₀_s] [CommRing R₁_s] [CommRing R₀₁_s]
    (α₀ : R₀ →+* R₀_s) (c₀ : F' →+* R₀_s)
    (α₁ : R₁ →+* R₁_s) (c₁ : F' →+* R₁_s)
    (α₀₁ : R₀₁ →+* R₀₁_s) (c₀₁ : F' →+* R₀₁_s)
    (res₀_s : R₀_s →+* R₀₁_s) (res₁_s : R₁_s →+* R₀₁_s)
    (hPush₀ : CategoryTheory.IsPushout
      (CommRingCat.ofHom (algebraMap ↥V R₀)) (CommRingCat.ofHom ρ)
      (CommRingCat.ofHom α₀) (CommRingCat.ofHom c₀))
    (hPush₁ : CategoryTheory.IsPushout
      (CommRingCat.ofHom (algebraMap ↥V R₁)) (CommRingCat.ofHom ρ)
      (CommRingCat.ofHom α₁) (CommRingCat.ofHom c₁))
    (hPush₀₁ : CategoryTheory.IsPushout
      (CommRingCat.ofHom (algebraMap ↥V R₀₁)) (CommRingCat.ofHom ρ)
      (CommRingCat.ofHom α₀₁) (CommRingCat.ofHom c₀₁))
    (hres₀_α : res₀_s.comp α₀ = α₀₁.comp res₀.toRingHom)
    (hres₀_c : res₀_s.comp c₀ = c₀₁)
    (hres₁_α : res₁_s.comp α₁ = α₀₁.comp res₁.toRingHom)
    (hres₁_c : res₁_s.comp c₁ = c₀₁) :
    (∀ p : ℕ, (α₀ h₀) ^ p ∈ nonZeroDivisors R₀_s) ∧
    (∀ (d : ℕ), 1 ≤ d →
      ∀ P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' d,
        MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P = 0 →
        ∃ (L : ℕ) (γ : Fin L → F') (Q : Fin L → MvPolynomial (Fin (N' + 1)) ↥V),
          (∀ l : Fin L, Q l ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V d) ∧
          (∀ l : Fin L, MvPolynomial.aeval f (Q l) = 0) ∧
          P = ∑ l : Fin L, MvPolynomial.C (γ l) * MvPolynomial.map ρ (Q l)) ∧
    (∀ (β₁ : R₁_s) (d₀ p₀ k : ℕ) (x₀ y₀ : R₀_s),
      1 ≤ d₀ →
      res₀_s ((α₀ h₀) ^ (d₀ * m₀)) * res₁_s β₁ = res₀_s x₀ →
      (α₀ h₀ * α₀ eZ) ^ k * ((α₀ eZ) ^ p₀ * x₀ - (α₀ h₀) ^ (d₀ * m₀) * y₀) = 0 →
      ∃ P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' d₀,
        β₁ = MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P) ∧
    (∀ (c_shift : F') (r₀ p d₀ q₁ q₂ : ℕ) (a₁ : R₁_s) (a₂ a₃ b₀ : R₀_s),
      1 ≤ r₀ → 1 ≤ d₀ →
      res₀_s ((α₀ h₀) ^ (d₀ * m₀)) * res₁_s a₁ = res₀_s b₀ →
      (α₀ h₀ * α₀ eZ * (α₀ (f_Z (1 : Fin (N' + 1))) - c₀ c_shift * (α₀ eZ) ^ m₀)) ^ q₁ *
        ((α₀ eZ) ^ (p + r₀ * m₀) * b₀ - (α₀ h₀) ^ (d₀ * m₀) * a₂) = 0 →
      (α₀ h₀ * α₀ eY * (α₀ (f_Y (1 : Fin (N' + 1))) - c₀ c_shift * (α₀ h₀) ^ m₀)) ^ q₂ *
        ((α₀ eY) ^ p * (α₀ h₀) ^ (r₀ * m₀) * b₀ - (α₀ h₀) ^ (d₀ * m₀) * a₃) = 0 →
      ∃ (q : ℕ) (P : MvPolynomial (Fin (N' + 1)) F'),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' (r₀ + q) ∧
        (α₁ (f (1 : Fin (N' + 1))) - c₁ c_shift) ^ q * a₁ =
          MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P) :=
by
  letI : Algebra ↥V F' := ρ.toAlgebra
  
  
  
  have hMkPushEquiv : ∀ {R R_s : Type u} [CommRing R] [Algebra ↥V R] [CommRing R_s]
      (α : R →+* R_s) (c : F' →+* R_s),
      CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap ↥V R)) (CommRingCat.ofHom ρ)
        (CommRingCat.ofHom α) (CommRingCat.ofHom c) →
      ∃ Θ : TensorProduct ↥V F' R ≃+* R_s,
        ∀ (s : F') (r : R), Θ (TensorProduct.tmul ↥V s r) = c s * α r := by
    intro R R_s _ _ _ α c hPush
    have hStd : CategoryTheory.IsPushout
        (CommRingCat.ofHom ρ)
        (CommRingCat.ofHom (algebraMap ↥V R))
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := ↥V) (A := F') (B := R)))
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := ↥V) (A := F') (B := R)).toRingHom) :=
      CommRingCat.isPushout_tensorProduct ↥V F' R
    let iso := CategoryTheory.IsPushout.isoIsPushout _ _ hStd hPush.flip
    let Θ : TensorProduct ↥V F' R ≃+* R_s := iso.commRingCatIsoToRingEquiv
    refine ⟨Θ, ?_⟩
    intro s r
    have hinl := CategoryTheory.IsPushout.inl_isoIsPushout_hom _ _ hStd hPush.flip
    have hinr := CategoryTheory.IsPushout.inr_isoIsPushout_hom _ _ hStd hPush.flip
    have hs : Θ (TensorProduct.tmul ↥V s (1 : R)) = c s :=
      congrFun (congrArg (fun φ => (φ.hom : _ → _)) hinl) s
    have hr : Θ (TensorProduct.tmul ↥V (1 : F') r) = α r :=
      congrFun (congrArg (fun φ => (φ.hom : _ → _)) hinr) r
    have hmul : (TensorProduct.tmul ↥V s (1 : R)) * (TensorProduct.tmul ↥V (1 : F') r) =
        TensorProduct.tmul ↥V s r := by
      simp
    rw [← hmul, map_mul, hs, hr]
  obtain ⟨Θ₀, hΘ₀⟩ := hMkPushEquiv α₀ c₀ hPush₀
  obtain ⟨Θ₁, hΘ₁⟩ := hMkPushEquiv α₁ c₁ hPush₁
  obtain ⟨Θ₀₁, hΘ₀₁⟩ := hMkPushEquiv α₀₁ c₀₁ hPush₀₁
  have hc₁_ρ : ∀ v : ↥V, c₁ (ρ v) = α₁ (algebraMap ↥V R₁ v) := by
    intro v
    have htmul : TensorProduct.tmul ↥V (ρ v) (1 : R₁) =
        TensorProduct.tmul ↥V (1 : F') (algebraMap ↥V R₁ v) := by
      have h1 : ρ v = v • (1 : F') := by
        rw [Algebra.smul_def, mul_one]; rfl
      have h2 : algebraMap ↥V R₁ v = v • (1 : R₁) := by
        rw [Algebra.smul_def, mul_one]
      rw [h1, h2, TensorProduct.smul_tmul]
    have := congrArg Θ₁ htmul
    rw [hΘ₁, hΘ₁, map_one, map_one, mul_one, one_mul] at this
    exact this
  have hEval_map : ∀ R : MvPolynomial (Fin (N' + 1)) ↥V,
      MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) (MvPolynomial.map ρ R) = α₁ (MvPolynomial.aeval f R) := by
    intro R
    rw [MvPolynomial.eval₂Hom_map_hom]
    have hcomp : c₁.comp ρ = α₁.comp (algebraMap ↥V R₁) := by
      ext v
      exact hc₁_ρ v
    rw [hcomp, MvPolynomial.aeval_def, ← MvPolynomial.coe_eval₂Hom, MvPolynomial.map_eval₂Hom]
    rfl
  have hres₀_α_app : ∀ x : R₀, res₀_s (α₀ x) = α₀₁ (res₀ x) := fun x =>
    congrFun (congrArg DFunLike.coe hres₀_α) x
  have hres₀_c_app : ∀ s : F', res₀_s (c₀ s) = c₀₁ s := fun s =>
    congrFun (congrArg DFunLike.coe hres₀_c) s
  have hres₁_α_app : ∀ x : R₁, res₁_s (α₁ x) = α₀₁ (res₁ x) := fun x =>
    congrFun (congrArg DFunLike.coe hres₁_α) x
  have hres₁_c_app : ∀ s : F', res₁_s (c₁ s) = c₀₁ s := fun s =>
    congrFun (congrArg DFunLike.coe hres₁_c) s
  have hNat₁ : ∀ w : TensorProduct ↥V F' R₁,
      res₁_s (Θ₁ w) = Θ₀₁ (LinearMap.lTensor F' res₁.toLinearMap w) := by
    intro w
    refine TensorProduct.inductionOn w (fun s r => ?_) (fun x y ihx ihy => ?_)
    · rw [LinearMap.lTensor_tmul, hΘ₁, hΘ₀₁, map_mul, hres₁_c_app, AlgHom.toLinearMap_apply,
        hres₁_α_app]
    · rw [map_add, map_add, ihx, ihy, map_add, map_add]
  
  
  
  have hClause1 : ∀ p : ℕ, (α₀ h₀) ^ p ∈ nonZeroDivisors R₀_s := by
    have hNzd1 : α₀ h₀ ∈ nonZeroDivisors R₀_s := by
      let J₁ : Ideal R₀ := Ideal.span ({h₀} : Set R₀)
      let μ₁ : R₀ →ₗ[↥V] R₀ := LinearMap.mulLeft ↥V h₀
      let π₁ : R₀ →ₗ[↥V] (R₀ ⧸ J₁) := (Ideal.Quotient.mkₐ ↥V J₁).toLinearMap
      have hFree₁ : Module.Free ↥V (R₀ ⧸ J₁) := by
        have h1 := hFree_quot 1 le_rfl
        rwa [pow_one] at h1
      have hFlat₁ : Module.Flat ↥V (R₀ ⧸ J₁) :=
        @Module.Flat.of_free ↥V (R₀ ⧸ J₁) _ _ _ hFree₁
      have hSurj_π₁ : Function.Surjective π₁ := Ideal.Quotient.mk_surjective
      have hInj_μ₁ : Function.Injective μ₁ := fun _ _ hxy =>
        mul_left_cancel₀ hh₀_ne hxy
      have hEx_μ₁ : Function.Exact μ₁ π₁ := by
        intro y
        change Ideal.Quotient.mk J₁ y = 0 ↔ y ∈ Set.range μ₁
        rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
        constructor
        · rintro ⟨c, rfl⟩; exact ⟨c, rfl⟩
        · rintro ⟨c, rfl⟩; exact ⟨c, rfl⟩
      have hInj_lμ₁ : Function.Injective (LinearMap.lTensor F' μ₁) :=
        @LinearMap.lTensor_injective_of_exact_of_flat ↥V _ R₀ _ _ R₀ (R₀ ⧸ J₁) _ _ _ _ hFlat₁
          π₁ hSurj_π₁ μ₁ hInj_μ₁ hEx_μ₁ F' _ _
      have hμ₁_Θ₀ : ∀ w : TensorProduct ↥V F' R₀,
          Θ₀ (LinearMap.lTensor F' μ₁ w) = α₀ h₀ * Θ₀ w := by
        intro w
        refine TensorProduct.inductionOn w (fun s r => ?_) (fun x y ihx ihy => ?_)
        · change Θ₀ (TensorProduct.tmul ↥V s (h₀ * r)) = α₀ h₀ * Θ₀ (TensorProduct.tmul ↥V s r)
          rw [hΘ₀, hΘ₀, map_mul]
          ring
        · rw [map_add, map_add, ihx, ihy, map_add, mul_add]
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      have h0 : Θ₀ (LinearMap.lTensor F' μ₁ (Θ₀.symm x)) = Θ₀ 0 := by
        rw [hμ₁_Θ₀, Θ₀.apply_symm_apply, mul_comm, hx, map_zero]
      have hw0 : Θ₀.symm x = 0 := hInj_lμ₁ (Θ₀.injective h0)
      calc
        x = Θ₀ (Θ₀.symm x) := (Θ₀.apply_symm_apply x).symm
        _ = 0 := by rw [hw0, map_zero]
    intro p
    exact Submonoid.pow_mem (nonZeroDivisors R₀_s) hNzd1 p
  
  
  
  let I_Z : Ideal R₀ := Ideal.span ({h₀, eY} : Set R₀)
  let I_Y' : Ideal R₀ := Ideal.span ({h₀, eZ} : Set R₀)
  have hIZ_sup_IY' : ∀ k : ℕ, I_Z ^ k ⊔ I_Y' ^ k = ⊤ := by
    have htop : I_Z ⊔ I_Y' = ⊤ := by
      rw [Ideal.eq_top_iff_one]
      have heY_mem : eY ∈ I_Z := Ideal.subset_span (by simp)
      have heZ_mem : eZ ∈ I_Y' := Ideal.subset_span (by simp)
      have hsum' : eY + eZ = 1 := by rw [add_comm, he_sum]
      rw [← hsum']
      exact Submodule.add_mem_sup heY_mem heZ_mem
    intro k
    exact Ideal.sup_pow_eq_top (Ideal.pow_sup_eq_top htop)
  have hIY'_mul_IZ : ∀ k : ℕ, I_Y' ^ k * I_Z ^ k ≤ Ideal.span ({h₀ ^ k} : Set R₀) := by
    have hprod1 : I_Y' * I_Z ≤ Ideal.span ({h₀} : Set R₀) := by
      dsimp [I_Y', I_Z]
      rw [Ideal.span_mul_span, Ideal.span_le]
      intro z hz
      rcases Set.mem_mul.mp hz with ⟨a, ha, b, hb, rfl⟩
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
      rcases ha with ha | ha <;> rcases hb with hb | hb
      · rw [ha, hb]; exact Ideal.mem_span_singleton.mpr ⟨h₀, rfl⟩
      · rw [ha, hb]; exact Ideal.mem_span_singleton.mpr ⟨eY, rfl⟩
      · rw [ha, hb]; exact Ideal.mem_span_singleton.mpr ⟨eZ, mul_comm _ _⟩
      · rw [ha, hb]; exact he_prod
    intro k
    calc
      I_Y' ^ k * I_Z ^ k = (I_Y' * I_Z) ^ k := (mul_pow I_Y' I_Z k).symm
      _ ≤ (Ideal.span ({h₀} : Set R₀)) ^ k := Ideal.pow_right_mono hprod1 k
      _ = Ideal.span ({h₀ ^ k} : Set R₀) := Ideal.span_singleton_pow h₀ k
  have hCancel_V : ∀ (p : ℕ), 1 ≤ p → ∀ (v : ↥V), v ≠ 0 → ∀ (r₀ : R₀),
      v • r₀ ∈ Ideal.span ({h₀ ^ p} : Set R₀) → r₀ ∈ Ideal.span ({h₀ ^ p} : Set R₀) := by
    intro p hp v hv r₀ hvr₀
    let J_p : Ideal R₀ := Ideal.span ({h₀ ^ p} : Set R₀)
    have hFree_p : Module.Free ↥V (R₀ ⧸ J_p) := hFree_quot p hp
    have hFlat_p : Module.Flat ↥V (R₀ ⧸ J_p) := @Module.Flat.of_free ↥V (R₀ ⧸ J_p) _ _ _ hFree_p
    let q₀ : R₀ ⧸ J_p := Ideal.Quotient.mk J_p r₀
    have hvq : v • q₀ = 0 := by
      have hmap : (Ideal.Quotient.mkₐ ↥V J_p) (v • r₀) = v • (Ideal.Quotient.mkₐ ↥V J_p r₀) :=
        map_smul (Ideal.Quotient.mkₐ ↥V J_p) v r₀
      change v • (Ideal.Quotient.mkₐ ↥V J_p r₀) = 0
      rw [← hmap]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hvr₀
    have hv_nzd : v ∈ nonZeroDivisors ↥V := mem_nonZeroDivisors_of_ne_zero hv
    have hq_tor : q₀ ∈ Submodule.torsion ↥V (R₀ ⧸ J_p) := by
      rw [Submodule.mem_torsion_iff]
      exact ⟨⟨v, hv_nzd⟩, hvq⟩
    have htor_bot : Submodule.torsion ↥V (R₀ ⧸ J_p) = ⊥ :=
      @Module.Flat.torsion_eq_bot ↥V (R₀ ⧸ J_p) _ _ _ hFlat_p
    rw [htor_bot, Submodule.mem_bot] at hq_tor
    exact Ideal.Quotient.eq_zero_iff_mem.mp hq_tor
  have hClause2 : ∀ (d : ℕ), 1 ≤ d →
      ∀ P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' d,
        MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P = 0 →
        ∃ (L : ℕ) (γ : Fin L → F') (Q : Fin L → MvPolynomial (Fin (N' + 1)) ↥V),
          (∀ l : Fin L, Q l ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V d) ∧
          (∀ l : Fin L, MvPolynomial.aeval f (Q l) = 0) ∧
          P = ∑ l : Fin L, MvPolynomial.C (γ l) * MvPolynomial.map ρ (Q l) := by
    intro d hd P hP_hom hevP
    let k : ℕ := d * m₀
    have hk_pos : 1 ≤ k := Nat.mul_pos hd hm₀
    let H_d : Submodule ↥V R₁ :=
      { carrier := {x₁ : R₁ | ∃ x₀ ∈ I_Z ^ k, res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁}
        zero_mem' := ⟨0, (I_Z ^ k).zero_mem, by simp⟩
        add_mem' := by
          rintro x₁ y₁ ⟨x₀, hx₀, hxgl⟩ ⟨y₀, hy₀, hygl⟩
          exact ⟨x₀ + y₀, (I_Z ^ k).add_mem hx₀ hy₀, by rw [map_add, map_add, hxgl, hygl, mul_add]⟩
        smul_mem' := by
          rintro v x₁ ⟨x₀, hx₀, hxgl⟩
          refine ⟨v • x₀, ?_, ?_⟩
          · rw [Algebra.smul_def]
            exact (I_Z ^ k).mul_mem_left _ hx₀
          · rw [map_smul, map_smul, hxgl, mul_smul_comm] }
    have hFlat_Hd : Module.Flat ↥V (R₁ ⧸ H_d) := by
      have _ : IsBezout ↥V := ValuationRing.instIsBezout
      rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
      intro q hq
      rw [Submodule.mem_bot]
      obtain ⟨x₁, rfl⟩ := Submodule.Quotient.mk_surjective H_d q
      rw [Submodule.mem_torsion_iff] at hq
      obtain ⟨⟨v, hv_nzd⟩, hv_eq⟩ := hq
      have hv_ne : v ≠ 0 := nonZeroDivisors.ne_zero hv_nzd
      have hvx₁ : v • x₁ ∈ H_d := by
        rw [← Submodule.Quotient.mk_eq_zero]
        exact hv_eq
      obtain ⟨y₀, hy₀_mem, hy₀_gl⟩ := hvx₁
      obtain ⟨p, a₀, hp_eq⟩ := hLoc_sec (res₁ x₁)
      rw [Submodule.Quotient.mk_eq_zero]
      rcases Nat.eq_zero_or_pos p with rfl | hp
      · simp only [pow_zero, map_one, one_mul] at hp_eq
        refine ⟨h₀ ^ k * a₀, ?_, ?_⟩
        · exact (I_Z ^ k).mul_mem_right a₀
            (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) k)
        · rw [map_mul, ← hp_eq]
      · have h_rel_R₀ : h₀ ^ p * y₀ = v • (h₀ ^ k * a₀) := by
          apply hInj_res₀
          calc
            res₀ (h₀ ^ p * y₀) = res₀ (h₀ ^ p) * res₀ y₀ := map_mul _ _ _
            _ = res₀ (h₀ ^ p) * (res₀ (h₀ ^ k) * res₁ (v • x₁)) := by rw [hy₀_gl]
            _ = v • (res₀ (h₀ ^ k) * (res₀ (h₀ ^ p) * res₁ x₁)) := by
              rw [map_smul, mul_smul_comm, mul_smul_comm, mul_left_comm]
            _ = v • (res₀ (h₀ ^ k) * res₀ a₀) := by rw [hp_eq]
            _ = res₀ (v • (h₀ ^ k * a₀)) := by rw [← map_mul, map_smul]
        have hv_mem_p : v • (h₀ ^ k * a₀) ∈ Ideal.span ({h₀ ^ p} : Set R₀) := by
          rw [← h_rel_R₀]
          exact Ideal.mem_span_singleton.mpr ⟨y₀, rfl⟩
        have hka_mem_p : h₀ ^ k * a₀ ∈ Ideal.span ({h₀ ^ p} : Set R₀) :=
          hCancel_V p hp v hv_ne (h₀ ^ k * a₀) hv_mem_p
        obtain ⟨x₀, hx₀_div⟩ := Ideal.mem_span_singleton.mp hka_mem_p
        have hy₀_eq : y₀ = v • x₀ := by
          apply mul_left_cancel₀ (pow_ne_zero p hh₀_ne)
          rw [h_rel_R₀, hx₀_div, mul_smul_comm]
        have hx₀_gl : res₀ x₀ = res₀ (h₀ ^ k) * res₁ x₁ := by
          have h_ap := congrArg res₀ hx₀_div
          rw [map_mul, map_mul, ← hp_eq] at h_ap
          have h_unit : res₀ (h₀ ^ p) * (res₁ t₀) ^ p = 1 := by
            rw [map_pow, ← mul_pow, hInv, one_pow]
          calc
            res₀ x₀ = (res₀ (h₀ ^ p) * res₀ x₀) * (res₁ t₀) ^ p := by
              rw [mul_right_comm, h_unit, one_mul]
            _ = (res₀ (h₀ ^ k) * (res₀ (h₀ ^ p) * res₁ x₁)) * (res₁ t₀) ^ p := by
              rw [← h_ap]
            _ = (res₀ (h₀ ^ k) * res₁ x₁) * (res₀ (h₀ ^ p) * (res₁ t₀) ^ p) := by ring
            _ = res₀ (h₀ ^ k) * res₁ x₁ := by rw [h_unit, mul_one]
        have hx₀_mem : x₀ ∈ I_Z ^ k := by
          have h1_top : (1 : R₀) ∈ I_Z ^ k ⊔ I_Y' ^ k := by
            rw [hIZ_sup_IY' k]; trivial
          obtain ⟨u_Z, hu_Z, u_Y', hu_Y', hu_sum⟩ := Submodule.mem_sup.mp h1_top
          let z₀ : R₀ := u_Y' * x₀
          have hvz₀ : v • z₀ ∈ Ideal.span ({h₀ ^ k} : Set R₀) := by
            have hvz₀_eq : v • z₀ = u_Y' * y₀ := by
              dsimp [z₀]
              rw [hy₀_eq, mul_smul_comm]
            rw [hvz₀_eq]
            exact hIY'_mul_IZ k (Submodule.mul_mem_mul hu_Y' hy₀_mem)
          have hz₀_span : z₀ ∈ Ideal.span ({h₀ ^ k} : Set R₀) :=
            hCancel_V k hk_pos v hv_ne z₀ hvz₀
          have hz₀_IZ : z₀ ∈ I_Z ^ k := by
            obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hz₀_span
            rw [hc]
            exact (I_Z ^ k).mul_mem_right c
              (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) k)
          have huZ_x₀ : u_Z * x₀ ∈ I_Z ^ k := (I_Z ^ k).mul_mem_right x₀ hu_Z
          have hx₀_sum : x₀ = u_Z * x₀ + z₀ := by
            calc
              x₀ = 1 * x₀ := (one_mul x₀).symm
              _ = (u_Z + u_Y') * x₀ := by rw [hu_sum]
              _ = u_Z * x₀ + z₀ := add_mul u_Z u_Y' x₀
          rw [hx₀_sum]
          exact (I_Z ^ k).add_mem huZ_x₀ hz₀_IZ
        exact ⟨x₀, hx₀_mem, hx₀_gl⟩
    obtain ⟨D_d, B_d, hB_hom, hB_span, hB_lin⟩ := hVerBasis d hd
    
    have hMon : ∀ β : Fin (N' + 1) →₀ ℕ, Finsupp.degree β = d →
        ∃ (m_β : Fin D_d → ↥V) (Q_β : MvPolynomial (Fin (N' + 1)) ↥V),
          Q_β ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V d ∧
          MvPolynomial.aeval f Q_β = 0 ∧
          MvPolynomial.monomial β (1 : ↥V) =
            Q_β + ∑ i : Fin D_d, MvPolynomial.C (m_β i) * B_d i := by
      intro β hdeg
      have hProd_S : ∀ S : Finset (Fin (N' + 1)),
          (∏ a ∈ S, f_Y a ^ β a) ∈ I_Z ^ ((∑ a ∈ S, β a) * m₀) ∧
          res₀ (∏ a ∈ S, f_Y a ^ β a) =
            res₀ (h₀ ^ ((∑ a ∈ S, β a) * m₀)) * res₁ (∏ a ∈ S, f a ^ β a) := by
        intro S
        induction S using Finset.induction_on with
        | empty =>
          simp [Ideal.one_eq_top]
        | @insert a s ha ih =>
          rw [Finset.prod_insert ha, Finset.prod_insert ha, Finset.sum_insert ha]
          refine ⟨?_, ?_⟩
          · have ha_mem : f_Y a ^ β a ∈ I_Z ^ (β a * m₀) := by
              have h1 : f_Y a ^ β a ∈ (I_Z ^ m₀) ^ β a := Ideal.pow_mem_pow (hfY_mem a) (β a)
              rwa [← pow_mul, mul_comm] at h1
            have hmul_mem := Submodule.mul_mem_mul ha_mem ih.1
            rwa [← pow_add, ← add_mul] at hmul_mem
          · have ha_gl : res₀ (f_Y a ^ β a) = res₀ (h₀ ^ (β a * m₀)) * res₁ (f a ^ β a) := by
              rw [map_pow, hfY_gl a, mul_pow, ← map_pow, ← pow_mul, mul_comm m₀ (β a), ← map_pow]
            rw [map_mul, map_mul, ha_gl, ih.2, add_mul, pow_add, map_mul]
            ring
      have hdeg_supp : ∑ a ∈ β.support, β a = d := by
        rw [← hdeg]
        rfl
      have haeval_mon_mem : MvPolynomial.aeval f (MvPolynomial.monomial β (1 : ↥V)) ∈ H_d := by
        obtain ⟨hS_mem, hS_gl⟩ := hProd_S β.support
        rw [hdeg_supp] at hS_mem hS_gl
        have haeval_eq : MvPolynomial.aeval f (MvPolynomial.monomial β (1 : ↥V)) =
            ∏ a ∈ β.support, f a ^ β a := by
          rw [MvPolynomial.aeval_monomial, map_one, one_mul]
          rfl
        rw [haeval_eq]
        exact ⟨∏ a ∈ β.support, f_Y a ^ β a, hS_mem, hS_gl⟩
      obtain ⟨m_β, hm_β⟩ := (hB_span _).mp haeval_mon_mem
      let Q_β : MvPolynomial (Fin (N' + 1)) ↥V :=
        MvPolynomial.monomial β (1 : ↥V) - ∑ i : Fin D_d, MvPolynomial.C (m_β i) * B_d i
      refine ⟨m_β, Q_β, ?_, ?_, ?_⟩
      · have hmon_hom : MvPolynomial.monomial β (1 : ↥V) ∈
            MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V d :=
          (MvPolynomial.mem_homogeneousSubmodule d _).mpr
            (MvPolynomial.isHomogeneous_monomial 1 hdeg)
        have hsum_hom : (∑ i : Fin D_d, MvPolynomial.C (m_β i) * B_d i) ∈
            MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) ↥V d := by
          refine Submodule.sum_mem _ fun i _ => ?_
          rw [← MvPolynomial.smul_eq_C_mul]
          exact Submodule.smul_mem _ (m_β i) (hB_hom i)
        exact Submodule.sub_mem _ hmon_hom hsum_hom
      · dsimp [Q_β]
        rw [map_sub, hm_β, map_sum]
        have hsum_eq : (∑ x : Fin D_d, (MvPolynomial.aeval f) (MvPolynomial.C (m_β x) * B_d x)) =
            ∑ i : Fin D_d, m_β i • (MvPolynomial.aeval f) (B_d i) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← MvPolynomial.smul_eq_C_mul, map_smul]
        rw [hsum_eq, sub_self]
      · dsimp [Q_β]
        exact (sub_add_cancel _ _).symm
    
    have hLinInd_F' : ∀ γ' : Fin D_d → F',
        (∑ i : Fin D_d, c₁ (γ' i) * α₁ (MvPolynomial.aeval f (B_d i))) = 0 →
        ∀ i : Fin D_d, γ' i = 0 := by
      let g_d : (Fin D_d → ↥V) →ₗ[↥V] R₁ :=
        { toFun := fun c => ∑ i : Fin D_d, c i • MvPolynomial.aeval f (B_d i)
          map_add' := fun c₁' c₂' => by
            simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
          map_smul' := fun v c => by
            simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
      have hInj_gd : Function.Injective g_d := by
        intro c₁' c₂' h_eq
        have hsub : g_d (c₁' - c₂') = 0 := by rw [map_sub, h_eq, sub_self]
        funext i
        have hi : c₁' i - c₂' i = 0 := hB_lin (c₁' - c₂') hsub i
        exact sub_eq_zero.mp hi
      have hSurj_mkQ : Function.Surjective H_d.mkQ := Submodule.Quotient.mk_surjective H_d
      have hEx_gd : Function.Exact g_d H_d.mkQ := by
        intro x₁
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        change (∃ x₀ ∈ (Ideal.span ({h₀, eY} : Set R₀)) ^ (d * m₀),
          res₀ x₀ = res₀ (h₀ ^ (d * m₀)) * res₁ x₁) ↔ x₁ ∈ Set.range g_d
        rw [hB_span x₁]
        constructor
        · rintro ⟨c, rfl⟩; exact ⟨c, rfl⟩
        · rintro ⟨c, rfl⟩; exact ⟨c, rfl⟩
      have hInj_lgd : Function.Injective (LinearMap.lTensor F' g_d) :=
        @LinearMap.lTensor_injective_of_exact_of_flat ↥V _ (Fin D_d → ↥V) _ _ R₁ (R₁ ⧸ H_d)
          _ _ _ _ hFlat_Hd H_d.mkQ hSurj_mkQ g_d hInj_gd hEx_gd F' _ _
      intro γ' hsum0 i₀
      let w : TensorProduct ↥V F' (Fin D_d → ↥V) :=
        ∑ i : Fin D_d, TensorProduct.tmul ↥V (γ' i) (Pi.single i (1 : ↥V))
      have hgd_single : ∀ i : Fin D_d, g_d (Pi.single i (1 : ↥V)) = MvPolynomial.aeval f (B_d i) := by
        intro i
        let e_i : Fin D_d → ↥V := Pi.single i (1 : ↥V)
        change ∑ j : Fin D_d, e_i j • MvPolynomial.aeval f (B_d j) = _
        rw [Finset.sum_eq_single i]
        · simp [e_i]
        · intro j _ hj; simp [e_i, Pi.single_eq_of_ne hj]
        · intro h; exact False.elim (h (Finset.mem_univ i))
      have hw_img0 : Θ₁ (LinearMap.lTensor F' g_d w) = Θ₁ 0 := by
        dsimp [w]
        rw [map_sum, map_sum, map_zero]
        have hcongr : (∑ i : Fin D_d,
            Θ₁ ((LinearMap.lTensor F' g_d) (TensorProduct.tmul ↥V (γ' i) (Pi.single i (1 : ↥V))))) =
            ∑ i : Fin D_d, c₁ (γ' i) * α₁ (MvPolynomial.aeval f (B_d i)) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [LinearMap.lTensor_tmul, hgd_single, hΘ₁]
        rw [hcongr, hsum0]
      have hw0 : w = 0 := hInj_lgd (Θ₁.injective hw_img0)
      let φ : TensorProduct ↥V F' (Fin D_d → ↥V) →ₗ[↥V] F' :=
        (TensorProduct.rid ↥V F').toLinearMap.comp (LinearMap.lTensor F' (LinearMap.proj i₀))
      have hφ0 : φ w = 0 := by rw [hw0, map_zero]
      have hφ_calc : φ w = γ' i₀ := by
        dsimp [φ, w]
        rw [map_sum, map_sum]
        simp only [LinearMap.lTensor_tmul, LinearMap.proj_apply, TensorProduct.rid_tmul]
        rw [Finset.sum_eq_single i₀]
        · simp
        · intro j _ hj; rw [Pi.single_eq_of_ne hj.symm, zero_smul]
        · intro h; exact False.elim (h (Finset.mem_univ i₀))
      rw [hφ_calc] at hφ0
      exact hφ0
    
    let L : ℕ := P.support.card
    let e : Fin L ≃ ↥P.support := P.support.equivFin.symm
    have hP_isHom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d P).mp hP_hom
    have hdeg_l : ∀ l : Fin L, Finsupp.degree (e l).1 = d := by
      intro l
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp (e l).2) (hP_isHom.coeff_eq_zero hne)
    choose m_l Q hQ_hom hQ_ker hQ_decomp using fun l : Fin L => hMon (e l).1 (hdeg_l l)
    let γ : Fin L → F' := fun l => P.coeff (e l).1
    have hP_expand : P =
        (∑ l : Fin L, MvPolynomial.C (γ l) * MvPolynomial.map ρ (Q l)) +
        ∑ i : Fin D_d,
          MvPolynomial.C (∑ l : Fin L, γ l * ρ (m_l l i)) * MvPolynomial.map ρ (B_d i) := by
      have h1 : P = ∑ l : Fin L, MvPolynomial.monomial (e l).1 (γ l) := by
        conv_lhs => rw [MvPolynomial.as_sum P]
        rw [← Finset.sum_attach P.support]
        exact (e.sum_comp (fun x : ↥P.support => MvPolynomial.monomial x.1 (P.coeff x.1))).symm
      have h2 : ∀ l : Fin L,
          MvPolynomial.monomial (e l).1 (γ l) =
            MvPolynomial.C (γ l) * MvPolynomial.map ρ (Q l) +
            ∑ i : Fin D_d, MvPolynomial.C (γ l * ρ (m_l l i)) * MvPolynomial.map ρ (B_d i) := by
        intro l
        have hm : MvPolynomial.monomial (e l).1 (γ l) =
            MvPolynomial.C (γ l) * MvPolynomial.map ρ (MvPolynomial.monomial (e l).1 (1 : ↥V)) := by
          rw [MvPolynomial.map_monomial, map_one, MvPolynomial.C_mul_monomial, mul_one]
        rw [hm, hQ_decomp l, map_add, map_sum, mul_add, Finset.mul_sum]
        congr 1
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, MvPolynomial.map_C, ← mul_assoc, ← map_mul]
      calc
        P = ∑ l : Fin L,
              (MvPolynomial.C (γ l) * MvPolynomial.map ρ (Q l) +
               ∑ i : Fin D_d, MvPolynomial.C (γ l * ρ (m_l l i)) * MvPolynomial.map ρ (B_d i)) := by
          rw [h1]
          exact Finset.sum_congr rfl fun l _ => h2 l
        _ = (∑ l : Fin L, MvPolynomial.C (γ l) * MvPolynomial.map ρ (Q l)) +
            ∑ l : Fin L, ∑ i : Fin D_d,
              MvPolynomial.C (γ l * ρ (m_l l i)) * MvPolynomial.map ρ (B_d i) :=
          Finset.sum_add_distrib
        _ = (∑ l : Fin L, MvPolynomial.C (γ l) * MvPolynomial.map ρ (Q l)) +
            ∑ i : Fin D_d,
              MvPolynomial.C (∑ l : Fin L, γ l * ρ (m_l l i)) * MvPolynomial.map ρ (B_d i) := by
          congr 1
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_sum, Finset.sum_mul]
    have hCoeff0 : ∀ i : Fin D_d, (∑ l : Fin L, γ l * ρ (m_l l i)) = 0 := by
      apply hLinInd_F'
      let ev := MvPolynomial.eval₂Hom c₁ (α₁ ∘ f)
      have hev_expand := congrArg ev hP_expand
      change ev P = _ at hev_expand
      rw [hevP, map_add, map_sum, map_sum] at hev_expand
      have hQ0 : (∑ x : Fin L, ev (MvPolynomial.C (γ x) * MvPolynomial.map ρ (Q x))) = 0 := by
        refine Finset.sum_eq_zero fun l _ => ?_
        rw [map_mul]
        change ev (MvPolynomial.C (γ l)) *
          MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) (MvPolynomial.map ρ (Q l)) = 0
        rw [hEval_map, hQ_ker l, map_zero, mul_zero]
      have hB_ev : (∑ x : Fin D_d,
          ev (MvPolynomial.C (∑ l : Fin L, γ l * ρ (m_l l x)) * MvPolynomial.map ρ (B_d x))) =
          ∑ i : Fin D_d,
            c₁ (∑ l : Fin L, γ l * ρ (m_l l i)) * α₁ (MvPolynomial.aeval f (B_d i)) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul]
        change MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) (MvPolynomial.C _) *
          MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) (MvPolynomial.map ρ (B_d i)) = _
        rw [MvPolynomial.eval₂Hom_C, hEval_map]
      rw [hQ0, zero_add, hB_ev] at hev_expand
      exact hev_expand.symm
    refine ⟨L, γ, Q, hQ_hom, hQ_ker, ?_⟩
    rw [hP_expand]
    have hRem0 : (∑ i : Fin D_d,
        MvPolynomial.C (∑ l : Fin L, γ l * ρ (m_l l i)) * MvPolynomial.map ρ (B_d i)) = 0 := by
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [hCoeff0 i, map_zero, zero_mul]
    rw [hRem0, add_zero]
  
  
  
  let h₀_s : R₀_s := α₀ h₀
  let eZ_s : R₀_s := α₀ eZ
  let eY_s : R₀_s := α₀ eY
  let t₀_s : R₁_s := α₁ t₀
  let I_Zs : Ideal R₀_s := Ideal.span ({h₀_s, eY_s} : Set R₀_s)
  have hInv_s : res₀_s h₀_s * res₁_s t₀_s = 1 := by
    have h_ap := congrArg α₀₁ hInv
    rw [map_mul, map_one, ← hres₀_α_app h₀, ← hres₁_α_app t₀] at h_ap
    exact h_ap
  have hMap_IZ_pow : ∀ k : ℕ, Ideal.map α₀ (I_Z ^ k) = I_Zs ^ k := by
    intro k
    dsimp [I_Z, I_Zs, h₀_s, eY_s]
    rw [Ideal.map_pow, Ideal.map_span, Set.image_pair]
  have hCechSpan : ∀ (r : ℕ), 1 ≤ r → ∀ (x₁ : R₁_s) (x₀ : R₀_s),
      x₀ ∈ I_Zs ^ (r * m₀) →
      res₀_s x₀ = res₀_s (h₀_s ^ (r * m₀)) * res₁_s x₁ →
      ∃ P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' r,
        x₁ = MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P := by
    intro r hr x₁ x₀ hx₀_mem hgl
    let k : ℕ := r * m₀
    let J : Ideal R₀ := I_Z ^ k
    let ι_J : ↥J →ₗ[↥V] R₀ := J.subtype.restrictScalars ↥V
    have hx₀_map : x₀ ∈ Ideal.map α₀ J := by
      dsimp [J, k]
      rw [hMap_IZ_pow (r * m₀)]
      exact hx₀_mem
    
    let J_lift : Ideal R₀_s :=
      { carrier := {y : R₀_s | ∃ w : TensorProduct ↥V F' ↥J,
          Θ₀ (LinearMap.lTensor F' ι_J w) = y}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by
          rintro y₁ y₂ ⟨w₁, rfl⟩ ⟨w₂, rfl⟩
          exact ⟨w₁ + w₂, by rw [map_add, map_add]⟩
        smul_mem' := by
          rintro z y ⟨w, rfl⟩
          suffices ∀ u : TensorProduct ↥V F' R₀,
              ∃ w' : TensorProduct ↥V F' ↥J,
                Θ₀ (LinearMap.lTensor F' ι_J w') =
                  Θ₀ u * Θ₀ (LinearMap.lTensor F' ι_J w) by
            obtain ⟨w', hw'⟩ := this (Θ₀.symm z)
            rw [Θ₀.apply_symm_apply] at hw'
            exact ⟨w', hw'⟩
          intro u
          refine TensorProduct.inductionOn u
            (fun s₁ r₀ => ?_)
            (fun u₁ u₂ ⟨w₁, hw₁⟩ ⟨w₂, hw₂⟩ =>
              ⟨w₁ + w₂, by rw [map_add, map_add, hw₁, hw₂, map_add, add_mul]⟩)
          refine TensorProduct.inductionOn w
            (fun s₂ j => ?_)
            (fun v₁ v₂ ⟨w₁, hw₁⟩ ⟨w₂, hw₂⟩ =>
              ⟨w₁ + w₂, by rw [map_add, map_add, hw₁, hw₂, map_add, map_add, mul_add]⟩)
          refine ⟨TensorProduct.tmul ↥V (s₁ * s₂) ⟨r₀ * j.1, J.mul_mem_left r₀ j.2⟩, ?_⟩
          change Θ₀ (TensorProduct.tmul ↥V (s₁ * s₂) (r₀ * j.1)) =
            Θ₀ (TensorProduct.tmul ↥V s₁ r₀) * Θ₀ (TensorProduct.tmul ↥V s₂ j.1)
          simp only [hΘ₀, map_mul]
          ring }
    have hMap_le_lift : Ideal.map α₀ J ≤ J_lift := by
      rw [Ideal.map_le_iff_le_comap]
      intro y hy
      refine ⟨TensorProduct.tmul ↥V (1 : F') ⟨y, hy⟩, ?_⟩
      change Θ₀ (TensorProduct.tmul ↥V (1 : F') y) = α₀ y
      simp only [hΘ₀, map_one, one_mul]
    obtain ⟨w₀, hw₀_eq⟩ := hMap_le_lift hx₀_map
    
    let δ : (↥J × R₁) →ₗ[↥V] R₀₁ :=
      { toFun := fun p => res₁ (t₀ ^ k) * res₀ (ι_J p.1) - res₁ p.2
        map_add' := fun p q => by
          simp only [Prod.fst_add, Prod.snd_add, map_add]
          ring
        map_smul' := fun v p => by
          simp only [Prod.smul_fst, Prod.smul_snd, map_smul,
            RingHom.id_apply, smul_sub, mul_smul_comm] }
    have hSurj_δ : Function.Surjective δ := by
      intro z
      obtain ⟨u₀, hu₀, u₁, heq⟩ := hCech r hr z
      exact ⟨(⟨u₀, hu₀⟩, u₁), heq⟩
    let K_δ : Submodule ↥V (↥J × R₁) := LinearMap.ker δ
    let ι_δ : ↥K_δ →ₗ[↥V] (↥J × R₁) := K_δ.subtype
    have hEx_δ : Function.Exact ι_δ δ := by
      intro p
      constructor
      · intro hp
        exact ⟨⟨p, hp⟩, rfl⟩
      · rintro ⟨⟨q, hq⟩, rfl⟩
        exact hq
    have hEx_lδ : Function.Exact (LinearMap.lTensor F' ι_δ) (LinearMap.lTensor F' δ) :=
      lTensor_exact F' hEx_δ hSurj_δ
    let w_pair : TensorProduct ↥V F' (↥J × R₁) :=
      LinearMap.lTensor F' (LinearMap.inl ↥V ↥J R₁) w₀ +
      LinearMap.lTensor F' (LinearMap.inr ↥V ↥J R₁) (Θ₁.symm x₁)
    have hδ_inl : ∀ w : TensorProduct ↥V F' ↥J,
        Θ₀₁ (LinearMap.lTensor F' (δ.comp (LinearMap.inl ↥V ↥J R₁)) w) =
          res₁_s (t₀_s ^ k) * res₀_s (Θ₀ (LinearMap.lTensor F' ι_J w)) := by
      intro w
      refine TensorProduct.inductionOn w (fun s j => ?_) (fun v₁ v₂ ih₁ ih₂ => ?_)
      · change Θ₀₁ (TensorProduct.tmul ↥V s (res₁ (t₀ ^ k) * res₀ j.1 - res₁ 0)) =
          res₁_s (t₀_s ^ k) * res₀_s (Θ₀ (TensorProduct.tmul ↥V s j.1))
        simp only [map_zero, sub_zero, hΘ₀₁, hΘ₀, map_mul, map_pow, ← hres₁_α_app t₀,
          ← hres₀_α_app j.1, hres₀_c_app]
        ring
      · rw [map_add, map_add, ih₁, ih₂, map_add, map_add, map_add, mul_add]
    have hδ_inr : δ.comp (LinearMap.inr ↥V ↥J R₁) = -res₁.toLinearMap := by
      ext u₁
      simp [δ]
    have hw_pair_ker : LinearMap.lTensor F' δ w_pair = 0 := by
      apply Θ₀₁.injective
      dsimp [w_pair]
      rw [map_add, ← LinearMap.lTensor_comp_apply, ← LinearMap.lTensor_comp_apply,
        map_add, hδ_inl, hw₀_eq, hδ_inr, LinearMap.lTensor_neg, LinearMap.neg_apply,
        map_neg, ← hNat₁, Θ₁.apply_symm_apply, map_zero, hgl]
      have h_unit_s : res₁_s (t₀_s ^ k) * res₀_s (h₀_s ^ k) = 1 := by
        rw [map_pow, map_pow, mul_comm, ← mul_pow, hInv_s, one_pow]
      calc
        res₁_s (t₀_s ^ k) * (res₀_s (h₀_s ^ k) * res₁_s x₁) + -res₁_s x₁
          = (res₁_s (t₀_s ^ k) * res₀_s (h₀_s ^ k)) * res₁_s x₁ - res₁_s x₁ := by ring
        _ = 0 := by rw [h_unit_s, one_mul, sub_self]
    obtain ⟨z_tilde, hz_tilde⟩ := (hEx_lδ w_pair).mp hw_pair_ker
    let π_snd : ↥K_δ →ₗ[↥V] R₁ := (LinearMap.snd ↥V ↥J R₁).comp ι_δ
    have hx₁_proj : Θ₁ (LinearMap.lTensor F' π_snd z_tilde) = x₁ := by
      dsimp [π_snd]
      rw [LinearMap.lTensor_comp_apply, hz_tilde]
      dsimp [w_pair]
      rw [map_add, ← LinearMap.lTensor_comp_apply, ← LinearMap.lTensor_comp_apply]
      have hsnd_inl : (LinearMap.snd ↥V ↥J R₁).comp (LinearMap.inl ↥V ↥J R₁) = 0 := by
        ext j; rfl
      have hsnd_inr : (LinearMap.snd ↥V ↥J R₁).comp (LinearMap.inr ↥V ↥J R₁) = LinearMap.id := by
        ext u₁; rfl
      rw [hsnd_inl, hsnd_inr, LinearMap.lTensor_zero, LinearMap.zero_apply, zero_add,
        LinearMap.lTensor_id, LinearMap.id_apply, Θ₁.apply_symm_apply]
    obtain ⟨D_r, B_r, hBr_hom, hBr_span, _⟩ := hVerBasis r hr
    have hKδ_span : ∀ z : ↥K_δ,
        ∃ c : Fin D_r → ↥V, z.1.2 = ∑ i : Fin D_r, c i • MvPolynomial.aeval f (B_r i) := by
      intro z
      have hz0 : res₁ (t₀ ^ k) * res₀ z.1.1.1 - res₁ z.1.2 = 0 := z.2
      have hz_eq : res₁ (t₀ ^ k) * res₀ z.1.1.1 = res₁ z.1.2 := sub_eq_zero.mp hz0
      have h_unit : res₀ (h₀ ^ k) * res₁ (t₀ ^ k) = 1 := by
        rw [map_pow, map_pow, ← mul_pow, hInv, one_pow]
      have hz_gl : res₀ z.1.1.1 = res₀ (h₀ ^ k) * res₁ z.1.2 := by
        calc
          res₀ z.1.1.1 = (res₀ (h₀ ^ k) * res₁ (t₀ ^ k)) * res₀ z.1.1.1 := by
            rw [h_unit, one_mul]
          _ = res₀ (h₀ ^ k) * (res₁ (t₀ ^ k) * res₀ z.1.1.1) := by ring
          _ = res₀ (h₀ ^ k) * res₁ z.1.2 := by rw [hz_eq]
      exact (hBr_span z.1.2).mp ⟨z.1.1.1, z.1.1.2, hz_gl⟩
    have hInd_z : ∀ w : TensorProduct ↥V F' ↥K_δ,
        ∃ P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' r,
          Θ₁ (LinearMap.lTensor F' π_snd w) = MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P := by
      intro w
      refine TensorProduct.inductionOn w
        (fun s z => ?_)
        (fun w₁ w₂ ⟨P₁, hP₁_hom, hP₁_eq⟩ ⟨P₂, hP₂_hom, hP₂_eq⟩ =>
          ⟨P₁ + P₂, Submodule.add_mem _ hP₁_hom hP₂_hom, by
            rw [map_add, map_add, map_add, hP₁_eq, hP₂_eq]⟩)
      obtain ⟨c, hc⟩ := hKδ_span z
      let P : MvPolynomial (Fin (N' + 1)) F' :=
        ∑ i : Fin D_r, MvPolynomial.C (s * ρ (c i)) * MvPolynomial.map ρ (B_r i)
      refine ⟨P, ?_, ?_⟩
      · refine Submodule.sum_mem _ fun i _ => ?_
        rw [← MvPolynomial.smul_eq_C_mul]
        apply Submodule.smul_mem
        rw [MvPolynomial.mem_homogeneousSubmodule]
        exact ((MvPolynomial.mem_homogeneousSubmodule r (B_r i)).mp (hBr_hom i)).map ρ
      · change Θ₁ (TensorProduct.tmul ↥V s z.1.2) =
          MvPolynomial.eval₂Hom c₁ (α₁ ∘ f)
            (∑ i : Fin D_r, MvPolynomial.C (s * ρ (c i)) * MvPolynomial.map ρ (B_r i))
        rw [hΘ₁, hc, map_sum, map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def, map_mul, ← hc₁_ρ (c i), map_mul]
        change c₁ s * (c₁ (ρ (c i)) * α₁ (MvPolynomial.aeval f (B_r i))) =
          MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) (MvPolynomial.C (s * ρ (c i))) *
            MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) (MvPolynomial.map ρ (B_r i))
        rw [MvPolynomial.eval₂Hom_C, hEval_map, map_mul, mul_assoc]
    obtain ⟨P, hP_hom, hP_eq⟩ := hInd_z z_tilde
    rw [hx₁_proj] at hP_eq
    exact ⟨P, hP_hom, hP_eq⟩
  
  
  
  have he_sum_s : eZ_s + eY_s = 1 := by
    dsimp [eZ_s, eY_s]
    rw [← map_add, he_sum, map_one]
  have hBezout_s : ∀ A B : ℕ, ∃ u u_Y : R₀_s, u * eZ_s ^ A + u_Y * eY_s ^ B = 1 := by
    have htop : Ideal.span ({eZ_s} : Set R₀_s) ⊔ Ideal.span ({eY_s} : Set R₀_s) = ⊤ := by
      rw [Ideal.eq_top_iff_one, ← he_sum_s]
      exact Submodule.add_mem_sup
        (Ideal.subset_span (Set.mem_singleton eZ_s))
        (Ideal.subset_span (Set.mem_singleton eY_s))
    intro A B
    have htop_AB : Ideal.span ({eZ_s ^ A} : Set R₀_s) ⊔ Ideal.span ({eY_s ^ B} : Set R₀_s) = ⊤ := by
      rw [← Ideal.span_singleton_pow, ← Ideal.span_singleton_pow]
      exact Ideal.sup_pow_eq_top (Ideal.pow_sup_eq_top htop)
    have h1_mem : (1 : R₀_s) ∈
        Ideal.span ({eZ_s ^ A} : Set R₀_s) ⊔ Ideal.span ({eY_s ^ B} : Set R₀_s) := by
      rw [htop_AB]; trivial
    obtain ⟨y₁, hy₁, y₂, hy₂, hy_sum⟩ := Submodule.mem_sup.mp h1_mem
    obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton.mp hy₁
    obtain ⟨u_Y, rfl⟩ := Ideal.mem_span_singleton.mp hy₂
    exact ⟨u, u_Y, by rw [← hy_sum]; ring⟩
  have hCancel_h₀s : ∀ (p : ℕ) (z : R₀_s), h₀_s ^ p * z = 0 → z = 0 := by
    intro p z hz
    have h_right : z * (α₀ h₀) ^ p = 0 := by
      dsimp [h₀_s] at hz
      rw [mul_comm]
      exact hz
    exact (mem_nonZeroDivisors_iff_right.mp (hClause1 p)) z h_right
  have hClause3 : ∀ (β₁ : R₁_s) (d₀ p₀ k : ℕ) (x₀ y₀ : R₀_s),
      1 ≤ d₀ →
      res₀_s (h₀_s ^ (d₀ * m₀)) * res₁_s β₁ = res₀_s x₀ →
      (h₀_s * eZ_s) ^ k * (eZ_s ^ p₀ * x₀ - h₀_s ^ (d₀ * m₀) * y₀) = 0 →
      ∃ P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' d₀,
        β₁ = MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P := by
    intro β₁ d₀ p₀ k x₀ y₀ hd₀ hgl hov
    have hov' : h₀_s ^ k * (eZ_s ^ k * (eZ_s ^ p₀ * x₀ - h₀_s ^ (d₀ * m₀) * y₀)) = 0 := by
      rw [← hov, mul_pow, mul_assoc]
    have hrel0 := hCancel_h₀s k _ hov'
    have heZ_x₀ : eZ_s ^ (k + p₀) * x₀ = h₀_s ^ (d₀ * m₀) * (eZ_s ^ k * y₀) := by
      have hsub : eZ_s ^ k * (eZ_s ^ p₀ * x₀) - eZ_s ^ k * (h₀_s ^ (d₀ * m₀) * y₀) = 0 := by
        rw [← mul_sub]; exact hrel0
      have heq := sub_eq_zero.mp hsub
      calc
        eZ_s ^ (k + p₀) * x₀ = eZ_s ^ k * (eZ_s ^ p₀ * x₀) := by rw [pow_add, mul_assoc]
        _ = eZ_s ^ k * (h₀_s ^ (d₀ * m₀) * y₀) := heq
        _ = h₀_s ^ (d₀ * m₀) * (eZ_s ^ k * y₀) := by ring
    obtain ⟨u, u_Y, hu_bez⟩ := hBezout_s (k + p₀) (d₀ * m₀)
    have hx₀_eq : x₀ = h₀_s ^ (d₀ * m₀) * (u * eZ_s ^ k * y₀) +
        eY_s ^ (d₀ * m₀) * (u_Y * x₀) := by
      calc
        x₀ = (u * eZ_s ^ (k + p₀) + u_Y * eY_s ^ (d₀ * m₀)) * x₀ := by
          rw [hu_bez, one_mul]
        _ = u * (eZ_s ^ (k + p₀) * x₀) + eY_s ^ (d₀ * m₀) * (u_Y * x₀) := by ring
        _ = h₀_s ^ (d₀ * m₀) * (u * eZ_s ^ k * y₀) + eY_s ^ (d₀ * m₀) * (u_Y * x₀) := by
          rw [heZ_x₀]; ring
    have hx₀_mem : x₀ ∈ I_Zs ^ (d₀ * m₀) := by
      rw [hx₀_eq]
      exact (I_Zs ^ (d₀ * m₀)).add_mem
        ((I_Zs ^ (d₀ * m₀)).mul_mem_right _
          (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) _))
        ((I_Zs ^ (d₀ * m₀)).mul_mem_right _
          (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) _))
    exact hCechSpan d₀ hd₀ β₁ x₀ hx₀_mem hgl.symm
  have hClause4 : ∀ (c_shift : F') (r₀ p d₀ q₁ q₂ : ℕ) (a₁ : R₁_s) (a₂ a₃ b₀ : R₀_s),
      1 ≤ r₀ → 1 ≤ d₀ →
      res₀_s (h₀_s ^ (d₀ * m₀)) * res₁_s a₁ = res₀_s b₀ →
      (h₀_s * eZ_s * (α₀ (f_Z (1 : Fin (N' + 1))) - c₀ c_shift * eZ_s ^ m₀)) ^ q₁ *
        (eZ_s ^ (p + r₀ * m₀) * b₀ - h₀_s ^ (d₀ * m₀) * a₂) = 0 →
      (h₀_s * eY_s * (α₀ (f_Y (1 : Fin (N' + 1))) - c₀ c_shift * h₀_s ^ m₀)) ^ q₂ *
        (eY_s ^ p * h₀_s ^ (r₀ * m₀) * b₀ - h₀_s ^ (d₀ * m₀) * a₃) = 0 →
      ∃ (q : ℕ) (P : MvPolynomial (Fin (N' + 1)) F'),
        P ∈ MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' (r₀ + q) ∧
        (α₁ (f (1 : Fin (N' + 1))) - c₁ c_shift) ^ q * a₁ =
          MvPolynomial.eval₂Hom c₁ (α₁ ∘ f) P := by
    intro c_shift r₀ p d₀ q₁ q₂ a₁ a₂ a₃ b₀ hr₀ hd₀ hb₀ hq₁ hq₂
    let g_c : R₁_s := α₁ (f (1 : Fin (N' + 1))) - c₁ c_shift
    let g'_Z : R₀_s := α₀ (f_Z (1 : Fin (N' + 1))) - c₀ c_shift * eZ_s ^ m₀
    let ĝ_Y : R₀_s := α₀ (f_Y (1 : Fin (N' + 1))) - c₀ c_shift * h₀_s ^ m₀
    have hĝY_mem : ĝ_Y ∈ I_Zs ^ m₀ := by
      have h1 : α₀ (f_Y (1 : Fin (N' + 1))) ∈ I_Zs ^ m₀ := by
        rw [← hMap_IZ_pow m₀]
        exact Ideal.mem_map_of_mem α₀ (hfY_mem (1 : Fin (N' + 1)))
      have h2 : c₀ c_shift * h₀_s ^ m₀ ∈ I_Zs ^ m₀ :=
        (I_Zs ^ m₀).mul_mem_left _
          (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) m₀)
      exact (I_Zs ^ m₀).sub_mem h1 h2
    have hgZ_mul : g'_Z * h₀_s ^ m₀ = eZ_s ^ m₀ * ĝ_Y := by
      have h_ap := congrArg α₀ (hfZ_gl (1 : Fin (N' + 1)))
      simp only [map_mul, map_pow] at h_ap
      dsimp [g'_Z, ĝ_Y, h₀_s, eZ_s]
      calc
        (α₀ (f_Z 1) - c₀ c_shift * (α₀ eZ) ^ m₀) * (α₀ h₀) ^ m₀
          = α₀ (f_Z 1) * (α₀ h₀) ^ m₀ - c₀ c_shift * (α₀ eZ) ^ m₀ * (α₀ h₀) ^ m₀ := by ring
        _ = (α₀ eZ) ^ m₀ * α₀ (f_Y 1) - c₀ c_shift * (α₀ eZ) ^ m₀ * (α₀ h₀) ^ m₀ := by
          rw [h_ap]
        _ = (α₀ eZ) ^ m₀ * (α₀ (f_Y 1) - c₀ c_shift * (α₀ h₀) ^ m₀) := by ring
    have hĝY_gl : res₀_s ĝ_Y = res₀_s (h₀_s ^ m₀) * res₁_s g_c := by
      have hf1 : res₀_s (α₀ (f_Y (1 : Fin (N' + 1)))) =
          res₀_s (h₀_s ^ m₀) * res₁_s (α₁ (f (1 : Fin (N' + 1)))) := by
        have h_ap := congrArg α₀₁ (hfY_gl (1 : Fin (N' + 1)))
        rw [map_mul, ← hres₀_α_app, ← hres₀_α_app, ← hres₁_α_app, map_pow] at h_ap
        exact h_ap
      have hc01 : res₀_s (c₀ c_shift) = res₁_s (c₁ c_shift) :=
        (hres₀_c_app c_shift).trans (hres₁_c_app c_shift).symm
      dsimp [ĝ_Y, g_c]
      rw [map_sub, map_sub, map_mul, hf1, hc01, map_pow]
      ring
    let q : ℕ := max q₁ q₂
    have hq₁_le : q₁ ≤ q := le_max_left q₁ q₂
    have hq₂_le : q₂ ≤ q := le_max_right q₁ q₂
    let N_Z : ℕ := q₁ + q₁ * m₀ + p + r₀ * m₀
    let N'_Y : ℕ := q₂ + p + r₀ * m₀
    let w_Z : R₀_s := ĝ_Y ^ (q - q₁) * eZ_s ^ q₁ * g'_Z ^ q₁ * h₀_s ^ ((r₀ + q₁) * m₀) * a₂
    let w'_Y : R₀_s := eY_s ^ (r₀ * m₀ + q₂) * ĝ_Y ^ q * a₃
    have hwZ_mem : w_Z ∈ I_Zs ^ ((r₀ + q) * m₀) := by
      have h_g : ĝ_Y ^ (q - q₁) ∈ I_Zs ^ ((q - q₁) * m₀) := by
        have h1 := Ideal.pow_mem_pow hĝY_mem (q - q₁)
        rwa [← pow_mul, mul_comm] at h1
      have h_h : h₀_s ^ ((r₀ + q₁) * m₀) ∈ I_Zs ^ ((r₀ + q₁) * m₀) :=
        Ideal.pow_mem_pow (Ideal.subset_span (by simp)) _
      have h_prod := Submodule.mul_mem_mul h_g h_h
      have hexp : (q - q₁) * m₀ + (r₀ + q₁) * m₀ = (r₀ + q) * m₀ := by
        rw [← add_mul]
        congr 1
        omega
      rw [← pow_add, hexp] at h_prod
      have hwZ_re : w_Z =
          (ĝ_Y ^ (q - q₁) * h₀_s ^ ((r₀ + q₁) * m₀)) * (eZ_s ^ q₁ * g'_Z ^ q₁ * a₂) := by
        dsimp [w_Z]; ring
      rw [hwZ_re]
      exact (I_Zs ^ ((r₀ + q) * m₀)).mul_mem_right _ h_prod
    have hw'Y_mem : w'_Y ∈ I_Zs ^ ((r₀ + q) * m₀) := by
      have h_e : eY_s ^ (r₀ * m₀) ∈ I_Zs ^ (r₀ * m₀) :=
        Ideal.pow_mem_pow (Ideal.subset_span (by simp)) _
      have h_g : ĝ_Y ^ q ∈ I_Zs ^ (q * m₀) := by
        have h1 := Ideal.pow_mem_pow hĝY_mem q
        rwa [← pow_mul, mul_comm] at h1
      have h_prod := Submodule.mul_mem_mul h_e h_g
      rw [← pow_add, ← add_mul] at h_prod
      have hwY_re : w'_Y = (eY_s ^ (r₀ * m₀) * ĝ_Y ^ q) * (eY_s ^ q₂ * a₃) := by
        dsimp [w'_Y]
        rw [pow_add]
        ring
      rw [hwY_re]
      exact (I_Zs ^ ((r₀ + q) * m₀)).mul_mem_right _ h_prod
    have hwZ_eq : h₀_s ^ (d₀ * m₀) * w_Z = eZ_s ^ N_Z * h₀_s ^ (r₀ * m₀) * ĝ_Y ^ q * b₀ := by
      have hq₁_re : h₀_s ^ q₁ *
          ((eZ_s * g'_Z) ^ q₁ * (eZ_s ^ (p + r₀ * m₀) * b₀ - h₀_s ^ (d₀ * m₀) * a₂)) = 0 := by
        change (h₀_s * eZ_s * g'_Z) ^ q₁ * _ = 0 at hq₁
        rw [← hq₁]
        simp only [mul_pow]
        ring
      have hrel₁ := sub_eq_zero.mp (by
        have h0 := hCancel_h₀s q₁ _ hq₁_re
        rw [mul_sub] at h0
        exact h0)
      have h_lhs : h₀_s ^ (d₀ * m₀) * w_Z =
          ĝ_Y ^ (q - q₁) * h₀_s ^ ((r₀ + q₁) * m₀) *
            (h₀_s ^ (d₀ * m₀) * ((eZ_s * g'_Z) ^ q₁ * a₂)) := by
        dsimp [w_Z]
        rw [mul_pow]
        ring
      have h_g_pow : ĝ_Y ^ (q - q₁) * ĝ_Y ^ q₁ = ĝ_Y ^ q := by
        rw [← pow_add, Nat.sub_add_cancel hq₁_le]
      have h_eZ_pow : eZ_s ^ q₁ * (eZ_s ^ m₀) ^ q₁ * eZ_s ^ (p + r₀ * m₀) = eZ_s ^ N_Z := by
        dsimp [N_Z]
        rw [← pow_mul, mul_comm m₀ q₁, ← pow_add, ← pow_add]
        congr 1
        omega
      rw [h_lhs, ← mul_left_comm ((eZ_s * g'_Z) ^ q₁) (h₀_s ^ (d₀ * m₀)) a₂, ← hrel₁]
      calc
        ĝ_Y ^ (q - q₁) * h₀_s ^ ((r₀ + q₁) * m₀) *
            ((eZ_s * g'_Z) ^ q₁ * (eZ_s ^ (p + r₀ * m₀) * b₀))
          = ĝ_Y ^ (q - q₁) * (g'_Z * h₀_s ^ m₀) ^ q₁ * eZ_s ^ q₁ *
              eZ_s ^ (p + r₀ * m₀) * h₀_s ^ (r₀ * m₀) * b₀ := by
            rw [add_mul, pow_add]
            simp only [mul_pow, ← pow_mul, mul_comm m₀ q₁]
            ring
        _ = (eZ_s ^ q₁ * (eZ_s ^ m₀) ^ q₁ * eZ_s ^ (p + r₀ * m₀)) *
              h₀_s ^ (r₀ * m₀) * (ĝ_Y ^ (q - q₁) * ĝ_Y ^ q₁) * b₀ := by
            rw [hgZ_mul, mul_pow]
            ring
        _ = eZ_s ^ N_Z * h₀_s ^ (r₀ * m₀) * ĝ_Y ^ q * b₀ := by
            rw [h_eZ_pow, h_g_pow]
    have hw'Y_eq : h₀_s ^ (d₀ * m₀) * w'_Y = eY_s ^ N'_Y * h₀_s ^ (r₀ * m₀) * ĝ_Y ^ q * b₀ := by
      have hq₂_re : h₀_s ^ q₂ *
          ((eY_s * ĝ_Y) ^ q₂ *
            (eY_s ^ p * h₀_s ^ (r₀ * m₀) * b₀ - h₀_s ^ (d₀ * m₀) * a₃)) = 0 := by
        change (h₀_s * eY_s * ĝ_Y) ^ q₂ * _ = 0 at hq₂
        rw [← hq₂]
        simp only [mul_pow]
        ring
      have hrel₂ := sub_eq_zero.mp (by
        have h0 := hCancel_h₀s q₂ _ hq₂_re
        rw [mul_sub] at h0
        exact h0)
      have h_g_pow : ĝ_Y ^ (q - q₂) * ĝ_Y ^ q₂ = ĝ_Y ^ q := by
        rw [← pow_add, Nat.sub_add_cancel hq₂_le]
      have h_lhs : h₀_s ^ (d₀ * m₀) * w'_Y =
          eY_s ^ (r₀ * m₀) * ĝ_Y ^ (q - q₂) * ((eY_s * ĝ_Y) ^ q₂ * (h₀_s ^ (d₀ * m₀) * a₃)) := by
        dsimp [w'_Y]
        rw [pow_add, ← h_g_pow, mul_pow]
        ring
      have h_eY_pow : eY_s ^ q₂ * eY_s ^ p * eY_s ^ (r₀ * m₀) = eY_s ^ N'_Y := by
        dsimp [N'_Y]
        rw [← pow_add, ← pow_add]
      rw [h_lhs, ← hrel₂]
      calc
        eY_s ^ (r₀ * m₀) * ĝ_Y ^ (q - q₂) *
            ((eY_s * ĝ_Y) ^ q₂ * (eY_s ^ p * h₀_s ^ (r₀ * m₀) * b₀))
          = (eY_s ^ q₂ * eY_s ^ p * eY_s ^ (r₀ * m₀)) *
              h₀_s ^ (r₀ * m₀) * (ĝ_Y ^ (q - q₂) * ĝ_Y ^ q₂) * b₀ := by
            rw [mul_pow]
            ring
        _ = eY_s ^ N'_Y * h₀_s ^ (r₀ * m₀) * ĝ_Y ^ q * b₀ := by
            rw [h_eY_pow, h_g_pow]
    obtain ⟨u, u_Y, hu_bez⟩ := hBezout_s N_Z N'_Y
    let x_tilde₀ : R₀_s := u * w_Z + u_Y * w'_Y
    have hx_tilde_mem : x_tilde₀ ∈ I_Zs ^ ((r₀ + q) * m₀) :=
      (I_Zs ^ ((r₀ + q) * m₀)).add_mem
        ((I_Zs ^ ((r₀ + q) * m₀)).mul_mem_left u hwZ_mem)
        ((I_Zs ^ ((r₀ + q) * m₀)).mul_mem_left u_Y hw'Y_mem)
    have hx_tilde_R₀ : h₀_s ^ (d₀ * m₀) * x_tilde₀ = h₀_s ^ (r₀ * m₀) * ĝ_Y ^ q * b₀ := by
      calc
        h₀_s ^ (d₀ * m₀) * (u * w_Z + u_Y * w'_Y)
          = u * (h₀_s ^ (d₀ * m₀) * w_Z) + u_Y * (h₀_s ^ (d₀ * m₀) * w'_Y) := by ring
        _ = (u * eZ_s ^ N_Z + u_Y * eY_s ^ N'_Y) * (h₀_s ^ (r₀ * m₀) * ĝ_Y ^ q * b₀) := by
          rw [hwZ_eq, hw'Y_eq]
          ring
        _ = h₀_s ^ (r₀ * m₀) * ĝ_Y ^ q * b₀ := by rw [hu_bez, one_mul]
    have hx_tilde_gl :
        res₀_s x_tilde₀ = res₀_s (h₀_s ^ ((r₀ + q) * m₀)) * res₁_s (g_c ^ q * a₁) := by
      have h_ap := congrArg res₀_s hx_tilde_R₀
      rw [map_mul, map_mul, map_mul, map_pow res₀_s ĝ_Y q, hĝY_gl, ← hb₀] at h_ap
      have h_rhs :
          res₀_s (h₀_s ^ (r₀ * m₀)) * (res₀_s (h₀_s ^ m₀) * res₁_s g_c) ^ q *
            (res₀_s (h₀_s ^ (d₀ * m₀)) * res₁_s a₁) =
          res₀_s (h₀_s ^ (d₀ * m₀)) *
            (res₀_s (h₀_s ^ ((r₀ + q) * m₀)) * res₁_s (g_c ^ q * a₁)) := by
        simp only [add_mul, pow_add, pow_mul, map_mul, map_pow, mul_pow]
        ring
      rw [h_rhs] at h_ap
      have h_unit_d : (res₁_s t₀_s) ^ (d₀ * m₀) * res₀_s (h₀_s ^ (d₀ * m₀)) = 1 := by
        rw [map_pow, mul_comm, ← mul_pow, hInv_s, one_pow]
      calc
        res₀_s x_tilde₀ =
            (res₁_s t₀_s) ^ (d₀ * m₀) * (res₀_s (h₀_s ^ (d₀ * m₀)) * res₀_s x_tilde₀) := by
          rw [← mul_assoc, h_unit_d, one_mul]
        _ = (res₁_s t₀_s) ^ (d₀ * m₀) *
              (res₀_s (h₀_s ^ (d₀ * m₀)) *
                (res₀_s (h₀_s ^ ((r₀ + q) * m₀)) * res₁_s (g_c ^ q * a₁))) := by
          rw [h_ap]
        _ = res₀_s (h₀_s ^ ((r₀ + q) * m₀)) * res₁_s (g_c ^ q * a₁) := by
          rw [← mul_assoc, h_unit_d, one_mul]
    obtain ⟨P, hP_hom, hP_eq⟩ :=
      hCechSpan (r₀ + q) (Nat.le_add_right_of_le hr₀) (g_c ^ q * a₁) x_tilde₀
        hx_tilde_mem hx_tilde_gl
    exact ⟨q, P, hP_hom, hP_eq⟩
  exact ⟨hClause1, hClause2, hClause3, hClause4⟩

theorem weil_sup1_affine_pullback_isPushout_and_basicOpen_inj : (∀ (B S : Type u) [CommRing B] [CommRing S]
      (X : AlgebraicGeometry.Scheme.{u})
      (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
      (s : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
      (U : X.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      let X_s := CategoryTheory.Limits.pullback p s
      let fst := CategoryTheory.Limits.pullback.fst p s
      let snd := CategoryTheory.Limits.pullback.snd p s
      let U_s : X_s.Opens := (TopologicalSpace.Opens.map fst.base).obj U
      let c_U : B →+* ↑(X.presheaf.obj (Opposite.op U)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ p.appLE ⊤ U le_top).hom
      let α_U : ↑(X.presheaf.obj (Opposite.op U)) →+* ↑(X_s.presheaf.obj (Opposite.op U_s)) :=
        (fst.appLE U U_s le_rfl).hom
      let β_U : S →+* ↑(X_s.presheaf.obj (Opposite.op U_s)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫ snd.appLE ⊤ U_s le_top).hom
      AlgebraicGeometry.IsAffineOpen U_s ∧
      CategoryTheory.IsPushout
        (CommRingCat.ofHom c_U) (AlgebraicGeometry.Spec.preimage s)
        (CommRingCat.ofHom α_U) (CommRingCat.ofHom β_U)) ∧
    (∀ (Y : AlgebraicGeometry.Scheme.{u}) (V₀_Y V₁_Y : Y.Opens),
      AlgebraicGeometry.IsAffineOpen V₀_Y →
      ∀ (h₀_Y : ↑(Y.presheaf.obj (Opposite.op V₀_Y))),
        Y.basicOpen h₀_Y = V₀_Y ⊓ V₁_Y →
        h₀_Y ∈ nonZeroDivisors ↑(Y.presheaf.obj (Opposite.op V₀_Y)) →
        (∀ (d₁ : ↑(Y.presheaf.obj (Opposite.op V₀_Y))) (W : Y.Opens),
          W = V₁_Y ⊔ Y.basicOpen d₁ →
          ∀ (h_le : V₁_Y ≤ W) (σ₁ σ₂ : ↑(Y.presheaf.obj (Opposite.op W))),
            (Y.presheaf.map (CategoryTheory.homOfLE h_le).op).hom σ₁ =
              (Y.presheaf.map (CategoryTheory.homOfLE h_le).op).hom σ₂ →
            σ₁ = σ₂) ∧
        (∀ (g₁ : ↑(Y.presheaf.obj (Opposite.op V₁_Y)))
           (d₁ d₂ : ↑(Y.presheaf.obj (Opposite.op V₀_Y))) (W : Y.Opens),
          W = Y.basicOpen g₁ ⊔ Y.basicOpen d₁ ⊔ Y.basicOpen d₂ →
          ∀ (h_le₀ : Y.basicOpen g₁ ≤ W),
            Y.basicOpen (h₀_Y * d₁) ≤ Y.basicOpen g₁ →
            Y.basicOpen (h₀_Y * d₂) ≤ Y.basicOpen g₁ →
            ∀ (σ₁ σ₂ : ↑(Y.presheaf.obj (Opposite.op W))),
              (Y.presheaf.map (CategoryTheory.homOfLE h_le₀).op).hom σ₁ =
                (Y.presheaf.map (CategoryTheory.homOfLE h_le₀).op).hom σ₂ →
              σ₁ = σ₂)) :=
by
  refine ⟨?_, ?_⟩
  · intro B S _ _ X p s U hU X_s fst snd U_s c_U α_U β_U
    have h_aff_fst : AlgebraicGeometry.IsAffineHom fst :=
      AlgebraicGeometry.isAffineHom_isStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback p s).flip
        (AlgebraicGeometry.isAffineHom_of_isAffine s)
    have hU_s : AlgebraicGeometry.IsAffineOpen U_s := hU.preimage fst
    refine ⟨hU_s, ?_⟩
    have hU_iso_from : hU.isoSpec.hom ≫ hU.fromSpec = U.ι := by
      rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom, AlgebraicGeometry.IsAffineOpen.toSpecΓ_fromSpec]
    have hUs_iso_from : hU_s.isoSpec.hom ≫ hU_s.fromSpec = U_s.ι := by
      rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom, AlgebraicGeometry.IsAffineOpen.toSpecΓ_fromSpec]
    let hTop_B : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens) :=
      AlgebraicGeometry.isAffineOpen_top _
    let hTop_S : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of S)).Opens) :=
      AlgebraicGeometry.isAffineOpen_top _
    have hc_Spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_U) = hU.fromSpec ≫ p := by
      have hc_hom : CommRingCat.ofHom c_U =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ p.appLE ⊤ U le_top :=
        CommRingCat.ofHom_hom _
      rw [hc_hom, AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Scheme.isoSpec_Spec_inv (CommRingCat.of B),
        ← AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p hTop_B hU le_top
    have hβ_Spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_U) = hU_s.fromSpec ≫ snd := by
      have hβ_hom : CommRingCat.ofHom β_U =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫ snd.appLE ⊤ U_s le_top :=
        CommRingCat.ofHom_hom _
      rw [hβ_hom, AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Scheme.isoSpec_Spec_inv (CommRingCat.of S),
        ← AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec snd hTop_S hU_s le_top
    have hα_Spec : (fst ∣_ U) ≫ hU.isoSpec.hom =
        hU_s.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) := by
      apply (CategoryTheory.cancel_mono hU.fromSpec).mp
      have hα_hom : CommRingCat.ofHom α_U = fst.appLE U U_s le_rfl :=
        CommRingCat.ofHom_hom _
      calc
        ((fst ∣_ U) ≫ hU.isoSpec.hom) ≫ hU.fromSpec
          = (fst ∣_ U) ≫ (hU.isoSpec.hom ≫ hU.fromSpec) := by
              rw [CategoryTheory.Category.assoc]
        _ = (fst ∣_ U) ≫ U.ι := by rw [hU_iso_from]
        _ = U_s.ι ≫ fst := AlgebraicGeometry.morphismRestrict_ι fst U
        _ = (hU_s.isoSpec.hom ≫ hU_s.fromSpec) ≫ fst := by rw [hUs_iso_from]
        _ = hU_s.isoSpec.hom ≫ (hU_s.fromSpec ≫ fst) := by
              rw [CategoryTheory.Category.assoc]
        _ = hU_s.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map (fst.appLE U U_s le_rfl) ≫ hU.fromSpec) := by
              rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec fst hU hU_s le_rfl]
        _ = (hU_s.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U)) ≫
              hU.fromSpec := by
              rw [hα_hom, CategoryTheory.Category.assoc]
    have hPb_res : CategoryTheory.IsPullback (fst ∣_ U) (U_s.ι ≫ snd) (U.ι ≫ p) s :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst U).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback p s)
    have hPb_target : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_U))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_U))
        (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage s)) := by
      refine hPb_res.of_iso hU_s.isoSpec hU.isoSpec
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) hα_Spec ?_ ?_ ?_
      · dsimp
        rw [CategoryTheory.Category.comp_id, hβ_Spec, ← CategoryTheory.Category.assoc, hUs_iso_from]
      · dsimp
        rw [CategoryTheory.Category.comp_id, hc_Spec, ← CategoryTheory.Category.assoc, hU_iso_from]
      · dsimp
        rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp,
          AlgebraicGeometry.Spec.map_preimage]
    let A : Type u := ↑(X.presheaf.obj (Opposite.op U))
    let ρ : B →+* S := (AlgebraicGeometry.Spec.preimage s).hom
    have hρ_hom : CommRingCat.ofHom ρ = AlgebraicGeometry.Spec.preimage s :=
      CommRingCat.ofHom_hom _
    let _ : Algebra B A := c_U.toAlgebra
    let _ : Algebra B S := ρ.toAlgebra
    let inl_tp : X.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of (TensorProduct B A S) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let inr_tp : CommRingCat.of S ⟶ CommRingCat.of (TensorProduct B A S) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    have hPush_tp : CategoryTheory.IsPushout
        (CommRingCat.ofHom c_U) (AlgebraicGeometry.Spec.preimage s) inl_tp inr_tp := by
      rw [← hρ_hom]
      exact CommRingCat.isPushout_tensorProduct B A S
    have hPb_tp : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_tp)
        (AlgebraicGeometry.Spec.map inr_tp)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_U))
        (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage s)) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ inl_tp inr_tp hPush_tp
    let e_Spec := CategoryTheory.IsPullback.isoIsPullback _ _ hPb_tp hPb_target
    have he_fst : e_Spec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) =
        AlgebraicGeometry.Spec.map inl_tp :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_tp hPb_target
    have he_snd : e_Spec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_U) =
        AlgebraicGeometry.Spec.map inr_tp :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_tp hPb_target
    let ψ_inv : CommRingCat.of (TensorProduct B A S) ⟶ X_s.presheaf.obj (Opposite.op U_s) :=
      AlgebraicGeometry.Spec.preimage e_Spec.inv
    let ψ_hom : X_s.presheaf.obj (Opposite.op U_s) ⟶ CommRingCat.of (TensorProduct B A S) :=
      AlgebraicGeometry.Spec.preimage e_Spec.hom
    have hψ_inv_hom : ψ_inv ≫ ψ_hom = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_Spec.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    have hψ_hom_inv : ψ_hom ≫ ψ_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_Spec.inv_hom_id, AlgebraicGeometry.Spec.map_id]
      rfl
    have hinl_ψ : inl_tp ≫ ψ_inv = CommRingCat.ofHom α_U := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        ← he_fst, CategoryTheory.Iso.inv_hom_id_assoc]
    have hinr_ψ : inr_tp ≫ ψ_inv = CommRingCat.ofHom β_U := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        ← he_snd, CategoryTheory.Iso.inv_hom_id_assoc]
    let e_ring : CommRingCat.of (TensorProduct B A S) ≅ X_s.presheaf.obj (Opposite.op U_s) :=
