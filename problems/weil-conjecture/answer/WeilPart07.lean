    have hι₀_eq : ∀ I : Simp 0, I = ι₀ (I.1 0) := by
      intro I; apply Subtype.ext; funext i; fin_cases i; rfl
    have himg_simp0 : ∀ I : Simp 0, Finset.univ.image I.1 = {I.1 0} := by
