      calc
        d₀ = d₀ * 1 := (mul_one d₀).symm
        _ = d₀ * (u + h₀_Y ^ N * v) := by rw [huv]
        _ = d₀ * u + v * (h₀_Y ^ N * d₀) := by ring
    rw [hd₀_eq]
    exact (RingHom.ker π_Z0 ⊔ RingHom.ker π'_0).add_mem
      (Ideal.mul_mem_left _ d₀ hu)
      (Ideal.mul_mem_left _ v hN_mem)
