      apply hz_ne_η
      rw [← hp₁_z, hp_eq, hp₀_η]
  have hPart3 : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K')) [AlgebraicGeometry.IsProper f]
      (E : Set ↥X), E ∈ irreducibleComponents ↥X →
      ∀ (η_E : ↥X), η_E ∈ E → closure ({η_E} : Set ↥X) = E →
      ∀ (V_sm : X.Opens), η_E ∈ V_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f) →
      ∀ (U_aff : X.Opens), AlgebraicGeometry.IsAffineOpen U_aff →
      (E \ (U_aff : Set ↥X)).Nonempty := by
    intro X f _ E hE η_E hη_mem hη_cl V_sm hη_V hSm U_aff hAff
    have hz_exists : ∃ z ∈ E, z ≠ η_E := by
      let g_sm : V_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of K') := V_sm.ι ≫ f
      let x_η : ↥V_sm.toScheme := ⟨η_E, hη_V⟩
      obtain ⟨U, _hU, V_z, hVz, hx_Vz, eUV, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 g_sm).mp hSm x_η
      have hU_top : U = ⊤ := by
        ext w
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hw₀ : g_sm.base x_η ∈ U := eUV hx_Vz
        have h_eq : w = g_sm.base x_η := by
          apply PrimeSpectrum.ext
          have h1 : w.asIdeal = ⊥ :=
            (Ideal.eq_bot_or_top w.asIdeal).resolve_right w.isPrime.ne_top
          have h2 : (g_sm.base x_η).asIdeal = ⊥ :=
            (Ideal.eq_bot_or_top (g_sm.base x_η).asIdeal).resolve_right (g_sm.base x_η).isPrime.ne_top
          exact h1.trans h2.symm
        exact h_eq ▸ hw₀
      subst hU_top
      let e_ring : K' ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K')).presheaf.obj (Opposite.op ⊤)) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).symm.commRingCatIsoToRingEquiv
      have hStd_K' : RingHom.IsStandardSmoothOfRelativeDimension 1
          ((g_sm.appLE ⊤ V_z eUV).hom.comp e_ring.toRingHom) :=
        (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).right
          (g_sm.appLE ⊤ V_z eUV).hom e_ring hStd
      obtain ⟨g_mv, _, hg_et⟩ := hStd_K'.exists_etale_mvPolynomial
      let S : Type u := ↑(V_sm.toScheme.presheaf.obj (Opposite.op V_z))
      let _ : Algebra (MvPolynomial (Fin 1) K') S := g_mv.toAlgebra
      let _ : Algebra K' S := (g_mv.comp MvPolynomial.C).toAlgebra
      have _ : IsScalarTower K' (MvPolynomial (Fin 1) K') S := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale (MvPolynomial (Fin 1) K') S := RingHom.etale_algebraMap.mp hg_et
      let q_η : PrimeSpectrum S := hVz.primeIdealOf ⟨x_η, hx_Vz⟩
      let φ_open : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ X := hVz.fromSpec ≫ V_sm.ι
      have _ : AlgebraicGeometry.IsOpenImmersion φ_open := inferInstance
      have hφ_open_emb : Topology.IsOpenEmbedding φ_open.base := φ_open.isOpenEmbedding
      have hφ_qη : φ_open.base q_η = η_E := by
        change V_sm.ι.base (hVz.fromSpec.base q_η) = η_E
        rw [hVz.fromSpec_primeIdealOf ⟨x_η, hx_Vz⟩]
        rfl
      have hp_bot : Ideal.under (MvPolynomial (Fin 1) K') q_η.asIdeal = ⊥ := by
        by_contra hp_ne
        have hbot_lt : (⊥ : Ideal (MvPolynomial (Fin 1) K')) <
            Ideal.under (MvPolynomial (Fin 1) K') q_η.asIdeal := bot_lt_iff_ne_bot.mpr hp_ne
        have _ : (⊥ : Ideal (MvPolynomial (Fin 1) K')).IsPrime :=
          ⟨bot_ne_top, fun {a b} hab => by
            rw [Ideal.mem_bot] at hab ⊢
            exact mul_eq_zero.mp hab⟩
        have _ : Module.Flat (MvPolynomial (Fin 1) K') S := inferInstance
        have _ : Algebra.HasGoingDown (MvPolynomial (Fin 1) K') S := Algebra.HasGoingDown.of_flat
        obtain ⟨q₀, hq₀_le, hq₀_prime, hq₀_lies⟩ :=
          Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt
