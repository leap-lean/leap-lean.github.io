    · obtain ⟨g_J, hg_J, p₀, hp₀, hJ_comp⟩ := hInsert (q + 2) I.1 I.2 haI
      let J : {J : Fin (q + 3) → Fin (N + 1) // StrictMono J} := ⟨g_J, hg_J⟩
      have hWJ_le : V_cov a ⊓ Finset.inf (Finset.univ.image I.1) V_cov ≤
          Finset.inf (Finset.univ.image J.1) V_cov :=
        hInf_le hp₀ hJ_comp
      have hcoc := congrArg
        ((Y.presheaf.map (CategoryTheory.homOfLE hWJ_le).op).hom) (hα J)
      rw [map_sum, map_zero] at hcoc
      have hcoc_split :
          (-1 : ℤ) ^ (p₀ : ℕ) •
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : V_cov a ⊓ Finset.inf (Finset.univ.image I.1) V_cov ≤
                Finset.inf (Finset.univ.image I.1) V_cov)).op).hom (α I) +
          ∑ r : Fin (q + 2),
            (-1 : ℤ) ^ (p₀.succAbove r : ℕ) •
              (Y.presheaf.map (CategoryTheory.homOfLE
                (hWJ_le.trans (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                  Finset.mem_image_of_mem J.1 (Finset.mem_univ ((p₀.succAbove r).succAbove t)))))).op).hom
                (α ⟨J.1 ∘ (p₀.succAbove r).succAbove,
