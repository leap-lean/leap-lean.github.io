by
  intro k₀ s₀ Y fst
  let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
  let snd := CategoryTheory.Limits.pullback.snd g_semi s₀
  have hAlgEq : algebraMap ↥V k₀ = (algebraMap (↥V ⧸ 𝔪_V) k₀).comp (Ideal.Quotient.mk 𝔪_V) :=
