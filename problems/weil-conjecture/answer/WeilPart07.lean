    let q_E := hW_Y.primeIdealOf ⟨η_E, hη_WY⟩
    have hqE_base : hW_Y.fromSpec.base q_E = η_E := hW_Y.fromSpec_primeIdealOf ⟨η_E, hη_WY⟩
    have hSpecLe : ∀ q' : ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op W_Y))),
        hW_Y.fromSpec.base q' ∈ E → q_E.asIdeal ≤ q'.asIdeal := by
      intro q' hq'E a ha
      have hqE_not : (q_E : PrimeSpectrum S) ∉ PrimeSpectrum.basicOpen a := by
        rw [PrimeSpectrum.mem_basicOpen]
        exact not_not.mpr ha
      have hη_not : η_E ∉ Y.basicOpen a := by
        intro hη_ba
        apply hqE_not
        have hmem_pre : q_E ∈ (TopologicalSpace.Opens.map hW_Y.fromSpec.base).obj (Y.basicOpen a) := by
          change hW_Y.fromSpec.base q_E ∈ Y.basicOpen a
          rwa [hqE_base]
        rwa [hW_Y.fromSpec_preimage_basicOpen a] at hmem_pre
      have hE_compl : E ⊆ (Y.basicOpen a : Set ↥Y)ᶜ := by
        rw [← hClosE]
        exact closure_minimal (Set.singleton_subset_iff.mpr hη_not) (Y.basicOpen a).isOpen.isClosed_compl
      have hq'_not : (⟨q'.asIdeal, q'.isPrime⟩ : PrimeSpectrum S) ∉ PrimeSpectrum.basicOpen a := by
        intro hq'_bo
        have hmem_pre : q' ∈ (TopologicalSpace.Opens.map hW_Y.fromSpec.base).obj (Y.basicOpen a) := by
          rw [hW_Y.fromSpec_preimage_basicOpen a]
          exact hq'_bo
        exact hE_compl hq'E hmem_pre
      rw [PrimeSpectrum.mem_basicOpen, not_not] at hq'_not
      exact hq'_not
    have hp_le_py : q_E.asIdeal ≤ p_y := by
      apply hSpecLe p_pt
      rw [hW_Y.fromSpec_primeIdealOf ⟨y, hy⟩]
      exact hyE
    have hp_min : q_E.asIdeal ∈ minimalPrimes S := by
      refine ⟨⟨q_E.isPrime, bot_le⟩, ?_⟩
      rintro r ⟨hr_prime, _⟩ hr_le
      let q_r : ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op W_Y))) := ⟨r, hr_prime⟩
      have hη_clos : η_E ∈ closure ({hW_Y.fromSpec.base q_r} : Set ↥Y) := by
        rw [mem_closure_iff]
        intro U_open hU_open hη_U
        have hPreOpen : IsOpen (hW_Y.fromSpec.base ⁻¹' U_open) :=
          hU_open.preimage hW_Y.fromSpec.continuous
        have hqE_pre : q_E ∈ hW_Y.fromSpec.base ⁻¹' U_open := by
          change hW_Y.fromSpec.base q_E ∈ U_open
          rwa [hqE_base]
        obtain ⟨V_b, ⟨U_b, ⟨b, rfl⟩, rfl⟩, hqE_Vb, hVb_sub⟩ :=
          PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open hqE_pre hPreOpen
        have hb_not_qE : b ∉ q_E.asIdeal := by
          change (q_E : PrimeSpectrum S) ∈ PrimeSpectrum.basicOpen b at hqE_Vb
          rwa [PrimeSpectrum.mem_basicOpen] at hqE_Vb
        have hb_not_r : b ∉ r := fun hbr => hb_not_qE (hr_le hbr)
        have hqr_Vb : (⟨r, hr_prime⟩ : PrimeSpectrum S) ∈ PrimeSpectrum.basicOpen b := by
          rwa [PrimeSpectrum.mem_basicOpen]
        exact ⟨hW_Y.fromSpec.base q_r, hVb_sub hqr_Vb, Set.mem_singleton _⟩
      have hE_sub : E ⊆ closure ({hW_Y.fromSpec.base q_r} : Set ↥Y) := by
        rw [← hClosE]
        exact closure_minimal (Set.singleton_subset_iff.mpr hη_clos) isClosed_closure
      have hClos_sub : closure ({hW_Y.fromSpec.base q_r} : Set ↥Y) ⊆ E :=
        hE.2 isIrreducible_singleton.closure hE_sub
      exact hSpecLe q_r (hClos_sub (subset_closure (Set.mem_singleton _)))
    exact ⟨η_E, q_E, hClosE, hη_mem, hqE_base, hp_min, hp_le_py⟩
  obtain ⟨η_Z, q_Z, hClosZ, _, hqZ_base, hpZ_min, hpZ_py⟩ := hCompMin Z hZ_comp hyΔ.1
  have hy_Y' : ∃ E' ∈ irreducibleComponents ↥Y, E' ≠ Z ∧ y ∈ E' := by
    have hy2 := hyΔ.2
    simp only [Y'_set, Set.mem_iUnion, Set.mem_sdiff, Set.mem_singleton_iff] at hy2
    rcases hy2 with ⟨E', ⟨hE'_comp, hE'_ne⟩, hyE'⟩
    exact ⟨E', hE'_comp, hE'_ne, hyE'⟩
  obtain ⟨E', hE'_comp, hE'_ne, hyE'⟩ := hy_Y'
  obtain ⟨η_E, q_E, hClosE, hηE_mem, hqE_base, hpE_min, hpE_py⟩ := hCompMin E' hE'_comp hyE'
  let p_Z : Ideal S := q_Z.asIdeal
  let p_E : Ideal S := q_E.asIdeal
  haveI : p_Z.IsPrime := q_Z.isPrime
  haveI : p_E.IsPrime := q_E.isPrime
  have hne_ZE : p_Z ≠ p_E := by
    intro heq
    have hq_eq : q_Z = q_E := PrimeSpectrum.ext heq
    have hη_eq : η_Z = η_E := by rw [← hqZ_base, hq_eq, hqE_base]
    apply hE'_ne
    rw [← hClosE, ← hη_eq, hClosZ]
  have hIS_pE : I_S ≤ p_E := by
    rw [hIS_eq]
    intro a ha
    rw [PrimeSpectrum.mem_vanishingIdeal] at ha
    apply ha q_E
    change hW_Y.fromSpec.base q_E ∈ Y'_set
    rw [hqE_base]
    exact Set.mem_biUnion ⟨hE'_comp, hE'_ne⟩ hηE_mem
  have hNot_IS_pZ : ¬ (I_S ≤ p_Z) := by
    intro hle
    have hqZ_zl : (q_Z : PrimeSpectrum S) ∈ PrimeSpectrum.zeroLocus (I_S : Set S) := hle
    rw [hIS_eq, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure] at hqZ_zl
    have hPreCl : IsClosed (hW_Y.fromSpec.base ⁻¹' Y'_set : Set (PrimeSpectrum S)) :=
      hClosedY'.preimage hW_Y.fromSpec.continuous
    rw [hPreCl.closure_eq] at hqZ_zl
    have hηZ_Y' : η_Z ∈ Y'_set := by
      rw [← hqZ_base]
      exact hqZ_zl
    simp only [Y'_set, Set.mem_iUnion, Set.mem_sdiff, Set.mem_singleton_iff] at hηZ_Y'
    rcases hηZ_Y' with ⟨E'', ⟨hE''_comp, hE''_ne⟩, hηZ_E''⟩
    have hZ_sub : Z ⊆ E'' := by
      rw [← hClosZ]
      exact closure_minimal (Set.singleton_subset_iff.mpr hηZ_E'')
        (isClosed_of_mem_irreducibleComponents E'' hE''_comp)
    have hE''_sub : E'' ⊆ Z := hZ_comp.2 hE''_comp.1 hZ_sub
    exact hE''_ne (Set.Subset.antisymm hE''_sub hZ_sub)
  obtain ⟨f, hf_not, hSm_fbar⟩ :=
    hPillar3 S I_S p_y p_Z p_E hRad_IS hIS_py hpZ_min hpE_min hne_ZE
      hpZ_py hpE_py hIS_pE hNot_IS_pZ B φ₁ φ₂ q_u hφ₁ hφ₂ hcomm_k₀ hpq
      (hx_mem_qu 0) (hx_mem_qu 1)
  exact hSmBridge q W_Y hW_Y hy f hf_not hSm_fbar

theorem weil_sup1_geom_fiber_reduced_sing_and_branch_smooth (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let sndY := CategoryTheory.Limits.pullback.snd g s₀
    let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
    let Δ : Set ↥Y := Z ∩ Y'_set
    (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
        (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      let X_s := CategoryTheory.Limits.pullback g s
      let snd_s := CategoryTheory.Limits.pullback.snd g s
      AlgebraicGeometry.IsReduced X_s ∧
      {y : ↥X_s | ¬ ∃ V_sm : X_s.Opens,
        y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ snd_s)}.Finite ∧
      (∀ E ∈ irreducibleComponents ↥X_s,
        (∃ η_E ∈ E, closure ({η_E} : Set ↥X_s) = E ∧
          ∃ V_sm : X_s.Opens,
            η_E ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ snd_s)) ∧
        ∀ U_aff : X_s.Opens, AlgebraicGeometry.IsAffineOpen U_aff →
          (E \ (U_aff : Set ↥X_s)).Nonempty)) ∧
    (∃ (Y'_sch : AlgebraicGeometry.Scheme.{u}) (ιY' : Y'_sch ⟶ Y),
      AlgebraicGeometry.IsClosedImmersion ιY' ∧
      AlgebraicGeometry.IsReduced Y'_sch ∧
      Set.range ιY'.base = Y'_set ∧
      ∀ q : ↥Y'_sch, ιY'.base q ∈ Δ →
        ∃ V_sm : Y'_sch.Opens,
          q ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ ιY' ≫ sndY)) :=
by
  constructor
  · intro K' _ _ s
    obtain ⟨⟨hRedEtale, hNodalRed⟩, hNodalLoc, _⟩ :=
      weil_nodal_etale_algebra_reduced_and_branch_ideals K'
    exact weil_sup1_geom_fiber_reduced_singFin_and_nonAffine K V C_K p_K n σ_K C g τ ι hSemi
      K' s (weil_etale_roof_relDimOne_smooth_descent K') hRedEtale hNodalRed hNodalLoc
  · let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    obtain ⟨⟨hRedEtale₀, _⟩, _, hNodalBranch₀⟩ :=
      weil_nodal_etale_algebra_reduced_and_branch_ideals k₀
    exact weil_sup1_complementary_subscheme_nodal_branch_smooth K m V hMaxNeBot hPkg
      C_K p_K n σ_K C g τ ι hSemi Z Z_sch ιZ hUnstab
      (weil_etale_roof_relDimOne_smooth_descent k₀) hRedEtale₀ hNodalBranch₀

theorem weil_sup1_valuation_flat_quotient_freeness_and_hensel_idempotent (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V) :
    (∀ (R : Type u) [CommRing R] [Algebra ↥V R],
      Module.Flat ↥V R →
      Algebra.FinitePresentation ↥V R →
      ∀ (x : R), (Polynomial.aeval (R := ↥V) x).toRingHom.Finite →
      ∀ (P : Polynomial ↥V), P.Monic →
      (let I_m : Ideal R := Ideal.map (algebraMap ↥V R) (IsLocalRing.maximalIdeal ↥V)
       let q_m : R →+* R ⧸ I_m := Ideal.Quotient.mk I_m
       ∀ b : R ⧸ I_m, q_m (Polynomial.aeval x P) * b = 0 → b = 0) →
      Module.Free ↥V (R ⧸ Ideal.span ({Polynomial.aeval x P} : Set R)) ∧
      Module.Finite ↥V (R ⧸ Ideal.span ({Polynomial.aeval x P} : Set R))) ∧
    (∀ (R₀ : Type u) [CommRing R₀] [Algebra ↥V R₀] (h₀ u₀ : R₀),
      Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀} : Set R₀)) →
      Module.Finite ↥V (R₀ ⧸ Ideal.span ({h₀} : Set R₀)) →
      (let I_mh : Ideal R₀ :=
         Ideal.map (algebraMap ↥V R₀) (IsLocalRing.maximalIdeal ↥V) ⊔ Ideal.span ({h₀} : Set R₀)
       let π_bar : R₀ →+* R₀ ⧸ I_mh := Ideal.Quotient.mk I_mh
       π_bar u₀ * π_bar u₀ = π_bar u₀) →
      ∃ eZ eY : R₀,
        eZ + eY = 1 ∧
        eZ * eY ∈ Ideal.span ({h₀} : Set R₀) ∧
        (let I_mh : Ideal R₀ :=
           Ideal.map (algebraMap ↥V R₀) (IsLocalRing.maximalIdeal ↥V) ⊔ Ideal.span ({h₀} : Set R₀)
         Ideal.Quotient.mk I_mh eZ = Ideal.Quotient.mk I_mh u₀ ∧
         Ideal.Quotient.mk I_mh eY = 1 - Ideal.Quotient.mk I_mh u₀) ∧
        Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀, eY} : Set R₀)) ∧
        Module.Finite ↥V (R₀ ⧸ Ideal.span ({h₀, eY} : Set R₀)) ∧
        Module.Free ↥V (R₀ ⧸ Ideal.span ({h₀, eZ} : Set R₀)) ∧
        Module.Finite ↥V (R₀ ⧸ Ideal.span ({h₀, eZ} : Set R₀))) :=
by
  refine ⟨?_, ?_⟩
  · 
    intro R _ _ hFlat hFP x hFin P hMonic hReg
    let f : R := Polynomial.aeval x P
    let I_f : Ideal R := Ideal.span ({f} : Set R)
    let M : Type u := R ⧸ I_f
    let q_M : R →+* M := Ideal.Quotient.mk I_f
    have hqM_smul : ∀ (c : ↥V) (y : R), q_M (c • y) = c • q_M y :=
      fun c y => map_smul (Ideal.Quotient.mkₐ ↥V I_f) c y
    have hFinM : Module.Finite ↥V M := by
      let algX : Algebra (Polynomial ↥V) R := (Polynomial.aeval (R := ↥V) x).toRingHom.toAlgebra
      obtain ⟨S_R, hS_R⟩ := @Module.Finite.fg_top (Polynomial ↥V) R _ _ algX.toModule hFin
      let _ : DecidableEq M := Classical.decEq M
      let B_gen : Finset M :=
        S_R.biUnion (fun s => (Finset.range P.natDegree).image (fun k => q_M (x ^ k * s)))
      have hModSum : ∀ Q : Polynomial ↥V,
          Q %ₘ P = ∑ k ∈ Finset.range P.natDegree,
            Polynomial.C ((Q %ₘ P).coeff k) * Polynomial.X ^ k := by
        intro Q
        by_cases hP1 : P = 1
        · subst hP1
          simp [Polynomial.modByMonic_one]
        · have hlt : (Q %ₘ P).natDegree < P.natDegree :=
            Polynomial.natDegree_modByMonic_lt Q hMonic hP1
          conv_lhs => rw [Polynomial.as_sum_range' (Q %ₘ P) P.natDegree hlt]
          refine Finset.sum_congr rfl (fun k _ => ?_)
          rw [Polynomial.C_mul_X_pow_eq_monomial]
      have hTermMem : ∀ (Q : Polynomial ↥V) (s : R), s ∈ S_R →
          q_M (Polynomial.aeval x Q * s) ∈ Submodule.span ↥V (↑B_gen : Set M) := by
        intro Q s hs
        have hDiv : Q %ₘ P + P * (Q /ₘ P) = Q := Polynomial.modByMonic_add_div Q P
        have hAeval : Polynomial.aeval x Q =
            Polynomial.aeval x (Q %ₘ P) + f * Polynomial.aeval x (Q /ₘ P) := by
          conv_lhs => rw [← hDiv]
          simp [f, map_add, map_mul]
        have hqM_eq : q_M (Polynomial.aeval x Q * s) = q_M (Polynomial.aeval x (Q %ₘ P) * s) := by
          have h1 : f * (Polynomial.aeval x (Q /ₘ P) * s) ∈ I_f :=
            I_f.mul_mem_right _ (Ideal.subset_span (Set.mem_singleton f))
          rw [hAeval, add_mul, map_add, mul_assoc, Ideal.Quotient.eq_zero_iff_mem.mpr h1, add_zero]
        rw [hqM_eq, hModSum Q, map_sum, Finset.sum_mul, map_sum]
        refine Submodule.sum_mem _ (fun k hk => ?_)
        have h_term : q_M (Polynomial.aeval x (Polynomial.C ((Q %ₘ P).coeff k) * Polynomial.X ^ k) * s) =
            ((Q %ₘ P).coeff k) • q_M (x ^ k * s) := by
          rw [Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow, mul_assoc,
            ← Algebra.smul_def, hqM_smul]
        rw [h_term]
        refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
        exact Finset.mem_biUnion.mpr ⟨s, hs, Finset.mem_image.mpr ⟨k, hk, rfl⟩⟩
      have hTopLe : (⊤ : Submodule ↥V M) ≤ Submodule.span ↥V (↑B_gen : Set M) := by
        intro m_el _
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective m_el
        have hr_mem : r ∈ @Submodule.span (Polynomial ↥V) R _ _ algX.toModule (↑S_R : Set R) := by
          rw [hS_R]; trivial
        obtain ⟨g, _, hg_eq⟩ :=
          (@Submodule.mem_span_finset (Polynomial ↥V) R _ _ algX.toModule S_R r).mp hr_mem
        have hr_sum : ∑ s ∈ S_R, Polynomial.aeval x (g s) * s = r := hg_eq
        change q_M r ∈ Submodule.span ↥V (↑B_gen : Set M)
        rw [← hr_sum, map_sum]
        exact Submodule.sum_mem _ (fun s hs => hTermMem (g s) s hs)
      exact ⟨⟨B_gen, le_antisymm le_top hTopLe⟩⟩
    have _ : Module.Finite ↥V M := hFinM
    have hIf_fg : I_f.FG := ⟨{f}, by simp [I_f]⟩
    have _ : Algebra.FinitePresentation ↥V M :=
      Algebra.FinitePresentation.quotient hIf_fg
    have _ : Module.FinitePresentation ↥V M :=
      Module.FinitePresentation.of_finite_of_finitePresentation ↥V M
    let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
    have hTorsBot : Submodule.torsion ↥V R = ⊥ :=
      (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout (R := ↥V) (M := R)).mp hFlat
    have hCancelV : ∀ {c : ↥V} {r₁ r₂ : R}, c ≠ 0 → c • r₁ = c • r₂ → r₁ = r₂ := by
      intro c r₁ r₂ hc h_eq
      have h_sub : (⟨c, mem_nonZeroDivisors_of_ne_zero hc⟩ : nonZeroDivisors ↥V) • (r₁ - r₂) = 0 := by
        change c • (r₁ - r₂) = 0
        rw [smul_sub, h_eq, sub_self]
      have h_mem : r₁ - r₂ ∈ Submodule.torsion ↥V R :=
        (Submodule.mem_torsion_iff (r₁ - r₂)).mpr ⟨⟨c, mem_nonZeroDivisors_of_ne_zero hc⟩, h_sub⟩
      rw [hTorsBot, Submodule.mem_bot] at h_mem
      exact sub_eq_zero.mp h_mem
    have hPure : ∀ z : TensorProduct ↥V ↥𝔪_V M, ∃ (π₀ : ↥𝔪_V) (m_el : M), z = π₀ ⊗ₜ[↥V] m_el := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, by simp⟩
      | tmul π m_el => exact ⟨π, m_el, rfl⟩
      | add z₁ z₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨π₁, m₁, rfl⟩
        rcases ih₂ with ⟨π₂, m₂, rfl⟩
        rcases ValuationRing.dvd_total π₁.1 π₂.1 with ⟨c, hc⟩ | ⟨c, hc⟩
        · have hπ₂ : π₂ = c • π₁ := Subtype.ext (by change π₂.1 = c * π₁.1; rw [hc, mul_comm])
          refine ⟨π₁, m₁ + c • m₂, ?_⟩
          rw [hπ₂, TensorProduct.smul_tmul, TensorProduct.tmul_add]
        · have hπ₁ : π₁ = c • π₂ := Subtype.ext (by change π₁.1 = c * π₂.1; rw [hc, mul_comm])
          refine ⟨π₂, c • m₁ + m₂, ?_⟩
          rw [hπ₁, TensorProduct.smul_tmul, TensorProduct.tmul_add]
    let I_m : Ideal R := Ideal.map (algebraMap ↥V R) 𝔪_V
    have hIm_single : ∀ {y : R}, y ∈ I_m → ∃ (μ₀ : ↥𝔪_V) (s : R), y = μ₀.1 • s := by
      intro y hy
      change y ∈ Ideal.span (algebraMap ↥V R '' (𝔪_V : Set ↥V)) at hy
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
      · rintro y ⟨μ, hμ, rfl⟩
        exact ⟨⟨μ, hμ⟩, 1, by simp [Algebra.smul_def]⟩
      · exact ⟨0, 0, by simp⟩
      · rintro y₁ y₂ _ _ ⟨μ₁, s₁, rfl⟩ ⟨μ₂, s₂, rfl⟩
        rcases ValuationRing.dvd_total μ₁.1 μ₂.1 with ⟨c, hc⟩ | ⟨c, hc⟩
        · exact ⟨μ₁, s₁ + c • s₂, by rw [hc, mul_smul, smul_add]⟩
        · exact ⟨μ₂, c • s₁ + s₂, by rw [hc, mul_smul, smul_add]⟩
      · rintro a y _ ⟨μ₀, s, rfl⟩
        refine ⟨μ₀, a * s, ?_⟩
        simp only [smul_eq_mul, Algebra.smul_def]
        ring
    have hInj : Function.Injective (LinearMap.rTensor M 𝔪_V.subtype) := by
