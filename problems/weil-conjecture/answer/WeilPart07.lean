    let e_inf := (AlgebraicGeometry.isPullback_opens_inf U₁ U₂).isoPullback
    exact @AlgebraicGeometry.isAffine_of_isAffineHom _ _ e_inf.hom inferInstance inferInstance

  
  have hPart2 : ∀ (U : C_semi.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map fst.base).obj U) ∧
      Function.Surjective (fst.app U).hom ∧
      ∀ s : ↑(C_semi.presheaf.obj (Opposite.op U)),
        (fst.app U).hom s = 0 ↔
          ∃ (π : ↥V) (w : ↑(C_semi.presheaf.obj (Opposite.op U))),
            π ∈ IsLocalRing.maximalIdeal ↥V ∧
            s = (g_semi.appTop ≫
              C_semi.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom π) * w := by
    intro U hU
    have hAff_UY : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map fst.base).obj U) :=
      AlgebraicGeometry.IsAffineHom.isAffine_preimage U hU
    have hSurj_U : Function.Surjective (fst.app U).hom :=
      (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCl_fst).2 U hU
    refine ⟨hAff_UY, hSurj_U, ?_⟩
    let R := CommRingCat.of ↥V
    let A := C_semi.presheaf.obj (Opposite.op U)
    let U_Y : Y.Opens := (TopologicalSpace.Opens.map fst.base).obj U
    let c_U : R ⟶ A :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫
        g_semi.appTop ≫
        C_semi.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op
    have hFromSpec : hU.fromSpec ≫ g_semi = AlgebraicGeometry.Spec.map c_U := by
      have h1 : g_semi = g_semi ≫ (AlgebraicGeometry.Spec R).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv := by
        rw [AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, CategoryTheory.Category.comp_id]
      calc
        hU.fromSpec ≫ g_semi
          = hU.fromSpec ≫ g_semi ≫ (AlgebraicGeometry.Spec R).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv := by
            conv_lhs => rw [h1]
        _ = hU.fromSpec ≫ C_semi.toSpecΓ ≫
              AlgebraicGeometry.Spec.map g_semi.appTop ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv := by
            rw [AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc]
        _ = AlgebraicGeometry.Spec.map (C_semi.presheaf.map (CategoryTheory.homOfLE le_top).op) ≫
