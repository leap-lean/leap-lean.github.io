theorem weil_sup1_geom_fiber_reduced_singFin_and_nonAffine (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (K' : Type u) [Field K'] [IsAlgClosed K']
    (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)) :
    let A_nod : Type u :=
      MvPolynomial (Fin 2) K' ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) K'))
    let c_nod : K' →+* A_nod := (Ideal.Quotient.mk _).comp MvPolynomial.C
    let X_s := CategoryTheory.Limits.pullback g s
    let snd_s := CategoryTheory.Limits.pullback.snd g s
    (∀ (S₀ : Type u) [CommRing S₀] [Algebra K' S₀] [Algebra.FinitePresentation K' S₀]
        (p : Ideal S₀) [p.IsPrime]
        (T₀ : Type u) [CommRing T₀] [Algebra K' T₀] [Algebra S₀ T₀]
        [IsScalarTower K' S₀ T₀] [Algebra.Etale S₀ T₀]
        (q : Ideal T₀) [q.IsPrime],
      p = Ideal.comap (algebraMap S₀ T₀) q →
      ∀ (φ_poly : Polynomial K' →+* T₀),
        φ_poly.Etale →
        φ_poly.comp Polynomial.C = algebraMap K' T₀ →
        ∃ f : S₀, f ∉ p ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap K' (Localization.Away f))) →
    (∀ (R B : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R]
        [CommRing B] [Algebra R B] [Algebra.Etale R B], IsReduced B) →
    (IsNoetherianRing A_nod ∧ IsReduced A_nod) →
    (∀ (B : Type u) [CommRing B] (φ₂ : A_nod →+* B),
      φ₂.Etale →
      (∀ i : Fin 2,
        ∃ ψ_i : Polynomial K' →+*
            Localization.Away (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))),
          ψ_i.Etale ∧
          ψ_i.comp Polynomial.C =
            (algebraMap B (Localization.Away (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))))).comp
              (φ₂.comp c_nod)) ∧
      {v : PrimeSpectrum B |
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ v.asIdeal ∧
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ v.asIdeal}.Finite ∧
      (∀ v₀ : PrimeSpectrum B,
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ v₀.asIdeal →
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ v₀.asIdeal →
        ∃ v₁ : PrimeSpectrum B,
          v₁.asIdeal ≤ v₀.asIdeal ∧
          φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∉ v₁.asIdeal)) →
    AlgebraicGeometry.IsReduced X_s ∧
    {y : ↥X_s | ¬ ∃ V_sm : X_s.Opens,
      y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ snd_s)}.Finite ∧
    (∀ E ∈ irreducibleComponents ↥X_s,
      (∃ η_E ∈ E, closure ({η_E} : Set ↥X_s) = E ∧
        ∃ V_sm : X_s.Opens,
          η_E ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ snd_s)) ∧
      ∀ U_aff : X_s.Opens, AlgebraicGeometry.IsAffineOpen U_aff →
        (E \ (U_aff : Set ↥X_s)).Nonempty) :=
by
  intro A_nod c_nod X_s snd_s hEtaleDesc hRedEtale hNodalRed hNodalLoc
  have hPart1 : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K')),
      (∀ y : ↥X, HasSpreadSmoothOrNodalAt f y) →
      AlgebraicGeometry.IsReduced X := by
    intro X f hCov
    suffices hStalk : ∀ y : ↥X, _root_.IsReduced ↑(X.presheaf.stalk y) by
      exact @AlgebraicGeometry.isReduced_of_isReduced_stalk X hStalk
    have hRedOfLoc : ∀ {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] {M : Submonoid R₀}
        {instAlg : Algebra R₀ S₀} (_ : @IsLocalization R₀ _ M S₀ _ instAlg),
        _root_.IsReduced R₀ → _root_.IsReduced S₀ :=
      fun {_R₀ _S₀ _ _ M instAlg} hLoc hRed =>
        @isReduced_localizationPreserves _ _ M _ _ instAlg hLoc hRed
    intro y
    rcases hCov y with ⟨V_sm, hyV, hSm⟩ | ⟨U', u₀, e₁, e₂, he₁, he₂, hu₀_y, _, _⟩
    · let g_sm : V_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of K') := V_sm.ι ≫ f
      let x₀ : ↥V_sm.toScheme := ⟨y, hyV⟩
      obtain ⟨U, _hU, V_aff, hV, hxV, eUV, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 g_sm).mp hSm x₀
      have hU_top : U = ⊤ := by
        ext z
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hz₀ : g_sm.base x₀ ∈ U := eUV hxV
        have h_eq : z = g_sm.base x₀ := by
          apply PrimeSpectrum.ext
          have h1 : z.asIdeal = ⊥ :=
            (Ideal.eq_bot_or_top z.asIdeal).resolve_right z.isPrime.ne_top
          have h2 : (g_sm.base x₀).asIdeal = ⊥ :=
            (Ideal.eq_bot_or_top (g_sm.base x₀).asIdeal).resolve_right (g_sm.base x₀).isPrime.ne_top
          exact h1.trans h2.symm
        exact h_eq ▸ hz₀
      subst hU_top
      let e_ring : K' ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K')).presheaf.obj (Opposite.op ⊤)) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).symm.commRingCatIsoToRingEquiv
      have hStd_K' : RingHom.IsStandardSmoothOfRelativeDimension 1
          ((g_sm.appLE ⊤ V_aff eUV).hom.comp e_ring.toRingHom) :=
        (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).right
          (g_sm.appLE ⊤ V_aff eUV).hom e_ring hStd
      obtain ⟨g_mv, _, hg_et⟩ := hStd_K'.exists_etale_mvPolynomial
      let S : Type u := ↑(V_sm.toScheme.presheaf.obj (Opposite.op V_aff))
      let _ : Algebra (MvPolynomial (Fin 1) K') S := g_mv.toAlgebra
      have _ : Algebra.Etale (MvPolynomial (Fin 1) K') S :=
        RingHom.etale_algebraMap.mp hg_et
      have _ : _root_.IsReduced (MvPolynomial (Fin 1) K') :=
        ⟨fun x ⟨k, hk⟩ => by
          induction k with
          | zero =>
            rw [pow_zero] at hk
            exact (mul_one x).symm.trans (hk ▸ mul_zero x)
          | succ k ih =>
            rw [pow_succ] at hk
            exact (mul_eq_zero.mp hk).elim ih id⟩
      have hRedS : _root_.IsReduced S := hRedEtale (MvPolynomial (Fin 1) K') S
      have _ : _root_.IsReduced ↑(V_sm.toScheme.presheaf.stalk x₀) :=
        hRedOfLoc (hV.isLocalization_stalk ⟨x₀, hxV⟩) hRedS
      have _ : CategoryTheory.IsIso (V_sm.ι.stalkMap x₀) := inferInstance
      let e_stalk := (asIso (V_sm.ι.stalkMap x₀)).commRingCatIsoToRingEquiv
      exact isReduced_of_injective e_stalk.toRingHom e_stalk.injective
    · obtain ⟨_hNoethA, _hRedA⟩ := hNodalRed
      obtain ⟨W_U, hW_U, hu₀W, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show u₀ ∈ (⊤ : U'.Opens) from trivial)
      have hEt_app : (e₂.appLE ⊤ W_U le_top).hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) e₂ he₂
          ⟨⊤, isAffineOpen_top _⟩ ⟨W_U, hW_U⟩ le_top
      let e_Anod : A_nod ≃+*
          ↑((AlgebraicGeometry.Spec (CommRingCat.of A_nod)).presheaf.obj (Opposite.op ⊤)) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).symm.commRingCatIsoToRingEquiv
      have hφ₂_et : ((e₂.appLE ⊤ W_U le_top).hom.comp e_Anod.toRingHom).Etale :=
        RingHom.Etale.respectsIso.right (e₂.appLE ⊤ W_U le_top).hom e_Anod hEt_app
      let B : Type u := ↑(U'.presheaf.obj (Opposite.op W_U))
      let _ : Algebra A_nod B :=
        ((e₂.appLE ⊤ W_U le_top).hom.comp e_Anod.toRingHom).toAlgebra
      have _ : Algebra.Etale A_nod B := RingHom.etale_algebraMap.mp hφ₂_et
      have hRedB : _root_.IsReduced B := hRedEtale A_nod B
      have _ : _root_.IsReduced ↑(U'.presheaf.stalk u₀) :=
        hRedOfLoc (hW_U.isLocalization_stalk ⟨u₀, hu₀W⟩) hRedB
      have _ : AlgebraicGeometry.Flat e₁ := inferInstance
      have hFlatStalk : (e₁.stalkMap u₀).hom.Flat := AlgebraicGeometry.Flat.stalkMap e₁ u₀
      let ψ_stalk := (e₁.stalkMap u₀).hom
      let _ : Algebra ↑(X.presheaf.stalk (e₁.base u₀)) ↑(U'.presheaf.stalk u₀) := ψ_stalk.toAlgebra
      have _ : Module.Flat ↑(X.presheaf.stalk (e₁.base u₀)) ↑(U'.presheaf.stalk u₀) := hFlatStalk
      have _ : IsLocalHom (algebraMap ↑(X.presheaf.stalk (e₁.base u₀)) ↑(U'.presheaf.stalk u₀)) :=
        inferInstanceAs (IsLocalHom ψ_stalk)
      have hFF : ψ_stalk.FaithfullyFlat :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      have hRed_stalk : _root_.IsReduced ↑(X.presheaf.stalk (e₁.base u₀)) :=
        isReduced_of_injective ψ_stalk (RingHom.FaithfullyFlat.injective hFF)
      exact hu₀_y ▸ hRed_stalk
  have hPart2 : ∀ (X : AlgebraicGeometry.Scheme.{u}) [CompactSpace ↥X]
      (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K'))
      [AlgebraicGeometry.LocallyOfFinitePresentation f],
      (∀ y : ↥X, HasSpreadSmoothOrNodalAt f y) →
      {y : ↥X | ¬ ∃ V_sm : X.Opens,
        y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f)}.Finite ∧
      (∀ E ∈ irreducibleComponents ↥X,
        ∃ η_E ∈ E, closure ({η_E} : Set ↥X) = E ∧
          ∃ V_sm : X.Opens,
            η_E ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f)) := by
    intro X _ f _ hCov
    let Sm : Set ↥X := {y : ↥X | ∃ V_sm : X.Opens,
      y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f)}
    let Sing : Set ↥X := {y : ↥X | ¬ ∃ V_sm : X.Opens,
      y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ f)}
    have hSm_open : IsOpen Sm := by
      rw [isOpen_iff_forall_mem_open]
      rintro y ⟨V_sm, hyV, hSmV⟩
      exact ⟨(V_sm : Set ↥X), fun z hz => ⟨V_sm, hz, hSmV⟩, V_sm.isOpen, hyV⟩
    have hSing_closed : IsClosed Sing := by
      change IsClosed Smᶜ
      exact hSm_open.isClosed_compl
    have hSing_compact : IsCompact Sing := hSing_closed.isCompact
    let e_K' : K' ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K')).presheaf.obj (Opposite.op ⊤)) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).symm.commRingCatIsoToRingEquiv
    have hBasicSmooth : ∀ (W_X : X.Opens) (hW_X : AlgebraicGeometry.IsAffineOpen W_X)
        (g₀ : ↑(X.presheaf.obj (Opposite.op W_X))),
        (let S₀ : Type u := ↑(X.presheaf.obj (Opposite.op W_X))
         let φ_K' : K' →+* S₀ := (f.appLE ⊤ W_X le_top).hom.comp e_K'.toRingHom
         letI : Algebra K' S₀ := φ_K'.toAlgebra
         RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap K' (Localization.Away g₀))) →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 ((X.basicOpen g₀).ι ≫ f) := by
      intro W_X hW_X g₀ hStd_loc
      let S₀ : Type u := ↑(X.presheaf.obj (Opposite.op W_X))
      let φ_K' : K' →+* S₀ := (f.appLE ⊤ W_X le_top).hom.comp e_K'.toRingHom
      let _ : Algebra K' S₀ := φ_K'.toAlgebra
      let V_sm : X.Opens := X.basicOpen g₀
      have hV_sm : AlgebraicGeometry.IsAffineOpen V_sm := hW_X.basicOpen g₀
      have _ : AlgebraicGeometry.IsAffine V_sm.toScheme := hV_sm
      let R_loc : Type u := ↑(X.presheaf.obj (Opposite.op V_sm))
      let res_mor : X.presheaf.obj (Opposite.op W_X) ⟶ X.presheaf.obj (Opposite.op V_sm) :=
        X.presheaf.map (homOfLE (X.basicOpen_le g₀)).op
      let _ : Algebra S₀ R_loc := res_mor.hom.toAlgebra
      let _ : Algebra K' R_loc := (res_mor.hom.comp φ_K').toAlgebra
      have _ : IsScalarTower K' S₀ R_loc := IsScalarTower.of_algebraMap_eq' rfl
      have _ : IsLocalization.Away g₀ R_loc := hW_X.isLocalization_basicOpen g₀
      let e_loc : Localization.Away g₀ ≃ₐ[K'] R_loc :=
        (IsLocalization.algEquiv (Submonoid.powers g₀) (Localization.Away g₀) R_loc).restrictScalars K'
      have _ : Algebra.IsStandardSmoothOfRelativeDimension 1 K' (Localization.Away g₀) :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hStd_loc
      have _ : Algebra.IsStandardSmoothOfRelativeDimension 1 K' R_loc :=
        Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 e_loc
      have hStd_Rloc : RingHom.IsStandardSmoothOfRelativeDimension 1 (res_mor.hom.comp φ_K') :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance
      let e_top : R_loc ≃+* ↑(V_sm.toScheme.presheaf.obj (Opposite.op ⊤)) :=
        V_sm.topIso.symm.commRingCatIsoToRingEquiv
      have hStd_top_K' : RingHom.IsStandardSmoothOfRelativeDimension 1
          (e_top.toRingHom.comp (res_mor.hom.comp φ_K')) :=
        (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).left
          (res_mor.hom.comp φ_K') e_top hStd_Rloc
      have h_sub_top : (⊤ : V_sm.toScheme.Opens) ≤ (TopologicalSpace.Opens.map V_sm.ι.base).obj W_X :=
        fun z _ => X.basicOpen_le g₀ z.2
      have h1 : f.appLE ⊤ W_X le_top ≫ V_sm.ι.appLE W_X ⊤ h_sub_top =
          (V_sm.ι ≫ f).appLE ⊤ ⊤ le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V_sm.ι f ⊤ W_X ⊤ le_top h_sub_top
      have h2 : res_mor ≫ V_sm.topIso.inv = V_sm.ι.appLE W_X ⊤ h_sub_top := by
        have h_top := AlgebraicGeometry.Scheme.Opens.topIso_inv V_sm
        have h_ι := AlgebraicGeometry.Scheme.Opens.ι_appLE V_sm W_X ⊤ h_sub_top
        exact (congrArg (res_mor ≫ ·) h_top).trans
          ((X.presheaf.map_comp _ _).symm.trans h_ι.symm)
      have h_eq_mor :
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
            ((V_sm.ι ≫ f).appLE ⊤ ⊤ le_top) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
            f.appLE ⊤ W_X le_top ≫ res_mor ≫ V_sm.topIso.inv := by
        rw [← h1, h2]
      have h_hom_eq :
          (((V_sm.ι ≫ f).appLE ⊤ ⊤ le_top).hom).comp e_K'.toRingHom =
          e_top.toRingHom.comp (res_mor.hom.comp φ_K') :=
        congrArg CommRingCat.Hom.hom h_eq_mor
      rw [← h_hom_eq] at hStd_top_K'
      have hStd_app : RingHom.IsStandardSmoothOfRelativeDimension 1
          (((V_sm.ι ≫ f).appLE ⊤ ⊤ le_top).hom) := by
        have h_tmp := (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).right
          (((V_sm.ι ≫ f).appLE ⊤ ⊤ le_top).hom.comp e_K'.toRingHom)
          e_K'.symm hStd_top_K'
        have h_id : (((V_sm.ι ≫ f).appLE ⊤ ⊤ le_top).hom.comp e_K'.toRingHom).comp
            e_K'.symm.toRingHom =
            ((V_sm.ι ≫ f).appLE ⊤ ⊤ le_top).hom := by
          ext a
          simp
        rwa [h_id] at h_tmp
      exact AlgebraicGeometry.SmoothOfRelativeDimension.mk fun x =>
        ⟨⊤, isAffineOpen_top _, ⊤, isAffineOpen_top V_sm.toScheme, trivial, le_top, hStd_app⟩
    have hChart : ∀ y ∈ Sing,
        ∃ (W_X : X.Opens) (hW_X : AlgebraicGeometry.IsAffineOpen W_X)
          (B : Type u) (_ : CommRing B)
          (φ₁ : ↑(X.presheaf.obj (Opposite.op W_X)) →+* B)
          (φ₂ : A_nod →+* B)
          (ι_WU : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ X)
          (v₀ : PrimeSpectrum B),
          φ₂.Etale ∧
          IsOpenMap ι_WU.base ∧
          ι_WU.base v₀ = y ∧
          (∀ v : PrimeSpectrum B, ι_WU.base v = hW_X.fromSpec.base (PrimeSpectrum.comap φ₁ v)) ∧
          (∀ i : Fin 2, φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ v₀.asIdeal) ∧
          (∀ (v : PrimeSpectrum B) (i : Fin 2),
            φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∉ v.asIdeal →
            ι_WU.base v ∈ Sm) := by
      intro y hySing
      rcases hCov y with hSm_y | ⟨U', u₀, e₁, e₂, he₁, he₂, hu₀_y, hX_mem, hcomm⟩
      · exact False.elim (hySing hSm_y)
      · obtain ⟨W_X, hW_X, hyWX, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show y ∈ (⊤ : X.Opens) from trivial)
        have hu₀_pre : u₀ ∈ (TopologicalSpace.Opens.map e₁.base).obj W_X := by
          change e₁.base u₀ ∈ W_X
          rwa [hu₀_y]
        obtain ⟨W_U, hW_U, hu₀WU, hWU_sub⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_pre
        let S₀ : Type u := ↑(X.presheaf.obj (Opposite.op W_X))
        let B : Type u := ↑(U'.presheaf.obj (Opposite.op W_U))
        let φ_K' : K' →+* S₀ := (f.appLE ⊤ W_X le_top).hom.comp e_K'.toRingHom
        have hFP_app : (f.appLE ⊤ W_X le_top).hom.FinitePresentation :=
          AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.LocallyOfFinitePresentation)
            f inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨W_X, hW_X⟩ le_top
        have hFP_K' : φ_K'.FinitePresentation :=
          RingHom.finitePresentation_respectsIso.right
            (f.appLE ⊤ W_X le_top).hom e_K' hFP_app
        let φ₁ : S₀ →+* B := (e₁.appLE W_X W_U hWU_sub).hom
        have hφ₁_et : φ₁.Etale :=
          AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
            e₁ he₁ ⟨W_X, hW_X⟩ ⟨W_U, hW_U⟩ hWU_sub
        let e_Anod : A_nod ≃+*
            ↑((AlgebraicGeometry.Spec (CommRingCat.of A_nod)).presheaf.obj (Opposite.op ⊤)) :=
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).symm.commRingCatIsoToRingEquiv
        let φ₂ : A_nod →+* B := (e₂.appLE ⊤ W_U le_top).hom.comp e_Anod.toRingHom
        have hEt_e₂ : (e₂.appLE ⊤ W_U le_top).hom.Etale :=
          AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
            e₂ he₂ ⟨⊤, isAffineOpen_top _⟩ ⟨W_U, hW_U⟩ le_top
        have hφ₂_et : φ₂.Etale :=
          RingHom.Etale.respectsIso.right (e₂.appLE ⊤ W_U le_top).hom e_Anod hEt_e₂
        have hK'_comm : φ₁.comp φ_K' = φ₂.comp c_nod := by
          have h_cat :
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
                f.appLE ⊤ W_X le_top ≫ e₁.appLE W_X W_U hWU_sub =
              CommRingCat.ofHom c_nod ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).inv ≫
                  e₂.appLE ⊤ W_U le_top := by
            rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e₁ f ⊤ W_X W_U le_top hWU_sub]
            have h_congr : (e₁ ≫ f).appLE ⊤ W_U le_top =
                (e₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)).appLE ⊤ W_U le_top := by
              congr 1
            have h_rhs := AlgebraicGeometry.Scheme.Hom.comp_appLE e₂
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)) ⊤ W_U le_top
            rw [h_congr, h_rhs]
            exact (AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality_assoc
              (CommRingCat.ofHom c_nod) (e₂.appLE _ W_U le_top)).symm
          exact congrArg CommRingCat.Hom.hom h_cat
        let ι_WU : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ X := hW_U.fromSpec ≫ e₁
        let v₀ : PrimeSpectrum B := hW_U.primeIdealOf ⟨u₀, hu₀WU⟩
        have _ : AlgebraicGeometry.Etale hW_U.fromSpec := inferInstance
        have _ : AlgebraicGeometry.Etale ι_WU := inferInstance
        have _ : AlgebraicGeometry.Flat ι_WU := inferInstance
        have _ : AlgebraicGeometry.LocallyOfFinitePresentation ι_WU := inferInstance
        have _ : AlgebraicGeometry.UniversallyOpen ι_WU :=
          AlgebraicGeometry.UniversallyOpen.of_flat ι_WU
        have hOpen_ι : IsOpenMap ι_WU.base := ι_WU.isOpenMap
        have hv₀_y : ι_WU.base v₀ = y := by
          change e₁.base (hW_U.fromSpec.base v₀) = y
