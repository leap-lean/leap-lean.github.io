    haveI : AlgebraicGeometry.IsPreimmersion s_P := hsP_pre
    haveI : AlgebraicGeometry.IsPreimmersion fst_P := inferInstance
    have hInj_fst : Function.Injective fst_P.base := AlgebraicGeometry.Scheme.Hom.injective fst_P
    have hChart : ∀ q : ↥F_P,
        ∃ (R_mod B_P : Type u) (_ : CommRing R_mod) (_ : CommRing B_P)
          (_ : Algebra κ_P R_mod) (_ : Algebra κ_P B_P) (_ : Algebra R_mod B_P)
          (_ : IsScalarTower κ_P R_mod B_P) (_ : Algebra.FiniteType κ_P R_mod)
          (_ : Algebra.Etale R_mod B_P)
          (j_P : AlgebraicGeometry.Spec (CommRingCat.of B_P) ⟶ F_P)
          (q₀ : PrimeSpectrum B_P),
