              rw [hp₀_eq]; exact subset_closure rfl))
          (isClosed_closure.preimage hEmb_U₀.continuous)) hqB_in_cl_p₀
      have hE_sub : E ⊆ fst₀.base ⁻¹' closure ({z_P} : Set ↥X) := by
        rw [← hηY_cl]
        refine closure_minimal (Set.singleton_subset_iff.mpr ?_)
          (isClosed_closure.preimage fst₀.continuous)
        simpa [hfst_ηY] using hy₀_in_cl_zP
      exact ⟨E, hE_mem, fun w hw => hE_sub hw⟩
  have etale_ringHom_of_chart :
      ∀ {R₀ : Type u} [CommRing R₀] {A₀ : CommRingCat.{u}}
        (X : AlgebraicGeometry.Scheme.{u})
        (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀))
        (W U : X.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (_ : U ≤ W)
        {ι_mor : CommRingCat.of R₀ ⟶ A₀}
        {e : W.toScheme ⟶ AlgebraicGeometry.Spec A₀},
        AlgebraicGeometry.Etale e →
        W.ι ≫ g = e ≫ AlgebraicGeometry.Spec.map ι_mor →
        ∃ φ : ↥A₀ →+* ↥(X.presheaf.obj (Opposite.op U)),
          φ.Etale ∧
          φ.comp ι_mor.hom = (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g)).hom := by
    clear * -
    intro R₀ _ A₀ X g W U hU hUW ι_mor e he_et he_comm
    let j : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U)) ⟶ W.toScheme :=
      hU.isoSpec.inv ≫ X.homOfLE hUW
    haveI : AlgebraicGeometry.IsOpenImmersion j := inferInstance
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 0 j := inferInstance
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 0 e :=
      (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero e).mp he_et
    have hsm_je : AlgebraicGeometry.SmoothOfRelativeDimension 0 (j ≫ e) := by
      simpa using AlgebraicGeometry.smoothOfRelativeDimension_comp 0 0 j e
    have het_je : AlgebraicGeometry.Etale (j ≫ e) :=
      (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero (j ≫ e)).mpr hsm_je
    let ψ_cat := AlgebraicGeometry.Spec.preimage (j ≫ e)
    have het_map : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map ψ_cat) := by
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact het_je
    have hφ_et : ψ_cat.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp het_map
    have hje_comm : (j ≫ e) ≫ AlgebraicGeometry.Spec.map ι_mor =
        hU.fromSpec ≫ g := by
      rw [CategoryTheory.Category.assoc, ← he_comm]
      dsimp [j]
      rw [CategoryTheory.Category.assoc (hU.isoSpec.inv),
        ← CategoryTheory.Category.assoc (X.homOfLE hUW),
        X.homOfLE_ι hUW, ← CategoryTheory.Category.assoc, hU.isoSpec_inv_ι]
    have hpre_eq : ι_mor ≫ ψ_cat =
        AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g) := by
      rw [← hje_comm, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
    refine ⟨ψ_cat.hom, hφ_et, ?_⟩
    exact congrArg CommRingCat.Hom.hom hpre_eq
  have hAffine_comap : ∀ (U : C_semi.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (q : PrimeSpectrum ↥(C_semi.presheaf.obj (Opposite.op U))),
      Ideal.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_semi)).hom q.asIdeal =
        (g_semi.base (hU.fromSpec.base q)).asIdeal := by
    intro U hU q
    have hmap : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_semi)) =
        hU.fromSpec ≫ g_semi := AlgebraicGeometry.Spec.map_preimage _
    change ((AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_semi))).base q).asIdeal =
      (g_semi.base (hU.fromSpec.base q)).asIdeal
    rw [hmap]
    rfl
  obtain ⟨z_P, x₀, hzP_base, hx₀_cl, hx₀_max, hLift_EP, hMin_zP, hClosedComp⟩ :=
    h_s1 (↥V) C_semi g_semi hProp P E_P hEP
