          let x₀ : L := Ideal.Quotient.mk M (MvPolynomial.X 0)
          let x₁ : L := Ideal.Quotient.mk M (MvPolynomial.X 1)
          let μ : Polynomial κ_P := minpoly κ_P x₀
          let ν : Polynomial κ_P := minpoly κ_P x₁
          have hμ_int : _root_.IsIntegral κ_P x₀ := Algebra.IsIntegral.isIntegral x₀
          have hν_int : _root_.IsIntegral κ_P x₁ := Algebra.IsIntegral.isIntegral x₁
          have hμ_irr : Irreducible μ := minpoly.irreducible hμ_int
          have : (Ideal.span {μ}).IsMaximal := PrincipalIdealRing.isMaximal_of_irreducible hμ_irr
          let E := Polynomial κ_P ⧸ Ideal.span {μ}
          letI : Field E := Ideal.Quotient.field (Ideal.span {μ})
          have hμ_ker : Ideal.span {μ} ≤ RingHom.ker (Polynomial.aeval x₀).toRingHom := by
            rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
            exact minpoly.aeval κ_P x₀
          let ψ_E : E →+* L := Ideal.Quotient.lift (Ideal.span {μ}) (Polynomial.aeval x₀).toRingHom hμ_ker
          let ψ : Polynomial E →+* L := Polynomial.eval₂RingHom ψ_E x₁
          let toE : κ_P →+* E := (Ideal.Quotient.mk (Ideal.span {μ})).comp Polynomial.C
          let φ : S →+* Polynomial E :=
            MvPolynomial.eval₂Hom (Polynomial.C.comp toE)
              ![Polynomial.C (Ideal.Quotient.mk (Ideal.span {μ}) Polynomial.X), Polynomial.X]
          have hψφ : ψ.comp φ = Ideal.Quotient.mk M := by
            apply MvPolynomial.ringHom_ext
            · intro c
              change ψ (φ (MvPolynomial.C c)) = Ideal.Quotient.mk M (MvPolynomial.C c)
              dsimp [φ, ψ, toE]
              rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, Polynomial.eval₂_C]
              change (Polynomial.aeval x₀) (Polynomial.C c) = Ideal.Quotient.mk M (MvPolynomial.C c)
              rw [Polynomial.aeval_C]
              rfl
            · intro i
              fin_cases i
              · change ψ (φ (MvPolynomial.X 0)) = x₀
                dsimp [φ, ψ]
                rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero, Polynomial.eval₂_C]
                change (Polynomial.aeval x₀) Polynomial.X = x₀
                exact Polynomial.aeval_X x₀
              · change ψ (φ (MvPolynomial.X 1)) = x₁
                dsimp [φ, ψ]
                rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero,
                  Polynomial.eval₂_X]
          let P₁ : Ideal S := RingHom.ker φ
          have : P₁.IsPrime := RingHom.ker_isPrime φ
          have hP₁_le_M : P₁ ≤ M := by
            intro z hz
            have hz0 : (Ideal.Quotient.mk M) z = 0 := by
              rw [← hψφ, RingHom.comp_apply, RingHom.mem_ker.mp hz, map_zero]
            exact Ideal.Quotient.eq_zero_iff_mem.mp hz0
          have hbot_lt_P₁ : (⊥ : Ideal S) < P₁ := by
            rw [bot_lt_iff_ne_bot]
            intro hP₁_bot
            let P_el : S := Polynomial.aeval (MvPolynomial.X 0 : S) μ
            have hPel_mem : P_el ∈ P₁ := by
              rw [RingHom.mem_ker]
              have hcomp : φ.comp (Polynomial.aeval (MvPolynomial.X 0 : S)).toRingHom =
                  Polynomial.C.comp (Ideal.Quotient.mk (Ideal.span {μ})) := by
                apply Polynomial.ringHom_ext
                · intro c
                  change φ ((Polynomial.aeval (MvPolynomial.X 0 : S)) (Polynomial.C c)) =
                    Polynomial.C (toE c)
                  rw [Polynomial.aeval_C, MvPolynomial.algebraMap_eq]
                  dsimp [φ]
                  rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
                · change φ ((Polynomial.aeval (MvPolynomial.X 0 : S)) Polynomial.X) =
                    Polynomial.C (Ideal.Quotient.mk (Ideal.span {μ}) Polynomial.X)
                  rw [Polynomial.aeval_X]
                  dsimp [φ]
                  rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
              change (φ.comp (Polynomial.aeval (MvPolynomial.X 0 : S)).toRingHom) μ = 0
              rw [hcomp, RingHom.comp_apply,
                Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton μ)),
                map_zero]
            rw [hP₁_bot, Ideal.mem_bot] at hPel_mem
            let proj₀ : S →+* Polynomial κ_P :=
              MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0]
            have hproj : proj₀ P_el = μ := by
              have hcomp : proj₀.comp (Polynomial.aeval (MvPolynomial.X 0 : S)).toRingHom =
                  RingHom.id (Polynomial κ_P) := by
                apply Polynomial.ringHom_ext
                · intro c
                  change proj₀ ((Polynomial.aeval (MvPolynomial.X 0 : S)) (Polynomial.C c)) =
                    Polynomial.C c
                  rw [Polynomial.aeval_C, MvPolynomial.algebraMap_eq]
                  dsimp [proj₀]
                  rw [MvPolynomial.eval₂Hom_C]
                · change proj₀ ((Polynomial.aeval (MvPolynomial.X 0 : S)) Polynomial.X) =
                    Polynomial.X
                  rw [Polynomial.aeval_X]
                  dsimp [proj₀]
                  rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
              change (proj₀.comp (Polynomial.aeval (MvPolynomial.X 0 : S)).toRingHom) μ = μ
              rw [hcomp, RingHom.id_apply]
            rw [hPel_mem, map_zero] at hproj
            exact hμ_irr.ne_zero hproj.symm
          have hP₁_lt_M : P₁ < M := by
            refine lt_of_le_of_ne hP₁_le_M ?_
            intro hEq
            let Q_el : S := Polynomial.aeval (MvPolynomial.X 1 : S) ν
            have hQel_M : Q_el ∈ M := by
              rw [← Ideal.Quotient.eq_zero_iff_mem]
              have hcomp : (Ideal.Quotient.mk M).comp
                  (Polynomial.aeval (R := κ_P) (MvPolynomial.X 1 : S)).toRingHom =
                  (Polynomial.aeval (R := κ_P) x₁).toRingHom := by
                apply Polynomial.ringHom_ext
                · intro c
                  simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
                    Polynomial.aeval_C]
                  rfl
                · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
                    Polynomial.aeval_X, x₁]
              change ((Ideal.Quotient.mk M).comp
                (Polynomial.aeval (R := κ_P) (MvPolynomial.X 1 : S)).toRingHom) ν = 0
              rw [hcomp]; exact minpoly.aeval κ_P x₁
            rw [← hEq, RingHom.mem_ker] at hQel_M
            have hφQ : φ Q_el = Polynomial.map toE ν := by
              have hcomp : φ.comp (Polynomial.aeval (MvPolynomial.X 1 : S)).toRingHom =
                  Polynomial.mapRingHom toE := by
                apply Polynomial.ringHom_ext
                · intro c
                  change φ ((Polynomial.aeval (MvPolynomial.X 1 : S)) (Polynomial.C c)) =
                    Polynomial.map toE (Polynomial.C c)
                  rw [Polynomial.aeval_C, MvPolynomial.algebraMap_eq, Polynomial.map_C]
                  dsimp [φ]
                  rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
                · change φ ((Polynomial.aeval (MvPolynomial.X 1 : S)) Polynomial.X) =
                    Polynomial.map toE Polynomial.X
                  rw [Polynomial.aeval_X, Polynomial.map_X]
                  dsimp [φ]
                  rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero]
              change (φ.comp (Polynomial.aeval (MvPolynomial.X 1 : S)).toRingHom) ν = Polynomial.map toE ν
              rw [hcomp]; rfl
            rw [hφQ] at hQel_M
            have hdeg_pos : 0 < (Polynomial.map toE ν).natDegree := by
              rw [(minpoly.monic hν_int).natDegree_map toE]
              exact minpoly.natDegree_pos hν_int
            rw [hQel_M, Polynomial.natDegree_zero] at hdeg_pos
            exact lt_irrefl 0 hdeg_pos
          have hP₁_ht_lt : P₁.height < (1 : ℕ) :=
            (Ideal.height_le_iff.mp hM_ht) P₁ inferInstance hP₁_lt_M
          have hP₁_ht_le : P₁.height ≤ (0 : ℕ) := by
            cases h : P₁.height with
            | top => rw [h] at hP₁_ht_lt; simp at hP₁_ht_lt
            | coe m_ht =>
              rw [h] at hP₁_ht_lt
              have hm : m_ht < 1 := by exact_mod_cast hP₁_ht_lt
              have hm0 : m_ht ≤ 0 := by omega
              exact_mod_cast hm0
          have hbot_ht_lt : (⊥ : Ideal S).height < (0 : ℕ) :=
            (Ideal.height_le_iff.mp hP₁_ht_le) ⊥ inferInstance hbot_lt_P₁
          simp at hbot_ht_lt
    have hBP_dichot : ∀ (R_mod B_P : Type u) [CommRing R_mod] [CommRing B_P]
        [Algebra R_mod B_P] [Algebra.QuasiFinite R_mod B_P],
        Ring.KrullDimLE 1 R_mod →
        ∀ (q : Ideal B_P), q.IsPrime → q ∈ minimalPrimes B_P ∨ q.IsMaximal := by
      intro R_mod B_P _ _ _ _ hDimR q hqp
      have hStrictComap : ∀ (a b : Ideal B_P) [a.IsPrime] [b.IsPrime],
          a < b → a.comap (algebraMap R_mod B_P) < b.comap (algebraMap R_mod B_P) := by
        intro a b hap hbp hab
        refine lt_of_le_of_ne (Ideal.comap_mono hab.le) ?_
        intro hEq
        let pa : PrimeSpectrum B_P := ⟨a, hap⟩
        let pb : PrimeSpectrum B_P := ⟨b, hbp⟩
        let r : PrimeSpectrum R_mod := PrimeSpectrum.comap (algebraMap R_mod B_P) pa
        have : DiscreteTopology ↥(PrimeSpectrum.comap (algebraMap R_mod B_P) ⁻¹' {r}) :=
          (Algebra.QuasiFinite.isDiscrete_comap_preimage_singleton r).1
        have hpa : pa ∈ PrimeSpectrum.comap (algebraMap R_mod B_P) ⁻¹' {r} := rfl
        have hpb : pb ∈ PrimeSpectrum.comap (algebraMap R_mod B_P) ⁻¹' {r} :=
          PrimeSpectrum.ext hEq.symm
        have hSpec_ab : pa ⤳ pb := (PrimeSpectrum.le_iff_specializes pa pb).mp hab.le
        have hSpec_sub : (⟨pa, hpa⟩ : ↥(PrimeSpectrum.comap (algebraMap R_mod B_P) ⁻¹' {r})) ⤳ ⟨pb, hpb⟩ :=
          Topology.IsInducing.subtypeVal.specializes_iff.mp hSpec_ab
        have hEq_sub : (⟨pa, hpa⟩ : ↥(PrimeSpectrum.comap (algebraMap R_mod B_P) ⁻¹' {r})) = ⟨pb, hpb⟩ :=
          specializes_iff_eq.mp hSpec_sub
        exact hab.ne (congrArg (fun z => z.1.asIdeal) hEq_sub)
      by_contra hNot
      have hNotMin : q ∉ minimalPrimes B_P := fun h => hNot (Or.inl h)
      have hNotMax : ¬ q.IsMaximal := fun h => hNot (Or.inr h)
      have hex_lt : ∃ q' : Ideal B_P, q'.IsPrime ∧ q' < q := by
        by_contra hNo
        apply hNotMin
        refine ⟨⟨hqp, bot_le⟩, ?_⟩
        rintro q' ⟨hq'p, _⟩ hq'le
        by_cases hEq : q' = q
        · exact hEq.ge
        · exact False.elim (hNo ⟨q', hq'p, lt_of_le_of_ne hq'le hEq⟩)
      obtain ⟨q', hq'p, hq'_lt⟩ := hex_lt
      obtain ⟨m_id, hmq_max, hq_le_m⟩ := Ideal.exists_le_maximal q hqp.ne_top
      have : m_id.IsPrime := hmq_max.isPrime
      have hq_lt_m : q < m_id := lt_of_le_of_ne hq_le_m (fun h => hNotMax (h ▸ hmq_max))
      have hc1 := @hStrictComap q' q hq'p hqp hq'_lt
      have hc2 := @hStrictComap q m_id hqp inferInstance hq_lt_m
      rcases (Ring.krullDimLE_one_iff.mp hDimR) (q.comap (algebraMap R_mod B_P)) inferInstance with hMinC | hMaxC
      · exact not_le_of_gt hc1 (hMinC.2 ⟨inferInstance, bot_le⟩ hc1.le)
      · exact hc2.ne (hMaxC.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hc2.le)
    refine ⟨hNoeth, hInj_fst, ?_, ?_⟩
    · intro E_P hEP
      have hEP_cl : IsClosed E_P := isClosed_of_mem_irreducibleComponents E_P hEP
      have hEP_irr : IsIrreducible E_P := hEP.1
      let η_E : ↥F_P := hEP_irr.genericPoint
      have hη_cl : closure ({η_E} : Set ↥F_P) = E_P := hEP_irr.closure_genericPoint hEP_cl
      have hη_mem : η_E ∈ E_P := hη_cl ▸ subset_closure (Set.mem_singleton η_E)
      obtain ⟨R_mod, B_P, _, _, _, _, _, _, _, _, j_P, q₀, _, hq₀_eq, hDimR, hMinR⟩ := hChart η_E
      have hInj_jP : Function.Injective j_P.base := AlgebraicGeometry.Scheme.Hom.injective j_P
      have hq₀_min : q₀.asIdeal ∈ minimalPrimes B_P := by
        refine ⟨⟨q₀.isPrime, bot_le⟩, ?_⟩
        rintro q' ⟨hq'p, _⟩ hq'le
        let pq' : PrimeSpectrum B_P := ⟨q', hq'p⟩
        have hSpec : pq' ⤳ q₀ := (PrimeSpectrum.le_iff_specializes pq' q₀).mp hq'le
        have hSpecF : j_P.base pq' ⤳ η_E := hq₀_eq ▸ hSpec.map j_P.base.hom.continuous
        have hSub : E_P ⊆ closure ({j_P.base pq'} : Set ↥F_P) := by
          rw [← hη_cl]
          exact closure_minimal (Set.singleton_subset_iff.mpr hSpecF.mem_closure) isClosed_closure
        have hMaxEP := (Set.ext_iff.mp (irreducibleComponents_eq_maximals_closed ↥F_P) E_P).mp hEP
        have hEqCl : closure ({j_P.base pq'} : Set ↥F_P) = E_P :=
          le_antisymm (hMaxEP.2 ⟨isClosed_closure, isIrreducible_singleton.closure⟩ hSub) hSub
        have hInsep : Inseparable (j_P.base pq') η_E := by
          rw [inseparable_iff_closure_eq, hEqCl, hη_cl]
        have hEqPt : j_P.base pq' = j_P.base q₀ := by
          rw [hq₀_eq]; exact hInsep.eq
        exact le_of_eq (congrArg PrimeSpectrum.asIdeal (hInj_jP hEqPt).symm)
      have : Module.Flat R_mod B_P := inferInstance
      have : Algebra.HasGoingDown R_mod B_P := Algebra.HasGoingDown.of_flat
      let p₀ : Ideal R_mod := q₀.asIdeal.comap (algebraMap R_mod B_P)
      have hp₀_min : p₀ ∈ minimalPrimes R_mod := by
        refine ⟨⟨inferInstance, bot_le⟩, ?_⟩
