          refine ⟨m₁ + m₂, ?_⟩
          have hmul : c ^ (m₁ + m₂) * (w₁ * w₂) = (c ^ m₁ * w₁) * (c ^ m₂ * w₂) := by
            rw [pow_add]
            ring
          rw [hmul]
          exact A.mul_mem hm₁ hm₂
