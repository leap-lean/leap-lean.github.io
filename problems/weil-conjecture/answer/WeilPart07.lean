    have hhom₁ : χ₁ ≫ C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op =
        CommRingCat.ofHom (R := B_M1) (S := A₀₁) (res₁.comp ψ₁) := by
      apply CommRingCat.hom_ext; rfl
    rw [hhom₀, hhom₁]
    let α₀ : B_M0 →+* B_M01 :=
      (P_M.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D₀ ⊓ D₁ ≤ D₀)).op).hom
    let α₁ : B_M1 →+* B_M01 :=
      (P_M.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D₀ ⊓ D₁ ≤ D₁)).op).hom
    let _ : Algebra B_M1 B_M01 := α₁.toAlgebra
    have hD₀₁_eq : D₀ ⊓ D₁ = P_M.basicOpen (tM a₁ a₀) := by
      rw [hP8_M a₁ a₀, inf_comm]
    let _ : IsLocalization.Away (tM a₁ a₀) B_M01 :=
      (hAffM a₁).isLocalization_of_eq_basicOpen (tM a₁ a₀)
        (CategoryTheory.homOfLE inf_le_right) hD₀₁_eq
    let φ₁ : B_M1 →+* A₀₁ := res₁.comp ψ₁
    have hφ₁_t : φ₁ (tM a₁ a₀) = (res₁ s₁) ^ d := by
      dsimp only [φ₁, a₀]
      rw [RingHom.comp_apply, hψ₁_t 0, hv₁_0, map_pow]
    have hu₁ : IsUnit (φ₁ (tM a₁ a₀)) := by
      rw [hφ₁_t]
      exact IsUnit.of_mul_eq_one ((res₀ t₀) ^ d) (by rw [mul_comm, hts_pow])
    let φ_tilde : B_M01 →+* A₀₁ := IsLocalization.Away.lift (tM a₁ a₀) (S := B_M01) hu₁
    have hlift_α₁ : φ_tilde.comp α₁ = φ₁ := by
      apply RingHom.ext; intro y
      exact IsLocalization.Away.lift_eq (tM a₁ a₀) (S := B_M01) hu₁ y
    have hlift_α₀ : φ_tilde.comp α₀ = res₀.comp ψ₀ := by
      have ht01 : φ_tilde (α₀ (tM a₀ a₁)) = (res₀ t₀) ^ d := by
        have h10 := congrArg φ_tilde (hP10_M a₀ a₁ a₀)
        change φ_tilde (α₁ (tM a₁ a₀) * α₀ (tM a₀ a₁)) = φ_tilde (α₀ (tM a₀ a₀)) at h10
        rw [map_mul, hP5_M a₀, map_one, map_one] at h10
        have hα₁_t : φ_tilde (α₁ (tM a₁ a₀)) = (res₁ s₁) ^ d := by
          change (φ_tilde.comp α₁) (tM a₁ a₀) = _
          rw [hlift_α₁, hφ₁_t]
        rw [hα₁_t] at h10
        calc
          φ_tilde (α₀ (tM a₀ a₁))
            = ((res₀ t₀) ^ d * (res₁ s₁) ^ d) * φ_tilde (α₀ (tM a₀ a₁)) := by
                rw [hts_pow, one_mul]
          _ = (res₀ t₀) ^ d * ((res₁ s₁) ^ d * φ_tilde (α₀ (tM a₀ a₁))) := mul_assoc _ _ _
          _ = (res₀ t₀) ^ d := by rw [h10, mul_one]
      have htop : Subring.closure (Set.range (cM a₀) ∪ Set.range (tM a₀)) ≤
          (φ_tilde.comp α₀).eqLocus (res₀.comp ψ₀) := by
        rw [Subring.closure_le]
        rintro _ (⟨r, rfl⟩ | ⟨k, rfl⟩)
        · change φ_tilde (α₀ (cM a₀ r)) = res₀ (ψ₀ (cM a₀ r))
          have hc9 : α₀ (cM a₀ r) = α₁ (cM a₁ r) := (hP9_M a₀ a₁ r).symm
          rw [hc9]
          change (φ_tilde.comp α₁) (cM a₁ r) = res₀ (ψ₀ (cM a₀ r))
          rw [hlift_α₁]
          simp only [φ₁, RingHom.comp_apply]
          have hr₁ : ψ₁ (cM a₁ r) = ρ₁ r := RingHom.congr_fun hψ₁_c r
          have hr₀ : ψ₀ (cM a₀ r) = ρ₀ r := RingHom.congr_fun hψ₀_c r
          rw [hr₁, hr₀]
          exact (RingHom.congr_fun hρ_ov r).symm
        · change φ_tilde (α₀ (tM a₀ k)) = res₀ (ψ₀ (tM a₀ k))
          have hc10 : α₀ (tM a₀ k) = α₁ (tM a₁ k) * α₀ (tM a₀ a₁) := (hP10_M a₀ a₁ k).symm
          rw [hc10, map_mul, ht01]
          have hk₁ : φ_tilde (α₁ (tM a₁ k)) = res₁ (v₁ k) := by
            change (φ_tilde.comp α₁) (tM a₁ k) = _
            rw [hlift_α₁]
            simp [φ₁, hψ₁_t k]
          rw [hk₁, hcocycle k, hψ₀_t k]
          calc
            ((res₁ s₁) ^ d * res₀ (v₀ k)) * (res₀ t₀) ^ d
              = res₀ (v₀ k) * ((res₀ t₀) ^ d * (res₁ s₁) ^ d) := by ring
            _ = res₀ (v₀ k) := by rw [hts_pow, mul_one]
      rw [hP6_M a₀] at htop
      apply RingHom.ext; intro z
      exact RingHom.mem_eqLocus.mp (htop (trivial : z ∈ (⊤ : Subring B_M0)))
    have hcat₀ : CommRingCat.ofHom (R := B_M0) (S := A₀₁) (res₀.comp ψ₀) =
        P_M.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D₀ ⊓ D₁ ≤ D₀)).op ≫
          CommRingCat.ofHom (R := B_M01) (S := A₀₁) φ_tilde := by
      apply CommRingCat.hom_ext
      exact hlift_α₀.symm
    have hcat₁ : CommRingCat.ofHom (R := B_M1) (S := A₀₁) (res₁.comp ψ₁) =
        P_M.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D₀ ⊓ D₁ ≤ D₁)).op ≫
          CommRingCat.ofHom (R := B_M01) (S := A₀₁) φ_tilde := by
      apply CommRingCat.hom_ext
      exact hlift_α₁.symm
    rw [hcat₀, hcat₁, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
      Category.assoc, Category.assoc,
      (hAffM a₀).map_fromSpec hD₀₁ (CategoryTheory.homOfLE (inf_le_left : D₀ ⊓ D₁ ≤ D₀)).op,
      (hAffM a₁).map_fromSpec hD₀₁ (CategoryTheory.homOfLE (inf_le_right : D₀ ⊓ D₁ ≤ D₁)).op]

  
  
  
  let covObj : ULift.{u} Bool → AlgebraicGeometry.Scheme.{u} :=
    fun b => if b.down then U₁.toScheme else U₀.toScheme
  let covMap : ∀ b : ULift.{u} Bool, covObj b ⟶ C :=
    fun b =>
      match b with
      | ⟨false⟩ => U₀.ι
      | ⟨true⟩ => U₁.ι
  have hCovImm : ∀ b : ULift.{u} Bool, AlgebraicGeometry.IsOpenImmersion (covMap b) := by
    rintro ⟨false | true⟩ <;> dsimp [covMap] <;> infer_instance
  have hCovSurj : ∀ x : ↥C, ∃ (b : ULift.{u} Bool) (z : ↥(covObj b)), (covMap b).base z = x := by
    intro x
    have hx : x ∈ (U₀ ⊔ U₁ : C.Opens) := by rw [hU_top]; trivial
    rcases hx with hx₀ | hx₁
    · exact ⟨⟨false⟩, ⟨x, hx₀⟩, rfl⟩
    · exact ⟨⟨true⟩, ⟨x, hx₁⟩, rfl⟩
  let 𝒰 : C.OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
      (ULift.{u} Bool) covObj covMap hCovSurj hCovImm
  let f_fam : ∀ b : 𝒰.I₀, 𝒰.X b ⟶ P_M :=
    fun b =>
      match b with
      | ⟨false⟩ => f₀
      | ⟨true⟩ => f₁
  have hglue : ∀ b₁ b₂ : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f b₁) (𝒰.f b₂) ≫ f_fam b₁ =
        CategoryTheory.Limits.pullback.snd (𝒰.f b₁) (𝒰.f b₂) ≫ f_fam b₂ := by
    rintro ⟨false | true⟩ ⟨false | true⟩
    · have heq : CategoryTheory.Limits.pullback.fst (𝒰.f ⟨false⟩) (𝒰.f ⟨false⟩) =
          CategoryTheory.Limits.pullback.snd (𝒰.f ⟨false⟩) (𝒰.f ⟨false⟩) :=
        (cancel_mono U₀.ι).mp CategoryTheory.Limits.pullback.condition
      rw [heq]
    · let fst₀₁ := CategoryTheory.Limits.pullback.fst U₀.ι U₁.ι
      let snd₀₁ := CategoryTheory.Limits.pullback.snd U₀.ι U₁.ι
      have hrng₀₁ : Set.range (fst₀₁ ≫ U₀.ι).base ⊆ Set.range (U₀ ⊓ U₁).ι.base := by
        rintro _ ⟨z, rfl⟩
        have hz₀ : (fst₀₁ ≫ U₀.ι).base z ∈ U₀ := (fst₀₁.base z).2
        have hz₁ : (fst₀₁ ≫ U₀.ι).base z ∈ U₁ := by
          rw [CategoryTheory.Limits.pullback.condition (f := U₀.ι) (g := U₁.ι)]
          exact (snd₀₁.base z).2
        exact ⟨⟨(fst₀₁ ≫ U₀.ι).base z, ⟨hz₀, hz₁⟩⟩, rfl⟩
      let m₀₁ := AlgebraicGeometry.IsOpenImmersion.lift (U₀ ⊓ U₁).ι (fst₀₁ ≫ U₀.ι) hrng₀₁
      have hm_fst : m₀₁ ≫ C.homOfLE inf_le_left = fst₀₁ := by
        rw [← cancel_mono U₀.ι, Category.assoc, C.homOfLE_ι]
        exact AlgebraicGeometry.IsOpenImmersion.lift_fac (U₀ ⊓ U₁).ι (fst₀₁ ≫ U₀.ι) hrng₀₁
      have hm_snd : m₀₁ ≫ C.homOfLE inf_le_right = snd₀₁ := by
        rw [← cancel_mono U₁.ι, Category.assoc, C.homOfLE_ι,
          AlgebraicGeometry.IsOpenImmersion.lift_fac (U₀ ⊓ U₁).ι (fst₀₁ ≫ U₀.ι) hrng₀₁]
        exact CategoryTheory.Limits.pullback.condition
      change fst₀₁ ≫ f₀ = snd₀₁ ≫ f₁
      rw [← hm_fst, ← hm_snd, Category.assoc, Category.assoc, hoverlap]
    · let fst₁₀ := CategoryTheory.Limits.pullback.fst U₁.ι U₀.ι
      let snd₁₀ := CategoryTheory.Limits.pullback.snd U₁.ι U₀.ι
      have hrng₁₀ : Set.range (snd₁₀ ≫ U₀.ι).base ⊆ Set.range (U₀ ⊓ U₁).ι.base := by
        rintro _ ⟨z, rfl⟩
        have hz₀ : (snd₁₀ ≫ U₀.ι).base z ∈ U₀ := (snd₁₀.base z).2
        have hz₁ : (snd₁₀ ≫ U₀.ι).base z ∈ U₁ := by
          rw [← CategoryTheory.Limits.pullback.condition (f := U₁.ι) (g := U₀.ι)]
          exact (fst₁₀.base z).2
        exact ⟨⟨(snd₁₀ ≫ U₀.ι).base z, ⟨hz₀, hz₁⟩⟩, rfl⟩
      let m₁₀ := AlgebraicGeometry.IsOpenImmersion.lift (U₀ ⊓ U₁).ι (snd₁₀ ≫ U₀.ι) hrng₁₀
      have hm_snd : m₁₀ ≫ C.homOfLE inf_le_left = snd₁₀ := by
        rw [← cancel_mono U₀.ι, Category.assoc, C.homOfLE_ι]
        exact AlgebraicGeometry.IsOpenImmersion.lift_fac (U₀ ⊓ U₁).ι (snd₁₀ ≫ U₀.ι) hrng₁₀
      have hm_fst : m₁₀ ≫ C.homOfLE inf_le_right = fst₁₀ := by
        rw [← cancel_mono U₁.ι, Category.assoc, C.homOfLE_ι,
          AlgebraicGeometry.IsOpenImmersion.lift_fac (U₀ ⊓ U₁).ι (snd₁₀ ≫ U₀.ι) hrng₁₀]
        exact CategoryTheory.Limits.pullback.condition.symm
      change fst₁₀ ≫ f₁ = snd₁₀ ≫ f₀
      rw [← hm_fst, ← hm_snd, Category.assoc, Category.assoc, hoverlap]
    · have heq : CategoryTheory.Limits.pullback.fst (𝒰.f ⟨true⟩) (𝒰.f ⟨true⟩) =
          CategoryTheory.Limits.pullback.snd (𝒰.f ⟨true⟩) (𝒰.f ⟨true⟩) :=
        (cancel_mono U₁.ι).mp CategoryTheory.Limits.pullback.condition
      rw [heq]
  let ιP : C ⟶ P_M := 𝒰.glueMorphisms f_fam hglue
  have hιP_0 : U₀.ι ≫ ιP = f₀ := 𝒰.ι_glueMorphisms f_fam hglue ⟨false⟩
  have hιP_1 : U₁.ι ≫ ιP = f₁ := 𝒰.ι_glueMorphisms f_fam hglue ⟨true⟩
  have hιP_comm : ιP ≫ p_M = g := by
    refine 𝒰.hom_ext _ _ ?_
    rintro ⟨false | true⟩
    · change (U₀.ι ≫ ιP) ≫ p_M = U₀.ι ≫ g
      rw [hιP_0, hf₀_comm]
    · change (U₁.ι ≫ ιP) ≫ p_M = U₁.ι ≫ g
      rw [hιP_1, hf₁_comm]
  
  have hProp_ιP : AlgebraicGeometry.IsProper ιP := by
    let _ : AlgebraicGeometry.IsProper g := hProp_g
    let _ : AlgebraicGeometry.IsProper p_M := hProp_pM
    have _ : AlgebraicGeometry.IsProper (ιP ≫ p_M) := by rwa [hιP_comm]
    exact @AlgebraicGeometry.IsProper.of_comp _ _ _ ιP p_M _ _
  have hClosedRange : IsClosed (Set.range ιP.base) := by
    let _ : AlgebraicGeometry.IsProper ιP := hProp_ιP
    exact ιP.isClosedMap.isClosed_range
  
  have heq₀ : (TopologicalSpace.Opens.map ιP.base).obj D₀ = U₀ := by
    ext x
    constructor
    · intro hxD₀
      have hx_cov : x ∈ (U₀ ⊔ U₁ : C.Opens) := by rw [hU_top]; trivial
      rcases hx_cov with hx₀ | hx₁
      · exact hx₀
      · have hz₁ : f₁.base ⟨x, hx₁⟩ ∈ D₀ := by
          change (U₁.ι ≫ ιP).base ⟨x, hx₁⟩ ∈ D₀ at hxD₀
          rwa [hιP_1] at hxD₀
        have hx_inter : x ∈ (U₁.ι.opensFunctor).obj ((TopologicalSpace.Opens.map f₁.base).obj D₀) :=
          ⟨⟨x, hx₁⟩, hz₁, rfl⟩
        rw [hpre₁] at hx_inter
        exact hx_inter.1
    · intro hx₀
      change (U₀.ι ≫ ιP).base ⟨x, hx₀⟩ ∈ D₀
      rw [hιP_0]
      change (hAffM a₀).fromSpec.base
        ((hU₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map χ₀).base ⟨x, hx₀⟩) ∈ D₀
      have hrng := congrArg SetLike.coe (hAffM a₀).opensRange_fromSpec
      change _ ∈ (D₀ : Set P_M)
      rw [← hrng]
      exact ⟨_, rfl⟩
  have heq₁ : (TopologicalSpace.Opens.map ιP.base).obj D₁ = U₁ := by
    ext x
    constructor
    · intro hxD₁
      have hx_cov : x ∈ (U₀ ⊔ U₁ : C.Opens) := by rw [hU_top]; trivial
      rcases hx_cov with hx₀ | hx₁
      · have hz₀ : f₀.base ⟨x, hx₀⟩ ∈ D₁ := by
          change (U₀.ι ≫ ιP).base ⟨x, hx₀⟩ ∈ D₁ at hxD₁
          rwa [hιP_0] at hxD₁
        have hx_inter : x ∈ (U₀.ι.opensFunctor).obj ((TopologicalSpace.Opens.map f₀.base).obj D₁) :=
          ⟨⟨x, hx₀⟩, hz₀, rfl⟩
        rw [hpre₀] at hx_inter
        exact hx_inter.2
      · exact hx₁
    · intro hx₁
      change (U₁.ι ≫ ιP).base ⟨x, hx₁⟩ ∈ D₁
      rw [hιP_1]
      change (hAffM a₁).fromSpec.base
        ((hU₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map χ₁).base ⟨x, hx₁⟩) ∈ D₁
      have hrng := congrArg SetLike.coe (hAffM a₁).opensRange_fromSpec
      change _ ∈ (D₁ : Set P_M)
      rw [← hrng]
      exact ⟨_, rfl⟩
  
  let V_compl : P_M.Opens := ⟨(Set.range ιP.base)ᶜ, hClosedRange.isOpen_compl⟩
  let V_cov : Fin 3 → P_M.Opens := ![D₀, D₁, V_compl]
  have hV_top : (⨆ i : Fin 3, V_cov i) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hy : y ∈ Set.range ιP.base
    · rcases hy with ⟨x, rfl⟩
      have hx : x ∈ (U₀ ⊔ U₁ : C.Opens) := by rw [hU_top]; trivial
      rcases hx with hx₀ | hx₁
      · refine ⟨0, ?_⟩
        change x ∈ (TopologicalSpace.Opens.map ιP.base).obj D₀
        rwa [heq₀]
      · refine ⟨1, ?_⟩
        change x ∈ (TopologicalSpace.Opens.map ιP.base).obj D₁
        rwa [heq₁]
    · exact ⟨2, hy⟩
  have hCl_ιP : AlgebraicGeometry.IsClosedImmersion ιP := by
    refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top V_cov hV_top ?_
    intro i
    fin_cases i
    · change AlgebraicGeometry.IsClosedImmersion (ιP ∣_ D₀)
      have hres₀ : (ιP ∣_ D₀) =
          (C.isoOfEq heq₀).hom ≫ hU₀.isoSpec.hom ≫
            AlgebraicGeometry.Spec.map χ₀ ≫ (hAffM a₀).isoSpec.inv := by
        rw [← cancel_mono D₀.ι, AlgebraicGeometry.morphismRestrict_ι]
        simp only [Category.assoc]
        rw [(hAffM a₀).isoSpec_inv_ι]
        change (ιP ⁻¹ᵁ D₀).ι ≫ ιP = (C.isoOfEq heq₀).hom ≫ f₀
        rw [← hιP_0, ← Category.assoc, C.isoOfEq_hom_ι]
      rw [hres₀]
      have _ : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map χ₀) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective χ₀ hsurj₀
      infer_instance
    · change AlgebraicGeometry.IsClosedImmersion (ιP ∣_ D₁)
      have hres₁ : (ιP ∣_ D₁) =
          (C.isoOfEq heq₁).hom ≫ hU₁.isoSpec.hom ≫
            AlgebraicGeometry.Spec.map χ₁ ≫ (hAffM a₁).isoSpec.inv := by
        rw [← cancel_mono D₁.ι, AlgebraicGeometry.morphismRestrict_ι]
        simp only [Category.assoc]
        rw [(hAffM a₁).isoSpec_inv_ι]
        change (ιP ⁻¹ᵁ D₁).ι ≫ ιP = (C.isoOfEq heq₁).hom ≫ f₁
        rw [← hιP_1, ← Category.assoc, C.isoOfEq_hom_ι]
      rw [hres₁]
      have _ : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map χ₁) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective χ₁ hsurj₁
      infer_instance
    · change AlgebraicGeometry.IsClosedImmersion (ιP ∣_ V_compl)
      have _ : IsEmpty ↥((ιP ⁻¹ᵁ V_compl).toScheme) := ⟨fun z => z.2 ⟨z.1, rfl⟩⟩
      infer_instance
  exact ⟨M, ιP, hCl_ιP, hιP_comm⟩

theorem weil_strictlySemistable_proper_curve_projective_over_valuation (K : Type u) [Field K]
    [IsSepClosed K] (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_semi : C_semi ⟶ C')
    (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
    (ι_semi : C_K ⟶ C_semi)
    (hUnemb : IsUnembeddedSemistablePointedModel V p_K n σ_K g' τ'
      C_semi g_semi f_semi τ_semi ι_semi) :
    ∃ (M : ℕ) (ιP : C_semi ⟶ (weilProjectiveSpaceOver ↥V M).left),
      AlgebraicGeometry.IsClosedImmersion ιP ∧
      ιP ≫ (weilProjectiveSpaceOver ↥V M).hom = g_semi :=
by
  by_cases hMax : IsLocalRing.maximalIdeal ↥V = ⊥
  · have hSurjV : Function.Surjective V.subtype := by
      intro a
      by_cases ha0 : a = 0
      · exact ⟨0, by simp [ha0]⟩
      · rcases ValuationSubring.mem_or_inv_mem V a with ha | hainv
        · exact ⟨⟨a, ha⟩, rfl⟩
        · have hx_ne : (⟨a⁻¹, hainv⟩ : ↥V) ≠ 0 := by
            intro h
            exact inv_ne_zero ha0 (congrArg Subtype.val h)
          have hx_not_mem : (⟨a⁻¹, hainv⟩ : ↥V) ∉ IsLocalRing.maximalIdeal ↥V := by
            rw [hMax, Submodule.mem_bot]
            exact hx_ne
          have hx_unit : IsUnit (⟨a⁻¹, hainv⟩ : ↥V) :=
            IsLocalRing.notMem_maximalIdeal.mp hx_not_mem
          obtain ⟨u, hu⟩ := hx_unit
          let v : ↥V := ↑(u⁻¹)
          refine ⟨v, ?_⟩
          have hu_mul : (⟨a⁻¹, hainv⟩ : ↥V) * v = 1 := by
            dsimp [v]
            rw [← hu, Units.mul_inv]
          have huK : a⁻¹ * V.subtype v = 1 := by
            have h := congrArg V.subtype hu_mul
            rw [map_mul, map_one] at h
            exact h
          calc
            V.subtype v = a * (a⁻¹ * V.subtype v) := by
              rw [← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
            _ = a := by rw [huK, mul_one]
    let eV : ↥V ≃+* K := RingEquiv.ofBijective V.subtype ⟨Subtype.val_injective, hSurjV⟩
    let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    haveI hIsoη : CategoryTheory.IsIso η_V := by
      refine ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom eV.symm.toRingHom), ?_, ?_⟩⟩
      · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomp : V.subtype.comp eV.symm.toRingHom = RingHom.id K :=
          RingHom.ext fun x => eV.apply_symm_apply x
        rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomp : eV.symm.toRingHom.comp V.subtype = RingHom.id ↥V :=
          RingHom.ext fun x => eV.symm_apply_apply x
        rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have ⟨_hInt', _hFlat', _hProp', _hLfp', _hSurj', ⟨M', ιP', hCl', hComm'⟩,
      _hτ', hPb', _hσ'⟩ := hMod'
    have ⟨_hSS_semi, _hProp_f, _hf_g, _hProp_g, _hSurj_g, _hτ_f, _hτ_g,
      hPb_semi, _hσ_semi, _hDisj_semi, _hSm_semi, _hFib_semi⟩ := hUnemb
    haveI : AlgebraicGeometry.IsClosedImmersion ιP' := hCl'
    haveI : CategoryTheory.IsIso ι' := hPb'.isIso_fst_of_isIso
    haveI : CategoryTheory.IsIso ι_semi := hPb_semi.isIso_fst_of_isIso
    refine ⟨M', CategoryTheory.inv ι_semi ≫ ι' ≫ ιP', inferInstance, ?_⟩
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hComm',
      hPb'.w, ← hPb_semi.w, ← CategoryTheory.Category.assoc,
      CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
  · have ⟨_hFinSpec, _hCardSpec, _hHensel, _hDiv, hAlgRes, _hSatFG⟩ := hPkg
    have ⟨hSS_semi, _hProp_f, _hf_g, hProp_g, hSurj_g, _hτ_f, _hτ_g,
      _hPb_semi, _hσ_semi, _hDisj_semi, _hSm_semi, hFib_semi⟩ := hUnemb
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    letI : IsAlgClosed k₀ := hAlgRes (IsLocalRing.maximalIdeal ↥V) hMax
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g_semi s₀
    let p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
      CategoryTheory.Limits.pullback.snd g_semi s₀
    haveI : AlgebraicGeometry.IsProper g_semi := hProp_g
    have hPropY : AlgebraicGeometry.IsProper p_Y := inferInstance
    obtain ⟨hConnY, hNodalY⟩ := hFib_semi k₀ s₀
    obtain ⟨r_pts, k₁, σ_bar, π_bar, hPolar⟩ :=
      weil_nodal_closed_fiber_finite_polar_projLine_map k₀ Y p_Y hPropY hConnY hNodalY
    have ⟨_hk₁, _hπ_bar_comm, hSec_bar, hInj_bar, hSm_bar, hHit_bar,
      _hFin_bar, _hPole_bar, _hLocal_bar⟩ := hPolar
    obtain ⟨γ_div, W_div, t_div, hCompat, hLift⟩ :=
      weil_strictlySemistable_henselian_divisor_lift_and_specialization K m V hMax hPkg
        C_semi g_semi hSS_semi hProp_g r_pts σ_bar hSec_bar hInj_bar hSm_bar hHit_bar
    obtain ⟨π, hπ_comm, hπ_pole⟩ :=
      weil_strictlySemistable_polar_divisor_section_lift K m V hMax hPkg
        C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C' g' τ' ι' hMod'
        C_semi g_semi f_semi τ_semi ι_semi hUnemb
        r_pts k₁ σ_bar π_bar hPolar γ_div W_div t_div hCompat hLift
    have ⟨hLift_loc, _hLift_disj, hLift_hit⟩ := hLift
    have hFin_π : AlgebraicGeometry.IsFinite π :=
      weil_strictlySemistable_polar_projLine_map_isFinite K m V hPkg
        C_semi g_semi hSS_semi hProp_g hSurj_g r_pts γ_div
        (fun i => (hLift_loc i).1) hLift_hit π hπ_comm hπ_pole
    exact weil_finite_over_projLine_closedImmersion_projSpace ↥V C_semi g_semi π hFin_π hπ_comm

theorem weil_local_semistable_contraction_to_global_semistable_model (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (r : ℕ)
    (U_cov : Fin r → C'.Opens)
    (hCov : (⋃ a : Fin r, (U_cov a : Set C')) = Set.univ)
    (hNonempty : ∀ a : Fin r, Nonempty ↥(U_cov a))
    (U_ss : Fin r → AlgebraicGeometry.Scheme.{u})
    (g_ss : ∀ a : Fin r, U_ss a ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : ∀ a : Fin r, AlgebraicGeometry.IsAffine (U_ss a))
    (hSS : ∀ a : Fin r, IsStrictlySemistableCurveOverValuation V (g_ss a))
    (h_mod : ∀ a : Fin r, (U_cov a).toScheme ⟶ U_ss a)
    (hProp_mod : ∀ a : Fin r, AlgebraicGeometry.IsProper (h_mod a))
    (hComm_mod : ∀ a : Fin r, h_mod a ≫ g_ss a = (U_cov a).ι ≫ g')
    (ι_Ucov : ∀ a : Fin r,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ (U_cov a).toScheme)
    (hι_comm : ∀ a : Fin r,
      ι_Ucov a ≫ (U_cov a).ι =
        AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ ι')
    (hPb_Ucov : ∀ a : Fin r,
      CategoryTheory.IsPullback (ι_Ucov a)
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ p_K)
        ((U_cov a).ι ≫ g')
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : ∀ a : Fin r,
      CategoryTheory.IsPullback (ι_Ucov a ≫ h_mod a)
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ p_K)
        (g_ss a)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C'' : Fin r → AlgebraicGeometry.Scheme.{u})
    (g'' : ∀ a : Fin r, C'' a ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom : ∀ a : Fin r, C'' a ⟶ (U_cov a).toScheme)
    (τ'' : ∀ (a : Fin r) (j : Fin n),
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a)) ⟶ C'' a)
    (ι_C'' : ∀ a : Fin r,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ C'' a)
    (hRes : ∀ a : Fin r,
      IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' (U_cov a) (h_mod a) (ι_Ucov a)
        (C'' a) (g'' a) (f_dom a) (τ'' a) (ι_C'' a)) :
    ∃ (C_semi : AlgebraicGeometry.Scheme.{u})
      (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
      (ι_semi : C_K ⟶ C_semi),
      IsSemistableValuationPointedModel V p_K n σ_K C_semi g_semi τ_semi ι_semi :=
by
  have hLocContr : ∀ a : Fin r,
      ∃ (C_bar : AlgebraicGeometry.Scheme.{u})
        (g_bar : C_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_bar : C_bar ⟶ (U_cov a).toScheme)
        (τ_bar : ∀ j : Fin n,
          AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a)) ⟶ C_bar)
        (ι_bar : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ C_bar),
        IsLocalRelativeStableMod V p_K g' n τ' ι' (U_cov a) (ι_Ucov a)
          C_bar g_bar f_bar τ_bar ι_bar := by
    intro a
    exact weil_local_strictlySemistable_relative_contraction K m V hPkg C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK C' g' τ' ι' hMod' (U_cov a) (hNonempty a)
      (U_ss a) (g_ss a) (hAff_ss a) (hSS a) (h_mod a) (hProp_mod a) (hComm_mod a)
      (ι_Ucov a) (hι_comm a) (hPb_Ucov a) (hPb_ss a)
      (C'' a) (g'' a) (f_dom a) (τ'' a) (ι_C'' a) (hRes a)
  choose C_bar g_bar f_bar τ_bar ι_bar hRelStab using hLocContr
  have hOverlap : ∀ a b : Fin r,
      let U_ab : C'.Opens := U_cov a ⊓ U_cov b
      let V_ab : (C_bar a).Opens :=
        (TopologicalSpace.Opens.map (f_bar a ≫ (U_cov a).ι).base).obj U_ab
      let W_ab : (C_bar b).Opens :=
        (TopologicalSpace.Opens.map (f_bar b ≫ (U_cov b).ι).base).obj U_ab
      ∃ (φ : V_ab.toScheme ≅ W_ab.toScheme),
        φ.hom ≫ W_ab.ι ≫ f_bar b ≫ (U_cov b).ι = V_ab.ι ≫ f_bar a ≫ (U_cov a).ι ∧
        ∀ (ψ : V_ab.toScheme ⟶ W_ab.toScheme),
          ψ ≫ W_ab.ι ≫ f_bar b ≫ (U_cov b).ι = V_ab.ι ≫ f_bar a ≫ (U_cov a).ι →
          ψ = φ.hom := by
    intro a b
    exact weil_local_relative_stable_overlap_uniqueness K m V hPkg C_K p_K n σ_K
      hIntCK hSmCK hStabCK C' g' τ' ι' hMod' (U_cov a) (U_cov b) (hNonempty a) (hNonempty b)
      (ι_Ucov a) (ι_Ucov b) (hι_comm a) (hι_comm b) (hPb_Ucov a) (hPb_Ucov b)
      (C_bar a) (C_bar b) (g_bar a) (g_bar b) (f_bar a) (f_bar b)
      (τ_bar a) (τ_bar b) (ι_bar a) (ι_bar b) (hRelStab a) (hRelStab b)
  obtain ⟨C_semi, g_semi, f_semi, τ_semi, ι_semi, hUnemb⟩ :=
    weil_glue_local_relative_stable_models_over_cover K m V hPkg C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK C' g' τ' ι' hMod' r U_cov hCov hNonempty
      ι_Ucov hι_comm hPb_Ucov C_bar g_bar f_bar τ_bar ι_bar hRelStab hOverlap
  obtain ⟨M, ιP, hCl, hComm⟩ :=
    weil_strictlySemistable_proper_curve_projective_over_valuation K m V hPkg C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK C' g' τ' ι' hMod' C_semi g_semi f_semi τ_semi ι_semi hUnemb
  obtain ⟨hSS_semi, _hProp_f, _hf_g, hProp_g, hSurj_g, _hτ_f, hτ_g, hPb_semi, hσ_semi,
    hDisj_semi, hSm_semi, hFib_semi⟩ := hUnemb
  obtain ⟨hInt_semi, hFlat_semi, _hSep_semi, hLfp_semi, _hCharts_semi⟩ := hSS_semi
  refine ⟨C_semi, g_semi, τ_semi, ι_semi, ?_⟩
  exact ⟨⟨hInt_semi, hFlat_semi, hProp_g, hLfp_semi, hSurj_g, ⟨M, ιP, hCl, hComm⟩,
    hτ_g, hPb_semi, hσ_semi⟩, hDisj_semi, hSm_semi, hFib_semi⟩

theorem weil_closed_fiber_unstable_p1_boundary_dichotomy (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (h3n : 3 ≤ n)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)).Finite ∧
    (HasStablePointedGeomFiber g n τ k₀ s₀ ∨
      ∃ Z Z_sch ιZ, IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ) :=
by
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  change (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)).Finite ∧
    (HasStablePointedGeomFiber g n τ k₀ s₀ ∨
      ∃ Z Z_sch ιZ, IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
  let Y : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g s₀
  let fst_Y : Y ⟶ C := CategoryTheory.Limits.pullback.fst g s₀
  let π_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
    CategoryTheory.Limits.pullback.snd g s₀
  have : (IsLocalRing.maximalIdeal ↥V).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal ↥V).isPrime
  obtain ⟨_, _, _, _, hAlgClosedPkg, _⟩ := hPkg
  have : IsAlgClosed k₀ := hAlgClosedPkg (IsLocalRing.maximalIdeal ↥V) hMaxNeBot
  obtain ⟨⟨_hIntC, _hFlat, hProp, _hLFP, _hSurj, _hProj, hSec, _hPb, _hSec_ι⟩,
    hDisj, hSmSec, hGeom⟩ := hSemi
  have : AlgebraicGeometry.IsProper g := hProp
  have hConnY : ConnectedSpace ↥Y := (hGeom k₀ s₀).1
  have : AlgebraicGeometry.IsLocallyNoetherian Y :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian π_Y
  have : CompactSpace ↥Y :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace π_Y
  have : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  have hFin : (irreducibleComponents ↥Y).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
  have h_etale_max_zero : ∀ (L : Type u) [Field L] (B : Type u) [CommRing B] [Algebra L B]
      [Algebra.Etale L B] (R_loc : Type u) [CommRing R_loc] [IsLocalRing R_loc]
      (Φ : B →+* R_loc) (z : B),
      Φ z ∈ IsLocalRing.maximalIdeal R_loc → Φ z = 0 := by
    intro L _ B _ _ _ R_loc _ _ Φ z hz
    classical
    obtain ⟨I, _, Ai, hFieldAi, hAlgAi, hEquiv, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod L B).mp inferInstance
    let _ : ∀ i : I, Field (Ai i) := hFieldAi
    let _ : ∀ i : I, Algebra L (Ai i) := hAlgAi
    let z' : ∀ i : I, Ai i := hEquiv z
    let e' : ∀ i : I, Ai i := fun i => if z' i = 0 then 1 else 0
    let e : B := hEquiv.symm e'
    have hze : z * e = 0 := by
      apply hEquiv.injective
      rw [map_mul, hEquiv.apply_symm_apply, map_zero]
      ext i
      change z' i * (if z' i = 0 then 1 else 0) = 0
      split_ifs with h <;> simp [h]
    have hu_ze' : IsUnit (z' + e') := by
      rw [Pi.isUnit_iff]
      intro i
      rw [isUnit_iff_ne_zero]
      change z' i + (if z' i = 0 then 1 else 0) ≠ 0
      split_ifs with h
      · simp [h]
      · simpa using h
    have hu_ze : IsUnit (z + e) := by
      have h1 : IsUnit (hEquiv.symm.toRingHom (z' + e')) := hu_ze'.map hEquiv.symm.toRingHom
      simpa [e, z', map_add] using h1
    have hu_sum : IsUnit (Φ z + Φ e) := by
      simpa [map_add] using hu_ze.map Φ
    have he_not_max : Φ e ∉ IsLocalRing.maximalIdeal R_loc := by
      intro he_mem
      exact IsLocalRing.notMem_maximalIdeal.mpr hu_sum (Ideal.add_mem _ hz he_mem)
    rcases IsLocalRing.notMem_maximalIdeal.mp he_not_max with ⟨u, hu⟩
    have hmul_zero : Φ z * Φ e = 0 := by
      rw [← map_mul, hze, map_zero]
    calc Φ z = Φ z * (↑u * ↑u⁻¹) := by simp
      _ = (Φ z * Φ e) * ↑u⁻¹ := by rw [← mul_assoc, hu]
      _ = 0 := by rw [hmul_zero, zero_mul]
  have h_stalk_dom : ∀ (R₀ : Type u) [Field R₀] (S : Type u) [CommRing S]
      [Algebra (Polynomial R₀) S] [Algebra.Etale (Polynomial R₀) S]
      (q : Ideal S) [q.IsPrime],
      True ∧ IsDomain (Localization.AtPrime q) := by
    intro R₀ _ S _ _ _ q _
    refine ⟨trivial, ?_⟩
    have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing (Polynomial R₀) S
    have : Module.Flat (Polynomial R₀) S := Algebra.Smooth.flat (Polynomial R₀) S
    have : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) inferInstance
    have : Module.Flat (Polynomial R₀) (Localization.AtPrime q) :=
      Localization.flat S q.primeCompl
    have : Module.IsTorsionFree (Polynomial R₀) (Localization.AtPrime q) :=
      Module.Flat.isTorsionFree
    let p : Ideal (Polynomial R₀) := Ideal.comap (algebraMap (Polynomial R₀) S) q
    have : p.IsPrime := Ideal.IsPrime.comap _
    by_cases hp : p = ⊥
    · have hunits : ∀ y : nonZeroDivisors (Polynomial R₀),
          IsUnit (algebraMap (Polynomial R₀) (Localization.AtPrime q) y) := by
        intro y
        have hy_ne : (y : Polynomial R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        have hy_not_p : (y : Polynomial R₀) ∉ p := by
          rw [hp]
          exact hy_ne
        have hy_compl : algebraMap (Polynomial R₀) S y ∈ q.primeCompl := hy_not_p
        rw [IsScalarTower.algebraMap_apply (Polynomial R₀) S (Localization.AtPrime q)]
        exact IsLocalization.map_units (Localization.AtPrime q)
          ⟨algebraMap (Polynomial R₀) S y, hy_compl⟩
      let ψ_ring : FractionRing (Polynomial R₀) →+* Localization.AtPrime q :=
        IsLocalization.lift hunits
      let ψ_alg : FractionRing (Polynomial R₀) →ₐ[Polynomial R₀] Localization.AtPrime q :=
        { ψ_ring with
          commutes' := fun a => IsLocalization.lift_eq hunits a }
      let Φ_alg : TensorProduct (Polynomial R₀) (FractionRing (Polynomial R₀)) S →ₐ[Polynomial R₀]
          Localization.AtPrime q :=
        Algebra.TensorProduct.lift ψ_alg
          (IsScalarTower.toAlgHom (Polynomial R₀) S (Localization.AtPrime q))
          (fun _ _ => Commute.all _ _)
      have hmax_bot : IsLocalRing.maximalIdeal (Localization.AtPrime q) = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro w hw
        obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl w
        have hΦ_mem : Φ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          have hΦ_eq : Φ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) =
              w * algebraMap S (Localization.AtPrime q) t.1 := by
            change Φ_alg (1 ⊗ₜ[Polynomial R₀] s) = _
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            exact hst.symm
          rw [hΦ_eq]
          exact Ideal.mul_mem_right _ _ hw
        have hs_zero : algebraMap S (Localization.AtPrime q) s = 0 := by
