theorem weil_twoAffineCover_monic_eval_nonZeroDivisor (R : Type u) [CommRing R] [IsLocalRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (V₀ V₁ : C.Opens)
    (h₀ : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁))) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal R).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let fstY := CategoryTheory.Limits.pullback.fst g s₀
    let R₀ := C.presheaf.obj (Opposite.op V₀)
    let R₁ := C.presheaf.obj (Opposite.op V₁)
    let φ₀ : R →+* ↑R₀ := (
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom
    let φ₁ : R →+* ↑R₁ := (
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom
    let I_m0 : Ideal ↑R₀ := Ideal.map φ₀ (IsLocalRing.maximalIdeal R)
    let I_m1 : Ideal ↑R₁ := Ideal.map φ₁ (IsLocalRing.maximalIdeal R)
    AlgebraicGeometry.IsAffineOpen V₀ →
    AlgebraicGeometry.IsAffineOpen V₁ →
    V₀ ⊔ V₁ = ⊤ →
    C.basicOpen h₀ = V₀ ⊓ V₁ →
    C.basicOpen t₀ = V₀ ⊓ V₁ →
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom h₀ *
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom t₀ = 1 →
    (∀ (K' : Type u) [Field K']
        (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (E : Set ↥(CategoryTheory.Limits.pullback g s)),
      E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) →
      (∀ U_aff : (CategoryTheory.Limits.pullback g s).Opens,
        AlgebraicGeometry.IsAffineOpen U_aff →
        (E \ (U_aff : Set ↥(CategoryTheory.Limits.pullback g s))).Nonempty) →
      (((CategoryTheory.Limits.pullback.fst g s).base ⁻¹' ((V₀ ⊓ V₁ : C.Opens) : Set C)) ∩ E).Nonempty) ∧
    ((∀ E ∈ irreducibleComponents ↥Y,
        ∀ U_aff : Y.Opens, AlgebraicGeometry.IsAffineOpen U_aff → (E \ (U_aff : Set ↥Y)).Nonempty) →
      ∀ (ψ₀ : AlgebraicGeometry.Spec (CommRingCat.of (↑R₀ ⧸ I_m0)) ⟶ Y)
        (ψ₁ : AlgebraicGeometry.Spec (CommRingCat.of (↑R₁ ⧸ I_m1)) ⟶ Y),
        Set.range ψ₀.base = fstY.base ⁻¹' (V₀ : Set C) →
        (∀ (a : ↑R₀) (p : AlgebraicGeometry.Spec (CommRingCat.of (↑R₀ ⧸ I_m0))),
          fstY.base (ψ₀.base p) ∈ (C.basicOpen a : Set C) ↔ Ideal.Quotient.mk I_m0 a ∉ p.asIdeal) →
        IsReduced (↑R₀ ⧸ I_m0) →
        (∀ p ∈ minimalPrimes (↑R₀ ⧸ I_m0),
          ∃ E ∈ irreducibleComponents ↥Y,
            ψ₀.base ⁻¹' E = PrimeSpectrum.zeroLocus (p : Set (↑R₀ ⧸ I_m0))) →
        Set.range ψ₁.base = fstY.base ⁻¹' (V₁ : Set C) →
        (∀ (a : ↑R₁) (p : AlgebraicGeometry.Spec (CommRingCat.of (↑R₁ ⧸ I_m1))),
          fstY.base (ψ₁.base p) ∈ (C.basicOpen a : Set C) ↔ Ideal.Quotient.mk I_m1 a ∉ p.asIdeal) →
        IsReduced (↑R₁ ⧸ I_m1) →
        (∀ p ∈ minimalPrimes (↑R₁ ⧸ I_m1),
          ∃ E ∈ irreducibleComponents ↥Y,
            ψ₁.base ⁻¹' E = PrimeSpectrum.zeroLocus (p : Set (↑R₁ ⧸ I_m1))) →
        (∀ r : ℕ, ∀ b : ↑R₀ ⧸ I_m0, Ideal.Quotient.mk I_m0 (h₀ ^ r) * b = 0 → b = 0) ∧
        (∀ r : ℕ, ∀ b : ↑R₁ ⧸ I_m1, Ideal.Quotient.mk I_m1 (t₀ ^ r) * b = 0 → b = 0) ∧
        (∀ Q : Polynomial R, Q.Monic →
          ∀ b : ↑R₁ ⧸ I_m1, Ideal.Quotient.mk I_m1 (Polynomial.eval₂ φ₁ t₀ Q) * b = 0 → b = 0)) :=
by
  intro k₀ s₀ Y fstY R₀ R₁ φ₀ φ₁ I_m0 I_m1 hAff₀ hAff₁ hCov hBas₀ hBas₁ _hInv
