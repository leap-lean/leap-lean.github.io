        ψ_Y S' hS' ⟨(z : F), hB_mono S S' hS hsub z.2⟩)
    (U_Y0 U_Y1 : Y.Opens)
    (f_bar_0 : ↑(Y.presheaf.obj (Opposite.op U_Y0)))
    (s_bar_1 : ↑(Y.presheaf.obj (Opposite.op U_Y1)))
    (x_Y : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y a))))
    (hCharts : U_Y0 ⊔ U_Y1 = ⊤ ∧
      AlgebraicGeometry.IsAffineOpen U_Y0 ∧
      AlgebraicGeometry.IsAffineOpen U_Y1 ∧
      Y.basicOpen f_bar_0 = U_Y0 ⊓ U_Y1 ∧
      Y.basicOpen s_bar_1 = U_Y0 ⊓ U_Y1 ∧
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Y0 ⊓ U_Y1 ≤ U_Y0)).op).hom
        f_bar_0 *
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1)).op).hom
        s_bar_1 = 1)
    (hGlobSplit : ∀ h : ↑(Y.presheaf.obj (Opposite.op (U_Y0 ⊓ U_Y1))),
      ∃ (a₀ : ↑(Y.presheaf.obj (Opposite.op U_Y0)))
        (a₁ : ↑(Y.presheaf.obj (Opposite.op U_Y1))),
        h =
          ((Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1)).op).hom s_bar_1) ^ m₀ *
          (Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_left : U_Y0 ⊓ U_Y1 ≤ U_Y0)).op).hom a₀ -
          (Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1)).op).hom a₁)
    (hx_Y_cocycle : ∀ a b : Fin (N + 1),
      (Y.presheaf.map (CategoryTheory.homOfLE
        (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b)))).op).hom (x_Y b) *
      (ψ_Y {a, b} (Finset.insert_nonempty a {b})
        ⟨t_loc a / t_loc b,
          ht_ratio {a, b} (Finset.insert_nonempty a {b})
            a (Finset.mem_insert_self a {b})
            b (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))⟩) ^ k =
      (Y.presheaf.map (CategoryTheory.homOfLE
        (Finset.inf_le (Finset.mem_insert_self a {b}))).op).hom (x_Y a))
    (hTriv : ∀ a : Fin (N + 1),
      let t_Ya := (Y.presheaf.map (CategoryTheory.homOfLE
        (le_of_eq Finset.inf_singleton.symm)).op).hom
        (ψ_Y {a} (Finset.singleton_nonempty a) ⟨t_loc a, (ht_mem a).1⟩)
      IsUnit ((Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_left : W_Y a ⊓ U_Y0 ≤ W_Y a)).op).hom t_Ya) ∧
      IsUnit ((Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_left : W_Y a ⊓ U_Y1 ≤ W_Y a)).op).hom (x_Y a)) ∧
      (Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_left : W_Y a ⊓ (U_Y0 ⊓ U_Y1) ≤ W_Y a)).op).hom (x_Y a) *
        ((Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_right.trans inf_le_right : W_Y a ⊓ (U_Y0 ⊓ U_Y1) ≤ U_Y1)).op).hom
          s_bar_1) ^ m₀ =
      ((Y.presheaf.map (CategoryTheory.homOfLE
        (inf_le_left : W_Y a ⊓ (U_Y0 ⊓ U_Y1) ≤ W_Y a)).op).hom t_Ya) ^ k) :
    ∃ (x_bar : Fin (N + 1) → F)
      (hx_mem : ∀ a : Fin (N + 1), x_bar a ∈ B {a}),
      (∀ a : Fin (N + 1),
        (Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq Finset.inf_singleton.symm)).op).hom
          (ψ_Y {a} (Finset.singleton_nonempty a) ⟨x_bar a, hx_mem a⟩) = x_Y a) ∧
      (∀ a b : Fin (N + 1),
        ∃ (π_ab : ↥V) (w_ab : F),
          π_ab ∈ IsLocalRing.maximalIdeal ↥V ∧
          w_ab ∈ B {a, b} ∧
          x_bar b * (t_loc a / t_loc b) ^ k - x_bar a = φ_VF π_ab * w_ab) ∧
      (∀ (p : ℕ) (ξ : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I} → F),
        (∀ I, (t_loc (I.1 0)) ^ k * ξ I ∈ B (Finset.univ.image I.1)) →
        (∀ J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J},
          ∃ (π_J : ↥V) (b_J : F),
            π_J ∈ IsLocalRing.maximalIdeal ↥V ∧
            b_J ∈ B (Finset.univ.image J.1) ∧
            (t_loc (J.1 0)) ^ k *
              (∑ q : Fin (p + 3), (-1 : F) ^ (q : ℕ) *
                ξ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩) =
              φ_VF π_J * b_J) →
        ∃ η : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F,
          (∀ I, (t_loc (I.1 0)) ^ k * η I ∈ B (Finset.univ.image I.1)) ∧
          ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
            ∃ (π_I : ↥V) (b_I : F),
              π_I ∈ IsLocalRing.maximalIdeal ↥V ∧
              b_I ∈ B (Finset.univ.image I.1) ∧
              (t_loc (I.1 0)) ^ k *
                ((∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
                  η ⟨I.1 ∘ q.succAbove, I.2.comp (Fin.strictMono_succAbove q)⟩) - ξ I) =
                φ_VF π_I * b_I) :=
by
  
  let ρ : ∀ {U₁ U₂ : Y.Opens}, U₂ ≤ U₁ →
      (↑(Y.presheaf.obj (Opposite.op U₁)) →+* ↑(Y.presheaf.obj (Opposite.op U₂))) :=
    fun h => (Y.presheaf.map (CategoryTheory.homOfLE h).op).hom
  have hρ_congr : ∀ {U₁ U₂ : Y.Opens} (h₁ h₂ : U₂ ≤ U₁)
      (x : ↑(Y.presheaf.obj (Opposite.op U₁))),
      ρ h₁ x = ρ h₂ x := fun _ _ _ => rfl
  have hρ_comp : ∀ {U₁ U₂ U₃ : Y.Opens} (h₁ : U₂ ≤ U₁) (h₂ : U₃ ≤ U₂)
      (x : ↑(Y.presheaf.obj (Opposite.op U₁))),
      ρ h₂ (ρ h₁ x) = ρ (h₂.trans h₁) x := by
    intro U₁ U₂ U₃ h₁ h₂ x
    have hop : (CategoryTheory.homOfLE h₁).op ≫ (CategoryTheory.homOfLE h₂).op =
        (CategoryTheory.homOfLE (h₂.trans h₁)).op :=
      congrArg Quiver.Hom.op (Subsingleton.elim _ _)
    change (Y.presheaf.map (CategoryTheory.homOfLE h₁).op ≫
      Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom x = _
    rw [← CategoryTheory.Functor.map_comp, hop]
  have hρ_id : ∀ {U₁ : Y.Opens} (h₁ : U₁ ≤ U₁)
      (x : ↑(Y.presheaf.obj (Opposite.op U₁))),
      ρ h₁ x = x := by
    intro U₁ h₁ x
    have hid : (CategoryTheory.homOfLE h₁).op = 𝟙 (Opposite.op U₁) :=
      congrArg Quiver.Hom.op (Subsingleton.elim (CategoryTheory.homOfLE h₁) (𝟙 U₁))
    dsimp only [ρ]
    rw [hid, CategoryTheory.Functor.map_id]
    rfl
  have hAff_inf : ∀ (S : Finset (Fin (N + 1))), S.Nonempty →
      AlgebraicGeometry.IsAffineOpen (Finset.inf S W_Y) := by
    intro S hS
    induction hS using Finset.Nonempty.cons_induction with
    | singleton a =>
      rw [Finset.inf_singleton]
      exact hWY_cov.2 a
    | cons a T ha hT ih =>
      rw [Finset.inf_cons]
      exact hAffInter (W_Y a) (Finset.inf T W_Y) (hWY_cov.2 a) ih
  have h_inf_inter : ∀ (S : Finset (Fin (N + 1))), S.Nonempty → ∀ (U : Y.Opens),
      (Finset.inf S W_Y) ⊓ U = Finset.inf S (fun a => W_Y a ⊓ U) := by
    intro S hS U
    induction hS using Finset.Nonempty.cons_induction with
    | singleton a =>
      rw [Finset.inf_singleton, Finset.inf_singleton]
    | cons a T ha hT ih =>
      rw [Finset.inf_cons, Finset.inf_cons, inf_inf_distrib_right, ih]

  
  have h_bin_glue : ∀ (W : Y.Opens)
      (s₀ : ↑(Y.presheaf.obj (Opposite.op (W ⊓ U_Y0))))
      (s₁ : ↑(Y.presheaf.obj (Opposite.op (W ⊓ U_Y1)))),
      ρ (inf_le_inf_left W inf_le_left : W ⊓ (U_Y0 ⊓ U_Y1) ≤ W ⊓ U_Y0) s₀ =
        ρ (inf_le_inf_left W inf_le_right : W ⊓ (U_Y0 ⊓ U_Y1) ≤ W ⊓ U_Y1) s₁ →
      ∃! s : ↑(Y.presheaf.obj (Opposite.op W)),
        ρ (inf_le_left : W ⊓ U_Y0 ≤ W) s = s₀ ∧
        ρ (inf_le_left : W ⊓ U_Y1 ≤ W) s = s₁ := by
    intro W s₀ s₁ h_eq
    let U_cov : ULift.{u} Bool → Y.Opens := fun b =>
      match b.down with
      | false => W ⊓ U_Y0
      | true => W ⊓ U_Y1
    let iUV : ∀ b, U_cov b ⟶ W := fun b =>
      match b with
      | ⟨false⟩ => CategoryTheory.homOfLE inf_le_left
      | ⟨true⟩ => CategoryTheory.homOfLE inf_le_left
    have hcov : W ≤ ⨆ b, U_cov b := by
      have hW : W = (W ⊓ U_Y0) ⊔ (W ⊓ U_Y1) := by
        rw [← inf_sup_left, hCharts.1, inf_top_eq]
      rw [hW]
      exact sup_le (le_iSup U_cov ⟨false⟩) (le_iSup U_cov ⟨true⟩)
    let sf : ∀ b, ↑(Y.presheaf.obj (Opposite.op (U_cov b))) := fun b =>
      match b with
      | ⟨false⟩ => s₀
      | ⟨true⟩ => s₁
    have hcompat : Y.presheaf.IsCompatible U_cov sf := by
      intro i j
      rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
      · rfl
      · have hle : (W ⊓ U_Y0) ⊓ (W ⊓ U_Y1) ≤ W ⊓ (U_Y0 ⊓ U_Y1) :=
          le_inf (inf_le_left.trans inf_le_left)
            (le_inf (inf_le_left.trans inf_le_right) (inf_le_right.trans inf_le_right))
        have h := congrArg (ρ hle) h_eq
        rw [hρ_comp, hρ_comp] at h
        exact h
      · have hle : (W ⊓ U_Y1) ⊓ (W ⊓ U_Y0) ≤ W ⊓ (U_Y0 ⊓ U_Y1) :=
          le_inf (inf_le_left.trans inf_le_left)
            (le_inf (inf_le_right.trans inf_le_right) (inf_le_left.trans inf_le_right))
        have h := congrArg (ρ hle) h_eq.symm
        rw [hρ_comp, hρ_comp] at h
        exact h
      · rfl
    obtain ⟨s, hs, huniq⟩ := Y.sheaf.existsUnique_gluing' U_cov W iUV hcov sf hcompat
    refine ⟨s, ⟨hs ⟨false⟩, hs ⟨true⟩⟩, ?_⟩
    intro t ⟨ht0, ht1⟩
    apply huniq t
    rintro ⟨_ | _⟩
    · exact ht0
    · exact ht1

  have h_bin_ext : ∀ (W : Y.Opens) (t₁ t₂ : ↑(Y.presheaf.obj (Opposite.op W))),
      ρ (inf_le_left : W ⊓ U_Y0 ≤ W) t₁ = ρ (inf_le_left : W ⊓ U_Y0 ≤ W) t₂ →
      ρ (inf_le_left : W ⊓ U_Y1 ≤ W) t₁ = ρ (inf_le_left : W ⊓ U_Y1 ≤ W) t₂ →
      t₁ = t₂ := by
    intro W t₁ t₂ h0 h1
    have h_eq : ρ (inf_le_inf_left W inf_le_left : W ⊓ (U_Y0 ⊓ U_Y1) ≤ W ⊓ U_Y0)
        (ρ (inf_le_left : W ⊓ U_Y0 ≤ W) t₁) =
        ρ (inf_le_inf_left W inf_le_right : W ⊓ (U_Y0 ⊓ U_Y1) ≤ W ⊓ U_Y1)
        (ρ (inf_le_left : W ⊓ U_Y1 ≤ W) t₁) := by
      rw [hρ_comp, hρ_comp]
    exact (h_bin_glue W _ _ h_eq).unique ⟨rfl, rfl⟩ ⟨h0.symm, h1.symm⟩

  
  have hGlue0 : ∀ (U : Y.Opens) (V_cov : Fin (N + 1) → Y.Opens)
      (hle : ∀ a : Fin (N + 1), V_cov a ≤ U),
      (⨆ a : Fin (N + 1), V_cov a) = U →
      ∀ (δ : ∀ K : {K : Fin 1 → Fin (N + 1) // StrictMono K},
          ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image K.1) V_cov)))),
        (∀ I : {I : Fin 2 → Fin (N + 1) // StrictMono I},
          (∑ r : Fin 2,
            (-1 : ℤ) ^ (r : ℕ) •
              ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))
                (δ ⟨I.1 ∘ r.succAbove, I.2.comp (Fin.strictMono_succAbove r)⟩)) = 0) →
        ∃ h : ↑(Y.presheaf.obj (Opposite.op U)),
          ∀ K : {K : Fin 1 → Fin (N + 1) // StrictMono K},
            δ K = ρ ((Finset.inf_le (f := V_cov)
              (Finset.mem_image_of_mem K.1 (Finset.mem_univ 0))).trans (hle (K.1 0)) :
              Finset.inf (Finset.univ.image K.1) V_cov ≤ U) h := by
    intro U V_cov hle hsup δ hδ
    let K₀ : Fin (N + 1) → {K : Fin 1 → Fin (N + 1) // StrictMono K} :=
      fun a => ⟨fun _ => a, fun i j hij => absurd hij (by omega)⟩
    have hK₀_inf : ∀ a : Fin (N + 1),
        Finset.inf (Finset.univ.image (K₀ a).1) V_cov = V_cov a := by
      intro a
      have himg : Finset.univ.image (K₀ a).1 = {a} := by
        ext x
        simp [K₀]
      rw [himg, Finset.inf_singleton]
    let U_idx : ULift.{u} (Fin (N + 1)) → Y.Opens := fun i => V_cov i.down
    let iUV : ∀ i, U_idx i ⟶ U := fun i => CategoryTheory.homOfLE (hle i.down)
    have hcov : U ≤ ⨆ i, U_idx i := by
      rw [← hsup]
      exact iSup_le fun a => le_iSup U_idx ⟨a⟩
    let sf : ∀ i, ↑(Y.presheaf.obj (Opposite.op (U_idx i))) :=
      fun i => ρ (le_of_eq (hK₀_inf i.down).symm) (δ (K₀ i.down))
    have h_lt : ∀ {x y : Fin (N + 1)}, x < y →
        ∀ {W : Y.Opens} (hx : W ≤ V_cov x) (hy : W ≤ V_cov y),
          ρ hx (sf ⟨x⟩) = ρ hy (sf ⟨y⟩) := by
      intro x y hxy W hx hy
      let I_xy : {I : Fin 2 → Fin (N + 1) // StrictMono I} :=
        ⟨![x, y], fun i j hij => by
          fin_cases i <;> fin_cases j <;> simp at hij ⊢
          exact hxy⟩
      have hface0 : (⟨I_xy.1 ∘ (0 : Fin 2).succAbove,
          I_xy.2.comp (Fin.strictMono_succAbove 0)⟩ :
          {K : Fin 1 → Fin (N + 1) // StrictMono K}) = K₀ y := by
        ext t; fin_cases t; rfl
      have hface1 : (⟨I_xy.1 ∘ (1 : Fin 2).succAbove,
          I_xy.2.comp (Fin.strictMono_succAbove 1)⟩ :
          {K : Fin 1 → Fin (N + 1) // StrictMono K}) = K₀ x := by
        ext t; fin_cases t; rfl
      have hW_le : W ≤ Finset.inf (Finset.univ.image I_xy.1) V_cov := by
        refine Finset.le_inf fun a ha => ?_
        rcases Finset.mem_image.mp ha with ⟨t, _, rfl⟩
        fin_cases t
        · exact hx
        · exact hy
      have hc := congrArg (ρ hW_le) (hδ I_xy)
      rw [Fin.sum_univ_two, map_add, map_zero, map_zsmul, map_zsmul,
        hρ_comp, hρ_comp] at hc
      have h0_eval : ∀ (K : {K : Fin 1 → Fin (N + 1) // StrictMono K})
          (hK : W ≤ Finset.inf (Finset.univ.image K.1) V_cov) (hEq : K = K₀ y),
          ρ hK (δ K) = ρ hy (sf ⟨y⟩) := by
        rintro _ hK rfl
        dsimp only [sf]
        rw [hρ_comp]
      have h1_eval : ∀ (K : {K : Fin 1 → Fin (N + 1) // StrictMono K})
          (hK : W ≤ Finset.inf (Finset.univ.image K.1) V_cov) (hEq : K = K₀ x),
          ρ hK (δ K) = ρ hx (sf ⟨x⟩) := by
        rintro _ hK rfl
        dsimp only [sf]
        rw [hρ_comp]
      rw [h0_eval _ _ hface0, h1_eval _ _ hface1] at hc
      simp only [Fin.val_zero, pow_zero, one_smul, Fin.val_one, pow_one, neg_one_smul] at hc
      exact (add_neg_eq_zero.mp hc).symm
    have hcompat : Y.presheaf.IsCompatible U_idx sf := by
      intro i j
      rcases lt_trichotomy i.down j.down with hij | hij | hij
      · exact h_lt hij inf_le_left inf_le_right
      · have heq : i = j := ULift.ext _ _ hij
        subst heq
        rfl
      · exact (h_lt hij inf_le_right inf_le_left).symm
    obtain ⟨h_raw, hh_raw, _⟩ := Y.sheaf.existsUnique_gluing' U_idx U iUV hcov sf hcompat
    let h : ↑(Y.presheaf.obj (Opposite.op U)) := h_raw
    have hh : ∀ a : Fin (N + 1), ρ (hle a) h = sf ⟨a⟩ := fun a => hh_raw ⟨a⟩
    refine ⟨h, fun K => ?_⟩
    have hK_eq : K = K₀ (K.1 0) := by
      ext t; fin_cases t; rfl
    have h_app := congrArg (ρ (le_of_eq (hK₀_inf (K.1 0)))) (hh (K.1 0))
    dsimp only [sf] at h_app
    rw [hρ_comp, hρ_comp, hρ_id] at h_app
    have h_trans : ∀ (K' : {K : Fin 1 → Fin (N + 1) // StrictMono K})
        (hEq : K' = K₀ (K.1 0))
        (hL : Finset.inf (Finset.univ.image K'.1) V_cov ≤ U),
        δ K' = ρ hL h := by
      rintro _ rfl hL
      exact h_app.symm
    exact h_trans K hK_eq _

  have h_succAbove_comp : ∀ {q : ℕ} (r s : Fin (q + 2)), (r : ℕ) ≤ (s : ℕ) →
      ∀ m : Fin (q + 1), r.castSucc.succAbove (s.succAbove m) = s.succ.succAbove (r.succAbove m) := by
    intro q r s hrs m
    ext
    simp only [Fin.succAbove, Fin.lt_def]
    split_ifs <;> simp only [Fin.val_castSucc, Fin.val_succ] at * <;> omega

  have hd_sq : ∀ (V_cov : Fin (N + 1) → Y.Opens) (q : ℕ)
      (c : ∀ L : {L : Fin (q + 1) → Fin (N + 1) // StrictMono L},
        ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image L.1) V_cov))))
      (I : {I : Fin (q + 3) → Fin (N + 1) // StrictMono I}),
      (∑ r : Fin (q + 3),
        (-1 : ℤ) ^ (r : ℕ) •
          ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
            Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))
            (∑ s : Fin (q + 2),
              (-1 : ℤ) ^ (s : ℕ) •
                ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                  Finset.mem_image_of_mem (I.1 ∘ r.succAbove)
                    (Finset.mem_univ (s.succAbove t))))
                  (c ⟨(I.1 ∘ r.succAbove) ∘ s.succAbove,
                    (I.2.comp (Fin.strictMono_succAbove r)).comp
                      (Fin.strictMono_succAbove s)⟩))) = 0 := by
    intro V_cov q c I
    let W_I : Y.Opens := Finset.inf (Finset.univ.image I.1) V_cov
    let eval_L : ∀ (L : {L : Fin (q + 1) → Fin (N + 1) // StrictMono L}),
        (W_I ≤ Finset.inf (Finset.univ.image L.1) V_cov) →
        ↑(Y.presheaf.obj (Opposite.op W_I)) :=
      fun L hL => ρ hL (c L)
    have heval_congr : ∀ {L₁ L₂ : {L : Fin (q + 1) → Fin (N + 1) // StrictMono L}}
        (h₁ : W_I ≤ Finset.inf (Finset.univ.image L₁.1) V_cov)
        (h₂ : W_I ≤ Finset.inf (Finset.univ.image L₂.1) V_cov),
        L₁ = L₂ → eval_L L₁ h₁ = eval_L L₂ h₂ := by
      rintro L₁ L₂ h₁ h₂ rfl
      rfl
    let L_rs : Fin (q + 3) × Fin (q + 2) → {L : Fin (q + 1) → Fin (N + 1) // StrictMono L} :=
      fun p => ⟨(I.1 ∘ p.1.succAbove) ∘ p.2.succAbove,
        (I.2.comp (Fin.strictMono_succAbove p.1)).comp (Fin.strictMono_succAbove p.2)⟩
    have hL_rs : ∀ p : Fin (q + 3) × Fin (q + 2),
        W_I ≤ Finset.inf (Finset.univ.image (L_rs p).1) V_cov :=
      fun p => (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
        Finset.mem_image_of_mem I.1 (Finset.mem_univ (p.1.succAbove t)))).trans
        (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
          Finset.mem_image_of_mem (I.1 ∘ p.1.succAbove) (Finset.mem_univ (p.2.succAbove t))))
    have h_rewrite : (∑ r : Fin (q + 3),
        (-1 : ℤ) ^ (r : ℕ) •
          ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
            Finset.mem_image_of_mem I.1 (Finset.mem_univ (r.succAbove t))))
            (∑ s : Fin (q + 2),
              (-1 : ℤ) ^ (s : ℕ) •
                ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                  Finset.mem_image_of_mem (I.1 ∘ r.succAbove)
                    (Finset.mem_univ (s.succAbove t))))
                  (c (L_rs (r, s))))) =
        ∑ p : Fin (q + 3) × Fin (q + 2),
          (-1 : ℤ) ^ ((p.1 : ℕ) + (p.2 : ℕ)) • eval_L (L_rs p) (hL_rs p) := by
      rw [Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_sum, Finset.smul_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [map_zsmul, smul_smul, ← pow_add, hρ_comp]
    rw [h_rewrite]
    let g : Fin (q + 3) × Fin (q + 2) → Fin (q + 3) × Fin (q + 2) := fun p =>
      if hp : (p.1 : ℕ) ≤ (p.2 : ℕ) then
        (p.2.succ, ⟨p.1.1, by omega⟩)
      else
        (p.2.castSucc, ⟨p.1.1 - 1, by omega⟩)
    apply Finset.sum_ninvolution g
    · intro p
      have hL_eq : L_rs p = L_rs (g p) := by
        by_cases hp : (p.1 : ℕ) ≤ (p.2 : ℕ)
        · have hg : g p = (p.2.succ, ⟨p.1.1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
          rw [hg]
          apply Subtype.ext
          funext m
          let r' : Fin (q + 2) := ⟨p.1.1, by omega⟩
          have hr' : r'.castSucc = p.1 := Fin.ext rfl
          change I.1 (p.1.succAbove (p.2.succAbove m)) =
            I.1 (p.2.succ.succAbove (r'.succAbove m))
          rw [← hr', h_succAbove_comp r' p.2 hp m]
        · have hg : g p = (p.2.castSucc, ⟨p.1.1 - 1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
          rw [hg]
          apply Subtype.ext
          funext m
          let s' : Fin (q + 2) := ⟨p.1.1 - 1, by omega⟩
          have hs' : s'.succ = p.1 := by ext; simp [s']; omega
          have hrs' : (p.2 : ℕ) ≤ (s' : ℕ) := by simp [s']; omega
          change I.1 (p.1.succAbove (p.2.succAbove m)) =
            I.1 (p.2.castSucc.succAbove (s'.succAbove m))
          rw [← hs', (h_succAbove_comp p.2 s' hrs' m).symm]
      rw [heval_congr (hL_rs (g p)) (hL_rs p) hL_eq.symm, ← add_smul]
      have hsign : (-1 : ℤ) ^ ((p.1 : ℕ) + (p.2 : ℕ)) +
          (-1 : ℤ) ^ (((g p).1 : ℕ) + ((g p).2 : ℕ)) = 0 := by
        by_cases hp : (p.1 : ℕ) ≤ (p.2 : ℕ)
        · have hg : g p = (p.2.succ, ⟨p.1.1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
          have hexp : ((g p).1 : ℕ) + ((g p).2 : ℕ) = ((p.1 : ℕ) + (p.2 : ℕ)) + 1 := by
            rw [hg]; simp; omega
          rw [hexp, pow_succ]; ring
        · have hg : g p = (p.2.castSucc, ⟨p.1.1 - 1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
          have hexp : (p.1 : ℕ) + (p.2 : ℕ) = (((g p).1 : ℕ) + ((g p).2 : ℕ)) + 1 := by
            rw [hg]; simp; omega
          rw [hexp, pow_succ]; ring
      rw [hsign, zero_smul]
    · intro p _ hgp
      by_cases hp : (p.1 : ℕ) ≤ (p.2 : ℕ)
      · have hg : g p = (p.2.succ, ⟨p.1.1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
        have h1 : ((g p).1 : ℕ) = (p.1 : ℕ) := congrArg (fun x => (x.1 : ℕ)) hgp
        rw [hg] at h1; simp at h1; omega
      · have hg : g p = (p.2.castSucc, ⟨p.1.1 - 1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
        have h1 : ((g p).1 : ℕ) = (p.1 : ℕ) := congrArg (fun x => (x.1 : ℕ)) hgp
        rw [hg] at h1; simp at h1; omega
    · intro p
      exact Finset.mem_univ _
    · intro p
      by_cases hp : (p.1 : ℕ) ≤ (p.2 : ℕ)
      · have hg : g p = (p.2.succ, ⟨p.1.1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
        rw [hg]
        have hnot : ¬ ((p.2.succ : ℕ) ≤ (p.1.1 : ℕ)) := by simp; omega
        simp only [g, hnot, ↓reduceDIte]
        ext <;> simp
      · have hg : g p = (p.2.castSucc, ⟨p.1.1 - 1, by omega⟩) := by simp only [g, hp, ↓reduceDIte]
        rw [hg]
        have hle' : ((p.2.castSucc : ℕ) ≤ ((⟨p.1.1 - 1, by omega⟩ : Fin (q + 2)) : ℕ)) := by
          simp; omega
        simp only [g, hle', ↓reduceDIte]
        ext <;> (simp; try omega)

  
  have hx_lift : ∀ a : Fin (N + 1),
      ∃ z : ↥(B {a}),
        ψ_Y {a} (Finset.singleton_nonempty a) z =
          ρ (le_of_eq Finset.inf_singleton) (x_Y a) :=
    fun a => (hψ_surj_ker {a} (Finset.singleton_nonempty a)).1
      (ρ (le_of_eq Finset.inf_singleton) (x_Y a))
  choose z_x hz_x using hx_lift
  let x_bar : Fin (N + 1) → F := fun a => (z_x a : F)
  have hx_mem : ∀ a : Fin (N + 1), x_bar a ∈ B {a} := fun a => (z_x a).2
  have hx_psi : ∀ a : Fin (N + 1),
      (Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq Finset.inf_singleton.symm)).op).hom
        (ψ_Y {a} (Finset.singleton_nonempty a) ⟨x_bar a, hx_mem a⟩) = x_Y a := by
    intro a
    change ρ (le_of_eq Finset.inf_singleton.symm)
      (ψ_Y {a} (Finset.singleton_nonempty a) (z_x a)) = x_Y a
    rw [hz_x a, hρ_comp, hρ_id]
  have hx_cocycle_mod : ∀ a b : Fin (N + 1),
      ∃ (π_ab : ↥V) (w_ab : F),
        π_ab ∈ IsLocalRing.maximalIdeal ↥V ∧
        w_ab ∈ B {a, b} ∧
        x_bar b * (t_loc a / t_loc b) ^ k - x_bar a = φ_VF π_ab * w_ab := by
    intro a b
    have hSab : ({a, b} : Finset (Fin (N + 1))).Nonempty := Finset.insert_nonempty a {b}
    have ha_sub : ({a} : Finset (Fin (N + 1))) ⊆ {a, b} :=
      Finset.singleton_subset_iff.mpr (Finset.mem_insert_self a {b})
    have hb_sub : ({b} : Finset (Fin (N + 1))) ⊆ {a, b} :=
      Finset.singleton_subset_iff.mpr (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))
    let xb_ab : ↥(B {a, b}) :=
      ⟨x_bar b, hB_mono {b} {a, b} (Finset.singleton_nonempty b) hb_sub (hx_mem b)⟩
    let xa_ab : ↥(B {a, b}) :=
      ⟨x_bar a, hB_mono {a} {a, b} (Finset.singleton_nonempty a) ha_sub (hx_mem a)⟩
    let rat_ab : ↥(B {a, b}) :=
      ⟨t_loc a / t_loc b, ht_ratio {a, b} hSab
        a (Finset.mem_insert_self a {b})
        b (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))⟩
    let d_ab : ↥(B {a, b}) := xb_ab * rat_ab ^ k - xa_ab
    have hd_zero : ψ_Y {a, b} hSab d_ab = 0 := by
      dsimp only [d_ab]
      rw [map_sub, map_mul, map_pow]
      have hrb : ψ_Y {a, b} hSab xb_ab =
          ρ (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))) (x_Y b) := by
        have h1 := (hψ_res {b} {a, b} (Finset.singleton_nonempty b) hSab hb_sub (z_x b)).symm
        change ψ_Y {a, b} hSab xb_ab = ρ (Finset.inf_mono hb_sub) (ψ_Y {b} _ (z_x b)) at h1
        rw [h1, hz_x b, hρ_comp]
      have hra : ψ_Y {a, b} hSab xa_ab =
          ρ (Finset.inf_le (Finset.mem_insert_self a {b})) (x_Y a) := by
        have h1 := (hψ_res {a} {a, b} (Finset.singleton_nonempty a) hSab ha_sub (z_x a)).symm
        change ψ_Y {a, b} hSab xa_ab = ρ (Finset.inf_mono ha_sub) (ψ_Y {a} _ (z_x a)) at h1
        rw [h1, hz_x a, hρ_comp]
      rw [hrb, hra]
      exact sub_eq_zero.mpr (hx_Y_cocycle a b)
    obtain ⟨π_ab, w_ab, hπ_ab, hw_ab, hd_eq⟩ := ((hψ_surj_ker {a, b} hSab).2 d_ab).mp hd_zero
    exact ⟨π_ab, w_ab, hπ_ab, hw_ab, hd_eq⟩

  let g_Y : ∀ a b : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (Finset.inf {a, b} W_Y))) :=
    fun a b =>
      (ψ_Y {a, b} (Finset.insert_nonempty a {b})
        ⟨t_loc a / t_loc b,
          ht_ratio {a, b} (Finset.insert_nonempty a {b})
            a (Finset.mem_insert_self a {b})
            b (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))⟩) ^ k
  let t_Ya : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y a))) :=
    fun a => ρ (le_of_eq Finset.inf_singleton.symm)
      (ψ_Y {a} (Finset.singleton_nonempty a) ⟨t_loc a, (ht_mem a).1⟩)

  have ht_Ya_cocycle : ∀ a b : Fin (N + 1),
      (ρ (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))) (t_Ya b)) ^ k *
        g_Y a b =
      (ρ (Finset.inf_le (Finset.mem_insert_self a {b})) (t_Ya a)) ^ k := by
    intro a b
    have hSab : ({a, b} : Finset (Fin (N + 1))).Nonempty := Finset.insert_nonempty a {b}
    have ha_sub : ({a} : Finset (Fin (N + 1))) ⊆ {a, b} :=
      Finset.singleton_subset_iff.mpr (Finset.mem_insert_self a {b})
    have hb_sub : ({b} : Finset (Fin (N + 1))) ⊆ {a, b} :=
      Finset.singleton_subset_iff.mpr (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))
    let zb : ↥(B {a, b}) :=
      ⟨t_loc b, hB_mono {b} {a, b} (Finset.singleton_nonempty b) hb_sub (ht_mem b).1⟩
    let zab : ↥(B {a, b}) :=
      ⟨t_loc a / t_loc b, ht_ratio {a, b} hSab
        a (Finset.mem_insert_self a {b})
        b (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))⟩
    let za : ↥(B {a, b}) :=
      ⟨t_loc a, hB_mono {a} {a, b} (Finset.singleton_nonempty a) ha_sub (ht_mem a).1⟩
    have hprod : zb ^ k * zab ^ k = za ^ k := by
      rw [← mul_pow]
      congr 1
      exact Subtype.ext (mul_div_cancel₀ (t_loc a) (ht_mem b).2)
    have hpsi := congrArg (ψ_Y {a, b} hSab) hprod
    rw [map_mul, map_pow, map_pow, map_pow] at hpsi
    have hrb : ψ_Y {a, b} hSab zb =
        ρ (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))) (t_Ya b) := by
      have h1 := (hψ_res {b} {a, b} (Finset.singleton_nonempty b) hSab hb_sub
        ⟨t_loc b, (ht_mem b).1⟩).symm
      change ψ_Y {a, b} hSab zb = ρ (Finset.inf_mono hb_sub) _ at h1
      dsimp only [t_Ya]
      rw [h1, hρ_comp]
    have hra : ψ_Y {a, b} hSab za =
        ρ (Finset.inf_le (Finset.mem_insert_self a {b})) (t_Ya a) := by
      have h1 := (hψ_res {a} {a, b} (Finset.singleton_nonempty a) hSab ha_sub
        ⟨t_loc a, (ht_mem a).1⟩).symm
      change ψ_Y {a, b} hSab za = ρ (Finset.inf_mono ha_sub) _ at h1
      dsimp only [t_Ya]
      rw [h1, hρ_comp]
    rw [hrb, hra] at hpsi
    exact hpsi

  
  have h_scale_coboundary : ∀ (m : ℕ)
      (ζ : {I : Fin (m + 1) → Fin (N + 1) // StrictMono I} → F)
      (hζ : ∀ I, (t_loc (I.1 0)) ^ k * ζ I ∈ B (Finset.univ.image I.1))
      (J : {J : Fin (m + 2) → Fin (N + 1) // StrictMono J}),
      let S_J := Finset.univ.image J.1
      let hSJ : S_J.Nonempty := ⟨J.1 0, Finset.mem_image_of_mem J.1 (Finset.mem_univ 0)⟩
      ∃ (z_sum : ↥(B S_J)),
        (z_sum : F) = (t_loc (J.1 0)) ^ k *
          (∑ q : Fin (m + 2), (-1 : F) ^ (q : ℕ) *
            ζ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩) ∧
        ψ_Y S_J hSJ z_sum =
          ∑ q : Fin (m + 2),
            (-1 : ℤ) ^ (q : ℕ) •
              (ρ (Finset.inf_mono (Finset.insert_subset_iff.mpr
                  ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
                   Finset.singleton_subset_iff.mpr
                     (Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove 0)))⟩))
                (g_Y (J.1 0) (J.1 (q.succAbove 0))) *
               ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                  Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove t))))
                (ψ_Y (Finset.univ.image (J.1 ∘ q.succAbove))
                  ⟨(J.1 ∘ q.succAbove) 0,
                    Finset.mem_image_of_mem (J.1 ∘ q.succAbove) (Finset.mem_univ 0)⟩
                  ⟨(t_loc ((J.1 ∘ q.succAbove) 0)) ^ k *
                    ζ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩,
                    hζ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩⟩)) := by
    intro m ζ hζ J S_J hSJ
    let a := J.1 0
    let u_q : ∀ q : Fin (m + 2), ↥(B S_J) := fun q =>
      have hsub_pair : ({a, J.1 (q.succAbove 0)} : Finset (Fin (N + 1))) ⊆ S_J :=
        Finset.insert_subset_iff.mpr
          ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
           Finset.singleton_subset_iff.mpr
             (Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove 0)))⟩
      ⟨t_loc a / t_loc (J.1 (q.succAbove 0)),
        hB_mono {a, J.1 (q.succAbove 0)} S_J (Finset.insert_nonempty _ _) hsub_pair
          (ht_ratio {a, J.1 (q.succAbove 0)} (Finset.insert_nonempty _ _)
            a (Finset.mem_insert_self _ _)
            (J.1 (q.succAbove 0)) (Finset.mem_insert_of_mem (Finset.mem_singleton_self _)))⟩
    let v_q : ∀ q : Fin (m + 2), ↥(B S_J) := fun q =>
      let I_q : {I : Fin (m + 1) → Fin (N + 1) // StrictMono I} :=
        ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩
      have hsub_face : Finset.univ.image I_q.1 ⊆ S_J :=
        Finset.image_subset_iff.mpr fun t _ =>
          Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove t))
      ⟨(t_loc (I_q.1 0)) ^ k * ζ I_q,
        hB_mono (Finset.univ.image I_q.1) S_J
          ⟨I_q.1 0, Finset.mem_image_of_mem I_q.1 (Finset.mem_univ 0)⟩ hsub_face (hζ I_q)⟩
    let z_sum : ↥(B S_J) := ∑ q : Fin (m + 2), (-1 : ℤ) ^ (q : ℕ) • ((u_q q) ^ k * v_q q)
    refine ⟨z_sum, ?_, ?_⟩
    · change (B S_J).subtype z_sum = _
      dsimp only [z_sum]
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [map_zsmul, map_mul, map_pow, zsmul_eq_mul, Int.cast_pow, Int.cast_neg, Int.cast_one]
      change (-1 : F) ^ (q : ℕ) *
          ((t_loc a / t_loc (J.1 (q.succAbove 0))) ^ k *
            ((t_loc (J.1 (q.succAbove 0))) ^ k *
              ζ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩)) =
        (t_loc a) ^ k *
          ((-1 : F) ^ (q : ℕ) *
            ζ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩)
      have hcancel : (t_loc a / t_loc (J.1 (q.succAbove 0))) ^ k *
          (t_loc (J.1 (q.succAbove 0))) ^ k = (t_loc a) ^ k := by
        rw [← mul_pow, div_mul_cancel₀ (t_loc a) (ht_mem (J.1 (q.succAbove 0))).2]
      rw [← mul_assoc ((t_loc a / t_loc (J.1 (q.succAbove 0))) ^ k), hcancel]
      ring
    · dsimp only [z_sum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [map_zsmul, map_mul, map_pow]
      congr 1
      congr 1
      · have hsub_pair : ({a, J.1 (q.succAbove 0)} : Finset (Fin (N + 1))) ⊆ S_J :=
          Finset.insert_subset_iff.mpr
            ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
             Finset.singleton_subset_iff.mpr
               (Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove 0)))⟩
        have h1 := (hψ_res {a, J.1 (q.succAbove 0)} S_J
          (Finset.insert_nonempty _ _) hSJ hsub_pair
          ⟨t_loc a / t_loc (J.1 (q.succAbove 0)),
            ht_ratio {a, J.1 (q.succAbove 0)} (Finset.insert_nonempty _ _)
              a (Finset.mem_insert_self _ _)
              (J.1 (q.succAbove 0)) (Finset.mem_insert_of_mem (Finset.mem_singleton_self _))⟩).symm
        change ψ_Y S_J hSJ (u_q q) = ρ (Finset.inf_mono hsub_pair) _ at h1
        rw [h1, ← map_pow]
      · have hsub_face : Finset.univ.image (J.1 ∘ q.succAbove) ⊆ S_J :=
          Finset.image_subset_iff.mpr fun t _ =>
            Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove t))
        have h1 := (hψ_res (Finset.univ.image (J.1 ∘ q.succAbove)) S_J
          ⟨(J.1 ∘ q.succAbove) 0, Finset.mem_image_of_mem _ (Finset.mem_univ 0)⟩
          hSJ hsub_face
          ⟨(t_loc ((J.1 ∘ q.succAbove) 0)) ^ k *
            ζ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩,
            hζ ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩⟩).symm
        exact h1

  
  refine ⟨x_bar, hx_mem, hx_psi, hx_cocycle_mod, ?_⟩
  intro p ξ hξ_mem hξ_cocycle

  
  let z_bar : ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
      ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) W_Y))) :=
    fun I => ψ_Y (Finset.univ.image I.1)
      ⟨I.1 0, Finset.mem_image_of_mem I.1 (Finset.mem_univ 0)⟩
      ⟨(t_loc (I.1 0)) ^ k * ξ I, hξ_mem I⟩
  have hz_cocycle : ∀ J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J},
      (∑ q : Fin (p + 3),
        (-1 : ℤ) ^ (q : ℕ) •
          (ρ (Finset.inf_mono (Finset.insert_subset_iff.mpr
              ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
               Finset.singleton_subset_iff.mpr
                 (Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove 0)))⟩))
            (g_Y (J.1 0) (J.1 (q.succAbove 0))) *
           ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
              Finset.mem_image_of_mem J.1 (Finset.mem_univ (q.succAbove t))))
            (z_bar ⟨J.1 ∘ q.succAbove, J.2.comp (Fin.strictMono_succAbove q)⟩))) = 0 := by
    intro J
    obtain ⟨z_sum, hz_coe, hz_psi⟩ := h_scale_coboundary (p + 1) ξ hξ_mem J
    obtain ⟨π_J, b_J, hπ_J, hb_J, h_eq_J⟩ := hξ_cocycle J
    have hz_zero : ψ_Y (Finset.univ.image J.1)
        ⟨J.1 0, Finset.mem_image_of_mem J.1 (Finset.mem_univ 0)⟩ z_sum = 0 :=
      ((hψ_surj_ker (Finset.univ.image J.1) _).2 z_sum).mpr
        ⟨π_J, b_J, hπ_J, hb_J, hz_coe.trans h_eq_J⟩
    exact hz_psi.symm.trans hz_zero

  
  let V₀ : Fin (N + 1) → Y.Opens := fun a => W_Y a ⊓ U_Y0
  let V₁ : Fin (N + 1) → Y.Opens := fun a => W_Y a ⊓ U_Y1
  let V₀₁ : Fin (N + 1) → Y.Opens := fun a => W_Y a ⊓ (U_Y0 ⊓ U_Y1)
  obtain ⟨μ₀, hμ₀_def⟩ : ∃ μ₀ : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (V₀ a))),
      ∀ a, μ₀ a = (ρ (inf_le_left : V₀ a ≤ W_Y a) (t_Ya a)) ^ k :=
    ⟨fun a => (ρ (inf_le_left : V₀ a ≤ W_Y a) (t_Ya a)) ^ k, fun _ => rfl⟩
  obtain ⟨μ₁, hμ₁_def⟩ : ∃ μ₁ : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (V₁ a))),
      ∀ a, μ₁ a = ρ (inf_le_left : V₁ a ≤ W_Y a) (x_Y a) :=
    ⟨fun a => ρ (inf_le_left : V₁ a ≤ W_Y a) (x_Y a), fun _ => rfl⟩
  have hμ₀_isUnit : ∀ a : Fin (N + 1), IsUnit (μ₀ a) := by
    intro a; rw [hμ₀_def a]; exact (hTriv a).1.pow k
  have hμ₁_isUnit : ∀ a : Fin (N + 1), IsUnit (μ₁ a) := by
    intro a; rw [hμ₁_def a]; exact (hTriv a).2.1
  obtain ⟨inv₀, hμ₀_inv_mul, hμ₀_mul_inv⟩ :
      ∃ inv₀ : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (V₀ a))),
        (∀ a, inv₀ a * μ₀ a = 1) ∧ (∀ a, μ₀ a * inv₀ a = 1) :=
    ⟨fun a => ↑(((hμ₀_isUnit a).unit)⁻¹),
      fun a => by
        have h := Units.inv_mul (hμ₀_isUnit a).unit
        rwa [(hμ₀_isUnit a).unit_spec] at h,
      fun a => by
        have h := Units.mul_inv (hμ₀_isUnit a).unit
        rwa [(hμ₀_isUnit a).unit_spec] at h⟩
  obtain ⟨inv₁, hμ₁_inv_mul, hμ₁_mul_inv⟩ :
      ∃ inv₁ : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (V₁ a))),
        (∀ a, inv₁ a * μ₁ a = 1) ∧ (∀ a, μ₁ a * inv₁ a = 1) :=
    ⟨fun a => ↑(((hμ₁_isUnit a).unit)⁻¹),
      fun a => by
        have h := Units.inv_mul (hμ₁_isUnit a).unit
        rwa [(hμ₁_isUnit a).unit_spec] at h,
      fun a => by
        have h := Units.mul_inv (hμ₁_isUnit a).unit
        rwa [(hμ₁_isUnit a).unit_spec] at h⟩

  have hμ₀_cocycle : ∀ a b : Fin (N + 1),
      ρ (inf_le_inf_right U_Y0
        (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b)))) (μ₀ b) *
      ρ (inf_le_left : Finset.inf {a, b} W_Y ⊓ U_Y0 ≤ Finset.inf {a, b} W_Y) (g_Y a b) =
      ρ (inf_le_inf_right U_Y0 (Finset.inf_le (Finset.mem_insert_self a {b}))) (μ₀ a) := by
    intro a b
    calc
      ρ (inf_le_inf_right U_Y0
          (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b)))) (μ₀ b) *
        ρ (inf_le_left : Finset.inf {a, b} W_Y ⊓ U_Y0 ≤ Finset.inf {a, b} W_Y) (g_Y a b)
        = ρ (inf_le_left : Finset.inf {a, b} W_Y ⊓ U_Y0 ≤ Finset.inf {a, b} W_Y)
            ((ρ (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b)))
              (t_Ya b)) ^ k * g_Y a b) := by
          rw [hμ₀_def b, map_mul, RingHom.map_pow _ (ρ _ (t_Ya b)) k,
            RingHom.map_pow _ (ρ _ (t_Ya b)) k, hρ_comp _ _ (t_Ya b), hρ_comp _ _ (t_Ya b)]
      _ = ρ (inf_le_left : Finset.inf {a, b} W_Y ⊓ U_Y0 ≤ Finset.inf {a, b} W_Y)
            ((ρ (Finset.inf_le (Finset.mem_insert_self a {b})) (t_Ya a)) ^ k) := by
          rw [ht_Ya_cocycle a b]
      _ = ρ (inf_le_inf_right U_Y0 (Finset.inf_le (Finset.mem_insert_self a {b}))) (μ₀ a) := by
          rw [hμ₀_def a, map_pow, map_pow, hρ_comp _ _ (t_Ya a), hρ_comp _ _ (t_Ya a)]

  have hμ₁_cocycle : ∀ a b : Fin (N + 1),
      ρ (inf_le_inf_right U_Y1
        (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b)))) (μ₁ b) *
      ρ (inf_le_left : Finset.inf {a, b} W_Y ⊓ U_Y1 ≤ Finset.inf {a, b} W_Y) (g_Y a b) =
      ρ (inf_le_inf_right U_Y1 (Finset.inf_le (Finset.mem_insert_self a {b}))) (μ₁ a) := by
    intro a b
    have h := congrArg (ρ (inf_le_left : Finset.inf {a, b} W_Y ⊓ U_Y1 ≤ Finset.inf {a, b} W_Y))
      (hx_Y_cocycle a b)
    change ρ _ (ρ _ (x_Y b) * g_Y a b) = ρ _ (ρ _ (x_Y a)) at h
    rw [map_mul, hρ_comp _ _ (x_Y b), hρ_comp _ _ (x_Y a)] at h
    rw [hμ₁_def b, hμ₁_def a, hρ_comp _ _ (x_Y b), hρ_comp _ _ (x_Y a)]
    exact h

  have hμ_bridge : ∀ a : Fin (N + 1),
      ρ (inf_le_inf_left (W_Y a) inf_le_right : V₀₁ a ≤ V₁ a) (μ₁ a) *
      (ρ (inf_le_right.trans inf_le_right : V₀₁ a ≤ U_Y1) s_bar_1) ^ m₀ =
      ρ (inf_le_inf_left (W_Y a) inf_le_left : V₀₁ a ≤ V₀ a) (μ₀ a) := by
    intro a
    rw [hμ₁_def a, hμ₀_def a, map_pow, hρ_comp _ _ (x_Y a), hρ_comp _ _ (t_Ya a)]
    exact (hTriv a).2.2

  let α₀ : ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
      ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) V₀))) :=
    fun I =>
      ρ (Finset.inf_le (f := V₀) (Finset.mem_image_of_mem I.1 (Finset.mem_univ 0))) (inv₀ (I.1 0)) *
      ρ (Finset.le_inf fun a ha => (Finset.inf_le (f := V₀) ha).trans inf_le_left :
        Finset.inf (Finset.univ.image I.1) V₀ ≤ Finset.inf (Finset.univ.image I.1) W_Y) (z_bar I)

  let α₁ : ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
      ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image I.1) V₁))) :=
    fun I =>
      ρ (Finset.inf_le (f := V₁) (Finset.mem_image_of_mem I.1 (Finset.mem_univ 0))) (inv₁ (I.1 0)) *
      ρ (Finset.le_inf fun a ha => (Finset.inf_le (f := V₁) ha).trans inf_le_left :
        Finset.inf (Finset.univ.image I.1) V₁ ≤ Finset.inf (Finset.univ.image I.1) W_Y) (z_bar I)

  have hα₀ : ∀ J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J},
      (∑ r : Fin (p + 3),
        (-1 : ℤ) ^ (r : ℕ) •
          ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
            Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))
            (α₀ ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) = 0 := by
    intro J
    let a := J.1 0
    have hle_JW : Finset.inf (Finset.univ.image J.1) V₀ ≤ Finset.inf (Finset.univ.image J.1) W_Y :=
      Finset.le_inf fun c hc => (Finset.inf_le (f := V₀) hc).trans inf_le_left
    have hle_Ja : Finset.inf (Finset.univ.image J.1) V₀ ≤ V₀ a :=
      Finset.inf_le (f := V₀) (Finset.mem_image_of_mem J.1 (Finset.mem_univ 0))
    have h_sum_eq : (∑ r : Fin (p + 3),
        (-1 : ℤ) ^ (r : ℕ) •
          ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
            Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))
            (α₀ ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) =
        ρ hle_Ja (inv₀ a) * ρ hle_JW (∑ r : Fin (p + 3),
          (-1 : ℤ) ^ (r : ℕ) •
            (ρ (Finset.inf_mono (Finset.insert_subset_iff.mpr
                ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
                 Finset.singleton_subset_iff.mpr
                   (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩))
              (g_Y a (J.1 (r.succAbove 0))) *
             ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))
              (z_bar ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩))) := by
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      let b := J.1 (r.succAbove 0)
      have hle_Jb : Finset.inf (Finset.univ.image J.1) V₀ ≤ V₀ b :=
        Finset.inf_le (f := V₀) (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))
      have hle_pair : Finset.inf (Finset.univ.image J.1) V₀ ≤ Finset.inf {a, b} W_Y ⊓ U_Y0 :=
        le_inf (Finset.le_inf fun c hc => by
          rcases Finset.mem_insert.mp hc with rfl | hc'
          · exact hle_Ja.trans inf_le_left
          · rw [Finset.mem_singleton.mp hc']
            exact hle_Jb.trans inf_le_left) (hle_Ja.trans inf_le_right)
      have h_rel := congrArg (ρ hle_pair) (hμ₀_cocycle a b)
      rw [map_mul, hρ_comp, hρ_comp, hρ_comp] at h_rel
      have h_inva : ρ hle_Ja (inv₀ a) * ρ hle_Ja (μ₀ a) = 1 := by
        rw [← map_mul, hμ₀_inv_mul a, map_one]
      have h_invb : ρ hle_Jb (μ₀ b) * ρ hle_Jb (inv₀ b) = 1 := by
        rw [← map_mul, hμ₀_mul_inv b, map_one]
      have h_inv_eq : ρ hle_Jb (inv₀ b) =
          ρ hle_Ja (inv₀ a) *
          ρ (hle_JW.trans (Finset.inf_mono (Finset.insert_subset_iff.mpr
            ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
             Finset.singleton_subset_iff.mpr
               (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩)))
            (g_Y a b) := by
        have h1 : ρ (hle_pair.trans (inf_le_inf_right U_Y0
            (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))))) (μ₀ b) =
            ρ hle_Jb (μ₀ b) := rfl
        have h2 : ρ (hle_pair.trans (inf_le_inf_right U_Y0
            (Finset.inf_le (Finset.mem_insert_self a {b})))) (μ₀ a) =
            ρ hle_Ja (μ₀ a) := rfl
        have h3 : ρ (hle_pair.trans inf_le_left) (g_Y a b) =
            ρ (hle_JW.trans (Finset.inf_mono (Finset.insert_subset_iff.mpr
              ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
               Finset.singleton_subset_iff.mpr
                 (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩))) (g_Y a b) := rfl
        rw [h1, h2, h3] at h_rel
        linear_combination -ρ hle_Jb (inv₀ b) * h_inva -
          ρ hle_Ja (inv₀ a) * ρ hle_Jb (inv₀ b) * h_rel +
          ρ hle_Ja (inv₀ a) *
            ρ (hle_JW.trans (Finset.inf_mono (Finset.insert_subset_iff.mpr
              ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
               Finset.singleton_subset_iff.mpr
                 (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩))) (g_Y a b) *
            h_invb
      dsimp only [α₀, Function.comp_apply]
      rw [map_mul, hρ_comp _ _ (inv₀ b), hρ_comp,
        map_zsmul, map_mul, hρ_comp _ _ (g_Y a b), hρ_comp, mul_smul_comm]
      apply congrArg ((-1 : ℤ) ^ (r : ℕ) • ·)
      change ρ hle_Jb (inv₀ b) * _ = ρ hle_Ja (inv₀ a) * (_ * _)
      rw [h_inv_eq, mul_assoc]
    rw [h_sum_eq, hz_cocycle J, map_zero, mul_zero]

  have hα₁ : ∀ J : {J : Fin (p + 3) → Fin (N + 1) // StrictMono J},
      (∑ r : Fin (p + 3),
        (-1 : ℤ) ^ (r : ℕ) •
          ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
            Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))
            (α₁ ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) = 0 := by
    intro J
    let a := J.1 0
    have hle_JW : Finset.inf (Finset.univ.image J.1) V₁ ≤ Finset.inf (Finset.univ.image J.1) W_Y :=
      Finset.le_inf fun c hc => (Finset.inf_le (f := V₁) hc).trans inf_le_left
    have hle_Ja : Finset.inf (Finset.univ.image J.1) V₁ ≤ V₁ a :=
      Finset.inf_le (f := V₁) (Finset.mem_image_of_mem J.1 (Finset.mem_univ 0))
    have h_sum_eq : (∑ r : Fin (p + 3),
        (-1 : ℤ) ^ (r : ℕ) •
          ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
            Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))
            (α₁ ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩)) =
        ρ hle_Ja (inv₁ a) * ρ hle_JW (∑ r : Fin (p + 3),
          (-1 : ℤ) ^ (r : ℕ) •
            (ρ (Finset.inf_mono (Finset.insert_subset_iff.mpr
                ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
                 Finset.singleton_subset_iff.mpr
                   (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩))
              (g_Y a (J.1 (r.succAbove 0))) *
             ρ (Finset.inf_mono (Finset.image_subset_iff.mpr fun t _ =>
                Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove t))))
              (z_bar ⟨J.1 ∘ r.succAbove, J.2.comp (Fin.strictMono_succAbove r)⟩))) := by
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      let b := J.1 (r.succAbove 0)
      have hle_Jb : Finset.inf (Finset.univ.image J.1) V₁ ≤ V₁ b :=
        Finset.inf_le (f := V₁) (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))
      have hle_pair : Finset.inf (Finset.univ.image J.1) V₁ ≤ Finset.inf {a, b} W_Y ⊓ U_Y1 :=
        le_inf (Finset.le_inf fun c hc => by
          rcases Finset.mem_insert.mp hc with rfl | hc'
          · exact hle_Ja.trans inf_le_left
          · rw [Finset.mem_singleton.mp hc']
            exact hle_Jb.trans inf_le_left) (hle_Ja.trans inf_le_right)
      have h_rel := congrArg (ρ hle_pair) (hμ₁_cocycle a b)
      rw [map_mul, hρ_comp, hρ_comp, hρ_comp] at h_rel
      have h_inva : ρ hle_Ja (inv₁ a) * ρ hle_Ja (μ₁ a) = 1 := by
        rw [← map_mul, hμ₁_inv_mul a, map_one]
      have h_invb : ρ hle_Jb (μ₁ b) * ρ hle_Jb (inv₁ b) = 1 := by
        rw [← map_mul, hμ₁_mul_inv b, map_one]
      have h_inv_eq : ρ hle_Jb (inv₁ b) =
          ρ hle_Ja (inv₁ a) *
          ρ (hle_JW.trans (Finset.inf_mono (Finset.insert_subset_iff.mpr
            ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
             Finset.singleton_subset_iff.mpr
               (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩)))
            (g_Y a b) := by
        have h1 : ρ (hle_pair.trans (inf_le_inf_right U_Y1
            (Finset.inf_le (Finset.mem_insert_of_mem (Finset.mem_singleton_self b))))) (μ₁ b) =
            ρ hle_Jb (μ₁ b) := rfl
        have h2 : ρ (hle_pair.trans (inf_le_inf_right U_Y1
            (Finset.inf_le (Finset.mem_insert_self a {b})))) (μ₁ a) =
            ρ hle_Ja (μ₁ a) := rfl
        have h3 : ρ (hle_pair.trans inf_le_left) (g_Y a b) =
            ρ (hle_JW.trans (Finset.inf_mono (Finset.insert_subset_iff.mpr
              ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
               Finset.singleton_subset_iff.mpr
                 (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩))) (g_Y a b) := rfl
        rw [h1, h2, h3] at h_rel
        linear_combination -ρ hle_Jb (inv₁ b) * h_inva -
          ρ hle_Ja (inv₁ a) * ρ hle_Jb (inv₁ b) * h_rel +
          ρ hle_Ja (inv₁ a) *
            ρ (hle_JW.trans (Finset.inf_mono (Finset.insert_subset_iff.mpr
              ⟨Finset.mem_image_of_mem J.1 (Finset.mem_univ 0),
               Finset.singleton_subset_iff.mpr
                 (Finset.mem_image_of_mem J.1 (Finset.mem_univ (r.succAbove 0)))⟩))) (g_Y a b) *
            h_invb
      dsimp only [α₁, Function.comp_apply]
      rw [map_mul, hρ_comp _ _ (inv₁ b), hρ_comp,
        map_zsmul, map_mul, hρ_comp _ _ (g_Y a b), hρ_comp, mul_smul_comm]
      apply congrArg ((-1 : ℤ) ^ (r : ℕ) • ·)
      change ρ hle_Jb (inv₁ b) * _ = ρ hle_Ja (inv₁ a) * (_ * _)
      rw [h_inv_eq, mul_assoc]
    rw [h_sum_eq, hz_cocycle J, map_zero, mul_zero]

  have hα_compat : ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
      (ρ ((Finset.inf_le (f := V₀₁) (Finset.mem_image_of_mem I.1 (Finset.mem_univ 0))).trans
        (inf_le_right.trans inf_le_right) :
        Finset.inf (Finset.univ.image I.1) V₀₁ ≤ U_Y1) s_bar_1) ^ m₀ *
      ρ (Finset.le_inf fun a ha =>
        (Finset.inf_le (f := V₀₁) ha).trans (inf_le_inf_left (W_Y a) inf_le_left) :
        Finset.inf (Finset.univ.image I.1) V₀₁ ≤ Finset.inf (Finset.univ.image I.1) V₀) (α₀ I) =
      ρ (Finset.le_inf fun a ha =>
        (Finset.inf_le (f := V₀₁) ha).trans (inf_le_inf_left (W_Y a) inf_le_right) :
        Finset.inf (Finset.univ.image I.1) V₀₁ ≤ Finset.inf (Finset.univ.image I.1) V₁) (α₁ I) := by
    intro I
    let a := I.1 0
    have hle_01a : Finset.inf (Finset.univ.image I.1) V₀₁ ≤ V₀₁ a :=
      Finset.inf_le (f := V₀₁) (Finset.mem_image_of_mem I.1 (Finset.mem_univ 0))
    have h_br := congrArg (ρ hle_01a) (hμ_bridge a)
    rw [map_mul, map_pow, hρ_comp, hρ_comp, hρ_comp] at h_br
    have hle_0a : Finset.inf (Finset.univ.image I.1) V₀₁ ≤ V₀ a :=
      hle_01a.trans (inf_le_inf_left (W_Y a) inf_le_left)
    have hle_1a : Finset.inf (Finset.univ.image I.1) V₀₁ ≤ V₁ a :=
      hle_01a.trans (inf_le_inf_left (W_Y a) inf_le_right)
    have h_inv0 : ρ hle_0a (μ₀ a) * ρ hle_0a (inv₀ a) = 1 := by
      rw [← map_mul, hμ₀_mul_inv a, map_one]
    have h_inv1 : ρ hle_1a (inv₁ a) * ρ hle_1a (μ₁ a) = 1 := by
      rw [← map_mul, hμ₁_inv_mul a, map_one]
    have h_s_inv : (ρ (hle_01a.trans (inf_le_right.trans inf_le_right)) s_bar_1) ^ m₀ *
        ρ hle_0a (inv₀ a) = ρ hle_1a (inv₁ a) := by
      linear_combination -(ρ (hle_01a.trans (inf_le_right.trans inf_le_right)) s_bar_1) ^ m₀ *
          ρ hle_0a (inv₀ a) * h_inv1 +
        ρ hle_1a (inv₁ a) * ρ hle_0a (inv₀ a) * h_br +
        ρ hle_1a (inv₁ a) * h_inv0
    dsimp only [α₀, α₁]
    rw [map_mul, map_mul, hρ_comp, hρ_comp, hρ_comp, hρ_comp, ← mul_assoc]
    congr 1

  
  have hcov_chart : ∀ (U : Y.Opens), AlgebraicGeometry.IsAffineOpen U →
      (∀ a : Fin (N + 1), W_Y a ⊓ U ≤ U) ∧
      (∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (W_Y a ⊓ U)) ∧
      (⨆ a : Fin (N + 1), W_Y a ⊓ U) = U := by
    intro U hU
    refine ⟨fun _ => inf_le_right, fun a => hAffInter (W_Y a) U (hWY_cov.2 a) hU, ?_⟩
    rw [← iSup_inf_eq, hWY_cov.1, top_inf_eq]

  have hAff01 : AlgebraicGeometry.IsAffineOpen (U_Y0 ⊓ U_Y1) :=
    hAffInter U_Y0 U_Y1 hCharts.2.1 hCharts.2.2.1
  obtain ⟨hV₀_le, hV₀_aff, hV₀_sup⟩ := hcov_chart U_Y0 hCharts.2.1
  obtain ⟨hV₁_le, hV₁_aff, hV₁_sup⟩ := hcov_chart U_Y1 hCharts.2.2.1
  obtain ⟨hV₀₁_le, hV₀₁_aff, hV₀₁_sup⟩ := hcov_chart (U_Y0 ⊓ U_Y1) hAff01

  obtain ⟨β'₀, hβ'₀⟩ := hAffCech U_Y0 hCharts.2.1 V₀ hV₀_le hV₀_aff hV₀_sup p α₀ hα₀
  obtain ⟨β'₁, hβ'₁⟩ := hAffCech U_Y1 hCharts.2.2.1 V₁ hV₁_le hV₁_aff hV₁_sup p α₁ hα₁

  let δ : ∀ K : {K : Fin (p + 1) → Fin (N + 1) // StrictMono K},
      ↑(Y.presheaf.obj (Opposite.op (Finset.inf (Finset.univ.image K.1) V₀₁))) :=
    fun K =>
      (ρ ((Finset.inf_le (f := V₀₁) (Finset.mem_image_of_mem K.1 (Finset.mem_univ 0))).trans
        (inf_le_right.trans inf_le_right) :
        Finset.inf (Finset.univ.image K.1) V₀₁ ≤ U_Y1) s_bar_1) ^ m₀ *
      ρ (Finset.le_inf fun a ha =>
        (Finset.inf_le (f := V₀₁) ha).trans (inf_le_inf_left (W_Y a) inf_le_left) :
        Finset.inf (Finset.univ.image K.1) V₀₁ ≤ Finset.inf (Finset.univ.image K.1) V₀) (β'₀ K) -
      ρ (Finset.le_inf fun a ha =>
        (Finset.inf_le (f := V₀₁) ha).trans (inf_le_inf_left (W_Y a) inf_le_right) :
        Finset.inf (Finset.univ.image K.1) V₀₁ ≤ Finset.inf (Finset.univ.image K.1) V₁) (β'₁ K)

  have hδ : ∀ I : {I : Fin (p + 2) → Fin (N + 1) // StrictMono I},
      (∑ r : Fin (p + 2),
        (-1 : ℤ) ^ (r : ℕ) •
