      have hs_eq : s = c_map ⊤ c := by
        refine P.sheaf.eq_of_locally_eq₂
          (CategoryTheory.homOfLE (le_top : W₀ ≤ ⊤))
          (CategoryTheory.homOfLE (le_top : W₁ ≤ ⊤))
          hCovW.symm.le s (c_map ⊤ c) ?_ ?_
        · change resP ⊤ W₀ le_top s = resP ⊤ W₀ le_top (c_map ⊤ c)
          rw [hc_res W₀ c, hc₀]
        · change resP ⊤ W₁ le_top s = resP ⊤ W₁ le_top (c_map ⊤ c)
          rw [hc_res W₁ c, hc₁]
      refine ⟨c, ?_, ?_⟩
      · rw [← hs₀, hs_eq, hc_res U'₀ c]
      · rw [← hs₁, hs_eq, hc_res U'₁ c]
    · intro z'
      let Q₀ : P.Opens := (U'₀ ⊓ W₀) ⊓ (U'₁ ⊓ W₀)
      let Q₁ : P.Opens := (U'₀ ⊓ W₁) ⊓ (U'₁ ⊓ W₁)
      have hQ₀_le : Q₀ ≤ U'₀ ⊓ U'₁ :=
        le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left)
      have hQ₁_le : Q₁ ≤ U'₀ ⊓ U'₁ :=
        le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left)
      have hCov_Q : U'₀ ⊓ U'₁ ≤ Q₀ ⊔ Q₁ := by
        intro x ⟨hxU₀, hxU₁⟩
        have hxW : x ∈ W₀ ⊔ W₁ := by rw [hCovW]; trivial
        rcases hxW with hxW₀ | hxW₁
        · exact Or.inl ⟨⟨hxU₀, hxW₀⟩, ⟨hxU₁, hxW₀⟩⟩
        · exact Or.inr ⟨⟨hxU₀, hxW₁⟩, ⟨hxU₁, hxW₁⟩⟩
      obtain ⟨a₀₀, a₁₀, ha₀⟩ := hLoc₀ (resP (U'₀ ⊓ U'₁) Q₀ hQ₀_le z')
      obtain ⟨a₀₁, a₁₁, ha₁⟩ := hLoc₁ (resP (U'₀ ⊓ U'₁) Q₁ hQ₁_le z')
      let M₀ : P.Opens := U'₀ ⊓ (W₀ ⊓ W₁)
      let M₁ : P.Opens := U'₁ ⊓ (W₀ ⊓ W₁)
      let Ω : P.Opens := M₀ ⊓ M₁
      have hM₀_le : M₀ ≤ W₀ ⊓ W₁ := inf_le_right
      have hM₁_le : M₁ ≤ W₀ ⊓ W₁ := inf_le_right
      have hCov_M : W₀ ⊓ W₁ ≤ M₀ ⊔ M₁ := by
        intro x hxW
        have hxU : x ∈ U'₀ ⊔ U'₁ := by rw [hCovU']; trivial
        rcases hxU with hxU₀ | hxU₁
        · exact Or.inl ⟨hxU₀, hxW⟩
        · exact Or.inr ⟨hxU₁, hxW⟩
      have hM₀_0 : M₀ ≤ U'₀ ⊓ W₀ := inf_le_inf_left U'₀ inf_le_left
      have hM₀_1 : M₀ ≤ U'₀ ⊓ W₁ := inf_le_inf_left U'₀ inf_le_right
      have hM₁_0 : M₁ ≤ U'₁ ⊓ W₀ := inf_le_inf_left U'₁ inf_le_left
      have hM₁_1 : M₁ ≤ U'₁ ⊓ W₁ := inf_le_inf_left U'₁ inf_le_right
      have hΩ_Q₀ : Ω ≤ Q₀ := inf_le_inf hM₀_0 hM₁_0
      have hΩ_Q₁ : Ω ≤ Q₁ := inf_le_inf hM₀_1 hM₁_1
      let ξ₀ := resP (U'₀ ⊓ W₀) M₀ hM₀_0 a₀₀ - resP (U'₀ ⊓ W₁) M₀ hM₀_1 a₀₁
      let ξ₁ := resP (U'₁ ⊓ W₀) M₁ hM₁_0 a₁₀ - resP (U'₁ ⊓ W₁) M₁ hM₁_1 a₁₁
      have hξ_compat : resP M₀ Ω inf_le_left ξ₀ = resP M₁ Ω inf_le_right ξ₁ := by
        have h0_Ω := congrArg (resP Q₀ Ω hΩ_Q₀) ha₀
        have h1_Ω := congrArg (resP Q₁ Ω hΩ_Q₁) ha₁
        simp only [map_sub] at h0_Ω h1_Ω
        change resP Q₀ Ω hΩ_Q₀ (resP (U'₀ ⊓ W₀) Q₀ inf_le_left a₀₀) -
            resP Q₀ Ω hΩ_Q₀ (resP (U'₁ ⊓ W₀) Q₀ inf_le_right a₁₀) =
            resP Q₀ Ω hΩ_Q₀ (resP (U'₀ ⊓ U'₁) Q₀ hQ₀_le z') at h0_Ω
        change resP Q₁ Ω hΩ_Q₁ (resP (U'₀ ⊓ W₁) Q₁ inf_le_left a₀₁) -
            resP Q₁ Ω hΩ_Q₁ (resP (U'₁ ⊓ W₁) Q₁ inf_le_right a₁₁) =
            resP Q₁ Ω hΩ_Q₁ (resP (U'₀ ⊓ U'₁) Q₁ hQ₁_le z') at h1_Ω
        rw [res_res, res_res, res_res] at h0_Ω h1_Ω
        have h_eq : resP (U'₀ ⊓ W₀) Ω (hΩ_Q₀.trans inf_le_left) a₀₀ -
            resP (U'₁ ⊓ W₀) Ω (hΩ_Q₀.trans inf_le_right) a₁₀ =
            resP (U'₀ ⊓ W₁) Ω (hΩ_Q₁.trans inf_le_left) a₀₁ -
            resP (U'₁ ⊓ W₁) Ω (hΩ_Q₁.trans inf_le_right) a₁₁ :=
          h0_Ω.trans h1_Ω.symm
        dsimp only [ξ₀, ξ₁]
        rw [map_sub, map_sub, res_res, res_res, res_res, res_res]
        exact sub_eq_sub_iff_sub_eq_sub.mp h_eq
      obtain ⟨ξ, hξ₀, hξ₁⟩ := glue₂ M₀ M₁ (W₀ ⊓ W₁) hM₀_le hM₁_le hCov_M ξ₀ ξ₁ hξ_compat
      obtain ⟨w₀, w₁, hw⟩ := hW_H1 ξ
      let u₀₀ := a₀₀ - resP W₀ (U'₀ ⊓ W₀) inf_le_right w₀
      let u₀₁ := a₀₁ - resP W₁ (U'₀ ⊓ W₁) inf_le_right w₁
      let u₁₀ := a₁₀ - resP W₀ (U'₁ ⊓ W₀) inf_le_right w₀
      let u₁₁ := a₁₁ - resP W₁ (U'₁ ⊓ W₁) inf_le_right w₁
      let I₀ : P.Opens := (U'₀ ⊓ W₀) ⊓ (U'₀ ⊓ W₁)
      have hI₀_M₀ : I₀ ≤ M₀ :=
        le_inf (inf_le_left.trans inf_le_left)
          (le_inf (inf_le_left.trans inf_le_right) (inf_le_right.trans inf_le_right))
      have hCov_U₀ : U'₀ ≤ (U'₀ ⊓ W₀) ⊔ (U'₀ ⊓ W₁) := by
        intro x hxU₀
        have hxW : x ∈ W₀ ⊔ W₁ := by rw [hCovW]; trivial
        rcases hxW with hxW₀ | hxW₁
        · exact Or.inl ⟨hxU₀, hxW₀⟩
        · exact Or.inr ⟨hxU₀, hxW₁⟩
      have hu₀_compat : resP (U'₀ ⊓ W₀) I₀ inf_le_left u₀₀ = resP (U'₀ ⊓ W₁) I₀ inf_le_right u₀₁ := by
        dsimp only [u₀₀, u₀₁]
        rw [map_sub, map_sub, res_res, res_res]
        have h_xi := congrArg (resP M₀ I₀ hI₀_M₀) hξ₀
        dsimp only [ξ₀] at h_xi
        rw [map_sub, res_res, res_res, res_res] at h_xi
        have h_w := congrArg (resP (W₀ ⊓ W₁) I₀ (hI₀_M₀.trans hM₀_le)) hw
        change resP (W₀ ⊓ W₁) I₀ (hI₀_M₀.trans hM₀_le)
            (resP W₀ (W₀ ⊓ W₁) inf_le_left w₀ - resP W₁ (W₀ ⊓ W₁) inf_le_right w₁) =
            resP (W₀ ⊓ W₁) I₀ (hI₀_M₀.trans hM₀_le) ξ at h_w
        rw [map_sub, res_res, res_res] at h_w
        exact sub_eq_sub_iff_sub_eq_sub.mp (h_xi.symm.trans h_w.symm)
      obtain ⟨a'₀, ha₀_0, ha₀_1⟩ :=
        glue₂ (U'₀ ⊓ W₀) (U'₀ ⊓ W₁) U'₀ inf_le_left inf_le_left hCov_U₀ u₀₀ u₀₁ hu₀_compat
      let I₁ : P.Opens := (U'₁ ⊓ W₀) ⊓ (U'₁ ⊓ W₁)
      have hI₁_M₁ : I₁ ≤ M₁ :=
        le_inf (inf_le_left.trans inf_le_left)
          (le_inf (inf_le_left.trans inf_le_right) (inf_le_right.trans inf_le_right))
      have hCov_U₁ : U'₁ ≤ (U'₁ ⊓ W₀) ⊔ (U'₁ ⊓ W₁) := by
        intro x hxU₁
        have hxW : x ∈ W₀ ⊔ W₁ := by rw [hCovW]; trivial
        rcases hxW with hxW₀ | hxW₁
        · exact Or.inl ⟨hxU₁, hxW₀⟩
        · exact Or.inr ⟨hxU₁, hxW₁⟩
      have hu₁_compat : resP (U'₁ ⊓ W₀) I₁ inf_le_left u₁₀ = resP (U'₁ ⊓ W₁) I₁ inf_le_right u₁₁ := by
        dsimp only [u₁₀, u₁₁]
        rw [map_sub, map_sub, res_res, res_res]
        have h_xi := congrArg (resP M₁ I₁ hI₁_M₁) hξ₁
        dsimp only [ξ₁] at h_xi
        rw [map_sub, res_res, res_res, res_res] at h_xi
        have h_w := congrArg (resP (W₀ ⊓ W₁) I₁ (hI₁_M₁.trans hM₁_le)) hw
        change resP (W₀ ⊓ W₁) I₁ (hI₁_M₁.trans hM₁_le)
            (resP W₀ (W₀ ⊓ W₁) inf_le_left w₀ - resP W₁ (W₀ ⊓ W₁) inf_le_right w₁) =
            resP (W₀ ⊓ W₁) I₁ (hI₁_M₁.trans hM₁_le) ξ at h_w
        rw [map_sub, res_res, res_res] at h_w
        exact sub_eq_sub_iff_sub_eq_sub.mp (h_xi.symm.trans h_w.symm)
      obtain ⟨a'₁, ha₁_0, ha₁_1⟩ :=
        glue₂ (U'₁ ⊓ W₀) (U'₁ ⊓ W₁) U'₁ inf_le_left inf_le_left hCov_U₁ u₁₀ u₁₁ hu₁_compat
      refine ⟨a'₀, a'₁, ?_⟩
      refine P.sheaf.eq_of_locally_eq₂
        (CategoryTheory.homOfLE hQ₀_le)
        (CategoryTheory.homOfLE hQ₁_le)
        hCov_Q
        (resP U'₀ (U'₀ ⊓ U'₁) inf_le_left a'₀ - resP U'₁ (U'₀ ⊓ U'₁) inf_le_right a'₁)
        z' ?_ ?_
      · change resP (U'₀ ⊓ U'₁) Q₀ hQ₀_le
            (resP U'₀ (U'₀ ⊓ U'₁) inf_le_left a'₀ - resP U'₁ (U'₀ ⊓ U'₁) inf_le_right a'₁) =
          resP (U'₀ ⊓ U'₁) Q₀ hQ₀_le z'
        rw [map_sub, res_res, res_res]
        have h00 : resP U'₀ Q₀ (hQ₀_le.trans inf_le_left) a'₀ = resP (U'₀ ⊓ W₀) Q₀ inf_le_left u₀₀ := by
          rw [← ha₀_0, res_res]
        have h10 : resP U'₁ Q₀ (hQ₀_le.trans inf_le_right) a'₁ = resP (U'₁ ⊓ W₀) Q₀ inf_le_right u₁₀ := by
          rw [← ha₁_0, res_res]
        rw [h00, h10]
        dsimp only [u₀₀, u₁₀]
        rw [map_sub, map_sub, res_res, res_res, sub_sub_sub_cancel_right]
        exact ha₀
      · change resP (U'₀ ⊓ U'₁) Q₁ hQ₁_le
            (resP U'₀ (U'₀ ⊓ U'₁) inf_le_left a'₀ - resP U'₁ (U'₀ ⊓ U'₁) inf_le_right a'₁) =
          resP (U'₀ ⊓ U'₁) Q₁ hQ₁_le z'
        rw [map_sub, res_res, res_res]
        have h01 : resP U'₀ Q₁ (hQ₁_le.trans inf_le_left) a'₀ = resP (U'₀ ⊓ W₁) Q₁ inf_le_left u₀₁ := by
          rw [← ha₀_1, res_res]
        have h11 : resP U'₁ Q₁ (hQ₁_le.trans inf_le_right) a'₁ = resP (U'₁ ⊓ W₁) Q₁ inf_le_right u₁₁ := by
          rw [← ha₁_1, res_res]
        rw [h01, h11]
        dsimp only [u₀₁, u₁₁]
        rw [map_sub, map_sub, res_res, res_res, sub_sub_sub_cancel_right]
        exact ha₁
  
  obtain ⟨hU'_H0, hU'_H1⟩ := hU'_cohom
  have h_round : ∀ V : Z_sch.Opens,
      V ≤ (TopologicalSpace.Opens.map isoP1.hom.base).obj
        ((TopologicalSpace.Opens.map isoP1.inv.base).obj V) := by
    intro V z hz
    have hid : isoP1.inv.base (isoP1.hom.base z) = z := by
      have h := congrArg (fun f => f.base z) isoP1.hom_inv_id
      simpa using h
    change isoP1.inv.base (isoP1.hom.base z) ∈ V
    rw [hid]
    exact hz
  let φ_V : ∀ V : Z_sch.Opens,
      Z_sch.presheaf.obj (Opposite.op V) ⟶
        P.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map isoP1.inv.base).obj V)) :=
    fun V => isoP1.inv.appLE V ((TopologicalSpace.Opens.map isoP1.inv.base).obj V) le_rfl
  let ψ_V : ∀ V : Z_sch.Opens,
      P.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map isoP1.inv.base).obj V)) ⟶
        Z_sch.presheaf.obj (Opposite.op V) :=
    fun V => isoP1.hom.appLE ((TopologicalSpace.Opens.map isoP1.inv.base).obj V) V (h_round V)
  have h_id_appLE : ∀ {X : AlgebraicGeometry.Scheme.{u}} (V : X.Opens) (f : X ⟶ X) (_ : f = 𝟙 X)
      (hV : V ≤ (TopologicalSpace.Opens.map f.base).obj V),
      f.appLE V V hV = 𝟙 _ := by
    rintro X V _ rfl hV
    exact (@AlgebraicGeometry.Scheme.Hom.appLE_eq_app X X (𝟙 X) V).trans
      (AlgebraicGeometry.Scheme.Hom.id_app V)
  have h_φψ : ∀ (V : Z_sch.Opens) (x : ↑(Z_sch.presheaf.obj (Opposite.op V))),
      (ψ_V V).hom ((φ_V V).hom x) = x := by
    intro V x
    have hcomp : φ_V V ≫ ψ_V V = 𝟙 _ := by
      refine (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE isoP1.hom isoP1.inv V
        ((TopologicalSpace.Opens.map isoP1.inv.base).obj V) V le_rfl (h_round V)).trans ?_
      exact h_id_appLE V (isoP1.hom ≫ isoP1.inv) isoP1.hom_inv_id _
    exact congrArg (fun f => f.hom x) hcomp
  have h_ψφ : ∀ (V : Z_sch.Opens)
      (y : ↑(P.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map isoP1.inv.base).obj V)))),
      (φ_V V).hom ((ψ_V V).hom y) = y := by
    intro V y
    let V' : P.Opens := (TopologicalSpace.Opens.map isoP1.inv.base).obj V
    have hcomp : ψ_V V ≫ φ_V V = 𝟙 _ := by
      refine (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE isoP1.inv isoP1.hom V' V V'
        (h_round V) le_rfl).trans ?_
      exact h_id_appLE V' (isoP1.inv ≫ isoP1.hom) isoP1.inv_hom_id _
    exact congrArg (fun f => f.hom y) hcomp
  have h_φ_res : ∀ (V₁ V₂ : Z_sch.Opens) (hle : V₁ ≤ V₂)
      (hle' : (TopologicalSpace.Opens.map isoP1.inv.base).obj V₁ ≤
        (TopologicalSpace.Opens.map isoP1.inv.base).obj V₂)
      (x : ↑(Z_sch.presheaf.obj (Opposite.op V₂))),
      (φ_V V₁).hom ((Z_sch.presheaf.map (CategoryTheory.homOfLE hle).op).hom x) =
        (P.presheaf.map (CategoryTheory.homOfLE hle').op).hom ((φ_V V₂).hom x) := by
    intro V₁ V₂ hle hle' x
    have hcomp : Z_sch.presheaf.map (CategoryTheory.homOfLE hle).op ≫ φ_V V₁ =
        φ_V V₂ ≫ P.presheaf.map (CategoryTheory.homOfLE hle').op := by
      dsimp [φ_V]
      rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
    exact congrArg (fun f => f.hom x) hcomp
  have hp_P : isoP1.inv ≫ p_Z = p_P := by
    rw [h_pZ, ← CategoryTheory.Category.assoc, isoP1.inv_hom_id, CategoryTheory.Category.id_comp]
  have h_appLE_pP : ∀ (W : P.Opens)
      (g : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀)) (_ : g = p_P)
      (hW : W ≤ (TopologicalSpace.Opens.map g.base).obj ⊤),
      g.appLE ⊤ W hW = p_P.appLE ⊤ W le_top := by
    rintro W _ rfl _
    rfl
  have h_φ_c : ∀ (V : Z_sch.Opens) (c : k₀),
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE p_P ⊤
          ((TopologicalSpace.Opens.map isoP1.inv.base).obj V) le_top).hom c =
      (φ_V V).hom (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE p_Z ⊤ V le_top).hom c) := by
    intro V c
    have hcomp : AlgebraicGeometry.Scheme.Hom.appLE p_Z ⊤ V le_top ≫ φ_V V =
        AlgebraicGeometry.Scheme.Hom.appLE p_P ⊤
          ((TopologicalSpace.Opens.map isoP1.inv.base).obj V) le_top := by
      refine (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE isoP1.inv p_Z ⊤ V
        ((TopologicalSpace.Opens.map isoP1.inv.base).obj V) le_top le_rfl).trans ?_
      exact h_appLE_pP _ (isoP1.inv ≫ p_Z) hp_P _
    exact congrArg
      (fun f => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ f).hom c) hcomp.symm
  constructor
  · intro a₀ a₁ h_eq
    have h_eq₀ := h_φ_res (U₀ ⊓ U₁) U₀ (inf_le_left : U₀ ⊓ U₁ ≤ U₀) (inf_le_left : U'₀ ⊓ U'₁ ≤ U'₀) a₀
    have h_eq₁ := h_φ_res (U₀ ⊓ U₁) U₁ (inf_le_right : U₀ ⊓ U₁ ≤ U₁) (inf_le_right : U'₀ ⊓ U'₁ ≤ U'₁) a₁
    have h_eq' : (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U'₀ ⊓ U'₁ ≤ U'₀)).op).hom
          ((φ_V U₀).hom a₀) =
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U'₀ ⊓ U'₁ ≤ U'₁)).op).hom
          ((φ_V U₁).hom a₁) := by
      exact h_eq₀.symm.trans ((congrArg (φ_V (U₀ ⊓ U₁)).hom h_eq).trans h_eq₁)
    obtain ⟨c, hc₀', hc₁'⟩ := hU'_H0 ((φ_V U₀).hom a₀) ((φ_V U₁).hom a₁) h_eq'
    rw [h_φ_c U₀ c] at hc₀'
    rw [h_φ_c U₁ c] at hc₁'
    refine ⟨c, ?_, ?_⟩
    · have h := congrArg (ψ_V U₀).hom hc₀'
      rwa [h_φψ U₀ a₀, h_φψ U₀ (c₀ c)] at h
    · have h := congrArg (ψ_V U₁).hom hc₁'
      rwa [h_φψ U₁ a₁, h_φψ U₁ (c₁ c)] at h
  · intro z
    obtain ⟨a'₀, a'₁, hz'⟩ := hU'_H1 ((φ_V (U₀ ⊓ U₁)).hom z)
    let a₀ : ↑A₀ := (ψ_V U₀).hom a'₀
    let a₁ : ↑A₁ := (ψ_V U₁).hom a'₁
    refine ⟨a₀, a₁, ?_⟩
    have h_r₀ := h_φ_res (U₀ ⊓ U₁) U₀ (inf_le_left : U₀ ⊓ U₁ ≤ U₀) (inf_le_left : U'₀ ⊓ U'₁ ≤ U'₀) a₀
    have h_r₁ := h_φ_res (U₀ ⊓ U₁) U₁ (inf_le_right : U₀ ⊓ U₁ ≤ U₁) (inf_le_right : U'₀ ⊓ U'₁ ≤ U'₁) a₁
    have h_img : (φ_V (U₀ ⊓ U₁)).hom (res₀ a₀ - res₁ a₁) = (φ_V (U₀ ⊓ U₁)).hom z := by
      rw [map_sub]
      dsimp only [res₀, res₁]
      rw [h_r₀, h_r₁, h_ψφ U₀ a'₀, h_ψφ U₁ a'₁]
      exact hz'
    have h := congrArg (ψ_V (U₀ ⊓ U₁)).hom h_img
    rwa [h_φψ (U₀ ⊓ U₁) (res₀ a₀ - res₁ a₁), h_φψ (U₀ ⊓ U₁) z] at h

theorem weil_sup1_nodal_roof_ideal_sum_eq_inf (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (R₁ : Type u) [CommRing R₁] [Algebra k₀ R₁] [IsReduced R₁] [IsNoetherianRing R₁]
    (J_Z J_Y' : Ideal R₁)
    (hRadZ : J_Z.IsRadical)
    (hRadY' : J_Y'.IsRadical)
    (hInf : J_Z ⊓ J_Y' = ⊥)
    (hNodes : ∀ 𝔭 : PrimeSpectrum R₁, J_Z ⊔ J_Y' ≤ 𝔭.asIdeal →
      (∃ 𝔮_Z : PrimeSpectrum R₁,
        𝔮_Z.asIdeal ≤ 𝔭.asIdeal ∧ J_Z ≤ 𝔮_Z.asIdeal ∧ ¬ J_Y' ≤ 𝔮_Z.asIdeal) ∧
      (∃ 𝔮_Y' : PrimeSpectrum R₁,
        𝔮_Y'.asIdeal ≤ 𝔭.asIdeal ∧ J_Y' ≤ 𝔮_Y'.asIdeal ∧ ¬ J_Z ≤ 𝔮_Y'.asIdeal) ∧
      (∃ (D : Type u) (_ : CommRing D) (𝔫₀ : PrimeSpectrum D)
          (ψ₁ : R₁ →+* D)
          (ψ₂ : (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D),
        ψ₁.Etale ∧ ψ₂.Etale ∧ PrimeSpectrum.comap ψ₁ 𝔫₀ = 𝔭 ∧
        (∀ i : Fin 2, ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ 𝔫₀.asIdeal) ∧
        ψ₁.comp (algebraMap k₀ R₁) = ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) :
    (∀ 𝔭 : PrimeSpectrum R₁, J_Z ⊔ J_Y' ≤ 𝔭.asIdeal →
      ∃ ev : R₁ →ₐ[k₀] k₀, RingHom.ker ev.toRingHom = 𝔭.asIdeal) ∧
    (∀ x : R₁, x ∈ J_Z ⊔ J_Y' ↔ ∀ 𝔭 : PrimeSpectrum R₁, J_Z ⊔ J_Y' ≤ 𝔭.asIdeal → x ∈ 𝔭.asIdeal) :=
by
  
  have hEtaleRad : ∀ (R D : Type u) [CommRing R] [IsNoetherianRing R] [CommRing D]
      (ψ : R →+* D), ψ.Etale →
      ∀ (J : Ideal R), J.IsRadical →
      ∀ (𝔫₀ : PrimeSpectrum D),
        (Ideal.map ((algebraMap D (Localization.AtPrime 𝔫₀.asIdeal)).comp ψ) J).IsRadical := by
    intro R D _ _ _ ψ hψ J hJ 𝔫₀
    let A := R ⧸ J
    haveI : IsNoetherianRing A := Ideal.Quotient.isNoetherianRing J
    haveI : IsReduced A := (Ideal.isRadical_iff_quotient_reduced J).mp hJ
    let J_D : Ideal D := Ideal.map ψ J
    let S := D ⧸ J_D
    letI : Algebra R D := ψ.toAlgebra
    haveI : Algebra.Etale R D := RingHom.etale_algebraMap.mp hψ
    let φ_AS : A →+* S := Ideal.Quotient.lift J ((Ideal.Quotient.mk J_D).comp ψ)
      (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem ψ hr))
    letI : Algebra A S := φ_AS.toAlgebra
    haveI : IsScalarTower R A S :=
      ⟨fun r a s => by
        rw [Algebra.smul_def r a, Algebra.smul_def _ s, map_mul, mul_assoc,
          ← Algebra.smul_def a s]
        have h_alg : algebraMap A S (algebraMap R A r) = algebraMap R S r := rfl
        rw [h_alg, ← Algebra.smul_def r (a • s)]⟩
    haveI : Algebra.Etale A (TensorProduct R A D) := Algebra.Etale.baseChange R D A
    let f_DS : D →ₐ[R] S := Ideal.Quotient.mkₐ R J_D
    let f_fwd : TensorProduct R A D →ₐ[A] S :=
      Algebra.TensorProduct.lift (Algebra.ofId A S) f_DS (fun _ _ => Commute.all _ _)
    have h_ker_inv : ∀ x ∈ J_D,
        (Algebra.TensorProduct.includeRight : D →ₐ[R] TensorProduct R A D) x = 0 := by
      intro x hx
      refine Submodule.span_induction ?_ (by simp) (fun x y _ _ hx0 hy0 => by
        rw [map_add, hx0, hy0, add_zero]) (fun d x _ hx0 => by
        rw [smul_eq_mul, map_mul, hx0, mul_zero]) hx
      rintro _ ⟨r, hr, rfl⟩
      have h1 : (1 : A) ⊗ₜ[R] (ψ r) = (1 : A) ⊗ₜ[R] (r • (1 : D)) := by
        congr 1
        rw [Algebra.smul_def, mul_one]
        rfl
      rw [Algebra.TensorProduct.includeRight_apply, h1, ← TensorProduct.smul_tmul r (1 : A) (1 : D)]
      have h2 : r • (1 : A) = 0 := by
        rw [Algebra.smul_def, mul_one]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
      rw [h2, TensorProduct.zero_tmul]
    let f_inv : S →+* TensorProduct R A D :=
      Ideal.Quotient.lift J_D
        (Algebra.TensorProduct.includeRight : D →ₐ[R] TensorProduct R A D).toRingHom h_ker_inv
    have h_left : ∀ z : TensorProduct R A D, f_inv (f_fwd z) = z := by
      intro z
      refine TensorProduct.inductionOn (motive := fun z => f_inv (f_fwd z) = z) z ?_
        (fun x y hx hy => by rw [map_add, map_add, hx, hy])
      intro a d
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
      have h_app : f_fwd ((Ideal.Quotient.mk J r) ⊗ₜ[R] d) =
          Ideal.Quotient.mk J_D (ψ r * d) := by
        dsimp only [f_fwd]
        rw [Algebra.TensorProduct.lift_tmul]
        have h1 : (Algebra.ofId A S) (Ideal.Quotient.mk J r) = Ideal.Quotient.mk J_D (ψ r) := rfl
        have h2 : f_DS d = Ideal.Quotient.mk J_D d := rfl
        rw [h1, h2, ← map_mul]
      rw [h_app]
      change (1 : A) ⊗ₜ[R] (ψ r * d) = (Ideal.Quotient.mk J r) ⊗ₜ[R] d
      have hrd : ψ r * d = r • d := rfl
      rw [hrd, ← TensorProduct.smul_tmul r (1 : A) d]
      congr 1
      rw [Algebra.smul_def, mul_one]
      rfl
    have h_right : ∀ s : S, f_fwd (f_inv s) = s := by
      intro s
      obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective s
      change f_fwd ((1 : A) ⊗ₜ[R] d) = Ideal.Quotient.mk J_D d
      dsimp only [f_fwd]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    let e_S : TensorProduct R A D ≃ₐ[A] S :=
      { f_fwd with
        invFun := f_inv
        left_inv := h_left
        right_inv := h_right }
    haveI : Algebra.Etale A S := Algebra.Etale.of_equiv e_S
    classical
    let ι := ↥(minimalPrimes A)
    letI : Fintype ι := (minimalPrimes.finite_of_isNoetherianRing A).fintype
    letI : ∀ i : ι, (i.1 : Ideal A).IsPrime := fun i => i.2.1.1
    let α : A →ₗ[A] (∀ i : ι, FractionRing (A ⧸ i.1)) :=
      LinearMap.pi fun i => Algebra.linearMap A (FractionRing (A ⧸ i.1))
    have hα_inj : Function.Injective α := by
      intro a₁ a₂ h_eq
      have hx0 : α (a₁ - a₂) = 0 := by rw [map_sub, h_eq, sub_self]
      have hx_min : ∀ i : ι, a₁ - a₂ ∈ i.1 := by
        intro i
        have hi0 : algebraMap (A ⧸ i.1) (FractionRing (A ⧸ i.1))
            (Ideal.Quotient.mk i.1 (a₁ - a₂)) = 0 := congrFun hx0 i
        have hmk0 : Ideal.Quotient.mk i.1 (a₁ - a₂) = 0 :=
          IsFractionRing.injective (A ⧸ i.1) (FractionRing (A ⧸ i.1)) (by rw [hi0, map_zero])
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
      have hx_rad : a₁ - a₂ ∈ (⊥ : Ideal A).radical := by
        rw [Ideal.radical_eq_sInf]
        refine Ideal.mem_sInf.mpr ?_
        rintro Q ⟨_, hQ⟩
        obtain ⟨p, hp, hpQ⟩ := @Ideal.exists_minimalPrimes_le A _ ⊥ Q hQ bot_le
        exact hpQ (hx_min ⟨p, hp⟩)
      obtain ⟨n, hn⟩ := hx_rad
      have hpow0 : (a₁ - a₂) ^ n = 0 := Ideal.mem_bot.mp hn
      exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hpow0)
    have h_lTensor_inj : Function.Injective (LinearMap.lTensor S α) :=
      Module.Flat.lTensor_preserves_injective_linearMap α hα_inj
    let Φ : S →+* (∀ i : ι, TensorProduct A S (FractionRing (A ⧸ i.1))) :=
      RingHom.pi fun i =>
        (Algebra.TensorProduct.includeLeft : S →ₐ[A] TensorProduct A S (FractionRing (A ⧸ i.1))).toRingHom
    have hΦ_eq : ∀ s : S,
        Φ s = (Algebra.TensorProduct.piRight A A S (fun i : ι => FractionRing (A ⧸ i.1)))
          ((LinearMap.lTensor S α) ((TensorProduct.rid A S).symm s)) := by
      intro s
      ext i
      simp [Φ, α]
    have hΦ_inj : Function.Injective Φ := by
      intro s₁ s₂ hs
      rw [hΦ_eq s₁, hΦ_eq s₂] at hs
      exact (TensorProduct.rid A S).symm.injective
        (h_lTensor_inj
          ((Algebra.TensorProduct.piRight A A S (fun i : ι => FractionRing (A ⧸ i.1))).injective hs))
    have hRed_i : ∀ i : ι, IsReduced (TensorProduct A S (FractionRing (A ⧸ i.1))) := by
      intro i
      haveI : Algebra.Etale (FractionRing (A ⧸ i.1))
          (TensorProduct A (FractionRing (A ⧸ i.1)) S) :=
        Algebra.Etale.baseChange A S (FractionRing (A ⧸ i.1))
      haveI : IsReduced (TensorProduct A (FractionRing (A ⧸ i.1)) S) :=
        Algebra.FormallyUnramified.isReduced_of_field
          (FractionRing (A ⧸ i.1)) (TensorProduct A (FractionRing (A ⧸ i.1)) S)
      exact isReduced_of_injective
        (Algebra.TensorProduct.comm A S (FractionRing (A ⧸ i.1))).toRingEquiv.toRingHom
        (Algebra.TensorProduct.comm A S (FractionRing (A ⧸ i.1))).injective
    letI : ∀ i : ι, IsReduced (TensorProduct A S (FractionRing (A ⧸ i.1))) := hRed_i
    haveI : IsReduced S := isReduced_of_injective Φ hΦ_inj
    have hJD_rad : J_D.IsRadical := (Ideal.isRadical_iff_quotient_reduced J_D).mpr inferInstance
    rw [← Ideal.map_map, ← Ideal.radical_eq_iff,
      ← IsLocalization.map_radical 𝔫₀.asIdeal.primeCompl (Localization.AtPrime 𝔫₀.asIdeal) J_D,
      Ideal.radical_eq_iff.mpr hJD_rad]

  
  have hNodalModel : ∀ (D : Type u) [CommRing D] (𝔫₀ : PrimeSpectrum D)
      (ψ₂ : (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D),
      ψ₂.Etale →
      (∀ i : Fin 2, ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ 𝔫₀.asIdeal) →
      let R_loc := Localization.AtPrime 𝔫₀.asIdeal
      let x₀ : R_loc := algebraMap D R_loc (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
      let x₁ : R_loc := algebraMap D R_loc (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
      IsNoetherianRing R_loc ∧
      (∃ ε_D : D →+* k₀,
        RingHom.ker ε_D = 𝔫₀.asIdeal ∧
        ε_D.comp (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = RingHom.id k₀) ∧
      (IsLocalRing.maximalIdeal R_loc = Ideal.span ({x₀, x₁} : Set R_loc) ∧ x₀ * x₁ = 0) ∧
      ((∀ r : R_loc, x₁ * r ∈ Ideal.span {x₀} → r ∈ Ideal.span {x₀}) ∧
       (∀ r : R_loc, x₀ * r ∈ Ideal.span {x₁} → r ∈ Ideal.span {x₁})) := by
    intro D _ 𝔫₀ ψ₂ hψ₂ hX
    let I_rel : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let B_nod := MvPolynomial (Fin 2) k₀ ⧸ I_rel
    let R_loc := Localization.AtPrime 𝔫₀.asIdeal
    let bX : Fin 2 → B_nod := fun i => Ideal.Quotient.mk I_rel (MvPolynomial.X i)
    let d₀ : D := ψ₂ (bX 0)
    let d₁ : D := ψ₂ (bX 1)
    let x₀ : R_loc := algebraMap D R_loc d₀
    let x₁ : R_loc := algebraMap D R_loc d₁
    haveI : IsNoetherianRing B_nod := Ideal.Quotient.isNoetherianRing I_rel
    letI : Algebra B_nod D := ψ₂.toAlgebra
    haveI : Algebra.Etale B_nod D := RingHom.etale_algebraMap.mp hψ₂
    haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing B_nod D
    have hNoeth : IsNoetherianRing R_loc :=
      IsLocalization.isNoetherianRing 𝔫₀.asIdeal.primeCompl R_loc inferInstance
    have hbX_mul : bX 0 * bX 1 = 0 := by
      dsimp [bX]
      rw [← map_mul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hx_mul : x₀ * x₁ = 0 := by
      dsimp [x₀, x₁, d₀, d₁]
      rw [← map_mul, ← map_mul, hbX_mul, map_zero, map_zero]
    
    have h_ker_ε₀ : ∀ p ∈ I_rel, MvPolynomial.constantCoeff p = 0 := by
      intro p hp
      refine Submodule.span_induction ?_ (by simp) (fun a b _ _ ha hb => by simp [ha, hb])
        (fun a b _ hb => by simp [hb]) hp
      rintro _ rfl
      simp
    let ε₀ : B_nod →+* k₀ := Ideal.Quotient.lift I_rel MvPolynomial.constantCoeff h_ker_ε₀
    let I_X01 : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span ({MvPolynomial.X 0, MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
    have h_poly_mod : ∀ P : MvPolynomial (Fin 2) k₀,
        P - MvPolynomial.C (MvPolynomial.constantCoeff P) ∈ I_X01 := by
      intro P
      refine MvPolynomial.induction_on
        (motive := fun P => P - MvPolynomial.C (MvPolynomial.constantCoeff P) ∈ I_X01) P ?_ ?_ ?_
      · intro c
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact I_X01.zero_mem
      · intro p q hp hq
        rw [map_add, map_add]
        have h_eq : (p + q) - (MvPolynomial.C (MvPolynomial.constantCoeff p) +
            MvPolynomial.C (MvPolynomial.constantCoeff q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by ring
        rw [h_eq]
        exact I_X01.add_mem hp hq
      · intro p k _
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
        have hXk : MvPolynomial.X k ∈ I_X01 := by
          refine Ideal.subset_span ?_
          fin_cases k <;> simp
        exact I_X01.mul_mem_left p hXk
    let I₀ : Ideal D := Ideal.span ({d₀, d₁} : Set D)
    let E := D ⧸ I₀
    let ι_kD : k₀ →+* D := ψ₂.comp ((Ideal.Quotient.mk I_rel).comp MvPolynomial.C)
    letI : Algebra k₀ E := ((Ideal.Quotient.mk I₀).comp ι_kD).toAlgebra
    letI : Algebra B_nod k₀ := ε₀.toAlgebra
    have h_comm_BE : ∀ b : B_nod, Ideal.Quotient.mk I₀ (ψ₂ b) = algebraMap k₀ E (ε₀ b) := by
      intro b
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective b
      have hP_mem : P - MvPolynomial.C (MvPolynomial.constantCoeff P) ∈ I_X01 := h_poly_mod P
      have h_map_le : Ideal.map (ψ₂.comp (Ideal.Quotient.mk I_rel)) I_X01 ≤ I₀ := by
        dsimp [I_X01]
        rw [Ideal.map_span]
        refine Ideal.span_mono ?_
        rintro _ ⟨Q, hQ, rfl⟩
        rcases hQ with rfl | hQ1
        · exact Set.mem_insert d₀ {d₁}
        · rw [Set.mem_singleton_iff.mp hQ1]
          exact Set.mem_insert_of_mem d₀ (Set.mem_singleton d₁)
      have hD_mem : ψ₂ (Ideal.Quotient.mk I_rel P) - ι_kD (MvPolynomial.constantCoeff P) ∈ I₀ := by
        have h1 : (ψ₂.comp (Ideal.Quotient.mk I_rel))
            (P - MvPolynomial.C (MvPolynomial.constantCoeff P)) ∈ I₀ :=
          h_map_le (Ideal.mem_map_of_mem _ hP_mem)
        simpa [RingHom.comp_apply, map_sub, ι_kD] using h1
      rw [← sub_eq_zero]
      change Ideal.Quotient.mk I₀ (ψ₂ (Ideal.Quotient.mk I_rel P)) -
        Ideal.Quotient.mk I₀ (ι_kD (MvPolynomial.constantCoeff P)) = 0
      rw [← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hD_mem
    haveI : IsScalarTower B_nod k₀ E :=
      ⟨fun b c e => by
        rw [Algebra.smul_def b c, Algebra.smul_def _ e, map_mul, mul_assoc,
          ← Algebra.smul_def c e]
        have h_alg : algebraMap k₀ E (algebraMap B_nod k₀ b) = algebraMap B_nod E b :=
          (h_comm_BE b).symm
        rw [h_alg, ← Algebra.smul_def b (c • e)]⟩
    haveI : Algebra.Etale k₀ (TensorProduct B_nod k₀ D) := Algebra.Etale.baseChange B_nod D k₀
    let g_DE : D →ₐ[B_nod] E := Ideal.Quotient.mkₐ B_nod I₀
    let g_fwd : TensorProduct B_nod k₀ D →ₐ[k₀] E :=
      Algebra.TensorProduct.lift (Algebra.ofId k₀ E) g_DE (fun _ _ => Commute.all _ _)
    have h_ker_ginv : ∀ x ∈ I₀,
        (Algebra.TensorProduct.includeRight : D →ₐ[B_nod] TensorProduct B_nod k₀ D) x = 0 := by
      intro x hx
      refine Submodule.span_induction ?_ (by simp) (fun a b _ _ ha hb => by
        rw [map_add, ha, hb, add_zero]) (fun a b _ hb => by
        rw [smul_eq_mul, map_mul, hb, mul_zero]) hx
      rintro _ (rfl | h_eq1)
      · have h1 : (1 : k₀) ⊗ₜ[B_nod] d₀ = (1 : k₀) ⊗ₜ[B_nod] (bX 0 • (1 : D)) := by
          congr 1
          rw [Algebra.smul_def, mul_one]
          rfl
        rw [Algebra.TensorProduct.includeRight_apply, h1,
          ← TensorProduct.smul_tmul (bX 0) (1 : k₀) (1 : D)]
        have h2 : bX 0 • (1 : k₀) = 0 := by
          rw [Algebra.smul_def, mul_one]
          exact MvPolynomial.constantCoeff_X k₀ (0 : Fin 2)
        rw [h2, TensorProduct.zero_tmul]
      · rw [Set.mem_singleton_iff.mp h_eq1]
        have h1 : (1 : k₀) ⊗ₜ[B_nod] d₁ = (1 : k₀) ⊗ₜ[B_nod] (bX 1 • (1 : D)) := by
          congr 1
          rw [Algebra.smul_def, mul_one]
          rfl
        rw [Algebra.TensorProduct.includeRight_apply, h1,
          ← TensorProduct.smul_tmul (bX 1) (1 : k₀) (1 : D)]
        have h2 : bX 1 • (1 : k₀) = 0 := by
          rw [Algebra.smul_def, mul_one]
          exact MvPolynomial.constantCoeff_X k₀ (1 : Fin 2)
        rw [h2, TensorProduct.zero_tmul]
    let g_inv : E →+* TensorProduct B_nod k₀ D :=
      Ideal.Quotient.lift I₀
        (Algebra.TensorProduct.includeRight : D →ₐ[B_nod] TensorProduct B_nod k₀ D).toRingHom
        h_ker_ginv
    have hg_left : ∀ z : TensorProduct B_nod k₀ D, g_inv (g_fwd z) = z := by
      intro z
      refine TensorProduct.inductionOn (motive := fun z => g_inv (g_fwd z) = z) z ?_
        (fun a b ha hb => by rw [map_add, map_add, ha, hb])
      intro c d
      have h_app : g_fwd (c ⊗ₜ[B_nod] d) = Ideal.Quotient.mk I₀ (ι_kD c * d) := by
        dsimp only [g_fwd]
        rw [Algebra.TensorProduct.lift_tmul]
        have h1 : (Algebra.ofId k₀ E) c = Ideal.Quotient.mk I₀ (ι_kD c) := rfl
        have h2 : g_DE d = Ideal.Quotient.mk I₀ d := rfl
        rw [h1, h2, ← map_mul]
      rw [h_app]
      change (1 : k₀) ⊗ₜ[B_nod] (ι_kD c * d) = c ⊗ₜ[B_nod] d
      have hcd : ι_kD c * d = (Ideal.Quotient.mk I_rel (MvPolynomial.C c)) • d := rfl
      rw [hcd, ← TensorProduct.smul_tmul (Ideal.Quotient.mk I_rel (MvPolynomial.C c)) (1 : k₀) d]
      congr 1
      rw [Algebra.smul_def, mul_one]
      exact MvPolynomial.constantCoeff_C (Fin 2) c
    have hg_right : ∀ e : E, g_fwd (g_inv e) = e := by
      intro e
      obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective e
      change g_fwd ((1 : k₀) ⊗ₜ[B_nod] d) = Ideal.Quotient.mk I₀ d
      dsimp only [g_fwd]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    let e_E : TensorProduct B_nod k₀ D ≃ₐ[k₀] E :=
      { g_fwd with
        invFun := g_inv
        left_inv := hg_left
        right_inv := hg_right }
    haveI : Algebra.Etale k₀ E := Algebra.Etale.of_equiv e_E
    haveI : IsReduced E := Algebra.FormallyUnramified.isReduced_of_field k₀ E
    haveI : Module.Finite k₀ E := Algebra.FormallyUnramified.finite_of_free k₀ E
    
    have hI₀_le : I₀ ≤ 𝔫₀.asIdeal := by
      rw [Ideal.span_le]
      rintro _ (rfl | h_eq1)
      · exact hX 0
      · rw [Set.mem_singleton_iff.mp h_eq1]
        exact hX 1
    let L := D ⧸ 𝔫₀.asIdeal
    haveI : IsDomain L := Ideal.Quotient.isDomain 𝔫₀.asIdeal
    letI : Algebra k₀ L := ((Ideal.Quotient.mk 𝔫₀.asIdeal).comp ι_kD).toAlgebra
    let π_EL : E →ₐ[k₀] L :=
      { toRingHom := Ideal.Quotient.factor hI₀_le
        commutes' := fun _ => rfl }
    have hπ_EL_surj : Function.Surjective π_EL := Ideal.Quotient.factor_surjective hI₀_le
    haveI : Module.Finite k₀ L := Module.Finite.of_surjective π_EL.toLinearMap hπ_EL_surj
    haveI : Algebra.IsIntegral k₀ L := Algebra.IsIntegral.of_finite k₀ L
    have h_bij_L : Function.Bijective (algebraMap k₀ L) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_L : k₀ ≃+* L := RingEquiv.ofBijective (algebraMap k₀ L) h_bij_L
    let ε_D : D →+* k₀ := e_L.symm.toRingHom.comp (Ideal.Quotient.mk 𝔫₀.asIdeal)
    have hε_ker : RingHom.ker ε_D = 𝔫₀.asIdeal := by
      ext d
      simp only [RingHom.mem_ker, ε_D, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe]
      rw [RingEquiv.coe_toRingHom, map_eq_zero_iff _ e_L.symm.injective]
      exact Ideal.Quotient.eq_zero_iff_mem
    have hε_C : ε_D.comp ι_kD = RingHom.id k₀ := by
      ext c
      change e_L.symm (algebraMap k₀ L c) = c
      exact e_L.symm_apply_apply c
    
    have hMax_eq : IsLocalRing.maximalIdeal R_loc = Ideal.span ({x₀, x₁} : Set R_loc) := by
      refine le_antisymm ?_ ?_
      · let 𝔫_bar : Ideal E := RingHom.ker π_EL.toRingHom
        haveI : 𝔫_bar.IsPrime := RingHom.ker_isPrime π_EL.toRingHom
        have h_mem_nbar : ∀ d : D, Ideal.Quotient.mk I₀ d ∈ 𝔫_bar ↔ d ∈ 𝔫₀.asIdeal := by
          intro d
          change Ideal.Quotient.factor hI₀_le (Ideal.Quotient.mk I₀ d) = 0 ↔ d ∈ 𝔫₀.asIdeal
          rw [Ideal.Quotient.factor_mk]
          exact Ideal.Quotient.eq_zero_iff_mem
        have hE_primes_max : ∀ 𝔮 : Ideal E, 𝔮.IsPrime → 𝔮.IsMaximal := by
          intro 𝔮 h𝔮
          haveI : IsDomain (E ⧸ 𝔮) := Ideal.Quotient.isDomain 𝔮
          haveI : Module.Finite k₀ (E ⧸ 𝔮) :=
            Module.Finite.of_surjective (Ideal.Quotient.mkₐ k₀ 𝔮).toLinearMap
              Ideal.Quotient.mk_surjective
          haveI : Algebra.IsIntegral k₀ (E ⧸ 𝔮) := Algebra.IsIntegral.of_finite k₀ (E ⧸ 𝔮)
          exact Ideal.Quotient.maximal_of_isField 𝔮
            (isField_of_isIntegral_of_isField' (Field.toIsField k₀))
        let E_loc := Localization.AtPrime 𝔫_bar
        have h_n₀_in_span : ∀ y ∈ 𝔫₀.asIdeal,
            algebraMap D R_loc y ∈ Ideal.span ({x₀, x₁} : Set R_loc) := by
          intro y hy
          let y_bar : E := Ideal.Quotient.mk I₀ y
          have hy_bar : y_bar ∈ 𝔫_bar := (h_mem_nbar y).mpr hy
          have hz_rad : algebraMap E E_loc y_bar ∈ (⊥ : Ideal E_loc).radical := by
            rw [Ideal.radical_eq_sInf]
            refine Ideal.mem_sInf.mpr ?_
            rintro P ⟨_, hP⟩
            let 𝔮 : Ideal E := Ideal.comap (algebraMap E E_loc) P
            have h𝔮_prime : 𝔮.IsPrime := Ideal.IsPrime.comap (algebraMap E E_loc)
            have h𝔮_le : 𝔮 ≤ 𝔫_bar := by
              intro e he
              by_contra he_not
              have h_unit : IsUnit (algebraMap E E_loc e) :=
                IsLocalization.map_units E_loc (⟨e, he_not⟩ : 𝔫_bar.primeCompl)
              exact hP.ne_top (Ideal.eq_top_of_isUnit_mem P he h_unit)
            have h𝔮_eq : 𝔮 = 𝔫_bar :=
              (hE_primes_max 𝔮 h𝔮_prime).eq_of_le ‹𝔫_bar.IsPrime›.ne_top h𝔮_le
            have hy_𝔮 : y_bar ∈ 𝔮 := h𝔮_eq.symm ▸ hy_bar
            exact hy_𝔮
          obtain ⟨k, hk⟩ := hz_rad
          have hz_zero : algebraMap E E_loc y_bar = 0 :=
            eq_zero_of_pow_eq_zero (Ideal.mem_bot.mp hk)
          obtain ⟨⟨s_bar, hs_bar⟩, hsy_bar⟩ :=
            (IsLocalization.map_eq_zero_iff 𝔫_bar.primeCompl E_loc y_bar).mp hz_zero
          obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective s_bar
          have hs_not : s ∉ 𝔫₀.asIdeal := fun hs => hs_bar ((h_mem_nbar s).mpr hs)
          have hsy_mem : s * y ∈ I₀ := by
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
            exact hsy_bar
          have h_map_I₀ : Ideal.map (algebraMap D R_loc) I₀ =
              Ideal.span ({x₀, x₁} : Set R_loc) := by
            dsimp [I₀, x₀, x₁]
            rw [Ideal.map_span, Set.image_pair]
          have h_prod_mem : algebraMap D R_loc s * algebraMap D R_loc y ∈
              Ideal.span ({x₀, x₁} : Set R_loc) := by
            rw [← map_mul, ← h_map_I₀]
            exact Ideal.mem_map_of_mem (algebraMap D R_loc) hsy_mem
          obtain ⟨u_s, hu_s⟩ :=
            IsLocalization.map_units R_loc (⟨s, hs_not⟩ : 𝔫₀.asIdeal.primeCompl)
          have hy_eq : algebraMap D R_loc y =
              ↑u_s⁻¹ * (algebraMap D R_loc s * algebraMap D R_loc y) := by
            rw [← hu_s, ← mul_assoc, Units.inv_mul, one_mul]
          rw [hy_eq]
          exact Ideal.mul_mem_left _ _ h_prod_mem
        intro z hz
        obtain ⟨⟨y, t⟩, hzt⟩ := IsLocalization.surj 𝔫₀.asIdeal.primeCompl z
        dsimp at hzt
        obtain ⟨u_t, hu_t⟩ := IsLocalization.map_units R_loc t
        have hz_eq : z = algebraMap D R_loc y * ↑u_t⁻¹ := by
          calc
            z = (z * ↑u_t) * ↑u_t⁻¹ := by rw [mul_assoc, Units.mul_inv, mul_one]
            _ = (z * algebraMap D R_loc t.1) * ↑u_t⁻¹ := by rw [hu_t]
            _ = algebraMap D R_loc y * ↑u_t⁻¹ := by rw [hzt]
        have hy_mem : y ∈ 𝔫₀.asIdeal := by
          by_contra hy_not
          obtain ⟨u_y, hu_y⟩ :=
            IsLocalization.map_units R_loc (⟨y, hy_not⟩ : 𝔫₀.asIdeal.primeCompl)
          have hz_unit : IsUnit z := by
            refine ⟨u_y * u_t⁻¹, ?_⟩
            rw [Units.val_mul, hu_y, ← hz_eq]
          exact IsLocalRing.notMem_maximalIdeal.mpr hz_unit hz
        rw [hz_eq]
        exact Ideal.mul_mem_right _ _ (h_n₀_in_span y hy_mem)
      · rw [Ideal.span_le]
        rintro _ (rfl | h_eq1)
        · exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc 𝔫₀.asIdeal d₀).mpr (hX 0)
        · rw [Set.mem_singleton_iff.mp h_eq1]
          exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc 𝔫₀.asIdeal d₁).mpr (hX 1)
    
    haveI : Module.Flat B_nod R_loc := Localization.flat D 𝔫₀.asIdeal.primeCompl
    let φ₂ : B_nod →+* R_loc := algebraMap B_nod R_loc
    have hBranchReg : ∀ (i j : Fin 2), i ≠ j →
        ∀ r : R_loc, φ₂ (bX j) * r ∈ Ideal.span {φ₂ (bX i)} →
          r ∈ Ideal.span {φ₂ (bX i)} := by
      intro i j hij
      let σ : MvPolynomial (Fin 2) k₀ →+* MvPolynomial (Fin 2) k₀ :=
        (MvPolynomial.aeval (fun k : Fin 2 =>
          if k = i then (0 : MvPolynomial (Fin 2) k₀) else MvPolynomial.X j)).toRingHom
      have hσ_Xi : σ (MvPolynomial.X i) = 0 := by simp [σ]
      have hσ_Xj : σ (MvPolynomial.X j) = MvPolynomial.X j := by simp [σ, hij.symm]
      have hσ_rel : σ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 := by
        rw [map_mul]
        have hij_cases : i = 0 ∨ i = 1 := by fin_cases i <;> simp
        rcases hij_cases with rfl | rfl
        · rw [hσ_Xi, zero_mul]
        · rw [hσ_Xi, mul_zero]
      let I_Xi : Ideal (MvPolynomial (Fin 2) k₀) :=
        Ideal.span ({MvPolynomial.X i} : Set (MvPolynomial (Fin 2) k₀))
      have hσ_mod : ∀ P : MvPolynomial (Fin 2) k₀, P - σ P ∈ I_Xi := by
        intro P
        refine MvPolynomial.induction_on (motive := fun P => P - σ P ∈ I_Xi) P ?_ ?_ ?_
        · intro c
          have hc : σ (MvPolynomial.C c) = MvPolynomial.C c := by simp [σ]
          rw [hc, sub_self]
          exact I_Xi.zero_mem
        · intro p q hp hq
          rw [map_add]
          have h_eq : (p + q) - (σ p + σ q) = (p - σ p) + (q - σ q) := by ring
          rw [h_eq]
          exact I_Xi.add_mem hp hq
        · intro p k hp
          rw [map_mul]
          by_cases hki : k = i
          · rw [hki, hσ_Xi, mul_zero, sub_zero]
            exact I_Xi.mul_mem_left p (Ideal.subset_span rfl)
          · have hkj : k = j := by
              fin_cases i <;> fin_cases j <;> fin_cases k <;> simp_all
            rw [hkj, hσ_Xj, ← sub_mul]
            exact I_Xi.mul_mem_right (MvPolynomial.X j) hp
      let I_Bi : Ideal B_nod := Ideal.span {bX i}
      let M_i := B_nod ⧸ I_Bi
      let μ_j : M_i →ₗ[B_nod] M_i := LinearMap.lsmul B_nod M_i (bX j)
      have hμ_inj : Function.Injective μ_j := by
        intro m₁ m₂ hm
        have hm0 : μ_j (m₁ - m₂) = 0 := by rw [map_sub, hm, sub_self]
        obtain ⟨b, h_b⟩ := Ideal.Quotient.mk_surjective (m₁ - m₂)
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective b
        rw [← h_b] at hm0
        have h_prod_in : Ideal.Quotient.mk I_rel (MvPolynomial.X j * P) ∈ I_Bi := by
          have h1 : bX j * Ideal.Quotient.mk I_rel P ∈ I_Bi := by
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
            exact hm0
          simpa [bX, map_mul] using h1
        rw [Ideal.mem_span_singleton] at h_prod_in
        obtain ⟨q_A, hq_A⟩ := h_prod_in
        obtain ⟨A_poly, rfl⟩ := Ideal.Quotient.mk_surjective q_A
        have h_diff_rel : MvPolynomial.X j * P - MvPolynomial.X i * A_poly ∈ I_rel := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hq_A]
          simp [bX, map_mul]
        rw [Ideal.mem_span_singleton] at h_diff_rel
        obtain ⟨B_poly, hB_poly⟩ := h_diff_rel
        have hσ_eq := congrArg σ hB_poly
        rw [map_sub, map_mul, map_mul, map_mul, hσ_Xj, hσ_Xi, zero_mul, sub_zero,
          hσ_rel, zero_mul] at hσ_eq
        have hX_ne : (MvPolynomial.X j : MvPolynomial (Fin 2) k₀) ≠ 0 := MvPolynomial.X_ne_zero j
        have hσP_zero : σ P = 0 := (mul_eq_zero.mp hσ_eq).resolve_left hX_ne
        have hP_in : P ∈ I_Xi := by
          simpa [hσP_zero] using hσ_mod P
        dsimp [I_Xi] at hP_in
        rw [Ideal.mem_span_singleton] at hP_in
        obtain ⟨Q_poly, rfl⟩ := hP_in
        refine sub_eq_zero.mp ?_
        rw [← h_b]
        refine Ideal.Quotient.eq_zero_iff_mem.mpr ?_
        rw [Ideal.mem_span_singleton]
        exact ⟨Ideal.Quotient.mk I_rel Q_poly, by simp [bX, map_mul]⟩
      have h_lTensor_μ : Function.Injective (LinearMap.lTensor R_loc μ_j) :=
        Module.Flat.lTensor_preserves_injective_linearMap μ_j hμ_inj
      let e_i := Algebra.TensorProduct.quotIdealMapEquivTensorQuot R_loc I_Bi
      have h_map_IBi : Ideal.map (algebraMap B_nod R_loc) I_Bi = Ideal.span {φ₂ (bX i)} := by
        dsimp [I_Bi, φ₂]
        rw [Ideal.map_span, Set.image_singleton]
      intro r hr
      rw [← h_map_IBi] at hr ⊢
      let I_map_i : Ideal R_loc := Ideal.map (algebraMap B_nod R_loc) I_Bi
      let q_r : R_loc ⧸ I_map_i := Ideal.Quotient.mk I_map_i r
      have he_zero : e_i (Ideal.Quotient.mk I_map_i 0) = 0 := by
        rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk, TensorProduct.zero_tmul]
      have h_zero_apply :
          (LinearMap.lTensor R_loc μ_j) (e_i q_r) = 0 := by
        rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
        change r ⊗ₜ[B_nod] (bX j • (1 : M_i)) = 0
        rw [← TensorProduct.smul_tmul (bX j) r (1 : M_i)]
        have h_smul_r : bX j • r = φ₂ (bX j) * r := Algebra.smul_def (bX j) r
        rw [h_smul_r, ← Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk R_loc I_Bi]
        have h_mk_eq : Ideal.Quotient.mk I_map_i (φ₂ (bX j) * r) =
            Ideal.Quotient.mk I_map_i 0 := by
          rw [map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
        exact (congrArg e_i h_mk_eq).trans he_zero
      have he_qr_zero : e_i q_r = e_i (Ideal.Quotient.mk I_map_i 0) :=
        h_lTensor_μ (by rw [h_zero_apply, he_zero, map_zero])
      have hqr_zero : q_r = 0 := by
        have h1 : q_r = Ideal.Quotient.mk I_map_i 0 :=
          (e_i.left_inv q_r).symm.trans
            ((congrArg e_i.invFun he_qr_zero).trans (e_i.left_inv (Ideal.Quotient.mk I_map_i 0)))
        simpa using h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp hqr_zero
    exact ⟨hNoeth, ⟨ε_D, hε_ker, hε_C⟩, ⟨hMax_eq, hx_mul⟩,
      ⟨hBranchReg 0 1 (by decide), hBranchReg 1 0 (by decide)⟩⟩

  
  have hLocalBranches : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
      (x₀ x₁ : R),
      IsLocalRing.maximalIdeal R = Ideal.span ({x₀, x₁} : Set R) →
      x₀ * x₁ = 0 →
      (∀ r : R, x₁ * r ∈ Ideal.span {x₀} → r ∈ Ideal.span {x₀}) →
      (∀ r : R, x₀ * r ∈ Ideal.span {x₁} → r ∈ Ideal.span {x₁}) →
      ∀ (I₁ I₂ : Ideal R),
        I₁.IsRadical → I₂.IsRadical →
        I₁ ≤ IsLocalRing.maximalIdeal R → I₂ ≤ IsLocalRing.maximalIdeal R →
        I₁ * I₂ = ⊥ → I₁ ≠ ⊥ → I₂ ≠ ⊥ →
        I₁ ⊔ I₂ = IsLocalRing.maximalIdeal R := by
    intro R _ _ _ x₀ x₁ hMax hMul hReg₁ hReg₀ I₁ I₂ hRad₁ hRad₂ hLe₁ hLe₂ hMulI hNe₁ hNe₂
    let P₀ : Ideal R := Ideal.span {x₀}
    let P₁ : Ideal R := Ideal.span {x₁}
    have hDisj : P₀ ⊓ P₁ = ⊥ := by
      rw [eq_bot_iff]
      intro z ⟨hz₀, hz₁⟩
      change z ∈ Ideal.span {x₀} at hz₀
      change z ∈ Ideal.span {x₁} at hz₁
      rw [Ideal.mem_span_singleton] at hz₀
      obtain ⟨r, rfl⟩ := hz₀
      have hr₁ : r ∈ Ideal.span {x₁} := hReg₀ r hz₁
      rw [Ideal.mem_span_singleton] at hr₁
      obtain ⟨s, rfl⟩ := hr₁
      rw [← mul_assoc, hMul, zero_mul]
      exact Ideal.zero_mem ⊥
    have hSingleBranch : ∀ (u v : R),
        IsLocalRing.maximalIdeal R = Ideal.span ({u, v} : Set R) →
        u * v = 0 →
        (∀ r : R, v * r ∈ Ideal.span {u} → r ∈ Ideal.span {u}) →
        Ideal.span {u} ⊓ Ideal.span {v} = ⊥ →
        (Ideal.span {u}).IsPrime ∧
        (∀ I : Ideal R, I.IsRadical → I ≤ Ideal.span {v} → ¬ I ≤ Ideal.span {u} →
          I = Ideal.span {v}) := by
      intro u v hMax_uv huv h_reg h_disj
      let P_u : Ideal R := Ideal.span {u}
      let P_v : Ideal R := Ideal.span {v}
      have hPu_le_max : P_u ≤ IsLocalRing.maximalIdeal R := by
        rw [hMax_uv]
        exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert u {v}))
      have hPv_le_max : P_v ≤ IsLocalRing.maximalIdeal R := by
        rw [hMax_uv]
        exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert_of_mem u rfl))
      have hPu_ne_top : P_u ≠ ⊤ :=
        ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top hPu_le_max
      let Q := R ⧸ P_u
      let π : R →+* Q := Ideal.Quotient.mk P_u
      haveI : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hPu_ne_top
      haveI : IsLocalRing Q := IsLocalRing.of_surjective' π Ideal.Quotient.mk_surjective
      haveI : IsNoetherianRing Q := Ideal.Quotient.isNoetherianRing P_u
      let v_bar : Q := π v
      have h_unit_iff : ∀ r : R, IsUnit (π r) ↔ r ∉ IsLocalRing.maximalIdeal R := by
        intro r
        constructor
        · intro h_unit hr_mem
          obtain ⟨q_inv, hq_inv⟩ := h_unit.exists_right_inv
          obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective q_inv
          have h_diff : 1 - r * s ∈ P_u := by
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, hq_inv, sub_self]
          have h_one_mem : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
            have h1 : (1 : R) = r * s + (1 - r * s) := by ring
            rw [h1]
            exact Ideal.add_mem _ (Ideal.mul_mem_right s _ hr_mem) (hPu_le_max h_diff)
          exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
            ((Ideal.eq_top_iff_one _).mpr h_one_mem)
        · intro hr_not
          exact (IsLocalRing.notMem_maximalIdeal.mp hr_not).map π
      have hMax_Q : IsLocalRing.maximalIdeal Q = Ideal.span {v_bar} := by
        refine le_antisymm ?_ ?_
        · intro q hq
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
          have hr_max : r ∈ IsLocalRing.maximalIdeal R := by
            by_contra hr_not
            exact IsLocalRing.notMem_maximalIdeal.mpr ((h_unit_iff r).mpr hr_not) hq
          rw [hMax_uv, Ideal.span_insert] at hr_max
          obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hr_max
          rw [Ideal.mem_span_singleton] at hb
          obtain ⟨c, rfl⟩ := hb
          change π (a + v * c) ∈ Ideal.span {v_bar}
          rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_add, map_mul]
          exact Ideal.mem_span_singleton.mpr ⟨π c, rfl⟩
        · rw [Ideal.span_singleton_le_iff_mem]
          by_contra hv_not
          have hv_unit : IsUnit v_bar := IsLocalRing.notMem_maximalIdeal.mp hv_not
          have hv_not_max : v ∉ IsLocalRing.maximalIdeal R := (h_unit_iff v).mp hv_unit
          exact hv_not_max (hPv_le_max (Ideal.subset_span rfl))
      have hv_pow_reg : ∀ (n : ℕ) (q : Q), v_bar ^ n * q = 0 → q = 0 := by
        intro n
        induction n with
        | zero =>
          intro q hq
          simpa using hq
        | succ n ih =>
          intro q hq
          rw [pow_succ, mul_assoc] at hq
          have hvq : v_bar * q = 0 := ih (v_bar * q) hq
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
          have hvr_in : v * r ∈ P_u := by
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
            exact hvq
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (h_reg r hvr_in)
      have h_krull : ⨅ n : ℕ, (Ideal.span {v_bar}) ^ n = (⊥ : Ideal Q) :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing (Ideal.span {v_bar})
          (hMax_Q ▸ (IsLocalRing.maximalIdeal.isMaximal Q).ne_top)
      have h_dvr_decomp : ∀ q : Q, q ≠ 0 → ∃ (n : ℕ) (w : Q), IsUnit w ∧ q = v_bar ^ n * w := by
        intro q hq
        have hq_not_iInf : q ∉ ⨅ n : ℕ, (Ideal.span {v_bar}) ^ n := by
          rw [h_krull, Ideal.mem_bot]
          exact hq
        rw [Ideal.mem_iInf] at hq_not_iInf
        push Not at hq_not_iInf
        obtain ⟨N, hN⟩ := hq_not_iInf
        rw [Ideal.span_singleton_pow] at hN
        have h_step : ∃ n : ℕ, q ∈ Ideal.span {v_bar ^ n} ∧ q ∉ Ideal.span {v_bar ^ (n + 1)} := by
          by_contra h_all
          push Not at h_all
          have h_ind : ∀ k : ℕ, q ∈ Ideal.span {v_bar ^ k} := by
            intro k
            induction k with
            | zero => simp
            | succ k ihk => exact h_all k ihk
          exact hN (h_ind N)
        obtain ⟨n, hn_in, hn_out⟩ := h_step
        rw [Ideal.mem_span_singleton] at hn_in
        obtain ⟨w, rfl⟩ := hn_in
        refine ⟨n, w, ?_, rfl⟩
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hw_max
        rw [hMax_Q, Ideal.mem_span_singleton] at hw_max
        obtain ⟨w', rfl⟩ := hw_max
        apply hn_out
        rw [← mul_assoc, ← pow_succ, Ideal.mem_span_singleton]
        exact ⟨w', rfl⟩
      haveI : NoZeroDivisors Q :=
        { eq_zero_or_eq_zero_of_mul_eq_zero := by
            intro q₁ q₂ hmul
            by_cases hq₁ : q₁ = 0
            · exact Or.inl hq₁
            · obtain ⟨n, w, hw_unit, rfl⟩ := h_dvr_decomp q₁ hq₁
              obtain ⟨u_w, rfl⟩ := hw_unit
              have h1 : v_bar ^ n * q₂ = 0 := by
                have h2 : ↑u_w * (v_bar ^ n * q₂) = 0 := by
                  calc
                    ↑u_w * (v_bar ^ n * q₂) = v_bar ^ n * ↑u_w * q₂ := by ring
                    _ = 0 := hmul
                simpa using congrArg (fun z : Q => ↑u_w⁻¹ * z) h2
              exact Or.inr (hv_pow_reg n q₂ h1) }
      haveI : IsDomain Q := NoZeroDivisors.to_isDomain Q
      have hPu_prime : P_u.IsPrime := (Ideal.Quotient.isDomain_iff_prime P_u).mp inferInstance
      refine ⟨hPu_prime, ?_⟩
      intro I hIRad hI_le hI_not
      obtain ⟨f, hfI, hf_not_u⟩ := Set.not_subset.mp hI_not
      have hπf_ne : π f ≠ 0 := fun h0 => hf_not_u (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      obtain ⟨n, w, hw_unit, hπf_eq⟩ := h_dvr_decomp (π f) hπf_ne
      obtain ⟨w_tilde, rfl⟩ := Ideal.Quotient.mk_surjective w
      have hw_tilde_unit : IsUnit w_tilde :=
        IsLocalRing.notMem_maximalIdeal.mp ((h_unit_iff w_tilde).mp hw_unit)
      have hn_ne_zero : n ≠ 0 := by
        rintro rfl
        rw [pow_zero, one_mul] at hπf_eq
        have hf_unit_Q : IsUnit (π f) := hπf_eq.symm ▸ hw_unit
        exact (h_unit_iff f).mp hf_unit_Q (hPv_le_max (hI_le hfI))
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn_ne_zero
      have h_diff_u : f - v ^ (k + 1) * w_tilde ∈ P_u := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_pow]
        exact sub_eq_zero.mpr hπf_eq
      have h_diff_v : f - v ^ (k + 1) * w_tilde ∈ P_v := by
        refine Ideal.sub_mem P_v (hI_le hfI) ?_
        rw [pow_succ', mul_assoc]
        exact Ideal.mem_span_singleton.mpr ⟨v ^ k * w_tilde, rfl⟩
      have h_diff_bot : f - v ^ (k + 1) * w_tilde ∈ (⊥ : Ideal R) := by
        rw [← h_disj]
        exact ⟨h_diff_u, h_diff_v⟩
      have hf_eq : f = v ^ (k + 1) * w_tilde := sub_eq_zero.mp (Ideal.mem_bot.mp h_diff_bot)
      obtain ⟨u_wt, rfl⟩ := hw_tilde_unit
      have hv_pow_I : v ^ (k + 1) ∈ I := by
        have h1 : v ^ (k + 1) = f * ↑u_wt⁻¹ := by
          rw [hf_eq, mul_assoc, Units.mul_inv, mul_one]
        rw [h1]
        exact Ideal.mul_mem_right _ I hfI
      have hv_I : v ∈ I := hIRad ⟨k + 1, hv_pow_I⟩
      exact le_antisymm hI_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hv_I))
    obtain ⟨hP₀_prime, hUniq₁⟩ := hSingleBranch x₀ x₁ hMax hMul hReg₁ hDisj
    have hMax_swap : IsLocalRing.maximalIdeal R = Ideal.span ({x₁, x₀} : Set R) := by
      rw [Set.pair_comm]
      exact hMax
    have hDisj_swap : Ideal.span {x₁} ⊓ Ideal.span {x₀} = ⊥ := by
      rw [inf_comm]
      exact hDisj
    obtain ⟨hP₁_prime, hUniq₀⟩ :=
      hSingleBranch x₁ x₀ hMax_swap (by rw [mul_comm, hMul]) hReg₀ hDisj_swap
    have h_or₀ : I₁ ≤ P₀ ∨ I₂ ≤ P₀ :=
      hP₀_prime.mul_le.mp (by rw [hMulI]; exact bot_le)
    have h_or₁ : I₁ ≤ P₁ ∨ I₂ ≤ P₁ :=
      hP₁_prime.mul_le.mp (by rw [hMulI]; exact bot_le)
    have hI₁_not_both : ¬ (I₁ ≤ P₀ ∧ I₁ ≤ P₁) := by
      rintro ⟨h0, h1⟩
      exact hNe₁ (le_bot_iff.mp (hDisj ▸ le_inf h0 h1))
    have hI₂_not_both : ¬ (I₂ ≤ P₀ ∧ I₂ ≤ P₁) := by
      rintro ⟨h0, h1⟩
      exact hNe₂ (le_bot_iff.mp (hDisj ▸ le_inf h0 h1))
    rcases h_or₀ with hI₁₀ | hI₂₀ <;> rcases h_or₁ with hI₁₁ | hI₂₁
    · exact False.elim (hI₁_not_both ⟨hI₁₀, hI₁₁⟩)
    · have hI₁_eq : I₁ = P₀ := hUniq₀ I₁ hRad₁ hI₁₀ (fun h => hI₁_not_both ⟨hI₁₀, h⟩)
      have hI₂_eq : I₂ = P₁ := hUniq₁ I₂ hRad₂ hI₂₁ (fun h => hI₂_not_both ⟨h, hI₂₁⟩)
      rw [hI₁_eq, hI₂_eq, hMax, Ideal.span_insert]
    · have hI₁_eq : I₁ = P₁ := hUniq₁ I₁ hRad₁ hI₁₁ (fun h => hI₁_not_both ⟨h, hI₁₁⟩)
      have hI₂_eq : I₂ = P₀ := hUniq₀ I₂ hRad₂ hI₂₀ (fun h => hI₂_not_both ⟨hI₂₀, h⟩)
      rw [hI₁_eq, hI₂_eq, sup_comm, hMax, Ideal.span_insert]
    · exact False.elim (hI₂_not_both ⟨hI₂₀, hI₂₁⟩)

  
  have hFlatDescent : ∀ (D : Type u) [CommRing D] (ψ₁ : R₁ →+* D), ψ₁.Etale →
      ∀ (𝔭 : PrimeSpectrum R₁) (𝔫₀ : PrimeSpectrum D),
        PrimeSpectrum.comap ψ₁ 𝔫₀ = 𝔭 →
        let φ₁ : R₁ →+* Localization.AtPrime 𝔫₀.asIdeal :=
          (algebraMap D (Localization.AtPrime 𝔫₀.asIdeal)).comp ψ₁
        (∀ (J : Ideal R₁) (𝔮 : PrimeSpectrum R₁),
          𝔮.asIdeal ≤ 𝔭.asIdeal → ¬ J ≤ 𝔮.asIdeal → Ideal.map φ₁ J ≠ ⊥) ∧
        (∀ (I : Ideal R₁),
          Ideal.map φ₁ I = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫₀.asIdeal) →
          ∀ x ∈ 𝔭.asIdeal, ∃ s : R₁, s ∉ 𝔭.asIdeal ∧ s * x ∈ I) := by
    intro D _ ψ₁ hψ₁ 𝔭 𝔫₀ hcomap
    let R_p := Localization.AtPrime 𝔭.asIdeal
    let R_loc := Localization.AtPrime 𝔫₀.asIdeal
    let φ₁ : R₁ →+* R_loc := (algebraMap D R_loc).comp ψ₁
    have h_eq : 𝔭.asIdeal = Ideal.comap ψ₁ 𝔫₀.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hcomap.symm
    let lam : R_p →+* R_loc :=
      Localization.localRingHom 𝔭.asIdeal 𝔫₀.asIdeal ψ₁ h_eq
    haveI : IsLocalHom lam := Localization.isLocalHom_localRingHom 𝔭.asIdeal 𝔫₀.asIdeal ψ₁ h_eq
    have hlam_comp : lam.comp (algebraMap R₁ R_p) = φ₁ := by
      ext r
      exact Localization.localRingHom_to_map 𝔭.asIdeal 𝔫₀.asIdeal ψ₁ h_eq r
    letI : Algebra R₁ D := ψ₁.toAlgebra
    haveI : Algebra.Etale R₁ D := RingHom.etale_algebraMap.mp hψ₁
    haveI : Module.Flat R₁ R_loc := Localization.flat D 𝔫₀.asIdeal.primeCompl
    letI : Algebra R_p R_loc := lam.toAlgebra
    haveI : IsScalarTower R₁ R_p R_loc :=
      ⟨fun r y z => by
        rw [Algebra.smul_def r y, Algebra.smul_def _ z, map_mul, mul_assoc,
          ← Algebra.smul_def y z]
        have h_alg : algebraMap R_p R_loc (algebraMap R₁ R_p r) = algebraMap R₁ R_loc r :=
          Localization.localRingHom_to_map 𝔭.asIdeal 𝔫₀.asIdeal ψ₁ h_eq r
        rw [h_alg, ← Algebra.smul_def r (y • z)]⟩
    haveI : Module.Flat R_p R_loc :=
      (Module.flat_iff_of_isLocalization R_p 𝔭.asIdeal.primeCompl R_loc).mpr inferInstance
    haveI : IsLocalHom (algebraMap R_p R_loc) := ‹IsLocalHom lam›
    haveI : Module.FaithfullyFlat R_p R_loc := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have h_comap_map : ∀ K : Ideal R_p, Ideal.comap lam (Ideal.map lam K) = K :=
      fun K => Ideal.comap_map_eq_self_of_faithfullyFlat K
    constructor
    · intro J 𝔮 h𝔮_le hJ_not h_bot
      obtain ⟨f, hfJ, hf_not_𝔮⟩ := Set.not_subset.mp hJ_not
      have hφf_zero : lam (algebraMap R₁ R_p f) = 0 := by
        have h1 : φ₁ f ∈ Ideal.map φ₁ J := Ideal.mem_map_of_mem φ₁ hfJ
        rw [h_bot, Ideal.mem_bot] at h1
        rw [← hlam_comp] at h1
        exact h1
      have h_mem_comap : algebraMap R₁ R_p f ∈ Ideal.comap lam (Ideal.map lam ⊥) := by
        rw [Ideal.mem_comap, hφf_zero]
        exact Ideal.zero_mem _
      rw [h_comap_map ⊥, Ideal.mem_bot] at h_mem_comap
      obtain ⟨⟨m, hm_not_𝔭⟩, hmf_zero⟩ :=
        (IsLocalization.map_eq_zero_iff 𝔭.asIdeal.primeCompl R_p f).mp h_mem_comap
      have hmf_𝔮 : m * f ∈ 𝔮.asIdeal := hmf_zero.symm ▸ 𝔮.asIdeal.zero_mem
      rcases 𝔮.isPrime.mem_or_mem hmf_𝔮 with hm_𝔮 | hf_𝔮
      · exact hm_not_𝔭 (h𝔮_le hm_𝔮)
      · exact hf_not_𝔮 hf_𝔮
    · intro I hI_map x hx_𝔭
      let K_I : Ideal R_p := Ideal.map (algebraMap R₁ R_p) I
      have h_map_KI : Ideal.map lam K_I = IsLocalRing.maximalIdeal R_loc := by
        dsimp [K_I]
        rw [Ideal.map_map, hlam_comp, hI_map]
      have hψx : ψ₁ x ∈ 𝔫₀.asIdeal := by
        rw [h_eq] at hx_𝔭
        exact hx_𝔭
      have hφx_max : lam (algebraMap R₁ R_p x) ∈ Ideal.map lam K_I := by
        rw [h_map_KI, Localization.localRingHom_to_map 𝔭.asIdeal 𝔫₀.asIdeal ψ₁ h_eq x]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc 𝔫₀.asIdeal (ψ₁ x)).mpr hψx
      have hx_KI : algebraMap R₁ R_p x ∈ K_I := by
        rw [← h_comap_map K_I]
        exact hφx_max
      obtain ⟨⟨⟨i, hiI⟩, ⟨m, hm_not_𝔭⟩⟩, hxm_eq⟩ :=
        (IsLocalization.mem_map_algebraMap_iff 𝔭.asIdeal.primeCompl R_p).mp hx_KI
      dsimp at hxm_eq
      have h_diff_zero : algebraMap R₁ R_p (m * x - i) = 0 := by
        rw [map_sub, map_mul, mul_comm, hxm_eq, sub_self]
      obtain ⟨⟨t, ht_not_𝔭⟩, ht_mul_zero⟩ :=
        (IsLocalization.map_eq_zero_iff 𝔭.asIdeal.primeCompl R_p (m * x - i)).mp h_diff_zero
      refine ⟨t * m, (𝔭.asIdeal.primeCompl.mul_mem ht_not_𝔭 hm_not_𝔭), ?_⟩
      have h_eq_ti : (t * m) * x = t * i := by
        have h1 : t * (m * x) = t * i := sub_eq_zero.mp (by simpa [mul_sub] using ht_mul_zero)
        rw [mul_assoc, h1]
      rw [h_eq_ti]
      exact Ideal.mul_mem_left I t hiI

  
  constructor
  · intro 𝔭 h𝔭
    obtain ⟨_, _, D, instD, 𝔫₀, ψ₁, ψ₂, _, hψ₂, hcomap, hX, halg⟩ := hNodes 𝔭 h𝔭
    letI : CommRing D := instD
    obtain ⟨_, ⟨ε_D, hε_ker, hε_C⟩, _, _⟩ := hNodalModel D 𝔫₀ ψ₂ hψ₂ hX
    let ev : R₁ →ₐ[k₀] k₀ :=
      { toRingHom := ε_D.comp ψ₁
        commutes' := fun c => by
          change (ε_D.comp (ψ₁.comp (algebraMap k₀ R₁))) c = c
          rw [halg]
          exact congrFun (congrArg DFunLike.coe hε_C) c }
    refine ⟨ev, ?_⟩
    ext r
    change r ∈ RingHom.ker (ε_D.comp ψ₁) ↔ r ∈ 𝔭.asIdeal
    rw [RingHom.mem_ker, RingHom.comp_apply, ← RingHom.mem_ker, hε_ker, ← hcomap]
    rfl
  · intro x
    let I : Ideal R₁ := J_Z ⊔ J_Y'
    constructor
    · exact fun hx 𝔭 h𝔭 => h𝔭 hx
    · intro hx_all
      by_contra hx_not
      have hMul_bot : J_Z * J_Y' = ⊥ := le_bot_iff.mp (Ideal.mul_le_inf.trans hInf.le)
      let C_x : Ideal R₁ :=
        { carrier := {s : R₁ | s * x ∈ I}
          add_mem' := fun {a b} ha hb => by
            dsimp at ha hb ⊢
            rw [add_mul]
            exact I.add_mem ha hb
          zero_mem' := by simp
          smul_mem' := fun r {a} ha => by
            dsimp at ha ⊢
            rw [mul_assoc]
            exact I.mul_mem_left r ha }
      have hCx_ne_top : C_x ≠ ⊤ := by
        intro htop
        have h1 : (1 : R₁) ∈ C_x := htop ▸ Submodule.mem_top
        change (1 : R₁) * x ∈ I at h1
        rw [one_mul] at h1
        exact hx_not h1
      obtain ⟨𝔐, h𝔐_max, hC𝔐⟩ := Ideal.exists_le_maximal C_x hCx_ne_top
      by_cases hI𝔐 : I ≤ 𝔐
      · let 𝔭 : PrimeSpectrum R₁ := ⟨𝔐, h𝔐_max.isPrime⟩
        have hx_𝔭 : x ∈ 𝔭.asIdeal := hx_all 𝔭 hI𝔐
        obtain ⟨⟨𝔮_Z, h𝔮Z_le, _, h𝔮Z_not⟩, ⟨𝔮_Y', h𝔮Y'_le, _, h𝔮Y'_not⟩,
            D, instD, 𝔫₀, ψ₁, ψ₂, hψ₁, hψ₂, hcomap, hX, _⟩ := hNodes 𝔭 hI𝔐
        letI : CommRing D := instD
        let R_loc := Localization.AtPrime 𝔫₀.asIdeal
        let φ₁ : R₁ →+* R_loc := (algebraMap D R_loc).comp ψ₁
        let J_Z_loc : Ideal R_loc := Ideal.map φ₁ J_Z
        let J_Y'_loc : Ideal R_loc := Ideal.map φ₁ J_Y'
        have hRadZ_loc : J_Z_loc.IsRadical := hEtaleRad R₁ D ψ₁ hψ₁ J_Z hRadZ 𝔫₀
        have hRadY'_loc : J_Y'_loc.IsRadical := hEtaleRad R₁ D ψ₁ hψ₁ J_Y' hRadY' 𝔫₀
        have h𝔭_eq : 𝔭.asIdeal = Ideal.comap ψ₁ 𝔫₀.asIdeal :=
          congrArg PrimeSpectrum.asIdeal hcomap.symm
        have hI_loc_le : Ideal.map φ₁ I ≤ IsLocalRing.maximalIdeal R_loc := by
          rw [Ideal.map_le_iff_le_comap]
          intro a ha
          have ha_𝔭 : a ∈ 𝔭.asIdeal := hI𝔐 ha
          rw [h𝔭_eq] at ha_𝔭
          exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc 𝔫₀.asIdeal (ψ₁ a)).mpr ha_𝔭
        have hZ_loc_le : J_Z_loc ≤ IsLocalRing.maximalIdeal R_loc :=
          (Ideal.map_mono le_sup_left).trans hI_loc_le
        have hY'_loc_le : J_Y'_loc ≤ IsLocalRing.maximalIdeal R_loc :=
          (Ideal.map_mono le_sup_right).trans hI_loc_le
        have hMul_loc : J_Z_loc * J_Y'_loc = ⊥ := by
          dsimp [J_Z_loc, J_Y'_loc]
          rw [← Ideal.map_mul, hMul_bot, Ideal.map_bot]
        obtain ⟨hNonvanish, hColonDescent⟩ := hFlatDescent D ψ₁ hψ₁ 𝔭 𝔫₀ hcomap
        have hZ_ne_bot : J_Z_loc ≠ ⊥ := hNonvanish J_Z 𝔮_Y' h𝔮Y'_le h𝔮Y'_not
        have hY'_ne_bot : J_Y'_loc ≠ ⊥ := hNonvanish J_Y' 𝔮_Z h𝔮Z_le h𝔮Z_not
        obtain ⟨hNoeth_loc, _, ⟨hMax_loc, hx_mul_loc⟩, ⟨hReg₁_loc, hReg₀_loc⟩⟩ :=
          hNodalModel D 𝔫₀ ψ₂ hψ₂ hX
        letI : IsNoetherianRing R_loc := hNoeth_loc
        have hSup_loc : J_Z_loc ⊔ J_Y'_loc = IsLocalRing.maximalIdeal R_loc :=
          hLocalBranches R_loc _ _ hMax_loc hx_mul_loc hReg₁_loc hReg₀_loc
            J_Z_loc J_Y'_loc hRadZ_loc hRadY'_loc hZ_loc_le hY'_loc_le
            hMul_loc hZ_ne_bot hY'_ne_bot
        have hI_map_max : Ideal.map φ₁ I = IsLocalRing.maximalIdeal R_loc := by
          dsimp [I]
          rw [Ideal.map_sup]
          exact hSup_loc
        obtain ⟨s, hs_not_𝔭, hsx_I⟩ := hColonDescent I hI_map_max x hx_𝔭
        exact hs_not_𝔭 (hC𝔐 hsx_I)
      · obtain ⟨s, hsI, hs_not_𝔐⟩ := Set.not_subset.mp hI𝔐
        have hs_Cx : s ∈ C_x := I.mul_mem_right x hsI
        exact hs_not_𝔐 (hC𝔐 hs_Cx)

theorem weil_sup1_closed_fiber_scheme_to_nodal_rings (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀) :
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    let Y := CategoryTheory.Limits.pullback g s₀
    let fstY := CategoryTheory.Limits.pullback.fst g s₀
    let sndY := CategoryTheory.Limits.pullback.snd g s₀
    let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
    let V₀_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₀
    let V₁_Y : Y.Opens := (TopologicalSpace.Opens.map fstY.base).obj V₁
    let R₀_Y := Y.presheaf.obj (Opposite.op V₀_Y)
    let R₁_Y := Y.presheaf.obj (Opposite.op V₁_Y)
    let R₀₁_Y := Y.presheaf.obj (Opposite.op (V₀_Y ⊓ V₁_Y))
    let c₁_Y : k₀ →+* ↑R₁_Y :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE sndY ⊤ V₁_Y le_top).hom
    let res₀_Y : ↑R₀_Y →+* ↑R₀₁_Y :=
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀_Y ⊓ V₁_Y ≤ V₀_Y)).op).hom
