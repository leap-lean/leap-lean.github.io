        ∀ (p : ℕ) (ξ : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F),
          (∀ I, (t_loc (I.1 0)) ^ k * ξ I ∈ A (Finset.univ.image I.1)) →
          ∀ J : {J : Fin (p + 2) → Fin (N + 1) // StrictMono J},
