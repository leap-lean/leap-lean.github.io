    have : JacobsonSpace ↥F_P := AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace snd_P
    have hsP_pre : AlgebraicGeometry.IsPreimmersion s_P := by
      have hfac : algebraMap ↥V κ_P =
          (algebraMap (↥V ⧸ P.asIdeal) κ_P).comp (Ideal.Quotient.mk P.asIdeal) :=
        IsScalarTower.algebraMap_eq ↥V (↥V ⧸ P.asIdeal) κ_P
      have hsP_eq : s_P =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥V ⧸ P.asIdeal) κ_P)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P.asIdeal)) := by
