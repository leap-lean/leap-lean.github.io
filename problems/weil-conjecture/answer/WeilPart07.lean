    obtain ⟨⟨a₁, ⟨_, n₁, rfl⟩⟩, ha₁⟩ :=
      @IsLocalization.surj _ _ (Submonoid.powers h₀_Y) ↑R₀₁_Y _ res₀_Y.toAlgebra hLoc_R01 j_Z
    change j_Z * res₀_Y (h₀_Y ^ n₁) = res₀_Y a₁ at ha₁
