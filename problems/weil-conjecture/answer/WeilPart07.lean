          w_a ∈ B {a} ∧
          x_glob a - x_bar a = φ_VF π_a * w_a) :=
by
  have h_s1 : ∀ (F : Type u) [Field F] (N k : ℕ) (t_loc : Fin (N + 1) → F),
      (∀ (p : ℕ) (ξ : {I : Fin (p + 1) → Fin (N + 1) // StrictMono I} → F)
          (K : {K : Fin (p + 3) → Fin (N + 1) // StrictMono K}),
        (∑ r : Fin (p + 3), (-1 : F) ^ (r : ℕ) *
          (∑ q : Fin (p + 2), (-1 : F) ^ (q : ℕ) *
            ξ ⟨(K.1 ∘ r.succAbove) ∘ q.succAbove,
              (K.2.comp (Fin.strictMono_succAbove r)).comp (Fin.strictMono_succAbove q)⟩)) = 0) ∧
      (∀ (A : Finset (Fin (N + 1)) → Subring F),
        (∀ S S' : Finset (Fin (N + 1)), S.Nonempty → S ⊆ S' → A S ≤ A S') →
        (∀ S : Finset (Fin (N + 1)), S.Nonempty → ∀ a ∈ S, ∀ b ∈ S, t_loc a / t_loc b ∈ A S) →
