            Category.assoc, AlgebraicGeometry.Scheme.Hom.map_appLE]
        exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hc₁) θ
      have hq₂_eq : q₂ = (g₂.appLE W₂_a (Ω a) hg₂_le).hom ((φ₂.appLE (D a) W₂_a hle_X₂).hom θ) := by
        have hc₂ : Φ₂.appLE (D a) (Ω a) hle₂ =
