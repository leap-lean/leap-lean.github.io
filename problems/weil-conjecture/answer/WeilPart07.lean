    by_cases haI : a ∈ Set.range I.1
    · obtain ⟨r₀, hr₀⟩ := haI
      rw [Finset.sum_eq_single r₀]
      · have hle_r₀ : V_cov a ⊓ Finset.inf (Finset.univ.image (I.1 ∘ r₀.succAbove)) V_cov ≤
            Finset.inf (Finset.univ.image I.1) V_cov :=
          hInf_le hr₀ rfl
        rw [hη_char ⟨I.1 ∘ r₀.succAbove, I.2.comp (Fin.strictMono_succAbove r₀)⟩ I r₀ hr₀ rfl hle_r₀,
          map_zsmul, hY_map_comp, ← mul_zsmul, hNegOneSq, one_zsmul]
