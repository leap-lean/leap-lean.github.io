      have h_ker_span : Ideal.span {(⟨g_a, hg_in_Ba⟩ : ↥B_a)} ≤
          RingHom.ker (π_Qβ.toRingHom.comp μ_B.symm.toRingHom) := by
        rw [Ideal.span_le]
