        funext m
        dsimp only [simpOf, Function.comp_apply]
        apply congrArg K.1
        apply Fin.ext
        dsimp only [g]
        split_ifs <;> simp only [succAbove_val, Fin.val_succ, Fin.val_castSucc] <;>
          split_ifs <;> omega
      change ∑ x ∈ (Finset.univ ×ˢ Finset.univ), f x = 0
      refine Finset.sum_ninvolution g ?_ ?_ ?_ ?_
      · intro x
        dsimp only [f]
        rw [h_simp x]
        dsimp only [g]
        split_ifs with h
        · have hsucc : (-1 : F) ^ ((x.2.succ : Fin (p + 3)) : ℕ) =
              (-1 : F) ^ (x.2 : ℕ) * (-1) := by
            rw [Fin.val_succ, pow_add, pow_one]
          change (-1 : F) ^ (x.1 : ℕ) * ((-1 : F) ^ (x.2 : ℕ) * ξ (simpOf x)) +
            (-1 : F) ^ ((x.2.succ : Fin (p + 3)) : ℕ) *
