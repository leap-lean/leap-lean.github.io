        le_trans (Finset.le_sup (f := fun p : Fin r₁ × Fin (d₁ + 1) => e₁_fn p.1 p.2)
          (Finset.mem_univ (j, ν))) (Nat.le_add_left _ 1)
      have hpow : (ψ_Dt (h_loc j)) ^ n₁ * ψ₁ (sec₁ ν) =
          (ψ_Dt (h_loc j)) ^ (n₁ - e₁_fn j ν) * ((ψ_Dt (h_loc j)) ^ (e₁_fn j ν) * ψ₁ (sec₁ ν)) := by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
      rw [hpow]
      have hhD : ψ_Dt (h_loc j) ∈ ψ_D.range := hRange_Dt ▸ ⟨h_loc j, rfl⟩
      exact mul_mem (pow_mem hhD _) (he₁_mem j ν)
    let algWD : Algebra ↑(C_semi.presheaf.obj (Opposite.op W_aff)) ↑(C_semi.presheaf.obj (Opposite.op D)) :=
      (C_semi.presheaf.map (homOfLE (C_semi.basicOpen_le u)).op).hom.toAlgebra
    letI := algWD
    have hLoc_D : IsLocalization.Away u ↑(C_semi.presheaf.obj (Opposite.op D)) :=
      hAffW.isLocalization_basicOpen u
    have hu_mem_W : ψ_W u ∈ ψ_W.range := ⟨u, rfl⟩
    have hClear_u : ∀ z ∈ ψ_D.range, ∃ k : ℕ, ∀ m : ℕ, k ≤ m → (ψ_W u) ^ m * z ∈ ψ_W.range := by
      rintro z ⟨s_D, rfl⟩
      obtain ⟨k, a, hka⟩ := @IsLocalization.Away.surj _ _ _ _ _ u hLoc_D s_D
      refine ⟨k, fun m hm => ?_⟩
      have hka_F := congrArg ψ_D hka
      rw [map_mul, map_pow] at hka_F
      have hu_F : ψ_D (algebraMap _ _ u) = ψ_W u :=
        compat_res η_semi hAffW ψ_W hψ_W hAffD ψ_D hψ_D (C_semi.basicOpen_le u) u
      have ha_F : ψ_D (algebraMap _ _ a) = ψ_W a :=
        compat_res η_semi hAffW ψ_W hψ_W hAffD ψ_D hψ_D (C_semi.basicOpen_le u) a
      rw [hu_F, ha_F] at hka_F
      have heq : (ψ_W u) ^ m * ψ_D s_D = (ψ_W u) ^ (m - k) * (ψ_D s_D * (ψ_W u) ^ k) := by
        rw [mul_comm (ψ_D s_D), ← mul_assoc, ← pow_add, Nat.sub_add_cancel hm]
      rw [heq, hka_F]
      have ha_mem_W : ψ_W a ∈ ψ_W.range := ⟨a, rfl⟩
      exact mul_mem (pow_mem hu_mem_W _) ha_mem_W
    have hf_in_D : ∀ i, ψ_Dt (f_loc i) ∈ ψ_D.range := fun i => hRange_Dt ▸ ⟨f_loc i, rfl⟩
    have hα_in_D : ∀ i, ψ_Dt (α_loc i) ∈ ψ_D.range := fun i => hRange_Dt ▸ ⟨α_loc i, rfl⟩
    have hh_in_D : ∀ j, ψ_Dt (h_loc j) ∈ ψ_D.range := fun j => hRange_Dt ▸ ⟨h_loc j, rfl⟩
    have hγ_in_D : ∀ j, ψ_Dt (γ_loc j) ∈ ψ_D.range := fun j => hRange_Dt ▸ ⟨γ_loc j, rfl⟩
    choose kf hkf using fun i => hClear_u _ (hf_in_D i)
    choose kα hkα using fun i => hClear_u _ (hα_in_D i)
    choose kh hkh using fun j => hClear_u _ (hh_in_D j)
    choose kγ hkγ using fun j => hClear_u _ (hγ_in_D j)
    choose m₀ hm₀ using fun p : Fin r₀ × Fin (d₀ + 1) => hClear_u _ (hn₀_mem p.1 p.2)
    choose m₁ hm₁ using fun p : Fin r₁ × Fin (d₁ + 1) => hClear_u _ (hn₁_mem p.1 p.2)
    let K_exp : ℕ :=
      Finset.univ.sup kf ⊔ Finset.univ.sup kα ⊔ Finset.univ.sup kh ⊔ Finset.univ.sup kγ
    let M_exp : ℕ := Finset.univ.sup m₀ ⊔ Finset.univ.sup m₁
    let N₀ : ℕ := 2 * K_exp + M_exp
    let f_out : Fin r₀ → F := fun i => (ψ_W u) ^ K_exp * ψ_Dt (f_loc i)
    let α_out : Fin r₀ → F := fun i => (ψ_W u) ^ (K_exp + M_exp) * ψ_Dt (α_loc i)
    let h_out : Fin r₁ → F := fun j => (ψ_W u) ^ K_exp * ψ_Dt (h_loc j)
    let γ_out : Fin r₁ → F := fun j => (ψ_W u) ^ (K_exp + M_exp) * ψ_Dt (γ_loc j)
    refine ⟨N₀, n₀, n₁, r₀, r₁, f_out, α_out, h_out, γ_out, ?_, ?_, ?_, ?_, ?_⟩
    · intro i
      refine ⟨hkf i K_exp (le_trans (Finset.le_sup (Finset.mem_univ i))
          (le_trans le_sup_left (le_trans le_sup_left le_sup_left))),
        hkα i (K_exp + M_exp) (le_trans (Finset.le_sup (Finset.mem_univ i))
          (le_trans le_sup_right (le_trans le_sup_left (le_trans le_sup_left (Nat.le_add_right _ _)))))⟩
    · intro j
      refine ⟨hkh j K_exp (le_trans (Finset.le_sup (Finset.mem_univ j))
          (le_trans le_sup_right le_sup_left)),
        hkγ j (K_exp + M_exp) (le_trans (Finset.le_sup (Finset.mem_univ j))
          (le_trans le_sup_right (Nat.le_add_right _ _)))⟩
    · have hsum_F := congrArg ψ_Dt hsum_Dt
      rw [map_add, map_sum, map_sum, map_one] at hsum_F
      simp_rw [map_mul] at hsum_F
      have hcalc : (∑ i : Fin r₀, α_out i * f_out i) + (∑ j : Fin r₁, γ_out j * h_out j) =
          (ψ_W u) ^ N₀ * ((∑ i : Fin r₀, ψ_Dt (α_loc i) * ψ_Dt (f_loc i)) +
            (∑ j : Fin r₁, ψ_Dt (γ_loc j) * ψ_Dt (h_loc j))) := by
        have hexp : (ψ_W u) ^ (K_exp + M_exp) * (ψ_W u) ^ K_exp = (ψ_W u) ^ N₀ := by
          dsimp [N₀]
          rw [← pow_add]
          congr 1
          omega
        rw [mul_add, Finset.mul_sum, Finset.mul_sum]
        congr 1
        · refine Finset.sum_congr rfl fun i _ => ?_
          dsimp [α_out, f_out]
          rw [← hexp]
          ring
        · refine Finset.sum_congr rfl fun j _ => ?_
          dsimp [γ_out, h_out]
          rw [← hexp]
          ring
      rw [hcalc, hsum_F, mul_one]
    · have h_all₀ : ∀ (i : Fin r₀) (μ : Fin (d₀ + 1)),
          (f_out i) ^ n₀ * (ψ_W u) ^ N₀ * ψ₀ (sec₀ μ) ∈ ψ_W.range := by
        intro i μ
        have h_m : (ψ_W u) ^ M_exp * ((ψ_Dt (f_loc i)) ^ n₀ * ψ₀ (sec₀ μ)) ∈ ψ_W.range :=
          hm₀ (i, μ) M_exp (le_trans (Finset.le_sup (Finset.mem_univ (i, μ))) le_sup_left)
        have h_ident : (f_out i) ^ n₀ * (ψ_W u) ^ N₀ * ψ₀ (sec₀ μ) =
            (ψ_W u) ^ (n₀ * K_exp + 2 * K_exp) *
              ((ψ_W u) ^ M_exp * ((ψ_Dt (f_loc i)) ^ n₀ * ψ₀ (sec₀ μ))) := by
          dsimp [f_out, N₀]
          rw [mul_pow, ← pow_mul, pow_add]
          ring
        rw [h_ident]
        exact mul_mem (pow_mem hu_mem_W _) h_m
      intro i
      exact ⟨h_all₀ i 0, fun μ => h_all₀ i μ.succ⟩
    · have h_all₁ : ∀ (j : Fin r₁) (ν : Fin (d₁ + 1)),
          (h_out j) ^ n₁ * (ψ_W u) ^ N₀ * ψ₁ (sec₁ ν) ∈ ψ_W.range := by
        intro j ν
        have h_m : (ψ_W u) ^ M_exp * ((ψ_Dt (h_loc j)) ^ n₁ * ψ₁ (sec₁ ν)) ∈ ψ_W.range :=
          hm₁ (j, ν) M_exp (le_trans (Finset.le_sup (Finset.mem_univ (j, ν))) le_sup_right)
        have h_ident : (h_out j) ^ n₁ * (ψ_W u) ^ N₀ * ψ₁ (sec₁ ν) =
            (ψ_W u) ^ (n₁ * K_exp + 2 * K_exp) *
              ((ψ_W u) ^ M_exp * ((ψ_Dt (h_loc j)) ^ n₁ * ψ₁ (sec₁ ν))) := by
          dsimp [h_out, N₀]
          rw [mul_pow, ← pow_mul, pow_add]
          ring
        rw [h_ident]
        exact mul_mem (pow_mem hu_mem_W _) h_m
      intro j
      exact ⟨h_all₁ j 0, fun ν => h_all₁ j ν.succ⟩
  
  · let W' : Fin (N + 1) → C_semi.Opens := fun a => Finset.inf {a} W
    have hSupW' : (⨆ a : Fin (N + 1), W' a) = ⊤ := by
      simp_rw [W', Finset.inf_singleton]
      exact hSupW
    let hAffW' : ∀ a : Fin (N + 1), IsAffineOpen (W' a) :=
      fun a => (hCovAff {a} (Finset.singleton_nonempty a)).2.choose
    let ψ_W' : ∀ a : Fin (N + 1), ↑(C_semi.presheaf.obj (Opposite.op (W' a))) →+* F :=
      fun a => (B {a}).subtype.comp (φ_cov {a} (Finset.singleton_nonempty a)).toRingHom
    have hψ_W' : ∀ a : Fin (N + 1),
        Spec.map (CommRingCat.ofHom (ψ_W' a)) ≫ (hAffW' a).fromSpec = η_semi :=
      fun a => (hCovAff {a} (Finset.singleton_nonempty a)).2.choose_spec
    have hPOU_chart : ∀ (V_ε : C_tilde.Opens) (hAff_ε : IsAffineOpen V_ε)
        (ψ_ε : ↑(C_tilde.presheaf.obj (Opposite.op V_ε)) →+* F),
        Spec.map (CommRingCat.ofHom ψ_ε) ≫ hAff_ε.fromSpec = η_tilde →
        ∃ (s : ℕ) (a_idx : Fin s → Fin (N + 1)) (f α : Fin s → F),
          (∀ j : Fin s, f j ∈ ψ_ε.range ∧ α j ∈ ψ_ε.range) ∧
          (∑ j : Fin s, α j * f j) = 1 ∧
          ∀ (j : Fin s), ∀ b ∈ B {a_idx j}, ∃ n : ℕ, (f j) ^ n * b ∈ ψ_ε.range := by
      intro V_ε hAff_ε ψ_ε hψ_ε
      let A_ε := ↑(C_tilde.presheaf.obj (Opposite.op V_ε))
      let S_cov : Set A_ε := {g | ∃ a : Fin (N + 1), C_tilde.basicOpen g ≤ (q ⁻¹ᵁ W' a) ⊓ V_ε}
      have hSup_basic : (⨆ g : ↥S_cov, C_tilde.basicOpen g.1) = V_ε := by
        apply le_antisymm
        · exact iSup_le fun g => C_tilde.basicOpen_le g.1
        · intro x hx
          rw [TopologicalSpace.Opens.mem_iSup]
          have hqx : q.base x ∈ (⊤ : C_semi.Opens) := trivial
          rw [← hSupW', TopologicalSpace.Opens.mem_iSup] at hqx
          obtain ⟨a, hxa⟩ := hqx
          obtain ⟨g, hg_le, hxg⟩ :=
            hAff_ε.exists_basicOpen_le (⟨x, hxa, hx⟩ : ↥((q ⁻¹ᵁ W' a) ⊓ V_ε)) hx
          exact ⟨⟨g, a, hg_le⟩, hxg⟩
      have hSpan_top : Ideal.span S_cov = (⊤ : Ideal A_ε) :=
        (hAff_ε.iSup_basicOpen_eq_self_iff).mp hSup_basic
      have h1_mem : (1 : A_ε) ∈ Ideal.span S_cov := by
        rw [hSpan_top]
        exact Submodule.mem_top
      obtain ⟨c_fs, hc_sub, hc_sum⟩ := Submodule.mem_span_set.mp h1_mem
      let s := c_fs.support.card
      let e : Fin s ≃ ↥c_fs.support := c_fs.support.equivFin.symm
      let f_loc : Fin s → A_ε := fun j => (e j).1
      let α_loc : Fin s → A_ε := fun j => c_fs (f_loc j)
      let a_idx : Fin s → Fin (N + 1) := fun j => (hc_sub (e j).2).choose
      have ha_idx : ∀ j : Fin s, C_tilde.basicOpen (f_loc j) ≤ (q ⁻¹ᵁ W' (a_idx j)) ⊓ V_ε :=
        fun j => (hc_sub (e j).2).choose_spec
      let f_out : Fin s → F := fun j => ψ_ε (f_loc j)
      let α_out : Fin s → F := fun j => ψ_ε (α_loc j)
      refine ⟨s, a_idx, f_out, α_out, fun j => ⟨⟨f_loc j, rfl⟩, ⟨α_loc j, rfl⟩⟩, ?_, ?_⟩
      · have hsum_ε : (∑ j : Fin s, α_loc j * f_loc j) = 1 := by
          calc
            (∑ j : Fin s, α_loc j * f_loc j) = ∑ x : ↥c_fs.support, c_fs x.1 * x.1 :=
              Fintype.sum_equiv e _ _ (fun _ => rfl)
            _ = ∑ x ∈ c_fs.support, c_fs x * x :=
              Finset.sum_coe_sort c_fs.support (fun x => c_fs x * x)
            _ = c_fs.sum (fun x a => a • x) := rfl
            _ = 1 := hc_sum
        have hsum_F := congrArg ψ_ε hsum_ε
        rw [map_sum, map_one] at hsum_F
        simp_rw [map_mul] at hsum_F
        exact hsum_F
      · intro j b hb
        rw [← hrange_cov {a_idx j} (Finset.singleton_nonempty (a_idx j))] at hb
        obtain ⟨b_loc, rfl⟩ := hb
        by_cases hfj0 : f_out j = 0
        · refine ⟨1, ?_⟩
          simp [hfj0]
        · let Dj := C_tilde.basicOpen (f_loc j)
          have hAff_Dj : IsAffineOpen Dj := hAff_ε.basicOpen (f_loc j)
          have hpt_Dj : η_tilde.base ptF ∈ Dj :=
            eta_mem_basicOpen η_tilde hAff_ε ψ_ε hψ_ε (f_loc j) hfj0
          obtain ⟨ψ_Dj, _, hψ_Dj⟩ := hAffEmb_tilde Dj hAff_Dj ⟨⟨_, hpt_Dj⟩⟩
          have hDj_le : Dj ≤ q ⁻¹ᵁ W' (a_idx j) := le_trans (ha_idx j) inf_le_left
          let β := (q.appLE (W' (a_idx j)) Dj hDj_le).hom b_loc
          have hβ_F : ψ_Dj β = ψ_W' (a_idx j) b_loc :=
            compat_appLE q η_semi η_tilde hη_q (hAffW' (a_idx j)) (ψ_W' (a_idx j))
              (hψ_W' (a_idx j)) hAff_Dj ψ_Dj hψ_Dj hDj_le b_loc
          let algDj : Algebra A_ε ↑(C_tilde.presheaf.obj (Opposite.op Dj)) :=
            (C_tilde.presheaf.map (homOfLE (C_tilde.basicOpen_le (f_loc j))).op).hom.toAlgebra
          letI := algDj
          have hLoc_Dj : IsLocalization.Away (f_loc j) ↑(C_tilde.presheaf.obj (Opposite.op Dj)) :=
            hAff_ε.isLocalization_basicOpen (f_loc j)
          obtain ⟨n, r, hnr⟩ := @IsLocalization.Away.surj _ _ _ _ _ (f_loc j) hLoc_Dj β
          refine ⟨n, r, ?_⟩
          have hnr_F := congrArg ψ_Dj hnr
          rw [map_mul, map_pow, hβ_F] at hnr_F
          have hf_F : ψ_Dj (algebraMap A_ε _ (f_loc j)) = f_out j :=
            compat_res η_tilde hAff_ε ψ_ε hψ_ε hAff_Dj ψ_Dj hψ_Dj
              (C_tilde.basicOpen_le (f_loc j)) (f_loc j)
          have hr_F : ψ_Dj (algebraMap A_ε _ r) = ψ_ε r :=
            compat_res η_tilde hAff_ε ψ_ε hψ_ε hAff_Dj ψ_Dj hψ_Dj
              (C_tilde.basicOpen_le (f_loc j)) r
          rw [hf_F, hr_F] at hnr_F
          rw [← hnr_F, mul_comm]
    rintro R_ε (rfl | rfl | rfl)
    · exact hPOU_chart V_tilde₀ hAffV0 ψ₀ hψ₀
    · exact hPOU_chart V_tilde₁ hAffV1 ψ₁ hψ₁
    · rw [hCl₀]
      exact hPOU_chart (V_tilde₀ ⊓ V_tilde₁) hAff₀₁ ψ₀₁ hψ₀₁

theorem weil_noetherian_localSubring_etale_cover_descent_and_monic_flatness (K : Type u) [Field K] (V : ValuationSubring K)
    (F : Type u) [Field F] (φ_VF : ↥V →+* F)
    (N : ℕ) (B : Finset (Fin (N + 1)) → Subring F)
    (r_a : Fin (N + 1) → ℕ)
    (P_a : ∀ a : Fin (N + 1), Fin (r_a a) → Ideal ↥V)
    (ρ_a : ∀ (a : Fin (N + 1)) (j : Fin (r_a a)), ↥(B {a}) →+* (↥V ⧸ P_a a j))
    (hEtCov : IsEtaleSubringCoverOverValuation V F φ_VF N B r_a P_a ρ_a) :
    ∃ (g_a : Fin (N + 1) → F)
      (Y_a : Fin (N + 1) → Finset F)
      (c_aj : ∀ (a : Fin (N + 1)), Fin (r_a a) → ↥(Y_a a) → ↥V),
      (∀ a : Fin (N + 1),
        ∃ hg : g_a a ∈ B {a},
          g_a a ≠ 0 ∧
          (∀ j : Fin (r_a a), ρ_a a j ⟨g_a a, hg⟩ = 0) ∧
          (∀ y : ↥(Y_a a), ∃ hy : (y : F) ∈ B {a},
            ∀ j : Fin (r_a a), ρ_a a j ⟨(y : F), hy⟩ = Ideal.Quotient.mk (P_a a j) (c_aj a j y))) ∧
      (∀ (S_V : Finset ↥V) (S_F : Finset F),
        ∃ (R_β : Subring ↥V) (B_β : Finset (Fin (N + 1)) → Subring F),
          IsNoetherianRing ↥R_β ∧
          IsLocalRing ↥R_β ∧
          IsLocalHom R_β.subtype ∧
          (∀ v ∈ S_V, v ∈ R_β) ∧
          (∀ (S S' : Finset (Fin (N + 1))), S.Nonempty → S ⊆ S' → B_β S ≤ B_β S') ∧
          (∀ (S : Finset (Fin (N + 1))), S.Nonempty →
            (∀ z ∈ S_F, z ∈ B S → z ∈ B_β S) ∧
            B_β S = Subring.closure (⋃ a ∈ S, (B_β {a} : Set F)) ∧
            ∃ (hR : ∀ r : ↥R_β, φ_VF (R_β.subtype r) ∈ B_β S)
              (hV : ∀ v : ↥V, φ_VF v ∈ B S)
              (hle : B_β S ≤ B S),
              let φ_R : ↥R_β →+* ↥(B_β S) := (φ_VF.comp R_β.subtype).codRestrict (B_β S) hR
              let φ_RB : ↥R_β →+* ↥(B S) :=
                (φ_VF.comp R_β.subtype).codRestrict (B S) (fun r => hV (R_β.subtype r))
              letI : Algebra ↥R_β ↥(B_β S) := φ_R.toAlgebra
              letI : Algebra ↥R_β ↥(B S) := φ_RB.toAlgebra
              let f₁ : ↥(B_β S) →ₐ[↥R_β] ↥(B S) :=
                { toRingHom := Subring.inclusion hle, commutes' := fun _ => Subtype.ext rfl }
              let f₂ : ↥V →ₐ[↥R_β] ↥(B S) :=
                { toRingHom := φ_VF.codRestrict (B S) hV, commutes' := fun _ => Subtype.ext rfl }
              Module.Flat ↥R_β ↥(B_β S) ∧
              Function.Bijective (Algebra.TensorProduct.productMap f₁ f₂)) ∧
          (∀ a : Fin (N + 1),
            g_a a ∈ B_β {a} ∧
            (∀ y ∈ Y_a a, y ∈ B_β {a}) ∧
            B_β {a} = Subring.closure (Set.range (φ_VF ∘ R_β.subtype) ∪ (Y_a a : Set F)) ∧
            (∀ x ∈ B {a}, ∀ r : ℕ, (g_a a) ^ r * x ∈ B_β {a} → x ∈ B_β {a}))) :=
by
  have hs1 : ∀ (V₀ : Type u) [CommRing V₀] [Nontrivial V₀]
      (B₀ : Type u) [CommRing B₀]
      (r : ℕ) (P : Fin r → Ideal V₀)
      (ρ : ∀ j : Fin r, B₀ →+* (V₀ ⧸ P j))
      (φ_VB : V₀ →+* B₀),
      (∀ (j : Fin r) (v : V₀), ρ j (φ_VB v) = Ideal.Quotient.mk (P j) v) →
      ((∃ θ : Polynomial V₀ →+* B₀,
          Function.Injective θ ∧ θ.Etale ∧ ∀ v : V₀, θ (Polynomial.C v) = φ_VB v) ∨
       (∃ (α : V₀) (θ : (MvPolynomial (Fin 2) V₀ ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C α}) →+* B₀),
          α ≠ 0 ∧ Function.Injective θ ∧ θ.Etale ∧
          ∀ v : V₀, θ (Ideal.Quotient.mk _ (MvPolynomial.C v)) = φ_VB v)) →
      ∃ (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra V₀ A₀)
        (θ₀ : A₀ →+* B₀) (X₀ : Finset A₀) (g₀ : A₀),
        Function.Injective θ₀ ∧
        θ₀.Etale ∧
        (∀ v : V₀, θ₀ (algebraMap V₀ A₀ v) = φ_VB v) ∧
        Algebra.adjoin V₀ (X₀ : Set A₀) = ⊤ ∧
        g₀ ≠ 0 ∧
        (∀ j : Fin r, ρ j (θ₀ g₀) = 0) ∧
        (∀ S_A : Finset A₀, ∃ S_V₀ : Finset V₀,
          ∀ R : Subring V₀, (∀ v ∈ S_V₀, v ∈ R) →
            ∃ (A_R : Type u) (_ : CommRing A_R) (_ : Algebra ↥R A_R)
              (ι_R : A_R →+* A₀) (X_R : Finset A_R) (g_R : A_R),
              Function.Injective ι_R ∧
              (∀ c ∈ S_A, c ∈ Set.range ι_R) ∧
              ι_R '' (X_R : Set A_R) = (X₀ : Set A₀) ∧
              Algebra.adjoin ↥R (X_R : Set A_R) = ⊤ ∧
              ι_R g_R = g₀ ∧
              Module.Flat ↥R A_R ∧
              Module.Flat ↥R (A_R ⧸ Ideal.span {g_R}) ∧
              ∃ h_comm : ∀ r₀ : ↥R, ι_R (algebraMap ↥R A_R r₀) = algebraMap V₀ A₀ (R.subtype r₀),
