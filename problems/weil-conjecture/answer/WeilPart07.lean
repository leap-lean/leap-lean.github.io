          have heq : (t₀ ^ (m₁_β ν) * gen₁ ν) * s₁ ^ (m₁_β ν) = gen₁ ν := by
            calc
              (t₀ ^ (m₁_β ν) * gen₁ ν) * s₁ ^ (m₁_β ν) = gen₁ ν * (t₀ * s₁) ^ (m₁_β ν) := by
                rw [mul_pow]; ring
