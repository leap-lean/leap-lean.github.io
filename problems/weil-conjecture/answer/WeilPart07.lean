      choose z₀ hz₀ z₁ hz₁ hz_eq using fun I : Simp (p + 1) => hOverlap _ (hcard I) _ (hγ I)
      let γ₀ : Simp (p + 1) → F := fun I => z₀ I / (t_loc (I.1 0)) ^ k
      let γ₁ : Simp (p + 1) → F := fun I => z₁ I / (t_loc (I.1 0)) ^ k
      refine ⟨γ₀, γ₁, ?_, ?_, ?_⟩
      · intro I; dsimp only [γ₀]; rw [mul_div_cancel₀ _ (pow_ne_zero k (ht_ne (I.1 0)))]; exact hz₀ I
      · intro I; dsimp only [γ₁]; rw [mul_div_cancel₀ _ (pow_ne_zero k (ht_ne (I.1 0)))]; exact hz₁ I
      · intro I
        dsimp only [γ₀, γ₁]
        rw [← sub_div, ← hz_eq I, mul_div_cancel_left₀ _ (pow_ne_zero k (ht_ne (I.1 0)))]
