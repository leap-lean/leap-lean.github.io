          have hρX : ρ (MvPolynomial.X (ι_X d)) = G_bar d := by
            change (MvPolynomial.aeval ρ_fun) (MvPolynomial.X (ι_X d)) = _
            rw [MvPolynomial.aeval_X]
            simp [ρ_fun, ι_X]
          rw [hρX]
          symm
          apply Ideal.Quotient.eq.mpr
          have hQ_bard : Q_bar (Fin.natAdd r d) = MvPolynomial.X (ι_X d) - MvPolynomial.rename ι_Y (G_bar d) := by
