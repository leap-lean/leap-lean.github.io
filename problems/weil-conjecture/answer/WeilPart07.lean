  have hPigeonPow : ∀ {ι_p : Type} [DecidableEq ι_p] (A : Subring F) (I : Finset ι_p)
      (s : ι_p → F) (_ : ∀ i ∈ I, s i ∈ A) (L : ℕ),
      ∃ c : ι_p → F, (∀ i ∈ I, c i ∈ A) ∧
        (∑ i ∈ I, s i) ^ (I.card * L + 1) = ∑ i ∈ I, c i * (s i) ^ (L + 1) := by
    intro ι_p _ A I s hs L
    have hnatA : ∀ n : ℕ, (n : F) ∈ A := fun n => by
      induction n with
      | zero => simp
      | succ k ihk => rw [Nat.cast_succ]; exact A.add_mem ihk A.one_mem
    induction I using Finset.induction_on with
    | empty =>
      refine ⟨fun _ => 0, by simp, ?_⟩
      simp
    | @insert a I ha ih =>
      have hsa : s a ∈ A := hs a (Finset.mem_insert_self a I)
      have hsI : ∀ i ∈ I, s i ∈ A := fun i hi => hs i (Finset.mem_insert_of_mem hi)
      obtain ⟨c', hc'A, hc'Eq⟩ := ih hsI
      let S' : F := ∑ i ∈ I, s i
      have hS'A : S' ∈ A := A.sum_mem hsI
      let K₀ : ℕ := I.card * L + 1
      let E : ℕ := (I.card + 1) * L + 1
      have hE_eq : E = L + K₀ := by dsimp [E, K₀]; ring
      let R_rng : Finset ℕ := Finset.range (E + 1)
      let hi_set : Finset ℕ := R_rng.filter (fun m => L + 1 ≤ m)
      let lo_set : Finset ℕ := R_rng.filter (fun m => ¬ (L + 1 ≤ m))
      let term_m : ℕ → F := fun m => (s a) ^ m * S' ^ (E - m) * (E.choose m : F)
      have hexp : (s a + S') ^ E = ∑ m ∈ hi_set, term_m m + ∑ m ∈ lo_set, term_m m := by
        rw [add_pow]
        exact (Finset.sum_filter_add_sum_filter_not R_rng (fun m => L + 1 ≤ m) term_m).symm
      let c_a : F := ∑ m ∈ hi_set, (s a) ^ (m - (L + 1)) * S' ^ (E - m) * (E.choose m : F)
      have hc_a_mem : c_a ∈ A :=
        A.sum_mem fun m _ => A.mul_mem (A.mul_mem (A.pow_mem hsa _) (A.pow_mem hS'A _)) (hnatA _)
      have hhi_sum : ∑ m ∈ hi_set, term_m m = c_a * (s a) ^ (L + 1) := by
        dsimp [c_a, term_m]
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun m hm => ?_
        have hm_le : L + 1 ≤ m := (Finset.mem_filter.mp hm).2
        have hm_split : m = (m - (L + 1)) + (L + 1) := by omega
        calc
          (s a) ^ m * S' ^ (E - m) * (E.choose m : F)
              = ((s a) ^ (m - (L + 1)) * (s a) ^ (L + 1)) * S' ^ (E - m) * (E.choose m : F) := by
                rw [← pow_add, ← hm_split]
          _ = (s a) ^ (m - (L + 1)) * S' ^ (E - m) * (E.choose m : F) * (s a) ^ (L + 1) := by
                ring
      let B_fac : F := ∑ m ∈ lo_set, (s a) ^ m * S' ^ (L - m) * (E.choose m : F)
      have hB_mem : B_fac ∈ A :=
        A.sum_mem fun m _ => A.mul_mem (A.mul_mem (A.pow_mem hsa _) (A.pow_mem hS'A _)) (hnatA _)
      have hlo_sum : ∑ m ∈ lo_set, term_m m = ∑ i ∈ I, (B_fac * c' i) * (s i) ^ (L + 1) := by
        have h1 : ∑ m ∈ lo_set, term_m m = B_fac * S' ^ K₀ := by
          dsimp [B_fac, term_m]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun m hm => ?_
          have hm_lt : ¬ (L + 1 ≤ m) := (Finset.mem_filter.mp hm).2
          have hsub : E - m = (L - m) + K₀ := by rw [hE_eq]; omega
          rw [hsub, pow_add]
          ring
        rw [h1, hc'Eq, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
      let c_fn : ι_p → F := fun x => if x = a then c_a else B_fac * c' x
      refine ⟨c_fn, ?_, ?_⟩
      · intro x hx
        dsimp only [c_fn]
        rcases Finset.mem_insert.mp hx with rfl | hxI
        · simp [hc_a_mem]
        · split_ifs
          · exact hc_a_mem
          · exact A.mul_mem hB_mem (hc'A x hxI)
      · rw [Finset.card_insert_of_notMem ha, Finset.sum_insert ha]
        change (s a + S') ^ E = ∑ x ∈ insert a I, c_fn x * (s x) ^ (L + 1)
        rw [hexp, hhi_sum, hlo_sum, Finset.sum_insert ha]
        have hca_eq : c_fn a = c_a := by simp [c_fn]
        rw [hca_eq]
        congr 1
        refine Finset.sum_congr rfl fun i hi => ?_
        have hne : i ≠ a := fun h => ha (h ▸ hi)
        have hci_eq : c_fn i = B_fac * c' i := by simp [c_fn, hne]
        rw [hci_eq]

  have hTwoChartClear : ∀ (A : Subring F) (w₀ : F), w₀ ∈ A →
