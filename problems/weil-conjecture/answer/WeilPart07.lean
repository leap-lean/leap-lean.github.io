      simp only [ha, ↓reduceDIte]
      let hEx := hInsert (q + 1) K.1 K.2 ha
      let g' := Classical.choose hEx
      let hEx1 := Classical.choose_spec hEx
      let hg' := Classical.choose hEx1
      let hEx2 := Classical.choose_spec hEx1
      let p := Classical.choose hEx2
      let hp := Classical.choose_spec hEx2
      change (-1 : ℤ) ^ (p : ℕ) •
        (Y.presheaf.map (CategoryTheory.homOfLE (hInf_le hp.1 hp.2)).op).hom (α ⟨g', hg'⟩) = _
      obtain ⟨hI_eq, hp_eq⟩ := hUnique (q + 1) K.1 K.2 ⟨g', hg'⟩ I' p p' hp.1 hp.2 hp' hcomp'
      rw [hp_eq, hα_res_eq hI_eq (hInf_le hp.1 hp.2) hle']
    have hSign : ∀ (p₀ : Fin (q + 3)) (r : Fin (q + 2)),
        (-1 : ℤ) ^ (r : ℕ) * (-1 : ℤ) ^ (r.predAbove p₀ : ℕ) =
        - ((-1 : ℤ) ^ (p₀ : ℕ) * (-1 : ℤ) ^ (p₀.succAbove r : ℕ)) := by
