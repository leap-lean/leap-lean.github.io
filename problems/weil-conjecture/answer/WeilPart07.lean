  have hψ₁_C : ∀ c : ↥V, ψ₁ (MvPolynomial.C c) = V₁.topIso.inv.hom (c_R₁ c) := by
    intro c
    simp [ψ₁]
  have hψ₁_X : ∀ a : Fin (N' + 1), ψ₁ (MvPolynomial.X a) = V₁.topIso.inv.hom (f a) := by
    intro a
    simp [ψ₁]
  have hψ₁ : Ideal.map ψ₁ (HomogeneousIdeal.irrelevant 𝒜_V).toIdeal = ⊤ := by
    apply hIrrel_crit
    refine Ideal.subset_span ⟨0, ?_⟩
    dsimp only
    rw [hψ₁_X 0, hf0, map_one]
  let φ₀ : U₀.toScheme ⟶ P_next.left :=
    AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ₁ hψ₁
  have hg₀ : φ₀ ≫ P_next.hom = U₀.ι ≫ g := by
    apply hSpec_comp
    intro c
    rw [hψ₁_C c, hAppTop_ι_g V₁ V₁ le_rfl c]
    congr 1
    have hid : C.presheaf.map (CategoryTheory.homOfLE (le_rfl : V₁ ≤ V₁)).op = 𝟙 _ :=
      (congrArg C.presheaf.map (Subsingleton.elim _ (𝟙 (Opposite.op V₁)))).trans
        (C.presheaf.map_id (Opposite.op V₁))
    rw [hid]
    rfl

  
  have hu_eZ0 : IsUnit (res_eZ eZ) := C.toRingedSpace.isUnit_res_basicOpen eZ
  have hu_eZm : IsUnit (res_eZ (eZ ^ m₀)) := by
    rw [map_pow]
    exact hu_eZ0.pow m₀
  let u_Z := hu_eZm.unit
  let g_Z : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op U₁)) :=
    fun a => res_eZ (f_Z a) * ↑(u_Z⁻¹)
  have hgZ_mul : ∀ a : Fin (N' + 1), g_Z a * res_eZ (eZ ^ m₀) = res_eZ (f_Z a) := by
    intro a
    dsimp [g_Z]
    have hval : res_eZ (eZ ^ m₀) = ↑u_Z := rfl
    rw [hval, mul_assoc, Units.inv_mul, mul_one]
  have hgZ0 : g_Z 0 = 1 := by
    apply hu_eZm.mul_right_cancel
    rw [hgZ_mul 0, hfZ0, one_mul]
  let ψ_Z : MvPolynomial (Fin (N' + 1)) ↥V →+* ↑(U₁.toScheme.presheaf.obj (Opposite.op ⊤)) :=
    U₁.topIso.inv.hom.comp (MvPolynomial.eval₂Hom (res_eZ.comp c_R₀) g_Z)
  have hψZ_C : ∀ c : ↥V, ψ_Z (MvPolynomial.C c) = U₁.topIso.inv.hom (res_eZ (c_R₀ c)) := by
    intro c
    simp [ψ_Z]
  have hψZ_X : ∀ a : Fin (N' + 1), ψ_Z (MvPolynomial.X a) = U₁.topIso.inv.hom (g_Z a) := by
    intro a
    simp [ψ_Z]
  have hψZ_X_mul : ∀ a : Fin (N' + 1),
      ψ_Z (MvPolynomial.X a) * U₁.topIso.inv.hom (res_eZ (eZ ^ m₀)) =
        U₁.topIso.inv.hom (res_eZ (f_Z a)) := by
    intro a
    rw [hψZ_X a, ← map_mul, hgZ_mul a]
  have hψ_Z : Ideal.map ψ_Z (HomogeneousIdeal.irrelevant 𝒜_V).toIdeal = ⊤ := by
    apply hIrrel_crit
    refine Ideal.subset_span ⟨0, ?_⟩
    dsimp only
    rw [hψZ_X 0, hgZ0, map_one]
  let φ₁ : U₁.toScheme ⟶ P_next.left :=
    AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ_Z hψ_Z
  have hg₁ : φ₁ ≫ P_next.hom = U₁.ι ≫ g := by
    apply hSpec_comp
    intro c
    rw [hψZ_C c, hAppTop_ι_g V₀ U₁ (C.basicOpen_le eZ) c]

  
  let ψ_Y : MvPolynomial (Fin (N' + 1)) ↥V →+* ↑(U₂.toScheme.presheaf.obj (Opposite.op ⊤)) :=
    U₂.topIso.inv.hom.comp (MvPolynomial.eval₂Hom (res_eY.comp c_R₀) (fun a => res_eY (f_Y a)))
  have hψY_C : ∀ c : ↥V, ψ_Y (MvPolynomial.C c) = U₂.topIso.inv.hom (res_eY (c_R₀ c)) := by
    intro c
    simp [ψ_Y]
  have hψY_X : ∀ a : Fin (N' + 1), ψ_Y (MvPolynomial.X a) = U₂.topIso.inv.hom (res_eY (f_Y a)) := by
    intro a
    simp [ψ_Y]
  have hψ_Y : Ideal.map ψ_Y (HomogeneousIdeal.irrelevant 𝒜_V).toIdeal = ⊤ := by
    apply hIrrel_crit
    rcases hr_u_ex with ⟨r_u, hr_u⟩
    rcases Ideal.mem_span_pair.mp hr_u with ⟨α, β, hαβ⟩
    let ρY := U₂.topIso.inv.hom.comp res_eY
    have hmem_span : ρY (eY ^ r_u) ∈
        Ideal.span (Set.range (fun a : Fin (N' + 1) => ψ_Y (MvPolynomial.X a))) := by
      rw [← hαβ, map_add, map_mul, map_mul]
      have h0_mem : ρY (f_Y 0) ∈
          Ideal.span (Set.range (fun a : Fin (N' + 1) => ψ_Y (MvPolynomial.X a))) :=
        Ideal.subset_span ⟨0, hψY_X 0⟩
      have h1_mem : ρY (f_Y (1 : Fin (N' + 1))) ∈
          Ideal.span (Set.range (fun a : Fin (N' + 1) => ψ_Y (MvPolynomial.X a))) :=
        Ideal.subset_span ⟨1, hψY_X 1⟩
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h0_mem) (Ideal.mul_mem_left _ _ h1_mem)
    have hu_eY : IsUnit (ρY (eY ^ r_u)) := by
      dsimp [ρY]
      rw [map_pow, map_pow]
      exact ((C.toRingedSpace.isUnit_res_basicOpen eY).map U₂.topIso.inv.hom).pow r_u
    exact (Ideal.eq_top_iff_one _).mp (Ideal.eq_top_of_isUnit_mem _ hmem_span hu_eY)
  let φ₂ : U₂.toScheme ⟶ P_next.left :=
    AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_V ψ_Y hψ_Y
  have hg₂ : φ₂ ≫ P_next.hom = U₂.ι ≫ g := by
    apply hSpec_comp
    intro c
    rw [hψY_C c, hAppTop_ι_g V₀ U₂ (C.basicOpen_le eY) c]

  
  have heZ_sup_eY : U₁ ⊔ U₂ = V₀ := by
    apply le_antisymm (sup_le (C.basicOpen_le eZ) (C.basicOpen_le eY))
    intro x hx
    rw [TopologicalSpace.Opens.mem_sup]
    by_contra hnot
    have hnZ : x ∉ C.basicOpen eZ := fun h => hnot (Or.inl h)
    have hnY : x ∉ C.basicOpen eY := fun h => hnot (Or.inr h)
    have hnZ' : ¬ IsUnit ((C.presheaf.germ V₀ x hx).hom eZ) :=
      fun hu => hnZ ((C.toRingedSpace.mem_basicOpen eZ x hx).mpr hu)
    have hnY' : ¬ IsUnit ((C.presheaf.germ V₀ x hx).hom eY) :=
      fun hu => hnY ((C.toRingedSpace.mem_basicOpen eY x hx).mpr hu)
    have hmZ' : (C.presheaf.germ V₀ x hx).hom eZ ∈ IsLocalRing.maximalIdeal _ := by
      by_contra h
      exact hnZ' (IsLocalRing.notMem_maximalIdeal.mp h)
    have hmY' : (C.presheaf.germ V₀ x hx).hom eY ∈ IsLocalRing.maximalIdeal _ := by
      by_contra h
      exact hnY' (IsLocalRing.notMem_maximalIdeal.mp h)
    have h1_mem := Ideal.add_mem _ hmZ' hmY'
    rw [← map_add, heZ_add_eY, map_one] at h1_mem
    exact Ideal.IsPrime.ne_top inferInstance (Ideal.eq_top_iff_one _ |>.mpr h1_mem)
  have hcov3 : U₀ ⊔ U₁ ⊔ U₂ = ⊤ := by
    rw [sup_assoc, heZ_sup_eY, sup_comm, hCovV₀₁]
  have h12 : U₁ ⊓ U₂ ≤ U₀ := by
    rcases Ideal.mem_span_singleton.mp heZ_mul_eY with ⟨w₀, hw₀⟩
    have hbo_mul : U₁ ⊓ U₂ = C.basicOpen h₀ ⊓ C.basicOpen w₀ := by
      dsimp [U₁, U₂]
      rw [← AlgebraicGeometry.Scheme.basicOpen_mul, hw₀, AlgebraicGeometry.Scheme.basicOpen_mul]
    rw [hbo_mul, hBasic_h₀]
    exact le_trans inf_le_left inf_le_right

  
  have hov01 : C.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀) ≫ φ₀ =
      C.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁) ≫ φ₁ := by
    let W₀₁ : C.Opens := U₀ ⊓ U₁
    have hW₀₁_V₀ : W₀₁ ≤ V₀ := le_trans inf_le_right (C.basicOpen_le eZ)
    have hW₀₁_01 : W₀₁ ≤ V₀ ⊓ V₁ := le_inf hW₀₁_V₀ inf_le_left
    let res_01_W : ↑(C.presheaf.obj (Opposite.op (V₀ ⊓ V₁))) →+* ↑(C.presheaf.obj (Opposite.op W₀₁)) :=
      (C.presheaf.map (CategoryTheory.homOfLE hW₀₁_01).op).hom
    let res_V₁_W : ↑(C.presheaf.obj (Opposite.op V₁)) →+* ↑(C.presheaf.obj (Opposite.op W₀₁)) :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀₁ ≤ V₁)).op).hom
    let res_U₁_W : ↑(C.presheaf.obj (Opposite.op U₁)) →+* ↑(C.presheaf.obj (Opposite.op W₀₁)) :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀₁ ≤ U₁)).op).hom
    let res_V₀_W : ↑(C.presheaf.obj (Opposite.op V₀)) →+* ↑(C.presheaf.obj (Opposite.op W₀₁)) :=
      (C.presheaf.map (CategoryTheory.homOfLE hW₀₁_V₀).op).hom
    have hcomp_01_V₀ : ∀ x : ↑(C.presheaf.obj (Opposite.op V₀)),
        res_01_W ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom x) =
        res_V₀_W x := by
      intro x
      change ((C.presheaf.map _ ≫ C.presheaf.map _).hom x) = _
      rw [← Functor.map_comp]
      rfl
    have hcomp_01_V₁ : ∀ x : ↑(C.presheaf.obj (Opposite.op V₁)),
        res_01_W ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom x) =
        res_V₁_W x := by
      intro x
      change ((C.presheaf.map _ ≫ C.presheaf.map _).hom x) = _
      rw [← Functor.map_comp]
      rfl
    have hcomp_U₁_V₀ : ∀ x : ↑(C.presheaf.obj (Opposite.op V₀)),
        res_U₁_W (res_eZ x) = res_V₀_W x := by
      intro x
      change ((C.presheaf.map _ ≫ C.presheaf.map _).hom x) = _
      rw [← Functor.map_comp]
      rfl
    have hu_h₀_W : IsUnit (res_V₀_W (h₀ ^ m₀)) := by
      rw [map_pow]
      refine IsUnit.pow m₀ (IsUnit.of_mul_eq_one (res_V₁_W t₀) ?_)
      rw [← hcomp_01_V₀, ← hcomp_01_V₁, ← map_mul, h_h₀_t₀, map_one]
    have hu_eZ_W : IsUnit (res_V₀_W (eZ ^ m₀)) := by
      rw [← hcomp_U₁_V₀]
      exact hu_eZm.map res_U₁_W
    apply hTwist_eq W₀₁.toScheme U₀.toScheme U₁.toScheme
      (C.homOfLE inf_le_left) (C.homOfLE inf_le_right) ψ₁ hψ₁ ψ_Z hψ_Z 1 isUnit_one
    · intro c
      rw [hψZ_C c, hψ₁_C c, hHomOfLE_topIso W₀₁ U₁ inf_le_right,
        hHomOfLE_topIso W₀₁ U₀ inf_le_left, hcomp_U₁_V₀]
      congr 1
      have hm₀_W : g.appLE ⊤ V₀ le_top ≫ C.presheaf.map (CategoryTheory.homOfLE hW₀₁_V₀).op =
          g.appLE ⊤ W₀₁ le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map g le_top (CategoryTheory.homOfLE hW₀₁_V₀).op
      have hm₁_W : g.appLE ⊤ V₁ le_top ≫ C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀₁ ≤ V₁)).op =
          g.appLE ⊤ W₀₁ le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map g le_top (CategoryTheory.homOfLE inf_le_left).op
      have heq_hom : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ g.appLE ⊤ V₀ le_top) ≫
          C.presheaf.map (CategoryTheory.homOfLE hW₀₁_V₀).op =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ g.appLE ⊤ V₁ le_top) ≫
            C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀₁ ≤ V₁)).op := by
        rw [Category.assoc, hm₀_W, Category.assoc, hm₁_W]
      exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp heq_hom) c
    · intro a
      rw [one_mul, hψZ_X a, hψ₁_X a, hHomOfLE_topIso W₀₁ U₁ inf_le_right,
        hHomOfLE_topIso W₀₁ U₀ inf_le_left]
      congr 1
      apply hu_eZ_W.mul_right_cancel
      have hlhs : res_U₁_W (g_Z a) * res_V₀_W (eZ ^ m₀) = res_V₀_W (f_Z a) := by
        rw [← hcomp_U₁_V₀, ← hcomp_U₁_V₀, ← map_mul, hgZ_mul a]
      rw [hlhs]
      apply hu_h₀_W.mul_right_cancel
      have hrhs := congrArg res_V₀_W (hfZ_eq a)
      rw [map_mul, map_mul] at hrhs
      have hfY_W := congrArg res_01_W (hfY_res a)
      rw [map_mul, hcomp_01_V₀, hcomp_01_V₀, hcomp_01_V₁] at hfY_W
      rw [hrhs, hfY_W]
      ring

  
  have hov02 : C.homOfLE (inf_le_left : U₀ ⊓ U₂ ≤ U₀) ≫ φ₀ =
      C.homOfLE (inf_le_right : U₀ ⊓ U₂ ≤ U₂) ≫ φ₂ := by
    let W₀₂ : C.Opens := U₀ ⊓ U₂
    have hW₀₂_V₀ : W₀₂ ≤ V₀ := le_trans inf_le_right (C.basicOpen_le eY)
    have hW₀₂_01 : W₀₂ ≤ V₀ ⊓ V₁ := le_inf hW₀₂_V₀ inf_le_left
    let res_01_W : ↑(C.presheaf.obj (Opposite.op (V₀ ⊓ V₁))) →+* ↑(C.presheaf.obj (Opposite.op W₀₂)) :=
      (C.presheaf.map (CategoryTheory.homOfLE hW₀₂_01).op).hom
    let res_V₁_W : ↑(C.presheaf.obj (Opposite.op V₁)) →+* ↑(C.presheaf.obj (Opposite.op W₀₂)) :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀₂ ≤ V₁)).op).hom
    let res_U₂_W : ↑(C.presheaf.obj (Opposite.op U₂)) →+* ↑(C.presheaf.obj (Opposite.op W₀₂)) :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀₂ ≤ U₂)).op).hom
    let res_V₀_W : ↑(C.presheaf.obj (Opposite.op V₀)) →+* ↑(C.presheaf.obj (Opposite.op W₀₂)) :=
      (C.presheaf.map (CategoryTheory.homOfLE hW₀₂_V₀).op).hom
    have hcomp_01_V₀ : ∀ x : ↑(C.presheaf.obj (Opposite.op V₀)),
        res_01_W ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom x) =
        res_V₀_W x := by
      intro x
      change ((C.presheaf.map _ ≫ C.presheaf.map _).hom x) = _
      rw [← Functor.map_comp]
      rfl
    have hcomp_01_V₁ : ∀ x : ↑(C.presheaf.obj (Opposite.op V₁)),
        res_01_W ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom x) =
        res_V₁_W x := by
      intro x
      change ((C.presheaf.map _ ≫ C.presheaf.map _).hom x) = _
      rw [← Functor.map_comp]
      rfl
    have hcomp_U₂_V₀ : ∀ x : ↑(C.presheaf.obj (Opposite.op V₀)),
        res_U₂_W (res_eY x) = res_V₀_W x := by
      intro x
      change ((C.presheaf.map _ ≫ C.presheaf.map _).hom x) = _
      rw [← Functor.map_comp]
      rfl
    let u₀₂ : ↑(W₀₂.toScheme.presheaf.obj (Opposite.op ⊤)) :=
      W₀₂.topIso.inv.hom (res_V₀_W (h₀ ^ m₀))
    have hu₀₂ : IsUnit u₀₂ := by
      dsimp [u₀₂]
      refine IsUnit.map W₀₂.topIso.inv.hom ?_
      rw [map_pow]
      refine IsUnit.pow m₀ (IsUnit.of_mul_eq_one (res_V₁_W t₀) ?_)
      rw [← hcomp_01_V₀, ← hcomp_01_V₁, ← map_mul, h_h₀_t₀, map_one]
    apply hTwist_eq W₀₂.toScheme U₀.toScheme U₂.toScheme
      (C.homOfLE inf_le_left) (C.homOfLE inf_le_right) ψ₁ hψ₁ ψ_Y hψ_Y u₀₂ hu₀₂
    · intro c
      rw [hψY_C c, hψ₁_C c, hHomOfLE_topIso W₀₂ U₂ inf_le_right,
        hHomOfLE_topIso W₀₂ U₀ inf_le_left, hcomp_U₂_V₀]
      congr 1
      have hm₀_W : g.appLE ⊤ V₀ le_top ≫ C.presheaf.map (CategoryTheory.homOfLE hW₀₂_V₀).op =
          g.appLE ⊤ W₀₂ le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map g le_top (CategoryTheory.homOfLE hW₀₂_V₀).op
      have hm₁_W : g.appLE ⊤ V₁ le_top ≫ C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀₂ ≤ V₁)).op =
          g.appLE ⊤ W₀₂ le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map g le_top (CategoryTheory.homOfLE inf_le_left).op
      have heq_hom : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ g.appLE ⊤ V₀ le_top) ≫
          C.presheaf.map (CategoryTheory.homOfLE hW₀₂_V₀).op =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ g.appLE ⊤ V₁ le_top) ≫
            C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀₂ ≤ V₁)).op := by
        rw [Category.assoc, hm₀_W, Category.assoc, hm₁_W]
      exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp heq_hom) c
    · intro a
      rw [hψY_X a, hψ₁_X a, hHomOfLE_topIso W₀₂ U₂ inf_le_right,
        hHomOfLE_topIso W₀₂ U₀ inf_le_left, hcomp_U₂_V₀]
      dsimp [u₀₂]
      rw [← map_mul]
      congr 1
      have hfY_W := congrArg res_01_W (hfY_res a)
      rw [map_mul, hcomp_01_V₀, hcomp_01_V₀, hcomp_01_V₁] at hfY_W
      exact hfY_W

  
  
  
  have h_s3 : ∃ (φ : C ⟶ P_next.left),
      φ ≫ P_next.hom = g ∧
      U₀.ι ≫ φ = φ₀ ∧
      U₁.ι ≫ φ = φ₁ ∧
      U₂.ι ≫ φ = φ₂ ∧
      AlgebraicGeometry.Surjective (AlgebraicGeometry.Scheme.Hom.toImage φ) ∧
      ∀ (D : P_next.left.Opens),
        AlgebraicGeometry.IsAffineOpen D →
        AlgebraicGeometry.IsAffineOpen
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.imageι φ).base).obj D) ∧
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.toImage φ).base).obj
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Hom.imageι φ).base).obj D) =
          (U₀.ι.opensFunctor).obj ((TopologicalSpace.Opens.map φ₀.base).obj D) ⊔
          (U₁.ι.opensFunctor).obj ((TopologicalSpace.Opens.map φ₁.base).obj D) ⊔
          (U₂.ι.opensFunctor).obj ((TopologicalSpace.Opens.map φ₂.base).obj D) := by
    have _ : AlgebraicGeometry.IsProper g := hPropG
    have _ : AlgebraicGeometry.IsProper P_next.hom := hProp_P
    have hov12 : C.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁) ≫ φ₁ =
        C.homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂) ≫ φ₂ := by
      calc C.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁) ≫ φ₁
        _ = (C.homOfLE (le_inf h12 inf_le_left : U₁ ⊓ U₂ ≤ U₀ ⊓ U₁) ≫
              C.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)) ≫ φ₁ := by
            rw [AlgebraicGeometry.Scheme.homOfLE_homOfLE]
        _ = C.homOfLE (le_inf h12 inf_le_left : U₁ ⊓ U₂ ≤ U₀ ⊓ U₁) ≫
              (C.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀) ≫ φ₀) := by
            rw [Category.assoc, ← hov01]
        _ = C.homOfLE h12 ≫ φ₀ := by
            rw [← Category.assoc, AlgebraicGeometry.Scheme.homOfLE_homOfLE]
        _ = C.homOfLE (le_inf h12 inf_le_right : U₁ ⊓ U₂ ≤ U₀ ⊓ U₂) ≫
              (C.homOfLE (inf_le_left : U₀ ⊓ U₂ ≤ U₀) ≫ φ₀) := by
            rw [← Category.assoc, AlgebraicGeometry.Scheme.homOfLE_homOfLE]
        _ = (C.homOfLE (le_inf h12 inf_le_right : U₁ ⊓ U₂ ≤ U₀ ⊓ U₂) ≫
              C.homOfLE (inf_le_right : U₀ ⊓ U₂ ≤ U₂)) ≫ φ₂ := by
            rw [hov02, Category.assoc]
