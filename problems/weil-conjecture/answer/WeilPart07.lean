          simp
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
        rw [← CategoryTheory.Category.assoc e_Y.inv.appTop, heY_id, CategoryTheory.Category.id_comp,
