          rw [mem_closure_iff]
          intro O hO hw₀_O
          have hO_open : IsOpen (φ_open.base '' O) := hφ_open_emb.isOpenMap O hO
          have hz₀_img : z₀ ∈ φ_open.base '' O := ⟨w₀, hw₀_O, rfl⟩
          obtain ⟨y', hy'_img, hy'_sing⟩ := (mem_closure_iff.mp hz₀_mem_cl) (φ_open.base '' O) hO_open hz₀_img
          rw [Set.mem_singleton_iff] at hy'_sing
