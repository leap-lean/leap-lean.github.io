        exact hxJ
      choose d hd_eq using hd
      refine ⟨π₀, ∑ x : ↥t, c_U.hom (d x) * w₀ x, hπ₀_mem, ?_⟩
      change s = c_U.hom π₀ * ∑ x : ↥t, c_U.hom (d x) * w₀ x
      rw [← hw₀, Finset.mul_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      change w₀ x * c_U.hom x.1 = c_U.hom π₀ * (c_U.hom (d x) * w₀ x)
      rw [hd_eq x, map_mul]
      ring
    · rintro ⟨π, w, hπ, rfl⟩
      exact Ideal.mul_mem_right w _ (Ideal.mem_map_of_mem c_U.hom hπ)

  
  have hEval : ∀ (i : Fin (r_pts + 1)) (U : C_semi.Opens)
      (h_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
        (TopologicalSpace.Opens.map (γ_div i).base).obj U)
      (h_top_Y : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
        (TopologicalSpace.Opens.map (σ_bar i).base).obj
          ((TopologicalSpace.Opens.map fst.base).obj U))
      (s : ↑(C_semi.presheaf.obj (Opposite.op U))),
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom).hom
        (((σ_bar i).appLE ((TopologicalSpace.Opens.map fst.base).obj U) ⊤ h_top_Y).hom
          ((fst.app U).hom s)) =
      algebraMap ↥V k₀
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom).hom
          (((γ_div i).appLE U ⊤ h_top).hom s)) := by
    intro i U h_top h_top_Y s
    have he_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤ γ_div i ⁻¹ᵁ U := h_top
    have he_top_Y : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
        σ_bar i ⁻¹ᵁ (fst ⁻¹ᵁ U) := h_top_Y
    have he_s₀ : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤ s₀ ⁻¹ᵁ ⊤ := le_top
    have h1 : fst.app U ≫ (σ_bar i).appLE (fst ⁻¹ᵁ U) ⊤ he_top_Y =
        (γ_div i).appLE U ⊤ he_top ≫ s₀.appTop := by
      have he_s₀' : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤ ⊤ := le_rfl
      have hid : (CategoryTheory.homOfLE he_s₀').op =
          𝟙 (Opposite.op (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens)) :=
        congrArg Quiver.Hom.op (Subsingleton.elim (CategoryTheory.homOfLE he_s₀') (𝟙 ⊤))
      have hid_map : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.map
          (CategoryTheory.homOfLE he_s₀').op = 𝟙 _ :=
        (congrArg (AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.map hid).trans
          ((AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.map_id _)
      have hs₀_top : s₀.appTop = s₀.appLE ⊤ ⊤ he_s₀ :=
        (CategoryTheory.Category.comp_id s₀.appTop).symm.trans
          (congrArg (s₀.appTop ≫ ·) hid_map.symm)
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE fst, hs₀_top,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE.congr_simp _ _ (hCompat i)]
    have h2 : (fst.app U ≫ (σ_bar i).appLE (fst ⁻¹ᵁ U) ⊤ he_top_Y) ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom =
        (γ_div i).appLE U ⊤ he_top ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom ≫
        CommRingCat.ofHom (algebraMap ↥V k₀) := by
      rw [h1, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap ↥V k₀))]
    exact congrArg (fun f => f.hom s) h2

  
  have hPart3 : ∀ i : Fin (r_pts + 1),
      Set.preimage fst.base (Set.range (γ_div i).base) = Set.range (σ_bar i).base := by
    intro i
    ext y
    constructor
    · rintro ⟨x, hx⟩
      have hSec_i : γ_div i ≫ g_semi = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) :=
        (hLift.1 i).1
      have hx_eq : x = s₀.base (snd.base y) := by
        calc
          x = (γ_div i ≫ g_semi).base x := by rw [hSec_i]; rfl
          _ = g_semi.base ((γ_div i).base x) := rfl
          _ = (fst ≫ g_semi).base y := by rw [hx]; rfl
          _ = (snd ≫ s₀).base y := by rw [CategoryTheory.Limits.pullback.condition]
          _ = s₀.base (snd.base y) := rfl
      refine ⟨snd.base y, hInj_fst ?_⟩
      calc
        fst.base ((σ_bar i).base (snd.base y))
          = (σ_bar i ≫ fst).base (snd.base y) := rfl
        _ = (s₀ ≫ γ_div i).base (snd.base y) := by rw [hCompat i]
        _ = (γ_div i).base (s₀.base (snd.base y)) := rfl
        _ = (γ_div i).base x := by rw [← hx_eq]
        _ = fst.base y := hx
    · rintro ⟨z, rfl⟩
      refine ⟨s₀.base z, ?_⟩
      calc
        (γ_div i).base (s₀.base z)
          = (s₀ ≫ γ_div i).base z := rfl
        _ = (σ_bar i ≫ fst).base z := by rw [← hCompat i]
        _ = fst.base ((σ_bar i).base z) := rfl

  
  have hPart4 : ∀ (i : Fin (r_pts + 1)) (U : C_semi.Opens)
      (h_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
        (TopologicalSpace.Opens.map (γ_div i).base).obj U)
      (h_top_Y : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
        (TopologicalSpace.Opens.map (σ_bar i).base).obj
          ((TopologicalSpace.Opens.map fst.base).obj U))
      (s : ↑(C_semi.presheaf.obj (Opposite.op U))),
      IsUnit (((σ_bar i).appLE ((TopologicalSpace.Opens.map fst.base).obj U) ⊤ h_top_Y).hom
        ((fst.app U).hom s)) →
      IsUnit ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom.hom
        (((γ_div i).appLE U ⊤ h_top).hom s)) := by
    intro i U h_top h_top_Y s hUnit
    let v : ↥V := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom).hom
      (((γ_div i).appLE U ⊤ h_top).hom s)
    have hUnit_k₀ : IsUnit (algebraMap ↥V k₀ v) := by
      have h := hUnit.map ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom).hom
      rwa [hEval i U h_top h_top_Y s] at h
    have hne : algebraMap ↥V k₀ v ≠ 0 := hUnit_k₀.ne_zero
    have hnot_mem : v ∉ 𝔪_V := by
      rw [← hKer_res, RingHom.mem_ker]
      exact hne
    exact IsLocalRing.notMem_maximalIdeal.mp hnot_mem

  
  have hPart5 : ∀ i : Fin (r_pts + 1),
      let W_Y_div := (TopologicalSpace.Opens.map fst.base).obj (W_div i)
      let t_Y_div := (fst.app (W_div i)).hom (t_div i)
      (Y.basicOpen t_Y_div : Set ↥Y) = (W_Y_div : Set ↥Y) \ Set.range (σ_bar i).base ∧
      (∀ j : Fin (r_pts + 1), i ≠ j →
        Disjoint (W_Y_div : Set ↥Y) (Set.range (σ_bar j).base)) ∧
      ∃ h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
          (TopologicalSpace.Opens.map (σ_bar i).base).obj W_Y_div,
        RingHom.ker (((σ_bar i).appLE W_Y_div ⊤ h_le).hom) = Ideal.span {t_Y_div} := by
    intro i
    dsimp only
    let W_Y_div : Y.Opens := (TopologicalSpace.Opens.map fst.base).obj (W_div i)
    let t_Y_div := (fst.app (W_div i)).hom (t_div i)
    obtain ⟨hSec_i, _hCl_i, hAff_Wi, _ht_ne_i, ⟨h_le_V, hKer_V⟩, hBasic_V⟩ := hLift.1 i
    have hBasic_Y : (Y.basicOpen t_Y_div : Set ↥Y) =
        (W_Y_div : Set ↥Y) \ Set.range (σ_bar i).base := by
      have hpre := congrArg (fun O : Y.Opens => (O : Set ↥Y))
        (AlgebraicGeometry.Scheme.preimage_basicOpen fst (t_div i)).symm
      change (Y.basicOpen t_Y_div : Set ↥Y) = fst.base ⁻¹' (C_semi.basicOpen (t_div i) : Set ↥C_semi) at hpre
      rw [hpre, hBasic_V, Set.preimage_sdiff, hPart3 i]
      rfl
    have hDisj_Y : ∀ j : Fin (r_pts + 1), i ≠ j →
        Disjoint (W_Y_div : Set ↥Y) (Set.range (σ_bar j).base) := by
      intro j hij
      rw [Set.disjoint_left]
      intro y hy hmem
      rw [← hPart3 j] at hmem
      exact Set.disjoint_left.mp (hLift.2.1 i j hij) hy hmem
    have h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
        (TopologicalSpace.Opens.map (σ_bar i).base).obj W_Y_div := by
      intro z _
      change (σ_bar i ≫ fst).base z ∈ W_div i
      rw [hCompat i]
      exact h_le_V (show s₀.base z ∈ (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) by trivial)
    refine ⟨hBasic_Y, hDisj_Y, h_le, ?_⟩
    apply le_antisymm
    · intro r_bar hr_bar
      rw [RingHom.mem_ker] at hr_bar
      obtain ⟨_, hSurj_Wi, hKer_Wi⟩ := hPart2 (W_div i) hAff_Wi
      obtain ⟨r, hr⟩ := hSurj_Wi r_bar
      let v_r : ↥V := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom).hom
        (((γ_div i).appLE (W_div i) ⊤ h_le_V).hom r)
      have hv_r_mem : v_r ∈ 𝔪_V := by
        rw [← hKer_res, RingHom.mem_ker]
        have hev := hEval i (W_div i) h_le_V h_le r
        rw [hr, hr_bar, map_zero] at hev
        exact hev.symm
      let c_vr : ↑(C_semi.presheaf.obj (Opposite.op (W_div i))) :=
        (g_semi.appTop ≫
          C_semi.presheaf.map (CategoryTheory.homOfLE (le_top : W_div i ≤ ⊤)).op).hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv.hom v_r)
      have hfst_cvr : (fst.app (W_div i)).hom c_vr = 0 :=
        (hKer_Wi c_vr).mpr ⟨v_r, 1, hv_r_mem, (mul_one c_vr).symm⟩
      have hγ_cvr : ((γ_div i).appLE (W_div i) ⊤ h_le_V).hom c_vr =
          ((γ_div i).appLE (W_div i) ⊤ h_le_V).hom r := by
        have he_w : W_div i ≤ g_semi ⁻¹ᵁ ⊤ := le_top
        have he_v : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
            γ_div i ⁻¹ᵁ W_div i := h_le_V
        have hcomp_id : (g_semi.appTop ≫
            C_semi.presheaf.map (CategoryTheory.homOfLE (le_top : W_div i ≤ ⊤)).op) ≫
            (γ_div i).appLE (W_div i) ⊤ he_v =
            𝟙 ((AlgebraicGeometry.Spec (CommRingCat.of ↥V)).presheaf.obj (Opposite.op ⊤)) := by
          have h1 : g_semi.appTop ≫
              C_semi.presheaf.map (CategoryTheory.homOfLE (le_top : W_div i ≤ ⊤)).op =
              g_semi.appLE ⊤ (W_div i) he_w := rfl
          rw [h1, AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
            AlgebraicGeometry.Scheme.Hom.appLE.congr_simp _ _ hSec_i]
          simp [AlgebraicGeometry.Scheme.Hom.appLE]
          convert ((AlgebraicGeometry.Spec (CommRingCat.of ↥V)).presheaf.map_id (Opposite.op ⊤))
        calc
          ((γ_div i).appLE (W_div i) ⊤ h_le_V).hom c_vr
            = (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
                ((g_semi.appTop ≫
                  C_semi.presheaf.map (CategoryTheory.homOfLE (le_top : W_div i ≤ ⊤)).op) ≫
                  (γ_div i).appLE (W_div i) ⊤ he_v)).hom) v_r := rfl
          _ = (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ 𝟙 _).hom) v_r := by
              rw [hcomp_id]
          _ = (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).hom ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv).hom)
                (((γ_div i).appLE (W_div i) ⊤ h_le_V).hom r) := by
              rw [CategoryTheory.Category.comp_id]; rfl
          _ = ((γ_div i).appLE (W_div i) ⊤ h_le_V).hom r := by
              rw [CategoryTheory.Iso.hom_inv_id]; rfl
      have hdiff_ker : r - c_vr ∈ RingHom.ker (((γ_div i).appLE (W_div i) ⊤ h_le_V).hom) := by
        rw [RingHom.mem_ker, map_sub, hγ_cvr, sub_self]
      rw [hKer_V, Ideal.mem_span_singleton] at hdiff_ker
      obtain ⟨u, hu⟩ := hdiff_ker
      have hr_eq : r = c_vr + t_div i * u := by linear_combination hu
      rw [Ideal.mem_span_singleton]
      refine ⟨(fst.app (W_div i)).hom u, ?_⟩
      rw [← hr, hr_eq, map_add, hfst_cvr, zero_add, map_mul]
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      have ht_ker : ((γ_div i).appLE (W_div i) ⊤ h_le_V).hom (t_div i) = 0 := by
        rw [← RingHom.mem_ker, hKer_V]
        exact Ideal.subset_span (Set.mem_singleton (t_div i))
      have hev := hEval i (W_div i) h_le_V h_le (t_div i)
      rw [ht_ker, map_zero, map_zero] at hev
      have hinv := congrArg (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv).hom) hev
      rw [map_zero] at hinv
      have hlhs : (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv).hom)
          (((σ_bar i).appLE W_Y_div ⊤ h_le).hom t_Y_div) = 0 := hinv
      rw [CategoryTheory.Iso.hom_inv_id] at hlhs
      exact hlhs

  exact ⟨hPart1, hPart2, hPart3, hPart4, hPart5⟩

theorem weil_closed_fiber_polar_laurent_and_tagged_trivialization (k₀ : Type u) [Field k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (hAffInter : ∀ U₁ U₂ : Y.Opens,
      AlgebraicGeometry.IsAffineOpen U₁ →
      AlgebraicGeometry.IsAffineOpen U₂ →
      AlgebraicGeometry.IsAffineOpen (U₁ ⊓ U₂))
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (r_pts k₁ : ℕ)
    (σ_bar : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y))
    (π_bar : Y ⟶ (weilProjectiveSpaceOver k₀ 1).left)
    (hPolar : IsClosedFiberPolarProjLineMap k₀ p_Y r_pts k₁ σ_bar π_bar)
    (hP1_cov :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsAffineOpen
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 0)) ∧
      AlgebraicGeometry.IsAffineOpen
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 1)) ∧
      AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 0) ⊔
        AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀) (MvPolynomial.X 1) = ⊤)
    (W_Y_div : Fin (r_pts + 1) → Y.Opens)
    (t_Y_div : ∀ i : Fin (r_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y_div i))))
    (hW_div_aff : ∀ i : Fin (r_pts + 1), AlgebraicGeometry.IsAffineOpen (W_Y_div i))
    (hDiv_Y : ∀ i : Fin (r_pts + 1),
      (Y.basicOpen (t_Y_div i) : Set ↥Y) = (W_Y_div i : Set ↥Y) \ Set.range (σ_bar i).base ∧
      (∀ j : Fin (r_pts + 1), i ≠ j →
        Disjoint (W_Y_div i : Set ↥Y) (Set.range (σ_bar j).base)) ∧
      ∃ h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
          (TopologicalSpace.Opens.map (σ_bar i).base).obj (W_Y_div i),
        RingHom.ker (((σ_bar i).appLE (W_Y_div i) ⊤ h_le).hom) = Ideal.span {t_Y_div i})
    (N : ℕ)
    (W_Y : Fin (N + 1) → Y.Opens)
    (tag : Fin (N + 1) → Option (Fin (r_pts + 1)))
    (t_Y_loc : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y a))))
    (u_Y_ab : ∀ a b : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y a ⊓ W_Y b))))
    (hTag_none : ∀ a : Fin (N + 1),
      tag a = none →
      Disjoint (W_Y a : Set ↥Y) (⋃ i : Fin (r_pts + 1), Set.range (σ_bar i).base) ∧
      t_Y_loc a = 1)
    (hTag_some : ∀ (a : Fin (N + 1)) (i : Fin (r_pts + 1)),
      tag a = some i →
      ∃ h_le : W_Y a ≤ W_Y_div i,
        t_Y_loc a = (Y.presheaf.map (CategoryTheory.homOfLE h_le).op).hom (t_Y_div i))
    (hu_mul : ∀ a b : Fin (N + 1),
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_Y a ⊓ W_Y b ≤ W_Y b)).op).hom
        (t_Y_loc b) * u_Y_ab a b =
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_Y a ⊓ W_Y b ≤ W_Y a)).op).hom
        (t_Y_loc a))
    (hu_same : ∀ (i : Fin (r_pts + 1)) (a b : Fin (N + 1)),
      tag a = some i → tag b = some i → u_Y_ab a b = 1) :
    ∃ (m₀ : ℕ)
      (U_Y0 U_Y1 : Y.Opens)
      (f_bar_0 : ↑(Y.presheaf.obj (Opposite.op U_Y0)))
      (s_bar_1 : ↑(Y.presheaf.obj (Opposite.op U_Y1)))
      (x_Y : ∀ a : Fin (N + 1), ↑(Y.presheaf.obj (Opposite.op (W_Y a)))),
      1 ≤ m₀ * k₁ ∧
      (U_Y0 ⊔ U_Y1 = ⊤ ∧
        AlgebraicGeometry.IsAffineOpen U_Y0 ∧
        AlgebraicGeometry.IsAffineOpen U_Y1 ∧
        Y.basicOpen f_bar_0 = U_Y0 ⊓ U_Y1 ∧
        Y.basicOpen s_bar_1 = U_Y0 ⊓ U_Y1 ∧
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Y0 ⊓ U_Y1 ≤ U_Y0)).op).hom
          f_bar_0 *
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1)).op).hom
          s_bar_1 = 1) ∧
      (∀ h : ↑(Y.presheaf.obj (Opposite.op (U_Y0 ⊓ U_Y1))),
        ∃ (a₀ : ↑(Y.presheaf.obj (Opposite.op U_Y0)))
          (a₁ : ↑(Y.presheaf.obj (Opposite.op U_Y1))),
          h =
            ((Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1)).op).hom s_bar_1) ^ m₀ *
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_left : U_Y0 ⊓ U_Y1 ≤ U_Y0)).op).hom a₀ -
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1)).op).hom a₁) ∧
      (∀ a b : Fin (N + 1),
        (Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_right : W_Y a ⊓ W_Y b ≤ W_Y b)).op).hom (x_Y b) *
          (u_Y_ab a b) ^ (m₀ * k₁) =
        (Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : W_Y a ⊓ W_Y b ≤ W_Y a)).op).hom (x_Y a)) ∧
      (∀ (i : Fin (r_pts + 1)) (a : Fin (N + 1)),
        tag a = some i →
        ∀ h_top_Y : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
            (TopologicalSpace.Opens.map (σ_bar i).base).obj (W_Y a),
          IsUnit (((σ_bar i).appLE (W_Y a) ⊤ h_top_Y).hom (x_Y a))) ∧
      (∀ a : Fin (N + 1),
        IsUnit ((Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : W_Y a ⊓ U_Y0 ≤ W_Y a)).op).hom (t_Y_loc a)) ∧
        IsUnit ((Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : W_Y a ⊓ U_Y1 ≤ W_Y a)).op).hom (x_Y a)) ∧
        (Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : W_Y a ⊓ (U_Y0 ⊓ U_Y1) ≤ W_Y a)).op).hom (x_Y a) *
          ((Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right.trans inf_le_right : W_Y a ⊓ (U_Y0 ⊓ U_Y1) ≤ U_Y1)).op).hom
            s_bar_1) ^ m₀ =
        ((Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : W_Y a ⊓ (U_Y0 ⊓ U_Y1) ≤ W_Y a)).op).hom (t_Y_loc a)) ^ (m₀ * k₁)) :=
by
  let _ := hAffInter
  let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀
  let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
  let P1 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜₁
  let π_P1 : Y ⟶ P1 := π_bar
  let D₀ : P1.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X 0)
  let D₁ : P1.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X 1)
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1 :=
    MvPolynomial.isHomogeneous_X k₀ 0
  have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1 :=
    MvPolynomial.isHomogeneous_X k₀ 1
  have hX0_smul : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ (1 • 1) := by
    simpa only [one_smul] using hX0
  have hX1_smul : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ (1 • 1) := by
    simpa only [one_smul] using hX1
  let T_P1 : ↑(P1.presheaf.obj (Opposite.op D₀)) :=
    (AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 0)).hom
      (HomogeneousLocalization.Away.mk 𝒜₁ hX0 1 (MvPolynomial.X 1) hX1_smul)
  let S_P1 : ↑(P1.presheaf.obj (Opposite.op D₁)) :=
    (AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1)).hom
      (HomogeneousLocalization.Away.mk 𝒜₁ hX1 1 (MvPolynomial.X 0) hX0_smul)
  have hP1_comp : ∀ {V₁ V₂ V₃ : P1.Opens} (h₁ : V₂ ≤ V₁) (h₂ : V₃ ≤ V₂)
      (w : ↑(P1.presheaf.obj (Opposite.op V₁))),
      (P1.presheaf.map (CategoryTheory.homOfLE h₂).op).hom
        ((P1.presheaf.map (CategoryTheory.homOfLE h₁).op).hom w) =
      (P1.presheaf.map (CategoryTheory.homOfLE (h₂.trans h₁)).op).hom w := by
    intro V₁ V₂ V₃ h₁ h₂ w
    have hop : (CategoryTheory.homOfLE h₁).op ≫ (CategoryTheory.homOfLE h₂).op =
        (CategoryTheory.homOfLE (h₂.trans h₁)).op :=
      congrArg Quiver.Hom.op (Subsingleton.elim _ _)
    change (P1.presheaf.map (CategoryTheory.homOfLE h₁).op ≫
      P1.presheaf.map (CategoryTheory.homOfLE h₂).op).hom w = _
    rw [← CategoryTheory.Functor.map_comp, hop]
  have hY_map_comp : ∀ {V₁ V₂ V₃ : Y.Opens} (h₁ : V₂ ≤ V₁) (h₂ : V₃ ≤ V₂)
      (x : ↑(Y.presheaf.obj (Opposite.op V₁))),
      (Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom
        ((Y.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x) =
      (Y.presheaf.map (CategoryTheory.homOfLE (h₂.trans h₁)).op).hom x := by
    intro V₁ V₂ V₃ h₁ h₂ x
    have hop : (CategoryTheory.homOfLE h₁).op ≫ (CategoryTheory.homOfLE h₂).op =
        (CategoryTheory.homOfLE (h₂.trans h₁)).op :=
      congrArg Quiver.Hom.op (Subsingleton.elim _ _)
    change (Y.presheaf.map (CategoryTheory.homOfLE h₁).op ≫
