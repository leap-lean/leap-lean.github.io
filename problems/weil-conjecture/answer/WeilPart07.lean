          rw [hWz_aff.range_fromSpec]
          ext w
          simp only [Set.mem_range, AlgebraicGeometry.Scheme.Hom.comp_apply]
          constructor
          · rintro ⟨p, rfl⟩; exact ⟨R_z.isoSpec.inv.base p, rfl⟩
          · rintro ⟨p, rfl⟩
            refine ⟨R_z.isoSpec.hom.base p, ?_⟩
            change (R_z.isoSpec.hom ≫ R_z.isoSpec.inv ≫ k_z).base p = k_z.base p
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
