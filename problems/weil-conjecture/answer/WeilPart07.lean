        let v' : Fin (n (j + 2)) → F_mod := v - bdryM (j + 2) F_mod y
        have hv'_Z : ∀ i : Fin (n (j + 2)), v' i ∈ Z_sub := by
          intro i
          have h1 : δ_B (v' i) = 0 := by
            dsimp only [v', Pi.sub_apply]
            rw [map_sub]
            change δ_B (v i) - (δ_B ∘ bdryM (j + 2) F_mod y) i = 0
            rw [h_bdryM_nat (j + 2) δ_B y]
            have hy_eq : δ_B ∘ y = y_bar := funext hy
            rw [hy_eq, show bdryM (j + 2) ↥B_sub y_bar = δ_B ∘ v from hy_bar]
            exact sub_self _
          exact congrArg Subtype.val h1
