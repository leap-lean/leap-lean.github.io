import WeilPart06
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_strictlySemistable_closed_fiber_smooth_divisor_lift (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hHensel : HenselianLocalRing ↥V)
    (hHenselSec : ∀ (R A k₀ : Type u) [CommRing R] [HenselianLocalRing R]
      [CommRing A] [Algebra R A] [Algebra.Etale R A] [Field k₀]
      (π_R : R →+* k₀),
      Function.Surjective π_R →
      RingHom.ker π_R = IsLocalRing.maximalIdeal R →
      ∀ (ω : A →+* k₀), ω.comp (algebraMap R A) = π_R →
      ∃ h : A, ω h ≠ 0 ∧ Function.Bijective (algebraMap R (Localization.Away h)))
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_semi)
    (r_pts : ℕ)
    (σ_bar : Fin (r_pts + 1) →
      (AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥V).ResidueField) ⟶
        CategoryTheory.Limits.pullback g_semi
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (hSec_bar : ∀ i : Fin (r_pts + 1),
      σ_bar i ≫ CategoryTheory.Limits.pullback.snd g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))) =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥V).ResidueField)))
    (hInj_bar : Function.Injective (fun i : Fin (r_pts + 1) =>
      (σ_bar i).base (⊥ : PrimeSpectrum (IsLocalRing.maximalIdeal ↥V).ResidueField)))
    (hSm_bar : ∀ i : Fin (r_pts + 1),
      ∃ V_sm : (CategoryTheory.Limits.pullback g_semi
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))).Opens,
        (σ_bar i).base (⊥ : PrimeSpectrum (IsLocalRing.maximalIdeal ↥V).ResidueField) ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_semi
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))) :
    ∃ (γ_div : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
      (W_div : Fin (r_pts + 1) → C_semi.Opens)
      (t_div : ∀ i : Fin (r_pts + 1), ↑(C_semi.presheaf.obj (Opposite.op (W_div i))))
      (e_div : ∀ i : Fin (r_pts + 1),
        (W_div i).toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      (∀ i : Fin (r_pts + 1),
        σ_bar i ≫ CategoryTheory.Limits.pullback.fst g_semi
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)) ≫ γ_div i) ∧
      (∀ i : Fin (r_pts + 1),
        γ_div i ≫ g_semi = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) ∧
        AlgebraicGeometry.IsClosedImmersion (γ_div i) ∧
        AlgebraicGeometry.IsAffineOpen (W_div i) ∧
        AlgebraicGeometry.Etale (e_div i) ∧
        (W_div i).ι ≫ g_semi =
          e_div i ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        t_div i ≠ 0 ∧
        (∃ h_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) ≤
            (TopologicalSpace.Opens.map (γ_div i).base).obj (W_div i),
          RingHom.ker (((γ_div i).appLE (W_div i) ⊤ h_le).hom) = Ideal.span {t_div i}) ∧
        (C_semi.basicOpen (t_div i) : Set ↥C_semi) =
          (W_div i : Set ↥C_semi) \ Set.range (γ_div i).base) ∧
      (∀ i j : Fin (r_pts + 1), i ≠ j →
        Disjoint (W_div i : Set ↥C_semi) (Set.range (γ_div j).base)) :=
by
  have h_step1 : ∀ (R k₀ : Type u) [CommRing R] [Field k₀]
      (π_R : R →+* k₀)
      (C : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (W : C.Opens) (a : R)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) R ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
      AlgebraicGeometry.Etale e →
      W.ι ≫ g = e ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
      ∀ (σ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
          CategoryTheory.Limits.pullback g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R))),
        σ ≫ CategoryTheory.Limits.pullback.snd g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R)) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) →
        ∀ (V_sm : (CategoryTheory.Limits.pullback g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R))).Opens),
          σ.base (⊥ : PrimeSpectrum k₀) ∈ V_sm →
          AlgebraicGeometry.SmoothOfRelativeDimension 1
            (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R))) →
          ∀ (hxW : (CategoryTheory.Limits.pullback.fst g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R))).base
                (σ.base (⊥ : PrimeSpectrum k₀)) ∈ W),
            ∃ ε : Fin 2,
              Ideal.Quotient.mk
                (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
                (MvPolynomial.X ε) ∉
                (e.base ⟨(CategoryTheory.Limits.pullback.fst g
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R))).base
                    (σ.base (⊥ : PrimeSpectrum k₀)), hxW⟩).asIdeal := by
    clear hSm_bar hInj_bar hSec_bar σ_bar r_pts hSS g_semi C_semi hHenselSec hHensel V
    intro R k₀ _ _ π_R C g W a e he_et he_comm σ hSec V_sm hqV hSm hxW
    by_contra! h_both
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_R)
    let Y := CategoryTheory.Limits.pullback g s₀
    let fst₀ := CategoryTheory.Limits.pullback.fst g s₀
    let p_Y := CategoryTheory.Limits.pullback.snd g s₀
    let pt₀ : PrimeSpectrum k₀ := ⊥
    let q₀ : ↥Y := σ.base pt₀
    let x₀ : ↥C := fst₀.base q₀
    let I_a : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let A_R := MvPolynomial (Fin 2) R ⧸ I_a
    let mk_R : MvPolynomial (Fin 2) R →+* A_R := Ideal.Quotient.mk I_a
    let C_R : R →+* A_R := mk_R.comp MvPolynomial.C
    have h_prod_R : mk_R (MvPolynomial.X 0) * mk_R (MvPolynomial.X 1) = C_R a := by
      have h0 : mk_R (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, map_mul] at h0
      exact sub_eq_zero.mp h0
    have ha_mem_nod : C_R a ∈ (e.base ⟨x₀, hxW⟩).asIdeal := by
      rw [← h_prod_R]
      exact Ideal.mul_mem_right _ _ (h_both 0)
    have ha_mem_g : a ∈ (g.base x₀).asIdeal := by
      have h_pt : (W.ι ≫ g).base ⟨x₀, hxW⟩ =
          (e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_R)).base ⟨x₀, hxW⟩ := by
        rw [he_comm]
      have h_eq : g.base x₀ = PrimeSpectrum.comap C_R (e.base ⟨x₀, hxW⟩) := h_pt
      rw [h_eq]
      exact ha_mem_nod
    have hg_x₀ : g.base x₀ = s₀.base pt₀ := by
      have h1 : (σ ≫ fst₀ ≫ g).base pt₀ = (σ ≫ p_Y ≫ s₀).base pt₀ := by
        rw [CategoryTheory.Limits.pullback.condition]
      have h2 : (σ ≫ p_Y ≫ s₀).base pt₀ = s₀.base pt₀ := by
        rw [← CategoryTheory.Category.assoc, hSec, CategoryTheory.Category.id_comp]
      exact h1.trans h2
    have hπ_a : π_R a = 0 := by
      rw [hg_x₀] at ha_mem_g
      have h_in : π_R a ∈ pt₀.asIdeal := ha_mem_g
      by_contra hne
      exact pt₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h_in (IsUnit.mk0 _ hne))
    let I₀ : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let A_k₀ := MvPolynomial (Fin 2) k₀ ⧸ I₀
    let mk₀ : MvPolynomial (Fin 2) k₀ →+* A_k₀ := Ideal.Quotient.mk I₀
    let C_k₀ : k₀ →+* A_k₀ := mk₀.comp MvPolynomial.C
    have hΨ_ker : I_a ≤ RingHom.ker (mk₀.comp (MvPolynomial.map π_R)) := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        RingHom.comp_apply, map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X,
        MvPolynomial.map_C, hπ_a, MvPolynomial.C_0, sub_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    let Ψ : A_R →+* A_k₀ := Ideal.Quotient.lift I_a (mk₀.comp (MvPolynomial.map π_R)) hΨ_ker
    have hΨ_mk : ∀ p : MvPolynomial (Fin 2) R, Ψ (mk_R p) = mk₀ (MvPolynomial.map π_R p) :=
      fun _ => rfl
    have hΨ_comm : CommRingCat.ofHom C_R ≫ CommRingCat.ofHom Ψ =
        CommRingCat.ofHom π_R ≫ CommRingCat.ofHom C_k₀ := by
      ext r
      change Ψ (mk_R (MvPolynomial.C r)) = mk₀ (MvPolynomial.C (π_R r))
      rw [hΨ_mk, MvPolynomial.map_C]
    have hPush : CategoryTheory.IsPushout
        (CommRingCat.ofHom C_R) (CommRingCat.ofHom π_R)
        (CommRingCat.ofHom Ψ) (CommRingCat.ofHom C_k₀) := by
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hΨ_comm
          (fun s => CommRingCat.ofHom (Ideal.Quotient.lift I₀
            (MvPolynomial.eval₂Hom s.inr.hom (fun i => s.inl.hom (mk_R (MvPolynomial.X i))))
            (by
              intro p hp
              have h_le : I₀ ≤ RingHom.ker
                  (MvPolynomial.eval₂Hom s.inr.hom
                    (fun i => s.inl.hom (mk_R (MvPolynomial.X i)))) := by
                rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
                  map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', ← map_mul, h_prod_R]
                have h_w := congrArg (fun f => f.hom a) s.condition
                dsimp at h_w
                rw [h_w, hπ_a, map_zero]
              exact h_le hp)))
          (fun s => by
            apply CommRingCat.hom_ext
            apply Ideal.Quotient.ringHom_ext
            apply MvPolynomial.ringHom_ext
            · intro r
              have h_w := congrArg (fun f => f.hom r) s.condition
              dsimp [C_R] at h_w
              change (MvPolynomial.eval₂Hom s.inr.hom
                (fun i => s.inl.hom (mk_R (MvPolynomial.X i))))
                  (MvPolynomial.map π_R (MvPolynomial.C r)) = s.inl.hom (mk_R (MvPolynomial.C r))
              rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
              exact h_w.symm
            · intro i
              change (MvPolynomial.eval₂Hom s.inr.hom
                (fun i => s.inl.hom (mk_R (MvPolynomial.X i))))
                  (MvPolynomial.map π_R (MvPolynomial.X i)) = s.inl.hom (mk_R (MvPolynomial.X i))
              rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X'])
          (fun s => by
            ext c
            change (MvPolynomial.eval₂Hom s.inr.hom
              (fun i => s.inl.hom (mk_R (MvPolynomial.X i)))) (MvPolynomial.C c) = s.inr.hom c
            exact MvPolynomial.eval₂Hom_C _ _ c)
          (fun s m hm_l hm_r => by
            apply CommRingCat.hom_ext
            apply Ideal.Quotient.ringHom_ext
            apply MvPolynomial.ringHom_ext
            · intro c
              have h_r := congrArg (fun f => f.hom c) hm_r
              dsimp [C_k₀] at h_r
              change m.hom (mk₀ (MvPolynomial.C c)) =
                (MvPolynomial.eval₂Hom s.inr.hom
                  (fun i => s.inl.hom (mk_R (MvPolynomial.X i)))) (MvPolynomial.C c)
              rw [MvPolynomial.eval₂Hom_C]
              exact h_r
            · intro i
              have h_l := congrArg (fun f => f.hom (mk_R (MvPolynomial.X i))) hm_l
              dsimp at h_l
              rw [hΨ_mk, MvPolynomial.map_X] at h_l
              change m.hom (mk₀ (MvPolynomial.X i)) =
                (MvPolynomial.eval₂Hom s.inr.hom
                  (fun i => s.inl.hom (mk_R (MvPolynomial.X i)))) (MvPolynomial.X i)
              rw [MvPolynomial.eval₂Hom_X']
              exact h_l))
    have hPb_Spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_k₀))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_R))
        s₀ :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    let W_Y : Y.Opens := (TopologicalSpace.Opens.map fst₀.base).obj W
    have hqW : q₀ ∈ W_Y := hxW
    have hPb_W : CategoryTheory.IsPullback (fst₀ ∣_ W) (W_Y.ι ≫ p_Y)
        (e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_R)) s₀ := by
      have h1 := (AlgebraicGeometry.isPullback_morphismRestrict fst₀ W).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback g s₀)
      rwa [he_comm] at h1
    let e_Y : W_Y.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_k₀) :=
      hPb_Spec.lift ((fst₀ ∣_ W) ≫ e) (W_Y.ι ≫ p_Y) (by
        rw [CategoryTheory.Category.assoc]
        exact hPb_W.w)
    have heY_fst : e_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) = (fst₀ ∣_ W) ≫ e :=
      hPb_Spec.lift_fst _ _ _
    have heY_snd : e_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_k₀) = W_Y.ι ≫ p_Y :=
      hPb_Spec.lift_snd _ _ _
    have hPb_top : CategoryTheory.IsPullback (fst₀ ∣_ W) e_Y e
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ)) := by
      refine CategoryTheory.IsPullback.of_bot ?_ heY_fst.symm hPb_Spec
      rwa [heY_snd]
    have heY_et : AlgebraicGeometry.Etale e_Y :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top he_et
    have h_both_Y : ∀ ε : Fin 2, mk₀ (MvPolynomial.X ε) ∈ (e_Y.base ⟨q₀, hqW⟩).asIdeal := by
      intro ε
      have h_res_pt : (fst₀ ∣_ W).base ⟨q₀, hqW⟩ = ⟨x₀, hxW⟩ := by
        apply W.ι.isOpenEmbedding.injective
        exact congrArg (fun f => f.base ⟨q₀, hqW⟩)
          (AlgebraicGeometry.morphismRestrict_ι fst₀ W)
      have h_comap : PrimeSpectrum.comap Ψ (e_Y.base ⟨q₀, hqW⟩) = e.base ⟨x₀, hxW⟩ := by
        have h_c : (e_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ)).base ⟨q₀, hqW⟩ =
            ((fst₀ ∣_ W) ≫ e).base ⟨q₀, hqW⟩ :=
          congrArg (fun f => f.base ⟨q₀, hqW⟩) heY_fst
        have h_lhs : (e_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ)).base ⟨q₀, hqW⟩ =
            PrimeSpectrum.comap Ψ (e_Y.base ⟨q₀, hqW⟩) := rfl
        have h_rhs : ((fst₀ ∣_ W) ≫ e).base ⟨q₀, hqW⟩ = e.base ⟨x₀, hxW⟩ :=
          congrArg e.base h_res_pt
        exact h_lhs.symm.trans (h_c.trans h_rhs)
      have h_mem : Ψ (mk_R (MvPolynomial.X ε)) ∈ (e_Y.base ⟨q₀, hqW⟩).asIdeal := by
        change mk_R (MvPolynomial.X ε) ∈ (PrimeSpectrum.comap Ψ (e_Y.base ⟨q₀, hqW⟩)).asIdeal
        rw [h_comap]
        exact h_both ε
      rwa [hΨ_mk, MvPolynomial.map_X] at h_mem
    obtain ⟨U_Y, hUY, hqU, hUY_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q₀) (U := W_Y ⊓ V_sm) ⟨hqW, hqV⟩
    have hUY_W : U_Y ≤ W_Y := fun z hz => (hUY_sub hz).1
    have hUY_V : U_Y ≤ V_sm := fun z hz => (hUY_sub hz).2
    let C_Y := ↑(Y.presheaf.obj (Opposite.op U_Y))
    have hσ_range : Set.range σ.base ⊆ Set.range hUY.fromSpec.base := by
      rw [hUY.range_fromSpec]
      rintro _ ⟨pt, rfl⟩
      have hpt : pt = pt₀ := Subsingleton.elim pt pt₀
      rw [hpt]
      exact hqU
    let σ_U : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of C_Y) :=
      AlgebraicGeometry.IsOpenImmersion.lift hUY.fromSpec σ hσ_range
    have hσ_fac : σ_U ≫ hUY.fromSpec = σ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hUY.fromSpec σ hσ_range
    let χ_Y : C_Y →+* k₀ := (AlgebraicGeometry.Spec.preimage σ_U).hom
    have hσ_U_eq : σ_U = AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_Y) :=
      (AlgebraicGeometry.Spec.map_preimage σ_U).symm
    let e_UY : AlgebraicGeometry.Spec (CommRingCat.of C_Y) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_k₀) :=
      hUY.isoSpec.inv ≫ Y.homOfLE hUY_W ≫ e_Y
    have heUY_et : AlgebraicGeometry.Etale e_UY :=
      AlgebraicGeometry.HasRingHomProperty.comp_of_isOpenImmersion (@AlgebraicGeometry.Etale.{u})
        hUY.isoSpec.inv (Y.homOfLE hUY_W ≫ e_Y)
        (AlgebraicGeometry.HasRingHomProperty.comp_of_isOpenImmersion (@AlgebraicGeometry.Etale.{u})
          (Y.homOfLE hUY_W) e_Y heY_et)
    let φ_nod : A_k₀ →+* C_Y := (AlgebraicGeometry.Spec.preimage e_UY).hom
    have heUY_eq : e_UY = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_nod) :=
      (AlgebraicGeometry.Spec.map_preimage e_UY).symm
    have hφ_et : φ_nod.Etale := by
      rw [heUY_eq] at heUY_et
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale.{u})).mp heUY_et
    have hfrom_pY : hUY.fromSpec ≫ p_Y =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_nod.comp C_k₀)) := by
      calc
        hUY.fromSpec ≫ p_Y = hUY.isoSpec.inv ≫ U_Y.ι ≫ p_Y := by
          rw [← CategoryTheory.Category.assoc, hUY.isoSpec_inv_ι]
        _ = hUY.isoSpec.inv ≫ Y.homOfLE hUY_W ≫ W_Y.ι ≫ p_Y := by
          rw [AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
        _ = e_UY ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_k₀) := by
          dsimp [e_UY]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, heY_snd]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_nod.comp C_k₀)) := by
          rw [heUY_eq, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hχ_id : χ_Y.comp (φ_nod.comp C_k₀) = RingHom.id k₀ := by
      have h_sp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ_Y.comp (φ_nod.comp C_k₀))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id k₀)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← hfrom_pY, ← hσ_U_eq,
          ← CategoryTheory.Category.assoc, hσ_fac, hSec, CommRingCat.ofHom_id,
          AlgebraicGeometry.Spec.map_id]
      have h_pre := congrArg AlgebraicGeometry.Spec.preimage h_sp
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at h_pre
      exact congrArg CommRingCat.Hom.hom h_pre
    have hχ_X : ∀ ε : Fin 2, χ_Y (φ_nod (mk₀ (MvPolynomial.X ε))) = 0 := by
      intro ε
      let pt₀_sp : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)) := pt₀
      have h_pt_W : (σ_U ≫ hUY.isoSpec.inv ≫ Y.homOfLE hUY_W).base pt₀_sp = ⟨q₀, hqW⟩ := by
        apply W_Y.ι.isOpenEmbedding.injective
        have h_hom : (σ_U ≫ hUY.isoSpec.inv ≫ Y.homOfLE hUY_W) ≫ W_Y.ι = σ := by
