              change φ_R r₀ * b = φ_AR_BR (algebraMap ↥R A_R r₀) * b
              have h_comm_r : φ_AR_BR (algebraMap ↥R A_R r₀) = φ_R r₀ :=
                (e_BR.commutes r₀)
