        PrimeSpectrum.ext (((hAffine_comap U₀ hU₀ q_B).symm.trans hqB_comap).trans hs₀_bot.symm)
      obtain ⟨y_gen, hy_fst, _⟩ :=
        @AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback _ _ _ g s₀ y₀
