        let y_R : ↥B_R := ⟨g_a * x, hgx⟩
        have h_in_top : f₁_B y_R ∈ Ideal.span {(⟨g_a, hg_in_Ba⟩ : ↥B_a)} := by
          rw [Ideal.mem_span_singleton]
          refine ⟨⟨x, hx⟩, ?_⟩
          apply Subtype.ext
          rfl
        have h_mk_top : Ideal.Quotient.mk (Ideal.span {(⟨g_a, hg_in_Ba⟩ : ↥B_a)}) (f₁_B y_R) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr h_in_top
        have hΘ : Θ_inv (Ideal.Quotient.mk _ (f₁_B y_R)) =
            (Ideal.Quotient.mk (Ideal.span {(⟨g_a, hg_in_BR⟩ : ↥B_R)}) y_R) ⊗ₜ[↥R] (1 : V₀) := by
          change π_Qβ (μ_B.symm (f₁_B y_R)) = _
          have hμ_y : μ_B (y_R ⊗ₜ[↥R] (1 : V₀)) = f₁_B y_R := by
            apply Subtype.ext
            change (g_a * x) * φ_VF 1 = g_a * x
            rw [map_one, mul_one]
          rw [← hμ_y, μ_B.symm_apply_apply]
          rfl
        have h_tp0 : (Ideal.Quotient.mk (Ideal.span {(⟨g_a, hg_in_BR⟩ : ↥B_R)}) y_R) ⊗ₜ[↥R] (1 : V₀) =
            (0 : Q_β) ⊗ₜ[↥R] (1 : V₀) := by
          rw [← hΘ, h_mk_top, map_zero, TensorProduct.zero_tmul]
        have h_q0 : Ideal.Quotient.mk (Ideal.span {(⟨g_a, hg_in_BR⟩ : ↥B_R)}) y_R = 0 :=
          hInj_Qβ_tp h_tp0
        have h_mem_BR : y_R ∈ Ideal.span {(⟨g_a, hg_in_BR⟩ : ↥B_R)} :=
          Ideal.Quotient.eq_zero_iff_mem.mp h_q0
        obtain ⟨z_R, hz_R⟩ := Ideal.mem_span_singleton.mp h_mem_BR
        have hz_val : g_a * x = g_a * z_R.1 := congrArg Subtype.val hz_R
        have hx_eq : x = z_R.1 := mul_left_cancel₀ hga_ne hz_val
        rw [hx_eq]
        exact z_R.2
      intro x hx r
      induction r generalizing x with
      | zero =>
        intro h0
        rwa [pow_zero, one_mul] at h0
      | succ r ih =>
        intro hr
        have h_rew : g_a ^ r * (g_a * x) = g_a ^ (r + 1) * x := by ring
        rw [← h_rew] at hr
        have hgx_Ba : g_a * x ∈ B_a := B_a.mul_mem hg_in_Ba hx
        have hgx_BR : g_a * x ∈ B_R := ih (g_a * x) hgx_Ba hr
        exact hSat_one x hx hgx_BR
    exact ⟨hg_in_BR, hYa_in_BR, hSat, hR_in_BR, hV_in_Ba, hle_BR_Ba, hFlat_BR, hBij_B⟩
  have hs3 : ∀ S_V : Finset ↥V,
      ∃ R_β : Subring ↥V,
        IsNoetherianRing ↥R_β ∧
        IsLocalRing ↥R_β ∧
        IsLocalHom R_β.subtype ∧
        ∀ v ∈ S_V, v ∈ R_β := by
    clear! F φ_VF N B r_a P_a ρ_a hEtCov hs1 hs2
    intro S_V
    let A_alg : Subalgebra ℤ ↥V := Algebra.adjoin ℤ (S_V : Set ↥V)
    have hFT : Algebra.FiniteType ℤ ↥A_alg :=
      Algebra.FiniteType.adjoin_of_finite S_V.finite_toSet
    have hNoethA : IsNoetherianRing ↥A_alg :=
      Algebra.FiniteType.isNoetherianRing ℤ ↥A_alg
    let p_β : Ideal ↥A_alg := Ideal.comap A_alg.val.toRingHom (IsLocalRing.maximalIdeal ↥V)
    have hp_prime : p_β.IsPrime := Ideal.IsPrime.comap A_alg.val.toRingHom
    let L := Localization.AtPrime p_β
    have hNoethL : IsNoetherianRing L :=
      IsLocalization.isNoetherianRing p_β.primeCompl L hNoethA
    have hLocL : IsLocalRing L := Localization.AtPrime.isLocalRing p_β
    have h_units : ∀ y : p_β.primeCompl, IsUnit (A_alg.val.toRingHom y) := by
      intro y
      exact IsLocalRing.notMem_maximalIdeal.mp y.2
    let φ_loc : L →+* ↥V := IsLocalization.lift (M := p_β.primeCompl) (g := A_alg.val.toRingHom) h_units
    have hInj : Function.Injective φ_loc := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨a, s⟩, hxs⟩ := IsLocalization.surj p_β.primeCompl x
      have ha_val : A_alg.val.toRingHom a = 0 := by
        calc
          A_alg.val.toRingHom a = φ_loc (algebraMap ↥A_alg L a) :=
            (IsLocalization.lift_eq h_units a).symm
          _ = φ_loc (x * algebraMap ↥A_alg L s) := by rw [hxs]
          _ = φ_loc x * φ_loc (algebraMap ↥A_alg L s) := map_mul φ_loc _ _
          _ = 0 * φ_loc (algebraMap ↥A_alg L s) := by rw [hx]
          _ = 0 := zero_mul _
      have ha0 : a = 0 := Subtype.ext ha_val
      have hxs0 : x * algebraMap ↥A_alg L s = 0 := by
        rw [hxs, ha0, map_zero]
      have hs_unit : IsUnit (algebraMap ↥A_alg L s) :=
        IsLocalization.map_units L s
      exact hs_unit.mul_left_eq_zero.mp hxs0
    let R_β : Subring ↥V := φ_loc.range
    let e_loc : L ≃+* ↥R_β := RingEquiv.ofBijective φ_loc.rangeRestrict
      ⟨fun x y h => hInj (congrArg Subtype.val h), φ_loc.rangeRestrict_surjective⟩
    have hNoethR : IsNoetherianRing ↥R_β := isNoetherianRing_of_ringEquiv L e_loc
    have hLocR : IsLocalRing ↥R_β := e_loc.isLocalRing
    refine ⟨R_β, hNoethR, hLocR, ?_, ?_⟩
    · refine ⟨fun r hr => ?_⟩
      let x : L := e_loc.symm r
      have hφx : φ_loc x = R_β.subtype r := by
        have he : e_loc x = r := e_loc.apply_symm_apply r
        exact congrArg Subtype.val he
      obtain ⟨⟨a, s⟩, hxs⟩ := IsLocalization.surj p_β.primeCompl x
      have ha_unit : IsUnit (A_alg.val.toRingHom a) := by
        have h_eq : A_alg.val.toRingHom a = φ_loc x * A_alg.val.toRingHom s := by
          calc
            A_alg.val.toRingHom a = φ_loc (algebraMap ↥A_alg L a) :=
              (IsLocalization.lift_eq h_units a).symm
            _ = φ_loc (x * algebraMap ↥A_alg L s) := by rw [hxs]
            _ = φ_loc x * φ_loc (algebraMap ↥A_alg L s) := map_mul φ_loc _ _
            _ = φ_loc x * A_alg.val.toRingHom s := by rw [IsLocalization.lift_eq h_units s]
        rw [h_eq, hφx]
        exact hr.mul (h_units s)
