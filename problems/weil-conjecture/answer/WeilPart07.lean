      have hη_cl_z : η_E ∈ closure ({z} : Set ↥X) := by
        have h_pre_sub : closure ({v₁} : Set (PrimeSpectrum B)) ⊆
            ι_WU.base ⁻¹' closure ({z} : Set ↥X) :=
