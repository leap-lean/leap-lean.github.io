      have hvA : v ∈ A_alg := Algebra.subset_adjoin hv
      refine ⟨algebraMap ↥A_alg L ⟨v, hvA⟩, ?_⟩
      exact IsLocalization.lift_eq h_units ⟨v, hvA⟩
  have hs4 : ∀ (V₀ : Type u) [CommRing V₀]
      (F : Type u) [Field F] (φ_VF : V₀ →+* F)
      (N : ℕ) (B : Finset (Fin (N + 1)) → Subring F)
      (Y_a : Fin (N + 1) → Finset F),
      (∀ (S : Finset (Fin (N + 1))), S.Nonempty →
        (∀ v : V₀, φ_VF v ∈ B S) ∧
        B S = Subring.closure (⋃ a ∈ S, (B {a} : Set F)) ∧
