          exact hy₀_U₀
        obtain ⟨w, ⟨hw_U₀, hw_eq⟩⟩ := (mem_closure_iff.mp hy_in_cl_ηY) _ hopen hy_mem
        rw [Set.mem_singleton_iff] at hw_eq
