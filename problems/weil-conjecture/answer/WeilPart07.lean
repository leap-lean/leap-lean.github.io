      rw [AlgebraicGeometry.Scheme.basicOpen_mul, AlgebraicGeometry.Scheme.basicOpen_res,
        AlgebraicGeometry.Scheme.basicOpen_res, AlgebraicGeometry.Scheme.basicOpen_res,
        AlgebraicGeometry.Scheme.basicOpen_pow Y eZ_Y (by omega : 0 < m₀)] at hbo_eq
      have heZ_bo : Y.basicOpen eZ_Y = V₀_Y ⊓ U_ZY :=
        AlgebraicGeometry.Scheme.basicOpen_appLE fstY V₀_Y V₀ le_rfl eZ
      have hz_eZ : z ∈ Y.basicOpen eZ_Y := by
        rw [heZ_bo]
        exact ⟨hzV₀, hzUZ⟩
      have hz_lhs : z ∈ (U_ZY ⊓ Y.basicOpen f₁_Y) ⊓ (U_ZY ⊓ Y.basicOpen eZ_Y) :=
        ⟨⟨hzUZ, hmem⟩, ⟨hzUZ, hz_eZ⟩⟩
      rw [hbo_eq] at hz_lhs
      exact hfZ1_vanish_Z z hz hzV₀ hz_lhs.2
  obtain ⟨f₁_gl, hf₁_V₁, hf₁_Z_mul, hf₁_vanish⟩ := h_s4

  
  
  
  have hKer : ∀ (a : Fin (N' + 1))
      (hXa : (MvPolynomial.X a : MvPolynomial (Fin (N' + 1)) ↥V) ∈ 𝒜_V 1)
      (r : ℕ) (P : MvPolynomial (Fin (N' + 1)) ↥V) (hP : P ∈ 𝒜_V (r • 1)),
      ((AlgebraicGeometry.Proj.awayToSection 𝒜_V (MvPolynomial.X a)).hom
        (HomogeneousLocalization.Away.mk 𝒜_V hXa r P hP)) ∈
        RingHom.ker ((φ.app (weilProjBasicOpen ↥V N' a)).hom) ↔
      MvPolynomial.eval₂Hom c_R₁ f (MvPolynomial.X a * P) = 0 := by
    have _ : AlgebraicGeometry.IsIntegral C := hIntC
    have hNontriv₀ : Nontrivial ↑(C.presheaf.obj (Opposite.op V₀)) := by
      let I₀ : Ideal ↑(C.presheaf.obj (Opposite.op V₀)) := Ideal.span ({h₀ ^ 1} : Set _)
      haveI : Nontrivial (↑(C.presheaf.obj (Opposite.op V₀)) ⧸ I₀) := (hQuot_h₀ 1 le_rfl).2.2
      exact RingHom.domain_nontrivial (Ideal.Quotient.mk I₀)
    have hNontriv₁ : Nontrivial ↑(C.presheaf.obj (Opposite.op V₁)) := by
      let I₁ : Ideal ↑(C.presheaf.obj (Opposite.op V₁)) := Ideal.span ({t₀ ^ 1} : Set _)
      haveI : Nontrivial (↑(C.presheaf.obj (Opposite.op V₁)) ⧸ I₁) := (hQuot_t₀ 1 le_rfl).2.2
      exact RingHom.domain_nontrivial (Ideal.Quotient.mk I₁)
    have hSub_bot : ∀ (U : C.Opens), U = ⊥ → Subsingleton ↑(C.presheaf.obj (Opposite.op U)) := by
      intro U hU
      subst hU
      obtain ⟨s₀, _, hs_uniq⟩ := C.sheaf.existsUnique_gluing (Empty.elim : Empty → C.Opens)
        (fun i => Empty.elim i) (fun i => Empty.elim i)
      have h_emp : (⨆ i : Empty, (Empty.elim i : C.Opens)) = ⊥ := iSup_of_empty _
      let e_bot := C.presheaf.mapIso (CategoryTheory.eqToIso h_emp).op
      refine Subsingleton.intro (fun x y => ?_)
      have hx : e_bot.hom x = s₀ := hs_uniq (e_bot.hom x) (fun i => Empty.elim i)
      have hy : e_bot.hom y = s₀ := hs_uniq (e_bot.hom y) (fun i => Empty.elim i)
      have hxy : e_bot.inv.hom (e_bot.hom.hom x) = e_bot.inv.hom (e_bot.hom.hom y) :=
        congrArg e_bot.inv.hom (hx.trans hy.symm)
      simpa using hxy
    have hNonempty_of_nontriv : ∀ (U : C.Opens),
        Nontrivial ↑(C.presheaf.obj (Opposite.op U)) → Nonempty ↥U := by
      intro U hNontriv
      by_contra hEmpty
      rw [not_nonempty_iff] at hEmpty
      have hU_bot : U = ⊥ := by
        ext x
        simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
        exact fun hx => hEmpty.false ⟨x, hx⟩
      have _ : Subsingleton ↑(C.presheaf.obj (Opposite.op U)) := hSub_bot U hU_bot
      exact false_of_nontrivial_of_subsingleton ↑(C.presheaf.obj (Opposite.op U))
    have hNE_V₀ : Nonempty ↥V₀ := hNonempty_of_nontriv V₀ hNontriv₀
    have hNE_V₁ : Nonempty ↥V₁ := hNonempty_of_nontriv V₁ hNontriv₁
    have hIrred : IrreducibleSpace ↥C := AlgebraicGeometry.irreducibleSpace_of_isIntegral C
    have hNE_V₀₁ : Nonempty ↥(V₀ ⊓ V₁) := by
      have hpre_univ := (IrreducibleSpace.isIrreducible_univ (X := ↥C)).isPreirreducible
      rcases hpre_univ V₀.1 V₁.1 V₀.2 V₁.2
