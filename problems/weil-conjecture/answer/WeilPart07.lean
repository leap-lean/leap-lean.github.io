            Ideal.Quotient.mk I_bar (MvPolynomial.X (Fin.castAdd N a).succ)
          have ha : ρ (MvPolynomial.X (Fin.castAdd N a).succ) = MvPolynomial.X a.succ := by
            change (MvPolynomial.aeval ρ_fun) (MvPolynomial.X (Fin.castAdd N a).succ) = _
            rw [MvPolynomial.aeval_X]
            simp [ρ_fun]
          rw [ha, MvPolynomial.rename_X]
          rfl
        · intro d
          change Ideal.Quotient.mk I_bar (MvPolynomial.rename ι_Y (ρ (MvPolynomial.X (ι_X d)))) =
